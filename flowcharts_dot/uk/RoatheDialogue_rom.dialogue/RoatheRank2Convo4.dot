digraph {
	1095 [label="RoatheRank2Convo4 begins.",color=orange];
		1095 -> 1096;
	1096 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1096 -> 1097 [label=true,color=green];
		1096 -> 1098 [label=false,color=brown];
	1097 [label="Check boolean RoatheKnowsReset2",color=orange];
		1097 -> 1099 [label=true,color=green];
		1097 -> 1100 [label=false,color=brown];
	1098 [label="Chat ends.",color=orange];
	1099 [label="Гм. Скажи мені. Чи вдалося мені переконати тебе минулого разу, що твоя «Байдужість» — це лише колекція зібраних дитячих іграшок, чи ти все ще віриш, що це якась «велика незбагненна істота з Порожнечі»?",shape=box,color=blue];
		1099 -> 1101;
	1100 [label="Check boolean RoatheMITW1",color=orange];
		1100 -> 1102 [label=true,color=green];
		1100 -> 1103 [label=false,color=brown];
	1101 [label="Якщо є щось у цьому світі, що я зневажаю, то це ганятися за власним хвостом. І ця метафора раніше була набагато більш поширеною, ніж зараз, я оце щойно усвідомив.",shape=box,color=blue];
		1101 -> 1104;
		1101 -> 1105;
		1101 -> 1106;
	1102 [label="Отже, перш ніж продовжувати, я хотів би переконатися, що все правильно зрозумів. Ти віриш в те, що Байдужість — це якась жахлива незбагненна істота з Порожнечі, яка проникла в нашу реальність через помилки Альбрехта?",shape=box,color=blue];
		1102 -> 1107;
	1103 [label="Усі, з ким я розмовляв у цій божевільні, повністю переконані, що ця «Людина в стіні» — якийсь буквальний і сміховинний бог. Справжній бог. Навіть ці два фанатики, здається, поділяють цю думку!",shape=box,color=blue];
		1103 -> 1108;
		1103 -> 1109;
		1103 -> 1110;
	1104 [label="Ні, тобі не вдалося. Вибач. ",shape=box,color=red];
		1104 -> 1111;
	1105 [label="Насправді тобі вдалося.",shape=box,color=red];
		1105 -> 1112;
	1106 [label="Ми так і не дійшли згоди.",shape=box,color=red];
		1106 -> 1113;
	1107 [label="Дозвольте мені сформулювати своє питання таким чином, перш ніж ми знову почнемо ходити по колу та ганятися за власним хвостом. І ця метафора раніше була набагато більш поширеною, ніж зараз, я оце щойно усвідомив, але я відхилився від теми.",shape=box,color=blue];
		1107 -> 1114;
	1108 [label="Ти не думаєш, що вона справжня?",shape=box,color=red];
		1108 -> 1115;
	1109 [label="Якщо ти не думаєш, що це бог, тоді хто це?",shape=box,color=red];
		1109 -> 1116;
	1110 [label="Але не ти?",shape=box,color=red];
		1110 -> 1117;
	1111 [label="Update boolean RoatheMITWSkip",color=orange];
		1111 -> 1118;
	1112 [label="Update boolean RoatheMITWSkip",color=orange];
		1112 -> 1119;
	1113 [label="Ох! Ну, тоді, здається, у мене ще є над чим працювати.",shape=box,color=blue];
		1113 -> 1120;
	1114 [label="Ти віриш в те, що істота, яку ти зараз називаєш Байдужістю, існувала до того, як Альбрехт зіткнувся з нею? Або ти вважаєш, що він створив її, коли вперше взаємодіяв з Порожнечею?",shape=box,color=blue];
		1114 -> 1121;
		1114 -> 1122;
		1114 -> 1123;
		1114 -> 1124;
	1115 [label="Хіба я так сказав? Не поспішай вкладати свої слова в мої уста, о Позачасовий узурпаторе. Я не заперечую, що Байдужість «реальна». Я заперечую, що вона є Богом.",shape=box,color=blue];
		1115 -> 1125;
		1115 -> 1126;
	1116 [label="Я можу позбавити тебе цього фальшивого божества двома простими словами, які потрібно добре знати та розуміти:",shape=box,color=blue];
		1116 -> 1127;
	1117 [label="Абсолютно ні! По-перше, немає ні бога, ні богів, ця ідея безглузда. По-друге, думати, що Альбрехт звільнив бога Порожнечі, ще смішніше!",shape=box,color=blue];
		1117 -> 1128;
	1118 [label="Update boolean RoatheMITW5Real",color=orange];
		1118 -> 1129;
	1119 [label="Update boolean RoatheMITW5Fake",color=orange];
		1119 -> 1130;
	1120 [label="Update boolean RoatheMITW1",color=orange];
		1120 -> 1131;
	1121 [label="Я не знаю. І я не думаю, що ти теж знаєш.",shape=box,color=red];
		1121 -> 1132;
	1122 [label="Я думаю, що це була істота, яка існувала до того, як Ентраті взаємодіяв з нею. Він просто надав її форму та вигляд за допомогою концептуального втілення.",shape=box,color=red];
		1122 -> 1133;
	1123 [label="Чесно кажучи… я не знаю.",shape=box,color=red];
		1123 -> 1134;
	1124 [label="Ти справді гадаєш, що Ентраті вигадав злостивого бога Порожнечі з нічого?",shape=box,color=red];
		1124 -> 1135;
	1125 [label="Ця річ сильніше за все, з чим мені коли-небудь доводилося мати справу.",shape=box,color=red];
		1125 -> 1136;
	1126 [label="Як ти думаєш, що це тоді?",shape=box,color=red];
		1126 -> 1116;
	1127 [label="Концептуальне втілення.",shape=box,color=blue];
		1127 -> 1137;
		1127 -> 1138;
		1127 -> 1139;
	1128 [label="У Порожнечі нічого немає. Саме тому вона називається Порожнечею! ",shape=box,color=blue];
		1128 -> 1140;
		1128 -> 1141;
	1129 [label="+10 Chemistry",color=orange];
		1129 -> 1142;
	1130 [label="+20 Chemistry",color=orange];
		1130 -> 5772;
	1131 [label="Але перш ніж продовжувати, я хотів би переконатися, що все правильно зрозумів. Ти віриш у те, що Байдужість — це якась жахлива незбагненна істота з Порожнечі, яка проникла в нашу реальність через помилки Альбрехта?",shape=box,color=blue];
		1131 -> 1107;
	1132 [label="Так! Я знаю! Те, що відбувається, настільки болісно очевидно і настільки смішно, що ви всі переконали себе, ніби за вікном шкребеться якийсь страшний звір, хоча це лише гілка дерева, що колихається вітром.",shape=box,color=blue];
		1132 -> 1143;
	1133 [label="Тільки не ти. Я покладав на тебе надії. Те, що відбувається, настільки болісно очевидно і настільки смішно, що ви всі переконали себе, ніби за вікном шкребеться якийсь страшний звір, хоча це лише гілка дерева, що колихається вітром.",shape=box,color=blue];
		1133 -> 1143;
	1134 [label="Те, що відбувається, настільки болісно очевидно і настільки смішно, що ви всі переконали себе, ніби за вікном шкребеться якийсь страшний звір, хоча це лише гілка дерева, що колихається вітром.",shape=box,color=blue];
		1134 -> 1143;
	1135 [label="Так! Я знаю! Те, що відбувається, настільки болісно очевидно і настільки смішно, що ви всі переконали себе, ніби за вікном шкребеться якийсь страшний звір, хоча це лише гілка дерева, що колихається вітром.",shape=box,color=blue];
		1135 -> 1143;
	1136 [label="І коли я таке заперечував? Насправді складається враження, що вам усім удалося довести себе до істеричного та безпідставно обурливого стану страждань.",shape=box,color=blue];
		1136 -> 1144;
		1136 -> 1145;
	1137 [label="Порожнеча небезпечна та могутня, як і те, що ми можемо зробити з неї. Повір, я знаю. Але вона має межі. Ти справді думаєш, що вона може проявити щось подібне? Це щось може створювати цілі мови, пальці, здатні живити цілі зорельоти, які стрибають через Порожнечу?",shape=box,color=red];
		1137 -> 1146;
	1138 [label="У це… дуже хочеться повірити, що це лише монстр під нашим ліжком, Роуте. Але після зустрічі з цим віч-на-віч я не знаю, як щось подібне може бути створене нашою свідомістю.",shape=box,color=red];
		1138 -> 1147;
	1139 [label="Концептуальне втілення не може зробити те, на що здатна Людина в стіні. Хоча Ентраті, можливо, виявив цю річ — і несе відповідальність за її перенесення сюди — але я не вірю, що він є першоджерелом.",shape=box,color=red];
		1139 -> 1148;
	1140 [label="Я… ",shape=box,color=red];
		1140 -> 1149;
	1141 [label="Ні. Я знаю речі, які походять із Порожнечі. Янголи. Спів. Привиди.",shape=box,color=red];
		1141 -> 1149;
	1142 [label="Хоча я розчарований тим, що ти дотримуєшся своєї позиції, проте твоя чесність мене надзвичайно тішить. І я радий, що не марную час, рухаючись вперед. Я впевнений, що ми знайдемо інші способи розважитися.",shape=box,color=blue];
		1142 -> 1150;
	5772 [label="Fantastic. I am glad my former self was so wonderfully convincing. And I am hopeful you are being honest and not lying to me in an attempt to \"shut me up.\" But, I have no choice but to believe you.",shape=box,color=blue];
		5772 -> 5773;
	1143 [label="Тільки тепер, під впливом Порожнечі, ви всі вигодували її страхом і силою, що вона, як зворотний зв’язок, втілилися в цю… Річ. Людину в стіні.",shape=box,color=blue];
		1143 -> 1151;
	1144 [label="Що ти хочеш сказати?",shape=box,color=red];
		1144 -> 1152;
	1145 [label="Зажди. Яким чином ми винні в цьому? Лише Альбрехт винен, він це випустив.",shape=box,color=red];
		1145 -> 1153;
	1146 [label="Людство, звісно, ніщо інше як творчість у широті та масштабах нових форм страждань, які воно може собі вигадати, чи не так? На твою долю випало багато форм жорстокості, які, я впевнений, ніхто не міг би уявити, що вони можливі за часів наших фанатиків.",shape=box,color=blue];
		1146 -> 1154;
	1147 [label="Ех, ти так близько підходиш до істини, але так швидко відкидаєш її. Ти думаєш, що «спокусливо» повірити, що це витвір нашого власного розуму, адже якби це було так, було б легше це відкинути? Ні, я думаю, що набагато небезпечніше зіткнутися з нашим власним творінням, ніж із богом.",shape=box,color=blue];
		1147 -> 1155;
	1148 [label="Хоча я ціную твоє смирення, проте кидаю виклик твоєму обмеженому розумінню можливостей людської винахідливості, особливо, що стосується вигадування нових форм страждань. Хіба ти не несеш повну відповідальність за створення власного всесвіту з нічого?",shape=box,color=blue];
		1148 -> 1156;
	1149 [label="Єдине, що походить із Порожнечі — це те, що ми поміщаємо в неї, і те, що повертається з неї. Вона може змінити матерію та енергію, але не може її створити.",shape=box,color=blue];
		1149 -> 1157;
	1150 [label="Я, наприклад, удячний за те, що мені не довелося знову ходити по колу та вести нескінченні дебати про тонкощі концептуального втілення.",shape=box,color=blue];
		1150 -> 1158;
	5773 [label="Either way, I am certain we will find other ways to amuse ourselves than to be lost in wandering and circular debates about the finer points of Conceptual Embodiment.",shape=box,color=blue];
		5773 -> 5774;
	1151 [label="Можливо, Альбрехт і розпочав цю нісенітницю, але ви всі несете відповідальність за те, що підливали масла в вогонь, поки він не перетворився на пекло. Байдужість ніколи не існувала. Аж раптом вона з’явилася. ",shape=box,color=blue];
		1151 -> 1159;
	1152 [label="Я хочу сказати, що Альбрехт міг бути тим, хто спочатку побачив свою власну пиху як обличчя усміхненого бога руйнувань.",shape=box,color=blue];
		1152 -> 1160;
	1153 [label="Альбрехт міг бути тим, хто спочатку побачив свою власну пиху як обличчя усміхненого бога руйнувань.",shape=box,color=blue];
		1153 -> 1160;
	1154 [label="+5 Chemistry",color=orange];
		1154 -> 1161;
	1155 [label="Зовнішнього ворога можна зрозуміти. Маніпулювати. Перемогти. Або, можливо, навіть домовитися, якщо на те пішло. У нього є слабкі сторони, якими можна скористатися. Але якщо це внутрішній ворог? Якого ми самі створили? Це насправді набагато підступніше.",shape=box,color=blue];
		1155 -> 1162;
	1156 [label="На твою долю випало багато форм жорстокості, які, я впевнений, ніхто не міг би уявити, що вони можливі за часів наших фанатиків. ",shape=box,color=blue];
		1156 -> 1163;
	1157 [label="Подумай, мандрівниче. Ці «Янголи Порожнечі», про яких ти говориш. Ці привиди. Чи були вони зроблені з тих, хто вже загубився в Порожнечі?",shape=box,color=blue];
		1157 -> 1164;
	1158 [label="Хоча це означає більше часу на проповіді фанатиків… ха. Вибір, вибір, вибір…",shape=box,color=blue];
		1158 -> 1165;
	5774 [label="I, for one, am grateful to be spared a second round.",shape=box,color=blue];
		5774 -> 1158;
	1159 [label="І ви всі в цьому винні.",shape=box,color=blue];
		1159 -> 1166;
		1159 -> 1167;
		1159 -> 1168;
	1160 [label="Але ви всі однаково винні в тому, що продовжуєте котити цей кавелик жука-гнойовика вниз по схилу, збільшуючи його з кожним шаром лайна, яке збираєте по дорозі!",shape=box,color=blue];
		1160 -> 1169;
	1161 [label="Як вид ми напрочуд дивовижні у своїй здатності підживлювати свої страхи новими способами самознищення.",shape=box,color=blue];
		1161 -> 1170;
	1162 [label="+5 Chemistry",color=orange];
		1162 -> 1171;
	1163 [label="+5 Chemistry",color=orange];
		1163 -> 1161;
	1164 [label="Вони були лише відлунням енергії, наче відрижка барвистого кутака, щоб нагодувати своїх дітей.",shape=box,color=blue];
		1164 -> 1169;
	1165 [label="Chat ends.",color=orange];
	1166 [label="Ми не можемо створювати такі речі, Роуте. Концептуальне втілення має свої межі.",shape=box,color=red];
		1166 -> 1172;
	1167 [label="Не звинувачуй нас у цьому. Ми не винні в тому, що ця річ заподіяла.",shape=box,color=red];
		1167 -> 1173;
	1168 [label="Поясни мені, як це працюватиме. Більшість речей, створених за допомогою концептуального втілення з Порожнечі, не можуть її покинути. Принаймні не надовго.",shape=box,color=red];
		1168 -> 1174;
	1169 [label="Дозволь мені спростити цю тему для тебе. Я можу позбавити тебе цього фальшивого божества двома простими словами, які потрібно добре знати та розуміти:",shape=box,color=blue];
		1169 -> 1127;
	1170 [label="Update boolean RoatheMITW1",color=orange];
		1170 -> 1107;
	1171 [label="Тому що тоді ми повинні побороти або опанувати демонів. А людство… ніколи не виграє такі війни, чи не так?",shape=box,color=blue];
		1171 -> 1170;
	1172 [label="Каже той, хто самотужки створив цілий альтернативний вимір? Прошу, мандрівниче… використай свою уяву, як колись давно.",shape=box,color=blue];
		1172 -> 1174;
	1173 [label="Я не докоряю тобі! Це вже давно було в процесі розробки, ще до твоєї появи. Альбрехт подбав про це.",shape=box,color=blue];
		1173 -> 1175;
	1174 [label="Концептуальне втілення працює таким чином: під час взаємодії з Порожнечею або в її безпосередній близькості сильні емоції та думки можуть проявлятися фізично. Ми обоє це знаємо.",shape=box,color=blue];
		1174 -> 1176;
		1174 -> 1177;
		1174 -> 1178;
	1175 [label="Він побачив власне віддзеркалення й пізнав справжній страх. І так спалахнула перша іскра, яка розпалила вогонь, що загрожує спалити все дотла. Ви всі просто продовжуєте підкидати дрова у вогонь.",shape=box,color=blue];
		1175 -> 1174;
	1176 [label="Правильно. Як і Дувірі, воно пов’язано з цим світом через «Заримен». ",shape=box,color=red];
		1176 -> 1179;
	1177 [label="Як «Заримен», «Паланка» та янголи Порожнечі. Порожнеча є всюди на цьому кораблі.",shape=box,color=red];
		1177 -> 1179;
	1178 [label="Так, і що?",shape=box,color=red];
		1178 -> 1180;
	1179 [label="Саме так. Там, де є Порожнеча, може існувати й концептуальне втілення. І тільки там.",shape=box,color=blue];
		1179 -> 1181;
		1179 -> 1182;
	1180 [label="Там, де є Порожнеча, може існувати й концептуальне втілення. І тільки там.",shape=box,color=blue];
		1180 -> 1181;
		1180 -> 1182;
	1181 [label="Але воно було в 1999 році. Воно слідувало за Альбрехтом всюди. І за мною теж.",shape=box,color=red];
		1181 -> 1183;
	1182 [label="Зажди…",shape=box,color=red];
		1182 -> 1184;
	1183 [label="Кляті пальці. Ми взяли ці кляті пальці у відчайдушній і божевільній спробі дістатися до Тау, і ми, орокіни, знайшли спосіб їх відтворити, чи не так?",shape=box,color=blue];
		1183 -> 1185;
	1184 [label="Так. Ти тепер розумієш. Кляті пальці. Ми взяли ці кляті пальці у відчайдушній і божевільній спробі дістатися до Тау, і ми, орокіни, знайшли спосіб їх відтворити, чи не так?",shape=box,color=blue];
		1184 -> 1185;
	1185 [label="Маленькі шматочки Порожнечі, куди б ти не пішов… Мережа траншей і тунелів, щоб ця штука могла з’являтися де завгодно. А що ще гірше?",shape=box,color=blue];
		1185 -> 1186;
	1186 [label="Тенно. І ти. Усі ви, кого торкнулася Порожнеча. І всі ви переслідувані цією річчю, бо куди б ви не пішли, вона може слідувати за вами.",shape=box,color=blue];
		1186 -> 1187;
	1187 [label="Та, імовірно, будь-хто, хто взаємодіяв із нею протягом будь-якого часу. Сам Ентраті. Його дворецький. Кавії. Власне, я та фанатики, завдяки нашій близькості до цього Святилища. Список можна продовжувати.",shape=box,color=blue];
		1187 -> 1188;
		1187 -> 1189;
	1188 [label="Тож ти припускаєш, що будь-хто, хто зазнав достатнього впливу Порожнечі, або будь-хто, хто є «акумулятором», стає ще однією шпариною, через яку Людина в стіні може зазирнути?",shape=box,color=red];
		1188 -> 1190;
	1189 [label="Але мені цікаво, як воно потрапило в Русалку?",shape=box,color=red];
		1189 -> 1191;
	1190 [label="Саме так. ",shape=box,color=blue];
		1190 -> 1192;
	1191 [label="У кого?",shape=box,color=blue];
		1191 -> 1193;
		1191 -> 1194;
	1192 [label="Це пояснює, чому вона не має власного обличчя, чи не так? Вона може з’являтися лише тим, кого мучить, і тим, кого намагається мучити.",shape=box,color=blue];
		1192 -> 1195;
	1193 [label="Майорка Несі Русалка. У 1999 році вона командувала військовим підрозділом під назвою «Скальдра» в Голвенії.",shape=box,color=red];
		1193 -> 1196;
	1194 [label="Коротше, вам нізащо не можна дозволити зустрітися.",shape=box,color=red];
		1194 -> 1197;
	1195 [label="Насправді вона набуває вигляду архітектури лише тоді, коли не здатна представити себе як щось більше та відмінне. Коли вона відчайдушно намагається передати відчуття величі та божественності.",shape=box,color=blue];
		1195 -> 1198;
		1195 -> 1199;
	1196 [label="Вона була або є одержимою Байдужістю. Байдужість використовує її розум, користуючись нею, як маріонеткою. Можливо, вона впустила її. Ми не знаємо. Ми також не знаємо, чи вона дійсно знову контролює ситуацію.",shape=box,color=red];
		1196 -> 1200;
	1197 [label="З тобою абсолютно не весело, узурпаторе. Але яке саме відношення вона має до… Байдужості?",shape=box,color=blue];
		1197 -> 1196;
	1198 [label="То ти вважаєш, що вона носить всі обличчя людей, з якими контактує… тому що вона не має власного?",shape=box,color=red];
		1198 -> 1201;
	1199 [label="Я вважаю, що Людина в стіні вирішила носити наші обличчя, тому що не може зрозуміти, як це бути людиною. Інакше вона занадто «велика».",shape=box,color=red];
		1199 -> 1202;
	1200 [label="Вона дійсно здається надзвичайно цікавою особистістю. І це справжнє задоволення. Але це зараз не має значення. Ти кажеш, що Байдужість захопила її розум? І це почалося під час твоєї маленької подорожі в минуле?",shape=box,color=blue];
		1200 -> 1203;
	1201 [label="Ні, дурненьке. Тому що воно лише імітує те, що його створило. Воно не є цілісною істотою — це лише іграшка, зроблена з невідповідних частин тих страхів, жахів і страждань, якими його годували. ",shape=box,color=blue];
		1201 -> 1204;
	1202 [label="Ні, дурненьке. Воно лише імітує те, що його створило. Воно не є цілісною істотою — це лише іграшка, зроблена з невідповідних частин тих страхів, жахів і страждань, якими його годували.",shape=box,color=blue];
		1202 -> 1204;
	1203 [label="Ну, якщо те, що ми знаємо про Порожнечу, відповідає дійсності, то сталося одне з двох: або вона потрапила в якусь взаємодію з Порожнечею в 1999 році з власної волі (що я вважаю вкрай малоймовірним, але не неможливим), або…",shape=box,color=blue];
		1203 -> 1205;
	1204 [label="Та. Схоже, сьогодні я нічого не зроблю. Це нормально через твоє глибоке занурення в цю пропаганду, якою тебе годували. Боюся, що Альбрехт є дуже переконливим культовим лідером.",shape=box,color=blue];
		1204 -> 1206;
	1205 [label="Наш дорогий Альбрехт знову втрутився.",shape=box,color=blue];
		1205 -> 1207;
		1205 -> 1208;
		1205 -> 1209;
	1206 [label="+10 Chemistry",color=orange];
		1206 -> 1210;
	1207 [label="Ти натякаєш, що Альбрехт навмисно зробив Несі маріонеткою Байдужості?",shape=box,color=red];
		1207 -> 1211;
	1208 [label="Ми не знаємо, чи все це правда. Нічого з цього. Це все лише припущення. Усе це може бути повною брехнею.",shape=box,color=red];
		1208 -> 1212;
	1209 [label="Якщо він прорвав діру в Порожнечі в 1999 році та навмисно спустив її… це б пояснювало чому ворфрейми працювали там спочатку… так само як у твої часи — без серця Деймос, я маю на увазі.",shape=box,color=red];
		1209 -> 1213;
	1210 [label="Update boolean RoatheMITW2",color=orange];
		1210 -> 1214;
	1211 [label="Я просто сиджу тут і гадаю на кавовій гущі, як і всі інші, узурпаторе. Далеко не мені натякати, що Альбрехт навмисно прорвав дірку в Порожнечу в Голвенії та впустив Байдужість, щоб дати їй власного аватара…",shape=box,color=blue];
		1211 -> 1215;
	1212 [label="Звичайно! Я просто сиджу тут і гадаю на кавовій гущі, як і всі інші, узурпаторе. Далеко не мені натякати, що Альбрехт навмисно прорвав дірку в Порожнечу в Голвенії та впустив Байдужість, щоб дати їй власного аватара…",shape=box,color=blue];
		1212 -> 1215;
	1213 [label="Бачиш? Ніколи не довіряй вченим. Вони готові зробити що завгодно заради винаходів. Але ж я просто сиджу тут і гадаю на кавовій гущі, як і всі інші, узурпаторе. Це все просто припущення.",shape=box,color=blue];
		1213 -> 1216;
	1214 [label="Сподіваюся, що принаймні я дав тобі привід для роздумів. А тепер я мушу йти.",shape=box,color=blue];
		1214 -> 1217;
	1215 [label="Мені просто здається, як тактику й людині, яка досить звикла розробляти стратегії для війни…",shape=box,color=blue];
		1215 -> 1218;
	1216 [label="Далеко не мені натякати, що Альбрехт навмисно прорвав дірку в Порожнечу в Голвенії та впустив Байдужість, щоб дати їй власного аватара! Мені просто здається, як тактику і людині, яка досить звикла розробляти стратегії для війни…",shape=box,color=blue];
		1216 -> 1218;
	1217 [label="Chat ends.",color=orange];
	1218 [label="Який перший крок до перемоги над безликим супротивником, який може бути де завгодно, ким завгодно і коли завгодно? Це звузити вибір до якомога меншої кількості варіантів…",shape=box,color=blue];
		1218 -> 1219;
	1219 [label="+20 Chemistry",color=orange];
		1219 -> 1220;
	1220 [label="І щоб ці варіанти були вичерпними.",shape=box,color=blue];
		1220 -> 1221;
	1221 [label="Update boolean RoatheMITW2Neci",color=orange];
		1221 -> 1222;
	1222 [label="Чудова тема для роздумів. Але! Наразі я маю йти.",shape=box,color=blue];
		1222 -> 1223;
	1223 [label="Chat ends.",color=orange];
}