		3971 -> 3973;
	3972 [label="Іноді я думаю, чи це не для цього Ентраті мене сюди послав? З вами всіма?",shape=box,color=red];
		3972 -> 3974;
	3973 [label="<RETRO_EMOJI_GIVELOVE>",shape=box,color=blue];
