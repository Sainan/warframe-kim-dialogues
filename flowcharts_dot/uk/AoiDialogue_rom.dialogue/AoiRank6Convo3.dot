	3958 [label="Навіть якби ми знали де вони, я не знаю, чи *взагалі повинні* повертати їх.",shape=box,color=red];
		3958 -> 3960;
	3959 [label="Я знаю. Мені теж від цього не дуже по собі.",shape=box,color=red];
