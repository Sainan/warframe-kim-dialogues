		3921 -> 3923;
	3922 [label="як воно працює у цьому випадку?",shape=box,color=blue];
		3922 -> 3924;
	3923 [label="про обидва!!! давай про велике зорельотище!!",shape=box,color=blue];
		3923 -> 3925;
	3924 [label="Залежить від того, велике чи маленьке судно, але щоб долати великі відстані, вони обидва торкаються Порожнечі. Вони летять крізь Порожнечу.",shape=box,color=red];
		3924 -> 3926;
	3925 [label="Ну, великий — мій рейкоджек. У ньому є копія відрізаного пальця Байдужості (ми звемо це релікварійний рушій).",shape=box,color=red];
		3925 -> 3927;
	3926 [label="Великий зореліт, рейкоджек, використовує штуку, яку ми звемо релікварійний рушій. Це копія відрізаного пальця Байдужості.",shape=box,color=red];
		3926 -> 3928;
	3927 [label="Він використовується для того, щоб торкнутися Порожнечі й подолати велику відстань між планетами. Я лечу крізь Порожнечу.",shape=box,color=red];
		3927 -> 3928;
