		3960 -> 3962;
		3960 -> 3963;
	3961 [label="На жаль, шкоду завдано. Альбрехт забрав пальці. І шляху назад нема.",shape=box,color=red];
		3961 -> 3960;
	3962 [label="Є дещо, пов’язане з «нитками Кра». Щось там дуже складно й заплутано. Щось… чого я не розумію…",shape=box,color=red];
		3962 -> 3964;
	3963 [label="Я не знаю, чи їхнє повернення доведе до добре. Не думаю, що Байдужість від цього передумає.",shape=box,color=red];
		3963 -> 3965;
	3964 [label="Це якось прив’язує Байдужість сюди? Утримує на нашому рівні? Допоки у нас пальці, то воно вимушена грати за нашими правилами.",shape=box,color=red];
		3964 -> 3966;
	3965 [label="Гадаю, що шкоду заподіяно. ",shape=box,color=red];
		3965 -> 3966;
	3966 [label="… мені ніц із цього не подобаєється",shape=box,color=blue];
		3966 -> 3967;
	3967 [label="космподорожі мали бути… веселими. крутими… сповненими… досліджень і зустручей із новими видами",shape=box,color=blue];
		3967 -> 3968;
	3968 [label="це мали бути зухвалі мандрівки. ну я не знаю. в аміра ціла промова є, цитата з серіалу",shape=box,color=blue];
		3968 -> 3969;
	3969 [label="це мала бути пригода про… людяність і емпатію і пізнання",shape=box,color=blue];
		3969 -> 3970;
	3970 [label="а не… таке",shape=box,color=blue];
		3970 -> 3971;
		3970 -> 3972;
