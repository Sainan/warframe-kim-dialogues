		j1500713498 -> j899905061;
		j1500713498 -> j1932581762;
	j899905061 [label="Навіть якби ми знали де вони, я не знаю, чи *взагалі повинні* повертати їх.",shape=box,color=red];
		j899905061 -> j897747934;
	j1932581762 [label="Я знаю. Мені теж від цього не дуже по собі.",shape=box,color=red];
		j1932581762 -> j4053651758;
	j897747934 [label="ти про що?",shape=box,color=blue];
		j897747934 -> j2905613838;
		j897747934 -> j2952514622;
	j4053651758 [label="На жаль, шкоду завдано. Альбрехт забрав пальці. І шляху назад нема.",shape=box,color=red];
		j4053651758 -> j897747934;
	j2905613838 [label="Є дещо, пов’язане з «нитками Кра». Щось там дуже складно й заплутано. Щось… чого я не розумію…",shape=box,color=red];
		j2905613838 -> j1251999806;
	j2952514622 [label="Я не знаю, чи їхнє повернення доведе до добре. Не думаю, що Байдужість від цього передумає.",shape=box,color=red];
		j2952514622 -> j1961244551;
	j1251999806 [label="Це якось прив’язує Байдужість сюди? Утримує на нашому рівні? Допоки у нас пальці, то воно вимушена грати за нашими правилами.",shape=box,color=red];
		j1251999806 -> j613257581;
	j1961244551 [label="Гадаю, що шкоду заподіяно. ",shape=box,color=red];
		j1961244551 -> j613257581;
	j613257581 [label="… мені ніц із цього не подобаєється",shape=box,color=blue];
		j613257581 -> j3483765288;
	j3483765288 [label="космподорожі мали бути… веселими. крутими… сповненими… досліджень і зустручей із новими видами",shape=box,color=blue];
		j3483765288 -> j2196330033;
	j2196330033 [label="це мали бути зухвалі мандрівки. ну я не знаю. в аміра ціла промова є, цитата з серіалу",shape=box,color=blue];
		j2196330033 -> j3610211050;
	j3610211050 [label="це мала бути пригода про… людяність і емпатію і пізнання",shape=box,color=blue];
		j3610211050 -> j3519721783;
	j3519721783 [label="а не… таке",shape=box,color=blue];
		j3519721783 -> j1656488343;
		j3519721783 -> j2216359031;
	j1656488343 [label="Припускаю, ніколи не знаєш напевне. Лише час розсуджує.",shape=box,color=red];
		j1656488343 -> j2225348186;
	j2216359031 [label="Іноді я думаю, чи це не для цього Ентраті мене сюди послав? З вами всіма?",shape=box,color=red];
		j2216359031 -> j299470607;
