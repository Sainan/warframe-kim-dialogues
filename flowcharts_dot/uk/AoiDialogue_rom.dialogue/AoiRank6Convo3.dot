		j3102251595 -> j2468249806;
	j2468249806 [label="але ШО?",shape=box,color=blue];
		j2468249806 -> j1958467684;
		j2468249806 -> j229010717;
	j1958467684 [label="СК;БДД: Альбрехт сунувся в Порожнечу, запанікував, звалив звідти… забравши кілька відірваних пальців Байдужості.",shape=box,color=red];
		j1958467684 -> j2250835421;
	j229010717 [label="Ну. Гаразд. Дивись. Отже. Альбрехт… був першим, хто «винайшов» прохід у Порожнечу.",shape=box,color=red];
		j229010717 -> j436793441;
	j2250835421 [label="по-перше… СК;БДД? о0",shape=box,color=blue];
		j2250835421 -> j1823143270;
	j436793441 [label="Це щось наче як пірнальна капсула. Матеріал — речовина під назвою «сіроскло». Він розтягнув мембрану між світами… вимірами?",shape=box,color=red];
		j436793441 -> j776485116;
	j1823143270 [label="Скажу коротко, бо дуже довго. Це Квінсі навчив.",shape=box,color=red];
		j1823143270 -> j2171598672;
	j776485116 [label="І справи пішли… не зовсім добре, якщо висловитися м’яко. Він запанікував, розхитав капсулу, вона перевернулася й коцнулася об гострий, наче бритва, край мембрани.",shape=box,color=red];
		j776485116 -> j3186166672;
	j2171598672 [label="гм…",shape=box,color=blue];
		j2171598672 -> j2296586485;
	j3186166672 [label="Сіроскляна капсула розбилася, він провалився в Порожнечу.",shape=box,color=red];
		j3186166672 -> j4145452758;
	j2296586485 [label="секундочку",shape=box,color=blue];
		j2296586485 -> j2140369601;
	j4145452758 [label="Коли отямився, то був знову у своїй лабораторії. Але то була не його лабораторія. І він витріщався на себе самого. Але то був не він. І той «він» назвався ім’ям, яке знала лише матір Альбрехта.",shape=box,color=red];
		j4145452758 -> j3096516571;
	j2140369601 [label="******У ТЕ Є ПАЛЬЦІ ТОЇ ХРІНІ?!?!?!****",shape=box,color=blue];
		j2140369601 -> j4013135590;
	j3096516571 [label="Отже, Альбрехт вирішив утекти, рятуючи життя. Порізав себе уламком сіроскла й кров’ю лишив послання для доньки, щоб та закрила мембрану за ним…",shape=box,color=red];
		j3096516571 -> j4034340405;
	j4013135590 [label="І ТИ ВИКОРИСТОВУЄШ ЇХ, ЩОБ ЖИВИТИ СВІЙ РЕЙКОДЖЕК?!?!",shape=box,color=blue];
		j4013135590 -> j2753969910;
	j4034340405 [label="бо відчував, що та «людина» добереться до нього.",shape=box,color=red];
		j4034340405 -> j1052523433;
	j2753969910 [label="<RETRO_EMOJI_HORRIFIED>",shape=box,color=blue];
		j2753969910 -> j1816744949;
	j1052523433 [label="Так вона й зробила. А коли прохід закрився… Ну… пальці начисто відрізало й вони лежали на підлозі.",shape=box,color=red];
		j1052523433 -> j3005658609;
	j1816744949 [label="може саме тому воно біситься!!!",shape=box,color=blue];
		j1816744949 -> j1358855758;
