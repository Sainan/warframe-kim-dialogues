	j658538933 [label="ага. точняк. так або інакше",shape=box,color=blue];
		j658538933 -> j1692125874;
	j2403148513 [label="Навіть якщо для того, щоби прибрати за ним. Щоб це подіяло на всесвіт. Це я про згадану тобою емпатію.",shape=box,color=red];
		j2403148513 -> j2793828302;
	j1692125874 [label="Отже ти хочеш далі поспілкуватися про сонячні рейки?",shape=box,color=red];
		j1692125874 -> j1288302914;
	j2793828302 [label="І я можу лише сподіватися на те, що в кінці виявиться саме так. І увесь цей час не витрачено на біганину з відром та шваброю за якимось божевільним дідом.",shape=box,color=red];
