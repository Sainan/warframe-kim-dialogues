		j4202609717 -> j3779482204;
	j1656697193 [label="про обидва!!! давай про велике зорельотище!!",shape=box,color=blue];
		j1656697193 -> j1409852273;
	j3779482204 [label="Залежить від того, велике чи маленьке судно, але щоб долати великі відстані, вони обидва торкаються Порожнечі. Вони летять крізь Порожнечу.",shape=box,color=red];
		j3779482204 -> j1474803092;
	j1409852273 [label="Ну, великий — мій рейкоджек. У ньому є копія відрізаного пальця Байдужості (ми звемо це релікварійний рушій).",shape=box,color=red];
		j1409852273 -> j1810956461;
	j1474803092 [label="Великий зореліт, рейкоджек, використовує штуку, яку ми звемо релікварійний рушій. Це копія відрізаного пальця Байдужості.",shape=box,color=red];
		j1474803092 -> j3895284234;
	j1810956461 [label="Він використовується для того, щоб торкнутися Порожнечі й подолати велику відстань між планетами. Я лечу крізь Порожнечу.",shape=box,color=red];
		j1810956461 -> j3895284234;
