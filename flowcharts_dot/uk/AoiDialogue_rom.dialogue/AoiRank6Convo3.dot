		3929 -> 3930;
	3930 [label="але ШО?",shape=box,color=blue];
		3930 -> 3931;
		3930 -> 3932;
	3931 [label="СК;БДД: Альбрехт сунувся в Порожнечу, запанікував, звалив звідти… забравши кілька відірваних пальців Байдужості.",shape=box,color=red];
		3931 -> 3933;
	3932 [label="Ну. Гаразд. Дивись. Отже. Альбрехт… був першим, хто «винайшов» прохід у Порожнечу.",shape=box,color=red];
		3932 -> 3934;
	3933 [label="по-перше… СК;БДД? о0",shape=box,color=blue];
		3933 -> 3935;
	3934 [label="Це щось наче як пірнальна капсула. Матеріал — речовина під назвою «сіроскло». Він розтягнув мембрану між світами… вимірами?",shape=box,color=red];
		3934 -> 3936;
	3935 [label="Скажу коротко, бо дуже довго. Це Квінсі навчив.",shape=box,color=red];
		3935 -> 3937;
	3936 [label="І справи пішли… не зовсім добре, якщо висловитися м’яко. Він запанікував, розхитав капсулу, вона перевернулася й коцнулася об гострий, наче бритва, край мембрани.",shape=box,color=red];
		3936 -> 3938;
	3937 [label="гм…",shape=box,color=blue];
		3937 -> 3939;
	3938 [label="Сіроскляна капсула розбилася, він провалився в Порожнечу.",shape=box,color=red];
		3938 -> 3940;
	3939 [label="секундочку",shape=box,color=blue];
		3939 -> 3941;
	3940 [label="Коли отямився, то був знову у своїй лабораторії. Але то була не його лабораторія. І він витріщався на себе самого. Але то був не він. І той «він» назвався ім’ям, яке знала лише матір Альбрехта.",shape=box,color=red];
		3940 -> 3942;
	3941 [label="******У ТЕ Є ПАЛЬЦІ ТОЇ ХРІНІ?!?!?!****",shape=box,color=blue];
		3941 -> 3943;
	3942 [label="Отже, Альбрехт вирішив утекти, рятуючи життя. Порізав себе уламком сіроскла й кров’ю лишив послання для доньки, щоб та закрила мембрану за ним…",shape=box,color=red];
		3942 -> 3944;
	3943 [label="І ТИ ВИКОРИСТОВУЄШ ЇХ, ЩОБ ЖИВИТИ СВІЙ РЕЙКОДЖЕК?!?!",shape=box,color=blue];
		3943 -> 3945;
	3944 [label="бо відчував, що та «людина» добереться до нього.",shape=box,color=red];
		3944 -> 3946;
	3945 [label="<RETRO_EMOJI_HORRIFIED>",shape=box,color=blue];
		3945 -> 3947;
	3946 [label="Так вона й зробила. А коли прохід закрився… Ну… пальці начисто відрізало й вони лежали на підлозі.",shape=box,color=red];
		3946 -> 3948;
	3947 [label="може саме тому воно біситься!!!",shape=box,color=blue];
		3947 -> 3949;
