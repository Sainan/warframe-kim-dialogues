		2831 -> 2835;
		2831 -> 2834;
	2835 [label="Вибач за розчарування. Він той, хто тобі потрібен. Відмовився від куви, яка дозволяє їм бути безсмертними. Не погодився на модну довгу руку. Нічого з цього.",shape=box,color=red];
