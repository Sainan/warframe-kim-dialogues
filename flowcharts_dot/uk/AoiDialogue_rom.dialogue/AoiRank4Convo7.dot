	2974 [label="Музика може визначати спогади. «Усмішка Юрана» — це пісня, яка була почута мною в думка… у спогадах людини, яка втратила все.",shape=box,color=red];
		2974 -> 2977;
	2975 [label="Музика може давати надію. Є щось у тому, щоб знати, що ми «Нумо разом», чи не так?",shape=box,color=red];
		2975 -> 2978;
	2976 [label="Музика може бути злом, Аой. Ці люди, яких я намагався врятувати, були прокляті піснею. «За Нармер» — співали вони.",shape=box,color=red];
