	2925 [label="я знайшла спосіб грати на фортепіано, насправді грати будь-яку музику, не думаючи про «мову Порожнечі»",shape=box,color=blue];
		2925 -> 2926;
	2929 [label="На це питання нелегко відповісти. Звуки, слова, висловлювання з Порожнечі. Більше схоже на прокляття. Передача чогось до тих вух, які можуть це почути.",shape=box,color=red];
		2929 -> 2948;
	2930 [label="Це те, що я більше ніколи не хочу чути.",shape=box,color=red];
		2930 -> 2949;
	2931 [label="Я думаю, що це мова того, що все це спричиняє. Як воно говорить.",shape=box,color=red];
		2931 -> 2953;
	2928 [label="легше почати урок фортепіано таким чином, тому що я не можу знайти фортепіано. тож давай триматися теорії.",shape=box,color=blue];
