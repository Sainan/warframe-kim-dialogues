		2956 -> 2960;
	2935 [label="ура! тож, для розуміння, музика тут завжди була дуже важливою. Хлопці та дівчата сідали за фортепіано замість телевізора і просто творили.",shape=box,color=blue];
		2935 -> 2936;
	2938 [label="ну, досить ретельно? я не була впевнена, чи варто заходити в порожні квартири…",shape=box,color=blue];
		2938 -> 2940;
	2939 [label="гм, вони великі і їх важко сховати… Сумніваюся, що Віктор і «Скальдра» грають.",shape=box,color=blue];
		2939 -> 2940;
	2952 [label="Chat ends.",color=orange];
	2957 [label="Вона достатньо потужна, щоб змінити життя. Є тварини, яких я знаю. Друзі, так би мовити. Кавії. Вони доторкнулися до Порожнечі та навчилися *говорити*, як за помахом чарівної палички.",shape=box,color=red];
		2957 -> 2959;
	2960 [label="Це причина того, що стільки болю.",shape=box,color=red];
		2960 -> 2961;
		2960 -> 2962;
	2936 [label="грати… писати… це справді пісня, це ніби спілкуватися через музику. тут навіть не потрібні тексти!",shape=box,color=blue];
		2936 -> 2937;
	2940 [label="ох. «Скальдра». вони, мабуть, знищили їх. чому вони дозволять вижити в цьому місці чомусь обнадійливому як інструмент?",shape=box,color=blue];
		2940 -> 2941;
	2959 [label="А починалося це так безнадійно. Так неправильно. Мова Порожнечі лише дозволила цим істотам спочатку відчути одне — безнадійність.",shape=box,color=red];
		2959 -> 2958;
	2961 [label="Я не можу це чути.",shape=box,color=red];
