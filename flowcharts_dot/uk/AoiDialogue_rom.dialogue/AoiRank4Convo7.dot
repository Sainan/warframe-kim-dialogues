		2933 -> 2939;
	2954 [label="ну тепер мені справді треба знайти тобі якусь музику. просто подумай про це. заглуши цю «мову Порожнечі» власною піснею, добре?",shape=box,color=blue];
		2954 -> 2955;
		2954 -> 2956;
	2950 [label="Давай залишимо все як є. [Завершити розмову]",shape=box,color=red];
		2950 -> 2952;
	2951 [label="У певному сенсі, мабуть.",shape=box,color=red];
		2951 -> 2953;
	2955 [label="Я дійсно не знаю, як це описати. Але вона потужна.",shape=box,color=red];
		2955 -> 2957;
