		j1528013252 -> j2367876194;
	j2367876194 [label="і коли я побачила, що музику використовують для того, щоб завдавати болю, це зламало щось у мені, як у дитині. я не розуміла.",shape=box,color=blue];
		j2367876194 -> j2471461529;
	j2471461529 [label="я й досі не розумію. Але тоді я знала, що можу дати відсіч, не піднімаючи кулаки, навіть якщо це означало б зганьбити себе.",shape=box,color=blue];
