		2943 -> 2944;
	2945 [label="Будь ласка. розкажи мені про пісню.",shape=box,color=blue];
		2945 -> 2974;
		2945 -> 2975;
		2945 -> 2976;
	2965 [label="ти не думаєш, що музика може пробитися і стати надією? для всіх? для всього? якщо мова Порожнечі — це «магія», то музика теж.",shape=box,color=blue];
		2965 -> 2967;
