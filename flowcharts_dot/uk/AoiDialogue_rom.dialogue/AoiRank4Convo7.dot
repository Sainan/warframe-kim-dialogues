		j3255770973 -> "Chat ends.";
	j4190451052 [label="+10 Chemistry",color=orange];
		j4190451052 -> j4108013001;
	j3424911980 [label="Музика може визначати спогади. «Усмішка Юрана» — це пісня, яка була почута мною в думка… у спогадах людини, яка втратила все.",shape=box,color=red];
		j3424911980 -> j2793082337;
