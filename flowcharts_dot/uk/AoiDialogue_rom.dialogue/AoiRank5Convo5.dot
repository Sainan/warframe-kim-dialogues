digraph {
	3513 [label="AoiRank5Convo5 begins.",color=orange];
		3513 -> 3514;
		3513 -> 3515;
	3514 [label="Одна річ, яка мене дійсно захоплює в тобі, — це твоя непохитна відданість побудові ліпшого світу. Звідки це в тебе?",shape=box,color=red];
		3514 -> 3516;
	3515 [label="У тебе вражаюча кількість енергії. Що запалює в тобі вогонь?",shape=box,color=red];
		3515 -> 3516;
	3516 [label="ого, дякую за ці слова. ем-м… гм-м. немає якогось великого визначального моменту, який би визначив мій життєвий шлях чи щось таке.",shape=box,color=blue];
		3516 -> 3517;
	3517 [label="наскільки я можу судити, я успадкувала це від батьків. вони були практичними людьми, але й мрійниками",shape=box,color=blue];
		3517 -> 3518;
	3518 [label="я маю на увазі, що ти не будеш будувати ракети для дослідження космосу, якщо ти не мрійник.",shape=box,color=blue];
		3518 -> 3519;
		3518 -> 3520;
		3518 -> 3521;
	3519 [label="Стривай. Твої батьки будували ракети?",shape=box,color=red];
		3519 -> 3522;
	3520 [label="Це до біса сімейний бізнес. Схоже, вони встановили високу планку.",shape=box,color=red];
		3520 -> 3523;
	3521 [label="Це не зовсім звичайна сімейна спадщина. Чи говорили вони про те, що їх надихало?",shape=box,color=red];
		3521 -> 3524;
	3522 [label="ну тато будував. а мама знала, як це зробити.",shape=box,color=blue];
		3522 -> 3525;
	3523 [label="так… і коли я стала солдатом, вони чітко дали зрозуміти, що це не зовсім те життя, яке вони сподівалися для мене побудувати.",shape=box,color=blue];
		3523 -> 3525;
	3524 [label="не багато. вони не дуже любили ділитися своїми мріями вголос. думаю, вони вірили, що їхній внесок у розвиток світу скаже все за них.",shape=box,color=blue];
		3524 -> 3525;
	3525 [label="тато був аерокосмічним інженером. мама викладала проєктування космічних систем в університеті, де вони познайомилися ще студентами.",shape=box,color=blue];
		3525 -> 3527;
		3525 -> 3526;
		3525 -> 3528;
	3527 [label="Ого, ваш будинок був наполовину мозковим центром, наполовину стартовим майданчиком.",shape=box,color=red];
		3527 -> 3530;
	3526 [label="З ними, мабуть, було цікаво спілкуватися.",shape=box,color=red];
		3526 -> 3529;
	3528 [label="Звучить так, ніби вони були геніальними. Мабуть, було неймовірно круто рости в такому оточенні.",shape=box,color=red];
		3528 -> 3529;
	3530 [label="ха-ха не зовсім. здебільшого було тихо.",shape=box,color=blue];
		3530 -> 3531;
	3529 [label="ага, гадаю, що так",shape=box,color=blue];
		3529 -> 3532;
	3531 [label="багато наших розмов зводилися до «привіт, люба» і «привіт» мимохідь. потім вони вечеряли по дорозі до офісу, щоби попрацювати допізна чи ще щось",shape=box,color=blue];
		3531 -> 3533;
	3532 [label="але більшість наших розмов зводилися до «привіт, люба» і «привіт», коли ми проходили повз один одного на кухні. вони швидко перекушували та поверталися до своїх офісів, щоби працювати допізна",shape=box,color=blue];
		3532 -> 3533;
	3533 [label="вони були зайняті",shape=box,color=blue];
		3533 -> 3534;
	3534 [label="поки я не потрапляла в неприємності, вони за мене не дуже хвилювалися. і незважаючи на весь той вогонь, що був у мене всередині, я дуже добре трималася подалі від неприємностей.",shape=box,color=blue];
		3534 -> 3535;
		3534 -> 3536;
		3534 -> 3537;
	3535 [label="Я розумію. Мої батьки теж завжди були зайняті. Управляння «Зарименом» було випробуванням для всіх. Проте ми завжди знаходили час, щоби принаймні поїсти разом.",shape=box,color=red];
		3535 -> 3538;
	3536 [label="У цьому є сенс. Коли робота так сильно затягує, часу залишається небагато, але я маю впевненість, що вони постійно думали про тебе.",shape=box,color=red];
		3536 -> 3539;
	3537 [label="Не можу сказати, що я їх звинувачую. Не з чуток знаю, що космічні подорожі не залишають місця для простою. Схоже, ти полегшила їм життя, не висовуючись.",shape=box,color=red];
		3537 -> 3540;
	3538 [label="+5 Chemistry",color=orange];
		3538 -> 3541;
	3539 [label="+5 Chemistry",color=orange];
		3539 -> 3542;
	3540 [label="ага, гадаю що так.",shape=box,color=blue];
		3540 -> 3545;
	3541 [label="це мило. я рада, що ви це робили.",shape=box,color=blue];
		3541 -> 3543;
	3542 [label="можливо",shape=box,color=blue];
		3542 -> 3544;
	3545 [label="я сподіваюся, що так.",shape=box,color=blue];
		3545 -> 3546;
	3543 [label="зараз я розумію, наскільки важливими є ці моменти, але коли я зростала, мені не здавалося дивним, що в мене їх не так багато.",shape=box,color=blue];
		3543 -> 3546;
	3544 [label="насправді так, я думаю це правда :)",shape=box,color=blue];
		3544 -> 3546;
	3546 [label="я розумію, чому мої батьки були так зосереджені на своїй роботі. по-своєму, так вони виявляли любов. вони хотіли забезпечити мене і створити технологію, яка могла би допомогти людству мати ліпше майбутнє",shape=box,color=blue];
		3546 -> 3547;
	3547 [label="озираючись назад, це навіть прекрасно",shape=box,color=blue];
		3547 -> 3548;
		3547 -> 3549;
		3547 -> 3550;
	3548 [label="Можливо, так, але я все ще не можу змиритися з тим, що їхня донька не проводила з ними більше часу. У нас так мало часу в цьому житті, розумієш? Ми повинні проводити якомога більше часу з людьми, яких ми любимо.",shape=box,color=red];
		3548 -> 3551;
	3549 [label="Прекрасно, звісно, але й практично. Вони робили те, що мало значення, а важливіше за це нічого не буває.",shape=box,color=red];
		3549 -> 3554;
	3550 [label="Це потужний вид любові, навіть якщо це не та любов, яка сидить за обіднім столом.",shape=box,color=red];
		3550 -> 3552;
	3551 [label="+5 Chemistry",color=orange];
		3551 -> 3553;
	3554 [label="досі не можу не думати про те, що ми не проводили багато часу разом.",shape=box,color=blue];
		3554 -> 3556;
	3552 [label="+5 Chemistry",color=orange];
		3552 -> 3555;
	3553 [label="саме частина «ми повинні проводити якомога більше» є складною, чи не так? її важко виміряти",shape=box,color=blue];
		3553 -> 3556;
	3556 [label="якщо коли-небудь побачу їх знову, то зроблю все, аби надолужити згаяний час. і знаю, що вони теж так учинять.",shape=box,color=blue];
		3556 -> 3563;
		3556 -> 3558;
		3556 -> 3561;
	3555 [label="так! не така як у фільмах, але дуже реальна.",shape=box,color=blue];
		3555 -> 3556;
	3563 [label="Справедливо. Просто не витрачай час на те, щоб відчувати себе погано через це зараз. Вони зробили свій вибір, а ти — свій. Схоже, ти добре справляєшся з тим, що вони тобі дали.",shape=box,color=red];
		3563 -> 3564;
	3558 [label="Знаєте, це твоє прагнення зробити світ ліпшим… воно глибше, ніж ти собі уявляєш. Ти повинна більше пишатися цим.",shape=box,color=red];
		3558 -> 3557;
	3561 [label="Сподіваюся, у тебе буде така можливість. У тебе серце, сповнене надії та сили. Думаю, вони пишалися б тим, ким ти стала.",shape=box,color=red];
		3561 -> 3560;
	3564 [label="напевно, що так",shape=box,color=blue];
		3564 -> 3567;
		3564 -> 3566;
		3564 -> 3565;
	3557 [label="+5 Chemistry",color=orange];
		3557 -> 3559;
	3560 [label="+5 Chemistry",color=orange];
		3560 -> 3562;
	3567 [label="У тебе їхній розум і запал, але ти зробила їх своїми. Ось що важливо.",shape=box,color=red];
		3567 -> 3570;
	3566 [label="Мені здається, що ти стала такою люблячою, уважною людиною, якої потребувала в молодості. Це те, чим варто пишатися.",shape=box,color=red];
		3566 -> 3568;
	3565 [label="Ти взяла все, що вони тобі дали, і побудувала на цьому — не лише з мріями та запалом, але й співчуттям. Це нелегко зробити.",shape=box,color=red];
		3565 -> 3569;
	3559 [label="о? як це?",shape=box,color=blue];
		3559 -> 3567;
		3559 -> 3566;
		3559 -> 3565;
	3562 [label="це багато для мене значить. я теж на це сподіваюся.",shape=box,color=blue];
		3562 -> 3567;
		3562 -> 3566;
		3562 -> 3565;
	3570 [label="це… насправді дуже класний спосіб подумати про це.",shape=box,color=blue];
		3570 -> 3573;
		3570 -> 3572;
		3570 -> 3574;
	3568 [label="+5 Chemistry",color=orange];
		3568 -> 3571;
	3569 [label="+5 Chemistry",color=orange];
		3569 -> 3571;
	3573 [label="Як це бачу так і називаю.",shape=box,color=red];
		3573 -> 3575;
	3572 [label="Завжди до твоїх послуг.",shape=box,color=red];
		3572 -> 3575;
	3574 [label="Ти заслуговуєш на те, щоб це почути.",shape=box,color=red];
		3574 -> 3575;
	3571 [label="я ніколи раніше не думала про це в такому сенсі. це… дуже гарний погляд на речі. дякую.",shape=box,color=blue];
		3571 -> 3573;
		3571 -> 3572;
		3571 -> 3574;
	3575 [label="<3",shape=box,color=blue];
