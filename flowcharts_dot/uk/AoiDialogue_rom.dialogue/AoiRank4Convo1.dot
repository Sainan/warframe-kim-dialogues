		2266 -> 2269 [label=false,color=brown];
	2339 [label="Звичайно. Я маю на увазі… я не дуже добре її знаю? Маля знає її ліпше за мене. Але вона врятувала мені життя.",shape=box,color=red];
		2339 -> 2341;
	2340 [label="Я в боргу перед нею, вона врятувала мені життя. Тож коли її знадобилася моя поміч тут, я відгукнувся.",shape=box,color=red];
		2340 -> 2342;
	2267 [label="Ха. Гаразд, пам’ятаєш тих реальних драконів, про яких ми говорили? Вони там були.",shape=box,color=red];
		2267 -> 2270;
	2269 [label="Дувірі може бути прекрасним, але він… також небезпечний, як і всі казкові світи. Наповнений монстрами та уроками, які потрібно засвоїти.",shape=box,color=red];
		2269 -> 2272;
	2268 [label="Тобі це сподобається. У Дувірі є літаючі дракони, які називаються орозміями.",shape=box,color=red];
		2268 -> 2271;
	2341 [label="маля? яке маля?",shape=box,color=blue];
