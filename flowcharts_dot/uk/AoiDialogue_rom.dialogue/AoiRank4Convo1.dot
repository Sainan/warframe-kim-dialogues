	2271 [label="<RETRO_EMOJI_WHOA>",shape=box,color=blue];
		2271 -> 2273;
	2343 [label="Версія мене з цього часовому проміжку, яка не постаріла, бо застрягла в стазисній капсулі на Луа, яку Лотос — яка згодом врятувала мене — на деякий час відправила разом з малям у Порожнечу, щоб убезпечити всіх…",shape=box,color=red];
		2343 -> 2345;
	2344 [label="Так. Ага. Отже. Технічно, це я з альтернативного часового проміжку. Інша версія мене не так сильно постаріла, тому що… розумієш? Це довга історія.",shape=box,color=red];
		2344 -> 3059;
	2365 [label="Дувірі став для мене… пасткою. Апатією. Забуттям — хто я. Чому я там.",shape=box,color=red];
		2365 -> 2367;
	2366 [label="Іноді, коли ти застрягаєш на дні свого життя… тобі просто потрібна рука допомоги.",shape=box,color=red];
		2366 -> 2368;
	2285 [label="Ти знаєш, як я можу використовувати Перенесення для керування вами? Я також можу використати Перенесення для керування орозмієм. Це *дійсно* дивно.",shape=box,color=red];
		2285 -> 2287;
	2286 [label="Вони можуть бути такими, якщо не намагаються тебе вбити.",shape=box,color=red];
		2286 -> 2289;
	2274 [label="У нас є злий король-дитина на ім’я Домін Тракс.",shape=box,color=red];
		2274 -> 2279;
	2275 [label="У нас є цілий ряд персонажів, кожен з яких страждає від власної жахливої передісторії. Кожен із них уособлює емоцію.",shape=box,color=red];
		2275 -> 2280;
	2273 [label="дракони?! як реальні дракони?!?!",shape=box,color=blue];
