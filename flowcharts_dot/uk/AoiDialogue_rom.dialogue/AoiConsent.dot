		j2246184576 -> j603364094;
	j603364094 [label="дійшло хах",shape=box,color=blue];
		j603364094 -> j2062834982;
	j2062834982 [label="<RETRO_EMOJI_WINK>",shape=box,color=blue];
		j2062834982 -> j303796151;
		j2062834982 -> j1169811400;
	j303796151 [label="Справді?",shape=box,color=red];
		j303796151 -> j1157143348;
	j1169811400 [label="Га?..",shape=box,color=red];
		j1169811400 -> j1157143348;
	j1157143348 [label="угу!!",shape=box,color=blue];
		j1157143348 -> j2379749575;
	j2379749575 [label="гадаю є лиш питання чи я з ними побачусь чи ні?",shape=box,color=blue];
		j2379749575 -> j2024127334;
	j2024127334 [label="ох… це ж… це ж не хтось з прокльону, ні? чи з круглого столу? бо було трохи фе",shape=box,color=blue];
		j2024127334 -> j1248466931;
	j1248466931 [label="Ні, ви не знайомі. І на жаль, я не знаю, чи зможу організувати знайомство. Вони не з цього часу.",shape=box,color=red];
		j1248466931 -> j1873878539;
	j1873878539 [label="трясця!!! то маєш обіцяти, що зі мною буде двічі більше всього і розваг в тому числі",shape=box,color=blue];
		j1873878539 -> j711946775;
	j711946775 [label="але ви щасливі разом?",shape=box,color=blue];
		j711946775 -> j2633851607;
	j2633851607 [label="Так. І до тебе почуття не менші. Ви обоє дуже важливі для мене.",shape=box,color=red];
		j2633851607 -> j2135724816;
	j2135724816 [label="+20 Chemistry",color=orange];
