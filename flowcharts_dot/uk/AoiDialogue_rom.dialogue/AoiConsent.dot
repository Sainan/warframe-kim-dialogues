		4256 -> 4257;
	4257 [label="Ні-ні! Нічого! Мені потрібно поговорити з тобою про… сподіваюся, це не буде дуже незручно для тебе.",shape=box,color=red];
		4257 -> 4258;
	4258 [label="Не хочу ставити тебе в незручне становище. Ми раніше цього не обговорювали. Тож якщо відмовиш, то це нічого. Просто хочу, щоб ти знала.",shape=box,color=red];
		4258 -> 4259;
	4259 [label="Те, що в нас є, важливе для мене. Дуже-дуже. І воно реальне. Я не хочу, щоб ти сумнівався в цьому.",shape=box,color=red];
