	4268 [label="ох… це ж… це ж не хтось з прокльону, ні? чи з круглого столу? бо було трохи фе",shape=box,color=blue];
		4268 -> 4269;
	4269 [label="Ні, ви не знайомі. І на жаль, я не знаю, чи зможу організувати знайомство. Вони не з цього часу.",shape=box,color=red];
		4269 -> 4270;
	4270 [label="трясця!!! то маєш обіцяти, що зі мною буде двічі більше всього і розваг в тому числі",shape=box,color=blue];
