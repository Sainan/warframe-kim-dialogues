		j379056631 -> "Chat ends.";
	j3895037289 [label="Хочу обговорити з тобою дещо, дізнатися, чи ти не проти.",shape=box,color=red];
		j3895037289 -> j1148229937;
	j1148229937 [label="Я не хочу, щоб у тебе була думка, що я брешу чи якось нечесно поводжуся.",shape=box,color=red];
		j1148229937 -> j1724373675;
	j1724373675 [label="<RETRO_EMOJI_OHNO>",shape=box,color=blue];
		j1724373675 -> j1110335861;
	j1110335861 [label="що я зробила?",shape=box,color=blue];
		j1110335861 -> j2514237937;
	j2514237937 [label="Ні-ні! Нічого! Мені потрібно поговорити з тобою про… сподіваюся, це не буде дуже незручно для тебе.",shape=box,color=red];
		j2514237937 -> j3433444521;
	j3433444521 [label="Не хочу ставити тебе в незручне становище. Ми раніше цього не обговорювали. Тож якщо відмовиш, то це нічого. Просто хочу, щоб ти знала.",shape=box,color=red];
		j3433444521 -> j3144000444;
	j3144000444 [label="Те, що в нас є, важливе для мене. Дуже-дуже. І воно реальне. Я не хочу, щоб ти сумнівався в цьому.",shape=box,color=red];
		j3144000444 -> j1851688633;
	j1851688633 [label="оооооооооооооох",shape=box,color=blue];
		j1851688633 -> j2246184576;
