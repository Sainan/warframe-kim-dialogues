	3395 [label="але вся ця історія з поплічником? я могла сказати, що він почувався… малим.",shape=box,color=blue];
		3395 -> 3396;
	3396 [label="я завжди знала, що такий великий гакер як він може бути по-своєму героєм",shape=box,color=blue];
		3396 -> 3399;
		3396 -> 3397;
