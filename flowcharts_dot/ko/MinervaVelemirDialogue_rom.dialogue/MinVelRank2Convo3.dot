		474 -> 478;
	475 [label="MomToxicated: 네가 광신도라는 단어를 사용한 점에 대해 이의를 제기하고 싶군. 하지만 너의 관점을 이해하고, 그 애와 상호작용한 것을 고려하면, 그게 네가 물을 수 있는 전부라고 생각한다.",shape=box,color=blue];
		475 -> 479;
	476 [label="MomToxicated: 난 그 애가 스스로가 가진 잠재력을 최대치로 발휘하도록 키웠다. 무슨 말이 하고 싶은 거지?",shape=box,color=blue];
		476 -> 480;
	477 [label="PapaPolar: 걔 엄마 *만나봤어*?",shape=box,color=blue];
		477 -> 481;
	478 [label="PapaPolar: 이런.",shape=box,color=blue];
		478 -> 482;
	479 [label="MomToxicated: 네시가 스칼드라에 합류했을 당시, 그것이 목적을 위한 수단이었다고 생각한다. 그 애는 주변에 있는 사람들을 믿었고, 신앙에 대한 확고한 신념보다는 덜 믿었지. 보댜노이와는 다르게 말이야.",shape=box,color=blue];
		479 -> 483;
	480 [label="PapaPolar: 얘가 무슨 말을 하는지 꽤 분명해 보이는데, M",shape=box,color=blue];
		480 -> 484;
	481 [label="MomToxicated: 에헴. 그 애한테 흡연 문제 안겨준 인간이 말하고 있네.",shape=box,color=blue];
		481 -> 485;
	482 [label="PapaPolar: 봐라. 난 그 애가 그 모든... 솔-루아 광신주의에 정말로 빠져 있었는지조차도 확신할 수 없다",shape=box,color=blue];
		482 -> 486;
	483 [label="MomToxicated: 그 아이는 항상 야망있는 여성이었어. 내가 그 야망을 격려하고, 키우고, 불을 지펴줬지. 그 아이를 얼려버리고 어린 시절에 억류하고 싶어 했던 *누군가*와는 달리.",shape=box,color=blue];
		483 -> 487;
	484 [label="PapaPolar: 아이는 부모를 닮는다는 말이야, 자기",shape=box,color=blue];
		484 -> 488;
	485 [label="PapaPolar: 그래 그리고 내가 말하고 싶은 건 아이는 부모를 닮는다는 말이야, 자기",shape=box,color=blue];
		485 -> 489;
	486 [label="PapaPolar: 적어도 나머지 스칼드라들만큼은 그러지 않았어. 뭔가 빠진 척하는 건 항상 목적을 달성하기 위한 그 애의 수단이었던 것 같으니까. ",shape=box,color=blue];
		486 -> 490;
	487 [label="PapaPolar: 내가 그 애한테 가도 된다고 말했어, 안 그래?!",shape=box,color=blue];
		487 -> 491;
	488 [label="MomToxicated: 아주 재밌어. 정말 끔찍할 정도로 똑똑해. 당신의 그 압도적인 재치에 박수를 보낼게. 난 적어도 그 애한테 흡연 문제를 주진 않았어.",shape=box,color=blue];
		488 -> 492;
	489 [label="PapaPolar: 그 애가 배운 건 스스로에게 효과가 있기 때문에 배운 것도 있지만, 어딘가에서 그 점을 얻었어. 그건 부정 못 하겠다.",shape=box,color=blue];
		489 -> 493;
	490 [label="PapaPolar: 맨 위에 뭐가 있든지 간에, 사다리 맨 위에 올라가는 것 자체에 의미를 두는 사람도 있으니까.",shape=box,color=blue];
		490 -> 494;
	491 [label="MomToxicated: 오, 그래. 그 참을 수 없는 행동 없이 그 애가 스스로를 표현하도록 내버려둔 *한 번*이 당신이 내 말 듣지 않고, 날 믿지 않고 그 애가 떠나게 내버려둔 그 *한 번*이었어. 그리고 뭔 일이 일어났는지 보라고!",shape=box,color=blue];
		491 -> 495;
	492 [label="MomToxicated: 벨리미르가 - 꽤 형편없는 - 저질 농담을 하는 이유는, 여자로서 상황에 접근하는 데 선택의 폭이 제한될 때가 있다는 말이야.",shape=box,color=blue];
		492 -> 496;
	493 [label="PapaPolar: 봐라, 군에 있을 때, 가끔은 그냥..스스로가 가지고 있는 자산을 활용해야 해, 알지?",shape=box,color=blue];
		493 -> 497;
	494 [label="MomToxicated: 그 애한텐 야망이 있었어. 당신은 항상 그 애가 그런 맘을 가지는 걸 반대해 왔지만.",shape=box,color=blue];
		494 -> 498;
	495 [label="PapaPolar: 그러면 도대체 난 몇 번이나 빌어먹을 사과를 해야 하는데!!",shape=box,color=blue];
		495 -> 499;
	496 [label="MomToxicated: 그리고, 만약 네가 특정한... \"자산\"을 가지고 태어날 만큼 운이 좋다면, 가끔은 유용하게 써먹을 수도 있지.",shape=box,color=blue];
