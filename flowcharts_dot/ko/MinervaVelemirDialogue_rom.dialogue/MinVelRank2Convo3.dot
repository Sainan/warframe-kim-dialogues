		539 -> 547;
	540 [label="MomToxicated: 그녀는 리더십이 무엇을 의미하는지 알았기에 병사들로부터 존경을 받았다. 후방에서 명령을 지껄이는 게 아니라, 사람들에게 자신이 그들을 위해 싸울 것이라는 걸 보여줬다. 그들과 함께할 거라고.",shape=box,color=blue];
		540 -> 548;
	541 [label="MomToxicated: 반짝이는 것들. 물 속에서 빛나는 미끼가 가까이에 있는 크고 멍청한 물고기들 모두를 유혹하는 것처럼. 그리고 사냥감들을 잡아버리지. 그게 나의 작은 아가야.",shape=box,color=blue];
