		j4212676074 -> j51922879;
	j3428972815 [label="MomToxicated: 그녀는 리더십이 무엇을 의미하는지 알았기에 병사들로부터 존경을 받았다. 후방에서 명령을 지껄이는 게 아니라, 사람들에게 자신이 그들을 위해 싸울 것이라는 걸 보여줬다. 그들과 함께할 거라고.",shape=box,color=blue];
		j3428972815 -> j1370986891;
