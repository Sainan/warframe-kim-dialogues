		j1792323360 -> j4170988525;
	j1446728976 [label="MomToxicated: 어쩌면 언젠가 그 사과가 죽은 이를 되살려낼지도 모르잖아. 그때까지? 그 말은 당신처럼 나에겐 쓸모없어.",shape=box,color=blue];
