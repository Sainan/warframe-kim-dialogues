		4 -> 7;
	5 [label="음.",shape=box,color=red];
		5 -> 7;
	6 [label="그리고 이건...?",shape=box,color=red];
		6 -> 7;
	7 [label="PapaPolar: 그렇게까지 나올 필요는 없잖아. 우선 \"안녕, 넌 잘 지내니?\" 부터 시작해야지.",shape=box,color=blue];
		7 -> 8;
	8 [label="PapaPolar: 미안하다, 친구야. M은 눈 앞에 목표물이 있으면, 바로 돌격 앞으로를 해버리거든.",shape=box,color=blue];
		8 -> 9;
	9 [label="MomToxicated: 당신이 나 깎아내리는 거 원하지 않는데?",shape=box,color=blue];
		9 -> 10;
	10 [label="PapaPolar: 나 안 그랬는데?",shape=box,color=blue];
		10 -> 11;
	11 [label="MomToxicated: 하. 그래. 그렇겠지. 얄체스코에서 나 깎아내리지 않았던 것처럼 말이야.",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="미네르바랑 벨리미르, 맞지?",shape=box,color=red];
		12 -> 14;
	13 [label="알았어... 우리 본론으로 돌아가 볼까? 뭐가 어떻게 돌아가는 거야?",shape=box,color=red];
		13 -> 15;
	14 [label="PapaPolar: 맞아. 미안하다. 안녕. 내가 누군지 알아맞히는 거 가장 쉬웠지, 응? ㅋㅋㅋ",shape=box,color=blue];
		14 -> 16;
	15 [label="PapaPolar: 하! 미안, 친구야. 벨리미르라고 한다. 그리고 여기 있는 MomToxicated는 미네르바야.",shape=box,color=blue];
		15 -> 17;
	16 [label="PapaPolar: 여기 있는 MomToxicated는 미네르바야.",shape=box,color=blue];
		16 -> 17;
	17 [label="MomToxicated: 벨리미르. 애초에 이럴 거면 이 방법을 사용하는 요점이 - ",shape=box,color=blue];
		17 -> 18;
	18 [label="MomToxicated: 제기랄.",shape=box,color=blue];
		18 -> 19;
	19 [label="PapaPolar: M, 합리적으로 굴자고. 소거 절차잖아. 이 시스템에서 우리 같은 괴물이 얼마나 더 있을까?",shape=box,color=blue];
		19 -> 20;
		19 -> 21;
		19 -> 22;
	20 [label="시간이 지날수록 점점 더 많이 생길 것 같은 느낌이 들어.",shape=box,color=red];
		20 -> 23;
	21 [label="둘이서 뭐가 일어나고 있는지 정리한 *다음*, 와서 얘기해줄래?",shape=box,color=red];
		21 -> 24;
	22 [label="지금 완전 혼란스러워.",shape=box,color=red];
		22 -> 25;
	23 [label="Update boolean VelimirFamily1",color=orange];
