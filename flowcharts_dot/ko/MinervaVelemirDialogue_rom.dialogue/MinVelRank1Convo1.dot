digraph {
	0 [label="MinVelRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="MomToxicated: 걔한테 무슨 일 생긴 거야? 답이 필요해.",shape=box,color=blue];
		1 -> 2;
	2 [label="MomToxicated: 진짜 답 말이야. 그리고 다른 애들이 나한테 말해주는 \"설명하기 어렵다\"는 식의 헛소리는 필요 없어.",shape=box,color=blue];
		2 -> 3;
		2 -> 4;
		2 -> 5;
		2 -> 6;
