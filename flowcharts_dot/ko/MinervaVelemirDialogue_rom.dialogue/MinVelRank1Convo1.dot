	24 [label="PapaPolar: 그럼 꽤 오랫동안 기다려야 할 거야, 이 친구야. 하.",shape=box,color=blue];
		24 -> 27;
	25 [label="PapaPolar: *네*가 혼란스럽다면, 그럼 우리 모두 망한 거겠지, 뭐. 하!",shape=box,color=blue];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="PapaPolar: 요점은 이거야. 여기 있는 M은 질문이 있고, 답을 얻길 원해, 그리고 네가 그 질문에 답하기를 바라고 있어.",shape=box,color=blue];
		27 -> 30;
	28 [label="PapaPolar: 우리가 여기 온 이유는 바로 너에게서 답을 얻고자 함이었어.",shape=box,color=blue];
		28 -> 30;
	29 [label="PapaPolar: 나도 그렇기를 바란다고! 사람이야 많으면 많을수록 더 즐거운 법이니까. 옛 속담 중에 '종교와 컬트의 유일한 차이점은 인원 수'라고 하잖아, 하하.",shape=box,color=blue];
		29 -> 31;
	30 [label="PapaPolar: 됐다. 훨씬 더 낫지, M? 너의 \"좋은 경찰/나쁜 경찰\" 게임 플랜에 더 잘 맞아 떨어지지?",shape=box,color=blue];
		30 -> 32;
	31 [label="PapaPolar: 그게 속담이었나? ",shape=box,color=blue];
		31 -> 33;
	32 [label="MomToxicated: 하늘에 계신 솔이시여, 비명 지르고 싶어...",shape=box,color=blue];
		32 -> 34;
		32 -> 35;
		32 -> 36;
	33 [label="PapaPolar: 나도 잘 모르겠다. 일단 뭔 말인진 알지? 물도 좋고, 모두 다 있고, 뭐 내가 신경쓰는 한은 일단 그렇잖아! 뭐, 어쨌든.",shape=box,color=blue];
		33 -> 27;
	34 [label="왜 심문받는 기분이 들지?",shape=box,color=red];
		34 -> 37;
	35 [label="뭐. 음. 나와의 대화를 \"게임\"으로 여기지 않았으면 좋겠어.",shape=box,color=red];
		35 -> 38;
	36 [label="뭐에 관해서 묻고 싶은데? 도울 수 있는 부분이라면 도울게.",shape=box,color=red];
		36 -> 39;
	37 [label="MomToxicated: 입도 뻥긋하지 마, 벨리미르.",shape=box,color=blue];
		37 -> 40;
	38 [label="MomToxicated: 이건 게임이 아니야.",shape=box,color=blue];
		38 -> 41;
