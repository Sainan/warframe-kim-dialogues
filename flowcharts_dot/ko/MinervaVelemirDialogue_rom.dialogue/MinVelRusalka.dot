		1901 -> 1902;
	1902 [label="이런 기록들을 찾았거든. 처음에는 조각조각 흩어져서 연결이 안 돼 있었어. 하지만 다 모아놓고 맞춰 보니, 이런... 메시지가 나오더라고.",shape=box,color=red];
		1902 -> 1903;
