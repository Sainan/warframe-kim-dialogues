		1922 -> 1924;
	1923 [label="MomToxicated: 하지만 놈은 뭣 때문에 이런 실낱 같은 희망을 우리에게 보여주려 하는 거지? 그저 우리에게 정신적 타격을 주려는 목적이 아니라면 말이야.",shape=box,color=blue];
		1923 -> 1925;
