		1929 -> 1930;
	1930 [label="PapaPolar: 당신은 모르겠지만, 멍청하기 짝이 없는 내 심장은 그것만으로 따뜻하게 안심이 되네.",shape=box,color=blue];
		1930 -> 1931;
