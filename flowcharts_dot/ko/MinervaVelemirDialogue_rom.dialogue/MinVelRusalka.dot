		1896 -> 1897;
	1897 [label="네시가... 왕위를 찬탈했어. 속삭임 - 달리 뭐라 부를 말이 없으니, 무심의 \"군대\"라고 하는 편이 편하겠지만... 아무튼 그게 두비리를 침략했고, 네시가 그 자리를 차지한 거야.",shape=box,color=red];
		1897 -> 1898;
