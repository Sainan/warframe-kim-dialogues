		1894 -> 1895;
		1894 -> 1896;
	1891 [label="잘... 모르겠어. 죽은 건 아닌 것 같아. 우선 내가 알아낸 걸 말해줄 테니까, 판단은 당신들이 해.",shape=box,color=red];
		1891 -> 1892;
	1895 [label="그게 아무래도 그 녀석에겐 뭐, 성장의 순간이었던 모양이야? 근데 문제는 이게 아니고. 어쨌든간 -",shape=box,color=red];
		1895 -> 1897;
