		1960 -> 1961;
	1961 [label="PapaPolar: 그래, 나도 아주 동감이다, 꼬마. 우리가 너한테 이걸 어떻게 갚을 길이 있을런지나 모르겠다만, 언제든 기회가 생긴다면? 반드시 나설 거라고만 알고 있어라.",shape=box,color=blue];
