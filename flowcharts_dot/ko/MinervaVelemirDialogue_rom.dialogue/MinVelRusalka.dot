		1926 -> 1927;
	1927 [label="PapaPolar: 어쩌면 그저 우리 애가 어딘가에서 아직도 목숨 붙이고 있다는 걸 알 수 있는, 마음의 평화에 더 가깝지 않을까?",shape=box,color=blue];
		1927 -> 1928;
