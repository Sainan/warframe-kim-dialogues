		j373716078 -> j1192901451;
	j1192901451 [label="MomToxicated: 우린 문제를 해결하기 위해 홀바니아에 있다. 그리고 넌 내가 그 문제를 해결하는 데 도움을 줄 수도 있어.",shape=box,color=blue];
		j1192901451 -> j2849868947;
