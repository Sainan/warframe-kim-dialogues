		j3173621264 -> j2594792491;
		j3173621264 -> j1170022395;
	j3811046208 [label="MomToxicated: 그리고, 뭐, 우린 그 애한테 뭐가 일어났는지도 모른 채로 그냥 지내자고 말하는 거야?! 아니면 그 애가 무사할지도?! 아니면 그 애가 더 이상 그 애가 아닐지도 모르는데?!",shape=box,color=blue];
		j3811046208 -> j2949781993;
	j2159928648 [label="PapaPolar: 왜 필요한지는 모르겠어. 반신이면서 보이드 괴물... 같은 것의 움직임을 예측하는 건 어려울 것 같으니까... 내 말이 맞지, 작은 친구?",shape=box,color=blue];
		j2159928648 -> j2173667733;
		j2159928648 -> j3526143151;
