		j3851816442 -> j3937782674;
		j3851816442 -> j3546220295;
	j3118765826 [label="MomToxicated: 그러니 우리는 앉아 있어야 한다고 제안하는 거네. 그게... 뭐. 머리를 내밀 때까지? 그리고 우리가 족제비 잡기라도 해야 한다고 말하는 거야?!",shape=box,color=blue];
		j3118765826 -> j64292902;
