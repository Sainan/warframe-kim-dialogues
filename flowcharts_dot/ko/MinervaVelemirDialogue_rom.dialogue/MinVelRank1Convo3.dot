		j1170022395 -> j1787291313;
	j441484273 [label="PapaPolar: 음악도 꽤 괜찮고 말이야. 그 아서라는 남자는 딱 내 술친구가 될 것 같고",shape=box,color=blue];
		j441484273 -> j3811046208;
	j3763013975 [label="MomToxicated: \"친구들\"이 뭐 때문에 필요한데?! 네시를 구하기 위해 어디로 가야 하는지만 알게 되면 바로 여기서 나갈 거야.",shape=box,color=blue];
		j3763013975 -> j2159928648;
	j3359269723 [label="PapaPolar: 그래서, 혹시 우리가 변화를 불러일으킬 수 있다면, 우린 그걸 할 거야. 그리고 그게 네시를 구하려고 하는 이유기도 해",shape=box,color=blue];
		j3359269723 -> j2594792491;
