	j728039003 [label="내가 왜 도와줘야 하는데?",shape=box,color=red];
		j728039003 -> j438272982;
	j2487637993 [label="그리고 이게 루살카와 무슨 관련이 있지?",shape=box,color=red];
		j2487637993 -> j438272982;
	j438272982 [label="MomToxicated: 그건 정말로 좋은 질문이야.",shape=box,color=blue];
		j438272982 -> j2395385719;
	j2395385719 [label="MomToxicated: 내 목적을 위해 굳이 네가 도와줄 필요는 없어. 우리에겐 공통의 적이 있지. \"벽 속의 남자\" 말이야.",shape=box,color=blue];
		j2395385719 -> j3658224730;
	j3658224730 [label="MomToxicated: 내가 이해하는 한, 우리 둘 다 그가 어디로 갔는지, 무엇을 노리고 있는지, 그리고 애초에 왜 루살카를 표적으로 삼았는지에 대한 관심은 있어.",shape=box,color=blue];
		j3658224730 -> j4279245187;
	j4279245187 [label="MomToxicated: 현 상황에 대한 평가는 정확한가?",shape=box,color=blue];
		j4279245187 -> j4049470322;
		j4279245187 -> j595634879;
		j4279245187 -> j4192879935;
	j4049470322 [label="잠깐 본론으로 돌아가서, 왜 그렇게까지 루살카를 챙기는지에 대해서 설명해 줄래?",shape=box,color=red];
		j4049470322 -> j1787291313;
	j595634879 [label="초반 두 개에 관해선, 그래. 솔직히 말하자면, 난 왜 그 자식이 루살카를 쫓았는지에 대해선 별로 관심 없어.",shape=box,color=red];
		j595634879 -> j460552632;
	j4192879935 [label="그래. 응. 정확해.",shape=box,color=red];
		j4192879935 -> j2594792491;
	j1787291313 [label="MomToxicated: 이유 같은 건 중요치 않아.",shape=box,color=blue];
		j1787291313 -> j4002325155;
	j460552632 [label="MomToxicated: 만약 네가 그 애 신변에 조금이라도 관심이 없다면, 우리가 알고 네가 그랬던 것처럼, 왜 그 애 목숨을 살려준 거야? 우린 그 이야기는 들었어.",shape=box,color=blue];
		j460552632 -> j1168210693;
		j460552632 -> j3852582671;
		j460552632 -> j2291539115;
	j2594792491 [label="그리고 미안하지만, 우린 아마도 벽 속의 남자가 다음 움직임을 보일 때까지 기다려야 할 거야.",shape=box,color=red];
		j2594792491 -> j784688474;
	j4002325155 [label="PapaPolar: 중요하거든. 그렇지만 언제가 됐든 얘가 그걸 알아낼 가능성은 커. 우리가 이렇게 신비스럽게 행동하지 않아도 된다고",shape=box,color=blue];
		j4002325155 -> j3073378671;
	j1168210693 [label="왜냐하면, 그렇게 행동하면 내 행동이 무심과 다를 바 없었을 테니까. 스칼드라와도, 엔트라티와도 말이야. 난 아무 생각 없이 사람들 죽이러 다니진 않아.",shape=box,color=red];
		j1168210693 -> j3646282073;
	j3852582671 [label="왜냐하면, 그 지점으로 이끈 선택을 한 건 루살카가 아니었기 때문이야. 그 순간 그녀를 죽이지 않았다고 해서, 일부러 그녀를 구하기 위해 *신경*을 쓸 정도는 아니다 이 뜻이야.",shape=box,color=red];
		j3852582671 -> j2405414509;
	j2291539115 [label="왜냐하면 내가 엔트라티의 더러운 일을 대신 해줄 생각은 없었기 때문이야. 그 인간이 무심의 새로운 꼭두각시를 죽이고 싶다면, 그 인간 스스로가 해야지.",shape=box,color=red];
		j2291539115 -> j4067793422;
	j784688474 [label="MomToxicated: 그럼 왜 그래야 하는 건데? 그 존재를 추적할 방법이 없어? 그거? 뭐든 간에 말이야? 아니면 그게 진짜로 뭘 쫓는지 몰라서 이러는 거야?",shape=box,color=blue];
		j784688474 -> j3526143151;
		j784688474 -> j2173667733;
	j3073378671 [label="PapaPolar: 그리고 어쩌면, \"정말로 어쩌면\" 당신이 여기에 있는 새로운 작은 친구를 믿고 약간의 정보를 맡긴다면, 얘가 *우리르으으으을 도와줄지도오오오*",shape=box,color=blue];
		j3073378671 -> j4029433744;
	j3646282073 [label="그 말뜻이라면, 내가 의도적으로 사람을 죽인다는 뜻이야. 하지만 난 그러진 않아. 내가 사람들을 죽이긴 하지만, 이건 달라. 뭔 뜻인지 알 거야.",shape=box,color=red];
		j3646282073 -> j3870289075;
	j2405414509 [label="루살카에 관해서 *잘 몰라*.",shape=box,color=red];
		j2405414509 -> j2948796190;
	j4067793422 [label="하지만 내가 의심했던 대로, 그 늙은 개자식은 다시 일어날 수 있을 것 같은 사람들한테만 총으로 쏘는 걸 좋아하더군.",shape=box,color=red];
		j4067793422 -> j3851816442;
	j3526143151 [label="반신-신-같은 존재에 추적 비컨을 부착할 수는 없지.",shape=box,color=red];
		j3526143151 -> j3118765826;
	j2173667733 [label="그 존재의 동기에 대해서 지금 우리도 약간 이해가 안 가. 하지만 좋은 건 아니야.",shape=box,color=red];
		j2173667733 -> j3118765826;
	j4029433744 [label="PapaPolar: 가끔 사람들끼리 일하는 방식이 그런 것 같거든. ",shape=box,color=blue];
		j4029433744 -> j254745849;
	j3870289075 [label="+5 Chemistry",color=orange];
		j3870289075 -> j3820578823;
	j2948796190 [label="PapaPolar: 그리고 우린 너에게 이 문제를 신경 쓸 이유를 주지 않았고. 안 그래, M?",shape=box,color=blue];
		j2948796190 -> j416992816;
