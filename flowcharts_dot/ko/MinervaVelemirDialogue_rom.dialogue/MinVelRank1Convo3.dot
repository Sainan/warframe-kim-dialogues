		j2949781993 -> j1713676267;
	j1713676267 [label="PapaPolar: 난 괜찮다고 한 마디도 말한 적 없어, M! 그냥 앉아서 시간을 기다려야 하는 지점이 있다고 이해하고 있는 거라고!",shape=box,color=blue];
		j1713676267 -> j3347624012;
