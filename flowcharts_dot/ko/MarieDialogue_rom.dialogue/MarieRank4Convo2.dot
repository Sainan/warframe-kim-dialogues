		j3083681803 -> j1164970980;
		j3083681803 -> j1322829322;
		j3083681803 -> j883999271;
		j3083681803 -> j1977153765;
	j1168021739 [label="당신의 신앙은 마치 당신이 만들어낸 역사처럼 당신에게 있어서 개인적인 것이라고 하셨지만, 그럼에도 불구하고 그건 신앙입니다. 당신은 왜 그리 믿으시나요 ?",shape=box,color=blue];
