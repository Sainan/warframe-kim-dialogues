	j3083681803 [label="당신은 제 신앙과는 다른 신앙을 가지고 있다고 하셨는데, 어쨌든 다 동일한 믿음으로 이루어져 있죠. 당신은 왜 그리 믿으시는 거죠 ?",shape=box,color=blue];
