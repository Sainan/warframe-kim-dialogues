		j2568824678 -> j1977153765;
		j2568824678 -> j1164970980;
	j2122919605 [label="콕 집어서, 왜 솔이냐고요 ? 루아나 당신이 고수하는 균형은요 ? 아주 좋은 질문입니다. 당신의 믿는 이유는 뭔가요 ?",shape=box,color=blue];
