	j1164970980 [label="내가 그 대답을 말했을 때 당신한테 솔직하게 전하지 못했어.",shape=box,color=red];
		j1164970980 -> j392572562;
	j1322829322 [label="한 가지 경험을 했어. 그게 내 인생을 바꿔 놓았지.",shape=box,color=red];
		j1322829322 -> j426414125;
	j883999271 [label="이유는 없어, 그저 내가 느낀 것일 뿐이야. 그 마음이 날 인도했지.",shape=box,color=red];
		j883999271 -> j2417831386;
	j1977153765 [label="내가 믿고 싶으니까. 그래서, 믿는 거야.",shape=box,color=red];
		j1977153765 -> j3080931226;
	j3522914648 [label="제 대답이 당신을 실망시킬까 봐 걱정이네요, 늑대씨. 큰 기적은 없었습니다. 하늘에서 저를 위해 쏟아지는 햇살도 없었습니다.",shape=box,color=blue];
		j3522914648 -> j1058586261;
	j3153308489 [label="\"왜 이 현명한 젊은 처자는 내가 진짜라고 생각하지 않는, 어리석은 것들을 믿고 있는 걸까?\", non ?",shape=box,color=blue];
		j3153308489 -> j4064946094;
