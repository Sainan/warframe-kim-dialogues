		j3123750229 -> j1421876285;
		j3123750229 -> j3039724897;
	j1780348390 [label="하지만 혹시 이런 갈림길에 서 있지는 않은지, 어느 길로 가야 할지 고민하고 있지는 않은지 궁금하시군요, non ?",shape=box,color=blue];
		j1780348390 -> j256159438;
	j2311082201 [label="영혼은 지니고 있는 믿음 그 이상의 존재입니다. 전 une Soeur de Sol이오나, 제 안에서 그 이상을 보셨으면 좋겠어요, non ?",shape=box,color=blue];
		j2311082201 -> j3317450390;
	j3972978851 [label="그게 제 이유입니다. 가장 불확실한 곳에 도착했을 때, 전 솔께서 제 곁에 있으시다는 걸 느낍니다. 눈을 감으면 et il est là, 절 이끄시지요.",shape=box,color=blue];
		j3972978851 -> j2244850397;
		j3972978851 -> j1487780934;
		j3972978851 -> j1301802383;
	j2326861979 [label="그 길을 찾으실 수 있을지는 모르겠으나, 꼭 찾으시길 기도합니다. 당신이 거기서 발견하는 것에는 un miracle 밖에 없을 거에요. ",shape=box,color=blue];
		j2326861979 -> j557335239;
	j13882008 [label="그거 참 아름다운 생각 같아요...",shape=box,color=blue];
		j13882008 -> j557335239;
	j3199134152 [label="Sainte Mère Sol, vous avez béni votre fille aujourd'hui ! HA-HA !!",shape=box,color=blue];
		j3199134152 -> "Chat ends.";
	j256159438 [label="의무감을 믿어야 하는 이유가 되지는 않지요. 기껏해야 의심만 자아낼 것이고, 최악의 경우 공허한 경멸만 불러낼 뿐이죠.",shape=box,color=blue];
		j256159438 -> j2476654909;
	j3317450390 [label="하늘에 수많은 별들이 있듯이, 우리가 선택할 수 있는 주제도 다양하게 있어요 !",shape=box,color=blue];
		j3317450390 -> j1800394295;
		j3317450390 -> j3607527981;
