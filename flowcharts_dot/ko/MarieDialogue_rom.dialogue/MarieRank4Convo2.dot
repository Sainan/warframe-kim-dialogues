		j4077904883 -> j3260547117;
	j981042811 [label="Peut-être ! 왜냐하면 가능성이 무한해졌으니까요 !",shape=box,color=blue];
		j981042811 -> j3260547117;
	j3617793458 [label="왜냐하면 당신이 그럴 거라고 악마가 말해줬거든요.",shape=box,color=blue];
		j3617793458 -> j2519936158;
	j3626179941 [label="오 ! 오, 용서하세요 ! 죄송합니다. 뭐에 대해 질문하고 싶으셨던 거죠 ? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		j3626179941 -> j1421876285;
		j3626179941 -> j3039724897;
	j3006953833 [label="그리고 그 점이 당신께 평화를 가져다주지 않는다고 말씀하셨죠... 그 점이 제 맘을 아프게 합니다.",shape=box,color=blue];
		j3006953833 -> j1191073883;
	j1191073883 [label="뭘 하셔야 할지에 대해선 말씀드리지 않을 겁니다. 그리고 어떤 길을 찾으셔야 하는지도 말씀드리지 않을 거에요.",shape=box,color=blue];
		j1191073883 -> j3435470247;
