	j1058586261 [label="Non, 전 항상 제 삶을 인도해주는 présence가 있다고 느꼈어요. 제가 갈림길에 다다를 때마다 미소를 지으며 저를 어느 길로 가야할 지 알려주는 은인일 뿐, 그 이상은 아닙니다.",shape=box,color=blue];
		j1058586261 -> j2667163169;
		j1058586261 -> j2983290945;
	j4064946094 [label="솔직히 말하자면? 어느정도는, 그래. 하지만 그런 식으로 표현하고 싶지는 않아.",shape=box,color=red];
		j4064946094 -> j1452451079;
	j1993470650 [label="난 오히려 어떤 계기가 있었는지, 아니면... 그 일로 인해서 이끌어졌는지 궁금했어.",shape=box,color=red];
		j1993470650 -> j3522914648;
