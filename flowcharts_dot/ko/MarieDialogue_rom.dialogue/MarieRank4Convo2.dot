		j392572562 -> j881863443;
	j426414125 [label="그렇다면 당신이 부럽네요 ! 대부분의 사람들은 ferme한 사건과 마주할 정도로 운이 따라주지 않아서요, oui ?",shape=box,color=blue];
		j426414125 -> j557335239;
	j2417831386 [label="아, 그럼 우리의 대답은 같군요. Cathédrale에 le Cardinal께서 도착하신 것 외에는 기적을 경험해 본 적이 없습니다.",shape=box,color=blue];
