	j1800394295 [label="날 용서해 줄래?",shape=box,color=red];
		j1800394295 -> j564919653;
	j3607527981 [label="미안해. 정말 바보같은 짓이었어.",shape=box,color=red];
		j3607527981 -> j3888489599;
	j3265602302 [label="Oui, 제가 운이 좋다는 걸 알아요. 그리고 그 평화는 다른 이들에게 강요하기 쉬운거지요. 그들이 원하든 원하지 않든 말이에요.",shape=box,color=blue];
		j3265602302 -> j577633407;
	j3426448524 [label="Oui, 여러번 그러셨으니까요. 그리고 그 순간마다 왜 그리 됐는지 생각을 해요. 어쩌면 그냥 저 스스로가 길을 찾아야 하는 걸지도요, non ? Ou peut-être que je suis une folle après tout, hah ! 우리가 항상 의도를 알도 만들어진 게 아니니까요.",shape=box,color=blue];
		j3426448524 -> j577633407;
	j222629906 [label="Oui, 언젠가 꼭 이루어지길 기도합니다. 하지만 그건 누군가로부터 주어지거나 가르칠 수 있는 게 아니라, 스스로 찾아야 하는 법입니다.",shape=box,color=blue];
		j222629906 -> j1062462827;
	j1107628896 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j1107628896 -> j557335239;
	j564919653 [label="Oui, 당신을 용서합니다. 당신이 리온 같았다면, 10번은 매질해야하는 형벌이라고 말했을 겁니다.",shape=box,color=blue];
		j564919653 -> j3406544061;
	j3888489599 [label="Oui, 그리고 당신이 리온 같았다면, 10번은 매질해야하는 형벌이라고 말했을 거에요 ! 하지만 당신은 다르죠. 그리고 당신은 용서받았습니다.",shape=box,color=blue];
		j3888489599 -> j3406544061;
	j577633407 [label="하지만 스스로의 믿음이 아무에게도 해를 끼치지 않는 한, 제 신념을 지키는 데 아무런 문제가 없다고 생각합니다, oui ?",shape=box,color=blue];
