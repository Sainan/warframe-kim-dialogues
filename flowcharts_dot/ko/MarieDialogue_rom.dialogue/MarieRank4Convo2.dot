		j2122919605 -> j1977153765;
	j4032934636 [label="제 확신함 대한 이유를 묻고 계시는 군요, 그쵸 ? 우주를 알 수 없다고 하셨잖아요 ?",shape=box,color=blue];
		j4032934636 -> j3522914648;
	j858393181 [label="아무런 신앙을 가지지 않는 사람으로서, 그게 왜 이상하게 보일 수 있는지 알겠어요, oui.",shape=box,color=blue];
		j858393181 -> j3153308489;
