		j3519164788 -> j3278599143;
	j2700541880 [label="Oui ! 전 자른 꽃들은 별로 좋하지 않아요. 혹시 선물로 주실거라면, 꽃병에 꽂힌 장미는 아니길 바랄게요.",shape=box,color=blue];
