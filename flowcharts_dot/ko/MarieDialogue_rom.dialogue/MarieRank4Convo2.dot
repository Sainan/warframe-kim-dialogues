		j2742055956 -> j1492998673;
	j881863443 [label="당신을 더 잘 알 수 있는 방법이 될 수도 있다고 생각했어...",shape=box,color=red];
		j881863443 -> j3079298119;
	j557335239 [label="하지만 당신의 질문은 제가 왜 그리 믿는지에 대한 것이겠고, 질문하셨는데 무례하게 방향을 틀어버렸네요, je m'excuse.",shape=box,color=blue];
		j557335239 -> j3522914648;
	j4205582125 [label="그때도 그건 인간과 과학의 행위였지, 광휘의 성체들께서 행한 영역은 아니었지요, non ? 제게 비행의 선물을 준 이 sérum 말입니다 -",shape=box,color=blue];
		j4205582125 -> j2932713234;
	j256866641 [label="하지만 그 점이 당신께 평화를 가져다주지 않는다고 말씀하셨죠 ? 그 점이 제 맘을 아프게 합니다...",shape=box,color=blue];
		j256866641 -> j2411662959;
	j770003624 [label="당신의 신앙이 그 중에서도 가장 강할 것 같은데요, non ?",shape=box,color=blue];
		j770003624 -> j990690054;
	j2667163169 [label="당신, 엔트라티의 혈청이 기적이라고 하지 않았어?",shape=box,color=red];
		j2667163169 -> j4205582125;
	j2983290945 [label="리온의 목소리들도? 무심의 목소리도 아니고?",shape=box,color=red];
		j2983290945 -> j2465777355;
	j1452451079 [label="오, 광휘의 성체들을 믿는다고 해서 절 어리석다고 생각하는 건 다른 신앙을 가진 이에 대해서 생각할 수 있는 가장 예의 바른 행동 중 하나겠네요.",shape=box,color=blue];
		j1452451079 -> j2831493361;
	j3260547117 [label="악마는 두려워해야 해요 ! 조심하세요, 악한 이여 ! 광명이 위에서 그대를 내리칠 것이니 !",shape=box,color=blue];
		j3260547117 -> j2718912295;
	j2519936158 [label="Non, non, non... 그거 질문하려던 게 아니었죠?! 아 !! Je vais lui faire bouffer un de ces livres !",shape=box,color=blue];
		j2519936158 -> j3123750229;
	j3435470247 [label="저라는 존재는 당신이 이 보이드 폭풍 속에서 찾아낸 소박한 피난처일 뿐입니다.",shape=box,color=blue];
		j3435470247 -> j1780348390;
	j1492998673 [label="당신의 어떤 본능적인 감각이 그런 말을 하게 만들었는지는 모르겠지만, 이제라도 진실을 말씀해 주셔서 정말 다행이에요.",shape=box,color=blue];
		j1492998673 -> j2311082201;
	j3079298119 [label="오... 절 알기 위해 그런 말들을 하실 필요는 없었을 텐데요.",shape=box,color=blue];
		j3079298119 -> j2311082201;
	j2932713234 [label="이건 인간의 산물입니다. 하지만 전 우리의 길을 하나로 이어준 존재는 바로 솔이라고 믿고 있습니다.",shape=box,color=blue];
		j2932713234 -> j3972978851;
	j2411662959 [label="그건 마치 당신이 숲 속을 헤메이고 있으면서, 그 안에서 나아가고자 하는 길을 필사적으로 찾는 것 같아요.",shape=box,color=blue];
		j2411662959 -> j2326861979;
	j990690054 [label="마음 속에 희망을 품고 숲 속에 있는 길을 걷다보면 원하는 길로 인도되는 거요 ?",shape=box,color=blue];
		j990690054 -> j13882008;
	j2465777355 [label="그럴 수도요, 저도 잘 모르겠어요. 어쩌면 악마가 맞을지도 모르고, 이 모든 게 우리가 아직 이해하지 못하는 과학의 산물일지도 모르죠. 둘은 베타적인 게 아니잖아요, non ?",shape=box,color=blue];
		j2465777355 -> j3972978851;
	j2831493361 [label="전혀 불쾌하지 않습니다, 그리고 그 솔직함에 항상 감사드리고 있어요. ",shape=box,color=blue];
		j2831493361 -> j3522914648;
	j2718912295 [label="+20 Chemistry",color=orange];
		j2718912295 -> j3199134152;
