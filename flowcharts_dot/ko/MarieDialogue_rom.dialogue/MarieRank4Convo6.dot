	j1964282710 [label="리온은 어른이잖아. 언제 대화하고 싶은지는 리온 스스로 결정할 수 있다고.",shape=box,color=red];
		j1964282710 -> j2858090005;
	j3274549900 [label="리온이 이런 고통을 겪는 걸 보면 가슴이 찢어지듯이 아파. 어떻게 도와줘야 할지 모르겠어.",shape=box,color=red];
