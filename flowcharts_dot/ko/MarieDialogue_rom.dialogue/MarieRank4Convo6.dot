		j4172887362 -> j1455649415;
	j1523666576 [label="새로운 가족을 선택할 수도 있어. 나처럼. 그리고 당신을 아껴주는 다른 사람들을 고려해봐, 엔트라티 빼고.",shape=box,color=red];
