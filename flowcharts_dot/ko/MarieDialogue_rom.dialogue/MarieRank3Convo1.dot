	j1242868313 [label="Oui, 그 말이 맞아요. 그 분이 한 모든 일 때문에 죄책감에 시달리실 것 같아요. 그래서 다른 이들과 의도적으로 거리를 두시는 것도 있을 거에요.",shape=box,color=blue];
		j1242868313 -> j291076491;
	j3724738659 [label="Oui, 정말 끔찍하도록 슬프고, 엄청난 고통이죠. 누군가가... 아직 살아있고, 당신 곁에 있지 않으려는 걸 안다는 점이요.",shape=box,color=blue];
