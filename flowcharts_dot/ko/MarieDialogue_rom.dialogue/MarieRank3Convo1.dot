	j1954431120 [label="그래요, 우린 굳건히 버텨내야만 합니다 ! Braves contre les ténèbres, pour toujours et à jamais !",shape=box,color=blue];
		j1954431120 -> j4030687924;
	j3142996898 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j3142996898 -> j4132047764;
	j4156567758 [label="그 인간은 많은 사람들을 다치게 하고 버렸어, 당신 말이 맞아. 그 인간도 그럴 수밖에 없다고 생각하긴 해.",shape=box,color=red];
		j4156567758 -> j1956871253;
	j668160523 [label="나에게 그토록 소중했던 사람 - 사랑하고 의지하던 존재가 떠나는 건, 정말로 힘든 일이야. 특히, 이유도 알 수 없거나, 돌아오지도 않는다면 더욱 그렇지.",shape=box,color=red];
		j668160523 -> j2576944321;
	j1866011935 [label="솔이시여 ! 그 분의 따님이 쓰신 책에서 불러일으켜진, 당신이 만든 세상이죠, oui ? Monsieur 로이드께서 말씀해주셨는데... Le Cardinal이 거기 계셨나요 ? 무슨 사유로 ? ",shape=box,color=blue];
		j1866011935 -> j2731639936;
		j1866011935 -> j13268050;
		j1866011935 -> j3919942691;
	j134101175 [label="Et pourtant, vous êtes toujours en vie ! 당신 살아남았잖아요, 안 그런가요 ? 그리고 건강하시잖아요 ? Monsieur 로이드가 들려주신 과거와 미래에서의 당신의 모험담을 믿는다면, 잘 지내시고 계시네요.",shape=box,color=blue];
		j134101175 -> j4231093281;
	j3992737367 [label="Ah, je vois ! Je suis une idiote, c'est ça ?! Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même ?! Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer !",shape=box,color=blue];
		j3992737367 -> j2523403966;
	j643592652 [label="Ah, oui... 저와 진실을 말할 정도의 사이는 아니었다 이 말이군요, n'est-ce pas ?",shape=box,color=blue];
		j643592652 -> j3297664238;
	j4030687924 [label="그 분께서 우릴 떠나신 점에 대해선 용서했습니다. 다른 이들은 그러지 못하겠지만요...",shape=box,color=blue];
		j4030687924 -> j4156567758;
		j4030687924 -> j668160523;
	j4132047764 [label="Le Cardinal께선 우리에게 돌아올 길을 찾아내실 겁니다. 그 분께서 부르실 때 우리는 그 분의 일을 돕기 위해 할 수 있는 모든 것을 할 뿐이며, 그 분에게 축복받은 이들도 명하시는 대로 이행해야할 뿐입니다.",shape=box,color=blue];
