		j1509448972 -> j3695116699;
	j2203076902 [label="엔트라티의 행동들을 이해할 수 있다면, 용서하기에 훨씬 쉽겠지.",shape=box,color=red];
		j2203076902 -> j226483890;
	j4062439833 [label="이 문제를 해결하기 위해 그 인간이 원하는 대로 움직여는 줄거야. 그리고 이 모든 게 끝나고 나면 죄값을 치르게 할꺼고.",shape=box,color=red];
		j4062439833 -> j321114900;
	j291076491 [label="Il inflige la douleur dans le coeur des autres, car la douleur vaut mieux que rien du tout. 고통받는 것이 공허함보다 낫죠, non ?",shape=box,color=blue];
		j291076491 -> j3543772475;
	j2958494919 [label="유감스럽지만, 그 인간이 제대로 설명하지 않는다면 우리가 할 수 거라곤, 계속해서 스스로를 위해 이유를 만들어내는 것뿐이라고 생각해.",shape=box,color=red];
		j2958494919 -> j3483143576;
	j1585218858 [label="요점을 놓치고 있는 것 같네. 그 인간은 거기에 날 남겨두고 떠났어. 보이드 속에 버려진 누군가를 보고는, 그곳에 날 남겨두고 떠나갔다고.",shape=box,color=red];
		j1585218858 -> j771310469;
	j1759291222 [label="아니. 그냥 그 인간이 날 그곳에 내버려두고 떠났다는 것만 알아. 보이드 속에 버려진 누군가를 보고는, 그곳에 날 남겨두고 떠났어.",shape=box,color=red];
