	j2731639936 [label="처음엔, 그 인간 내면 어딘가에서 자신의 딸이 남겨둔 조그만 거라도 찾고 있었던 같아. 그 대신, 스스로가 거리를 두고자 했던 감정들을 통해서 무심에 맞서 싸울 방법을 찾아냈어.",shape=box,color=red];
		j2731639936 -> j570414689;
	j13268050 [label="그 인간이 남긴 노트에는 개념의 형상화를 연구하기 위해 갔다가 그 대신, 무심과 싸우는 것의 가치를 배우게 되었다는 아주 불쾌할 정도의 자화자찬적인 이야기가 담겨져 있어.",shape=box,color=red];
		j13268050 -> j438571182;
	j3919942691 [label="그 인간이 남긴 메모가 사실이라면, 두비리에게, - 더 나아가 나에게, 무심에 맞서 싸우는 법을 가르치기 위해 그 장소에 있었어. 하지만 결국 그게 무슨 소용이 있었나 싶지만.",shape=box,color=red];
