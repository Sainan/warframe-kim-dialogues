		j247318600 -> j596340943;
	j847939427 [label="Oui, bien sûr ! 그 어느 누구도, 특히 수녀에게서 훈계를 듣고 싶어하진 않죠. 이해합니다. Merci, 저도 바보가 되고 싶진 않아요.",shape=box,color=blue];
		j847939427 -> j38042250;
		j847939427 -> j4177913729;
		j847939427 -> j3039724897;
	j2610005844 [label="네, 맞아요. 전 이제 무기가 되었지요. Murmure들이 잘 알다시피요 ! 하지만 le Cardinal께서 맡기신 길을 따르고자 해요. 그 길이 얼마나 축복받은 길인지는 잘 알지만요.",shape=box,color=blue];
		j2610005844 -> j3037539917;
		j2610005844 -> j2734362781;
	j4017987511 [label="Le Cardinal처럼. 그 분도 오로킨이셨죠, non ? 그리고 그 분은 제가 비난할 대상이 전혀 아닙니다. 그 분께서 안 계셨다면, 지금처럼 되지는 못했을 거에요. 지금처럼 축복받은 채로 말이에요.",shape=box,color=blue];
		j4017987511 -> j971223805;
		j4017987511 -> j1590996781;
	j1426900270 [label="워프레임은... 그리 친절한 방법으로 제작되는 게 아니었어. 위습의 영혼이 감염체 육신 안에 갇혀 있지 않았으면 해.",shape=box,color=red];
		j1426900270 -> j4123248537;
	j4183183349 [label="위습이 누구였던 간에, 그녀도 당신을 알게 되어서 기쁠 거라고 생각해.",shape=box,color=red];
		j4183183349 -> j515643270;
	j847063184 [label="그 사람들의 영혼이 떠나서 안식을 찾을 수 있길 바라지만, 기억의 일부는 남아 있다고 생각해.",shape=box,color=red];
		j847063184 -> j1264009058;
	j596340943 [label="전혀 아니야. 워프레임으로 변한 사람들 중 일부는 여전히 핵심이 되는 설계 안에 남아 있다고 생각하거든.",shape=box,color=red];
		j596340943 -> j2166611122;
	j3037539917 [label="그 인간에 대해선 반박할 부분이 너무나도 많지만, 누구에게 어떤 프로토프레임 혈청을 투여해야 할지 본능적으로 알고 있다는 점은 인정할게. 왜 그리 행동하는지는 모르겠지만.",shape=box,color=red];
		j3037539917 -> j1498861126;
	j2734362781 [label="엔트라티를 당신이 믿는 것만치로 신뢰하지 않았으면 해. 그 인간이 왜 그런 짓을 했는지 알 수도 없고, 동기도 불분명하거든.",shape=box,color=red];
		j2734362781 -> j1722407835;
	j971223805 [label="우린 엔트라티를 따라가야 해. 그냥 그가 가는 대로 따라가야 할 것 같아. 무심을 막을 수 있는 유일한 기회도 엔트라티고.",shape=box,color=red];
		j971223805 -> j737842484;
