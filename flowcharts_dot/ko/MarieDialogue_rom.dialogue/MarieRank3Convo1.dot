		j3926796356 -> j1426875576;
	j1217592073 [label="영혼에 대한 논의가 마음에 들지 않으신가요 ? 마음에 들지 않으신다면 이해해요. 좀 더 실용적인 주제로 넘어가도 되겠지만, 불편하게 해드리고 싶지는 않아요.",shape=box,color=blue];
