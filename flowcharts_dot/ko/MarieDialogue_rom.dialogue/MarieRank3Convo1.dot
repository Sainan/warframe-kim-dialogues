		j3493670864 -> j1866011935;
	j3514418404 [label="뭐, 시작하자면, 그 인간이 내 가슴에 총 한 방 쏘고 죽게 내버려 뒀어.",shape=box,color=red];
		j3514418404 -> j134101175;
	j3360061370 [label="그 인간이 지나간 자리엔 고통, 죽음 그리고 버림받는 일만 남으니까.",shape=box,color=red];
		j3360061370 -> j1591510439;
	j2295087346 [label="그 인간을 믿은 적이 없어. 다만 당신을 놀라게 하고 싶지 않았을 뿐이야.",shape=box,color=red];
		j2295087346 -> j3992737367;
	j3326431291 [label="전에는 거짓말할 생각은 없었고, 그냥 주제에 대해서 어떻게 접근해야 할지 몰랐어. 당신이 그 인간을 정말 좋아하는 것 같거든...",shape=box,color=red];
