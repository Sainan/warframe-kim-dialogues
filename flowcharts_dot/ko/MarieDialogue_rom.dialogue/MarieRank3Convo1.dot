	j2005636933 [label="그 인간은 거기에 날 남겨두고 떠났다고. 어느 시점에 도착했는지도 모르겠지만 - 보이드 속에 버려진 누군가를 보고는... 그곳에 날 남겨두고 훌쩍 가버린 거지.",shape=box,color=red];
