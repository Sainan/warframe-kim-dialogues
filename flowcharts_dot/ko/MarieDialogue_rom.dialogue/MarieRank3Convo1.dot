		j3190577962 -> j130896092;
	j2837025266 [label="어떠면 그 분은 당신의 정신이 깨지기 쉬운 상태로 무너져내릴까봐 다른 곳으로 데려가는게 가능한지도 몰랐을지도요. 어쩌면 당신이 없다면 l'Indifférence이 그곳을 차지했을 거라 생각했을지도요. Peut-être, peut-être, peut-être.",shape=box,color=blue];
		j2837025266 -> j1591510439;
