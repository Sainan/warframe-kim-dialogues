	"Chat ends." [color=orange];
	j4166085648 [label="무기는 해를 끼치는 것뿐만 아니라 보호하는 데에도 사용될 수 있어. 우리에게 무기가 필요하다는 사실을 좋아하진 않지만... 필요해.",shape=box,color=red];
