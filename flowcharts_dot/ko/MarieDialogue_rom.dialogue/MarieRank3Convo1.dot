	j321114900 [label="+10 Chemistry",color=orange];
		j321114900 -> j2385681034;
	j3543772475 [label="그 점은 제 소중한 리온이 누구보다 잘 아는 교훈이군요... 리온이 지금 당신에게 말을 건네줘서 정말 기뻐요. 하지만 오늘은 le Cardinal에 대해서 이야기하는 날이에요.",shape=box,color=blue];
