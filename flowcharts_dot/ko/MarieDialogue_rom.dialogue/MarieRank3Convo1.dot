	j2637220928 [label="저는 감염에 대해서만 들었을 뿐, 아는 바가 거의 없지만... 당신을 믿어요. 제가 느낀 점이 사실이라면, 그리고 그게 사실이길 기도하며, 위습의 영혼이 갇혀 있다고 생각하진 않아요.",shape=box,color=blue];
		j2637220928 -> j726675176;
	j1353029347 [label="그리 말씀해주시니 어찌나 감사한지. 제가 느끼는 게 사실이라면, 그리고 위습의 영혼이 실제이기를 기도하며, oui. 당신 말이 맞는 것 같아요. 전 위습의 영혼이 갇혀 있다고 생각하진 않아요.",shape=box,color=blue];
		j1353029347 -> j726675176;
	j1366073839 [label="제가 느끼는 게 사실이라면, 그리고 그게 사실이길 기도하며, non. 전 위습의 영혼이 갇혀 있다고 생각하진 않아요.",shape=box,color=blue];
		j1366073839 -> j726675176;
	j2302449256 [label="제가 느끼는 게 사실이라면, 그리고 그게 사실이길 기도하며, oui. 당신 말이 맞는 것 같아요. 그리고 그들은 우릴 돕기 위해 남아있죠. 전 위습의 영혼이 갇혀 있다고 생각하진 않아요.",shape=box,color=blue];
		j2302449256 -> j726675176;
	j3823744403 [label="Oui, 저는 le Cardinal께 축복을 받았습니다... 하지만 그 분에 대한 저의 사랑이 너무나 특별하다는 걸 알고 있어요. 슬픔이나 증오, 원망으로 더럽혀지지 않았으니까요.",shape=box,color=blue];
		j3823744403 -> j3213814063;
	j2087519897 [label="당신이 그 분을 끔찍한 괴물로 여기시는 거 알아요. 그러나 묻고 싶은 점이 있네요. 뭐가 그리 그 분을 못 믿게 만드는 거죠 ?",shape=box,color=blue];
		j2087519897 -> j3493670864;
		j2087519897 -> j3514418404;
		j2087519897 -> j3360061370;
	j4242756608 [label="전 당신이 그 분을 믿는다고 생각했는데요 ? 왜 갑자기 마음이 바뀌셨나요 ? 원래 그렇게 변덕스러우신가요 ? ",shape=box,color=blue];
		j4242756608 -> j2295087346;
		j4242756608 -> j3326431291;
	j3619458093 [label="왜 그리 그 분을 믿지 못하시죠 ?",shape=box,color=blue];
		j3619458093 -> j3493670864;
		j3619458093 -> j3360061370;
		j3619458093 -> j3514418404;
	j644298140 [label="Oui, 그리고 그리 빨리 마음을 바꾸시는 건가요 ? 거짓말을 하시는 군요. 무슨 목적으로 그러시는지 잘 모르겠네요. Et je ne veux pas le savoir.",shape=box,color=blue];
		j644298140 -> j1508231473;
	j1437921170 [label="+5 Chemistry",color=orange];
		j1437921170 -> j1954431120;
	j202053317 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j202053317 -> j1954431120;
	j2655463751 [label="솔의 길을 따르는 우리는, 교차로에서 걷고자 하는 이들에게 언제나 길잡이가 되어야 한다고 생각해요, non? ",shape=box,color=blue];
		j2655463751 -> j3142996898;
	j3170563791 [label="당신은 루아의 신자입니다. 어떤 이들은 어둠 속에서 홀로 걸어야 한다고 우리가 가르친다는 걸 아실텐데요, oui ?",shape=box,color=blue];
		j3170563791 -> j3142996898;
	j1719453023 [label="당신께선 광휘의 성체들 신자이십니다. 어떤 이는 알려지지 않은 길을 혼자 걷는다는 걸 우리가 가르친다는 걸 아실텐데요, oui ?",shape=box,color=blue];
		j1719453023 -> j3142996898;
	j251866909 [label="제 신앙에서는, 인생의 길을 걸어가다가 루아와 솔이 만나는 교차로에 서게 되는 이들이 있다고 합니다. ",shape=box,color=blue];
		j251866909 -> j3142996898;
	j726675176 [label="위습에게서, 솔의 따스한 미소가 제게 쏟아지는 걸 느낍니다. Le Cardinal은 현명한 선택을 하셨다고 생각해요. 제 혈관이 그녀를 품게 되어 영광입니다.",shape=box,color=blue];
