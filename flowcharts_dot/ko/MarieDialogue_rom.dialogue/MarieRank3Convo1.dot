		j3695116699 -> j3965092993;
	j226483890 [label="종국엔 우리가 모두가 이해하게 될 거라 기도하며, 종국엔 우리 모두가 살아남아서 진실을 알게 되기를 기도할게요. 하지만 지금 제 주변의 famille들을 보며, 그들이 마음 속으로 용서할 수 있기를 기도해요. 그들 스스로의 행복을 위해서요.",shape=box,color=blue];
