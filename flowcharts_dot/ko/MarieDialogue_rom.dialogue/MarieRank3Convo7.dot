		1545 -> 1521;
	1546 [label="솔직히 말해서, 사람들이 나를 그 이상의 존재로 봐줬으면 좋겠어.",shape=box,color=red];
		1546 -> 1522;
	1547 [label="그 말이 맞습니다. 리온은 그래요. 하지만 그는 주변 이들을 보호하기 위해 그렇게 하는 게 필요하다고 생각하죠. 당신이 그런 것들을 더 이상 필요로 하지 않는다고 느낄 때, 리온은 당신에게 무엇이 걱정되는 지 말해줄 거에요. 인내심을 가져주세요. 때가 되면 리온이 당신에게 말을 걸어올거에요.",shape=box,color=blue];
		1547 -> 1550;
	1543 [label="리온이 곧 나와 대화를 나눌 수 있을만큼 편해지길 바래.",shape=box,color=red];
		1543 -> 1548;
	1544 [label="두 사람이 서로를 만나서 다행이야. 우린 첫 인상보다 훨씬 더 좋은 사람들이거든.",shape=box,color=red];
		1544 -> 1549;
	1550 [label="쳇. 죄송하지만 adieu할 시간이 되었네요. 속삭임이 멈추질 않아서요 !",shape=box,color=blue];
		1550 -> 1553;
