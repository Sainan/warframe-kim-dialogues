	j1854462771 [label="무례한 질문을 하나 해도 될까?",shape=box,color=red];
		j1854462771 -> j128243601;
	j3794119107 [label="이 대화가 맘에 안 들면, 다른 주제로 넘어갈 수도 있어.",shape=box,color=red];
		j3794119107 -> j3319007304;
	j955823245 [label="불편하게 만들 생각 전혀 없었어. 그저 리온이 걱정됐을 뿐이야. 겉모습은 냉정하지만, 고통스러워하는 것 같으니까.",shape=box,color=red];
		j955823245 -> j1806936630;
	j2504065415 [label="제가 작은 여자애였을 때, ma famille가 절 그곳에 버렸거든요. 오랫동안 거지로 지내면서 어떻게든 살아볼려고 애썼습니다.",shape=box,color=blue];
		j2504065415 -> j3604925486;
	j128243601 [label="+5 Chemistry",color=orange];
		j128243601 -> j1269702172;
	j3319007304 [label="아뇨, 아뇨. 괜찮아요. 그저 호기심 많은 구경꾼들이 살금살금 와서는 리온의 철창을 두드리는 데 익숙해져서 그래요. 마치 그가 monstre de cirque라도 되는 것처럼 말이죠.",shape=box,color=blue];
		j3319007304 -> j1974000391;
