	1522 [label="+15 Chemistry",color=orange];
		1522 -> 1529;
	1523 [label="리온은 나랑 대화를 할 것 같지 않아.",shape=box,color=red];
		1523 -> 1530;
	1524 [label="가능하면 리온을 돕고 싶어. 조언 좀 해줄 수 있을까?",shape=box,color=red];
		1524 -> 1530;
	1531 [label="당신이 여기서 하고자 하는 게 그런 행동이 아니길 바랍니다.",shape=box,color=blue];
		1531 -> 1536;
		1531 -> 1537;
	1526 [label="Update boolean MarieBeggar1",color=orange];
		1526 -> 1532;
	1527 [label="다른 이들이 말하길, 당신은 늑대라고 하는데, 저한테는 예의가 참 바르시네요 ! 어찌나 보기 좋은지. 무슨 질문을 하시려는 지 알 것 같아요. 제가 왜 길거리에 있었냐고요?",shape=box,color=blue];
		1527 -> 1519;
	1528 [label="언젠가, 당신에 대한 이야기책이 나오리라 생각이 들어요. 이 얼마나 매력적인 생각인가요. 아마 제가 쓸지도요. 북쪽 골 언어로 쓰이겠지만요! Imaginez cela !",shape=box,color=blue];
		1528 -> 1533;
	1529 [label="그렇다면 진심으로 이해하시는 거네요. 전 발이 없어 날 수 있는 힘을 얻은 불쌍한 소녀, 마리 수녀보다 더 큰 존재입니다. 그리고 리온은 침묵 속에서 자신의 짐을 짊어지는 비극적인 신부보다 더 큰 존재지요.",shape=box,color=blue];
		1529 -> 1534;
	1530 [label="+10 Chemistry",color=orange];
		1530 -> 1535;
	1536 [label="나도 \"지역 명물\"로 취급받는 거 익숙해서, 당신들이 어떤 심정인지 알아. 아니야, 그런 의도로 물은 게 아니야. ",shape=box,color=red];
		1536 -> 1541;
	1537 [label="아니, 그냥 궁금해서야. 그리고 솔직히 걱정되기도 해. 리온은 자신의 고통을 많이 감추는 것 같으니까.",shape=box,color=red];
		1537 -> 1542;
	1532 [label="저 같이 다리를 쓰지 못하면서 dans la Cité de la Lumière에 있으면 일자리도 못 얻고 돌아갈 장소도 없을 거라는 게 상상이 가시겠죠.",shape=box,color=blue];
		1532 -> 1538;
	1533 [label="아니면 그런 건 상상하지 마세요, 어쩌면 현실이 되어있을지도 모르니까요. 하 ! 훌륭한 대화 도중 죄송하지만, adieu할 시간이 되었네요. 속삭임이 멈추질 않아서요 !",shape=box,color=blue];
		1533 -> 1539;
	1534 [label="그 점만 기억해두신다면, 우린 좋은 친구가 되리라 생각해요. 훌륭한 대화 도중 죄송하지만, adieu할 시간이 되었네요. 속삭임이 멈추질 않아서요 !",shape=box,color=blue];
		1534 -> 1540;
	1535 [label="인내심을 가져주세요. 리온은... 처음엔 다가오지 않아요. 하지만, 때가 되면 당신에게 다가갈꺼에요. 당신이 좋은 의도를 가지고 있다면, 알아봐줄 거에요. 하지만 이제, 당신과 인사를 해야할 것 같네요, adieu.",shape=box,color=blue];
		1535 -> 2424;
	1541 [label="Oui, 상상이 가실거에요. 시간을 반복할 수 있고, 새로운 세상을 소환할 수 있으며 시간 여행이 가능한 존재시잖아요 ! 당신 마술사 같기도 해요, 안 그런가요, non ?",shape=box,color=blue];
		1541 -> 1545;
		1541 -> 1546;
	1542 [label="+15 Chemistry",color=orange];
