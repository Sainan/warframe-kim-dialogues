	j455102647 [label="솔직히 말해서, 사람들이 나를 그 이상의 존재로 봐줬으면 좋겠어.",shape=box,color=red];
		j455102647 -> j2215789646;
	j2469179962 [label="걱정해주신다는 점에서 존경스럽네요. 리온은 강해서 자신에게 가해지는 모든 것들을 견뎌낼 수 있어요. 하지만 모든 짐은 함께 지는 것이 더 쉬운 법이죠.",shape=box,color=blue];
