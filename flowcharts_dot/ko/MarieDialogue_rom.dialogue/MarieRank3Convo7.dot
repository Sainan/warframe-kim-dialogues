	j1806936630 [label="+5 Chemistry",color=orange];
		j1806936630 -> j550719420;
	j3604925486 [label="Boolean MarieBeggar1 is now true.",color=orange];
		j3604925486 -> j1993182453;
	j1269702172 [label="다른 이들이 말하길, 당신은 늑대라고 하는데, 저한테는 예의가 참 바르시네요 ! 어찌나 보기 좋은지. 무슨 질문을 하시려는 지 알 것 같아요. 제가 왜 길거리에 있었냐고요?",shape=box,color=blue];
		j1269702172 -> j2504065415;
	j1974000391 [label="둘은 어떻게 만났어?",shape=box,color=red];
		j1974000391 -> j581938932;
	j1053325286 [label="나도 \"지역 명물\"로 취급받는 거 익숙해서, 당신이 왜 그리 방어적인 태도를 취하는지 이해가 가.",shape=box,color=red];
		j1053325286 -> j2236551264;
	j917180734 [label="괜찮아. 그냥 리온이 걱정되서 그래.",shape=box,color=red];
		j917180734 -> j816126542;
	j550719420 [label="제... 퉁명스러운 태도에 대해 사과드립니다. 그저 호기심 많은 구경꾼들이 살금살금 와서는 리온의 철창을 두드리는 데 익숙해져서 그래요. 마치 그가 monstre de cirque라도 되는 것처럼 말이죠.",shape=box,color=blue];
		j550719420 -> j1053325286;
		j550719420 -> j917180734;
	j1993182453 [label="저 같이 다리를 쓰지 못하면서 dans la Cité de la Lumière에 있으면 일자리도 못 얻고 돌아갈 장소도 없을 거라는 게 상상이 가시겠죠.",shape=box,color=blue];
		j1993182453 -> j3543734154;
	j581938932 [label="제 소중한 리온은 이미 Cathédrale에서 오랫동안 자리를 잡고 있었는데, 마침 Mère Supérieure께서 저를 받아들여주셨고, 전 광휘의 성체를 따르는 수녀가 되었습니다.",shape=box,color=blue];
		j581938932 -> j3770879004;
		j581938932 -> j1538999110;
	j2236551264 [label="Oui, 상상이 가실거에요. 시간을 반복할 수 있고, 새로운 세상을 소환할 수 있으며 시간 여행이 가능한 존재시잖아요 ! 당신 마술사 같기도 해요, 안 그런가요, non ?",shape=box,color=blue];
