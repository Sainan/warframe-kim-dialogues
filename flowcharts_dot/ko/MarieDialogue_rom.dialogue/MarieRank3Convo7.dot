	j2355411803 [label="+15 Chemistry",color=orange];
		j2355411803 -> j664836987;
	j242536785 [label="그래서 리온과 제가 그렇게 빨리 가족이 된 것 같아요. 리온은 단 한 번도 절 불쌍히 여기지 않았어요. 저도 그를 똑같이 대했구요.",shape=box,color=blue];
		j242536785 -> j59646216;
		j242536785 -> j1395933814;
	j664836987 [label="그 말이 맞습니다. 리온은 그래요. 하지만 그는 주변 이들을 보호하기 위해 그렇게 하는 게 필요하다고 생각하죠. 당신이 그런 것들을 더 이상 필요로 하지 않는다고 느낄 때, 리온은 당신에게 무엇이 걱정되는 지 말해줄 거에요. 인내심을 가져주세요. 때가 되면 리온이 당신에게 말을 걸어올거에요.",shape=box,color=blue];
		j664836987 -> j3562211386;
	j59646216 [label="리온이 곧 나와 대화를 나눌 수 있을만큼 편해지길 바래.",shape=box,color=red];
		j59646216 -> j153617042;
	j1395933814 [label="두 사람이 서로를 만나서 다행이야. 우린 첫 인상보다 훨씬 더 좋은 사람들이거든.",shape=box,color=red];
