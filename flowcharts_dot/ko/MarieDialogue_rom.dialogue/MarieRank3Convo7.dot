	j3039724897 [label="[종료.]",shape=box,color=red];
		j3039724897 -> "Chat ends.";
	j4150249707 [label="제 소중한 리온은 이미 Cathédrale에서 오랫동안 자리를 잡고 있었는데, 마침 Mère Supérieure께서 저를 받아들여주셨고, 전 광휘의 성체를 따르는 수녀가 되었습니다. (당신께서 리온과 대화를 하셔서 정말이지 너무 기뻐요 !)",shape=box,color=blue];
		j4150249707 -> j3981931049;
		j4150249707 -> j1854462771;
	j1509152361 [label="이야기를 나누기 전에 정의를 내려주시길 부탁드려요. 그리고 부드럽게, 제 영혼이 리온의 형제라는 사실을 조심스럽게 상기하시길 부탁드립니다.",shape=box,color=blue];
		j1509152361 -> j3794119107;
