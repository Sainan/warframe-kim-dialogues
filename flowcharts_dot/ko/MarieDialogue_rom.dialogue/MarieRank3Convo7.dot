digraph {
	1488 [label="MarieRank3Convo7 begins.",color=orange];
		1488 -> 3741;
	3741 [label="Update boolean MarieLyonAvailable",color=orange];
		3741 -> 1491;
		3741 -> 1490;
		3741 -> 1489;
	1491 [label="당신하고 리온은 어떻게 만났어?",shape=box,color=red];
		1491 -> 1494;
	1490 [label="리온은... 괜찮은거야?",shape=box,color=red];
		1490 -> 1493;
	1489 [label="[종료.]",shape=box,color=red];
		1489 -> 1492;
	1494 [label="제 소중한 리온은 이미 Cathédrale에서 오랫동안 자리를 잡고 있었는데, 마침 Mère Supérieure께서 저를 받아들여주셨고, 전 광휘의 성체를 따르는 수녀가 되었습니다. (당신께서 리온과 대화를 하셔서 정말이지 너무 기뻐요 !)",shape=box,color=blue];
		1494 -> 1497;
		1494 -> 1498;
	1493 [label="이야기를 나누기 전에 정의를 내려주시길 부탁드려요. 그리고 부드럽게, 제 영혼이 리온의 형제라는 사실을 조심스럽게 상기하시길 부탁드립니다.",shape=box,color=blue];
		1493 -> 1495;
		1493 -> 1496;
	1492 [label="Chat ends.",color=orange];
	1497 [label="당신... 머물 곳이 필요했었어?",shape=box,color=red];
		1497 -> 1501;
	1498 [label="무례한 질문을 하나 해도 될까?",shape=box,color=red];
		1498 -> 1502;
	1495 [label="이 대화가 맘에 안 들면, 다른 주제로 넘어갈 수도 있어.",shape=box,color=red];
		1495 -> 1499;
	1496 [label="불편하게 만들 생각 전혀 없었어. 그저 리온이 걱정됐을 뿐이야. 겉모습은 냉정하지만, 고통스러워하는 것 같으니까.",shape=box,color=red];
		1496 -> 1500;
	1501 [label="제가 작은 여자애였을 때, ma famille가 절 그곳에 버렸거든요. 오랫동안 거지로 지내면서 어떻게든 살아볼려고 애썼습니다.",shape=box,color=blue];
		1501 -> 1507;
	1502 [label="+5 Chemistry",color=orange];
		1502 -> 1508;
	1499 [label="아뇨, 아뇨. 괜찮아요. 그저 호기심 많은 구경꾼들이 살금살금 와서는 리온의 철창을 두드리는 데 익숙해져서 그래요. 마치 그가 monstre de cirque라도 되는 것처럼 말이죠.",shape=box,color=blue];
		1499 -> 1503;
		1499 -> 1504;
		1499 -> 1505;
	1500 [label="+5 Chemistry",color=orange];
		1500 -> 1506;
	1507 [label="Update boolean MarieBeggar1",color=orange];
		1507 -> 1512;
	1508 [label="다른 이들이 말하길, 당신은 늑대라고 하는데, 저한테는 예의가 참 바르시네요 ! 어찌나 보기 좋은지. 무슨 질문을 하시려는 지 알 것 같아요. 제가 왜 길거리에 있었냐고요?",shape=box,color=blue];
		1508 -> 1501;
	1503 [label="둘은 어떻게 만났어?",shape=box,color=red];
		1503 -> 1509;
	1504 [label="나도 \"지역 명물\"로 취급받는 거 익숙해서, 당신이 왜 그리 방어적인 태도를 취하는지 이해가 가.",shape=box,color=red];
		1504 -> 1510;
	1505 [label="괜찮아. 그냥 리온이 걱정되서 그래.",shape=box,color=red];
		1505 -> 1511;
	1506 [label="제... 퉁명스러운 태도에 대해 사과드립니다. 그저 호기심 많은 구경꾼들이 살금살금 와서는 리온의 철창을 두드리는 데 익숙해져서 그래요. 마치 그가 monstre de cirque라도 되는 것처럼 말이죠.",shape=box,color=blue];
		1506 -> 1504;
		1506 -> 1505;
	1512 [label="저 같이 다리를 쓰지 못하면서 dans la Cité de la Lumière에 있으면 일자리도 못 얻고 돌아갈 장소도 없을 거라는 게 상상이 가시겠죠.",shape=box,color=blue];
		1512 -> 1518;
	1509 [label="제 소중한 리온은 이미 Cathédrale에서 오랫동안 자리를 잡고 있었는데, 마침 Mère Supérieure께서 저를 받아들여주셨고, 전 광휘의 성체를 따르는 수녀가 되었습니다.",shape=box,color=blue];
		1509 -> 1513;
		1509 -> 1514;
	1510 [label="Oui, 상상이 가실거에요. 시간을 반복할 수 있고, 새로운 세상을 소환할 수 있으며 시간 여행이 가능한 존재시잖아요 ! 당신 마술사 같기도 해요, 안 그런가요, non ?",shape=box,color=blue];
		1510 -> 1515;
		1510 -> 1516;
	1511 [label="+5 Chemistry",color=orange];
		1511 -> 1517;
	1518 [label="그래서 리온과 제가 그렇게 빨리 가족이 된 것 같아요. 리온은 단 한 번도 절 불쌍히 여기지 않았어요. 저도 그를 똑같이 대했구요.",shape=box,color=blue];
		1518 -> 1525;
	1513 [label="당신... 머물 곳이 필요했었어?",shape=box,color=red];
		1513 -> 1519;
	1514 [label="무례한 질문을 하나 해도 될까?",shape=box,color=red];
		1514 -> 1520;
	1515 [label="그거 꽤 깔끔한 요약이네.",shape=box,color=red];
		1515 -> 1521;
	1516 [label="솔직히 말해서, 사람들이 나를 그 이상의 존재로 봐줬으면 좋겠어.",shape=box,color=red];
		1516 -> 1522;
	1517 [label="걱정해주신다는 점에서 존경스럽네요. 리온은 강해서 자신에게 가해지는 모든 것들을 견뎌낼 수 있어요. 하지만 모든 짐은 함께 지는 것이 더 쉬운 법이죠.",shape=box,color=blue];
		1517 -> 1523;
		1517 -> 1524;
	1525 [label="반면에 다른 사람들은 리온을 마치 monstre de cirque라도 되는 것처럼 대하며 그의 철창을 호기심에 두드리곤 합니다.",shape=box,color=blue];
		1525 -> 1531;
	1519 [label="제가 작은 여자애였을 때, ma famille가 절 그곳에 버렸거든요. 오랫동안 거지로 지내면서 어떻게든 살아볼려고 애썼습니다.",shape=box,color=blue];
		1519 -> 1526;
