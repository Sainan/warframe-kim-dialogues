		j2803108070 -> j1350233930;
	j2133964204 [label="당신 전혀 바보같지 않아. 나도 똑같이 생각했으니까.",shape=box,color=red];
		j2133964204 -> j1350233930;
	j875016600 [label="그럼에도 바로 그런 짓을 하고 앉아 있었네요. 제 어리석음을 일깨워 주셔서 감사합니다. 체! 바보같은 작은 마리. 음... M'sieur 피보나치의 물탱를 좀 닦아야겠네요.",shape=box,color=blue];
