	j2835657735 [label="Merci. 뭐, 더 이상 슬픈 채로 있기 싫네요. 좀 더 즐거운 일을 하러 가야겠어요 ! M'sieur 피보나치의 물탱크를 청소해야 할 것 같아요.",shape=box,color=blue];
		j2835657735 -> j2486340526;
	j837641502 [label="하 ! Merci. 그래주시면 제 바보 같은 눈물이 멎을 거에요. 바보 같은 마리를 기운나게 하는 법을 제대로 알고 계시네요, non ?",shape=box,color=blue];
		j837641502 -> j2803108070;
		j837641502 -> j2133964204;
	j1854915985 [label="Oui. 맞는 말씀이에요. 사실 그렇죠. 세상에는 Monsieur 오탁과 같은 사례가 셀 수 없이 많고, 그보다 훨씬 더 끔찍한 이야기들도 많으니까요. 저는 그런 사례 중 하나 때문에 울고 싶지 않아요. ",shape=box,color=blue];
		j1854915985 -> j875016600;
	j2486340526 [label="Check boolean MarieDating",color=orange];
