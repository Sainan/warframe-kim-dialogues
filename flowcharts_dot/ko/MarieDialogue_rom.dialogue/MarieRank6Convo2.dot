		j3979133402 -> j3831025287 [label=false,color=brown];
	j507763602 [label="늑대씨 ! 내 늑대씨 ! 오탁을 만났어요 ! 마침내 만났다구요 !",shape=box,color=blue];
		j507763602 -> j3864224028;
		j507763602 -> j651584913;
	j2889518278 [label="오탁을 만났어요 ! 마침내 만났다구요 !",shape=box,color=blue];
		j2889518278 -> j3864224028;
		j2889518278 -> j651584913;
	j3529834607 [label="늑대씨 ! 내 늑대씨 ! Monsieur 네크랄로이드의 등에 있는 얼굴이요 ! 드디어 만났다구요 !",shape=box,color=blue];
		j3529834607 -> j1556385827;
		j3529834607 -> j2514291192;
		j3529834607 -> j575119119;
	j3831025287 [label="Monsieur 네크랄로이드의 등에 있는 얼굴이요 ! 드디어 만났다구요 !",shape=box,color=blue];
		j3831025287 -> j1556385827;
		j3831025287 -> j2514291192;
		j3831025287 -> j575119119;
	j3864224028 [label="오탁과의 대화는 즐거웠어?",shape=box,color=red];
		j3864224028 -> j753336972;
	j651584913 [label="오탁이랑 대화는 어떻게 진행됐어?",shape=box,color=red];
		j651584913 -> j3441112064;
	j1556385827 [label="불쌍한 오탁... 어떻게 됐어?",shape=box,color=red];
		j1556385827 -> j1697126412;
	j2514291192 [label="드디어 만났구나. 오탁은 설명하기 좀 어려운 존재일 수 있거든.",shape=box,color=red];
		j2514291192 -> j48695968;
	j575119119 [label="오탁을 만났다고? 오 이런... 어떻게 됐어?",shape=box,color=red];
		j575119119 -> j430246409;
	j753336972 [label="네. 어쩌면 울고 싶었을지도요. 그는 마치 우리가 서로 소개한 적이 없는 것 같은 대화를 하더니 세 번이나 자기 소개를 했어요.",shape=box,color=blue];
		j753336972 -> j1393686614;
	j3441112064 [label="그는... 마치 우리가 서로 소개한 적이 없는 것 같은 대화를 하더니 세 번이나 자기 소개를 했어요.",shape=box,color=blue];
		j3441112064 -> j1393686614;
	j1697126412 [label="그분은 정말 다정하고 매력적이었요 ! 하지만 유머 감각 아래 묻힌 상심이 보였기에, 제 가슴이 찢어졌어요.",shape=box,color=blue];
		j1697126412 -> j1020730508;
	j48695968 [label="네, 그런 것 같아요. 아이가 작은 로봇 뒤에 휘갈겨 쓴 낙서 같죠. 정말 귀엽고 매력적이었어요 !",shape=box,color=blue];
		j48695968 -> j3797506518;
	j430246409 [label="왜 제가 그를 만났다는 게 별로 달갑지 않으신 것처럼 들리는 걸까요 ?",shape=box,color=blue];
		j430246409 -> j490645608;
		j430246409 -> j3447081580;
		j430246409 -> j67807881;
	j1393686614 [label="그분은 이전과 마찬가지로 굴하지 않고 쾌활히 인사를 건네주셨지만, 제가 Soeur de Sol인걸 알고 계셨어요 ! ",shape=box,color=blue];
		j1393686614 -> j3787495025;
	j1020730508 [label="불쌍한 Monsieur 오탁에 대해서 알려주시겠어요 ?",shape=box,color=blue];
		j1020730508 -> j194921085;
	j3797506518 [label="하지만 유머 아래에 상심이 묻혀 있었기에, 가슴이 찢어지는 줄 알았어요.",shape=box,color=blue];
		j3797506518 -> j1020730508;
	j490645608 [label="오탁이 가끔 내 신경을 긁을 때가 있거든. 그게 다야. ",shape=box,color=red];
		j490645608 -> j3071948999;
	j3447081580 [label="그렇게 들렸다면 미안. 그 녀석은 그냥... 일부 사람들한텐 좀 받아들이기 힘들 수 있거든.",shape=box,color=red];
		j3447081580 -> j3528183165;
	j67807881 [label="미안. 오탁이 가끔 사람들 신경을 긁을 때가 있거든. 그건 오탁 잘못이 아니야.",shape=box,color=red];
		j67807881 -> j3528183165;
	j3787495025 [label="사실, 그분은 광휘의 성체들에 대해 꽤 많이 알고 있었어요 ! 우린 그분이 \"오로킨 제국 이전 시대\"의 \"고대 종교\"에 대해서 오랫동안 대화를 나눴어요.",shape=box,color=blue];
		j3787495025 -> j2686393509;
	j194921085 [label="오탁은 한때 오로킨의 과학자이자 학자인 아르키메디안이었어. 그에게 일어난 일은... 결코 행복이라 할 수 없는 일이었지.",shape=box,color=red];
		j194921085 -> j2269936922;
	j3071948999 [label="당신이 약자들에게 좀 더 친절히 대해 주시면 좋겠어요. Mais par la grâce de Sol, 우리 모두 나아가는 거니까요.",shape=box,color=blue];
		j3071948999 -> j237027465;
	j3528183165 [label="그렇다면 다른 이들이 그분들에게 친절과 인내심을 보여주기를. Mais par la grâce de Sol, 우리 모두 함께 나아가는 거니까요.",shape=box,color=blue];
		j3528183165 -> j237027465;
	j2686393509 [label="그때의 지식 상당 부분이 지금은 사라져서 기록 보관소 깊숙한 곳에 숨겨져 있고, 엄격히 금지되어 있다고 제게 말씀해 주셨지만요. 비밀 꼭 지키라고 맹세까지 시키셨어요.",shape=box,color=blue];
		j2686393509 -> j163155357;
	j2269936922 [label="오탁은 누구나 인정할 만한 천재였고, 아르곤 크리스탈 활용 기술의 선두주자이기도 했어.",shape=box,color=red];
		j2269936922 -> j1895323026;
	j237027465 [label="그러한 운명은 우리 중 누구에게나 찾아올 수 있어요. 심지어 당신에게도요.",shape=box,color=blue];
		j237027465 -> j2974427064;
		j237027465 -> j1513859926;
	j163155357 [label="그분은 집행관 발라스 - 그게 뭐하는 사람이든 - 라는 존재가 저를 이단 종파로서 발견하고 처형할까 봐 깊은 우려를 표하셨어요.",shape=box,color=blue];
		j163155357 -> j2777144182;
		j163155357 -> j1497298064;
	j1895323026 [label="그리고 그 기술은 보이드의 힘을 끌어 쓰는 거지. 우리가 지금 만드는 강력한 워프레임이나 무기들을 수없이 만들어낼 수 있는 것도 바로 그 기술 때문이야.",shape=box,color=red];
		j1895323026 -> j997554972;
	j2974427064 [label="당신 말이 맞네. 미안해. 그럴 의도가 아니었어.",shape=box,color=red];
		j2974427064 -> j1020730508;
	j1513859926 [label="난 오탁에게 시간을 쓸 여유가 없어서 말이야, 미안.",shape=box,color=red];
		j1513859926 -> j430305543;
	j2777144182 [label="발라스는 죽었어... 계속 말해줘.",shape=box,color=red];
		j2777144182 -> j3528472623;
	j1497298064 [label="그런 일은... 일어나지 않을 거야. 계속 말해줘.",shape=box,color=red];
		j1497298064 -> j3528472623;
	j997554972 [label="오탁은 결정학을 전문분야로 삼았어. 그의 연구물들이 여기 실험실에 보관되어 있지.",shape=box,color=red];
		j997554972 -> j3498942987;
	j430305543 [label="그럼 더 많은 시간을 낭비해드린 점에 대해 사과드려야겠네요.",shape=box,color=blue];
		j430305543 -> j3007723528;
	j3528472623 [label="+5 Chemistry",color=orange];
		j3528472623 -> j2774152835;
	j3498942987 [label="나도 자세히는 모르지만, 어떤 이유가 있어서 오탁은 세팔론이 되었고, 원래 쓰던 자기 네크랄로이드 껍질을 받았지.",shape=box,color=red];
		j3498942987 -> j3191748895;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j2774152835 [label="그럴 것 같았어요... 뭐, 그분은 제게 어디서 왔냐고 물었고, 제가 대답하자 웃으시면서 \"아니, 그건 불가능해! 그리고 알아뒀어야 했어, 난 -\"",shape=box,color=blue];
		j2774152835 -> j920485644;
	j3191748895 [label="모든 세팔론이 처벌받아 그렇게 되는 건 아니야. 하지만 여기 데이모스에 와서... 일이 영 안 좋게 됐고, 오탁은 크게 손상을 입었지.",shape=box,color=red];
		j3191748895 -> j2105349457;
	j920485644 [label="그러고는 그분은... 다시 자기소개를 하셨어요. 그리고 plains에서 광물 샘플을 가지고 왔냐고 물으셨죠...",shape=box,color=blue];
		j920485644 -> j1320902349;
		j920485644 -> j1872465619;
	j2105349457 [label="Pauvre petit...",shape=box,color=blue];
		j2105349457 -> j253530729;
	j1320902349 [label="그래... 그게 오탁이야.",shape=box,color=red];
		j1320902349 -> j1963372767;
	j1872465619 [label="오, 마리. 정말 유감이야...",shape=box,color=red];
		j1872465619 -> j1963372767;
	j253530729 [label="Boolean MarieOtak1 is now true.",color=orange];
		j253530729 -> j3864224028;
		j253530729 -> j651584913;
	j1963372767 [label="그분을 위해 할 수 있는 일이 아무것도 없다는 생각에 가슴이 찢어지다 못해 산산조각 나는 것 같아요.",shape=box,color=blue];
		j1963372767 -> j457335464;
	j457335464 [label="Evaluate expressions",color=orange];
		j457335464 -> j719510888 [label="MarieCephalonSoul",color=purple];
