	j1531682106 [label="당신이 로스한테 약간 불공평하게 대하는 것 같은데.",shape=box,color=red];
		j1531682106 -> j2315790529;
	j2110279915 [label="조심할게. 약속할게.",shape=box,color=red];
		j2110279915 -> j1305007136;
	j1053907157 [label="당신이 그 힘은 신이 아니라 우리 자신의 마음에서 비롯되었다고 믿는다 해도, 그건 여전히 위협입니다.",shape=box,color=blue];
		j1053907157 -> j3690807920;
	j2755198899 [label="그자가 그 힘은 신이 아니라 우리 자신의 마음에서 비롯되었다고 믿는다 해도, 그건 여전히 위협입니다.",shape=box,color=blue];
		j2755198899 -> j3690807920;
	j2315790529 [label="Add -1 to Thermostat counter",color=orange];
		j2315790529 -> j346990631;
	j1305007136 [label="+20 Chemistry",color=orange];
		j1305007136 -> j1700761566;
	j346990631 [label="Oui ? 어떻게요? 매정할 뜻은 없었지만, 진심으로 궁금해서 물어보는 거에요.",shape=box,color=blue];
		j346990631 -> j3893819406;
		j346990631 -> j2622775178;
		j346990631 -> j3292739493;
		j346990631 -> j881830100;
	j1700761566 [label="Merci. 제가 바라는 건 그게 다에요.",shape=box,color=blue];
		j1700761566 -> "Chat ends.";
	j3893819406 [label="그는 다른 사회, 다른 시간 - 다른 기대 속에서 자랐어. 우리는 좋아하지 않을지 몰라도, 로스는 로스 그 자체야.",shape=box,color=red];
		j3893819406 -> j2768177142;
	j2622775178 [label="당신과 리온은 엔트라티에게서 프로토프레임 혈청을 기꺼이 받았잖아. 로스는 그러지 않았어. 그게 어떤 건지 상상이 가?",shape=box,color=red];
		j2622775178 -> j2750989701;
		j2622775178 -> j277897567;
		j2622775178 -> j2768177142;
	j3292739493 [label="그는 자신이 필요하다고 믿는 일을 하며 수 세기동안 살아왔어. 다만 그게 무엇인지에 대해 우리 사이에 의견이 다를 뿐이야.",shape=box,color=red];
		j3292739493 -> j2750989701;
		j3292739493 -> j3402495697;
	j881830100 [label="내 생각엔 로스의... 태도가 당신을 화나게 만드는 요인인 것 같아. 로스의 행동에서 화나는 게 아니라.",shape=box,color=red];
		j881830100 -> j3402495697;
		j881830100 -> j2750989701;
	j2768177142 [label="그는 고위 군사이자 사교계 명사였어. 그리고 그 두 가지 모두 때때로 모호한 결정을 내려야 하는 상황이 있다고.",shape=box,color=red];
		j2768177142 -> j681163897;
	j2750989701 [label="난 사람이 \"잘못된 일\"이라고 느끼는 일을 할 수도 있다고 생각해. 그걸 좋은 의도로 행했으리라 생각하거든.",shape=box,color=red];
		j2750989701 -> j744946520;
	j277897567 [label="그는 오로킨 제국을 구하기 위해 모든 일을 다 했고, 그에 대한 감사의 표시로 자신의 의지와 상관없이 이 혼란 속에 빠져버렸어.",shape=box,color=red];
		j277897567 -> j681163897;
	j3402495697 [label="로스는 스스로가 한 일에 자부심을 느끼기 때문에 당신한테 좋지 않은 인상을 주는 것 같아.",shape=box,color=red];
		j3402495697 -> j1195041789;
	j681163897 [label="Check boolean MarieGrineer",color=orange];
		j681163897 -> j271965286 [label=true,color=green];
		j681163897 -> j290173817 [label=false,color=brown];
	j744946520 [label="당신이 그를 악마로 생각할지 모르지만, 그의 머릿속에서 그 점은 진실과 꽤 거리가 멀었어.",shape=box,color=red];
		j744946520 -> j681163897;
	j1195041789 [label="Oui, 개인적으론 죽음을 즐기는 이들을 좋아하지 않습니다. 그리고 그가 피를 흘리고 싶어 하는 점에서도 놀랐구요. 당신이 그 점을 불안 요소로서 여기지 않는다는 사실도 마찬가지로 불안하네요.",shape=box,color=blue];
		j1195041789 -> j3409513663;
	j271965286 [label="그리고 당신이 맞서 싸우는 \"코퍼스\"나 \"\"그리니어\"를 지휘하는 자들 역시 같은 말들을 할 거라 생각해요. 적들도 자신들은 잘못된 행동을 하고 있지 않다고 생각하거든요.",shape=box,color=blue];
		j271965286 -> j3557331547;
	j290173817 [label="그리고 당신이 맞서 싸우는 \"코퍼스\"나 \"\"그린-이어\"를 지휘하는 자들 역시 같은 말들을 할 거라 생각해요. 적들도 자신들은 잘못된 행동을 하고 있지 않다고 생각하거든요.",shape=box,color=blue];
		j290173817 -> j3557331547;
	j3409513663 [label="폭력의 죄에는 거부의 방식을 적용하고, 그 공포를 거부하는 것, 그걸 \"중요한 일\"이라는 이름으로 무의미하다고 치부하는 건 너무나도 쉬운 일이죠.",shape=box,color=blue];
		j3409513663 -> j3133130607;
	j3557331547 [label="그들은 자신의 행동이 정의롭고 선하며 필요한 행동이라 믿습니다. 어떻게 한 악마는 용납하시면서 다른 악마는 용납하시지 못하죠 ?",shape=box,color=blue];
		j3557331547 -> j1331304951;
		j3557331547 -> j529031163;
		j3557331547 -> j2058942352;
		j3557331547 -> j542357665;
	j3133130607 [label="그 행위 자체에 자부심을 느끼는 건... 저한테 너무 힘든 일입니다. 전 누군가의 목숨을 빼앗아야 할 때 즐겁지 않으나, 그자는 즐거워 하죠. 그러니까 그런 방식에선? 우리는 꽤 다릅니다.",shape=box,color=blue];
		j3133130607 -> j400750079;
	j1331304951 [label="그들이 내가 동의하지 않는 일들을 하려 할 때 저지하려 노력할거야. 하지만... 필요할 땐 그들 편에서 싸울 거야.",shape=box,color=red];
		j1331304951 -> j3705017189;
	j529031163 [label="그 집단들이 정의상으로 \"선\" 이나 \"악\" 이라고 생각하지 않아. 단지 그들이 취하는 행동에 따라 결정될 뿐이지.",shape=box,color=red];
		j529031163 -> j2725723683;
	j2058942352 [label="어떤 행동은 \"선\"이고, 어떤 행동은 \"악\"이다라고 선언하는 건 내 입장에서 할 말은 아니고. 난 보호받아야 할 사람들을 보호하기 위해 행동할 뿐이지.",shape=box,color=red];
		j2058942352 -> j3705017189;
	j542357665 [label="당신, 내가 개인을 판단할 때 고려하는 기준으로 전체 집단을 판단하라고 요구하고 있어.",shape=box,color=red];
		j542357665 -> j2725723683;
	j400750079 [label="악마가 당신의 갈비뼈에 칼을 꽂으려 해도, 그걸 너무 늦게 깨닫지 않으시길 바랄 뿐입니다. 당신의 마지막 순간에 \"마리가 경고했었지.\"가 스쳐 지나가지 않길 바랍니다.",shape=box,color=blue];
		j400750079 -> j1869603802;
		j400750079 -> j2194206903;
	j3705017189 [label="그리고 당신은 악마가 위협이 아니라고 믿고 있다고요 ? 악마가 주변 이들에게 위험하지 않다고요 ? 그자는 큰 화를 초래할 수 있습니다.",shape=box,color=blue];
		j3705017189 -> j2947791304;
		j3705017189 -> j359502467;
	j2725723683 [label="그자가 저지른 끔찍한 행동들은 어떻고요 ? 그 모든 죽음과 학살은요 ? 당신의 머릿속에는 이런 행동들이 정당한 거라고 고려되나요 ?",shape=box,color=blue];
		j2725723683 -> j359502467;
	j1869603802 [label="로스는 그러지 않을 거야. 그리고 시도한다 해도, 내가 막을 거고.",shape=box,color=red];
		j1869603802 -> j599288894;
	j2194206903 [label="그게 내 마지막 순간에 드는 생각이 아닐 거라고 약속해.",shape=box,color=red];
		j2194206903 -> j4028570150;
	j2947791304 [label="로스가 우릴 배신할 때가 온다면, 내가 직접 움직일 거야. 그때까지 그는 그저 우리 아군일 뿐이라는 게 증명됐으니까... 좀 과장된 표현이긴 하지만.",shape=box,color=red];
		j2947791304 -> j2747773089;
