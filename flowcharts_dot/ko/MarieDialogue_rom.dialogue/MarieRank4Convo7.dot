	j663423135 [label="전 면죄나 도움을 구하는 이들을 외면하고 싶지는 않으나... 그 어느 것도 악마가 원하는 게 아니라고 생각이 듭니다.",shape=box,color=blue];
		j663423135 -> j3825159125;
		j663423135 -> j3210589304;
		j663423135 -> j492546394;
		j663423135 -> j3039724897;
	j3825159125 [label="그럼 당신은 로스가 진짜로 원하는 게 뭐라고 생각해?",shape=box,color=red];
		j3825159125 -> j4025871617;
	j3210589304 [label="두 사람 사이가 안 좋다는 거 알고, 그 점에 대해선 유감이야. 하지만 그렇다고 해서 내가 로스를 쫓아낼 수는 없어.",shape=box,color=red];
		j3210589304 -> j3817575376;
	j492546394 [label="로스는 오로킨에 대해서 우리가 결코 알 수 없을 만큼 많은 것들을 - 말 그대로 - 잊어버린 모양이야. 우리에겐 그자가 필요해.",shape=box,color=red];
		j492546394 -> j3719241924;
	j3039724897 [label="[종료.]",shape=box,color=red];
		j3039724897 -> "Chat ends.";
	j4025871617 [label="그자는 야생동물입니다. 당신이 음식과 따뜻한 보금자리를 제공하면 가까이 올지도 모르지만, 당신이라는 존재가 그에게 더 이상 쓸모가 없어지는 순간 그 모든 것은 사라질 겁니다.",shape=box,color=blue];
		j4025871617 -> j2154408961;
	j3817575376 [label="Add 1 to Thermostat counter",color=orange];
		j3817575376 -> j4015376513;
	j3719241924 [label="Add -1 to Thermostat counter",color=orange];
		j3719241924 -> j4025871617;
	j2154408961 [label="당신에게서 뭔가를 원해요. 우리에게서도요. ",shape=box,color=blue];
		j2154408961 -> j863296879;
	j4015376513 [label="Non, nor 제가 그렇게 하라고 종용하는 게 아니에요. 그저 그 악마를... 믿을 수가 없다는 거에요. 지금도 그렇고, 앞으로도요.",shape=box,color=blue];
		j4015376513 -> j4025871617;
