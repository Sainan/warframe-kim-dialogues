		j4093421340 -> j4132431946 [label="x < 21",color=purple];
		j4093421340 -> j4132431946 [label="false",color=purple];
	j720825400 [label="그자의 잃어버린 기억, 타우에서 경험했던 과거의 공포... 그것들이 무엇을 예고하는지 걱정되요.",shape=box,color=blue];
		j720825400 -> j194842286;
		j720825400 -> j3125155664;
	j4059830218 [label="당신이 그자의 산산 조각난 정신 속에 있는 모든 것들을 밝혀냈다고 생각하시는 거 알아요.",shape=box,color=blue];
		j4059830218 -> j2209587486;
		j4059830218 -> j3125155664;
	j4132431946 [label="우리가 더 많이 배워나가면서, 그의 산산조각난 정신 속으로 더 깊이 파고들수록, 전 점점 불안해져요. 위험도 점점 더 명확해지니까요.",shape=box,color=blue];
		j4132431946 -> j3125155664;
		j4132431946 -> j194842286;
	j194842286 [label="기억이 돌아오는 순간, 로스가 연기처럼 그냥 사라질 거라고 생각하지 않아. 더 중요한 뭔가가 있어.",shape=box,color=red];
		j194842286 -> j1770060846;
	j3125155664 [label="로스가 아직 찾고 있는 게 더 있을 거야. 로스의 기억 속이 아니라, 우리의 기억 속에서 말이야.",shape=box,color=red];
		j3125155664 -> j3455461645;
	j2209587486 [label="로스가 이걸로 우리가 알아낼 수 있는 건 그게 전부라고 말했을 때, 난 그 말을 믿어. 만약 그 말 맞다면, 왜 아직도 여기 있는 건데?",shape=box,color=red];
		j2209587486 -> j1770060846;
	j1770060846 [label="사실 저는 그자의 지식 자체보다 그 지식을 어떻게 활용할지에 대해 더 걱정됩니다.",shape=box,color=blue];
		j1770060846 -> j2094780788;
	j3455461645 [label="Oui ! 바로 그게 제가 걱정하는 부분이에요. 하지만 그게 도대체 뭘까요 ? 지금 우리가 뭘 위해서 그자를 따르는 거죠 ?",shape=box,color=blue];
		j3455461645 -> j2094780788;
	j2094780788 [label="이 새로운 존재를 악마가 어찌 휘두르든, 우리를 끌어들이려는 게 아닐까 두려워요. 그자가 선량할 거라는 희망에 당신의 눈이 멀지 않기를 바랄 뿐입니다.",shape=box,color=blue];
		j2094780788 -> j3220864701;
		j2094780788 -> j4269817780;
		j2094780788 -> j3467243753;
	j3220864701 [label="당신 말에 동의해. 난 그자를 믿지 않아.",shape=box,color=red];
		j3220864701 -> j2707753729;
	j4269817780 [label="로스는 강력하고 박식해. 아군으로 삼고 싶은 존재지.",shape=box,color=red];
		j4269817780 -> j1022954613;
	j3467243753 [label="로스가 우릴 배신하지 않을까에 대해 걱정해봐야 소용없어. - 배신하지 않았거든. 그리고 아직 죄를 저지르지도 않은 사람을 죄인이라고 부르고 싶지도 않아.",shape=box,color=red];
		j3467243753 -> j1712103392;
	j2707753729 [label="+20 Chemistry",color=orange];
		j2707753729 -> j3019550764;
	j1022954613 [label="Add -1 to Thermostat counter",color=orange];
		j1022954613 -> j2123993825;
	j1712103392 [label="Add 1 to Thermostat counter",color=orange];
		j1712103392 -> j2355707116;
	j3019550764 [label="Bien ! 적어도 다른 눈이 그 악마를 지켜보고 있다는 걸 알면 마음이 편해지겠죠. 잠드는 데 도움이 될지도 모르겠네요. Merci.",shape=box,color=blue];
		j3019550764 -> j3984234322;
	j2123993825 [label="Oui, 하지만 그 동맹의 대가가 종국엔 얼마나 될지 궁금해지네요. 그 대가를 치르는 게 기쁘지 않을 수도 있어요.",shape=box,color=blue];
		j2123993825 -> j3690807920;
	j2355707116 [label="Oui... 옳은 말씀이신 것 같아요. 우린 바로 그림자에 휩쓸릴 수 없죠. 무심을 무너뜨리고 싶어하는 이들과 어깨를 나란히 해야겠지요.",shape=box,color=blue];
		j2355707116 -> j808986917;
	j3984234322 [label="Boolean MarieRoatheNoTrust is now true.",color=orange];
		j3984234322 -> "Chat ends.";
	j3690807920 [label="다만 주의하시라고 말씀드리고 싶네요... 그자는 신사의 가죽을 뒤집어 쓴 괴물입니다. 조심하세요, s'il te plaît ?",shape=box,color=blue];
		j3690807920 -> j1531682106;
