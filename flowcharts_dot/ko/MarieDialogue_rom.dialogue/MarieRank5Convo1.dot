		2461 -> 2468 [label="MarieEntratiFan2",color=purple];
		2461 -> 2470 [label="false",color=purple];
	2462 [label="Evaluate expressions",color=orange];
		2462 -> 2473 [label="MarieEntratiMonster1",color=purple];
		2462 -> 2473 [label="MarieEntratiMonster2",color=purple];
		2462 -> 2471 [label="MarieEntratiFan1",color=purple];
		2462 -> 2471 [label="MarieEntratiFan2",color=purple];
		2462 -> 2472 [label="false",color=purple];
	2463 [label="그게 우리가 할 수 있는 일이라 여기시나요 ? Le Cardinal을 추방하는 거요 ? 제 생각엔 그분 스스로 한 것 같은데요, non ?",shape=box,color=blue];
		2463 -> 2474;
		2463 -> 2467;
	2464 [label="리온은 여러 가지 증상을 가지고 있는데, 그중 상당수는 자신과 자신의 마음에 대한 의심에서 비롯된 것 같아요. Le Cardinal은... 오히려 상황을 악화시킨 것 같아요.",shape=box,color=blue];
		2464 -> 2475;
		2464 -> 2467;
	2465 [label="제가 어떻게 하길 바라시나요 ? Le Cardinal의 초상을 불태우고, 그분을 비난할까요 ? M'sieur 태그퍼처럼 그분의 불운을 빌며, 보이드로 밀어넣기라도 해야 하나요 ?",shape=box,color=blue];
		2465 -> 2474;
		2465 -> 2467;
	2466 [label="그게 바로 문제라고, 마리. 당신이 다른 이들에게 바라는 게 있다는 점이야. 다른 이들이 당신에게 요구하는 것이 아니라. 아니면 그들이 엔트라티에게 뭘 요구하는지를 생각해.",shape=box,color=red];
		2466 -> 2476;
	2467 [label="엔트라티는 어디를 가든 다친 존재들만 남겨둔다고. 내가 하려는 건 그 사람들이 모든 걸 다시 온전히 바로잡을 수 있도록 돕는 것일 뿐이야. 그 부분에 있어선 \"선\"이든 \"악\"이든 별로 신경 안 써.",shape=box,color=red];
		2467 -> 2477;
	2469 [label="Oui, 당신은 그분을 향한 증오심이 너무 강하시니까요 ! 제가 한 말이 le Cardinal에 대한 분노를 누그러뜨리는 데 도움 된 게 하나도 없었단 뜻인가요 ?",shape=box,color=blue];
		2469 -> 2482;
	2468 [label="방금 전까지만 해도 당신도 저처럼 엔트라티를 얼마나 좋아하는지 말씀하시지 않으셨나요 ? 그런데 지금 와서 무슨 심경의 변화를 느끼신 거죠 ?",shape=box,color=blue];
		2468 -> 2478;
		2468 -> 2479;
		2468 -> 2480;
		2468 -> 2481;
	2470 [label="Oui, 그리고 당신은 엔트라티를 정말 monstre로 생각하시니까요 ! 당신은 그분의 친절을 너무도 쉽게 무시하시는 군요 !",shape=box,color=blue];
		2470 -> 2482;
	2473 [label="방금 전까지만 해도 엔트라티의 monstruosité에 대해서 말씀하시지 않으셨나요 ? 지금 와서 생각이 바뀌신 이유가 뭐죠 ?",shape=box,color=blue];
		2473 -> 2478;
		2473 -> 2479;
		2473 -> 2480;
		2473 -> 2481;
	2471 [label="Merci, 당신은 이 성전에서 제 든든한 동반자세요 ! 이런 마음을 가지는 건 우리 뿐인가 봐요 - Monsieur 로이드조차도 그런 원망을 품고 계시니까요...",shape=box,color=blue];
		2471 -> 2483;
	2472 [label="Merci, 그 말을 들어서 제가 얼마나 기쁜지 모르실 거에요 ! 이런 마음을 가지는 건 우리 뿐인가 봐요 - Monsieur 로이드조차도 그런 원망을 품고 계시니까요...",shape=box,color=blue];
		2472 -> 2483;
	2474 [label="내 생각엔 다른 사람들이 당신에게 무엇을 요구하느냐가 아니라 당신이 다른 사람들에게 무엇을 요구하느냐가 더 중요한 것 같은데, 아니면 엔트라티에게 말이야.",shape=box,color=red];
		2474 -> 2476;
	2475 [label="그리고 그 점이 당신한테는 문제가 안된다고?",shape=box,color=red];
		2475 -> 2484;
	2476 [label="그리고 제가 다른 이들에게 터무니없는 것을 요구하는 게 달리 또 뭐가 있나요 ? 그들의 마음에 용서를 받아들이라는 거요?",shape=box,color=blue];
		2476 -> 2485;
		2476 -> 2486;
	2477 [label="고귀하지만, 성가시기도 한데다, 시공간을 여행하면서 자신의 mécontents을 돕는다는 거죠, non ? 당신은 분명 이 일로 그분에 대해 분함을 표하시겠죠...",shape=box,color=blue];
		2477 -> 2487;
		2477 -> 2488;
	2482 [label="이 대화 자체가 실수였어요...",shape=box,color=blue];
		2482 -> 2493;
		2482 -> 2494;
	2478 [label="솔직히 이 주제를 당신과 함께 풀어나가는 데 정말 애를 많이 먹었어. 정말이지 너무 고통스러웠어. 개인적으로 그 인간은... 선하지도 악하다고 생각치 않아. 그냥 둘 다 혼재된 존재라고 생각할 뿐이야.",shape=box,color=red];
		2478 -> 2489;
	2479 [label="마음을 바꿨어. 난 엔트라티 편이야. 그리고 당신 편이기도 하고. 당신이 날 설득했거든.",shape=box,color=red];
		2479 -> 2490;
	2480 [label="[마음을 고백한다.] 난 그저... 당신 편에 서려고 최선을 다해 노력했을 뿐이야. 당신을 좋아하니까. 내가 표현한 것보다 훨씬 더 많이.",shape=box,color=red];
		2480 -> 2491;
	2481 [label="마음을 바꿨고 그 인간이 괴물이라고 결정했어. 완전히 말이야.",shape=box,color=red];
		2481 -> 2492;
	2483 [label="함께라면, 그분의 선행을 깎아내리려는 이들로부터 모두를 지킬 수 있을지도요, oui ? 그렇지만 궁금하네요. 당신을 둘러싼 모든 것에 맞서서...왜 제 편을 들어주시는 거죠 ?",shape=box,color=blue];
		2483 -> 2495;
	2484 [label="Check boolean LyonDating",color=orange];
		2484 -> 2496 [label=true,color=green];
		2484 -> 2497 [label=false,color=brown];
	2485 [label="당신은 엔트라티를 너무 높게 평가하고 있어, 마리. 그리고 다른 사람들한테 당신 기준에 똑같이 맞추라고 요구하는 건 바보같은 짓이야.",shape=box,color=red];
		2485 -> 2498;
	2486 [label="엔트라티를 용서하는 것 이상의 일을 하라고 요구하는 것 같다고. 그 인간이 벌인 일들이 전혀 잘못된 것들이 아니다라는 척을 하라고 요구하는 것 같다고.",shape=box,color=red];
		2486 -> 2499;
	2487 [label="물론이야. 하지만 내가 맺은 가장 중요한 관계들과 우정의 일부에 대해서 엔트라티를 \"감사\"해야 할 존재라고 생각하긴 해.",shape=box,color=red];
		2487 -> 2500;
	2488 [label="아니, 꼭 그렇진 않아. 엔트라티가 나에게 해줬음 하는 일이 있다고 하면, 할 거야. 이 모든 일이 다 끝나면 그 때 가서 판단할거고.",shape=box,color=red];
		2488 -> 2500;
	2493 [label="잠깐만, 마리. 제발. 설명할 시간을 줘.",shape=box,color=red];
		2493 -> 2505;
		2493 -> 2506;
		2493 -> 2507;
		2493 -> 2508;
	2494 [label="엔트라티에 대한 내 생각을 분명히 밝혔어. 미안해. 어떤 부분에 대해선 우리 의견이 일치하지 않는 것 같아.",shape=box,color=red];
		2494 -> 2509;
