	j2928229665 [label="아무래도 그분께선 단순히 몸만 치유될 수 있도록 독을 찔러 넣으신 것 뿐이고, 이 모든 것은 그저 불가피한 잔혹함인 것 같네요.",shape=box,color=blue];
