	j214368386 [label="그분이 당신 마음속에 자리를 잡고 있다는 거 알고 있고, 이에 대해서 진심으로 감사히 생각하고 있어요 - 아마도 마침내 그분에 대한 걱정을 멈출 수 있을거고, 이 모든 싸움도 무의미해지겠죠 -",shape=box,color=blue];
