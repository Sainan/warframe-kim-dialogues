		2495 -> 2510;
		2495 -> 2511;
		2495 -> 2512;
	2496 [label="그분이 당신 마음속에 자리를 잡고 있다는 거 알고 있고, 이에 대해서 진심으로 감사히 생각하고 있어요 - 아마도 마침내 그분에 대한 걱정을 멈출 수 있을거고, 이 모든 싸움도 무의미해지겠죠 -",shape=box,color=blue];
		2496 -> 2497;
	2497 [label="그렇지만 마음이 아프네요. 리온은 제 마음의 형제니까요 ! 리온은 이 세상에서 가장 소중한 존재이며, 그가 agonie으로 힘들어하는 모습을 보면 마치 제 고통인냥 가슴이 아파요.",shape=box,color=blue];
		2497 -> 2513;
	2498 [label="말 조심하세요, 드리프터.",shape=box,color=blue];
		2498 -> 2514;
	2499 [label="Je ne suis pas naïve, 제가 그런 존재인 것처럼 말하지 마세요 !",shape=box,color=blue];
		2499 -> 2515;
	2500 [label="아무래도 그분께선 단순히 몸만 치유될 수 있도록 독을 찔러 넣으신 것 뿐이고, 이 모든 것은 그저 불가피한 잔혹함인 것 같네요.",shape=box,color=blue];
		2500 -> 2516;
		2500 -> 2517;
	2505 [label="[마음을 고백한다.] 당신을 많이 아껴. 내가 표현하는 것보다 훨씬 더. 그리고... 너무 당신에게 너무 심하게 굴어서 미안하지만, 그 인간이 다른 사람들을 다치게 한 것처럼, 당신을 다치게 둘 순 없어.",shape=box,color=red];
		2505 -> 2523;
	2506 [label="그 인간은 자기가 아끼는 사람들에게 도움을 주기는 커녕 불타는 걸 지켜만보고 아무것도 안하는 걸 봐왔어. 자기가 사랑했다고 생각하는 모든 사람들을 말이야. 당신에게도 똑같이 하는 걸 보고 싶지 않아...",shape=box,color=red];
		2506 -> 2524;
	2507 [label="스스로를 잘 표현하지 못해서 미안해. 하지만... 그 인간은 당신을 이용하고 있고, 당신의 친절함을 이용해서 조종하고 있는 것 같아서 그래. 그게 다야.",shape=box,color=red];
		2507 -> 2525;
	2508 [label="당신 눈에 엔트라티가 구세주로 보일진 몰라도, 내 눈엔 그저 늙고 겁에 질린채 답을 찾아 헤메는 인간으로 밖에 안 보여. 어쩌면 그 인간에 대한 해답은 그 사이 어딘가에 있을지도 모르지.",shape=box,color=red];
		2508 -> 2498;
	2509 [label="Oui. 그런 것 같네요.",shape=box,color=blue];
		2509 -> 2526;
