	2529 [label="Update boolean MarieWillDate",color=orange];
		2529 -> 2542;
	2530 [label="마리, 그 인간은 신이 아니야. 그냥 인간이라고. 로스만큼이나 오만하고 위험할 뿐이야. 동일한 사회에서 왔고, 그 사회 속에 내재되어 있던 문제들을 똑같이 겪고 있다고.",shape=box,color=red];
		2530 -> 2543;
	2531 [label="그 인간이 당신에게 친절하게 대했다는 거 알아. 당신에게 있어서 그 인간이 수많은 사람들과 달랐을지도 몰라. 어쩌면 당신을 딸처럼 대했을지도... 하지만 나무만 보지 말고, 숲을 봐줘. 제발.",shape=box,color=red];
