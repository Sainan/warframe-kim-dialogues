	2430 [label="당신이 le Cardinal에 대해서 한 말을 곰곰이 생각해 봤어요. 그분의 행동이... 선과 악이 \"뒤섞인 것 같다\" 라는 말이요.",shape=box,color=blue];
		2430 -> 2436;
	2431 [label="당신이 le Cardinal에 대해서 한 말을 곰곰이 생각해 봤어요. 그분의 행동이... 리온에게 고통을 안겨주었다는 말이요.",shape=box,color=blue];
		2431 -> 2436;
	2432 [label="M'sieur 태그퍼와 나눈 대화에서 그가 le Cadinal을 그토록 싫어하는 이유에 대한 당신의 설득력 있는 주장에 대해 곰곰이 생각해 봤어요.",shape=box,color=blue];
		2432 -> 2436;
	2433 [label="M'sieur 태그퍼와의 논쟁에서 그가 왜 le Cardinal을 멸시하는 지에 대한 이유를 곰곰이 생각해 봤어요.",shape=box,color=blue];
		2433 -> 2436;
	2434 [label="M'sieur 태그퍼와의 논쟁에 대해 곰곰이 생각해 봤어요. 그리고 그 논쟁에 대한 우리의 논쟁도요.",shape=box,color=blue];
		2434 -> 2436;
	2435 [label="Le Cardinal에 대해 아직 알려지지도, 말해지지도 않은 것들이 너무 많다는 생각이 들어요. 다른 이들이 제 주변에선 계란 껍질 위를 걷듯 조심히 다니며, 그분에 대해 말하기를 두려워하는 것 같아요.",shape=box,color=blue];
		2435 -> 2436;
	2436 [label="다른 분들이 그분을 망종, 미치광이, 배신자로 표현하고 싶어하시는 거 압니다. 하지만 제겐 그런 존재가 아니었어요.",shape=box,color=blue];
		2436 -> 2437;
	2437 [label="Check boolean MarieBackstory1",color=orange];
		2437 -> 2439 [label=true,color=green];
		2437 -> 2438 [label=false,color=brown];
	2439 [label="아무래도 제가 버려지는 일에 너무 익숙해져서 그런거겠죠. ",shape=box,color=blue];
		2439 -> 2440;
	2438 [label="전 어렸을 때, 가족에게 버림받고, 길거리에 내버려졌습니다. 제 육신이... 비정상적이라는 이유로요. 망가졌다고, 상류 사회에 부적합하다는 이유로요.",shape=box,color=blue];
		2438 -> 2440;
	2440 [label="아무래도 제 삶 속에 아버지란 존재가 없었으니까, 그렇기에 그분의 부재를 기꺼이 용서할 수 있는 걸지도요.",shape=box,color=blue];
		2440 -> 2441;
	2441 [label="Evaluate expressions",color=orange];
		2441 -> 2442 [label="MarieEntrati4a",color=purple];
		2441 -> 2443 [label="MarieEntrati4b",color=purple];
		2441 -> 2444 [label="MarieEntrati3a",color=purple];
		2441 -> 2445 [label="MarieEntrati3b",color=purple];
		2441 -> 2446 [label="MarieEntrati3",color=purple];
		2441 -> 2447 [label="false",color=purple];
	2442 [label="하지만 전 그분을 용서합니다. 그분의 악행에 있어서 타인에게 끼쳤던 해보다도 그분의 선행에 더 큰 가치를 두기 때문이에요.",shape=box,color=blue];
		2442 -> 2448;
		2442 -> 2449;
		2442 -> 2450;
		2442 -> 2451;
		2442 -> 2452;
	2443 [label="전 리온이 강하고 신앙의 위기를 극복하기를 기도하지만, 그것이 전적으로 le Cardinal의 잘못이라고는 믿지 않습니다.",shape=box,color=blue];
		2443 -> 2448;
		2443 -> 2449;
		2443 -> 2450;
		2443 -> 2453;
		2443 -> 2454;
	2444 [label="그래서 M'sieur 태그퍼와 le Cardinal께 피해를 입은 분들에 대한 당신의 설득력 있는 의견을 감사히 여기지만... 여전히 그분의 악행에 있어서 타인에게 끼쳤던 해보다도 그분의 선행에 더 큰 가치를 둡니다.",shape=box,color=blue];
		2444 -> 2448;
		2444 -> 2449;
		2444 -> 2450;
		2444 -> 2455;
		2444 -> 2456;
	2445 [label="그래서 M'sieur 태그퍼의 분노를 이해하고 그의 의견에 공감을 할 순 있지만, M'sieur 태그퍼는 le Cardinal을 용서할 마음의 여유를 스스로 찾으셔야 해요. 저는 그분의 악행에 있어서 타인에게 끼쳤던 해보다도 그분의 선행에 더 큰 가치를 둡니다.",shape=box,color=blue];
		2445 -> 2448;
		2445 -> 2449;
		2445 -> 2450;
		2445 -> 2457;
		2445 -> 2458;
	2446 [label="그래서 전 le Cardinal과 함께한 역사가 있는 이들, 특히 M'sieur 태그퍼를 감사히 여기지만, 전 아직까지 그분의 악행에 있어서 타인에게 끼쳤던 해보다도 그 분의 선행에 더 큰 가치를 둡니다.",shape=box,color=blue];
		2446 -> 2448;
		2446 -> 2449;
		2446 -> 2450;
		2446 -> 2459;
	2447 [label="그래서 전 le Cardinal과 함께한 역사가 있는 이들을 감사히 여기지만, 전 아직까지 그분의 악행에 있어서 타인에게 끼쳤던 해보다도 그 분의 선행에 더 큰 가치를 둡니다.",shape=box,color=blue];
		2447 -> 2448;
		2447 -> 2449;
		2447 -> 2450;
	2448 [label="당신의 삶에서 그 인간이 행한 좋은 일들을 감사히 받아들이는 당신을 비난하지 않는 것처럼, 그 인간으로 인해 자신들의 삶에 악영향이 생겼다는 다른 사람들을 탓하지 않는 것과 같아.",shape=box,color=red];
		2448 -> 2460;
	2449 [label="잘 모르겠어. 그 인간의 행동이 좋은 결과보단 해로운 결과들을 더 많이 낳았다고 생각해. 그걸 알아봐줬으면 좋겠어.",shape=box,color=red];
		2449 -> 2461;
	2450 [label="난 당신 편이야, 마리. 엔트라티가 한 짓을 비난할 순 없어. 그도 무심과 싸우고 있으니까.",shape=box,color=red];
		2450 -> 2462;
	2451 [label="당신이 엔트라티를 용서하는 건 옳은 일이야. 다른 사람들도 당신을 따라서 용서할 수 있으면 좋겠어.",shape=box,color=red];
		2451 -> 2462;
	2452 [label="용서를 구하는 누군가를 비난하진 않을거야. 하지만 스스로와 다른 사람들을 다른 뭔가로부터 보호해야 한다는 걸 이해한다면 용서는 할 수 있을지도.",shape=box,color=red];
		2452 -> 2463;
	2453 [label="리온의 고통이 그 인간의 잘못이라고 생각해?",shape=box,color=red];
		2453 -> 2464;
	2454 [label="리온은 신앙의 위기보다도 훨씬 더 큰 고통을 겪고 있어, 마리. 그리고 그 중 많은 부분이 엔트라티와 관련이 있고.",shape=box,color=red];
		2454 -> 2461;
	2455 [label="내가 해왔던 말들이 조금이라도 균형을 맞추는 데 도움이 되지 않았어?",shape=box,color=red];
		2455 -> 2465;
	2456 [label="엔트라티가 한 모든 일들을 돌아보면서 어떻게 해악보다 선한 점들이 더 많다고 생각할 수 있어?",shape=box,color=red];
		2456 -> 2461;
	2457 [label="당신은 카비아들과 태그퍼가 겪은 일의 심각성을 과소평가하고 있어.",shape=box,color=red];
		2457 -> 2461;
	2458 [label="용서, 중요하지. 하지만 엔트라티라는 존재가 당신이 받아들이고 싶어하는 부분보다 훨씬 더 복잡할 수 있는 존재라는 걸 인정하는 것도 중요하다고 생각해.",shape=box,color=red];
		2458 -> 2465;
	2459 [label="아직도 태그퍼와 카비아들이 겪은 고통을 이해하지 못하는 것 같네. 당신이 겪은 것보다 훨씬 더 심한 걸 겪었다고.",shape=box,color=red];
		2459 -> 2461;
	2460 [label="하지만 원망과 존경, 이 두 개의 단어가 동등한 가치가 아니란 거 아시나요 ? 전 다른 이들이 악의적인 원한을 버리길 바래요.",shape=box,color=blue];
		2460 -> 2466;
		2460 -> 2467;
	2461 [label="Evaluate expressions",color=orange];
		2461 -> 2469 [label="MarieEntratiMonster1",color=purple];
		2461 -> 2469 [label="MarieEntratiMonster2",color=purple];
