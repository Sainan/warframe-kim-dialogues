		2510 -> 2527;
	2511 [label="이 전쟁에는 뭐든 필요하다고 생각해. 결국 우리는 무심으로부터 우주를 구하려는 거잖아, 안 그래?",shape=box,color=red];
		2511 -> 2528;
	2512 [label="엔트라티를 믿어. 진심으로. 그야말로 이 문제를 해결할 계획을 가지고 있고, 이 모든 것이 궁극적으로 선을 위한 행동이라고 생각해.",shape=box,color=red];
		2512 -> 2529;
	2513 [label="하지만 리온의 신앙에 대한 절망은 le Cardinal의 탓이 아닙니다. 기반에 균열이 생긴 거에요. 그저 더 큰 압력이 가해진 것 뿐이죠, oui ?",shape=box,color=blue];
		2513 -> 2500;
	2514 [label="Update boolean MarieWarning",color=orange];
		2514 -> 2499;
	2515 [label="전 le Cardinal이 루아이자 솔, - 빛과 어둠 - 선과 악이라는 걸 잘 알고 있습니다. 그분은 둘 다 아니며, 친절함과 잔혹함을 모두 가지고 계십니다.",shape=box,color=blue];
		2515 -> 2530;
		2515 -> 2531;
	2516 [label="그래서 당신이 그 인간에 대해 말할 때 다른 애들이 화내는 거라고. 당신은 엔트라티가 다른 사람들에게 상처 준 모든 일들을 덮어두고, 마치 바보처럼 아무 일도 없었던 척 하라고 하잖아.",shape=box,color=red];
		2516 -> 2498;
	2517 [label="마리, 그만. 당신한테 그 인간이 좋은 사람이었다고 이 모든 걸 순수한 의도로 벌여놨다는 게 아니란 걸 받아들여야 해. 그 인간은 좋은 사람이 아니야. 그보다 훨씬 더 복잡한 존재라고.",shape=box,color=red];
