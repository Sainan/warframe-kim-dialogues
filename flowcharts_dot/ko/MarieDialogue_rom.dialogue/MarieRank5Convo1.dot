		2563 -> 2572;
	2564 [label="Oui ! Précisément. 그리고 저는 때가 됐을 때 모두가 제자리를 찾으리라 확신이 들어요. 이 문제에 대해서 저와 함께할 친구가 있어서 얼마나 기쁜지 몰라요.",shape=box,color=blue];
		2564 -> 2573;
	2565 [label="날 믿어, 당신은 아무것도 몰라. 셀 수도 없는 수많은 존재들이 이 일로 목숨을 잃었어. 그리고 그 인간 때문에 삶이 망가진 존재들의 이름을 목록으로 정리해서 뽑아놓을 수도 있다고. 그렇다고 해서 아무도 무심의 존재를 잊지는 않았어.",shape=box,color=red];
		2565 -> 2574;
	2566 [label="그분의 따님을 만나게 된다면 분명 머지않아 잘 알게 되겠죠 ! 여기 있는 모든 이들은 그분에게 당한 모든 고통을 너무 빨리 말해버려요 ! Le Cardinal이 돌아오지 않는 것도 당연하시죠. 제가 그분이였다고 해도 단 한 순간도 여기서 시간을 보내지 않을테니까요 -",shape=box,color=blue];
		2566 -> 2575;
	2567 [label="그렇다고 해서 그분이 떠나버릴 거라곤 생각하지 않아요 ! Le Cardinal께서 이 vipères의 소굴로 돌아오실 거라 생각하시나요 ?! Non ! 제가 그분이였다고 해도 단 한 순간도 여기서 시간을 보내지 않을테니까요 - ",shape=box,color=blue];
