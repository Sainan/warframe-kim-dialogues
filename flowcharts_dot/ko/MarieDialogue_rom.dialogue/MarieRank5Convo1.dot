	j4015554002 [label="Oui ! Précisément. 그리고 저는 때가 됐을 때 모두가 제자리를 찾으리라 확신이 들어요. 이 문제에 대해서 저와 함께할 친구가 있어서 얼마나 기쁜지 몰라요.",shape=box,color=blue];
