		2555 -> 2565;
		2555 -> 2557;
	2556 [label="지금 막연하게 추측만 하고 있는 거잖아. 당신도 자세히 모르잖아. 엔트라티의 친딸을 만난 적도 없고, 어떤 일을 겪었는지, 어떤 고통을 견뎌냈는지 전혀 모르잖아.",shape=box,color=red];
