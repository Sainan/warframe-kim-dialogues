		j2928229665 -> j1712538047;
	j2595537661 [label="[마음을 고백한다.] 당신을 많이 아껴. 내가 표현하는 것보다 훨씬 더. 그리고... 너무 당신에게 너무 심하게 굴어서 미안하지만, 그 인간이 다른 사람들을 다치게 한 것처럼, 당신을 다치게 둘 순 없어.",shape=box,color=red];
		j2595537661 -> j2892740682;
	j2915173600 [label="그 인간은 자기가 아끼는 사람들에게 도움을 주기는 커녕 불타는 걸 지켜만보고 아무것도 안하는 걸 봐왔어. 자기가 사랑했다고 생각하는 모든 사람들을 말이야. 당신에게도 똑같이 하는 걸 보고 싶지 않아...",shape=box,color=red];
		j2915173600 -> j149343570;
	j1163829755 [label="스스로를 잘 표현하지 못해서 미안해. 하지만... 그 인간은 당신을 이용하고 있고, 당신의 친절함을 이용해서 조종하고 있는 것 같아서 그래. 그게 다야.",shape=box,color=red];
