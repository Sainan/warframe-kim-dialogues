		j709500590 -> j3440982079 [label="MarieEntrati3",color=purple];
		j709500590 -> j3136737246 [label="false",color=purple];
	j4234271295 [label="당신이 le Cardinal에 대해서 한 말을 곰곰이 생각해 봤어요. 그분의 행동이... 선과 악이 \"뒤섞인 것 같다\" 라는 말이요.",shape=box,color=blue];
		j4234271295 -> j2540696233;
	j1310252428 [label="당신이 le Cardinal에 대해서 한 말을 곰곰이 생각해 봤어요. 그분의 행동이... 리온에게 고통을 안겨주었다는 말이요.",shape=box,color=blue];
		j1310252428 -> j2540696233;
	j312688416 [label="M'sieur 태그퍼와 나눈 대화에서 그가 le Cadinal을 그토록 싫어하는 이유에 대한 당신의 설득력 있는 주장에 대해 곰곰이 생각해 봤어요.",shape=box,color=blue];
		j312688416 -> j2540696233;
	j49015092 [label="M'sieur 태그퍼와의 논쟁에서 그가 왜 le Cardinal을 멸시하는 지에 대한 이유를 곰곰이 생각해 봤어요.",shape=box,color=blue];
		j49015092 -> j2540696233;
	j3440982079 [label="M'sieur 태그퍼와의 논쟁에 대해 곰곰이 생각해 봤어요. 그리고 그 논쟁에 대한 우리의 논쟁도요.",shape=box,color=blue];
		j3440982079 -> j2540696233;
	j3136737246 [label="Le Cardinal에 대해 아직 알려지지도, 말해지지도 않은 것들이 너무 많다는 생각이 들어요. 다른 이들이 제 주변에선 계란 껍질 위를 걷듯 조심히 다니며, 그분에 대해 말하기를 두려워하는 것 같아요.",shape=box,color=blue];
		j3136737246 -> j2540696233;
	j2540696233 [label="다른 분들이 그분을 망종, 미치광이, 배신자로 표현하고 싶어하시는 거 압니다. 하지만 제겐 그런 존재가 아니었어요.",shape=box,color=blue];
		j2540696233 -> j2718976672;
	j2718976672 [label="Check boolean MarieBackstory1",color=orange];
		j2718976672 -> j773372717 [label=true,color=green];
		j2718976672 -> j1230523285 [label=false,color=brown];
	j773372717 [label="아무래도 제가 버려지는 일에 너무 익숙해져서 그런거겠죠. ",shape=box,color=blue];
		j773372717 -> j3532976881;
	j1230523285 [label="전 어렸을 때, 가족에게 버림받고, 길거리에 내버려졌습니다. 제 육신이... 비정상적이라는 이유로요. 망가졌다고, 상류 사회에 부적합하다는 이유로요.",shape=box,color=blue];
		j1230523285 -> j3532976881;
	j3532976881 [label="아무래도 제 삶 속에 아버지란 존재가 없었으니까, 그렇기에 그분의 부재를 기꺼이 용서할 수 있는 걸지도요.",shape=box,color=blue];
		j3532976881 -> j4106479212;
	j4106479212 [label="Evaluate expressions",color=orange];
		j4106479212 -> j875563169 [label="MarieEntrati4a",color=purple];
		j4106479212 -> j195916801 [label="MarieEntrati4b",color=purple];
		j4106479212 -> j4236213317 [label="MarieEntrati3a",color=purple];
		j4106479212 -> j1577756633 [label="MarieEntrati3b",color=purple];
		j4106479212 -> j4270867959 [label="MarieEntrati3",color=purple];
		j4106479212 -> j1114507640 [label="false",color=purple];
	j875563169 [label="하지만 전 그분을 용서합니다. 그분의 악행에 있어서 타인에게 끼쳤던 해보다도 그분의 선행에 더 큰 가치를 두기 때문이에요.",shape=box,color=blue];
		j875563169 -> j2680460814;
		j875563169 -> j912001995;
		j875563169 -> j496176625;
		j875563169 -> j1430171619;
		j875563169 -> j831278866;
	j195916801 [label="전 리온이 강하고 신앙의 위기를 극복하기를 기도하지만, 그것이 전적으로 le Cardinal의 잘못이라고는 믿지 않습니다.",shape=box,color=blue];
		j195916801 -> j2680460814;
		j195916801 -> j912001995;
		j195916801 -> j496176625;
		j195916801 -> j217574909;
		j195916801 -> j3665009229;
	j4236213317 [label="그래서 M'sieur 태그퍼와 le Cardinal께 피해를 입은 분들에 대한 당신의 설득력 있는 의견을 감사히 여기지만... 여전히 그분의 악행에 있어서 타인에게 끼쳤던 해보다도 그분의 선행에 더 큰 가치를 둡니다.",shape=box,color=blue];
		j4236213317 -> j2680460814;
		j4236213317 -> j912001995;
		j4236213317 -> j496176625;
		j4236213317 -> j1932025813;
		j4236213317 -> j3915492431;
	j1577756633 [label="그래서 M'sieur 태그퍼의 분노를 이해하고 그의 의견에 공감을 할 순 있지만, M'sieur 태그퍼는 le Cardinal을 용서할 마음의 여유를 스스로 찾으셔야 해요. 저는 그분의 악행에 있어서 타인에게 끼쳤던 해보다도 그분의 선행에 더 큰 가치를 둡니다.",shape=box,color=blue];
		j1577756633 -> j2680460814;
		j1577756633 -> j912001995;
		j1577756633 -> j496176625;
		j1577756633 -> j2724347432;
		j1577756633 -> j78982087;
	j4270867959 [label="그래서 전 le Cardinal과 함께한 역사가 있는 이들, 특히 M'sieur 태그퍼를 감사히 여기지만, 전 아직까지 그분의 악행에 있어서 타인에게 끼쳤던 해보다도 그 분의 선행에 더 큰 가치를 둡니다.",shape=box,color=blue];
		j4270867959 -> j2680460814;
		j4270867959 -> j912001995;
		j4270867959 -> j496176625;
		j4270867959 -> j2288798412;
	j1114507640 [label="그래서 전 le Cardinal과 함께한 역사가 있는 이들을 감사히 여기지만, 전 아직까지 그분의 악행에 있어서 타인에게 끼쳤던 해보다도 그 분의 선행에 더 큰 가치를 둡니다.",shape=box,color=blue];
		j1114507640 -> j2680460814;
		j1114507640 -> j912001995;
		j1114507640 -> j496176625;
	j2680460814 [label="당신의 삶에서 그 인간이 행한 좋은 일들을 감사히 받아들이는 당신을 비난하지 않는 것처럼, 그 인간으로 인해 자신들의 삶에 악영향이 생겼다는 다른 사람들을 탓하지 않는 것과 같아.",shape=box,color=red];
		j2680460814 -> j1701758152;
	j912001995 [label="잘 모르겠어. 그 인간의 행동이 좋은 결과보단 해로운 결과들을 더 많이 낳았다고 생각해. 그걸 알아봐줬으면 좋겠어.",shape=box,color=red];
		j912001995 -> j4288371264;
	j496176625 [label="난 당신 편이야, 마리. 엔트라티가 한 짓을 비난할 순 없어. 그도 무심과 싸우고 있으니까.",shape=box,color=red];
		j496176625 -> j3142094137;
	j1430171619 [label="당신이 엔트라티를 용서하는 건 옳은 일이야. 다른 사람들도 당신을 따라서 용서할 수 있으면 좋겠어.",shape=box,color=red];
		j1430171619 -> j3142094137;
	j831278866 [label="용서를 구하는 누군가를 비난하진 않을거야. 하지만 스스로와 다른 사람들을 다른 뭔가로부터 보호해야 한다는 걸 이해한다면 용서는 할 수 있을지도.",shape=box,color=red];
		j831278866 -> j3856677370;
	j217574909 [label="리온의 고통이 그 인간의 잘못이라고 생각해?",shape=box,color=red];
		j217574909 -> j1839526089;
	j3665009229 [label="리온은 신앙의 위기보다도 훨씬 더 큰 고통을 겪고 있어, 마리. 그리고 그 중 많은 부분이 엔트라티와 관련이 있고.",shape=box,color=red];
		j3665009229 -> j4288371264;
	j1932025813 [label="내가 해왔던 말들이 조금이라도 균형을 맞추는 데 도움이 되지 않았어?",shape=box,color=red];
		j1932025813 -> j3754952093;
	j3915492431 [label="엔트라티가 한 모든 일들을 돌아보면서 어떻게 해악보다 선한 점들이 더 많다고 생각할 수 있어?",shape=box,color=red];
		j3915492431 -> j4288371264;
	j2724347432 [label="당신은 카비아들과 태그퍼가 겪은 일의 심각성을 과소평가하고 있어.",shape=box,color=red];
		j2724347432 -> j4288371264;
	j78982087 [label="용서, 중요하지. 하지만 엔트라티라는 존재가 당신이 받아들이고 싶어하는 부분보다 훨씬 더 복잡할 수 있는 존재라는 걸 인정하는 것도 중요하다고 생각해.",shape=box,color=red];
		j78982087 -> j3754952093;
	j2288798412 [label="아직도 태그퍼와 카비아들이 겪은 고통을 이해하지 못하는 것 같네. 당신이 겪은 것보다 훨씬 더 심한 걸 겪었다고.",shape=box,color=red];
		j2288798412 -> j4288371264;
	j1701758152 [label="하지만 원망과 존경, 이 두 개의 단어가 동등한 가치가 아니란 거 아시나요 ? 전 다른 이들이 악의적인 원한을 버리길 바래요.",shape=box,color=blue];
		j1701758152 -> j2095074031;
		j1701758152 -> j3386379666;
	j4288371264 [label="Evaluate expressions",color=orange];
		j4288371264 -> j2524794408 [label="MarieEntratiMonster1",color=purple];
		j4288371264 -> j2524794408 [label="MarieEntratiMonster2",color=purple];
		j4288371264 -> j3974671634 [label="MarieEntratiFan1",color=purple];
		j4288371264 -> j3974671634 [label="MarieEntratiFan2",color=purple];
		j4288371264 -> j3422549395 [label="false",color=purple];
	j3142094137 [label="Evaluate expressions",color=orange];
		j3142094137 -> j1765812419 [label="MarieEntratiMonster1",color=purple];
		j3142094137 -> j1765812419 [label="MarieEntratiMonster2",color=purple];
		j3142094137 -> j479639961 [label="MarieEntratiFan1",color=purple];
		j3142094137 -> j479639961 [label="MarieEntratiFan2",color=purple];
		j3142094137 -> j1654906341 [label="false",color=purple];
	j3856677370 [label="그게 우리가 할 수 있는 일이라 여기시나요 ? Le Cardinal을 추방하는 거요 ? 제 생각엔 그분 스스로 한 것 같은데요, non ?",shape=box,color=blue];
		j3856677370 -> j1635480819;
		j3856677370 -> j3386379666;
	j1839526089 [label="리온은 여러 가지 증상을 가지고 있는데, 그중 상당수는 자신과 자신의 마음에 대한 의심에서 비롯된 것 같아요. Le Cardinal은... 오히려 상황을 악화시킨 것 같아요.",shape=box,color=blue];
		j1839526089 -> j3395099572;
		j1839526089 -> j3386379666;
	j3754952093 [label="제가 어떻게 하길 바라시나요 ? Le Cardinal의 초상을 불태우고, 그분을 비난할까요 ? M'sieur 태그퍼처럼 그분의 불운을 빌며, 보이드로 밀어넣기라도 해야 하나요 ?",shape=box,color=blue];
		j3754952093 -> j1635480819;
		j3754952093 -> j3386379666;
	j2095074031 [label="그게 바로 문제라고, 마리. 당신이 다른 이들에게 바라는 게 있다는 점이야. 다른 이들이 당신에게 요구하는 것이 아니라. 아니면 그들이 엔트라티에게 뭘 요구하는지를 생각해.",shape=box,color=red];
		j2095074031 -> j3463412639;
	j3386379666 [label="엔트라티는 어디를 가든 다친 존재들만 남겨둔다고. 내가 하려는 건 그 사람들이 모든 걸 다시 온전히 바로잡을 수 있도록 돕는 것일 뿐이야. 그 부분에 있어선 \"선\"이든 \"악\"이든 별로 신경 안 써.",shape=box,color=red];
		j3386379666 -> j2403257895;
	j2524794408 [label="Oui, 당신은 그분을 향한 증오심이 너무 강하시니까요 ! 제가 한 말이 le Cardinal에 대한 분노를 누그러뜨리는 데 도움 된 게 하나도 없었단 뜻인가요 ?",shape=box,color=blue];
		j2524794408 -> j3421499955;
	j3974671634 [label="방금 전까지만 해도 당신도 저처럼 엔트라티를 얼마나 좋아하는지 말씀하시지 않으셨나요 ? 그런데 지금 와서 무슨 심경의 변화를 느끼신 거죠 ?",shape=box,color=blue];
		j3974671634 -> j3660841512;
		j3974671634 -> j1299046569;
		j3974671634 -> j619391684;
		j3974671634 -> j2469954477;
	j3422549395 [label="Oui, 그리고 당신은 엔트라티를 정말 monstre로 생각하시니까요 ! 당신은 그분의 친절을 너무도 쉽게 무시하시는 군요 !",shape=box,color=blue];
		j3422549395 -> j3421499955;
	j1765812419 [label="방금 전까지만 해도 엔트라티의 monstruosité에 대해서 말씀하시지 않으셨나요 ? 지금 와서 생각이 바뀌신 이유가 뭐죠 ?",shape=box,color=blue];
		j1765812419 -> j3660841512;
		j1765812419 -> j1299046569;
		j1765812419 -> j619391684;
		j1765812419 -> j2469954477;
	j479639961 [label="Merci, 당신은 이 성전에서 제 든든한 동반자세요 ! 이런 마음을 가지는 건 우리 뿐인가 봐요 - Monsieur 로이드조차도 그런 원망을 품고 계시니까요...",shape=box,color=blue];
		j479639961 -> j4083095611;
	j1654906341 [label="Merci, 그 말을 들어서 제가 얼마나 기쁜지 모르실 거에요 ! 이런 마음을 가지는 건 우리 뿐인가 봐요 - Monsieur 로이드조차도 그런 원망을 품고 계시니까요...",shape=box,color=blue];
		j1654906341 -> j4083095611;
	j1635480819 [label="내 생각엔 다른 사람들이 당신에게 무엇을 요구하느냐가 아니라 당신이 다른 사람들에게 무엇을 요구하느냐가 더 중요한 것 같은데, 아니면 엔트라티에게 말이야.",shape=box,color=red];
		j1635480819 -> j3463412639;
	j3395099572 [label="그리고 그 점이 당신한테는 문제가 안된다고?",shape=box,color=red];
		j3395099572 -> j2159116448;
	j3463412639 [label="그리고 제가 다른 이들에게 터무니없는 것을 요구하는 게 달리 또 뭐가 있나요 ? 그들의 마음에 용서를 받아들이라는 거요?",shape=box,color=blue];
		j3463412639 -> j100113828;
		j3463412639 -> j3813253356;
	j2403257895 [label="고귀하지만, 성가시기도 한데다, 시공간을 여행하면서 자신의 mécontents을 돕는다는 거죠, non ? 당신은 분명 이 일로 그분에 대해 분함을 표하시겠죠...",shape=box,color=blue];
		j2403257895 -> j3530186236;
		j2403257895 -> j2135317430;
	j3421499955 [label="이 대화 자체가 실수였어요...",shape=box,color=blue];
		j3421499955 -> j3866429496;
		j3421499955 -> j2161771331;
	j3660841512 [label="솔직히 이 주제를 당신과 함께 풀어나가는 데 정말 애를 많이 먹었어. 정말이지 너무 고통스러웠어. 개인적으로 그 인간은... 선하지도 악하다고 생각치 않아. 그냥 둘 다 혼재된 존재라고 생각할 뿐이야.",shape=box,color=red];
		j3660841512 -> j3511506200;
	j1299046569 [label="마음을 바꿨어. 난 엔트라티 편이야. 그리고 당신 편이기도 하고. 당신이 날 설득했거든.",shape=box,color=red];
		j1299046569 -> j3254408036;
	j619391684 [label="[마음을 고백한다.] 난 그저... 당신 편에 서려고 최선을 다해 노력했을 뿐이야. 당신을 좋아하니까. 내가 표현한 것보다 훨씬 더 많이.",shape=box,color=red];
		j619391684 -> j3595569264;
	j2469954477 [label="마음을 바꿨고 그 인간이 괴물이라고 결정했어. 완전히 말이야.",shape=box,color=red];
		j2469954477 -> j1380850067;
