	173 [label="Update boolean MarieSecretPower",color=orange];
		173 -> 179;
	174 [label="Ce qui est fait est fait. 제 주변엔 더 많은 이들이 고통받고 있으며, 더 많은 이들이 더 큰 도움을 필요로 하는 상황 속에, 솔께 기적을 기도드릴 수 없었어요. 광휘의 성체들도 이미 많은 것들을 내주셨구요.",shape=box,color=blue];
		174 -> 180;
