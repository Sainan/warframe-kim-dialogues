digraph {
	77 [label="MarieRank1Convo3 begins.",color=orange];
		77 -> 78;
	78 [label="Il y a un crâne volant ! Keksekça ?! 날아다니는 해골이 있는데, 다들 아무 일도 없다는 듯이 하루하루를 보내고 있어요. 누군가는 저 존재들이 얼마나 이상한지 눈치채 줬으면 하는데 말이죠.",shape=box,color=blue];
		78 -> 79;
		78 -> 81;
		78 -> 80;
	79 [label="그냥 네크랄로이드야. 아니, 네크랄로이드는 한 명으로 쳐야 하나? 복잡하네.",shape=box,color=red];
		79 -> 82;
	81 [label="저건 네크랄로이드야. 세팔론이고, 당신을 해치지 않을 거야.",shape=box,color=red];
		81 -> 84;
	80 [label="[종료.]",shape=box,color=red];
		80 -> 83;
	82 [label="실례할게요. 이름이 있는 존재인가요 아니면 물체인가요 ?",shape=box,color=blue];
		82 -> 85;
		82 -> 86;
	84 [label="그를 위협적인 존재라고 여기지 않았어요 ! 절 두렵게 만들지도 않는 걸요.",shape=box,color=blue];
		84 -> 87;
	83 [label="Chat ends.",color=orange];
	85 [label="잘... 모르겠네.",shape=box,color=red];
		85 -> 88;
	86 [label="응.",shape=box,color=red];
		86 -> 89;
	87 [label="사실, 아주 매력적인 존재라고 생각해요. 다만 대화 중에 고집이 센 편일 뿐. 그의 살아있으면서 영감을 주는 존재하고도 전혀 다르고요. 하지만 제가 가장 아끼는 여행 동반자의 성격을 고려하면, 그 점이 크게 거슬리지 않다는 걸 알 수 있죠.",shape=box,color=blue];
		87 -> 90;
	88 [label="첫번째로, 이 \"네크랄로이드\"는 누구의 설계대로 제작되었나요 ? 이건 이름이기도 할테고, 아마도 명칭이기도 하겠죠 ?",shape=box,color=blue];
		88 -> 91;
		88 -> 92;
	89 [label="어... 이해가 안되네요. 그리고 여기 있는 로이드에게 어떤 영향을 끼치죠 ?",shape=box,color=blue];
		89 -> 88;
	90 [label="당신이 그의 얼굴에서 흉측함을 느끼는 건, 제가 지금 다루고 있는 문제가 아니라는 건 확실해요.",shape=box,color=blue];
		90 -> 93;
		90 -> 94;
	91 [label="당신의 Cardinal Dimanche. 엔트라티야.",shape=box,color=red];
		91 -> 95;
	92 [label="엔트라티가 만들었어. 하지만 세팔론이라는 개념 자체는 오로킨이 발명해낸 거야.",shape=box,color=red];
		92 -> 95;
	93 [label="그 해골 친구가 당신에게 반감을 주지 않았다는 게 놀랍네.",shape=box,color=red];
		93 -> 96;
	94 [label="문맥에서 벗어나서, 이상하다는 거 인정할게. 근데 구체적으로 어느 부분이 화나게 만드는 거야?",shape=box,color=red];
		94 -> 97;
	95 [label="Excusez-moi, le Cardinal이 자신의 동반자의 복제를 만들어서 날아다니는 해골 하인으로 제작한 다음, 그런 식으로 이름을 지어줬다는 말인가요 ?",shape=box,color=blue];
		95 -> 98;
	96 [label="저에 대해서 아는 점이 적은 건, 당신 탓이 아니에요. 전 평생 죽은 이들과 그들이 안식하는 곳을 돌보는 데 많은 시간을 보냈습니다. ",shape=box,color=blue];
		96 -> 99;
	97 [label="네크랄로이드의 뒷면에 어린 아이가 낙서한 듯한 얼굴이 있는 이유가 궁금해요.",shape=box,color=blue];
		97 -> 100;
	98 [label="그렇다면, 왜 이런 네크랄로이드가 더 많지 않은 건가요 ?",shape=box,color=blue];
		98 -> 101;
		98 -> 102;
		98 -> 103;
	99 [label="사실 제 인생의 많은 부분을 그들의 소중한 동반자로서 지냈습니다. 그들은 제가 매일 겪는 고민에 귀 기울이고 싶어 했으니까요.",shape=box,color=blue];
		99 -> 104;
	100 [label="Monsieur 네크랄로이드와 Monsieur 로이드 두 분 모두에게 물어보려 했지만, 둘 다 말하고 싶어하지 않았고, 그저 이름만 말해주었습니다. 오탁. 그리고 둘 다 매우 슬픈 어조로 말해줬어요.",shape=box,color=blue];
		100 -> 105;
	101 [label="아마 연인의 디지털 사본을 만드는 게 얼마나 무서운 일인지 깨달은 거겠지.",shape=box,color=red];
		101 -> 106;
	102 [label="어쩌면 그 인간은 오직 한 사람만을 만들려고 했을지도.",shape=box,color=red];
		102 -> 107;
	103 [label="잘 모르겠네. 아마 더 만들 시간이 없었던 거 아닐까?",shape=box,color=red];
		103 -> 108;
	104 [label="Update boolean MarieGraveyard1",color=orange];
		104 -> 109;
		104 -> 110;
	105 [label="그래서 여기서 당신과 대화를 나누고 있는 거에요. 절 도와주실 수 있기를 바라는 마음에서요.",shape=box,color=blue];
		105 -> 111;
		105 -> 112;
	106 [label="Ou bien, 이 이상한 실험실이 Monsieur 로이드 없이는 계속 운영될 수 없다는 점에서의, 자신이 가지고 있는 사랑과 존경을 담은 헌사였을 수도요.",shape=box,color=blue];
		106 -> 113;
		106 -> 114;
	107 [label="+5 Chemistry",color=orange];
		107 -> 115;
	108 [label="상상해 보세요. 날아다니는 해골 무리들, 모두 힘들일 필요 없이 완벽하게 효율적으로 움직이는 모습을요 !",shape=box,color=blue];
		108 -> 114;
		108 -> 116;
	109 [label="묘지 돌보는 일을 좋아했어?",shape=box,color=red];
		109 -> 117;
	110 [label="죽은 이들이 답해줬어?",shape=box,color=red];
		110 -> 118;
	111 [label="오탁에 대해서 알고 싶어? 아니면 왜 오탁이랑 대화를 못 하는지 알고 싶은거야?",shape=box,color=red];
		111 -> 119;
	112 [label="오탁은 설명해주기 좀 어려워...",shape=box,color=red];
		112 -> 2918;
	113 [label="이상한 종류의 낭만적인 제스처라고 말하고 싶지만, 난 이 점에 대해서 말할 수 있는 사람이 아니야.",shape=box,color=red];
		113 -> 122;
	114 [label="솔직히 말해자면, 내가 있는 곳 주변에 네크랄로이드가 돌아다니는 거 나쁘지 않을 것 같아.",shape=box,color=red];
		114 -> 123;
	115 [label="어떤 의미에선, 비극적이고도 아름답지요, non ? 이 이상한 실험실이 Monsieur 로이드 없이는 계속 운영될 수 없다는 점에서의, 자신이 가지고 있는 사랑과 존경을 담은 헌사였을 수도요.",shape=box,color=blue];
		115 -> 124;
		115 -> 113;
	116 [label="솔직히 말하자면, 저 존재가 하나 뿐이여서 다행이라고 생각해. 세상이 저 존재들을 받아들일 준비가 안 됐을 수도.",shape=box,color=red];
		116 -> 125;
	117 [label="오, 네. 영묘와 지하 무덤 돌보는 것도 좋아했죠. 의자 움직이는 게 힘든 것도 있지만, 야외 공간을 더 좋아해요. 계단으로 이동하는 것보다 더 힘들지도 않고요.",shape=box,color=blue];
		117 -> 126;
	118 [label="하 ! 다행스럽게도, 아니요. 음침한 표정을 한 당신의 \"네크랄로이드\"가 제게 대답하기 전까지는요. 죽은 자와 대화하는 것은 광휘의 성체들이 내려주는 은총의 영역이라, 제가 알 수 있는 부분은 아니에요.",shape=box,color=blue];
		118 -> 127;
	119 [label="시간이 어느정도 흐른 뒤에, 둘 다 알고 싶지만, 어디서부터 시작해야 할지는 당신께 맡길래요. 어느쪽이 더 중요한지도 잘 모르겠고요, après tout.",shape=box,color=blue];
		119 -> 2918;
	2918 [label="Check boolean LoidFamilyComplete",color=orange];
		2918 -> 121 [label=true,color=green];
		2918 -> 121 [label=false,color=brown];
		2918 -> 120 [label=false,color=brown];
	122 [label="궁금해지만, 그건 다음에 나눠야 할 이야기인 것 같아요. Cela dit...",shape=box,color=blue];
		122 -> 97;
	123 [label="그렇다면 아마 사업체, 조직 혹은 양쪽 모두에게 필요하다고 시달렸을 거라 확신이 들어요. 하지만 이 이야기는 다음에 하기로 해요.",shape=box,color=blue];
		123 -> 97;
	124 [label="내 생각엔 이 장소가 무너지지 않게 유지하는 게 무엇보다도 중요한 게 아니었을까 생각해.",shape=box,color=red];
		124 -> 130;
	125 [label="물론이에요 ! 저도 그렇고요. 이제 다음 질문으로 넘어갈게요.",shape=box,color=blue];
		125 -> 97;
	126 [label="Update boolean MarieSerum1",color=orange];
		126 -> 131;
		126 -> 132;
	127 [label="그리고 아니요, 영혼과 목소리를 듣는 건 저보다 제 소중한 리온이 훨씬 더 잘 아는 분야입니다. 하지만 머리 뒷면에 아이가 해놓은 듯한 낙서를 보니, Monsieur 네크랄로이드도 영혼들에 시달리고 있지 않은지 궁금해지네요.",shape=box,color=blue];
		127 -> 133;
	121 [label="오탁은 한때 오로킨의 과학자이자 학자인 아르키메디안이었어. 그에게 일어난 일은 결코 행복한 이야기가 아니야.",shape=box,color=red];
		121 -> 129;
	120 [label="뭐... 짧게 말하자면, 엔트라티 가족 중 몇몇은 위층에 살고 있는데, 그 사람들은 우리가 여기 아래 있다는 걸 정확히는 몰라.",shape=box,color=red];
		120 -> 128;
	130 [label="그리고 당신 말이 맞을지도 몰라요. 날아다니는 아말감은 진짜 Monsieur 로이드의 raison d'être와 nuance를 많이 놓치고 있는 것 같아요. Cela dit...",shape=box,color=blue];
		130 -> 97;
	131 [label="혈청을 바르고 발이 바뀌었는지 묻는 게 적절한지 모르겠어...",shape=box,color=red];
		131 -> 136;
	132 [label="당신 의자?",shape=box,color=red];
		132 -> 137;
	133 [label="사실, 제가 여기 온 이유는 당신과 이야기를 나누기 위해서였어요. 대화를 나누는 게 괜찮으시다면요.",shape=box,color=blue];
		133 -> 100;
	129 [label="Update boolean MarieOtak1",color=orange];
		129 -> 135;
	128 [label="Update boolean MarieFamily1",color=orange];
		128 -> 134;
	136 [label="+10 Chemistry",color=orange];
		136 -> 140;
	137 [label="당신은 이걸 뭐라고 부를지 잘 모르겠네요 ? Un fauteuil roulant, 아니면... 제가 정말 싫어하는 표현이지만, un fauteuil pour invalide이요.",shape=box,color=blue];
		137 -> 141;
	135 [label="Par les Luminaires... 계속해 주세요.",shape=box,color=blue];
		135 -> 139;
	134 [label="Par les Luminaires... 우리 모두가 비밀리에 여기 있다는 말인가요 ?! 그래서 우리가 여길 떠날 수 없는 건가요 ?! Mais pourquoi ?!",shape=box,color=blue];
		134 -> 138;
	140 [label="오 ! 오, 착하고 가여운 사람 같으니. 거기 앉아서, le Cardinal에 의해 제 mes pieds가 뺏긴 건 아닌가하고 상상하고 있었군요 ! Non, non, non - 그런 건 전혀 아니에요.",shape=box,color=blue];
		140 -> 144;
	141 [label="지금 우리가 앉아 있는 것처럼, 이 작고 귀여운 장치들 앞에 앉아 소통하는 거죠. 하지만 측면에 바퀴가 달려 있어서 자유롭게 이동할 수 있어요. 바퀴 달린 의자에요.",shape=box,color=blue];
		141 -> 145;
		141 -> 146;
	139 [label="모든 기록에 따르면 그는 천재였고, 아르곤 크리스탈을 이용한 기술의 선두주자였어.",shape=box,color=red];
		139 -> 143;
	138 [label="알브레히트의 딸, 오일러리아 - 어머니라고 알려진 존재와 그녀의 가족들이 이제까지 데이모스를 관리하고 있었어.",shape=box,color=red];
		138 -> 142;
	144 [label="솔께선 본래 다루기 힘든 발을 가지고 태어나는 불편함을 제 삶에 안겨주시기로 결정하셨습니다. 전 걸을 수 없었서요. ",shape=box,color=blue];
		144 -> 149;
	145 [label="프로토프레임이 되기 전에 장애가 있었어?",shape=box,color=red];
		145 -> 150;
	146 [label="우린 그걸 휠체어라고 불러, 믿기 어렵겠지만.",shape=box,color=red];
		146 -> 151;
	143 [label="이는 보이드를 다룰 수 있는 힘이었고 - 오로킨이 강력한 워프레임들과 무기류를 제작할 수 있는 이유였어.",shape=box,color=red];
		143 -> 148;
	142 [label="이 곳과 보이드 에너지를 근원계로 펌핑해내는 심장을 지켜보고, 우리 모두에게... 실제로, 알브레히트 엔트라티가 떠난 이후로도 이 힘을 계속 사용할 수 있게 해줬어.",shape=box,color=red];
		142 -> 861;
	149 [label="하지만 그건 단지 불편함일 뿐이었어요.",shape=box,color=blue];
		149 -> 155;
	150 [label="Non. 그렇지 않았습니다.",shape=box,color=blue];
		150 -> 156;
	151 [label="하 ! 오, 제가 바보였다는 생각에 여기 앉아서 웃음이 터져 나와버렸어요. 맞아요, 바퀴 달린 의자니까 휠체어라고 부르겠죠. 이런 바보 같으니.",shape=box,color=blue];
		151 -> 155;
	148 [label="오탁은 결정학을 전문분야로 삼았어. 그의 연구물들이 여기 실험실에 보관되어 있지.",shape=box,color=red];
		148 -> 154;
	861 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		861 -> 152 [label=true,color=green];
		861 -> 153 [label=false,color=brown];
	155 [label="하지만, 스스로를 움직여야 했던 점이 그리워지지는 않네요. 리온도 마찬가지일 것 같아요. 날아다닐 수 있다는 게 얼마나 자유로운지 !",shape=box,color=blue];
		155 -> 160;
		155 -> 161;
		155 -> 162;
	156 [label="Update boolean MarieInvalid",color=orange];
		156 -> 163;
	154 [label="어떤 이유에서인지, 왜인지 나도 모르겠지만, 세팔론으로 바뀌었고, 자신만의 네크랄로이드 껍데기를 갖게 되었어.",shape=box,color=red];
		154 -> 159;
	152 [label="그녀는 알브레히트의 부재를 받아들였고, 가족들과 화해했지만, 그건 힘든 일이었어.",shape=box,color=red];
		152 -> 157;
	153 [label="그녀는 알브레히트의 부재를 받아들이지 못했고, 가족들은 서로의 목을 조르고 있는 형국이었어.",shape=box,color=red];
		153 -> 158;
	160 [label="난 장애라는 게 우리를 변화시키는 요소라고 생각하려 해. 어떤 면에서는 우리를 제한하는 것도 사실이지만, 다른 사람들이 갖지 못하는 강점을 줄 수도 있으니까.",shape=box,color=red];
		160 -> 167;
	161 [label="스스로의 상태를 문제라고 생각해 본 적 없어?",shape=box,color=red];
		161 -> 168;
	162 [label="프로토프레임 혈청이 이런 효과를 낼 수 있다는 걸 알고 있었어?",shape=box,color=red];
		162 -> 169;
	163 [label="Chat ends.",color=orange];
	159 [label="모든 세팔론들이 처벌의 형태로서 만들어진 건 아니였어. 하지만 데이모스에서는 일이... 제대로 진행되지 않았고, 심한 부상을 입었어.",shape=box,color=red];
		159 -> 166;
	157 [label="자신의 아버지가 밖에 나돌아다니고, 사고란 사고 다 치고 다니고, 딸한테는 말 한마디 없이, 편지 한통조차 보내지 않았다는 걸 알면서도...?",shape=box,color=red];
		157 -> 164;
	158 [label="자신의 아버지가 밖에 나돌아다니고, 사고란 사고 다 치고 다니고, 딸한테는 말 한마디 없이, 편지 한통조차 보내지 않았다는 걸 알면서도...?",shape=box,color=red];
		158 -> 165;
	167 [label="+5 Chemistry",color=orange];
		167 -> 173;
