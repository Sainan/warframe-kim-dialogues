		1932 -> 1935;
	1933 [label="Chat ends.",color=orange];
	1936 [label="Monsieur 로이드가 \"원본\"이라고 인정하셨지만, Monsieur 네크랄로이드께서 그게 \"자신\"의 해골이라 말씀하셨어요. Monsieur 로이드께서 끼어드셔서 그게 자신의 해골을 \"복제\"한 거라 말씀하셨구요.",shape=box,color=blue];
		1936 -> 1938;
	1935 [label="Monsieur 네크랄로이드와 Monsieur 로이드 두 분 모두에게 물어보려 했지만, 둘 다 말하고 싶어하지 않았고, 그저 이름만 말해주었습니다. 오탁. 그리고 둘 다 매우 슬픈 어조로 말해줬어요.",shape=box,color=blue];
		1935 -> 1937;
	1938 [label="어떻게 이런 일이 가능한 거죠 ? 그리고 \"복제\"는 뭘 의미하는 건가요 ? 진짜 해골인가요, ou bien c'est un faux ? Monsieur 네크랄로이드와 Monsieur 로이드는 왜 다른 답을 하셨죠 ?",shape=box,color=blue];
		1938 -> 1940;
		1938 -> 1941;
		1938 -> 1942;
	1937 [label="그래서 여기서 당신과 대화를 나누고 있는 거에요. 절 도와주실 수 있기를 바라는 마음에서요.",shape=box,color=blue];
		1937 -> 1939;
	1940 [label="네크랄로이드의 관점에서는 그의 두개골일 거라 생각해. 그게 맞아. 하지만 로이드의 관점에선 복제품이지.",shape=box,color=red];
		1940 -> 1944;
	1941 [label="솔직히 뭘로 제작되었는지는 모르겠어. 뼈일 수도 있고, 아니면 폴리머일 수도 있고...",shape=box,color=red];
		1941 -> 1945;
	1942 [label="당신이 고민하고 있는 질문의 핵심은 \"네크랄로이드는 실존하는가?\"에 대한거지, \"그 해골 진짜인가?\"가 아닌 것 같아.",shape=box,color=red];
		1942 -> 1946;
	1939 [label="불쌍한 Monsieur 오탁에 대해서 알려주시겠어요 ?",shape=box,color=blue];
		1939 -> 1943;
	1944 [label="그 점이 절 불안하게 만들어요. 두 신사분이 근원을 생각하는 방식 때문에요. 한 분은 그걸 sacro-saint라 생각하고, 다른 분은 copie라고 여기시니까요.",shape=box,color=blue];
		1944 -> 1948;
	1945 [label="그 해골이 뭘로 만들어졌는지가 그리 걱정되는 지는 잘 모르겠어요. 그 해골의 근원이 궁금하니까요. 아니면 두 신사분이 그 근원을 어찌 생각하시는지가 궁금하겠네요. 한 분은 그걸 sacro-saint라 생각하고, 다른 분은 copie라고 여기시니까요.",shape=box,color=blue];
		1945 -> 1948;
	1946 [label="+5 Chemistry",color=orange];
