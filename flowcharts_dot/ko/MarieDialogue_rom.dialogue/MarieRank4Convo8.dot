	j3384971676 [label="Boolean MarieCephalonUnsure is now false.",color=orange];
		j3384971676 -> j3656876278;
	j1540206979 [label="악마와 그 동족들이 죄 받아 마땅하다는 게 옳았다는 또 다른 증거네요. 그러나 어쩌면 오탁과 그의 동족들에 대한 당신의 생각이 맞을지도 모르고요. 어쩌면 그렇게 믿는 게 당신께 평화를 가져다줄지도 모르죠.",shape=box,color=blue];
		j1540206979 -> j735260278;
	j735260278 [label="그리고 결국 제가 틀릴 수도 있죠. 친절과 존중을 보이는 건 결코 해가 되는 행동이 아니에요.",shape=box,color=blue];
		j735260278 -> j4117068469;
