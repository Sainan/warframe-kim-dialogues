		1557 -> 1562;
		1557 -> 1563;
		1557 -> 1564;
	1559 [label="Monsieur 네크랄로이드께서 영혼을 가질 수 있는지 확신하지 못하시는 건 알지만, 전 자신의 뼈조차 가지지 못하는 분이 어떻게 영혼을 가질 수 있으시는지 모르겠어요.",shape=box,color=blue];
