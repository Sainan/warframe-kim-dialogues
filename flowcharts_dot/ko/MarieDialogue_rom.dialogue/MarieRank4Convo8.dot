	1556 [label="이는 보이드를 다룰 수 있는 힘이었고 - 오로킨이 강력한 워프레임들과 무기류를 제작할 수 있는 이유였어.",shape=box,color=red];
		1556 -> 1561;
	1562 [label="당신 말이 맞을지도. 어쩌면 그들은 그저 사람들의 복제품일지도. 하지만 그들이 사람인지도 잘 모르겠으니, 일단은 사람처럼 대해야 해.",shape=box,color=red];
		1562 -> 1571;
	1563 [label="네크랄로이드는 예외일 뿐, 일반적인 기준은 아니라고 생각해. 그는 사람의 복제품으로 만들어졌을 뿐, 사람으로 제작된 게 아니니까.",shape=box,color=red];
		1563 -> 1572;
	1564 [label="당신 말이 맞아. 정교한 과학 안에 갇힌 영혼이 아니라면 아마 더 낫고, 더 인간적일 거야...",shape=box,color=red];
		1564 -> 1573;
	1565 [label="네크랄로이드에게 영혼이 없을지 몰라도, 특별한 존재야. 오탁처럼 다른 세팔론들도 그렇고. 그들이 세팔론으로 만들어질 때 파괴되었지만.",shape=box,color=red];
		1565 -> 1574;
	1566 [label="당신 말이 맞아. 그래서 나보고 어찌 해줬음 하는데?",shape=box,color=red];
		1566 -> 1575;
	1567 [label="당신 말이 맞아. 영혼을 가지고 있지않아. 그렇다고 해서 우리가 함부로 대할 수는 없지.",shape=box,color=red];
		1567 -> 1576;
	1568 [label="당신 말이 맞는지 틀린지는 모르지만서도. 그들은 여전히 생각하고 느낄 수 있다고. 물건처럼 대할 수 없어.",shape=box,color=red];
		1568 -> 1577;
