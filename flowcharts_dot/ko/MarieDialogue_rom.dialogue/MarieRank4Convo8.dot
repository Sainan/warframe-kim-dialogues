	j3656876278 [label="+5 Chemistry",color=orange];
		j3656876278 -> j3073761258;
	j4117068469 [label="어쨌거나, Monsieur 네크랄로이드를 위해 다시 꽃으로 화관을 만들어야겠어요. 불평하시지만, non 이라고 하진 않으실테니까요 !",shape=box,color=blue];
