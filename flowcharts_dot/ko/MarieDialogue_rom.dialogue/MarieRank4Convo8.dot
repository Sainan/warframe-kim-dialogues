		1596 -> 2945;
	1603 [label="Oui, 정말 현명한 말씀입니다. 전 그저 속으로 생각하면서 당신에게 있어서 그들이 어떤 존재인지 궁금했을 뿐이에요. 당신 말이 맞아요. 친절과 존중을 보이는 건 결코 해가 되는 행동이 아니에요.",shape=box,color=blue];
		1603 -> 1610;
	1604 [label="어쩌면 당신이 맞을지도요. 그리고 그러길 바래요 ! 어떤 경우든, 우리는 친절해야 해요 - 왜냐하면 그들은 사고를 하는 존재들이니까요. 무엇을 생각하고, 무엇을 느끼더라도요.",shape=box,color=blue];
