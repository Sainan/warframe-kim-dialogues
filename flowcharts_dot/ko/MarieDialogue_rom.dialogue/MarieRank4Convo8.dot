	j55008371 [label="Merci, 그럴게요 ! À la revoyure !",shape=box,color=blue];
		j55008371 -> "Chat ends.";
	j2979299112 [label="Oui. 하지만 그분의 침묵이 절 고민에 빠지게 하는 건 아니에요. Monsieur 네크랄로이드께 몸체에 있는 해골이 한때 살아있는 영혼에 속한 것인지 아닌지에 대해 여쭤봤어요.",shape=box,color=blue];
		j2979299112 -> j19474023;
	j560978056 [label="죽은 자를 위한 전통적인 지하 납골당에선 육신을 노출시키는 경우가 많잖아요, oui ? 그래서 이렇게 하는 게 가능해요. 이러한 관습이 남아 있는 것 같아요, 아직도요.",shape=box,color=blue];
		j560978056 -> j650126628;
	j650126628 [label="오로킨의 일부 예술 작품에서 그들이 해골에 가지고 있는 사랑을 볼 수 있었어요. ",shape=box,color=blue];
		j650126628 -> j2870273468;
		j650126628 -> j2955410447;
		j650126628 -> j1479756684;
	j2870273468 [label="그걸로 많은 것들이 설명되는 것 같아.",shape=box,color=red];
		j2870273468 -> j1212014391;
	j2955410447 [label="많은 것들이 변하더라도, 본질은 여전하지. 응?",shape=box,color=red];
		j2955410447 -> j1212014391;
	j1479756684 [label="딸이 전에도 이런 시도를 한 적이 있을 것 같은데, 분명 질투할 거야.",shape=box,color=red];
		j1479756684 -> j464180647;
	j1212014391 [label="Oui ! 시간이 그렇게 많이 흘렀는데도 그 영향은 여전한 것 같아요. 아주 작은 조각이라도 남아 있다는 점에서 얼마나 행복한지 모르겠어요.",shape=box,color=blue];
		j1212014391 -> j3744931382;
	j464180647 [label="Oui ? 그럼 그분과의 만남을 고대할게요 ! 그분께 Monsieur 네크랄로이드를 인정사정없이 꾸며드렸다고 말씀드릴 거에요.",shape=box,color=blue];
		j464180647 -> j3744931382;
	j3744931382 [label="Faux 해골이든 아니든, Monsieur 네크랄로이드는 왕관을 쓰셔야 해요. 제가 너무 좋다고 표현하면 완전 부끄러워하시거든요 ! 하실 수만 있으셨다면, 얼굴을 붉히셨으리라 생각해요. 그리고 그 점이 절 웃게 만들고요.",shape=box,color=blue];
		j3744931382 -> j4101990552;
	j4101990552 [label="À la revoyure !",shape=box,color=blue];
		j4101990552 -> "Chat ends.";
}