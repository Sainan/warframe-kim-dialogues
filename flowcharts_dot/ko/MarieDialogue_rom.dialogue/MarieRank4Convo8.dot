	j108282503 [label="오 ! 루아의 권리를 나타내는 것 중 하나에요. 영혼이 세상을 떠난 날, 왕관이나 꽃을 엮어서 만든 화관으로 두개골 위나 무덤 위에 올려놔요. ",shape=box,color=blue];
