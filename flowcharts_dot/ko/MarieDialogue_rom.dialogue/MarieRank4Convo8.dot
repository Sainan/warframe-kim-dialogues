	1947 [label="모든 기록에 따르면 그는 천재였고, 아르곤 크리스탈을 이용한 기술의 선두주자였어.",shape=box,color=red];
		1947 -> 1556;
	1558 [label="Monsieur 네크랄로이드는 자신만의 뼈조차 가지지 못하는데, 어떻게 영혼을 가질 수 있나요 ?",shape=box,color=blue];
