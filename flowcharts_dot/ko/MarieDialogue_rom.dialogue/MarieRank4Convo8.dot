		j604089908 -> j735260278;
	j1618452169 [label="어쩌면 오탁과 그의 동족들에 대한 당신의 생각이 맞을지도 모르고요. 어쩌면 그렇게 믿는 게 당신께 평화를 가져다줄지도 모르죠.",shape=box,color=blue];
