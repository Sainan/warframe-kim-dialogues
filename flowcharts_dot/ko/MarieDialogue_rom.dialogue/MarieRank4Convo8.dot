digraph {
	"MarieRank4Convo8 begins." [color=orange];
		"MarieRank4Convo8 begins." -> j2786051379;
	j2786051379 [label="Check boolean MarieOtak1",color=orange];
		j2786051379 -> j3529721313 [label=true,color=green];
		j2786051379 -> j3359071274 [label=false,color=brown];
	j3529721313 [label="드리프터, 제가 Monsieur 네크랄로이드와 Monsieur 오탁에 대한 정보들을 더 많이 알수록 점점 더 불안한 생각이 들어요...",shape=box,color=blue];
		j3529721313 -> j2654597373;
		j3529721313 -> j687464508;
	j3359071274 [label="드리프터, 잠깐 얘기 좀 할 수 있을 까요 ?",shape=box,color=blue];
		j3359071274 -> j1892583691;
		j3359071274 -> j3039724897;
	j2654597373 [label="왜 그런데?",shape=box,color=red];
		j2654597373 -> j1708179881;
	j687464508 [label="구체적으로 어떤 문제가 있는데?",shape=box,color=red];
		j687464508 -> j1708179881;
	j1892583691 [label="물론이야. 무슨 일인데?",shape=box,color=red];
		j1892583691 -> j4135502695;
	j3039724897 [label="[종료.]",shape=box,color=red];
		j3039724897 -> "Chat ends.";
	j1708179881 [label="Monsieur 네크랄로이드께 몸체에 있는 해골이 한때 살아있는 영혼에 속한 것인지 아닌지에 대해 여쭤봤어요.",shape=box,color=blue];
		j1708179881 -> j19474023;
	j4135502695 [label="네크랄로이드의 뒷면에 어린 아이가 낙서한 듯한 얼굴이 있는 이유가 궁금해요.",shape=box,color=blue];
		j4135502695 -> j1167235264;
	"Chat ends." [color=orange];
	j19474023 [label="Monsieur 로이드가 \"원본\"이라고 인정하셨지만, Monsieur 네크랄로이드께서 그게 \"자신\"의 해골이라 말씀하셨어요. Monsieur 로이드께서 끼어드셔서 그게 자신의 해골을 \"복제\"한 거라 말씀하셨구요.",shape=box,color=blue];
		j19474023 -> j550270203;
	j1167235264 [label="Monsieur 네크랄로이드와 Monsieur 로이드 두 분 모두에게 물어보려 했지만, 둘 다 말하고 싶어하지 않았고, 그저 이름만 말해주었습니다. 오탁. 그리고 둘 다 매우 슬픈 어조로 말해줬어요.",shape=box,color=blue];
		j1167235264 -> j3218701340;
	j550270203 [label="어떻게 이런 일이 가능한 거죠 ? 그리고 \"복제\"는 뭘 의미하는 건가요 ? 진짜 해골인가요, ou bien c'est un faux ? Monsieur 네크랄로이드와 Monsieur 로이드는 왜 다른 답을 하셨죠 ?",shape=box,color=blue];
		j550270203 -> j2461103642;
		j550270203 -> j3203921629;
		j550270203 -> j2152600570;
	j3218701340 [label="그래서 여기서 당신과 대화를 나누고 있는 거에요. 절 도와주실 수 있기를 바라는 마음에서요.",shape=box,color=blue];
		j3218701340 -> j888137221;
	j2461103642 [label="네크랄로이드의 관점에서는 그의 두개골일 거라 생각해. 그게 맞아. 하지만 로이드의 관점에선 복제품이지.",shape=box,color=red];
		j2461103642 -> j191456843;
	j3203921629 [label="솔직히 뭘로 제작되었는지는 모르겠어. 뼈일 수도 있고, 아니면 폴리머일 수도 있고...",shape=box,color=red];
		j3203921629 -> j3185274792;
	j2152600570 [label="당신이 고민하고 있는 질문의 핵심은 \"네크랄로이드는 실존하는가?\"에 대한거지, \"그 해골 진짜인가?\"가 아닌 것 같아.",shape=box,color=red];
		j2152600570 -> j987762629;
	j888137221 [label="불쌍한 Monsieur 오탁에 대해서 알려주시겠어요 ?",shape=box,color=blue];
		j888137221 -> j249951031;
	j191456843 [label="그 점이 절 불안하게 만들어요. 두 신사분이 근원을 생각하는 방식 때문에요. 한 분은 그걸 sacro-saint라 생각하고, 다른 분은 copie라고 여기시니까요.",shape=box,color=blue];
		j191456843 -> j3408858168;
	j3185274792 [label="그 해골이 뭘로 만들어졌는지가 그리 걱정되는 지는 잘 모르겠어요. 그 해골의 근원이 궁금하니까요. 아니면 두 신사분이 그 근원을 어찌 생각하시는지가 궁금하겠네요. 한 분은 그걸 sacro-saint라 생각하고, 다른 분은 copie라고 여기시니까요.",shape=box,color=blue];
		j3185274792 -> j3408858168;
	j987762629 [label="+5 Chemistry",color=orange];
		j987762629 -> j3652573913;
	j249951031 [label="오탁은 한때 오로킨의 과학자이자 학자인 아르키메디안이었어. 그에게 일어난 일은 결코 행복한 이야기가 아니야.",shape=box,color=red];
		j249951031 -> j3618031910;
	j3408858168 [label="Evaluate expressions",color=orange];
		j3408858168 -> j1917922830 [label="MarieCephalonSoul",color=purple];
		j3408858168 -> j3171186841 [label="MarieCephalonNoSoul",color=purple];
		j3408858168 -> j1393290986 [label="MarieCephalonUnsure",color=purple];
		j3408858168 -> j3165113420 [label="false",color=purple];
	j3652573913 [label="Oui ! 맞아요, 그게 바로 질문의 심장이고 주체에요 - 아니면 해골에 해당하려나요 - 하. 한 분은 그걸 sacro-saint라 생각하고, 다른 분은 copie라고 여기시니까요.",shape=box,color=blue];
		j3652573913 -> j3408858168;
	j3618031910 [label="모든 기록에 따르면 그는 천재였고, 아르곤 크리스탈을 이용한 기술의 선두주자였어.",shape=box,color=red];
		j3618031910 -> j3547401656;
	j1917922830 [label="Monsieur 네크랄로이드는 자신만의 뼈조차 가지지 못하는데, 어떻게 영혼을 가질 수 있나요 ?",shape=box,color=blue];
		j1917922830 -> j269135133;
		j1917922830 -> j622622751;
		j1917922830 -> j495918980;
	j3171186841 [label="이 점이 Monsieur 네크랄로이드의 영혼이 없다는 증거인가요 ?",shape=box,color=blue];
		j3171186841 -> j269135133;
		j3171186841 -> j622622751;
		j3171186841 -> j495918980;
	j1393290986 [label="Monsieur 네크랄로이드께서 영혼을 가질 수 있는지 확신하지 못하시는 건 알지만, 전 자신의 뼈조차 가지지 못하는 분이 어떻게 영혼을 가질 수 있으시는지 모르겠어요.",shape=box,color=blue];
		j1393290986 -> j269135133;
		j1393290986 -> j622622751;
		j1393290986 -> j495918980;
	j3165113420 [label="제가 말씀드리고 있는 건 사람처럼 보이도록 만들어진 아주 정교한 기술에 대해서에요, 제가 틀렸나요? 훨씬 더 복잡한 phonographe 말이에요.",shape=box,color=blue];
		j3165113420 -> j3835656089;
		j3165113420 -> j28765847;
		j3165113420 -> j516119167;
		j3165113420 -> j590860138;
		j3165113420 -> j3077068554;
	j3547401656 [label="이는 보이드를 다룰 수 있는 힘이었고 - 오로킨이 강력한 워프레임들과 무기류를 제작할 수 있는 이유였어.",shape=box,color=red];
		j3547401656 -> j3068792075;
	j269135133 [label="당신 말이 맞을지도. 어쩌면 그들은 그저 사람들의 복제품일지도. 하지만 그들이 사람인지도 잘 모르겠으니, 일단은 사람처럼 대해야 해.",shape=box,color=red];
		j269135133 -> j50405075;
	j622622751 [label="네크랄로이드는 예외일 뿐, 일반적인 기준은 아니라고 생각해. 그는 사람의 복제품으로 만들어졌을 뿐, 사람으로 제작된 게 아니니까.",shape=box,color=red];
		j622622751 -> j1445316267;
	j495918980 [label="당신 말이 맞아. 정교한 과학 안에 갇힌 영혼이 아니라면 아마 더 낫고, 더 인간적일 거야...",shape=box,color=red];
		j495918980 -> j3785572320;
	j3835656089 [label="네크랄로이드에게 영혼이 없을지 몰라도, 특별한 존재야. 오탁처럼 다른 세팔론들도 그렇고. 그들이 세팔론으로 만들어질 때 파괴되었지만.",shape=box,color=red];
		j3835656089 -> j1462448708;
	j28765847 [label="당신 말이 맞아. 그래서 나보고 어찌 해줬음 하는데?",shape=box,color=red];
		j28765847 -> j4140793936;
	j516119167 [label="당신 말이 맞아. 영혼을 가지고 있지않아. 그렇다고 해서 우리가 함부로 대할 수는 없지.",shape=box,color=red];
		j516119167 -> j486681725;
	j590860138 [label="당신 말이 맞는지 틀린지는 모르지만서도. 그들은 여전히 생각하고 느낄 수 있다고. 물건처럼 대할 수 없어.",shape=box,color=red];
		j590860138 -> j251221385;
	j3077068554 [label="네크랄로이드는 영혼을 가지고 있어. 모든 세팔론들도 그렇고.",shape=box,color=red];
		j3077068554 -> j494612907;
	j3068792075 [label="오탁은 결정학을 전문분야로 삼았어. 그의 연구물들이 여기 실험실에 보관되어 있지.",shape=box,color=red];
		j3068792075 -> j3894819117;
