	j56571445 [label="Bonjour ! 정말 바보같은 일이 있었어요.",shape=box,color=blue];
		j56571445 -> j1439703282;
		j56571445 -> j3039724897;
	j1439703282 [label="오? 무슨 일인데?",shape=box,color=red];
		j1439703282 -> j1890003007;
	j3039724897 [label="[종료.]",shape=box,color=red];
		j3039724897 -> "Chat ends.";
	j1890003007 [label="M'sieur 새 Trois호께 생일인지 언제인지 질문드렸더니, 잘 모르겠다고 하시더군요 ! 정말로 슬퍼요 !",shape=box,color=blue];
		j1890003007 -> j1626950542;
	"Chat ends." [color=orange];
	j1626950542 [label="카비아는 누구도 자신의 생일을 몰라요. 그들이 우리처럼 언어를 표현하거나 calendrier을 알아볼 수 없는 상태로 태어났다는 점을 고려하면 당연한 일일지도요.",shape=box,color=blue];
		j1626950542 -> j2021686435;
	j2021686435 [label="그래서 생각했어요, 이 무슨 tragédie인지 ! 당장 이걸 바로 잡아야 해요, non ?",shape=box,color=blue];
		j2021686435 -> j248707915;
		j2021686435 -> j3780278217;
		j2021686435 -> j906188446;
	j248707915 [label="그런 생각은 해보지도 못했는걸.",shape=box,color=red];
		j248707915 -> j487283115;
	j3780278217 [label="카비아들이 언제 태어났는지 어떻게 알 수 있는데?",shape=box,color=red];
		j3780278217 -> j974676049;
	j906188446 [label="카비아들이 직접 생일 날짜를 고르게 할 거야?",shape=box,color=red];
		j906188446 -> j638704916;
	j487283115 [label="Oui ! Monsieur 로이드도 마찬가지셨어요. 제가 이 사실을 알았을 때 그 분의 표정은 엄청난 슬픔으로 가득차셨습니다...",shape=box,color=blue];
		j487283115 -> j1954487052;
	j974676049 [label="처음엔 le Cardinal의 기록을 확인해보려는 생각이었어요 - 아마도 그분께선 카비아가 언제 태어났는지 기록해두셨을 거에요, oui ?",shape=box,color=blue];
		j974676049 -> j2402114516;
	j638704916 [label="\"할꺼냐고요 ?\" 마치 제가 결정해버린 듯이 말씀하시네요 ! ",shape=box,color=blue];
		j638704916 -> j974676049;
	j1954487052 [label="그분께서는 그 점을 먼저 생각하지 못한 게 자기 잘못이라고 여기시는 게 너무 가슴 아파요. Monsieur 로이드의 잘못이 아니에요. 많은 이들을 위해 정말 많은 일들을 하고 계시니까요...",shape=box,color=blue];
		j1954487052 -> j2017545641;
	j2402114516 [label="Evaluate expressions",color=orange];
		j2402114516 -> j961880472 [label="MarieEntratiComplete",color=purple];
		j2402114516 -> j961880472 [label="MarieEntrati3a",color=purple];
		j2402114516 -> j1567413562 [label="false",color=purple];
	j2017545641 [label="우리 모두는 Monsieur 로이드의 상냥함을 알게 되어 축복받았지요. 그분께서 끌어올리는 샘의 깊이는 끝이 없습니다.",shape=box,color=blue];
		j2017545641 -> j920877004;
		j2017545641 -> j2493608240;
	j961880472 [label="하지만 그때 저는 M'sieur 태그퍼와 다른 이들과 나눈 대화를 떠올렸고, 그렇게 하는 게... 그리 현명한 일은 아닐 수도 있겠다는 생각이 들었어요.",shape=box,color=blue];
		j961880472 -> j3583764511;
	j1567413562 [label="하지만 카비아들은 과거의 기록을 찾는 데 관심이 없어 보였어요. 자신의 근원을 생각하는 게 얼마나 고통스러운지 잘 아니까요.",shape=box,color=blue];
		j1567413562 -> j3583764511;
	j920877004 [label="로이드가 여기 있어서 우린 정말 운이 좋아.",shape=box,color=red];
		j920877004 -> j735392473;
	j2493608240 [label="로이드가 가끔씩은 기분이 나아지길 바랄 뿐이야.",shape=box,color=red];
		j2493608240 -> j840337661;
	j3583764511 [label="결국, 저조차도 제 생일을 모르니까요. ",shape=box,color=blue];
		j3583764511 -> j1192732340;
		j3583764511 -> j4135878676;
		j3583764511 -> j633854056;
	j735392473 [label="Oui, 정말로요. 우리 모두가 그렇죠.",shape=box,color=blue];
		j735392473 -> j3542593548;
	j840337661 [label="그분은 진지한 성격을 가지고 계시지만, 미소 지으시는 모습을 본 적 있어요. 예상치 못한 순간에 유머가 드러나죠. 그저 인내심을 가져야 해요.",shape=box,color=blue];
		j840337661 -> j3542593548;
	j1192732340 [label="기분 좀 나아지게 말하자면, 나도 기억 안나. 그 꼬마도 생일은 기억 못할 것 같아.",shape=box,color=red];
		j1192732340 -> j2072001679;
	j4135878676 [label="생일이란 것 자체가 과대평가되었어.",shape=box,color=red];
		j4135878676 -> j1732432867;
	j633854056 [label="어차피 직접 고르는 게 더 재밌어. 더 Poignant하기도 하고. ",shape=box,color=red];
		j633854056 -> j3078991776;
	j3542593548 [label="Check boolean MarieDating",color=orange];
		j3542593548 -> j2547998187 [label=true,color=green];
		j3542593548 -> j2028671597 [label=false,color=brown];
	j2072001679 [label="당신과 당신의 minuscule copie를 때문에 훌쩍거릴 이유가 더 많아졌네요. 그래도 우리가 공유하는 것들이 더 많아졌어요 !",shape=box,color=blue];
		j2072001679 -> j3542593548;
	j1732432867 [label="전 그게 과대평가되었다고 전혀 생각치 않아요 ! 우리가 세상을 떠난 이들을 기리는 것처럼, 아직 우리와 함께하는 이들을 기려야 하니까요.",shape=box,color=blue];
		j1732432867 -> j3542593548;
	j3078991776 [label="Poignant ? 당신이 북쪽 골 언어를 사용하실 줄은 몰랐어요 ! 저와의 대화를 통해서 이해하시게 된건가요 ?",shape=box,color=blue];
		j3078991776 -> j827640893;
		j3078991776 -> j1985709011;
	j2547998187 [label="+20 Chemistry",color=orange];
		j2547998187 -> j4188658490;
	j2028671597 [label="+20 Chemistry",color=orange];
		j2028671597 -> j4000628257;
	j827640893 [label="내... 생각엔 두 언어에서 같이 쓰이는 단어라고 생각이 들어...",shape=box,color=red];
		j827640893 -> j2451556652;
	j1985709011 [label="당신에게서 배웠을 걸.",shape=box,color=red];
		j1985709011 -> j405065655;
	j4188658490 [label="자 ! 어서요, mon coeur ! 설령 아무 일도 일어나지 않더라도, 중요한 건 마음이니까요 ! Au calendrier !",shape=box,color=blue];
		j4188658490 -> "Chat ends.";
	j4000628257 [label="자 ! 어서요 ! 설령 아무 일도 일어나지 않더라도, 중요한 건 마음이니까요 ! Au calendrier !",shape=box,color=blue];
		j4000628257 -> "Chat ends.";
	j2451556652 [label="풉 ! 다른 언어들은 항상 골 언어의 가장 좋은 부분을 훔쳐서 가져간다니까요! 세월이 흘러도 절대 변하지 않을 거에요 !",shape=box,color=blue];
		j2451556652 -> j3542593548;
	j405065655 [label="그럼 당신은 똑똑한거에요 ! 골 언어는 역사상 가장 아름다운 언어 중 하나이고, 이 언어를 futur에서 선보일 수 있어서 기뻐요.",shape=box,color=blue];
		j405065655 -> j3542593548;
