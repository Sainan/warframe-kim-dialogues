digraph {
	2615 [label="MarieEntratiDay2 begins.",color=orange];
		2615 -> 2616;
	2616 [label="드리프터. 잠시 시간을 내서 생각을 정리하고... 스스로 진정하려고 노력했어요. 화가 났을 때는 대화에 뛰어들지 않겠다는 저 혼자만의 엄격한 규칙이 있거든요.",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="Evaluate expressions",color=orange];
		2617 -> 2618 [label="MarieEntrati5a",color=purple];
		2617 -> 2619 [label="MarieEntrati5b",color=purple];
		2617 -> 2620 [label="MarieEntrati5c",color=purple];
		2617 -> 2621 [label="MarieEntrati5d",color=purple];
		2617 -> 2622 [label="MarieEntrati5e",color=purple];
		2617 -> 2623 [label="MarieEntrati5f",color=purple];
		2617 -> 2624 [label="MarieEntrati5g",color=purple];
		2617 -> 2625 [label="MarieEntrati5h",color=purple];
		2617 -> 2626 [label="MarieEntrati5i",color=purple];
		2617 -> 2627 [label="false",color=purple];
	2618 [label="당신과의 어제 나눈 대화는... 제 갈비뼈에 꽂힌 단검과도 같았습니다. 분노에 차서 그 자리를 도망쳤다는 걸 인정하지만, répulsion도 들었어요. 당신이 아니라 제 자신에게요.",shape=box,color=blue];
		2618 -> 2628;
	2619 [label="하지만 대화를 계속하기 전, 먼저 한 가지 문제를 짚고 넘어가야겠어요 - 바로 당신이 제게 말할 때의 어조에요. 당신은 절 어린아이로 치부하시죠. 어쩌면 수백 년이나 더 오래 사셨으니 그럴꺼에요.",shape=box,color=blue];
		2619 -> 2629;
	2620 [label="당신의 말씀을 곰곰이 생각하는 데 많은 시간을 보냈습니다. 이는 성전이 아니며, le Cardinal은 교활한 방식으로 행동해 오셨다는 거요.",shape=box,color=blue];
		2620 -> 2630;
	2621 [label="당신께서 말씀하셨듯... 솔의 경전에 무고한 이들이 죽어도 괜찮냐는 묻는 그 질문은 옳았습니다. 그런 내용은 없으니까요.",shape=box,color=blue];
		2621 -> 2631;
	2622 [label="대화를 시작하기 전, 먼저 한 가지 문제를 짚고 넘어가야겠습니다 - 당신 스스로가 신앙을 갖고 있지 않으면서, 제가 가진 신앙을 대항용으로 사용하려는 그 의지에 대해서요.",shape=box,color=blue];
		2622 -> 2632;
	2623 [label="어제의 대화 도중... 자리를 떠나게 되어 죄송하다는 말씀 드립니다. 저에게 너무 과한 내용들이었어요. 하지만 이 대화를 계속하기 전에 한 가지 여쭤봐야할 게 있습니다 - 진심이셨나요 ? 아니면 그냥 불편한 논쟁을 피하려고 제 감정을 조종하신 건가요 ?",shape=box,color=blue];
		2623 -> 2633;
		2623 -> 2634;
	2624 [label="Le Cardinal과 관련해서 우린 막다른 길에 다다른 것 같네요, oui ? 당신은 그분을 monstre로 보시고, 전 그분을 성인처럼 보잖아요.",shape=box,color=blue];
		2624 -> 2635;
	2625 [label="당신이 제 호감을 사려고 엔트라티의 편을 들기로 한 결정에 대해 이야기하고 싶어졌어요. 괜찮으시다면요.",shape=box,color=blue];
		2625 -> 2636;
	2626 [label="지금 당장 당신의 거짓말에 대해 이야기하고 싶어졌어요. 괜찮으시다면요.",shape=box,color=blue];
		2626 -> 2636;
	2627 [label="Chat ends.",color=orange];
	2628 [label="당신이 그리 치명적일 정도로 정확하게 조준해오니 제가 어찌 안 놀랄 수 있겠어요 ? 제 말을 악마의 것과 비교하시다니...",shape=box,color=blue];
		2628 -> 2637;
	2629 [label="당신은 미지의 차원, 보이드 그 자체를 여행하셨죠. 신들, 천사들과 싸우셨겠죠. 당신에게 저는 누구인가요, oui ? 그저 바보같고 작은 마리에요.",shape=box,color=blue];
		2629 -> 2638;
	2630 [label="그리고 저는... oui, 당신 말이 맞아요. 이건 성전이 아니지요. 성전 같은 건 없으니까요. 전쟁은 결코 거룩하거나, 정의롭거나, 의롭지 않아요. 고통이란 건 결코 인도하는 빛이 되어서는 안 됩니다.",shape=box,color=blue];
		2630 -> 2639;
	2631 [label="전쟁은 결코 거룩하거나, 정의롭거나, 의롭지 않아요. 고통이란 건 결코 인도하는 빛이 되어서는 안 됩니다.",shape=box,color=blue];
		2631 -> 2639;
	2632 [label="이는 부정적인 행동입니다, 드리프터. 잔인하고 무능한 짓이에요. 대화에서 \"승리\"하려는 시도일 뿐이지, 그런 식으로 상대방을 대하시는 건 안됩니다.",shape=box,color=blue];
		2632 -> 2640;
	2633 [label="진심이었어. 타이밍이 좋지 않았다면... 사과할게. 당신이 진심으로 걱정돼, 마리...",shape=box,color=red];
		2633 -> 2641;
	2634 [label="의도한 건 아니었어. 그냥... 딴 생각하다가. 정말, 정말, 미안해. 그 순간의 열정이 너무 커서 그랬어.",shape=box,color=red];
		2634 -> 2642;
	2635 [label="어쨌거나... 전 우리 사이를 이렇게까지 만들고 싶지는 않습니다. 당신은 정말 착한 사람이에요. 우리의 관계 사이에 틀어지게 두고 싶지 않은 점들이 너무 많지요.",shape=box,color=blue];
		2635 -> 2946;
	2636 [label="제 감정을 통제하려고 상황을 조작하려는 건... 부정직하고 잔인한 행동입니다. 솔직히 말해서 당신을 미워하고 싶어요, 드리프터.",shape=box,color=blue];
		2636 -> 2644;
	2637 [label="스스로를 세상과 그 안의 모든 존재에게 열린 마음과 정신을 가진 사람이라고 생각했습니다. 그런데 당신은 아주 간결하고도 가시 돋힌 화살 하나로 제 생각이 틀렸다는 걸 증명해 주셨습니다.",shape=box,color=blue];
		2637 -> 2645;
	2638 [label="한편으론, 이해합니다. 공감도 되요. 우리 둘 다 화나 있었죠. 하지만 다른 한편으로는, 당신께서 지금보다 더 우아하고 재치있게 절 대해 주시길 부탁드립니다.",shape=box,color=blue];
		2638 -> 2646;
	2639 [label="심지어 우리가 지금 하고 있는 일 - 속삭임을 파괴하고 수많은 적들과 싸우는 일조차도 광휘의 성체들께서 마련한 길도 아니지요.",shape=box,color=blue];
		2639 -> 2647;
	2640 [label="신앙은 다른 이를 공격하는 무기가 아니며, 앞으로도 그럴 수 없습니다. 이는 방패요, 어둠 속을 밝히는 빛과 같습니다. 길을 인도하는 목소리 말이에요.",shape=box,color=blue];
		2640 -> 2648;
	2641 [label="그 엄청난 사실과 마주하기 전 - 먼저 le Cardinal에 대한 스스로의 생각에 대해 설명해야겠지요, s'il vous plaît.",shape=box,color=blue];
		2641 -> 2649;
	2642 [label="Update boolean DrifterMarie",color=orange];
		2642 -> 2650;
	2946 [label="Check boolean LoidFamilyComplete",color=orange];
		2946 -> 2651 [label=true,color=green];
		2946 -> 2643 [label=false,color=brown];
	2644 [label="어쨌거나... 전 우리 사이를 이렇게까지 만들고 싶지는 않습니다. 우리의 관계 사이에 틀어지게 두고 싶지 않은 점들이 너무 많지요.",shape=box,color=blue];
		2644 -> 1395;
	2645 [label="아무래도 이렇게라도 pour m'excuser 하려고 여기에 있나봐요 - 제가 이렇게 어리석게 고집을 부린 점에 대해 진심으로 사과를 드리고 싶어요. 이해해주시면 좋겠어요.",shape=box,color=blue];
		2645 -> 2653;
		2645 -> 2654;
	2646 [label="전 길거리에서 살았습니다. 매일매일을 육체적 고통 속에서 살아나갔죠. 이별의 아픔도, 사랑도, 두려움과 거절도, 삶과 상실도 경험하였습니다.",shape=box,color=blue];
		2646 -> 2655;
	2647 [label="세상이 적들과 같은 부류의 존재들에게 침략당하지 않도록 칼을 들어 올리는 행위가 아무리 필요하더라도, 칼 자체를 숭배해서는 안 됩니다. 그리고 그 칼로 인해 무고한 이들이 피해를 입는 것은 결코 용서받을 수 없는 행위이지요.",shape=box,color=blue];
		2647 -> 2656;
	2648 [label="그리고 그걸 이용해서 절 \"패배\" 시킬 생각이셨던가요? 비겁한 계략이셨습니다. 하지만 우리 모두 화가 났었으니, 용서...해 드릴게요. 당신께서 절 용서해 주신다면, 분노에 찬 말들을 용서해 드리겠습니다.",shape=box,color=blue];
		2648 -> 2657;
		2648 -> 2658;
	2649 [label="전 le Cardinal에 대한 옹호를 포기하기 어렵다고 생각합니다... 그리고 왜 그를 놓아줄 수 없었는지 이해하는 데 시간이 좀 걸렸어요.",shape=box,color=blue];
		2649 -> 2659;
	2650 [label="Non, 이해해요... \"격정 범죄\"로 얼마나 많은 살인들이 저질러졌을까요, oui ? 물론 그 과정에서 많은 아이들이 태어났겠지만요.",shape=box,color=blue];
		2650 -> 2660;
	2651 [label="그리고 당신은 짧은 시간 안에 저에게 중요한 사람이 되었어요... 우리의 대화가 너무나 joyeuses한 걸 깨달았어요.",shape=box,color=blue];
		2651 -> 2661;
	2643 [label="사실, 아직도 Monsieur 로이드께서 위층에 계신 분들과 함께하는 모습을 보고 싶어요. Le Cardinal의 남은 가족분들에게 위로가 전해지기를 바랍니다. 그리고 당신이 바로 그 길이에요 ! ",shape=box,color=blue];
		2643 -> 2651;
	1395 [label="Check boolean LoidFamilyComplete",color=orange];
		1395 -> 2662 [label=true,color=green];
		1395 -> 2652 [label=false,color=brown];
	2653 [label="나도 그래. 그리고 내 말로 인해서 당신이 상처를 입었다면 사과할게. 그 문제들을 어떻게 말해야 할 지 몰랐었어.",shape=box,color=red];
		2653 -> 2663;
	2654 [label="내 말이 전달되서 정말 기뻐. 희망을 잃고 있던 차였거든.",shape=box,color=red];
		2654 -> 2664;
	2655 [label="그리고 만약 우리 모두보다 훨씬 높은 곳에 스스로가 있다고 진심으로 믿고 계신다면, 당신은 길 잃은 구름 외에는 그 어떤 것도 보지 못하실 겁니다.",shape=box,color=blue];
		2655 -> 2657;
		2655 -> 2658;
	2656 [label="그래서... 저는 Le Cardinal이 \"더 큰 선\" 이라는 명목 하에 다른 이들을 해치는 행위가 정당화될 수 없다는 걸 인정하겠습니다.",shape=box,color=blue];
		2656 -> 2665;
	2657 [label="답답했었고, 어떻게하면 당신이 제정신을 차릴 수 있을지 몰랐었어. 엔트라티는 당신의 친구가 아니야. 아버지도 아니고.",shape=box,color=red];
		2657 -> 2666;
	2658 [label="미안. 화가 폭발해서, 그럴 의도는 아니었는데 말을 내뱉어 버렸어.",shape=box,color=red];
		2658 -> 2667;
	2659 [label="제가 모든 사실을 고백했더라도 절 얕잡아 보지 말아주셨으면 해요. 이 점이 너무 하찮고 pathétique하게만 느껴지니까요.",shape=box,color=blue];
		2659 -> 2668;
		2659 -> 2669;
	2660 [label="전... 실망했고, 상처 받았습니다. 하지만 전... 당신을 용서하겠어요.",shape=box,color=blue];
		2660 -> 2670;
	2661 [label="Evaluate expressions",color=orange];
		2661 -> 2671 [label="DrifterMarie",color=purple];
		2661 -> 2672 [label="DrifterLyon",color=purple];
		2661 -> 2673 [label="DrifterRoathe",color=purple];
		2661 -> 2674 [label="false",color=purple];
	2662 [label="그리고 당신은 아직도 리온과 악마에게 베풀 수 있는 친절함이 많이 남아 있을 거에요...",shape=box,color=blue];
		2662 -> 2675;
		2662 -> 2676;
	2652 [label="사실, 아직도 Monsieur 로이드께서 위층에 계신 분들과 함께하는 모습을 보고 싶어요. Le Cardinal의 남은 가족분들에게 위로가 전해지기를 바랍니다. 그리고 당신이 바로 그 길이에요 ! ",shape=box,color=blue];
		2652 -> 2662;
	2663 [label="+10 Chemistry",color=orange];
		2663 -> 2677;
	2664 [label="누군가가 \"승리\"했을 때 은혜를 베푸는 데는 이유가 있어요.",shape=box,color=blue];
		2664 -> 2678;
		2664 -> 2679;
	2665 [label="그분의 길에 산산조각난 삶들과 마음만이 남아져 있다면, \"더 크나큰 선\"이 남아있어봤자 무슨 소용이 있을까요 ?",shape=box,color=blue];
		2665 -> 2645;
	2666 [label="Non. 그분은 제 아버지가 아니시죠. 제 친아버지는 어렸을 때 절 길거리에 내버렸고, le Cardinal은 그보다 더 잔인한 짓은 하지 않으셨으니까요.",shape=box,color=blue];
		2666 -> 2680;
	2667 [label="수많은 희극이 열정의 열기 속에서 이루어졌습니다. 세상은 원래 그런 법이니까요. ",shape=box,color=blue];
		2667 -> 2681;
	2668 [label="그게 어떤 의미인지 난 이미 알고 있다고 생각이 드네. ",shape=box,color=red];
		2668 -> 2682;
	2669 [label="당신을 얕잡아 보지 않을 거야, 마리. 약속할게.",shape=box,color=red];
		2669 -> 2683;
	2670 [label="괜찮으시다면... le Cardinal에 대한 대화를 마무리 지어 주시겠어요? -제 상심은 일단 접어두고요, s'il te plaît ?",shape=box,color=blue];
		2670 -> 2684;
	2671 [label="사실, 당신이 저에게 그 감정을 고백하셨을 때, 제가 어떻게 당신을 밀어낼 수 있겠어요 ?",shape=box,color=blue];
		2671 -> 2685;
	2672 [label="사실, 당신이 저에게 리온에 대한 감정을 고백하셨을 때, 제가 어떻게 당신을 밀어낼 수 있겠어요 ? 당신이 리온에게 평화와... 위로를 줄 수 있을텐데...",shape=box,color=blue];
		2672 -> 2685;
	2673 [label="사실, 당신이 저에게 악마에 대한 감정을 고백하셨을 때, 제가 어떻게 당신을 밀어낼 수 있겠어요 ? 당신의 취향은 이해가 안 가지만... 당신이 우리 곁에 있어야 할 것 같으니까요, oui ?",shape=box,color=blue];
		2673 -> 2685;
	2674 [label="동료인 당신을 잃고 싶지 않아요. 우린 이 모든 것을 제쳐두고, 서로가 동의하지 않더라도 계속해서 나아갈 수 있다고 말할 수 있을까요 ?",shape=box,color=blue];
		2674 -> 2686;
		2674 -> 2687;
	2675 [label="마리, 기다려. 제발. 사과할게.",shape=box,color=red];
		2675 -> 2688;
	2676 [label="솔직히 말해서 당신이 내게 해줬던 말들을 중요하게 여기지 않았어. 당신에게 그렇게 중요할 거라 생각하지 않았거든.",shape=box,color=red];
		2676 -> 2688;
	2677 [label="당신이 아시는 것보다 더 많이 감사드려요, 진심으로요.",shape=box,color=blue];
		2677 -> 2689;
	2678 [label="그냥 놀린거야.",shape=box,color=red];
		2678 -> 2690;
	2679 [label="미안. 자주 \"승리\"하는 편이 아니라서.",shape=box,color=red];
		2679 -> 2691;
	2680 [label="Update boolean MarieFamilyFail",color=orange];
		2680 -> 2692;
	2681 [label="+5 Chemistry",color=orange];
		2681 -> 2693;
	2682 [label="당신도 이미 알겠지만요, non ? Famille를 잃은 사람 말이에요. ",shape=box,color=blue];
		2682 -> 2694;
