		433 -> 430;
	437 [label="중요한 점은, 당신의 마음 속에 사랑이 있다면, 당신이 기도하는 신들의 이름에 무슨 의미가 있을까요 ? 전혀 중요치 않다고, 저는 생각합니다.",shape=box,color=blue];
