digraph {
	57 [label="MarieRank1Convo2 begins.",color=orange];
		57 -> 59;
		57 -> 58;
	59 [label="마리? 나 리온한테 뭐 잘못한 거라도 있는 걸까?",shape=box,color=red];
		59 -> 61;
	58 [label="[종료.]",shape=box,color=red];
		58 -> 60;
	61 [label="흐음 ? Pourquoi ? 아... 혹시 리온이 당신과의 이 '말하는 도구'를 아직 시작하지 않아서인가요 ?",shape=box,color=blue];
		61 -> 62;
		61 -> 63;
		61 -> 64;
	60 [label="Chat ends.",color=orange];
	62 [label="혹시 타자 칠 줄 모른대?",shape=box,color=red];
		62 -> 65;
	63 [label="혹시 리온, 기술 공포증 같은 거 있어?",shape=box,color=red];
		63 -> 66;
	64 [label="맞아. 너랑 로스 둘 다 이 메신저에 있으니, 리온도...",shape=box,color=red];
		64 -> 67;
	65 [label="하 ! 리온은 제가 만난 이들 중엔 가장 배움이 빠른 사람 중 하나랍니다, 드리프터 ! 저라면 무엇이든 돈이 걸린 퍼즐로 리온에게 도전하지는 않을 거에요.",shape=box,color=blue];
		65 -> 67;
	66 [label="Non, 리온은 새로운 것에 잘 적응하는 편이에요. 리온이라면 머지않아 저 밑의 은신처에서 쿵쿵거리며 돌아다니는 저 manoeuvres de marche도 금세 연구해 자기만의 설계까지 만들어낼 수 있을 거라고 기대해 마지않는답니다.",shape=box,color=blue];
		66 -> 67;
	67 [label="그저, 리온이 당신을 잘 모르기 때문이랍니다. 리온은... 빈말로라도 사교적인 사람이 아니거든요. 당신의 기분을 상하게 만들려던 게 아니에요.",shape=box,color=blue];
		67 -> 68;
		67 -> 69;
	68 [label="당신이 해줄 수 있는 게 있지 않을까?",shape=box,color=red];
		68 -> 70;
	69 [label="나 때문이 아니라 다행이네...",shape=box,color=red];
		69 -> 71;
	70 [label="리온은... 자기 자신의 마음 속이 너무 시끄러울 뿐이랍니다. 그 마음 속을 보여줄 수 있는 사람에게는 아주 세세히 신경을 써 주곤 해요.",shape=box,color=blue];
		70 -> 72;
	71 [label="+5 Chemistry",color=orange];
		71 -> 73;
	72 [label="+15 Chemistry",color=orange];
		72 -> 74;
	73 [label="Non, non, non, 당신 탓이 아니에요. 리온은... 자기 자신의 마음 속이 너무 시끄러울 뿐이랍니다. 그 마음 속을 보여줄 수 있는 사람에게는 아주 세세히 신경을 써 주곤 해요.",shape=box,color=blue];
		73 -> 72;
	74 [label="시간이 걸릴 거고. 인내심도 필요할 거에요.",shape=box,color=blue];
		74 -> 75;
	75 [label="아 ! 가봐야겠어요. 나중에 마저 얘기해요.",shape=box,color=blue];
		75 -> 76;
	76 [label="Chat ends.",color=orange];
}