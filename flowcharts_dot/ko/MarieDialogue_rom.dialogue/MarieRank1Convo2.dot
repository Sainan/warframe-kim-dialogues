	"Chat ends." [color=orange];
	j365774906 [label="혹시 타자 칠 줄 모른대?",shape=box,color=red];
		j365774906 -> j1260352540;
	j1632445747 [label="혹시 리온, 기술 공포증 같은 거 있어?",shape=box,color=red];
		j1632445747 -> j2421145876;
	j2963229049 [label="맞아. 너랑 로스 둘 다 이 메신저에 있으니, 리온도...",shape=box,color=red];
		j2963229049 -> j4012501429;
	j1260352540 [label="하 ! 리온은 제가 만난 이들 중엔 가장 배움이 빠른 사람 중 하나랍니다, 드리프터 ! 저라면 무엇이든 돈이 걸린 퍼즐로 리온에게 도전하지는 않을 거에요.",shape=box,color=blue];
		j1260352540 -> j4012501429;
	j2421145876 [label="Non, 리온은 새로운 것에 잘 적응하는 편이에요. 리온이라면 머지않아 저 밑의 은신처에서 쿵쿵거리며 돌아다니는 저 manoeuvres de marche도 금세 연구해 자기만의 설계까지 만들어낼 수 있을 거라고 기대해 마지않는답니다.",shape=box,color=blue];
		j2421145876 -> j4012501429;
	j4012501429 [label="그저, 리온이 당신을 잘 모르기 때문이랍니다. 리온은... 빈말로라도 사교적인 사람이 아니거든요. 당신의 기분을 상하게 만들려던 게 아니에요.",shape=box,color=blue];
		j4012501429 -> j2859446319;
		j4012501429 -> j2407755885;
	j2859446319 [label="당신이 해줄 수 있는 게 있지 않을까?",shape=box,color=red];
		j2859446319 -> j789219900;
	j2407755885 [label="나 때문이 아니라 다행이네...",shape=box,color=red];
		j2407755885 -> j3312965129;
	j789219900 [label="리온은... 자기 자신의 마음 속이 너무 시끄러울 뿐이랍니다. 그 마음 속을 보여줄 수 있는 사람에게는 아주 세세히 신경을 써 주곤 해요.",shape=box,color=blue];
		j789219900 -> j3567155379;
	j3312965129 [label="+5 Chemistry",color=orange];
		j3312965129 -> j1663807976;
	j3567155379 [label="+15 Chemistry",color=orange];
		j3567155379 -> j190578019;
	j1663807976 [label="Non, non, non, 당신 탓이 아니에요. 리온은... 자기 자신의 마음 속이 너무 시끄러울 뿐이랍니다. 그 마음 속을 보여줄 수 있는 사람에게는 아주 세세히 신경을 써 주곤 해요.",shape=box,color=blue];
		j1663807976 -> j3567155379;
	j190578019 [label="시간이 걸릴 거고. 인내심도 필요할 거에요.",shape=box,color=blue];
		j190578019 -> j1451732007;
	j1451732007 [label="아 ! 가봐야겠어요. 나중에 마저 얘기해요.",shape=box,color=blue];
		j1451732007 -> "Chat ends.";
}