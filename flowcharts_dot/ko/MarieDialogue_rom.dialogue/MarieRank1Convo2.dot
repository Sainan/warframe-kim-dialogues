		j3039724897 -> "Chat ends.";
	j522723138 [label="흐음 ? Pourquoi ? 아... 혹시 리온이 당신과의 이 '말하는 도구'를 아직 시작하지 않아서인가요 ?",shape=box,color=blue];
		j522723138 -> j365774906;
