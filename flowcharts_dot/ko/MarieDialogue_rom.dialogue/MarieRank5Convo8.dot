	3771 [label="Oui, qu'est-ce qu'il y a ?",shape=box,color=blue];
		3771 -> 3774;
	3772 [label="Chat ends.",color=orange];
	3779 [label="이제 그자를 \"우리\" 악마라고 불러야 하죠, non ? 곧 떠나지도 않을 것 같으니까요. 하 !",shape=box,color=blue];
		3779 -> 3784;
	3775 [label="제가 당신한테 그 질문을 해야 할 것 같은데요, non ? 지금 그 자랑 어울려 다니는 건 당신이잖아요 !",shape=box,color=blue];
		3775 -> 3781;
	3776 [label="당신이 어떻게 그런 결과를 얻었는지는 모르겠지만. 그자는 혈청 투약의 진실을 우리에게 말해 주었어요.",shape=box,color=blue];
		3776 -> 3782;
	3777 [label="당신이 어떻게 그런 결과를 얻었는지는 모르겠지만. 그자는 sérum 투약의 진실을 우리에게 말해 주었어요.",shape=box,color=blue];
	3778 [label="그자가 걱정되네요. 밝혀진 비밀로 생각보다 더 자책하는 것 같아요, n'est-ce pas?",shape=box,color=blue];
		3778 -> 3783;
	3774 [label="갑자기 이런 말을 해서 미안하지만, 어떻게 말을 꺼내야 할지 몰랐었어.",shape=box,color=red];
		3774 -> 3780;
	3784 [label="Monsieur 로이드의 도움을 받아낸 건 잘한 일이에요. 전 그게 가능할 거라고 생각도 못했거든요.",shape=box,color=blue];
		3784 -> 3786;
	3781 [label="전 당신에게 toutes sortes de commérages을 물어보라는 tentation에 저항하고 있다구요.",shape=box,color=blue];
		3781 -> 3786;
	3782 [label="솔이시여, 제 맘이 찢어지네요. 그자의 목소리는 떨리지 않았지만. Mais je l'ai vu dans ses yeux.",shape=box,color=blue];
		3782 -> 3786;
	3783 [label="가슴이 찢어지네요. 언젠가 그자의 마음이 산산조각나지 않기를 바랄 뿐이에요. 그자가 살아남을 수 있을지도 모르겠어요. 우리 중 누가 살아남을 수 있을지조차 모르겠어요.",shape=box,color=blue];
		3783 -> 3787;
	3780 [label="당신을 흠모하고 있어. 그저 당신을 사랑해.",shape=box,color=red];
		3780 -> 3785;
	3786 [label="그자에게 변화가 일어났어요. 미묘하지만, 분명히요. ",shape=box,color=blue];
		3786 -> 3789;
	3787 [label="Chat ends.",color=orange];
	3785 [label="그래서, 궁금하던 차인데... 당신만 괜찮다면... 나랑 커플이 되어줄래?",shape=box,color=red];
		3785 -> 3788;
