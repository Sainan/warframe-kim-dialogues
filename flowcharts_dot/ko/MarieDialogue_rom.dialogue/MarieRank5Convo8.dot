		3788 -> 3790 [label="false",color=purple];
	3792 [label="그점에 대해서 당신께 감사드려야 할 것 같아요.",shape=box,color=blue];
		3792 -> 3795;
	3790 [label="오 ! 오, 드리프터. 이 말을 어찌 전해야할지 모르겠으니, 그냥 솔직하게 말할게요. ",shape=box,color=blue];
		3790 -> 3793;
	3791 [label="오, 저도 같은 마음이에요 ! Mais je ne sais pas comment te l'écrire, je n'ose pas taper les mots ! 이런걸 생각하는 것조차 바보같은 짓이라고 생각했었어요 !",shape=box,color=blue];
		3791 -> 3794;
	3795 [label="그자가 그걸 받아들일진 모르겠으나, 우정은 항상 갖게 되겠죠.",shape=box,color=blue];
		3795 -> 3798;
	3793 [label="Non.",shape=box,color=blue];
		3793 -> 3796;
	3794 [label="아 ! 절 행복하게 만드시네요 !",shape=box,color=blue];
		3794 -> 3797;
	3798 [label="그렇다고 해서 그자에게 소리 지르는 걸 결코 지치지 않을거지만요 !",shape=box,color=blue];
		3798 -> 3801;
		3798 -> 3802;
	3796 [label="Chat ends.",color=orange];
	3797 [label="좀 더... 격식있는 구애를 원하신다면, oui ! Oui ! 커플 하고 싶어요.",shape=box,color=blue];
		3797 -> 3799;
		3797 -> 3800;
	3801 [label="어쨌거나, 로스는 당신 놀리는 걸 너무 좋아하는 것 같아.",shape=box,color=red];
		3801 -> 3805;
	3802 [label="당신 둘 사이에 어떤 종류의 친밀감을 찾게 되서 다행이야.",shape=box,color=red];
		3802 -> 3806;
	3799 [label="결혼 제안을 하는 게 아니야, 아직은. ",shape=box,color=red];
		3799 -> 3803;
	3800 [label="그 의미가 확실히 발전하긴 했어. 더 \"격식\"이라고는 할 수 없지만, 보여...줄 수 있어서 정말 기뻐.",shape=box,color=red];
		3800 -> 3804;
	3805 [label="Comme un gros chat de gouttière. 그자 성격에 익숙해져 버렸어요.",shape=box,color=blue];
