	3806 [label="Oui ! 저도 그래요. 매일 그자에 대해 조금씩 덜 참을 수 있게 되어가고 있어요.",shape=box,color=blue];
		3806 -> 3805;
	3803 [label="이제 제가 놀리는 역이니까요. 걱정하지 마세요. 어쨌거나, je suis ravie ! 이 새로운... romantiques 관습들을 배워가는 게 기대되요.",shape=box,color=blue];
		3803 -> 3807;
	3804 [label="하 ! 당신이 사악한 거 꾸밀 때를 잘 아니까요. 그럼, 기대하고 있을게요.",shape=box,color=blue];
