		j3352038746 -> j3941728896;
	"Chat ends." [color=orange];
	j2015980261 [label="이제 그자를 \"우리\" 악마라고 불러야 하죠, non ? 곧 떠나지도 않을 것 같으니까요. 하 !",shape=box,color=blue];
		j2015980261 -> j4196248985;
	j556594691 [label="제가 당신한테 그 질문을 해야 할 것 같은데요, non ? 지금 그 자랑 어울려 다니는 건 당신이잖아요 !",shape=box,color=blue];
		j556594691 -> j2061243921;
	j1696917173 [label="당신이 어떻게 그런 결과를 얻었는지는 모르겠지만. 그자는 혈청 투약의 진실을 우리에게 말해 주었어요.",shape=box,color=blue];
		j1696917173 -> j3303779035;
	j836839397 [label="당신이 어떻게 그런 결과를 얻었는지는 모르겠지만. 그자는 sérum 투약의 진실을 우리에게 말해 주었어요.",shape=box,color=blue];
	j1998577440 [label="그자가 걱정되네요. 밝혀진 비밀로 생각보다 더 자책하는 것 같아요, n'est-ce pas?",shape=box,color=blue];
		j1998577440 -> j2533116399;
	j3941728896 [label="갑자기 이런 말을 해서 미안하지만, 어떻게 말을 꺼내야 할지 몰랐었어.",shape=box,color=red];
		j3941728896 -> j2057854699;
	j4196248985 [label="Monsieur 로이드의 도움을 받아낸 건 잘한 일이에요. 전 그게 가능할 거라고 생각도 못했거든요.",shape=box,color=blue];
		j4196248985 -> j179320143;
	j2061243921 [label="전 당신에게 toutes sortes de commérages을 물어보라는 tentation에 저항하고 있다구요.",shape=box,color=blue];
		j2061243921 -> j179320143;
	j3303779035 [label="솔이시여, 제 맘이 찢어지네요. 그자의 목소리는 떨리지 않았지만. Mais je l'ai vu dans ses yeux.",shape=box,color=blue];
		j3303779035 -> j179320143;
	j2533116399 [label="가슴이 찢어지네요. 언젠가 그자의 마음이 산산조각나지 않기를 바랄 뿐이에요. 그자가 살아남을 수 있을지도 모르겠어요. 우리 중 누가 살아남을 수 있을지조차 모르겠어요.",shape=box,color=blue];
		j2533116399 -> "Chat ends.";
	j2057854699 [label="당신을 흠모하고 있어. 그저 당신을 사랑해.",shape=box,color=red];
		j2057854699 -> j2199641679;
	j179320143 [label="그자에게 변화가 일어났어요. 미묘하지만, 분명히요. ",shape=box,color=blue];
		j179320143 -> j3554189636;
	j2199641679 [label="그래서, 궁금하던 차인데... 당신만 괜찮다면... 나랑 커플이 되어줄래?",shape=box,color=red];
		j2199641679 -> j2298753926;
	j3554189636 [label="+5 Chemistry",color=orange];
		j3554189636 -> j413988495;
	j2298753926 [label="Evaluate expressions",color=orange];
		j2298753926 -> j905628316 [label="MarieNoDate",color=purple];
		j2298753926 -> j3467965121 [label="MarieWillDate",color=purple];
		j2298753926 -> j905628316 [label="false",color=purple];
	j413988495 [label="그점에 대해서 당신께 감사드려야 할 것 같아요.",shape=box,color=blue];
		j413988495 -> j1843959272;
	j905628316 [label="오 ! 오, 드리프터. 이 말을 어찌 전해야할지 모르겠으니, 그냥 솔직하게 말할게요. ",shape=box,color=blue];
		j905628316 -> j617350017;
	j3467965121 [label="오, 저도 같은 마음이에요 ! Mais je ne sais pas comment te l'écrire, je n'ose pas taper les mots ! 이런걸 생각하는 것조차 바보같은 짓이라고 생각했었어요 !",shape=box,color=blue];
		j3467965121 -> j2057070094;
	j1843959272 [label="그자가 그걸 받아들일진 모르겠으나, 우정은 항상 갖게 되겠죠.",shape=box,color=blue];
		j1843959272 -> j3992273372;
	j617350017 [label="Non.",shape=box,color=blue];
		j617350017 -> "Chat ends.";
	j2057070094 [label="아 ! 절 행복하게 만드시네요 !",shape=box,color=blue];
		j2057070094 -> j1053195795;
	j3992273372 [label="그렇다고 해서 그자에게 소리 지르는 걸 결코 지치지 않을거지만요 !",shape=box,color=blue];
		j3992273372 -> j1826314338;
		j3992273372 -> j4274436751;
	j1053195795 [label="좀 더... 격식있는 구애를 원하신다면, oui ! Oui ! 커플 하고 싶어요.",shape=box,color=blue];
		j1053195795 -> j3778352630;
		j1053195795 -> j4222086815;
	j1826314338 [label="어쨌거나, 로스는 당신 놀리는 걸 너무 좋아하는 것 같아.",shape=box,color=red];
		j1826314338 -> j2462401490;
	j4274436751 [label="당신 둘 사이에 어떤 종류의 친밀감을 찾게 되서 다행이야.",shape=box,color=red];
		j4274436751 -> j2516487058;
	j3778352630 [label="결혼 제안을 하는 게 아니야, 아직은. ",shape=box,color=red];
		j3778352630 -> j183402476;
	j4222086815 [label="그 의미가 확실히 발전하긴 했어. 더 \"격식\"이라고는 할 수 없지만, 보여...줄 수 있어서 정말 기뻐.",shape=box,color=red];
		j4222086815 -> j2159970968;
	j2462401490 [label="Comme un gros chat de gouttière. 그자 성격에 익숙해져 버렸어요.",shape=box,color=blue];
		j2462401490 -> j3964593298;
	j2516487058 [label="Oui ! 저도 그래요. 매일 그자에 대해 조금씩 덜 참을 수 있게 되어가고 있어요.",shape=box,color=blue];
		j2516487058 -> j2462401490;
	j183402476 [label="이제 제가 놀리는 역이니까요. 걱정하지 마세요. 어쨌거나, je suis ravie ! 이 새로운... romantiques 관습들을 배워가는 게 기대되요.",shape=box,color=blue];
		j183402476 -> j3909934362;
	j2159970968 [label="하 ! 당신이 사악한 거 꾸밀 때를 잘 아니까요. 그럼, 기대하고 있을게요.",shape=box,color=blue];
		j2159970968 -> j3909934362;
	j3964593298 [label="그자가 떠나면 슬퍼질 것 같아요.",shape=box,color=blue];
		j3964593298 -> "Chat ends.";
	j3909934362 [label="+10 Chemistry",color=orange];
		j3909934362 -> j2979628400;
	j2979628400 [label="그럼 그 때까지 ? À la revoyure, mon coeur.",shape=box,color=blue];
