		3229 -> 3233;
	3232 [label="Chat ends.",color=orange];
	3233 [label="리온이 말하길 그가 가진 전체 이야기를 당신에게 했다고 그러더군요, oui ? 그 점을 생각만 해도 전 눈물이 날 것 같아요...",shape=box,color=blue];
		3233 -> 3234;
		3233 -> 3235;
		3233 -> 3236;
	3234 [label="사실, 리온은 괜찮은 것 같아. 그냥... 그가 겪은 일들이 때문에 그래 - 그것도 많이.",shape=box,color=red];
		3234 -> 3237;
	3235 [label="얘기 듣고 맘이 아팠어... 리온을 돕기 위해 내가 할 수 있는 일이 더 많았으면 좋겠어...",shape=box,color=red];
		3235 -> 3238;
