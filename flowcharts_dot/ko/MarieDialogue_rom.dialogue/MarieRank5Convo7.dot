	j3337830748 [label="정말? 날 대신해서 로스랑 논쟁 벌일 거야?",shape=box,color=red];
		j3337830748 -> j1805780255;
	j1523164110 [label="당신이 제 영혼의 형제를 돕기 위해 한 모든 일들을 생각한다면 ? 다른 문제들에 대해서는 의견이 맞지 않았을 수도 있고 - 결코 의견이 일치하지 않을 수도 있지만, 이 일에 관해서요 ? 이 일만큼은 제가 당신을 위해 해드릴거에요.",shape=box,color=blue];
		j1523164110 -> j2569971645;
	j1805780255 [label="하 ! 훨씬 더 작은 일로도 악마와 싸워봤었어요. 그리고 당신이 제 영혼의 형제를 돕기 위해 한 모든 일들을 생각한다면 ? 기쁜 맘으로 임할 거에요. ",shape=box,color=blue];
