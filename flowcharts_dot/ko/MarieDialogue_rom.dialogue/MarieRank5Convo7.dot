		j3039724897 -> "Chat ends.";
	j3985628212 [label="+5 Chemistry",color=orange];
		j3985628212 -> j3985267088;
	j1124530401 [label="그저 들어주셨다는 것만으로도 정말 많은 일을 해내신 겁니다. 그가 말할 수 있도록 곁에 있어주는 것만으로도요. 리온은 망가지지 않았습니다 - 그의 균열은 심상의 기반을 걱정할 만큼 깊지 않아요. 그저 얕은 상처일 뿐이죠.",shape=box,color=blue];
		j1124530401 -> j3120554720;
	j3201758815 [label="+5 Chemistry",color=orange];
		j3201758815 -> j929225998;
	j3985267088 [label="Oui, 이해하셨군요. 리온은 부서지고 텅 빈 존재가 아니에요. 리온의 균열은 심상의 기반을 걱정할 만큼 깊지 않아요. 그저 얕은 상처일 뿐이죠.",shape=box,color=blue];
		j3985267088 -> j3120554720;
	j3120554720 [label="어제, 리온이 앉아서 M'sieur 피보나치께 고대 철학책을 읽어주는 걸 봤다니까요 ?",shape=box,color=blue];
		j3120554720 -> j1179310951;
	j929225998 [label="Oui, 귀 기울여 듣는 것만으로도 많은 걸 할 수 있어요. 리온은 부서지고 텅 빈 존재가 아니에요. 리온의 균열은 심상의 기반을 걱정할 만큼 깊지 않아요. 그저 얕은 상처일 뿐이죠.",shape=box,color=blue];
		j929225998 -> j3120554720;
	j1179310951 [label="M'sieur 피보나치가 그 책을 누구든 자기에게 읽어 달라고 그렇게 오랫동안 간청을 하고 다녔는데, 다른 사람들은 모두 거절하곤 했죠 ! 그분에게 des munitions를 주고 싶지 않았던 게 틀림 없다니까요, 하 !",shape=box,color=blue];
		j1179310951 -> j2486207884;
	j2486207884 [label="Evaluate expressions",color=orange];
		j2486207884 -> j2933720065 [label="LyonDating",color=purple];
		j2486207884 -> j1699204003 [label="MarieDating",color=purple];
		j2486207884 -> j3784017197 [label="false",color=purple];
	j2933720065 [label="우리의 소중한 리온 스스로도 그런 일을 할 줄은 꿈에도 몰랐을 거에요. 다른 이들과 그런 식으로 소통하는 걸요. 정말 즐거워하고 있었거든요.",shape=box,color=blue];
		j2933720065 -> j1326799248;
	j1699204003 [label="리온 스스로도 그런 일을 할 줄은 꿈에도 몰랐을 거에요. 다른 이들과 그런 식으로 소통하는 걸요. 정말 즐거워하고 있었어요, mon coeur.",shape=box,color=blue];
		j1699204003 -> j1326799248;
	j3784017197 [label="리온 스스로도 그런 일을 할 줄은 꿈에도 몰랐을 거에요. 다른 이들과 그런 식으로 소통하는 걸요. 정말 즐거워하고 있었거든요.",shape=box,color=blue];
		j3784017197 -> j1326799248;
	j1326799248 [label="그리고 저녁 기도 때 그 일로 광휘의 성체들께 감사 기도를 올릴 필요는 없지만 다른 누군가에겐 기도를 올려야 한다는 걸 아실 거에요. 바로 당신이죠.",shape=box,color=blue];
