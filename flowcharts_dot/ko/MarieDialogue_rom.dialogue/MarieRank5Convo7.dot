		j1195933820 -> j3725116348;
		j1195933820 -> j3039724897;
	j1857376883 [label="당신에게 일부나마 이야기를 털어놓았다고 하더군요, oui? 리온이 당신에게 마음을 열기 시작했다는 게 기뻐요...",shape=box,color=blue];
		j1857376883 -> j3310525133;
		j1857376883 -> j384180522;
		j1857376883 -> j3039724897;
	j384180522 [label="사실, 리온은 괜찮은 것 같아. 그냥... 그가 겪은 일들이 때문에 그래 - 그것도 많이.",shape=box,color=red];
		j384180522 -> j3985628212;
	j3310525133 [label="얘기 듣고 맘이 아팠어... 리온을 돕기 위해 내가 할 수 있는 일이 더 많았으면 좋겠어...",shape=box,color=red];
		j3310525133 -> j1124530401;
	j3725116348 [label="리온이... 마침내 날 믿고 자신의 모든 이야기를 해줬다는 점이 그저 기뻐...",shape=box,color=red];
