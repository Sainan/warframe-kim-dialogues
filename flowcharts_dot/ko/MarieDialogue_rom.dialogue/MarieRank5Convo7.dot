		3236 -> 3239;
	3237 [label="+5 Chemistry",color=orange];
		3237 -> 3240;
	3238 [label="그저 들어주셨다는 것만으로도 정말 많은 일을 해내신 겁니다. 그가 말할 수 있도록 곁에 있어주는 것만으로도요. 리온은 망가지지 않았습니다 - 그의 균열은 심상의 기반을 걱정할 만큼 깊지 않아요. 그저 얕은 상처일 뿐이죠.",shape=box,color=blue];
		3238 -> 3241;
	3239 [label="+5 Chemistry",color=orange];
		3239 -> 3242;
	3240 [label="Oui, 이해하셨군요. 리온은 부서지고 텅 빈 존재가 아니에요. 리온의 균열은 심상의 기반을 걱정할 만큼 깊지 않아요. 그저 얕은 상처일 뿐이죠.",shape=box,color=blue];
		3240 -> 3241;
	3241 [label="어제, 리온이 앉아서 M'sieur 피보나치께 고대 철학책을 읽어주는 걸 봤다니까요 ?",shape=box,color=blue];
		3241 -> 3243;
	3242 [label="Oui, 귀 기울여 듣는 것만으로도 많은 걸 할 수 있어요. 리온은 부서지고 텅 빈 존재가 아니에요. 리온의 균열은 심상의 기반을 걱정할 만큼 깊지 않아요. 그저 얕은 상처일 뿐이죠.",shape=box,color=blue];
		3242 -> 3241;
	3243 [label="M'sieur 피보나치께서는 오랫동안 다른 누군가에게 책을 읽어 달라고 간청하였으나, 모두가 거절했어요 ! 그에게 지식이라는 또 다른 des munitions를 주고 싶어 하지 않았겠죠, 하 !",shape=box,color=blue];
		3243 -> 3244;
