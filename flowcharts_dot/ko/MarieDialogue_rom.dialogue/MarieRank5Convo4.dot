	2982 [label="하지만 제 생각엔... 제 생각엔 - 아, 솔이시여 용서해 주시길 - 그 악마의 도움이 필요할 것 같습니다. 그렇지 않으면 Monsieur 로이드께서 우리 말을 들어주지 않을 것 같아요.",shape=box,color=blue];
		2982 -> 2986;
	2983 [label="로이드가 엔트라티 가족과 대화하도록 설득하려면 로스의 도움이 필요할 것 같아. 도움 없이는 로이드가 우리가 원하는 대로 움직여줄 것 같지 않아. 가족들과 그가 안전할 거라는 보장 없이는 말이야.",shape=box,color=red];
