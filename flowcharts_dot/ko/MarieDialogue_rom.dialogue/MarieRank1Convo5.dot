digraph {
	3964 [label="MarieRank1Convo5 begins.",color=orange];
		3964 -> 3965;
	3965 [label="Bonjour, bonjour ! 당신이 드리프터군요, oui ? Monsieur 로이드께서 당신에 대해 정말 많은 이야기를 해주셨답니다. 이런 식으로 \"만나게\" 되어 정말 반가워요...",shape=box,color=blue];
		3965 -> 3966;
	3966 [label="Appareil cliquetant, 그래도 영리한 수단이네요 !",shape=box,color=blue];
		3966 -> 3967;
	3967 [label="저는 Soeur 마리 르루입니다만, 마리라고 불러주셔도 되요. 최근 제 영혼의 형제인 리온 알라드 신부와 함께 이 곳으로 왔고... 음, Monsieur 로이드께서 악마에 대해 경고 하셨을거라 생각합니다, n'est-ce pas ?",shape=box,color=blue];
		3967 -> 3968;
		3967 -> 3969;
		3967 -> 3970;
	3968 [label="만나서 반가워. 그리고 오해하지 말았으면 좋겠는데, 물론 여기 온 걸 환영하지만... 당신들 도대체 여기서 뭐하는 중이야?",shape=box,color=red];
		3968 -> 3972;
	3969 [label="악마? 오로킨을 뜻하는 거야?",shape=box,color=red];
		3969 -> 3974;
	3970 [label="[종료.]",shape=box,color=red];
		3970 -> 3971;
	3972 [label="+5 Chemistry",color=orange];
		3972 -> 3973;
	3974 [label="Oui, le Cardinal께서 우리에게 맡기신 ce monstre irritant à la peau bleue. 당신은 그분을 알브레히트 엔트라티로 알고 계시지 않나요? 그분이 바로 우리가 여기에 있는 이유지만, 그건 아주 긴 이야기에요, j'en ai bien peur.",shape=box,color=blue];
		3974 -> 3975;
		3974 -> 3976;
	3971 [label="Chat ends.",color=orange];
	3973 [label="Merci ! 우리가 여기 온 이유와 방법은 아주 긴 이야기에요, j'en ai bien peur. 우리는 le Cardinal에 의해 파견되어 왔습니다. 그 분을 알브레히트 엔트라티라고 알고 계시지 않으신가요? 그분께서 우리에게 그 푸른 피부의 irritant monstrueux를 맡기셨습니다.",shape=box,color=blue];
		3973 -> 3975;
		3973 -> 3976;
	3975 [label="내가 도울 수 있는 건 해 볼게.",shape=box,color=red];
		3975 -> 3980;
	3976 [label="\"맡겼다고?\"",shape=box,color=red];
		3976 -> 3977;
	3980 [label="+5 Chemistry",color=orange];
		3980 -> 3981;
	3977 [label="우린 그자의 영혼을 인도하기 위해 할 수 있는 모든 것을 해야 한답니다, si c'est possible. Et si ce n'est pas le cas ? 그렇다면 적어도 그자가 더 이상 해를 끼치지 않도록 신경 써야 해요.",shape=box,color=blue];
		3977 -> 3978;
		3977 -> 3979;
	3981 [label="당신은 Monsieur 로이드와 카비아들이 말씀해주신 그대로인 사람이네요 ! 우린 좋은 친구가 될 것 같아요.",shape=box,color=blue];
		3981 -> 3983;
	3978 [label="당신이 시도한다면 도와줄게.",shape=box,color=red];
		3978 -> 3980;
	3979 [label="그자는 오로킨이야. 선함을 유지하는 유일한 방법은 미간 사이에 총알을 박는 것뿐이라고.",shape=box,color=red];
		3979 -> 3982;
	3983 [label="아 ! 가봐야겠어요, 양해해 주세요. 곧 다시 얘기 나눌 수 있기를 ! À la revoyure !",shape=box,color=blue];
		3983 -> 3984;
	3982 [label="리온처럼 말씀하시는 군요. 그래도 희망을 버리진 않을 거에요, 아직은요.",shape=box,color=blue];
		3982 -> 3983;
	3984 [label="Chat ends.",color=orange];
}