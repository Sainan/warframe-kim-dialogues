digraph {
	"MarieRank1Convo5 begins." [color=orange];
		"MarieRank1Convo5 begins." -> j302703310;
	j302703310 [label="Bonjour, bonjour ! 당신이 드리프터군요, oui ? Monsieur 로이드께서 당신에 대해 정말 많은 이야기를 해주셨답니다. 이런 식으로 \"만나게\" 되어 정말 반가워요...",shape=box,color=blue];
		j302703310 -> j21919483;
	j21919483 [label="Appareil cliquetant, 그래도 영리한 수단이네요 !",shape=box,color=blue];
		j21919483 -> j404166744;
	j404166744 [label="저는 Soeur 마리 르루입니다만, 마리라고 불러주셔도 되요. 최근 제 영혼의 형제인 리온 알라드 신부와 함께 이 곳으로 왔고... 음, Monsieur 로이드께서 악마에 대해 경고 하셨을거라 생각합니다, n'est-ce pas ?",shape=box,color=blue];
		j404166744 -> j3991096720;
		j404166744 -> j438872444;
		j404166744 -> j3039724897;
	j3991096720 [label="만나서 반가워. 그리고 오해하지 말았으면 좋겠는데, 물론 여기 온 걸 환영하지만... 당신들 도대체 여기서 뭐하는 중이야?",shape=box,color=red];
		j3991096720 -> j4146710935;
	j438872444 [label="악마? 오로킨을 뜻하는 거야?",shape=box,color=red];
		j438872444 -> j2978308296;
	j3039724897 [label="[종료.]",shape=box,color=red];
		j3039724897 -> "Chat ends.";
	j4146710935 [label="+5 Chemistry",color=orange];
		j4146710935 -> j3549881871;
	j2978308296 [label="Oui, le Cardinal께서 우리에게 맡기신 ce monstre irritant à la peau bleue. 당신은 그분을 알브레히트 엔트라티로 알고 계시지 않나요? 그분이 바로 우리가 여기에 있는 이유지만, 그건 아주 긴 이야기에요, j'en ai bien peur.",shape=box,color=blue];
		j2978308296 -> j3897878402;
		j2978308296 -> j381416839;
	"Chat ends." [color=orange];
	j3549881871 [label="Merci ! 우리가 여기 온 이유와 방법은 아주 긴 이야기에요, j'en ai bien peur. 우리는 le Cardinal에 의해 파견되어 왔습니다. 그 분을 알브레히트 엔트라티라고 알고 계시지 않으신가요? 그분께서 우리에게 그 푸른 피부의 monstre irritant를 맡기셨습니다.",shape=box,color=blue];
		j3549881871 -> j3897878402;
		j3549881871 -> j381416839;
	j3897878402 [label="내가 도울 수 있는 건 해 볼게.",shape=box,color=red];
		j3897878402 -> j3029409494;
	j381416839 [label="\"맡겼다고?\"",shape=box,color=red];
		j381416839 -> j797791704;
	j3029409494 [label="+5 Chemistry",color=orange];
		j3029409494 -> j364843696;
	j797791704 [label="우린 그자의 영혼을 인도하기 위해 할 수 있는 모든 것을 해야 한답니다, si c'est possible. Et si ce n'est pas le cas ? 그렇다면 적어도 그자가 더 이상 해를 끼치지 않도록 신경 써야 해요.",shape=box,color=blue];
		j797791704 -> j3397163678;
		j797791704 -> j2228336574;
	j364843696 [label="당신은 Monsieur 로이드와 카비아들이 말씀해주신 그대로인 사람이네요 ! 우린 좋은 친구가 될 것 같아요.",shape=box,color=blue];
		j364843696 -> j2184121964;
	j3397163678 [label="당신이 시도한다면 도와줄게.",shape=box,color=red];
		j3397163678 -> j3029409494;
	j2228336574 [label="그자는 오로킨이야. 선함을 유지하는 유일한 방법은 미간 사이에 총알을 박는 것뿐이라고.",shape=box,color=red];
		j2228336574 -> j1764148869;
	j2184121964 [label="아 ! 가봐야겠어요, 양해해 주세요. 곧 다시 얘기 나눌 수 있기를 ! À la revoyure !",shape=box,color=blue];
		j2184121964 -> "Chat ends.";
	j1764148869 [label="리온처럼 말씀하시는 군요. 그래도 희망을 버리진 않을 거에요, 아직은요.",shape=box,color=blue];
		j1764148869 -> j2184121964;
}