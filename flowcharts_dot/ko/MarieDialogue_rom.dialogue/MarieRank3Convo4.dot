	1267 [label="신경쓰지 마세요, 그냥 재밌게 노는 거에요. Silly little Marie la révolutionnaire.",shape=box,color=blue];
		1267 -> 1271;
	1268 [label="+10 Chemistry",color=orange];
		1268 -> 1267;
	1272 [label="제가 지금 여기 와서 질문하고자 했던 게 뭐였는지 완전히 까먹었어요 ! 하 ! 오 네. 나중에 생각나겠죠.",shape=box,color=blue];
