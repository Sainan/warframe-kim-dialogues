	1253 [label="+10 Chemistry",color=orange];
		1253 -> 1256;
	1257 [label="제가 누구랑 시간을 보내는지를 보세요, oui ? 조각상 하나를 읽어내는 법을 배우면 다른 조각상 읽어내는 것도 어렵지 않아요.",shape=box,color=blue];
		1257 -> 1259;
	1256 [label="제 생각엔 그냥 사람들 짜증나게 할려고 그랬던 것 같아요 !",shape=box,color=blue];
		1256 -> 1258;
	1259 [label="+10 Chemistry",color=orange];
		1259 -> 1261;
	1258 [label="Et ils se demandent pourquoi des rébellions éclatent. Vous aviez peut-être vos warframes, mais nous avions nos guillotines !",shape=box,color=blue];
		1258 -> 1260;
	1261 [label="그렇지만 Monsieur 로이드가 리온보다 더.. piquant하다는 거 인정해요.",shape=box,color=blue];
