		1252 -> 1254;
		1252 -> 1255;
	1249 [label="수천년 동안 권력을 쥐고 흔들면 사람들은... 지루해지기 마련이야. 지루한 사람들은 복잡한 시스템을 만들어 내지.",shape=box,color=red];
		1249 -> 1253;
	1250 [label="오로킨은 화려하고 정교한 것에 대한 취향을 가지고 있었고, 이는 관료주의에도 영향을 미쳤어.",shape=box,color=red];
		1250 -> 1253;
	1251 [label="솔직히 말하자면? 나도 그리 생각하기 시작했어.",shape=box,color=red];
