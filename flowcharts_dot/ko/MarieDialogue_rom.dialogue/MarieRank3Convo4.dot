	j1766115820 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j1766115820 -> j486822038;
	j486822038 [label="얼마 전 Monsieur 로이드와 그 분의 어린 시절에 관해 이야기를 나누었는데, 궁금한 점이 하나 있었어요.",shape=box,color=blue];
		j486822038 -> j3558294837;
		j486822038 -> j654691879;
		j486822038 -> j1868745947;
		j486822038 -> j3039724897;
	j3558294837 [label="미안. 뭐라고?",shape=box,color=red];
		j3558294837 -> j2816590901;
	j654691879 [label="이... 문제에... 대해서 어찌 생각해야 할지 잘 모르겠네.",shape=box,color=red];
		j654691879 -> j1330993286;
	j1868745947 [label="질문이 뭔데?",shape=box,color=red];
		j1868745947 -> j1954731713;
	j3039724897 [label="[종료.]",shape=box,color=red];
		j3039724897 -> "Chat ends.";
	j2816590901 [label="그분의 젊을 적에 대해서 이야기하고 있었어요. Ai-je fait quelque chose qui vous a offensé ?",shape=box,color=blue];
		j2816590901 -> j1810454079;
		j2816590901 -> j701632634;
	j1330993286 [label="저도 이해가 안 돼요. Ai-je fait quelque chose qui vous avez offensé ?",shape=box,color=blue];
		j1330993286 -> j1810454079;
		j1330993286 -> j701632634;
	j1954731713 [label="아르키메디안 - 그들은 오로킨이었을까요 ? 아니면 아니었을까요 ? 그 단어는 너무 경박하게 쓰여져요.",shape=box,color=blue];
		j1954731713 -> j1020194010;
	"Chat ends." [color=orange];
	j1810454079 [label="아무래도 난... 질투하는 것 같아.",shape=box,color=red];
		j1810454079 -> j3762758616;
	j701632634 [label="아무래도 난... 놀란 것 같아.",shape=box,color=red];
		j701632634 -> j1010099276;
	j1020194010 [label="악마에게도 물어볼 수 있겠지만, 가능하다면 악마와 대화하고 싶지 않아요.",shape=box,color=blue];
		j1020194010 -> j2023708436;
		j1020194010 -> j3458044327;
	j3762758616 [label="De la jalousie ? Pourquoi ?",shape=box,color=blue];
		j3762758616 -> j869694585;
	j1010099276 [label="Pourquoi ?",shape=box,color=blue];
		j1010099276 -> j2239799025;
		j1010099276 -> j2355213537;
	j2023708436 [label="아니, 아르키메디안은 오로킨보다 한 계급 아래였어.",shape=box,color=red];
		j2023708436 -> j486578585;
	j3458044327 [label="오로킨 제국은 오로킨들이 통치했기에 그리 불리게 되었지만, 단순히 지배 계급의 명칭이기도 해.",shape=box,color=red];
		j3458044327 -> j486578585;
	j869694585 [label="+10 Chemistry",color=orange];
		j869694585 -> j1018691410;
	j2239799025 [label="당신이 이제 나보다 로이드에 대해 더 많이 알고 있다는 사실에 약간 당황했을 뿐이야.",shape=box,color=red];
		j2239799025 -> j869694585;
	j2355213537 [label="난 로이드의 과거에 대해서 어떤 것도 모르는 데다, 그를 꽤 오랫동안 알고 있었거든.",shape=box,color=red];
		j2355213537 -> j869694585;
	j486578585 [label="이런 일 자주 있어. 당신 혼자만 그리 느끼는 게 아니야.",shape=box,color=red];
		j486578585 -> j2635762912;
	j1018691410 [label="오 ! 너무 맘에 담아두지 마세요, s'il vous plaît !",shape=box,color=blue];
		j1018691410 -> j2188047112;
	j2635762912 [label="오로킨이 의도적으로 사회를 혼란스럽고 무디게 만들었나요?",shape=box,color=blue];
		j2635762912 -> j1360976336;
		j2635762912 -> j3171029335;
		j2635762912 -> j691769099;
	j2188047112 [label="Monsieur 로이드는, 무슨 단어로 표현해야 할까요, 거리가 먼 존재인가요 ?",shape=box,color=blue];
		j2188047112 -> j1144686951;
		j2188047112 -> j1900078094;
	j1360976336 [label="수천년 동안 권력을 쥐고 흔들면 사람들은... 지루해지기 마련이야. 지루한 사람들은 복잡한 시스템을 만들어 내지.",shape=box,color=red];
		j1360976336 -> j2646592741;
	j3171029335 [label="오로킨은 화려하고 정교한 것에 대한 취향을 가지고 있었고, 이는 관료주의에도 영향을 미쳤어.",shape=box,color=red];
		j3171029335 -> j2646592741;
	j691769099 [label="솔직히 말하자면? 나도 그리 생각하기 시작했어.",shape=box,color=red];
		j691769099 -> j2646592741;
	j1144686951 [label="사실, 로이드에 대해서 아무것도 모르겠어.",shape=box,color=red];
		j1144686951 -> j335862378;
	j1900078094 [label="로이드는 조금 냉담한 편이야, 응.",shape=box,color=red];
		j1900078094 -> j335862378;
	j2646592741 [label="+10 Chemistry",color=orange];
		j2646592741 -> j3314846095;
	j335862378 [label="제가 누구랑 시간을 보내는지를 보세요, oui ? 조각상 하나를 읽어내는 법을 배우면 다른 조각상 읽어내는 것도 어렵지 않아요.",shape=box,color=blue];
		j335862378 -> j991987835;
	j3314846095 [label="제 생각엔 그냥 사람들 짜증나게 할려고 그랬던 것 같아요 !",shape=box,color=blue];
		j3314846095 -> j1451255618;
	j991987835 [label="+10 Chemistry",color=orange];
		j991987835 -> j2243337734;
	j1451255618 [label="Et ils se demandent pourquoi des rébellions éclatent. Vous aviez peut-être vos warframes, mais nous avions nos guillotines !",shape=box,color=blue];
		j1451255618 -> j3566713005;
	j2243337734 [label="그렇지만 Monsieur 로이드가 리온보다 더.. piquant하다는 거 인정해요.",shape=box,color=blue];
		j2243337734 -> j1943200854;
		j2243337734 -> j3546740589;
	j3566713005 [label="Vive la révolution !",shape=box,color=blue];
		j3566713005 -> j1840081423;
		j3566713005 -> j2863904995;
		j3566713005 -> j3244278591;
	j1943200854 [label="로이드한테도 이유가 있어.",shape=box,color=red];
		j1943200854 -> j3374468357;
	j3546740589 [label="어쨌든... 질문이 뭐였지?",shape=box,color=red];
		j3546740589 -> j2381524602;
	j1840081423 [label="내가 걱정해야할 부분이 있어?",shape=box,color=red];
		j1840081423 -> j4157458175;
	j2863904995 [label="Vive la révolution ! 응.",shape=box,color=red];
		j2863904995 -> j2352866414;
	j3244278591 [label="방금 무슨 일이 일어났는지 잘 모르겠으나, 동의하는 바야...?",shape=box,color=red];
		j3244278591 -> j2352866414;
	j3374468357 [label="네, 분명히 그리 보여요.",shape=box,color=blue];
		j3374468357 -> j607832761;
	j2381524602 [label="아 ! 네.",shape=box,color=blue];
		j2381524602 -> j607832761;
	j4157458175 [label="신경쓰지 마세요, 그냥 재밌게 노는 거에요. Silly little Marie la révolutionnaire.",shape=box,color=blue];
		j4157458175 -> j1101202396;
	j2352866414 [label="+10 Chemistry",color=orange];
		j2352866414 -> j4157458175;
	j607832761 [label="제가 지금 여기 와서 질문하고자 했던 게 뭐였는지 완전히 까먹었어요 ! 하 ! 오 네. 나중에 생각나겠죠.",shape=box,color=blue];
		j607832761 -> j548065447;
	j1101202396 [label="제 질문에 답해주셔서 감사해요, 이제 당신을 놔드려야 할 것 같네요. ",shape=box,color=blue];
		j1101202396 -> j548065447;
	j548065447 [label="하루를 방해해서 죄송합니다. 아니면 저녁이거나요. 아니면 어떤 시간, 언제 어디서든 당신의 일상을 방해하게 되서요.",shape=box,color=blue];
		j548065447 -> j4101990552;
	j4101990552 [label="À la revoyure !",shape=box,color=blue];
		j4101990552 -> "Chat ends.";
