		1234 -> 1237;
		1234 -> 1238;
	1233 [label="아르키메디안 - 그들은 오로킨이었을까요 ? 아니면 아니었을까요 ? 그 단어는 너무 경박하게 쓰여져요.",shape=box,color=blue];
