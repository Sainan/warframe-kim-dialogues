digraph {
	2239 [label="MarieRank4Convo3 begins.",color=orange];
		2239 -> 2240;
		2239 -> 2241;
	2240 [label="오늘 하루는 어때, 마리?",shape=box,color=red];
		2240 -> 2242;
	2241 [label="[종료.]",shape=box,color=red];
		2241 -> 2243;
	2242 [label="그렇게 좋지는 않아요. 내일 다시 오셔서 이야기를 나누시는 게 좋을 듯 해요. 제가 좋은 말동무가 될 수 없을 것 같거든요.",shape=box,color=blue];
		2242 -> 2244;
		2242 -> 2245;
		2242 -> 2246;
	2243 [label="Chat ends.",color=orange];
	2244 [label="원한다면 내가 거기로 가겠지만, 얘기로 풀고 싶다면 기꺼이 들어줄게.",shape=box,color=red];
		2244 -> 2247;
	2245 [label="알았어, 이해했어.",shape=box,color=red];
		2245 -> 2248;
	2246 [label="무슨 일인지 물어봐도 될까...?",shape=box,color=red];
		2246 -> 2247;
	2247 [label="C'est vraiment gentil, 하지만 오래된 문제일 뿐이에요... 당신께서 걱정하실 필요 없어요. 괜찮을 테니까요.",shape=box,color=blue];
		2247 -> 2249;
	2248 [label="Chat ends.",color=orange];
	2249 [label="Update boolean MarieChronicPain",color=orange];
		2249 -> 2250;
		2249 -> 2251;
		2249 -> 2252;
	2250 [label="얘기하고 싶은 확신이 들면, 난 여기 있으니까. 얘기하고 싶으면 해도 돼.",shape=box,color=red];
		2250 -> 2253;
	2251 [label="나... 그거 어떤 건지 알아. 내가 \"루프\"를 시작하기 전에, 두비리에서 꽤 심하게 다쳤었어. 다 나았지만, 아직도 가끔씩 엄청 고통이 몰려와. 그리고 고통 때문에 움찔거리는 걸 숨기려고 노력 중이야.",shape=box,color=red];
		2251 -> 2254;
	2252 [label="오래된 고질적인 문제들은 새로운 문제들만큼이나 골치 아픈 경우가 있지. 나타났다 사라지고, 우리 곁에 함께 할 수 있다고 해서 이야기할 가치가 없다는 뜻은 아니니까.",shape=box,color=red];
		2252 -> 2255;
	2253 [label="정말 친절하시네요, 그리고... 잘 알겠습니다. 제가 또 작고 고집 센 마리로 변모했었네요.",shape=box,color=blue];
		2253 -> 2256;
	2254 [label="Update boolean DrifterChronicPain",color=orange];
		2254 -> 2257;
	2255 [label="Oui, tu as raison. 제가 또 작고 고집 센 마리로 변모했었네요.",shape=box,color=blue];
		2255 -> 2256;
	2256 [label="설명하기 어렵지만, 노력해 볼게요. Mes pieds, oui ? 제 발이요. Le sérum이 절 바꿔놓았고, 날 수 있게 해주었지요 -",shape=box,color=blue];
		2256 -> 2258;
	2257 [label="Par les Luminaires, 정말 유감이에요. 그럼 어떤 느낌인지, 이해하시겠네요, oui ?",shape=box,color=blue];
		2257 -> 2259;
	2258 [label="하지만 전 여전히 느껴요. 절 집어삼키려 하고, 제 영혼의 모든 희망과 joie을 파괴하려 하는 그 뒤틀린 존재들이요.",shape=box,color=blue];
		2258 -> 2260;
	2259 [label="스스로를 배신하는 육신을 갖는 것, 그 점이 스스로의 정신을 느리게 만든다는 점. 지금도 너무 이상해요. Le sérum이 절 바꿔놓았고, 날 수 있게 해주었지요 -",shape=box,color=blue];
		2259 -> 2258;
	2260 [label="항상 아파요. 항상. 지금도, 여기 앉아있음에도, 발을 생각하고 있노라면, 고통이 느껴져요. 하지만, 그걸 알아차리는 것만으론 충분치 않아요.",shape=box,color=blue];
		2260 -> 2261;
	2261 [label="그런데도, 지금도 한밤중에 절 고통스럽게 깨어나게 만들어요. 그리고 전 궁금해지죠, 솔이시여, pourquoi ? 왜 아직도 이... 끝없는 agonie을 느껴야 하는 거죠 ?",shape=box,color=blue];
		2261 -> 2262;
	2262 [label="이게 다 무슨 소용이 있나요 ? 아, 그러나 아침이 되면 스스로에게 웃으며 말합니다. \"조용히 해, 마리. 넌 축복 받았어. 네가 가진 모든 것들, 네가 할 수 있는 모든 것들을 보렴.\"",shape=box,color=blue];
		2262 -> 2263;
	2263 [label="Cathédrale에서 \"당신은 읽고, 쓰고, 먹을 수 있고, 잘 수 있습니다. 충분히 움직일 수 있습니다. 앞을 내다볼 수 있는 눈과 말할 수 있는 혀가 있습니다. 쓸 수 있는 손이 있습니다. 그리고 당신을 돌봐주는 사람들이 있습니다.\" 라고 들었습니다. 그리고 이제 전 날 수 있죠! 전 보이드 그 자체와 l'Indifférence로부터 futur를 지켜야 해요 !",shape=box,color=blue];
		2263 -> 2264;
	2264 [label="\"울 수 있을 때 실컷 울어라, 바보같은 여자애야. 이 끊임없는 고통들은 앞으로 닥칠 일들에 대항하기 위해 널 강하게 만들어 줄거다\" 라고 스스로에게 말합니다. 그리고 하루는 다음날로 넘어가고, 그 다음날이 오면 과거만큼 나쁘지 않아지니까요.",shape=box,color=blue];
		2264 -> 2265;
	2265 [label="Check boolean DrifterChronicPain",color=orange];
		2265 -> 2266 [label=true,color=green];
		2265 -> 2269 [label=true,color=green];
		2265 -> 2267 [label=false,color=brown];
		2265 -> 2268 [label=false,color=brown];
	2266 [label="그런 고통이 우리에게 주는 것이 하나 있다면, 아마도 고통을 참게 되는 능력일거야.",shape=box,color=red];
		2266 -> 2270;
	2269 [label="하지만, 가끔... 어떤 날은 일어날 때, 그 날이 바로 스스로가 부숴져 버릴 것 같은 기분이 들 때가 있어.",shape=box,color=red];
		2269 -> 2270;
	2267 [label="정말... 끊임없이 계속 아파? 정말, 정말 유감이야, 마리...",shape=box,color=red];
		2267 -> 2271;
	2268 [label="듣는 약이 없어? 치료법도?",shape=box,color=red];
		2268 -> 2272;
	2270 [label="한 교구민께서 제게 \"고통스러우신가요? 항상요?\" 라고 물으신 적이 있어요. 그래서, \"Oui, monsieur. Je le suis.\" 라고 대답했지요. 그분의 표정에는 경악과 공포가 뒤섞여 있었어요.",shape=box,color=blue];
		2270 -> 2273;
	2271 [label="가끔, 앉아서 이렇게 극심한 agonie에 시달리지 않았다면 얼마나 많은 것들을 해낼 수 있었을까, 하고 생각해요, oui ? 만약 이렇게... 매순간 나를 가로막는 육신의 감옥에 갇혀 있지 않았다면 말이에요.",shape=box,color=blue];
		2271 -> 2274;
	2272 [label="그런게 있으면 좋겠지만. Mais non, 그런 건 없습니다. 제 시대에는 없고, 아마도 이 시대에도 없을 것 같아요.",shape=box,color=blue];
		2272 -> 2275;
	2273 [label="\"어떻게 버티시는 거에요?\" 라고 다음 질문을 던지셨죠. 그분께 미소를 지으며 \"저에게 다른 선택지가 있겠습니까, Monsieur...?\" 라고 대답했던 게 기억나네요.",shape=box,color=blue];
		2273 -> 2276;
		2273 -> 2277;
	2274 [label="이 얼마나 화나게 만드는 일인지 ! 태어나면서부터 육신에 배신당하지 않은 이들을 얼마나 질투했던지. 하지만 à part rendre nos vies plus amères, 그게 다 무슨 소용이 있겠어요 ? 더 원통하게 만들지 않을까요 ?",shape=box,color=blue];
		2274 -> 2278;
	2275 [label="종류에 따라서, 인간, 과학, 신앙으로는 치료할 수 없기도 하니까요.",shape=box,color=blue];
		2275 -> 2271;
	2276 [label="이것과 똑같은 대화를 여러 번 나누었어...",shape=box,color=red];
		2276 -> 2271;
	2277 [label="그렇지. 정말 유감이야.",shape=box,color=red];
		2277 -> 2279;
	2278 [label="Aucun. 저는 저답게 살고, 계속해서 노력할 것입니다.",shape=box,color=blue];
		2278 -> 2280;
	2279 [label="Non, 당신이 비슷한 agonie을 겪으셨다는 사실에 저도 유감스러울 뿐입니다. ",shape=box,color=blue];
		2279 -> 2271;
	2280 [label="Check boolean DrifterChronicPain",color=orange];
		2280 -> 2281 [label=true,color=green];
		2280 -> 2282 [label=false,color=brown];
	2281 [label="그리고 당신도 그러시겠죠. 그러실 거에요. 전 그걸 믿고 있으니까요.",shape=box,color=blue];
		2281 -> 2282;
	2282 [label="+20 Chemistry",color=orange];
		2282 -> 2283;
	2283 [label="이 대화가 제게 얼마나 큰 의미였는지 말로서 표현할 수가 없네요. 그러니 그냥 merci하다고만 말씀드리고 싶어요, 드리프터.",shape=box,color=blue];
		2283 -> 2284;
	2284 [label="Et encore merci.",shape=box,color=blue];
		2284 -> 2285;
	2285 [label="Chat ends.",color=orange];
}