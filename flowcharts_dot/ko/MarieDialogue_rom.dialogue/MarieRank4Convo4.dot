		j1249567230 -> j1124832805;
	j2084252351 [label="Si je le pouvais, je prendrais ce couteau qu'il aime tant utiliser pour agacer les autres et je le fourrerais là où seule Lua peut le voir !",shape=box,color=blue];
		j2084252351 -> j58706653;
	j199038099 [label="그럴지도요, 그렇지만 제 기분을 나아지게 만들려고 노력하시는 것 같네요. 그러니.. 더 이상은 캐묻지 않겠습니다.",shape=box,color=blue];
		j199038099 -> j710861372;
	j980032309 [label="제 기분을 나아지게 만들려고 거짓말을 하시는 것 같네요. 그러니... 더 이상은 캐묻지 않겠습니다.",shape=box,color=blue];
		j980032309 -> j710861372;
	j58706653 [label="죄송합니다. 그건... 부적절했어요. 전 une Soeur de Sol, 이런 식으로 화를 내거나 말을 내뱉어선 안 됩니다.",shape=box,color=blue];
		j58706653 -> j4071631946;
	j710861372 [label="+5 Chemistry",color=orange];
		j710861372 -> j3115148704;
	j4071631946 [label="+5 Chemistry",color=orange];
		j4071631946 -> j449254731;
	j3115148704 [label="이 대화에서 스스로를 용납할 수 있는 최소한의 존엄성을 지키고 싶어요.",shape=box,color=blue];
		j3115148704 -> j3638354535;
	j449254731 [label="제 분노는 당신께 향하는 것이 아니에요. 그리고 당신의 솔직함에 항상 감사드리고 있어요.",shape=box,color=blue];
		j449254731 -> j2671648276;
	j3638354535 [label="만약 당신이 M'sieur 태그퍼와 제가 벌인 다툼에 대해 대화하러 오신거라면, 그 다툼이 일어났다는 사실을 부인하진 않겠습니다.",shape=box,color=blue];
		j3638354535 -> j2671648276;
	j2671648276 [label="악마가 뭐 때문에 싸우게 됐는지 말씀드렸나요?",shape=box,color=blue];
		j2671648276 -> j370765590;
	j370765590 [label="Evaluate expressions",color=orange];
		j370765590 -> j4118458386 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j3127440579 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j3328792029 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j4118458386 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j4118458386 [label="false",color=purple];
		j370765590 -> j783303141 [label="false",color=purple];
	j4118458386 [label="로스가 말 안해줘도 뭔 일인지 알 수 있어. 엔트라티 관련이지.",shape=box,color=red];
		j4118458386 -> j2995720621;
	j3127440579 [label="알려줬어. 하지만 그 무엇보다도 당신을 더 걱정하는 것 같았어.",shape=box,color=red];
		j3127440579 -> j854223485;
	j3328792029 [label="알려줬어. 로스는 카비아에 대한 감정 때문에 이 상황을 걱정하는 것 같아. ",shape=box,color=red];
		j3328792029 -> j1986965449;
	j783303141 [label="아니, 이건 진짜야. 로스가 나보고 당신 확인해 보랬어.",shape=box,color=red];
		j783303141 -> j1838386477;
	j2995720621 [label="Oui. M'sieur 태그퍼와 le Cardinal에 관한 주제로 논쟁을 벌였습니다.",shape=box,color=blue];
		j2995720621 -> j644643376;
		j2995720621 -> j1553481725;
	j854223485 [label="악마가 왜 당신에게 그런 걸 믿게 하는지 모르겠네요. 그게 그 자에게 무슨 도움이 될지도 모르겠구요.",shape=box,color=blue];
		j854223485 -> j1009651575;
	j1986965449 [label="악마는 상처 입은 세 마리의 동물을 보고, 스스로가 가진 charisme를 이용해서 자신을 믿고 따르게 하는게 가능하다는 걸 알고 있습니다.",shape=box,color=blue];
		j1986965449 -> j3212307005;
	j1838386477 [label="악마가 왜 당신에게 그런 짓을 하게 하는지 모르겠네요. 그게 그자에게 무슨 도움이 될지도 모르겠구요.",shape=box,color=blue];
		j1838386477 -> j1639250035;
	j644643376 [label="태그퍼가 엔트라티의 지지자는 아니니까, 응.",shape=box,color=red];
		j644643376 -> j2206926980;
	j1553481725 [label="그 논쟁이 매우 시끄러웠을 거라고 생각이 드는데.",shape=box,color=red];
		j1553481725 -> j3747384480;
	j1009651575 [label="악마가 저에게 베푼다고 생각되는 모든 친절은 그자의 목적을 이루기 위한 행동들입니다. - 바로 저를 le Cardinal께 등 돌리게 하기 위함이죠. 전 알고 있다구요. ",shape=box,color=blue];
		j1009651575 -> j3697874266;
	j3212307005 [label="그자는 저에게 대항하기 위해 불리한 상황을 역전하고자 이런 짓을 합니다. 악마는 le Cardinal 대항하여 절 타락시키고 싶어 합니다. 제가 그분께 등을 돌리는 모습을 보고 싶어해요. 전 알고 있어요.",shape=box,color=blue];
		j3212307005 -> j3697874266;
	j1639250035 [label="하지만... 여기서 논의하고자 하는 건 그게 아니죠. 싸움은 le Cardinal을 두고 벌어졌습니다. ",shape=box,color=blue];
		j1639250035 -> j644643376;
		j1639250035 -> j1553481725;
	j2206926980 [label="그리고 이게 제가 이해가 가지 않는 부분들이에요 ! 그들이 받은 재능들을 보세요 !",shape=box,color=blue];
		j2206926980 -> j1545708336;
		j2206926980 -> j3288692685;
	j3747384480 [label="Oui ! 그는 절 stupide라고 불렀어요. 제가 한낱 어린애일 뿐이라고요.",shape=box,color=blue];
		j3747384480 -> j898327793;
		j3747384480 -> j1545708336;
	j3697874266 [label="그리고 M'sieur 태그퍼와 제가 논쟁을 벌였던 주제는 le Cardinal에 관한 것이었습니다.",shape=box,color=blue];
		j3697874266 -> j644643376;
		j3697874266 -> j1553481725;
	j1545708336 [label="제발 부탁이니, 처음부터 시작해줘. 싸움은 어떻게 시작된거야?",shape=box,color=red];
		j1545708336 -> j3738170307;
	j3288692685 [label="이제 왜 이 싸움이 일어났는지 알 수 있을 것 같네.",shape=box,color=red];
		j3288692685 -> j3738170307;
	j898327793 [label="정말 태그퍼가 당신을 멍청하고 어린애라고 불렀다고?",shape=box,color=red];
		j898327793 -> j247722049;
	j3738170307 [label="Oui. Le Cardinal에 대해서 언급하긴 했는데, 그게 뭔지는 모르겠어요. ",shape=box,color=blue];
		j3738170307 -> j2607827149;
	j247722049 [label="더 최악으로요, 아마도요.",shape=box,color=blue];
		j247722049 -> j238029861;
	j2607827149 [label="M'sieur 태그퍼가 곁눈질을 하며 코웃음을 쳤어요. 왜 그런 조롱을 하는지 이유를 물어봤죠.",shape=box,color=blue];
		j2607827149 -> j1324091674;
	j238029861 [label="\"넌 어린 새끼일 뿐이야, 마리 ! 순진하기 짝이 없어. 평생 남한테 생각이나 의존하고 살았겠지. 맹목적인 신앙이라는 이름의 작은 둥지 안에서 웅크리고 지냈으니까 !\"",shape=box,color=blue];
		j238029861 -> j2750578729;
	j1324091674 [label="\"알브레히트는 더럽고, 역겨운 거짓말쟁이야 !\"",shape=box,color=blue];
		j1324091674 -> j3848560948;
	j2750578729 [label="\"나이든 것들이 저들 좋을 대로 씹어내서 뱉은 말들을, 얼마든 속이라며 벌린 그 아가리로 주워먹고 살아남으면서 !\"",shape=box,color=blue];
		j2750578729 -> j471012429;
	j3848560948 [label="Et j'ai répondu, \"당신에게 주어진 선물들을 보세요 - 사고, 언어, 자아의 선물을요!\"",shape=box,color=blue];
		j3848560948 -> j2966542052;
	j471012429 [label="Boolean MarieEntrati3 is now true.",color=orange];
		j471012429 -> j309893046;
		j471012429 -> j2312007237;
		j471012429 -> j2153734977;
	j2966542052 [label="\"Le Cardinal께서 당신에게 내려주신 모든 축복에 감사하셔야 해요.\"",shape=box,color=blue];
		j2966542052 -> j255201681;
		j2966542052 -> j2028439785;
	j309893046 [label="태그퍼는 자기 입장에서만 알고 있어. 엔트라티의 진짜 동기나 의견은... 명확하게 설명되지 않았으니까.",shape=box,color=red];
		j309893046 -> j4018329402;
	j2312007237 [label="당신이 다른 사람에게 \"의존\"하는 것에 대해 어떻게 생각하는지 알고 있고, 태그퍼가 그렇게 표현한 것은 유감이라고 생각해.",shape=box,color=red];
		j2312007237 -> j1499929264;
	j2153734977 [label="태그퍼가 그런 생각을 하는데에는 충분한 이유가 있어.",shape=box,color=red];
		j2153734977 -> j946548047;
	j255201681 [label="그리고 태그퍼는 그걸 어떻게 받아들였는데?",shape=box,color=red];
		j255201681 -> j238029861;
	j2028439785 [label="오, 이런...",shape=box,color=red];
		j2028439785 -> j238029861;
	j4018329402 [label="+5 Chemistry",color=orange];
		j4018329402 -> j3059188037;
	j1499929264 [label="+5 Chemistry",color=orange];
		j1499929264 -> j988955766;
	j946548047 [label="Evaluate expressions",color=orange];
		j946548047 -> j2653558017 [label="MarieEntratiFamily",color=purple];
		j946548047 -> j3318290117 [label="MarieEntratiMonster1",color=purple];
		j946548047 -> j3318290117 [label="MarieEntratiMonster2",color=purple];
		j946548047 -> j100356865 [label="MarieEntratiFan1",color=purple];
		j946548047 -> j100356865 [label="MarieEntratiFan2",color=purple];
		j946548047 -> j4184153825 [label="MarieEntratiNeutral",color=purple];
		j946548047 -> j3445388323 [label="false",color=purple];
	j3059188037 [label="그래도 그에게는 그럴 권리가 없어요 ! 그 말들이 제게 얼마나 큰 상처를 주는지 그가 알고 있을지 모르겠네요. En outre -",shape=box,color=blue];
		j3059188037 -> j946548047;
	j988955766 [label="Merci, 그 말들이 제 마음 속을 얼마나 깊이 베었는지 헤아릴 수 없을 것 같아요.",shape=box,color=blue];
		j988955766 -> j1310152989;
		j988955766 -> j1715774051;
		j988955766 -> j1524899117;
	j2653558017 [label="이런게 le Cardinal께서 돌아오셨을 때 받을 수 있는 환대라면, 그분께서 돌아오시지 않는 것도 당연한 일이에요 !",shape=box,color=blue];
		j2653558017 -> j1086807997;
		j2653558017 -> j2101821543;
	j3318290117 [label="그리고 당신은 이 모든 일에 대해서 M'sieur 태그퍼의 편을 드시겠죠, non ? 당신은 le Cardinal을 그 짐승과 똑같이 괴물이라고 생각하잖아요.",shape=box,color=blue];
		j3318290117 -> j1086807997;
		j3318290117 -> j427160435;
	j100356865 [label="놀랍기 그지없네요, je pensais que tu étais de mon côté ! 저와 함께 le Cardinal의 대의명분을 옹호하시는 줄 알았는데요?",shape=box,color=blue];
		j100356865 -> j283950563;
	j4184153825 [label="전에도 말씀하셨듯이, 그게 다 무슨 상관인가요 ? 우린 그분의 행적을 따라 섬기고 나중에 심판해야 합니다. 이 싸움은 무의미해요, non ?",shape=box,color=blue];
		j4184153825 -> j1734266401;
		j4184153825 -> j2064441411;
	j3445388323 [label="그 존재들이 le Cardianl의 손에 의해 변모했다는 걸 압니다. 우리 모두 le Cardianl께서 내려주신 선물을 받았는데, 상처입은 마음으로 보면 저주일 뿐이군요 !",shape=box,color=blue];
		j3445388323 -> j3121160174;
	j1310152989 [label="그리고 당신 말이 태그퍼에게 얼마나 깊이 고통줬을지 알아? 카비아들 이야기 전부 알고 있어?",shape=box,color=red];
		j1310152989 -> j3445388323;
	j1715774051 [label="그리고 당신이 한 말도 태그퍼에게 똑같이 상처를 줬어.",shape=box,color=red];
		j1715774051 -> j3472482411;
	j1524899117 [label="솔직히 말해서, 난 당신 편이긴 한데... 우리는 평화를 유지하기 위해 노력해야 해, 마리.",shape=box,color=red];
		j1524899117 -> j1124665263;
		j1524899117 -> j3456164738;
	j1086807997 [label="마리, 제발. 당신이랑 싸울려고 하는 게 아니야. 그냥 그들이 겪은 일들을 당신이 이해해줬으면 하는거야.",shape=box,color=red];
		j1086807997 -> j2589112448;
	j2101821543 [label="엔트라티가 스스로 저지른 일들을 정리하는데 도움을 줬다면, 이 세상에는 그를 옹호하는 더 많은 친구들이 생겼을지도 모르지.",shape=box,color=red];
		j2101821543 -> j1393849870;
	j427160435 [label="맞아, 난 태그퍼 편을 들겠어. 왜냐면 당신은 이성의 목소리를 듣지 않으니까. 그 놈의 \"le Cardianl\"이 보이는 것과는 다르단 걸 이해해야 한다고.",shape=box,color=red];
		j427160435 -> j2589112448;
	j283950563 [label="이게 정말 당신이 하는 큰 속임수인가요 ? 꼬마 마리와 un jeu하고 계셨던 건가요 ?",shape=box,color=blue];
		j283950563 -> j1031933460;
		j283950563 -> j862631830;
	j1734266401 [label="이 모든 일이 끝나고 나면 우리 주변에 아무도 남지 않는다는 게 중요하지. 그들은 많은 걸 겪었어.",shape=box,color=red];
		j1734266401 -> j2589112448;
	j2064441411 [label="태그퍼도 곧 잊어버릴 거야. 당신도 분명 잊어버릴 거고.",shape=box,color=red];
		j2064441411 -> j2757659087;
	j3121160174 [label="우리 모두 그분께 버림받았죠 ! 어디 한번 말해봐요, 그들이 얼마나 더 큰 고통을 당했기에, 제가 이런 증오를 견뎌야 하는 거죠 ?!",shape=box,color=blue];
		j3121160174 -> j1639327012;
	j3472482411 [label="Oui ?! 그럼 이유를 말해 보세요 !",shape=box,color=blue];
		j3472482411 -> j3445388323;
	j1124665263 [label="카비아가 겪었던 상황들은... 고통스러워.",shape=box,color=red];
		j1124665263 -> j3445388323;
	j3456164738 [label="카비아들은 동물이야, 지능을 부여받았다고 해도, 여전히 동물이야. 그들이 할 수 일에는 한계라는 게 있어.",shape=box,color=red];
		j3456164738 -> j4025834813;
	j2589112448 [label="Oui ? 그럼 La Lumière Sacrée de Sol의 역할로서 어둠을 몰아내세요 ! 작고 어리석은 마리를 일깨워 보시라고요 !",shape=box,color=blue];
		j2589112448 -> j3445388323;
	j1393849870 [label="Oui, 맞아요. 그분께서 보이드의 신으로부터 우주를 구하려 한다는 것만으로도 충분하지 않나요, non ?!",shape=box,color=blue];
