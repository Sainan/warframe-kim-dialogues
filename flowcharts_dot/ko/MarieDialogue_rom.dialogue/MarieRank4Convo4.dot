		2375 -> 2383;
	2377 [label="당신이 말했었잖아. \"이름의 부재는 잔인함의 가장 궁극적인 형태\"라고. 엔트라티는 카비아들에게 이름을 붙이려고 하지 않았어. 그들에게 그만큼의 가치가 없다고 여겼으니까.",shape=box,color=red];
