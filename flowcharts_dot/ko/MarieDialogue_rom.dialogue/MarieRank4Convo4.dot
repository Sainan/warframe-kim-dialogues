		2344 -> 2350 [label="false",color=purple];
	2345 [label="그래도 그에게는 그럴 권리가 없어요 ! 그 말들이 제게 얼마나 큰 상처를 주는지 그가 알고 있을지 모르겠네요. En outre -",shape=box,color=blue];
		2345 -> 2344;
	2346 [label="Merci, 그 말들이 제 마음 속을 얼마나 깊이 베었는지 헤아릴 수 없을 것 같아요.",shape=box,color=blue];
		2346 -> 2352;
		2346 -> 2353;
		2346 -> 2354;
	2347 [label="이런게 le Cardinal께서 돌아오셨을 때 받을 수 있는 환대라면, 그분께서 돌아오시지 않는 것도 당연한 일이에요 !",shape=box,color=blue];
		2347 -> 2355;
		2347 -> 2356;
	2348 [label="그리고 당신은 이 모든 일에 대해서 M'sieur 태그퍼의 편을 드시겠죠, non ? 당신은 le Cardinal을 그 짐승과 똑같이 괴물이라고 생각하잖아요.",shape=box,color=blue];
		2348 -> 2357;
		2348 -> 2358;
	2349 [label="놀랍기 그지없네요, je pensais que tu étais de mon côté ! 저와 함께 le Cardinal의 대의명분을 옹호하시는 줄 알았는데요?",shape=box,color=blue];
		2349 -> 2359;
	2351 [label="전에도 말씀하셨듯이, 그게 다 무슨 상관인가요 ? 우린 그분의 행적을 따라 섬기고 나중에 심판해야 합니다. 이 싸움은 무의미해요, non ?",shape=box,color=blue];
		2351 -> 2361;
		2351 -> 2362;
	2350 [label="그 존재들이 le Cardianl의 손에 의해 변모했다는 걸 압니다. 우리 모두 le Cardianl께서 내려주신 선물을 받았는데, 상처입은 마음으로 보면 저주일 뿐이군요 !",shape=box,color=blue];
		2350 -> 2360;
	2352 [label="그리고 당신 말이 태그퍼에게 얼마나 깊이 고통줬을지 알아? 카비아들 이야기 전부 알고 있어?",shape=box,color=red];
		2352 -> 2350;
	2353 [label="그리고 당신이 한 말도 태그퍼에게 똑같이 상처를 줬어.",shape=box,color=red];
		2353 -> 2363;
	2354 [label="솔직히 말해서, 난 당신 편이긴 한데... 우리는 평화를 유지하기 위해 노력해야 해, 마리.",shape=box,color=red];
		2354 -> 2364;
		2354 -> 2365;
	2355 [label="마리, 제발. 당신이랑 싸울려고 하는 게 아니야. 그냥 그들이 겪은 일들을 당신이 이해해줬으면 하는거야.",shape=box,color=red];
		2355 -> 2366;
	2356 [label="엔트라티가 스스로 저지른 일들을 정리하는데 도움을 줬다면, 이 세상에는 그를 옹호하는 더 많은 친구들이 생겼을지도 모르지.",shape=box,color=red];
		2356 -> 2367;
	2357 [label="마리, 제발. 당신이랑 싸울려고 하는 게 아니야. 그냥 그들이 겪은 일들을 당신이 이해해줬으면 하는거야.",shape=box,color=red];
		2357 -> 2366;
	2358 [label="맞아, 난 태그퍼 편을 들겠어. 왜냐면 당신은 이성의 목소리를 듣지 않으니까. 그 놈의 \"le Cardianl\"이 보이는 것과는 다르단 걸 이해해야 한다고.",shape=box,color=red];
		2358 -> 2366;
	2359 [label="이게 정말 당신이 하는 큰 속임수인가요 ? 꼬마 마리와 un jeu하고 계셨던 건가요 ?",shape=box,color=blue];
		2359 -> 2368;
		2359 -> 2369;
	2361 [label="이 모든 일이 끝나고 나면 우리 주변에 아무도 남지 않는다는 게 중요하지. 그들은 많은 걸 겪었어.",shape=box,color=red];
		2361 -> 2366;
	2362 [label="태그퍼도 곧 잊어버릴 거야. 당신도 분명 잊어버릴 거고.",shape=box,color=red];
		2362 -> 2371;
	2360 [label="우리 모두 그분께 버림받았죠 ! 어디 한번 말해봐요, 그들이 얼마나 더 큰 고통을 당했기에, 제가 이런 증오를 견뎌야 하는 거죠 ?!",shape=box,color=blue];
		2360 -> 2370;
	2363 [label="Oui ?! 그럼 이유를 말해 보세요 !",shape=box,color=blue];
		2363 -> 2350;
	2364 [label="카비아가 겪었던 상황들은... 고통스러워.",shape=box,color=red];
		2364 -> 2350;
	2365 [label="카비아들은 동물이야, 지능을 부여받았다고 해도, 여전히 동물이야. 그들이 할 수 일에는 한계라는 게 있어.",shape=box,color=red];
		2365 -> 2372;
	2366 [label="Oui ? 그럼 La Lumière Sacrée de Sol의 역할로서 어둠을 몰아내세요 ! 작고 어리석은 마리를 일깨워 보시라고요 !",shape=box,color=blue];
		2366 -> 2350;
	2367 [label="Oui, 맞아요. 그분께서 보이드의 신으로부터 우주를 구하려 한다는 것만으로도 충분하지 않나요, non ?!",shape=box,color=blue];
		2367 -> 2373;
	2368 [label="아니야, 거짓말하는 게 아니야. 당신 생각에 동의해. 그냥 그들이 겪었던 상황이... 힘들었다는 걸 전하는 거야.",shape=box,color=red];
		2368 -> 2366;
	2369 [label="아니, 정확히는, 게임도 아니거든...? 엔트라티는 믿을 수 없고, 당신 편인 척 하는 것 외에는 어떻게 설득해야 할지를 모르겠어.",shape=box,color=red];
		2369 -> 2374;
	2371 [label="Non ! 당신이 이 대화를 시작했고, 이 대화를 계속하셔야 해요. Explique !",shape=box,color=blue];
