	2310 [label="로스가 말 안해줘도 뭔 일인지 알 수 있어. 엔트라티 관련이지.",shape=box,color=red];
		2310 -> 2314;
	2311 [label="알려줬어. 하지만 그 무엇보다도 당신을 더 걱정하는 것 같았어.",shape=box,color=red];
		2311 -> 2315;
	2309 [label="알려줬어. 로스는 카비아에 대한 감정 때문에 이 상황을 걱정하는 것 같아. ",shape=box,color=red];
		2309 -> 2313;
	2312 [label="아니, 이건 진짜야. 로스가 나보고 당신 확인해 보랬어.",shape=box,color=red];
		2312 -> 2316;
	2314 [label="Oui. M'sieur 태그퍼와 le Cardinal에 관한 주제로 논쟁을 벌였습니다.",shape=box,color=blue];
		2314 -> 2318;
		2314 -> 2319;
	2315 [label="악마가 왜 당신에게 그런 걸 믿게 하는지 모르겠네요. 그게 그 자에게 무슨 도움이 될지도 모르겠구요.",shape=box,color=blue];
		2315 -> 2320;
	2313 [label="악마는 상처 입은 세 마리의 동물을 보고, 스스로가 가진 charisme를 이용해서 자신을 믿고 따르게 하는게 가능하다는 걸 알고 있습니다.",shape=box,color=blue];
		2313 -> 2317;
	2316 [label="악마가 왜 당신에게 그런 짓을 하게 하는지 모르겠네요. 그게 그자에게 무슨 도움이 될지도 모르겠구요.",shape=box,color=blue];
		2316 -> 2321;
	2318 [label="태그퍼가 엔트라티의 지지자는 아니니까, 응.",shape=box,color=red];
		2318 -> 2323;
	2319 [label="그 논쟁이 매우 시끄러웠을 거라고 생각이 드는데.",shape=box,color=red];
		2319 -> 2324;
	2320 [label="악마가 저에게 베푼다고 생각되는 모든 친절은 그자의 목적을 이루기 위한 행동들입니다. - 바로 저를 le Cardinal께 등 돌리게 하기 위함이죠. 전 알고 있다구요. ",shape=box,color=blue];
		2320 -> 2322;
	2317 [label="그자는 저에게 대항하기 위해 불리한 상황을 역전하고자 이런 짓을 합니다. 악마는 le Cardinal 대항하여 절 타락시키고 싶어 합니다. 제가 그분께 등을 돌리는 모습을 보고 싶어해요. 전 알고 있어요.",shape=box,color=blue];
		2317 -> 2322;
	2321 [label="하지만... 여기서 논의하고자 하는 건 그게 아니죠. 싸움은 le Cardinal을 두고 벌어졌습니다. ",shape=box,color=blue];
		2321 -> 2318;
		2321 -> 2319;
	2323 [label="그리고 이게 제가 이해가 가지 않는 부분들이에요 ! 그들이 받은 재능들을 보세요 !",shape=box,color=blue];
		2323 -> 2325;
		2323 -> 2326;
	2324 [label="Oui ! 그는 절 stupide라고 불렀어요. 제가 한낱 어린애일 뿐이라고요.",shape=box,color=blue];
		2324 -> 2327;
		2324 -> 2325;
	2322 [label="그리고 M'sieur 태그퍼와 제가 논쟁을 벌였던 주제는 le Cardinal에 관한 것이었습니다.",shape=box,color=blue];
		2322 -> 2318;
		2322 -> 2319;
	2325 [label="제발 부탁이니, 처음부터 시작해줘. 싸움은 어떻게 시작된거야?",shape=box,color=red];
		2325 -> 2328;
	2326 [label="이제 왜 이 싸움이 일어났는지 알 수 있을 것 같네.",shape=box,color=red];
		2326 -> 2328;
	2327 [label="정말 태그퍼가 당신을 멍청하고 어린애라고 불렀다고?",shape=box,color=red];
		2327 -> 2329;
	2328 [label="Oui. Le Cardinal에 대해서 언급하긴 했는데, 그게 뭔지는 모르겠어요. ",shape=box,color=blue];
		2328 -> 2330;
	2329 [label="더 최악으로요, 아마도요.",shape=box,color=blue];
		2329 -> 2331;
	2330 [label="M'sieur 태그퍼가 곁눈질을 하며 코웃음을 쳤어요. 왜 그런 조롱을 하는지 이유를 물어봤죠.",shape=box,color=blue];
		2330 -> 2332;
	2331 [label="\"넌 어린 새끼일 뿐이야, 마리 ! 순진하기 짝이 없어. 평생 남한테 생각이나 의존하고 살았겠지. 맹목적인 신앙이라는 이름의 작은 둥지 안에서 웅크리고 지냈으니까 !\"",shape=box,color=blue];
		2331 -> 2333;
	2332 [label="\"알브레히트는 더럽고, 역겨운 거짓말쟁이야 !\"",shape=box,color=blue];
		2332 -> 2334;
	2333 [label="\"나이든 것들이 저들 좋을 대로 씹어내서 뱉은 말들을, 얼마든 속이라며 벌린 그 아가리로 주워먹고 살아남으면서 !\"",shape=box,color=blue];
		2333 -> 2335;
	2334 [label="Et j'ai répondu, \"당신에게 주어진 선물들을 보세요 - 사고, 언어, 자아의 선물을요!\"",shape=box,color=blue];
