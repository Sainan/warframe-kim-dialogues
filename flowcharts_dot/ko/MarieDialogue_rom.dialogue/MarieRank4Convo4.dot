		2370 -> 2375 [label="false",color=purple];
	2372 [label="만약 그들에 대한 동정심을 유발하고 분노를 당신에게 돌리려고 하는 거라면, 정말 그러고 싶다는 생각이 드네요.",shape=box,color=blue];
		2372 -> 2380;
	2373 [label="아마도 여기서 마무리짓는게 좋을 것 같군요. 우리 모두가 더 이상 화나기 전에 말이에요.",shape=box,color=blue];
		2373 -> 2381;
	2374 [label="Oui ? 글쎄요, 기쁜 마음으로 말씀드리는데, 당신은 실패하셨어요.",shape=box,color=blue];
		2374 -> 2382;
