		j323398698 -> j1249567230;
	j1124832805 [label="Bien sûr, ce salaud de diable ouvre sa bouche et vous raconte tout ! Il ne cherche qu'à m'embarrasser !",shape=box,color=blue];
		j1124832805 -> j2084252351;
