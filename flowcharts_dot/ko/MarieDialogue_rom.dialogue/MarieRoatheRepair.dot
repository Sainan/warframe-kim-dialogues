		j3498396436 -> j215779513;
	j126715472 [label="정말 정말 죄송해요. 기분 나쁘게 했다는 거 알아요. 그리고 그럴 의도는 없었어요. 저한테 있어서 정말로 하고 싶지 않은 일이었어요, 믿어주세요.",shape=box,color=red];
		j126715472 -> j2428934086;
	j4177712951 [label="Je vais le tuer ! Je savais que ce démon était rempli de la pire merde qui soit ! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses !",shape=box,color=blue];
		j4177712951 -> "Chat ends.";
	j792428479 [label="오래 머물지 않겠습니다. 당신이 없는 동안에도 이미 그자는 많은 설득력을 보여줬으니까요. 그리고 악마는 늘 그렇듯, 꽤나 잘 했어요.",shape=box,color=blue];
		j792428479 -> j1884046084;
	j215779513 [label="오래 머물지 않겠습니다. 당신이 없는 동안에도 이미 그자는 많은 설득력을 보여줬으니까요. 그리고 악마는 늘 그렇듯, 꽤나 잘 했어요.",shape=box,color=blue];
		j215779513 -> j1253397433;
	j2428934086 [label="그리고 이유가 뭐죠 ?",shape=box,color=blue];
		j2428934086 -> j3751673245;
		j2428934086 -> j1066271194;
	j1884046084 [label="그리고 인정해야겠군요. 제가... 이곳에 갇혀서 아무런 도움도 받지 못하는 것에 점점 지쳐가고 있다는 걸요.",shape=box,color=blue];
		j1884046084 -> j333249559;
	j1253397433 [label="하지만 그자의 말이 아니라 그자가 가진 영리함에 감사하셔야 해요. 그자는 저를 Monsieur 로이드와 앉혔고 얘길 나눌 수 있었습니다.",shape=box,color=blue];
		j1253397433 -> j3852896114;
		j1253397433 -> j3696288593;
	j3751673245 [label="[마음을 고백한다.] 왜냐하면 내가 당신을 진심으로 아끼기 때문이야, 마리. 당신을 사랑해.",shape=box,color=red];
		j3751673245 -> j4228498583;
