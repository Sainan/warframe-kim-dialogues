	j3696288593 [label="하지만 로이드는 알브레히트를 사랑하잖아. 안 그래?",shape=box,color=red];
		j3696288593 -> j3106418923;
	j2168641574 [label="내가 실언을 할 거라는 걸 알고 있었어. 그리고 놀랍게도, 그리 되어버렸어.",shape=box,color=red];
		j2168641574 -> j1630410668;
	j3656312146 [label="당신도 그자만큼이나 나쁘군요.",shape=box,color=blue];
		j3656312146 -> "Chat ends.";
	j3151953893 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3151953893 -> j2529015854;
	j593511449 [label="Monsieur 로이드의 맑은 시야 덕분에 제가 흐릿한 시야로 본다는 걸 알 수 있었어요. Monsieur 로이드는 le Cardinal - 그의 알브레히트 - 를 사랑하지만, 그럼에도 불구하고 그의 모든 결점을 그대로 보기 때문이죠.",shape=box,color=blue];
		j593511449 -> j2221659704;
	j3106418923 [label="네. 사랑하세요. 하지만 그럼에도 불구하고 le Cardinal의 모든 결점들을 보실 수 있습니다. 그리고 바로 그분의 맑은 시야 덕분에 제가 흐릿한 시야로 본다는 걸 알 수 있었어요.",shape=box,color=blue];
		j3106418923 -> j2221659704;
	j1630410668 [label="당신의 주의를 끌기 위해 로스에게 도움을 요청한 부분에 대해선 정말 미안하지만, 달리 누구에게 부탁해야 할지 몰랐어.",shape=box,color=red];
