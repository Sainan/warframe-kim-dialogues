	j1320415152 [label="드리프터. 악마에게 쫓기고 있어요. 그자의 작은 악마들 때문에 귀찮아 죽겠어요 ! 다 당신 때문이래요 ! 당신이 무릎 꿇고 사과하길 바랄거라고 그러더군요.",shape=box,color=blue];
