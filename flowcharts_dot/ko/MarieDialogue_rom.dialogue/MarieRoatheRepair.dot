	j2529015854 [label="Boolean MarieFamilyFail is now false.",color=orange];
		j2529015854 -> "Chat ends.";
	j2221659704 [label="다른 이를 사랑한다는 것은 그 상대의 모든 좋은 면과 나쁜 면을 있는 그대로 받아들이는 것이죠, après tout ?",shape=box,color=blue];
		j2221659704 -> j3722403271;
	j452115297 [label="오, 드리프터... 불쌍한 내 방랑자여. 제 용서를 구하기 위해 그리 애쓰실 필요 없어요. ",shape=box,color=blue];
