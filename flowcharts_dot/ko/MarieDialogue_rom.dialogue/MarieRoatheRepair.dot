	j1545566238 [label="드리프터. 악마에게 쫓기고 있어요. 그자의 작은 악마들 때문에 귀찮아 죽겠어요 ! 다 당신 때문이래요 ! Monsieur 로이드를 위층으로 데려가는 일에 제 도움을 원할거라고 그러던데요 ?",shape=box,color=blue];
