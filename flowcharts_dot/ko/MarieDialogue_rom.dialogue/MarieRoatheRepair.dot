		3824 -> 3828;
	3825 [label="맞아.",shape=box,color=red];
		3825 -> 3830;
	3826 [label="로스가 그랬어?",shape=box,color=red];
		3826 -> 3828;
	3827 [label="정말 정말 죄송해요. 기분 나쁘게 했다는 거 알아요. 그리고 그럴 의도는 없었어요. 저한테 있어서 정말로 하고 싶지 않은 일이었어요, 믿어주세요.",shape=box,color=red];
		3827 -> 3831;
	3828 [label="Je vais le tuer ! Je savais que ce démon était rempli de la pire merde qui soit ! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses !",shape=box,color=blue];
		3828 -> 3832;
	3829 [label="오래 머물지 않겠습니다. 당신이 없는 동안에도 이미 그자는 많은 설득력을 보여줬으니까요. 그리고 악마는 늘 그렇듯, 꽤나 잘 했어요.",shape=box,color=blue];
		3829 -> 3833;
	3830 [label="오래 머물지 않겠습니다. 당신이 없는 동안에도 이미 그자는 많은 설득력을 보여줬으니까요. 그리고 악마는 늘 그렇듯, 꽤나 잘 했어요.",shape=box,color=blue];
		3830 -> 3834;
	3831 [label="그리고 이유가 뭐죠 ?",shape=box,color=blue];
		3831 -> 3835;
		3831 -> 3836;
	3832 [label="Chat ends.",color=orange];
	3833 [label="그리고 인정해야겠군요. 제가... 이곳에 갇혀서 아무런 도움도 받지 못하는 것에 점점 지쳐가고 있다는 걸요.",shape=box,color=blue];
		3833 -> 3837;
	3834 [label="하지만 그자의 말이 아니라 그자가 가진 영리함에 감사하셔야 해요. 그자는 저를 Monsieur 로이드와 앉혔고 얘길 나눌 수 있었습니다.",shape=box,color=blue];
		3834 -> 3838;
		3834 -> 3839;
	3835 [label="[마음을 고백한다.] 왜냐하면 내가 당신을 진심으로 아끼기 때문이야, 마리. 당신을 사랑해.",shape=box,color=red];
		3835 -> 3840;
	3836 [label="신경쓰지마. 이건 분명 실수였으니까.",shape=box,color=red];
		3836 -> 3841;
	3837 [label="그러니, 아주 잘 해낼 거라고 생각합니다. 제가 도와드릴거니까요. 제 도움을 받게 되실 겁니다.",shape=box,color=blue];
		3837 -> 3842;
	3838 [label="오?",shape=box,color=red];
		3838 -> 3843;
	3839 [label="하지만 로이드는 알브레히트를 사랑하잖아. 안 그래?",shape=box,color=red];
		3839 -> 3844;
	3840 [label="내가 실언을 할 거라는 걸 알고 있었어. 그리고 놀랍게도, 그리 되어버렸어.",shape=box,color=red];
		3840 -> 3845;
	3841 [label="당신도 그자만큼이나 나쁘군요.",shape=box,color=blue];
		3841 -> 3846;
	3842 [label="Update boolean MarieFamilySuccess",color=orange];
		3842 -> 3847;
	3843 [label="Monsieur 로이드의 맑은 시야 덕분에 제가 흐릿한 시야로 본다는 걸 알 수 있었어요. Monsieur 로이드는 le Cardinal - 그의 알브레히트 - 를 사랑하지만, 그럼에도 불구하고 그의 모든 결점을 그대로 보기 때문이죠.",shape=box,color=blue];
		3843 -> 3848;
	3844 [label="네. 사랑하세요. 하지만 그럼에도 불구하고 le Cardinal의 모든 결점들을 보실 수 있습니다. 그리고 바로 그분의 맑은 시야 덕분에 제가 흐릿한 시야로 본다는 걸 알 수 있었어요.",shape=box,color=blue];
		3844 -> 3848;
	3845 [label="당신의 주의를 끌기 위해 로스에게 도움을 요청한 부분에 대해선 정말 미안하지만, 달리 누구에게 부탁해야 할지 몰랐어.",shape=box,color=red];
		3845 -> 3849;
	3846 [label="Chat ends.",color=orange];
	3847 [label="Update boolean MarieFamilyFail",color=orange];
		3847 -> 3850;
	3848 [label="다른 이를 사랑한다는 것은 그 상대의 모든 좋은 면과 나쁜 면을 있는 그대로 받아들이는 것이죠, après tout ?",shape=box,color=blue];
		3848 -> 3851;
	3849 [label="오, 드리프터... 불쌍한 내 방랑자여. 제 용서를 구하기 위해 그리 애쓰실 필요 없어요. ",shape=box,color=blue];
		3849 -> 3852;
