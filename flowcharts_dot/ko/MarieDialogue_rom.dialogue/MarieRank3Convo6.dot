	"MarieRank3Convo6 begins." [color=orange];
		"MarieRank3Convo6 begins." -> j299227742;
	j299227742 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j299227742 -> j3953133506;
	j3953133506 [label="당신께 질문을 하나 해야하는데, 그 질문으로 저라는 인간을 판단하지 않으시길 간청드립니다, 드리프터.",shape=box,color=blue];
		j3953133506 -> j1637839016;
		j3953133506 -> j1330945638;
		j3953133506 -> j3039724897;
	j1637839016 [label="요상한 상황에 있는 것 같네. 물론 그런걸로 당신을 판단하진 않겠지만서도.",shape=box,color=red];
		j1637839016 -> j3271221419;
	j1330945638 [label="최선을 다해볼게.",shape=box,color=red];
		j1330945638 -> j2638492888;
	j3039724897 [label="[종료.]",shape=box,color=red];
		j3039724897 -> "Chat ends.";
	j3271221419 [label="절 알지도, 뭘 적을려고 하는지도 모르는 상태에서 이리 Vraiment gentil하게 대해주시다니 감사할 따름이에요.",shape=box,color=blue];
		j3271221419 -> j1977446992;
	j2638492888 [label="+10 Chemistry",color=orange];
		j2638492888 -> j1592283119;
	"Chat ends." [color=orange];
	j1977446992 [label="그렇지만... 머리가 크면서도 말하는 물고기 때문에 골치가 아프지 않나요 ? 피보나치랬던가 ?",shape=box,color=blue];
		j1977446992 -> j2595677899;
		j1977446992 -> j714700952;
		j1977446992 -> j2430321065;
	j1592283119 [label="진심으로 감사합니다, 고마워요.",shape=box,color=blue];
		j1592283119 -> j1977446992;
	j2595677899 [label="응. 맞아, 완전히. 고마워.",shape=box,color=red];
		j2595677899 -> j3100122170;
	j714700952 [label="당신이 피보나치에게 짜증나 있다는 생각이 엄청나게 귀엽네.",shape=box,color=red];
		j714700952 -> j1848425602;
	j2430321065 [label="아니, 전혀. 난 피보나치를 좋아하거든.",shape=box,color=red];
		j2430321065 -> j3072869177;
	j3100122170 [label="저만 그런 게 아니어서 다행이네요. 하지만, 분명히 말씀드리자면, 그를 모욕할 의도는 추호도 없어요. 제가 지금 상황 때문에 기분이 안 좋지만서도, 피보나치도 최선을 다해 상황을 견뎌냈으리라 생각하니까요.",shape=box,color=blue];
		j3100122170 -> j1220055501;
	j1848425602 [label="오 ? 어떻게요? 다행이지만, 왜 그런지 이유를 모르겠네요. 제가 골머리를 앓는다는 건 매력적이진 않으니까요.",shape=box,color=blue];
		j1848425602 -> j3656364685;
		j1848425602 -> j446652386;
	j3072869177 [label="그럼 용서해 주시길 간청드릴 수 밖에 없네요. 모욕할 의도는 추호도 없었습니다. 제가 지금 상황 때문에 기분이 안 좋지만서도, 피보나치도 최선을 다해 상황을 견뎌냈으리라 생각하니까요.",shape=box,color=blue];
		j3072869177 -> j2789261956;
	j1220055501 [label="그의 길게 말하는 방식이 저와는 전혀 맞지 않는다는 거, c'est tout.",shape=box,color=blue];
		j1220055501 -> j437717284;
	j3656364685 [label="난 인생의 대부분을 목숨 걸고 싸우는 데 소모하고 있어. 이렇게 작게나마 인간성을 일깨워 주는 것이... 내가 살아가는 이유이기도 해.",shape=box,color=red];
		j3656364685 -> j3105612831;
	j446652386 [label="가끔은 한 발 물러서서 이 모든게 얼마나 어처구니가 없는 일인지 되돌아봐야 할 거 같아. 노그와 솔의 여사제라니...",shape=box,color=red];
		j446652386 -> j683518092;
	j2789261956 [label="그의 길게 말하는 방식이 저와는 전혀 맞지 않는다는 거, 그게 전부입니다.",shape=box,color=blue];
		j2789261956 -> j437717284;
	j437717284 [label="쳇. 불평해서는 안되겠네요. 오늘 밤 리온에게 저녁을 가져다줘야겠어요. 리온이 또 끔찍한 머리앓이에 시달리고 있거든요.",shape=box,color=blue];
		j437717284 -> j1921491996;
		j437717284 -> j887322761;
	j3105612831 [label="+5 Chemistry",color=orange];
		j3105612831 -> j4286370772;
	j683518092 [label="+5 Chemistry",color=orange];
		j683518092 -> j3244551231;
	j1921491996 [label="리온은 그거에 자주 시달려?",shape=box,color=red];
		j1921491996 -> j1014789701;
	j887322761 [label="잠깐만... 뭐라고?",shape=box,color=red];
		j887322761 -> j3547341;
	j4286370772 [label="당신의 그런 부분을 절대로 잃지 마세요, 드리프터. 삶의 불꽃을 찾는 당신의 그런 부분을 절대로 놓치지 마세요.",shape=box,color=blue];
		j4286370772 -> j1977614657;
	j3244551231 [label="세상에, 그리 말씀하시는 게 당연하네요. 아이가 할 법한 유치한 농담처럼 들리긴 하지만요, n'est-ce pas ?",shape=box,color=blue];
		j3244551231 -> j2846293026;
	j1014789701 [label="Oui, oui. 몇 주에 한 번 ? 두 달에 한 번 ? 제가 기억하기로, 리온이 가장 고통없이 지내던 기간은, 아마 6개월 정도였던 것 같아요.",shape=box,color=blue];
		j1014789701 -> j547018639;
	j3547341 [label="오 ! 이런. 흠. 일반적으로 골치가 아픈 걸 생각하시면 되는데, 훨씬 심한 상황인 거죠. 어떤 이들은 구토를 할 정도로 골머리가 아프다는데, 여성에게 더 흔하게 발생하는 증상이에요.",shape=box,color=blue];
		j3547341 -> j2391909519;
		j3547341 -> j3125625617;
	j1977614657 [label="세상은 어둡고 심각한 장소가 되고 싶어 안달이 나 있습니다. 모든 면에서 우리에게 고통을 안겨줄 준비가 되어 있지요.",shape=box,color=blue];
		j1977614657 -> j1389409677;
	j2846293026 [label="미래의 수녀, 신부 그리고 악마가 과거로 보내지고... 그리고 futur로 가서... 물고기, 사슴같은 존재, 거대한 새 그리고 집사와 만나죠...",shape=box,color=blue];
		j2846293026 -> j3471142308;
	j547018639 [label="Check boolean Megrim",color=orange];
		j547018639 -> j1234888794 [label=true,color=green];
		j547018639 -> j1477828157 [label=true,color=green];
		j547018639 -> j2244020540 [label=true,color=green];
		j547018639 -> j1234888794 [label=false,color=brown];
		j547018639 -> j1477828157 [label=false,color=brown];
		j547018639 -> j295972373 [label=false,color=brown];
	j2391909519 [label="지금은 \"편두통\" 이라고 부르는 것 같아.",shape=box,color=red];
		j2391909519 -> j661858984;
	j3125625617 [label="허. 머리앓이. 알려줘서 고마워.",shape=box,color=red];
		j3125625617 -> j1523975624;
	j1389409677 [label="우린 가능한 한 밝음과 경박함을 추구해야 해요, 필요하다면 유치함의 형태로라도 말이에요.",shape=box,color=blue];
		j1389409677 -> j2267903441;
	j3471142308 [label="정말 재밌네요, 당신 말이 맞는 것 같아요 !",shape=box,color=blue];
		j3471142308 -> j3921950398;
	j1234888794 [label="무슨 원인으로 아픈건지 궁금해지네.",shape=box,color=red];
		j1234888794 -> j1504803499;
	j1477828157 [label="되게 끔찍하네...",shape=box,color=red];
		j1477828157 -> j1446439102;
	j2244020540 [label="나도 머리앓이를 앓아. 정말 끔찍해.",shape=box,color=red];
		j2244020540 -> j352779475;
	j295972373 [label="나도 그런 종류의 두통이 있어. 정말 끔찍해.",shape=box,color=red];
		j295972373 -> j352779475;
	j661858984 [label="또 어떤 흥미로운 역사적 particularités들을 알아가게 될지 궁금하네요 ! 정말 신나요. 전 새로운 것들을 배우는 걸 정말 좋아하거든요. \"편두통.\" 앞으로 나아가는 길이 그렇게 멀지는 않은 것 같네요.",shape=box,color=blue];
		j661858984 -> j192241572;
	j1523975624 [label="Boolean Megrim is now true.",color=orange];
		j1523975624 -> j3768834229;
	j2267903441 [label="이제 리온도 같은 생각을 해준다면 좋겠지만요.",shape=box,color=blue];
		j2267903441 -> j260001137;
	j3921950398 [label="이제 제 소중한 리온도 같은 방식으로 밝음을 보면 좋겠지만요.",shape=box,color=blue];
		j3921950398 -> j260001137;
	j1504803499 [label="원인에는 리온만이 생각하는 이론이 있어요. ",shape=box,color=blue];
		j1504803499 -> j2917003732;
	j1446439102 [label="당신께서 위로의 말씀을 전하신다면 분명 환영받으시리라 생각합니다. 그리고 겉보기와는 달리, 리온은 그러한 행동에 감사함을 느낄 거에요.",shape=box,color=blue];
		j1446439102 -> j4121141783;
	j352779475 [label="당신도요 ? 리온에게 말씀해 주세요. 그도 다른 이들이 비슷한 고통을 겪을 수 있다는 걸 알아야 해요.",shape=box,color=blue];
		j352779475 -> j898219227;
	j192241572 [label="Boolean Migraine is now true.",color=orange];
		j192241572 -> j3768834229;
	j3768834229 [label="명칭이 어떻든간, 리온은 그 중 하나의 증상과 함께 엎드려 있고 아침까지 그러고 있겠죠. 불쌍한 그는 흐릿한 것 외에는 아무것도 볼 수 없고, 손발도 느낄 수 없어요. 그리고 고통을 참을 수 없다고도 말하죠.",shape=box,color=blue];
		j3768834229 -> j547018639;
	j260001137 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j260001137 -> j783435722;
	j2917003732 [label="하지만 최근까지 자신만의 이론을 가지고 있었다고 말하는 편이 더 정확할지도 모르겠네요.",shape=box,color=blue];
		j2917003732 -> j428906568;
	j4121141783 [label="리온의 태도가 당신을 설득하려 해도, 간곡히 부탁드리오니 마음을 다 잡아주세요, 드리프터. 냉정하고 냉혹해 보이는 겉모습 속에는 많은 도움을 필요로 하는 존재가 있으니까요.",shape=box,color=blue];
		j4121141783 -> j1141415925;
		j4121141783 -> j4118341669;
		j4121141783 -> j2674435821;
	j898219227 [label="+5 Chemistry",color=orange];
		j898219227 -> j3380123467;
	j783435722 [label="아, 말이 나와서 그런데요. 제 머리가 아프다는 거에 대해서 불평을 했다는 게 너무 죄송하네요. 오늘 밤 리온에게 저녁을 가져다줘야겠어요. 리온이 또 끔찍한 머리앓이에 시달리고 있거든요.",shape=box,color=blue];
		j783435722 -> j887322761;
		j783435722 -> j1921491996;
	j428906568 [label="Boolean MarieLyonFaith1 is now true.",color=orange];
		j428906568 -> j4121141783;
	j1141415925 [label="난 정말 고집이 센 편이니까. 걱정하지 마.",shape=box,color=red];
		j1141415925 -> j1114503530;
	j4118341669 [label="나한테 이미 벽 속의 남자가 한 명 있어... 두 명이라고 뭔 일이 있겠어?",shape=box,color=red];
		j4118341669 -> j1013283001;
	j2674435821 [label="리온도 다 큰 성인이잖아. 리온이 말하고자 하는 게 있으면, 말할 수도 있지.",shape=box,color=red];
		j2674435821 -> j1036945398;
	j3380123467 [label="광휘의 성체들께선 그런 방식이 아니라도 리온이라면 기꺼이 혼자서 고통을 겪을 거라는 걸 아세요...",shape=box,color=blue];
		j3380123467 -> j417548394;
	j1114503530 [label="+5 Chemistry",color=orange];
		j1114503530 -> j3458572513;
	j1013283001 [label="저한테 그런 식의 농담을 하셔도 되지만, 리온에게 그런 말은 하지 마세요. 당신의 Indifférence이라는 주제가 리온에게 있어서 몹시 아픈 주제니까요.",shape=box,color=blue];
		j1013283001 -> j3202830205;
	j1036945398 [label="리온은 다 큰 성인 남자요, 네. 그리고 저는 그가 대화를 원한다고 믿고 있어요. 그치만 리온이 대화를 할 수 있는지에 대해선 의문이 드네요.",shape=box,color=blue];
		j1036945398 -> j593594447;
	j417548394 [label="Boolean MarieLyonSuffering2 is now true.",color=orange];
		j417548394 -> j4121141783;
	j3458572513 [label="리온과 함께하실려면 그 고집이 필요하시라 생각해요. 고마워요, 드리프터. 그는 저에게 있어서 가장 소중한 친구이자 형제에요. 리온이 그리 고통스러워하는 모습을 보니 마음이 찢어지는 것 같아요.",shape=box,color=blue];
		j3458572513 -> j1438823964;
	j3202830205 [label="회복 탄력성을 가지세요. 인내심을 가지고 친절히 대해주세요. 리온은 제게 형제와도 같으며 가장 소중한 친구입니다, 드리프터. 리온이 그리 고통스러워하는 모습을 보니 마음이 찢어지는 것 같아요.",shape=box,color=blue];
		j3202830205 -> j1438823964;
	j593594447 [label="누구나가 모두 똑같은 재능을 가지고 있거나, 그런 것들을 누릴 자격이 있다고 생각하는 게 아닙니다. 리온은 고통받고 있으며, 고통받는 것이 자신의 운명이라고 믿고 있어요.",shape=box,color=blue];
		j593594447 -> j3380749601;
	j1438823964 [label="나중에 마저 이야기 하도록 해요. Par la grâce de Sol.",shape=box,color=blue];
		j1438823964 -> "Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j3380749601 [label="리온은 제게 형제와도 같고, 가장 소중한 친구이기도 합니다. 그리고 제 마음은 리온을 생각하면 가슴이 찢어지는 것 같아요. 제가 부탁드리고자 함은... 인내심을 갖고, 친절히 대해주시는 것뿐이에요. 만약 당신께서 그러실 수 있으시다면요.",shape=box,color=blue];
		j3380749601 -> j1438823964;
	"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
