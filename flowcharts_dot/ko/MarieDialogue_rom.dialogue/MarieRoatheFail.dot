	j1077909284 [label="로이드와 엔트라티 가문을 재결합시키기 위해 로스에게 도와달라고 설득하는 중이야. 근데 혈청 복용 부분에 고집 부리고 있어. 로스에게 얘기할려면 당신 도움이 필요해.",shape=box,color=red];
		j1077909284 -> j2376952565;
	j3287709060 [label="로스에게 변할 수 있는 힘이 있다는 걸 깨닫게 하려고. 과거에 저지른 일들을 용서할 수 있다는 거. 그러려면 당신 도움이 필요해.",shape=box,color=red];
		j3287709060 -> j3923286180;
	j1150411688 [label="로스는 스스로가 저지른 일들 때문에 속으로 자책하고 있어. 당신 도움 없이는, 자기 정체성을 받아들이지 않고 계속해서 스스로를 파괴할 것 같아 걱정이야.",shape=box,color=red];
		j1150411688 -> j3865352322;
	j1397127903 [label="로스가 혈청에 대한 진실을 알게 됐어. 스스로가 자발적으로 그걸 맞았다는 걸. 그리고 그 점이 스스로를 망가뜨리고 있어. 로스를 진정시키는 데 당신 도움이 필요해.",shape=box,color=red];
		j1397127903 -> j2376952565;
	j2495023303 [label="로스 때문에 미칠 것 같아. 어떻게 말을 걸어야 할지 모르겠어. 조언 좀 줄래?",shape=box,color=red];
		j2495023303 -> j2376952565;
	j2376952565 [label="Non, 그 악마와 대화하는 게 조금이라도 능숙했다면, 항상 제가 그 자에게 골 언어로 소리 지르고 있을 것 같나요 ?",shape=box,color=blue];
		j2376952565 -> j3001059741;
