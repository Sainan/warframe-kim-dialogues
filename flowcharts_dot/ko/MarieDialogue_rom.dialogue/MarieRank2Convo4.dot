	648 [label="단지 조심하시라고 당부드릴 뿐이에요. 루아를 매료시켜 하늘의 별도 따다줄 수 있는 사내라고, 저는 생각합니다.",shape=box,color=blue];
		648 -> 657;
	645 [label="무슨 목적으로 이해하느냐가 제 관심사입니다. 하지만 잔소리를 할 필요는 없겠지요.",shape=box,color=blue];
