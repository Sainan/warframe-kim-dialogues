		713 -> 717;
	714 [label="그래, 당신 이야기를 얘기해줘서 고마워. 그러니까 엔트라티는 로스에게... 용서받을 기회를 준 것일까? 타우에서의 일? 아니면 그냥 오로킨으로서?",shape=box,color=red];
