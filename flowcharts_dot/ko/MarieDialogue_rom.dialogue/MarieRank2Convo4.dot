		3907 -> 3909 [label=false,color=brown];
	702 [label="Le Cardinal께서 우리에게... 그 자의 영혼을 돌보라고 맡기신 걸까요 ? 아니면 그 자를 묶어놓는 사슬을 지켜보라고 맡기신 걸까요. Je préférerais le renvoyer en enfer.",shape=box,color=blue];
		702 -> 705;
