	602 [label="로스에 대해 물어봐도 될까? 아니면 물어보지 않는게 나을까?",shape=box,color=red];
		602 -> 605;
	601 [label="방 안에 있는 코끼리에 대해 물어봐도 될까?",shape=box,color=red];
