	711 [label="제가 그 자에 대해서 문제 삼는 건 작고 사랑스러운 동반자로서의 매력적인 본성은 전혀 없으면서 고양이로서의 살인적인 자존심은 모두 가지고 있기 때문입니다.",shape=box,color=blue];
		711 -> 716;
