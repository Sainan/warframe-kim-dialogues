	600 [label="[종료.]",shape=box,color=red];
		600 -> 603;
	605 [label="Ce diable est un imbécile qui se croit au-dessus de tout reproche ! Je préfèrerais boire un pot de vernis à bois plutôt que de passer une minute de plus à l'écouter s'enorgueillir comme un chat qui se lèche le pelage !",shape=box,color=blue];
		605 -> 607;
		605 -> 608;
	604 [label="Quoi! Où ça? Un éléphant ?!",shape=box,color=blue];
		604 -> 606;
	603 [label="Chat ends.",color=orange];
	607 [label="정말 창의적이었어.",shape=box,color=red];
		607 -> 610;
	608 [label="난... 그 중 어떤 표현도 친절하지 않는다고 생각할게.",shape=box,color=red];
		608 -> 611;
	606 [label="물고기, 새, 그리고 M'sieur 태그퍼가 뭔지는 모르겠지만요. 이 성역 안에 이상한 존재들이 많이 보이긴 하지만, éléphant는 없어요 - 혹시 농담하시는 건가요 ?",shape=box,color=blue];
		606 -> 609;
	610 [label="+5 Chemistry",color=orange];
		610 -> 614;
	611 [label="+5 Chemistry",color=orange];
		611 -> 615;
	609 [label="오! 미안. 1999년대 친구들이 가르쳐 준 표현이었어... ",shape=box,color=red];
		609 -> 612;
		609 -> 613;
	614 [label="Merci. 창의적이었지만, 질문을 하신거였죠. 제 분노가 당신을 향하게 해서는 안됐어요. 용서해 주세요.",shape=box,color=blue];
		614 -> 618;
	615 [label="전혀 아니었어요. 용서해 주세요, 그걸 지적하지 말았어야 했어요. ",shape=box,color=blue];
		615 -> 618;
	612 [label="내가 문자 그대로를 말한 건 아니었어.",shape=box,color=red];
		612 -> 616;
	613 [label="이제 왜 내가 혼란스러워할 때마다 걔네들이 이걸 귀엽다고 생각하는지 알겠네...",shape=box,color=red];
		613 -> 617;
	618 [label="Evaluate expressions",color=orange];
