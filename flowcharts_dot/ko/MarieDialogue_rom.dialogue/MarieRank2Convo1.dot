	390 [label="\"그럴 거야\"라고 말할 때, 당신은 누구를 가르키는 거죠 ? 당신, 아이, 악마, 심지어 Monsieur 로이드 아니면 le Cardinal까지... 당신들 뒤에는 수 세기가 펼쳐져 있어요.",shape=box,color=blue];
		390 -> 391;
	391 [label="루아가 우리를 데리러 오시기까지 얼마나 많은 세월들이 남았는지 궁금해 지네요. 그리고 그날이 오면 제가 얼마나 간절하게 그 분을 받아들일지 궁금하고요. 하지만 그건 제 믿음이지, 당신의 믿음이 아니에요.",shape=box,color=blue];
		391 -> 389;
	392 [label="아직은 잘 모르겠습니다. 착한 악마처럼, 자신의 계략을 숨기고 있겠죠. 하지만 그렇다고 신을 믿지는 않고요. 아마, 스스로를 제외하고 말이에요.",shape=box,color=blue];
		392 -> 389;
	393 [label="Non, 그렇지 않아요. 당신과 아주 비슷해요. 어떤 신도 믿지 않으니까요. 아마, 스스로를 제외하고 말이죠.",shape=box,color=blue];
		393 -> 389;
