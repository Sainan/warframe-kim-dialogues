		j645986701 -> j2908915590;
	j2289347873 [label="난 루아께 더 끌리는 것 같아.",shape=box,color=red];
		j2289347873 -> j2205026230;
	j964735580 [label="난 균형을 추구해. 그게 세상의 자연스러운 질서라고 생각하고.",shape=box,color=red];
		j964735580 -> j3179868163;
