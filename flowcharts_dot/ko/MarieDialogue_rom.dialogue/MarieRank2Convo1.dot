		j1976952066 -> j1529914782;
	j2516707265 [label="종종 Cathédrale의 성소에 앉아 배우러 오는 낯선 이들과 즐겁게 대화를 나누곤 하죠.",shape=box,color=blue];
		j2516707265 -> j407263905;
	j2112242313 [label="+5 Chemistry",color=orange];
		j2112242313 -> j1654979234;
	j2263615991 [label="+5 Chemistry",color=orange];
		j2263615991 -> j3346971977;
	j80746739 [label="+5 Chemistry",color=orange];
		j80746739 -> j4151968950;
	j2908915590 [label="Boolean DrifterFaithSol is now true.",color=orange];
		j2908915590 -> j2914704087;
	j2205026230 [label="Boolean DrifterFaithLua is now true.",color=orange];
		j2205026230 -> j822391131;
	j3179868163 [label="Boolean DrifterFaithBalance is now true.",color=orange];
		j3179868163 -> j3352187792;
	j1639923379 [label="Oui, je vois... 확신하려면 당신만의 \"증거\"가 필요한가요? 당신 삶에서 우리가 느끼는 믿음과 열정 같은 감정을 불러 일으키는 일은 없었던 건가요 ?",shape=box,color=blue];
		j1639923379 -> j3585801080;
		j1639923379 -> j2235772400;
	j3320754236 [label="Oui, c'est vrai - 그게 진실이죠. 신앙심은 수많은 영혼들이 묻는 수많은 질문들에 답해줍니다. 죽음 이후에 무슨 일이 일어날지 두렵진 않으신가요 ?",shape=box,color=blue];
		j3320754236 -> j1988272631;
		j3320754236 -> j1094924278;
	j1529914782 [label="Comme c'est fascinant... 그리고 이제 같은 말을 반복하는 사람이 두 명이나 생겼네요... 악마도 똑같은 말을 속삭였거든요.",shape=box,color=blue];
		j1529914782 -> j1234619572;
	j407263905 [label="우리의 신앙에 대해 너무나 궁금했으나, \"맞아요, 맞아. 그거야 말로 진실이에요.\"라고 말하고 싶진 않습니다. 우리 기쁨의 일부를 신들께서 가져가시길 바랄 뿐입니다.",shape=box,color=blue];
		j407263905 -> j210260866;
		j407263905 -> j1516118966;
	j1654979234 [label="Je comprends et c'est magnifique. 광휘의 성체들께서 다른 얼굴, 다른 이름을 가지고 있지는 않았는지 종종 궁금했어요.",shape=box,color=blue];
		j1654979234 -> j3453040478;
	j3346971977 [label="Oh, comme c'est fascinant ! 언젠가 당신의 신앙에 대해 배우고 싶네요. 당신의 의식에 대해서도 듣고 싶고요.",shape=box,color=blue];
		j3346971977 -> j2678181651;
		j3346971977 -> j2435649337;
	j4151968950 [label="Oh, comme c'est fascinant ! 언젠간 그 신앙에서 어떤 부분은 일치하면서도 어떤 부분은 어떻게 다른지에 대해 듣고 싶네요.",shape=box,color=blue];
		j4151968950 -> j2678181651;
		j4151968950 -> j2435649337;
	j2914704087 [label="+10 Chemistry",color=orange];
		j2914704087 -> j1153082444;
	j822391131 [label="+5 Chemistry",color=orange];
		j822391131 -> j2924720598;
	j3352187792 [label="+5 Chemistry",color=orange];
		j3352187792 -> j3023107608;
	j3585801080 [label="아니, 그냥 단순히 믿지 않을 뿐이야.",shape=box,color=red];
		j3585801080 -> j1418907036;
	j2235772400 [label="맞아. 난 한번도... 신앙심을 \"느껴본 적이 없어\". 필요했던 적도 없고.",shape=box,color=red];
		j2235772400 -> j3024339988;
	j1988272631 [label="모든 사람들은 죽어. 그걸 두려워하는 건 바보같은 짓이야. 우리 모두에게 찾아오는 결말이고. 아니 적어도... 그래야 하고.",shape=box,color=red];
		j1988272631 -> j329779631;
	j1094924278 [label="이미 충분히 죽어봤어. 그 뒤에 뭐가 일어날지 두렵지 않아. 그저 목 빠지게 기다릴 뿐이야.",shape=box,color=red];
		j1094924278 -> j1202351735;
	j1234619572 [label="+5 Chemistry",color=orange];
		j1234619572 -> j111727716;
	j210260866 [label="당신의 신앙을 믿지 않는 사람들에게 마음을 연다는 점이 조금 놀랍네.",shape=box,color=red];
		j210260866 -> j3271056547;
	j1516118966 [label="바로 그거야. 난 어느 쪽이 \"옳다\"거나 \"틀렸다\"고 말하고 싶지 않거든.",shape=box,color=red];
		j1516118966 -> j4161806428;
	j3453040478 [label="그분들께서는 다른 종파의 추종자들을 기쁘게 하기 위해 형체를 바꾸는 것으로 알려져 있습니다. 하지만 그건 제 신앙이지, 당신의 신앙이 아니니까요.",shape=box,color=blue];
		j3453040478 -> j4142366506;
	j2678181651 [label="그거 좋겠는데.",shape=box,color=red];
		j2678181651 -> j1171942277;
	j2435649337 [label="당신이 다른 종교에 열린 마음을 가지고 있다는 게 놀랍네. ",shape=box,color=red];
		j2435649337 -> j2014247266;
	j1153082444 [label="제 마음에 꼭 드는 방랑자이시군요 ! 제 얼굴에 미소를 가져다 주시네요. 절 기분 좋게 할려고 거짓말하신 건 아니었으면 좋겠어요.",shape=box,color=blue];
		j1153082444 -> j93828870;
	j2924720598 [label="아, 제 소중한 리온처럼 밤의 길을 걷는 방랑자이시군요. 리온이 준비됐을 때, 어둠의 여신께서 지나오신 행적을 말해주면 정말로 크게 기뻐할거에요.",shape=box,color=blue];
		j2924720598 -> j93828870;
	j3023107608 [label="우유부단함 없이 균형을 선택하셨군요. 언제 태양이 떠야 하고, 언제 달이 태양에 응답해야 하는 지 아는 것, 하지만 결코 의심에 빠지지 않고 기도하는 것 말이죠 ?",shape=box,color=blue];
		j3023107608 -> j1883290786;
	j1418907036 [label="+5 Chemistry",color=orange];
		j1418907036 -> j2387279919;
	j3024339988 [label="+5 Chemistry",color=orange];
		j3024339988 -> j2177680351;
	j329779631 [label="+5 Chemistry",color=orange];
		j329779631 -> j958568465;
	j1202351735 [label="+5 Chemistry",color=orange];
		j1202351735 -> j2932029916;
	j111727716 [label="그 사람에게 조금이라도 믿음이 있다는 게 가슴이 미어집니다만, 이 일에 관해선 어떨까요 ? 그에게 직접 말을 걸어보셔야 할 것 같아요. 다만 조심하세요. 악마는 위험한 게임을 하니까요.",shape=box,color=blue];
		j111727716 -> j866596882;
		j111727716 -> j77553792;
	j3271056547 [label="확실하게, 이런 옷을 입고 있으면서, 다른 이들에게 엄격한 기대를 갖지 않는 건 의외일지도요. 위로를 원치 않은 이들에게 설교를 전하면, 큰 사랑을 얻지 못한다는 점을 저도 잘 알고 있습니다.",shape=box,color=blue];
		j3271056547 -> j2359833571;
	j4161806428 [label="+5 Chemistry",color=orange];
		j4161806428 -> j2029893266;
	j4142366506 [label="전 단지 당신의 신앙이 당신께 평화를 가져다주길 바랍 뿐입니다만 ?",shape=box,color=blue];
		j4142366506 -> j3837526094;
		j4142366506 -> j3140658905;
		j4142366506 -> j957453623;
	j1171942277 [label="Ô joie ! 전 배우는 걸 정말 좋아해서요. 광휘의 성체들께서 다른 얼굴, 다른 이름을 가지고 있지는 않았는지 종종 궁금했어요.",shape=box,color=blue];
		j1171942277 -> j876107562;
	j2014247266 [label="확실하게, 이런 옷을 입고 있으면서, 다른 이들에게 엄격한 기대를 갖지 않는 건 의외일지도요. 위로를 원치 않은 이들에게 설교를 전하면, 큰 사랑을 얻지 못한다는 점을 저도 잘 알고 있습니다.",shape=box,color=blue];
		j2014247266 -> j2670360158;
	j93828870 [label="단순한 궁금증입니다만, 우리의 믿음이 당신께 평화를 가져다 주나요 ?",shape=box,color=blue];
		j93828870 -> j3837526094;
		j93828870 -> j3140658905;
		j93828870 -> j957453623;
	j1883290786 [label="그건 정말 보기 드문 재능입니다... 그리고 당신께서 그 재능을 발휘하시길 바라고요. 갈림길에서 너무 오래 머무르는 건 갈등에 휩쓸리는 것일지도 모른다는 생각이 드니까요.",shape=box,color=blue];
		j1883290786 -> j3979458986;
	j2387279919 [label="그럼, 삶이 더 단순하겠네요. 신과 성당의 규칙에 따라 살지 않는 것. 솔직히 좀 질투가 나네요.",shape=box,color=blue];
		j2387279919 -> j3796832343;
	j2177680351 [label="그렇다면, 당신이 부럽네요. 방랑자씨 ! 신들을 알 필요도 없이, 그리 오랜 세월을 살아오셨으니.",shape=box,color=blue];
		j2177680351 -> j3796832343;
	j958568465 [label="루아의 제자처럼 들리고, 기분 나쁘게 말하려는 건 아닙니다. Oui, 노파께서 우리 모두를 위해 오시고 은빛 눈물을 흘리십니다. 하지만 당신 말을 들으니 더 궁금해져요...",shape=box,color=blue];
		j958568465 -> j179401219;
	j2932029916 [label="Oui, 궁금해지네요. 당신, 아이, 악마, 심지어 Monsieur 로이드 아니면 le Cardinal까지... 당신들 뒤에는 수 세기가 펼쳐져 있어요.",shape=box,color=blue];
		j2932029916 -> j2688864263;
	j866596882 [label="어떤 종류의 위험한 게임?",shape=box,color=red];
		j866596882 -> j3767215795;
	j77553792 [label="그는 벽 속의 남자가 실제 인물이라고 생각하지 않는 거야, 그치?",shape=box,color=red];
		j77553792 -> j55588928;
	j2359833571 [label="+5 Chemistry",color=orange];
		j2359833571 -> j1608714012;
	j2029893266 [label="다른 이들의 신념에 대한 당신의 지혜와 친절함에 미소가 지어지네요.",shape=box,color=blue];
		j2029893266 -> j220824647;
	j3837526094 [label="실제로 그렇지 않아.",shape=box,color=red];
		j3837526094 -> j2061334035;
	j3140658905 [label="솔직히 그 점에 대해선 많이 생각하지 않아.",shape=box,color=red];
		j3140658905 -> j1687803327;
	j957453623 [label="실제로 그래.",shape=box,color=red];
		j957453623 -> j3499250694;
	j876107562 [label="그분들께서는 다른 종파의 추종자들을 기쁘게 하기 위해 형체를 바꾸는 것으로 알려져 있습니다. 하지만 그건 제 신앙이지, 당신의 신앙이 아니니까요. 위로를 구하지 않는 이들에게 설교하지 않겠습니다. 그런 설교는 큰 사랑을 받지 못한다는 걸 알았으니까요.",shape=box,color=blue];
		j876107562 -> j2670360158;
	j2670360158 [label="아니요, 제 믿음은 저의 것이고, 당신의 믿음은 당신 것이죠. 그저 신앙이 당신께 평화를 가져다 주는지 궁금할 뿐입니다만 ?",shape=box,color=blue];
		j2670360158 -> j3837526094;
		j2670360158 -> j3140658905;
		j2670360158 -> j957453623;
	j3979458986 [label="결국, 모든 이들은 스스로가 걸어나가야 하는 길을 선택해야 합니다. 하지만 갈림길은 우리 모두가 시작해야 하는 곳이며, 균형은 모든 구조의 토대입니다.",shape=box,color=blue];
		j3979458986 -> j128047621;
	j3796832343 [label="하지만, 궁금하네요... 믿지 않는 것, 그 점이 당신께 평화를 가져다 주나요 ?",shape=box,color=blue];
		j3796832343 -> j3837526094;
		j3796832343 -> j3140658905;
		j3796832343 -> j957453623;
	j179401219 [label="\"그럴 거야\"라고 말할 때, 당신은 누구를 가르키는 거죠 ? 당신, 아이, 악마, 심지어 Monsieur 로이드 아니면 le Cardinal까지... 당신들 뒤에는 수 세기가 펼쳐져 있어요.",shape=box,color=blue];
		j179401219 -> j2688864263;
	j2688864263 [label="루아가 우리를 데리러 오시기까지 얼마나 많은 세월들이 남았는지 궁금해 지네요. 그리고 그날이 오면 제가 얼마나 간절하게 그 분을 받아들일지 궁금하고요. 하지만 그건 제 믿음이지, 당신의 믿음이 아니에요.",shape=box,color=blue];
		j2688864263 -> j3796832343;
	j3767215795 [label="아직은 잘 모르겠습니다. 착한 악마처럼, 자신의 계략을 숨기고 있겠죠. 하지만 그렇다고 신을 믿지는 않고요. 아마, 스스로를 제외하고 말이에요.",shape=box,color=blue];
		j3767215795 -> j3796832343;
	j55588928 [label="Non, 그렇지 않아요. 당신과 아주 비슷해요. 어떤 신도 믿지 않으니까요. 아마, 스스로를 제외하고 말이죠.",shape=box,color=blue];
		j55588928 -> j3796832343;
	j1608714012 [label="Non, 열린 마음으로 찾아오는 이들은 누구나 환영받을 겁니다.",shape=box,color=blue];
		j1608714012 -> j220824647;
	j220824647 [label="단순한 궁금증입니다만, 그 점이 당신께 평화를 가져다 주나요 ?",shape=box,color=blue];
		j220824647 -> j3837526094;
