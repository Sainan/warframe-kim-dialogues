	351 [label="맞아. 난 한번도... 신앙심을 \"느껴본 적이 없어\". 필요했던 적도 없고.",shape=box,color=red];
		351 -> 364;
	352 [label="모든 사람들은 죽어. 그걸 두려워하는 건 바보같은 짓이야. 우리 모두에게 찾아오는 결말이고. 아니 적어도... 그래야 하고.",shape=box,color=red];
		352 -> 365;
	353 [label="이미 충분히 죽어봤어. 그 뒤에 뭐가 일어날지 두렵지 않아. 그저 목 빠지게 기다릴 뿐이야.",shape=box,color=red];
		353 -> 366;
	354 [label="+5 Chemistry",color=orange];
