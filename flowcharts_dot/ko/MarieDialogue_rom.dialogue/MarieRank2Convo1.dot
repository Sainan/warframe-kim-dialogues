	344 [label="Update boolean DrifterFaithBalance",color=orange];
		344 -> 357;
	339 [label="Oui, je vois... 확신하려면 당신만의 \"증거\"가 필요한가요? 당신 삶에서 우리가 느끼는 믿음과 열정 같은 감정을 불러 일으키는 일은 없었던 건가요 ?",shape=box,color=blue];
		339 -> 350;
		339 -> 351;
	340 [label="Oui, c'est vrai - 그게 진실이죠. 신앙심은 수많은 영혼들이 묻는 수많은 질문들에 답해줍니다. 죽음 이후에 무슨 일이 일어날지 두렵진 않으신가요 ?",shape=box,color=blue];
		340 -> 352;
		340 -> 353;
	341 [label="Comme c'est fascinant... 그리고 이제 같은 말을 반복하는 사람이 두 명이나 생겼네요... 악마도 똑같은 말을 속삭였거든요.",shape=box,color=blue];
		341 -> 354;
	338 [label="우리의 신앙에 대해 너무나 궁금했으나, \"맞아요, 맞아. 그거야 말로 진실이에요.\"라고 말하고 싶진 않습니다. 우리 기쁨의 일부를 신들께서 가져가시길 바랄 뿐입니다.",shape=box,color=blue];
		338 -> 348;
		338 -> 349;
	360 [label="Je comprends et c'est magnifique. 광휘의 성체들께서 다른 얼굴, 다른 이름을 가지고 있지는 않았는지 종종 궁금했어요.",shape=box,color=blue];
		360 -> 373;
	358 [label="Oh, comme c'est fascinant ! 언젠가 당신의 신앙에 대해 배우고 싶네요. 당신의 의식에 대해서도 듣고 싶고요.",shape=box,color=blue];
		358 -> 371;
		358 -> 372;
	359 [label="Oh, comme c'est fascinant ! 언젠간 그 신앙에서 어떤 부분은 일치하면서도 어떤 부분은 어떻게 다른지에 대해 듣고 싶네요.",shape=box,color=blue];
