	348 [label="당신의 신앙을 믿지 않는 사람들에게 마음을 연다는 점이 조금 놀랍네.",shape=box,color=red];
		348 -> 361;
	349 [label="바로 그거야. 난 어느 쪽이 \"옳다\"거나 \"틀렸다\"고 말하고 싶지 않거든.",shape=box,color=red];
		349 -> 362;
	373 [label="그분들께서는 다른 종파의 추종자들을 기쁘게 하기 위해 형체를 바꾸는 것으로 알려져 있습니다. 하지만 그건 제 신앙이지, 당신의 신앙이 아니니까요.",shape=box,color=blue];
		373 -> 386;
	371 [label="그거 좋겠는데.",shape=box,color=red];
		371 -> 384;
	372 [label="당신이 다른 종교에 열린 마음을 가지고 있다는 게 놀랍네. ",shape=box,color=red];
		372 -> 385;
	368 [label="제 마음에 꼭 드는 방랑자이시군요 ! 제 얼굴에 미소를 가져다 주시네요. 절 기분 좋게 할려고 거짓말하신 건 아니었으면 좋겠어요.",shape=box,color=blue];
		368 -> 382;
	369 [label="아, 제 소중한 리온처럼 밤의 길을 걷는 방랑자이시군요. 리온이 준비됐을 때, 어둠의 여신께서 지나오신 행적을 말해주면 정말로 크게 기뻐할거에요.",shape=box,color=blue];
		369 -> 382;
	370 [label="우유부단함 없이 균형을 선택하셨군요. 언제 태양이 떠야 하고, 언제 달이 태양에 응답해야 하는 지 아는 것, 하지만 결코 의심에 빠지지 않고 기도하는 것 말이죠 ?",shape=box,color=blue];
		370 -> 383;
	363 [label="+5 Chemistry",color=orange];
		363 -> 376;
