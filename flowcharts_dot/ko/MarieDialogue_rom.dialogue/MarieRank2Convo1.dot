	j1633429017 [label="Merci, merci ! 방금 주신 말씀이 제 믿음에 큰 힘이 되었어요. 그 믿음을 허비하지 않을게요. 그럼 이만.",shape=box,color=blue];
		j1633429017 -> "Chat ends.";
	j1497557254 [label="완전히 이해하고, 기분 나쁘지도 않아요. 제 이야기를 들어주셔서 감사하고, 나눠주신 이야기들에도 감사드립니다. 다른 주제에 대해서 이야기해 볼까 하는데, 솔께서도 우리가 충분히 이야기를 나눴다는 걸 알고 계실 거에요 !",shape=box,color=blue];
		j1497557254 -> "Chat ends.";
