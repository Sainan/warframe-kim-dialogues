digraph {
	302 [label="MarieRank2Convo1 begins.",color=orange];
		302 -> 303;
	303 [label="제가 무례하게 질문한다고 생각치 않으셨으면 좋겠지만, 정말 너무나 궁금해서요. 광휘의 성체들이나 아니면 다른 존재에 대한 신앙심 갖고 계신가요 ?",shape=box,color=blue];
		303 -> 3898;
		303 -> 3899;
		303 -> 3900;
	3898 [label="만약에 당신에게 관심 있다고 말하면 어떻게 돼? 신성모독에 해당되나?",shape=box,color=red];
		3898 -> 3902;
	3899 [label="아니, 전혀 무례하지 않아.",shape=box,color=red];
		3899 -> 308;
		3899 -> 307;
		3899 -> 306;
		3899 -> 305;
		3899 -> 304;
	3900 [label="[종료.]",shape=box,color=red];
		3900 -> 3901;
	3902 [label="Update boolean DrifterMarie",color=orange];
		3902 -> 3903;
	308 [label="그건... 복잡해. 어떤 존재가 있다고는 믿지만, 그렇다고 해서 딱히 정해진 신앙은 없어.",shape=box,color=red];
		308 -> 313;
	307 [label="응, 맞아. 믿고 있는 신앙이 있긴 한데, 당신이 알 법한 신앙은 아니야.",shape=box,color=red];
		307 -> 312;
	306 [label="광휘의 성체들을 믿는 것 같아, 당신처럼 말이야.",shape=box,color=red];
		306 -> 311;
	305 [label="아니, 없어. 신들을 믿지 않아. 우리가 아직 이해하지 못하는 과학만을 믿지.",shape=box,color=red];
		305 -> 310;
	304 [label="솔직히, 잘 모르겠어. 대답을 가지기엔 세상이 너무 복잡한 것 같아.",shape=box,color=red];
		304 -> 309;
	3901 [label="Chat ends.",color=orange];
	3903 [label="아, oui ? 이게 뭔 말이죠? Quelle audace, 당신의 그런 질문에 솔직히 놀랐어요 ! 전혀 예상도 못했거든요...",shape=box,color=blue];
		3903 -> 3904;
	313 [label="Update boolean DrifterFaithPersonal",color=orange];
		313 -> 318;
	312 [label="+5 Chemistry",color=orange];
		312 -> 317;
	311 [label="+5 Chemistry",color=orange];
		311 -> 316;
	310 [label="+5 Chemistry",color=orange];
		310 -> 315;
	309 [label="Update boolean DrifterFaithAgnostic",color=orange];
		309 -> 314;
	3904 [label="근데 내 주의를 돌리려 하고 있군요 ! 반대하진 않지만, 그런 일은 아직 너무 이르잖아요, n'est pas ?",shape=box,color=blue];
		3904 -> 3905;
	318 [label="+5 Chemistry",color=orange];
		318 -> 326;
	317 [label="어떠한 이름으로 불리든 전 신앙에서 아름다움을 찾는 답니다. 말해 주세요, 그건 새로운 신앙인가요 ? 아니면 오래된 건가요 ? 제가 그걸 인지할 수 있나요 ?",shape=box,color=blue];
		317 -> 324;
		317 -> 325;
	316 [label="당신도요 ?! Oh, comme c'est fascinant ! 먼 미래에서까지 누군가가 믿음을 지킨다고 생각하니, cela remplit mon coeur de joie. 기쁨으로 제 심장이 두근거려요. 하지만 과거에서 보낸 시간이 영향을 끼친 건 아닐까요 ? 아, 상관 없겠지요.",shape=box,color=blue];
		316 -> 323;
	315 [label="그 답변을 존중합니다. 하지만 묻고 싶은 게 있어요. 어떻게 그렇게 확신하시죠? 그것 자체가 일종의 신앙심 아닌가요? 그리고 이게... 당신의 무심이라는 존재가 신이 아니라면요 ?",shape=box,color=blue];
		315 -> 320;
		315 -> 321;
		315 -> 322;
	314 [label="+10 Chemistry",color=orange];
		314 -> 319;
	3905 [label="저는...제 질문에 대한 답변이 듣고 싶은데, s'il vous plait, 당신만 괜찮으시다면요. 그런데 지금 당신 때문에 얼굴이 새빨개졌어요 !",shape=box,color=blue];
		3905 -> 308;
		3905 -> 307;
		3905 -> 306;
		3905 -> 305;
		3905 -> 304;
	326 [label="아, oui. 방랑자, 그게 바로 당신의 이름이었죠. 수많은 문화, 수많은 신앙, 수많은 세상을 보았을 거에요. Cela est très spirituel, non ? 마치 조개껍데기처럼 일부들만 모은거겠네요.",shape=box,color=blue];
		326 -> 336;
		326 -> 337;
	324 [label="전혀 인지할 수 없을 거야.",shape=box,color=red];
		324 -> 334;
	325 [label="일부는 인지할 수도 있겠지만, 다른 부분은 전혀 낯설 수도 있어.",shape=box,color=red];
		325 -> 335;
	323 [label="당신은 어느 쪽에 더 헌신적일지 궁금하네요. 아니면 균형을 추구하시나요 ?",shape=box,color=blue];
		323 -> 331;
		323 -> 332;
		323 -> 333;
	320 [label="내가 옳다고 확신할 수는 없어. 누구도 옳을 수는 없으니까. 하지만 개인적으론 신을 믿지 않아.",shape=box,color=red];
		320 -> 328;
	321 [label="난 종교가 죽음과 미지에 대한 두려움으로 인해 사람들의 삶에 생긴 공허함을 메우기 위해 존재한다고 생각해.",shape=box,color=red];
		321 -> 329;
	322 [label="무심이 어떤 존재인지는 모르지만, 신은 아니야. 그냥 그 존재의 원인을 밝혀내야 할 뿐. ",shape=box,color=red];
		322 -> 330;
	319 [label="아, 어쩌면 가장 현명한 대답일지도 모르겠네요! 우린 필멸자이지만 - 아직 그리 말할 수 있는지도 모르지만 - 신들의 계획을 이끌어낼 수 있다고 말할 수 있을까요 ?",shape=box,color=blue];
		319 -> 327;
	336 [label="우리 모두에게 말을 건네는, 더 오래되고, 더 진실되면서도, 더 깊은 무언가가 있다고 생각해. 일종의 연결 조직처럼.",shape=box,color=red];
		336 -> 347;
	337 [label="정확해. 난 그 모든 것에서 아름다움을 보니까, 누가 옳고 그르다고 말할 수 없어.",shape=box,color=red];
		337 -> 347;
