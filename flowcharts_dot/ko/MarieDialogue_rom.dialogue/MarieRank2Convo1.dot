		386 -> 394;
		386 -> 395;
		386 -> 396;
	384 [label="Ô joie ! 전 배우는 걸 정말 좋아해서요. 광휘의 성체들께서 다른 얼굴, 다른 이름을 가지고 있지는 않았는지 종종 궁금했어요.",shape=box,color=blue];
		384 -> 398;
	385 [label="확실하게, 이런 옷을 입고 있으면서, 다른 이들에게 엄격한 기대를 갖지 않는 건 의외일지도요. 위로를 원치 않은 이들에게 설교를 전하면, 큰 사랑을 얻지 못한다는 점을 저도 잘 알고 있습니다.",shape=box,color=blue];
		385 -> 399;
	382 [label="단순한 궁금증입니다만, 우리의 믿음이 당신께 평화를 가져다 주나요 ?",shape=box,color=blue];
		382 -> 394;
		382 -> 395;
		382 -> 396;
	383 [label="그건 정말 보기 드문 재능입니다... 그리고 당신께서 그 재능을 발휘하시길 바라고요. 갈림길에서 너무 오래 머무르는 건 갈등에 휩쓸리는 것일지도 모른다는 생각이 드니까요.",shape=box,color=blue];
		383 -> 397;
	376 [label="그럼, 삶이 더 단순하겠네요. 신과 성당의 규칙에 따라 살지 않는 것. 솔직히 좀 질투가 나네요.",shape=box,color=blue];
		376 -> 389;
	377 [label="그렇다면, 당신이 부럽네요. 방랑자씨 ! 신들을 알 필요도 없이, 그리 오랜 세월을 살아오셨으니.",shape=box,color=blue];
		377 -> 389;
	378 [label="루아의 제자처럼 들리고, 기분 나쁘게 말하려는 건 아닙니다. Oui, 노파께서 우리 모두를 위해 오시고 은빛 눈물을 흘리십니다. 하지만 당신 말을 들으니 더 궁금해져요...",shape=box,color=blue];
		378 -> 390;
	379 [label="Oui, 궁금해지네요. 당신, 아이, 악마, 심지어 Monsieur 로이드 아니면 le Cardinal까지... 당신들 뒤에는 수 세기가 펼쳐져 있어요.",shape=box,color=blue];
