	406 [label="그러시다면, 당신께서 기도를 하시든 안 하시든, 저의 솔께서 당신게 미소 짓고 계실거라는 걸 압니다. 당신은 필요하면서도 유일한 길을 찾으셨으니까요.",shape=box,color=blue];
		406 -> 410;
	407 [label="Aah, pardonne-moi ! 쬐깐한 마리가 설교를 하고 있었다니, 이 얼마나 부끄러운 일인지 ! 전 당신께 학교 선생님마냥 설교하러 온 게 아니에요.",shape=box,color=blue];
		407 -> 382;
	408 [label="당신의 정직함에 깊이 감동하였습니다, 방랑자씨. 허락해 주신다면... 이 이야기를 다시 하고 싶은데 괜찮으실까요? 설교하거나 캐묻고 싶지 않아요. 당신을 괴롭힐 의도도 없어요.",shape=box,color=blue];
