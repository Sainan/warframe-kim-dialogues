	398 [label="그분들께서는 다른 종파의 추종자들을 기쁘게 하기 위해 형체를 바꾸는 것으로 알려져 있습니다. 하지만 그건 제 신앙이지, 당신의 신앙이 아니니까요. 위로를 구하지 않는 이들에게 설교하지 않겠습니다. 그런 설교는 큰 사랑을 받지 못한다는 걸 알았으니까요.",shape=box,color=blue];
		398 -> 399;
	399 [label="아니요, 제 믿음은 저의 것이고, 당신의 믿음은 당신 것이죠. 그저 신앙이 당신께 평화를 가져다 주는지 궁금할 뿐입니다만 ?",shape=box,color=blue];
		399 -> 394;
