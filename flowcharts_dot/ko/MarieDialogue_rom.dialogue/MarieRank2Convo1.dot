	397 [label="결국, 모든 이들은 스스로가 걸어나가야 하는 길을 선택해야 합니다. 하지만 갈림길은 우리 모두가 시작해야 하는 곳이며, 균형은 모든 구조의 토대입니다.",shape=box,color=blue];
		397 -> 403;
	389 [label="하지만, 궁금하네요... 믿지 않는 것, 그 점이 당신께 평화를 가져다 주나요 ?",shape=box,color=blue];
		389 -> 394;
