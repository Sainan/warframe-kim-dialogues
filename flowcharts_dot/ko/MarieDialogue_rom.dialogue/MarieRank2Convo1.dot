	j2900844406 [label="+10 Chemistry",color=orange];
		j2900844406 -> j1658757063;
	j3649272168 [label="제 질투심이 흘러넘쳐요! 이에 사로잡혀서 집어삼켜질 것 같아요. 허락해 주신다면... 이 이야기를 다시 하고 싶은데 괜찮으실까요 ? 설교하거나 캐묻고 싶지 않아요. 당신을 괴롭힐 의도도 없어요.",shape=box,color=blue];
		j3649272168 -> j1976810275;
	j471000755 [label="그러시다면, 당신께서 기도를 하시든 안 하시든, 저의 솔께서 당신게 미소 짓고 계실거라는 걸 압니다. 당신은 필요하면서도 유일한 길을 찾으셨으니까요.",shape=box,color=blue];
		j471000755 -> j3900809823;
	j4075774170 [label="Aah, pardonne-moi ! 쬐깐한 마리가 설교를 하고 있었다니, 이 얼마나 부끄러운 일인지 ! 전 당신께 학교 선생님마냥 설교하러 온 게 아니에요.",shape=box,color=blue];
		j4075774170 -> j93828870;
	j1658757063 [label="당신의 정직함에 깊이 감동하였습니다, 방랑자씨. 허락해 주신다면... 이 이야기를 다시 하고 싶은데 괜찮으실까요? 설교하거나 캐묻고 싶지 않아요. 당신을 괴롭힐 의도도 없어요.",shape=box,color=blue];
		j1658757063 -> j1976810275;
	j1976810275 [label="단지 궁금해서도 있고, 가능하다면 도와드리고도 싶어서 그래요. 싫으시다면, 다시는 이 이야기를 꺼내지 않을게요.",shape=box,color=blue];
		j1976810275 -> j3888253628;
		j1976810275 -> j3795778024;
	j3900809823 [label="이 이야기를 나중에 다시 할 수 있을까요? 너무 궁금해서 더 자세히 알고 싶거든요.",shape=box,color=blue];
