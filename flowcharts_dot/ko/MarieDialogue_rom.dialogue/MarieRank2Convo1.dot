	366 [label="+5 Chemistry",color=orange];
		366 -> 379;
	367 [label="그 사람에게 조금이라도 믿음이 있다는 게 가슴이 미어집니다만, 이 일에 관해선 어떨까요 ? 그에게 직접 말을 걸어보셔야 할 것 같아요. 다만 조심하세요. 악마는 위험한 게임을 하니까요.",shape=box,color=blue];
		367 -> 380;
		367 -> 381;
	361 [label="확실하게, 이런 옷을 입고 있으면서, 다른 이들에게 엄격한 기대를 갖지 않는 건 의외일지도요. 위로를 원치 않은 이들에게 설교를 전하면, 큰 사랑을 얻지 못한다는 점을 저도 잘 알고 있습니다.",shape=box,color=blue];
		361 -> 374;
	362 [label="+5 Chemistry",color=orange];
