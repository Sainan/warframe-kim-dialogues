	j1698645168 [label="Boolean MarieOtak1 is now true.",color=orange];
		j1698645168 -> j922529676;
		j1698645168 -> j1249898489;
	j3368252999 [label="그분을 위해 할 수 있는 일이 아무것도 없다는 생각에 가슴이 찢어지다 못해 산산조각 나는 것 같아요.",shape=box,color=blue];
		j3368252999 -> j1970966774;
	j1970966774 [label="Evaluate expressions",color=orange];
