	3141 [label="Monsieur 네크랄로이드의 등에 있는 얼굴이요 ! 드디어 만났다구요 !",shape=box,color=blue];
		3141 -> 3145;
		3141 -> 3146;
		3141 -> 3147;
	3143 [label="오탁이랑 대화는 어떻게 진행됐어?",shape=box,color=red];
		3143 -> 3148;
	3144 [label="오탁과의 대화는 즐거웠어?",shape=box,color=red];
		3144 -> 3149;
	3145 [label="오탁을 만났다고? 오 이런... 어떻게 됐어?",shape=box,color=red];
		3145 -> 3150;
	3146 [label="드디어 만났구나. 오탁은 설명하기 좀 어려운 존재일 수 있거든.",shape=box,color=red];
		3146 -> 3151;
	3147 [label="불쌍한 오탁... 어떻게 됐어?",shape=box,color=red];
		3147 -> 3152;
	3148 [label="그는... 마치 우리가 서로 소개한 적이 없는 것 같은 대화를 하더니 세 번이나 자기 소개를 했어요.",shape=box,color=blue];
		3148 -> 3153;
	3149 [label="네. 어쩌면 울고 싶었을지도요. 그는 마치 우리가 서로 소개한 적이 없는 것 같은 대화를 하더니 세 번이나 자기 소개를 했어요.",shape=box,color=blue];
		3149 -> 3153;
	3150 [label="왜 그를 만난 걸 그닥 기뻐하시지 않는거죠 ?",shape=box,color=blue];
		3150 -> 3154;
		3150 -> 3155;
		3150 -> 3156;
	3151 [label="네, 그런 것 같아요. 아이가 작은 로봇 뒤에 휘갈겨 쓴 낙서 같죠. 정말 귀엽고 매력적이었어요 !",shape=box,color=blue];
		3151 -> 3157;
	3152 [label="그분은 정말 다정하고 매력적이었요 ! 하지만 유머 감각 아래 묻힌 상심이 보였기에, 제 가슴이 찢어졌어요.",shape=box,color=blue];
		3152 -> 3158;
	3153 [label="그분은 이전과 마찬가지로 굴하지 않고 쾌활히 인사를 건네주셨지만, 제가 Soeur de Sol인걸 알고 계셨어요 ! ",shape=box,color=blue];
		3153 -> 3159;
	3154 [label="미안. 오탁이 가끔 사람들 신경을 긁을 때가 있거든. 그건 오탁 잘못이 아니야.",shape=box,color=red];
		3154 -> 3160;
	3155 [label="그럴 뜻은 아니었어. 그냥 어떤 사람들에게 있어서 좀... 받아들이기 힘들 수 있거든.",shape=box,color=red];
		3155 -> 3160;
	3156 [label="오탁이 가끔 내 신경을 긁을 때가 있거든. 그게 다야. ",shape=box,color=red];
		3156 -> 3161;
	3157 [label="하지만 유머 아래에 상심이 묻혀 있었기에, 가슴이 찢어지는 줄 알았어요.",shape=box,color=blue];
		3157 -> 3158;
	3158 [label="불쌍한 Monsieur 오탁에 대해서 알려주시겠어요 ?",shape=box,color=blue];
		3158 -> 3162;
	3159 [label="사실, 그분은 광휘의 성체들에 대해 꽤 많이 알고 있었어요 ! 우린 그분이 \"오로킨 제국 이전 시대\"의 \"고대 종교\"에 대해서 오랫동안 대화를 나눴어요.",shape=box,color=blue];
		3159 -> 3163;
	3160 [label="그렇다면 다른 이들이 그분들에게 친절과 인내심을 보여주기를. Mais par la grâce de Sol, 우리 모두 함께 나아가는 거니까요.",shape=box,color=blue];
		3160 -> 3164;
	3161 [label="당신이 약자들에게 좀 더 친절히 대해 주시면 좋겠어요. 결국 솔의 은총을 위해 우리 모두 함께 나아가는 거니까요.",shape=box,color=blue];
		3161 -> 3164;
	3162 [label="오탁은 한때 오로킨의 과학자이자 학자인 아르키메디안이었어. 그에게 일어난 일은 결코 행복한 이야기가 아니야.",shape=box,color=red];
		3162 -> 3165;
	3163 [label="그때의 지식 상당 부분이 지금은 사라져서 기록 보관소 깊숙한 곳에 숨겨져 있고, 엄격히 금지되어 있다고 제게 말씀해 주셨지만요. 비밀 꼭 지키라고 맹세까지 시키셨어요.",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="그러한 운명은 우리 중 누구에게나 찾아올 수 있어요. 심지어 당신에게도요.",shape=box,color=blue];
		3164 -> 3167;
		3164 -> 3168;
	3165 [label="모든 기록에 따르면 그는 천재였고, 아르곤 크리스탈을 이용한 기술의 선두주자였어.",shape=box,color=red];
		3165 -> 3169;
	3166 [label="그분은 집행관 발라스 - 그게 뭐하는 사람이든 - 라는 존재가 저를 이단 종파로서 발견하고 처형할까 봐 깊은 우려를 표하셨어요.",shape=box,color=blue];
		3166 -> 3170;
		3166 -> 3171;
	3167 [label="난 오탁에게 시간을 쓸 여유가 없어서 말이야, 미안.",shape=box,color=red];
		3167 -> 3172;
	3168 [label="당신 말이 맞네. 미안해. 그럴 의도가 아니었어.",shape=box,color=red];
		3168 -> 3158;
	3169 [label="이는 보이드를 다룰 수 있는 힘이었고 - 오로킨이 강력한 워프레임들과 무기류를 제작할 수 있는 이유였어.",shape=box,color=red];
		3169 -> 3173;
	3170 [label="그런 일은... 일어나지 않을 거야. 계속 말해줘.",shape=box,color=red];
		3170 -> 3174;
	3171 [label="발라스는 죽었어... 계속 말해줘.",shape=box,color=red];
		3171 -> 3174;
	3172 [label="그럼 더 많은 시간을 낭비해드린 점에 대해 사과드려야겠네요.",shape=box,color=blue];
		3172 -> 3175;
	3173 [label="오탁은 결정학을 전문분야로 삼았어. 그의 연구물들이 여기 실험실에 보관되어 있지.",shape=box,color=red];
		3173 -> 3176;
