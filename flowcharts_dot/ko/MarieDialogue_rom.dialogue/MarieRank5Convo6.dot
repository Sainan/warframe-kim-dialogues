	3175 [label="Update boolean MarieOtakComplete",color=orange];
		3175 -> 3178;
	3176 [label="어떤 이유에서인지, 왜인지 나도 모르겠지만, 세팔론으로 바뀌었고, 자신만의 네크랄로이드 껍데기를 갖게 되었어.",shape=box,color=red];
		3176 -> 3179;
	3177 [label="그럴 것 같았어요... 뭐, 그분은 제게 어디서 왔냐고 물었고, 제가 대답하자 웃으시면서 \"아니, 그건 불가능해! 그리고 알아뒀어야 했어, 난 -\"",shape=box,color=blue];
		3177 -> 3180;
	3178 [label="Chat ends.",color=orange];
	3179 [label="모든 세팔론들이 처벌의 형태로서 만들어진 건 아니였어. 하지만 데이모스에서는 일이... 제대로 진행되지 않았고, 심한 부상을 입었어.",shape=box,color=red];
