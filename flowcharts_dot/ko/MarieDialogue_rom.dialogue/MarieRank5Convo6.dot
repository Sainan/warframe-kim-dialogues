		3189 -> 3193;
	3188 [label="세팔론에 영혼이 있는지 확신할 수 없다는 당신의 의견을 알고 있으나 - 광휘의 성체들께 불쌍한 오탁이 고통받지 않도록 기도 올릴 수 밖에 없네요.",shape=box,color=blue];
		3188 -> 3192;
	3187 [label="전 그분의 껍데기 속에 남은 것이 과학과 깜빡이는 빛뿐이기를... 광휘의 성체들께 기도를 올릴 수 밖에 없을 것 같아요.",shape=box,color=blue];
		3187 -> 3191;
	3194 [label="어찌하여 그분을 그 지옥에 내버려두시고, 무너진 채 죽을 때까지 기다리게 하여 평화를 얻게 하시려는 건가요? 저는 그저 기도를 올릴 수 밖에 없습니다... 만약 그곳에 어떤 존재가 있다면 -",shape=box,color=blue];
		3194 -> 3197;
	3193 [label="그리고 그 고장난 육신에 갇힌 영혼은 없으며, 그 분의 마지막 순간에 마침내 평화를 얻게 될 거란 거라고 생각하며 죽음으로서 평화를 찾게되길 기다리지도, 바라지도 않게 되겠죠.",shape=box,color=blue];
		3193 -> 3196;
