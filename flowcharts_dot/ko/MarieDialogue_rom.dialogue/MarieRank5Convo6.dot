		3204 -> 3208;
	3205 [label="당신 기분 전환되게 내가 뭐 할 수 있는 게 있을까? 페이스트리 좀 훔쳐올까?",shape=box,color=red];
		3205 -> 3209;
	3206 [label="신들은 가끔 잔인할 때도 있어, 마리. 인생이란 그런 법이니까.",shape=box,color=red];
