		3191 -> 3195;
	3197 [label="외로운 경계의 공간 속에 스스로의 선택에 따라 그곳에 머무시는 거니까요...",shape=box,color=blue];
		3197 -> 3200;
	3196 [label="만약 당신이 틀렸고, 영혼이 스스로의 의지와는 반대로 그 철장과도 같은 몸 안에 머물러 있다면요 ?",shape=box,color=blue];
		3196 -> 3199;
	3195 [label="아니면 지금 정신 세계에 어떤 종류의 존재가 있다하면, 외로운 경계의 공간 속에 스스로의 선택에 따라 그곳에 머무시는 거겠죠.",shape=box,color=blue];
		3195 -> 3198;
	3200 [label="그렇지 않을 거라고 생각하는 것만으로도 신들의 자비에 대해 의심하게 되니까요, non ?",shape=box,color=blue];
		3200 -> 3201;
