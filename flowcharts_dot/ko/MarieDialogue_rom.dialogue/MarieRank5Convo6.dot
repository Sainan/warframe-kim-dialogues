		3140 -> 3143;
		3140 -> 3144;
	3142 [label="늑대씨 ! 내 늑대씨 ! Monsieur 네크랄로이드의 등에 있는 얼굴이요 ! 드디어 만났다구요 !",shape=box,color=blue];
		3142 -> 3145;
		3142 -> 3146;
