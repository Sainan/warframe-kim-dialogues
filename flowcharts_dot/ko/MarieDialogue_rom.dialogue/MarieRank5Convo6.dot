		j925755091 -> j922529676;
		j925755091 -> j1249898489;
	j652287403 [label="늑대씨 ! 내 늑대씨 ! Monsieur 네크랄로이드의 등에 있는 얼굴이요 ! 드디어 만났다구요 !",shape=box,color=blue];
		j652287403 -> j2855831079;
		j652287403 -> j3926994820;
		j652287403 -> j4019480566;
	j2076206413 [label="Monsieur 네크랄로이드의 등에 있는 얼굴이요 ! 드디어 만났다구요 !",shape=box,color=blue];
		j2076206413 -> j2855831079;
		j2076206413 -> j3926994820;
		j2076206413 -> j4019480566;
	j922529676 [label="오탁이랑 대화는 어떻게 진행됐어?",shape=box,color=red];
		j922529676 -> j3765714510;
	j1249898489 [label="오탁과의 대화는 즐거웠어?",shape=box,color=red];
		j1249898489 -> j824981410;
	j2855831079 [label="오탁을 만났다고? 오 이런... 어떻게 됐어?",shape=box,color=red];
		j2855831079 -> j1919842507;
	j3926994820 [label="드디어 만났구나. 오탁은 설명하기 좀 어려운 존재일 수 있거든.",shape=box,color=red];
		j3926994820 -> j2110819760;
	j4019480566 [label="불쌍한 오탁... 어떻게 됐어?",shape=box,color=red];
		j4019480566 -> j570784545;
	j3765714510 [label="그는... 마치 우리가 서로 소개한 적이 없는 것 같은 대화를 하더니 세 번이나 자기 소개를 했어요.",shape=box,color=blue];
		j3765714510 -> j1129743883;
	j824981410 [label="네. 어쩌면 울고 싶었을지도요. 그는 마치 우리가 서로 소개한 적이 없는 것 같은 대화를 하더니 세 번이나 자기 소개를 했어요.",shape=box,color=blue];
		j824981410 -> j1129743883;
	j1919842507 [label="왜 그를 만난 걸 그닥 기뻐하시지 않는거죠 ?",shape=box,color=blue];
		j1919842507 -> j1327405444;
		j1919842507 -> j1741099781;
		j1919842507 -> j3156156150;
	j2110819760 [label="네, 그런 것 같아요. 아이가 작은 로봇 뒤에 휘갈겨 쓴 낙서 같죠. 정말 귀엽고 매력적이었어요 !",shape=box,color=blue];
		j2110819760 -> j2502426447;
	j570784545 [label="그분은 정말 다정하고 매력적이었요 ! 하지만 유머 감각 아래 묻힌 상심이 보였기에, 제 가슴이 찢어졌어요.",shape=box,color=blue];
		j570784545 -> j1442776567;
	j1129743883 [label="그분은 이전과 마찬가지로 굴하지 않고 쾌활히 인사를 건네주셨지만, 제가 Soeur de Sol인걸 알고 계셨어요 ! ",shape=box,color=blue];
		j1129743883 -> j1891082731;
	j1327405444 [label="미안. 오탁이 가끔 사람들 신경을 긁을 때가 있거든. 그건 오탁 잘못이 아니야.",shape=box,color=red];
		j1327405444 -> j116902605;
	j1741099781 [label="그럴 뜻은 아니었어. 그냥 어떤 사람들에게 있어서 좀... 받아들이기 힘들 수 있거든.",shape=box,color=red];
		j1741099781 -> j116902605;
	j3156156150 [label="오탁이 가끔 내 신경을 긁을 때가 있거든. 그게 다야. ",shape=box,color=red];
		j3156156150 -> j1822462655;
	j2502426447 [label="하지만 유머 아래에 상심이 묻혀 있었기에, 가슴이 찢어지는 줄 알았어요.",shape=box,color=blue];
		j2502426447 -> j1442776567;
	j1442776567 [label="불쌍한 Monsieur 오탁에 대해서 알려주시겠어요 ?",shape=box,color=blue];
		j1442776567 -> j1467370853;
	j1891082731 [label="사실, 그분은 광휘의 성체들에 대해 꽤 많이 알고 있었어요 ! 우린 그분이 \"오로킨 제국 이전 시대\"의 \"고대 종교\"에 대해서 오랫동안 대화를 나눴어요.",shape=box,color=blue];
		j1891082731 -> j3814169018;
	j116902605 [label="그렇다면 다른 이들이 그분들에게 친절과 인내심을 보여주기를. Mais par la grâce de Sol, 우리 모두 함께 나아가는 거니까요.",shape=box,color=blue];
		j116902605 -> j3924432150;
	j1822462655 [label="당신이 약자들에게 좀 더 친절히 대해 주시면 좋겠어요. 결국 솔의 은총을 위해 우리 모두 함께 나아가는 거니까요.",shape=box,color=blue];
		j1822462655 -> j3924432150;
	j1467370853 [label="오탁은 한때 오로킨의 과학자이자 학자인 아르키메디안이었어. 그에게 일어난 일은 결코 행복한 이야기가 아니야.",shape=box,color=red];
		j1467370853 -> j3055347414;
	j3814169018 [label="그때의 지식 상당 부분이 지금은 사라져서 기록 보관소 깊숙한 곳에 숨겨져 있고, 엄격히 금지되어 있다고 제게 말씀해 주셨지만요. 비밀 꼭 지키라고 맹세까지 시키셨어요.",shape=box,color=blue];
		j3814169018 -> j1362971485;
	j3924432150 [label="그러한 운명은 우리 중 누구에게나 찾아올 수 있어요. 심지어 당신에게도요.",shape=box,color=blue];
		j3924432150 -> j1513859926;
		j3924432150 -> j1847402896;
	j3055347414 [label="모든 기록에 따르면 그는 천재였고, 아르곤 크리스탈을 이용한 기술의 선두주자였어.",shape=box,color=red];
		j3055347414 -> j3285411488;
	j1362971485 [label="그분은 집행관 발라스 - 그게 뭐하는 사람이든 - 라는 존재가 저를 이단 종파로서 발견하고 처형할까 봐 깊은 우려를 표하셨어요.",shape=box,color=blue];
		j1362971485 -> j2474133071;
		j1362971485 -> j605060996;
	j1513859926 [label="난 오탁에게 시간을 쓸 여유가 없어서 말이야, 미안.",shape=box,color=red];
		j1513859926 -> j430305543;
	j1847402896 [label="당신 말이 맞네. 미안해. 그럴 의도가 아니었어.",shape=box,color=red];
		j1847402896 -> j1442776567;
	j3285411488 [label="이는 보이드를 다룰 수 있는 힘이었고 - 오로킨이 강력한 워프레임들과 무기류를 제작할 수 있는 이유였어.",shape=box,color=red];
		j3285411488 -> j128065452;
	j2474133071 [label="그런 일은... 일어나지 않을 거야. 계속 말해줘.",shape=box,color=red];
		j2474133071 -> j2073409662;
	j605060996 [label="발라스는 죽었어... 계속 말해줘.",shape=box,color=red];
		j605060996 -> j2073409662;
	j430305543 [label="그럼 더 많은 시간을 낭비해드린 점에 대해 사과드려야겠네요.",shape=box,color=blue];
		j430305543 -> j3007723528;
	j128065452 [label="오탁은 결정학을 전문분야로 삼았어. 그의 연구물들이 여기 실험실에 보관되어 있지.",shape=box,color=red];
		j128065452 -> j1175071265;
	j2073409662 [label="+5 Chemistry",color=orange];
		j2073409662 -> j1074823391;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j1175071265 [label="어떤 이유에서인지, 왜인지 나도 모르겠지만, 세팔론으로 바뀌었고, 자신만의 네크랄로이드 껍데기를 갖게 되었어.",shape=box,color=red];
		j1175071265 -> j1101309761;
	j1074823391 [label="그럴 것 같았어요... 뭐, 그분은 제게 어디서 왔냐고 물었고, 제가 대답하자 웃으시면서 \"아니, 그건 불가능해! 그리고 알아뒀어야 했어, 난 -\"",shape=box,color=blue];
		j1074823391 -> j3684394835;
	j1101309761 [label="모든 세팔론들이 처벌의 형태로서 만들어진 건 아니였어. 하지만 데이모스에서는 일이... 제대로 진행되지 않았고, 심한 부상을 입었어.",shape=box,color=red];
		j1101309761 -> j646397063;
	j3684394835 [label="그러고는 그분은... 다시 자기소개를 하셨어요. 그리고 plaines에서 광물 샘플을 가지고 왔냐고 물으셨죠...",shape=box,color=blue];
		j3684394835 -> j3440072152;
		j3684394835 -> j2017686191;
	j646397063 [label="Pauvre petit...",shape=box,color=blue];
		j646397063 -> j1698645168;
	j3440072152 [label="오, 마리. 정말 유감이야...",shape=box,color=red];
		j3440072152 -> j3368252999;
	j2017686191 [label="그래... 그게 오탁이야.",shape=box,color=red];
