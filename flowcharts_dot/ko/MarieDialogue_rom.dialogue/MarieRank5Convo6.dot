		j899552265 -> j2014340194;
		j899552265 -> j733416482;
	j468114431 [label="Oui. 맞는 말씀이에요. 사실 그렇죠. 세상에는 Monsieur 오탁과 같은 사례가 셀 수 없이 많고, 그보다 훨씬 더 끔찍한 이야기들도 많으니까요. 저는 그런 사례 중 하나 때문에 울고 싶지 않아요. ",shape=box,color=blue];
		j468114431 -> j3954193150;
	j1552923998 [label="Merci. 뭐, 더 이상 슬픈 채로 있기 싫네요. 좀 더 즐거운 일을 하러 가야겠어요 ! M'sieur 피보나치의 물탱크를 청소해야 할 것 같아요.",shape=box,color=blue];
		j1552923998 -> j2425134241;
	j2014340194 [label="당신 전혀 바보같지 않아. 나도 똑같이 생각했으니까.",shape=box,color=red];
		j2014340194 -> j2235898819;
	j733416482 [label="내가 당신을 위해 해줄 수 최소한의 일이니까.",shape=box,color=red];
		j733416482 -> j2235898819;
	j3954193150 [label="그럼에도 바로 그런 짓을 하고 앉아 있었네요. 제 어리석음을 일깨워 주셔서 감사합니다. 체 ! 바보같은 작은 마리. 음... M'sieur 피보나치의 물탱크를 좀 닦아 줘야겠어요.",shape=box,color=blue];
		j3954193150 -> j2425134241;
