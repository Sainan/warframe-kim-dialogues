	j1060438450 [label="오, 광휘의 성체들이시여 - 어찌하여 그분께 지옥을 만드시고, 그분의 영혼을 과학과 깜빡이는 빛의 우리 속에 가둬놓으신 건가요 ?",shape=box,color=blue];
		j1060438450 -> j3726541745;
	j377563201 [label="당신의 의견이 맞아서 그 껍데기 안에 어떤 것도 남지 않았고 과학과 깜빡이는 빛만이 있는 거라고... 광휘의 성체들께 기도드릴 수 밖에 없겠네요.",shape=box,color=blue];
		j377563201 -> j2622173876;
	j3513951748 [label="세팔론에 영혼이 있는지 확신할 수 없다는 당신의 의견을 알고 있으나 - 광휘의 성체들께 불쌍한 오탁이 고통받지 않도록 기도 올릴 수 밖에 없네요.",shape=box,color=blue];
		j3513951748 -> j3028217149;
	j3784682335 [label="전 그분의 껍데기 속에 남은 것이 과학과 깜빡이는 빛뿐이기를... 광휘의 성체들께 기도를 올릴 수 밖에 없을 것 같아요.",shape=box,color=blue];
		j3784682335 -> j911710223;
	j3726541745 [label="어찌하여 그분을 그 지옥에 내버려두시고, 무너진 채 죽을 때까지 기다리게 하여 평화를 얻게 하시려는 건가요? 저는 그저 기도를 올릴 수 밖에 없습니다... 만약 그곳에 어떤 존재가 있다면 -",shape=box,color=blue];
		j3726541745 -> j3617881581;
	j2622173876 [label="그리고 그 고장난 육신에 갇힌 영혼은 없으며, 그 분의 마지막 순간에 마침내 평화를 얻게 될 거란 거라고 생각하며 죽음으로서 평화를 찾게되길 기다리지도, 바라지도 않게 되겠죠.",shape=box,color=blue];
		j2622173876 -> j3519747169;
	j3028217149 [label="그 고장난 육신에 갇힌 영혼은 없으며, 그 분의 마지막 순간에 마침내 평화를 얻게 될 거란 거라고 생각하며 죽음으로서 평화를 찾게되길 기다리지도, 바라지도 않게 되겠죠.",shape=box,color=blue];
		j3028217149 -> j4229271545;
	j911710223 [label="그리고 그 고장난 육신에 갇힌 영혼은 없으며, 그 분의 마지막 순간에 마침내 평화를 얻게 될 거란 거라고 생각하며 죽음으로서 평화를 찾게되길 기다리지도, 바라지도 않게 되겠죠.",shape=box,color=blue];
		j911710223 -> j4229271545;
	j3617881581 [label="외로운 경계의 공간 속에 스스로의 선택에 따라 그곳에 머무시는 거니까요...",shape=box,color=blue];
		j3617881581 -> j2058233256;
	j3519747169 [label="만약 당신이 틀렸고, 영혼이 스스로의 의지와는 반대로 그 철장과도 같은 몸 안에 머물러 있다면요 ?",shape=box,color=blue];
		j3519747169 -> j471188833;
	j4229271545 [label="아니면 지금 정신 세계에 어떤 종류의 존재가 있다하면, 외로운 경계의 공간 속에 스스로의 선택에 따라 그곳에 머무시는 거겠죠.",shape=box,color=blue];
		j4229271545 -> j2058233256;
	j2058233256 [label="그렇지 않을 거라고 생각하는 것만으로도 신들의 자비에 대해 의심하게 되니까요, non ?",shape=box,color=blue];
		j2058233256 -> j3945403139;
	j471188833 [label="신들의 자비에 대해 의심하게 되는 것으로 충분하다고 생각합니다, non ?",shape=box,color=blue];
		j471188833 -> j3945403139;
