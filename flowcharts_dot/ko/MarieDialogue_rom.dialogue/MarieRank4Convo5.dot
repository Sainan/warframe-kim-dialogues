		1709 -> 1714;
	1710 [label="Le Cardinal의 불가피한 이별로 인해 다른 가족들에게 고통을 안겨준 건 이들을 보호하려는 결정에서 비롯됐다는 점은 알겠으나...",shape=box,color=blue];
		1710 -> 1715;
	1711 [label="Oui... 왜 그런지 알겠어요. 할 수만 있다면 그분의 가족을 치유하려고 노력하겠어요, non ? 우리가 이곳에서 빠져나갈 수 있는 유일한 희망은 그것 뿐인 것 같으니까요. ",shape=box,color=blue];
