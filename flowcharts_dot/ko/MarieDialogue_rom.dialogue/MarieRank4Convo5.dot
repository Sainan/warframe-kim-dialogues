		1629 -> 1632 [label="false",color=purple];
	2930 [label="드리프터 ! 제가 계략을 꾸미고 있는데요.",shape=box,color=blue];
		2930 -> 2931;
		2930 -> 2932;
	1630 [label="드리프터 ! 저번에 우리 위층에 있는 가족분들에 대한 계략을 꾸미고 있는데, 그분들이 우릴 침입자로 볼지도 모른다는 생각이 들었어요.",shape=box,color=blue];
		1630 -> 1633;
	1631 [label="드리프터 ! 저번에 우리 위층에 있는 가족분들에 대해서 말씀하셨던 걸 곰곰이 생각해 봤는데, 그분들이 생각나서 마음이 너무 아팠어요...",shape=box,color=blue];
		1631 -> 1634;
	1632 [label="왜 위층에 올라갈 수 없는 건가요 ? Le Cardinal famille라고 불리는 분들과 왜 이야기를 할 수 없는 건가요 ?",shape=box,color=blue];
		1632 -> 1635;
		1632 -> 1636;
	2931 [label="무서워해야 해?",shape=box,color=red];
		2931 -> 2934;
	2932 [label="[종료.]",shape=box,color=red];
		2932 -> 2933;
	1633 [label="\"다른 가족\"과 compétition 상태가 될 수도 있고, oui ? 정말 고민되요.",shape=box,color=blue];
		1633 -> 1634;
	1634 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1634 -> 1637 [label=true,color=green];
		1634 -> 1638 [label=false,color=brown];
	1635 [label="뭐... 짧게 말하자면, 엔트라티 가족 중 몇몇은 위층에 살고 있는데, 그 사람들은 우리가 여기 아래 있다는 걸 정확히는 몰라.",shape=box,color=red];
		1635 -> 1639;
	1636 [label="[종료.]",shape=box,color=red];
		1636 -> 1640;
	2934 [label="OuI ! 그 날아다니는 작은 로봇들. 네크라... 네크라... 뭐라 부르죠 ?",shape=box,color=blue];
		2934 -> 2935;
	2933 [label="Chat ends.",color=orange];
	1637 [label="우린 le Cardinal에 대한 사랑을 놓고 경쟁하는 관계가 아니니까요. 어떻게하면 그분들이 이 사실을 알 수 있을까요?",shape=box,color=blue];
		1637 -> 1641;
		1637 -> 1642;
		1637 -> 1643;
	1638 [label="가족분들이 가진 내면의 갈등을 치유해가는 일은 어떻게 진행되고 있나요?",shape=box,color=blue];
		1638 -> 1644;
		1638 -> 1645;
		1638 -> 1646;
		1638 -> 1647;
	1639 [label="Update boolean MarieFamily1",color=orange];
		1639 -> 1648;
	1640 [label="Chat ends.",color=orange];
	2935 [label="네크라마이트?",shape=box,color=red];
		2935 -> 2936;
	1641 [label="당신 말이 맞아. 어떤 이가 줄 생각도 안하는 걸 두고 다른 사람들과 경쟁할 수는 없지.",shape=box,color=red];
		1641 -> 1649;
	1642 [label="딱지가 앉은 상처를 여는 건 위험해. 감염을 없앨 수 있거나... 그 과정에서 출혈이 생길 수도 있어.",shape=box,color=red];
		1642 -> 1650;
	1643 [label="당신 - 우리 - 모두에게는 공통점이 하나 있어. 어느 순간, 우린 엔트라티에게 버림받았다는 거야.",shape=box,color=red];
		1643 -> 1651;
	1644 [label="솔직히 말할까? 딴 일 하느라 정신 팔렸었어.",shape=box,color=red];
		1644 -> 1652;
	1645 [label="조금만 더 하면 나아질 것 같아.",shape=box,color=red];
		1645 -> 1653;
	1646 [label="진전을 이루고 있는 것 같아.",shape=box,color=red];
		1646 -> 1654;
	1647 [label="[종료.]",shape=box,color=red];
		1647 -> 1655;
	1648 [label="Par les Luminaires... 우리 모두가 비밀리에 여기 있다는 말인가요 ?! 그래서 우리가 여길 떠날 수 없는 건가요 ?! Mais pourquoi ?!",shape=box,color=blue];
		1648 -> 1656;
	2936 [label="Oui ! 하 ! 가구를 바꾸는 데 너무 집착하는 것 같더라구요. non ? 하지만 물건을 옮기면... 똑같이 옮겨놔요.",shape=box,color=blue];
		2936 -> 2937;
