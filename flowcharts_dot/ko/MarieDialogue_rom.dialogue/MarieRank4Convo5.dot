		1713 -> 1717;
	1714 [label="Non, 악마는 안되요 - 다른 사람 다 되도 악마는 안되요. 하지만 뭔가 계획하는 게 있으신가 보네요. 당연히 고르셔야 하는 선택지로는 Monsieur 로이드가 있습니다, non ?",shape=box,color=blue];
		1714 -> 1718;
	1715 [label="불필요하게 잔인하다고 생각되지 않나요 ? 다른 사람들은 그분이 죽었다고 생각했을 거에요. 아니면 더 최악으로요 ! 그리고 우리는, 여기서 comme des rats d'égout 처럼 있어야 하나요 ?",shape=box,color=blue];
		1715 -> 1719;
