		j2515192195 -> j866466819 [label="MarieEntratiNeutral",color=purple];
		j2515192195 -> j2300161016 [label="false",color=purple];
	j2295282358 [label="솔직히 말할까? 딴 일 하느라 정신 팔렸었어.",shape=box,color=red];
		j2295282358 -> j2761563313;
	j2814682462 [label="조금만 더 하면 나아질 것 같아.",shape=box,color=red];
		j2814682462 -> j1154808659;
	j434057971 [label="진전을 이루고 있는 것 같아.",shape=box,color=red];
		j434057971 -> j2036379512;
	j1202419149 [label="알브레히트의 딸, 오일러리아 - 어머니라고 알려진 존재와 그녀의 가족들이 이제까지 데이모스를 관리하고 있었어.",shape=box,color=red];
		j1202419149 -> j180217070;
	j4036325072 [label="그럼 가구를 그냥 전부 옮겨다 놓고, 네크라마이트들이 새 가구를 들여놓을 때까지 기다렸다가, 또 옮겨놓는다 해도... 무슨 문제가 있겠어요? 그렇게 하면 옮긴 걸 다 팔 수 있죠 ! 이 ce mobilier étrange들로 돈을 버는 거에요 !",shape=box,color=blue];
		j4036325072 -> j3062557455;
		j4036325072 -> j3219680930;
		j4036325072 -> j1169835377;
	j2147609872 [label="Le Cardinal에 대한 우리의 의견 불일치가 해결되지 않았다는 점을 알고 있어요. 전 이 대화를 교양있게 이어가려고 노력하고 있습니다.",shape=box,color=blue];
		j2147609872 -> j1280378441;
	j3856260528 [label="당신이 비난받을 만한 사람들을 지적할 기회를 찾지 않고 갈등을 해소하는 것에 대한 논의를 원치 않는다는 거 잘 이해하고 있습니다.",shape=box,color=blue];
		j3856260528 -> j1280378441;
	j1082252399 [label="Oui ! 당신께서 제게 늘 상기시켜 주듯이, 당신은 그분을 un monstre로 여기고 있죠 ! 그분의 마음속에는 악의와 공허함만이 가득하다고요 !",shape=box,color=blue];
		j1082252399 -> j1280378441;
	j619661594 [label="당신이 le Cardinal의 영혼을 위한 이 전쟁에서 제 편이라고 생각했습니다만 ?",shape=box,color=blue];
		j619661594 -> j1580697150;
	j2017429328 [label="당신이 le Cardinal에 대해 아직 결정을 못 내리신 줄 알았는데요 ? 아니면 이제 맘을 정하신건가요 ?",shape=box,color=blue];
		j2017429328 -> j345903003;
		j2017429328 -> j3549048625;
	j3623798287 [label="Oui. M'sieur 태그퍼와 함께 배우고 있어요...",shape=box,color=blue];
		j3623798287 -> j1913191426;
	j710933253 [label="딱지 앉은 상처에 대해서 나한테 함부로 말하지 마세요, 늑대씨. 지난번 le Cardianl에 대해 얘기했을 때 상처가 아직 아물지도 않았어요.",shape=box,color=blue];
		j710933253 -> j1280378441;
	j3449955461 [label="Oui, 하지만 이전에 말씀하셨잖아요 - 우리는 서로가 고통받아서 얻은 상처에 대해서 서로 비난하는 걸 멈춰야 한다고요.",shape=box,color=blue];
		j3449955461 -> j382100250;
	j3898389004 [label="당신이 Le Cadinal에게 상처를 입었다고 생각해서 그분을 끔찍한 monstre로 여기시는 거 알고 있어요.",shape=box,color=blue];
		j3898389004 -> j1280378441;
	j2960979859 [label="당신이 le Cardinal의 영혼을 위한 이 전쟁에서 제 편이라는 걸 알고 있어요. 이에 대해서 영원히 감사드릴 거에요.",shape=box,color=blue];
		j2960979859 -> j1537620960;
	j866466819 [label="당신이 그분에 대한 판단을 유보하고 있다는 걸 알고 있어요. 그 점에 대해서 매우 감사드리고 있어요.",shape=box,color=blue];
		j866466819 -> j1537620960;
	j1537620960 [label="다른 이들이 그분을 탓하고 있는 걸 알지만, 우리가 온전히 하나로 모여야 할 때 분열된 채로 피 흘리는 모습을 보고 싶지 않아요.",shape=box,color=blue];
		j1537620960 -> j2513811496;
	j1751173783 [label="Oui, - M'sieur 태그퍼와 함께 - 모두가 같은 기준을 가지고 있는게 아니라는 걸 배우고 있지만요.",shape=box,color=blue];
		j1751173783 -> j1913191426;
	j615424447 [label="그리고 당신께서 제게 \"친절히\" 지적해 주신 것처럼, 다른 이들이 같은 기준을 가지고 있는 게 아니라는 것을 배우고 있습니다, non ?",shape=box,color=blue];
		j615424447 -> j1280378441;
	j695552232 [label="Oui, 맞아요 ! Le Cadinal께서 떠나신 걸 비난하진 않으나, 그분의 업적은 sacro-saint -",shape=box,color=blue];
		j695552232 -> j1537620960;
	j4144290516 [label="그리고 당신이 Le Cadinal에게 상처를 입었다고 생각해서 그분을 끔찍한 monstre로 여기시는 거 알고 있어요.",shape=box,color=blue];
		j4144290516 -> j1280378441;
	j2300161016 [label="다른 이들이 자신이 받은 고통에 대해 그분을 비난하는 데 급급한 반면, 전 단지 우리가 분열되서 고통받는 모습을 보고 싶지 않아서 그래요.",shape=box,color=blue];
		j2300161016 -> j2513811496;
	j2761563313 [label="뭐에 그리 정신이 팔리셨는데요? Mécontents의 불만을 정리하는 것보다 더 중요한 일들이 있나요?",shape=box,color=blue];
		j2761563313 -> j2807771551;
	j1154808659 [label="Mécontents의 불만을 정리하는 일 보다 더 어려운 일이 있나요?",shape=box,color=blue];
		j1154808659 -> j763562306;
	j2036379512 [label="Oh, magnifique !",shape=box,color=blue];
		j2036379512 -> j1686188517;
	j180217070 [label="이 곳과 보이드 에너지를 근원계로 펌핑해내는 심장을 지켜보고, 우리 모두에게... 실제로, 알브레히트 엔트라티가 떠난 이후로도 이 힘을 계속 사용할 수 있게 해줬어.",shape=box,color=red];
		j180217070 -> j3916832970;
	j3062557455 [label="엔트라티네 의자를 내다 놔도 살 사람이 있을지 잘 모르겠네...",shape=box,color=red];
		j3062557455 -> j1212045721;
	j3219680930 [label="그러다간 결국 시장에 넘칠 정도로 재고가 쌓이지 않을까? 제법 싼 값에 팔아야 할텐데...",shape=box,color=red];
		j3219680930 -> j1212045721;
	j1169835377 [label="기발하네. 문제될 게 뭐가 있겠어, 응.",shape=box,color=red];
		j1169835377 -> j3777900734;
	j1280378441 [label="그리고 두 주제가 불가분의 관계라는 걸 알기에, 오늘은 생산적인 토론을 유지해주시길 부탁드려요, oui ?",shape=box,color=blue];
		j1280378441 -> j761526621;
	j1580697150 [label="당신의 속임수는 뭐죠, 늑대씨 ? 아니면 작은 마리는 당신에게 있어서 un jeu일 뿐인가요 ?",shape=box,color=blue];
		j1580697150 -> j2687240666;
		j1580697150 -> j3549048625;
	j345903003 [label="그 인간이 벌여왔던 짓들이 필요한 행동이었냐에 대해선 확실히 결정하진 못했어. 하지만 그 차가운 본성은 의심할 여지조차 없지.",shape=box,color=red];
		j345903003 -> j1280378441;
	j3549048625 [label="당신 편인 척 하는 거에 지쳤어, 미안.",shape=box,color=red];
		j3549048625 -> j4142615896;
	j1913191426 [label="우리는 서로가 고통받아서 얻은 상처에 대해서 서로 비난하는 걸 멈춰야 한다고요.",shape=box,color=blue];
		j1913191426 -> j382100250;
	j382100250 [label="Le Cadinal을 비난하는 것에는 동의하지 않으나, 우리가 온전히 하나로 모여야 할 때 분열된 채로 피 흘리는 모습을 보고 싶지 않아요.",shape=box,color=blue];
		j382100250 -> j753443074;
		j382100250 -> j1374151591;
	j2513811496 [label="누구의 잘못인지는 중요하지 않으며, 우리는 서로가 겪은 고통에 대해 서로를 비난하는 걸 멈춰야 해요.",shape=box,color=blue];
		j2513811496 -> j753443074;
		j2513811496 -> j1374151591;
	j2807771551 [label="농담이에요, 농담 ! 당신이 얼마나 바쁜지, 얼마나 많은 곳에서, 얼마나 많은 시간선에서 당신을 필요로 하는지 가늠도 할 수 없어요.",shape=box,color=blue];
		j2807771551 -> j1686188517;
	j763562306 [label="농담이에요, 농담 ! 가족분들이 얼마나 힘드셨을지 가늠할 수 없어서요. 그리고 그걸 풀어내는 것도 얼마나 힘든지도요.",shape=box,color=blue];
		j763562306 -> j1686188517;
	j1686188517 [label="가족분들의 문제가 해결되지 않은 상태에서 우리가 그분들에게 환대를 받을 수 있을지조차 의문이에요. 더 큰 문제가 아직 해결되지 않은 채 남아있어요 -",shape=box,color=blue];
		j1686188517 -> j674457661;
	j3916832970 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3916832970 -> j20587143 [label=true,color=green];
		j3916832970 -> j3337182392 [label=false,color=brown];
	j1212045721 [label="푸훗 ! 하지만 제법 할 만한 실험이라고 생각하거든요. 어쩌면 수없이 많은 책장으로 벽을 쌓아서 악마를 격리시켜 둘 수도 있잖아요!",shape=box,color=blue];
		j1212045721 -> j2979954743;
	j3777900734 [label="당신의 빈정거림은 예의있게 무시하도록 하겠어요. 제법 할 만한 실험이라고 생각하거든요. 어쩌면 수없이 많은 책장으로 벽을 쌓아서 악마를 격리시켜 둘 수도 있잖아요!",shape=box,color=blue];
		j3777900734 -> j2979954743;
