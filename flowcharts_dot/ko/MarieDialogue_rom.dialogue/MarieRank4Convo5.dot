		j437277583 -> j1316635360;
	j1316635360 [label="Evaluate expressions",color=orange];
		j1316635360 -> j2261243197 [label="LoidFamilyComplete",color=purple];
		j1316635360 -> j404157802 [label="MarieFamilyOther",color=purple];
		j1316635360 -> j2922311600 [label="MarieFamily2",color=purple];
		j1316635360 -> j2922311600 [label="MarieFamily1",color=purple];
		j1316635360 -> j3482794678 [label="false",color=purple];
	j2261243197 [label="드리프터 ! 제가 계략을 꾸미고 있는데요.",shape=box,color=blue];
		j2261243197 -> j1941672373;
		j2261243197 -> j3039724897;
	j404157802 [label="드리프터 ! 전에 저희 위층 가족분들에 대해 말씀해 주신 것을 가지고 꿍꿍이를 하나 꾸미고 있었어요. 그분들이 저희를 침입자로 느끼실 지도 모르지만요.",shape=box,color=blue];
		j404157802 -> j2241076020;
	j2922311600 [label="드리프터 ! 저번에 우리 위층에 있는 가족분들에 대해서 말씀하셨던 걸 곰곰이 생각해 봤어요. 마음이 너무 아프네요...",shape=box,color=blue];
		j2922311600 -> j1000557311;
	j3482794678 [label="왜 위층에 올라갈 수 없는 건가요 ? Le Cardinal famille라고 불리는 분들과 왜 이야기를 할 수 없는 건가요 ?",shape=box,color=blue];
		j3482794678 -> j2827913714;
		j3482794678 -> j3039724897;
	j1941672373 [label="겁먹어야 할 일인가?",shape=box,color=red];
		j1941672373 -> j3714762100;
	j3039724897 [label="[종료.]",shape=box,color=red];
		j3039724897 -> "Chat ends.";
	j2241076020 [label="\"다른 가족\"과 compétition 상태가 될 수도 있고, oui ? 정말 고민되요.",shape=box,color=blue];
		j2241076020 -> j1000557311;
	j1000557311 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j1000557311 -> j674457661 [label=true,color=green];
		j1000557311 -> j3642914 [label=false,color=brown];
	j2827913714 [label="뭐... 짧게 말하자면, 엔트라티 가족 중 몇몇은 위층에 살고 있는데, 그 사람들은 우리가 여기 아래 있다는 걸 정확히는 몰라.",shape=box,color=red];
		j2827913714 -> j1694555684;
	j3714762100 [label="OuI ! 그 날아다니는 작은 로봇들요. 네크라... 네크라... 뭐라 부르죠 ?",shape=box,color=blue];
		j3714762100 -> j461293613;
	"Chat ends." [color=orange];
	j674457661 [label="우린 le Cardinal에 대한 사랑을 놓고 경쟁하는 관계가 아니니까요. 어떻게하면 그분들이 이 사실을 알 수 있을까요?",shape=box,color=blue];
		j674457661 -> j3584873854;
		j674457661 -> j3133902162;
		j674457661 -> j952162002;
	j3642914 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j3642914 -> j674457661 [label=true,color=green];
		j3642914 -> j4022364408 [label=false,color=brown];
	j1694555684 [label="Boolean MarieFamily1 is now true.",color=orange];
		j1694555684 -> j3038975975;
	j461293613 [label="네크라마이트?",shape=box,color=red];
		j461293613 -> j317823914;
	j3584873854 [label="당신 말이 맞아. 어떤 이가 줄 생각도 안하는 걸 두고 다른 사람들과 경쟁할 수는 없지.",shape=box,color=red];
		j3584873854 -> j380005824;
	j3133902162 [label="딱지가 앉은 상처를 여는 건 위험해. 감염을 없앨 수 있거나... 그 과정에서 출혈이 생길 수도 있어.",shape=box,color=red];
		j3133902162 -> j2952898253;
	j952162002 [label="당신 - 우리 - 모두에게는 공통점이 하나 있어. 어느 순간, 우린 엔트라티에게 버림받았다는 거야.",shape=box,color=red];
		j952162002 -> j2515192195;
	j4022364408 [label="가족분들이 가진 내면의 갈등을 치유해가는 일은 어떻게 진행되고 있나요?",shape=box,color=blue];
		j4022364408 -> j2295282358;
		j4022364408 -> j2814682462;
		j4022364408 -> j434057971;
		j4022364408 -> j3039724897;
	j3038975975 [label="Par les Luminaires... 우리 모두가 비밀리에 여기 있다는 말인가요 ?! 그래서 우리가 여길 떠날 수 없는 건가요 ?! Mais pourquoi ?!",shape=box,color=blue];
		j3038975975 -> j1202419149;
	j317823914 [label="Oui ! 하 ! 그것들, 정말 끈질기게도 가구가 망가지면 새로 갖다 놓더라구요, non? 하지만 망가뜨리는 게 아니라 단순히 옮겨놓기만 해도... 똑같이 새로 갖다 놓더란 말이죠.",shape=box,color=blue];
		j317823914 -> j4036325072;
	j380005824 [label="Evaluate expressions",color=orange];
		j380005824 -> j2147609872 [label="MarieEntrati3a",color=purple];
		j380005824 -> j2147609872 [label="MarieEntrati3b",color=purple];
