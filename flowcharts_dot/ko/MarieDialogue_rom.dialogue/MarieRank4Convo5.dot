	1652 [label="뭐에 그리 정신이 팔리셨는데요? Mécontents의 불만을 정리하는 것보다 더 중요한 일들이 있나요?",shape=box,color=blue];
		1652 -> 1676;
	1653 [label="Mécontents의 불만을 정리하는 일 보다 더 어려운 일이 있나요?",shape=box,color=blue];
		1653 -> 1677;
	1654 [label="Oh, magnifique !",shape=box,color=blue];
		1654 -> 1678;
	1655 [label="Chat ends.",color=orange];
	1656 [label="알브레히트의 딸, 오일러리아 - 어머니라고 알려진 존재와 그녀의 가족들이 이제까지 데이모스를 관리하고 있었어.",shape=box,color=red];
		1656 -> 1679;
	2937 [label="가구를 전부 옮기고, 네크라마이트들이 새 가구를 들여놓고, 그걸 또... 반복하는 행동을 막을 수 있는게 뭐가 있을까요 ? 다 팔아버리는 거에요. Make profit de ce mobilier étrange !",shape=box,color=blue];
		2937 -> 2938;
		2937 -> 2939;
		2937 -> 2940;
	1658 [label="Le Cardinal에 대한 우리의 의견 불일치가 해결되지 않았다는 점을 알고 있어요. 전 이 대화를 교양있게 이어가려고 노력하고 있습니다.",shape=box,color=blue];
		1658 -> 1680;
	1661 [label="당신이 비난받을 만한 사람들을 지적할 기회를 찾지 않고 갈등을 해소하는 것에 대한 논의를 원치 않는다는 거 잘 이해하고 있습니다.",shape=box,color=blue];
		1661 -> 1680;
	1657 [label="Oui ! 당신께서 제게 늘 상기시켜 주듯이, 당신은 그분을 un monstre로 여기고 있죠 ! 그분의 마음속에는 악의와 공허함만이 가득하다고요 !",shape=box,color=blue];
		1657 -> 1680;
	1659 [label="당신이 le Cardinal의 영혼을 위한 이 전쟁에서 제 편이라고 생각했습니다만 ?",shape=box,color=blue];
		1659 -> 1681;
	1660 [label="당신이 le Cardinal에 대해 아직 결정을 못 내리신 줄 알았는데요 ? 아니면 이제 맘을 정하신건가요 ?",shape=box,color=blue];
		1660 -> 1682;
		1660 -> 1683;
	1668 [label="Oui. M'sieur 태그퍼와 함께 배우고 있어요...",shape=box,color=blue];
		1668 -> 1686;
	1662 [label="딱지 앉은 상처에 대해서 나한테 함부로 말하지 마세요, 늑대씨. 지난번 le Cardianl에 대해 얘기했을 때 상처가 아직 아물지도 않았어요.",shape=box,color=blue];
		1662 -> 1680;
	1663 [label="Oui, 하지만 이전에 말씀하셨잖아요 - 우리는 서로가 고통받아서 얻은 상처에 대해서 서로 비난하는 걸 멈춰야 한다고요.",shape=box,color=blue];
		1663 -> 1684;
	1664 [label="당신이 Le Cadinal에게 상처를 입었다고 생각해서 그분을 끔찍한 monstre로 여기시는 거 알고 있어요.",shape=box,color=blue];
		1664 -> 1680;
	1665 [label="당신이 le Cardinal의 영혼을 위한 이 전쟁에서 제 편이라는 걸 알고 있어요. 이에 대해서 영원히 감사드릴 거에요.",shape=box,color=blue];
		1665 -> 1666;
	1667 [label="당신이 그분에 대한 판단을 유보하고 있다는 걸 알고 있어요. 그 점에 대해서 매우 감사드리고 있어요.",shape=box,color=blue];
		1667 -> 1666;
	1666 [label="다른 이들이 그분을 탓하고 있는 걸 알지만, 우리가 온전히 하나로 모여야 할 때 분열된 채로 피 흘리는 모습을 보고 싶지 않아요.",shape=box,color=blue];
		1666 -> 1685;
	1675 [label="Oui, - M'sieur 태그퍼와 함께 - 모두가 같은 기준을 가지고 있는게 아니라는 걸 배우고 있지만요.",shape=box,color=blue];
		1675 -> 1686;
	1669 [label="그리고 당신께서 제게 \"친절히\" 지적해 주신 것처럼, 다른 이들이 같은 기준을 가지고 있는 게 아니라는 것을 배우고 있습니다, non ?",shape=box,color=blue];
		1669 -> 1680;
	1670 [label="Oui, 맞아요 ! Le Cadinal께서 떠나신 걸 비난하진 않으나, 그분의 업적은 sacro-saint -",shape=box,color=blue];
		1670 -> 1666;
	1671 [label="그리고 당신이 Le Cadinal에게 상처를 입었다고 생각해서 그분을 끔찍한 monstre로 여기시는 거 알고 있어요.",shape=box,color=blue];
		1671 -> 1680;
	1672 [label="당신이 le Cardinal의 영혼을 위한 이 전쟁에서 제 편이라는 걸 알고 있어요. 이에 대해서 영원히 감사드릴 거에요.",shape=box,color=blue];
		1672 -> 1666;
	1673 [label="당신이 그분에 대한 판단을 유보하고 있다는 걸 알고 있어요. 그 점에 대해서 매우 감사드리고 있어요.",shape=box,color=blue];
		1673 -> 1666;
	1674 [label="다른 이들이 자신이 받은 고통에 대해 그분을 비난하는 데 급급한 반면, 전 단지 우리가 분열되서 고통받는 모습을 보고 싶지 않아서 그래요.",shape=box,color=blue];
		1674 -> 1685;
	1676 [label="농담이에요, 농담 ! 당신이 얼마나 바쁜지, 얼마나 많은 곳에서, 얼마나 많은 시간선에서 당신을 필요로 하는지 가늠도 할 수 없어요.",shape=box,color=blue];
		1676 -> 1678;
	1677 [label="농담이에요, 농담 ! 가족분들이 얼마나 힘드셨을지 가늠할 수 없어서요. 그리고 그걸 풀어내는 것도 얼마나 힘든지도요.",shape=box,color=blue];
		1677 -> 1678;
	1678 [label="가족분들의 문제가 해결되지 않은 상태에서 우리가 그분들에게 환대를 받을 수 있을지조차 의문이에요. 더 큰 문제가 아직 해결되지 않은 채 남아있어요 -",shape=box,color=blue];
		1678 -> 1637;
	1679 [label="이 곳과 보이드 에너지를 근원계로 펌핑해내는 심장을 지켜보고, 우리 모두에게... 실제로, 알브레히트 엔트라티가 떠난 이후로도 이 힘을 계속 사용할 수 있게 해줬어.",shape=box,color=red];
		1679 -> 1687;
	2938 [label="엔트라티 의자에 대한 시장성이 크지 않아서 잘 모르겠네...",shape=box,color=red];
		2938 -> 2942;
	2939 [label="결국엔 시장에 흘러넘쳐날 정도로 재고가 쌓이지 않을까? 꽤 싸게 팔아야 할 것 같기도...",shape=box,color=red];
		2939 -> 2942;
	2940 [label="훌륭해. 아무 문제 없어 보여.",shape=box,color=red];
		2940 -> 2941;
	1680 [label="그리고 두 주제가 불가분의 관계라는 걸 알기에, 오늘은 생산적인 토론을 유지해주시길 부탁드려요, oui ?",shape=box,color=blue];
		1680 -> 1688;
	1681 [label="당신의 속임수는 뭐죠, 늑대씨 ? 아니면 작은 마리는 당신에게 있어서 un jeu일 뿐인가요 ?",shape=box,color=blue];
		1681 -> 1689;
		1681 -> 1683;
	1682 [label="그 인간이 벌여왔던 짓들이 필요한 행동이었냐에 대해선 확실히 결정하진 못했어. 하지만 그 차가운 본성은 의심할 여지조차 없지.",shape=box,color=red];
		1682 -> 1680;
	1683 [label="당신 편인 척 하는 거에 지쳤어, 미안.",shape=box,color=red];
		1683 -> 1690;
	1686 [label="우리는 서로가 고통받아서 얻은 상처에 대해서 서로 비난하는 걸 멈춰야 한다고요.",shape=box,color=blue];
		1686 -> 1684;
	1684 [label="Le Cadinal을 비난하는 것에는 동의하지 않으나, 우리가 온전히 하나로 모여야 할 때 분열된 채로 피 흘리는 모습을 보고 싶지 않아요.",shape=box,color=blue];
		1684 -> 1691;
		1684 -> 1692;
	1685 [label="누구의 잘못인지는 중요하지 않으며, 우리는 서로가 겪은 고통에 대해 서로를 비난하는 걸 멈춰야 해요.",shape=box,color=blue];
		1685 -> 1691;
		1685 -> 1692;
	1687 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1687 -> 1693 [label=true,color=green];
		1687 -> 1694 [label=false,color=brown];
	2942 [label="풉 ! 아직도 가치있는 실험이라고 생각하거든요. 수많은 책장으로 악마를 가둬둘 수 있을지도 몰라요 !",shape=box,color=blue];
		2942 -> 2943;
	2941 [label="당신의 비꼬는 언사는 무시하도록 할게요. 왜냐하면 이건 가치있는 실험이라고 생각하거든요. 수많은 책장으로 악마를 가둬둘 수 있을지도 몰라요 !",shape=box,color=blue];
		2941 -> 2943;
	1688 [label="전 논쟁을 벌이기 보다는...이 이상한 공존 속에서 서로 살아가는 데 도움을 줄 수 있는 방법을 찾고 있어요.",shape=box,color=blue];
		1688 -> 1686;
	1689 [label="아니, 게임이 아니야. 엔트라티는 믿을 수 없고, 당신 편인 척 하는 것 외에는 어떻게 설득해야 할지를 모르겠어.",shape=box,color=red];
		1689 -> 1695;
	1690 [label="Oui ? 글쎄요, 기쁜 마음으로 말씀드리는데, 더 이상 그러실 필요 없습니다.",shape=box,color=blue];
		1690 -> 1696;
	1691 [label="모두가 함께, 하나되어, 우리는... 이상한 가족인 셈이지. 하지만, 그럼에도 불구하고 가족은 가족이니까.",shape=box,color=red];
		1691 -> 1697;
	1692 [label="우리는 서로 떨어져 있을 때보다 함께 있을 때 더 강할테니까.",shape=box,color=red];
		1692 -> 1698;
		1692 -> 1699;
	1693 [label="그녀는 알브레히트의 부재를 받아들였고, 가족들과 화해했지만, 그건 힘든 일이었어.",shape=box,color=red];
		1693 -> 1700;
	1694 [label="그녀는 알브레히트의 부재를 받아들이지 못했고, 가족들은 서로의 목을 조르고 있는 형국이었어.",shape=box,color=red];
		1694 -> 1701;
	2943 [label="+20 Chemistry",color=orange];
		2943 -> 2944;
	1695 [label="Oui ? 글쎄요, 기쁜 마음으로 말씀드리는데, 당신은 실패하셨어요.",shape=box,color=blue];
		1695 -> 1696;
	1696 [label="Update boolean MarieEntratiFan1",color=orange];
