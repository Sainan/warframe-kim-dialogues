digraph {
	"MarieRank3Convo2 begins." [color=orange];
		"MarieRank3Convo2 begins." -> j3102612293;
	j3102612293 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3102612293 -> j369807617;
	j369807617 [label="Check boolean LoidFamilyComplete",color=orange];
		j369807617 -> j2024291761 [label=true,color=green];
		j369807617 -> j1668831657 [label=false,color=brown];
	j2024291761 [label="제가 infirme하다고 생각하지 않으셨으면 좋겠지만... 때때로 이런 일을 전에 한 적이 있는 듯한 이상한 느낌을 받거든요 ?",shape=box,color=blue];
		j2024291761 -> j1159626169;
	j1668831657 [label="Check boolean MarieFamily1",color=orange];
		j1668831657 -> j1175007004 [label=true,color=green];
		j1668831657 -> j1768244930 [label=false,color=brown];
	j1159626169 [label="이런 대화를 나눴었고... 이런 사람들을 만났었고... 불가능한 일이죠, non ?",shape=box,color=blue];
		j1159626169 -> j784241637;
	j1175007004 [label="Le Cardinal의 famille에 대해 더 자세히 말씀해 주시겠어요 ? 그 분의 과거에 대해서 알고 싶어요.",shape=box,color=blue];
		j1175007004 -> j168622845;
		j1175007004 -> j1384036298;
		j1175007004 -> j3039724897;
	j1768244930 [label="Le Cardinal의 famille에 대해 좀 더 자세히 말씀해 주시겠어요 ? 그 분의 과거에 대해서 알고 싶어요.",shape=box,color=blue];
		j1768244930 -> j168622845;
		j1768244930 -> j1384036298;
		j1768244930 -> j3039724897;
	j784241637 [label="+20 Chemistry",color=orange];
		j784241637 -> j1047926691;
	j168622845 [label="알고 있는 걸 모두 말해줄 순 있지만 당신이 생각하는 것만큼 많지는 않아.",shape=box,color=red];
		j168622845 -> j2717209484;
	j1384036298 [label="오. 물론이지, 그치만.. 로이드랑 이야기하는 게 더 나을 것 같은데?",shape=box,color=red];
		j1384036298 -> j1281093546;
	j3039724897 [label="[종료.]",shape=box,color=red];
		j3039724897 -> "Chat ends.";
	j1047926691 [label="우린 이걸 déjà vu라 불러요. 혈청과 시간 여행 때문이겠죠. C'est la vie !",shape=box,color=blue];
		j1047926691 -> "Chat ends.";
	j2717209484 [label="말씀해주는 모든 것들을 소중히 여길게요. Promis !",shape=box,color=blue];
		j2717209484 -> j3885413349;
	j1281093546 [label="Le Cardinal의 얘기가 나와서 말인데... Monsieur 로이드께서 꽤 심하게 맘을 다치신 것 같아요. 너무 과하게 말씀드리고 싶진 않지만요.",shape=box,color=blue];
		j1281093546 -> j3885413349;
	"Chat ends." [color=orange];
	j3885413349 [label="특히 제가 avec une certaine joie, 다른 사람들은 그런 것 같지 않아서요.",shape=box,color=blue];
		j3885413349 -> j1361716132;
		j3885413349 -> j560324856;
	j1361716132 [label="누구에 대해서 알고 싶은데?",shape=box,color=red];
		j1361716132 -> j3441959150;
	j560324856 [label="음, 위층에 어머니, 아버지, 아들, 딸 그리고 할머니가 계시지.",shape=box,color=red];
		j560324856 -> j3441959150;
	j3441959150 [label="한 가지만 먼저 알려주시겠어요 ? 제가 물어볼 때마다 악마가 마치 본인만 아는 농담을 들은 듯 절 보고 웃어요. Grand-mère. 할머니라던가요.",shape=box,color=blue];
		j3441959150 -> j3026210913;
	j3026210913 [label="Le Cardinal의 부인은 아니시잖아요, non ?",shape=box,color=blue];
		j3026210913 -> j3058087908;
	j3058087908 [label="아니. 아버지의 어머니. 그러니까 어머니의 시어머니 되셔.",shape=box,color=red];
		j3058087908 -> j2361505767;
	j2361505767 [label="Je... vois. 그리고... 왜 그 분들을 이름으로서 부르지 않으시는 거죠 ? Ne serait-ce pas plus simple ?",shape=box,color=blue];
		j2361505767 -> j310924734;
		j2361505767 -> j504798744;
	j310924734 [label="긴 이야기로 듣고 싶어?",shape=box,color=red];
		j310924734 -> j2115172931;
	j504798744 [label="요약해줄게.",shape=box,color=red];
		j504798744 -> j1883087339;
	j2115172931 [label="Oui ! 당분간 가야할 곳도 없으니까요.",shape=box,color=blue];
		j2115172931 -> j389850401;
	j1883087339 [label="오로킨 제국이 붕괴했을 때 윗층에 살던 가족들이 이곳에 갇혔어. 엔트라티의 손자인 아들이 감염체를 풀어버렸지.",shape=box,color=red];
		j1883087339 -> j3998906131;
	j389850401 [label="음, 우린 데이모스라는 위성에 있어. 아주 오래전, 센티언트들을 물리치기 위해 필사적인 시도로 이곳에서 생물학 폭탄이 폭발했어.",shape=box,color=red];
		j389850401 -> j335091828;
	j3998906131 [label="Par Sol ! 의도적으로요 ?",shape=box,color=blue];
		j3998906131 -> j2753523360;
	j335091828 [label="오로킨이 오래전에 전쟁을 벌였던 자들 말이죠 ? 우리가 악마와 함께 다크 리프랙토리에서 봤던 자들, oui ?",shape=box,color=blue];
		j335091828 -> j3144090522;
	j2753523360 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j2753523360 -> j3555033791 [label=true,color=green];
		j2753523360 -> j2150155305 [label=true,color=green];
		j2753523360 -> j2150155305 [label=false,color=brown];
		j2753523360 -> j2667606251 [label=false,color=brown];
	j3144090522 [label="맞아. 그들은 감염체를 사용해서 센티언트와 싸우려 했어. 하지만 데이모스가 압도당해버렸지. 가족들은 네크랄리스크 - 바로 우리 위 - 에 피난처에 있듯 숨어 있어.",shape=box,color=red];
		j3144090522 -> j3063391824;
	j3555033791 [label=" 아니, 그건 사고였다고 생각해. 좋은 의도로 했을 거야.",shape=box,color=red];
		j3555033791 -> j2541661697;
	j2150155305 [label="진실에 대해선 아직 잘 모르지만, 더 자세히 알 때까지 판단을 보류할래.",shape=box,color=red];
		j2150155305 -> j2541661697;
	j2667606251 [label="진실에 대해선 아직 잘 모르지만, 아들은 거만해. 그 정도는 말해줄 수 있을 것 같아.",shape=box,color=red];
		j2667606251 -> j429660108;
	j3063391824 [label="아들, 그러니까 엔트라티의 손자는 감염된 동물들을 보존하고 연구하는 데 열중했거든.",shape=box,color=red];
		j3063391824 -> j3566927437;
	j2541661697 [label="+10 Chemistry",color=orange];
		j2541661697 -> j4074097386;
	j429660108 [label="망측하네요. 그와 우리를 위해, 그게 사실이 아니길 빌어요. 계속해 주세요.",shape=box,color=blue];
		j429660108 -> j3498357726;
	j3566927437 [label="오, 솔이시여... 좋은 의도로 그랬던 건가요 ?",shape=box,color=blue];
		j3566927437 -> j2755410679;
	j4074097386 [label="굉장히 친절하시네요. Continuez, s'il vous plaît.",shape=box,color=blue];
		j4074097386 -> j3498357726;
	j3498357726 [label="음, 네크랄리스크에 갇혀 있고, 슬픔에 잠겨 있으며, 구출해 줄 오로킨 제국은 없고, 이제는 감염이 새어 들어오고 있어...",shape=box,color=red];
		j3498357726 -> j728138709;
	j2755410679 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j2755410679 -> j3947776296 [label=true,color=green];
		j2755410679 -> j1289064070 [label=true,color=green];
		j2755410679 -> j3785279193 [label=true,color=green];
		j2755410679 -> j3947776296 [label=false,color=brown];
		j2755410679 -> j1289064070 [label=false,color=brown];
		j2755410679 -> j2421739568 [label=false,color=brown];
	j728138709 [label="가족들은 서로에게 등을 돌렸어. 내부에서부터 서로를 찢어 발겼지. 그리고 나머지는 감염이 마무리를 지어버렸어. 가족들의 이름까지 빼앗아 가버린 거야. ",shape=box,color=red];
		j728138709 -> j608599598;
	j3947776296 [label="응, 그랬으리라 믿고 있어. 아들은 진심으로 그 생물들을 아끼니까.",shape=box,color=red];
		j3947776296 -> j91398036;
	j1289064070 [label="유감스럽게도, 그건 중요치 않고, 무모한 피해만 이미 일어나버렸어.",shape=box,color=red];
		j1289064070 -> j912244166;
	j3785279193 [label="아니, 오만함이 아들을 부추겼어. 비록 그게 사고였다고 주장하더라도 말이야.",shape=box,color=red];
		j3785279193 -> j429660108;
	j2421739568 [label="진실에 대해선 아직 잘 모르지만, 아들은 거만해. 그 정도는 말해줄 수 있을 것 같아.",shape=box,color=red];
		j2421739568 -> j429660108;
	j608599598 [label="이름의 부재는 잔인함의 가장 궁극적인 형태에요...",shape=box,color=blue];
		j608599598 -> j482800561;
	j91398036 [label="+10 Chemistry",color=orange];
		j91398036 -> j2749043936;
	j912244166 [label="+5 Chemistry",color=orange];
		j912244166 -> j1507963048;
	j482800561 [label="Boolean MarieFamily2 is now true.",color=orange];
		j482800561 -> j696297381;
		j482800561 -> j2549599044;
		j482800561 -> j2144036147;
	j2749043936 [label="아들이 카비아에 대해 어찌 생각할지 궁금하네요... 그들을 만날 수 없다는 건 정말 안타까운 일이에요...",shape=box,color=blue];
		j2749043936 -> j1629008235;
		j2749043936 -> j3628898771;
	j1507963048 [label="스스로가 가지는 의도의 순수함만이 중요하다면, 세상은 아름다운 곳이 될텐데, non ? C'est la vie.",shape=box,color=blue];
		j1507963048 -> j3523391480;
	j696297381 [label="놔버리지만 않는다면 말이야, 할머니처럼.",shape=box,color=red];
		j696297381 -> j453913729;
	j2549599044 [label="솔직히 그리 나쁘지도 않아. 익숙해질 거야.",shape=box,color=red];
		j2549599044 -> j3903892089;
	j2144036147 [label="동물들은 이름이 없지만 아주 행복해 보여. 우린 그저 우리 자신을 위해 동물들에게 이름을 지어주는 거야.",shape=box,color=red];
		j2144036147 -> j4054816891;
	j1629008235 [label="그 생각에 미소가 지어져. 하지만 현명한 선택은 아닌 것 같아.",shape=box,color=red];
		j1629008235 -> j1310874165;
	j3628898771 [label="언젠가 그리 되기를 바라고 있어. 정말이야.",shape=box,color=red];
		j3628898771 -> j3948333923;
	j3523391480 [label="Et ensuite ?",shape=box,color=blue];
		j3523391480 -> j3498357726;
	j453913729 [label="+5 Chemistry",color=orange];
		j453913729 -> j1003388763;
	j3903892089 [label="아 ! Quelle horreur ! 그럴 뜻이 아니었어요 ! 오, 너무 부끄러워요 ! 죄송해요, 그럴 의도가 아니었어요 - 오, 부끄러워라 !",shape=box,color=blue];
		j3903892089 -> j2417223774;
		j3903892089 -> j2220603413;
	j4054816891 [label="+5 Chemistry",color=orange];
		j4054816891 -> j968857735;
	j1310874165 [label="왜 그리 생각하시죠 ?",shape=box,color=blue];
		j1310874165 -> j2962847512;
		j1310874165 -> j4063177751;
	j3948333923 [label="Add 1 to Family counter",color=orange];
		j3948333923 -> j1827137725;
	j1003388763 [label="이제 그 분은 제가 만나고 싶은 여인처럼 들려요... ",shape=box,color=blue];
		j1003388763 -> j3237699167;
	j2417223774 [label="어떻게 보상해 줄 거야?",shape=box,color=red];
		j2417223774 -> j2720075571;
	j2220603413 [label="괜찮아. 그냥 놀린 것뿐이야. 화 안 났어.",shape=box,color=red];
		j2220603413 -> j1948568943;
	j968857735 [label="정말 그러네요 ! 그런 식으론 생각해 본 적이 없었어요. 그리고 스스로 선택할 수도 있죠. 그 자체로 얼마나 자유로운지.",shape=box,color=blue];
		j968857735 -> j3237699167;
	j2962847512 [label="절반의 사람들이 나머지 절반을 \"또 다른 가족\"으로 볼까봐 걱정이야.",shape=box,color=red];
		j2962847512 -> j2327103298;
	j4063177751 [label="위층 상황은... 아무리 좋은 날이라도 불안정해. 가족들을 화나게 하고 싶지 않아.",shape=box,color=red];
		j4063177751 -> j2185142490;
	j1827137725 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j1827137725 -> j2882711411 [label=true,color=green];
		j1827137725 -> j1425825926 [label=false,color=brown];
	j3237699167 [label="너무나도 즐거운 대화였는데, 이제 제가 오찬 준비할 차례라서요. Monsieur 로이드께서 저에게 당신만의 방법으로 제대로 차 대접하는 법을 가르쳐 주고 계세요 !",shape=box,color=blue];
		j3237699167 -> "Chat ends.";
	j2720075571 [label="Maintenant, vous parlez aussi mal que le diable. 아니요, 당신 속임수에 빠지지 않을 거에요.",shape=box,color=blue];
		j2720075571 -> "Chat ends.";
	j1948568943 [label="+5 Chemistry",color=orange];
		j1948568943 -> j1691695431;
	j2327103298 [label="Add 1 to Family counter",color=orange];
		j2327103298 -> j1428084309;
	j2185142490 [label="영혼의 회복력이 얼마나 강한지 아시면 깜짝 놀라실 거에요. 그리고 지금 제 주변에 있는 이들은 너무나 늙었고, 시간에 의해 너무나 단련된 상태죠.",shape=box,color=blue];
		j2185142490 -> j3918357633;
	j2882711411 [label="할 수 있어요. 그것도 생각보다 쉽게. 어떻게 할지만 생각하면 되요. ",shape=box,color=blue];
		j2882711411 -> j511197064;
		j2882711411 -> j4063177751;
	j1425825926 [label="Oui ? 그리고 당신이나 당신의 minuscule copie는 위층의 famille과 어떻게 지내고 있나요 ?",shape=box,color=blue];
		j1425825926 -> j2178360218;
		j1425825926 -> j4063177751;
	j1691695431 [label="오, loué soit Sol ! 궁금한 게 하나 생겼는데요... 그 별명은 어디서 유래됐나요 ? \"Le Drifter ?\"",shape=box,color=blue];
		j1691695431 -> j3955766370;
		j1691695431 -> j1276135779;
	j1428084309 [label="+5 Chemistry",color=orange];
		j1428084309 -> j2056602819;
	j3918357633 [label="+5 Chemistry",color=orange];
		j3918357633 -> j1898447072;
	j511197064 [label="우린 이 문제에 대해서 조심히 접근해야 해. 절반의 사람들이 나머지 절반을 \"또 다른 가족\"으로 볼까봐 걱정이야.",shape=box,color=red];
		j511197064 -> j2327103298;
	j2178360218 [label="천천히. 조심스럽게 진행해야 해. 절반의 사람들이 나머지 절반을 \"또 다른 가족\"으로 볼까봐 걱정이야.",shape=box,color=red];
		j2178360218 -> j2327103298;
	j3955766370 [label="스스로가 직접 고른거면 좋겠네.",shape=box,color=red];
		j3955766370 -> j2292347372;
	j1276135779 [label="솔직히, 기억이 안나.",shape=box,color=red];
		j1276135779 -> j283959892;
	j2056602819 [label="오... Par Sol, 당신이 이 문제를 해결하신 것 같아요 !",shape=box,color=blue];
		j2056602819 -> j738468136;
	j1898447072 [label="당신은 이미 여러 번 가족들을 놀라게 했잖아요. 이번 한 번만이라도 가족들이 당신을 놀라게 해 보세요.",shape=box,color=blue];
		j1898447072 -> j1735831806;
	j2292347372 [label="얼마나 자유로울까요 ! 자신의 이름을 직접 고를 수 있다니. Cathédrale에선, 옷도 직접 고를 수 없었어요. 하 !",shape=box,color=blue];
		j2292347372 -> j3237699167;
	j283959892 [label="당신은 정말 너무나도 많은 mystères를 가지고 있어요 ! ",shape=box,color=blue];
		j283959892 -> j3237699167;
	j738468136 [label="Boolean MarieFamilyOther is now true.",color=orange];
		j738468136 -> j2786660591;
	j1735831806 [label="하지만 제발, 부디, s'il vous plaît, 이야기를 마저 해 주세요. 당신의 작은 늑대 마리는 제대로 사냥하려면 사냥감이 무엇인지 알아야 하니까요, non ?",shape=box,color=blue];
		j1735831806 -> j1354152966;
		j1735831806 -> j2117271086;
