digraph {
	1015 [label="MarieRank3Convo2 begins.",color=orange];
		1015 -> 3736;
	3736 [label="Update boolean MarieLyonAvailable",color=orange];
		3736 -> 2923;
	2923 [label="Check boolean LoidFamilyComplete",color=orange];
		2923 -> 2924 [label=true,color=green];
		2923 -> 1016 [label=false,color=brown];
	2924 [label="제가 infirme하다고 생각하지 않으셨으면 좋겠지만... 때때로 이런 일을 전에 한 적이 있는 듯한 이상한 느낌을 받거든요 ?",shape=box,color=blue];
		2924 -> 2925;
	1016 [label="Check boolean MarieFamily1",color=orange];
		1016 -> 1017 [label=true,color=green];
		1016 -> 1018 [label=false,color=brown];
	2925 [label="이런 대화를 나눴었고... 이런 사람들을 만났었고... 불가능한 일이죠, non ?",shape=box,color=blue];
		2925 -> 2926;
	1017 [label="Le Cardinal의 famille에 대해 더 자세히 말씀해 주시겠어요 ? 그 분의 과거에 대해서 알고 싶어요.",shape=box,color=blue];
		1017 -> 1020;
		1017 -> 1021;
		1017 -> 1019;
	1018 [label="Le Cardinal의 famille에 대해 좀 더 자세히 말씀해 주시겠어요 ? 그 분의 과거에 대해서 알고 싶어요.",shape=box,color=blue];
		1018 -> 1020;
		1018 -> 1021;
		1018 -> 1019;
	2926 [label="+20 Chemistry",color=orange];
		2926 -> 2927;
	1020 [label="알고 있는 걸 모두 말해줄 순 있지만 당신이 생각하는 것만큼 많지는 않아.",shape=box,color=red];
		1020 -> 1023;
	1021 [label="오. 물론이지, 그치만.. 로이드랑 이야기하는 게 더 나을 것 같은데?",shape=box,color=red];
		1021 -> 1024;
	1019 [label="[종료.]",shape=box,color=red];
		1019 -> 1022;
	2927 [label="우린 이걸 déjà vu라 불러요. 혈청과 시간 여행 때문이겠죠. C'est la vie !",shape=box,color=blue];
		2927 -> 2928;
	1023 [label="말씀해주는 모든 것들을 소중히 여길게요. Promis !",shape=box,color=blue];
		1023 -> 1025;
	1024 [label="Le Cardinal의 얘기가 나와서 말인데... Monsieur 로이드께서 꽤 심하게 맘을 다치신 것 같아요. 너무 과하게 말씀드리고 싶진 않지만요.",shape=box,color=blue];
		1024 -> 1025;
	1022 [label="Chat ends.",color=orange];
	2928 [label="Chat ends.",color=orange];
	1025 [label="특히 제가 avec une certaine joie, 다른 사람들은 그런 것 같지 않아서요.",shape=box,color=blue];
		1025 -> 1026;
		1025 -> 1027;
	1026 [label="누구에 대해서 알고 싶은데?",shape=box,color=red];
		1026 -> 1028;
	1027 [label="음, 위층에 어머니, 아버지, 아들, 딸 그리고 할머니가 계시지.",shape=box,color=red];
		1027 -> 1028;
	1028 [label="한 가지만 먼저 알려주시겠어요 ? 제가 물어볼 때마다 악마가 마치 본인만 아는 농담을 들은 듯 절 보고 웃어요. Grand-mère. 할머니라던가요.",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="Le Cardinal의 부인은 아니시잖아요, non ?",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="아니. 아버지의 어머니. 그러니까 어머니의 시어머니 되셔.",shape=box,color=red];
		1030 -> 1031;
	1031 [label="Je... vois. 그리고... 왜 그 분들을 이름으로서 부르지 않으시는 거죠 ? Ne serait-ce pas plus simple ?",shape=box,color=blue];
		1031 -> 1032;
		1031 -> 1033;
	1032 [label="긴 이야기로 듣고 싶어?",shape=box,color=red];
		1032 -> 1034;
	1033 [label="요약해줄게.",shape=box,color=red];
		1033 -> 1035;
	1034 [label="Oui ! 당분간 가야할 곳도 없으니까요.",shape=box,color=blue];
		1034 -> 1036;
	1035 [label="오로킨 제국이 붕괴했을 때 윗층에 살던 가족들이 이곳에 갇혔어. 엔트라티의 손자인 아들이 감염체를 풀어버렸지.",shape=box,color=red];
		1035 -> 1037;
	1036 [label="음, 우린 데이모스라는 위성에 있어. 아주 오래전, 센티언트들을 물리치기 위해 필사적인 시도로 이곳에서 생물학 폭탄이 폭발했어.",shape=box,color=red];
		1036 -> 1038;
	1037 [label="Par Sol ! 의도적으로요 ?",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="오로킨이 오래전에 전쟁을 벌였던 자들 말이죠 ? 우리가 악마와 함께 다크 리프랙토리에서 봤던 자들, oui ?",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1039 -> 1041 [label=true,color=green];
		1039 -> 1042 [label=true,color=green];
		1039 -> 1042 [label=false,color=brown];
		1039 -> 1043 [label=false,color=brown];
	1040 [label="맞아. 그들은 감염체를 사용해서 센티언트와 싸우려 했어. 하지만 데이모스가 압도당해버렸지. 가족들은 네크랄리스크 - 바로 우리 위 - 에 피난처에 있듯 숨어 있어.",shape=box,color=red];
		1040 -> 1044;
	1041 [label=" 아니, 그건 사고였다고 생각해. 좋은 의도로 했을 거야.",shape=box,color=red];
		1041 -> 1045;
	1042 [label="진실에 대해선 아직 잘 모르지만, 더 자세히 알 때까지 판단을 보류할래.",shape=box,color=red];
		1042 -> 1045;
	1043 [label="진실에 대해선 아직 잘 모르지만, 아들은 거만해. 그 정도는 말해줄 수 있을 것 같아.",shape=box,color=red];
		1043 -> 1046;
	1044 [label="아들, 그러니까 엔트라티의 손자는 감염된 동물들을 보존하고 연구하는 데 열중했거든.",shape=box,color=red];
		1044 -> 1047;
	1045 [label="+10 Chemistry",color=orange];
		1045 -> 1048;
	1046 [label="망측하네요. 그와 우리를 위해, 그게 사실이 아니길 빌어요. 계속해 주세요.",shape=box,color=blue];
		1046 -> 1049;
	1047 [label="오, 솔이시여... 좋은 의도로 그랬던 건가요 ?",shape=box,color=blue];
		1047 -> 1076;
	1048 [label="굉장히 친절하시네요. Continuez, s'il vous plaît.",shape=box,color=blue];
		1048 -> 1049;
	1049 [label="음, 네크랄리스크에 갇혀 있고, 슬픔에 잠겨 있으며, 구출해 줄 오로킨 제국은 없고, 이제는 감염이 새어 들어오고 있어...",shape=box,color=red];
		1049 -> 1053;
	1076 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1076 -> 1051 [label=true,color=green];
		1076 -> 1052 [label=true,color=green];
		1076 -> 1055 [label=true,color=green];
		1076 -> 1051 [label=false,color=brown];
		1076 -> 1052 [label=false,color=brown];
		1076 -> 1054 [label=false,color=brown];
	1053 [label="가족들은 서로에게 등을 돌렸어. 내부에서부터 서로를 찢어 발겼지. 그리고 나머지는 감염이 마무리를 지어버렸어. 가족들의 이름까지 빼앗아 가버린 거야. ",shape=box,color=red];
		1053 -> 1058;
	1051 [label="응, 그랬으리라 믿고 있어. 아들은 진심으로 그 생물들을 아끼니까.",shape=box,color=red];
		1051 -> 1056;
	1052 [label="유감스럽게도, 그건 중요치 않고, 무모한 피해만 이미 일어나버렸어.",shape=box,color=red];
		1052 -> 1057;
	1055 [label="아니, 오만함이 아들을 부추겼어. 비록 그게 사고였다고 주장하더라도 말이야.",shape=box,color=red];
		1055 -> 1059;
	1054 [label="진실에 대해선 아직 잘 모르지만, 아들은 거만해. 그 정도는 말해줄 수 있을 것 같아.",shape=box,color=red];
		1054 -> 1059;
	1058 [label="이름의 부재는 잔인함의 가장 궁극적인 형태에요...",shape=box,color=blue];
		1058 -> 1062;
	1056 [label="+10 Chemistry",color=orange];
		1056 -> 1060;
	1057 [label="+5 Chemistry",color=orange];
		1057 -> 1061;
	1059 [label="망측하네요. 그와 우리를 위해, 그게 사실이 아니길 빌어요. 계속해 주세요.",shape=box,color=blue];
		1059 -> 1049;
	1062 [label="Update boolean MarieFamily2",color=orange];
		1062 -> 1066;
		1062 -> 1067;
		1062 -> 1068;
	1060 [label="아들이 카비아에 대해 어찌 생각할지 궁금하네요... 그들을 만날 수 없다는 건 정말 안타까운 일이에요...",shape=box,color=blue];
		1060 -> 1063;
		1060 -> 1064;
	1061 [label="스스로가 가지는 의도의 순수함만이 중요하다면, 세상은 아름다운 곳이 될텐데, non ? C'est la vie.",shape=box,color=blue];
		1061 -> 1065;
	1066 [label="놔버리지만 않는다면 말이야, 할머니처럼.",shape=box,color=red];
		1066 -> 1071;
	1067 [label="솔직히 그리 나쁘지도 않아. 익숙해질 거야.",shape=box,color=red];
		1067 -> 1072;
	1068 [label="동물들은 이름이 없지만 아주 행복해 보여. 우린 그저 우리 자신을 위해 동물들에게 이름을 지어주는 거야.",shape=box,color=red];
		1068 -> 1073;
	1063 [label="그 생각에 미소가 지어져. 하지만 현명한 선택은 아닌 것 같아.",shape=box,color=red];
		1063 -> 1069;
	1064 [label="언젠가 그리 되기를 바라고 있어. 정말이야.",shape=box,color=red];
		1064 -> 1070;
	1065 [label="Et ensuite ?",shape=box,color=blue];
		1065 -> 1049;
	1071 [label="+5 Chemistry",color=orange];
		1071 -> 1077;
	1072 [label="아 ! Quelle horreur ! 그럴 뜻이 아니었어요 ! 오, 너무 부끄러워요 ! 죄송해요, 그럴 의도가 아니었어요 - 오, 부끄러워라 !",shape=box,color=blue];
		1072 -> 1078;
		1072 -> 1079;
	1073 [label="+5 Chemistry",color=orange];
		1073 -> 1080;
	1069 [label="왜 그리 생각하시죠 ?",shape=box,color=blue];
		1069 -> 1074;
		1069 -> 1075;
	1070 [label="Add 1 to Family",color=orange];
		1070 -> 1050;
	1077 [label="이제 그 분은 제가 만나고 싶은 여인처럼 들려요... ",shape=box,color=blue];
		1077 -> 1085;
	1078 [label="어떻게 보상해 줄 거야?",shape=box,color=red];
		1078 -> 1086;
	1079 [label="괜찮아. 그냥 놀린 것뿐이야. 화 안 났어.",shape=box,color=red];
		1079 -> 1087;
	1080 [label="정말 그러네요 ! 그런 식으론 생각해 본 적이 없었어요. 그리고 스스로 선택할 수도 있죠. 그 자체로 얼마나 자유로운지.",shape=box,color=blue];
		1080 -> 1085;
	1074 [label="절반의 사람들이 나머지 절반을 \"또 다른 가족\"으로 볼까봐 걱정이야.",shape=box,color=red];
		1074 -> 1081;
	1075 [label="위층 상황은... 아무리 좋은 날이라도 불안정해. 가족들을 화나게 하고 싶지 않아.",shape=box,color=red];
		1075 -> 1082;
	1050 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1050 -> 1083 [label=true,color=green];
		1050 -> 1084 [label=false,color=brown];
	1085 [label="너무나도 즐거운 대화였는데, 이제 제가 오찬 준비할 차례라서요. Monsieur 로이드께서 저에게 당신만의 방법으로 제대로 차 대접하는 법을 가르쳐 주고 계세요 !",shape=box,color=blue];
		1085 -> 1094;
	1086 [label="Maintenant, vous parlez aussi mal que le diable. 아니요, 당신 속임수에 빠지지 않을 거에요.",shape=box,color=blue];
		1086 -> 1095;
	1087 [label="+5 Chemistry",color=orange];
		1087 -> 1096;
	1081 [label="Add 1 to Family",color=orange];
		1081 -> 1088;
	1082 [label="영혼의 회복력이 얼마나 강한지 아시면 깜짝 놀라실 거에요. 그리고 지금 제 주변에 있는 이들은 너무나 늙었고, 시간에 의해 너무나 단련된 상태죠.",shape=box,color=blue];
		1082 -> 1089;
	1083 [label="할 수 있어요. 그것도 생각보다 쉽게. 어떻게 할지만 생각하면 되요. ",shape=box,color=blue];
		1083 -> 1090;
		1083 -> 1091;
	1084 [label="Oui ? 그리고 당신이나 당신의 minuscule copie는 위층의 famille과 어떻게 지내고 있나요 ?",shape=box,color=blue];
		1084 -> 1092;
		1084 -> 1093;
	1094 [label="Chat ends.",color=orange];
	1095 [label="Chat ends.",color=orange];
	1096 [label="오, loué soit Sol ! 궁금한 게 하나 생겼는데요... 그 별명은 어디서 유래됐나요 ? \"Le Drifter ?\"",shape=box,color=blue];
		1096 -> 1099;
		1096 -> 1100;
	1088 [label="+5 Chemistry",color=orange];
		1088 -> 1097;
	1089 [label="+5 Chemistry",color=orange];
		1089 -> 1098;
	1090 [label="우린 이 문제에 대해서 조심히 접근해야 해. 절반의 사람들이 나머지 절반을 \"또 다른 가족\"으로 볼까봐 걱정이야.",shape=box,color=red];
		1090 -> 1081;
	1091 [label="위층 상황은... 아무리 좋은 날이라도 불안정해. 가족들을 화나게 하고 싶지 않아.",shape=box,color=red];
		1091 -> 1082;
	1092 [label="천천히. 조심스럽게 진행해야 해. 절반의 사람들이 나머지 절반을 \"또 다른 가족\"으로 볼까봐 걱정이야.",shape=box,color=red];
		1092 -> 1081;
	1093 [label="위층 상황은... 아무리 좋은 날이라도 불안정해. 가족들을 화나게 하고 싶지 않아.",shape=box,color=red];
		1093 -> 1082;
	1099 [label="스스로가 직접 고른거면 좋겠네.",shape=box,color=red];
		1099 -> 1103;
	1100 [label="솔직히, 기억이 안나.",shape=box,color=red];
		1100 -> 1104;
	1097 [label="오... Par Sol, 당신이 이 문제를 해결하신 것 같아요 !",shape=box,color=blue];
		1097 -> 1101;
	1098 [label="당신은 이미 여러 번 가족들을 놀라게 했잖아요. 이번 한 번만이라도 가족들이 당신을 놀라게 해 보세요.",shape=box,color=blue];
		1098 -> 1102;
	1103 [label="얼마나 자유로울까요 ! 자신의 이름을 직접 고를 수 있다니. Cathédrale에선, 옷도 직접 고를 수 없었어요. 하 !",shape=box,color=blue];
		1103 -> 1085;
	1104 [label="당신은 정말 너무나도 많은 mystères를 가지고 있어요 ! ",shape=box,color=blue];
		1104 -> 1085;
	1101 [label="Update boolean MarieFamilyOther",color=orange];
		1101 -> 1105;
	1102 [label="하지만 제발, 부디, s'il vous plaît, 이야기를 마저 해 주세요. 당신의 작은 늑대 마리는 제대로 사냥하려면 사냥감이 무엇인지 알아야 하니까요, non ?",shape=box,color=blue];
		1102 -> 1106;
		1102 -> 1107;
		1102 -> 3914;
	1105 [label="너무 흥분해서 스스로를 잊었네요 - je suis assise ici, remuant sur ma chaise !",shape=box,color=blue];
		1105 -> 1102;
	1106 [label="어디까지 했더라?",shape=box,color=red];
		1106 -> 1108;
	1107 [label="그거 조금 사악해 보였는데, 안 그래?",shape=box,color=red];
		1107 -> 1109;
	3914 [label="당신이 날 사냥해줬음 하고 바라고 있는 걸...",shape=box,color=red];
		3914 -> 3915;
	1108 [label="아들이 Animaux Infestés를 너무 가까이서 불러 냈다는 부분이요.",shape=box,color=blue];
		1108 -> 1049;
	1109 [label="Peut-être ! 하지만 선이라는 이름으로 조금 악한 짓을 한다고 해서 뭐가 나쁘겠어요, 흠 ?",shape=box,color=blue];
		1109 -> 1110;
		1109 -> 1111;
	3915 [label="Update boolean DrifterMarie",color=orange];
		3915 -> 3913;
	1110 [label="맞아... 어쨌든, 이야기로 돌아가자.",shape=box,color=red];
		1110 -> 1049;
	1111 [label="오해하지마. 꽤 즐겁게 받아들였으니까.",shape=box,color=red];
		1111 -> 1112;
	3913 [label="절 망가뜨릴 속셈이세요 ?! 방금 크게 소리 질러버렸고, Monsieur 로이드께서 오셔서 괜찮냐고 물어보셨어요. 쥐를 봤다고 거짓말을 해버렸는데, 이 시기엔 쥐가 없다는 대답까지 들어버렸다고요 !",shape=box,color=blue];
		3913 -> 3916;
	1112 [label="하 ! 그럴 줄 알았어요. 이제, 실없는 소리 그만하시고 본론으로 돌아가요. 아들이 Animaux Infestés를 너무 가까이서 불러 냈다고요, oui?",shape=box,color=blue];
		1112 -> 1049;
	3916 [label="+5 Chemistry",color=orange];
		3916 -> 3917;
	3917 [label="Quelle méchanceté, tu es terrible ! Je te déteste et tu me fais rougir maintenant !",shape=box,color=blue];
		3917 -> 3918;
		3917 -> 3919;
	3918 [label="나한테 화났어?",shape=box,color=red];
		3918 -> 3920;
	3919 [label="그렇구나... 어쨌든, 이야기로 돌아가자.",shape=box,color=red];
		3919 -> 1049;
	3920 [label="Non ! 이야기 마저 계속해 주세요 !",shape=box,color=blue];
