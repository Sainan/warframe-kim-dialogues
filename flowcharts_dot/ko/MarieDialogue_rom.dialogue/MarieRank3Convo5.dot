	1362 [label="+10 Chemistry",color=orange];
		1362 -> 1366;
	1360 [label="그렇지 않다면? 항상 도움이 되는 해결책이 있어요 !",shape=box,color=blue];
		1360 -> 1364;
	1363 [label="하 ! Oui, 그렇고 말고요. Très bien, 나아졌다니 다행입니다.",shape=box,color=blue];
		1363 -> 1367;
	1365 [label="Oui, 하지만 그렇다면 당신은 우리가 알고 사랑해 마지 않는 그 멋진 늑대가 아니게 되겠죠? 솔께선 당신을 딱 필요한 자리에 앉혀주신 것 같아요.",shape=box,color=blue];
		1365 -> 1369;
	1366 [label="Oui, 전적으로 동의해요. 전쟁을 위해 태어난 이는 없죠. 뭐, 제가 들은 \"그린-이어\"는 제외하고요. 설령 그렇다 해도...",shape=box,color=blue];
		1366 -> 1370;
	1364 [label="Des pâtisseries !",shape=box,color=blue];
		1364 -> 1368;
	1367 [label="아 ! 오찬이 나왔네요. 가봐야겠어요. 나중에 봐요, 늑대씨. 이 이야기를 해서 정말 다행이에요.",shape=box,color=blue];
		1367 -> 1371;
	1369 [label="하지만 제 말이 무슨 의미인지는 아시겠죠. 상대방이 어떤 교육과 지도를 받았는지 보면, 당신도 똑같은 걸 갖고 싶어지니까요. 특히 당신이 그렇게 혼자였을 때는 더욱 그렇지요.",shape=box,color=blue];
