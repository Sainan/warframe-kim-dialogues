		3950 -> 3951;
	1301 [label="전 une Soeur de Sol입니다. 전투는... 제 운명이 아니에요. 살상도요. 카비아들은 속삭임이 살아있는 존재가 아니라고 말해줍니다만 - 제가 마주하는 다른 이들은 어떨까요 ?",shape=box,color=blue];
		1301 -> 1310;
	1302 [label="+5 Chemistry",color=orange];
		1302 -> 1311;
	1297 [label="그럼 더 이상 캐묻지 않겠습니다. 때로는 말로 표현하기 어렵다는 걸 아니까요.",shape=box,color=blue];
		1297 -> 1306;
	1298 [label="Cathédrale에 그런 수녀님이 계셨어요. 야단법석이란 법석은 다 떠셨죠. 언젠가 새벽 3시에 은제 도구들을 닦고 계신 걸 본 적도 있었어요.",shape=box,color=blue];
		1298 -> 1307;
	1299 [label="아, oui. 무슨 말씀이신지 알 것 같아요. 태양 위로 움직이는, 일종의... 구름 같은 거군요.",shape=box,color=blue];
		1299 -> 1308;
	1300 [label="한 방울씩 물이 채워지는 컵처럼, non ?",shape=box,color=blue];
