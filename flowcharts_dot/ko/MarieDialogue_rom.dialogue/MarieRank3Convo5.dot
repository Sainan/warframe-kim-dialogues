		1323 -> 1332;
	1324 [label="- 제가 누구의 신앙을 따르든, 당신이 따르든 따르지 않든, 당신을 용서합니다. 당신이 리온 같았다면, 10번은 매질해야하는 형벌이라고 말했을 겁니다.",shape=box,color=blue];
		1324 -> 1333;
	1328 [label="Oui ! 당신의 minuscule copie와 triste 이야기요... 생각만 해도 눈물이 나올려고 하네요. Famille라고 생각했던 이들에 의해 전쟁 기계로 변했지요 ?",shape=box,color=blue];
		1328 -> 1337;
	1329 [label="Oui ! 제가 듣기로는 당신이 지금처럼 싸우는 법을 배우느라 고생을 꽤나 했다고 전해지더군요. 죽음은 잔혹한 스승이죠, 전 상상도 못하겠지만...",shape=box,color=blue];
		1329 -> 1337;
	1325 [label="이 말들이 당신께 중요할 지는 모르겠습니다. 아니면 윙윙거리는 machinerie 위에 빛나는 점 몇 개에 불과할지도 모르지요.",shape=box,color=blue];
		1325 -> 1334;
	1335 [label="당신의 그 친구분들에 대해선 잘 모르지만, 제 생각엔 - 그분들에게 당신이 있어서 정말 다행이라고 생각해요.",shape=box,color=blue];
		1335 -> 1306;
	1327 [label="예배당에 당신과 비슷한 기질을 가진 신부님이 계셨던 것 같아요. 그분은 모든 걸 견뎌내셨죠 - 더 이상 견뎌내실 수 없을 때까지요.",shape=box,color=blue];
