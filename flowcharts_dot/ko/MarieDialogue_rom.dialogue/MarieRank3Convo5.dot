		1342 -> 1347;
	1344 [label="+10 Chemistry",color=orange];
		1344 -> 1350;
	1345 [label="+5 Chemistry",color=orange];
		1345 -> 1351;
	1346 [label="그저 당신에게 어떻게 지냈냐고 물었을 뿐이었는데. 그리고 그 질문은 여전히 유효합니다, petit mensonge ou non.",shape=box,color=blue];
		1346 -> 1352;
		1346 -> 1353;
		1346 -> 1354;
	1348 [label="가끔, 스스로 얼마나 많은 것들을 발견해야 했는지 생각해 볼 때가 있어. 그 꼬마가 실제로 훈련을 받았다는 점에선 조금 부럽기도 해.",shape=box,color=red];
		1348 -> 1356;
	1349 [label="전쟁의 삶을 살아가는데 \"좋은\" 방법은 없다고 생각해. 태어나든, 자랐든, 선택하든 말이야. 결국 중요한 건 스스로가 누구이고, 그걸 어떻게 활용하냐야.",shape=box,color=red];
		1349 -> 1357;
	1347 [label="주변 이들이 멀어져 보이거나 디지털화된 것처럼 보이거나, 인사를 기다리며 참을성 있게 앉아 있는 것처럼 보일 수도 있습니다.",shape=box,color=blue];
		1347 -> 1355;
	1350 [label="Oui, 그리고 당신이 리온 같았다면, 10번은 매질해야하는 형벌이라고 말했을 거에요 ! 하지만 당신은 다르죠. 그리고 당신은 용서받았습니다.",shape=box,color=blue];
		1350 -> 1341;
	1351 [label="Oui, 당신을 용서합니다. 당신이 리온 같았다면, 10번은 매질해야하는 형벌이라고 말했을 겁니다.",shape=box,color=blue];
		1351 -> 1341;
	1352 [label="솔직히 말해서, 나아졌어.",shape=box,color=red];
		1352 -> 1358;
	1353 [label="솔직히, 다 괜찮아. 당신은 어떤데?",shape=box,color=red];
		1353 -> 1285;
	1354 [label="이제 나아졌어. 고마워. 고해가 사람들에게 좋다는 소리를 들었어, 맞지?",shape=box,color=red];
		1354 -> 1359;
