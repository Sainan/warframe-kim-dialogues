		j3023167008 -> j3810557217;
		j3023167008 -> j4197798649;
	j1929331317 [label="당신이 une métaphore를 사용한다는 건 알지만서도, 웃음이 터져 나오네요 ! 아무리 노력해도 지금 제 입장이 되실 순 없을 것 같아서요 !",shape=box,color=blue];
		j1929331317 -> j2995963019;
	j993440137 [label="우리의 하루와 마음은 엉뚱한 방향으로 흘러가는 법이 너무나 많지요. 마치 빠져들 수 있는 어두운 구멍을 찾아내는 것처럼요, non ?",shape=box,color=blue];
		j993440137 -> j2118400298;
	j2480591648 [label="그 분께 왜 그런 행동들을 하시는지 여쭤봤고, 그 분은 너무 걱정이 되서 잠을 이룰 수 없다고 말씀하셨습니다.",shape=box,color=blue];
		j2480591648 -> j3717677851;
	j3081329913 [label="Ennui라고 이러한 감정을 표현하는 단어가 있어요. 모든 것들이 무의미하게... 만드는 권태와 불만을 뜻해요.",shape=box,color=blue];
		j3081329913 -> j650867662;
	j2519093161 [label="가득차서 쏟아지겠지요. 어쩌면 내용물이 쏟아질지도요. 그리고 이 모든게 une catastrophe처럼 느껴지겠죠. ",shape=box,color=blue];
		j2519093161 -> j1614183571;
	j3965780349 [label="영혼은 지니고 있는 믿음 그 이상의 존재입니다. 전 une Soeur de Sol이오나, 제 안에서 그 이상을 보셨으면 좋겠어요, non ?",shape=box,color=blue];
