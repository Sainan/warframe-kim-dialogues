		j3908425253 -> j3965780349;
	j4175976660 [label="Je ne comprends pas votre humour. 아마도 미래에서는, \"재미있다\"라는 뜻이 다른가 보죠 ?",shape=box,color=blue];
		j4175976660 -> j227554745;
	j1773729568 [label="당신의 어떤 본능적인 감각이 그런 mensonge를 내뱉게 한 건지 모르겠네요. ",shape=box,color=blue];
