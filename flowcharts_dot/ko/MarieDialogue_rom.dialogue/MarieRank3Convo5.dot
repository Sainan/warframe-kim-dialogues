	j3807340470 [label="Non. 차라리 지금의 저인 상태로 있고 싶어요. Le Cardinal의 손, 그분께서 건넨 혈청을 맞기로 결정한 저 말이에요.",shape=box,color=blue];
		j3807340470 -> j570395646;
	j1038438316 [label="사실, 현실적인 면을 고려해 보면 제가 이 글을 정리할 당시, 당신이 시간의 흐름 상 어디쯤에 있는가에 따라, 며칠이 지났을 수도 있고 몇년이 지났을 수도 있습니다.",shape=box,color=blue];
		j1038438316 -> j1499756758;
