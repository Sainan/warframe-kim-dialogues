		j1914615464 -> j2316840792;
	j2595110321 [label="가끔, 스스로 얼마나 많은 것들을 발견해야 했는지 생각해 볼 때가 있어. 그 꼬마가 실제로 훈련을 받았다는 점에선 조금 부럽기도 해.",shape=box,color=red];
		j2595110321 -> j2953019379;
	j440708252 [label="전쟁의 삶을 살아가는데 \"좋은\" 방법은 없다고 생각해. 태어나든, 자랐든, 선택하든 말이야. 결국 중요한 건 스스로가 누구이고, 그걸 어떻게 활용하냐야.",shape=box,color=red];
		j440708252 -> j300637842;
	j2955568924 [label="주변 이들이 멀어져 보이거나 디지털화된 것처럼 보이거나, 인사를 기다리며 참을성 있게 앉아 있는 것처럼 보일 수도 있습니다.",shape=box,color=blue];
		j2955568924 -> j3524082792;
