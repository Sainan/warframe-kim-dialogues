	j2530281194 [label="Oui ! 당신의 minuscule copie와 triste 이야기요... 생각만 해도 눈물이 나올려고 하네요. Famille라고 생각했던 이들에 의해 전쟁 기계로 변했지요 ?",shape=box,color=blue];
		j2530281194 -> j3807340470;
	j3605964787 [label="Oui ! 제가 듣기로는 당신이 지금처럼 싸우는 법을 배우느라 고생을 꽤나 했다고 전해지더군요. 죽음은 잔혹한 스승이죠, 전 상상도 못하겠지만...",shape=box,color=blue];
		j3605964787 -> j3807340470;
	j3585284001 [label="이 말들이 당신께 중요할 지는 모르겠습니다. 아니면 윙윙거리는 machinerie 위에 빛나는 점 몇 개에 불과할지도 모르지요.",shape=box,color=blue];
		j3585284001 -> j1038438316;
