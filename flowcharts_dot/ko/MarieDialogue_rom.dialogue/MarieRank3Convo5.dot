		1303 -> 1312;
	1304 [label="Je ne comprends pas votre humour. 아마도 미래에서는, \"재미있다\"라는 뜻이 다른가 보죠 ?",shape=box,color=blue];
		1304 -> 1313;
	1305 [label="당신의 어떤 본능적인 감각이 그런 mensonge를 내뱉게 한 건지 모르겠네요. ",shape=box,color=blue];
		1305 -> 1314;
	3951 [label="Bon, où en étais-je ?",shape=box,color=blue];
		3951 -> 1278;
	1310 [label="솔의 이름으로 싸우는 것... 이게 정녕 제 길일까요 ? 솔의 이름으로 살인자가 되어야 하는 건가요 ? Moi, petite Marie ?",shape=box,color=blue];
		1310 -> 1319;
		1310 -> 1320;
	1311 [label="당신이 une métaphore를 사용한다는 건 알지만서도, 웃음이 터져 나오네요 ! 아무리 노력해도 지금 제 입장이 되실 순 없을 것 같아서요 !",shape=box,color=blue];
		1311 -> 1321;
	1306 [label="우리의 하루와 마음은 엉뚱한 방향으로 흘러가는 법이 너무나 많지요. 마치 빠져들 수 있는 어두운 구멍을 찾아내는 것처럼요, non ?",shape=box,color=blue];
		1306 -> 1315;
	1307 [label="그 분께 왜 그런 행동들을 하시는지 여쭤봤고, 그 분은 너무 걱정이 되서 잠을 이룰 수 없다고 말씀하셨습니다.",shape=box,color=blue];
		1307 -> 1316;
	1308 [label="Ennui라고 이러한 감정을 표현하는 단어가 있어요. 모든 것들이 무의미하게... 만드는 권태와 불만을 뜻해요.",shape=box,color=blue];
		1308 -> 1317;
	1309 [label="가득차서 쏟아지겠지요. 어쩌면 내용물이 쏟아질지도요. 그리고 이 모든게 une catastrophe처럼 느껴지겠죠. ",shape=box,color=blue];
		1309 -> 1318;
	1312 [label="영혼은 지니고 있는 믿음 그 이상의 존재입니다. 전 une Soeur de Sol이오나, 제 안에서 그 이상을 보셨으면 좋겠어요, non ?",shape=box,color=blue];
		1312 -> 1322;
	1313 [label="전 그렇지 않거든요.",shape=box,color=blue];
		1313 -> 1323;
	1314 [label="제발 그게 benign 언행이었으며, 제 존재를 비방하기 위한 잔인한 농담이 아니었기를 바랍니다. 그렇기에, 전 솔의 예시를 따르기로 결정하였습니다 -",shape=box,color=blue];
		1314 -> 1324;
	1319 [label="난 군인으로서 훈련받지 않았었어. 그 꼬마처럼 말이야. 당신도 마찬가지겠지만.",shape=box,color=red];
		1319 -> 1328;
	1320 [label="난... 항상 이랬던 건 아니야. 언제나 싸움꾼이었지. 힘든 과정을 통해서 배워야 했어.",shape=box,color=red];
		1320 -> 1329;
	1321 [label="머릿속에 떠오르는 생각 때문에 웃겨서 머리가 아플 지경이에요. 숨도 못 쉬기 전에 말씀해 주세요 - 어떤 의미로 같은 굴레 안에 있었다고 하신건가요 ?",shape=box,color=blue];
		1321 -> 1319;
		1321 -> 1320;
	1315 [label="그럴 때는 우리 자신에게 친절하면서도 인내심을 갖도록 노력할 뿐입니다.",shape=box,color=blue];
		1315 -> 1325;
	1316 [label="그러실 때마다 함께 잘 companie가 필요하신지 여쭤봤고, 가끔은 허락하시고, 가끔은 거절하셨죠.",shape=box,color=blue];
		1316 -> 1306;
	1317 [label="아니면, 당신의 숨기고 싶은, 울고 싶은 마음일지도요. 그건 좀 더 절망에 가깝지만, 뭐라 단정 지을 순 없겠네요.",shape=box,color=blue];
		1317 -> 1335;
