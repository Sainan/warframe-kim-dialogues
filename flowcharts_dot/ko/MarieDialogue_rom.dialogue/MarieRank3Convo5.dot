	j3626313043 [label="우리는 모두 눈먼 존재일 뿐이며, 이 세상에서 길을 찾으려고 노력하고 있을 뿐입니다.",shape=box,color=blue];
		j3626313043 -> j1914615464;
	j570395646 [label="하지만 당신은 절 괴롭히는 슬픔과 불확실성을 아시고 계시죠. 이 전쟁의 삶에서 태어나지 않고, 자라지 않는다는 거요.",shape=box,color=blue];
