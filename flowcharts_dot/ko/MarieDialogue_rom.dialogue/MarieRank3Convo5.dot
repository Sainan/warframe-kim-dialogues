		j2096448959 -> j2545479153;
	j1914615464 [label="그저 당신에게 어떻게 지냈냐고 물었을 뿐이었는데. 그리고 그 질문은 여전히 유효합니다, petit mensonge ou non.",shape=box,color=blue];
