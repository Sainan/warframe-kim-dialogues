		j1479373034 -> j993440137;
	j3608770181 [label="Cathédrale에 그런 수녀님이 계셨어요. 야단법석이란 법석은 다 떠셨죠. 언젠가 새벽 3시에 은제 도구들을 닦고 계신 걸 본 적도 있었어요.",shape=box,color=blue];
		j3608770181 -> j2480591648;
