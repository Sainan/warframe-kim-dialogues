		j2396861619 -> j1180282791;
	j2780046854 [label="전 une Soeur de Sol입니다. 전투는... 제 운명이 아니에요. 살상도요. 카비아들은 속삭임이 살아있는 존재가 아니라고 말해줍니다만 - 제가 마주하는 다른 이들은 어떨까요 ?",shape=box,color=blue];
