		j3734127592 -> j519313662 [label="false",color=purple];
	j519313662 [label="잔인해지지 않으면서 이 말들을 어찌 전해야할지 모르겠으니... 간단하게 전달할게요.",shape=box,color=blue];
		j519313662 -> j3779282096;
	j2177339153 [label="맞아. 당신은... 나랑 같은 마음이 아니라고 생각이 든다만?",shape=box,color=red];
		j2177339153 -> j2710066155;
	j2719191771 [label="상황이 바뀌었어, 그리고... 미안해.",shape=box,color=red];
		j2719191771 -> j2186141317;
	j2584772218 [label="서로를 웃게 만드는 선물같은 능력. 진실 혹은 거짓을 서로에게 확인시키는 능력. 서로의 마음을 바꾸어놓는 능력. 고통스러울 때 서로에게 응원을 보내는 능력. 어리석은 행동으로 서로를 다치게 하는 능력.",shape=box,color=blue];
		j2584772218 -> j2846710844;
	j2036211419 [label="그리고 그 점이 절 슬프게 만들어요, 오. 당신이 그러기 전에 막는 것이 얼마나 슬픈 일인지.",shape=box,color=blue];
		j2036211419 -> j2464821925;
	j2424615542 [label="무슨... 뜻인지 모르겠어, 마리.",shape=box,color=red];
		j2424615542 -> j236124890;
	j445406003 [label="Mon coeur t'appartient également, Marie !",shape=box,color=red];
		j445406003 -> j1355234040;
	j1278963174 [label="사랑에 빠졌을 때 서로에게 기쁨을 가져다주는 능력. 증오에 빠졌을 때 서로에게 agonie를 가져다주는 능력. 이는 humanité로부터 비롯된 선물과도 같은 능력입니다 - 무심과는 다른 것이죠.",shape=box,color=blue];
		j1278963174 -> j526749541;
	j2156496278 [label="무심의 근원에 관계없이, 무심이 거부하는 모든 것, 무심이 파괴하는 모든 것에 굳게 매달리라는 가르침이 아닐까요 ?",shape=box,color=blue];
		j2156496278 -> j791161413;
	j2128122945 [label="우리가 함께 보낸 시간이 얼마나 많았는지 생각해 보세요. 당신이 살아온 세월을 크게 본다면 이게 얼마나 짧은지를 말이에요.",shape=box,color=blue];
		j2128122945 -> j893257492;
	j654158927 [label="대신에요 ? 그럼... 먼저 당신 마음의 타래를 풀어야 할 것 같군요, 드리프터. 그건 제가 대신 해드릴 수 없습니다.",shape=box,color=blue];
		j654158927 -> j3699890413;
	j798847334 [label="그리고 그럴 수도 있겠네요. 저는 질투심 많은 사람이 아니지만, 제가 모르는 누군가가 제 마음이 향하는 이를 사로잡았다는 걸 아는 건 정말 중요한 일이니까요 -",shape=box,color=blue];
		j798847334 -> j2320651874;
	j2929536347 [label="+10 Chemistry",color=orange];
		j2929536347 -> j4121460860;
	j628794134 [label="저는 - 오! 오, mon coeur !",shape=box,color=blue];
		j628794134 -> j2063280221;
	j3779282096 [label="그냥... 다른 이에게 충실하시는게 나을 것 같아요. 저에게 느끼시는 그 감정에 대한 응답으로서 당신께 다시 전해드리진 않겠습니다. 죄송합니다.",shape=box,color=blue];
