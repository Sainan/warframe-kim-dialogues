	3304 [label="그리고 전 속으로 생각했어요. 이게 바로 무심이 파괴하고자 하는 것일까 ? 이것이 바로 무심이 먹어치우는 것일까 ? 다른 사람들에게 영향을 미치는 다른 이의 힘 말인가 ?",shape=box,color=blue];
		3304 -> 3321;
	3309 [label="당신은 제 영혼의 형제에게 크나큰 평화를 가져다주셨습니다. 리온에게 우리가 싸워야 할 진정한 적이 있다는 걸 설득시켜 주셨고 - 그에게 희망을 주셨어요.",shape=box,color=blue];
		3309 -> 3329;
	3310 [label="당신께서 제 영혼의 형제에게 위로와 평화를 가져다주었고, 그가 전에는 전혀 누리지 못했던 평화를 주셨습니다. 당신의 동행은 리온에게 말로 표현할 수 없을 만큼 큰 의미가 있었을 거에요.",shape=box,color=blue];
		3310 -> 3329;
	3311 [label="무심이 진정 무엇인지 우리는 결코 답을 알 수 없을지도 모르지만, 그게 중요치 않다는 걸 우린 알고 있죠. 무심이 제시하는 도전, 그리고 그것이 현실이라는 점으로 - 우린 그걸 마주해야 해요.",shape=box,color=blue];
		3311 -> 3329;
	3312 [label="전 악마가 Monsieur 로이드와 le Cardinal의 가족분들의 재결합을 돕도록 설득되었다고 받아들이지 못하겠습니다. 그자의 이유가... 의심스럽지만, 여전히 그자를 완전히 믿지 못하니까요. ",shape=box,color=blue];
		3312 -> 3330;
	3313 [label="우리의 악마가 자신의 잘못, 자신이 희생시킨 무고한 생명들에 대해 조금이라도 후회할 수 있을 거라고는 생각이 안 들었어요. 당신이 제 생각이 틀렸다는 걸 증명해 주셨습니다.",shape=box,color=blue];
		3313 -> 3331;
	3314 [label="당신이 어떠한 사슬로 악마를 묶어두었는진 모르지만, 그자에게 확실히 목줄이 채워져 있는 것 같네요. 그자는 전보다...더 온순해진 것 같습니다. 이건 다 당신 덕분이에요.",shape=box,color=blue];
		3314 -> 3331;
	3315 [label="우리가 되살려 준 기억들이 그자를 진정시킨 것 같네요. 어쩌면 그자는 잃게된 모든 이에 대한 슬픔을 떠올리면서, 아직 잃을 수도 있는 이들을 떠올렸을지도요.",shape=box,color=blue];
		3315 -> 3331;
	3316 [label="어쩌면 당신에 대한 그자의 애호로 그 성질을 누그러뜨린 걸지도요, 저도 잘은 모르겠어요. 이유가 어찌됐든, 당신 덕분이라는 걸 알아요.",shape=box,color=blue];
		3316 -> 3331;
	3308 [label="당신들에 대해서 악의를 품고 있지 않으며 오직 당신들 둘에 대한 joie만을 가지고 있습니다, oui ?",shape=box,color=blue];
		3308 -> 3327;
		3308 -> 3328;
	3306 [label="상황이 바뀌었어. 그리고... 그 다른 상대에게 충실해야 할 것 같아. 미안.",shape=box,color=red];
		3306 -> 3325;
	3307 [label="믿기 힘들 수도 있고, 어쩌면 받아들이기 힘들 수도 있다는 거 알아. 하지만... 당신을 사랑해. 그리고 다른 상대도 사랑하고. 똑같이 말이야.",shape=box,color=red];
