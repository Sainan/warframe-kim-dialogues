		3300 -> 3316 [label="false",color=purple];
	3298 [label="저번에 저에 대한 감정이 있다고 말씀하셨던 걸 알아요. 하지만 이제 다른 이와 함께하는 걸 보고 있죠. 그저 당신이 행복해보여서 기쁘다는 말을 전하고 싶었어 !",shape=box,color=blue];
		3298 -> 3308;
	3297 [label="저번에 한 번 말씀하셨죠... 오, 어찌 말을 꺼내야 할지 모르겠네요. 그... 당신이 저한테 감정이 있다고요. 하지만 당신이 다른 이에 감정을 가지고 있다는 걸 알아요.",shape=box,color=blue];
		3297 -> 3306;
		3297 -> 3307;
	3296 [label="저번에 한 번 말씀하셨죠... 오, 어찌 말을 꺼내야 할지 모르겠네요. 그... 당신이 저한테 감정이 있다고요.",shape=box,color=blue];
		3296 -> 3305;
	3294 [label="그 시간들이 제게 얼마나 큰 의미가 있었는지 생각했어요. 마치 바다에 떠 있는 배처럼, 그 시간들이 스스로와 삶의 방향을 얼마나 바꾸어 놓았는지요.",shape=box,color=blue];
