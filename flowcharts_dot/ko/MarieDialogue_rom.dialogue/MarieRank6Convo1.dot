		3320 -> 3335;
	3319 [label="그리고 그 점이 절 슬프게 만들어요, 오. 당신이 그러기 전에 막는 것이 얼마나 슬픈 일인지.",shape=box,color=blue];
		3319 -> 3334;
	3317 [label="무슨... 뜻인지 모르겠어, 마리.",shape=box,color=red];
		3317 -> 3332;
	3318 [label="Mon coeur t'appartient également, Marie !",shape=box,color=red];
		3318 -> 3333;
	3336 [label="사랑에 빠졌을 때 서로에게 기쁨을 가져다주는 능력. 증오에 빠졌을 때 서로에게 agonie를 가져다주는 능력. 이는 humanité로부터 비롯된 선물과도 같은 능력입니다 - 무심과는 다른 것이죠.",shape=box,color=blue];
		3336 -> 3349;
	3343 [label="무심의 근원에 관계없이, 무심이 거부하는 모든 것, 무심이 파괴하는 모든 것에 굳게 매달리라는 가르침이 아닐까요 ?",shape=box,color=blue];
