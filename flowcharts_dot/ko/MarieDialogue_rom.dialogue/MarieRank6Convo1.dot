	3891 [label="대신에요 ? 그럼... 먼저 당신 마음의 타래를 풀어야 할 것 같군요, 드리프터. 그건 제가 대신 해드릴 수 없습니다.",shape=box,color=blue];
		3891 -> 3892;
	3342 [label="그리고 그럴 수도 있겠네요. 저는 질투심 많은 사람이 아니지만, 제가 모르는 누군가가 제 마음이 향하는 이를 사로잡았다는 걸 아는 건 정말 중요한 일이니까요 -",shape=box,color=blue];
