	j3115571732 [label="그리고 전 속으로 생각했어요. 이게 바로 무심이 파괴하고자 하는 것일까 ? 이것이 바로 무심이 먹어치우는 것일까 ? 다른 사람들에게 영향을 미치는 다른 이의 힘 말인가 ?",shape=box,color=blue];
		j3115571732 -> j2584772218;
	j1368960885 [label="당신이 주워 담을 수 없는 말을 하려고 하는 것 같아서 걱정되요. 그리고 그 말이 우리 사이를 영원히 바꿔 놓을 것 같아요.",shape=box,color=blue];
		j1368960885 -> j2036211419;
	j3803372216 [label="Mon coeur t'appartient depuis notre première rencontre...",shape=box,color=blue];
		j3803372216 -> j2424615542;
		j3803372216 -> j445406003;
	j2396864824 [label="서로를 웃게 만드는 선물같은 능력. 진실 혹은 거짓을 서로에게 확인시키는 능력. 서로의 마음을 바꾸어놓는 능력. 고통스러울 때 서로에게 응원을 보내는 능력. 어리석은 행동으로 서로를 다치게 하는 능력.",shape=box,color=blue];
		j2396864824 -> j1278963174;
	j1832187315 [label="가장 어두운 시기에 리온을 인도하고, 고통과 agonie의 순간에 그를 붙잡아주는 당신이 있다면, 그 차이가 무엇이겠어요 ?",shape=box,color=blue];
		j1832187315 -> j2156496278;
	j192858501 [label="그 결과는 의심할 여지 없이 당신 덕분이에요. 로스가 여기 와서 le Cardinal의 가족분들을 보호하고 있는 건 당신 덕분입니다.",shape=box,color=blue];
		j192858501 -> j164661609;
	j164661609 [label="그리고 우리의 악마가 우리의 적이 아니라는 걸 압니다, oui ? 그게 바로 무심이에요. 무심이 거부하는 모든 것, 무심이 파괴하는 모든 것에 굳게 매달리라는 가르침이 아닐까요 ?",shape=box,color=blue];
		j164661609 -> j2128122945;
	j2234193794 [label="하지만... 만약 ",shape=box,color=red];
		j2234193794 -> j654158927;
	j1839905660 [label="나도 당신에게 마음이 있어, 마리.",shape=box,color=red];
		j1839905660 -> j798847334;
	j2857417535 [label="Oui, 이해합니다. 물론이죠. 이해해요 ! 영혼을 따르는 당신을 어찌 비난할 수 있겠나요 ?",shape=box,color=blue];
		j2857417535 -> j2929536347;
	j3734127592 [label="Evaluate expressions",color=orange];
