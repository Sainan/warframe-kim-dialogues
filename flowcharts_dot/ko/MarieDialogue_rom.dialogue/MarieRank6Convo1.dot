	j1880044286 [label="그 시간들이 제게 얼마나 큰 의미가 있었는지 생각했어요. 마치 바다에 떠 있는 배처럼, 그 시간들이 스스로와 삶의 방향을 얼마나 바꾸어 놓았는지요.",shape=box,color=blue];
		j1880044286 -> j3115571732;
