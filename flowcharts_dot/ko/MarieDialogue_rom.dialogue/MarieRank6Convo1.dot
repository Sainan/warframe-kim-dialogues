		j3470333215 -> j3905211376 [label="false",color=purple];
	j920172875 [label="저번에 저에 대한 감정이 있다고 말씀하셨던 걸 알아요. 하지만 이제 다른 이와 함께하는 걸 보고 있죠. 그저 당신이 행복해보여서 기쁘다는 말을 전하고 싶었어 !",shape=box,color=blue];
		j920172875 -> j2635459730;
	j2782906334 [label="저번에 한 번 말씀하셨죠... 오, 어찌 말을 꺼내야 할지 모르겠네요. 그... 당신이 저한테 감정이 있다고요. 하지만 당신이 다른 이에 감정을 가지고 있다는 걸 알아요.",shape=box,color=blue];
		j2782906334 -> j1610478524;
		j2782906334 -> j2594570680;
	j1790714327 [label="저번에 한 번 말씀하셨죠... 오, 어찌 말을 꺼내야 할지 모르겠네요. 그... 당신이 저한테 감정이 있다고요.",shape=box,color=blue];
