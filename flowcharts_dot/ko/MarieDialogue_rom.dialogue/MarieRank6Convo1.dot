	3302 [label="당신이 주워 담을 수 없는 말을 하려고 하는 것 같아서 걱정되요. 그리고 그 말이 우리 사이를 영원히 바꿔 놓을 것 같아요.",shape=box,color=blue];
		3302 -> 3319;
	3301 [label="Mon coeur t'appartient depuis notre première rencontre...",shape=box,color=blue];
		3301 -> 3317;
		3301 -> 3318;
	3321 [label="서로를 웃게 만드는 선물같은 능력. 진실 혹은 거짓을 서로에게 확인시키는 능력. 서로의 마음을 바꾸어놓는 능력. 고통스러울 때 서로에게 응원을 보내는 능력. 어리석은 행동으로 서로를 다치게 하는 능력.",shape=box,color=blue];
		3321 -> 3336;
	3329 [label="가장 어두운 시기에 리온을 인도하고, 고통과 agonie의 순간에 그를 붙잡아주는 당신이 있다면, 그 차이가 무엇이겠어요 ?",shape=box,color=blue];
		3329 -> 3343;
	3330 [label="그 결과는 의심할 여지 없이 당신 덕분이에요. 로스가 여기 와서 le Cardinal의 가족분들을 보호하고 있는 건 당신 덕분입니다.",shape=box,color=blue];
		3330 -> 3331;
	3331 [label="그리고 우리의 악마가 우리의 적이 아니라는 걸 압니다, oui ? 그게 바로 무심이에요. 무심이 거부하는 모든 것, 무심이 파괴하는 모든 것에 굳게 매달리라는 가르침이 아닐까요 ?",shape=box,color=blue];
		3331 -> 3344;
	3327 [label="하지만... 만약 ",shape=box,color=red];
