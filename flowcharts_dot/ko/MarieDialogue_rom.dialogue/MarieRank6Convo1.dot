	"Chat ends." [color=orange];
	j3146720027 [label="당신은 정말 훌륭하고 친절한 친구로서 제게 있어주셨어요. 제가 기도조차 올릴 수 없을 만큼 이미 훌륭한 아군이죠. ",shape=box,color=blue];
		j3146720027 -> j3352154434;
	j3439778576 [label="Oui, 당신은 그런 걸 더 선호하는 것 같지만요, non ? 하 ! 개인적으론 악마를 그런 식으로 상상하고 싶지 않으니까 - 신경쓰지 마세요 ! 제가 말하러 온 건 그런 게 아니에요.",shape=box,color=blue];
