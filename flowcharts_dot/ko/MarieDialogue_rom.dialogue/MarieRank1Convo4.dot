	281 [label="아, 알겠어요. 당신은 그저 병사들을 모집하고 계셨군요. 하지만 저 악마는 당신의 등을 지키기 보다는 당신의 늑골에 단검을 꽂을 거에요.",shape=box,color=blue];
		281 -> 284;
	280 [label="Le diable séduit les coeurs les plus forts. 로스는 교활한 수법을 쓰지만, 조심하셔야 해요. 그 사람의 눈을 마주보고, 다른 것에는 주의를 기울이셔야 해요. ",shape=box,color=blue];
		280 -> 283;
	279 [label="제 생각엔 로스는 그 누구보다도 오래 살아남은 것 같아요. 어쩌면 로스가 떠돌아 다니기에, 지옥이 직접 그를 맞이해야 할지도요.",shape=box,color=blue];
		279 -> 283;
	285 [label="당신의 자비에 찬사를 보내며, 제 마음은 기쁨으로 한 가득입니다. 광휘의 성체들께선 우리에게 모든 이들은 도움을 받을 수 있고, 모든 이들은 용서받을 수 있다고 가르치십니다만... 그건 오직 그들이 그걸 바랄 때만 가능하답니다.",shape=box,color=blue];
		285 -> 290;
	284 [label="로스는 당신의 아군이 아니며, 앞으로도 그럴리 없습니다. 그 악마는 오직 스스로의 필요에 부응하는 이들 편에 서 있을 뿐이죠.",shape=box,color=blue];
		284 -> 287;
