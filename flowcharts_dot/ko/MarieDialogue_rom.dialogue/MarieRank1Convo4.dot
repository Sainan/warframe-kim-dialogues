		j1118016558 -> j1573915890;
	j164906823 [label="Add -1 to Thermostat counter",color=orange];
		j164906823 -> j876875287;
	j1759393463 [label="+5 Chemistry",color=orange];
		j1759393463 -> j1912615971;
	j1871551763 [label="아, 알겠어요. 당신은 그저 병사들을 모집하고 계셨군요. 하지만 저 악마는 당신의 등을 지키기 보다는 당신의 늑골에 단검을 꽂을 거에요.",shape=box,color=blue];
		j1871551763 -> j997826484;
	j1573915890 [label="Le diable séduit les coeurs les plus forts. 로스는 교활한 수법을 쓰지만, 조심하셔야 해요. 그 사람의 눈을 마주보고, 다른 것에는 주의를 기울이셔야 해요. ",shape=box,color=blue];
		j1573915890 -> j2685584349;
	j876875287 [label="제 생각엔 로스는 그 누구보다도 오래 살아남은 것 같아요. 어쩌면 로스가 떠돌아 다니기에, 지옥이 직접 그를 맞이해야 할지도요.",shape=box,color=blue];
		j876875287 -> j2685584349;
	j1912615971 [label="당신의 자비에 찬사를 보내며, 제 마음은 기쁨으로 한 가득입니다. 광휘의 성체들께선 우리에게 모든 이들은 도움을 받을 수 있고, 모든 이들은 용서받을 수 있다고 가르치십니다만... 그건 오직 그들이 그걸 바랄 때만 가능하답니다.",shape=box,color=blue];
		j1912615971 -> j1733611350;
	j997826484 [label="로스는 당신의 아군이 아니며, 앞으로도 그럴리 없습니다. 그 악마는 오직 스스로의 필요에 부응하는 이들 편에 서 있을 뿐이죠.",shape=box,color=blue];
		j997826484 -> j2939769357;
		j997826484 -> j1217567877;
		j997826484 -> j3096820916;
	j2685584349 [label="+5 Chemistry",color=orange];
		j2685584349 -> j3882442657;
	j1733611350 [label="스스로의 구원을 위해 단 한 번도 땀 흘리지 않는 이들을 돕는 끝이 없는 업은, 부족한 노예의 삶과도 같습니다.",shape=box,color=blue];
		j1733611350 -> j2939769357;
		j1733611350 -> j1217567877;
		j1733611350 -> j3096820916;
	j2939769357 [label="오로킨과 로스의 상황에 대해선 내가 당신보다 더 잘 알고 있어. 당신 도움 필요없다고.",shape=box,color=red];
		j2939769357 -> j1861803279;
	j1217567877 [label="경고해줘서 고마워. 로스를 상대할 때 꼭 명심할게.",shape=box,color=red];
		j1217567877 -> j581655174;
	j3096820916 [label="고맙지만, 스스로 헤쳐나갈 수 있어. 그리고, 더 중요한 게 뭔지 알아? 난 로스보다 더 심한 일도 경험해봤다는 거야.",shape=box,color=red];
		j3096820916 -> j3813209865;
	j3882442657 [label="제가 너무 불친절한 걸까요... 당신은 그를 모릅니다. 로스를 있는 그대로 보지 못하고 있어요. 전 그저 당신이 상처받지 않길 바랄 뿐입니다.",shape=box,color=blue];
		j3882442657 -> j2939769357;
		j3882442657 -> j1217567877;
		j3882442657 -> j3096820916;
	j1861803279 [label="Boolean MarieRoatheWarning is now true.",color=orange];
		j1861803279 -> j929863810;
	j581655174 [label="+10 Chemistry",color=orange];
		j581655174 -> j1256766894;
	j3813209865 [label="+5 Chemistry",color=orange];
		j3813209865 -> j4263704989;
	j929863810 [label="죄송합니다. 당신이나 당신이 조종을 견뎌낼 수 있는 지 저는 잘 모르겠어요. 다만, 우리가 온갖 걱정을 쏟아냈기에 걱정될 뿐이에요.",shape=box,color=blue];
		j929863810 -> j283116714;
	j1256766894 [label="그게 제가 바랄 수 있는 전부였어요. Merci, merci, merci. 이제, 가봐야 할 것 같네요.",shape=box,color=blue];
		j1256766894 -> "Chat ends.";
	j4263704989 [label="Oui, vous avez raison. 당신이나 당신이 조종을 견뎌낼 수 있는 지 저는 잘 모르겠어요. 다만, 우리가 온갖 걱정을 쏟아냈기에 걱정될 뿐이에요.",shape=box,color=blue];
		j4263704989 -> j3984730290;
