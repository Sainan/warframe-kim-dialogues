		245 -> 249 [label="x > 0",color=purple];
		245 -> 248 [label="x <= 0",color=purple];
		245 -> 248 [label="false",color=purple];
	250 [label="정말요 ? 그럼 당신만 모르는 것 같군요. 아이와 악마 사이에서, 모두가 잃어버린 자신의 일부를 찾고 있는 것 같거든요.",shape=box,color=blue];
		250 -> 255;
		250 -> 256;
	251 [label="왜 그리 상실감에 빠져 있는지 묻는 건 지나친 걸까요 ? 아이와 악마의 이유에 대해선 알고 있지만, 당신껀 모르겠어요.",shape=box,color=blue];
		251 -> 255;
		251 -> 256;
	249 [label="왜 악마의 노력에 협조하기로 결정했나요 ? 당신한테 악마의 동족들을 학살한 데 대한 책임이 있다고 들었어요.",shape=box,color=blue];
		249 -> 252;
		249 -> 253;
		249 -> 254;
	248 [label="악마의 노력에 힘을 보탤 생각이신가요 ? 당신한테 악마의 동족들을 학살한 데 대한 책임이 있다고 들었어요.",shape=box,color=blue];
		248 -> 252;
		248 -> 253;
		248 -> 254;
	255 [label="난 셀 수 없을 정도의 세월을... 다르게 말하자면, 스스로를 죽여오며 보냈어. 하나하나 기억하지 못한다고 해도 신경 안 써.",shape=box,color=red];
		255 -> 260;
	256 [label="요약해 주자면, 난... 정말 오랜 세월을 고통 속에서 보냈어. 잊어버린 건 일종의 자기방어 기제라고 생각해.",shape=box,color=red];
		256 -> 261;
	252 [label="그건 내 또 다른 존재가 한 일이야. 난 사회가 아닌 개인에게 책임을 묻는 게 맞다고 생각해.",shape=box,color=red];
		252 -> 257;
	253 [label="그건 내가 한 일이 아니라, 그 꼬마가 한 일이야. 그렇지만 나도 그 애만큼 오로킨을 싫어해.",shape=box,color=red];
		253 -> 258;
	254 [label="나가 북의 밤, 텐노가 오로킨을 배신했을 때, 난 거기 없었어. 거기에 동참했던 건 그 꼬마였다고.",shape=box,color=red];
		254 -> 259;
	260 [label="당신을 탓하는 게 아니에요. 제가 그런 학대를 당한다면, 그 모든 걸 다 숨겨두고 싶어할 거에요. 적어도, 찾으러 다니지도 않을거고요.",shape=box,color=blue];
		260 -> 265;
	261 [label="그 점에 관해선 의심의 여지도 없어요 ! 만약 제가 그런 학대를 당한다면, 제 영혼도 비슷한 행동을 할 거에요. 고칠 수도 없고 아무 소용도 없는 모든 것들을 숨겨두겠죠.",shape=box,color=blue];
		261 -> 265;
