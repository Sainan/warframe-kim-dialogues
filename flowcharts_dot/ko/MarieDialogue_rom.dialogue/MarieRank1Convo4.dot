	259 [label="나가 북의 밤. 오, 머릿속에 그려지네요. Quelles couleurs magnifiques !",shape=box,color=blue];
		259 -> 264;
	265 [label="+5 Chemistry",color=orange];
		265 -> 268;
	262 [label="Oui, je comprends. 건물을 빨리 불태워서 무너뜨려야 하는데, 냄새는 벽 안에 있는 쥐 탓을 하시는 군요.",shape=box,color=blue];
		262 -> 266;
	263 [label="Je meurs d'envie de savoir pourquoi ! 하지만 이 대화는 다음에 하기로 해요. 그렇지 않으면 우린 영원히 여기 있게 될거고, Monsieur 로이드가 저에게 화를 내실 거에요.",shape=box,color=blue];
		263 -> 267;
	264 [label="더 자세한 내용들은 Monsieur 로이드께 물어봐야 겠네요. 그렇지만 !",shape=box,color=blue];
		264 -> 267;
	268 [label="그렇지만, 이렇게 풀어내면 당신과 무슨 이야기를 하고 싶은지에 대한 통찰력을 좀 얻을 수 있겠지요.",shape=box,color=blue];
		268 -> 245;
	266 [label="하지만 그 대화는 다음에 하기로 해요. 그렇지 않으면 우린 영원히 여기 있게 될거고, Monsieur 로이드가 저에게 화를 내실 거에요.",shape=box,color=blue];
