	j3449424541 [label="로스는 도울 가치가 없는 존재라고 증명할 만한 일들을 하지 않았어... 아직은 말이야.",shape=box,color=red];
		j3449424541 -> j3741368548;
	j1235849793 [label="난 동료들을 거부할 수 없는 것 같아.",shape=box,color=red];
		j1235849793 -> j2749894235;
	j1985877082 [label="[로스에게 가는 관심을 고백한다.] 그에게 뭔가 매력적인 게 있어...",shape=box,color=red];
		j1985877082 -> j1118016558;
	j143291056 [label="로스는 살아남기 위해서 필요한 일을 하는 것 같아. 그걸 탓할 순 없지.",shape=box,color=red];
		j143291056 -> j164906823;
