digraph {
	237 [label="MarieRank1Convo4 begins.",color=orange];
		237 -> 238;
	238 [label="무례한 게 아니길 빌지만 질문 하나 해도 될까요 ? 우리의 우정이 시작된 지 얼마 안 된데다가, 특히나 당신은 오랜 시간을 보내왔으니까요.",shape=box,color=blue];
		238 -> 241;
		238 -> 240;
		238 -> 239;
	241 [label="솔직히 말하자면, 지내왔던 세월의 대부분을 잊어버렸어. ",shape=box,color=red];
		241 -> 244;
	240 [label="괜찮아, 신경 안 써. 질문해 봐.",shape=box,color=red];
		240 -> 243;
	239 [label="[종료.]",shape=box,color=red];
		239 -> 242;
	244 [label="솔이시여 ! 그 말에 제 마음이 찢어지네요. 당신과 악마 모두 마치 장이 뜯겨져 나간 서적처럼 정보가 결여된 것 같아요, non ?",shape=box,color=blue];
		244 -> 246;
		244 -> 247;
	243 [label="+5 Chemistry",color=orange];
		243 -> 245;
	242 [label="Chat ends.",color=orange];
	246 [label="내 과거의 결여된 부분을 그리워하지는 않는다만.",shape=box,color=red];
		246 -> 250;
	247 [label="매우 다른 이유라면, 맞아.",shape=box,color=red];
		247 -> 251;
