		294 -> 297;
	295 [label="그게 제가 바랄 수 있는 전부였어요. Merci, merci, merci. 이제, 가봐야 할 것 같네요.",shape=box,color=blue];
		295 -> 298;
	296 [label="Oui, vous avez raison. 당신이나 당신이 조종을 견뎌낼 수 있는 지 저는 잘 모르겠어요. 다만, 우리가 온갖 걱정을 쏟아냈기에 걱정될 뿐이에요.",shape=box,color=blue];
