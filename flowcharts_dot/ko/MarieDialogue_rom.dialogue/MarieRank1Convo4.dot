digraph {
	"MarieRank1Convo4 begins." [color=orange];
		"MarieRank1Convo4 begins." -> j2582949833;
	j2582949833 [label="무례한 게 아니길 빌지만 질문 하나 해도 될까요 ? 우리의 우정이 시작된 지 얼마 안 된데다가, 특히나 당신은 오랜 시간을 보내왔으니까요.",shape=box,color=blue];
		j2582949833 -> j725075772;
		j2582949833 -> j1561089016;
		j2582949833 -> j3039724897;
	j725075772 [label="솔직히 말하자면, 지내왔던 세월의 대부분을 잊어버렸어. ",shape=box,color=red];
		j725075772 -> j3619796117;
	j1561089016 [label="괜찮아, 신경 안 써. 질문해 봐.",shape=box,color=red];
		j1561089016 -> j2947588656;
	j3039724897 [label="[종료.]",shape=box,color=red];
		j3039724897 -> "Chat ends.";
	j3619796117 [label="솔이시여 ! 그 말에 제 마음이 찢어지네요. 당신과 악마 모두 마치 장이 뜯겨져 나간 서적처럼 정보가 결여된 것 같아요, non ?",shape=box,color=blue];
		j3619796117 -> j3444572230;
		j3619796117 -> j422555213;
	j2947588656 [label="+5 Chemistry",color=orange];
		j2947588656 -> j523704316;
	"Chat ends." [color=orange];
	j3444572230 [label="내 과거의 결여된 부분을 그리워하지는 않는다만.",shape=box,color=red];
		j3444572230 -> j2973381105;
	j422555213 [label="매우 다른 이유라면, 맞아.",shape=box,color=red];
		j422555213 -> j1804384218;
	j523704316 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j523704316 -> j3586638661 [label="x > 0",color=purple];
		j523704316 -> j1502757067 [label="x <= 0",color=purple];
		j523704316 -> j1502757067 [label="false",color=purple];
	j2973381105 [label="정말요 ? 그럼 당신만 모르는 것 같군요. 아이와 악마 사이에서, 모두가 잃어버린 자신의 일부를 찾고 있는 것 같거든요.",shape=box,color=blue];
		j2973381105 -> j4284042055;
		j2973381105 -> j3956502600;
	j1804384218 [label="왜 그리 상실감에 빠져 있는지 묻는 건 지나친 걸까요 ? 아이와 악마의 이유에 대해선 알고 있지만, 당신껀 모르겠어요.",shape=box,color=blue];
		j1804384218 -> j4284042055;
		j1804384218 -> j3956502600;
	j3586638661 [label="왜 악마의 노력에 협조하기로 결정했나요 ? 당신한테 악마의 동족들을 학살한 데 대한 책임이 있다고 들었어요.",shape=box,color=blue];
		j3586638661 -> j797287852;
		j3586638661 -> j1794768235;
		j3586638661 -> j4103958297;
	j1502757067 [label="악마의 노력에 힘을 보탤 생각이신가요 ? 당신한테 악마의 동족들을 학살한 데 대한 책임이 있다고 들었어요.",shape=box,color=blue];
		j1502757067 -> j797287852;
		j1502757067 -> j1794768235;
		j1502757067 -> j4103958297;
	j4284042055 [label="난 셀 수 없을 정도의 세월을... 다르게 말하자면, 스스로를 죽여오며 보냈어. 하나하나 기억하지 못한다고 해도 신경 안 써.",shape=box,color=red];
		j4284042055 -> j851515572;
	j3956502600 [label="요약해 주자면, 난... 정말 오랜 세월을 고통 속에서 보냈어. 잊어버린 건 일종의 자기방어 기제라고 생각해.",shape=box,color=red];
		j3956502600 -> j1406544034;
	j797287852 [label="그건 내 또 다른 존재가 한 일이야. 난 사회가 아닌 개인에게 책임을 묻는 게 맞다고 생각해.",shape=box,color=red];
		j797287852 -> j890794554;
	j1794768235 [label="그건 내가 한 일이 아니라, 그 꼬마가 한 일이야. 그렇지만 나도 그 애만큼 오로킨을 싫어해.",shape=box,color=red];
		j1794768235 -> j463721392;
	j4103958297 [label="나가 북의 밤, 텐노가 오로킨을 배신했을 때, 난 거기 없었어. 거기에 동참했던 건 그 꼬마였다고.",shape=box,color=red];
		j4103958297 -> j1353348115;
	j851515572 [label="당신을 탓하는 게 아니에요. 제가 그런 학대를 당한다면, 그 모든 걸 다 숨겨두고 싶어할 거에요. 적어도, 찾으러 다니지도 않을거고요.",shape=box,color=blue];
		j851515572 -> j4280833131;
	j1406544034 [label="그 점에 관해선 의심의 여지도 없어요 ! 만약 제가 그런 학대를 당한다면, 제 영혼도 비슷한 행동을 할 거에요. 고칠 수도 없고 아무 소용도 없는 모든 것들을 숨겨두겠죠.",shape=box,color=blue];
		j1406544034 -> j4280833131;
	j890794554 [label="Add 1 to Thermostat counter",color=orange];
		j890794554 -> j1928183326;
	j463721392 [label="Add -1 to Thermostat counter",color=orange];
		j463721392 -> j2227699783;
	j1353348115 [label="나가 북의 밤. 오, 머릿속에 그려지네요. Quelles couleurs magnifiques !",shape=box,color=blue];
		j1353348115 -> j2972348037;
	j4280833131 [label="+5 Chemistry",color=orange];
		j4280833131 -> j540433709;
	j1928183326 [label="Oui, je comprends. 건물을 빨리 불태워서 무너뜨려야 하는데, 냄새는 벽 안에 있는 쥐 탓을 하시는 군요.",shape=box,color=blue];
		j1928183326 -> j402663553;
	j2227699783 [label="Je meurs d'envie de savoir pourquoi ! 하지만 이 대화는 다음에 하기로 해요. 그렇지 않으면 우린 영원히 여기 있게 될거고, Monsieur 로이드가 저에게 화를 내실 거에요.",shape=box,color=blue];
		j2227699783 -> j4192617946;
	j2972348037 [label="더 자세한 내용들은 Monsieur 로이드께 물어봐야 겠네요. 그렇지만 !",shape=box,color=blue];
		j2972348037 -> j4192617946;
	j540433709 [label="그렇지만, 이렇게 풀어내면 당신과 무슨 이야기를 하고 싶은지에 대한 통찰력을 좀 얻을 수 있겠지요.",shape=box,color=blue];
		j540433709 -> j523704316;
	j402663553 [label="하지만 그 대화는 다음에 하기로 해요. 그렇지 않으면 우린 영원히 여기 있게 될거고, Monsieur 로이드가 저에게 화를 내실 거에요.",shape=box,color=blue];
