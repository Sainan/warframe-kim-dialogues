	283 [label="+5 Chemistry",color=orange];
		283 -> 286;
	290 [label="스스로의 구원을 위해 단 한 번도 땀 흘리지 않는 이들을 돕는 끝이 없는 업은, 부족한 노예의 삶과도 같습니다.",shape=box,color=blue];
		290 -> 287;
		290 -> 288;
		290 -> 289;
	287 [label="오로킨과 로스의 상황에 대해선 내가 당신보다 더 잘 알고 있어. 당신 도움 필요없다고.",shape=box,color=red];
		287 -> 291;
	288 [label="경고해줘서 고마워. 로스를 상대할 때 꼭 명심할게.",shape=box,color=red];
		288 -> 292;
	289 [label="고맙지만, 스스로 헤쳐나갈 수 있어. 그리고, 더 중요한 게 뭔지 알아? 난 로스보다 더 심한 일도 경험해봤다는 거야.",shape=box,color=red];
		289 -> 293;
	286 [label="제가 너무 불친절한 걸까요... 당신은 그를 모릅니다. 로스를 있는 그대로 보지 못하고 있어요. 전 그저 당신이 상처받지 않길 바랄 뿐입니다.",shape=box,color=blue];
		286 -> 287;
