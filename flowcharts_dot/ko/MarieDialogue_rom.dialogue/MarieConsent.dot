	j1985950621 [label="Check boolean MarieConsentComplete",color=orange];
		j1985950621 -> "Chat ends." [label=true,color=green];
		j1985950621 -> j4143234026 [label=false,color=brown];
	j1134465740 [label="Check boolean MariePolyamorySuccess",color=orange];
		j1134465740 -> j1985950621 [label=true,color=green];
		j1134465740 -> "Chat ends." [label=false,color=brown];
	j4143234026 [label="Mon coeur, 얘기 좀 나눌 수 있을까요 ? 잠깐이면 되요. ",shape=box,color=blue];
		j4143234026 -> j3052332023;
		j4143234026 -> j1084943698;
	j3052332023 [label="안녕, 물론이지. 무슨 일이야?",shape=box,color=red];
		j3052332023 -> j2053894146;
	j1084943698 [label="[종료.]",shape=box,color=red];
		j1084943698 -> j952339130;
	j2053894146 [label="그냥 이렇게 말하고 싶었어요... 당신의 마음이 다른 이에게 속해 있다는 걸 알아요. 비록 그 사람을 알지는 못하지만, 제 마음을 이 사실만으로도 기쁩니다.",shape=box,color=blue];
		j2053894146 -> j1115020740;
	j952339130 [label="Boolean MarieConsentComplete is now true.",color=orange];
		j952339130 -> "Chat ends.";
	j1115020740 [label="당신을 믿고 있어요. 만약 그 상대가 당신의 영혼 속에 자리를 잡고 있다면, 저는 기꺼이 그 마음을 다른 이와 나누고 싶어요.",shape=box,color=blue];
		j1115020740 -> j840106723;
	j840106723 [label="언젠가 그분을 만날 기회가 있길 바랄 뿐이에요, oui ? 제가 사랑하는 이의 연인도 나의 연인이어야 하니까요...",shape=box,color=blue];
		j840106723 -> j2971944554;
	j2971944554 [label="물론, 다른 분이 그럴 의향이 있다면요.",shape=box,color=blue];
		j2971944554 -> j751415852;
		j2971944554 -> j3947183480;
		j2971944554 -> j3718884356;
	j751415852 [label="솔직히 말하자면, 당신이 그 상대의 타입이 아닐수도 있어.",shape=box,color=red];
		j751415852 -> j2984509730;
	j3947183480 [label="당신을 좋아할 거야, 마리. 나처럼.",shape=box,color=red];
		j3947183480 -> j1933056620;
	j3718884356 [label="다른 상대방이 저항할 수 없을 것 같아.",shape=box,color=red];
		j3718884356 -> j1933056620;
	j2984509730 [label="쳇 ! 당신 정말 끔찍해요, 나의 늑대씨. 그냥 제 꿈을 가지게끔 해줘요. 그 때가 되면, 당신이 제 곁에 있을 때 온전히 당신을 품을 수 있을 것 같으니까요 !",shape=box,color=blue];
		j2984509730 -> j3691881527;
	j1933056620 [label="그 때가 되면, 당신이 제 곁에 있을 때 온전히 당신을 품을 수 있으니까요. 그리고 저처럼 당신을 돌봐주는 이와 기꺼이 당신을 나눌 거에요.",shape=box,color=blue];
		j1933056620 -> j3691881527;
	j3691881527 [label="결국, 당신이 여기저기 돌아다니면서 즐거운 시간을 보내는 동안 누군가는 속삭임을 감시해야 하니까요 !",shape=box,color=blue];
		j3691881527 -> j2255789755;
	j2255789755 [label="그리고 말 나온 김에, 할 일이 생겼어요. À la revoyure !",shape=box,color=blue];
		j2255789755 -> j952339130;
}