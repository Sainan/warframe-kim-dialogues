	3577 [label="Chat ends.",color=orange];
	3578 [label="Mon coeur, 얘기 좀 나눌 수 있을까요 ? 잠깐이면 되요. ",shape=box,color=blue];
		3578 -> 3580;
		3578 -> 3579;
	3576 [label="Chat ends.",color=orange];
	3580 [label="안녕, 물론이지. 무슨 일이야?",shape=box,color=red];
		3580 -> 3582;
	3579 [label="[종료.]",shape=box,color=red];
		3579 -> 3581;
	3582 [label="그냥 이렇게 말하고 싶었어요... 당신의 마음이 다른 이에게 속해 있다는 걸 알아요. 비록 그 사람을 알지는 못하지만, 제 마음을 이 사실만으로도 기쁩니다.",shape=box,color=blue];
		3582 -> 3584;
	3581 [label="Update boolean MarieConsentComplete",color=orange];
		3581 -> 3583;
	3584 [label="당신을 믿고 있어요. 만약 그 상대가 당신의 영혼 속에 자리를 잡고 있다면, 저는 기꺼이 그 마음을 다른 이와 나누고 싶어요.",shape=box,color=blue];
		3584 -> 3585;
	3583 [label="Chat ends.",color=orange];
	3585 [label="언젠가 그분을 만날 기회가 있길 바랄 뿐이에요, oui ? 제가 사랑하는 이의 연인도 나의 연인이어야 하니까요...",shape=box,color=blue];
		3585 -> 3586;
	3586 [label="물론, 다른 분이 그럴 의향이 있다면요.",shape=box,color=blue];
		3586 -> 3587;
		3586 -> 3588;
		3586 -> 3589;
	3587 [label="솔직히 말하자면, 당신이 그 상대의 타입이 아닐수도 있어.",shape=box,color=red];
		3587 -> 3590;
	3588 [label="당신을 좋아할 거야, 마리. 나처럼.",shape=box,color=red];
		3588 -> 3591;
	3589 [label="다른 상대방이 저항할 수 없을 것 같아.",shape=box,color=red];
		3589 -> 3591;
	3590 [label="쳇 ! 당신 정말 끔찍해요, 나의 늑대씨. 그냥 제 꿈을 가지게끔 해줘요. 그 때가 되면, 당신이 제 곁에 있을 때 온전히 당신을 품을 수 있을 것 같으니까요 !",shape=box,color=blue];
		3590 -> 3592;
	3591 [label="그 때가 되면, 당신이 제 곁에 있을 때 온전히 당신을 품을 수 있으니까요. 그리고 저처럼 당신을 돌봐주는 이와 기꺼이 당신을 나눌 거에요.",shape=box,color=blue];
		3591 -> 3592;
	3592 [label="결국, 당신이 여기저기 돌아다니면서 즐거운 시간을 보내는 동안 누군가는 속삭임을 감시해야 하니까요 !",shape=box,color=blue];
		3592 -> 3593;
	3593 [label="그리고 말 나온 김에, 할 일이 생겼어요. À la revoyure !",shape=box,color=blue];
		3593 -> 3594;
	3594 [label="Update boolean MarieConsentComplete",color=orange];
		3594 -> 3595;
	3595 [label="Chat ends.",color=orange];
}