		1190 -> 1193;
	1194 [label="Chat ends.",color=orange];
	3927 [label="Oui. 그냥 \"궁금해서\" 였군요. 절 속일 순 없으세요. 리온과의 관계를 포기하지는 않을 거라고 경고드려야겠네요. 리온을 당신보다 훨씬 오래 알고 지냈거든요.",shape=box,color=blue];
