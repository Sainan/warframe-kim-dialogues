		1179 -> 1184;
	3922 [label="오, 솔이시여 ! Non ! 리온은 피만 빼면 모든 면에서 제게 형제와도 같아요. 그 생각만으로 complètement dégoûtée 하는 스스로를 발견했어요 !",shape=box,color=blue];
		3922 -> 3923;
		3922 -> 3924;
	1175 [label="당신이 죽도록 가족이 내버려뒀다고?",shape=box,color=red];
		1175 -> 1180;
	1176 [label="그 때가 몇 살이었는데?",shape=box,color=red];
		1176 -> 1181;
	1182 [label="엔트라티께선 그 어떤 것도 망쳐놓지 않으셨어요. 리온과 저는 예전부터 강하죠. 상황이 바뀌었을 뿐이에요, non ?",shape=box,color=blue];
		1182 -> 1186;
	1183 [label="리온이 없었다면 전 그 어디에도 존재하지 못했을 거에요. 어쩌면 언덕 아래쯤에 있었을 지도 모르죠. 하 !",shape=box,color=blue];
		1183 -> 1187;
	1184 [label="리온은 정말 이상한 방식으로 절 웃게 만들어요. 하지만 그건 당신도 마찬가지죠, 늑대씨. 전 여기 있기에 점점 더 행복해지고 있어요.",shape=box,color=blue];
		1184 -> 1188;
	3923 [label="그냥 궁금했을 뿐이야.",shape=box,color=red];
		3923 -> 3925;
	3924 [label="인정할게, 조금 안심했어.",shape=box,color=red];
		3924 -> 3931;
	1180 [label="가족들 눈에는, 오랫동안 절 고치려고 최선을 다해 왔다는 게 보였어요. 걷는 법을 가르쳐 줄 가정교사들, 교정기. 신발들.",shape=box,color=blue];
		1180 -> 1185;
	1181 [label="여섯 살 ? 일곱 살 ? 가족들 눈에는, 오랫동안 절 고치려고 최선을 다해 왔다는 게 보였어요. 걷는 법을 가르쳐 줄 가정교사들, 교정기. 신발들.",shape=box,color=blue];
		1181 -> 1185;
	1186 [label="루아께선 끊임없이 변하시죠. 아무리 변함없는 존재인 솔조차도, 궤도에 영향을 받게 됩니다.",shape=box,color=blue];
		1186 -> 1191;
	1187 [label="리온은 정말 제 영혼의 형제에요. 전 여기 있기에 점점 더 행복해지고 있어요.",shape=box,color=blue];
		1187 -> 1188;
	1188 [label="리온도 곧 똑같은 사실을 깨닫길 바랄 뿐이지만... 악마는 속삭임과 거짓말로 그를 괴롭히죠.",shape=box,color=blue];
		1188 -> 1192;
	3925 [label="+10 Chemistry",color=orange];
		3925 -> 3926;
	3931 [label="Check boolean DrifterMarie",color=orange];
		3931 -> 3932 [label=true,color=green];
		3931 -> 3933 [label=false,color=brown];
	1185 [label="다들 그 짐에 지쳐 있었어요. 그리하여, 숫자와 글자를 읽고 쓰는 걸 겨우 할 수 있던 저는 분뇨와 진흙이 뒤섞인 곳에 빠져있는 스스로를 발견할 수 있었습니다.",shape=box,color=blue];
		1185 -> 1189;
		1185 -> 1190;
	1191 [label="우린 우리만의 방식을 고집해서는 안 돼요. 그렇지 않으면 그러한 고집 때문에 망가질 거에요, 늑대씨. 게다가, 전 여기 있기에 점점 더 행복해지고 있어요.",shape=box,color=blue];
		1191 -> 1188;
	1192 [label="으아 ! 호랑이도 제말하면 온다더니 부르고 있네요. 가봐야 겠어요.",shape=box,color=blue];
		1192 -> 1194;
	3926 [label="Check boolean DrifterMarie",color=orange];
		3926 -> 3927 [label=true,color=green];
		3926 -> 3928 [label=false,color=brown];
	3932 [label="Oui, 의도를 분명히 밝히셨군요. 리온과의 관계를 포기하지는 않을 거라고 경고드려야겠네요. 리온을 당신보다 훨씬 오래 알고 지냈거든요.",shape=box,color=blue];
		3932 -> 3928;
