		1172 -> 1177;
	1173 [label="너희 둘이 만나서 정말 다행이야.",shape=box,color=red];
		1173 -> 1178;
	1174 [label="너희 두사람이 날 웃게 만드는 것 같아.",shape=box,color=red];
		1174 -> 1179;
