		1114 -> 1118 [label=false,color=brown];
	1115 [label="대성당에서의 생활이 어땠는지 더 자세히 알려줄래? 엔트라티가 오기 전에?",shape=box,color=red];
		1115 -> 1119;
	1117 [label="어디서 자랐어, 마리?",shape=box,color=red];
		1117 -> 2425;
	1118 [label="[종료.]",shape=box,color=red];
		1118 -> 1122;
	1116 [label="엔트라티가 나타나기 전에 대성당에서의 생활은 어땠어?",shape=box,color=red];
		1116 -> 1120;
	1119 [label="외로웠던 것 같아요. 사실을 말하자면요. 리온이 제 곁에 있었지만, 그가 가끔 어떤지 아시잖아요. (오 ! 리온이 지금 당신과 대화를 나누게 되서 정말 기뻐요 !)",shape=box,color=blue];
		1119 -> 1123;
	2425 [label="Update boolean MarieBackstory1",color=orange];
		2425 -> 1121;
	1122 [label="Chat ends.",color=orange];
	1120 [label="오, 당신의 흥미를 끌어낼만한 이야기가 있는지는 모르겠지만, 그래도 궁금하시다면 알려드릴게요. ",shape=box,color=blue];
		1120 -> 1124;
	1123 [label="Update boolean MarieGraveyard2",color=orange];
		1123 -> 1126;
	1121 [label="제가 사용하는 언어를 통해서 아실거라 생각했는데, 당신이 제 시대의 세상 사람이 아니라는 걸 깨달았지 뭐에요, 하 !",shape=box,color=blue];
		1121 -> 1125;
	1124 [label="전 솔의 수녀로서 주어진 일들을 하며 지내고 있었어요. 성찬식 물품들을 닦고, 교구민들을 위해 성찬 봉헌물을 준비하는 일이요. ",shape=box,color=blue];
		1124 -> 1127;
	1126 [label="그렇다고 해서 제가 죽은 자와 대화하는 데 많은 시간을 보낸 이유는 그게 아니고요.",shape=box,color=blue];
		1126 -> 1129;
	1125 [label="전 골이라는 나라의 수도인 la Cité de la Lumière 출신이에요. 세계적으로 볼 때, 홀바니아와 지도 상 그리 멀지 않은 곳이죠.",shape=box,color=blue];
		1125 -> 1128;
	1127 [label="Crypte와 묘지를 관리하는 게 제가 가장 좋아하는 일이었어요.",shape=box,color=blue];
		1127 -> 1130;
		1127 -> 1131;
	1129 [label="Update boolean MarieGraveyard2",color=orange];
		1129 -> 1134;
	1128 [label="제가 속한 Cathédrale이 1999년도에도 아직 서 있을지 궁금한데요 ? 이거 참 흥미로운 생각인 것 같아요 !",shape=box,color=blue];
		1128 -> 1132;
		1128 -> 1133;
	1130 [label="그걸 왜 가장 좋아했는데?",shape=box,color=red];
		1130 -> 1135;
	1131 [label="미안. 마지막 부분 좀 설명해줄래?",shape=box,color=red];
		1131 -> 1136;
	1134 [label="묘지에는 아름다움이 있고, tranquillité가 있어요. 너무나 조용하고 평화롭지요.",shape=box,color=blue];
		1134 -> 1139;
	1132 [label="당신 주제에서 벗어나는 거 좋아하지, 안 그래?",shape=box,color=red];
		1132 -> 1137;
	1133 [label="아마 두 명의 친구에게 물어볼 수 있을 것 같은데, 둘 다 여행을 꽤 많이 다녔거든. 그 도시에 가봤다고도 했던 것 같기도.",shape=box,color=red];
		1133 -> 1138;
	1135 [label="전 영면에 드신 분들과 이야기하는 걸 정말 좋아했어요. 그분들은 제 걱정을 들어주셨고, 비난하는 말은 한마디도 하지 않으셨죠.",shape=box,color=blue];
		1135 -> 1140;
	1136 [label="Cathédrale에서 사자를 관리하는 게 제 업무였죠. Crypte 바닥의 먼지를 쓸고, 마당의 잡초를 뽑곤 했어요.",shape=box,color=blue];
		1136 -> 1135;
	1139 [label="그분들께 my troubles et les activités des autres에 대해 말씀드리는 걸 좋아하는 것 같아요. 왜냐하면 그 분들의 걱정은 끝났으니까요, oui ?",shape=box,color=blue];
		1139 -> 1143;
	1137 [label="+5 Chemistry",color=orange];
		1137 -> 1141;
	1138 [label="+5 Chemistry",color=orange];
		1138 -> 1142;
	1140 [label="뭐, 단 한 마디도 대답해주진 않으셨지만, mais cela me convenait tout à fait ! 아예 침묵인 상태가 더 좋으니까요.",shape=box,color=blue];
		1140 -> 1144;
	1143 [label="그 분들께는 이제 모든 것들이 작게 보일 것이고, 그 점이 저에게 위안이 되지요.",shape=box,color=blue];
		1143 -> 1146;
		1143 -> 1147;
		1143 -> 1148;
	1141 [label="눈치채셨군요, oui ? 리온은 제가 햇살 속의 먼지처럼, 바람 따라 어디든 떠다닌다고 늘 놀리곤 하죠. (리온이 지금은 당신과 대화를 나누게 되서 정말 기뻐요 !)",shape=box,color=blue];
		1141 -> 1145;
	1142 [label="오, 그 분들을 귀찮게 만들지 마세요. 그냥 제 어리석은 생각일 뿐이에요. 그 장소가 사라진다고 생각하면 얼마나 슬플지 모르겠어요.",shape=box,color=blue];
		1142 -> 1145;
	1144 [label="+5 Chemistry",color=orange];
		1144 -> 1149;
	1146 [label="잘 모르겠네. 난... 진짜로 죽는 게 무서워. 죽음이 주변에 산재하는 걸 좋아한 적이 없어.",shape=box,color=red];
		1146 -> 1151;
	1147 [label="난 그런 식으로 생각해 본 적이 없었어.",shape=box,color=red];
		1147 -> 1152;
	1148 [label="나도 무덤과 공동 묘지에 있을 때 비슷한 평화를 느껴. 완전 이해해.",shape=box,color=red];
		1148 -> 1153;
	1145 [label="그냥 궁금해서요, non ? Tout ce qui existe - 존재하는 모든 것 - 을 알고 싶어요. 그래서 le Cardinal과 제가 만나게 된 거라고 생각해요.",shape=box,color=blue];
		1145 -> 1150;
	1149 [label="상상이 가시나요? 말하는 해골들요, 마치 네크랄로이드처럼요 ? 하 !",shape=box,color=blue];
		1149 -> 1154;
		1149 -> 1155;
	1151 [label="그 맘 알아요, 쬐깐한 morbide 마리같으니 ! 정말 신기하네요. 하지만 사람마다 생각은 다르니까요, non ?",shape=box,color=blue];
		1151 -> 1157;
	1152 [label="당신 혼자만 그러신게 아니에요. 우린 앞으로 일어날 일들을 생각하며 많은 시간을 보내는 걸 좋아하지 않지요. 그 일이 눈 앞에 닥치기 전까지는요.",shape=box,color=blue];
		1152 -> 1158;
	1153 [label="이해해 주셔서 정말 기뻐요 !",shape=box,color=blue];
		1153 -> 1158;
	1150 [label="Où en étais-je ? 아 ! Oui. 제 이야기 중이였죠.",shape=box,color=blue];
		1150 -> 1156;
	1154 [label="휠체어를 사용해야 하는 당신에게 쉬운 일은 아니잖아.",shape=box,color=red];
		1154 -> 1159;
	1155 [label="얘기 나눌 수 있는 다른 친구는 없었어?",shape=box,color=red];
		1155 -> 1160;
	1157 [label="누군가는 그 분들을 돌봐야 하지요. 그리고 전 기꺼이 그럴 거에요.",shape=box,color=blue];
		1157 -> 1158;
	1158 [label="리온은 제가 땅에 더 가까워서 무덤에 대해서 많이 생각하는 거라고 농담을 던지기도 했죠.",shape=box,color=blue];
		1158 -> 1162;
	1156 [label="놀라실지도 모르겠지만, 전 부유한 famille에서 태어났습니다. 오로킨과 비슷한, bourgeois 계층이었죠.",shape=box,color=blue];
		1156 -> 1161;
	1159 [label="Non, 전혀 쉽지 않았죠. 하지만 시간이 지나면 리온이 crypte로 가는 계단을 오르내릴 수 있도록 도와줬고, 나머지는 시간이 지나면서 해결할 수 있었어요.",shape=box,color=blue];
		1159 -> 1163;
	1160 [label="Update boolean MarieGraveyard1",color=orange];
		1160 -> 1164;
	1162 [label=" 저도 리온한테 머리 속이 텅 비어 있어서 그 속에 유령으로 가득찬 거냐고 물었지만요.",shape=box,color=blue];
		1162 -> 1166;
	1161 [label="하지만 제가 이렇게 태어났을 때는... mes pieds tordus et inutilisables한 상태의 기형아였으니까요. 오, ma mère는 견딜 수 없으셨을 거에요.",shape=box,color=blue];
		1161 -> 1165;
	1163 [label="고집 센 사람이 뭘 할 수 있는지 생각하면 정말 인상적이에요, oui ?",shape=box,color=blue];
		1163 -> 1167;
	1164 [label="물론, 리온이 있었죠. 하지만 어떤 날은 서로를 어떻게 대하는지 잘 아시잖아요.",shape=box,color=blue];
		1164 -> 1129;
	1166 [label="그리하면, 저를 언덕 밑으로 밀어 떨어뜨리겠다고 위협하고, 전 리온의 사제복을 쐐기풀로 가득 채우겠다고 위협했죠.",shape=box,color=blue];
		1166 -> 1169;
	1165 [label="겉모습을 유지해야 했고요, oui ? 상류층으로서의 수준도 유지해야 했죠.",shape=box,color=blue];
		1165 -> 1168;
	1167 [label="뭐. 황소 고집이랑 상체 근육만 있는 거죠, 하 !",shape=box,color=blue];
		1167 -> 1170;
	1169 [label="La famille.",shape=box,color=blue];
		1169 -> 1172;
		1169 -> 1173;
		1169 -> 1174;
		1169 -> 3921;
	1168 [label="그래서, 불쌍하고 기형적인 마리는 어찌 되었을까요 ? 전 la Cité de la Lumière로 끌려가서, 길거리에서 사라질 게 분명했어요...",shape=box,color=blue];
		1168 -> 1171;
	1170 [label="Update boolean MarieGraveyard1",color=orange];
		1170 -> 1129;
