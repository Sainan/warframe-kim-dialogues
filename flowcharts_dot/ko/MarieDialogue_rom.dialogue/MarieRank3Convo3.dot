	1195 [label="제 ma mère께 une indésirable pour로 만들었던 이유가, 거리의 다른 아이들 사이에서 꽤나 인기를 끌게 만들었습니다.",shape=box,color=blue];
		1195 -> 1197;
	3930 [label="그래도 말이에요, 당신 정말 흥미로워요, 늑대씨. 리온은 정말 제 영혼의 형제에요. 전 여기 있기에 점점 더 행복해지고 있어요.",shape=box,color=blue];
		3930 -> 1188;
	3937 [label="+10 Chemistry",color=orange];
		3937 -> 3938;
	3942 [label="+10 Chemistry",color=orange];
		3942 -> 3943;
	1197 [label="Pieds 없는 아이보다 더 pathétique한 게 뭐가 있을까요, oui ? 제가 하루 종일 손을 벌리면 다른 애들이 일주일 동안 도둑질하는 것보다 더 많이 벌 수 있었어요.",shape=box,color=blue];
		1197 -> 1198;
	3938 [label="오 ! Par Sol. 정말 깜짝 놀랐어요, 인정해야겠네요. 그런데 지금 여기 앉아서 Monsieur 로이드로부터 새빨개진 얼굴을 숨기고 있어요...",shape=box,color=blue];
		3938 -> 3939;
	3943 [label="이게 절 얼마나 행복하게 만드는지 당신은 모르겠지만, 말할 때 신중하게 생각해 주세요.",shape=box,color=blue];
		3943 -> 3944;
	1198 [label="바로 이런 이유로, 길거리에서 les Soeurs de Sol 중 한 분이 절 발견하신 거였어요. 절 데려가시겠다고 제안해 주셨죠.",shape=box,color=blue];
		1198 -> 1199;
		1198 -> 1200;
	3939 [label="리온과의 관계를 포기하지는 않을 거라고 경고드려야겠네요. 리온을 당신보다 훨씬 오래 알고 지냈거든요.",shape=box,color=blue];
		3939 -> 3940;
	3944 [label="Update boolean DrifterLyon",color=orange];
		3944 -> 3945;
	1199 [label="다른 애들은 어떻게 됐어?",shape=box,color=red];
		1199 -> 1201;
	1200 [label="분명, 네 라고 답했겠지.",shape=box,color=red];
		1200 -> 1202;
	3940 [label="+10 Chemistry",color=orange];
		3940 -> 1188;
	3945 [label="리온은 제 형제에요. 당신이 상상도 못 할 만큼 그를 사랑하지만, 문제가 많은 사람이죠. 그에게 접근하기 전에 말들을 신중하게 고려하셔야 해요, n'est-ce pas ?",shape=box,color=blue];
		3945 -> 3946;
	1201 [label="+5 Chemistry",color=orange];
		1201 -> 1203;
	1202 [label="Oui, 제가 뭘 더 할 수 있었겠어요 ? 아파서 쓰러지는 건 시간 문제였으니까요. Enfant때 부터 알고 있었어요.",shape=box,color=blue];
		1202 -> 1204;
		1202 -> 1205;
	3946 [label="이 문제에 대해서 곧 얘기할 수 있을 것 같네요, 오해는 마시길. 격려하는 거니까요 ! 그냥 곰곰히 생각해보셨으면 해요.",shape=box,color=blue];
		3946 -> 3940;
	1203 [label="정말로 상냥한 마음을 가지셨네요. 분명, 모두를 다 데려갈 순 없었겠지만... 전 친구들을 잊지 않았어요.",shape=box,color=blue];
		1203 -> 1206;
	1204 [label="수녀님들은 어떤 분들이셨어?",shape=box,color=red];
		1204 -> 1207;
	1205 [label="대성당에서의 생활에는 어떻게 적응해 갔어?",shape=box,color=red];
		1205 -> 1208;
	1206 [label="전 매주 salaire와 부엌에서 다른 이들에게서 모은 음식 조각들을 가지고 돌아왔어요.",shape=box,color=blue];
		1206 -> 1209;
	1207 [label="Les Soeurs 는 제게 정말 친절하셨어요 ! 그리 생각하지 않는 점이 짐작이 가지만요, non ?",shape=box,color=blue];
		1207 -> 1210;
	1208 [label="정말 좋았어요 ! 그리 생각하지 않는 점이 짐작이 가지만요, non ?",shape=box,color=blue];
		1208 -> 1210;
	1209 [label="친구들이 남아 있는 동안 그 애들을 최대한 잘 돌봤어요. 많은 이들이 variole ou tuberculose로 죽었지만요...",shape=box,color=blue];
		1209 -> 1211;
	1210 [label="세 끼 식사, 따뜻한 침대, 머리 위에 지붕이 있는 것까지. 구타, 강도 혹은 더 최악의 일을 당할 염려를 안해도 되니까요 ?",shape=box,color=blue];
		1210 -> 1212;
	1211 [label="일부 애들은 이사가거나, 다른 애들은 싸우거나 폭력으로 인해 목숨을 잃었습니다. 대부분은 정직한 일을 찾아 성장했고, 스스로 famille를 꾸렸죠.",shape=box,color=blue];
		1211 -> 1213;
	1212 [label="전 제대로 된 교육을 받게 되었습니다. 솔과 루아의 복음을 배웠어요. 신앙 안에서 길을 찾으라는 가르침을 받았지요. 제가 원한다면 떠날 수도 있었을 거에요.",shape=box,color=blue];
		1212 -> 1214;
	1213 [label="어떤 애들은 절 보려고 Cathédrale에 들르기도 했어요. 정말 마음이 따뜻해졌어요.",shape=box,color=blue];
		1213 -> 1214;
	1214 [label="다른 애들은 구조되지 못한 채 저만 거리에서 빠져나왔다는 사실에 오랫동안 죄책감을 느꼈습니다. 어떤 날은, 아직도 느껴요.",shape=box,color=blue];
		1214 -> 1215;
		1214 -> 1216;
	1215 [label="내 주변에서 죽어간 모든 사람들을 떠올리고는, 나 혼자만 살아남았다는 걸 느낄 때? 나도 똑같은 심정이야. 하지만 우리 스스로 그리 내몰 순 없잖아. 할 수 있는 한에서 상황을 개선시켜 나가기 위해 계속해서 싸워 나가야 해.",shape=box,color=red];
		1215 -> 1217;
	1216 [label="당신은 주어진 상황에서 다른 사람들을 도우려고 최선을 다해 왔어. 다른 사람들이 당신을 격려했고, 지금 그 기회를 얻었으니, 이제 다른 사람들을 격려하려고 노력하는 거잖아.",shape=box,color=red];
		1216 -> 1218;
	1217 [label="이게 영원히 계속될까요 ? 전투 말이에요 ? 우리를 익사시키려는 조류에 맞서는 전쟁이요 ?",shape=box,color=blue];
		1217 -> 1219;
	1218 [label="Add 1 to Thermostat",color=orange];
		1218 -> 1220;
	1219 [label="Add -1 to Thermostat",color=orange];
		1219 -> 1221;
	1220 [label="+10 Chemistry",color=orange];
		1220 -> 1222;
	1221 [label="+10 Chemistry",color=orange];
		1221 -> 1223;
	1222 [label="Oui, 정확하시네요. 전 뗏목 위로 올라왔고, 이제 다른 이들을 위해 그리 행동해야 하지요. ",shape=box,color=blue];
		1222 -> 1224;
	1223 [label="하지만 무슨 말씀을 하시고 싶은지 알아요. 핵심은, 포기하지 말라는 뜻이잖아요. 제가 이러한 은사를 받은 건 다른 이들을 위한 방패가 되라는 의미겠지요.",shape=box,color=blue];
		1223 -> 1224;
	1224 [label="Merci. 하지만 이제 가봐야겠네요.",shape=box,color=blue];
		1224 -> 1225;
	1225 [label="Chat ends.",color=orange];
}