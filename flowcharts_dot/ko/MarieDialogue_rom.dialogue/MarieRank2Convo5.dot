		j705881125 -> j3542174089;
	j1273044115 [label="고마워요. 성공하실지는 모르겠지만, 때로는 시도해 보는 것 외에는 방법이 없을 때가 있어요.",shape=box,color=blue];
		j1273044115 -> j3083916220;
	j2130204240 [label="어느쪽이든, 오탁의 기억 속에 남아있는게 무엇이든 당신이 그를 친절히 대한다면, 오래전에 죽은 오탁도 지금 당신께 미소를 지을거라 믿기로 했어요.",shape=box,color=blue];
		j2130204240 -> j1531393501;
	j1406220802 [label="Monsieur 로이드께서 바로 옆에 서 계시는데, 네크랄로이드에게 영혼이 있다고 말씀드리기는 어렵네요, oui?",shape=box,color=blue];
		j1406220802 -> j2130204240;
	j361373833 [label="기술, 아마도요 - 과학, 물론이겠죠 - 그치만 영혼에 관해서요 ? 오로킨들은 자기네들 마음도 제대로 제어할 수 없었을 거에요 ! 거기에 대한 증거가 필요하다면 우리와 함께 다니는 악마 좀 보라죠.",shape=box,color=blue];
