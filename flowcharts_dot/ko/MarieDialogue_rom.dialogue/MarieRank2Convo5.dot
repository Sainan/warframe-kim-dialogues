	j3500059888 [label="오, 당신께 잔인해지라고 종용하는 걸로 오해하지 말아주셨으면 해요 ! Non ! 그들을 소중히 대해주시고, 실제로 소중한 존재들이니까요. 자신들의 잘못으로 지금의 모습을 갖게 된게 아닌 걸 아니까요 !",shape=box,color=blue];
