	j1743131658 [label="당신 말이 맞아. 영혼을 가지고 있지않아. 그렇다고 해서 우리가 함부로 대할 수는 없지.",shape=box,color=red];
		j1743131658 -> j446334214;
	j2846854192 [label="당신 말이 맞는지 틀린지는 모르지만서도. 그들은 여전히 생각하고 느낄 수 있다고. 물건처럼 대할 수 없어.",shape=box,color=red];
