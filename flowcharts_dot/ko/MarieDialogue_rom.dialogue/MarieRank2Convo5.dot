	830 [label="+5 Chemistry",color=orange];
		830 -> 838;
	845 [label="악마와 그 동족들이 죄 받아 마땅하다는 게 옳았다는 또 다른 증거네요. 그러나 어쩌면 오탁과 그의 동족들에 대한 당신의 생각이 맞을지도 모르고요. 어쩌면 그렇게 믿는 게 당신께 평화를 가져다줄지도 모르죠.",shape=box,color=blue];
		845 -> 850;
	846 [label="오로킨 악마들이 남긴 부서진 육신들 때문에 마음이 아픕니다. 오로킨들은 신이 아니라, 자신들이 지나간 모든 것들을 집어 삼키는 포식자였어요. 증거는 우리와 함께 여행하는 자만 봐도 알겠어요.",shape=box,color=blue];
		846 -> 851;
	847 [label="어쩌면 당신이 맞을지도요. 하지만 오로킨 악마들이 우리보다 영혼의 구성에 대해 더 잘 알고 있었다고 생각하진 않습니다. 오로킨은 위대한 신들이 아니었으니까요.",shape=box,color=blue];
		847 -> 852;
	848 [label="어쩌면 오탁과 그의 동족들에 대한 당신의 생각이 맞을지도 모르고요. 어쩌면 그렇게 믿는 게 당신께 평화를 가져다줄지도 모르죠.",shape=box,color=blue];
