		736 -> 739 [label="MarieOtak1",color=purple];
		736 -> 738 [label="MarieFamily1",color=purple];
		736 -> 737 [label="false",color=purple];
	739 [label="이전에 Monsieur 오탁에 대해서 말씀하신 점을 생각해 봤어요.",shape=box,color=blue];
		739 -> 743;
	738 [label="이전에 le Cardinal의 가족에 대해서 말씀하신 점을 생각해 봤어요.",shape=box,color=blue];
		738 -> 742;
	737 [label="다시 한 번 Monsieur \"네크랄로이드\"에 대해서 질문을 드리고 싶은데, 괜찮으신가요?",shape=box,color=blue];
		737 -> 741;
		737 -> 740;
	743 [label="혹시나 저의 경험과 이야기가 비슷한지 궁금해서요. 시간이 되신다면, 제 질문에 답해주실 수 있으신가요 ?",shape=box,color=blue];
		743 -> 749;
		743 -> 748;
	742 [label="네크랄로이드의 뒷면에 있는 아이같은 얼굴, 오탁에 대한 이야기를 들려주실 수 있으신가요?",shape=box,color=blue];
		742 -> 747;
		742 -> 746;
	741 [label="물론이야, 뭐에 대해서 묻고 싶어?",shape=box,color=red];
		741 -> 745;
	740 [label="[종료.]",shape=box,color=red];
		740 -> 744;
	749 [label="질문해 봐.",shape=box,color=red];
		749 -> 754;
	748 [label="[종료.]",shape=box,color=red];
		748 -> 753;
	747 [label="물론이지.",shape=box,color=red];
		747 -> 752;
	746 [label="나중에 하자. [종료.]",shape=box,color=red];
		746 -> 751;
	745 [label="네크랄로이드의 뒷면에 어린 아이가 낙서한 듯한 얼굴이 있는 이유가 궁금해요.",shape=box,color=blue];
		745 -> 750;
	744 [label="Chat ends.",color=orange];
	754 [label="한때 Cathédrale에 과거의 회랑에서 스스로를 잃어버린 수녀가 한 분 계셨어요. 바로 세실리아 수녀님이셨죠.",shape=box,color=blue];
		754 -> 757;
	753 [label="Chat ends.",color=orange];
	752 [label="모든 기록에 따르면 그는 천재였고, 아르곤 크리스탈을 이용한 기술의 선두주자였어.",shape=box,color=red];
		752 -> 756;
	751 [label="Chat ends.",color=orange];
	750 [label="Monsieur 네크랄로이드와 Monsieur 로이드 두 분 모두에게 물어보려 했지만, 둘 다 말하고 싶어하지 않았고, 그저 이름만 말해주었습니다. 오탁. 그리고 둘 다 매우 슬픈 어조로 말해줬어요.",shape=box,color=blue];
		750 -> 755;
	757 [label="그 분께서는 복도에 있는 큰 시계 앞에 서서 지금이 오후 2시라고 외치곤 하셨는데, 당장 몇 시인지는 정확히 모르셨어요.",shape=box,color=blue];
		757 -> 761;
	756 [label="이는 보이드를 다룰 수 있는 힘이었고 - 오로킨이 강력한 워프레임들과 무기류를 제작할 수 있는 이유였어.",shape=box,color=red];
		756 -> 760;
	755 [label="그래서 여기서 당신과 대화를 나누고 있는 거에요. 절 도와주실 수 있기를 바라는 마음에서요.",shape=box,color=blue];
		755 -> 758;
		755 -> 759;
	761 [label="우린 복도에 있는 모든 그림들이 잘못된 방향으로 놓여 있는 걸 발견했고, 수녀님은 그 그림들끼리 끔찍한 음모들을 속삭이고 있다고 말씀하셨습니다.",shape=box,color=blue];
		761 -> 766;
	760 [label="오탁은 결정학을 전문분야로 삼았어. 그의 연구물들이 여기 실험실에 보관되어 있지.",shape=box,color=red];
		760 -> 765;
	758 [label="오탁에 대해서 알고 싶어? 아니면 왜 오탁이랑 대화를 못 하는지 알고 싶은거야?",shape=box,color=red];
		758 -> 762;
	759 [label="오탁은 설명해주기 좀 어려워...",shape=box,color=red];
		759 -> 2919;
	766 [label="나중에 수녀님이 들으신 대화는 다른 방에서 일어나는 대화를 들으신 거고, 그게 그림들이 말하는 걸로 착각하셨다는 걸 알게 됐어요...",shape=box,color=blue];
		766 -> 770;
	765 [label="어떤 이유에서인지, 왜인지 나도 모르겠지만, 세팔론으로 바뀌었고, 자신만의 네크랄로이드 껍데기를 갖게 되었어.",shape=box,color=red];
		765 -> 769;
	762 [label="시간이 어느정도 흐른 뒤에, 둘 다 알고 싶지만, 어디서부터 시작해야 할지는 당신께 맡길래요. 어느쪽이 더 중요한지도 잘 모르겠고요, après tout.",shape=box,color=blue];
		762 -> 2919;
	2919 [label="Check boolean LoidFamilyComplete",color=orange];
		2919 -> 764 [label=true,color=green];
		2919 -> 764 [label=false,color=brown];
		2919 -> 763 [label=false,color=brown];
	770 [label="어떤 날은 휴게실에 있는 모든 쿠션들을 아이들로 착각하시곤, 모두를 초대해서 차를 마시게끔 하셨습니다...",shape=box,color=blue];
		770 -> 774;
	769 [label="모든 세팔론들이 처벌의 형태로서 만들어진 건 아니였어. 하지만 데이모스에서는 일이... 제대로 진행되지 않았고, 심한 부상을 입었어.",shape=box,color=red];
		769 -> 773;
	764 [label="오탁은 한때 오로킨의 과학자이자 학자인 아르키메디안이었어. 그에게 일어난 일은 결코 행복한 이야기가 아니야.",shape=box,color=red];
		764 -> 768;
	763 [label="뭐... 짧게 말하자면, 엔트라티 가족 중 몇몇은 위층에 살고 있는데, 그 사람들은 우리가 여기 아래 있다는 걸 정확히는 몰라.",shape=box,color=red];
		763 -> 767;
	774 [label="제가 방에 들어가자, 그 분께서는 절 올려다보며 말씀하셨습니다. \"오, 오데트 수녀님. 거기 계셨군요! 고아원 아이들이 찾아왔어요. 저희랑 함께 차 드실래요?\"",shape=box,color=blue];
		774 -> 777;
		774 -> 778;
	773 [label="+5 Chemistry",color=orange];
		773 -> 776;
	768 [label="Update boolean MarieOtak1",color=orange];
		768 -> 772;
	767 [label="Update boolean MarieFamily1",color=orange];
		767 -> 771;
	777 [label="어떻게 했어?",shape=box,color=red];
		777 -> 781;
	778 [label="오데트 수녀님은 누구야?",shape=box,color=red];
		778 -> 782;
	776 [label="Pauvre petit...",shape=box,color=blue];
		776 -> 780;
	772 [label="Par les Luminaires... 계속해 주세요.",shape=box,color=blue];
		772 -> 752;
	771 [label="Par les Luminaires... 우리 모두가 비밀리에 여기 있다는 말인가요 ?! 그래서 우리가 여길 떠날 수 없는 건가요 ?! Mais pourquoi ?!",shape=box,color=blue];
		771 -> 775;
	781 [label="의자를 테이블 쪽 빈 자리로 굴려놓고 그 분과 함께 쿠션을 놓고 차를 마셨죠. 그 것말고 제가 할 수 있는 일 뭐가 있었겠어요 ?",shape=box,color=blue];
		781 -> 787;
	782 [label="유감스럽지만, 오데트 수녀님이 돌아가신 지 30년이 흘렀어요.",shape=box,color=blue];
		782 -> 788;
	780 [label="그래서, 오탁은 메인 네크랄로이드 - 유일하게 남아있는 네크랄로이드 - 에게 전이되고... 뭐. 설명하기가 어렵네.",shape=box,color=red];
		780 -> 784;
		780 -> 785;
		780 -> 786;
	775 [label="알브레히트의 딸, 오일러리아 - 어머니라고 알려진 존재와 그녀의 가족들이 이제까지 데이모스를 관리하고 있었어.",shape=box,color=red];
		775 -> 779;
	787 [label="그 분께서 과거 이야기를 해주실 때마다 얼마나 웃었는지. 세실리아 수녀님은 그 누구에게도, 적어도 제가 아는 한, 어느 누구에게도 한 번도 이야기하신 적 없는 그런 이야기들을 해주셨어요.",shape=box,color=blue];
		787 -> 791;
	788 [label="의자를 테이블 쪽 빈 자리로 굴려놓고 그 분과 함께 쿠션을 놓고 차를 마셨죠.",shape=box,color=blue];
		788 -> 787;
	784 [label="솔직히 말해서, 오탁을 고칠 수만 있다면 좋겠어. 진짜 오탁을 다시 데려오는 거야.",shape=box,color=red];
		784 -> 754;
	785 [label="오탁은 날 웃게 만들어. 같이 있으면 즐겁지만, 그 안에는 비극적이고 무너진 무언가가 숨겨져 있어.",shape=box,color=red];
		785 -> 754;
	786 [label="안타깝게도, 오탁은 고칠 수 없어. 그리고 주변 사람들 신경을 거슬리게 하는 것 같아. ",shape=box,color=red];
		786 -> 754;
	779 [label="이 곳과 보이드 에너지를 근원계로 펌핑해내는 심장을 지켜보고, 우리 모두에게... 실제로, 알브레히트 엔트라티가 떠난 이후로도 이 힘을 계속 사용할 수 있게 해줬어.",shape=box,color=red];
		779 -> 783;
	791 [label="그 때, 그 분의 눈이 어떤 때는 밝고, 어떤 때는 흐릿했어요. 마치 어린 아이의 인형과도 같았죠...",shape=box,color=blue];
		791 -> 794;
		791 -> 795;
		791 -> 796;
		791 -> 797;
	783 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		783 -> 789 [label=true,color=green];
		783 -> 790 [label=false,color=brown];
	794 [label="왜 그 수녀님과 함께 앉았어?",shape=box,color=red];
		794 -> 800;
	795 [label="세실리아 수녀님은 어떻게 됐어?",shape=box,color=red];
		795 -> 801;
	796 [label="당신이 그 자리에 있었다는 게 그 분께 뭔가 의미가 있었으면 좋겠어.",shape=box,color=red];
		796 -> 802;
	797 [label="당신 정말 상냥해, 그 분과 함께 앉아줘서 말이야.",shape=box,color=red];
		797 -> 803;
	789 [label="그녀는 알브레히트의 부재를 받아들였고, 가족들과 화해했지만, 그건 힘든 일이었어.",shape=box,color=red];
		789 -> 792;
	790 [label="그녀는 알브레히트의 부재를 받아들이지 못했고, 가족들은 서로의 목을 조르고 있는 형국이었어.",shape=box,color=red];
		790 -> 793;
	800 [label="+15 Chemistry",color=orange];
		800 -> 806;
	801 [label="그 분과 같은 처지에 있는 모든 이들처럼요. 그분도 햇빛 아래 그림처럼 계속해서 희미해져 가고 결국엔 사라져서 아무것도 남지 않았습니다. ",shape=box,color=blue];
		801 -> 807;
	802 [label="+10 Chemistry",color=orange];
		802 -> 808;
	803 [label="+5 Chemistry",color=orange];
		803 -> 809;
	792 [label="자신의 아버지가 밖에 나돌아다니고, 사고란 사고 다 치고 다니고, 딸한테는 말 한마디 없이, 편지 한통조차 보내지 않았다는 걸 알면서도...?",shape=box,color=red];
		792 -> 798;
	793 [label="자신의 아버지가 밖에 나돌아다니고, 사고란 사고 다 치고 다니고, 딸한테는 말 한마디 없이, 편지 한통조차 보내지 않았다는 걸 알면서도...?",shape=box,color=red];
		793 -> 799;
	806 [label="현명한 질문을 해주셨네요. 정말 현명한 질문입니다. 여러가지 이유가 제게 영감을 준 것 같았거든요. 그 분의 테이블로 향한 게 제 안에 있는 친절함이었으면 좋겠습니다만.",shape=box,color=blue];
		806 -> 812;
	807 [label="그리고 나서 그 분께선 우리의 곁을 떠나셨고, 세실리아 수녀님을 위해 촛불 기도회를 열었어요. 스스로에게 진심으로 친절했던 이들을 기억하실 수 있기를 바라는 마음으로요. ",shape=box,color=blue];
		807 -> 813;
	808 [label="저도 그 분의 내면 어딘가에서 이해하셨으리라 믿고 싶어요.",shape=box,color=blue];
		808 -> 813;
	809 [label="하지만 그게 친절함으로 비롯된 행동이었을까요 ? 아니면 스스로가 가진 죄책감 때문에 그랬던 걸까요 ? 아, 하지만 그리 말씀해주시는 당신은 친절한 분이 맞아요. ",shape=box,color=blue];
		809 -> 813;
	798 [label="그게 오일러리아, 어머니에게 있어서 얼마나 고통스러울지 상상할 수도 없어. 다른 가족들에게도.",shape=box,color=red];
		798 -> 804;
	799 [label="그러면 가족들이 가질 수 있는 화해의 가능성도 모두 사라질 거야.",shape=box,color=red];
		799 -> 805;
	812 [label="하지만 제 생각엔 제 내면 깊숙한 곳에 있는 죄책감으로 움직였던 것 같아요. 그 자리에 참석하지 않는다면, 그 분을 무시하는게 될 거라고 생각했으니까요. 마치 아이를 소홀히 대하는 것처럼.",shape=box,color=blue];
		812 -> 813;
	813 [label="오탁이 자신에게 친절하고 인내심 있는 사람들을 알고 있다고 믿고 싶네요. 하지만 다시 생각해 보면, 오탁 스스로가 더 이상 존재하지 않는 것 같아요, 그런가요 ?",shape=box,color=blue];
		813 -> 817;
	804 [label="Le Cardinal의 불가피한 이별로 인해 다른 가족들에게 고통을 안겨준 건 이들을 보호하려는 결정에서 비롯됐다는 점은 알겠으나...",shape=box,color=blue];
		804 -> 810;
	805 [label="+10 Chemistry",color=orange];
		805 -> 811;
	817 [label="제가 말씀드리고 있는 건 사람처럼 보이도록 만들어진 아주 정교한 기술에 대해서에요, 제가 틀렸나요? 훨씬 더 복잡한 phonographe 말이에요. 네크랄로이드처럼, 영혼이 없는 거요.",shape=box,color=blue];
		817 -> 822;
		817 -> 823;
		817 -> 824;
		817 -> 825;
		817 -> 826;
	810 [label="불필요하게 잔인하다고 생각되지 않나요 ? 다른 사람들은 그분이 죽었다고 생각했을 거에요. 아니면 더 최악으로요 ! 그리고 우리는, 여기서 comme des rats d'égout 처럼 있어야 하나요 ?",shape=box,color=blue];
		810 -> 814;
		810 -> 815;
	811 [label="Oui... 왜 그런지 알겠어요. 할 수만 있다면 그분의 가족을 치유하려고 노력하겠어요, non ? 우리가 이곳에서 빠져나갈 수 있는 유일한 희망은 그것 뿐인 것 같으니까요. ",shape=box,color=blue];
		811 -> 816;
	822 [label="네크랄로이드에게 영혼이 없을지 몰라도, 특별한 존재야. 오탁처럼 다른 세팔론들도 그렇고. 그들이 세팔론으로 만들어질 때 파괴되었지만.",shape=box,color=red];
		822 -> 831;
	823 [label="당신 말이 맞아. 그래서 나보고 어찌 해줬음 하는데?",shape=box,color=red];
		823 -> 832;
	824 [label="당신 말이 맞아. 영혼을 가지고 있지않아. 그렇다고 해서 우리가 함부로 대할 수는 없지.",shape=box,color=red];
		824 -> 833;
	825 [label="당신 말이 맞는지 틀린지는 모르지만서도. 그들은 여전히 생각하고 느낄 수 있다고. 물건처럼 대할 수 없어.",shape=box,color=red];
		825 -> 834;
	826 [label="네크랄로이드는 영혼을 가지고 있어. 모든 세팔론들도 그렇고.",shape=box,color=red];
		826 -> 835;
	814 [label="사실 그건 내가 결정할 수 있는 문제가 아니야.",shape=box,color=red];
		814 -> 818;
	815 [label="사실 쥐를 좋아하는 친구가 있어서 말이야. 쥐들은 정말 귀여운 것 같아.",shape=box,color=red];
		815 -> 819;
