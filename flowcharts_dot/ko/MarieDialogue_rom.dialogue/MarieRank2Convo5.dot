	852 [label="기술, 아마도요 - 과학, 물론이겠죠 - 그치만 영혼에 관해서요 ? 오로킨들은 자기네들 마음도 제대로 제어할 수 없었을 거에요 ! 거기에 대한 증거가 필요하다면 우리와 함께 다니는 악마 좀 보라죠.",shape=box,color=blue];
