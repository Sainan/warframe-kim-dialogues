		j3359734167 -> j1077266090;
	j934831935 [label="Oui, 전 아주 괜찮아요, 정말이에요. 하지만 merci. 걱정해줘서 고마워요.",shape=box,color=blue];
		j934831935 -> "Chat ends.";
	j4143293364 [label="하 ! 이게 참 웃기네요, Non ? 당신 말이 맞아요. Mes pieds 생각을 전혀 안 하고 살았는데, 이제 와 생각하니, 아프게 느껴지네요. ",shape=box,color=blue];
		j4143293364 -> j2347386766;
	j810921552 [label="Oui ! 지금 저한테 말을 거시는 거요. 마음이란 건 참으로 신기해요, 그렇지 않나요 ? Mes pieds는 항상 아플거라고 생각하지만, 전 그냥 그걸 무시하는 법을 배웠어요.",shape=box,color=blue];
