		j2147973821 -> j2644623123;
	j2767088750 [label="얘기하고 싶은 확신이 들면, 난 여기 있으니까. 얘기하고 싶으면 해도 돼.",shape=box,color=red];
		j2767088750 -> j2151448895;
	j3330672209 [label="나... 그거 어떤 건지 알아. 내가 \"루프\"를 시작하기 전에, 두비리에서 꽤 심하게 다쳤었어. 다 나았지만, 아직도 가끔씩 엄청 고통이 몰려와. 그리고 고통 때문에 움찔거리는 걸 숨기려고 노력 중이야.",shape=box,color=red];
		j3330672209 -> j2621246166;
	j1077266090 [label="오래된 고질적인 문제들은 새로운 문제들만큼이나 골치 아픈 경우가 있지. 나타났다 사라지고, 우리 곁에 함께 할 수 있다고 해서 이야기할 가치가 없다는 뜻은 아니니까.",shape=box,color=red];
		j1077266090 -> j1857173586;
	j2347386766 [label="마음이란 건 정말 경이로운 존재에요. 항상, 아프다는 게 참 신기한 일이기도 한데, 전 그냥 그걸 무시하는 법을 배웠어요.",shape=box,color=blue];
		j2347386766 -> j453554260;
		j2347386766 -> j2970224232;
		j2347386766 -> j3304284746;
	j453554260 [label="나도 똑같아. 내가 집중하는 순간 - 맞아, 고통이 찾아와. 가끔은 내가 왜 이리 바쁘게 지내는지 궁금해져.",shape=box,color=red];
		j453554260 -> j928378923;
	j2970224232 [label="가끔은 늘 고통에 방해받지 않았더라면 얼마나 많은 일들을 해낼 수 있었을까 생각이 들고 그 점에 화가 나.",shape=box,color=red];
		j2970224232 -> j1378819069;
	j3304284746 [label="당신도 항상 피곤해? 가끔은 내가 왜 이렇게 지쳐 있는지 궁금하거든. 항상 고통에 휩싸여 정신없이 시간을 보내고 있으니까.",shape=box,color=red];
