	j3831928655 [label="Oui, 그래요. Par exemple -",shape=box,color=blue];
		j3831928655 -> j1738614763;
	j1225809982 [label="하지만 당신께서 말씀하신 대로에요, non ? 제가 가진 것처럼 모든 불편함에는 숨겨진 힘이 있다는 거요. 우린 그냥 찾아내기만 하면 되요.",shape=box,color=blue];
		j1225809982 -> j1326430959;
	j2595458180 [label="Oui, 맞아요. 가끔 거기 앉아 선반 맨 윗줄에 놓인 책을 멍하니 바라보고 있노라면, 제가 그 책에 손이 닿지 않는 게 얼마나 부당한지에 대해 생각하곤 했어요.",shape=box,color=blue];
		j2595458180 -> j3172533830;
	j4040021410 [label="며칠 전, 성역에 있는 샹들리에에 쌓인 먼지를 털고 있었는데, Monsieur 로이드께서 그만하라고 간청하셨어요.",shape=box,color=blue];
		j4040021410 -> j1330013872;
	j1700768674 [label="설명하기 어렵지만, 노력해 볼게요. Mes pieds, oui ? 제 발이요. Le sérum이 절 바꿔놓았고, 날 수 있게 해주었지요 -",shape=box,color=blue];
		j1700768674 -> j375095024;
	j107374663 [label="Par les Luminaires, 정말 유감이에요. 그럼 어떤 느낌인지, 이해하시겠네요, oui ?",shape=box,color=blue];
		j107374663 -> j1760157258;
	j599353686 [label="Oui ! 오! 며칠 전, 성역에 있는 샹들리에에 쌓인 먼지를 털고 있었는데, Monsieur 로이드께서 그만하라고 간청하셨어요.",shape=box,color=blue];
		j599353686 -> j1784009858;
	j3319966886 [label="하지만 당신께서 말씀하신 대로에요, non ? 우리가 가진 것처럼 모든 불편함에는 숨겨진 힘이 있다는 거요. 우린 그냥 찾아내기만 하면 되요.",shape=box,color=blue];
		j3319966886 -> j782275738;
	j1100410060 [label="Oui, 당신의 답답함이 이해가 가요. 가끔 거기 앉아 선반 맨 윗줄에 놓인 책을 멍하니 바라보고 있노라면, 제가 그 책에 손이 닿지 않는 게 얼마나 부당한지에 대해 생각하곤 했어요.",shape=box,color=blue];
		j1100410060 -> j304806742;
	j226235234 [label="Oui !! 오, 이해하시는군요 !! Par exemple -",shape=box,color=blue];
		j226235234 -> j401003047;
	j1738614763 [label="다른 사람들은 걸어다닐 수 있는데, jour après jour, heure après heure, 항상 떠다니는 게 얼마나 피곤하지 아시나요 ?",shape=box,color=blue];
		j1738614763 -> j3056929587;
	j1326430959 [label="하지만 맞아요, 답답해요. 가끔 거기 앉아 선반 맨 윗줄에 놓인 책을 멍하니 바라보고 있노라면, 제가 그 책에 손이 닿지 않는 게 얼마나 부당한지에 대해 생각하곤 했어요.",shape=box,color=blue];
		j1326430959 -> j3172533830;
	j3172533830 [label="그 책안에는 제가 알고 싶은 지식이 담겨 있었을 거고, 다른 누구도 아닌, 왜 제가 그 지식을 얻지 못할까요 ? 그리고 절 불쌍히 여겨 그 지식을 그 자리에서 꺼내서 저에게 줄 누군가가 나타나야 하죠...",shape=box,color=blue];
		j3172533830 -> j568793177;
	j1330013872 [label="전 그분께 계속 바쁘게 지내야 한다고, 손을 계속 움직여야 한다고 말씀드렸죠. 하지만 그분께선 제가 왜 그리 활동적으로 지내야 하는지 제대로 이해하지 못하신 것 같았어요.",shape=box,color=blue];
		j1330013872 -> j2946045583;
	j375095024 [label="하지만 전 여전히 느껴요. 절 집어삼키려 하고, 제 영혼의 모든 희망과 joie을 파괴하려 하는 그 뒤틀린 존재들이요.",shape=box,color=blue];
		j375095024 -> j2409210578;
	j1760157258 [label="스스로를 배신하는 육신을 갖는 것, 그 점이 스스로의 정신을 느리게 만든다는 점. 지금도 너무 이상해요. Le sérum이 절 바꿔놓았고, 날 수 있게 해주었지요 -",shape=box,color=blue];
		j1760157258 -> j1472069784;
	j1784009858 [label="전 그분께 계속 바쁘게 지내야 한다고, 손을 계속 움직여야 한다고 말씀드렸죠. 하지만 그분께선 제가 왜 그리 활동적으로 지내야 하는지 제대로 이해하지 못하신 것 같았어요.",shape=box,color=blue];
		j1784009858 -> j1550193408;
	j782275738 [label="하지만, 당신의 답답함이 이해가 가요. 오, 저도 잘 알고 말고요. 가끔 거기 앉아 선반 맨 윗줄에 놓인 책을 멍하니 바라보고 있노라면, 제가 그 책에 손이 닿지 않는 게 얼마나 부당한지에 대해 생각하곤 했어요.",shape=box,color=blue];
		j782275738 -> j304806742;
	j304806742 [label="그 책안에는 제가 알고 싶은 지식이 담겨 있었을 거고, 다른 누구도 아닌, 왜 제가 그 지식을 얻지 못할까요 ? 그리고 절 불쌍히 여겨 그 지식을 그 자리에서 꺼내서 저에게 줄 누군가가 나타나야 하죠...",shape=box,color=blue];
		j304806742 -> j692975324;
		j304806742 -> j1672659063;
	j401003047 [label="다른 사람들은 걸어다닐 수 있는데, jour après jour, heure après heure, 항상 떠다니는 게 얼마나 피곤하지 아시나요 ?",shape=box,color=blue];
		j401003047 -> j3519886589;
	j3056929587 [label="이렇게 움직일 수 있고 원하는 곳, 어디든 갈 수 있다는 점에 ravie 해요. 오해하진 말아주세요. 하지만, 여전히 너무 지쳐요 !",shape=box,color=blue];
		j3056929587 -> j2946045583;
	j568793177 [label="그리고 그건 다른 사람들의 잘못이 아니에요. 친절한 행동을 하시는 것뿐이니까요. 전 도움이 필요하고요. 제가 도움이 필요한 점도 그분들의 잘못이 아니고요. 하지만 그 도움이 필요하다는 점이 얼마나 답답한 부분인지.",shape=box,color=blue];
		j568793177 -> j1735226164;
		j568793177 -> j4011356706;
	j2946045583 [label="그저... 이 모든 것에 대해 이야기할 수 있다는 점이... 정말 너무 좋네요. 말로는 다 표현할 수가 없어요. 제가 겪는 이런 보이지 않는, 소리없는 전염병에 대해 이야기할 수 있다는 건 정말 드문 일이거든요.",shape=box,color=blue];
		j2946045583 -> j1844415262;
