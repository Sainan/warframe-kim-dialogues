	j1035510958 [label="신앙에 대해선 말씀드리진 않겠습니다만... 이 제한된 관점에서 우리의 형태를 생각해야 지점에서 결여된 부분이 있기에, 우리는... 있는 그대로의 우리 모습에서 평화를 찾아야 한다는 점만 말씀드리겠습니다, non ? 그게 우리가 할 수 있는 전부니까요.",shape=box,color=blue];
		j1035510958 -> j2548984291;
	j2747321299 [label="우리의 신앙이 비슷하다고는 생각이 들지만, 솔께선... 저를 지금의 모습으로 만드셨다고만 말씀드리고 싶어요. 전 그분의 설계를 믿어야 해요, non ? 저의 제한된 시야로는 그게 아무리 잘못되었다 생각이 들더라도 말이에요. 당신도 그리 생각하실지 궁금하네요.",shape=box,color=blue];
		j2747321299 -> j2548984291;
	j3502926088 [label="우리 신앙의 형태가 다르다는 점을 알기에, 제 지식이 모자란 부분에 대해선 말을 아끼겠어요. 하지만 제가 할 수 있는 말은 그저, 솔께서는 합당한 이유가 있어 저를 이런 모습으로 창조하셨고, 저는 그분의 뜻에 믿음을 가져야 한다는 것이죠, non ? 제 모자란 시야에선 아무리 잘못되어 보이더라도 말이에요. 당신 또한 그런 식으로 생각하실 수는 없는지 싶네요.",shape=box,color=blue];
		j3502926088 -> j2548984291;
	j2296796262 [label="당신의 믿음은 당신께 개인적이란 걸 알고 있으니, 굳이 캐묻지는 않겠어요. 하지만 제가 할 수 있는 말은 그저, 솔께서는 합당한 이유가 있어 저를 이런 모습으로 창조하셨고, 저는 그분의 뜻에 믿음을 가져야 한다는 것이죠, non ? 제 모자란 시야에선 아무리 잘못되어 보이더라도 말이에요. 당신 또한 그런 식으로 생각하실 수는 없는지 싶네요.",shape=box,color=blue];
		j2296796262 -> j2548984291;
	j3032208032 [label="솔께서 우릴 있는 그대로 만드셨기에, 우린 그분의 설계를 믿어야 해요. 우리의 제한된 시야로는 그게 아무리 잘못되었다 생각이 들더라도 말입니다.",shape=box,color=blue];
		j3032208032 -> j2548984291;
	j397025263 [label="루아께선 우리를 루아처럼, 솔께선 나란 존재를 솔처럼 만드셨어요. 우리는 그분들의 설계를 믿어야 해요, non ? 우리가 가진 제한된 시야로는 그게 아무리 잘못되었다 생각이 들더라도 말입니다.",shape=box,color=blue];
		j397025263 -> j2548984291;
	j1185482567 [label="광휘의 성체들께선 우리를 있는 그대로 만드셨기에, 우리 모두 그분들의 설계를 믿어야 해요, non ? 우리의 제한된 시야로는 그게 아무리 잘못되었다 생각이 들더라도 말입니다.",shape=box,color=blue];
		j1185482567 -> j2548984291;
	j837481038 [label="우리 중 누구도 우주의 진정한 답을 알 수 없다는 믿음을 굳게 고수하고 계시다는 건 알고, 그 점에 대해선 감탄하고 존중한답니다. 하지만 제가 할 수 있는 말은 그저, 솔께서는 합당한 이유가 있어 저를 이런 모습으로 창조하셨고, 저는 그분의 뜻에 믿음을 가져야 한다는 것이죠, non ? 제 모자란 시야에선 아무리 잘못되어 보이더라도 말이에요.",shape=box,color=blue];
		j837481038 -> j2548984291;
	j1593659943 [label="당신께서 스스로 신앙을 갖지 않으신다는 걸 알고, 그 점을 존중해요. 하지만 제가 할 수 있는 말은 그저, 솔께서는 합당한 이유가 있어 저를 이런 모습으로 창조하셨고, 저는 그분의 뜻에 믿음을 가져야 한다는 것이죠, non ? 제 모자란 시야에선 아무리 잘못되어 보이더라도 말이에요.",shape=box,color=blue];
