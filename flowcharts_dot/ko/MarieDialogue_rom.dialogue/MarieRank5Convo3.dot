		2851 -> 2852;
	2852 [label="그 책안에는 제가 알고 싶은 지식이 담겨 있었을 거고, 다른 누구도 아닌, 왜 제가 그 지식을 얻지 못할까요 ? 그리고 절 불쌍히 여겨 그 지식을 그 자리에서 꺼내서 저에게 줄 누군가가 나타나야 하죠...",shape=box,color=blue];
		2852 -> 2861;
	2853 [label="전 그분께 계속 바쁘게 지내야 한다고, 손을 계속 움직여야 한다고 말씀드렸죠. 하지만 그분께선 제가 왜 그리 활동적으로 지내야 하는지 제대로 이해하지 못하신 것 같았어요.",shape=box,color=blue];
		2853 -> 2862;
	2858 [label="하지만 전 여전히 느껴요. 절 집어삼키려 하고, 제 영혼의 모든 희망과 joie을 파괴하려 하는 그 뒤틀린 존재들이요.",shape=box,color=blue];
		2858 -> 2867;
	2859 [label="스스로를 배신하는 육신을 갖는 것, 그 점이 스스로의 정신을 느리게 만든다는 점. 지금도 너무 이상해요. Le sérum이 절 바꿔놓았고, 날 수 있게 해주었지요 -",shape=box,color=blue];
		2859 -> 2868;
	2863 [label="전 그분께 계속 바쁘게 지내야 한다고, 손을 계속 움직여야 한다고 말씀드렸죠. 하지만 그분께선 제가 왜 그리 활동적으로 지내야 하는지 제대로 이해하지 못하신 것 같았어요.",shape=box,color=blue];
		2863 -> 2872;
	2864 [label="하지만, 당신의 답답함이 이해가 가요. 오, 저도 잘 알고 말고요. 가끔 거기 앉아 선반 맨 윗줄에 놓인 책을 멍하니 바라보고 있노라면, 제가 그 책에 손이 닿지 않는 게 얼마나 부당한지에 대해 생각하곤 했어요.",shape=box,color=blue];
