		2865 -> 2873;
		2865 -> 2874;
	2866 [label="다른 사람들은 걸어다닐 수 있는데, jour après jour, heure après heure, 항상 떠다니는 게 얼마나 피곤하지 아시나요 ?",shape=box,color=blue];
		2866 -> 2875;
	2860 [label="이렇게 움직일 수 있고 원하는 곳, 어디든 갈 수 있다는 점에 ravie 해요. 오해하진 말아주세요. 하지만, 여전히 너무 지쳐요 !",shape=box,color=blue];
		2860 -> 2862;
	2861 [label="그리고 그건 다른 사람들의 잘못이 아니에요. 친절한 행동을 하시는 것뿐이니까요. 전 도움이 필요하고요. 제가 도움이 필요한 점도 그분들의 잘못이 아니고요. 하지만 그 도움이 필요하다는 점이 얼마나 답답한 부분인지.",shape=box,color=blue];
		2861 -> 2869;
		2861 -> 2870;
	2862 [label="그저... 이 모든 것에 대해 이야기할 수 있다는 점이... 정말 너무 좋네요. 말로는 다 표현할 수가 없어요. 제가 겪는 이런 보이지 않는, 소리없는 전염병에 대해 이야기할 수 있다는 건 정말 드문 일이거든요.",shape=box,color=blue];
		2862 -> 2871;
	2867 [label="항상 아파요. 항상. 지금도, 여기 앉아있음에도, 발을 생각하고 있노라면, 고통이 느껴져요. 하지만, 그걸 알아차리는 것만으론 충분치 않아요.",shape=box,color=blue];
