		j212108202 -> j2147973821;
	j801968418 [label="지금 저한테 말을 거시는 거요. 마음이란 건 참으로 신기해요, 그렇지 않나요 ? Mes pieds는 항상 아플거라고 생각하지만, 전 그냥 그걸 무시하는 법을 배웠어요.",shape=box,color=blue];
