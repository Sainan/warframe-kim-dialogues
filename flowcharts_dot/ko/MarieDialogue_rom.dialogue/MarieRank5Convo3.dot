	j2644623123 [label="Non... 이 고통은 끝나지 않아요. 이렇게 대화를 나누는 것처럼 주의를 돌리는 방법 밖에 없어요. 아니면 계속 바쁘게 지내거나요.",shape=box,color=blue];
