		j2824057119 -> j810921552;
	j212108202 [label="Oui, 그런 것 같아요. 마음이란 건 정말 경이로운 존재에요. 항상, 아프다는 게 참 신기한 일이기도 한데, 전 그냥 그걸 무시하는 법을 배웠어요.",shape=box,color=blue];
		j212108202 -> j3233858790;
