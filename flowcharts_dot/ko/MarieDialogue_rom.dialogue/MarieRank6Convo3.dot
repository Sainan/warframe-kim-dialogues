	j603361935 [label="로이드를 설득해서 계단 위로 올라가서 가족들과 이야기하게 하는 방법에 대해 생각해 봤는데... 좋은 방법이 떠올랐어. 당신이 좋아하지 않을 것 같지만.",shape=box,color=red];
