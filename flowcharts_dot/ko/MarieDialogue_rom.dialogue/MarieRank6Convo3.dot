		3667 -> 3675;
	3668 [label="그럴 수도, 그렇지만 그냥 대부분은 그저 쇼를 즐기기 위해서 그런 것 뿐인 것 같아.",shape=box,color=red];
		3668 -> 3676;
	3662 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3662 -> 3671;
	3674 [label="악마는 변덕스럽거든요 ! 다른 이들이 말하듯이, C'est la vie !",shape=box,color=blue];
		3674 -> 3682;
	3673 [label="그리고 이 모든 일이 일어나도록 당신이 한 역할을 알아차리지 못할 만큼 전 바보가 아니랍니다 !",shape=box,color=blue];
		3673 -> 3681;
	3672 [label="Check boolean MarieDating",color=orange];
		3672 -> 3680 [label=true,color=green];
		3672 -> 3679 [label=false,color=brown];
	3677 [label="오 ! 제가 하려던 말은 그런 의미가 아니었어요, pardonne-moi ! 그냥 그자가 당신을 편애하는 것 같아서요. 다른 이들은 무시해도 당신 말이라면 그자 귀에 들어갈 것 같아서 부탁하려던 거에요.",shape=box,color=blue];
		3677 -> 3684;
	3678 [label="+5 Chemistry",color=orange];
		3678 -> 3685;
