	3698 [label="악마가 당신을 편애하는 것 같아도, 다른 이들 말은 무시하는 것 같으니 당신 말이라면 들어줄 거라곤 말씀드릴 수 없겠네요.",shape=box,color=blue];
		3698 -> 3709;
	3692 [label="로스의 삶 속 모든 존재들이 그를 괴물로 만들려고 애썼어. 아마 내가 그러지 않은 첫 번째 사람이겠지.",shape=box,color=red];
		3692 -> 3703;
	3693 [label="로스는 겉으로 드러내지 못하는 부분이 많아. 갑옷을 둘렀다고 할 순 없지만, 사람들이 자신을 해치지 않을 거라고 믿지 못하는 것 같아.",shape=box,color=red];
