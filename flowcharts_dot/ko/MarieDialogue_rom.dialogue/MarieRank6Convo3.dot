		j149162938 -> j3569999725;
	j3608740850 [label="당신이 행복해서 정말 기쁘네요. 그리고 악마가 노력을... 쏟을 곳이 있다니 더할 나위 없지요, non ?",shape=box,color=blue];
		j3608740850 -> j1696967187;
	j2359943802 [label="악마가 당신을 편애하는 것 같아도, 다른 이들 말은 무시하는 것 같으니 당신 말이라면 들어줄 거라곤 말씀드릴 수 없겠네요.",shape=box,color=blue];
		j2359943802 -> j505501067;
	j1146680319 [label="로스의 삶 속 모든 존재들이 그를 괴물로 만들려고 애썼어. 아마 내가 그러지 않은 첫 번째 사람이겠지.",shape=box,color=red];
		j1146680319 -> j1361312806;
	j1258718909 [label="로스는 겉으로 드러내지 못하는 부분이 많아. 갑옷을 둘렀다고 할 순 없지만, 사람들이 자신을 해치지 않을 거라고 믿지 못하는 것 같아.",shape=box,color=red];
		j1258718909 -> j3085821375;
	j3018034421 [label="로스는... 정말 오랜 세월 동안 정말 큰 상처를 받았어. 가시로 뒤덮였을 뿐, 그게 다야.",shape=box,color=red];
		j3018034421 -> j2893738139;
	j2272352687 [label="로스가 얼마나 오래 살았는지를 생각하면 이해할 수 있을 것 같아. 나도 로스와 똑같은 수의 죽음을 봐왔으니까.",shape=box,color=red];
		j2272352687 -> j900103594;
	j2513078074 [label="로스는 옳은 일만 하려고 노력해 왔어. 물론 잘못된 방향으로 갔을지도 모르지만, 그는 오로킨으로부터 근원계를 구하려고 노력했어.",shape=box,color=red];
		j2513078074 -> j514040150;
	j3903391029 [label="로스가 가진 유머 센스를 좋아해. 당신이 가진 자존심의 벽을 극복하면 로스를 영리하다고 생각할 거야.",shape=box,color=red];
		j3903391029 -> j180760308;
