	3607 [label="Chat ends.",color=orange];
	3609 [label="로이드를 설득해서 계단 위로 올라가서 가족들과 이야기하게 하는 방법에 대해 생각해 봤는데... 좋은 방법이 떠올랐어. 당신이 좋아하지 않을 것 같지만.",shape=box,color=red];
		3609 -> 3614;
	3610 [label="로이드를 설득해서 위층에 있는 엔트라티 가족과 대화하는 방법에 대해 더 생각해 봤어?",shape=box,color=red];
		3610 -> 3615;
	3611 [label="로이드와 엔트라티 가족에 대한 대화를 시도하는 주제에 대해서, 그... 로스의 개입을 전혀 재고해보지 않을 생각이야?",shape=box,color=red];
		3611 -> 3616;
	3612 [label="마리, 당신 아직도... 로이드를 설득해서 \"위층 이웃\"들과 얘기하는 것에 고려하고 있어? 우리가 좀 이상하게 얘기를 마무리 지은 것 같아서 말이야.",shape=box,color=red];
		3612 -> 3616;
	3608 [label="Monsieur 로이드가 le Cardinal의 가족분들과 대화하는 걸 얼마나 두려워하시는지 생각해 봤어요.",shape=box,color=blue];
		3608 -> 3613;
