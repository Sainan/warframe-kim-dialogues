	3616 [label="Check boolean MarieDating",color=orange];
		3616 -> 3623 [label=true,color=green];
		3616 -> 3622 [label=false,color=brown];
	3613 [label="이 교착 상태를 어찌 깨뜨려야 할까요. 우리가 갇힌 이 purgatoire는 더 이상 이 상태로 지속되어선 안 됩니다. 너무나 불필요하게 고통스러워 보여요.",shape=box,color=blue];
		3613 -> 3617;
	3619 [label="Bonjour, mon coeur ! 제가 싫어할까봐 걱정되는 점이 뭐에요 ?",shape=box,color=blue];
		3619 -> 3625;
	3618 [label="Bonjour, mon coeur ! 오 ? 제가 싫어할까봐 걱정되는 점이 뭐에요 ?",shape=box,color=blue];
		3618 -> 3625;
	3621 [label="Bonjour, mon coeur ! 좀 여러가지 생각해 봤는데, oui... 솔직히 인정하기 싫네요. 이렇게 말하는 게 전혀 즐겁지 않아요.",shape=box,color=blue];
		3621 -> 3626;
	3620 [label="Bonjour, mon coeur ! 좀 여러가지 생각해 봤는데, oui... 솔직히 인정하기 싫네요. 이렇게 말하는 게 전혀 즐겁지 않아요.",shape=box,color=blue];
		3620 -> 3626;
	3623 [label="Bonjour, bonjour, mon coeur ! 좀 여러가지 생각해 봤는데, oui... 솔직히 인정하기 싫네요. 이렇게 말하는 게 전혀 즐겁지 않아요.",shape=box,color=blue];
		3623 -> 3627;
	3622 [label="Bonjour - 좀 여러가지 생각해 봤는데, oui... 솔직히 인정하기 싫네요. 이렇게 말하는 게 전혀 즐겁지 않아요.",shape=box,color=blue];
		3622 -> 3627;
	3617 [label="하지만 우리에게는... 어떤 종류의 보루가 필요하다고 생각이 들어요, non ? 혹시 좋은 생각 있으신지요 ?",shape=box,color=blue];
		3617 -> 3624;
		3617 -> 3625;
	3625 [label="로이드가 엔트라티 가족과 대화하도록 설득하려면 로스의 도움이 필요할 것 같아. 도움 없이는 로이드가 우리가 원하는 대로 움직여줄 것 같지 않아. 가족들과 그가 안전할 거라는 보장 없이는 말이야.",shape=box,color=red];
		3625 -> 3629;
	3626 [label="하지만 제 생각엔... 제 생각엔 - 아, 솔이시여 용서해 주시길 - 그 악마의 도움이 필요할 것 같습니다. 그렇지 않으면 Monsieur 로이드께서 우리 말을 들어주지 않을 것 같아요.",shape=box,color=blue];
		3626 -> 3630;
	3627 [label="당신 말이 맞을지도 모르겠네요. 악마가 우리에게 놓치고 있던 조각일지도. 아, 이런 글을 적는 것조차 너무 괴롭네요 ! ",shape=box,color=blue];
		3627 -> 3631;
	3624 [label="끔찍한 원천에서 도움을 받지 않고서는 좋은 아이디어가 떠오르지 않아. 나중에 큰 곤경에 빠질 수도 있는 원천 말야. 바로, 로스야.",shape=box,color=red];
		3624 -> 3628;
	3629 [label="전... 인정하고 싶지 않으나, 당신이 옳을 수도 있겠네요... 솔이시여 절 용서해 주시길.",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="악마는 강력하고, 일이 잘못될 경우 힘을 주겠다고 약속하겠죠, non ?",shape=box,color=blue];
		3630 -> 3634;
		3630 -> 3635;
