	3628 [label="정말 그리 생각하시나요 ? 제가 악마와의 différences를 해결할 수 있다면, 당신도 분명 해결하실 수 있겠죠, non ?",shape=box,color=blue];
		3628 -> 3632;
		3628 -> 3633;
	3634 [label="아니, 분명 다른 방법이 있을 거야. 이 문제에 관해서 로스에게 도움을 요청하는 건 거부할래.",shape=box,color=red];
		3634 -> 3628;
	3635 [label="당신 말이 맞아. 동의할 줄은 몰랐어. 묻기가 두려웠거든.",shape=box,color=red];
		3635 -> 3631;
	3638 [label="/Lotus/Language/1999Texting/MarieRomance/Marie_MarieRank6Convo3_3118 begins.",shape=box,color=blue];
		3638 -> 3644;
	3637 [label="이 점에 있어서 그자가 우리에게 도움을 줄 것 같나요 ?",shape=box,color=blue];
		3637 -> 3643;
	3636 [label="이 점에 있어서 그자가 우리에게 도움을 줄 것 같나요 ?",shape=box,color=blue];
