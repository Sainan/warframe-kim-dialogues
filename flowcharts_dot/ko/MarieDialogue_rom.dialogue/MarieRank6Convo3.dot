	j3486137034 [label="아니, 미안. ",shape=box,color=red];
		j3486137034 -> j3684840173;
	j1221173394 [label="좋아. 당신이 괜찮다면, 나도 괜찮아.",shape=box,color=red];
		j1221173394 -> j949163689;
	j3884593614 [label="안타깝게도, 아니... 로스와의 관계는 끝난 것 같아. 다른 방법이 있을까?",shape=box,color=red];
		j3884593614 -> j2932098753;
	j3707277709 [label="우릴 도와줄 거야. 가족들을 재결하는 걸 도와달라고 설득했거든 - 당신도 믿기지 않을 거야 - 아무래도 엔트라티 가족들을 지킬려고 하는 것 같아. 어쨌든 남아있는 오로킨은 그들이 전부니까.",shape=box,color=red];
		j3707277709 -> j2141483867;
	j1910112401 [label="우릴 도와줄 거야. 가족들을 재결하는 걸 도와달라고 설득했거든 - 놀랄 일도 아니지만서도 - 내 생각엔 그 인간이 가족들 곁에 없는 걸 이용해서 악의적인 목적을 가지고 도와주는 것 같아.",shape=box,color=red];
		j1910112401 -> j2979190731;
	j1055307792 [label="아직 아무것도 정해지지 않았어. 로스는... 뭐, 어떤 성격인지 알잖아.",shape=box,color=red];
		j1055307792 -> j2913252443;
	j2558821194 [label="아직도 작업 중이지만, 그리 될 것 같아.",shape=box,color=red];
