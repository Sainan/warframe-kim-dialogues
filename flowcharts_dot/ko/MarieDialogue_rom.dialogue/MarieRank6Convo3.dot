		j1199840061 -> j534999224;
	j3176199949 [label="Oui, 잘 알지요. 하지만 다른 모든 사람들이 실패한 것과는 달리 당신은 그자를 설득할 수 있는 특별한 방법을 가지고 있다고 생각합니다, non ?",shape=box,color=blue];
