	j1752521862 [label="로이드와 엔트라티 가족에 대한 대화를 시도하는 주제에 대해서, 그... 로스의 개입을 전혀 재고해보지 않을 생각이야?",shape=box,color=red];
		j1752521862 -> j1903226774;
	j1344939697 [label="마리, 당신 아직도... 로이드를 설득해서 \"위층 이웃\"들과 얘기하는 것에 고려하고 있어? 우리가 좀 이상하게 얘기를 마무리 지은 것 같아서 말이야.",shape=box,color=red];
		j1344939697 -> j1903226774;
	j4253794099 [label="Monsieur 로이드가 le Cardinal의 가족분들과 대화하는 걸 얼마나 두려워하시는지 생각해 봤어요.",shape=box,color=blue];
