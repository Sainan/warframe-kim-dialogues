		3639 -> 3645;
		3639 -> 3646;
	3632 [label="아니, 미안. ",shape=box,color=red];
		3632 -> 3640;
	3633 [label="좋아. 당신이 괜찮다면, 나도 괜찮아.",shape=box,color=red];
		3633 -> 3641;
	3644 [label="안타깝게도, 아니... 로스와의 관계는 끝난 것 같아. 다른 방법이 있을까?",shape=box,color=red];
		3644 -> 3650;
	3643 [label="우릴 도와줄 거야. 가족들을 재결하는 걸 도와달라고 설득했거든 - 당신도 믿기지 않을 거야 - 아무래도 엔트라티 가족들을 지킬려고 하는 것 같아. 어쨌든 남아있는 오로킨은 그들이 전부니까.",shape=box,color=red];
		3643 -> 3649;
	3642 [label="우릴 도와줄 거야. 가족들을 재결하는 걸 도와달라고 설득했거든 - 놀랄 일도 아니지만서도 - 내 생각엔 그 인간이 가족들 곁에 없는 걸 이용해서 악의적인 목적을 가지고 도와주는 것 같아.",shape=box,color=red];
		3642 -> 3648;
	3645 [label="아직 아무것도 정해지지 않았어. 로스는... 뭐, 어떤 성격인지 알잖아.",shape=box,color=red];
		3645 -> 3651;
	3646 [label="아직도 작업 중이지만, 그리 될 것 같아.",shape=box,color=red];
		3646 -> 3652;
	3640 [label="+20 Chemistry",color=orange];
		3640 -> 3647;
	3641 [label="Oui, 꼭 즐길 필요는 없겠지만, 우리가 삼켜야하는 un médicament인 것 같네요.",shape=box,color=blue];
		3641 -> 3631;
	3650 [label="오 ! 그건... 안타깝네요. 전 잘 모르겠어요 ? 그리 생각하지 않거든요... 악마에게 다른 방법으로 접근해 볼 수 있지 않을까요 ? 아니면 다시 시도해보거나 ?",shape=box,color=blue];
		3650 -> 3657;
