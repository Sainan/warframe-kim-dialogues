	j3684840173 [label="+20 Chemistry",color=orange];
		j3684840173 -> j458275704;
	j949163689 [label="Oui, 꼭 즐길 필요는 없겠지만, 우리가 삼켜야하는 un médicament인 것 같네요.",shape=box,color=blue];
		j949163689 -> j636489540;
	j2932098753 [label="오 ! 그건... 안타깝네요. 전 잘 모르겠어요 ? 그리 생각하지 않거든요... 악마에게 다른 방법으로 접근해 볼 수 있지 않을까요 ? 아니면 다시 시도해보거나 ?",shape=box,color=blue];
		j2932098753 -> j1541800504;
