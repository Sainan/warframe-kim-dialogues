		3657 -> 3666;
	3656 [label="+20 Chemistry",color=orange];
		3656 -> 3665;
	3654 [label="적어도, 도와는 주겠지. 그리고 로스가 실제로 위험한 행동을 실행에 옮기지 못하도록 확실하게 지켜볼거야.",shape=box,color=red];
		3654 -> 3663;
	3655 [label="그냥 선한 행동하는 게 부끄러워서 만들어낸 변명같다고 생각이 들지만.",shape=box,color=red];
		3655 -> 3664;
	3659 [label="Oui, 잘 알지요. 하지만 다른 모든 사람들이 실패한 것과는 달리 당신은 그자를 설득할 수 있는 특별한 방법을 가지고 있다고 생각합니다, non ?",shape=box,color=blue];
		3659 -> 3669;
		3659 -> 3670;
	3658 [label="Oui, 아주 잘 알지요. 악마는 평소에도 고집이 센 편이에요. 가끔, 그냥 사람들 의견 반대하는 걸 즐기는 것 같거든요 !",shape=box,color=blue];
		3658 -> 3667;
		3658 -> 3668;
	3660 [label="다른 모든 사람들이 실패한 것과는 달리 당신은 그자를 설득할 수 있는 특별한 방법을 가지고 있다고 생각합니다, non ?",shape=box,color=blue];
		3660 -> 3669;
