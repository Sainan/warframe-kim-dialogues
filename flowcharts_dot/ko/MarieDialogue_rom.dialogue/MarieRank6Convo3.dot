		j665279251 -> j3569999725;
	j1696967187 [label="특히 당신이 그자의 어깨에 앉아 악마를 화나게 하는 작은 un ange 역할을 한다면 우리 모두에게 더욱 좋겠지요.",shape=box,color=blue];
		j1696967187 -> j3299158852;
		j1696967187 -> j3843091527;
	j505501067 [label="그리고 함께 나누는 개인적인 순간들에 그런 말들 절대로 나누지 마세요. Non. Jamais.",shape=box,color=blue];
		j505501067 -> j3286641605;
		j505501067 -> j1055701058;
	j1361312806 [label="그리고 요즘 제가 그 목록 맨 위에 있다 이거죠, non ? 그렇다면... 그자가 이유를, 왜 항상 그런 식으로 행동하는지를 고려해야겠네요. 정죄는 영혼을 구원하지 못하니까요.",shape=box,color=blue];
		j1361312806 -> j697539491;
	j3085821375 [label="우리 모두는 항상 주변 이들에게 숨기는 고통을 가지고 있지요. 다른 존재들이 그 고통을 이용할까 봐 숨기려 하는 것이죠. 당신 말이 맞다면, 그자에게 더 친절히 대해야 할 것 같네요.",shape=box,color=blue];
		j3085821375 -> j697539491;
	j2893738139 [label="그 모든 세월 동안 얼마나 많은 사랑과 상실을 겪었을지 상상조차 할 수 없네요. 제가 본 모든 걸 고려해봐도, 그 사실이 너무 비현실적으로 느껴져요.",shape=box,color=blue];
		j2893738139 -> j3978002088;
	j900103594 [label="가끔 그자와 대화를 나누다보면 그가 얼마나 많은 세월을 살았는지 잊어버리곤 합니다. 제가 본 모든 것을 고려하더라도, 그 사실이 너무나 비현실적으로 느껴져요.",shape=box,color=blue];
		j900103594 -> j4159484328;
	j514040150 [label="항상... 미묘한 차이가 있어요, oui ? 어떤 식으로 행동하든 항상 이유가 있어요. 당신 말이 맞다면, 그자에게 더 친절히 대해야 할 것 같네요.",shape=box,color=blue];
