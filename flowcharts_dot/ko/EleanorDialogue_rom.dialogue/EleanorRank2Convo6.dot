		789 -> 790;
	790 [label="아 그렇군. 너는 썬더볼트 왕이 공정한 엘레노어를 영입하기 위해 보내진 선택받은 사자로군. 의심할 여지없이 온갖 속임수가 나를 기다리고 있겠네. Fol de rol 등등.",shape=box,color=blue];
