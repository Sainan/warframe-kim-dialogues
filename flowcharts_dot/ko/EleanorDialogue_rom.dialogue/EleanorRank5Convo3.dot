	2315 [label="나랑 거래하자. 레티한테 가서 간단한 심리 평가를 해달라고 하고, 여기서 실제로 무슨 일이 일어나고 있는지 자세히 파악하고 나면, 이 대화는 잊어버리는 거야.",shape=box,color=blue];
