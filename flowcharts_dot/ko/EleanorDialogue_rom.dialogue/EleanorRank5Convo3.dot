		2298 -> 2305;
	2302 [label="Chat ends.",color=orange];
	2307 [label="네가 찾고 있던 걸 찾게 돼서 너무 기뻐. 모든 강은 결국 바다로 가는 길을 찾지.",shape=box,color=blue];
		2307 -> 2313;
	2303 [label="흠, 이제 내가 널 속이기 위해 뭘 했는지 궁금하네. 아니면 널 조종하려고. 어쩌면 내가 네 머릿속에 어떤 제안을 했을지도 모르잖아.",shape=box,color=blue];
		2303 -> 2308;
	2305 [label="흠, 이제 내가 널 속이기 위해 뭘 했는지 궁금하네. 아니면 널 조종하려고. 어쩌면 내가 네 머릿속에 어떤 제안을 했을지도 모르잖아. 아니면 내 시스템에 끌리는 2차 테크병 바이러스가 네 시스템에 있을 수도 있고.",shape=box,color=blue];
