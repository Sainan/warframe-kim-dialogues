		2293 -> 2844;
	2294 [label="내 말은... 우리는 지금 무엇을 하고 있는지 알고 있어. 확산을 억제하고 있고. 네가 해야 하는 일을 해냈고. 여기 있을 필요가 없어. 그런데도...",shape=box,color=blue];
		2294 -> 2844;
	2295 [label="아, 수수께끼 같은 말은 하지 마. 어떻게든 너에게서 정보를 빼내야 할 것 같으니까.",shape=box,color=blue];
