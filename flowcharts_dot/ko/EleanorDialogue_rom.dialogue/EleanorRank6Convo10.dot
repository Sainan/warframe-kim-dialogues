digraph {
	3285 [label="EleanorRank6Convo10 begins.",color=orange];
		3285 -> 3286;
	3286 [label="생각이 들더란 말이지, 12월이 끝날 때 늘 그랬듯 올해는 맨 처음으로 돌아갈 거고, 느끼기엔 완전 새로운 한 해처럼 느껴지겠지만, 사실은 아닐 거라는 거",shape=box,color=blue];
		3286 -> 3287;
	3287 [label="그리고 난 이런 루프가 지금까지 몇 번 일어났는지 알고 있다고 믿지만, 실제로는 아닐 거라는 거지. 왜냐면 기억을 못 하고 있을지도 모르니까",shape=box,color=blue];
		3287 -> 3288;
	3288 [label="내가 1회차 루프라고 생각했던 게 사실은 5만 42회차였으면 어쩔 거야?",shape=box,color=blue];
		3288 -> 3289;
	3289 [label="그러다가 이런 생각도 했어. 젠장, 다 관두자. 그냥 완전히 미쳐 날뛰어서 뭐든 원하는 대로 해도 되지 않아? 왜냐면 네가 바닥 한 번만 내려치면 다 원래대로 돌아갈 일이니까",shape=box,color=blue];
		3289 -> 3290;
	3290 [label="하지만 곧바로 또 '아니, 잠깐만. 만약 이 해가 진짜 그대로 확정되는 해면 어떻게 해? 드디어 1999년에서 2000년으로 넘어갈 수 있는 해가 바로 지금이라면?' 하고.",shape=box,color=blue];
		3290 -> 3291;
	3291 [label="드디어 찾아온 운명의 마지막 1999년이 될 그 한 번의 루프에서 완전히 구제불능의 바보가 되고 싶진 않아. 아마 그 꼬인 걸 풀 일도 요원할 테고.",shape=box,color=blue];
		3291 -> 3292;
	3292 [label="지겨울 정도로 오래 된 비유를 쓰자면, 분명 어느 날엔, 끝없는 겨울이 아닌 진짜 솔스티스가 찾아오겠지",shape=box,color=blue];
		3292 -> 3293;
	3293 [label="Check boolean EleanorDating",color=orange];
		3293 -> 3295 [label=true,color=green];
		3293 -> 3294 [label=false,color=brown];
	3295 [label="그 때까진 너와 나, 둘이서 서로를 따뜻하게 데워 주며 버티면 되는 일일 거야. (쪽)",shape=box,color=blue];
		3295 -> 3297;
	3294 [label="그 때까진 우리 모두 계속, 서로를 따뜻하게 데워 주며 버티면 되는 일일 거야.",shape=box,color=blue];
		3294 -> 3296;
	3297 [label="Chat ends.",color=orange];
	3296 [label="Chat ends.",color=orange];
}