digraph {
	"EleanorRank6Convo10 begins." [color=orange];
		"EleanorRank6Convo10 begins." -> j4118835246;
	j4118835246 [label="생각이 들더란 말이지, 12월이 끝날 때 늘 그랬듯 올해는 맨 처음으로 돌아갈 거고, 느끼기엔 완전 새로운 한 해처럼 느껴지겠지만, 사실은 아닐 거라는 거",shape=box,color=blue];
		j4118835246 -> j2484008802;
	j2484008802 [label="그리고 난 이런 루프가 지금까지 몇 번 일어났는지 알고 있다고 믿지만, 실제로는 아닐 거라는 거지. 왜냐면 기억을 못 하고 있을지도 모르니까",shape=box,color=blue];
		j2484008802 -> j2826918952;
	j2826918952 [label="내가 1회차 루프라고 생각했던 게 사실은 5만 42회차였으면 어쩔 거야?",shape=box,color=blue];
		j2826918952 -> j2638787497;
	j2638787497 [label="그러다가 이런 생각도 했어. 젠장, 다 관두자. 그냥 완전히 미쳐 날뛰어서 뭐든 원하는 대로 해도 되지 않아? 왜냐면 네가 바닥 한 번만 내려치면 다 원래대로 돌아갈 일이니까",shape=box,color=blue];
		j2638787497 -> j2976933757;
	j2976933757 [label="하지만 곧바로 또 '아니, 잠깐만. 만약 이 해가 진짜 그대로 확정되는 해면 어떻게 해? 드디어 1999년에서 2000년으로 넘어갈 수 있는 해가 바로 지금이라면?' 하고.",shape=box,color=blue];
		j2976933757 -> j2229627833;
	j2229627833 [label="드디어 찾아온 운명의 마지막 1999년이 될 그 한 번의 루프에서 완전히 구제불능의 바보가 되고 싶진 않아. 아마 그 꼬인 걸 풀 일도 요원할 테고.",shape=box,color=blue];
		j2229627833 -> j1917801627;
	j1917801627 [label="지겨울 정도로 오래 된 비유를 쓰자면, 분명 어느 날엔, 끝없는 겨울이 아닌 진짜 솔스티스가 찾아오겠지",shape=box,color=blue];
		j1917801627 -> j420725480;
	j420725480 [label="Check boolean EleanorDating",color=orange];
		j420725480 -> j3826660598 [label=true,color=green];
		j420725480 -> j2952777987 [label=false,color=brown];
	j3826660598 [label="그 때까진 너와 나, 둘이서 서로를 따뜻하게 데워 주며 버티면 되는 일일 거야. (쪽)",shape=box,color=blue];
		j3826660598 -> "Chat ends.";
	j2952777987 [label="그 때까진 우리 모두 계속, 서로를 따뜻하게 데워 주며 버티면 되는 일일 거야.",shape=box,color=blue];
		j2952777987 -> "Chat ends.";
	"Chat ends." [color=orange];
}