digraph {
	143 [label="EleanorRank1Convo3 begins.",color=orange];
		143 -> 144;
	144 [label="그래서, 보이드 말인데.",shape=box,color=blue];
		144 -> 145;
	145 [label="사실 상당히 궁금하거든. 그래서...",shape=box,color=blue];
		145 -> 146;
	146 [label="...질문을 좀 속사포로 쏟아붓게 될 것 같은데, 괜찮아?",shape=box,color=blue];
		146 -> 147;
		146 -> 148;
		146 -> 149;
	147 [label="그럼.",shape=box,color=red];
		147 -> 154;
	148 [label="전부 답해주지 못할 지도 모르지만, 해 봐.",shape=box,color=red];
		148 -> 153;
	149 [label="아니. [종료.]",shape=box,color=red];
		149 -> 150;
	154 [label="좋아. 그럼...",shape=box,color=blue];
		154 -> 155;
	153 [label="+10 Chemistry",color=orange];
		153 -> 152;
	150 [label="... 그래, 그래서 넌 아직 내가 좋아하는 그 신비로운 아우라를 가지고 있는 거야.",shape=box,color=blue];
		150 -> 151;
	155 [label="... 보이드가 너에게 어떤 의미인지, 몇 마디로 요약해 줄 수 있을까?",shape=box,color=blue];
		155 -> 156;
		155 -> 157;
