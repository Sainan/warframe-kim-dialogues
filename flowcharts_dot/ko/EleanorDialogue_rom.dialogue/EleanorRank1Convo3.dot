	152 [label="솔직히 말해 준 거구나. 고마워.",shape=box,color=blue];
		152 -> 154;
	151 [label="Chat ends.",color=orange];
	156 [label="좀 취조당하는 것 같은 느낌인데. 인터뷰야 이거?",shape=box,color=red];
		156 -> 159;
	157 [label="나에게 어떤 \"의미\"냐고?",shape=box,color=red];
		157 -> 160;
	158 [label="보이드가 정확히 무엇인지는 아무도 확신하지 못해. 차원이면서, 에너지 필드기도 하고, 공간을 가로지르는 지름길이면서, 오로킨들이 숨은 도피처이기도 하고...",shape=box,color=red];
		158 -> 161;
	159 [label="미안. 오래된 습관이라서.",shape=box,color=blue];
		159 -> 162;
	160 [label="그래.",shape=box,color=blue];
		160 -> 163;
	161 [label="다 흥미로운 이야기긴 하지만, 그건 기술적인 측면에 더 가까운 것 같구나. 나는 네게 보이드가 어떤 의미인지에 더 관심이 있었어. 그게 너는, 뭐, 보이드 그 자체와 함께 살며 숨쉬는 것 같으니까. 말 그대로.",shape=box,color=blue];
		161 -> 164;
		161 -> 165;
		161 -> 166;
	162 [label="실수했어. 난 이제 더 이상 기자도 아니고, 넌 기삿거리도 아니지. 그냥, 내가 너무 관심이 많이 갈 뿐이야.",shape=box,color=blue];
		162 -> 164;
		162 -> 165;
		162 -> 166;
	163 [label="네 개인적인 감상을 들려줘.",shape=box,color=blue];
		163 -> 164;
		163 -> 165;
		163 -> 166;
	164 [label="보이드는 내게 불가능한 일을 할 수 있는 능력을 줬어. 에너지 빔을 쏘고, 실체 없는 형태로 변하고, 뭐 그런 겁나 좋은 것들. 내가 온 곳에선, 보이드가 바로 워프레임이 할 수 있는 그 모든 것들을 가능케 만드는 근원이야.",shape=box,color=red];
		164 -> 201;
	165 [label="보이드는 내 부모님을 미치게 만들었어.",shape=box,color=red];
		165 -> 167;
	166 [label="얼마만큼인지도 모르는 시간 동안, 보이드는 내 집이었어. 내게 맞춰 스스로 형태를 바꿨지. 혹은 어떻게 해서든 내가 직접 빚어냈거나. 정확히 무슨 일이 일어났는지는, 아직도 잘 모르곘어.",shape=box,color=red];
		166 -> 169;
	201 [label="잠깐. 잠깐.",shape=box,color=blue];
		201 -> 202;
	167 [label="미안, 괜히 물어본 게 잘못이란 생각이 드는구나.",shape=box,color=blue];
		167 -> 168;
	169 [label="오오, 아주 열심히 듣고 있단다. 계속해.",shape=box,color=blue];
		169 -> 170;
	202 [label="그러니까 네 말은, 보이드란 게 기적을 일으키는 엔진이라는 거니?",shape=box,color=blue];
		202 -> 203;
	168 [label="이제 괜찮으시니?",shape=box,color=blue];
		168 -> 171;
	170 [label="Check boolean EleanorDuviri",color=orange];
		170 -> 172 [label=true,color=green];
		170 -> 174 [label=false,color=brown];
	203 [label="그리고 난 이미 거기 연결되어 있는 거고?",shape=box,color=blue];
		203 -> 205;
	171 [label="괜찮아질 기회조차 없었지.",shape=box,color=red];
		171 -> 176;
	172 [label="빚어졌다는건... 두비리를 말하는 거지? 탑, 섬, 날아다니는 말, 그런 것들.",shape=box,color=blue];
		172 -> 178;
	174 [label="어떤 형태를 취했지?",shape=box,color=blue];
		174 -> 179;
	205 [label="연결돼 있다니, 무슨 얘기야?",shape=box,color=red];
		205 -> 204;
	176 [label="오, 솔이시여. 끔찍해라.",shape=box,color=blue];
		176 -> 177;
	178 [label="그래. 말 그대로 아이들의 동화에 생명을 불어넣은 거지.",shape=box,color=red];
		178 -> 182;
	179 [label="'두비리 이야기'라고, 내가 좋아했던 책이 있었어. 마법 왕국에 대한 이야기였지만, 사실은 감정과, 그 감정들이 줄 수 있는 교훈에 대한 이야기였지.",shape=box,color=red];
		179 -> 180;
	204 [label="내 말은, 난 이제 워프레임이잖아. 아니, 프로토프레임인가, 그들과 비슷한 거고.",shape=box,color=blue];
		204 -> 206;
	177 [label="이 이야기, 지금은 그만 할까?",shape=box,color=blue];
		177 -> 175;
		177 -> 173;
	182 [label="그리고 그 모든 게 현실이었다고? 꿈처럼 느껴지지 않았어?",shape=box,color=blue];
		182 -> 189;
	180 [label="보이드가 그 이야기에 생명을 불어넣었고, 난 그 안에서 살게 된 거야. 그리고 후에 그곳은 감옥이 되었지. 뭐, 다른 얘기지만.",shape=box,color=red];
		180 -> 181;
	206 [label="그리고 능력을 쓸 수 있지. 정신 조종이라던가, 뇌 과부하.",shape=box,color=blue];
		206 -> 207;
	175 [label="괜찮아.",shape=box,color=red];
		175 -> 186;
	173 [label="그래, 안 하는 게 좋겠어. [종료.]",shape=box,color=red];
		173 -> 183;
	189 [label="아니, 엘레노어, 매일 아침 죽임을 당한다는 건 꿈 같지 않았어. 그 모든 순간을 고스란히 느껴야 했다고.",shape=box,color=red];
		189 -> 190;
	181 [label="Update boolean EleanorDuviri",color=orange];
		181 -> 182;
	207 [label="내 안에서 나오는 힘이 거기서 나오는 거라고? 보이드?",shape=box,color=blue];
		207 -> 208;
	186 [label="자식으로부터 부모를 떼어놓는 것. 서로를 적대하게 만드는 것. 내가 듣기엔 우연이 아닌 것 같은 걸.",shape=box,color=blue];
		186 -> 187;
	183 [label="그럼, 다음에.",shape=box,color=blue];
		183 -> 184;
	190 [label="그래.",shape=box,color=blue];
		190 -> 192;
	208 [label="잠깐만, 멈춰 봐. 내가 온 시간에선, 이... 펌프같은 게 있었거든. 데이모스의 심장이라고.",shape=box,color=red];
		208 -> 209;
	187 [label="의식을 가지고 의도한 것처럼 들려.",shape=box,color=blue];
		187 -> 188;
	184 [label="Update boolean EleanorDrifterParentsAsked",color=orange];
		184 -> 185;
	192 [label="난...",shape=box,color=blue];
		192 -> 196;
	209 [label="잠깐만, 마음 좀 가라앉히고 있어.",shape=box,color=blue];
		209 -> 210;
	188 [label="거의 뭐, 뒤틀린 과학처럼.",shape=box,color=blue];
		188 -> 191;
	185 [label="Chat ends.",color=orange];
	196 [label="그게 어떤 건지, 생각해봐야겠구나.",shape=box,color=blue];
		196 -> 197;
	210 [label="좋아. 하던 얘기 마저 해. 더 듣고 싶어 견딜 수가 없으니.",shape=box,color=blue];
		210 -> 211;
	191 [label="맞아. 보이드 안엔 무언가가 있어. 그 정도까진 알아. 무심, 감기지 않는 눈, '벽 속의 남자'. 내가 '보이드가 뭔가 했다'고 말한다면, 실제로는 이 작자가 했다는 얘기야.",shape=box,color=red];
		191 -> 193;
	197 [label="현실이 된 말들. 무에서부터 창조된, 구체적인 현실,",shape=box,color=blue];
		197 -> 215;
	211 [label="데이모스의 심장은 근원계 전체를 일종의 보이드 후광으로 감싼 채 유지하고 있어. 자연 방사선처럼. 보이드 에너지를 끌어오는 모든 것들은 그 심장에 의존하고 있지.",shape=box,color=red];
		211 -> 212;
	193 [label="그래서, 보이드와 그 존재는 동일한 게 아니란 말이야?",shape=box,color=blue];
		193 -> 195;
	215 [label="'마법'이라는 단어만으론 너무 모자라게 느껴지는걸.",shape=box,color=blue];
		215 -> 218;
	212 [label="그렇다면 말이지.",shape=box,color=blue];
		212 -> 213;
	195 [label="동일할 수도 있지. 난 아니길 바라지만.",shape=box,color=red];
		195 -> 194;
	218 [label="+10 Chemistry",color=orange];
		218 -> 216;
	213 [label="내가 사는 시간에 데이모스의 심장이 없다면, 보이드는 어떻게 나한테까지 닿고 있는 걸까?",shape=box,color=blue];
		213 -> 214;
	194 [label="Update boolean EleanorDrifterParents",color=orange];
