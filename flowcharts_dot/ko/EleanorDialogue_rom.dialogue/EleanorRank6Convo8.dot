		j1477853228 -> j2048823929;
	j3150413965 [label="아니, 넌 절대 지뢰밭이 아니야.",shape=box,color=red];
		j3150413965 -> j3761861993;
	j468242212 [label="응, 그 애가 뭘 보고 그런 소릴 했는지 알 것 같아. 미안. 하지만 그 애 말이 맞아.",shape=box,color=red];
		j468242212 -> j3795668132;
