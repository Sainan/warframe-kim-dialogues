		j1106361614 -> "Chat ends.";
	j2448442506 [label="마치 내가 뭔가를 의도해서 말하면 넌 가장 최악의 해석으로 곧바로 점프하는 느낌이야.",shape=box,color=red];
		j2448442506 -> j2898620380;
	j3284023915 [label="가끔은 네가 아예 채팅방을 나가버리는 바람에 거기에 더 뭐라 설명할 기회조차 없는 경우도 있고.",shape=box,color=red];
		j3284023915 -> j2898620380;
	j2898620380 [label="...뭐",shape=box,color=blue];
		j2898620380 -> j547622588;
	j547622588 [label="일단 지금 느끼기엔, 당장 로그아웃해서 두 번 다시 KIM따위 쓰고 싶지 않아지는구나.",shape=box,color=blue];
