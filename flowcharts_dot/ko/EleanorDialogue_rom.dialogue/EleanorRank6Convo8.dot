		3216 -> 3217;
	3217 [label="그게, 카야가 내게 그런 말을 했거든. 그리고 그걸 듣고 다른 사람들과 나눈 대화를 모두 돌아보니, 갑자기 나 자신이 다른 관점으로 보이면서 '이런, 젠장' 하게 되는 순간을 겪은 거지.",shape=box,color=blue];
		3217 -> 3218;
