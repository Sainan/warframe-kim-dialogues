		3222 -> 3225;
		3222 -> 3226;
	3223 [label="그래. 둘이서 채팅을 하고 있던 중에 갑자기 그런 말을 꺼내더구나. '당신은 멋지지만, 순 지뢰밭이야. 뭘 꺼내든 당신이 어떻게 반응할지 전혀 알 수가 없어.' 라고.",shape=box,color=blue];
		3223 -> 3218;
		3223 -> 3219;
	3224 [label="그렇다니 기뻐. 고맙구나.",shape=box,color=blue];
		3224 -> 3227;
	3225 [label="그래도 카야가 그걸 지적해서 다행이야. 난 별 해가 없는 내용을 말했다고 생각했는데, 넌 내가 네 머리에 불이라도 붙인 것처럼 반응할 때가 있었거든.",shape=box,color=red];
		3225 -> 3228;
