		j3356819717 -> j3895480956;
	j3895480956 [label="그러니까, 이걸 항상 염두에 둬 줬으면 하는데,",shape=box,color=blue];
		j3895480956 -> j1114835676;
	j1114835676 [label="나는 텔레파시를 할 수 있어. 원하지도 않았지만, 그렇게 됐어. 그래서 사람의 생각을 읽을 수 있지.",shape=box,color=blue];
		j1114835676 -> j1164673442;
	j1164673442 [label="그래도 직접 얼굴을 맞댄 채 대화할 땐, 네가 뭘 어떻게 느끼는지 알 수 있는 온갖 단서가 보여.",shape=box,color=blue];
		j1164673442 -> j2848245753;
