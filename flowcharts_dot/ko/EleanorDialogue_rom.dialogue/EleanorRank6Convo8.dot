		j3795668132 -> j3395262318;
		j3795668132 -> j4024389786;
	j1339439653 [label="그래. 둘이서 채팅을 하고 있던 중에 갑자기 그런 말을 꺼내더구나. '당신은 멋지지만, 순 지뢰밭이야. 뭘 꺼내든 당신이 어떻게 반응할지 전혀 알 수가 없어.' 라고.",shape=box,color=blue];
		j1339439653 -> j3150413965;
		j1339439653 -> j468242212;
	j2555771183 [label="그렇다니 기뻐. 고맙구나.",shape=box,color=blue];
		j2555771183 -> j1106361614;
	j3395262318 [label="그래도 카야가 그걸 지적해서 다행이야. 난 별 해가 없는 내용을 말했다고 생각했는데, 넌 내가 네 머리에 불이라도 붙인 것처럼 반응할 때가 있었거든.",shape=box,color=red];
		j3395262318 -> j2448442506;
		j3395262318 -> j3284023915;
	j4024389786 [label="가끔 네 반응이 정말 극단적일 때가 있거든. 내가 말한 내용에 비해 너무 과도할 정도로.",shape=box,color=red];
		j4024389786 -> j3284023915;
		j4024389786 -> j2448442506;
