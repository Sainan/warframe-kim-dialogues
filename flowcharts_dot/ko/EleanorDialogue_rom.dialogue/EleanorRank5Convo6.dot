digraph {
	2541 [label="EleanorRank5Convo6 begins.",color=orange];
		2541 -> 2542;
	2542 [label="오늘 아침에 쇼핑몰이 조금 다르게 느껴질 수도 있어.",shape=box,color=blue];
		2542 -> 2543;
	2543 [label="딱히 크게 눈에 띄는 건 없어. 그냥 몇 명의 얼굴에 미소가 보이더라. 여기저기서 웃음소리가 들리고. 공기 중에 행복이 뿌려졌달까.",shape=box,color=blue];
		2543 -> 2544;
		2543 -> 2545;
	2544 [label="네 기분에 따른 거겠지?",shape=box,color=red];
		2544 -> 2547;
	2545 [label="금방 돌아올게. [종료.]",shape=box,color=red];
		2545 -> 2546;
	2547 [label="그냥 내가 보답하는 방식이라고 해두자. 텔레파시는 보낼 수도 있지만 받을 수도 있어. 호스파이프를 한 사람에게만 뿌릴 필요는 없지. 한 지역에 뿌려지는 미세한 안개같이.",shape=box,color=blue];
		2547 -> 2548;
	2546 [label="Chat ends.",color=orange];
	2548 [label="네가 온 곳에는 온 동네에 잔디 스프링클러가 있니?",shape=box,color=blue];
		2548 -> 2549;
		2548 -> 2550;
	2549 [label="우린 VERD-IE랑 드론이 있어. 자리만의 식물들을 돌보는 임무를 맡고 있고. 그런 걸 얘기하는 건가?",shape=box,color=red];
		2549 -> 2551;
	2550 [label="스프링...클러?",shape=box,color=red];
		2550 -> 2552;
	2551 [label="그럴 거야.",shape=box,color=blue];
		2551 -> 2553;
	2552 [label="그래, 얘야, 스프링클러. 잔디를 촉촉하고 아름답게 유지하는 물 분무기 같은 거.",shape=box,color=blue];
		2552 -> 2554;
	2553 [label="난 어렸을 때 잔디 스프링클러를 좋아했어. 마법 같았지. 태양이 밝을 때, 그 안에서 무지개를 잡을 수 있었어. 그 무지개를 뚫고 지나갈 때면 맛있는 추위가 온몸에 느껴졌어.",shape=box,color=blue];
		2553 -> 2555;
	2554 [label="또 네 형제가 비명을 지를 때까지 그의 얼굴에 쏘아대기 아주 적격이지.",shape=box,color=blue];
		2554 -> 2555;
	2555 [label="'행복은 잔디 스크링클러에서'. 인사말 카드에 적어봐.",shape=box,color=blue];
		2555 -> 2556;
	2556 [label="오늘은 기분이 좋아 보이네. 다행이다.",shape=box,color=red];
		2556 -> 2557;
	2557 [label="응 좋아. 그리고 이걸 왜 혼자만 간직해야 하는지 모르겠어. 쇼핑몰 전체에 꽉 채우고 싶어.",shape=box,color=blue];
		2557 -> 2558;
		2557 -> 2559;
		2557 -> 2560;
	2558 [label="그건 사람들을 약에 취하게 하는 거랑 비슷한 거 아냐?",shape=box,color=red];
		2558 -> 2561;
	2559 [label="긍정적 기분을 여기저기 떠드는 거? 안될 게 뭐야. 음악을 연주하는 것과 어떻게 다른 건지 모르겠네.",shape=box,color=red];
		2559 -> 2562;
	2560 [label="그럼 오늘이 아서가 웃는 걸 볼 수 있는 날인가?",shape=box,color=red];
		2560 -> 2563;
	2561 [label="... 하. 기쁨을 뿌려주는 비밀스러운 요정이 돼보려 했는데, 대신 사악한 마약 도깨비가 되어 버렸네. 내 행복 무드 급하락함.",shape=box,color=blue];
		2561 -> 2564;
	2562 [label="오! 좋은 비유네!",shape=box,color=blue];
		2562 -> 2566;
	2563 [label="아마도. 그러면 좋겠네. 그는 너무 많은 걸 견뎌내야 했거든.",shape=box,color=blue];
		2563 -> 2567;
	2564 [label="좋아. 그만 둘게.",shape=box,color=blue];
		2564 -> 2565;
	2566 [label="만약 아오이가 음악으로 분위기를 바꿀 수 있다면, 나도 분위기를 통해 바꿀 수 있지 않을까?",shape=box,color=blue];
		2566 -> 2568;
	2567 [label="네가 온 후로 정말 많은 것이 변했어. 우리만을 말하는 게 아냐. 전부 다. 쇼핑몰까지도.",shape=box,color=blue];
		2567 -> 2568;
	2565 [label="Chat ends.",color=orange];
	2568 [label="아오이가 날 설득한 게 한 수였네. 그녀에게 축복을.",shape=box,color=blue];
		2568 -> 2569;
		2568 -> 2570;
	2569 [label="잠깐. 걔가 뭘 했다고?",shape=box,color=red];
		2569 -> 2571;
	2570 [label="있어봐. 나 뭔가를 놓친 거 같아.",shape=box,color=red];
		2570 -> 2571;
	2571 [label="내가 말 안 했어?",shape=box,color=blue];
		2571 -> 2572;
	2572 [label="아. 네가 도착하기 얼마 전이었어. 우리는 하루 종일 밖에서 테크병 벌집을 없애고 있었지. 공기 중에는 살인적인 긴장감이 감돌고 있었고. 싸움은 보통 우리의 분노를 불태우고 서로를 공격하기에는 너무 지치게 만들지만, 그날은 달랐어.",shape=box,color=blue];
		2572 -> 2573;
	2573 [label="아서가 '우리는 내일 이걸 다시 한다'라고 말했던 게 기억나. 그 말은 우리 모두를 한 방 먹인 듯했지. 쇼핑몰로 돌아가는 길에 아무도 말을 하지 않았어.",shape=box,color=blue];
		2573 -> 2574;
		2573 -> 2575;
		2573 -> 2576;
	2574 [label="와우. 팀 사기를 높이는 방법이 대단하군, 아서.",shape=box,color=red];
		2574 -> 2579;
	2575 [label="그는 정말 매력적일 수 있겠어...",shape=box,color=red];
		2575 -> 2579;
	2576 [label="그는 어깨에 많은 짐을 지고 있었어. 그게 힘든 거지.",shape=box,color=red];
		2576 -> 2577;
	2579 [label="그는 우리가 일에 집중하도록 하려고 했던 거 같아. 하지만 난 그냥 망가진 기분이었어. 아서와 아오이는 말을 하지 않았고, 아미르는 퀸시의 신경을 너무 많이 건드려서 그의 목숨이 달아나지 않을까 두려웠고, 레티는 기회가 있을 때마다 나를 곁눈질로 쳐다보고 있었어.",shape=box,color=blue];
		2579 -> 2580;
	2577 [label="그렇지. 보통 그는 잘 숨기는 편이야. 체력이 바닥난 순간에도. 근데 아마 그날은 아무것도 남지 않았을 거야.",shape=box,color=blue];
		2577 -> 2578;
	2580 [label="그날 나는 거울을 들여다보며 많은 시간을 보냈어. 나는 내 투영이 내 목을 움켜쥐고 '네가 문제야. 너만 없었다면 이런 일은 일어나지 않았을 거야.'라고 경멸하는 것을 계속 상상했어.",shape=box,color=blue];
		2580 -> 2581;
		2580 -> 2582;
	2578 [label="팀을 하나로 유지하려고 스스로를 지치게 만든 거지.",shape=box,color=blue];
		2578 -> 2579;
	2581 [label="모두가 변화를 위해 네 머릿속으로 들어갔다는 소리 같군.",shape=box,color=red];
		2581 -> 2583;
	2582 [label="그건 레티가 한 헛소리 같군.",shape=box,color=red];
		2582 -> 2584;
	2583 [label="아, 이건 그들이 한 게 아냐. 나였어. 내가 억누르고 있던 자기 의심과 증오의 모든 조각들이 쏟아져 나온 거야.",shape=box,color=blue];
		2583 -> 2585;
	2584 [label="고마워. 네가 내 편이라는 거 알아. 그건 나에겐 아주 큰 의미야.",shape=box,color=blue];
		2584 -> 2586;
	2585 [label="난 생각했지. 이 그룹에 필요한 건 희생양이구나.",shape=box,color=blue];
		2585 -> 2587;
	2586 [label="나는 레티의 말을 너무 많이 들어서, 스스로 그렇게 생각하게 되었어. 어쩌면 걔 말이 맞을지도 몰라. 내가 여기 남으면 모두를 위험에 빠뜨리게 되는 거야.",shape=box,color=blue];
		2586 -> 2588;
	2587 [label="괴물. 비난할 누군가가 필요했던 거야.",shape=box,color=blue];
		2587 -> 2588;
	2588 [label="나는 모든 계획을 세웠어. 밤이 되면 몰라 빠져나가서, 아서가 절대 찾아낼 수 없는 도시 어딘가에 숨어 - 이게 내가 가장 자랑스러워하는 부분인데 - 멀리서 계속 도와주자.",shape=box,color=blue];
		2588 -> 2589;
		2588 -> 2590;
	2589 [label="그가 널 찾아냈을 거 같은데. 그는 꽤 단호하잖아.",shape=box,color=red];
		2589 -> 2591;
	2590 [label="더 가능성 있는 시나리오는 그가 당신을 찾으려다가 죽었다는 거.",shape=box,color=red];
		2590 -> 2592;
	2591 [label="어떻게? 아미르는 텔레파시를 추적할 수 없잖아.",shape=box,color=blue];
		2591 -> 2593;
	2592 [label="나한테 죄책감을 주려는 거야?",shape=box,color=blue];
		2592 -> 2594;
	2593 [label="나는 고귀한 망명자가 되려고 했어. 지붕 위에 웅크리고 앉아 바람이 휘날려도 단호한 표정을 짓고. 테크병의 건설 상황을 보고하고, 헥스에서 스칼드라가 봉쇄한 도로의 위치를 알려주고, 비상 통신 중계 역할도 할 수 있었지. 레티를 살려줄 때마다, 그녀가 느끼게 하고 싶었지. 사소하다고? 물론이지.",shape=box,color=blue];
		2593 -> 2595;
	2594 [label="그러지 마. 난 이미 충분히 끔찍하다고.",shape=box,color=blue];
		2594 -> 2598;
	2595 [label="내 순간을 선택했어. 아미르가 잠들 때까지 기다렸다가 긴 코트를 입고 가능한 한 조용히 차고로 향했지.",shape=box,color=blue];
		2595 -> 2596;
	2598 [label="Chat ends.",color=orange];
	2596 [label="근데 보안 격자가 저절로 내려오는 거야. 돌아보니 아오이가 있더라고.",shape=box,color=blue];
		2596 -> 2597;
	2597 [label="우리는 밤새도록 이야기하며 서로 부둥켜안고 울었어. 그녀도 아파했어. 아주 깊이. 해가 뜰 무렵, 나는 남기로 결심했어.",shape=box,color=blue];
		2597 -> 2599;
		2597 -> 2600;
		2597 -> 2601;
	2599 [label="마음을 바꿀 시간은 아직 있어.",shape=box,color=red];
		2599 -> 2602;
	2600 [label="아오이는 정말 멋지네. 그녀가 네 옆에 있었던 게 참 다행이야.",shape=box,color=red];
		2600 -> 2604;
	2601 [label="운이 좋았지.",shape=box,color=red];
		2601 -> 2604;
	2602 [label="어떤 기괴한 충동이 너를 이끌었든지 간에, 그걸 잘 참아내길 바래.",shape=box,color=blue];
		2602 -> 2603;
	2604 [label="+20 Chemistry",color=orange];
		2604 -> 2605;
	2603 [label="Chat ends.",color=orange];
	2605 [label="응. 우리 여섯 모두 새해 전날 여기 있어야 했나 봐. 물론, 너도. 때론 문 앞에 있는 낯선 사람이, 행운을 가져다주기도 하지.",shape=box,color=blue];
		2605 -> 2606;
	2606 [label="Chat ends.",color=orange];
}