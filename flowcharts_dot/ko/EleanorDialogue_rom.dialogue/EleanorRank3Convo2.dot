	931 [label="여기 있어. 얘기해.",shape=box,color=red];
		931 -> 933;
	932 [label="내가 루살카의 생각을 들여다보려고 노력하다가, 그 대신 무심과 접촉하게 된 얘기 기억나니?",shape=box,color=blue];
