		935 -> 938;
	934 [label="루살카 소령에게 무슨 일이 일어났었는지 알고 있니?",shape=box,color=blue];
		934 -> 936;
		934 -> 937;
	938 [label="그래. 사실 그때는 이야기할 준비가 되지 않았었어. 네가 원한다면, 지금 할 수 있는데.",shape=box,color=blue];
		938 -> 945;
	936 [label="그녀는 이용 당했어. 무심이 그녀를 꼭두각시로 만들었어.",shape=box,color=red];
		936 -> 939;
	937 [label="그녀는 속이 빈 채로... 음... 워프레임처럼 움직이고 있었던 거 같아...?",shape=box,color=red];
		937 -> 940;
	945 [label="네가 확실하다면.",shape=box,color=red];
		945 -> 946;
	939 [label="'무심'. 그걸 그렇게 부르니?",shape=box,color=blue];
		939 -> 941;
	940 [label="그렇지, 속이 비었지.",shape=box,color=blue];
		940 -> 942;
	946 [label="어 확실해.",shape=box,color=blue];
		946 -> 947;
	941 [label="고마워.",shape=box,color=blue];
		941 -> 943;
	942 [label="하지만 그녀를 움직이는 건 너와 달랐어.",shape=box,color=blue];
		942 -> 944;
	947 [label="이 생물, 이 존재, 우리가 맞서 싸워야 하는 거야. 이제 그 정도는 알아.",shape=box,color=blue];
		947 -> 951;
	943 [label="그렇게 이름을 붙이니까 내가 조금이나마 통제력을 되찾은 거 같은 기분이 드네.",shape=box,color=blue];
		943 -> 948;
	944 [label="인간 같은 모든 게 가짜 같았다고 해야 하나.",shape=box,color=blue];
		944 -> 949;
	951 [label="제발 진실을 말해줘. 희망이 있다고 믿니?",shape=box,color=blue];
		951 -> 956;
		951 -> 957;
		951 -> 958;
	948 [label="나는 내 생각으로 그것에 접촉했어. 루살카의 생각을 알아낼 줄 알았지만... 바깥쪽이 젖은 스펀지 같은 석고보드처럼 무너져 내리더니 그 안에 갇혀 버린 거야. 허우적거리며.",shape=box,color=blue];
		948 -> 950;
	949 [label="상점에 있는 마네킹 같았어. 조각난.",shape=box,color=blue];
		949 -> 952;
	956 [label="이 시점에서? ... 아니.",shape=box,color=red];
		956 -> 960;
	957 [label="솔직히 말하면? 난... 잘 모르겠어.",shape=box,color=red];
		957 -> 961;
	958 [label="그래, 믿어.",shape=box,color=red];
		958 -> 962;
	950 [label="Update boolean EleanorIndifference",color=orange];
		950 -> 951;
	952 [label="알다시피, 내가 접촉해 봤잖아. 내 생각으로. 그녀를 좀 알아보려고 했는데, 거기에 없더라고.",shape=box,color=blue];
		952 -> 953;
	960 [label="적어도 솔직은 하네.",shape=box,color=blue];
		960 -> 963;
	961 [label="이해해.",shape=box,color=blue];
		961 -> 964;
	962 [label="이유는 말하지 마.",shape=box,color=blue];
		962 -> 965;
	953 [label="무슨 말인지 알겠어. 우리는 그것을 무심이라고 부르는 거잖아.",shape=box,color=red];
		953 -> 954;
	963 [label="좋아. 희망은 개나 줘버리자.",shape=box,color=blue];
		963 -> 966;
	964 [label="세상엔 우리가 모르는 게 너무 많아.",shape=box,color=blue];
		964 -> 967;
	965 [label="그 믿음을 붙잡고 있어봐. 내가 느낄 수 있게.",shape=box,color=blue];
		965 -> 968;
	954 [label="고마워.",shape=box,color=blue];
		954 -> 955;
	966 [label="나는 순수한 피의 맹세로 완강하게 계속 싸워나갈 거야.",shape=box,color=blue];
		966 -> 969;
	967 [label="올해 이미 일이 벌어졌는데, 어떻게 다시 온전한 정신으로 계획을 세울 수 있을까?",shape=box,color=blue];
		967 -> 970;
	968 [label="제발.",shape=box,color=blue];
		968 -> 971;
	955 [label="그렇게 이름을 붙이니까 내가 조금이나마 통제력을 되찾은 거 같은 기분이 드네.",shape=box,color=blue];
		955 -> 959;
	969 [label="증오든. 분노든. 뭐든.",shape=box,color=blue];
		969 -> 973;
	970 [label="어쩌면 희망은 망상일지도 몰라. 모르겠어.",shape=box,color=blue];
		970 -> 974;
	971 [label="루살카에게 손을 뻗었더니, 내 손가락이 그녀의 얼굴에 닿고는 바로 뚫려버리는 것 같았어. 가면이 허물어지더라.",shape=box,color=blue];
		971 -> 975;
	959 [label="Update boolean EleanorIndifference",color=orange];
		959 -> 972;
	973 [label="무관심보다는 나아. 순순히 항복하는 것보다는 낫잖아.",shape=box,color=blue];
		973 -> 978;
	974 [label="지금 당장은 정말 할 수 있을 것만도 같거든.",shape=box,color=blue];
		974 -> 977;
	975 [label="그 밑에는 있던 건...",shape=box,color=blue];
		975 -> 976;
	972 [label="나는 내 생각으로 그것에 접촉했어. 루살카의 생각을 알아낼 줄 알았지만... 바깥쪽이 젖은 스펀지 같은 석고보드처럼 무너져 내리더니 그 안에 갇혀 버린 거야. 허우적거리며.",shape=box,color=blue];
		972 -> 976;
	978 [label="난 준비됐어.",shape=box,color=blue];
		978 -> 979;
	977 [label="아, 그래. 그렇지. 어둠 속을 비틀거리고 있어도, 적어도 우리에게는 서로의 동반자가 있으니까.",shape=box,color=blue];
		977 -> 980;
	976 [label="단어였어. ‘Calenture.’ 선원들에게 영향을 주곤 했던 일종의 광기인 셈이지. 그들은 주변의 푸른 바다가 물이 아니라 푸른 잔디라고 확신하게 되었을 거야.",shape=box,color=blue];
		976 -> 981;
	979 [label="Chat ends.",color=orange];
	980 [label="Chat ends.",color=orange];
	981 [label="그들은 배에서 아름다운 푸른 초원으로 뛰어내려 달려가야 했어. 다른 동료들이 그들을 말리면, 그들은 싸우려 들었지.",shape=box,color=blue];
		981 -> 982;
	982 [label="나도 푸른 잔디일 걸 기대하고, 뛰었지. 바로 그 순간 얼어붙은 어둠 속이란 걸 알아차렸어.",shape=box,color=blue];
		982 -> 983;
	983 [label="Update boolean EleanorIndifference2",color=orange];
		983 -> 984;
		983 -> 986;
	984 [label="난 네가 이렇게 얘기하는 건 안전하지 않은 거 같아.",shape=box,color=red];
		984 -> 985;
	986 [label="여기 있어. 얘기해.",shape=box,color=red];
		986 -> 987;
	985 [label="아, 젠장.",shape=box,color=blue];
		985 -> 988;
	987 [label="말로 표현할 수 없는 감정이 있어. 세상을 바라보면 건물, 자동차, 사람, 직장, 일상 등 모든 평범함은 바닥없는 공포 위에 얇은 지각일 뿐이고, 사람들이 그 사실을 깨닫게 된다면 비명을 지르고 멈추지 않겠지.",shape=box,color=blue];
		987 -> 989;
	988 [label="나는 간신히 이 지경까지 이르러 정신을 차렸는데, 이제 뭐, 어쩌라고? 악마가 소환될까 봐 악마에 대해 언급하지 말라는 건가?",shape=box,color=blue];
		988 -> 990;
	989 [label="난 지각을 뚫고 떨어졌어.",shape=box,color=blue];
		989 -> 992;
	990 [label="밤에 비명 소리가 들린다면, 그거 난 줄 알아.",shape=box,color=blue];
		990 -> 991;
	992 [label="공허함이 아니었어. 견딜 수 있었거든. 끝없이 계속되었지만, 그저 차가운 공간만 있었던 건 아냐. 그 안에 무언가와 함께 있었거든.",shape=box,color=blue];
		992 -> 993;
		992 -> 994;
		992 -> 995;
	991 [label="Chat ends.",color=orange];
	993 [label="눈?",shape=box,color=red];
		993 -> 997;
	994 [label="벽에 갇힌 남자?",shape=box,color=red];
		994 -> 997;
	995 [label="그게 뭐였어?",shape=box,color=red];
		995 -> 996;
	997 [label="모르겠어. 하지만 그건 내가 거기에 있다는 걸 알고 있었어. 나를 알고 있었다고. 마치 코끼리가 눈을 가로질러 기어가는 파리를 알고 있는 것처럼.",shape=box,color=blue];
		997 -> 998;
	996 [label="+5 Chemistry",color=orange];
		996 -> 997;
	998 [label="'그 커다란 무언가가 내 존재를 알아서는 안 돼'라고 생각했던 기억이 나.",shape=box,color=blue];
		998 -> 999;
	999 [label="나를 완전히 무시하는 듯한 태도를 보였고, 너무나 큰 무관심이라 그 자리에서 더 이상 존재하지 않고 싶게 느껴질 정도였어.",shape=box,color=blue];
		999 -> 1000;
		999 -> 1001;
	1000 [label="그게... 그렇더라.",shape=box,color=red];
		1000 -> 1002;
	1001 [label="넌 어떻게 했는데?",shape=box,color=red];
		1001 -> 1002;
	1002 [label="차라리 나를 싫어했다면 대처할 수 있었을 거 같아. 그러면 약간의 가치, 의미 같은 거라도 가졌을 테니까. 하지만 그것은 나를 무의미하게 여겼고, 나는 그것이 뭔지를 보았어. 나는 티끌이었어. 아무것도 아니었던 거라고.",shape=box,color=blue];
		1002 -> 1003;
	1003 [label="내가 지금까지 가졌던 모든 것, 모든 행복한 순간, 모든 웃음, 엘레노어 나이팅게일로서의 모든 조각들이 그 폭풍 속에서 날아가 버린 거야.",shape=box,color=blue];
		1003 -> 1004;
	1004 [label="빛이 사라지는 것 같았고, 맹세컨대, 만족감의 작은 떨림이 그것을 통해 전해졌어. 마치 나를 짓밟은 것이 재밌다는 듯이. 손톱 밑의 벼룩처럼.",shape=box,color=blue];
		1004 -> 1005;
	1005 [label="하지만 돌아왔잖아? 여전히 여기 있잖아. 넌 그것이 틀렸다는 걸 증명한 거야.",shape=box,color=red];
		1005 -> 1006;
	1006 [label="내가?",shape=box,color=blue];
		1006 -> 1007;
	1007 [label="그건 아직 저 밖에 존재하잖아, 안 그래?",shape=box,color=blue];
		1007 -> 1008;
		1007 -> 1009;
	1008 [label="어, 그렇지. 하지만 너도 여전히 여기 있는걸.",shape=box,color=red];
		1008 -> 1011;
	1009 [label="별이 아무리 우주가 크고, 춥고 어둡다 해서 타는 걸 멈추진 않는 법이거든.",shape=box,color=red];
		1009 -> 1010;
	1011 [label="친구야, 결국은 무심이 이길 거야. 우리가 아무리 많은 진부한 말을 심연에 던진다 해도.",shape=box,color=blue];
		1011 -> 1012;
	1010 [label="하지만 별들도 언젠가는 타는 것을 멈출 거잖아. 언젠가는. 우주가 다 타서 죽어버리면.",shape=box,color=blue];
		1010 -> 1011;
	1012 [label="화를 내지 않는 것이 문제야. 너는 생각을 명확하게 하는 걸로 저주를 받는 거야.",shape=box,color=blue];
		1012 -> 1013;
	1013 [label="내가 무슨 말 하는지 알겠지. 너는 참새 알처럼 깨지거나 약물로 뇌를 태워 더 이상 아무것도 느끼지 못할 때까지 버틸 수도 있었을 거야. 그리고 이걸... 아는 것보다 덜 아팠을 테지.",shape=box,color=blue];
		1013 -> 1014;
	1014 [label="너 왜 아직도 이런 대화에서 꺼지지 않았는지 이해가 안 가네.",shape=box,color=blue];
		1014 -> 1015;
		1014 -> 1016;
	1015 [label="엔트로피에 대해선 알아. 어쩌면 거대한 무심도 같은 것일 수 있지. 어쩌면 끝의 끝에 가선 그게 이길지도 모르고. 모르겠다. 다만 내가 확실히 아는 건, 지금 당장 그게 이기게 놔 둘 생각은 없다는 거야.",shape=box,color=red];
		1015 -> 1017;
	1016 [label="난 네가 슬슬 그놈의 마음 좀 제발 정했으면 좋겠는데. 쉬운 길을 선택해 미쳐버리고 싶어? 아니면 그 소파에서 그놈의 엉덩이 좀 떼고 일어나 싸울 거야?",shape=box,color=red];
		1016 -> 1018;
	1017 [label="만약 이 모든 것에서 살아남을 가능성이 있다면, 우리 모두가 살아남는 거야.",shape=box,color=red];
		1017 -> 1020;
	1018 [label="싸우자고 어떻게",shape=box,color=blue];
		1018 -> 1019;
	1020 [label="그래서 너는 전투 전략으로 실존적 절망에 대한 나의 통곡을 참으라는 건가? 그건 너무 아서 같잖아.",shape=box,color=blue];
		1020 -> 1021;
	1019 [label="너랑 아서는 대체 아는 게 그게 다야? 싸우는 거?",shape=box,color=blue];
		1019 -> 1022;
	1021 [label="사실, 믿을지 안 믿을지 모르겠지만, 나는 너를 많이 아껴.",shape=box,color=red];
		1021 -> 1027;
	1022 [label="존재의 근본적인 무의미함에 대한 너의 답은 '방법이 나올 때까지 때려라' 이건가?",shape=box,color=blue];
		1022 -> 1023;
	1027 [label="나도 널 아껴, 친구야. 우리는 팀메이트잖아. 함께 많은 일을 겪었다고.",shape=box,color=blue];
		1027 -> 1028;
	1023 [label="우리에게 공통점이 하나라도 있다고 생각했던 게 믿을 수가 없네.",shape=box,color=blue];
		1023 -> 1024;
	1028 [label="나는 그저 좋은 배인 엘레노어가 피투성이가 된 바다나 어두운 늪으로 가라앉을 수도 있다는 사실을 알려주는 거야. 그리고 그녀가 가라앉을 때 네가 거기에 있지 않았으면 하는 거고.",shape=box,color=blue];
		1028 -> 1030;
	1024 [label="날 더 속여보시지.",shape=box,color=blue];
		1024 -> 1025;
	1030 [label="+20 Chemistry",color=orange];
		1030 -> 1029;
	1025 [label="Update boolean EleanorNoDate",color=orange];
		1025 -> 1026;
	1029 [label="고마워. 이제 가봐. 난 괜찮을 거야, 정말로.",shape=box,color=blue];
		1029 -> 1031;
	1026 [label="Chat ends.",color=orange];
	1031 [label="Chat ends.",color=orange];
}