digraph {
	1621 [label="EleanorRank4Convo3 begins.",color=orange];
		1621 -> 1622;
	1622 [label="나 해냈나 봐. 뚫은 거 같아. 접촉이 됐다고.",shape=box,color=blue];
		1622 -> 1623;
	1623 [label="거기 있니? 제발 거기 있어줘.",shape=box,color=blue];
		1623 -> 1624;
	1624 [label="이걸 텔레파시로 해야 하는 건가? 오 제발. 지금은 아니야.",shape=box,color=blue];
		1624 -> 1625;
		1624 -> 1626;
	1625 [label="엘레노어, 침착해. 무슨 일이야?",shape=box,color=red];
		1625 -> 1628;
	1626 [label="[무시한다.]",shape=box,color=red];
		1626 -> 1627;
	1628 [label="Check boolean EleanorSister",color=orange];
		1628 -> 1640 [label=true,color=green];
		1628 -> 1629 [label=false,color=brown];
	1627 [label="Chat ends.",color=orange];
	1640 [label="다른 나. 수녀가 된 그녀. 그녀에게 연락하려고 노력했어.",shape=box,color=blue];
		1640 -> 1641;
	1629 [label="네가 나타난 이후로, 한 가지 질문이 계속 나를 괴롭혔어. 내가 방금 대답했을지도 모르는 질문이야. 그리고 솔 맙소사, 내가 무슨 짓을 한 건지 모르겠네.",shape=box,color=blue];
		1629 -> 1630;
	1641 [label="방금 했어.",shape=box,color=blue];
		1641 -> 1642;
	1630 [label="처음부터 시작해. 무슨 말인지 모르겠어. 무슨 질문?",shape=box,color=red];
		1630 -> 1631;
	1642 [label="물론 내가 이 세상에 머물러 있는 한 결코 성공할 수 없었을 거야. 나는 이미 이 세상의 '나'인 거야. 나는 울부짖는 순결을 통과해야만 했어. 블랙스타 푸그. 거골 만. 그게 네가 반대편으로 갈 수 있는 방법이야. 어쩌면 과 될 수 있었을 것들.",shape=box,color=blue];
		1642 -> 1643;
	1631 [label="너! 피비린내 나는 너에 대한 질문. 너는 한 번이 아니라 두 번 존재하고 있잖아.",shape=box,color=blue];
		1631 -> 1632;
	1643 [label="보이드! 난 보이드를 봤어!",shape=box,color=blue];
		1643 -> 1644;
		1643 -> 1645;
	1632 [label="그리고 만약 다른 세상에, 또 다른 버전의 네가 있다면, 왜 나는 그럴 수 없는 거지?",shape=box,color=blue];
		1632 -> 1633;
	1644 [label="너... 정말 레티의 특별한 물건을 얻지 못한 게 확실해?",shape=box,color=red];
		1644 -> 1646;
	1645 [label="그럴 리가 없어, 엘레노어. 알브레히트 엔트라티가 들어가기 전까지는 아무도 보이드에 들어가지 않아. 지금 우리가 있는 곳에서는 미래로 가는 길이 너무 멀어.",shape=box,color=red];
		1645 -> 1647;
	1633 [label="지금은 확실히 존재하는 것으로 확인된 방대한 저 우주 어딘가에는 내가 항상 되고 싶어 했던 그런 버전의 내가 있었어.",shape=box,color=blue];
		1633 -> 1634;
	1646 [label="드리프터야, 네가 유머를 대응 기제로 사용하는 능력은 인정하지만, 나 지금 아주 진지해.",shape=box,color=blue];
		1646 -> 1648;
	1647 [label="나는 몸이 아니라 생각으로 들어간 거야. 그게 다른 거지.",shape=box,color=blue];
		1647 -> 1650;
	1634 [label="수녀가 되기 위해 세상을 떠난 사람.",shape=box,color=blue];
		1634 -> 1635;
	1648 [label="나는 내가 하기로 마음먹은 걸 실행했어.",shape=box,color=blue];
		1648 -> 1649;
	1650 [label="아야 머리가 아파 아야 아야 아야",shape=box,color=blue];
		1650 -> 1651;
	1635 [label="루아의 사도 중 한 명이 산꼭대기 어딘가에 앉아 있었고, 그녀의 주변에는 향 구름이 피어 있었어.",shape=box,color=blue];
		1635 -> 1636;
	1649 [label="나는 보이드를 봤을 뿐 아니라, 그 안으로 들어갔어.",shape=box,color=blue];
		1649 -> 1650;
	1651 [label="Check boolean EleanorIndifference2",color=orange];
		1651 -> 1652 [label=true,color=green];
		1651 -> 1654 [label=true,color=green];
		1651 -> 1653 [label=false,color=brown];
		1651 -> 1654 [label=false,color=brown];
	1636 [label="나는 줄곧 그녀에게 연락하려고 노력해 왔어. 그녀를 찾기 위해 보이드를 통하려고 노력했지.",shape=box,color=blue];
		1636 -> 1637;
	1652 [label="만약 네가 정말로 보이드로 들어간 거라면, 네가 얼마나 큰 위험에 처한 건지 알 수 없어. 밖에 뭐가 있는지 알면서도, 그냥 뛰어 들은 거야?",shape=box,color=red];
		1652 -> 1655;
	1654 [label="너 미쳤어?!",shape=box,color=red];
		1654 -> 1657;
	1653 [label="무엇을 봤어? 무슨 일이 있던 거야?",shape=box,color=red];
		1653 -> 1656;
	1637 [label="Update boolean EleanorSister",color=orange];
		1637 -> 1638;
		1637 -> 1639;
	1655 [label="처음에 그렇게 해서 보이드로 들어갔어. 그 기억을 통해서. 공포감은 그저 연기였고 연기 사이에는 문이 있었어. 내가 그렇게 두려워하지 않았다면 처음에 그것을 분명하게 봤을 거야.",shape=box,color=blue];
		1655 -> 1662;
	1657 [label="아니 전혀.",shape=box,color=blue];
		1657 -> 1659;
	1656 [label="말로 표현할 수 없는 감정이 있어. 세상을 바라보면 건물, 자동차, 사람, 직장, 일상 등 모든 평범함은 바닥없는 공포 위에 얇은 지각일 뿐이고, 사람들이 그 사실을 깨닫게 된다면 비명을 지르고 멈추지 않겠지.",shape=box,color=blue];
		1656 -> 1658;
	1638 [label="오, 이런.",shape=box,color=red];
		1638 -> 1641;
	1639 [label="그리고...?",shape=box,color=red];
		1639 -> 1641;
	1662 [label="이건 실수였어. 그게 루살카를 데려갔거든. 알브레히트도 거의 데려갈 뻔했지. 너도 쉽게 데려갈 수 있을 거야.",shape=box,color=red];
		1662 -> 1663;
	1659 [label="잘 들어. 제발. 그리고 이해하려고 노력해 봐.",shape=box,color=blue];
		1659 -> 1664;
		1659 -> 1665;
	1658 [label="난 지각을 뚫고 떨어졌어.",shape=box,color=blue];
		1658 -> 1660;
	1663 [label="그것이 시도했어. 난 느껴졌어. 나는 그것이 호기심이 많고 나에게 다가오고 있다는 것을 알고 있었어.",shape=box,color=blue];
		1663 -> 1664;
		1663 -> 1665;
	1664 [label="그러니까 무한히 가능한 세계 중에서, 우연히 올바른 세계를 찾게 된 거로군?",shape=box,color=red];
		1664 -> 1666;
	1665 [label="엘레노어, 무심은 원하는 대로 보일 수 있어. 알브레히트가 그걸 처음 마주쳤을 때처럼 말이야.",shape=box,color=red];
		1665 -> 1667;
	1660 [label="공허함이 아니었어. 견딜 수 있었거든. 끝없이 계속되었지만, 그저 차가운 공간만 있었던 건 아냐. 그 안에 무언가와 함께 있었거든.",shape=box,color=blue];
		1660 -> 1661;
	1666 [label="확신하지 못해도 괜찮아. 미친 소리처럼 들리겠지만, 그냥 내 말을 들어봐, 알겠지?",shape=box,color=blue];
		1666 -> 1668;
	1667 [label="아마도 네가 원하는 것이 무엇인지 감지하고 네가 보고 싶어 하는 형태를 취했을 수도 있어.",shape=box,color=red];
		1667 -> 1668;
	1661 [label="Update boolean EleanorIndifference2",color=orange];
		1661 -> 1662;
	1668 [label="너랑 거래를 해야겠어.",shape=box,color=blue];
		1668 -> 1669;
	1669 [label="먼저 내가 무슨 일이 있었는지 다 말해줄게.",shape=box,color=blue];
		1669 -> 1670;
	1670 [label="내 얘기가 끝나면, 나를 엉망진창으로 만든 게 무심인지 아닌지 네가 결정할 수 있어. 진지하게 받아들일 거라고 약속할게.",shape=box,color=blue];
		1670 -> 1671;
	1671 [label="어때?",shape=box,color=blue];
		1671 -> 1672;
		1671 -> 1673;
	1672 [label="좋아.",shape=box,color=red];
		1672 -> 1682;
	1673 [label="네가 이런 짓을 했다는 게 믿기지가 않네. 다시는 그러지 마, 엘레노어! 널 그것에게 빼앗길 순 없다고!",shape=box,color=red];
		1673 -> 1674;
	1682 [label="그래서 내가 말했듯이. 난 그녀를 찾았어.",shape=box,color=blue];
		1682 -> 1683;
	1674 [label="뭐라고?",shape=box,color=blue];
		1674 -> 1675;
	1683 [label="나는 무심이 지켜보고 있다는 것을 느낄 수 있었어. 그것이 나에게 다가오는데 마른 사막의 미라와 같은 표정을 짓는 걸 느낄 수 있었지. 나는 그녀에게 다가갔고, 그녀는 나를 잡아당겼어.",shape=box,color=blue];
		1683 -> 1684;
	1675 [label="무슨 말을 해야 할지 모르겠네. 네가 너무 화가 나서 조금 걱정되긴 한데, 네가 그렇게 신경을 쓰고 있는지 몰랐어.",shape=box,color=blue];
		1675 -> 1676;
	1684 [label="그녀는 불씨가 가득한 구덩이 옆의 야외 신사 같은 곳에서 로터스 자세로 앉아 있었어. 밤이었는데, 달은 구름 사이로 희미하게 비치고 있었어.",shape=box,color=blue];
		1684 -> 1685;
	1676 [label="난 괜찮아. 그러니 내 걱정은 안 해도 돼.",shape=box,color=blue];
		1676 -> 1678;
	1685 [label="그녀가 입술에 손가락을 가져다 댔어.",shape=box,color=blue];
		1685 -> 1686;
	1678 [label="+5 Chemistry",color=orange];
		1678 -> 1677;
	1686 [label="잠시 동안 난 그 거대한 손이 여전히 나를 더듬고 있다는 것을 느낄 수 있었지. 그리고 그것은 마치 손가락에 단두대가 내려온 것처럼 주춤했어.",shape=box,color=blue];
		1686 -> 1687;
	1677 [label="아무것도 약속할 수는 없지만, 다시는 놀라게 하지 않을게.",shape=box,color=blue];
		1677 -> 1679;
		1677 -> 1680;
	1687 [label="풀이 속삭였어. 귀뚜라미는 노래를 했고. 우리뿐이었지.",shape=box,color=blue];
		1687 -> 1689;
	1679 [label="좋아... 그냥... 무슨 일이 있었는지 말해줘.",shape=box,color=red];
		1679 -> 1682;
	1680 [label="나는 여기에 가담할 수 없어. [종료.]",shape=box,color=red];
		1680 -> 1681;
	1689 [label="이 모든 게 끔찍하게도 익숙하게 들리네. 그러고 나서는?",shape=box,color=red];
		1689 -> 1688;
	1681 [label="Chat ends.",color=orange];
	1688 [label="우리는 불구덩이를 사이에 두고 앉아 있었어. 그녀는 말은 하지 않았지만, 부드럽고 자매처럼 느껴지는 그녀의 마음을 들여다보게 해주었지.",shape=box,color=blue];
		1688 -> 1690;
	1690 [label="그녀는 너무 행복했고, 완벽하게 만족해했어. 그녀 자신에게 딱 맞는 장소에. 굳은 발, 맑은 눈. 불을 들이마시고 달을 들이키고 있는.",shape=box,color=blue];
		1690 -> 1691;
		1690 -> 1692;
	1691 [label="그래서 넌 그게 너에게 맞는 선택이었다고 느껴졌니?",shape=box,color=red];
		1691 -> 1693;
	1692 [label="머물고 싶은 유혹이 들었어?",shape=box,color=red];
		1692 -> 1693;
	1693 [label="아니! 그 반대였어!",shape=box,color=blue];
		1693 -> 1694;
	1694 [label="나는 그 길을 갈 필요가 없어, 왜냐하면 그녀가 이미 간 길이잖아. 모르겠어? 나는 이제 자유야. '만약'에 대해서 궁금해할 필요가 없어진 거야. 엘레노어 자매가 이미 거기에 있으니까. 그녀가 내 편이라고. 이해가 돼?",shape=box,color=blue];
		1694 -> 1695;
	1695 [label="조금은? 내가 알고 싶은 건, 그게 도움이 되긴 했냐는 거야?",shape=box,color=red];
		1695 -> 1696;
	1696 [label="어 그럼. 이제 다음에 무엇을 해야 할지 더 확신할 수 있게 되었어.",shape=box,color=blue];
		1696 -> 1698;
	1698 [label="+15 Chemistry",color=orange];
		1698 -> 1697;
	1697 [label="나는 이제 그녀가 자유롭게 해준 삶을 온전히 살아갈 거야.",shape=box,color=blue];
		1697 -> 1699;
	1699 [label="Chat ends.",color=orange];
}