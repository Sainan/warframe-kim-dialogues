digraph {
	460 [label="EleanorRank2Convo3 begins.",color=orange];
		460 -> 461;
	461 [label="좋아, 우리는 안지도 좀 됐고, 넌 미래에서 왔잖아. 그래서 네가 이 문제에 대해 솔직하게 말해줄 수 있을 거라고 생각하니까, 가장 중요한 질문을 해야겠어.",shape=box,color=blue];
		461 -> 462;
	462 [label="우리뿐인가? 아니면 마침내 다른 누군가가 접촉한 걸까?",shape=box,color=blue];
		462 -> 463;
		462 -> 464;
		462 -> 465;
	463 [label="외계 생명체를 말하려는 거야? 아직은 아닌 거 같네, 언젠가는 그럴 수도 있겠지.",shape=box,color=red];
		463 -> 466;
	464 [label="안타깝게도, 우리에게 가장 가까이 온 건 무심 같은데.",shape=box,color=red];
		464 -> 467;
	465 [label="어, 우리뿐이야. 인간과 인간이 만든 것 말고는 아무것도 없어.",shape=box,color=red];
		465 -> 468;
	466 [label="아, 이런.",shape=box,color=blue];
		466 -> 469;
	467 [label="'무심'이 뭐야? 네 생각속에서 살짝 엿본 적은 있지만, 이해가 되지 않아. 그 뭔가는 내가 아주 두꺼운 벽이 있는 먼 곳으로 달려가서 몸을 웅크리고 싶게 만들었거든.",shape=box,color=blue];
		467 -> 470;
		467 -> 471;
	468 [label="아주 삭막한 대답이군.",shape=box,color=blue];
		468 -> 472;
	469 [label="우리가 이야기할 수 있는 무언가가 저 어딘가에 있으면 했는데. 우리 종족에 대해 진지하게 외부적 관점을 지닌 누군가.",shape=box,color=blue];
		469 -> 473;
	470 [label="우리도 아직 그것이 무엇인지 모르겠어. 또는 무엇을 원하는지도. 레드 베일이 생각하는 것처럼 고대의 존재인 건지, 아니면 알브레히트가 그걸 어떡하다 만든 건지조차도.",shape=box,color=red];
		470 -> 474;
	471 [label="루살카 소령을 잡아간 게 바로 그거야.",shape=box,color=red];
		471 -> 475;
	472 [label="왜인지는 모르겠군. 결국 지능은 지능인 거야. 우리가 그것을 발견하든 창조하든 중요하지 않아야 해.",shape=box,color=blue];
		472 -> 540;
	473 [label="물론, 대화도 하고... 다른 것도.",shape=box,color=blue];
		473 -> 477;
		473 -> 476;
	474 [label="그게 루살카 소령에게 빙의했던 거라고 말하면, 도움이 되려나?",shape=box,color=red];
		474 -> 475;
	475 [label="오.",shape=box,color=blue];
		475 -> 543;
	540 [label="난 우주가 모든 알들을 한 바구니에 넣지 않았다는 확신을 원했던 거 같아. 만약 인간이 이 세상의 전부였다면, 꽤나 엉망진창이었을 거 같거든.",shape=box,color=blue];
		540 -> 541;
	477 [label="친구가 될만한 촉수 괴물이라도 찾고 있는 건가?",shape=box,color=red];
		477 -> 494;
	476 [label="잠깐. 어떤 종류의 교감을 말하는 건데?",shape=box,color=red];
		476 -> 479;
	543 [label="오, 이런.",shape=box,color=blue];
		543 -> 544;
	541 [label="아, 그렇군.",shape=box,color=blue];
		541 -> 542;
	494 [label="+5 Chemistry",color=orange];
		494 -> 478;
	479 [label="어떤 종류의 교감이라, 그럴 수도 있겠네. 꼭 육체적인 것이어야 하는 건 아니니까. 난 꼭 인간이거나 지구상의 것이어야만 하는 게 아니라 단지 무언가로 마음을 감동시키고 싶을 뿐이야.",shape=box,color=blue];
		479 -> 481;
	544 [label="오 젠장.",shape=box,color=blue];
		544 -> 545;
	542 [label="Chat ends.",color=orange];
	478 [label="저기요. 난 '촉수 괴물'이 아니거든요. 난 우연히 촉수를 가지게 된 것뿐이라고. 그것도 하나. 지금까지는.",shape=box,color=blue];
		478 -> 480;
	481 [label="난 레티의 쥐 중 한 마리의 생각을 움직여 무슨 일이 일어나는지 보고 싶었을 뿐이야.",shape=box,color=blue];
		481 -> 483;
		481 -> 484;
	545 [label="그거? 그게 너의 '무심'이랑 같은 거였어?",shape=box,color=blue];
		545 -> 546;
	480 [label="내가 하고 싶은 게 촉수로 대화하는 것뿐이었다면, 프린세스 루시나 동물원에 가서 문어랑 친구를 먹었겠지.",shape=box,color=blue];
		480 -> 482;
	483 [label="그 가엽은 걸 다치게 하진 않았지?",shape=box,color=red];
		483 -> 485;
	484 [label="그래, 어떻게 됐는지 말해봐.",shape=box,color=red];
		484 -> 485;
	546 [label="나 그것을 만져 봤다고. 내 생각의 저 끝까지 그것을 만지고 그 기억을 잠가 버렸어.",shape=box,color=blue];
		546 -> 547;
	482 [label="... 그리고 지금은 차라리 그랬으면 좋았겠다 싶네. 문어는 매우 지능적이거든. 아마 지금쯤 함께 시를 쓰고 있었을지도 몰라. 그 문어 지금 어디 있으려나?",shape=box,color=blue];
		482 -> 486;
	485 [label="그에게는 끔찍한 3초였을 거야.",shape=box,color=blue];
		485 -> 491;
	547 [label="언제 그런 일이 있었는지 기억조차 나지 않아. 그녀가 탄노이에서 연설을 하고 있었는데, '저 여자의 머리를 찔러본 적이 없네. 안에 뭐가 있는지 궁금하군. 아마 가죽과 바늘로 가득 차 있을거야'라는 생각이 들었고 그래서 만져봤...",shape=box,color=blue];
		547 -> 548;
	486 [label="누군가 먹었을 거야. 격리된 도시의 동물에서 공급이 부족해지면 흔히 일어나는 일이지.",shape=box,color=blue];
		486 -> 487;
	491 [label="불쌍한 것. 보다시피, 난 내 생각을 들여다보는 것이 그에게 어떤 것인지 알려주는 데 실패했어. 커다란 백화점에서 길을 잃은 아이가 엄마를 찾으며 계속 울부짖는 모습을 상상해 봐. 모든 것이 거대하고 혼란스럽고 냄새 대신 소리와 모양뿐인 거지.",shape=box,color=blue];
		491 -> 492;
	548 [label="이런 빌어먹을.",shape=box,color=blue];
		548 -> 549;
	487 [label="그리고 먹히지 않은 애들은 지금쯤 테크병에 걸렸을 거야.",shape=box,color=blue];
		487 -> 488;
	492 [label="난 가능한 한 빨리 연결을 끊어버렸어. 한 시간 정도 어지러웠겠지만, 괜찮았을 거야. 무슨 일이 있었는지 기억하지 못할 거야.",shape=box,color=blue];
		492 -> 497;
		492 -> 496;
	549 [label="미안, 아직은 말할 수 없겠어.",shape=box,color=blue];
		549 -> 550;
	488 [label="... '꿈'에서는 이런 식이었어, 그렇지? 하지만 전혀 꿈이 아니었어. 일어난 일이었다고. 아니라면 일어날 거야. 그 버전의 뭔가가. 그 동물원에서 무슨 일이 일어나고 있어.",shape=box,color=blue];
		488 -> 489;
	497 [label="그래서 넌 어땠는데? 쥐가 되어 본 기분이 어땠어?",shape=box,color=red];
		497 -> 500;
	496 [label="괜찮아, 그냥 쥐일 뿐이잖아.",shape=box,color=red];
		496 -> 498;
	550 [label="+20 Chemistry",color=orange];
		550 -> 551;
	489 [label="최대한 많이 기억해 봐야겠어.",shape=box,color=blue];
		489 -> 490;
	500 [label="네가 아무것도 하지 않고 침대에 누워 숨만 쉬고 싶은 그런 종류의 슬럼프를 겪어본 적이 있는지 모르겠지만, 그거랑 아주 비슷했어.",shape=box,color=blue];
		500 -> 501;
	498 [label="레티가 방금 네가 한 말을 듣지 못하게 하는 게 좋겠어. 네 장기를 그대로 보존하고 싶다면 말이야.",shape=box,color=blue];
		498 -> 499;
	551 [label="Update boolean EleanorIndifference",color=orange];
		551 -> 552;
	490 [label="말리지 말아 봐.",shape=box,color=blue];
		490 -> 493;
	501 [label="아주 기본적인. 간단한 걸로 간단한 게 충족되는.",shape=box,color=blue];
		501 -> 502;
	499 [label="Chat ends.",color=orange];
	552 [label="Chat ends.",color=orange];
	493 [label="Update boolean EleanorRemembers",color=orange];
		493 -> 495;
	502 [label="어린 시절의 순수함은 쥐의 자아와는 다르니까.",shape=box,color=blue];
		502 -> 503;
		502 -> 504;
	495 [label="Chat ends.",color=orange];
	503 [label="왠지 즐거웠다는 소리로 들린다.",shape=box,color=red];
		503 -> 505;
	504 [label="지금 쥐를 부러워하는 거야?",shape=box,color=red];
		504 -> 506;
	505 [label="어, 즐거웠어. 당연히 쥐가 되면 나쁜 점이 있겠지. 포식자들이 그를 찾아내지 못하도록 죽은 형제를 먹어야 하는 것처럼 말이야. 하지만 그 잠깐 동안의 단순함은 종교적 돌파구와 같았다고나 할까.",shape=box,color=blue];
		505 -> 507;
	506 [label="그럴 수도.",shape=box,color=blue];
		506 -> 509;
	507 [label="쥐가 된다는 건 수도사가 되는 것과 비슷한 거 같아. 남은 것을 먹고, 세상에서 겸손해야 하고, 절대 차나 집을 소유하지 않고.",shape=box,color=blue];
		507 -> 508;
	509 [label="작고 단순해서 필요한 것이 별로 없으니 대담한 뭔가가 있다고 생각해.",shape=box,color=blue];
		509 -> 510;
	508 [label="종교적 돌파구?",shape=box,color=red];
		508 -> 509;
	510 [label="믿을지 모르겠지만, 난 오랫동안 수녀가 될까 생각했었거든.",shape=box,color=blue];
		510 -> 511;
	511 [label="Update boolean EleanorNun1",color=orange];
		511 -> 512;
		511 -> 513;
	512 [label="수녀라는 게 뭔지 나에게 알려줘야 해, 엘레노어.",shape=box,color=red];
		512 -> 514;
	513 [label="수녀?",shape=box,color=red];
		513 -> 515;
	514 [label="아, 맞다. 네가 온 곳에는 그런 게 없지.",shape=box,color=blue];
		514 -> 516;
	515 [label="맞다. 네가 온 곳에는 그런 게 없지.",shape=box,color=blue];
		515 -> 516;
	516 [label="루아의 추종자처럼. 빡빡 머리에, 흰색 또는 검은색 옷을 입고, 매우 엄격한 삶을 살지. 다른 모든 것을 배제하고 신성한 것들에만 집중하는 거지. 매일 기도와 명상을 하고 아주 단출한 식사를 하고.",shape=box,color=blue];
		516 -> 517;
		516 -> 518;
		516 -> 519;
		516 -> 520;
	517 [label="끔찍하군.",shape=box,color=red];
		517 -> 521;
	518 [label="멋지다.",shape=box,color=red];
		518 -> 522;
	519 [label="어려운 일이겠네.",shape=box,color=red];
		519 -> 523;
	520 [label="그거... 나한테는 안 맞겠다.",shape=box,color=red];
		520 -> 526;
	521 [label="그렇게 보이지. 그런데 수도원 생활과 감옥 생활의 유일한 차이점은 본인이 원해서 한다는 거지.",shape=box,color=blue];
		521 -> 527;
	522 [label="대부분의 젊은 초보자들도 수도원 생활을 직접 겪어보기 전까지는 멋지다고 생각하지. 아마 때려치우는 비율이 80% 정도 된다나 봐.",shape=box,color=blue];
		522 -> 527;
	523 [label="오, 아니지. 내 말은, 처음에는, 맞아. 사회가 너에게 필요하다고 가르쳐 준 모든 것에서 벗어나야 하거든. 아마 그 단계가 가장 어려울 거야.",shape=box,color=blue];
		523 -> 528;
	526 [label="+10 Chemistry",color=orange];
		526 -> 524;
	527 [label="그래서 결국 나에게는 맞지 않더라고. 난 이 세상을 즐기면서 사는 게 좋아.",shape=box,color=blue];
		527 -> 525;
	528 [label="하지만 일단 자리가 잡히면, 뭐가 힘드려나? 유혹? 넌 아마 아무것도 보지 못할 거야. 신성한 것으로부터 방해가 될 수 있는 모든 것을 나 자신에게서 잘라내야 하는 거거든.",shape=box,color=blue];
		528 -> 527;
	524 [label="나한테도 맞지 않아. 난 이 세상을 즐기면서 사는 게 좋더라고.",shape=box,color=blue];
		524 -> 525;
	525 [label="그런데 솔... 마치 나의 다른 버전이 어딘가 산꼭대기에 앉아 나를 내려다보고 있을 거 같아. 주변에는 향이 피어나고, 제트기와 달석 구슬이 손가락 사이로 날아다니고, 비참한 연민의 눈을 한 그녀가 말이야.",shape=box,color=blue];
		525 -> 529;
	529 [label="이게 그저 환상이라는 걸 알아. 갑옷을 입은 아서의 기사들만큼이나 허튼소리라는 거.",shape=box,color=blue];
		529 -> 530;
		529 -> 531;
	530 [label="우리 모두는 언젠가 함께 잘 되는 꿈을 꾸지.",shape=box,color=red];
		530 -> 532;
	531 [label="나는 항상 다른 버전의 나와 이야기를 해. 함께 식사를 하고. 네가 생각하는 것만큼 미친 짓은 아니야.",shape=box,color=red];
		531 -> 533;
	532 [label="고맙네. 어떤 이유에서인지 그 말이 위안이 되네.",shape=box,color=blue];
		532 -> 534;
	533 [label="그래. 네가 겪은 일은 정상적인 기준으로 봤을 때 단순히 피비린내 나는 광기에 불과하다는 사실을 계속 잊고 있었네.",shape=box,color=blue];
		533 -> 534;
	534 [label="그게... 전에 한 번도 해본 적은 없지만, 혹시 그녀가 존재한다면 연락을 시도해 볼까. 그래. '자매 엘레노어'에게 텔레파시로 연락이 닿을 수 있을지도 모르잖아.",shape=box,color=blue];
		534 -> 535;
	535 [label="가장 최악의 상황이 뭘까?",shape=box,color=blue];
		535 -> 538;
	538 [label="+10 Chemistry",color=orange];
		538 -> 536;
	536 [label="내 다른 나로부터 경험을 얻을 수도 있잖아. 상상해 보라고. 오 루아, 나 지금 너무 흥분돼.",shape=box,color=blue];
		536 -> 537;
	537 [label="Update boolean EleanorSister",color=orange];
		537 -> 539;
	539 [label="Chat ends.",color=orange];
}