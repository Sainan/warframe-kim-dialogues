digraph {
	2968 [label="EleanorRank6Convo4 begins.",color=orange];
		2968 -> 2969;
	2969 [label="그런 적 있지 않니? 샤워를 하고 있는데, 이상한 목소리가 조그맣게 들려오더니 예전엔 한 번도 생각해본 적 없는 질문을 물어 오는 느낌이 드는 거.",shape=box,color=blue];
		2969 -> 2970;
		2969 -> 2971;
		2969 -> 2972;
	2970 [label="아니 별로, 그런 적 없어. [종료.]",shape=box,color=red];
		2970 -> 2973;
	2971 [label="그러니까, '루아가 갑자기 하늘에 다시 나타났을 때 지구에 있던 사람들은 뭔 생각을 했을까?' 같은?",shape=box,color=red];
		2971 -> 2974;
	2972 [label="그러니까, '오퍼레이터! 데리고 계신 쿠브로 박제해 보실 생각 혹시 없으신가요?' 같은 소리?",shape=box,color=red];
		2972 -> 2975;
	2973 [label="Chat ends.",color=orange];
	2974 [label="맞아, 바로 그거.",shape=box,color=blue];
		2974 -> 2976;
	2975 [label="그건 그냥 오디스 소리고. 보통 그러거든.",shape=box,color=red];
		2975 -> 2977;
	2976 [label="잠깐",shape=box,color=blue];
		2976 -> 2978;
	2977 [label="착하기도 하지. 아니, 내 말은, 내면의 소리 말하는 거야.",shape=box,color=blue];
		2977 -> 2979;
	2978 [label="루아가 사라졌었어?",shape=box,color=blue];
		2978 -> 2980;
	2979 [label="내가 개인 위생이라는 중요한 일에 신경 쓰고 있을 때, 뇌의 한 구석도 스스로 바쁘게 움직이느라 나오는 그것.",shape=box,color=blue];
		2979 -> 2981;
	2980 [label="얼마나 오래? 어디로 사라졌었는데? 그럼 조류나 파도는 어떻게 된 거야?",shape=box,color=blue];
		2980 -> 2982;
		2980 -> 2983;
	2981 [label="난 항상 그런 목소릴 듣거든. 이상할 정도로 규칙이란 게 없고. 특히 요즘들어선 더 심해서 이게 정말 내 머리에서 나오는 게 맞긴 한가 싶어질 정도야. ",shape=box,color=blue];
		2981 -> 2984;
	2982 [label="순서대로 답해주자면: 몰라. 보이드로. 몰라.",shape=box,color=red];
		2982 -> 2985;
	2983 [label="옛 전쟁이 끝나려고 할 즈음 로터스가 루아를 보이드로 보내버렸어. 그리고 꽤 최근 들어서 우리 꼬맹이가 다시 꺼내 왔고.",shape=box,color=red];
		2983 -> 2986;
	2984 [label="그 중 일부는 그림으로도 표현해 봤지.",shape=box,color=blue];
		2984 -> 2985;
	2985 [label="아니다, 이 얘긴 나중으로 하자.",shape=box,color=blue];
		2985 -> 2987;
	2986 [label="조류나 파도는 어떻게 됐는지 모르겠네.",shape=box,color=red];
		2986 -> 2988;
	2987 [label="그래서, 샤워 중 갑자기 떠오르는 생각들 말인데. 오늘 아침에 떠올린 게 아주 기가 막혔거든.",shape=box,color=blue];
		2987 -> 2989;
	2988 [label="로터스는 어떻게 그렇게 달을 통째로 옮겨버릴 수 있는 거야???",shape=box,color=blue];
		2988 -> 2985;
	2989 [label="이런 물음이었어. '신들이 진짜로 있다면 어떻게 될까?'",shape=box,color=blue];
		2989 -> 2990;
	2990 [label="잠깐이지만 좀 많이 흔들렸고, 생각을 멈추려고 얼굴에 찬물도 좀 끼얹어야 했지.",shape=box,color=blue];
		2990 -> 2991;
		2990 -> 2992;
		2990 -> 2993;
	2991 [label="그게 뭐가 그렇게 이상해? 나한텐 꽤 기본적인 의문으로 들리는데.",shape=box,color=red];
		2991 -> 2994;
	2992 [label="... 보통 다들 신들이 진짜 있다고 생각 안 해? 분명 레티는 그랬던 것 같은데.",shape=box,color=red];
		2992 -> 2995;
	2993 [label="그래, 참 끔찍한 생각이네.",shape=box,color=red];
		2993 -> 2996;
	2994 [label="아, 이래서 내가 너한테 이런 얘기 하는 걸 좋아한다니까.",shape=box,color=blue];
		2994 -> 2997;
	2995 [label="오, 이것 보셔. 신들이 정말 존재한다고 믿는 사람은 아무도 없어. 적어도 그 뭐랄지, 탁자와 의자가 실재한다고 믿는 정도로는.",shape=box,color=blue];
		2995 -> 2998;
	2996 [label="그렇지? 온 우주가 내게 전언을 보내고 있다고 느꼈던 그 모든 순간, 그게 정말 사실이었다면?",shape=box,color=blue];
		2996 -> 2999;
	2997 [label="환상이라는 점에서 네 인생은 너무 터무니없었던 나머지 신의 현실성이란 게 너무 자연스러워서. 추측 따윌 한다 해 봤자 피자에 토핑 올리는 정도의 이득밖에 없는 거니까.",shape=box,color=blue];
		2997 -> 3000;
	2998 [label="진짜 신이란, 뭐 마을 우물이나 옥외 화장실 같은 거 아닐까. 과거 사람들에겐 정말로 있었던 것. ",shape=box,color=blue];
		2998 -> 3001;
	2999 [label="자격이 있는 것도 아니고, 단지 세상이 그렇다는 이유로 모든 걸 차지하고 조종하는 치졸한 불사신 자식들의 손에 모든 것이 달려 있다고 상상해 봐.",shape=box,color=blue];
		2999 -> 3002;
	3000 [label="게다가 넌 실제로 신을 만난 적이 있을 지도 모르지. 무심이란 게 바로 그 신이라면.",shape=box,color=blue];
		3000 -> 3003;
	3001 [label="오늘날에 와선 그저 상징이라던지, 은유라던지, 뭐 그런 말도 안 되는 것들일 뿐이고.",shape=box,color=blue];
		3001 -> 3004;
		3001 -> 3005;
	3002 [label="그리고 더 미치는 부분은, 옛 사람들은 실제로 그걸 사실이라 믿고 살아왔다는 거야. 그게 그들의 현실이고, 매일의 일상이었으니까.",shape=box,color=blue];
		3002 -> 3006;
	3003 [label="네 덕에 방금 생각이 났네. 자리만에서 있었던 일. 내가 무심을 처음 만났던 때 말이야.",shape=box,color=red];
		3003 -> 3007;
	3004 [label="어쩌면 오늘날 사람들은 그냥 덜 무서워하게 된 걸지도?",shape=box,color=red];
		3004 -> 3008;
	3005 [label="솔이랑 루아가 너희 신 아니었어?",shape=box,color=red];
		3005 -> 3009;
	3006 [label="그 당시 사람들에게 신이란 날씨만큼이나 현실인 것이었고, 동시에 날씨만큼의 재앙을 던져 주던 존재였지.",shape=box,color=blue];
		3006 -> 3010;
	3007 [label="그땐 그게 그거였는지도 몰랐지, 물론. 하지만 그놈이 말했던 건 똑똑히 기억해. ",shape=box,color=red];
		3007 -> 3011;
	3008 [label="응, 그게 맞는 것 같아. ",shape=box,color=blue];
		3008 -> 3012;
	3009 [label="뭐 그건, 그렇지. 하지만 동시에 그냥 천체이기도 한 거잖아. ",shape=box,color=blue];
		3009 -> 3013;
	3010 [label="솔직히 말해서, 오로킨 치하에서 사는 삶이랑 다르진 않은 것 같은데.",shape=box,color=red];
		3010 -> 3014;
	3011 [label="내 불빛을 가져가도 된다고 했더니, 나한테 웃어 보이면서 그러더라고. '고맙다, 얘야. 그럼 받아 가야겠어.'",shape=box,color=red];
		3011 -> 3015;
	3012 [label="왜 그런지도 알 것 같고.",shape=box,color=blue];
		3012 -> 3016;
	3013 [label="브리타니아가 이름이나, 정체성 같은 걸 갖춘 나라긴 하지만, 동시에 그냥 흙과 바위로 된 덩어리일 뿐이기도 한 것처럼. 둘 다 동시에 해당할 수 있는 거지.",shape=box,color=blue];
		3013 -> 3017;
	3014 [label="불사신에, 옹졸하고, 그냥 위에 서 있으니까 군림할 뿐이고...",shape=box,color=red];
		3014 -> 3018;
	3015 [label="어휴 세상에, 소름이 돋는다.",shape=box,color=blue];
		3015 -> 3019;
	3016 [label="그러니까, 결국은 빛의 문제야.",shape=box,color=blue];
		3016 -> 3020;
	3017 [label="화창하게 날씨 좋은 날 나가서 갑자기 감사하는 마음이 들면, 하늘 위 솔을 올려다보며 '건배!' 할 수도 있는 거고, 그건 진심인 거야. 사람이라면 흔히 하는 일인 거고.",shape=box,color=blue];
		3017 -> 3021;
	3018 [label="맞다, 그래. 네겐 진짜로 살아 있는 신이 있었지. 하지만 너희가 전부 죽였잖아.",shape=box,color=blue];
		3018 -> 3022;
	3019 [label="어느 오랜 민담에서나 악마란 건 법조문 하나하나에 깐깐하게 매달리는 놈들이니 말이야.",shape=box,color=blue];
		3019 -> 3023;
	3020 [label="애시당초에, 솔과 루아란 게 뭐였지? 이들이 누구에게든 '신'으로 비쳐지기 전에 말이야. 빛이었잖아.",shape=box,color=blue];
		3020 -> 3024;
		3020 -> 3025;
	3021 [label="하지만 오늘날 솔이나 루아가 무슨 임신한 인간 여성이라거나, 어떤 인간 남자놈의 아이를 낳았다거나, 그렇게 해서 왕이 태어났다거나 하는 말을 말 그대로 믿는 사람은 없어.",shape=box,color=blue];
		3021 -> 3026;
	3022 [label="(오해는 말렴, 네가 신을 죽여버렸다는 게 난 너무나 좋으니까.)",shape=box,color=blue];
		3022 -> 3027;
	3023 [label="그 녀석은 네가 거기에 뭔가를 약속했다고 생각한 걸까? 네 그 '불빛'에?",shape=box,color=blue];
		3023 -> 3028;
		3023 -> 3029;
	3024 [label="그렇지. 어딜 가든, 빛은 좋은 것, 선한 것을 상징하니까.",shape=box,color=red];
		3024 -> 3030;
	3025 [label="아주 오랫동안, 인류에게 유이하게 존재했던 빛이었지.",shape=box,color=red];
		3025 -> 3030;
	3026 [label="하지만 옛날의 사람들은 정말로 그런 걸 믿었지. 지금의 우리는 그 이야기가 그저 전설일 뿐이라는 걸 알고, 그런 이야기를 믿을 단계를 이미 지나쳐버렸지만.",shape=box,color=blue];
		3026 -> 3031;
		3026 -> 3032;
	3027 [label="우리 꼬맹이랑 나를 헷갈리고 있는 것 같은데. 그 위대한 텐노들의 반란에 난 참여해 보지도 못했어.",shape=box,color=red];
		3027 -> 3033;
	3028 [label="그 녀석은 내가 '거래'를 했다고 했어. 그러니 내가 그 녀석에게 뭘 빚졌다고 생각하는 건... 맞는 것 같은데.",shape=box,color=red];
		3028 -> 3034;
	3029 [label="내가 말한 건 그 때 내가 들고 있던 둥근 전등이었지만, 그 녀석이 무슨 뜻으로 말했는진, 뭐 누가 알아.",shape=box,color=red];
		3029 -> 3034;
	3030 [label="바로 그거야.",shape=box,color=blue];
		3030 -> 3035;
	3031 [label="신이랑 인간이... 서로 짝을 지었다고?",shape=box,color=red];
		3031 -> 3036;
	3032 [label="신을 부모로 둔 왕이라고? 오로킨만 멍청이들인 줄 알았는데 더하네.",shape=box,color=red];
		3032 -> 3036;
	3033 [label="그 아주 특별하다는 애들을 위한 마굴리스의 프로그램엔 들어가 보지도 못했고. 워프레임도 못 얻었고, 옛 전쟁에서 싸워본 적은 더더욱 없었네.",shape=box,color=red];
		3033 -> 3037;
	3034 [label="다만 그 녀석에 대한 것 한 가지는 확실해. 그 녀석은 놀이를 할 줄 안다는 것.",shape=box,color=red];
		3034 -> 3038;
	3035 [label="하지만 어느 날, 아마 덩치 큰 동굴 원시인 여자애들에게 괴롭힘이나 당했을 어떤 동굴 원시 너드가 그놈의 돌끼리 부딪쳐보는 그걸 해 본 거고, 그랬더니 빙고!",shape=box,color=blue];
		3035 -> 3039;
	3036 [label="어휴, 그런 얘긴 아주 많고도 많단다. 전 세계 온 사방에 있지.",shape=box,color=blue];
		3036 -> 3040;
	3037 [label="...차라리 네가 겪었으면 좋았을걸 싶었니?",shape=box,color=blue];
		3037 -> 3041;
		3037 -> 3042;
		3037 -> 3043;
	3038 [label="+20 Chemistry",color=orange];
		3038 -> 3044;
	3039 [label="원하는 때에 원하는 대로 빛이 있으라! 하늘에 떠 있는 저 커다란 빛한테서는 이제 독립인 거지!",shape=box,color=blue];
		3039 -> 3045;
	3040 [label="어떤 오만한 성직자가 바다를 건너 신대륙의 '야만인'들에게 솔의 복음을 전파하려고 했는데, 그 야만인들이 솔에 대해서 이미 다 알고 있을 뿐만 아니라, 그들을 통치하는 게 솔의 친자식이었다고 생각해 봐.",shape=box,color=blue];
		3040 -> 3046;
	3041 [label="사실은 잘 모르겠어.",shape=box,color=red];
		3041 -> 3047;
	3042 [label="솔직히 말하자면, 아니.",shape=box,color=red];
		3042 -> 3048;
	3043 [label="응. 그게 나았을걸.",shape=box,color=red];
		3043 -> 3049;
	3044 [label="그래. 네가 오늘 뭘 하든, 아서든, 나든, 우리 중 누구랑 있든... 몸 조심하렴.",shape=box,color=blue];
		3044 -> 3050;
	3045 [label="그리고 지금의 우릴 봐, 어딜 가나 빛이 있지. 빛의 가치를 끌어내린 거야.",shape=box,color=blue];
		3045 -> 3003;
	3046 [label="대번에 꼬리를 말고 고향으로 도망치든지, 아님 그 자리에서 개종하겠지.",shape=box,color=blue];
		3046 -> 3051;
		3046 -> 3052;
	3047 [label="그럴 수도 있지. 존중해.",shape=box,color=blue];
		3047 -> 3057;
	3048 [label="기쁜 소리네. 네 지금의 인생이 최악이 아니고 더 나빴을 수도 있다는 걸 알 수 있다면, 축하할 만한 일이 아닐까?",shape=box,color=blue];
		3048 -> 3057;
	3049 [label="이해가, 될 것도 같아. 놓쳐버린 게 참 많은 거지?",shape=box,color=blue];
		3049 -> 3057;
	3050 [label="Check boolean EleanorDating",color=orange];
		3050 -> 3054 [label=true,color=green];
		3050 -> 3055 [label=false,color=brown];
