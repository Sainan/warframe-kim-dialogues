digraph {
	220 [label="EleanorRank1Convo4 begins.",color=orange];
		220 -> 221;
	221 [label="어떤 느낌이니? 전염병이 가득한 도시를 유유자적 돌아다니면서도, 병에 걸릴 걱정 따윈 안 해도 되는 자유가 있다는 게.",shape=box,color=blue];
		221 -> 222;
		221 -> 223;
		221 -> 224;
	222 [label="\"유유자적 돌아다닌다\"는 표현은 너무한데, 엘레노어.",shape=box,color=red];
		222 -> 225;
	223 [label="내가 병에 걸릴지 안 걸릴지는 몰라. 그냥 여지껏 안 걸린 것 뿐이니까.",shape=box,color=red];
		223 -> 226;
	224 [label="환상적이지. 위기에 처한 사람들을 도와줄 수 있잖아.",shape=box,color=red];
		224 -> 248;
	225 [label="충고 고맙지만, 난 내 좋을 대로 말할 거란다.",shape=box,color=blue];
		225 -> 227;
		225 -> 228;
	226 [label="어머, 그럴 리가.",shape=box,color=blue];
		226 -> 230;
	248 [label="하. 그게 엔트라티의 전매특허였지. 그가 처음으로 그놈의 '닥터 프라이데이' 의학 쇼인지 뭔지에 출연헀던 시절.",shape=box,color=blue];
		248 -> 255;
	227 [label="그럼 네가 선을 넘거든 내가 말해줄게.",shape=box,color=red];
		227 -> 232;
	228 [label="그러시든지. [종료.]",shape=box,color=red];
		228 -> 229;
	230 [label="네가 하는 걸 봐 왔거든. 너도 한때 인간이었을지는 모르지만, 이제는 우주 엘프 스팽글리부츠 같은 거잖니. 그 온갖 귀신 나올 것 같은 빛무리며 신비한 힘들.",shape=box,color=blue];
		230 -> 231;
	255 [label="Check boolean EleanorEntrati",color=orange];
		255 -> 256 [label=true,color=green];
		255 -> 257 [label=false,color=brown];
	232 [label="…",shape=box,color=blue];
		232 -> 233;
	229 [label="Chat ends.",color=orange];
	231 [label="네가 죽을 수 있다고 생각 안 해. 적어도 영원히는. 그리고 사람들이 죽기 위해 얼마나 노력했는지, 나는 알지.",shape=box,color=blue];
		231 -> 236;
	256 [label="왜 그자 본인은 감염되지 않았는지 궁금해지긴 하는군. 그의 가족들도 결국은 다 당했는데.",shape=box,color=blue];
		256 -> 263;
	257 [label="적어도 그자는 흡수되지 않고 스스로를 지켜냈더구나. 네가 아는 것보다 너와 더 비슷할지도 모르겠어.",shape=box,color=blue];
		257 -> 263;
	233 [label="좋아. 알았다고. 미안해.",shape=box,color=blue];
		233 -> 234;
	236 [label="넌 테크병을 무서워하는 척조차 하지 않아. 왜 하겠어? 무서울 이유가 없는데.",shape=box,color=blue];
		236 -> 237;
	263 [label="홀바니아엔 참 구세주 지망생들이 많기도 해.",shape=box,color=blue];
		263 -> 264;
	234 [label="이 엘레노어가 오늘은 좀 레몬처럼 시큼하단다.",shape=box,color=blue];
		234 -> 235;
	237 [label="어차피 걸리지 않을 테니까.",shape=box,color=blue];
		237 -> 245;
		237 -> 246;
		237 -> 247;
	264 [label="옛날엔 공주님, 그 다음엔 엔트라티. 빅토르. 물론 내 남동생도 있지. 그리고 이젠 너고.",shape=box,color=blue];
		264 -> 265;
	235 [label="솔 맙소사, 그 시큼한 레몬 맛마저도 그립네.",shape=box,color=blue];
		235 -> 238;
		235 -> 239;
	245 [label="넌 이것들을 나만큼은 모르지. 이것들은 진화해. 변이하고, 학습한다고. 오로킨도 저것들을 이길 수 있을 거라 생각했지만, 결국 이길 수 없었어.",shape=box,color=red];
		245 -> 249;
	246 [label="어쩌면 네 말이 맞을지도 모르지. 하지만 모르잖아.",shape=box,color=red];
		246 -> 261;
	247 [label="네 말이 맞아. 그러니 사람들을 더 도울 수 있을지도.",shape=box,color=red];
		247 -> 248;
	265 [label="넌 스스로를 영웅이라고 생각하니?",shape=box,color=blue];
		265 -> 270;
	238 [label="뭐 마음에 담아둔 거라도 있어?",shape=box,color=red];
		238 -> 242;
	239 [label="그럼 그러고 재밌게 놀던가. [종료.]",shape=box,color=red];
		239 -> 244;
