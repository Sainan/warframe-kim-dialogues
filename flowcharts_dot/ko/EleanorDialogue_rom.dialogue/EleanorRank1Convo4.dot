	242 [label="+10 Chemistry",color=orange];
		242 -> 240;
	244 [label="Chat ends.",color=orange];
	252 [label="아, 세상에. 이제야 기억났어. 에리스. 그 선체들. 데이모스의 지표.",shape=box,color=blue];
		252 -> 253;
	253 [label="테크병을 상대론 이길 수 없다는 걸 자꾸만 잊어버리게 되는구나.",shape=box,color=blue];
		253 -> 258;
	250 [label="모르겠지. 그리고 추측할 입장도 아니야, 실은.",shape=box,color=blue];
		250 -> 251;
	271 [label="난 그저 최선을 다할 뿐이야.",shape=box,color=red];
		271 -> 281;
	272 [label="응, 맞아.",shape=box,color=red];
		272 -> 276;
