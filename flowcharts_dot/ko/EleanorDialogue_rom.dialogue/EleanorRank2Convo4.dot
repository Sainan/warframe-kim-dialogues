	657 [label="난 네가 이 문제에 대해 계속 생각하는 게 건강에 좋지 않다고 생각해.",shape=box,color=red];
		657 -> 658;
	670 [label="자. 벽이 세워졌어. 이제 조용히 해봐. 이제 널 보내줘야 할 거 같네, 그렇지.",shape=box,color=blue];
		670 -> 671;
	658 [label="난 내가 건강하다고 생각하지 않아, 완전히 끝. 여기까지.",shape=box,color=blue];
