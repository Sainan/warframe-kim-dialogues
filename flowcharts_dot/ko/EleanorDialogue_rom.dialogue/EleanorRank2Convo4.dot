		639 -> 668;
	655 [label="내가 완전히 죽는다면 어떻게 될지 궁금해져. 테크병은 시체를 살아있게 하고 용도를 변경할 수 있어. 본 적이 있거든. 마치 흰개미 무리가 로봇을 조종하기 위해 함께 일하는 모습을.",shape=box,color=blue];
		655 -> 656;
	668 [label="좋아. 좋아. 알았어. 이제 집중할게. 제발 내 곁에 있어줘. 내 생각으로 벽을 만들고 있다고. 나와 천사들 사이에 벽이 생기고 있어.",shape=box,color=blue];
		668 -> 669;
	656 [label="그럼.. 나는 일종의 테크병 좀비가 되는 걸까? 만약 그것이 나를 되살려 놓았다면, 그건 여전히 나인 걸까? 아니면 나는 단지 내 기억에 접근이 가능한 테크병 하이브마인드 형태일 뿐이고, 나라고 생각하는 걸까?",shape=box,color=blue];
		656 -> 657;
