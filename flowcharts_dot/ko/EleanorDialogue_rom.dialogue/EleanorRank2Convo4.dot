digraph {
	553 [label="EleanorRank2Convo4 begins.",color=orange];
		553 -> 554;
	554 [label="우리가 죽고 나면 무슨 일이 일어날까?",shape=box,color=blue];
		554 -> 555;
		554 -> 556;
		554 -> 557;
		554 -> 558;
	555 [label="난 괜찮아, 엘레노어. 물어봐 줘서 고마워! 잘 지내고 있지?",shape=box,color=red];
		555 -> 560;
	556 [label="... 너 괜찮니?",shape=box,color=red];
		556 -> 561;
	557 [label="난 죽은 후에도 그 자아가 살아남을 수 있다는 것을 충분히 봐 왔어.",shape=box,color=red];
		557 -> 562;
	558 [label="멍청한 얘기는 그만하자. [종료.]",shape=box,color=red];
		558 -> 559;
