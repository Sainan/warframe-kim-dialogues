		578 -> 584 [label=true,color=green];
		578 -> 585 [label=false,color=brown];
	579 [label="집착?",shape=box,color=blue];
		579 -> 586;
	569 [label="내가 잡담은 건너 뛰고 핵심을 찌른 건 아는데, 솔직히 말해서 네 피 냄새가 호기심을 끄는 탓도 있어.",shape=box,color=blue];
		569 -> 570;
	580 [label="나도 봤어. 나는 너의 오로킨이 형벌로 여겨졌던 존재를 사후에 걸맞은 이름이라고 생각하지 않는데.",shape=box,color=blue];
		580 -> 581;
	581 [label="으악. 난 차라리 죽는 게 나을 거 같아.",shape=box,color=blue];
		581 -> 588;
	582 [label="난 이 행성에서 일어나는 모든 넌더리나는 일들 중에서도, 오로킨이 최악이라고 생각해.",shape=box,color=blue];
		582 -> 583;
	583 [label="그들이 존재하는 걸 막기에는 너무 늦은 걸까. 왠지 짓밟아 버릴 나비를 찾아봐야 할 거 같네.",shape=box,color=blue];
		583 -> 589;
	584 [label="보이드 매직인 건가. 보이드에 대해 더 많이 알아갈수록, 거기에 더 가고 싶어져. 아마도 내가 속해야 할 곳은 거기인 거 같아. 지도의 끝자락에 있고 용이 있는. 텐노 너는 보이드 피를 가지고 있잖아. 운 좋은 자식.",shape=box,color=blue];
		584 -> 585;
	585 [label="너희들 모두에게는 매우 잘된 일이지만, 우리 같은 무지렁이들은? 텐노가 될 수 없는 거잖아, 그렇지?",shape=box,color=blue];
		585 -> 590;
	586 [label="넌 집에서 멀리 떨어져 온 불쌍한 외계인이고, 나는 뭐 네 몸을 조각내서 네가 어떻게 작동하는지 알아내기 위해 집착하는 과학자라는 건가?",shape=box,color=blue];
		586 -> 587;
	570 [label="시간 여행을 하는 이방인이 말 그대로 내 인생에, 이미 우스꽝스러워 보이는 내 인생에 툭 떨어졌는데, 나는 사회적 예의범절에서 물러나야 한다는 말이야?",shape=box,color=blue];
		570 -> 571;
	588 [label="멍청한 얘기 그만해, 엘레노어. 세팔론은 사람이라고.",shape=box,color=red];
		588 -> 595;
	589 [label="상상해 봐. 멍청한 병신 새끼 무리들 존재가 통째로 사라졌는데 억울한 건 그들이 비명이 지르는 소리조차 들을 수 없었다는 거지.",shape=box,color=blue];
		589 -> 597;
	590 [label="죽음에서 살아나면 가능하다고도 생각해.",shape=box,color=red];
		590 -> 599;
	587 [label="미안. 나는 우리가 서로에게 꽤 흥미를 자아내는 존재라고 생각했어. 이런 작은 대화가 서로를 알아가는 우리만의 방식이라고 생각했다고.",shape=box,color=blue];
		587 -> 591;
	571 [label="너는 내게 다른 누군가가 생각할 수 없는 관점을 제시할 수 있어. 그러니 제발. 내가 가구들을 후벼 파기 전에. 나랑 얘기 좀 해줘.",shape=box,color=blue];
		571 -> 572;
		571 -> 573;
		571 -> 574;
		571 -> 575;
	595 [label="내가 틀렸다면 알려줘, 하지만... 네가 말하는 그건 사람이 아닌 것처럼 들리는데. 마치 사람이라고 생각하도록 프로그래밍된 컴퓨터와 더 비슷하지 않나?",shape=box,color=blue];
		595 -> 596;
	597 [label="비록...",shape=box,color=blue];
		597 -> 598;
	599 [label="그래, 그래, 무슨 말인지 알아. 내 말 좀 들어봐 봐.",shape=box,color=blue];
		599 -> 600;
	591 [label="그런데 아니었네. 난 깨어있는 모든 시간을 본인의 '집착'에 대해서만 생각하는 지크의 사생팬이랑 다를 바 없구나.",shape=box,color=blue];
		591 -> 592;
	596 [label="뭐 그럴 수도 있고. 네크랄로이드는 아직 살아있는 로이드의 세팔론 복제품이야. 하지만 세팔론이 오리지널이 아니더라도, 그들은 여전히 사람인 거라고.",shape=box,color=red];
		596 -> 601;
	598 [label="쓰레기들이긴 했지만.",shape=box,color=blue];
		598 -> 602;
	600 [label="보이드는 영혼이 존재하는 곳일 거야. 우리가 말하고 있는 게 그거지? 누군가가 정령의 영역을 열었는데 이제 너희들은 그것을 사용해서 그 반쪽 기기에 전력을 공급한다는 거잖아.",shape=box,color=blue];
		600 -> 605;
	592 [label="여기는 두비리가 아니 옵니다, 폐하. 여기 있는 사람은 아무도 신경 쓰지 않아.",shape=box,color=blue];
		592 -> 593;
	601 [label="흠. 미안하지만, 그건 다른 문제야. 우리는 여기서 인격에 대해 이야기하고 있는 게 아니야. 우리는 연속성에 대해 이야기하고 있는 거라고.",shape=box,color=blue];
		601 -> 806;
	602 [label="내가 그들을 쓸어버렸다면 너도 그랬을 거야, 아닌가? 너의 존재는 그들의 존재에 달려있기 때문이지.",shape=box,color=blue];
		602 -> 603;
		602 -> 604;
	605 [label="그냥 누군가는 아니고. 엔트라티. 그가 보이드에 첫 발을 내디뎠어.",shape=box,color=red];
		605 -> 606;
	593 [label="잘난 척 그만해.",shape=box,color=blue];
		593 -> 594;
	806 [label="아미르에게 부탁해 말하는 샬롯 인형을 재프로그램시켜 엘레노어의 간판 대사 몇 개를 집어넣으면, 내가 죽은 뒤 아미르가 그걸 갖고 레티에게 겁을 줄 수는 있겠지만, 그게 나는 아닐 거잖아.",shape=box,color=blue];
		806 -> 807;
	603 [label="아, 우리에게 필요한 게 바로 이거네. 더 많은 사람들이 타임라인을 어지럽히고 있어.",shape=box,color=red];
		603 -> 610;
	604 [label="아니면 네가 새로운 역사의 한 지표를 만들어 그걸 따라가는 거야.",shape=box,color=red];
		604 -> 611;
	606 [label="그 이중적인 개자식이 이 특정한 일에 숟가락 얹었다는 사실을 알았어야 했어.",shape=box,color=blue];
		606 -> 608;
	594 [label="Chat ends.",color=orange];
	807 [label="아니면 내가 그 인형에 어떻게 빙의할 수 있다면 모를까. 가서 한 번 생각해볼게.",shape=box,color=blue];
		807 -> 622;
		807 -> 623;
	610 [label="와우.",shape=box,color=blue];
		610 -> 612;
	611 [label="내가 시작하게 하지 마. 시작하면 우리는 일주일 내내 여기 있게 될 거야.",shape=box,color=blue];
		611 -> 613;
	608 [label="보이드에서 죽은 사람을 만난 적이 있어? 아니면 보이드가 죽은 사람의 모습을 취한 적이 있니? 물어봐서 미안하지만, 알고 싶어.",shape=box,color=blue];
		608 -> 609;
	622 [label="톱날처럼 생겼고 톱날처럼 소리가 난다면, 그건 톱날이야. 그냥 다 똑같은 거라고, 그렇지 않아?",shape=box,color=red];
		622 -> 624;
	623 [label="이거 너에게 중요한 거지?",shape=box,color=red];
		623 -> 625;
	612 [label="난 그냥 재미있는 대화라고만 생각했어.",shape=box,color=blue];
		612 -> 614;
	613 [label="우리는 여전히 '육체가 죽으면 영혼이 살아남는가'에 대해 이야기 중이야. 아직 '자유 의지란 정말 존재하는가'에 대해 도달하지 않았다고.",shape=box,color=blue];
		613 -> 615;
	609 [label="나는 그렇게 죽은 사람들을 몇 알아. 사수자들.",shape=box,color=red];
		609 -> 617;
	624 [label="흠. 아니. 난 그렇게 생각하지 않아.",shape=box,color=blue];
		624 -> 640;
	625 [label="아, 눈치챘어?",shape=box,color=blue];
		625 -> 645;
	614 [label="분명히 말하지만, 난 미래에 대해 실제로 계획이 없어. 난 그저",shape=box,color=blue];
		614 -> 616;
	615 [label="(이게 네가 얻게 되는 거야, 엘레노어, 그녀가 자기 자신에게 얘기한다. 이게 바로 흥미로운 사람에게 중요한 질문을 해야 하는 이유야.)",shape=box,color=blue];
		615 -> 622;
		615 -> 623;
	617 [label="Update boolean EleanorHoldfasts1",color=orange];
		617 -> 626;
	640 [label="만약 보이드가 내 복제를 만들었다면, 난 우리 중 누가 진짜인지 잠을 이루지 못할 거 같은데.",shape=box,color=blue];
		640 -> 641;
	645 [label="어. 나에게 중요해.",shape=box,color=blue];
		645 -> 646;
	616 [label="그거 알아? 그럴만한 가치가 없다고.",shape=box,color=blue];
		616 -> 618;
	626 [label="뭐라고?",shape=box,color=blue];
		626 -> 627;
	641 [label="왜냐하면 죽은 동안에도 그럴 수 있다면, 살아있는 동안에도 분명 가능할 테니까.",shape=box,color=blue];
		641 -> 642;
	646 [label="내가 실제로 얘기한 것보다 훨씬 더, 두렵네.",shape=box,color=blue];
		646 -> 647;
	618 [label="난 그저 네가 가버리는 걸 정말로 원하지 않는다고 말하려던 것뿐이야. 아주아주 많이. 그래서 내 미래에 있는 사람들이 뭔가를 바꾸기보다는 폭군들의 굴레에 갇혀 고통을 받도록 내버려두려고 한 거라고.",shape=box,color=blue];
		618 -> 619;
	627 [label="죽은 사람을 알고 있다고? 개인적으로?",shape=box,color=blue];
		627 -> 628;
	642 [label="... 내 이야기가 산으로 가는 거 같네. 미안해. 나중에 이야기하자고. 어쩌면.",shape=box,color=blue];
		642 -> 643;
	647 [label="우리 중 일부가 신체의 죽음에서 살아남기를 바라는 데는 이유가 있다고 가정해 보자. 그런 사람이 나 혼자만은 아니라는 걸 알겠네.",shape=box,color=blue];
		647 -> 648;
	619 [label="짓궂은 농담이군. 미안. 다시는 하지 않을게.",shape=box,color=blue];
		619 -> 620;
	628 [label="그들은 죽은 것을 기억해? 실제로 그들이 죽었다는 걸 알아?",shape=box,color=blue];
		628 -> 629;
		628 -> 630;
	643 [label="+10 Chemistry",color=orange];
		643 -> 644;
	648 [label="Update boolean EleanorBereaved",color=orange];
		648 -> 649;
	620 [label="+5 Chemistry",color=orange];
		620 -> 621;
	629 [label="어. 그들은 예전에 자리만의 장교였어. 보이드에서 길을 잃은 콜로니 함선의. 지금은 아마 유령이 됐을 거야.",shape=box,color=red];
		629 -> 631;
	630 [label="그게... 좀 복잡해. 보이드로 들어갈 수는 있지만, 나올 때는 똑같지 않거든.",shape=box,color=red];
		630 -> 632;
	644 [label="Chat ends.",color=orange];
	649 [label="너 잘못된 사람에게 묻고 있어. 난 내가 죽을 수 *있을지* 확신할 수가 없거든.",shape=box,color=red];
		649 -> 650;
	621 [label="Chat ends.",color=orange];
	631 [label="맙소사, 믿을 수가 없군.",shape=box,color=blue];
		631 -> 633;
	632 [label="아. 적절한 단어를 찾지 못하는 거니? 아니면 내게 모든 이야기를 해주고 싶지 않은 거니? 사람들이 뭔가 머뭇거리려고 하면 괜히 긴장된다니까.",shape=box,color=blue];
		632 -> 634;
	650 [label="Check boolean EleanorDuviri",color=orange];
		650 -> 651 [label=true,color=green];
		650 -> 652 [label=false,color=brown];
	633 [label="하지만...",shape=box,color=blue];
		633 -> 635;
	634 [label="잠깐. 대답하지 말아봐. 방금 뭔가가 떠올랐어. 그게 네 생각인지 아닌지는 모르겠지만, 별 나무에서 피 흘리고 있는 솔의 모습은 끔찍하네.",shape=box,color=blue];
		634 -> 636;
	651 [label="맞아. 그들은 노력했어, 그렇지? 트락스는 너를 스펙터클하게 만들었지. 네가 그 악몽을 어떻게 극복하고 제정신을 유지했는지 모르겠다.",shape=box,color=blue];
		651 -> 652;
	652 [label="우리끼리 하는 얘기지만, 내가 죽을 수 있을지 모르겠다.",shape=box,color=blue];
		652 -> 653;
	635 [label="우리는 그 안에 같은 사람이 있다는 걸 어떻게 알지? 같은 관점인가?",shape=box,color=blue];
		635 -> 637;
	636 [label="천사들.",shape=box,color=blue];
		636 -> 638;
	653 [label="지금 내 안에는 작은 테크노사이트들로 구성된 위원회가 살고 있는데, 만약 자기들의 집이 철거된다면 엄청 화를 내겠지.",shape=box,color=blue];
		653 -> 654;
	637 [label="그냥, 나도 잘 모르겠는데, 보이드 클론 뭐 그런 건가? 가능한 건가? 보이드가 사람의 생각을 가져다가 취한 다음 형태를 부여한다. 그리고 그 형태가 죽은 사람과 동일한 사람이라고 생각한다라.",shape=box,color=blue];
		637 -> 622;
		637 -> 623;
	638 [label="친절한 루아, 난 그들을 들을 수 있어. 마치... 에어컨이 너무 오래 작동해서 그 소리를 차단했는데 갑자기 들리는 거처럼.",shape=box,color=blue];
