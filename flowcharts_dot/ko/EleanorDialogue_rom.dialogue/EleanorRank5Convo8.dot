digraph {
	2659 [label="EleanorRank5Convo8 begins.",color=orange];
		2659 -> 2660;
	2660 [label="생각해 봤는데, 해야 할 일이 있어.",shape=box,color=blue];
		2660 -> 2661;
	2661 [label="도움이 필요할 것 같아.",shape=box,color=blue];
		2661 -> 2662;
		2661 -> 2663;
	2662 [label="난 항상 너를 위해 여기 있어. 무슨 생각 해?",shape=box,color=red];
		2662 -> 2665;
	2663 [label="지금은 채팅을 할 수 없어, 미안. [종료.]",shape=box,color=red];
		2663 -> 2664;
	2665 [label="Check boolean EleanorChristopher2",color=orange];
		2665 -> 2667 [label=true,color=green];
		2665 -> 2666 [label=false,color=brown];
	2664 [label="Chat ends.",color=orange];
	2667 [label="그래서. 크리스토퍼 말인데.",shape=box,color=blue];
		2667 -> 2675;
	2666 [label="Check boolean EleanorChristopher1",color=orange];
		2666 -> 2671 [label=true,color=green];
		2666 -> 2668 [label=false,color=brown];
	2675 [label="나는 수년 동안 그를 붙잡고 있었어. 아서 역시. 우리는 매년 그를 추모했지만 올해는 안 했어. 더 이상 마주하지 못하겠기에.",shape=box,color=blue];
		2675 -> 2676;
	2671 [label="아주... 길고 비극적인 이야기를 아주 짧게 하자면... 크리스토퍼는 우리가 결혼하기 전에 도로변 폭탄 테러로 죽었어.",shape=box,color=blue];
		2671 -> 2672;
	2668 [label="크리스토퍼에 대해 말해야겠어.",shape=box,color=blue];
		2668 -> 2669;
	2676 [label="유령이 존재하는지 모르겠지만, 어쩌면 존재할 것도 같아. 내가 그를 유령이 되게 했으니.",shape=box,color=blue];
		2676 -> 2677;
	2672 [label="아마도 다른 날 모든 이야기를 할 수도 있고. 안 할 수도 있어.",shape=box,color=blue];
		2672 -> 2673;
	2669 [label="아서의 가장 친한 친구였어. 우리는 약혼했었고 나는 그를 사랑한다고 생각했었지.",shape=box,color=blue];
		2669 -> 2670;
	2677 [label="너무 자책하지 마. 너 그 사람을 사랑했잖아.",shape=box,color=red];
		2677 -> 2678;
	2673 [label="지금 이걸 너에게 말하는 이유는...",shape=box,color=blue];
		2673 -> 2674;
	2670 [label="Update boolean EleanorChristopher1",color=orange];
		2670 -> 2671;
	2678 [label="오 친구. 나 그렇다고 생각했었거든. 나는 그 사람을 사랑했지만, 내가 그와 사랑을 했었는지 아닌지는 모르겠더라.",shape=box,color=blue];
		2678 -> 2679;
	2674 [label="Update boolean EleanorChristopher2",color=orange];
		2674 -> 2675;
	2679 [label="끔찍하게 들리지 않니? 하지만 사실이야. 당시에는 중요하지 않았던 거 같아. 그러다 그가 죽었고, 그게 우리 이야기의 전부가 되어 버렸어.",shape=box,color=blue];
		2679 -> 2680;
	2680 [label="내가 애정했던 모든 것들이 그가 어떻게 죽었는지에 가려져 버렸어. 그 사람을 생각할 때마다 마음이 편치 않아.",shape=box,color=blue];
		2680 -> 2681;
	2681 [label="이건 불공평해. 그에게. 이보다 더 나은 대우를 받을 자격이 있는데.",shape=box,color=blue];
		2681 -> 2682;
		2681 -> 2683;
	2682 [label="이해해. 완전히. 나는 우리 부모님을 그들이 대우받아 마땅한 방식으로 기억하기로 했거든.",shape=box,color=red];
		2682 -> 2684;
	2683 [label="끔찍한 일이지만 피할 수 없었잖아. 그게 우리가 붙잡고 있는 유일한 것이 되게 내버려 둘 순 없어.",shape=box,color=red];
		2683 -> 2684;
	2684 [label="그런데 나는 왜 이렇게 죄책감이 드는 걸까?",shape=box,color=blue];
		2684 -> 2685;
	2685 [label="왜 그를 놓아주는 게 그를 버리는 것과 같은 기분이 드는 걸까?",shape=box,color=blue];
		2685 -> 2686;
		2685 -> 2688;
	2686 [label="네가 그를 너무 오랫동안 붙잡고 있었기 때문에 멈추는 방법을 모르는 것뿐이야.",shape=box,color=red];
		2686 -> 2687;
	2688 [label="너는 다른 누군가가 너를 사랑할 수 없을 거라 걱정하기 때문이야.",shape=box,color=red];
		2688 -> 2689;
	2687 [label="이런. 네 말이 맞네.",shape=box,color=blue];
		2687 -> 2692;
	2689 [label="Check boolean EleanorDating",color=orange];
		2689 -> 2690 [label=true,color=green];
		2689 -> 2691 [label=false,color=brown];
	2692 [label="우리는 이런 문제를 다루는 데 아무 쓸모가 없어, 내 운명인 건가. 우린 모든 걸 억누르지. 용감한 얼굴을 하고 전선에서 휘파람을 불고. 그건 우릴 이겨내게 해. 우리 부모님을 이겨냈듯이. 하지만 멈추는 법을 몰라.",shape=box,color=blue];
		2692 -> 2693;
	2690 [label="그게 다야? 내가 그렇게 가벼운가?",shape=box,color=blue];
		2690 -> 2694;
	2691 [label="지금 내 상태로는 크리스토퍼조차도 나를 사랑해 주지 않을 거야.",shape=box,color=blue];
		2691 -> 2696;
	2693 [label="어떻게 해야 하지? 어떻게 놓아줘야 해?",shape=box,color=blue];
		2693 -> 2698;
	2694 [label="지금은 너희 중 누구와도 어울리지 않은 것 같아.",shape=box,color=blue];
		2694 -> 2695;
	2696 [label="... 아니. 그건 맞지 않아. 나는 그에게 전혀 공평하지 굴지 않았어, 그렇지?",shape=box,color=blue];
		2696 -> 2697;
	2698 [label="Check boolean LettieDiasdeMuertos",color=orange];
		2698 -> 2699 [label=true,color=green];
		2698 -> 2700 [label=true,color=green];
		2698 -> 2701 [label=true,color=green];
		2698 -> 2700 [label=false,color=brown];
		2698 -> 2701 [label=false,color=brown];
	2695 [label="나... 나는 네가 내 모든 가졌으면 좋겠어. 끝없는 슬픔 속에 내 일부를 가두어 둘 수는 없어.",shape=box,color=blue];
		2695 -> 2698;
	2697 [label="그는 내 행복을 방해하고 싶지 않을 거야. 친절한 사람이거든.",shape=box,color=blue];
		2697 -> 2698;
	2699 [label="난 레티가 도와줄 수 있다고 생각해.",shape=box,color=red];
		2699 -> 2702;
	2700 [label="그에게 편지를 써보는 건 어때.",shape=box,color=red];
		2700 -> 2703;
	2701 [label="아서와 얘기해 봐. 그는 처음부터 너와 함께 이 슬픔을 겪어온 사람이잖아.",shape=box,color=red];
		2701 -> 2704;
	2702 [label="레티?",shape=box,color=blue];
		2702 -> 2705;
	2703 [label="한편으로는 그게 멍청한 짓이라 생각되지만. 그는 읽지 않을 거야. 죽었으니까. 하지만...",shape=box,color=blue];
		2703 -> 2706;
	2704 [label="응, 맞아. 어쩌면 그게 문제일 수도 있어. 나는 그가 내가 올해 우리의 작은 추모식을 지키지 않은 것에 화가 났다는 걸 알고 있거든.",shape=box,color=blue];
		2704 -> 2707;
	2705 [label="왜 하필?",shape=box,color=blue];
		2705 -> 2708;
	2706 [label="... 생각해 보니까, 그게 멍청한 짓이 아닐 수도 있겠다는 생각이 드네.",shape=box,color=blue];
		2706 -> 2710;
	2707 [label="나... 이번에는 내 방식대로 크리스토퍼에게 작별 인사를 해봐야겠어. 마지막으로 한 번만.",shape=box,color=blue];
		2707 -> 2711;
	2708 [label="걔는 많은 경험이 있지. 죽은 자를 추모하는 것까지 모든 걸 알고 있어.",shape=box,color=red];
		2708 -> 2709;
	2710 [label="그래. 해 보지 뭐. 그에게 할 말이 많아. 그가 살아 있을 때는 한 번도 하지 못했던 말. 그러고 나면 아마도 그는 쉴 수 있게 될지도 몰라.",shape=box,color=blue];
		2710 -> 2712;
	2711 [label="아서에게 있어서 그이는 항상 잃어버린 형제이자, 쓰러진 동료 군인이겠지. 그 애가 알고 이해하는 그 사람에게의 애도란 그런 거야. 하지만 내게는 아니지.",shape=box,color=blue];
		2711 -> 2713;
	2709 [label="네가 정중하게 물어본다면, 그 아이도 널 외면하지 않을 거야.",shape=box,color=red];
		2709 -> 2720;
	2712 [label="들어줘서 고마워. 따뜻한 충고도.",shape=box,color=blue];
		2712 -> 2714;
	2713 [label="더 이상 아서의 방식대로는 할 수 없어. 내 생각에... 내가 아서에게 말하면, 이해해 줄 거야.",shape=box,color=blue];
		2713 -> 2718;
	2720 [label="…",shape=box,color=blue];
		2720 -> 2721;
	2714 [label="+20 Chemistry",color=orange];
		2714 -> 2715;
	2718 [label="+10 Chemistry",color=orange];
		2718 -> 2719;
	2721 [label="그래.",shape=box,color=blue];
		2721 -> 2722;
	2715 [label="이 은혜 절대로 잊지 않을게.",shape=box,color=blue];
		2715 -> 2716;
	2719 [label="고마워.",shape=box,color=blue];
		2719 -> 2717;
	2722 [label="때가 된 거야.",shape=box,color=blue];
		2722 -> 2723;
	2716 [label="Chat ends.",color=orange];
	2717 [label="Chat ends.",color=orange];
	2723 [label="+20 Chemistry",color=orange];
		2723 -> 2724;
	2724 [label="난 아주 많은 것을 내려놓아야 해.",shape=box,color=blue];
		2724 -> 2725;
	2725 [label="레티와 얘기해 볼게. 나보고 꺼지라고 하면, 그러지 뭐. 적어도 노력은 한 거잖아, 그렇지?",shape=box,color=blue];
		2725 -> 2726;
	2726 [label="시도해 보는데 의미가 있다고 봐. 레티는 사람들이 생각하는 것만큼 무정하진 않아.",shape=box,color=red];
		2726 -> 2727;
	2727 [label="내가 장담해. 이렇게 살면서, 매일 하는 일을 하면서, 우리 모두 벽을 쌓아 왔어. 그냥 문을 넣는 걸 잊었을 뿐이야.",shape=box,color=blue];
		2727 -> 2728;
	2728 [label="너의 그 사랑스러운 머리로 내 벽을 두드려줘서 고마워.",shape=box,color=blue];
		2728 -> 2729;
	2729 [label="Chat ends.",color=orange];
}