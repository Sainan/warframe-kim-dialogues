digraph {
	1389 [label="EleanorRank4Convo1 begins.",color=orange];
		1389 -> 1390;
	1390 [label="뭘 좀 물어보려고 하는데 네가 싫어할 수도 있어. 하지만 내 상태를 감안하면 언젠가는 이런 대화를 해야 한다는 걸 너도 알고 있었을 거야.",shape=box,color=blue];
		1390 -> 1391;
	1391 [label="난 널 믿고 좋아해. 그러니 그냥 솔직하게 물어볼게, 괜찮지?",shape=box,color=blue];
		1391 -> 1392;
	1392 [label="사실 내가 물어볼 권리는 없지만, 그래도 알아야겠어.",shape=box,color=blue];
		1392 -> 1393;
	1393 [label="만약 내가 완전히 돌아선다면, 테크병이 날 덮쳐서 내가 더 이상 네가 알고 있던 엘레노어가 아니라면 날 죽일 건가?",shape=box,color=blue];
		1393 -> 1394;
		1393 -> 1395;
		1393 -> 1396;
		1393 -> 1397;
	1394 [label="내가 그러길 바래?",shape=box,color=red];
		1394 -> 1398;
	1395 [label="당연하지.",shape=box,color=red];
		1395 -> 1399;
	1396 [label="절대로.",shape=box,color=red];
		1396 -> 1400;
	1397 [label="난 대답하지 않을래.",shape=box,color=red];
		1397 -> 1401;
	1398 [label="흠. 시작이 좋아. 너는 내 삶을 네 개인적인 도덕성을 과시할 기회로 보는 대신 내가 원하는 것을 이루게 해주었지. 이게 그저 너에 대한 것이 아니라는 걸 말해줘.",shape=box,color=blue];
		1398 -> 1402;
	1399 [label="와우. 놀랍군.",shape=box,color=blue];
		1399 -> 1403;
	1400 [label="그래. 음.",shape=box,color=blue];
		1400 -> 1404;
	1401 [label="뭐 마음대로.",shape=box,color=blue];
		1401 -> 1405;
	1402 [label="드문 일이야.",shape=box,color=blue];
		1402 -> 1406;
	1403 [label="주저함도, 어려움도 없이, 바로 그렇다고 대답하다니.",shape=box,color=blue];
		1403 -> 1407;
	1404 [label="미안. 사실 좀 당황스럽네. 네가 그렇게 솔직하게 말해 줄 줄은 몰랐거든.",shape=box,color=blue];
		1404 -> 1408;
	1405 [label="나도 다시는 묻지 않을게.",shape=box,color=blue];
		1405 -> 1409;
	1406 [label="불행히도 그게 내 마음을 바꿀 수 없다는 걸 의미하니까 우리의 딜레마에서 벗어나게 해주지는 못할 거야.",shape=box,color=blue];
		1406 -> 1410;
	1407 [label="고맙네. 너는 여러모로 나에게 수수께끼 같은 존재이지만, 이제 네가 내 머리에 총알을 기꺼이 박아줄 의향이 있다는 걸 알게 되었으니, 그리고 이런 유의 일은 일터에서는 매우 중요하기도 하니까.",shape=box,color=blue];
		1407 -> 1411;
	1408 [label="그 괴물을 그냥 살려두는 거야?",shape=box,color=blue];
		1408 -> 1412;
	1409 [label="그런 일이 일어날 때까지 기다렸다가 네가 어떻게 하는지 봐야 되겠는걸?",shape=box,color=blue];
		1409 -> 1413;
	1410 [label="내가 그렇다고 가정해 보지. 나는 네가 탐욕스러운 괴물로 계속 사는 걸 원치 않을 테니 날 빨리 처리해 주길 바라겠지. 그게 지금은 엘레노어가 원하는 거라고 해두자고.",shape=box,color=blue];
		1410 -> 1414;
	1411 [label="그리고 방금 내 세포 속의 테크병이 불안하게 몸을 떠는 게 느껴졌어.",shape=box,color=blue];
		1411 -> 1415;
	1412 [label="미안, 미안. 난 매일 레티가 내 귀에 대고 내가 여기 있을 자격이 없다고 떠드는 걸 들으며 살았고 아서는 마치 내가 쓸모없는 사람인 양 쳐다보면서 그가 그 일을 할 때까지 날짜만 세고 있었는데, 네가 그렇게 얘기해 줄줄 몰랐거든.",shape=box,color=blue];
		1412 -> 1422;
	1413 [label="넌 도무지 알 수 없는 존재라니까.",shape=box,color=blue];
		1413 -> 1417;
	1414 [label="하지만 그 탐욕스러운 괴물이 나라면, 더 그럴까? 만약, 내 인간성이 테크병 도가니 속에서 타버렸고, 죽고 싶지 않다면?",shape=box,color=blue];
		1414 -> 1424;
	1415 [label="이제부터는 좀 더 신중히 행동해야겠어. 숙주에게 솔에 대한 공포를 기생충에게 심어달라고 위협하는 것만큼 좋은 건 없을 테니까, 어?",shape=box,color=blue];
		1415 -> 1418;
	1422 [label="+20 Chemistry",color=orange];
		1422 -> 1416;
	1417 [label="나도 그래.",shape=box,color=blue];
		1417 -> 1420;
	1424 [label="왜나하면 내가 살아있는 것처럼 느껴지기 때문이야, 드리프터. 강력하게 살아있어.",shape=box,color=blue];
		1424 -> 1425;
		1424 -> 1426;
		1424 -> 1427;
		1424 -> 1428;
	1418 [label="Update boolean EleanorNoDate",color=orange];
		1418 -> 1419;
	1416 [label="울고 있어. 하지만 행복의 눈물이야. 다시 얘기하자. 부탁이야.",shape=box,color=blue];
		1416 -> 1423;
	1420 [label="Update boolean EleanorNoDate",color=orange];
		1420 -> 1421;
	1425 [label="나라도 그랬을 거야.",shape=box,color=red];
		1425 -> 1429;
	1426 [label="요점은 맞아. 하지만 그러지 않을 거야.",shape=box,color=red];
		1426 -> 1430;
	1427 [label="그건 얼마나 많은 사람들이 위험에 처해 있는지에 따라 달라지겠지.",shape=box,color=red];
		1427 -> 1431;
	1428 [label="내 질문에 답하지 않았어. 내가 대답해 볼까?",shape=box,color=red];
		1428 -> 1432;
	1419 [label="Chat ends.",color=orange];
	1423 [label="Chat ends. Next chat will be EleanorMonster.",color=orange];
	1421 [label="Chat ends.",color=orange];
	1429 [label="좋아. 그래서 우리는 행복하고 힘 있는 엘레노어를 예전처럼 엘레노어의 제단 위에서 희생시키는 거로군?",shape=box,color=blue];
		1429 -> 1433;
	1430 [label="오, 그러면 이제 내가 할 건 너를 향해 내 크고 아름다운 눈을 깜빡이며 너의 결심을 무너지게 하면 되는 거구나?",shape=box,color=blue];
		1430 -> 1434;
	1431 [label="아. 그러네. 이 시나리오에서는, 나는 아마도 무자비하게 사람들을 학살하는 비인간적인 괴물이겠지. 너는 나를 광견병 걸린 개와 배고픈 곰 같은 것들과 함께 '육식하는 동물' 카테고리에 넣을 수 있으니, 도덕적 딜레마가 없다는 걸 의미하고.",shape=box,color=blue];
		1431 -> 1435;
	1432 [label="... 모르겠어. 어떤 날은 그렇게도 생각해. 멜로드라마에 나오는 주인공 같은 기분이랄까.",shape=box,color=blue];
		1432 -> 1436;
	1433 [label="난 살기로 결정하고 마음을 바꿀 수 있지만, 넌 그럴 수 없는 거야?",shape=box,color=blue];
		1433 -> 1442;
	1434 [label="그렇다면 너는 어떤 두려움이 없는 뱀파이어 사냥꾼이 되고 싶은 거니?",shape=box,color=blue];
		1434 -> 1443;
	1435 [label="그러니 말해줘.",shape=box,color=blue];
		1435 -> 1438;
	1436 [label="\"오 이런, 우리가 사랑했던 불운한 소녀가 섹시한 뱀파이어가 되었어. 그녀를 다시 죽여서 그 죽음으로 그녀가 다시 순수하고 순결하게 되도록 해주자.\"",shape=box,color=blue];
		1436 -> 1437;
	1442 [label="놀라지 말아야지. 이게 네가 준비한 이야기의 결말이니까.",shape=box,color=blue];
		1442 -> 1444;
	1443 [label="내가 말해줄게. 너는 영화 중간에 죽어버리는 그런 사람이 되는 거야. 그들은 해야 할 일을 할 마음이 없는 사람들이기 때문이지.",shape=box,color=blue];
		1443 -> 1445;
	1438 [label="내가 첫 번째 희생자를 내기 전까지는 기다리는 거니, 내 머리통을 박살 내기 전에?",shape=box,color=blue];
		1438 -> 1439;
	1437 [label="Update boolean EleanorArthurNightmare",color=orange];
		1437 -> 1441;
	1444 [label="\"오 이런, 우리가 사랑했던 불운한 소녀가 섹시한 뱀파이어가 되었어. 그녀를 다시 죽여서 그 죽음으로 그녀가 다시 순수하고 순결하게 되도록 해주자.\"",shape=box,color=blue];
		1444 -> 1448;
	1445 [label="너는 이제 다른 사람들에게 경계해야 할 사람이 되는 거야, 그렇게 되는 거라고!",shape=box,color=blue];
		1445 -> 1446;
	1439 [label="네가 그러지 않으면, 내가 위험한 사람이라고 어떻게 확신할 수 있지?",shape=box,color=blue];
		1439 -> 1440;
	1441 [label="사실, 난 그것에 집착했어. 악몽을 꾸었지. 소파에서 깨어나니 아서가 내 위에 서서, 눈물을 흘리며 손에는 칼을 들고 있고, 엘레노어가 본인의 누이었지만 이제는 사라졌고, 그가 죽어가고 있음에는 그렇게 할 수밖에 없다고 말을 하던, 흑흑.",shape=box,color=blue];
		1441 -> 1450;
	1448 [label="Update boolean EleanorArthurNightmare",color=orange];
		1448 -> 1449;
	1446 [label="미안. 내가 공정하지 못했어. 다시 얘기해.",shape=box,color=blue];
		1446 -> 1447;
	1440 [label="Chat ends.",color=orange];
	1450 [label="그리고 아서가 내 갈비뼈 사이로 칼날을 들이밀었을 때 나는 \"엘레노어는 여기 있다고, 이 멍청한 새끼야!\"라고 소리쳤지만, 그는 더 이상 내 말을 들을 수 없었지.",shape=box,color=blue];
		1450 -> 1451;
	1449 [label="사실, 난 그것에 집착했어. 악몽을 꾸었지. 소파에서 깨어나니 아서가 내 위에 서서, 눈물을 흘리며 손에는 칼을 들고 있고, 엘레노어가 본인의 누이었지만 이제는 사라졌고, 그가 죽어가고 있음에는 그렇게 할 수밖에 없다고 말을 하던, 흑흑.",shape=box,color=blue];
		1449 -> 1455;
	1447 [label="Chat ends.",color=orange];
	1451 [label="내가 듣기로, 넌 이 문제를 미리 결정하고 싶어 하지 않는다는군.",shape=box,color=red];
		1451 -> 1452;
	1455 [label="그리고 아서가 내 갈비뼈 사이로 칼날을 들이밀었을 때 나는 \"엘레노어는 여기 있다고, 이 멍청한 새끼야!\"라고 소리쳤지만, 그는 더 이상 내 말을 들을 수 없었지.",shape=box,color=blue];
		1455 -> 1456;
	1452 [label="그런 경우에, 나에게도 기대할 수 없지.",shape=box,color=red];
		1452 -> 1453;
	1456 [label="어쩌면 난 다음에 네 꿈을 꾸게 될지도 모르겠네.",shape=box,color=blue];
		1456 -> 1457;
	1453 [label="+20 Chemistry",color=orange];
		1453 -> 1454;
