	3319 [label="이 점에 대해서 유일하게 짜증 나는 점은 이 사실을 네 머릿속에서 발견했다는 거야.",shape=box,color=blue];
		3319 -> 3320;
	3317 [label="Chat ends.",color=orange];
	3320 [label="네가 정중하게 허락을 구할 생각이 없었다는 건 아니지만. 안녕.",shape=box,color=blue];
		3320 -> 3321;
	3321 [label="거기에 대한 대답은 투덜거리며 팔짱을 끼고 \"그래 물론이지\"라고 대답하겠지만, 나는 여기 앉아서 네 환상 속에서 봤던 아름다운 존재와 즐겁게 지내는 모습을 엿보고 싶은 충동을 억누를 수밖에 없었어.",shape=box,color=blue];
		3321 -> 3322;
	3322 [label="내가 이 시공간에 갇혀 있는 것처럼, 그건 이제 내 환상 속에 있는 거니까. 그거참 대단히 감-사-합-니-다!",shape=box,color=blue];
		3322 -> 3323;
	3323 [label="미안. 사실 동의를 구하려고 온 거야. 이 얘기가 전에는 논의한 적 없는 주제라는 거 알고 있어. 네가 모든 걸 괜찮게 받아들이는지 알고 싶었어.",shape=box,color=red];
		3323 -> 3324;
	3324 [label="물론 괜찮고말고! 네 마음속에서 그 존재의 모습이 그려져. 그 상대방을 믿는다면, 나도 그 존재를 믿어.",shape=box,color=blue];
		3324 -> 3325;
	3325 [label="직접 만날 수 없다는 점이 조금 슬프네.",shape=box,color=blue];
		3325 -> 3326;
	3326 [label="+20 Chemistry",color=orange];
		3326 -> 3327;
