	j1282722120 [label="이 점에 대해서 유일하게 짜증 나는 점은 이 사실을 네 머릿속에서 발견했다는 거야.",shape=box,color=blue];
		j1282722120 -> j52530064;
	j52530064 [label="네가 정중하게 허락을 구할 생각이 없었다는 건 아니지만. 안녕.",shape=box,color=blue];
		j52530064 -> j831822375;
	j831822375 [label="거기에 대한 대답은 투덜거리며 팔짱을 끼고 \"그래 물론이지\"라고 대답하겠지만, 나는 여기 앉아서 네 환상 속에서 봤던 아름다운 존재와 즐겁게 지내는 모습을 엿보고 싶은 충동을 억누를 수밖에 없었어.",shape=box,color=blue];
		j831822375 -> j575864119;
	j575864119 [label="내가 이 시공간에 갇혀 있는 것처럼, 그건 이제 내 환상 속에 있는 거니까. 그거참 대단히 감-사-합-니-다!",shape=box,color=blue];
		j575864119 -> j306509487;
	j306509487 [label="미안. 사실 동의를 구하려고 온 거야. 이 얘기가 전에는 논의한 적 없는 주제라는 거 알고 있어. 네가 모든 걸 괜찮게 받아들이는지 알고 싶었어.",shape=box,color=red];
		j306509487 -> j4160317397;
	j4160317397 [label="물론 괜찮고말고! 네 마음속에서 그 존재의 모습이 그려져. 그 상대방을 믿는다면, 나도 그 존재를 믿어.",shape=box,color=blue];
		j4160317397 -> j2275998756;
	j2275998756 [label="직접 만날 수 없다는 점이 조금 슬프네.",shape=box,color=blue];
		j2275998756 -> j1386100022;
	j1386100022 [label="+20 Chemistry",color=orange];
		j1386100022 -> j4170966673;
	j4170966673 [label="어쩌면 널 통해 간접적으로라도 알 수 있을지도 모른다는 생각이 들지만 말이야.",shape=box,color=blue];
		j4170966673 -> j298331240;
	j298331240 [label="Boolean EleanorConsentComplete is now true.",color=orange];
		j298331240 -> "Chat ends.";
