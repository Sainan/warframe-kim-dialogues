digraph {
	1333 [label="EleanorRank3Convo6 begins.",color=orange];
		1333 -> 1334;
	1334 [label="스칼드라가 홀바니아를 장악하기 전 가장 좋은 점이 무엇이었는지 알아?",shape=box,color=blue];
		1334 -> 1335;
		1334 -> 1336;
		1334 -> 1337;
		1334 -> 1338;
		1334 -> 1339;
	1335 [label="밤놀이?",shape=box,color=red];
		1335 -> 1342;
	1336 [label="지하 격투장?",shape=box,color=red];
		1336 -> 1343;
	1337 [label="쇼핑?",shape=box,color=red];
		1337 -> 1344;
	1338 [label="잘 모르겠는데.",shape=box,color=red];
		1338 -> 1345;
	1339 [label="관심 없어. [종료.]",shape=box,color=red];
		1339 -> 1340;
	1342 [label="이런 세상에. 수술로 아름다워진 사람들이 검증되지 않은 약물로 완벽한 얼굴을 하고 있는 거? 아니.",shape=box,color=blue];
		1342 -> 1346;
	1343 [label="봐. 나는 땀에 젖은 사람들이 서로를 격렬하게 때리는 걸 보는 걸 반대하지는 않아. 하지만 아니야.",shape=box,color=blue];
		1343 -> 1346;
	1344 [label="그럴듯한데. 브레슬린 핸드백과 장갑 콤보부터 얼음 위의 인간 눈알까지 무엇이든 얻을 수 있지. 하지만 아니야.",shape=box,color=blue];
		1344 -> 1346;
	1345 [label="그렇지, 넌 물론 전혀 모를 거야. 새로 온 신입이니까.",shape=box,color=blue];
		1345 -> 1346;
	1340 [label="우우.",shape=box,color=blue];
		1340 -> 1341;
	1346 [label="목욕탕!",shape=box,color=blue];
		1346 -> 1347;
	1341 [label="Chat ends.",color=orange];
	1347 [label="네가 있는 곳에도 이런 게 있는지 모르겠네. 사원 같은 데인데, 보통 솔 세트 방이랑 루아 세트가 있어. 공동 또는 개인 수영장에 몸을 담글 수도 있고. 모든 것에서 허브 향이 나고 증기가 나오고 정신을 차리기에는 아주 좋지.",shape=box,color=blue];
		1347 -> 1348;
	1348 [label="홀바니아는 항상 청결을 의식처럼 따르는 매우 중요한 전통을 가지고 있었어. 도시가 온천 위로 지어진 때로 거슬러 올라가는 거 같아.",shape=box,color=blue];
		1348 -> 1349;
	1349 [label="빅토르 입에서 나온 그 모든 '순수한' 헛소리는 뭐지? 옛날식의 노래를 부르고 있었거든. 그래서 모든 시민들이 그가 어디서 왔는지 다 알아.",shape=box,color=blue];
		1349 -> 1350;
	1350 [label="나는 추가의 홀러를 지불하고 근육 전문가가 내 근육의 긴장을 풀어주는 걸 좋아하곤 했어. 아마 너도 좋아했을 거야, 확신해.",shape=box,color=blue];
		1350 -> 1351;
		1350 -> 1352;
		1350 -> 1353;
	1351 [label="잘 모르겠네.",shape=box,color=red];
		1351 -> 1354;
	1352 [label="내가 좋아할 만한 거 같네.",shape=box,color=red];
		1352 -> 1357;
	1353 [label="그건 어떻게 됐는데?",shape=box,color=red];
		1353 -> 1359;
	1354 [label="넌 감염된 인간의 몸으로 만든 수트는 입지만, 마사지는 거부하는 건가?",shape=box,color=blue];
		1354 -> 1355;
	1357 [label="나랑 비슷한 결의 팀원일 거라 생각했어.",shape=box,color=blue];
		1357 -> 1358;
	1359 [label="아마 짐작할 수 있을걸. 테크병은 너무 많은 것을 파괴했어. 발병 후에도 목욕탕을 계속 유지할 수 있는 방법은 없었거든.",shape=box,color=blue];
		1359 -> 1360;
	1355 [label="이상하군.",shape=box,color=blue];
		1355 -> 1356;
	1358 [label="다른 사람들도 좀 덜 불안해하면 좋을 텐데. 안타깝게도, 발병 후에도 목욕탕을 계속 유지할 수 있는 방법은 없었거든.",shape=box,color=blue];
		1358 -> 1360;
	1360 [label="내가 본 바로는, 그중 일부는 현재 그냥 산란 웅덩이더라고. 솔직히, 너무 속상하더라. 천 년 된 대리석과 모자이크 바닥을 위로 소름 끼치는 살육들이 깔려 있던 걸 발견했던 게 기억나.",shape=box,color=blue];
		1360 -> 1361;
	1356 [label="Chat ends.",color=orange];
	1361 [label="네 시대에도 그런 게 있었어?",shape=box,color=blue];
		1361 -> 1362;
	1362 [label="성스러운 공중 목욕탕? 아니, 그런 건 없었을걸.",shape=box,color=red];
		1362 -> 1363;
	1363 [label="그럼 사람들은 스트레스를 풀기 위해 어떤 걸 해?",shape=box,color=blue];
		1363 -> 1364;
		1363 -> 1365;
		1363 -> 1366;
	1364 [label="라툼이란 게 있어.",shape=box,color=red];
		1364 -> 1367;
	1365 [label="어떤 사람들은 인덱스에 돈을 걸더라.",shape=box,color=red];
		1365 -> 1368;
	1366 [label="코미는 꽤 오랫동안 해왔지.",shape=box,color=red];
		1366 -> 1369;
	1367 [label="아미르가 혼자서 효과음을 내는 소리 같네...",shape=box,color=blue];
		1367 -> 1370;
	1368 [label="주식 중개인 같은 거?",shape=box,color=blue];
		1368 -> 1371;
	1369 [label="코미? 흑백 카운터? 솔과 루아의 결혼 전쟁 같은?",shape=box,color=blue];
		1369 -> 1372;
	1370 [label="그리니어 게임이야. 전체 시스템에 의식 경기장 전투를 중계하는 거지.",shape=box,color=red];
		1370 -> 1373;
	1371 [label="... 비슷한? 주식 거래와 4인 4조의 폭력이 결합된 거 같아. 이상하게 들릴 수 있다는 거 알아.",shape=box,color=red];
		1371 -> 1374;
	1372 [label="음.. 어? 잠깐, 그게 코미가 상징하는 의미였어?",shape=box,color=red];
		1372 -> 1375;
	1373 [label="그들에게는 엄청난 뒷거래인 셈이지. 아주 치명적인.",shape=box,color=red];
		1373 -> 1376;
	1374 [label="코퍼스는 그것에 완전히 열광하더라고.",shape=box,color=red];
		1374 -> 1377;
	1375 [label="우리는 그저 보드게임이라고만 알고 있는데!",shape=box,color=red];
		1375 -> 1378;
	1376 [label="아빠와 아서는 매주 토요일 밤마다 레슬링을 함께 보곤 했어.",shape=box,color=blue];
		1376 -> 1380;
	1377 [label="하지만 그들은 너의 적이잖아, 아닌가? 아니면 팀 스포츠에 있어서는 일종의 휴전 협정 같은 게 있는 건가?",shape=box,color=blue];
		1377 -> 1383;
	1378 [label="오로킨은 정말 좋아하더라. 두비리에도 있어.",shape=box,color=red];
		1378 -> 1379;
	1380 [label="+10 Chemistry",color=orange];
		1380 -> 2815;
	1383 [label="+10 Chemistry",color=orange];
		1383 -> 2079;
	1379 [label="그게 그렇게 오래됐는지는 몰랐네.",shape=box,color=red];
		1379 -> 1384;
	2815 [label="기회가 되면, 라툼 테이프를 아미르에게 줘봐. 정말 좋아할 거야.",shape=box,color=blue];
		2815 -> 1381;
	2079 [label="내가 뭔 말하고 있더라? 물론 거기에 포함되어 있겠지. 사람들이란 건 다 원래 그래.",shape=box,color=blue];
		2079 -> 1382;
	1384 [label="오래되었다고? 신성한 거지. 재밌기도 하고. 조합이 멋있지.",shape=box,color=blue];
		1384 -> 1385;
	1381 [label="Chat ends.",color=orange];
	1382 [label="Chat ends.",color=orange];
	1385 [label="모든 것에 본질적인 두 가지 원칙이 있어, 알지? 정신과 몸. 상징과 의미. 솔과 루아.",shape=box,color=blue];
		1385 -> 1387;
	1387 [label="+20 Chemistry",color=orange];
