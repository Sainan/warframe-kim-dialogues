digraph {
	1262 [label="EleanorRank3Convo5 begins.",color=orange];
		1262 -> 1263;
	1263 [label="안녕, 드리프터. 나 화났어.",shape=box,color=blue];
		1263 -> 1266;
		1263 -> 1264;
		1263 -> 1265;
	1266 [label="무엇이 너를 그렇게 화나게 한 거야?",shape=box,color=red];
		1266 -> 1268;
	1264 [label="안녕, 화났어. 난 드리프터야.",shape=box,color=red];
		1264 -> 1269;
	1265 [label="지금은 시간이 없어, 미안. [종료.]",shape=box,color=red];
		1265 -> 1267;
	1268 [label="두 가지야.",shape=box,color=blue];
		1268 -> 1273;
	1269 [label="미래에 이러한 아빠 농담이 나올거야",shape=box,color=blue];
		1269 -> 1271;
	1267 [label="Chat ends.",color=orange];
	1273 [label="와인이 그리워. 진짜 와인을 너무 오랫동안 마셔보지 못했어. 헬바니아의 모든 와인은 질병 발발 후 며칠 만에 스칼드라 지휘관이 싹 수거해 갔거든.",shape=box,color=blue];
		1273 -> 1274;
	1271 [label="+10 Chemistry",color=orange];
		1271 -> 1270;
	1274 [label="퀸시와 아서가 과일 배급 주머니로 감옥 밀조술을 만들어보려 했지만, 여전히 품위가 남아있던 사람들은 거절을 했어. 레티와 단결할 수 있었던 드문 순간이었지.",shape=box,color=blue];
		1274 -> 1275;
	1270 [label="기분이 나아졌어. 고마워.",shape=box,color=blue];
		1270 -> 1272;
	1275 [label="또 하나는, 훨씬 훨씬 더 큰 것, 미래야.",shape=box,color=blue];
		1275 -> 1276;
	1272 [label="Chat ends.",color=orange];
	1276 [label="네 잘못은 아니지만... 네 눈으로 미래를 보고 나니 일반적인 방법으로는 바뀌지 않을 거라는 비참함이 느껴지네.",shape=box,color=blue];
		1276 -> 1277;
		1276 -> 1278;
	1277 [label="내가 어떻게 해야 네 기분이 좋아지려나?",shape=box,color=red];
		1277 -> 1279;
	1278 [label="일반적인 방법?",shape=box,color=red];
		1278 -> 1280;
	1279 [label="글쎄. 색다른 춤?",shape=box,color=blue];
		1279 -> 1281;
	1280 [label="아미르와 함께 저녁을 보내고, 요즘 그가 빠져있는 코믹 시리즈나 레트로 게임에 대해 이야기를 듣는 것.",shape=box,color=blue];
		1280 -> 1282;
	1281 [label="발라스의 죽음에 대해서 나에게 자세히 얘기해 주는 거?",shape=box,color=blue];
		1281 -> 1283;
	1282 [label="레티가 퇴마사를 부를 때까지 크리스털로 나를 둘러싸고 정신적으로 주문을 외우기.",shape=box,color=blue];
		1282 -> 1284;
	1283 [label="그렇게 말해주는 건 고마운데, 이런 우울함은 그냥 감수하는 게 낫겠어.",shape=box,color=blue];
		1283 -> 1286;
	1284 [label="이건 좀 다른 종류의 슬픔이야. 축축한 담요처럼 나를 무겁게 짓누르고 있거든.",shape=box,color=blue];
		1284 -> 1288;
		1284 -> 1289;
	1286 [label="아무래도 내가 그림으로 그려야겠어",shape=box,color=blue];
		1286 -> 1285;
	1288 [label="1999년 홀바니아는 험난했지! 스칼드라, 테크병, 보이드는 뭔가를 알고 있었고. 미래가 정말 그렇게 나빠 보였을까?",shape=box,color=red];
		1288 -> 1290;
	1289 [label="오, 제발... 넌 강해. 견뎌낼 수 있다고. 여기에는 멋진 것들이 아주 많아.",shape=box,color=red];
		1289 -> 1291;
	1285 [label="+5 Chemistry",color=orange];
		1285 -> 1287;
	1290 [label="봐, 나는 공상과학 소설을 별로 좋아하지 않았어. 아서에게는 그런 시절이 있었지만, 항상 거친 군대 이야기를 더 좋아했었지. 남자답게 영웅이 되고, 소년들을 위한 건전한 이야기, 수많은 암시, 난 네가 그런 종류의 것들을 알고 있었을 거라 확신해.",shape=box,color=blue];
		1290 -> 1292;
	1291 [label="좋아. 내 손을 잡고 홀바니아 거리를 걸어줘.",shape=box,color=blue];
		1291 -> 1293;
	1287 [label="Chat ends.",color=orange];
	1292 [label="하지만 나는 공상 과학 소설에 대해 충분히 알고 있었기 때문에, 아주 먼 미래에는 우리가 함께할 수 있을 거라 생각했어. 모든 것이 반짝반짝 빛나고 멸균 상태이고. 로봇이 모든 힘든 일을 하고, 질병도 없고, 돈도 필요하지 않으며, 은빛 탑과 푸른 하늘, 섹시한 도마뱀만 존재하는.",shape=box,color=blue];
		1292 -> 1295;
		1292 -> 1296;
	1293 [label="간 순무로 만든 케이크를 먹으면서 학교 너머로 해지는 모습을 바라볼 수 있는 곳을 알고 있거든.",shape=box,color=blue];
		1293 -> 1294;
	1295 [label="우리에겐 로봇이 있잖아. 그들은 힘든 일을 많이 하지.",shape=box,color=red];
		1295 -> 1298;
	1296 [label="하지만 네가 말하는 건 허구일 뿐이잖아, 안 그래? 아니라면 현실이 그에 부응할 거라고 기대하는 이유는 뭐지?",shape=box,color=red];
		1296 -> 1299;
	1294 [label="그러고는 불타는 탱크 옆에서 칵테일도 마실 수 있어.",shape=box,color=blue];
		1294 -> 1297;
	1298 [label="어, 그래. 맞는 말이야.",shape=box,color=blue];
		1298 -> 1300;
	1299 [label="으악. 나는 말이야... 그게 복잡해. 설명해 줄게.",shape=box,color=blue];
		1299 -> 1301;
	1297 [label="Chat ends.",color=orange];
	1300 [label="하지만 그 로봇들이 평범한 사람들의 삶을 더 쉽게 만들어 줬을까?",shape=box,color=blue];
		1300 -> 1303;
	1301 [label="미래가 어린이 코믹 책처럼 보일 거라고 예상했다는 말이 아니야. 그것과 관련된 낙천주의가 있었다는 뜻이지.",shape=box,color=blue];
		1301 -> 1302;
	1303 [label="아니면 그냥 당연하게 여겨질만한 다른 존재가 되었을까?",shape=box,color=blue];
		1303 -> 1306;
		1303 -> 1307;
	1302 [label="우리 모두가 지금은 아무리 엉망진창이어도 언젠가는 해결될 거라고 당연하게 생각했던 거 같아. 우리 문명은 발전하도록 되어 있어. 처음에는 곤봉으로 서로의 머리를 내리치기 시작했고, 수천 년이 지난 후 그렇게 하지 않고도 서로의 차이점을 해결할 수 있는 방법을 찾았으니까.",shape=box,color=blue];
		1302 -> 1304;
		1302 -> 1305;
	1306 [label="너 그냥 모든 걸 최악으로만 보려고 결심한 거지, 그렇지?",shape=box,color=red];
		1306 -> 1310;
	1307 [label="좋아. 우리는 로봇을 두었다고 해서 착취를 당했던 게 아니야.",shape=box,color=red];
		1307 -> 1311;
	1304 [label="기술이 아무리 발전해도, 사람은 여전히 사람인 거야.",shape=box,color=red];
		1304 -> 1308;
	1305 [label="혹시 우리가 실망시켰다면 미안?",shape=box,color=red];
		1305 -> 1309;
	1310 [label="뻔하지.",shape=box,color=blue];
		1310 -> 1315;
	1311 [label="맞아. 그게 정말 실망스러운 점이야.",shape=box,color=blue];
		1311 -> 1316;
	1308 [label="빙고. 내가 이 모든 것이 우울하다고 생각하는 걸 정확히 짚어줬네.",shape=box,color=blue];
		1308 -> 1313;
	1309 [label="바로 그거야.",shape=box,color=blue];
		1309 -> 1313;
	1315 [label="그래야 무엇을 바꿔야 하는지 알 수 있으니까.",shape=box,color=blue];
		1315 -> 1317;
	1316 [label="너는 진보적이었지만, 깨달음을 얻으려고 했지.",shape=box,color=blue];
		1316 -> 1318;
	1313 [label="너는 이 모든 놀라운, 마법 같은 기술을 네 손끝에 쥐고는 서로를 착취할 새로운 방법을 찾은 것뿐이었어. 과학은 우리를 더 이상 평등하지 않게 만들었거든.",shape=box,color=blue];
		1313 -> 1312;
		1313 -> 1314;
	1317 [label="Chat ends.",color=orange];
	1318 [label="나와 함께해 줘서 고마워. 감당하기엔 많은 거라는 건 나도 알아.",shape=box,color=blue];
		1318 -> 1320;
	1312 [label="흠, 내가 그런 짓을 한 적이 없다는 걸 정중하게 상기시켜 주는 건가?",shape=box,color=red];
		1312 -> 1322;
	1314 [label="네 불만 사항을 오로킨에 전달해 주지.",shape=box,color=red];
		1314 -> 1322;
	1320 [label="+15 Chemistry",color=orange];
		1320 -> 2837;
	1322 [label="이런 제발, 네가 그랬다는 뜻이 아니야. 네 시대를 말하는 거라고.",shape=box,color=blue];
		1322 -> 1323;
	2837 [label="Chat ends.",color=orange];
	1323 [label="만약에 되돌아간 게 있다면. 육체의 신이시여! 다시 발명해야 하는 것들 중에서, 너는 그들을 다시 만들어 낸 거라고.",shape=box,color=blue];
		1323 -> 1324;
	1324 [label="텐노는 오로킨을 죽였어. 그걸 잊은 거야?",shape=box,color=red];
		1324 -> 1325;
	1325 [label="아니. 정서적으로 학대받은 고아들이 불멸의 엘리트를 살해한 걸 난 잊지 않았어. 난 그게 너무 마음에 들어. 눈을 감으면 비명 소리가 들릴 정도거든.",shape=box,color=blue];
		1325 -> 1326;
		1325 -> 1327;
	1326 [label="좋아. 미래는 엉망진창이야. 네가 원한다면 그것에 집중할 수 있어.",shape=box,color=red];
		1326 -> 1328;
	1327 [label="그건... 내가... 사람들에게 인정받기 위해 조심해야 하는 거네.",shape=box,color=red];
		1327 -> 1329;
	1328 [label="난 더 나은 것을 만들기 위해 노력하는 사람들과 함께야.",shape=box,color=red];
		1328 -> 1330;
	1329 [label="... 빈정대는 건 미래에도 쓸모가 없는 건가?",shape=box,color=blue];
		1329 -> 1331;
	1330 [label="+20 Chemistry",color=orange];
		1330 -> 1332;
	1331 [label="Chat ends.",color=orange];
