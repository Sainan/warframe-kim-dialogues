		686 -> 688 [label=false,color=brown];
	679 [label="너 말야 -",shape=box,color=blue];
		679 -> 680;
	687 [label="세상에나. 미안. 허튼 소리 좀 해봤어.",shape=box,color=blue];
		687 -> 688;
	688 [label="다시 해볼게.",shape=box,color=blue];
		688 -> 689;
	680 [label="네가 시작했잖아...",shape=box,color=blue];
		680 -> 681;
	689 [label="저널리스트는 세상에서 일어나는 흥미로운 일들을 추적해서 글을 쓰거나 방송을 통해 다른 사람들에게 이야기 해 주는 사람이야.",shape=box,color=blue];
		689 -> 690;
	681 [label="그 혼란스러운 생명체...",shape=box,color=blue];
		681 -> 682;
	690 [label="스토리텔러라고 해야 하나. 뭔가를 만들어내는 건 아니고.",shape=box,color=blue];
		690 -> 691;
		690 -> 692;
	682 [label="Chat ends.",color=orange];
	691 [label="그렇다면 무엇이 이야기를 '흥미롭게' 만드는 걸까?",shape=box,color=red];
		691 -> 693;
	692 [label="그럼 너는 사실만 얘기해? 어떤 사실을 말할지 어떻게 골라?",shape=box,color=red];
		692 -> 693;
	693 [label="대부분의 경우, 사람들은 세상에서 일어나는 나쁜 일에만 흥미를 가지지. 피는 피를 부른다는 옛말처럼.",shape=box,color=blue];
		693 -> 694;
	694 [label="난 네가 사는 시간에도 상황이 다를 거라 생각하지 않는데.",shape=box,color=blue];
		694 -> 695;
	695 [label="나는 내 일을 통해 변화를 주고 싶었어. 그래, 돈은 받고 있었지만, 세상에 좋은 일을 하고 싶었던 거지.",shape=box,color=blue];
		695 -> 696;
	696 [label="Check boolean EleanorHatesHeroes",color=orange];
		696 -> 697 [label=true,color=green];
		696 -> 698 [label=false,color=brown];
	697 [label="물론 그때는 내가 더 어렸었지. '세상에서 좋은 일을 하고 싶다'라는 의지를 꺽으려면 거기서 시간을 보내는 것보다 좋은 건 없거든.",shape=box,color=blue];
		697 -> 699;
	698 [label="여기가 나를 데려온 데야. 진짜로. 내가 처음에 홀바니아로 오게 된 이유는 그 이야기 때문이거든.",shape=box,color=blue];
		698 -> 700;
	699 [label="미안. 얘기가 옆길로 샜네. 싫은 소리 좀 할게. 내가 펫을 싫어하는 것에 대해 내 얘기 좀 들어볼래?",shape=box,color=blue];
		699 -> 701;
		699 -> 702;
	700 [label="난 네가 아서 때문에 온 줄 알았어.",shape=box,color=red];
		700 -> 705;
	701 [label="물론, 안될 거 없지.",shape=box,color=red];
		701 -> 704;
	702 [label="아니, 싫은데. [종료.]",shape=box,color=red];
		702 -> 703;
	705 [label="아, 그가 여기에 먼저 오긴 했지. 하지만 그는 내게 여기서 무슨 일이 일어나고 있는지 말해주는 실수를 했고, 난 그냥 마냥 기다릴 수만은 없었어. 그래서 내 오랜 친구인 대니 멕일보이에게 전화해 엄청난 돈을 주고 위조된 비자와 여권을 구했지. 그것들이 급하게 필요해서.",shape=box,color=blue];
		705 -> 706;
	704 [label="좋아. 난 이미 경고했으니 나중에 딴소리 마. 나에게는 영웅 바이러스라고 부르는 학설이 있어.",shape=box,color=blue];
		704 -> 707;
	703 [label="Chat ends.",color=orange];
	706 [label="여기서 네가 이해해야 할 게 있어. 그들이 홀바니아를 봉쇄하긴 했지만, 한 번에 다 할 수는 없었지. 이곳은 광명의 칸 시대부터 존재해 온 벽으로 둘러싸인 도시 국가이지만, 그녀를 막기 위해 세운 성벽은 너무 낡았고 담당 권력자들은 바리케이드와 검문소를 제때 세울 수 없었거든.",shape=box,color=blue];
		706 -> 708;
	707 [label="이야기를 통해 전염되는 바이러스가 있다고 잠시 상상해 봐. 모든 바이러스와 마찬가지로 숙주를 장악하고 더 멀리 퍼지고 싶어 하지.",shape=box,color=blue];
		707 -> 709;
	708 [label="사람들은 빠져나가려고 서로 걸려 넘어지기 일쑤였고, 그래서 아무도 이곳에 들어오려고 하는 멍청한 브리타니아인 소녀에게는 관심이 없었지.",shape=box,color=blue];
		708 -> 710;
	709 [label="영웅 바이러스는 세상을 마치 이야기처럼 보이게 해. 좋은 건 개개인이 멋진 일을 하는 거라고 속삭이거든.",shape=box,color=blue];
		709 -> 711;
	710 [label="여기서 최악인 걸 얘기해 줄까?",shape=box,color=blue];
		710 -> 712;
		710 -> 713;
	711 [label="그래서 넌 자연스럽게 그런 사람이 되고 싶어 하지.",shape=box,color=blue];
		711 -> 720;
	712 [label="어 말해줘.",shape=box,color=red];
		712 -> 717;
	713 [label="징그러운 얘기야?",shape=box,color=red];
		713 -> 714;
	720 [label="그게 아무리 힘들 지어도.",shape=box,color=blue];
		720 -> 721;
	717 [label="좋아. 여기서 최악이었던 건.",shape=box,color=blue];
		717 -> 718;
	714 [label="오, 갑자기 비위라도 약해지신 건가?",shape=box,color=blue];
		714 -> 715;
	721 [label="영웅은 어려운 결정을 내려야 하기 때문이야. 영웅은 고통을 꿋꿋이 견뎌내야 하니까.",shape=box,color=blue];
		721 -> 722;
	718 [label="나는 테스투도 증후군이라고 질병에 대해 조사 중이었어. 테스투도는 거북이를 의미하는데, 이 증후군을 앓는 사람들은 초기 증상으로 피부에 딱딱한 반점이 생긴대. 결과적으로 갑옷 도금으로 변하는 것과 같은 종류의 것은 우리처럼 운이 좋은 몇 명뿐이었고.",shape=box,color=blue];
		718 -> 719;
	715 [label="네 우아한 감정을 상하게 했다면 미안해. 그만 두자고, 그럼.",shape=box,color=blue];
		715 -> 716;
	722 [label="근데 모두 다 헛소리야. 영웅 바이러스는 장난감을 팔고, 영화를 만들고 어린 소년 소녀들이 기꺼이 총알받이가 되도록 만들기 위함일 뿐이거든.",shape=box,color=blue];
		722 -> 723;
	719 [label="테스투도 증후군은 홀바니아에만 있는 것으로 확인되는 치료 저항성 질환이었는데, 컴퓨터와 불가사의하고 불길한 연관성이 있는 거 같았고, 한꺼번에 나타났어. 그리고 그것에 대해 너무 많은 질문은 한 사람들은 홀바니아 하수구에 처박히곤 했어.",shape=box,color=blue];
		719 -> 724;
	716 [label="Chat ends.",color=orange];
	723 [label="요양원에서 늙은이들의 엉덩이를 닦아주는 것이 영웅적인 것이라 생각하는 자들에 대한 영화는 만들지 않아.",shape=box,color=blue];
		723 -> 725;
	724 [label="홀바니아에 도착한 지 몇 시간 만에 나는 하수구를 뚫고 가서 지금껏 경험하지 못했던 가장 큰 감정적 격변을 겪고 있는 아서를 달래주어야 했어.",shape=box,color=blue];
		724 -> 726;
	725 [label="거의 끝나가, 나랑 있어줘.",shape=box,color=blue];
		725 -> 727;
	726 [label="그 자식. 넌 아마 내가 걔를 화나게 하려고 여기까지 따라왔다고 생각하겠지.",shape=box,color=blue];
		726 -> 728;
		726 -> 729;
		726 -> 730;
	727 [label="영웅 바이러스는 주목을 받으면 가장 좋은 일을 할 수 있다고 속이는 거야. 불가능하고 잘못된 예를 보여주는 거지.",shape=box,color=blue];
		727 -> 733;
	728 [label="난 네가 그 상황을 진지하게 받아들이지 않은 거 같은데.",shape=box,color=red];
		728 -> 735;
	729 [label="그냥 그랬다고 인정해.",shape=box,color=red];
		729 -> 736;
	730 [label="아니, 하지만 그건 보너스*였던 거* 아냐?",shape=box,color=red];
		730 -> 737;
	733 [label="+15 Chemistry",color=orange];
		733 -> 731;
	735 [label="아 물론 진지하게 받아들였지.",shape=box,color=blue];
		735 -> 738;
	736 [label="물론 그랬어. 하지만 다른 고귀한 목적 또한 염두에 두고 있었어.",shape=box,color=blue];
		736 -> 739;
	737 [label="정확해. 하지만 다른 고귀한 목적 또한 염두에 두고 있었어.",shape=box,color=blue];
		737 -> 739;
	731 [label="아서는 테크병으로 나를 잃었다 생각하지만, 사실 나는 오래전에 그를 영웅 바이러스에게 빼앗긴 거야.",shape=box,color=blue];
		731 -> 732;
	738 [label="사람들이 날 죽이려고 했어. 이런 거에 별난 유머 감각을 지닌 걸 용서해 줘.",shape=box,color=blue];
		738 -> 740;
	739 [label="'고귀한.' 솔의 공. 내게 일어난 모든 일은 다 그럴 법 했어, 안 그래?",shape=box,color=blue];
		739 -> 741;
		739 -> 742;
	732 [label="Update boolean EleanorHeroVirus",color=orange];
		732 -> 734;
	740 [label="아마도 네가 너무 오랫동안 혼자여서 모를 수도 있는데, 이런 옷을 입고, 서로를 놀리는 게 우리의 정신 건강에 도움이 되기도 해.",shape=box,color=blue];
		740 -> 745;
	741 [label="넌 나에게 최악인 부분을 얘기하던 중이었어.",shape=box,color=red];
		741 -> 743;
	742 [label="넌 그저 네가 해야 할 일을 한거 같은데. 그다음에는?",shape=box,color=red];
		742 -> 744;
	734 [label="Chat ends.",color=orange];
	745 [label="그게 때로는, 뼈가 사무칠 정도로 느껴질 때가 있는데, 특히 레티가 우울증에 빠지면 미워할 누군가가 필요해지거든.",shape=box,color=blue];
		745 -> 746;
	743 [label="아, 맞다.",shape=box,color=blue];
		743 -> 744;
	744 [label="그래서 내가 하수구에 있는데, 머리 대신 CRT 모니터 뭉텅이 같은 게 비틀거리면서 지나가는 거야. 그 둥지 같은 걸 찾았을 때는 난 나 자신을 거의 죽일 뻔했어.",shape=box,color=blue];
		744 -> 749;
	746 [label="하지만 제발, 우리 모두를 위해서 조금 기운을 내봐.",shape=box,color=blue];
		746 -> 747;
	749 [label="증식. 일부는 유기적이고, 일부는 기술적이고, 일부는 불쌍한 개자식의 섬망증 같은. 사람들이 유독 가스를 너무 많이 흡입했을 때만 볼 수 있는 색깔의 빛. 끔찍해서 눈을 뗄 수가 없었지.",shape=box,color=blue];
		749 -> 750;
	747 [label="아서도 가끔은 맥주캔을 따고 쉰다고.",shape=box,color=blue];
		747 -> 748;
	750 [label="잭팟이 따로 없었지.",shape=box,color=blue];
		750 -> 751;
		750 -> 752;
	748 [label="Chat ends.",color=orange];
	751 [label="오 이런...",shape=box,color=red];
		751 -> 754;
	752 [label="거기 있지 않았다고 말해줘.",shape=box,color=red];
		752 -> 753;
	754 [label="내 키네마틱 2300A 슬립 폰으로 흐릿한 사진 12장을 찍어 아서에게 보냈어.",shape=box,color=blue];
		754 -> 755;
	753 [label="당연히 있었지.",shape=box,color=blue];
		753 -> 754;
	755 [label="그리고 '테크병이 어디서 왔는지 알 것 같아.'라고 메시지를 보낸 거야.",shape=box,color=blue];
		755 -> 756;
	756 [label="난 다음 날 기사를 올렸어. '홀바니아 거리 아래의 테크병'이라는 제목으로.",shape=box,color=blue];
		756 -> 757;
		756 -> 758;
	757 [label="네가 이름을 지은 거구나.",shape=box,color=red];
		757 -> 759;
	758 [label="그게 거기서 나온 거로구나.",shape=box,color=red];
		758 -> 759;
	759 [label="짜잔! 내가 이름 지었어.",shape=box,color=blue];
		759 -> 760;
	760 [label="그게 바로 최악인 부분인 거야.",shape=box,color=blue];
		760 -> 761;
	761 [label="지금은 아무도 그것을 '테스투도 증후군'이라고 부르지 않아. 아무도 테크노사이트라고 부르지 않아. 모두가 테크병이라고 불러.",shape=box,color=blue];
		761 -> 762;
	762 [label="이 도시를 먹어치우고 나의 뼈까지 갉아먹는 이 괴물의 이름을 내가 지은 거라고.",shape=box,color=blue];
		762 -> 763;
	763 [label="Update boolean EleanorHollTold",color=orange];
		763 -> 764;
		763 -> 765;
	764 [label="바보 같은 게임을 하고, 바보 같은 상을 받은 거네?",shape=box,color=red];
		764 -> 766;
	765 [label="그게 뭐가 나쁜데? 그 이름 딱인데.",shape=box,color=red];
		765 -> 778;
	766 [label="미안. 어떤 이유에서인지 네가 이해해 줄 거라고 생각했거든. 아니면 적어도 공감해 줄줄 알았어.",shape=box,color=blue];
		766 -> 767;
	778 [label="+20 Chemistry",color=orange];
		778 -> 773;
	767 [label="네 말이 맞아. 다 바보 같은 게임이야.",shape=box,color=blue];
		767 -> 768;
	773 [label="내가 제레미 코니스턴 장관과 가짜 기근 구호, 또는 라즐로 비료 스캔들 등에 대해 한 일에 대해 이야기하는 사람은 아무도 없어. 파문을 일으키지도 않았다고.",shape=box,color=blue];
		773 -> 774;
	768 [label="우리 모두는 멈추지 않는 회전목마에 갇힌 썩어가는 광대 무리일 뿐인 거야.",shape=box,color=blue];
		768 -> 769;
	774 [label="그리고 이제는 모든 사람이 사용하지만 아무도 내가 그걸 생각해 냈다는 것을 몰라.",shape=box,color=blue];
		774 -> 775;
	769 [label="모여봐 모여서 멋진 고르곤 여인을 봐봐. 아이가 너무 가까이 오지는 못하게 해. 오늘 그녀가 밥을 먹지 않았거든.",shape=box,color=blue];
		769 -> 771;
