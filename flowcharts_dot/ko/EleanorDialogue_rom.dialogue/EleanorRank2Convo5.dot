digraph {
	673 [label="EleanorRank2Convo5 begins.",color=orange];
		673 -> 674;
	674 [label="안녕, 엘레노어...",shape=box,color=red];
		674 -> 675;
	675 [label="안녕. 무슨 생각하고 있어?",shape=box,color=blue];
		675 -> 683;
		675 -> 676;
