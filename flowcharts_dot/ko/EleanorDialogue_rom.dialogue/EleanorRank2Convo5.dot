		683 -> 684;
	676 [label="뭐 딱히. [종료.]",shape=box,color=red];
		676 -> 677;
	684 [label="다른 사람의 트라우마를 돈으로 바꾸는 직업이지.",shape=box,color=blue];
		684 -> 685;
