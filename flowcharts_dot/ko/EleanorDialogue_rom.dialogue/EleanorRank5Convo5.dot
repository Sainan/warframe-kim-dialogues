		2513 -> 2515;
	2514 [label="이게 어디로 가는지 알 것도 같네.",shape=box,color=red];
		2514 -> 2515;
	2515 [label="맞아. 내 방어력이 약해지니까, 나한테 닿을 수도 있지.",shape=box,color=blue];
		2515 -> 2516;
	2516 [label="내 말이 무슨 말인지 알겠지. 가장 원초적인 수준에서 나를 강타하는 거라고. 나를 다시 원하고. 내가 알지 못했던 황홀경을 느끼게 해줄 거라 약속하고.",shape=box,color=blue];
