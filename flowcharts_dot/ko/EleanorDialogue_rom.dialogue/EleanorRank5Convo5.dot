		2510 -> 2511;
	2511 [label="그게 어떤 생각을 가지고 있든 간에, 항상 내 생각과 연결될 수 있어. 그것이 보내는 생각은 항상 너무 조잡하고 약해서 내가 쉽게 막을 수가 있다고.",shape=box,color=blue];
		2511 -> 2512;
	2512 [label="대부분의 경우 마치 내 두개골 뒤를 미친 듯이 긁는 듯한 느낌이야. 마치 화장실에 있을 때 고양이가 문을 열려고 하는 것처럼.",shape=box,color=blue];
		2512 -> 2513;
