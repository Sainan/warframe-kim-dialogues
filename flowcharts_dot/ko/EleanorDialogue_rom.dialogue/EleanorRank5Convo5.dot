		2500 -> 2502;
	2501 [label="그러니까 테크병은 내가 네가 그것으로 돌아가는 걸 막고 있다고 생각하는 거야?",shape=box,color=red];
		2501 -> 2505;
	2503 [label="글쎄, 아마도 내가 완전한 워프레임이었다면 테크병은 나를 이렇게 보지 않았겠지. 지금도 내 세포는 여전히 사그라져 있고, 테크병은 나를 자기 것으로 보고 있으니.",shape=box,color=blue];
		2503 -> 2506;
	2504 [label="요상하지 않아? 버림받은 전 남친이야 뭐야!",shape=box,color=blue];
		2504 -> 2506;
	2502 [label="글쎄, 아마도 내가 완전한 워프레임이었다면 테크병은 나를 이렇게 보지 않았겠지. 지금도 내 세포는 여전히 사그라져 있고, 테크병은 나를 자기 것으로 보고 있으니.",shape=box,color=blue];
		2502 -> 2507;
	2505 [label="어. 그들에게로 다시 돌아오래.",shape=box,color=blue];
		2505 -> 2507;
	2506 [label="내가 온 곳에서는, 아마 동네 슈퍼마켓 뒤편에 가서 싸워야 할 거야. 네 시간에서는 어떨지 모르겠지만.",shape=box,color=blue];
		2506 -> 2508;
	2507 [label="이게 네 진짜 가족이야, 라고 속삭이고 있어. 다시 우리와 함께해 줘, 끊어진 자매여. 받아들여줘.",shape=box,color=blue];
		2507 -> 2508;
	2508 [label="잠깐, 조금 뒤로 물러서봐. 그게 테크병이 느끼는 감정이라는 걸 어떻게 알지?",shape=box,color=red];
