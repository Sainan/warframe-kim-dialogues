		2469 -> 2471 [label=false,color=brown];
	2470 [label="하지만 우리가 함께한 이후 다른 일들이 일어나고 있어. 사실 좀 곤란한 얘기야. 그 문제에 대해 이야기하고 싶었지만, 타이밍이 좋지 않았거든.",shape=box,color=blue];
