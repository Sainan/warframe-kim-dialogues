		2493 -> 2497;
	2496 [label="뭔가 엄청나게 엉망진창이 된 수준에서, 테크병은 나를 자신의 소유물이라 생각해. 나는 그들의 번식 대상이 되도록 만들어졌으니까. 레가사이트는 나는 라이벌 여왕쯤으로 여긴다고.",shape=box,color=blue];
		2496 -> 2498;
		2496 -> 2499;
	2497 [label="뭔가 엄청나게 엉망진창이 된 수준에서, 테크병은 나를 자신의 소유물이라 생각해. 나는 그들의 번식 대상이 되도록 만들어졌으니까. 레가사이트는 나는 라이벌 여왕쯤으로 여긴다고.",shape=box,color=blue];
		2497 -> 2500;
