digraph {
	2845 [label="EleanorRank6Convo2 begins.",color=orange];
		2845 -> 2846;
	2846 [label="안녕, 너한테 아이디어좀 몇 가지 털어놓고 싶은데.",shape=box,color=blue];
		2846 -> 2847;
	2847 [label="핀즈나잇 생각을 하고 있었어. 핀즈나잇용 가장을 안 한지도 벌써 몇 년인데, 아미르네 만화책을 한 권 훑어보고 있다보니 갑자기 이런 생각이 났거든 - 잠깐, 내가 카운테사 가장을 하면 괜찮지 않을까? 날카로운 송곳니도 있고, 다 있잖아!",shape=box,color=blue];
		2847 -> 2848;
	2848 [label="헌데 너무 식상하긴 한가? 차라리 댄디 데미지가 나으려나?",shape=box,color=blue];
		2848 -> 2849;
		2848 -> 2850;
		2848 -> 2851;
	2849 [label="댄디 데미지가 누군데?",shape=box,color=red];
		2849 -> 2852;
	2850 [label="사람들을 헷갈리게 만들고 싶거든, 언제든 로터스로 가장하면 되는 일이야.",shape=box,color=red];
		2850 -> 2853;
	2851 [label="...핀즈나잇이라는게 뭔지부터 가르쳐 줘야 할 것 같은데.",shape=box,color=red];
		2851 -> 2854;
	2852 [label="오, 세상에. 친구. ",shape=box,color=blue];
		2852 -> 2855;
	2853 [label="오, 신들이시여, 안돼. 네 머릿속에서 그녀를 본 적이 있어. 난 절대로 그녀를 제대로 표현해낼 수 없을 거야.",shape=box,color=blue];
		2853 -> 2856;
	2854 [label="음음. 가끔 네가 아무 것도 모르는 부외자라는 걸 잊어버리곤 하는구나. ",shape=box,color=blue];
		2854 -> 2857;
	2855 [label="댄디 데미지가 길을 개척해 나아간 덕분에 템플과 리퍼들이 그 장르에서 달려 나갈 수 있었던 거야. 그 사람은 모든 엄마들의 악몽이자 모든 십대 청소년 재앙덩어리들의 꿈이었지.",shape=box,color=blue];
		2855 -> 2858;
	2856 [label="그리고 그 헬멧 말이야. 그거 헬멧 맞니? 아니면 로터스의 일부분이니? 그게 있는데 어떻게 앞을 볼 수 있는 거니?",shape=box,color=blue];
		2856 -> 2859;
	2857 [label="핀즈나잇이란 솔께서 세상에 미치는 영향력이 약해지는 기념일이란다.",shape=box,color=blue];
		2857 -> 2860;
	2858 [label="대벌레 같은 몸을 하고선, 무성 영화의 여왕처럼 스스로를 꾸몄지. 입은 설탕을 바른 것만 같고, 세로줄 무늬와 가죽, 그리고 쇠사슬 개줄이 아이콘이었어. 광대뼈는 마치 해골의 골반 같았고.",shape=box,color=blue];
		2858 -> 2861;
		2858 -> 2862;
	2859 [label="어쨌든, 안 그래도 그녀는 한 몸에 세 개의 자신을 깃들이고 있어. 난 도저히 셋 중 하나를 골라잡는다는 건 할 수가 없구나.",shape=box,color=blue];
		2859 -> 2861;
		2859 -> 2862;
	2860 [label="말만 들어선 영 말이 안 되는 것 같지만. 왜 어둠이 힘을 더하는데 기념을 하지? 왜 이런 무법, 무정부 상태를 기뻐하는 걸까?",shape=box,color=blue];
		2860 -> 2863;
	2861 [label="코스튬으로 차려입어? 파티? 이 전쟁통에서? 그런 게 진짜 가능하긴 해?",shape=box,color=red];
		2861 -> 2864;
	2862 [label="듣자 하니, 핀즈나잇은 나베루스랑 엄청 비슷한 것 같네. 저쪽 사람들도 나베루스 때 가장하는 걸 좋아하거든.",shape=box,color=red];
		2862 -> 2864;
	2863 [label="내 생각엔 아마, 예방 접종 같은 거겠지만. 우리가 두려워하는 걸 아주 조금만 주사해 두면, 강해지는 거야. 혹은 그냥 악마의 가면을 쓰고 지옥을 이 지상에 재현하려는 핑계일 수도 있고.",shape=box,color=blue];
		2863 -> 2861;
		2863 -> 2862;
	2864 [label="...어쩌면 내가 그냥 좀 한심하게 굴고 있는 걸수도 있겠구나. 애들도 아니고. 안 그러니?",shape=box,color=blue];
		2864 -> 2865;
	2865 [label="참, 무슨 생각을 하고 있는 건지.",shape=box,color=blue];
		2865 -> 2866;
	2866 [label="애초에 내가 가장을 할 필요가 뭐가 있겠니? 난 이미 괴물인걸. 지금도 그렇고 앞으로도 계속.",shape=box,color=blue];
		2866 -> 2867;
	2867 [label="Check boolean EleanorDating",color=orange];
		2867 -> 2868 [label=true,color=green];
		2867 -> 2869 [label=true,color=green];
		2867 -> 2870 [label=true,color=green];
		2867 -> 2869 [label=false,color=brown];
		2867 -> 2870 [label=false,color=brown];
	2868 [label="그렇다 해도 넌 내가 사랑하는 괴물이야, 엘레노어. 난 그 어떤 것도 후회하지 않아.",shape=box,color=red];
		2868 -> 2871;
	2869 [label="이쯤 되면 네가 자기 얘길 그런 식으로 하는 걸 슬슬 즐기나 싶네.",shape=box,color=red];
		2869 -> 2872;
	2870 [label="아니, 진짜 괴물은 너처럼 사람들을 신경써 주지 않아.",shape=box,color=red];
		2870 -> 2873;
	2871 [label="+5 Chemistry",color=orange];
		2871 -> 2874;
	2872 [label="만약 네가 정말 그런 괴물이라고 믿는다면, 핀즈나잇이야말로 그걸 기념할 완벽한 기회잖아.",shape=box,color=red];
		2872 -> 2875;
		2872 -> 2873;
	2873 [label="네가 변할지도 모르는 존재 때문에 두려워지는 건 알고 있어. 하지만 지금의 넌 그 존재가 아니야.",shape=box,color=red];
		2873 -> 2876;
	2874 [label="오, 그렇지! 바보같기는. 우리들만의 이야기에서 괴물은 해피 엔딩을 맞았다는 걸 잊어버리고 있었구나.",shape=box,color=blue];
		2874 -> 2877;
	2875 [label="진짜 괴물이 돼. 정복하라고. 1년 중 이 날 밤만이라도. 괴물이란 이름을 자랑스럽게 달고 다녀.",shape=box,color=red];
		2875 -> 2878;
	2876 [label="그러니 맘껏 차려 입어. 재밌게 즐기고. 누가 알아, 다른 헥스 대원들도 얼마쯤은 즐길지.",shape=box,color=red];
		2876 -> 2879;
	2877 [label="미안해. 네가 정말로 '원하는' 게 지금 이 현실이라는 걸 아직도 믿기가 좀 힘들어. 어쩌면 설득력이 아주 조금 더 필요할지도 모르겠고.",shape=box,color=blue];
		2877 -> 2880;
	2878 [label="세상에 그게 왜 끔찍한 소린지 댈 수 있는 이유가 얼마나 많은데",shape=box,color=blue];
		2878 -> 2881;
	2879 [label="그 도전, 받아들이지. 그리고 새삼스럽지만, 고마워. x",shape=box,color=blue];
		2879 -> 2882;
	2880 [label="그러니 나중에 또 서로 잡아먹어 볼까. (쪽)",shape=box,color=blue];
		2880 -> 2883;
	2881 [label="얼마나. 많은데.",shape=box,color=blue];
		2881 -> 2884;
	2882 [label="Chat ends.",color=orange];
	2883 [label="Chat ends.",color=orange];
	2884 [label="(지금 당장 떠오르는 건 없지만 분명 수십 가지는 있을 거거든)",shape=box,color=blue];
		2884 -> 2885;
	2885 [label="... 젠장.",shape=box,color=blue];
		2885 -> 2886;
	2886 [label="우울에 버무려질 새도 없이 아주 그냥 꼬치구이마냥 꿰뚫는구나. 젠장할. 아주 잘 하셨어. x",shape=box,color=blue];
		2886 -> 2887;
	2887 [label="Chat ends.",color=orange];
}