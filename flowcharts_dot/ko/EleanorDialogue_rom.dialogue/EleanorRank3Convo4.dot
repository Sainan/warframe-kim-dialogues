		1194 -> 1195;
	1193 [label="Chat ends.",color=orange];
	1195 [label="자리만? 너의 부모님은 어떻게 되셨어? 그 아이들은 네가 겪은 것과 비슷하게 끔찍한 시련을 겪었겠지?",shape=box,color=blue];
		1195 -> 1196;
