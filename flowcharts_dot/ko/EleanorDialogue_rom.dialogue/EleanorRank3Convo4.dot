digraph {
	1123 [label="EleanorRank3Convo4 begins.",color=orange];
		1123 -> 1124;
	1124 [label="만약 내가 말하는 것 중에 틀린 게 있다면 알려줘:",shape=box,color=blue];
		1124 -> 1125;
	1125 [label="너는 또 다른 자아로 돌아다니고 있어. 그 다른 자아는 너이기도 하고 아니기도 하고. 그들은 마치 현실의 또 다른 버전에서 온 어린 시절의 너 같기도 하고 말이야.",shape=box,color=blue];
		1125 -> 1126;
		1125 -> 1127;
	1126 [label="꼭 그렇지는 않아. 이게 그들의 현실 버전이야. 나는 여기서 아웃사이더고.",shape=box,color=red];
		1126 -> 1128;
	1127 [label="오히려 우리는 어느 순간 나눠지게 됐어. 나는 왼쪽으로, 그들은 오른쪽으로 가버렸지.",shape=box,color=red];
		1127 -> 1129;
	1128 [label="와우 넬리. 잠깐. 내가 처리할게.",shape=box,color=blue];
		1128 -> 1130;
	1129 [label="난 우리가 그들의 현실이 아닌, 너의 현실 속에 있는 거라 생각해. 내가... 처리할게.",shape=box,color=blue];
		1129 -> 1130;
	1130 [label="그러니까... 너는 크로스오버 에피소드의 게스트 스타처럼 쇼에 출연하게 된 거라는 얘기인가?",shape=box,color=blue];
		1130 -> 1131;
	1131 [label="그렇다고 봐야지.",shape=box,color=red];
		1131 -> 1132;
	1132 [label="아 헷갈린다. 그럼 너의 현실 버전은 어떻게 된 거지? 어디로 간 거야?",shape=box,color=blue];
		1132 -> 1133;
		1132 -> 1134;
		1132 -> 1135;
	1133 [label="내 생각에 그중에 남은 건 차원을 넘나드는 유령선 자리만뿐인 거 같은데...?",shape=box,color=red];
		1133 -> 1136;
	1134 [label="남은 건 그게 뭐였든 나와 함께 두비리로 들어왔어. 좋든 나쁘든.",shape=box,color=red];
		1134 -> 1137;
	1135 [label="난 그것에 대해 많이 생각하지 않아. 아마도 사라졌을걸.",shape=box,color=red];
		1135 -> 1138;
	1136 [label="Check boolean EleanorHoldfasts1",color=orange];
		1136 -> 1139 [label=true,color=green];
		1136 -> 1140 [label=false,color=brown];
	1137 [label="그러면 어떤 의미에서는 계속 살아가고 있는 거네.",shape=box,color=blue];
		1137 -> 1145;
	1138 [label="우주 통째를 잃었을 리가 없어. 말도 안 돼. 어딘가에 있을 거야.",shape=box,color=blue];
		1138 -> 1146;
	1139 [label="아! 네 유령 친구들의 소굴. 사수자들.",shape=box,color=blue];
		1139 -> 1141;
	1140 [label="미안하지만, 흥미로운 얘기 같은데 무슨 말인지 하나도 모르겠어.",shape=box,color=blue];
		1140 -> 1142;
	1145 [label="그게 조금이라도 위안이 될지는 모르겠지만.",shape=box,color=blue];
		1145 -> 1147;
	1146 [label="그럴 수도 있겠지. 하지만 말했듯이, 내 주요 관심사는 아니야.",shape=box,color=red];
		1146 -> 1148;
	1141 [label="그곳은 향수에 젖어 산책을 하러 갈만한 곳은 아닌 거 같아.",shape=box,color=blue];
		1141 -> 1143;
	1142 [label="유령선?",shape=box,color=blue];
		1142 -> 1144;
	1147 [label="나는 집과 가족이 \"어디에서\", 주변의 \"누구\"를 어떻게 만드는지에 따라 더 큰 의미가 있다는 걸 배우게 되었어.",shape=box,color=red];
		1147 -> 1149;
	1148 [label="하지만 거기가 네 집인걸. 다시 돌아가고 싶지 않아?",shape=box,color=blue];
		1148 -> 1150;
	1143 [label="네가 무엇을 잃었는지 짐작도 할 수 없겠어.",shape=box,color=blue];
		1143 -> 1151;
	1144 [label="차원 사이에 구멍이 있다니?",shape=box,color=blue];
		1144 -> 1152;
	1149 [label="어디에서 무엇으로 태어났는지는 중요하지 않은 거지.",shape=box,color=red];
		1149 -> 1157;
	1150 [label="더 이상은 아니야. 난 집이 없거든.",shape=box,color=red];
		1150 -> 1158;
	1151 [label="그렇지 만은 않아.",shape=box,color=red];
		1151 -> 1153;
	1152 [label="자리만 호는 내가 탔던 콜로니 함선이야. 타우로 향하던 배였지. 도착하지는 못했지만.",shape=box,color=red];
		1152 -> 1154;
	1157 [label="난 잃어버린 것들을 신경 쓰지 않아. 나는 현재 내가 가지고 있는 것에 집중할래. 이곳처럼. 너희들 모두처럼. 왜냐하면...",shape=box,color=red];
		1157 -> 1159;
	1158 [label="'드리프터'라는 별명이 붙은 데가 이유가 있겠지.",shape=box,color=red];
		1158 -> 1159;
	1153 [label="난 빠져나왔는걸. 살아남았잖아. 운이 미친 듯이 좋은 거겠지?",shape=box,color=red];
		1153 -> 1155;
	1154 [label="그 배는 보이드 속으로 들어갔고, 거기에 존재하던 무언가가 그 배를 지옥 버전으로 바꾸기로 한 거지.",shape=box,color=red];
		1154 -> 1156;
	1159 [label="내가 가본 모든 곳들 중에 이곳이 내가 가장 있어야 할 곳이라는 느낌이 들거든.",shape=box,color=red];
		1159 -> 1171;
	1155 [label="솔직히 말해서, 애초에 우리 중 누군가가 살았을 확률은 너무 낮아서, 나에게는 그저 기적일 뿐인 거야.",shape=box,color=red];
		1155 -> 1160;
	1156 [label="그 배는 보이드와 현실을 오가다, 이제는 문턱에 갇혀 버렸어.",shape=box,color=red];
		1156 -> 1161;
	1171 [label="허. 이상하게도 자랑스럽네.",shape=box,color=blue];
		1171 -> 1172;
