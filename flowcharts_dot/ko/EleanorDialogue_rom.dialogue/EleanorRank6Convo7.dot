		3195 -> 3198;
	3196 [label="Chat ends.",color=orange];
	3197 [label="\"침착히 대응하고 프로들에게 맡기십시오!\" 하고, 여덟 살짜리 아서가 액션 앵거스를 연기하면서 낮게 깔고 내던 그 목소리 말이지. 플라스틱 SAS 부대가 내 샌디 인형들을 공룡 군대한테서 구출해 내는 놀이를 하면서.",shape=box,color=blue];
