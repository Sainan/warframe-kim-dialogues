		3193 -> 3196;
	3194 [label="... 다만 네게 살짝 알려주자면, 나한테 있어서 그 목소리는, 언제나 그 애의 액션 앵거스 피규어 목소리로 들릴 거라는 거야.",shape=box,color=blue];
		3194 -> 3197;
