digraph {
	1700 [label="EleanorRank4Convo4 begins.",color=orange];
		1700 -> 1701;
		1700 -> 1702;
		1700 -> 1703;
	1701 [label="너와 레티가 친구였던 적은 있니?",shape=box,color=red];
		1701 -> 1704;
	1702 [label="여기는 꽤 친밀하게 연결된 그룹이야. 너네들 중에 헥스에서 다른 사람과 데이트한 적 있니?",shape=box,color=red];
		1702 -> 1705;
	1703 [label="아서가 누군가와 연애를 한다면 어떻게 받아들일 거야?",shape=box,color=red];
		1703 -> 1706;
	1704 [label="오 이런, 그럼. 우리는 한동안 아주 가까웠지.",shape=box,color=blue];
		1704 -> 1707;
	1705 [label="친구, 이건 조금 개인적인 얘기이지만, 허락할게. 넌 우리와 꽤 오랫동안 함께 해왔잖아. 여기 형세에 대해 알 자격이 있지.",shape=box,color=blue];
		1705 -> 1708;
	1706 [label="멀리 떨어져 있지 않은 누군가를 말하는 거야?",shape=box,color=blue];
		1706 -> 1709;
	1707 [label="물론, 엔트라티 이전 얘기지만.",shape=box,color=blue];
		1707 -> 1710;
	1708 [label="아서와 아오이가 데이트하던 거 말고? 아니. 내가 아는 한에서는, 그러니까... 내가 알았을 거야.",shape=box,color=blue];
		1708 -> 1711;
	1709 [label="대답하지 마.",shape=box,color=blue];
		1709 -> 1712;
	1710 [label="이제 걔는 내가 다른 사람인 것처럼 행동해. 뭐 걔는 편하겠지. 내가 진짜 엘레노어가 아니라면 걔는 자기가 원하는 만큼 나에게 상처를 줄 수 있거든, 왜나하면 걔는 자기가 아는 사람은 해치진 않아. 난 그게 비열한 거 같아.",shape=box,color=blue];
		1710 -> 1715;
	1711 [label="그리고 만약 네가 우리 중 누군가에게 접근할 생각이라면...",shape=box,color=blue];
		1711 -> 1713;
	1712 [label="만약 내가 그들이 자신들이 무엇을 하고 있는지 알고 있고 그 남자에 대해 진심 어린 감정을 가지고 있다고 생각했다면, 나도 설레었겠지. 당연히.",shape=box,color=blue];
		1712 -> 1714;
	1715 [label="그래도 걔는 여전히 네가 이 곤경에서 회복되기를 바라잖아, 안 그래?",shape=box,color=red];
		1715 -> 1723;
	1713 [label="... 퀸시의 신뢰를 얻는 것보다 더 한 짓도 할 수 있을 거야. 그는 많은 것을 봐. 어쩌면 메모해 두는 게 좋을 거야.",shape=box,color=blue];
		1713 -> 1716;
	1714 [label="하지만 나는 그들이 그 사람을 다치게 하는 게 얼마나 쉬운 일인지 확인하고 싶었어.",shape=box,color=blue];
		1714 -> 1719;
	1723 [label="아, 그러지 마. 그전에 내 날개와 꼬리가 자랄 테니.",shape=box,color=blue];
		1723 -> 1724;
	1716 [label="+5 Chemistry",color=orange];
		1716 -> 1717;
	1719 [label="겉모습은 갑옷과 태도로 가득 차 있지만 속은 부드럽고 말랑말랑한 유기농으로 만들어진 로봇은 어떤 걸까?",shape=box,color=blue];
		1719 -> 1718;
		1719 -> 1720;
		1719 -> 1721;
	1724 [label="엔트라티는 망했어. 샤워하면서 노래하고 거리에서 아이들에게 미소 짓던 옛 엘레노어를 다시 보고 싶다면, 그 희망은 이제 그와 함께 떠난 거라 봐야지.",shape=box,color=blue];
		1724 -> 1728;
		1724 -> 1729;
	1717 [label="Chat ends.",color=orange];
	1718 [label="솔라리스?",shape=box,color=red];
		1718 -> 1722;
	1720 [label="녹스?",shape=box,color=red];
		1720 -> 1722;
	1721 [label="센티언트?",shape=box,color=red];
		1721 -> 1722;
	1728 [label="레티는 거울을 좀 들여다보고 본인 역시 인간성을 잃기까지 얼마 남지 않았다는 사실을 깨달아야 해.",shape=box,color=red];
		1728 -> 1730;
	1729 [label="아서가 너를 여전히 동생이라 생각한다면, 레티 역시 그걸로 충분할 거야.",shape=box,color=red];
		1729 -> 1731;
	1722 [label="뭐든 상관없어. 요점은, 아서는 그런 것이라는 거야.",shape=box,color=blue];
		1722 -> 1725;
	1730 [label="내 편을 들어주는 거야?",shape=box,color=blue];
		1730 -> 1732;
	1731 [label="그렇게 생각하겠지.",shape=box,color=blue];
		1731 -> 1733;
	1725 [label="만약 걔가 너를 받아들인다면, 부디 상냥하게 대해줘.",shape=box,color=blue];
		1725 -> 1726;
	1732 [label="어, 맞아. 걔는 좀 그래야 돼.",shape=box,color=blue];
		1732 -> 1734;
	1733 [label="레티는 아서를 흠모해. 그는 걔가 결코 가질 수 없었던 큰오빠와도 같은 존재거든. 아서가 아니었다면, 나는 아마도 클로로포름이 묻은 헝겊 조각을 입에 물고 강바닥에서 눈을 떴을 거야.",shape=box,color=blue];
		1733 -> 1735;
	1726 [label="+5 Chemistry",color=orange];
		1726 -> 1727;
	1734 [label="나는 아직도 걔가 이 도시를 불타게 내버려두라고 한 말을 용서하지 못하겠어.",shape=box,color=blue];
		1734 -> 1736;
	1735 [label="걔는 그가 망상에 빠져서, 과거에 빠져 산다고 생각해. 하지만 걔는 그 남자를 사랑해. 걔 또한 좋은 군인이기 때문에 절대로 그에서 맞서지 않을 테니까.",shape=box,color=blue];
		1735 -> 1737;
		1735 -> 1738;
	1727 [label="Chat ends.",color=orange];
	1736 [label="아오이조차도 놀랐잖아. 이쯤 되면 진짜 괴물이 누군인지 궁금하지 않아?",shape=box,color=blue];
		1736 -> 1737;
		1736 -> 1738;
	1737 [label="그런데 걔는 왜 그렇게 너를 싫어하는 거야?",shape=box,color=red];
		1737 -> 1739;
	1738 [label="걔를 겁먹게 하는 게 정말로 혀뿐이야? 아니면 생각을 읽는 거?",shape=box,color=red];
		1738 -> 1739;
	1739 [label="그건 좀 복잡해. 여러 가지 이유가 있어.",shape=box,color=blue];
		1739 -> 1740;
	1740 [label="걔가 내 면전에 대고 자기 머릿속 쑤셔 보지 말라더라고. 내가 동의하지 않는다면, 헥스를 떠나서 스스로 기회를 잡을 거래. 미친 짓이지.",shape=box,color=blue];
		1740 -> 1741;
	1741 [label="그래서 걔는 내가 자기 10대 때 일기를 읽을까 봐 두렵다는 거야. 내가 자기의 가장 부끄러운 비밀을 들여다보면 영원히 굴욕을 당할까 봐서.",shape=box,color=blue];
		1741 -> 1742;
	1742 [label="사실, 난 그다지 궁금하지도 않아. 걔가 나에게 숨기고 있는 게 뭐든 간에, 안전하다고.",shape=box,color=blue];
		1742 -> 1743;
		1742 -> 1744;
	1743 [label="너희 둘이... 조금이라도 로맨틱했던 적 있니?",shape=box,color=red];
		1743 -> 1745;
	1744 [label="혹시 걔가 널 좋아하는 거 같니?",shape=box,color=red];
		1744 -> 1746;
	1745 [label="내가 뭐 키스라도 했을까 봐?",shape=box,color=blue];
		1745 -> 1747;
	1746 [label="그런 생각이 들은 적 있어.",shape=box,color=blue];
		1746 -> 1748;
	1747 [label="아니. 그런 적 없어.",shape=box,color=blue];
		1747 -> 1749;
	1748 [label="뭐 그럴 수도 있었을 것 같아. 친구들끼리 포옹하고 애무하는 건 아무 문제가 없잖아. 특히 아서가 브리핑에서 우리의 감정이 업무 수행에 방해가 되면 안 된다고 불편한 연설을 해야 한다면.",shape=box,color=blue];
		1748 -> 1750;
	1749 [label="그렇다면 다행인데, 지금 우리 사이가 얼마나 어색해질지 상상할 수 있겠어?",shape=box,color=blue];
		1749 -> 1751;
	1750 [label="스트레스도 풀어주고, 사기를 북돋워 주기도 하는데, 비용은 싸잖아.",shape=box,color=blue];
		1750 -> 1752;
	1751 [label="그러니까 내 말은... 아니라고 말하진 않았을 거야. 그냥 떠오른 적이 없어.",shape=box,color=blue];
		1751 -> 1755;
	1752 [label="하지만 미스 가르시아가 숨기고 있는 건 사람들이 그녀를 해칠만 한 무언가야. 난 그녀의 머릿속에 그걸 볼 수 있으니까 내가 위협적이 되는 거지.",shape=box,color=blue];
		1752 -> 1754;
	1755 [label="+10 Chemistry",color=orange];
		1755 -> 1753;
	1754 [label="잠깐, 아서와 아오이는 상품 아니었어?",shape=box,color=red];
		1754 -> 1757;
	1753 [label="그러니까 그 아이에게 매력을 느꼈다면, 도전해 봐! 내가 옆에서 응원해 줄게! 루아는 레티가 암울하고 사랑이 없는 삶에서도 행복을 누릴 수 있다는 걸 알고 있거든.",shape=box,color=blue];
		1753 -> 1756;
	1757 [label="왜? 너 우리 오빠한테 관심 있어? 아니면 아오이?",shape=box,color=blue];
		1757 -> 1758;
		1757 -> 1759;
		1757 -> 1760;
	1756 [label="Chat ends.",color=orange];
	1758 [label="음. 그게. 사실은...",shape=box,color=red];
		1758 -> 1761;
	1759 [label="어... 아니... 사실 난 *너*한테 관심 있는데...",shape=box,color=red];
		1759 -> 1762;
	1760 [label="아니. 정말 웃기군. 그들은 내 취향이 아니야, 미안. 걔넨 너무 \"영웅스러워.\"",shape=box,color=red];
		1760 -> 1801;
	1761 [label="오! 오! 말해줘...",shape=box,color=blue];
