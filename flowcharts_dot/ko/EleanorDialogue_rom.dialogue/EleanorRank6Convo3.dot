	j2300102924 [label="문제는 말이야, 그 애가 그렇게 연습을 열심히 한 건 우리 부모님을 위해서도, 헨쇼 선생님을 기쁘게 해 주기 위해서도 아니었다는 거야. ",shape=box,color=blue];
