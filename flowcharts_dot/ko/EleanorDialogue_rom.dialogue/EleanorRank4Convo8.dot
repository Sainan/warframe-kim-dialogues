	2042 [label="Chat ends.",color=orange];
	2045 [label="안녕 엘레노어? 아미르가 맞추고 있던 보드 게임 기억나? 페이블 & 프론티어?",shape=box,color=red];
		2045 -> 2044;
	2046 [label="안녕 엘레노어? 너하고 아미르 친한 거 맞지?",shape=box,color=red];
		2046 -> 2048;
	2047 [label="너 보드게임 좋아하니?",shape=box,color=red];
		2047 -> 2049;
	2044 [label="응. 근데 네가 시간 낭비일 거라고, 단지 걔가 불쌍해서 같이 놀아줬다고 하지 않았었나, 맞지?",shape=box,color=blue];
		2044 -> 2050;
		2044 -> 2052;
		2044 -> 2053;
	2048 [label="걔는 매력적인 익살꾸러기야. 근데 왜?",shape=box,color=blue];
		2048 -> 2055;
		2048 -> 2056;
	2049 [label="그냥 다른 사람만큼만. 근데 왜?",shape=box,color=blue];
		2049 -> 2055;
		2049 -> 2056;
	2050 [label="아이고. 너 아직 화났구나. 알았어.",shape=box,color=red];
		2050 -> 2051;
	2052 [label="그때는 네가 \"너무 쿨하군\"이라고 생각했고, 나도 그런척하려고 했었어. 지금은 내가 더 잘 알지만.",shape=box,color=red];
		2052 -> 2054;
	2053 [label="그래 난... 그냥 사과하고 싶었어. 내가... 한 말은 진심이 아니었어. 네가 거절할까 봐 두려웠어.",shape=box,color=red];
		2053 -> 2062;
	2055 [label="아미르가 페이블 & 프론티어 게임을 하기 위해 팀을 모으고 있는데, 내가 도와주겠다고 했거든.",shape=box,color=red];
		2055 -> 2057;
	2056 [label="아미르는 정말 모든 사람과 페이블 & 프론티어를 하고 싶어 해. 너도 할래?",shape=box,color=red];
		2056 -> 2057;
	2051 [label="Chat ends.",color=orange];
	2054 [label="우리 중 더 이상 게임에 \"너무 쿨하지\" 못한 건 너일까 아니면 나일까?",shape=box,color=blue];
		2054 -> 2058;
		2054 -> 2059;
		2054 -> 2060;
	2062 [label="우리 모두 인생에서 한 번쯤은 그런 적 있잖아... 누군가에서 좋은 인상을 주기 위해 가면을 쓰려고 하다가 어디로 가는지 보이지가 않아서 얼굴을 땅에 박고 쓰러지는 일 같은 거 말이야. 그리고 네가 물었을 때 너와 나는 거의 만나지 못했어. 좋아. 널 용서해 줄게.",shape=box,color=blue];
		2062 -> 2067;
	2057 [label="아 그렇군. 너는 썬더볼트 왕이 공정한 엘레노어를 영입하기 위해 보내진 선택받은 사자로군. 의심할 여지없이 온갖 속임수가 나를 기다리고 있겠네. Fol de rol 등등.",shape=box,color=blue];
		2057 -> 2063;
		2057 -> 2064;
	2058 [label="너지. 난 아직도 그게 멍청한 게임이라고 생각하지만, 그러든지 말든지.",shape=box,color=red];
		2058 -> 2061;
	2059 [label="나. 확실히 나야. 넌 여전히 게임에 너무 쿨해. 하지만 나는 바보 멍청이지. 퀸시도 그랬어.",shape=box,color=red];
		2059 -> 2062;
	2060 [label="...둘 다?",shape=box,color=red];
		2060 -> 2062;
	2067 [label="솔직히, 얼간이 같은 목소리로 몇 시간 동안 연기하는 게 나쁘게 들리지는 않네. 나도 끼워줘.",shape=box,color=blue];
		2067 -> 2068;
	2063 [label="솔직히 재밌을 거 같은데. 그에게 큰 의미가 있어 보이네.",shape=box,color=red];
		2063 -> 2067;
	2064 [label="어, 시간 낭비 같아 보이지만 친절하게 굴려고 애쓰는 중이야.",shape=box,color=red];
		2064 -> 2065;
	2061 [label="Chat ends.",color=orange];
	2068 [label="오! 난 마법사가 되고 싶은데. 아니면 시인할까. 아니면 둘 다? 둘 다 할 수 있을까?",shape=box,color=blue];
		2068 -> 2069;
	2065 [label="내가 너에게 호의를 베풀 예정이므로 이 말은 그에게 전하지 않을게. 대신 조언 하나 하지. 앞으로 내 앞에서는 그를 더 존중해 주길 바래.",shape=box,color=blue];
		2065 -> 2066;
	2069 [label="아니면 늪에 빠진 마녀가 될 수도 있겠어! 꽉 끼는 바디스만 입을 수 있다면 말이야. 엄마 모씨티츠가 네 뼈를 먹어 치울 거야, 이 작은 난쟁이야.",shape=box,color=blue];
		2069 -> 2077;
