	1086 [label="그거 영웅 바이러스 같은 거야. 결국 너 자신이 다른 사람들 이야기 속 주인공이라고 생각한다니까.",shape=box,color=blue];
		1086 -> 1087;
	1087 [label="거기에 훌륭한 이야기는 없어. 드라마틱한 효과를 위해 내 삶에 작은 줄거리 거리를 더해주는 작가는 없거든.",shape=box,color=blue];
