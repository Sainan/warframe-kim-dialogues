digraph {
	1032 [label="EleanorRank3Convo3 begins.",color=orange];
		1032 -> 1033;
	1033 [label="안녕, 엘레노어. 잘 지내고 있어?",shape=box,color=red];
		1033 -> 1034;
	1034 [label="아주 좋아. 내 혀를 면도하고 있는 중이었어.",shape=box,color=blue];
		1034 -> 1035;
		1034 -> 1036;
	1035 [label="면도?",shape=box,color=red];
		1035 -> 1037;
	1036 [label="잠깐만. *뭘 해?*",shape=box,color=red];
		1036 -> 1038;
	1037 [label="면도. 이 뾰족한 조각들이 계속 돋아나. 예전에는 미각 돌기였던 거 같은데. 밀어내지 않으면 정말 길고 꼬불꼬불해지거든. 말미잘처럼.",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="손톱을 다듬는 것과 별반 다르지 않구나.",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="미안. 미리 알려줬어야 했는데.",shape=box,color=blue];
		1039 -> 1041;
	1040 [label="성가시겠네. 하지만 여전히 원치 않는 이상 생성물의 껍질을 벗기는 것에 불과하잖아.",shape=box,color=blue];
		1040 -> 1041;
	1041 [label="엘레노어가 주방 칼과 수술용 알코올 한 병을 들고 화장실로 들어가면 사람들 모두 최소 100야드 이상은 떨어져 있어야 한다는 것을 알고 있어.",shape=box,color=blue];
		1041 -> 1042;
	1042 [label="그냥 참을성 있게 기다리면 내가 턱에는 피를 흘리며 손에는 게살 같은 게 들은 비닐봉지를 들고 나올 거야. 한 번은 그것들로 햄버거를 만들어 보려고 했지만 아무도 원하지 않더라.",shape=box,color=blue];
		1042 -> 1043;
	1043 [label="미안, 에로틱한 30분짜리 채팅을 원했었니 아니면 단지 5분?",shape=box,color=blue];
		1043 -> 1044;
		1043 -> 1045;
	1044 [label="나를 역겹게 하려는 거라면 그만둬.",shape=box,color=red];
		1044 -> 1046;
