		1103 -> 1104;
	1088 [label="나에게 일어나는 멍청한 일에서 의미를 찾을 수 있어. 나는 솔이나 루아 같은 별 들 사이의 뭔가가 아닌 아티스트라고.",shape=box,color=blue];
