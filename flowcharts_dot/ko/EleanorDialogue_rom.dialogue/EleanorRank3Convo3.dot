		1105 -> 1106;
	1090 [label="네가 그걸 떠올리게 했어. 기억할지 모르겠지만. 나는 나 자신을 불쌍히 여겼고 네가 날 깨우쳐줬었지.",shape=box,color=blue];
		1090 -> 1091;
