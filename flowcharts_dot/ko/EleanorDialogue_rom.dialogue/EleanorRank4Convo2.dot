digraph {
	1521 [label="EleanorRank4Convo2 begins.",color=orange];
		1521 -> 1522;
	1522 [label="오 드리프터! 시간과 공간의 방랑자! 네가 이 작은 화면에 있는 게 얼마나 반가운 줄 아니!",shape=box,color=blue];
		1522 -> 1523;
		1522 -> 1524;
	1523 [label="안녕, 엘레노어.",shape=box,color=red];
		1523 -> 1526;
	1524 [label="금방 돌아올게, 칼리모스가 또 코드로 장난치고 있어. 아마 끊어질 [종료.]",shape=box,color=red];
		1524 -> 1525;
	1526 [label="안녕 친구.",shape=box,color=blue];
		1526 -> 1527;
	1525 [label="Chat ends.",color=orange];
	1527 [label="있잖아.",shape=box,color=blue];
		1527 -> 1528;
		1527 -> 1529;
	1528 [label="미래의 삶이 어떨지에 대한 질문 사항이 있니?",shape=box,color=red];
		1528 -> 1530;
	1529 [label="꼬리가 자랐네.",shape=box,color=red];
		1529 -> 1531;
	1530 [label="으악. 난 너무 지루할 정도로 예측이 가능한데.",shape=box,color=blue];
		1530 -> 1533;
	1531 [label="... 네가 좋아하지 않나?",shape=box,color=blue];
		1531 -> 1532;
	1533 [label="어, 나도 그래. 그럼 하나 더. 하지만 이건 정말 큰 문제니, 조금만 참아줘, 알겠지?",shape=box,color=blue];
		1533 -> 1534;
	1532 [label="아, 아니. 내 엉덩이는 꼬리를 추가한다고 해서 개선되지 않을 거야. 이보다 더 좋아질 수 없어. 이미 완벽하거든.",shape=box,color=blue];
		1532 -> 1535;
	1534 [label="최선을 다해볼게.",shape=box,color=red];
		1534 -> 1536;
	1535 [label="하지만, 나 질문이 하나 있어.",shape=box,color=blue];
		1535 -> 1537;
	1536 [label="좋아, 아주 좋았어. 그러니까.",shape=box,color=blue];
		1536 -> 1537;
	1537 [label="너의 시간에서는 연애는 어떻게 진행되는 거니? 그러니까 내 말은, '두 명 이상의 성인이 서로 다른 정도의 엄숙함을 가지고 모이는' 게 일반적인 거니? 아니면 누가 누구와 함께할 수 있는지에 대한 그런 종류의 규칙들이 있는 거니?",shape=box,color=blue];
		1537 -> 1538;
		1537 -> 1539;
		1537 -> 1540;
	1538 [label="그건 내가 깊게 생각해 본 적 없는 건데.",shape=box,color=red];
		1538 -> 1541;
	1539 [label="그건 아마도 문화에 따라 다르겠지.",shape=box,color=red];
		1539 -> 1542;
	1540 [label="... 왜 그런 걸 물어보는 거야?",shape=box,color=red];
		1540 -> 1543;
	1541 [label="맙소사.",shape=box,color=blue];
		1541 -> 1547;
	1542 [label="그렇지. 물론이지.",shape=box,color=blue];
		1542 -> 1548;
	1543 [label="Check boolean EleanorEntrati",color=orange];
		1543 -> 1544 [label=true,color=green];
		1543 -> 1545 [label=false,color=brown];
	1547 [label="네가 두비리에 고립되어 있었다는 건 알았지만, 그 정도인 줄은 몰랐네.",shape=box,color=blue];
		1547 -> 1552;
	1548 [label="그럼 다른 방법을 시도해 볼게.",shape=box,color=blue];
		1548 -> 1550;
	1544 [label="데이모스에는 두 사람이 있지, 아빠와 엄마. 그들은 결혼한 부부야. 그들이 거대한 감염체였던 이전의 오로킨이었지는 모르겠지만, 그들은 우리 엄마와 아빠와 똑같은 방식으로 매우 분명하고 고생스럽게 결혼했지.",shape=box,color=blue];
		1544 -> 1546;
	1545 [label="네 생각에서 얻은 작은 조각들을 보면 여전히 표준적인 방식으로 짝을 이루는 사람들을 볼 수 있네. 우리 엄마와 아빠와 똑같은 방식으로 매우 분명하고 고생스럽게 결혼한 사람들.",shape=box,color=blue];
		1545 -> 1546;
	1552 [label="+15 Chemistry",color=orange];
		1552 -> 1549;
	1550 [label="어디 보자...",shape=box,color=blue];
		1550 -> 1554;
	1546 [label="그럼 그게 오로킨의 기준이었을까?",shape=box,color=blue];
		1546 -> 1551;
	1549 [label="만약 내 질문이 기분 나빴다면 진심으로 사과할게.",shape=box,color=blue];
		1549 -> 1553;
	1554 [label="그렇군. 그럼 네가 온 곳에서는, 예를 들어 사람이 세팔론과 연애를 한다, 이런 게 정상이라고 할 수 있어?",shape=box,color=blue];
		1554 -> 1555;
		1554 -> 1556;
	1551 [label="오로킨은 규칙과 금기를 중시했지. 그들은 위계질서 지키는 것을 좋아했어. 연애는 사회적 경계를 넘을 수 없었지. 예를 들어, 닥스는 오로킨 귀족과 함께 할 수 없었던 것처럼.",shape=box,color=red];
		1551 -> 1554;
	1553 [label="Chat ends.",color=orange];
	1555 [label="네가 알고 싶다면, 내가 오디스를 여기로 끌고 와서 확인해 볼 수도 있을 거 같은데...",shape=box,color=red];
		1555 -> 1557;
	1556 [label="... 한 번도 들어본 적은 없는데, 가능할지 모르겠네.",shape=box,color=red];
		1556 -> 1560;
	1557 [label="그럼 좀 이론적인 질문을 해볼게!",shape=box,color=blue];
		1557 -> 1558;
	1560 [label="젠장. 다시 해볼게.",shape=box,color=blue];
		1560 -> 1561;
	1558 [label="나는 네 유리 모양의 동료에게 내 몸을 비비고 싶지는 않아. 걔가 아무리 매력적이라 해도.",shape=box,color=blue];
		1558 -> 1559;
	1561 [label="네 시간에서 여자이면서 위험한 누군가를 만들어 봐. 강인하기도 하고, 악마가 소유한 적 없는 루살카 소령 같은.",shape=box,color=blue];
		1561 -> 1562;
		1561 -> 1563;
	1559 [label="나는 너에게 권력 불균형에 대해 물어보려 했던 건데, 실패했네.",shape=box,color=blue];
		1559 -> 1561;
	1562 [label="그리니어 저격수?",shape=box,color=red];
		1562 -> 1564;
	1563 [label="닥스?",shape=box,color=red];
		1563 -> 1565;
	1564 [label="좋아. 그리니어 저격수 여인이 있는데 그녀에게 반했다고 가정해 보자고. 그리고 이건 상호적인 관계야. 불행한 연인들이고 절실하게 비극적이지. 그들은 함께 할 수 있을까?",shape=box,color=blue];
		1564 -> 1566;
		1564 -> 1567;
		1564 -> 1568;
		1564 -> 1569;
	1565 [label="좋아. 닥스 군인 여인이 있는데 그녀가 낮은 계층의 인간에게 반했다고 가정해 보자고. 그리고 이건 상호적인 관계야. 불행한 연인들이고 절실하게 비극적이지. 그들은 함께 할 수 있을까?",shape=box,color=blue];
		1565 -> 1566;
		1565 -> 1567;
		1565 -> 1568;
		1565 -> 1569;
	1566 [label="두 사람이 모두 원한다면, 물론이지.",shape=box,color=red];
		1566 -> 1570;
	1567 [label="왜 안 되지?",shape=box,color=red];
		1567 -> 1570;
	1568 [label="나는 누군가가 그들을 막으려는 걸 보고 싶네.",shape=box,color=red];
		1568 -> 1570;
	1569 [label="물론, 하지만 어려울 거야.",shape=box,color=red];
		1569 -> 1576;
	1570 [label="난 여기서 나 자신이 매우 혼란스러운걸.",shape=box,color=blue];
		1570 -> 1572;
	1576 [label="+5 Chemistry",color=orange];
		1576 -> 1571;
	1572 [label="네가 온 곳에서는 사람들이 자신보다 훨씬 더 강력하고 위험한 파트너와 연을 맺는 게 정상이라는 건가? '검블리와 드래곤의 양말'에서 엘프 왕자가 거인과 결혼하는 것처럼?",shape=box,color=blue];
		1572 -> 1574;
	1571 [label="고마워.",shape=box,color=blue];
		1571 -> 1573;
	1574 [label="... 넌 내가 무슨 말을 하는지 모르는 거 같네.",shape=box,color=blue];
		1574 -> 1578;
		1574 -> 1579;
	1573 [label="질문: 신체적, 치명적인 레벨이 매우 차이가 큰 두 사람이 연인이 될 수 있을까? 답: 그렇다.",shape=box,color=blue];
		1573 -> 1575;
	1578 [label="난 아주 정확하게 알고 있는걸.",shape=box,color=red];
		1578 -> 1582;
	1579 [label="어, 전혀 모르겠어.",shape=box,color=red];
		1579 -> 1580;
	1575 [label="내가 알고 싶었던 건 그게 전부야.",shape=box,color=blue];
		1575 -> 1577;
	1582 [label="너의 하루를 망치고 싶지 않아. 미안해.",shape=box,color=blue];
		1582 -> 1583;
	1580 [label="그만하는 게 낫겠어. 나 자신을 완전히 망가트릴 위험에 놓인 거 같거든.",shape=box,color=blue];
		1580 -> 1581;
	1577 [label="Chat ends.",color=orange];
	1583 [label="자기 연민에 대한 질책을 좀 해도 될까?",shape=box,color=blue];
		1583 -> 1584;
		1583 -> 1585;
	1581 [label="Chat ends.",color=orange];
	1584 [label="마음껏 떠들어봐.",shape=box,color=red];
		1584 -> 1587;
	1585 [label="나 지금 이럴 시간이 없어, 미안. [종료.]",shape=box,color=red];
		1585 -> 1586;
	1587 [label="나는 내 인생이 함께할 누군가가 없다고 해서 의미가 없다고 말하려는 게 아냐.",shape=box,color=blue];
		1587 -> 1588;
	1586 [label="Chat ends.",color=orange];
	1588 [label="나는 내가 사랑하기로 선택한 사람에 의해 정의되지는 않거든.",shape=box,color=blue];
		1588 -> 1589;
	1589 [label="나는 나 자신만으로 충분해.",shape=box,color=blue];
		1589 -> 1590;
	1590 [label="하지만 내가 흥분해서 누군가를 실수로 죽일 수도 있는데 그때는 어떻게 그 관계의 가능성을 즐길 수 있는 걸까",shape=box,color=blue];
		1590 -> 1591;
	1591 [label="엘레노어와 그녀의 음탕한 곤충 문제에 온 것을 환영해.",shape=box,color=blue];
		1591 -> 1592;
	1592 [label="만약 내가 그 엔트라티 놈을 찾으면 나는 그의 거시기를 귀걸이로 만들어 버릴 거야. 만약 그 새끼에게 그게 있다면 말이지.",shape=box,color=blue];
		1592 -> 1593;
		1592 -> 1594;
	1593 [label="헥스에서는 언제든지 다른 사람과 데이트할 수 있어.",shape=box,color=red];
		1593 -> 1595;
	1594 [label="잠깐만. 너 지금 누군가를 다치게 할까 봐 걱정돼서 혼자라는 얘기야?",shape=box,color=red];
		1594 -> 1596;
	1595 [label="OMFS",shape=box,color=blue];
		1595 -> 1597;
	1596 [label="응.",shape=box,color=blue];
		1596 -> 1601;
	1597 [label="나 지금 웃지 않으려고 혀 꽉 깨물고 있는 중이야.",shape=box,color=blue];
		1597 -> 1598;
	1601 [label="너는 내가 하는 것보다 낫다는 걸 알고 있을 거야, 아마도. 나는 프로토프레임이야. 부분적으로 변형된 전쟁 기계이고, 날이 갈수록 그 부분이 적어지고 있다는 걸 느끼기도 하지.",shape=box,color=blue];
		1601 -> 1602;
	1598 [label="그 네 사람 중에서 만약에 내가 데이트를 한다면 그나마 아오이뿐인데 아서 때문에 복잡해졌어.",shape=box,color=blue];
		1598 -> 1599;
	1602 [label="불쌍한 '닉스'를 설계한 누군가는 킬러를 만들고 있었어. 그게 바로 나야. 효율적이고. 치명적이고. 클레이모어처럼 귀엽기까지 한.",shape=box,color=blue];
		1602 -> 1603;
	1599 [label="제안은 고맙지만, 그런 일은 백만 년이 지나도 벌어지지 않을 거야.",shape=box,color=blue];
		1599 -> 1600;
	1603 [label="일상적인 업무에서는 괜찮지만, 회사 파티에서 크리스마스 장식 밑에 걸어 다니는 죽음의 함정과도 같은 나와 키스할 사람이 누가 있겠어?",shape=box,color=blue];
		1603 -> 1604;
		1603 -> 1606;
	1600 [label="Chat ends.",color=orange];
	1604 [label="네가 걱정하는 건 이런 우발적인 상처인 거지. 그런 일이 있었던 거야? 함께 있던 사람을 다치게 한 적이 있어?",shape=box,color=red];
		1604 -> 1605;
	1606 [label="그러니까 내 말은, 적어도 좋은 소식은 사고가 났을 때, 홀바니아에서 초기화 이후 죽은 사람이 없다는 거야.",shape=box,color=red];
		1606 -> 1607;
	1605 [label="아니, 그런 일은 없었어. 내가 그렇게 되도록 놔두지 않았거든. 알겠니?",shape=box,color=blue];
		1605 -> 1608;
	1607 [label="...",shape=box,color=blue];
		1607 -> 1609;
	1608 [label="파트너도 없고, 사상자도 없고. 하지만 위험을 감수할 가치는 없어.",shape=box,color=blue];
		1608 -> 1610;
	1609 [label="그걸 생각하지 못했네.",shape=box,color=blue];
		1609 -> 1611;
	1610 [label="죄책감에 시달리느니 외로운 게 나은 거 같아, 고마워.",shape=box,color=blue];
		1610 -> 1612;
	1611 [label="하지만 우리의 기억은 지속되잖아.",shape=box,color=blue];
		1611 -> 1613;
	1612 [label="그럼 엔트라티 주사 이후로는 계속 혼자였던 거야?",shape=box,color=red];
		1612 -> 1618;
	1613 [label="하지만 상황이 나아진다고 해도, 한 번 머리를 물어뜯은 사람과 관계를 유지하고 싶어 하는 사람은 없을 거야.",shape=box,color=blue];
		1613 -> 1614;
	1618 [label="+20 Chemistry",color=orange];
		1618 -> 1615;
	1614 [label="루아가 슬퍼했어. 지금 술 한잔해야겠네.",shape=box,color=blue];
		1614 -> 1620;
	1615 [label="맞아. 내가 기꺼이 감수할 수 있는 타협인 거지.",shape=box,color=blue];
		1615 -> 1616;
	1620 [label="Chat ends.",color=orange];
	1616 [label="미안해. 이런 얘기를 한 게 좋은 생각이었는지 모르겠네.",shape=box,color=blue];
		1616 -> 1617;
	1617 [label="잠시 혼자 있어야 할 것 같아.",shape=box,color=blue];
		1617 -> 1619;
	1619 [label="Chat ends.",color=orange];
}