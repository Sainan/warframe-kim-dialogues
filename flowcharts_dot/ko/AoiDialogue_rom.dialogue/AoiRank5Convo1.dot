digraph {
	3063 [label="AoiRank5Convo1 begins.",color=orange];
		3063 -> 3064;
	3064 [label="엘레노어에게 잘 대해준 점에 대해 너에게 단 한 번도 고맙다고 말한 적이 없었어.",shape=box,color=blue];
		3064 -> 3065;
	3065 [label="그러니 고마워 <3",shape=box,color=blue];
		3065 -> 3071;
		3065 -> 3070;
		3065 -> 3072;
	3071 [label="나한테 고맙다고 말할 필요는 없지만, 말해준 점에 대해서 고맙게 생각해.",shape=box,color=red];
		3071 -> 3069;
	3070 [label="물론이지. 그녀는 헥스의 일원이잖아.",shape=box,color=red];
		3070 -> 3069;
	3072 [label="내가 그녀를 못살게 굴까 봐 걱정했어?",shape=box,color=red];
		3072 -> 3069;
	3069 [label="네가 엘레노어에 대해 경계하는 첫번째 헥스 멤버는 아닐 거야. 그리고, 내 말 믿어, 난 헥스의 모두를 사랑해. 그러니 네 맘이 지금과 달랐어도 이해했을 거야. - 하지만 다른 그 맘을 바꾸기 위해 부단히도 노력했을 거야.",shape=box,color=blue];
		3069 -> 3066;
		3069 -> 3067;
	3066 [label="사람들이 엘레노어를 의심했어? 진심으로?",shape=box,color=red];
		3066 -> 3068;
	3067 [label="아서가 자기 누이를 사람들이 경계하는 걸 묵인했다는 점이 더 믿기 힘든데.",shape=box,color=red];
		3067 -> 3068;
	3068 [label="초반엔 레티, 퀸시 둘이서 의심을 품었고. 그녀가 완전히 테크병에 잠식되어갈까봐 걱정했었어. 아서가 그 말을 듣지 않았기 때문에, 걔네 나름 우려되는 부분에 관해선 조용히 있었지만, 우리 모두 어느 정도에서 그것을 느꼈어. 그리고 *우리*가 무언가를 감지했다면, 엘레노어가 얼마나 날카롭고 명확하게 움직일지 상상해봐",shape=box,color=blue];
		3068 -> 3074;
		3068 -> 3073;
		3068 -> 3075;
	3074 [label="솔이시여 아서에게 축복을. 그는 좋은 동생이야.",shape=box,color=red];
		3074 -> 3076;
	3073 [label="사람들이 항상 뭘 생각하는지 알고 있는 그녀에게 있어서 참을 수 없는 일이었을 것 같다.",shape=box,color=red];
		3073 -> 3077;
	3075 [label="레티랑 퀸시에게 정말 실망했어.",shape=box,color=red];
		3075 -> 3077;
	3076 [label="걔는 좋은 동생이야. 맞아. 그렇지만 그 점이 당시 엘레노어의 상황을 더 어렵게 만들었다고 생각해. 걘 자기 누나 지키기 위해서 필사적이었고 만약에라도 감염으로 인해 엘레노어가 너무 많은 고통을 겪는다고 믿었다면, 그 문제를 자기 손으로 직접 해결하려 했을 거야.",shape=box,color=blue];
		3076 -> 3078;
		3076 -> 3079;
	3077 [label="걔네들은 그저 무서웠을 뿐이야. 공포는 사람들을 이상한 방식으로 움직이게 만드니까.",shape=box,color=blue];
		3077 -> 3080;
		3077 -> 3081;
	3078 [label="걔가... 자기 손으로 누나를 죽였을 수도 있었다라는 말을 하는 거야?",shape=box,color=red];
		3078 -> 3082;
	3079 [label="통제력을 잃어간다는 공포는 매우 무서웠을 거야. 특히 아서가 엘레노어를 그렇게 지켜보고 있으니까.",shape=box,color=red];
		3079 -> 3082;
	3080 [label="분명히 해두자면, 팀은 그 이후로도 많은 진전을 보였어.",shape=box,color=red];
		3080 -> 3086;
	3081 [label="그때 당시에, 걔네들이 두려움을 극복할 수 있었으면 좋았을 텐데 말이지.",shape=box,color=red];
		3081 -> 3085;
	3082 [label="난 아서가 그녀를 죽일 거라고는 생각도 못 했는데, 엘레노어는 했었나 봐. 이건 그녀와 아서 사이의 문제지만, 난 엘레노어가 더 이상 그런 식으로 생각하지 않게 돼서 다행이야.",shape=box,color=blue];
		3082 -> 3083;
		3082 -> 3084;
	3086 [label="내가 듣기론 사람들에게 정말로 트라우마를 부여하는 건 그들에게 일어나는 사건이 아니라, 그 사건에서 스스로가 어떻게 반응하느냐에 따라 결정된대. 레티와 퀸시의 마음을 생각했을 때, 걔네가 가진 두려움으로 엘레노어에게 무슨 일이 일어나게 했다면 걔넨 스스로를 절대 용서하지 못했으리라 확신이 들어.",shape=box,color=blue];
		3086 -> 3088;
		3086 -> 3087;
	3085 [label="+5 Chemistry",color=orange];
		3085 -> 3086;
	3083 [label="그녀가 무엇보다도 그런 종류의 두려움까지 안고 있었다는 것은 상상하기 어려워.",shape=box,color=red];
		3083 -> 3089;
	3084 [label="엘레노어가 그 문제 때문에 떠나려고 한 적 있었어?",shape=box,color=red];
		3084 -> 3090;
	3088 [label="그렇게 될 뻔 했어?",shape=box,color=red];
		3088 -> 3090;
	3087 [label="걔네가 인간이라는 점에서 비난하긴 힘들 것 같네.",shape=box,color=red];
		3087 -> 3090;
	3089 [label="+5 Chemistry",color=orange];
		3089 -> 3090;
	3090 [label="변이 후, 엘레노어는 모든 사람이 어떻게 반응하는 지 주의 깊게 살폈어. 난 그녀가 자기 자신의 선택 사항들을 고려하는 것을 볼 수 있었고, 이대로 머무르면 이점보다 단점이 더 많을 것이라 생각했을 거야. 엘레노어 스스로가 헥스를 돕고자 했지만, 다른 사람들이 그녀를 바라보는 눈빛은 멀리서 더 많은 도움을 줄 수 있는거 아닌가를 궁금해 하더라고.",shape=box,color=blue];
		3090 -> 3092;
		3090 -> 3091;
	3092 [label="어이가 없네. 그녀와 같은 초능력이 얼마나 대단한지 모르는 거야? 엘레노어는 매우 귀중한 사람이라고.",shape=box,color=red];
		3092 -> 3094;
	3091 [label="너무 불공평해. 다른 사람들은 그녀가 헥스를 위해 얼마나 많은 것들을 기꺼이 포기할지를 보려고도 안했잖아.",shape=box,color=red];
		3091 -> 3093;
	3094 [label="그녀는 멀리서도 스스로의 힘을 쓸 수 있고, 자신의 존재로 우리에게 부담을 주지 않고도 연결을 유지할 수 있을 거라고 생각했어.",shape=box,color=blue];
		3094 -> 3095;
		3094 -> 3096;
	3093 [label="+5 Chemistry",color=orange];
		3093 -> 3094;
	3095 [label="이해했어. 그녀는 팀원들이 안전하다고 느끼게 해주려고 팀과 함께하는 선택지를 기꺼이 희생했구나.",shape=box,color=red];
		3095 -> 3097;
	3096 [label="홀바니아에 혼자 있었다면 엘레노어는 심각한 위험에 빠졌을 거야.",shape=box,color=red];
		3096 -> 3097;
	3097 [label="어느 날 밤, 아미르마저 잠들었을 때, 엘레노어는 실제로 거의 떠날 뻔했어. 조용히, 한밤중에 말이야. 우리에게 작별 인사조차 안 남기고.",shape=box,color=blue];
		3097 -> 3098;
		3097 -> 3099;
		3097 -> 3100;
	3098 [label="가슴 아픈 일이야.",shape=box,color=red];
		3098 -> 3101;
	3099 [label="모두에게 다행스럽게도, 그런 일은 일어나지 않았구나.",shape=box,color=red];
		3099 -> 3103;
	3100 [label="그녀는 그 때 엄청 외로웠을 거야.",shape=box,color=red];
		3100 -> 3102;
	3101 [label="+5 Chemistry",color=orange];
		3101 -> 3103;
	3103 [label="무슨 일이 일어났을지 상상하기도 싫지만... 난 계속 엘레노어를 지켜보며 옆에 있어주려고 노력했어.",shape=box,color=blue];
		3103 -> 3104;
	3102 [label="+5 Chemistry",color=orange];
		3102 -> 3103;
	3104 [label="누군가와 함께 있는데 그 누군가의 마음이 실제로 거기 없을 때의 감각을 알아? 그들의 현재에 머물려고 아무리 노력해도, 그 마음이 계속 표류하며 떠다니는거? 난 그걸 알아채버렸어...",shape=box,color=blue];
		3104 -> 3105;
		3104 -> 3106;
	3105 [label="넌 그 순간 그녀에게 꼭 필요한 존재였던 것 같아.",shape=box,color=red];
		3105 -> 3109;
	3106 [label="팀의 행복에 관한 문제라면, 그 어떠한 것도 널 지나쳐 갈 수 없지.",shape=box,color=red];
		3106 -> 3109;
	3109 [label="그녀가 스스로의 초능력을 조절하는 법을 배우기 위해 멀리 떨어져 있던 것인지, 아니면 사람들이 그녀를 어떻게 보는지 의식적으로 살피기 위해 멀리 떨어진 것인지 알 길이 없었어. 그래서 나도 그녀를 계속 봤던거고.",shape=box,color=blue];
		3109 -> 3108;
	3108 [label="엘레노어가 아토미사이클에 시동거는 것을 느낀 순간에, 차고에 있는 모든 아토미사이클을 걸어 잠그고 그녀를 막으러 달려나갔어.",shape=box,color=blue];
		3108 -> 3107;
		3108 -> 3110;
	3107 [label="완전 너 다웠네. 그녀가 머무른 이유는 바로 너야.",shape=box,color=red];
		3107 -> 3112;
	3110 [label="용감한 행동이였어.",shape=box,color=red];
		3110 -> 3112;
	3112 [label="엘레노어가 정말로 원했다면 그녀를 보내줬을 거야. 그렇지만, 엘레노어는 먼저 나와 마음을 털어놓지 않고는 떠나지 않았을 거야, 하하.",shape=box,color=blue];
		3112 -> 3113;
		3112 -> 3111;
		3112 -> 3114;
	3113 [label="그거 완전 너답다 하하. 마음을 터놓는 솔직한 대화는 잘 진행됐어?",shape=box,color=red];
		3113 -> 3116;
	3111 [label="네가 그녀를 위해 거기에 있어줘서 기뻐. 그날 밤은 아마도 엘레노어에게 모든 것을 바꿔 놓았을 거야.",shape=box,color=red];
		3111 -> 3116;
	3114 [label="그리고 그 마음을 터놓는 대화가 엘레노어를 구했고, 헥스도 구했을 거야.",shape=box,color=red];
		3114 -> 3116;
	3116 [label="오, 우리 해가 뜰 때까지 얘기를 나눴어. 아미르가 잠들었을 때니까, 핀볼 게임도 같이했고- 우리 둘끼리만.",shape=box,color=blue];
		3116 -> 3117;
	3117 [label="실없고 재밌었어. 엘레노어가 가장 필요로 하던 종류의 즐거움이었으니까.",shape=box,color=blue];
		3117 -> 3118;
		3117 -> 3115;
	3118 [label="어떻게 그녀에게 모든 것이 괜찮다고 확신시켰어?",shape=box,color=red];
		3118 -> 3119;
	3115 [label="가끔 가장 간단한 것이 가장 큰 차이를 만들어 내니까.",shape=box,color=red];
		3115 -> 3119;
	3119 [label="내가 특별히 말한 건 없는 것 같아. 단지... 거기에 있는 거. 친구로 있어주는 거.",shape=box,color=blue];
		3119 -> 3120;
	3120 [label="그녀의 변이 후, 누군가가 그녀는 단지 보호가 필요한 아서의 연약한 누나가 아니라는 것을 그녀 스스로에게 처음으로 선보였어. 그날 밤, 나는 그녀가 헥스에서 자신만의 자리를 개척할 수 있다는 것을 깨닫는 데 도움이 되었다고 생각해.",shape=box,color=blue];
		3120 -> 3121;
		3120 -> 3122;
	3121 [label="그걸 네가 해서 기뻐. 그녀한테 필요했던 거였어.",shape=box,color=red];
		3121 -> 3123;
	3122 [label="이게 바로 진정한 리더십이라고 생각해, 아오이.",shape=box,color=red];
		3122 -> 3123;
	3123 [label="솔직히 말해서, 나한테도 그런게 필요했어. 우리는 어디에 소속되어 있는지를 알 때 더 강해지니까.",shape=box,color=blue];
		3123 -> 3124;
		3123 -> 3125;
	3124 [label="엘레노어는 사람들이 생각하는 것보다 훨씬 강하지만, 네가 그녀 곁에 있어준 점이 무엇보다 중요하다고 생각해.",shape=box,color=red];
		3124 -> 3126;
	3125 [label="네가 팀을 하나로 유지하는데 한 몫했다고 생각해.",shape=box,color=red];
		3125 -> 3127;
	3126 [label="+5 Chemistry",color=orange];
		3126 -> 3127;
	3127 [label="네가 우리와 함께 해줬기에, 그 끔찍한 챕터에서 다시 살아날 수 있었다는 걸 막 깨달았어",shape=box,color=blue];
		3127 -> 3128;
	3128 [label="하지만 너와 우리 모두는 이런 과정이 필요가 없었어. 넌 바로 이해해 줬으니까",shape=box,color=blue];
		3128 -> 3129;
	3129 [label="그래서 고마워",shape=box,color=blue];
		3129 -> 3130;
		3129 -> 3132;
		3129 -> 3131;
		3129 -> 3133;
	3130 [label="엘레노어는 훌륭한 여성으로서 대접받을 만한 사람이야.",shape=box,color=red];
		3130 -> 3134;
	3132 [label="별 일 아니야. 우린 서로의 등 뒤를 지켜줘야 하니까.",shape=box,color=red];
		3132 -> 3134;
	3131 [label="엘레노어를 위해 그 때, 거기에 있어준 거 고마워.",shape=box,color=red];
		3131 -> 3134;
	3133 [label="넌 이 팀을 하나로 붙어있게 해주는 접착제와도 같은 존재야, 아오이.",shape=box,color=red];
		3133 -> 3134;
	3134 [label="넌 내가 가장 좋아하는 사람 중 하나야 <3 그냥 그렇다고",shape=box,color=blue];
		3134 -> 3135;
	3135 [label="Chat ends.",color=orange];
}