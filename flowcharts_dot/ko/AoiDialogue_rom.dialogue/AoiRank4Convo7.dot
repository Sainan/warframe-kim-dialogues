		2939 -> 2940;
	2952 [label="Chat ends.",color=orange];
	2957 [label="삶을 바꿔버릴 만큼 강력해. 내가 아는 동물 친구들이 있어. 카비아라고 불려. 걔들은 보이드를 만지고나서 병든 마법에 걸린 것처럼 말하는 법을 배웠어.",shape=box,color=red];
