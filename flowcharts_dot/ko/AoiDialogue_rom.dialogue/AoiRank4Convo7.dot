		2925 -> 2926;
	2929 [label="대답하기 쉽지 않네. 소리, 단어들, 보이드로부터 나오는 말들이야. 저주에 좀 더 가까워. 들을 수 있는 모든 귀에 무언가를 전달하는 거지.",shape=box,color=red];
