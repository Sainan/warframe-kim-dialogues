	3405 [label="난 아미르한테 방송을 보여줬고, 나머지는 아미르가 다 처리했어!",shape=box,color=blue];
		3405 -> 3409;
	3406 [label="뭐어어 그건 팀 노력의 결과물었어. 내가 걔의 사이드킥이었다고 불러도 좋아 ^_^",shape=box,color=blue];
