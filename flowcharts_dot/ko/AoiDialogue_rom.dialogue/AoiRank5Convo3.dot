		3389 -> 3392;
	3391 [label="안쓰러웠어? 너희 둘 꽤 친하다고 생각했어.",shape=box,color=red];
		3391 -> 3393;
	3392 [label="시간이 좀 걸렸어. 아미르는 군 경험없이 우리랑 합류했기 때문에, 전투는 언제나 그에게 벅찼어",shape=box,color=blue];
		3392 -> 3394;
	3393 [label="오, 맞아! 우리 둘 친한 사이 맞아. 아케이드에서 우리 둘이 나눈 재밌는 추억 중 일부는 게임하고 On-lyne 마구 듣고 즐겼던 거야.",shape=box,color=blue];
		3393 -> 3395;
	3394 [label="걔는 영웅이 되는 조건이 전투만이 아니란 걸 깨달아야 했어",shape=box,color=blue];
		3394 -> 3396;
	3395 [label="하지만 그 사이드 킥 그런거? 난 걔가 자기자신을... 과소평가 하고 있단 걸 알 수 있었어.",shape=box,color=blue];
		3395 -> 3396;
	3396 [label="난 아미르와 같은 훌륭한 해커들이 자기자신만의 방법으로 영웅이 될 수 있단 걸 항상 알고 있었어",shape=box,color=blue];
		3396 -> 3399;
