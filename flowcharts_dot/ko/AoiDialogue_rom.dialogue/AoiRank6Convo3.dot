	j20845620 [label="RL;CBA: 알브레히트는 보이드로 향했고, 패닉 상태가 되어서, 무심의 손가락을 훔쳐 나왔어.",shape=box,color=red];
		j20845620 -> j3355010348;
	j2486158720 [label="그래. 좋아. 그래서. 알브레히트가... 보이드 속으로 진입하는 방법을 \"발견\"한 최초의 인물이라는 거야.",shape=box,color=red];
