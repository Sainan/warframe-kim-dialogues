		3935 -> 3937;
	3936 [label="가볍게 말하자면, 일이... 틀어진거야. 그 인간은 당황했고, 충격도 받았고, 그 잠수종이 기울어지면서 면도날처럼 날카로운 막의 가장자리에 부딪힌거지.",shape=box,color=red];
