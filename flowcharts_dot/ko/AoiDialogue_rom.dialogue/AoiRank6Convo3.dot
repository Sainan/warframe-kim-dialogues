		j2862616960 -> j914324551;
	j1793838082 [label="가끔, 엔트라티가 나를 여기로 돌려보낸 게 바로 그런 점 때문이 아닐까 하는 생각이 들어. 모두와 함께 말이야.",shape=box,color=red];
