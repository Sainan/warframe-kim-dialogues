		j3140541754 -> j1421427623;
	j3187867752 [label="큰 함선인 레일잭은 성해함 장치라는 걸 사용해 - 그 안에는 무심의 잘린 손가락 복제품이 들어가 있어.",shape=box,color=red];
		j3187867752 -> j1954513340;
	j1421427623 [label="그걸 이용해서 보이드를 통해 행성 간 장거리를 가로지르며 이동하는 거야. 보이드를 통과하는 거지.",shape=box,color=red];
