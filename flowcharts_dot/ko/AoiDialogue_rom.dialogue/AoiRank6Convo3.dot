	j2664150861 [label="우주 여행은... 재미있어야 해. 멋지고. 탐험으로... 가득 차고, 새로운 종족을 만나는 거야",shape=box,color=blue];
		j2664150861 -> j3320363378;
	j3320363378 [label="대담하게 어딘가로 향해야 하고 나도 잘 모르겠어 아미르가 보던 쇼 중 하나에 전체 연설문이 있어",shape=box,color=blue];
