		3931 -> 3933;
	3932 [label="그래. 좋아. 그래서. 알브레히트가... 보이드 속으로 진입하는 방법을 \"발견\"한 최초의 인물이라는 거야.",shape=box,color=red];
		3932 -> 3934;
