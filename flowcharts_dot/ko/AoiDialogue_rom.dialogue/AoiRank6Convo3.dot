		3961 -> 3960;
	3962 [label="\"크라의 실낱\"에는 뭔가 특별한 게 있어. 엄청 복잡한 거라고 해야하나? 뭔가...나도 잘 모르는 그런거?",shape=box,color=red];
		3962 -> 3964;
