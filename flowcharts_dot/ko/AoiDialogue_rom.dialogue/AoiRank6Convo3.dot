		j2637585381 -> j3140541754;
	j342291996 [label="글쎄, 큰 함선이냐 작은 함선이냐에 따라 다르겠지만 - 둘 다 보이드를 통해 먼 거리를 건너는 거야.보이드를 통과해서.",shape=box,color=red];
