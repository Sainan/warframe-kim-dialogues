		j3355010348 -> j1782338584;
	j2317744745 [label="그건, 일종의 잠수종이었어. 세리글래스라는 걸로 제작됐고. 그 인간은 두 세계 사이에 막 같은 걸 펼쳤지.",shape=box,color=red];
		j2317744745 -> j4013945329;
	j1782338584 [label="정말로 긴; 하기가 싫다라는 뜻. 퀸시가 알려줬어.",shape=box,color=red];
		j1782338584 -> j4103560400;
	j4013945329 [label="가볍게 말하자면, 일이... 틀어진거야. 그 인간은 당황했고, 충격도 받았고, 그 잠수종이 기울어지면서 면도날처럼 날카로운 막의 가장자리에 부딪힌거지.",shape=box,color=red];
		j4013945329 -> j2142418401;
	j4103560400 [label="허...",shape=box,color=blue];
		j4103560400 -> j1264337590;
	j2142418401 [label="세리글래스 종이 깨지고 그 인간이 보이드 속으로 떨어졌어.",shape=box,color=red];
		j2142418401 -> j1931618234;
	j1264337590 [label="두번째로",shape=box,color=blue];
		j1264337590 -> j688937880;
	j1931618234 [label="그리고 정신을 차렸을 때, 다시 연구실로 돌아와 있었어. 하지만 그 곳은 그 인간의 연구실이 아니었어. 스스로를 응시하고 있었지만 그건 그 자신이 아니었어. 그리고 \"그\"는 어머니만이 알 수 있는 이름을 불렀어.",shape=box,color=red];
		j1931618234 -> j2968369920;
	j688937880 [label="****무심의 손가락을 네가 가지고 있다?!?!?!****",shape=box,color=blue];
		j688937880 -> j4146327581;
	j2968369920 [label="그래서, 알브레히트는 목숨 걸고 도망쳤어. 깨진 세리글래스에 베였고, 자신의 피로 딸에게 자기 뒤에 있는 막을 닫으라고 썼어 -",shape=box,color=red];
		j2968369920 -> j2939034653;
