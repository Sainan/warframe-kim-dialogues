	j3927079999 [label="그래서 내가 처음부터 쥐들을 키웠던 거야\n쥐들의 수명은 짧지만 그들의 삶 자체를 잊지 않으니까\n그들이 얻을 수 있는 모든 부스러기들에서 기쁨을 찾기 위해\n그리고 그들에게 바친 모든 사랑을 되돌려주기 위해서\n그런 것들이 언제 사라질지 모르잖아",shape=box,color=blue];
