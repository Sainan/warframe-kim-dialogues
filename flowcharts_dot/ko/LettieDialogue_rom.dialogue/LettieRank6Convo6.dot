digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LettieRank6Convo6 begins." [color=orange];
		"LettieRank6Convo6 begins." -> j3446112295;
	j3446112295 [label="엔트라티가 거의 만회했지\n미네르바를 보내줘서 말이야\n*거의*",shape=box,color=blue];
		j3446112295 -> j4058585348;
		j3446112295 -> j4020197129;
	j4058585348 [label="내가 걱정해야할 일이야?",shape=box,color=red];
		j4058585348 -> j1950369554;
	j4020197129 [label="너희 둘 잘 어울릴 것 같았는데, ㅋㅋㅋ.",shape=box,color=red];
		j4020197129 -> j3591810165;
	j1950369554 [label="Jajaja 아니\n하지만 같이 할 동료들이 많으면 좋지\n특히 미네르바 말이야, 그 사람은 스스로 잘 해낼 수 있어\n남은 잔해를 바닥에서 긁어내지 않아도 될 존재가 주변에 있다는 것 만으로도 좋다고",shape=box,color=blue];
		j1950369554 -> j292067237;
	j3591810165 [label="JAJAJAJA\n무슨 의미야?!\n같이 할 동료들이 많아서 좋아\n특히 미네르바 말이야, 그 사람은 스스로 잘 해낼 수 있어\n남은 잔해를 바닥에서 긁어내지 않아도 될 존재가 주변에 있다는 것만으로도 좋다고",shape=box,color=blue];
		j3591810165 -> j292067237;
	j292067237 [label="그리고 벨리미르는 날 웃게 만들어\n난 스스로가 누구인지 정확히 아는 남자를 존경해\nAlguien auténtico y fiel a sí mismo, ¿sí?\n그 양반은 얼마 전에 아오이가 자기 발톱을 칠하게 냅두기도 했어 jajajaja\n내가 좋아하는 클래식 리버타시안 머슬카에 대해 이야기하면서 말이야\n아무것도 거슬리지 않는다는 듯이",shape=box,color=blue];
		j292067237 -> j369316342;
	j369316342 [label="더 많은 이들이 올지도 모르겠지만\n정말이지 아주 간만에 처음으로\n그렇게 되기를 바라게 됐어",shape=box,color=blue];
		j369316342 -> "Chat ends.";
	"Chat ends." [color=orange];
}