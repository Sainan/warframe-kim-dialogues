		2795 -> 2798;
	2796 [label="¿Sí?
그래서 화낼 일이 뭐길래?",shape=box,color=blue];
		2796 -> 2798;
	2797 [label="¿Sí?
그래서 뭘 이해해줬음 하는데?",shape=box,color=blue];
		2797 -> 2798;
	2798 [label="네가 싫어하는 상황에 놓이게 만들고 싶지 않아. 이 문제를 우리가 전에는 이야기해 본 적이 없는 문제라는 것도 알고. 그러니 거절해도 괜찮아. 단지 이 점을 알아줬으면 좋겠어.",shape=box,color=red];
		2798 -> 2799;
	2799 [label="우리의 관계는 나에게 중요해 - 그것도 아주 많이 중요해 - 그리고 진심이야. 그걸 의심하지 않았으면 해.",shape=box,color=red];
		2799 -> 2800;
	2800 [label="아, entiendo...
