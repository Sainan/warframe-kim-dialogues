		2800 -> 2801;
		2800 -> 2802;
	2801 [label="소중히 여겨. 하지만 너도 정말로 아끼고 있어.",shape=box,color=red];
		2801 -> 2803;
	2802 [label="너라면 빨리 알아낼 수 있을 거라고 짐작했어야 했는데.",shape=box,color=red];
		2802 -> 2804;
	2803 [label="Ay, sí
