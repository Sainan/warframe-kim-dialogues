	j1486729066 [label="[종료.]",shape=box,color=red];
		j1486729066 -> j3702107533;
	j3712038380 [label="항상\n하지만 너한테는 시간 쓸 수 있는데?\n¿Qué?",shape=box,color=blue];
		j3712038380 -> j97671136;
	j3702107533 [label="Boolean LettieConsentComplete is now true.",color=orange];
		j3702107533 -> "Chat ends.";
	j97671136 [label="너랑 중요한 이야기를 하고 싶은데, 듣고 네가 괜찮을지 확인하고 싶어.",shape=box,color=red];
		j97671136 -> j2301217305;
	j2301217305 [label="내게 중요한 건 내가 너에게 어떤 식으로든 거짓말을 하고 있거나, 솔직하게 대하지 않는다는 느낌을 네가 받지 않게 해야 한다는 점이거든.",shape=box,color=red];
		j2301217305 -> j1419412255;
		j2301217305 -> j3299699419;
		j2301217305 -> j1262939190;
	j1419412255 [label="제발 아프게 하지 말아 줘.",shape=box,color=red];
		j1419412255 -> j543114778;
	j3299699419 [label="제발 화내지 말아 줘.",shape=box,color=red];
		j3299699419 -> j3448110549;
	j1262939190 [label="이해해줬으면 좋겠어.",shape=box,color=red];
		j1262939190 -> j2661460521;
	j543114778 [label="Jajajajaj\n우린 이거에 대해서 얘기했잖아\n난 내가 좋아하는 방식으로만 널 아프게 한다고\n이제 뭔 말이 하고 싶은 건데",shape=box,color=blue];
		j543114778 -> j516518700;
	j3448110549 [label="¿Sí?\n그래서 화낼 일이 뭐길래?",shape=box,color=blue];
		j3448110549 -> j516518700;
	j2661460521 [label="¿Sí?\n그래서 뭘 이해해줬음 하는데?",shape=box,color=blue];
		j2661460521 -> j516518700;
	j516518700 [label="네가 괜찮지 않다 느끼는 상황에 놓이게 만들고 싶지 않아. 우리가 예전엔 이야기해본 적 없는 문제라는 것도 알고. 그러니 거절해도 괜찮아. 단지 이 점을 알아뒀으면 좋겠어.",shape=box,color=red];
		j516518700 -> j2725418802;
	j2725418802 [label="우리의 관계는 내게 중요해. 아주 중요해. 그리고 나는 진심이고. 네가 그걸 의심하지 않았으면 좋겠어.",shape=box,color=red];
		j2725418802 -> j3470378416;
	j3470378416 [label="아, entiendo...\n그냥 알고 싶은 게 있는데\n그 상대방을 정말로 아끼니, solecito?\n¿Quiénes son?",shape=box,color=blue];
		j3470378416 -> j3963598041;
		j3470378416 -> j2930918339;
	j3963598041 [label="소중히 여겨. 하지만 너도 정말로 아끼고 있어.",shape=box,color=red];
		j3963598041 -> j2053088865;
	j2930918339 [label="너라면 빨리 알아낼 수 있을 거라고 짐작했어야 했는데.",shape=box,color=red];
		j2930918339 -> j4022676750;
	j2053088865 [label="Ay, sí\n탓할 수도 없네, 그렇게 많이 보고 다니고\n여행도 하고 다니니까\n난 괜찮아",shape=box,color=blue];
		j2053088865 -> j3008602848;
	j4022676750 [label="내가 속인거야\n엘레노어가 경고해줬어\nJajaja 걘 엄청난 수다쟁이니까",shape=box,color=blue];
		j4022676750 -> j598759402;
	j3008602848 [label="하지만 헥스는 안돼\nMi familia no, ¿por favor?\n그랬다간 일주일 동안 수술용 패드로 몸을 문질러야 할 것 같으니",shape=box,color=blue];
		j3008602848 -> j775589868;
	j598759402 [label="탓할 수도 없네, 그렇게 많이 보고 다니고\n여행도 하고 다니니까\n난 괜찮아",shape=box,color=blue];
		j598759402 -> j3008602848;
	j775589868 [label="+20 Chemistry",color=orange];
		j775589868 -> j647002381;
	j647002381 [label="넌 나에게 매우 중요하고 소중해, solecito\n그리고 상대방이 너에게 행복을 가져다준다면?\n상대방이 나에게도 같은 것을 가져다줄 거야\n그만큼 간단한거지",shape=box,color=blue];
		j647002381 -> j2480774619;
	j2480774619 [label="오\n그리고 언젠가 그쪽을 여기로 데려올 방법을 찾아줘\n만나고 싶으니까",shape=box,color=blue];
		j2480774619 -> j2709761363;
		j2480774619 -> j3577999127;
	j2709761363 [label="네 아가씨. :)",shape=box,color=red];
		j2709761363 -> j3702107533;
	j3577999127 [label="내가 할 수 있는 건 해볼게.",shape=box,color=red];
		j3577999127 -> j3702107533;
}