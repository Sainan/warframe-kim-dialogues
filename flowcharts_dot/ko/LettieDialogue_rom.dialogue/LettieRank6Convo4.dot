		j2381764028 -> j362194976;
	j2352643683 [label="무슨 일 있어?",shape=box,color=red];
		j2352643683 -> j2764014807;
	j362194976 [label="Sólo las arañas\n다시 편안하게 느끼는 것 같아\n이 또한 지나갈 일이지만",shape=box,color=blue];
		j362194976 -> j4044414027;
	j2764014807 [label="아니, 새로울 거 없어\nSólo las arañas\n다시 편안하게 느끼는 것 같아\n이 또한 지나갈 일이지만",shape=box,color=blue];
		j2764014807 -> j4044414027;
	j4044414027 [label="가끔은\n풀 수 있는 문제처럼 쉬웠음 좋겠어\n그러면 고칠 수 있을텐데 말이야, ¿sí?\n말을 붙이고, 엄청 쎄게 때릴텐데 jajaja",shape=box,color=blue];
		j4044414027 -> j922969769;
	j922969769 [label="문제는 해결할 수 있어\n문제에는 정답이란 게 있으니까\nLos sentimientos no se arreglan\n믿어봐, 시도했었으니까",shape=box,color=blue];
		j922969769 -> j724376448;
		j922969769 -> j1426928328;
	j724376448 [label="행복해질 일이 많다고 생각하지만서도.",shape=box,color=red];
		j724376448 -> j754052018;
	j1426928328 [label="두비리에서 \"감정을 고치는 것\"이 때로는 최악의 선택이라는 걸 아주 어렵게 배웠어.",shape=box,color=red];
		j1426928328 -> j3068043832;
	j754052018 [label="Ay, sí, 그래\n그리고 내가 그러리라는 걸 알아\n그리고 가끔은\n사람들이 나의 그런 부분을 이해해줬으면 좋겠어\n절대로 그런 부분에 빠져들어가지 않을 거란 걸 말이야",shape=box,color=blue];
		j754052018 -> j3933983662;
	j3068043832 [label="Síí...\n가끔 유혹적이긴 하지만 jajaja\n그냥 다 사라지길 바랄 뿐이야\n하지만 무슨 일이 일어나는 지 알려줬잖아\n모든게 마비될 때 말이야",shape=box,color=blue];
		j3068043832 -> j1192350653;
	j3933983662 [label="나도 달랐으면 좋겠어\n그치만 나는 나인걸\n그리고 그런 점에 사과하는 것도 포기했어\n오래전에 말이야",shape=box,color=blue];
		j3933983662 -> "Chat ends.";
	j1192350653 [label="누구에게도 그런 일이 일어나길 바라지 않아\nOk 알브레히트라면 모를까\nPinche güey\n그 인간 마음은 너무 차갑잖아",shape=box,color=blue];
		j1192350653 -> j3930888092;
		j1192350653 -> j4155790831;
	j3930888092 [label="어떻게 하면 다른 생각들을 덜 할 수 있을까? 아니면 안에 계속 있는 걸 원해?",shape=box,color=red];
		j3930888092 -> j3121899512;
	j4155790831 [label="그 인간이 장기적인 계획을 가지고 있길 바랄 뿐이야.",shape=box,color=red];
		j4155790831 -> j2290743900;
	j3121899512 [label="으어, 좋은 질문이야\n솔직히 잘 모르겠어\n계속 안에 있는 게 좋을 것 같기도 \n아니면, 나가서 죽여버리는 것도 좋을 것 같고\n¿Te quedas?, ¿o vamos a matar cosas? \n선택지들이 놓여져 있네...",shape=box,color=blue];
		j3121899512 -> j367502390;
		j3121899512 -> j206694573;
	j2290743900 [label="그 cabrón에게 바라는 거 단 하나야\n그 인간이 아주 오래동안 엘레베이터에 타고 있는 거\n나와 함께\n그리고 야구 방망이도 함께",shape=box,color=blue];
		j2290743900 -> j1228105678;
	j367502390 [label="머무르는 것에 투표할게.",shape=box,color=red];
		j367502390 -> j1461714590;
	j206694573 [label="죽이고 다니는 거에 투표할게.",shape=box,color=red];
		j206694573 -> j384616050;
	j1228105678 [label="그 이미지가 내 멘탈을 기분 좋게 만들어\nJajaja",shape=box,color=blue];
		j1228105678 -> j3819368348;
	j1461714590 [label="좋은 선택이야\nM&V와 함께 바에 앉아 있는 거지\n카드나 한 판 둘까\n생각을 좀 바꿔야할지도",shape=box,color=blue];
		j1461714590 -> j3819368348;
	j384616050 [label="Jajaja 좋은 선택이야\n내 머릿 속 생각에서 고통을 빼서 없애버리는 거야\n다른 누군가한테 고통을 주입해서",shape=box,color=blue];
		j384616050 -> j3819368348;
