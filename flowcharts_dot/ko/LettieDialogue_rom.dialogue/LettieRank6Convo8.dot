		j2518703744 -> j2530914963;
	j1499611822 [label="네가 도와줄 수 있는 일은 없어?",shape=box,color=red];
		j1499611822 -> j2530914963;
	j1360868269 [label="JAJAJA 네 비상 연락처로 나 저장해두지 말라고 상기시켜줘\nSííí, 그 애는 미래로 뻗어나가지만 여기로 돌아온다고\n그 놈의 템포럴 아르키-어쩌구 때문에\n하지만... 우리를 위해서도 돌아오는 것 같아, 내 생각엔",shape=box,color=blue];
		j1360868269 -> j3548039105;
	j2273135453 [label="Sííí, 그 놈의 템포럴 아르키-어쩌구 때문에\n하지만... 우리를 위해서도 돌아오는 것 같아, 내 생각엔",shape=box,color=blue];
		j2273135453 -> j3548039105;
	j2530914963 [label="가끔은 시간이 걸려.\n그치만 내가 할 수만 있다면 그 애를 도우려고 노력할거야\n그 애가 의학에 대해 충분히 호기심이 많다는 걸 루아께서도 아시니까 jajaja\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j2530914963 -> j3762522734;
	j3548039105 [label="그 애가 여기 있는게 좋아\n그 애도 그걸 알고 있다고 생각하고\n수술 보조 하는 걸 좋아하는 것 같지만서도...\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j3548039105 -> j356937901;
