		j580547789 -> j3541017210 [label=false,color=brown];
	j2892543958 [label="그 애가 그런 상황에서 도망가고 싶어하는 걸 비난할 순 없어\n내가 할 수만 있었다면, 했을 거고\n하지만\n그 애가 떠나지 않았다는 거 알아차렸어?",shape=box,color=blue];
		j2892543958 -> j420357957;
