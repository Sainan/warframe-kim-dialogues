		j3032858281 -> j463011218;
	j648699606 [label="그 인간이 무서워하고 온 세상이 자신에게 반대할 때의 기분을 느끼게 해주고 싶어\n모두가 그 인간을 비웃을 때\n비웃어주고 싶어",shape=box,color=blue];
		j648699606 -> j4264837853;
	j463011218 [label="누가 그게 계획이래\n그 인간이 어떤 타입인지 알아\n겁쟁이들이야, 전부 다, 다들 안전하다고 생각하는 곳에서 말이나 씨부리고 있지",shape=box,color=blue];
		j463011218 -> j648699606;
	j4264837853 [label="나처럼 생기고 자라는 게 어떤 건지나 알아?\n나처럼 말하고?\n나처럼 입고?\n군 기지에서 그렇지 않은 애들이랑 둘러 싸여있을 때?",shape=box,color=blue];
		j4264837853 -> j1557937066;
	j1557937066 [label="내 스스로를 위해서 맞섰다는 이유로 종종 두들겨 맞은 채로 집에 돌아왔어\nMi mamá는 항상 혀를 내두르면서 내가 머리 숙이고 얌전히 다녀야 한다고 말했지\n¿Quedarme callada?\n지옥처럼",shape=box,color=blue];
		j1557937066 -> j580547789;
