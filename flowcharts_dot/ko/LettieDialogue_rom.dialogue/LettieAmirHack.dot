	j2316161106 [label="VOY A MATAR A ESE PINCHE MOCOSO",shape=box,color=blue];
		j2316161106 -> j265820731;
		j2316161106 -> j3246088298;
	j265820731 [label="너 뭔가 화난 것 같은데...",shape=box,color=red];
		j265820731 -> j2527551401;
	j3246088298 [label="음... 너 혹시 땅콩버터 받았어...?",shape=box,color=red];
		j3246088298 -> j2527551401;
	j2527551401 [label="아니 도대체가 내가\n케첩 팩 500상자로 뭘 하라는 거야\n¡DILE A ESE NIÑO QUE VENGA AQUÍ AHORA MISMO! \n그 자식더러 처리하라 그래\n당장!!",shape=box,color=blue];
		j2527551401 -> j1652044094;
		j2527551401 -> j2416139964;
	j1652044094 [label="이봐, 그러니까, 이거 다 실수야. 아미르는 네 쥐들이 먹을 땅콩버터를 보내려던 거라고.",shape=box,color=red];
		j1652044094 -> j790951015;
	j2416139964 [label="이거 다 오해야. 아미르는 너한테 선물을 보내려던 것 뿐이야.",shape=box,color=red];
		j2416139964 -> j2940424585;
	j790951015 [label="하지만 어쩌다 보니 다 망했네. 아미르가 처리할 떄 내가 도울게.",shape=box,color=red];
		j790951015 -> j3410437217;
	j2940424585 [label="알 게 뭐야 \n¡¡SÁCALAS DE AQUÍ!! \n¡¡AHORA!!",shape=box,color=blue];
		j2940424585 -> "Initiate conversation AmirHack3 in /Lotus/Types/Gameplay/1999Wf/Dialogue/JabirDialogue_rom.dialogue";
	j3410437217 [label="+20 Chemistry",color=orange];
		j3410437217 -> j3439993760;
	"Initiate conversation AmirHack3 in /Lotus/Types/Gameplay/1999Wf/Dialogue/JabirDialogue_rom.dialogue" [label="Initiate conversation AmirHack3 in /Lotus/Types/Gameplay/1999Wf/Dialogue/JabirDialogue_rom.dialogue",color=orange];
		"Initiate conversation AmirHack3 in /Lotus/Types/Gameplay/1999Wf/Dialogue/JabirDialogue_rom.dialogue" -> "Chat ends.";
	j3439993760 [label="¿SÍ? \n다 mis panquecitos를 위한 거였다고?",shape=box,color=blue];
		j3439993760 -> j4012181817;
	"Chat ends." [color=orange];
	j4012181817 [label="¡Ay equis! \n그냥 이거 여기서 다 치워 \n¡¡AHORA!!",shape=box,color=blue];
