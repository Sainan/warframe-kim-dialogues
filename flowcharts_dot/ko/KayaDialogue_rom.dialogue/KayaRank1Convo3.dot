		131 -> 140;
	129 [label="레티는 진짜 정말 엄청나게 차분해. 똑똑하기도 하고. 그래도, 진짜로 당신을 믿어보라고 그랬으니까. 그러니까, 한 번 두고 봐야겠지.",shape=box,color=blue];
