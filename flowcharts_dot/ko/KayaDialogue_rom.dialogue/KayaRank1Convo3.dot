		109 -> 114 [label=false,color=brown];
	111 [label="그래, 난 당신 몰라. 그저 당신이 뭘 할 수 있는지 알고 싶을 뿐이야. 그래서 우리가 대화를 나누는 거고. 진지해지자고.",shape=box,color=blue];
