		j421755303 -> j743497043;
	j943196901 [label="사실, 아미르는 내 원래 가설 중 몇 가지가 틀렸다는 걸 확신시켜 줘서 도움은 됐지만, 이런 건 돈 내면 답을 얻을 수도 있다고도 했고, 당신이 날 도와주지 않는다면, 적어도 미래의 다른 사람과 대화할 수 있다고 말해줬어.",shape=box,color=blue];
		j943196901 -> j107863013;
		j943196901 -> j4229119285;
	j4035221362 [label="우린 꽤 잘 지내고 있어. 레티는 내 뇌에서 0의 끔찍함과 나 자신을 봐주던, 내 예전 선생님을 떠올리게 해.",shape=box,color=blue];
		j4035221362 -> j611515330;
	j2282369107 [label="그거 제안이야? 뭐로 접근할 수 있는데? 무엇이 되든 도움이 될 거야.",shape=box,color=blue];
		j2282369107 -> j933468645;
	j3016314313 [label="시간 여행 하고 싶어하잖아, 근데 어디로 가고 싶은데? 이유는 또 뭐고?",shape=box,color=red];
