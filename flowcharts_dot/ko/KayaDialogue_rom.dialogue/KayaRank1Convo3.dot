		112 -> 118;
	113 [label="그리고 내가 등장해 버리니까 정말로 무서워했어. 누군가가 나타날 거라고는 영감도 전혀 예상치 못했나봐.",shape=box,color=blue];
		113 -> 119;
		113 -> 120;
	116 [label="해봤지. 몇 가지 기본적인 사항에는 동의했지만, 아미르는 구체적이고 재현할 수 있는 시간 여행 정리에는 관심이 없는 듯했어. ",shape=box,color=blue];
