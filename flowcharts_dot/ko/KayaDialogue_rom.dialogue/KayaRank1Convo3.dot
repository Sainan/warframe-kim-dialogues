		123 -> 130;
		123 -> 131;
	122 [label="우린 꽤 잘 지내고 있어. 레티는 내 뇌에서 0의 끔찍함과 나 자신을 봐주던, 내 예전 선생님을 떠올리게 해.",shape=box,color=blue];
