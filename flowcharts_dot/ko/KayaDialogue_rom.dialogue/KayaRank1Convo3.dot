	j4229119285 [label="그런 걸 너한테 돈 받고 의견 팔아제끼는 사람이 있다면 거짓말하는 거야. 도와줄게, 진짜. 그것도 무료로.",shape=box,color=red];
		j4229119285 -> j2504081427;
