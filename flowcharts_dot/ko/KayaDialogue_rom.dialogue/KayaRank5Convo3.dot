		j145506587 -> "Chat ends. Next chat will be KayaRank5Convo4.";
	j2497636145 [label="좋았어어어어 예! 맞아. 그럼 먼저. 스스로에게 집중해 봐. 당신은 스스로를 용, 독수리, 표범 중 어느 쪽이라고 생각해?",shape=box,color=blue];
