	j4226164809 [label="용.",shape=box,color=red];
		j4226164809 -> j1378000544;
	j2380686522 [label="정말 멋진 캐릭터들과 생물들이 있는 거...",shape=box,color=blue];
		j2380686522 -> j3800832828;
	j1180528885 [label="ㅇㅋ 그렇다면 당신은 완전히 꽁지라라로 게임을 시작하겠네",shape=box,color=blue];
		j1180528885 -> j1894789605;
	j4028029531 [label="ㅇㅋ 그러면 당신은 확실히 깃깃버트로 게임을 시작하겠네",shape=box,color=blue];
		j4028029531 -> j520273354;
	j1378000544 [label="ㅇㅋ 그렇다면 당신은 아마 개굴보고로 게임을 시작하겠네.",shape=box,color=blue];
		j1378000544 -> j2104629078;
	j3800832828 [label="그건 중요하지 않아, 어쨌든. 당신쪽부터 시작하자. 당신은 스스로를 용, 독수리, 표범 중 어느 쪽이라고 생각해?",shape=box,color=blue];
