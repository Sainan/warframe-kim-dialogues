	j2845309726 [label="오오오 안녕, 지니몬 카드에 대한 기초를 설명해줘도 될까?",shape=box,color=blue];
		j2845309726 -> j849459810;
	j849459810 [label="물론 아미르는 마침내 같이 놀 수 있는 (그리고 질 수 있는) 사람이 생겨서 정말 기뻐하는 것 같아.",shape=box,color=blue];
		j849459810 -> j2028026021;
	j2028026021 [label="하지만 우리 둘 다 당신을 지니몬에 끌어들이는 게 재밌을 거로 생각했어. ",shape=box,color=blue];
