		j3800832828 -> j4226164809;
	j1894789605 [label="가장 멋진 선택지지만 확실히 까다롭고, 시작할 때 정말 약해.",shape=box,color=blue];
		j1894789605 -> j3079267411;
	j520273354 [label="조금 난이도가 있지만 정말 멋져. ",shape=box,color=blue];
		j520273354 -> j2729160574;
	j2104629078 [label="초심자에게는 좋은 선택이야. ",shape=box,color=blue];
		j2104629078 -> j3361846529;
	j3079267411 [label="그래서 마지막은 어찌 되냐고? 가장 화려하고 위엄있는 표범이 당신 친구로서 있게 되는 거야.",shape=box,color=blue];
		j3079267411 -> j293001801;
	j2729160574 [label="그리고 깃깃버트는 엄청 귀여워 왜냐하면 걔한테 탄산 포도를 먹이면 다른 누구보다도 더 빨리 레벨업할 수 있어서야.",shape=box,color=blue];
		j2729160574 -> j3109495141;
	j3361846529 [label="물론 기본적으로 지금까지 가장 귀여운 개구리로 게임을 시작하지만 결국 전투에서 충분히 승리하고 나면...",shape=box,color=blue];
		j3361846529 -> j2944568835;
