	j593080053 [label="뭔 게임이야 도대체가...",shape=box,color=red];
		j593080053 -> j3459722195;
	j3459722195 [label="응 맞아. 그렇게 지니몬을 모으고, 모은 친구들은 당신을 위해 싸워주고, 그렇게 모험을 떠나는 거야.",shape=box,color=blue];
		j3459722195 -> j1099874914;
	j1099874914 [label="하지만 그건 비디오 게임 버전이야. 카드 게임 버전에서는 마치 현실에서 다른 사람과 전투만 벌이는 것과 같아.",shape=box,color=blue];
		j1099874914 -> j2076848044;
	j2076848044 [label="하지만 모두 같은 생각하는 것 같지만. 지니몬 지니몬 지니몬. ",shape=box,color=blue];
		j2076848044 -> j2492160469;
