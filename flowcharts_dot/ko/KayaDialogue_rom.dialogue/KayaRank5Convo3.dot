		j877069890 -> j1425494925;
	j374602923 [label="너 그냥 쉽게 이기고 싶은 거지. 어림도 없지.",shape=box,color=red];
		j374602923 -> j944689438;
	j151112206 [label="아니, 나 지금 더 헷갈려. 아무것도 설명 안 해줬잖아! ",shape=box,color=red];
		j151112206 -> j944689438;
	j1425494925 [label="아주 좋아.. 당신만의 스타터 팩을 얻고 싶으면 10,000 홀러만 지불하면 돼...",shape=box,color=blue];
		j1425494925 -> j744690451;
		j1425494925 -> j1237450305;
	j944689438 [label="아, 그러지 마! 좀... 경기할 때 봐줄게. 아미르가 당신 도와주도록 내버려둘 테니까! ",shape=box,color=blue];
		j944689438 -> j3039111252;
