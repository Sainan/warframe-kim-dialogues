		j2028026021 -> j3211487115;
	j3862211199 [label="너네끼리 놀아. 난 바빠. [종료.]",shape=box,color=red];
		j3862211199 -> j145506587;
	j2693626743 [label="얼른 써버리고 싶은 홀러가 좀 있는데, 어디부터 시작해야 돼?",shape=box,color=red];
		j2693626743 -> j2497636145;
