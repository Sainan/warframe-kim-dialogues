		j1913426961 -> j3866455630;
	j522354749 [label="맥주 한 잔이 상황을 이해하는 데 도움이 되니까.",shape=box,color=red];
		j522354749 -> j3866455630;
	j2930355725 [label="그냥 '언급'으로 끝날 문제가 아니야. 끝이자 시작이라고.",shape=box,color=red];
		j2930355725 -> j3866455630;
	j2956481842 [label="엉망진창이고 바쁘지! 팀에 합류한 걸 환영한다 [종료.]",shape=box,color=red];
		j2956481842 -> j465934596;
