		j3866455630 -> j1570152292;
		j3866455630 -> j355850604;
	j1575825432 [label="세상에... 뒷담까자고? 내가 그렇게까지 말해줬는데도? ",shape=box,color=blue];
		j1575825432 -> j2631821532;
	j2517225058 [label="완전 그렇지. 100%라고. 왜냐하면 여기선 아무도 경쟁하지 않잖아.",shape=box,color=blue];
		j2517225058 -> j3961570506;
	j1570152292 [label="알브레히트가 그 존재의 손가락을 가지고 있어.",shape=box,color=red];
		j1570152292 -> j464324292;
	j355850604 [label="그 존재의... 손가락이 하나 있어. 내 시간대 안에서. 세상에서, 아마.",shape=box,color=red];
		j355850604 -> j464324292;
	j2631821532 [label="(뭐 물론 당연히 아서지. 내가 대화를 나눠봤는데 듣자하니 네가 그 사람 머릿속을 정말 엉망으로 만든 것 같아서 말이야).",shape=box,color=blue];
		j2631821532 -> j3620563256;
	j3961570506 [label="그건, 정말 이상한 일이야. 우리는 괴물로 변해버리고 말았는데 가장 인간적인 사람이라고 느껴져.",shape=box,color=blue];
		j3961570506 -> j704461524;
