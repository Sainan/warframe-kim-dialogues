	j3285397684 [label="우리가 고등학교 졸업한지는 꽤애애애 되었다는 거 알아. ",shape=box,color=blue];
		j3285397684 -> j1582973577;
	"Chat ends. Next chat will be KayaRank4Convo4." [color=orange];
	j1606825818 [label="정말로 가까이, 아주 가까이 거의 다 왔어.",shape=box,color=blue];
		j1606825818 -> j385535342;
		j1606825818 -> j2291284860;
	j1582973577 [label="하지만 당신이 우릴 정말 아끼고 있다는 걸 확인하기 위해 영재까지는 필요없어. 그리고 우린 모두 당신을 존경해.",shape=box,color=blue];
		j1582973577 -> j3502831199;
	j385535342 [label="1999년도를 탈출하는 것에 가까워졌어?",shape=box,color=red];
		j385535342 -> j1844862865;
	j2291284860 [label="요즘 뭐가 널 이끄는데?",shape=box,color=red];
		j2291284860 -> j1647936902;
	j3502831199 [label="아서한테 말이야. 처음엔, 세상에 진짜 크게 반했었어.",shape=box,color=blue];
		j3502831199 -> j1211137507;
	j1844862865 [label="그래! 물론 몇 가지 주의할 점은 있지. 당신이 온 시간대에는 '보이드의 지문'이 남아있으니까, 가장 확실하고 안전한 길은 정확히 당신이 온 곳으로 가는 거야.",shape=box,color=blue];
		j1844862865 -> j1794438037;
		j1844862865 -> j3445789960;
		j1844862865 -> j492978427;
	j1647936902 [label="물론, 당신이지.",shape=box,color=blue];
		j1647936902 -> j4136784815;
		j1647936902 -> j2395296393;
	j1211137507 [label="Check boolean ArthurDating",color=orange];
