	j1794438037 [label="아직도 이 일이 가능할 거라고 생각하는 거야, 그럼?",shape=box,color=red];
		j1794438037 -> j2971902093;
	j3445789960 [label="내 시간대라고 딱히 크게 나아지는 건 아니지만, 적어도 도와줄 순 있어.",shape=box,color=red];
		j3445789960 -> j3020080177;
	j492978427 [label="흐흠, 사실 보이드는 손가락에 대해 진지하게 임하는 편이야.",shape=box,color=red];
		j492978427 -> j797851358;
