	j2395296393 [label="나?",shape=box,color=red];
		j2395296393 -> j1844862865;
	j1026598545 [label="아서 이미 누가 채간 건 알고 있지?",shape=box,color=red];
		j1026598545 -> j2720862767;
	j2403760661 [label="좋게 말해둘게.",shape=box,color=red];
		j2403760661 -> j1545589215;
	j1373757322 [label="징그러워.",shape=box,color=red];
		j1373757322 -> j2580179158;
	j2971902093 [label="당연하지. 이건 도전이라고. 무슨 일이 일어날 건 일어나잖아, 그치? 이게 날 바쁘게 하고, 집중하게 만들 수 있는 것 처럼... ",shape=box,color=blue];
		j2971902093 -> j2906459789;
	j3020080177 [label="그렇지! 돌아갈 다리는 죄다 태우고! 뒤도 안 보고 가는 거야!",shape=box,color=blue];
		j3020080177 -> j465934596;
	j797851358 [label="허?",shape=box,color=blue];
		j797851358 -> j2999801847;
	j2720862767 [label="프흐흐 이미 알고 있다고, 운도 좋기는! 어째애애앴든",shape=box,color=blue];
		j2720862767 -> j2667022277;
	j1545589215 [label="풉 안돼! 제발 이거 비밀 얘기잖아! 어째애애앴든...",shape=box,color=blue];
		j1545589215 -> j2667022277;
	j2580179158 [label="음, 당신 미쳤어? 안 징그럽거든. 어쨌든!",shape=box,color=blue];
		j2580179158 -> j2667022277;
	j2906459789 [label="단점은 없어. 내가 알아내거나, 알아내지 못하거나. 여기서 만나거나, 저기서 만나거나. 그치? 나중에 봐!",shape=box,color=blue];
		j2906459789 -> j465934596;
	j2999801847 [label="이 모든 것, 엔트라티가 저지른 모든 일, 보이드에 대한 그 인간의 추구, 이 모든 일....의 본질.",shape=box,color=red];
		j2999801847 -> j4087798869;
	j2667022277 [label="근데 이건 어떤 면에서 고등학교에서 모두로부터 호감을 받게 되는 인기 있는 사람 같은 느낌이야.",shape=box,color=blue];
		j2667022277 -> j3761779400;
	j4087798869 [label="손가락 1개로 이렇게 된거야. 손가락 하나.",shape=box,color=red];
		j4087798869 -> j2235927417;
	j3761779400 [label="그리고 단순히 인기 이상의 의미를 가지지만.",shape=box,color=blue];
		j3761779400 -> j582317494;
	j2235927417 [label="아서의 맥주에 빠져있었어? 왜 그걸 진작에 말하지 않은 거야?",shape=box,color=blue];
		j2235927417 -> j1913426961;
