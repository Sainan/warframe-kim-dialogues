digraph {
	"KayaRank2Convo1 begins." [color=orange];
		"KayaRank2Convo1 begins." -> j957846127;
	j957846127 [label="안녕 카야!",shape=box,color=red];
		j957846127 -> j809845671;
	j809845671 [label="노바, 온라인에선 노바라고 불러.",shape=box,color=blue];
		j809845671 -> j953657362;
		j809845671 -> j3503196225;
	j953657362 [label="그래, 그럼 노바. ",shape=box,color=red];
		j953657362 -> j2074619147;
	j3503196225 [label="알았어. 언제부터?",shape=box,color=red];
		j3503196225 -> j1692302664;
	j2074619147 [label="ㅇㅋ 고마워. 그냥 인터넷에서 카야라고 부르지마. 직접 만나서 얘기할 땐 되지만, 여기선 노바라고 불러. 알았지?",shape=box,color=blue];
		j2074619147 -> j1365210914;
		j2074619147 -> j1493288361;
	j1692302664 [label="음 그게 중요해? 여긴 인터넷이고, 실명 쓰고 싶지 않아.",shape=box,color=blue];
		j1692302664 -> j1843849659;
		j1692302664 -> j764990377;
	j1365210914 [label="알았어, 근데 이유는 물어봐도 될까?",shape=box,color=red];
		j1365210914 -> j920608435;
	j1493288361 [label="알았어. 노바. 노바. 아 맞다. 물어보고 싶은게 있었어: 여기서 널 더 편안하게 만들어 줄 수 있는게 있어?",shape=box,color=red];
		j1493288361 -> j3557746042;
	j1843849659 [label="그래 응, 네가 시간 여행에 대해 얼마나 자주 묻는지에 대해서 다른 사람들에게 보여주고 싶지 않거든.",shape=box,color=red];
		j1843849659 -> j3705262101;
	j764990377 [label="오? 아미르가 이 네트워크 꽤 잘 관리하는 것 같은데, 내가 뭘 놓쳤나?",shape=box,color=red];
		j764990377 -> j752090170;
	j920608435 [label="다른 사람들한테 좋아하는 별명이 있는지 물어본 적 있어? 그냥 그렇다 생각하고 받아들이라고. ",shape=box,color=blue];
		j920608435 -> j1493288361;
	j3557746042 [label="우리 중 누구도 이 임시 집에 '있으려고' 의도한 건 아니지만 최선을 다하고 있다고.",shape=box,color=red];
		j3557746042 -> j768624492;
	j3705262101 [label="진심이야? 인터넷은 위험해. 진짜, 정말로.",shape=box,color=blue];
		j3705262101 -> j1144012884;
		j3705262101 -> j2971449724;
	j752090170 [label="나한텐 중요하거든. 다시는 카야를 온라인에서 찾는 사람이 없기를 바랄 뿐이야.",shape=box,color=blue];
		j752090170 -> j1984669412;
		j752090170 -> j140459017;
	j768624492 [label="흐음. 음. 흠. 편안한 거라. 아무도 나에 대한 소문 퍼뜨리고 다니진 않지?",shape=box,color=blue];
		j768624492 -> j3782703763;
		j768624492 -> j2388763051;
	j1144012884 [label="뭔 일 있었어?",shape=box,color=red];
		j1144012884 -> j960515419;
	j2971449724 [label="그리고 네 생각엔 시간 여행은 안 그렇고?",shape=box,color=red];
		j2971449724 -> j4294415938;
	j1984669412 [label="시간 경찰이 널 잡을 일은 없을 거야. 맹세해.",shape=box,color=red];
		j1984669412 -> j208328175;
	j140459017 [label="곤경에 처한 적이 있어?",shape=box,color=red];
