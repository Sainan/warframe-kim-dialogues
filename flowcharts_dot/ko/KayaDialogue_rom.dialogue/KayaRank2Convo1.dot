		j1857984510 -> j2035659039;
	j127675875 [label="하나도 안 웃기거든. 우리 여자들 한 방에 모아놓고 모두가 서로 목 조르는 걸 기대하고 있는 거잖아.",shape=box,color=blue];
		j127675875 -> j4251194862;
	j3391758139 [label="아미르와 퀸시는 네가 만든 웜홀을 대놓고 넘어가지는 않을 텐데, 맹세한 건데 보지 않을 땐 웜홀 뛰어넘어 갈 걸.",shape=box,color=red];
		j3391758139 -> j2091072191;
	j530022079 [label="그럼, 주변 사람들을 통해서 우리가 서로를 돕는 팀이란 걸 알 수 있을 거야.",shape=box,color=red];
		j530022079 -> j2970836909;
	j2491962010 [label="음. 그게 시간 여행을 하고 싶은 이유야? 뭔가를 증명하려고?",shape=box,color=red];
		j2491962010 -> j2611912671;
	j3506747215 [label="하지만 ",shape=box,color=blue];
		j3506747215 -> j1860375307;
	"Chat ends. Next chat will be KayaRank2Convo2." [color=orange];
	j2035659039 [label="그러니 나한테 며칠, 아니 몇 주만 더 달라고. 그러면 이 모든 걸 알아낼 수 있고 그렇게 되면 1999년도랑 작별 인사 나누게 될 거라고.",shape=box,color=blue];
		j2035659039 -> j3290079724;
	j4251194862 [label="질투. 비교. 어으. 내 인생에서 그 부분이랑은 손절 쳤다고. 다른 여자애들이랑 날 싸우게 만들지 마. ",shape=box,color=blue];
		j4251194862 -> j2292283515;
	j2091072191 [label="아오이와 레티는 너의 가장 친한 친구가 될지, 아니면 네 엄마가 될지 결정 못하는 것 같아.",shape=box,color=red];
		j2091072191 -> j953695863;
	j2970836909 [label="음. ",shape=box,color=blue];
		j2970836909 -> j2171443287;
