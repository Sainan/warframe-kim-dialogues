		j333665030 -> j4262429612;
	j3169387450 [label="내 친구들을 걱정하는 것이 강함이야. 이 모든 불편한 상황들을 견뎌낼 이유가 되기도 하고.",shape=box,color=red];
		j3169387450 -> j4262429612;
	j600558582 [label="우리 모두 처리해야할 머리아픈 상황들이 있어. 혼자서 해내긴 힘드니까.",shape=box,color=red];
		j600558582 -> j4262429612;
	j2298121309 [label="우린 그냥 네가 우리 주변에서 편안함을 느낄 때까지 기다리고 있을 뿐이야.",shape=box,color=red];
