	j3290079724 [label="그 점에 판돈을 걸어달라고.",shape=box,color=blue];
		j3290079724 -> j2292283515;
	j953695863 [label="물론 나도, 내가 어떡하다 여기까지 오게 되었는지 누군가 이해하고 싶어 하는 존재가 있어서 기뻐.",shape=box,color=red];
		j953695863 -> j3157031891;
