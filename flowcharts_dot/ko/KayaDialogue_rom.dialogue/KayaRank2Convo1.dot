	j208328175 [label="어으. 하나도 재미없어. ",shape=box,color=blue];
		j208328175 -> j2292283515;
	j1860375307 [label="바보같은 실수를 저지른 적이 있지. 딱 한 번. ",shape=box,color=blue];
		j1860375307 -> j1857984510;
	j2380285433 [label="아 진짜. 농담도 하지마.",shape=box,color=blue];
		j2380285433 -> j127675875;
	j4030581225 [label="아서랑 엘레노어는 분명히 널 자기들보다 훨씬 더 똑똑한 여동생으로 여길 거야.",shape=box,color=red];
		j4030581225 -> j3391758139;
	j3778427614 [label="내가 마치 애 같다고, 나한테 무슨 일이 생기면 어떡하냐고 말하는 건 바로 당신이잖아?",shape=box,color=blue];
		j3778427614 -> j530022079;
