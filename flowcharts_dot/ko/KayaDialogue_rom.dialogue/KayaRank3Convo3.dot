		j2416796040 -> j3588492270;
	j2270180763 [label="다들 힘들었어. 너도 괜찮아질 거야.",shape=box,color=red];
		j2270180763 -> j3157749739;
	j3249695588 [label="이 빌어먹을 상황 때문에 우리 모두 뭔가를 잃었어. 주변 좀 둘러보라고.",shape=box,color=red];
