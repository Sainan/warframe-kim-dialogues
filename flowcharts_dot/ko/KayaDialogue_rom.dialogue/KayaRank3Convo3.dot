		j3157749739 -> j1044771463;
	j1262276593 [label="더이상 사람들을 믿을 수 있을지 모르겠어. 너조차도.",shape=box,color=blue];
		j1262276593 -> j2697602550;
	"Chat ends. Next chat will be KayaRank4Convo1." [color=orange];
	j1044771463 [label="당신은 내 인생 가장 최악인 해에 날 가둬버렸어. ",shape=box,color=blue];
		j1044771463 -> j2697602550;
	j2697602550 [label="중요한 점은 내가 여길 빠져나가기 위해 당신을 이용하는 거야. ",shape=box,color=blue];
		j2697602550 -> j1140759876;
		j2697602550 -> j932725086;
	j1140759876 [label="뭐가 널 이렇게까지 만들었는지는 모르지만, 그게 네 진정한 행복을 누릴 수 있는 기회를 망치는 것 같네.",shape=box,color=red];
		j1140759876 -> j2626139828;
	j932725086 [label="그래라. 네가 빨리 떠날수록 내가 다뤄야 할 고까운 태도가 줄어드니 뭐.",shape=box,color=red];
		j932725086 -> j1400843689;
	j2626139828 [label="내가 널 미워하게 만들수 없어. 짜증나게 만들 순 있겠지만 그렇다고 미워할 정도는 아니야.",shape=box,color=red];
		j2626139828 -> j495562480;
		j2626139828 -> j1720022439;
	j1400843689 [label="우리가 이에 동의해서 다행이네.",shape=box,color=blue];
		j1400843689 -> j1173661291;
	j495562480 [label="우릴 이용하고 있다고 생각하고 있다면, 그래라. ",shape=box,color=red];
		j495562480 -> j1291296815;
	j1720022439 [label="어찌됐든 널 도울 거야.",shape=box,color=red];
		j1720022439 -> j3490226697;
	j1173661291 [label="Boolean KayaAttitude is now true.",color=orange];
		j1173661291 -> j3588492270;
	j1291296815 [label="그걸 알아낼 때쯤, 넌 그걸 행동으로 옮길 거고, 우린 여전히 여기 있을 거야.",shape=box,color=red];
		j1291296815 -> j1321656021;
	j3490226697 [label="그냥 우리가 널 헤치려는게 아니라는 점만 빨리 알아주길 바란다.",shape=box,color=red];
		j3490226697 -> j4010798965;
	j1321656021 [label="그 방법을 알아내게 되면... 어느 누구도 나를 예전처럼 바라보지 않을 거야...",shape=box,color=blue];
		j1321656021 -> j3588492270;
	j4010798965 [label="당신이 애쓰지 않아도, 내가 망쳐놓을 거야. 난 항상 그러니까.",shape=box,color=blue];
		j4010798965 -> j3588492270;
}