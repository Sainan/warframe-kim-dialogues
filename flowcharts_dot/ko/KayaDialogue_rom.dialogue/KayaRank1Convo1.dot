digraph {
	0 [label="KayaRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="안녕. 누구나 시간 여행을 할 수 있어, 아니면 당신만 할 수 있는 거야?",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="너도 좋은 하루 보내, 꼬마야 잘 들어봐, 그렇게 간단한 일이 아니야.",shape=box,color=red];
		2 -> 4;
	3 [label="안녕? 카야였지? 요즘 어떠니.",shape=box,color=red];
		3 -> 5;
	4 [label="꼬마 아니야. 19살이라고.",shape=box,color=blue];
		4 -> 6;
		4 -> 7;
	5 [label="좋아. ",shape=box,color=blue];
		5 -> 8;
	6 [label="그래. 이 새로운 그룹 안에서 제일 어리다고 할 수 있을 것 같다, 꼬마야.",shape=box,color=red];
		6 -> 9;
	7 [label="그래 그래, 시간 여행에 성급하게 뛰어들지는 마. 그건... 꽤 복잡하거든.",shape=box,color=red];
		7 -> 10;
	8 [label="그래서. 당신뿐이야? 다른 사람들도 할 수 있어? 미래의 학교에서 시간 여행을 가르치기도 해?",shape=box,color=blue];
		8 -> 11;
	9 [label="으어. 막내, 그렇겠지, 하지만 답을 찾아내기 위해서 뭔가를 시도하는 의지는 그중 제일 강할걸. 따라잡기 위해서 노력 좀 해야 할 거다. 그래서: 시간 여행. 어떻게 그리고 누가 가능하지?",shape=box,color=blue];
		9 -> 12;
	10 [label="어으. 얼마나 복잡하길래? 공식? 화학 원소랑 원자 원소? 내가 알아낼 테니까, 방향만 가르쳐 줘.",shape=box,color=blue];
		10 -> 13;
		10 -> 14;
	11 [label="그냥 나 혼자만이야. 더 간단히 해두자면.",shape=box,color=red];
		11 -> 15;
	12 [label="그럼 왜 당신 뿐인데? 계획 같은 거 있어? ",shape=box,color=blue];
		12 -> 16;
	13 [label="정말 뭐라고 말해줘야 할지 모르겠다. 그건 과학의 영역만은 아니고, 그렇다고 하면 엔트라티가 아는 과학의 영역이야.",shape=box,color=red];
		13 -> 17;
	14 [label="여기 방향을 알려줄게: 멈춰 [종료.]",shape=box,color=red];
		14 -> 1022;
	15 [label="학교에서 가르치던 것을 말하자면, 가르쳤다고 해도 공부하진 않았을 거야. 하지만 가르치긴 했을지도? ",shape=box,color=red];
		15 -> 18;
	16 [label="계획이 없다면, 당신이 가진 능력에 대하여 과학적인 자료를 얻기 위해 나한테 뭘 추천해 줄 수 있어?",shape=box,color=blue];
		16 -> 19;
	17 [label="어으 그 미친 영감. 그 인간한테 더 많은 질문을 해야 했어. 좋아. 적어도 과학이라면, 내가 그걸 재현할 수 있다는 뜻이고, 당신이 오고 갈 수 있으니, 내가 알아낼 수 있다는 뜻이겠지. 잘 있어.",shape=box,color=blue];
		17 -> 20;
	1022 [label="+20 Chemistry",color=orange];
		1022 -> 1018;
	18 [label="왜, 숙제하고 싶니? 시간 여행은 지금 시간대엔 너무 진보된 기술이야...",shape=box,color=red];
		18 -> 21;
	19 [label="정말 질문이 많구나, 꼬마야. 분위기 깨서 미안한데 그래도: 나도 잘 몰라. 오직 엔트라티만이 답을 알고 있어.",shape=box,color=red];
		19 -> 22;
	20 [label="+20 Chemistry",color=orange];
		20 -> 1015;
	1018 [label="{\"Id\":1018,\"Incoming\":[1022],\"Outgoing\":[1023],\"GraphPos\":[3236,718],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1018 -> 1023;
	21 [label="어으, 당신 진심이야?",shape=box,color=blue];
		21 -> 24;
	22 [label="Update boolean KayaSetKid",color=orange];
		22 -> 25;
	1015 [label="{\"Id\":1015,\"Incoming\":[20],\"Outgoing\":[23],\"GraphPos\":[3252,817],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1015 -> 23;
	1023 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	24 [label="헥스 멤버 중 알아낸 사람이 있어? 그 사람들이 정보 가지고 있어? ",shape=box,color=blue];
		24 -> 26;
		24 -> 27;
	25 [label="ㅇㅋ.",shape=box,color=blue];
		25 -> 28;
	23 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	26 [label="아미르에게 물어보는 건 어때? 시간 여행 플롯이 나오는 게임을 했던 걸로 기억하는데...",shape=box,color=red];
		26 -> 29;
	27 [label="그렇겐 생각 안 들어, 꼬마야. 하지만 뭔가 유용한 걸 배우고 싶다면, 레티에게 가서 치료 기초 과정에 관해 물어도 좋아.",shape=box,color=red];
		27 -> 30;
	28 [label="+20 Chemistry",color=orange];
		28 -> 996;
	29 [label="Update boolean KayaAmirTravel",color=orange];
		29 -> 32;
	30 [label="Update boolean KayaLettieHeal",color=orange];
		30 -> 33;
	996 [label="{\"Id\":996,\"Incoming\":[28],\"Outgoing\":[31],\"GraphPos\":[4241,541],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		996 -> 31;
	32 [label="게임? 그냥 답, 방향성, 뭐든 정보가 필요하다고. 내가 알아낼게. 도움이 되는 게 생각난다면, 날 찾아와.",shape=box,color=blue];
		32 -> 34;
	33 [label="내 스타일 아니야. 상관없지만.",shape=box,color=blue];
		33 -> 35;
	31 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	34 [label="+20 Chemistry",color=orange];
		34 -> 998;
	35 [label="+20 Chemistry",color=orange];
		35 -> 997;
	998 [label="{\"Id\":998,\"Incoming\":[34],\"Outgoing\":[36],\"GraphPos\":[5087,255],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		998 -> 36;
	997 [label="{\"Id\":997,\"Incoming\":[35],\"Outgoing\":[37],\"GraphPos\":[4970,380],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		997 -> 37;
	36 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	37 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
}