digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j3617506624;
	j3617506624 [label="안녕. 누구나 시간 여행을 할 수 있어, 아니면 당신만 할 수 있는 거야?",shape=box,color=blue];
		j3617506624 -> j26361875;
		j3617506624 -> j2908599009;
	j26361875 [label="너도 좋은 하루 보내, 꼬마야 잘 들어봐, 그렇게 간단한 일이 아니야.",shape=box,color=red];
		j26361875 -> j40133502;
	j2908599009 [label="안녕? 카야였지? 요즘 어떠니.",shape=box,color=red];
		j2908599009 -> j2688466983;
	j40133502 [label="꼬마 아니야. 19살이라고.",shape=box,color=blue];
		j40133502 -> j2499854119;
		j40133502 -> j4219704182;
	j2688466983 [label="좋아. ",shape=box,color=blue];
		j2688466983 -> j1889438887;
	j2499854119 [label="그래. 이 새로운 그룹 안에서 제일 어리다고 할 수 있을 것 같다, 꼬마야.",shape=box,color=red];
		j2499854119 -> j3701500332;
	j4219704182 [label="그래 그래, 시간 여행에 성급하게 뛰어들지는 마. 그건... 꽤 복잡하거든.",shape=box,color=red];
		j4219704182 -> j1612715519;
	j1889438887 [label="그래서. 당신뿐이야? 다른 사람들도 할 수 있어? 미래의 학교에서 시간 여행을 가르치기도 해?",shape=box,color=blue];
		j1889438887 -> j2215265643;
	j3701500332 [label="으어. 막내, 그렇겠지, 하지만 답을 찾아내기 위해서 뭔가를 시도하는 의지는 그중 제일 강할걸. 따라잡기 위해서 노력 좀 해야 할 거다. 그래서: 시간 여행. 어떻게 그리고 누가 가능하지?",shape=box,color=blue];
		j3701500332 -> j1331842242;
	j1612715519 [label="어으. 얼마나 복잡하길래? 공식? 화학 원소랑 원자 원소? 내가 알아낼 테니까, 방향만 가르쳐 줘.",shape=box,color=blue];
		j1612715519 -> j717683834;
		j1612715519 -> j3483178927;
	j2215265643 [label="그냥 나 혼자만이야. 더 간단히 해두자면.",shape=box,color=red];
		j2215265643 -> j2418484203;
	j1331842242 [label="그럼 왜 당신 뿐인데? 계획 같은 거 있어? ",shape=box,color=blue];
		j1331842242 -> j3013827864;
	j717683834 [label="정말 뭐라고 말해줘야 할지 모르겠다. 그건 과학의 영역만은 아니고, 그렇다고 하면 엔트라티가 아는 과학의 영역이야.",shape=box,color=red];
		j717683834 -> j965170081;
	j3483178927 [label="여기 방향을 알려줄게: 멈춰 [종료.]",shape=box,color=red];
		j3483178927 -> "Chat ends.";
	j2418484203 [label="학교에서 가르치던 것을 말하자면, 가르쳤다고 해도 공부하진 않았을 거야. 하지만 가르치긴 했을지도? ",shape=box,color=red];
		j2418484203 -> j1749505289;
	j3013827864 [label="계획이 없다면, 당신이 가진 능력에 대하여 과학적인 자료를 얻기 위해 나한테 뭘 추천해 줄 수 있어?",shape=box,color=blue];
		j3013827864 -> j1540879490;
	j965170081 [label="어으 그 미친 영감. 그 인간한테 더 많은 질문을 해야 했어. 좋아. 적어도 과학이라면, 내가 그걸 재현할 수 있다는 뜻이고, 당신이 오고 갈 수 있으니, 내가 알아낼 수 있다는 뜻이겠지. 잘 있어.",shape=box,color=blue];
		j965170081 -> j2547432773;
	"Chat ends." [color=orange];
	j1749505289 [label="왜, 숙제하고 싶니? 시간 여행은 지금 시간대엔 너무 진보된 기술이야...",shape=box,color=red];
		j1749505289 -> j3590288429;
	j1540879490 [label="정말 질문이 많구나, 꼬마야. 분위기 깨서 미안한데 그래도: 나도 잘 몰라. 오직 엔트라티만이 답을 알고 있어.",shape=box,color=red];
		j1540879490 -> j2221286671;
	j2547432773 [label="+20 Chemistry",color=orange];
		j2547432773 -> "Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue";
	j3590288429 [label="어으, 당신 진심이야?",shape=box,color=blue];
		j3590288429 -> j2901382962;
	j2221286671 [label="Boolean KayaSetKid is now true.",color=orange];
		j2221286671 -> j2132394826;
	"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" [label="Queue conversation HexKayaConvo1 in HexDialogue_rom.dialogue",color=orange];
		"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j2901382962 [label="헥스 멤버 중 알아낸 사람이 있어? 그 사람들이 정보 가지고 있어? ",shape=box,color=blue];
		j2901382962 -> j3961411026;
		j2901382962 -> j3704347471;
	j2132394826 [label="ㅇㅋ.",shape=box,color=blue];
		j2132394826 -> j2547432773;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j3961411026 [label="아미르에게 물어보는 건 어때? 시간 여행 플롯이 나오는 게임을 했던 걸로 기억하는데...",shape=box,color=red];
		j3961411026 -> j3558509047;
	j3704347471 [label="그렇겐 생각 안 들어, 꼬마야. 하지만 뭔가 유용한 걸 배우고 싶다면, 레티에게 가서 치료 기초 과정에 관해 물어도 좋아.",shape=box,color=red];
		j3704347471 -> j3694448604;
	j3558509047 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j3558509047 -> j2862109098;
	j3694448604 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j3694448604 -> j818416245;
	j2862109098 [label="게임? 그냥 답, 방향성, 뭐든 정보가 필요하다고. 내가 알아낼게. 도움이 되는 게 생각난다면, 날 찾아와.",shape=box,color=blue];
		j2862109098 -> j2547432773;
	j818416245 [label="내 스타일 아니야. 상관없지만.",shape=box,color=blue];
		j818416245 -> j2547432773;
}