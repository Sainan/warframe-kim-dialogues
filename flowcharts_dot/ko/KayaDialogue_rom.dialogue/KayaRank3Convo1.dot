	j2728174396 [label="어쨌든, 이 학생은 나한테 생일 케이크를 구워주고는 아무에게도 나눠 주지 말고 집에 가져가서 먹으라고 그랬었어. ",shape=box,color=blue];
		j2728174396 -> j1961408462;
