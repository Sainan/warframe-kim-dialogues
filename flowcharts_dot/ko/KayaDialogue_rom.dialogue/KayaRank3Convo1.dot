		j2399742547 -> j2144121665;
	j3446617291 [label="그리고 위대하고 영감이 넘치는 미래에서 온 당신은 요점도 확실히 놓쳤겠지. 지니몬 카드들 말이야! 그리고 나! 이게 믿겨져?!",shape=box,color=blue];
