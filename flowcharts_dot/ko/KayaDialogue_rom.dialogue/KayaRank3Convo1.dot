		j2895957087 -> j2728174396;
	j1961408462 [label="솔직히 말해서, 처음엔 당신이 그랬던 것처럼 이상했어. 하지만 받은 케이크를 내 부엌칼로 자르니까 안에서 딱딱한 무언가에 부딪혔어.",shape=box,color=blue];
		j1961408462 -> j1888414011;
	j1888414011 [label="역겨워 그치? 처음엔 엄청 역겨웠어. 하지만, 안을 들여다보니 케이크 아래에 숨겨진 플라스틱 용기 같은 걸 찾았고, 밀봉된 지니몬 카드 팩으로 채워져 있었어. 내가 제일 좋아하는 애들이었지.",shape=box,color=blue];
		j1888414011 -> j527843885;
	j527843885 [label="나 같은 여자애는 학교에서 그런 모습 보이고 싶지 않을 거야. 하지만 이 수줍은 친구는 내가 좋아하는 걸 눈치채고, 진짜 선물을 담고, 외형은 큰 케이크로 만들어서 내 관심을 끌었어.",shape=box,color=blue];
