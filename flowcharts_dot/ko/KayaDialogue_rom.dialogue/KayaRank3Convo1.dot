	j2232916935 [label="뭐. 조금은 관련 있는 얘기 같기도. 음. 일단 난 '모든 사람이 나처럼 보이고 싶고 그렇게 되고 싶어하는' 타입이라는 걸 말해줘야겠다.",shape=box,color=blue];
