	j1966422490 [label="좋은 성적,. 사실, 좋은 거 이상이었지. 그리고 치어 포스 대장이기도 했고. 내 생일 파티 초대장 받는 일은 엄청난 일이었을 거라고.",shape=box,color=blue];
