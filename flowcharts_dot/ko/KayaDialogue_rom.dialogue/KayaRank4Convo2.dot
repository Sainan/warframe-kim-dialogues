		j3926974489 -> j4425683;
	j4425683 [label="내가 왜 떠나야 하는 지 알겠어?",shape=box,color=blue];
		j4425683 -> j4085399146;
	j4085399146 [label="이건 마치, 내게 일어난 일은 '다른 사람'에게는 일어난 적 없는 것 같으니까.",shape=box,color=blue];
		j4085399146 -> j152519177;
	j152519177 [label="그 일로 헤드라인까지 장식했었다고. 사람들은 내 스스로가 그 사진을 공유하기로 결정까지 내렸으면서 무슨 희생자인 척한다고 비웃었어.",shape=box,color=blue];
		j152519177 -> j1439641526;
	j1439641526 [label="학생 데이터베이스에서 내 이름을 검색하면 다들 필히 '교수의 그거', 교수의 그렇고 그런 노리개라는 생각까지 떠올리겠지.",shape=box,color=blue];
		j1439641526 -> j1191423682;
	j1191423682 [label="그리고 당신들도 그 사진을 발견할 거고, 그 누구도 다시는 날 똑같은 눈으로 보지 않겠지. 존중도... 사라지겠지. 영원히.",shape=box,color=blue];
		j1191423682 -> j2105607097;
	j2105607097 [label="난 빠져나가야 해, 앞으로 나아가야 해, 이 모든 것을 뒤로 하고 똑똑한 나로서 있을 수 있는 시간과 장소로.",shape=box,color=blue];
		j2105607097 -> j4152772982;
		j2105607097 -> j1796480552;
		j2105607097 -> j3471734205;
	j4152772982 [label="더이상 할 말이 없다. 우리 모두 후회할만한 일을 해왔어. ",shape=box,color=red];
		j4152772982 -> j2541155120;
	j1796480552 [label="오히려 지금보다도 더 너라는 존재를 존경하게 되었어.",shape=box,color=red];
		j1796480552 -> j2954455984;
	j3471734205 [label="우리 중 누구도 이 일로 널 판단하는 순간은 결코 없을 거야.",shape=box,color=red];
		j3471734205 -> j3051414897;
	j2541155120 [label="언젠가 당신도 지금까지 벌여왔던 일 중 가장 후회되는 걸 얘기해줄지도...",shape=box,color=blue];
