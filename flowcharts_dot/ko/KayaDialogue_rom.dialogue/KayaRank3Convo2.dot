	j3701757518 [label="뭐 보아하니 이렇게 시작하나 보네.",shape=box,color=red];
		j3701757518 -> j2416189645;
	j2416189645 [label="지금 이 모든 것들? 생각하는 거 이상이라고. 알브레히트가 어딘가로 향했고, 무언가를 깨워버렸고, 그 존재가 그를 쫓았어. 보이드지.",shape=box,color=red];
