		j2416189645 -> j455945979;
	j2533007536 [label="보이드는 살아있으면서 살아있지도 않아. 그러면서, 그렇지 않은 것. 역설적이지만 우리 모두에게 일어난 일들의 원인이자 이유야.",shape=box,color=red];
