digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank4Convo1 begins." [color=orange];
		"KayaRank4Convo1 begins." -> j1656852598;
	j1656852598 [label="이런게 어떤건지 알긴 알아? 인터넷이 나타나서는, 우리들한테 많은 것을 약속하지.",shape=box,color=blue];
		j1656852598 -> j804711684;
	j804711684 [label="그러니 당신이 나라고 가정해보자. 당신은 18살이 되었고, 온라인에 접속했어. 어디에나 있는 새로운 친구들과 채팅을 시작해!",shape=box,color=blue];
		j804711684 -> j2077919605;
	j2077919605 [label="그리고 나 같은 '똑똑한 여자애'가 인터넷에서 가장 멍청한 짓을 저질렀어. ",shape=box,color=blue];
		j2077919605 -> j169058990;
	j169058990 [label="당신은 반대편에 있는 사람을 믿게 돼. ",shape=box,color=blue];
		j169058990 -> j3496219958;
	j3496219958 [label="그리고 이 모든 새로운 기술들을 보면서 사람들은 여전히 사람들이다 라는 점을 까먹게 돼. ",shape=box,color=blue];
		j3496219958 -> j3216339052;
	j3216339052 [label="그래서 당신은 루아께서 보고 부끄러워하실 만한 누드 사진을 보내. 인터넷에서 만난 사람과 특별한 인연이 있다고 생각하고. 그러니 당신은 온라인에서 사귄 남자 친구를 믿어. ",shape=box,color=blue];
		j3216339052 -> j1669214331;
	j1669214331 [label="다음 날, 그 사진은 어디에나 있게 되지. 캠퍼스에 있는 모든 사람이 그걸 봤어. 공유하고. 교수님께도 보냈지. 인터넷 전체에서. 내가 알지도 못했던 나라들에까지 퍼져갔지.",shape=box,color=blue];
		j1669214331 -> j3273143457;
	j3273143457 [label="난 이 반석 위에서 가장 똑똑한 사람이었을 수도 있었는데, 모든 사람들이 날 기억할 수 있는 건 그 사진 하나 뿐이 되어버렸지.",shape=box,color=blue];
		j3273143457 -> j2362128587;
	j2362128587 [label="그러니 내가 여기서 빠져나갈 거라고 말하는 건, 진심이라고. 그 사진이 아무 의미가 없다는 건 알고 있어. 미래는 계속 나아가고, 사람들은 각자 즐거움을 얻기 마련이니까.",shape=box,color=blue];
		j2362128587 -> j573281095;
	j573281095 [label="하지만 나한텐 그게 내 인생을 망쳐버린 격이야. 난 인터넷이 없는 미래에서 살고 싶어. 이 일에서 나아갈 수 있다는 걸 증명하고 싶다고. 과거로 돌아가는 건 다른 사람들이 옳다는 걸 증명하고 난 이 일에서 벗어날 수가 없게 되는 거야.",shape=box,color=blue];
		j573281095 -> j284540176;
	j284540176 [label="그러니, 딱 기다리고 있으라고. 네가 온 곳에서 날 볼 수 있을 테니까. ",shape=box,color=blue];
		j284540176 -> j3632055820;
	j3632055820 [label="그리고 우린 세상을 바라보고 내 선택이 날 파괴하지 않았다는 걸로 웃을 수 있겠지. 그 모든 고난이 날 더 똑똑하게 만들었을 뿐이고 시간대를 빠져나갈 만큼 똑똑해진 거라고.",shape=box,color=blue];
		j3632055820 -> j3258508148;
	j3258508148 [label="+20 Chemistry",color=orange];
		j3258508148 -> "Chat ends. Next chat will be KayaRank4Convo2.";
	"Chat ends. Next chat will be KayaRank4Convo2." [color=orange];
}