		j2513465689 -> j4240658220;
	j2626757861 [label="난 내가 누구인지를 배우고 있으며, 후회가 날 저의하게 내버려둬서는 안된다는 걸 알았어.",shape=box,color=blue];
		j2626757861 -> j2567259306;
	j4240658220 [label="만약에 이 글을 읽고 있는 사람이 있다면, 그 중 한 명이 바로 카야 벨라스코일 테니까.",shape=box,color=blue];
		j4240658220 -> j1919943003;
	j2567259306 [label="그리고 내가 빠져나가면, 거의 못된 짓하는 게 될 거야. 누구도 따라갈 수 없을 만큼 위험할 거야.",shape=box,color=blue];
		j2567259306 -> j1338286681;
	j1919943003 [label="내 이름을 검색하려면, 두가지 사실을 찾아내야 해: 내가 문제를 풀어냈다는 점과 1999년도를 벗어났다는 점이야.",shape=box,color=blue];
		j1919943003 -> j1463649427;
