		j1159170382 -> j3267007881;
	j2986346728 [label="스스로의 운을 너무 시험하지 마라, 찬탈자여. \"즐겁다\"라는 표현은 좀 과장된 것 같군. 오히려 네게 점점 마음이 가는 것 같다. 곰팡이처럼 말이다.",shape=box,color=blue];
		j2986346728 -> j1328807703;
	j3376844114 [label="\"기쁨?\" 이게 그건가? 내가 이런 피학성애자인 줄은 몰랐군. 흠. 아니면 그냥 내 몸이 썩어가는 감각과 너희 모두에게 점점 정이 드는 느낌이 들어서 그런 걸까?",shape=box,color=blue];
		j3376844114 -> j2929155604;
	j4128399818 [label="누군가와 이야기할 수 있다는 건 나름 즐거운 일이다. 물론 너희들이 말했듯, 가끔씩 거슬리긴 하지만.",shape=box,color=blue];
		j4128399818 -> j849425396;
	j510374367 [label="외로움? 하. 네가 막고 있는 건 내 삶으로 돌아오려는 내 제정신뿐이다. 네가 \"점점 날 향한 마음을 키워나가고 있다\"는 뜻으로 말하는 거라면, 다른 어떤 존재가 그런 효과를 가지고 있는지 알고 싶지 않나?",shape=box,color=blue];
