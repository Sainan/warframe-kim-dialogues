	j3115747776 [label="마리와 리온에게까지도?",shape=box,color=red];
		j3115747776 -> j258297170;
	j2488902009 [label="저 황금빛 성벽 안에서 땀 흘리며 일하다 죽어간 수많은 선량한 영혼들에 대해 아무것도 모를거다. 시간 속에 잊혀진 그들의 삶에 대한 이야기도.",shape=box,color=blue];
		j2488902009 -> j3584573045;
	j455913509 [label="그들을 죽여봤자 소용없으니까, 안 그런가? 날 설득하려는 거냐, 찬탈자여? 놀랍군 - 네가 이렇게 교활한 괴물일 줄은 상상도 못했다!",shape=box,color=blue];
