		j3601886859 -> j340834873;
	j3827837053 [label="유반의 장 하나만으로도 오로킨 사회를 불태워버릴 충분한 이유가 될 수 있었다. 그런데 넌 온 동족을 비난하고 있다... 너 자신도 그 사회 출신이면서, 이 찬탈자 같으니!",shape=box,color=blue];
		j3827837053 -> j2488902009;
	j340834873 [label="그러니까, 당신이 모두를 살려두는 이유는 그들을 죽이는 게 무의미하다고 생각하기 때문이야?",shape=box,color=red];
		j340834873 -> j455913509;
