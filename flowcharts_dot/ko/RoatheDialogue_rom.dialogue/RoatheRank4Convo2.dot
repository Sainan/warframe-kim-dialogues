	j258297170 [label="만약 지하실에 내려가서 광신도들이 서 있던 자리에 핏자국 두 개를 발견했다면, 꽤나 심한 질책을 받을 게 뻔하니까. 그렇지 않나?",shape=box,color=blue];
		j258297170 -> j928505352;
	j3584573045 [label="네가 알지 못한다는 이유만으로 영원히 잊힐 비극들을 위해 흘린 눈물의 강들 말이다.",shape=box,color=blue];
		j3584573045 -> j1747000501;
	j1274027591 [label="함께 있는 시간이 즐겁다고 인정해도 돼. 사람들은 단순히 실용적인 목적으로만 존재하는 게 아니니까.",shape=box,color=red];
		j1274027591 -> j796436421;
	j1105146427 [label="우리가 당신을 귀찮게 할 수도 있지만, 짊어지고 있는 외로움을 덜어주는 데 도움이 될 수 있다는 것을 인정해도 괜찮아.",shape=box,color=red];
		j1105146427 -> j134072315;
	j928505352 [label="너한테든, 아니면 집사한테든, 아니면 텐노에게든, 아니면 텐노의 무시무시한 \"어머니\"한테든. 으윽. 그건 정말 끔찍하군. 그건 좀 신경이 쓰인다. 그 주제에 대해선 다음에 다시 얘기하도록 하지.",shape=box,color=blue];
