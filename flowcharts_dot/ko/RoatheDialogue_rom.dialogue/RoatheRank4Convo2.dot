		j3713486377 -> j2542052581;
	j880954404 [label="나는 아직도 내가 왜 널 그토록 믿고 많은 것을 털어놓았는지 이해할 수 없다. 넌 그 신뢰를 배신했잖나, 찬탈자여.",shape=box,color=blue];
		j880954404 -> j2779331791;
	j493447864 [label="아직 할 일이 남아 있다, 찬탈자여. 내가 주변 사람들을 모두 죽이면 어떻게 내 기억을 되찾도록 도울 수 있겠나?",shape=box,color=blue];
		j493447864 -> j2706112491;
	j4065624906 [label="네 주장이 옳다는 걸 즉시 증명하지 않기 위해 매우 노력하고 있으니.",shape=box,color=blue];
		j4065624906 -> j1803978494;
	j436795856 [label="어쩌면 네가 정신 차리고 생각을 바꿀 거라고 기대하는 걸지도 모르지. 하지만 내가 주변 사람들을 모두 죽여버린다면 그럴 가능성은 극적으로 낮아지겠지, 안 그런가?",shape=box,color=blue];
		j436795856 -> j2706112491;
	j2542052581 [label="허나 그리 해봤자 아무 소용도 없다, 안 그런가? 전쟁에서 단 한 가지라도 배울 점이 있다면, 그것은 결국 살인으로 얻는 것이 거의 없다는 사실이다.",shape=box,color=blue];
		j2542052581 -> j744554821;
	j2779331791 [label="만약 내가 주변 이들을 모두 학살한다 하면, 그런 일이 일어날 확률은 극적으로 낮다, 안 그런가? 전쟁에서 단 한 가지라도 배울 점이 있다면, 그것은 결국 살인으로 얻는 것이 거의 없다는 사실이다.",shape=box,color=blue];
		j2779331791 -> j3601886859;
	j2706112491 [label="게다가 그리 해봤자 아무 소용도 없다, 안 그런가? 전쟁에서 단 한 가지라도 배울 점이 있다면, 그것은 결국 살인으로 얻는 것이 거의 없다는 사실이다.",shape=box,color=blue];
		j2706112491 -> j3601886859;
	j1803978494 [label="오로킨에 대한 너의 증오심에는 공감한다. 믿어다오. 대부분의 오로킨들은 서로를 경멸했으니. 난 동족의 죄악과 만행을 너무 잘 알고 있다. ",shape=box,color=blue];
		j1803978494 -> j3827837053;
	j744554821 [label="가끔씩 그런 행동을 조금씩 저지르고 싶은 욕망을 품는 것이 즐거운 일일지도 모르지.",shape=box,color=blue];
