	"Chat ends." [color=orange];
	j1634624079 [label="음성 메시지: 벌",shape=box,color=blue];
		j1634624079 -> j3283657270;
	j3283657270 [label="구술 기록: 전쟁 이전, 그 '계획'을 처음 입안한 자는 스칸이었다. 짜증스럽고도 지적이고, 동시에 신랄한 자. \"둥지에 불이 붙었으니, 우리는 이 둥지를 떠나 날아가야 한다.\"",shape=box,color=blue];
		j3283657270 -> j1610854275;
	j1610854275 [label="지나친 착취와 무모한 실험으로, 우리는 성계가 더 이상 재생을 꿈꿀 수조차 없을 정도로 망가뜨려 버리고 말았다.",shape=box,color=blue];
		j1610854275 -> j461484419;
	j461484419 [label="이제 새로운 지평으로의 확장만이 우리에게 남은 유일한 선택지였다. ",shape=box,color=blue];
		j461484419 -> j2098712924;
	j2098712924 [label="그러나, 또한 그는 보이드 속 그 비겁한 타워의 건설을 주도한 자이기도 했다.",shape=box,color=blue];
		j2098712924 -> j224779312;
	j224779312 [label="돌아온 센티언트들에 대한 두려움이 너무나 강해, 생각할 수 있는 것이라곤 보이드의 바다 위 외딴섬으로의 도피뿐이었겠지.",shape=box,color=blue];
		j224779312 -> j2496055971;
	j2496055971 [label="센티언트들의 용기를 우리는 얼마나 하찮게 여겼던가.",shape=box,color=blue];
		j2496055971 -> j483163745;
	j483163745 [label="그들은 기회에 불과하더라도 오로지 우리를 벌하기 위해 육신을 지지는 보이드의 불길마저 기꺼이 견디고 건너왔거늘.",shape=box,color=blue];
		j483163745 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}