		j4160620174 -> j455644993;
	j3367857915 [label="그동안 \"듣고\" 싶다면 기꺼이 해주마. 가벼운 경고를 주자면, 넌 오로킨에게 얘기를 해달라고 요청한 거다.",shape=box,color=blue];
