		j2174971436 -> "Chat ends.";
	j277916168 [label="설령 네가 믿지 않더라도, 이렇게 오랜 시간이 지났는데도, 전통이란 게 로이드가 내 말을 듣도록 고무시킬 수 있을까 생각해 봐라. 사실...난 꽤 설득력이 있는 편이다. 한때 가장 사악한 집행자들의 충실한 조력자였으니까.",shape=box,color=blue];
