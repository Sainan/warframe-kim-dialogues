	537 [label="+5 Chemistry",color=orange];
		537 -> 548;
	535 [label="적을 알라, 라는 건가? 아니면 그저 불가능한 것을 앉아서 마주 보고 싶은 호기심 때문인가? ",shape=box,color=blue];
		535 -> 546;
	536 [label="원하는 만큼 펄떡여라, 물고기야. 어차피 내게로 헤엄쳐 왔으니.",shape=box,color=blue];
		536 -> 547;
	541 [label="설령 네가 믿지 않더라도, 이렇게 오랜 시간이 지났는데도, 전통이란 게 로이드가 내 말을 듣도록 고무시킬 수 있을까 생각해 봐라. 사실...난 꽤 설득력이 있는 편이다. 한때 가장 사악한 집행자들의 충실한 조력자였으니까.",shape=box,color=blue];
		541 -> 551;
		541 -> 552;
		541 -> 553;
	539 [label="Chat ends.",color=orange];
	540 [label="Update boolean RoatheDeal",color=orange];
		540 -> 550;
	542 [label="아니. 난 자리만 이전의 오로킨까지는 다룰 생각없어 - 그리고, 그 이후로는... 뭐... 당신도 이미 요점을 파악했으리라 생각이 들지만.",shape=box,color=red];
		542 -> 554;
	543 [label="난 오로킨을 여러번 다뤄봤기 때문에 그들을 너무 믿지 않는 게 신상에 좋다는 걸 알고 있어.",shape=box,color=red];
		543 -> 555;
	544 [label="미안하지만, 난 그 꼬마보다 당신네 부류에 애정이 요만큼도 없어.",shape=box,color=red];
		544 -> 555;
	545 [label="본인이 뭘 요청했는지 알지도 못하고 말이야. 조심하지 않으면 한 시간 동안 여기에 있어야 할 거다.",shape=box,color=blue];
		545 -> 523;
	549 [label="음. 알다마다. 이대로 내 무릎에라도 앉으려나 했다만. 뭐 됐겠지...",shape=box,color=blue];
		549 -> 557;
	548 [label="그리 생각하는가? 음. 그럼 창으로 이 물고기를 낚는데 얼마나 시간이 걸리는 지 두고 봐야겠군.",shape=box,color=blue];
