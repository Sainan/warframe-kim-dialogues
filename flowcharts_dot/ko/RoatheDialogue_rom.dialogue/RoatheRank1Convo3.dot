	j3873914948 [label="헬민스였다. 과거에 그것이 어떻게 자라났는지는 알 길이 없군, 우리가 도착했을 시점엔 이미 그것이 있었으니. 그 과정에서 헬민스는 시들어 죽어버렸지만 - 나는 하나가 더 있다면, 원래 시간으로 되돌아갈 수 있을 거라 여겼지.",shape=box,color=blue];
