digraph {
	186 [label="RoatheRank1Convo3 begins.",color=orange];
		186 -> 188;
		186 -> 187;
	188 [label="혹시 물어봐도 될까? 여긴 어떻게 다시 오게 된 거야? 그러니까... 정확히, 언제에서?",shape=box,color=red];
		188 -> 190;
	187 [label="[종료.]",shape=box,color=red];
		187 -> 189;
	190 [label="Evaluate expressions on HellStory",color=orange];
		190 -> 191 [label="x >= 21",color=purple];
		190 -> 192 [label="x < 21",color=purple];
		190 -> 192 [label="false",color=purple];
	189 [label="Chat ends.",color=orange];
	191 [label="왜 이미 그 답을 아주 잘 알고 있을 것 같은 예감이 들지, 나의 찬탈자여? 이미 내 머릿속 조각들을 주워들었다면, 그런 사소한 것을 물어 무슨 장난질을 할 생각이지?",shape=box,color=blue];
		191 -> 193;
	192 [label="그래, 당연히 물어봐야지! 그래야 나의 이 빛나는 재치에 대해 논하고, 알브레히트가 얼마나 뇌보다도 발이 빠른지, 그러면서 정확히 동시에 어찌나 그리도 놀라울 정도의 겁쟁이인지를 논할 기회가 생길 것 아니냐!",shape=box,color=blue];
		192 -> 194;
	193 [label="Check boolean RoatheKnowsReset",color=orange];
		193 -> 196 [label=true,color=green];
		193 -> 195 [label=false,color=brown];
	194 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		194 -> 197 [label="x >= 1",color=purple];
		194 -> 198 [label="x <= 0",color=purple];
		194 -> 198 [label="false",color=purple];
	196 [label="주변인들의 정신을 건드리고 다니는 걸 보니, 네 악랄함은 알브레히트와 다를 바가 없군. 사람을 무슨 마음대로 갖고 노는 장난감이라도 된다는 듯이! 그러니 말해 다오. 이미 답을 알고 있다면, 도대체 왜 굳이 묻는것이냐, 으응?",shape=box,color=blue];
		196 -> 201;
		196 -> 202;
	195 [label="말해 봐라. 네가 찾는 답을 너는 이미 알고 있는 것 같다는 내 예감이 맞는 것이냐? 내가 어떻게 이 광신도들과 함께 여기로 돌아왔는지, 정확히 어느 시간대에서 온 것인지 이미 알고 있겠지. 뿐만 아니라 훨씬 더 많은 것도. 그렇지 않나?",shape=box,color=blue];
		195 -> 199;
		195 -> 200;
	197 [label="적어도 알브레히트 손으로 거기 보내진 게 네 의지가 아니었다는 건 알겠어.",shape=box,color=red];
		197 -> 203;
	198 [label="아, 그래서 넌 자의로 과거로 간 게 아니구나.",shape=box,color=red];
		198 -> 203;
	201 [label="내가 지금 이 과정으로 너희를 모두 이끌려고 하는 중인데, 저번엔 아주 성대하게 망쳐버렸어. 그래서 다시 해보는 중이고. 말하자면 \"백지부터 다시\" 인 거지.",shape=box,color=red];
		201 -> 206;
	202 [label="이걸 진짜 어떻게 설명해야 할지 모르겠는데. 나도 좋아서 너네 기억을 지우는 이 능력을 얻은 게 아니고, 나도 이 능력을 어떻게 잘 다룰 수 있게 해 보려고 최대한 노력하고 있다고.",shape=box,color=red];
		202 -> 207;
	199 [label="아니, 몰라.",shape=box,color=red];
		199 -> 204;
	200 [label="솔직히 말하자면... 응, 알아.",shape=box,color=red];
		200 -> 205;
	203 [label="아니, 물론 전혀 내 의사가 아니었다. 여기서 네가 우리 오로킨에 대해 알아야 할 것이 있다만, 우리는 자주... 뭐, 지금은 엣말이군. 서로 게임을 즐기곤 했었다. 온갖 종류의 게임들이었지. 정치 게임, 심리 게임, 성적인 게임. 종류는 무엇이든 상관 없었어.",shape=box,color=blue];
		203 -> 208;
	206 [label="+5 Chemistry",color=orange];
		206 -> 211;
	207 [label="그렇다면 노력에도 불구하고 결과는 썩 형편없군, 반복되는 시간 속의 지인이여. 이전에 얻지 못한 결말이 무엇이기에 지금 이렇게 이루려 하는 것이지?",shape=box,color=blue];
		207 -> 212;
	204 [label="하. 이제 보니 기억 도둑일 뿐만 아니라 거짓말쟁이이기까지 하군, 찬탈자여.",shape=box,color=blue];
		204 -> 209;
