	j749506015 [label="완벽하군. 우린 전장을 설정하는 첫 번째 규칙을 정립했다: 숫자. 바로 병력 규모지. 명백하게도, 너는 압도적인 수적 열세에 놓여져 있다.",shape=box,color=blue];
