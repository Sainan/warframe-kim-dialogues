		2118 -> 2121 [label="false",color=purple];
	2117 [label="I wonder, is that what you took from me, Usurper? That we were lovers, that I confessed my love to you, and you did not feel the same?",shape=box,color=blue];
		2117 -> 2113;
	2116 [label="Whatever poor opinions you have formed of me I deserve. And you are certainly not alone in holding them. Not alone in the slightest.",shape=box,color=blue];
		2116 -> 2120;
	2115 [label="Update boolean RoatheAlone1",color=orange];
		2115 -> 2116;
	2119 [label="Chat ends.",color=orange];
	2124 [label="So tragic, indeed... I almost want the details, but I feel as though that is jumping to the end of the book before we are ready.",shape=box,color=blue];
		2124 -> 2125;
	2123 [label="But who am I kidding?! We know why you did it, don't we? And it wasn't for love of me. But for love of another. I am simply waxing poetic.",shape=box,color=blue];
		2123 -> 2125;
	2122 [label="But who am I kidding?! We know why you did it, don't we? And it wasn't for love of me. It wasn't even for love at all. I am simply waxing poetic.",shape=box,color=blue];
		2122 -> 2125;
	2121 [label="Bah. But what is the point in sitting about and waxing poetic?",shape=box,color=blue];
		2121 -> 2125;
	2120 [label="Chat ends.",color=orange];
	2125 [label="But I am not here to garner your sympathy or your pity. All of this is my own doing. Whatever poor opinions you have formed of me I deserve. And you are certainly not alone in holding them. ",shape=box,color=blue];
