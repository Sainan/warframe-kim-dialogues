digraph {
	2049 [label="RoatheRank3Convo6 begins.",color=orange];
		2049 -> 2052;
		2049 -> 2050;
		2049 -> 2051;
	2052 [label="Why are you spending so much time with the Cavia, Roathe?",shape=box,color=red];
		2052 -> 2055;
	2050 [label="Stay away from the Cavia, Roathe. It makes me nervous.",shape=box,color=red];
		2050 -> 2053;
	2051 [label="[End.]",shape=box,color=red];
		2051 -> 2054;
	2055 [label="Hm? Well, I find them some of the most unequivocally sad and pathetic creations I have ever met in all of the Void-damned Origin System. ",shape=box,color=blue];
		2055 -> 2057;
	2053 [label="To avoid as little misunderstanding as possible in this situation, I will avoid my usual verbosity and simply say this: ",shape=box,color=blue];
		2053 -> 2056;
	2054 [label="Chat ends.",color=orange];
	2057 [label="Lab animals. Lab animals, Albrecht! You threw animals into the damn Void and then when they came out yabbering in your made-up children's language you told your butler to euthanize them?!",shape=box,color=blue];
		2057 -> 2059;
	2056 [label="No.",shape=box,color=blue];
		2056 -> 2058;
	2059 [label="Always leaving everyone else to do his dirty work. But I digress. You are asking me about why I sit and talk to them. Especially the bird. It is simple. But I think I would like you to guess. I want to see if you can work it out.",shape=box,color=blue];
		2059 -> 2060;
		2059 -> 2061;
		2059 -> 2062;
		2059 -> 2063;
		2059 -> 2064;
	2058 [label="Chat ends.",color=orange];
	2060 [label="He doesn't know who you are.",shape=box,color=red];
		2060 -> 2065;
	2061 [label="Bird 3 loves everyone.",shape=box,color=red];
		2061 -> 2066;
	2062 [label="You like to surround yourself with people that make you feel smart.",shape=box,color=red];
		2062 -> 2067;
	2063 [label="He has keen observations on the people around him.",shape=box,color=red];
		2063 -> 2068;
	2064 [label="He's easy to manipulate.",shape=box,color=red];
		2064 -> 2069;
	2065 [label="Yes. In a way, that is precisely it. He does not know who I am. He knows nothing of the \"Devil of Tau.\" And he... more over, does not care.",shape=box,color=blue];
		2065 -> 2070;
	2066 [label="He does. He is quite charming in his gormless innocence. But what you are saying, in a slightly kinder and more round-about way, is that no one else could love me, is that it?",shape=box,color=blue];
		2066 -> 2071;
	2067 [label="I wish you understood how misguided you are. How very far from the mark your arrow flies... but you are not alone in your opinion of me.",shape=box,color=blue];
		2067 -> 2072;
	2068 [label="He does. And his observations are quite useful, but nothing I could not have reached myself within a few moments of my own.",shape=box,color=blue];
		2068 -> 2073;
	2069 [label="I wish you understood how misguided you are. How very far from the mark your arrow flies... but you are not alone in your opinion of me.",shape=box,color=blue];
		2069 -> 2074;
	2070 [label="+10 Chemistry",color=orange];
		2070 -> 2075;
	2071 [label="So I must rely on the idiotic bird for company? But you are close enough to the truth I suppose I will give you... a passing grade.",shape=box,color=blue];
		2071 -> 2075;
	2072 [label="Not alone in the slightest.",shape=box,color=blue];
		2072 -> 2076;
	2073 [label="What you are saying in a slightly kinder and more round-about way is that you believe I am using the large talking bird for my own ends? Is that it?",shape=box,color=blue];
		2073 -> 2077;
	2074 [label="Not alone in the slightest.",shape=box,color=blue];
		2074 -> 2078;
	2075 [label="To him, I am not Roathe. I am not Orokin. I am not a criminal. Or a traitor. Or a coward. I can simply be... myself.",shape=box,color=blue];
		2075 -> 2079;
	2076 [label="Update boolean RoatheAlone1",color=orange];
		2076 -> 2080;
	2077 [label="No. But you are not alone in your opinion of me. Not alone in the slightest.",shape=box,color=blue];
		2077 -> 2078;
	2078 [label="Update boolean RoatheAlone1",color=orange];
		2078 -> 2081;
	2079 [label="I do not think I can describe to you what a simple and rare relief it is...",shape=box,color=blue];
		2079 -> 2082;
		2079 -> 2083;
		2079 -> 2084;
	2080 [label="+5 Chemistry",color=orange];
		2080 -> 2085;
	2081 [label="+5 Chemistry",color=orange];
		2081 -> 2086;
	2082 [label="You can let it all go, you know. You can change. Even here, even now.",shape=box,color=red];
		2082 -> 2087;
	2083 [label="It must be an awful burden. Dealing with the expectations of your reputation wherever you go, even here.",shape=box,color=red];
		2083 -> 2088;
	2084 [label="Are you implying that the rest of this is some kind of show you put on?",shape=box,color=red];
		2084 -> 2089;
	2085 [label="Chat ends.",color=orange];
	2086 [label="Chat ends.",color=orange];
	2087 [label="Add 2 to Thermostat",color=orange];
		2087 -> 2090;
	2088 [label="Add -1 to Thermostat",color=orange];
		2088 -> 2091;
	2089 [label="Were it so simple, and all this were some great façade that I could change out like some masquerade visage! No, Usurper. This is who I am, down to each rotten bone of me.",shape=box,color=blue];
		2089 -> 2092;
	2090 [label="Were it so simple, Usurper. You make it all sound so tempting. Can I? Perhaps... Perhaps it is not to late, even for a sad, tragic devil such as I.",shape=box,color=blue];
		2090 -> 2093;
	2091 [label="+10 Chemistry",color=orange];
		2091 -> 2094;
	2092 [label="But that is not to say that I do not relish the opportunity to lay it all down for an hours' time and simply enjoy a conversation with someone who is none the wiser to all the terrible crimes I have committed in my day.",shape=box,color=blue];
		2092 -> 2095;
	2093 [label="+10 Chemistry",color=orange];
		2093 -> 2096;
	2094 [label="It is exhausting, Usurper. And would that I could set down the persona like some masquerade visage and never pick it up again. But this is who I am, down to each rotten bone of me.",shape=box,color=blue];
		2094 -> 2092;
	2095 [label="Update boolean RoatheBirdThree",color=orange];
		2095 -> 2097;
		2095 -> 2098;
	2096 [label="Is this nothing but a great façade I wear? Or is it burrowed deep to the rotten bone of me? I do not yet know. All I can say is that I still enjoy the opportunity to lay it all down for an hours' time when I can.",shape=box,color=blue];
		2096 -> 2099;
	2097 [label="Pardon if this seems rude but... your life sounds like it's been a lonely one.",shape=box,color=red];
		2097 -> 2100;
	2098 [label="You're not accustomed to having many friends, are you?",shape=box,color=red];
		2098 -> 2101;
	2099 [label="I set the burden aside and sit with someone who is none the wiser to my terrible crimes and talk with the giant charmingly gormless bird and find myself... at peace. For the first time in a long time.",shape=box,color=blue];
		2099 -> 2102;
	2100 [label="Evaluate expressions",color=orange];
		2100 -> 2106 [label="RoatheUnloved1, RoatheKnowsReset2",color=purple];
		2100 -> 2105 [label="RoatheKnowsReset2",color=purple];
		2100 -> 2104 [label="RoatheUnloved1",color=purple];
		2100 -> 2103 [label="false",color=purple];
	2101 [label="Check boolean RoatheKnowsReset2",color=orange];
		2101 -> 2108 [label=true,color=green];
		2101 -> 2107 [label=false,color=brown];
	2102 [label="Perhaps there is hope to what you say. Or perhaps I am fooling myself. And it is just a moment's respite.",shape=box,color=blue];
		2102 -> 2109;
	2106 [label="Yes, it has been. Or at least, what I can recall of it. Or is that what you took from me, Usurper? That we were lovers, that I confessed my love to you, and you did not feel the same?",shape=box,color=blue];
		2106 -> 2113;
	2105 [label="I will admit that it has been. At least what I can recall of it. Would it shock you to know that I have never once been in love? Not mutually, at any rate. Perhaps it would not. We have likely been through all this before, after all.",shape=box,color=blue];
		2105 -> 2112;
	2104 [label="It has been. Long and lonely. But it is all of my on doing, Usurper. I am not here to garner your sympathy or your pity.",shape=box,color=blue];
		2104 -> 2111;
	2103 [label="I will admit that it has been. At least what I can recall of it. Would it shock you to know that I have never once been in love? But it is all of my on doing, Usurper. I am not here to garner your sympathy or your pity.",shape=box,color=blue];
		2103 -> 2110;
	2108 [label="Who knows? Perhaps I had friends and I simply cannot remember them because you and I were friends before you put an end to that, hm?",shape=box,color=blue];
		2108 -> 2114;
	2107 [label="Who knows? Perhaps I had friends and I simply cannot remember them because Entrati muddled about in my head and took away my recollections of them.",shape=box,color=blue];
		2107 -> 2114;
	2109 [label="Update boolean RoatheBirdThree",color=orange];
		2109 -> 2097;
		2109 -> 2098;
	2113 [label="Or was it vice versa? You fell madly in love with the Devil Himself, but his heart remained cold to you. Distraught, you did the only thing you could--you tore his mind to shreds!",shape=box,color=blue];
		2113 -> 2118;
	2112 [label="Update boolean RoatheUnloved1",color=orange];
		2112 -> 2117;
	2111 [label="Update boolean RoatheAlone1",color=orange];
		2111 -> 2116;
	2110 [label="Update boolean RoatheUnloved1",color=orange];
		2110 -> 2115;
	2114 [label="For all the good that seems to have done me.",shape=box,color=blue];
		2114 -> 2119;
	2118 [label="Evaluate expressions",color=orange];
		2118 -> 2124 [label="RoatheDatingDeal",color=purple];
