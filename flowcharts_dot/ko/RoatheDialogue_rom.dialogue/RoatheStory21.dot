	"Chat ends." [color=orange];
	j1151571566 [label="음성 메시지: 망각",shape=box,color=blue];
		j1151571566 -> j1855068778;
	j1855068778 [label="구술 기록: 비겁자라.",shape=box,color=blue];
		j1855068778 -> j955845456;
	j955845456 [label="그렇게 불리나 보군. 아닌가? 이 먼지투성이 홀에 널려 있는 역사서들을 읽어보았다. 거짓이지. 놈들은 진실을 모른다. 내가 과업을 완수하기도 전에 내가 살던 시대로부터 끌려 나가고 말았다는 것을.",shape=box,color=blue];
		j955845456 -> j3848568135;
	j3848568135 [label="비겁자.",shape=box,color=blue];
		j3848568135 -> j1745858615;
	j1745858615 [label="이제야 기억이 난다. 그 황금빛 홀에서, 놈이 내게 접근해 왔다. 내가 모르는 얼굴을 입고 있었지만, 우리에겐 그리 드문 일도 아니지. 목소리로, 움직이는 방식으로 이미 알아볼 수 있었다.",shape=box,color=blue];
		j1745858615 -> j2382942137;
	j2382942137 [label="비겁한 자식!",shape=box,color=blue];
		j2382942137 -> j2563240369;
	j2563240369 [label="놈은 내게 단 하나의 질문을 던졌다. 이 모든 것을 잿더미로 불태워버리고도, 진정으로 용서받을 수 있으리라 믿느냐고.",shape=box,color=blue];
		j2563240369 -> j3366211749;
	j3366211749 [label="비겁한 놈!",shape=box,color=blue];
		j3366211749 -> j1028092908;
	j1028092908 [label="창백한 빛깔을 하고, 뻗어온 그 손에는... 주사기가 있었다. 반짝이는 그 안에... 자유... 또 하나의 기회... 또 하나의 삶을 담은.",shape=box,color=blue];
		j1028092908 -> j3481778041;
	j3481778041 [label="나는 그 주사를 받아들였다.",shape=box,color=blue];
		j3481778041 -> j3429971576;
	j3429971576 [label="...비겁한 새끼!",shape=box,color=blue];
		j3429971576 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}