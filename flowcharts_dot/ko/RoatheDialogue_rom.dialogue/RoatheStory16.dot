		j1753896890 -> "Chat ends." [label=false,color=brown];
	j2963576544 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j2963576544 -> j3898504651 [label="x >= 16",color=purple];
		j2963576544 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j3898504651 [label="음성 메시지: 희생",shape=box,color=blue];
		j3898504651 -> j4103806725;
	j4103806725 [label="구술 기록: 트레이본. 네 레일잭을 프라가사의 아가리에 내던지듯 돌격시키던 네 모습을 보았다. 너와 네 부하들을 탐욕스럽게 집어삼키는 데에 정신이 팔려, 프라가사는 정작 내 함선이 재빨리 달아나는 것을 눈치채지 못했지.",shape=box,color=blue];
		j4103806725 -> j995371903;
	j995371903 [label="너는 네 상관을 위해 목숨을 내놓았고, 나는 너의 이타성에 따귀라도 한 대 얻어맞은 기분이었다.",shape=box,color=blue];
		j995371903 -> j1916739051;
	j1916739051 [label="마리나. 너는 내게 네 몸을 바쳤지. 그 참호 속에서, 우리는 쿠바를 함께 마셨다. 내 손이 덜덜 떨리는 가운데 꿰뚫린 나의 목은 액체를 넘기지 못하고 흘렸지만, 효과가 발휘되는 데 필요한 몇 방울만큼은 끝내 넘겼지.",shape=box,color=blue];
		j1916739051 -> j1318861843;
	j1318861843 [label="너의 마지막 경례를, 그리고 흐려져 가던 시야를 기억한다. 그러고서 나는 한때 너의 것이었던 눈을 깜빡이며 깨어났고, 배를 갈린 내 시체가 진흙 속에 죽어 있는 것을 보았지.",shape=box,color=blue];
		j1318861843 -> j2204107109;
	j2204107109 [label="로스티그. 복제 과정에서 뭔가 잘못되었을 것이라 했다. 그게 아니면 어떻게 그리니어가 산 채로 타들어 가면서도 포탑을 끝까지 사수할 수 있었겠는가? 새앙쥐마저도 자기 보전이란 것을 알거늘!",shape=box,color=blue];
		j2204107109 -> j776779318;
	j776779318 [label="아니. 너의 그 \"결함\"은 너를 그 모든 것들보다도 고귀하게 만들었다.",shape=box,color=blue];
		j776779318 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}