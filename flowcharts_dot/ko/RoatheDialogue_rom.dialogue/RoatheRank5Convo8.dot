		j705954853 -> j4125803273;
	j4125803273 [label="Check boolean RoatheFailNot21",color=orange];
		j4125803273 -> j1758133089 [label=true,color=green];
		j4125803273 -> "Chat ends." [label=false,color=brown];
	j1758133089 [label="Evaluate expressions on HellStory counter",color=orange];
		j1758133089 -> j334755037 [label="x >= 21",color=purple];
		j1758133089 -> "Chat ends." [label="x <= 21",color=purple];
		j1758133089 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j334755037 [label="이 멍청이 같으니! 대체 무슨 짓을 한 것이냐?! 왜, 대체 왜 반겨줄 놈도 없는 공동으로 굳이 파고들어간 거냐?!",shape=box,color=blue];
		j334755037 -> j2512073207;
	j2512073207 [label="Boolean RoatheFailNot21 is now false.",color=orange];
		j2512073207 -> j3666643920;
	j3666643920 [label="명령이다. 당장 이걸 고쳐 놓아라. 이건 네 잘못이다. 느껴진단 말이다, 내게 발톱을 박아대며, 찢어발기려는 그것이! 무슨 거대한 짐승처럼.",shape=box,color=blue];
		j3666643920 -> j2616065987;
	j2616065987 [label="내게서 이걸 없애 다오. 이 역병 같은 고통을 없애 다오. 내 머리에서 이 기억들을 지워 줘. 너라면 할 수 있다는 걸 안다. 네가 가진 그 능력을 사용해 전부 끝내버리란 말이다. 당장.",shape=box,color=blue];
		j2616065987 -> j3098234556;
		j2616065987 -> j2044657983;
		j2616065987 -> j144717131;
	j3098234556 [label="진심이야? 하지만... 넌 머리가 좋잖아. 곧 있으면 무슨 일이 벌어지고 있는 건지 알아챌 것 같단 생각이 드는데.",shape=box,color=red];
		j3098234556 -> j709663057;
	j2044657983 [label="그건 기억의 종류가 달라, 로스. 그 기억엔 안 통할 거야. 그것들은 네 정신 더 깊숙한 곳에 묻혀 있다고.",shape=box,color=red];
		j2044657983 -> j1729563897;
	j144717131 [label="도망가서 숨는다고 해 봤자 안 통할 거야. 그래봤자 결국 제자리로 돌아오게 될 뿐이라고. ",shape=box,color=red];
		j144717131 -> j2010897862;
	j709663057 [label="높은 확률로 그렇겠지. 이것저것 끼워맞춰 전체를 파악하고는 해달라고 하지도 않은 짓을 했다며 널 비난할 것이야. 너는 폭풍우 같은 분노를 견뎌내야 하겠고.",shape=box,color=blue];
		j709663057 -> j3647174802;
	j1729563897 [label="그럴 지도 모르지. 네 말이 맞을 가능성이 아주 높다. 하지만 어차피 이젠 다른 선택지가 없는 게지, 응? 일단 해 볼만한 가치는 있겠지.",shape=box,color=blue];
		j1729563897 -> j3647174802;
	j2010897862 [label="그렇게 된다면, 그저 다시 지우면 그만인 것이다. 어차피 네 그 능력은 무한하지 않나, 응?",shape=box,color=blue];
		j2010897862 -> j3647174802;
	j3647174802 [label="물론 네가 내 기억을 조작했다는 것을 깨닫게 되면 네게 무시무시할 정도로 화를 내게 되겠지. 그리고 나는 그게 내가 부탁한 것이었다고 밝히지 않는 것을 권한다, 연인이여.",shape=box,color=blue];
		j3647174802 -> j1931375662;
	j1931375662 [label="나는 그저 네가 거짓말을 하고 있다 주장할 것이고, 그렇게 되면 너에 대한 내 인상은 돌이킬 수 없을 정도로 망가져버리겠지.",shape=box,color=blue];
		j1931375662 -> j1655500240;
		j1931375662 -> j4115402177;
	j1655500240 [label="안 돼. 그렇게는 못 해. 안 할 거야. 이 상황을 같이 끝까지 파헤쳐 나가야만 해. 우리 그냥 대화로 풀면 안될까?",shape=box,color=red];
		j1655500240 -> j1003134794;
	j4115402177 [label="난... 정말 다른 방법이 없는 거야?",shape=box,color=red];
		j4115402177 -> j1003134794;
	j1003134794 [label="아니. 그 집사를 위층으로 올려보내고 싶나? 그럼 내가 말한 대로 내 머릿속에서 이 모든 말도 안 되는 기억들을 지워버려라. 어떻게 되든 상관 없다면? 그럼 마음대로 하거라. 어차피 나와는 관계 없는 일이니.",shape=box,color=blue];
		j1003134794 -> j107585747;
	j107585747 [label="아, 거기에 더해, 물론, 우리의 개인적 친분, 정도까지가 이 상황에서 내가 써먹을 수 있는 유일한 협상 재료로군. 그게 다다.",shape=box,color=blue];
		j107585747 -> j3934605578;
	j3934605578 [label="어떻게 할 거지?",shape=box,color=blue];
		j3934605578 -> j1336250423;
		j3934605578 -> j3299845545;
	j1336250423 [label="알았어...할게... 해줄게. 네 기억 지워줄게. 마리랑 리온 기억도 같이 사라지게 되겠지만.",shape=box,color=red];
		j1336250423 -> j1894449330;
	j3299845545 [label="아니. 거절할래. 미안하지만, 이 문제를 직시해야 해.",shape=box,color=red];
		j3299845545 -> j1243217226;
		j3299845545 -> j1361939933;
	j1894449330 [label="+10 Chemistry",color=orange];
		j1894449330 -> j499098860;
	j1243217226 [label="차근차근 얘기해 보자고.",shape=box,color=red];
		j1243217226 -> j1592732768;
	j1361939933 [label="원망할 만큼 원망해도 돼. 하지만 이 문제가 해결될 때까지는 아무것도 하지 않을 거야.",shape=box,color=red];
		j1361939933 -> j3399112717;
	j499098860 [label="좋아. 바로 시작해라. ",shape=box,color=blue];
		j499098860 -> j4072107213;
	j1592732768 [label="감히 - 감히 내게 \"진정\"하라고 말하지 마라! 마치 몸이 두 동강 나는 듯한 고통을 느낄 권리조차 없다고 생각해서 그러는 거냐?!",shape=box,color=blue];
		j1592732768 -> j2312307746;
	j3399112717 [label="흥미롭군. 흥미롭고도 예상치 못한 부분이다. 설명해 봐라.",shape=box,color=blue];
		j3399112717 -> j509670989;
		j3399112717 -> j3288351084;
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j2312307746 [label="마치 내 자신에 대한 이해, 내 삶의 근간이 저주받은 루아처럼 산산조각 나고 갈기갈기 찢어진 것 같은 기분이다! 번지는 잉크로 다시 쓰여진 것 같단 말이다. 겁쟁이로!",shape=box,color=blue];
		j2312307746 -> j2410929376;
	j509670989 [label="내가 그런 일을 한 건 어쩔 수 없는 일이었으니까. 넌 더 이상 이 진실로부터 외면할 수 없어.",shape=box,color=red];
		j509670989 -> j1830055178;
	j3288351084 [label="나에 대해서 어떻게 생각하든 자유지만, 난 나선을 보면 바로 알아보게 돼 있어.",shape=box,color=red];
		j3288351084 -> j319765972;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
	j2410929376 [label="그런데 감히 나보고 \"진정\"하라고 말하는 거냐?!",shape=box,color=blue];
		j2410929376 -> j1830055178;
	j1830055178 [label="Evaluate expressions",color=orange];
