	j175304620 [label="넌 특별한 능력을 가지고 있다. 시간을 되돌릴 수 있는 능력, 나선으로 돌게 할 수도 있고, 반복하게 할 수도 있는 능력 말이다. 그리고 이 능력은... 감염체와의 연관성, 그리고 시간과의 연관성 때문에 프로토프레임의 정신에 흥미로운 영향을 끼친다.",shape=box,color=blue];
