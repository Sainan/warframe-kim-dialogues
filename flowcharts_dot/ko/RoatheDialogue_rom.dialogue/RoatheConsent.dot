	5408 [label="Chat ends.",color=orange];
	5407 [label="Hey Roathe? Do you have a second? [Ask consent for multiple partners.]",shape=box,color=red];
		5407 -> 5410;
	5406 [label="[End.]",shape=box,color=red];
		5406 -> 5409;
	5405 [label="Chat ends.",color=orange];
	5410 [label="Hm? What is it, darling?",shape=box,color=blue];
		5410 -> 5412;
	5409 [label="Update boolean RoatheConsentComplete",color=orange];
		5409 -> 5411;
	5412 [label="I want to talk to you about something and I want to make sure you're okay with it.",shape=box,color=red];
		5412 -> 5413;
	5411 [label="Chat ends.",color=orange];
	5413 [label="It's important to me that you don't feel like I'm lying to you or being dishonest with you.",shape=box,color=red];
		5413 -> 5414;
	5414 [label="Do go on. This sounds like it is going to be quite good.",shape=box,color=blue];
		5414 -> 5415;
	5415 [label="I don't want to put you into a situation you're not okay with. So if you say no, that's all right. I want you to know that.",shape=box,color=red];
		5415 -> 5416;
	5416 [label="What we have is important to me - very important - and it's real. I don't want you to doubt that.",shape=box,color=red];
		5416 -> 5417;
	5417 [label="Wait. By the Void, are you trying to tip-toe around the news that you have another partner?",shape=box,color=blue];
		5417 -> 5418;
	5418 [label="How much of a fool do you think I am? I already know, Drifter dear!",shape=box,color=blue];
		5418 -> 5419;
		5418 -> 5420;
	5419 [label="I take it you don't mind, then?",shape=box,color=red];
		5419 -> 5421;
	5420 [label="You... do?",shape=box,color=red];
		5420 -> 5422;
	5421 [label="If only you could hear me laughing in the Sanctum right now. Drifter, darling. Dear sweet Drifter. I am Orokin. Of course I do not mind.",shape=box,color=blue];
		5421 -> 5423;
	5422 [label="If only you could hear me laughing in the Sanctum right now. Drifter, darling. Dear sweet Drifter.",shape=box,color=blue];
		5422 -> 5424;
	5423 [label="Think what you will about my society and our penchant for enjoying the company of others in a way you may see as dismissive and belittling, we also understood what it was like to love.",shape=box,color=blue];
		5423 -> 5425;
	5424 [label="I knew the moment it happened. I have my methods. And no, I do not mind in the slightest. I am Orokin.",shape=box,color=blue];
		5424 -> 5423;
	5425 [label="No one understood love like the Orokin. And we knew that one could have room in the heart for more than one. ",shape=box,color=blue];
		5425 -> 5426;
	5426 [label="I am merely disappointed that the zealots are likely too close-minded to join in the fun.",shape=box,color=blue];
		5426 -> 5427;
	5427 [label="Pah. On second thought, that is likely for the best. Can you imagine the nonsense that would cause?",shape=box,color=blue];
		5427 -> 5428;
	5428 [label="Update boolean RoatheConsentComplete",color=orange];
		5428 -> 5429;
	5429 [label="Well, regardless. If they make you happy, then enjoy them. But know that when you are with me?",shape=box,color=blue];
		5429 -> 5430;
	5430 [label="+5 Chemistry",color=orange];
		5430 -> 5431;
	5431 [label="You are mine and mine alone.",shape=box,color=blue];
		5431 -> 5432;
	5432 [label="Chat ends.",color=orange];
