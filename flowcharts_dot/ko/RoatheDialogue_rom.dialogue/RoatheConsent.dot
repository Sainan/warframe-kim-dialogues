		j4082858284 -> "Chat ends." [label=false,color=brown];
	j2908640513 [label="이봐, 로스? 시간 좀 있어? [다수의 파트너를 둘 수 있도록 동의를 구한다.]",shape=box,color=red];
		j2908640513 -> j3896027677;
	j1331688891 [label="[종료.]",shape=box,color=red];
		j1331688891 -> j604242687;
	j3896027677 [label="흠? 무엇이지, 연인이여?",shape=box,color=blue];
		j3896027677 -> j232444981;
	j604242687 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j604242687 -> "Chat ends.";
	j232444981 [label="너랑 중요한 이야기를 하고 싶은데, 듣고 네가 괜찮을지 확인하고 싶어.",shape=box,color=red];
		j232444981 -> j404178551;
	j404178551 [label="내게 중요한 건 내가 너에게 거짓말을 하고 있거나, 솔직하게 대하지 않는다는 느낌을 네가 받지 않게 해야 한다는 점이거든.",shape=box,color=red];
		j404178551 -> j2372879822;
	j2372879822 [label="계속 해 보지 그러나. 제법 좋은 이야기일 것 같다는 생각이 든다.",shape=box,color=blue];
		j2372879822 -> j1773166913;
	j1773166913 [label="네가 괜찮지 않다 느끼는 상황에 놓이게 만들고 싶지 않아. 그러니 거절해도 괜찮아. 단지 이 점을 알아뒀으면 좋겠어.",shape=box,color=red];
		j1773166913 -> j3399535696;
	j3399535696 [label="우리의 관계는 내게 중요해. 아주 중요해. 그리고 나는 진심이고. 네가 그걸 의심하지 않았으면 좋겠어.",shape=box,color=red];
		j3399535696 -> j3957607205;
	j3957607205 [label="잠깐. 보이드 맙소사. 설마 지금 네게 다른 파트너가 생겼다는 소식을 가지고 말꼬리를 빙빙 돌리고 있는 것인가?",shape=box,color=blue];
		j3957607205 -> j600621293;
	j600621293 [label="도대체 내가 얼마나 멍청하다 생각하는 건가? 진작에 알고 있다, 내 연인 드리프터여!",shape=box,color=blue];
		j600621293 -> j2343440014;
		j600621293 -> j2862552864;
	j2343440014 [label="그 말은, 별로 신경 쓰지 않는단 얘기겠지?",shape=box,color=red];
		j2343440014 -> j3935552250;
	j2862552864 [label="안...다고?",shape=box,color=red];
		j2862552864 -> j2772135336;
	j3935552250 [label="지금 성역에서 웃어대는 내 소리를 네가 들었어야 했거늘! 드리프터, 내 연인이여. 내 사랑스러운 드리프터여. 나는 오로킨이다. 신경을 쓸 리가 없지.",shape=box,color=blue];
		j3935552250 -> j3218360747;
	j2772135336 [label="지금 성역에서 웃어대는 내 소리를 네가 들었어야 했거늘! 드리프터, 내 연인이여. 내 사랑스러운 드리프터여.",shape=box,color=blue];
		j2772135336 -> j1592628577;
	j3218360747 [label="우리의 사회, 그리고 다른 이들과 어울리는 우리의 방식이 네 눈엔 무심하고 하찮게 여기는 것처럼 보였을지 모르겠다만, 네가 어떻게 생각하든 우리 또한 사랑한다는 것이 어떤 것인지는 알고 있었다.",shape=box,color=blue];
		j3218360747 -> j1098231829;
	j1592628577 [label="그런 일이 일어난 순간부터 알고 있었다. 다 수단이 있지. 그리고 아니, 조금도 신경 쓰지 않는다. 나는 오로킨이니까.",shape=box,color=blue];
		j1592628577 -> j3218360747;
	j1098231829 [label="그 어떤 이들도 오로킨처럼 사랑을 이해하진 못했지. 그리고 우리는 한 사람이 둘 이상을 마음에 품을 수도 있다는 것을 알고 있었다. ",shape=box,color=blue];
		j1098231829 -> j2517283443;
	j2517283443 [label="그저 저 광신도들이 함께 재미를 보기엔 아마 너무 꽉 막혀 있을 거라는 것이 실망스러울 뿐이군.",shape=box,color=blue];
		j2517283443 -> j3802224673;
	j3802224673 [label="흥. 다시 생각하면, 그게 오히려 나을 지도 모를 일이다. 그게 이루어졌다간 어떤 말도 안 되는 일이 벌어질지 상상이 가느냐?",shape=box,color=blue];
		j3802224673 -> j3371508403;
	j3371508403 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j3371508403 -> j324059452;
	j324059452 [label="뭐, 어찌되었든, 그걸로 네가 만족할 수 있다면, 마음껏 즐기거라. 하지만 네가 나와 함께 있을 때엔?",shape=box,color=blue];
		j324059452 -> j2163345754;
	j2163345754 [label="+5 Chemistry",color=orange];
		j2163345754 -> j2413401661;
	j2413401661 [label="너는 오로지 나만의 것이라는 것을 알아 두어야 할 것이다.",shape=box,color=blue];
		j2413401661 -> "Chat ends.";
}