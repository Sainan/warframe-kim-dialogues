	"Chat ends." [color=orange];
	j1832979154 [label="음성 메시지: 오로킨",shape=box,color=blue];
		j1832979154 -> j3915240448;
	j3915240448 [label="구술 기록: 너무나 오랫동안, 오로킨 제국에는 적수가 없었다. 제국의 군은 그저 사소한 원한이나, 가문 간의 싸움, 집행관 사이의 싸움을 수행하기 위해 존재했을 뿐.",shape=box,color=blue];
		j3915240448 -> j2464263396;
	j2464263396 [label="센티언트들이 공격해 왔을 때, 우리는 오랫동안 박탈당했던 단결을 경험했다. 닥스들은 분수를 모르는 상것들, 혹은 도둑놈이나 다름없는 장사치들이 아닌 다른 무언가를 향해 칼을 뽑았다.",shape=box,color=blue];
		j2464263396 -> j3688661370;
	j3688661370 [label="황제들 - 명목상 통치자이나 그 권력은 집행관들에게 이양하고 만 불멸자들은, 비틀거리며 깨어나 먼지 쌓인 자신들의 황금 옥좌에 올랐다.",shape=box,color=blue];
		j3688661370 -> j3405813200;
	j3405813200 [label="전쟁, 장엄한 전쟁이다! 드디어, 제국이 의미를 갖게 되었다. 아직은 먼 태양의 죽음보다도 더욱 코앞에 다가온 절멸을 통해 스스로를 규정하게 된 우리는, 비로소 삶이라는 이름의 감로수를 깊이 들이마셨다.",shape=box,color=blue];
		j3405813200 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}