		j402528088 -> j1836310800;
	j3615406349 [label="타당하군. 하지만 내가 물품들을 \"숨겨두었던\" 장소들은 오랜 세월이 흐르는 동안 아마도... 어디론가 사라졌을 거다.",shape=box,color=blue];
		j3615406349 -> j3459221586;
