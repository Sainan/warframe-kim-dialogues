	"RoatheRank3Convo1 begins." [color=orange];
		"RoatheRank3Convo1 begins." -> j3884395195;
	j3884395195 [label="드디어 우리의 소중한 리온과 얘기를 나누게 된건가? 아니면 여전히 차가운 반을 보이고 있던가? 솔직히 말하자면, 거리를 두는 게 더 나을지도 모른다.",shape=box,color=blue];
