digraph {
	"RoatheRank3Convo1 begins." [color=orange];
		"RoatheRank3Convo1 begins." -> j499411233;
	j499411233 [label="Are you finally speaking with our dear Lyon? Or is he still giving you the cold shoulder? Honestly, you might be better off keeping a safe distance.",shape=box,color=blue];
		j499411233 -> j603661331;
		j499411233 -> j1532427375;
		j499411233 -> j242691715;
	j603661331 [label="Do you not get along with him?",shape=box,color=red];
		j603661331 -> j2451895156;
	j1532427375 [label="If you were a little kinder to Marie and Lyon, they might be kinder to you.",shape=box,color=red];
		j1532427375 -> j3167944946;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j2451895156 [label="I would \"get along\" with him better if he strove to understand a little more about who I am and from whence I hail. I am what I am. And have been for many centuries. I do not expect to change simply because they demand it now.",shape=box,color=blue];
		j2451895156 -> j3060654953;
	j3167944946 [label="And what of their kindness toward me, Usurper? I am what I am. And have been for many centuries. I do not expect to change simply because they demand it now.",shape=box,color=blue];
		j3167944946 -> j3060654953;
	"Chat ends." [color=orange];
	j3060654953 [label="Evaluate expressions on HellStory counter",color=orange];
		j3060654953 -> j2274898744 [label="x >= 21",color=purple];
		j3060654953 -> j905799151 [label="x < 21",color=purple];
		j3060654953 -> j905799151 [label="false",color=purple];
	j2274898744 [label="I may have took that serum willingly - but I know I did not sign up to be harangued at all hours by those two ingrates.  ",shape=box,color=blue];
		j2274898744 -> j1028162670;
	j905799151 [label="It is Albrecht's fault I'm like this! It's his fault I'm trapped here with them, not mine! I had nothing to do with this hideous arrangement!",shape=box,color=blue];
		j905799151 -> j1028162670;
	j1028162670 [label="They can register their complaints with their precious \"Cardinal,\" not me.",shape=box,color=blue];
		j1028162670 -> j3512719574;
		j1028162670 -> j1411373517;
		j1028162670 -> j1595842520;
	j3512719574 [label="They mean well, even if they are going about it not in the best way.",shape=box,color=red];
		j3512719574 -> j2845285288;
	j1411373517 [label="Don't you feel like you need to be forgiven for the things you've done?",shape=box,color=red];
		j1411373517 -> j1027089187;
	j1595842520 [label="They're just trying to help you.",shape=box,color=red];
		j1595842520 -> j863220740;
	j2845285288 [label="Add -1 to Thermostat counter",color=orange];
		j2845285288 -> j220887818;
	j1027089187 [label="Add 1 to Thermostat counter",color=orange];
		j1027089187 -> j3036964445;
	j863220740 [label="\"Help.\" Yes. \"Help.\" Pardon me for finding their style of \"help\" deeply \"unhelpful.\"",shape=box,color=blue];
		j863220740 -> j3784946236;
	j220887818 [label="Yes, that is the tragedy of it all. They honestly do believe they are trying to do \"good.\"",shape=box,color=blue];
		j220887818 -> j4166761131;
	j3036964445 [label="Forgiven by whom? You? Them? The butler? Albrecht? Or \"the gods?\"",shape=box,color=blue];
		j3036964445 -> j2375131449;
		j3036964445 -> j3815419821;
		j3036964445 -> j3470785504;
	j3784946236 [label="Indeed I would find it more \"helpful\" if they were to switch my wine for a caustic astringent, Usurper.",shape=box,color=blue];
		j3784946236 -> j4153325233;
	j4166761131 [label="And what do you think? Do you think I am in need of some \"great redemption?\" Some \"holy forgiveness?\"",shape=box,color=blue];
		j4166761131 -> j937239071;
	j2375131449 [label="You're leaving an important bullet off that list.",shape=box,color=red];
		j2375131449 -> j168266264;
	j3815419821 [label="You're an Orokin. You've committed atrocities in war and by the nature of your society. You have a lot to atone for.",shape=box,color=red];
		j3815419821 -> j3910628880;
	j3470785504 [label="Don't you at least recognize that you've done terrible things in your life?",shape=box,color=red];
		j3470785504 -> j3170331004;
	j4153325233 [label="It would at least be more efficient.",shape=box,color=blue];
		j4153325233 -> j297841199;
	j937239071 [label="Evaluate expressions",color=orange];
		j937239071 -> j1627408029 [label="RoatheTraitor2",color=purple];
		j937239071 -> j1663874272 [label="RoatheTraitor2",color=purple];
		j937239071 -> j1431567606 [label="RoatheTraitor2",color=purple];
		j937239071 -> j2118802610 [label="RoatheTraitor2",color=purple];
		j937239071 -> j1627408029 [label="RoatheTraitor1",color=purple];
		j937239071 -> j1663874272 [label="RoatheTraitor1",color=purple];
		j937239071 -> j1431567606 [label="RoatheTraitor1",color=purple];
		j937239071 -> j2118802610 [label="RoatheTraitor1",color=purple];
		j937239071 -> j1627408029 [label="RoatheExecutor2",color=purple];
		j937239071 -> j1663874272 [label="RoatheExecutor2",color=purple];
		j937239071 -> j1431567606 [label="RoatheExecutor2",color=purple];
		j937239071 -> j2118802610 [label="RoatheExecutor2",color=purple];
		j937239071 -> j1627408029 [label="false",color=purple];
		j937239071 -> j1663874272 [label="false",color=purple];
		j937239071 -> j1431567606 [label="false",color=purple];
	j168266264 [label="Pray tell. ",shape=box,color=blue];
		j168266264 -> j609609454;
		j168266264 -> j2487152941;
		j168266264 -> j2165308899;
	j3910628880 [label="Orokin society I will not apologize for, as I was not its creator. Merely a denizen of it. And if you are to blame all those who take part in a system that they were guilty of simply being born into, you would condemn billions in your haughty self-righteousness. As for the rest?",shape=box,color=blue];
		j3910628880 -> j3785054515;
	j3170331004 [label="And what if I have? I cannot change them now. What is the point in feeling guilt?",shape=box,color=blue];
		j3170331004 -> j2698687077;
		j3170331004 -> j2702635453;
	j297841199 [label="Though betwixt the two of them, I prefer the priest, I must admit. He listens to reason. He may just come around to the fact the Indifference is not a real god.",shape=box,color=blue];
		j297841199 -> j201886671;
	j1627408029 [label="I do think it's worth reflecting on our deeds that have harmed people and attempting to understand how to make them right. But I don't think those two are going about it the right way at all.",shape=box,color=red];
		j1627408029 -> j2708291707;
	j1663874272 [label="I don't believe in the need to forgive anyone other than yourself, in the end. If you're comfortable with the deeds you've done? So be it.",shape=box,color=red];
		j1663874272 -> j4027033312;
	j1431567606 [label="You were born into a society where a lot of Orokin behavior was just... normal. Expected. It wasn't \"wrong\" to you. I'm not saying it makes it okay, just understandable.",shape=box,color=red];
		j1431567606 -> j1890181887;
	j2118802610 [label="You were planning on overthrowing the Orokin. You knew they were corrupt, and you were trying to fix them.",shape=box,color=red];
		j2118802610 -> j2561764448;
	j609609454 [label="Yourself.",shape=box,color=red];
		j609609454 -> j959970570;
	j2487152941 [label="Your own people who you were about to betray.",shape=box,color=red];
		j2487152941 -> j3510925405;
	j2165308899 [label="The Sentients you slaughtered.",shape=box,color=red];
		j2165308899 -> j3785054515;
	j3785054515 [label="It was war. And it is the nature of war to kill those you fight against in great numbers. Do you weep for the Grineer or the \"Corpus\" you kill?",shape=box,color=blue];
		j3785054515 -> j1457441548;
		j3785054515 -> j2934595105;
		j3785054515 -> j775509054;
	j2698687077 [label="Forgiveness from others is important.",shape=box,color=red];
		j2698687077 -> j3766760591;
	j2702635453 [label="You can change how you act in the future.",shape=box,color=red];
		j2702635453 -> j2572122842;
	j201886671 [label="In fact, I might yet convince him to see through the whole of his religion - fancy that. A man who sees fanciful and bloody hallucinations, but also sense and logic. What a rarity.",shape=box,color=blue];
		j201886671 -> j3720336953;
		j201886671 -> j403228762;
	j2708291707 [label="Mm. I see. It is not the action but the methodology you object to. I hereby retract my previous approval and replace it with consternation.",shape=box,color=blue];
		j2708291707 -> "Chat ends.";
	j4027033312 [label="Boolean RoatheVillainSelf is now true.",color=orange];
		j4027033312 -> j3869033430;
	j1890181887 [label="Boolean RoatheVillainOrokin is now true.",color=orange];
		j1890181887 -> j3869033430;
	j2561764448 [label="So I think that even if you were planning on reshaping it in your own image? You knew it had to change.",shape=box,color=red];
		j2561764448 -> j4018388009;
		j2561764448 -> j2217105262;
	j959970570 [label="Check boolean RoatheKnowsReset2",color=orange];
		j959970570 -> j16760483 [label=true,color=green];
		j959970570 -> j1942685302 [label=false,color=brown];
	j3510925405 [label="I have never lost one night's sleep to any guilt over betraying my own people, Usurper. Believe me.",shape=box,color=blue];
		j3510925405 -> j2603067377;
	j1457441548 [label="No. But the Sentients are a different situation.",shape=box,color=red];
		j1457441548 -> j2730977161;
	j2934595105 [label="Yes. I do.",shape=box,color=red];
		j2934595105 -> j2910297875;
	j775509054 [label="How I feel about the lives I have to take is my own business. We're talking about you.",shape=box,color=red];
		j775509054 -> j1666123088;
	j3766760591 [label="Why? So that I am left alone? So that I am not some... anathema? Some social pariah? ",shape=box,color=blue];
		j3766760591 -> j1619612370;
	j2572122842 [label="Learning from one's mistakes is key, yes. But one does not need to feel \"guilt\" to understand \"failure.\"",shape=box,color=blue];
		j2572122842 -> j1566114467;
	j3720336953 [label="Lyon seems to be contending with enough of his own problems, don't you think?",shape=box,color=red];
		j3720336953 -> j94224466;
	j403228762 [label="I'm sorry, you're doing what?",shape=box,color=red];
		j403228762 -> j1504496295;
	j3869033430 [label="Your context was different to ours, now. And what we see as cruel and terrible you were raised to see as just another part of how the world worked.",shape=box,color=red];
		j3869033430 -> j2762237735;
	j4018388009 [label="It still doesn't excuse everything you did - travesties are travesties and horrors are horrors. But you were trying.",shape=box,color=red];
		j4018388009 -> j1474141688;
	j2217105262 [label="From my point of view, you were at war and trying to navigate a society of sociopaths while planning to overthrow it all at the same time. And they labeled you a devil for it. I don't think that's fair.",shape=box,color=red];
		j2217105262 -> j3722146913;
	j16760483 [label="For running.",shape=box,color=red];
		j16760483 -> j2340587127;
	j1942685302 [label="For failing.",shape=box,color=red];
		j1942685302 -> j2340587127;
	j2603067377 [label="I will not apologize for the Orokin Empire, as I was not its creator, merely a denizen of it. But neither will I take any blame for planning to tear it down around me. We deserved what we received, and worse.",shape=box,color=blue];
		j2603067377 -> j3575441853;
	j2730977161 [label="Every situation is a \"different situation,\" Usurper. Context is always key. And you are simply looking at the \"Old War\" with the clarity of hindsight.",shape=box,color=blue];
		j2730977161 -> j3917963790;
	j2910297875 [label="Then I feel an immense pity for you, Usurper, and I suggest you either come to accept that which you are tasked with doing, or retire from this life and take up farming.",shape=box,color=blue];
		j2910297875 -> j3704674669;
	j1666123088 [label="Mm. I love when you so clearly display I have pressed your buttons, it is so wonderfully delicious. You deflect the conversation poorly.",shape=box,color=blue];
		j1666123088 -> j3170497426;
	j1619612370 [label="Look at me, Usurper. See what I am. An Orokin, removed from their empire.",shape=box,color=blue];
		j1619612370 -> j1209696910;
	j1566114467 [label="And what is the point of forgiveness, in the end? From whom should I strive to be forgiven? Others? So that I am not some anathema?",shape=box,color=blue];
		j1566114467 -> j1619612370;
	j94224466 [label="And that is precisely what I was seeking to help him with! I am only trying to help him through some of his uncertainty regarding the Indifference and what Entrati told him.",shape=box,color=blue];
		j94224466 -> j4456978;
	j1504496295 [label="Absolutely nothing of harm, regardless of what the annoying floating gnat might tell you. I am only trying to help him through some of his uncertainty regarding what the Indifference and what Entrati told him.",shape=box,color=blue];
		j1504496295 -> j4456978;
	j2762237735 [label="+10 Chemistry",color=orange];
		j2762237735 -> j3555367686;
	j1474141688 [label="Boolean RoatheVillainOrokin is now true.",color=orange];
		j1474141688 -> j2762237735;
	j3722146913 [label="Boolean RoatheVillainShortcut is now true.",color=orange];
		j3722146913 -> j759984916;
	j2340587127 [label="Boolean RoatheForgivenessShortcut is now true.",color=orange];
		j2340587127 -> j1933300832;
	j3575441853 [label="If there is a single thing I feel guilt for? It is that the Tenno were responsible for finally burning it all down, and not me.",shape=box,color=blue];
		j3575441853 -> j533316691;
	j3917963790 [label="If you are to judge all peoples actions of the past with all the information you have in the future, you will find yourself incessantly mortified.",shape=box,color=blue];
		j3917963790 -> j554845230;
	j3704674669 [label="Though it would be a shame. It is glorious fun to watch you work. Not terribly efficient - but wonderfully flashy.",shape=box,color=blue];
		j3704674669 -> j676375239;
	j3170497426 [label="Though I suppose spending centuries by yourself with no one to talk to but the invented creations of your storybook mind does limits ones opportunities to sharpen one's social weaponry.",shape=box,color=blue];
		j3170497426 -> j621750518;
	j1209696910 [label="I was \"the Devil of Tau\" in my own time. And here, I am already \"the devil\" to all who meet me.",shape=box,color=blue];
		j1209696910 -> j3858206075;
	j4456978 [label="Entrati told him his \"visions\" were not the product of Lua but of the Indifference. This is leading him into a bit of a \"crisis of faith.\"",shape=box,color=blue];
		j4456978 -> j1087141826;
	j3555367686 [label="How charming to know that the concept of nuance and subtlety is not dead after all. Yes, you are quite right. I am a product of another time, another era, another society.",shape=box,color=blue];
		j3555367686 -> j21545698;
	j759984916 [label="+20 Chemistry",color=orange];
		j759984916 -> j2908145921;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j533316691 [label="Boolean RoatheForgivenessNoGuilt is now true.",color=orange];
		j533316691 -> j1933300832;
	j554845230 [label="Accept what has happened in the past and move on.",shape=box,color=blue];
		j554845230 -> j1507862729;
	j676375239 [label="You make the battlefield \"fun\" if nothing else. ",shape=box,color=blue];
		j676375239 -> j1507862729;
	j621750518 [label="Go spar with the Priest, you both need the practice. ",shape=box,color=blue];
		j621750518 -> j4081414586;
	j3858206075 [label="Albrecht saw fit to ensure the moniker was permanent. ",shape=box,color=blue];
		j3858206075 -> j1507862729;
	j1087141826 [label="However, I am attempting to convince him that this is not the case, and neither \"god\" sent them, as there are no \"gods.\" He is simply unwell.",shape=box,color=blue];
		j1087141826 -> j1211992884;
		j1087141826 -> j2280650092;
	j21545698 [label="I could recognize the cruelty and the travesties of my people for what they were, however. There were lows  to which many of my kind sank that even I could not stomach.",shape=box,color=blue];
		j21545698 -> j2638639778;
	j2908145921 [label="I knew I liked you for a reason, Usurper. Finally! Someone who appreciates me! It only took... how many centuries?!",shape=box,color=blue];
		j2908145921 -> j3910698344;
	j1507862729 [label="Here is my advice to you: kill all guilt in your heart over your actions, like I have. Drive a blade into its chest until it is dead.",shape=box,color=blue];
		j1507862729 -> j1220676220;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j1211992884 [label="Does Lyon want your help?",shape=box,color=red];
		j1211992884 -> j1001295770;
	j2280650092 [label="And you think that makes things better for him?",shape=box,color=red];
		j2280650092 -> j2424994168;
	j2638639778 [label="But such matters are... complex. And I appreciate that you can see that. Bah. The butler is giving me a look. I need to exit this conversation. We shall speak again soon.",shape=box,color=blue];
		j2638639778 -> "Chat ends.";
	j3910698344 [label="Bah. The butler is giving me a look. I need to exit this conversation. We shall speak again soon.",shape=box,color=blue];
		j3910698344 -> "Chat ends.";
	j1220676220 [label="Guilt is nothing but a traitor in the night who will rob you of all you hold dear. It does you nothing but harm.",shape=box,color=blue];
		j1220676220 -> j533316691;
	j1001295770 [label="He has not refused to listen. He has not told me to stop talking. I would, if he told me to.",shape=box,color=blue];
		j1001295770 -> j1283274951;
	j2424994168 [label="Is it better for the religiously-inclined to manipulate him simply because they can? To point at his hallucinations and call them \"visions\" instead of helping him?",shape=box,color=blue];
		j2424994168 -> j700071382;
	j1283274951 [label="It angers me to see those around Lyon use and manipulate him, whether or not they even realize they are doing it. All in the name of \"religion\" and \"belief.\"",shape=box,color=blue];
		j1283274951 -> j700071382;
	j700071382 [label="I have been reading the accounts of what happened. This... \"Red Veil\" could have tried to retrieve that Tenno from inside his Harrow for all those centuries. But they did not. They let him wither away and die.",shape=box,color=blue];
		j700071382 -> j369764846;
	j369764846 [label="Why? In the name of standing guard against some... theoretical \"God of the Void.\"",shape=box,color=blue];
		j369764846 -> j1057348296;
		j369764846 -> j4152398274;
	j1057348296 [label="You think Rell's sacrifice was for nothing?",shape=box,color=red];
		j1057348296 -> j800763013;
	j4152398274 [label="Rell was the only thing holding that thing back, all those years.",shape=box,color=red];
		j4152398274 -> j2482921993;
	j800763013 [label="No. He was protecting against something. But who knows how much worse he made matters? Who knows how much of himself and his fear and dread he fed it, for all those centuries?",shape=box,color=blue];
		j800763013 -> j83970865;
	j2482921993 [label="Or he was the only thing feeding it, all those years.",shape=box,color=blue];
		j2482921993 -> j83970865;
	j83970865 [label="Conceptual embodiment only manifests what it is given to create with. And the Void can only work with the cloth it is given to sew from.",shape=box,color=blue];
		j83970865 -> j2620294746;
	j2620294746 [label="How much did that one Tenno pour into its existence alone, I wonder? He was a veritable feast of Agony, Pain, Betrayal, Sadness... Loneliness...",shape=box,color=blue];
		j2620294746 -> j705454502;
	j705454502 [label="And the numbness that must come with the thousands of years he spent alone in that place, speaking into the Nothingness. What follows with that, if not Indifference?",shape=box,color=blue];
		j705454502 -> j572581504;
		j705454502 -> j1130964076;
	j572581504 [label="It's possible what you're saying is true. I just... don't know that it is. And I don't know that it isn't.",shape=box,color=red];
		j572581504 -> j1466683420;
	j1130964076 [label="It was powerful before it got to Rell. He wouldn't have sacrificed himself like that without good reason.",shape=box,color=red];
		j1130964076 -> j1153066795;
	j1466683420 [label="+10 Chemistry",color=orange];
		j1466683420 -> j4234686140;
	j1153066795 [label="So are children's nightmares. They are the most powerful creatures in the universe to a six-year-old. But to an adult, they are nothing but a puff of lint caught in a vent that drifted too close to the light.",shape=box,color=blue];
		j1153066795 -> j844888828;
	j4234686140 [label="I do not think I could ask for anything more than for you to simply admit you do not know for certain what we are dealing with.",shape=box,color=blue];
		j4234686140 -> j2510016574;
	j844888828 [label="We make mountains out of specks of dust simply because we must have a reason to be miserable and destroy ourselves.",shape=box,color=blue];
		j844888828 -> j3726658528;
	j2510016574 [label="That is a gloriously wonderful place to start. And an admirable trait for any person to own: the simple ability to just say... \"I do not know.\"",shape=box,color=blue];
		j2510016574 -> j2280634445;
	j3726658528 [label="Humanity at a glance.",shape=box,color=blue];
		j3726658528 -> j3208040028;
	j2280634445 [label="If we Orokin could have mustered that once and a while, we might have survived.",shape=box,color=blue];
		j2280634445 -> j3208040028;
	j3208040028 [label="Boolean RoatheMITW3 is now true.",color=orange];
		j3208040028 -> j1933300832;
}