	"Chat ends." [color=orange];
	j4242008947 [label="음성 메시지: 협상",shape=box,color=blue];
		j4242008947 -> j3620386567;
	j3620386567 [label="구술 기록: 7인의 집행관 중, 발라스는 동등한 자들 중 으뜸을 자처하곤 했다. ",shape=box,color=blue];
		j3620386567 -> j807884700;
	j807884700 [label="늘 협상에 능하고, 늘상 달콤한 목소리로 남들을 꼬드기는 그는, 다른 이들의 원한과 분쟁을 곧잘 해결하곤 했지.",shape=box,color=blue];
		j807884700 -> j2287155273;
	j2287155273 [label="내게는 참으로 즐겁게도, 나는 그가 지금 두 가시덤불 사이에 낀 장미와 같은 신세라는 것을 알게 되었다. ",shape=box,color=blue];
		j2287155273 -> j2838140882;
	j2838140882 [label="덤불의 한쪽은 니토크가 이끄는 주전파가, 다른 한쪽은 스칸이 이끄는 화평파가 잡아당기고 있었다.",shape=box,color=blue];
		j2838140882 -> j2802386933;
	j2802386933 [label="발라스는 둘 중 어느 쪽으로든 결정을 내리고, 그가 편들지 않은 다른 쪽의 맹렬한 적대감을 사야만 하는 상황에 몰려 있었다.",shape=box,color=blue];
		j2802386933 -> j2965550405;
	j2965550405 [label="나로서는 도저히 짐작할 수조차 없는 이유로, 그는 화평을 선택했다. 4대 3. 그렇게 탐욕스러운 센티언트 놈들은 갑자기 아군이자 친구가 되었다.",shape=box,color=blue];
		j2965550405 -> j3653414596;
	j3653414596 [label="\"어떤 식으로든, 그는 돌아설 수밖에 없게 될 거야.\" 니토크는 장담했고, 그런 와중 나는 현지에 배치된 닥스들 중 불만분자를 찾아내라는 임무에 파견되었다.",shape=box,color=blue];
		j3653414596 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}