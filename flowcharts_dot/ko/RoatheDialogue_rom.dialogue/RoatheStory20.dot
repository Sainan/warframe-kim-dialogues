	"RoatheStory20 begins." [color=orange];
		"RoatheStory20 begins." -> j1115489240;
	j1115489240 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:StoryConditions(dialogueType=/Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue, rank=4, count=10, storyCount=20)",color=orange];
		j1115489240 -> j1035281352 [label=true,color=green];
		j1115489240 -> "Chat ends." [label=false,color=brown];
	j1035281352 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1035281352 -> j1264023284 [label="x >= 20",color=purple];
		j1035281352 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j1264023284 [label="음성 메시지: 복종",shape=box,color=blue];
		j1264023284 -> j1176608585;
	j1176608585 [label="구술 기록: 나는 처음부터 이해하고 있었다. 전장에서든, 침실에서든 - 굴복하는 척하며 승리하는 길을.",shape=box,color=blue];
		j1176608585 -> j614791482;
	j614791482 [label="내가 물러서는 모습을 적이 본다면, 반드시 밀고 들어오리라는 것을 확신할 수 있으니, 그다음은 쉽게 넘어뜨릴 수 있는 것이다.",shape=box,color=blue];
		j614791482 -> j1462090343;
	j1462090343 [label="\"앞잡이\", 그렇게 불렸던가. \"애완견.\" 니토크는 자신이 주도권을 쥐고 있다고 믿고 있었다. 내가 얼마나 교묘하고 비밀스럽게 그녀를 유도했는지. ",shape=box,color=blue];
		j1462090343 -> j1295628377;
	j1295628377 [label="피투성이 손의 로스. 제 부하를 잡아먹어 살찌운 식인귀 로스. 목숨을 초개같이 낭비하는 자.",shape=box,color=blue];
		j1295628377 -> j193076193;
	j193076193 [label="무슨, 내가 오로지 싸움만을 위해 싸움에 임한다는 듯이! 아니, 오로킨 제국은 반드시 끝나야만 한다.",shape=box,color=blue];
		j193076193 -> j379581701;
	j379581701 [label="그게 실현되기 위해선, 전쟁이 반드시 계속되어야만 한다. 오로지 절대적이고도 되돌릴 수 없는 패배만이, 저 일곱 마리의 황금 돌짐승을 무너뜨릴 수 있을 것이다.",shape=box,color=blue];
		j379581701 -> j2923772991;
	j2923772991 [label="니토크조차도 나의 본심은 모르고 있었다. 그저 내가 그녀의 곁에서 함께 통치하길 꿈꾸는 줄로만 알았겠지.",shape=box,color=blue];
		j2923772991 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}