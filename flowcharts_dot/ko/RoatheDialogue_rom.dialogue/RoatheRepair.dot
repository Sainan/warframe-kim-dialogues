		j3136897973 -> j3578420640 [label=false,color=brown];
	j3578420640 [label="자, 그럼. 이젠 이 전쟁의 다음 전투로 넘어가도 되는 거겠지? 집사 말이다.",shape=box,color=blue];
		j3578420640 -> j2730270238;
	j2730270238 [label="나로서는, 너무나 고대하고 있으니 말이다.",shape=box,color=blue];
