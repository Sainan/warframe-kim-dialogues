digraph {
	"RoatheRepair begins." [color=orange];
		"RoatheRepair begins." -> j2688688654;
	j2688688654 [label="Evaluate expressions",color=orange];
		j2688688654 -> j2326214228 [label="LyonRoatheFailFix, MarieRoatheFailFix",color=purple];
		j2688688654 -> "Chat ends." [label="false",color=purple];
	j2326214228 [label="그만! 그만. 항복이다! 네 광신도 놈들의 맹공격을 멈춰 다오. 아주 미친 쿠브로돈보다도 더해! 그 빌어먹을 것들은 어딜 가나 나를 졸졸 쫓아다니지. 잠도 발뻗고 잘 수가 없어!",shape=box,color=blue];
		j2326214228 -> j2190422764;
	"Chat ends." [color=orange];
	j2190422764 [label="무엇이냐?! 도대체 무얼 원하는 게야?!",shape=box,color=blue];
		j2190422764 -> j277260646;
		j2190422764 -> j1593095106;
		j2190422764 -> j3151341041;
	j277260646 [label="혈청 맞은 일에 대해 다시 한 번 얘기해 보고 싶어. 로스. 이제 도망을 멈출 시간이야. ",shape=box,color=red];
		j277260646 -> j1979205857;
	j1593095106 [label="로스. 혈청을 맞았다는 사실로 네가 비겁자가 되는 건 아니야. 오히려 그 일 덕에 너는 유일하게 살아남은 오로킨이 된 거라고. 받아들여.",shape=box,color=red];
		j1593095106 -> j1420398166;
	j3151341041 [label="로스. 혈청을 맞았다는 사실로 네가 비겁자가 되는 건 아니야. 그 덕에 새로운 삶의 기회를 얻었잖아. 진짜 변화를 만들어낼 수 있는.",shape=box,color=red];
		j3151341041 -> j62611055;
	j1979205857 [label="Evaluate expressions on Thermostat counter",color=orange];
		j1979205857 -> j493452146 [label="x >= 5",color=purple];
		j1979205857 -> j2049376449 [label="x <= 0",color=purple];
		j1979205857 -> j3051674447 [label="x > 0 && x < 5",color=purple];
		j1979205857 -> j3051674447 [label="false",color=purple];
	j1420398166 [label="Add -5 to Thermostat counter",color=orange];
		j1420398166 -> j1979205857;
	j62611055 [label="Add 5 to Thermostat counter",color=orange];
		j62611055 -> j1979205857;
	j493452146 [label="너는 그 분노에 사로잡혀 내면부터 갉아먹히고 있는 거야. 그 분노를 오히려 이용해 오늘날 이 세상을 아직도 파괴하고 있는 놈들과 싸우는 데 쓸 수도 있는 거라고. 지금. 이 현재에서.",shape=box,color=red];
		j493452146 -> j2220717320;
	j2049376449 [label="넌 지금 비난의 화살을 네게 돌리고 있는 거야. 그 화살을 세상으로 돌려야지. 오로킨 제국으로부터 세상을 구원하려 최선을 다한 것 뿐인데도 널 비난하는 세상으로.",shape=box,color=red];
		j2049376449 -> j3848315897;
	j3051674447 [label="그런 이유로 놈들을 시켜 나를 밤낮으로 괴롭혔다고? 고작 그런 이유로? 이게 그 네 그 한심한 주장을 듣게 만들려는 마지막 발악이었단 말이냐?",shape=box,color=blue];
		j3051674447 -> j2051524203;
	j2220717320 [label="과거는 너라는 존재를 규정짓지 않아, 로스. 널 규정짓는 건 네 미래야. 그리고 그 나가 북소리의 밤에 모조리 죽어버린 다른 오로킨들과는 다르게, 네겐 아직 누릴 미래가 있잖아.",shape=box,color=red];
		j2220717320 -> j2685707137;
	j3848315897 [label="주변에서 널 보는 시선이 널 규정짓는 게 아니야. 그들이 네 행동을 어떻게 보는가도 아니고. 널 규정짓는 건 네가 너 자신, 그리고 너의 선택에 대해 어떻게 믿느냐지.",shape=box,color=red];
		j3848315897 -> j3132972996;
	j2051524203 [label="아니.",shape=box,color=blue];
		j2051524203 -> j4071251330;
	j2685707137 [label="그게 바로 지금 현재, 널 규정짓는 유일한 것이야. 너는 바뀔 수 있어. 그리고 네 주변의 세상도 바꿀 수 있다고. 여기서 내가 건넬 질문은 하나 뿐인 것 같네. 적어도, 시도라도 해 주지 않을래?",shape=box,color=red];
		j2685707137 -> j1549838673;
	j3132972996 [label="그리고 이 상황에서 딱 하나 명확하게 간단한 사실이 뭔지 알아? 넌 나가 북의 밤을 살아남은 굉장히 소수의 오로킨 중 하나라는 거야. 내 시각에서 보자면? 그저 작전상 후퇴였을 뿐인 걸로 보이네.",shape=box,color=red];
		j3132972996 -> j3677047082;
	j4071251330 [label="네 실패는 눈 뜨고 못 봐줄 정도로군. 벌써 한 번도 아니고 두 번째.",shape=box,color=blue];
		j4071251330 -> j2365530810;
	j1549838673 [label="너 자신을 용서하고 앞으로 나아가려는 시도.",shape=box,color=red];
		j1549838673 -> j1403721508;
	j3677047082 [label="그 이상도, 그 이하도 아닌.",shape=box,color=red];
		j3677047082 -> j25415658;
	j2365530810 [label="혹여나 공직 따위에 출마하려는 생각은 하지 않는 것이 좋을 것이다.",shape=box,color=blue];
		j2365530810 -> "Chat ends.";
	j1403721508 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j1403721508 -> j1612673224;
	j25415658 [label="Boolean RoatheVillain is now true.",color=orange];
		j25415658 -> j3490606760;
	j1612673224 [label="+20 Chemistry",color=orange];
		j1612673224 -> j2424612101;
	j3490606760 [label="+20 Chemistry",color=orange];
		j3490606760 -> j2215547825;
	j2424612101 [label="내가 저지른 그 모든 짓들을 용서하라고? 그리고 미래로 나아가라고? 음...",shape=box,color=blue];
		j2424612101 -> j1842129199;
	j2215547825 [label="전쟁에서 이기기 위한 일보 후퇴라. 흠. ",shape=box,color=blue];
		j2215547825 -> j3372382569;
	j1842129199 [label="이 상황에 대한 너의 그 재해석에는 약간의 의구심이 들긴 한다만, 그걸 거부하기엔 난... 이 새로운 미래가 내게 어떤 의미가 될지 너무나 솔깃하여 뿌리칠 수가 없다, 연인 드리프터여.",shape=box,color=blue];
		j1842129199 -> j3855990344;
	j3372382569 [label="이 사건들을... 작전상 후퇴로 재정의하려는 네 시도는 조금 의구심이 들긴 한다만, 솔직히 말해... 마음에 들지 않는다고 말할 수는 없군. 내 연인 드리프터여.",shape=box,color=blue];
		j3372382569 -> j110126690;
	j3855990344 [label="내 삶에 주어진 이 \"새로운 기회\"라. 좋다. 너의 논조를 인정하고 받아들이도록 하지. 꽤나 늦었지만, 효과적이었던 건... 매한가지이니.",shape=box,color=blue];
		j3855990344 -> j2214700998;
	j110126690 [label="좋다. 너의 논조를 인정하고 받아들이도록 하지. 꽤나 늦었지만, 효과적이었던 건... 매한가지이니.",shape=box,color=blue];
		j110126690 -> j2214700998;
	j2214700998 [label="네 말에 감사한다. 네 생각보다도 훨씬 더.",shape=box,color=blue];
