	2132 [label="Transcript: Her madness was seductive because it was obvious.",shape=box,color=blue];
		2132 -> 5636;
	5636 [label="누구라도 그녀와 함께 있다 보면 자신이 지금 어디에 서 있는지 - 거대한 나락 같은 공동의 가장자리 - 항상 깨닫게 되곤 했지.",shape=box,color=blue];
		5636 -> 5635;
	5635 [label="'뛰어들어 봐,' 마치 거대한 우주와 같은 장난기로부터 나오는 즐거움으로 빛을 내며, 그녀의 눈은 내게 말하곤 했다.",shape=box,color=blue];
		5635 -> 5637;
	5637 [label="그녀의 정신 나간 환상을 통해 나는, 이 길고도 암울한 오로킨으로서의 존재의식으로부터 벗어날 수 있었다.",shape=box,color=blue];
		5637 -> 2136;
	2136 [label="우리의 감각들은 과잉에 묻힌 나머지 이미 수백 년 전부터 마비되어 있었다. 그러나 그녀는, 나름의 방식이지만, 생생한 상태를 유지하고 있었던 것이다.",shape=box,color=blue];
		2136 -> 5638;
	5638 [label="영원히, 끝이 없는 굶주림을 간직하며. 어느 저녁 그녀는 나를 자신의 목욕에 초대했고, 나는 피와 향 섞인 물이 섞인 웅덩이 사이를 거침없이 걸어가 충직한 모습으로 그녀의 명을 기다렸다.",shape=box,color=blue];
		5638 -> 5639;
	5639 [label="\"지루해 죽겠구나, 로스. 다른 오로킨들을 모두 죽이고 우리가 그 자리를 빼앗자.\"",shape=box,color=blue];
		5639 -> 2135;
	2135 [label="Add 1 to HellStory",color=orange];
