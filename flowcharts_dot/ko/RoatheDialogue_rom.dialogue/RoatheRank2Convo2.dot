		j3804077044 -> j1899313575;
	j167777186 [label="음, 그렇군. 뭐, 넌 아무래도 이렇게까지 기억이 산산조각 난 다른 프로토프레임을... 상대해 본 적이 없을 테니까. 그런 점에서 네 심정을 어느 정도는 이해할 수 있다. 이 모든 게 \"사랑\"이라는 이름으로 벌어진 일이니까.",shape=box,color=blue];
