		j1762822375 -> j1099064160;
	j4107849765 [label="발라스는 집행관이었다. 사실상 일곱의 황금 군주들 중 가장 강력한 자 중 하나였지. 그가 마굴리스를 침실로 부르기만 해도 그녀는 조금의 망설임도 없이 그곳으로 향해야 했을 거다.",shape=box,color=blue];
