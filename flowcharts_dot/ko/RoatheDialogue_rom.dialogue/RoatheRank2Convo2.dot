		j2208849165 -> j2540820459;
	j3813664734 [label="난 우리 모두 다듬어지지 않은 원석과 같다고 믿고 싶다. 우리에겐 결점이 있고, 특징도 있다. 여기저기에 핏줄이 드러나고, 흠집이 있기도 하지.",shape=box,color=blue];
