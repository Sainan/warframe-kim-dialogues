	j2489376160 [label="음성 메시지: 분열",shape=box,color=blue];
		j2489376160 -> j1145799491;
	j1145799491 [label="구술 기록: 센티언트들의 첫 성계 침공과 처참하게 끝난 오로킨의 반격 이후, 제국에는 기묘한 침묵이 내렸다.",shape=box,color=blue];
		j1145799491 -> j1982531964;
	j1982531964 [label="타우에 고립된 동포들에게서 소식이 없었다, 이것이 통신을 방해받아서인지, 아니면 모두가 흔적도 남김없이 말살되었는지는 알 길이 없는 일이었다.",shape=box,color=blue];
		j1982531964 -> j3927603341;
	j3927603341 [label="곧 나는 의견을 구하는 요청을 받게 되었다. 전략가로서, 저들은 내가 적에 대해 낱낱이 알 거라 기대했으니까.",shape=box,color=blue];
		j3927603341 -> j2789737959;
	j2789737959 [label="센티언트들은 타우 위의 솔라 레일 터미너스를 언제든 파괴할 수 있었지만, 레일은 아직도 작동 중이었다.",shape=box,color=blue];
		j2789737959 -> j4243534321;
	j4243534321 [label="어째서지? 문을 계속 열어놓아 저들이 얻는 이득이란 뭐지?",shape=box,color=blue];
		j4243534321 -> j3099188759;
	j3099188759 [label="놈들의 공격은 단결된 의지인가, 아니면 일부는 아직 평화로운 공존을 희망하고 있는 것인가?",shape=box,color=blue];
		j3099188759 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}