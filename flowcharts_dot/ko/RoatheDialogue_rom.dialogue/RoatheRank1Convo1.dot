		47 -> 52;
	41 [label="이미 무슨 유리공방 안 만취한 라잘리온마냥 내 머릿속을 이리저리 때려부수고 다니고 있는 너이니, 그 머릿속 내용물들이 도대체 무얼 의미하는 것인지 해독하는 데 네 도움이 필요하다.",shape=box,color=blue];
		41 -> 48;
	42 [label="너와 그 두 광신도 녀석이 이미 내 머릿속을 유리공방 안 만취한 라잘리온마냥 휘젓고 다니기 시작했지. 그 머릿속 내용물들이 도대체 무얼 의미하는 것인지 해독하는 데 네 도움이 필요하다.",shape=box,color=blue];
		42 -> 48;
	43 [label="알브레히트가 그 주사를 내 목에 꽂아 나를 이런... 이런 것으로 만들었을 때, 놈은 내게 또 다른 무언가를 했다. 오로킨들 사이의 흔한 놀음이라면 또 모른다. 하지만 이런 건? 이따위 건 완전히 별개의 얘기지.",shape=box,color=blue];
		43 -> 49;
