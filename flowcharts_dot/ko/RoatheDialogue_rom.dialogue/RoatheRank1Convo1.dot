		50 -> 45;
	51 [label="보아하니 이제는 그저 나를 조롱하려 여기꺼지 온 모양이로구나. 그렇다면 지금 어서 실컷 조롱하고, 더 걸릴 것 없이 다음 이야기로 넘어가기를 바란다.",shape=box,color=blue];
		51 -> 57;
	52 [label="1999년 때는 그 해 자체가 되풀이되고 있으니까, 프로토프레임들한텐 다 먹히는 줄 알았단 말이야. 근데 아니었나봐.",shape=box,color=red];
		52 -> 58;
	48 [label="내 기억을 되찾는 데 네 도움이 필요할 뿐만 아니라 - 상처에 소금을 뿌리기라도 하는 것처럼, 그 기억의 진실을 내 스스로 알아볼 방법 또한 찾을 수가 없으니 말이다!",shape=box,color=blue];
		48 -> 53;
		48 -> 54;
	49 [label="놈은 내 기억 대부분을 앗아 갔다. 너의 그... 작은 아이 모습은 기억나더군. 그것이 그 트라우마에 시달리는 텐노 친구들과 쏘다니는 모습이. 로터스가 그것에게 되찾아주려 하는 것이 무엇인지는 알 것 같다.",shape=box,color=blue];
		49 -> 55;
		49 -> 56;
	57 [label="어느 가희의 장식용으로 교잡된 깽깽거리는 쿠브로처럼, 이렇게 발밑에 깔린 듯한 굴욕에 계속 견디고 싶지는 않으니 말이다.",shape=box,color=blue];
		57 -> 63;
		57 -> 64;
	58 [label="아무래도... 이건 감염체 자체랑 더 관련이 있는 것 같아? 이걸 어느 정도 넌지시 말해준 말하는 기타가 있었거든. 그리고 너도 헬민스를 통해서 여기로 온 거잖아, 그치?",shape=box,color=red];
		58 -> 65;
	53 [label="그러니까 너는 그냥... 누구한테 이야기를 털어놓고 싶은 거라고?",shape=box,color=red];
		53 -> 59;
	54 [label="내가 도와줄 수 있는 거라면 기꺼이 도와줄게. 어떻게 하는지를 정말 몰라서 그렇지.",shape=box,color=red];
		54 -> 60;
	55 [label="그럼... 왜 직접 다크 리프랙토리에 들어가지 않는 건데?",shape=box,color=red];
		55 -> 61;
	56 [label="꼬맹이를 \"그것\"이라 부르면 안 되지.",shape=box,color=red];
		56 -> 62;
	63 [label="넌 도망쳤지. 하지만 어차피 많은 사람들이 도망치곤 해. 중요한 건 이미 일어난 일을 제대로 마주하는 것일 뿐.",shape=box,color=red];
