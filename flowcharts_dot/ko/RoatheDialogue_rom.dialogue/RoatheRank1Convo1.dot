		j4026548805 -> j1675517771 [label="x <= 0",color=purple];
		j4026548805 -> j1675517771 [label="false",color=purple];
	j1102035201 [label="그래, 해 보거라.",shape=box,color=blue];
		j1102035201 -> j2853196812;
	j1057109103 [label="당장 급한 일이 -",shape=box,color=blue];
		j1057109103 -> j484168751;
	j784869560 [label="오! 그것 참 불편을 끼쳐 참 미안하게 되었군. 네 우선순위 명단이 이미 꽉 찼다는걸 감히 몰라보아서!",shape=box,color=blue];
		j784869560 -> j4130924731;
	j1892246300 [label="+5 Chemistry",color=orange];
		j1892246300 -> j4142968700;
	j542267014 [label="그리고 그 점에 있어선, 내 기준에 네가 찬탈자로 여겨질 여지가 적어도 두 가지는 있다는 것이지. (그리고 그 집사가 이야기한 두비리에서의 일까지 합친다면 세 가지일지도 모르겠다만, 그것은 나중의 논쟁거리로 밀어 두도록 할까.)",shape=box,color=blue];
		j542267014 -> j4078429900;
	j629627867 [label="그래, 그 점은 참으로 몇 번이고 잔인할 정도로 분명히 보여주더군. 고맙기 그지없게도.",shape=box,color=blue];
		j629627867 -> j2853196812;
	j1121210105 [label="그 점은 분명히 해 준 바 있지.",shape=box,color=blue];
		j1121210105 -> j2853196812;
	j1675517771 [label="두고 볼 일이지.",shape=box,color=blue];
		j1675517771 -> j2853196812;
	j2853196812 [label="자, 거래는 간단한 것이다. 내 매력적일 정도로 덧없고도 무상한 새 \"친구\"여.",shape=box,color=blue];
		j2853196812 -> j1071362491;
	j484168751 [label="당장 급한 일이 아니어 보였다고?!",shape=box,color=blue];
		j484168751 -> j3337969868;
	j4130924731 [label="참, 진심으로 놀랍기 그지없군. 네 예의는 그야말로 끔찍하기 짝이 없다, 드리프터여.",shape=box,color=blue];
		j4130924731 -> j2955882185;
	j4142968700 [label="뭐라고? 그리고 도대체 정확히 뭘 어떻게 했길래 네가 내 머릿속을 나베루스 파티의 말리움 그릇마냥 뒤적거리고 다니는 꼴을 내가 잊는단 말이냐?",shape=box,color=blue];
		j4142968700 -> j2625053964;
		j4142968700 -> j2457717966;
	j1071362491 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1071362491 -> j307650848 [label="x >= 21",color=purple];
		j1071362491 -> j1770164572 [label="x >= 1",color=purple];
		j1071362491 -> j3727390579 [label="x <= 0",color=purple];
		j1071362491 -> j3727390579 [label="false",color=purple];
	j3337969868 [label="네놈은 보통 사람을 먼저 제대로 알 기회도 갖지 않고, 상대의 의사는 모조리 무시한 채 무작정 머릿속에 쳐들어가 주물럭거리는 버릇이 있더냐?!",shape=box,color=blue];
		j3337969868 -> j2930419019;
	j2955882185 [label="하지만 아무래도 지금와서 할 수 있는 건 아무것도 없는 것 같군. 너는 이미 진실을 알고, 나는 네 눈앞에 그 혐오스러운 비겁함을 낱낱이 발가벗겨졌으니.",shape=box,color=blue];
		j2955882185 -> j3940443182;
	j2625053964 [label="긴 얘기니까 간단히 말하자면, 프로토프레임 혈청에까지 영향을 미치는 것 같은 이... 어떤 감염 양상이 있는데...",shape=box,color=red];
		j2625053964 -> j3650007080;
	j2457717966 [label="아. 뭐... 음. 그러니까, 나한테 시간을 되돌리는 능력이 있는데.",shape=box,color=red];
		j2457717966 -> j3650007080;
	j307650848 [label="이미 무슨 유리공방 안 만취한 라잘리온마냥 내 머릿속을 이리저리 때려부수고 다니고 있는 너이니, 그 머릿속 내용물들이 도대체 무얼 의미하는 것인지 해독하는 데 네 도움이 필요하다.",shape=box,color=blue];
		j307650848 -> j1545535964;
	j1770164572 [label="너와 그 두 광신도 녀석이 이미 내 머릿속을 유리공방 안 만취한 라잘리온마냥 휘젓고 다니기 시작했지. 그 머릿속 내용물들이 도대체 무얼 의미하는 것인지 해독하는 데 네 도움이 필요하다.",shape=box,color=blue];
		j1770164572 -> j1545535964;
	j3727390579 [label="알브레히트가 그 주사를 내 목에 꽂아 나를 이런... 이런 것으로 만들었을 때, 놈은 내게 또 다른 무언가를 했다. 오로킨들 사이의 흔한 놀음이라면 또 모른다. 하지만 이런 건? 이따위 건 완전히 별개의 얘기지.",shape=box,color=blue];
		j3727390579 -> j3705736247;
	j2930419019 [label="네 예의는 그야말로 끔찍하기 짝이 없다!",shape=box,color=blue];
		j2930419019 -> j2955882185;
	j3940443182 [label="보아하니 이제는 그저 나를 조롱하려 여기꺼지 온 모양이로구나. 그렇다면 지금 어서 실컷 조롱하고, 더 걸릴 것 없이 다음 이야기로 넘어가기를 바란다.",shape=box,color=blue];
		j3940443182 -> j2367052251;
	j3650007080 [label="1999년 때는 그 해 자체가 되풀이되고 있으니까, 프로토프레임들한텐 다 먹히는 줄 알았단 말이야. 근데 아니었나봐.",shape=box,color=red];
		j3650007080 -> j3774812409;
	j1545535964 [label="내 기억을 되찾는 데 네 도움이 필요할 뿐만 아니라 - 상처에 소금을 뿌리기라도 하는 것처럼, 그 기억의 진실을 내 스스로 알아볼 방법 또한 찾을 수가 없으니 말이다!",shape=box,color=blue];
		j1545535964 -> j1876522358;
		j1545535964 -> j2264994874;
	j3705736247 [label="놈은 내 기억 대부분을 앗아 갔다. 너의 그... 작은 아이 모습은 기억나더군. 그것이 그 트라우마에 시달리는 텐노 친구들과 쏘다니는 모습이. 로터스가 그것에게 되찾아주려 하는 것이 무엇인지는 알 것 같다.",shape=box,color=blue];
		j3705736247 -> j1662525764;
		j3705736247 -> j3047008847;
	j2367052251 [label="어느 가희의 장식용으로 교잡된 깽깽거리는 쿠브로처럼, 이렇게 발밑에 깔린 듯한 굴욕에 계속 견디고 싶지는 않으니 말이다.",shape=box,color=blue];
		j2367052251 -> j3730569598;
		j2367052251 -> j1656530562;
	j3774812409 [label="아무래도... 이건 감염체 자체랑 더 관련이 있는 것 같아? 이걸 어느 정도 넌지시 말해준 말하는 기타가 있었거든. 그리고 너도 헬민스를 통해서 여기로 온 거잖아, 그치?",shape=box,color=red];
		j3774812409 -> j2188730430;
	j1876522358 [label="그러니까 너는 그냥... 누구한테 이야기를 털어놓고 싶은 거라고?",shape=box,color=red];
		j1876522358 -> j487649129;
	j2264994874 [label="내가 도와줄 수 있는 거라면 기꺼이 도와줄게. 어떻게 하는지를 정말 몰라서 그렇지.",shape=box,color=red];
		j2264994874 -> j1377684663;
	j1662525764 [label="그럼... 왜 직접 다크 리프랙토리에 들어가지 않는 건데?",shape=box,color=red];
		j1662525764 -> j635631160;
	j3047008847 [label="꼬맹이를 \"그것\"이라 부르면 안 되지.",shape=box,color=red];
		j3047008847 -> j575430209;
	j3730569598 [label="넌 도망쳤지. 하지만 어차피 많은 사람들이 도망치곤 해. 중요한 건 이미 일어난 일을 제대로 마주하는 것일 뿐.",shape=box,color=red];
		j3730569598 -> j2655447537;
	j1656530562 [label="널 조롱하진 않을 거야. 결국 또 다른 자리에서 넌 싸우기로 했잖아.",shape=box,color=red];
		j1656530562 -> j317770250;
	j2188730430 [label="이 이야기 전체에 대해 걱정스러울 정도로 확실한 게 없군, 드리프터. 특히 내 두개골 속 내용물에 대해선 더더욱 말이야.",shape=box,color=blue];
		j2188730430 -> j1484100229;
	j487649129 [label="오, 긴 소파 같은 데 드러누워 내 \"감정\" 이야기를 늘어놓으면 다 될 것만 같이 말하는 건 그만두거라.",shape=box,color=blue];
		j487649129 -> j1377684663;
	j1377684663 [label="나는 그저 내 대신 저 기계를 작동시켜 줄 누군가가 필요한 것 뿐이다. 지금은 내 손으로 할 수 없는 일이니 말이야. ",shape=box,color=blue];
		j1377684663 -> j3390686490;
	j635631160 [label="나도 그걸 직접 하고 싶은 마음은 굴뚝같다만, 하지 않는 게 아니라 할 수가 없는 것이다! 알브레히트가 찔러넣은 이 빌어먹을 프로토프레임 혈청이 저 망할 기계를 스스로 작동시킬 능력을 내게서 앗아 갔어!",shape=box,color=blue];
		j635631160 -> j3726577706;
	j575430209 [label="분명히 말하건대, \"그것\"이 타당하다.",shape=box,color=blue];
		j575430209 -> j2728636425;
	j2655447537 [label="Add 1 to Thermostat counter",color=orange];
		j2655447537 -> j737806709;
	j317770250 [label="Add -1 to Thermostat counter",color=orange];
		j317770250 -> j827311393;
	j1484100229 [label="그리고 그래, 나는 헬민스를 통해 이곳으로 온 것이 맞다. 참고로 내가 직접 제작하고 키워낸 것이었지. 자, 하려던 얘기가... 네놈이 내 기억을 지웠다는 이야기던가?! 무슨 기억, 우리가 여태껏 나눈 대화의 기억을 말이냐?! ",shape=box,color=blue];
		j1484100229 -> j1027982078;
	j3390686490 [label="또한 내 기억이 돌아올 때마다 그걸 기록하고 정리하는 데 도움을 줄 누군가도 필요하다. 말하자면 임시 비서 같은 셈이지.",shape=box,color=blue];
		j3390686490 -> j3707741652;
	j3726577706 [label="그리고 한 술 더 떠, 내 기억을 되찾는 데 네 도움이 필요할 뿐만 아니라 - 상처에 소금을 뿌리기라도 하는 것처럼, 그 기억의 진실을 내 스스로 알아볼 방법 또한 찾을 수가 없지 않느냐!",shape=box,color=blue];
		j3726577706 -> j1876522358;
		j3726577706 -> j2264994874;
	j2728636425 [label="그리고 나도 그걸 직접 하고 싶은 마음은 굴뚝같다만, 하지 않는 게 아니라 할 수가 없는 것이다! 알브레히트가 찔러넣은 이 빌어먹을 프로토프레임 혈청이 저 망할 기계를 스스로 작동시킬 능력을 내게서 앗아 갔어!",shape=box,color=blue];
