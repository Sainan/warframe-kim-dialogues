		j209874787 -> j2586940854;
	j270053089 [label="몰라. 그리고 사실 너한테 폭언 들으러 여기 온 것도 아니고, 로스. 너한테서 이런 비난 듣자고 모두의 시간을 되돌린 게 아니야.",shape=box,color=red];
		j270053089 -> j1898680521;
	j2887687373 [label="내가 최대한 추측해 보자면? 우리 대화에 대한 기억은 그렇게 깊게 뿌리내린 게 아닐 거야. 표면 기억일 뿐이지. 하지만 네 과거에 대해 알아낸 건... 좀 더 네 핵심 기억에 가까운 거라서 그런 게 아닐까?",shape=box,color=red];
		j2887687373 -> j3741160508;
