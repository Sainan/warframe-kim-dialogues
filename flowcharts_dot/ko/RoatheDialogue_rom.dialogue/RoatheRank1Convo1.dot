		j3998890108 -> j3027499205 [label="x < 6",color=purple];
		j3998890108 -> j3027499205 [label="false",color=purple];
	j3419968114 [label="너의 그 뻔뻔함에 찬사를 금할 수가 없군! 정말로, 변장한 오로킨 따위가 아닌 것이 확실하느냐? 혹 다른 이들에게 들키지 않으려고 그 푸른 피부를 숨기고 있을 뿐이 아니더냐?!",shape=box,color=blue];
		j3419968114 -> j1221590554;
		j3419968114 -> j3351313690;
		j3419968114 -> j2069155901;
	j2229582870 [label="Boolean RoatheResetEdgeCase is now true.",color=orange];
		j2229582870 -> j3027499205;
	j3027499205 [label="보이드로부터 태어난 이상 존재, \"드리프터\"라. 바로 그 찬탈자인가. 드디어, 이야기를 해 보게 되는군. 오라. 이 악마가 제안할 거래가 있으니...",shape=box,color=blue];
		j3027499205 -> j1129534128;
