		j3351313690 -> j802468215;
	j2069155901 [label="지금 뭐라고?",shape=box,color=red];
		j2069155901 -> j802468215;
	j1129534128 [label="찬탈자라고?",shape=box,color=red];
		j1129534128 -> j2869459505;
	j2764929579 [label="무슨... 거래인데?",shape=box,color=red];
		j2764929579 -> j1456402948;
	j2860582612 [label="\"타우의 악마\"가 내게 할 만한 제안이라는 게 뭐가 있지?",shape=box,color=red];
		j2860582612 -> j2598047504;
	j3584827276 [label="안녕, 로스.",shape=box,color=red];
		j3584827276 -> j4078429900;
	j91912186 [label="아, 그래, 좋군! 사실은 내 이름을 알고 있었다 이거지! 몇 번이고 몇 번이고 날 쳐죽이느라 바쁘신 몸이었으니, 분명 한 귀로 흘리고 잊어버렸을 거라고 생각했다!",shape=box,color=blue];
		j91912186 -> j1890642234;
	j802468215 [label="더 생산적으로 할 만한 일이 그렇게도 없나?! 아니면 네가 시간을 효율적으로 쓸 방법이라곤 이 몇 번이고 돌고 도는 \"야즈낙 꼬리잡기\" 놀음을 하고 노는 것 뿐이란 건가?!",shape=box,color=blue];
		j802468215 -> j1890642234;
	j2869459505 [label="Boolean RoatheUsurper is now true.",color=orange];
		j2869459505 -> j1425926179;
	j1456402948 [label="으흠, 걱정할 필요 없다... 기대할 필요 또한 마찬가지지. 아직까지는. 그저 장차 서로에게 크게 이익이 되고자 하는 두 개인 사이의 안건 협약일 뿐이니.",shape=box,color=blue];
		j1456402948 -> j4078429900;
	j2598047504 [label="+5 Chemistry",color=orange];
		j2598047504 -> j82923468;
	j4078429900 [label="자, 이제 잘 듣거라. 저 두 광신도 놈들은 끔찍하도록 공을 들여 가며 나를 몇 번이고 꾸짖어 이 지루함을 더하고 있다. 너라면 이런 설교 행위 따위에 굴하지 않을 수 있겠지.",shape=box,color=blue];
		j4078429900 -> j1997555341;
		j4078429900 -> j2720394242;
	j1890642234 [label="참 믿을 수가 없군 - 네놈이 내게 가한 이 모든 불의, 내 영혼을 한 겹 한 겹 벗겨내는 이 행위가 순전히 네놈의 명령에서 온 악의가 아니라는 것이!",shape=box,color=blue];
		j1890642234 -> j2910592034;
		j1890642234 -> j3272522204;
		j1890642234 -> j3029348516;
	j1425926179 [label="+5 Chemistry",color=orange];
		j1425926179 -> j2457634668;
	j82923468 [label="진작부터 내 명성을 듣고 있었나 보군. 좋다. 그렇다면 이야기가 빨라지겠지.",shape=box,color=blue];
		j82923468 -> j2310236734;
	j1997555341 [label="네 명령을 들을 생각은 없는데.",shape=box,color=red];
		j1997555341 -> j4026548805;
	j2720394242 [label="할 수 있는 한 해 볼게.",shape=box,color=red];
		j2720394242 -> j1102035201;
	j2910592034 [label="당장 급한 일이 아닌 것 같아 보여서?",shape=box,color=red];
		j2910592034 -> j1057109103;
	j3272522204 [label="그냥... 그냥 진작 얘기를 해 볼 기회가 없었을 뿐이야.",shape=box,color=red];
		j3272522204 -> j784869560;
	j3029348516 [label="넌 기억을 못 하는 것 뿐이겠지만... 전에도 우리 이런 적 있어.",shape=box,color=red];
		j3029348516 -> j1892246300;
	j2457634668 [label="아! 반역자라 함은 바로 너희들이 아니더냐? 오로킨으로부터 근원계를 찬탈한 텐노들 말이다. 그리고 너 또한, 둥지에 숨어들어온 뻐꾸기 새끼처럼, 네 세상에서 이 쪽 세상으로 몰래 숨어들어와 있지.",shape=box,color=blue];
		j2457634668 -> j542267014;
	j2310236734 [label="그리고 걱정할 필요도, 기대할 필요도 없다... 아직까지는. 그저 장차 서로에게 크게 이익이 되고자 하는 두 개인 사이의 안건 협약일 뿐이니.",shape=box,color=blue];
		j2310236734 -> j4078429900;
	j4026548805 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4026548805 -> j629627867 [label="x >= 21",color=purple];
