	75 [label="왜냐면 네놈이 그 피비린내 나는 즐거움을 누리자고 나를 다진 고기로 잘게 저며주던 그 \"정겨운\" 기억만큼은 분명히 있으니 말이다. 도대체 그게 무슨 의미가 있는 행위더란 말이냐?",shape=box,color=blue];
		75 -> 79;
		75 -> 80;
	72 [label="그리고 그 대가로 - 나는 여기에 아무 짓 없이 가만히... 평온히 앉아 있을 것을 엄숙히 맹세하겠다. 누구에게도 위협을 가하지 않겠다고. 다시 한 번 확실히 하겠다만, 나는 위협이 되는 데 능한 자다. 저 광신도들에게도 해를 끼치 않도록 하지. 집사에게도. 혹은 저 알브레히트의 보이드 오염 동물들에게도.",shape=box,color=blue];
		72 -> 76;
	77 [label="나란 놈은 참으로 운도 좋지.",shape=box,color=blue];
		77 -> 84;
	78 [label="지금 이 순간, 내가 하고 있는 걸 세간에선 \"두 명의 바보 같은 광신자 두 명과 지하 묘소에서 썩어가며 전쟁에 상처받은 어린것들에게 잡동사니를 나눠주는 짓\"이라 하는 모양이더군.",shape=box,color=blue];
		78 -> 85;
	79 [label="몰라. 그리고 사실 너한테 폭언 들으러 여기 온 것도 아니고, 로스. 너한테서 이런 비난 듣자고 모두의 시간을 되돌린 게 아니야.",shape=box,color=red];
		79 -> 5634;
	80 [label="내가 최대한 추측해 보자면? 우리 대화에 대한 기억은 그렇게 깊게 뿌리내린 게 아닐 거야. 표면 기억일 뿐이지. 하지만 네 과거에 대해 알아낸 건... 좀 더 네 핵심 기억에 가까운 거라서 그런 게 아닐까?",shape=box,color=red];
		80 -> 86;
	76 [label="그리고 더 중요한 것으로, 저 위에서 우리의 존재마저도 눈치채지 못하고 돌연변이 식물처럼 가만히 앉아 있는 저 알브레히트의 뒤틀린 가족들에게도 아무 해를 끼치지 않도록 하지.",shape=box,color=blue];
		76 -> 81;
		76 -> 82;
		76 -> 83;
	84 [label="나는 내 할 일을 하려 한다, 드리프터. 그러나 사실은 그대로 남아 있지 - 내 과거를, 내가 무슨 짓을 했는지를 너는 너무 많이 알고 있어. 그리고 우린... 그저 이 상태로 존재할 수밖에 없는 것이겠지.",shape=box,color=blue];
		84 -> 90;
	85 [label="허나 지금 시점에선 그렇게 부를 수밖에 없는 노릇이겠지.",shape=box,color=blue];
		85 -> 84;
	5634 [label="그래, 네녀석이 그 보이드 능력을 소환해 우리 머릿속에서 최근 있었던 일들을 지워버린 이유를 감히 추측할 수도 있을 것 같군. 참으로 완벽하게 뻔하기 그지없어.",shape=box,color=blue];
		5634 -> 91;
	86 [label="환상적이로군. 아주 놀라울 지경이야. 이젠 내 기억을 자기 멋대로 지울 능력이 된다고 생각하는 미치광이의 손아귀에 떨어지다니! 아주 귀엽기 그지없어.",shape=box,color=blue];
		86 -> 91;
	81 [label="거래를 하자는 건줄 알았는데. 지금 하는 건 날 협박하는 거 아냐?",shape=box,color=red];
