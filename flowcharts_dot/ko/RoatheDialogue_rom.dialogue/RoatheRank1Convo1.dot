	j1027982078 [label="왜냐면 네놈이 그 피비린내 나는 즐거움을 누리자고 나를 다진 고기로 잘게 저며주던 그 \"정겨운\" 기억만큼은 분명히 있으니 말이다. 도대체 그게 무슨 의미가 있는 행위더란 말이냐?",shape=box,color=blue];
		j1027982078 -> j270053089;
		j1027982078 -> j2887687373;
	j3707741652 [label="그리고 그 대가로 - 나는 여기에 아무 짓 없이 가만히... 평온히 앉아 있을 것을 엄숙히 맹세하겠다. 누구에게도 위협을 가하지 않겠다고. 다시 한 번 확실히 하겠다만, 나는 위협이 되는 데 능한 자다. 저 광신도들에게도 해를 끼치 않도록 하지. 집사에게도. 혹은 저 알브레히트의 보이드 오염 동물들에게도.",shape=box,color=blue];
		j3707741652 -> j286078121;
