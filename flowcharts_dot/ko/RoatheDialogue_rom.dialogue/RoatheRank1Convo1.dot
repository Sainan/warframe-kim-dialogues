		64 -> 70;
	65 [label="이 이야기 전체에 대해 걱정스러울 정도로 확실한 게 없군, 드리프터. 특히 내 두개골 속 내용물에 대해선 더더욱 말이야.",shape=box,color=blue];
		65 -> 71;
	59 [label="오, 긴 소파 같은 데 드러누워 내 \"감정\" 이야기를 늘어놓으면 다 될 것만 같이 말하는 건 그만두거라.",shape=box,color=blue];
		59 -> 60;
	60 [label="나는 그저 내 대신 저 기계를 작동시켜 줄 누군가가 필요한 것 뿐이다. 지금은 내 손으로 할 수 없는 일이니 말이야. ",shape=box,color=blue];
		60 -> 66;
	61 [label="나도 그걸 직접 하고 싶은 마음은 굴뚝같다만, 하지 않는 게 아니라 할 수가 없는 것이다! 알브레히트가 찔러넣은 이 빌어먹을 프로토프레임 혈청이 저 망할 기계를 스스로 작동시킬 능력을 내게서 앗아 갔어!",shape=box,color=blue];
		61 -> 67;
	62 [label="분명히 말하건대, \"그것\"이 타당하다.",shape=box,color=blue];
		62 -> 68;
	69 [label="Add 1 to Thermostat",color=orange];
		69 -> 73;
	70 [label="Add -1 to Thermostat",color=orange];
		70 -> 74;
	71 [label="그리고 그래, 나는 헬민스를 통해 이곳으로 온 것이 맞다. 참고로 내가 직접 제작하고 키워낸 것이었지. 자, 하려던 얘기가... 네놈이 내 기억을 지웠다는 이야기던가?! 무슨 기억, 우리가 여태껏 나눈 대화의 기억을 말이냐?! ",shape=box,color=blue];
		71 -> 75;
	66 [label="또한 내 기억이 돌아올 때마다 그걸 기록하고 정리하는 데 도움을 줄 누군가도 필요하다. 말하자면 임시 비서 같은 셈이지.",shape=box,color=blue];
		66 -> 72;
	67 [label="그리고 한 술 더 떠, 내 기억을 되찾는 데 네 도움이 필요할 뿐만 아니라 - 상처에 소금을 뿌리기라도 하는 것처럼, 그 기억의 진실을 내 스스로 알아볼 방법 또한 찾을 수가 없지 않느냐!",shape=box,color=blue];
		67 -> 53;
		67 -> 54;
	68 [label="그리고 나도 그걸 직접 하고 싶은 마음은 굴뚝같다만, 하지 않는 게 아니라 할 수가 없는 것이다! 알브레히트가 찔러넣은 이 빌어먹을 프로토프레임 혈청이 저 망할 기계를 스스로 작동시킬 능력을 내게서 앗아 갔어!",shape=box,color=blue];
		68 -> 67;
	73 [label="환상적이로군. 자기반성과 회개를 해야 한다며 내 귀에 시끄럽게 윙윙거리는 날벌레가 또 하나 늘다니.",shape=box,color=blue];
