	j2650707412 [label="나는 내 할 일을 하려 한다, 드리프터. 그러나 사실은 그대로 남아 있지 - 내 과거를, 내가 무슨 짓을 했는지를 너는 너무 많이 알고 있어. 그리고 우린... 그저 이 상태로 존재할 수밖에 없는 것이겠지.",shape=box,color=blue];
