	j2715336264 [label="음성 메시지: 창조력",shape=box,color=blue];
		j2715336264 -> j930746093;
	j930746093 [label="구술 기록: 이제와 생각하니, 군사 아르키메디아의 개발이 처음 이루어질 당시엔, 본래 여흥으로 여겨졌던 것이 기억난다. ",shape=box,color=blue];
		j930746093 -> j959150456;
	j959150456 [label="마치 투기장 형태의 서커스에서 범죄자들이 처형되는 모습을 지켜보는 방탕한 탕아들처럼.",shape=box,color=blue];
		j959150456 -> j4157372397;
	j4157372397 [label="우리는 자신보다 훨씬 열등한 적을 처단할 새롭고 자극적인 방법을 고안해냈다며 우쭐해져 있을 뿐이었다.",shape=box,color=blue];
		j4157372397 -> j2083587709;
	j2083587709 [label="얼마나 우스운 자만이었는가. 실제로 우리는 변화무쌍한 적들에게 더 이상 당해내지 못한다는 것을 깨닫고, 필사적으로 혁신에 매달렸다.",shape=box,color=blue];
		j2083587709 -> j199178006;
	j199178006 [label="그들은 떼를 지은 새끼들이 불어터진 어미의 육신을 뜯어먹듯 우리를 찢어발겨왔다.",shape=box,color=blue];
		j199178006 -> j1585038129;
	j1585038129 [label="시간의 페이지 사이에 짓눌려 생기를 잃고 말라붙어버린 우리는, 그저 진화의 경쟁에서 도태될 수밖에 없었던 것이다.",shape=box,color=blue];
		j1585038129 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}