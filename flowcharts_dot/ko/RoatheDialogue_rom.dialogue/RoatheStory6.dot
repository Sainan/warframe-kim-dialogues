	j1898630093 [label="음성 메시지: 지각력",shape=box,color=blue];
		j1898630093 -> j1194858683;
	j1194858683 [label="구술 기록: 우리는 센티언트들을 \"독립체\"라기보단 \"하나의 존재\"로 여겼다. ",shape=box,color=blue];
		j1194858683 -> j2534403888;
	j2534403888 [label="우리가 맞서는 군단들에게, 개별적 생명에 대한 고려라곤 고작 피 속 혈구세포들 정도의 수준밖에 없었기에.",shape=box,color=blue];
		j2534403888 -> j1913343301;
	j1913343301 [label="그들은 점점 더 뻗어나가는, 악의적 덩어리와 같은 육신을 이루는 세포였던 것이다.",shape=box,color=blue];
		j1913343301 -> j3058951677;
	j3058951677 [label="내 생각컨대, 당시 우리는 이것과 꽤 차이가 있는 방식의 군체 의식 - 즉, 감염체를 상대했던 과거 경험에 너무 길들여져 있었다.",shape=box,color=blue];
		j3058951677 -> j1073754434;
	j1073754434 [label="센티언트들에게는 '진화하라'는 사명이 주어져 있었고, 그 진화의 종착점에 존재하는 유일한 모델이란 바로 우리였다.",shape=box,color=blue];
		j1073754434 -> j1506127847;
	j1506127847 [label="그들이 근원계로 돌아오는 이유는 오로킨을 말살하기 위해서만이 아니라, 오로킨의 자리를 대체하고 궁극적으로는... 완벽한 존재로 거듭나기 위해서였던 것이다.",shape=box,color=blue];
		j1506127847 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}