	"Chat ends." [color=orange];
	j2017095957 [label="VM: 깃발",shape=box,color=blue];
		j2017095957 -> j1979600030;
	j1979600030 [label="구술 기록: 우리와 같은 자들이 전쟁의 참상을 얼마나 허례허식으로 다루는지 명료하게 설명하기엔 기수병만한 것이 없다.",shape=box,color=blue];
		j1979600030 -> j2429470174;
	j2429470174 [label="무슨 대가를 치러서라도 반드시 지켜야 하며, 또한 의문 없이 따라야 하는 자들.",shape=box,color=blue];
		j2429470174 -> j1708233772;
	j1708233772 [label="그리고 거기에 더하자면, 제정신인 병사라면 결코 완수하지 못할 명령을 하달받고, 이를 따르지 않으면 그보다도 어떻게든 더 끔찍한 운명을 맞으리라 위협받는 경우도 있었지. ",shape=box,color=blue];
		j1708233772 -> j3270312060;
	j3270312060 [label="우습기로는 우스우나,",shape=box,color=blue];
		j3270312060 -> j3997812726;
	j3997812726 [label="다른 이들 가운데서도 그들의 모습만큼 내 눈을 끄는 자들은 없었다. 뭉개진 시신이 되고 난다면야 다른 이들과 다를 바가 없어졌지만. ",shape=box,color=blue];
		j3997812726 -> j279824391;
	j279824391 [label="그건 그들이 여전히 붙들고 있던 깃발 때문이었다. 오로킨의 금빛으로 번쩍이면서도, 점점이 흩어진 핏빛이 스며든 모습. ",shape=box,color=blue];
		j279824391 -> j604679674;
	j604679674 [label="나는 전장을 떠날 때마다 언제나 그 깃발이 전장의 땅에 당당히 꽂혀 있도록 했다.",shape=box,color=blue];
		j604679674 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}