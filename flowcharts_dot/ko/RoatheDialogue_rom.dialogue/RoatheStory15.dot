	j3983756015 [label="음성 메시지: 거짓말",shape=box,color=blue];
		j3983756015 -> j1205749191;
	j1205749191 [label="구술 기록: 나는 우리가 다루는 무기 가운데 많은 수에 쉽사리 통달했지만, 그 중에서도 특히 하나에 특출났다. 바로, 거짓말.",shape=box,color=blue];
		j1205749191 -> j820363231;
	j820363231 [label="나는 이 무기를 특히 나 자신의 군대에게 가장 자주 휘둘렀다. 나는 의무와 규율이라는 거짓말로 뼛속까지 그들을 채찍질했다.",shape=box,color=blue];
		j820363231 -> j1891308074;
	j1891308074 [label="이 전쟁에서 이길 수 있다는 거짓말로 그들을 덮어 누르고, 나의 호의, 내가 보여줄 수 있는 가장 큰 존중이라는 거짓말로 그들을 꿰뚫었다.",shape=box,color=blue];
		j1891308074 -> j1625357491;
	j1625357491 [label="그리고 혼자만의 사적인 시간엔, 그 무기를 나 자신에게 돌렸다. 오, 내 얼마나 많은 피를 흘렸는지.",shape=box,color=blue];
		j1625357491 -> j1648694156;
	j1648694156 [label="Add 1 to HellStory counter",color=orange];
		j1648694156 -> "Chat ends. Next chat will be RoatheStory16.";
	"Chat ends. Next chat will be RoatheStory16." [color=orange];
