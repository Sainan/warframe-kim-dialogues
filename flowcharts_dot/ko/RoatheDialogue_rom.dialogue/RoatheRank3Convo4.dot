		j2476974658 -> j2723038259 [label=true,color=green];
		j2476974658 -> j3384398711 [label=false,color=brown];
	j2723038259 [label="그러면서도 너도 나름 하고 싶은 일이 있는 것 같아서 말이다. 그런 점을 칭찬하는 거고, 절대 비난하는 게 아니다. 다만, 평소에 그렇게 별나고 괴짜 같은 네가... 다른 면에서는 그렇게 순종적이라는 게 이상하게 느껴져서 말이다. ",shape=box,color=blue];
		j2723038259 -> j3389932156;
		j2723038259 -> j685763704;
		j2723038259 -> j3962440449;
	j3384398711 [label="평소에 그렇게 별나고 괴짜 같은 네가... 다른 면에서는 그렇게 순종적이라는 게 이상하게 느껴져서 말이다. ",shape=box,color=blue];
		j3384398711 -> j3389932156;
		j3384398711 -> j685763704;
		j3384398711 -> j3962440449;
	j3389932156 [label="무심이 근원계 - 혹은 그 어떤 곳이든 - 파괴하도록 내버려 두는 건 그 어느 누구에게도 도움이 안 되니까.",shape=box,color=red];
		j3389932156 -> j1086605522;
	j685763704 [label="알브레히트를 순종적으로 따르는 건 아니야.",shape=box,color=red];
		j685763704 -> j3572344836;
	j3962440449 [label="나에게는 나만의 이유가 있어. 그리고 그걸 밝힐 이유도 없지.",shape=box,color=red];
		j3962440449 -> j4125752382;
	j1086605522 [label="아, 그렇군. \"무심\" 문제가 해결될 때까지 임시로 서비스를 제공하는 거군. 그럼 그 문제가 해결되면 어떻게 할 계획인가?",shape=box,color=blue];
		j1086605522 -> j3559795919;
		j1086605522 -> j253612143;
		j1086605522 -> j3242150116;
		j1086605522 -> j451034954;
		j1086605522 -> j2385655742;
	j3572344836 [label="정말이냐? 내가 보기엔 순종적인 것 같다만. 그 인간이 손가락을 튕기면 넌 훈련된 쿠브로마냥 그의 발목에 바짝 붙어 앉게 되겠지. 심지어 그 인간이 \"타우\"라는 이름을 속삭이자 잃어버린 장소에 대한 모든 기억을 떠올리려고 허둥거리고 있지 않나.",shape=box,color=blue];
		j3572344836 -> j2216160497;
		j3572344836 -> j2026554450;
	j4125752382 [label="너무나 수수께기고, 너무나 알 수 없는 이유다! 게다가 완전 허튼 소리지 않나. 그 인간의 명령에 복종한다는 사실을 인정하고 싶지 않다면, 그리 해라.",shape=box,color=blue];
		j4125752382 -> j3602962529;
	j3559795919 [label="왜 자꾸 이런 걸 따지는 거야? 나한테 진짜 묻고 싶은 게 뭔데?",shape=box,color=red];
		j3559795919 -> j1263441097;
	j253612143 [label="솔직히 말해서, 아직 그렇게 멀리까진 생각 안 해본 것 같아.",shape=box,color=red];
		j253612143 -> j2091862032;
	j3242150116 [label="이런 난장판을 만든 대가를 치르게 할 거야. 그 인간은 속죄해야 할 점들이 아주 많으니까. ",shape=box,color=red];
		j3242150116 -> j2741504748;
	j451034954 [label="내가 살아남는다는 가정하에 말하는 거지?",shape=box,color=red];
		j451034954 -> j4977497;
	j2385655742 [label="늘 그랬듯, 날 필요로 하는 곳으로 갈 거야. 문제는 대개 날 찾아오니까.",shape=box,color=red];
		j2385655742 -> j326538833;
	j2216160497 [label="왜 그리 애써서 날 화나게 만들려고 하는 거야?",shape=box,color=red];
		j2216160497 -> j1631185994;
	j2026554450 [label="그저 사람들이 처한 비참한 상황에서 벗어날 수 있도록 돕기 위해서 내가 해야 할 일을 하고 있을 뿐이야.",shape=box,color=red];
		j2026554450 -> j1158096429;
	j3602962529 [label="내가 보기엔 그 인간이 손가락을 튕기면 넌 훈련된 쿠브로마냥 그의 발목에 바짝 붙어 앉는 것 같단 말이다. 심지어 그 인간이 \"타우\"라는 이름을 속삭이자 잃어버린 장소에 대한 모든 기억을 떠올리려고 허둥거리고 있지 않나.",shape=box,color=blue];
		j3602962529 -> j2216160497;
		j3602962529 -> j2026554450;
	j1263441097 [label="+5 Chemistry",color=orange];
		j1263441097 -> j2492602141;
	j2091862032 [label="Ah! So you admit you are an idiot! How refreshing. I adore when fools place their lack of wit right out in the open, it makes my task of manipulating them all the easier.",shape=box,color=blue];
		j2091862032 -> j317747760;
	j2741504748 [label="Ah! So it is base, primal revenge you are after! Glorious. A rabid animal, ready to gnaw at the bones of those who have wronged you.",shape=box,color=blue];
		j2741504748 -> j3516561474;
	j4977497 [label="+5 Chemistry",color=orange];
		j4977497 -> j3162817704;
	j326538833 [label="Ah, I see. Listlessness masked with nobility. You do not know where you belong, where you should stay, so you cloak yourself in this veneer of \"righteousness sacrifice\" and do the bidding of others?",shape=box,color=blue];
		j326538833 -> j704188706;
	j1631185994 [label="내가 도저히 이해할 수 없는 것은, 내가 알기로 완전히 다른 차원의 현실에서 온 존재인 네가 왜 시공간을 넘나들며 \"치료 전문가 행세\"를 하냐 이 말이다.",shape=box,color=blue];
		j1631185994 -> j1480610041;
	j1158096429 [label="그래, 그게 바로 핵심이다! 왜 굳이 시공간을 떠돌아다니며 \"치료 전문가 행세\"를 하는 거냐? 내가 알기론, 넌 완전히 다른 차원의 현실에서 온 존재이고, ",shape=box,color=blue];
		j1158096429 -> j1480610041;
	j2492602141 [label="Astute. Yes, very well, I will get to the heart of what I am asking more directly. I was attempting to goad you into anger to see if it would prompt a more honest response.",shape=box,color=blue];
		j2492602141 -> j3632462187;
	j317747760 [label="You are like a kubrow who has finally caught a kaithe. You do not know what to do now you have your teeth in its leg.",shape=box,color=blue];
		j317747760 -> j2026554450;
		j317747760 -> j2216160497;
	j3516561474 [label="One of the simplest and oldest of all human motivations. And, therefore, one of the easiest to understand.",shape=box,color=blue];
		j3516561474 -> j2026554450;
	j3162817704 [label="Never officially a soldier, yet in your tone I hear the weariness of the most battle-hardened of them all.",shape=box,color=blue];
		j3162817704 -> j4083512599;
	j704188706 [label="How utterly tragic.",shape=box,color=blue];
		j704188706 -> j2633062991;
		j704188706 -> j1084660117;
	j1480610041 [label="나라면 두비리로 돌아가서 보이드의 구조를 뚫을 수 있는 다른 구멍들을 찾아내려고 애쓸 거다! 상상해 봐라! 얼마나 많은 가능성이 열려 있을지! 내 손안에 있는 세상들을 말이다!",shape=box,color=blue];
		j1480610041 -> j2925256586;
		j1480610041 -> j2511773907;
	j3632462187 [label="But I suppose this will have to do.",shape=box,color=blue];
		j3632462187 -> j65736806;
	j4083512599 [label="Very well. From one to another, out of respect, I will get to the heart of what I am asking more directly. I was attempting to goad you into anger to see if it would prompt a more honest response.",shape=box,color=blue];
		j4083512599 -> j65736806;
	j2633062991 [label="I have a place where I belong.",shape=box,color=red];
		j2633062991 -> j375984319;
	j1084660117 [label="You don't know what you're talking about.",shape=box,color=red];
		j1084660117 -> j1310123581;
	j2925256586 [label="당신도 알브레히트와 다를 게 없어. 그 인간도 시간을 넘나들면서 온갖 사고란 사고는 다 치고 다니잖아. 그런데 당신은 차원 전체에 그런 짓을 하려고 해?!",shape=box,color=red];
		j2925256586 -> j144098750;
	j2511773907 [label="그게 바로 당신네들 오로킨의 문제점이라고. 당신은 온 세상을 자기 마음대로 할 수 있을 거라고 생각하잖아. ",shape=box,color=red];
		j2511773907 -> j2373542450;
	j65736806 [label="+5 Chemistry",color=orange];
		j65736806 -> j4243150815;
	j375984319 [label="Do tell! Is it this Höllvania? Or perhaps Duviri? Or perhaps your crashed Orbiter on what remains of Earth?",shape=box,color=blue];
		j375984319 -> j2026554450;
		j375984319 -> j2216160497;
	j1310123581 [label="Then tell me all about where your home is! Is it this Höllvania? Or perhaps Duviri? Or perhaps your crashed Orbiter on what remains of Earth?",shape=box,color=blue];
		j1310123581 -> j2026554450;
		j1310123581 -> j2216160497;
	j144098750 [label="왜 우린 그러면 안 되는 거지? 우리는 우월한 창조물이잖나, 안 그런가? 알브레히트는 자기가 하고 싶은 대로 하고, 넌 아무렇지도 않게 그 자가 저지른 일들을 수습하지 않나! 난 그리하면 안 되는 건가? 알브레히트의 행동은 정당화하고 왜 내 행동은 정당하지 않은 거냐?",shape=box,color=blue];
		j144098750 -> j1525764059;
	j2373542450 [label="왜 우린 그러면 안 되는 거지? 우리는 우월한 창조물이잖나, 안 그런가? 알브레히트는 마음대로 행동하며 시간을 휩쓸고 다니고, 제대로 이해하지도 못하는 감염체로 많은 이들을 감염시키고 있다. 이 모든 게 \"소위 신을 물리친다\"는 명분으로 말이다.",shape=box,color=blue];
		j2373542450 -> j1525764059;
