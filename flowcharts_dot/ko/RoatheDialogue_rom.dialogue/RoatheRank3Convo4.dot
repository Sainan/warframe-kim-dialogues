	j4166698875 [label="목록을 줄줄이 나열할 수도 있지만, 그러면 오후 내내 여기 앉아 있어야 할 것 같으니까. 아니, 내가 오늘 물어보고 싶은 건 딱 한 가지 주제다. 적어도. 오늘은 말이다.",shape=box,color=blue];
