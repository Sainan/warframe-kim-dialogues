	"Chat ends." [color=orange];
	j2572694064 [label="음성 메시지: 적응",shape=box,color=blue];
		j2572694064 -> j2101041811;
	j2101041811 [label="구술 기록: 많은 센티언트들이 전투를 거듭해 가며 진화했기에, 같은 적을 두 번 만나리라고는 결코 보장할 수 없는 상황이었다. 하지만 또 다른 일부는 마치 오래전 어떤 정점에 도달한 듯, 일관된 형태를 유지하고 있었다.",shape=box,color=blue];
		j2101041811 -> j2405643660;
	j2405643660 [label="완벽한 살육자가 된 그들은 상어가 그리하듯, 매번 같은 차가운 공포를 우리에게 선사했다.",shape=box,color=blue];
		j2405643660 -> j4196548377;
	j4196548377 [label="미쳐 돌아가는 노릇이었다. 센티언트의 게형 함선에 대한 전략을 완벽히 수립한 지 얼마 되지도 않아 그 게형 함선이 지렁이형 함선으로 바뀐다면, 어떻게 게형 함선의 행동 패턴을 전략화하란 말인가?",shape=box,color=blue];
		j4196548377 -> j1698962013;
	j1698962013 [label="그리고 그 지렁이형 함선 자체 또한 또 다른 괴물로 대체되기까지는 또 얼마나 걸리겠는가?",shape=box,color=blue];
		j1698962013 -> j3936431973;
	j3936431973 [label="우리가 할 수 있었던 것은 거꾸로 돌아가는 것뿐이었다. 진보는 지금껏 치명적이었을 뿐. 오래된 전통, 고대로부터 내려온 명예와 규율들에, 우리는 이제 마땅히 존중과 경의를 표해야만 했다.",shape=box,color=blue];
		j3936431973 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}