	2191 [label="Transcript: Among the Seven I was - so I was told - considered Nitokh’s plaything and concubine.",shape=box,color=blue];
		2191 -> 5688;
	5688 [label="In the early days of the War they appointed me Vice Regent Grand Carnus at her goading, thinking it a jest.",shape=box,color=blue];
		5688 -> 5689;
	5689 [label="How quickly their laughter turned to solemn applause as I brought home the news of one victory after another.",shape=box,color=blue];
		5689 -> 2187;
	2187 [label="The blood of better men dappled me like medals. In secret I amassed weapons for Nitokh.",shape=box,color=blue];
		2187 -> 2188;
	2188 [label="It was easily done. I was too glorious a figure to be suspected",shape=box,color=blue];
		2188 -> 2186;
