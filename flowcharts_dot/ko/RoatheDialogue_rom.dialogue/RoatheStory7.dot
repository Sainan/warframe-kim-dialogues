		j1678501823 -> j3954252218;
	j3954252218 [label="구술 기록: 7인 의회 사이에서 나는 - 그렇다고 들었다 - 니토크의 장난감이자 첩실로 여겨지고 있었다.",shape=box,color=blue];
		j3954252218 -> j575956784;
	j575956784 [label="전쟁 초 무렵, 그들은 니토크의 부추김에 농담 삼아 나를 부섭정 대 카르누스에 임명했다.",shape=box,color=blue];
		j575956784 -> j3519568186;
	j3519568186 [label="그 비웃음이 내가 가져오는 연전연승의 소식 앞에 얼마나 빠르게 엄숙한 박수소리로 바뀌어갔는지.",shape=box,color=blue];
		j3519568186 -> j47161466;
	j47161466 [label="나보다 더 나은 자들의 피가 훈장처럼 나를 물들이는 가운데, 비밀리에, 나는 니토크를 위한 무기들을 모았다.",shape=box,color=blue];
		j47161466 -> j1279041143;
	j1279041143 [label="쉬운 일이었다. 나는 의심하기엔 너무나 영광스런 인물이었기에.",shape=box,color=blue];
		j1279041143 -> j921430358;
