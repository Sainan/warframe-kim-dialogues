	j3582039667 [label="그래, 파란 피부, 꼬리, 인페스티드 육신까지 싹 다 갖춘 채로. 망토, 모자, 가면이 얼마나 큰 힘을 발휘하는지 알면 정말 놀랄 거다.",shape=box,color=blue];
