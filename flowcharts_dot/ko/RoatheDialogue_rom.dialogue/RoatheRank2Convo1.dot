		j659470794 -> j3176525515;
	j3645551347 [label="말해봐라, 내 제안에 대한 마음이 바뀌었는지? 이게 네 마지막 기회일 수도 있다, 찬탈자여. 난 인내심 많은 악마지만, 바보처럼 문을 잡아당겨서 안을 바라봤을 때 혼자 남겨지는 건 싫으니까 말이야.",shape=box,color=blue];
