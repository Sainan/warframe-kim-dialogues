		656 -> 679;
	657 [label="흐음. 그렇군. 솔직한 감상을 말하자면, 숭고한 노력이로군. 나도 이미 몇 번이고, 몇 번이고 시도해 본 일이니 말이야. 그리고 똑같은 횟수만큼 실패했지.",shape=box,color=blue];
