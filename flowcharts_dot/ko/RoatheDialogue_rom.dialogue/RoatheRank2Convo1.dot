		j175282275 -> j1878342239;
	j1308155390 [label="네가 우리의 대화에 계속 등장하는 데에는 다 이유가 있다고 생각이 든다만, 찬탈자여. 그리고 어쩌면 내가 도울 수 있는 부분들이 있을지도 모르니까.",shape=box,color=blue];
