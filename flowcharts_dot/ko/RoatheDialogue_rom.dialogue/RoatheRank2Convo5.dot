		j1042938308 -> j2248157709;
	j758952030 [label="니토크가 날 불러 오로킨들을 모두 몰살시키고 싶다고 했을 때? 난 즉시 동의했다. 독사 같은 오로킨들의 머리를 잘라내고 싶었고, 더 온화한 체제, 더 온화한 통치자로 바꾸고 싶었다.",shape=box,color=blue];
		j758952030 -> j2794040720;
