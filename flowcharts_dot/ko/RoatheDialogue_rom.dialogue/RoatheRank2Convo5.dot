		j2321147914 -> j1530859560;
	j4013566118 [label="물론이지, 당연하게도 말이다! 그리고 이 얘기를 들어본 적 없다고 시치미 떼지 말아라. 분명히 들어봤을 거니까. ",shape=box,color=blue];
		j4013566118 -> j2675490432;
