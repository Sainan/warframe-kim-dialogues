	j3632893704 [label="모든 일, 그리고 그 이상까지.",shape=box,color=blue];
		j3632893704 -> j3556384964;
	j991586124 [label="오로킨들 사이에서 배신은 흔한 일이었다. 하지만 제국 전체를 배신한다? 그런 반역은 옥색의 빛 처형은 물론, 세팔론 프로그램의 처형에 마땅한 죄였다.",shape=box,color=blue];
