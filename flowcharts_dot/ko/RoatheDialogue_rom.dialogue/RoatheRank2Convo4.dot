		j4112537106 -> j3665632858;
		j4112537106 -> j3687066978;
	j444389360 [label="보이드엔 아무것도 없다. 그게 바로 보이드가 '공허'라 불리는 이유야! ",shape=box,color=blue];
		j444389360 -> j2779640726;
