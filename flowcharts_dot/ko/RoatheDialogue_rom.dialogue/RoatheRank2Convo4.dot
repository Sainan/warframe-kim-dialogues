	j4078438340 [label="응. 그래서?",shape=box,color=red];
		j4078438340 -> j3735087869;
	j1444435498 [label="정확하다. 보이드가 있는 곳에 개념의 형상화가 따라올 수 있지. 오직 그곳에서만 가능하다.",shape=box,color=blue];
