digraph {
	1095 [label="RoatheRank2Convo4 begins.",color=orange];
		1095 -> 1096;
	1096 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1096 -> 1097 [label=true,color=green];
		1096 -> 1098 [label=false,color=brown];
	1097 [label="Check boolean RoatheKnowsReset2",color=orange];
		1097 -> 1099 [label=true,color=green];
		1097 -> 1100 [label=false,color=brown];
	1098 [label="Chat ends.",color=orange];
	1099 [label="Hm. Tell me. Did I manage to convince you last time we did this that your \"Indifference\" is merely a collection of cobbled-together children's toys, or did you end all this still believing it is some \"great unknowable entity from the Void.\"",shape=box,color=blue];
		1099 -> 1101;
	1100 [label="Check boolean RoatheMITW1",color=orange];
		1100 -> 1102 [label=true,color=green];
		1100 -> 1103 [label=false,color=brown];
	1101 [label="If there's one thing in this world that I despise, it's chasing my tail. And that metaphor used to be far more proverbial than it is now, I just realized.",shape=box,color=blue];
		1101 -> 1104;
		1101 -> 1105;
		1101 -> 1106;
	1102 [label="So, before we continue, I would like to just make sure that I have everything straight. You believe that the Indifference is some Horrible Unknowable Entity from the Void, leaking into our reality because of Albrecht's mistakes?",shape=box,color=blue];
		1102 -> 1107;
	1103 [label="Everyone I speak to around this madhouse is entirely convinced that this \"Man in the Wall\" is some kind of literal and laughable god. An actual god. Even those two zealots seem to be entertaining the idea!",shape=box,color=blue];
		1103 -> 1108;
		1103 -> 1109;
		1103 -> 1110;
	1104 [label="You didn't, no. Sorry. ",shape=box,color=red];
		1104 -> 1111;
	1105 [label="You did, actually.",shape=box,color=red];
		1105 -> 1112;
	1106 [label="We never really quite settled on either side.",shape=box,color=red];
		1106 -> 1113;
	1107 [label="Allow me to phrase my question thusly, before we spin ourselves around and we end up once more chasing our tails. Which... is a metaphor that I just now realize used to be far more proverbial than it is now, but I digress.",shape=box,color=blue];
		1107 -> 1114;
	1108 [label="You don't think he's real?",shape=box,color=red];
		1108 -> 1115;
	1109 [label="And if you don't think he's a god, what do you think he is?",shape=box,color=red];
		1109 -> 1116;
	1110 [label="And you don't?",shape=box,color=red];
		1110 -> 1117;
	1111 [label="Update boolean RoatheMITWSkip",color=orange];
		1111 -> 1118;
	1112 [label="Update boolean RoatheMITWSkip",color=orange];
		1112 -> 1119;
	1113 [label="Ah! Well, then it seems I still have work to do.",shape=box,color=blue];
		1113 -> 1120;
	1114 [label="Do you believe that the entity that you now call the Indifference existed prior to Albrecht's dealings with it? Or do you believe he created it when he first interacted with the Void?",shape=box,color=blue];
		1114 -> 1121;
		1114 -> 1122;
		1114 -> 1123;
		1114 -> 1124;
	1115 [label="Now, did I say those words? Do not be so quick to put words into my mouth, Oh Transient Usurper. I did not deny that the Indifference was \"real.\" I denied that it was a God.",shape=box,color=blue];
		1115 -> 1125;
		1115 -> 1126;
	1116 [label="I can disrobe this false deity for you in two simple words you should know and understand quite well:",shape=box,color=blue];
		1116 -> 1127;
	1117 [label="Absolutely not! First, there are no god or gods, the idea is absurd. Second, to think that Albrecht let loose a god of the Void? Even more laughable!",shape=box,color=blue];
		1117 -> 1128;
	1118 [label="Update boolean RoatheMITW5Real",color=orange];
		1118 -> 1129;
	1119 [label="Update boolean RoatheMITW5Fake",color=orange];
		1119 -> 1130;
	1120 [label="Update boolean RoatheMITW1",color=orange];
		1120 -> 1131;
	1121 [label="I don't know. And I don't think you possibly can, either.",shape=box,color=red];
		1121 -> 1132;
	1122 [label="I think it was an entity that existed before Entrati interacted with it. He just gave it shape and form via Conceptual Embodiment.",shape=box,color=red];
		1122 -> 1133;
	1123 [label="I honestly... don't know.",shape=box,color=red];
		1123 -> 1134;
	1124 [label="You really think that Entrati made a malignant Void god out of whole cloth?",shape=box,color=red];
		1124 -> 1135;
	1125 [label="That thing is more powerful than anything I've ever been up against.",shape=box,color=red];
		1125 -> 1136;
	1126 [label="What do you think he is, then?",shape=box,color=red];
		1126 -> 1116;
	1127 [label="Conceptual Embodiment.",shape=box,color=blue];
		1127 -> 1137;
		1127 -> 1138;
		1127 -> 1139;
	1128 [label="There is nothing in the Void. That is why it is named the Void! ",shape=box,color=blue];
		1128 -> 1140;
		1128 -> 1141;
	1129 [label="+10 Chemistry",color=orange];
		1129 -> 1142;
	1130 [label="+20 Chemistry",color=orange];
		1130 -> 5772;
	1131 [label="But before we continue, I would like to just make sure that I have everything straight. You believe that the Indifference is some Horrible Unknowable Entity from the Void, leaking into our reality because of Albrecht's mistakes?",shape=box,color=blue];
		1131 -> 1107;
	1132 [label="Yes! I can! It is so painfully obvious what is happening, and so utterly laughable that you have all convinced yourself that there is some great beast scraping at the window, when it is but a tree branch in the wind.",shape=box,color=blue];
		1132 -> 1143;
	1133 [label="Not you, too. I had such high hopes. It is so painfully obvious what is happening, and so utterly laughable that you have all convinced yourself that there is some great beast scraping at the window, when it is but a tree branch in the wind.",shape=box,color=blue];
		1133 -> 1143;
	1134 [label="It is so painfully obvious what is happening, and so utterly laughable that you have all convinced yourself that there is some great beast scraping at the window, when it is but a tree branch in the wind.",shape=box,color=blue];
		1134 -> 1143;
	1135 [label="Yes! I do! It is so painfully obvious that is what is happening and so utterly laughable that you have all convinced yourself that there is some great beast scraping at the window, when it is but a tree branch in the wind.",shape=box,color=blue];
		1135 -> 1143;
	1136 [label="And when have I denied that, either? Indeed, it seems you have all managed to spin yourselves into quite a hysterical and needlessly egregious bit of tribulation.",shape=box,color=blue];
		1136 -> 1144;
		1136 -> 1145;
	1137 [label="The Void and what we can make of it is dangerous and powerful - trust me, I know. But it has limits. You really think it's capable of manifesting something like that? That can create whole languages, fingers that can power ships that jump through the Void?",shape=box,color=red];
		1137 -> 1146;
	1138 [label="It's... very tempting to believe that it's just a monster under our bed, Roathe. But I've seen this thing, face to \"face,\" and I don't know how something like that just comes out of our minds.",shape=box,color=red];
		1138 -> 1147;
	1139 [label="Conceptual Embodiment cannot do what the Man in the Wall is capable of doing. While Entrati may have manifested that thing - and is responsible for bringing it here - I don't believe he is the original source of it.",shape=box,color=red];
		1139 -> 1148;
	1140 [label="I... ",shape=box,color=red];
		1140 -> 1149;
	1141 [label="No. I've seen things that come from the Void. Angels. Singing. Ghosts.",shape=box,color=red];
		1141 -> 1149;
	1142 [label="While I am disappointed that you held the line, I find your honesty extremely refreshing. And I am glad to not be wasting my time as we go forward. I am certain we'll find other ways to amuse ourselves.",shape=box,color=blue];
		1142 -> 1150;
	5772 [label="Fantastic. I am glad my former self was so wonderfully convincing. And I am hopeful you are being honest and not lying to me in an attempt to \"shut me up.\" But, I have no choice but to believe you.",shape=box,color=blue];
		5772 -> 5773;
	1143 [label="Only now, due to the influence of the Void, you have all fed it so much fear and power that it has, like a feedback loop, balled itself up into this... Thing. This Man in the Wall.",shape=box,color=blue];
		1143 -> 1151;
	1144 [label="What're you saying?",shape=box,color=red];
		1144 -> 1152;
	1145 [label="Wait. How are we to blame for this? Albrecht is the one to blame, he set it loose.",shape=box,color=red];
		1145 -> 1153;
	1146 [label="Humanity is certainly nothing if not creative in the breadth and magnitude of new forms of suffering it can concoct for itself, is it not? You yourself have been witness to many a form of cruelty I am sure no one could scare imagine was possible in the time of our dear zealots.",shape=box,color=blue];
		1146 -> 1154;
	1147 [label="Ah, you are so close to the truth and yet so quick to dismiss it. You think it is \"tempting\" to believe it is a creation of your own mind as it would be easier to dismiss it if it were so? No, I think it makes it far more dangerous to face a creation of our own making than a god.",shape=box,color=blue];
		1147 -> 1155;
	1148 [label="While I appreciate your humility, I challenge your limited understanding of the capability of human creativity - especially in regards to how it can devise new forms of suffering. Are you not in fact single-handedly responsible for conjuring your own universe from whole cloth?",shape=box,color=blue];
		1148 -> 1156;
	1149 [label="The only thing that comes from the Void is that which we place within it - and what returns from it. It changes matter and energy - but it cannot create it.",shape=box,color=blue];
		1149 -> 1157;
	1150 [label="I, for one, am grateful to be spared a second round of wandering and circular debates on the finer points of Conceptual Embodiment.",shape=box,color=blue];
		1150 -> 1158;
	5773 [label="Either way, I am certain we will find other ways to amuse ourselves than to be lost in wandering and circular debates about the finer points of Conceptual Embodiment.",shape=box,color=blue];
		5773 -> 5774;
	1151 [label="Albrecht may have started this nonsense, but all of you are responsible for stoking the fire until it became an inferno. The Indifference never existed. Until, suddenly, it did. ",shape=box,color=blue];
		1151 -> 1159;
	1152 [label="What I am saying is this: Albrecht might have been the one who originally saw his own hubris staring back at him as the face of a grinning god of destruction, yes.",shape=box,color=blue];
		1152 -> 1160;
	1153 [label="Albrecht might have been the one who originally saw his own hubris staring back at him as the face of a grinning god of destruction, yes.",shape=box,color=blue];
		1153 -> 1160;
	1154 [label="+5 Chemistry",color=orange];
		1154 -> 1161;
	1155 [label="An external foe can be understood. Manipulated. Defeated. Or perhaps even negotiated with, if it comes to that. They have weaknesses that can be exploited. But an internal foe? One of our own making? That is far more insidious indeed.",shape=box,color=blue];
		1155 -> 1162;
	1156 [label="You yourself have been witness to many a form of cruelty I am sure no one could scare imagine was possible in the time of our dear zealots. ",shape=box,color=blue];
		1156 -> 1163;
	1157 [label="Think, Drifter. These \"Void Angels\" of which you speak. These ghosts. Were they made of those already lost to the Void?",shape=box,color=blue];
		1157 -> 1164;
	1158 [label="Though it does mean more time to be preached at by the zealots... bah. Choices, choices, choices...",shape=box,color=blue];
		1158 -> 1165;
	5774 [label="I, for one, am grateful to be spared a second round.",shape=box,color=blue];
		5774 -> 1158;
	1159 [label="And you are all to blame for it.",shape=box,color=blue];
		1159 -> 1166;
		1159 -> 1167;
		1159 -> 1168;
	1160 [label="But you are all as equally to blame for continuing to roll this juba bug turd downhill for as long as you have, getting bigger with every scrap of feces it collects along the way!",shape=box,color=blue];
		1160 -> 1169;
	1161 [label="As a species, we are quite wondrous in our ability to feed our fears new ways to destroy ourselves.",shape=box,color=blue];
		1161 -> 1170;
	1162 [label="+5 Chemistry",color=orange];
		1162 -> 1171;
	1163 [label="+5 Chemistry",color=orange];
		1163 -> 1161;
	1164 [label="They were merely echoes of energy being regurgitated like a colorful kutak to feed its children.",shape=box,color=blue];
		1164 -> 1169;
	1165 [label="Chat ends.",color=orange];
	1166 [label="We can't create things like that, Roathe - I told you. Conceptual Embodiment has its limits.",shape=box,color=red];
		1166 -> 1172;
	1167 [label="Don't blame us for this. We're not at fault for the damage that thing has caused.",shape=box,color=red];
		1167 -> 1173;
	1168 [label="Walk me through your reasoning on how this would work. Most things that are created via Conceptual Embodiment from the Void can't leave it - at least not for long.",shape=box,color=red];
		1168 -> 1174;
	1169 [label="Allow me to simplify the discussion for you. I can disrobe this false deity for you in two simple words you should know and understand quite well:",shape=box,color=blue];
		1169 -> 1127;
	1170 [label="Update boolean RoatheMITW1",color=orange];
		1170 -> 1107;
	1171 [label="Because then we must fight our own demons. And humanity... never wins such wars, do we?",shape=box,color=blue];
		1171 -> 1170;
	1172 [label="Says the one who created an entire alternate dimension single-handedly? Please, Drifter... use your imagination like you once did so long ago.",shape=box,color=blue];
		1172 -> 1174;
	1173 [label="I am not reprimanding you! This thing was already long in the works before you ever entered the picture. Albrecht saw to that.",shape=box,color=blue];
		1173 -> 1175;
	1174 [label="Conceptual Embodiment works like thus - when interacting with the Void, or in proximity to the Void, powerful emotions and thoughts can manifest physically. We both know this.",shape=box,color=blue];
		1174 -> 1176;
		1174 -> 1177;
		1174 -> 1178;
	1175 [label="He saw his own reflection and knew true fear. And so began the first spark that lit the fire that threatens to burn it all down. You all simply keep throwing more fuel into it.",shape=box,color=blue];
		1175 -> 1174;
	1176 [label="Right. Like Duviri, it shares a connection to this world via the Zariman. ",shape=box,color=red];
		1176 -> 1179;
	1177 [label="Like the Zariman, and the Holdfasts, and the Void Angels. The Void is everywhere on that ship.",shape=box,color=red];
		1177 -> 1179;
	1178 [label="Yes. And?",shape=box,color=red];
		1178 -> 1180;
	1179 [label="Precisely. Where the Void goes, Conceptual Embodiment can follow. And only there.",shape=box,color=blue];
		1179 -> 1181;
		1179 -> 1182;
	1180 [label="Where the Void goes, Conceptual Embodiment can follow. And only there.",shape=box,color=blue];
		1180 -> 1181;
		1180 -> 1182;
	1181 [label="But it's been to 1999. It's followed Albrecht everywhere. And me, too.",shape=box,color=red];
		1181 -> 1183;
	1182 [label="Wait...",shape=box,color=red];
		1182 -> 1184;
	1183 [label="The damnable fingers. We took those cursed fingers, in a desperate and mad attempt to reach Tau, and we Orokin found a way to replicate them, didn't we?",shape=box,color=blue];
		1183 -> 1185;
	1184 [label="Yes. You now see it. The damnable fingers. We took those cursed fingers, in a desperate and mad attempt to reach Tau, and we Orokin found a way to replicate them, didn't we?",shape=box,color=blue];
		1184 -> 1185;
	1185 [label="Little bits of the Void, everywhere you go... A network of trenches and tunnels for that thing to pop up wherever it may like. And worse still?",shape=box,color=blue];
		1185 -> 1186;
	1186 [label="The Tenno. And you. All of you, Void-touched. And all of you, haunted by that thing, for wherever you go, it can follow.",shape=box,color=blue];
		1186 -> 1187;
	1187 [label="And likely anyone who has interacted with it for any length of time. Entrati himself. His butler. The Cavia. Myself, the zealots, by our proximity to this Sanctum. The list goes on.",shape=box,color=blue];
		1187 -> 1188;
		1187 -> 1189;
	1188 [label="So you're postulating that anyone with enough Void exposure - or anyone who is a \"battery\" becomes another window for the Man in the Wall to peer through?",shape=box,color=red];
		1188 -> 1190;
	1189 [label="But how did it get into Rusalka, I wonder?",shape=box,color=red];
		1189 -> 1191;
	1190 [label="Precisely. ",shape=box,color=blue];
		1190 -> 1192;
	1191 [label="Who?",shape=box,color=blue];
		1191 -> 1193;
		1191 -> 1194;
	1192 [label="Which would explain why it cannot wear its own face, wouldn't it? It can only appear as those it is tormenting, to those it is attempting to torment.",shape=box,color=blue];
		1192 -> 1195;
	1193 [label="Major Neci Rusalka. She was in charge of the military force known as Scaldra in 1999, in Höllvania.",shape=box,color=red];
		1193 -> 1196;
	1194 [label="The long and short of it is that I should never, ever, allow you two to meet.",shape=box,color=red];
		1194 -> 1197;
	1195 [label="In fact it only seems to wear the face of architecture when it is struggling to show itself as something Larger and Other. When it is desperate to appeal to some sense of Grandiosity and Godhood.",shape=box,color=blue];
		1195 -> 1198;
		1195 -> 1199;
	1196 [label="She was - or is - being possessed by the Indifference. It's sharing her mind, using her like a puppet. Or she let it in. We don't know. We also don't know if she's actually back in control.",shape=box,color=red];
		1196 -> 1200;
	1197 [label="You are absolutely no fun, Usurper. But how does she involve our... Indifference, precisely?",shape=box,color=blue];
		1197 -> 1196;
	1198 [label="So you think it's wearing all the faces of people it comes into contact with... because it doesn't have one of its own?",shape=box,color=red];
		1198 -> 1201;
	1199 [label="I believe the Man in the Wall is choosing to wear our faces because it can't comprehend what it's like to be human. It's too \"big,\" otherwise.",shape=box,color=red];
		1199 -> 1202;
	1200 [label="She does sound like a deliciously formidable individual. And a complete delight. But that is neither here nor there for the moment. You say the Indifference has taken over her mind? And this began in your little furlough into the past?",shape=box,color=blue];
		1200 -> 1203;
	1201 [label="No, silly thing. Because it is only mimicking that which created it. It is not a whole entity - it is only a toy made out of mismatched parts of whatever fears and dread and suffering it has been fed. ",shape=box,color=blue];
		1201 -> 1204;
	1202 [label="No, silly thing. It is only mimicking that which created it. It is not a whole entity - it is only a toy made out of mismatched parts of whatever fears and dread and suffering it has been fed.",shape=box,color=blue];
		1202 -> 1204;
	1203 [label="Well, if what we know of the Void holds true, then one of two things occurred: Either, she happened into some instance of the Void in 1999 of her own doing (which I find deeply improbable, but not impossible), or...",shape=box,color=blue];
		1203 -> 1205;
	1204 [label="Bah. I see I am going to make no progress today. That is fine, you are deeply entrenched in this propaganda you have been fed. Albrecht is a deeply convincing cult leader, I fear.",shape=box,color=blue];
		1204 -> 1206;
	1205 [label="Our dear Albrecht was meddling again.",shape=box,color=blue];
		1205 -> 1207;
		1205 -> 1208;
		1205 -> 1209;
	1206 [label="+10 Chemistry",color=orange];
		1206 -> 1210;
	1207 [label="Are you implying that Albrecht made Neci the puppet of the Indifference on purpose?",shape=box,color=red];
		1207 -> 1211;
	1208 [label="We don't know that any of this is true. Any of it. This is all just speculation. All of this could be complete lies.",shape=box,color=red];
		1208 -> 1212;
	1209 [label="If he ripped a hole through to the Void in 1999, and let it in on purpose... that would explain why Warframes worked there in the first place... same with your time - without the Deimos heart, that is.",shape=box,color=red];
		1209 -> 1213;
	1210 [label="Update boolean RoatheMITW2",color=orange];
		1210 -> 1214;
	1211 [label="I am merely sitting here reading tea leaves with the best of them, Usurper. Far be it from me to insinuate that Albrecht purposefully ripped open a hole into the Void in Höllvania and let the Indifference in, in order to give it an avatar of its own...",shape=box,color=blue];
		1211 -> 1215;
	1212 [label="Of course! I am merely sitting here reading tea leaves with the best of them, Usurper. Far be it from me to insinuate that Albrecht purposefully ripped open a hole into the Void in Höllvania and let the Indifference in, in order to give it an avatar of its own...",shape=box,color=blue];
		1212 -> 1215;
	1213 [label="You see? Never trust a scientist. They are willing to do anything in the name of muddling about. But then again, I am simply sitting here reading tea leaves with the best of them, Usurper. This is all simple postulation.",shape=box,color=blue];
		1213 -> 1216;
	1214 [label="I do hope that I at least gave you something to think on. For now, however, I must go.",shape=box,color=blue];
		1214 -> 1217;
	1215 [label="It just seems to me, as a tactician and a man who is quite accustomed to strategizing for war...",shape=box,color=blue];
		1215 -> 1218;
	1216 [label="Far be it from me to insinuate that Albrecht purposefully ripped open a hole into the Void in Höllvania and let the Indifference in, in order to give it an avatar of its own! It just seems to me, as a tactician and a man who is quite accustomed to strategizing for war...",shape=box,color=blue];
		1216 -> 1218;
	1217 [label="Chat ends.",color=orange];
	1218 [label="That the first step to defeating a faceless opponent who can be anywhere, anyone, and anywhen? Is to narrow it down to as few options as possible...",shape=box,color=blue];
		1218 -> 1219;
	1219 [label="+20 Chemistry",color=orange];
		1219 -> 1220;
	1220 [label="And to ensure those options can bleed out.",shape=box,color=blue];
		1220 -> 1221;
	1221 [label="Update boolean RoatheMITW2Neci",color=orange];
		1221 -> 1222;
	1222 [label="Wonderful food for thought. But! For now, I must go.",shape=box,color=blue];
		1222 -> 1223;
	1223 [label="Chat ends.",color=orange];
}