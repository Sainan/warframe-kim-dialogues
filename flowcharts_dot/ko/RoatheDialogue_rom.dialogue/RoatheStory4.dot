	"Chat ends." [color=orange];
	j2983445252 [label="음성 메시지: 오만",shape=box,color=blue];
		j2983445252 -> j205553959;
	j205553959 [label="구술 기록: 우리는 패배를 예상하지 않았다. ",shape=box,color=blue];
		j205553959 -> j3743883549;
	j3743883549 [label="센티언트의 첫 원정 공격 이후, 우리는 응징성 반격을 준비했다.",shape=box,color=blue];
		j3743883549 -> j1714871229;
	j1714871229 [label="도금유리의 요희 호가 죽음으로 가득한 날개를 달고 세레스의 안개로부터 솟아올랐다. 드론과 은 갑옷을 입은 미르미돈을 잔뜩 실은 갤리온선.",shape=box,color=blue];
		j1714871229 -> j2071574094;
	j2071574094 [label="안개와 같이 섬세한 회로망이 반투명한 장갑 아래 우아한 레이스처럼 드리웠고, ",shape=box,color=blue];
		j2071574094 -> j812546183;
	j812546183 [label="그 크기는 너무 거대한 나머지 솔라 레일의 가장자리에 간신히 닿지 않을 정도였다.",shape=box,color=blue];
		j812546183 -> j2167064638;
	j2167064638 [label="센티언트들은 그 결말을 우리에게 똑똑히 보여주었다. 그들이 노래하자, 우리의 기술이 마비되기 시작한 것이다. 우리의 전사들은 번쩍거리는 갑옷을 입은 채 몸부림치고 질식하며 죽어갔다.",shape=box,color=blue];
		j2167064638 -> j854025804;
	j854025804 [label="승무원들이 산 채로 구워지는 가운데, 도금유리의 요희 호는 엔진을 잃고 뛰어드는 백조와 같이 타우의 하늘로 추락했다. 불꽃놀이치고는 너무나도 복잡하고 값비싼 불꽃놀이였다.",shape=box,color=blue];
		j854025804 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}