	"Chat ends." [color=orange];
	j3631644781 [label="음성 메시지: 반역",shape=box,color=blue];
		j3631644781 -> j708170182;
	j708170182 [label="구술 기록: \"평화라고?\"",shape=box,color=blue];
		j708170182 -> j100491001;
	j100491001 [label="그녀의 목소리는 마치 깨진 유리 조각이 내 귓속에서 갈려나가는 소리처럼 들렸다.",shape=box,color=blue];
		j100491001 -> j703807471;
	j703807471 [label="집행관 니토크는 명백히 불쾌해했다. 그녀가 기대한 것은 전투에 전투가 이어진 끝에 오로킨의 파멸이라는 절정의 황홀경으로 대단원을 맞이하는, 영광스런 고조의 과정이었으니까.",shape=box,color=blue];
		j703807471 -> j3053076906;
	j3053076906 [label="그 뒤엔 숨어 있던 그녀가 세상에 나와서... 뭐, 거기서부턴 이제 추측만 할 수 있을 뿐이지. 어쩌면 그녀는 센티언트들의 신임을 얻게 되리라 기대했던 것인지도 모른다.",shape=box,color=blue];
		j3053076906 -> j409980872;
	j409980872 [label="혹은 그들이 불타고 오염된 잔해만 남은 이 근원계를 버리고 떠난 뒤, 남은 그녀가 자신만의 새로운 왕국을 건설할 수 있게 되리라 생각했던 것인지도 모르지.",shape=box,color=blue];
		j409980872 -> j3050383373;
	j3050383373 [label="어느 쪽이었든, 평화는 용납할 수 없는 선택지였다. 그리하여 우리는 이 협정을 무너뜨릴 목적으로 움직이기 시작했다.",shape=box,color=blue];
		j3050383373 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}