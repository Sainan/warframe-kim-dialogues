		j1345003952 -> j1866528498;
	j3256352826 [label="널 도와주면 내 기억 찾는 걸 도와주겠다 약조했었다. 그리고 난 거래 조건을 이행했지. 그게 우리의 계약이었다!",shape=box,color=red];
