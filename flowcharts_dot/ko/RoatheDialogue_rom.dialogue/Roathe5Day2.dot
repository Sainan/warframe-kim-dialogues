	j8852792 [label="명령이다. 당장 이걸 고쳐 놓아라. 이건 네 잘못이다. 느껴진단 말이다, 내게 발톱을 박아대며, 찢어발기려는 그것이! 무슨 거대한 짐승처럼.",shape=box,color=blue];
