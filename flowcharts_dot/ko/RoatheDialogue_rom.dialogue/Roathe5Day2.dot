	j3591944113 [label="새로운 날이 밝아오고, 오랜만에 미래를 계획하고 있는 내 자신을 발견했다. 이 세상을 어떻게 바꿔나갈 수 있을지, 내가 가진 지식과 내 존재를 어떻게 더 나은 방향으로 활용할 수 있을지 생각해 보았다.",shape=box,color=blue];
		j3591944113 -> j3984658869;
	j1115060223 [label="새로운 날이 밝아오고, 오랜만에 미래를 계획하고 있는 내 자신을 발견했다. 앞으로의 삶이 나에게 어떤 의미인지, 내가 원하는 것은 무엇인지, 내 주변 환경을 어떻게 바꿔나가고 싶은지 곰곰이 생각해 보았다.",shape=box,color=blue];
		j1115060223 -> j2558396776;
	j1642383502 [label="정확히 뭘 기다리고 있는지 물어봐도 되나? 사건에 대한 기억이 아직 완벽하게 남아 있어서 말이야. 넌 내 기억에서 그 모든 것을 지워주겠다 약속했지.",shape=box,color=blue];
