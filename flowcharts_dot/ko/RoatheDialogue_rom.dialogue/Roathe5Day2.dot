	j3550175473 [label="설령 우리가 이런 교착 상태에 영원히 갇히게 된다 해도 말인가? 불쌍하고, 딱한 찬탈자여... 잘 알겠다. 악마에게 연옥은 지옥에 있는 것보다 낫지, 안 그런가?",shape=box,color=blue];
		j3550175473 -> j3240159168;
	j2030187180 [label="좋다. 얼른 시작해라. 이 사실을 머릿속에 담아두고 사는 게 지긋지긋하다.",shape=box,color=blue];
		j2030187180 -> j378811769;
	j2059834177 [label="하지만 그게 너와 무슨 상관이지? 나의 텅 빈 시체에서 원하는 모든 것을 잘라낼 수도 있을 거다. 내 갈비뼈는 앙상하게 드러나 있고 새하얗게 바래버렸으니.",shape=box,color=blue];
		j2059834177 -> j1776100240;
	j452504082 [label="참으로 비극적이지 않나? 엔트라티 가문의 잔재들은 집사가 여기서 홀로 슬픔에 잠겨 양손을 주무르며 썩어가고 있다는 사실을 결코 알지 못할 거라는 걸 생각하면 말이다?",shape=box,color=blue];
