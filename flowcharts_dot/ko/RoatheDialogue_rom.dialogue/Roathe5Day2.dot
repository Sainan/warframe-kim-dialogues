	j3923314978 [label="속았다는 걸 이제야 깨달았다고 해서 그리 분개해하지 마라. 난 거래 조건을 제시했으나 원하는 바에 대해선 명확히 밝힌 적이 없었지. 그걸 못 알아챘나?",shape=box,color=blue];
		j3923314978 -> j2104191926;
	j1866528498 [label="난 거래 조건을 제시했으나 원하는 바에 대해선 명확히 밝힌 적이 없었지. 그걸 못 알아챘나?",shape=box,color=blue];
		j1866528498 -> j2104191926;
	j1323904934 [label="\"내 기억이 돌아올 때마다 그걸 기록하고 정리하는 데 도움을 줄 누군가도 필요하다. 말하자면 임시 비서 같은 셈이지.\"",shape=box,color=blue];
		j1323904934 -> j3882238463;
	j1159986242 [label="나는 그저 네가 거짓말을 하고 있다 주장할 것이고, 그렇게 되면 너에 대한 내 인상은 돌이킬 수 없을 정도로 망가져버리겠지.",shape=box,color=blue];
		j1159986242 -> j3526968917;
		j1159986242 -> j2156304916;
	j1358358731 [label="대화를 나눌 때마다 우리가 걷는 이 땅이 너에게 익숙한 곳일지 낯선 곳일지 궁금해진다. 내가 그저 같은 말을 되풀이하는 것인지, 아니면 너에게 새로운 놀라움을 선사하는 것일지도 궁금하고.",shape=box,color=blue];
		j1358358731 -> j523017028;
	j778818393 [label="넌 거래 조건을 충실히 이행했다. 이제 우리는 공격 방식을 어떻게 펼칠지 세부 사항을 조율해야 하는 마지막 단계에 이르렀으니.",shape=box,color=blue];
		j778818393 -> j3331470226;
	j983716935 [label="Boolean RoatheDating is now false.",color=orange];
		j983716935 -> j997784240;
	j2104191926 [label="난 그저 네가 이 거래를 통해 얻게 될 이점만 말했을 뿐이다. 그것들을 얻기 위해 무엇을 해야 하는지, 또 왜 이행해야 하는지는 전혀 언급하지 않았다. 그런데 넌 아무 생각없이 거래를 해버렸지.",shape=box,color=blue];
		j2104191926 -> j2931599289;
	j3882238463 [label="첫 번째 기준인 \"내 기억을 기록하는 것\"에는 충족했으나, 두 번째 기준인 \"그 기억들을 정리하도록 도와라\"의 조건 이행은 완전히 실패했군.",shape=box,color=blue];
		j3882238463 -> j3643644813;
	j3526968917 [label="안 돼. 그렇게는 못 해. 안 할 거야. 이 상황을 같이 끝까지 파헤쳐 나가야만 해. 우리 그냥 대화로 풀면 안될까?",shape=box,color=red];
		j3526968917 -> j2919632114;
	j2156304916 [label="난... 정말 다른 방법이 없는 거야?",shape=box,color=red];
		j2156304916 -> j2919632114;
	j523017028 [label="어쨌든, 내게 말하지 않아줬음 좋겠다. 너무 뻔히 예측 가능한 인간이 되는 걸 싫어하니까. 어찌됐든, 네 덕분에 내게 있어서 아주 중요한 문제를 해결할 수 있게 되었다. ",shape=box,color=blue];
		j523017028 -> j1511306578;
	j3331470226 [label="이 전쟁은 세 개의 전선에서 치뤄져야 한다. 모두가 협력해야만 승리할 수 있다.",shape=box,color=blue];
		j3331470226 -> j3390863061;
		j3331470226 -> j693456150;
	j997784240 [label="그래, 네가 나에게 뭘 요구하든, 이제는 결코 얻지 못할 것이다. 이 어처구니없는 일을 끝내고 내 기억에서 지워버리는 게 좋을 것이다. \"내 연인, 드리프터여.\"",shape=box,color=blue];
		j997784240 -> j810037017;
	j2931599289 [label="이것이야말로 옛말에 \"백지수표\"라 하던 것이 아닌가? 그리고 넌 아주 자발적으로 서명해 넘겨주었고.",shape=box,color=blue];
		j2931599289 -> j1961248530;
		j2931599289 -> j246654216;
	j3643644813 [label="가족과 집사가 화해했다고 도저히 말할 수 없을 것 같은데, 네 생각은 어떻지?",shape=box,color=blue];
		j3643644813 -> j4125845643;
	j2919632114 [label="아니. 그 집사를 위층으로 올려보내고 싶나? 그럼 내가 말한 대로 내 머릿속에서 이 모든 말도 안 되는 기억들을 지워버려라. 어떻게 되든 상관 없다면? 그럼 마음대로 하거라. 어차피 나와는 관계 없는 일이니.",shape=box,color=blue];
		j2919632114 -> j2274878605;
	j1511306578 [label="어젯밤, 정말로 오랜만에 깊게 잠들었다. \"기억도 나지 않을 만큼 오랜만\"이라고 말하고 싶었으나, 그건 너무나 진부한 표현이겠지.",shape=box,color=blue];
