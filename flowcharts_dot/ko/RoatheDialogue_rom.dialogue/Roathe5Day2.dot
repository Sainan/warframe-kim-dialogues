		j1642383502 -> j3870570617;
	j1824113320 [label="아직도 결정을 못 내렸나? 난 참을성이 많은 악마지만, 한계라는 게 있다. 이 기억들을 내 마음에서 깨끗이 지워주실 건가, 아니면 그대로 둘 건가?",shape=box,color=blue];
		j1824113320 -> j4175122817;
		j1824113320 -> j893619800;
	j252131236 [label="우린 여기에 있고, 여기에 영원히 머물겠지. 이 연옥에서. 부디 이곳을 즐기길 바란다. 우린 한 발짝도 더 나아갈 수 없을테니까.",shape=box,color=blue];
		j252131236 -> j2171950327;
