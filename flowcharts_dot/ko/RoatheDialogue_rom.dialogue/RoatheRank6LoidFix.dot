		j2686505034 -> j1037693350;
	j2431580371 [label="내가 설득을 끝내고 나면, 집사 놈은 분명 골이 나 있을 것이다. 분명 네가 제일 먼저 알 수 있겠지. 놈은 필시 그 징징거림을 주체하지 못할 것이다.",shape=box,color=blue];
		j2431580371 -> j1525402981;
	j1037693350 [label="난 그를 해치려는 게 아니다! 맹세코, 그저 말만 하겠다는 것 뿐이지. 뭐, 그자 입에서 이야기가 나온다면, 보나마나 아주 극악무도한 행패를 저지른 것처럼 들리겠지만 말이야.",shape=box,color=blue];
