		j1641827914 -> j1014639102;
	j4202659040 [label="렐이 지금 존재하기도 하고 존재하지 않기도 하는 것처럼, 무심은 결코 신이 아니었지만, 지금은 언제나 신과 같은 위치에 있지.",shape=box,color=red];
		j4202659040 -> j427793244;
	j1957443425 [label="내 입장을 다시 한번 고려하도록 설득을 해도 되겠나? 아니면 이 문제에 대한 너의 견해는 절대 바뀌지 않는 건가?",shape=box,color=blue];
