		j1957443425 -> j1338351539;
	j2487694890 [label="그렇게 예민한 방아쇠를 가지고 있을 줄은 몰랐다, 소중한 드리프터여. 허나 광신도들의 말을 빌리자면, \"c'est la vie.\"",shape=box,color=blue];
