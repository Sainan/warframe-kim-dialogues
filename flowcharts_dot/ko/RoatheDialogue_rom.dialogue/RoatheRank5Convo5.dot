		j2948494049 -> j1637422660;
	j3662786985 [label="해봤어. 내 생각엔 엔트라티가 보이드로부터 풀어놓은 건 우리가 도착하기 전부터 에테르에 존재했던 형체 없는 신이었던 것 같아.",shape=box,color=red];
		j3662786985 -> j2249511301;
	j1662504871 [label="해봤어. 네 주장은 순 헛소리 같아.",shape=box,color=red];
		j1662504871 -> j4099310853;
	j904644874 [label="해봤어. 네 말이 맞는 것 같아. 엔트라티가 그것과 접촉하기 전에는 존재하지 않았던 것 같아. 그 인간은 신을 찾고 싶어 했고... 그래서 보이드가 신인 척하는 무언가를 뱉어낸 거지.",shape=box,color=red];
		j904644874 -> j1641827914;
	j1637422660 [label="해봤어. 답은 그 중간 어디쯤에 있을 것 같아. 전에는 신이 아니었을지 몰라도, 지금은 신이지. 엔트라티가 보이드를 열자마자 순식간에 존재하게 만든 것 같아.",shape=box,color=red];
		j1637422660 -> j4202659040;
