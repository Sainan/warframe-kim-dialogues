	j697481169 [label="음성 메시지: 불길",shape=box,color=blue];
		j697481169 -> j1554725392;
	j1554725392 [label="구술 기록: 거대한 위력과 과잉은 과거 우리에게 훌륭하도록 유용한 요소였고, 나는 이것을 전쟁 전술로 활용해야 했다.",shape=box,color=blue];
		j1554725392 -> j4262984412;
	j4262984412 [label="선조의 시대에 우리가 어떻게 감염체를 길들였냐고? 당연히, 폭탄 속 원자의 심장을 장미 봉오리처럼 찢어발겨서지!",shape=box,color=blue];
		j4262984412 -> j3786745225;
	j3786745225 [label="7인 의회는 다 같이 한목소리로 내게 탄두의 삼지창을 쥔 악마, 걷잡을 수 없는 방사능 주머니를 쥔 농부가 되기를 명했다.",shape=box,color=blue];
		j3786745225 -> j2384003425;
	j2384003425 [label="그날 우리는 센티언트들이 우리의 기술을 무효화할 수 있을 뿐만 아니라, 역으로 장악할 수도 있다는 것을 알게 되었다.",shape=box,color=blue];
		j2384003425 -> j2277930246;
	j2277930246 [label="우리가 내보낸 그 조그맣고도 사악한 평탄화 드론 떼는 들고 갔던 폭탄을 아직도 무겁게 짊어진 채, 알 수 없는 음절로 깔깔거리며 우리에게 신이 난 듯 날아 돌아왔다. 그러고는 그것들을 파견한 바로 그 모함의 한가운데서 폭탄을 터뜨리고 말았다.",shape=box,color=blue];
		j2277930246 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}