	j3203899948 [label="음성 메시지: 손실",shape=box,color=blue];
		j3203899948 -> j332010957;
	j332010957 [label="구술 기록: 손실은 터무니없을 정도였다.",shape=box,color=blue];
		j332010957 -> j4065958086;
	j4065958086 [label="많은 이들이 자료를 그대로 믿기를 거부한 채, 무언가의 오류라고만 단정했다. 혹은 거짓말이거나, 세팔론의 음모거나.",shape=box,color=blue];
		j4065958086 -> j559663380;
	j559663380 [label="오로킨의 속임수를 먹고 자라다 못해 지나치게 탐식해 온 그들에게, 이제 진실을 거부하기란 쉬운 일이었다.",shape=box,color=blue];
		j559663380 -> j36170380;
	j36170380 [label="그 순간 이래로, 그들은 자신의 위안을 위해 지어낸 환상 속에서 살게 되었다.",shape=box,color=blue];
		j36170380 -> j2951227408;
	j2951227408 [label="\"우리는 이기고 있어\", \"센티언트 놈들이 후퇴하고 있다\" - 그렇게 생각하지 않는 자들은 모두 반역자였다.",shape=box,color=blue];
		j2951227408 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}