	"Chat ends." [color=orange];
	j1022946265 [label="음성 메시지: 워프레임",shape=box,color=blue];
		j1022946265 -> j1009593044;
	j1009593044 [label="구술 기록: 워프레임을 처음 봤을 때에는, 제대로 된 무기라기보단 예술적 표현에 가까워 보였다.",shape=box,color=blue];
		j1009593044 -> j1876331117;
	j1876331117 [label="전쟁은 어차피 패배한 판. 센티언트들을 격퇴할 방법은 없었다. 그렇다면, 이런 기묘하고 비현실적인 전사들이라도 만들어 고대로부터 내려온 무기로 무장시키자.",shape=box,color=blue];
		j1876331117 -> j3343166894;
	j3343166894 [label="그리하면 적어도 우리의 패배가 아름답게 보이긴 하겠지. 기억에 남을 만하겠지.",shape=box,color=blue];
		j3343166894 -> j2763823972;
	j2763823972 [label="그러나 모든 이들의 예상을 깨고, 그들은 승리했다. 곧 충격적일 정도로 터무니없는 활약상이 전선으로부터 흘러들어오기 시작했다.",shape=box,color=blue];
		j2763823972 -> j1570336106;
	j1570336106 [label="워프레임들이 천사와 같은 모습으로 하늘에서 나타나, 포로들을 해방시키고 센티언트들의 요새를 초토화시켰노라고. 단신으로도 기적 같은 존재들이었지만, 떼를 지어 모이면 신들과도 같았다.",shape=box,color=blue];
		j1570336106 -> j1275625283;
	j1275625283 [label="그렇다면 이들이 그저 선전 도구로밖에 보이지 않은 것도, 무리는 아니었겠지.",shape=box,color=blue];
		j1275625283 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}