	"Chat ends." [color=orange];
	j3491887575 [label="음성 메시지: 지휘관들",shape=box,color=blue];
		j3491887575 -> j2335579436;
	j2335579436 [label="구술 기록: 지금에 와서 떠오른다. 서로 웃음을 나누는 오로킨 젊은이들의 무리.",shape=box,color=blue];
		j2335579436 -> j230885253;
	j230885253 [label="아직 더럽혀지지 않은 지휘관의 예복을 두른 귀족들.",shape=box,color=blue];
		j230885253 -> j1206437999;
	j1206437999 [label="어릴 적의 친구들은 이제 닥스 군단, 그리니어 군단, 영물질 부대, 자가 복제 발암기, 원시 생체드론 칼날거미, 저기술 병사 수납기 등의 지휘를 맡고 있다.",shape=box,color=blue];
		j1206437999 -> j2052364122;
	j2052364122 [label="게걸스런 악마들을 마음대로 부리는, 금빛을 두른 소년 소녀들.",shape=box,color=blue];
		j2052364122 -> j666063420;
	j666063420 [label="그들의 오만은 따끔거리는 땀처럼 내 마음 속을 흐른다. 그들은 마시고 노래하며, 곧 다가올 자신의 미래를 자랑했지.",shape=box,color=blue];
		j666063420 -> j2296428105;
	j2296428105 [label="자신들은 명성을 떨칠 거라고. 자신의 가문을 드높은 영예로 치켜올릴 거라고.",shape=box,color=blue];
		j2296428105 -> j4102892321;
	j4102892321 [label="그들 중 너무나 많은 수가 스러졌다. 시체조차 돌아오지 못했다.",shape=box,color=blue];
		j4102892321 -> j3233523915;
	j3233523915 [label="적들이 우리의 비밀을 캐낼 수 없도록, 죽는 순간 그들의 몸 속 쿠바가 발동해 시신을 액화시킨 것이다.",shape=box,color=blue];
		j3233523915 -> j4009808197;
	j4009808197 [label="The hope of a generation turned to an oily puddle, sloshed through by Grineer boots.",shape=box,color=blue];
		j4009808197 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}