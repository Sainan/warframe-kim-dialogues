		j2756001721 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j4036573268 [label="음성 메시지: 지휘관들",shape=box,color=blue];
		j4036573268 -> j2997641862;
	j2997641862 [label="구술 기록: 지금에 와서 떠오른다. 서로 웃음을 나누는 오로킨 젊은이들의 무리.",shape=box,color=blue];
		j2997641862 -> j979967746;
	j979967746 [label="아직 더럽혀지지 않은 지휘관의 예복을 두른 귀족들.",shape=box,color=blue];
		j979967746 -> j2496601332;
	j2496601332 [label="어릴 적의 친구들은 이제 닥스 군단, 그리니어 군단, 영물질 부대, 자가 복제 발암기, 원시 생체드론 칼날거미, 저기술 병사 수납기 등의 지휘를 맡고 있다.",shape=box,color=blue];
		j2496601332 -> j4148574359;
	j4148574359 [label="게걸스런 악마들을 마음대로 부리는, 금빛을 두른 소년 소녀들.",shape=box,color=blue];
		j4148574359 -> j532557488;
	j532557488 [label="그들의 오만은 따끔거리는 땀처럼 내 마음 속을 흐른다. 그들은 마시고 노래하며, 곧 다가올 자신의 미래를 자랑했지.",shape=box,color=blue];
		j532557488 -> j4040325476;
	j4040325476 [label="자신들은 명성을 떨칠 거라고. 자신의 가문을 드높은 영예로 치켜올릴 거라고.",shape=box,color=blue];
		j4040325476 -> j2836424868;
	j2836424868 [label="그들 중 너무나 많은 수가 스러졌다. 시체조차 돌아오지 못했다.",shape=box,color=blue];
		j2836424868 -> j2834245833;
	j2834245833 [label="적들이 우리의 비밀을 캐낼 수 없도록, 죽는 순간 그들의 몸 속 쿠바가 발동해 시신을 액화시킨 것이다.",shape=box,color=blue];
		j2834245833 -> j2281909788;
	j2281909788 [label="한 세대의 희망은 그렇게, 그리니어의 군홧발 밑에 철벅이는 기름 웅덩이로 변해 버렸다. ",shape=box,color=blue];
		j2281909788 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}