		j3154365955 -> j2045775098;
	j2539978751 [label="다행스럽게도 그러지 않았다. 마치 카펫에 볼일 본 강아지처럼 코를 그 문제에 문지르는 건 싫으니까. 지금도 신경 쓸 일은 충분히 많고 말이다.",shape=box,color=blue];
