		j2683659855 -> j2550784127;
	j975200514 [label="어차피 셋은 함께 있어야 해. 엔트라티가 그렇게 만들어버렸어. 그러니 이 상황을 최대한 활용하는 것도 나쁘지 않아.",shape=box,color=red];
		j975200514 -> j2380698944;
