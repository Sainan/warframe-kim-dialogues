		j4018384693 -> j3184769622;
	j1313878382 [label="그렇지 않을 경우, 내가 평생 들어본 사례 중 가장 슬픈 사례가 될지도 모르니까.",shape=box,color=blue];
		j1313878382 -> j2927459171;
