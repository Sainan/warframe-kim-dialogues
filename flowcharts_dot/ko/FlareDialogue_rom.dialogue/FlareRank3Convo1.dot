		665 -> 663;
	666 [label="아니면 오늘 하루를 버텨낼 수 있을지? 아니면 방에 틀어박혀 문을 걸어 잠그고 모든 사람한테 나가라고 해야 할까",shape=box,color=blue];
		666 -> 668;
	667 [label="그녀가 그냥 무섭기만 하면 좋겠어. 그 정도는 감당할 수 있을 테니까. 그녀가 못 머리같이, 나를 괴롭히는 공포 영화 속 괴물 같은 존재라면 말이야",shape=box,color=blue];
		667 -> 669;
