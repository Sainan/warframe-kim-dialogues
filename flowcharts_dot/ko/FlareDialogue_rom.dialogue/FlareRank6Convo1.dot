	j1561101807 [label="너의 손길은 독이며, 너의 입맞춤은 신성하네\n내 척추를 다시 써 내리는 손을 가진 악마\n어떤 날, 나는 기어다니고, 어떤 날, 나는 날아다니네\n내가 하늘을 만질 수 없을 때 날 안아줄 거라고 말해줘",shape=box,color=blue];
		j1561101807 -> j2729667313;
	j1333213540 [label="너의 손길이 내 피부 아래의 비밀을 더듬어 가네\n상처가 있던 곳에 너의 서약을 새겨 넣는구나\n어떤 날, 난 서 있고, 어떤 날, 난 기어다니네\n하지만 넌 내가 모든 것을 가진 것 같은 기분을 느끼게 해줘",shape=box,color=blue];
