	j3680446657 [label="나는 보이드 속에서 춤을 추고, 너의 불꽃 속에서 길을 잃었어\n매일 아침, 나는 새로운 이름으로 깨어나\n너는 나의 구세주인가, 아니면 나의 마지막인가?\n너는 솔을 높이 껴안아 주지만, 바닷속으로 잠겨가네\n오, 나를 사랑하든 떠나든, 그저 나를 자유로이 두지 마",shape=box,color=blue];
