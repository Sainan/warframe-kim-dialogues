		j434038618 -> j2729667313;
	j252995549 [label="너의 손길은 천둥이고, 너의 입맞춤은 폭풍이야\n하지만 너의 속은 비명 지르며, 따뜻하게 지내려고 노력하고 있어\n네 피부 아래의 균열을 봐봐\n넌 싸우고 있지만 결코 이기지 못할 전투야",shape=box,color=blue];
