		j3022792970 -> j1941418009;
	j479509615 [label="나는 불타고, 나는 부서지고, 나는 너의 눈 속에서 길을 잃었어\n너는 죽어가는 루아가 숨기는 보이드\n날 사랑하든 떠나든, 난 어느 쪽으로든 상처받을 거야\n매일 밤은 전쟁이지만, 너와 함께라면, 난 머물 수도 있어",shape=box,color=blue];
