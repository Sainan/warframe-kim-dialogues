	j2467067576 [label="너의 눈 뒤 속에서 얼음이 일고 있는 게 보여\n자정의 하늘 안에서 갇히신 루아께서 잠겨가고 있어\n넌 죄인처럼 웃지만, 난 그 아픔을 보네\n매 손길, 매 호흡—넌 얼마나 견딜 수 있니?",shape=box,color=blue];
		j2467067576 -> j1908806570;
	j1244761686 [label="루아께서 입을 벌리시는 걸 보았어\n그 안에는 은이, 설탕처럼 쏟아지네\n수백만 개의 목소리가 달콤하게 속삭였어\n텅 빈 복도와 얽혀진 꿈을 통해서",shape=box,color=blue];
		j1244761686 -> j1908806570;
	j3365818742 [label="새벽 속에서 넓게 펼쳐진 굶주린 날개여\n그 발톱으로 내 피부에 너의 운명을 새기는구나\n한 번의 호흡으로 나는 신성해지며—다음 호흡으로, 나는 추락하네\n내가 전부인지 아니면 아무것도 아닌지 알 수 없어",shape=box,color=blue];
		j3365818742 -> j2729667313;
	j2235492082 [label="넌 불맛이 나고, 죄악처럼 노래해\n넌 나를 가까이 끌어당기고 끌어들여\n날 사랑하든 떠나든, 난 어느 쪽으로든 상처받을 거야\n매일 새벽은 전쟁이지만, 너와 함께라면, 난 머물 수도 있어",shape=box,color=blue];
