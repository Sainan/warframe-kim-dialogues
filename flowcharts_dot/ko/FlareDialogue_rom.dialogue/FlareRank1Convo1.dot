	15 [label="좋아",shape=box,color=blue];
		15 -> 20;
	16 [label="아미르가... 자세한 정보들을 말해줬어. 꽤 빠르게 말이야.",shape=box,color=blue];
		16 -> 21;
	17 [label="너 동물원 유리창 두들기러 온 거야?",shape=box,color=red];
