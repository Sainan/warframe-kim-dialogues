		18 -> 20;
	19 [label="오, 솔이시여 절대로 아니야. 그런 인상 줘서 미안. 하지만 네 말도 맞는 것 같아. 우리 프로토프레임들이 이 도시의 유일한 과학 실험체들은 아니잖아, 안 그래?",shape=box,color=blue];
		19 -> 23;
		19 -> 24;
