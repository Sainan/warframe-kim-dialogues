		45 -> 48;
	46 [label="그리고 그것에 대해 나에게 답을 줄 수 있는 유일한 남자 - 그걸 나한테 설명해 주거나 그녀를 없앨 수 있는 유일한 남자가 *사라졌거든*",shape=box,color=blue];
		46 -> 50;
	47 [label="그래서 네가 알고 있는 그 인간의 모든 것을 알고 싶어, 너만 괜찮다면 말이야",shape=box,color=blue];
		47 -> 51;
