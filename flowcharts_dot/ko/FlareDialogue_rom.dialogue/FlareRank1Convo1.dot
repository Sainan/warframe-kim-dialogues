	4 [label="다른 과학 실험체들이 나한테 말하던 사람, 그거 너 맞지?",shape=box,color=blue];
		4 -> 6;
		4 -> 7;
	5 [label="여기 앉아 있으면서 아무것도 안 하는 것보다야 뭔가 하는 게 낫지. 묻고 싶은 질문이 많아, 너한테 시간만 있다면 말이야",shape=box,color=blue];
		5 -> 8;
		5 -> 9;
		5 -> 10;
	6 [label="이 주변에 내가 두 명이나 있을 거라고는 상상이 안 되지만. 글쎄, 뭐. 어쨌든 긴 이야기가 될 거야.",shape=box,color=red];
		6 -> 11;
	7 [label="걔들이 무슨 말을 했는지에 따라 다르지. 하지만 대화는 가능해.",shape=box,color=red];
		7 -> 12;
	8 [label="아무것도 안 하는 것보다야 뭔가 하는 게 낫지, 그래서 동물원 유리창 두드리기로 결심했구나. 아주 멋져.",shape=box,color=red];
		8 -> 13;
	9 [label="정말? 아무것도 안 하는 것보다야 뭔가 하는 게 낫다고? 정말 기쁘네. ㅋㅋㅋ.",shape=box,color=red];
		9 -> 14;
	10 [label="묻고 싶은 질문들이 있다면 물어봐. 난 여기 있으니까. 마음껏 물어봐.",shape=box,color=red];
		10 -> 15;
	11 [label="좋아. 음. 걔들이 기본적인 내용을 알려주긴 했어.",shape=box,color=blue];
		11 -> 16;
