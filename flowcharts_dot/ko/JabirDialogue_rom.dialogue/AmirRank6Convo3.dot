	j1327141076 [label="\"이 시점에 이르러선, 경비병이 얼마나 많이 가래침을 뱉어 댔는지 바닥이 반질반질할 지경이로군요. 다른 선택지를 시도해 보세요.\"",shape=box,color=blue];
		j1327141076 -> j4027183644;
	j4064398375 [label="\"경비병은 영 못마땅한 표정입니다. 그는 카악 퉤 하고 당신의 감방에 침을 뱉더니, 돌아서서 자기 의자로 다시 가 버립니다. 수 분 내로, 그의 코 고는 소리가 다시 한번 지하감옥을 뒤흔드는군요.\"",shape=box,color=blue];
		j4064398375 -> j371570762;
	j568041055 [label="뭐, 이거 말고 오거 같은 거였음 했어?",shape=box,color=blue];
		j568041055 -> j2513262964;
	j1947130797 [label="\"\"한동안 자물쇠와 씨름하던 당신은 마지막 금속편을 제 자리로 끼워넣는 데 성공합니다. 장치가 열리지만, 철컹 하고 너무 큰 소리를 내는군요.\"",shape=box,color=blue];
		j1947130797 -> j4054200745;
	j3670113740 [label="Check boolean ShankPick",color=orange];
		j3670113740 -> j4243976537 [label=true,color=green];
		j3670113740 -> j2271009593 [label=false,color=brown];
	j371570762 [label="Boolean LoogieLoop is now true.",color=orange];
		j371570762 -> j2417693503;
	j2513262964 [label="식상하지 않게 만들려는 것 뿐이라구",shape=box,color=blue];
		j2513262964 -> j4007980996;
		j2513262964 -> j619230111;
	j4054200745 [label="\"깨닫기도 전에, 경비병이 이미 잠에서 깨어나 있습니다. 그가 문으로 달려오자, 당신을 내려다보고 있는 커다란 그리니어가 눈에 들어오는군요. 당신은 무기를 향해 손을 뻗지만, 수감자 신세인 당신에게 무기가 있을 리 없다는 것을 그제서야 깨닫습니다.\"",shape=box,color=blue];
		j4054200745 -> j2956480890;
