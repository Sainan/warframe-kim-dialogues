		j571350755 -> j2417693503;
	j3822114325 [label="\"당신은 금속 조각을 살펴봅니다. '나쁘지 않네' 하고, 당신은 생각합니다. '예전에 찔러 본 다른 어떤 무기만큼이나 깊게 들어가겠어' 하며, 당신은 조각을 주워듭니다.\"",shape=box,color=blue];
