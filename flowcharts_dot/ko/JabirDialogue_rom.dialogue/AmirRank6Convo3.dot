	j835196768 [label="\"경비병은 더 이상 참아 줄 생각이 없습니다. 그는 허리춤에서 열쇠를 꺼내더니 감옥 문을 열고 감방 안으로 들이닥치는군요. 당신은 본능적으로 무기를 향해 손을 뻗지만, 수감자인 당신의 무기는 이미 빼앗긴 지 오래라는 것을 그제서야 깨닫습니다.\"",shape=box,color=blue];
