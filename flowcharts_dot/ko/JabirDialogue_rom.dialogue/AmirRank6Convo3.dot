		j3942496660 -> j4024058829;
	j3495492024 [label="\"그 소리에 경비병이 깨어납니다. 경비병이 한숨을 쉬며 투덜거리는 소리가 들리더니, 천천히 당신의 시야 안으로 걸어옵니다.\"",shape=box,color=blue];
