		j200495498 -> j590192296;
	j2587273482 [label="맨손으로 가자고. 그 놈 자식을 주먹으로 후려쳐.",shape=box,color=red];
		j2587273482 -> j3984165644;
	j4292612074 [label="양동이를 냅다 던져.",shape=box,color=red];
		j4292612074 -> j2941495866;
	j312482859 [label="그리니어라니? 뭔 소리야?",shape=box,color=red];
		j312482859 -> j47857188;
	j1401670016 [label="Boolean GrineerExist is now true.",color=orange];
		j1401670016 -> j1204131922;
	j590192296 [label="\"그리니어는 당신에게 달려듭니다. 당신은 옆으로 뛰어 피한 뒤 뻣뻣한 가죽같은 그의 목 피부를 뚫고 금속 조각을 밀어넣습니다.\"",shape=box,color=blue];
		j590192296 -> j2901684405;
	j3984165644 [label="\"당신은 있는 힘을 다해 경비병의 턱주가리에 맹렬한 강펀치를 날립니다.\"",shape=box,color=blue];
		j3984165644 -> j3357893514;
	j2941495866 [label="\"당신은 감방을 가로질러 쏜살같이 움직이더니 오물 양동이를 집어들어, 경비병에게 내던집니다.\"",shape=box,color=blue];
		j2941495866 -> j3597465646;
	j47857188 [label="페이블 앤 프론티어에도 그리니어가 나올 수 있다구",shape=box,color=blue];
		j47857188 -> j1557021443;
	j2901684405 [label="\"제 목을 가득 채운 핏물에 질식해 죽어가는 그리니어는, 숨이 넘어가며 마지막 말을 내뱉습니다.\"",shape=box,color=blue];
		j2901684405 -> j1749812773;
	j3357893514 [label="\"하지만 경비병은 꿈쩍도 하질 않는군요.\"",shape=box,color=blue];
		j3357893514 -> j781743141;
	j3597465646 [label="\"경비병은 해를 입지도, 당황하지도, 기분이 좋지도 않지만, 냄새는 좀 나아졌을지도 모르겠군요.\"",shape=box,color=blue];
