		j1156057370 -> j2745826645;
	j820564260 [label="\"눈을 뜨자 당신은 지하 깊은 곳에 있는 어둡고, 축축한 지하 감옥에 갇혀 있습니다. 창살 너머에 있는 복도에선 경비병이 코를 골고 있군요. 수면 무호흡증인가? 한 번 검사를 받아 보는 게 좋을 것 같군요. 당신에게 기억나는 건 얼마 없지만, 여기서 나가야 한다는 건 알고 있습니다.\"",shape=box,color=blue];
