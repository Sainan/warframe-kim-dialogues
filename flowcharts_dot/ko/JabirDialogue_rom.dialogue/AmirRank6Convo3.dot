		3977 -> 3982;
	4494 [label="\"이 시점에 이르러선, 경비병이 얼마나 많이 가래침을 뱉어 댔는지 바닥이 반질반질할 지경이로군요. 다른 선택지를 시도해 보세요.\"",shape=box,color=blue];
		4494 -> 3964;
	3971 [label="\"경비병은 영 못마땅한 표정입니다. 그는 카악 퉤 하고 당신의 감방에 침을 뱉더니, 돌아서서 자기 의자로 다시 가 버립니다. 수 분 내로, 그의 코 고는 소리가 다시 한번 지하감옥을 뒤흔드는군요.\"",shape=box,color=blue];
