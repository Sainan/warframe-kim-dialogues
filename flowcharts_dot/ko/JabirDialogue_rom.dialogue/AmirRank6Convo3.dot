	j2391497165 [label="\"당신의 의식 깊숙한 곳에서 자그마한 목소리가 들립니다. '야, 이 똥멍청아, 이번이 마지막 기회다. 뭘 아무리 용을 써 봐도 여기 어떻게 왔는진 기억 안 나는 거라고. 헛짓거리 그만해.'\"",shape=box,color=blue];
		j2391497165 -> j2859300151;
	j3942496660 [label="\"바짝 말라서 마치 그 자리에 수십 년은 있었던 것처럼 보입니다. 족쇄를 집어드니 부서지면서 바닥으로 떨어지는군요. 부서진 조각들 사이에서 뾰족한 금속 조각을 찾을 수 있습니다.\"",shape=box,color=blue];
