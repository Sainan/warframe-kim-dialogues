	4463 [label="네 말이 맞아 저 녀석들 구해줘야지.",shape=box,color=red];
		4463 -> 4465;
	4464 [label="제발. 안돼. 진짜 두고 가야 될 상황이라고.",shape=box,color=red];
		4464 -> 4466;
	4465 [label="\"자비르가 호각을 들고 붑니다.\"",shape=box,color=blue];
		4465 -> 4467;
	4466 [label="\"'기각!' 자비르가 말합니다.\"",shape=box,color=blue];
		4466 -> 4465;
	4467 [label="\"몇 초 후, 쥐 수십마리가 함선 안으로 몰려듭니다. 자비르는 당신을 보더니 크게 외칩니다. '가자!'\"",shape=box,color=blue];
		4467 -> 4468;
	4468 [label="\"함선은 그대로 이륙합니다. 그리니어들은 총을 발사하지만, 격납고를 유유히 빠져나가는 강력한 레일잭 앞에서 그들의 총알은 그저 튕겨나가기만 할 뿐입니다.\"",shape=box,color=blue];
		4468 -> 4469;
	4469 [label="\"쥐들이 함교를 뽈뽈거리며 돌아다니는 동안, 당신은 창 밖 광활한 우주를 내다봅니다. 그리고는 자신만만하게 말하지요. '레일드라이브, 발진.' 그러자 레일잭은 빛의 속도로 저 멀리 사라집니다.\"",shape=box,color=blue];
		4469 -> 4470;
	4470 [label="\"끝.\"",shape=box,color=blue];
		4470 -> 4471;
	4471 [label="워.",shape=box,color=red];
		4471 -> 4472;
	4472 [label="그래서, 엔딩은 어땠어? 너무 정신 나갔나?",shape=box,color=blue];
		4472 -> 4473;
		4472 -> 4474;
	4473 [label="이야, 할 말을 잃었다.",shape=box,color=red];
		4473 -> 4475;
	4474 [label="응, 그래서 좋았어.",shape=box,color=red];
		4474 -> 4476;
	4475 [label="그보다 더 심한 피드백도 받은 적 있다구",shape=box,color=blue];
		4475 -> 4477;
	4476 [label="휴, 너무 막 나갔나 좀 걱정했었어 사실",shape=box,color=blue];
		4476 -> 4477;
	4477 [label="그래서, 재고 점검은.",shape=box,color=red];
		4477 -> 4478;
	4478 [label="오 그거?",shape=box,color=blue];
		4478 -> 4479;
