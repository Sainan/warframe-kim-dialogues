	4423 [label="그 쥐 호루라기 그걸 다시 써 보자고.",shape=box,color=red];
		4423 -> 4427;
	4421 [label="제어판을 사용해.",shape=box,color=red];
		4421 -> 4425;
	4424 [label="레일잭으로 무조건 뛴다.",shape=box,color=red];
		4424 -> 4428;
	4422 [label="자비르를 보내 경사로 경비병을 공격하게 할 거야.",shape=box,color=red];
		4422 -> 4426;
	4427 [label="\"자비르는 호루라기를 꺼내 한 번 길게 붑니다. 하지만 훅 입김 부는 소리 외에는 아무 것도 들리지 않는군요. 앉아서 기다리지만, 아무 일도 일어나지 않습니다. 쥐도 안 나타나고, 아무것도요. 자비르는 어깨를 으쓱합니다.\"",shape=box,color=blue];
		4427 -> 4432;
	4425 [label="\"당신은 제어판으로 다가가지만, 그 전에 성실한 경비병이 눈치를 채고 맙니다. 당신은 항복의 의미로 손을 들어 보이려 하지만 그러거나 말거나 경비병은 당신을 쏴버리는군요. 그리니어는 원래 그렇게 못됐으니까요.\"",shape=box,color=blue];
		4425 -> 4429;
		4425 -> 4430;
	4428 [label="\"당신은 함선으로 냅다 뛰어가지만, 경사로를 지키던 경비병이 당신을 발견하고 발포합니다. 당신의 오늘도, 인생도, 고통스럽게 끝나버립니다.\"",shape=box,color=blue];
		4428 -> 4429;
		4428 -> 4433;
	4426 [label="어이구 그러세요 네 위험하면 아미르를 보내야겠져",shape=box,color=blue];
		4426 -> 4431;
	4432 [label="\"그러나 잠시 후 들립니다. 바스락거리는 소리가. 마치 뭔가를 씹는 것처럼. 그러더니 갑자기 쥐들이 격납고 여기저기의 환풍구로부터 튀어나옵니다. 그리니어 병사들은 초딩 애들처럼 꺅꺅 비명을 질러대며 총을 쏘아댑니다. 총알이 여기저기 어지럽게 날아다니는군요.\"",shape=box,color=blue];
		4432 -> 4437;
	4429 [label="잠깐 좀 쉬어야겠어. [종료.]",shape=box,color=red];
		4429 -> 4434;
	4430 [label="다시 한 번.",shape=box,color=red];
		4430 -> 4435;
	4433 [label="다시!",shape=box,color=red];
		4433 -> 4438;
	4431 [label="아니 아미르가 아니라 자비르지",shape=box,color=blue];
		4431 -> 4436;
	4437 [label="\"쥐들 덕에 경비병들이 혼비백산하고 있습니다. 이제 어쩔까요?\"",shape=box,color=blue];
		4437 -> 4441;
		4437 -> 4442;
	4434 [label="다시 올 꺼지",shape=box,color=blue];
		4434 -> 4439;
	4435 [label="Update boolean OneMoreTime",color=orange];
		4435 -> 4414;
	4438 [label="Update boolean Again",color=orange];
		4438 -> 4414;
	4436 [label="뭐 그러셔",shape=box,color=blue];
		4436 -> 4440;
	4441 [label="자비르에게 경사로 경비원을 족치라고 해!",shape=box,color=red];
		4441 -> 4444;
	4442 [label="제어판으로 문을 열어.",shape=box,color=red];
		4442 -> 4445;
	4439 [label="Chat ends.",color=orange];
	4440 [label="\"당신은 외칩니다. '자비르, 저 녀석 잡아!' 동시에 당신은 경사로 경비병을 가리킵니다.\"",shape=box,color=blue];
		4440 -> 4443;
	4444 [label="\"자비르는 경비원에게 달려가 전기 충격을 가합니다. 경비원은 힘없이 쓰러집니다.\"",shape=box,color=blue];
		4444 -> 4447;
	4445 [label="당신은 제어판 책상 쪽으로 몰래 다가가 최대한 몸을 숨긴 채 콘솔을 조작해보려고 합니다. 그리고 어떻게든 기능을 발동시켜 격납고 문을 여는 데 성공하는군요.\".",shape=box,color=blue];
		4445 -> 4448;
	4443 [label="\"이건 좀 아닌데 하는 본능적인 생각에도 불구하고, 자비르는 용감히 뛰어듭니다. 아무리 그라도 안 들키고 달려갈 정도로 빠르진 않은데도요. 경비병들은 발포하고, 자비르는 비극적인 죽음을 맞습니다.\"",shape=box,color=blue];
		4443 -> 4446;
	4447 [label="Update boolean RampGuardZapped",color=orange];
		4447 -> 4450;
	4448 [label="\"쥐 때문에 난리가 난 경비병들은 문이 열린 줄 눈치도 채지 못합니다.\"",shape=box,color=blue];
		4448 -> 4451;
	4446 [label="게임 오버야 친구",shape=box,color=blue];
