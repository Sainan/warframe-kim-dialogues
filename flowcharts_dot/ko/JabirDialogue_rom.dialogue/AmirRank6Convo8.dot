	4453 [label="여기서 끝내면 될 것 같은데. [종료.]",shape=box,color=red];
		4453 -> 4458;
	4459 [label="\"당신은 자비르를 바라보며, '네가 이걸 조종해 날 수 있는 방법을 알면 좋을텐데,' 라고 말하지만, 자비르는 '난 모르지, 하지만 넌 알잖아.' 하고 대답합니다.\"",shape=box,color=blue];
		4459 -> 4462;
	4460 [label="\"자비르는 경사로 경비병을 가리킵니다.\"",shape=box,color=blue];
		4460 -> 4441;
	4457 [label="Update boolean KeepZabirAlive",color=orange];
		4457 -> 4414;
	4458 [label="너 지금 나 죽였잖아",shape=box,color=blue];
		4458 -> 4461;
	4462 [label="\"당신이 함선에 동력을 공급하고 경사로를 올려 출입문을 닫는 버튼을 누르려는 순간, 자비르가 외칩니다. '잠깐! 저 녀석들을 그대로 두고 갈 순 없잖아.'\"",shape=box,color=blue];
		4462 -> 4463;
		4462 -> 4464;
