	j4162133219 [label="+5 Chemistry",color=orange];
		j4162133219 -> j3306665605;
	j3060972208 [label="+5 Chemistry",color=orange];
		j3060972208 -> j2963813882;
	j3306665605 [label="오... 준비 됐지 그럼",shape=box,color=blue];
		j3306665605 -> j3839478019;
	j2963813882 [label="뭐라 하긴 힘드네, 제법 멋진 친구인 건 사실이니까",shape=box,color=blue];
		j2963813882 -> j3839478019;
	j3839478019 [label="자 그럼 간다",shape=box,color=blue];
		j3839478019 -> j2451921389;
	j2451921389 [label="당신은 이제 풀려난 자비르와 함께 전기 실험실 한가운데에 서 있습니다. 그는 당신을 바라보며 말합니다. '낭비하고 있을 시간 없어. 따라와.'\"",shape=box,color=blue];
		j2451921389 -> j4213415613;
	j4213415613 [label="그는 끝없이 이어진 복도로 당신을 데려갑니다. 그는 이 소행성 기지를 손바닥 안처럼 훤히 꿰뚫고 있어, 경비병의 배치도 그들의 동선도 모르는 게 없군요.\"",shape=box,color=blue];
		j4213415613 -> j649068394;
		j4213415613 -> j1566079967;
		j4213415613 -> j1046338603;
	j649068394 [label="자비르에게 쥐들에 대해 물어볼래.",shape=box,color=red];
		j649068394 -> j2304138566;
	j1566079967 [label="자비르도 수감자야?",shape=box,color=red];
		j1566079967 -> j7662584;
	j1046338603 [label="자비르는 나를 어디로 데려가는 거야?",shape=box,color=red];
		j1046338603 -> j2034133038;
	j2304138566 [label="\"자비르는 놀란 표정입니다. '쥐들이 널 찾았다고? 멋진데. 통했잖아. 이거 좀 봐봐.' 자비르는 복잡한 돋을새김으로 장식된 금 호루라기를 들어 보입니다. '쥐의 여왕이 나한테 이걸 줬어. 이제 우린 그녀를 찾아야 해.'\"",shape=box,color=blue];
		j2304138566 -> j4157872105;
	j7662584 [label="\"당신은 자비르에게 어쩌다 여기 왔냐고 물어봅니다. '그 얘기 할 시간 없어.' 그는 말합니다. '지금은 여기서 빠져나가는 데에만 집중해야 해.'\"",shape=box,color=blue];
		j7662584 -> j649068394;
		j7662584 -> j1046338603;
	j2034133038 [label="\"자비르는 돌아보며 말합니다. '널 격납고 구역으로 데려가야지. 거기서 함선을 훔쳐서 최대한 멀리멀리 도망칠 거야. 쥐 여왕도 찾고.'\"",shape=box,color=blue];
		j2034133038 -> j4157872105;
	j4157872105 [label="쥐의 여왕?",shape=box,color=red];
		j4157872105 -> j1380523085;
	j1380523085 [label="\"'그녀가 내게 호루라기를 줬거든. 쥐들은 그 소리에 따라 움직여. 그녀는 내 친구야. 항상 좋은 친구는 아니지만, 그래도 신경을 써 주지.'\"",shape=box,color=blue];
		j1380523085 -> j2360795937;
		j1380523085 -> j3292306392;
	j2360795937 [label="혹시 이거 레티한테 한 번이라도 보여준 적 있어?",shape=box,color=red];
		j2360795937 -> j2224292964;
	j3292306392 [label="이것도 어딘가 익숙하게 들리네.",shape=box,color=red];
		j3292306392 -> j928101860;
	j2224292964 [label="나도 내 목숨이 아까워 위험하게 그걸 내놓을 수는 없다고",shape=box,color=blue];
		j2224292964 -> j3844507992;
	j928101860 [label="현실이든 상상이든 누구랑 닮았다면 전부 다 그냥 우연일 뿐이야",shape=box,color=blue];
		j928101860 -> j3844507992;
	j3844507992 [label="\"자비르의 도움으로 당신은 지그재그처럼 이어지는 소행성 기지의 복도를 나아갑니다. 곳곳의 경비병이나 보안 카메라도 그는 능숙하게 피해서 지나가는군요.\"",shape=box,color=blue];
		j3844507992 -> j757578140;
	j757578140 [label="\"마침내, 당신들은 커다란 문 앞에 다다릅니다. 자비르는 몸을 숙이라는 신호를 보내는군요. 당신과 자비르는 몸을 웅크린 채 몰래 함선의 격납고로 잠입합니다.\"",shape=box,color=blue];
		j757578140 -> j3337341887;
	j3337341887 [label="\"당신은 기둥 그림자 속에 웅크리고 숨어 있습니다. 근처의 그리니어 경비병들이 내는 소리가 들려옵니다.\"",shape=box,color=blue];
		j3337341887 -> j1957720318;
	j1957720318 [label="\"무엇을 하시겠습니까?\"",shape=box,color=blue];
		j1957720318 -> j4215318123;
		j1957720318 -> j3034138337;
	j4215318123 [label="경비병을 공격한다.",shape=box,color=red];
		j4215318123 -> j2758231534;
	j3034138337 [label="주변을 둘러볼래.",shape=box,color=red];
		j3034138337 -> j1090670285;
	j2758231534 [label="\"자기 보호 본능이나 뒷일 생각은 한 톨도 없이, 당신은 탁 트인 공간으로 달려나갑니다. 다른 쪽에 있던 한 무리의 경비병들이 욕설을 내뱉으며 총격을 퍼붓기 시작하는군요. 당신은 빗발치는 총알 속으로 저돌적으로 달려나가다 즉사합니다. 당신의 고집스런 용기가 불러온 정신나간 행위에 자비르는 절레절레 머리를 흔듭니다.\"",shape=box,color=blue];
		j2758231534 -> j795288441;
	j1090670285 [label="\"당신은 모퉁이를 돌아 구역을 살펴 봅니다.\"",shape=box,color=blue];
		j1090670285 -> j408852119;
	j795288441 [label="다시 한 번 시도해서 이번엔 즉사 루트를 피해 볼래?",shape=box,color=blue];
		j795288441 -> j1918342705;
		j795288441 -> j2041026852;
	j408852119 [label="\"격납고 중앙에 레일잭이 정박되어 있군요. 하지만 레일잭으로 올라가는 경사로는 경비병이 지키고 있습니다. 격납고 한 쪽에서는 십여 명의 그리니어들이 시끌벅적하게 주사위 놀이를 하느라 정신이 없습니다. 당신으로부터 몇 피트쯤 떨어진 곳에는 제어판이 설치된 책상이 있군요.\"",shape=box,color=blue];
		j408852119 -> j1515214852;
	j1918342705 [label="넵.",shape=box,color=red];
		j1918342705 -> j1430202917;
	j2041026852 [label="오늘은 이걸로 됐어. [종료.]",shape=box,color=red];
		j2041026852 -> "Chat ends.";
	j1515214852 [label="\"'여기서 나가려면, 격납고 구역 문을 먼저 열어야 해.' 자비르가 속삭입니다.\"",shape=box,color=blue];
		j1515214852 -> j3325710846;
	j1430202917 [label="\"이번엔 무엇을 하시겠습니까?\"",shape=box,color=blue];
		j1430202917 -> j148216709;
		j1430202917 -> j3034138337;
	j3325710846 [label="\"자비르는 당신을 바라봅니다. '뭐 좋은 방법 없어?'\"",shape=box,color=blue];
		j3325710846 -> j774369477;
		j3325710846 -> j3325710846;
	j148216709 [label="... 이 구역을 살펴본다던가?",shape=box,color=red];
		j148216709 -> j1090670285;
