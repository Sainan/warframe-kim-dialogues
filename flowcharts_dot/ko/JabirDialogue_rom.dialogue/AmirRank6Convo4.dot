	4205 [label="Chat ends.",color=orange];
	4206 [label="\"당신이 들어온 곳은 커다란 빈 방입니다. 무슨 지하 저장고인가보죠? 유일하게 눈길을 끄는 건 육중한 금속 문밖에 없네요.\"",shape=box,color=blue];
		4206 -> 4207;
