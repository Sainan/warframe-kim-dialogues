	j3783878007 [label="아니 이게 아니라...",shape=box,color=blue];
		j3783878007 -> j3583213601;
	j3583213601 [label="\"찍찍거리는 소리는 점점 커지며, 곧 발톱이 돌바닥에 짜각거리는 소리까지 들립니다. 갑자기 당신의 횃불 너머로 그림자가 드리워집니다. 고양이만한... 아니... 개만한 쥐 한마리가 당신에게로 달려듭니다.\"",shape=box,color=blue];
		j3583213601 -> j1049035356;
	j1049035356 [label="\"하지만 쥐는 한 마리가 아닙니다. 사방에서 몰려오고 있어요.\" .",shape=box,color=blue];
		j1049035356 -> j2432278246;
