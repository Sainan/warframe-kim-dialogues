		j1398306946 -> j1372476009;
	j107051245 [label="\"사방팔방에 핏자국이 튀어 있군요. 아무리 봐도, 이전에 탈출을 시도한 수감자들은 영... 비효율적인 방법을 시도한 모양입니다. 그러니 그들의 목숨을 건 시행착오를 보고 배운 당신은, 어떻게 해 나가야 할지 감을 잡습니다!\"",shape=box,color=blue];
