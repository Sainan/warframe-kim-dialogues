		j1499168881 -> j112368292;
	j3481008141 [label="\"당신 하는 짓이 지긋지긋해진 고대의 신이 벼락을 내렸습니다. 당신은 벼락에 맞았고, 죽었답니다. 끝.\"",shape=box,color=blue];
