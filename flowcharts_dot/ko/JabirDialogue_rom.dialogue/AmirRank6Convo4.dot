	j221085784 [label="Check boolean FlintTaken",color=orange];
		j221085784 -> j2278951529 [label=true,color=green];
		j221085784 -> j2057422382 [label=false,color=brown];
	j1093744908 [label="\"당신은 조심스레 감방을 빠져나옵니다. 오른쪽에는 출구로 향하는 커다란 문이 있군요. 문은 아주 살짝만 열려 있습니다. 문 너머에서 다른 그리니어 경비병들이 웅성거리는 소리를 듣습니다. 왼쪽으로는 지하 감옥 복도가 이어져 있지만, 너무 어두워서 그 너머에 뭐가 있는지는 보이지 않는군요.\"",shape=box,color=blue];
		j1093744908 -> j1405298677;
	j1211069330 [label="좋아",shape=box,color=blue];
		j1211069330 -> j4018090013;
	j2278951529 [label="\"당신은 다시 한 번 경비병의 시체를 뒤지지만 더 이상 쓸만한 걸 찾아내지는 못합니다. 당신은 잠시 곰팡이 핀 비스킷을 먹어 볼까 생각하다가, 비스킷의 악취를 맡고는 금세 다시 생각하기로 합니다.\"",shape=box,color=blue];
		j2278951529 -> j3451620922;
	j2057422382 [label="\"당신은 뭔가 쓸만한 것을 찾아 경비병의 시체를 더듬어 봅니다. 부싯돌 하나와 곰팡이 핀 비스킷 외에는 아무것도 없군요. 당신은 부싯돌을 챙깁니다.\"",shape=box,color=blue];
		j2057422382 -> j1791784368;
	j1405298677 [label="Check boolean TorchTaken",color=orange];
		j1405298677 -> j326321293 [label=true,color=green];
		j1405298677 -> j3790833630 [label=false,color=brown];
	j4018090013 [label="\"당신은 문을 닫고 도움의 손길을 기다리지만, 아무도 찾아오지 않습니다. 그 대신 경비병들이 들이닥치고, 완전 미친듯이 화내는군요, 왜냐면 걔네들 친구를 니가 죽이면 안 됐으니까. 그래서 걔네들은 너한테 온갖 끔찍하고 못된 짓을 막 해댑니다. 니가 완전 끔찍하고 의미 없이 죽을 때까지.\"",shape=box,color=blue];
