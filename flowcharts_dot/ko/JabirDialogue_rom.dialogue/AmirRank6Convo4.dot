		4114 -> 4117;
	4115 [label="\"당신은 감방 안, 당신이 방금 죽인 그리니어의 시체 앞에 서 있습니다. 당신의 머릿속에선 그가 죽어가면서 남긴, '넌 절대 로터스를 찾을 수 없을 거다.'라는 말이 자꾸 맴도는군요.\"",shape=box,color=blue];
