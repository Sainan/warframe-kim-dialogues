		4152 -> 4158;
	4153 [label="\"당신 하는 짓이 지긋지긋해진 고대의 신이 벼락을 내렸습니다. 당신은 벼락에 맞았고, 죽었답니다. 끝.\"",shape=box,color=blue];
		4153 -> 4159;
	4154 [label="Update boolean FlintLoop3",color=orange];
		4154 -> 4118;
	4156 [label="\"당신이 복도 끝으로 조심조심 나아가자, 횃불이 당신 앞에 있는 새깜깜하게 어두운 구덩이를 밝혀 주기 시작합니다. 당신은 저수조 앞에 서 있습니다. 아래를 내려다봐도 바닥이 보이지 않는군요. 횃불이 아니었다면 분명 떨어져 죽었을 겁니다.\"",shape=box,color=blue];
		4156 -> 4160;
	4155 [label="\"당신은 그대로 추락합니다. 철퍼덕 하고 터지는 소리와 함께 바닥에 충돌하기까지의 짧은 시간 동안, 당신이 할 수 있는 것이라곤 뭔가 불빛이라도 가져올걸, 하는 후회 뿐입니다.\"",shape=box,color=blue];
