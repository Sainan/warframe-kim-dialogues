		j2406208026 -> j2667741943;
	j4269030763 [label="\"쥐들은 당신을 둥글게 둘러쌉니다. 당신은 굳건히 써서 싸울 태세를 갖추고 있지만, 쥐들은 공격해오지 않는군요. 그 대신, 제일 커다란 녀석이 당신에게 고개를 숙여 절해옵니다. 녀석의 목에 목걸이가 걸려 있군요. 목걸이의 은 사슬이 풀려 땅으로 떨어집니다. 쥐는 당신을 바라보며, 마치 '당신의 것입니다.' 하고 말하는 듯 하군요.\"",shape=box,color=blue];
		j4269030763 -> j2858394649;
