		j812099110 -> j2432278246;
		j812099110 -> j433859969;
	j4244705777 [label="\"당신은 목걸이를 주워듭니다. 사슬에는 열쇠가 연결돼 있군요.\"",shape=box,color=blue];
		j4244705777 -> j318942415;
	j672221659 [label="\"쥐는 말을 하지 않습니다. 애초에, 쥐인걸요.\"",shape=box,color=blue];
		j672221659 -> j318942415;
	j318942415 [label="\"쥐들은 돌아서더니 재빨리 도망쳐 버립니다. 누구든간 열쇠를 준 사람은 당신이 여기 있을 줄 알고 있었겠군요. 그럴 수 있을 만한 사람은 단 한 사람밖에 없습니다... 로터스.\"",shape=box,color=blue];
		j318942415 -> j2422906084;
