		j2422906084 -> j349079678;
	j349079678 [label="\"당신은 열쇠를 문에 끼워 넣어 봅니다. 열리네요. 문 너머에서 밝은 빛이 쏟아져오는 통에, 당신은 고통스러울 정도로 눈을 가늘게 뜰 수밖에 없습니다. 그리곤 눈앞에 보이는 광경에 놀라움을 금치 못하는군요...\"",shape=box,color=blue];
