		4128 -> 4133 [label=true,color=green];
		4128 -> 4132 [label=false,color=brown];
	4129 [label="\"당신은 문을 닫고 도움의 손길을 기다리지만, 아무도 찾아오지 않습니다. 그 대신 경비병들이 들이닥치고, 완전 미친듯이 화내는군요, 왜냐면 걔네들 친구를 니가 죽이면 안 됐으니까. 그래서 걔네들은 너한테 온갖 끔찍하고 못된 짓을 막 해댑니다. 니가 완전 끔찍하고 의미 없이 죽을 때까지.\"",shape=box,color=blue];
