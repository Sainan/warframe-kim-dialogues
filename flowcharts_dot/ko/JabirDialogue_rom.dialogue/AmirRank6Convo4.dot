	4123 [label="Check boolean FlintTaken",color=orange];
		4123 -> 4126 [label=true,color=green];
		4123 -> 4127 [label=false,color=brown];
	4124 [label="\"당신은 조심스레 감방을 빠져나옵니다. 오른쪽에는 출구로 향하는 커다란 문이 있군요. 문은 아주 살짝만 열려 있습니다. 문 너머에서 다른 그리니어 경비병들이 웅성거리는 소리를 듣습니다. 왼쪽으로는 지하 감옥 복도가 이어져 있지만, 너무 어두워서 그 너머에 뭐가 있는지는 보이지 않는군요.\"",shape=box,color=blue];
		4124 -> 4128;
	4125 [label="좋아",shape=box,color=blue];
		4125 -> 4129;
	4126 [label="\"당신은 다시 한 번 경비병의 시체를 뒤지지만 더 이상 쓸만한 걸 찾아내지는 못합니다. 당신은 잠시 곰팡이 핀 비스킷을 먹어 볼까 생각하다가, 비스킷의 악취를 맡고는 금세 다시 생각하기로 합니다.\"",shape=box,color=blue];
		4126 -> 4130;
	4127 [label="\"당신은 뭔가 쓸만한 것을 찾아 경비병의 시체를 더듬어 봅니다. 부싯돌 하나와 곰팡이 핀 비스킷 외에는 아무것도 없군요. 당신은 부싯돌을 챙깁니다.\"",shape=box,color=blue];
		4127 -> 4131;
