		4168 -> 4174;
	4171 [label="\"당신은 판자 틈새 사이로 횃불을 비추려 해 봅니다. 갑자기 훅 부는 바람이 횃불의 불꽃을 깜빡거리게 만드는군요. 물방울이 떨어지는 소리가 들립니다.\"",shape=box,color=blue];
		4171 -> 4166;
	4172 [label="\"있는 힘을 다해 판자를 뜯어내자, 다 녹이 슬어 흔적만 좀 남은 철근이 드러납니다. 사이를 비집고 들어갈 만한 틈은 있군요. 그 너머로는 낮고, 좁은 터널이 보입니다.\"",shape=box,color=blue];
