		4214 -> 4215;
	4215 [label="\"찍찍거리는 소리는 점점 커지며, 곧 발톱이 돌바닥에 짜각거리는 소리까지 들립니다. 갑자기 당신의 횃불 너머로 그림자가 드리워집니다. 고양이만한... 아니... 개만한 쥐 한마리가 당신에게로 달려듭니다.\"",shape=box,color=blue];
		4215 -> 4216;
