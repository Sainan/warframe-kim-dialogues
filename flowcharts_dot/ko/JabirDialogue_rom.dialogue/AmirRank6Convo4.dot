		j716511180 -> j2789091935;
	j3573323230 [label="\"당신은 판자 틈새 사이로 횃불을 비추려 해 봅니다. 갑자기 훅 부는 바람이 횃불의 불꽃을 깜빡거리게 만드는군요. 물방울이 떨어지는 소리가 들립니다.\"",shape=box,color=blue];
