		j1175397331 -> j1499168881 [label=true,color=green];
		j1175397331 -> j3481008141 [label=false,color=brown];
	j3080761651 [label="\"당신의 의식 깊숙한 곳에서 자그마한 목소리가 들립니다. '야, 이 똥멍청아, 이번이 마지막 기회다. 뭘 아무리 용을 써 봐도 경비병 시체엔 더 이상 쓸만한 게 없다고. 헛짓거리 그만해.'\"",shape=box,color=blue];
		j3080761651 -> j3245937525;
	j496498856 [label="\"당신은 횃불을 손에 듭니다. 불꽃이 꺼지지 않기만을 빌면서요. 당신은 복도를 따라 내려갑니다. 지나치게 되는 빈 감방들은, 하나하나가 다 똑같이 황량하기만 하군요.\"",shape=box,color=blue];
		j496498856 -> j1728480409;
	j1545831665 [label="\"당신은 어둠 속으로 손을 더듬으며... 무언가를... 찾아 헤맵니다. 하지만 걸음을 내딛을 때마다 점점 더 길을 잃는 기분만 드는군요. 그러다 당신은 갑자기 바닥 끝 허공을 밟고 굴러 떨어집니다.\"",shape=box,color=blue];
		j1545831665 -> j2381548768;
	j21558127 [label="\"당신의 죽음은 빠르고 신속하지만, 고통이 아예 없을 정도로 빠르지는 않습니다. 아주 아픕니다. 많이요.\"",shape=box,color=blue];
		j21558127 -> j1376925595;
