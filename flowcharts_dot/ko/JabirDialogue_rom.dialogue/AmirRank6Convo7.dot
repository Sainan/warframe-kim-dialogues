	j970257374 [label="Boolean Zapped is now true.",color=orange];
		j970257374 -> j1571667540;
	j2214190091 [label="\"남자는 동그란 선글라스를 벗어 자기를 구해 준 은인을 한 번 길게 쳐다봅니다.\"",shape=box,color=blue];
		j2214190091 -> j1792490068;
	j2118413920 [label="\"그의 시선은 강렬하군요.\"",shape=box,color=blue];
		j2118413920 -> j3295058743;
	j1649764695 [label="동그란 선글라스라. 그 남자 이름이 뭔데?",shape=box,color=red];
		j1649764695 -> j3797134806;
	j1792490068 [label="어 아니다 그러니까",shape=box,color=blue];
		j1792490068 -> j1915875832;
	j3295058743 [label="\"그의 강인한 손, 두툼한 팔뚝, 그리고 탄탄한 다리가 눈에 띕니다. '스피드에 아주 타고난 몸이네' 하고, 당신은 눈썹을 치켜올리며 생각합니다.\"",shape=box,color=blue];
		j3295058743 -> j2094616245;
	j3797134806 [label="\"내 이름은 자비르야. 그는 자신만만하게 대답합니다.\"",shape=box,color=blue];
		j3797134806 -> j1165203621;
	j1915875832 [label="\"남자는 동그란 선글라스를 벗어 자기를 구해 주려 한 사람을 한 번 길게 쳐다봅니다.\"",shape=box,color=blue];
		j1915875832 -> j3499241272;
	j2094616245 [label="거기 진정 좀 하라고 아자씨. 그래서 이 잘생긴 남자 이름은 뭔데?",shape=box,color=red];
		j2094616245 -> j3797134806;
	j1165203621 [label="어째 익숙하게 들리는 이름인데. 여기서 무슨 짓을 당하고 있었던 거야?",shape=box,color=red];
		j1165203621 -> j949594020;
	j949594020 [label="\"'내 에너지를 뽑아먹히고 있었지. 내가 좀 많이 짜릿짜릿하거든. 뭐, 이미 눈치챘겠지만.' 자비르가 말합니다.\"",shape=box,color=blue];
		j949594020 -> j2103388479;
	j2103388479 [label="좋아, 자비르. 로터스는 어떻게 구하지?",shape=box,color=red];
		j2103388479 -> j1730338567;
	j1730338567 [label="자비르는 놀란 것 같군요. \"로터스를 구해? 날 이렇게 처박아 둔 게 로터스야! 우린 얼른 이 소행성을 빠져나가야 한다고!\"",shape=box,color=blue];
