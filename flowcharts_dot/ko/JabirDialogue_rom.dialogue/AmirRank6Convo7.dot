		4308 -> 4314;
	4309 [label="\"아무래도 이건 다시 건드리지 않는 게 좋을 것 같죠.\"",shape=box,color=blue];
		4309 -> 4295;
		4309 -> 4296;
	4310 [label="\"당신은 제어판을 사용해 보려고 하지만, 당신조차 해킹할 수 없는 보안 프로토콜로 잠겨 있습니다. 이건 좀 더 수동에 가까운 방법으로 해결해야겠단 생각이 듭니다.\"",shape=box,color=blue];
		4310 -> 4295;
		4310 -> 4296;
	4311 [label="전선을 잘라내.",shape=box,color=red];
		4311 -> 4315;
	4312 [label="Update boolean ControlPanel",color=orange];
		4312 -> 4316;
	4313 [label="\"당신은 있는 힘껏 쇠지렛대를 터빈 속으로 던져버립니다. 부품들과 피스톤이 갈려나가는 거대한 소음이 방을 채우는군요. 그와 동시의 터빈의 회전이 천천히 멎어들어갑니다.\"",shape=box,color=blue];
		4313 -> 4317;
	4314 [label="그으으으으러니까 여기선 그냥 스킵좀 하자",shape=box,color=blue];
		4314 -> 4318;
	4315 [label="Check boolean TurbineStopped",color=orange];
		4315 -> 4319 [label=true,color=green];
		4315 -> 4320 [label=false,color=brown];
	4316 [label="Check boolean PanelSmashed",color=orange];
		4316 -> 4321 [label=true,color=green];
		4316 -> 4322 [label=false,color=brown];
	4317 [label="\"남자는 안심한 나머지 어깨를 떨굽니다. 이제 나 좀 꺼내줘.\"",shape=box,color=blue];
		4317 -> 4323;
	4318 [label="엣헴",shape=box,color=blue];
		4318 -> 4324;
	4319 [label="\"전선 절단기를 쓰자 남자에게 연결된 케이블이 간단히 잘려나갑니다. 팔이 자유롭게 풀려난 남자는 이제 스스로 구속구를 풀어낼 수 있게 됐군요.\"",shape=box,color=blue];
		4319 -> 4325;
	4320 [label="\"당신은 절단기의 칼날을 전류가 흐르는 전선에 갖다 대지만, 곧바로 후회합니다. 전선에 흐르는 전류가 절단기를 타고 당신의 몸으로도 흐르더니, 당신을 금세 튕겨냅니다.\"",shape=box,color=blue];
		4320 -> 4326;
	4321 [label="\"저번에 해봤지만 잘 안 됐죠.\"",shape=box,color=blue];
		4321 -> 4307;
		4321 -> 4306;
	4322 [label="\"당신이 제어판을 부수자, 묶여 있는 남자는 당신에게 대고 비명을 지르는 것 같습니다. 당신이 한 짓이 영 좋지 않았던 것 같군요.\"",shape=box,color=blue];
		4322 -> 4327;
	4323 [label="Update boolean TurbineStopped",color=orange];
		4323 -> 4311;
	4324 [label="어흠흠",shape=box,color=blue];
		4324 -> 4328;
	4325 [label="\"남자는 동그란 선글라스를 벗어 자기를 구해 준 은인을 한 번 길게 쳐다봅니다.\"",shape=box,color=blue];
		4325 -> 4329;
	4326 [label="\"당신은 바닥에 쓰러집니다. 남자는 아직도 고통에 시달리고 있고, 당신의 머리카락은 이제 쭈뼛 서 있군요.\"",shape=box,color=blue];
		4326 -> 4330;
	4327 [label="Update boolean PanelSmashed",color=orange];
		4327 -> 4307;
		4327 -> 4306;
	4328 [label="\"기적인지 뭔지, 어떻게 된 건지 몰라도, 남자의 순수하게 강력한 힘으로 터빈이 폭발했습니다!\"",shape=box,color=blue];
		4328 -> 4331;
