		j995680227 -> j1829366757 [label=false,color=brown];
	j572503223 [label="Check boolean PanelSmashed",color=orange];
		j572503223 -> j3636343838 [label=true,color=green];
		j572503223 -> j3787753686 [label=false,color=brown];
	j4160457788 [label="\"남자는 안심한 나머지 어깨를 떨굽니다. 이제 나 좀 꺼내줘.\"",shape=box,color=blue];
		j4160457788 -> j693948477;
	j986193940 [label="엣헴",shape=box,color=blue];
		j986193940 -> j27395476;
	j2933983322 [label="\"전선 절단기를 쓰자 남자에게 연결된 케이블이 간단히 잘려나갑니다. 팔이 자유롭게 풀려난 남자는 이제 스스로 구속구를 풀어낼 수 있게 됐군요.\"",shape=box,color=blue];
		j2933983322 -> j2527641545;
	j1829366757 [label="\"당신은 절단기의 칼날을 전류가 흐르는 전선에 갖다 대지만, 곧바로 후회합니다. 전선에 흐르는 전류가 절단기를 타고 당신의 몸으로도 흐르더니, 당신을 금세 튕겨냅니다.\"",shape=box,color=blue];
		j1829366757 -> j3161189958;
	j3636343838 [label="\"저번에 해봤지만 잘 안 됐죠.\"",shape=box,color=blue];
		j3636343838 -> j918147750;
		j3636343838 -> j2538253078;
	j3787753686 [label="\"당신이 제어판을 부수자, 묶여 있는 남자는 당신에게 대고 비명을 지르는 것 같습니다. 당신이 한 짓이 영 좋지 않았던 것 같군요.\"",shape=box,color=blue];
		j3787753686 -> j1502386489;
	j693948477 [label="Boolean TurbineStopped is now true.",color=orange];
		j693948477 -> j947175151;
	j27395476 [label="어흠흠",shape=box,color=blue];
		j27395476 -> j2800054437;
	j2527641545 [label="\"남자는 동그란 선글라스를 벗어 자기를 구해 준 은인을 한 번 길게 쳐다봅니다.\"",shape=box,color=blue];
		j2527641545 -> j3499241272;
	j3161189958 [label="\"당신은 바닥에 쓰러집니다. 남자는 아직도 고통에 시달리고 있고, 당신의 머리카락은 이제 쭈뼛 서 있군요.\"",shape=box,color=blue];
		j3161189958 -> j970257374;
