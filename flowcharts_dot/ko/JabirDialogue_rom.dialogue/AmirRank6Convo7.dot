		j3235722505 -> j1042264811;
	j747774463 [label="\"당신은 크고 무거운 쇠지렛대를 집어듭니다. 튼튼한 도구로군요. 먹먹하게 들려 오는 남자의 비명소리가 점점 더 커져 갑니다.\"",shape=box,color=blue];
