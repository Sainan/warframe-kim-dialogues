		4300 -> 4304;
	4301 [label="\"당신은 크고 무거운 쇠지렛대를 집어듭니다. 튼튼한 도구로군요. 먹먹하게 들려 오는 남자의 비명소리가 점점 더 커져 갑니다.\"",shape=box,color=blue];
		4301 -> 4305;
		4301 -> 4306;
		4301 -> 4307;
	4302 [label="나 나 손목터널증후군같은거 오기 전에 여기서 너 좀 멈춰야겠다",shape=box,color=blue];
