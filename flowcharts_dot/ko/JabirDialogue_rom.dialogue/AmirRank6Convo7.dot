		j1502386489 -> j918147750;
		j1502386489 -> j2538253078;
	j2800054437 [label="\"기적인지 뭔지, 어떻게 된 건지 몰라도, 남자의 순수하게 강력한 힘으로 터빈이 폭발했습니다!\"",shape=box,color=blue];
		j2800054437 -> j2214190091;
