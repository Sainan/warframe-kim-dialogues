		4329 -> 4332 [label=true,color=green];
		4329 -> 4333 [label=false,color=brown];
	4330 [label="Update boolean Zapped",color=orange];
		4330 -> 4286;
	4331 [label="\"남자는 동그란 선글라스를 벗어 자기를 구해 준 은인을 한 번 길게 쳐다봅니다.\"",shape=box,color=blue];
		4331 -> 4334;
	4332 [label="\"그의 시선은 강렬하군요.\"",shape=box,color=blue];
		4332 -> 4335;
	4333 [label="동그란 선글라스라. 그 남자 이름이 뭔데?",shape=box,color=red];
		4333 -> 4336;
	4334 [label="어 아니다 그러니까",shape=box,color=blue];
		4334 -> 4337;
	4335 [label="\"그의 강인한 손, 두툼한 팔뚝, 그리고 탄탄한 다리가 눈에 띕니다. '스피드에 아주 타고난 몸이네' 하고, 당신은 눈썹을 치켜올리며 생각합니다.\"",shape=box,color=blue];
		4335 -> 4338;
	4336 [label="\"내 이름은 자비르야. 그는 자신만만하게 대답합니다.\"",shape=box,color=blue];
		4336 -> 4339;
	4337 [label="\"남자는 동그란 선글라스를 벗어 자기를 구해 주려 한 사람을 한 번 길게 쳐다봅니다.\"",shape=box,color=blue];
		4337 -> 4329;
	4338 [label="거기 진정 좀 하라고 아자씨. 그래서 이 잘생긴 남자 이름은 뭔데?",shape=box,color=red];
		4338 -> 4336;
	4339 [label="어째 익숙하게 들리는 이름인데. 여기서 무슨 짓을 당하고 있었던 거야?",shape=box,color=red];
		4339 -> 4340;
	4340 [label="\"'내 에너지를 뽑아먹히고 있었지. 내가 좀 많이 짜릿짜릿하거든. 뭐, 이미 눈치챘겠지만.' 자비르가 말합니다.\"",shape=box,color=blue];
		4340 -> 4341;
	4341 [label="좋아, 자비르. 로터스는 어떻게 구하지?",shape=box,color=red];
		4341 -> 4342;
	4342 [label="자비르는 놀란 것 같군요. \"로터스를 구해? 날 이렇게 처박아 둔 게 로터스야! 우린 얼른 이 소행성을 빠져나가야 한다고!\"",shape=box,color=blue];
		4342 -> 4343;
		4342 -> 4344;
