		4303 -> 4310 [label=false,color=brown];
	4304 [label="\"산업용 강도로 보이는 이 절단기는 그 어떤 것이라도 자르고 들어갈 수 있을 것 같군요.\"",shape=box,color=blue];
		4304 -> 4311;
