	j1080426739 [label="나중에 할 거지? 그렇다고 믿는다",shape=box,color=blue];
		j1080426739 -> "Chat ends.";
	j1553737349 [label="\"놀랍도록 다정한 쥐 무리에게서 받은 열쇠를 꽂고 돌리며, 당신은 문 너머에 펼쳐진 것이 뭐든 등 뒤에 있을 지하 감옥보단 낫기를 기도합니다.\"",shape=box,color=blue];
		j1553737349 -> j2101623201;
	"Chat ends. Next chat will be AmirRank6Convo3." [color=orange];
	"Chat ends. Next chat will be AmirRank6Convo2." [color=orange];
	j2101623201 [label="\"문을 통과하자 당신은 커다란 서비스 엘리베이터 앞에 있습니다. 이거 그냥 지하 감옥 아니었나요?\"",shape=box,color=blue];
		j2101623201 -> j4166456145;
		j2101623201 -> j2029226451;
	j4166456145 [label="지하 감옥으로 돌아갈래.",shape=box,color=red];
		j4166456145 -> j2855164576;
	j2029226451 [label="엘리베이터에 탈래.",shape=box,color=red];
		j2029226451 -> j463273005;
	j2855164576 [label="\"당신은 뒤를 돌아 지하 감옥 쪽을 바라봅니다만, 곧바로 '저길 돌아가다니 멍청한 생각이야' 하는 생각이 듭니다.\"",shape=box,color=blue];
		j2855164576 -> j1943855483;
	j463273005 [label="\"당신은 엘리베이터를 타고 위로 올라갑니다. 개방된 창살 사이로 당신은 지하 감옥의 석재 벽이 점점 더 진보된 기술로 대체되어가는 광경을 볼 수 있습니다. 다시 한번 당신은 생각합니다. '도대체 난 어디에 있는 거야?'\"",shape=box,color=blue];
		j463273005 -> j1215256673;
	j1943855483 [label="하하... 그래, 엘리베이터 타지 뭐.",shape=box,color=red];
		j1943855483 -> j463273005;
	j1215256673 [label="\"엘리베이터가 다다른 곳은 덜덜거리는 기계, 그리고 거대한 튜브들이 늘어선 복도로군요. 무슨 연구실인 걸까요?\"",shape=box,color=blue];
		j1215256673 -> j1654827790;
	j1654827790 [label="\"복도 끝에 있는 방 쪽에서, 당신은 한 남자가 고통에 겨워 울부짖는 소리를 듣습니다.\"",shape=box,color=blue];
		j1654827790 -> j480406324;
		j1654827790 -> j1415205930;
	j480406324 [label="울부짖는 소리는 무시하고, 나갈 길을 찾을래.",shape=box,color=red];
		j480406324 -> j1785236982;
	j1415205930 [label="울부짖는 남자에게로 가 볼래.",shape=box,color=red];
		j1415205930 -> j2986674424;
	j1785236982 [label="\"당신은 복도 여기저기서 쓸만한 걸 찾으려고 해 보지만, 울부짖는 소리는 점점 무시할 수 없을 정도로 커져 갑니다. 당신은 이 남자에게 이끌려, 어떻게든 도와주고 싶다는 마음이 듭니다.\"",shape=box,color=blue];
		j1785236982 -> j2986674424;
	j2986674424 [label="\"당신은 이 고통에 찬 비명의 근원지를 찾아 복도를 가로질러 갑니다. 그렇게 들어간 거대한 기계실에서, 당신은 남자 한 명을 발견하는군요. 썩 나쁘지 않은 매력의 외형을 한 남자는 기계에 묶여 있습니다. 그의 손끝에서 뿜어져나오는 전기 볼트가 커다란 터빈에 동력을 공급하고 있습니다.\"",shape=box,color=blue];
		j2986674424 -> j2367284433;
		j2986674424 -> j765587316;
	j2367284433 [label="물어봐. \"무슨 일이야?\" 하고.",shape=box,color=red];
		j2367284433 -> j3326525261;
	j765587316 [label="남자를 살펴봐.",shape=box,color=red];
		j765587316 -> j3326525261;
	j3326525261 [label="\"남자는 높은 플랫폼에 팔을 쭉 뻗은 채 묶여 있는 상태입니다. 그의 손끝에는 서로 꼬여 굵은 케이블을 이루는 탐침이 연결되어 있으며, 그 케이블은 거대한 터빈으로 이어져 있군요. 남자의 손에선 전기 스파크가 빠르게 뿜어져 나오고 있습니다.\"",shape=box,color=blue];
		j3326525261 -> j568229566;
	j568229566 [label="비명과 빠직빠직하는 소리 사이에서 남자는 겨우겨우 소리칩니다. \"터빈... 좀... 멈춰줘!!\"",shape=box,color=blue];
		j568229566 -> j1499820469;
	j1499820469 [label="기계실을 확인해 볼래.",shape=box,color=red];
		j1499820469 -> j2987138607;
	j2987138607 [label="\"당신은 뭔가 쓸만한 것을 찾아 방을 뒤집니다. 공구들이 늘어선 벤치가 눈에 띄는군요. 쇠지렛대. 커다란 전선 절단기. 제어판이 있습니다.\"",shape=box,color=blue];
		j2987138607 -> j1571667540;
