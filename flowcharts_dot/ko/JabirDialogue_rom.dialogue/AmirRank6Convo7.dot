		j801762922 -> j1110728012;
	j2538253078 [label="쇠지렛대를 터빈 날개로 던질래.",shape=box,color=red];
		j2538253078 -> j922937066;
	j918147750 [label="계속 주변을 둘러볼래.",shape=box,color=red];
		j918147750 -> j1571667540;
	j2993344252 [label="이건 의도적인 어뷰징이던지 아님 니가 지이이이이인짜 못하는거야",shape=box,color=blue];
		j2993344252 -> j542842892;
	j1248340205 [label="\"아무래도 이건 다시 건드리지 않는 게 좋을 것 같죠.\"",shape=box,color=blue];
		j1248340205 -> j322823595;
		j1248340205 -> j3881144224;
	j1468313092 [label="\"당신은 제어판을 사용해 보려고 하지만, 당신조차 해킹할 수 없는 보안 프로토콜로 잠겨 있습니다. 이건 좀 더 수동에 가까운 방법으로 해결해야겠단 생각이 듭니다.\"",shape=box,color=blue];
		j1468313092 -> j322823595;
		j1468313092 -> j3881144224;
	j947175151 [label="전선을 잘라내.",shape=box,color=red];
		j947175151 -> j995680227;
	j1110728012 [label="Boolean ControlPanel is now true.",color=orange];
		j1110728012 -> j572503223;
	j922937066 [label="\"당신은 있는 힘껏 쇠지렛대를 터빈 속으로 던져버립니다. 부품들과 피스톤이 갈려나가는 거대한 소음이 방을 채우는군요. 그와 동시의 터빈의 회전이 천천히 멎어들어갑니다.\"",shape=box,color=blue];
		j922937066 -> j4160457788;
	j542842892 [label="그으으으으러니까 여기선 그냥 스킵좀 하자",shape=box,color=blue];
		j542842892 -> j986193940;
