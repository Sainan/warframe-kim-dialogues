	4511 [label="Update boolean AmirConsentComplete",color=orange];
		4511 -> 4513;
	4514 [label="너랑 중요한 이야기를 하고 싶은데, 상황이 너무 심각해지기 전에 괜찮은지 확인하고 싶어.",shape=box,color=red];
		4514 -> 4515;
	4513 [label="Chat ends.",color=orange];
	4515 [label="우리가 이전에 이 얘기해 본 적 없는 주제란 거 알아. 중요한 점은 내가 너에게 거짓말을 하거나 어떤 식으로든 정직하지 않게 대하는 것처럼 느껴지지 않도록 하는 거야.",shape=box,color=red];
		4515 -> 4516;
	4516 [label="어어어어뭐가일어나고있는건데뭔일인데누구죽였어누가죽었어아니면잠깐그것보다더이상한일이야그것보다더이상한거지너도기타랑사귀는거지오루아시여",shape=box,color=blue];
		4516 -> 4517;
		4516 -> 4518;
	4517 [label="이상하게 들릴 수도 있겠지만 - 그렇다고 해서 너한테 덜 끌린다는 뜻은 아니야.",shape=box,color=red];
		4517 -> 4519;
	4518 [label="뭐, 적어도 기타 때문은 아니니까...? 있잖아. 이상하게 들릴 수도 있겠지만 - 그렇다고 해서 너한테 덜 끌린다는 뜻은 아니야.",shape=box,color=red];
		4518 -> 4520;
	4519 [label="미안뇌가아직네가기타와의잠재적교제를한다는점에걸려있어잠깐리부팅좀할게",shape=box,color=blue];
		4519 -> 4521;
	4520 [label="+5 Chemistry",color=orange];
		4520 -> 4519;
	4521 [label="그으으으으리이이이이이고오오오 다시 돌아왔어. 미안 뭐에 대해서 말할려고 한거야?",shape=box,color=blue];
		4521 -> 4522;
	4522 [label="너... 어딘가에 다른 짝이 있는 거지? 아니면... 언제? 그 존재가... 헥스는 아니...겠지? ....... 아아아으아아아어아악 그거 너무 이상할 것 같아아아아",shape=box,color=blue];
		4522 -> 4523;
	4523 [label="그거 완전 네가 내 사촌 레이라랑 사귀는 것 같단 말이야 토나와토나와토나와토나와토나와토나와토나와",shape=box,color=blue];
		4523 -> 4525;
		4523 -> 4524;
	4525 [label="아니, 헥스도 아니고, 기타도 아니야. 네 사촌도 아니고. ",shape=box,color=red];
		4525 -> 4527;
	4524 [label="너한테 사촌이 있는지도 몰랐어.",shape=box,color=red];
		4524 -> 4526;
	4527 [label="OK 그럼 다른 사람이랑 관계를 맺고 있다 이 말이야?!?!?!",shape=box,color=blue];
		4527 -> 4528;
	4526 [label="그래, 우리는 가족에 대해서 별로 이야기하지 않은 것 같네 우린 따로 얘기할 게 너무 많으니까!! 예를 들자면, 다른 사람이랑 관계를 맺고 있다 이 말이야?!?!?!",shape=box,color=blue];
		4526 -> 4528;
	4528 [label="불편하게 느끼는 거 이해해. 그리고 그렇다고 해서 너한테 덜 끌린다는 뜻이 아니란 걸 알아줬으면 좋겠어.",shape=box,color=red];
		4528 -> 4529;
	4529 [label="상대 쪽은 여기 사람이 아니고, 어떻게 소개해 줄 수 있을지도 모르겠지만…. 그쪽도 나한테 소중해, 너도 마찬가지고.",shape=box,color=red];
		4529 -> 4530;
	4530 [label="그냥 받아들이기 힘들 수도 있다는 거 알아. 그리고 이 상황을 받아들이지 못한다면, 충분히 이해하고 받아들일테니까. 다만 거짓말을 하거나 뭔가를 숨기고 있다고 생각하게 만들고 싶지 않았어.",shape=box,color=red];
		4530 -> 4531;
