		4537 -> 4538 [label="false",color=purple];
	4539 [label="하지만 진지하게 말하자면? 난...진심으로 널 믿어. 넌 나에게 중요해 그리고 진실을 말해줘서 기뻐. 만약 이 일에 대해서 거짓말을 했다면, 상황이 많이 달라졌을 거야, 알지?",shape=box,color=blue];
		4539 -> 4540;
	4538 [label="하지만 진지하게 말하자면? 난... 이 관계가 이리 흘러가도 괜찮아. 널 믿을게. 진실을 말해줘서 기뻐. 만약 이 일에 대해서 거짓말을 했다면, 상황이 많이 달라졌을 거야, 알지?",shape=box,color=blue];
