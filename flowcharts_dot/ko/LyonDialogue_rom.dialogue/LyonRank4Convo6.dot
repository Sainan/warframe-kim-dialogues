		j3720775547 -> j1701645841;
	j1097401880 [label="리온, 네가 왜 그런 - 음... 그... 왜 스스로를 다치게 하는지에 대해 괜찮다면 얘기해 줄 수 있어?",shape=box,color=red];
		j1097401880 -> j139097740;
