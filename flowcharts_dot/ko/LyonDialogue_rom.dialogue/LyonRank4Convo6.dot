		1262 -> 1265;
	1263 [label="그 점에 대해서 그대와 논쟁할 이유는 없소. 난 종교 의식의 차이에 매료되어 있으니. 종교 의식에 대한 모든 기록을 연구하는 것을 매우 좋아한다오.",shape=box,color=blue];
		1263 -> 1266;
