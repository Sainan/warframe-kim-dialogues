		1186 -> 1192;
	1183 [label="[자해 관련 대화를 비활성화합니다. 비활성화해도 리온이나 다른 캐릭터와의 케미스트리에는 아무런 영향이 없습니다.]",shape=box,color=red];
		1183 -> 1189;
