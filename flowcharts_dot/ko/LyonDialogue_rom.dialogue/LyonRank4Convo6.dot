	1208 [label="Update boolean DrifterHarmStop",color=orange];
		1208 -> 1214;
	1215 [label="아니, 그렇지 않은 것 같소만. 날 괴롭히던 환상들을 머릿속에서 지워야 했던 필요성이... 이 혈청의 \"선물\"을 발휘해야 하는 필요성으로 바뀌었소.",shape=box,color=blue];
		1215 -> 1221;
	1211 [label="그러므로, 이런 상황에서... 전투 준비가 안된 군인으로서 대처할 게 아니라 숲 속에 있는 사슴처럼 아무것도 모르는 상태에서 화살을 맞을 수 있다는 걸 나도 잘 알고 있소.",shape=box,color=blue];
		1211 -> 1216;
	1212 [label="오, 친구여... 그대가 겪은 일에 대해 내 공감을 적절히 표현할 수 있는 단어가 없소.",shape=box,color=blue];
		1212 -> 1217;
	1213 [label="Check boolean LyonAllRight",color=orange];
		1213 -> 1219 [label=true,color=green];
		1213 -> 1218 [label=false,color=brown];
	1214 [label="나의 이 특이한 강박관념을 끝내기에는 몇년이 흐른다한들 프로토프레임 혈청을 한 대 더 맞는다한들 너무 늦었다고 생각하오. 사실, 이제는 더 이상 참을 수 없는 행동이 된 것 같지 않소?",shape=box,color=blue];
		1214 -> 1220;
	1221 [label="+5 Chemistry",color=orange];
		1221 -> 1226;
	1216 [label="그렇기에, 난 그대에게 다음과 같은 말을 남기고자 하오:",shape=box,color=blue];
		1216 -> 1222;
	1217 [label="이런 순간들이 찾아오게 되면 언어는 하찮게 보이오. 우린 그 순간들을 최대한 활용하려고 안간힘을 쓰나, 언제나 실패하는 듯 하오.",shape=box,color=blue];
		1217 -> 1223;
	1219 [label="\"괜찮아\"라는 개념에 스스로 접근하는 걸 깨닫고 다시 한번 웃지 않으려고 노력하고 있소. 하지만, 그 감정에는 정말로 공감하는 바요, 드리프터.",shape=box,color=blue];
		1219 -> 1224;
	1218 [label="\"괜찮아\"라는 개념에 스스로 접근하는 걸 깨닫고 웃지 않으려고 노력하고 있소. 하지만, 그 감정에는 정말로 공감하는 바요, 드리프터.",shape=box,color=blue];
		1218 -> 1224;
	1220 [label="+5 Chemistry",color=orange];
		1220 -> 1225;
	1226 [label="혈청을 투약하기 전에도 자해 충동을 치료할 수 있는 능력이 있었다면, \"해로우\" 워프레임과 합쳐진 지금은 그 능력이 거의 불가능해졌다고 생각하오.",shape=box,color=blue];
		1226 -> 1231;
	1222 [label="일어설 의지를 찾을 수 없을 때조차도, 다른 이를 일으켜 세울 수 있는 힘을 찾는 방법을 스스로에게 상기시켜야 하오.",shape=box,color=blue];
		1222 -> 1227;
	1223 [label="그대의 고해를 바탕으로, 내가 할 수 있는 일이 세 가지 있소.",shape=box,color=blue];
		1223 -> 1228;
	1224 [label="+5 Chemistry",color=orange];
		1224 -> 1229;
		1224 -> 1230;
	1225 [label="하지만 내 신체적, 정신적 건강에 대한 걱정의 표현이라고 해서 그리 가볍게 말할 생각은 없소. 양해 부탁드리오. 단지 내가 그걸 멈출 수 있다고 생각이 들지 않을 뿐.",shape=box,color=blue];
		1225 -> 1229;
		1225 -> 1230;
	1231 [label="좀 무례하게 말해도 되오, 드리프터? 난 더 이상 그런 식으로 내 자신에게 영구적인 해를 끼칠 수 없을 것 같소.",shape=box,color=blue];
		1231 -> 1235;
	1227 [label="그게 바로 이야기의 진정한 목적이오.",shape=box,color=blue];
		1227 -> 1232;
	1228 [label="첫째; 난 아무런 위험에 처하지 않았다고 단호히 말할 수 있소. 만약 스스로 자해하려는 욕망을 부추기는 깊고 끔찍한 자기혐오가 있다고 생각한다면, 기꺼이 그 두려움을 없애드리겠소.",shape=box,color=blue];
		1228 -> 1233;
	1229 [label="왜 그런 행동을 하는지 이유를 물어도 될까?",shape=box,color=red];
		1229 -> 1234;
	1230 [label="그냥 당신이 너무 멀리 가버릴까봐 걱정되서 그래.",shape=box,color=red];
		1230 -> 1231;
	1235 [label="스스로가 불변하다고 생각할 만큼 오만하진 않으나, 그런 행동은... 어떻게 말해야 하나... 설계의 일부인 것 같소.",shape=box,color=blue];
		1235 -> 1241;
	1232 [label="+20 Chemistry",color=orange];
		1232 -> 1236;
	1233 [label="그 깊은 우울함을 이해하지만, 향로를 사용하고 싶은 마음은 전혀 들지 않소. (게다가 마리는 절대 허락하지 않을 것이니. 다시는 향로에 가까이 가지 못하게 하는 것보다는 차라리 그 우울함을 달래줄 것이오.)",shape=box,color=blue];
		1233 -> 1237;
	1234 [label="Evaluate expressions",color=orange];
		1234 -> 1240 [label="LyonBackstory3a, LyonLecture2",color=purple];
		1234 -> 1240 [label="LyonBackstory3b, LyonLecture2",color=purple];
		1234 -> 1239 [label="LyonBackstory3a",color=purple];
		1234 -> 1239 [label="LyonBackstory3b",color=purple];
		1234 -> 1238 [label="false",color=purple];
	1241 [label="+5 Chemistry",color=orange];
		1241 -> 1246;
	1236 [label="잘 지내시오, 드리프터. 후에 마저 이야기 나누길.",shape=box,color=blue];
		1236 -> 1242;
	1237 [label="하지만 그리 깊은 고통이 밤중에 내게 속삭인 적은 없었소, 내 친구여. 이걸로 그대에게 맹세할 수 있소. 이 점을, 내가 소중히 여기는 모든 것에 걸고 맹세하오.",shape=box,color=blue];
		1237 -> 1243;
	1240 [label="난 내가 행동하도록 영감을 주는 진실에 대해 말해드렸소 - 고통이 날 괴롭히는 환상들을 마음속에서 씻어준다는 점을. 그리고 루아의 형제들 사이에서는 이 관행이 그대의 문화권에서 부끄러워하는 것처럼 그렇게 부끄럽지 않는다는 것을. 내가 소중히 여기는 모든 것에 맹세코, 어떤 비밀도 숨기지 않을 것이오.",shape=box,color=blue];
		1240 -> 1245;
	1239 [label="그건 복잡한 주제요. 내 살을 찢는 이유가 단 하나만 있는 게 아니니까. 날 괴롭히는 환상에 대해 말했고, 그 고통이 내 정신을 맑게 해준다는 것도 말해드렸소. 하지만 그 행위 자체는 그대가 생각하는 것만큼 금기시되는 게 아니오.",shape=box,color=blue];
		1239 -> 1244;
	1238 [label="그건 복잡한 주제요. 내 살을 찢는 이유가 단 하나만 있는 게 아니니까. 하지만 요즘 시대에 이 문제가 그대가 생각하는 것만큼 금기시되는 건 아니라는 점을 먼저 말해주고 싶구려.",shape=box,color=blue];
		1238 -> 1244;
	1246 [label="내가 자행하는 행동이 \"옳다\"고는 생각치 않소. 내가 하는 행동을 다른 이들이 따라 해야 한다고도 생각치 않소. 내가 하는 행동이 부러워할 만한 일이라고 생각치도 않소.",shape=box,color=blue];
		1246 -> 1251;
	1242 [label="-리온 알라드 신부",shape=box,color=blue];
		1242 -> 1247;
	1243 [label="둘째; 이 글을 내게 보내준 그대의 용기에 찬사를 보내오. 차라리 피하는 편이 더 쉬웠을 텐데, 그대는 그러지 않았지.",shape=box,color=blue];
		1243 -> 1248;
	1245 [label="만약 스스로 자해하려는 욕망을 부추기는 깊고 끔찍한 자기혐오가 있다고 생각한다면, 기꺼이 그 두려움을 없애드리겠소.",shape=box,color=blue];
		1245 -> 1250;
	1244 [label="루아의 형제들 사이에는 채찍질이라는 고대의 관습이 있소. 이는 드문 일이며, 내가 살던 시대에서도 구식으로 여겨져서 \"루아의 환상에 축복받은 이들\"에게 주로 행해져 왔소.",shape=box,color=blue];
		1244 -> 1249;
	1251 [label="하지만 이건 - 엄청나게 독특하고 문자 그대로의 의미에서 \"초자연적\" - 나에게 있어서 엄연히 위험한 것은 아니오.",shape=box,color=blue];
		1251 -> 1256;
	1247 [label="Update boolean LyonSpeech",color=orange];
		1247 -> 1252;
	1248 [label="셋째; 난 그대의 동료가 겪은 고통의 맥락을 이해하지 못하고, 앞으로도 결코 이해하지 못할 것이오. 그리고 어떤 면에서는, 그들 자신 외에는 누구도 결코 이해하지 못할 것이오.",shape=box,color=blue];
		1248 -> 1253;
	1250 [label="그 깊은 우울함을 이해하지만, 향로를 사용하고 싶은 마음은 전혀 들지 않소. 게다가 마리는 절대 허락하지 않을 것이니.",shape=box,color=blue];
		1250 -> 1255;
	1249 [label="대성당에 도착한지 얼마 되지 않아 신부님 중 한 분께서 내가 그와 비슷한... \"축복\"을 받았다는 것을 보고 돕기로 결정하셨을 때, 그 말을 나에게 가르쳐 주셨소. ",shape=box,color=blue];
		1249 -> 1254;
	1256 [label="사실, 난 내 고통을 치료할 수 있는 현대 과학의 기적이 없는지 종종 생각해 왔소. 내가 그런 도움을 받아들일 만큼 건강하다면, 기꺼이 받아들일 것이오. 지금 내 신체적 상태가 그걸 허용할지는 의문이오.",shape=box,color=blue];
		1256 -> 1261;
	1252 [label="Chat ends.",color=orange];
	1253 [label="그토록 모든 것을 소진하는 방식으로 고통을 겪는 것은 그 자체로 고독한 일이니.",shape=box,color=blue];
		1253 -> 1257;
