	1266 [label="종교 인류학은 내게 있어서 아주 소중하고 중요한 학문이오. 한 사회와 대중의 의례를 연구하면 더 많은 것을 배울 수 있기에. ",shape=box,color=blue];
		1266 -> 1270;
	1271 [label="하지만 이것만은 약속드리오 - 만약 내가 더 이상 스스로를 신뢰할 수 없는 순간이 온다고 진심으로 두려워하게 된다면, 그 때 말을 하겠소.",shape=box,color=blue];
		1271 -> 1275;
	1272 [label="그 깊은 우울함을 이해하지만, 향로를 사용하고 싶은 마음은 전혀 들지 않소. 게다가 마리는 절대 허락하지 않을 것이니.",shape=box,color=blue];
		1272 -> 1267;
