		1204 -> 1199 [label="false",color=purple];
	1198 [label="우리가 앉아서 사용하는 이 기계 장치는 베일에 싸인 비인격적인 느낌을 주지. 마치 누군가가 그 기계에 입력하는 그 어떤 말이든, 그 어떤 해악으로부터 우리를 어떻게든 보호해 주는 것처럼 말이오.",shape=box,color=blue];
		1198 -> 1205;
	1203 [label="+5 Chemistry",color=orange];
		1203 -> 1209;
	1199 [label="미안 - 다시 생각해 보니, 안될 것 같아. [종료.]",shape=box,color=red];
		1199 -> 1194;
	1200 [label="[경고: 자살에 대한 논의가 이뤄집니다.] 난... 이런 종류의 \"습관\"으로 인해 누군가를 잃은 적이 있어. 난...",shape=box,color=red];
		1200 -> 1206;
	1201 [label="그저 당신을 돕고 싶어. 당신이 괜찮은지 확인하고 싶어. 그게 다야.",shape=box,color=red];
		1201 -> 1207;
	1202 [label="이게 건강하다고 할 수 없다고 느껴 - 이런 일은 멈춰야 해. ",shape=box,color=red];
		1202 -> 1208;
	1210 [label="혈청을 투약하기 전에도 다쳤었다고 했지만... 그게 더 나아졌을 거라고는 생각이 안 들어.",shape=box,color=red];
		1210 -> 1215;
	1205 [label="난 그 반대라고 주장하고 싶소. 즉, 우리가 일상적인 사회적 상호교류에서 입는 갑옷에서 벗어나면, 우리를 보호할 수 있는 것도 벗겨진다는 것.",shape=box,color=blue];
		1205 -> 1211;
	1209 [label="이... 문제를 섬세히 다루는 그대의 천성에 감사드리오, 드리프터. 정말로 감사드리오. 하지만 이런 주제가 논의의 대상이 되는 데는 꽤나 익숙하오. 걱정, 혐오감, 또는 병적인 호기심 때문일 수도 있으나, 그대는 이미 전자의 사람이라는 걸 증명했다고 생각하오.",shape=box,color=blue];
		1209 -> 1199;
		1209 -> 1200;
		1209 -> 1201;
		1209 -> 1202;
	1206 [label="Update boolean DrifterHarmLoss",color=orange];
		1206 -> 1212;
