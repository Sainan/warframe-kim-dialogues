		j2252092968 -> "Chat ends.";
	j1495229872 [label="두 사람이 얘기를 나누고 있다고 마리가 알려줬소 - 물론이오. 내 이런 특별한 특성에 대해서 말하는 게 나한테 있어서 얼마나 불편한지 놀라지도 않으실 거요.",shape=box,color=blue];
