		1254 -> 1258;
		1254 -> 1259;
		1254 -> 1260;
	1261 [label="그런데도, 장담하건대 - 나는 이에 따라 죽지 않을 것이오. 어렸을 때부터 짊어져 온 짐이니. 그리고 딱지를 뜯지 않고 내버려둔다면, 밑에서 곪아가는 상처보다 이 증상이 낫다고, 나는 그리 판단하오.",shape=box,color=blue];
		1261 -> 1264;
	1257 [label="단지 나의 신께, 그리고 그대와 그대의 신께, 그리고 그들의 신께 기도드릴 뿐이오. 그대의 마음속에 어떠한 죄책감을 품지 않기를. 이 세상이나 다른 세상에서 용서받을 만한 것이 있다면, 그것은 바로 그런 고통을 겪은 누군가를 아는 친절일 것이오.",shape=box,color=blue];
		1257 -> 1262;
	1260 [label="그리고 당신 스스로는 결코... 과격해지지 않을 거라 확신하고?",shape=box,color=red];
