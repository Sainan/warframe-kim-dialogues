digraph {
	0 [label="LyonRank3Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="반갑소, 드리프터.",shape=box,color=blue];
		1 -> 2;
	2 [label="그대가 나와 대화하고 싶다는 걸 알게 되었소.",shape=box,color=blue];
		2 -> 3;
		2 -> 4;
		2 -> 5;
	3 [label="리온, 여기서 대화를 나누게 되서 기뻐 - 고마워.",shape=box,color=red];
		3 -> 6;
	4 [label="마침내 내가 위협되지 않을 거란걸 마리가 확신시켜 준 거야?",shape=box,color=red];
		4 -> 7;
	5 [label="오! 안녕, 리온. 솔직히 당신이 설득될 줄 몰랐어. 마음을 바꿔서 기뻐.",shape=box,color=red];
		5 -> 8;
	6 [label="그대는 대화를 나누고 싶지 않았을지도 모르지만, 알았소. 괜찮소이다.",shape=box,color=blue];
		6 -> 9;
		6 -> 10;
	7 [label="지금 선택이 빠르게 바뀌지 않도록 내 신경을 자극하지 않는 게 좋을 거요.",shape=box,color=blue];
		7 -> 11;
	8 [label="뭐, 그렇게 됐소. 대화를 다 나누고 나면 그닥 기쁘지 않을지도 모르지.",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
	9 [label="다른 사람들 의견을 들어보니 논의해야 할 문제가 있다고 해서. 내가 도와줄 수 있는 일이 있을까?",shape=box,color=red];
		9 -> 12;
	10 [label="뭔가 다른 문제가 있어?",shape=box,color=red];
		10 -> 13;
	11 [label="+10 Chemistry",color=orange];
		11 -> 14;
	12 [label="시간이 지나면, 그럴지도. 그렇지만 우린 이제 막 이야기를 시작했을 뿐이오. 내가 여기 온 건 단지... 마리의 말에 굴복했다는 점을 전하기 위해서일 뿐. 대화에 한정해서는, 그대를 믿을 수 있다는 마리의 의견 말이오.",shape=box,color=blue];
		12 -> 15;
	13 [label="헛웃음이 나올 정도로 불충분한 질문이군. 그대와는 이제 막 이야기를 나누기 시작했으니 그 질문에는 대답도 하지 않겠소. 내가 여기 온 건 단지... 마리의 말에 굴복했다는 점을 전하기 위해서일 뿐. 대화에 한정해서는, 그대를 믿을 수 있다는 마리의 의견 말이오.",shape=box,color=blue];
		13 -> 15;
	14 [label="Chat ends.",color=orange];
	15 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		15 -> 16 [label="x > 0",color=purple];
		15 -> 17 [label="x <= 0",color=purple];
		15 -> 17 [label="false",color=purple];
	16 [label="그리고 보아하니 이제 모두가 로스의 \"지옥\"과도 같은 이 계획에 협력해야 하지 읺소? 그러니 서로를 제대로 아는 게 현명한 방법일거고. 그대가 선호하는 방식도 이 방법이니, 그래서 이 대화 방식을 사용하는 거요.",shape=box,color=blue];
		16 -> 18;
		16 -> 19;
	17 [label="그리고 보아하니 이제 모두가 로스의 \"지옥\"과도 같은 이 계획을 위해 영원히 파트너가 될 수도 있고 아닐게 될 수도 있지 않소이까? 그러니 서로를 제대로 아는 게 현명한 방법일거고. 그대가 선호하는 방식도 이 방법이니, 그래서 이 대화 방식을 사용하는 거요.",shape=box,color=blue];
		17 -> 18;
		17 -> 19;
	18 [label="왠지 모르겠지만, 이미 잘못된 시작을 해버린 것 같다는 느낌이 드네.",shape=box,color=red];
		18 -> 20;
	19 [label="그럼... 당신이 선호하는 다른 방식이 있어?",shape=box,color=red];
		19 -> 21;
	20 [label="아니. 그렇지 않소. 나라는 존재가 그대가 평소에 얘기를 나누는 종류의 사람이 아닐 뿐. 그 덕에 그대는 지금까지 대화 중 문제가 일어나지 않은 축복을 받아왔겠지만, 이제는 나같이 정신 나가버린 존재는 흔치 않은 존재와 얘기를 나누게 되었소.",shape=box,color=blue];
		20 -> 22;
	21 [label="아니. 괜찮소. 오히려 생각을 원하는 만큼 다듬을 시간을 벌어주니까. 이 장치가 왜 매력적인지 알 것 같소이다.",shape=box,color=blue];
		21 -> 23;
	22 [label="딴 주제로 넘어갔군. 여기서 \"문자\" 대화로 시간을 할애하려던 게 아니었는데, 분명 실망했겠지. 그저 나의 항복을 알려드리고 싶었을 뿐이오.",shape=box,color=blue];
		22 -> 24;
		22 -> 25;
	23 [label="어쨌든. 여기서 \"문자\" 대화로 시간을 할애하려던 게 아니었는데, 분명 실망했겠지. 그저 나의 항복을 알려드리고 싶었을 뿐이오.",shape=box,color=blue];
		23 -> 25;
		23 -> 24;
	24 [label="마리는 보이는 것보다 훨씬 더 위험한 사람이야, 안 그래?",shape=box,color=red];
		24 -> 26;
	25 [label="다시 한번 간단히 말할게, 고마워.",shape=box,color=red];
		25 -> 27;
	26 [label="+20 Chemistry",color=orange];
		26 -> 28;
	27 [label="+15 Chemistry",color=orange];
		27 -> 29;
	28 [label="그대는 수면 아래가 얼마나 깊은지 이제 막 의심하기 시작한거요.",shape=box,color=blue];
		28 -> 30;
	29 [label="그리고 그대와는... 대화를 나눌 만한 가치가 있었소. 고맙소.",shape=box,color=blue];
		29 -> 30;
	30 [label="-리온 알라드 신부",shape=box,color=blue];
		30 -> 31;
	31 [label="Chat ends.",color=orange];
}