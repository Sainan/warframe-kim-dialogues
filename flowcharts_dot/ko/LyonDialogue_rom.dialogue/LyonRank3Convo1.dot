	"LyonRank3Convo1 begins." [color=orange];
		"LyonRank3Convo1 begins." -> j2989993693;
	j2989993693 [label="안녕하시오, 드리프터.",shape=box,color=blue];
		j2989993693 -> j3979705373;
	j3979705373 [label="듣자하니 그대가 나와 대화를 하고 싶다 하더이다.",shape=box,color=blue];
		j3979705373 -> j3213919037;
		j3979705373 -> j3325852898;
		j3979705373 -> j1029876319;
	j3213919037 [label="여기서 대화를 나누게 되어서 기뻐, 리온. 고마워.",shape=box,color=red];
		j3213919037 -> j489397742;
	j3325852898 [label="드디어 내가 위협이 될 일 없을 거라는 마리의 설득을 받아들인 거야?",shape=box,color=red];
		j3325852898 -> j544559285;
	j1029876319 [label="오! 안녕, 리온. 솔직히 네가 설득을 받아들일 줄은 몰랐어. 마음을 바꿔줘서 기뻐.",shape=box,color=red];
		j1029876319 -> j881922119;
	j489397742 [label="그대는 대화를 나누고 싶지 않았을지도 모르지만, 알았소. 괜찮소이다.",shape=box,color=blue];
		j489397742 -> j1473227844;
		j489397742 -> j4238036796;
	j544559285 [label="그 선택을 철회할 이유를 이렇게 빨리 찾도록 만들지 않는 것이 좋을 거요.",shape=box,color=blue];
		j544559285 -> j1933300832;
	j881922119 [label="뭐, 그렇게 되었지. 하지만 대화를 다 나누고 나면 그렇게 기쁘지 않아질지도 모르오.",shape=box,color=blue];
		j881922119 -> j1473227844;
		j881922119 -> j4238036796;
	j1473227844 [label="다른 사람들 의견을 들어보니 논의해야 할 문제가 있다고 해서. 내가 도와줄 수 있는 일이 있을까?",shape=box,color=red];
		j1473227844 -> j1027488604;
	j4238036796 [label="뭔가 다른 문제가 있어?",shape=box,color=red];
		j4238036796 -> j2853951724;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j1027488604 [label="시간이 좀 지나면, 말해드릴 수 있을지도 모르지. 허나 우리는 이제 막 담론을 시작한 참이외다. 나는 그저... 적어도 대화를 나눔에 있어선 그대를 믿어도 된다는 마리의 완고한 주장에 굴복했다는 사실을, 그대에게 알려주려 왔을 뿐이오.",shape=box,color=blue];
		j1027488604 -> j2777944732;
	j2853951724 [label="이제 막 담론을 시작했을 뿐일 터인데, 참으로 헛웃음이 들 정도라 대답할 생각조차 들지 않을 만큼 모자란 질문이로군. 나는 그저... 적어도 대화를 나눔에 있어선 그대를 믿어도 된다는 마리의 완고한 주장에 굴복했다는 사실을, 그대에게 알려주려 왔을 뿐이오.",shape=box,color=blue];
		j2853951724 -> j2777944732;
	"Chat ends." [color=orange];
	j2777944732 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j2777944732 -> j3923522311 [label="x > 0",color=purple];
		j2777944732 -> j2079495671 [label="x <= 0",color=purple];
		j2777944732 -> j2079495671 [label="false",color=purple];
	j3923522311 [label="그리고 보아하니 로스가 \"지옥 끝까지라도\" 이루고자 하는 이 과업에 있어 우리는 이제 한 배를 탄 셈이 아니겠소? 그러니 서로 제대로 안면을 익혀 둠이 적절한 처사겠지. 그대가 대화에 있어 선호하는 방식은 이것인 듯 하여, 나 또한 이 기계를 쓰고 있소이다.",shape=box,color=blue];
		j3923522311 -> j4254956701;
		j3923522311 -> j3187556249;
	j2079495671 [label="그리고 보아하니 로스가 \"지옥 끝까지라도\" 이루고자 하는 이 과업에 있어 우리는 이제 한 배를 탈 수도, 타지 않을 수도 있는 셈이 아니겠소? 그러니 서로 제대로 안면을 익혀 둠이 적절한 처사겠지. 그대가 대화에 있어 선호하는 방식은 이것인 듯 하여, 나 또한 이 기계를 쓰고 있소이다.",shape=box,color=blue];
		j2079495671 -> j4254956701;
		j2079495671 -> j3187556249;
	j4254956701 [label="왠지 모르겠지만, 이미 잘못된 시작을 해버린 것 같다는 느낌이 드네.",shape=box,color=red];
		j4254956701 -> j1191326897;
	j3187556249 [label="그럼... 네가 선호하는 다른 방식이 있어?",shape=box,color=red];
		j3187556249 -> j95614997;
	j1191326897 [label="아니. 그렇지 않소. 나라는 존재가 그대가 평소에 얘기를 나누는 종류의 사람이 아닐 뿐. 그 덕에 그대는 지금까지 대화 중 문제가 일어나지 않은 축복을 받아왔겠지만, 이제는 나같이 정신 나가버린 존재는 흔치 않은 존재와 얘기를 나누게 되었소.",shape=box,color=blue];
		j1191326897 -> j3890535883;
	j95614997 [label="아니. 괜찮소. 오히려 생각을 원하는 만큼 다듬을 시간을 벌어주니까. 이 장치가 왜 매력적인지 알 것 같소이다.",shape=box,color=blue];
		j95614997 -> j554628559;
	j3890535883 [label="딴 주제로 넘어갔군. 여기서 \"문자\" 대화로 시간을 할애하려던 게 아니었는데, 분명 실망했겠지. 그저 나의 항복을 알려드리고 싶었을 뿐이오.",shape=box,color=blue];
		j3890535883 -> j2282938009;
		j3890535883 -> j4078823151;
	j554628559 [label="어쨌든. 여기서 \"문자\" 대화로 시간을 할애하려던 게 아니었는데, 분명 실망했겠지. 그저 나의 항복을 알려드리고 싶었을 뿐이오.",shape=box,color=blue];
		j554628559 -> j4078823151;
		j554628559 -> j2282938009;
	j2282938009 [label="마리는 보이는 것보다 훨씬 더 위험한 사람이야, 안 그래?",shape=box,color=red];
		j2282938009 -> j843759623;
	j4078823151 [label="다시 한번 간단히 말할게, 고마워.",shape=box,color=red];
		j4078823151 -> j2009083868;
	j843759623 [label="+20 Chemistry",color=orange];
		j843759623 -> j2693500390;
	j2009083868 [label="+15 Chemistry",color=orange];
		j2009083868 -> j384513837;
	j2693500390 [label="그대는 수면 아래가 얼마나 깊은지 이제 막 의심하기 시작한거요.",shape=box,color=blue];
		j2693500390 -> j3312326441;
	j384513837 [label="그리고 그대와는... 대화를 나눌 만한 가치가 있었소. 고맙소.",shape=box,color=blue];
		j384513837 -> j3312326441;
	j3312326441 [label="-리온 알라드 신부",shape=box,color=blue];
