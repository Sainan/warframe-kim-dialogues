	1720 [label="난... 렐과 해로우가 당신과 함께 있어줘서 정말 기뻤어, 리온... 비록 그 만남이 기억 속에만 있었더라도 말이야.",shape=box,color=red];
		1720 -> 1725;
	1725 [label="고맙소. 그들이 그립소. 그래도... 이곳에는 내 고통을 이해해 줄 이가 그렇지 않은 이보다 많다는 걸 깨닫고 있다오.",shape=box,color=blue];
