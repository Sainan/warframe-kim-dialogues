		1637 -> 1639;
	1635 [label="Chat ends.",color=orange];
	1638 [label="난 문을 잠그고, 옷을 벗고 바닥 한가운데 앉아 가능한 모든 물건에서 멀리 떨어진 다음 옆구리에 바늘을 꽂게 됐소.",shape=box,color=blue];
		1638 -> 1640;
	1639 [label="Update boolean LyonRell3",color=orange];
		1639 -> 1641;
	1640 [label="로스가 당시 입고 있었던 의상으로 보이는 것들이 감염으로 그의 살을 어떻게 비틀었는지 보았기에 - 똑같은 운명의 희생자가 되고 싶지 않았소.",shape=box,color=blue];
		1640 -> 1642;
	1641 [label="Update boolean LyonFaith3Unknown",color=orange];
		1641 -> 1643;
	1642 [label="통증이 가라앉자 이미 흐릿했던 시야가 더욱...흐릿해졌소. 어쩐 일인지... 이중으로 보이는 것 같았지. 마치 시야에 있는 형상들이 하나가 아니라 두 개로 보이는 것 같았소.",shape=box,color=blue];
		1642 -> 1644;
	1643 [label="Chat ends. Next chat will be Lyon5FaithDay2.",color=orange];
	1644 [label="구토하고 의식을 잃기 전에 하의를 챙겨 입을 수 있었기에, 스스로의 회복력을 꽤 자랑스럽게 생각하오.",shape=box,color=blue];
		1644 -> 1645;
	1645 [label="잠에서 깼을 땐, 혼자가 아니었소. 그렇다고 내가 투약받던 방의 바닥에 누워 있던 것도 아니었지. 난 어린 시절 속 방 안, 너무나도 잘 아는 삐걱거리는 낡은 바닥에 앉아 있었소.",shape=box,color=blue];
		1645 -> 1646;
	1646 [label="내 옆에는 앳된 청년이 앉아 있었소. 그 옆에는 내가 지금 해로우라고 알고 있는 형체가 서 있었지. 그 청년의 손에는 작은 나무 인형이 있었는데, 팔다리 마디가 나 있었고 - 도색은 접힌 자국과 갈라진 틈만 빼면 거의 다 벗겨져 있었소. 그건 내 아버지 것이었소. 군인을 묘사한 나무 인형이었으니.",shape=box,color=blue];
		1646 -> 1647;
	1647 [label="그 인형은 내가 어렸을 때, 내 것이라고 주장할 수 있는 유일한 장난감이었소.",shape=box,color=blue];
		1647 -> 1648;
		1647 -> 1649;
	1648 [label="나도 어렸을 때 비슷한 인형을 가지고 있었어. 내가 가장 좋아하는 장난감 중 하나였거든.",shape=box,color=red];
		1648 -> 1650;
	1649 [label="렐이었어?",shape=box,color=red];
		1649 -> 1651;
	1650 [label="그렇다 들었소. 내 인형은 좀 더 유순한 걸로 판명됐지만.",shape=box,color=blue];
		1650 -> 1652;
		1650 -> 1653;
		1650 -> 1654;
	1651 [label="그렇소.",shape=box,color=blue];
		1651 -> 1655;
	1652 [label="트락스는 복잡한 주제야. 이 지점에선 언급하지 않을게.",shape=box,color=red];
		1652 -> 1656;
	1653 [label="사실 트락스 잘못도 아니었어. 그저 그 순간 내게 필요했던 그런 존재였으니까.",shape=box,color=red];
		1653 -> 1657;
	1654 [label="괜찮아. 트락스도 앞으로 나아가고 있으니까. 천천히. 어떻게든. 불가능해 보이는 것도 바뀔 수 있어.",shape=box,color=red];
		1654 -> 1658;
	1655 [label="꿈속에서 - 마음속에서 - 날 찾아온 그 앳된 청년과 그의 조용한 수호자는 나에게는 낯선 존재였으나, 마치 함께 자란 친형제처럼 내게는 친숙한 존재들이었지.",shape=box,color=blue];
		1655 -> 1659;
	1656 [label="그렇구려. 이 지점에서 그 얘기를 시작하면 말하던 주제를 잊어버리고 두비리의 도덕적, 신학적 함의에 대해 몇 시간이고 논쟁하게 될 거요.",shape=box,color=blue];
		1656 -> 1655;
	1657 [label="그대 대신 내가 그 자리에 있었으면 무슨 짓을 했을지에 대하ㄴ 아주 사소한 생각이라도 떠올리게 되면 공포가 몰려오더이다. 하지만 그런 얘기를 하다 보면 몇 시간이고 여기서 헤매고 다닐 수도 있지.",shape=box,color=blue];
		1657 -> 1655;
	1658 [label="만약 그가 변화의 조짐을 보이고 있고, 그게 그대 감정의 산물이라면, 어쩌면 다른 무언가를 암시하는 것일지도 모르오. 하지만 이 문제는 후일에 논의하도록.",shape=box,color=blue];
		1658 -> 1655;
	1659 [label="과장된 비유를 사용하는 점 양해해 주시구려. 우리는 마치 서로의 뿌리를 구별할 수 없을 정도로 함께 자란 세 그루의 나무와도 같았소 -",shape=box,color=blue];
		1659 -> 1660;
	1660 [label="그런 상태에서 그저 눈 깜짝할 새 곁에 있게 된 존재들. 렐과 해로우가 없던 내 삶이 기억났소. 그런데도, 그들은 거기에 있었소. 매 순간, - 모든 경우 - 내 곁에.",shape=box,color=blue];
		1660 -> 1661;
	1661 [label="덧붙여서, 이 점에 대해서 엔트라티와 이야기를 나누고 싶었소. 이 현상의 근원이 되는 뿌리에 대해서 - 말장난하는게 아니라 - 정확하게 알고 싶었소만, 우리가 마침내 변화에서 회복했을 때, 엔트라티는 사라져 버렸소.",shape=box,color=blue];
		1661 -> 1662;
	1662 [label="Check boolean LoidFamilyComplete",color=orange];
		1662 -> 1664 [label=true,color=green];
		1662 -> 1663 [label=false,color=brown];
		1662 -> 1664 [label=false,color=brown];
	1664 [label="감염과 그게 어떻게 작동하는지에 대해 아는 게 조금 뿐이라, 일종의... 아마도... 나도 잘 모르겠다, 시간 밖에서 일어나는 일이라면?",shape=box,color=red];
		1664 -> 1666;
	1663 [label="엔트라티의 딸이 위층에 있어. 그 인간 옆에서 공부를 하고 일했었거든. 그녀라면 도와줄 수 있을지도 몰라.",shape=box,color=red];
		1663 -> 1665;
	1666 [label="기타가... 하나 있거든... 설명하기가 정말 어렵지만, 우리 둘 다 헬민스를 통해 시간 여행을 했어...",shape=box,color=red];
		1666 -> 1668;
	1665 [label="Update boolean LyonFamilySuccess",color=orange];
		1665 -> 1667;
	1668 [label="그 과정은 내 악몽 속에 오랫동안 남을 거요. 그럼에도 렐, 해로우 그리고 내가 어떻게 그런... 분자적이고 영적인 차원에서 연결되었는지 구체적인 내용은 나도 모르오.",shape=box,color=blue];
		1668 -> 1670;
	1667 [label="Add 1 to Family",color=orange];
		1667 -> 1669;
	1670 [label="하지만 갈림길은 양방향으로 뻗어 있었고, 그들이 내 삶에 있었던 곳에 나도 그들의 삶 속에 있었소. 나는 무심을 보았소. 그들이 무엇을 그리 경계하고 있는지 이해가 갔지. 해로우의 모습과, 그가 예전에 어떤 모습이었는지를 어렴풋이 보게 되었소.",shape=box,color=blue];
		1670 -> 1672;
	1669 [label="이제 그녀와 직접 대화를 나눌수만 있다면 얼마나 좋을지. 이미 그런 계획이 진행 중일 거라 생각하오. 그렇다면 내가... 도와드리리다. 필요한 순간에 설득할 수 있을 거요.",shape=box,color=blue];
		1669 -> 1671;
	1672 [label="하지만 무심의 압력이 날 압도했으니. 바로 그곳에서 느낄 수 있었소 - 그들이 벽을 두드리는 소리를. 똑... 똑... 똑...",shape=box,color=blue];
		1672 -> 1673;
	1671 [label="그럼에도 렐, 해로우 그리고 내가 어떻게 그런... 분자적이고 영적인 차원에서 연결되었는지 구체적인 내용은 나도 모르오.",shape=box,color=blue];
		1671 -> 1670;
	1673 [label="어린 시절의 모든 환상, 스스로가 목격했던 모든 공포 - 그것들은 그저 무심에 불과했던 걸까? 지금 내가 잘못 기억하고 있는 건가? 아니면 정말 루아에게 \"축복\"을 받은 걸까?",shape=box,color=blue];
		1673 -> 1674;
	1674 [label="내 안의 믿음이... 구겨지고 떨어져 나갔소. 새까맣게 타버린 종이처럼, 먼지로 변해버렸지. 아, 스스로의 나약함에 얼마나 혐오감이 들던지...",shape=box,color=blue];
		1674 -> 1675;
	1675 [label="Evaluate expressions",color=orange];
		1675 -> 1681 [label="LyonDating",color=purple];
		1675 -> 1682 [label="DrifterFaithYesSimilar",color=purple];
		1675 -> 1682 [label="DrifterFaithYesForeign",color=purple];
		1675 -> 1682 [label="DrifterFaithPersonal",color=purple];
		1675 -> 1680 [label="DrifterFaithSol",color=purple];
		1675 -> 1680 [label="DrifterFaithLua",color=purple];
		1675 -> 1680 [label="DrifterFaithBalance",color=purple];
		1675 -> 1679 [label="DrifterFaithAgnostic",color=purple];
		1675 -> 1678 [label="DrifterFaithNoFear",color=purple];
		1675 -> 1677 [label="DrifterFaithNoMITW",color=purple];
		1675 -> 1678 [label="DrifterFaithNoMaybe",color=purple];
		1675 -> 1676 [label="false",color=purple];
	1681 [label="오, 리온... 당신 정말 많은 일을 겪었어. 의심은 나약함의 결과가 아니야 - 고통의 결과지.",shape=box,color=red];
		1681 -> 1683;
		1681 -> 1684;
		1681 -> 1685;
		1681 -> 1686;
		1681 -> 1687;
	1682 [label="믿음은 지속될 필요가 없으며 - 불변을 바라지도 않아. 믿음을 잃었다가 다시 되찾은 사람들의 이야기가 얼마나 많은지 알아?",shape=box,color=red];
		1682 -> 1683;
		1682 -> 1684;
		1682 -> 1685;
	1680 [label="당신은 평생 광휘의 성체들에게 삶을 헌신했잖아, 리온. 그들이 이런 일로 당신을 외면할 거라고 생각해?",shape=box,color=red];
		1680 -> 1683;
		1680 -> 1684;
		1680 -> 1685;
	1679 [label="신들이 있는지 없는지 난 잘 모르겠어, 리온 - 우리 중 누구도 진정으로 알 수 없을 거야. 하지만 내가 아는 건, 당신이 정말 많은 일을 겪었다는 거야.",shape=box,color=red];
		1679 -> 1683;
		1679 -> 1685;
		1679 -> 1686;
	1678 [label="나 스스로는 이 세상에 신들 같은 건 존재하지 않는다고 믿지만, 그게 당신의 삶에서 얼마나 중요한 존재였는지는 잘 알고 있어. 그 점을 깎아내리고 싶지도 않고.",shape=box,color=red];
		1678 -> 1685;
		1678 -> 1687;
	1677 [label="무심은 우리가 만든 거야 - 그 존재는 신이 아니야, 리온. 엔트라티의 실수로 스스로를 망가뜨리지 마. 당신의 신앙은 어떤데?",shape=box,color=red];
		1677 -> 1685;
		1677 -> 1687;
	1676 [label="당신이 이런 식으로, 모두의 헛소리에 휘말리는 모습을 보고 있으니 정말 괴로워. 당신은 이런 일을 당할 자격이 없어.",shape=box,color=red];
		1676 -> 1683;
		1676 -> 1684;
		1676 -> 1685;
		1676 -> 1686;
		1676 -> 1687;
	1683 [label="믿음을 다시 찾아야 한다는 소리를 하는게 아니야. 만약 당신이 원한다면 - 필요하다고 느낀다면 - 믿음, 신앙이라는 건 영원히 잃어버리는 것이 아니라는 말이야.",shape=box,color=red];
		1683 -> 1688;
	1684 [label="루아께선 분명, 당신이 어떤 일을 겪었는지, 당신이 자신의 이름으로 견뎌낸 것을 알고 계실 거야. ",shape=box,color=red];
		1684 -> 1689;
	1685 [label="내 생각엔 당신이 집중해야하는 부분은 내면 안에서 어떤 종류의 평화를 찾는 거야 - 어떻게든 말이야.",shape=box,color=red];
		1685 -> 1690;
	1686 [label="신이 있다면, 만약 당신의 루아가 존재한다면 - 분명 루아는 당신이 겪은 일을 볼 수 있을 거야. 루아의 이름으로 리온이 견뎌낸 모든 것들을 말이야. 그게 루아에게 분명 의미가 있을 거야.",shape=box,color=red];
		1686 -> 1691;
	1687 [label="신들이 존재하는지 여부에 대한 관념을 버리고, 먼저 자기자신을 치유하는 데 집중해야 한다고 생각해.",shape=box,color=red];
		1687 -> 1692;
	1688 [label="Update boolean LyonFaith3Maybe",color=orange];
		1688 -> 1693;
	1689 [label="Update boolean LyonFaith3Yes",color=orange];
		1689 -> 1693;
	1690 [label="Update boolean LyonFaith3Maybe",color=orange];
		1690 -> 1693;
	1691 [label="Update boolean LyonFaith3Yes",color=orange];
		1691 -> 1693;
	1692 [label="Update boolean LyonFaith3No",color=orange];
		1692 -> 1693;
	1693 [label="어쩌면 그대의 말이 맞을지도…. 그리고 내 슬픈 의심에 대한 점이 이야기의 요점은 아니었소. 그렇지만 그대의 말을 고려해 볼 테니, 내일 이 문제에 대해 더 자세한 이야기를 나눴으면 하오.",shape=box,color=blue];
		1693 -> 1694;
	1694 [label="자리만 10-0호에서 렐이 겪은 삶과 그 후 그가 견뎌낸 모든 것들을 보았소. 감염으로 인해 희미해진 군인 해로우의 삶도 보았지. 마치 그들이 골에서 내가 겪은 모든 고통과 삶을 보았듯이 말이오.",shape=box,color=blue];
		1694 -> 1695;
	1695 [label="우리 중 누구도 단 한 번도 말을 주고받지 않았다는 사실이 이상하게 느껴질지도 모르겠구려. 우리는 그럴 필요성을 전혀 느끼지 못했으니까. 그저 우리 사이에는... 이해심이 있었을 뿐.",shape=box,color=blue];
		1695 -> 1696;
		1695 -> 1697;
	1696 [label="정말로 대화를 안 나눴어? 한 번도?",shape=box,color=red];
		1696 -> 1698;
	1697 [label="그래... 알 것 같아.",shape=box,color=red];
		1697 -> 1699;
	1698 [label="그들의 목소리를 들을 수 있었소 - 그들이 살아오면서 했던 모든 말을 기억했지만, 그 말들은 결코 나에게 직접 전달된 것이 아니었소.",shape=box,color=blue];
		1698 -> 1699;
	1699 [label="미소에 말이 필요하오? 찡그린 표정에는? 아이의 울음소리를 들어야 아이가 고통스러워하거나 두려워한다는 걸 알 수 있소? 아니지, 우린 그저 우리 사이에 오간 의미만 알았을 뿐이오.",shape=box,color=blue];
		1699 -> 1700;
	1700 [label="그게... 그게 더 이상 존재하지 않을 때까지.",shape=box,color=blue];
		1700 -> 1701;
	1701 [label="Check boolean LyonDating",color=orange];
		1701 -> 1703 [label=true,color=green];
		1701 -> 1702 [label=false,color=brown];
	1703 [label="그들은 사라진 게 아니오, mon miracle... 단지 죽었을 뿐.",shape=box,color=blue];
		1703 -> 1704;
	1702 [label="그들은 사라진 게 아니오, 친구여... 단지 죽었을 뿐.",shape=box,color=blue];
		1702 -> 1704;
	1704 [label="더 이상 미확정 부분들을 들을 수 없게 됐소. 이제는, 확정된 부분만 들을 수 있는 것 같소만.",shape=box,color=blue];
		1704 -> 1705;
		1704 -> 1706;
	1705 [label="미안, 확정된 부분이라고?",shape=box,color=red];
		1705 -> 1707;
	1706 [label="언제부터... 안 들리게 됐는데?",shape=box,color=red];
		1706 -> 1708;
	1707 [label="이미 설명했듯이 어떻게 풀어내야 할지 모르겠구려. 나도 잘 모르겠소. 용서해 주시오.",shape=box,color=blue];
		1707 -> 1708;
	1708 [label="우리기 로스와 함께 헬민스를 거쳐 여기까지 왔고, 성역에 도착한 순간까지… 모르겠소… 왜 그랬는지. 나도 무슨 일이 일어났는지 모르겠소.",shape=box,color=blue];
		1708 -> 1709;
	1709 [label="시간의 장막을 통과하면서, 나의 친구들, 나의 형제들... 나의 영혼과 그토록 밀접하게 엮어내ㄴ 뿌리를 가진 나무들은... 나와 함께 시들어 죽어버렸소.",shape=box,color=blue];
		1709 -> 1710;
	1710 [label="이제 공허함만이 깃들었으니. 부패해가고 있소. 그들의 기억이 여전히 내 기억을 오염시키고 있으나. 이 모든 걸 내려놓을 기회가 온다하더라도 결코 포기하지 않을 거요...",shape=box,color=blue];
		1710 -> 1711;
		1710 -> 1712;
	1711 [label="오?",shape=box,color=red];
		1711 -> 1713;
	1712 [label="왜 포기 안해?",shape=box,color=red];
		1712 -> 1713;
	1713 [label="어머니가 처음 때리셨던 그 순간의 기억이 생생하게 떠오르오. 두 가지 갈래로 기억나는데, 솔의 가장 밝은 빛처럼 또렷히 말이오. 그리고 그 모든 기억들이 사실임을 알고 있소.",shape=box,color=blue];
		1713 -> 1714;
	1714 [label="한 장면에서는... 나는 방 안의 어둠 속에서 혼자 울고 있소. 또 다른 장면에서는 두 형체가 그림자 속에서 내 옆으로 서 있지.",shape=box,color=blue];
		1714 -> 1715;
	1715 [label="마음속 목소리를 지우려고 처음으로 칼날을 스스로의 피부에 들이댔던 순간을 두 번이나 기억하오. 한 번은, 방이 텅 비어 있었지.",shape=box,color=blue];
		1715 -> 1716;
	1716 [label="또 다른 장면에서는, 내 뒤에서 콧노래 소리가 들렸지. 냉정한 수호자의 조용한 존재감이 느껴졌소.",shape=box,color=blue];
		1716 -> 1717;
	1717 [label="루아에 대한 믿음을 잃고 그 대신 루아의 인도를 받게 된다면... 기꺼이 응할 수 있는 거래가 될지도 모르오.",shape=box,color=blue];
		1717 -> 1718;
