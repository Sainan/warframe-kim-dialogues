		j1538291680 -> j3728328129;
	j3728328129 [label="고맙소. 그들이 그립소. 그래도... 이곳에는 내 고통을 이해해 줄 이가 그렇지 않은 이보다 많다는 걸 깨닫고 있다오.",shape=box,color=blue];
