		1627 -> 1631;
	2350 [label="Update boolean LyonWillDate",color=orange];
		2350 -> 2351;
	1632 [label="그런 것 같소. 하지만 그런 면에서 스스로 수년간 연습해 왔다고 생각하기에, 엔트라티의 경고가 실제보다 훨씬 더 인상적이었던 것 같소.",shape=box,color=blue];
		1632 -> 1633;
	1633 [label="마리와 난 따로 혈청을 투약받기로 정했소. 내가 먼저 가서 변화를 경험할 수 있도록 마리에게 청하였고, 그 다음에 그녀의 변화를 도울 수 있게 해달라 부탁했으나 - 마리는 당연하게도, 완강히 거절하였소.",shape=box,color=blue];
		1633 -> 1636;
