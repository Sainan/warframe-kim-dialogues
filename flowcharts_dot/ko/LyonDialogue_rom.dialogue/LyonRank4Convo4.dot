	1058 [label="대성당의 다른 신부님 중 한 분이 내 마음을... 맑게 해줄려고 가르쳐 준 거였소. 루아에게 선택받은 이들은 종종 \"환상\"을 보는 능력을 \"축복\"으로서 받는다고.",shape=box,color=blue];
		1058 -> 1061;
	1059 [label="Check boolean LyonPainOff",color=orange];
		1059 -> 1063 [label=true,color=green];
		1059 -> 1062 [label=false,color=brown];
	1060 [label="그 마음은 이해하지만, 부모보다 키와 체격이 더 커졌을 때, 그들의 입장에서 커져버린 날 돌보는 게 얼마나 힘든 일이었을지 말로 다 표현할 수 없을 것 같소.",shape=box,color=blue];
		1060 -> 1059;
	1061 [label="Update boolean LyonLecture2",color=orange];
		1061 -> 1049;
	1063 [label="환상과 목소리들이 종종 나를 격렬한 발작에 빠뜨렸소, 드리프터. 내가 본 것들에게서 깨어나는 유일한 방법은 스스로를 고문하는 것뿐이었지.",shape=box,color=blue];
		1063 -> 1064;
	1062 [label="환상과 목소리들이 종종 나를 격렬한 발작에 빠뜨렸소, 드리프터. 난 종종 칼을 들고 스스로의 살을 도려내곤 했소. 고통만이 날 깨어나게 했기에.",shape=box,color=blue];
		1062 -> 1064;
	1064 [label="하지만, 그 목소리들이 나에게 지시를 내리게 되었고",shape=box,color=blue];
		1064 -> 1065;
	1065 [label="난...안되겠소. 더는 할 수 없소. 용서해 주시오. 타자를 치는 동안에도 손이 떨리고 있소. 이제 그만둬야 할 것 같소.",shape=box,color=blue];
		1065 -> 1066;
		1065 -> 1067;
	1066 [label="물론이야. 괜찮아. 서두를 필요 없어. 당신이 준비되었을 때, 난 언제든 여기에 있으니까.",shape=box,color=red];
		1066 -> 1068;
	1067 [label="알았어, 너무 힘들었지. 편히 쉬어, 응? 그리고... 고마워. 이건 나한테 큰 의미가 있었어.",shape=box,color=red];
		1067 -> 1069;
	1068 [label="+10 Chemistry",color=orange];
