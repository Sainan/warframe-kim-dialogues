	1070 [label="고맙소. 곧 다시 연락드리리다.",shape=box,color=blue];
		1070 -> 1072;
	1071 [label="이쪽도 마찬가지오. 그대가 아는 것보다 더 많은 걸 생각하게 됐소. 감사 인사를 전하오, 내 친구. 곧 다시 얘기하길.",shape=box,color=blue];
		1071 -> 1073;
