		j3260070664 -> j1558878757 [label=true,color=green];
		j3260070664 -> j4205174583 [label=false,color=brown];
	j1742506507 [label="전쟁으로 인해서 무엇이 파괴되는지를 생각하면 마음이 아프더이다. 하지만 그로 인해 무엇이 창조되는가가 더욱 기묘한 법이니.",shape=box,color=blue];
		j1742506507 -> j4205174583;
	j1558878757 [label="흠. 다른 이들은 요즘 그리 부르오? \"이전 경험?\" 정말 멋진 표현이군. 엔트라티는 꽤나 엉망진창인 것 같지만, 그대는... 스스로 즐길 방법을 찾은 것 같아 다행이오.",shape=box,color=blue];
		j1558878757 -> j1305408727;
		j1558878757 -> j3455594574;
		j1558878757 -> j1975304103;
	j4205174583 [label="M. 로이드는 그대의 과거, 그리고 우리의 미래인 홀바니아에서 겪은 \"불행한 모험\"에 대해 말해주었소. 엔트라티가 정말 엉망진창으로 일을 벌였더군.",shape=box,color=blue];
		j4205174583 -> j1693455583;
