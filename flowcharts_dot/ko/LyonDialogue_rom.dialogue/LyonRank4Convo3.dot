		j2255023203 -> j1228404775;
	j2536772225 [label="왜 로스가 뭔가를 꾸미고 있다고 생각해?",shape=box,color=red];
		j2536772225 -> j3088545410;
	j4223838395 [label="물론, 우리는 교류를 나눌 수 있소. 하지만 이렇게는 안 되지. 여기서는. 왜 그런지 아시오?",shape=box,color=blue];
		j4223838395 -> j2586236511;
		j4223838395 -> j1724477329;
	j1228404775 [label="어쩌면 그게 현명한 선택일지도 모르오. 그자가 그 생물들을 지금보다 더 쓸모 있는 도구로서 조종하는 꼴을 보고 싶진 않으니까.",shape=box,color=blue];
		j1228404775 -> j3030718961;
	j3088545410 [label="로스는 누구와 대화를 나누든 항상 어떤 동기를 염두에 두고 있소. 그자가 그 생물들을 지금보다 더 쓸모 있는 도구로서 조종하는 꼴을 보고 싶진 않으니까.",shape=box,color=blue];
		j3088545410 -> j2611691546;
	j2586236511 [label="그 꼬마는... 이미 자기들만의 말도 안 되는 일들을 겪고 있어. 이 이상 뭘 해달라고 바랄 수 없어. 옳지도 않고.",shape=box,color=red];
		j2586236511 -> j584143113;
	j1724477329 [label="생각하기엔... 프로토프레임과의 \"이전 경험\"이 있기 때문이려나?",shape=box,color=red];
		j1724477329 -> j3260070664;
	j2611691546 [label="시간이 남는다면 조사해보는 것도 좋을 것 같지만, 물론 그건 전적으로 그대의 선택이오.",shape=box,color=blue];
		j2611691546 -> j3030718961;
	j584143113 [label="맞소. 그 존재가 견뎌내야 했던 일들에 대한 소문을 들었소. 전쟁과... 깨져버린, 갈기갈기 찢져겨버린 우정의 이야기들 말이요.",shape=box,color=blue];
		j584143113 -> j1742506507;
