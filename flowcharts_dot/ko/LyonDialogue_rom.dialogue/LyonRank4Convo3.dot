	j2165905142 [label="사과드리오. 그대 말이 맞소. 질투하는 척하거나 스스로가 선동가처럼 보이려는 게 아니오. 다른 이들과 함께하는 시간에 무엇을 하든 그건 순전히 그대의 사정이니까.",shape=box,color=blue];
