		j3039724897 -> "Chat ends.";
	j3252924416 [label="그들의 정감 어린 농담을 듣는 걸 매우 좋아하지만, 그대가 짐작했다시피, 그 농담엔 참여하고 있지 않소. 그들의 담론에 내가 보탤 말이 거의 없기에.",shape=box,color=blue];
		j3252924416 -> j1068815454;
	j2439544460 [label="그가 정말 마음에 드오. 사실, 새로운 동료들 중 내가 가장 많은 시간을 보내고 싶은 이가 바로 그요.",shape=box,color=blue];
		j2439544460 -> j228373698;
	"Chat ends." [color=orange];
	j1068815454 [label="그런데 로스가 새 3호와 서서 오랫동안 대화나누는 모습을 보면 걱정이 되더이다. 그자가 그리 행동함으로써 무엇을 이루고자 하는지 알 수가 없으니.",shape=box,color=blue];
		j1068815454 -> j2507757158;
	j228373698 [label="아마 아무도 놀라지 않겠지. 언뜻 보기에 우리는 아주 비슷한 성향을 가지고 있으니.",shape=box,color=blue];
