		j2507757158 -> j2536772225;
	j3030718961 [label="내가 더 기이하게 생각하는 건 어린 오퍼레이터요... 그리고 그 존재가 로터스라 부르는 이도. 그리고 우리가 그들과 얼마나 거리를 두고 있는지도.",shape=box,color=blue];
		j3030718961 -> j4223838395;
