		j2338469863 -> j1859470810;
	j363346514 [label="사과드리오. 난 그대의 마음도, 다른 이들의 마음도 잘 모르오. 그대가 다른 이들과 함께하는 시간에 무엇을 하든 그건 순전히 그대의 사정이오.",shape=box,color=blue];
