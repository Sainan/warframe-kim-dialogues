digraph {
	2100 [label="LyonRank5Convo9 begins.",color=orange];
		2100 -> 2101;
	2101 [label="Evaluate expressions",color=orange];
		2101 -> 2102 [label="LyonDating, LyonDatingConfession",color=purple];
		2101 -> 2103 [label="LyonDating",color=purple];
		2101 -> 2102 [label="false",color=purple];
	2102 [label="Chat ends.",color=orange];
	2103 [label="Mon miracle, 내가... 이 다음 일화를 들려주기 전에 그대가 이해했는지에 대해 꼭 확인해야겠소. ",shape=box,color=blue];
		2103 -> 2104;
	2104 [label="이제부터 내가 내뱉는 말에 귀을 기울여야 할거요. 이해했소?",shape=box,color=blue];
		2104 -> 2105;
		2104 -> 2106;
	2105 [label="당신 때문에 긴장돼, 뭐가 문젠데?",shape=box,color=red];
		2105 -> 2107;
	2106 [label="응, 여기 있으니까. 얘기해 줘.",shape=box,color=red];
		2106 -> 2108;
	2107 [label="아무 문제도 없소 - 오히려 그 반대지. 바로 그점이 이해해야 할 중요한 지점이며 - 내가 그대를 해방시켜주고 싶은 끔찍한 결과요. 만약 그대가 그런 일이 뒤따를 것이라고 고려하고 있다면 말이오.",shape=box,color=blue];
		2107 -> 2109;
		2107 -> 2110;
		2107 -> 2111;
	2108 [label="+5 Chemistry",color=orange];
		2108 -> 2112;
	2109 [label="듣고 있어.",shape=box,color=red];
		2109 -> 2113;
	2110 [label="뭔 말인지 모르겠어.",shape=box,color=red];
		2110 -> 2114;
	2111 [label="뭐에... 관한 끔찍한 결과인데?",shape=box,color=red];
		2111 -> 2115;
	2112 [label="고맙소. 시작하기에 앞서, 아무 문제가 없다는 점을 말씀드리고 싶소 - 하지만 그대에게 밝히고 싶은 끔찍한 결과가 여기에 있소. 만약 그대가 그런 일이 뒤따를 것이라고 고려하고 있다면 말이오.",shape=box,color=blue];
		2112 -> 2109;
		2112 -> 2110;
		2112 -> 2111;
	2113 [label="+5 Chemistry",color=orange];
		2113 -> 2116;
	2114 [label="맞소. 나 또한 이 점을 뼈저리게 느끼고 있으니.",shape=box,color=blue];
		2114 -> 2115;
	2115 [label="다시 시작하겠소.",shape=box,color=blue];
		2115 -> 2116;
	2116 [label="많은 이들은 내가 그렇게 좋지 않은 상태라 생각할 수도 있고, 실제로도 그럴 가능성이 매우 높다는 걸 스스로도 알고 있소. 적어도 내 정신이 완전한 상태는 아니란 말이오.",shape=box,color=blue];
		2116 -> 2117;
	2117 [label="오래전부터 이 현실에서 평화롭게 지냈소. 더 이상 날 괴롭히지도 않았지. 나를 괴롭히는 환상들 - 그 목소리들 - 스스로 두려움이나 증오 없이 그것들과 함께 살아갈 방법을 찾았소.",shape=box,color=blue];
		2117 -> 2118;
	2118 [label="(최근에 생각해 보니, 약간의 짓궂음 때문에 그랬던 것 같지만, 그게 중요한 게 아니오.)",shape=box,color=blue];
		2118 -> 2119;
	2119 [label="하지만 그대가 우리 사이의 이 관계 - 이전에 나와 다른 이 사이에 불가능하다고 생각했던 관계 - 를 끝내려고 한다면,",shape=box,color=blue];
		2119 -> 2120;
	2120 [label="어느 날 당신의 마음이 정말로 나에게서 멀어진다면? ",shape=box,color=blue];
		2120 -> 2121;
	2121 [label="나는 견뎌낼 거요, mon miracle.",shape=box,color=blue];
		2121 -> 2122;
	2122 [label="나는 나를 괴롭히는 것들에 휩쓸리지 않을 것이오. ",shape=box,color=blue];
		2122 -> 2123;
	2123 [label="Check boolean LyonAllRight",color=orange];
		2123 -> 2125 [label=true,color=green];
		2123 -> 2124 [label=false,color=brown];
	2125 [label="그대가 했던 표현을 빌리자면, \"괜찮을 거요.\" 다시 한번 웃고 떠들 수 있는 이유를 찾을 것이오.",shape=box,color=blue];
		2125 -> 2126;
		2125 -> 2127;
	2124 [label="난 살아남을 거요. 잘 지낼 거고. 다시 한번 웃고 떠들 수 있는 이유를 찾을 것이오.",shape=box,color=blue];
		2124 -> 2126;
		2124 -> 2127;
	2126 [label="오, 리온... 당신은 나한테 짐 같은 존재가 아니야.",shape=box,color=red];
		2126 -> 2128;
	2127 [label="그러니까... 나하고의 관계를 끝내고 싶다는 뜻이야?",shape=box,color=red];
		2127 -> 2129;
	2128 [label="단지 그대가 나 때문에 느낄지도 모르는 어떤 어려움으로부터라도 그대를 해방시켜 주기 위해 노력하는 것뿐이오...",shape=box,color=blue];
		2128 -> 2130;
		2128 -> 2131;
		2128 -> 2132;
	2129 [label="아니오! 전혀 아니오! 단지 그대가 나 때문에 느낄지도 모르는 어떤 어려움으로부터라도 그대를 해방시켜 주기 위해 노력하는 것뿐이오.",shape=box,color=blue];
		2129 -> 2130;
		2129 -> 2131;
		2129 -> 2132;
	2130 [label="당신이 가지고 있는 고통은...내가 가진 고통과 메아리쳐. 그 고통을 극복하도록 돕는 건 결코 어려운 일이 아닐 거야.",shape=box,color=red];
		2130 -> 2133;
	2131 [label="무엇이 날 당신에게 이끌리게 만드는 지 설명할 수가 없어. 하지만 당신은 결코 의무나 짐이 되지 않을 거야.",shape=box,color=red];
		2131 -> 2134;
	2132 [label="[헤어진다.] 이 모든 게 너무 힘들어졌어. 미안. 여기서 끝내는 게 나을 것 같아.",shape=box,color=red];
		2132 -> 2135;
	2133 [label="그대 때문에 내 맘이 얼마나 아플지 말로 다 표현할 수가 없구려. 하지만 우리 외로운 고통의 유령들이 서로를 찾았다는 사실에 영원히 감사할 따름이오.",shape=box,color=blue];
		2133 -> 2136;
	2134 [label="이 감사의 마음을 제대로 표현할 수 있는 방법이 없고, 어떤 말로도 표현할 수 없을 것 같소.",shape=box,color=blue];
		2134 -> 2136;
	2135 [label="알았소. 그렇겠지. 지금 시점에서... 다른 답변을 받아들이는 건... 위선일 거요... ",shape=box,color=blue];
		2135 -> 2137;
	2136 [label="하지만 이미 극단적인 자기만족을 위해서라고밖에 표현할 수 없는 이 서문을 쓰기 위해 많은 노력을 기울였으니...",shape=box,color=blue];
		2136 -> 2138;
		2136 -> 2139;
		2136 -> 2140;
	2137 [label="완전히 이해하오. 그리고 그대에게 최고의 일들만 있기를 바라겠소. 우리가 함께 보낸 모든 순간들을 소중히 간직할 거요.",shape=box,color=blue];
		2137 -> 2141;
	2138 [label="처음엔 아무 말도 하지 않던 사람이, 정말 말이 많아졌네.",shape=box,color=red];
		2138 -> 2142;
	2139 [label="그 점을 사랑스럽다고 여기니까, 걱정하지 마.",shape=box,color=red];
		2139 -> 2143;
	2140 [label="그냥 \"우리가 각자의 길을 가게 되더라도, 난 괜찮을 거요.\" 라고 말할 수도 있었을 거야.",shape=box,color=red];
		2140 -> 2144;
	2141 [label="내 마음 속에서 기억들이 사라져도, 내 영혼으로 기억할 것이오. 안녕히.",shape=box,color=blue];
		2141 -> 2145;
	2142 [label="+5 Chemistry",color=orange];
		2142 -> 2146;
	2143 [label="+5 Chemistry",color=orange];
		2143 -> 2147;
	2144 [label="+5 Chemistry",color=orange];
		2144 -> 2148;
	2145 [label="Update boolean LyonDating",color=orange];
		2145 -> 2149;
	2146 [label="하! 내 머릿속을 들여다보고 싶지 않았으면, 함부로 여기저기 찌르고 다니지 말았어야지. 그건 전적으로 그대 책임이오.",shape=box,color=blue];
		2146 -> 2150;
	2147 [label="나의 그런 점을 사랑스럽게 여겨주어 기쁘게 생각하고 있다오. 내가 말을 거의 안 하는 이유가 바로 그 점이오. 이 모든 이야기를 직접 듣는다면 어떨지 상상이나 가오? 마리였다면 벌써 몇 년도 전에 미친개를 처리하듯 때려눕혔겠지.",shape=box,color=blue];
		2147 -> 2150;
	2148 [label="그대도 본래 어느 정도 불경스러우면서도 비꼬는 태도를 가지고 있는데, 난 절대 따라잡을 수 없을 거요. 그 쪽은 그대에게 맡기겠소.",shape=box,color=blue];
		2148 -> 2150;
	2149 [label="Update boolean IsDating",color=orange];
		2149 -> 2151;
	2150 [label="그럼에도 불구하고, 이 모든 것은 단지 이어지는 이야기의 서곡일 뿐, 그에 비하면 이야기는 매우 짧소...",shape=box,color=blue];
		2150 -> 2152;
	2151 [label="- 리온",shape=box,color=blue];
		2151 -> 2153;
	2152 [label="어젯밤 악몽에 시달리다 일어났소. 깨어나니 그림자가 날 에워싸더이다. 내 정신 상태에선 전혀 낯설거나 새로운 게 아니었으니. 그림자는 침대 위로 드리워져 걷히지 않았소.",shape=box,color=blue];
		2152 -> 2154;
	2153 [label="Chat ends.",color=orange];
	2154 [label="그들이 두렵지 않았소. 그들이 날 해칠 수 없다는 것을 알았으니까. 하지만 그렇다고 내 마음에서 사라지진 않겠지. 그들을 없앨 수 있는 사람은 오직 한 명뿐이오.",shape=box,color=blue];
		2154 -> 2155;
	2155 [label="침대에서 몸을 일으켜, 계속되는 악몽으로 흐릿해진 시야를 뚫고 비틀거리며 앞으로 나아가 간신히 옷을 입었소. 향로를 움켜쥐고 바닥 한가운데 무릎을 꿇고... 준비를 했지. ",shape=box,color=blue];
		2155 -> 2156;
	2156 [label="\"내 정신을 맑게 해주는\" 준비를 했지. 이 이상은 설명하지 않겠소.",shape=box,color=blue];
		2156 -> 2157;
	2157 [label="하지만 눈을 감는 순간, 내 정신은 딴 데로 쏠리더이다. 내 생각이... 그대에게로 흘러갔소, mon miracle...",shape=box,color=blue];
		2157 -> 2158;
	2158 [label="그대의 목소리, 내 어깨에 닿던 그대의 손길... ",shape=box,color=blue];
		2158 -> 2159;
	2159 [label="그리고 그 환상들이... 달아나 버렸소. 그들은 자리를 버리고, 더 강한... 그대라는 유령에게 쫓겨났소.",shape=box,color=blue];
		2159 -> 2160;
	2160 [label="난... 일어섰소. 향로를 침대 옆 탁자 위에 올려두고... 성역의 모래사장을 걷기로 결정했다오...",shape=box,color=blue];
		2160 -> 2161;
		2160 -> 2162;
	2161 [label="이제야 당신이 왜 서문이 필요했는지 알 것 같네.",shape=box,color=red];
		2161 -> 2163;
	2162 [label="뭐라 말해야 할지 모르겠어...",shape=box,color=red];
		2162 -> 2164;
	2163 [label="뭐, 그런 셈이오. 걷는 도중... 그러한 순간의 어두운 위험에 대해 바로 깨달았소. 그대가... 그걸 책임감으로 생각하게 될지도 모른다는 생각 - 그대 스스로를 날 짓누르는 사슬로 여기게 될지도 모른다는 생각 말이오.",shape=box,color=blue];
		2163 -> 2165;
	2164 [label="+5 Chemistry",color=orange];
		2164 -> 2166;
	2165 [label="그대에게 간청하오 - 높고 낮은 곳에 있는 그 어떤 신이나 신들에게 바라오 - 그대가 결코 그러지 말기를. 이는 그대가 내게 준 선물이며, 매번 새롭게 태어날 때마다 소중히 간식하겠소.",shape=box,color=blue];
		2165 -> 2167;
	2166 [label="아무 말도 하지 않아도 되오, mon miracle... ",shape=box,color=blue];
		2166 -> 2168;
	2167 [label="맹세해 주시오, mon miracle - 내가 그대에게 공허한 감옥이 되는 때가 오면... 나로부터 자유로워지겠다고.",shape=box,color=blue];
		2167 -> 2169;
	2168 [label="걷는 도중... 그러한 순간의 어두운 위험에 대해 바로 깨달았소. 그대가... 그걸 책임감으로 생각하게 될지도 모른다는 생각 - 그대 스스로를 날 짓누르는 사슬로 여기게 될지도 모른다는 생각 말이오.",shape=box,color=blue];
		2168 -> 2165;
	2169 [label="난 내가 사랑하는 이들에게 있어서 공허한 감옥이 되지 않을 거요. 그대에게도, 마리에게도.",shape=box,color=blue];
		2169 -> 2170;
		2169 -> 2171;
	2170 [label="[헤어진다.] 난 - 난 못하겠어. 약속 못하겠어, 미안해.",shape=box,color=red];
		2170 -> 2172;
	2171 [label="맹세할게. ",shape=box,color=red];
		2171 -> 2173;
	2172 [label="+10 Chemistry",color=orange];
		2172 -> 2174;
	2173 [label="+10 Chemistry",color=orange];
		2173 -> 2175;
	2174 [label="고맙소. 솔직하게 말해주어 정말로 고맙소, mon miracle. 이 순간엔 용기가 필요했고, 그에 응한 그대의 마음을 칭찬하는 바요.",shape=box,color=blue];
		2174 -> 2176;
	2175 [label="고맙소. 정말로 고맙소, mon miracle...",shape=box,color=blue];
		2175 -> 2177;
	2176 [label="우리가 함께 보낸 모든 순간들을 소중히 간직할 거요. 그대가 생각할 수 있는 이상으로 소중하게.",shape=box,color=blue];
		2176 -> 2178;
	2177 [label="갑자기 너무 피곤해 지는데, 마치... 어깨에서 무거운 짐이 내려진 것 같기도... 가서 좀 누워야겠소.",shape=box,color=blue];
		2177 -> 2179;
	2178 [label="내 마음 속에서 그 추억들이 사라져도, 내 영혼으로 기억할 것이오. 안녕히.",shape=box,color=blue];
		2178 -> 2180;
	2179 [label="- 리온",shape=box,color=blue];
		2179 -> 2181;
	2180 [label="Update boolean LyonDating",color=orange];
		2180 -> 2182;
	2181 [label="Update boolean LyonDatingConfession",color=orange];
