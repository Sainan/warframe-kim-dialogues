		j3594191379 -> j2749899811 [label="LyonDating",color=purple];
		j3594191379 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j2749899811 [label="Mon miracle, 내가... 이 다음 일화를 들려주기 전에 그대가 이해했는지에 대해 꼭 확인해야겠소. ",shape=box,color=blue];
		j2749899811 -> j1441744786;
	j1441744786 [label="이제부터 내가 내뱉는 말에 귀을 기울여야 할거요. 이해했소?",shape=box,color=blue];
		j1441744786 -> j1991587808;
		j1441744786 -> j2170037571;
	j1991587808 [label="너 때문에 긴장돼, 뭐가 문젠데?",shape=box,color=red];
		j1991587808 -> j405584072;
	j2170037571 [label="응, 여기 있으니까. 얘기해 줘.",shape=box,color=red];
		j2170037571 -> j1460253285;
	j405584072 [label="아무 문제도 없소 - 오히려 그 반대지. 바로 그점이 이해해야 할 중요한 지점이며 - 내가 그대를 해방시켜주고 싶은 끔찍한 결과요. 만약 그대가 그런 일이 뒤따를 것이라고 고려하고 있다면 말이오.",shape=box,color=blue];
		j405584072 -> j1588454011;
		j405584072 -> j2013360792;
		j405584072 -> j3089292993;
	j1460253285 [label="+5 Chemistry",color=orange];
		j1460253285 -> j3775822608;
	j1588454011 [label="듣고 있어.",shape=box,color=red];
		j1588454011 -> j2424147191;
	j2013360792 [label="뭔 말인지 모르겠어.",shape=box,color=red];
		j2013360792 -> j3867880110;
	j3089292993 [label="뭐에... 관한 끔찍한 결과인데?",shape=box,color=red];
		j3089292993 -> j311662101;
	j3775822608 [label="고맙소. 시작하기에 앞서, 아무 문제가 없다는 점을 말씀드리고 싶소 - 하지만 그대에게 밝히고 싶은 끔찍한 결과가 여기에 있소. 만약 그대가 그런 일이 뒤따를 것이라고 고려하고 있다면 말이오.",shape=box,color=blue];
		j3775822608 -> j1588454011;
		j3775822608 -> j2013360792;
		j3775822608 -> j3089292993;
	j2424147191 [label="+5 Chemistry",color=orange];
		j2424147191 -> j3453312730;
	j3867880110 [label="맞소. 나 또한 이 점을 뼈저리게 느끼고 있으니.",shape=box,color=blue];
		j3867880110 -> j311662101;
	j311662101 [label="다시 시작하겠소.",shape=box,color=blue];
		j311662101 -> j3453312730;
	j3453312730 [label="많은 이들이 내가... 그리 좋지 않은 상태라 생각할 수 있고, 실제로도 그럴 가능성이 높다는 걸... 알고 있소. 적어도, 내 정신이 온전한 상태라 할 수는 없겠지.",shape=box,color=blue];
		j3453312730 -> j2582382819;
	j2582382819 [label="나는 이 점에 대해 마음의 평안을 가지기로 한지 오래요. 더 이상 내게 괴로울 거리가 되지 못하지. 나를 괴롭히는 그 환상, 그 목소리들... 나는 두려움이나 증오 없이 그것들과 공생하는 방법을 터득하게 되었소.",shape=box,color=blue];
		j2582382819 -> j3238819006;
	j3238819006 [label="(최근들어, 솔직히 말하자면 약간의 앙심 때문인 듯도 하지만, 어쨌든 그게 중요한 건 아니지.)",shape=box,color=blue];
		j3238819006 -> j2236529383;
	j2236529383 [label="하지만 그대가 우리 사이의 이 관계 - 이전에 나와 다른 이 사이에 불가능하다고 생각했던 관계 - 를 끝내려고 한다면,",shape=box,color=blue];
		j2236529383 -> j2142624175;
	j2142624175 [label="어느 날 너의 마음이 정말로 나에게서 멀어진다면? ",shape=box,color=blue];
		j2142624175 -> j4255094378;
	j4255094378 [label="나는 견뎌낼 거요, mon miracle.",shape=box,color=blue];
		j4255094378 -> j2515005130;
	j2515005130 [label="나는 나를 괴롭히는 것들에 휩쓸리지 않을 것이오. ",shape=box,color=blue];
		j2515005130 -> j2851720794;
	j2851720794 [label="Check boolean LyonAllRight",color=orange];
		j2851720794 -> j1849745682 [label=true,color=green];
		j2851720794 -> j1333533698 [label=false,color=brown];
	j1849745682 [label="그대가 했던 표현을 빌리자면, \"괜찮을 거요.\" 다시 한번 웃고 떠들 수 있는 이유를 찾을 것이오.",shape=box,color=blue];
		j1849745682 -> j2203997231;
		j1849745682 -> j4294123375;
	j1333533698 [label="난 살아남을 거요. 잘 지낼 거고. 다시 한번 웃고 떠들 수 있는 이유를 찾을 것이오.",shape=box,color=blue];
		j1333533698 -> j2203997231;
		j1333533698 -> j4294123375;
	j2203997231 [label="오, 리온... 너는 나한테 짐 같은 존재가 아니야.",shape=box,color=red];
		j2203997231 -> j2966230349;
	j4294123375 [label="그러니까... 나하고의 관계를 끝내고 싶다는 뜻이야?",shape=box,color=red];
		j4294123375 -> j1996362367;
	j2966230349 [label="나는 그저 나 때문에 그대가 느낄지도 모르는 그 어떤 어려움이든 덜어 주고자 하는 것 뿐이외다...",shape=box,color=blue];
		j2966230349 -> j1887029443;
		j2966230349 -> j1803270956;
		j2966230349 -> j3899649568;
	j1996362367 [label="아니! 전혀 그런 게 아니오! 나는 그저 나 때문에 그대가 느낄지도 모르는 그 어떤 어려움이든 덜어 주고자 하는 것 뿐이외다.",shape=box,color=blue];
		j1996362367 -> j1887029443;
		j1996362367 -> j1803270956;
		j1996362367 -> j3899649568;
	j1887029443 [label="네가 가지고 있는 고통은...내가 가진 고통과 메아리쳐. 그 고통을 극복하도록 돕는 건 결코 어려운 일이 아닐 거야.",shape=box,color=red];
		j1887029443 -> j463084621;
	j1803270956 [label="무엇이 날 네게 이끌리게 만드는 지 설명할 수가 없어. 하지만 너는 결코 의무나 짐이 되지 않을 거야.",shape=box,color=red];
		j1803270956 -> j1341465821;
	j3899649568 [label="[헤어진다.] 이 모든 게 너무 힘들어지고 있어. 미안. 여기서 끝내는 게 나을 것 같아.",shape=box,color=red];
		j3899649568 -> j2266848814;
	j463084621 [label="그대 때문에 내 맘이 얼마나 아플지 말로 다 표현할 수가 없구려. 하지만 우리 외로운 고통의 유령들이 서로를 찾았다는 사실에 영원히 감사할 따름이오.",shape=box,color=blue];
		j463084621 -> j1542541183;
	j1341465821 [label="이 감사의 마음을 제대로 표현할 수 있는 방법이 없고, 어떤 말로도 표현할 수 없을 것 같소.",shape=box,color=blue];
		j1341465821 -> j1542541183;
	j2266848814 [label="알았소. 그렇겠지. 지금 시점에서... 다른 답변을 받아들이는 건... 위선일 거요... ",shape=box,color=blue];
		j2266848814 -> j1829629649;
	j1542541183 [label="하지만 이미 극단적인 자기만족을 위해서라고밖에 표현할 수 없는 이 서문을 쓰기 위해 많은 노력을 기울였으니...",shape=box,color=blue];
		j1542541183 -> j2977012471;
		j1542541183 -> j2432535075;
		j1542541183 -> j874534722;
	j1829629649 [label="완전히 이해하오. 그리고 그대에게 최고의 일들만 있기를 바라겠소. 우리가 함께 보낸 모든 순간들을 소중히 간직할 거요.",shape=box,color=blue];
		j1829629649 -> j2161173424;
	j2977012471 [label="처음엔 아무 말도 하지 않던 사람이, 정말 말이 많아졌네.",shape=box,color=red];
		j2977012471 -> j1379124705;
	j2432535075 [label="그 점을 사랑스럽다고 여기니까, 걱정하지 마.",shape=box,color=red];
		j2432535075 -> j3822012864;
	j874534722 [label="그냥 \"우리가 각자의 길을 가게 되더라도, 난 괜찮을 거요.\" 라고 말할 수도 있었을 거야.",shape=box,color=red];
		j874534722 -> j2121740550;
	j2161173424 [label="내 마음 속에서 기억들이 사라져도, 내 영혼으로 기억할 것이오. 안녕히.",shape=box,color=blue];
		j2161173424 -> j3487055388;
	j1379124705 [label="+5 Chemistry",color=orange];
		j1379124705 -> j2748783191;
	j3822012864 [label="+5 Chemistry",color=orange];
		j3822012864 -> j81629468;
	j2121740550 [label="+5 Chemistry",color=orange];
		j2121740550 -> j3514686468;
	j3487055388 [label="Boolean LyonDating is now false.",color=orange];
		j3487055388 -> j120569796;
	j2748783191 [label="하! 내 머릿속을 들여다보고 싶지 않았으면, 함부로 여기저기 찌르고 다니지 말았어야지. 그건 전적으로 그대 책임이오.",shape=box,color=blue];
		j2748783191 -> j971370474;
	j81629468 [label="나의 그런 점을 사랑스럽게 여겨주어 기쁘게 생각하고 있다오. 내가 말을 거의 안 하는 이유가 바로 그 점이오. 이 모든 이야기를 직접 듣는다면 어떨지 상상이나 가오? 마리였다면 벌써 몇 년도 전에 미친개를 처리하듯 때려눕혔겠지.",shape=box,color=blue];
		j81629468 -> j971370474;
	j3514686468 [label="그대도 본래 어느 정도 불경스러우면서도 비꼬는 태도를 가지고 있는데, 난 절대 따라잡을 수 없을 거요. 그 쪽은 그대에게 맡기겠소.",shape=box,color=blue];
		j3514686468 -> j971370474;
	j120569796 [label="Boolean IsDating is now false.",color=orange];
		j120569796 -> j1696229132;
	j971370474 [label="그럼에도 불구하고, 이 모든 것은 단지 이어지는 이야기의 서곡일 뿐, 그에 비하면 이야기는 매우 짧소...",shape=box,color=blue];
		j971370474 -> j506265622;
	j1696229132 [label="- 리온",shape=box,color=blue];
		j1696229132 -> "Chat ends.";
	j506265622 [label="어젯밤 악몽에 시달리다 일어났소. 깨어나니 그림자가 날 에워싸더이다. 내 정신 상태에선 전혀 낯설거나 새로운 게 아니었으니. 그림자는 침대 위로 드리워져 걷히지 않았소.",shape=box,color=blue];
		j506265622 -> j1837682944;
	j1837682944 [label="그들이 두렵지는 않았소. 날 해칠 수 없다는 것을 알았으니까. 하지만 그렇다고 내 마음에서 사라지는 것 또한 아니었지. 내가 아는 한, 그들을 없앨 수 있는 방법은 오직 하나 뿐이었소.",shape=box,color=blue];
		j1837682944 -> j3225513997;
	j3225513997 [label="침대에서 몸을 일으켜, 계속되는 악몽으로 흐릿해진 시야를 뚫고 비틀거리며 앞으로 나아가 간신히 옷을 입었소. 향로를 움켜쥐고 바닥 한가운데 무릎을 꿇고... 준비를 했지. ",shape=box,color=blue];
		j3225513997 -> j4042838831;
	j4042838831 [label="\"내 정신을 맑게 해주는\" 준비를 했지. 이 이상은 설명하지 않겠소.",shape=box,color=blue];
		j4042838831 -> j709514555;
	j709514555 [label="하지만 눈을 감는 순간, 내 정신은 딴 데로 쏠리더이다. 내 생각이... 그대에게로 흘러갔소, mon miracle...",shape=box,color=blue];
		j709514555 -> j471125834;
	j471125834 [label="그대의 목소리, 내 어깨에 닿던 그대의 손길... ",shape=box,color=blue];
		j471125834 -> j859280204;
	j859280204 [label="그리고 그 환상들이... 달아나 버렸소. 그들은 자리를 버리고, 더 강한... 그대라는 유령에게 쫓겨났소.",shape=box,color=blue];
		j859280204 -> j2456982616;
	j2456982616 [label="난... 일어섰소. 향로를 침대 옆 탁자 위에 올려두고... 성역의 모래사장을 걷기로 결정했다오...",shape=box,color=blue];
		j2456982616 -> j1124733846;
		j2456982616 -> j459015309;
	j1124733846 [label="이제야 네가 왜 서문이 필요했는지 알 것 같네.",shape=box,color=red];
		j1124733846 -> j134386962;
	j459015309 [label="뭐라 말해야 할지 모르겠어...",shape=box,color=red];
		j459015309 -> j3614642944;
	j134386962 [label="뭐, 그런 셈이오. 걷는 도중... 그러한 순간의 어두운 위험에 대해 바로 깨달았소. 그대가... 그걸 책임감으로 생각하게 될지도 모른다는 생각 - 그대 스스로를 날 짓누르는 사슬로 여기게 될지도 모른다는 생각 말이오.",shape=box,color=blue];
		j134386962 -> j2392501046;
	j3614642944 [label="+5 Chemistry",color=orange];
		j3614642944 -> j1869698946;
	j2392501046 [label="그대에게 간청하오 - 높고 낮은 곳에 있는 그 어떤 신이나 신들에게 바라오 - 그대가 결코 그러지 말기를. 이는 그대가 내게 준 선물이며, 매번 새롭게 태어날 때마다 소중히 간식하겠소.",shape=box,color=blue];
		j2392501046 -> j1239528961;
	j1869698946 [label="아무 말도 하지 않아도 되오, mon miracle... ",shape=box,color=blue];
		j1869698946 -> j2159741253;
	j1239528961 [label="맹세해 주시오, mon miracle - 내가 그대에게 공허한 감옥이 되는 때가 오면... 나로부터 자유로워지겠다고.",shape=box,color=blue];
		j1239528961 -> j1495040387;
	j2159741253 [label="걷는 도중... 그러한 순간의 어두운 위험에 대해 바로 깨달았소. 그대가... 그걸 책임감으로 생각하게 될지도 모른다는 생각 - 그대 스스로를 날 짓누르는 사슬로 여기게 될지도 모른다는 생각 말이오.",shape=box,color=blue];
		j2159741253 -> j2392501046;
	j1495040387 [label="난 내가 사랑하는 이들에게 있어서 공허한 감옥이 되지 않을 거요. 그대에게도, 마리에게도.",shape=box,color=blue];
		j1495040387 -> j3408803336;
		j1495040387 -> j190665690;
	j3408803336 [label="[헤어진다.] 난 - 난 못하겠어. 약속 못하겠어, 미안해.",shape=box,color=red];
		j3408803336 -> j1120689221;
	j190665690 [label="맹세할게. ",shape=box,color=red];
		j190665690 -> j2833759395;
	j1120689221 [label="+10 Chemistry",color=orange];
		j1120689221 -> j3521785243;
	j2833759395 [label="+10 Chemistry",color=orange];
		j2833759395 -> j1786804069;
	j3521785243 [label="고맙소. 솔직하게 말해주어 정말로 고맙소, mon miracle. 이 순간엔 용기가 필요했고, 그에 응한 그대의 마음을 칭찬하는 바요.",shape=box,color=blue];
		j3521785243 -> j3117580707;
	j1786804069 [label="고맙소. 정말로 고맙소, mon miracle...",shape=box,color=blue];
		j1786804069 -> j3022108118;
	j3117580707 [label="우리가 함께 보낸 모든 순간들을 소중히 간직할 거요. 그대가 생각할 수 있는 이상으로 소중하게.",shape=box,color=blue];
		j3117580707 -> j1511229437;
	j3022108118 [label="갑자기 너무 피곤해 지는데, 마치... 어깨에서 무거운 짐이 내려진 것 같기도... 가서 좀 누워야겠소.",shape=box,color=blue];
		j3022108118 -> j3033017295;
	j1511229437 [label="내 마음 속에서 그 추억들이 사라져도, 내 영혼으로 기억할 것이오. 안녕히.",shape=box,color=blue];
