	j2840117677 [label="당신과 어울리기로 결심한 사람들 모두 자선 활동 한다고 생각하는 거야?",shape=box,color=red];
		j2840117677 -> j1955471069;
	j243769519 [label="질문하기도 전에 그대 안에 드는 의문점을 알고 있소. 엔트라티는 무슨 계략을 꾸몄던 거지? 홀바니아에서 그랬던 것처럼, 도시도 감염시켰던 걸까? 계획이 뭐였을까? 어떤 발견을 했을까?",shape=box,color=blue];
