		576 -> 580;
	581 [label="흠. 미치광이와 광인으로 인해 그대의 정신이 더럽혀지는게 싫지 않소? 궁금하군. 그럼에도 말하는 동물들과... 시대를 초월한 존재들과 어울리는 것 같던데. 아마 나도 그대의 다른 이들보다 더 이상하거나 덜 이상하진 않겠지.",shape=box,color=blue];
		581 -> 582;
	578 [label="미치광이와 광인이 그대의 \"중립적\" 의견의 유일한 원천이라, 그대가 얼마나 현명한 선택지를 찾지 못했는지 잘 알겠소. 왜 굳이 나에게 말을 거는지 도무지 이해가 안 가지만.",shape=box,color=blue];
		578 -> 582;
	579 [label="왜 굳이 나에게 말을 걸려고 하는거요? 그럴 필요가 없다는 거 그대도 잘 알고 있잖소. 마리와 친구가 되고 싶거나 - 심지어 구애를 하고 싶다면 -, 난 마리의 보호자도 아버지도 아니니 그리하시오. 그대가 망할 로스에게 무슨 의도를 품고 있든, 그자가 내게 갚아야 할 답 외에는 관심 없소.",shape=box,color=blue];
		579 -> 582;
	580 [label="\"진실.\" 요즘들어 그 단어가 얼마나 웃기게 들리는지 이해해줬으면 하오. 미치광이와 광인으로 인해 그대의 정신이 더럽혀지는게 싫지 않소? 궁금하군. 그럼에도 말하는 동물들과... 시대를 초월한 존재들과 어울리는 것 같던데. 아마 나도 그대의 다른 이들보다 더 이상하거나 덜 이상하진 않겠지.",shape=box,color=blue];
