		j3307858394 -> j3009646029 [label="false",color=purple];
	j3946322479 [label="허. 그런 식으로는 생각해 본 적 없지만, 그렇소 - 어쩌면 그랬을지도. 모두에게는 정말 화가 날 만한 일인 거 아오. 우리가 엔트라티의 진짜 모습에 대해 아는 바가 거의 없는 것과 딱 들어맞는 것 같기도.",shape=box,color=blue];
