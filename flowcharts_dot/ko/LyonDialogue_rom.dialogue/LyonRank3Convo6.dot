		j1834534198 -> j3730950839;
	j1365253276 [label="다른 이들은 그 폭풍우를 느끼지 못했을 거라는 걸 잘 알고 있지만, 내 감각엔 매우 생생하게 느껴졌소.",shape=box,color=blue];
		j1365253276 -> j3999922724;
	j3999922724 [label="그로부터 정확히 1년 후, 엔트라티는 마지막으로 다시 나타났는데... 로스가 그의 발치에 의식을 잃은 채 쓰러져 있었소. 지금의 모습 그대로.",shape=box,color=blue];
		j3999922724 -> j2610477030;
