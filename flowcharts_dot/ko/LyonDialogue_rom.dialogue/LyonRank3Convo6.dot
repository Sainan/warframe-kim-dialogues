		j3780653293 -> j760892383;
	j1941664685 [label="로스가 깨어났소. 처음엔, 자신의 이름도 거의 기억해내지 못했소. 엔트라티는 빌어먹을 그 존재에게 작별 인사를 건넸지. \"우리엘, 자타의 이단자여, 그대 추방된 이여, 답하라 - 오로킨은 과연 용서받을 수 있는가?\"",shape=box,color=blue];
		j1941664685 -> j420968254;
	j43647212 [label="모든 걸 후회하오, 드리프터. 맞소, 물론이고 말고. 하지만 또 이걸 반복해야 한다면? 물론, 다시하고 말고. 마리를 혼자 둘 순 없으니.",shape=box,color=blue];
		j43647212 -> j2332374955;
	j760892383 [label="이 점에선, 우리 의견이 일치하는군. 하지만 나도 그녀를 탓할 순 없소. 마리에게 시간 좀 주시오. 곧 이해하게 될 터이니. 마리는 굉장히 총명하오, 드리프터. 바보 취급하지 말도록.",shape=box,color=blue];
		j760892383 -> j2332374955;
	j420968254 [label="엔트라티는 투약 후에 떠났소. 그리고 로스와 우리는 함께 버려졌고, 이제 그대가 보는 지금의 모습으로 새롭게 변했으니 - 변덕스러운 악마와 더 잘 맞설 수 있게 된거지.",shape=box,color=blue];
		j420968254 -> j4238221149;
	j2332374955 [label="이야기를 마무리 짓자면… 엔트라티는 투약 후에 떠났소. 그리고 로스와 우리는 함께 버려졌고, 이제 그대가 보는 지금의 모습으로 새롭게 변했으니 - 변덕스러운 악마와 더 잘 맞설 수 있게 된거지.",shape=box,color=blue];
