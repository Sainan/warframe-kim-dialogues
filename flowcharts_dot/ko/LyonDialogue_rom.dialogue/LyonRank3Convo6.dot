	j3041572237 [label="마리는 그 혈청을 기꺼이 받아들였소. 물론, 그럴 수밖에. 어찌 그러지 않을 수 있겠소? 그리고 나 또한 어찌 그녀를 따르지 않을 수 있겠소? 그 결말이 어디로 향한다 한들, 내 어찌 그 진실을 쫓지 않을 수 있겠냔 말이오?",shape=box,color=blue];
