		j3009646029 -> j2318610844;
	j2925812147 [label="3년, 2개월, 그리고 11일 동안, 엔트라티는 우리 대성당에서 Cardinal Dimanche로서 재직하였소. 그리고 그 모든 시간 동안, 마리와 나는 그가 우리를 가지고 무슨 계획을 꾸미고 있는지도 모른 채 그를 섬겼지.",shape=box,color=blue];
		j2925812147 -> j757155637;
	j2377192664 [label="허나 예상했겠지만, 미치광이에게 간단한 질문을 던지면 종종 엉뚱한 길로 빠지는 법이오. 내 주제에서 벗어나 본래 주제로 돌아가도록 하지.",shape=box,color=blue];
		j2377192664 -> j2925812147;
	j2318610844 [label="그 당시 내 눈엔, 진짜 악마로 느껴졌지. 엔트라티가 자신이 누구인지, 어느 시간으로부터 왔는지, 그리고 우리에게 맡기고자 하는 \"진정한 사명\"을 밝힌 것은 바로 그 때였소.",shape=box,color=blue];
