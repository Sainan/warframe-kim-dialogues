		j1854672896 -> j2944665401;
	j4191567209 [label="너와 어울리기로 결심한 사람들 모두 자선 활동 한다고 생각하는 거야?",shape=box,color=red];
		j4191567209 -> j1955471069;
	j757155637 [label="그대가 굳이 묻기 전부터도 그대에게 떠오르는 의문을 알 것 같소. 엔트라티는 무슨 계략을 꾸미고 있었나? 홀바니아에 그러했다고 하듯, 도시 전체를 감염시키기라도 했나? 그의 계획은 무엇이었지? 알아낸 것은?",shape=box,color=blue];
		j757155637 -> j3068185230;
	j152274966 [label="고해하고자 하는 것이 있소, 드리프터? 속죄하고 싶은 것이라도 있소?",shape=box,color=blue];
		j152274966 -> j1773930397;
	j1176486542 [label="흠. 아니오. 아직은, 아마도.",shape=box,color=blue];
		j1176486542 -> j1090488093;
	j1090488093 [label="그대의 경박함은 거짓이 아니오. 그것은 자선의 의미를 가질 뿐. 자선은 내가 필요로 하지도, 원치도 않소. ",shape=box,color=blue];
		j1090488093 -> j1854672896;
		j1090488093 -> j4191567209;
	j2944665401 [label="직접 본인한테 가서 물어보는 게 가장 좋을 거요. 나도 종종 똑같은 생각을 하니까.",shape=box,color=blue];
