		j1272915177 -> j694211111;
	j3282148038 [label="마리는 혈청을 기꺼이 받아들였소. 당연하게, 받아들였소. 어떻게 안 그럴 수 있겠소? 그리고 내가 어찌 그녀를 따르지 않을 수 있겠소? 진실이 어디로 이끌든, 어떻게 내가 진실을 찾지 않을 수 있겠냔 말이오?",shape=box,color=blue];
		j3282148038 -> j1813802388;
