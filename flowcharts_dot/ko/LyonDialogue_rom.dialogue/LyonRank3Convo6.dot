	j3150688104 [label="그 3년과 며칠 후, 엔트라티는 끔찍한 폭풍 속으로 사라졌소. 그가 나타났을 때와 똑같은 폭풍이었지.",shape=box,color=blue];
		j3150688104 -> j3307858394;
	j3958682800 [label="다른 이의 마음 속 생각을 아는 것은 불가능하오. 그는 제단에 무릎을 꿇고 고개를 숙였소. 기도하고 있던 걸까? 아니면 그저 자신만의 생각에 잠겨 있던 걸까? 나는 알 길이 없소.",shape=box,color=blue];
