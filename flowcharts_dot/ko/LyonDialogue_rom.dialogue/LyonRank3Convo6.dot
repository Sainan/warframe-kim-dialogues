		j3767185399 -> j243769519;
	j3730950839 [label="허나 예상했겠지만, 미치광이에게 간단한 질문을 던지면 종종 엉뚱한 길로 빠지는 법이오. 내 주제에서 벗어나 본래 주제로 돌아가도록 하지.",shape=box,color=blue];
		j3730950839 -> j3767185399;
	j2610477030 [label="말 그대로 진짜 악마, 아니 당시엔 그리 보였소. 바로 그 때, 엔트라티는 자신이 누구인지, 언제 나타났는지, 그리고 우리에게 맡긴 진정한 사명이 무엇인지 말해 주었지.",shape=box,color=blue];
