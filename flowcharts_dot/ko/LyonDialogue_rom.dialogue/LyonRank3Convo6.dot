	j3049566607 [label="+5 Chemistry",color=orange];
		j3049566607 -> j2377192664;
	j3973473156 [label="다른 이들에겐 그 폭풍우가 존재하지 않았을 거라는 걸 잘 알고 있었지만, 내 감각엔 참으로 생생하게 느껴졌지.",shape=box,color=blue];
		j3973473156 -> j3009646029;
