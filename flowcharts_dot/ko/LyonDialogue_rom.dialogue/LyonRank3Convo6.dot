	j1451615402 [label="+5 Chemistry",color=orange];
		j1451615402 -> j3551375181;
	j2770809525 [label="마리는 공수병에 걸린 곰을 무릎에 끌어 안고 자신의 목이 찢어지든 내버려 둘 것이오. 그리하면 그 동물이 잠시나마 평화를 찾을 수 있을테니까.",shape=box,color=blue];
		j2770809525 -> j3088553279;
	j2291214673 [label="난난 그걸 실용주의에 대한 확고한 헌신이라고 고려하고 있지만, 그대가 원하는 대로 정의하시오.",shape=box,color=blue];
