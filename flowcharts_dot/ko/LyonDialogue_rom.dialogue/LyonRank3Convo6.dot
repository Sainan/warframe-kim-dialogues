	j432838890 [label="당신이 우리와 같은 시각으로 세상을 보지 못할 수도 있다는 경고를 받았어. 하지만 그런 점에 신경 쓰이진 않아. 당신이 뭘 아는지 궁금하니까.",shape=box,color=red];
		j432838890 -> j3974708462;
	j1572189151 [label="마리는 \"le Cardinal\"에 푹 빠진 것 같아. 로스는 분명 그런 마리를 싫어하는 것 같고. 이 중에서 중립적인 사고를 가진 사람을 찾고 있거든. 당신이 그 기준에 제일 가까운 사람이야.",shape=box,color=red];
		j1572189151 -> j3433812000;
	j678971760 [label="달리... 뭘 물어봐야 될지 모르겠어서?",shape=box,color=red];
		j678971760 -> j45178704;
	j1008204972 [label="당신이 우리와 같은 시각으로 세상을 보지 못할 수도 있다는 경고를 받았어. 그렇다면 당신이야말로 타인은 보지 못하는 진실을 볼 수도 있다는 거지.",shape=box,color=red];
		j1008204972 -> j2026903705;
	j3974708462 [label="흠. 미치광이와 광인으로 인해 그대의 정신이 더럽혀지는게 싫지 않소? 궁금하군. 그럼에도 말하는 동물들과... 시대를 초월한 존재들과 어울리는 것 같던데. 아마 나도 그대의 다른 이들보다 더 이상하거나 덜 이상하진 않겠지.",shape=box,color=blue];
		j3974708462 -> j2845885253;
	j3433812000 [label="미치광이와 광인이 그대의 \"중립적\" 의견의 유일한 원천이라, 그대가 얼마나 현명한 선택지를 찾지 못했는지 잘 알겠소. 왜 굳이 나에게 말을 거는지 도무지 이해가 안 가지만.",shape=box,color=blue];
		j3433812000 -> j2845885253;
	j45178704 [label="왜 굳이 나에게 말을 걸려고 하는거요? 그럴 필요가 없다는 거 그대도 잘 알고 있잖소. 마리와 친구가 되고 싶거나 - 심지어 구애를 하고 싶다면 -, 난 마리의 보호자도 아버지도 아니니 그리하시오. 그대가 망할 로스에게 무슨 의도를 품고 있든, 그자가 내게 갚아야 할 답 외에는 관심 없소.",shape=box,color=blue];
		j45178704 -> j2845885253;
	j2026903705 [label="\"진실.\" 요즘들어 그 단어가 얼마나 웃기게 들리는지 이해해줬으면 하오. 미치광이와 광인으로 인해 그대의 정신이 더럽혀지는게 싫지 않소? 궁금하군. 그럼에도 말하는 동물들과... 시대를 초월한 존재들과 어울리는 것 같던데. 아마 나도 그대의 다른 이들보다 더 이상하거나 덜 이상하진 않겠지.",shape=box,color=blue];
		j2026903705 -> j2845885253;
	j2845885253 [label="Evaluate expressions",color=orange];
		j2845885253 -> j368813934 [label="LyonFirstFlirt",color=purple];
		j2845885253 -> j368813934 [label="DrifterLyon",color=purple];
		j2845885253 -> j97743158 [label="LyonOffer",color=purple];
		j2845885253 -> j1610860404 [label="false",color=purple];
	j368813934 [label="그리고 제발, 우리 둘 다 또 한 번... 당황스러운 순간을 겪지 않게 해주오, 그래주겠소? 그대가 나에게 말을 건 이유가 바로 그거라는 거 아오. 그 말이 기분 좋게 들리지만서도, 동시에 터무니없을 정도의 경박함이 내 신경을 긁고 있소.",shape=box,color=blue];
		j368813934 -> j133987842;
		j368813934 -> j270011129;
		j368813934 -> j902706963;
	j97743158 [label="그리고 제발, 그대의 \"나를 돕고 싶다\"는 우리 관계에 대한 설교는 그만해줬음 하오, 그래주겠소? 그대가 친절히 대하려는 의도는 분명 파악하였으나, 터무니없을 정도의 경박함이 내 신경을 긁고 있소.",shape=box,color=blue];
		j97743158 -> j133987842;
		j97743158 -> j270011129;
		j97743158 -> j902706963;
	j1610860404 [label="그리고 제발, 그대의 \"나를 돕고 싶다\"거나 \"나와 친구가 되고 싶다\"식의 장황한 설교는 자제해 줬음 하오. 그대가 친절히 대하려는 의도는 분명 파악하였으나, 터무니없을 정도의 경박함이 내 신경을 긁고 있소.",shape=box,color=blue];
		j1610860404 -> j133987842;
		j1610860404 -> j270011129;
		j1610860404 -> j902706963;
	j133987842 [label="내가 하는 말이 진심이 아니라고 해서 경박한게 되는 거야? 아니면 내가 당신에 대해 진심일 수 없다고 생각해서야?",shape=box,color=red];
		j133987842 -> j1756347758;
	j270011129 [label="신부님. 내가 알고 싶었던 건 엔트라티가 얼마나 오랫동안 추기경 행세를 했는지에 대한 이야기 뿐이야. 그게 다라고.",shape=box,color=red];
		j270011129 -> j4102134309;
	j902706963 [label="\"경박함\"이라니, 뭔 뜻이야? 지금 나보고 거짓말쟁이라고 부른 거야?",shape=box,color=red];
		j902706963 -> j5625625;
	j1756347758 [label="둘 다 아니오. 그대의 말들은 내가 필요로 하지도, 원하지도 않는 자선이오.",shape=box,color=blue];
		j1756347758 -> j1854672896;
		j1756347758 -> j2840117677;
	j4102134309 [label="뭐 괜찮겠지. 3년 2개월 11일 동안 엔트라티는 우리 대성당에서 Cardinal Dimanche로서 재직하였소. 그리고 그 모든 시간 동안 마리와 나는 그가 우리를 위해 무슨 계획을 가지고 있는지도 모른 채 그를 섬겼소.",shape=box,color=blue];
