	1839 [label="결국, \"격정 범죄\"라는 단어가 만들어진 데에는 다 이유가 있는 법이오. 만약 우리가 스스로의 신념을 고수하지 않는다면, 삶은 끔찍하게 지루하겠지.",shape=box,color=blue];
		1839 -> 1844;
	1838 [label="그랬소. 우리는 매일 밤 그날 있었던 일들에 대해 얘기한다오. 그대와의 대화가 끝나자마자 마리가 재빨리 내 곁으로 와서는 그 일에 대한 자신의 생각을 전부 말해줬으니.",shape=box,color=blue];
		1838 -> 1842;
