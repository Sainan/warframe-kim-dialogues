	j3486458065 [label="그대를 돕기 위해 최선을 다하겠지만, 그점이 그대에게 도움이 되지는 않을 것 같구려.",shape=box,color=blue];
		j3486458065 -> j1980782443;
	j1708423550 [label="처음이야 분명 아프겠지. 부러진 뼈 맞추듯이 말이야. 하지만 이런 상처가 제대로 낫는 유일한 방법이기도 해.",shape=box,color=red];
		j1708423550 -> j1584912135;
	j133269272 [label="우리의 단결로 인한 이점이 분리로 인한 단점보다 더 크다고 생각해.",shape=box,color=red];
		j133269272 -> j1584912135;
	j1960547125 [label="아니, 그렇지만 난 도움이 필요한 사람들을 보호하는 일을 하고 있어. 그들과 이곳을 영원히 속삭임과 감염으로부터 지킬 수는 없는 일이잖아. 하지만 당신이랑 마리, 그리고 로스라면 - 할 수 있을지도 몰라.",shape=box,color=red];
		j1960547125 -> j1584912135;
	j4182622616 [label="엔트라티를 꼭 믿는 건 아니지만 - 그래도 그 인간이 우리의 적이라고는 생각 안 들어. 전쟁이 다가오고 있고, 우리는 모두 마땅히 있어야 할 자리에 앉아 있어야 할 것 같아. 바로 이곳이 우리가 있어야 할 자리야.",shape=box,color=red];
		j4182622616 -> j3273270103;
