		1896 -> 1902;
	1897 [label="음. 그럴지도. 하지만 우리 모두는 체스 말이 아니고, 그리 취급되는 걸 거부하오. 엔트라티가 그런 호소를 하고 싶었다면, 빌어먹을 편지라도 보냈어야 했소.",shape=box,color=blue];
		1897 -> 1903;
	1900 [label="그 빌어먹을 개자식은 - 그 주둥아리를 다물게 할 수 있는 방법을 내가 아무리 찾을려고 해봐도 - 유용하긴 하오.",shape=box,color=blue];
		1900 -> 1905;
	1898 [label="그렇겠지...",shape=box,color=red];
		1898 -> 1900;
	1899 [label="왜 로스가 이 모든 일에서 그렇게 중요한 건데?",shape=box,color=red];
		1899 -> 1904;
	1901 [label="- 리온",shape=box,color=blue];
		1901 -> 1906;
	1902 [label="맞소. 현명한 말이오. 잘 알겠소. 내가 마리와 대화해 보겠소. 이 문제에 대해 다시 이야기하도록 설득해 보겠소.",shape=box,color=blue];
