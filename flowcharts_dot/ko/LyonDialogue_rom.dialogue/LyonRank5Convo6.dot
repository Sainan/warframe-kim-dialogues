		j3604043618 -> j1960547125;
		j3604043618 -> j4182622616;
	j3497962379 [label="Boolean LyonFamilyFail is now true.",color=orange];
		j3497962379 -> "Chat ends.";
	j884161754 [label="M. 로이드와 엔트라티의 소원해진 가족 사이의 일이 어찌 전개될지는 모르겠소. 다만 내 도움이 필요하면 언제든 도와드리리다.",shape=box,color=blue];
		j884161754 -> j2800191596;
