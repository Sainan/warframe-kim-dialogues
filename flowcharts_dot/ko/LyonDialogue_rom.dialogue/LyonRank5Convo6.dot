	j2497600713 [label="마리가 전부 말했겠지, 그치?",shape=box,color=red];
		j2497600713 -> j3748066086;
	j2056526130 [label="마리에게 네크라마이트를 사용해서 가구를 복제하는 걸 멈춰달라고 설득해 주시오. 이 의자들을 어찌 해야 할지 모르겠소.",shape=box,color=blue];
		j2056526130 -> j3315564048;
	j157104987 [label="결국, \"격정 범죄\"라는 단어가 만들어진 데에는 다 이유가 있는 법이오. 만약 우리가 스스로의 신념을 고수하지 않는다면, 삶은 끔찍하게 지루하겠지.",shape=box,color=blue];
		j157104987 -> j3649000286;
	j3748066086 [label="그랬소. 우리는 매일 밤 그날 있었던 일들에 대해 얘기한다오. 그대와의 대화가 끝나자마자 마리가 재빨리 내 곁으로 와서는 그 일에 대한 자신의 생각을 전부 말해줬으니.",shape=box,color=blue];
		j3748066086 -> j1897754482;
		j3748066086 -> j3397345122;
	j3315564048 [label="+20 Chemistry",color=orange];
		j3315564048 -> j2637106157;
	j3649000286 [label="분명 더 조용하고, 더 평화로운 세상이겠지. 하지만 지루할 것이오. 예술이라고 할 만한 것도 없을 것이오.",shape=box,color=blue];
		j3649000286 -> j2734593025;
	j1897754482 [label="마리가 뭐라 말했는데?",shape=box,color=red];
		j1897754482 -> j3495933037;
	j3397345122 [label="... 그리고?",shape=box,color=red];
		j3397345122 -> j3495933037;
	j2637106157 [label="그리고 난... 로스의 육신 어딘가에 깊숙히 박아줘야 하는지도 모를 다채로운 제안에 마리를 데려가는 점을 거부하는 바요.",shape=box,color=blue];
		j2637106157 -> "Chat ends.";
	j2734593025 [label="딴 주제로 넘어가 버렸군. 궁금한 게 있소 - 그녀와 대화해 보니, 그대의 말이 마리에게 공감을 불러일으킨 것 같소. 여기서 묻겠는데 - 두 사람 사이의 상황이 어떻게 처리되었는지에 대해 만족하오?",shape=box,color=blue];
		j2734593025 -> j1424199455;
