		j983902687 -> j3486458065;
	j2014971163 [label="흠. 그리고 그런 점이 사실로 밝혀졌을 때 관련된 당사자들 사이에 발생하는 재결합으로 발생하는 고통은 어떨 것 같소?",shape=box,color=blue];
