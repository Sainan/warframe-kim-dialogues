		j1424199455 -> j2359139412 [label="false",color=purple];
	j2749576868 [label="하! 마치 내가 그녀의 신뢰를 배신하고 그대에게 말하는 것 같구려. 그대는 내게 소중하다오, mon miracle - 마리는 아주 오랜 세월 동안 내 영혼의 자매였소.",shape=box,color=blue];
		j2749576868 -> j1844662376;
	j134788621 [label="하! 마치 내가 그녀의 신뢰를 배신하고 그대에게 말하는 것 같구려. 그대는 내게 소중하다오, 친구여 - 마리는 아주 오랜 세월 동안 내 영혼의 자매였소.",shape=box,color=blue];
		j134788621 -> j1844662376;
	j4179529316 [label="응. 로이드와 위층 가족 사이를 수습하는 데 마리의 도움이 필요할 것 같아. 그리고 그건... 정말 큰 일이야, 리온. 얼마나 큰일인지 설명할 수가 없을 정도.",shape=box,color=red];
		j4179529316 -> j2535332486;
	j3328650943 [label="아니 - 솔직히 말하자면, 우리 사이에 일이 이렇게 흘러버렸고, 로이드와 위층 가족 사이의 관계를 수습하기 위해 마리에게 협력해달라고 부탁할 모든 기회가 망쳐졌어.",shape=box,color=red];
		j3328650943 -> j3603296158;
	j1579215943 [label="아니 - 솔직히 말하자면, 우리 사이에 일이 이렇게 흘러버렸고, 로이드와 위층 가족 사이의 관계를 수습하기 위해 마리에게 협력해달라고 부탁할 모든 기회가 망쳐졌어.",shape=box,color=red];
		j1579215943 -> j792863823;
	j3427051481 [label="만족해. 마리는 로이드와 위층 가족의 관계 개선에 도움을 주지 않을거고, 그래도 난 괜찮아.",shape=box,color=red];
		j3427051481 -> j2541719781;
	j1689087107 [label="만족해. 마리가 엔트라티는 순전히 \"선\"으로 된 존재가 아닐 수도 있다는 걸 알아채서 다행이야. 그리고... 음, 순전히 \"악\"도 아니잖아, 그치?",shape=box,color=red];
		j1689087107 -> j819624339;
	j2959406441 [label="마무리 지은 부분에선 만족해. 솔직히 엔트라티에 대해선 마리 편이니까. 다시 생각해 보니 더 그런 것 같고.",shape=box,color=red];
		j2959406441 -> j2541719781;
	j4186969723 [label="엔트라티에 관해선 의견이 맞지 않았어. 설득하는 데 실패했고... 더 잘할 수 있었으면 좋았을 텐데.",shape=box,color=red];
		j4186969723 -> j4054034757;
	j2333834934 [label="엔트라티에 대해서는 \"서로 의견이 다르다는 데 합의\"했는데, 이 주제에 대해서는 그 정도 밖에 할 수 없을 것 같아. 더 이상 이야기 나눈다고 해서 상황이 나아질 것 같지도 않고.",shape=box,color=red];
		j2333834934 -> j3899622670;
	j2359139412 [label="솔직히 말하자면, 괜찮아. 이쯤 되면 더 좋아질 것 같지도 않고, 더 나빠질 것 같지도 않아.",shape=box,color=red];
		j2359139412 -> j3899622670;
	j1844662376 [label="아니, 마리가 내게 한 말은 비밀로 해두겠소. 하지만 그래도 그녀에게서 공감은 이끌어 냈으니. 그런데 두 사람 사이의 상황이 어떻게 처리되었는지에 대해 만족하오?",shape=box,color=blue];
		j1844662376 -> j1424199455;
	j2535332486 [label="비록 그 규모를 온전히 이해할 수는 없더라도, 이 작업의 위대함은 충분히 이해할 수 있소. 어떤 면에서든 이 작업에 참여하게 되어 깊은 영광을 느끼오.",shape=box,color=blue];
		j2535332486 -> j4208481966;
		j2535332486 -> j2088271619;
	j3603296158 [label="흥미롭군... 뭐, 이제 그대는 그녀의 연인이지 않소? 만약 이곳에서 그녀를 설득할 영향력을 가진 이가 있다면 - 그건 바로 당신일 거요, 안 그렇소?",shape=box,color=blue];
		j3603296158 -> j3319821809;
	j792863823 [label="흥미롭군... 음, 내가 마리에게 어느 정도의... 영향력을 행사한 적 있다고 들었을 거요. 비록 한정적이기는 하지만. 그대는 M. 로이드와 엔트라티의 소원해진 가족 사이의 관계 회복이 얼마나 중요하다고 생각하는 거요?",shape=box,color=blue];
		j792863823 -> j1498920715;
		j792863823 -> j1140456903;
	j2541719781 [label="그것이 성급함, 오만함, 무지 혹은 무관심의 어조인지 알 수 없구려. 그래서 난 네 가지를 모두 섞은 어조로 말하고, 오늘 하루를 보내야겠소.",shape=box,color=blue];
		j2541719781 -> j1079436339;
	j819624339 [label="맞소. 나도 그대와 비슷한 관점으로 보고 있소. 그가 어떤 쪽이라고는 생각하지 않으나... 그의 동기에는 그런 면이 섞여 있지.",shape=box,color=blue];
		j819624339 -> j4294111037;
	j4054034757 [label="흠. 안타깝게도, 모든 것을 접어야 할 때가 오기도 하오. 반죽을 과하게 치댈수도 있고, 예술가는 그림을 과하게 그릴 수 있으며, 논쟁은 분명 과한 긴장감을 유발할 수 있지.",shape=box,color=blue];
		j4054034757 -> j883117765;
	j3899622670 [label="그렇구려. 어쩌면 주제를 더 나은 방향으로 옮겨가는 게 나을지도.",shape=box,color=blue];
		j3899622670 -> j4260300157;
	j4208481966 [label="당신이 도와주겠다고 말할 줄은 생각도 못했는 걸.",shape=box,color=red];
		j4208481966 -> j2481967043;
	j2088271619 [label="그러면 로이드를 설득해서 위층 가족과 얘기할 수 있도록 도와주겠다는 거야?",shape=box,color=red];
		j2088271619 -> j761807981;
	j3319821809 [label="그대가 마리에게 한 말에서 어떤 종류의 희생도 치르질 않았기 때문이오 - 그녀를 유혹하려고 어떤 것을 다른 것보다 우선시하는 것처럼.",shape=box,color=blue];
		j3319821809 -> j983902687;
	j1498920715 [label="이 세상엔 외로움이 너무 많아, 리온. 슬픔도 너무 많아. 끝낼 수 있을 때 끝내버리자는 게 어때서? ",shape=box,color=red];
		j1498920715 -> j2014971163;
	j1140456903 [label="나도 잘 모르겠어. 본능이야 - 직감이라고. 엔트라티가 이 순간에 당신들 셋을 여기로 데려온 데에는 다 이유가 있는 것 같아.",shape=box,color=red];
		j1140456903 -> j3604043618;
	j1079436339 [label="유감이오.",shape=box,color=blue];
		j1079436339 -> j3497962379;
	j4294111037 [label="오만이 그를 이끌었소. 지식에 대한 탐욕 말이오. 이제, 어쩌면, 용서에 대한 탐욕일지도 모르지. 누가 알겠소? 그 자신도 자신의 속마음을 알고 있을지 궁금하구려.",shape=box,color=blue];
		j4294111037 -> j884161754;
	j883117765 [label="내가 그랬다면 포기했을 것 같소. 그리고 언젠가 그녀가 엔트라티의 진짜 모습을 볼 수 있기를 바라오 - 기껏해야 그저 복잡한 사람일 뿐이니.",shape=box,color=blue];
		j883117765 -> j884161754;
	j4260300157 [label="개인적으로, 그 훌륭하고 완벽한 \"le Cardinal\"에 대해 끊임없이 떠드는 것을 더 이상 듣고 싶지 않소.",shape=box,color=blue];
		j4260300157 -> j884161754;
	j2481967043 [label="스스로가 그리 상냥한 성정이 아니라는 건 알지만, 그렇다고 냉혈한은 아니니. 내 도움이 필요하면 언제든 도와드리리다.",shape=box,color=blue];
		j2481967043 -> j2800191596;
	j761807981 [label="물론이오. 내 도움이 필요하면 언제든 도와드리리다.",shape=box,color=blue];
		j761807981 -> j2800191596;
