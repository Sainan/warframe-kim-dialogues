	1881 [label="M. 로이드와 엔트라티의 소원해진 가족 사이의 일이 어찌 전개될지는 모르겠소. 다만 내 도움이 필요하면 언제든 도와드리리다.",shape=box,color=blue];
		1881 -> 1885;
	1885 [label="Evaluate expressions",color=orange];
		1885 -> 1893 [label="RoatheFamilyDelay",color=purple];
		1885 -> 1894 [label="RoatheFamilyFail",color=purple];
		1885 -> 1892 [label="false",color=purple];
	1886 [label="그대를 돕기 위해 최선을 다하겠지만, 그점이 그대에게 도움이 되지는 않을 것 같구려.",shape=box,color=blue];
		1886 -> 1895;
	1887 [label="처음이야 분명 아프겠지. 부러진 뼈 맞추듯이 말이야. 하지만 이런 상처가 제대로 낫는 유일한 방법이기도 해.",shape=box,color=red];
		1887 -> 1896;
	1888 [label="우리의 단결로 인한 이점이 분리로 인한 단점보다 더 크다고 생각해.",shape=box,color=red];
		1888 -> 1896;
	1889 [label="아니, 그렇지만 난 도움이 필요한 사람들을 보호하는 일을 하고 있어. 그들과 이곳을 영원히 속삭임과 감염으로부터 지킬 수는 없는 일이잖아. 하지만 당신이랑 마리, 그리고 로스라면 - 할 수 있을지도 몰라.",shape=box,color=red];
		1889 -> 1896;
	1890 [label="엔트라티를 꼭 믿는 건 아니지만 - 그래도 그 인간이 우리의 적이라고는 생각 안 들어. 전쟁이 다가오고 있고, 우리는 모두 마땅히 있어야 할 자리에 앉아 있어야 할 것 같아. 바로 이곳이 우리가 있어야 할 자리야.",shape=box,color=red];
		1890 -> 1897;
	1891 [label="Chat ends.",color=orange];
	1893 [label="하지만 그대가 이미 가장 힘든 작업을 끝마쳤다고 알고 있소 - 로스를 설득하는 일 말이오.",shape=box,color=blue];
		1893 -> 1900;
	1894 [label="하지만 로스의 마음을 어찌 바꿀지에 대해 고민해야 할 것 같소. 그자의 마음을... 내가 어찌 해볼 수 있을 것 같지 않구려. 게다가 그자가 없다면, 이 일은 헛수고일지도 모르니까.",shape=box,color=blue];
		1894 -> 1898;
		1894 -> 1899;
	1892 [label="하지만 가장 설득하기 어려운 이는, 생각도 하기 싫지만, 아마 가장 중요한 존재는 - 로스일 거요.",shape=box,color=blue];
		1892 -> 1898;
		1892 -> 1899;
