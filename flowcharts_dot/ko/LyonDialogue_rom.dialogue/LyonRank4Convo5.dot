		1150 -> 1155;
	1151 [label="Update boolean LyonTime1",color=orange];
		1151 -> 1156;
	1152 [label="날 믿으시오, 아니까. 그리고 당황스럽기도 하고, 고맙소. 하지만 이곳이야말로 모든 물건들이 말을 할 수 있는 것 같긴 하오만.",shape=box,color=blue];
