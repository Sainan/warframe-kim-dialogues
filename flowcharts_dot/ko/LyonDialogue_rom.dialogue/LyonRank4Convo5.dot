		j3039724897 -> "Chat ends.";
	j3521748760 [label="리온, 너와 마리가 있는 대성당에 로스가 오게 된 경위를 듣고 싶은데, 말해줄 수 있어?",shape=box,color=red];
		j3521748760 -> j1771476239;
	j1692057698 [label="바라는 대로. 허나 그닥 유쾌한 이야기는 아니오. 그자는 다친 야생 고양이처럼 성당 문 앞에 버려졌소.",shape=box,color=blue];
		j1692057698 -> j3769319211;
	"Chat ends." [color=orange];
	j1771476239 [label="바라는 대로. 그자는 다친 야생 고양이처럼 성당 문 앞에 버려졌소. 그 이야기는 그닥 유쾌하지 않기에.",shape=box,color=blue];
		j1771476239 -> j3769319211;
