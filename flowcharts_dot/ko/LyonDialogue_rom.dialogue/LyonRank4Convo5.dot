	1170 [label="난... 용서해 주시오. 이만 가야겠소. 아직은 이 이야기를 할 수가 없으니. 난... 미안하오. 다시는 이 이야기를 묻지 마시오.",shape=box,color=blue];
		1170 -> 1174;
	1171 [label="그렇다면 스스로의 이성적인 사고를 넘어 울려 퍼진 목소리에 대해 내가 말할 때, 그대는 어떤 생각이 드오? 난 평생 그 목소리를 들어본 적이 없다는 걸 아오. 그렇다고 해서 그 목소리가 항상 거기에 있었다는 것은 있을 수가 없는 일이오.",shape=box,color=blue];
