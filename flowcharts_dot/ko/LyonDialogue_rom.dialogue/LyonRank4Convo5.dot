		1112 -> 1117;
		1112 -> 1118;
		1112 -> 1119;
	1120 [label="우리의 동료 형제 자매들은 우리를 거리로 추방하거나 화형에 처하진 않았소. \"Cardinal Dimanche\"는 우리의 변화가... 광휘의 성체들께서 이뤄낸 업적이라고 다른 이들을 확신시켰소.",shape=box,color=blue];
		1120 -> 1127;
	1121 [label="로스는 \"어떻게\" 해야 할지 구체적인 내용을 알고 있지만, 그자는... 수년간의 작업 끝에 우리의 혈액 샘플로 \"헬민스\"를 만들어냈소.",shape=box,color=blue];
		1121 -> 1128;
	1122 [label="내가 어떤지 이미 봤잖소, 안 그렇소?",shape=box,color=blue];
