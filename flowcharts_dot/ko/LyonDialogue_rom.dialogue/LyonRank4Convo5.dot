		j2036164317 -> j836866170;
	j2829012913 [label="그점이 위로가 되는지, 아니면 실망스러운지 모르겠군. 고맙소. 이제 와서 감염체가 말을 할 수 있다는 걸 알게 되니 정말 신기하구려.",shape=box,color=blue];
