		1077 -> 1080 [label=false,color=brown];
	1079 [label="리온, 당신과 마리가 있는 대성당에 로스가 오고 난 후의 이야기를 듣고 싶은데, 말해줄 수 있어?",shape=box,color=red];
		1079 -> 1082;
