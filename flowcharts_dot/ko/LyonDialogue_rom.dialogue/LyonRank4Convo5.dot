		1153 -> 1158 [label="false",color=purple];
	1154 [label="그대가 말하려던 단어가 \"점령당했다\"였다면, 나도 잘 봤소, 드리프터. 속삭이던 존재. 벽 안에 있던 남자. 또닥또닥하는 소리...",shape=box,color=blue];
		1154 -> 1159;
	1155 [label="제발, 말해주시오. 하지만 다른 존재들이 내 마음 속에 머물다가 결국 떠나가는 것보다, 악기가 덧없는 반신이 되도록 내버려 두는 편이 훨씬 더 위안이 된다고 생각하오. 이상하게도, 그 존재... 이후로...",shape=box,color=blue];
		1155 -> 1160;
	1156 [label="그게 단순히 이 문제에 대한 나의 독특한 민감성 때문인지, 아니면... 내가 만들어낸 개인적인 상황 때문인지, 아니면... 그 존재 때문인지 잘 모르겠소 -",shape=box,color=blue];
