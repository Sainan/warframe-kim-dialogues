		1117 -> 1124;
	1118 [label="그 뒤엔 어떻게 됐는데?",shape=box,color=red];
		1118 -> 1125;
	1119 [label="후회해?",shape=box,color=red];
		1119 -> 1126;
	1127 [label="지하 납골당 안에 숨어서 타인의 시선을 피했소. 옛 교우들은 우리를 무서워하면서도 필요한 물품을 가져다주곤 했지.",shape=box,color=blue];
		1127 -> 1134;
	1128 [label="난 스스로가 감염체와 어떻게든 연결되어 있다고 믿소... 시간을... 넘어서... 하지만 자세한 건 모르오.",shape=box,color=blue];
		1128 -> 1135;
		1128 -> 1136;
	1129 [label="얼마 동안이나 그곳에 갇혀 있던거야?",shape=box,color=red];
		1129 -> 1137;
	1130 [label="그래서... 모두를 지하실에 가둬놨다는 거야?",shape=box,color=red];
		1130 -> 1138;
	1124 [label="Update boolean LyonMarieEntrati",color=orange];
		1124 -> 1131;
	1125 [label="로스가 깨어났소. 처음엔, 자신의 이름도 거의 기억해내지 못했소. 엔트라티는 빌어먹을 그 존재에게 작별 인사를 건넸지. \"우리엘, 자타의 이단자여, 그대 추방된 이여, 답하라 - 오로킨은 과연 용서받을 수 있는가?\"",shape=box,color=blue];
		1125 -> 1132;
	1126 [label="모든 걸 후회하오, 드리프터. 맞소, 물론이고 말고. 하지만 또 이걸 반복해야 한다면? 물론, 다시하고 말고. 마리를 혼자 둘 순 없으니.",shape=box,color=blue];
		1126 -> 1133;
	1134 [label="교우들은...마리가 유령처럼 계단에서 갑자기 나타나서 그들을 맞이했음에도 불구하고, 오직 그녀하고만 상호 교류하길 고집했소. ",shape=box,color=blue];
		1134 -> 1139;
		1134 -> 1140;
	1135 [label="로스가 헬민스를 역설계했다고?! 얼마나 걸렸는데?!",shape=box,color=red];
		1135 -> 1141;
	1136 [label="아무도 이해하지 못할 거야. 이건 새로운 발견이거든.",shape=box,color=red];
		1136 -> 1142;
	1137 [label="우리가 말하는 인페스티드 혼합체로 변한 후 몇 년이 흘렀는지 물어볼 이는 아무래도 내가 아닐 거요. 그 이후로 시간이 어떻게 흘렀는지 스스로가 파악하는 건... 너무나 난해하니까.",shape=box,color=blue];
		1137 -> 1143;
		1137 -> 1144;
	1138 [label="글로는 더 혹독하게 보일지도 모르겠소. 우리를 둘 곳이 없었으니까. 종탑은 너무 개방되어 있었고, 가혹한 요소들에 너무 노출되어 있었으니까. 지하 납골당은 아늑하고 따뜻했소.",shape=box,color=blue];
		1138 -> 1145;
	1131 [label="이 점에선, 우리 의견이 일치하는군. 하지만 나도 그녀를 탓할 순 없소. 마리에게 시간 좀 주시오. 곧 이해하게 될 터이니. 마리는 굉장히 총명하오, 드리프터. 바보 취급하지 말도록.",shape=box,color=blue];
		1131 -> 1133;
	1132 [label="엔트라티는 투약 후에 떠났소. 그리고 로스와 우리는 함께 버려졌고, 이제 그대가 보는 지금의 모습으로 새롭게 변했으니 - 변덕스러운 악마와 더 잘 맞설 수 있게 된거지.",shape=box,color=blue];
		1132 -> 1096;
	1133 [label="이야기를 계속하자면... 엔트라티는 투약 후에 떠났소. 그리고 로스와 우리는 함께 버려졌고, 이제 그대가 보는 지금의 모습으로 새롭게 변했으니 - 변덕스러운 악마와 더 잘 맞설 수 있게 된거지.",shape=box,color=blue];
		1133 -> 1096;
	1139 [label="로스를 피하는 건 이해할 수 있는데... 교우들이 당신과 대화하는 것보다 그점을 더 선호한거야?",shape=box,color=red];
		1139 -> 1146;
	1140 [label="마리는 매우 친절하니까...",shape=box,color=red];
		1140 -> 1147;
	1141 [label="Update boolean LyonRoatheHelminth",color=orange];
		1141 -> 1148;
	1142 [label="그점이 위로가 되는지, 아니면 실망스러운지 모르겠군. 고맙소. 이제 와서 감염체가 말을 할 수 있다는 걸 알게 되니 정말 신기하구려.",shape=box,color=blue];
		1142 -> 1149;
		1142 -> 1150;
	1143 [label="어떤 식으로 난해한데?",shape=box,color=red];
		1143 -> 1151;
	1144 [label="감염체가 말을 할 수도 있다는 걸 말해줬어야 했나 확신이 안 서...",shape=box,color=red];
		1144 -> 1152;
	1145 [label="그리고, 불행하게도, 우리는 로스가 돌아다닐 수 있는... 출구가 있다는 걸 발견했소.",shape=box,color=blue];
		1145 -> 1153;
	1146 [label="내가 어떤지 이미 봤잖소, 안 그렇소?",shape=box,color=blue];
		1146 -> 1129;
		1146 -> 1130;
	1147 [label="바로 그 말대로.",shape=box,color=blue];
		1147 -> 1130;
		1147 -> 1129;
	1148 [label="그대가 물어봐야 할 사람은 내가 아닐 거요. 그 이후로 시간의 흐름에 대한 내 이해가... 복잡해졌기에. 어쩌면 \"더욱 복잡해졌다\"라고 하는 게 더 정확할지도 모르겠군. 이보다 더 끔찍할 순 없을 것 같으니까...",shape=box,color=blue];
		1148 -> 1143;
		1148 -> 1144;
	1149 [label="모든 가정용품들이 그런 건 아니야. 의자가 가끔... 음... 신경쓰지 말고, 계속해 줘.",shape=box,color=red];
