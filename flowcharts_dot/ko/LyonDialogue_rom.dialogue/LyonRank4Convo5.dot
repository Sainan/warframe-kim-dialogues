	1161 [label="그리고 내가 이렇게 말하면 날 분명 광인이라고 생각할 거라는 걸 알지만, 난... 시간을... 순수한 직선형으로 경험하지 않았소.",shape=box,color=blue];
		1161 -> 1165;
		1161 -> 1166;
	1162 [label="그게 그자의 얼마 안 되는 장점 중 하나라고 생각하오. 도둑질은 아니고, 그 뒤에 숨은 이유 말이오. 내 생각엔 그자가 마리와의 대화를 유도해내기 위해 불법적으로 물품들을 조달했으리라 생각하오.",shape=box,color=blue];
		1162 -> 1167;
	1163 [label="그 점은 여기서 별로 중요치 않소.",shape=box,color=blue];
		1163 -> 1168;
		1163 -> 1169;
	1164 [label="그 존재가 항상 거기에 있었을 리가 없소. 하지만 어린 시절 집 담벼락 너머, 루아의 은빛처럼 지금도 선명하게 기억나오, 젊은 남자의 목소리. 그 옆에 서 있는 또 다른 존재... \"똑 똑 똑...\"",shape=box,color=blue];
		1164 -> 1170;
	1165 [label="\"그 존재?\" 그게 도대체 누군데?",shape=box,color=red];
		1165 -> 1159;
	1166 [label="난 헤아릴 수 없는 수세기 동안 나선형으로 시간을 경험했어, 리온.",shape=box,color=red];
		1166 -> 1171;
	1167 [label="아마도 그자가 주의를 기울이지 않는다고 생각했을 때, 마리의 얼굴에 미소가 번졌기 때문이겠지. 언젠가 그가 내게 이렇게 말했던 적이 있소. \"운명이 마리를 그렇게 불우하게 만든 건 정말 비극적인 일이다.\"",shape=box,color=blue];
		1167 -> 1172;
