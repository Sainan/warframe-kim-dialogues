		j322352528 -> j3728405827;
	j249472217 [label="Boolean LyonSerum1 is now true.",color=orange];
		j249472217 -> j4256223481;
		j249472217 -> j4238513042;
		j249472217 -> j957680092;
	j929877328 [label="우리의 동료 형제 자매들은 우리를 거리로 추방하거나 화형에 처하진 않았소. \"Cardinal Dimanche\"는 우리의 변화가... 광휘의 성체들께서 이뤄낸 업적이라고 다른 이들을 확신시켰소.",shape=box,color=blue];
		j929877328 -> j1167734141;
	j1382912622 [label="로스는 \"어떻게\" 해야 할지 구체적인 내용을 알고 있지만, 그자는... 수년간의 작업 끝에 우리의 혈액 샘플로 \"헬민스\"를 만들어냈소.",shape=box,color=blue];
		j1382912622 -> j305487727;
	j1672807632 [label="내가 어떤지 이미 봤잖소, 안 그렇소?",shape=box,color=blue];
		j1672807632 -> j1999683173;
	j3728405827 [label="바로 그 말대로.",shape=box,color=blue];
		j3728405827 -> j3620311974;
	j4256223481 [label="마리는 아직도 엔트라티를 너무 숭배하는 것 같아.",shape=box,color=red];
		j4256223481 -> j1490779236;
	j4238513042 [label="그 뒤엔 어떻게 됐는데?",shape=box,color=red];
