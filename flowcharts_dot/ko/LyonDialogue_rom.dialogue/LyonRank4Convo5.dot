	j574266039 [label="내 말이 맞았네. 그 이야기는 로스에 관한 거였어.",shape=box,color=red];
		j574266039 -> j2917835219;
	j1213626027 [label="로스의 말에 따르면, 자신이 나타났을 때, 조금... 사나워질 만한 모든 이유들이 있었다고 하더라고.",shape=box,color=red];
		j1213626027 -> j3670830822;
	j2584457349 [label="괜찮아, 마저 얘기해 줘.",shape=box,color=red];
		j2584457349 -> j2266356665;
	j2917835219 [label="성당에 자주 드나들던 길고양이에 대한 이야기였지. 그 의미를 그대가 어떻게 얻는지, 내가 왜 그 이야기를 했는지는 전적으로 그대의 책임이오. 난 신부니까, 안 그렇소?",shape=box,color=blue];
		j2917835219 -> j2266356665;
	j3670830822 [label="그런 지위와 성향을 가진 존재라면 엔트라티가 자신에게 가한 행동에 대해 억울함을 느꼈으리라 예상되오. 솔직히 말해서. 그자가 이 문제를 더 우아하게 처리했다면 그 점이 훨씬 더 당황스러웠겠지.",shape=box,color=blue];
		j3670830822 -> j2266356665;
	j2266356665 [label="Evaluate expressions",color=orange];
		j2266356665 -> j486921874 [label="LyonSerum1",color=purple];
		j2266356665 -> j1726023670 [label="false",color=purple];
	j486921874 [label="지난번, 엔트라티가 잠시 사라졌다가 로스와 함께 돌아왔을 때, 지금 우리가 보는 그자의 모습이 완전히 변해 있었다는 이야기를 나누었던 게 기억나구려. 엔트라티는 3년 넘게 했던 거짓말들을 모두 털어놓았소.",shape=box,color=blue];
		j486921874 -> j2373460602;
	j1726023670 [label="그 순간까지 일어난 사건을 요약해 보겠소. 그렇지 않으면... 기껏해야 터무니없는 소리로 들릴지도 모르겠군.",shape=box,color=blue];
		j1726023670 -> j3574347958;
	j2373460602 [label="엔트라티는 우리에게 지금의 모습으로 만들어낸 \"프로토프레임 혈청\"을 우리에게 주었고, 우리가 그걸 받아들이자... 그는 바로 우리를 다시 버렸소.",shape=box,color=blue];
		j2373460602 -> j607116340;
	j3574347958 [label="3년 2개월 11일 동안 엔트라티는 우리 대성당에서 Cardinal Dimanche로서 재직하였소. 그리고 그 모든 시간 동안 마리와 나는 그가 우리를 위해 무슨 계획을 가지고 있는지도 모른 채 그를 섬겼소.",shape=box,color=blue];
		j3574347958 -> j3858168207;
	j607116340 [label="그리고 우리는 그곳에서 새로 태어난 고아의 혼합물로서 남겨졌고, 몸과 영혼은 스스로가 이해할 수 있는 경지를 넘어서 육신조차 제어할 수 없는 창조물로서 재탄생하였소.",shape=box,color=blue];
		j607116340 -> j1577072717;
	j3858168207 [label="질문하기도 전에 그대 안에 드는 의문점을 알고 있소. 엔트라티는 무슨 계략을 꾸몄던 거지? 홀바니아에서 그랬던 것처럼, 도시도 감염시켰던 걸까? 계획이 뭐였을까? 어떤 발견을 했을까?",shape=box,color=blue];
		j3858168207 -> j2470417045;
	j1577072717 [label="우리의 고향이었지만 더 이상 우리에게 우호적이지 않은 도시에 발이 묶여버렸소. 우리는... 숨어야만 했소.",shape=box,color=blue];
		j1577072717 -> j1756710517;
		j1577072717 -> j728509782;
	j2470417045 [label="이에 대해 말하자면, 그대는 실망할 것이오. 엔트라티는 설교하고, 공부하고, 쉬고, 기도하였소. 그러던 어느 날 밤, 끔찍한 폭풍 한가운데서 사라졌소. 엔트라티가 나타났던 바로 그 폭풍 말이오.",shape=box,color=blue];
		j2470417045 -> j2575044127;
	j1756710517 [label="바뀌어버린 외형 때문에?",shape=box,color=red];
		j1756710517 -> j934243246;
	j728509782 [label="대성당에서 거절 당했어?",shape=box,color=red];
		j728509782 -> j1585040676;
	j2575044127 [label="Check boolean MarieLyonVisions",color=orange];
		j2575044127 -> j3802855161 [label=true,color=green];
		j2575044127 -> j3386995503 [label=false,color=brown];
	j934243246 [label="그대가 알아차렸는지는 모르겠지만, 마리는 날 수 있게 되었고 로스는... 파랗고, 다른 문제들도 산재해 있었소.",shape=box,color=blue];
		j934243246 -> j418330277;
	j1585040676 [label="정확히는... 아니오. 우리는 공직에서 쫓겨나진 거요. 하지만 동료 형제 자매들은 우리를 거리로 추방하거나 화형에 처하진 않았소. \"Cardinal Dimanche\"는 우리의 변화가... 광휘의 성체들께서 이뤄낸 업적이라고 다른 이들을 확신시켰소.",shape=box,color=blue];
		j1585040676 -> j4082667155;
	j3802855161 [label="다른 이들은 그 폭풍우를 느끼지 못했을 거라는 걸 잘 알고 있지만, 내 감각엔 매우 생생하게 느껴졌소.",shape=box,color=blue];
		j3802855161 -> j3386995503;
	j3386995503 [label="그로부터 정확히 1년 후, 엔트라티는 마지막으로 다시 나타났는데... 로스가 그의 발치에 의식을 잃은 채 쓰러져 있었소. 지금의 모습 그대로.",shape=box,color=blue];
		j3386995503 -> j234278757;
	j418330277 [label="그대가 하루종일 말하는 동물과 해골을 가지고 놀면서 범우주적 보이드에 대한 의문을 곰곰이 생각하는 걸 알지만, 대부분의 인간에게는 그게 표준적인 문제가 아니니까.",shape=box,color=blue];
		j418330277 -> j2564979321;
	j4082667155 [label="지하 납골당 안에 숨어서 타인의 시선을 피했소. 옛 교우들은 우리를 무서워하면서도 필요한 물품을 가져다주곤 했지.",shape=box,color=blue];
		j4082667155 -> j1994193002;
	j234278757 [label="말 그대로 진짜 악마, 아니 당시엔 그리 보였소. 바로 그 때, 엔트라티는 자신이 누구인지, 언제 나타났는지, 그리고 우리에게 맡긴 \"진정한 사명\"이 무엇인지 말해 주었지. 그가 우리 둘을 가장 \"신성한 사명\"을 위해 선택했다는 것을.",shape=box,color=blue];
		j234278757 -> j4027079990;
	j2564979321 [label="게다가, 몸을 충분히 잘 가린다면 군중 속을 돌아다닐 수 있는 건 우리 셋 중 나 하나였을 거요. ",shape=box,color=blue];
		j2564979321 -> j316994331;
		j2564979321 -> j4283088355;
	j1994193002 [label="교우들은...마리가 유령처럼 계단에서 갑자기 나타나서 그들을 맞이했음에도 불구하고, 오직 그녀하고만 상호 교류하길 고집했소. ",shape=box,color=blue];
		j1994193002 -> j4020963966;
		j1994193002 -> j322352528;
	j4027079990 [label="마리는 혈청을 기꺼이 받아들였소. 당연하게, 받아들였소. 어떻게 안 그럴 수 있겠소? 그리고 내가 어찌 그녀를 따르지 않을 수 있겠소? 진실이 어디로 이끌든, 어떻게 내가 진실을 찾지 않을 수 있겠냔 말이오?",shape=box,color=blue];
		j4027079990 -> j249472217;
	j316994331 [label="어디에 머물렀어?",shape=box,color=red];
		j316994331 -> j929877328;
	j4283088355 [label="모두 어쩌다가 여기까지 온거야?",shape=box,color=red];
		j4283088355 -> j1382912622;
	j4020963966 [label="로스를 피하는 건 이해할 수 있는데... 교우들이 너와 대화하는 것보다 그점을 더 선호한거야?",shape=box,color=red];
		j4020963966 -> j1672807632;
