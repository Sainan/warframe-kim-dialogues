		j957680092 -> j100313577;
	j1167734141 [label="지하 납골당 안에 숨어서 타인의 시선을 피했소. 옛 교우들은 우리를 무서워하면서도 필요한 물품을 가져다주곤 했지.",shape=box,color=blue];
		j1167734141 -> j1910563940;
	j305487727 [label="난 스스로가 감염체와 어떻게든 연결되어 있다고 믿소... 시간을... 넘어서... 하지만 자세한 건 모르오.",shape=box,color=blue];
		j305487727 -> j1608798250;
		j305487727 -> j1509930587;
	j1999683173 [label="얼마 동안이나 그곳에 갇혀 있던거야?",shape=box,color=red];
		j1999683173 -> j2471504671;
	j3620311974 [label="그래서... 모두를 지하실에 가둬놨다는 거야?",shape=box,color=red];
		j3620311974 -> j2461162609;
	j1490779236 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j1490779236 -> j4223422831;
	j46469544 [label="로스가 깨어났소. 처음엔, 자신의 이름도 거의 기억해내지 못했소. 엔트라티는 빌어먹을 그 존재에게 작별 인사를 건넸지. \"우리엘, 자타의 이단자여, 그대 추방된 이여, 답하라 - 오로킨은 과연 용서받을 수 있는가?\"",shape=box,color=blue];
		j46469544 -> j4060062017;
	j100313577 [label="모든 걸 후회하오, 드리프터. 맞소, 물론이고 말고. 하지만 또 이걸 반복해야 한다면? 물론, 다시하고 말고. 마리를 혼자 둘 순 없으니.",shape=box,color=blue];
		j100313577 -> j374608458;
	j1910563940 [label="교우들은...마리가 유령처럼 계단에서 갑자기 나타나서 그들을 맞이했음에도 불구하고, 오직 그녀하고만 상호 교류하길 고집했소. ",shape=box,color=blue];
		j1910563940 -> j3478742666;
		j1910563940 -> j4183910892;
	j1608798250 [label="로스가 헬민스를 역설계했다고?! 얼마나 걸렸는데?!",shape=box,color=red];
		j1608798250 -> j2036164317;
	j1509930587 [label="아무도 이해하지 못할 거야. 이건 새로운 발견이거든.",shape=box,color=red];
		j1509930587 -> j2829012913;
	j2471504671 [label="우리가 말하는 인페스티드 혼합체로 변한 후 몇 년이 흘렀는지 물어볼 이는 아무래도 내가 아닐 거요. 그 이후로 시간이 어떻게 흘렀는지 스스로가 파악하는 건... 너무나 난해하니까.",shape=box,color=blue];
		j2471504671 -> j3044849228;
		j2471504671 -> j1668632680;
	j2461162609 [label="글로는 더 혹독하게 보일지도 모르겠소. 우리를 둘 곳이 없었으니까. 종탑은 너무 개방되어 있었고, 가혹한 요소들에 너무 노출되어 있었으니까. 지하 납골당은 아늑하고 따뜻했소.",shape=box,color=blue];
		j2461162609 -> j3957784548;
	j4223422831 [label="이 점에선, 우리 의견이 일치하는군. 하지만 나도 그녀를 탓할 순 없소. 마리에게 시간 좀 주시오. 곧 이해하게 될 터이니. 마리는 굉장히 총명하오, 드리프터. 바보 취급하지 말도록.",shape=box,color=blue];
		j4223422831 -> j374608458;
	j4060062017 [label="엔트라티는 투약 후에 떠났소. 그리고 로스와 우리는 함께 버려졌고, 이제 그대가 보는 지금의 모습으로 새롭게 변했으니 - 변덕스러운 악마와 더 잘 맞설 수 있게 된거지.",shape=box,color=blue];
		j4060062017 -> j607116340;
	j374608458 [label="이야기를 계속하자면... 엔트라티는 투약 후에 떠났소. 그리고 로스와 우리는 함께 버려졌고, 이제 그대가 보는 지금의 모습으로 새롭게 변했으니 - 변덕스러운 악마와 더 잘 맞설 수 있게 된거지.",shape=box,color=blue];
