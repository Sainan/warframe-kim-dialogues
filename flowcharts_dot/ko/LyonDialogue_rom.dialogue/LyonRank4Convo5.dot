		1078 -> 1081;
	1082 [label="바라는 대로. 허나 그닥 유쾌한 이야기는 아니오. 그자는 다친 야생 고양이처럼 성당 문 앞에 버려졌소.",shape=box,color=blue];
		1082 -> 1084;
	1083 [label="Chat ends.",color=orange];
	1081 [label="바라는 대로. 그자는 다친 야생 고양이처럼 성당 문 앞에 버려졌소. 그 이야기는 그닥 유쾌하지 않기에.",shape=box,color=blue];
		1081 -> 1084;
