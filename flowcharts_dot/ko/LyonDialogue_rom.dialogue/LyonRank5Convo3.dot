digraph {
	1556 [label="LyonRank5Convo3 begins.",color=orange];
		1556 -> 1557;
	1557 [label="Evaluate expressions",color=orange];
		1557 -> 1559 [label="LyonDating",color=purple];
		1557 -> 1560 [label="LyonConvession1",color=purple];
		1557 -> 1560 [label="LyonRell2a",color=purple];
		1557 -> 1560 [label="LyonRell2b",color=purple];
		1557 -> 1560 [label="LyonRell1",color=purple];
		1557 -> 1558 [label="false",color=purple];
	1559 [label="자랑스러운 일은 아니지만, 와인 한 병을 다 마셨고 이제 내가 필사적으로 하지 않으려고 노력했던 나머지 이야기들을 마저 말할 준비가 되었소. Mon miracle...",shape=box,color=blue];
		1559 -> 1561;
	1560 [label="자랑스러운 일은 아니지만, 와인 한 병을 다 마셨고 이제 내가 필사적으로 하지 않으려고 노력했던 나머지 이야기들을 마저 말할 준비가 되었소...",shape=box,color=blue];
		1560 -> 1561;
	1558 [label="Chat ends.",color=orange];
	1561 [label="이 병이 진짜 와인이라면, 라벨에 정확한 이름도 없거니와 - 내 시대 때 마셨던 와인과 M.로이드가 와인이라고 알고 있는 와인이 같은 건지 확신은 못하겠지만.",shape=box,color=blue];
		1561 -> 1562;
	1562 [label="변명하자면, 병 전체를 들이킬 생각은 추호도 없었소... 하지만 내용물이 실제로 같은 물질인지 알아볼려고 들이킨 것 뿐이었는데, 사라져 버렸소이다...",shape=box,color=blue];
		1562 -> 1563;
		1562 -> 1564;
		1562 -> 1565;
	1563 [label="아니. 얘기 안 할래.",shape=box,color=red];
		1563 -> 1566;
	1564 [label="맛은 똑같은 것 같아?",shape=box,color=red];
		1564 -> 1567;
	1565 [label="당신 술 취했어?",shape=box,color=red];
		1565 -> 1568;
	1566 [label="나도 그리 쉽게 벗어날 수만 있다면 좋을텐데. 그대를 비난하진 않겠소.",shape=box,color=blue];
		1566 -> 1569;
	1567 [label="나도 모르겠소! 그게 가장 짜증나는 부분이오! 하지만 그게 중요한 게 아니지. 요점은 취하려고 했던 거요. 그리고 내가 술에 취했는지도 잘 모르겠소. 완전히 술에 깬 상태는 아니지만 -",shape=box,color=blue];
		1567 -> 1570;
	1568 [label="잠재적으로. 난 타인이 생각하는 것만큼 술과 거리가 먼 사람도 아니오.",shape=box,color=blue];
		1568 -> 1571;
	1569 [label="Update boolean LyonConfessionFail",color=orange];
		1569 -> 1572;
	1570 [label="그러니 이정도면 충분하겠지.",shape=box,color=blue];
		1570 -> 1573;
		1570 -> 1574;
	1571 [label="이 모든 노력의 목적이 바로 그것이니. 그러니 이정도면 충분하겠지.",shape=box,color=blue];
		1571 -> 1573;
		1571 -> 1574;
	1572 [label="Chat ends.",color=orange];
	1573 [label="얼마나 끔찍하길래 술까지 취한 채로 말하는 거야?",shape=box,color=red];
		1573 -> 1575;
	1574 [label="난 여기 있으니까 준비되면...",shape=box,color=red];
		1574 -> 1575;
	1575 [label="똑... 똑... 똑...",shape=box,color=blue];
		1575 -> 1576;
		1575 -> 1577;
	1576 [label="... 오.",shape=box,color=red];
		1576 -> 1578;
	1577 [label="취할만 하네.",shape=box,color=red];
		1577 -> 1578;
	1578 [label="그 환상이 평생 내 마음속에 있었던 게 아니라는 걸 확실히 아오. 렐이라는 이름의 텐노와 그 수호자 해로우. 그 존재들이 내 어린 시절 집 안에 있었을 가능성은 없소.",shape=box,color=blue];
		1578 -> 1579;
	1579 [label="그 존재들이 내 마음속에서, 내 꿈속에서 속삭이고 알아들을 수 없는 목소리로 메아리쳤을 리가 없소. 하지만 여전히 기억 속에서 그들을 보고, 그의 목소리를 듣는다오.",shape=box,color=blue];
		1579 -> 1580;
	1580 [label="Check boolean LyonTime1",color=orange];
		1580 -> 1581 [label=true,color=green];
		1580 -> 1582 [label=false,color=brown];
	1581 [label="엔트라티가 말해줬던 설명 중 에너지가 시간 속 여러 장소에 동시에 존재할 수 있다는 것을 철학적 관점에서는 다 이해했소. 하지만 감정적으론 이해 못했소. 내가... 혈청을 주입하기 전까지는.",shape=box,color=blue];
		1581 -> 1583;
	1582 [label="혈청을 주입하는 순간 - 마치 모든 것들이 하나가 된 것 같더이다. 엔트라티가 스스로를 밝히고, 그의 존재에 대한 모든 진실을 드러냈을 때 - ",shape=box,color=blue];
		1582 -> 1584;
	1583 [label="가끔 마음속에서 크고 얕으면서 고요한 호수가 사방으로 뻗어 있는 전경이 보이오. 검고 매끄러운, 흑요석으로 된 예언의 거울처럼.",shape=box,color=blue];
		1583 -> 1585;
	1584 [label="그는 \"양자 얽힘\", \"중첩\", \"영원론\" 등 자신이 아는 모든 것들을 내게 설명해 주었소.",shape=box,color=blue];
		1584 -> 1586;
	1585 [label="무한히 흘러내리는 거대한 검은 호수. 이해하는 게 불가능하지.",shape=box,color=blue];
		1585 -> 1587;
	1586 [label="과학적인 관점이 아닌, 철학적인 의미로는 전부 이해했소. 하지만 감정적으론 이해 못했소. 내가... 그 혈청을 주입하기 전까지는.",shape=box,color=blue];
		1586 -> 1583;
	1587 [label="그리고 그곳에서 그들을 찾을 수 있소. 그곳에서 우리는 만나게 되니. 그리고 그곳에서 그들을 느낄 수 있소...",shape=box,color=blue];
		1587 -> 1588;
	1588 [label="그들?",shape=box,color=red];
		1588 -> 1589;
	1589 [label="다른 해로우들... 텅 빈 조각상, 메아리의 메아리의 메아리... 그들은 영원히 모든 방향으로 계속해서 이어지오...",shape=box,color=blue];
		1589 -> 1590;
	1590 [label="렐은 그 중 하나에 스스로를 집어넣었소. 그 안에서 자기 자신을 잃어버렸지. 그리고 그렇게 함으로써, 그 모든 존재들 안에서 스스로를 잃어버렸소...",shape=box,color=blue];
		1590 -> 1591;
	1591 [label="나도 포함해서. 나를 변형시킨 혈청 속에 있던 해로우도 포함해서.",shape=box,color=blue];
		1591 -> 1592;
		1591 -> 1593;
	1592 [label="보이드시여, 전혀 몰랐어...",shape=box,color=red];
		1592 -> 1594;
	1593 [label="오 안돼 -",shape=box,color=red];
		1593 -> 1594;
	1594 [label="그들은 내 마음속에서 나와 함께 있었소 - 렐과 그의 해로우는 나와 너무나 닮았지만, 동시에 너무나 다르기에.",shape=box,color=blue];
		1594 -> 1595;
	1595 [label="렐은 두려움이 없었고, 너무나 확신에 가득 차 있었지. 그 두 가지는 나에게는 없는 것이었으니.",shape=box,color=blue];
		1595 -> 1596;
	1596 [label="렐은 무심에 굳건히 맞섰고, 그것이 무엇인지, 무엇이 아닌지는 개의치 않았소. 그저 무엇을 해야 할지 알고 있었을 뿐.",shape=box,color=blue];
		1596 -> 1597;
	1597 [label="그가 겪었던 모든 잔혹함에도 불구하고. 그 모든 세월 동안, 그 영원의 \"지금\"과 \"그때\", 내가 혈청을 주입받던 그 순간... \"이전\"과 \"이후\"에도 렐은 거기에 있었소.",shape=box,color=blue];
		1597 -> 1598;
	1598 [label="렐은 내 친구였소. 나에게 있어 형제였소.",shape=box,color=blue];
		1598 -> 1599;
	1599 [label="과거에서? 현재에서?",shape=box,color=blue];
		1599 -> 1600;
	1600 [label="더 이상 렐의 기척이 느껴지지 않소.",shape=box,color=blue];
		1600 -> 1601;
		1600 -> 1602;
	1601 [label="렐은...렐은 이제 영면에 들었어, 리온... 렐은 평화를 되찾았어.",shape=box,color=red];
		1601 -> 1603;
	1602 [label="오, 리온...",shape=box,color=red];
		1602 -> 1604;
	1603 [label="나도 알고 있소. 렐이 떠났을 때 그 감정이 느껴졌으니까. 그리고 흐느껴 울었소. 렐이 너무나도 그립소. 아직도 렐의 목소리가 메아리친다는 걸 아오 - 어떻게든, 어떤 방식으로든, 그저 내가 완벽하게 이해하지 못할 뿐.",shape=box,color=blue];
		1603 -> 1605;
		1603 -> 1606;
	1604 [label="렐이 너무나도 그립소. 아직도 렐의 목소리가 메아리친다는 걸 아오 - 어떻게든, 어떤 방식으로든, 그저 내가 완벽하게 이해하지 못할 뿐.",shape=box,color=blue];
		1604 -> 1605;
		1604 -> 1606;
	1605 [label="렐은 우리 중 가장 강했어. 그를 알 기회가 조금이라도 있었다니 정말 다행이야.",shape=box,color=red];
		1605 -> 1607;
	1606 [label="렐은 아이들의 무지와 잔혹함 때문에 버림받았어... 렐은 그런 대우를 받아서는 안 되는 거였어.",shape=box,color=red];
		1606 -> 1608;
	1607 [label="나도 그를 알게 되어 기쁘오. 그의 힘이 강했냐하면? 강했을지도, 아닐지도 모르오. 결국, 렐은 무엇이 필요한지 알고 있었고, 그걸 실현할 만큼 강했으니.",shape=box,color=blue];
		1607 -> 1609;
	1608 [label="그랬을지도. 하지만 결국 렐은 필요한 일을 해냈고 그걸 실현할 만큼 강했소.",shape=box,color=blue];
		1608 -> 1609;
	1609 [label="이런 때에는, 우리가 할 수 있는 일이라곤 \"충분히 강하길\" 하고 기도하는 게 전부라고 생각하오.",shape=box,color=blue];
		1609 -> 1610;
	1610 [label="말이 나온 김에, 안타깝게도, 이 와인을 과소평가했던 것 같소... 매우 강하지만, 효과가 나타나기까지 시간이 걸렸소.",shape=box,color=blue];
		1610 -> 1611;
	1611 [label="이만 가봐야 ",shape=box,color=blue];
		1611 -> 1612;
	1612 [label="이만 가보겠소.",shape=box,color=blue];
		1612 -> 1613;
	1613 [label="Check boolean LyonDating",color=orange];
		1613 -> 1614 [label=true,color=green];
		1613 -> 1615 [label=false,color=brown];
	1614 [label="+20 Chemistry",color=orange];
		1614 -> 1616;
	1615 [label="+20 Chemistry",color=orange];
		1615 -> 1617;
	1616 [label="고맙소, 내 사랑.",shape=box,color=blue];
		1616 -> 1618;
	1617 [label="고맙소, 친구.",shape=box,color=blue];
		1617 -> 1618;
	1618 [label="- 리온",shape=box,color=blue];
		1618 -> 1619;
	1619 [label="Update boolean LyonConfession2",color=orange];
		1619 -> 1620;
	1620 [label="Update boolean LyonWillDate",color=orange];
		1620 -> 1621;
	1621 [label="Chat ends.",color=orange];
}