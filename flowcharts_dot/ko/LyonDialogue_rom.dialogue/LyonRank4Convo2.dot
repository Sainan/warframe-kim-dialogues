digraph {
	781 [label="LyonRank4Convo2 begins.",color=orange];
		781 -> 782;
		781 -> 783;
		781 -> 784;
	782 [label="당신하고 마리가 어떻게 신부와 수녀라는 신분을 유지할 수 있는지, 또... 폭력 행위를 저지르는 것도 받아들일 수 있는 지 알려줄래?",shape=box,color=red];
		782 -> 785;
		782 -> 786;
		782 -> 787;
	783 [label="리온, 좀 이상한 질문해도 돼?",shape=box,color=red];
		783 -> 788;
	784 [label="[종료.]",shape=box,color=red];
		784 -> 789;
	785 [label="마리가 \"païens!\"을 외치며 싸움터로 뛰어드는 소리를 들었는데... 그녀가 다른 신념을 가지고 누군가를 비난할 사람이라고는 생각하기 어려워. 당신도 크게 다르지 않겠지. 분명 마리는 당신을 아주 높이 평가하는 것 같아.",shape=box,color=red];
		785 -> 790;
	786 [label="당신과 마리가 여기서 하는 일에 대해 성당에선 어떻게 생각할까? 말하자면... 신들의 이름으로 당신이 해야 할 일에 대해서 말이야.",shape=box,color=red];
		786 -> 791;
	787 [label="난 전장에서 당신하고 마리를 지켜보고, 마리와 사적인 얘기를 나누고, 당신이 조용히 책 읽는 모습을 봐... 아무래도 내 마음속에선 당신들을 하나의 기준으로 맞춰서 보는데 어려움을 겪고 있는 것 같아.",shape=box,color=red];
	788 [label="만약 그대가 우리의 현재 상황을 그저 \"이상하다\"라고 표현한다면, 그저 그대의 강인함에 감탄하거나, 아니면 그대의 어휘력 부족에 실망할 것이오. 하지만, 전자에 감탄해야겠지.",shape=box,color=blue];
		788 -> 793;
	789 [label="Chat ends.",color=orange];
	790 [label="그대 말이 맞소. 마리는 다른 이들이 그들 마음속에 고대 나무의 신을 품고 있다고 비난하는 사람은 아니오. 오히려, 그 종교와 우리 종교가 어떤 공통점을 갖고 있는지 찾으려 들지.",shape=box,color=blue];
		790 -> 794;
	791 [label="그 당시에는 솔이나 루아의 이름으로 수많은 성전이 벌어졌소. \"이교도\"를 몰아내거나 \"성지를 차기하기 위해\" 피비린내 나는 \"십자군 전쟁\"을 벌이기도 했지. 당시 사람들이 즐겨 쓰던 온갖 엉뚱한 논리를 들먹이면서 말이오.",shape=box,color=blue];
		791 -> 795;
	793 [label="+5 Chemistry",color=orange];
		793 -> 797;
	794 [label="혹시 그 나무는 솔의 빛으로 영양분을 얻지 못하는 걸까? 다른 이들과 빵을 나눌 수 있는 공통점이 없는 걸까? 마리는 그들의 신앙을 해치려 하기보다는 그들의 이야기를 듣고 싶어 한다오.",shape=box,color=blue];
		794 -> 798;
	795 [label="광휘의 성체 정교회는 군대도 없고, 전쟁도 치르지 않소. 그들은 소속 교단원들이 행동하거나 다른 교단을 보호하는 걸 막지 않는다오.",shape=box,color=blue];
		795 -> 727;
	797 [label="즉, 말하자면, 좋소, 계속해서 물어보시오. 그대가 궁금해하는 것이 무엇이든 물어본다고 해서 내가 더 이상 \"이상하다\"라고 느낄 수는 없으니.",shape=box,color=blue];
		797 -> 785;
		797 -> 786;
		797 -> 787;
	798 [label="마리가 전장에서 적들과 교전할 때, 그건 두 가지 이유 중 하나라고 생각되오: 하나는 고대 십자군처럼 행동하며 즐거운 시간을 보내거나, 솔의 기사처럼 빛나는 갑옷을 입은 스스로를 상상하며 놀거나 -",shape=box,color=blue];
		798 -> 796;
	727 [label="마리가 전장에서 적들과 교전할 때, 그건 두 가지 이유 중 하나라고 생각되오: 하나는 고대 십자군처럼 행동하며 즐거운 시간을 보내거나, 솔의 기사처럼 빛나는 갑옷을 입은 스스로를 상상하며 놀거나 -",shape=box,color=blue];
		727 -> 796;
	796 [label="아니면, 아마도 마리는 아스타포어 8장 23절 \"폭력을 행하여 나의 집에 들어오려는 영혼들은 외로운 존재들이다. 그들은 솔의 빛에서 쫓겨난 자들이기에.\" 라는 말을 기억하고 있을 것이오.",shape=box,color=blue];
		796 -> 799;
	799 [label="그녀의 눈으로는, 더 큰 선을 수호한다는 명목으로 행하는 폭력은 정의로운 일이오 - 그대도 그럴 것이고, 그대와 함께 싸우는 이들도 그럴꺼라 생각하오만. ",shape=box,color=blue];
		799 -> 800;
	800 [label="따라서, 마리가 싸우는 존재들 - 종교와 상관없이 - 솔에서 추방된 존재들이오. 설령 그녀가 속한 교단의 신성한 옷을 입었다 하더라도, 그 눈에는 이교도로 인지될 뿐이오.",shape=box,color=blue];
		800 -> 801;
		800 -> 802;
	801 [label="이 대화에서 당신만 쏙 빼놓고 얘기하는 거 알아챘거든. 이 모든 싸움에 대해서 당신은 어떻게 생각해?",shape=box,color=red];
		801 -> 803;
	802 [label="이해가 되는 것 같아. 고마워.",shape=box,color=red];
		802 -> 804;
	803 [label="난 의도적으로 회피하고 있었소만, 드리프터.",shape=box,color=blue];
		803 -> 805;
		803 -> 806;
	804 [label="+5 Chemistry",color=orange];
		804 -> 807;
	805 [label="대놓고 고집부리면서 말하네, 신부님.",shape=box,color=red];
		805 -> 808;
	806 [label="알았어. 오늘 들은 이야기로만 만족할게.",shape=box,color=red];
		806 -> 804;
	807 [label="말해두겠지만, 마리는... 그대가 좋은 의도로 왔다고 했었소. 그리고 난 내 자신을 믿지 못할 때조차도 마리를 믿지.",shape=box,color=blue];
		807 -> 809;
	808 [label="+10 Chemistry",color=orange];
		808 -> 810;
	809 [label="결국 내가 할 수 있는 건 그대의 인내심에 간청하는 것 뿐이오. 대부분의 날, 루아께선 내 스스로의 인내심 부족하다는 걸 알고 계시지.",shape=box,color=blue];
		809 -> 811;
	810 [label="잘 알겠소. 만류에도 불구하고 그리 호기심이 많소? 내가 초래한 죽음이... 예상만큼 그렇게까지 스스로를 괴롭히진 않았소.",shape=box,color=blue];
		810 -> 812;
	811 [label="-리온 알라드 신부",shape=box,color=blue];
		811 -> 813;
	812 [label="또는 다른 말로 표현하자면, 이건 나 같이 성직자와 학자를 겸하는 이가 \"적합하다\" 할 수도 있겠거니.",shape=box,color=blue];
		812 -> 814;
		812 -> 815;
	813 [label="Chat ends.",color=orange];
	814 [label="난 살아오면서 평화보다 전쟁을 더 많이 봐 왔어, 리온. 만약 내가 그러한 경험에 시달렸다면, 여기에 있지도 못했겠지. 하지만 그렇다고 해서 전쟁이란게 큰 부담, 큰 대가를 치르지 않는다는 건 아니야.",shape=box,color=red];
		814 -> 816;
	815 [label="다른 이들이 내가 누구인지, 내가 무엇인지, 내가 어디에서 왔는지 말해줬겠지. 나를 따라오는 죽음 - 내가 불러온 죽음. 나를 정의하는 죽음. 당신이 느끼는 어떠한 것들이 날 놀라게 하는 게 가능할 것 같아?",shape=box,color=red];
		815 -> 817;
	816 [label="Add 1 to Thermostat",color=orange];
		816 -> 818;
	817 [label="Add -1 to Thermostat",color=orange];
		817 -> 819;
	818 [label="그렇소, 실제로도 그렇고.",shape=box,color=blue];
		818 -> 820;
		818 -> 821;
	819 [label="그러하오, 그러리라 믿기도 하고.",shape=box,color=blue];
		819 -> 820;
		819 -> 821;
	820 [label="미안. 화난게 느껴져. 그럴 의도가 아니었어.",shape=box,color=red];
		820 -> 822;
	821 [label="자세히 좀... 설명해 줄래?",shape=box,color=red];
		821 -> 823;
	822 [label="그대를 탓하려는 게 아니오, 드리프터. 리버타시아에 있는 우리 형제자매들의 말을 빌려서 표하자면, 나라는 존재는 \"이해하기 힘든\" 사람이니까.",shape=box,color=blue];
		822 -> 824;
	823 [label="마음 속에 울려 퍼지는 공포는 경계를 알 수 없는 듯 하오. 한때 신성한 진홍색으로 물들었던 인간의 힘줄이 부서지고 검게 변하는 것을 보았소.",shape=box,color=blue];
		823 -> 825;
	824 [label="나라는 존재는 그저 포위당한 개인일 뿐. 나는 벽을 지키고 있소. 문을 여는 것은 방어선의 온전함을 위협하는 것이니까.",shape=box,color=blue];
		824 -> 826;
		824 -> 827;
	825 [label="내 자신이 가지고 있는 수십만 개의 얼굴을 보오. 비슷하지만, 낯선 얼굴들. 속이 빈 관, 뒤틀리고 부서진 인간의 살덩어리들, 삶과 죽음 사이의 장막에 매달려 있는 시체들.",shape=box,color=blue];
		825 -> 828;
	826 [label="이해했어. 당신이 준비될 때, 얘기 나누도록 하자.",shape=box,color=red];
		826 -> 829;
	827 [label="무슨 뜻이야?",shape=box,color=red];
		827 -> 823;
	828 [label="공허 속 침묵의 가면에 갇힌 표현들. 하지만 그들의 영혼은 깜빡거리는 잔해 속에서, 고요히 남아 사라지지 않는 불씨 속에서, 난 그들의 비명 소리를 듣소. 끝없이 갈망하며 울부짖소. 응징을. 자유를.",shape=box,color=blue];
		828 -> 830;
	829 [label="이 문제에 있어서 선택의 여지가 없다는 분명한 인상을 받기 시작했소만.",shape=box,color=blue];
		829 -> 831;
	830 [label="죽음을.",shape=box,color=blue];
		830 -> 832;
	831 [label="+15 Chemistry",color=orange];
		831 -> 833;
	832 [label="깨어 있는 시간 내내 이 환상들이 나를 괴롭히오. 꿈에서조차도. 난 악몽을 꾸지 않는데, 내가 경험하는 것들 - 전부가 이루어지기 때문이오.",shape=box,color=blue];
		832 -> 834;
	833 [label="그러나 말해두겠지만, 마리는... 그대가 좋은 의도로 왔다고 했었소. 그리고 난 내 자신을 믿지 못할 때조차도 마리를 믿지.",shape=box,color=blue];
		833 -> 835;
	834 [label="Check boolean LyonPainOff",color=orange];
		834 -> 836 [label=true,color=green];
		834 -> 837 [label=false,color=brown];
	835 [label="결국 내가 할 수 있는 건 그대의 인내심에 간청하는 것 뿐이오. 대부분의 날, 루아께선 내 스스로의 인내심 부족하다는 걸 알고 계시지.",shape=box,color=blue];
		835 -> 838;
	836 [label="내 영혼 속에 울려 퍼지는 속삭임에 제물을 바칠 때만, 세상이 내 스스로에게 익숙하게 느껴질 만한 방식으로 반사되어 돌아오지.",shape=box,color=blue];
		836 -> 839;
	837 [label="내 영혼 속에 울려 퍼지는 속삭임에 제물로 내 육신을 찢어낼 때만, 세상이 내 스스로에게 익숙하게 느껴질 만한 방식으로 반사되어 돌아오지.",shape=box,color=blue];
		837 -> 839;
	838 [label="-리온 알라드 신부",shape=box,color=blue];
		838 -> 840;
	839 [label="그러니 내가 \"느끼는\" 걸 아는 척하지 마시오, 드리프터. 그대는 이제서야 막 이해하기 시작한 것 같으니까.",shape=box,color=blue];
		839 -> 841;
		839 -> 842;
		839 -> 843;
	840 [label="Update boolean LyonVisions2d",color=orange];
		840 -> 844;
	841 [label="미 - 미안해. 몰랐어.",shape=box,color=red];
		841 -> 845;
	842 [label="그리고 내가 봐왔던 수많은 공포와 고통이 있는데 당신도 그걸 이해 못하지, 리온.",shape=box,color=red];
		842 -> 846;
	843 [label="내가 말을 잘못했다면 사과하겠지만, 이해하고 싶은 것 뿐이야. 당신의 이런 환상들을...",shape=box,color=red];
		843 -> 847;
	844 [label="Chat ends.",color=orange];
	845 [label="알았소, 뭐, 이 긴 세월을 잘 버텨왔으니까. 앞으로 몇 년은 더 버틸 수 있을 거라 확신하오. 그대가 크게 걱정할 필요는 없소.",shape=box,color=blue];
		845 -> 848;
	846 [label="이 장소의 형상이 반영된 것을 보면, 분명 그러리라 확신이 드오. 하지만 그대는 자신이 최고라고 생각하지 않소? 모든 공포와 고통에 관한 최고 권위자 아니오?",shape=box,color=blue];
		846 -> 849;
		846 -> 850;
	847 [label="알았소, 뭐, 인생 내내 그 모든 것들을 잘 견뎌왔으니까. 앞으로 몇 년은 더 버틸 수 있을 거라 확신하오. 그대가 크게 걱정할 필요는 없소.",shape=box,color=blue];
		847 -> 848;
	848 [label="Update boolean LyonVisions2a",color=orange];
		848 -> 851;
		848 -> 852;
	849 [label="당신이 겪고 있는 일을 당신이 생각하는 것보다 내가 더 공감해줄 수 있잖아.",shape=box,color=red];
		849 -> 853;
	850 [label="내가 죽음과 공포를 많이 겪어왔다고 말했잖아, 리온. 그러니까 그런 일로 깎아내리는 거 별로 좋아하지 않아.",shape=box,color=red];
		850 -> 854;
	851 [label="당신이 묘사하는 거 말이야, 리온... 그 환상이 프로토프레임이 되기 전에 시작됐어, 아니면 후에 시작됐어?",shape=box,color=red];
		851 -> 855;
	852 [label="이 건에 대해서 나중에 다시 얘기해줄래? 제발?",shape=box,color=red];
		852 -> 856;
	853 [label="Update boolean LyonVisions2b",color=orange];
		853 -> 857;
	854 [label="Update boolean LyonVisions2c",color=orange];
		854 -> 858;
	855 [label="그대가 생각하는 것처럼 간단한 질문이라 여겨진다면. 어찌됐든, 오늘은 대답할 생각이 없소. 머리가 아파올 것 같으니.",shape=box,color=blue];
		855 -> 859;
	856 [label="이 문제에 있어서 선택의 여지가 없다는 분명한 인상을 받기 시작했소만.",shape=box,color=blue];
		856 -> 859;
	857 [label="동정을 구하지 않는다는 게 이상하게 들릴지도 모르겠지만, 드리프터. 내가 찾는 건 답이오. 보증 말이오. 모든 것이 환상이고 거짓일 때 하늘에서 알려주는 답.",shape=box,color=blue];
		857 -> 860;
		857 -> 861;
	858 [label="그럼 날 그대의 발 앞에 엎드리게 하시오. 그대가 견뎌낸 모든 것들에 찬사를 보낼 터이니. 그 수많은 것들을 목격했음에도 불구하고 어찌하여 아직까지 제정신을 유지하고 있는지 궁금하구려.",shape=box,color=blue];
		858 -> 862;
	859 [label="+10 Chemistry",color=orange];
		859 -> 863;
	860 [label="해볼 수 있는 걸 해볼게.",shape=box,color=red];
		860 -> 864;
	861 [label="그럼, 내가 도와줄 수 있을 것 같아. 이 건에 대해서 나중에 다시 얘기해줄래? 제발?",shape=box,color=red];
		861 -> 856;
