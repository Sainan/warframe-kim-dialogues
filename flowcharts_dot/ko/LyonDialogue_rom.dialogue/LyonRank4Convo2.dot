		j3444806326 -> j2722086859;
	j1338108737 [label="그리고 내가 봐왔던 수많은 공포와 고통이 있는데 당신도 그걸 이해 못하지, 리온.",shape=box,color=red];
		j1338108737 -> j1128306014;
	j2639814741 [label="내가 말을 잘못했다면 사과하겠지만, 이해하고 싶은 것 뿐이야. 당신의 이런 환상들을...",shape=box,color=red];
		j2639814741 -> j3154680827;
	j2722086859 [label="알았소, 뭐, 이 긴 세월을 잘 버텨왔으니까. 앞으로 몇 년은 더 버틸 수 있을 거라 확신하오. 그대가 크게 걱정할 필요는 없소.",shape=box,color=blue];
		j2722086859 -> j4270520825;
	j1128306014 [label="이 장소의 형상이 반영된 것을 보면, 분명 그러리라 확신이 드오. 하지만 그대는 자신이 최고라고 생각하지 않소? 모든 공포와 고통에 관한 최고 권위자 아니오?",shape=box,color=blue];
