		j909855652 -> j3306093240;
	j4066575096 [label="내가 죽음과 공포를 많이 겪어왔다고 말했잖아, 리온. 그러니까 그런 일로 깎아내리는 거 별로 좋아하지 않아.",shape=box,color=red];
		j4066575096 -> j1519447360;
	j3934591328 [label="당신이 묘사하는 거 말이야, 리온... 그 환상이 프로토프레임이 되기 전에 시작됐어, 아니면 후에 시작됐어?",shape=box,color=red];
