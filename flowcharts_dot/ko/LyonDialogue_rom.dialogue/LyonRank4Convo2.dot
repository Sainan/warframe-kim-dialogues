	j4219105113 [label="결국 내가 할 수 있는 건 그대의 인내심에 간청하는 것 뿐이오. 대부분의 날, 루아께선 내 스스로의 인내심 부족하다는 걸 알고 계시지.",shape=box,color=blue];
		j4219105113 -> j1355207950;
	j1252244658 [label="내 영혼 속에 울려 퍼지는 속삭임에 제물을 바칠 때만, 세상이 내 스스로에게 익숙하게 느껴질 만한 방식으로 반사되어 돌아오지.",shape=box,color=blue];
		j1252244658 -> j3382422233;
	j1105667921 [label="내 영혼 속에 울려 퍼지는 속삭임에 제물로 내 육신을 찢어낼 때만, 세상이 내 스스로에게 익숙하게 느껴질 만한 방식으로 반사되어 돌아오지.",shape=box,color=blue];
		j1105667921 -> j3382422233;
	j1355207950 [label="-리온 알라드 신부",shape=box,color=blue];
		j1355207950 -> j2522325746;
	j3382422233 [label="그러니 내가 \"느끼는\" 걸 아는 척하지 마시오, 드리프터. 그대는 이제서야 막 이해하기 시작한 것 같으니까.",shape=box,color=blue];
		j3382422233 -> j3444806326;
