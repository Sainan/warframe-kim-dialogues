digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank4Convo7 begins." [color=orange];
		"LyonRank4Convo7 begins." -> j2665726607;
	j2665726607 [label="드리프터? 그대에게 사과해도 되겠소?",shape=box,color=blue];
		j2665726607 -> j1859397250;
		j2665726607 -> j2135502624;
		j2665726607 -> j3039724897;
	j1859397250 [label="물론이지...? 근데 뭘 사과해?",shape=box,color=red];
		j1859397250 -> j1074968798;
	j2135502624 [label="사과할 필요없어, 리온. 아무것도 잘못한 게 없잖아.",shape=box,color=red];
		j2135502624 -> j1306657343;
	j3039724897 [label="[종료.]",shape=box,color=red];
		j3039724897 -> "Chat ends.";
	j1074968798 [label="+5 Chemistry",color=orange];
		j1074968798 -> j3150706724;
	j1306657343 [label="고맙지만, 그래도 그대에게는 내 사과를 받을 자격이 있다고 생각하오. 최대한 간략히 적어서, 불필요한 학식으로 부담을 주지 않도록 노력하겠소.",shape=box,color=blue];
		j1306657343 -> j228343512;
	"Chat ends." [color=orange];
	j3150706724 [label="고맙소. 최대한 간략히 적어서, 불필요한 학식으로 부담을 주지 않도록 노력하겠소.",shape=box,color=blue];
		j3150706724 -> j228343512;
	j228343512 [label="난 대화가 어렵소. 이런 종류의 비인격적이고 기계적인 대화나 우편보다 친밀한 대화에선 훨씬 더 그러하오.",shape=box,color=blue];
		j228343512 -> j2758129989;
	j2758129989 [label="어찌 설명해야 할지 모르겠구려 - 다만, 마치 무언가를... 움켜쥐려고 애쓰지만, 손가락 사이로 먼지 조각이 빠져나가는 것 같은 느낌이오. ",shape=box,color=blue];
		j2758129989 -> j3415509734;
	j3415509734 [label="난 종종 빈 캔버스 조각인 것 같은 기분이 드오. 캔버스 표면에 유화 물감을 묻히고, 내 마음의 눈으로 볼 수 있는 형상의 그림자를 만들려고 애쓰는 것 같소.",shape=box,color=blue];
		j3415509734 -> j2734141231;
	j2734141231 [label="하지만 내가 더 많이 이러한 작업을 진행해도, 희망은 점점 더 없어질 뿐.",shape=box,color=blue];
		j2734141231 -> j2313479988;
	j2313479988 [label="더 노력할수록 더 멀어져만 가오. 그래서 난... 아예 시도조차 하지 않는 법을 배웠소.",shape=box,color=blue];
		j2313479988 -> j2606220376;
	j2606220376 [label="그래서 처음에 내가 그대를 피한거요. 그리고 아직도... 내가 고독에 시달리는 이유이기도 하지. 할 말이 잘 안 떠오르오.",shape=box,color=blue];
		j2606220376 -> j856330031;
		j2606220376 -> j563025508;
		j2606220376 -> j3108700718;
	j856330031 [label="당신이 내 곁에 조용히 있어준다면 난 언제나 행복할 거야.",shape=box,color=red];
		j856330031 -> j422502578;
	j563025508 [label="나도 가끔은 그런 편이니까. 다 괜찮아.",shape=box,color=red];
		j563025508 -> j4171919909;
	j3108700718 [label="사과를 받아줄게.",shape=box,color=red];
		j3108700718 -> j3074525836;
	j422502578 [label="+15 Chemistry",color=orange];
		j422502578 -> j476020001;
	j4171919909 [label="+15 Chemistry",color=orange];
		j4171919909 -> j3809622888;
	j3074525836 [label="+10 Chemistry",color=orange];
		j3074525836 -> j3106782582;
	j476020001 [label="꼭... 기억해 두겠소. 고맙소, 드리프터.",shape=box,color=blue];
		j476020001 -> j3312326441;
	j3809622888 [label="전혀 눈치채지 못했소. 이 세상에 나 혼자만 있는 게 아니라는 걸 기억해 두겠소... 고맙소, 드리프터.",shape=box,color=blue];
		j3809622888 -> j3312326441;
	j3106782582 [label="물론이요. 고맙소, 드리프터.",shape=box,color=blue];
		j3106782582 -> j3312326441;
	j3312326441 [label="-리온 알라드 신부",shape=box,color=blue];
