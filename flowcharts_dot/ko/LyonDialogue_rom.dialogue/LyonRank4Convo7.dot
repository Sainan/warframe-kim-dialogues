digraph {
	1285 [label="LyonRank4Convo7 begins.",color=orange];
		1285 -> 1286;
	1286 [label="드리프터? 그대에게 사과해도 되겠소?",shape=box,color=blue];
		1286 -> 1287;
		1286 -> 1288;
		1286 -> 1289;
	1287 [label="물론이지...? 근데 뭘 사과해?",shape=box,color=red];
		1287 -> 1290;
	1288 [label="사과할 필요없어, 리온. 아무것도 잘못한 게 없잖아.",shape=box,color=red];
		1288 -> 1291;
	1289 [label="[종료.]",shape=box,color=red];
		1289 -> 1292;
	1290 [label="+5 Chemistry",color=orange];
		1290 -> 1293;
	1291 [label="고맙지만, 그래도 그대에게는 내 사과를 받을 자격이 있다고 생각하오. 최대한 간략히 적어서, 불필요한 학식으로 부담을 주지 않도록 노력하겠소.",shape=box,color=blue];
		1291 -> 1294;
	1292 [label="Chat ends.",color=orange];
	1293 [label="고맙소. 최대한 간략히 적어서, 불필요한 학식으로 부담을 주지 않도록 노력하겠소.",shape=box,color=blue];
		1293 -> 1294;
	1294 [label="난 대화가 어렵소. 이런 종류의 비인격적이고 기계적인 대화나 우편보다 친밀한 대화에선 훨씬 더 그러하오.",shape=box,color=blue];
		1294 -> 1295;
	1295 [label="어찌 설명해야 할지 모르겠구려 - 다만, 마치 무언가를... 움켜쥐려고 애쓰지만, 손가락 사이로 먼지 조각이 빠져나가는 것 같은 느낌이오. ",shape=box,color=blue];
		1295 -> 1296;
	1296 [label="난 종종 빈 캔버스 조각인 것 같은 기분이 드오. 캔버스 표면에 유화 물감을 묻히고, 내 마음의 눈으로 볼 수 있는 형상의 그림자를 만들려고 애쓰는 것 같소.",shape=box,color=blue];
		1296 -> 1297;
	1297 [label="하지만 내가 더 많이 이러한 작업을 진행해도, 희망은 점점 더 없어질 뿐.",shape=box,color=blue];
		1297 -> 1298;
	1298 [label="더 노력할수록 더 멀어져만 가오. 그래서 난... 아예 시도조차 하지 않는 법을 배웠소.",shape=box,color=blue];
		1298 -> 1299;
	1299 [label="그래서 처음에 내가 그대를 피한거요. 그리고 아직도... 내가 고독에 시달리는 이유이기도 하지. 할 말이 잘 안 떠오르오.",shape=box,color=blue];
		1299 -> 1300;
		1299 -> 1301;
		1299 -> 1302;
	1300 [label="당신이 내 곁에 조용히 있어준다면 난 언제나 행복할 거야.",shape=box,color=red];
		1300 -> 1303;
	1301 [label="나도 가끔은 그런 편이니까. 다 괜찮아.",shape=box,color=red];
		1301 -> 1304;
	1302 [label="사과를 받아줄게.",shape=box,color=red];
		1302 -> 1305;
	1303 [label="+15 Chemistry",color=orange];
		1303 -> 1306;
	1304 [label="+15 Chemistry",color=orange];
		1304 -> 1307;
	1305 [label="+10 Chemistry",color=orange];
		1305 -> 1308;
	1306 [label="꼭... 기억해 두겠소. 고맙소, 드리프터.",shape=box,color=blue];
		1306 -> 1309;
	1307 [label="전혀 눈치채지 못했소. 이 세상에 나 혼자만 있는 게 아니라는 걸 기억해 두겠소... 고맙소, 드리프터.",shape=box,color=blue];
		1307 -> 1309;
	1308 [label="물론이요. 고맙소, 드리프터.",shape=box,color=blue];
		1308 -> 1309;
	1309 [label="-리온 알라드 신부",shape=box,color=blue];
		1309 -> 1310;
	1310 [label="Chat ends.",color=orange];
}