	j1316396836 [label="Check boolean LyonPolyamorySuccess",color=orange];
		j1316396836 -> j1181132753 [label=true,color=green];
		j1316396836 -> "Chat ends." [label=false,color=brown];
	j4257936266 [label="허락만 해준다면, 우리 두 사람의 마음을 편안하게 해줄 수 있을 것 같은 내용을 간략히 전하고 싶소, mon miracle.",shape=box,color=blue];
		j4257936266 -> j1122773555;
		j4257936266 -> j1294561268;
	j1122773555 [label="[종료.]",shape=box,color=red];
		j1122773555 -> j3944516755;
	j1294561268 [label="무슨 문제 있어, 리온?",shape=box,color=red];
		j1294561268 -> j3202864753;
	j3944516755 [label="Boolean LyonConsentComplete is now true.",color=orange];
		j3944516755 -> "Chat ends.";
	j3202864753 [label="아니, 아무 문제도 없소. 그냥 그대가 나와 함께 있지 않을 때 다른 이와... 애정 어린 방식으로 시간을 보낸다는 걸 알고 있다는 걸 전하고 싶었소.",shape=box,color=blue];
		j3202864753 -> j2306282444;
	j2306282444 [label="그리고 이 사실이 날 주저하게 만들거나 불안하게 만들지 않는다는 걸 확실히 말하고 싶었소. 그대가 내 삶에 함께한 것으로 내게 평화와 기쁨만을 가져다 주었으니까...",shape=box,color=blue];
		j2306282444 -> j597398956;
	j597398956 [label="그리고 다른 이라고 해서 어떻게 그런 선물을 거부할 수 있겠소?",shape=box,color=blue];
		j597398956 -> j2937854837;
		j597398956 -> j4137968808;
	j2937854837 [label="다른 상대방도 당신을 좋아할 거라고 생각해.",shape=box,color=red];
		j2937854837 -> j971287662;
	j4137968808 [label="고마워. 그 말들 나한텐 큰 의미야.",shape=box,color=red];
		j4137968808 -> j4258745109;
	j971287662 [label="그 생각만 해도 미소가 지어지는 구려. 그리고 어쩌면 다른 삶, 혹은 다른 날에 우리가 만날지도 모르니까. ",shape=box,color=blue];
		j971287662 -> j191877508;
	j4258745109 [label="지금 우리가 - 지금의 내가, 그대가 가져다준 모든 것, 우리가 상징하는 모든 것에... 만족하오. 아니, 난... 행복하오. 실로 아주, 오랜만에 처음으로.",shape=box,color=blue];
		j4258745109 -> j2495156281;
	j191877508 [label="하지만 이건에서는, 우리처럼 만족스럽소. 아니, 난... 행복하오. 실로 아주, 오랜만에 처음으로.",shape=box,color=blue];
		j191877508 -> j2495156281;
	j2495156281 [label="그리고 그건 그대 덕분이요. 하지만 지금은, 작별 인사를 건네야 할 것 같구려.",shape=box,color=blue];
		j2495156281 -> j3649559419;
	j3649559419 [label="- 리온",shape=box,color=blue];
		j3649559419 -> j3944516755;
}