		2218 -> 2220;
	2219 [label="Update boolean LyonConsentComplete",color=orange];
		2219 -> 2221;
	2220 [label="아니, 아무 문제도 없소. 그냥 그대가 나와 함께 있지 않을 때 다른 이와... 애정 어린 방식으로 시간을 보낸다는 걸 알고 있다는 걸 전하고 싶었소.",shape=box,color=blue];
		2220 -> 2222;
	2221 [label="Chat ends.",color=orange];
	2222 [label="그리고 이 사실이 날 주저하게 만들거나 불안하게 만들지 않는다는 걸 확실히 말하고 싶었소. 그대가 내 삶에 함께한 것으로 내게 평화와 기쁨만을 가져다 주었으니까...",shape=box,color=blue];
		2222 -> 2223;
	2223 [label="그리고 다른 이라고 해서 어떻게 그런 선물을 거부할 수 있겠소?",shape=box,color=blue];
		2223 -> 2224;
		2223 -> 2225;
	2224 [label="다른 상대방도 당신을 좋아할 거라고 생각해.",shape=box,color=red];
		2224 -> 2226;
	2225 [label="고마워. 그 말들 나한텐 큰 의미야.",shape=box,color=red];
		2225 -> 2227;
	2226 [label="그 생각만 해도 미소가 지어지는 구려. 그리고 어쩌면 다른 삶, 혹은 다른 날에 우리가 만날지도 모르니까. ",shape=box,color=blue];
		2226 -> 2228;
	2227 [label="지금 우리가 - 지금의 내가, 그대가 가져다준 모든 것, 우리가 상징하는 모든 것에... 만족하오. 아니, 난... 행복하오. 실로 아주, 오랜만에 처음으로.",shape=box,color=blue];
		2227 -> 2229;
	2228 [label="하지만 이건에서는, 우리처럼 만족스럽소. 아니, 난... 행복하오. 실로 아주, 오랜만에 처음으로.",shape=box,color=blue];
		2228 -> 2229;
	2229 [label="그리고 그건 그대 덕분이요. 하지만 지금은, 작별 인사를 건네야 할 것 같구려.",shape=box,color=blue];
