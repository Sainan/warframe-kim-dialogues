		j259886552 -> j728885961;
	j3481623597 [label="만약 당신이 뭔가를 보고 있다면, 그 환상이 당신을 괴롭히는지가 내 유일한 궁금증이다만?",shape=box,color=red];
		j3481623597 -> j2736934020;
	j4213305970 [label="당신이 저번에 했던 말 - 당신이 괜찮은지 궁금했을 뿐이었어, 그게 다야.",shape=box,color=red];
		j4213305970 -> j3896380367;
