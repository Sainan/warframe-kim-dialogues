		447 -> 448;
	448 [label="사실, 전에 계시던 추기경이 몇 달 전 병으로 세상을 떠나신 후 우린 새로운 추기경을 기다리고 있었소.",shape=box,color=blue];
		448 -> 449;
	449 [label="Dimanche는 따뜻한 미소와 굳은 악수로 날 맞이했으며, 난 그에게 여정이 길었는지에 대해 물었소. 그 대답은 절대 잊지 못할 것이니.",shape=box,color=blue];
		449 -> 450;
