		j1428371468 -> j4012650878 [label=false,color=brown];
	j595978381 [label="그리고 만약 그 진술이 사실이라면, 어찌 받아들일 거요, 드리프터?",shape=box,color=blue];
		j595978381 -> j2821822155;
	j3724053387 [label="\"그리고\" 그게 끝이오. 그 사건을 내가 어떻게 목격했는지, 내 경험의 진실을 그대로 말씀드렸소. 다른 건 없소.",shape=box,color=blue];
		j3724053387 -> j1043975064;
	j2938496584 [label="마리는 엔트라티가 실제로 무엇을 할 수 있는지, 그리고 그 인간이 \"진보\"와 이제는 \"구원\"이라는 이름으로 저지른 모든 끔찍한 일에 대한 모든 사실들을 알지 못해.",shape=box,color=red];
		j2938496584 -> j2939431420;
	j4099376455 [label="마리는 다 큰 성인이야. 그녀를 보호하고자 하는 당신 마음은 존경스럽지만, 마리도 무엇을 믿고 누구를 믿을지는 스스로 결정할 수 있어.",shape=box,color=red];
		j4099376455 -> j1846536867;
	j2284937264 [label="우리의 육신을 더럽히고, 우리의 미래를 파괴하고, 우리의 과거를 오염시킨 것 - 이 모든 것, 아마도 용서할 수 있을거요.",shape=box,color=blue];
		j2284937264 -> j2640816042;
	j664443380 [label="엔트라티는 그다지 좋은 행동을 취하고 있진 않지만, 우주를 구하려고 노력하고 있잖아.",shape=box,color=red];
		j664443380 -> j2284937264;
	j3262720688 [label="그 인간이 당신에게 로스처럼 프로토프레임이 되도록 강요했어?",shape=box,color=red];
		j3262720688 -> j73458951;
	j4012650878 [label="물론이야. 근데 왜 엔트라티에게 화나있어?",shape=box,color=red];
		j4012650878 -> j3394034844;
