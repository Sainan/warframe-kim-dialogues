	j3335346390 [label="뭐, 솔직히 말하자면 - 그대 앞에 다른 선택지들이 놓여져 있는데... 마리나 로스나... 아니면 우주의 다른 누군가라던가...",shape=box,color=blue];
		j3335346390 -> j1151000804;
	j1266355358 [label="많은 이들은 내가 그렇게 좋지 않은 상태라 생각할 수도 있고, 실제로도 그럴 가능성이 매우 높다는 걸 스스로도 알고 있소. 적어도 내 정신이 완전한 상태는 아니란 말이오.",shape=box,color=blue];
		j1266355358 -> j4098640939;
	j2222501570 [label="이제, 그대가 마리와 함께 시간을 보내게 되어 행복하다는 말을 전하겠소. 내가 그대에게 슬픔만을 안겨주던 곳에서 마리는 그대에게 기쁨을 줄 것이니. 그녀와 함께 행복하시오. 내 모든 축복을 그대에게 전하오.",shape=box,color=blue];
