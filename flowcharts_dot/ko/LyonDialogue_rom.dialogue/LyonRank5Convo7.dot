		j2756298967 -> j2753510653;
	j2753510653 [label="어젯밤 악몽에 시달리다 일어났소. 깨어나니 그림자가 날 에워싸더이다. 내 정신 상태에선 전혀 낯설거나 새로운 게 아니었으니. 그림자는 침대 위로 드리워져 걷히지 않았소.",shape=box,color=blue];
		j2753510653 -> j2319380109;
	j2319380109 [label="그들이 두렵지는 않았소. 날 해칠 수 없다는 것을 알았으니까. 하지만 그렇다고 내 마음에서 사라지는 것 또한 아니었지. 내가 아는 한, 그들을 없앨 수 있는 방법은 오직 하나 뿐이었소.",shape=box,color=blue];
		j2319380109 -> j212020377;
	j212020377 [label="침대에서 몸을 일으켜, 계속되는 악몽으로 흐릿해진 시야를 뚫고 비틀거리며 앞으로 나아가 간신히 옷을 입었소. 향로를 움켜쥐고 바닥 한가운데 무릎을 꿇고... 준비를 했지. ",shape=box,color=blue];
