		j3034788933 -> j2900120704;
	j4072889892 [label="아무 문제도 없소 - 오히려 그 반대지. 바로 그점이 이해해야 할 중요한 지점이며 - 내가 그대를 해방시켜주고 싶은 끔찍한 결과요. 만약 그대가 그런 일이 뒤따를 것이라고 고려하고 있다면 말이오.",shape=box,color=blue];
