		2079 -> 2081;
	2080 [label="아무 말도 하지 않아도 되오, mon miracle... ",shape=box,color=blue];
		2080 -> 2082;
	2081 [label="맹세해 주시오, mon miracle - 내가 그대에게 공허한 감옥이 되는 때가 오면... 나로부터 자유로워지겠다고.",shape=box,color=blue];
		2081 -> 2083;
	2082 [label="걷는 도중... 그러한 순간의 어두운 위험에 대해 바로 깨달았소. 그대가... 그걸 책임감으로 생각하게 될지도 모른다는 생각 - 그대 스스로를 날 짓누르는 사슬로 여기게 될지도 모른다는 생각 말이오.",shape=box,color=blue];
