	j574881653 [label="+5 Chemistry",color=orange];
		j574881653 -> j2617978386;
	j2708227267 [label="하. 내가 놀랄거라 생각했소? 난 마리의 빛 아래 서있고, 항상 그래 왔소. 다른 뜻이 있어서 이러는 게 아니오, 친구여 - 원망하거나 질투하는 게 아니오. 약조드리리다.",shape=box,color=blue];
		j2708227267 -> j4176294050;
	j833956337 [label="우리 모두가 그런 편이지. 내 영혼의 자매는 끊임없이 날 놀래킨다오. 두 사람의 행복을, 말로 다 표현할 수 없을 만큼 기도하겠소.",shape=box,color=blue];
		j833956337 -> j3672668390;
	j231007528 [label="흠? 그런 뜻이 아니오. 그렇게까지 강경하게 나서서 마리의 수호자 행세를 할 리가 없잖소. 그대가 도리에서 벗어난 행동을 하면, 마리가 직접 나서서 뼈를 부러뜨려 버릴텐데.",shape=box,color=blue];
		j231007528 -> j2560131514;
	j3561623673 [label="엔트라티는 로스에게 스스로도 알지도 못하는 미래를 구해야 한다고 말했소. 그자에게 있어선 지위도, 발 앞에 무릎을 꿇을 민중도, 숭배할 종복도 없는 미래 말이오.",shape=box,color=blue];
		j3561623673 -> j4012262788;
