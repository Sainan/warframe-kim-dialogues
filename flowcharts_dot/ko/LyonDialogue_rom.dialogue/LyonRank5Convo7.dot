	2040 [label="오, 리온... 당신은 나한테 짐 같은 존재가 아니야.",shape=box,color=red];
		2040 -> 2042;
	2041 [label="그러니까... 나하고의 관계를 끝내고 싶다는 뜻이야?",shape=box,color=red];
		2041 -> 2043;
	2042 [label="단지 그대가 나 때문에 느낄지도 모르는 어떤 어려움으로부터라도 그대를 해방시켜 주기 위해 노력하는 것뿐이오...",shape=box,color=blue];
		2042 -> 2044;
		2042 -> 2045;
		2042 -> 2046;
	2043 [label="아니오! 전혀 아니오! 단지 그대가 나 때문에 느낄지도 모르는 어떤 어려움으로부터라도 그대를 해방시켜 주기 위해 노력하는 것뿐이오.",shape=box,color=blue];
		2043 -> 2044;
		2043 -> 2045;
		2043 -> 2046;
	2044 [label="당신이 가지고 있는 고통은...내가 가진 고통과 메아리쳐. 그 고통을 극복하도록 돕는 건 결코 어려운 일이 아닐 거야.",shape=box,color=red];
		2044 -> 2047;
	2045 [label="무엇이 날 당신에게 이끌리게 만드는 지 설명할 수가 없어. 하지만 당신은 결코 의무나 짐이 되지 않을 거야.",shape=box,color=red];
		2045 -> 2048;
	2046 [label="[헤어진다.] 이 모든 게 너무 힘들어졌어. 미안. 여기서 끝내는 게 나을 것 같아.",shape=box,color=red];
		2046 -> 2049;
	2047 [label="그대 때문에 내 맘이 얼마나 아플지 말로 다 표현할 수가 없구려. 하지만 우리 외로운 고통의 유령들이 서로를 찾았다는 사실에 영원히 감사할 따름이오.",shape=box,color=blue];
		2047 -> 2050;
	2048 [label="이 감사의 마음을 제대로 표현할 수 있는 방법이 없고, 어떤 말로도 표현할 수 없을 것 같소.",shape=box,color=blue];
		2048 -> 2050;
	2049 [label="알았소. 그렇겠지. 지금 시점에서... 다른 답변을 받아들이는 건... 위선일 거요... ",shape=box,color=blue];
		2049 -> 2051;
	2050 [label="하지만 이미 극단적인 자기만족을 위해서라고밖에 표현할 수 없는 이 서문을 쓰기 위해 많은 노력을 기울였으니...",shape=box,color=blue];
		2050 -> 2052;
		2050 -> 2053;
		2050 -> 2054;
	2051 [label="완전히 이해하오. 그리고 그대에게 최고의 일들만 있기를 바라겠소. 우리가 함께 보낸 모든 순간들을 소중히 간직할 거요.",shape=box,color=blue];
		2051 -> 2055;
	2052 [label="처음엔 아무 말도 하지 않던 사람이, 정말 말이 많아졌네.",shape=box,color=red];
		2052 -> 2056;
