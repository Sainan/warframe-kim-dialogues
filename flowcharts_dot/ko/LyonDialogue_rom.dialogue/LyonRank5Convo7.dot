		j2617978386 -> j2938344851;
	j4176294050 [label="우리 사이에 있었던 일에 대해서 원망을 품고 있진 않소. 다만 함께 보낸 시간에 대해서만 감사한 마음을 표현할 수 있을 뿐.",shape=box,color=blue];
		j4176294050 -> j557551485;
	j3672668390 [label="그대에 대해서 이야기할 때 마리의 눈에 기쁨이 가득하오. 그대가 방문할지도 모른다는 생각이 들 때마다 즐거움으로 들뜨지.",shape=box,color=blue];
