	2073 [label="그리고 그 환상들이... 달아나 버렸소. 그들은 자리를 버리고, 더 강한... 그대라는 유령에게 쫓겨났소.",shape=box,color=blue];
		2073 -> 2074;
	2074 [label="난... 일어섰소. 향로를 침대 옆 탁자 위에 올려두고... 성역의 모래사장을 걷기로 결정했다오...",shape=box,color=blue];
		2074 -> 2075;
		2074 -> 2076;
	2075 [label="이제야 당신이 왜 서문이 필요했는지 알 것 같네.",shape=box,color=red];
		2075 -> 2077;
	2076 [label="뭐라 말해야 할지 모르겠어...",shape=box,color=red];
		2076 -> 2078;
	2077 [label="뭐, 그런 셈이오. 걷는 도중... 그러한 순간의 어두운 위험에 대해 바로 깨달았소. 그대가... 그걸 책임감으로 생각하게 될지도 모른다는 생각 - 그대 스스로를 날 짓누르는 사슬로 여기게 될지도 모른다는 생각 말이오.",shape=box,color=blue];
