		j1494212890 -> j441362188 [label="false",color=purple];
	j3974525607 [label="하지만 그대를 위해서라도, 이 열정이 빨리 지나가고 중독으로 이어지지 않기를 바라오. 그런 것들이 다른 이들을 파괴하는 걸 봐왔으니까.",shape=box,color=blue];
		j3974525607 -> j111544931;
	j1412632412 [label="나도 직접 봤소. 비록 깊이 묻혀 있을지라도, 그대가 비집어 여는 시도를 달가워하지 않을지도 모르오. 그자는 스스로의 모습을 즐기고 있다고 생각하오.",shape=box,color=blue];
		j1412632412 -> j111544931;
	j1893185660 [label="그런 관계는 단순한 어둠... 이상의 것을 기반으로 해야 하오. 하지만 그 점에 대해서 설교하진 않겠소.",shape=box,color=blue];
		j1893185660 -> j111544931;
	j1151000804 [label="내 깨진 색유리 창문과 같은 성정을 곁에 두고 싶어한다는 게 믿기가 어렵소... 그대가 심각하게 아프지 않는 한 말이오.",shape=box,color=blue];
		j1151000804 -> j3648269795;
		j1151000804 -> j2042195848;
	j4098640939 [label="오래전부터 이 현실에서 평화롭게 지냈소. 더 이상 날 괴롭히지도 않았지. 나를 괴롭히는 환상들 - 그 목소리들 - 스스로 두려움이나 증오 없이 그것들과 함께 살아갈 방법을 찾았소.",shape=box,color=blue];
		j4098640939 -> j3626952012;
	j3105319533 [label="어떤 방법으로든 그를 위해 내가 거기 있을 수 있어서 행복해.",shape=box,color=red];
		j3105319533 -> j1009383246;
	j441362188 [label="로스에게 일어난 일은…. 너무 복잡해. 아무래도 오랫동안 이 문제를 정리해야 할 거야.",shape=box,color=red];
		j441362188 -> j1009383246;
	j3933014957 [label="정확해. 로스는 전쟁에서 이기기 위해서 그랬어 - 그리고 그건 때로는 몇 번의 전투에서 지는 걸 의미하기도 하니까.",shape=box,color=red];
		j3933014957 -> j1009383246;
	j3287149569 [label="로스도 시간이 지나면 스스로를 용서하게 될 거야. 하지만 바깥에 드러내는 모습은 절대로 변하지 않을 것 같아.",shape=box,color=red];
		j3287149569 -> j1009383246;
