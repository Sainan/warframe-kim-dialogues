		2035 -> 2037;
	2039 [label="그대가 했던 표현을 빌리자면, \"괜찮을 거요.\" 다시 한번 웃고 떠들 수 있는 이유를 찾을 것이오.",shape=box,color=blue];
		2039 -> 2040;
