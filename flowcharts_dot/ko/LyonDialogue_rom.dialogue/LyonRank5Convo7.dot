		j2145482114 -> j1471933318;
	j3924206576 [label="그 끌림을 이해하오. 직접 보지 못했다는 걸 부인하진 않겠소. 하지만 그대를 위해서라도 그 끌림에 휩쓸리지 않기를 바랄 뿐.",shape=box,color=blue];
		j3924206576 -> j1150248019;
