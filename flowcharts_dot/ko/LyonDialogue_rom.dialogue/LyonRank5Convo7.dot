		2059 -> 2063;
	2060 [label="하! 내 머릿속을 들여다보고 싶지 않았으면, 함부로 여기저기 찌르고 다니지 말았어야지. 그건 전적으로 그대 책임이오.",shape=box,color=blue];
		2060 -> 2064;
	2061 [label="나의 그런 점을 사랑스럽게 여겨주어 기쁘게 생각하고 있다오. 내가 말을 거의 안 하는 이유가 바로 그 점이오. 이 모든 이야기를 직접 듣는다면 어떨지 상상이나 가오? 마리였다면 벌써 몇 년도 전에 미친개를 처리하듯 때려눕혔겠지.",shape=box,color=blue];
		2061 -> 2064;
	2062 [label="그대도 본래 어느 정도 불경스러우면서도 비꼬는 태도를 가지고 있는데, 난 절대 따라잡을 수 없을 거요. 그 쪽은 그대에게 맡기겠소.",shape=box,color=blue];
