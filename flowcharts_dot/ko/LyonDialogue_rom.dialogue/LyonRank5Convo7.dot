	2066 [label="어젯밤 악몽에 시달리다 일어났소. 깨어나니 그림자가 날 에워싸더이다. 내 정신 상태에선 전혀 낯설거나 새로운 게 아니었으니. 그림자는 침대 위로 드리워져 걷히지 않았소.",shape=box,color=blue];
		2066 -> 2068;
	2067 [label="Chat ends.",color=orange];
	2068 [label="그들이 두렵지 않았소. 그들이 날 해칠 수 없다는 것을 알았으니까. 하지만 그렇다고 내 마음에서 사라지진 않겠지. 그들을 없앨 수 있는 사람은 오직 한 명뿐이오.",shape=box,color=blue];
		2068 -> 2069;
	2069 [label="침대에서 몸을 일으켜, 계속되는 악몽으로 흐릿해진 시야를 뚫고 비틀거리며 앞으로 나아가 간신히 옷을 입었소. 향로를 움켜쥐고 바닥 한가운데 무릎을 꿇고... 준비를 했지. ",shape=box,color=blue];
		2069 -> 2070;
	2070 [label="\"내 정신을 맑게 해주는\" 준비를 했지. 이 이상은 설명하지 않겠소.",shape=box,color=blue];
		2070 -> 2071;
	2071 [label="하지만 눈을 감는 순간, 내 정신은 딴 데로 쏠리더이다. 내 생각이... 그대에게로 흘러갔소, mon miracle...",shape=box,color=blue];
