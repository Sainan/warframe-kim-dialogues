		j2255982309 -> j231007528;
	j1229661096 [label="그자는 완강히 부인하겠지만, 난 그자가 본인을 겁쟁이라 생각하는 걸 알고 있소. 그자를 겁쟁이라 부르고 싶지도 않고.",shape=box,color=blue];
