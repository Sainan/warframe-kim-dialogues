		2053 -> 2057;
	2054 [label="그냥 \"우리가 각자의 길을 가게 되더라도, 난 괜찮을 거요.\" 라고 말할 수도 있었을 거야.",shape=box,color=red];
		2054 -> 2058;
	2055 [label="내 마음 속에서 기억들이 사라져도, 내 영혼으로 기억할 것이오. 안녕히.",shape=box,color=blue];
