		j2938344851 -> j2647627860;
	j2617978386 [label="고맙소. 시작하기에 앞서, 아무 문제가 없다는 점을 말씀드리고 싶소 - 하지만 그대에게 밝히고 싶은 끔찍한 결과가 여기에 있소. 만약 그대가 그런 일이 뒤따를 것이라고 고려하고 있다면 말이오.",shape=box,color=blue];
		j2617978386 -> j3059016438;
