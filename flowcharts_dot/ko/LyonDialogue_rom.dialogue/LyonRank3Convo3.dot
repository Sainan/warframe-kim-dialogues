		j3101722115 -> j379258538;
	j3187260393 [label="난 지금 우리가 직면한 도전들이 위험하다고 생각이 들어. 극도로 위험해. 그리고 그것들을 그리 대해야 하고.",shape=box,color=red];
		j3187260393 -> j3169742589;
	j1476546919 [label="유령은 우리에게 고통을 안겨줄 만큼 실재하니까. 하지만 총알을 써서 대할 순 없잖아. 적어도 내가 발견한 것 중에는 말이야.",shape=box,color=red];
