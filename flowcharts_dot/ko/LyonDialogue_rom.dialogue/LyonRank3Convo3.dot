	173 [label="+5 Chemistry",color=orange];
		173 -> 181;
	174 [label="그럴껄? 내가 접촉해왔던 보이드의 부분들은 이미 각인되어 있는 경향이 있었어. 우리가 이미 보이드에 어떤 형태를 부여했거나, 아니면 현실 사이의 경계를 너무 모호하게 만들었을 수도.",shape=box,color=red];
		174 -> 182;
		174 -> 183;
	175 [label="혁명은 그걸 행사하는 이들의 정신 속에 존재하기에 타당성을 갖게 되오.",shape=box,color=blue];
		175 -> 184;
	176 [label="그렇소. 그리 표현할 수도 있겠군. 성당 복도에 출몰하는 유령들을 무시해야 하오, 아니면 그들에게 조금이라도 주의를 기울이는 행동 자체가 그들을 더 강하게 만드는 거요?",shape=box,color=blue];
		176 -> 177;
		176 -> 178;
		176 -> 179;
		176 -> 180;
	177 [label="난 지금 우리가 직면한 도전들이 위험하다고 생각이 들어. 극도로 위험해. 그리고 그것들을 그리 대해야 하고.",shape=box,color=red];
		177 -> 185;
	178 [label="유령은 우리에게 고통을 안겨줄 만큼 실재하니까. 하지만 총알을 써서 대할 순 없잖아. 적어도 내가 발견한 것 중에는 말이야.",shape=box,color=red];
		178 -> 186;
	179 [label="결국 뭐가 말하고 싶은 건데, 리온?",shape=box,color=red];
		179 -> 187;
	180 [label="솔직히... 나도 잘 모르겠어, 리온. 그리고 나도 알고 싶고.",shape=box,color=red];
		180 -> 188;
	181 [label="그렇소, 그리 표현할 수도 있겠군. 우리가 스스로의 악마를 드러내지 않았다고... 어떻게 확신할 수 있겠소이까?",shape=box,color=blue];
		181 -> 177;
		181 -> 178;
		181 -> 179;
		181 -> 180;
	182 [label="전체 구조, 사실 루아 자체도 보이드 속에 숨겨졌다가 되돌려진거야. 그래서 루아는 단순히 그 내부 안에 존재했다고 해서 물질을 소모하지 않아.",shape=box,color=red];
		182 -> 189;
	183 [label="당신이 암시하는 건 아무것도 존재할 수 없는 \"더 깊은\" 보이드의 존재인데, 솔직히 그 점에 대해선 말해줄 수 없어.",shape=box,color=red];
		183 -> 190;
	184 [label="만약 주변 이들의 생각에서 이 정보가 지워진다면, 더 이상 존재하지 않게 되는 것이오?",shape=box,color=blue];
		184 -> 165;
		184 -> 164;
