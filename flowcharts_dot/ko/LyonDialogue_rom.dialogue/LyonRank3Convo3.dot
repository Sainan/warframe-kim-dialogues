		j4132033382 -> j222814286;
	j683019875 [label="그 사람을 변호하자면, 내 보이드 노출건은 그 사람이 책을 가이드로 사용하려고 의도한 것보다 훨씬 더 길었어.",shape=box,color=red];
		j683019875 -> j1563202692;
