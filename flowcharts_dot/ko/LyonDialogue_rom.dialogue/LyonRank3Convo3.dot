		j43975270 -> j3288751375;
	j3820563408 [label="그럴껄? 내가 접촉해왔던 보이드의 부분들은 이미 각인되어 있는 경향이 있었어. 우리가 이미 보이드에 어떤 형태를 부여했거나, 아니면 현실 사이의 경계를 너무 모호하게 만들었을 수도.",shape=box,color=red];
