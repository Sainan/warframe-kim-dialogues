	140 [label="+5 Chemistry",color=orange];
		140 -> 146;
	136 [label="왜 다른 이들의 머릿속을 그런 쓸모없는 거짓말들로 채워 넣는 건지 종종 궁금해진다오. 권력이 목적일까? 영향력일까? 아니면 자기 말을 진심으로 믿고, 자신이 내뱉는 진실이 아닌 것들에 무지한 것일까?",shape=box,color=blue];
		136 -> 142;
		136 -> 141;
	137 [label="아니, 보이드가 만들어낸 모든 것은 그저... 일시적인 거라고 생각해. 그것을 만든 존재나 무언가의 파편일 뿐이야. 기억의 유령일 뿐이지.",shape=box,color=red];
		137 -> 143;
	138 [label="그런 것 같아. 응. 마치 예술가가 그린 그림처럼, 누군가의 머릿속에서 나왔을지 몰라도, 그려지고 나면 진짜가 되는 것처럼.",shape=box,color=red];
		138 -> 144;
	139 [label="그건 전적으로 당신이 가지고 있는 \"진짜\"에 대한 정의에 달렸어.",shape=box,color=red];
		139 -> 145;
	146 [label="그렇군, 양해해 주시오. 난 단지... 직접적으로 대화하는 데 능숙하지 않아서 말이오. 특히 이렇게 이상한 방식으로는 더욱. 하지만 지금부터 노력해 보겠소이다.",shape=box,color=blue];
		146 -> 122;
	142 [label="이 경우, 오일러리아 엔트라티는 스스로가 쓴 글이 유용하다고 생각했던 것 같아. 내가 필요할 땐 전혀 도움이 되지 않았던 것뿐.",shape=box,color=red];
		142 -> 148;
	141 [label="잘 모르겠네. 당신 머릿속은 어떤 거짓말들로 가득 찼는데, 리온?",shape=box,color=red];
		141 -> 147;
	143 [label="그렇다면 보이드의 그러한 속성에 의해 발생하는 효과는 \"실제\"가 아닌 거요?",shape=box,color=blue];
		143 -> 149;
	144 [label="그렇지만 그대가 사용한 비유는 정확하지 않은 것 같네만. 보이드에서 회수한 물질들은 보이드로 돌아가지, 안 그렇소?",shape=box,color=blue];
		144 -> 150;
	145 [label="+5 Chemistry",color=orange];
		145 -> 151;
	148 [label="그 사람을 변호하자면, 내 보이드 노출건은 그 사람이 책을 가이드로 사용하려고 의도한 것보다 훨씬 더 길었어.",shape=box,color=red];
		148 -> 153;
