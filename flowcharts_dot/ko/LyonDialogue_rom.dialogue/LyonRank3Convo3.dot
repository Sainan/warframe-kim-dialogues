	157 [label="불행한 무지는 우리 모두가 다른 이들에게 악영향을 미칠 수 있다고 바라는 최선의 답이겠지.",shape=box,color=blue];
		157 -> 163;
	158 [label="하지만 내 질문은, 그래서 무슨 차이가 있다는 거요? 최종 결과가 같다면, 그게 중요한 일인가?",shape=box,color=blue];
