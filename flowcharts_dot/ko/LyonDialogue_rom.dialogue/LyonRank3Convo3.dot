	125 [label="M. 로이드가 나에게 보낸 공포에 질린 표정과 \"그대가 화나지 않도록\" 당장 책을 내려놓으라고 고집부리신 점을 고려하면 그대야말로 그 책에 대해 뭔가 알고 있다고 추측할 수 있었지.",shape=box,color=blue];
		125 -> 128;
	124 [label="내 질문은 \"개념의 형상화\"의 본질과 관련이 있소. 책을 읽고 나니, 이 책은 아이들에게 스스로가 가진 감정을 보이드와 상호작용하지 않게 막게끔 그 방법을 가르치기 위해 만들어진 것을 알게 되었소.",shape=box,color=blue];
		124 -> 126;
		124 -> 127;
	128 [label="\"두비리 이야기\". M. 로이드로부터 그대가 겪은 일이 꽤나... 지치는 일이고 장기간 고통을 당했다는 설명을 들었지만, 특별히 여쭤보고 싶은 것이 하나 생겼소.",shape=box,color=blue];
		128 -> 131;
	126 [label="그게 얼마나 도움이 안 됐는지 몰라. 특히 내 경우엔 말이야.",shape=box,color=red];
		126 -> 129;
	127 [label="강한 감정과 보이드가 상호작용을 일으키면... 심각한 문제를 야기할 수 있어.",shape=box,color=red];
		127 -> 130;
	131 [label="혹시, 질문에 답하는 게 너무 어렵소?",shape=box,color=blue];
		131 -> 134;
		131 -> 135;
	129 [label="우리 삶 중 수많은 부분이 다른 이들에 의해 사실인 것처럼 처방되나, 실제로 시험해 보니 쓸모없다는 것만이 증명된건가?",shape=box,color=blue];
		129 -> 132;
	130 [label="그런 것 같군. 카비아를 만났고, 보이드 천사들에 대한 이야기도 들었고, 직접 속삭임도 마주했소. ",shape=box,color=blue];
		130 -> 133;
	134 [label="아니. 질문해 봐.",shape=box,color=red];
