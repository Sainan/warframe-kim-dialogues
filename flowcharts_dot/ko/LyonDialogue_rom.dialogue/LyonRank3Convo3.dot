	135 [label="전적으로 구체적인 사항에 따라 다르지. 무슨 질문을 하려는 건지 전혀 모르겠네.",shape=box,color=red];
		135 -> 140;
	132 [label="Update boolean LyonFaith1",color=orange];
		132 -> 136;
	133 [label="내가 가진 호기심은 바로 그런 것이오. 혹여나 그대가 이 질문에 대해 자세히 설명해 줄 수 있을지 궁금해서 \"소리 내어\" 생각해 보았지. 보이드가 형태를 갖추었을 때, 그 안에서 무엇이 흘러 나올까- 그건 \"실존\"하는 것일까?",shape=box,color=blue];
		133 -> 137;
		133 -> 138;
