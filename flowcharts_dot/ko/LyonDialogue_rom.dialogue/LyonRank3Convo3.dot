	j767842174 [label="전적으로 구체적인 사항에 따라 다르지. 무슨 질문을 하려는 건지 전혀 모르겠네.",shape=box,color=red];
		j767842174 -> j2302391837;
	j1156279048 [label="Boolean LyonFaith1 is now true.",color=orange];
		j1156279048 -> j2102015559;
	j2654602696 [label="내가 가진 호기심은 바로 그런 것이오. 혹여나 그대가 이 질문에 대해 자세히 설명해 줄 수 있을지 궁금해서 \"소리 내어\" 생각해 보았지. 보이드가 형태를 갖추었을 때, 그 안에서 무엇이 흘러 나올까- 그건 \"실존\"하는 것일까?",shape=box,color=blue];
		j2654602696 -> j2930322673;
		j2654602696 -> j4040904839;
		j2654602696 -> j972675272;
	j2302391837 [label="+5 Chemistry",color=orange];
		j2302391837 -> j1792655736;
	j2102015559 [label="왜 다른 이들의 머릿속을 그런 쓸모없는 거짓말들로 채워 넣는 건지 종종 궁금해진다오. 권력이 목적일까? 영향력일까? 아니면 자기 말을 진심으로 믿고, 자신이 내뱉는 진실이 아닌 것들에 무지한 것일까?",shape=box,color=blue];
		j2102015559 -> j3121314352;
		j2102015559 -> j2569410690;
	j2930322673 [label="아니, 보이드가 만들어낸 모든 것은 그저... 일시적인 거라고 생각해. 그것을 만든 존재나 무언가의 파편일 뿐이야. 기억의 유령일 뿐이지.",shape=box,color=red];
		j2930322673 -> j2844135268;
	j4040904839 [label="그런 것 같아. 응. 마치 예술가가 그린 그림처럼, 누군가의 머릿속에서 나왔을지 몰라도, 그려지고 나면 진짜가 되는 것처럼.",shape=box,color=red];
		j4040904839 -> j2951948649;
	j972675272 [label="그건 전적으로 당신이 가지고 있는 \"진짜\"에 대한 정의에 달렸어.",shape=box,color=red];
		j972675272 -> j4132033382;
	j1792655736 [label="그렇군, 양해해 주시오. 난 단지... 직접적으로 대화하는 데 능숙하지 않아서 말이오. 특히 이렇게 이상한 방식으로는 더욱. 하지만 지금부터 노력해 보겠소이다.",shape=box,color=blue];
		j1792655736 -> j162996973;
	j3121314352 [label="이 경우, 오일러리아 엔트라티는 스스로가 쓴 글이 유용하다고 생각했던 것 같아. 내가 필요할 땐 전혀 도움이 되지 않았던 것뿐.",shape=box,color=red];
		j3121314352 -> j683019875;
	j2569410690 [label="잘 모르겠네. 당신 머릿속은 어떤 거짓말들로 가득 찼는데, 리온?",shape=box,color=red];
		j2569410690 -> j3324066200;
	j2844135268 [label="그렇다면 보이드의 그러한 속성에 의해 발생하는 효과는 \"실제\"가 아닌 거요?",shape=box,color=blue];
		j2844135268 -> j3178673710;
	j2951948649 [label="그렇지만 그대가 사용한 비유는 정확하지 않은 것 같네만. 보이드에서 회수한 물질들은 보이드로 돌아가지, 안 그렇소?",shape=box,color=blue];
