	j13219978 [label="M. 로이드의 서재 책꽂이의 책 정리하는 일을 돕고 있었는데, 그 기괴하고 날아다니는... 장치가 그 일을 대신 해낼 수 있다고 말씀하시더군 -",shape=box,color=blue];
