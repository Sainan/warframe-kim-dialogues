	171 [label="+5 Chemistry",color=orange];
		171 -> 176;
	172 [label="우리가 광휘의 성체들에 대해 논하는 게 아니지 않소이까. 보이드에 대해서 논하는 중이었소.",shape=box,color=blue];
		172 -> 177;
		172 -> 178;
