	154 [label="그렇지만 내가 말하고 싶은 건, 그 사람이 스스로에게 작용한 건 내적인 힘이었다는 거야. 외적인 힘이 아니라.",shape=box,color=red];
		154 -> 158;
	155 [label="하지만 이는 잊혀지면 더 이상 존재하지 않게 되지 않습니까. 시간 속에서 사라진 이야기는 영원히 사라지는 것입니다.",shape=box,color=blue];
		155 -> 159;
