		j1604152333 -> j3103931881;
	j3101722115 [label="그렇소. 그리 표현할 수도 있겠군. 성당 복도에 출몰하는 유령들을 무시해야 하오, 아니면 그들에게 조금이라도 주의를 기울이는 행동 자체가 그들을 더 강하게 만드는 거요?",shape=box,color=blue];
