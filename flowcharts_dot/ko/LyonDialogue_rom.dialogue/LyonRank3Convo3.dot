		j3324066200 -> "Chat ends.";
	j3178673710 [label="수많은 기억들은 어떤 이를 술에 취하게 만들거나 목숨을 끊게끔 유도하지. 그 기억들은 \"진짜\"가 아니오?",shape=box,color=blue];
		j3178673710 -> j3904917341;
	j2647417992 [label="좋아, 그럼 생각해보자. 시나 노래는 글로 기록되지 않더라도 존재하잖아.",shape=box,color=red];
		j2647417992 -> j2976973486;
