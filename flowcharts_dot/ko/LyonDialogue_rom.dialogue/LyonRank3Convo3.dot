		185 -> 191;
	186 [label="Update boolean LyonFake1",color=orange];
		186 -> 192;
	187 [label="Update boolean LyonFaith1",color=orange];
		187 -> 193;
	188 [label="모르는 점을 솔직하게 인정하는 그대의 모습이 참 신선하군. 더 많은 인류가 그런 재능을 가졌으면 좋을텐데.",shape=box,color=blue];
		188 -> 194;
	189 [label="보이드에 들어갔다가 복구된 물질에는 흥미 없소. 그저 보이드에서 온전히 창조된 것에 관심이 있을 뿐.",shape=box,color=blue];
		189 -> 164;
		189 -> 165;
		189 -> 166;
	190 [label="솔직한 답변 감사드리오. 아마도 나는 존재할 수 없는 것과 지금 존재하는 것에는 덜 관심이 가나 보오.",shape=box,color=blue];
		190 -> 164;
		190 -> 165;
		190 -> 166;
	191 [label="그렇소. 보이드에서 넘어온 것을 무력으로서 무너뜨릴 수 있는게 있고, 없는게 있는지를 그대도 잘 알고 있겠지만...",shape=box,color=blue];
		191 -> 195;
	192 [label="아마도 그래서 많은 이들이 보이진 않지만 쓰라리면서 피 흘리는 상처를 막기 위해... 과잉으로 의지하는 거겠지. 치료는 가능하지만, 무기가 아닌 영혼의 힘으로서.",shape=box,color=blue];
		192 -> 195;
	193 [label="내가 완전히 잘못 생각한 게 분명하오. 다음에 다시 이야기하도록 하지. 바쁠텐데 방해해서 미안하오.",shape=box,color=blue];
		193 -> 196;
	194 [label="그럼에도 불구하고, 이 문제에 대한 내 생각은 완전히 정해지지 않은 것 같소.",shape=box,color=blue];
		194 -> 193;
	195 [label="하지만 언제나처럼 의심에 사로잡히곤 하오. 바쁠텐데 방해해서 미안하고 시간 내주어 고맙소, 드리프터.",shape=box,color=blue];
		195 -> 196;
	196 [label="-리온 알라드 신부",shape=box,color=blue];
