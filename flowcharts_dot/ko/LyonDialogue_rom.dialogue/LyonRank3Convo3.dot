		160 -> 167;
	161 [label="사건에 미친 영향으로? 보이드에서 비롯된 일들로 역사의 흐름이 바뀌었어.",shape=box,color=red];
		161 -> 168;
	162 [label="다른 이들에게 미치는 영향으로? 보이드에서 나온 \"것\"의 영향으로 확실히 그런 결과를 낳았지.",shape=box,color=red];
		162 -> 169;
	163 [label="허나, 내 호기심은 책 자체나 그 유용성에 있는 것이 아니오. 잠깐 시적인 표현을 사용한 점에 대해선 실례했소이다.",shape=box,color=blue];
		163 -> 170;
	164 [label="그것들이 \"실존\"하는 지에 묻는 게 아니라, 그것들이 \"타당\"한 지를 질문하는 거였네. 그것들을 없애버려도 될지 말지 말이야.",shape=box,color=red];
		164 -> 171;
	165 [label="나도 솔이나 루아와 악수할 수 없다는 이유만으로 광휘의 성체들이 \"실제\"하는지 아닌지 묻고 싶을 정도야.",shape=box,color=red];
		165 -> 172;
	166 [label="우회적으로, 보이드 속의 모든 \"것\"들이 우리의 의지로 존재하게 만들어서 존재하는 지에 묻고 있네.",shape=box,color=red];
		166 -> 173;
	167 [label="보이드로부터 나온 것은 반드시 보이드로 돌아간다, 이 말인가? 하지만 보이드는 본래 공허함으로 이루어져 있지 않나?",shape=box,color=blue];
		167 -> 174;
	168 [label="타당한 지적이오. 그렇다면 혁명은 바구니에 담아 무게를 잴 수 없기에 \"실제\"가 아니라는 뜻이오?",shape=box,color=blue];
		168 -> 169;
	169 [label="분명 많은 영혼들의 목숨을 앗아갔소. 그들은 그 타당성에 대해 강력히 반발하겠지만, 이 점을 고려해 주시오:",shape=box,color=blue];
		169 -> 175;
	170 [label="혹여나 그대가 이 질문에 대해 자세히 설명해 줄 수 있을지 궁금해서 \"소리 내어\" 생각해 보았소. 보이드가 형태를 갖추었을 때, 그 안에서 무엇이 흘러 나올까- 그건 \"실존\"하는 것일까?",shape=box,color=blue];
		170 -> 137;
		170 -> 139;
