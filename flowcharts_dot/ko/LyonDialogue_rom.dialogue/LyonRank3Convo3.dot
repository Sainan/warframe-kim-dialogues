digraph {
	114 [label="LyonRank3Convo3 begins.",color=orange];
		114 -> 115;
	115 [label="M. 로이드의 서재 책꽂이의 책 정리하는 일을 돕고 있었는데, 그 기괴하고 날아다니는... 장치가 그 일을 대신 해낼 수 있다고 말씀하시더군 -",shape=box,color=blue];
		115 -> 116;
	116 [label="그리고 오일러리아 엔트라티가 쓴 허구의 세계를 배경으로 한 흥미롭고도 자세한 어린이 동화책을 발견하였소.",shape=box,color=blue];
		116 -> 117;
	117 [label="저자의 성이 \"Cardinal Dimanche\"의 본명과 같다는 점을 알아차리고는, 바로 나 자신을 위해 그 사본을 따로 보관해 두었지.",shape=box,color=blue];
		117 -> 120;
