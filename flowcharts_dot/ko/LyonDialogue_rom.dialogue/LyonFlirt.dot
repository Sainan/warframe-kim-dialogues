		303 -> 304;
	304 [label="그 스스럼 없는 행동에 감사를 표하네. 무엇을 시도하고 있는지는 알고 있으니, 그 점에 대해선 칭찬해 드리겠소. 그리고 그대의 제안을 다시 고려해볼 때가 온다면? 그 제안이 여전히 유효하기를 바라오.",shape=box,color=blue];
