	288 [label="당신에게 관심있어, 리온. 지극히 간단한 이유야.",shape=box,color=red];
		288 -> 293;
	289 [label="왜 그랬는지 모르겠어, 리온. 분명히 말하자면 이 모든 게 실수였어. 정말 미안해.",shape=box,color=red];
		289 -> 294;
	290 [label="난... 진심으로 한 거였어. 하지만 이 모든게 너무 빠르게 진행된 것 같으니까, 사과할게.",shape=box,color=red];
		290 -> 294;
	287 [label="Chat ends.",color=orange];
	291 [label="단지 나 혼자 즐거울려고 당신한테 추파 던진게 아니야, 리온. 그게 목적이라고 생각이 들었다면 미안해.",shape=box,color=red];
		291 -> 294;
	292 [label="기분 나쁘게 할 의도는 없었고 그냥 놀린 거였어. 미안해.",shape=box,color=red];
