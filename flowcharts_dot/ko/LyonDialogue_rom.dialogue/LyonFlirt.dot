	"LyonFlirt begins." [color=orange];
		"LyonFlirt begins." -> j648840281;
		"LyonFlirt begins." -> j2327001303;
		"LyonFlirt begins." -> j2155286024;
	j648840281 [label="리온? 우리 얘기 좀 할까? ",shape=box,color=red];
		j648840281 -> j2143478971;
	j2327001303 [label="리온? 내 말이 불편했다면 정말, 진심으로 미안해. 그럴 의도가 아니었어.",shape=box,color=red];
		j2327001303 -> j3262529493;
	j2155286024 [label="[종료.]",shape=box,color=red];
		j2155286024 -> j2883342425;
	j2143478971 [label="뭐에 대해서 이야기를 나누고 싶은 거요, 드리프터?",shape=box,color=blue];
		j2143478971 -> j4207866462;
	j3262529493 [label="그렇다고 한다면, 단지 날 불편하게 만들어서 그대 혼자 즐거울려고 농담을 한게 아니라 하면... 처음부터 왜 그런 추파가 담긴 농담을 던지는 거요?",shape=box,color=blue];
		j3262529493 -> j1270924277;
		j3262529493 -> j832012452;
		j3262529493 -> j3279137220;
	j2883342425 [label="Boolean LyonFlirtIgnored is now true.",color=orange];
		j2883342425 -> "Chat ends.";
	j4207866462 [label="그대만의 즐거움을 위한 추파를 담은 이야기요? 아니면 다른 주제로 넘어가겠소?",shape=box,color=blue];
		j4207866462 -> j1480415759;
		j4207866462 -> j279487591;
		j4207866462 -> j3279137220;
	j1270924277 [label="당신에게 관심있어, 리온. 지극히 간단한 이유야.",shape=box,color=red];
		j1270924277 -> j214141333;
	j832012452 [label="왜 그랬는지 모르겠어, 리온. 분명히 말하자면 이 모든 게 실수였어. 정말 미안해.",shape=box,color=red];
		j832012452 -> j2291937483;
	j3279137220 [label="난... 진심으로 한 거였어. 하지만 이 모든게 너무 빠르게 진행된 것 같으니까, 사과할게.",shape=box,color=red];
		j3279137220 -> j2291937483;
	"Chat ends." [color=orange];
	j1480415759 [label="단지 나 혼자 즐거울려고 당신한테 추파 던진게 아니야, 리온. 그게 목적이라고 생각이 들었다면 미안해.",shape=box,color=red];
		j1480415759 -> j2291937483;
	j279487591 [label="기분 나쁘게 할 의도는 없었고 그냥 놀린 거였어. 미안해.",shape=box,color=red];
		j279487591 -> j512683352;
	j214141333 [label="그건 상호적이지 않소, 지극히 간단한 이유지.",shape=box,color=blue];
		j214141333 -> "Chat ends.";
	j2291937483 [label="난... 그대를 용서하겠소, 드리프터.",shape=box,color=blue];
		j2291937483 -> j2165804071;
	j512683352 [label="알겠소.",shape=box,color=blue];
		j512683352 -> "Chat ends.";
	j2165804071 [label="그리고 최근 내 심경을 압도했던 모든 것들을 표현하는 나의 솔직함을 양해해 주길 바라오:",shape=box,color=blue];
		j2165804071 -> j2949820803;
	j2949820803 [label="난 지금 환상적인 광기와 끝없이 난무하는 학살의 세계 속에서 낯선 존재들과 말하는 동물들에게 둘러싸여 있소.",shape=box,color=blue];
		j2949820803 -> j1108121485;
	j1108121485 [label="내가 알고 있는 모든 것은 \"옥색의 빛\"과 \"오로킨 제국\"과 \"보이드\"의 빛나는 광선에 휩쓸려 사라졌고 \"속삭임\"에 의해 위협받고 있소.",shape=box,color=blue];
		j1108121485 -> j3881638154;
	j3881638154 [label="그러니, 그대가 제의한 이... 매혹의 제안이 naïveté해서 이상할정도로 웃기게 여겨지더라도 양해 부탁드리오. 난 그대를 잘 알지도 못할 뿐더러 신뢰도 하지 않소. 게다가, 난 다른 존재의 말을 받아들일 수 밖에 없는 처지기에.",shape=box,color=blue];
		j3881638154 -> j3217429301;
	j3217429301 [label="아직 나조차도 잘 알지 못하고 신뢰하지도 않는 다른 이들의 말들.",shape=box,color=blue];
		j3217429301 -> j1585753138;
	j1585753138 [label="이 모든 것이 마리와 내 앞에 쌓인 외적인 힘일 뿐 - 그대가 볼 수 없는 나머지 모든 것들은 언급할 필요도 없겠지.",shape=box,color=blue];
		j1585753138 -> j640939443;
	j640939443 [label="그 스스럼 없는 행동에 감사를 표하네. 무엇을 시도하고 있는지는 알고 있으니, 그 점에 대해선 칭찬해 드리겠소. 그리고 그대의 제안을 다시 고려해볼 때가 온다면? 그 제안이 여전히 유효하기를 바라오.",shape=box,color=blue];
		j640939443 -> j3866441613;
		j640939443 -> j3513804494;
		j640939443 -> j467484536;
	j3866441613 [label="장담은 못하겠어, 신부님.",shape=box,color=red];
		j3866441613 -> j3242136659;
	j3513804494 [label="내 친한 친구의 말을 빌리자면, \"난 고집쟁이야, 친구.\"",shape=box,color=red];
		j3513804494 -> j4136330162;
	j467484536 [label="그럴 거야.",shape=box,color=red];
		j467484536 -> j2153695610;
	j3242136659 [label="그렇겠지. 그 어느 누구도 예상 못했을 거요.",shape=box,color=blue];
		j3242136659 -> j3503542734;
