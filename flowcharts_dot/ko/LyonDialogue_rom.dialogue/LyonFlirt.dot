		300 -> 301;
	301 [label="그러니, 그대가 제의한 이... 매혹의 제안이 naïveté해서 이상할정도로 웃기게 여겨지더라도 양해 부탁드리오. 난 그대를 잘 알지도 못할 뿐더러 신뢰도 하지 않소. 게다가, 난 다른 존재의 말을 받아들일 수 밖에 없는 처지기에.",shape=box,color=blue];
		301 -> 302;
