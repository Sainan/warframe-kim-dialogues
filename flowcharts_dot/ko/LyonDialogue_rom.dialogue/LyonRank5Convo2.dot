		j680575522 -> j3007827210 [label="false",color=purple];
	j1187251612 [label="+20 Chemistry",color=orange];
		j1187251612 -> j3180805795;
	j2882349603 [label="친구여, 참을성 있게 기다려주어 고맙고 생각보다 더 친절히 대해주어서 고맙소. 그대가 내 이야기의 일부분 - 루아가 가장 어두웠던 밤에 대해서도 궁금해졌으리라 생각하오.",shape=box,color=blue];
		j2882349603 -> j1560470314;
	j2691528749 [label="친구여, 참을성 있게 기다려주어 고맙소. 그대가 내 이야기의 일부분 - 루아가 가장 어두웠던 밤에 대해서도 궁금해졌으리라 생각하오.",shape=box,color=blue];
		j2691528749 -> j1560470314;
	j3763354646 [label="친구여, 내 과거를 궁금해하지 않으셨소. 나도 그대가 내 이야기의 일부분 - 루아가 가장 어두웠던 밤에 대해서도 궁금해졌으리라 생각하오.",shape=box,color=blue];
		j3763354646 -> j1560470314;
	j3007827210 [label="친구여, 내 이야기를 듣고 궁금해졌을 것이고, 루아가 가장 어두웠던 밤에 대해서도 궁금해졌을 거요.",shape=box,color=blue];
		j3007827210 -> j1560470314;
	j3180805795 [label="[이전 트리거 경고가 설정되어 대화가 생략됩니다.]",shape=box,color=blue];
		j3180805795 -> j370687875;
	j1560470314 [label="이는 내가 결코 말하지 않겠다 맹세했던 사연이요. 내 일기를 읽었던 마리만이 알고 있지. 그리고 이제 이 이야기를 그대를 위해, 여기에 적어 두겠소.",shape=box,color=blue];
		j1560470314 -> j1955400053;
	j370687875 [label="Boolean LyonConfession1 is now true.",color=orange];
		j370687875 -> "Chat ends.";
	j1955400053 [label="한번 시작하면 멈출 수 없을 거요, 다시 시작할 수도 없을테니. 그러니 질문을 못하게 하더라도 양해해 주시오.",shape=box,color=blue];
		j1955400053 -> j4095565657;
		j1955400053 -> j4270361459;
		j1955400053 -> j2557178564;
