		j4270361459 -> j2586640820;
	j2557178564 [label="[경고: 자해 및 아동 학대에 대한 언급이 있습니다. 이 선택지를 클릭하면 종료됩니다. 리온과의 케미스트리에 어떠한 손실도 발생하지 않습니다.]",shape=box,color=red];
		j2557178564 -> j784838610;
	j2055937657 [label="[종료.]",shape=box,color=red];
		j2055937657 -> j3856020424;
	j179541736 [label="고마워.",shape=box,color=blue];
		j179541736 -> j141195667;
	j2586640820 [label="+5 Chemistry",color=orange];
		j2586640820 -> j179541736;
	j784838610 [label="Check boolean LyonSpeech",color=orange];
		j784838610 -> j3342655806 [label=true,color=green];
		j784838610 -> j3288145901 [label=false,color=brown];
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j141195667 [label="Evaluate expressions",color=orange];
		j141195667 -> j3652616094 [label="LyonBackstory3a",color=purple];
		j141195667 -> j3652616094 [label="LyonBackstory3b",color=purple];
		j141195667 -> j2525506967 [label="false",color=purple];
	j3342655806 [label="+20 Chemistry",color=orange];
		j3342655806 -> j370687875;
	j3288145901 [label="만약 그대가 이 선택을 겁쟁이의 선택이라 여길 생각이라면, 제발 간청드리건대 - 그러지 마시오. 이 고통은 그대가 감당해야 할 고통이 아니오. 내 고통이지. 그대는 이 순간을 견뎌내야 할 필요도 없소.",shape=box,color=blue];
		j3288145901 -> j2943731550;
	j3652616094 [label="우리는 내 가족에 대해, 내가 자란 농장에서 보낸 시간들에 대해. 날 괴롭히고 폭력으로 몰아넣었던 환상들에 대해 이야기할 거요.",shape=box,color=blue];
		j3652616094 -> j3016129359;
	j2525506967 [label="날 키워주신 분들에 대해 많이 말해드리지 않은 걸 아오. 그리고 거기엔 그럴 만한 이유가 있소.",shape=box,color=blue];
		j2525506967 -> j1640202045;
	j2943731550 [label="우리가 앉아서 사용하는 이 기계 장치는 베일에 싸인 비인격적인 느낌을 주지. 마치 누군가가 그 기계에 입력하는 그 어떤 말이든, 그 어떤 해악으로부터 우리를 어떻게든 보호해 주는 것처럼 말이오.",shape=box,color=blue];
		j2943731550 -> j2593819374;
	j3016129359 [label="다른 방에서 속삭이는 목소리, 나를 부르는 목소리에 대해 말한 적 있지 않소. 때로는 마치 내 이름을 부르는 것 같더이다 -",shape=box,color=blue];
		j3016129359 -> j443525994;
	j1640202045 [label="어머니는... 내 환상을 악마의 짓거리로 여기셨소. 그리고 신체에 가하는 폭력으로서 그 환상을 떨어뜨리려고 하셨지. 내가 더 이상 서 있을 수 없을 때까지.",shape=box,color=blue];
		j1640202045 -> j2343302470;
	j2593819374 [label="난 그 반대라고 주장하고 싶소. 즉, 우리가 일상적인 사회적 상호교류에서 입는 갑옷에서 벗어나면, 우리를 보호할 수 있는 것도 벗겨진다는 것.",shape=box,color=blue];
		j2593819374 -> j4117507617;
	j443525994 [label="어떤 때는 아무 의미도 없는 것처럼 들릴 때도 있고. 횡설수설하는 헛소리, 아니면 악마의 언어처럼 들리기도 했다오.",shape=box,color=blue];
		j443525994 -> j1120952325;
	j2343302470 [label="그리고 내 아버지는? 뭐. 어머니가 아무리 잔인하더라도, 아버지만큼은 아니셨으니까. 자세한 부분은 생략하겠소.",shape=box,color=blue];
		j2343302470 -> j1459781315;
	j4117507617 [label="그러므로, 이런 상황에서... 전투 준비가 안된 군인으로서 대처할 게 아니라 숲 속에 있는 사슴처럼 아무것도 모르는 상태에서 화살을 맞을 수 있다는 걸 나도 잘 알고 있소.",shape=box,color=blue];
		j4117507617 -> j1015400307;
	j1120952325 [label="처음엔, 말도 안 되는 소리들에 겁이 났소. 제발 말이라도 통하게 해 달라고 빌었지. 루아의 영혼께 내게 바라는 바를 그들에게 말해 달라고 기도도 했었소.",shape=box,color=blue];
		j1120952325 -> j500390746;
	j1459781315 [label="하지만 그들의 폭력은 내가 저지른 폭력에도 비견될 만하니. 내 환상은 종종 나를 상대하게 어렵게 만드니 - 특히 내가 자라게 되어 아버지보다도 키가 커지고 체격도 더 강해졌을 때 더욱 그렇소.",shape=box,color=blue];
		j1459781315 -> j2700393043;
	j1015400307 [label="그렇기에, 난 그대에게 다음과 같은 말을 남기고자 하오:",shape=box,color=blue];
		j1015400307 -> j3816453955;
	j500390746 [label="하지만 그 의도를 알아내기 시작했을 때 - 그토록 간절히 기도했던 것을 후회하게 되었소. 이제서야, 내게 요구한 것들이 무엇인지 알게 되었으니.",shape=box,color=blue];
		j500390746 -> j2483111894;
	j2700393043 [label="그리고 이러한 환상들은 종종 목소리의 형태를 띠기도 한다오. 때로는 마치 내 이름을 부르는 것도 같고 -",shape=box,color=blue];
		j2700393043 -> j443525994;
	j3816453955 [label="일어설 의지를 찾을 수 없을 때조차도, 다른 이를 일으켜 세울 수 있는 힘을 찾는 방법을 스스로에게 상기시켜야 하오.",shape=box,color=blue];
		j3816453955 -> j4234239122;
	j2483111894 [label="오, 그들은 이를 위해 매우 큰 대가를 치뤄야 했소.",shape=box,color=blue];
		j2483111894 -> j3753784645;
	j4234239122 [label="그게 바로 이야기의 진정한 목적이오.",shape=box,color=blue];
		j4234239122 -> j1290680747;
	j3753784645 [label="오해하지 마시오. 내 부모님에 대해서 어떠한 애정도 없으니. 그들에게 느꼈을지도 모르는 가족애는 이미 오래전 수많은 멍과 흉터 속에 묻혀 버렸기에.",shape=box,color=blue];
		j3753784645 -> j3649892223;
	j1290680747 [label="+20 Chemistry",color=orange];
		j1290680747 -> j3166770987;
	j3649892223 [label="하지만 그들이 내게 무엇을 해달라고 간청했을까...? 그리고 가장 어두운 밤에 내게 원하는 바를 행하라고 강요했을까...?",shape=box,color=blue];
		j3649892223 -> j2739666483;
	j3166770987 [label="잘 지내시오, 드리프터. 후에 마저 이야기 나누길.",shape=box,color=blue];
		j3166770987 -> j2809422911;
	j2739666483 [label="나는 소년이라 부르기엔 조금 앳된 나이였소 - 남자처럼 보이지도 않았지. 아마 열여섯? 열여덟쯤이었을까? 처음엔 이 모든게 또 하나의 끔찍한 악몽, 뒤틀린 꿈인 줄 알았소.",shape=box,color=blue];
		j2739666483 -> j3659677235;
	j2809422911 [label="-리온 알라드 신부",shape=box,color=blue];
		j2809422911 -> j370687875;
	j3659677235 [label="내 주변에는 앙상하고 뒤틀린 형체들이 서 있었지. 오로지 순수한 악의와 그림자로만 이루어진 형상들.",shape=box,color=blue];
		j3659677235 -> j3936791432;
	j3936791432 [label="그들은 나를 조롱하고, 무엇을 해야 하는지를 강요했소. 나를 사랑한다 주장하는 존재들이 내 육신을 거두고자 한다면, 나 또한 그러지 말아야 할 이유가 있느냐고...",shape=box,color=blue];
		j3936791432 -> j1214206579;
	j1214206579 [label="악몽에서 깨어났을 땐 - 아니, 어쩌면 항상 깨어 있던 건지도 모르지. 도무지 제대로 알 길이 없소 - 내 손엔 사냥용 칼이 들려 있었소. 그리고 부모님의 방문 앞에 서 있었지.",shape=box,color=blue];
		j1214206579 -> j899881357;
	j899881357 [label="달은 새로 떴고, 구름은 짙었소. 희미한 빛조차 보이지 않는, 칠흑 같은 어둠 뿐. ",shape=box,color=blue];
		j899881357 -> j2765611064;
	j2765611064 [label="루아께서 날 버리셨소.",shape=box,color=blue];
		j2765611064 -> j1186645478;
	j1186645478 [label="난 그 목소리들의 부름에 응답할 수 없었소. 그들에게 어머니와 아버지의 영혼을 내줄 수 없었으니까.",shape=box,color=blue];
		j1186645478 -> j2486676073;
	j2486676073 [label="텅 빈 밤 속으로 난 도망쳤소. 깊은 숲 속으로, 나뭇가지들이 내 맨살을 찢어지만, 고통에 조금도 개의치 않았소.",shape=box,color=blue];
		j2486676073 -> j3538238664;
	j3538238664 [label="다리가 무너져 더 이상 날 지탱할 수 없을 때까지 달리고 달렸소. 당시에 울고 있었던 것 같기도, 나도 잘 모르겠소.",shape=box,color=blue];
		j3538238664 -> j3909020931;
	j3909020931 [label="하지만, 그 징후는 이미 뒤따라왔으니. 환상이 여전히 피를 갈구하며 속삭였소.",shape=box,color=blue];
		j3909020931 -> j1435637431;
	j1435637431 [label="내가 환상을 볼 수만 없다면, 그들이 사라지길 바라는 마음으로... 내 눈구멍에 칼을 꽂았을 때...",shape=box,color=blue];
		j1435637431 -> j4085108036;
	j4085108036 [label="스스로 정신을 잃고 과업을 완수하지 못한게 아쉬울 따름이오. 이제 와서는 절대 알 수 없겠지.",shape=box,color=blue];
		j4085108036 -> j935907694;
	j935907694 [label="깨어났을 때, 루아 교구에 있더이다. 한 형제께서 날 발견하고 상처를 붕대로 싸매 주셨소. 그리고 내가 무엇으로부터 도망치고 있었는지 물으셨소.",shape=box,color=blue];
		j935907694 -> j774330431;
	j774330431 [label="난 너무 흥분한 상태였기에, 형제께 거짓말을 할 수 없었소. 모든 것을 고했지 - 환상, 그들이 내게 저지르라고 한 일들도. 난 정죄받을 거라 예상했었소.",shape=box,color=blue];
		j774330431 -> j87368666;
	j87368666 [label="말을 마치자, 그는 그저 슬픔을 담은 미소를 지으며 내 손바닥에 루아 부적을 쥐어주셨소. \"루아는 축복을 내리지만 저주이기도 하오, 형제여.\"",shape=box,color=blue];
		j87368666 -> j1858469652;
	j1858469652 [label="그러고는 날 Cité de la Lumière에 있는 대성당으로 보냈소. 그리고 나는 엔트라티가 날 찾아올 때까지 그 곳에 머물러 있었지...",shape=box,color=blue];
		j1858469652 -> j763997745;
	j763997745 [label="이제... 그대는 알게 되었소.",shape=box,color=blue];
		j763997745 -> j2201932890;
	j2201932890 [label="그리고... 이제 난 가봐야겠소.",shape=box,color=blue];
		j2201932890 -> j624114251;
	j624114251 [label="Boolean LyonConfession1 is now true.",color=orange];
		j624114251 -> j1411527856;
	j1411527856 [label="+20 Chemistry",color=orange];
		j1411527856 -> j1696229132;
	j1696229132 [label="- 리온",shape=box,color=blue];
		j1696229132 -> "Chat ends.";
}