	j2396852650 [label="그러니, 그대가 제의한 이... 연대의 제안이 naïveté해서 이상할정도로 웃기게 여겨지더라도 양해 부탁드리오. 난 그대를 잘 알지도 못할 뿐더러 신뢰도 하지 않소. 게다가, 난 다른 존재의 말을 받아들일 수 밖에 없는 처지기에.",shape=box,color=blue];
		j2396852650 -> j321499463;
	j3315550243 [label="이제 그만 가시오, 드리프터. 내가 그대를 찾아서 강제로 쉬게 만들기 전에. 그리고 우리 중 그 누구도 그걸 즐기지 않을 거외다.",shape=box,color=blue];
