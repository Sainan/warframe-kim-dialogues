		j1160575423 -> j1507804850;
	j2392980791 [label="이건 개인적인 문제요, 드리프터. 나와 사교하려는 그대의 시도에 대해 감사드리오. 그리고 나라는 존재가.. 그대가 여지껏 상대해왔던 존재들 중 가장 상냥한 존재가 아니라는 점을 이해해 줘서 고마울 뿐이오.",shape=box,color=blue];
