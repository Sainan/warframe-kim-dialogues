		j1118061501 -> j2905931503;
	j597948297 [label="엔트라티가 아무런 예고도, 준비도, 어떠한 것도 없이 너를 프로토프레임으로 만들어서 여기에 데려다 놨어. 네가 적응하는 데 어떤 식으로든 도울 수 있다면, 기꺼이 도와줄게.",shape=box,color=red];
