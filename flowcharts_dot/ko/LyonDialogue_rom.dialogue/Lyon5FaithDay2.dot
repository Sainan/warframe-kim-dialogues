	j3752926445 [label="나 스스로는 이 세상에 신들 같은 건 존재하지 않는다고 믿지만, 그게 너의 삶에서 얼마나 중요한 존재였는지는 잘 알고 있어. 그 점을 깎아내리고 싶지도 않고.",shape=box,color=red];
