		j3626627435 -> j3325351314 [label="false",color=purple];
		j3626627435 -> j3039724897 [label="false",color=purple];
	j1580368952 [label="이전에 내가 무심은 \"진정한 신\"이란 걸 믿지 않는다는 점에 대해 이야기하고 싶어했잖아. 지금이 바로 그 적절한 시기일려나?",shape=box,color=red];
		j1580368952 -> j2900754249;
	j3039724897 [label="[종료.]",shape=box,color=red];
		j3039724897 -> "Chat ends.";
	j2320723616 [label="며칠 전, 개념의 형상화와 무심에 대해 질문했었잖아. 혹시 뭔가 신경 쓰이는 게 있어?",shape=box,color=red];
		j2320723616 -> j3646108851;
	j1562449558 [label="로스는 \"벽 속의 남자\"가 진짜 신이 아니라고 확신하고 있어. 그는 \"개념의 형상화\"의 산물이라고 말이야. 당신은 어떻게 생각해?",shape=box,color=red];
		j1562449558 -> j3688048959;
	j3325351314 [label="리온, 당신이랑 로스 사이에 무슨 일이 있는 거야? 단편적으로 밖에 몰라서 말이야.",shape=box,color=red];
		j3325351314 -> j442526625;
	j2900754249 [label="이 문제로 인해 발생한 실질적인 문제에 대해 논의하기에 \"좋은\" 시간이 언제가 될지 모르겠소, 드리프터.",shape=box,color=blue];
		j2900754249 -> j20732735;
	"Chat ends." [color=orange];
	j3646108851 [label="나를 괴롭히는 것들이 너무나 많소, 드리프터. 무심과 개념의 형상화라는 주제는 그중 하나에 불과할지도 모르지.",shape=box,color=blue];
		j3646108851 -> j1293245133;
	j3688048959 [label="문제는 말이오, 드리프터. 나도 잘 모른다는 거요. 만약 답을 알았다면, 이런 내면의 논쟁으로 스스로를 괴롭히지 않았을 거요.",shape=box,color=blue];
		j3688048959 -> j35210906;
	j442526625 [label="요약하자면, 그 주제에 대한 그자의 폭언을 피했다는 게 놀랍긴 하오. 그자는 기회가 있을 때마다 그런 폭언을 쏟아내려고 너무 열심인 것 같으니.",shape=box,color=blue];
		j442526625 -> j4278094690;
	j20732735 [label="허나 그런 의미에서 지금이야말로 그 어느 때보다 \"좋은\" 시기요. 그대가 무심이란 존재는 진정한 신이 아니라는 로스의 믿음에 동조하는 것 같아 흥미롭군.",shape=box,color=blue];
		j20732735 -> j35210906;
	j1293245133 [label="아니면 상황을 어찌 해석하느냐에 따라 두 가지가 될 수도 있지. 하지만 내 딜레마의 핵심은 바로 이것이요.",shape=box,color=blue];
		j1293245133 -> j35210906;
	j35210906 [label="어쨌든, 처음부터... 시작해야겠군. 맥락을 모르면 이 주제가 왜 내게 그리 중요한지 정확하게 이해하지 못할 거요...",shape=box,color=blue];
		j35210906 -> j3682252762;
	j4278094690 [label="그자는 무심이 어떤 의미에서든 보이드의 신이 아니며, 실제로는 엔트라티와 그 이후에 그것과 교류한 모든 이들이 만들어낸 존재라 믿고 있소 -",shape=box,color=blue];
		j4278094690 -> j3736016011;
	j3682252762 [label="난 루아의 형제요. 내 삶을 루아께 바쳤으니. 평생동안, 이걸 믿어 왔소.",shape=box,color=blue];
		j3682252762 -> j1900510030;
	j3736016011 [label="- \"개념의 형상화\"라고 알려진 것을 통해 보이드에서 창조된 것이라고. ",shape=box,color=blue];
		j3736016011 -> j402390703;
	j1900510030 [label="대성당에 도착한 이후, 난 내 신앙을 굳건히 지켜왔소 - 즉 내 고통, 아픔, 환상 -",shape=box,color=blue];
		j1900510030 -> j1390575130;
	j402390703 [label="그대가 두비리를 창조한 방식과 비슷한 방식이라 생각이 드오.",shape=box,color=blue];
		j402390703 -> j35210906;
	j1390575130 [label="- 루아를 위해 헌신해 왔소. 그녀의 이름으로, 그녀의 목적을 위해.",shape=box,color=blue];
		j1390575130 -> j3263569306;
	j3263569306 [label="그... \"Cardinal Dimanche\"가 스스로를 알브레히트 엔트라티라는 사실을 밝힐 때까지는.",shape=box,color=blue];
		j3263569306 -> j1701793658;
	j1701793658 [label="그리고 그는 스스로가 누구인지, 보이드와 관련된 그의 악행에 대한 이야기, 그리고 그로 인해 발생한 모든 일들을 우리에게 말해주었소... 더 구체적으로 말하면... 그로 인해 발생한 결과 모든 것들을 말이오.",shape=box,color=blue];
		j1701793658 -> j1360789944;
		j1701793658 -> j3542051568;
	j1360789944 [label="무심.",shape=box,color=red];
		j1360789944 -> j3621080235;
	j3542051568 [label="그리고?",shape=box,color=red];
		j3542051568 -> j49057302;
	j3621080235 [label="맞소. 그는 자신을 맞이한 비웃는 존재, 실험실과 비슷한 장소에서 찾아낸 손가락들에 대해 얘기해 주었소.",shape=box,color=blue];
		j3621080235 -> j2108550104;
	j49057302 [label="엔트라티는 세리글래스 종을 타고 보이드 속으로 내려갔던 이야기를 들려주었소. 마치 그의 실험실을 연상시키는 장소에 대해서. ",shape=box,color=blue];
		j49057302 -> j2108550104;
	j2108550104 [label="게다가, 그는 공간뿐만 아니라 시간을 초월하여 자신을 따라다닐 수 있는 무언가를 풀어놓았다는 사실을 깨닫고 느꼈던 엄청난 공포에 대해서도 이야기 했소.",shape=box,color=blue];
		j2108550104 -> j849154084;
	j849154084 [label="허무의 신. 억제되어야 할 존재. 그가 가진 조각난 육신의 본래 주인, 자유로이 풀려나고 싶어서 벽 뒤를 끊임없이 긁어대는 자.",shape=box,color=blue];
		j849154084 -> j3263602073;
	j3263602073 [label="이미 자유로워졌으나, 자유롭지 못한, 끔찍하고 소모적인 신.",shape=box,color=blue];
		j3263602073 -> j3055880734;
		j3263602073 -> j3392475287;
	j3055880734 [label="무슨 뜻이야?",shape=box,color=red];
		j3055880734 -> j3826452011;
	j3392475287 [label="\"이미 자유로워졌으나\" 와 \"자유롭지 못하다\" 라고?",shape=box,color=red];
		j3392475287 -> j3826452011;
	j3826452011 [label="Check boolean LyonRell1",color=orange];
		j3826452011 -> j2240252804 [label=true,color=green];
		j3826452011 -> j198176131 [label=false,color=brown];
	j2240252804 [label="시간은... 나 같은 존재에게 있어서 얽혀 있소. 지금 내가 처한 상황은 설명하기 어렵고, 설명하기도 힘드오. 한 번 제대로 설명하려고 했으나, 비참하게 실패했지.",shape=box,color=blue];
		j2240252804 -> j3675848976;
	j198176131 [label="시간은... 나 같은 존재에게 있어서 얽혀 있소. 지금 내가 처한 상황은 설명하기 어렵고, 설명하기도 힘드오.",shape=box,color=blue];
		j198176131 -> j3675848976;
	j3675848976 [label="오늘 말하고자 하는 요점은 그 내용이 아니므로 자세한 내용은 다음 기회에 설명하겠소.",shape=box,color=blue];
		j3675848976 -> j366078008;
	j366078008 [label="Check boolean LyonRell1",color=orange];
		j366078008 -> j3481125069 [label=true,color=green];
		j366078008 -> j2855869346 [label=true,color=green];
		j366078008 -> j1159513198 [label=true,color=green];
		j366078008 -> j2855869346 [label=false,color=brown];
		j366078008 -> j1159513198 [label=false,color=brown];
	j3481125069 [label="하지만 당신이 렐을 듣는다면 - 아니 들었다면 - 그 점에 관해서 얘기하고 싶어.",shape=box,color=red];
		j3481125069 -> j503891745;
	j2855869346 [label="좋아. 당신 말 따를게.",shape=box,color=red];
		j2855869346 -> j215524214;
	j1159513198 [label="하지만 그 부분에 대해서 이야기하고 싶은 걸...",shape=box,color=red];
		j1159513198 -> j834670201;
	j503891745 [label="알고 있소. 그리고 난 그 주제를 터무니없이 피해왔지. 그 존재의 이름만으로도",shape=box,color=blue];
		j503891745 -> j2671234238;
	j215524214 [label="이 주제를 너무 피하고 있다는 걸 스스로도 이미 잘 알고 있으며, 이에 사과드리오. 하지만 이 주제로 인해 내가 쉽게 회복할 수 있을지 확신할 수 없는 환상에 빠질 수도 있소.",shape=box,color=blue];
		j215524214 -> j1860198425;
	j834670201 [label="장담하건대, 그럴 거요. 이 주제를 너무 피하고 있다는 걸 자신도 이미 잘 알고 있으며, 이에 사과드리오. 하지만, 이 주제로 인해 내가 쉽게 회복할 수 있을지 확신할 수 없는 환상에 빠질 수도 있소.",shape=box,color=blue];
		j834670201 -> j1860198425;
	j2671234238 [label="위협적이라서",shape=box,color=blue];
		j2671234238 -> j2268551383;
	j1860198425 [label="내 육신의 병 문제로 인해 더 이상 대화를 짧게 끝내고 싶지도 않으니.",shape=box,color=blue];
		j1860198425 -> j3083354052;
		j1860198425 -> j1708590439;
		j1860198425 -> j1680634804;
	j2268551383 [label="사슬에 묶인 남자의 형상이 떠오르고",shape=box,color=blue];
		j2268551383 -> j457638900;
	j3083354052 [label="당신이 겪은 것과 동일한 문제를 겪는 다른 이에게 \"병\" 때문에 그렇다고 하지 않을 것 같아, 리온.",shape=box,color=red];
		j3083354052 -> j4146489879;
	j1708590439 [label="\"스스로가 바라지도 않은 환상에 저주받았다\"를 병 때문이라하는 건 끔찍한 표현 같지만. 당신 답다고 해야하나.",shape=box,color=red];
		j1708590439 -> j4146489879;
	j1680634804 [label="당신이 무얼 할 수 있는지 알고 있으니, 그저 당신 지시를 따를게.",shape=box,color=red];
		j1680634804 -> j1048515;
	j457638900 [label="피투성이인채",shape=box,color=blue];
		j457638900 -> j3518285947;
	j4146489879 [label="그 감상에 감사를 표하오. 하지만 난 좋은 날 산산 조각난 색유리 창문에 불과하다는 걸 알고 있소. 그저 여기 서서 그 많은 조각들이 어디로 사라졌는지 궁금할 뿐.",shape=box,color=blue];
		j4146489879 -> j516314119;
	j1048515 [label="고맙소. 그대의 인내심에 감탄해버렸으니. 하지만 난 좋은 날 산산 조각난 색유리 창문에 불과하다는 걸 알고 있소. 그저 여기 서서 그 많은 조각들이 어디로 사라졌는지 궁금할 뿐.",shape=box,color=blue];
		j1048515 -> j516314119;
	j3518285947 [label="힘줄과 육신의 잘라내어 만든",shape=box,color=blue];
		j3518285947 -> j3902329884;
	j516314119 [label="잃어버린 부분을 찾을 때마다 제자리에 다시 끼워 넣는 일이 도움이 되기보다는 상처를 입힐 가능성이 더 크기에.",shape=box,color=blue];
		j516314119 -> j696742885;
	j3902329884 [label="제발 멈춰줘",shape=box,color=blue];
		j3902329884 -> j4186037466;
	j696742885 [label="가끔 내 마음의 눈에 보이는, 악몽이 허락하는 한 멀리 뻗어 있는, 정말로 텅 빈 눈을 가진 해로우 중 하나가 되는 게 더 낫지 않을까 생각하곤 하오.",shape=box,color=blue];
		j696742885 -> j3090338735;
	j4186037466 [label="그들의 얼굴이\n셀 수 없이 많은데\n공허하고 부서져 있으며\n영원히 산산 조각난 기도 속에서\n나는 무엇이 될 것인가",shape=box,color=blue];
		j4186037466 -> j520610698;
		j4186037466 -> j814770577;
	j3090338735 [label="Evaluate expressions",color=orange];
		j3090338735 -> j900205083 [label="MarieDating",color=purple];
		j3090338735 -> j3800209214 [label="MarieDating",color=purple];
		j3090338735 -> j3800209214 [label="RoatheDating",color=purple];
		j3090338735 -> j900205083 [label="RoatheDating",color=purple];
		j3090338735 -> j3800209214 [label="false",color=purple];
		j3090338735 -> j900205083 [label="false",color=purple];
		j3090338735 -> j303688417 [label="false",color=purple];
	j520610698 [label="숨 쉬어, 리온. 숨 쉬어. 그들은 실제로 거기에 있지 않아.",shape=box,color=red];
		j520610698 -> j1241187484;
	j814770577 [label="미 - 미안해, 리온. 화면에 집중해줘. 난 여기 있으니까.",shape=box,color=red];
		j814770577 -> j1239830991;
	j900205083 [label="이게 당신에게 맡겨진 끔찍한 짐이라는 걸 알아. 그리고 어쩌면 이게 옳지 않은 일일지도 몰라. 하지만 난 벗어날 방법을 모르겠어.",shape=box,color=red];
		j900205083 -> j3801591241;
	j3800209214 [label="마리에게 있어서 당신은 세상 전부야. 그리고 내 소중한 친구가 되었어. 로스조차도 당신을 그리워할 것 같아. 당신은 인정 안 하겠지만 말이야.",shape=box,color=red];
		j3800209214 -> j171299608;
	j303688417 [label="[마음을 고백한다.] 그런 일이 당신에게 일어난다면 가슴이 찢어질 거야, 리온. 난...당신을 진심으로 아끼니까.",shape=box,color=red];
		j303688417 -> j3724306516;
	j1241187484 [label="틀렸어\n그들은 거기에 있어\n결코 날 떠나지 않을 거야\n다시는\n엔트라티가 봤어\n용서해주길",shape=box,color=blue];
		j1241187484 -> j2862131335;
	j1239830991 [label="내 육신을 찢고\n내 뼈에서 벗겨내지\n어째서? 무슨 목적으로?\n이게 누구의 허기를 채워주는 거지?",shape=box,color=blue];
		j1239830991 -> j770769946;
		j1239830991 -> j4166708951;
	j3801591241 [label="상상도 할 수 없는... 일을 하지 않고서는 안될 것 같아. 아니면 그런 일을 해야하거나.",shape=box,color=red];
		j3801591241 -> j2654768756;
	j171299608 [label="당신은 소중히 여겨지고 사랑받고 있어. 가족과 친구들이 있어. 항상 그런 기분이 아니더라도.",shape=box,color=red];
		j171299608 -> j1185147826;
	j3724306516 [label="난 - 분명, 농담하는 거겠지. 방금 목격한 일을 생각하면, 그대 말이 진심일 리가 없잖소? 제정신을 잃었거나, 아니면 동정심이 이성을 압도했거나 둘 중 하나일 거요.",shape=box,color=blue];
		j3724306516 -> j2140036461;
		j3724306516 -> j1962799380;
	j2862131335 [label="+10 Chemistry",color=orange];
		j2862131335 -> j4006363057;
