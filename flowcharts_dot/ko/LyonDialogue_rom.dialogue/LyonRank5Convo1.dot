		1347 -> 1350 [label=false,color=brown];
	1348 [label="하지만 당신이 렐을 듣는다면 - 아니 들었다면 - 그 점에 관해서 얘기하고 싶어.",shape=box,color=red];
		1348 -> 1351;
	1349 [label="좋아. 당신 말 따를게.",shape=box,color=red];
		1349 -> 1352;
	1350 [label="하지만 그 부분에 대해서 이야기하고 싶은 걸...",shape=box,color=red];
		1350 -> 1353;
	1351 [label="알고 있소. 그리고 난 그 주제를 터무니없이 피해왔지. 그 존재의 이름만으로도",shape=box,color=blue];
		1351 -> 1354;
	1352 [label="이 주제를 너무 피하고 있다는 걸 스스로도 이미 잘 알고 있으며, 이에 사과드리오. 하지만 이 주제로 인해 내가 쉽게 회복할 수 있을지 확신할 수 없는 환상에 빠질 수도 있소.",shape=box,color=blue];
		1352 -> 1355;
	1353 [label="장담하건대, 그럴 거요. 이 주제를 너무 피하고 있다는 걸 자신도 이미 잘 알고 있으며, 이에 사과드리오. 하지만, 이 주제로 인해 내가 쉽게 회복할 수 있을지 확신할 수 없는 환상에 빠질 수도 있소.",shape=box,color=blue];
		1353 -> 1355;
	1354 [label="위협적이라서",shape=box,color=blue];
		1354 -> 1356;
	1355 [label="내 육신의 병 문제로 인해 더 이상 대화를 짧게 끝내고 싶지도 않으니.",shape=box,color=blue];
		1355 -> 1357;
		1355 -> 1358;
		1355 -> 1359;
	1356 [label="사슬에 묶인 남자의 형상이 떠오르고",shape=box,color=blue];
		1356 -> 1360;
	1357 [label="당신이 겪은 것과 동일한 문제를 겪는 다른 이에게 \"병\" 때문에 그렇다고 하지 않을 것 같아, 리온.",shape=box,color=red];
		1357 -> 1361;
	1358 [label="\"스스로가 바라지도 않은 환상에 저주받았다\"를 병 때문이라하는 건 끔찍한 표현 같지만. 당신 답다고 해야하나.",shape=box,color=red];
		1358 -> 1361;
	1359 [label="당신이 무얼 할 수 있는지 알고 있으니, 그저 당신 지시를 따를게.",shape=box,color=red];
		1359 -> 1362;
	1360 [label="피투성이인채",shape=box,color=blue];
		1360 -> 1363;
	1361 [label="그 감상에 감사를 표하오. 하지만 난 좋은 날 산산 조각난 색유리 창문에 불과하다는 걸 알고 있소. 그저 여기 서서 그 많은 조각들이 어디로 사라졌는지 궁금할 뿐.",shape=box,color=blue];
		1361 -> 1364;
	1362 [label="고맙소. 그대의 인내심에 감탄해버렸으니. 하지만 난 좋은 날 산산 조각난 색유리 창문에 불과하다는 걸 알고 있소. 그저 여기 서서 그 많은 조각들이 어디로 사라졌는지 궁금할 뿐.",shape=box,color=blue];
		1362 -> 1364;
	1363 [label="힘줄과 육신의 잘라내어 만든",shape=box,color=blue];
		1363 -> 1365;
	1364 [label="잃어버린 부분을 찾을 때마다 제자리에 다시 끼워 넣는 일이 도움이 되기보다는 상처를 입힐 가능성이 더 크기에.",shape=box,color=blue];
		1364 -> 1366;
	1365 [label="제발 멈춰줘",shape=box,color=blue];
		1365 -> 1367;
	1366 [label="가끔 내 마음의 눈에 보이는, 악몽이 허락하는 한 멀리 뻗어 있는, 정말로 텅 빈 눈을 가진 해로우 중 하나가 되는 게 더 낫지 않을까 생각하곤 하오.",shape=box,color=blue];
		1366 -> 1368;
	1367 [label="그들의 얼굴이
셀 수 없이 많은데
공허하고 부서져 있으며
영원히 산산 조각난 기도 속에서
나는 무엇이 될 것인가",shape=box,color=blue];
		1367 -> 1369;
		1367 -> 1370;
	1368 [label="Evaluate expressions",color=orange];
		1368 -> 1372 [label="MarieDating",color=purple];
		1368 -> 1371 [label="MarieDating",color=purple];
		1368 -> 1371 [label="RoatheDating",color=purple];
		1368 -> 1372 [label="RoatheDating",color=purple];
		1368 -> 1371 [label="false",color=purple];
		1368 -> 1372 [label="false",color=purple];
		1368 -> 1373 [label="false",color=purple];
	1369 [label="숨 쉬어, 리온. 숨 쉬어. 그들은 실제로 거기에 있지 않아.",shape=box,color=red];
		1369 -> 1374;
	1370 [label="미 - 미안해, 리온. 화면에 집중해줘. 난 여기 있으니까.",shape=box,color=red];
		1370 -> 1375;
	1372 [label="이게 당신에게 맡겨진 끔찍한 짐이라는 걸 알아. 그리고 어쩌면 이게 옳지 않은 일일지도 몰라. 하지만 난 벗어날 방법을 모르겠어.",shape=box,color=red];
		1372 -> 1377;
	1371 [label="마리에게 있어서 당신은 세상 전부야. 그리고 내 소중한 친구가 되었어. 로스조차도 당신을 그리워할 것 같아. 당신은 인정 안 하겠지만 말이야.",shape=box,color=red];
		1371 -> 1376;
	1373 [label="[마음을 고백한다.] 그런 일이 당신에게 일어난다면 가슴이 찢어질 거야, 리온. 난...당신을 진심으로 아끼니까.",shape=box,color=red];
		1373 -> 1378;
	1374 [label="틀렸어
그들은 거기에 있어
결코 날 떠나지 않을 거야
다시는
엔트라티가 봤어
용서해주길",shape=box,color=blue];
		1374 -> 1379;
	1375 [label="내 육신을 찢고
내 뼈에서 벗겨내지
어째서? 무슨 목적으로?
이게 누구의 허기를 채워주는 거지?",shape=box,color=blue];
		1375 -> 1380;
		1375 -> 1381;
	1377 [label="상상도 할 수 없는... 일을 하지 않고서는 안될 것 같아. 아니면 그런 일을 해야하거나.",shape=box,color=red];
		1377 -> 1383;
	1376 [label="당신은 소중히 여겨지고 사랑받고 있어. 가족과 친구들이 있어. 항상 그런 기분이 아니더라도.",shape=box,color=red];
		1376 -> 1382;
	1378 [label="난 - 분명, 농담하는 거겠지. 방금 목격한 일을 생각하면, 그대 말이 진심일 리가 없잖소? 제정신을 잃었거나, 아니면 동정심이 이성을 압도했거나 둘 중 하나일 거요.",shape=box,color=blue];
		1378 -> 1384;
		1378 -> 1385;
	1379 [label="+10 Chemistry",color=orange];
		1379 -> 1386;
	1380 [label="아무도. 더 이상 이렇게 고통받을 필요 없어. 그냥 흘려보내.",shape=box,color=red];
		1380 -> 1387;
	1381 [label="알아. 아프다는 거 알아. 미안해. 정말 미안해. 그 방에서 얼른 나가.",shape=box,color=red];
		1381 -> 1388;
	1383 [label="+10 Chemistry",color=orange];
		1383 -> 1390;
	1382 [label="당신은 혼자가 아니야, 리온. 그리고 당신이 없으면 그리울 거야.",shape=box,color=red];
		1382 -> 1389;
	1384 [label="아니, 리온. 난 진심이야. 당신은 나한테 있어서 정말 큰 의미의 존재야. 내가 바라는 건 그저 당신이 그걸 믿어줬음 하는 거라고.",shape=box,color=red];
		1384 -> 1391;
	1385 [label="난... 어쩌면 당신 말이 맞을지도. 어쩌면 지금은 적절한 때가 아닐지도 몰라.",shape=box,color=red];
		1385 -> 1392;
	1386 [label="Update boolean LyonRell2b",color=orange];
		1386 -> 1393;
	1387 [label="그리도 간단했다면
이 사슬들은 오랫동안 내 것이었는데
언어보다도 더 오래
내 이름보다도 더 오래
용서해줘",shape=box,color=blue];
		1387 -> 1379;
	1388 [label="당신의 마음 속에 있는 방에서 뒤돌아서 빠져나가.",shape=box,color=red];
		1388 -> 1394;
	1390 [label="M. 네크랄로이드를 보고, M. 오디스나 M. 오탁에 대한 이야기를 들었소. 두개골에서 생각이 뽑혀져 나온 텅 빈 워프레임들을 떠올렸소.",shape=box,color=blue];
		1390 -> 1396;
	1389 [label="+10 Chemistry",color=orange];
		1389 -> 1395;
