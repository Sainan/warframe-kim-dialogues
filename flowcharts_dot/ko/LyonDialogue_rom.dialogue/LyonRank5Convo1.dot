		1312 -> 1313 [label="RoatheMITW1",color=purple];
		1312 -> 1316 [label="false",color=purple];
		1312 -> 1313 [label="false",color=purple];
	1315 [label="이전에 내가 무심은 \"진정한 신\"이란 걸 믿지 않는다는 점에 대해 이야기하고 싶어했잖아. 지금이 바로 그 적절한 시기일려나?",shape=box,color=red];
		1315 -> 1320;
	1313 [label="[종료.]",shape=box,color=red];
		1313 -> 1318;
	1314 [label="며칠 전, 개념의 형상화와 무심에 대해 질문했었잖아. 혹시 뭔가 신경 쓰이는 게 있어?",shape=box,color=red];
		1314 -> 1319;
	1317 [label="로스는 \"벽 속의 남자\"가 진짜 신이 아니라고 확신하고 있어. 그는 \"개념의 형상화\"의 산물이라고 말이야. 당신은 어떻게 생각해?",shape=box,color=red];
		1317 -> 1322;
	1316 [label="리온, 당신이랑 로스 사이에 무슨 일이 있는 거야? 단편적으로 밖에 몰라서 말이야.",shape=box,color=red];
		1316 -> 1321;
	1320 [label="이 문제로 인해 발생한 실질적인 문제에 대해 논의하기에 \"좋은\" 시간이 언제가 될지 모르겠소, 드리프터.",shape=box,color=blue];
		1320 -> 1324;
	1318 [label="Chat ends.",color=orange];
	1319 [label="나를 괴롭히는 것들이 너무나 많소, 드리프터. 무심과 개념의 형상화라는 주제는 그중 하나에 불과할지도 모르지.",shape=box,color=blue];
		1319 -> 1323;
	1322 [label="문제는 말이오, 드리프터. 나도 잘 모른다는 거요. 만약 답을 알았다면, 이런 내면의 논쟁으로 스스로를 괴롭히지 않았을 거요.",shape=box,color=blue];
		1322 -> 1326;
	1321 [label="요약하자면, 그 주제에 대한 그자의 폭언을 피했다는 게 놀랍긴 하오. 그자는 기회가 있을 때마다 그런 폭언을 쏟아내려고 너무 열심인 것 같으니.",shape=box,color=blue];
		1321 -> 1325;
	1324 [label="허나 그런 의미에서 지금이야말로 그 어느 때보다 \"좋은\" 시기요. 그대가 무심이란 존재는 진정한 신이 아니라는 로스의 믿음에 동조하는 것 같아 흥미롭군.",shape=box,color=blue];
		1324 -> 1326;
	1323 [label="아니면 상황을 어찌 해석하느냐에 따라 두 가지가 될 수도 있지. 하지만 내 딜레마의 핵심은 바로 이것이요.",shape=box,color=blue];
		1323 -> 1326;
	1326 [label="어쨌든, 처음부터... 시작해야겠군. 맥락을 모르면 이 주제가 왜 내게 그리 중요한지 정확하게 이해하지 못할 거요...",shape=box,color=blue];
		1326 -> 1328;
	1325 [label="그자는 무심이 어떤 의미에서든 보이드의 신이 아니며, 실제로는 엔트라티와 그 이후에 그것과 교류한 모든 이들이 만들어낸 존재라 믿고 있소 -",shape=box,color=blue];
		1325 -> 1327;
	1328 [label="난 루아의 형제요. 내 삶을 루아께 바쳤으니. 평생동안, 이걸 믿어 왔소.",shape=box,color=blue];
		1328 -> 1330;
	1327 [label="- \"개념의 형상화\"라고 알려진 것을 통해 보이드에서 창조된 것이라고. ",shape=box,color=blue];
		1327 -> 1329;
	1330 [label="대성당에 도착한 이후, 난 내 신앙을 굳건히 지켜왔소 - 즉 내 고통, 아픔, 환상 -",shape=box,color=blue];
		1330 -> 1331;
	1329 [label="그대가 두비리를 창조한 방식과 비슷한 방식이라 생각이 드오.",shape=box,color=blue];
		1329 -> 1326;
	1331 [label="- 루아를 위해 헌신해 왔소. 그녀의 이름으로, 그녀의 목적을 위해.",shape=box,color=blue];
		1331 -> 1332;
	1332 [label="그... \"Cardinal Dimanche\"가 스스로를 알브레히트 엔트라티라는 사실을 밝힐 때까지는.",shape=box,color=blue];
		1332 -> 1333;
	1333 [label="그리고 그는 스스로가 누구인지, 보이드와 관련된 그의 악행에 대한 이야기, 그리고 그로 인해 발생한 모든 일들을 우리에게 말해주었소... 더 구체적으로 말하면... 그로 인해 발생한 결과 모든 것들을 말이오.",shape=box,color=blue];
		1333 -> 1334;
		1333 -> 1335;
	1334 [label="무심.",shape=box,color=red];
		1334 -> 1336;
	1335 [label="그리고?",shape=box,color=red];
		1335 -> 1337;
	1336 [label="맞소. 그는 자신을 맞이한 비웃는 존재, 실험실과 비슷한 장소에서 찾아낸 손가락들에 대해 얘기해 주었소.",shape=box,color=blue];
		1336 -> 1338;
	1337 [label="엔트라티는 세리글래스 종을 타고 보이드 속으로 내려갔던 이야기를 들려주었소. 마치 그의 실험실을 연상시키는 장소에 대해서. ",shape=box,color=blue];
		1337 -> 1338;
	1338 [label="게다가, 그는 공간뿐만 아니라 시간을 초월하여 자신을 따라다닐 수 있는 무언가를 풀어놓았다는 사실을 깨닫고 느꼈던 엄청난 공포에 대해서도 이야기 했소.",shape=box,color=blue];
		1338 -> 1339;
	1339 [label="허무의 신. 억제되어야 할 존재. 그가 가진 조각난 육신의 본래 주인, 자유로이 풀려나고 싶어서 벽 뒤를 끊임없이 긁어대는 자.",shape=box,color=blue];
		1339 -> 1340;
	1340 [label="이미 자유로워졌으나, 자유롭지 못한, 끔찍하고 소모적인 신.",shape=box,color=blue];
		1340 -> 1341;
		1340 -> 1342;
	1341 [label="무슨 뜻이야?",shape=box,color=red];
		1341 -> 1343;
	1342 [label="\"이미 자유로워졌으나\" 와 \"자유롭지 못하다\" 라고?",shape=box,color=red];
		1342 -> 1343;
	1343 [label="Check boolean LyonRell1",color=orange];
		1343 -> 1345 [label=true,color=green];
		1343 -> 1344 [label=false,color=brown];
	1345 [label="시간은... 나 같은 존재에게 있어서 얽혀 있소. 지금 내가 처한 상황은 설명하기 어렵고, 설명하기도 힘드오. 한 번 제대로 설명하려고 했으나, 비참하게 실패했지.",shape=box,color=blue];
		1345 -> 1346;
	1344 [label="시간은... 나 같은 존재에게 있어서 얽혀 있소. 지금 내가 처한 상황은 설명하기 어렵고, 설명하기도 힘드오.",shape=box,color=blue];
		1344 -> 1346;
	1346 [label="오늘 말하고자 하는 요점은 그 내용이 아니므로 자세한 내용은 다음 기회에 설명하겠소.",shape=box,color=blue];
		1346 -> 1347;
