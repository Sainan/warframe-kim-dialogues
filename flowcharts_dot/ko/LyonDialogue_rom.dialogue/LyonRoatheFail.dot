	"Chat ends." [color=orange];
	j3934780159 [label="도울 수 있는 일이 있다면 뭐든 하겠소, mon miracle. 두 사람 사이에 무슨 문제라도 있소?",shape=box,color=blue];
		j3934780159 -> j1618578127;
	j3851942854 [label="도울 수 있는 일이 있다면 뭐든 하겠소, 친구여. 두 사람 사이에 무슨 문제라도 있소?",shape=box,color=blue];
		j3851942854 -> j1618578127;
	j1618578127 [label="Evaluate expressions",color=orange];
		j1618578127 -> j1075884282 [label="RoatheFail",color=purple];
		j1618578127 -> j1075884282 [label="RoatheFailStall",color=purple];
		j1618578127 -> j3177217291 [label="RoatheFailUltimate",color=purple];
		j1618578127 -> j3505395096 [label="RoatheFailNot21",color=purple];
		j1618578127 -> j2448606260 [label="RoatheFailUnloved",color=purple];
	j1075884282 [label="로스는... 음... 자신의 선택으로 혈청을 투약했다는 진실을 마주하고 있어. 어떻게 된 건지 모르겠지만, 내가 그를 제대로 돕지 못한 것 같아.",shape=box,color=red];
		j1075884282 -> j3797760286;
	j3177217291 [label="나도 잘 모르겠어. 해선 안 될 말을 한 것 같아.",shape=box,color=red];
		j3177217291 -> j711563995;
	j3505395096 [label="그자가 더 이상 자신의 기억 속으로 들어가지 말라고 했어. 그래서 더 이상 들어가지 않고 있지만. 이제... 갇힌 상태가 된거야?",shape=box,color=red];
		j3505395096 -> j2317053611;
	j2448606260 [label="로스에게 평범한 동지애로 지낼 뿐이라고 말했고, 그가 별 문제 삼지 않는 것 같았지만, 지금은 로스와의 관계가 퇴보한 것 같아.",shape=box,color=red];
		j2448606260 -> j711563995;
	j3797760286 [label="알겠소. 과거의 행동을 새로운 시각으로서 바라보면서 수용하는 건 어려운 일이겠지. 로스와 우리를 이 비열한 상황에 몰아넣은 엔트라티를 저주하오.",shape=box,color=blue];
		j3797760286 -> j2035280399;
	j711563995 [label="알겠소. 이 문제에 대해 내가 할 수 있는 일이 거의 없다는 말을 드려야 할 것 같구려. 그대는 이 문제에 대해 \"뿌린 대로 거두는\" 후유증을 겪고 있는 거니까.",shape=box,color=blue];
		j711563995 -> j2059859499;
	j2317053611 [label="알겠소. 때로는 자신의 바람대로 행동하는 것과, 자신의 요청을 그대로 따르는 것은 다르오.",shape=box,color=blue];
		j2317053611 -> j1583663882;
	j2035280399 [label="그자가 그대 말을 듣도록 최선을 다해 설득해 보리다. 그러나 스스로의 행동을 비겁함이 아닌 다른 것으로 재해석해야 하는 이유를 더 잘 설명할 수 있는 논거를 준비해두길 권고하오.",shape=box,color=blue];
		j2035280399 -> j3365071112;
	j2059859499 [label="그런 식으로 냉담하고 무시하는 태도를 보이면 상대방도 똑같이 반응할 수 밖에 없소. 특히 로스 같은 자를 상대할 때는 더욱 그렇고.",shape=box,color=blue];
		j2059859499 -> j3756776683;
	j1583663882 [label="누군가의 바람을 거스르는 것은 우리가 해야 할 끔찍한 행위이며, 특히 그 사람의 사적인 기억과 생각을 훔치는 것과 같은 행위는 더욱 그렇소.",shape=box,color=blue];
		j1583663882 -> j761358597;
	j3365071112 [label="그 점이 로스를 안에서부터 완전히 먹어치운다는 걸 알고 있으니까.",shape=box,color=blue];
		j3365071112 -> j1882739304;
	j3756776683 [label="어떤 방법을 통해 문제를 바로잡을 수 있을지 모르겠소. 하지만 마리 혹은 나를 통해서는 해결책을 찾을 수 없을 것 같구려. 양해해 주시오.",shape=box,color=blue];
		j3756776683 -> j1764309768;
	j761358597 [label="우리와 그자를 이런 비열한 처지로 몰아넣은 엔트라티를 저주하오.",shape=box,color=blue];
		j761358597 -> j1986539127;
	j1882739304 [label="이 문제에 마리의 도움도 필요하다는 걸 알고 있소. 두 사람 사이에 애정이란게 거의 없다는 걸 알테니, 마리를 설득하는 게 좀 더 어려울 수도 있겠구려.",shape=box,color=blue];
		j1882739304 -> j3043779031;
	j1764309768 [label="아마도 이 지점에선 다른 선택지를 모색해 보는 게 좋을 것 같소.",shape=box,color=blue];
		j1764309768 -> "Chat ends.";
	j1986539127 [label="하지만 안타깝게도 그자를 도울 수 있는 유일한 방법이 바로 그리 하는 것 밖에 없을 것 같소. 그리고 발견되지 않은 기억이 하나도 남지 않을 때까지 디센디아를 계속 탐험하는 거요.",shape=box,color=blue];
		j1986539127 -> j1494908397;
	j3043779031 [label="Boolean LyonRoatheFailFix is now true.",color=orange];
		j3043779031 -> j289463762;
	j1494908397 [label="악마가 어떻게든 저항하더라도.",shape=box,color=blue];
		j1494908397 -> "Chat ends.";
	j289463762 [label="루아께서 그대를 이끄시길.",shape=box,color=blue];
		j289463762 -> "Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
