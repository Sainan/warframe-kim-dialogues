	2267 [label="도울 수 있는 일이 있다면 뭐든 하겠소, mon miracle. 두 사람 사이에 무슨 문제라도 있소?",shape=box,color=blue];
		2267 -> 2269;
	2268 [label="도울 수 있는 일이 있다면 뭐든 하겠소, 친구여. 두 사람 사이에 무슨 문제라도 있소?",shape=box,color=blue];
