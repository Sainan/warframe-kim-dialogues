		2269 -> 2271 [label="RoatheFailNot21",color=purple];
		2269 -> 2270 [label="RoatheFailUnloved",color=purple];
	2273 [label="로스는... 음... 자신의 선택으로 혈청을 투약했다는 진실을 마주하고 있어. 어떻게 된 건지 모르겠지만, 내가 그를 제대로 돕지 못한 것 같아.",shape=box,color=red];
		2273 -> 2277;
	2272 [label="나도 잘 모르겠어. 해선 안 될 말을 한 것 같아.",shape=box,color=red];
		2272 -> 2276;
	2271 [label="그자가 더 이상 자신의 기억 속으로 들어가지 말라고 했어. 그래서 더 이상 들어가지 않고 있지만. 이제... 갇힌 상태가 된거야?",shape=box,color=red];
		2271 -> 2275;
	2270 [label="로스에게 평범한 동지애로 지낼 뿐이라고 말했고, 그가 별 문제 삼지 않는 것 같았지만, 지금은 로스와의 관계가 퇴보한 것 같아.",shape=box,color=red];
		2270 -> 2274;
	2277 [label="알겠소. 과거의 행동을 새로운 시각으로서 바라보면서 수용하는 건 어려운 일이겠지. 로스와 우리를 이 비열한 상황에 몰아넣은 엔트라티를 저주하오.",shape=box,color=blue];
		2277 -> 2280;
	2276 [label="알겠소. 이 문제에 대해 내가 할 수 있는 일이 거의 없다는 말을 드려야 할 것 같구려. 그대는 이 문제에 대해 \"뿌린 대로 거두는\" 후유증을 겪고 있는 거니까.",shape=box,color=blue];
		2276 -> 2278;
	2275 [label="알겠소. 때로는 자신의 바람대로 행동하는 것과, 자신의 요청을 그대로 따르는 것은 다르오.",shape=box,color=blue];
		2275 -> 2279;
	2274 [label="알겠소. 이 문제에 대해 내가 할 수 있는 일이 거의 없다는 말을 드려야 할 것 같구려. 그대는 이 문제에 대해 \"뿌린 대로 거두는\" 후유증을 겪고 있는 거니까.",shape=box,color=blue];
		2274 -> 2278;
	2280 [label="그자가 그대 말을 듣도록 최선을 다해 설득해 보리다. 그러나 스스로의 행동을 비겁함이 아닌 다른 것으로 재해석해야 하는 이유를 더 잘 설명할 수 있는 논거를 준비해두길 권고하오.",shape=box,color=blue];
		2280 -> 2282;
	2278 [label="그런 식으로 냉담하고 무시하는 태도를 보이면 상대방도 똑같이 반응할 수 밖에 없소. 특히 로스 같은 자를 상대할 때는 더욱 그렇고.",shape=box,color=blue];
		2278 -> 2281;
	2279 [label="누군가의 바람을 거스르는 것은 우리가 해야 할 끔찍한 행위이며, 특히 그 사람의 사적인 기억과 생각을 훔치는 것과 같은 행위는 더욱 그렇소.",shape=box,color=blue];
		2279 -> 2341;
	2282 [label="그 점이 로스를 안에서부터 완전히 먹어치운다는 걸 알고 있으니까.",shape=box,color=blue];
		2282 -> 2284;
	2281 [label="어떤 방법을 통해 문제를 바로잡을 수 있을지 모르겠소. 하지만 마리 혹은 나를 통해서는 해결책을 찾을 수 없을 것 같구려. 양해해 주시오.",shape=box,color=blue];
		2281 -> 2283;
	2341 [label="우리와 그자를 이런 비열한 처지로 몰아넣은 엔트라티를 저주하오.",shape=box,color=blue];
		2341 -> 2342;
	2284 [label="이 문제에 마리의 도움도 필요하다는 걸 알고 있소. 두 사람 사이에 애정이란게 거의 없다는 걸 알테니, 마리를 설득하는 게 좀 더 어려울 수도 있겠구려.",shape=box,color=blue];
		2284 -> 2286;
	2283 [label="아마도 이 지점에선 다른 선택지를 모색해 보는 게 좋을 것 같소.",shape=box,color=blue];
		2283 -> 2285;
	2342 [label="하지만 안타깝게도 그자를 도울 수 있는 유일한 방법이 바로 그리 하는 것 밖에 없을 것 같소. 그리고 발견되지 않은 기억이 하나도 남지 않을 때까지 디센디아를 계속 탐험하는 거요.",shape=box,color=blue];
		2342 -> 2343;
