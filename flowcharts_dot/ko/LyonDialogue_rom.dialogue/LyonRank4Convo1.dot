		666 -> 679;
	667 [label="난 저 밖 어딘가에 무언가가 존재한다고 믿지만, 거기에 대해선 사람들이 진정한 답을 찾을 수 없을 것 같아.",shape=box,color=red];
		667 -> 680;
	668 [label="난 종교가 없어. 종교는 두려움을 극복하는 데 도움이 되는 도구라고 생각하는 편이야 - 기분 나쁘게 받아들이진 말아줘.",shape=box,color=red];
		668 -> 681;
	669 [label="난 종교가 없어. 세상에 뭔가 있을 리가 없다고 호언장담할 순 없지만, 그닥 신경 쓰지 않고 있어.",shape=box,color=red];
