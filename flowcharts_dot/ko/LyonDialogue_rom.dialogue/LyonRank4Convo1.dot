	701 [label="우리의 신앙이 의도적이든 아니든 서로에게 얼마나 많은 영향을 끼쳤는지 궁금하오.",shape=box,color=blue];
		701 -> 704;
	698 [label="대단히 흥미롭군! 이 분야의 학자로서, 우리가 각자의 신앙에 대해 서로에게서 자세히 배울 시간을 갖길 바라오.",shape=box,color=blue];
		698 -> 704;
	695 [label="말하자면 길어. ",shape=box,color=red];
		695 -> 707;
	696 [label="여러 종교를 공부해 봤지만, 나한테 맞는 종교는 하나도 없었어. 그러다 보니 인간 본성의 다소 독특한 복합성을 이해하게 됐어.",shape=box,color=red];
		696 -> 708;
	697 [label="난 내가 느끼는 것을 믿어. 그것이 정확히 무엇인지 알려줄 건축물이나 책은 필요없지.",shape=box,color=red];
		697 -> 709;
	690 [label="정말이요? 난... 좀 놀랐소이다. 놀랍지만, 기쁘구려. 그러니 그대가 그리 궁금해하는 것도 당연하겠지. 우리의 가르침은 그대가 알던 것과는 너무나 다르니까. 시간이 너무 많이 흘렀소.",shape=box,color=blue];
		690 -> 704;
	691 [label="그 점을 존중하오. 우리가 알 수 없는 것을 인식하고, 인간이라는 존재의 하찮음을 직시하는 것은 명예로운 일이니.",shape=box,color=blue];
		691 -> 704;
	692 [label="날 믿어도 되오, 거기에 기분 나쁘고 할 게 어딨소. 수많은 경우, 그대의 말이 옳을 터이니.",shape=box,color=blue];
		692 -> 705;
		692 -> 706;
	693 [label="장막 너머에서 우리를 기다리고 있을지도 모르는 일에 대해 걱정할 이유를 찾지 못한다는 점이 부럽다는 걸 인정하겠소. 다른 이들이 그 점을 더 걱정해 주었더라면, 우리 세상은 그 시절에 더 평화로웠을텐데.",shape=box,color=blue];
		693 -> 704;
	694 [label="이 주제에 대해서 그대와 자세히 이야기를 나누고 싶소. 하지만 지금은 그런 논의를 나눌 준비가 되어 있지 않군.",shape=box,color=blue];
		694 -> 704;
	688 [label="현명한 시작점이오. 명절들을 통해 아는 것은 그 문화를 이해하는 것과 같소. 사람들이 어찌 기념하느냐에 따라 그 사람들이 어떻게 기억될지 결정되기 때문이지. 그러한 순간들은 함께하는 이들에게 가장 소중히 여겨지기 때문이오.",shape=box,color=blue];
		688 -> 702;
	689 [label="물론이오. 이미 알고 있을지도 모르는 것부터 시작해보겠소: 솔과 루아, 태양과 달을 뜻하지. 이들은 각자의 모습을 영원히 바꿀 수 있는 신들이요.",shape=box,color=blue];
		689 -> 703;
	710 [label="흠. 그 궁금증에 답해 드리겠소. 너무 지루하지 않게, 어디서부터 시작했음 하오?",shape=box,color=blue];
		710 -> 665;
		710 -> 664;
	704 [label="그리고 내가 주제에서 벗어나지 못한 점 사과드리오. 본론에서 너무 벗어나 버린 것 같으니.",shape=box,color=blue];
		704 -> 714;
	707 [label="+20 Chemistry",color=orange];
		707 -> 717;
	708 [label="+20 Chemistry",color=orange];
