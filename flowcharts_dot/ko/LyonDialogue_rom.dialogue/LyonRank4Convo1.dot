		j3653530717 -> j524005108;
	j4249720809 [label="대단히 흥미롭군! 성직에 임하는 학구자로써, 우리 각자의 신앙에 대해 서로 자세히 배울 시간을 갖기를 바라오.",shape=box,color=blue];
		j4249720809 -> j524005108;
	j2375919288 [label="말하자면 길어. ",shape=box,color=red];
		j2375919288 -> j219007802;
	j91988829 [label="여러 종교를 공부해 봤지만, 나한테 맞는 종교는 하나도 없었어. 그러다 보니 인간 본성의 다소 독특한 복합성을 이해하게 됐어.",shape=box,color=red];
		j91988829 -> j1167445392;
	j2342877417 [label="난 내가 느끼는 것을 믿어. 그것이 정확히 무엇인지 알려줄 건축물이나 책은 필요없지.",shape=box,color=red];
		j2342877417 -> j312188045;
	j2386456409 [label="정말이요? 난... 좀 놀랐소이다. 놀랍지만, 기쁘구려. 그러니 그대가 그리 궁금해하는 것도 당연하겠지. 우리의 가르침은 그대가 알던 것과는 너무나 다르니까. 시간이 너무 많이 흘렀소.",shape=box,color=blue];
		j2386456409 -> j524005108;
	j2540707068 [label="그 점을 존중하오. 우리가 알 수 없는 것을 인식하고, 인간이라는 존재의 하찮음을 직시하는 것은 명예로운 일이니.",shape=box,color=blue];
		j2540707068 -> j524005108;
	j3735497025 [label="날 믿어도 되오, 거기에 기분 나쁘고 할 게 어딨소. 수많은 경우, 그대의 말이 옳을 터이니.",shape=box,color=blue];
		j3735497025 -> j2992306066;
		j3735497025 -> j2228381307;
	j796110056 [label="장막 너머에서 우리를 기다리고 있을지도 모르는 일에 대해 걱정할 이유를 찾지 못한다는 점이 부럽다는 걸 인정하겠소. 다른 이들이 그 점을 더 걱정해 주었더라면, 우리 세상은 그 시절에 더 평화로웠을텐데.",shape=box,color=blue];
		j796110056 -> j524005108;
	j1132520900 [label="이 주제에 대해서 그대와 자세히 이야기를 나누고 싶소. 하지만 지금은 그런 논의를 나눌 준비가 되어 있지 않군.",shape=box,color=blue];
		j1132520900 -> j524005108;
	j357920195 [label="현명한 시작점이오. 명절들을 통해 아는 것은 그 문화를 이해하는 것과 같소. 사람들이 어찌 기념하느냐에 따라 그 사람들이 어떻게 기억될지 결정되기 때문이지. 그러한 순간들은 함께하는 이들에게 가장 소중히 여겨지기 때문이오.",shape=box,color=blue];
		j357920195 -> j12414764;
	j2194775984 [label="물론이오. 이미 알고 있을지도 모르는 것부터 시작해보겠소: 솔과 루아, 태양과 달을 뜻하지. 이들은 각자의 모습을 영원히 바꿀 수 있는 신들이요.",shape=box,color=blue];
		j2194775984 -> j334264406;
	j3127451999 [label="흠. 그 궁금증에 답해 드리겠소. 너무 지루하지 않게, 어디서부터 시작했음 하오?",shape=box,color=blue];
		j3127451999 -> j551942859;
		j3127451999 -> j2775707134;
	j524005108 [label="그리고 내가 주제에서 벗어나지 못한 점 사과드리오. 본론에서 너무 벗어나 버린 것 같으니.",shape=box,color=blue];
		j524005108 -> j1898218617;
	j219007802 [label="+20 Chemistry",color=orange];
		j219007802 -> j27099145;
	j1167445392 [label="+20 Chemistry",color=orange];
		j1167445392 -> j1368497728;
	j312188045 [label="+20 Chemistry",color=orange];
		j312188045 -> j2552877328;
	j2992306066 [label="그렇다고 해서 내가 배움에 관심이 없다는 뜻은 아니야.",shape=box,color=red];
		j2992306066 -> j114237893;
	j2228381307 [label="네 경우는 어땠길래?",shape=box,color=red];
		j2228381307 -> j833150412;
	j12414764 [label="우리의 중요하고 가장 일반적인 명절은, 일 년 중 낮이 가장 짧고 가장 긴 겨울과 여름 솔스티스가 있소.",shape=box,color=blue];
		j12414764 -> j4191158819;
	j334264406 [label="수 세기 동안 수많은 신도들에게 여러 모습으로 나타났소. 때로는 남성, 때로는 여성으로 나타났지만 항상 태양인 솔과 달인 루아로 나타났으니.",shape=box,color=blue];
		j334264406 -> j3081955234;
		j334264406 -> j294469812;
	j1898218617 [label="광휘의 성체 정교회에 대해 알고 싶다고 하지 않았소? 지루함으로 그대 눈에 눈물이 나오지 않도록, 어디서부터 시작하길 원하오?",shape=box,color=blue];
		j1898218617 -> j551942859;
		j1898218617 -> j2775707134;
	j27099145 [label="음. 이야기 하나 정도는 믿을 수 있는 친구에게 말해주는 게 좋겠구려. 완전히 이해하오. 게다가 이번에는 나한테서가 아니라, 네게서 질문을 받았으니까.",shape=box,color=blue];
		j27099145 -> j524005108;
	j1368497728 [label="영혼의 색유리창. 깨지면 산산조각나지만, 다시 모이면 얼마나 아름다운 모습을 그려내는지.",shape=box,color=blue];
		j1368497728 -> j524005108;
	j2552877328 [label="세상이 그대와 같은 신앙을 공유한다면, 훨씬 더 나은 곳이 될 것이오.",shape=box,color=blue];
		j2552877328 -> j524005108;
	j114237893 [label="그런 점에서 난 그대의 호기심과 학문적 성향을 칭찬하고 싶구려. ",shape=box,color=blue];
		j114237893 -> j524005108;
	j833150412 [label="내 경우는... 복잡하오. 그렇다고 해서 내게 두려움이 전혀 없었다고 거짓말은 못하겠소. 종교가 내 삶에 두려움을 홍수처럼 쏟아부었지만, 결코 없애지도 못했으니까.",shape=box,color=blue];
		j833150412 -> j524005108;
	j4191158819 [label="두 명절 모두 큰 축제로 기념되지만, 누구와 함께 축제를 즐기는지에 따라 구분되기도 하오. 겨울 솔스티스는 가족이나 가장 가까운 친구들과 함께하는 날이라면, 여름 솔스티스는 낯선 이들과 함께 보내는 명절이오.",shape=box,color=blue];
		j4191158819 -> j3441316222;
		j4191158819 -> j4140512136;
	j3081955234 [label="오, 이제야 훨씬 더 이해가 잘 되네.",shape=box,color=red];
		j3081955234 -> j2897624937;
	j294469812 [label="[계속 말하도록 기다려준다.]",shape=box,color=red];
		j294469812 -> j166784651;
	j3441316222 [label="정말? 여름 솔스티스에 대해 더 자세히 말해줘.",shape=box,color=red];
		j3441316222 -> j2084673507;
	j4140512136 [label="겨울 솔스티스에 대해 더 자세히 말해줘.",shape=box,color=red];
		j4140512136 -> j95397944;
	j2897624937 [label="그렇소. 일부 종파는 상징을 선택하는 데 약간 엄격하고, 솔은 \"반드시\" 한 가지 방식이거나 \"반드시\" 다른 방식이어야 한다고 주장하나, 정교회는 이를 사실로 인정하지 않소.",shape=box,color=blue];
		j2897624937 -> j2284356693;
	j166784651 [label="각 광휘의 성체들은 여러 측면을 가지고 있소. 각 측면은 전체의 기능으로도 볼 수 있으니. 예를 들자면, 루아는 어머니, 아가씨, 노파를 뜻하오.",shape=box,color=blue];
		j166784651 -> j843440413;
	j2084673507 [label="여름 솔스티스는 풍성한 수확을 나누고, 한 번도 만난 적 없는 낯선 이들을 하나로 모으는 날이오. 밭에 모여 직접 만든 음식을 가져가면 되고, 그게 어떤 종류든 상관 없소.",shape=box,color=blue];
		j2084673507 -> j2453577955;
	j95397944 [label="겨울 솔스티스는 추위에 맞서 싸우고, 가장 어두운 시기에 우리를 따뜻하게 대해 준 이들을 소중히 여기는 날이오. 양초들로 나무를 장식하고, 하늘의 별처럼 우리의 길을 인도하는, 앞서간 이들을 위해 한 명, 한 명을 위한 촛불을 켜오.",shape=box,color=blue];
		j95397944 -> j1025443858;
	j2284356693 [label="개인적으론 먼 미래까지 살아남은 것이 무엇이었든 간에, 그 존재가 내 종교를 기록하는 데 있어서 약간 혼란스러웠으리라 예상하오.",shape=box,color=blue];
		j2284356693 -> j1425825238;
	j843440413 [label="또한 루아는 영혼들을 눈물의 강을 따라 끝없는 밤으로 인도하는 자, 죽음 그 자체, 전령이자 선구자일 수도 있소.",shape=box,color=blue];
		j843440413 -> j1326396487;
	j2453577955 [label="양초든, 빵이든, 옷이든, 그림이든, 시집이든, 화환이든. 빈손으로 오더라도 \"기쁜 소식\"을 전하는 것조차 축복으로 여겨야 하오.",shape=box,color=blue];
		j2453577955 -> j2933707390;
	j1025443858 [label="그리고 그 위에는, 어둠 속 별나무 위에서 고통받는 솔이 있소. 희미해졌지만, 잊혀지진 않은 존재. 지금은 루아의 시대이므로, 우리는 이 그림자의 시대에서 그녀를 기려야 하오.",shape=box,color=blue];
		j1025443858 -> j540667673;
	j1425825238 [label="스스로가 마치 살아있는 고고학적 유물 같군. 얼마나 우울한 일인지. 본론으로 돌아가기로 하지.",shape=box,color=blue];
		j1425825238 -> j166784651;
	j1326396487 [label="다른 종파에서는 죽음이 베일을 쓴 늙은 여인으로 묘사하기도 하지만, 우리 모두에게 다가오는 영혼을 다 동일한 존재라 말하오. 마지막 순간에 우리를 인도하고자 하는 은빛 손길 말이오.",shape=box,color=blue];
		j1326396487 -> j1714675882;
	j2933707390 [label="생명에 대한 축하 - 웃음 - 음악 - 이 모든 것을 공유하는 일은 솔의 가장 긴 하루 동안 거행되오. ",shape=box,color=blue];
		j2933707390 -> j964857623;
	j540667673 [label="그리고 우리는 가까이 다가가 구운 새 요리와 뿌리채소, 그리고 얼어붙은 땅에서 싱싱하게 자라지 않은 모든 것을 먹으며, 사랑하는 이들을 품에 안소. 그리고 떠나간 이들의 이야기를 들려주지.",shape=box,color=blue];
		j540667673 -> j3167242472;
	j1714675882 [label="일식 때 태양 위로 넘어가는 달은, 모든 것이 사라지는 그 순간에 우릴 갈림길로 인도하지.",shape=box,color=blue];
