	705 [label="그렇다고 해서 내가 배움에 관심이 없다는 뜻은 아니야.",shape=box,color=red];
		705 -> 715;
	706 [label="당신 경우는 어땠길래?",shape=box,color=red];
		706 -> 716;
	702 [label="우리의 중요하고 가장 일반적인 명절은, 일 년 중 낮이 가장 짧고 가장 긴 겨울과 여름 솔스티스가 있소.",shape=box,color=blue];
		702 -> 711;
	703 [label="수 세기 동안 수많은 신도들에게 여러 모습으로 나타났소. 때로는 남성, 때로는 여성으로 나타났지만 항상 태양인 솔과 달인 루아로 나타났으니.",shape=box,color=blue];
		703 -> 712;
		703 -> 713;
	714 [label="광휘의 성체 정교회에 대해 알고 싶다고 하지 않았소? 지루함으로 그대 눈에 눈물이 나오지 않도록, 어디서부터 시작하길 원하오?",shape=box,color=blue];
		714 -> 665;
		714 -> 664;
	717 [label="음. 이야기 하나 정도는 믿을 수 있는 친구에게 말해주는 게 좋겠구려. 완전히 이해하오. 게다가 이번에는 나한테서가 아니라, 당신에게서 질문을 받았으니까.",shape=box,color=blue];
		717 -> 704;
	718 [label="영혼의 색유리창. 깨지면 산산조각나지만, 다시 모이면 얼마나 아름다운 모습을 그려내는지.",shape=box,color=blue];
		718 -> 704;
	719 [label="세상이 그대와 같은 신앙을 공유한다면, 훨씬 더 나은 곳이 될 것이오.",shape=box,color=blue];
		719 -> 704;
	715 [label="그런 점에서 난 그대의 호기심과 학문적 성향을 칭찬하고 싶구려. ",shape=box,color=blue];
		715 -> 704;
	716 [label="내 경우는... 복잡하오. 그렇다고 해서 내게 두려움이 전혀 없었다고 거짓말은 못하겠소. 종교가 내 삶에 두려움을 홍수처럼 쏟아부었지만, 결코 없애지도 못했으니까.",shape=box,color=blue];
		716 -> 704;
	711 [label="두 명절 모두 큰 축제로 기념되지만, 누구와 함께 축제를 즐기는지에 따라 구분되기도 하오. 겨울 솔스티스는 가족이나 가장 가까운 친구들과 함께하는 날이라면, 여름 솔스티스는 낯선 이들과 함께 보내는 명절이오.",shape=box,color=blue];
		711 -> 720;
		711 -> 721;
	712 [label="오, 이제야 훨씬 더 이해가 잘 되네.",shape=box,color=red];
		712 -> 722;
	713 [label="[계속 말하도록 기다려준다.]",shape=box,color=red];
		713 -> 723;
	720 [label="정말? 여름 솔스티스에 대해 더 자세히 말해줘.",shape=box,color=red];
		720 -> 724;
	721 [label="겨울 솔스티스에 대해 더 자세히 말해줘.",shape=box,color=red];
		721 -> 725;
	722 [label="그렇소. 일부 종파는 상징을 선택하는 데 약간 엄격하고, 솔은 \"반드시\" 한 가지 방식이거나 \"반드시\" 다른 방식이어야 한다고 주장하나, 정교회는 이를 사실로 인정하지 않소.",shape=box,color=blue];
		722 -> 726;
	723 [label="각 광휘의 성체들은 여러 측면을 가지고 있소. 각 측면은 전체의 기능으로도 볼 수 있으니. 예를 들자면, 루아는 어머니, 아가씨, 노파를 뜻하오.",shape=box,color=blue];
		723 -> 731;
	724 [label="여름 솔스티스는 풍성한 수확을 나누고, 한 번도 만난 적 없는 낯선 이들을 하나로 모으는 날이오. 밭에 모여 직접 만든 음식을 가져가면 되고, 그게 어떤 종류든 상관 없소.",shape=box,color=blue];
		724 -> 728;
	725 [label="겨울 솔스티스는 추위에 맞서 싸우고, 가장 어두운 시기에 우리를 따뜻하게 대해 준 이들을 소중히 여기는 날이오. 양초들로 나무를 장식하고, 하늘의 별처럼 우리의 길을 인도하는, 앞서간 이들을 위해 한 명, 한 명을 위한 촛불을 켜오.",shape=box,color=blue];
		725 -> 729;
	726 [label="개인적으론 먼 미래까지 살아남은 것이 무엇이었든 간에, 그 존재가 내 종교를 기록하는 데 있어서 약간 혼란스러웠으리라 예상하오.",shape=box,color=blue];
		726 -> 730;
	731 [label="또한 루아는 영혼들을 눈물의 강을 따라 끝없는 밤으로 인도하는 자, 죽음 그 자체, 전령이자 선구자일 수도 있소.",shape=box,color=blue];
		731 -> 734;
	728 [label="양초든, 빵이든, 옷이든, 그림이든, 시집이든, 화환이든. 빈손으로 오더라도 \"기쁜 소식\"을 전하는 것조차 축복으로 여겨야 하오.",shape=box,color=blue];
		728 -> 732;
	729 [label="그리고 그 위에는, 어둠 속 별나무 위에서 고통받는 솔이 있소. 희미해졌지만, 잊혀지진 않은 존재. 지금은 루아의 시대이므로, 우리는 이 그림자의 시대에서 그녀를 기려야 하오.",shape=box,color=blue];
		729 -> 733;
	730 [label="스스로가 마치 살아있는 고고학적 유물 같군. 얼마나 우울한 일인지. 본론으로 돌아가기로 하지.",shape=box,color=blue];
		730 -> 723;
	734 [label="다른 종파에서는 죽음이 베일을 쓴 늙은 여인으로 묘사하기도 하지만, 우리 모두에게 다가오는 영혼을 다 동일한 존재라 말하오. 마지막 순간에 우리를 인도하고자 하는 은빛 손길 말이오.",shape=box,color=blue];
		734 -> 737;
	732 [label="생명에 대한 축하 - 웃음 - 음악 - 이 모든 것을 공유하는 일은 솔의 가장 긴 하루 동안 거행되오. ",shape=box,color=blue];
		732 -> 735;
	733 [label="그리고 우리는 가까이 다가가 구운 새 요리와 뿌리채소, 그리고 얼어붙은 땅에서 싱싱하게 자라지 않은 모든 것을 먹으며, 사랑하는 이들을 품에 안소. 그리고 떠나간 이들의 이야기를 들려주지.",shape=box,color=blue];
		733 -> 736;
	737 [label="일식 때 태양 위로 넘어가는 달은, 모든 것이 사라지는 그 순간에 우릴 갈림길로 인도하지.",shape=box,color=blue];
		737 -> 739;
	735 [label="누구나 낯선 이와 새로운 친구를 사귀고, 필요한 것을 집으로 가져갈 수 있었지.",shape=box,color=blue];
		735 -> 738;
	736 [label="루아의 가장 긴 밤, 루아께서 우리와 우리 가족을 인도할 것이라는 걸 기억하오.",shape=box,color=blue];
		736 -> 738;
