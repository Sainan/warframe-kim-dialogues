		j1733703232 -> j3098270240;
	j3249900358 [label="난 광휘의 성체들을 따르지만, 균형 잡힌 길을 걸을려고 노력하고 있어.",shape=box,color=red];
		j3249900358 -> j3098270240;
	j1958243861 [label="난 저 밖 어딘가에 무언가가 존재한다고 믿지만, 거기에 대해선 사람들이 진정한 답을 찾을 수 없을 것 같아.",shape=box,color=red];
		j1958243861 -> j287954236;
	j1632005182 [label="난 종교가 없어. 종교는 그저 두려움 많은 이들이 의지하는 목발 같은 거라고 생각하는 편이야. - 기분 나쁘게 받아들이진 말고.",shape=box,color=red];
		j1632005182 -> j1075402413;
	j3856531252 [label="난 종교가 없어. 저 세상 밖엔 아무 것도 없다고 호언장담할 순 없지만, 그냥 그닥 신경 쓰진 않고 있어.",shape=box,color=red];
		j3856531252 -> j2101344642;
	j3242692816 [label="난 종교가 없어. 모든 신은 - 심지어 무심까지도, 전부 우리 상상의 산물일 뿐이라고 여겨. 기분 나쁘게 받아들이진 말고.",shape=box,color=red];
