digraph {
	0 [label="LoidRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="드리프터. 이런 식으로 연락을 드리게 되어 죄송합니다. 이 장치를 사용하여 연락 드리고 싶지 않았으나, 지금 상황이 거의 비상사태에 가까워서 누구에게 도움을 요청해야 할지 알 수 없었습니다.",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="POM2_LAB1?",shape=box,color=red];
		2 -> 4;
	3 [label="누구신지...?",shape=box,color=red];
		3 -> 4;
	4 [label="아, 그렇군. 아직 기본 설정인 채로 있었네요. 이쪽은 로이드입니다. 제가... 먼저 말씀드려야 했는데, 최근 해부의 성역 내 상황이 너무나 혼란스러워졌습니다.",shape=box,color=blue];
		4 -> 5;
	5 [label="그래서 연락드리는 겁니다. 당신의 도움이 절실히 필요합니다. 제 시간대에, 이곳 성역 안에 프로토프레임이 3명이 도착했습니다. 이전에 우리가 알고 있던 존재들이 아니에요.",shape=box,color=blue];
		5 -> 6;
	6 [label="그들 중 하나는",shape=box,color=blue];
		6 -> 7;
	7 [label="실례합니다",shape=box,color=blue];
		7 -> 8;
	8 [label="그들 중 한 분은 오로킨입니다. 드리프터.",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
		8 -> 11;
	9 [label="로터스는 어디 있어요?",shape=box,color=red];
		9 -> 12;
	10 [label="오, 이런... ",shape=box,color=red];
		10 -> 13;
	11 [label="뭐라고요?!",shape=box,color=red];
		11 -> 13;
	12 [label="로터스와 오퍼레이터는 신경써야 할 다른 문제들이 있습니다. 믿어주십시오. 그들은 이미 한계에 다다를 정도로 부담을 지고 있습니다. 제가 도움을 구할 곳이 따로 있었다면 이런 문제로 당신에게 도움을 요청하지 않았을 겁니다.",shape=box,color=blue];
		12 -> 14;
	13 [label="제가 도움을 구할 곳이 따로 있었다면 이런 문제로 당신에게 도움을 요청하지 않았을 겁니다. 당신은... 이런 종류의 문제에 대해선 새로운 전문가인듯 하니까요.",shape=box,color=blue];
		13 -> 15;
	14 [label="당신은... 이런 종류의 문제에 대해선 새로운 전문가인듯 하니까요.",shape=box,color=blue];
		14 -> 15;
	15 [label="어찌 설명해 드려야 할지 잘 모르겠군요. 하지만 성역에 오시면 그분들을 놓치기 어려우실 거라고 생각이 듭니다. 두 분은 POM-2에서 당신과 대화하기로 하셨고, 한 분은 좀 더 설득이 필요할 것 같습니다.",shape=box,color=blue];
		15 -> 16;
	16 [label="전... 당신이... 성공하리라 믿습니다.",shape=box,color=blue];
		16 -> 29;
	29 [label="Update boolean LoidTriadAvailable",color=orange];
		29 -> 17;
	17 [label="Chat ends. Next chat will be LoidFamily.",color=orange];
}