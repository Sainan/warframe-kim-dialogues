digraph {
	"LoidRank1Convo1 begins." [color=orange];
		"LoidRank1Convo1 begins." -> j2911121706;
	j2911121706 [label="드리프터. 이런 식으로 연락을 드리게 되어 죄송합니다. 이 장치를 사용하여 연락 드리고 싶지 않았으나, 지금 상황이 거의 비상사태에 가까워서 누구에게 도움을 요청해야 할지 알 수 없었습니다.",shape=box,color=blue];
		j2911121706 -> j3106796315;
		j2911121706 -> j4111147668;
	j3106796315 [label="POM2_LAB1?",shape=box,color=red];
		j3106796315 -> j73173283;
	j4111147668 [label="누구신지...?",shape=box,color=red];
		j4111147668 -> j73173283;
	j73173283 [label="아, 그렇군. 아직 기본 설정인 채로 있었네요. 이쪽은 로이드입니다. 제가... 먼저 말씀드려야 했는데, 최근 해부의 성역 내 상황이 너무나 혼란스러워졌습니다.",shape=box,color=blue];
		j73173283 -> j3212016589;
	j3212016589 [label="그래서 연락드리는 겁니다. 당신의 도움이 절실히 필요합니다. 제 시간대에, 이곳 성역 안에 프로토프레임이 3명이 도착했습니다. 이전에 우리가 알고 있던 존재들이 아니에요.",shape=box,color=blue];
		j3212016589 -> j3203550960;
	j3203550960 [label="그들 중 하나는",shape=box,color=blue];
		j3203550960 -> j565395162;
	j565395162 [label="실례합니다",shape=box,color=blue];
		j565395162 -> j1844380044;
	j1844380044 [label="그들 중 한 분은 오로킨입니다. 드리프터.",shape=box,color=blue];
		j1844380044 -> j3089405503;
		j1844380044 -> j1269878070;
		j1844380044 -> j113736232;
	j3089405503 [label="로터스는 어디 있어요?",shape=box,color=red];
		j3089405503 -> j209496551;
	j1269878070 [label="오, 이런... ",shape=box,color=red];
		j1269878070 -> j2670512932;
	j113736232 [label="뭐라고요?!",shape=box,color=red];
		j113736232 -> j2670512932;
	j209496551 [label="로터스와 오퍼레이터는 신경써야 할 다른 문제들이 있습니다. 믿어주십시오. 그들은 이미 한계에 다다를 정도로 부담을 지고 있습니다. 제가 도움을 구할 곳이 따로 있었다면 이런 문제로 당신에게 도움을 요청하지 않았을 겁니다.",shape=box,color=blue];
		j209496551 -> j3758381493;
	j2670512932 [label="제가 도움을 구할 곳이 따로 있었다면 이런 문제로 당신에게 도움을 요청하지 않았을 겁니다. 당신은... 이런 종류의 문제에 대해선 새로운 전문가인듯 하니까요.",shape=box,color=blue];
		j2670512932 -> j3706432449;
	j3758381493 [label="당신은... 이런 종류의 문제에 대해선 새로운 전문가인듯 하니까요.",shape=box,color=blue];
		j3758381493 -> j3706432449;
	j3706432449 [label="어찌 설명해 드려야 할지 잘 모르겠군요. 하지만 성역에 오시면 그분들을 놓치기 어려우실 거라고 생각이 듭니다. 두 분은 POM-2에서 당신과 대화하기로 하셨고, 한 분은 좀 더 설득이 필요할 것 같습니다.",shape=box,color=blue];
		j3706432449 -> j47487047;
	j47487047 [label="전... 당신이... 성공하리라 믿습니다.",shape=box,color=blue];
		j47487047 -> j3173882;
	j3173882 [label="Boolean LoidTriadAvailable is now true.",color=orange];
		j3173882 -> "Chat ends. Next chat will be LoidFamily.";
	"Chat ends. Next chat will be LoidFamily." [color=orange];
}