		19 -> 20 [label="MarieFamilySuccess, LyonFamilySuccess, RoatheFamilySuccess",color=purple];
		19 -> 21 [label="false",color=purple];
	20 [label="드리프터. 당신이 이겼습니다. 로스, 마리, 리온이 마침내 때가 왔다고 설득하더군요.",shape=box,color=blue];
		20 -> 22;
	21 [label="Chat ends.",color=orange];
	22 [label="제가 해야 할 일들이 떠올라서 뼛속까지 두렵네요. 고마이트루님과 가족분들이 그동안 발밑에서 무슨 일이 벌어지고 있었는지 알게 되셨을 때, 분노에 휩싸여서 사지를 찢어낼 때, 어쩌면 그 잘리는 게 제 것이 될지도 모르겠군요.",shape=box,color=blue];
		22 -> 23;
	23 [label="지금은 그 이름으로 그분을 부르는 게 너무나 낯설지만, 우리 사이는 정말 많은 것들이 변했습니다. 그리고 머지않아 더 많은 것들이 변하겠네요.",shape=box,color=blue];
		23 -> 24;
		23 -> 25;
	24 [label="한참 전에 해결했어야 할 일이에요. 로이드는 괜찮을 거에요.",shape=box,color=red];
		24 -> 26;
	25 [label="해내실 수 있을 거에요.",shape=box,color=red];
		25 -> 26;
	26 [label="네, 그럼. 부디 직접 오셔서 제 내장이 네크랄리스크 축제용 장식으로 사용되지 않도록 확인해 주시겠습니까? 어쨌든 지금은 위로가 좀 필요하니까요.",shape=box,color=blue];
		26 -> 27;
	27 [label="Update boolean LoidFamilyComplete",color=orange];
		27 -> 28;
	28 [label="Chat ends.",color=orange];
}