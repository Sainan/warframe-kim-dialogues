	j3233694762 [label="드리프터. 당신이 이겼습니다. 로스, 마리, 리온이 마침내 때가 왔다고 설득하더군요.",shape=box,color=blue];
		j3233694762 -> j1146213250;
	"Chat ends." [color=orange];
	j1146213250 [label="제가 해야 할 일들이 떠올라서 뼛속까지 두렵네요. 고마이트루님과 가족분들이 그동안 발밑에서 무슨 일이 벌어지고 있었는지 알게 되셨을 때, 분노에 휩싸여서 사지를 찢어낼 때, 어쩌면 그 잘리는 게 제 것이 될지도 모르겠군요.",shape=box,color=blue];
		j1146213250 -> j832945944;
	j832945944 [label="지금은 그 이름으로 그분을 부르는 게 너무나 낯설지만, 우리 사이는 정말 많은 것들이 변했습니다. 그리고 머지않아 더 많은 것들이 변하겠네요.",shape=box,color=blue];
		j832945944 -> j1546135188;
		j832945944 -> j3766502607;
	j1546135188 [label="한참 전에 해결했어야 할 일이에요. 로이드는 괜찮을 거에요.",shape=box,color=red];
		j1546135188 -> j586622894;
	j3766502607 [label="해내실 수 있을 거에요.",shape=box,color=red];
		j3766502607 -> j586622894;
	j586622894 [label="네, 그럼. 부디 직접 오셔서 제 내장이 네크랄리스크 축제용 장식으로 사용되지 않도록 확인해 주시겠습니까? 어쨌든 지금은 위로가 좀 필요하니까요.",shape=box,color=blue];
		j586622894 -> j937202740;
