digraph {
	1898 [label="QuincyAmirNightmares begins.",color=orange];
		1898 -> 1897;
	1897 [label="야",shape=box,color=blue];
		1897 -> 1888;
	1888 [label="네가 말한 그거. 작은 속도광 자식이랑 얘기했다",shape=box,color=blue];
		1888 -> 1901;
		1888 -> 1899;
		1888 -> 1904;
	1901 [label="어떻게 됐어?",shape=box,color=red];
		1901 -> 1900;
	1899 [label="와우. 정말 내 말 들어준거야?",shape=box,color=red];
		1899 -> 1902;
	1904 [label="나 뭔가 하는 중이야, 미안. [종료.]",shape=box,color=red];
		1904 -> 1903;
	1900 [label="그 자식은 처음에 내가 자기 얼굴에 죽빵 날릴거라고 생각했대 ㅋㅋㅋㅋ 근데 내가 걔 지붕으로 데려갔고 우린 앉아서 담소나 좀 나눴지",shape=box,color=blue];
		1900 -> 1905;
	1902 [label="입 싸 물고 내가 말할 수 있게 좀 냅둬 줘라, 응?",shape=box,color=blue];
		1902 -> 1900;
	1903 [label="Chat ends.",color=orange];
	1905 [label="걔가 그런 악몽 꾸는 거 내가 어떻게 알았는 지 알려줬어. 걔가 괜찮지 않다는 걸 어떻게 알아챘는지 말이야",shape=box,color=blue];
		1905 -> 1907;
		1905 -> 1906;
	1907 [label="그래서?",shape=box,color=red];
		1907 -> 1908;
	1906 [label="아미르가 뭐라 그랬는데?",shape=box,color=red];
		1906 -> 1908;
	1908 [label="처음엔 말이 없었어",shape=box,color=blue];
		1908 -> 1909;
	1909 [label="스스로가 되게 부끄러운 듯한 표정으로 앉아만 있더라",shape=box,color=blue];
		1909 -> 1910;
	1910 [label="아마 내가 그걸로 놀릴거라고 생각했겠지",shape=box,color=blue];
		1910 -> 1911;
	1911 [label="솔직히 말해서 그 자식 놀란 모습 보고 있자니, 그렇게 했어야 했나 끌리긴 하더라고",shape=box,color=blue];
		1911 -> 1912;
	1912 [label="그래서... 내가 처음으로 누군가를 죽여야 했던 때에 대해서 이야기 했어. 처음으로 내가 스코프로 현장을 내려다 보고 누군가의 생명을 앗아간 때",shape=box,color=blue];
		1912 -> 1893;
	1893 [label="한참 전쟁 중일 때 첫 번째로 보이는 건... 무장한 낯선 존재가 다가오는거야...",shape=box,color=blue];
		1893 -> 1913;
	1913 [label="완전히 다른 점은, 네가 대략적으로 274m 떨어진 지붕에 있고, 네가 거기 있다는 걸 다른 사람들은 전혀 모른다면 상황은 완전히 달라지지...",shape=box,color=blue];
		1913 -> 1914;
	1914 [label="그리고 그 사람들에 대해 *생각*할 시간을 가지게 되지. 누구였을까, 왜 거기 있었을까. 가족은 있었을까? 애들은 있었을까?",shape=box,color=blue];
		1914 -> 1931;
	1931 [label="그리고... 방아쇠를 당기는 거야. 탕",shape=box,color=blue];
		1931 -> 1928;
	1928 [label="지금은 상관없는 일이야",shape=box,color=blue];
		1928 -> 1889;
	1889 [label="그 사람들 죽었어, 그리고 내가 그 목숨 앗아간거야",shape=box,color=blue];
		1889 -> 1892;
	1892 [label="그리고 그 얼굴들이 내 머릿속에 남는 거야",shape=box,color=blue];
		1892 -> 1915;
	1915 [label="그 뒤로 죽인 사람들도 마찬가지고",shape=box,color=blue];
		1915 -> 1896;
		1915 -> 1930;
	1896 [label="아미르가 어떻게 반응했어...?",shape=box,color=red];
		1896 -> 1916;
	1930 [label="그거... 고양되는 이야기네.",shape=box,color=red];
		1930 -> 1916;
	1916 [label="엄청 긴 시간동안 아무 말도 하지 않았어. 우린 그저 침묵 속에 앉아만 있었지",shape=box,color=blue];
		1916 -> 1927;
	1927 [label="그러더니 걔가... 본인이 겪고 있는 악몽에 대해 말해줬어",shape=box,color=blue];
		1927 -> 1894;
	1894 [label="그리고 자기가 군인이 아니여서 스스로가 그룹 내에서 일원이 아닌 것처럼 느낀다는 점도",shape=box,color=blue];
		1894 -> 1890;
	1890 [label="그래서 걔한테 내가 겪던 악몽들에 대해 얘기해줬어. 내가 꼬마 때 꿨던 악몽 말이야",shape=box,color=blue];
		1890 -> 1891;
	1891 [label="그리고 그 자식한테 사과도 했어. 이제까지 널 너무 하대해서 미안하다고 말이야",shape=box,color=blue];
		1891 -> 1895;
	1895 [label="그리고 걔가 다른 애들과 마찬가지로 우리한테도 속해있다는 점, 그리고 내 방식이 따로 있는 것처럼 그 너한테도 나름의 방식이 있다는 점, 그리고 그게 바로 우리라는 점, 그런 이야기들?",shape=box,color=blue];
		1895 -> 1929;
	1929 [label="... 그 자식이 그거 듣고 뭐랬는 줄 아냐?",shape=box,color=blue];
		1929 -> 1926;
		1929 -> 1925;
	1926 [label="뭐랬는데?",shape=box,color=red];
		1926 -> 1922;
	1925 [label="모르겠는데?",shape=box,color=red];
		1925 -> 1922;
	1922 [label="\"네 말이 맞아. 너 완전 개자식이야\"",shape=box,color=blue];
		1922 -> 1920;
	1920 [label="그래서 내가 그 자식 지붕에서 밀어 벌이려는 순간?",shape=box,color=blue];
		1920 -> 1921;
	1921 [label="걔가 나 안아주더라. 빌어먹을정도로 꼭 안아줬어. 그러더니 '그치만 넌 내 큰 형이기도 하잖아'",shape=box,color=blue];
		1921 -> 1923;
	1923 [label="이뭐씨",shape=box,color=blue];
		1923 -> 1924;
	1924 [label="근데... 아니다. 해볼만 했어. 걔한텐 뭔가 의미가 있었던 것 같기도, 진짜로 말이야... 그리고... 나한테도 뭔가 의미가 있었던 것 같기도 해. 내 생각엔",shape=box,color=blue];
		1924 -> 1918;
	1918 [label="+20 Chemistry",color=orange];
		1918 -> 1919;
	1919 [label="그러니... 고맙다",shape=box,color=blue];
		1919 -> 1917;
	1917 [label="Chat ends.",color=orange];
}