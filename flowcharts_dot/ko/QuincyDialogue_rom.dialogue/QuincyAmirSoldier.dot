digraph {
	1845 [label="QuincyAmirSoldier begins.",color=orange];
		1845 -> 1846;
	1846 [label="야",shape=box,color=blue];
		1846 -> 1847;
	1847 [label="네가 말한 그거. 작은 속도광 자식이랑 얘기했다",shape=box,color=blue];
		1847 -> 1850;
		1847 -> 1848;
		1847 -> 1853;
	1850 [label="어떻게 됐어?",shape=box,color=red];
		1850 -> 1849;
	1848 [label="와우. 정말 내 말 들어준거야?",shape=box,color=red];
		1848 -> 1851;
	1853 [label="나 뭔가 하는 중이야, 미안. [종료.]",shape=box,color=red];
		1853 -> 1852;
	1849 [label="그 자식은 처음에 내가 자기 얼굴에 죽빵 날릴거라고 생각했대 ㅋㅋㅋㅋ 근데 내가 걔 지붕으로 데려갔고 우린 앉아서 담소나 좀 나눴지",shape=box,color=blue];
		1849 -> 1854;
	1851 [label="입 싸 물고 내가 말할 수 있게 좀 냅둬 줘라, 응?",shape=box,color=blue];
		1851 -> 1849;
	1852 [label="Chat ends.",color=orange];
	1854 [label="내가 군에 입대했을 때랑 내가 어떻게 저격수가 되었는 지에 대해서 말이야",shape=box,color=blue];
		1854 -> 1856;
		1854 -> 1855;
	1856 [label="그러고보니, *어떻게* 저격수가 된거야?",shape=box,color=red];
		1856 -> 1857;
	1855 [label="그래서?",shape=box,color=red];
		1855 -> 1858;
	1857 [label="지금 그게 중요한게 아니잖아",shape=box,color=blue];
		1857 -> 1858;
	1858 [label="내가 처음으로 누군가를 죽여야 했던 때에 대해서 이야기 해줬어",shape=box,color=blue];
		1858 -> 1859;
	1859 [label="처음으로 내가 스코프로 현장을 내려다 보고 누군가의 생명을 앗아간 때",shape=box,color=blue];
		1859 -> 1860;
	1860 [label="한참 전쟁 중일 때 첫 번째로 보이는 건... 무장한 낯선 존재가 다가오는거야...",shape=box,color=blue];
		1860 -> 1861;
	1861 [label="완전히 다른 점은, 네가 대략적으로 274m 떨어진 지붕에 있고, 네가 거기 있다는 걸 다른 사람들은 전혀 모른다면 상황은 완전히 달라지지...",shape=box,color=blue];
		1861 -> 1864;
	1864 [label="그리고 그 사람들에 대해 *생각*할 시간을 가지게 되지. 누구였을까, 왜 거기 있었을까. 가족은 있었을까? 애들은 있었을까?",shape=box,color=blue];
		1864 -> 1862;
	1862 [label="그리고... 방아쇠를 당기는 거야. 탕",shape=box,color=blue];
		1862 -> 1863;
	1863 [label="지금은 상관없는 일이야",shape=box,color=blue];
		1863 -> 1865;
	1865 [label="그 사람들 죽었어, 그리고 내가 그 목숨 앗아간거야",shape=box,color=blue];
		1865 -> 1866;
	1866 [label="그리고 그 얼굴들이 내 머릿속에 남는 거야",shape=box,color=blue];
		1866 -> 1867;
	1867 [label="그 뒤로 죽인 사람들도 마찬가지고",shape=box,color=blue];
		1867 -> 1868;
		1867 -> 1869;
	1868 [label="아미르가 어떻게 반응했어...?",shape=box,color=red];
		1868 -> 1871;
	1869 [label="그거... 고양되는 이야기네.",shape=box,color=red];
		1869 -> 1871;
	1871 [label="엄청 긴 시간동안 아무 말도 하지 않았어. 우린 그저 침묵 속에 앉아만 있었지",shape=box,color=blue];
		1871 -> 1877;
	1877 [label="그러더니 걔가... 본인이 겪고 있는 악몽에 대해 말해줬어",shape=box,color=blue];
		1877 -> 1874;
	1874 [label="그리고 자기가 군인이 아니여서 스스로가 그룹 내에서 일원이 아닌 것처럼 느낀다는 점도",shape=box,color=blue];
		1874 -> 1872;
	1872 [label="그래서 내가 군인으로서 처음으로 2명을 사살했을 때 얼마나 무서웠는 지에 대해서도 얘기해줬어",shape=box,color=blue];
		1872 -> 1873;
	1873 [label="그리고 내가 어떻게 그 일들로 악몽을 꾸게 되었는지 말이야, 내가 꼬마 때 꿨던 것보다 더 심한 악몽들이었어",shape=box,color=blue];
		1873 -> 1875;
	1875 [label="그리고 그 자식한테 사과도 했어. 이제까지 널 너무 하대해서 미안하다고 말이야",shape=box,color=blue];
		1875 -> 1876;
	1876 [label="그리고 걔가 다른 애들과 마찬가지로 우리한테도 속해있다는 점, 그리고 내 방식이 따로 있는 것처럼 그 너한테도 나름의 방식이 있다는 점, 그리고 그게 바로 우리라는 점, 그런 이야기들?",shape=box,color=blue];
		1876 -> 1870;
	1870 [label="... 그 자식이 그거 듣고 뭐랬는 줄 아냐?",shape=box,color=blue];
		1870 -> 1878;
		1870 -> 1879;
	1878 [label="뭐랬는데?",shape=box,color=red];
		1878 -> 1882;
	1879 [label="모르겠는데?",shape=box,color=red];
		1879 -> 1882;
	1882 [label="\"네 말이 맞아. 너 완전 개자식이야\"",shape=box,color=blue];
		1882 -> 1884;
	1884 [label="그래서 내가 그 자식 지붕에서 밀어 벌이려는 순간?",shape=box,color=blue];
		1884 -> 1883;
	1883 [label="걔가 나 안아주더라. 빌어먹을정도로 꼭 안아줬어. 그러더니 '그치만 넌 내 큰 형이기도 하잖아'",shape=box,color=blue];
		1883 -> 1881;
	1881 [label="이뭐씨",shape=box,color=blue];
		1881 -> 1880;
	1880 [label="근데... 아니다. 해볼만 했어. 걔한텐 뭔가 의미가 있었던 것 같기도, 진짜로 말이야... 그리고... 나한테도 뭔가 의미가 있었던 것 같기도 해. 내 생각엔",shape=box,color=blue];
		1880 -> 1886;
	1886 [label="+20 Chemistry",color=orange];
		1886 -> 1885;
	1885 [label="그러니... 고맙다",shape=box,color=blue];
		1885 -> 1887;
	1887 [label="Chat ends.",color=orange];
}