digraph {
	2657 [label="QuincyTomorrow begins.",color=orange];
		2657 -> 2658;
		2657 -> 2659;
	2658 [label="그래서. 그 내일이 되버렸는데. 이제 \"헥스에 어떻게 합류하게 되었는지\" 에 대해서 대화할 수 있는 거야?",shape=box,color=red];
