		3067 -> 3065;
	3065 [label="그리고 이제... 이제 이 개자식 - 이 개자식 - 과 이제 그 자식한테 무슨 일이 일어나는 지를 신경 써야 한다고!",shape=box,color=blue];
		3065 -> 3064;
