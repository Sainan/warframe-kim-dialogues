		j3870760305 -> "Chat ends.";
	j1258017675 [label="너랑 중요한 이야기를 하고 싶은데, 괜찮은지 확인하고 싶어.",shape=box,color=red];
		j1258017675 -> j385337785;
	j385337785 [label="중요한 점은 내가 너에게 거짓말을 하거나 어떤 식으로든 정직하지 않게 대하는 것처럼 느껴지지 않도록 하는 거야.",shape=box,color=red];
		j385337785 -> j2019006518;
	j2019006518 [label="웃겨 뒤지겠네 너 뭐하냐",shape=box,color=blue];
		j2019006518 -> j3401356536;
	j3401356536 [label="누굴 죽였냐, 전하께서 돌아가셨냐?",shape=box,color=blue];
		j3401356536 -> j1037989528;
	j1037989528 [label="아니! 아니야. 아서는 살아있어. 그냥 불편한 상황이 아니었으면 하는 얘기를 하고 싶었을 뿐이야.",shape=box,color=red];
		j1037989528 -> j3516921970;
	j3516921970 [label="네가 싫어하는 상황에 놓이게 만들고 싶지 않아. 그러니 거절해도 괜찮아. 단지 이 점을 알아줬으면 좋겠어.",shape=box,color=red];
		j3516921970 -> j3501058354;
	j3501058354 [label="우리의 관계는 나에게 중요해 - 그것도 아주 많이 중요해 - 그리고 진심이야. 그걸 의심하지 않았으면 해.",shape=box,color=red];
		j3501058354 -> j1148984836;
	j1148984836 [label="Check boolean QuincyForgiven",color=orange];
		j1148984836 -> j1501446994 [label=true,color=green];
		j1148984836 -> j963433398 [label=false,color=brown];
	j1501446994 [label="오오 젠장 자기야, 지금 딴 동네에서 딴 사랑에 빠졌다고 말할려는 거지?",shape=box,color=blue];
		j1501446994 -> j898120515;
	j963433398 [label="오오 젠장 자기야, 지금 딴 동네에서 딴 게임에 빠졌다고 말할려는 거지?",shape=box,color=blue];
		j963433398 -> j263578351;
	j898120515 [label="상황이 너무 심각해지기 전에 동의를 구하는 것에 대해서 이야기하고 싶었어. 화나지 않았길 바라고 우리가 한 번도 이런 얘길해 본 적이 없으니까.",shape=box,color=red];
		j898120515 -> j2665468222;
	j263578351 [label="상황이 너무 심각해지기 전에 동의를 구하는 것에 대해서 이야기하고 싶었어. 화나지 않았길 바라고 우리가 한 번도 이런 얘길해 본 적이 없으니까.",shape=box,color=red];
		j263578351 -> j3263641187;
	j2665468222 [label="이 몸께서 화났다고 누가 그러든? 아니야 자기야 난 어떻게하면 핑크 머리가 날 다른 시간대로 버스 태워다 줄 수 있는지 알아내려고 노력하는 중이라고 ㅋㅋㅋㅋㅋㅋ",shape=box,color=blue];
		j2665468222 -> j702961767;
	j3263641187 [label="아니야! 아니, 누군진 몰라도 놀 줄 아는 상대에겐 존경심을 표해야지",shape=box,color=blue];
		j3263641187 -> j4243627709;
	j702961767 [label="아니 하지만 뭔 일인진 알겠어. 어떤 건지 알아. 가끔은 사랑에 푹 빠지고 그대로 다른 사랑에 푹 빠진다는 거니까, 이건 그냥 네가 그럴 수 있다는 심장을 가지고 있다는 뜻이다. 부끄러워할 거 없어",shape=box,color=blue];
		j702961767 -> j1444588695;
	j4243627709 [label="아니 하지만 뭔 일인진 알겠어. 어떤 건지 알아. 가끔은 어딘가에 푹 빠지고 그대로 다른 쪽에 푹 빠진다는 거니까, 이건 그냥 네가 그럴 수 있다는 심장을 가지고 있다는 뜻이다. 부끄러워할 거 없어",shape=box,color=blue];
		j4243627709 -> j1039894267;
	j1444588695 [label="+20 Chemistry",color=orange];
		j1444588695 -> j2396449772;
	j1039894267 [label="+20 Chemistry",color=orange];
		j1039894267 -> j517662931;
	j2396449772 [label="우리 사이가 아직 진짜라고 말한다면, 난 널 믿는다",shape=box,color=blue];
		j2396449772 -> j1333213653;
	j517662931 [label="우리 사이가 아직도 잘 유지되고 있다고 말한다면, 난 널 믿는다",shape=box,color=blue];
		j517662931 -> j1333213653;
	j1333213653 [label="헥스나 원탁을 볼 때 얼굴에 이상한 표정 짓지 않는 것이 좋을 거다",shape=box,color=blue];
		j1333213653 -> j2041221370;
	j2041221370 [label="제발, 헥스는 안된다. 그러면 나 제대로 미칠 거라고",shape=box,color=blue];
		j2041221370 -> j3870760305;
}