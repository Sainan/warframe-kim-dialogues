		3875 -> 3878;
	3876 [label="그냥 걔한테 이런 말 하지마 해버리면 내가 널 벽 넘어서 쏴버릴테니까 ㅋㅋㅋㅋ",shape=box,color=blue];
		3876 -> 3879;
