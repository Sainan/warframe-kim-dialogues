	j1382110341 [label="벨리미르에 대해서 어떻게 생각해?",shape=box,color=red];
		j1382110341 -> j2878122650;
	j3167850005 [label="필요없지 않냐? 아오이는 아오이니까. 걘 부서지지 않는 인간도 아니지만 문제가 될 일도 없는 인간이지",shape=box,color=blue];
		j3167850005 -> j680321679;
	j2878122650 [label="하하아아아아",shape=box,color=blue];
		j2878122650 -> j11169687;
	j680321679 [label="걘 스스로가 누구인지 잘 알고 있고, 스스로를 어떻게 잘 다루어야 하는지도 알지",shape=box,color=blue];
		j680321679 -> j1211527989;
	j11169687 [label="난 스스로가 누구인지를 정확히 알고 그 점을 하나도 신경쓰지 않는 남자 정말 좋아한다고, 친구야",shape=box,color=blue];
		j11169687 -> j3374628318;
	j1211527989 [label="그리고 걔는 첫날부터 내가 어떤 인간인지 알아차렸다고 ㅋㅋㅋㅋㅋ",shape=box,color=blue];
		j1211527989 -> j2193336982;
	j3374628318 [label="대장님도 그 양반한테 한 두개 정도 배웠음 하네",shape=box,color=blue];
		j3374628318 -> j1837573493;
	j2193336982 [label="처음엔 이 몸을 긴장하게 만들더라고. 걔가 날 \"고치거나\" 뭔가를 할거라고 생각했다",shape=box,color=blue];
		j2193336982 -> j1243545288;
	j1837573493 [label="그 양반은 날 \"롱샷 맥익스트림리브리태닉\"이라고 불렀지만 ",shape=box,color=blue];
		j1837573493 -> j3767800504;
	j1243545288 [label="하지만 아니였어. 이해해준 거지. 어떤 면에선 걘 내 큰 누나 같다",shape=box,color=blue];
		j1243545288 -> j2007330242;
	j3767800504 [label="... 이 몸은 그렇게 브리타닉이지도 않은데 말이지?",shape=box,color=blue];
