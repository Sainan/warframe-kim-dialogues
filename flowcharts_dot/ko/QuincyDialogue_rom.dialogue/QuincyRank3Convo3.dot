	1359 [label="+20 Chemistry",color=orange];
		1359 -> 1358;
	1361 [label="왠지는 모르지만 그거에 등 보이면 안될 것 같다. 걔가 아직도 엔트라티를 위해서 뭔가 하고 있는게 아닐까 뭐 그런걸 걱정해야 하나?",shape=box,color=blue];
		1361 -> 1364;
		1361 -> 1363;
	1362 [label="그래서 내가 아는 한, 칼리모스는 카밧으로서, 이 세계의 더 작은 \"고양이\"로부터 진화한 존재야.",shape=box,color=red];
		1362 -> 1365;
	1363 [label="내 생각엔, 칼리모스가 엔트라티의 헛소리에 지쳤다고 생각해. 다른 많은 사람들처럼.",shape=box,color=red];
		1363 -> 1369;
	1364 [label="그게 가능한가? 내 말은, 쟨 카밧이잖아. 쟤넨 항상 *약간* 엉뚱하다고, 안 그래? ㅋㅋㅋ",shape=box,color=red];
		1364 -> 1370;
