digraph {
	1351 [label="QuincyRank3Convo3 begins.",color=orange];
		1351 -> 1352;
	1352 [label="그럼... 그 크고 털없는 이상한 고양이 괴물은 뭐야?",shape=box,color=blue];
		1352 -> 1353;
