		1374 -> 1376 [label=false,color=brown];
	1373 [label="친절하게 놀아주고 귀엽고 부드럽게 대해주니 골골골골골 거리고 좋아하고 그래서 이제 안전하다고 생각했을 때... 면상에 발톱먹었다고, 친구야.",shape=box,color=blue];
		1373 -> 1380;
	1375 [label="그 고양이는 레티가 나한테 말해준 카비아와 같은 존재들 아니냐? 레티가 카비아 이야기로 엄청 울었어. 그리고 그렇게 화난 모습 정말 간만에 보기도 했고.",shape=box,color=blue];
		1375 -> 1378;
		1375 -> 1379;
	1376 [label="으음... 엔트라티가 이전에 인간 지능의 수준을 가진 동물들을 만들긴 했어. 하지만 보통은 대화를 나누는 정도야.",shape=box,color=red];
		1376 -> 1377;
	1380 [label="고양이들. 걔들 항상 놀라면 눈알부터 노린다니까",shape=box,color=blue];
		1380 -> 1382;
		1380 -> 1383;
	1378 [label="내 생각엔 걔는 우리만큼 똑똑한 것 같아. 그냥 쿨하게 행동하고 있을 뿐. 그렇다고 해서 걔랑 싸우진 않을 거야, 나도 체면이란 게 있으니까",shape=box,color=red];
		1378 -> 1381;
	1379 [label="칼리모스가 걔네 중 하나였으면, 지금쯤 우리에게 알려줬을거야... 안 그래?",shape=box,color=red];
		1379 -> 1381;
	1377 [label="걔들을 카비아라고 불러. 하지만 칼리모스가 걔네 중 하나였으면, 지금쯤 우리에게 알려줬을거야... 안 그래?",shape=box,color=red];
		1377 -> 1381;
	1382 [label="그래도 난 카밧들 좋아해, 똑똑하고, 우아하니까. 걔들이 우릴 사랑하는 건 *걔들이* 선택했기 때문이야. 쿠브로 -개들, 미안- 은 그런 식이 되도록 훨씬 더 학습화되어 있어.",shape=box,color=red];
		1382 -> 1385;
	1383 [label="나도 너랑 동감이야. 난 쿠브로 -미안, 개야- 사람이거든.",shape=box,color=red];
		1383 -> 1384;
	1381 [label="ㅋㅋㅋ 내가 전에 사겼던 인간들 중 한 명 같네",shape=box,color=blue];
		1381 -> 1389;
	1385 [label="고양이들은 항상 뭔가를 꾸미고 있다고",shape=box,color=blue];
		1385 -> 1386;
	1384 [label="개들은 항상 널 만나서 행복해해. 그저 사랑을 원한다고",shape=box,color=blue];
		1384 -> 1385;
	1389 [label="걘 항상 이렇게 수줍은 척 해. 골골골 거리면서. 그리고 가장 예상치 못했을 때...? 살육을 시작하는거지. 모두가 걔를 과소평가하고 있어.",shape=box,color=blue];
		1389 -> 1390;
	1386 [label="그리고 그 괴물 고양이가 지금은 잘 행동하고 있지만, 걔 뭐 꾸미고 있는 것 같다고",shape=box,color=blue];
		1386 -> 1387;
		1386 -> 1388;
	1390 [label="두 번이나 그런 실수는 반복하지 않을 거야. 사람한테도, 거대한 괴물 고양이한테도.",shape=box,color=blue];
		1390 -> 1391;
	1387 [label="나도 잘 모르겠어. 이용당하고 버려지는 게 어떤 건지는 나도 아니까. 걔가 머물고 싶어 한다면? 따뜻한 침대랑 걔가 원하는 만큼 긁어줄 거야",shape=box,color=red];
		1387 -> 1397;
