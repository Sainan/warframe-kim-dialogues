		1365 -> 1366;
	1369 [label="그러니까 쟤는 보통 고양이보다 더 똑똑하다는 뜻이잖아.",shape=box,color=blue];
		1369 -> 1372;
	1370 [label="이게 바로 내가 개를 좋아하는 이유라고, 알겠냐? 고양이가 아무리 널 사랑한다고 해도, 넌 절대 걔들을 믿을 수 없지",shape=box,color=blue];
		1370 -> 1371;
	1360 [label="Chat ends.",color=orange];
