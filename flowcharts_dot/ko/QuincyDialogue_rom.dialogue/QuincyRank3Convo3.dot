		1353 -> 1356;
	1354 [label="걔가 큰 고양이 괴물인 걸 묻는거야, 아니면 그 애에 대해서 묻는 거야?",shape=box,color=red];
		1354 -> 1357;
	1355 [label="바로 돌아올게, 그 크고 털없는 이상한 고양이 밥 먹일 시간이라서. [종료.]",shape=box,color=red];
		1355 -> 1359;
	1356 [label="ㅋㅋㅋㅋ오 그거참 좋은 징조네. 너도 어찌해야 할지 모른다면, 우린 뭘 해야 하냐?",shape=box,color=blue];
		1356 -> 1361;
	1357 [label="뭐, 좋아. 이제 네가 그렇게 말한거다? ㅋㅋㅋㅋ 두 쪽 다 궁금함",shape=box,color=blue];
		1357 -> 1362;
		1357 -> 1363;
