		1366 -> 1367;
		1366 -> 1368;
	1372 [label="우리 지금 여기서 인간 수준의 지능에 대해서 이야기하고 있는 거지? 똑바로 말해봐",shape=box,color=blue];
		1372 -> 1374;
	1371 [label="우리집 할매는 가끔 나를 자기 친구 집에 두고 나갔는데. 친구분은 좋은 분이셨어. 진짜 미친 고양이를 키우셨거든.",shape=box,color=blue];
		1371 -> 1373;
	1367 [label="내 말은, *고양이*들은 항상 *약간* 엉뚱하다고, 안 그래? ㅋㅋㅋ",shape=box,color=red];
		1367 -> 1370;
