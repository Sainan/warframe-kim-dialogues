	852 [label="그렇게 말해주니 고맙다. 그치만 삶으로부터 날 보호해줄 필요는 없어. 난 그걸 충분히 봐왔어, 믿으라고. 네가 봐왔던 것만큼 거칠지는 않지만, 잔인할 뿐이야",shape=box,color=blue];
