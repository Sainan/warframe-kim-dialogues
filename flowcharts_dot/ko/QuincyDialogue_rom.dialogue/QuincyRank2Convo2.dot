		753 -> 754;
	747 [label="다른 거야, 사촌. 그냥 내가 누구를 미워해야하는 지 알고 싶었어. 그리고 언젠가 그 지랄맞은 새끼들 찾을 경우를 대비해서 말이야.",shape=box,color=blue];
		747 -> 751;
