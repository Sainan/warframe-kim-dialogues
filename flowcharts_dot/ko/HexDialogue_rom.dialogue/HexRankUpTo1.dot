		j1797308447 -> j26076608;
	j26076608 [label="H16h V0l7463: 뭐ㅓㅓㅓㅓ 그치. 하지만 거기 아서가 있으면 들어가지 말고 있어. 난 경고했다. 걔는혼자만의시간을너무좋아하니까...",shape=box,color=blue];
