		"HexRankUpTo1 begins." -> j928523782;
	j928523782 [label="Broadsword: 우린 이제 여기 갇힌 거다. 알았나? 그러니 청소 제대로 하고 다녀라. 푸드 코트가 길거리보다 더 더럽다. 무슨 빌어먹을 동물원도 아니고.",shape=box,color=blue];
		j928523782 -> j361254900;
