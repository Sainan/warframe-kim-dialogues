digraph {
	"ArthurRank6Convo8 begins." [color=orange];
		"ArthurRank6Convo8 begins." -> j769421586;
	j769421586 [label="참, 오늘 아침 무언가를 깨달은 참인데, 그러고 나니 웃음이 멈추질 않더군.",shape=box,color=blue];
		j769421586 -> j882966427;
		j769421586 -> j944443004;
	j882966427 [label="말해봐.",shape=box,color=red];
		j882966427 -> j2835695477;
	j944443004 [label="오? 뭔데?",shape=box,color=red];
		j944443004 -> j2835695477;
	j2835695477 [label="보댜노이는 전이가 어떻게 이루어지는지 전혀 아는 게 없다는 것. ",shape=box,color=blue];
		j2835695477 -> j2042005550;
	j2042005550 [label="놈에게 넌 클라크 켄트와 메가블로크 같은 걸 거다. 네 워프레임 중 둘이 한 장소에 있는 걸 본 적이 없을 테니까.",shape=box,color=blue];
		j2042005550 -> j3259419532;
	j3259419532 [label="그 녀석의 머릿속엔, 무슨...헥스와 함께 여기저기 미친듯이 날뛰고 돌아다니는 사이코 슈퍼 병사가 한 부대씩이나 있는 거야!",shape=box,color=blue];
		j3259419532 -> j1260114123;
		j3259419532 -> j2494309990;
	j1260114123 [label="그 자식이 알지 못하는 건 그 자식 본인에게 상처를 *줄 수 있다*, 이거지? <RETRO_EMOJI_COOLARMSUP>",shape=box,color=red];
		j1260114123 -> j1397271150;
	j2494309990 [label="ㅋㅋㅋㅋㅋㅋ!! 그런 생각은 해보지도 못했는데.",shape=box,color=red];
		j2494309990 -> j2765241957;
	j1397271150 [label="그래, 그거지. 그리고 그걸 굳이 내가 정정해 줄 생각은 없다.",shape=box,color=blue];
		j1397271150 -> j2959792848;
	j2765241957 [label="굳이 내가 그걸 정정해 줄 생각도 없다. 하지만 그놈 머릿속에선 지금 이 상황이 어떻게 돌아가고 있는지, 상상도 가지 않는군.",shape=box,color=blue];
		j2765241957 -> j2959792848;
	j2959792848 [label="놈이 그렇게까지 우리에게 피해망상을 갖는 것도 무리는 아닌 셈이야. 하! 그 한심한 자식이 거의 불쌍해질 정도로구만.",shape=box,color=blue];
		j2959792848 -> j4206897366;
	j4206897366 [label="뭐 정말 불쌍하다는 건 아니고.",shape=box,color=blue];
		j4206897366 -> "Chat ends.";
	"Chat ends." [color=orange];
}