digraph {
	3541 [label="ArthurRank6Convo8 begins.",color=orange];
		3541 -> 3542;
	3542 [label="참, 오늘 아침 무언가를 깨달은 참인데, 그러고 나니 웃음이 멈추질 않더군.",shape=box,color=blue];
		3542 -> 3543;
		3542 -> 3544;
	3543 [label="말해봐.",shape=box,color=red];
		3543 -> 3545;
	3544 [label="오? 뭔데?",shape=box,color=red];
		3544 -> 3545;
	3545 [label="보댜노이는 전이가 어떻게 이루어지는지 전혀 아는 게 없다는 것. ",shape=box,color=blue];
		3545 -> 3546;
	3546 [label="놈에게 넌 클라크 켄트와 메가블로크 같은 걸 거다. 네 워프레임 중 둘이 한 장소에 있는 걸 본 적이 없을 테니까.",shape=box,color=blue];
		3546 -> 3547;
	3547 [label="그 녀석의 머릿속엔, 무슨...헥스와 함께 여기저기 미친듯이 날뛰고 돌아다니는 사이코 슈퍼 병사가 한 부대씩이나 있는 거야!",shape=box,color=blue];
		3547 -> 3548;
		3547 -> 3549;
	3548 [label="그 자식이 알지 못하는 건 그 자식 본인에게 상처를 *줄 수 있다*, 이거지? <RETRO_EMOJI_COOLARMSUP>",shape=box,color=red];
		3548 -> 3550;
	3549 [label="ㅋㅋㅋㅋㅋㅋ!! 그런 생각은 해보지도 못했는데.",shape=box,color=red];
		3549 -> 3551;
	3550 [label="그래, 그거지. 그리고 그걸 굳이 내가 정정해 줄 생각은 없다.",shape=box,color=blue];
		3550 -> 3552;
	3551 [label="굳이 내가 그걸 정정해 줄 생각도 없다. 하지만 그놈 머릿속에선 지금 이 상황이 어떻게 돌아가고 있는지, 상상도 가지 않는군.",shape=box,color=blue];
		3551 -> 3552;
	3552 [label="놈이 그렇게까지 우리에게 피해망상을 갖는 것도 무리는 아닌 셈이야. 하! 그 한심한 자식이 거의 불쌍해질 정도로구만.",shape=box,color=blue];
		3552 -> 3553;
	3553 [label="뭐 정말 불쌍하다는 건 아니고.",shape=box,color=blue];
		3553 -> 3554;
	3554 [label="Chat ends.",color=orange];
}