digraph {
	3360 [label="ArthurRank6Convo3 begins.",color=orange];
		3360 -> 3361;
	3361 [label="언제던가, 그 기타와 이야기를 해 본 적이 있다.",shape=box,color=blue];
		3361 -> 3362;
		3361 -> 3363;
	3362 [label="난 개인적으로 그닥 좋아하진 않아, 그 녀석.",shape=box,color=red];
		3362 -> 3364;
	3363 [label="리지랑? 어떻게 됐어?",shape=box,color=red];
		3363 -> 3365;
	3364 [label="솔직히 말하자면, 난 오히려 마음에 들었다. 그 녀석의 그... 기묘한? 점만 익숙해 진다면 말이야.",shape=box,color=blue];
		3364 -> 3366;
	3365 [label="생각했던 것보다 낫더군. 오히려 마음에 들었다.",shape=box,color=blue];
		3365 -> 3366;
	3366 [label="게다가,",shape=box,color=blue];
		3366 -> 3367;
	3367 [label="그 기타와 엘레노어가 자기들밖에 듣지 못하는 농담을 나누면서 웃고 있는 것 같았으니 말이다.",shape=box,color=blue];
		3367 -> 3368;
	3368 [label="그러니 나도 제대로 자기 소개를 해 두는 게 좋겠다고 생각했지.",shape=box,color=blue];
		3368 -> 3369;
	3369 [label="그 기타, 쓸만한 통찰을 많이 갖추고 있더군. 거기에 플레어도 퍽 좋은 녀석이지. 솔직히, 바에 들어온 그 무리 전부가 신선한 청량제 같은 느낌이야. ",shape=box,color=blue];
		3369 -> 3370;
	3370 [label="뭐... 관용적으로 말하면 그렇단 말이다.",shape=box,color=blue];
		3370 -> 3371;
		3370 -> 3372;
		3370 -> 3373;
	3371 [label="벌써 헥스 대원들이 질려?",shape=box,color=red];
		3371 -> 3374;
	3372 [label="어떤 통찰이었는데?",shape=box,color=red];
		3372 -> 3375;
	3373 [label="친구가 생겼다니 기쁘다. ㅋㅋ ",shape=box,color=red];
		3373 -> 3376;
	3374 [label="뭐? 아니야! 당연히 아니지.",shape=box,color=blue];
		3374 -> 3377;
	3375 [label="흥미로운 이야기더군. 올해가 몇 번이나 루프했는지에 대한 이야기 말이야.",shape=box,color=blue];
		3375 -> 3378;
	3376 [label="그냥, 같이 뭘 겪은 게 그다지 없는 사람들이 얼마쯤 있어 종종 이야기를 나눌 수 있다는 것도 좋은 것 같더군.",shape=box,color=blue];
		3376 -> 3379;
	3377 [label="헥스는 내 가족이나 마찬가지다. 내 팀원들이야. 너도 잘 알잖나.",shape=box,color=blue];
		3377 -> 3376;
	3378 [label="내가 지난 올해들을 몇 번이나 잊어버렸거나, 혹은 기억하고 있을지. 그 기타가 그... 시간의 흐름 밖에 살고 있고? 우리는 그렇지 않다거나, 그런 것.",shape=box,color=blue];
		3378 -> 3380;
	3379 [label="말이 되는 소리긴 한 건지 모르겠군. 상대를 알고, 신뢰도 하지만, 함께 *지옥을 빠져나와 살아남은* 건 아닌, 그런 사이인 거다.",shape=box,color=blue];
		3379 -> 3381;
	3380 [label="그리고 먼저 말해두자면, 아니, 난 알고 싶지 않다. 내게 알 권리가 있는 것도 아니고.",shape=box,color=blue];
		3380 -> 3382;
	3381 [label="그래서 가끔 그저 함께 앉아 술 한 잔 걸치기만 하기도 훨씬 쉬워지지.",shape=box,color=blue];
		3381 -> 3383;
		3381 -> 3384;
		3381 -> 3385;
	3382 [label="그러니까, 내가 말하고 싶은 건 - 네가 그런 짓을 했건 아니건, 괜찮다는 거다. 그렇게 했다고 네게 앙심을 품거나 하진 않을 테니.",shape=box,color=blue];
		3382 -> 3386;
	3383 [label="난 그럴 만한 기회가 영 없었어.",shape=box,color=red];
		3383 -> 3387;
	3384 [label="그래, 알 것 같아.",shape=box,color=red];
		3384 -> 3388;
	3385 [label="그 중 몇 명은 나이가 좀 더 지긋하고, 군 생활 경험이 있다는 게 또 도움이 되는 점이려나.",shape=box,color=red];
		3385 -> 3389;
	3386 [label="우리가 지금 있는 이 상황 자체가 정상은 아니지. 이런 상황은 본래 우리 같은 - 그러니까 인간들이, 겪어야 할 일이 아닌 거다.",shape=box,color=blue];
		3386 -> 3390;
	3387 [label="아무래도 없었겠지.",shape=box,color=blue];
		3387 -> 3391;
	3388 [label="무게란 게 그렇게까지... 없는 거다. 서로 나눈 과거도 없고. 아미르라면 '짐'이라 부를, 그런 과거.",shape=box,color=blue];
		3388 -> 3391;
	3389 [label="솔 맙소사, 두 말하면 잔소리지. 그 리버타시아 인들을 어떻게 받아들여야 할지 처음엔 잘 알기 어려웠다. 하지만 지금은? 이 사람들이 있다는 게 참 다행이더군.",shape=box,color=blue];
		3389 -> 3391;
	3390 [label="그래서 따라야 할 지침도 뭣도 없어. 그러니 네가 뭘 하기로 하건, 네겐 뭔가 타당한 이유가 있어서 그런 거라고 난 믿기로 했다.",shape=box,color=blue];
		3390 -> 3392;
	3391 [label="하지만 그러다보니 생각을 하게 되더군.",shape=box,color=blue];
		3391 -> 3393;
