		3393 -> 3397;
	3394 [label="무슨 생각?",shape=box,color=red];
		3394 -> 3398;
	3396 [label="나는 널 사랑한다. 그리고 만약 내가 그걸 잊어버린다 해도, 네가 다른 길을 가기로 한다 해도, 다 괜찮아.",shape=box,color=blue];
		3396 -> 3400;
	3395 [label="난 네게 목숨까지 맡길 수 있을 정도로 믿는다. 그리고 그 무엇도 그 사실을 바꾸진 못할 거야. 설령 내가 한동안 그걸 잊어버린다 해도.",shape=box,color=blue];
		3395 -> 3399;
	3397 [label="하. 일단 들어는 봐라. 네 얘기지만.",shape=box,color=blue];
		3397 -> 3401;
	3398 [label="너. ",shape=box,color=blue];
		3398 -> 3401;
	3400 [label="여기서 널 만나기 전엔, 그런 걸 받아들일 수 있을 거라 생각하지도 못했어. 널 잃어버릴까봐, 지금 이 마음을 잃어버릴까봐 너무 두려웠을 거다.",shape=box,color=blue];
		3400 -> 3402;
	3399 [label="여기서 널 만나기 전엔, 그런 걸 받아들일 수 있을 거라 생각하지도 못했어. 나 자신의 일부를 잃어버린다는 게 너무 두려웠을 거다.",shape=box,color=blue];
		3399 -> 3402;
	3401 [label="그리고 끝없이 반복되는 이... 시간선 전체 말이다. 그러다 보니 나는 대체 몇 번의 1999년을 기억하지 못하고 사는 건지도, 생각하게 되더군.",shape=box,color=blue];
		3401 -> 3403;
		3401 -> 3404;
		3401 -> 3405;
	3402 [label="바다 위를 떠다니는 똇목에 절박하게 매달린 사람처럼, 목숨 걸고 매달렸겠지. 하지만 이만하면 이 루프도 겪을 만큼 겪은 건지, 아니면... 단순히 너 때문인지, ...모르겠다.",shape=box,color=blue];
		3402 -> 3406;
	3403 [label="그 기타가 뭐라 그랬건 다 중상모략이야. 진짜야. 맹세해.",shape=box,color=red];
		3403 -> 3407;
	3404 [label="나... 곧 혼나나?",shape=box,color=red];
		3404 -> 3407;
	3405 [label="그... 우리 이 얘기 하면 안 될 것 같은데, 아서.",shape=box,color=red];
		3405 -> 3407;
	3406 [label="지금 네가 내게 준 행복, 이 평온은, 영원히 이어질 지도 모른다는 기약을 얻는 것보다도 지금 이 순간 느끼는 게 더 가치 있어.",shape=box,color=blue];
		3406 -> 3408;
	3407 [label="말 끝날 때까지 좀 기다려 봐라. 내 타자가 너보다 느리단 건 알잖나.",shape=box,color=blue];
		3407 -> 3409;
	3408 [label="군인으로 사는 삶에서 배우는 게 있다면, 삶의 모든 것은 한 순간에 불과하다는 거다.",shape=box,color=blue];
		3408 -> 3410;
	3409 [label="내가 말하려는 건, 그러니까 이거다.",shape=box,color=blue];
		3409 -> 3411;
	3410 [label="한 순간 여기 있다고 느끼다 보면, 다음 순간엔 없지. 아무래도 나는 지금에서야 그걸 받아들이게 된 것 같다. 이번에야말로.",shape=box,color=blue];
		3410 -> 3412;
	3411 [label="네가 나건, 나머지 헥스 대원들이건, 우리가 나눴던 과거의 소통들을 잊어버리게 만들었다 해도, 다 괜찮다.",shape=box,color=blue];
		3411 -> 3413;
	3412 [label="그러니, 네가 바닥을 내려치고 내가 모든 걸 잊는 바람에 우리가 함께하는 시간이 끝난다 해도,",shape=box,color=blue];
		3412 -> 3414;
	3413 [label="그런다고 네게 원한을 갖거나 하진 않을 테니.",shape=box,color=blue];
		3413 -> 3386;
	3414 [label="혹은 언젠가 무심이 불시에 널 덮쳐 모든 게 끝난다 해도,",shape=box,color=blue];
		3414 -> 3415;
	3415 [label="난 지금 손 안에 쥔 이 순간을 즐길 거야. 여기, 지금 이 순간. 그것이야말로 내가 지금 가진 것이니까.",shape=box,color=blue];
		3415 -> 3416;
	3416 [label="그리고 그거야말로 내가 확신할 수 있는 어떤 것이라고, 나는 알 수 있어.",shape=box,color=blue];
		3416 -> 3417;
		3416 -> 3418;
		3416 -> 3419;
	3417 [label="딱히 개인적인 감정은 없어. 보통은 내가 네 누나랑 사귀어 보려다 망해서 일어나는 일이거든. :P",shape=box,color=red];
		3417 -> 3420;
	3418 [label="고마워, 아서... 지금 그거, 내가 표현할 수 있는 것보다도 내겐 훨씬 더 큰 의미야.",shape=box,color=red];
		3418 -> 3421;
	3419 [label="가끔은 내가 너 같은 침착함을 가졌다면 얼마나 좋았을까, 생각하곤 해. <3",shape=box,color=red];
		3419 -> 3422;
	3420 [label="하. 하. 뭐, 아무리 헛다리를 성대하게 짚다 못해 자기 목구멍에 꽂아 넣어도 곧장 빼낼 수 있는 초능력 마술의 힘이 있으니, 참 좋긴 하겠구만?",shape=box,color=blue];
		3420 -> 3423;
	3421 [label="때때론 나도 이렇게 정신줄을 제대로 잡아서, 뭐라도 의미 있는 말을 해 보려고 하는 법이다.",shape=box,color=blue];
		3421 -> 3424;
	3422 [label="실질적으로 내게 참고 견딘다는 것 외엔 선택지가 없다는 이유가 더 클 거다. 뭐, 브리타니아 사고방식이 그렇지. ",shape=box,color=blue];
		3422 -> 3425;
	3423 [label="이제 문제는 우리 모두가 소통하는 방법을 배워야겠다는 것 뿐이겠군. 아, 하나만 물어 보지.",shape=box,color=blue];
		3423 -> 3426;
	3424 [label="뭐, 한 잔 걸칠 때가 슬슬 된 것 같군. 갈까?",shape=box,color=blue];
		3424 -> 3427;
		3424 -> 3428;
	3425 [label="\"스스로를 가다듬고, 계속 앞으로 나아가라\" 는 옛 말처럼.",shape=box,color=blue];
		3425 -> 3424;
	3426 [label="시간을 돌릴 때마다 엘레노어의 기준이 좀 낮아지긴 하던가?",shape=box,color=blue];
		3426 -> 3429;
