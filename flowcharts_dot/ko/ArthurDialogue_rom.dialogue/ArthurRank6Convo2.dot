		j400383585 -> j304628891;
	j3749092022 [label="음음. 뭐, 날 잘 알잖나. 겉으론 바삭바삭 거칠어도, 속은 촉촉하고 물기가 많지. 아미르와 벨리미르가 끊임없이 들먹이는 그 끔찍한 페이스트리 과자의 상한 버전처럼.",shape=box,color=blue];
