digraph {
	"ArthurRank6Convo2 begins." [color=orange];
		"ArthurRank6Convo2 begins." -> j616102602;
	j616102602 [label="생각을 하고 있었다만. 우리 같은 이들이 앞으로 몇 명이나 더 있을 것 같나?",shape=box,color=blue];
