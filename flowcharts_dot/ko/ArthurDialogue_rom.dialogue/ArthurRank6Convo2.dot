		j4067442847 -> j1018077285;
		j4067442847 -> j1172724021;
	j1018077285 [label="카야가 자력으로 시간 여행에 성공했으니, 이제 나도 왔다갔다하는 게 좀 더 쉬워질지도 모르지.",shape=box,color=red];
		j1018077285 -> j1261063015;
