	1557 [label="우리가 무고한 사람들을 학살해야 했던 이유. 그 답을 요구하며 쫓아다녔더니, 장교는 나를 불명예 제대시키겠다고 위협했고.",shape=box,color=blue];
		1557 -> 1558;
	1558 [label="그냥 닥쳐라. 할 일이나 해. 총이나 쏘고. 착한 병사가 그러듯 죽이란 말이야.",shape=box,color=blue];
