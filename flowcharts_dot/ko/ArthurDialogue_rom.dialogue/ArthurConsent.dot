		j972778441 -> "Chat ends." [label=false,color=brown];
	j59646279 [label="아서, 대화 좀 할 수 있을까? [다수의 파트너가 있는 경우 동의를 구한다]",shape=box,color=red];
		j59646279 -> j2538511029;
	j1589253455 [label="[종료.]",shape=box,color=red];
		j1589253455 -> j3652224286;
	j2538511029 [label="언제든지. 무슨 문제라도 있나?",shape=box,color=blue];
		j2538511029 -> j2407079791;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j2407079791 [label="아니, 전혀 없어. 그냥 불편한 상황이 아니었으면 하는 얘기를 하고 싶었을 뿐이야.",shape=box,color=red];
		j2407079791 -> j3572139172;
	j3572139172 [label="네가 싫어하는 상황에 놓이게 만들고 싶지 않아. 이 문제를 우리가 전에는 이야기해 본 적이 없는 문제라는 것도 알고. 그러니 거절해도 괜찮아. 단지 이 점을 알아줬으면 좋겠어.",shape=box,color=red];
		j3572139172 -> j2900101427;
	j2900101427 [label="우리의 관계는 나에게 중요해 - 그것도 아주 많이 중요해 - 그리고 진심이야. 그걸 의심하지 않았으면 해.",shape=box,color=red];
		j2900101427 -> j259179852;
	j259179852 [label="아. 무슨 말 하려는 지 알겠군. 다른 사람에게도 마음이 끌린다는 얘기인가?",shape=box,color=blue];
		j259179852 -> j2440724079;
		j259179852 -> j618671337;
	j2440724079 [label="응. 이해하기 어려울 수도 있다는 거 알지만, 그렇다고 해서 너한테 덜 끌린다는 뜻이 아니니까.",shape=box,color=red];
		j2440724079 -> j3617004464;
	j618671337 [label="응. 하지만 지금 생각하니 우린 여기서 끝내는 게 나을 것 같아. [헤어진다.]",shape=box,color=red];
		j618671337 -> j2944338382;
	j3617004464 [label="내 사랑, 내가 군대에서 그리 오래 굴렀는데 온갖 종류의 관계를 보지 않았다고 생각하나?",shape=box,color=blue];
		j3617004464 -> j8656778;
	j2944338382 [label="그걸 네가 진심으로 원한다면...",shape=box,color=blue];
		j2944338382 -> j3701883258;
	j8656778 [label="인생의 많은 시간을 거의 죽을 뻔하며 보내다 보면 인생에서 무엇이 중요한지, 무엇이 중요하지 않은지 감사하게 되지.",shape=box,color=blue];
		j8656778 -> j1000453817;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j1000453817 [label="기준선에 대해 더 이상 의문을 품지 마라. 완전히 이해하니까.",shape=box,color=blue];
		j1000453817 -> j2823695628;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j2823695628 [label="중요한 점? 네가 나한테 소중한 존재라는 거다. 그리고 그 상대방도 너에게 소중하다면, 그쪽도 나에게 소중한 존재다.",shape=box,color=blue];
		j2823695628 -> j3796320344;
	j3796320344 [label="그냥. 그저. 헥스만 아니면 돼. 알았나? 이게 \"가족\"에게 해당하는 일이면 스스로도 감당할 수 없을 것 같으니까.",shape=box,color=blue];
		j3796320344 -> j115861435;
	j115861435 [label="그 생각만으로도 가위눌릴 것 같군.",shape=box,color=blue];
		j115861435 -> j2231753387;
		j115861435 -> j706509521;
	j2231753387 [label="ㅋㅋㅋ. 약속할게.",shape=box,color=red];
		j2231753387 -> j3689123715;
	j706509521 [label="내 생각엔, 네가 그 상대방을 정말 좋아할 것 같아.",shape=box,color=red];
		j706509521 -> j4123257176;
	j3689123715 [label="고맙다. 언젠가 그 상대방과 만날 수 있으면 좋겠군. 물론... 개인적인 이유로 말이다.",shape=box,color=blue];
		j3689123715 -> j2662699301;
	j4123257176 [label="언젠가 그 상대방과 만날 수 있으면 좋겠군. 물론... 개인적인 이유로 말이다.",shape=box,color=blue];
		j4123257176 -> j2662699301;
	j2662699301 [label="+20 Chemistry",color=orange];
		j2662699301 -> j1582779730;
	j1582779730 [label="스스로 잘 챙기면서 다녀라, 내 사랑.",shape=box,color=blue];
