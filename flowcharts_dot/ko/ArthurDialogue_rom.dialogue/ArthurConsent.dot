		j972778441 -> "Chat ends." [label=false,color=brown];
	j3147847030 [label="아서, 대화 좀 할 수 있을까? [다수의 파트너를 둘 수 있도록 동의를 구한다]",shape=box,color=red];
		j3147847030 -> j1959291200;
	j1589253455 [label="[종료.]",shape=box,color=red];
		j1589253455 -> j3652224286;
	j1959291200 [label="언제든지. 무슨 문제라도 있나?",shape=box,color=blue];
		j1959291200 -> j3602066472;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j3602066472 [label="아니, 전혀 없어. 그냥 불편한 상황이 아니었으면 하는 얘기를 하고 싶었을 뿐이야.",shape=box,color=red];
		j3602066472 -> j790608653;
	j790608653 [label="네가 괜찮지 않다 느끼는 상황에 놓이게 만들고 싶지 않아. 우리가 예전엔 이야기해본 적 없는 문제라는 것도 알고. 그러니 거절해도 괜찮아. 단지 이 점을 알아뒀으면 좋겠어.",shape=box,color=red];
		j790608653 -> j1063157344;
	j1063157344 [label="우리의 관계는 내게 중요해. 아주 중요해. 그리고 나는 진심이고. 네가 그걸 의심하지 않았으면 좋겠어.",shape=box,color=red];
		j1063157344 -> j3681702658;
	j3681702658 [label="아. 무슨 말 하려는 지 알겠군. 다른 사람에게도... 마음이 끌린다는 얘기로 받아들여도 되나?",shape=box,color=blue];
		j3681702658 -> j2361442711;
		j3681702658 -> j618671337;
	j2361442711 [label="응. 이해하기 어려울 수도 있다는 거 알지만, 그렇다고 해서 너한테 덜 끌린다는 뜻이 아니니까.",shape=box,color=red];
		j2361442711 -> j1811621936;
	j618671337 [label="응. 하지만 지금 생각하니 우린 여기서 끝내는 게 나을 것 같아. [헤어진다.]",shape=box,color=red];
		j618671337 -> j2944338382;
	j1811621936 [label="내 사랑, 내가 군대에서 그리 오래 굴렀는데 온갖 종류의 관계를 보지 않았다고 생각하나?",shape=box,color=blue];
		j1811621936 -> j1946687674;
	j2944338382 [label="그걸 네가 진심으로 원한다면...",shape=box,color=blue];
		j2944338382 -> j3701883258;
	j1946687674 [label="인생의 많은 시간을 거의 죽을 뻔하며 보내다 보면 인생에서 무엇이 중요한지, 무엇이 중요하지 않은지 감사하게 되지.",shape=box,color=blue];
		j1946687674 -> j258423150;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j258423150 [label="이게 어떤 식으로 진행될지는 모르나, 넌 내게 소중하니까 시도해 볼 용의는 있다.",shape=box,color=blue];
		j258423150 -> j3096160492;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j3096160492 [label="널 소중히 여기니까. 그리고 그쪽도 널 아낀다면, 나도 상대방을 소중히 여길거다.",shape=box,color=blue];
		j3096160492 -> j455403639;
	j455403639 [label="그저 바라기ㄹ. 정말이지. 절대로. 몰에 있는 멤버들은 안된다. 알았지?",shape=box,color=blue];
		j455403639 -> j878942507;
	j878942507 [label="상황이란게 이미 충분히 혼란스럽단 말이다.",shape=box,color=blue];
		j878942507 -> j2231753387;
		j878942507 -> j706509521;
	j2231753387 [label="ㅋㅋㅋ. 약속할게.",shape=box,color=red];
		j2231753387 -> j3689123715;
	j706509521 [label="내 생각엔, 네가 그 상대방을 정말 좋아할 것 같아.",shape=box,color=red];
		j706509521 -> j4123257176;
	j3689123715 [label="고맙다. 언젠가 그 상대방과 만날 수 있으면 좋겠군. 물론... 개인적인 이유로 말이다.",shape=box,color=blue];
		j3689123715 -> j2662699301;
	j4123257176 [label="언젠가 그 상대방과 만날 수 있으면 좋겠군. 물론... 개인적인 이유로 말이다.",shape=box,color=blue];
		j4123257176 -> j2662699301;
	j2662699301 [label="+20 Chemistry",color=orange];
		j2662699301 -> j1582779730;
	j1582779730 [label="스스로 잘 챙기면서 다녀라, 내 사랑.",shape=box,color=blue];
