	3641 [label="Check boolean ArthurPolyamorySuccess",color=orange];
		3641 -> 3609 [label=true,color=green];
		3641 -> 3610 [label=false,color=brown];
	3612 [label="Chat ends.",color=orange];
	3613 [label="아서, 대화 좀 할 수 있을까? [다수의 파트너가 있는 경우 동의를 구한다]",shape=box,color=red];
		3613 -> 3615;
	3611 [label="[종료.]",shape=box,color=red];
		3611 -> 3614;
	3610 [label="Chat ends.",color=orange];
	3615 [label="언제든지. 무슨 문제라도 있나?",shape=box,color=blue];
		3615 -> 3617;
	3614 [label="Update boolean ArthurConsentComplete",color=orange];
		3614 -> 3616;
	3617 [label="아니, 전혀 없어. 그냥 불편한 상황이 아니었으면 하는 얘기를 하고 싶었을 뿐이야.",shape=box,color=red];
		3617 -> 3618;
	3616 [label="Chat ends.",color=orange];
	3618 [label="네가 싫어하는 상황에 놓이게 만들고 싶지 않아. 이 문제를 우리가 전에는 이야기해 본 적이 없는 문제라는 것도 알고. 그러니 거절해도 괜찮아. 단지 이 점을 알아줬으면 좋겠어.",shape=box,color=red];
		3618 -> 3619;
	3619 [label="우리의 관계는 나에게 중요해 - 그것도 아주 많이 중요해 - 그리고 진심이야. 그걸 의심하지 않았으면 해.",shape=box,color=red];
		3619 -> 3620;
	3620 [label="아. 무슨 말 하려는 지 알겠군. 다른 사람에게도 마음이 끌린다는 얘기인가?",shape=box,color=blue];
		3620 -> 3621;
		3620 -> 3622;
	3621 [label="응. 이해하기 어려울 수도 있다는 거 알지만, 그렇다고 해서 너한테 덜 끌린다는 뜻이 아니니까.",shape=box,color=red];
		3621 -> 3623;
	3622 [label="응. 하지만 지금 생각하니 우린 여기서 끝내는 게 나을 것 같아. [헤어진다.]",shape=box,color=red];
		3622 -> 3624;
	3623 [label="내 사랑, 내가 군대에서 그리 오래 굴렀는데 온갖 종류의 관계를 보지 않았다고 생각하나?",shape=box,color=blue];
		3623 -> 3625;
	3624 [label="그걸 네가 진심으로 원한다면...",shape=box,color=blue];
		3624 -> 3626;
	3625 [label="인생의 많은 시간을 거의 죽을 뻔하며 보내다 보면 인생에서 무엇이 중요한지, 무엇이 중요하지 않은지 감사하게 되지.",shape=box,color=blue];
		3625 -> 3627;
	3626 [label="Update boolean IsDating",color=orange];
		3626 -> 3628;
	3627 [label="기준선에 대해 더 이상 의문을 품지 마라. 완전히 이해하니까.",shape=box,color=blue];
		3627 -> 3629;
	3628 [label="Update boolean ArthurDating",color=orange];
		3628 -> 3630;
	3629 [label="중요한 점? 네가 나한테 소중한 존재라는 거다. 그리고 그 상대방도 너에게 소중하다면, 그쪽도 나에게 소중한 존재다.",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="Chat ends.",color=orange];
	3631 [label="그냥. 그저. 헥스만 아니면 돼. 알았나? 이게 \"가족\"에게 해당하는 일이면 스스로도 감당할 수 없을 것 같으니까.",shape=box,color=blue];
		3631 -> 3632;
	3632 [label="그 생각만으로도 가위눌릴 것 같군.",shape=box,color=blue];
		3632 -> 3634;
		3632 -> 3633;
	3634 [label="ㅋㅋㅋ. 약속할게.",shape=box,color=red];
		3634 -> 3636;
	3633 [label="내 생각엔, 네가 그 상대방을 정말 좋아할 것 같아.",shape=box,color=red];
		3633 -> 3635;
	3636 [label="고맙다. 언젠가 그 상대방과 만날 수 있으면 좋겠군. 물론... 개인적인 이유로 말이다.",shape=box,color=blue];
		3636 -> 3637;
	3635 [label="언젠가 그 상대방과 만날 수 있으면 좋겠군. 물론... 개인적인 이유로 말이다.",shape=box,color=blue];
		3635 -> 3637;
	3637 [label="+20 Chemistry",color=orange];
		3637 -> 3638;
	3638 [label="스스로 잘 챙기면서 다녀라, 내 사랑.",shape=box,color=blue];
		3638 -> 3639;
	3639 [label="Update boolean ArthurConsentComplete",color=orange];
		3639 -> 3640;
	3640 [label="Chat ends.",color=orange];
}