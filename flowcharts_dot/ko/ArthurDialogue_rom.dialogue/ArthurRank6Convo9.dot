digraph {
	3555 [label="ArthurRank6Convo9 begins.",color=orange];
		3555 -> 3556;
	3556 [label="엘레노어가 모으는 저... 인페스티드 총들, 난 잘 모르겠군.",shape=box,color=blue];
		3556 -> 3557;
		3556 -> 3558;
	3557 [label="왜?",shape=box,color=red];
		3557 -> 3559;
	3558 [label="적어도 말은 안 하잖아.",shape=box,color=red];
		3558 -> 3560;
	3559 [label="엘레노어가 그 총들과 대화를 할 수 있는 것 같다는 것도 있다만, 그 외에도?",shape=box,color=blue];
		3559 -> 3561;
	3560 [label="*우리에게* 안 할 뿐이지. *엘레노어*에게까지 안 하고 있는지는 잘 모르겠더군.",shape=box,color=blue];
		3560 -> 3561;
	3561 [label="놈들이 그 기타와 대화를 한다는 건 안다. 그다지 필요 이상으로 생각하고 싶지 않은 부분이기도 하지.",shape=box,color=blue];
		3561 -> 3562;
	3562 [label="하지만 그 총들... 혹시 전염을 걱정해야 하는 것 아닌가? 아무래도 수가 불어나고 있는 것 같다만.",shape=box,color=blue];
		3562 -> 3563;
	3563 [label="어떻게 그러고 있는지도 모르겠고. 놈들의 탄약이 어디서 나는 건지, 애초부터 뭘로 만들어져 있는 건지도, 그렇게 깊게 생각하고 싶지 않군.",shape=box,color=blue];
		3563 -> 3564;
		3563 -> 3565;
	3564 [label="적어도 이 인페스티드 녀석들은 우리 편이지 않아?",shape=box,color=red];
		3564 -> 3566;
	3565 [label="그럼 넌 그냥 보통 총만 쓰는 게 좋을 것 같네.",shape=box,color=red];
		3565 -> 3567;
	3566 [label="그래, *지금은* 그렇지.",shape=box,color=blue];
		3566 -> 3568;
	3567 [label="그렇게 될 것 같다.",shape=box,color=blue];
		3567 -> 3568;
	3568 [label="내 보조 화기가 내 발등에 구멍을 내면, 적어도 이런 짓을 한 머저리가 나라는 건 알 수 있겠지.",shape=box,color=blue];
		3568 -> 3569;
	3569 [label="내 총 자체가 충성의 대상을 다시 생각해보기로 했던지, 한밤중에 갑자기 출출해져서 그랬다는 게 아니라 말이야.",shape=box,color=blue];
		3569 -> 3570;
	3570 [label="Chat ends.",color=orange];
}