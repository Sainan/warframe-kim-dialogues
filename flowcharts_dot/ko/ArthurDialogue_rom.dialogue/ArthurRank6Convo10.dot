		j3087718805 -> j1551249260;
	j3287313406 [label="그리고 이젠 녀석이 내 최고 기록을 계속 깨 대고 있다는 게 짜증이 나 견딜 수가 없군.",shape=box,color=blue];
		j3287313406 -> j2135529710;
	j1551249260 [label="참 희한하지, 우리 둘의 관계는. 그렇게 많은 대화를 나누지도 않는데 말이야.",shape=box,color=blue];
		j1551249260 -> j1343489327;
	j2135529710 [label="... 지난 이틀 동안 벌써 이 게임을 플레이하느라 26시간을 허비했는데.",shape=box,color=blue];
		j2135529710 -> j2934179004;
	j1343489327 [label="하지만 상황이 급박해진다면 서로를 위해 죽을 수도 있다는 건 둘 모두 알고 있다.",shape=box,color=blue];
		j1343489327 -> j737113711;
	j2934179004 [label="내가 다시 저 망할 물건 근처에라도 가거든 레티를 불러 날 마취시켜라.",shape=box,color=blue];
