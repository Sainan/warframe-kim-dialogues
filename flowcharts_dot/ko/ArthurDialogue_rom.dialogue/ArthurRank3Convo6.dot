digraph {
	1188 [label="ArthurRank3Convo6 begins.",color=orange];
		1188 -> 1189;
	1189 [label="'진실 인질 교환'을 하자.",shape=box,color=blue];
		1189 -> 1190;
		1189 -> 1191;
	1190 [label="ㅋㅋㅋㅋ 뭐?",shape=box,color=red];
		1190 -> 1192;
	1191 [label="과거 세상은 이상하군.",shape=box,color=red];
		1191 -> 1192;
	1192 [label="하. 그러니까, 내가 브리타니아 군에 있을 때 했던 놀이다.",shape=box,color=blue];
		1192 -> 1193;
	1193 [label="네가 너 자신에 대한 부끄러운 진실을 하나 털어 놓으면, 나도 내 걸 하나 말해주는, 그런 거지.",shape=box,color=blue];
		1193 -> 1194;
	1194 [label="그렇게 서로의 진실을 인질로 삼는 거야.",shape=box,color=blue];
		1194 -> 1195;
	1195 [label="진실 인질이라지만, \"신뢰를 쌓는 연습\" 이기도 하지. 게다가 이번엔 내가 먼저 할 거다.",shape=box,color=blue];
		1195 -> 1196;
		1195 -> 1197;
		1195 -> 1198;
	1196 [label="보통이라면, 네가 여기서 흔들다리 게임이라도 시작해야 할 것 같은데... 뭐, 그러지.",shape=box,color=red];
		1196 -> 1202;
	1197 [label="그래, 뭐 안 될 거 없지.",shape=box,color=red];
		1197 -> 1202;
	1198 [label="아냐, 안 할래.",shape=box,color=red];
		1198 -> 1199;
	1202 [label="자, 내 진실부터 가지. 내겐 세바스티안이라는 이름의 테디 베어 인형이 있다.",shape=box,color=blue];
		1202 -> 1203;
	1199 [label="좋을 대로 해라.",shape=box,color=blue];
		1199 -> 1200;
	1203 [label="내가 그걸 안고 잘 거라는 둥 쓸데 없는 상상이 네 머릿속에 스며들기 전에 말하자면, 아니다.",shape=box,color=blue];
		1203 -> 1204;
	1200 [label="Chat ends.",color=orange];
	1204 [label="임무 중에 찾은 거야. 폭격 맞은 주택단지에서. 수 년 전에.",shape=box,color=blue];
		1204 -> 1205;
	1205 [label="가져와서 선반 위에 두었지. 그리고 대화를 나눌 상대가 아무도 없을 때가 되면.",shape=box,color=blue];
		1205 -> 1206;
	1206 [label="녀석에게 말을 걸곤 해. 추레하지만 오래 된 친구지. 덕분에 내가 미치지 않을 수 있다.",shape=box,color=blue];
		1206 -> 1201;
		1206 -> 1207;
		1206 -> 1208;
	1201 [label="엌ㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋ",shape=box,color=red];
		1201 -> 1214;
	1207 [label="그건... 가슴아플 정도로 귀여운데.",shape=box,color=red];
		1207 -> 1211;
	1208 [label="언제 한 번 세바스티안 안아봐도 돼?",shape=box,color=red];
		1208 -> 1210;
	1214 [label="그래, 실컷 웃어라.",shape=box,color=blue];
		1214 -> 1213;
	1211 [label="나 좀 죽을 거 같다.",shape=box,color=red];
		1211 -> 1212;
	1210 [label="+20 Chemistry",color=orange];
		1210 -> 1209;
	1213 [label="너무 웃겨서 지릴거같앜ㅋㅋㅋㅋㅋㅋㅋ!",shape=box,color=red];
		1213 -> 1215;
	1212 [label="넌 진짜 알면 알수록 놀랍다, 아서.",shape=box,color=red];
		1212 -> 1217;
	1209 [label="안 될 것 없지.",shape=box,color=blue];
		1209 -> 1218;
	1215 [label="그래, 안다.",shape=box,color=blue];
		1215 -> 1218;
	1217 [label="+20 Chemistry",color=orange];
		1217 -> 1216;
	1218 [label="네 차례야.",shape=box,color=blue];
		1218 -> 1219;
		1218 -> 1220;
		1218 -> 1221;
		1218 -> 1222;
	1216 [label="헤.",shape=box,color=blue];
		1216 -> 1218;
	1219 [label="두비리에 있을 때, 내 어릴 적 침실을 실수로 자꾸 불러내곤 했지. 어딘가 숨을 곳이 필요해서.",shape=box,color=red];
		1219 -> 1227;
	1220 [label="언제던가 로둔이 내 목을 쳤을 때, 내 머리가 너무 멀리 날아가는 바람에 나무에 걸린 적이 있었지!",shape=box,color=red];
		1220 -> 1226;
	1221 [label="케이스를 제대로 타는 방법을 터득하기 전까지 육백 하고도 여든 일곱 번의 루프가 걸렸어.",shape=box,color=red];
		1221 -> 1225;
	1222 [label="아냐, 안 할래. 그래도 세바스티안 얘기 들려준 건 고마워.",shape=box,color=red];
		1222 -> 1223;
	1227 [label="어떻게 빠져나오는지 알아낼 때까지 그런 방을 몇 개 불러냈는지, 세다가 잊어버릴 정도였어.",shape=box,color=red];
		1227 -> 1228;
	1226 [label="머리가 잘린 뒤에 얼마나 오래 살아 있을 수 있는지 알아? 왜냐면 난 *알거든*. ㅋㅋㅋ",shape=box,color=red];
		1226 -> 1228;
	1225 [label="어느 뼈가 어떻게 부러졌는지, 전부 총합을 내기 시작했지. 아마 그 목록이 어디 아직 있을 건데.",shape=box,color=red];
		1225 -> 1228;
	1223 [label="이럴 줄 알았어.",shape=box,color=blue];
		1223 -> 1224;
	1228 [label="솔 맙소사... 지금 네가 뭘 해야 하는지를 잘못 안 것 같다만, 친구.",shape=box,color=blue];
		1228 -> 1229;
	1224 [label="Chat ends.",color=orange];
	1229 [label="하지만, 어 -... 적어도 시도는 해 줘서 고맙다.",shape=box,color=blue];
		1229 -> 978;
	978 [label="Chat ends.",color=orange];
}