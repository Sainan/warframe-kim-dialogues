digraph {
	2911 [label="AoiRank4Convo7 begins.",color=orange];
		2911 -> 2912;
	2912 [label="Check boolean AoiVoidTongue",color=orange];
		2912 -> 2914 [label=true,color=green];
		2912 -> 2913 [label=false,color=brown];
	2914 [label="所以，我想我有办法了！",shape=box,color=blue];
		2914 -> 2917;
		2914 -> 2918;
	2913 [label="Check boolean AoiPianoLesson",color=orange];
		2913 -> 2915 [label=true,color=green];
		2913 -> 2916 [label=false,color=brown];
	2917 [label="<RETRO_EMOJI_WUT>",shape=box,color=red];
		2917 -> 2919;
	2918 [label="你有什么？",shape=box,color=red];
		2918 -> 2920;
	2915 [label="啊咳咳！你准备好上钢琴课了吗？",shape=box,color=blue];
		2915 -> 2921;
		2915 -> 2922;
	2916 [label="我可以给你介绍一个朋友吗？他的名字叫“钢琴先生”。",shape=box,color=blue];
		2916 -> 2921;
		2916 -> 2922;
	2919 [label="+5 Chemistry",color=orange];
		2919 -> 2924;
	2920 [label="我找到了一种弹钢琴的方式，可以真正地弹奏任何音乐，而不用考虑“虚空语”",shape=box,color=blue];
		2920 -> 2926;
	2921 [label="我报名。",shape=box,color=red];
		2921 -> 2927;
	2922 [label="现在不行。[结束]",shape=box,color=red];
		2922 -> 2923;
	2924 [label="<RETRO_EMOJI_JOY>",shape=box,color=blue];
		2924 -> 2925;
	2926 [label="或者可能我想得太多了。那么，什么是虚空语？",shape=box,color=blue];
		2926 -> 2929;
		2926 -> 2930;
		2926 -> 2931;
	2927 [label="那我们先从这个问题开始：为什么是音乐？为什么是钢琴？",shape=box,color=blue];
		2927 -> 2928;
	2923 [label="Chat ends.",color=orange];
	2925 [label="我有一种弹钢琴的方式，可以真正地弹奏任何音乐，而不用考虑“虚空语”",shape=box,color=blue];
		2925 -> 2926;
	2929 [label="这个问题很难回答。来自虚空的声音、词语、言语。更像是一种诅咒。对任何能听到它的耳朵都是一种沟通。",shape=box,color=red];
		2929 -> 2948;
	2930 [label="这是我再也不想听到的东西。",shape=box,color=red];
		2930 -> 2949;
	2931 [label="我觉得这就是造成这一切的语言。它的表达方式。",shape=box,color=red];
		2931 -> 2953;
	2928 [label="这样开始钢琴课比较容易，因为呃，我找不到钢琴。所以我们先从理论开始吧。",shape=box,color=blue];
		2928 -> 2934;
		2928 -> 2932;
		2928 -> 2933;
	2948 [label="神马 <RETRO_EMOJI_OHNO>",shape=box,color=blue];
		2948 -> 2954;
	2949 [label="就像一首烂歌吗？",shape=box,color=blue];
		2949 -> 2950;
		2949 -> 2951;
	2953 [label="那是不是像唱歌一样的语言？",shape=box,color=blue];
		2953 -> 2955;
		2953 -> 2956;
	2934 [label="好的，我们就从理论开始。",shape=box,color=red];
		2934 -> 2935;
	2932 [label="你真的很努力在找吗？",shape=box,color=red];
		2932 -> 2938;
	2933 [label="我们在哪能找到钢琴呢？",shape=box,color=red];
		2933 -> 2939;
	2954 [label="好吧，现在我真的需要给你弄些音乐了。想想看。用你自己的歌曲淹没这“虚空语”，对吧？",shape=box,color=blue];
		2954 -> 2955;
		2954 -> 2956;
	2950 [label="我们先说到这里吧。[结束]",shape=box,color=red];
		2950 -> 2952;
	2951 [label="我想，算是吧。",shape=box,color=red];
		2951 -> 2953;
	2955 [label="我真的不知道该怎么形容它。但它确实很强大。",shape=box,color=red];
		2955 -> 2957;
	2956 [label="这不会是你想听的东西。这是导致这一切发生的原因之一。",shape=box,color=red];
		2956 -> 2960;
	2935 [label="太好了！所以，为了让你赶上进度，这里的音乐自古以来就很重要。男孩和女孩会坐在钢琴前创作，而不是坐在电视机前。",shape=box,color=blue];
		2935 -> 2936;
	2938 [label=" 嗯，算是挺努力的吧？我不太敢进那些空荡荡的公寓……",shape=box,color=blue];
		2938 -> 2940;
	2939 [label="嗯，它们又大又难藏……我不认为维克多和炽蛇军会弹。",shape=box,color=blue];
		2939 -> 2940;
	2952 [label="Chat ends.",color=orange];
	2957 [label="强大到足以改变生命。我认识一些动物，我会说它们是朋友。科维兽。它们接触了虚空，就像魔法一样学会了怎么*说话*。",shape=box,color=red];
		2957 -> 2959;
	2960 [label="它造成了很多痛苦。",shape=box,color=red];
		2960 -> 2961;
		2960 -> 2962;
	2936 [label="演奏……创作……其实一首歌就像是通过音乐进行交流。你甚至不需要歌词！",shape=box,color=blue];
		2936 -> 2937;
	2940 [label="呃。炽蛇军。他们可能毁了它们。他们怎么可能会让像乐器这样带有希望的东西留下来？",shape=box,color=blue];
		2940 -> 2941;
	2959 [label="现在当它们说话，一开始总是那么绝望。那么不对劲。虚空语最初只让这些生物感受到一种感觉：绝望。",shape=box,color=red];
		2959 -> 2958;
	2961 [label="我听不下去。",shape=box,color=red];
		2961 -> 2963;
	2962 [label="但即便如此，我感觉我知道如何说这种语言。",shape=box,color=red];
		2962 -> 2963;
	2937 [label="但想象一下——为我们的世界创造一些东西，一些可以让人们哭泣？跳舞？唱歌的东西？对我来说，这就是魔法。",shape=box,color=blue];
		2937 -> 2942;
		2937 -> 2943;
	2941 [label="但等等，那我问你，如果未来有音乐，也许就有希望。那么……",shape=box,color=blue];
		2941 -> 2945;
	2958 [label="别说我笨，但你试过给它们放音乐了吗？你的朋友们？也许这会有所帮助，哪怕只有一秒钟？",shape=box,color=blue];
		2958 -> 2965;
	2963 [label="这让我感到害怕。它就像一首我想要忘掉的歌。就像一个应该消失的魔咒。",shape=box,color=red];
		2963 -> 2964;
	2942 [label="魔法？我不这么认为。不过我确实喜欢好听的歌。",shape=box,color=red];
		2942 -> 2946;
	2943 [label="音乐一直是我经历中的一部分。通过歌曲回忆，我能理解。",shape=box,color=red];
		2943 -> 2944;
	2945 [label="那么请告诉我一首歌吧。",shape=box,color=blue];
		2945 -> 2974;
		2945 -> 2975;
		2945 -> 2976;
	2965 [label="你不觉得音乐可以打破一切，成为希望吗？对于所有人？对于所有事？如果虚空语是“魔法”，那么音乐也是。",shape=box,color=blue];
		2965 -> 2967;
		2965 -> 2966;
	2964 [label="没事的，没事的。我懂的。音乐有时也会让人感到绝望。",shape=box,color=blue];
		2964 -> 2965;
	2946 [label="也许有一天你会相信我。",shape=box,color=blue];
		2946 -> 2947;
	2944 [label="+10 Chemistry",color=orange];
		2944 -> 2945;
	2974 [label="音乐可以定义记忆。《朱兰笑》是一首我在失去一切的人的脑海中、记忆中听到的歌。",shape=box,color=red];
		2974 -> 2977;
	2975 [label="音乐可以带来希望。那首《我们共度时艰》是不是特别有力量？",shape=box,color=red];
		2975 -> 2978;
	2976 [label="碧，音乐可能是邪恶的。我试图拯救的那些人，他们被一首歌诅咒了。“只为众生得救赎”，他们这么唱。",shape=box,color=red];
		2976 -> 2979;
	2967 [label="那你给我放首歌好吗？",shape=box,color=red];
		2967 -> 2968;
	2966 [label="也许你听了太多歌了。",shape=box,color=red];
		2966 -> 2969;
	2947 [label="Chat ends.",color=orange];
	2977 [label="想象一下，你失去了一切——家庭、生活、你自己的认同感。",shape=box,color=red];
		2977 -> 2980;
	2978 [label="通过歌曲找到快乐、意义和共同的经历。",shape=box,color=red];
		2978 -> 2981;
	2979 [label="你不知道看到那是什么样的感受。",shape=box,color=red];
		2979 -> 2982;
	2968 [label="+10 Chemistry",color=orange];
		2968 -> 2971;
	2969 [label="嗯，这只是你的看法。谢谢你听我说完。",shape=box,color=blue];
		2969 -> 2970;
	2980 [label="有那么一首歌，只需要一首歌，就是你找到自我的基础。",shape=box,color=red];
		2980 -> 2983;
	2981 [label="这很有趣。也充满希望。我们许多人无法选择自己的生活境遇。",shape=box,color=red];
		2981 -> 2984;
	2982 [label="天哪，我真的很抱歉，请继续告诉我吧。",shape=box,color=blue];
		2982 -> 2985;
	2971 [label="当然！！！！",shape=box,color=blue];
		2971 -> 2972;
	2970 [label="Chat ends.",color=orange];
	2983 [label="我喜欢这么想，如果我迷失了自己，音乐将会是我找到方向的方式。",shape=box,color=red];
		2983 -> 2987;
	2984 [label="但我们仍然可以选择一起歌唱，无论是关于什么，或者什么都不关于。只是歌唱。",shape=box,color=red];
		2984 -> 2989;
	2985 [label="在这里跟你说这些，我感觉有些不妥，我希望我可以唱给你听，但如果有什么我可以说的，那就是邪恶……",shape=box,color=red];
		2985 -> 2986;
	2972 [label="Update boolean AoiPlaySong",color=orange];
		2972 -> 2973;
	2987 [label="你说的……",shape=box,color=blue];
		2987 -> 2988;
	2989 [label="音乐真的很有力量。",shape=box,color=blue];
		2989 -> 2990;
	2986 [label="邪恶总是试图毁掉善良。我见过这样的事情发生在音乐上。任何人都不应该歌颂那些被诅咒的人。",shape=box,color=red];
		2986 -> 2989;
	2973 [label="Chat ends.",color=orange];
	2988 [label="让我感觉，嗯，很有共鸣。就好像是宇宙的规律一样。",shape=box,color=blue];
		2988 -> 2989;
	2990 [label="这说起来有点尴尬，我也有一个类似的故事。虽然没有那么沉重，但也差不多……也许你会理解。",shape=box,color=blue];
		2990 -> 2991;
	2991 [label="当我还是个孩子的时候，就像“小女孩碧”一样，想和每个人都成为朋友。",shape=box,color=blue];
		2991 -> 2992;
		2991 -> 2993;
	2992 [label="听起来就像我认识的碧。",shape=box,color=red];
		2992 -> 2994;
	2993 [label="真的吗？碧变得友好了？",shape=box,color=red];
		2993 -> 2996;
	2994 [label="+10 Chemistry",color=orange];
		2994 -> 2995;
	2996 [label="我就忽略这句了！",shape=box,color=blue];
		2996 -> 2997;
	2995 [label="<RETRO_EMOJI_PUMPEDUP>",shape=box,color=blue];
		2995 -> 2997;
	2997 [label="但有一个孩子，总是被欺负。总是。",shape=box,color=blue];
		2997 -> 2998;
	2998 [label="他们还会唱一些恶毒的歌曲来嘲笑那个孩子。非常可怕和恶毒。",shape=box,color=blue];
		2998 -> 2999;
	2999 [label="当我看到音乐被用来造成痛苦时，小时候的我感到内心有些东西碎了。我当时不明白。",shape=box,color=blue];
		2999 -> 3000;
	3000 [label="现在还是不明白。但我知道，我可以不用挥拳反击，即使这意味着让自己尴尬。",shape=box,color=blue];
		3000 -> 3001;
		3000 -> 3002;
	3001 [label="那你是怎么做的？",shape=box,color=red];
		3001 -> 3003;
	3002 [label="你让自己尴尬了吗？",shape=box,color=red];
		3002 -> 3003;
	3003 [label="我唱得比那些霸凌者还大声。那是一首很蠢的歌，我甚至都不记得它是怎么唱的。",shape=box,color=blue];
		3003 -> 3004;
	3004 [label="但它有用。",shape=box,color=blue];
		3004 -> 3005;
	3005 [label="当他们试图欺负我时，他们会向我扔 CD，但你猜怎么着？",shape=box,color=blue];
		3005 -> 3009;
		3005 -> 3006;
	3009 [label="那些 CD 是金属做的？",shape=box,color=red];
		3009 -> 3007;
	3006 [label="你把它们弄坏了？",shape=box,color=red];
		3006 -> 3007;
	3007 [label="哈！不是。我得到了免费的音乐！碧赢了！",shape=box,color=blue];
		3007 -> 3008;
	3008 [label="我希望你知道，也希望这里的每个人都知道，我会为你们所有人唱得更大声。",shape=box,color=blue];
		3008 -> 3010;
	3010 [label="一直都会。",shape=box,color=blue];
		3010 -> 3011;
	3011 [label="Chat ends.",color=orange];
}