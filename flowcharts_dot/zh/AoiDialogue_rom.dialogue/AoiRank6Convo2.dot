		j2997484825 -> j3311706329;
	j1713311259 [label="其实是另一个英择谛家族的人，但我明白你的意思。",shape=box,color=red];
		j1713311259 -> j1725714321;
	j2054810777 [label="嗯，确切来说，这些都是英择谛家族里“父亲”的作品，而不是阿尔布雷希特的作品。",shape=box,color=red];
