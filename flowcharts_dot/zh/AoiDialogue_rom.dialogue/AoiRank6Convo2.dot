		j2981487732 -> j2614304719;
	j3410275939 [label="不全是。只有英择谛家族的东西才是。",shape=box,color=red];
		j3410275939 -> j3391729524;
	j2614304719 [label="我本来还期待能看到酷炫的大机甲 :(",shape=box,color=blue];
