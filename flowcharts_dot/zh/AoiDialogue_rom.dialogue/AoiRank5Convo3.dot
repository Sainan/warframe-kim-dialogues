		3418 -> 3419;
	3419 [label="你也是个英雄，知道吗 <3",shape=box,color=blue];
		3419 -> 3421;
		3419 -> 3420;
		3419 -> 3422;
	3421 [label="你的这句话对我意义重大。",shape=box,color=red];
		3421 -> 3423;
	3420 [label="听你这么说我感觉好极了。",shape=box,color=red];
		3420 -> 3424;
	3422 [label="你这个万人迷。",shape=box,color=red];
		3422 -> 3427;
