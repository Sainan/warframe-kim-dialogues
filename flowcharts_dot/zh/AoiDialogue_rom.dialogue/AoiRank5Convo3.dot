digraph {
	3372 [label="AoiRank5Convo3 begins.",color=orange];
		3372 -> 3373;
		3372 -> 3374;
	3373 [label="你一定是六人组里最强的英雄了。我是说，考虑到这里的每个人身上都有一部分金属化了，肯定没人会招惹你。",shape=box,color=red];
		3373 -> 3375;
	3374 [label="我一直在想，整个团队之中，你总是下意识地为他人着想，让你成为了我们中最像英雄的人。",shape=box,color=red];
		3374 -> 3376;
	3375 [label="哈哈",shape=box,color=blue];
		3375 -> 3378;
	3376 [label="+5 Chemistry",color=orange];
		3376 -> 3377;
	3378 [label="你说话就像阿米尔",shape=box,color=blue];
		3378 -> 3380;
		3378 -> 3379;
		3378 -> 3381;
		3378 -> 3382;
	3377 [label="<3",shape=box,color=blue];
		3377 -> 3378;
	3380 [label="我有生以来还是第一次听到这种话。",shape=box,color=red];
		3380 -> 3383;
	3379 [label="谢谢你。不过为什么这么说?",shape=box,color=red];
		3379 -> 3384;
	3381 [label="真的吗？你为什么这么说？",shape=box,color=red];
		3381 -> 3386;
	3382 [label="这是夸奖吗？",shape=box,color=red];
		3382 -> 3385;
	3383 [label="真的吗？不过你们俩还真像 ;)",shape=box,color=blue];
		3383 -> 3386;
	3384 [label="+5 Chemistry",color=orange];
		3384 -> 3386;
	3386 [label="只是当阿米尔刚加入六人组的时候，他开玩笑说我是超级英雄",shape=box,color=blue];
		3386 -> 3387;
	3385 [label="当然是啦！",shape=box,color=blue];
		3385 -> 3386;
	3387 [label="……他是我的助手",shape=box,color=blue];
		3387 -> 3388;
	3388 [label="很温馨，但也有一点伤感",shape=box,color=blue];
		3388 -> 3390;
		3388 -> 3389;
		3388 -> 3391;
	3390 [label="还挺让人惊讶的。毕竟阿米尔看起来总是那么自信。",shape=box,color=red];
		3390 -> 3392;
	3389 [label="助手，嗯？这听起来可不像我现在认识的阿米尔。发生了什么？",shape=box,color=red];
		3389 -> 3392;
	3391 [label="伤感？我以为你们俩关系很好。",shape=box,color=red];
		3391 -> 3393;
	3392 [label="这需要时间。阿米尔加入我们时没有任何军事经验，所以战斗对他来说太难了",shape=box,color=blue];
		3392 -> 3394;
	3393 [label="哦，我们关系当然好啦！阿米尔是我最好的朋友。我最喜欢的一些回忆就是我们在街机厅里玩游戏，一起听线上时代的歌。",shape=box,color=blue];
		3393 -> 3395;
	3394 [label="他只是需要明白，成为英雄并不全是为了战斗",shape=box,color=blue];
		3394 -> 3396;
	3395 [label="但当助手这件事呢？我看得出来，他觉得自己……很渺小。",shape=box,color=blue];
		3395 -> 3396;
	3396 [label="我一直都知道，像他这样厉害的黑客也能以自己的方式成为英雄",shape=box,color=blue];
		3396 -> 3399;
		3396 -> 3397;
	3399 [label="那么是什么改变了他？他现在看起来不像任何人的助手了。",shape=box,color=red];
		3399 -> 3398;
	3397 [label="是你帮他意识到这一点的，不是吗？",shape=box,color=red];
		3397 -> 3398;
	3398 [label="我不能把功劳都揽在自己身上，但他取得突破的时候我在他身边。",shape=box,color=blue];
		3398 -> 3400;
	3400 [label="有一天，我从一个线上时代粉丝那里听到了一段疯狂广播，她拼凑了一些关于金曲大厂（线上时代的唱片公司）的阴暗细节",shape=box,color=blue];
		3400 -> 3402;
	3402 [label="她几乎是在哀求有人能帮助他们，阿米尔毫不犹豫地站了出来",shape=box,color=blue];
		3402 -> 3401;
		3402 -> 3403;
		3402 -> 3404;
	3401 [label="阿米尔怎么会卷入这种事？",shape=box,color=red];
		3401 -> 3405;
	3403 [label="阿米尔？我还以为跑去救线上时代的人是你呢。",shape=box,color=red];
		3403 -> 3406;
	3404 [label="这听起来像是传说中的碧—阿米尔组合啊。",shape=box,color=red];
		3404 -> 3407;
	3405 [label="我给他看了广播。阿米尔把剩下的都搞定了！",shape=box,color=blue];
		3405 -> 3409;
	3406 [label="嗯，这是团队合作的结果。你可以说我是他的助手 ^_^",shape=box,color=blue];
		3406 -> 3409;
	3407 [label="+5 Chemistry",color=orange];
		3407 -> 3408;
	3409 [label="他黑进了他们经纪人的邮箱，发现了他们与炽蛇军一连串的交易。他们一直在克隆乐队，并将他们置于危险之中，而这一切都被他们的管理层掩盖了",shape=box,color=blue];
		3409 -> 3410;
	3408 [label="超级粉丝和超级黑客联手？当然势不可挡啦！",shape=box,color=blue];
		3408 -> 3409;
	3410 [label="恶心！",shape=box,color=blue];
		3410 -> 3411;
	3411 [label="如果没有阿米尔的技术，这一切都不会曝光",shape=box,color=blue];
		3411 -> 3412;
		3411 -> 3413;
	3412 [label="哇。简直难以置信。阿米尔真的揭露了这一切吗？",shape=box,color=red];
		3412 -> 3414;
	3413 [label="你知道吗，如果知识就是力量，那么黑客真的很强大。",shape=box,color=red];
		3413 -> 3414;
	3414 [label="当然啦！整个过程让他意识到自己不仅仅是个助手，他本身就是个英雄 ^_^",shape=box,color=blue];
		3414 -> 3416;
		3414 -> 3415;
	3416 [label="你们还能一起去街机厅里尽情摇摆",shape=box,color=red];
		3416 -> 3417;
	3415 [label="好像还能有什么疑问似的。",shape=box,color=red];
		3415 -> 3418;
	3417 [label="就两位英雄在放松一下嘛！",shape=box,color=blue];
		3417 -> 3419;
