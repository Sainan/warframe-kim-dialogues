digraph {
	3899 [label="AoiRank6Convo3 begins.",color=orange];
		3899 -> 3900;
	3900 [label="那个，有个问题",shape=box,color=blue];
		3900 -> 3901;
	3901 [label="你有一艘宇宙飞船",shape=box,color=blue];
		3901 -> 3902;
		3901 -> 3903;
		3901 -> 3904;
	3902 [label="然后呢？",shape=box,color=red];
		3902 -> 3905;
	3903 [label="实际上，我有好几艘。",shape=box,color=red];
		3903 -> 3906;
	3904 [label="我有。:)",shape=box,color=red];
		3904 -> 3905;
	3905 [label="它是怎么在行星之间穿梭的啊？",shape=box,color=blue];
		3905 -> 3907;
	3906 [label="<RETRO_EMOJI_PASSGLASSES>",shape=box,color=blue];
		3906 -> 3908;
		3906 -> 3909;
	3907 [label="你们有……超级火箭吗？虫洞？你们是怎么飞这么远的？",shape=box,color=blue];
		3907 -> 3910;
	3908 [label="<RETRO_EMOJI_YUM>",shape=box,color=red];
		3908 -> 3911;
	3909 [label="<RETRO_EMOJI_SUNGLASSES>",shape=box,color=red];
		3909 -> 3912;
	3910 [label="还是说太阳帆？我父母正在琢磨怎么做",shape=box,color=blue];
		3910 -> 3913;
		3910 -> 3914;
	3911 [label="<RETRO_EMOJI_STARE>",shape=box,color=blue];
		3911 -> 3915;
	3912 [label="+5 Chemistry",color=orange];
		3912 -> 3916;
	3913 [label="你不会喜欢这个问题的答案。是奥罗金创造的航行方法。",shape=box,color=red];
		3913 -> 3917;
	3914 [label="嗯，那得看情况。你是指我的“大船”还是“小船”？",shape=box,color=red];
		3914 -> 3918;
	3915 [label="总之……",shape=box,color=blue];
		3915 -> 3919;
	3916 [label="哈哈 ^_^ 但是",shape=box,color=blue];
		3916 -> 3919;
	3917 [label="<RETRO_EMOJI_ANNOYED1>",shape=box,color=blue];
		3917 -> 3920;
	3918 [label="+5 Chemistry",color=orange];
		3918 -> 3921;
	3919 [label="它们是怎么在行星之间穿梭的啊？",shape=box,color=blue];
		3919 -> 3907;
	3920 [label="嗯……我想没有哪个社会是彻底坏的。",shape=box,color=blue];
		3920 -> 3922;
	3921 [label="<RETRO_EMOJI_WHOA>",shape=box,color=blue];
		3921 -> 3923;
	3922 [label="那么方法是什么？",shape=box,color=blue];
		3922 -> 3924;
	3923 [label="都行！！！先从大船开始！！",shape=box,color=blue];
		3923 -> 3925;
	3924 [label="嗯，这取决于飞船是大船还是小船——但它们都利用虚空来跨越遥远的距离。它们穿越虚空。",shape=box,color=red];
		3924 -> 3926;
	3925 [label="嗯，那是我的航道星舰。里面装着虚空无情之物的复制品手指——也就是圣物装置。",shape=box,color=red];
		3925 -> 3927;
	3926 [label="那艘大船，也就是航道星舰，使用了一种叫做圣物装置的东西——里面有一根虚空无情之物断指的复制品。",shape=box,color=red];
		3926 -> 3928;
	3927 [label="它利用这个东西进入虚空，跨越行星之间的巨大距离。它就是这样在虚空中穿梭的。",shape=box,color=red];
		3927 -> 3928;
	3928 [label="<RETRO_EMOJI_OHNO>",shape=box,color=blue];
		3928 -> 3929;
	3929 [label="不好意思",shape=box,color=blue];
		3929 -> 3930;
	3930 [label="什么",shape=box,color=blue];
		3930 -> 3931;
		3930 -> 3932;
	3931 [label="长；懒看：阿尔布雷希特进入虚空，惊慌失措，最后还偷走了虚空无情之物的手指。",shape=box,color=red];
		3931 -> 3933;
	3932 [label="嗯。好吧。是这样。阿尔布雷希特……是第一个“发现”如何进入虚空的人。",shape=box,color=red];
		3932 -> 3934;
	3933 [label="首先……长；懒看：？",shape=box,color=blue];
		3933 -> 3935;
	3934 [label="算是一个潜水钟舱吧。由一种叫做玻璃窗的东西制成。他撑开了连接两个世界的薄膜。",shape=box,color=red];
		3934 -> 3936;
	3935 [label="太长了；懒得看。昆西教我的。",shape=box,color=red];
		3935 -> 3937;
	3936 [label="事情……说得好听一点，就是出了问题。他惊慌失措，踉跄了一下，那东西歪了过去，撞到了薄膜锋利的边缘。",shape=box,color=red];
		3936 -> 3938;
	3937 [label="呵……",shape=box,color=blue];
		3937 -> 3939;
	3938 [label="玻璃钟舱碎裂，他坠入虚空。",shape=box,color=red];
		3938 -> 3940;
	3939 [label="其次",shape=box,color=blue];
		3939 -> 3941;
	3940 [label="当他醒来时，他回到了实验室，只是那不再是他的实验室。他盯着自己，只不过那不再是他自己。“他”给他自己起了个只有他妈妈才知道的名字。",shape=box,color=red];
		3940 -> 3942;
	3941 [label="****你有它的手指？！？！？！****",shape=box,color=blue];
		3941 -> 3943;
	3942 [label="于是，阿尔布雷希特拼命逃命。破碎的玻璃窗划伤了他，他用自己的血，写下了让他女儿关闭他身后那层膜质的字——",shape=box,color=red];
		3942 -> 3944;
	3943 [label="你还用它来给你的航道星舰提供动力？！？！",shape=box,color=blue];
		3943 -> 3945;
	3944 [label="——因为他能感觉到那个“人”正在接近他。",shape=box,color=red];
		3944 -> 3946;
	3945 [label="<RETRO_EMOJI_HORRIFIED>",shape=box,color=blue];
		3945 -> 3947;
	3946 [label="她照做了。当门关上的时候？嗯……它的手指被切断了，掉在地板上。",shape=box,color=red];
		3946 -> 3948;
	3947 [label="也许这就是它生气的原因！！！",shape=box,color=blue];
		3947 -> 3949;
		3947 -> 3950;
	3948 [label="……哇哦……",shape=box,color=blue];
		3948 -> 3951;
	3949 [label="它不仅为航道星舰提供动力，还为其他很多东西提供动力，这就是问题所在……",shape=box,color=red];
		3949 -> 3952;
	3950 [label="也许吧。",shape=box,color=red];
		3950 -> 3953;
	3951 [label="首先：真是个难以置信的故事……",shape=box,color=blue];
		3951 -> 3954;
	3952 [label="哦……",shape=box,color=blue];
		3952 -> 3955;
		3952 -> 3956;
	3953 [label="你就不能把它还回去吗？！",shape=box,color=blue];
		3953 -> 3955;
		3953 -> 3956;
	3954 [label="其次",shape=box,color=blue];
		3954 -> 3941;
	3955 [label="我……不知道那些手指在哪里。",shape=box,color=red];
		3955 -> 3957;
	3956 [label="我不知道这是不是个好主意？",shape=box,color=red];
		3956 -> 3957;
	3957 [label="但它们被拿走了……",shape=box,color=blue];
		3957 -> 3958;
		3957 -> 3959;
	3958 [label="即使我们知道它们在哪里，我也不知道我们是否应该把它们还回去。",shape=box,color=red];
		3958 -> 3960;
	3959 [label="我知道。我也觉得这样做不对。",shape=box,color=red];
		3959 -> 3961;
	3960 [label="你这话是什么意思？",shape=box,color=blue];
		3960 -> 3962;
		3960 -> 3963;
	3961 [label="但不幸的是，损失已经造成。阿尔布雷希特拿走了手指。现在已经无法挽回了。",shape=box,color=red];
		3961 -> 3960;
	3962 [label="那个“时间丝线”有点特别。可以说超级复杂？说到特别之处……我也说不上来？",shape=box,color=red];
		3962 -> 3964;
	3963 [label="我不知道把它们还回去会不会有什么好处。我觉得这不会改变他的想法。",shape=box,color=red];
		3963 -> 3965;
	3964 [label="就把它困在这里？让它待在我们的地盘上？我们手上有它的手指，它就只能按照我们的规矩来。",shape=box,color=red];
		3964 -> 3966;
	3965 [label="我想伤害已经造成了，没办法了。 ",shape=box,color=red];
		3965 -> 3966;
	3966 [label="……我不喜欢这样",shape=box,color=blue];
		3966 -> 3967;
	3967 [label="太空旅行本该是……有趣、酷炫、充满……探索，还有遇到新物种",shape=box,color=blue];
		3967 -> 3968;
	3968 [label="大胆地去某个地方，我也不知道，反正就像阿米尔看的那些节目里讲过的一大段话",shape=box,color=blue];
		3968 -> 3969;
	3969 [label="只是这本应是关于……人性、同情心、学习和冒险",shape=box,color=blue];
		3969 -> 3970;
	3970 [label="而不是……像这样",shape=box,color=blue];
		3970 -> 3971;
		3970 -> 3972;
	3971 [label="我想，谁也不知道。但时间会给出答案。",shape=box,color=red];
		3971 -> 3973;
	3972 [label="有时候我会想，这难道不正是英择谛的本意吗？把我送回到这里，和你们所有人一起。",shape=box,color=red];
		3972 -> 3974;
	3973 [label="<RETRO_EMOJI_GIVELOVE>",shape=box,color=blue];
		3973 -> 3975;
	3974 [label="或者去什么地方，去帮助……治愈人们。",shape=box,color=red];
		3974 -> 3976;
	3975 [label="是的，无论如何，时间都会给出答案",shape=box,color=blue];
		3975 -> 3977;
	3976 [label="就算只是为了收拾他留下来的烂摊子，从某种程度上来说，这也是为了给宇宙带来你所说的同情心。",shape=box,color=red];
		3976 -> 3978;
	3977 [label="那么，你接下来想听听有关星际航道的事吗？",shape=box,color=red];
		3977 -> 3979;
	3978 [label="但我只能希望，最终一切都会好起来。而且不是我拿着拖把桶追着一个疯子跑。",shape=box,color=red];
		3978 -> 3980;
	3979 [label="哈哈，不了",shape=box,color=blue];
		3979 -> 3981;
	3980 [label="+5 Chemistry",color=orange];
		3980 -> 3982;
	3981 [label="Chat ends.",color=orange];
	3982 [label="好吧，如果这就是你要做的，我会和你在一起！",shape=box,color=blue];
		3982 -> 3983;
	3983 [label="<RETRO_EMOJI_TWOHUGS>",shape=box,color=blue];
		3983 -> 3984;
	3984 [label="拖把双胞胎哈哈",shape=box,color=blue];
		3984 -> 3985;
	3985 [label="但……我希望你是对的。我希望到最后，这是为了重建我们失去的一切。",shape=box,color=blue];
		3985 -> 3986;
	3986 [label="要不然，这还有什么意义呢？",shape=box,color=blue];
		3986 -> 3977;
}