digraph {
	"AoiRank6Convo3 begins." [color=orange];
		"AoiRank6Convo3 begins." -> j1417597976;
	j1417597976 [label="那个，有个问题",shape=box,color=blue];
		j1417597976 -> j3287651548;
	j3287651548 [label="你有一艘宇宙飞船",shape=box,color=blue];
		j3287651548 -> j2481448341;
		j3287651548 -> j3104731077;
		j3287651548 -> j3770216870;
	j2481448341 [label="然后呢？",shape=box,color=red];
		j2481448341 -> j1308441235;
	j3104731077 [label="实际上，我有好几艘。",shape=box,color=red];
		j3104731077 -> j3022734469;
	j3770216870 [label="我有。:)",shape=box,color=red];
		j3770216870 -> j1308441235;
	j1308441235 [label="它是怎么在行星之间穿梭的啊？",shape=box,color=blue];
		j1308441235 -> j912447882;
	j3022734469 [label="<RETRO_EMOJI_PASSGLASSES>",shape=box,color=blue];
		j3022734469 -> j1919391654;
		j3022734469 -> j2820534922;
	j912447882 [label="你们有……超级火箭吗？虫洞？你们是怎么飞这么远的？",shape=box,color=blue];
		j912447882 -> j3886622399;
	j1919391654 [label="<RETRO_EMOJI_YUM>",shape=box,color=red];
		j1919391654 -> j3940911357;
	j2820534922 [label="<RETRO_EMOJI_SUNGLASSES>",shape=box,color=red];
		j2820534922 -> j228614722;
	j3886622399 [label="还是说太阳帆？我父母正在琢磨怎么做",shape=box,color=blue];
		j3886622399 -> j4020460726;
		j3886622399 -> j71125008;
	j3940911357 [label="<RETRO_EMOJI_STARE>",shape=box,color=blue];
		j3940911357 -> j1279465415;
	j228614722 [label="+5 Chemistry",color=orange];
		j228614722 -> j1399375135;
	j4020460726 [label="你不会喜欢这个问题的答案。是奥罗金创造的航行方法。",shape=box,color=red];
		j4020460726 -> j2923629488;
	j71125008 [label="嗯，那得看情况。你是指我的“大船”还是“小船”？",shape=box,color=red];
		j71125008 -> j3220240956;
	j1279465415 [label="总之……",shape=box,color=blue];
		j1279465415 -> j3251525607;
	j1399375135 [label="哈哈 ^_^ 但是",shape=box,color=blue];
		j1399375135 -> j3251525607;
	j2923629488 [label="<RETRO_EMOJI_ANNOYED1>",shape=box,color=blue];
		j2923629488 -> j2685994686;
	j3220240956 [label="+5 Chemistry",color=orange];
		j3220240956 -> j333479504;
	j3251525607 [label="它们是怎么在行星之间穿梭的啊？",shape=box,color=blue];
		j3251525607 -> j912447882;
	j2685994686 [label="嗯……我想没有哪个社会是彻底坏的。",shape=box,color=blue];
		j2685994686 -> j57751951;
	j333479504 [label="<RETRO_EMOJI_WHOA>",shape=box,color=blue];
		j333479504 -> j2049744993;
	j57751951 [label="那么方法是什么？",shape=box,color=blue];
		j57751951 -> j2933582559;
	j2049744993 [label="都行！！！先从大船开始！！",shape=box,color=blue];
		j2049744993 -> j2141175355;
	j2933582559 [label="嗯，这取决于飞船是大船还是小船——但它们都利用虚空来跨越遥远的距离。它们穿越虚空。",shape=box,color=red];
		j2933582559 -> j725536904;
	j2141175355 [label="嗯，那是我的航道星舰。里面装着虚空无情之物的复制品手指——也就是圣物装置。",shape=box,color=red];
		j2141175355 -> j1885585646;
	j725536904 [label="那艘大船，也就是航道星舰，使用了一种叫做圣物装置的东西——里面有一根虚空无情之物断指的复制品。",shape=box,color=red];
		j725536904 -> j1596529365;
	j1885585646 [label="它利用这个东西进入虚空，跨越行星之间的巨大距离。它就是这样在虚空中穿梭的。",shape=box,color=red];
		j1885585646 -> j1596529365;
	j1596529365 [label="<RETRO_EMOJI_OHNO>",shape=box,color=blue];
		j1596529365 -> j1613642989;
	j1613642989 [label="不好意思",shape=box,color=blue];
		j1613642989 -> j855251338;
	j855251338 [label="什么",shape=box,color=blue];
		j855251338 -> j1927866186;
		j855251338 -> j606167900;
	j1927866186 [label="长；懒看：阿尔布雷希特进入虚空，惊慌失措，最后还偷走了虚空无情之物的手指。",shape=box,color=red];
		j1927866186 -> j1771972703;
	j606167900 [label="嗯。好吧。是这样。阿尔布雷希特……是第一个“发现”如何进入虚空的人。",shape=box,color=red];
		j606167900 -> j2940501929;
	j1771972703 [label="首先……长；懒看：？",shape=box,color=blue];
		j1771972703 -> j3533219574;
	j2940501929 [label="算是一个潜水钟舱吧。由一种叫做玻璃窗的东西制成。他撑开了连接两个世界的薄膜。",shape=box,color=red];
		j2940501929 -> j2761565373;
	j3533219574 [label="太长了；懒得看。昆西教我的。",shape=box,color=red];
		j3533219574 -> j3471937699;
	j2761565373 [label="事情……说得好听一点，就是出了问题。他惊慌失措，踉跄了一下，那东西歪了过去，撞到了薄膜锋利的边缘。",shape=box,color=red];
		j2761565373 -> j1253901872;
	j3471937699 [label="呵……",shape=box,color=blue];
		j3471937699 -> j1231828143;
	j1253901872 [label="玻璃钟舱碎裂，他坠入虚空。",shape=box,color=red];
		j1253901872 -> j1474404889;
	j1231828143 [label="其次",shape=box,color=blue];
		j1231828143 -> j318850201;
	j1474404889 [label="当他醒来时，他回到了实验室，只是那不再是他的实验室。他盯着自己，只不过那不再是他自己。“他”给他自己起了个只有他妈妈才知道的名字。",shape=box,color=red];
		j1474404889 -> j1682904878;
	j318850201 [label="****你有它的手指？！？！？！****",shape=box,color=blue];
		j318850201 -> j468251676;
	j1682904878 [label="于是，阿尔布雷希特拼命逃命。破碎的玻璃窗划伤了他，他用自己的血，写下了让他女儿关闭他身后那层膜质的字——",shape=box,color=red];
		j1682904878 -> j2065179356;
	j468251676 [label="你还用它来给你的航道星舰提供动力？！？！",shape=box,color=blue];
		j468251676 -> j157072906;
	j2065179356 [label="——因为他能感觉到那个“人”正在接近他。",shape=box,color=red];
		j2065179356 -> j2686400200;
	j157072906 [label="<RETRO_EMOJI_HORRIFIED>",shape=box,color=blue];
		j157072906 -> j1567210672;
	j2686400200 [label="她照做了。当门关上的时候？嗯……它的手指被切断了，掉在地板上。",shape=box,color=red];
		j2686400200 -> j2480227638;
	j1567210672 [label="也许这就是它生气的原因！！！",shape=box,color=blue];
		j1567210672 -> j3188819415;
		j1567210672 -> j593792280;
	j2480227638 [label="……哇哦……",shape=box,color=blue];
		j2480227638 -> j471264516;
	j3188819415 [label="它不仅为航道星舰提供动力，还为其他很多东西提供动力，这就是问题所在……",shape=box,color=red];
		j3188819415 -> j2312653196;
	j593792280 [label="也许吧。",shape=box,color=red];
		j593792280 -> j1954243615;
	j471264516 [label="首先：真是个难以置信的故事……",shape=box,color=blue];
		j471264516 -> j1231828143;
	j2312653196 [label="哦……",shape=box,color=blue];
		j2312653196 -> j2243500504;
		j2312653196 -> j2305433714;
	j1954243615 [label="你就不能把它还回去吗？！",shape=box,color=blue];
		j1954243615 -> j2243500504;
		j1954243615 -> j2305433714;
	j2243500504 [label="我……不知道那些手指在哪里。",shape=box,color=red];
		j2243500504 -> j2247032389;
	j2305433714 [label="我不知道这是不是个好主意？",shape=box,color=red];
		j2305433714 -> j2247032389;
	j2247032389 [label="但它们被拿走了……",shape=box,color=blue];
		j2247032389 -> j892762177;
		j2247032389 -> j1370061440;
	j892762177 [label="即使我们知道它们在哪里，我也不知道我们是否应该把它们还回去。",shape=box,color=red];
		j892762177 -> j3932163649;
	j1370061440 [label="我知道。我也觉得这样做不对。",shape=box,color=red];
		j1370061440 -> j3918734862;
	j3932163649 [label="你这话是什么意思？",shape=box,color=blue];
		j3932163649 -> j3287993812;
		j3932163649 -> j3361684625;
	j3918734862 [label="但不幸的是，损失已经造成。阿尔布雷希特拿走了手指。现在已经无法挽回了。",shape=box,color=red];
		j3918734862 -> j3932163649;
	j3287993812 [label="那个“时间丝线”有点特别。可以说超级复杂？说到特别之处……我也说不上来？",shape=box,color=red];
		j3287993812 -> j2907204079;
	j3361684625 [label="我不知道把它们还回去会不会有什么好处。我觉得这不会改变他的想法。",shape=box,color=red];
		j3361684625 -> j2580356821;
	j2907204079 [label="就把它困在这里？让它待在我们的地盘上？我们手上有它的手指，它就只能按照我们的规矩来。",shape=box,color=red];
		j2907204079 -> j3873123481;
	j2580356821 [label="我想伤害已经造成了，没办法了。 ",shape=box,color=red];
		j2580356821 -> j3873123481;
	j3873123481 [label="……我不喜欢这样",shape=box,color=blue];
		j3873123481 -> j917670136;
	j917670136 [label="太空旅行本该是……有趣、酷炫、充满……探索，还有遇到新物种",shape=box,color=blue];
		j917670136 -> j3834464039;
	j3834464039 [label="大胆地去某个地方，我也不知道，反正就像阿米尔看的那些节目里讲过的一大段话",shape=box,color=blue];
		j3834464039 -> j824055960;
	j824055960 [label="只是这本应是关于……人性、同情心、学习和冒险",shape=box,color=blue];
		j824055960 -> j281158666;
	j281158666 [label="而不是……像这样",shape=box,color=blue];
		j281158666 -> j3391426048;
		j281158666 -> j2499538805;
	j3391426048 [label="我想，谁也不知道。但时间会给出答案。",shape=box,color=red];
		j3391426048 -> j3081942869;
	j2499538805 [label="有时候我会想，这难道不正是英择谛的本意吗？把我送回到这里，和你们所有人一起。",shape=box,color=red];
		j2499538805 -> j2268430573;
	j3081942869 [label="<RETRO_EMOJI_GIVELOVE>",shape=box,color=blue];
		j3081942869 -> j1360684079;
	j2268430573 [label="或者去什么地方，去帮助……治愈人们。",shape=box,color=red];
		j2268430573 -> j1519501641;
	j1360684079 [label="是的，无论如何，时间都会给出答案",shape=box,color=blue];
		j1360684079 -> j3845784796;
	j1519501641 [label="就算只是为了收拾他留下来的烂摊子，从某种程度上来说，这也是为了给宇宙带来你所说的同情心。",shape=box,color=red];
		j1519501641 -> j2279164702;
	j3845784796 [label="那么，你接下来想听听有关星际航道的事吗？",shape=box,color=red];
		j3845784796 -> j1189716771;
	j2279164702 [label="但我只能希望，最终一切都会好起来。而且不是我拿着拖把桶追着一个疯子跑。",shape=box,color=red];
		j2279164702 -> j2533268198;
	j1189716771 [label="哈哈，不了",shape=box,color=blue];
		j1189716771 -> "Chat ends.";
	j2533268198 [label="+5 Chemistry",color=orange];
		j2533268198 -> j4115696714;
	"Chat ends." [color=orange];
	j4115696714 [label="好吧，如果这就是你要做的，我会和你在一起！",shape=box,color=blue];
		j4115696714 -> j1730799150;
	j1730799150 [label="<RETRO_EMOJI_TWOHUGS>",shape=box,color=blue];
		j1730799150 -> j917816948;
	j917816948 [label="拖把双胞胎哈哈",shape=box,color=blue];
		j917816948 -> j370977480;
	j370977480 [label="但……我希望你是对的。我希望到最后，这是为了重建我们失去的一切。",shape=box,color=blue];
		j370977480 -> j1890657158;
	j1890657158 [label="要不然，这还有什么意义呢？",shape=box,color=blue];
		j1890657158 -> j3845784796;
}