digraph {
	3063 [label="AoiRank5Convo1 begins.",color=orange];
		3063 -> 3064;
	3064 [label="我还没跟你说声谢谢你，你对埃莉诺那么好",shape=box,color=blue];
		3064 -> 3065;
	3065 [label="所以谢谢你 <3",shape=box,color=blue];
		3065 -> 3071;
		3065 -> 3070;
		3065 -> 3072;
	3071 [label="你不需要谢我，但很高兴你这么说。",shape=box,color=red];
		3071 -> 3069;
	3070 [label="当然。她可是六人组的一员。",shape=box,color=red];
		3070 -> 3069;
	3072 [label="你担心我会对她刻薄吗？",shape=box,color=red];
		3072 -> 3069;
	3069 [label="你不是六人组中第一个对埃莉诺产生戒心的人。相信我，我爱六人组中的每一个人，所以我能理解——但我也会努力让你改变想法。",shape=box,color=blue];
		3069 -> 3066;
		3069 -> 3067;
	3066 [label="有人怀疑埃莉诺？真的吗？",shape=box,color=red];
		3066 -> 3068;
	3067 [label="我很难相信亚瑟会容忍人们对他的姐姐存有戒心。",shape=box,color=red];
		3067 -> 3068;
	3068 [label="早些时候，莱蒂和昆西也对她有过怀疑，他们担心她会彻底变成科腐者。亚瑟不愿意听，所以他们保持了沉默，但其实或多或少我们都感受到了。但如果*我们*都能感觉得到，你可以想象对于埃莉诺来说，这种感觉多么敏感和清晰。",shape=box,color=blue];
		3068 -> 3074;
		3068 -> 3073;
		3068 -> 3075;
	3074 [label="感谢太阳神赐予我们像亚瑟这样的一位好弟弟。",shape=box,color=red];
		3074 -> 3076;
	3073 [label="总是知道别人在想什么，这对她来说一定是种煎熬。",shape=box,color=red];
		3073 -> 3077;
	3075 [label="我对莱蒂和昆西真的很失望。",shape=box,color=red];
		3075 -> 3077;
	3076 [label="他是的，对。但我觉得，这让埃莉诺当时的处境更难。他不顾一切地想要保护她，而她也知道，如果他认为她因感染而饱受痛苦，他可能会亲自出手解决此事。",shape=box,color=blue];
		3076 -> 3078;
		3076 -> 3079;
	3077 [label="他们只是害怕。恐惧会使人做出奇怪的行为。",shape=box,color=blue];
		3077 -> 3080;
		3077 -> 3081;
	3078 [label="你是说他可能……杀了他自己的姐姐？",shape=box,color=red];
		3078 -> 3082;
	3079 [label="恐惧会失去控制的感觉一定非常可怕。尤其是在亚瑟那样看顾她的情况下。",shape=box,color=red];
		3079 -> 3082;
	3080 [label="显然，自那以后这个团队已经有了很大的进步。",shape=box,color=red];
		3080 -> 3086;
	3081 [label="我希望当时的他们能够克服恐惧。",shape=box,color=red];
		3081 -> 3085;
	3082 [label="我从没认为他会杀了她，但埃莉诺却这么想。她为什么会这么想，那是她和亚瑟之间的事。我只是很高兴她不再那样想了。",shape=box,color=blue];
		3082 -> 3083;
		3082 -> 3084;
	3086 [label="我曾听人说过，真正让人们受到创伤的不是遭遇了什么，而是如何面对这些遭遇。在了解过莱蒂和昆西的内心世界后，我敢肯定，如果他们因为恐惧导致埃莉诺出事，他们绝对不会原谅自己。",shape=box,color=blue];
		3086 -> 3088;
		3086 -> 3087;
	3085 [label="+5 Chemistry",color=orange];
		3085 -> 3086;
	3083 [label="很难想象她除了面对每天的一切以外，还要承受如此巨大的恐惧。",shape=box,color=red];
		3083 -> 3089;
	3084 [label="她有没有因此差点离开？",shape=box,color=red];
		3084 -> 3090;
	3088 [label="真的差点发生那种情况吗？",shape=box,color=red];
		3088 -> 3090;
	3087 [label="我猜，很难怪他们，毕竟他们也是人。",shape=box,color=red];
		3087 -> 3090;
	3089 [label="+5 Chemistry",color=orange];
		3089 -> 3090;
	3090 [label="埃莉诺变化后，她很注意每个人的反应。我看得出她在权衡各种选择，觉得留下来可能弊大于利。她想要帮助六人组，但有些人看她的眼神让她怀疑自己是否应该在远处提供帮助。",shape=box,color=blue];
		3090 -> 3092;
		3090 -> 3091;
	3092 [label="这太荒谬了。像她那样有精神异能的人？简直是无价之宝。",shape=box,color=red];
		3092 -> 3094;
	3091 [label="这太不公平了。他们没看到她为了六人组愿意放弃多少。",shape=box,color=red];
		3091 -> 3093;
	3094 [label="她认为她可以远程使用她的能力，保持联系而不让我们因她的存在而感到负担。",shape=box,color=blue];
		3094 -> 3095;
		3094 -> 3096;
	3093 [label="+5 Chemistry",color=orange];
		3093 -> 3094;
	3095 [label="我明白了。她愿意为了让团队感到安全而牺牲与团队在一起的机会。",shape=box,color=red];
		3095 -> 3097;
	3096 [label="独自待在霍瓦尼亚会让她面临很大的危险。",shape=box,color=red];
		3096 -> 3097;
	3097 [label="有一天晚上，连阿米尔都已经睡下了，她真的差点就离开了。悄无声息地，在深夜。她甚至不想让我们为道别感到负担。",shape=box,color=blue];
		3097 -> 3098;
		3097 -> 3099;
		3097 -> 3100;
	3098 [label="真是令人心碎。",shape=box,color=red];
		3098 -> 3101;
	3099 [label="幸运的是，她显然没有这么做。",shape=box,color=red];
		3099 -> 3103;
	3100 [label="在那一刻，她一定感到非常孤独。",shape=box,color=red];
		3100 -> 3102;
	3101 [label="+5 Chemistry",color=orange];
		3101 -> 3103;
	3103 [label="我不愿意去想如果她真的走了会发生什么……但我一直在关注着她，试图陪伴在她身边。",shape=box,color=blue];
		3103 -> 3104;
	3102 [label="+5 Chemistry",color=orange];
		3102 -> 3103;
	3104 [label="你知道那种感觉吗？虽然你和某人在一起，但他们似乎心不在焉？他们的思绪总是飘忽不定，无论他们多么努力地想要专注？而我注意到了……",shape=box,color=blue];
		3104 -> 3105;
		3104 -> 3106;
	3105 [label="听起来你当时正是她所需要的人。",shape=box,color=red];
		3105 -> 3109;
	3106 [label="在团队的幸福方面，没有什么能逃过你的眼睛。",shape=box,color=red];
		3106 -> 3109;
	3109 [label="我不确定她保持距离是在学习如何控制她的精神异能，还是在刻意观察别人如何看待她。因此，我也开始关注她。",shape=box,color=blue];
		3109 -> 3108;
	3108 [label="我一感觉到她的原子摩托车启动，就锁定了车库里所有的原子摩托车，然后跑出去阻止她。",shape=box,color=blue];
		3108 -> 3107;
		3108 -> 3110;
	3107 [label="原来是你。你是她留下来的原因。",shape=box,color=red];
		3107 -> 3112;
	3110 [label="你真勇敢。",shape=box,color=red];
		3110 -> 3112;
	3112 [label="如果她真的想走，我会让她走的。但在没有和我来一场谈心之前，她是走不了的，哈哈。",shape=box,color=blue];
		3112 -> 3113;
		3112 -> 3111;
		3112 -> 3114;
	3113 [label="真是太符合你的风格了，哈哈。我猜那次谈心进行得不错吧？",shape=box,color=red];
		3113 -> 3116;
	3111 [label="我很高兴你当时陪在她身边。那一晚可能改变了她的一切。",shape=box,color=red];
		3111 -> 3116;
	3114 [label="那次谈心可能救了她——以及六人组。",shape=box,color=red];
		3114 -> 3116;
	3116 [label="哦，我们一直聊到天亮。由于阿米尔睡着了，我们甚至还玩了会儿弹球——就我们两个人。",shape=box,color=blue];
		3116 -> 3117;
	3117 [label="这又傻又有趣，却正是埃莉诺非常需要的那种快乐。",shape=box,color=blue];
		3117 -> 3118;
		3117 -> 3115;
	3118 [label="你是怎么让她相信一切都会好的？",shape=box,color=red];
		3118 -> 3119;
	3115 [label="有时候，最简单的事情可以带来最大的改变。",shape=box,color=red];
		3115 -> 3119;
	3119 [label="我不认为是我说的什么话起了作用，而是……我在那里。作为一个朋友。",shape=box,color=blue];
		3119 -> 3120;
	3120 [label="这是她变身后第一次有人让她知道，她不仅仅是亚瑟那个需要保护的脆弱姐姐。我认为那晚帮她意识到她能在六人组中找到自己的位置。",shape=box,color=blue];
		3120 -> 3121;
		3120 -> 3122;
	3121 [label="我很高兴你这么做了。她需要这样的支持。",shape=box,color=red];
		3121 -> 3123;
	3122 [label="碧，这才是真正的领导力。",shape=box,color=red];
		3122 -> 3123;
	3123 [label="说实话，我也需要。当我们知道自己属于哪里时，我们都会变得更坚强。",shape=box,color=blue];
		3123 -> 3124;
		3123 -> 3125;
	3124 [label="埃莉诺比人们想象的要坚强，但有你在她身边，一切都变得不同了。",shape=box,color=red];
		3124 -> 3126;
	3125 [label="嗯，我要赞扬你保持了团队的团结。",shape=box,color=red];
		3125 -> 3127;
	3126 [label="+5 Chemistry",color=orange];
		3126 -> 3127;
	3127 [label="我想我刚刚意识到，让你加入我们，我们可能会重演那段糟糕的过去",shape=box,color=blue];
		3127 -> 3128;
	3128 [label="但实际上并没有。你马上就理解了",shape=box,color=blue];
		3128 -> 3129;
	3129 [label="所以，谢谢你",shape=box,color=blue];
		3129 -> 3130;
		3129 -> 3132;
		3129 -> 3131;
		3129 -> 3133;
	3130 [label="埃莉诺值得被看到，她是个了不起的女人。",shape=box,color=red];
		3130 -> 3134;
	3132 [label="这没什么。我们得互相支持。",shape=box,color=red];
		3132 -> 3134;
	3131 [label="谢谢你在埃莉诺需要时支持她。",shape=box,color=red];
		3131 -> 3134;
	3133 [label="碧，你就是将这个团队凝聚在一起的粘合剂。",shape=box,color=red];
		3133 -> 3134;
	3134 [label="告诉你一声，你是我最喜欢的人之一 <3",shape=box,color=blue];
		3134 -> 3135;
	3135 [label="Chat ends.",color=orange];
}