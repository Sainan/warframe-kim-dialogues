digraph {
	2825 [label="AoiRank4Convo6 begins.",color=orange];
		2825 -> 2826;
	2826 [label="你给我讲了这么多关于奥罗金的可怕故事……有没有人曾经背弃过他们的生活方式？",shape=box,color=blue];
		2826 -> 2827;
		2826 -> 2828;
	2827 [label="信不信由你，阿尔布雷希特·英择谛博士做到了。",shape=box,color=red];
		2827 -> 2829;
	2828 [label="他们中大部分人最终都死了。但阿尔布雷希特·英择谛以自己的方式做到了。",shape=box,color=red];
		2828 -> 2830;
	2829 [label="咦惹。",shape=box,color=blue];
		2829 -> 2831;
	2830 [label="呃，那家伙。总是能死里逃生。",shape=box,color=blue];
		2830 -> 2831;
	2831 [label="我还希望是个……更酷的人呢。",shape=box,color=blue];
		2831 -> 2835;
		2831 -> 2834;
	2835 [label="很抱歉让你失望了。他就是那个人。拒绝使用能够让他们长生不老的赤毒。也没有选择那种时髦的长臂。统统没有。",shape=box,color=red];
		2835 -> 2833;
	2834 [label="嗯嗯……我得想一想有什么酷的奥罗金人。给我一分钟。",shape=box,color=red];
		2834 -> 2832;
	2833 [label="我敢肯定，他只会追求对他最有利的东西。",shape=box,color=blue];
		2833 -> 2836;
		2833 -> 2837;
	2832 [label="嗯，我猜，至少有你吧 ^_^",shape=box,color=blue];
		2832 -> 2836;
		2832 -> 2837;
		2832 -> 2838;
	2836 [label="你曾经尊敬过英择谛吗？",shape=box,color=red];
		2836 -> 2839;
	2837 [label="你对英择谛的真实看法是什么？除了“不酷”的评价以外。",shape=box,color=red];
		2837 -> 2840;
	2838 [label="哈哈。我不是奥罗金人。我只是来自他们的帝国。这完全不同。",shape=box,color=red];
		2838 -> 2841;
	2839 [label="嗯。现在提这种大问题了吗？我看你确实有资格问。",shape=box,color=blue];
		2839 -> 2843;
	2840 [label="我对这个人已经没有任何尊重可言了 ^_^",shape=box,color=blue];
		2840 -> 2843;
	2841 [label="哦哦。真让人困惑",shape=box,color=blue];
		2841 -> 2842;
	2843 [label="像他这样的人，只有在对自己有利的时候才会装出迷人的样子",shape=box,color=blue];
		2843 -> 2844;
		2843 -> 2845;
	2842 [label="不过我真的不喜欢英择谛。像他这样的人，只有在对自己有利的时候才会装出迷人的样子",shape=box,color=blue];
		2842 -> 2844;
		2842 -> 2845;
	2844 [label="你认为他真正追求的是什么？",shape=box,color=red];
		2844 -> 2846;
	2845 [label="所以你曾经觉得他很迷人。",shape=box,color=red];
		2845 -> 2847;
	2846 [label="控制。完全的支配。",shape=box,color=blue];
		2846 -> 2848;
	2847 [label="我不会这么说。更像是我本来是愿意尊重他的。",shape=box,color=blue];
		2847 -> 2849;
	2848 [label="而且不是以有趣的、流行歌星世界巡演那种方式。",shape=box,color=blue];
		2848 -> 2850;
	2849 [label="但他自己放弃了这个机会。",shape=box,color=blue];
		2849 -> 2850;
	2850 [label="他吞噬一切他所触及的东西。即使是整个宇宙对他来说也不够。",shape=box,color=blue];
		2850 -> 2851;
		2850 -> 2852;
		2850 -> 2853;
	2851 [label="你很早就知道这一点了吗？你是六人组中最有直觉的人。如果有人会有这种预感，那一定是你。",shape=box,color=red];
		2851 -> 2854;
	2852 [label="我倾向于同意你的看法。",shape=box,color=red];
		2852 -> 2854;
	2853 [label="我不确定。毕竟宇宙那么大。:P",shape=box,color=red];
		2853 -> 2856;
	2854 [label="+5 Chemistry",color=orange];
		2854 -> 2855;
	2856 [label="但他会尝试，这就是问题所在",shape=box,color=blue];
		2856 -> 2857;
	2855 [label="谢谢。^_^",shape=box,color=blue];
		2855 -> 2857;
	2857 [label="不是马上就有，但很早以前，每次他表现得很友好时，我总有一种不祥的预感，好像有什么坏事即将发生",shape=box,color=blue];
		2857 -> 2858;
	2858 [label="那时候，我不知道该怎么形容，但我总感觉所有的问题背后，幕后黑手都是他。",shape=box,color=blue];
		2858 -> 2859;
	2859 [label="但当他把你周围的每个人都骗过去时，你又能做什么呢？",shape=box,color=blue];
		2859 -> 2860;
		2859 -> 2861;
	2860 [label="你认为他真的骗过了所有人吗？",shape=box,color=red];
		2860 -> 2862;
	2861 [label="我猜你只能等他们自己看清楚了。",shape=box,color=red];
		2861 -> 2863;
	2862 [label="嗯，也许没有",shape=box,color=blue];
		2862 -> 2864;
	2863 [label="是啊",shape=box,color=blue];
		2863 -> 2865;
	2864 [label="更像是大家都太害怕，不敢去对抗他",shape=box,color=blue];
		2864 -> 2866;
	2865 [label="这种本能的友好就像我的诅咒一样",shape=box,color=blue];
		2865 -> 2867;
	2866 [label="这让我非常烦躁。",shape=box,color=blue];
		2866 -> 2868;
		2866 -> 2869;
	2867 [label="也许如果我当初说了些什么，更多的人会更早看穿他",shape=box,color=blue];
		2867 -> 2868;
		2867 -> 2869;
	2868 [label="如果这能让你感到一点安慰，他在我们那边也是这样。",shape=box,color=red];
		2868 -> 2870;
	2869 [label="你不是唯一一个。他对每个人都留下了痕迹。",shape=box,color=red];
		2869 -> 2871;
	2870 [label="这……我猜是喜忧参半吧。",shape=box,color=blue];
		2870 -> 2872;
		2870 -> 2873;
	2871 [label="呃。连未来也没法逃过那家伙的毒手。",shape=box,color=blue];
		2871 -> 2872;
		2871 -> 2873;
	2872 [label="他留下了一个女儿，而她还在拼命修补他破坏的一切。尽管她很生气，但我感觉她还是忍不住相信他。",shape=box,color=red];
		2872 -> 2874;
	2873 [label="是的。他让他的爱人留下来弥补他对无数人……和动物造成的伤害。",shape=box,color=red];
		2873 -> 2874;
	2874 [label="这就是他。这就是他的做事方式。",shape=box,color=blue];
		2874 -> 2875;
	2875 [label="他是我所接触过的唯一一个空虚的存在。",shape=box,color=blue];
		2875 -> 2876;
	2876 [label="当他找到想要的东西时，他会彻底地吞噬它，然后在用完后就抛弃它。总是以最无情、最自私的方式行事。",shape=box,color=blue];
		2876 -> 2877;
		2876 -> 2879;
		2876 -> 2882;
	2877 [label="是啊……“不酷”开始听起来像是轻描淡写了。",shape=box,color=red];
		2877 -> 2883;
	2879 [label="天啊，别憋着，说出来吧。",shape=box,color=red];
		2879 -> 2880;
	2882 [label="我觉得连喜欢他的人也不会否认这一点。",shape=box,color=red];
		2882 -> 2881;
	2883 [label="+5 Chemistry",color=orange];
		2883 -> 2878;
	2880 [label="我不得不承认，一想到这些我就会情绪很激动……",shape=box,color=blue];
		2880 -> 2884;
		2880 -> 2885;
		2880 -> 2886;
	2881 [label="请代我向未来所有受到他伤害的人问好。",shape=box,color=blue];
		2881 -> 2884;
		2881 -> 2885;
		2881 -> 2886;
	2878 [label="哈哈，我从未见过有谁比他更不酷的！",shape=box,color=blue];
		2878 -> 2884;
		2878 -> 2885;
		2878 -> 2886;
	2884 [label="如果我勾起了一些不愉快的回忆，对不起。",shape=box,color=red];
		2884 -> 2887;
	2885 [label="我们以后也没必要再谈论他了。",shape=box,color=red];
		2885 -> 2887;
	2886 [label="当碧开始用句号而不是表情符号时，你就知道事情很严重了。",shape=box,color=red];
