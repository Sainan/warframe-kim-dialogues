	2887 [label="不，没关系……",shape=box,color=blue];
		2887 -> 2889;
	2888 [label="哈哈，你这么懂我真有点吓人",shape=box,color=blue];
		2888 -> 2889;
	2889 [label="看，当我想到那个博士时，我都会想起我第一次在亚瑟眼中看到的恐惧",shape=box,color=blue];
		2889 -> 2890;
	2890 [label="我会想起阿米尔的恐慌发作，埃莉诺说不出话，昆西变得铁石心肠，而莱蒂不知所措，无法拯救她周围的人",shape=box,color=blue];
		2890 -> 2891;
