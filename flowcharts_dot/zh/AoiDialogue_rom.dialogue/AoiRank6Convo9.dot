		j433187176 -> j2713702632;
		j433187176 -> j862616160;
	j3238944517 [label="哈哈哈哈。",shape=box,color=red];
		j3238944517 -> "Chat ends.";
	j2713702632 [label="嗷。:) 但是企鹅托托是什么？",shape=box,color=red];
		j2713702632 -> j3369513991;
	j862616160 [label="太可爱了！但他到底是*什么*？",shape=box,color=red];
		j862616160 -> j3369513991;
	j3369513991 [label="讲出来可能会暴露我年龄，但他是初代三只吉尼梦之一",shape=box,color=blue];
		j3369513991 -> j1989134745;
	j1989134745 [label="就是，在他们还没在自由国推出之前，什么的",shape=box,color=blue];
		j1989134745 -> j3361223159;
	j3361223159 [label="你只能在基潘古买到他们，而且没有翻译",shape=box,color=blue];
		j3361223159 -> j3554309607;
	j3554309607 [label="所以住在卡纳塔的时候很难买到他们，当我得到他们时，他们就像我珍贵的财产一样，你知道吗？",shape=box,color=blue];
		j3554309607 -> j1422458216;
	j1422458216 [label="也是一些我和我父母故乡的记忆",shape=box,color=blue];
		j1422458216 -> j333755193;
	j333755193 [label="呵呵，所以企鹅托托是我的小伙伴",shape=box,color=blue];
		j333755193 -> j3609852741;
	j3609852741 [label="无论走到哪里，都带给我家的感觉",shape=box,color=blue];
		j3609852741 -> j100802857;
		j3609852741 -> j1669253027;
	j100802857 [label="我想阿米尔超级喜欢吉尼梦。",shape=box,color=red];
		j100802857 -> j1056645530;
	j1669253027 [label="我想卡娅非常喜欢吉尼梦。",shape=box,color=red];
		j1669253027 -> j1815751761;
	j1056645530 [label="我知道这太棒了我们一直在玩",shape=box,color=blue];
