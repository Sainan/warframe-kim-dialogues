	j4173205701 [label="有困扰到？不过没关系",shape=box,color=blue];
		j4173205701 -> j150183946;
	j1835782584 [label="尤其是在他经历了这一切之后？！你能想象吗？",shape=box,color=blue];
		j1835782584 -> j1232797150;
	j2911578263 [label="哈哈，当个青少年就已经够糟糕的了，不需要再经历其他的事情，你知道吗？",shape=box,color=blue];
		j2911578263 -> j495925286;
	j150183946 [label="我不会为此而发疯，这是她的权利",shape=box,color=blue];
		j150183946 -> j256859168;
	j1232797150 [label="<RETRO_EMOJI_TWOHUGS>",shape=box,color=blue];
		j1232797150 -> j2588762252;
	j495925286 [label="在那个年纪，我不知道自己是谁。毫无头绪。完全迷失了方向。我所做的就是努力成为那个别人希望我成为的人。",shape=box,color=blue];
		j495925286 -> j3093817189;
	j2588762252 [label="我……不记得我们之前发生的一切了",shape=box,color=blue];
		j2588762252 -> j723740645;
	j3093817189 [label="如果加上发生在她身上的事？",shape=box,color=blue];
		j3093817189 -> j2110283359;
	j723740645 [label="就像一场梦。你知道吗，有时候我会做噩梦。但当我醒来时，一切都消失了，大家都还在。",shape=box,color=blue];
		j723740645 -> j3189784895;
	j2110283359 [label="再加上世界末日？",shape=box,color=blue];
		j2110283359 -> j3954549135;
	j3189784895 [label="但当他们醒来…… :(",shape=box,color=blue];
		j3189784895 -> j2227415788;
	j3954549135 [label="如果她不想喜欢我，那完全没问题，哈哈",shape=box,color=blue];
		j3954549135 -> j2850540261;
	j2227415788 [label="我在国危部失去了很多朋友……很多很多。但你投入战斗时就知道会发生这种事",shape=box,color=blue];
		j2227415788 -> j1808828702;
	j2850540261 [label="但如果她想要朋友或者需要我，我随时都在",shape=box,color=blue];
		j2850540261 -> j3522956452;
	j1808828702 [label="弗莱尔是一名音乐家。他们想要做的就是创造艺术并改变世界……",shape=box,color=blue];
		j1808828702 -> j1736156132;
