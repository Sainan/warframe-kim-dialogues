		j390291563 -> j3776734052;
	j5787598 [label="我想她不太喜欢我",shape=box,color=blue];
		j5787598 -> j1456116676;
		j5787598 -> j1402972537;
	j3776734052 [label="我很高兴他在这里！！哦我的天真正的音乐家",shape=box,color=blue];
		j3776734052 -> j3225366970;
	j1456116676 [label="说真的，我认为她谁都不太喜欢。",shape=box,color=red];
		j1456116676 -> j256859168;
	j1402972537 [label="这很困扰你吗？",shape=box,color=red];
