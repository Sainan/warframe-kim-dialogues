		j379056631 -> "Chat ends.";
	j1431201578 [label="我想跟你说件事，我想先确定你能接受。",shape=box,color=red];
		j1431201578 -> j3608421973;
	j3608421973 [label="对我来说重要的是，你不会觉得我在对你撒谎，或者对你不坦诚。",shape=box,color=red];
		j3608421973 -> j3945152840;
	j3945152840 [label="<RETRO_EMOJI_OHNO>",shape=box,color=blue];
		j3945152840 -> j3453261670;
	j3453261670 [label="我做了什么吗？",shape=box,color=blue];
		j3453261670 -> j1946066733;
	j1946066733 [label="不是！不是。我只是想跟你说点事，希望不会让你觉得不舒服。",shape=box,color=red];
		j1946066733 -> j1672734534;
	j1672734534 [label="我不想让你陷入一种你无法接受的情况。我知道我们之前没有讨论过这件事。所以如果你拒绝，那也没关系。我希望你清楚这一点。",shape=box,color=red];
		j1672734534 -> j4246447291;
	j4246447291 [label="我们之间的感情对我很重要——非常重要——而且它是真实的。我不希望你怀疑这一点。",shape=box,color=red];
		j4246447291 -> j2307566148;
	j2307566148 [label="哦————",shape=box,color=blue];
		j2307566148 -> j3492329019;
	j3492329019 [label="(っᵔ◡ᵔ)っ(˶ᵔ ᵕ ᵔ˶)",shape=box,color=blue];
		j3492329019 -> j438448084;
