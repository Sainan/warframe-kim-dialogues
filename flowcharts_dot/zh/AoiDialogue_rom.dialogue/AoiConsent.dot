	4251 [label="嘿嘿！！ <RETRO_EMOJI_HAPPY2>",shape=box,color=blue];
		4251 -> 4253;
	4250 [label="Update boolean AoiConsentComplete",color=orange];
		4250 -> 4252;
	4253 [label="我想跟你说件事，我想先确定你能接受。",shape=box,color=red];
		4253 -> 4254;
	4252 [label="Chat ends.",color=orange];
	4254 [label="对我来说重要的是，你不会觉得我在对你撒谎，或者对你不坦诚。",shape=box,color=red];
		4254 -> 4255;
	4255 [label="<RETRO_EMOJI_OHNO>",shape=box,color=blue];
		4255 -> 4256;
	4256 [label="我做了什么吗？",shape=box,color=blue];
		4256 -> 4257;
	4257 [label="不是！不是。我只是想跟你说点事，希望不会让你觉得不舒服。",shape=box,color=red];
		4257 -> 4258;
	4258 [label="我不想让你陷入一种你无法接受的情况。我知道我们之前没有讨论过这件事。所以如果你拒绝，那也没关系。我希望你清楚这一点。",shape=box,color=red];
		4258 -> 4259;
	4259 [label="我们之间的感情对我很重要——非常重要——而且它是真实的。我不希望你怀疑这一点。",shape=box,color=red];
		4259 -> 4260;
	4260 [label="哦————",shape=box,color=blue];
		4260 -> 4261;
	4261 [label="(っᵔ◡ᵔ)っ(˶ᵔ ᵕ ᵔ˶)",shape=box,color=blue];
		4261 -> 4262;
	4262 [label="我明白了，呵呵呵",shape=box,color=blue];
		4262 -> 4263;
	4263 [label="<RETRO_EMOJI_WINK>",shape=box,color=blue];
		4263 -> 4265;
		4263 -> 4264;
	4265 [label="真的吗？",shape=box,color=red];
		4265 -> 4266;
	4264 [label="哈……？",shape=box,color=red];
		4264 -> 4266;
	4266 [label="嗯哼！！",shape=box,color=blue];
		4266 -> 4267;
	4267 [label="我觉得我只想知道我有没有机会认识他？",shape=box,color=blue];
		4267 -> 4268;
	4268 [label="哦……不会是……不会是六人组里的一个人吧，是吗？还是老圆桌里的一个？那可能会有点恶心",shape=box,color=blue];
		4268 -> 4269;
	4269 [label="不，你不会认识他的。很遗憾，我不知道能不能安排你们见面。他不是这个时代的。",shape=box,color=red];
		4269 -> 4270;
	4270 [label="可恶！！那你得答应我，为了我你要享受双倍的开心，哈哈",shape=box,color=blue];
		4270 -> 4271;
	4271 [label="那他能让你开心吗？",shape=box,color=blue];
		4271 -> 4272;
	4272 [label="能。而我对你的关心也没有变少。你们两个对我都很重要。",shape=box,color=red];
		4272 -> 4273;
