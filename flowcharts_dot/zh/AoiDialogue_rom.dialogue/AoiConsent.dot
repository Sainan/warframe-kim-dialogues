		j2062834982 -> j678852386;
		j2062834982 -> j1963840552;
	j678852386 [label="真的吗？",shape=box,color=red];
		j678852386 -> j1016968822;
	j1963840552 [label="哈……？",shape=box,color=red];
		j1963840552 -> j1016968822;
	j1016968822 [label="嗯哼！！",shape=box,color=blue];
		j1016968822 -> j2473312418;
	j2473312418 [label="我只想知道我有没有机会认识他？",shape=box,color=blue];
		j2473312418 -> j3878407040;
	j3878407040 [label="哦……不会是……不会是六人组里的谁吧，是吗？还是老圆桌里的一个？那样的话可能会有点恶心？挺喜欢他们的，就是过去的事太多了，你懂的。",shape=box,color=blue];
		j3878407040 -> j992199403;
	j992199403 [label="不，你不会认识他的。很遗憾，我不知道能不能安排你们见面。他不是这个时代的。",shape=box,color=red];
		j992199403 -> j4156130121;
	j4156130121 [label="可恶！！那你得答应我，为了我你要享受双倍的开心，哈哈",shape=box,color=blue];
		j4156130121 -> j492025465;
	j492025465 [label="那他能让你开心吗？",shape=box,color=blue];
		j492025465 -> j2582063336;
	j2582063336 [label="能。而我对你的关心也没有变少。你们两个对我都很重要。",shape=box,color=red];
