digraph {
	3513 [label="AoiRank5Convo5 begins.",color=orange];
		3513 -> 3514;
		3513 -> 3515;
	3514 [label="我真的很佩服你对于建设更美好世界的坚定承诺。这种信念来自哪里？",shape=box,color=red];
		3514 -> 3516;
	3515 [label="你总是干劲十足。是什么点燃了你内心的火焰？",shape=box,color=red];
		3515 -> 3516;
	3516 [label="哦，哇，谢谢你这么说。呃……嗯。没有什么重大的决定性时刻影响了我的人生道路。",shape=box,color=blue];
		3516 -> 3517;
	3517 [label="据我所知，我从父母那里继承了这种精神。他们是务实的人，但也是梦想家。",shape=box,color=blue];
		3517 -> 3518;
	3518 [label="我的意思是，如果你不是一个梦想家，你就不会去造火箭探索太空的。",shape=box,color=blue];
		3518 -> 3519;
		3518 -> 3520;
		3518 -> 3521;
	3519 [label="等等，你的父母是造火箭的？",shape=box,color=red];
		3519 -> 3522;
	3520 [label="这可真是个不得了的家族事业。听起来他们把标准定得很高。",shape=box,color=red];
		3520 -> 3523;
	3521 [label="这可不是普通的家族传统。他们有没有提到是什么激励了他们？",shape=box,color=red];
		3521 -> 3524;
	3522 [label="嗯，爸爸造。妈妈也懂得怎么造。",shape=box,color=blue];
		3522 -> 3525;
	3523 [label="是的……当我成为一名士兵时，他们很明确地表示这并不是他们希望为我提供的生活。",shape=box,color=blue];
		3523 -> 3525;
	3524 [label="说的不多。他们不喜欢公开分享他们的梦想。我觉得他们相信自己对世界的贡献足以说明一切。",shape=box,color=blue];
		3524 -> 3525;
	3525 [label="爸爸是一名航天工程师，妈妈在他们相识的大学里教空间系统设计。",shape=box,color=blue];
		3525 -> 3527;
		3525 -> 3526;
		3525 -> 3528;
	3527 [label="哇，你们家一部分是智囊团，一部分是发射台。",shape=box,color=red];
		3527 -> 3530;
	3526 [label="和他们交谈一定非常有趣。",shape=box,color=red];
		3526 -> 3529;
	3528 [label="听起来他们很聪明。在这样的环境中成长一定很不同寻常。",shape=box,color=red];
		3528 -> 3529;
	3530 [label="哈哈，其实不是。大多数时间，我们家都很安静。",shape=box,color=blue];
		3530 -> 3531;
	3529 [label="是啊，我想是这样",shape=box,color=blue];
		3529 -> 3532;
	3531 [label="我们大多数的对话是在碰到时说上几句的“嘿，宝贝”和“嗨”，他们会随便吃点东西，然后就回办公室继续熬夜工作",shape=box,color=blue];
		3531 -> 3533;
	3532 [label="我们的交流大多是在厨房碰到时说上几句的“嘿，宝贝”和“嗨”，他们会随便吃点东西，然后就回办公室继续熬夜工作",shape=box,color=blue];
		3532 -> 3533;
	3533 [label="他们很忙",shape=box,color=blue];
		3533 -> 3534;
	3534 [label="只要我不惹麻烦，他们就不太担心我。虽然我内心有很多激情，但我真的很擅长避免惹麻烦。",shape=box,color=blue];
		3534 -> 3535;
		3534 -> 3536;
		3534 -> 3537;
	3535 [label="我能理解。我的父母也总是很忙。运行扎里曼号飞船需要每个人全身心投入。不过，至少我们总能抽出时间一起吃饭。",shape=box,color=red];
		3535 -> 3538;
	3536 [label="这很合理。当工作那么忙碌时，剩下的时间并不多，但我敢打赌他们一直在想你。",shape=box,color=red];
		3536 -> 3539;
	3537 [label="我能理解他们。我自己就经历过，太空旅行几乎不留给人休息时间。看起来你的懂事让他们省了不少心",shape=box,color=red];
		3537 -> 3540;
	3538 [label="+5 Chemistry",color=orange];
		3538 -> 3541;
	3539 [label="+5 Chemistry",color=orange];
		3539 -> 3542;
	3540 [label="嗯，我想我确实有帮到他们。",shape=box,color=blue];
		3540 -> 3545;
	3541 [label="那真好。我很高兴他们这么做。",shape=box,color=blue];
		3541 -> 3543;
	3542 [label="可能吧",shape=box,color=blue];
		3542 -> 3544;
	3545 [label="我希望是这样。",shape=box,color=blue];
		3545 -> 3546;
	3543 [label="现在我意识到那些时刻有多珍贵，但在我成长的时候并没多少这样的时刻，却一点都不觉得奇怪。",shape=box,color=blue];
		3543 -> 3546;
	3544 [label="其实，我觉得确实是这样 :)",shape=box,color=blue];
		3544 -> 3546;
	3546 [label="我能理解为什么我的父母那么专注于他们的工作。在他们看来，这是他们表达爱的方式。他们希望为我提供生活保障，同时为人类能拥有更好的未来创造科技",shape=box,color=blue];
		3546 -> 3547;
	3547 [label="回想起来，这其实挺美好的",shape=box,color=blue];
		3547 -> 3548;
		3547 -> 3549;
		3547 -> 3550;
	3548 [label="也许是这样，他们的女儿没能多陪陪他们，这让我心里很不是滋味。你知道，我们的人生时间有限。我们应该尽可能多地和我们爱的人在一起。",shape=box,color=red];
		3548 -> 3551;
	3549 [label="确实美好，但也很实际。他们做的是有意义的事情，没有什么比这更重要的了。",shape=box,color=red];
		3549 -> 3554;
	3550 [label="这也是一种强大的爱，即使它不是那种会在围坐在餐桌上体现出来的爱。",shape=box,color=red];
		3550 -> 3552;
	3551 [label="+5 Chemistry",color=orange];
		3551 -> 3553;
	3554 [label="但我还是忍不住想到我们在一起度过的时间并不多。",shape=box,color=blue];
		3554 -> 3556;
	3552 [label="+5 Chemistry",color=orange];
		3552 -> 3555;
	3553 [label="“尽可能多”这个部分确实很棘手，不是吗？很难具体衡量",shape=box,color=blue];
		3553 -> 3556;
	3556 [label="如果我还能再次见到他们，我一定会弥补失去的时光。我相信他们也会的。",shape=box,color=blue];
		3556 -> 3563;
		3556 -> 3558;
		3556 -> 3561;
	3555 [label="对！这不是电影里看到的那种，但非常真实。",shape=box,color=blue];
		3555 -> 3556;
	3563 [label="说得对。现在就别浪费时间去难过了。他们做出了他们的选择，你也做出了你的选择。看起来你已经很好地运用了他们给你的东西。",shape=box,color=red];
		3563 -> 3564;
	3558 [label="你知道，你那种想要让世界变得更好的驱动力……其实比你自己想象的还要深。你应该为此感到自豪。",shape=box,color=red];
		3558 -> 3557;
	3561 [label="我希望你能有这个机会。你的心中充满了希望和力量。我想他们会为你现在的样子感到骄傲。",shape=box,color=red];
		3561 -> 3560;
	3564 [label="我想是的。",shape=box,color=blue];
		3564 -> 3567;
		3564 -> 3566;
		3564 -> 3565;
	3557 [label="+5 Chemistry",color=orange];
		3557 -> 3559;
	3560 [label="+5 Chemistry",color=orange];
		3560 -> 3562;
	3567 [label="你有他们的才智和决心，但你已经将它们融入到你的个性中。这才是最重要的。",shape=box,color=red];
		3567 -> 3570;
	3566 [label="在我看来，你已经成长为你小时候渴望拥有的那种充满爱心、体贴的人。这是值得骄傲的事情。",shape=box,color=red];
		3566 -> 3568;
	3565 [label="你不仅是用梦想和驱动力，还有同情心，将他们给予你的一切都发扬光大。这并不容易做到。",shape=box,color=red];
		3565 -> 3569;
	3559 [label="哦？怎么说？",shape=box,color=blue];
		3559 -> 3567;
		3559 -> 3566;
		3559 -> 3565;
	3562 [label="这对我真的很重要。我也这么希望。",shape=box,color=blue];
		3562 -> 3567;
		3562 -> 3566;
		3562 -> 3565;
	3570 [label="这……实际上是一个非常酷的思考方式。",shape=box,color=blue];
		3570 -> 3573;
		3570 -> 3572;
		3570 -> 3574;
	3568 [label="+5 Chemistry",color=orange];
		3568 -> 3571;
	3569 [label="+5 Chemistry",color=orange];
		3569 -> 3571;
	3573 [label="我只是说出我所看到的。",shape=box,color=red];
		3573 -> 3575;
	3572 [label="不客气。",shape=box,color=red];
		3572 -> 3575;
	3574 [label="你值得被这样表扬。",shape=box,color=red];
		3574 -> 3575;
	3571 [label="我以前从来没有这样想过。这真是一个很美好的看法。谢谢你。",shape=box,color=blue];
		3571 -> 3573;
		3571 -> 3572;
		3571 -> 3574;
	3575 [label="<3",shape=box,color=blue];
		3575 -> 3576;
	3576 [label="Chat ends.",color=orange];
}