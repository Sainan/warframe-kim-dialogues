	2271 [label="<RETRO_EMOJI_WHOA>",shape=box,color=blue];
		2271 -> 2273;
	2343 [label="是这个时间线上的我，因为被困在月球上的一个冷冻舱里而没有变老，后来 Lotus 为了保护大家安全，把月球和那个孩子放进了虚空一段时间。她最后救了我——",shape=box,color=red];
		2343 -> 2345;
	2344 [label="对。嗯。所以，严格来说，我来自另一个时间线。另一个版本的我没那么老，因为……你知道的？这个故事很长。",shape=box,color=red];
		2344 -> 3059;
	2365 [label="当我在双衍王境的时候，我……被困住了。变得麻木。我忘记了我是谁。也忘了我为什么在那里。",shape=box,color=red];
		2365 -> 2367;
	2366 [label="有时候，当你人生跌到谷底时……你只需要一只援手。",shape=box,color=red];
		2366 -> 2368;
	2285 [label="你知道我怎么使用传识来操控你吧？我也可以在奥金魇龙身上使用传识。这*真的*很奇怪。",shape=box,color=red];
		2285 -> 2287;
	2286 [label="当它们不在试图杀死你的时候，它们确实很酷。",shape=box,color=red];
		2286 -> 2289;
	2274 [label="我们有一个邪恶的孩子国王，名叫士魂大帝。",shape=box,color=red];
		2274 -> 2279;
	2275 [label="我们有一大堆角色，每个角色都有着自己悲惨的背景故事。每个角色都代表着一种情感。",shape=box,color=red];
		2275 -> 2280;
	2273 [label="龙？！真的是字面上的龙？！？！",shape=box,color=blue];
