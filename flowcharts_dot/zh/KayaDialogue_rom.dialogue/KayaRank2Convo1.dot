digraph {
	"KayaRank2Convo1 begins." [color=orange];
		"KayaRank2Convo1 begins." -> j1602493170;
	j1602493170 [label="嘿，卡娅！",shape=box,color=red];
		j1602493170 -> j1480267502;
	j1480267502 [label="Nova，在网上，我用 Nova 这个名字。",shape=box,color=blue];
		j1480267502 -> j3132455403;
		j1480267502 -> j756824932;
	j3132455403 [label="好的，那就叫你 Nova。 ",shape=box,color=red];
		j3132455403 -> j3036945251;
	j756824932 [label="这样啊。从什么时候开始的？",shape=box,color=red];
		j756824932 -> j1395790043;
	j3036945251 [label="嗯，谢谢，只是别在网上叫我卡娅。你可以当面这样叫我，但在这里：叫我 NOVA。可以吗？",shape=box,color=blue];
		j3036945251 -> j351697293;
		j3036945251 -> j2251499838;
	j1395790043 [label="嗯，这重要吗？毕竟这是互联网，我更倾向于不用真名。",shape=box,color=blue];
		j1395790043 -> j1014083513;
		j1395790043 -> j1344625270;
	j351697293 [label="可以。但我能问问为什么吗？",shape=box,color=red];
		j351697293 -> j3492516415;
	j2251499838 [label="明白了。Nova。Nova。对了。我想问一下：我能做些什么让你在这里感觉更自在一些吗？",shape=box,color=red];
		j2251499838 -> j1372231517;
	j1014083513 [label="也是，你肯定不想让人知道你有多常问我关于时间旅行的事。",shape=box,color=red];
		j1014083513 -> j1677213537;
	j1344625270 [label="哦？我很确定阿米尔已经把这个网络加固得很好了，除非我没注意到什么？",shape=box,color=red];
		j1344625270 -> j3353738814;
	j3492516415 [label="你问过其他人喜欢什么昵称吗？赶紧适应吧。 ",shape=box,color=blue];
		j3492516415 -> j2251499838;
	j1372231517 [label="我知道我们谁都不想‘待在’这种临时的家，但我们都在尽力了。",shape=box,color=red];
		j1372231517 -> j3250996037;
	j1677213537 [label="你是认真的吗？互联网真的很危险。",shape=box,color=blue];
		j1677213537 -> j3786234179;
		j1677213537 -> j2577488846;
	j3353738814 [label="这对我来说很重要。我不希望有任何人再在网上找到卡娅。",shape=box,color=blue];
		j3353738814 -> j1712795300;
		j3353738814 -> j1110463939;
	j3250996037 [label="嗯。嗯。嗯。自在。没人在背后说我的坏话吧？",shape=box,color=blue];
		j3250996037 -> j2474973244;
		j3250996037 -> j2306639473;
	j3786234179 [label="你是不是出过什么事？",shape=box,color=red];
		j3786234179 -> j960515419;
	j2577488846 [label="那你觉得时间旅行不危险吗？",shape=box,color=red];
		j2577488846 -> j4294415938;
	j1712795300 [label="我保证，时间警察不会抓到你的。",shape=box,color=red];
		j1712795300 -> j1735100517;
	j1110463939 [label="你惹事了？",shape=box,color=red];
		j1110463939 -> j1528483520;
	j2474973244 [label="嗯，碧确实有说过……",shape=box,color=red];
		j2474973244 -> j1243965272;
	j2306639473 [label="一点都没有。大家都很高兴你在这。",shape=box,color=red];
		j2306639473 -> j457328304;
	j960515419 [label="Check boolean KayaSetKid",color=orange];
		j960515419 -> j857342398 [label=true,color=green];
		j960515419 -> j4212339383 [label=false,color=brown];
	j4294415938 [label="Check boolean KayaSetKid",color=orange];
		j4294415938 -> j3950019076 [label=true,color=green];
		j4294415938 -> j78970399 [label=false,color=brown];
	j1735100517 [label="呃。不好笑。 ",shape=box,color=blue];
		j1735100517 -> j2292283515;
	j1528483520 [label="我就犯过一个错。 ",shape=box,color=blue];
		j1528483520 -> j868740607;
	j1243965272 [label="别开这种玩笑。",shape=box,color=blue];
		j1243965272 -> j3208489500;
	j457328304 [label="亚瑟和埃莉诺绝对把你当作比他们聪明得多的小妹妹。",shape=box,color=red];
		j457328304 -> j2513341901;
	j857342398 [label="你总说我像个小孩，要是我真的出了什么事怎么办？",shape=box,color=blue];
		j857342398 -> j640409215;
	j4212339383 [label="不是我现在能改变的事。",shape=box,color=blue];
		j4212339383 -> j2126627977;
	j3950019076 [label="听着，我知道你把我当小孩看。",shape=box,color=blue];
		j3950019076 -> j250600901;
	j78970399 [label="行。你说的都对。",shape=box,color=blue];
		j78970399 -> j2260932059;
	j2292283515 [label="+20 Chemistry",color=orange];
		j2292283515 -> "Chat ends. Next chat will be KayaRank2Convo2.";
	j868740607 [label="我通常不会犯错的。",shape=box,color=blue];
		j868740607 -> j3092124478;
	j3208489500 [label="一点也不好笑。你把我们这样的女生放在一个房间里，大家都以为我们会互相厮杀。",shape=box,color=blue];
		j3208489500 -> j3521795146;
	j2513341901 [label="阿米尔和昆西对你的虫洞念念不忘，我发誓当你不注意的时候他们会跳进去。",shape=box,color=red];
		j2513341901 -> j3812322596;
	j640409215 [label="那我希望你能从周围的人看出来，我们是一个互帮互助的团队。",shape=box,color=red];
		j640409215 -> j135348727;
	j2126627977 [label="那，这是你想要搞清楚时间旅行的原因吗？为了证明些什么？",shape=box,color=red];
		j2126627977 -> j3299454248;
	j250600901 [label="只不过 ",shape=box,color=blue];
		j250600901 -> j1528483520;
	j2260932059 [label="可能是危险的吧。而正因为这样，我得知道正确的做法。不能犯错。",shape=box,color=blue];
		j2260932059 -> j1528483520;
	"Chat ends. Next chat will be KayaRank2Convo2." [color=orange];
	j3092124478 [label="所以再给我几天，或许几个星期，我就能把这件事搞定，然后就和 1999 年说再见。",shape=box,color=blue];
		j3092124478 -> j33123620;
	j3521795146 [label="嫉妒。比较。呃。我已经受够了生活的那部分。别想着挑拨我和其他女生的关系。 ",shape=box,color=blue];
		j3521795146 -> j2292283515;
	j3812322596 [label="碧和莱蒂似乎还没决定好是想当你最好的朋友还是当你妈妈。",shape=box,color=red];
		j3812322596 -> j829442652;
	j135348727 [label="嗯。",shape=box,color=blue];
		j135348727 -> j3924700937;
	j3299454248 [label="也许吧。",shape=box,color=blue];
		j3299454248 -> j2139070583;
	j33123620 [label="等着瞧。",shape=box,color=blue];
		j33123620 -> j2292283515;
	j829442652 [label="当然还有我，我很高兴有人想知道我到底是怎么来到这里的。",shape=box,color=red];
		j829442652 -> j1621040092;
	j3924700937 [label="你说得对。你确实不是不受欢迎。",shape=box,color=blue];
		j3924700937 -> j381477507;
	j2139070583 [label="你怎么会关心这个？",shape=box,color=blue];
		j2139070583 -> j913171054;
		j2139070583 -> j732325098;
		j2139070583 -> j1811164013;
	j1621040092 [label="你们真的……喜欢我吗？",shape=box,color=blue];
		j1621040092 -> j3724858571;
		j1621040092 -> j2711499318;
	j381477507 [label="而且似乎大家都信任你，至少他们是这么说的。",shape=box,color=blue];
		j381477507 -> j1811164013;
		j381477507 -> j732325098;
		j381477507 -> j913171054;
	j913171054 [label="信任他人并共同合作，这就是我们的特点。 ",shape=box,color=red];
		j913171054 -> j2621628410;
	j732325098 [label="关心朋友是一种力量。这也是我忍受所有这些糟糕事的理由。",shape=box,color=red];
		j732325098 -> j2621628410;
	j1811164013 [label="我们每个人都有自己的问题要处理。独自一人面对很难。",shape=box,color=red];
		j1811164013 -> j2621628410;
	j3724858571 [label="我们只是在等你在我们这里感到自在。",shape=box,color=red];
		j3724858571 -> j3833450525;
	j2711499318 [label="我们怎么可能不喜欢？ ",shape=box,color=red];
		j2711499318 -> j3833450525;
	j2621628410 [label="哈哈，听起来像是某个姐妹会的口号。",shape=box,color=blue];
		j2621628410 -> j1062383525;
		j2621628410 -> j4205353439;
	j3833450525 [label="我……明白了。",shape=box,color=blue];
		j3833450525 -> j2292283515;
	j1062383525 [label="“姐妹会口号”到底是什么？",shape=box,color=red];
		j1062383525 -> j1013115668;
	j4205353439 [label="姐妹会？那是什么。",shape=box,color=red];
		j4205353439 -> j1013115668;
	j1013115668 [label="哈哈，认真的吗？如果未来没有这些，那我真得去未来看看了。天哪。",shape=box,color=blue];
		j1013115668 -> j1467900100;
	j1467900100 [label="还是不懂……",shape=box,color=red];
		j1467900100 -> j1110132157;
	j1110132157 [label="在大学里，一群女生自称姐妹，好像这很有意义似的。我想大概就像是‘社团’吧。 ",shape=box,color=blue];
		j1110132157 -> j2295993285;
	j2295993285 [label="哦，可能像是‘帕尔沃斯的姐妹’？",shape=box,color=red];
		j2295993285 -> j2518087395;
	j2518087395 [label="听起来好蠢。呃。我真希望那不是个真正的姐妹会。",shape=box,color=blue];
		j2518087395 -> j3615416491;
	j3615416491 [label="嗯，她们总是想弄死我。",shape=box,color=red];
		j3615416491 -> j3214044630;
	j3214044630 [label="我感觉我的姐妹会也曾想弄死我……",shape=box,color=blue];
		j3214044630 -> j2292283515;
}