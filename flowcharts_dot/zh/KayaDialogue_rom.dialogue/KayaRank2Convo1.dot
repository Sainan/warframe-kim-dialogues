		174 -> 176;
		174 -> 177;
	175 [label="嗯，这重要吗？毕竟这是互联网，我更倾向于不用真名。",shape=box,color=blue];
		175 -> 178;
		175 -> 179;
	176 [label="可以。但我能问问为什么吗？",shape=box,color=red];
		176 -> 180;
	177 [label="明白了。Nova。Nova。对了。我想问一下：我能做些什么让你在这里感觉更自在一些吗？",shape=box,color=red];
		177 -> 181;
	178 [label="也是，你肯定不想让人知道你有多常问我关于时间旅行的事。",shape=box,color=red];
		178 -> 182;
	179 [label="哦？我很确定阿米尔已经把这个网络加固得很好了，除非我没注意到什么？",shape=box,color=red];
		179 -> 183;
	180 [label="你问过其他人喜欢什么昵称吗？赶紧适应吧。 ",shape=box,color=blue];
		180 -> 177;
	181 [label="我知道我们谁都不想‘待在’这种临时的家，但我们都在尽力了。",shape=box,color=red];
