	j3919099667 [label="Check boolean KayaFutureWin2",color=orange];
		j3919099667 -> j2463673656 [label=true,color=green];
		j3919099667 -> j724049082 [label=false,color=brown];
	j724049082 [label="我可能永远出不去了。我接受了。",shape=box,color=blue];
		j724049082 -> j2714981988;
	j2463673656 [label="好吧首先，你现在可以叫我卡娅了。",shape=box,color=blue];
		j2463673656 -> j1829969975;
	j2714981988 [label="我正在学会接受自己，我不应该用后悔定义我。",shape=box,color=blue];
		j2714981988 -> j3924326010;
	j1829969975 [label="因为如果任何人在读这条消息，是卡娅·维拉斯科解开了这个难题。",shape=box,color=blue];
		j1829969975 -> j283871136;
	j3924326010 [label="而且像，如果我真的出去了，那就太卑鄙了。对任何跟着过来的人都太危险了。",shape=box,color=blue];
		j3924326010 -> j2992604160;
	j283871136 [label="如果你去搜索我的名字，你会找到两样东西：我解开了这个难题，我已经离开了 1999 年。",shape=box,color=blue];
		j283871136 -> j1772751718;
	j2992604160 [label="所以，让我们在这儿做自己能做的吧！在这个 1999 年。",shape=box,color=blue];
		j2992604160 -> j1932779872;
		j2992604160 -> j3226685638;
	j1772751718 [label="然后无论你找到我的什么照片，那个女孩把你们全部抛下了。拜！",shape=box,color=blue];
		j1772751718 -> j1340085259;
	j1932779872 [label="1999 很荣幸能拥有卡娅·维拉斯科",shape=box,color=red];
		j1932779872 -> j1491866842;
	j3226685638 [label="任何事都可能发生，我很高兴和你一起度过这一切。",shape=box,color=red];
		j3226685638 -> j1491866842;
	j1340085259 [label="卡娅？不可能。证明一下。",shape=box,color=red];
		j1340085259 -> j1092722623;
	j1092722623 [label="当然。来 Larunda 中继站找我。我一边看星星一边等你。",shape=box,color=blue];
