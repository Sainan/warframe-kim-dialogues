digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank5Convo2 begins." [color=orange];
		"KayaRank5Convo2 begins." -> j2338381449;
	j2338381449 [label="这次我问*你*关于时间旅行的问题怎么样？",shape=box,color=red];
		j2338381449 -> j1748994662;
	j1748994662 [label="别。我们还是聊点别的吧！好吗？",shape=box,color=blue];
		j1748994662 -> j3602582192;
	j3602582192 [label="Check boolean KayaPromiseRegret",color=orange];
		j3602582192 -> j2889759111 [label=true,color=green];
		j3602582192 -> j3627306141 [label=false,color=brown];
		j3602582192 -> j1124086855 [label=false,color=brown];
	j2889759111 [label="比如我最后悔的事？",shape=box,color=red];
		j2889759111 -> j2354346087;
	j3627306141 [label="比如呢？你选一个。",shape=box,color=red];
		j3627306141 -> j1933170701;
	j1124086855 [label="比如……卡利莫斯？",shape=box,color=red];
		j1124086855 -> j505068163;
	j2354346087 [label="嗯嗯好吧。是什么？ ",shape=box,color=blue];
		j2354346087 -> j2008450041;
		j2354346087 -> j3200166799;
		j2354346087 -> j3713461036;
	j1933170701 [label="嗯我想想……我的第一只宠物？ ",shape=box,color=blue];
		j1933170701 -> j3386195234;
	j505068163 [label=" 嗯，嗯她很好，不过我更喜欢狗狗。我和一只狗一起长大的。我希望能再次看见他。",shape=box,color=blue];
		j505068163 -> j2626049254;
		j505068163 -> j691759948;
		j505068163 -> j3929121577;
	j2008450041 [label="没有要求阿尔布雷希特负起更多应负的责任。",shape=box,color=red];
		j2008450041 -> j3590077414;
	j3200166799 [label="没有早点阻止 Ballas。",shape=box,color=red];
		j3200166799 -> j2659207838;
	j3713461036 [label="放弃自己。",shape=box,color=red];
		j3713461036 -> j3090136773;
	j3386195234 [label="虽然这是网上黑客的惯用问题，所以呃，别告诉任何人。",shape=box,color=blue];
		j3386195234 -> j2345259110;
	j2626049254 [label="同情。最好就聊到这吧。[结束]",shape=box,color=red];
		j2626049254 -> j3219460250;
	j691759948 [label="我很抱歉，跟我说说他。",shape=box,color=red];
		j691759948 -> j4246148275;
	j3929121577 [label="我也丢过一只宠物。你的狗叫什么名字？",shape=box,color=red];
		j3929121577 -> j4246148275;
	j3590077414 [label="就好像经过了这么多，我还是让他逃了。",shape=box,color=red];
		j3590077414 -> j1166601537;
	j2659207838 [label="我不知道我还能怎么改变当时的情况。",shape=box,color=red];
		j2659207838 -> j3366488055;
	j3090136773 [label="别人怎么看并不重要。曾经有段时间，没有人比我更恨我自己。",shape=box,color=red];
		j3090136773 -> j4144247796;
	j2345259110 [label="他的名字叫齐罗。我觉得你会叫他库狛。",shape=box,color=blue];
		j2345259110 -> j1478794997;
	j3219460250 [label="+20 Chemistry",color=orange];
		j3219460250 -> "Chat ends. Next chat will be KayaRank5Convo3.";
	j4246148275 [label="这其实有点不公平。英择谛时间旅行的时候可以带上他的古怪猫猫一起？",shape=box,color=blue];
		j4246148275 -> j927014126;
	j1166601537 [label="我知道他以为他是在教我，但那个混蛋根本没意识到他让我经历了什么。",shape=box,color=red];
		j1166601537 -> j1335156745;
	j3366488055 [label="但我知道就算我只快一分钟，就会有人少受一点罪。",shape=box,color=red];
		j3366488055 -> j3550704867;
	j4144247796 [label="我甚至连死也死不了。而我希望我能死。 ",shape=box,color=red];
		j4144247796 -> j1188153693;
	j1478794997 [label="很大一只，你能想象到的最大的狗狗。我敢打赌他可以一口将沃尔科夫先生咬成两半。",shape=box,color=blue];
		j1478794997 -> j3436010982;
		j1478794997 -> j3968351036;
	"Chat ends. Next chat will be KayaRank5Convo3." [color=orange];
	j927014126 [label="如果我有齐罗在身边……这趟旅途可就轻松多了。",shape=box,color=blue];
		j927014126 -> j1017877313;
	j1335156745 [label="而且不仅是我。我们所有人。洛德、戈迈特鲁……真恶心。我不知道如果我再次见到他，我能不能冷静。",shape=box,color=red];
		j1335156745 -> j1188153693;
	j3550704867 [label="Ballas 代表着我一切的恐惧。他就是生命中之极恶。 ",shape=box,color=red];
		j3550704867 -> j1188153693;
	j1188153693 [label="你要是这么说的话……我感觉生活和人有时候就是这么糟不是么？",shape=box,color=blue];
		j1188153693 -> j1600353012;
	j3436010982 [label="我来的地方仍然有大型库狛！ ",shape=box,color=red];
		j3436010982 -> j2168785437;
	j3968351036 [label="呃我不知道。沃尔科夫先生可是很强壮的。",shape=box,color=red];
		j3968351036 -> j4156995704;
	j1017877313 [label="齐罗是第一个看见我哭的生物，你知道吗。 ",shape=box,color=blue];
		j1017877313 -> j2718191013;
	j1600353012 [label="但有时候又非常棒。",shape=box,color=blue];
		j1600353012 -> j1041292996;
	j2168785437 [label="哦天哪……那我更有理由要去了。哇！",shape=box,color=blue];
		j2168785437 -> j4041214565;
	j4156995704 [label="好像你说的有道理……但反正，又大又吓人的齐罗。但他非常保护我。",shape=box,color=blue];
		j4156995704 -> j1017877313;
	j2718191013 [label="我好像是五岁，在我记忆中我一直拒绝哭泣。",shape=box,color=blue];
		j2718191013 -> j886777376;
	j1041292996 [label="我们无法用最大的遗憾来定义自己。我感觉你帮我从我的遗憾中走出来了。",shape=box,color=blue];
		j1041292996 -> j3359564278;
	j4041214565 [label="我的齐罗非常保护我。 ",shape=box,color=blue];
		j4041214565 -> j1017877313;
	j886777376 [label="但那是我一年级第一天回家，齐罗就在那里。",shape=box,color=blue];
		j886777376 -> j3395906772;
	j3359564278 [label="但我不会改变这件已经发生的事。 ",shape=box,color=blue];
		j3359564278 -> j2474765886;
	j3395906772 [label="然后他就跟着我进了房间，我在哭的时候他守在门口。",shape=box,color=blue];
		j3395906772 -> j4237450344;
		j3395906772 -> j1165967274;
	j2474765886 [label="因为对吧，我不讨厌这个。Nova？简直太酷了好吧。",shape=box,color=blue];
		j2474765886 -> j2828834448;
	j4237450344 [label="是什么让你那么难过？",shape=box,color=red];
		j4237450344 -> j2837116821;
	j1165967274 [label="你怎么记得？",shape=box,color=red];
		j1165967274 -> j537400217;
	j2828834448 [label="你一件都不想改变？",shape=box,color=red];
		j2828834448 -> j1647728845;
	j2837116821 [label="有人说我胖。",shape=box,color=blue];
		j2837116821 -> j2843613612;
	j537400217 [label="我怎么能忘？！",shape=box,color=blue];
		j537400217 -> j2837116821;
	j1647728845 [label="一件都不。而且我希望你也不用改变。",shape=box,color=blue];
		j1647728845 -> j3219460250;
	j2843613612 [label="这好像是，我小时候让孩子们不受欢迎的一件事。",shape=box,color=blue];
		j2843613612 -> j1625182494;
		j2843613612 -> j1167645008;
	j1625182494 [label="孩子们有时候真的很残忍。",shape=box,color=red];
		j1625182494 -> j3438574128;
	j1167645008 [label="受欢迎有那么重要吗？",shape=box,color=red];
		j1167645008 -> j1944991570;
	j3438574128 [label="每个人都很残忍。",shape=box,color=blue];
		j3438574128 -> j665850342;
	j1944991570 [label="重要……直到这一切发生了。在经历了这些糟糕的事情之后，我觉得我变得更好了，就像，我现在才是我真正想要成为的人。",shape=box,color=blue];
		j1944991570 -> j685798221;
	j665850342 [label="每人都想做那个酷小孩。",shape=box,color=blue];
		j665850342 -> j3990444218;
	j685798221 [label="不用在意别人对我的看法。就……终于活出我自己。",shape=box,color=blue];
		j685798221 -> j3219460250;
	j3990444218 [label="但我现在意识到了，不在乎酷更酷。所以你才这么酷。",shape=box,color=blue];
		j3990444218 -> j1242074600;
	j1242074600 [label="在经历了这些糟糕的事情之后，我觉得我变得更好了，就像，我现在才是我真正想要成为的人。",shape=box,color=blue];
		j1242074600 -> j685798221;
}