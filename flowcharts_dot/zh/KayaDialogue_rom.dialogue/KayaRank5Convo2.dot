		822 -> 824 [label=true,color=green];
		822 -> 825 [label=false,color=brown];
		822 -> 823 [label=false,color=brown];
	824 [label="比如我最后悔的事？",shape=box,color=red];
		824 -> 827;
	825 [label="比如呢？你选一个。",shape=box,color=red];
		825 -> 828;
	823 [label="比如……卡利莫斯？",shape=box,color=red];
		823 -> 826;
	827 [label="嗯嗯好吧。是什么？ ",shape=box,color=blue];
		827 -> 832;
		827 -> 833;
		827 -> 834;
	828 [label="嗯我想想……我的第一只宠物？ ",shape=box,color=blue];
		828 -> 835;
	826 [label=" 嗯，嗯她很好，不过我更喜欢狗狗。我和一只狗一起长大的。我希望能再次看见他。",shape=box,color=blue];
		826 -> 829;
		826 -> 830;
		826 -> 831;
	832 [label="没有要求阿尔布雷希特负起更多应负的责任。",shape=box,color=red];
		832 -> 838;
	833 [label="没有早点阻止 Ballas。",shape=box,color=red];
		833 -> 839;
	834 [label="放弃自己。",shape=box,color=red];
		834 -> 840;
	835 [label="虽然这是网上黑客的惯用问题，所以呃，别告诉任何人。",shape=box,color=blue];
		835 -> 841;
	829 [label="同情。最好就聊到这吧。[结束]",shape=box,color=red];
		829 -> 836;
	830 [label="我很抱歉，跟我说说他。",shape=box,color=red];
		830 -> 837;
	831 [label="我也丢过一只宠物。你的狗叫什么名字？",shape=box,color=red];
		831 -> 837;
	838 [label="就好像经过了这么多，我还是让他逃了。",shape=box,color=red];
		838 -> 844;
	839 [label="我不知道我还能怎么改变当时的情况。",shape=box,color=red];
		839 -> 845;
	840 [label="别人怎么看并不重要。曾经有段时间，没有人比我更恨我自己。",shape=box,color=red];
		840 -> 846;
	841 [label="他的名字叫齐罗。我觉得你会叫他库狛。",shape=box,color=blue];
		841 -> 847;
	836 [label="+20 Chemistry",color=orange];
		836 -> 842;
	837 [label="这其实有点不公平。英择谛时间旅行的时候可以带上他的古怪猫猫一起？",shape=box,color=blue];
		837 -> 843;
	844 [label="我知道他以为他是在教我，但那个混蛋根本没意识到他让我经历了什么。",shape=box,color=red];
		844 -> 849;
	845 [label="但我知道就算我只快一分钟，就会有人少受一点罪。",shape=box,color=red];
		845 -> 850;
	846 [label="我甚至连死也死不了。而我希望我能死。 ",shape=box,color=red];
		846 -> 851;
	847 [label="很大一只，你能想象到的最大的狗狗。我敢打赌他可以一口将沃尔科夫先生咬成两半。",shape=box,color=blue];
		847 -> 852;
		847 -> 853;
	842 [label="Chat ends. Next chat will be KayaRank5Convo3.",color=orange];
	843 [label="如果我有齐罗在身边……这趟旅途可就轻松多了。",shape=box,color=blue];
		843 -> 848;
	849 [label="而且不仅是我。我们所有人。洛德、戈迈特鲁……真恶心。我不知道如果我再次见到他，我能不能冷静。",shape=box,color=red];
		849 -> 851;
	850 [label="Ballas 代表着我一切的恐惧。他就是生命中之极恶。 ",shape=box,color=red];
		850 -> 851;
	851 [label="你要是这么说的话……我感觉生活和人有时候就是这么糟不是么？",shape=box,color=blue];
		851 -> 855;
	852 [label="我来的地方仍然有大型库狛！ ",shape=box,color=red];
		852 -> 856;
	853 [label="呃我不知道。沃尔科夫先生可是很强壮的。",shape=box,color=red];
		853 -> 857;
	848 [label="齐罗是第一个看见我哭的生物，你知道吗。 ",shape=box,color=blue];
		848 -> 854;
	855 [label="但有时候又非常棒。",shape=box,color=blue];
		855 -> 859;
	856 [label="哦天哪……那我更有理由要去了。哇！",shape=box,color=blue];
		856 -> 860;
	857 [label="好像你说的有道理……但反正，又大又吓人的齐罗。但他非常保护我。",shape=box,color=blue];
		857 -> 848;
	854 [label="我好像是五岁，在我记忆中我一直拒绝哭泣。",shape=box,color=blue];
		854 -> 858;
	859 [label="我们无法用最大的遗憾来定义自己。我感觉你帮我从我的遗憾中走出来了。",shape=box,color=blue];
		859 -> 862;
	860 [label="我的齐罗非常保护我。 ",shape=box,color=blue];
		860 -> 848;
	858 [label="但那是我一年级第一天回家，齐罗就在那里。",shape=box,color=blue];
		858 -> 861;
	862 [label="但我不会改变这件已经发生的事。 ",shape=box,color=blue];
		862 -> 865;
	861 [label="然后他就跟着我进了房间，我在哭的时候他守在门口。",shape=box,color=blue];
		861 -> 863;
		861 -> 864;
	865 [label="因为对吧，我不讨厌这个。Nova？简直太酷了好吧。",shape=box,color=blue];
		865 -> 868;
	863 [label="是什么让你那么难过？",shape=box,color=red];
		863 -> 866;
	864 [label="你怎么记得？",shape=box,color=red];
		864 -> 867;
	868 [label="你一件都不想改变？",shape=box,color=red];
		868 -> 871;
	866 [label="有人说我胖。",shape=box,color=blue];
		866 -> 869;
	867 [label="我怎么能忘？！",shape=box,color=blue];
		867 -> 870;
	871 [label="一件都不。而且我希望你也不用改变。",shape=box,color=blue];
		871 -> 874;
	869 [label="这好像是，我小时候让孩子们不受欢迎的一件事。",shape=box,color=blue];
		869 -> 872;
		869 -> 873;
	870 [label="有人说我胖。",shape=box,color=blue];
