digraph {
	819 [label="KayaRank5Convo2 begins.",color=orange];
		819 -> 820;
	820 [label="这次我问*你*关于时间旅行的问题怎么样？",shape=box,color=red];
		820 -> 821;
	821 [label="别。我们还是聊点别的吧！好吗？",shape=box,color=blue];
