	874 [label="+20 Chemistry",color=orange];
		874 -> 877;
	872 [label="孩子们有时候真的很残忍。",shape=box,color=red];
		872 -> 875;
	873 [label="受欢迎有那么重要吗？",shape=box,color=red];
		873 -> 876;
	877 [label="Chat ends. Next chat will be KayaRank5Convo3.",color=orange];
	875 [label="每个人都很残忍。",shape=box,color=blue];
		875 -> 878;
	876 [label="重要……直到这一切发生了。在经历了这些糟糕的事情之后，我觉得我变得更好了，就像，我现在才是我真正想要成为的人。",shape=box,color=blue];
		876 -> 879;
	878 [label="每人都想做那个酷小孩。",shape=box,color=blue];
		878 -> 880;
	879 [label="不用在意别人对我的看法。就……终于活出我自己。",shape=box,color=blue];
