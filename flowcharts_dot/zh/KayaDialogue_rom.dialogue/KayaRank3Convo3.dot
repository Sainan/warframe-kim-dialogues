	"KayaRank3Convo3 begins." [color=orange];
		"KayaRank3Convo3 begins." -> j2957468498;
	j2957468498 [label="你知道那是什么感觉吗？",shape=box,color=blue];
		j2957468498 -> j780519273;
	j780519273 [label="我曾是个拥有一切的女孩。 ",shape=box,color=blue];
		j780519273 -> j2820100941;
		j780519273 -> j3311337909;
		j780519273 -> j577041866;
	j2820100941 [label="深呼吸，放松一下，Nova。[结束]",shape=box,color=red];
		j2820100941 -> j3588492270;
	j3311337909 [label="这对每个人来说都很困难。你会好起来的。",shape=box,color=red];
		j3311337909 -> j3477909239;
	j577041866 [label="我们所有人都因为这堆屁事失去了某些东西。看看周围吧。",shape=box,color=red];
		j577041866 -> j3204863270;
	j3588492270 [label="+20 Chemistry",color=orange];
		j3588492270 -> "Chat ends. Next chat will be KayaRank4Convo1.";
	j3477909239 [label="只有逃离这一年，我才能真正“好起来”。",shape=box,color=blue];
		j3477909239 -> j3680126609;
	j3204863270 [label="我只是不知道我还能不能相信别人了。甚至包括你。",shape=box,color=blue];
		j3204863270 -> j136389501;
	"Chat ends. Next chat will be KayaRank4Convo1." [color=orange];
	j3680126609 [label="你把我困在了我这辈子最痛苦的一年。 ",shape=box,color=blue];
		j3680126609 -> j136389501;
	j136389501 [label="基本上我只是利用你来逃离这里。 ",shape=box,color=blue];
		j136389501 -> j2655479355;
		j136389501 -> j941461499;
	j2655479355 [label="无论是什么原因导致你变成这样，它都在毁掉你获得真正幸福的机会。",shape=box,color=red];
		j2655479355 -> j3706222748;
	j941461499 [label="你早走早好，省得我还要面对你这种态度。",shape=box,color=red];
		j941461499 -> j4117872456;
	j3706222748 [label="你没法让我恨你。惹毛我倒是可以，但这不是恨。",shape=box,color=red];
		j3706222748 -> j3245424174;
		j3706222748 -> j1709222765;
	j4117872456 [label="很高兴我们意见一致。",shape=box,color=blue];
		j4117872456 -> j1173661291;
	j3245424174 [label="你要非觉得是在利用我们，那就这么想好了。 ",shape=box,color=red];
		j3245424174 -> j2201421388;
	j1709222765 [label="我肯定会想办法帮你的。",shape=box,color=red];
		j1709222765 -> j1904051566;
	j1173661291 [label="Boolean KayaAttitude is now true.",color=orange];
		j1173661291 -> j3588492270;
	j2201421388 [label="等你想通的那天，你总会想通的，我们还会在这。",shape=box,color=red];
		j2201421388 -> j3155343535;
	j1904051566 [label="我只希望你早点明白我们从没想过要伤害你。",shape=box,color=red];
		j1904051566 -> j2383384786;
	j3155343535 [label="等你们发现时……就再不会用现在的眼神看我了……",shape=box,color=blue];
		j3155343535 -> j3588492270;
	j2383384786 [label="就算你们没有想伤害我，我也会搞砸一些事。向来如此。",shape=box,color=blue];
		j2383384786 -> j3588492270;
}