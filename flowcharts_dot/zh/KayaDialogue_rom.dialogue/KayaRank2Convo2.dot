	edge [fontname="Roboto Condensed"];

	"KayaRank2Convo2 begins." [color=orange];
		"KayaRank2Convo2 begins." -> j1876216003;
	j1876216003 [label="嗨。你能帮我确认一下吗？ ",shape=box,color=blue];
		j1876216003 -> j1100390682;
	j1100390682 [label="你的时间旅行能力的关键，是不是某种比例的科技细胞和虚空的混合？",shape=box,color=blue];
		j1100390682 -> j1835892505;
		j1100390682 -> j544246480;
	j1835892505 [label="混合？我们这是在烤蛋糕吗？",shape=box,color=red];
		j1835892505 -> j2491206742;
	j544246480 [label="那你的研究进展得不错嘛？",shape=box,color=red];
		j544246480 -> j3308529427;
	j2491206742 [label="我从没试过做那个，但我敢打赌我会做得很好。",shape=box,color=blue];
		j2491206742 -> j1110013065;
		j2491206742 -> j3979083517;
	j3308529427 [label="非常好。我其实已经非常接近了。非常接近。",shape=box,color=blue];
		j3308529427 -> j1747069111;
		j3308529427 -> j1096385660;
	j1110013065 [label="你怎么知道的？",shape=box,color=red];
		j1110013065 -> j472775779;
	j3979083517 [label="Nova，谦虚点。",shape=box,color=red];
		j3979083517 -> j472775779;
	j1747069111 [label="你怎么确定的？",shape=box,color=red];
		j1747069111 -> j3662570507;
	j1096385660 [label="你一定是个优秀的学生。",shape=box,color=red];
		j1096385660 -> j3774089165;
	j472775779 [label="我不需要谦虚。我在高中的成绩是学校史上最高的，而且我大学一年级的学术成绩是百年来最好的。",shape=box,color=blue];
		j472775779 -> j746155880;
		j472775779 -> j1973879236;
	j3662570507 [label="你听说过‘诺拉·夜’吗？",shape=box,color=blue];
		j3662570507 -> j1790697216;
		j3662570507 -> j1442334123;
	j3774089165 [label="我在高中的成绩是学校史上最高的，而且我大学一年级的学术成绩是百年来最好的。",shape=box,color=blue];
		j3774089165 -> j1990520750;
	j746155880 [label="但这并不意味着你就可以烤蛋糕。除非你学过烘焙？",shape=box,color=red];
		j746155880 -> j157471099;
	j1973879236 [label="但你还是不够聪明，竟然用了英择谛的血清，对吧？",shape=box,color=red];
		j1973879236 -> j2013501876;
	j1790697216 [label="可能吧，但她肯定听说过我。",shape=box,color=red];
		j1790697216 -> j179348927;
	j1442334123 [label="哇，听说过。她是我那个时代的人",shape=box,color=red];
		j1442334123 -> j179348927;
	j1990520750 [label="我不仅仅是个优秀的学生。有好几所大学都邀请我去那里读书。我的第一年本应是完美的……",shape=box,color=blue];
		j1990520750 -> j2266448214;
		j1990520750 -> j3854546455;
	j157471099 [label="Boolean KayaCake is now true.",color=orange];
		j157471099 -> j936715527;
	j2013501876 [label="笑死？看看是谁在说话？不就是“英择谛老师的马屁精”吗。是的，我知道大家都怎么说你的",shape=box,color=blue];
		j2013501876 -> j2909339201;
		j2013501876 -> j1165336674;
	j179348927 [label="嗯，当然了。好吧，我已经发明了一个时间拦截的公式，结果它能接收到声波！ ",shape=box,color=blue];
		j179348927 -> j730336542;
	j2266448214 [label="要不是因为……这一切？",shape=box,color=red];
		j2266448214 -> j3924388935;
	j3854546455 [label="要不是因为……英择谛？",shape=box,color=red];
		j3854546455 -> j3924388935;
	j936715527 [label="我。的。天。你真的以为我不会烤蛋糕吗？",shape=box,color=blue];
		j936715527 -> j276355485;
	j2909339201 [label="你故意编造事实来发泄。为什么要这样？",shape=box,color=red];
		j2909339201 -> j3809808586;
	j1165336674 [label="你是想伤我的心吗？",shape=box,color=red];
		j1165336674 -> j3809808586;
	j730336542 [label="所以我一直在这里收听这个电台。我觉得我们会合得来。",shape=box,color=blue];
		j730336542 -> j2630814237;
	j3924388935 [label="要不是因为这个蠢互联网。 ",shape=box,color=blue];
		j3924388935 -> j1713598398;
		j3924388935 -> j180877568;
	j276355485 [label="正好能分散下注意力。你给我等着。",shape=box,color=blue];
		j276355485 -> j2906669224;
	j3809808586 [label="你知道，受欢迎不是万能的。如果每个人都想看到你失败呢？如果你站在顶峰，那么总有一天每个人都会想把你拉下来。 ",shape=box,color=blue];
		j3809808586 -> j242068335;
		j3809808586 -> j3758631764;
	j2630814237 [label="首先我可以整合我的理论，也许尝试拦截一种无生命的物质，以确保安全。",shape=box,color=blue];
		j2630814237 -> j3422284283;
	j1713598398 [label="互联网最终会消失的，别担心。",shape=box,color=red];
		j1713598398 -> j2082005025;
	j180877568 [label="所以你在大学不愉快的原因是因为……互联网。",shape=box,color=red];
		j180877568 -> j1199466914;
	j2906669224 [label="+20 Chemistry",color=orange];
		j2906669224 -> "Chat ends. Next chat will be KayaRank2Convo3.";
	j242068335 [label="这里不是高中。 ",shape=box,color=red];
		j242068335 -> j860569030;
	j3758631764 [label="Nova，我们这里不是那种地方，我们有真正重要的事情要处理。",shape=box,color=red];
		j3758631764 -> j860569030;
	j3422284283 [label="你在某种程度上为我留下了一个可利用的虫洞，所以我想你是我的学习伙伴。部分功劳给你。",shape=box,color=blue];
		j3422284283 -> j2895005418;
		j3422284283 -> j179089781;
	j2082005025 [label="也许是我毁掉它的！",shape=box,color=blue];
		j2082005025 -> j3740714946;
	j1199466914 [label="我刚刚说过了。",shape=box,color=blue];
		j1199466914 -> j2743649359;
	"Chat ends. Next chat will be KayaRank2Convo3." [color=orange];
	j860569030 [label="盲目信任别人会受伤。在互联网上信任别人？那会毁了你的生活。 ",shape=box,color=blue];
		j860569030 -> j2906669224;
	j2895005418 [label="我们俩都拿 A+！",shape=box,color=red];
		j2895005418 -> j3910845915;
	j179089781 [label="很高兴能帮到你。",shape=box,color=red];
		j179089781 -> j1279369227;
	j3740714946 [label="哦，我的天，是我吗？",shape=box,color=blue];
		j3740714946 -> j800086774;
		j3740714946 -> j2691185838;
	j2743649359 [label="我就快速跟你讲讲吧，看在你可能还不太了解这边情况的份上。",shape=box,color=blue];
		j2743649359 -> j317171061;
	j3910845915 [label="但你确定不是因为刚才我的收音机是开着的？",shape=box,color=red];
		j3910845915 -> j94890115;
	j1279369227 [label="虽然我几乎没怎么理解。",shape=box,color=red];
		j1279369227 -> j2852164888;
	j800086774 [label="抱歉说实话，但我真的不知道。",shape=box,color=red];
		j800086774 -> j3716959953;
	j2691185838 [label="哦，当然。Nova 以关掉互联网而闻名。这就是我来这里的原因，为了阻止你。",shape=box,color=red];
		j2691185838 -> j2880736844;
	j317171061 [label="人们会在网上会撒谎。他们可以假装是你的朋友，也可以迅速传播谣言。 ",shape=box,color=blue];
		j317171061 -> j485009819;
	j94890115 [label="百分之百确定。",shape=box,color=blue];
		j94890115 -> j2906669224;
	j2852164888 [label="那就加油跟上。",shape=box,color=blue];
		j2852164888 -> j2906669224;
	j3716959953 [label="没意思。算了。",shape=box,color=blue];
		j3716959953 -> "Chat ends. Next chat will be KayaRank2Convo3.";
	j2880736844 [label="哈。才怪。",shape=box,color=blue];
		j2880736844 -> j2092911540;
	j485009819 [label="一旦发生这种情况，就别想过正常生活了。朋友啊，什么的都没了。",shape=box,color=blue];
		j485009819 -> j4085777854;
	j2092911540 [label="+20 Chemistry",color=orange];
		j2092911540 -> j3758266124;
	j4085777854 [label="而且那又怎样？反正你也不会懂。别来烦我。 ",shape=box,color=blue];
		j4085777854 -> j542942984;
		j4085777854 -> j2999362884;
	j3758266124 [label="一旦我下定决心做什么事，没人可以阻止我。",shape=box,color=blue];
		j3758266124 -> "Chat ends. Next chat will be KayaRank2Convo3.";
	j542942984 [label="你想怎样都行。不来烦你。",shape=box,color=red];
		j542942984 -> j2800328152;
	j2999362884 [label="我很难知道我有没有惹你不开心，我为你的遭遇感到抱歉，但是……",shape=box,color=red];
		j2999362884 -> j3515550694;
	j2800328152 [label="行。",shape=box,color=blue];
		j2800328152 -> "Chat ends. Next chat will be KayaRank2Convo3.";
	j3515550694 [label="我只是需要一点时间。好吧。再见。",shape=box,color=blue];
		j3515550694 -> "Chat ends. Next chat will be KayaRank2Convo3.";
}