digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank5Convo3 begins." [color=orange];
		"KayaRank5Convo3 begins." -> j2018514199;
	j2018514199 [label="哦嗨，我可以向你介绍一下吉尼梦卡牌的基础知识吗？",shape=box,color=blue];
		j2018514199 -> j2020218518;
	j2020218518 [label="阿米尔当然很高兴终于有人和他一起玩了（而且还让他输）。",shape=box,color=blue];
		j2020218518 -> j4129734691;
	j4129734691 [label="但我们都觉得拉你入坑吉尼梦会很有意思。 ",shape=box,color=blue];
		j4129734691 -> j1816017501;
		j4129734691 -> j2316875867;
		j4129734691 -> j140124949;
	j1816017501 [label="你们玩吧。我很忙。[结束]",shape=box,color=red];
		j1816017501 -> j145506587;
	j2316875867 [label="我口袋里的几枚霍币放到都快把裤子烧穿了，我们怎么开始？",shape=box,color=red];
		j2316875867 -> j2154399425;
	j140124949 [label="提醒我一下……我们在说什么？",shape=box,color=red];
		j140124949 -> j658564492;
	j145506587 [label="+20 Chemistry",color=orange];
		j145506587 -> "Chat ends. Next chat will be KayaRank5Convo4.";
	j2154399425 [label="好耶！好所以首先，我们来聚焦一下你。你觉得自己更像龙，更像鹰，还是更像豹呢？",shape=box,color=blue];
		j2154399425 -> j686735112;
		j2154399425 -> j4086333367;
		j2154399425 -> j1244451474;
	j658564492 [label="就是那个 1999 年超火的节目、游戏、收藏品！",shape=box,color=blue];
		j658564492 -> j3172887594;
	"Chat ends. Next chat will be KayaRank5Convo4." [color=orange];
	j686735112 [label="豹。",shape=box,color=red];
		j686735112 -> j3821405115;
	j4086333367 [label="鹰。",shape=box,color=red];
		j4086333367 -> j2125914104;
	j1244451474 [label="龙。",shape=box,color=red];
		j1244451474 -> j3380655167;
	j3172887594 [label="你知道的，有超酷的角色、生物……",shape=box,color=blue];
		j3172887594 -> j3995534531;
	j3821405115 [label="好，那么你绝对会想用泰拉拉猫开始游戏",shape=box,color=blue];
		j3821405115 -> j3869107212;
	j2125914104 [label="好，那么你肯定会想用伯特鸟开始游戏",shape=box,color=blue];
		j2125914104 -> j1796601208;
	j3380655167 [label="好，那么你可能会想用博格蛙开始游戏。",shape=box,color=blue];
		j3380655167 -> j532722327;
	j3995534531 [label="我想这些不是重点。总之，我们还是先从你说起。你觉得自己更像龙，更像鹰，还是更像豹呢？",shape=box,color=blue];
		j3995534531 -> j686735112;
		j3995534531 -> j4086333367;
		j3995534531 -> j1244451474;
	j3869107212 [label="是最酷的选择，但绝对有难度，一开始很弱。",shape=box,color=blue];
		j3869107212 -> j1958775684;
	j1796601208 [label="有一点进阶但非常酷。 ",shape=box,color=blue];
		j1796601208 -> j1174527575;
	j532722327 [label="是一个对新手很不错的选择。 ",shape=box,color=blue];
		j532722327 -> j2886061619;
	j1958775684 [label="但最后？你会得到一只最华丽、最威严的黑豹。",shape=box,color=blue];
		j1958775684 -> j4033213251;
	j1174527575 [label="波波鸟超级可爱因为你可以给他喂泡泡葡萄，他可以比任何人升级的都快。",shape=box,color=blue];
		j1174527575 -> j642846454;
	j2886061619 [label="然后当然你会从最可爱的一只蛙蛙开始，但最终如果你赢得够多……",shape=box,color=blue];
		j2886061619 -> j2469609627;
	j4033213251 [label="真是优雅的选择呢。",shape=box,color=blue];
		j4033213251 -> j3212832608;
	j642846454 [label="然后你就可以解锁一整套种地系统。",shape=box,color=blue];
		j642846454 -> j3212832608;
	j2469609627 [label="你可以将它进化成一条龙。",shape=box,color=blue];
		j2469609627 -> j3212832608;
	j3212832608 [label="这到底是个什么游戏……",shape=box,color=red];
		j3212832608 -> j2744992364;
	j2744992364 [label="好吧，基本上就是你去收集吉尼梦精灵，它们会为你战斗，然后你还可以去各地冒险。",shape=box,color=blue];
		j2744992364 -> j3264091738;
	j3264091738 [label="但那是电子游戏的版本。在卡牌游戏中你会和现实中的其他人对战。",shape=box,color=blue];
		j3264091738 -> j662952603;
	j662952603 [label="但都差不多就是了。吉尼梦吉尼梦吉尼梦。 ",shape=box,color=blue];
		j662952603 -> j1273344931;
	j1273344931 [label="所以，开始玩第一场吗？",shape=box,color=blue];
		j1273344931 -> j2296282312;
		j1273344931 -> j1455818657;
		j1273344931 -> j3727203558;
		j1273344931 -> j2100513588;
	j2296282312 [label="不要。[结束]",shape=box,color=red];
		j2296282312 -> j145506587;
	j1455818657 [label="当然为什么不呢，新手运气可在我这里。",shape=box,color=red];
		j1455818657 -> j1634668663;
	j3727203558 [label="你只是想轻松赢一场。没门。",shape=box,color=red];
		j3727203558 -> j2441908961;
	j2100513588 [label="不，我更迷惑了。你啥也没解释！ ",shape=box,color=red];
		j2100513588 -> j2441908961;
	j1634668663 [label="太好了……你只需要发过来大约 10000 霍币买一套自己的入门卡……",shape=box,color=blue];
		j1634668663 -> j3164435559;
		j1634668663 -> j1726866691;
	j2441908961 [label="哦来吧……我会放水的。我甚至会让阿米尔帮你！ ",shape=box,color=blue];
		j2441908961 -> j2378943354;
	j3164435559 [label="既然你这么说的话……",shape=box,color=red];
		j3164435559 -> j1012151186;
	j1726866691 [label="什么！我可没有那么多钱。",shape=box,color=red];
		j1726866691 -> j1012151186;
	j2378943354 [label="而且如果你赢，我会送你一包没打开的吉尼梦卡！",shape=box,color=blue];
		j2378943354 -> j991475445;
		j2378943354 -> j2571470054;
		j2378943354 -> j2593472464;
	j1012151186 [label="没有问题，如果你只要在这里填下你的银行信息……",shape=box,color=blue];
		j1012151186 -> j3632467496;
		j1012151186 -> j732571539;
	j991475445 [label="那好吧。只要阿米尔帮我就行。",shape=box,color=red];
		j991475445 -> j1634668663;
	j2571470054 [label="改天再来怎么样？",shape=box,color=red];
		j2571470054 -> j400372888;
	j2593472464 [label="不要！ ",shape=box,color=red];
		j2593472464 -> j400372888;
	j3632467496 [label="我可不会上当！",shape=box,color=red];
		j3632467496 -> j4292319838;
	j732571539 [label="好的，4……1",shape=box,color=red];
		j732571539 -> j3725187722;
	j400372888 [label="那好吧。",shape=box,color=blue];
		j400372888 -> j145506587;
	j4292319838 [label="恭喜你，你通过了即时网安全测试。 ",shape=box,color=blue];
		j4292319838 -> j682503485;
	j3725187722 [label="天哪不！这是一个测试，你可不能在即时网上发你的银行信息。 ",shape=box,color=blue];
		j3725187722 -> j3412422631;
	j682503485 [label="天哪阿米尔可确信你会上当了。",shape=box,color=blue];
		j682503485 -> j850028177;
	j3412422631 [label="呃该死！我欠阿米尔一场游戏。他说你会上当的。",shape=box,color=blue];
		j3412422631 -> j145506587;
	j850028177 [label="不过我们晚点再玩吧。",shape=box,color=blue];
		j850028177 -> j145506587;
}