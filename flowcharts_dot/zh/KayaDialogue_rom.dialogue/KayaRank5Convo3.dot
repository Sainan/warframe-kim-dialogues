		925 -> 928;
		925 -> 929;
	926 [label="哦来吧……我会放水的。我甚至会让阿米尔帮你！ ",shape=box,color=blue];
		926 -> 930;
	927 [label="Chat ends. Next chat will be KayaRank5Convo4.",color=orange];
	928 [label="既然你这么说的话……",shape=box,color=red];
		928 -> 931;
	929 [label="什么！我可没有那么多钱。",shape=box,color=red];
		929 -> 931;
	930 [label="而且如果你赢，我会送你一包没打开的吉尼梦卡！",shape=box,color=blue];
		930 -> 932;
		930 -> 933;
		930 -> 934;
	931 [label="没有问题，如果你只要在这里填下你的银行信息……",shape=box,color=blue];
