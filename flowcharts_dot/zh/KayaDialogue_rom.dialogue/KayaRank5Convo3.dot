digraph {
	887 [label="KayaRank5Convo3 begins.",color=orange];
		887 -> 888;
	888 [label="哦嗨，我可以向你介绍一下吉尼梦卡牌的基础知识吗？",shape=box,color=blue];
		888 -> 889;
	889 [label="阿米尔当然很高兴终于有人和他一起玩了（而且还让他输）。",shape=box,color=blue];
		889 -> 890;
	890 [label="但我们都觉得拉你入坑吉尼梦会很有意思。 ",shape=box,color=blue];
		890 -> 891;
		890 -> 892;
		890 -> 893;
	891 [label="你们玩吧。我很忙。[结束]",shape=box,color=red];
		891 -> 894;
	892 [label="我口袋里的几枚霍币放到都快把裤子烧穿了，我们怎么开始？",shape=box,color=red];
		892 -> 895;
	893 [label="提醒我一下……我们在说什么？",shape=box,color=red];
		893 -> 896;
	894 [label="+20 Chemistry",color=orange];
		894 -> 897;
	895 [label="好耶！好所以首先，我们来聚焦一下你。你觉得自己更像龙，更像鹰，还是更像豹呢？",shape=box,color=blue];
		895 -> 898;
		895 -> 899;
		895 -> 900;
	896 [label="就是那个 1999 年超火的节目、游戏、收藏品！",shape=box,color=blue];
		896 -> 901;
	897 [label="Chat ends. Next chat will be KayaRank5Convo4.",color=orange];
	898 [label="豹。",shape=box,color=red];
		898 -> 902;
	899 [label="鹰。",shape=box,color=red];
		899 -> 903;
	900 [label="龙。",shape=box,color=red];
		900 -> 904;
	901 [label="你知道的，有超酷的角色、生物……",shape=box,color=blue];
		901 -> 905;
	902 [label="好，那么你绝对会想用泰拉拉猫开始游戏",shape=box,color=blue];
		902 -> 906;
	903 [label="好，那么你肯定会想用伯特鸟开始游戏",shape=box,color=blue];
		903 -> 907;
	904 [label="好，那么你可能会想用博格蛙开始游戏。",shape=box,color=blue];
		904 -> 908;
	905 [label="我想这些不是重点。总之，我们还是先从你说起。你觉得自己更像龙，更像鹰，还是更像豹呢？",shape=box,color=blue];
		905 -> 898;
		905 -> 899;
		905 -> 900;
	906 [label="是最酷的选择，但绝对有难度，一开始很弱。",shape=box,color=blue];
		906 -> 909;
	907 [label="有一点进阶但非常酷。 ",shape=box,color=blue];
		907 -> 910;
	908 [label="是一个对新手很不错的选择。 ",shape=box,color=blue];
		908 -> 911;
	909 [label="但最后？你会得到一只最华丽、最威严的黑豹。",shape=box,color=blue];
		909 -> 912;
	910 [label="波波鸟超级可爱因为你可以给他喂泡泡葡萄，他可以比任何人升级的都快。",shape=box,color=blue];
		910 -> 913;
	911 [label="然后当然你会从最可爱的一只蛙蛙开始，但最终如果你赢得够多……",shape=box,color=blue];
		911 -> 914;
	912 [label="真是优雅的选择呢。",shape=box,color=blue];
		912 -> 915;
	913 [label="然后你就可以解锁一整套种地系统。",shape=box,color=blue];
		913 -> 915;
	914 [label="你可以将它进化成一条龙。",shape=box,color=blue];
		914 -> 915;
	915 [label="这到底是个什么游戏……",shape=box,color=red];
		915 -> 916;
	916 [label="好吧，基本上就是你去收集吉尼梦精灵，它们会为你战斗，然后你还可以去各地冒险。",shape=box,color=blue];
		916 -> 917;
	917 [label="但那是电子游戏的版本。在卡牌游戏中你会和现实中的其他人对战。",shape=box,color=blue];
		917 -> 918;
	918 [label="但都差不多就是了。吉尼梦吉尼梦吉尼梦。 ",shape=box,color=blue];
		918 -> 919;
	919 [label="所以，开始玩第一场吗？",shape=box,color=blue];
		919 -> 920;
		919 -> 921;
		919 -> 922;
		919 -> 923;
	920 [label="不要。[结束]",shape=box,color=red];
		920 -> 924;
	921 [label="当然为什么不呢，新手运气可在我这里。",shape=box,color=red];
		921 -> 925;
	922 [label="你只是想轻松赢一场。没门。",shape=box,color=red];
		922 -> 926;
	923 [label="不，我更迷惑了。你啥也没解释！ ",shape=box,color=red];
		923 -> 926;
	924 [label="+20 Chemistry",color=orange];
