digraph {
	460 [label="KayaRank3Convo2 begins.",color=orange];
		460 -> 461;
	461 [label="你似乎真的对“时间旅行”很好奇。说实在地，你很痴迷。",shape=box,color=red];
		461 -> 462;
	462 [label="正在努力。差不多了。",shape=box,color=blue];
		462 -> 463;
	463 [label="一旦你把时间旅行琢磨明白了，还有个更大的问题要考虑。永恒论。 ",shape=box,color=red];
		463 -> 464;
	464 [label="嗯……什么？",shape=box,color=blue];
		464 -> 465;
		464 -> 466;
	465 [label="我们看看你是不是聪明到能把这点弄清楚。因为永恒论，这个对话有一个没有在这里就结束的版本。[结束。]",shape=box,color=red];
		465 -> 467;
	466 [label="希望你不忙，因为这才是我来这里的真正原因。",shape=box,color=red];
		466 -> 468;
	467 [label="Update boolean KayaEternalismTest",color=orange];
		467 -> 469;
	468 [label="我不忙，请解释。这可能与时间操纵的最后理论润色息息相关。",shape=box,color=blue];
		468 -> 470;
	469 [label="+20 Chemistry",color=orange];
		469 -> 471;
	470 [label="这一切的发生并不是因为某位科学家想出了一个公式。",shape=box,color=red];
		470 -> 472;
	471 [label="Chat ends. Next chat will be KayaRank3Convo3.",color=orange];
	472 [label="嗯，我想事情就是这样开始的。",shape=box,color=red];
		472 -> 473;
	473 [label="但现在的这一切？已经超越了那些。这是因为阿尔布雷希特去了某个地方，唤醒了某个东西，然后它就跟着他回来了。虚空。",shape=box,color=red];
		473 -> 474;
		473 -> 475;
	474 [label="虚空既是活的，又不是。它是一个悖论，是我们每个人所经历的一切起源，也是这一切发生的理由。",shape=box,color=red];
		474 -> 476;
	475 [label="没有“元素周期表”或公式可以解释这一点。",shape=box,color=red];
		475 -> 477;
	476 [label="你好，世界。",shape=box,color=blue];
		476 -> 478;
		476 -> 479;
	477 [label="科学可以解释它。它主宰一切。",shape=box,color=blue];
		477 -> 480;
	478 [label="“再见，阿尔布雷希特”",shape=box,color=red];
		478 -> 481;
	479 [label="什么？",shape=box,color=red];
		479 -> 482;
	480 [label="Check boolean KayaVoidTest",color=orange];
		480 -> 484 [label=true,color=green];
		480 -> 483 [label=false,color=brown];
	481 [label="+5 Chemistry",color=orange];
		481 -> 485;
	482 [label="那是有史以来在互联网上发布的第一篇内容。第一条信息。由互联网的创建者发布，来证明互联网“运行了”。",shape=box,color=blue];
		482 -> 486;
	484 [label="这就是为什么我告诉你要小心虚空。",shape=box,color=red];
		484 -> 488;
	483 [label="如果解释不了怎么办？",shape=box,color=red];
		483 -> 487;
	485 [label="哈！我的天啊，但愿吧。但是你知道“你好，世界”吗？",shape=box,color=blue];
		485 -> 482;
	486 [label="然后一切都乱套了。人们像疯了一样。互联网改变了一切：科学、经济、技术、娱乐。",shape=box,color=blue];
		486 -> 489;
	488 [label="有些事是无法控制的。",shape=box,color=red];
		488 -> 491;
	487 [label="如果你认为的一切都是铁律……",shape=box,color=red];
		487 -> 490;
	489 [label="经过数十亿次的选择和因果关系，有一天我上线了…… ",shape=box,color=blue];
		489 -> 492;
	491 [label="也有些事是无法解释的。",shape=box,color=red];
		491 -> 493;
	490 [label="而这一切会发生，只是因为外部有什么东西想要它发生。",shape=box,color=red];
		490 -> 493;
	492 [label="这就是 Nova（或者更确切地说是卡娅）的末日。她的未来、事业、朋友，一切的一切。只因一个错误。 ",shape=box,color=blue];
		492 -> 494;
	493 [label="所以你是说，我的实验、测试、研究和假设中缺少部分的是“魔法”。",shape=box,color=blue];
		493 -> 495;
		493 -> 496;
	494 [label="所以我想比起其他人，我更信任虚空。",shape=box,color=blue];
		494 -> 497;
		494 -> 498;
		494 -> 499;
	495 [label="不是魔法。就只是……虚空。虚空。一种来自其他地方的能量。",shape=box,color=red];
		495 -> 500;
	496 [label="你有看过我能做什么吗? ",shape=box,color=red];
		496 -> 501;
	497 [label="别 [结束]。",shape=box,color=red];
		497 -> 502;
	498 [label="真悲观啊，Nova。",shape=box,color=red];
		498 -> 503;
	499 [label="我之前也相信过虚空。",shape=box,color=red];
		499 -> 503;
	500 [label="这会对我有帮助。",shape=box,color=blue];
		500 -> 504;
		500 -> 505;
	501 [label="看到过。观察过。记录过。研究过。也重新研究过。嗯。这一切都可以解释。它根植于某种东西。也许是“魔法”。",shape=box,color=blue];
		501 -> 506;
	502 [label="+20 Chemistry",color=orange];
		502 -> 507;
	503 [label="我想也许你还没有完全明白。 ",shape=box,color=blue];
		503 -> 508;
	504 [label="如果你鲁莽行事，可能会失去一切。",shape=box,color=red];
		504 -> 503;
	505 [label="这对你“有帮助”？",shape=box,color=red];
		505 -> 503;
	506 [label="这会对我有帮助。",shape=box,color=blue];
		506 -> 504;
		506 -> 505;
	507 [label="Chat ends. Next chat will be KayaRank3Convo3.",color=orange];
	508 [label="但我要离开 1999 年。",shape=box,color=blue];
		508 -> 509;
	509 [label="我根本不关心在到达那里的过程中会发生什么。",shape=box,color=blue];
		509 -> 510;
	510 [label="这是占据我大脑的唯一一件事。",shape=box,color=blue];
		510 -> 511;
	511 [label="对我来说，这是件好事。 ",shape=box,color=blue];
		511 -> 512;
	512 [label="+20 Chemistry",color=orange];
