digraph {
	"KayaRank3Convo2 begins." [color=orange];
		"KayaRank3Convo2 begins." -> j3946861921;
	j3946861921 [label="你似乎真的对“时间旅行”很好奇。说实在地，你很痴迷。",shape=box,color=red];
		j3946861921 -> j2115791375;
	j2115791375 [label="正在努力。差不多了。",shape=box,color=blue];
		j2115791375 -> j3199166066;
	j3199166066 [label="一旦你把时间旅行琢磨明白了，还有个更大的问题要考虑。永恒论。 ",shape=box,color=red];
		j3199166066 -> j1705816678;
	j1705816678 [label="嗯……什么？",shape=box,color=blue];
		j1705816678 -> j1484119235;
		j1705816678 -> j4214895251;
	j1484119235 [label="我们看看你是不是聪明到能把这点弄清楚。因为永恒论，这个对话有一个没有在这里就结束的版本。[结束。]",shape=box,color=red];
		j1484119235 -> j3655577789;
	j4214895251 [label="希望你不忙，因为这才是我来这里的真正原因。",shape=box,color=red];
		j4214895251 -> j3237030637;
	j3655577789 [label="Boolean KayaEternalismTest is now true.",color=orange];
		j3655577789 -> j2156753723;
	j3237030637 [label="我不忙，请解释。这可能与时间操纵的最后理论润色息息相关。",shape=box,color=blue];
		j3237030637 -> j1624814258;
	j2156753723 [label="+20 Chemistry",color=orange];
		j2156753723 -> "Chat ends. Next chat will be KayaRank3Convo3.";
	j1624814258 [label="这一切的发生并不是因为某位科学家想出了一个公式。",shape=box,color=red];
		j1624814258 -> j847708981;
	"Chat ends. Next chat will be KayaRank3Convo3." [color=orange];
	j847708981 [label="嗯，我想事情就是这样开始的。",shape=box,color=red];
		j847708981 -> j4039882341;
	j4039882341 [label="但现在的这一切？已经超越了那些。这是因为阿尔布雷希特去了某个地方，唤醒了某个东西，然后它就跟着他回来了。虚空。",shape=box,color=red];
		j4039882341 -> j4234821844;
		j4039882341 -> j1143982949;
	j4234821844 [label="虚空既是活的，又不是。它是一个悖论，是我们每个人所经历的一切起源，也是这一切发生的理由。",shape=box,color=red];
		j4234821844 -> j626738540;
	j1143982949 [label="没有“元素周期表”或公式可以解释这一点。",shape=box,color=red];
		j1143982949 -> j1704691950;
	j626738540 [label="你好，世界。",shape=box,color=blue];
		j626738540 -> j664783607;
		j626738540 -> j2827181680;
	j1704691950 [label="科学可以解释它。它主宰一切。",shape=box,color=blue];
		j1704691950 -> j3668359530;
	j664783607 [label="“再见，阿尔布雷希特”",shape=box,color=red];
		j664783607 -> j673449812;
	j2827181680 [label="什么？",shape=box,color=red];
		j2827181680 -> j3765540444;
	j3668359530 [label="Check boolean KayaVoidTest",color=orange];
		j3668359530 -> j3129648597 [label=true,color=green];
		j3668359530 -> j1443973737 [label=false,color=brown];
	j673449812 [label="+5 Chemistry",color=orange];
		j673449812 -> j447042877;
	j3765540444 [label="那是有史以来在互联网上发布的第一篇内容。第一条信息。由互联网的创建者发布，来证明互联网“运行了”。",shape=box,color=blue];
		j3765540444 -> j191662330;
	j3129648597 [label="这就是为什么我告诉你要小心虚空。",shape=box,color=red];
		j3129648597 -> j3155020601;
	j1443973737 [label="如果解释不了怎么办？",shape=box,color=red];
		j1443973737 -> j2939701463;
	j447042877 [label="哈！我的天啊，但愿吧。但是你知道“你好，世界”吗？",shape=box,color=blue];
		j447042877 -> j3765540444;
	j191662330 [label="然后一切都乱套了。人们像疯了一样。互联网改变了一切：科学、经济、技术、娱乐。",shape=box,color=blue];
		j191662330 -> j4044852528;
	j3155020601 [label="有些事是无法控制的。",shape=box,color=red];
		j3155020601 -> j2415458151;
	j2939701463 [label="如果你认为的一切都是铁律……",shape=box,color=red];
		j2939701463 -> j731201747;
	j4044852528 [label="经过数十亿次的选择和因果关系，有一天我上线了…… ",shape=box,color=blue];
		j4044852528 -> j2663126633;
	j2415458151 [label="也有些事是无法解释的。",shape=box,color=red];
		j2415458151 -> j1534311553;
	j731201747 [label="而这一切会发生，只是因为外部有什么东西想要它发生。",shape=box,color=red];
		j731201747 -> j1534311553;
	j2663126633 [label="这就是 Nova（或者更确切地说是卡娅）的末日。她的未来、事业、朋友，一切的一切。只因一个错误。 ",shape=box,color=blue];
		j2663126633 -> j1921593363;
	j1534311553 [label="所以你是说，我的实验、测试、研究和假设中缺少部分的是“魔法”。",shape=box,color=blue];
		j1534311553 -> j2039233328;
		j1534311553 -> j61852582;
	j1921593363 [label="所以我想比起其他人，我更信任虚空。",shape=box,color=blue];
		j1921593363 -> j1014358658;
		j1921593363 -> j1828404821;
		j1921593363 -> j3970261338;
	j2039233328 [label="不是魔法。就只是……虚空。虚空。一种来自其他地方的能量。",shape=box,color=red];
		j2039233328 -> j3721852181;
	j61852582 [label="你有看过我能做什么吗? ",shape=box,color=red];
		j61852582 -> j3672415561;
	j1014358658 [label="别 [结束]。",shape=box,color=red];
		j1014358658 -> j2156753723;
	j1828404821 [label="真悲观啊，Nova。",shape=box,color=red];
		j1828404821 -> j2387570868;
	j3970261338 [label="我之前也相信过虚空。",shape=box,color=red];
		j3970261338 -> j2387570868;
	j3721852181 [label="这会对我有帮助。",shape=box,color=blue];
		j3721852181 -> j1676235618;
		j3721852181 -> j1086479556;
	j3672415561 [label="看到过。观察过。记录过。研究过。也重新研究过。嗯。这一切都可以解释。它根植于某种东西。也许是“魔法”。",shape=box,color=blue];
		j3672415561 -> j3721852181;
	j2387570868 [label="我想也许你还没有完全明白。 ",shape=box,color=blue];
		j2387570868 -> j171592205;
	j1676235618 [label="如果你鲁莽行事，可能会失去一切。",shape=box,color=red];
		j1676235618 -> j2387570868;
	j1086479556 [label="这对你“有帮助”？",shape=box,color=red];
		j1086479556 -> j2387570868;
	j171592205 [label="但我要离开 1999 年。",shape=box,color=blue];
		j171592205 -> j1412162899;
	j1412162899 [label="我根本不关心在到达那里的过程中会发生什么。",shape=box,color=blue];
		j1412162899 -> j632717757;
	j632717757 [label="这是占据我大脑的唯一一件事。",shape=box,color=blue];
		j632717757 -> j3659932788;
	j3659932788 [label="对我来说，这是件好事。 ",shape=box,color=blue];
		j3659932788 -> j2156753723;
}