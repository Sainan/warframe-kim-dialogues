digraph {
	"KayaRank4Convo1 begins." [color=orange];
		"KayaRank4Convo1 begins." -> j3287365910;
	j3287365910 [label="你想知道那是什么样子吗？互联网的出现，给我们带来了很多可能性。",shape=box,color=blue];
		j3287365910 -> j4288792500;
	j4288792500 [label="所以你代入一下我。你 18 岁了。你登录网络。开始与来自各个地方的新朋友聊天！",shape=box,color=blue];
		j4288792500 -> j3478349436;
	j3478349436 [label="而你作为一个公认的“聪明妞”，却在网上做了最愚蠢的事。 ",shape=box,color=blue];
		j3478349436 -> j2858367832;
	j2858367832 [label="你轻信了网络另一端的人。 ",shape=box,color=blue];
		j2858367832 -> j3897888647;
	j3897888647 [label="当你面对这个崭新的科技时，你便忘了人心险恶。 ",shape=box,color=blue];
		j3897888647 -> j1876326336;
	j1876326336 [label="于是你发了一张令人脸红的裸照。你相信你和网上认识的人的关系。觉得可以信任你的网恋男友。 ",shape=box,color=blue];
		j1876326336 -> j1124368426;
	j1124368426 [label="接着第二天，这张照片就到处都是了。校园里的每个人都看到了它。互相分享。发给你的教授。传遍了整个互联网。甚至传到了我都不知道其存在的国家。",shape=box,color=blue];
		j1124368426 -> j1331770219;
	j1331770219 [label="我可能是这地球上最聪明的人，但人们只会因为那张照片而记住我。",shape=box,color=blue];
		j1331770219 -> j1876923712;
	j1876923712 [label="所以，当我说我要离开这里时，我是认真的。我知道那张照片毫无意义，生活在前进，人们只是想找点乐子。",shape=box,color=blue];
		j1876923712 -> j1305898827;
	j1305898827 [label="但对我来说，它毁了我的生活。我想生活在没有互联网的未来。我想证明我能从这件事中走出来。回到过去就证明他们是对的，我就无法摆脱这件事。",shape=box,color=blue];
		j1305898827 -> j473741199;
	j473741199 [label="所以，等着吧。你会在你的来处见到我。 ",shape=box,color=blue];
		j473741199 -> j4270464529;
	j4270464529 [label="然后看着这个世界，我们可以笑着说，我的选择并没有毁了我。这一切只是让我变得更聪明。聪明到可以摆脱这一切。",shape=box,color=blue];
		j4270464529 -> j3258508148;
	j3258508148 [label="+20 Chemistry",color=orange];
		j3258508148 -> "Chat ends. Next chat will be KayaRank4Convo2.";
	"Chat ends. Next chat will be KayaRank4Convo2." [color=orange];
}