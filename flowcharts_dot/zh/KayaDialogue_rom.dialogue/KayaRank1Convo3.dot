digraph {
	"KayaRank1Convo3 begins." [color=orange];
		"KayaRank1Convo3 begins." -> j2019027283;
	j2019027283 [label="时间旅行——它花费大吗？涉及原材料的成本吗？还是在你的时代已经成为了某种可以与这里相关联的商品？",shape=box,color=blue];
		j2019027283 -> j352445184;
		j2019027283 -> j3488096862;
	j352445184 [label="为什么这么问？想省下几块霍币来贿赂我吗？",shape=box,color=red];
		j352445184 -> j1388370822;
	j3488096862 [label="有些成本是不会以霍币的形式显示的。顺便说一句，嗨。 ",shape=box,color=red];
		j3488096862 -> j2306343102;
	j1388370822 [label="这招对英择谛有效。",shape=box,color=blue];
		j1388370822 -> j2312597080;
		j1388370822 -> j2631024370;
	j2306343102 [label="嗨。所以我不能就这样付钱给某人然后学会怎么去做吗？",shape=box,color=blue];
		j2306343102 -> j3729864696;
		j2306343102 -> j1688502252;
		j2306343102 -> j3583717885;
	j2312597080 [label="你再说一次？",shape=box,color=red];
		j2312597080 -> j1310704431;
	j2631024370 [label="什么？",shape=box,color=red];
		j2631024370 -> j1310704431;
	j3729864696 [label="你知道你的批次‘Nova’和时间旅行没关系，对吧？",shape=box,color=red];
		j3729864696 -> j1211494482;
	j1688502252 [label="听着，你好像只关心一件事。时间旅行。为什么？",shape=box,color=red];
		j1688502252 -> j3767472231;
	j3583717885 [label="你不能。[结束]",shape=box,color=red];
		j3583717885 -> j3994434447;
	j1310704431 [label="Check boolean KayaSetFound",color=orange];
		j1310704431 -> j1593997890 [label=true,color=green];
		j1310704431 -> j1174728416 [label=false,color=brown];
	j1211494482 [label="Nova 能做什么不能做什么并不重要。",shape=box,color=blue];
		j1211494482 -> j2647674648;
	j3767472231 [label="你不会明白的。",shape=box,color=blue];
		j3767472231 -> j4068424555;
		j3767472231 -> j2676668847;
	j3994434447 [label="+20 Chemistry",color=orange];
		j3994434447 -> "Chat ends. Next chat will be KayaRank2Convo1.";
	j1593997890 [label="呃，我已经告诉你了。我找到他了。",shape=box,color=blue];
		j1593997890 -> j1993021742;
	j1174728416 [label="是这样的。",shape=box,color=blue];
		j1174728416 -> j2619091749;
	j2647674648 [label="Check boolean KayaAmirTravel",color=orange];
		j2647674648 -> j1978094500 [label=true,color=green];
		j2647674648 -> j368315635 [label=false,color=brown];
	j4068424555 [label="你根本不了解我。等等，这不是你常说的吗？",shape=box,color=red];
		j4068424555 -> j2000150120;
	j2676668847 [label="我保证我能明白。",shape=box,color=red];
		j2676668847 -> j2930844637;
	"Chat ends. Next chat will be KayaRank2Convo1." [color=orange];
	j1993021742 [label="+5 Chemistry",color=orange];
		j1993021742 -> j1174728416;
	j2619091749 [label="他当时在电脑上忙些什么。",shape=box,color=blue];
		j2619091749 -> j4184737952;
	j1978094500 [label="好吧，我想我们在试着充分利用我们手头的工具。你有没有跟阿米尔谈过你的问题？",shape=box,color=red];
		j1978094500 -> j2030418759;
	j368315635 [label="Check boolean KayaLettieHeal",color=orange];
		j368315635 -> j2627242813 [label=true,color=green];
		j368315635 -> j1330859092 [label=false,color=brown];
	j2000150120 [label="是，我不了解你。我只知道你能做什么。这也是我们为什么在交谈的原因。请认真点。",shape=box,color=blue];
		j2000150120 -> j2718068519;
	j2930844637 [label="来自互联网上一个陌生人的保证，别开玩笑了。哈。告诉我我想知道的就行。",shape=box,color=blue];
		j2930844637 -> j4265187549;
	j4184737952 [label="然后我一出现，他竟然吓了一跳。就像，他根本没想到会有人出现。",shape=box,color=blue];
		j4184737952 -> j1274851199;
		j4184737952 -> j257631086;
	j2030418759 [label="我问过了。我们在一些基本理论上有共识，但他似乎对具体的、可复现的时间旅行定理不感兴趣。 ",shape=box,color=blue];
		j2030418759 -> j3266871983;
	j2627242813 [label="好吧，我想我们在试着充分利用我们手头的工具。你和莱蒂谈过吗？我感觉你们会合得来。",shape=box,color=red];
		j2627242813 -> j1043222120;
	j1330859092 [label="对，我只是觉得如果你能使用我这个时代的更多工具，可能会更简单些。",shape=box,color=red];
		j1330859092 -> j3373570125;
	j2718068519 [label="好吧，我们认真一点。",shape=box,color=red];
		j2718068519 -> j2031388416;
		j2718068519 -> j2796735690;
	j4265187549 [label="你是不是经历了什么？",shape=box,color=red];
		j4265187549 -> j3920912612;
	j1274851199 [label="哇，真是厉害。",shape=box,color=red];
		j1274851199 -> j3976209401;
	j257631086 [label="哇，你这是在吹牛吗？",shape=box,color=red];
		j257631086 -> j3976209401;
	j3266871983 [label="事实上，他让我相信我在一些原始假设上是错误的，所以这的确有帮助，但他提醒我，如果你不帮我的话，也许我可以花钱找到答案，或者至少花钱与未来的某个人交谈。",shape=box,color=blue];
		j3266871983 -> j27835109;
		j3266871983 -> j3906086010;
	j1043222120 [label="我们确实很合得来。她让我想起了我以前的一位老师，她一点也不刻薄，而且非常欣赏我的才智。",shape=box,color=blue];
		j1043222120 -> j661526181;
	j3373570125 [label="这算是个提议吗？我能使用什么？任何帮助都会有用。",shape=box,color=blue];
		j3373570125 -> j1745504268;
	j2031388416 [label="你想要时间旅行，但去哪里呢？为什么？",shape=box,color=red];
		j2031388416 -> j18384358;
	j2796735690 [label="你看过周围了吗？",shape=box,color=red];
		j2796735690 -> j2042661539;
	j3920912612 [label="我们都经历了一些事。如果你找到了帮助我的方法，告诉我一声。",shape=box,color=blue];
		j3920912612 -> j3994434447;
	j3976209401 [label="呃，我为什么还要跟你说这个？",shape=box,color=blue];
		j3976209401 -> j48968139;
	j27835109 [label="给我 10 霍币，我就告诉你你是怎么死的。",shape=box,color=red];
		j27835109 -> j3118047252;
	j3906086010 [label="任何向你推销这种东西的人都是在撒谎。我会尽力帮助你，真的。不收钱。",shape=box,color=red];
		j3906086010 -> j3308684592;
	j661526181 [label="她实际上非常随和。也很聪明。不过，她还是让我真正去信任你，所以我想我们拭目以待吧。",shape=box,color=blue];
		j661526181 -> j1037139102;
		j661526181 -> j4275893303;
	j1745504268 [label="如果你想按自己的方式弄清楚，我会看看能找到什么帮助你的。",shape=box,color=red];
		j1745504268 -> j3271291266;
	j18384358 [label="你能搞懂哪怕任何东西吗？呃。",shape=box,color=blue];
		j18384358 -> j1234968438;
	j2042661539 [label="看过了。我什么都看过了。这个千禧年的奇迹转折。因为人们都想让‘那个女孩’出现，所以我被邀请到了很多派对。",shape=box,color=blue];
		j2042661539 -> j1203426102;
	j48968139 [label="直接告诉我，我需要去攒钱或者做些什么吗？",shape=box,color=blue];
		j48968139 -> j2527917460;
		j48968139 -> j1696657690;
	j3118047252 [label="呃。变态。",shape=box,color=blue];
		j3118047252 -> j3994434447;
	j3308684592 [label="我们拭目以待吧。",shape=box,color=blue];
		j3308684592 -> j3994434447;
	j1037139102 [label="我来这里不是为了背叛你或其他什么，我也不是什么时间旅行的教科书",shape=box,color=red];
		j1037139102 -> j3526066010;
	j4275893303 [label="我向你保证你可以信任我，我不确定你为什么这么有敌意。",shape=box,color=red];
		j4275893303 -> j603470847;
	j3271291266 [label="我想。我会努力的。",shape=box,color=blue];
		j3271291266 -> j3994434447;
	j1234968438 [label="谁还想留在这里？就像……",shape=box,color=blue];
		j1234968438 -> j3237672292;
	j1203426102 [label="这种事永远不会停下来。向前看吧。当你能帮我的时候来找我。",shape=box,color=blue];
		j1203426102 -> j3994434447;
	j2527917460 [label="卡娅，我觉得你对这件事太过痴迷了。如果你搞不定怎么办？",shape=box,color=red];
		j2527917460 -> j443287151;
	j1696657690 [label="不清楚。卡娅，我是被选中的人。 ",shape=box,color=red];
		j1696657690 -> j3283918468;
	j3526066010 [label="呃。行吧",shape=box,color=blue];
		j3526066010 -> j3994434447;
	j603470847 [label="我有我的理由",shape=box,color=blue];
		j603470847 -> j3994434447;
	j3237672292 [label="我会弄明白的，我知道我能，所以，嗯。再见。",shape=box,color=blue];
		j3237672292 -> j3994434447;
	j443287151 [label="我会搞定的。",shape=box,color=blue];
		j443287151 -> j3994434447;
	j3283918468 [label="是啊，一个被选中的蠢货",shape=box,color=blue];
		j3283918468 -> j3994434447;
}