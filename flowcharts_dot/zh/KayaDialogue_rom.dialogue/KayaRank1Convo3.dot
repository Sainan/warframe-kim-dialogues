		91 -> 96;
	92 [label="你再说一次？",shape=box,color=red];
		92 -> 97;
	93 [label="什么？",shape=box,color=red];
		93 -> 97;
	94 [label="你知道你的批次‘Nova’和时间旅行没关系，对吧？",shape=box,color=red];
