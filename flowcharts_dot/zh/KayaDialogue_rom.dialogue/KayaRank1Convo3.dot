digraph {
	86 [label="KayaRank1Convo3 begins.",color=orange];
		86 -> 87;
	87 [label="时间旅行——它花费大吗？涉及原材料的成本吗？还是在你的时代已经成为了某种可以与这里相关联的商品？",shape=box,color=blue];
		87 -> 88;
		87 -> 89;
	88 [label="为什么这么问？想省下几块霍币来贿赂我吗？",shape=box,color=red];
		88 -> 90;
	89 [label="有些成本是不会以霍币的形式显示的。顺便说一句，嗨。 ",shape=box,color=red];
		89 -> 91;
	90 [label="这招对英择谛有效。",shape=box,color=blue];
		90 -> 92;
		90 -> 93;
	91 [label="嗨。所以我不能就这样付钱给某人然后学会怎么去做吗？",shape=box,color=blue];
		91 -> 94;
