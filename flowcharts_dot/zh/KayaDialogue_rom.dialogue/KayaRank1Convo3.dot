	108 [label="+5 Chemistry",color=orange];
		108 -> 101;
	107 [label="他当时在电脑上忙些什么。",shape=box,color=blue];
		107 -> 113;
	110 [label="好吧，我想我们在试着充分利用我们手头的工具。你有没有跟阿米尔谈过你的问题？",shape=box,color=red];
		110 -> 116;
	109 [label="Check boolean KayaLettieHeal",color=orange];
		109 -> 115 [label=true,color=green];
		109 -> 114 [label=false,color=brown];
	111 [label="是，我不了解你。我只知道你能做什么。这也是我们为什么在交谈的原因。请认真点。",shape=box,color=blue];
		111 -> 117;
	112 [label="来自互联网上一个陌生人的保证，别开玩笑了。哈。告诉我我想知道的就行。",shape=box,color=blue];
		112 -> 118;
	113 [label="然后我一出现，他竟然吓了一跳。就像，他根本没想到会有人出现。",shape=box,color=blue];
		113 -> 119;
		113 -> 120;
	116 [label="我问过了。我们在一些基本理论上有共识，但他似乎对具体的、可复现的时间旅行定理不感兴趣。 ",shape=box,color=blue];
		116 -> 123;
	115 [label="好吧，我想我们在试着充分利用我们手头的工具。你和莱蒂谈过吗？我感觉你们会合得来。",shape=box,color=red];
		115 -> 122;
	114 [label="对，我只是觉得如果你能使用我这个时代的更多工具，可能会更简单些。",shape=box,color=red];
		114 -> 121;
	117 [label="好吧，我们认真一点。",shape=box,color=red];
		117 -> 124;
		117 -> 125;
	118 [label="你是不是经历了什么？",shape=box,color=red];
		118 -> 126;
	119 [label="哇，真是厉害。",shape=box,color=red];
		119 -> 127;
	120 [label="哇，你这是在吹牛吗？",shape=box,color=red];
		120 -> 127;
	123 [label="事实上，他让我相信我在一些原始假设上是错误的，所以这的确有帮助，但他提醒我，如果你不帮我的话，也许我可以花钱找到答案，或者至少花钱与未来的某个人交谈。",shape=box,color=blue];
		123 -> 130;
		123 -> 131;
	122 [label="我们确实很合得来。她让我想起了我以前的一位老师，她一点也不刻薄，而且非常欣赏我的才智。",shape=box,color=blue];
		122 -> 129;
	121 [label="这算是个提议吗？我能使用什么？任何帮助都会有用。",shape=box,color=blue];
		121 -> 128;
	124 [label="你想要时间旅行，但去哪里呢？为什么？",shape=box,color=red];
		124 -> 132;
	125 [label="你看过周围了吗？",shape=box,color=red];
		125 -> 133;
	126 [label="我们都经历了一些事。如果你找到了帮助我的方法，告诉我一声。",shape=box,color=blue];
		126 -> 134;
	127 [label="呃，我为什么还要跟你说这个？",shape=box,color=blue];
		127 -> 135;
	130 [label="给我 10 霍币，我就告诉你你是怎么死的。",shape=box,color=red];
		130 -> 139;
	131 [label="任何向你推销这种东西的人都是在撒谎。我会尽力帮助你，真的。不收钱。",shape=box,color=red];
		131 -> 140;
	129 [label="她实际上非常随和。也很聪明。不过，她还是让我真正去信任你，所以我想我们拭目以待吧。",shape=box,color=blue];
		129 -> 137;
		129 -> 138;
	128 [label="如果你想按自己的方式弄清楚，我会看看能找到什么帮助你的。",shape=box,color=red];
		128 -> 136;
	132 [label="你能搞懂哪怕任何东西吗？呃。",shape=box,color=blue];
		132 -> 141;
	133 [label="看过了。我什么都看过了。这个千禧年的奇迹转折。因为人们都想让‘那个女孩’出现，所以我被邀请到了很多派对。",shape=box,color=blue];
		133 -> 142;
	134 [label="+20 Chemistry",color=orange];
		134 -> 143;
	135 [label="直接告诉我，我需要去攒钱或者做些什么吗？",shape=box,color=blue];
