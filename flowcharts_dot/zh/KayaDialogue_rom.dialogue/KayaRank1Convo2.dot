digraph {
	"KayaRank1Convo2 begins." [color=orange];
		"KayaRank1Convo2 begins." -> j38758685;
	j38758685 [label="嗨。为什么英择谛的跨时间装置会涉及到需要和即时通在线网络保持活跃的连接？",shape=box,color=blue];
		j38758685 -> j2334963416;
	j2334963416 [label="或者，我猜，嗨。时间旅行需要用到互联网吗？",shape=box,color=blue];
		j2334963416 -> j3963024654;
		j2334963416 -> j2923087650;
	j3963024654 [label="好吧，那我就直接说吧。不，‘互联网’并没有延续到我的时代，所以它应该不是必需的。但也可能是。 ",shape=box,color=red];
		j3963024654 -> j2471354235;
	j2923087650 [label="嗨卡娅，你也好啊。 ",shape=box,color=red];
		j2923087650 -> j779491458;
	j2471354235 [label="所以你不需要连互联网就可以随意进出吗？英择谛需要吗？",shape=box,color=blue];
		j2471354235 -> j277824570;
	j779491458 [label="呃。互联网？考虑到网络的属性，我可以理解……",shape=box,color=blue];
		j779491458 -> j277824570;
	j277824570 [label="我真的什么都不敢肯定。我只知道有一个数列，英择谛有个计划，而它涉及到我现在在这里。我需要到这里来，遇见你们。",shape=box,color=red];
		j277824570 -> j867690433;
	j867690433 [label="好吧，但为什么看起来他的一些笔记中坚持要有互联网连接呢？",shape=box,color=blue];
		j867690433 -> j772131819;
		j867690433 -> j1937615383;
		j867690433 -> j478708454;
	j772131819 [label="下次见到他我会问问他的。",shape=box,color=red];
		j772131819 -> j1600259003;
	j1937615383 [label="你有他的笔记？",shape=box,color=red];
		j1937615383 -> j602020503;
	j478708454 [label="这有问题吗？像你这样的孩子不是都喜欢互联网吗？ ",shape=box,color=red];
		j478708454 -> j2322558332;
	j1600259003 [label="？",shape=box,color=blue];
		j1600259003 -> j2067923325;
		j1600259003 -> j3515610118;
	j602020503 [label="不是真的有。我只是在找到他时看到了一些东西。我觉得他没想到会被人发现。",shape=box,color=blue];
		j602020503 -> j448789439;
	j2322558332 [label="Check boolean KayaSetKid",color=orange];
		j2322558332 -> j2419596796 [label=true,color=green];
		j2322558332 -> j71094360 [label=false,color=brown];
	j2067923325 [label="抱歉，我只是开个玩笑……在未来是有笑话的。",shape=box,color=red];
		j2067923325 -> j3752051292;
	j3515610118 [label="开个玩笑。放轻松点。",shape=box,color=red];
		j3515610118 -> j3139476125;
	j448789439 [label="Boolean KayaSetFound is now true.",color=orange];
		j448789439 -> j162779587;
		j448789439 -> j3921055861;
	j2419596796 [label="老是叫我小孩，这让你自我感觉更好吗？你怎么就不明白呢？",shape=box,color=blue];
		j2419596796 -> j2271472028;
	j71094360 [label="你根本不了解我。",shape=box,color=blue];
		j71094360 -> j1557784581;
	j3752051292 [label="好吧。",shape=box,color=blue];
		j3752051292 -> j3294301468;
	j3139476125 [label="不。",shape=box,color=blue];
		j3139476125 -> j1557784581;
	j162779587 [label="你？当别人都找不到英择谛的时候，你却找到了他？",shape=box,color=red];
		j162779587 -> j2715445820;
	j3921055861 [label="你找到他了？怎么做到的？",shape=box,color=red];
		j3921055861 -> j2715445820;
	j2271472028 [label="我不得不快点长大。这全是因为那些该死的互联网上的人。",shape=box,color=blue];
		j2271472028 -> j1557784581;
	j1557784581 [label="+20 Chemistry",color=orange];
		j1557784581 -> "Chat ends. Next chat will be KayaRank1Convo3.";
	j3294301468 [label="+20 Chemistry",color=orange];
		j3294301468 -> j662322110;
	j2715445820 [label="我想要答案。",shape=box,color=blue];
		j2715445820 -> j2325987379;
	"Chat ends. Next chat will be KayaRank1Convo3." [color=orange];
	j662322110 [label="那你确定未来没有互联网？完全确定？",shape=box,color=blue];
		j662322110 -> j1597337580;
	j2325987379 [label="+20 Chemistry",color=orange];
		j2325987379 -> j1509218521;
	j1597337580 [label="其实，算了，当我什么都没说。等我到了那里自然会知道。",shape=box,color=blue];
		j1597337580 -> j1557784581;
	j1509218521 [label="这个鬼地方变化太快了。尤其是在互联网后台里那些关于这个博士的讨论。",shape=box,color=blue];
		j1509218521 -> j127113203;
	j127113203 [label="于是我找到了他，让他大吃一惊。天啊。博士爷爷不太高兴，但我直奔主题。",shape=box,color=blue];
		j127113203 -> j824493648;
	j824493648 [label="我知道他来自未来。他也知道我知道。他给了我一个选择，好吧，不管怎样。现在我找到了你。 ",shape=box,color=blue];
		j824493648 -> j247296006;
	j247296006 [label="某种意义上，我也给你一个选择。帮助我，或者你会后悔。",shape=box,color=blue];
		j247296006 -> j1751820256;
		j247296006 -> j3491349530;
	j1751820256 [label="很好。你要知道，我不是你的敌人。",shape=box,color=red];
		j1751820256 -> j4043129818;
	j3491349530 [label="你对所有新朋友都这样威胁的吗？",shape=box,color=red];
		j3491349530 -> j2857571044;
	j4043129818 [label="至少现在还不是。人总会变的。我们走着瞧。",shape=box,color=blue];
		j4043129818 -> j1557784581;
	j2857571044 [label="我只是在保护我自己。 ",shape=box,color=blue];
		j2857571044 -> j1557784581;
}