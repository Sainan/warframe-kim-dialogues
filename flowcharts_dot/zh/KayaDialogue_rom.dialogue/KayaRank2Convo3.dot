digraph {
	"KayaRank2Convo3 begins." [color=orange];
		"KayaRank2Convo3 begins." -> j4146475611;
	j4146475611 [label="你能解释一下‘Protea’的机制吗？我挖到了一些她的蓝图资料，需要确认一下。",shape=box,color=blue];
		j4146475611 -> j1511309857;
		j4146475611 -> j1582168710;
		j4146475611 -> j3072977145;
	j1511309857 [label="不，我不能。[结束]",shape=box,color=red];
		j1511309857 -> j2189522063;
	j1582168710 [label="解释她的机制？我可以试试。",shape=box,color=red];
		j1582168710 -> j4050377172;
		j1582168710 -> j4246391002;
	j3072977145 [label="Protea？她很复杂。",shape=box,color=red];
		j3072977145 -> j2317393192;
	j2189522063 [label="+20 Chemistry",color=orange];
		j2189522063 -> "Chat ends. Next chat will be KayaRank3Convo1.";
	j4050377172 [label="投掷。",shape=box,color=red];
		j4050377172 -> j4085509775;
	j4246391002 [label="我猜你想了解时泊之锚？",shape=box,color=red];
		j4246391002 -> j1204159587;
	j2317393192 [label="不仅仅是因为她能做什么，还因为她的来历。",shape=box,color=red];
		j2317393192 -> j3963656646;
		j2317393192 -> j4246391002;
	"Chat ends. Next chat will be KayaRank3Convo1." [color=orange];
	j4085509775 [label="投掷？",shape=box,color=blue];
		j4085509775 -> j3780044854;
		j4085509775 -> j4188387101;
	j1204159587 [label="+5 Chemistry",color=orange];
		j1204159587 -> j3339056814;
	j3963656646 [label="不管她原来是谁，她现在是为帕尔沃斯·格拉努效力的。",shape=box,color=red];
		j3963656646 -> j4075767629;
	j3780044854 [label="投掷，然后继续投掷。",shape=box,color=red];
		j3780044854 -> j1488902573;
	j4188387101 [label="你自己问的。",shape=box,color=red];
		j4188387101 -> j345260036;
	j3339056814 [label="是的。",shape=box,color=blue];
		j3339056814 -> j436482773;
	j4075767629 [label="是是，有钱有势的高智商大反派。老掉牙的套路。",shape=box,color=blue];
		j4075767629 -> j2611845394;
		j4075767629 -> j3184866120;
		j4075767629 -> j2513254407;
	j1488902573 [label="呃。那再见了？再见。",shape=box,color=blue];
		j1488902573 -> j2189522063;
	j345260036 [label="我是问了，本以为可以听到她与时间关联性的解答，至少从我观察到的……",shape=box,color=blue];
		j345260036 -> j436482773;
	j436482773 [label="是的。因为时间旅行，或者是对时间方面的某种掌握的表现。",shape=box,color=red];
		j436482773 -> j1148411284;
	j2611845394 [label="你知道这种人？",shape=box,color=red];
		j2611845394 -> j2324928337;
	j3184866120 [label="他不全是坏人，但你这么说也差不多。",shape=box,color=red];
		j3184866120 -> j2413606021;
	j2513254407 [label="他要为很多事负责。太多了，无法一一列举，但 Protea 是其中之一。",shape=box,color=red];
		j2513254407 -> j1969696095;
	j1148411284 [label="没错。",shape=box,color=blue];
		j1148411284 -> j1933471669;
		j1148411284 -> j1370749021;
	j2324928337 [label="知道。",shape=box,color=blue];
		j2324928337 -> j3666568552;
	j2413606021 [label="随便吧",shape=box,color=blue];
		j2413606021 -> j1969696095;
	j1969696095 [label="那我应该去找他谈谈？",shape=box,color=blue];
		j1969696095 -> j146402819;
		j1969696095 -> j2176089578;
	j1933471669 [label="因为出于某种原因，Nova 所能做的就是向她认识的唯一的时间旅行者询问时间旅行的事。",shape=box,color=red];
		j1933471669 -> j2556501709;
	j1370749021 [label="因为你真的不会放弃？我并不是希望你放弃，而是我真的不知道该如何帮助你。",shape=box,color=red];
		j1370749021 -> j3436545458;
	j3666568552 [label="我大学的院长就是这种人。如果我再见到他的话……",shape=box,color=blue];
		j3666568552 -> j2743440910;
	j146402819 [label="如果你想一辈子成为科学试验品，那当然可以。",shape=box,color=red];
		j146402819 -> j57513547;
	j2176089578 [label="我认为让你接触他并不是个好主意，即使这是有可能的。",shape=box,color=red];
		j2176089578 -> j337156349;
	j2556501709 [label="+5 Chemistry",color=orange];
		j2556501709 -> j2852528624;
	j3436545458 [label="Protea、说些具体的。比如说，有没有一个像我这样的她？你知道的，像是个半成品怪胎？",shape=box,color=blue];
		j3436545458 -> j1436933372;
		j3436545458 -> j2987825849;
	j2743440910 [label="我曾以为他会站在我这边，但…… ",shape=box,color=blue];
		j2743440910 -> j1384111031;
		j2743440910 -> j2108752223;
	j57513547 [label="还可能被卖给出价最高的人。",shape=box,color=red];
		j57513547 -> j2793285996;
	j337156349 [label="我们还是专注于那些能在这里帮到你的事情吧。",shape=box,color=red];
		j337156349 -> j682795310;
	j2852528624 [label="没错。",shape=box,color=blue];
		j2852528624 -> j4103760757;
	j1436933372 [label="不过，正是这个半成品怪胎将要解决时间旅行的问题。要对自己有些信心。",shape=box,color=red];
		j1436933372 -> j3322959889;
	j2987825849 [label="我们所知道的只有战甲 Protea。",shape=box,color=red];
		j2987825849 -> j1830799486;
	j1384111031 [label="你在大学到底发生了什么事？",shape=box,color=red];
		j1384111031 -> j4194380302;
	j2108752223 [label="在什么事情上站在你这边？",shape=box,color=red];
		j2108752223 -> j4194380302;
	j2793285996 [label="他是个聪明人，但不是个好人。我不认为他会成为盟友。",shape=box,color=red];
		j2793285996 -> j1955280983;
	j682795310 [label="比如时间……方面的事。",shape=box,color=red];
		j682795310 -> j1933471669;
	j4103760757 [label="我真高兴你能理解。",shape=box,color=blue];
		j4103760757 -> j1740962367;
		j4103760757 -> j3275640169;
	j3322959889 [label="+5 Chemistry",color=orange];
		j3322959889 -> j3451124434;
	j1830799486 [label="真为她感到难过。",shape=box,color=blue];
		j1830799486 -> j3665245661;
	j4194380302 [label="呃，我们就当作是‘Nova 对抗互联网’好了。",shape=box,color=blue];
		j4194380302 -> j3405742904;
	j1955280983 [label="让我想想。",shape=box,color=blue];
		j1955280983 -> j3016925107;
	j1740962367 [label="如果我想问关于 1999 的问题呢？",shape=box,color=red];
		j1740962367 -> j2481395981;
	j3275640169 [label="我以后能问你别的事情吗？",shape=box,color=red];
		j3275640169 -> j2481395981;
	j3451124434 [label="你说得对。",shape=box,color=blue];
		j3451124434 -> j3665245661;
	j3665245661 [label="不过呢",shape=box,color=blue];
		j3665245661 -> j2481395981;
	j3405742904 [label="笨笨的 Nova。",shape=box,color=blue];
		j3405742904 -> j3619937083;
	j3016925107 [label="嗯。好吧，让我们假设 Protea 在所有这些造物中，对时间的掌握是最先进的",shape=box,color=blue];
		j3016925107 -> j239721537;
	j2481395981 [label="事情是这样的，接下来我会告诉你具体该怎么做。",shape=box,color=blue];
		j2481395981 -> j762713678;
	j3619937083 [label="如果老师不让你上课，成绩又有什么意义呢。",shape=box,color=blue];
		j3619937083 -> j3093873651;
		j3619937083 -> j4266544347;
	j239721537 [label="这种掌握是基于理论、科学、天赋，还是……嗯。 ",shape=box,color=blue];
		j239721537 -> j1933454000;
	j762713678 [label="我会进行时间旅行，就像你曾经做的那样。",shape=box,color=blue];
		j762713678 -> j2668348031;
	j3093873651 [label="现在的世道已经不同了。",shape=box,color=red];
		j3093873651 -> j2591681057;
	j4266544347 [label="如果你哪天想聊聊这件事……",shape=box,color=red];
		j4266544347 -> j2591681057;
	j1933454000 [label="或者，嗯。实际上。对，就理解成虚空和它有关吧。",shape=box,color=blue];
		j1933454000 -> j703010658;
		j1933454000 -> j3200632526;
	j2668348031 [label="我会去你来自的地方。",shape=box,color=blue];
		j2668348031 -> j2230659998;
	j2591681057 [label="我知道，我知道……",shape=box,color=blue];
		j2591681057 -> j3787897896;
	j703010658 [label="虚空不是那种你能简单‘解决’的东西。",shape=box,color=red];
		j703010658 -> j3252923051;
	j3200632526 [label="虚空和……全部一切都有关。",shape=box,color=red];
		j3200632526 -> j3497777646;
	j2230659998 [label="然后我就会知道你有没有骗过我，或者我是否真的可以信任你，我会知道未来发生了什么。",shape=box,color=blue];
		j2230659998 -> j1723548634;
	j3787897896 [label="我这么说吧，一旦我搞清楚了这个“时间旅行”的事，我会告诉你更多。那时候我也没什么好失去的了。",shape=box,color=blue];
		j3787897896 -> j2189522063;
	j3252923051 [label="但它可能是我能利用的东西！哈！是时候做个实验了。 ",shape=box,color=blue];
		j3252923051 -> j1486117650;
	j3497777646 [label="对我而言，开启另一项实验可能才意味着全部一切。再见啦！ ",shape=box,color=blue];
		j3497777646 -> j1486117650;
	j1723548634 [label="所以，我得回去看书了！还有一些关于 Protea 的事情……嗯。",shape=box,color=blue];
		j1723548634 -> j2189522063;
	j1486117650 [label="等等，注意安全！",shape=box,color=red];
		j1486117650 -> j4088838641;
	j4088838641 [label="Boolean KayaVoidTest is now true.",color=orange];
		j4088838641 -> j2189522063;
}