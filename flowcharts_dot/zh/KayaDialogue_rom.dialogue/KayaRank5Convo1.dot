digraph {
	"KayaRank5Convo1 begins." [color=orange];
		"KayaRank5Convo1 begins." -> j2666858327;
	j2666858327 [label="我一直看到这些紫色的东西，但它们第二天就凭空消失了。",shape=box,color=blue];
		j2666858327 -> j1682368892;
	j1682368892 [label="我觉得它们的衰变得有些原因。",shape=box,color=blue];
		j1682368892 -> j582236351;
	j582236351 [label="因为那些物质不是在转化为新同位素的衰变态。",shape=box,color=blue];
		j582236351 -> j2964099844;
	j2964099844 [label="它们直接从这儿凭空消失了。",shape=box,color=blue];
		j2964099844 -> j2695058377;
		j2964099844 -> j4212048;
	j2695058377 [label="你是说永冻晶矿吗？",shape=box,color=red];
		j2695058377 -> j2741600931;
	j4212048 [label="你是说氩结晶吗？ ",shape=box,color=red];
		j4212048 -> j1333492479;
	j2741600931 [label="嗯嗯不，不是。",shape=box,color=blue];
		j2741600931 -> j4212048;
		j2741600931 -> j1539897245;
	j1333492479 [label="一定就是它了！",shape=box,color=blue];
		j1333492479 -> j3346673603;
	j1539897245 [label="你是说奥罗金电池？",shape=box,color=red];
		j1539897245 -> j2541931121;
	j3346673603 [label="在你来的地方，有办法保存它们吗？",shape=box,color=blue];
		j3346673603 -> j3344936640;
		j3346673603 -> j4055574860;
	j2541931121 [label="嗯不是，肯定也不是那个。",shape=box,color=blue];
		j2541931121 -> j2997777560;
		j2541931121 -> j3434581235;
	j3344936640 [label="它们一旦从虚空中带出来就消失了。",shape=box,color=red];
		j3344936640 -> j349650698;
	j4055574860 [label="没有办法，我一直都以为它们只是衰变了。 ",shape=box,color=red];
		j4055574860 -> j349650698;
	j2997777560 [label="你是说红化结晶吗？",shape=box,color=red];
		j2997777560 -> j1941768587;
	j3434581235 [label="你是说氩结晶吗？",shape=box,color=red];
		j3434581235 -> j1333492479;
	j349650698 [label="噢那就对了——在虚空中它们是惰性的。",shape=box,color=blue];
		j349650698 -> j2609188720;
	j1941768587 [label="我觉得不是，如果我们想不出来，我可能永远也解不开这个问题了。",shape=box,color=blue];
		j1941768587 -> j1137247960;
		j1941768587 -> j3434581235;
	j2609188720 [label="而一旦当它们离开虚空，它们就必须返回虚空。它们并不会衰变成新物质。",shape=box,color=blue];
		j2609188720 -> j1486832418;
	j1137247960 [label="你是说纳米孢子吗？",shape=box,color=red];
		j1137247960 -> j2492575547;
	j1486832418 [label="它们相位回归虚空。虚空无处不在，召唤它们回去。",shape=box,color=blue];
		j1486832418 -> j221969447;
	j2492575547 [label="呃呃不，我的最后一个样本也不见了。我……唉。我得走了。",shape=box,color=blue];
		j2492575547 -> j30035150;
	j221969447 [label="Boolean KayaFutureWin2 is now true.",color=orange];
		j221969447 -> j3033082020;
		j221969447 -> j3577744819;
	j30035150 [label="我可能做不到了。",shape=box,color=blue];
		j30035150 -> j4123196853;
	j3033082020 [label="这能让你离开 1999 年吗？打算躲进虚空？这我并不推荐。",shape=box,color=red];
		j3033082020 -> j3036426053;
	j3577744819 [label="这对你的目标重要吗？",shape=box,color=red];
		j3577744819 -> j3423440109;
	j4123196853 [label="+20 Chemistry",color=orange];
		j4123196853 -> "Chat ends. Next chat will be KayaRank5Convo2.";
	j3036426053 [label="这更多是在说物质状态，以及虚空不是“线性”的理论，所以我可以把虚空当作蹦床跟着你回去。",shape=box,color=blue];
		j3036426053 -> j3558840236;
	j3423440109 [label="非常非常非常！这意味着物质在虚空和这个地方之间存在连接。原子，物质，它们在两个地点都具有一致性。 ",shape=box,color=blue];
		j3423440109 -> j543168558;
	"Chat ends. Next chat will be KayaRank5Convo2." [color=orange];
	j3558840236 [label="等等，跟着我？ ",shape=box,color=red];
		j3558840236 -> j1671474633;
	j543168558 [label="在我们的理解中，虚空并不是”线性“的，所以我可以把虚空当作蹦床跟着你回去。",shape=box,color=blue];
		j543168558 -> j3558840236;
	j1671474633 [label="是的，无论我测试或运算多少次方程式，我总是缺少一个“灯塔”。蹦床跳需要有个落点，如果你曾经回去过一次，那就足够进行校准了。 ",shape=box,color=blue];
		j1671474633 -> j4193552431;
		j1671474633 -> j403097479;
	j4193552431 [label="我希望你会后空翻！一座灯塔马上就来。 ",shape=box,color=red];
		j4193552431 -> j803305697;
	j403097479 [label="哇哦，我不知道这样做我能不能接受。要是你卡住或者迷路了怎么办？！ ",shape=box,color=red];
		j403097479 -> j825406423;
	j803305697 [label="我当然还没完全准备好。只有一次机会，三思而后行。1000 次思而后行…… ",shape=box,color=blue];
		j803305697 -> j2192440905;
		j803305697 -> j2160938385;
	j825406423 [label="我不会的。 ",shape=box,color=blue];
		j825406423 -> j2680188973;
	j2192440905 [label="有道理，科学最好在有充分信心的前提下进行。",shape=box,color=red];
		j2192440905 -> j710883976;
	j2160938385 [label="试试吧！没时间考虑了，现在就出发！ ",shape=box,color=red];
		j2160938385 -> j920725755;
	j2680188973 [label="你有可能呢。",shape=box,color=red];
		j2680188973 -> j695096363;
	j710883976 [label="看我把你教的多好。",shape=box,color=blue];
		j710883976 -> j3522715130;
		j710883976 -> j2766048621;
	j920725755 [label="啊不不不，我还没准备好！你别催我！",shape=box,color=blue];
		j920725755 -> j3476963860;
	j695096363 [label="没有。",shape=box,color=blue];
		j695096363 -> j1753673082;
		j695096363 -> j1031757008;
	j3522715130 [label="别做梦了！ ",shape=box,color=red];
		j3522715130 -> j4123196853;
	j2766048621 [label="好吧，你是个好老师。虽然我只见过你教米尼娃玩新的喝酒游戏。",shape=box,color=red];
		j2766048621 -> j2160774105;
	j3476963860 [label="好吧，看来你还是意识到这可能有多危险。好样的。",shape=box,color=red];
		j3476963860 -> j4094817270;
	j1753673082 [label="唉……",shape=box,color=red];
		j1753673082 -> j3595284985;
	j1031757008 [label="但……你还是有可能吧。",shape=box,color=red];
		j1031757008 -> j3595284985;
	j2160774105 [label="米尼娃宿醉时比时光旅行更危险。快跑！",shape=box,color=blue];
		j2160774105 -> j4123196853;
	j4094817270 [label="不过米尼娃宿醉时更危险。快跑！",shape=box,color=blue];
		j4094817270 -> j4123196853;
	j3595284985 [label="你来找我。",shape=box,color=blue];
		j3595284985 -> j2409947401;
	j2409947401 [label="别把责任推到我头上啊……",shape=box,color=red];
		j2409947401 -> j2556081268;
	j2556081268 [label="不许反悔！",shape=box,color=blue];
		j2556081268 -> j4123196853;
}