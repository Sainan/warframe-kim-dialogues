		j2195002343 -> j951303311;
	j951303311 [label="你知道我为什么要离开吗？",shape=box,color=blue];
		j951303311 -> j3475728923;
	j3475728923 [label="就好像，任何人都没有经历过发生在我身上的事。",shape=box,color=blue];
		j3475728923 -> j3948008545;
	j3948008545 [label="这张照片上了头条。人们嘲讽我明明是自己要发那张照片却假装自己是受害者。",shape=box,color=blue];
		j3948008545 -> j1791338357;
	j1791338357 [label="甚至如果有人在学生数据库中查找我的名字，就会联想到那个老师的放荡马屁精。",shape=box,color=blue];
		j1791338357 -> j3390784500;
	j3390784500 [label="你们要是发现那张照片也会用异样的眼光看待我。仿佛所有的尊重……都永远消失。",shape=box,color=blue];
		j3390784500 -> j255554673;
	j255554673 [label="我必须离开，我必须向前走，走到一个我足够聪明可以把这一切都抛在脑后的时间和地方。",shape=box,color=blue];
		j255554673 -> j2795958812;
		j255554673 -> j236773314;
		j255554673 -> j2735295955;
	j2795958812 [label="我没什么好说的了。我们都做过后悔的事。 ",shape=box,color=red];
		j2795958812 -> j373575447;
	j236773314 [label="说实话，我现在更佩服你了。",shape=box,color=red];
		j236773314 -> j1957155674;
	j2735295955 [label="我们任何人都不会因此对你评头论足。",shape=box,color=red];
		j2735295955 -> j3051414897;
