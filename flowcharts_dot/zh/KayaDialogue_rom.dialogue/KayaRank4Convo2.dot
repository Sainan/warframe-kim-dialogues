		j3051414897 -> j2072611246 [label=false,color=brown];
	j2189173735 [label="也许我会的。毕竟我们还有很多时间。",shape=box,color=red];
		j2189173735 -> j636956295;
	j2513125416 [label="这是个承诺。在这个世界上你并不孤单。我们都只不过把赌注放在了别人身上。",shape=box,color=red];
		j2513125416 -> j3706483799;
