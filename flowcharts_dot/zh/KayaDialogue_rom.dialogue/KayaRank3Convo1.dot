		433 -> 434;
	434 [label="但像我这样的女生，打死也不能在学校被人发现收到这些东西。不过那个害羞的家伙显然看穿了我的真实喜好，并且偷偷把真正的礼物塞给我。还故意用大蛋糕打掩护来吸引我的注意力，谁知道呢。",shape=box,color=blue];
