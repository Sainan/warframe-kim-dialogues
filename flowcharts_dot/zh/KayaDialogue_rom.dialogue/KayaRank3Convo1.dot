	edge [fontname="Roboto Condensed"];

	"KayaRank3Convo1 begins." [color=orange];
		"KayaRank3Convo1 begins." -> j3076092425;
	j3076092425 [label="我刚刚意识到你让我想起了谁。 ",shape=box,color=blue];
		j3076092425 -> j746370966;
	j746370966 [label="大学一年级时和我搭档的一个同学。",shape=box,color=blue];
		j746370966 -> j2561229719;
	j2561229719 [label="Check boolean KayaCake",color=orange];
		j2561229719 -> j3244024433 [label=true,color=green];
		j2561229719 -> j2786588650 [label=false,color=brown];
		j2561229719 -> j2071906039 [label=false,color=brown];
	j3244024433 [label="呃噢。是好的方面吗？",shape=box,color=red];
		j3244024433 -> j1611549448;
	j2786588650 [label="我猜是位极具魅力且才华横溢的学生？",shape=box,color=red];
		j2786588650 -> j4236610145;
	j2071906039 [label="让我做下心理准备，免得引起争执……",shape=box,color=red];
		j2071906039 -> j3686452574;
	j1611549448 [label="是的，确实如此。 ",shape=box,color=blue];
		j1611549448 -> j4046082171;
	j4236610145 [label="呃，我不想打击你，但我不会调情。绝对不会。",shape=box,color=blue];
		j4236610145 -> j655885179;
	j3686452574 [label="天呐，拜托，别这样。这是一段快乐的回忆。",shape=box,color=blue];
		j3686452574 -> j1041988507;
		j3686452574 -> j500863839;
	j4046082171 [label="我去烤蛋糕就是想证明你错了。",shape=box,color=blue];
		j4046082171 -> j244794427;
	j655885179 [label="特别是在网上。",shape=box,color=blue];
		j655885179 -> j2300700607;
		j655885179 -> j2833130866;
	j1041988507 [label="既然你这么说。",shape=box,color=red];
		j1041988507 -> j1080815491;
	j500863839 [label="你好像没有很多这样的回忆。",shape=box,color=red];
		j500863839 -> j3099854954;
	j244794427 [label="然后这让我想起了唯一一个为我烤过蛋糕的人，就是这位害羞的同学。",shape=box,color=blue];
		j244794427 -> j4222739883;
	j2300700607 [label="但如果我想呢？",shape=box,color=red];
		j2300700607 -> j2166049788;
	j2833130866 [label="哇，我的错，我的错。 ",shape=box,color=red];
		j2833130866 -> j827556854;
	j1080815491 [label="其实这是关于我的生日，但不是关于我。 ",shape=box,color=blue];
		j1080815491 -> j965617305;
	j3099854954 [label="那就让我来分享一个吧！ ",shape=box,color=blue];
		j3099854954 -> j1080815491;
	j4222739883 [label="虽然我几乎没和他们来往过，但他们还是知道了我的生日。",shape=box,color=blue];
		j4222739883 -> j4014853292;
	j2166049788 [label="那绝不可能是我。",shape=box,color=blue];
		j2166049788 -> j2013445877;
	j827556854 [label="不要有下次了。",shape=box,color=blue];
		j827556854 -> j694783558;
	j965617305 [label="好吧，我想还是有点跟我有关。我应该说，呃，我绝对是那种每个人都想和我在一起的人。",shape=box,color=blue];
		j965617305 -> j506328630;
	j4014853292 [label="他们给我带来了撒有香草糖霜的香草蛋糕，我发誓，那蛋糕有三层那么高。",shape=box,color=blue];
		j4014853292 -> j1717634997;
	j2013445877 [label="+5 Chemistry",color=orange];
		j2013445877 -> "Chat ends. Next chat will be KayaRank3Convo2.";
	j694783558 [label="我保证没有下次了。",shape=box,color=red];
		j694783558 -> j3348184314;
	j506328630 [label="成绩很好，甚至可以说是优秀。还是啦啦队的队长。受邀参加我的生日派对是很有面子的事。",shape=box,color=blue];
		j506328630 -> j3967339417;
	j1717634997 [label="总之，我看到他们拿着蛋糕。当时我还特别担心全班同学会看到他们给我送蛋糕。因为我们压根就不是一个圈子的。",shape=box,color=blue];
		j1717634997 -> j2686152535;
	"Chat ends. Next chat will be KayaRank3Convo2." [color=orange];
	j3348184314 [label="Boolean KayaFlirtPromise is now true.",color=orange];
		j3348184314 -> j3842909310;
	j3967339417 [label="总之，这个学生给我烤了一个生日蛋糕，但告诉我不要和任何人分享，等我回家再吃。 ",shape=box,color=blue];
		j3967339417 -> j3360462632;
	j2686152535 [label="我成绩很好，甚至可以说是优秀。还是啦啦队的队长。受邀参加我的生日派对是很有面子的事。",shape=box,color=blue];
		j2686152535 -> j3967339417;
	j3842909310 [label="好吧。",shape=box,color=blue];
		j3842909310 -> j3967339417;
	j3360462632 [label="老实说，这让我觉得怪怪的，就像你一开始给我的感觉一样。但我把它切开时，我的菜刀碰到了某个坚硬的东西。",shape=box,color=blue];
		j3360462632 -> j3877066245;
	j3877066245 [label="听起来很恶心吧？简直恶心爆了。但等我仔细一看，蛋糕底下居然藏了个塑料盒，里面塞满了密封的吉尼梦卡牌包。那是我最喜欢的东西了。",shape=box,color=blue];
		j3877066245 -> j437582963;
	j437582963 [label="但像我这样的女生，打死也不能在学校被人发现收到这些东西。不过那个害羞的家伙显然看穿了我的真实喜好，并且偷偷把真正的礼物塞给我。还故意用大蛋糕打掩护来吸引我的注意力，谁知道呢。",shape=box,color=blue];
		j437582963 -> j2475985909;
		j437582963 -> j253553152;
		j437582963 -> j1532452424;
	j2475985909 [label="我是不会给你烤蛋糕的。",shape=box,color=red];
		j2475985909 -> j2724958725;
	j253553152 [label="对于一个被认为是天才儿童的人来说，你真的花了很长时间才说明白重点……",shape=box,color=red];
		j253553152 -> j1720041477;
	j1532452424 [label="这是怎么让你想起我的？",shape=box,color=red];
		j1532452424 -> j1160470551;
	j2724958725 [label="+20 Chemistry",color=orange];
		j2724958725 -> j3517537172;
	j1720041477 [label="作为来自那个伟大又鼓舞人心的未来的人，你绝对错过了重点。吉尼梦卡！我哎！你能相信吗？",shape=box,color=blue];
		j1720041477 -> j1145751271;
		j1720041477 -> j2369901797;
	j1160470551 [label="我想用我自己的方式告诉你，我相信你，所以告诉你我收集吉尼梦卡牌。这种卡只有废柴才玩。",shape=box,color=blue];
		j1160470551 -> j2036341813;
	j3517537172 [label="哈哈哈！",shape=box,color=blue];
		j3517537172 -> j1387883970;
	j1145751271 [label="我根本不知道那是个什么东西！",shape=box,color=red];
		j1145751271 -> j1246526922;
	j2369901797 [label="它们像是特别的收藏品吗？",shape=box,color=red];
		j2369901797 -> j1246526922;
	j2036341813 [label="至少我是这么认为的。但真正的废柴是其他人。 ",shape=box,color=blue];
		j2036341813 -> j1301595421;
		j2036341813 -> j2938472228;
		j2036341813 -> j2007493724;
	j1387883970 [label="反正你烤出来也会很恶心的。",shape=box,color=blue];
		j1387883970 -> j3962738955;
		j1387883970 -> j2927012974;
	j1246526922 [label="它们就像小孩玩的怪兽卡牌游戏，完全是为废柴准备的，尤其是在大学里。",shape=box,color=blue];
		j1246526922 -> j2036341813;
	j1301595421 [label="也许有一天你会让我看看你的吉尼梦卡牌？",shape=box,color=red];
		j1301595421 -> j4078847919;
	j2938472228 [label="哇！我们居然完整聊完了一次天，而且没有只扯时间旅行！",shape=box,color=red];
		j2938472228 -> j714339047;
	j2007493724 [label="你这是在向我敞开心扉吗？真新鲜啊！",shape=box,color=red];
		j2007493724 -> j2685778755;
	j3962738955 [label="你大概是对的。",shape=box,color=red];
		j3962738955 -> j1094355024;
	j2927012974 [label="我是能搞定的。",shape=box,color=red];
		j2927012974 -> j1094355024;
	j4078847919 [label="也许吧。",shape=box,color=blue];
		j4078847919 -> j1895387827;
	j714339047 [label="嗒哒！",shape=box,color=blue];
		j714339047 -> j1895387827;
	j2685778755 [label="可别习惯这样啊。也许吧。算了，我也不知道。 ",shape=box,color=blue];
		j2685778755 -> j1895387827;
	j1094355024 [label="耶！耶！ ",shape=box,color=blue];
		j1094355024 -> j1438450326;
	j1895387827 [label="+20 Chemistry",color=orange];
		j1895387827 -> "Chat ends. Next chat will be KayaRank3Convo2.";
	j1438450326 [label="我想用我自己的方式告诉你，我相信你，所以告诉你我收集吉尼梦卡牌。这种卡只有废柴才玩。",shape=box,color=blue];
		j1438450326 -> j3223939090;
	j3223939090 [label="至少我是这么认为的。但真正的废柴是其他人。 ",shape=box,color=blue];
		j3223939090 -> j2007493724;
		j3223939090 -> j2938472228;
		j3223939090 -> j1301595421;
