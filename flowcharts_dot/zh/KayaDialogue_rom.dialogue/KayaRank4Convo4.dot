digraph {
	"KayaRank4Convo4 begins." [color=orange];
		"KayaRank4Convo4 begins." -> j78067521;
	j78067521 [label="我想我可以帮得上忙。",shape=box,color=red];
		j78067521 -> j3054357049;
	j3054357049 [label="我知道一个地方，其实我该说我是从那里来的。双衍王境。",shape=box,color=red];
		j3054357049 -> j1338167365;
	j1338167365 [label="即使我离开了，它依然存在。在虚空中。",shape=box,color=red];
		j1338167365 -> j110515675;
	j110515675 [label="而另一个孩子所在的星系，是我曾经去过的地方。",shape=box,color=red];
		j110515675 -> j3805187466;
	j3805187466 [label="嗯，你的足迹真的是我能够“安全追随”的关键。",shape=box,color=blue];
		j3805187466 -> j3667303409;
	j3667303409 [label="Boolean KayaFutureWin1 is now true.",color=orange];
		j3667303409 -> j3978014925;
	j3978014925 [label="当粒子被吸引到下一个形态时，它就像一个巨大的发光的虚空出口标志。",shape=box,color=blue];
		j3978014925 -> j3999777383;
	j3999777383 [label="不好意思，“双衍王境”是什么？一种物质的状态？ ",shape=box,color=blue];
		j3999777383 -> j3339171254;
		j3999777383 -> j2769210837;
	j3339171254 [label="它是我在虚空创造出的地方。",shape=box,color=red];
		j3339171254 -> j1993802692;
	j2769210837 [label="从很多方面来说，那里才是我真正的家。我……是在那里长大的。",shape=box,color=red];
		j2769210837 -> j645285196;
	j1993802692 [label="一个充满了具象化概念和情感的地方。",shape=box,color=red];
		j1993802692 -> j3066260068;
	j645285196 [label="它在虚空中。",shape=box,color=red];
		j645285196 -> j768618859;
	j3066260068 [label="它基本上就是一本活生生的“教科书”。",shape=box,color=red];
		j3066260068 -> j1045718458;
	j768618859 [label="不过，最近我们那的访客并不多。",shape=box,color=red];
		j768618859 -> j2605667793;
	j1045718458 [label="哈哈！我的天。好吧，我明白了，它真的在虚空中吗？",shape=box,color=blue];
		j1045718458 -> j3650654229;
	j2605667793 [label="我造访的时候请铺好红地毯。",shape=box,color=blue];
		j2605667793 -> j110571661;
		j2605667793 -> j2875421831;
		j2605667793 -> j461745356;
	j3650654229 [label="是的，但它很大程度上要依托于扎里曼号。",shape=box,color=red];
		j3650654229 -> j2043245985;
	j110571661 [label="我不经常回那里……",shape=box,color=red];
		j110571661 -> j1599645833;
	j2875421831 [label="你真的觉得你会去那里吗？",shape=box,color=red];
		j2875421831 -> j176798715;
	j461745356 [label="好嘞，太空旅行者！[结束]",shape=box,color=red];
		j461745356 -> j392027042;
	j2043245985 [label="就像一个巨大的金属月亮。",shape=box,color=red];
		j2043245985 -> j405214771;
	j1599645833 [label="它还在吗？你怎么能确定？",shape=box,color=blue];
		j1599645833 -> j1510871417;
	j176798715 [label="为所有可能的结果做好计划。",shape=box,color=blue];
		j176798715 -> j2245734226;
		j176798715 -> j2123525991;
	j392027042 [label="+20 Chemistry",color=orange];
		j392027042 -> "Chat ends. Next chat will be KayaRank5Convo1.";
	j405214771 [label="有太阳吗？",shape=box,color=blue];
		j405214771 -> j1571476160;
		j405214771 -> j2494257313;
	j1510871417 [label="应该还在吧？我不在的时候如果它消失了我会知道的。",shape=box,color=red];
		j1510871417 -> j1911450811;
	j2245734226 [label="如果你在某个地方、某个时候迷路了怎么办？",shape=box,color=red];
		j2245734226 -> j1754395787;
	j2123525991 [label="我可以畅想一下，但你真的认为你能找到摆脱 1999 年的办法吗？",shape=box,color=red];
		j2123525991 -> j2270158781;
	"Chat ends. Next chat will be KayaRank5Convo1." [color=orange];
	j1571476160 [label="努力想想的话，或许可能有？",shape=box,color=red];
		j1571476160 -> j4288154315;
	j2494257313 [label="我只是在抒情而已，那里没有太阳。",shape=box,color=red];
		j2494257313 -> j239489698;
	j1911450811 [label="你会知道吗？有个科学流派认为对双衍王境的观察是其存在的关键。",shape=box,color=blue];
		j1911450811 -> j179662591;
		j1911450811 -> j2270689666;
	j1754395787 [label="我不知道，如果你再也见不到我，就在我的葬礼上说几句好话吧。",shape=box,color=blue];
		j1754395787 -> j1835383639;
	j2270158781 [label="当然，如果你能帮上忙，请告诉我！ ",shape=box,color=blue];
		j2270158781 -> j392027042;
	j4288154315 [label="哈哈。",shape=box,color=blue];
		j4288154315 -> j4081655077;
	j239489698 [label="有任何天体吗？",shape=box,color=blue];
		j239489698 -> j1183492933;
		j239489698 -> j3586722958;
	j179662591 [label="我不确定科学能否解释这一切。“它”就是这一切的原因。",shape=box,color=red];
		j179662591 -> j1608664470;
	j2270689666 [label="这听起来更像是哲学。",shape=box,color=red];
		j2270689666 -> j1612639075;
	j1835383639 [label="哦，如果我真的死了，告诉亚瑟我觉得他很可爱。 ",shape=box,color=blue];
		j1835383639 -> j1487584150;
	j4081655077 [label="我尽力。",shape=box,color=blue];
		j4081655077 -> j392027042;
	j1183492933 [label="据我所知没有。",shape=box,color=red];
		j1183492933 -> j1354495553;
	j3586722958 [label="没有。",shape=box,color=red];
		j3586722958 -> j1354495553;
	j1608664470 [label="你认为“它”能被解释吗？",shape=box,color=blue];
		j1608664470 -> j2811126901;
		j1608664470 -> j4294556610;
	j1612639075 [label="这不是我的最高分科目，别提醒我了，呃。",shape=box,color=blue];
		j1612639075 -> j1254626373;
	j1487584150 [label="Check boolean ArthurDating",color=orange];
		j1487584150 -> j661174767 [label=true,color=green];
		j1487584150 -> j1220641378 [label=false,color=brown];
		j1487584150 -> j2391711693 [label=false,color=brown];
	j1354495553 [label="已知宇宙中的所有事物都是由它们与天体的关系所定义的。这个虚空真奇怪。",shape=box,color=blue];
		j1354495553 -> j1646227697;
		j1354495553 -> j2123695532;
	j2811126901 [label="我不知道我想不想它被解释出来。",shape=box,color=red];
		j2811126901 -> j1583594226;
	j4294556610 [label="如果“它”可以被解释的话，我们就能解决很多问题。",shape=box,color=red];
		j4294556610 -> j1583594226;
	j1254626373 [label="你对哲学很头疼吗？",shape=box,color=red];
		j1254626373 -> j2691539899;
	j661174767 [label="尽管情况如此……如果真到了那一步，我会的。 ",shape=box,color=red];
		j661174767 -> j1224270061;
	j1220641378 [label="知道了。 ",shape=box,color=red];
		j1220641378 -> j1224270061;
	j2391711693 [label="我希望不会发展到那一步。",shape=box,color=red];
		j2391711693 -> j1476265787;
	j1646227697 [label="这是“虚空”。在事物出现之前，一切都是虚无。",shape=box,color=red];
		j1646227697 -> j211134153;
	j2123695532 [label="等我们找到阿尔布雷希特，我们会把他带回去或什么的，我还没有计划。",shape=box,color=red];
		j2123695532 -> j211134153;
	j1583594226 [label="好吧，站在你的角度考虑的话，我估计解答你的科学谜题会有点意思，希望你能找到答案。",shape=box,color=blue];
		j1583594226 -> j3966229363;
		j1583594226 -> j1312676659;
	j2691539899 [label="我想是吧？也许不完全是对它“头疼”。谁在乎原因和对象，我们只要做些很酷的事情就行了。",shape=box,color=blue];
		j2691539899 -> j207665078;
		j2691539899 -> j300936503;
	j1224270061 [label="谢谢你啊！",shape=box,color=blue];
		j1224270061 -> j392027042;
	j1476265787 [label="呃。",shape=box,color=blue];
		j1476265787 -> j1224270061;
	j211134153 [label="似乎有关联，但不是我的研究重点。回见！",shape=box,color=blue];
		j211134153 -> j392027042;
	j3966229363 [label="Nova，我不确定我会喜欢那些答案。",shape=box,color=red];
		j3966229363 -> j392027042;
	j1312676659 [label="同意，总有一天会的。",shape=box,color=red];
		j1312676659 -> j392027042;
	j207665078 [label="我想是的，但你与他人共同生活在这个星球上，无论我们愿不愿意，我们的选择都会影响他人。",shape=box,color=red];
		j207665078 -> j2447829740;
	j300936503 [label="也许这就是英择谛第一次进入虚空前的想法，现在看看我们。",shape=box,color=red];
		j300936503 -> j2576536772;
	j2447829740 [label="呃。",shape=box,color=blue];
		j2447829740 -> j2924563668;
	j2576536772 [label="呃。",shape=box,color=blue];
		j2576536772 -> j392027042;
	j2924563668 [label="好吧，你说得对。 ",shape=box,color=blue];
		j2924563668 -> j392027042;
}