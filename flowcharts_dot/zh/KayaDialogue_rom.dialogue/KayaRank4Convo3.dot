		655 -> 660;
	656 [label="有一根手指来自……它。在我的时代。也算是在我们的世界吧。",shape=box,color=red];
		656 -> 660;
	657 [label="Chat ends. Next chat will be KayaRank4Convo4.",color=orange];
	658 [label="(但很明显是亚瑟，因为我和他说过话，听起来你真的让他精神错乱了）。",shape=box,color=blue];
		658 -> 661;
	659 [label="这就像是最奇怪的事情。我们变成了怪物，但这是我感到最有人性的时候。",shape=box,color=blue];
