		614 -> 617;
	615 [label="甚至连亚瑟也是。首先声明，我超级迷恋他，我的天啊。",shape=box,color=blue];
		615 -> 618;
	616 [label="没错！当然也有一些注意事项。最可靠、最安全的方法就是完全回到你来自的时代，因为那里有“虚空指纹”。",shape=box,color=blue];
