		629 -> 636;
	630 [label="没错！当然也有一些注意事项。最可靠、最安全的方法就是完全回到你来自的时代，因为那里有“虚空指纹”。",shape=box,color=blue];
		630 -> 619;
		630 -> 620;
		630 -> 621;
	633 [label="哎呀我知道，真幸运啊！话说回来",shape=box,color=blue];
