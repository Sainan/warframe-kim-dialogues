	632 [label="哎呦不要啊，千万不要，我是信任你才跟你说的！话说回来……",shape=box,color=blue];
		632 -> 637;
	631 [label="呃，你疯了吗？一点都不恶心好吗。话说回来！",shape=box,color=blue];
		631 -> 637;
	634 [label="没什么坏处。要么我想明白，要么想不明白。 要么在这里见，要么在那里见。对吧？回头见！",shape=box,color=blue];
		634 -> 638;
	635 [label="+20 Chemistry",color=orange];
		635 -> 639;
	636 [label="所有这一切，英择谛所做的一切。他对虚空的追求，这一切的……本质。",shape=box,color=red];
