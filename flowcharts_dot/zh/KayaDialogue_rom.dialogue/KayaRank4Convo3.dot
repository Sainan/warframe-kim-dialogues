digraph {
	"KayaRank4Convo3 begins." [color=orange];
		"KayaRank4Convo3 begins." -> j3221864725;
	j3221864725 [label="我信任你。",shape=box,color=blue];
		j3221864725 -> j3290574590;
	j3290574590 [label="但这并不意味着我只会待在这里而不留后路。",shape=box,color=blue];
		j3290574590 -> j3048329160;
		j3290574590 -> j3032798845;
		j3290574590 -> j4057057601;
	j3048329160 [label="我很高兴我们现在能够互相信任。[结束]",shape=box,color=red];
		j3048329160 -> j465934596;
	j3032798845 [label="你离你的“后路”还有多远？",shape=box,color=red];
		j3032798845 -> j228247901;
	j4057057601 [label="什么让你信服了？",shape=box,color=red];
		j4057057601 -> j1130866190;
	j465934596 [label="+20 Chemistry",color=orange];
		j465934596 -> "Chat ends. Next chat will be KayaRank4Convo4.";
	j228247901 [label="呃，明天再问我好吗？",shape=box,color=blue];
		j228247901 -> j87782242;
	j1130866190 [label="我知道我们早已不是高中生了。 ",shape=box,color=blue];
		j1130866190 -> j2820380177;
	"Chat ends. Next chat will be KayaRank4Convo4." [color=orange];
	j87782242 [label="离得真的很接近了，就差一个导火索了。",shape=box,color=blue];
		j87782242 -> j872277029;
		j87782242 -> j1182853031;
	j2820380177 [label="但即使不是天才儿童也能看出你真的关心我们。我们也都很尊重你。",shape=box,color=blue];
		j2820380177 -> j3603340906;
	j872277029 [label="你快要逃离 1999 年了吗？",shape=box,color=red];
		j872277029 -> j2622716430;
	j1182853031 [label="目前的导火索是什么？",shape=box,color=red];
		j1182853031 -> j2857144417;
	j3603340906 [label="甚至连亚瑟也是。首先声明，我超级迷恋他，我的天啊。",shape=box,color=blue];
		j3603340906 -> j1211137507;
	j2622716430 [label="没错！当然也有一些注意事项。最可靠、最安全的方法就是完全回到你来自的时代，因为那里有“虚空指纹”。",shape=box,color=blue];
		j2622716430 -> j3668321789;
		j2622716430 -> j3739132371;
		j2622716430 -> j1630184319;
	j2857144417 [label="当然是你啊。",shape=box,color=blue];
		j2857144417 -> j1044087336;
		j2857144417 -> j1178609832;
	j1211137507 [label="Check boolean ArthurDating",color=orange];
		j1211137507 -> j3245427800 [label=true,color=green];
		j1211137507 -> j1164139245 [label=false,color=brown];
		j1211137507 -> j1000470889 [label=false,color=brown];
	j3668321789 [label="那么，你仍然很确定这一点吗？",shape=box,color=red];
		j3668321789 -> j2510079023;
	j3739132371 [label="我的时代也没好到哪里去，但至少我可以帮得上忙。",shape=box,color=red];
		j3739132371 -> j3065248988;
	j1630184319 [label="嗯，虚空确实对手指还挺重视的。",shape=box,color=red];
		j1630184319 -> j3561717590;
	j1044087336 [label="我一定很特别。",shape=box,color=red];
		j1044087336 -> j2622716430;
	j1178609832 [label="我？",shape=box,color=red];
		j1178609832 -> j2622716430;
	j3245427800 [label="你知道他已经名花有主了，对吧？",shape=box,color=red];
		j3245427800 -> j4117809243;
	j1164139245 [label="我会替你美言几句的。",shape=box,color=red];
		j1164139245 -> j2743507936;
	j1000470889 [label="好恶心。",shape=box,color=red];
		j1000470889 -> j1298278772;
	j2510079023 [label="当然。这是个挑战。该发生的总会发生，对吧？就像，这让我忙碌，专注…… ",shape=box,color=blue];
		j2510079023 -> j901447771;
	j3065248988 [label="没错！破釜沉舟！不要回头！",shape=box,color=blue];
		j3065248988 -> j465934596;
	j3561717590 [label="啊？",shape=box,color=blue];
		j3561717590 -> j2187844656;
	j4117809243 [label="哎呀我知道，真幸运啊！话说回来",shape=box,color=blue];
		j4117809243 -> j2097774870;
	j2743507936 [label="哎呦不要啊，千万不要，我是信任你才跟你说的！话说回来……",shape=box,color=blue];
		j2743507936 -> j2097774870;
	j1298278772 [label="呃，你疯了吗？一点都不恶心好吗。话说回来！",shape=box,color=blue];
		j1298278772 -> j2097774870;
	j901447771 [label="没什么坏处。要么我想明白，要么想不明白。 要么在这里见，要么在那里见。对吧？回头见！",shape=box,color=blue];
		j901447771 -> j465934596;
	j2187844656 [label="所有这一切，英择谛所做的一切。他对虚空的追求，这一切的……本质。",shape=box,color=red];
		j2187844656 -> j4070819971;
	j2097774870 [label="其实在某种程度上，就像在高中，每个人都喜欢你。",shape=box,color=blue];
		j2097774870 -> j3571556038;
	j4070819971 [label="归结为一根手指。就是一根手指。",shape=box,color=red];
		j4070819971 -> j1564193538;
	j3571556038 [label="这说明了一些更深层次的东西，而不仅仅是受欢迎程度。",shape=box,color=blue];
		j3571556038 -> j3125083110;
	j1564193538 [label="你是不是喝了亚瑟的啤酒？你为什么不早点说呢？",shape=box,color=blue];
		j1564193538 -> j2517092014;
		j1564193538 -> j3794390194;
		j1564193538 -> j4091174071;
	j3125083110 [label="我们每个人或多或少都有点精神错乱。 ",shape=box,color=blue];
		j3125083110 -> j2241401513;
		j3125083110 -> j1301225202;
		j3125083110 -> j2443264551;
	j2517092014 [label="虚空。教科书上可不教这块知识。",shape=box,color=red];
		j2517092014 -> j1658826733;
	j3794390194 [label="喝点啤酒也许能理清思路。",shape=box,color=red];
		j3794390194 -> j1658826733;
	j4091174071 [label="这可不是“早点说”的事情。它是终点，也是起点。",shape=box,color=red];
		j4091174071 -> j1658826733;
	j2241401513 [label="又错乱又忙碌！欢迎加入团队。[结束]",shape=box,color=red];
		j2241401513 -> j465934596;
	j1301225202 [label="你觉得谁最错乱？",shape=box,color=red];
		j1301225202 -> j1198755246;
	j2443264551 [label="这是在夸我吗？",shape=box,color=red];
		j2443264551 -> j2954450722;
	j1658826733 [label="但你说的一根手指是什么意思？",shape=box,color=blue];
		j1658826733 -> j908755634;
		j1658826733 -> j2220825460;
	j1198755246 [label="天哪……聊点八卦吗？在我刚说完那些之后？ ",shape=box,color=blue];
		j1198755246 -> j3664668220;
	j2954450722 [label="完全是。百分之百。因为这里没有人在竞争。",shape=box,color=blue];
		j2954450722 -> j1517123235;
	j908755634 [label="阿尔布雷希特有它的手指。",shape=box,color=red];
		j908755634 -> j3912441150;
	j2220825460 [label="有一根手指来自……它。在我的时代。也算是在我们的世界吧。",shape=box,color=red];
		j2220825460 -> j3912441150;
	j3664668220 [label="(但很明显是亚瑟，因为我和他说过话，听起来你真的让他精神错乱了）。",shape=box,color=blue];
		j3664668220 -> j1441164655;
	j1517123235 [label="这就像是最奇怪的事情。我们变成了怪物，但这是我感到最有人性的时候。",shape=box,color=blue];
		j1517123235 -> j269888512;
	j3912441150 [label="明白了，所以物质是保留的，谢谢！",shape=box,color=blue];
		j3912441150 -> j2350767109;
	j1441164655 [label="顺便说一句，这证实了我对你与 1999 年的肉体联系的假设。",shape=box,color=blue];
		j1441164655 -> j758551122;
	j269888512 [label="其实我现在可以做我自己了。",shape=box,color=blue];
		j269888512 -> j2224272800;
	j2350767109 [label="就这？",shape=box,color=red];
		j2350767109 -> j2031198680;
	j758551122 [label="这是具有关联性的，因为……啊！测试完成。回头再说。",shape=box,color=blue];
		j758551122 -> j465934596;
	j2224272800 [label="我不再害怕了。",shape=box,color=blue];
		j2224272800 -> j2114909679;
	j2031198680 [label="你不想问“它是什么”？或为什么它会有一根手指？",shape=box,color=red];
		j2031198680 -> j1174042533;
	j2114909679 [label="所以，谢谢你？",shape=box,color=blue];
		j2114909679 -> j465934596;
	j1174042533 [label="你可以处理这个问题。研究物质保存的状态显然更有趣。谢谢！",shape=box,color=blue];
		j1174042533 -> j465934596;
}