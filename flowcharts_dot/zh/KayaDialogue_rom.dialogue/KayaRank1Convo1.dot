digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j64632745;
	j64632745 [label="嗨。是每个人都能时光旅行，还是只有你可以？",shape=box,color=blue];
		j64632745 -> j3993946596;
		j64632745 -> j1110745240;
	j3993946596 [label="你好啊，听着，孩子，事情没那么简单。 ",shape=box,color=red];
		j3993946596 -> j1991335243;
	j1110745240 [label="你好？卡娅？你今天过得怎么样？",shape=box,color=red];
		j1110745240 -> j2240829874;
	j1991335243 [label="我不是孩子。我19岁了。",shape=box,color=blue];
		j1991335243 -> j1966583536;
		j1991335243 -> j3418070464;
	j2240829874 [label="还行。 ",shape=box,color=blue];
		j2240829874 -> j1237226515;
	j1966583536 [label="嗯。不过你还是这批新人中最小的，孩子，。",shape=box,color=red];
		j1966583536 -> j3348763030;
	j3418070464 [label="好好，不过别急着了解时间旅行。这事……很复杂。",shape=box,color=red];
		j3418070464 -> j1906699099;
	j1237226515 [label="那么，就只有你吗？还有其他人吗？未来的学校里会教时光旅行吗？",shape=box,color=blue];
		j1237226515 -> j4010642169;
	j3348763030 [label="呃。最小是没错，但显然也是最积极想要找到答案的那个。跟上节奏吧。那么：时间旅行。怎样做？谁能做？",shape=box,color=blue];
		j3348763030 -> j1662241357;
	j1906699099 [label="呃。有多复杂？需要公式？化学和原子元素？我会弄清楚的，只要给我指个方向就行。",shape=box,color=blue];
		j1906699099 -> j3178761826;
		j1906699099 -> j2830232142;
	j4010642169 [label="就当只有我一个人好了。这样简单些。",shape=box,color=red];
		j4010642169 -> j1361482495;
	j1662241357 [label="为什么是你？你有计划吗？ ",shape=box,color=blue];
		j1662241357 -> j1553728972;
	j3178761826 [label="我真的不知道该怎么告诉你。这不仅仅是科学领域的事，或者就算是科学，那也是只有英择谛知道的科学。",shape=box,color=red];
		j3178761826 -> j3927371263;
	j2830232142 [label="给你个方向：停下来。[结束]",shape=box,color=red];
		j2830232142 -> j2547432773;
	j1361482495 [label="至于学校教不教这个，如果有的话，我是没学过。但说不定有呢？ ",shape=box,color=red];
		j1361482495 -> j562805729;
	j1553728972 [label="如果没有，你能给我点什么建议，让我找到有关你能力的科学依据？",shape=box,color=blue];
		j1553728972 -> j728820260;
	j3927371263 [label="呃，那个混蛋。我就知道我应该多问他一些问题。好吧。至少如果是科学问题的话，那我就能复现它，而且既然你可以自由来去，我肯定能弄清楚。拜拜。",shape=box,color=blue];
		j3927371263 -> j2547432773;
	j2547432773 [label="+20 Chemistry",color=orange];
		j2547432773 -> "Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue";
	j562805729 [label="怎么，想要点家庭作业吗？现在讲时光旅行可能还太超前了……",shape=box,color=red];
		j562805729 -> j696791934;
	j728820260 [label="小孩，问题真多。不过我得让你失望了：我不知道。只有英择谛知道答案。",shape=box,color=red];
		j728820260 -> j3291693144;
	"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" [label="Queue conversation HexKayaConvo1 in HexDialogue_rom.dialogue",color=orange];
		"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j696791934 [label="呃，你说真的吗？",shape=box,color=blue];
		j696791934 -> j821724774;
	j3291693144 [label="Boolean KayaSetKid is now true.",color=orange];
		j3291693144 -> j253683150;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j821724774 [label="六人组里有人搞清楚了吗？他们有什么信息吗？ ",shape=box,color=blue];
		j821724774 -> j1381902763;
		j821724774 -> j381256404;
	j253683150 [label="行吧。",shape=box,color=blue];
		j253683150 -> j2547432773;
	j1381902763 [label="也许是阿米尔？他可能玩过一些关于时间旅行的游戏……",shape=box,color=red];
		j1381902763 -> j3572389511;
	j381256404 [label="孩子，我觉得没有。如果你想学点有用的东西，可以去找莱蒂学习一下治疗的基础课。",shape=box,color=red];
		j381256404 -> j995990538;
	j3572389511 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j3572389511 -> j1048438651;
	j995990538 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j995990538 -> j3826843211;
	j1048438651 [label="游戏？我需要的是答案，一个方向，什么都行。我自己会弄明白的。如果你想到什么有用的，来找我。",shape=box,color=blue];
		j1048438651 -> j2547432773;
	j3826843211 [label="那不是我的风格。算了。",shape=box,color=blue];
		j3826843211 -> j2547432773;
}