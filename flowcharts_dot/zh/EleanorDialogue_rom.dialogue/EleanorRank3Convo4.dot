digraph {
	1123 [label="EleanorRank3Convo4 begins.",color=orange];
		1123 -> 1124;
	1124 [label="如果我说错了什么，随时打断我：",shape=box,color=blue];
		1124 -> 1125;
	1125 [label="你还有另一个自己在外面四处走动。那个另一个自己既是你，又不是你。他们就像是另一个现实版本的你的孩童版。",shape=box,color=blue];
		1125 -> 1126;
		1125 -> 1127;
	1126 [label="不完全是。这是他们的现实版本。我这里是外来者。",shape=box,color=red];
		1126 -> 1128;
	1127 [label="更像是我们在某处分开了，我向左走，他们向右走。",shape=box,color=red];
		1127 -> 1129;
	1128 [label="哇喔，等一下。让我消化一下。",shape=box,color=blue];
		1128 -> 1130;
	1129 [label="所以我们现在是处于他们的现实里，不是你的，对吗？我得……消化一下。",shape=box,color=blue];
		1129 -> 1130;
	1130 [label="这么说……你就像是跨界剧集的客串明星，然后被写进了这个剧情？",shape=box,color=blue];
		1130 -> 1131;
	1131 [label="差不多就是这样。",shape=box,color=red];
		1131 -> 1132;
	1132 [label="这让我头都晕了。那你那个版本的现实怎么样了？它去哪了？",shape=box,color=blue];
		1132 -> 1133;
		1132 -> 1134;
		1132 -> 1135;
	1133 [label="我想它剩下的只有那艘幽灵船扎里曼号，堵在维度之间的一个洞……？",shape=box,color=red];
		1133 -> 1136;
	1134 [label="我想，它的一部分随我去了双衍王境，无论是好是坏。",shape=box,color=red];
		1134 -> 1137;
	1135 [label="我没想那么多。我猜它已经丢失了。",shape=box,color=red];
		1135 -> 1138;
	1136 [label="Check boolean EleanorHoldfasts1",color=orange];
		1136 -> 1139 [label=true,color=green];
		1136 -> 1140 [label=false,color=brown];
	1137 [label="那么从某种意义上来说，它依然存在。",shape=box,color=blue];
		1137 -> 1145;
	1138 [label="你不能就这样“丢失”一个整个宇宙。那太疯狂了。它一定还在某个地方。",shape=box,color=blue];
		1138 -> 1146;
	1139 [label="啊！你那友善幽灵们的巢穴。坚守者。",shape=box,color=blue];
		1139 -> 1141;
	1140 [label="抱歉，这听起来很有趣，但我不知道你在说什么。",shape=box,color=blue];
		1140 -> 1142;
	1145 [label="我不知道这是否算一种安慰。",shape=box,color=blue];
		1145 -> 1147;
	1146 [label="也许吧。就像我说的，这不是我主要关心的问题。",shape=box,color=red];
		1146 -> 1148;
	1141 [label="我实在无法想象，那会是你想回去散步怀旧的地方。",shape=box,color=blue];
		1141 -> 1143;
	1142 [label="幽灵船？",shape=box,color=blue];
		1142 -> 1144;
	1147 [label="我学到了，“家”更多在于你如何赋予身边的“地方”和“人”以意义，此心安处，便是吾乡。",shape=box,color=red];
		1147 -> 1149;
	1148 [label="但那是你的家。你不想回去吗？",shape=box,color=blue];
		1148 -> 1150;
	1143 [label="我无法想象你都失去了什么。",shape=box,color=blue];
		1143 -> 1151;
	1144 [label="维度之间的洞？",shape=box,color=blue];
		1144 -> 1152;
	1149 [label="与你出生在哪里或是什么出身的关系不大。",shape=box,color=red];
		1149 -> 1157;
	1150 [label="真的不是了，不再是了。我其实没有家。",shape=box,color=red];
		1150 -> 1158;
	1151 [label="我不这么看。",shape=box,color=red];
		1151 -> 1153;
	1152 [label="我当时乘坐的是扎里曼号殖民船。目的地是 Tau 星系。但没能到达。",shape=box,color=red];
		1152 -> 1154;
	1157 [label="我不关注失去的东西。我关注我仍然拥有的东西。比如这个地方。比如你们所有人。因为……",shape=box,color=red];
		1157 -> 1159;
	1158 [label="你知道，我被叫做为“漂泊者”是有原因的。",shape=box,color=red];
		1158 -> 1159;
	1153 [label="我逃了出来。我活了下来。这有多幸运？",shape=box,color=red];
		1153 -> 1155;
	1154 [label="她最终落入虚空，那里的某种存在决定将这艘飞船变成一片地狱般的景象。",shape=box,color=red];
		1154 -> 1156;
	1159 [label="在我去过的所有地方中，这里最让我有归属感。",shape=box,color=red];
		1159 -> 1171;
	1155 [label="说实话，我们任何一个人能存在的几率本就是极低，对我来说这只是又一个奇迹。",shape=box,color=red];
		1155 -> 1160;
	1156 [label="她一直在虚空与现实之间来回穿梭，如今被困在了两者的界限上。",shape=box,color=red];
		1156 -> 1161;
	1171 [label="哈。奇怪的是，这让我有点自豪。",shape=box,color=blue];
		1171 -> 1172;
	1160 [label="别纠结我们失去了什么。珍惜我们拥有的一切。",shape=box,color=red];
		1160 -> 1170;
	1161 [label="她其实并不只是一艘飞船。她更像是……多个不同版本的集合体。",shape=box,color=red];
		1161 -> 1162;
	1172 [label="也许你只是需要一支合适的、致命而时尚的都市生物突击队来作伴。",shape=box,color=blue];
		1172 -> 1173;
	1170 [label="比如说？我现在有了这个地方。还有你们所有人。这是第一个我真正感觉像家的地方。",shape=box,color=red];
		1170 -> 1171;
	1162 [label="Update boolean EleanorHoldfasts1",color=orange];
		1162 -> 1163;
	1173 [label="像我这样不合群和搞砸一切的人？",shape=box,color=red];
		1173 -> 1174;
	1163 [label="我实在无法想象，那会是你想回去散步怀旧的地方。",shape=box,color=blue];
		1163 -> 1164;
	1174 [label="伙计，而且还感到自豪。",shape=box,color=blue];
		1174 -> 1175;
	1164 [label="我无法想象你都失去了什么。",shape=box,color=blue];
		1164 -> 1165;
		1164 -> 1166;
	1175 [label="但回到你的另一个版本……",shape=box,color=blue];
		1175 -> 1176;
		1175 -> 1177;
	1165 [label="我不这么看。",shape=box,color=red];
		1165 -> 1167;
	1166 [label="我现在有了这个地方。这是第一个我真正感觉像家的地方。",shape=box,color=red];
		1166 -> 1171;
	1176 [label="对。Ordis 称他们为“指挥官”。Lotus 称他们为“她的孩子”。我通常就叫他们“孩子”。",shape=box,color=red];
		1176 -> 1180;
	1177 [label="我尽量避开他们。我这点工资还不够让我当保姆，哪怕只是照看我自己。",shape=box,color=red];
		1177 -> 1178;
	1167 [label="我逃了出来。我活了下来。这有多幸运？",shape=box,color=red];
		1167 -> 1168;
	1180 [label="+10 Chemistry",color=orange];
		1180 -> 1181;
	1178 [label="噢，太狠了。",shape=box,color=blue];
		1178 -> 1179;
	1168 [label="说实话，我们任何一个人能存在的几率本就是极低，对我来说这只是又一个奇迹。",shape=box,color=red];
		1168 -> 1169;
	1181 [label="Check boolean EleanorLotus",color=orange];
		1181 -> 1182 [label=true,color=green];
		1181 -> 1185 [label=false,color=brown];
	1179 [label="考虑到你们有那么多共同之处，你可以对他们更温柔一些的。",shape=box,color=blue];
		1179 -> 1185;
	1169 [label="别纠结我们失去了什么。珍惜我们拥有的一切。",shape=box,color=red];
		1169 -> 1170;
	1182 [label="我喜欢她有孩子这件事。那些致命的太空孩童。",shape=box,color=blue];
		1182 -> 1183;
	1185 [label="所以这是我不明白的部分。",shape=box,color=blue];
		1185 -> 1186;
	1183 [label="我在想她会不会让我成为其中一个？我能成为 Tenno 吗？",shape=box,color=blue];
		1183 -> 1184;
	1186 [label="这个孩子已经有数十亿岁了，但是他们大部分时间都待在冰箱里，所以他们还是个孩子，对吗？",shape=box,color=blue];
		1186 -> 1187;
		1186 -> 1188;
	1184 [label="不。我我想我不能吧？首先，我太老了。",shape=box,color=blue];
		1184 -> 1185;
	1187 [label="差不多是这样。",shape=box,color=red];
		1187 -> 1189;
	1188 [label="不太确定他们在被训练成职业杀手后还有多少“孩童”天性。",shape=box,color=red];
		1188 -> 1190;
	1189 [label="好的。",shape=box,color=blue];
		1189 -> 1191;
	1190 [label="孩子。就是。孩子。",shape=box,color=blue];
		1190 -> 1192;
	1191 [label="请稍稍体谅下我。",shape=box,color=blue];
		1191 -> 1194;
	1192 [label="他们不会因为受到虐待就变成其他东西。",shape=box,color=blue];
		1192 -> 1193;
	1194 [label="如果你不想谈论这个话题，请立刻告诉我。",shape=box,color=blue];
		1194 -> 1195;
	1193 [label="Chat ends.",color=orange];
	1195 [label="那艘扎里曼号？你的父母的事？这个孩子和你一样经历了那些恐怖的事件，对吗？",shape=box,color=blue];
		1195 -> 1196;
	1196 [label="是的。",shape=box,color=red];
		1196 -> 1197;
	1197 [label="你必须明白，一开始我们俩之间只有一个我。我们完全是同一个人，直到我和那个东西握手的那一刻。那时他们走了他们的路，我走了我的路。",shape=box,color=red];
		1197 -> 1198;
	1198 [label="好的。想这个让我头疼，但好吧。",shape=box,color=blue];
		1198 -> 1199;
	1199 [label="所以有个孩子。一个深受创伤的孩子。真的有人认为给这样一个孩子武器、盔甲和一系列由死人制成的战斗服，训练他们杀人，然后送他们去打仗是个好主意吗？",shape=box,color=blue];
		1199 -> 1200;
	1200 [label="对。那就是奥罗金。",shape=box,color=red];
		1200 -> 1201;
	1201 [label="告诉我，在经历了所有这些，以及正在经历的情况下，这个孩子怎么还没有在医院里陷入精神崩溃？",shape=box,color=blue];
		1201 -> 1202;
		1201 -> 1203;
	1202 [label="老实说，我也说不清楚。我知道有人喜欢他们，照顾他们。主要是 Ordis 和 Lotus。",shape=box,color=red];
		1202 -> 1204;
	1203 [label="虚空作证，他们见过的暴力与流血远超任何孩子应当承受的程度。而且，他们也从未选择过这样的生活。",shape=box,color=red];
		1203 -> 1204;
	1204 [label="Tenno 没有选择是否成为战士的权利。奥罗金本来打算杀死他们所有人，直到他们找到了利用他们的方式。",shape=box,color=red];
		1204 -> 1205;
	1205 [label="但是是什么让他们继续前行呢？我觉得那不是他们被训练出来的，这是关于他们是谁的事情。",shape=box,color=red];
		1205 -> 1206;
	1206 [label="关怀？同情？",shape=box,color=blue];
		1206 -> 1207;
		1206 -> 1208;
		1206 -> 1209;
	1207 [label="正义。公义。",shape=box,color=red];
		1207 -> 1210;
	1208 [label="或许是一些更深层次的东西。",shape=box,color=red];
		1208 -> 1224;
	1209 [label="生存本能。归根结底，人们想要活下去。",shape=box,color=red];
		1209 -> 1231;
	1210 [label="Check boolean EleanorHeroVirus",color=orange];
		1210 -> 1211 [label=true,color=green];
		1210 -> 1212 [label=false,color=brown];
	1224 [label="也许是虚空无情之物的反面吧。",shape=box,color=blue];
		1224 -> 1225;
	1231 [label="嗯。我不知道。",shape=box,color=blue];
		1231 -> 1232;
	1211 [label="当然了。英雄病毒。我早该知道它会流传到你们那个时代。",shape=box,color=blue];
		1211 -> 1213;
	1212 [label="啊。英雄病毒。",shape=box,color=blue];
		1212 -> 1214;
	1225 [label="我在想……",shape=box,color=blue];
		1225 -> 1226;
	1232 [label="如果他们只是想生存，那么他们和科腐者没什么两样。",shape=box,color=blue];
		1232 -> 1233;
	1213 [label="那些可怜的孩子们完全沉浸在一个神话中，不是吗？",shape=box,color=blue];
		1213 -> 1215;
	1214 [label="这就是我所说的荒谬循环，以美好的故事开头，却以年轻人自愿送命结尾。",shape=box,color=blue];
		1214 -> 1219;
	1226 [label="什么？",shape=box,color=red];
		1226 -> 1227;
	1233 [label="从你谈论这个孩子的方式来看，我不知道我是更担心他们还是更害怕他们。",shape=box,color=blue];
		1233 -> 1234;
	1215 [label="被训练去相信自己是光荣的战士，而不是无辜的傀儡吗？",shape=box,color=blue];
		1215 -> 1216;
	1219 [label="亚瑟有这病，克里斯托弗也有。",shape=box,color=blue];
