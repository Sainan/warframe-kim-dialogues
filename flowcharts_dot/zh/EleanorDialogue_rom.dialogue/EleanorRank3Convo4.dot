		1248 -> 1251 [label=true,color=green];
		1248 -> 1249 [label=false,color=brown];
	1240 [label="因为他们内心那个能忍受他们所经历的一切，并仍然心存同情的东西？我们都需要那种力量。",shape=box,color=blue];
		1240 -> 1242;
	1244 [label="我想知道他们是怎么应对的。",shape=box,color=blue];
		1244 -> 1245;
	1251 [label="我一直在尝试通过心灵感应与她联系。如果你能做到，我也能，对吧？",shape=box,color=blue];
		1251 -> 1252;
		1251 -> 1253;
	1249 [label="事实上，得知你的另一个版本后，我确信在某个地方一定有另一个决定成为一名修女的我。 月神的信徒，剃光头，定期祈祷，所有这些。",shape=box,color=blue];
		1249 -> 1250;
