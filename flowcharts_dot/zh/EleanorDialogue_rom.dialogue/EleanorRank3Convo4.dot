	1223 [label="Chat ends.",color=orange];
	1236 [label="老实说，那个孩子很好。Lotus 和他们在一起。洛德也在。他们不会崩溃的。",shape=box,color=red];
		1236 -> 1239;
	1237 [label="埃莉诺，不要低估他们。这么多年来，没有我，他们也过得很好。",shape=box,color=red];
		1237 -> 1243;
	1238 [label="不用担心。我已经在去看了。如果你愿意，我会转告他们你的问候。",shape=box,color=red];
		1238 -> 1247;
	1239 [label="好的。我只是希望你确定。",shape=box,color=blue];
		1239 -> 1241;
	1243 [label="坦白说，我并不确定屠杀数千人并承受难以言喻的创伤是否算“过得很好”。",shape=box,color=blue];
		1243 -> 1246;
	1247 [label="谢谢。我承认，与另一个版本的自己交谈对我来说很兴奋。",shape=box,color=blue];
		1247 -> 1248;
	1241 [label="+5 Chemistry",color=orange];
