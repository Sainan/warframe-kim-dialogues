digraph {
	2386 [label="EleanorRank5Convo4 begins.",color=orange];
		2386 -> 2387;
	2387 [label="Check boolean EleanorDating",color=orange];
		2387 -> 2388 [label=true,color=green];
		2387 -> 2389 [label=false,color=brown];
	2388 [label="亲爱的？如果你在，我现在很需要你的倾听。",shape=box,color=blue];
		2388 -> 2390;
	2389 [label="如果你在，我现在很需要一个朋友。",shape=box,color=blue];
		2389 -> 2390;
	2390 [label="Check boolean EleanorArthurNightmare",color=orange];
		2390 -> 2391 [label=true,color=green];
		2390 -> 2392 [label=false,color=brown];
	2391 [label="我又做那些亚瑟的梦了。那些他不得不杀了我的梦。",shape=box,color=blue];
		2391 -> 2394;
		2391 -> 2395;
	2392 [label="我一直做着这个可怕的梦，梦到亚瑟要杀了我。当他把剑插入我的肋骨时，我尖叫着“埃莉诺就在这里，你这个蠢货！”他已经听不见我的声音了。",shape=box,color=blue];
		2392 -> 2393;
	2394 [label="我在呢。没事的。",shape=box,color=red];
		2394 -> 2397;
	2395 [label="[无视]",shape=box,color=red];
		2395 -> 2396;
	2393 [label="Update boolean EleanorArthurNightmare",color=orange];
		2393 -> 2394;
		2393 -> 2395;
	2397 [label="埃莉诺，亚瑟不会杀你的。你是他的姐姐。他知道这一点。",shape=box,color=red];
		2397 -> 2398;
	2396 [label="Chat ends.",color=orange];
	2398 [label="问题就在这里。“你不再是我的姐姐了。”这是他在梦中说的话。然后他用他的玩具剑刺穿了我的胸膛。",shape=box,color=blue];
		2398 -> 2399;
	2399 [label="在梦里我们还只是小孩子，如果这还不够混乱的话。",shape=box,color=blue];
		2399 -> 2400;
		2399 -> 2401;
	2400 [label="那不是真的。无论你被感染得多严重，我不相信亚瑟会伤害你。",shape=box,color=red];
		2400 -> 2402;
	2401 [label="……哎呀。",shape=box,color=red];
		2401 -> 2403;
	2402 [label="甚至不会“让我摆脱痛苦”吗？即使我在受苦？",shape=box,color=blue];
		2402 -> 2408;
	2403 [label="嗯。这是最糟糕的部分。",shape=box,color=blue];
		2403 -> 2404;
	2408 [label="他跟他爸爸一样。他只做正确的事情，而不是容易的事。",shape=box,color=blue];
		2408 -> 2409;
		2408 -> 2410;
	2404 [label="太生动了，太真实了。就像我在回忆真实发生过的事情一样。",shape=box,color=blue];
		2404 -> 2405;
		2404 -> 2406;
	2409 [label="无论你认为你的家庭有多糟糕，与我见过的一些家庭相比，这根本不算什么。",shape=box,color=red];
		2409 -> 2411;
	2410 [label="等一下。你爸爸和这件事有什么关系？",shape=box,color=red];
		2410 -> 2412;
	2405 [label="但我相信亚瑟实际上不会这么做的。",shape=box,color=red];
		2405 -> 2408;
	2406 [label="也许你应该和亚瑟谈谈这件事？",shape=box,color=red];
		2406 -> 2407;
	2411 [label="我确信。未来在其残酷性上非常有创意。",shape=box,color=blue];
		2411 -> 2413;
	2412 [label="关系到一切。",shape=box,color=blue];
		2412 -> 2414;
		2412 -> 2415;
	2407 [label="我做不到。他跟他爸爸一样。他只做正确的事情，而不是容易的事。",shape=box,color=blue];
		2407 -> 2409;
		2407 -> 2410;
	2413 [label="但我现在关心的是过去。",shape=box,color=blue];
		2413 -> 2416;
	2414 [label="如果你想让我理解，你得给我更多的信息。",shape=box,color=red];
		2414 -> 2416;
	2415 [label="埃莉诺，请不要故意含糊其辞。",shape=box,color=red];
		2415 -> 2417;
	2416 [label="这是许多我们不曾谈论的事情之一。",shape=box,color=blue];
		2416 -> 2420;
	2417 [label="我没有。",shape=box,color=blue];
		2417 -> 2418;
	2420 [label="我们没谈论过在卡沃纳发生的事情，没谈论过克里斯托弗，更没谈论过卡莉奶奶。",shape=box,color=blue];
		2420 -> 2421;
		2420 -> 2422;
	2418 [label="我真的在尽力解释。",shape=box,color=blue];
		2418 -> 2419;
	2421 [label="那也许你不应该谈论。",shape=box,color=red];
		2421 -> 2423;
	2422 [label="那也许你应该谈论。",shape=box,color=red];
		2422 -> 2425;
	2419 [label="我爸爸为亚瑟和我处理彼此之间问题的方式树立了榜样。或者更确切地说，为我们如何回避问题树立了榜样。",shape=box,color=blue];
		2419 -> 2420;
	2423 [label="也许我不应该谈论。",shape=box,color=blue];
		2423 -> 2424;
	2425 [label="也许我应该谈论。",shape=box,color=blue];
		2425 -> 2426;
	2424 [label="Chat ends.",color=orange];
	2426 [label="也许是时候了。",shape=box,color=blue];
		2426 -> 2427;
	2427 [label="你想听整个故事吗？还是我只讲重点？",shape=box,color=blue];
		2427 -> 2428;
		2427 -> 2429;
	2428 [label="我哪儿也不去。告诉我整个故事吧。",shape=box,color=red];
		2428 -> 2432;
	2429 [label="可以给我一个简短版本吗？",shape=box,color=red];
		2429 -> 2430;
	2432 [label="卡莉奶奶是我们的祖母。卡莉斯塔·彭罗斯·南丁格尔。",shape=box,color=blue];
		2432 -> 2433;
	2430 [label="卡莉奶奶病得很重。精神错乱。我们的父亲用枕头把她闷死，不愿让她继续受苦。希望这对你来说够简洁。",shape=box,color=blue];
		2430 -> 2431;
	2433 [label="她患有佩勒姆综合症。你们现在可能已经找到了治疗方法（她内心痛苦地说道）。这种病会侵蚀人的心智。与其说是一下子看着你爱的人死去，不如说是他们逐渐地，一点一点地消失，就像一张老照片在阳光下慢慢褪色，或是一段被复制过多的录像带。",shape=box,color=blue];
		2433 -> 2434;
		2433 -> 2435;
	2431 [label="Chat ends.",color=orange];
	2434 [label="就像苏达的情况，让她决定成为一个中枢。我理解。",shape=box,color=red];
		2434 -> 2436;
	2435 [label="实际上……不，我们还没有找到治疗方法……",shape=box,color=red];
		2435 -> 2436;
	2436 [label="她刚来和我们一起住时，亚瑟和我都很兴奋。对我们来说，她是一位可爱的老太太，身上散发着紫罗兰的香味，会用各种不同的声音讲故事。我们过生日时，她会给我们真钱折纸。我们以为生活会一直像过生日一样。",shape=box,color=blue];
		2436 -> 2437;
	2437 [label="后来她的状况开始恶化。起初，她只是健忘。后来她开始把我们和其他人弄混。她把我叫成艾伯丁，把亚瑟叫成查理。还问起吉米跑到哪里去了。我们一直都不知道吉米是狗还是猫，还是她的男朋友。",shape=box,color=blue];
		2437 -> 2438;
	2438 [label="后来，她开始和不存在的人说话。然后，天黑后她会在房子里徘徊。",shape=box,color=blue];
		2438 -> 2440;
		2438 -> 2441;
	2440 [label="这对你们俩来说一定很可怕。",shape=box,color=red];
		2440 -> 2439;
	2441 [label="哦，虚空。",shape=box,color=red];
		2441 -> 2439;
	2439 [label="我记得半夜上厕所时，看到她在黑暗中沿着走廊踉踉跄跄地向我走来，呻吟着，脸部扭曲，头发像疯掉的小丑假发。我忍不住尖叫了起来。",shape=box,color=blue];
		2439 -> 2442;
	2442 [label="当情况变得非常糟糕时，她会躺在床上尖叫。早上我们去上学，在回家路上当我拐进小巷时，我会感到心情沉重，因为过了整整八个小时后，我还能在十户人家开外听到她的尖叫。",shape=box,color=blue];
		2442 -> 2443;
	2443 [label="我们的父亲曾经说过要用枕头捂住她的脸。我们以为他在开玩笑，一定是在开玩笑，因为那毕竟是他的妈妈。",shape=box,color=blue];
		2443 -> 2444;
		2443 -> 2445;
	2444 [label="现在很多事情都说得通了。",shape=box,color=red];
		2444 -> 2446;
	2445 [label="……哦。",shape=box,color=red];
		2445 -> 2446;
	2446 [label="有一晚她又在尖叫，然后尖叫声就停止了。我起床走到亚瑟的房间。当然，他也醒了。我们坐在一起静静听着，然后我们听到她房间的门关上了。",shape=box,color=blue];
		2446 -> 2447;
	2447 [label="第二天，爸爸说她在睡梦中去世了。",shape=box,color=blue];
		2447 -> 2448;
		2447 -> 2449;
	2448 [label="你害怕亚瑟也会对你做同样的事吗？",shape=box,color=red];
		2448 -> 2450;
	2449 [label="亚瑟不是你的爸爸。他不会做那种事。",shape=box,color=red];
		2449 -> 2451;
	2450 [label="如果他真的认为那是最好的选择呢？",shape=box,color=blue];
		2450 -> 2452;
	2451 [label="你无法确定这一点。如果亚瑟真的认为这是最好的选择呢？",shape=box,color=blue];
		2451 -> 2452;
	2452 [label="我不知道。可能吧。不过现在我说出来之后，感觉没那么可能了。",shape=box,color=blue];
		2452 -> 2453;
	2453 [label="+20 Chemistry",color=orange];
		2453 -> 2454;
	2454 [label="你真好。谢谢你的包容。我需要把这些话说出来。",shape=box,color=blue];
		2454 -> 2455;
	2455 [label="Update boolean EleanorDreams",color=orange];
		2455 -> 2456;
	2456 [label="Chat ends.",color=orange];
}