		210 -> 211;
	191 [label="是的。虚空中有某种东西。这一点我是知道的。虚空无情之物，无睑之眼，“墙中人”。当我说虚空造成了这一切，我的意思是，是他做的。",shape=box,color=red];
		191 -> 193;
	197 [label="文字被赋予了生命。从虚无创造出了具体的现实。",shape=box,color=blue];
