		205 -> 204;
	176 [label="噢，天哪。这真是太糟糕了。",shape=box,color=blue];
		176 -> 177;
	178 [label="是的。简直就像是童话故事变成了现实。",shape=box,color=red];
		178 -> 182;
	179 [label="我以前很喜欢一本书。《双衍王境故事集》。是一些关于一个魔法王国的故事，但实际上它讲的是情感以及情感所能教会我们的教训。",shape=box,color=red];
		179 -> 180;
	204 [label="我的意思是，我是一个战甲，或者说是原型战甲。我和他们一样。",shape=box,color=blue];
		204 -> 206;
	177 [label="你现在是不是不太想谈这个？",shape=box,color=blue];
		177 -> 175;
		177 -> 173;
	182 [label="这是真实的吗？感觉不像是梦境吗？",shape=box,color=blue];
		182 -> 189;
	180 [label="虚空让它变成了现实，我就生活在了那个世界里。后来它变成了一座监狱。不过那就是另一个故事了。",shape=box,color=red];
		180 -> 181;
	206 [label="我现在能做这些事情了。精神控制，或者融化别人的脸。",shape=box,color=blue];
		206 -> 207;
	175 [label="我没问题。",shape=box,color=red];
		175 -> 186;
	173 [label="嗯，不太想谈。[结束]",shape=box,color=red];
		173 -> 183;
	189 [label="不，埃莉诺，每天早上被杀害的感觉绝对不像是在做梦。我感受到了每一秒的痛苦。",shape=box,color=red];
		189 -> 190;
	181 [label="Update boolean EleanorDuviri",color=orange];
		181 -> 182;
	207 [label="我的这些力量是从虚空来的吗？",shape=box,color=blue];
		207 -> 208;
	186 [label="父母和孩子被迫分开，互相反目。这在我看来并非偶然。",shape=box,color=blue];
