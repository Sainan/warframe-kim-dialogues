	156 [label="我感觉自己被问住了。这是采访吗？",shape=box,color=red];
		156 -> 159;
	157 [label="它对我“意味”着什么？",shape=box,color=red];
		157 -> 160;
	158 [label="没人真正知道虚空是什么。它是一个维度，是一个能量场，是一条穿越太空的捷径，是奥罗金藏身之处……",shape=box,color=red];
		158 -> 161;
	159 [label="抱歉。老习惯了。",shape=box,color=blue];
		159 -> 162;
	160 [label="是的。",shape=box,color=blue];
		160 -> 163;
	161 [label="虽然这些听起来很有趣，但听起来有些技术性。我更感兴趣的是它对你意味着什么。因为你看起来就像是，呃，在为它而活。字面上的意思。",shape=box,color=blue];
		161 -> 164;
		161 -> 165;
		161 -> 166;
	162 [label="请原谅我。我不再是记者了，你也不是我报道的对象。我只是非常感兴趣。",shape=box,color=blue];
		162 -> 164;
		162 -> 165;
		162 -> 166;
	163 [label="讲讲你的个人感受吧。",shape=box,color=blue];
		163 -> 164;
		163 -> 165;
		163 -> 166;
	164 [label="虚空让我能做一些不可能的事情。发射能量光束，化为虚无，诸如此类的厉害事情。在我们那边，正是虚空让战甲能够做到他们所做的事情。",shape=box,color=red];
		164 -> 201;
	165 [label="虚空让我的父母发疯了。",shape=box,color=red];
		165 -> 167;
	166 [label="虚空曾是我的家，我不知道在那里待了多久。它好像根据我来塑造它自己，或者是我以某种方式塑造了它。具体是什么还不太清楚。",shape=box,color=red];
		166 -> 169;
	201 [label="等一下。等等。",shape=box,color=blue];
		201 -> 202;
	167 [label="我很抱歉。我现在觉得自己提这个问题有些失礼了。",shape=box,color=blue];
		167 -> 168;
	169 [label="哦。你完全引起了我的注意。",shape=box,color=blue];
		169 -> 170;
	202 [label="你是说，虚空是一种奇迹引擎？",shape=box,color=blue];
		202 -> 203;
	168 [label="他们有恢复吗？",shape=box,color=blue];
		168 -> 171;
	170 [label="Check boolean EleanorDuviri",color=orange];
