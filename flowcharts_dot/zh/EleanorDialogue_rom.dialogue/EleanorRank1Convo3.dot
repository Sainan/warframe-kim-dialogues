		170 -> 174 [label=false,color=brown];
	203 [label="而我已经与它产生了连接？",shape=box,color=blue];
		203 -> 205;
	171 [label="他们没有那个机会。",shape=box,color=red];
		171 -> 176;
	172 [label="你说的“塑造”是指……双衍王境？那些塔楼、岛屿和飞马？",shape=box,color=blue];
		172 -> 178;
	174 [label="它变成了什么样子？",shape=box,color=blue];
		174 -> 179;
