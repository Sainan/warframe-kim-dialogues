digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"EleanorRank6Convo4 begins." [color=orange];
		"EleanorRank6Convo4 begins." -> j3794163865;
	j3794163865 [label="你有没有过这样的经历：正在洗澡时，突然有个奇怪的小声音问了你一个你从未想过要问自己的问题？",shape=box,color=blue];
		j3794163865 -> j2230578819;
		j3794163865 -> j1702494759;
		j3794163865 -> j1826810655;
	j2230578819 [label="没有过。[结束]",shape=box,color=red];
		j2230578819 -> "Chat ends.";
	j1702494759 [label="就像\"当月球突然再次出现在天空中时，地球上的人们会怎么想？”",shape=box,color=red];
		j1702494759 -> j91591426;
	j1826810655 [label="你的意思就像\"指挥官！您是否考虑过把您的库狛制作成标本？” ",shape=box,color=red];
		j1826810655 -> j1336905914;
	"Chat ends." [color=orange];
	j91591426 [label="对，没错。",shape=box,color=blue];
		j91591426 -> j3744813998;
	j1336905914 [label="那是 Ordis。他就会这样。",shape=box,color=red];
		j1336905914 -> j3997784250;
	j3744813998 [label="等等",shape=box,color=blue];
		j3744813998 -> j3163262212;
	j3997784250 [label="保佑他。不，我说的是内心的声音。",shape=box,color=blue];
		j3997784250 -> j2096378851;
	j3163262212 [label="月球消失了？",shape=box,color=blue];
		j3163262212 -> j471260595;
	j2096378851 [label="有点像你在专注于个人卫生，而你的的大脑在忙着自娱自乐。",shape=box,color=blue];
		j2096378851 -> j4126517364;
	j471260595 [label="多久了？她去了哪里？那潮汐怎么办？",shape=box,color=blue];
		j471260595 -> j2179774399;
		j471260595 -> j2233422524;
	j4126517364 [label="我经常遇到这种情况。奇怪的是，它们总是随机出现。最近这种情况频繁到让我开始怀疑，这些想法是不是真的都来自我的大脑。 ",shape=box,color=blue];
		j4126517364 -> j3158568976;
	j2179774399 [label="按顺序回答：不知道，虚空，不知道。",shape=box,color=red];
		j2179774399 -> j351405484;
	j2233422524 [label="Lotus 在远古之战结束后将她送入了虚空。那个孩子最近才将她带了回来。",shape=box,color=red];
		j2233422524 -> j735811043;
	j3158568976 [label="我把其中的一些画了出来。",shape=box,color=blue];
		j3158568976 -> j351405484;
	j351405484 [label="算了，我们以后再讨论这个。",shape=box,color=blue];
		j351405484 -> j349037660;
	j735811043 [label="不清楚潮汐的情况。",shape=box,color=red];
		j735811043 -> j3614088409;
	j349037660 [label="所以，随意的淋浴想法。今早我被一个超绝的问题击中了。",shape=box,color=blue];
		j349037660 -> j2170963485;
	j3614088409 [label="Lotus 是怎么挪动整个月亮的？",shape=box,color=blue];
		j3614088409 -> j351405484;
	j2170963485 [label="它说，\"嘿，如果神真的存在呢？”",shape=box,color=blue];
		j2170963485 -> j3136864962;
	j3136864962 [label="我一下子浑身发抖。只好用冷水洗脸，让自己清醒过来。",shape=box,color=blue];
		j3136864962 -> j3272569443;
		j3136864962 -> j2938906725;
		j3136864962 -> j2400485011;
	j3272569443 [label="这有什么奇怪的？在我看来这是一个很基本的问题。",shape=box,color=red];
		j3272569443 -> j3993304752;
	j2938906725 [label="……难道人们不认为神是真实存在的？我敢肯定莱蒂是相信的。",shape=box,color=red];
		j2938906725 -> j2041255358;
	j2400485011 [label="是啊，那真是个可怕的想法。",shape=box,color=red];
		j2400485011 -> j541438499;
	j3993304752 [label="啊，这就是为什么我喜欢和你谈论这些事情",shape=box,color=blue];
		j3993304752 -> j2435393255;
	j2041255358 [label="哦，别开玩笑了。没有人真的认为神是真实存在的。不是像桌子和椅子那样真实存在。",shape=box,color=blue];
		j2041255358 -> j2159740048;
	j541438499 [label="是吧？如果每次你觉得宇宙在给你传递信息时，而它确实是在发送信息，那会怎样？",shape=box,color=blue];
		j541438499 -> j3207889980;
	j2435393255 [label="你的生活如此荒诞不经，以至于神的存在对你来说，就像比萨配料的优劣之争一样自然而然",shape=box,color=blue];
		j2435393255 -> j3384596390;
	j2159740048 [label="真正的神就像村里的水井和户外厕所。它们是人们曾经拥有过的东西。 ",shape=box,color=blue];
		j2159740048 -> j3688556822;
	j3207889980 [label="想象一下，一切都掌握在这些卑鄙、不死的混蛋手中，他们掌权只是因为事情就是这样，而不是因为他们配得上",shape=box,color=blue];
		j3207889980 -> j1871024444;
	j3384596390 [label="你甚至可能遇到过一个神。如果这就是虚空无情之物的话。",shape=box,color=blue];
		j3384596390 -> j1736695589;
	j3688556822 [label="如今它们不过就是符号、隐喻，或是些无稽之谈之类的东西。",shape=box,color=blue];
		j3688556822 -> j1246492359;
		j3688556822 -> j1475816397;
	j1871024444 [label="而最疯狂的是，人们就是这样生活的。这就是他们的现实，他们每天的生活都是如此。",shape=box,color=blue];
		j1871024444 -> j1855370362;
	j1736695589 [label="你刚才让我想起了一件事，那是在扎里曼号上我第一次遇到虚空无情之物。",shape=box,color=red];
		j1736695589 -> j1557910694;
	j1246492359 [label="也许人们只是不再那么害怕了？",shape=box,color=red];
		j1246492359 -> j2560978821;
	j1475816397 [label="我以为太阳神和月神是你们的神。",shape=box,color=red];
		j1475816397 -> j2122537751;
	j1855370362 [label="对他们来说，神就像天气一样真实，而且对他们也差不多同样不在乎。",shape=box,color=blue];
		j1855370362 -> j1336794706;
	j1557910694 [label="当然，当时我并不知道那是什么。不过我记得它说了什么。 ",shape=box,color=red];
		j1557910694 -> j2207686924;
	j2560978821 [label="我觉得是这样，没错。 ",shape=box,color=blue];
		j2560978821 -> j3122148735;
	j2122537751 [label="是的，它们确实是。但它们也只是天体。 ",shape=box,color=blue];
		j2122537751 -> j2288189737;
	j1336794706 [label="说实话，这听起来和在奥罗金统治下的生活没什么两样。",shape=box,color=red];
		j1336794706 -> j3991864064;
	j2207686924 [label="我说它可以拿走我的光，它冲我咧嘴一笑，说：“小鬼，谢谢你。我想我会用到的。”",shape=box,color=red];
		j2207686924 -> j3256134237;
	j3122148735 [label="我想我也知道原因。",shape=box,color=blue];
		j3122148735 -> j654190241;
	j2288189737 [label="就像不列颠尼克是一个国家，有自己的名字和身份什么的，但它也只是一堆土和石头。它可以同时是两者。",shape=box,color=blue];
		j2288189737 -> j2614598357;
	j3991864064 [label="永生不死、心胸狭隘、掌权只是因为他们本就掌权……",shape=box,color=red];
		j3991864064 -> j988790841;
	j3256134237 [label="天啊，你让我起鸡皮疙瘩",shape=box,color=blue];
		j3256134237 -> j1461256656;
	j654190241 [label="一切都与光有关。",shape=box,color=blue];
		j654190241 -> j3631939238;
	j2614598357 [label="你可以趁着一个晴朗美好的日子出去走走，心怀感激地仰望太阳，然后大声喊出“谢谢！”你发自内心地这么做。这是人类会做的事。",shape=box,color=blue];
		j2614598357 -> j2179486057;
	j988790841 [label="没错。你们确实有过活着的神。但你们把他们杀光了。",shape=box,color=blue];
		j988790841 -> j328538455;
	j1461256656 [label="魔鬼对法律条文一丝不苟，在所有古老的民间故事中都是如此。",shape=box,color=blue];
		j1461256656 -> j2713781741;
	j3631939238 [label="太阳和月亮究竟是什么？在它们被认为是神之前？它们只不过是光而已。",shape=box,color=blue];
		j3631939238 -> j3215919260;
		j3631939238 -> j1580735050;
	j2179486057 [label="但现在没有人会认为太阳神或月神真的让某个人类女人怀孕了或者是某个人类男人的孩子的母亲，这就是国王的由来。",shape=box,color=blue];
		j2179486057 -> j428598387;
	j328538455 [label="（别误会，我为你感到高兴。）",shape=box,color=blue];
		j328538455 -> j3871169806;
	j2713781741 [label="你觉得它认为你已经向它许下了承诺吗？你的“光”？",shape=box,color=blue];
		j2713781741 -> j2879212146;
		j2713781741 -> j2084789710;
	j3215919260 [label="对。无论你走到哪里，光都象征着美好。",shape=box,color=red];
		j3215919260 -> j1758071448;
	j1580735050 [label="人类在漫长的岁月里所拥有的唯一光明。",shape=box,color=red];
		j1580735050 -> j1758071448;
	j428598387 [label="人们过去曾相信那些说法。如今我们知道那些故事不过是传说。我们已经超越了它们。",shape=box,color=blue];
		j428598387 -> j2117952018;
		j428598387 -> j3200300284;
	j3871169806 [label="你把我跟那孩子搞混了。我从没参与过伟大的 Tenno 起义。",shape=box,color=red];
		j3871169806 -> j47049353;
	j2879212146 [label="它说我们明明约定好了。所以我想它认为我欠它……什么东西。",shape=box,color=red];
		j2879212146 -> j1382922391;
	j2084789710 [label="我指的是我随身携带的灯球，但谁知道它说的是什么。",shape=box,color=red];
		j2084789710 -> j1382922391;
	j1758071448 [label="是的。",shape=box,color=blue];
		j1758071448 -> j861563503;
	j2117952018 [label="神与人……在一起了？",shape=box,color=red];
		j2117952018 -> j1950855656;
	j3200300284 [label="国王的父母是神？我还以为奥罗金人就是混蛋呢。",shape=box,color=red];
		j3200300284 -> j1950855656;
	j47049353 [label="从来没参与过 Margulis 为“非常特别的孩子们”设立的项目，从没得到过战甲，也从来没参与过远古之战。",shape=box,color=red];
		j47049353 -> j872922059;
	j1382922391 [label="我至少知道一件事。它会捣鬼。",shape=box,color=red];
		j1382922391 -> j850358393;
	j861563503 [label="但后来，有个小洞穴宅男——他大概是被那些大洞穴女孩欺负过——想出了用石头互相敲击的办法，结果一击即中。",shape=box,color=blue];
		j861563503 -> j966941983;
	j1950855656 [label="哦，那种事情发生过很多次。世界各地都有过。",shape=box,color=blue];
		j1950855656 -> j268662774;
	j872922059 [label="……你想要这些吗？",shape=box,color=blue];
		j872922059 -> j1012895663;
		j872922059 -> j3908443876;
		j872922059 -> j1733344927;
	j850358393 [label="+20 Chemistry",color=orange];
		j850358393 -> j2288358175;
	j966941983 [label="随时随地都有光！摆脱对天际大灯的依赖！",shape=box,color=blue];
		j966941983 -> j314302482;
	j268662774 [label="想象一下，你是一个自命不凡的牧师，乘船远渡重洋，前往新大陆向“野蛮人”传播太阳神的福音，却发现他们不仅早已知晓太阳神的一切，而且太阳神的亲生儿子正统治着他们。",shape=box,color=blue];
		j268662774 -> j3695910721;
	j1012895663 [label="我真不知道。",shape=box,color=red];
		j1012895663 -> j767366797;
	j3908443876 [label="老实说，不想。",shape=box,color=red];
		j3908443876 -> j4235396803;
	j1733344927 [label="是的，我想。",shape=box,color=red];
		j1733344927 -> j2214464305;
	j2288358175 [label="好的。无论你今天做什么，和谁在一起，不管是和我、亚瑟还是我们中的任何一个人……都要注意安全。",shape=box,color=blue];
		j2288358175 -> j3435349021;
	j314302482 [label="看看我们现在。光无处不在。我们已经让它变得廉价了。",shape=box,color=blue];
		j314302482 -> j1736695589;
	j3695910721 [label="你只能夹着尾巴逃回家，或者当场顺服。",shape=box,color=blue];
		j3695910721 -> j1656477487;
		j3695910721 -> j2787014798;
	j767366797 [label="很公平。我尊重。",shape=box,color=blue];
		j767366797 -> j2991126293;
	j4235396803 [label="我很高兴。如果你觉得你的生活本可以比现在更糟糕，那我想我们有值得庆祝的事情吧？",shape=box,color=blue];
		j4235396803 -> j2991126293;
	j2214464305 [label="我觉得我理解。你错过了很多东西，对吧？",shape=box,color=blue];
		j2214464305 -> j2991126293;
	j3435349021 [label="Check boolean EleanorDating",color=orange];
		j3435349021 -> j590475229 [label=true,color=green];
		j3435349021 -> j3434717612 [label=false,color=brown];
	j1656477487 [label="你真的认为神是真实存在的吗？还是说，你只是害怕他们可能存在的想法？",shape=box,color=red];
		j1656477487 -> j1813964172;
	j2787014798 [label="好的。所以你的意思是：如果过去的人一直都是对的，那该怎么办？",shape=box,color=red];
		j2787014798 -> j1813964172;
	j2991126293 [label="Check boolean EleanorDating",color=orange];
		j2991126293 -> j226869246 [label=true,color=green];
		j2991126293 -> j2664460194 [label=false,color=brown];
	j590475229 [label="我爱你。任何试图阻碍这份爱的神，都最好向神之上的见鬼东西祈祷去吧。",shape=box,color=blue];
		j590475229 -> "Chat ends.";
	j3434717612 [label="你是我亲爱的朋友。任何试图将你从我身边夺走的神，都将发现其现实将面临严峻考验。",shape=box,color=blue];
		j3434717612 -> "Chat ends.";
	j1813964172 [label="这么说吧，我以前对无聊的物质现实比现在自信得多。",shape=box,color=blue];
		j1813964172 -> j3607170239;
	j226869246 [label="+20 Chemistry",color=orange];
		j226869246 -> j1391014020;
	j2664460194 [label="+20 Chemistry",color=orange];
		j2664460194 -> j173096516;
	j3607170239 [label="曾经充满信心的地方，如今只剩下一个漂泊者形状的空洞。",shape=box,color=blue];
		j3607170239 -> j1016890128;
	j1391014020 [label="我们都有自己的伤疤，亲爱的。 ",shape=box,color=blue];
		j1391014020 -> "Chat ends.";
	j173096516 [label="我们都有自己的伤疤，我的朋友。",shape=box,color=blue];
		j173096516 -> "Chat ends.";
	j1016890128 [label="+20 Chemistry",color=orange];
		j1016890128 -> j2132072138;
	j2132072138 [label="说实话？我真的不怀念它。偶尔被各种可能性吓一跳也挺不错的。",shape=box,color=blue];
		j2132072138 -> "Chat ends.";
}