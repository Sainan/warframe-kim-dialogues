digraph {
	2888 [label="EleanorRank6Convo3 begins.",color=orange];
		2888 -> 2889;
	2889 [label="我不知道你是否注意到，发生了一件超级奇妙的事情。",shape=box,color=blue];
		2889 -> 2890;
	2890 [label="亚瑟又开始唱歌了。谢天谢地。",shape=box,color=blue];
		2890 -> 2891;
		2890 -> 2892;
		2890 -> 2893;
	2891 [label="他之前为什么不唱了？",shape=box,color=red];
		2891 -> 2894;
	2892 [label="我不是他的粉丝，不过要是能让他开心的话我愿意做他的听众……",shape=box,color=red];
		2892 -> 2895;
	2893 [label="我很高兴。他唱得真好。",shape=box,color=red];
		2893 -> 2896;
	2894 [label="赛前焦虑症。就这么简单。",shape=box,color=blue];
		2894 -> 2897;
	2895 [label="您情商还真是高啊。",shape=box,color=blue];
		2895 -> 2898;
	2896 [label="是吧？",shape=box,color=blue];
		2896 -> 2899;
	2897 [label="很难相信像亚瑟这么勇敢的人会害怕成这样。",shape=box,color=red];
		2897 -> 2900;
	2898 [label="能得到您的关心可真是太荣幸了呢。",shape=box,color=blue];
		2898 -> 2901;
	2899 [label="当我想到要让他站在一群人面前唱歌需要付出多大的努力时……",shape=box,color=blue];
		2899 -> 2902;
	2900 [label="他护甲裂了？",shape=box,color=red];
		2900 -> 2903;
	2901 [label="尤其他放弃唱歌是有原因的，而这些原因你不可能知道。",shape=box,color=blue];
		2901 -> 2904;
		2901 -> 2905;
	2902 [label="……我是说，那是他第一次真正地失去了前进的勇气。",shape=box,color=blue];
		2902 -> 2906;
	2903 [label="是名字的问题。问题就出在这。",shape=box,color=blue];
		2903 -> 2907;
	2904 [label="是因为精神支持不够？",shape=box,color=red];
		2904 -> 2908;
	2905 [label="太多观众给差评了？",shape=box,color=red];
		2905 -> 2908;
	2906 [label="八十年代的“冬至颂歌音乐会”。想象一下，我们的小男孩穿着短裤，独唱《晨露多晶莹》。",shape=box,color=blue];
		2906 -> 2909;
		2906 -> 2910;
	2907 [label="“哦，你名字的意思是夜莺对吗，那就给我们唱首歌吧”",shape=box,color=blue];
		2907 -> 2911;
	2908 [label="同样的笑话听得太多了，更像是这样。",shape=box,color=blue];
		2908 -> 2903;
	2909 [label="场面太壮观了。",shape=box,color=red];
		2909 -> 2912;
	2910 [label="我不知道那个。",shape=box,color=red];
		2910 -> 2913;
	2911 [label="我们一生中遇到过不同的混蛋，却都说着同一套台词。现在维克多也变成这样了。 ",shape=box,color=blue];
		2911 -> 2914;
	2912 [label="他对此非常认真。连续几周的练习之后，在那天晚上，他打了退堂鼓。躲在后台，不肯登场。",shape=box,color=blue];
		2912 -> 2915;
		2912 -> 2897;
	2913 [label="好吧。我想唱给你听，但我不知道唱出来会是什么声音。",shape=box,color=blue];
		2913 -> 2916;
	2914 [label="+5 Chemistry",color=orange];
		2914 -> 2917;
	2915 [label="你是怎么说服他的？",shape=box,color=red];
		2915 -> 2918;
	2916 [label="傻叉科腐者。我之前给碧唱过生日快乐歌，听起来就像只被卷进碎纸机的牛蛙。",shape=box,color=blue];
		2916 -> 2919;
	2917 [label="说实话，我为亚瑟有勇气唱歌而骄傲。",shape=box,color=blue];
		2917 -> 2920;
	2918 [label="我直接踢了他屁股一脚。我并不以此为荣。但确实需要这么做。",shape=box,color=blue];
		2918 -> 2921;
	2919 [label="抱歉。不能再唱歌了，一定很难过。",shape=box,color=red];
		2919 -> 2922;
	2920 [label="Chat ends.",color=orange];
	2921 [label="问题是，他做这些练习并不是为了我们的父母，也不是为了让亨肖太太高兴。 ",shape=box,color=blue];
		2921 -> 2923;
	2922 [label="哦，也没什么损失。反正我也不会唱歌。",shape=box,color=blue];
		2922 -> 2924;
	2923 [label="他唱歌是因为他热爱唱歌。但当聚光灯照在他身上时，他就沉默了。",shape=box,color=blue];
		2923 -> 2925;
		2923 -> 2900;
	2924 [label="我离歌手最接近的一次是在卧室里大声喊着浪炮乐队的歌词，因为我想加入曼迪·杰利科的乐队，因为我喜欢她。 ",shape=box,color=blue];
		2924 -> 2926;
	2925 [label="也许他只需要记住他有多喜欢做这件事。",shape=box,color=red];
		2925 -> 2927;
	2926 [label="然后我爸来砸门，威胁我说，如果他再听到这些脏话，就用消毒剂把我的嘴洗干净。",shape=box,color=blue];
		2926 -> 2928;
	2927 [label="亚瑟最快乐的时候，就是他能忘掉亚瑟的时候。当他能让自己的灵魂得到安息，只做自己的时候。",shape=box,color=blue];
		2927 -> 2929;
	2928 [label="（我不知道你们那里是否有 “朋克”，但不会唱歌与其说是一种障碍，倒不如说是一种优势。）",shape=box,color=blue];
		2928 -> 2930;
		2928 -> 2931;
	2929 [label="啤酒能帮他。",shape=box,color=blue];
		2929 -> 2932;
	2930 [label="我们没有朋克，但我们有管道乐。",shape=box,color=red];
		2930 -> 2933;
	2931 [label="这乐队后来怎么样了？",shape=box,color=red];
		2931 -> 2934;
	2932 [label="而且，如果他能选的话，维利米尔的表现确实很像亚瑟心目中的父亲形象。",shape=box,color=blue];
		2932 -> 2935;
		2932 -> 2936;
	2933 [label="你怎么还会卖关子了。",shape=box,color=blue];
		2933 -> 2937;
	2934 [label="他们甚至连“在当地酒馆进行可怜的演出 ”的阶段都没到。",shape=box,color=blue];
		2934 -> 2938;
	2935 [label="我理解他。",shape=box,color=red];
		2935 -> 2939;
	2936 [label="我觉得维利米尔和米尼娃有点太像你真正的父母了。",shape=box,color=red];
		2936 -> 2940;
	2937 [label="我要你告诉我什么是管道乐。",shape=box,color=blue];
		2937 -> 2941;
	2938 [label="有消息说，曼迪打算向观众吐口水，就这样。巨丢脸。",shape=box,color=blue];
		2938 -> 2942;
		2938 -> 2943;
	2939 [label="亚瑟几个月来一直带着那只泰迪熊到处跑。现在维利米尔出现了。仿佛命运感知到亚瑟的生命中有一个熊形的缺口……",shape=box,color=blue];
		2939 -> 2944;
	2940 [label="是啊。也许拌嘴让他有了家的感觉。 ",shape=box,color=blue];
		2940 -> 2945;
	2941 [label="因为这听着就像在拉德斯顿大楼里用小密封袋装着卖的东西。",shape=box,color=blue];
		2941 -> 2946;
		2941 -> 2947;
	2942 [label="谁会介意一点唾沫呢？",shape=box,color=red];
		2942 -> 2948;
	2943 [label="吐口水？这听着像科技细胞终幕者对美好夜晚的理解。",shape=box,color=red];
		2943 -> 2949;
	2944 [label="+5 Chemistry",color=orange];
		2944 -> 2950;
	2945 [label="+5 Chemistry",color=orange];
		2945 -> 2951;
	2946 [label="这就像音乐，只不过你是通过敲击管道来演奏的。还有通风口。还有 Corpus 的头盔。还有其他任何你能找到的东西，真的。 ",shape=box,color=red];
		2946 -> 2952;
	2947 [label="就是指毫无意义的噪音。只有通风小子才喜欢。",shape=box,color=red];
		2947 -> 2953;
	2948 [label="+5 Chemistry",color=orange];
		2948 -> 2954;
	2949 [label="那是个不同的时代。那时的朋克才是真正的朋克。 ",shape=box,color=blue];
		2949 -> 2955;
	2950 [label="……抱歉。我无权妄加揣测。我只是高兴他开心而已。",shape=box,color=blue];
		2950 -> 3311;
	2951 [label="让你觉得想家的事物还挺奇怪的，不是吗？",shape=box,color=blue];
		2951 -> 2956;
	2952 [label="这就是通风小子的风格。",shape=box,color=red];
		2952 -> 2957;
	2953 [label="哈。“毫无意义的噪音”。我以前听人这么说过。",shape=box,color=blue];
		2953 -> 2958;
	2954 [label="我可以告诉你，我绝对不介意。",shape=box,color=blue];
		2954 -> 2955;
	2955 [label="……我只是想“真希望她能看到现在的我”。我觉得她会喜欢这个版本的我。",shape=box,color=blue];
		2955 -> 2959;
	3311 [label="Chat ends.",color=orange];
	2956 [label="Chat ends.",color=orange];
	2957 [label="+5 Chemistry",color=orange];
		2957 -> 2960;
	2958 [label="我不认为有什么是毫无意义的，一切都可以成为一个人青春的背景音乐。",shape=box,color=blue];
		2958 -> 2961;
	2959 [label="天哪，看看我，我都变得多愁善感和怀旧起来了。",shape=box,color=blue];
		2959 -> 2962;
	2960 [label="嗯。听起来像是末日风音乐。如果你有空给我录一些，我想听听。",shape=box,color=blue];
		2960 -> 2963;
	2961 [label="我还是别说了。我都变得多愁善感了。",shape=box,color=blue];
		2961 -> 2964;
	2962 [label="+5 Chemistry",color=orange];
		2962 -> 2965;
	2963 [label="不过，千万不要在商场的扬声器上播放。",shape=box,color=blue];
		2963 -> 2966;
	2964 [label="Chat ends.",color=orange];
	2965 [label="还是回去细聊吧。谢谢你的倾听。",shape=box,color=blue];
		2965 -> 2967;
	2966 [label="Chat ends.",color=orange];
	2967 [label="Chat ends.",color=orange];
}