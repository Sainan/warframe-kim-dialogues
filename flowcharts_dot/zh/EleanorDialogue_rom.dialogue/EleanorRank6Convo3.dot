digraph {
	"EleanorRank6Convo3 begins." [color=orange];
		"EleanorRank6Convo3 begins." -> j2984190871;
	j2984190871 [label="我不知道你是否注意到，发生了一件超级奇妙的事情。",shape=box,color=blue];
		j2984190871 -> j4086273340;
	j4086273340 [label="亚瑟又开始唱歌了。谢天谢地。",shape=box,color=blue];
		j4086273340 -> j2550350347;
		j4086273340 -> j3716241722;
		j4086273340 -> j567024010;
	j2550350347 [label="他之前为什么不唱了？",shape=box,color=red];
		j2550350347 -> j1350503892;
	j3716241722 [label="我不是他的粉丝，不过要是能让他开心的话我愿意做他的听众……",shape=box,color=red];
		j3716241722 -> j178440008;
	j567024010 [label="我很高兴。他唱得真好。",shape=box,color=red];
		j567024010 -> j1516315518;
	j1350503892 [label="赛前焦虑症。就这么简单。",shape=box,color=blue];
		j1350503892 -> j3637686116;
	j178440008 [label="您情商还真是高啊。",shape=box,color=blue];
		j178440008 -> j2277453704;
	j1516315518 [label="是吧？",shape=box,color=blue];
		j1516315518 -> j1274879721;
	j3637686116 [label="很难相信像亚瑟这么勇敢的人会害怕成这样。",shape=box,color=red];
		j3637686116 -> j2398015720;
	j2277453704 [label="能得到您的关心可真是太荣幸了呢。",shape=box,color=blue];
		j2277453704 -> j374574080;
	j1274879721 [label="当我想到要让他站在一群人面前唱歌需要付出多大的努力时……",shape=box,color=blue];
		j1274879721 -> j2934338463;
	j2398015720 [label="他护甲裂了？",shape=box,color=red];
		j2398015720 -> j1092779073;
	j374574080 [label="尤其他放弃唱歌是有原因的，而这些原因你不可能知道。",shape=box,color=blue];
		j374574080 -> j4085348646;
		j374574080 -> j2840417632;
	j2934338463 [label="……我是说，那是他第一次真正地失去了前进的勇气。",shape=box,color=blue];
		j2934338463 -> j317861184;
	j1092779073 [label="是名字的问题。问题就出在这。",shape=box,color=blue];
		j1092779073 -> j3171905796;
	j4085348646 [label="是因为精神支持不够？",shape=box,color=red];
		j4085348646 -> j2259343764;
	j2840417632 [label="太多观众给差评了？",shape=box,color=red];
		j2840417632 -> j2259343764;
	j317861184 [label="八十年代的“冬至颂歌音乐会”。想象一下，我们的小男孩穿着短裤，独唱《晨露多晶莹》。",shape=box,color=blue];
		j317861184 -> j3354691316;
		j317861184 -> j4036565013;
	j3171905796 [label="“哦，你名字的意思是夜莺对吗，那就给我们唱首歌吧”",shape=box,color=blue];
		j3171905796 -> j4076759560;
	j2259343764 [label="同样的笑话听得太多了，更像是这样。",shape=box,color=blue];
		j2259343764 -> j1092779073;
	j3354691316 [label="场面太壮观了。",shape=box,color=red];
		j3354691316 -> j2296660325;
	j4036565013 [label="我不知道那个。",shape=box,color=red];
		j4036565013 -> j1186717788;
	j4076759560 [label="我们一生中遇到过不同的混蛋，却都说着同一套台词。现在维克多也变成这样了。 ",shape=box,color=blue];
		j4076759560 -> j3821353471;
	j2296660325 [label="他对此非常认真。连续几周的练习之后，在那天晚上，他打了退堂鼓。躲在后台，不肯登场。",shape=box,color=blue];
		j2296660325 -> j1797636838;
		j2296660325 -> j3637686116;
	j1186717788 [label="好吧。我想唱给你听，但我不知道唱出来会是什么声音。",shape=box,color=blue];
		j1186717788 -> j476973698;
	j3821353471 [label="+5 Chemistry",color=orange];
		j3821353471 -> j432422673;
	j1797636838 [label="你是怎么说服他的？",shape=box,color=red];
		j1797636838 -> j108955262;
	j476973698 [label="傻叉科腐者。我之前给碧唱过生日快乐歌，听起来就像只被卷进碎纸机的牛蛙。",shape=box,color=blue];
		j476973698 -> j31611301;
	j432422673 [label="说实话，我为亚瑟有勇气唱歌而骄傲。",shape=box,color=blue];
		j432422673 -> "Chat ends.";
	j108955262 [label="我直接踢了他屁股一脚。我并不以此为荣。但确实需要这么做。",shape=box,color=blue];
		j108955262 -> j2413711152;
	j31611301 [label="抱歉。不能再唱歌了，一定很难过。",shape=box,color=red];
		j31611301 -> j705860731;
	"Chat ends." [color=orange];
	j2413711152 [label="问题是，他做这些练习并不是为了我们的父母，也不是为了让亨肖太太高兴。 ",shape=box,color=blue];
		j2413711152 -> j2237875196;
	j705860731 [label="哦，也没什么损失。反正我也不会唱歌。",shape=box,color=blue];
		j705860731 -> j2893956558;
	j2237875196 [label="他唱歌是因为他热爱唱歌。但当聚光灯照在他身上时，他就沉默了。",shape=box,color=blue];
		j2237875196 -> j2756115691;
		j2237875196 -> j2398015720;
	j2893956558 [label="我离歌手最接近的一次是在卧室里大声喊着浪炮乐队的歌词，因为我想加入曼迪·杰利科的乐队，因为我喜欢她。 ",shape=box,color=blue];
		j2893956558 -> j2255628262;
	j2756115691 [label="也许他只需要记住他有多喜欢做这件事。",shape=box,color=red];
		j2756115691 -> j2202022704;
	j2255628262 [label="然后我爸来砸门，威胁我说，如果他再听到这些脏话，就用消毒剂把我的嘴洗干净。",shape=box,color=blue];
		j2255628262 -> j3770642350;
	j2202022704 [label="亚瑟最快乐的时候，就是他能忘掉亚瑟的时候。当他能让自己的灵魂得到安息，只做自己的时候。",shape=box,color=blue];
		j2202022704 -> j1099079610;
	j3770642350 [label="（我不知道你们那里是否有 “朋克”，但不会唱歌与其说是一种障碍，倒不如说是一种优势。）",shape=box,color=blue];
		j3770642350 -> j1830974358;
		j3770642350 -> j427703603;
	j1099079610 [label="啤酒能帮他。",shape=box,color=blue];
		j1099079610 -> j1251549068;
	j1830974358 [label="我们没有朋克，但我们有管道乐。",shape=box,color=red];
		j1830974358 -> j158430698;
	j427703603 [label="这乐队后来怎么样了？",shape=box,color=red];
		j427703603 -> j440989284;
	j1251549068 [label="而且，如果他能选的话，维利米尔的表现确实很像亚瑟心目中的父亲形象。",shape=box,color=blue];
		j1251549068 -> j3467437665;
		j1251549068 -> j3776793723;
	j158430698 [label="你怎么还会卖关子了。",shape=box,color=blue];
		j158430698 -> j2978239557;
	j440989284 [label="他们甚至连“在当地酒馆进行可怜的演出 ”的阶段都没到。",shape=box,color=blue];
		j440989284 -> j1398247122;
	j3467437665 [label="我理解他。",shape=box,color=red];
		j3467437665 -> j2885020459;
	j3776793723 [label="我觉得维利米尔和米尼娃有点太像你真正的父母了。",shape=box,color=red];
		j3776793723 -> j51193009;
	j2978239557 [label="我要你告诉我什么是管道乐。",shape=box,color=blue];
		j2978239557 -> j3246910305;
	j1398247122 [label="有消息说，曼迪打算向观众吐口水，就这样。巨丢脸。",shape=box,color=blue];
		j1398247122 -> j2631960345;
		j1398247122 -> j2535078363;
	j2885020459 [label="亚瑟几个月来一直带着那只泰迪熊到处跑。现在维利米尔出现了。仿佛命运感知到亚瑟的生命中有一个熊形的缺口……",shape=box,color=blue];
		j2885020459 -> j972373218;
	j51193009 [label="是啊。也许拌嘴让他有了家的感觉。 ",shape=box,color=blue];
		j51193009 -> j4268841611;
	j3246910305 [label="因为这听着就像在拉德斯顿大楼里用小密封袋装着卖的东西。",shape=box,color=blue];
		j3246910305 -> j1157935320;
		j3246910305 -> j1063426070;
	j2631960345 [label="谁会介意一点唾沫呢？",shape=box,color=red];
		j2631960345 -> j2598539159;
	j2535078363 [label="吐口水？这听着像科技细胞终幕者对美好夜晚的理解。",shape=box,color=red];
		j2535078363 -> j3176773844;
	j972373218 [label="+5 Chemistry",color=orange];
		j972373218 -> j1238352514;
	j4268841611 [label="+5 Chemistry",color=orange];
		j4268841611 -> j567998284;
	j1157935320 [label="这就像音乐，只不过你是通过敲击管道来演奏的。还有通风口。还有 Corpus 的头盔。还有其他任何你能找到的东西，真的。 ",shape=box,color=red];
		j1157935320 -> j2933056231;
	j1063426070 [label="就是指毫无意义的噪音。只有通风小子才喜欢。",shape=box,color=red];
		j1063426070 -> j1046315125;
	j2598539159 [label="+5 Chemistry",color=orange];
		j2598539159 -> j1988913946;
	j3176773844 [label="那是个不同的时代。那时的朋克才是真正的朋克。 ",shape=box,color=blue];
		j3176773844 -> j435893589;
	j1238352514 [label="……抱歉。我无权妄加揣测。我只是高兴他开心而已。",shape=box,color=blue];
		j1238352514 -> "Chat ends.";
	j567998284 [label="让你觉得想家的事物还挺奇怪的，不是吗？",shape=box,color=blue];
		j567998284 -> "Chat ends.";
	j2933056231 [label="这就是通风小子的风格。",shape=box,color=red];
		j2933056231 -> j1999306350;
	j1046315125 [label="哈。“毫无意义的噪音”。我以前听人这么说过。",shape=box,color=blue];
		j1046315125 -> j3977966257;
	j1988913946 [label="我可以告诉你，我绝对不介意。",shape=box,color=blue];
		j1988913946 -> j435893589;
	j435893589 [label="……我只是想“真希望她能看到现在的我”。我觉得她会喜欢这个版本的我。",shape=box,color=blue];
		j435893589 -> j1833517281;
	j1999306350 [label="+5 Chemistry",color=orange];
		j1999306350 -> j1635164570;
	j3977966257 [label="我不认为有什么是毫无意义的，一切都可以成为一个人青春的背景音乐。",shape=box,color=blue];
		j3977966257 -> j1657711221;
	j1833517281 [label="天哪，看看我，我都变得多愁善感和怀旧起来了。",shape=box,color=blue];
		j1833517281 -> j1847808116;
	j1635164570 [label="嗯。听起来像是末日风音乐。如果你有空给我录一些，我想听听。",shape=box,color=blue];
		j1635164570 -> j3097471541;
	j1657711221 [label="我还是别说了。我都变得多愁善感了。",shape=box,color=blue];
		j1657711221 -> "Chat ends.";
	j1847808116 [label="+5 Chemistry",color=orange];
		j1847808116 -> j3023222855;
	j3097471541 [label="不过，千万不要在商场的扬声器上播放。",shape=box,color=blue];
		j3097471541 -> "Chat ends.";
	j3023222855 [label="还是回去细聊吧。谢谢你的倾听。",shape=box,color=blue];
		j3023222855 -> "Chat ends.";
}