digraph {
	3285 [label="EleanorRank6Convo10 begins.",color=orange];
		3285 -> 3286;
	3286 [label="所以我在想：一年会在十二月底的时候又像以往一样循环，虽然它会让人感觉像是崭新的一年，但实际上并非如此",shape=box,color=blue];
		3286 -> 3287;
	3287 [label="虽然我认为自己知道这种情况之前发生过多少次，但我实际上并不确定，因为我可能记不清了",shape=box,color=blue];
		3287 -> 3288;
	3288 [label="如果我记得的第一次循环实际上是第 15042 次循环呢？",shape=box,color=blue];
		3288 -> 3289;
	3289 [label="然后我想，算了，干脆彻底放纵，想做什么就做什么，因为你总是可以随时猛砸地板然后一切重新开始",shape=box,color=blue];
		3289 -> 3290;
	3290 [label="但后来我又想到，不行，等等，万一这次真的成功了呢？万一我们终于能从 1999 年顺利进入 2000 年呢？",shape=box,color=blue];
		3290 -> 3291;
	3291 [label="我不想在有最后决定性的 1999 年中的一个循环里把自己搞得一团糟。不然到时候我就很危险了。",shape=box,color=blue];
		3291 -> 3292;
	3292 [label="套用那个老掉牙的比喻来说，总有一天会迎来春至日，而非无尽的寒冬",shape=box,color=blue];
		3292 -> 3293;
