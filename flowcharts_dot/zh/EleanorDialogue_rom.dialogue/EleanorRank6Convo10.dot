digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"EleanorRank6Convo10 begins." [color=orange];
		"EleanorRank6Convo10 begins." -> j3238938560;
	j3238938560 [label="所以我在想：一年会在十二月底的时候又像以往一样循环，虽然它会让人感觉像是崭新的一年，但实际上并非如此",shape=box,color=blue];
		j3238938560 -> j906253335;
	j906253335 [label="虽然我认为自己知道这种情况之前发生过多少次，但我实际上并不确定，因为我可能记不清了",shape=box,color=blue];
		j906253335 -> j2062988197;
	j2062988197 [label="如果我记得的第一次循环实际上是第 15042 次循环呢？",shape=box,color=blue];
		j2062988197 -> j394239031;
	j394239031 [label="然后我想，算了，干脆彻底放纵，想做什么就做什么，因为你总是可以随时猛砸地板然后一切重新开始",shape=box,color=blue];
		j394239031 -> j3880206429;
	j3880206429 [label="但后来我又想到，不行，等等，万一这次真的成功了呢？万一我们终于能从 1999 年顺利进入 2000 年呢？",shape=box,color=blue];
		j3880206429 -> j3121497510;
	j3121497510 [label="我不想在有最后决定性的 1999 年中的一个循环里把自己搞得一团糟。不然到时候我就很危险了。",shape=box,color=blue];
		j3121497510 -> j1306871801;
	j1306871801 [label="套用那个老掉牙的比喻来说，总有一天会迎来春至日，而非无尽的寒冬",shape=box,color=blue];
		j1306871801 -> j420725480;
	j420725480 [label="Check boolean EleanorDating",color=orange];
		j420725480 -> j688441141 [label=true,color=green];
		j420725480 -> j4084444340 [label=false,color=brown];
	j688441141 [label="在那之前你和我只能互相取暖了。x",shape=box,color=blue];
		j688441141 -> "Chat ends.";
	j4084444340 [label="在那之前，我们只要互相取暖就好了。",shape=box,color=blue];
		j4084444340 -> "Chat ends.";
	"Chat ends." [color=orange];
}