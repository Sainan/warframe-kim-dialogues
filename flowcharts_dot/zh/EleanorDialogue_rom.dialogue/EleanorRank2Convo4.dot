digraph {
	553 [label="EleanorRank2Convo4 begins.",color=orange];
		553 -> 554;
	554 [label="你觉得我们死后会发生什么？",shape=box,color=blue];
		554 -> 555;
		554 -> 556;
		554 -> 557;
		554 -> 558;
	555 [label="我最近还不错，埃莉诺，谢谢你关心！你呢？",shape=box,color=red];
		555 -> 560;
	556 [label="……你还好吗？",shape=box,color=red];
		556 -> 561;
	557 [label="我已经见识过足够多的事情，知道人格是可以逾越死亡的。",shape=box,color=red];
		557 -> 562;
	558 [label="别再聊愚蠢的话题了。[结束]",shape=box,color=red];
		558 -> 559;
	560 [label="呵。",shape=box,color=blue];
		560 -> 563;
	561 [label="不好。",shape=box,color=blue];
		561 -> 564;
	562 [label="继续？",shape=box,color=blue];
		562 -> 565;
	559 [label="Chat ends.",color=orange];
	563 [label="听着，如果你愿意的话，我们可以聊聊天气。",shape=box,color=blue];
		563 -> 566;
	564 [label="但我并不是在以任何悲观的方式考虑死亡，如果你担心这点的话。我还是希望自己能活很长时间的。",shape=box,color=blue];
		564 -> 567;
	565 [label="（想象一下我躺在沙发上，双手托着下巴，抬头看着石榴 2 代，满怀期待地等着看你接下来会打什么。）",shape=box,color=blue];
		565 -> 572;
		565 -> 573;
		565 -> 574;
		565 -> 575;
	566 [label="或者，既然我们已经在商场了，咱们可以去喝点拿铁，然后吐槽一下莱蒂有多么讨厌，她把所有那些粉色和黄色的药丸都留给了自己，而不是像她应该做的那样分给我们，我说得对吧？",shape=box,color=blue];
		566 -> 568;
	567 [label="只是我需要独自度过太多漫长而阴暗的时光，也有无数事情可以思考，而此时我可怜的小细胞正像面包块一样，在我如今变成女巫汤的血液里翻滚扭曲。",shape=box,color=blue];
		567 -> 572;
		567 -> 573;
		567 -> 574;
		567 -> 575;
	572 [label="在我们那边，我们有“中枢”。那些曾经是人类的玻璃方块，现在依然能表达出他们的个性。大多数时候。",shape=box,color=red];
		572 -> 576;
	573 [label="奥罗金人过去常常将他们的意识转移到偷来的身体中，这样他们就可以永生。",shape=box,color=red];
		573 -> 577;
	574 [label="所有 Tenno 都可以使用“传识”来操控战甲。我们不受物理形态的限制。因此，想象我们的存在会随着身体的死亡而结束是没有意义的。",shape=box,color=red];
		574 -> 578;
	575 [label="埃莉诺，我真的不想助长你的这种痴迷。",shape=box,color=red];
		575 -> 579;
	568 [label="（打出这些字让我感觉自己都脏了。抱歉。）",shape=box,color=blue];
		568 -> 569;
	576 [label="Check boolean EleanorOrigin",color=orange];
		576 -> 580 [label=true,color=green];
		576 -> 581 [label=false,color=brown];
	577 [label="Check boolean EleanorEntrati",color=orange];
		577 -> 582 [label=true,color=green];
		577 -> 583 [label=false,color=brown];
	578 [label="Check boolean EleanorVoidLove",color=orange];
		578 -> 584 [label=true,color=green];
		578 -> 585 [label=false,color=brown];
	579 [label="痴迷？",shape=box,color=blue];
		579 -> 586;
	569 [label="我知道我跳过了很多闲聊直接切入正题，但说实话，这都是你的错，谁让你太有趣呢。",shape=box,color=blue];
		569 -> 570;
	580 [label="我看到了。我不认为被你们奥罗金视为惩罚的存在，是一种名副其实的来生。",shape=box,color=blue];
		580 -> 581;
	581 [label="呸。我宁愿体面地死去。",shape=box,color=blue];
		581 -> 588;
	582 [label="在这个星球上所有令人恶心的事物中，我认为这些奥罗金人是最糟糕的。",shape=box,color=blue];
		582 -> 583;
	583 [label="我想知道现在去阻止他们的存在是否已经太迟了。也许我只需要找到正确的蝴蝶去踩死。",shape=box,color=blue];
		583 -> 589;
	584 [label="更多的虚空魔法。我对虚空了解得越多，就越想去那里。也许那才是我的归属。远在地图的边缘。那里有龙。你们 Tenno 的血液里流淌着虚空。真是幸运的家伙。",shape=box,color=blue];
		584 -> 585;
	585 [label="你们那一群人还好，但我们这些普通人怎么办？我们不可能都是 Tenno，对吧？",shape=box,color=blue];
		585 -> 590;
	586 [label="怎么，就好比你是一个远离家乡的倒霉外星流浪儿，而我是一个痴迷于把你解剖，以了解你的运作原理的科学家吗？",shape=box,color=blue];
		586 -> 587;
	570 [label="一个穿越时空的半神突然闯入我的生活，我的生活已经够荒谬的了，而我还得保持社交礼仪的矜持吗？",shape=box,color=blue];
		570 -> 571;
	588 [label="埃莉诺，别那么刻薄。中枢也是人。",shape=box,color=red];
		588 -> 595;
	589 [label="想象一下。一群狂妄自大的混蛋从此消失。唯一的缺点是我们听不到他们的尖叫声。",shape=box,color=blue];
		589 -> 597;
	590 [label="我只是在说我认为死后生存是有可能的。",shape=box,color=red];
		590 -> 599;
	587 [label="抱歉。我以为我们彼此都很有趣。我以为这些小对话是我们相互了解的方式。",shape=box,color=blue];
		587 -> 591;
	571 [label="你可以给我旁人无法提供的观点。所以请你。在我开始抓家具之前。和我聊聊。",shape=box,color=blue];
		571 -> 572;
		571 -> 573;
		571 -> 574;
		571 -> 575;
	595 [label="如果我理解错了，请纠正我，但是……你所说的听起来不像是一个人。它更像是一个被编程成以为自己是那个人类的电脑。对吗？",shape=box,color=blue];
		595 -> 596;
	597 [label="不过……",shape=box,color=blue];
		597 -> 598;
	599 [label="是的，是的，我知道你的意思。迁就我一下。",shape=box,color=blue];
		599 -> 600;
	591 [label="但不。显然我和那些整日只想着自己“痴迷”兹克的女粉丝没什么两样。",shape=box,color=blue];
		591 -> 592;
	596 [label="有点那个意思。殁世械灵就是洛德的中枢复制品，洛德仍然活着。但即使中枢不是原来的那个人，他们仍然是人类。",shape=box,color=red];
		596 -> 601;
	598 [label="糟糕。",shape=box,color=blue];
		598 -> 602;
	600 [label="虚空可能是灵魂存在的地方。这是我们的意思吗？是不是有人撬开了灵界，现在你们用它来为你们一半的设备供电？",shape=box,color=blue];
		600 -> 605;
	592 [label="陛下，您已经不再在双衍王境了。这里没人在乎你。",shape=box,color=blue];
		592 -> 593;
	601 [label="嗯。抱歉，但这不是一回事。我们讨论的不是人格，而是连续性。",shape=box,color=blue];
		601 -> 806;
	602 [label="如果我抹去他们的存在，我也会抹去你的存在，对吗？因为你的存在依赖于他们的存在。",shape=box,color=blue];
		602 -> 603;
		602 -> 604;
	605 [label="不只是某个人。是英择谛。他是第一个进入虚空的人。",shape=box,color=red];
		605 -> 606;
	593 [label="别自以为是了。",shape=box,color=blue];
		593 -> 594;
	806 [label="我可以让阿米尔重新编程一个夏洛特聊天娃娃，让它说出一些埃莉诺的经典语录，然后他可以在我死后用它来吓唬莱蒂，但那并不是我。",shape=box,color=blue];
		806 -> 807;
	603 [label="哦，正是我们需要的。更多人来扰乱时间线。",shape=box,color=red];
		603 -> 610;
	604 [label="或者你可能只是创造了一个新的历史分支，然后沿着那条路走下去。",shape=box,color=red];
		604 -> 611;
	606 [label="我早该知道那个两面派的混蛋在这件事里也有份。",shape=box,color=blue];
		606 -> 608;
	594 [label="Chat ends.",color=orange];
	807 [label="除非我能以某种方式影响它。让我去思考一下这个问题。",shape=box,color=blue];
		807 -> 622;
		807 -> 623;
	610 [label="哇哦。",shape=box,color=blue];
		610 -> 612;
	611 [label="别提了。如果你这样做，我们可能得讨论一整周。",shape=box,color=blue];
		611 -> 613;
	608 [label="有没有人在虚空中遇到过死去的人？或者虚空曾经变成过某个死去的人的形态？抱歉问这个，但我真的需要知道。",shape=box,color=blue];
		608 -> 609;
	622 [label="如果它看起来像只梭歌，而且叫声也像梭歌，它就是梭歌。那不都一样吗？",shape=box,color=red];
		622 -> 624;
	623 [label="这件事情对你来说真的很重要，对吗？",shape=box,color=red];
		623 -> 625;
	612 [label="我本以为这只是一场有趣的谈话。",shape=box,color=blue];
		612 -> 614;
	613 [label="我们现在还在讨论“肉体死亡后灵魂是否仍然存在”的问题。还没到“自由意志是否真的存在”的讨论呢。",shape=box,color=blue];
		613 -> 615;
	609 [label="我认识一些死去的人是那样的。那些坚守者。",shape=box,color=red];
		609 -> 617;
	624 [label="嗯。不。我不这么认为。",shape=box,color=blue];
		624 -> 640;
	625 [label="噢，你注意到了？",shape=box,color=blue];
		625 -> 645;
	614 [label="我要澄清一下，我并没有真正的计划去干涉未来。我只是",shape=box,color=blue];
		614 -> 616;
	615 [label="（这就是你的下场，埃莉诺，她对自己说。这就是向有趣的人提出深度问题的下场。）",shape=box,color=blue];
		615 -> 622;
		615 -> 623;
	617 [label="Update boolean EleanorHoldfasts1",color=orange];
		617 -> 626;
	640 [label="如果虚空复制了我，我会因为不知道哪个是真正的我而失眠。",shape=box,color=blue];
		640 -> 641;
	645 [label="是的。这对我很重要。",shape=box,color=blue];
		645 -> 646;
	616 [label="算了，这都不重要了。",shape=box,color=blue];
		616 -> 618;
	626 [label="什么？",shape=box,color=blue];
		626 -> 627;
	641 [label="因为如果它可以在你死后做到这一点，那么它肯定也可以在你活着时做到这一点。",shape=box,color=blue];
		641 -> 642;
	646 [label="恐怕比我表现出来的还要重要。",shape=box,color=blue];
		646 -> 647;
	618 [label="我本来想说的是，我多么不希望你消失。我甚至宁愿让未来的人们继续忍受暴君的压迫，也不愿改变任何事情。",shape=box,color=blue];
		618 -> 619;
	627 [label="你认识一些死去的人？是社交意义上的吗？",shape=box,color=blue];
		627 -> 628;
	642 [label="……我对这个走向感到不太舒服。抱歉。以后再聊。也许吧。",shape=box,color=blue];
		642 -> 643;
	647 [label="我就说我有理由希望我们的一部分能超越肉体的死亡吧。我知道不止我一个人有这个想法。",shape=box,color=blue];
		647 -> 648;
	619 [label="我开了个糟糕的玩笑。抱歉。不会再发生了。",shape=box,color=blue];
		619 -> 620;
	628 [label="他们记得自己的死亡？他们真的知道自己已经死了？",shape=box,color=blue];
		628 -> 629;
		628 -> 630;
	643 [label="+10 Chemistry",color=orange];
		643 -> 644;
	648 [label="Update boolean EleanorBereaved",color=orange];
		648 -> 649;
	620 [label="+5 Chemistry",color=orange];
		620 -> 621;
	629 [label="是的。他们曾经是扎里曼号上的军官。那艘迷失在虚空中的殖民飞船。现在他们大概可以算是幽灵了。",shape=box,color=red];
		629 -> 631;
	630 [label="这……很复杂。东西可以进入虚空，但当它们出来时就不太一样了。",shape=box,color=red];
		630 -> 632;
	644 [label="Chat ends.",color=orange];
	649 [label="那你问错人了。我不确定我是否*能*死。",shape=box,color=red];
		649 -> 650;
	621 [label="Chat ends.",color=orange];
	631 [label="我的天，这实在太不可思议了。",shape=box,color=blue];
		631 -> 633;
	632 [label="啊。你是找不到合适的词语吗？还是你不想告诉我全部的故事？当人们试图隐瞒些什么，我会感到紧张。",shape=box,color=blue];
		632 -> 634;
	650 [label="Check boolean EleanorDuviri",color=orange];
		650 -> 651 [label=true,color=green];
		650 -> 652 [label=false,color=brown];
	633 [label="不过……",shape=box,color=blue];
		633 -> 635;
	634 [label="等等。先别回答。我脑子里突然闪过一个念头。我不知道那是不是你的一个不经意的想法，但我的天，这让我觉得很恐怖。",shape=box,color=blue];
		634 -> 636;
	651 [label="对。他们试过了，不是吗？士魂大帝把你弄得像个定期表演一样。我不知道你是怎么挺过那场噩梦并保持理智的。",shape=box,color=blue];
		651 -> 652;
	652 [label="说实话，我也不确定我是否能死。",shape=box,color=blue];
		652 -> 653;
	635 [label="我们怎么知道里面是同一个人？有同样的观点？",shape=box,color=blue];
		635 -> 637;
	636 [label="天使。",shape=box,color=blue];
		636 -> 638;
	653 [label="现在，我的体内有一个由科技细胞组成的委员会，如果他们的家被摧毁了，他们会非常恼火的。",shape=box,color=blue];
		653 -> 654;
	637 [label="如果只是，我不知道，某种虚空克隆体或类似的东西呢？这可能发生吗？虚空会吸收一个人的思想，然后赋予它形态。然后那个形态会认为自己是那个死去的人。",shape=box,color=blue];
		637 -> 622;
		637 -> 623;
	638 [label="天哪，我能听到它们。就像是……空调在房间里开了很久，你已经将它的噪音忽略，然后突然你注意到了它。",shape=box,color=blue];
		638 -> 639;
	654 [label="这也是为什么它们不遗余力地让我变得又大又强壮的原因。",shape=box,color=blue];
		654 -> 655;
	639 [label="为什么我要开始问你这些，该死的",shape=box,color=blue];
		639 -> 668;
	655 [label="这让我不禁好奇，如果我被直接杀死会发生什么。科腐者可以让尸体保持活动并重新利用。我亲眼所见。就像一群白蚁共同操纵一台机器人。",shape=box,color=blue];
		655 -> 656;
	668 [label="好吧。好吧。对。我现在要集中注意力。请留在这里。我在用我的思维筑起一道墙。它正从我和那些天使之间升起。",shape=box,color=blue];
		668 -> 669;
	656 [label="那么……我会变成某种科腐者丧尸吗？如果它让我复活，我还是原来的我吗？还是我只是一个有着我的记忆的科腐者集体意识，并以为自己是我？",shape=box,color=blue];
		656 -> 657;
	669 [label="墙，墙，墙，美丽的墙。",shape=box,color=blue];
		669 -> 670;
	657 [label="我觉得一直纠结这些问题对你的健康不好。",shape=box,color=red];
		657 -> 658;
	670 [label="好了。墙已经建好。现在一切都安静了。我应该让你走了，对吗。",shape=box,color=blue];
		670 -> 671;
	658 [label="我觉得我本身就不健康。所以就这样吧。",shape=box,color=blue];
		658 -> 659;
	671 [label="+10 Chemistry",color=orange];
		671 -> 672;
	659 [label="但是……",shape=box,color=blue];
		659 -> 660;
	672 [label="Chat ends.",color=orange];
	660 [label="我感激你这么关心我，并说出这些话。",shape=box,color=blue];
		660 -> 661;
	661 [label="莱蒂在监控我的身体状况，因为亚瑟需要我随时待命。我不怪她。那是她的工作。",shape=box,color=blue];
		661 -> 662;
	662 [label="但没有人在关心我。",shape=box,color=blue];
		662 -> 663;
	663 [label="至少到现在为止没有。",shape=box,color=blue];
		663 -> 664;
	664 [label="天，你不过是做了件善良的事，而我们已经太久没有单纯地对彼此好过了，以至于我现在要大惊小怪一番。",shape=box,color=blue];
		664 -> 666;
	666 [label="+20 Chemistry",color=orange];
		666 -> 665;
	665 [label="嗯哼。谢谢你。就这样。",shape=box,color=blue];
		665 -> 667;
	667 [label="Chat ends.",color=orange];
}