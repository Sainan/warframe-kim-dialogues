		j3364311394 -> "Chat ends." [label=true,color=green];
		j3364311394 -> j556108045 [label=false,color=brown];
	j3528729371 [label="Check boolean EleanorPolyamorySuccess",color=orange];
		j3528729371 -> j3364311394 [label=true,color=green];
		j3528729371 -> "Chat ends." [label=false,color=brown];
	j556108045 [label="我觉得这件事唯一让我恼火的点，是我先在你脑海里发现了这种想法的存在。",shape=box,color=blue];
		j556108045 -> j2429888828;
	j2429888828 [label="我并不是不知道，你打算礼貌地过来征求我的同意。你好。",shape=box,color=blue];
		j2429888828 -> j2374956311;
	j2374956311 [label="答案是一个撅着嘴，双臂交叉地回答“好，当然可以”，而我却只能坐在这里，忍住不想你去和我在你幻想中瞥见的那个美丽尤物寻欢作乐的样子。",shape=box,color=blue];
		j2374956311 -> j1745202313;
	j1745202313 [label="而现在这些都只存在于——我的——幻想中了，因为我被困在了这个时间和这个地点，我——谢——谢——你！",shape=box,color=blue];
		j1745202313 -> j2327619059;
	j2327619059 [label="对不起。我真的是来征求你同意的。我知道我们之前没讨论过这件事。我只是想确认这一切你都不会介意。",shape=box,color=red];
		j2327619059 -> j1813767170;
	j1813767170 [label="当然没问题！我能在你的心眼里看到他。如果你信任他，我就信任他。",shape=box,color=blue];
		j1813767170 -> j2353702024;
	j2353702024 [label="我只是有点难过，我没机会脚踏几条船。",shape=box,color=blue];
		j2353702024 -> j4181782511;
	j4181782511 [label="+20 Chemistry",color=orange];
		j4181782511 -> j725810214;
	j725810214 [label="但或许我可以通过你来间接体验这种感觉，这倒是个不错的想法。",shape=box,color=blue];
		j725810214 -> j298331240;
	j298331240 [label="Boolean EleanorConsentComplete is now true.",color=orange];
		j298331240 -> "Chat ends.";
}