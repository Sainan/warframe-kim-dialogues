	3318 [label="Chat ends.",color=orange];
	3319 [label="我觉得这件事唯一让我恼火的点，是我先在你脑海里发现了这种想法的存在。",shape=box,color=blue];
		3319 -> 3320;
	3317 [label="Chat ends.",color=orange];
	3320 [label="我并不是不知道，你打算礼貌地过来征求同意。你好。",shape=box,color=blue];
		3320 -> 3321;
	3321 [label="答案是一个撅着嘴，双臂交叉地回答“好，当然可以”，而我却只能坐在这里，忍住不想你去和我在你幻想中瞥见的那个美丽尤物寻欢作乐的样子。",shape=box,color=blue];
		3321 -> 3322;
	3322 [label="而现在这些都只存在于——我的——幻想中了，因为我被困在了这个时间和这个地点，我——谢——谢——你！",shape=box,color=blue];
		3322 -> 3323;
	3323 [label="对不起。我真的是来征求你同意的。我知道我们之前没讨论过这件事。我只是想确认这一切你都不会介意。",shape=box,color=red];
		3323 -> 3324;
	3324 [label="当然没问题！我能在你的心眼里看到他。如果你信任他，我就信任他。",shape=box,color=blue];
		3324 -> 3325;
	3325 [label="我只是有点难过，我没机会脚踏几条船。",shape=box,color=blue];
		3325 -> 3326;
	3326 [label="+20 Chemistry",color=orange];
		3326 -> 3327;
	3327 [label="但或许我可以通过你来间接体验这种感觉，这倒是个不错的想法。",shape=box,color=blue];
		3327 -> 3328;
	3328 [label="Update boolean EleanorConsentComplete",color=orange];
		3328 -> 3329;
	3329 [label="Chat ends.",color=orange];
