digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"EleanorRank6Convo9 begins." [color=orange];
		"EleanorRank6Convo9 begins." -> j3427652886;
	j3427652886 [label="那么，用我妈妈的话来说，所谓的“Mara Lohk”到底是什么呢？",shape=box,color=blue];
		j3427652886 -> j1119611834;
		j3427652886 -> j630576833;
	j1119611834 [label="这是虚空无情之物对我的称呼。",shape=box,color=red];
		j1119611834 -> j1096047520;
	j630576833 [label="我不知道。这是虚空语。",shape=box,color=red];
		j630576833 -> j1096047520;
	j1096047520 [label="啊。我问这个是因为当我有时看着你的时候，我隐隐约约会在脑海里听到它。",shape=box,color=blue];
		j1096047520 -> j1403727449;
	j1403727449 [label="Check boolean EleanorDating",color=orange];
		j1403727449 -> j932514265 [label=true,color=green];
		j1403727449 -> j329210583 [label=false,color=brown];
	j932514265 [label="（还有其他一些比如““哗嗷”、“天啊”和“那是我的漂泊者，没错。”之类的话。）",shape=box,color=blue];
		j932514265 -> j2515464092;
	j329210583 [label="（还有其他一些比如“天啊，他们真酷”和“那是我伙计，没错”之类的话。）",shape=box,color=blue];
		j329210583 -> j2515464092;
	j2515464092 [label="这个语言里有没有你认识的词？",shape=box,color=blue];
		j2515464092 -> j3191058852;
	j3191058852 [label="有几个。",shape=box,color=red];
		j3191058852 -> j2628690827;
	j2628690827 [label="Netra 代表“腐朽”，Xata 代表“真理”，Ris 代表“光明”……",shape=box,color=red];
		j2628690827 -> j1584869574;
	j1584869574 [label="Lohk 是“虚空”，Oull 是“可能性”，Khra 是“时间”……",shape=box,color=red];
		j1584869574 -> j3101577310;
	j3101577310 [label="祝你好运，用这些东西制作一个冰箱磁铁诗",shape=box,color=blue];
		j3101577310 -> j1954333945;
	j1954333945 [label="等待。如果“Lohk”是虚空，那么“Mara Lohk”就是某种虚空。或者虚空之物。",shape=box,color=blue];
		j1954333945 -> j1370356206;
	j1370356206 [label="虚空梦魇？噩梦？虚空恶魔？",shape=box,color=blue];
		j1370356206 -> j3483280607;
		j1370356206 -> j993324856;
	j3483280607 [label="小心点。这不仅仅是一种语言。",shape=box,color=red];
		j3483280607 -> j1120440265;
	j993324856 [label="我被叫过更难听的。",shape=box,color=red];
		j993324856 -> j441892956;
	j1120440265 [label="这是不是就是我回头一看，有个黑眼睛的埃莉诺正冲我咧嘴笑的时刻？",shape=box,color=blue];
		j1120440265 -> j3098705831;
	j441892956 [label="如果我回来再跟你唠叨这件事，你可别惊讶。",shape=box,color=blue];
		j441892956 -> j1899362923;
	j3098705831 [label="我觉得我还是看看吧，以防万一……",shape=box,color=blue];
		j3098705831 -> j1739444334;
	j1899362923 [label="+5 Chemistry",color=orange];
		j1899362923 -> j109742337;
	j1739444334 [label="噢我的天啊",shape=box,color=blue];
		j1739444334 -> j3737564586;
	j109742337 [label="忍不住想打听一下。这大概就是我记者的本性吧。",shape=box,color=blue];
		j109742337 -> "Chat ends.";
	j3737564586 [label="怎么了？",shape=box,color=red];
		j3737564586 -> j3670328434;
	"Chat ends." [color=orange];
	j3670328434 [label="蜘蛛",shape=box,color=blue];
		j3670328434 -> j3642229541;
	j3642229541 [label="你认真的？",shape=box,color=red];
		j3642229541 -> j3993775645;
	j3993775645 [label="我本打算开玩笑说什么都没有，结果天花板上却挂着一只该死的大蜘蛛",shape=box,color=blue];
		j3993775645 -> j2924325919;
	j2924325919 [label="等会儿再聊，我得去拿个杯子和一些卡片",shape=box,color=blue];
		j2924325919 -> "Chat ends.";
}