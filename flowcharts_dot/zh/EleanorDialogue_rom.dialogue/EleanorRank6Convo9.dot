digraph {
	3255 [label="EleanorRank6Convo9 begins.",color=orange];
		3255 -> 3256;
	3256 [label="那么，用我妈妈的话来说，所谓的“Mara Lohk”到底是什么呢？",shape=box,color=blue];
		3256 -> 3257;
		3256 -> 3258;
	3257 [label="这是虚空无情之物对我的称呼。",shape=box,color=red];
		3257 -> 3259;
	3258 [label="我不知道。这是虚空语。",shape=box,color=red];
		3258 -> 3259;
	3259 [label="啊。我问这个是因为当我有时看着你的时候，我隐隐约约会在脑海里听到它。",shape=box,color=blue];
		3259 -> 3260;
	3260 [label="Check boolean EleanorDating",color=orange];
		3260 -> 3262 [label=true,color=green];
		3260 -> 3261 [label=false,color=brown];
	3262 [label="（还有其他一些比如““哗嗷”、“天啊”和“那是我的漂泊者，没错。”之类的话。）",shape=box,color=blue];
		3262 -> 3263;
	3261 [label="（还有其他一些比如“天啊，他们真酷”和“那是我伙计，没错”之类的话。）",shape=box,color=blue];
		3261 -> 3263;
	3263 [label="这个语言里有没有你认识的词？",shape=box,color=blue];
		3263 -> 3264;
	3264 [label="有几个。",shape=box,color=red];
		3264 -> 3265;
	3265 [label="Netra 代表“腐朽”，Xata 代表“真理”，Ris 代表“光明”……",shape=box,color=red];
		3265 -> 3266;
	3266 [label="Lohk 是“虚空”，Oull 是“可能性”，Khra 是“时间”……",shape=box,color=red];
		3266 -> 3267;
	3267 [label="祝你好运，用这些东西制作一个冰箱磁铁诗",shape=box,color=blue];
		3267 -> 3268;
	3268 [label="等待。如果“Lohk”是虚空，那么“Mara Lohk”就是某种虚空。或者虚空之物。",shape=box,color=blue];
		3268 -> 3269;
	3269 [label="虚空梦魇？噩梦？虚空恶魔？",shape=box,color=blue];
		3269 -> 3270;
		3269 -> 3271;
	3270 [label="小心点。这不仅仅是一种语言。",shape=box,color=red];
		3270 -> 3272;
	3271 [label="我被叫过更难听的。",shape=box,color=red];
		3271 -> 3273;
	3272 [label="这是不是就是我回头一看，有个黑眼睛的埃莉诺正冲我咧嘴笑的时刻？",shape=box,color=blue];
		3272 -> 3274;
	3273 [label="如果我回来再跟你唠叨这件事，你可别惊讶。",shape=box,color=blue];
		3273 -> 3275;
	3274 [label="我觉得我还是看看吧，以防万一……",shape=box,color=blue];
		3274 -> 3276;
	3275 [label="+5 Chemistry",color=orange];
		3275 -> 3277;
	3276 [label="噢我的天啊",shape=box,color=blue];
		3276 -> 3278;
	3277 [label="忍不住想打听一下。这大概就是我记者的本性吧。",shape=box,color=blue];
		3277 -> 3279;
	3278 [label="怎么了？",shape=box,color=red];
		3278 -> 3280;
	3279 [label="Chat ends.",color=orange];
	3280 [label="蜘蛛",shape=box,color=blue];
		3280 -> 3281;
	3281 [label="你认真的？",shape=box,color=red];
		3281 -> 3282;
	3282 [label="我本打算开玩笑说什么都没有，结果天花板上却挂着一只该死的大蜘蛛",shape=box,color=blue];
		3282 -> 3283;
	3283 [label="等会儿再聊，我得去拿个杯子和一些卡片",shape=box,color=blue];
		3283 -> 3284;
	3284 [label="Chat ends.",color=orange];
}