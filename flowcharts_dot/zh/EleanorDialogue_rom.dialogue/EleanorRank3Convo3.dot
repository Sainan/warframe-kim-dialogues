digraph {
	1032 [label="EleanorRank3Convo3 begins.",color=orange];
		1032 -> 1033;
	1033 [label="嘿，埃莉诺。最近怎么样？",shape=box,color=red];
		1033 -> 1034;
	1034 [label="很好。刚刚在剃舌头。",shape=box,color=blue];
		1034 -> 1035;
		1034 -> 1036;
	1035 [label="剃？",shape=box,color=red];
		1035 -> 1037;
	1036 [label="等等。*什么？*",shape=box,color=red];
		1036 -> 1038;
	1037 [label="对，剃。我舌头上不断冒出一些疙瘩。我觉得它们以前是味蕾。如果我不切掉它们，它们会变得很长，动来动去的，像海葵一样。",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="这其实和剪指甲没什么区别。",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="抱歉，我真该事先警告你这件事的。",shape=box,color=blue];
		1039 -> 1041;
	1040 [label="可能会更乱一些。但归根结底不过是修剪掉多余的赘生物罢了。",shape=box,color=blue];
		1040 -> 1041;
	1041 [label="其他人都知道，当埃莉诺拿着菜刀和一瓶消毒酒精走进浴室时，至少要离她一百米远。",shape=box,color=blue];
		1041 -> 1042;
	1042 [label="只要耐心等待，我最后会带着满嘴血、手里还提着一袋像蟹肉的东西出来。我曾经试图把切下的碎肉做成汉堡，但没人愿意吃。",shape=box,color=blue];
		1042 -> 1043;
	1043 [label="对不起，你是想要半小时的情色聊天，还是五分钟就够了？",shape=box,color=blue];
		1043 -> 1044;
		1043 -> 1045;
	1044 [label="别想恶心我。",shape=box,color=red];
		1044 -> 1046;
	1045 [label="既然我们在谈论舌头……",shape=box,color=red];
		1045 -> 1048;
	1046 [label="喂。我才是那个喉咙里卡着半条鳗鱼的人。请原谅我试图用玩笑来应对。",shape=box,color=blue];
		1046 -> 1047;
	1048 [label="继续。",shape=box,color=blue];
		1048 -> 1049;
	1047 [label="Chat ends.",color=orange];
	1049 [label="……你对它的控制有多少？",shape=box,color=red];
		1049 -> 1050;
	1050 [label="好的。等一下。",shape=box,color=blue];
		1050 -> 1051;
	1051 [label="介么多",shape=box,color=blue];
		1051 -> 1052;
	1052 [label="我嘬得肿么样",shape=box,color=blue];
		1052 -> 1053;
		1052 -> 1054;
	1053 [label="告诉我你不会是……",shape=box,color=red];
		1053 -> 1056;
	1054 [label="哦，天哪，不行。我不聊了。[结束]",shape=box,color=red];
		1054 -> 1055;
	1056 [label="哦，不过确实是呢呵呵呵",shape=box,color=blue];
		1056 -> 1058;
		1056 -> 1057;
	1055 [label="Chat ends.",color=orange];
	1058 [label="你在用它打字吗？！",shape=box,color=red];
		1058 -> 1060;
	1057 [label="如果这个问题太私人了，请见谅，但是……你的舌头还能做些*什么*呢……？",shape=box,color=red];
		1057 -> 1059;
	1060 [label="嗯",shape=box,color=blue];
		1060 -> 1066;
	1059 [label="好的吧……",shape=box,color=blue];
		1059 -> 1061;
	1066 [label="不过不会持续很久，因为我会把键盘弄得全是口水。",shape=box,color=blue];
		1066 -> 1067;
	1061 [label="想想你会做什么",shape=box,color=blue];
		1061 -> 1062;
	1067 [label="不管怎样。现在你知道了。",shape=box,color=blue];
		1067 -> 1068;
		1067 -> 1069;
	1062 [label="我也能",shape=box,color=blue];
		1062 -> 1063;
	1068 [label="你有没有失去对它的控制？",shape=box,color=red];
		1068 -> 1070;
	1069 [label="你有没有不小心咬过它？",shape=box,color=red];
		1069 -> 1071;
	1063 [label="感觉真好哈哈",shape=box,color=blue];
		1063 -> 1064;
	1070 [label="这该死的玩意儿似乎有自己的想法。当我想它的时候我就能控制它。但我不去想它的时候，它似乎会对我的情绪做出反应。",shape=box,color=blue];
		1070 -> 1072;
	1071 [label="经常。它恢复得很快。",shape=box,color=blue];
		1071 -> 1074;
	1064 [label="Update boolean EleanorFlirt",color=orange];
		1064 -> 1065;
		1064 -> 1069;
	1072 [label="更糟糕的可能是，它不是由我驱动的，而是由我与科腐者的潜在联系驱动的。我宁愿不去考虑这种可能。",shape=box,color=blue];
		1072 -> 1073;
	1074 [label="有一次我把它完全咬掉了，它又长回来了。这东西我摆脱不了。",shape=box,color=blue];
		1074 -> 1075;
	1065 [label="我。呵呵。那么，我想我的下一个问题是……你有没有失去对它的控制？",shape=box,color=red];
		1065 -> 1070;
	1073 [label="不过，我真的很讨厌它挡住我的牙齿。有一次我把它完全咬掉了，它又长回来了。这东西我摆脱不了。",shape=box,color=blue];
		1073 -> 1075;
	1075 [label="至少它没有再变长。只是长出了一些像叶片的东西。",shape=box,color=blue];
		1075 -> 1076;
		1075 -> 1077;
	1076 [label="你想回到英择谛改变你之前的样子吗？",shape=box,color=red];
		1076 -> 1078;
	1077 [label="你对此有什么感觉？就是……真正的感觉是什么？",shape=box,color=red];
		1077 -> 1079;
	1078 [label="我是说，当然啊？毫不犹豫。但我做不到，那纠结它又有什么用呢？",shape=box,color=blue];
		1078 -> 1080;
	1079 [label="我不会主动选择它。但我不讨厌它。我感觉它似乎一直都在那里。",shape=box,color=blue];
		1079 -> 1081;
	1080 [label="我们遇到的每件事都是有原因的。",shape=box,color=red];
		1080 -> 1083;
	1081 [label="我想念自己的声音。痛恨自己再也无法唱歌了。",shape=box,color=blue];
		1081 -> 1082;
	1083 [label="是的。只是有时候原因就是：一个邪恶的混蛋做了邪恶的事。",shape=box,color=blue];
		1083 -> 1084;
	1082 [label="但这舌头？你可能觉得这很难相信，有时候它反而给我带来了安慰。我再也不会手无寸铁了。",shape=box,color=blue];
		1082 -> 1099;
		1082 -> 1100;
	1084 [label="所以如果你说一切都是最好的安排，好像所有事情都有一个伟大的计划或目的，那你就自己信去吧。我不相信那一套。",shape=box,color=blue];
		1084 -> 1085;
	1099 [label="那么……你最喜欢你现在这种状态中的什么？",shape=box,color=red];
		1099 -> 1101;
	1100 [label="至少你们中有一个人在试图找到一线希望……",shape=box,color=red];
		1100 -> 1102;
	1085 [label="Check boolean EleanorHeroVirus",color=orange];
		1085 -> 1086 [label=true,color=green];
		1085 -> 1087 [label=false,color=brown];
	1101 [label="感觉自己坚不可摧。",shape=box,color=blue];
		1101 -> 1107;
	1102 [label="只有一个？你见过阿米尔吗？",shape=box,color=blue];
		1102 -> 1103;
	1086 [label="那是英雄病毒，你以为自己是别人故事中的主角。",shape=box,color=blue];
		1086 -> 1087;
	1087 [label="伙计，这里没有什么伟大的故事。没有什么天上的作者在为我的生活编排小情节，增加戏剧性。",shape=box,color=blue];
		1087 -> 1088;
	1107 [label="介意我给你讲个故事吗？",shape=box,color=blue];
		1107 -> 1108;
	1103 [label="他虽然有他的黑暗时刻，但那个男孩激励了我们所有人。",shape=box,color=blue];
		1103 -> 1104;
	1088 [label="我可以从发生在我身上的愚蠢事情中寻找意义。我才是艺术家，不是太阳神、月神或任何介于两者之间的星星。",shape=box,color=blue];
		1088 -> 1089;
	1108 [label="说吧。",shape=box,color=red];
		1108 -> 1109;
	1104 [label="想比起那些闷闷不乐、一脸愁容的人，我更喜欢阿米尔的态度。",shape=box,color=blue];
		1104 -> 1105;
	1089 [label="Check boolean EleanorGalvanized",color=orange];
		1089 -> 1090 [label=true,color=green];
		1089 -> 1091 [label=false,color=brown];
		1089 -> 1092 [label=false,color=brown];
	1109 [label="我十八岁那年，我们一大帮人庆祝考试结束。我们都挤在一辆小车里。我躺在后座三个人的腿上。",shape=box,color=blue];
		1109 -> 1110;
	1105 [label="+10 Chemistry",color=orange];
		1105 -> 1106;
	1090 [label="是你让我想起了这一点。我不知道你是否还记得。我当时在自怜自艾，而你让我清醒过来。",shape=box,color=blue];
		1090 -> 1091;
		1090 -> 1092;
	1091 [label="我很高兴能帮上忙。",shape=box,color=red];
		1091 -> 1093;
	1092 [label="你不是在说生活毫无意义，对吗？",shape=box,color=red];
		1092 -> 1095;
	1110 [label="塞布·克罗姆利在后备箱里发牢骚。克里斯托弗和马可坐在前面。我们每个人都喝得烂醉，喝的是草莓伏特加混捕鼠者烈酒。",shape=box,color=blue];
		1110 -> 1111;
	1106 [label="Chat ends.",color=orange];
	1093 [label="+10 Chemistry",color=orange];
		1093 -> 1094;
	1095 [label="天哪，不是的。我是说意义隐藏在表面之下，需要雕刻家的凿子才能发掘出来。",shape=box,color=blue];
		1095 -> 1096;
	1111 [label="马可闯了红灯，一辆对面来的车撞上了我们的侧面，我们翻出路面，最后掉进了沟里。我之所以知道这些，是因为警察告诉我的。",shape=box,color=blue];
		1111 -> 1112;
	1094 [label="Chat ends.",color=orange];
	1096 [label="有些时候，一切都感觉黯淡、可怕且空洞，我甚至不想离开沙发。但当我恢复正常时，我知道那种感觉是虚假的。",shape=box,color=blue];
		1096 -> 1097;
	1112 [label="他们不得不把我从车里切割出来。我一直在尖叫。这种伤痛让你浑身无处可逃。你感觉自己只是因为存在就受到了惩罚。",shape=box,color=blue];
		1112 -> 1113;
	1097 [label="你知道吗，没人能掌握生活的意义？这是你和宇宙之间的即兴演奏。它丢给你一些东西，而你围绕它即兴发挥。",shape=box,color=blue];
		1097 -> 1098;
	1113 [label="我像只无助的小兔子，像融化的蜡笔一样，消失了。只能躺在那里，一声声尖叫。在那之前，我一直以为自己很坚强。",shape=box,color=blue];
		1113 -> 1114;
	1098 [label="有助于我将注意力集中到半感染状态里那些我喜欢的部分。",shape=box,color=blue];
		1098 -> 1099;
		1098 -> 1100;
	1114 [label="Update boolean EleanorCrash",color=orange];
		1114 -> 1115;
	1115 [label="我明白你说的那种痛。",shape=box,color=red];
		1115 -> 1116;
	1116 [label="两天前我被一辆炽蛇军装甲车撞了。",shape=box,color=blue];
		1116 -> 1117;
	1117 [label="那种熟悉的痛苦再次涌上心头，但它已不再让我无法动弹。它像燃料一样，激发了我，让我愤怒。",shape=box,color=blue];
		1117 -> 1118;
	1118 [label="我自己站了起来，重新接上了脱臼的肩膀，然后用我的双手撕开了那台装甲车。",shape=box,color=blue];
		1118 -> 1119;
	1119 [label="这是痛苦的，但也是令人陶醉的。",shape=box,color=blue];
		1119 -> 1121;
	1121 [label="+20 Chemistry",color=orange];
		1121 -> 1120;
	1120 [label="所以，真的很感谢你，英择谛。无论你现在身处何方。",shape=box,color=blue];
		1120 -> 1122;
	1122 [label="Chat ends.",color=orange];
}