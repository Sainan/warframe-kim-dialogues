digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"EleanorRank6Convo2 begins." [color=orange];
		"EleanorRank6Convo2 begins." -> j3812081490;
	j3812081490 [label="嘿。我想听听你的意见。",shape=box,color=blue];
		j3812081490 -> j3012192244;
	j3012192244 [label="我在想恶魔之夜的事。我已经好多年没打扮过了，但刚才翻看阿米尔的一本漫画时，突然想到——等等，我完全可以扮成伯爵夫人！我连獠牙都有了，一切都齐了！",shape=box,color=blue];
		j3012192244 -> j4106616242;
	j4106616242 [label="但这是不是太明显了？我应该像丹迪·戴米奇那样吗？",shape=box,color=blue];
		j4106616242 -> j3398939271;
		j4106616242 -> j2929731068;
		j4106616242 -> j2007095165;
	j3398939271 [label="谁是丹迪·戴米奇？",shape=box,color=red];
		j3398939271 -> j1064257632;
	j2929731068 [label="如果你想迷惑别人的话，你可以打扮成 Lotus。",shape=box,color=red];
		j2929731068 -> j34563969;
	j2007095165 [label="……你得先告诉我恶魔之夜是什么。",shape=box,color=red];
		j2007095165 -> j4073638234;
	j1064257632 [label="噢，伙计。 ",shape=box,color=blue];
		j1064257632 -> j1176079417;
	j34563969 [label="天啊，不。我在你脑海中见过她。我可没法再现她的模样。",shape=box,color=blue];
		j34563969 -> j3577145548;
	j4073638234 [label="嗯。有时候我都忘了你是个初来乍到的外地人。 ",shape=box,color=blue];
		j4073638234 -> j354163811;
	j1176079417 [label="丹迪·戴米奇的行动为 Temple 和撕裂者乐队创造了逃跑的机会。他堪称每位母亲的噩梦，却是每个叛逆少年的梦想。",shape=box,color=blue];
		j1176079417 -> j2887181072;
	j3577145548 [label="还有那顶头盔。那是头盔吗？还是她身体的一部分？她是怎么透过它看东西的？",shape=box,color=blue];
		j3577145548 -> j1839452962;
	j354163811 [label="恶魔之夜庆祝的是太阳对世界影响力的消退。",shape=box,color=blue];
		j354163811 -> j3396827398;
	j2887181072 [label="身材修长如竹节虫，妆容精致如默片女王。嘴唇甜美如糖果。条纹西装、皮革与狗链。颧骨突出的像骷髅的臀部。",shape=box,color=blue];
		j2887181072 -> j3241393938;
		j2887181072 -> j3753950910;
	j1839452962 [label="不管怎样，她身上有三个不同的性格。我实在无法在她们之间做出选择。",shape=box,color=blue];
		j1839452962 -> j3241393938;
		j1839452962 -> j3753950910;
	j3396827398 [label="这听起来似乎并不合理。为什么要庆祝黑暗的降临？为什么要为无政府状态和混乱而高兴呢？",shape=box,color=blue];
		j3396827398 -> j519885010;
	j3241393938 [label="打扮变装？开派对？还是在战区？你真的觉得这些会发生吗？",shape=box,color=red];
		j3241393938 -> j4013542526;
	j3753950910 [label="你知道吗，恶魔之夜听起来和纳贝流士很像。人们也喜欢为那个活动打扮一番的。",shape=box,color=red];
		j3753950910 -> j4013542526;
	j519885010 [label="我觉得这可能就像接种疫苗一样。用一点点我们所恐惧的事物，让我们坚强起来。又或者这不过是个借口，借此戴上魔鬼的面具，大闹一场。",shape=box,color=blue];
		j519885010 -> j3241393938;
		j519885010 -> j3753950910;
	j4013542526 [label="……我可能只是在犯傻。很幼稚。对吧？",shape=box,color=blue];
		j4013542526 -> j336302439;
	j336302439 [label="哦，我在想什么呢。",shape=box,color=blue];
		j336302439 -> j1223713762;
	j1223713762 [label="我不需要打扮，对吧？我本来就是个怪物。永远都是。",shape=box,color=blue];
		j1223713762 -> j2436064064;
	j2436064064 [label="Check boolean EleanorDating",color=orange];
		j2436064064 -> j517127047 [label=true,color=green];
		j2436064064 -> j1020257900 [label=true,color=green];
		j2436064064 -> j3699549993 [label=true,color=green];
		j2436064064 -> j1020257900 [label=false,color=brown];
		j2436064064 -> j3699549993 [label=false,color=brown];
	j517127047 [label="你是我爱的怪物，埃莉诺。我一点也不后悔。",shape=box,color=red];
		j517127047 -> j3291657047;
	j1020257900 [label="我开始觉得你喜欢这么说自己。",shape=box,color=red];
		j1020257900 -> j1950685641;
	j3699549993 [label="不。真正的怪物可不会像你这样关心别人。",shape=box,color=red];
		j3699549993 -> j611869161;
	j3291657047 [label="+5 Chemistry",color=orange];
		j3291657047 -> j3930475848;
	j1950685641 [label="如果你真的认为自己就是那样的人，那么恶魔之夜就是庆祝它的完美时机。",shape=box,color=red];
		j1950685641 -> j355719712;
		j1950685641 -> j611869161;
	j611869161 [label="我知道你害怕自己可能会变成什么样。但那不是现在的你。",shape=box,color=red];
		j611869161 -> j1027624791;
	j3930475848 [label="哦，对啊！我真糊涂。我忘了那个怪物在我们的故事里有一个圆满的结局。",shape=box,color=blue];
		j3930475848 -> j2030698692;
	j355719712 [label="成为怪物。拥有它。在这一年中的这一晚，自豪地佩戴这个称号。",shape=box,color=red];
		j355719712 -> j2019448060;
	j1027624791 [label="所以，好好打扮。玩得开心。虚空知道六人组的每个人都用得上。",shape=box,color=red];
		j1027624791 -> j508210080;
	j2030698692 [label="原谅我。我还是不太相信这是你真正想要的。也许我还需要一点什么来说服自己。",shape=box,color=blue];
		j2030698692 -> j214556019;
	j2019448060 [label="哦，有太多太多的理由说明这是个糟糕透顶的主意",shape=box,color=blue];
		j2019448060 -> j2105189651;
	j508210080 [label="我接受你的建议。再次感谢你。x",shape=box,color=blue];
		j508210080 -> "Chat ends.";
	j214556019 [label="我们稍后再互相吞噬吧。 xxx",shape=box,color=blue];
		j214556019 -> "Chat ends.";
	j2105189651 [label="非。常。多。",shape=box,color=blue];
		j2105189651 -> j2326581112;
	"Chat ends." [color=orange];
	j2326581112 [label="（我现在想不出来任何理由，但我肯定有成百上千个）",shape=box,color=blue];
		j2326581112 -> j2035825888;
	j2035825888 [label="……该死。",shape=box,color=blue];
		j2035825888 -> j939214732;
	j939214732 [label="你真是让我自己挖坑自己跳啊。该死，你真厉害。干得漂亮。x",shape=box,color=blue];
		j939214732 -> "Chat ends.";
}