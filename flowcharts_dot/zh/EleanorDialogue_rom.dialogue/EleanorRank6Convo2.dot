digraph {
	2845 [label="EleanorRank6Convo2 begins.",color=orange];
		2845 -> 2846;
	2846 [label="嘿。我想听听你的意见。",shape=box,color=blue];
		2846 -> 2847;
	2847 [label="我在想恶魔之夜的事。我已经好多年没打扮过了，但刚才翻看阿米尔的一本漫画时，突然想到——等等，我完全可以扮成伯爵夫人！我连獠牙都有了，一切都齐了！",shape=box,color=blue];
		2847 -> 2848;
	2848 [label="但这是不是太明显了？我应该像丹迪·戴米奇那样吗？",shape=box,color=blue];
		2848 -> 2849;
		2848 -> 2850;
		2848 -> 2851;
	2849 [label="谁是丹迪·戴米奇？",shape=box,color=red];
		2849 -> 2852;
	2850 [label="如果你想迷惑别人的话，你可以打扮成 Lotus。",shape=box,color=red];
		2850 -> 2853;
	2851 [label="……你得先告诉我恶魔之夜是什么。",shape=box,color=red];
		2851 -> 2854;
	2852 [label="噢，伙计。 ",shape=box,color=blue];
		2852 -> 2855;
	2853 [label="天啊，不。我在你脑海中见过她。我可没法再现她的模样。",shape=box,color=blue];
		2853 -> 2856;
	2854 [label="嗯。有时候我都忘了你是个初来乍到的外地人。 ",shape=box,color=blue];
		2854 -> 2857;
	2855 [label="丹迪·戴米奇的行动为 Temple 和撕裂者乐队创造了逃跑的机会。他堪称每位母亲的噩梦，却是每个叛逆少年的梦想。",shape=box,color=blue];
		2855 -> 2858;
	2856 [label="还有那顶头盔。那是头盔吗？还是她身体的一部分？她是怎么透过它看东西的？",shape=box,color=blue];
		2856 -> 2859;
	2857 [label="恶魔之夜庆祝的是太阳对世界影响力的消退。",shape=box,color=blue];
		2857 -> 2860;
	2858 [label="身材修长如竹节虫，妆容精致如默片女王。嘴唇甜美如糖果。条纹西装、皮革与狗链。颧骨突出的像骷髅的臀部。",shape=box,color=blue];
		2858 -> 2861;
		2858 -> 2862;
	2859 [label="不管怎样，她身上有三个不同的性格。我实在无法在她们之间做出选择。",shape=box,color=blue];
		2859 -> 2861;
		2859 -> 2862;
	2860 [label="这听起来似乎并不合理。为什么要庆祝黑暗的降临？为什么要为无政府状态和混乱而高兴呢？",shape=box,color=blue];
		2860 -> 2863;
	2861 [label="打扮变装？开派对？还是在战区？你真的觉得这些会发生吗？",shape=box,color=red];
		2861 -> 2864;
	2862 [label="你知道吗，恶魔之夜听起来和纳贝流士很像。人们也喜欢为那个活动打扮一番的。",shape=box,color=red];
		2862 -> 2864;
	2863 [label="我觉得这可能就像接种疫苗一样。用一点点我们所恐惧的事物，让我们坚强起来。又或者这不过是个借口，借此戴上魔鬼的面具，大闹一场。",shape=box,color=blue];
		2863 -> 2861;
		2863 -> 2862;
	2864 [label="……我可能只是在犯傻。很幼稚。对吧？",shape=box,color=blue];
		2864 -> 2865;
	2865 [label="哦，我在想什么呢。",shape=box,color=blue];
		2865 -> 2866;
	2866 [label="我不需要打扮，对吧？我本来就是个怪物。永远都是。",shape=box,color=blue];
		2866 -> 2867;
	2867 [label="Check boolean EleanorDating",color=orange];
		2867 -> 2868 [label=true,color=green];
		2867 -> 2869 [label=true,color=green];
		2867 -> 2870 [label=true,color=green];
		2867 -> 2869 [label=false,color=brown];
		2867 -> 2870 [label=false,color=brown];
	2868 [label="你是我爱的怪物，埃莉诺。我一点也不后悔。",shape=box,color=red];
		2868 -> 2871;
	2869 [label="我开始觉得你喜欢这么说自己。",shape=box,color=red];
		2869 -> 2872;
	2870 [label="不。真正的怪物可不会像你这样关心别人。",shape=box,color=red];
		2870 -> 2873;
	2871 [label="+5 Chemistry",color=orange];
		2871 -> 2874;
	2872 [label="如果你真的认为自己就是那样的人，那么恶魔之夜就是庆祝它的完美时机。",shape=box,color=red];
		2872 -> 2875;
		2872 -> 2873;
	2873 [label="我知道你害怕自己可能会变成什么样。但那不是现在的你。",shape=box,color=red];
		2873 -> 2876;
	2874 [label="哦，对啊！我真糊涂。我忘了那个怪物在我们的故事里有一个圆满的结局。",shape=box,color=blue];
		2874 -> 2877;
	2875 [label="成为怪物。拥有它。在这一年中的这一晚，自豪地佩戴这个称号。",shape=box,color=red];
		2875 -> 2878;
	2876 [label="所以，好好打扮。玩得开心。虚空知道六人组的每个人都用得上。",shape=box,color=red];
		2876 -> 2879;
	2877 [label="原谅我。我还是不太相信这是你真正想要的。也许我还需要一点什么来说服自己。",shape=box,color=blue];
		2877 -> 2880;
	2878 [label="哦，有太多太多的理由说明这是个糟糕透顶的主意",shape=box,color=blue];
		2878 -> 2881;
	2879 [label="我接受你的建议。再次感谢你。x",shape=box,color=blue];
		2879 -> 2882;
	2880 [label="我们稍后再互相吞噬吧。 xxx",shape=box,color=blue];
		2880 -> 2883;
	2881 [label="非。常。多。",shape=box,color=blue];
		2881 -> 2884;
	2882 [label="Chat ends.",color=orange];
	2883 [label="Chat ends.",color=orange];
	2884 [label="（我现在想不出来任何理由，但我肯定有成百上千个）",shape=box,color=blue];
		2884 -> 2885;
	2885 [label="……该死。",shape=box,color=blue];
		2885 -> 2886;
	2886 [label="你真是让我自己挖坑自己跳啊。该死，你真厉害。干得漂亮。x",shape=box,color=blue];
		2886 -> 2887;
	2887 [label="Chat ends.",color=orange];
}