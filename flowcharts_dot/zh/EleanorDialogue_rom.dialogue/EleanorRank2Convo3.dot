digraph {
	460 [label="EleanorRank2Convo3 begins.",color=orange];
		460 -> 461;
	461 [label="好了，我们已经认识有一段时间了，你来自未来，我认为我可以信任你会给我一个诚实的回答，所以我得问你一个非常重要的问题。",shape=box,color=blue];
		461 -> 462;
	462 [label="宇宙里是只有我们吗？或者我们最终联系到了其他存在？",shape=box,color=blue];
		462 -> 463;
		462 -> 464;
		462 -> 465;
	463 [label="你是说外星生命吗？还没有，但也许有一天会有。",shape=box,color=red];
		463 -> 466;
	464 [label="不幸的是，虚空无情之物是我们迄今为止遇到的最接近的东西。",shape=box,color=red];
		464 -> 467;
	465 [label="是的，只有我们。除了人类和人类创造的东西之外，什么都没有。",shape=box,color=red];
		465 -> 468;
	466 [label="哎呀。",shape=box,color=blue];
		466 -> 469;
	467 [label="“虚空无情之物”是什么？我在你的脑海中看到了一些片段，但我理解不了。它让我想逃到一个有着厚厚墙壁的远处去蜷缩起来。",shape=box,color=blue];
		467 -> 470;
		467 -> 471;
	468 [label="这可能是最悲观的回答。",shape=box,color=blue];
		468 -> 472;
	469 [label="我真心希望外面有我们可以交流的生命。一种能从外部视角看待我们种族的生命。",shape=box,color=blue];
		469 -> 473;
	470 [label="我们还不确定它是什么。甚至不知道它想要什么。我们甚至不知道它是不是像血色面纱那样认为的古老存在，还是阿尔布雷希特以某种方式创造出来的。",shape=box,color=red];
		470 -> 474;
	471 [label="它就是那个带走鲁莎卡少校的东西。",shape=box,color=red];
		471 -> 475;
	472 [label="我不知道为什么。毕竟，智能就是智能。无论我们是发现它还是创造它，都不应该有差别。",shape=box,color=blue];
		472 -> 540;
	473 [label="不仅是交谈……当然还包括其他事。",shape=box,color=blue];
		473 -> 477;
		473 -> 476;
	474 [label="如果我告诉你它就是曾经附身在鲁莎卡少校身上的东西，这对你有帮助吗？",shape=box,color=red];
		474 -> 475;
	475 [label="哦。",shape=box,color=blue];
		475 -> 543;
	540 [label="我想我只是想确认宇宙并没有把所有鸡蛋都放在一个篮子里。因为如果只有人类存在，那我们真的完蛋了。",shape=box,color=blue];
		540 -> 541;
	477 [label="在寻找一个触手怪同类当朋友吗？",shape=box,color=red];
		477 -> 494;
	476 [label="等等。你心里想的是什么样的互动？",shape=box,color=red];
		476 -> 479;
	543 [label="不好。",shape=box,color=blue];
		543 -> 544;
	541 [label="哎。",shape=box,color=blue];
		541 -> 542;
	494 [label="+5 Chemistry",color=orange];
		494 -> 478;
	479 [label="我想是某种交流吧。不一定是物理上的。我只是想和一些非人类，甚至是非地球生物进行思维碰触。",shape=box,color=blue];
		479 -> 481;
	544 [label="糟了。",shape=box,color=blue];
		544 -> 545;
	542 [label="Chat ends.",color=orange];
	478 [label="请注意你的言辞。我不是什么“触手怪”。我是一个恰好有一根触手的怪物。到目前为止，只有一根。",shape=box,color=blue];
		478 -> 480;
	481 [label="我曾经尝和莱蒂的一只老鼠心灵接触，只是想看看会发生什么。",shape=box,color=blue];
		481 -> 483;
		481 -> 484;
	545 [label="那个东西？那就是你说的“虚空无情之物”？",shape=box,color=blue];
		545 -> 546;
	480 [label="如果我只是想和有触手的东西交谈，我就会去露西娜公主动物园和章鱼交朋友。",shape=box,color=blue];
		480 -> 482;
	483 [label="那个可怜的小东西没受伤吧？",shape=box,color=red];
		483 -> 485;
	484 [label="好吧，我得问问这事怎么样了。",shape=box,color=red];
		484 -> 485;
	546 [label="我接触过它。我用我思维的边缘触碰过那个东西，并且我把那段记忆封锁了。",shape=box,color=blue];
		546 -> 547;
	482 [label="……现在我真希望我当初那么做了。章鱼非常聪明。我们现在可能已经一起写诗了。我在想那只章鱼现在在哪儿？",shape=box,color=blue];
		482 -> 486;
	485 [label="对它来说是可怕的三秒钟。",shape=box,color=blue];
		485 -> 491;
	547 [label="我甚至不记得那是什么时候发生的了。她在扩音器上发表演讲的时候，我想“我从未探查过她的脑海，不知道里面会有什么，也许全是皮革和针头”，于是我就发出探查……",shape=box,color=blue];
		547 -> 548;
	486 [label="可能已经被人吃了吧。在城市被隔离后，动物园里的动物通常都是这个下场。",shape=box,color=blue];
		486 -> 487;
	491 [label="可怜的小东西。你看，我没考虑到我的思维对它来说会是什么样的。想象一下一个孩子在无边无际的百货公司里迷路了，不停地尖叫着呼唤妈妈。一切都那么巨大又难以理解，到处是声音和形状，而不是它熟悉的气味。",shape=box,color=blue];
		491 -> 492;
	548 [label="完了完了完了",shape=box,color=blue];
		548 -> 549;
	487 [label="没被吃掉的生物现在可能都被科腐者感染了。",shape=box,color=blue];
		487 -> 488;
	492 [label="我尽可能快地断开了连接。它头晕了大概一个小时，然后就好了。我怀疑它甚至不记得发生了什么。",shape=box,color=blue];
		492 -> 497;
		492 -> 496;
	549 [label="我现在还不能谈这件事。很抱歉。",shape=box,color=blue];
		549 -> 550;
	488 [label="……这和“梦”里的情况一样，不是吗？只不过这根本不是梦。它发生了。或者将要发生。或者某种形式的它将会发生。那家动物园里会发生一些事。",shape=box,color=blue];
		488 -> 489;
	497 [label="那你感觉怎样？变成小鼠是什么感觉？",shape=box,color=red];
		497 -> 500;
	496 [label="拜托，这只是一只小鼠。",shape=box,color=red];
		496 -> 498;
	550 [label="+20 Chemistry",color=orange];
		550 -> 551;
	489 [label="我要尽可能多地记住。",shape=box,color=blue];
		489 -> 490;
	500 [label="我不知道你是否曾经有过这样的低迷，你只想躺在床上呼吸，什么也不做，只是单纯地存在，但我的感觉很像那样。",shape=box,color=blue];
		500 -> 501;
	498 [label="我建议你别让莱蒂听到你这么说。除非你不在乎你的器官还能否留在原来的位置。",shape=box,color=blue];
		498 -> 499;
	551 [label="Update boolean EleanorIndifference",color=orange];
		551 -> 552;
	490 [label="别试图阻止我。",shape=box,color=blue];
		490 -> 493;
	501 [label="非常简单。用简单的方式满足简单的需求。",shape=box,color=blue];
		501 -> 502;
	499 [label="Chat ends.",color=orange];
	552 [label="Chat ends.",color=orange];
	493 [label="Update boolean EleanorRemembers",color=orange];
		493 -> 495;
	502 [label="童年的纯真与小鼠的意识根本无法比拟。",shape=box,color=blue];
		502 -> 503;
		502 -> 504;
	495 [label="Chat ends.",color=orange];
	503 [label="你这么说，听起来还挺惬意的。",shape=box,color=red];
		503 -> 505;
	504 [label="你是在嫉妒一只小鼠吗？",shape=box,color=red];
		504 -> 506;
	505 [label="确实很惬意。我当然知道做一只小鼠也有不好的一面，比如不得不吃掉死去的兄弟，以免被捕食者嗅到，但那短暂的单纯时刻像是宗教上的顿悟。",shape=box,color=blue];
		505 -> 507;
	506 [label="有点吧。",shape=box,color=blue];
		506 -> 509;
	507 [label="我猜，当小鼠就像当和尚一样。靠零星食物生存，谦卑地过日子，永远不会拥有汽车或房子。",shape=box,color=blue];
		507 -> 508;
	509 [label="我只是觉得，做一个需求少、简单的小生物有种英雄般的感觉。",shape=box,color=blue];
		509 -> 510;
	508 [label="宗教上的顿悟？",shape=box,color=red];
		508 -> 509;
	510 [label="说出来你可能不信，我以前真的考虑了很久要不要去当修女。",shape=box,color=blue];
		510 -> 511;
	511 [label="Update boolean EleanorNun1",color=orange];
		511 -> 512;
		511 -> 513;
	512 [label="埃莉诺，你得告诉我那是什么。",shape=box,color=red];
		512 -> 514;
	513 [label="修女？",shape=box,color=red];
		513 -> 515;
	514 [label="对，确实。看来你们那里没有这种人。",shape=box,color=blue];
		514 -> 516;
	515 [label="对。也许你们那里没有这种人。",shape=box,color=blue];
		515 -> 516;
	516 [label="就像是献身于月神的信徒。剃光头，根据不同的宗派穿着白色或黑色长袍，过着非常严苛的生活。你得专注于神圣的事务，摒弃一切杂念。每天祈祷和冥想。饮食简单。",shape=box,color=blue];
		516 -> 517;
		516 -> 518;
		516 -> 519;
		516 -> 520;
	517 [label="那听起来很糟糕。",shape=box,color=red];
		517 -> 521;
	518 [label="那听起来很棒。",shape=box,color=red];
		518 -> 522;
	519 [label="那听起来很有挑战性。",shape=box,color=red];
		519 -> 523;
	520 [label="这听起来……好像不适合我。",shape=box,color=red];
		520 -> 526;
	521 [label="表面上看确实如此。修道生活和坐牢唯一的区别是，前者是自愿的。",shape=box,color=blue];
		521 -> 527;
	522 [label="这对大多数初入修道的年轻人来说也听起来很棒，直到他们真正体验了修道生活。我想退出率大概是百分之八十。",shape=box,color=blue];
		522 -> 527;
	523 [label="哦，不。我是说，一开始，是的，你需要让自己逐渐摆脱社会教给你的所有东西。这个阶段可能是最困难的。",shape=box,color=blue];
		523 -> 528;
	526 [label="+10 Chemistry",color=orange];
		526 -> 524;
	527 [label="后来我发现这种生活不适合我。我太喜欢世俗的生活了。",shape=box,color=blue];
		527 -> 525;
	528 [label="但一旦你适应了，挑战将会是什么？诱惑？你根本看不到任何诱惑。这种生活的理念就是让你远离一切可能让你分心的事物，专注于神。",shape=box,color=blue];
		528 -> 527;
	524 [label="也不适合我。我发现我太喜欢世俗的生活了。",shape=box,color=blue];
		524 -> 525;
	525 [label="但是天啊……就像有另一个版本的我，坐在某座山顶上，周围香烟缭绕，手中拨动着黑玉和月光石的珠子，带着绝对的怜悯俯视着我。",shape=box,color=blue];
		525 -> 529;
	529 [label="我知道这只是幻想。就像亚瑟的骑士童话一样不真实。",shape=box,color=blue];
		529 -> 530;
		529 -> 531;
	530 [label="我们都幻想这有一天自己能把一切都处理得很完美。",shape=box,color=red];
		530 -> 532;
	531 [label="我经常和另一个版本的自己聊天。我们还一起吃过饭。这并不像你想的那么疯狂。",shape=box,color=red];
		531 -> 533;
	532 [label="谢谢你。不知怎的，听到这话让我感到非常安慰。",shape=box,color=blue];
		532 -> 534;
	533 [label="是的。我总是忘记，按照常人的标准来看，你经历的事情简直是彻头彻尾的疯狂。",shape=box,color=blue];
		533 -> 534;
	534 [label="你知道吗……我以前从没这么做过，但我想我会尝试联系她，万一她真的存在呢。是的。也许我能通过心灵感应联系到“埃莉诺修女”。",shape=box,color=blue];
		534 -> 535;
	535 [label="能出什么大问题呢？",shape=box,color=blue];
		535 -> 538;
	538 [label="+10 Chemistry",color=orange];
		538 -> 536;
	536 [label="我可能会从另一个自己那里得到一些指引。想象一下。哦，天哪，我现在真的很兴奋。",shape=box,color=blue];
