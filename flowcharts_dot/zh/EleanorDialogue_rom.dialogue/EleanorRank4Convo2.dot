digraph {
	1521 [label="EleanorRank4Convo2 begins.",color=orange];
		1521 -> 1522;
	1522 [label="啊，漂泊者！啊，时间与空间的流浪者！能在这小小的屏幕上见到你，真是太好了！",shape=box,color=blue];
		1522 -> 1523;
		1522 -> 1524;
	1523 [label="嗨，埃莉诺……",shape=box,color=red];
		1523 -> 1526;
	1524 [label="马上回来，卡利莫斯又在玩电线了，可能会断线。[结束]",shape=box,color=red];
		1524 -> 1525;
	1526 [label="嘿，伙计。",shape=box,color=blue];
		1526 -> 1527;
	1525 [label="Chat ends.",color=orange];
	1527 [label="猜猜我有什么话说？",shape=box,color=blue];
		1527 -> 1528;
		1527 -> 1529;
	1528 [label="你是不是有关于未来生活的问题？",shape=box,color=red];
		1528 -> 1530;
	1529 [label="你长了一条尾巴。",shape=box,color=red];
		1529 -> 1531;
	1530 [label="呃。我真容易被猜到。",shape=box,color=blue];
		1530 -> 1533;
	1531 [label="……你会喜欢的，不是吗？",shape=box,color=blue];
		1531 -> 1532;
	1533 [label="是的，有。又一个新问题。这个问题很重大，所以请耐心听我说，好吗？",shape=box,color=blue];
		1533 -> 1534;
	1532 [label="唉，没有。我的屁股并没有因为加了尾巴而变得更好。它不可能更好了，因为它已经很完美了。",shape=box,color=blue];
		1532 -> 1535;
	1534 [label="我尽量。",shape=box,color=red];
		1534 -> 1536;
	1535 [label="不过，我确实有个问题想问你。",shape=box,color=blue];
		1535 -> 1537;
	1536 [label="好的，那太好了。那么。",shape=box,color=blue];
		1536 -> 1537;
	1537 [label="你们那个时代，人们的关系是如何构建的？我的意思是，是不是还是常见的“两个或多个的成年人，以不同的正式方式在一起”？还是很多规则限制谁可以和谁在一起？",shape=box,color=blue];
		1537 -> 1538;
		1537 -> 1539;
		1537 -> 1540;
	1538 [label="我对这个还真没了解过。",shape=box,color=red];
		1538 -> 1541;
	1539 [label="这取决于文化。",shape=box,color=red];
		1539 -> 1542;
	1540 [label="……你为什么要问这个？",shape=box,color=red];
		1540 -> 1543;
	1541 [label="天哪。",shape=box,color=blue];
		1541 -> 1547;
	1542 [label="也是。当然了。",shape=box,color=blue];
		1542 -> 1548;
	1543 [label="Check boolean EleanorEntrati",color=orange];
		1543 -> 1544 [label=true,color=green];
		1543 -> 1545 [label=false,color=brown];
	1547 [label="我知道你在双衍王境里是孤立的，但我真没想到你会孤立到这种地步。",shape=box,color=blue];
		1547 -> 1552;
	1548 [label="让我来试试另一种问法。",shape=box,color=blue];
		1548 -> 1550;
	1544 [label="火卫二上的那两个人，“父亲”和“母亲”。他们是一对夫妻。虽然他们可能是庞大的、感染的前奥罗金生物，但他们的婚姻显然非常痛苦，就像我父母的一样。",shape=box,color=blue];
		1544 -> 1546;
	1545 [label="从你脑海中收集到的零星信息中，人们还是保持着传统的配对方式。他们的婚姻显然非常痛苦，就像我父母的一样。",shape=box,color=blue];
		1545 -> 1546;
	1552 [label="+15 Chemistry",color=orange];
		1552 -> 1549;
	1550 [label="来看看……",shape=box,color=blue];
		1550 -> 1554;
	1546 [label="那么，这是奥罗金的常态吗？",shape=box,color=blue];
		1546 -> 1551;
	1549 [label="如果我这个问题给你带来任何不快，我真的很抱歉。",shape=box,color=blue];
		1549 -> 1553;
	1554 [label="好吧。那在你来自的地方，一个人和一个中枢在一起，这种情况正常吗？",shape=box,color=blue];
		1554 -> 1555;
		1554 -> 1556;
	1551 [label="奥罗金人崇尚规则和禁忌。他们推崇等级制度。人与人之间的关系不能跨越社会阶层。比如说，禁卫就不能和奥罗金贵族在一起。",shape=box,color=red];
		1551 -> 1554;
	1553 [label="Chat ends.",color=orange];
	1555 [label="如果你想找到答案的话，我可以尝试将 Ordis 拖回这个时代来……",shape=box,color=red];
		1555 -> 1557;
	1556 [label="……我从未听说过这样的事，而且我不确定这是怎么做到的。",shape=box,color=red];
		1556 -> 1560;
	1557 [label="我是在问一个理论上的问题！",shape=box,color=blue];
		1557 -> 1558;
	1560 [label="可恶。我再试一次。",shape=box,color=blue];
		1560 -> 1561;
	1558 [label="我并不是真的想去和你那玻璃朋友亲密接触，无论他有多迷人。",shape=box,color=blue];
		1558 -> 1559;
	1561 [label="想象一下你那个时代的某个人，既是女性，又很危险。而且很强大。就像没有被恶魔附身的鲁莎卡少校那样。",shape=box,color=blue];
		1561 -> 1562;
		1561 -> 1563;
	1559 [label="我在尝试问你关于“权力不平等”的问题，但似乎没问出来",shape=box,color=blue];
		1559 -> 1561;
	1562 [label="一个 Grineer 狙击手？",shape=box,color=red];
		1562 -> 1564;
	1563 [label="一个禁卫？",shape=box,color=red];
		1563 -> 1565;
	1564 [label="好吧。假设有一位 Grineer 狙击手女士和一个人类互相坠入爱河。命运多舛的恋人。极其悲惨。他们能在一起吗？",shape=box,color=blue];
		1564 -> 1566;
		1564 -> 1567;
		1564 -> 1568;
		1564 -> 1569;
	1565 [label="好吧。假设有一位禁卫女士和一个卑微的人类互相坠入爱河。命运多舛的恋人。极其悲惨。他们能在一起吗？",shape=box,color=blue];
		1565 -> 1566;
		1565 -> 1567;
		1565 -> 1568;
		1565 -> 1569;
	1566 [label="如果那是他们双方都想要的，当然可以。",shape=box,color=red];
		1566 -> 1570;
	1567 [label="为什么不呢？",shape=box,color=red];
		1567 -> 1570;
	1568 [label="我倒想看看有谁会试图阻止他们。",shape=box,color=red];
		1568 -> 1570;
	1569 [label="能。但是会很难。",shape=box,color=red];
		1569 -> 1576;
	1570 [label="我在这儿越说越乱了。",shape=box,color=blue];
		1570 -> 1572;
	1576 [label="+5 Chemistry",color=orange];
		1576 -> 1571;
	1572 [label="在你们那里，人们和比自己强大得多、危险得多的人在一起，这种情况常见吗？就像《甘布利和龙的袜子》中精灵王子最后和巨人结婚一样？",shape=box,color=blue];
		1572 -> 1574;
	1571 [label="谢谢。",shape=box,color=blue];
		1571 -> 1573;
	1574 [label="……你不知道我在说什么，对吧。",shape=box,color=blue];
		1574 -> 1578;
		1574 -> 1579;
	1573 [label="问：两个体型和杀伤力差别很大的人可以谈恋爱吗？答：可以。",shape=box,color=blue];
		1573 -> 1575;
	1578 [label="实际上，我很确定我知道你在说什么。",shape=box,color=red];
		1578 -> 1582;
	1579 [label="还真是不知道。",shape=box,color=red];
		1579 -> 1580;
	1575 [label="我想知道的就是这些。",shape=box,color=blue];
		1575 -> 1577;
	1582 [label="我不想毁了你的一天。对不起。",shape=box,color=blue];
		1582 -> 1583;
	1580 [label="那我还是不问了。不然我可能会让自己出丑。",shape=box,color=blue];
		1580 -> 1581;
	1577 [label="Chat ends.",color=orange];
	1583 [label="我可以自怨自艾地抱怨一番吗？",shape=box,color=blue];
		1583 -> 1584;
		1583 -> 1585;
	1581 [label="Chat ends.",color=orange];
	1584 [label="尽管抱怨吧",shape=box,color=red];
		1584 -> 1587;
	1585 [label="我没空聊这个，抱歉。[结束]",shape=box,color=red];
		1585 -> 1586;
	1587 [label="我并不是说没有人共度一生我就活得没意义",shape=box,color=blue];
		1587 -> 1588;
	1586 [label="Chat ends.",color=orange];
	1588 [label="我不是由我所爱的人定义的",shape=box,color=blue];
		1588 -> 1589;
	1589 [label="我自己就是完整的",shape=box,color=blue];
		1589 -> 1590;
	1590 [label="但在我一激动就可能不小心杀人的情况下，我怎么可能考虑开始一场恋爱呢",shape=box,color=blue];
		1590 -> 1591;
	1591 [label="欢迎了解埃莉诺和她的交配螳螂问题",shape=box,color=blue];
		1591 -> 1592;
	1592 [label="如果我能找到那个英择谛混蛋，我会把他的蛋蛋做成耳环。如果他还有蛋蛋的话。",shape=box,color=blue];
		1592 -> 1593;
		1592 -> 1594;
	1593 [label="你可以考虑和六人组中的其他人约会啊。",shape=box,color=red];
		1593 -> 1595;
	1594 [label="等等。你之所以单身，是因为你害怕伤到别人吗？",shape=box,color=red];
		1594 -> 1596;
	1595 [label="哦我的天",shape=box,color=blue];
		1595 -> 1597;
	1596 [label="是的。",shape=box,color=blue];
		1596 -> 1601;
	1597 [label="我真的是在咬舌头，不让自己笑出声来",shape=box,color=blue];
		1597 -> 1598;
	1601 [label="我觉得你比我自己还更了解我究竟是什么。我是原型战甲。是一个部分变形的战争机器，而且那还未变形的部分似乎每天都在减少。",shape=box,color=blue];
		1601 -> 1602;
	1598 [label="在那四个人中，我唯一可以考虑约会的就是碧，但因为亚瑟，这很麻烦",shape=box,color=blue];
		1598 -> 1599;
	1602 [label="无论是谁设计了可怜的“Nyx”，他都在打造一个杀手。那就是现在的我。高效。致命。像地雷一样可爱。",shape=box,color=blue];
		1602 -> 1603;
	1599 [label="谢谢你的建议，但不行，绝对不可能",shape=box,color=blue];
		1599 -> 1600;
	1603 [label="这对于日常工作来说还行，但在办公室聚会上，谁会想在槲寄生下亲吻一个行走的死亡陷阱呢？",shape=box,color=blue];
		1603 -> 1604;
		1603 -> 1606;
	1600 [label="Chat ends.",color=orange];
	1604 [label="你担心的那种意外伤害。这种事发生过吗？你曾经伤害过和你在一起的人吗？",shape=box,color=red];
		1604 -> 1605;
	1606 [label="我的意思是，还好如果有什么意外，霍瓦尼亚重置之后没人会真的死掉……",shape=box,color=red];
		1606 -> 1607;
	1605 [label="没有，因为我根本不会允许那种事发生。好吗？",shape=box,color=blue];
		1605 -> 1608;
	1607 [label="……",shape=box,color=blue];
		1607 -> 1609;
	1608 [label="没有伴侣，就没有伤亡。不值得冒这个险。",shape=box,color=blue];
		1608 -> 1610;
	1609 [label="我以前没想到这一点。",shape=box,color=blue];
		1609 -> 1611;
	1610 [label="我宁愿孤独，也不愿背负罪恶感，谢谢。",shape=box,color=blue];
		1610 -> 1612;
	1611 [label="但我们的记忆还在。",shape=box,color=blue];
		1611 -> 1613;
	1612 [label="那么自从打了英择谛的疫苗之后你就一直单身了吗？",shape=box,color=red];
		1612 -> 1618;
	1613 [label="我不认为会有人愿意和曾经咬掉他们头的人谈恋爱，即使后来情况好转了。",shape=box,color=blue];
		1613 -> 1614;
	1618 [label="+20 Chemistry",color=orange];
		1618 -> 1615;
	1614 [label="月神啊。我现在需要喝一杯。",shape=box,color=blue];
		1614 -> 1620;
	1615 [label="没错。这是我非常愿意做出的牺牲。",shape=box,color=blue];
		1615 -> 1616;
	1620 [label="Chat ends.",color=orange];
	1616 [label="对不起。我不确定谈论这个是不是个好主意。",shape=box,color=blue];
		1616 -> 1617;
	1617 [label="我想我需要独处一会儿。",shape=box,color=blue];
		1617 -> 1619;
	1619 [label="Chat ends.",color=orange];
}