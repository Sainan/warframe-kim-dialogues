	2314 [label="Chat ends.",color=orange];
	2315 [label="我们做个交易。你去找莱蒂，让她给你做个简单的心理评估，看看到底是怎么回事，然后我们就忘掉这次谈话。",shape=box,color=blue];
		2315 -> 2316;
		2315 -> 2317;
		2315 -> 2318;
	2311 [label="我以为我已经说得很清楚了。",shape=box,color=red];
		2311 -> 2315;
	2316 [label="我不需要心理评估。喜欢你并不是什么疯狂的事。如果你对我没有同样的感觉，请直说。",shape=box,color=red];
		2316 -> 2321;
	2317 [label="如果你对我没有同样的感觉，就直说吧。",shape=box,color=red];
		2317 -> 2321;
	2318 [label="哇。好吧。没关系。",shape=box,color=red];
