	2302 [label="Chat ends.",color=orange];
	2307 [label="我很高兴你找到了你想要的东西。所有的河流最终会汇入大海。",shape=box,color=blue];
		2307 -> 2313;
	2303 [label="好吧，现在我在想我做了什么让你上当。或者操纵了你。也许我在你脑海中种下了某种暗示。",shape=box,color=blue];
		2303 -> 2308;
	2305 [label="好吧，现在我在想我做了什么让你上当。或者操纵了你。也许我在你脑海中种下了某种暗示。或者是你的体内有次级科腐者病毒，被我体内的病毒吸引。",shape=box,color=blue];
		2305 -> 2306;
	2313 [label="+20 Chemistry",color=orange];
		2313 -> 2312;
	2308 [label="或者是你的体内有次级科腐者病毒，被我体内的病毒吸引。",shape=box,color=blue];
		2308 -> 2309;
