		2844 -> 2300 [label=true,color=green];
		2844 -> 2299 [label=true,color=green];
		2844 -> 2296 [label=false,color=brown];
	2300 [label="我真的厌倦了和人们反复讨论这个问题。我不会离开。就这样。[结束]",shape=box,color=red];
		2300 -> 2301;
	2299 [label="我非常在乎这个团队。现在你们都是我的家人。这是我以前从未真正拥有过的。",shape=box,color=red];
