		2306 -> 2310;
	2312 [label="就家庭而言，这个家庭一团糟。但给我什么也不换。",shape=box,color=blue];
		2312 -> 2314;
	2309 [label="或者是（深呼吸）你真的喜欢我，就像我喜欢你一样。就这么简单吗？",shape=box,color=blue];
