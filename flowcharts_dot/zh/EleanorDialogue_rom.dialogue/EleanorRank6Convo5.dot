digraph {
	"EleanorRank6Convo5 begins." [color=orange];
		"EleanorRank6Convo5 begins." -> j1753396570;
	j1753396570 [label="我在想，就像我经常想的那样……",shape=box,color=blue];
		j1753396570 -> j2011888899;
	j2011888899 [label="一旦这个循环最终关闭，无论这是如何发生的，地球接下来会怎样？",shape=box,color=blue];
		j2011888899 -> j4215192205;
	j4215192205 [label="我知道 2000 年对你来说，已经是相当遥远的过去了，但你能告诉我我们这个小星球的未来会发生什么吗？",shape=box,color=blue];
		j4215192205 -> j2032961527;
		j4215192205 -> j1777518795;
	j2032961527 [label="恐怕，不太好。",shape=box,color=red];
		j2032961527 -> j4293489863;
	j1777518795 [label="说实话，我觉得我不该这么做。",shape=box,color=red];
		j1777518795 -> j3203885737;
	j4293489863 [label="据我所知，科腐者成为了一个全球性问题。人们用核武器来解决它——或者尝试这么做。",shape=box,color=red];
		j4293489863 -> j3584529618;
	j3203885737 [label="如果你预先知道将要发生的事情，你可能会试着改变它，而这可能意味着我永远不会存在。",shape=box,color=red];
		j3203885737 -> j4243035459;
	j3584529618 [label="第一次“辐射战争”就是这么开始的。",shape=box,color=red];
		j3584529618 -> j4174307572;
	j4243035459 [label="你可以说我自私，但我喜欢存在。",shape=box,color=red];
		j4243035459 -> j520847770;
	j4174307572 [label="……最终这个星球变得非常混乱，以至于 Orokin 想要逃离它，去其他地方生活，对吗？",shape=box,color=blue];
		j4174307572 -> j2655709654;
	j520847770 [label="哦，就像你所做的一切都没有改变未来？",shape=box,color=blue];
		j520847770 -> j4256333382;
	j2655709654 [label="……这引出了整个扎里曼事件，这就是关于你的部分。",shape=box,color=blue];
		j2655709654 -> j2637155084;
	j4256333382 [label="你可能改变了一些小细节，但大的方面基本保持不变。",shape=box,color=blue];
		j4256333382 -> j1166424659;
	j2637155084 [label="想想真奇怪，这一切都是从这座城市开始的。",shape=box,color=blue];
		j2637155084 -> j3841888550;
		j2637155084 -> j4051540225;
	j1166424659 [label="我觉得宇宙知道她要怎么做。",shape=box,color=blue];
		j1166424659 -> j4035462728;
	j3841888550 [label="也许这就是为什么今年如此重要的原因之一。",shape=box,color=red];
		j3841888550 -> j4122694068;
	j4051540225 [label="是的。从霍瓦尼亚到扎里曼 10-0 号。这是一条贯穿线。",shape=box,color=red];
		j4051540225 -> j3475090695;
	j4035462728 [label="除了不长眼的粒子胡闹之外，还有很多事情发生。",shape=box,color=blue];
		j4035462728 -> j4181400152;
		j4035462728 -> j2668745791;
	j4122694068 [label="+5 Chemistry",color=orange];
		j4122694068 -> j1051171569;
	j3475090695 [label="等等……",shape=box,color=blue];
		j3475090695 -> j2155599763;
	j4181400152 [label="我不同意你的观点。宇宙是没有思想的。",shape=box,color=red];
		j4181400152 -> j721882359;
	j2668745791 [label="我同意。如果像情感这样人性化的东西都能塑造虚空……",shape=box,color=red];
		j2668745791 -> j4137353748;
	j1051171569 [label="有道理。如果阿尔布雷希特的核弹爆炸了，是不是就意味着没有科腐者，没有衰败的地球，没必要逃跑，就没有第一次进入虚空的旅行，也没有虚空无情之物了？？",shape=box,color=blue];
		j1051171569 -> j3673731719;
	j2155599763 [label="如果你的是扎里曼 10-0号，那扎里曼的 1 到 9 会是什么情况？",shape=box,color=blue];
		j2155599763 -> j41684217;
	j721882359 [label="也许从很大或很小的角度来看，但不是你我所存在的层面上。",shape=box,color=blue];
		j721882359 -> j2996472646;
	j4137353748 [label="+5 Chemistry",color=orange];
		j4137353748 -> j1085043921;
	j3673731719 [label="……我去看看莱蒂现在有没有咖啡。 ",shape=box,color=blue];
		j3673731719 -> "Chat ends.";
	j41684217 [label="我记得，是无人机。 ",shape=box,color=red];
		j41684217 -> j2246473657;
	j2996472646 [label="如果我们能够创造意义，并且我们是宇宙的一部分，那宇宙从定义上来说就是有意义的。",shape=box,color=blue];
		j2996472646 -> j3639387957;
	j1085043921 [label="的确如此。那我们创造的意义就不仅仅是舒适的错觉。",shape=box,color=blue];
		j1085043921 -> j1825658626;
	"Chat ends." [color=orange];
	j2246473657 [label="或者中枢驾驶的地球改造舱。他们做了很多实验。",shape=box,color=red];
		j2246473657 -> j2843865059;
	j3639387957 [label="+5 Chemistry",color=orange];
		j3639387957 -> j4206962432;
	j1825658626 [label="但总有一个声音在你耳边低语，坚持说这一切都不重要。",shape=box,color=blue];
		j1825658626 -> j2123535204;
	j2843865059 [label="他们称之为“计划”。 ",shape=box,color=red];
		j2843865059 -> j3885571036;
	j4206962432 [label="我们的存在并不比夸克或超新星更不真实或有效。无论你喜不喜欢，我们都很重要。",shape=box,color=blue];
		j4206962432 -> "Chat ends.";
	j2123535204 [label="也许宇宙的重大决斗并不是在善与恶之间，而是在有意义与无意义之间？",shape=box,color=blue];
		j2123535204 -> "Chat ends.";
	j3885571036 [label="+5 Chemistry",color=orange];
		j3885571036 -> j1112453442;
	j1112453442 [label="听起来比“把我们不负责任的屁股挪到一个新的星球，然后我们可以到处祸害行动”要好得多。",shape=box,color=blue];
		j1112453442 -> "Chat ends.";
}