digraph {
	3068 [label="EleanorRank6Convo5 begins.",color=orange];
		3068 -> 3069;
	3069 [label="我在想，就像我经常想的那样……",shape=box,color=blue];
		3069 -> 3070;
	3070 [label="一旦这个循环最终关闭，无论这是如何发生的，地球接下来会怎样？",shape=box,color=blue];
		3070 -> 3071;
	3071 [label="我知道 2000 年对你来说，已经是相当遥远的过去了，但你能告诉我我们这个小星球的未来会发生什么吗？",shape=box,color=blue];
		3071 -> 3072;
		3071 -> 3074;
	3072 [label="恐怕，不太好。",shape=box,color=red];
		3072 -> 3073;
	3074 [label="说实话，我觉得我不该这么做。",shape=box,color=red];
		3074 -> 3076;
	3073 [label="据我所知，科腐者成为了一个全球性问题。人们用核武器来解决它——或者尝试这么做。",shape=box,color=red];
		3073 -> 3075;
	3076 [label="如果你预先知道将要发生的事情，你可能会试着改变它，而这可能意味着我永远不会存在。",shape=box,color=red];
		3076 -> 3078;
	3075 [label="第一次“辐射战争”就是这么开始的。",shape=box,color=red];
		3075 -> 3077;
	3078 [label="你可以说我自私，但我喜欢存在。",shape=box,color=red];
		3078 -> 3080;
	3077 [label="……最终这个星球变得非常混乱，以至于奥罗金想要逃离它，去其他地方生活，对吗？",shape=box,color=blue];
		3077 -> 3079;
	3080 [label="哦，就像你所做的一切都没有改变未来？",shape=box,color=blue];
		3080 -> 3082;
	3079 [label="……这引出了整个扎里曼事件，这就是关于你的部分。",shape=box,color=blue];
		3079 -> 3081;
	3082 [label="你可能改变了一些小细节，但大的方面基本保持不变。",shape=box,color=blue];
		3082 -> 3085;
	3081 [label="想想真奇怪，这一切都是从这座城市开始的。",shape=box,color=blue];
		3081 -> 3083;
		3081 -> 3084;
	3085 [label="我觉得宇宙知道她要怎么做。",shape=box,color=blue];
		3085 -> 3088;
	3083 [label="也许这就是为什么今年如此重要的原因之一。",shape=box,color=red];
		3083 -> 3086;
	3084 [label="是的。从霍瓦尼亚到扎里曼 10-0 号。这是一条贯穿线。",shape=box,color=red];
		3084 -> 3087;
	3088 [label="除了不长眼的粒子胡闹之外，还有很多事情发生。",shape=box,color=blue];
		3088 -> 3091;
		3088 -> 3092;
	3086 [label="+5 Chemistry",color=orange];
		3086 -> 3089;
	3087 [label="等等……",shape=box,color=blue];
		3087 -> 3090;
	3091 [label="我不同意你的观点。宇宙是没有思想的。",shape=box,color=red];
		3091 -> 3095;
	3092 [label="我同意。如果像情感这样人性化的东西都能塑造虚空……",shape=box,color=red];
		3092 -> 3096;
	3089 [label="有道理。如果阿尔布雷希特的核弹爆炸了，是不是就意味着没有科腐者，没有衰败的地球，没必要逃跑，就没有第一次进入虚空的旅行，也没有虚空无情之物了？？",shape=box,color=blue];
		3089 -> 3093;
	3090 [label="如果你的是扎里曼 10-0号，那扎里曼的 1 到 9 会是什么情况？",shape=box,color=blue];
		3090 -> 3094;
	3095 [label="也许从很大或很小的角度来看，但不是你我所存在的层面上。",shape=box,color=blue];
		3095 -> 3099;
	3096 [label="+5 Chemistry",color=orange];
		3096 -> 3100;
	3093 [label="……我去看看莱蒂现在有没有咖啡。 ",shape=box,color=blue];
		3093 -> 3097;
	3094 [label="我记得，是无人机。 ",shape=box,color=red];
		3094 -> 3098;
	3099 [label="如果我们能够创造意义，并且我们是宇宙的一部分，那宇宙从定义上来说就是有意义的。",shape=box,color=blue];
		3099 -> 3102;
	3100 [label="的确如此。那我们创造的意义就不仅仅是舒适的错觉。",shape=box,color=blue];
		3100 -> 3103;
	3097 [label="Chat ends.",color=orange];
	3098 [label="或者中枢驾驶的地球改造舱。他们做了很多实验。",shape=box,color=red];
		3098 -> 3101;
	3102 [label="+5 Chemistry",color=orange];
		3102 -> 3105;
	3103 [label="但总有一个声音在你耳边低语，坚持说这一切都不重要。",shape=box,color=blue];
		3103 -> 3106;
	3101 [label="他们称之为“计划”。 ",shape=box,color=red];
		3101 -> 3104;
	3105 [label="我们的存在并不比夸克或超新星更不真实或有效。无论你喜不喜欢，我们都很重要。",shape=box,color=blue];
		3105 -> 3108;
	3106 [label="也许宇宙的重大决斗并不是在善与恶之间，而是在有意义与无意义之间？",shape=box,color=blue];
		3106 -> 3109;
	3104 [label="+5 Chemistry",color=orange];
		3104 -> 3107;
	3108 [label="Chat ends.",color=orange];
	3109 [label="Chat ends.",color=orange];
	3107 [label="听起来比“把我们不负责任的屁股挪到一个新的星球，然后我们可以到处祸害行动”要好得多。",shape=box,color=blue];
		3107 -> 3110;
	3110 [label="Chat ends.",color=orange];
}