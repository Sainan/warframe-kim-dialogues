	j3177550690 [label="+5 Chemistry",color=orange];
		j3177550690 -> j3940605120;
	j878361655 [label="好吧。",shape=box,color=blue];
		j878361655 -> j2728623953;
	j243413784 [label="我的意思是，这并不糟糕",shape=box,color=blue];
		j243413784 -> j1714100672;
	j1416399235 [label="我觉得你一定明白我的意思，但我会真诚地接受你的回答。",shape=box,color=blue];
		j1416399235 -> j3388545624;
	j3940605120 [label="太棒了。这显然是自然免疫的典型案例！",shape=box,color=blue];
		j3940605120 -> j3864254554;
	j2728623953 [label="据我所知，你绝不是唯一有这种想法的人",shape=box,color=blue];
		j2728623953 -> j2496015009;
	j1714100672 [label="不过我实在无法认真对待这件事。这是有原因的。",shape=box,color=blue];
		j1714100672 -> j2496015009;
	j3388545624 [label="大多数时候，亚瑟说话就像一个正常人，但有时他会用那种声音说话。",shape=box,color=blue];
		j3388545624 -> j433682659;
	j3864254554 [label="我们必须确保把你的遗体捐献给医学科学。",shape=box,color=blue];
		j3864254554 -> "Chat ends.";
	j2496015009 [label="……我只是想让你知道，对我来说，那永远都是他的安格斯玩偶声音。",shape=box,color=blue];
		j2496015009 -> j2336300181;
	j433682659 [label="这就像听着有人用水泥搅拌机给你调制一杯睾酮奶昔。",shape=box,color=blue];
		j433682659 -> j2429358884;
	"Chat ends." [color=orange];
	j2336300181 [label="“保持冷静，让专业人士来处理这件事” 八岁的亚瑟低吼道，当时安格斯玩偶和塑料特种兵正在从恐龙军队中营救我的桑迪娃娃",shape=box,color=blue];
		j2336300181 -> j3803199467;
	j2429358884 [label="非常粗糙，你甚至可以从里面挑出新石器时代的斧头。",shape=box,color=blue];
