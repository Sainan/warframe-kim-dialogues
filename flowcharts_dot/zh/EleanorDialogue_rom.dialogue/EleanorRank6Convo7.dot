		j2777140845 -> j3728970420;
	j3314916673 [label="你对他已经相当了解了，毕竟我们作为一个团队一起经历了那么多",shape=box,color=blue];
		j3314916673 -> j3728970420;
	j3728970420 [label="我只是想知道：",shape=box,color=blue];
		j3728970420 -> j1327964116;
	j1327964116 [label="当他用那个声音说话的时候你是怎么应付的？",shape=box,color=blue];
		j1327964116 -> j487974251;
		j1327964116 -> j3860091636;
		j1327964116 -> j3932113318;
		j1327964116 -> j67337452;
	j487974251 [label="对我没什么影响。",shape=box,color=red];
