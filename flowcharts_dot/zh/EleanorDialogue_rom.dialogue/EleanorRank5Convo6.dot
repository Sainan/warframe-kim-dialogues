digraph {
	2541 [label="EleanorRank5Convo6 begins.",color=orange];
		2541 -> 2542;
	2542 [label="你可能会注意到今天早上商场的气氛有点不一样。",shape=box,color=blue];
		2542 -> 2543;
	2543 [label="没有什么大的明显区别。只是更多人在微笑。时不时传来一阵笑声。空气中弥漫着一丝幸福。",shape=box,color=blue];
		2543 -> 2544;
		2543 -> 2545;
	2544 [label="那是你做的，对吧？",shape=box,color=red];
		2544 -> 2547;
	2545 [label="马上回来。[结束]",shape=box,color=red];
		2545 -> 2546;
	2547 [label="这只是我回馈的方式。你知道，一个心灵感应者既能发送信息，也能接收信息。它不一定是对一个人的强力喷射。它可以像细雾一样喷洒在一个区域上。",shape=box,color=blue];
		2547 -> 2548;
	2546 [label="Chat ends.",color=orange];
	2548 [label="你们那里有草坪洒水器吗？",shape=box,color=blue];
		2548 -> 2549;
		2548 -> 2550;
	2549 [label="我们有环管-独立机和像她一样的无人机。它们负责照料扎里曼号上的植物。你是指这种东西吗？",shape=box,color=red];
		2549 -> 2551;
	2550 [label="洒水……器？",shape=box,color=red];
		2550 -> 2552;
	2551 [label="可以这么说。",shape=box,color=blue];
		2551 -> 2553;
	2552 [label="是的，亲爱的，洒水器。洒水器可以让你的草坪保持湿润。",shape=box,color=blue];
		2552 -> 2554;
	2553 [label="我小时候很喜欢草坪洒水器。它们太神奇了。阳光最灿烂的时候，你可以在它们当中看到彩虹。穿过它们时，浑身都能感到一阵凉爽。",shape=box,color=blue];
		2553 -> 2555;
	2554 [label="也是把你弟弟的脸按上去直到他尖叫的理想工具。",shape=box,color=blue];
		2554 -> 2555;
	2555 [label="“幸福是一个草坪洒水器”。把这句话放在贺卡上吧。",shape=box,color=blue];
		2555 -> 2556;
	2556 [label="你今天看起来心情不错。看到你这样我很高兴。",shape=box,color=red];
		2556 -> 2557;
	2557 [label="是的。我不觉得有必要把这种心情只留给自己。所以我把它扩散到整个商场。",shape=box,color=blue];
		2557 -> 2558;
		2557 -> 2559;
		2557 -> 2560;
	2558 [label="这不是有点像给人下药吗？",shape=box,color=red];
		2558 -> 2561;
	2559 [label="传播积极情绪？为什么不呢？我看不出这和放音乐有什么不同。",shape=box,color=red];
		2559 -> 2562;
	2560 [label="那么今天我可能会看到亚瑟微笑吗？",shape=box,color=red];
		2560 -> 2563;
	2561 [label="……真好。我本来想做一个散播欢乐的秘密幸福小仙女，结果却变成了邪恶的毒品小妖精。我的好心情一落千丈。",shape=box,color=blue];
		2561 -> 2564;
	2562 [label="哦！好比喻！",shape=box,color=blue];
		2562 -> 2566;
	2563 [label="也许。我希望如此。他忍受了太多。",shape=box,color=blue];
		2563 -> 2567;
	2564 [label="好吧。我会停下来。",shape=box,color=blue];
		2564 -> 2565;
	2566 [label="如果碧可以通过音乐来影响心情，那么我也可以通过氛围做到，对吧？",shape=box,color=blue];
		2566 -> 2568;
	2567 [label="自从你来后，很多事情都变了。我指的不只是你和我。我指的是所有的一切。甚至是商场。",shape=box,color=blue];
		2567 -> 2568;
	2565 [label="Chat ends.",color=orange];
	2568 [label="我很高兴碧说服我留下。感谢她。",shape=box,color=blue];
		2568 -> 2569;
		2568 -> 2570;
	2569 [label="等等。她做了什么？",shape=box,color=red];
		2569 -> 2571;
	2570 [label="倒回去一下。我错过了什么。",shape=box,color=red];
		2570 -> 2571;
	2571 [label="我没有告诉你吗？",shape=box,color=blue];
		2571 -> 2572;
	2572 [label="啊。这是你来之前不久的事。那天我们整天都在外面试图清除一个科腐者巢穴。空气中弥漫着一种凶险的紧张气氛。战斗通常能消磨我们的怒气，让我们筋疲力尽，无法对彼此发脾气，但那一天不同。",shape=box,color=blue];
		2572 -> 2573;
	2573 [label="我记得亚瑟说了类似“我们明天再做一遍”这样的话，这对我们来说就像是一个重拳。在回商场的路上，没有人说一句话。",shape=box,color=blue];
		2573 -> 2574;
		2573 -> 2575;
		2573 -> 2576;
	2574 [label="哇哦。亚瑟，真是个“提升团队士气”的好办法。",shape=box,color=red];
		2574 -> 2579;
	2575 [label="他可真会讨人喜欢……",shape=box,color=red];
		2575 -> 2579;
	2576 [label="他肩上担负着很多责任。这对他的影响很大。",shape=box,color=red];
		2576 -> 2577;
	2579 [label="我想他只是想让我们集中精力工作。但我感觉自己快崩溃了。亚瑟和碧不再说话，阿米尔一直在烦昆西，我开始担心他的生命，而莱蒂一有机会就冷眼看我。",shape=box,color=blue];
		2579 -> 2580;
	2577 [label="是的。通常他都能掩饰得很好，即使是在精疲力竭的时候。但我想他已经没有余力了。",shape=box,color=blue];
		2577 -> 2578;
	2580 [label="那天我花了很多时间照镜子。我不断幻想镜子里的我抓住我的喉咙并嘶声说“你就是问题所在。如果不是因为你，这一切都不会发生。”",shape=box,color=blue];
		2580 -> 2581;
		2580 -> 2582;
	2578 [label="为了维持团队的团结，他已经透支了自己。",shape=box,color=blue];
		2578 -> 2579;
	2581 [label="听起来这次反而像是别人进入了你的脑海。",shape=box,color=red];
		2581 -> 2583;
	2582 [label="这听起来像是莱蒂会说的废话。",shape=box,color=red];
		2582 -> 2584;
	2583 [label="哦，这不是他们。这是我自己。在一那天，我一直压抑的自我怀疑和自我憎恨全都涌上心头。",shape=box,color=blue];
		2583 -> 2585;
	2584 [label="谢谢你。我知道你会支持我，这对我来说很重要。",shape=box,color=blue];
		2584 -> 2586;
	2585 [label="我心里想：这个团队需要的是一个替罪羊。",shape=box,color=blue];
		2585 -> 2587;
	2586 [label="这句话我听莱蒂说了无数次了，最后我心想：也许她是对的。我留在这里会让每个人都处于危险之中。",shape=box,color=blue];
		2586 -> 2588;
	2587 [label="一个怪物。一个可以归咎的人。",shape=box,color=blue];
		2587 -> 2588;
	2588 [label="我想出了一个完整的计划。我会在夜里溜走，躲在城里某个亚瑟永远找不到的地方，然后——这是我最自豪的部分——继续在远处帮助他们。",shape=box,color=blue];
		2588 -> 2589;
		2588 -> 2590;
	2589 [label="我觉得他还是能找到你。他很有决心的。",shape=box,color=red];
		2589 -> 2591;
	2590 [label="更可能的情况是，他会在找你的过程中死去。",shape=box,color=red];
		2590 -> 2592;
	2591 [label="怎么找到？阿米尔无法追踪心灵感应。",shape=box,color=blue];
		2591 -> 2593;
	2592 [label="想让我感到内疚吗？",shape=box,color=blue];
		2592 -> 2594;
	2593 [label="我将会是一个高尚的流亡者。我会蹲在屋顶上，看起来被风吹得凌乱，却目光坚定。我可以报告科腐者的集结情况，让六人组知道炽蛇军在哪里设置路障，甚至充当紧急通讯中继。每次我救了莱蒂的命，我一定要让她感受到。小气？绝对是。",shape=box,color=blue];
		2593 -> 2595;
	2594 [label="别费心了。我已经够难受了。",shape=box,color=blue];
		2594 -> 2598;
	2595 [label="我选择了合适的时机。我等到阿米尔睡着了。然后穿上一件长外套，悄无声息地走向车库。",shape=box,color=blue];
		2595 -> 2596;
	2598 [label="Chat ends.",color=orange];
	2596 [label="防盗栅栏自动落了下来。我转过身，碧就在那里。",shape=box,color=blue];
		2596 -> 2597;
	2597 [label="我们彻夜长谈，相拥而泣。她也很受伤，非常深。等到太阳升起时，我决定留下。",shape=box,color=blue];
		2597 -> 2599;
		2597 -> 2600;
		2597 -> 2601;
	2599 [label="现在还有时间改变主意。",shape=box,color=red];
		2599 -> 2602;
	2600 [label="碧太棒了。我很高兴她在那里陪伴你。",shape=box,color=red];
		2600 -> 2604;
	2601 [label="真幸运。",shape=box,color=red];
		2601 -> 2604;
	2602 [label="不管是什么怪诞的冲动让你写下句话，我希望你被它呛到。",shape=box,color=blue];
		2602 -> 2603;
	2604 [label="+20 Chemistry",color=orange];
		2604 -> 2605;
	2603 [label="Chat ends.",color=orange];
	2605 [label="是的。我想，在除夕夜，我们六个人都应该在这里。当然还有你。门外带来好运的陌生人。",shape=box,color=blue];
		2605 -> 2606;
	2606 [label="Chat ends.",color=orange];
}