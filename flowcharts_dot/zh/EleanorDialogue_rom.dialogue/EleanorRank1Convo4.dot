digraph {
	220 [label="EleanorRank1Convo4 begins.",color=orange];
		220 -> 221;
	221 [label="那是什么感觉？在一个瘟疫肆虐的城市里自由自在地闲逛，而且知道自己永远不用担心被感染？",shape=box,color=blue];
		221 -> 222;
		221 -> 223;
