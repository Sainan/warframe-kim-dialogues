	231 [label="我不认为你能被杀死。至少不会永远被杀死。而且我知道，有人曾经多么努力地试过。",shape=box,color=blue];
		231 -> 236;
	256 [label="让人不禁疑惑他为何没被感染。毕竟，他的家人都被感染了。",shape=box,color=blue];
		256 -> 263;
	257 [label="至少他设法保全了自己免于感染。或许他比你想象的更像你。",shape=box,color=blue];
