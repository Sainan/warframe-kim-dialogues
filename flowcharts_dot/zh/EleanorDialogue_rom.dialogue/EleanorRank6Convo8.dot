	j561122810 [label="谢谢，朋友。",shape=box,color=blue];
		j561122810 -> j2111913889;
	j1280612545 [label="亲爱的，谢谢你。",shape=box,color=blue];
		j1280612545 -> j2111913889;
	j2111913889 [label="我是个雷区吗？",shape=box,color=blue];
		j2111913889 -> j2603365245;
	j2603365245 [label="因为卡娅这么说我。当我回想起和某人的所有对话时，我有一种“哦，糟糕！”的感觉，然后突然对自己有了新的认识。",shape=box,color=blue];
		j2603365245 -> j2999172280;
		j2603365245 -> j3509288260;
		j2603365245 -> j1703305666;
	j2999172280 [label="不，你不是雷区。",shape=box,color=red];
		j2999172280 -> j3063591171;
	j3509288260 [label="我觉得我明白她的意思，是啊。抱歉，但她说得有道理。",shape=box,color=red];
		j3509288260 -> j2649918825;
	j1703305666 [label="等等，卡娅这么说的？",shape=box,color=red];
		j1703305666 -> j3509151009;
	j3063591171 [label="+5 Chemistry",color=orange];
		j3063591171 -> j1253584881;
	j2649918825 [label="哦。",shape=box,color=blue];
		j2649918825 -> j3852765947;
		j2649918825 -> j1758747730;
	j3509151009 [label="是的。她在我们聊天的时候突然说了这句话。“你很酷，但你就像个雷区。我永远不知道你会对什么事情有什么反应。”",shape=box,color=blue];
		j3509151009 -> j2999172280;
		j3509151009 -> j3509288260;
	j1253584881 [label="很高兴你这么说。谢谢你。",shape=box,color=blue];
		j1253584881 -> j1533866915;
	j3852765947 [label="我很高兴卡娅告诉了你。我在这里说过一些我以为无伤大雅的话，而你的反应却像是我把你的头发点着了似的。",shape=box,color=red];
		j3852765947 -> j1645512948;
		j3852765947 -> j1416744573;
	j1758747730 [label="有时候，你的反应真的很大惊小怪，跟我和你说的话完全不符。",shape=box,color=red];
		j1758747730 -> j1416744573;
		j1758747730 -> j1645512948;
	j1533866915 [label="青少年，诶？ ",shape=box,color=blue];
		j1533866915 -> "Chat ends.";
	j1645512948 [label="就像是你对我想表达的意思直接做出了最糟糕的解释。",shape=box,color=red];
		j1645512948 -> j3246443122;
	j1416744573 [label="有时候你完全不说话，我甚至没机会解释。",shape=box,color=red];
		j1416744573 -> j3246443122;
	j3246443122 [label="行。",shape=box,color=blue];
		j3246443122 -> j4200288552;
	j4200288552 [label="现在我就想退出，以后再也不用即时通了。",shape=box,color=blue];
		j4200288552 -> j1710677258;
		j4200288552 -> j348479541;
	j1710677258 [label="或许想想你刚才说的话？",shape=box,color=red];
		j1710677258 -> j2925716530;
	j348479541 [label="就是这样。砰。雷区。",shape=box,color=red];
		j348479541 -> j1583687557;
		j348479541 -> j2925716530;
	j2925716530 [label="你还不明白吗？",shape=box,color=red];
		j2925716530 -> j79458339;
	j1583687557 [label="我觉得你需要点时间好好想想。[结束]",shape=box,color=red];
		j1583687557 -> "Chat ends.";
	j79458339 [label="好的。好的。听我说完。",shape=box,color=blue];
		j79458339 -> j709645534;
	j709645534 [label="拜托了。",shape=box,color=blue];
		j709645534 -> j1558553095;
	j1558553095 [label="牢记这一点：",shape=box,color=blue];
		j1558553095 -> j3603099780;
	j3603099780 [label="我有心灵感应。虽然我没要求过。但我的确有。我能感知别人的想法。",shape=box,color=blue];
		j3603099780 -> j4207884588;
	j4207884588 [label="如果我们面对面说话，我就会对你的感受有各种各样的线索",shape=box,color=blue];
		j4207884588 -> j1440107560;
	j1440107560 [label="表情、肢体语言，嘿，有时候甚至是实际的想法，因为，就像我说的，心灵感应",shape=box,color=blue];
		j1440107560 -> j950502145;
	j950502145 [label="但在即时通上，我只能猜，而且没有任何线索",shape=box,color=blue];
		j950502145 -> j1808724742;
	j1808724742 [label="所以是的，我有时候会有下意识的反应。",shape=box,color=blue];
		j1808724742 -> j1772870569;
		j1808724742 -> j2751811886;
	j1772870569 [label="不是吧。",shape=box,color=red];
		j1772870569 -> j4120549079;
	j2751811886 [label="是的，你的确如此。",shape=box,color=red];
		j2751811886 -> j4120549079;
	j4120549079 [label="对。所以。",shape=box,color=blue];
		j4120549079 -> j526522950;
	j526522950 [label="（深呼吸，坐直，振作起来，埃莉诺）",shape=box,color=blue];
		j526522950 -> j3644726804;
	j3644726804 [label="我会尽力，以后不再成为雷区。",shape=box,color=blue];
		j3644726804 -> j1477108902;
	j1477108902 [label="我会回顾我们以前的聊天记录，然后好好想想。",shape=box,color=blue];
		j1477108902 -> j4001491239;
	j4001491239 [label="我欠你的。因为不管是不是雷区，你都在这里。你一直在前行。x",shape=box,color=blue];
