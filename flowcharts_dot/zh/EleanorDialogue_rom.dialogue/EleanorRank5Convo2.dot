digraph {
	2175 [label="EleanorRank5Convo2 begins.",color=orange];
		2175 -> 2176;
	2176 [label="好了。我冷静下来了，并且已经做好了充分的心理准备。",shape=box,color=blue];
		2176 -> 2177;
	2177 [label="我能和你聊聊克里斯托弗吗？",shape=box,color=blue];
		2177 -> 2178;
	2178 [label="Check boolean EleanorChristopher1",color=orange];
		2178 -> 2184 [label=true,color=green];
		2178 -> 2180 [label=true,color=green];
		2178 -> 2185 [label=true,color=green];
		2178 -> 2179 [label=false,color=brown];
		2178 -> 2185 [label=false,color=brown];
	2184 [label="我在听。",shape=box,color=red];
		2184 -> 2186;
	2180 [label="我为什么需要了解他？",shape=box,color=red];
		2180 -> 2187;
	2185 [label="[无视]",shape=box,color=red];
		2185 -> 2181;
	2179 [label="谁是克里斯托弗？",shape=box,color=red];
		2179 -> 2182;
	2186 [label="谢谢。",shape=box,color=blue];
		2186 -> 2188;
	2187 [label="因为我失去了他，他是我非常亲近的人。",shape=box,color=blue];
		2187 -> 2188;
	2181 [label="Chat ends.",color=orange];
	2182 [label="亚瑟最好的朋友。我们订了婚。我以为我很爱他。",shape=box,color=blue];
		2182 -> 2183;
	2188 [label="Check boolean EleanorDating",color=orange];
		2188 -> 2189 [label=true,color=green];
		2188 -> 2190 [label=false,color=brown];
	2183 [label="Update boolean EleanorChristopher1",color=orange];
		2183 -> 2184;
		2183 -> 2180;
	2189 [label="既然你和我现在的关系更加亲近了（在很多令人愉快的方面），你真的应该了解一下你将要深入交往的人。",shape=box,color=blue];
		2189 -> 2191;
	2190 [label="如果我说错了，请纠正我，但最近我感觉你和我不仅仅是队友。",shape=box,color=blue];
		2190 -> 2193;
	2191 [label="我已经看过你的内心，但你还没看过我的。",shape=box,color=blue];
		2191 -> 2192;
	2193 [label="Check boolean EleanorConfession",color=orange];
		2193 -> 2194 [label=true,color=green];
		2193 -> 2195 [label=false,color=brown];
	2192 [label="所以，请做好准备，耐心听我说。",shape=box,color=blue];
		2192 -> 2197;
	2194 [label="你已经很明确地向我表达了你的感受，我很感激。",shape=box,color=blue];
		2194 -> 2196;
	2195 [label="我们绝对是朋友。也许不止如此。但我们仍在彼此周围徘徊，等待对方先迈出第一步。",shape=box,color=blue];
		2195 -> 2196;
	2197 [label="我想告诉你关于克里斯托弗的事，因为我觉得你有权知道。",shape=box,color=blue];
		2197 -> 2198;
		2197 -> 2199;
	2196 [label="我非常喜欢你。我信任你。你有很多机会像莱蒂那样把我当成怪物，但你没有这样做。别以为我没注意到。",shape=box,color=blue];
		2196 -> 2197;
	2198 [label="说吧。",shape=box,color=red];
		2198 -> 2202;
	2199 [label="我没空聊这个。[结束]",shape=box,color=red];
		2199 -> 2200;
	2202 [label="他比亚瑟和我大几岁。我记得他没有哪天是不在我身边的。我们的父母是朋友，所以他总是来我们家玩。",shape=box,color=blue];
		2202 -> 2203;
	2200 [label="适时退出与朋友的谈话是对的。这次不是那种时候。",shape=box,color=blue];
		2200 -> 2201;
	2203 [label="他过去经常和亚瑟在庄园后面的树林里玩士兵游戏。克里斯托弗是指挥官，亚瑟是忠诚的中尉。如果他们让我加入，我得扮演护士。",shape=box,color=blue];
		2203 -> 2204;
	2201 [label="Chat ends.",color=orange];
	2204 [label="我希望爸爸看到亚瑟为了救他的指挥官而英勇地扑向松果手榴弹，会想“嗯，我儿子对这种军事游戏太痴迷了，或许我该告诉他，真枪实弹的战斗并不像他想象的那么有趣。”",shape=box,color=blue];
		2204 -> 2205;
		2204 -> 2206;
		2204 -> 2207;
	2205 [label="你觉得亚瑟会听从他的话吗？",shape=box,color=red];
		2205 -> 2210;
	2206 [label="我觉得，从各方面来看，一切还算不错。",shape=box,color=red];
		2206 -> 2209;
	2207 [label="但如果亚瑟听了他的话，我们就永远不会相遇了。:)",shape=box,color=red];
		2207 -> 2208;
	2210 [label="大概不会。他只会认为这是爸爸在考验他。",shape=box,color=blue];
		2210 -> 2216;
	2209 [label="从某些方面来说，是的。",shape=box,color=blue];
		2209 -> 2211;
	2208 [label="是的，我们的相遇确实是我生命中难得的恩赐。",shape=box,color=blue];
		2208 -> 2212;
	2216 [label="总之，一个又一个的夏天过去了。我们渐渐长大成人。那时候既尴尬又多汗，充满荷尔蒙。有派对，也有考试。克里斯托弗去上大学了。家里养的狗死了，我们又养了一只新的。这些都可以做成个蒙太奇。",shape=box,color=blue];
		2216 -> 2217;
	2211 [label="但我其实是在跟你说一件失去亲人的事。",shape=box,color=blue];
		2211 -> 2215;
	2212 [label="但我宁愿这一切没有这么大的代价。",shape=box,color=blue];
		2212 -> 2213;
	2217 [label="突然有一天，我走进厨房，看到了一个穿制服的青年，我心里暗自感慨，我人生中第二次心里直呼“哗嗷”。",shape=box,color=blue];
		2217 -> 2218;
		2217 -> 2219;
	2215 [label="现在真的不适合去找什么好的一面。",shape=box,color=blue];
		2215 -> 2216;
	2213 [label="尤其是当我还没告诉你这些伤痕有多深。",shape=box,color=blue];
		2213 -> 2214;
	2218 [label="不好意思，那是什么声音？我没看清楚。:P",shape=box,color=red];
		2218 -> 2220;
	2219 [label="那谁是第一个？",shape=box,color=red];
		2219 -> 2222;
	2214 [label="Chat ends.",color=orange];
	2220 [label="“哗嗷”？",shape=box,color=blue];
		2220 -> 2221;
	2222 [label="曼迪·杰利科。我的暗恋对象。她辍学了，染了头发，打了耳洞，穿着皮夹克在城里到处闲逛，抽着烟，瞪着任何靠近的人。我一看到她，就感觉自己的骨头都酥了。",shape=box,color=blue];
		2222 -> 2223;
	2221 [label="这是不列颠尼克人表达惊叹的传统方式。应以低沉的咆哮声和鼓起双颊的方式发出。",shape=box,color=blue];
		2221 -> 2223;
	2223 [label="总之。这不重要。",shape=box,color=blue];
		2223 -> 2224;
	2224 [label="那你和克里斯托弗……",shape=box,color=red];
		2224 -> 2225;
	2225 [label="是的。他很善良。英俊。强壮。也很容易被激起斗志，这是一个很大的优点。不过他一心想加入军队。",shape=box,color=blue];
		2225 -> 2226;
	2226 [label="我们在这点上意见不一。对他来说，这是一种使命。他会去帮助那些需要帮助的人，为世界带来改变。他和亚瑟一样，对那套男子汉英雄主义深信不疑。",shape=box,color=blue];
		2226 -> 2227;
	2227 [label="Check boolean EleanorHeroVirus",color=orange];
		2227 -> 2228 [label=true,color=green];
		2227 -> 2229 [label=true,color=green];
		2227 -> 2230 [label=true,color=green];
		2227 -> 2229 [label=false,color=brown];
		2227 -> 2230 [label=false,color=brown];
	2228 [label="我知道你很反感英雄这个概念。这就是原因吗？",shape=box,color=red];
		2228 -> 2231;
	2229 [label="他说得对。只有人们愿意为更美好的世界而战，才能带来改变。",shape=box,color=red];
		2229 -> 2233;
	2230 [label="这是个很有吸引力的想法。人们想要帮忙。这一点很容易被利用。",shape=box,color=red];
		2230 -> 2236;
	2231 [label="是的。我恨它影响了克里斯托弗，也恨它现在仍在影响亚瑟，恨它影响了许多像他们一样的人。",shape=box,color=blue];
		2231 -> 2232;
	2233 [label="你是可以为更美好的世界而战，并不需要相信那些英雄废话！",shape=box,color=blue];
		2233 -> 2234;
	2236 [label="我曾对他说：“你为什么想为一个根本不在乎你的王子去杀人？”他会伤心，因为这并不是为了国王的命令。对他而言，这是为了消灭那些囤积食物、并强迫政治犯在红化结晶矿场劳作至死的军阀。",shape=box,color=blue];
		2236 -> 2237;
	2232 [label="我并不反对道德观念。天知道我自己甚至也有一些。可那套所谓的英雄故事完全是害人的废话。",shape=box,color=blue];
		2232 -> 2237;
	2234 [label="英雄病毒的本质就是它是种病毒。它不关心宿主。它让你相信，为某个理想牺牲是体面且高尚的，而不是一种他妈的无谓牺牲。",shape=box,color=blue];
		2234 -> 2235;
	2237 [label="我本以为我能说服克里斯托弗放弃当兵。如果说服不了，那就用亲吻让他放弃。",shape=box,color=blue];
		2237 -> 2238;
		2237 -> 2239;
		2237 -> 2240;
		2237 -> 2241;
	2235 [label="Chat ends.",color=orange];
	2238 [label="这样做有点自大了。",shape=box,color=red];
		2238 -> 2242;
	2239 [label="我在准备好听那个“但是”。",shape=box,color=red];
		2239 -> 2244;
	2240 [label="听起来他已经下定决心了。",shape=box,color=red];
		2240 -> 2247;
	2241 [label="……提醒自己：与埃莉诺争论……",shape=box,color=red];
		2241 -> 2248;
	2242 [label="是的，那又怎样？",shape=box,color=blue];
		2242 -> 2243;
	2244 [label="我需要明说吗？",shape=box,color=blue];
		2244 -> 2245;
	2247 [label="+10 Chemistry",color=orange];
		2247 -> 2246;
	2248 [label="……现在不是时候。",shape=box,color=blue];
		2248 -> 2249;
	2243 [label="我当时只想救他的命。就算是不择手段我也在所不惜。",shape=box,color=blue];
		2243 -> 2251;
	2245 [label="我陷入了自己试图布下的网中。",shape=box,color=blue];
		2245 -> 2251;
	2246 [label="是的。当然，那时已经太迟了。我本以为我会迷住他，但事实是，他迷住了我。",shape=box,color=blue];
		2246 -> 2250;
	2249 [label="这对我来说并不容易，所以请你挑个更好的时机",shape=box,color=blue];
		2249 -> 2251;
	2251 [label="我告诉他我怀孕了。他提出要娶我。真是个又傻又帅气的白痴。",shape=box,color=blue];
		2251 -> 2252;
	2250 [label="我很抱歉。我无法在不哭的情况下说完这些，所以如果我回复得慢，至少你知道原因了。",shape=box,color=blue];
		2250 -> 2251;
	2252 [label="你真的怀孕了？",shape=box,color=red];
		2252 -> 2253;
	2253 [label="没有。但我以为我怀了。如果你想问的是这个，我并没有故意要骗他。",shape=box,color=blue];
		2253 -> 2254;
	2254 [label="亚瑟高兴得像在云端上跳舞。他视为兄弟的那个人即将成为他的姐夫。",shape=box,color=blue];
		2254 -> 2255;
	2255 [label="然后一切都进入快进。什么先发制人的战略。边界和封锁、升级风险、还有该死的道德任务。克里斯托弗被派遣出去，亚瑟已经在报名，所有的男孩都去了赤色守望，而我妈妈仍在忙着安排婚礼座位。",shape=box,color=blue];
		2255 -> 2256;
		2255 -> 2257;
	2256 [label="那后来怎么样了？",shape=box,color=red];
		2256 -> 2258;
	2257 [label="你还能继续说下去吗？",shape=box,color=red];
		2257 -> 2258;
	2258 [label="他们杀了他。那些我们本来去帮助的人。他们用化肥和石工钉制成的炸弹炸毁了他的车。",shape=box,color=blue];
		2258 -> 2259;
	2259 [label="我告诉自己“至少他是瞬间死去的。”“至少他没有受苦”但据我所知，他死的时候可能眼中插着钉子，一直尖叫。",shape=box,color=blue];
		2259 -> 2260;
	2260 [label="妈的",shape=box,color=blue];
		2260 -> 2261;
	2261 [label="真他妈的",shape=box,color=blue];
		2261 -> 2262;
		2261 -> 2263;
	2262 [label="至少他在死的时候认为他是在做对的事……",shape=box,color=red];
		2262 -> 2264;
	2263 [label="我很抱歉……",shape=box,color=red];
		2263 -> 2266;
	2264 [label="我觉得你完全没有注意看我说的话",shape=box,color=blue];
		2264 -> 2265;
	2266 [label="我当然哭了，但我一直在想“你期待什么呢，你这个愚蠢的女孩，你知道你会遇到什么，你知道这会发生“",shape=box,color=blue];
		2266 -> 2267;
	2265 [label="我不想听那些“至少……”。他是因为一个愚蠢的原因，以一种愚蠢的方式死的",shape=box,color=blue];
		2265 -> 2269;
	2267 [label="这样告诉你，感觉就像是老套的民歌",shape=box,color=blue];
		2267 -> 2268;
	2269 [label="Check boolean EleanorDating",color=orange];
		2269 -> 2270 [label=true,color=green];
		2269 -> 2271 [label=false,color=brown];
	2268 [label="我的爱人去参战了，唱着欢快的歌，哦不，他死了，我将在寂静的山谷中徘徊，再也不会嫁给别人",shape=box,color=blue];
		2268 -> 2279;
	2270 [label="如果你在我谈论这些时都没有在看，那你还有什么没看到的？虽然我们之间的一切很美好……但不。这是一个错误。",shape=box,color=blue];
		2270 -> 2272;
	2271 [label="如果你在我谈论这些时都没有在看，那你还有什么没看到的？",shape=box,color=blue];
		2271 -> 2273;
	2279 [label="对不起。埃莉诺，振作点。",shape=box,color=blue];
		2279 -> 2280;
	2272 [label="这整件事都是一个错误。我们结束了。",shape=box,color=blue];
		2272 -> 2275;
	2273 [label="Update boolean EleanorNoDate",color=orange];
		2273 -> 2274;
	2280 [label="我想他会喜欢你的。",shape=box,color=blue];
		2280 -> 2281;
	2275 [label="Update boolean IsDating",color=orange];
		2275 -> 2276;
	2274 [label="Chat ends.",color=orange];
	2281 [label="+10 Chemistry",color=orange];
		2281 -> 2282;
	2276 [label="Update boolean EleanorDating",color=orange];
		2276 -> 2277;
	2282 [label="我得去整理一下了。待会儿再聊。",shape=box,color=blue];
		2282 -> 2283;
	2277 [label="Update boolean EleanorNoDate",color=orange];
		2277 -> 2278;
	2283 [label="Update boolean EleanorChristopher2",color=orange];
		2283 -> 2284;
	2278 [label="Chat ends.",color=orange];
