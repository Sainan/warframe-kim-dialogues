digraph {
	1906 [label="EleanorRank4Convo6 begins.",color=orange];
		1906 -> 1907;
		1906 -> 1908;
	1907 [label="所以……为什么是水晶？",shape=box,color=red];
		1907 -> 1909;
	1908 [label="那么。你和昆西。你们有没有……你懂的？",shape=box,color=red];
		1908 -> 1910;
	1909 [label="哦，我一直都很喜欢它们。小时候，我爸爸带我们去过拉德斯顿的创新博物馆，我和亚瑟都买了这些水晶种植套装。亚瑟种出来一坨屎，真的是长得跟屎一样的小石头。后来它被扔进了垃圾箱。我的是一颗美丽的蓝色钻石。从那天起，不知道为什么，我一直觉得水晶是属于我这边的。",shape=box,color=blue];
		1909 -> 1912;
	1910 [label="好，我今天感觉很大方，所以我免费告诉你这个。",shape=box,color=blue];
		1910 -> 1911;
	1912 [label="那么它们只是用来装饰吗？",shape=box,color=red];
		1912 -> 1916;
	1911 [label="我们从来没有。连一点苗头都没有。",shape=box,color=blue];
		1911 -> 1913;
	1916 [label="啊。不。",shape=box,color=blue];
		1916 -> 1917;
	1913 [label="我忍不住想到，昆西最喜欢的姿势可能是“伴侣在上面拿着一面镜子，这样他就能幻想自己正在和自己做爱”。",shape=box,color=blue];
		1913 -> 1914;
	1917 [label="我知道有很多关于水晶的文章都是废话。我对那种说法不感兴趣。我不相信水晶能净化我的气场或点亮我的脉轮。",shape=box,color=blue];
		1917 -> 1918;
	1914 [label="不谢谢。我只需要在远处欣赏就够了。",shape=box,color=blue];
		1914 -> 1915;
	1918 [label="但它们确实存在。",shape=box,color=blue];
		1918 -> 1919;
	1915 [label="Chat ends.",color=orange];
	1919 [label="抱歉。我知道我听起来像个十足的疯子。",shape=box,color=blue];
		1919 -> 1920;
		1919 -> 1921;
		1919 -> 1922;
	1920 [label="幸好说出这句话的人是你而不是我。它们只不过是一些漂亮的石头。",shape=box,color=red];
		1920 -> 1923;
	1921 [label="我有几个朋友是中枢。他们实际上是玻璃立方体形式的智慧生物。你怎么会觉得我会嘲笑你认为水晶确实存在的？",shape=box,color=red];
		1921 -> 1924;
	1922 [label="我花了太多时间从地里挖水晶，所以它们在更深层次上的重要性不言而喻。你会惊讶地发现，有多少战甲的制作材料是某种或几种水晶。",shape=box,color=red];
		1922 -> 1925;
	1923 [label="噢，有时候你真是让人抓狂。",shape=box,color=blue];
		1923 -> 1926;
	1924 [label="好吧，现在我因为觉得自己愚蠢真的感到蠢了。",shape=box,color=blue];
		1924 -> 1929;
	1925 [label="太神奇了，我很好奇！",shape=box,color=blue];
		1925 -> 1930;
	1926 [label="我原本以为，在所有人中，你能够将自己的视角提升到高于纯粹物质的水平。",shape=box,color=blue];
		1926 -> 1927;
	1929 [label="我想你一定有些我梦寐以求的水晶。",shape=box,color=blue];
		1929 -> 1931;
		1929 -> 1932;
		1929 -> 1933;
	1930 [label="请告诉我，智慧的旅行者，你们时代的水晶有什么特别之处？",shape=box,color=blue];
		1930 -> 1932;
	1927 [label="去你的吧。让我和自己心爱的石头待在一起。",shape=box,color=blue];
		1927 -> 1928;
	1931 [label="氩结晶。只有在虚空中才能找到它，一旦你把它带出来它就会消散。",shape=box,color=red];
		1931 -> 1934;
	1932 [label="有一个完全由水晶构成的战甲。她叫 Citrine。",shape=box,color=red];
		1932 -> 1944;
	1933 [label="我们有一对被变成水晶的恋人。",shape=box,color=red];
		1933 -> 1941;
	1928 [label="Chat ends.",color=orange];
	1934 [label="你说“只有在虚空中才能找到它”，好像人们总是能随意进出虚空似的。我还以为这是一个让人疯狂的维度，而不是海滨度假胜地。",shape=box,color=blue];
		1934 -> 1937;
	1944 [label="+10 Chemistry",color=orange];
		1944 -> 1935;
	1941 [label="+10 Chemistry",color=orange];
		1941 -> 1936;
	1937 [label="我想我还没告诉你关于奥罗金塔的事。它们就像虚空中的堡垒，是为了防止 Sentient 的攻击而建立的。",shape=box,color=red];
		1937 -> 1951;
	1935 [label="那是她的名字？我想我在你的脑海中瞥见过她！",shape=box,color=blue];
		1935 -> 1938;
	1936 [label="多么美丽又悲伤。成为爱情纪念的感觉如何呢？",shape=box,color=blue];
		1936 -> 1939;
	1951 [label="+20 Chemistry",color=orange];
		1951 -> 1946;
	1938 [label="那位漂亮的晶岩女士。我想我和她现在算是有点亲戚关系了。这是个令人欣慰的想法。",shape=box,color=blue];
		1938 -> 1943;
	1939 [label="我希望没人会从它们晶体上弄下碎片来当作纪念品。在我们的时代，这肯定会发生。",shape=box,color=blue];
		1939 -> 1940;
	1946 [label="这听起来很熟悉。在拉德斯顿和曼彻尼亚地下有这些高度戒备的掩体。理论上，如果真的爆发了辐射战争，那些富人和权贵就可以躲进他们豪华避难所，边喝着含羞草鸡尾酒，边看着我们这些普通人在地上被烧成灰烬。",shape=box,color=blue];
		1946 -> 1947;
	1943 [label="那就，欢迎加入这个大家庭吧？",shape=box,color=red];
		1943 -> 1945;
	1940 [label="人们确实试图这么做，但我们会保护他们。这是我们至少能做的事。",shape=box,color=red];
		1940 -> 1942;
	1947 [label="历来如此，她叹了口气说道。",shape=box,color=blue];
		1947 -> 1948;
	1945 [label="Chat ends.",color=orange];
	1942 [label="Chat ends.",color=orange];
	1948 [label="这很有意思。我小时候，大家都非常害怕辐射战争。我还记得那些公共服务广播。严肃地建议如何囤积物资、如何准备避难室，以及如何埋葬死去的亲人，即使你不想这么做。",shape=box,color=blue];
		1948 -> 1949;
	1949 [label="当我在你的脑海中看到那个反应堆爆炸的场景时，我仿佛又回到了那些噩梦中。我知道我们必须不惜一切代价阻止它。我会让其他人相信你的。",shape=box,color=blue];
		1949 -> 1950;
	1950 [label="不过，等待这个星球的并不是辐射战争，对吧？而是科腐者。不管怎样，这个循环终将会结束，到那时，世界其他地方也会受到感染。",shape=box,color=blue];
		1950 -> 1952;
	1952 [label="Chat ends.",color=orange];
}