digraph {
	1262 [label="EleanorRank3Convo5 begins.",color=orange];
		1262 -> 1263;
	1263 [label="你好，漂泊者。我不开心。",shape=box,color=blue];
		1263 -> 1266;
		1263 -> 1264;
		1263 -> 1265;
	1266 [label="什么事让你不开心？",shape=box,color=red];
		1266 -> 1268;
	1264 [label="你好，不开心。我是漂泊者。",shape=box,color=red];
		1264 -> 1269;
	1265 [label="现在没空，抱歉。[结束]",shape=box,color=red];
		1265 -> 1267;
	1268 [label="两件事。",shape=box,color=blue];
		1268 -> 1273;
	1269 [label="未来居然有这种冷笑话",shape=box,color=blue];
		1269 -> 1271;
	1267 [label="Chat ends.",color=orange];
	1273 [label="我想念葡萄酒。我已经很久没喝过真正的酒了。霍瓦尼亚所有的酒都在疫情爆发几天后被炽蛇军指挥部征用了。",shape=box,color=blue];
		1273 -> 1274;
	1271 [label="+10 Chemistry",color=orange];
		1271 -> 1270;
	1274 [label="昆西和亚瑟试着用水果口粮包做监狱特酿，但我们这些还有点尊严的人拒绝了。这可是莱蒂难得的团结时刻。",shape=box,color=blue];
		1274 -> 1275;
	1270 [label="现在开心了。谢谢。",shape=box,color=blue];
		1270 -> 1272;
	1275 [label="另一件事，也是更重要的事情，是未来。",shape=box,color=blue];
		1275 -> 1276;
	1272 [label="Chat ends.",color=orange];
	1276 [label="这不是你的错，但是……现在我从你的眼里看到了未来，从某种意义上说我觉得很痛苦，常用的方法都无法改变这种痛苦。",shape=box,color=blue];
		1276 -> 1277;
		1276 -> 1278;
	1277 [label="我要怎么做才能让你高兴起来？",shape=box,color=red];
		1277 -> 1279;
	1278 [label="常用的方法？",shape=box,color=red];
		1278 -> 1280;
	1279 [label="我不知道。也许跳一段异国情调的舞蹈？",shape=box,color=blue];
		1279 -> 1281;
	1280 [label="和阿米尔一起度过一个晚上，听他热情地谈论他目前着迷的漫画系列或复古游戏。",shape=box,color=blue];
		1280 -> 1282;
	1281 [label="向我详细描述一下 Ballas 的死？",shape=box,color=blue];
		1281 -> 1283;
	1282 [label="用水晶包围我自己，心里默念，直到莱蒂叫驱魔师来。",shape=box,color=blue];
		1282 -> 1284;
	1283 [label="谢谢你的好心，但我觉得这份忧愁是不得不承受的。",shape=box,color=blue];
		1283 -> 1286;
	1284 [label="这是一种不同的悲伤。它像一条湿透的毯子一样重重地压着我。",shape=box,color=blue];
		1284 -> 1288;
		1284 -> 1289;
	1286 [label="也许我会去画画。",shape=box,color=blue];
		1286 -> 1285;
	1288 [label="1999 年的霍瓦尼亚可真够呛！炽蛇军、科腐者、虚空知道还有什么。未来真的看起来糟糕那么多吗？",shape=box,color=red];
		1288 -> 1290;
	1289 [label="哦，来吧……你很坚强。你能应付的。这里有很多很酷的东西。",shape=box,color=red];
		1289 -> 1291;
	1285 [label="+5 Chemistry",color=orange];
		1285 -> 1287;
	1290 [label="听着，我从来都不喜欢科幻小说。亚瑟有一段时间喜欢，但他总是更喜欢坚韧不拔的军队题材。男子汉成为英雄，积极健康的男孩们的故事，有大量的潜台词，我相信你知道这种东西。",shape=box,color=blue];
		1290 -> 1292;
	1291 [label="好吧。拉着我的手，陪我穿过霍瓦尼亚的街道。",shape=box,color=blue];
		1291 -> 1293;
	1287 [label="Chat ends.",color=orange];
	1292 [label="但我对科幻小说的了解足以让我知道，在遥远的未来，我们应该把我们的事情安排得井井有条。一切应该是光鲜亮丽、一腐不染的。机器人做所有艰苦的工作，没有疾病，没有人需要钱，到处都是银色的塔、蓝蓝的天和性感的蜥蜴。",shape=box,color=blue];
		1292 -> 1295;
		1292 -> 1296;
	1293 [label="我知道一个地方，我们可以在那里吃一些碎萝卜蛋糕，再看看太阳从学校的废墟上空落下。",shape=box,color=blue];
		1293 -> 1294;
	1295 [label="我们有机器人。它们确实做了很多艰苦的工作。",shape=box,color=red];
		1295 -> 1298;
	1296 [label="但你讲的这些都是小说里的内容，不是吗？你为什么期望现实也会变成这样？",shape=box,color=red];
		1296 -> 1299;
	1294 [label="稍后，我们可以在燃烧坦克的光下品尝鸡尾酒。",shape=box,color=blue];
		1294 -> 1297;
	1298 [label="好吧，这可以给你加一分。",shape=box,color=blue];
		1298 -> 1300;
	1299 [label="唉，我不是……这很复杂。让我解释一下。",shape=box,color=blue];
		1299 -> 1301;
	1297 [label="Chat ends.",color=orange];
	1300 [label="但这些机器人真的让普通人的生活变得更轻松了吗？",shape=box,color=blue];
		1300 -> 1303;
	1301 [label="我并不是说我期待未来看起来像儿童漫画那样美好。我只是说对未来有一种乐观的期待。",shape=box,color=blue];
		1301 -> 1302;
	1303 [label="还是只是变成了另一种被人们视为理所当然的存在？",shape=box,color=blue];
		1303 -> 1306;
		1303 -> 1307;
	1302 [label="我们似乎都理所当然地认为，无论现在有多么困难，终究会有解决的一天。我们的文明注定要向前发展。我们一开始是用棍棒互相砸对方的头，几千年后，我们学会了用更文明的方式来解决分歧，而不是靠暴力。",shape=box,color=blue];
		1302 -> 1304;
		1302 -> 1305;
	1306 [label="你总是喜欢往坏处想，是吧？",shape=box,color=red];
		1306 -> 1310;
	1307 [label="好吧。机器人并没有解决剥削问题。",shape=box,color=red];
		1307 -> 1311;
	1304 [label="无论技术发生多大变化，人性始终如一。",shape=box,color=red];
		1304 -> 1308;
	1305 [label="对不起，我们让你失望了？",shape=box,color=red];
		1305 -> 1309;
	1310 [label="没错。",shape=box,color=blue];
		1310 -> 1315;
	1311 [label="对。这就是令人失望的地方。",shape=box,color=blue];
		1311 -> 1316;
	1308 [label="一针见血。你所说的正是我对这一切感到沮丧的原因。",shape=box,color=blue];
		1308 -> 1313;
	1309 [label="没错。",shape=box,color=blue];
		1309 -> 1313;
	1315 [label="只有这样我们才能知道哪里需要改变。",shape=box,color=blue];
		1315 -> 1317;
	1316 [label="你们很先进，但也应该有更高的觉悟",shape=box,color=blue];
		1316 -> 1318;
	1313 [label="你们拥有所有这些不可思议的神奇技术，却只用它来找到新的方式去剥削彼此。科学并没有让我们变得更平等，反而是更加不平等。",shape=box,color=blue];
		1313 -> 1312;
		1313 -> 1314;
	1317 [label="Chat ends.",color=orange];
	1318 [label="感谢你的耐心，我知道这些说起来可能有点多。",shape=box,color=blue];
		1318 -> 1320;
	1312 [label="嗯，礼貌地提醒一下，那些事我一件都没做过？",shape=box,color=red];
		1312 -> 1322;
	1314 [label="我会把你的投诉转达给奥罗金。",shape=box,color=red];
		1314 -> 1322;
	1320 [label="+15 Chemistry",color=orange];
		1320 -> 2837;
	1322 [label="哦，天啊，我不是指你个人。我是说你所在的那个时代。",shape=box,color=blue];
		1322 -> 1323;
	2837 [label="Chat ends.",color=orange];
	1323 [label="说到变化，你们是在倒退。还神的化身！那么多可以重新创造的东西，你们居然选了这个！",shape=box,color=blue];
		1323 -> 1324;
	1324 [label="是 Tenno 灭了奥罗金。你忘了这部分吗？",shape=box,color=red];
		1324 -> 1325;
	1325 [label="不。我没忘记那些情感受虐的孤儿们杀死不朽精英的那部分。我特别喜欢那一幕。如果我闭上眼睛，我几乎可以想象到尖叫声。",shape=box,color=blue];
		1325 -> 1326;
		1325 -> 1327;
	1326 [label="好吧。未来一团糟。如果你喜欢，你可以关注这一点。",shape=box,color=red];
		1326 -> 1328;
	1327 [label="这……是……我不会轻易向人透露的事情。",shape=box,color=red];
		1327 -> 1329;
	1328 [label="我支持那些在努力让未来变得更好的人。",shape=box,color=red];
		1328 -> 1330;
	1329 [label="……未来连讽刺也过时了吗？",shape=box,color=blue];
		1329 -> 1331;
	1330 [label="+20 Chemistry",color=orange];
		1330 -> 1332;
	1331 [label="Chat ends.",color=orange];
	1332 [label="Chat ends.",color=orange];
}