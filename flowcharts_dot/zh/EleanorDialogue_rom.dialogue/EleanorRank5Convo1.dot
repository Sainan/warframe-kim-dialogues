		2090 -> 2093 [label=false,color=brown];
		2090 -> 2094 [label=false,color=brown];
		2090 -> 2095 [label=false,color=brown];
	2091 [label="La Flaca？",shape=box,color=red];
		2091 -> 2096;
	2092 [label="……一个炽蛇军杀手？",shape=box,color=red];
		2092 -> 2098;
	2093 [label="月神的其中一个形象？",shape=box,color=red];
		2093 -> 2099;
	2094 [label="这就是你对死亡的称呼吗？",shape=box,color=red];
		2094 -> 2099;
		2094 -> 2101;
	2095 [label="不知道。",shape=box,color=red];
		2095 -> 2101;
	2096 [label="+5 Chemistry",color=orange];
		2096 -> 2097;
	2098 [label="不算是。",shape=box,color=blue];
		2098 -> 2101;
	2099 [label="+5 Chemistry",color=orange];
		2099 -> 2100;
	2101 [label="她就是死神。也是月神的其中一个形象，这取决于你遵循哪个传统。她是那个在你结束忙碌生命的这一天，过来帮你盖被子，亲吻你说晚安，唱歌哄你入睡的那个人。",shape=box,color=blue];
		2101 -> 2102;
		2101 -> 2103;
	2097 [label="哈哈。看来你和我们亲爱的莱蒂谈过了。是的。",shape=box,color=blue];
		2097 -> 2101;
	2100 [label="是的，没错。",shape=box,color=blue];
		2100 -> 2101;
	2102 [label="你说你感到忧郁，这不是开玩笑的，对吗？",shape=box,color=red];
		2102 -> 2104;
	2103 [label="这会是一场“找个舒服的位置坐下，漂泊者，这需要点时间”的谈话，对吗？",shape=box,color=red];
		2103 -> 2105;
	2104 [label="伙计。英择谛给予我们的一切，力量，强度，铠甲……我愿意用这一切来换取一点安慰，那就是死亡不是终点。",shape=box,color=blue];
		2104 -> 2108;
	2105 [label="……原本是的。",shape=box,color=blue];
		2105 -> 2106;
	2108 [label="我试过了。我不喜欢承认这一点，但有时当我们在巡逻时遇到战斗，我会尝试进入垂死之人的脑海，并与他们一起经历那个过程。如果隧道尽头真有一丝光亮，我只想看到它。",shape=box,color=blue];
		2108 -> 2109;
		2108 -> 2110;
	2106 [label="算了。我相信你还有更重要的事情要做。",shape=box,color=blue];
		2106 -> 2107;
	2109 [label="埃莉诺，这太可怕了。你没有权利这么做。",shape=box,color=red];
		2109 -> 2111;
	2110 [label="你尝试过安慰他们吗？",shape=box,color=red];
		2110 -> 2114;
	2107 [label="Chat ends.",color=orange];
	2111 [label="我知道。我知道。",shape=box,color=blue];
		2111 -> 2112;
	2114 [label="我尝试过一次。这有什么坏处呢？反正他们都要死了。那是一个年轻的炽蛇军士兵。她向我冲过来，我朝她的胸口开了一枪。",shape=box,color=blue];
		2114 -> 2115;
	2112 [label="我告诉自己我只是想帮忙，但事实是我只是想看看。你说得对。那真是太可怕了。",shape=box,color=blue];
		2112 -> 2113;
	2115 [label="她在咯咯地吐着血，我跪在她身边，试着告诉她没关系，痛苦即将结束，很快她就会和先去的家人团聚了，所有那些临终关怀时会说的安抚话语，能说的我都说了。",shape=box,color=blue];
		2115 -> 2116;
	2113 [label="Chat ends.",color=orange];
	2116 [label="她非常害怕。她仅存的意识就像是水箱里四处挣扎的老鼠。当她感觉到我在她脑海中时，她试图依附我。她求我帮忙。在这一切下面是……我甚至不知道你会怎么称呼它……",shape=box,color=blue];
		2116 -> 2117;
		2116 -> 2118;
		2116 -> 2119;
	2117 [label="希望？",shape=box,color=red];
		2117 -> 2120;
	2118 [label="恐惧？",shape=box,color=red];
		2118 -> 2120;
	2119 [label="否认？",shape=box,color=red];
		2119 -> 2120;
	2120 [label="否认。她不相信自己会死。她为什么会相信呢？她之前一直都在。死亡怎么会现在把她带走？",shape=box,color=blue];
		2120 -> 2121;
	2121 [label="在生命中的每一天，你都把自己视为理所当然。你醒来时在这里，睡觉时也在这里。你的一生都在由你自己构建的房子里。你从未出去过，因为你不能。",shape=box,color=blue];
		2121 -> 2122;
	2122 [label="然后有一天，你听到自己的房子正在被拆除。",shape=box,color=blue];
		2122 -> 2123;
		2122 -> 2124;
	2123 [label="你为什么不帮助她？",shape=box,color=red];
		2123 -> 2125;
	2124 [label="你有陪她到最后吗？",shape=box,color=red];
		2124 -> 2126;
	2125 [label="你希望我做什么？叫莱蒂过来？治愈她胸口上的伤口？只因为我近距离看到了这个人的经历？",shape=box,color=blue];
		2125 -> 2127;
	2126 [label="有。我吓坏了。当她感觉自己即将走到尽头，我确信我也会被她拖下去。我能感受到那种下沉的力量在拉扯我。",shape=box,color=blue];
		2126 -> 2128;
	2127 [label="对于炽蛇军来说，要么杀，要么被杀。他们不会对我们仁慈。",shape=box,color=blue];
		2127 -> 2129;
	2128 [label="但我必须留下来。我不能抛下她独自一人死去。",shape=box,color=blue];
		2128 -> 2130;
	2129 [label="Chat ends.",color=orange];
	2130 [label="虽然我猜她最后还是独自一人死去。但我没能和她一起迈出最后一步。",shape=box,color=blue];
		2130 -> 2131;
		2130 -> 2132;
	2131 [label="你从这次经历中学到了什么？",shape=box,color=red];
		2131 -> 2133;
	2132 [label="那么你看到了你希望看到的东西吗？",shape=box,color=red];
		2132 -> 2134;
	2133 [label="我什么也没学到。",shape=box,color=blue];
		2133 -> 2135;
	2134 [label="没有。",shape=box,color=blue];
		2134 -> 2135;
	2135 [label="但她看到了。她看到了她母亲的脸庞、和她一起上学的孩子们、她的猫、还有一个溺水身亡的表亲。但这些都不是真实的存在或灵魂。只是一些因为垂死的大脑拼命寻找可以依附的东西，而被迫浮现的记忆。",shape=box,color=blue];
		2135 -> 2137;
	2137 [label="然后，她身份的房子开始在她周围瓦解。就在她临死前，她睁大了双眼。我想，在那一刻，她有生以来第一次真正理解了死亡到底是什么。",shape=box,color=blue];
		2137 -> 2136;
		2137 -> 2138;
	2136 [label="垂死之人明白了死亡是什么。埃莉诺，真是个深刻的见解啊。",shape=box,color=red];
		2136 -> 2139;
	2138 [label="你这是什么意思？每个人都知道死亡是什么。",shape=box,color=red];
		2138 -> 2140;
	2139 [label="看着。下次如果你想批评我的废话，不用觉得非得先听我说完。",shape=box,color=blue];
		2139 -> 2141;
	2140 [label="不。我们以为我们知道它是什么，但我们所有的经历都是从外部来的。",shape=box,color=blue];
		2140 -> 2143;
	2141 [label="没人强迫你和我说话。再见。",shape=box,color=blue];
		2141 -> 2142;
	2143 [label="她的一生就像住在一间没有灯光的房子里的女人，她只有一把手电筒。她会用她意识的光照亮这里或那里。一段记忆、一项任务、一次互动。",shape=box,color=blue];
		2143 -> 2144;
	2142 [label="Chat ends.",color=orange];
	2144 [label="她会在睡梦中从一个房间走到另一个房间，探索地下室，但这始终是一个封闭的、有限的过程。你明白我的意思吗？",shape=box,color=blue];
		2144 -> 2145;
		2144 -> 2146;
	2145 [label="不太明白，但继续说。",shape=box,color=red];
		2145 -> 2147;
	2146 [label="明白。",shape=box,color=red];
		2146 -> 2147;
	2147 [label="然后，当房子被拆毁，她的人格在她周围崩塌时，突然间，手电筒不再只照亮墙壁、书本或沙发了。它照向了无边无际的天空。她的意识在没有自我阻碍的情况下，闪耀在无尽的天空。",shape=box,color=blue];
		2147 -> 2149;
		2147 -> 2150;
		2147 -> 2151;
	2149 [label="但意识会随着肉体的死亡而消亡。你所经历的不过是她垂死大脑中的一次痉挛。",shape=box,color=red];
		2149 -> 2148;
	2150 [label="你觉得“意识”是我们真正的本质，而其余的都只是外壳？",shape=box,color=red];
		2150 -> 2155;
	2151 [label="哇。太深奥了。你开枪打了人，还侵犯了她的隐私。",shape=box,color=red];
		2151 -> 2156;
	2148 [label="我试着多次对自己这么说。",shape=box,color=blue];
		2148 -> 2152;
	2155 [label="+5 Chemistry",color=orange];
		2155 -> 2154;
	2156 [label="看着。下次如果你想批评我的废话，不用觉得非得先听我说完。",shape=box,color=blue];
		2156 -> 2157;
	2152 [label="我无法相信那只是大脑停止运作的过程。那感觉更像是灵魂的释放。",shape=box,color=blue];
		2152 -> 2153;
	2154 [label="我知道这听起来没有任何道理。认为我们首先是一个视角，其次才是一个人格，这种想法很违反直觉。我只知道，陪伴一个人的灵魂从生到死的过程，就是这种感觉。",shape=box,color=blue];
		2154 -> 2159;
	2157 [label="没人强迫你和我说话。再见。",shape=box,color=blue];
		2157 -> 2158;
	2153 [label="Chat ends.",color=orange];
	2159 [label="你对这一切有什么感觉？",shape=box,color=red];
		2159 -> 2160;
	2158 [label="Chat ends.",color=orange];
	2160 [label="安慰？我喜欢我们身上的某种东西会存续下来的想法。我更倾向于认为死亡不是把你从宇宙中抹去，而是抹去一切将你与宇宙隔绝的东西。",shape=box,color=blue];
		2160 -> 2161;
	2161 [label="但构成自我的不仅仅是基本的意识。还有记忆、情感、观点、各种层面。当你失去这一切时，你是在失去一个真实的人，即使那份火花以某种方式存续下来。",shape=box,color=red];
		2161 -> 2162;
	2162 [label="我知道。",shape=box,color=blue];
		2162 -> 2163;
	2163 [label="说实话，这就是为什么我想和你谈论虚空幽灵和中枢，以及你们那个时代里所有这些东西的原因。我想知道我们是否有机会与失去的人交流。",shape=box,color=blue];
		2163 -> 2164;
	2164 [label="是真正的交流，而不是一些全息图垃圾。那种能让你确切了解到对方思想的交流方式。",shape=box,color=blue];
		2164 -> 2165;
		2164 -> 2166;
	2165 [label="不，其实没有。即使到了未来，我们失去的人……无论好坏？只是……消失了。",shape=box,color=red];
		2165 -> 2167;
	2166 [label="埃莉诺，说重点吧。你失去了谁？",shape=box,color=red];
		2166 -> 2169;
	2167 [label="我明白了。也许有些门我们永远无法打开。也许这样更好。",shape=box,color=blue];
		2167 -> 2168;
	2169 [label="他叫克里斯托弗。是亚瑟最好的朋友。",shape=box,color=blue];
		2169 -> 2170;
	2168 [label="Chat ends.",color=orange];
	2170 [label="我们订了婚。我以为我很爱他。",shape=box,color=blue];
		2170 -> 2171;
	2171 [label="Update boolean EleanorChristopher1",color=orange];
		2171 -> 2172;
	2172 [label="+10 Chemistry",color=orange];
		2172 -> 2173;
	2173 [label="抱歉，我没法说下去。我下次再跟你说。",shape=box,color=blue];
		2173 -> 2174;
	2174 [label="Chat ends.",color=orange];
}