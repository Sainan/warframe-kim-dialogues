digraph {
	2081 [label="EleanorRank5Convo1 begins.",color=orange];
		2081 -> 2082;
	2082 [label="Check boolean EleanorDating",color=orange];
		2082 -> 2083 [label=true,color=green];
		2082 -> 2084 [label=false,color=brown];
	2083 [label="你好，亲爱的。我现在感觉有点忧郁。你有时间吗？",shape=box,color=blue];
		2083 -> 2085;
		2083 -> 2086;
	2084 [label="你好。我现在感觉有点忧郁。你有时间吗？",shape=box,color=blue];
		2084 -> 2085;
		2084 -> 2086;
	2085 [label="对你，我永远有时间。",shape=box,color=red];
		2085 -> 2088;
	2086 [label="我*真的*抱歉，现在不行。[结束]",shape=box,color=red];
		2086 -> 2087;
	2088 [label="真心地感谢你。",shape=box,color=blue];
		2088 -> 2089;
	2087 [label="Chat ends.",color=orange];
	2089 [label="你知道戴帽子的女人是谁吗？ ",shape=box,color=blue];
		2089 -> 2090;
