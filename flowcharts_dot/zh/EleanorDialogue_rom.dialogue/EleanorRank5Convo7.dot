digraph {
	2607 [label="EleanorRank5Convo7 begins.",color=orange];
		2607 -> 2608;
	2608 [label="“虚空无情之物”的无情是它的本质，还是它的欲望？",shape=box,color=blue];
		2608 -> 2609;
		2608 -> 2610;
		2608 -> 2611;
	2609 [label="你和莱蒂都这样，你知道吗。你们都忘了说“你好”。",shape=box,color=red];
		2609 -> 2613;
	2610 [label="大多数人都会先说声“你好”。",shape=box,color=red];
		2610 -> 2614;
	2611 [label="[无视]",shape=box,color=red];
		2611 -> 2612;
	2613 [label="恭喜你发现了我们的共同点。还有，抱歉。这个问题更重要。",shape=box,color=blue];
		2613 -> 2615;
	2614 [label="抱歉。这个问题更重要。",shape=box,color=blue];
		2614 -> 2615;
	2612 [label="Chat ends.",color=orange];
	2615 [label="我认为“虚空无情之物”会试图以某种方式介入我们之间。",shape=box,color=blue];
		2615 -> 2616;
	2616 [label="别笑。我能从骨髓深处感觉到。鲁莎卡里面的那个东西很想看到我们把对方撕成碎片。",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="我不知道为什么。我就是知道。",shape=box,color=blue];
		2617 -> 2618;
		2617 -> 2619;
	2618 [label="是的。我觉得你是对的。",shape=box,color=red];
		2618 -> 2620;
	2619 [label="也许这就是发生在英择谛家人身上的事。他们在他的实验室上方生活了多年，却一直不知情。当那孩子找到他们时，他们已经关系疏远，沉浸在怨恨之中。",shape=box,color=red];
		2619 -> 2620;
	2620 [label="我已经在你的脑海里看到了。阿尔布雷希特和洛德。“母亲”和“父亲”。你和你的父母。就我们所知，鲁莎卡和维克多也是如此。当然还有我们六个人。",shape=box,color=blue];
		2620 -> 2621;
	2621 [label="这个东西的所作所为是冷酷的，扭曲的。但在某种意义上，它背后隐藏着动机。",shape=box,color=blue];
		2621 -> 2622;
		2621 -> 2623;
	2622 [label="我觉得你说得对。在扎里曼号，父母是最先失去理智的。也许坚守者能坚持这么久，是因为他们都没有孩子。",shape=box,color=red];
		2622 -> 2627;
	2623 [label="我不喜欢假设去理解那些基本上可以称为*神*的事物。这个东西正在试图理解情感。它只是在玩弄自己的玩具，而且玩得很糟糕。",shape=box,color=red];
		2623 -> 2624;
	2627 [label="就让它尝试来破坏我们之间的关系。我向太阳神发誓，我会结束它的。我会找到办法的。",shape=box,color=blue];
		2627 -> 2628;
	2624 [label="这是个值得赞赏的理论，但我们并不确切知道，对吧？",shape=box,color=blue];
		2624 -> 2625;
	2628 [label="宇宙中一定存在着那个东西无法对抗的力量。我选择全心全意相信这一点。",shape=box,color=blue];
		2628 -> 2629;
	2625 [label="如果你是对的，那么它是无辜的。几乎像个孩子。这和我们的认知不符——它是恶意的。",shape=box,color=blue];
		2625 -> 2626;
	2629 [label="如果它把我整个人吞下去，我会卡在它的喉咙里，让它窒息。",shape=box,color=blue];
		2629 -> 2630;
		2629 -> 2631;
	2626 [label="Chat ends.",color=orange];
	2630 [label="这是一个很好的死法。",shape=box,color=red];
		2630 -> 2632;
	2631 [label="我还不知道我们该怎么做，但我支持你。我们必须赢。",shape=box,color=red];
		2631 -> 2635;
	2632 [label="在这种情况下，我反正都要死了。",shape=box,color=blue];
		2632 -> 2633;
	2635 [label="如果这是个故事，你会想出一些巧妙的招数。你可能会挖出巨人的石心，用天鹅的羽毛敲碎它，或者诱骗它跳下悬崖。",shape=box,color=blue];
		2635 -> 2636;
	2633 [label="但至少我能把口水吐在它眼睛上。",shape=box,color=blue];
		2633 -> 2634;
	2636 [label="你说过你是一名“记者”。这些不是你过去讲的那种故事，对吧？你讲的是真相，无论它有多丑陋。",shape=box,color=red];
		2636 -> 2637;
	2634 [label="Chat ends.",color=orange];
	2637 [label="如果那些古老的故事不是真实的，人们就不会一直讲述它们。",shape=box,color=blue];
		2637 -> 2638;
	2638 [label="我并不是说巨人是真的。我只是说古老的故事讲述了另一种真相。",shape=box,color=blue];
		2638 -> 2639;
		2638 -> 2640;
	2639 [label="要度过难关，我们需要的不仅仅是童话故事，无论它们有多么鼓舞人心。",shape=box,color=red];
		2639 -> 2641;
	2640 [label="我生活在一个由故事构成的王国里。我知道故事的力量有多大。",shape=box,color=red];
		2640 -> 2643;
	2641 [label="我知道。我希望我有更多除了直觉之外的东西。",shape=box,color=blue];
		2641 -> 2642;
	2643 [label="我认为所有那些打败巨人的故事都有一个共同点：它们都是关于学习规则并弄清楚如何巧妙地利用这些规则。",shape=box,color=blue];
		2643 -> 2644;
	2642 [label="我们正在面对的是庞大、可怕并且超出我们理解的事物。通常只有孩子们才需要面对这种情况。这就是为什么童话存在的原因。",shape=box,color=blue];
		2642 -> 2645;
		2642 -> 2646;
	2644 [label="有些怪物很蠢。有些怪物被迫只能按字面意义行事。有些怪物有秘密。但在你弄清楚怪物受限于什么规则之前，你是无法取胜的。",shape=box,color=blue];
		2644 -> 2645;
		2644 -> 2646;
	2645 [label="它被困在墙里。我甚至不确定那堵墙是什么。",shape=box,color=red];
		2645 -> 2647;
	2646 [label="我不认为虚空无情之物受到任何规则的约束。",shape=box,color=red];
		2646 -> 2649;
	2647 [label="没关系。如果它真的被困住了，那么我们可以推断出两件事，对吗？",shape=box,color=blue];
		2647 -> 2651;
	2649 [label="一定会有规则约束它！即使是神也有规则！无论虚空无情之物看起来有多强大，它不是神。",shape=box,color=blue];
		2649 -> 2650;
	2651 [label="一是，它可以被困住，甚至被囚禁。",shape=box,color=blue];
		2651 -> 2653;
	2650 [label="你打败了士魂大帝。不管你失败了多少次，屁股多少次着地。最终你还是赢了。你为什么不能同样战胜墙中人呢？",shape=box,color=blue];
		2650 -> 2648;
	2653 [label="+15 Chemistry",color=orange];
		2653 -> 2652;
	2648 [label="埃莉诺，你是什么时候开始不再害怕它了？",shape=box,color=red];
		2648 -> 2655;
	2652 [label="二是，它想要某种东西。它想要出去。如果我们知道它想要什么，我们就已经领先它一步了。",shape=box,color=blue];
		2652 -> 2654;
	2655 [label="我并没有。",shape=box,color=blue];
		2655 -> 2657;
	2654 [label="Chat ends.",color=orange];
	2657 [label="+20 Chemistry",color=orange];
		2657 -> 2656;
	2656 [label="我只是更害怕失去你，好吗？",shape=box,color=blue];
		2656 -> 2658;
	2658 [label="Chat ends.",color=orange];
}