digraph {
	924 [label="EleanorRank3Convo2 begins.",color=orange];
		924 -> 926;
	926 [label="Check boolean EleanorIndifference",color=orange];
		926 -> 925 [label=true,color=green];
		926 -> 927 [label=false,color=brown];
	925 [label="你在吗？我需要谈谈。",shape=box,color=blue];
		925 -> 928;
		925 -> 929;
	927 [label="你在吗？我需要跟你谈谈一些事情。严肃的事情。",shape=box,color=blue];
		927 -> 931;
		927 -> 929;
	928 [label="我在的。",shape=box,color=red];
		928 -> 932;
	929 [label="真的很抱歉。现在不行。[结束]",shape=box,color=red];
		929 -> 930;
	931 [label="我在。继续说。",shape=box,color=red];
		931 -> 933;
	932 [label="还记得我曾经跟你说过，我试图用我的意识接触鲁莎卡的意识，结果却碰到了虚空无情之物吗？",shape=box,color=blue];
		932 -> 935;
	930 [label="Chat ends.",color=orange];
	933 [label="谢谢。",shape=box,color=blue];
		933 -> 934;
	935 [label="我当然记得。",shape=box,color=red];
		935 -> 938;
	934 [label="你知道鲁莎卡少校发生了什么事吗？",shape=box,color=blue];
		934 -> 936;
		934 -> 937;
	938 [label="对。当时我还没准备好谈论这件事。现在我准备好了，如果你愿意的话。",shape=box,color=blue];
		938 -> 945;
	936 [label="她被利用了。虚空无情之物在操纵她。",shape=box,color=red];
		936 -> 939;
	937 [label="我很确定她被掏空了，然后像……呃……战甲……那样被操控。",shape=box,color=red];
		937 -> 940;
	945 [label="如果你确定的话。",shape=box,color=red];
		945 -> 946;
	939 [label="“虚空无情之物”。你就这么叫它？",shape=box,color=blue];
		939 -> 941;
	940 [label="是的，被掏空了。",shape=box,color=blue];
		940 -> 942;
	946 [label="我确定。",shape=box,color=blue];
		946 -> 947;
	941 [label="谢谢。",shape=box,color=blue];
		941 -> 943;
	942 [label="但是操控她的东西和你不一样。",shape=box,color=blue];
		942 -> 944;
	947 [label="这个生物，这个存在，就是我们最终的对手。我现在知道这一点了。",shape=box,color=blue];
		947 -> 951;
	943 [label="给那个东西起个名字，让我感觉我至少回收了一点控制权。",shape=box,color=blue];
		943 -> 948;
	944 [label="它身上任何看似人性的东西都像是一种嘲弄。",shape=box,color=blue];
		944 -> 949;
	951 [label="请跟我说实话。你觉得还有希望吗？",shape=box,color=blue];
		951 -> 956;
		951 -> 957;
		951 -> 958;
	948 [label="我用意识接触过那个东西。我以为我会探查到鲁莎卡的思想，但是……外层就像湿漉漉的海绵石膏板一样塌了下来，然后我就完全陷入了其中。挣扎着。",shape=box,color=blue];
		948 -> 950;
	949 [label="它就像是商店里的人体模型一样，被分割成了几部分。",shape=box,color=blue];
		949 -> 952;
	956 [label="此时此刻？……没有。",shape=box,color=red];
		956 -> 960;
	957 [label="老实说？我……不确定。",shape=box,color=red];
		957 -> 961;
	958 [label="是的，我相信。",shape=box,color=red];
		958 -> 962;
	950 [label="Update boolean EleanorIndifference",color=orange];
		950 -> 951;
	952 [label="你看，我用我的意念触碰了它。我试图探查她，但她已经不在了。",shape=box,color=blue];
		952 -> 953;
	960 [label="至少你很诚实。",shape=box,color=blue];
		960 -> 963;
	961 [label="我理解。",shape=box,color=blue];
		961 -> 964;
	962 [label="别告诉我原因。",shape=box,color=blue];
		962 -> 965;
	953 [label="我知道你说的是什么。我们称之为“虚空无情之物”。",shape=box,color=red];
		953 -> 954;
	963 [label="好。那就让希望破灭吧。",shape=box,color=blue];
		963 -> 966;
	964 [label="有太多我们不知道的事了。",shape=box,color=blue];
		964 -> 967;
	965 [label="只需要坚持那个信念。让我感受它。",shape=box,color=blue];
		965 -> 968;
	954 [label="谢谢。",shape=box,color=blue];
		954 -> 955;
	966 [label="我会继续战斗，全凭一股纯粹的倔强。",shape=box,color=blue];
		966 -> 969;
	967 [label="在经历了今年的种种之后，我们怎么可能再有理智的计划？",shape=box,color=blue];
		967 -> 970;
	968 [label="拜托了。",shape=box,color=blue];
		968 -> 971;
	955 [label="给那个东西起个名字，让我感觉我至少回收了一点控制权。",shape=box,color=blue];
		955 -> 959;
	969 [label="憎恨、愤怒。什么都行。",shape=box,color=blue];
		969 -> 973;
	970 [label="也许希望只是一种错觉。我不知道。",shape=box,color=blue];
		970 -> 974;
	971 [label="我当时探查鲁莎卡，仿佛我的手指触碰到她的脸，却穿了过去。面具瞬间崩解。",shape=box,color=blue];
		971 -> 975;
	959 [label="Update boolean EleanorIndifference",color=orange];
		959 -> 972;
	973 [label="这总比麻木要好，比懦弱投降要好。",shape=box,color=blue];
		973 -> 978;
	974 [label="但我现在真的很需要一些希望。",shape=box,color=blue];
		974 -> 977;
	975 [label="面具下的东西就像……",shape=box,color=blue];
		975 -> 976;
	972 [label="我用意识接触过那个东西。我以为我会探查到鲁莎卡的思想，但是……外层就像湿漉漉的海绵石膏板一样塌了下来，然后我就完全陷入了其中。挣扎着。",shape=box,color=blue];
		972 -> 976;
	978 [label="我准备好了。",shape=box,color=blue];
		978 -> 979;
	977 [label="哎，就这样吧。即便我们在黑暗中摸索前行，至少我们还有彼此的陪伴。",shape=box,color=blue];
		977 -> 980;
	976 [label="有一个词叫“热病”。这是一种曾经影响水手们的疯症。他们会坚信周围的绿色海洋根本不是水，而是绿色的草地。",shape=box,color=blue];
		976 -> 981;
	979 [label="Chat ends.",color=orange];
	980 [label="Chat ends.",color=orange];
	981 [label="他们会情不自禁地从船上跳下，奔向那些看似美丽的绿色草原。如果有船员拉住他们，他们会挣扎反抗。",shape=box,color=blue];
		981 -> 982;
	982 [label="我跳下去的时候以为会落在草地上，结果下一秒我就陷入了冰冷的黑暗之中。",shape=box,color=blue];
		982 -> 983;
	983 [label="Update boolean EleanorIndifference2",color=orange];
		983 -> 984;
		983 -> 986;
	984 [label="我觉得你这样谈论这件事不安全。",shape=box,color=red];
		984 -> 985;
	986 [label="我在这里。继续说。",shape=box,color=red];
		986 -> 987;
	985 [label="哎呀，坏了。",shape=box,color=blue];
		985 -> 988;
	987 [label="有一种感觉是无法用语言形容的。你望向这个世界，你就知道，所有的平凡事物——建筑、汽车、人们、工作、日常生活——都只是一层薄薄的表皮，掩盖着无尽的恐怖。如果人们意识到这一点，他们会开始尖叫，永远不停歇。",shape=box,color=blue];
		987 -> 989;
	988 [label="我刚刚好不容易才做好了心理准备，可现在，怎么搞得连“魔鬼”都不敢提了，就因为害怕把他召唤出来？",shape=box,color=blue];
		988 -> 990;
	989 [label="我穿过了那层表皮。",shape=box,color=blue];
		989 -> 992;
	990 [label="如果你在夜里听到尖叫声，那是我。",shape=box,color=blue];
		990 -> 991;
	992 [label="那不是空无。我本能承受空无。它无止境地延续，但那并不仅仅是冰冷的空间。那里有什么东西与我同在。",shape=box,color=blue];
		992 -> 993;
		992 -> 994;
		992 -> 995;
	991 [label="Chat ends.",color=orange];
	993 [label="一只眼睛？",shape=box,color=red];
		993 -> 997;
	994 [label="一个被困在墙里的人？",shape=box,color=red];
		994 -> 997;
	995 [label="是什么？",shape=box,color=red];
		995 -> 996;
	997 [label="我不知道。但它知道我在那里。它意识到了我的存在。就像大象意识到一只苍蝇爬过它的眼睛一样。",shape=box,color=blue];
		997 -> 998;
	996 [label="+5 Chemistry",color=orange];
		996 -> 997;
	998 [label="我记得我当时想“这么庞大的存在应该不会注意到我”。",shape=box,color=blue];
		998 -> 999;
	999 [label="它对我完全不在意，那种极度的冷漠，让我恨不得想立刻消失。",shape=box,color=blue];
		999 -> 1000;
		999 -> 1001;
	1000 [label="它……就是这样的。",shape=box,color=red];
		1000 -> 1002;
	1001 [label="那你怎么做的？",shape=box,color=red];
		1001 -> 1002;
	1002 [label="如果它恨我，我觉得我还能应对。那样我至少还有些价值，有些意义。但它视我为无物，我也看到了它的视角。我就是一个微不足道的点。什么也不是。",shape=box,color=blue];
		1002 -> 1003;
	1003 [label="我曾经拥有的一切、每一个温柔的瞬间、每一次欢笑、埃莉诺·南丁格尔的点点滴滴都在那场风暴中消散了。",shape=box,color=blue];
		1003 -> 1004;
	1004 [label="它感受到我的光芒正在消逝，我发誓，它心中涌起一丝满足的颤抖。好像它很高兴压垮了我。就像碾死它指甲下的一只跳蚤那样。",shape=box,color=blue];
		1004 -> 1005;
	1005 [label="但你回来了，不是吗？你还在这里。你证明了那东西错了。",shape=box,color=red];
		1005 -> 1006;
	1006 [label="我有吗？",shape=box,color=blue];
		1006 -> 1007;
	1007 [label="它还在外面，不是吗？",shape=box,color=blue];
		1007 -> 1008;
		1007 -> 1009;
	1008 [label="是的，它还在。但你也还在这里。",shape=box,color=red];
		1008 -> 1011;
	1009 [label="群星不会因为宇宙的广袤、寒冷与黑暗而熄灭光芒。",shape=box,color=red];
		1009 -> 1010;
	1011 [label="虚空无情之物最终总会胜利，我的朋友，无论我们向深渊投入多少陈词滥调。",shape=box,color=blue];
		1011 -> 1012;
	1010 [label="但它们终将熄灭。总有一天，宇宙会走向热寂。",shape=box,color=blue];
		1010 -> 1011;
	1012 [label="这就是未陷入疯狂的代价：你被清晰的思维诅咒了。",shape=box,color=blue];
		1012 -> 1013;
	1013 [label="你知道我在说什么。你本可以选择像麻雀蛋一样碎掉，或者用毒品摧毁自己大脑，直到你什么都感觉不到。可这些痛苦都比不上现在……清醒地知道一切。",shape=box,color=blue];
		1013 -> 1014;
	1014 [label="我不明白你为什么还没有结束这场谈话。",shape=box,color=blue];
		1014 -> 1015;
		1014 -> 1016;
	1015 [label="我理解熵增。也许强大的虚空无情之物是同一回事。也许它最终会胜利。我不知道。但我知道的是，我现在不会让它胜利。",shape=box,color=red];
		1015 -> 1017;
	1016 [label="我在等你做这个决定呢。你是想选择捷径，放任自己发疯？还是从沙发上站起来，奋力一战？",shape=box,color=red];
		1016 -> 1018;
	1017 [label="如果我们能一起挺过这一切，我们就会一起生存下去。",shape=box,color=red];
		1017 -> 1020;
	1018 [label="怎么战斗",shape=box,color=blue];
		1018 -> 1019;
	1020 [label="所以你忍受我这些存在主义的哀嚎，是把它当作一种战斗策略？真是太像亚瑟的作风了。",shape=box,color=blue];
		1020 -> 1021;
	1019 [label="这是你和亚瑟唯一会的吗？战斗？",shape=box,color=blue];
		1019 -> 1022;
	1021 [label="事实上，不管你信不信，我是关心你的。",shape=box,color=red];
		1021 -> 1027;
	1022 [label="对于存在本身的虚无，你的回应竟然是“想办法揍它一顿？”",shape=box,color=blue];
		1022 -> 1023;
	1027 [label="伙计，我也关心你。我们是队友。我们一起经历了很多。",shape=box,color=blue];
		1027 -> 1028;
	1023 [label="我真不敢相信我曾经以为我们有共同之处。",shape=box,color=blue];
		1023 -> 1024;
	1028 [label="公平地说，我应该警告你，埃莉诺号这艘船可能会沉没，不论是在血海之中还是在漆黑的沼泽里，而你绝对不想在她沉没时仍待在船上。",shape=box,color=blue];
		1028 -> 1030;
	1024 [label="真是自作多情。",shape=box,color=blue];
		1024 -> 1025;
	1030 [label="+20 Chemistry",color=orange];
		1030 -> 1029;
	1025 [label="Update boolean EleanorNoDate",color=orange];
		1025 -> 1026;
	1029 [label="谢谢。你应该走了。我现在会没事的。真的。",shape=box,color=blue];
		1029 -> 1031;
	1026 [label="Chat ends.",color=orange];
	1031 [label="Chat ends.",color=orange];
}