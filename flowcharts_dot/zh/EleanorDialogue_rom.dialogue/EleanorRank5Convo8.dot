digraph {
	2659 [label="EleanorRank5Convo8 begins.",color=orange];
		2659 -> 2660;
	2660 [label="我一直在想。有件事我必须要做。",shape=box,color=blue];
		2660 -> 2661;
	2661 [label="我会需要帮助的。",shape=box,color=blue];
		2661 -> 2662;
		2661 -> 2663;
	2662 [label="我永远在这里支持你。你在想什么？",shape=box,color=red];
		2662 -> 2665;
	2663 [label="现在没空聊，抱歉。[结束]",shape=box,color=red];
		2663 -> 2664;
	2665 [label="Check boolean EleanorChristopher2",color=orange];
		2665 -> 2667 [label=true,color=green];
		2665 -> 2666 [label=false,color=brown];
	2664 [label="Chat ends.",color=orange];
	2667 [label="那么，关于克里斯托弗。",shape=box,color=blue];
		2667 -> 2675;
	2666 [label="Check boolean EleanorChristopher1",color=orange];
		2666 -> 2671 [label=true,color=green];
		2666 -> 2668 [label=false,color=brown];
	2675 [label="这些年我一直在怀念他。亚瑟也是如此。我们每年都会举行一个仪式来纪念他。但今年我做不到。我无法面对。",shape=box,color=blue];
		2675 -> 2676;
	2671 [label="长话短说，这是一个悲惨的故事……在我们结婚前，克里斯托弗在一次路边炸弹袭击中丧生。",shape=box,color=blue];
		2671 -> 2672;
	2668 [label="现在是时候告诉你关于克里斯托弗的事了。",shape=box,color=blue];
		2668 -> 2669;
	2676 [label="我不知道鬼魂是否存在，但它们或许真的存在，因为我让他变成了一个鬼魂。",shape=box,color=blue];
		2676 -> 2677;
	2672 [label="也许我改天再告诉你整个故事。也许我不会。",shape=box,color=blue];
		2672 -> 2673;
	2669 [label="他是亚瑟最好的朋友。我们订了婚。我以为我很爱他。",shape=box,color=blue];
		2669 -> 2670;
	2677 [label="别对自己太苛刻了。你爱过那个人。",shape=box,color=red];
		2677 -> 2678;
	2673 [label="我现在告诉你这些是因为……",shape=box,color=blue];
		2673 -> 2674;
	2670 [label="Update boolean EleanorChristopher1",color=orange];
		2670 -> 2671;
	2678 [label="哦，伙计。我以为我爱他。我爱过他，但我甚至不确定我是否真的爱上了他。",shape=box,color=blue];
		2678 -> 2679;
	2674 [label="Update boolean EleanorChristopher2",color=orange];
		2674 -> 2675;
	2679 [label="这听起来很糟糕，不是吗？但这是真的。当时，这似乎并不重要。后来他死了，这成了我们故事的全部。",shape=box,color=blue];
		2679 -> 2680;
	2680 [label="我对他的所有钦佩都被他的去世所掩盖。一想到他，我的胃就会感到一阵绞痛。",shape=box,color=blue];
		2680 -> 2681;
	2681 [label="这对他不公平。他值得更好的。",shape=box,color=blue];
		2681 -> 2682;
		2681 -> 2683;
	2682 [label="我完全理解。我选择以我父母应得的方式来纪念他们。",shape=box,color=red];
		2682 -> 2684;
	2683 [label="发生的事情很可怕。这是无法避免的。但我们不能让这成为我们的心结。",shape=box,color=red];
		2683 -> 2684;
	2684 [label="那为什么我会感到这么内疚？",shape=box,color=blue];
		2684 -> 2685;
	2685 [label="为什么我觉得放手就像是抛弃他一样？",shape=box,color=blue];
		2685 -> 2686;
		2685 -> 2688;
	2686 [label="因为你心里一直放不下他，久到不知如何让自己放手。",shape=box,color=red];
		2686 -> 2687;
	2688 [label="因为你担心再也没有人能真正爱你了。",shape=box,color=red];
		2688 -> 2689;
	2687 [label="天。你说得太对了，你知道。",shape=box,color=blue];
		2687 -> 2692;
	2689 [label="Check boolean EleanorDating",color=orange];
		2689 -> 2690 [label=true,color=green];
		2689 -> 2691 [label=false,color=brown];
	2692 [label="我们这帮人，不怎么会面对这种事。我们把一切都藏在心里。装出一副勇敢的样子，在战壕中吹口哨。这让我们撑过来了，就像我们的父母，他们也是这样撑过来的。但我们不知道该如何停止。",shape=box,color=blue];
		2692 -> 2693;
	2690 [label="是这个原因吗？我有这么肤浅吗？",shape=box,color=blue];
		2690 -> 2694;
	2691 [label="我甚至怀疑，以我现在的状态，克里斯托弗是否还会爱我……",shape=box,color=blue];
		2691 -> 2696;
	2693 [label="我该怎么办？我该如何放手？",shape=box,color=blue];
		2693 -> 2698;
	2694 [label="现在我觉得我不配得到你们中的任何一个。",shape=box,color=blue];
		2694 -> 2695;
	2696 [label="……不。这不公平。我这样对他太不公平了，不是吗？",shape=box,color=blue];
		2696 -> 2697;
	2698 [label="Check boolean LettieDiasdeMuertos",color=orange];
		2698 -> 2699 [label=true,color=green];
		2698 -> 2700 [label=true,color=green];
		2698 -> 2701 [label=true,color=green];
		2698 -> 2700 [label=false,color=brown];
		2698 -> 2701 [label=false,color=brown];
	2695 [label="我想……我希望你拥有我的全部。我不能让自己的一部分永远停留在无尽的哀悼中。",shape=box,color=blue];
		2695 -> 2698;
	2697 [label="他不会想妨碍我的幸福。他很善良。",shape=box,color=blue];
		2697 -> 2698;
	2699 [label="我真的觉得莱蒂可以帮助你。",shape=box,color=red];
		2699 -> 2702;
	2700 [label="你可以给他写一封信。",shape=box,color=red];
		2700 -> 2703;
	2701 [label="也许你可以和亚瑟谈谈。他从一开始就和你一起经历了这段悲伤。",shape=box,color=red];
		2701 -> 2704;
	2702 [label="莱蒂？",shape=box,color=blue];
		2702 -> 2705;
	2703 [label="我心里想，这是个愚蠢的想法。他不会读到这些。他已经不在了。但是……",shape=box,color=blue];
		2703 -> 2706;
	2704 [label="是的，他确实有。也许这正是问题的一部分。我知道他很不高兴，因为我今年没有继续我们的小小纪念仪式。",shape=box,color=blue];
		2704 -> 2707;
	2705 [label="为什么是她？",shape=box,color=blue];
		2705 -> 2708;
	2706 [label="……我越想越觉得这似乎并不那么愚蠢。",shape=box,color=blue];
		2706 -> 2710;
	2707 [label="我只是……这次我必须以我自己的方式和克里斯托弗告别。彻底地。",shape=box,color=blue];
		2707 -> 2711;
	2708 [label="她有很多经验。她非常了解如何纪念逝者。",shape=box,color=red];
		2708 -> 2709;
	2710 [label="好。我会去做的。有些话我需要对他说。那些他在世时我从未说过的话。也许这样他就可以安息了。",shape=box,color=blue];
		2710 -> 2712;
	2711 [label="对亚瑟来说，他永远是一个死去的兄弟，一位阵亡的士兵。这是他所知道和理解的哀悼方式。但那不是我的方式。",shape=box,color=blue];
		2711 -> 2713;
	2709 [label="我相信如果你恭敬地向她寻求建议，她不会拒绝你。",shape=box,color=red];
		2709 -> 2720;
	2712 [label="谢谢你的倾听和建议。",shape=box,color=blue];
		2712 -> 2714;
	2713 [label="我不能再用亚瑟的方式了。我想……如果我告诉他这一点，他会理解的。",shape=box,color=blue];
		2713 -> 2718;
	2720 [label="……",shape=box,color=blue];
		2720 -> 2721;
	2714 [label="+20 Chemistry",color=orange];
		2714 -> 2715;
	2718 [label="+10 Chemistry",color=orange];
		2718 -> 2719;
	2721 [label="是的",shape=box,color=blue];
		2721 -> 2722;
	2715 [label="我永远都不会忘记这件事。",shape=box,color=blue];
		2715 -> 2716;
	2719 [label="谢谢你。",shape=box,color=blue];
		2719 -> 2717;
	2722 [label="是时候了。",shape=box,color=blue];
		2722 -> 2723;
	2716 [label="Chat ends.",color=orange];
	2717 [label="Chat ends.",color=orange];
	2723 [label="+20 Chemistry",color=orange];
		2723 -> 2724;
	2724 [label="我想我需要放下很多东西。",shape=box,color=blue];
		2724 -> 2725;
	2725 [label="我要和她谈谈。如果她叫我滚蛋，那就这样吧。但至少我尝试过了，对吧？",shape=box,color=blue];
		2725 -> 2726;
	2726 [label="这值得一试。莱蒂没有人们想象的那么无情。",shape=box,color=red];
		2726 -> 2727;
	2727 [label="我敢打赌。过这样的生活，做着我们每天所做的事，我们都筑起了墙。我们只是忘了在墙上装门而已。",shape=box,color=blue];
		2727 -> 2728;
	2728 [label="谢谢你用你那可爱的头撞我的墙。",shape=box,color=blue];
		2728 -> 2729;
	2729 [label="Chat ends.",color=orange];
}