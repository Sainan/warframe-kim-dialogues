digraph {
	1621 [label="EleanorRank4Convo3 begins.",color=orange];
		1621 -> 1622;
	1622 [label="我想我做到了。我突破了。我取得了联系。",shape=box,color=blue];
		1622 -> 1623;
	1623 [label="你在吗？请一定要在。",shape=box,color=blue];
		1623 -> 1624;
	1624 [label="我必须通过心灵感应做这件事吗？哦，神啊。求你了，不要现在。",shape=box,color=blue];
		1624 -> 1625;
		1624 -> 1626;
	1625 [label="埃莉诺，慢一点说。发生什么事了？",shape=box,color=red];
		1625 -> 1628;
	1626 [label="[无视]",shape=box,color=red];
		1626 -> 1627;
	1628 [label="Check boolean EleanorSister",color=orange];
		1628 -> 1640 [label=true,color=green];
		1628 -> 1629 [label=false,color=brown];
	1627 [label="Chat ends.",color=orange];
	1640 [label="另一个我。成为修女的我。我一直在尝试联系她。",shape=box,color=blue];
		1640 -> 1641;
	1629 [label="自从你出现以后，一个问题一直困扰着我。我觉得我可能刚找到了答案。亲爱的太阳神，我不知道我做了什么。",shape=box,color=blue];
		1629 -> 1630;
	1641 [label="我刚刚做到了。",shape=box,color=blue];
		1641 -> 1642;
	1630 [label="从头说起。我不知道你在说什么。什么问题？",shape=box,color=red];
		1630 -> 1631;
	1642 [label="当然，只要我还留在这个世界，这件事就永远无法实现。我已经是这个世界的“我”了。我必须穿越那咆哮的白色所在。黑星赋格。水蛭之渊。那才是通往其他面的方式。可能和曾经可能的世界。",shape=box,color=blue];
		1642 -> 1643;
	1631 [label="你！问题就是这个该死的你。你不只存在一次，而是两次。",shape=box,color=blue];
		1631 -> 1632;
	1643 [label="虚空！我看到了虚空！",shape=box,color=blue];
		1643 -> 1644;
		1643 -> 1645;
	1632 [label="如果你能在另一个世界、以另一个版本的自己存在，那我为什么不行呢？",shape=box,color=blue];
		1632 -> 1633;
	1644 [label="你……确定你没有偷偷用了莱蒂的特别药品吗？",shape=box,color=red];
		1644 -> 1646;
	1645 [label="埃莉诺，这不可能发生。在阿尔布雷希特·英择谛之前，没有人能进入虚空。从我们现在的时间来看，那还是遥远的未来。",shape=box,color=red];
		1645 -> 1647;
	1633 [label="在这些现已被证实存在的无限的可能宇宙中，存在着那个我曾经想过要不要成为的我。",shape=box,color=blue];
		1633 -> 1634;
	1646 [label="亲爱的漂泊者，我很欣赏你用幽默来作为自己的应对机制，但此刻我是非常严肃的。",shape=box,color=blue];
		1646 -> 1648;
	1647 [label="我是用我的思想进去的，不是身体。这就是区别。",shape=box,color=blue];
		1647 -> 1650;
	1634 [label="那个放弃俗世去当修女的我。",shape=box,color=blue];
		1634 -> 1635;
	1648 [label="我实现了自己的计划。",shape=box,color=blue];
		1648 -> 1649;
	1650 [label="哎哟，头痛死了，好痛",shape=box,color=blue];
		1650 -> 1651;
	1635 [label="一位月神的信徒坐在某座山顶上，周围香烟缭绕。",shape=box,color=blue];
		1635 -> 1636;
	1649 [label="我不仅仅是见到了虚空，我还进去了。",shape=box,color=blue];
		1649 -> 1650;
	1651 [label="Check boolean EleanorIndifference2",color=orange];
		1651 -> 1652 [label=true,color=green];
		1651 -> 1654 [label=true,color=green];
		1651 -> 1653 [label=false,color=brown];
		1651 -> 1654 [label=false,color=brown];
	1636 [label="我一直在尝试联系她。试图穿过虚空去寻找她。",shape=box,color=blue];
		1636 -> 1637;
	1652 [label="如果你真的进入了虚空，我都不敢想象你把自己置于多大的危险之中。你明知道那里有什么，居然还敢直接跳进去？",shape=box,color=red];
		1652 -> 1655;
	1654 [label="你疯了吗？！",shape=box,color=red];
		1654 -> 1657;
	1653 [label="你看到了什么？发生了什么事？",shape=box,color=red];
		1653 -> 1656;
	1637 [label="Update boolean EleanorSister",color=orange];
		1637 -> 1638;
		1637 -> 1639;
	1655 [label="我最初是通过那段记忆进入虚空的。恐惧只是烟雾，而穿过烟雾就是一扇门。如果我当时没有那么害怕，我一开始就能清楚地看到它。",shape=box,color=blue];
		1655 -> 1662;
	1657 [label="一点儿也没有。",shape=box,color=blue];
		1657 -> 1659;
	1656 [label="有一种感觉是无法用语言形容的。你望向这个世界，你就知道，所有的平凡事物——建筑、汽车、人们、工作、日常生活——都只是一层薄薄的表皮，掩盖着无尽的恐怖。如果人们意识到这一点，他们会开始尖叫，永远不停歇。",shape=box,color=blue];
		1656 -> 1658;
	1638 [label="不好。",shape=box,color=red];
		1638 -> 1641;
	1639 [label="然后呢……？",shape=box,color=red];
		1639 -> 1641;
	1662 [label="这是个错误。它夺走了鲁莎卡。它差点就夺走了阿尔布雷希特。它也能轻易夺走你。",shape=box,color=red];
		1662 -> 1663;
	1659 [label="请听我说。并试着去理解。",shape=box,color=blue];
		1659 -> 1664;
		1659 -> 1665;
	1658 [label="我穿过了那层表皮。",shape=box,color=blue];
		1658 -> 1660;
	1663 [label="它试图这么做。我感觉到了。我知道它在好奇，向我伸手。",shape=box,color=blue];
		1663 -> 1664;
		1663 -> 1665;
	1664 [label="那么，在无数个可能的世界中，你偏偏找到了正确的那一个？",shape=box,color=red];
		1664 -> 1666;
	1665 [label="埃莉诺，虚空无情之物可以变成任何它想变的样子。当阿尔布雷希特第一次遇到它时，它变成了阿尔布雷希特的样子。",shape=box,color=red];
		1665 -> 1667;
	1660 [label="那不是空无。我本能承受空无。它无止境地延续，但那并不仅仅是冰冷的空间。那里有什么东西与我同在。",shape=box,color=blue];
		1660 -> 1661;
	1666 [label="你不信也没关系。我知道这听起来很疯狂。但请听我说完，好吗？",shape=box,color=blue];
		1666 -> 1668;
	1667 [label="我想它可能感知到了你的愿望，于是就变成了你希望看到的形态。",shape=box,color=red];
		1667 -> 1668;
	1661 [label="Update boolean EleanorIndifference2",color=orange];
		1661 -> 1662;
	1668 [label="我们来个约定。",shape=box,color=blue];
		1668 -> 1669;
	1669 [label="你先让我把发生的事情讲完。",shape=box,color=blue];
		1669 -> 1670;
	1670 [label="等我讲完后，你再自己决定这是不是虚空无情之物在搞鬼。我保证我会认真考虑你的意见。",shape=box,color=blue];
		1670 -> 1671;
	1671 [label="成交吗？",shape=box,color=blue];
		1671 -> 1672;
		1671 -> 1673;
	1672 [label="成交。",shape=box,color=red];
		1672 -> 1682;
	1673 [label="我简直不敢相信你会做这种事。埃莉诺，别再这样做了！我不能让那个东西夺走你！",shape=box,color=red];
		1673 -> 1674;
	1682 [label="正如我之前说的。我找到她了。",shape=box,color=blue];
		1682 -> 1683;
	1674 [label="什么？",shape=box,color=blue];
		1674 -> 1675;
	1683 [label="我能感觉到虚空无情之物在注视我。当它向我伸手时，我能感觉到它那干枯如沙漠木乃伊的面孔。我向她伸出手，她把我拉了过去。",shape=box,color=blue];
		1683 -> 1684;
	1675 [label="我不知道该说什么。我有点担心，因为你听起来很难过，但我没想到你竟然这么在乎。",shape=box,color=blue];
		1675 -> 1676;
	1684 [label="她正以莲花坐姿坐在某种露天神庙里，旁边是一个堆满余烬的坑。当时是晚上。月亮昏暗，在滚动的云层中若隐若现。",shape=box,color=blue];
		1684 -> 1685;
	1676 [label="我没事。请不要担心我。",shape=box,color=blue];
		1676 -> 1678;
	1685 [label="她把一根手指放在嘴唇上。",shape=box,color=blue];
		1685 -> 1686;
	1678 [label="+5 Chemistry",color=orange];
		1678 -> 1677;
	1686 [label="那一瞬间，我还能感觉到那只巨手在摸索着我。然后它突然收回，就像是它的一根手指被断头台砍下了一样。",shape=box,color=blue];
		1686 -> 1687;
	1677 [label="我不能保证什么，但我会尽量不再吓到你。",shape=box,color=blue];
		1677 -> 1679;
		1677 -> 1680;
	1687 [label="草儿在沙沙作响。蟋蟀在歌唱。我们俩独处一室。",shape=box,color=blue];
		1687 -> 1689;
	1679 [label="好吧……就……告诉我发生了什么事。",shape=box,color=red];
		1679 -> 1682;
	1680 [label="我不能再这样下去了。[结束]",shape=box,color=red];
		1680 -> 1681;
	1689 [label="这一切听起来真是太熟悉了。然后呢？",shape=box,color=red];
		1689 -> 1688;
	1681 [label="Chat ends.",color=orange];
	1688 [label="我们隔着火坑对坐。她没有说话，但她让我进入她的内心，那么柔和，如同姐妹一般。",shape=box,color=blue];
		1688 -> 1690;
	1690 [label="她非常幸福，非常满足。一个找到了正确位置的女人。双脚长满老茧，双眼清澈。呼吸着火焰，品味月色。",shape=box,color=blue];
		1690 -> 1691;
		1690 -> 1692;
	1691 [label="所以你觉得那会是你的正确选择吗？",shape=box,color=red];
		1691 -> 1693;
	1692 [label="你有想过留在那里吗？",shape=box,color=red];
		1692 -> 1693;
	1693 [label="不！恰恰相反！",shape=box,color=blue];
		1693 -> 1694;
	1694 [label="我不需要走那条路，因为她已经走过了。你不明白吗？我现在自由了。我再也不需要想“如果”了，因为已经有了埃莉诺修女。她会支持我。我说得有道理吗？",shape=box,color=blue];
		1694 -> 1695;
	1695 [label="有点吧？我只想知道，这对你有帮助吗？",shape=box,color=red];
		1695 -> 1696;
	1696 [label="哦，当然。我从未如此确定接下来该做什么。",shape=box,color=blue];
		1696 -> 1698;
	1698 [label="+15 Chemistry",color=orange];
		1698 -> 1697;
	1697 [label="我要尽情享受她给予我的自由，尽情享受生活。",shape=box,color=blue];
		1697 -> 1699;
	1699 [label="Chat ends.",color=orange];
}