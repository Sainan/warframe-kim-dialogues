digraph {
	1333 [label="EleanorRank3Convo6 begins.",color=orange];
		1333 -> 1334;
	1334 [label="你知道在炽蛇军接管之前，霍瓦尼亚最棒的事情是什么吗？",shape=box,color=blue];
		1334 -> 1335;
		1334 -> 1336;
