		1337 -> 1344;
	1338 [label="不知道。",shape=box,color=red];
		1338 -> 1345;
	1339 [label="不感兴趣。[结束。]",shape=box,color=red];
		1339 -> 1340;
	1342 [label="天哪。那些整过容的拥有完美脸蛋的美人吸食未经测试的毒品？不。",shape=box,color=blue];
		1342 -> 1346;
	1343 [label="听着。我一点也不反对看两个大汗淋漓的家伙互相厮杀。但不。",shape=box,color=blue];
		1343 -> 1346;
	1344 [label="猜得好。你可以买到任何东西，从布雷斯林手提包和手套套装到冷冻的人类眼球。但不是。",shape=box,color=blue];
		1344 -> 1346;
	1345 [label="嗯，你当然不知道。你是一个初来乍到的新人。",shape=box,color=blue];
		1345 -> 1346;
	1340 [label="嘘。",shape=box,color=blue];
		1340 -> 1341;
	1346 [label="是澡堂！",shape=box,color=blue];
		1346 -> 1347;
	1341 [label="Chat ends.",color=orange];
	1347 [label="我不知道你所在的地方有没有类似的。我想你会称它们为庙堂，通常有一套太阳房和一套月亮房。你可以在公共或者私人池里泡泡。一切散发着草药和蒸汽的味道，很有助于提神醒脑。",shape=box,color=blue];
		1347 -> 1348;
	1348 [label="霍瓦尼亚一直有非常重要的清洁仪式传统。我想这一切都要追溯到这座城市赖以建立的温泉。",shape=box,color=blue];
		1348 -> 1349;
	1349 [label="维克多说的那些“纯洁”的废话？他在唱老调。所有市民都懂他的想法。",shape=box,color=blue];
		1349 -> 1350;
	1350 [label="我曾经喜欢花额外的霍币，让一个肌肉发达的专业人士把我肌肉中所有的紧张都松解出来。你会喜欢的。我相信你会的。",shape=box,color=blue];
		1350 -> 1351;
		1350 -> 1352;
		1350 -> 1353;
	1351 [label="我不太确定。",shape=box,color=red];
		1351 -> 1354;
	1352 [label="听起来像是我会喜欢的。",shape=box,color=red];
		1352 -> 1357;
	1353 [label="他们怎么了？",shape=box,color=red];
		1353 -> 1359;
	1354 [label="你会穿着一件由被感染的人体制成的衣服大摇大摆地走来走去，却不愿意接受按摩？",shape=box,color=blue];
		1354 -> 1355;
	1357 [label="我就知道你是我这类的队友。",shape=box,color=blue];
		1357 -> 1358;
	1359 [label="我相信你能猜到。科腐者破坏了这么多。疫情爆发后，澡堂根本无法继续开放。",shape=box,color=blue];
		1359 -> 1360;
	1355 [label="奇怪。",shape=box,color=blue];
		1355 -> 1356;
	1358 [label="我希望其他人也不那么拘谨。遗憾的是，疫情爆发后，澡堂根本无法继续开放。",shape=box,color=blue];
		1358 -> 1360;
	1360 [label="据我所见，其中一些现在基本上就是产卵池了。说实话，这让我心碎。我记得，我在那蔓延的血肉之下，发现了有着千年历史的大理石和马赛克地板。",shape=box,color=blue];
		1360 -> 1361;
	1356 [label="Chat ends.",color=orange];
	1361 [label="你们那时候也有过这样的事吗？",shape=box,color=blue];
		1361 -> 1362;
	1362 [label="神圣的公共澡堂？没有，还真没有。",shape=box,color=red];
		1362 -> 1363;
	1363 [label="那么人们怎么放松呢？",shape=box,color=blue];
		1363 -> 1364;
		1363 -> 1365;
		1363 -> 1366;
	1364 [label="有死亡角斗场。",shape=box,color=red];
		1364 -> 1367;
	1365 [label="有些人押注指数之场。",shape=box,color=red];
		1365 -> 1368;
	1366 [label="围棋已经存在一段时间了。",shape=box,color=red];
		1366 -> 1369;
	1367 [label="听起来像是阿米尔对自己发出音效噪音……",shape=box,color=blue];
		1367 -> 1370;
	1368 [label="炒股的？",shape=box,color=blue];
		1368 -> 1371;
	1369 [label="围棋？黑色和白色的棋子？太阳神和月亮神的婚礼之战？",shape=box,color=blue];
		1369 -> 1372;
	1370 [label="这是 Grineer 的特色。是向整个星系广播的竞技场战斗仪式。",shape=box,color=red];
		1370 -> 1373;
	1371 [label="……差不多？就像是股票交易和四对四暴力游戏的结合。我知道这听起来很奇怪。",shape=box,color=red];
		1371 -> 1374;
	1372 [label="嗯。。是的？等等，这就是围棋所代表的意思吗？",shape=box,color=red];
		1372 -> 1375;
	1373 [label="这对他们来说是一件大事，非常严肃。",shape=box,color=red];
		1373 -> 1376;
	1374 [label="Corpus 对此非常疯狂。",shape=box,color=red];
		1374 -> 1377;
	1375 [label="我们只知道它是一种棋盘游戏！",shape=box,color=red];
		1375 -> 1378;
	1376 [label="爸爸和亚瑟以前每周六晚上都会一起看摔跤。",shape=box,color=blue];
		1376 -> 1380;
	1377 [label="但他们是你的敌人，不是吗？还是你们在团队运动方面有某种休战？",shape=box,color=blue];
		1377 -> 1383;
	1378 [label="奥罗金人很喜欢它。甚至在双衍王境也有。",shape=box,color=red];
		1378 -> 1379;
	1380 [label="+10 Chemistry",color=orange];
		1380 -> 2815;
	1383 [label="+10 Chemistry",color=orange];
		1383 -> 2079;
	1379 [label="不过，我都不知道它有那么古老。",shape=box,color=red];
		1379 -> 1384;
	2815 [label="如果有机会，就给他塞几盘死亡角斗场的录像带。我想他会喜欢的。",shape=box,color=blue];
		2815 -> 1381;
	2079 [label="我在说什么呢？当然有。人性就是这样的。",shape=box,color=blue];
		2079 -> 1382;
	1384 [label="古老？它是神圣的！而且很有趣。绝妙的组合。",shape=box,color=blue];
		1384 -> 1385;
	1381 [label="Chat ends.",color=orange];
	1382 [label="Chat ends.",color=orange];
	1385 [label="你知道吗，一切都围绕着相同的两个基本原则？心灵与身体。象征与意义。太阳神与月亮神。",shape=box,color=blue];
