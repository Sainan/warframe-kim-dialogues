digraph {
	1953 [label="EleanorRank4Convo7 begins.",color=orange];
		1953 -> 1954;
	1954 [label="我有个问题想问你，但不确定你会怎么反应，所以如果我问得不妥，请直说。",shape=box,color=blue];
		1954 -> 1955;
	1955 [label="好。",shape=box,color=red];
		1955 -> 1956;
	1956 [label="你的父母是什么样的人？",shape=box,color=blue];
		1956 -> 1957;
		1956 -> 1958;
		1956 -> 1959;
		1956 -> 1960;
		1956 -> 1962;
	1957 [label="已经过去太久了，我几乎记不清了。",shape=box,color=red];
		1957 -> 1963;
	1958 [label="非常善良。他们尽力对我好了。",shape=box,color=red];
		1958 -> 1965;
	1959 [label="非常严格。他们说了算，并且让我明白这一点。",shape=box,color=red];
		1959 -> 1967;
	1960 [label="非常绝望。我还不如是被野生库狛养大的。",shape=box,color=red];
		1960 -> 1972;
	1962 [label="我……现在不想谈这个了。对不起。[结束]",shape=box,color=red];
		1962 -> 1978;
	1963 [label="对不起。我愚蠢地以为，既然你对扎里曼的记忆这么清晰，你也能记得你的父母。",shape=box,color=blue];
		1963 -> 1964;
	1965 [label="我很高兴。如果你不介意的话我这么说，这从你身上可以看出来。",shape=box,color=blue];
		1965 -> 1966;
	1967 [label="我不认为你的成长环境是温柔的。我猜殖民者需要坚强。",shape=box,color=blue];
		1967 -> 1970;
	1972 [label="哦天哪。好吧，不管怎么说，你自己变成了一个相当不错的人。",shape=box,color=blue];
		1972 -> 1973;
	1978 [label="不，我很抱歉。我没有权利去问。",shape=box,color=blue];
		1978 -> 1979;
	1964 [label="我忘了你已经历了许多世。",shape=box,color=blue];
		1964 -> 1968;
	1966 [label="你心中有着善良的温暖火焰，我想知道是谁帮助点燃了它。",shape=box,color=blue];
		1966 -> 1969;
	1970 [label="在那些奥罗金人的统治下，有人能成长得这么好真是不可思议。",shape=box,color=blue];
		1970 -> 1971;
	1973 [label="我只希望你当初能过得轻松一些。",shape=box,color=blue];
		1973 -> 1974;
	1979 [label="Chat ends.",color=orange];
	1968 [label="Update boolean DrifterParentsUnknown",color=orange];
		1968 -> 1980;
	1969 [label="Update boolean DrifterParentsKind",color=orange];
		1969 -> 1980;
	1971 [label="Update boolean DrifterParentsStrict",color=orange];
		1971 -> 1980;
	1974 [label="Update boolean DrifterParentsUseless",color=orange];
		1974 -> 1980;
	1980 [label="你为什么问这个？",shape=box,color=red];
		1980 -> 1981;
	1981 [label="我在想我的父母。其实我经常这么做。我就坐在那里，想象爸爸妈妈会怎么看待他们孩子现在的样子。",shape=box,color=blue];
		1981 -> 1982;
		1981 -> 1983;
	1982 [label="他们是怎样的人？",shape=box,color=red];
		1982 -> 1984;
	1983 [label="他们是怎样的父母？",shape=box,color=red];
		1983 -> 1985;
	1984 [label="从性格上看，他们完全不是一类人，这意味着他们的关系在最初几年里会热烈而明亮，但之后就会崩塌成一个吞噬一切黑洞。",shape=box,color=blue];
		1984 -> 1986;
	1985 [label="一个词，不合拍。爸爸希望我们独立，所以他会设计一些情况让我们不得不独立。比如把我们扔进树林里，只给一把小刀之类的。妈妈总是赶来救我们。这注定是无法维持的。",shape=box,color=blue];
		1985 -> 1987;
	1986 [label="爸爸是退伍军人。他性格开朗，眼睛有点皱纹，说话像播音员，内心很破碎，破碎得就像摇晃时会响的沙砾袋。他其实特别容易难过。我曾经随口说了些我以为很无伤大雅的话，后来却听到他在厕所里哭。",shape=box,color=blue];
		1986 -> 1988;
	1987 [label="亚瑟和我很快就学会了怎么让他们互相掐架。你知道孩子都爱这样。",shape=box,color=blue];
		1987 -> 1989;
	1988 [label="妈妈那边家境富裕，这意味着她的生活比较自由。她没沉迷于派对，不会酗酒、吸毒，也不会在拉德斯顿公寓里连续狂欢一整周。那些更像是贾妮丝姨妈的风格。妈妈更喜欢鲜花、陶艺刺猬、香薰和一切温馨美好的事物。",shape=box,color=blue];
		1988 -> 1990;
	1989 [label="父母总想过度弥补他们觉得自己父母做错的事情，不是吗？",shape=box,color=blue];
		1989 -> 1990;
	1990 [label="你说的一半话我听着像虚空语，但我想我能理解。",shape=box,color=red];
		1990 -> 1991;
	1991 [label="好吧，他们现在离婚了。等我们都成年后才离的，说是出于“考虑”。多体贴啊，你不觉得吗？就因为“孩子们需要稳定”之类的屁话，让我们在一个他妈的战场般的家里生活。",shape=box,color=blue];
		1991 -> 1992;
	1992 [label="你们还有联系么？",shape=box,color=red];
		1992 -> 1993;
	1993 [label="偶尔吧。我们以前总是在冬至回家。现在我真的很怀念那时候。装饰星星树，为太阳神加冕，小孩子们打扮成月神的三种形象挨家挨户拜访，烤鸟肉……这听起来很伤感，但我真的很喜欢。",shape=box,color=blue];
		1993 -> 1994;
	1994 [label="冬至的时候，爸妈总会停战，而且他们总是遵守协议。在好的年头，他们甚至能在节后的第三天才开始吵架，即使一直喝着李子白兰地。",shape=box,color=blue];
		1994 -> 1995;
	1995 [label="如果你感觉到一阵思乡之情如潮水般涌来，那是因为我。抱歉。",shape=box,color=blue];
		1995 -> 1996;
	1996 [label="我通常把强烈的情绪藏在心里，但有时它们就像锅里的牛奶一样沸腾起来，影响到每一个人。然后我就得在即时通上到处道歉。",shape=box,color=blue];
		1996 -> 1997;
	1997 [label="为什么现在提起这个？",shape=box,color=red];
		1997 -> 1998;
	1998 [label="我只是在想他们会怎么看你。如果我们能离开这个地方，我想带上我的时空旅行朋友一起去吃冬至晚餐。",shape=box,color=blue];
		1998 -> 1999;
	1999 [label="我想你会喜欢的。你和爸爸还有亚瑟可以坐在炉火边，交换战斗的故事，妈妈可以温柔地问你是否单身。",shape=box,color=blue];
		1999 -> 2000;
		1999 -> 2001;
		1999 -> 2002;
		1999 -> 2003;
	2000 [label="我觉得我吓到他们。",shape=box,color=red];
		2000 -> 2016;
	2001 [label="为了你，我会表现得非常好。",shape=box,color=red];
		2001 -> 2017;
	2002 [label="老实说，这听起来很有意思。",shape=box,color=red];
		2002 -> 2018;
	2003 [label="单身？等等，我是以伴侣的身份回家吗？",shape=box,color=red];
		2003 -> 2007;
