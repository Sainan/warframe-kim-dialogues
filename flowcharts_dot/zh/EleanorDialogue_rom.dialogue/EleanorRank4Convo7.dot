	2018 [label="+15 Chemistry",color=orange];
		2018 -> 2006;
	2007 [label="嗯。",shape=box,color=blue];
		2007 -> 2011;
	2004 [label="哈！这更让我想去这么做了。",shape=box,color=blue];
		2004 -> 2008;
	2005 [label="你真贴心！",shape=box,color=blue];
		2005 -> 2009;
	2006 [label="哦天哪，我们就这么办吧。如果有机会，我们一定要让它成真。",shape=box,color=blue];
		2006 -> 2010;
	2011 [label="“这话题转得太快了，”她一边扇风一边说。",shape=box,color=blue];
		2011 -> 2015;
	2008 [label="我能想象到爸爸礼貌地问道：“所以说，一直都是被刺死的吗，还是他们试过其他方式？”",shape=box,color=blue];
		2008 -> 2012;
	2009 [label="……我应该在尝试实现这个梦想之前放手。我们现在在这里，这就是现在，而且战争仍在继续。",shape=box,color=blue];
		2009 -> 2013;
	2010 [label="谢谢。",shape=box,color=blue];
		2010 -> 2014;
