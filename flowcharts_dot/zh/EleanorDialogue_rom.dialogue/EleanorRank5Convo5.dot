	2462 [label="Chat ends.",color=orange];
	2464 [label="你好，我亲爱的。",shape=box,color=blue];
		2464 -> 2467;
		2464 -> 2468;
	2465 [label="你好，这位来自另一个时代的神秘又莫名让人着迷的陌生人。",shape=box,color=blue];
		2465 -> 2467;
		2465 -> 2468;
	2467 [label="你昨晚睡得好些了吗？",shape=box,color=red];
		2467 -> 2466;
	2468 [label="你又做噩梦了吗？",shape=box,color=red];
		2468 -> 2466;
	2466 [label="自从我跟你说了卡莉奶奶的事情后，我就再也没有梦到过亚瑟。我想你驱除了那个恶魔。",shape=box,color=blue];
		2466 -> 2469;
	2469 [label="Check boolean EleanorDating",color=orange];
		2469 -> 2470 [label=true,color=green];
		2469 -> 2471 [label=false,color=brown];
	2470 [label="但自从我们在一起以来，发生了一些别的事情。其实有点尴尬。我一直想和你谈谈这件事，但没有找到合适的时机。",shape=box,color=blue];
		2470 -> 2472;
		2470 -> 2473;
		2470 -> 2474;
	2471 [label="但这并不意味着没有做过其他的梦。相当令人不安的那种。",shape=box,color=blue];
		2471 -> 2480;
		2471 -> 2481;
		2471 -> 2482;
	2472 [label="你梦到我了？",shape=box,color=red];
		2472 -> 2475;
	2473 [label="你梦到我们了？",shape=box,color=red];
		2473 -> 2476;
	2474 [label="尴尬？这听起来不太好。",shape=box,color=red];
		2474 -> 2477;
	2480 [label="我不认为你那么容易受到干扰。",shape=box,color=red];
		2480 -> 2483;
	2481 [label="是不是梦到从无尽的楼梯上摔下来？",shape=box,color=red];
		2481 -> 2484;
	2482 [label="这可能很重要。以你的能力，一个梦可能不仅仅是一个梦。",shape=box,color=red];
		2482 -> 2485;
	2475 [label="那不会尴尬。这个才尴尬。",shape=box,color=blue];
		2475 -> 2478;
	2476 [label="天，我倒希望是。不过恐怕没有那么愉快。",shape=box,color=blue];
		2476 -> 2478;
	2477 [label="别担心。事情并没有那么糟。我并不害怕。只是……",shape=box,color=blue];
		2477 -> 2478;
	2483 [label="我的确不容易受到干扰，这就是为什么这件事很困扰我。",shape=box,color=blue];
		2483 -> 2486;
	2484 [label="不，不是那个。不过有趣的是，似乎每个人都做过那种梦。",shape=box,color=blue];
		2484 -> 2486;
	2485 [label="这正是我所担心的。",shape=box,color=blue];
		2485 -> 2486;
	2478 [label="（好的，埃莉诺，深呼吸，你可以的）",shape=box,color=blue];
		2478 -> 2479;
	2486 [label="（好的，埃莉诺，深呼吸，你可以的）",shape=box,color=blue];
		2486 -> 2487;
	2479 [label="我觉得科腐者嫉妒了。",shape=box,color=blue];
		2479 -> 2490;
		2479 -> 2491;
	2487 [label="我觉得科腐者嫉妒了。",shape=box,color=blue];
		2487 -> 2488;
		2487 -> 2489;
	2490 [label="你开玩笑的吧。",shape=box,color=red];
		2490 -> 2494;
	2491 [label="嫉妒了？",shape=box,color=red];
		2491 -> 2495;
	2488 [label="你开玩笑的吧。",shape=box,color=red];
		2488 -> 2492;
	2489 [label="嫉妒了？",shape=box,color=red];
		2489 -> 2493;
	2494 [label="哦，我倒希望我是在开玩笑。",shape=box,color=blue];
		2494 -> 2496;
	2495 [label="嫉妒你把我从它那抢走，没错。",shape=box,color=blue];
		2495 -> 2496;
	2492 [label="哦，我倒希望我是在开玩笑。",shape=box,color=blue];
		2492 -> 2497;
	2493 [label="嫉妒我们的友谊，没错。",shape=box,color=blue];
		2493 -> 2497;
	2496 [label="在某种极其扭曲的层面上，它认为我是它的所有物。我本应成为它的繁殖对象。你知道，传承种把我视为竞争对手的女王。",shape=box,color=blue];
		2496 -> 2498;
		2496 -> 2499;
	2497 [label="在某种极其扭曲的层面上，它认为我是它的所有物。我本应成为它的繁殖对象。你知道，传承种把我视为竞争对手的女王。",shape=box,color=blue];
		2497 -> 2500;
		2497 -> 2501;
	2498 [label="战甲不是这样运作的。它们体内的感染已经被驯服，处于休眠状态。我想 Nidus 除外，有自己的规则。",shape=box,color=red];
		2498 -> 2503;
	2499 [label="所以科腐者认为我从它那里偷走了你，现在它想要你回去？",shape=box,color=red];
		2499 -> 2504;
	2500 [label="战甲不是这样运作的。它们体内的感染已经被驯服，处于休眠状态。我想 Nidus 除外，有自己的规则。",shape=box,color=red];
		2500 -> 2502;
	2501 [label="所以科腐者认为我在阻止你回去？",shape=box,color=red];
		2501 -> 2505;
	2503 [label="嗯，如果我是一个完整的战甲，那么科腐者可能就不会这么看我了。事实上，我的细胞仍在活跃，它把我当成了自己的一部分。",shape=box,color=blue];
		2503 -> 2506;
	2504 [label="这不是很奇怪吗？被抛弃的前任！",shape=box,color=blue];
		2504 -> 2506;
	2502 [label="嗯，如果我是一个完整的战甲，那么科腐者可能就不会这么看我了。事实上，我的细胞仍在活跃，它把我当成了自己的一部分。",shape=box,color=blue];
		2502 -> 2507;
	2505 [label="是的。它想要我回到它的队伍中。",shape=box,color=blue];
		2505 -> 2507;
	2506 [label="在我们那，你得去超市后面和它打一架。我不确定在你们的时代这种事是怎么处理的。",shape=box,color=blue];
		2506 -> 2508;
	2507 [label="它在耳边低语，这才是你真正的家庭。再次成为我们的一部分吧，被分离的姐妹。接受我们吧。",shape=box,color=blue];
		2507 -> 2508;
	2508 [label="等一下，倒回去一点。你怎么知道这就是科腐者的感受？",shape=box,color=red];
		2508 -> 2509;
	2509 [label="哦天，这部分有点尴尬。",shape=box,color=blue];
		2509 -> 2510;
	2510 [label="我之前提到的那些梦？我确信那是科腐者发出的。",shape=box,color=blue];
		2510 -> 2511;
	2511 [label="无论那东西有什么能算是思想的东西，它总是能与我的思想连接。它发出的思想总是那么粗糙和弱小，我可以轻松抵挡它们。",shape=box,color=blue];
		2511 -> 2512;
	2512 [label="大多数时候，它只是让我感觉到后脑勺有种疯狂的抓挠感，就像你在洗手间里，外面有只猫想进来一样。",shape=box,color=blue];
		2512 -> 2513;
		2512 -> 2514;
	2513 [label="但当你睡着的时候，情况就不同了，对吗？",shape=box,color=red];
		2513 -> 2515;
	2514 [label="我想我知道这是怎么回事了。",shape=box,color=red];
		2514 -> 2515;
	2515 [label="对。我的防御降低了，它就能接触及到我。",shape=box,color=blue];
		2515 -> 2516;
	2516 [label="它一直在最原始的层面上影响我，如果你明白我的意思。它想要我回去。它承诺它能让我感受到前所未有的狂喜。",shape=box,color=blue];
		2516 -> 2517;
	2517 [label="它会将新生命的包囊播种在我的肉体。因为它以为这是我想要的，你知道的。",shape=box,color=blue];
		2517 -> 2518;
	2518 [label="Check boolean EleanorDating",color=orange];
		2518 -> 2519 [label=true,color=green];
		2518 -> 2520 [label=true,color=green];
		2518 -> 2521 [label=false,color=brown];
		2518 -> 2522 [label=false,color=brown];
	2519 [label="好吧，看来我们就这样了。我怎么能和那种东西竞争呢？",shape=box,color=red];
		2519 -> 2523;
	2520 [label="我会*烧掉一切*，绝不让它带走你。",shape=box,color=red];
		2520 -> 2524;
	2521 [label="我绝不会让它夺走你，埃莉诺。你是我的朋友。",shape=box,color=red];
		2521 -> 2525;
	2522 [label="你就像我的家人一样。我不会让它得逞。",shape=box,color=red];
		2522 -> 2526;
	2523 [label="+20 Chemistry",color=orange];
		2523 -> 2530;
	2524 [label="这种话可是会让漂泊者被吻个不停哦。",shape=box,color=blue];
		2524 -> 2527;
	2525 [label="我知道。我想它也知道，所以它才这么生气。它争不过我们。",shape=box,color=blue];
		2525 -> 2528;
	2526 [label="知道有你支持我，我就能更安心地睡觉了。",shape=box,color=blue];
		2526 -> 2529;
	2530 [label="没事的，亲爱的。我不会为了一团化脓的、漂浮着孤立科技的结核肉块而离开你。",shape=box,color=blue];
		2530 -> 2531;
	2527 [label="+20 Chemistry",color=orange];
		2527 -> 2532;
	2528 [label="+20 Chemistry",color=orange];
		2528 -> 2533;
	2529 [label="+20 Chemistry",color=orange];
		2529 -> 2534;
	2531 [label="只是……如果有一天早晨我们一起醒来，你发现我的眼睛特别黑，脸色特别憔悴，请给我带一杯浓咖啡，不要问我细节好吗？",shape=box,color=blue];
		2531 -> 2535;
		2531 -> 2536;
	2532 [label="想不想真正让科腐者嫉妒一把？",shape=box,color=blue];
		2532 -> 2538;
	2533 [label="那么，我们会一起面对它。并肩作战。永远。",shape=box,color=blue];
