		654 -> 658 [label=false,color=brown];
	655 [label="你还好吗？真的好吗？",shape=box,color=red];
		655 -> 659;
	656 [label="她简直要把我*吓死*了。",shape=box,color=red];
		656 -> 660;
	657 [label="没事。我猜这事……挺复杂的。",shape=box,color=red];
		657 -> 661;
	658 [label="我要怎么确定你是呢？",shape=box,color=red];
		658 -> 662;
	659 [label="不。我非常非常不好",shape=box,color=blue];
		659 -> 663;
	660 [label="+5 Chemistry",color=orange];
		660 -> 664;
	661 [label="+5 Chemistry",color=orange];
		661 -> 665;
	662 [label="抱歉你没法确定。如果能让你好受的话，其实我大多数早上自己都不相信自己",shape=box,color=blue];
		662 -> 663;
	663 [label="你知道每天早上醒来，不知道自己是否能平安无事的感觉吗？",shape=box,color=blue];
		663 -> 666;
	664 [label="哈哈。可不是嘛。终于有人知道我的苦了",shape=box,color=blue];
		664 -> 667;
	665 [label="我……至少可以这么说……",shape=box,color=blue];
		665 -> 663;
	666 [label="不知道自己能不能熬过这一天？或者我是不是得把自己关在房间里，锁上门，叫所有人走开",shape=box,color=blue];
		666 -> 668;
	667 [label="我希望她只是吓人而已。那样我还能处理。如果她只是像《钉头》那样的恐怖电影里的怪物一直缠着我，那倒还好",shape=box,color=blue];
		667 -> 669;
	668 [label="钻进自己的世界，把自己隐藏起来，不让他们看到我那一面",shape=box,color=blue];
		668 -> 670;
	669 [label="全身穿着黑胶衣，戴着链条和乳环，还有夸张的登场，那我还能接受。但是",shape=box,color=blue];
		669 -> 663;
	670 [label="害怕它会做些什么",shape=box,color=blue];
		670 -> 671;
	671 [label="你知道醒来时……不知道会变成什么样子的自己是什么感觉吗？",shape=box,color=blue];
		671 -> 672;
		671 -> 673;
		671 -> 674;
	672 [label="不太知道。",shape=box,color=red];
		672 -> 675;
	673 [label="嗯。我知道。",shape=box,color=red];
		673 -> 676;
		673 -> 677;
		673 -> 678;
	674 [label="我不敢说我知道，但我还是能理解的……",shape=box,color=red];
		674 -> 679;
	675 [label="真羡慕你。",shape=box,color=blue];
		675 -> 680;
	676 [label="我甚至不知道该如何描述它。但我理解。相信我。",shape=box,color=red];
		676 -> 681;
	677 [label="有时候我醒来，感觉有另一个我活在一个陌生人的皮囊下。感觉表面的我与真实的我不相符。就像我是一个谎言。",shape=box,color=red];
		677 -> 682;
	678 [label="有时候我一醒来就痛不欲生，只想钻进一个洞里，希望这一天快点过去。等明天再试一次。但我知道这种痛会一直回来。",shape=box,color=red];
		678 -> 683;
	679 [label="Update boolean FlarePainEmpathy",color=orange];
		679 -> 684;
	680 [label="Update boolean FlarePainNone",color=orange];
		680 -> 685;
	681 [label="漂泊者，我相信你。每个人都有自己的旅程，而你的旅程又漫长又……独特",shape=box,color=blue];
		681 -> 686;
	682 [label="你这话说到我心坎里了。在丽兹出现在我的生活之前，我就一直觉得自己是两个人共用一个身体",shape=box,color=blue];
		682 -> 687;
	683 [label="慢性疼痛……当你的身体背叛你的时候。我有个好朋友，因为这个不得不放弃跟他们的乐队一起巡演",shape=box,color=blue];
		683 -> 688;
		683 -> 689;
	684 [label="还有……我很抱歉一开始跟你说话的方式完全像个混蛋。我……只是真的很害怕",shape=box,color=blue];
		684 -> 690;
	685 [label="看……我很抱歉一开始跟你说话的方式完全像个混蛋。我……只是真的很害怕",shape=box,color=blue];
		685 -> 690;
	686 [label="你的痛苦是你自己的，我不能假装完全理解",shape=box,color=blue];
		686 -> 691;
	687 [label="学会去爱上这个谎言，并唱出它的真实，是我学过的最难的事之一",shape=box,color=blue];
		687 -> 692;
	688 [label="不。我指的不是这个。",shape=box,color=red];
		688 -> 679;
	689 [label="对，正是这样。",shape=box,color=red];
		689 -> 693;
	690 [label="我只是……一开始，我的乐队不是被科腐者，而是被那个鸟人毁了。现在，我还要对付她及她对我的企图",shape=box,color=blue];
		690 -> 694;
	691 [label="Update boolean FlarePainUnique",color=orange];
		691 -> 684;
	692 [label="我觉得这是一个我们永远都在挣扎的课题",shape=box,color=blue];
		692 -> 695;
	693 [label="Update boolean FlarePainChronic",color=orange];
		693 -> 684;
	694 [label="既然我的……秘密已经暴露了，那可以这么说，我想和你重新开始。你好。我是弗莱尔。我迫切需要你的帮助，来摆脱那个试图摧毁我的东西",shape=box,color=blue];
		694 -> 696;
		694 -> 697;
	695 [label="Update boolean FlarePainStranger",color=orange];
		695 -> 684;
	696 [label="你能告诉我这一切是怎么开始的吗？你最初是怎么遇到丽兹的？",shape=box,color=red];
		696 -> 698;
	697 [label="你为什么觉得丽兹想要毁掉你？",shape=box,color=red];
		697 -> 699;
	698 [label="就在那个鸟人公开处决我的乐队成员之后",shape=box,color=blue];
		698 -> 700;
	699 [label="因为我能听到她，在我心灵的边缘低语，不断地抓挠",shape=box,color=blue];
		699 -> 701;
	700 [label="还在每个频道上，称*我们*是人民的敌人。他怎么敢这么做？！？！",shape=box,color=blue];
		700 -> 702;
	701 [label="“你是我的，你的全部都是我的，你永远都是我的”",shape=box,color=blue];
		701 -> 703;
	702 [label="他怎么敢试图灭我们口？！我不能让他这么做……我当时很绝望。我让愤怒——那股*怒火*驱使我",shape=box,color=blue];
		702 -> 704;
	703 [label="“让我们进来”",shape=box,color=blue];
		703 -> 705;
	704 [label="我做了我唯一知道的事。也是我一生中唯一会做的事",shape=box,color=blue];
		704 -> 706;
	705 [label="“我们可以合二为一，我们可以变得完整”",shape=box,color=blue];
		705 -> 707;
	706 [label="我拿起我的吉他，用我的音乐回击他的声音",shape=box,color=blue];
		706 -> 708;
	707 [label="漂泊者，*你*觉得这听起来像什么？在我听来，就像一个想要吞噬我的恶魔",shape=box,color=blue];
		707 -> 709;
		707 -> 710;
		707 -> 711;
	708 [label="那音乐在我体内尖叫，渴望被释放",shape=box,color=blue];
		708 -> 712;
	709 [label="是的，我理解你的感受。我也不认为她……完全是无害的。",shape=box,color=red];
		709 -> 713;
	710 [label="干嘛不直接甩掉她？",shape=box,color=red];
		710 -> 714;
	711 [label="也许吧？又或者……你其实是在对抗一个共生生物？",shape=box,color=red];
		711 -> 715;
	712 [label="那是我一生中从未有过的感觉",shape=box,color=blue];
		712 -> 716;
	713 [label="+5 Chemistry",color=orange];
		713 -> 717;
	714 [label="哦，我谢谢你，没有你纯粹无比的天才智慧我可怎么办呢？！？！",shape=box,color=blue];
		714 -> 718;
	715 [label="共生？和一个说想要“合而为一”并且——并且要吞噬我的东西谈和解？！？！",shape=box,color=blue];
		715 -> 719;
	716 [label="我走上舞台，释放出失去朋友所带来的所有痛苦、所有愤怒、所有悲痛。我疯狂弹奏直到手指流血……",shape=box,color=blue];
		716 -> 720;
	717 [label="*谢谢你。*拜托了，我们得找个办法永远摆脱她",shape=box,color=blue];
		717 -> 721;
	718 [label="你当我傻的吗？！？！",shape=box,color=blue];
