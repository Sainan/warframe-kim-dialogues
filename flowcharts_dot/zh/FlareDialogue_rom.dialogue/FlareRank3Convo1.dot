	j1997779354 [label="那个……",shape=box,color=red];
		j1997779354 -> j4288814842;
	j2694380989 [label="我该从哪开始呢？",shape=box,color=red];
		j2694380989 -> j4288814842;
	j2646216374 [label="嗯。嗨。",shape=box,color=red];
		j2646216374 -> j4288814842;
