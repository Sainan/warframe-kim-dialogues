		j2564159568 -> j2705117016 [label=true,color=green];
		j2564159568 -> j4049316351 [label=true,color=green];
		j2564159568 -> j1684775223 [label=true,color=green];
		j2564159568 -> j1920878870 [label=true,color=green];
		j2564159568 -> j2705117016 [label=false,color=brown];
		j2564159568 -> j1684775223 [label=false,color=brown];
		j2564159568 -> j1920878870 [label=false,color=brown];
	j2705117016 [label="你还好吗？真的好吗？",shape=box,color=red];
		j2705117016 -> j3974817821;
	j4049316351 [label="她简直要把我*吓死*了。",shape=box,color=red];
		j4049316351 -> j3322409918;
	j1684775223 [label="没事。我猜这事……挺复杂的。",shape=box,color=red];
		j1684775223 -> j3867267307;
	j1920878870 [label="我要怎么确定你是呢？",shape=box,color=red];
		j1920878870 -> j1618864132;
	j3974817821 [label="不。我非常非常不好",shape=box,color=blue];
		j3974817821 -> j2827209533;
	j3322409918 [label="+5 Chemistry",color=orange];
		j3322409918 -> j2088929191;
	j3867267307 [label="+5 Chemistry",color=orange];
		j3867267307 -> j1971975521;
	j1618864132 [label="抱歉你没法确定。如果能让你好受的话，其实我大多数早上自己都不相信自己",shape=box,color=blue];
		j1618864132 -> j2827209533;
	j2827209533 [label="你知道每天早上醒来，不知道自己是否能平安无事的感觉吗？",shape=box,color=blue];
		j2827209533 -> j3232410057;
	j2088929191 [label="哈哈。可不是嘛。终于有人知道我的苦了",shape=box,color=blue];
		j2088929191 -> j1130703104;
	j1971975521 [label="我……至少可以这么说……",shape=box,color=blue];
		j1971975521 -> j2827209533;
	j3232410057 [label="不知道自己能不能熬过这一天？或者我是不是得把自己关在房间里，锁上门，叫所有人走开",shape=box,color=blue];
		j3232410057 -> j3224458536;
	j1130703104 [label="我希望她只是吓人而已。那样我还能处理。如果她只是像《钉头》那样的恐怖电影里的怪物一直缠着我，那倒还好",shape=box,color=blue];
		j1130703104 -> j1571284489;
	j3224458536 [label="钻进自己的世界，把自己隐藏起来，不让他们看到我那一面",shape=box,color=blue];
		j3224458536 -> j3299374801;
	j1571284489 [label="全身穿着黑胶衣，戴着链条和乳环，还有夸张的登场，那我还能接受。但是",shape=box,color=blue];
		j1571284489 -> j2827209533;
	j3299374801 [label="害怕它会做些什么",shape=box,color=blue];
		j3299374801 -> j1829917303;
	j1829917303 [label="你知道醒来时……不知道会变成什么样子的自己是什么感觉吗？",shape=box,color=blue];
		j1829917303 -> j2555698236;
		j1829917303 -> j135194231;
		j1829917303 -> j1155904095;
	j2555698236 [label="不太知道。",shape=box,color=red];
		j2555698236 -> j238057938;
	j135194231 [label="嗯。我知道。",shape=box,color=red];
		j135194231 -> j626870187;
		j135194231 -> j3769583360;
		j135194231 -> j3197324064;
	j1155904095 [label="我不敢说我知道，但我还是能理解的……",shape=box,color=red];
		j1155904095 -> j1520533011;
	j238057938 [label="真羡慕你。",shape=box,color=blue];
		j238057938 -> j3234973717;
	j626870187 [label="我甚至不知道该如何描述它。但我理解。相信我。",shape=box,color=red];
		j626870187 -> j3774758216;
	j3769583360 [label="有时候我醒来，感觉有另一个我活在一个陌生人的皮囊下。感觉表面的我与真实的我不相符。就像我是一个谎言。",shape=box,color=red];
		j3769583360 -> j4093216020;
	j3197324064 [label="有时候我一醒来就痛不欲生，只想钻进一个洞里，希望这一天快点过去。等明天再试一次。但我知道这种痛会一直回来。",shape=box,color=red];
		j3197324064 -> j379564624;
	j1520533011 [label="Boolean FlarePainEmpathy is now true.",color=orange];
		j1520533011 -> j3335724203;
	j3234973717 [label="Boolean FlarePainNone is now true.",color=orange];
		j3234973717 -> j3438815549;
	j3774758216 [label="漂泊者，我相信你。每个人都有自己的旅程，而你的旅程又漫长又……独特",shape=box,color=blue];
		j3774758216 -> j1391700780;
	j4093216020 [label="你这话说到我心坎里了。在丽兹出现在我的生活之前，我就一直觉得自己是两个人共用一个身体",shape=box,color=blue];
		j4093216020 -> j2580201064;
	j379564624 [label="慢性疼痛……当你的身体背叛你的时候。我有个好朋友，因为这个不得不放弃跟他们的乐队一起巡演",shape=box,color=blue];
		j379564624 -> j3217105602;
		j379564624 -> j3779193354;
	j3335724203 [label="还有……我很抱歉一开始跟你说话的方式完全像个混蛋。我……只是真的很害怕",shape=box,color=blue];
		j3335724203 -> j2127310494;
	j3438815549 [label="看……我很抱歉一开始跟你说话的方式完全像个混蛋。我……只是真的很害怕",shape=box,color=blue];
		j3438815549 -> j2127310494;
	j1391700780 [label="你的痛苦是你自己的，我不能假装完全理解",shape=box,color=blue];
		j1391700780 -> j2499168753;
	j2580201064 [label="学会去爱上这个谎言，并唱出它的真实，是我学过的最难的事之一",shape=box,color=blue];
		j2580201064 -> j164465951;
	j3217105602 [label="不。我指的不是这个。",shape=box,color=red];
		j3217105602 -> j1520533011;
	j3779193354 [label="对，正是这样。",shape=box,color=red];
		j3779193354 -> j3736621303;
	j2127310494 [label="我只是……一开始，我的乐队不是被科腐者，而是被那个鸟人毁了。现在，我还要对付她及她对我的企图",shape=box,color=blue];
		j2127310494 -> j811300696;
	j2499168753 [label="Boolean FlarePainUnique is now true.",color=orange];
		j2499168753 -> j3335724203;
	j164465951 [label="我觉得这是一个我们永远都在挣扎的课题",shape=box,color=blue];
		j164465951 -> j1206272442;
	j3736621303 [label="Boolean FlarePainChronic is now true.",color=orange];
		j3736621303 -> j3335724203;
	j811300696 [label="既然我的……秘密已经暴露了，那可以这么说，我想和你重新开始。你好。我是弗莱尔。我迫切需要你的帮助，来摆脱那个试图摧毁我的东西",shape=box,color=blue];
		j811300696 -> j3465603353;
		j811300696 -> j3043093963;
	j1206272442 [label="Boolean FlarePainStranger is now true.",color=orange];
		j1206272442 -> j3335724203;
	j3465603353 [label="你能告诉我这一切是怎么开始的吗？你最初是怎么遇到丽兹的？",shape=box,color=red];
		j3465603353 -> j1806063891;
	j3043093963 [label="你为什么觉得丽兹想要毁掉你？",shape=box,color=red];
		j3043093963 -> j1777072183;
	j1806063891 [label="就在那个鸟人公开处决我的乐队成员之后",shape=box,color=blue];
		j1806063891 -> j3660574266;
	j1777072183 [label="因为我能听到她，在我心灵的边缘低语，不断地抓挠",shape=box,color=blue];
		j1777072183 -> j3698092234;
	j3660574266 [label="还在每个频道上，称*我们*是人民的敌人。他怎么敢这么做？！？！",shape=box,color=blue];
		j3660574266 -> j2628934149;
	j3698092234 [label="“你是我的，你的全部都是我的，你永远都是我的”",shape=box,color=blue];
		j3698092234 -> j2094743052;
	j2628934149 [label="他怎么敢试图灭我们口？！我不能让他这么做……我当时很绝望。我让愤怒——那股*怒火*驱使我",shape=box,color=blue];
		j2628934149 -> j3417729890;
	j2094743052 [label="“让我们进来”",shape=box,color=blue];
		j2094743052 -> j2964089946;
	j3417729890 [label="我做了我唯一知道的事。也是我一生中唯一会做的事",shape=box,color=blue];
		j3417729890 -> j2888344007;
	j2964089946 [label="“我们可以合二为一，我们可以变得完整”",shape=box,color=blue];
		j2964089946 -> j4028852138;
	j2888344007 [label="我拿起我的吉他，用我的音乐回击他的声音",shape=box,color=blue];
		j2888344007 -> j825620029;
	j4028852138 [label="漂泊者，*你*觉得这听起来像什么？在我听来，就像一个想要吞噬我的恶魔",shape=box,color=blue];
		j4028852138 -> j4254771223;
		j4028852138 -> j686982380;
		j4028852138 -> j2524610292;
	j825620029 [label="那音乐在我体内尖叫，渴望被释放",shape=box,color=blue];
		j825620029 -> j491359839;
	j4254771223 [label="是的，我理解你的感受。我也不认为她……完全是无害的。",shape=box,color=red];
		j4254771223 -> j138431903;
	j686982380 [label="干嘛不直接甩掉她？",shape=box,color=red];
		j686982380 -> j3224960380;
	j2524610292 [label="也许吧？又或者……你其实是在对抗一个共生生物？",shape=box,color=red];
		j2524610292 -> j2244098804;
	j491359839 [label="那是我一生中从未有过的感觉",shape=box,color=blue];
		j491359839 -> j70404981;
	j138431903 [label="+5 Chemistry",color=orange];
		j138431903 -> j2070004090;
	j3224960380 [label="哦，我谢谢你，没有你纯粹无比的天才智慧我可怎么办呢？！？！",shape=box,color=blue];
		j3224960380 -> j2749511453;
	j2244098804 [label="共生？和一个说想要“合而为一”并且——并且要吞噬我的东西谈和解？！？！",shape=box,color=blue];
		j2244098804 -> j2911100289;
	j70404981 [label="我走上舞台，释放出失去朋友所带来的所有痛苦、所有愤怒、所有悲痛。我疯狂弹奏直到手指流血……",shape=box,color=blue];
		j70404981 -> j996746250;
	j2070004090 [label="*谢谢你。*拜托了，我们得找个办法永远摆脱她",shape=box,color=blue];
		j2070004090 -> j1922905062;
	j2749511453 [label="你当我傻的吗？！？！",shape=box,color=blue];
		j2749511453 -> j4224301492;
	j2911100289 [label="你比她还疯！！",shape=box,color=blue];
		j2911100289 -> j4036509153;
	j996746250 [label="看起来​被感染的血液接触任何电器似乎都会有奇怪现象……",shape=box,color=blue];
		j996746250 -> j333817414;
		j996746250 -> j2185105717;
	j1922905062 [label="否则我不知道该怎么继续下去",shape=box,color=blue];
		j1922905062 -> j765276533;
	j4224301492 [label="这是我第一个尝试的办法！！！",shape=box,color=blue];
		j4224301492 -> j1649614093;
