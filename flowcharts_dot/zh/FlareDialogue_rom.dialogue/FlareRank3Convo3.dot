	j1513660552 [label="+5 Chemistry",color=orange];
		j1513660552 -> j3680749422;
	j3287218965 [label="你的建议到底是什么？我们就这么谈谈？！",shape=box,color=blue];
		j3287218965 -> j3826671970;
		j3287218965 -> j266890573;
	j3680749422 [label="我原以为*我的*生活已经够奇怪的……",shape=box,color=blue];
		j3680749422 -> j3287218965;
	j3826671970 [label="我的意思是她就是*你*。所以，如果你们是同一个人，她其实并不想伤害你。也许你并不需要摆脱她。",shape=box,color=red];
		j3826671970 -> j726687831;
	j266890573 [label="我的意思是，或许你不需要摆脱她。可能关键在于与她和解。",shape=box,color=red];
		j266890573 -> j2294215399;
	j726687831 [label="如果你不知道很多音乐人有多厌恶自己，那你真的对音乐人了解不多",shape=box,color=blue];
		j726687831 -> j3154726457;
	j2294215399 [label="如果她是你的一部分，我觉得她就是，那么与她对话——理解她——可能是更好的解决方案。",shape=box,color=red];
		j2294215399 -> j3868652459;
	j3154726457 [label="如果能让我们永远名留青史，不少人会欣然选择壮烈的自我毁灭",shape=box,color=blue];
		j3154726457 -> j466298853;
	j3868652459 [label="如果你错了怎么办？如果她是在利用你，让我打开心门呢？一旦我放下抵抗，就意味着永别了弗莱尔，永远迎来丽兹",shape=box,color=blue];
		j3868652459 -> j350213411;
		j3868652459 -> j3896403315;
	j466298853 [label="作为一个见多识广又历经沧桑的人来说……你有时还真是天真",shape=box,color=blue];
		j466298853 -> j2427268409;
	j350213411 [label="我不知道。我从未见过感染者撒谎。它之前也没有像这样说话。她说她并不想那样。但我无法保证。",shape=box,color=red];
		j350213411 -> j3165090714;
