		j998334771 -> j3100926727;
	j3034525026 [label="她就是一个失败的疯狂科学实验产物。她根本不应该存在。我不认为你已经想尽了一切办法",shape=box,color=blue];
		j3034525026 -> j550120544;
	j3487428767 [label="你是说她既是我心灵的一部分*也是*感染的一部分？",shape=box,color=blue];
		j3487428767 -> j3805752795;
		j3487428767 -> j3711292859;
	j3100926727 [label="创造她的方式和她试图*吞噬我*有什么关系？",shape=box,color=blue];
		j3100926727 -> j497011437;
	j3805752795 [label="挺怪的，我知道。欢迎来到我的生活。 ",shape=box,color=red];
