		j2498795757 -> j1006574041;
	j1723028931 [label="噢……",shape=box,color=red];
		j1723028931 -> j1006574041;
	j1457734155 [label="我知道这一点，我并不傻。但我真的相信她说她并不想伤害你。",shape=box,color=red];
		j1457734155 -> j920389640;
	j935813953 [label="随便吧。弗莱尔，看着。我不知道要怎么去摆脱她，所以我们还是跟她*谈谈*吧。",shape=box,color=red];
		j935813953 -> j692053004;
	j2832952558 [label="如果你说的是真的——虽然我不太相信——那我脑子里到底萦绕着什么样的压抑的情感创伤才形成*那个东西*？",shape=box,color=blue];
		j2832952558 -> j2584239207;
	j1006574041 [label="嗯。从那以后，她就一直缠着我，在夜深人静的时候在我脑海中低语。“让我们进来。我们将合而为一，你是我们的”",shape=box,color=blue];
		j1006574041 -> j998334771;
	j920389640 [label="*你们俩*我谁都不信",shape=box,color=blue];
