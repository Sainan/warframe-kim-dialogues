		1160 -> 1165;
	1161 [label="如果非要我牺牲一只动物，我想莱蒂不会喜欢的……",shape=box,color=red];
		1161 -> 1166;
	1162 [label="我是不是需要……在地上用粉笔画个圈还是什么的？",shape=box,color=red];
