		j1033520841 -> j1237412029;
	j1814678515 [label="冷静点！我只是想让弗莱尔离开。我想谈谈你们之间达成某种和平的谈判。",shape=box,color=red];
		j1814678515 -> j2955946858;
	j1538805630 [label="因为你错了，他希望你离开他的生活。所以，我要想办法杀了你，把你扔进虚空——或者别的什么。我不在乎是什么。",shape=box,color=red];
