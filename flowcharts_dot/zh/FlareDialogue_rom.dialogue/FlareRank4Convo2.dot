	1174 [label="为什么",shape=box,color=blue];
		1174 -> 1180;
	1175 [label="弗莱尔担心一旦他让你进入，你就会吞噬他的意识。他将不再是“他”了。",shape=box,color=red];
		1175 -> 1181;
	1176 [label="如果你如愿以偿，你能具体描述一下你将如何改变他吗？我是说，用……正常的、非宇宙恐怖的术语。",shape=box,color=red];
		1176 -> 1182;
	1177 [label="……能出什么问题呢……",shape=box,color=red];
		1177 -> 1183;
	1178 [label="我知道你之前嘲笑过这个想法，但我有*非常*独特的杀人方法。",shape=box,color=red];
		1178 -> 1183;
	1179 [label="我考虑过你把她困在双衍王境的想法……我觉得你是对的。我觉得这能行。",shape=box,color=red];
		1179 -> 1184;
	1180 [label="既然你想把我们赶走，我们为什么要听你的话呢？！",shape=box,color=blue];
		1180 -> 1185;
		1180 -> 1186;
	1181 [label="他做他自己有什么特别之处？",shape=box,color=blue];
		1181 -> 1187;
	1182 [label="Update boolean FlareNonCosmic",color=orange];
		1182 -> 1188;
	1183 [label="我愿意付出",shape=box,color=blue];
		1183 -> 1189;
	1184 [label="把她关进 Kullervo 的牢房。她还可以跟他做个伴。",shape=box,color=red];
		1184 -> 1183;
	1185 [label="冷静点！我只是想让弗莱尔离开。我想谈谈你们之间达成某种和平的谈判。",shape=box,color=red];
		1185 -> 1190;
	1186 [label="因为你错了，他希望你离开他的生活。所以，我要想办法杀了你，把你扔进虚空——或者别的什么。我不在乎是什么。",shape=box,color=red];
		1186 -> 1191;
	1187 [label="他是一个空壳，没有我们他只是一个瓷娃娃",shape=box,color=blue];
		1187 -> 1192;
	1188 [label="我们会尽力的……;)",shape=box,color=blue];
		1188 -> 1187;
	1189 [label="  ",shape=box,color=blue];
		1189 -> 1193;
	1190 [label="嗯……方法很可疑，不过我们正在听……继续说",shape=box,color=blue];
		1190 -> 1176;
		1190 -> 1175;
	1191 [label="我非常、*非常*擅长杀死那些不可杀之物。相信我。",shape=box,color=red];
		1191 -> 1194;
	1192 [label="我们试图用歌声、用伟大、用他一生所追寻的东西来充实他",shape=box,color=blue];
		1192 -> 1195;
	1193 [label="  ",shape=box,color=blue];
		1193 -> 1196;
	1194 [label="@#!$%#^$#&%$^#@$ @#$@#$%$#^!@#$#@%$##^$%#$!!@#!@$#%%#@%$^%@$@$!@#$!@$@!#",shape=box,color=blue];
		1194 -> 1197;
	1195 [label="他在追星星，而我们吞噬它们",shape=box,color=blue];
		1195 -> 1198;
