		1222 -> 1225;
	1223 [label="但是……这难道不公平吗……？",shape=box,color=blue];
		1223 -> 1226;
		1223 -> 1227;
	1224 [label="是的！就是那样。她真可爱。我们爱她，非常非常爱……",shape=box,color=blue];
		1224 -> 1228;
	1225 [label="跑……跑……跑……",shape=box,color=blue];
		1225 -> 1229;
	1226 [label="我认为弗莱尔永远不会放弃自己的个人身份，丽兹。但我也看不出试图杀死或摧毁你有什么价值。",shape=box,color=red];
		1226 -> 1230;
	1227 [label="你必须尝试从弗莱尔的角度看待问题。他很害怕。他失去了一切。现在他害怕失去仅存的——他自己。",shape=box,color=red];
		1227 -> 1230;
	1228 [label="为什么我们生来不属于她……",shape=box,color=blue];
		1228 -> 1231;
	1229 [label="我们……永远存在……如果没有我们，TENNO，你会怎么样……？",shape=box,color=blue];
		1229 -> 1232;
	1230 [label="但我们是他的朋友，不是他的敌人……",shape=box,color=blue];
		1230 -> 1233;
		1230 -> 1234;
	1231 [label="那样她就会接受我们的……",shape=box,color=blue];
		1231 -> 1235;
		1231 -> 1236;
	1232 [label="杀了我们吧，因为是你养育了我们，恶魔……",shape=box,color=blue];
		1232 -> 1237;
	1233 [label="那就别再提什么“吞噬他的意识”了。 ",shape=box,color=red];
		1233 -> 1238;
	1234 [label="你一直做得不好，没能让他明白这一点。",shape=box,color=red];
		1234 -> 1238;
	1235 [label="对你来说是“分享”，在我们看来是“破坏”。你得试着去理解。我知道要“低调”很难，但还是要努力尝试。还记得埃莉诺的经历吗？还有莱蒂？",shape=box,color=red];
		1235 -> 1239;
	1236 [label="你必须尝试从弗莱尔的角度看待问题。他很害怕。他失去了一切。现在他害怕失去仅存的——他自己。",shape=box,color=red];
		1236 -> 1240;
	1237 [label="哦……在你离开之前……？",shape=box,color=blue];
		1237 -> 1241;
	1238 [label="我们会……考虑……",shape=box,color=blue];
