digraph {
	1154 [label="FlareRank4Convo2 begins.",color=orange];
		1154 -> 1155;
		1154 -> 1156;
	1155 [label="我一直在想你的问题，我想我有个办法可以永远摆脱丽兹。",shape=box,color=red];
		1155 -> 1157;
