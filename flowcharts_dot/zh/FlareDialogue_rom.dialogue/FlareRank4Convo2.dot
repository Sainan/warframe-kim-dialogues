		1168 -> 1171 [label=true,color=green];
		1168 -> 1172 [label=true,color=green];
		1168 -> 1173 [label=false,color=brown];
	1169 [label="但你却说要把我们从世界上除掉",shape=box,color=blue];
		1169 -> 1174;
	1170 [label="你需要我们做什么，甜甜的人？",shape=box,color=blue];
		1170 -> 1175;
		1170 -> 1176;
	1171 [label="我想我们应该把她带到虚空去。让虚空无情之物来对付她。",shape=box,color=red];
		1171 -> 1177;
	1172 [label="我想我们一定能找到杀死丽兹的办法。我之前已经杀过上千个 Infested 了。再多一个应该不难。",shape=box,color=red];
		1172 -> 1178;
