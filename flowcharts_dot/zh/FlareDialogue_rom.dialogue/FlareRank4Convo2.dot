		1201 -> 1205 [label=true,color=green];
		1201 -> 1203 [label=false,color=brown];
		1201 -> 1204 [label=false,color=brown];
	1202 [label="你以为……事情真的会……那么简单吗……？",shape=box,color=blue];
		1202 -> 1206;
	1203 [label="我开始明白为什么弗莱尔认为你会吃掉他了，丽兹。",shape=box,color=red];
		1203 -> 1207;
	1205 [label="这就是你对“非宇宙恐怖”的理解吗？",shape=box,color=red];
		1205 -> 1209;
	1204 [label="那么……你*的确*打算吞噬他的意识？",shape=box,color=red];
		1204 -> 1208;
	1206 [label="嗯嗯嗯呵呵呵呵……",shape=box,color=blue];
		1206 -> 1210;
	1207 [label=":(",shape=box,color=blue];
		1207 -> 1211;
	1209 [label="……对不起",shape=box,color=blue];
		1209 -> 1212;
	1208 [label="是……的？",shape=box,color=blue];
		1208 -> 1211;
	1210 [label="我们打算告诉你一个……小秘密……",shape=box,color=blue];
		1210 -> 1213;
	1211 [label="我们。打算。分享？他的？心灵？",shape=box,color=blue];
		1211 -> 1214;
	1212 [label="我们再试试。咳咳。",shape=box,color=blue];
		1212 -> 1211;
	1213 [label="我们并不是……第一个丽兹……",shape=box,color=blue];
		1213 -> 1215;
	1214 [label="这样。更好吗？",shape=box,color=blue];
