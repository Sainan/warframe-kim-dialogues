		j3548928297 -> j479616889;
	j1620634355 [label="我现在感觉就像是一块砸穿了别人温室的天花板的砖头",shape=box,color=blue];
		j1620634355 -> j4165087765;
		j1620634355 -> j9478798;
	j3919430003 [label="他们真是可爱的怪胎",shape=box,color=blue];
		j3919430003 -> j2513776154;
	j2141111217 [label="说风波都算轻描淡写了，哈。",shape=box,color=blue];
		j2141111217 -> j2990835297;
	j3663674207 [label="所以就只是……“啦啦啦啥也没发生？”",shape=box,color=red];
		j3663674207 -> j2445610168;
	j479616889 [label="你真的想装作什么都不知道吗？",shape=box,color=red];
		j479616889 -> j1977794729;
	j4165087765 [label="……是不是很痛苦？",shape=box,color=red];
		j4165087765 -> j905937328;
	j9478798 [label="哈哈。那是什么意思？",shape=box,color=red];
		j9478798 -> j3607816950;
	j2513776154 [label="我可以坐下来一连几天看着他们。这很好，因为我没有别事可做。哈哈",shape=box,color=blue];
