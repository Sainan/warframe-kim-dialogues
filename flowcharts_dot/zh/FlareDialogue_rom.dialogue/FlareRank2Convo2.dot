	j2990835297 [label="Boolean FlareBackstory1 is now true.",color=orange];
		j2990835297 -> j426545236;
	j2445610168 [label="我还应该做什么？",shape=box,color=blue];
		j2445610168 -> j1927630127;
	j1977794729 [label="我*不想*这样，但我不知道还能怎么做，旅行者。 ",shape=box,color=blue];
		j1977794729 -> j1927630127;
	j905937328 [label="+5 Chemistry",color=orange];
		j905937328 -> j1172796473;
	j3607816950 [label="我出现得太突然，把别人的事搞得一团糟，不是吗？",shape=box,color=blue];
		j3607816950 -> j3491094541;
		j3607816950 -> j1910210061;
	j1402480149 [label="我忍不住想把他们写进我的音乐中",shape=box,color=blue];
		j1402480149 -> j2165117716;
	j426545236 [label="有一天，我接到了一个奇怪的电话，某个狡猾的鸟人打来的。他装作一副了不起的样子，振振有词，好像非得证明点什么",shape=box,color=blue];
		j426545236 -> j964519318;
	j1927630127 [label="好像它就在房间的角落里，一直盯着我看",shape=box,color=blue];
		j1927630127 -> j2917968660;
	j1172796473 [label="哈，抱歉。不，我的意思是——我感觉我像是一场派对的不速之客",shape=box,color=blue];
		j1172796473 -> j3607816950;
	j3491094541 [label="看看周围。在你到来之前，霍瓦尼亚就已经一团糟了。",shape=box,color=red];
		j3491094541 -> j1788214939;
	j1910210061 [label="那块砖头又不是自找的，对吗？",shape=box,color=red];
		j1910210061 -> j1549928789;
	j2165117716 [label="我在想我能不能教他们玩乐器……",shape=box,color=blue];
		j2165117716 -> j619938223;
	j964519318 [label="他告诉我们他有多么重要，这座城市是如何正在“堕落”和“失去信仰”的，以及我们该怎么“帮助他完成他的崇高事业，让一切回到正轨”",shape=box,color=blue];
		j964519318 -> j236556593;
	j2917968660 [label="没有眼睛，但一直在注视着，没有眼睑，空洞，*饥渴着*",shape=box,color=blue];
		j2917968660 -> j2161561572;
	j1788214939 [label="嗯，我想是的。已经残破的东西很难再被破坏了",shape=box,color=blue];
		j1788214939 -> j608609611;
	j1549928789 [label="对，但它确实把自己变成了一个看起来非常有用的钝器，对吧？",shape=box,color=blue];
		j1549928789 -> j1373354305;
	j619938223 [label="Check boolean QuincyArthur2",color=orange];
		j619938223 -> j1657731190 [label=true,color=green];
		j619938223 -> j366426054 [label=true,color=green];
		j619938223 -> j3336084893 [label=true,color=green];
		j619938223 -> j366426054 [label=false,color=brown];
		j619938223 -> j1244967597 [label=false,color=brown];
		j619938223 -> j3336084893 [label=false,color=brown];
	j236556593 [label="他还真以为自己知道在和谁说话呢。最好笑的是？他还自称是我的*粉丝*",shape=box,color=blue];
		j236556593 -> j117279965;
	j2161561572 [label="等着我眨眼，等着我张望，等着我瞥一眼，等着我放松警惕，然后它就会袭击 ",shape=box,color=blue];
		j2161561572 -> j739786304;
	j608609611 [label="尽管如此，我还是忍不住觉得自己在使事情变得更糟，而不是更好",shape=box,color=blue];
		j608609611 -> j2467498304;
	j1373354305 [label="但我明白你的意思",shape=box,color=blue];
		j1373354305 -> j2100819267;
	j1657731190 [label="我有充分证据证明亚瑟会唱歌。",shape=box,color=red];
		j1657731190 -> j441399333;
	j366426054 [label="我知道碧会*立刻*加入你。",shape=box,color=red];
		j366426054 -> j2120333676;
	j3336084893 [label="我的虚空老天爷啊。我在想象他们组成一个乐队的样子。我觉得我快要笑死了。",shape=box,color=red];
		j3336084893 -> j2120333676;
	j1244967597 [label="我......祝你在这事上一切顺利。",shape=box,color=red];
		j1244967597 -> j2852247361;
	j117279965 [label="这个世界上最糟糕的事情，莫过于看着某些蠢货为了自己的目的而歪曲你的话了",shape=box,color=blue];
		j117279965 -> j869203608;
	j739786304 [label="就像鲨鱼在嗅觅水中的血液……",shape=box,color=blue];
		j739786304 -> j3786456927;
		j739786304 -> j2467680460;
	j2467498304 [label="这一切都是因为我被英择谛利用了。我想要力量，为了告诉那个鸟人他无法扼杀音乐",shape=box,color=blue];
		j2467498304 -> j1083356343;
	j2100819267 [label="我被利用了，但我也让自己被利用了，我很生气，我想让那个鸟人知道音乐不会消亡",shape=box,color=blue];
		j2100819267 -> j1083356343;
	j441399333 [label="他不像是伴唱歌手的料，但谁知道呢",shape=box,color=blue];
		j441399333 -> j2852247361;
	j2120333676 [label="多可爱的画面啊",shape=box,color=blue];
		j2120333676 -> j2852247361;
	j2852247361 [label="但这都是痴人说梦……",shape=box,color=blue];
		j2852247361 -> j2550367952;
	j869203608 [label="所以，我们当然答应了。主要就是为了惹怒那个鸟人，让他知道多大屌办多大事",shape=box,color=blue];
		j869203608 -> j3060185841;
	j3786456927 [label="哇哦，冷静一下。你在说什么？",shape=box,color=red];
		j3786456927 -> j4001494687;
	j2467680460 [label="好吧，弗莱尔。你吓到我了。",shape=box,color=red];
		j2467680460 -> j2530098685;
	j1083356343 [label="但是……我……已经适应了，回答你的问题 ",shape=box,color=blue];
		j1083356343 -> j2284816572;
	j2550367952 [label="我现在是二重唱……如果她如愿以偿的话，很快就是独唱了……",shape=box,color=blue];
		j2550367952 -> j3375163881;
		j2550367952 -> j2467680460;
	j3060185841 [label="早知道就该相信那些关于奇怪疫情的小道消息了",shape=box,color=blue];
		j3060185841 -> j1346374605;
	j4001494687 [label="我很抱歉……",shape=box,color=blue];
		j4001494687 -> j46883408;
	j2530098685 [label="吓到的不只是你",shape=box,color=blue];
		j2530098685 -> j4001494687;
	j2284816572 [label="即使我这辈子再也吃不到披萨了，我也会幸福地死去",shape=box,color=blue];
		j2284816572 -> j2126918467;
	j3375163881 [label="难道你要我无视这些话？",shape=box,color=red];
		j3375163881 -> j4001494687;
	j1346374605 [label="真他妈见鬼",shape=box,color=blue];
		j1346374605 -> j526183506;
		j1346374605 -> j1526020821;
	j46883408 [label="我控制不住",shape=box,color=blue];
		j46883408 -> j1460803828;
	j2126918467 [label="这些怪物难道没听说过*三明治*吗？！？！",shape=box,color=blue];
		j2126918467 -> j1908008806;
	j526183506 [label="靠。",shape=box,color=red];
		j526183506 -> j830420749;
	j1526020821 [label="你感染了科腐者？",shape=box,color=red];
		j1526020821 -> j830420749;
	j1460803828 [label="事情是怎么发生的呢，当她—— ",shape=box,color=blue];
		j1460803828 -> j1953551354;
	j1908008806 [label="*除此之外*，她还一直*缠着*我，要我不断地喂她吃这些奇怪的东西，比如——",shape=box,color=blue];
		j1908008806 -> j77157526;
	j830420749 [label="推荐指数 0 分。再也不想来。当时我在巡演巴士上躺着，突然有人敲门",shape=box,color=blue];
		j830420749 -> j3096670621;
		j830420749 -> j3632325020;
	j1953551354 [label="这是类似于……多重人格吗？ ",shape=box,color=red];
		j1953551354 -> j748588778;
	j77157526 [label="该死。",shape=box,color=blue];
		j77157526 -> j3375163881;
		j77157526 -> j2467680460;
	j3096670621 [label="英择谛？",shape=box,color=red];
		j3096670621 -> j2146800836;
	j3632325020 [label="让我猜猜。",shape=box,color=red];
		j3632325020 -> j1242773343;
	j748588778 [label="要是真这么简单就好了",shape=box,color=blue];
		j748588778 -> j1468000381;
	j2146800836 [label="叮叮叮。",shape=box,color=blue];
		j2146800836 -> j1242773343;
	j1242773343 [label="噗，你也知道故事会怎么发展了。神奇的奇迹疗法？还说什么会让我成为世界上前所未有的艺人？",shape=box,color=blue];
		j1242773343 -> j1755701227;
	j1468000381 [label="不，太空旅行者……那是丽兹……",shape=box,color=blue];
		j1468000381 -> j2256732405;
	j1755701227 [label="诸如此类等等、等等。",shape=box,color=blue];
		j1755701227 -> j1235584625;
	j2256732405 [label="她是我的吉他……",shape=box,color=blue];
		j2256732405 -> j128887103;
	j1235584625 [label="那个鸟人想要一场演唱会？好吧，他如愿以偿了。我的舞台形象一直有点……过于",shape=box,color=blue];
		j1235584625 -> j616303543;
	j128887103 [label="并且……她想吞噬我残存的灵魂……",shape=box,color=blue];
		j128887103 -> "Chat ends. Next chat will be FlareRank2Convo3.";
	j616303543 [label="我总会把音量开到最大 ",shape=box,color=blue];
		j616303543 -> j3421653829;
	"Chat ends. Next chat will be FlareRank2Convo3." [color=orange];
	j3421653829 [label="但现在？*现在？*我感觉自己飘得比云朵还高，靠着某种我甚至不知道其*存在的*汁液运行着",shape=box,color=blue];
		j3421653829 -> j10512086;
		j3421653829 -> j2253652983;
	j10512086 [label="然后呢？",shape=box,color=red];
		j10512086 -> j3341389905;
	j2253652983 [label="虚空可是猛药。",shape=box,color=red];
		j2253652983 -> j3797283744;
	j3341389905 [label="站在那个舞台上，我感觉自己焕然一新……或者说是重生了。真正的重生。我感觉自己比以往任何时候都更贴近本我。真是太奇妙了。自由自在。我感觉自己在飞翔",shape=box,color=blue];
		j3341389905 -> j3592206248;
	j3797283744 [label="什么？",shape=box,color=blue];
		j3797283744 -> j625192878;
	j3592206248 [label="我们为霍瓦尼亚举办了一场他们永远不会忘记的音乐会。那个鸟人想让我们给他们希望？和信念？我们做到了。直入人心",shape=box,color=blue];
		j3592206248 -> j2155380;
	j625192878 [label="别管了，继续吧。 ",shape=box,color=red];
		j625192878 -> j3341389905;
	j2155380 [label="然后他们就掀翻了炽蛇军的卡车，推倒雕像，哈哈哈",shape=box,color=blue];
		j2155380 -> j4054432402;
	j4054432402 [label="那个鸟人气坏了……",shape=box,color=blue];
		j4054432402 -> j3716176734;
	j3716176734 [label="早应该知道这会让我们付出代价的……",shape=box,color=blue];
		j3716176734 -> j1719138346;
	j1719138346 [label="会让他们……",shape=box,color=blue];
		j1719138346 -> j3151473731;
		j1719138346 -> j3842393523;
	j3151473731 [label="我听说了。",shape=box,color=red];
		j3151473731 -> j1882847833;
	j3842393523 [label="发生了什么……？",shape=box,color=red];
		j3842393523 -> j1453726807;
	j1882847833 [label="是的。",shape=box,color=blue];
		j1882847833 -> j3909238325;
	j1453726807 [label="那个鸟人决定无论如何都要举办属于他自己的演出。只是这一次？不再是演唱会",shape=box,color=blue];
		j1453726807 -> j1363778842;
	j3909238325 [label="我根本无力阻止他们。他们人数太多了。对付我一个人？我倒是看过你干掉他们时，就像切水果一样轻松……",shape=box,color=blue];
		j3909238325 -> j390779790;
	j1363778842 [label="而是那种你只能表演一次的演出……",shape=box,color=blue];
		j1363778842 -> j3909238325;
	j390779790 [label="而我就像刚出生的小长颈鹿学走路一样瘫在这里",shape=box,color=blue];
		j390779790 -> j195522419;
	j195522419 [label="除了看着他们一个个死去之外什么也做不了……",shape=box,color=blue];
		j195522419 -> j1089761900;
	j1089761900 [label="鸟人还通过国家电视台现场直播……",shape=box,color=blue];
		j1089761900 -> j3525863943;
	j3525863943 [label="对收视率得意洋洋，好像这是什么值得骄傲的事……",shape=box,color=blue];
		j3525863943 -> j1031730213;
	j1031730213 [label="我想她这么做完全有道理……",shape=box,color=blue];
		j1031730213 -> j536083324;
	j536083324 [label="以所有的仇恨、悲伤和愤怒为食",shape=box,color=blue];
		j536083324 -> j760915301;
	j760915301 [label="就像鲨鱼，在嗅觅水中的血液",shape=box,color=blue];
		j760915301 -> j4116028579;
	j4116028579 [label="我才知道她已经向你“介绍”过自己了。",shape=box,color=blue];
		j4116028579 -> j2137078357;
	j2137078357 [label="这是怎么发生的，或者她是何时……出现的",shape=box,color=blue];
