	j3347150937 [label="谢谢你，甜甜。这个恶魔还真会甜言蜜语",shape=box,color=blue];
		j3347150937 -> "Chat ends.";
	j3948338804 [label="但我想现在我的家就是一间酒吧，所以……想怎么喝就怎么喝吧。",shape=box,color=blue];
