	j4005448098 [label="那么……丽兹，你到底*多大了*？",shape=box,color=red];
		j4005448098 -> j3839149084;
	j2825752917 [label="生日快乐，你这个让人做噩梦，又奇怪又可怕的感染乐器。",shape=box,color=red];
		j2825752917 -> j2526940491;
	j1194307136 [label="一般来说？喝得烂醉，和朋友出去疯。",shape=box,color=blue];
		j1194307136 -> j4287007434;
	j36601844 [label="会，而且非常难听。所以，如果你想让大家唱这首歌，我确实知道你睡在哪里，而且我的喇叭劲可大了。",shape=box,color=blue];
		j36601844 -> "Chat ends.";
	j3839149084 [label="礼貌，恶魔。讲点礼貌。",shape=box,color=blue];
