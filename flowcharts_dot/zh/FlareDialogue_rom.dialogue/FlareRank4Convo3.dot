digraph {
	"FlareRank4Convo3 begins." [color=orange];
		"FlareRank4Convo3 begins." -> j241001313;
	j241001313 [label="我不知道这破事为什么让我这么害怕",shape=box,color=blue];
		j241001313 -> j2544877309;
	j2544877309 [label="我早就习惯了这种无稽之谈，只是……没有这么夸张而已",shape=box,color=blue];
		j2544877309 -> j1029030981;
		j2544877309 -> j4236756924;
	j1029030981 [label="你这话是什么意思？",shape=box,color=red];
		j1029030981 -> j4208572140;
	j4236756924 [label="嘿，弗莱尔。",shape=box,color=red];
		j4236756924 -> j2668805371;
	j4208572140 [label="抱歉，我有点忧郁。今天早上醒来，我感到一种自己很久没有的感觉",shape=box,color=blue];
		j4208572140 -> j2200406084;
	j2668805371 [label="嘿。",shape=box,color=blue];
		j2668805371 -> j4208572140;
	j2200406084 [label="我不知道这是不是因为乐队成员去世的悲痛，还是……关于*她的*这件事，或者别的什么……",shape=box,color=blue];
		j2200406084 -> j324177621;
	j324177621 [label="Check boolean FlareLizzieEnemy",color=orange];
		j324177621 -> j3754353282 [label=true,color=green];
		j324177621 -> j1262937011 [label=false,color=brown];
		j324177621 -> j2298920998 [label=false,color=brown];
		j324177621 -> j174008868 [label=false,color=brown];
	j3754353282 [label="关于丽兹……我想我可能真的惹毛她了。: |",shape=box,color=red];
		j3754353282 -> j4021133105;
	j1262937011 [label="嗯，我们都经历了许多事情，你并不孤单。",shape=box,color=red];
		j1262937011 -> j396150199;
	j2298920998 [label="我觉得你现在有些崩溃也很正常。",shape=box,color=red];
		j2298920998 -> j268848402;
	j174008868 [label="如果你想聊聊，我很乐意倾听。",shape=box,color=red];
		j174008868 -> j896522631;
	j4021133105 [label="相信我……我知道",shape=box,color=blue];
		j4021133105 -> j2238915660;
	j396150199 [label="+5 Chemistry",color=orange];
		j396150199 -> j2394869449;
	j268848402 [label="我想是的。但谁不是呢？",shape=box,color=blue];
		j268848402 -> j3203580666;
	j896522631 [label="+5 Chemistry",color=orange];
		j896522631 -> j2590225305;
	j2238915660 [label="从那以后她就一直对我大吼大叫",shape=box,color=blue];
		j2238915660 -> j297132164;
	j2394869449 [label="呵。我们真是乌合之众啊……",shape=box,color=blue];
		j2394869449 -> j3219833448;
	j3203580666 [label="虽然我想大多数人都不会与一个整天都在对他们咆哮的吞噬灵魂的恐怖感染生物作斗争",shape=box,color=blue];
		j3203580666 -> j297132164;
	j2590225305 [label="谢谢",shape=box,color=blue];
		j2590225305 -> j297132164;
	j297132164 [label="今天醒来时，我感到一种……恐惧，这是我自从小时候就再未有过的",shape=box,color=blue];
		j297132164 -> j1421544073;
	j3219833448 [label="现在想想，这倒是个不错的乐队名",shape=box,color=blue];
		j3219833448 -> j1914402862;
	j1421544073 [label="不是她带来的那种“哦，太好了，我今天要死了”的恐惧",shape=box,color=blue];
		j1421544073 -> j2958271135;
	j1914402862 [label="扯远了",shape=box,color=blue];
		j1914402862 -> j297132164;
	j2958271135 [label="也不是那种你每天都要面对的乱七八糟的事情。所以抱怨起来就显得有点老套了的情况",shape=box,color=blue];
		j2958271135 -> j286710211;
	j286710211 [label="但是……我甚至不知道你是否能理解……",shape=box,color=blue];
		j286710211 -> j3850420900;
	j3850420900 [label="但有时我醒来，却不知道世界期待我成为什么样的人了……",shape=box,color=blue];
		j3850420900 -> j1734936858;
	j1734936858 [label="无论我是什么人，都不够好。无论我是什么人，都无法满足要求",shape=box,color=blue];
		j1734936858 -> j2735248821;
	j2735248821 [label="我人生中的每一天，无论走到哪里，都不断被灌输关于我*应该*是什么样的人的形象和标准",shape=box,color=blue];
		j2735248821 -> j1072006100;
	j1072006100 [label="前几天我看见一个健身迷在街上走",shape=box,color=blue];
		j1072006100 -> j2306413232;
	j2306413232 [label="穿着无可挑剔的衣服和紧身马甲的绝对完美典范。你可以在那屁股把一枚金币弹开，然后拿回两枚银币和一枚铜币",shape=box,color=blue];
		j2306413232 -> j4008738841;
	j4008738841 [label="他身上每一寸都散发着高贵、地位、自信和财富的气息。他戴的手表可能比我一年赚的钱还多",shape=box,color=blue];
		j4008738841 -> j3250936261;
	j3250936261 [label="天呐我非常想要他。非常想成为他……",shape=box,color=blue];
		j3250936261 -> j3707725797;
	j3707725797 [label="我就是这个意思",shape=box,color=blue];
		j3707725797 -> j1166610807;
	j1166610807 [label="“看起来像这样”“行为像这样”“感觉像这样”“成为这样”，否则你就是一文不值",shape=box,color=blue];
		j1166610807 -> j3599552937;
	j3599552937 [label="试图成为人们想要的样子感觉非常不对。不过即使感觉对呢？那也是毫无意义的……我知道我会失败……但不去尝试呢？……天啊，孤独就像沉重的负担，有时让人难以从床上爬起来",shape=box,color=blue];
		j3599552937 -> j2712293838;
	j2712293838 [label="对不起……",shape=box,color=blue];
		j2712293838 -> j1939847842;
	j1939847842 [label="这对你来说可能都是无稽之谈",shape=box,color=blue];
		j1939847842 -> j1903756072;
	j1903756072 [label="我是说，看看我们——看看*我*，亲爱的——我们简直是天壤之别……",shape=box,color=blue];
		j1903756072 -> j2381660996;
		j1903756072 -> j3971955498;
		j1903756072 -> j2775086324;
		j1903756072 -> j1676444609;
	j2381660996 [label="其实并不是。",shape=box,color=red];
		j2381660996 -> j406152862;
	j3971955498 [label="我能理解，但并不完全感同身受……",shape=box,color=red];
		j3971955498 -> j2556536284;
	j2775086324 [label="我认为……出于各种原因，我们每个人在生活中都曾有过这种感受，只是程度不同而已。",shape=box,color=red];
		j2775086324 -> j3970382402;
	j1676444609 [label="不，我觉得这完全说得通。相信我。",shape=box,color=red];
		j1676444609 -> j3970382402;
	j406152862 [label="是吧",shape=box,color=blue];
		j406152862 -> j1411247290;
	j2556536284 [label="没事的。为你高兴，真的",shape=box,color=blue];
		j2556536284 -> j940260128;
