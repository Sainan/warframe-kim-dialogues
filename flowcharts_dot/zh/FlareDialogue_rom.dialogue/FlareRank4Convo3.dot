		j213567793 -> j4248653133 [label=false,color=brown];
	j365778533 [label="这想法很贴心，但……家庭与*自我归属感*并不相同",shape=box,color=blue];
		j365778533 -> j2213369941;
	j2161393612 [label="让你成为宇宙整体的一部分。",shape=box,color=red];
		j2161393612 -> j3132287761;
	j487571 [label="你身处人潮涌动的商场，周围都是人。没有理由感到孤独。你可以交朋友。",shape=box,color=red];
