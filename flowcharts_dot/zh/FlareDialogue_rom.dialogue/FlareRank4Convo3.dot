		j1413372858 -> j1152533803;
	j2172093440 [label="成为宇宙的一部分？",shape=box,color=blue];
		j2172093440 -> j2991197501;
	j260492291 [label="呵好呀……",shape=box,color=blue];
		j260492291 -> j3968996345;
	j3058413767 [label="我喜欢这个笑话，很好玩。",shape=box,color=red];
		j3058413767 -> j573683320;
	j1152533803 [label="抱歉，抱歉，糟糕的笑话。亚瑟一直警告我不要在错误的时间搞黑色幽默。",shape=box,color=red];
		j1152533803 -> j2175309750;
	j2991197501 [label="我以前一直以为，所有音乐家都想在成名之际死去，这样他们就不会有机会耗尽精力",shape=box,color=blue];
		j2991197501 -> j1781624431;
	j573683320 [label="好吧",shape=box,color=blue];
		j573683320 -> j3968996345;
	j2175309750 [label="几个世纪的孤独与被处决经历，让我变得像碧所说的\"刻薄阀门\"完全失灵——毕竟那曾是我唯一的抗争武器。",shape=box,color=red];
		j2175309750 -> j4006925670;
	j1781624431 [label="我以为这是我的命运，但事实却并非如此。我错了。",shape=box,color=blue];
		j1781624431 -> j3576030286;
	j4006925670 [label="所以我也不知道如何把它关掉——",shape=box,color=red];
		j4006925670 -> j4129937828;
	j3576030286 [label="但是……我想我一直渴望成为更伟大的事业的一部分，我也确实一直觉得自己没有归属。你是说这是她感觉到的吗？",shape=box,color=blue];
		j3576030286 -> j941937930;
		j3576030286 -> j833751224;
	j4129937828 [label="停止打字",shape=box,color=blue];
		j4129937828 -> j4165677466;
	j941937930 [label="我想是的，用最恐怖的方式，没错。",shape=box,color=red];
		j941937930 -> j3649634582;
	j833751224 [label="她就是你的一部分。她能感受到那种痛苦。那种渴望。我想她正在努力去*解决它。*",shape=box,color=red];
		j833751224 -> j3649634582;
	j4165677466 [label="有趣的是，你可能无意间发现了什么……",shape=box,color=blue];
