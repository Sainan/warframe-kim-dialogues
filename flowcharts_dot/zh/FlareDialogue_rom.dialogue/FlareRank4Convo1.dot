digraph {
	"FlareRank4Convo1 begins." [color=orange];
		"FlareRank4Convo1 begins." -> j2965818802;
	j2965818802 [label="我今天一直在想……我现在所处的这种荒谬的处境…...",shape=box,color=blue];
		j2965818802 -> j611030476;
	j611030476 [label="和最好的前行道路",shape=box,color=blue];
		j611030476 -> j2075160653;
	j2075160653 [label="或者说......缺乏这样的道路",shape=box,color=blue];
		j2075160653 -> j2440480461;
	j2440480461 [label="我有一个想法",shape=box,color=blue];
		j2440480461 -> j1953780926;
		j2440480461 -> j1856585765;
	j1953780926 [label="呃哦。",shape=box,color=red];
		j1953780926 -> j1544275501;
	j1856585765 [label="是吗？",shape=box,color=red];
		j1856585765 -> j3232540279;
	j1544275501 [label="不不，听我说",shape=box,color=blue];
		j1544275501 -> j59367854;
	j3232540279 [label="所以",shape=box,color=blue];
		j3232540279 -> j59367854;
	j59367854 [label="丽兹说她来自“任何地方和任何时间”所以......",shape=box,color=blue];
		j59367854 -> j4171909045;
	j4171909045 [label="要求你把她拖到遥远的未来是没有用的，她只会爬回这里",shape=box,color=blue];
		j4171909045 -> j4046095849;
	j4046095849 [label="是吧？",shape=box,color=blue];
		j4046095849 -> j1777170602;
		j4046095849 -> j440139061;
	j1777170602 [label="应该是这样？",shape=box,color=red];
		j1777170602 -> j3667202025;
	j440139061 [label="不知道。",shape=box,color=red];
		j440139061 -> j3792410591;
	j3667202025 [label="很好",shape=box,color=blue];
		j3667202025 -> j1296551845;
	j3792410591 [label="为了方便讨论，我们就假设是这样",shape=box,color=blue];
		j3792410591 -> j1296551845;
	j1296551845 [label="但据我从其他迷人的怪物那里收集到的信息来看……",shape=box,color=blue];
		j1296551845 -> j1368302652;
	j1368302652 [label="有一个地方*没有*感染者",shape=box,color=blue];
		j1368302652 -> j3117081065;
	j3117081065 [label="我们可以把她关在她*没办法*爬回来……的地方",shape=box,color=blue];
		j3117081065 -> j3535605116;
		j3117081065 -> j1622458300;
	j3535605116 [label="我真的，真的不喜欢这个话题的走向，弗莱尔……你在说什么？",shape=box,color=red];
		j3535605116 -> j3839270000;
	j1622458300 [label="如果你是说要把她扔进虚空……我不同意。",shape=box,color=red];
		j1622458300 -> j1973479116;
	j3839270000 [label="我说的不是虚空",shape=box,color=blue];
		j3839270000 -> j3857914008;
	j1973479116 [label="我不知道 Infestation 在虚空中是什么样的存在，而我也不想让情况变得更糟。",shape=box,color=red];
		j1973479116 -> j3839270000;
	j3857914008 [label="我说的是双衍王境",shape=box,color=blue];
		j3857914008 -> j2537381723;
		j3857914008 -> j2802358519;
		j3857914008 -> j3368983109;
	j2537381723 [label="我想那*会*给士魂大帝一个教训……",shape=box,color=red];
		j2537381723 -> j114159222;
	j2802358519 [label="什么？不！绝对不行！",shape=box,color=red];
		j2802358519 -> j114159222;
	j3368983109 [label="我——你是怎么知道双衍王境的？！",shape=box,color=red];
		j3368983109 -> j3433088083;
	j114159222 [label="在那个世界对你做了那些事后，你似乎并不欠它什么人情",shape=box,color=blue];
		j114159222 -> j2031664980;
		j114159222 -> j669540454;
		j114159222 -> j4236484986;
	j3433088083 [label="我能和其他原型战甲“说话”，你知道吧",shape=box,color=blue];
		j3433088083 -> j1776561132;
	j2031664980 [label="你有什么权利告诉我，我应该让它去见鬼？",shape=box,color=red];
		j2031664980 -> j3060204712;
		j2031664980 -> j3225885719;
		j2031664980 -> j411227284;
	j669540454 [label="也许是。也许不是。",shape=box,color=red];
		j669540454 -> j3060204712;
		j669540454 -> j3225885719;
		j669540454 -> j411227284;
	j4236484986 [label="你把情况想得过于简单了。双衍王境过去——和*现在*——都远不止是一个“地方”。",shape=box,color=red];
		j4236484986 -> j3060204712;
		j4236484986 -> j3225885719;
		j4236484986 -> j411227284;
	j1776561132 [label="他们给我讲了你生活的那个奇怪又狂野的小世界",shape=box,color=blue];
		j1776561132 -> j114159222;
	j3060204712 [label="你从没去过那里。你没在那里呆过几个世纪。你也没在那里生活或者死过。",shape=box,color=red];
		j3060204712 -> j2623850922;
		j3060204712 -> j3833244548;
		j3060204712 -> j151764832;
	j3225885719 [label="咱们开门见山吧，弗莱尔？那个地方……既是我的写照，又是它所基于的故事集的原型。",shape=box,color=red];
		j3225885719 -> j2623850922;
		j3225885719 -> j3833244548;
		j3225885719 -> j151764832;
	j411227284 [label="虽然我对它的感觉并不太……美好……但我不能把 Infestation 扔进去然后就走。",shape=box,color=red];
		j411227284 -> j2623850922;
		j411227284 -> j151764832;
		j411227284 -> j3833244548;
	j2623850922 [label="尽管有时候我喜欢回到那里一拳又一拳地打人脸......但那里不是我的垃圾桶。",shape=box,color=red];
		j2623850922 -> j2360366238;
	j3833244548 [label="不管我喜不喜欢......不知怎的，我竟愚蠢地成为了那个地方的负责人。",shape=box,color=red];
		j3833244548 -> j2028912821;
	j151764832 [label="我对此有多少痛苦的回忆，就有多少快乐的回忆。",shape=box,color=red];
		j151764832 -> j3951395619;
	j2360366238 [label="所以它也不是你的垃圾处理场。",shape=box,color=red];
		j2360366238 -> j3424905661;
		j2360366238 -> j2371696801;
		j2360366238 -> j1081701023;
	j2028912821 [label="所以当它有危险的时候，我必须在那儿保护它。",shape=box,color=red];
		j2028912821 -> j1081701023;
		j2028912821 -> j2371696801;
		j2028912821 -> j3424905661;
	j3951395619 [label="虽然我想要摆脱它，但并不意味着我希望那里的一切都遭受痛苦。",shape=box,color=red];
		j3951395619 -> j1081701023;
		j3951395619 -> j3424905661;
		j3951395619 -> j2371696801;
	j3424905661 [label="你这是要我让别人受苦。",shape=box,color=red];
		j3424905661 -> j3838013100;
	j2371696801 [label="想想你到底要让我做些什么，弗莱尔。",shape=box,color=red];
		j2371696801 -> j4088158857;
	j1081701023 [label="你真的想用那样的方式危及另一个世界吗？",shape=box,color=red];
		j1081701023 -> j782952678;
	j3838013100 [label="+5 Chemistry",color=orange];
		j3838013100 -> j4020457909;
	j4088158857 [label="那我希望，我的意思是*希望*你能提出另一种选择",shape=box,color=blue];
		j4088158857 -> j1708684916;
	j782952678 [label="我——但双衍王境并不是 *真的*",shape=box,color=blue];
		j782952678 -> j3711636506;
		j782952678 -> j3003286495;
	j4020457909 [label="我——但他们不是真人——",shape=box,color=blue];
		j4020457909 -> j1893392288;
	j1708684916 [label="因为我觉得你想不出什么",shape=box,color=blue];
		j1708684916 -> j2990166568;
	j3711636506 [label="好吧。好的。你诚心诚意地来谈判，如果她撒谎的话，我会......考虑把她关进双衍王境。",shape=box,color=red];
		j3711636506 -> j2944680472;
	j3003286495 [label="我们是谁，凭什么决定什么是真的，什么不是？",shape=box,color=red];
		j3003286495 -> j3693190124;
	j1893392288 [label="不，不。我已经能听到我脑袋里的那些话了",shape=box,color=blue];
		j1893392288 -> j990597224;
	j2990166568 [label="Boolean FlareWar4 is now true.",color=orange];
		j2990166568 -> j517075388;
	j2944680472 [label="Boolean FlareWar4b is now true.",color=orange];
		j2944680472 -> j106194494;
	j3693190124 [label="我……是呀……有道理。",shape=box,color=blue];
		j3693190124 -> j1089488443;
	j990597224 [label="终究，是什么让一个人变得真实？我们是谁，又能决定什么？",shape=box,color=blue];
		j990597224 -> j2613595826;
	j517075388 [label="+20 Chemistry",color=orange];
		j517075388 -> "Chat ends. Next chat will be FlareRank4Convo2.";
	j106194494 [label="+5 Chemistry",color=orange];
		j106194494 -> j3984830755;
	j1089488443 [label="+5 Chemistry",color=orange];
		j1089488443 -> j2613595826;
	j2613595826 [label="你的虚空无情之物肯定觉得我们不重要。",shape=box,color=blue];
		j2613595826 -> j2398863622;
	"Chat ends. Next chat will be FlareRank4Convo2." [color=orange];
	j3984830755 [label="谢谢你，太空旅行者。感谢你。祝你好运",shape=box,color=blue];
		j3984830755 -> j517075388;
	j2398863622 [label="妈的。*妈的。*他妈的。漂泊者，我只是……我……我没有别的办法，我走投无路了，求你了……我不知道还能*做*什么",shape=box,color=blue];
		j2398863622 -> j3711636506;
		j2398863622 -> j558661457;
	j558661457 [label="让我……试试跟丽兹聊聊这事。",shape=box,color=red];
