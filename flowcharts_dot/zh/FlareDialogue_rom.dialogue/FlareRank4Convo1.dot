		1091 -> 1093;
	1092 [label="所以",shape=box,color=blue];
		1092 -> 1093;
	1093 [label="丽兹说她来自“任何地方和任何时间”所以......",shape=box,color=blue];
		1093 -> 1094;
	1094 [label="要求你把她拖到遥远的未来是没有用的，她只会爬回这里",shape=box,color=blue];
		1094 -> 1095;
	1095 [label="是吧？",shape=box,color=blue];
		1095 -> 1096;
		1095 -> 1097;
	1096 [label="应该是这样？",shape=box,color=red];
		1096 -> 1098;
	1097 [label="不知道。",shape=box,color=red];
		1097 -> 1099;
	1098 [label="很好",shape=box,color=blue];
		1098 -> 1100;
	1099 [label="为了方便讨论，我们就假设是这样",shape=box,color=blue];
		1099 -> 1100;
	1100 [label="但据我从其他迷人的怪物那里收集到的信息来看……",shape=box,color=blue];
		1100 -> 1101;
	1101 [label="有一个地方*没有*感染者",shape=box,color=blue];
		1101 -> 1102;
	1102 [label="我们可以把她关在她*没办法*爬回来……的地方",shape=box,color=blue];
		1102 -> 1103;
		1102 -> 1104;
	1103 [label="我真的，真的不喜欢这个话题的走向，弗莱尔……你在说什么？",shape=box,color=red];
		1103 -> 1105;
	1104 [label="如果你是说要把她扔进虚空……我不同意。",shape=box,color=red];
		1104 -> 1106;
	1105 [label="我说的不是虚空",shape=box,color=blue];
		1105 -> 1107;
	1106 [label="我不知道 Infestation 在虚空中是什么样的存在，而我也不想让情况变得更糟。",shape=box,color=red];
		1106 -> 1105;
	1107 [label="我说的是双衍王境",shape=box,color=blue];
		1107 -> 1108;
		1107 -> 1109;
		1107 -> 1110;
	1108 [label="我想那*会*给士魂大帝一个教训……",shape=box,color=red];
		1108 -> 1111;
	1109 [label="什么？不！绝对不行！",shape=box,color=red];
		1109 -> 1111;
	1110 [label="我——你是怎么知道双衍王境的？！",shape=box,color=red];
		1110 -> 1112;
	1111 [label="在那个世界对你做了那些事后，你似乎并不欠它什么人情",shape=box,color=blue];
		1111 -> 1113;
		1111 -> 1114;
		1111 -> 1115;
	1112 [label="我能和其他原型战甲“说话”，你知道吧",shape=box,color=blue];
		1112 -> 1116;
	1113 [label="你有什么权利告诉我，我应该让它去见鬼？",shape=box,color=red];
		1113 -> 1117;
		1113 -> 1118;
		1113 -> 1119;
	1114 [label="也许是。也许不是。",shape=box,color=red];
		1114 -> 1117;
		1114 -> 1118;
		1114 -> 1119;
	1115 [label="你把情况想得过于简单了。双衍王境过去——和*现在*——都远不止是一个“地方”。",shape=box,color=red];
		1115 -> 1117;
		1115 -> 1118;
		1115 -> 1119;
	1116 [label="他们给我讲了你生活的那个奇怪又狂野的小世界",shape=box,color=blue];
		1116 -> 1111;
	1117 [label="你从没去过那里。你没在那里呆过几个世纪。你也没在那里生活或者死过。",shape=box,color=red];
		1117 -> 1120;
		1117 -> 1121;
		1117 -> 1122;
	1118 [label="咱们开门见山吧，弗莱尔？那个地方……既是我的写照，又是它所基于的故事集的原型。",shape=box,color=red];
		1118 -> 1120;
		1118 -> 1121;
		1118 -> 1122;
	1119 [label="虽然我对它的感觉并不太……美好……但我不能把 Infestation 扔进去然后就走。",shape=box,color=red];
		1119 -> 1120;
		1119 -> 1122;
		1119 -> 1121;
	1120 [label="尽管有时候我喜欢回到那里一拳又一拳地打人脸......但那里不是我的垃圾桶。",shape=box,color=red];
		1120 -> 1123;
	1121 [label="不管我喜不喜欢......不知怎的，我竟愚蠢地成为了那个地方的负责人。",shape=box,color=red];
		1121 -> 1124;
	1122 [label="我对此有多少痛苦的回忆，就有多少快乐的回忆。",shape=box,color=red];
		1122 -> 1125;
	1123 [label="所以它也不是你的垃圾处理场。",shape=box,color=red];
		1123 -> 1126;
		1123 -> 1127;
		1123 -> 1128;
	1124 [label="所以当它有危险的时候，我必须在那儿保护它。",shape=box,color=red];
		1124 -> 1128;
		1124 -> 1127;
		1124 -> 1126;
	1125 [label="虽然我想要摆脱它，但并不意味着我希望那里的一切都遭受痛苦。",shape=box,color=red];
		1125 -> 1128;
		1125 -> 1126;
		1125 -> 1127;
	1126 [label="你这是要我让别人受苦。",shape=box,color=red];
		1126 -> 1129;
	1127 [label="想想你到底要让我做些什么，弗莱尔。",shape=box,color=red];
		1127 -> 1130;
