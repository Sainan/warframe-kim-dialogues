digraph {
	1084 [label="FlareRank4Convo1 begins.",color=orange];
		1084 -> 1085;
	1085 [label="我今天一直在想……我现在所处的这种荒谬的处境…...",shape=box,color=blue];
		1085 -> 1086;
	1086 [label="和最好的前行道路",shape=box,color=blue];
