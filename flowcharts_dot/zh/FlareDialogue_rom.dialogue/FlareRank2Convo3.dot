		j2810413912 -> j395778156;
		j2810413912 -> j294026459;
	j665653395 [label="哦吼，我们喜欢你，你学得真快，是不是……",shape=box,color=blue];
		j665653395 -> j2577833368;
	j3655752460 [label="你是弗莱尔。绝对是弗莱尔。",shape=box,color=red];
		j3655752460 -> j4273742201;
	j2430583425 [label="我好困惑。",shape=box,color=red];
		j2430583425 -> j413893509;
	j395778156 [label="我不知道。",shape=box,color=red];
		j395778156 -> j413893509;
	j294026459 [label="你是丽兹。绝对是丽兹。",shape=box,color=red];
		j294026459 -> j184590001;
	j2577833368 [label="嗯……他情不自禁地张开漂亮的小嘴，向你讲述我们的一切",shape=box,color=blue];
		j2577833368 -> j2906863274;
	j4273742201 [label="这是你更想见到的人吗？",shape=box,color=blue];
		j4273742201 -> j3535087465;
	j413893509 [label="可怜的太空旅行者",shape=box,color=blue];
		j413893509 -> j849261837;
	j184590001 [label="如果我说是呢？",shape=box,color=blue];
		j184590001 -> j3535087465;
	j2906863274 [label="所以，我们认为我们应该过来介绍一下我们自己……适当地",shape=box,color=blue];
		j2906863274 -> j3416334772;
	j3535087465 [label="一个身体。两个灵魂",shape=box,color=blue];
		j3535087465 -> j3926256031;
	j849261837 [label="你有什么不明白的？",shape=box,color=blue];
		j849261837 -> j3535087465;
	j3416334772 [label="你好，丽兹。",shape=box,color=red];
		j3416334772 -> j1226720886;
	j3926256031 [label="尤其对于你来说，这应该不奇怪……",shape=box,color=blue];
		j3926256031 -> j542265439;
		j3926256031 -> j3416334772;
	j1226720886 [label="你好呀……",shape=box,color=blue];
		j1226720886 -> j4153807611;
	j542265439 [label="别了。等弗莱尔回来再跟我聊吧。我撤了。[结束]",shape=box,color=red];
		j542265439 -> j2005699285;
	j4153807611 [label="我们有一个问题要问你",shape=box,color=blue];
		j4153807611 -> j1236026631;
