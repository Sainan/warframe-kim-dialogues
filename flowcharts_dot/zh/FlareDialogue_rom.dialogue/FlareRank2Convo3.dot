		j2005699285 -> j3271057574;
	j1236026631 [label="非常重要的一个问题",shape=box,color=blue];
		j1236026631 -> j2405744056;
	j3271057574 [label="+20 Chemistry",color=orange];
		j3271057574 -> "Chat ends. Next chat will be FlareRank3Convo1.";
	j2405744056 [label="你……",shape=box,color=blue];
		j2405744056 -> j687252655;
	"Chat ends. Next chat will be FlareRank3Convo1." [color=orange];
	j687252655 [label="爱我们吗……？",shape=box,color=blue];
		j687252655 -> j2815786635;
		j687252655 -> j3654541132;
		j687252655 -> j3300477371;
	j2815786635 [label="不爱。感染者只是必要之恶，仅此而已。",shape=box,color=red];
		j2815786635 -> j959652266;
	j3654541132 [label="爱。我战甲中一部分都是感染者。所以……我想是的，我爱你们。",shape=box,color=red];
		j3654541132 -> j4141046172;
	j3300477371 [label="也许吧。感染者是我生命的一部分，但我不知道是否可以信任它。",shape=box,color=red];
		j3300477371 -> j3817422881;
	j959652266 [label="是这样吗……？",shape=box,color=blue];
		j959652266 -> j250497491;
	j4141046172 [label="很好……听到这个我们很高兴，甜甜",shape=box,color=blue];
		j4141046172 -> j1404023694;
	j3817422881 [label="愚蠢的恶魔。你混淆了信任和爱。",shape=box,color=blue];
		j3817422881 -> j2565069811;
	j250497491 [label="Invoke /Lotus/Scripts/1999/HexSyndicateDialog.lua:SetupJumpScare(breakUpFadeTimer=1, breakUpEasterEggChance=0.02, questRankLimit=3)",color=orange];
		j250497491 -> j1788160204;
	j1404023694 [label="我们爱你。我们希望你知道这件事。几个世纪以来，我们一直关注着你，爱着你……",shape=box,color=blue];
		j1404023694 -> j246807743;
		j1404023694 -> j2789507356;
	j2565069811 [label="但我们暂时可以接受这个…… 甜甜，我们以后会再问你的",shape=box,color=blue];
		j2565069811 -> j1404023694;
	j1788160204 [label="Boolean FlareJumpScare is now true.",color=orange];
		j1788160204 -> j3271057574;
	j246807743 [label="怎么说？",shape=box,color=red];
		j246807743 -> j168970621;
	j2789507356 [label="是吗？那些总想置我于死地的科腐者和感染者可不是这么想的。",shape=box,color=red];
		j2789507356 -> j4163670144;
	j168970621 [label="我们为你呼吸。为你牺牲。供养你。这位恶魔满意了吗？",shape=box,color=blue];
		j168970621 -> j2865335211;
		j168970621 -> j4133818957;
	j4163670144 [label="在你生病的时候，你自身的白细胞难道不会攻击你吗？！",shape=box,color=blue];
		j4163670144 -> j166684437;
	j2865335211 [label="我还以为事情无法变得更诡异了呢……",shape=box,color=red];
		j2865335211 -> j2294183153;
	j4133818957 [label="你是 Helminth？！",shape=box,color=red];
		j4133818957 -> j391522291;
	j166684437 [label="我们数量众多。我们永恒不变。我们贯穿始终。我们便是一切。请原谅我们，因为我们未能察觉那些少数的个体。",shape=box,color=blue];
		j166684437 -> j168970621;
	j2294183153 [label="嗯呵呵呵呵……可怜的恶魔……用偷来的手指和感染者的玩物拼凑而成……",shape=box,color=blue];
		j2294183153 -> j732214521;
	j391522291 [label="我们散为万物，合为归一",shape=box,color=blue];
		j391522291 -> j2033439904;
	j732214521 [label="曾经孤寂，孤寂不再",shape=box,color=blue];
		j732214521 -> j3246364277;
	j2033439904 [label="但不要害怕",shape=box,color=blue];
		j2033439904 -> j2946384710;
	j3246364277 [label="我们为你感到高兴",shape=box,color=blue];
		j3246364277 -> j2838517879;
	j2946384710 [label="我们。爱。你。直到永远",shape=box,color=blue];
		j2946384710 -> j2838517879;
	j2838517879 [label="这就是为什么我们在和你商量……不对……我们乞求你……",shape=box,color=blue];
		j2838517879 -> j1201619531;
	j1201619531 [label="这家伙是我们的",shape=box,color=blue];
		j1201619531 -> j2997093041;
	j2997093041 [label="让我们把他带走……",shape=box,color=blue];
		j2997093041 -> j2537749880;
	j2537749880 [label="真的拜托了好吗……？",shape=box,color=blue];
		j2537749880 -> j3844629375;
		j2537749880 -> j445536805;
		j2537749880 -> j1438524920;
	j3844629375 [label="你所说的“带走”他是什么意思？就像疯狂会吞噬其他战甲那样？",shape=box,color=red];
		j3844629375 -> j85160863;
	j445536805 [label="这要他同意才行。",shape=box,color=red];
		j445536805 -> j507787565;
	j1438524920 [label="我……做不到。对不起。我不能让你“带走”弗莱尔。",shape=box,color=red];
		j1438524920 -> j2025706438;
	j85160863 [label="不！！当然不会！！！我们不可能对他做出这样的事。不可能做出像博士那样的事",shape=box,color=blue];
		j85160863 -> j3525883871;
	j507787565 [label="那你必须跟他谈谈。让他相信我们不会伤害他！！",shape=box,color=blue];
		j507787565 -> j759086758;
		j507787565 -> j1094383715;
	j2025706438 [label="不。他是我们的。你不能让他缄默我们！！！",shape=box,color=blue];
		j2025706438 -> j250497491;
	j3525883871 [label="而且我们也不想离开他！！！",shape=box,color=blue];
		j3525883871 -> j4208014215;
	j759086758 [label="你难不成想让他像在你手里的其他战甲那样疯掉吗……",shape=box,color=red];
		j759086758 -> j2411989925;
	j1094383715 [label="我不确定。吃掉他的灵魂听起来似乎相当不妙。",shape=box,color=red];
		j1094383715 -> j1745035513;
	j4208014215 [label="不要让他缄默我们！！",shape=box,color=blue];
		j4208014215 -> j3322455431;
	j2411989925 [label="我们不会让他变为空壳",shape=box,color=blue];
		j2411989925 -> j1361374036;
	j1745035513 [label="我们从来没说过这样的话",shape=box,color=blue];
		j1745035513 -> j3322455431;
	j3322455431 [label="替我们和他谈谈。我们爱你。拜托。你一定要为我们这么做",shape=box,color=blue];
		j3322455431 -> j2868738321;
		j3322455431 -> j3525374662;
		j3322455431 -> j1000447657;
	j1361374036 [label="那。不。是。我们的。错。",shape=box,color=blue];
		j1361374036 -> j4015900150;
	j2868738321 [label="好吧……",shape=box,color=red];
		j2868738321 -> j660922163;
	j3525374662 [label="我……不知道……我会考虑的。",shape=box,color=red];
