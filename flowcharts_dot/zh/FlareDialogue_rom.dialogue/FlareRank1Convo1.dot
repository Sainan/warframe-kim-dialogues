digraph {
	"FlareRank1Convo1 begins." [color=orange];
		"FlareRank1Convo1 begins." -> j3791403833;
	j3791403833 [label="嘿，太空旅行者",shape=box,color=blue];
		j3791403833 -> j3147785562;
		j3791403833 -> j2861620070;
	j3147785562 [label="噢，嘿。你是弗莱尔，对吗？",shape=box,color=red];
		j3147785562 -> j1540287907;
	j2861620070 [label="嘿。怎么了？",shape=box,color=red];
		j2861620070 -> j3722505431;
	j1540287907 [label="你就是另几个实验产物一直跟我说的那个人，对吗？",shape=box,color=blue];
		j1540287907 -> j3429559126;
		j1540287907 -> j3005126089;
	j3722505431 [label="坐在这里，无事可做。我有一堆问题要问你，如果你有时间的话",shape=box,color=blue];
		j3722505431 -> j2778906035;
		j3722505431 -> j812496364;
		j3722505431 -> j322211184;
	j3429559126 [label="我得说，我无法想象会有两个我在这里。但。好吧。说来话长。",shape=box,color=red];
		j3429559126 -> j321873102;
	j3005126089 [label="这要看他们都说了些什么。但很有可能是我。",shape=box,color=red];
		j3005126089 -> j251532324;
	j2778906035 [label="无事可做，你当这是在逛动物园呢。好家伙。",shape=box,color=red];
		j2778906035 -> j2283747286;
	j812496364 [label="真的吗？无事可做？我真是受宠若惊。哈哈。",shape=box,color=red];
		j812496364 -> j2376834970;
	j322211184 [label="如果你有想问的，我就在这里。问吧。",shape=box,color=red];
		j322211184 -> j2737270509;
	j321873102 [label="好吧。怎么说呢。他们告诉了我一些基本的情况。",shape=box,color=blue];
		j321873102 -> j372142650;
	j251532324 [label="好吧……",shape=box,color=blue];
		j251532324 -> j933725858;
		j251532324 -> j2434778852;
	j2283747286 [label="+5 Chemistry",color=orange];
		j2283747286 -> j473795178;
	j2376834970 [label="嘿，抱歉。说错了。",shape=box,color=blue];
		j2376834970 -> j881934202;
	j2737270509 [label="太好了",shape=box,color=blue];
		j2737270509 -> j881934202;
	j372142650 [label="阿米尔已经……非常快地提供了一些细节，可以这么说。",shape=box,color=blue];
		j372142650 -> j561780123;
	j933725858 [label="你当这是逛动物园呢？",shape=box,color=red];
		j933725858 -> j1928662170;
	j2434778852 [label="有什么我能帮你的吗？",shape=box,color=red];
		j2434778852 -> j881934202;
	j473795178 [label="哦，天哪。不是。很抱歉给你这种印象。不过我明白你的意思。我们原型战甲并不是这座城市里唯一的实验产物，对吧？",shape=box,color=blue];
		j473795178 -> j3989143014;
		j473795178 -> j4256682696;
		j473795178 -> j4143000036;
	j881934202 [label="感染。腐烂。正在毒害我血液的这种东西。我需要知道你所了解的一切",shape=box,color=blue];
		j881934202 -> j708171260;
	j561780123 [label="非常……非常的快……",shape=box,color=blue];
		j561780123 -> j2850897917;
	j1928662170 [label="+5 Chemistry",color=orange];
		j1928662170 -> j473795178;
	j3989143014 [label="嗯，但总有更糟的情况。",shape=box,color=red];
		j3989143014 -> j778023295;
	j4256682696 [label="随着时间的推移，你会慢慢学会适应的，大概吧。",shape=box,color=red];
		j4256682696 -> j3443156537;
	j4143000036 [label="对的，不是。",shape=box,color=red];
		j4143000036 -> j3412962188;
	j708171260 [label="从头开始。如果可以的话，*现在*就告诉我，麻烦你了。",shape=box,color=blue];
		j708171260 -> j2988955069;
	j2850897917 [label="Check boolean QuincySpaceTrauma",color=orange];
		j2850897917 -> j2237160134 [label=true,color=green];
		j2850897917 -> j1802539880 [label=false,color=brown];
	j778023295 [label="我*很想*知道，你到底认为什么情况会比现在更糟",shape=box,color=blue];
		j778023295 -> j3880753837;
	j3443156537 [label="这就是我想找你聊的，其实……",shape=box,color=blue];
		j3443156537 -> j881934202;
	j3412962188 [label="那么告诉我",shape=box,color=blue];
		j3412962188 -> j2878500996;
	j2988955069 [label="Boolean FlareInfestation1 is now true.",color=orange];
		j2988955069 -> j1400176782;
		j2988955069 -> j405588162;
		j2988955069 -> j3839119825;
	j2237160134 [label="然后另一个人对“太空创伤”说了点什么，如果我没记错的话？",shape=box,color=blue];
		j2237160134 -> j1802539880;
		j2237160134 -> j3451682628;
	j1802539880 [label="哈哈。好吧，至少我们可以跳过自我介绍的部分了。",shape=box,color=red];
		j1802539880 -> j933725858;
		j1802539880 -> j2434778852;
	j3880753837 [label="启发启发我",shape=box,color=blue];
		j3880753837 -> j2476835297;
	j2878500996 [label="他去了哪儿？英择谛？其他人都说他们不知道，还说连你也不知道",shape=box,color=blue];
		j2878500996 -> j2005106000;
	j1400176782 [label="你就这种态度吗？我好像不太喜欢。",shape=box,color=red];
		j1400176782 -> j4253602905;
	j405588162 [label="呃……从头讲要花很长时间，而且我不认为你会听到想要的答案。",shape=box,color=red];
		j405588162 -> j221911037;
	j3839119825 [label="哇噢，等一下。等一下。你还好吗？",shape=box,color=red];
		j3839119825 -> j1302301900;
	j3451682628 [label="没错。肯定是昆西。",shape=box,color=red];
		j3451682628 -> j933725858;
		j3451682628 -> j2434778852;
	j2476835297 [label="因为从我的角度看来，我的血液里有一种毒药，它正慢慢地让我失去理智，腐蚀我的身体",shape=box,color=blue];
		j2476835297 -> j646510503;
	j2005106000 [label="我觉得都是胡扯",shape=box,color=blue];
		j2005106000 -> j365148024;
	j4253602905 [label="我……抱歉。我通常不会这么做。但我现在的状况……很难用语言形容",shape=box,color=blue];
		j4253602905 -> j3226585070;
	j221911037 [label="亲爱的太空旅行者，我问这些可不是因为得到我想要的答案。而是我*必须知道*答案",shape=box,color=blue];
		j221911037 -> j2093139085;
	j1302301900 [label="我觉得我无法用语言形容我有多么不好",shape=box,color=blue];
		j1302301900 -> j3226585070;
	j646510503 [label="唯一能给我答案的人——唯一能给我一个解释或者让我摆脱她的人已经*消失*了",shape=box,color=blue];
		j646510503 -> j1702964281;
	j365148024 [label="所以你不介意的话，我想知道你所知道的关于他的一切",shape=box,color=blue];
		j365148024 -> j2298332036;
	j3226585070 [label="而且提醒你，用语言表达感受是我的本职工作",shape=box,color=blue];
		j3226585070 -> j2446445730;
	j2093139085 [label="我无法用语言表达我与其他人情况的不同，以及我多么*需要**立即*摆脱她",shape=box,color=blue];
		j2093139085 -> j1784867276;
		j2093139085 -> j1901073980;
		j2093139085 -> j4170641019;
		j2093139085 -> j2513654917;
	j1702964281 [label="Boolean FlareInfestation1 is now true.",color=orange];
		j1702964281 -> j2579430663;
		j1702964281 -> j1400176782;
		j1702964281 -> j405588162;
		j1702964281 -> j3839119825;
	j2298332036 [label="从头开始",shape=box,color=blue];
		j2298332036 -> j1400176782;
		j2298332036 -> j3839119825;
		j2298332036 -> j405588162;
	j2446445730 [label="所以，我就把事实简单地摆在台面上好了。我犯了一个错误，注射了这种奇怪的药剂",shape=box,color=blue];
		j2446445730 -> j2288930165;
	j1784867276 [label="她？",shape=box,color=red];
		j1784867276 -> j1636800634;
	j1901073980 [label="你经历的和六人组经历的没什么不同。你不孤单。",shape=box,color=red];
		j1901073980 -> j805013563;
	j4170641019 [label="我懂得你的感受。我可以帮你。",shape=box,color=red];
		j4170641019 -> j964418248;
	j2513654917 [label="我知道现在发生的事情很可怕——变成原型战甲，还有霍瓦尼亚这里的情况——",shape=box,color=red];
		j2513654917 -> j947255900;
	j2579430663 [label="我的意思是，世界上还有比被视为怪胎更糟糕的事情。哎呀。",shape=box,color=red];
		j2579430663 -> j2508603522;
	j2288930165 [label="我不知道你需要什么帮助，需要什么贿赂，需要为你做什么——但我*现在*就*需要*摆脱她",shape=box,color=blue];
		j2288930165 -> j1784867276;
		j2288930165 -> j1901073980;
		j2288930165 -> j4170641019;
		j2288930165 -> j2513654917;
	j1636800634 [label="“她”是谁？",shape=box,color=red];
		j1636800634 -> j3515654789;
	j805013563 [label="不，不，我一点也不觉得这是同一回事。我现在开始觉得你其实根本不明白……而*这*才是让我害怕的点",shape=box,color=blue];
		j805013563 -> j3146383778;
		j805013563 -> j1033184934;
		j805013563 -> j1228145825;
	j964418248 [label="就是那样。我刚刚以为你没明白……我害怕的就是*那样*",shape=box,color=blue];
		j964418248 -> j1033184934;
		j964418248 -> j3146383778;
		j964418248 -> j1228145825;
	j947255900 [label="就是那样。我刚刚以为你没明白……我害怕的就是*那样*",shape=box,color=blue];
		j947255900 -> j1033184934;
		j947255900 -> j1228145825;
		j947255900 -> j3146383778;
	j2508603522 [label="+5 Chemistry",color=orange];
		j2508603522 -> j4196207577;
	j3515654789 [label="Boolean FlareLizzie1 is now true.",color=orange];
		j3515654789 -> j3352645639;
	j3146383778 [label="你会没事的。我保证。",shape=box,color=red];
		j3146383778 -> j1020764556;
	j1033184934 [label="随你便吧。你想聊的时时候再来找我。",shape=box,color=red];
		j1033184934 -> j2206140283;
	j1228145825 [label="那就帮我弄明白，弗莱尔。跟我说说。发生了什么事？",shape=box,color=red];
		j1228145825 -> j1419935490;
	j4196207577 [label="虽然我……欣赏这种感受，但这超出了任何程度的社交规范，变成了完全不同的东西",shape=box,color=blue];
		j4196207577 -> j2339542448;
	j3352645639 [label="弗莱尔？",shape=box,color=red];
		j3352645639 -> j2206140283;
	j1020764556 [label="但愿我能相信你",shape=box,color=blue];
		j1020764556 -> j2206140283;
	j2206140283 [label="+20 Chemistry",color=orange];
		j2206140283 -> "Initiate conversation HexFlareConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue";
	j1419935490 [label="我……没法。对不起，我就是没法……",shape=box,color=blue];
		j1419935490 -> j2726863055;
	j2339542448 [label="有些东西我无法用语言来表达，而这就是我的工作——用语言表达感受",shape=box,color=blue];
		j2339542448 -> j2446445730;
