digraph {
	0 [label="FlareRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="嘿，太空旅行者",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="噢，嘿。你是弗莱尔，对吗？",shape=box,color=red];
		2 -> 4;
	3 [label="嘿。怎么了？",shape=box,color=red];
		3 -> 5;
	4 [label="你就是另几个实验产物一直跟我说的那个人，对吗？",shape=box,color=blue];
		4 -> 6;
		4 -> 7;
	5 [label="坐在这里，无事可做。我有一堆问题要问你，如果你有时间的话",shape=box,color=blue];
		5 -> 8;
		5 -> 9;
		5 -> 10;
	6 [label="我得说，我无法想象会有两个我在这里。但。好吧。说来话长。",shape=box,color=red];
		6 -> 11;
	7 [label="这要看他们都说了些什么。但很有可能是我。",shape=box,color=red];
		7 -> 12;
	8 [label="无事可做，你当这是在逛动物园呢。好家伙。",shape=box,color=red];
		8 -> 13;
	9 [label="真的吗？无事可做？我真是受宠若惊。哈哈。",shape=box,color=red];
		9 -> 14;
	10 [label="如果你有想问的，我就在这里。问吧。",shape=box,color=red];
		10 -> 15;
	11 [label="好吧。怎么说呢。他们告诉了我一些基本的情况。",shape=box,color=blue];
		11 -> 16;
	12 [label="好吧……",shape=box,color=blue];
		12 -> 17;
		12 -> 18;
	13 [label="+5 Chemistry",color=orange];
		13 -> 19;
	14 [label="嘿，抱歉。说错了。",shape=box,color=blue];
		14 -> 20;
	15 [label="太好了",shape=box,color=blue];
		15 -> 20;
	16 [label="阿米尔已经……非常快地提供了一些细节，可以这么说。",shape=box,color=blue];
		16 -> 21;
	17 [label="你当这是逛动物园呢？",shape=box,color=red];
		17 -> 22;
	18 [label="有什么我能帮你的吗？",shape=box,color=red];
		18 -> 20;
	19 [label="哦，天哪。不是。很抱歉给你这种印象。不过我明白你的意思。我们原型战甲并不是这座城市里唯一的实验产物，对吧？",shape=box,color=blue];
		19 -> 23;
		19 -> 24;
		19 -> 25;
	20 [label="感染。腐烂。正在毒害我血液的这种东西。我需要知道你所了解的一切",shape=box,color=blue];
		20 -> 26;
	21 [label="非常……非常的快……",shape=box,color=blue];
		21 -> 27;
	22 [label="+5 Chemistry",color=orange];
		22 -> 28;
	23 [label="嗯，但总有更糟的情况。",shape=box,color=red];
		23 -> 29;
	24 [label="随着时间的推移，你会慢慢学会适应的，大概吧。",shape=box,color=red];
		24 -> 30;
	25 [label="对的，不是。",shape=box,color=red];
		25 -> 31;
	26 [label="从头开始。如果可以的话，*现在*就告诉我，麻烦你了。",shape=box,color=blue];
		26 -> 32;
	27 [label="Check boolean QuincySpaceTrauma",color=orange];
		27 -> 34 [label=true,color=green];
		27 -> 33 [label=false,color=brown];
	28 [label="哦，天哪。不是。很抱歉给你这种印象。不过我明白你的意思。我们原型战甲并不是这座城市里唯一的实验产物，对吧？",shape=box,color=blue];
		28 -> 23;
		28 -> 24;
		28 -> 25;
	29 [label="我*很想*知道，你到底认为什么情况会比现在更糟",shape=box,color=blue];
		29 -> 35;
	30 [label="这就是我想找你聊的，其实……",shape=box,color=blue];
		30 -> 20;
	31 [label="那么告诉我",shape=box,color=blue];
		31 -> 36;
	32 [label="Update boolean FlareInfestation1",color=orange];
		32 -> 37;
		32 -> 38;
		32 -> 39;
	34 [label="然后另一个人对“太空创伤”说了点什么，如果我没记错的话？",shape=box,color=blue];
		34 -> 33;
		34 -> 40;
	33 [label="哈哈。好吧，至少我们可以跳过自我介绍的部分了。",shape=box,color=red];
		33 -> 17;
		33 -> 18;
	35 [label="启发启发我",shape=box,color=blue];
		35 -> 41;
	36 [label="他去了哪儿？英择谛？其他人都说他们不知道，还说连你也不知道",shape=box,color=blue];
		36 -> 42;
	37 [label="你就这种态度吗？我好像不太喜欢。",shape=box,color=red];
		37 -> 43;
	38 [label="呃……从头讲要花很长时间，而且我不认为你会听到想要的答案。",shape=box,color=red];
		38 -> 44;
	39 [label="哇噢，等一下。等一下。你还好吗？",shape=box,color=red];
		39 -> 45;
	40 [label="没错。肯定是昆西。",shape=box,color=red];
		40 -> 17;
		40 -> 18;
	41 [label="因为从我的角度看来，我的血液里有一种毒药，它正慢慢地让我失去理智，腐蚀我的身体",shape=box,color=blue];
		41 -> 46;
	42 [label="我觉得都是胡扯",shape=box,color=blue];
		42 -> 47;
	43 [label="我……抱歉。我通常不会这么做。但我现在的状况……很难用语言形容",shape=box,color=blue];
		43 -> 48;
	44 [label="亲爱的太空旅行者，我问这些可不是因为得到我想要的答案。而是我*必须知道*答案",shape=box,color=blue];
		44 -> 49;
	45 [label="我觉得我无法用语言形容我有多么不好",shape=box,color=blue];
		45 -> 48;
	46 [label="唯一能给我答案的人——唯一能给我一个解释或者让我摆脱她的人已经*消失*了",shape=box,color=blue];
		46 -> 50;
	47 [label="所以你不介意的话，我想知道你所知道的关于他的一切",shape=box,color=blue];
		47 -> 51;
	48 [label="而且提醒你，用语言表达感受是我的本职工作",shape=box,color=blue];
		48 -> 52;
	49 [label="我无法用语言表达我与其他人情况的不同，以及我多么*需要**立即*摆脱她",shape=box,color=blue];
		49 -> 53;
