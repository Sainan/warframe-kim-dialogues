	52 [label="所以，我就把事实简单地摆在台面上好了。我犯了一个错误，注射了这种奇怪的药剂",shape=box,color=blue];
		52 -> 58;
	53 [label="她？",shape=box,color=red];
		53 -> 59;
	54 [label="你经历的和六人组经历的没什么不同。你不孤单。",shape=box,color=red];
		54 -> 60;
	55 [label="我懂得你的感受。我可以帮你。",shape=box,color=red];
		55 -> 61;
	56 [label="我知道现在发生的事情很可怕——变成原型战甲，还有霍瓦尼亚这里的情况——",shape=box,color=red];
		56 -> 62;
	57 [label="我的意思是，世界上还有比被视为怪胎更糟糕的事情。哎呀。",shape=box,color=red];
		57 -> 63;
	58 [label="我不知道你需要什么帮助，需要什么贿赂，需要为你做什么——但我*现在*就*需要*摆脱她",shape=box,color=blue];
		58 -> 53;
		58 -> 54;
		58 -> 55;
		58 -> 56;
	59 [label="“她”是谁？",shape=box,color=red];
		59 -> 64;
	60 [label="不，不，我一点也不觉得这是同一回事。我现在开始觉得你其实根本不明白……而*这*才是让我害怕的点",shape=box,color=blue];
		60 -> 65;
