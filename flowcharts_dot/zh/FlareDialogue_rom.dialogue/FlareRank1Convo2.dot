		140 -> 144;
	141 [label="然后你做了什么？",shape=box,color=red];
		141 -> 145;
	142 [label="我讨厌世界上存在这样的人。",shape=box,color=red];
		142 -> 146;
	143 [label="我非常非常抱歉，弗莱尔……",shape=box,color=red];
		143 -> 147;
	144 [label="我希望能做点什么改变情况，但是……",shape=box,color=red];
		144 -> 148;
	145 [label="或多或少地发泄了我的愤怒",shape=box,color=blue];
		145 -> 149;
	146 [label="不能让自己被仇恨扭曲。 即使你所做的事是一名士兵，每天都必须杀人，整天都在——",shape=box,color=blue];
		146 -> 150;
	147 [label="+5 Chemistry",color=orange];
		147 -> 151;
	148 [label="+5 Chemistry",color=orange];
		148 -> 152;
	149 [label="或好或坏",shape=box,color=blue];
		149 -> 153;
	150 [label="我会尽量不去恨他们。但我想，如果另一种选择是麻木感受不到任何东西，那会更糟，对吧？",shape=box,color=blue];
		150 -> 154;
	151 [label="有些事情就是会发生。我不是这个世界上第一个遭遇悲剧的人，也不是最后一个",shape=box,color=blue];
		151 -> 155;
	152 [label="不。我懂。卡娅——啊抱歉，她更喜欢别人叫她 Nova，——她向我解释过。时间旅行很复杂",shape=box,color=blue];
		152 -> 156;
	153 [label="不过……既然我们聊到了我的……转变，我突然想到个问题。",shape=box,color=blue];
		153 -> 157;
	154 [label="如果我们变得麻木，就会发生更糟糕的事情，你知道吧？",shape=box,color=blue];
		154 -> 158;
		154 -> 159;
	155 [label="无论你走到哪里，都会有人失去亲人。我们经历的爱与悲伤塑造了我们。",shape=box,color=blue];
		155 -> 160;
	156 [label="然后……有些事情就是会发生。我不是这个世界上第一个遭遇悲剧的人，也不是最后一个",shape=box,color=blue];
		156 -> 161;
	157 [label="Update boolean FlareInfestation2",color=orange];
		157 -> 162;
	158 [label="我其实宁愿无谓的屠杀不要发生，不过是的，我明白。",shape=box,color=red];
		158 -> 163;
	159 [label="对，我知道。",shape=box,color=red];
		159 -> 163;
	160 [label="如果我们变得麻木，就会发生更糟糕的事情，你知道吧？",shape=box,color=blue];
		160 -> 158;
		160 -> 159;
	161 [label="但还是谢谢你。我很感激你想去试试的心。这对我来说就够了。",shape=box,color=blue];
		161 -> 153;
	162 [label="这种感染……当……当英择谛给人注射病毒株时……它最终状态的多少影响是由毒株本身决定的？",shape=box,color=blue];
		162 -> 164;
	163 [label="呵呵。说得好。",shape=box,color=blue];
		163 -> 153;
	164 [label="又有多少是由被注射的对象决定的……？",shape=box,color=blue];
		164 -> 165;
	165 [label="多少是毒株本身的，多少是后天的……？",shape=box,color=blue];
		165 -> 166;
		165 -> 167;
	166 [label="对于战甲和原型战甲好像不一样。",shape=box,color=red];
		166 -> 168;
	167 [label="说实话我不知道。我只能猜测。",shape=box,color=red];
		167 -> 169;
	168 [label="我不在乎你是不是瞎编的，我只有这些了。但请快点……以防",shape=box,color=blue];
		168 -> 170;
	169 [label="求求你了。猜测总比没有好。但请快点……以防……",shape=box,color=blue];
		169 -> 171;
		169 -> 170;
	170 [label="“以防”什么？",shape=box,color=red];
		170 -> 172;
	171 [label="……好。",shape=box,color=red];
		171 -> 173;
	172 [label="没什么，请继续解释下你刚才说的",shape=box,color=blue];
		172 -> 174;
		172 -> 175;
	173 [label="所以，我认为对于普通战甲而言，它们吸取了完整的个性，除了一些零零碎碎的。但英择谛用来制造原型战甲的毒株*取自*这些普通战甲。",shape=box,color=red];
		173 -> 176;
	174 [label="好吧……",shape=box,color=red];
		174 -> 173;
	175 [label="不，弗莱尔。你有事瞒着我。告诉我。我为什么要快点？“以防”什么？！",shape=box,color=red];
		175 -> 177;
	176 [label="所以，你成了你自己的和这个毒株来源的战甲的混合体。",shape=box,color=red];
		176 -> 178;
	177 [label="这不是我的错……这根本不是我的错，你明白吗？！妈的……妈的",shape=box,color=blue];
		177 -> 179;
	178 [label="所以……她不是我。噢，谢天谢地。噢，谢天谢地。你不知道听到这句话我有多*解脱*。",shape=box,color=blue];
