		93 -> 99 [label=false,color=brown];
	94 [label="没问题。我可以问一下你来霍瓦尼亚的原因吗？",shape=box,color=red];
		94 -> 97;
	95 [label="好吧，但是……你之前说“她”会杀了你。听起来很严重。“她”是谁？",shape=box,color=red];
		95 -> 98;
	99 [label="好吧，但你看上去很难过。我觉得这事不能就这么算了……发生了什么？",shape=box,color=red];
		99 -> 98;
	97 [label="Update boolean FlareBackstory1",color=orange];
		97 -> 100;
	98 [label="我警告过你……我警告过你……这不是我的错……这根本不是我的错，你明白吗？！妈的……妈的",shape=box,color=blue];
		98 -> 101;
	100 [label="有一天，我接到了一个奇怪的电话，某个狡猾的鸟人打来的。他装作一副了不起的样子，振振有词，好像非得证明点什么",shape=box,color=blue];
		100 -> 102;
	101 [label="Update boolean FlareLizzie2",color=orange];
		101 -> 103;
	102 [label="他告诉我们他有多么重要，这座城市是如何正在“堕落”和“失去信仰”的，以及我们该怎么“帮助他完成他的崇高事业，让一切回到正轨”",shape=box,color=blue];
		102 -> 104;
	103 [label="+20 Chemistry",color=orange];
		103 -> 105;
	104 [label="他还真以为自己知道在和谁说话呢。最好笑的是？他还自称是我的*粉丝*",shape=box,color=blue];
		104 -> 106;
	105 [label="Chat ends. Next chat will be FlareRank1Convo3.",color=orange];
	106 [label="这个世界上最糟糕的事情，莫过于看着某些蠢货为了自己的目的而歪曲你的话了",shape=box,color=blue];
		106 -> 107;
	107 [label="所以，我们当然答应了。主要就是为了惹怒那个鸟人，让他知道多大屌办多大事",shape=box,color=blue];
		107 -> 108;
	108 [label="早知道就该相信那些关于奇怪疫情的小道消息了",shape=box,color=blue];
		108 -> 109;
	109 [label="真他妈见鬼",shape=box,color=blue];
		109 -> 110;
		109 -> 111;
	110 [label="靠。",shape=box,color=red];
		110 -> 112;
	111 [label="你感染了科腐者？",shape=box,color=red];
		111 -> 112;
	112 [label="推荐指数 0 分。再也不想来。当时我在巡演巴士上躺着，突然有人敲门",shape=box,color=blue];
		112 -> 113;
		112 -> 114;
	113 [label="是英择谛？",shape=box,color=red];
		113 -> 115;
	114 [label="让我猜猜。",shape=box,color=red];
		114 -> 116;
	115 [label="叮叮叮。",shape=box,color=blue];
		115 -> 116;
	116 [label="噗，你也知道故事会怎么发展了。神奇的奇迹疗法？还说什么会让我成为世界上前所未有的艺人？",shape=box,color=blue];
		116 -> 117;
	117 [label="诸如此类等等、等等。",shape=box,color=blue];
		117 -> 118;
	118 [label="那个鸟人想要一场演唱会？好吧，他如愿以偿了。我的舞台形象一直有点……过于",shape=box,color=blue];
		118 -> 119;
	119 [label="我总会把音量开到最大 ",shape=box,color=blue];
		119 -> 120;
	120 [label="但现在？*现在？*我感觉自己飘得比云朵还高，靠着某种我甚至不知道其*存在的*汁液运行着",shape=box,color=blue];
		120 -> 121;
		120 -> 122;
	121 [label="然后呢？",shape=box,color=red];
		121 -> 123;
	122 [label="虚空可是猛药。",shape=box,color=red];
		122 -> 124;
	123 [label="站在那个舞台上，我感觉自己焕然一新……或者说是重生了。真正的重生。我感觉自己比以往任何时候都更贴近本我。真是太奇妙了。自由自在。我感觉自己在飞翔",shape=box,color=blue];
		123 -> 125;
	124 [label="什么？",shape=box,color=blue];
		124 -> 126;
	125 [label="我们为霍瓦尼亚举办了一场他们永远不会忘记的音乐会。那个鸟人想让我们给他们希望？和信念？我们做到了。直入人心",shape=box,color=blue];
		125 -> 127;
	126 [label="别管了，继续吧。 ",shape=box,color=red];
		126 -> 123;
	127 [label="然后他们就掀翻了炽蛇军的卡车，推倒雕像，哈哈哈",shape=box,color=blue];
		127 -> 128;
	128 [label="那个鸟人气坏了……",shape=box,color=blue];
		128 -> 129;
	129 [label="早应该知道这会让我们付出代价的……",shape=box,color=blue];
		129 -> 130;
	130 [label="会让他们……",shape=box,color=blue];
		130 -> 131;
		130 -> 132;
	131 [label="我听说了。",shape=box,color=red];
		131 -> 133;
	132 [label="发生了什么……？",shape=box,color=red];
		132 -> 134;
	133 [label="是的。",shape=box,color=blue];
		133 -> 135;
	134 [label="那个鸟人决定无论如何都要举办属于他自己的演出。只是这一次？不再是演唱会",shape=box,color=blue];
		134 -> 136;
	135 [label="我根本无力阻止他们。他们人数太多了。对付我一个人？我倒是看过你干掉他们时，就像切水果一样轻松……",shape=box,color=blue];
		135 -> 137;
	136 [label="而是那种你只能表演一次的演出……",shape=box,color=blue];
		136 -> 135;
	137 [label="而我就像刚出生的小长颈鹿学走路一样瘫在这里",shape=box,color=blue];
		137 -> 138;
	138 [label="除了看着他们一个个死去之外什么也做不了……",shape=box,color=blue];
		138 -> 139;
	139 [label="鸟人还通过国家电视台现场直播……",shape=box,color=blue];
		139 -> 140;
	140 [label="对收视率得意洋洋，好像这是什么值得骄傲的事……",shape=box,color=blue];
		140 -> 141;
