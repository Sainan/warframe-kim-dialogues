		"FlareRank1Convo2 begins." -> j3318564459;
		"FlareRank1Convo2 begins." -> j1513116245;
	j173065721 [label="对了昨天……",shape=box,color=red];
		j173065721 -> j205752660;
	j3318564459 [label="弗莱尔？你在吗？",shape=box,color=red];
		j3318564459 -> j1144113379;
	j1513116245 [label="我们可以聊聊吗？",shape=box,color=red];
		j1513116245 -> j3038205283;
	j205752660 [label="嘿。那个，我之前心情不好。你知道的。还请换一个话题",shape=box,color=blue];
		j205752660 -> j3085447498;
	j1144113379 [label="我在。但如果你是来聊昨天的事的，我们能换个话题吗？ 我之前心情不好，还是不要继续那个话题了",shape=box,color=blue];
		j1144113379 -> j3085447498;
	j3038205283 [label="当然了。但如果你是来聊昨天的事的，我们能换个话题吗？ 我之前心情不好，还是不要继续那个话题了",shape=box,color=blue];
		j3038205283 -> j3085447498;
	j3085447498 [label="Check boolean FlareLizzie1",color=orange];
		j3085447498 -> j1558197024 [label=true,color=green];
		j3085447498 -> j1180162462 [label=true,color=green];
		j3085447498 -> j1558197024 [label=false,color=brown];
		j3085447498 -> j1277001850 [label=false,color=brown];
	j1558197024 [label="没问题。我可以问一下你来霍瓦尼亚的原因吗？",shape=box,color=red];
		j1558197024 -> j308278381;
	j1180162462 [label="好吧，但是……你之前说“她”会杀了你。听起来很严重。“她”是谁？",shape=box,color=red];
		j1180162462 -> j4267322743;
	j1277001850 [label="好吧，但你看上去很难过。我觉得这事不能就这么算了……发生了什么？",shape=box,color=red];
		j1277001850 -> j4267322743;
	j308278381 [label="Boolean FlareBackstory1 is now true.",color=orange];
		j308278381 -> j3107970616;
	j4267322743 [label="我警告过你……我警告过你……这不是我的错……这根本不是我的错，你明白吗？！妈的……妈的",shape=box,color=blue];
		j4267322743 -> j145207193;
	j3107970616 [label="有一天，我接到了一个奇怪的电话，某个狡猾的鸟人打来的。他装作一副了不起的样子，振振有词，好像非得证明点什么",shape=box,color=blue];
		j3107970616 -> j1603662508;
	j145207193 [label="Boolean FlareLizzie2 is now true.",color=orange];
		j145207193 -> j261191027;
	j1603662508 [label="他告诉我们他有多么重要，这座城市是如何正在“堕落”和“失去信仰”的，以及我们该怎么“帮助他完成他的崇高事业，让一切回到正轨”",shape=box,color=blue];
		j1603662508 -> j13868766;
	j261191027 [label="+20 Chemistry",color=orange];
		j261191027 -> "Chat ends. Next chat will be FlareRank1Convo3.";
	j13868766 [label="他还真以为自己知道在和谁说话呢。最好笑的是？他还自称是我的*粉丝*",shape=box,color=blue];
		j13868766 -> j980611920;
	"Chat ends. Next chat will be FlareRank1Convo3." [color=orange];
	j980611920 [label="这个世界上最糟糕的事情，莫过于看着某些蠢货为了自己的目的而歪曲你的话了",shape=box,color=blue];
		j980611920 -> j1660210504;
	j1660210504 [label="所以，我们当然答应了。主要就是为了惹怒那个鸟人，让他知道多大屌办多大事",shape=box,color=blue];
		j1660210504 -> j1869657107;
	j1869657107 [label="早知道就该相信那些关于奇怪疫情的小道消息了",shape=box,color=blue];
		j1869657107 -> j4261365009;
	j4261365009 [label="真他妈见鬼",shape=box,color=blue];
		j4261365009 -> j1322304624;
		j4261365009 -> j3063996554;
	j1322304624 [label="靠。",shape=box,color=red];
		j1322304624 -> j662384958;
	j3063996554 [label="你感染了科腐者？",shape=box,color=red];
		j3063996554 -> j662384958;
	j662384958 [label="推荐指数 0 分。再也不想来。当时我在巡演巴士上躺着，突然有人敲门",shape=box,color=blue];
		j662384958 -> j147626406;
		j662384958 -> j3105030766;
	j147626406 [label="是英择谛？",shape=box,color=red];
		j147626406 -> j1867005106;
	j3105030766 [label="让我猜猜。",shape=box,color=red];
		j3105030766 -> j1217889465;
	j1867005106 [label="叮叮叮。",shape=box,color=blue];
		j1867005106 -> j1217889465;
	j1217889465 [label="噗，你也知道故事会怎么发展了。神奇的奇迹疗法？还说什么会让我成为世界上前所未有的艺人？",shape=box,color=blue];
		j1217889465 -> j3276061790;
	j3276061790 [label="诸如此类等等、等等。",shape=box,color=blue];
		j3276061790 -> j1800753767;
	j1800753767 [label="那个鸟人想要一场演唱会？好吧，他如愿以偿了。我的舞台形象一直有点……过于",shape=box,color=blue];
		j1800753767 -> j4071726575;
	j4071726575 [label="我总会把音量开到最大 ",shape=box,color=blue];
		j4071726575 -> j2570393508;
	j2570393508 [label="但现在？*现在？*我感觉自己飘得比云朵还高，靠着某种我甚至不知道其*存在的*汁液运行着",shape=box,color=blue];
		j2570393508 -> j2682059599;
		j2570393508 -> j1466452813;
	j2682059599 [label="然后呢？",shape=box,color=red];
		j2682059599 -> j2068923922;
	j1466452813 [label="虚空可是猛药。",shape=box,color=red];
		j1466452813 -> j1111051758;
	j2068923922 [label="站在那个舞台上，我感觉自己焕然一新……或者说是重生了。真正的重生。我感觉自己比以往任何时候都更贴近本我。真是太奇妙了。自由自在。我感觉自己在飞翔",shape=box,color=blue];
		j2068923922 -> j3663103453;
	j1111051758 [label="什么？",shape=box,color=blue];
		j1111051758 -> j846881766;
	j3663103453 [label="我们为霍瓦尼亚举办了一场他们永远不会忘记的音乐会。那个鸟人想让我们给他们希望？和信念？我们做到了。直入人心",shape=box,color=blue];
		j3663103453 -> j1374490274;
	j846881766 [label="别管了，继续吧。 ",shape=box,color=red];
		j846881766 -> j2068923922;
	j1374490274 [label="然后他们就掀翻了炽蛇军的卡车，推倒雕像，哈哈哈",shape=box,color=blue];
		j1374490274 -> j3008290222;
	j3008290222 [label="那个鸟人气坏了……",shape=box,color=blue];
		j3008290222 -> j1087154828;
	j1087154828 [label="早应该知道这会让我们付出代价的……",shape=box,color=blue];
		j1087154828 -> j92413999;
	j92413999 [label="会让他们……",shape=box,color=blue];
		j92413999 -> j2577927382;
		j92413999 -> j2942135894;
	j2577927382 [label="我听说了。",shape=box,color=red];
		j2577927382 -> j467265377;
	j2942135894 [label="发生了什么……？",shape=box,color=red];
		j2942135894 -> j654989825;
	j467265377 [label="是的。",shape=box,color=blue];
		j467265377 -> j2917282434;
	j654989825 [label="那个鸟人决定无论如何都要举办属于他自己的演出。只是这一次？不再是演唱会",shape=box,color=blue];
		j654989825 -> j3502850508;
	j2917282434 [label="我根本无力阻止他们。他们人数太多了。对付我一个人？我倒是看过你干掉他们时，就像切水果一样轻松……",shape=box,color=blue];
		j2917282434 -> j1072430722;
	j3502850508 [label="而是那种你只能表演一次的演出……",shape=box,color=blue];
		j3502850508 -> j2917282434;
	j1072430722 [label="而我就像刚出生的小长颈鹿学走路一样瘫在这里",shape=box,color=blue];
		j1072430722 -> j2123318477;
	j2123318477 [label="除了看着他们一个个死去之外什么也做不了……",shape=box,color=blue];
		j2123318477 -> j1783349912;
	j1783349912 [label="鸟人还通过国家电视台现场直播……",shape=box,color=blue];
		j1783349912 -> j245661577;
	j245661577 [label="对收视率得意洋洋，好像这是什么值得骄傲的事……",shape=box,color=blue];
		j245661577 -> j3750155844;
		j245661577 -> j992688282;
		j245661577 -> j4021301331;
		j245661577 -> j4115092305;
	j3750155844 [label="然后你做了什么？",shape=box,color=red];
		j3750155844 -> j1260208888;
	j992688282 [label="我讨厌世界上存在这样的人。",shape=box,color=red];
		j992688282 -> j3761875564;
	j4021301331 [label="我非常非常抱歉，弗莱尔……",shape=box,color=red];
		j4021301331 -> j1055387523;
	j4115092305 [label="我希望能做点什么改变情况，但是……",shape=box,color=red];
		j4115092305 -> j269901234;
	j1260208888 [label="或多或少地发泄了我的愤怒",shape=box,color=blue];
		j1260208888 -> j917207166;
	j3761875564 [label="不能让自己被仇恨扭曲。 即使你所做的事是一名士兵，每天都必须杀人，整天都在——",shape=box,color=blue];
		j3761875564 -> j807225964;
	j1055387523 [label="+5 Chemistry",color=orange];
		j1055387523 -> j1687959941;
	j269901234 [label="+5 Chemistry",color=orange];
		j269901234 -> j2633703496;
	j917207166 [label="或好或坏",shape=box,color=blue];
		j917207166 -> j3965435181;
	j807225964 [label="我会尽量不去恨他们。但我想，如果另一种选择是麻木感受不到任何东西，那会更糟，对吧？",shape=box,color=blue];
		j807225964 -> j2206382502;
	j1687959941 [label="有些事情就是会发生。我不是这个世界上第一个遭遇悲剧的人，也不是最后一个",shape=box,color=blue];
		j1687959941 -> j676724827;
	j2633703496 [label="不。我懂。卡娅——啊抱歉，她更喜欢别人叫她 Nova，——她向我解释过。时间旅行很复杂",shape=box,color=blue];
		j2633703496 -> j678323947;
	j3965435181 [label="不过……既然我们聊到了我的……转变，我突然想到个问题。",shape=box,color=blue];
		j3965435181 -> j3760200232;
	j2206382502 [label="如果我们变得麻木，就会发生更糟糕的事情，你知道吧？",shape=box,color=blue];
		j2206382502 -> j1803193787;
		j2206382502 -> j1861971228;
	j676724827 [label="无论你走到哪里，都会有人失去亲人。我们经历的爱与悲伤塑造了我们。",shape=box,color=blue];
		j676724827 -> j2206382502;
	j678323947 [label="然后……有些事情就是会发生。我不是这个世界上第一个遭遇悲剧的人，也不是最后一个",shape=box,color=blue];
		j678323947 -> j3370771898;
	j3760200232 [label="Boolean FlareInfestation2 is now true.",color=orange];
		j3760200232 -> j2621008640;
	j1803193787 [label="我其实宁愿无谓的屠杀不要发生，不过是的，我明白。",shape=box,color=red];
		j1803193787 -> j2186588406;
	j1861971228 [label="对，我知道。",shape=box,color=red];
		j1861971228 -> j2186588406;
	j3370771898 [label="但还是谢谢你。我很感激你想去试试的心。这对我来说就够了。",shape=box,color=blue];
		j3370771898 -> j3965435181;
	j2621008640 [label="这种感染……当……当英择谛给人注射病毒株时……它最终状态的多少影响是由毒株本身决定的？",shape=box,color=blue];
		j2621008640 -> j4227034560;
	j2186588406 [label="呵呵。说得好。",shape=box,color=blue];
		j2186588406 -> j3965435181;
	j4227034560 [label="又有多少是由被注射的对象决定的……？",shape=box,color=blue];
		j4227034560 -> j552218281;
	j552218281 [label="多少是毒株本身的，多少是后天的……？",shape=box,color=blue];
		j552218281 -> j3310544670;
		j552218281 -> j3656377094;
	j3310544670 [label="对于战甲和原型战甲好像不一样。",shape=box,color=red];
		j3310544670 -> j3362582082;
	j3656377094 [label="说实话我不知道。我只能猜测。",shape=box,color=red];
		j3656377094 -> j341433686;
	j3362582082 [label="我不在乎你是不是瞎编的，我只有这些了。但请快点……以防",shape=box,color=blue];
		j3362582082 -> j4198797511;
	j341433686 [label="求求你了。猜测总比没有好。但请快点……以防……",shape=box,color=blue];
		j341433686 -> j3030029332;
		j341433686 -> j4198797511;
	j4198797511 [label="“以防”什么？",shape=box,color=red];
		j4198797511 -> j474150416;
	j3030029332 [label="……好。",shape=box,color=red];
		j3030029332 -> j3229080014;
	j474150416 [label="没什么，请继续解释下你刚才说的",shape=box,color=blue];
		j474150416 -> j2712119087;
		j474150416 -> j2558293959;
	j3229080014 [label="所以，我认为对于普通战甲而言，它们吸取了完整的个性，除了一些零零碎碎的。但英择谛用来制造原型战甲的毒株*取自*这些普通战甲。",shape=box,color=red];
		j3229080014 -> j3925592079;
	j2712119087 [label="好吧……",shape=box,color=red];
		j2712119087 -> j3229080014;
	j2558293959 [label="不，弗莱尔。你有事瞒着我。告诉我。我为什么要快点？“以防”什么？！",shape=box,color=red];
		j2558293959 -> j101324838;
	j3925592079 [label="所以，你成了你自己的和这个毒株来源的战甲的混合体。",shape=box,color=red];
		j3925592079 -> j4051283757;
	j101324838 [label="这不是我的错……这根本不是我的错，你明白吗？！妈的……妈的",shape=box,color=blue];
		j101324838 -> j1832658038;
	j4051283757 [label="所以……她不是我。噢，谢天谢地。噢，谢天谢地。你不知道听到这句话我有多*解脱*。",shape=box,color=blue];
		j4051283757 -> j3292288683;
	j1832658038 [label="Check boolean Check FlareLizzie1",color=orange];
		j1832658038 -> j145207193 [label=true,color=green];
		j1832658038 -> j2551528817 [label=false,color=brown];
	j3292288683 [label="Check boolean FlareLizzie1",color=orange];
		j3292288683 -> j1489036062 [label=true,color=green];
		j3292288683 -> j1295373061 [label=false,color=brown];
	j2551528817 [label="Boolean FlareLizzie1 is now true.",color=orange];
		j2551528817 -> j261191027;
	j1489036062 [label="又是这个“她”。“她”是谁？",shape=box,color=red];
		j1489036062 -> j1125360846;
	j1295373061 [label="等等。什么？她？“她”是谁？",shape=box,color=red];
		j1295373061 -> j2420960243;
	j1125360846 [label="一个我们需要解决的问题……对于即将要在你身上发生的事，我深感抱歉",shape=box,color=blue];
		j1125360846 -> j145207193;
	j2420960243 [label="我现在不能再谈论这个了。对不起",shape=box,color=blue];
		j2420960243 -> j2551528817;
