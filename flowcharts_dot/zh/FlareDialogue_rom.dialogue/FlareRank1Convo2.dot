	87 [label="对了昨天……",shape=box,color=red];
		87 -> 90;
	88 [label="弗莱尔？你在吗？",shape=box,color=red];
		88 -> 91;
	89 [label="我们可以聊聊吗？",shape=box,color=red];
		89 -> 92;
	90 [label="嘿。那个，我之前心情不好。你知道的。还请换一个话题",shape=box,color=blue];
		90 -> 93;
	91 [label="我在。但如果你是来聊昨天的事的，我们能换个话题吗？ 我之前心情不好，还是不要继续那个话题了",shape=box,color=blue];
		91 -> 93;
	92 [label="当然了。但如果你是来聊昨天的事的，我们能换个话题吗？ 我之前心情不好，还是不要继续那个话题了",shape=box,color=blue];
		92 -> 93;
