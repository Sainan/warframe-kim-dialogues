		j986641060 -> j1302961707 [label=false,color=brown];
	j3784881671 [label="Boolean WhatLoop2 is now true.",color=orange];
		j3784881671 -> j1957115620;
	j3673652922 [label="操作控制面板？",shape=box,color=red];
		j3673652922 -> j1168789816;
	j2800354362 [label="拿起剪线钳？",shape=box,color=red];
		j2800354362 -> j3407978234;
	j563723942 [label="拿起撬棍？",shape=box,color=red];
		j563723942 -> j1514397862;
	j1194965971 [label="我",shape=box,color=blue];
		j1194965971 -> j496092661;
	j1302961707 [label="Boolean WhatLoop3 is now true.",color=orange];
		j1302961707 -> j1957115620;
	j1168789816 [label="Boolean ControlPanel is now true.",color=orange];
		j1168789816 -> j3136528501;
	j3407978234 [label="Boolean WireCutters is now true.",color=orange];
		j3407978234 -> j1156177139;
	j1514397862 [label="“你拿起那根粗大的撬棍，这是个很结实的工具。男子压抑的惨声越来越大了。”",shape=box,color=blue];
		j1514397862 -> j601448143;
		j1514397862 -> j4175296542;
		j1514397862 -> j1408187006;
	j496092661 [label="我得先暂停一下，不然你再这样下去会让我得鼠标手",shape=box,color=blue];
		j496092661 -> j251184870;
	j3136528501 [label="Check boolean PanelSmashed",color=orange];
		j3136528501 -> j4033198457 [label=true,color=green];
		j3136528501 -> j4182229945 [label=false,color=brown];
	j1156177139 [label="“这把是工业级别的剪线钳，看起来几乎什么都能剪断。”",shape=box,color=blue];
		j1156177139 -> j3538018545;
	j601448143 [label="用撬棍砸烂控制面板。",shape=box,color=red];
		j601448143 -> j1110728012;
	j4175296542 [label="将撬棍扔进涡轮叶片。",shape=box,color=red];
		j4175296542 -> j1277433035;
	j1408187006 [label="继续环顾四周",shape=box,color=red];
		j1408187006 -> j1571667540;
	j251184870 [label="你这是在折磨我，还是说你真的不会玩啊",shape=box,color=blue];
		j251184870 -> j3217792529;
	j4033198457 [label="“你大概不想再碰那个玩意了吧。”",shape=box,color=blue];
		j4033198457 -> j2800354362;
		j4033198457 -> j563723942;
	j4182229945 [label="“你试图操作控制面板，但它被安全协议锁住了，连你也无法破解。你意识到只能手动解决这个问题了作。”",shape=box,color=blue];
		j4182229945 -> j2800354362;
		j4182229945 -> j563723942;
	j3538018545 [label="剪掉电缆。",shape=box,color=red];
		j3538018545 -> j995680227;
	j1110728012 [label="Boolean ControlPanel is now true.",color=orange];
		j1110728012 -> j572503223;
	j1277433035 [label="“你猛地一抬手，把撬棍扔进涡轮机。房间里顿时响起齿轮和活塞的摩擦声。涡轮机的转速也慢了下来。”",shape=box,color=blue];
		j1277433035 -> j2794938828;
	j3217792529 [label="所以咱们直接跳剧情吧",shape=box,color=blue];
		j3217792529 -> j4020229245;
	j995680227 [label="Check boolean TurbineStopped",color=orange];
		j995680227 -> j616637200 [label=true,color=green];
		j995680227 -> j3497076248 [label=false,color=brown];
	j572503223 [label="Check boolean PanelSmashed",color=orange];
		j572503223 -> j3230103950 [label=true,color=green];
		j572503223 -> j1754676171 [label=false,color=brown];
	j2794938828 [label="“那男子如释重负地瘫倒在地。说道：快救我出去。”",shape=box,color=blue];
		j2794938828 -> j825165512;
	j4020229245 [label="嗯哼",shape=box,color=blue];
		j4020229245 -> j2836556400;
	j616637200 [label="“剪线钳轻松剪断了连在男子身上的电缆。他的双臂解脱后，开始解开剩余的束缚。”",shape=box,color=blue];
		j616637200 -> j2636129826;
	j3497076248 [label="“你把剪线钳的刀口对准带电电线，立刻就后悔了。电流通过剪线钳流入你的身体，把你击飞了出去。”",shape=box,color=blue];
		j3497076248 -> j1947672897;
	j3230103950 [label="“上次这招的效果可不怎么样。”",shape=box,color=blue];
		j3230103950 -> j1408187006;
		j3230103950 -> j4175296542;
	j1754676171 [label="“当你砸碎控制面板时，被困的男子似乎朝你怒吼起来。他并不喜欢你的做法。”",shape=box,color=blue];
		j1754676171 -> j1502386489;
	j825165512 [label="Boolean TurbineStopped is now true.",color=orange];
		j825165512 -> j3538018545;
	j2836556400 [label="（清嗓子）",shape=box,color=blue];
		j2836556400 -> j3860628017;
	j2636129826 [label="“男子摘下圆形墨镜，久久地注视着自己的救命恩人。”",shape=box,color=blue];
		j2636129826 -> j3499241272;
	j1947672897 [label="“你躺在地上慢慢恢复意识。那个男子还在痛苦中，而你的头发现在都竖了起来。”",shape=box,color=blue];
		j1947672897 -> j970257374;
	j1502386489 [label="Boolean PanelSmashed is now true.",color=orange];
		j1502386489 -> j1408187006;
		j1502386489 -> j4175296542;
	j3860628017 [label="“奇迹般地，涡轮机竟被男子纯粹的力量引爆！”",shape=box,color=blue];
		j3860628017 -> j180453200;
	j3499241272 [label="Check boolean AmirDating",color=orange];
		j3499241272 -> j1194544209 [label=true,color=green];
