	j519474280 [label="Boolean WhatLoop1 is now true.",color=orange];
		j519474280 -> j1957115620;
	j1957115620 [label="你会怎么做？",shape=box,color=blue];
		j1957115620 -> j3673652922;
		j1957115620 -> j2800354362;
		j1957115620 -> j563723942;
	j986641060 [label="Check boolean WhatLoop3",color=orange];
