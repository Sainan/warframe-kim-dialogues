	j970257374 [label="Boolean Zapped is now true.",color=orange];
		j970257374 -> j1571667540;
	j180453200 [label="“男子摘下圆形墨镜，久久地注视着自己的救命恩人。”",shape=box,color=blue];
		j180453200 -> j664524854;
	j1194544209 [label="“他的目光很锐利。”",shape=box,color=blue];
		j1194544209 -> j4060310498;
	j200397730 [label="戴着圆墨镜的这位，他叫什么名字？",shape=box,color=red];
		j200397730 -> j1038740648;
	j664524854 [label="呃，我是说",shape=box,color=blue];
		j664524854 -> j409707027;
	j4060310498 [label="“你注意到他结实的双手、饱满的前臂和紧实的双腿。你挑了挑眉，心想‘速度型的身材’。”",shape=box,color=blue];
		j4060310498 -> j2032299577;
	j1038740648 [label="“叫我扎比尔。他自信地说道。”",shape=box,color=blue];
		j1038740648 -> j3861372110;
	j409707027 [label="“男子摘下圆形墨镜，久久地注视着那个刚才试图救他的家伙。”",shape=box,color=blue];
		j409707027 -> j3499241272;
	j2032299577 [label="冷静点，大个子。这位帅哥叫什么名字？",shape=box,color=red];
		j2032299577 -> j1038740648;
	j3861372110 [label="听起来有些耳熟。他们对你做了什么？",shape=box,color=red];
		j3861372110 -> j2087182748;
	j2087182748 [label="“‘榨取我的能量。我的电力十足，你应该已经注意到了。’扎比尔说道。”",shape=box,color=blue];
		j2087182748 -> j1454628417;
	j1454628417 [label="好吧，扎比尔，我们怎么救 Lotus。",shape=box,color=red];
		j1454628417 -> j3559463306;
	j3559463306 [label="扎比尔震惊了。“救 Lotus？就是她把我放到这里来的！我们得离开这颗小行星！”",shape=box,color=blue];
		j3559463306 -> j3375435886;
		j3559463306 -> j1551573588;
	j3375435886 [label="阿米尔，什么？",shape=box,color=red];
