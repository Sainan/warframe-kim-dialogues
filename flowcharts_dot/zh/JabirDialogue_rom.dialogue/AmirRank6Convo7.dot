	j3301792238 [label="我就知道你会回来的",shape=box,color=blue];
		j3301792238 -> "Chat ends.";
	j1835025740 [label="“当你转动那群意外友好的巨鼠送给你的钥匙时，你心中暗自祈祷，门后的一切会比身后的地牢更美好。”",shape=box,color=blue];
		j1835025740 -> j2936832420;
	"Chat ends. Next chat will be AmirRank6Convo3." [color=orange];
	"Chat ends. Next chat will be AmirRank6Convo2." [color=orange];
	j2936832420 [label="“你发现自己站在一座巨大的货梯前。原来这里不只是地下城那么简单？”",shape=box,color=blue];
		j2936832420 -> j3779346330;
		j2936832420 -> j754681339;
	j3779346330 [label="返回地下城。",shape=box,color=red];
		j3779346330 -> j4124905418;
	j754681339 [label="坐电梯。",shape=box,color=red];
		j754681339 -> j3505717561;
	j4124905418 [label="“你转身看了看地下城，心想‘我是不是傻，居然还想再进去。’”",shape=box,color=blue];
		j4124905418 -> j1848383742;
	j3505717561 [label="“你坐上电梯往上走。透过电梯的金属栅栏，你可以看到地下城的石墙正被越来越先进的科技所取代。你再次疑惑：‘我到底在哪儿？’”",shape=box,color=blue];
		j3505717561 -> j22056593;
	j1848383742 [label="哈哈……好吧，那坐电梯吧。",shape=box,color=red];
		j1848383742 -> j3505717561;
	j22056593 [label="“电梯停在一个大厅，里面充满咕哝作响的机器和巨大的管道。这是某种实验室吗？”",shape=box,color=blue];
		j22056593 -> j2165100853;
	j2165100853 [label="此时，走廊尽头的一间房间中，传来一名男子痛苦的惨叫声。",shape=box,color=blue];
		j2165100853 -> j3355777990;
		j2165100853 -> j1419443558;
	j3355777990 [label="忽略惨叫声，去找出路。",shape=box,color=red];
		j3355777990 -> j3258164397;
	j1419443558 [label="去找那名惨叫的男子。",shape=box,color=red];
		j1419443558 -> j3163122596;
	j3258164397 [label="“你在大厅里四处寻找值钱的东西，但那惨叫声越来越凄厉，让你无法忽视。你被吸引过去，心想得帮一下他。”",shape=box,color=blue];
		j3258164397 -> j3163122596;
	j3163122596 [label="“你沿着走廊，循着痛苦惨叫声走去。你走进一间宽敞的机械室，在那里看到了一名男子。一个相貌平平的男子，被绑在一台机器上。电流从他的指尖迸发而出，源源不断地为一台巨大的涡轮机供电。”",shape=box,color=blue];
		j3163122596 -> j3136179467;
		j3163122596 -> j211138346;
	j3136179467 [label="问他：“你怎么了？”",shape=box,color=red];
		j3136179467 -> j2499097766;
	j211138346 [label="检查这个男子。",shape=box,color=red];
		j211138346 -> j2499097766;
	j2499097766 [label="“这名男子被绑在一个高高的平台上，双臂张开。他的指尖连接着探针，这些探针扭结成一根粗大的电缆，连接着一台巨大的涡轮机。一道道电弧在他手中灵活地舞动。”",shape=box,color=blue];
		j2499097766 -> j3334470372;
	j3334470372 [label="在惨叫声和电击之间，男子艰难地吐出几个字：“关……掉……涡轮机！！”",shape=box,color=blue];
		j3334470372 -> j3184485814;
	j3184485814 [label="检查房间。",shape=box,color=red];
		j3184485814 -> j2892738176;
	j2892738176 [label="“你环顾房间，寻找有用的东西。你看到了一个放着工具的长凳。上面有一根撬棍、大型剪线钳、一个控制面板。”",shape=box,color=blue];
		j2892738176 -> j1571667540;
	j1571667540 [label="Check boolean WhatLoop",color=orange];
		j1571667540 -> j4289283942 [label=true,color=green];
		j1571667540 -> j1569507004 [label=false,color=brown];
