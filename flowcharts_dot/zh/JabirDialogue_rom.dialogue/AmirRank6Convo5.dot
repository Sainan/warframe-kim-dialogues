	"AmirRank6Convo5 begins." [color=orange];
		"AmirRank6Convo5 begins." -> j1508599291;
	j1508599291 [label="所以未来人……你来自未来，对吗？",shape=box,color=blue];
		j1508599291 -> j1438732242;
		j1508599291 -> j1925197936;
	j1438732242 [label="据我所知是的。",shape=box,color=red];
		j1438732242 -> j2416384793;
	j1925197936 [label="如果我们不深入探讨《永恒论》的话，那么是的，我来自未来。",shape=box,color=red];
		j1925197936 -> j2416384793;
	j2416384793 [label="跟我说说所有有关外星人的事",shape=box,color=blue];
		j2416384793 -> j3406995211;
		j2416384793 -> j2303068822;
	j3406995211 [label="你这话是什么意思？",shape=box,color=red];
		j3406995211 -> j1005429317;
	j2303068822 [label="扎兹诺格这位酒神能把你喝趴到桌子下面。",shape=box,color=red];
		j2303068822 -> j1308548071;
	j1005429317 [label="你知道的，外星人、不明飞行物，还有该死的探测器！",shape=box,color=blue];
		j1005429317 -> j4149878500;
		j1005429317 -> j1482842109;
	j1308548071 [label="哇哦！真的吗？他喝的什么？",shape=box,color=blue];
		j1308548071 -> j2593535004;
		j1308548071 -> j2354998912;
	j4149878500 [label="我真不忍心让你失望……",shape=box,color=red];
		j4149878500 -> j2919061464;
	j1482842109 [label="有 Sentient，但我敢肯定你指的不是这个。",shape=box,color=red];
		j1482842109 -> j3334297910;
	j2593535004 [label="主要是活塞油。他特别喜欢活塞油。",shape=box,color=red];
		j2593535004 -> j8341304;
	j2354998912 [label="格洛普白兰地",shape=box,color=red];
		j2354998912 -> j8341304;
	j2919061464 [label="不！",shape=box,color=blue];
		j2919061464 -> j337823560;
	j3334297910 [label="不过这些 sentient 最初来自地球",shape=box,color=blue];
		j3334297910 -> j386214215;
	j8341304 [label="哇哦……",shape=box,color=blue];
		j8341304 -> j2937370312;
	j337823560 [label="难道连一条来自遥远星系的信息都没有吗？",shape=box,color=blue];
		j337823560 -> j1663263450;
	j386214215 [label="我说的是星际飞船",shape=box,color=blue];
		j386214215 -> j2880907443;
	j2937370312 [label="等等？你在逗我吗？",shape=box,color=blue];
		j2937370312 -> j242884080;
		j2937370312 -> j391638475;
	j1663263450 [label="一句“你好”？？",shape=box,color=blue];
		j1663263450 -> j1070426560;
	j2880907443 [label="长相奇特的外星人以光速在星系中穿梭，结交朋友然后对抗反派",shape=box,color=blue];
		j2880907443 -> j2698995244;
	j242884080 [label="从不。",shape=box,color=red];
		j242884080 -> j2199108930;
	j391638475 [label="被抓住了。",shape=box,color=red];
		j391638475 -> j965888842;
	j1070426560 [label="在遥远的未来，一定有这些事情发生",shape=box,color=blue];
		j1070426560 -> j1825505093;
		j1070426560 -> j3145079322;
	j2698995244 [label="或者我不知道，所以我才问的",shape=box,color=blue];
		j2698995244 -> j3145079322;
		j2698995244 -> j1825505093;
	j2199108930 [label="哈哈……说真的",shape=box,color=blue];
		j2199108930 -> j3894614990;
	j965888842 [label="+5 Chemistry",color=orange];
		j965888842 -> j2199108930;
	j1825505093 [label="如果真有，也没人告诉过我。",shape=box,color=red];
		j1825505093 -> j3439367365;
	j3145079322 [label="如果奥罗金人发现了外星人，他们会对此保密。",shape=box,color=red];
		j3145079322 -> j3439367365;
	j3894614990 [label="一定有外星人，跟我讲讲他们的事，我必须知道",shape=box,color=blue];
		j3894614990 -> j1482842109;
		j3894614990 -> j4149878500;
	j3439367365 [label="那么这就是阴谋了",shape=box,color=blue];
		j3439367365 -> j3719481381;
	j3719481381 [label="我就知道",shape=box,color=blue];
		j3719481381 -> j400968143;
		j3719481381 -> j267493363;
	j400968143 [label="奥罗金的情况更糟，所以……",shape=box,color=red];
		j400968143 -> j2956164389;
	j267493363 [label="我不会说得那么绝对。",shape=box,color=red];
		j267493363 -> j2956164389;
	j2956164389 [label="真相就在那",shape=box,color=blue];
		j2956164389 -> j3261998717;
	j3261998717 [label="+5 Chemistry",color=orange];
		j3261998717 -> j1973999915;
	j1973999915 [label="嘟嘟嘟",shape=box,color=blue];
