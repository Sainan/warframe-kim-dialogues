		j3459900906 -> j524797526;
	j3316821453 [label="Boolean AmirConsentComplete is now true.",color=orange];
		j3316821453 -> "Chat ends.";
	j524797526 [label="我想跟你说件事，我想在事情还没到不可收拾的地步之前，先确定你能接受。",shape=box,color=red];
		j524797526 -> j560918068;
	j560918068 [label="我知道我们之前没有讨论过这件事。对我来说重要的是，你不会觉得我在用任何方式对你撒谎，或者对你不坦诚。",shape=box,color=red];
		j560918068 -> j3927418488;
	j3927418488 [label="呃呃怎么回事发生了什么你杀人了吗有人死了吗还是等等事情是不是比这更离奇肯定比这更离奇你在和那把吉他约会吗天啊",shape=box,color=blue];
		j3927418488 -> j4242276233;
		j3927418488 -> j2210631715;
	j4242276233 [label="我知道这听起来可能很奇怪——但这并不意味着我对你的感情有所减少。",shape=box,color=red];
		j4242276233 -> j4139400737;
	j2210631715 [label="好吧，至少，不是那把吉他……？听着，我知道这听起来可能很奇怪——但这并不意味着我对你的感情有所减少。",shape=box,color=red];
		j2210631715 -> j476949233;
	j4139400737 [label="抱歉我脑子里还想着你可能在和那把吉他约会等等我得重启",shape=box,color=blue];
		j4139400737 -> j3601294911;
	j476949233 [label="+5 Chemistry",color=orange];
		j476949233 -> j4139400737;
	j3601294911 [label="啊——好——了——我们可以接着说了。不好意思，你刚才想跟我说什么来着？",shape=box,color=blue];
		j3601294911 -> j82722199;
	j82722199 [label="你……在某个地方还有别的爱人？或者……在某个时候？那……应该不是六人组成员……对吧？……啊啊啊啊，那也太奇——怪了吧",shape=box,color=blue];
		j82722199 -> j1781562678;
	j1781562678 [label="这就像你跟我表妹莱拉交往一样 恶心恶心恶心恶心",shape=box,color=blue];
		j1781562678 -> j978271554;
		j1781562678 -> j1364851465;
	j978271554 [label="不，不是六人组成员。不是那把吉他。也不是你表妹。 ",shape=box,color=red];
		j978271554 -> j3146307925;
	j1364851465 [label="我不知道你还有个表妹。",shape=box,color=red];
		j1364851465 -> j3113944736;
	j3146307925 [label="好吧 所以那是什么 你还有其他恋情？！？！？！",shape=box,color=blue];
		j3146307925 -> j2134561651;
	j3113944736 [label="是啊 我想我们从没怎么聊过我的家人 我们有太多乱七八糟的其他事要聊 比如 你还有另一段恋情？！？！？！",shape=box,color=blue];
		j3113944736 -> j2134561651;
	j2134561651 [label="如果这件事让你心里不舒服，我能理解。而且我希望你知道，这并不意味着你在我心里的分量有所减少。",shape=box,color=red];
		j2134561651 -> j1803857581;
	j1803857581 [label="他不来自这里，我甚至不知道能不能或者该怎么介绍你们认识，但是……他对我来说也很重要。但你也是一样。",shape=box,color=red];
		j1803857581 -> j474999330;
	j474999330 [label="我知道这可能很难接受，如果你不能接受，我完全理解。我只是不想让你觉得我在骗你，或者瞒你什么。",shape=box,color=red];
		j474999330 -> j1372097384;
	j1372097384 [label="反反复复烦烦烦烦烦烦烦烦烦烦烦烦烦烦烦你哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈哈咩咩咩咩咩咩咩咩咩咩咩咩咩咩咩靠靠靠靠靠靠靠靠靠靠靠靠靠靠靠靠靠靠靠",shape=box,color=blue];
		j1372097384 -> j3428979951;
	j3428979951 [label="（那是我脑子短路的声音 顺便一说）",shape=box,color=blue];
		j3428979951 -> j669895393;
	j669895393 [label="你对我来说很重要，就，非常非常重要。我不想失去这份感情。我不知道。可以吧。嗯，好吧。我可以接受。我相信你。很显然他对你很重要，所以……可以。",shape=box,color=blue];
		j669895393 -> j1079793674;
	j1079793674 [label="这真的太奇怪了，但为什么所有好事都落在你身上，而我却要被困在这里",shape=box,color=blue];
		j1079793674 -> j375083100;
	j375083100 [label="+20 Chemistry",color=orange];
