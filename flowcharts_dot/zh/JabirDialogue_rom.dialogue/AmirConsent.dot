	j4241364667 [label="但说真的？我……我真的很相信你。你对我很重要，我很高兴你告诉我真相。我想如果你在这件事上骗我，那情况就完全不一样了，你懂吧？",shape=box,color=blue];
		j4241364667 -> j75416564;
	j3622714282 [label="但说真的？我……我愿意看看这会如何发展。我会相信你。很高兴你告诉我真相。我想如果你在这件事上骗我，那情况就完全不一样了，你懂吧？",shape=box,color=blue];
