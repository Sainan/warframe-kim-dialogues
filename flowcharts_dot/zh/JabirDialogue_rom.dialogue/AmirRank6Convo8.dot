		4377 -> 4380;
	4378 [label="+5 Chemistry",color=orange];
		4378 -> 4381;
	4379 [label="Chat ends.",color=orange];
	4380 [label="哦……准备好了",shape=box,color=blue];
		4380 -> 4382;
	4381 [label="这我不会怪你，他确实挺迷人的",shape=box,color=blue];
		4381 -> 4382;
	4382 [label="那我开始了",shape=box,color=blue];
		4382 -> 4383;
	4383 [label="“你和已经重获自由的扎比尔站在电气实验室中央。他看着你，说道：‘没时间了，跟我来。’”",shape=box,color=blue];
		4383 -> 4384;
	4384 [label="“他带你穿过一条又一条走廊。他对这颗小行星了如指掌，清楚每一名守卫和他们的动向。”",shape=box,color=blue];
		4384 -> 4385;
		4384 -> 4386;
		4384 -> 4387;
	4385 [label="向扎比尔询问老鼠的事情。",shape=box,color=red];
		4385 -> 4388;
	4386 [label="他也是囚犯吗？",shape=box,color=red];
		4386 -> 4389;
	4387 [label="扎比尔要带我去哪里？",shape=box,color=red];
		4387 -> 4390;
	4388 [label="“扎比尔听后大吃一惊。‘老鼠找到你了？太棒了。居然成了。看这个。’扎比尔举起一只精致的金哨子。‘这是鼠后给我的。我们得去找她。’”",shape=box,color=blue];
		4388 -> 4391;
	4389 [label="“你问扎比尔是怎么到这里来的，‘现在没空说这些，’他说，‘我们先想办法逃出去。’”",shape=box,color=blue];
		4389 -> 4385;
		4389 -> 4387;
	4390 [label="“扎比尔回头看了你一眼：‘带你去机库。我们偷一艘船，能逃多远逃多远。然后去找鼠后。’”",shape=box,color=blue];
		4390 -> 4391;
	4391 [label="鼠后？",shape=box,color=red];
		4391 -> 4392;
	4392 [label="“‘她给了我这个哨子。老鼠们都听它的。她是我的朋友。虽然她有时候不太友好，但她很关心我。’”",shape=box,color=blue];
		4392 -> 4393;
		4392 -> 4394;
	4393 [label="你有没有把这个给莱蒂看过？",shape=box,color=red];
		4393 -> 4395;
	4394 [label="怎么听着她也有点耳熟。",shape=box,color=red];
		4394 -> 4396;
	4395 [label="我还挺惜命的，才不会冒这个险",shape=box,color=blue];
		4395 -> 4397;
	4396 [label="如有雷同，纯属巧合",shape=box,color=blue];
		4396 -> 4397;
	4397 [label="“在扎比尔的帮助下，你们在小行星的走廊间一路曲折穿行。他巧妙地避开了守卫和监控摄像头。”",shape=box,color=blue];
		4397 -> 4398;
	4398 [label="“最后，你们来到一扇大门前。扎比尔示意你低下身子。你们俩一起蹲下，潜入飞船的机库。”",shape=box,color=blue];
		4398 -> 4399;
	4399 [label="“你蹲在一根柱子的阴影中。能听到附近 Grineer 守卫的声音。”",shape=box,color=blue];
		4399 -> 4400;
	4400 [label="“你打算怎么办？”",shape=box,color=blue];
		4400 -> 4401;
		4400 -> 4402;
	4401 [label="冲上去打。",shape=box,color=red];
		4401 -> 4403;
	4402 [label="环顾四周。",shape=box,color=red];
		4402 -> 4404;
	4403 [label="“毫无自保意识，也没有一丝犹豫，你冲进了空旷的地方。对面的一群守卫开始扫射。密集弹雨迎面而至，你当场毙命。扎比尔对你这种愚蠢的莽夫行为摇了摇头。”",shape=box,color=blue];
		4403 -> 4405;
	4404 [label="“你探头从拐角处往下看，仔细观察了一下周围的环境。”",shape=box,color=blue];
		4404 -> 4406;
	4405 [label="要不要再试一次，然后这次别一开始就被秒杀了？",shape=box,color=blue];
		4405 -> 4407;
		4405 -> 4408;
	4406 [label="“机库中央停着一艘航道星舰。通往航道星舰的舷梯被一名守卫挡住了。机库一侧，有十来个 Grineer 正热火朝天地玩骰子游戏。距离你几步远，有一张配有控制面板的桌子。”",shape=box,color=blue];
		4406 -> 4409;
	4407 [label="好。",shape=box,color=red];
		4407 -> 4410;
	4408 [label="今天就到这里吧。[结束]",shape=box,color=red];
		4408 -> 4411;
	4409 [label="“‘要想出去，得先打开机库的大门，’扎比尔低声说道。”",shape=box,color=blue];
		4409 -> 4412;
	4410 [label="“这次你打算怎么办？”",shape=box,color=blue];
		4410 -> 4413;
		4410 -> 4402;
	4411 [label="Chat ends.",color=orange];
	4412 [label="“扎比尔看着你。‘有什么好主意吗？’”",shape=box,color=blue];
		4412 -> 4414;
		4412 -> 4412;
	4413 [label="……勘察一下周围？",shape=box,color=red];
		4413 -> 4404;
