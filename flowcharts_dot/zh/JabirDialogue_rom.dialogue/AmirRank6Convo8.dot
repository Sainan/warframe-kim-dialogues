	j45394037 [label="这可是你的损失",shape=box,color=blue];
		j45394037 -> "Chat ends.";
	j3268262703 [label="+5 Chemistry",color=orange];
		j3268262703 -> j1527349261;
	j3445307647 [label="+5 Chemistry",color=orange];
		j3445307647 -> j2449325480;
	j1527349261 [label="哦……准备好了",shape=box,color=blue];
		j1527349261 -> j1187865802;
	j2449325480 [label="这我不会怪你，他确实挺迷人的",shape=box,color=blue];
		j2449325480 -> j1187865802;
	j1187865802 [label="那我开始了",shape=box,color=blue];
		j1187865802 -> j1902083367;
	j1902083367 [label="“你和已经重获自由的扎比尔站在电气实验室中央。他看着你，说道：‘没时间了，跟我来。’”",shape=box,color=blue];
		j1902083367 -> j3211029330;
	j3211029330 [label="“他带你穿过一条又一条走廊。他对这颗小行星了如指掌，清楚每一名守卫和他们的动向。”",shape=box,color=blue];
		j3211029330 -> j1175736229;
		j3211029330 -> j614527856;
		j3211029330 -> j2255800484;
	j1175736229 [label="向扎比尔询问老鼠的事情。",shape=box,color=red];
		j1175736229 -> j3156511334;
	j614527856 [label="他也是囚犯吗？",shape=box,color=red];
		j614527856 -> j2746601232;
	j2255800484 [label="扎比尔要带我去哪里？",shape=box,color=red];
		j2255800484 -> j1960205667;
	j3156511334 [label="“扎比尔听后大吃一惊。‘老鼠找到你了？太棒了。居然成了。看这个。’扎比尔举起一只精致的金哨子。‘这是鼠后给我的。我们得去找她。’”",shape=box,color=blue];
		j3156511334 -> j2332770001;
	j2746601232 [label="“你问扎比尔是怎么到这里来的，‘现在没空说这些，'他说，‘我们先想办法逃出去。'”",shape=box,color=blue];
		j2746601232 -> j1175736229;
		j2746601232 -> j2255800484;
	j1960205667 [label="“扎比尔回头看了你一眼：‘带你去机库。我们偷一艘船，能逃多远逃多远。然后去找鼠后。’”",shape=box,color=blue];
		j1960205667 -> j2332770001;
	j2332770001 [label="鼠后？",shape=box,color=red];
		j2332770001 -> j307389198;
	j307389198 [label="“‘她给了我这个哨子。老鼠们都听它的。她是我的朋友。虽然她有时候不太友好，但她很关心我。’”",shape=box,color=blue];
		j307389198 -> j1475970971;
		j307389198 -> j3870483462;
	j1475970971 [label="你有没有把这个给莱蒂看过？",shape=box,color=red];
		j1475970971 -> j2558596626;
	j3870483462 [label="怎么听着她也有点耳熟。",shape=box,color=red];
		j3870483462 -> j1419189749;
	j2558596626 [label="我还挺惜命的，才不会冒这个险",shape=box,color=blue];
		j2558596626 -> j1827773340;
	j1419189749 [label="如有雷同，纯属巧合",shape=box,color=blue];
		j1419189749 -> j1827773340;
	j1827773340 [label="“在扎比尔的帮助下，你们在小行星的走廊间一路曲折穿行。他巧妙地避开了守卫和监控摄像头。”",shape=box,color=blue];
		j1827773340 -> j2861407790;
	j2861407790 [label="“最后，你们来到一扇大门前。扎比尔示意你低下身子。你们俩一起蹲下，潜入飞船的机库。”",shape=box,color=blue];
		j2861407790 -> j1102319100;
	j1102319100 [label="“你蹲在一根柱子的阴影中。能听到附近 Grineer 守卫的声音。”",shape=box,color=blue];
		j1102319100 -> j2396063175;
	j2396063175 [label="“你打算怎么办？”",shape=box,color=blue];
		j2396063175 -> j695026684;
		j2396063175 -> j790056039;
	j695026684 [label="冲上去打。",shape=box,color=red];
		j695026684 -> j3661665942;
	j790056039 [label="环顾四周。",shape=box,color=red];
		j790056039 -> j4141115343;
	j3661665942 [label="“毫无自保意识，也没有一丝犹豫，你冲进了空旷的地方。对面的一群守卫开始扫射。密集弹雨迎面而至，你当场毙命。扎比尔对你这种愚蠢的莽夫行为摇了摇头。”",shape=box,color=blue];
		j3661665942 -> j3795895387;
	j4141115343 [label="“你探头从拐角处往下看，仔细观察了一下周围的环境。”",shape=box,color=blue];
		j4141115343 -> j3070974502;
	j3795895387 [label="要不要再试一次，然后这次别一开始就被秒杀了？",shape=box,color=blue];
		j3795895387 -> j3897394590;
		j3795895387 -> j2251030969;
	j3070974502 [label="“机库中央停着一艘航道星舰。通往航道星舰的舷梯被一名守卫挡住了。机库一侧，有十来个 Grineer 正热火朝天地玩骰子游戏。距离你几步远，有一张配有控制面板的桌子。”",shape=box,color=blue];
		j3070974502 -> j1546766936;
	j3897394590 [label="好。",shape=box,color=red];
		j3897394590 -> j2410489491;
	j2251030969 [label="今天就到这里吧。[结束]",shape=box,color=red];
		j2251030969 -> "Chat ends.";
	j1546766936 [label="“‘要想出去，得先打开机库的大门，'扎比尔低声说道。”",shape=box,color=blue];
		j1546766936 -> j172003812;
	j2410489491 [label="“这次你打算怎么办？”",shape=box,color=blue];
		j2410489491 -> j1986887581;
		j2410489491 -> j790056039;
	j172003812 [label="“扎比尔看着你。‘有什么好主意吗？’”",shape=box,color=blue];
		j172003812 -> j774369477;
		j172003812 -> j172003812;
	j1986887581 [label="……勘察一下周围？",shape=box,color=red];
		j1986887581 -> j4141115343;
