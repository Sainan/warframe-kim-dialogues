	4451 [label="Update boolean HangarDoorsOpen",color=orange];
		4451 -> 4456;
	4449 [label="再试一次？这次让扎比尔活下来？",shape=box,color=blue];
		4449 -> 4452;
		4449 -> 4453;
	4455 [label="“你感觉到机会来了，并冲向航道星舰。”",shape=box,color=blue];
		4455 -> 4459;
	4454 [label="“扎比尔向你挥手，示意你打开机库门。”",shape=box,color=blue];
		4454 -> 4442;
	4456 [label="Check boolean RampGuardZapped",color=orange];
		4456 -> 4455 [label=true,color=green];
		4456 -> 4460 [label=false,color=brown];
	4452 [label="我保证这次不会让你挂了。",shape=box,color=red];
		4452 -> 4457;
	4453 [label="我想我们可以先玩到这里。[结束]",shape=box,color=red];
		4453 -> 4458;
	4459 [label="“你看着扎比尔说，‘希望你会开这玩意，’扎比尔说，‘我不会，不过你会啊。’”",shape=box,color=blue];
		4459 -> 4462;
	4460 [label="“扎比尔指了指舷梯守卫。”",shape=box,color=blue];
		4460 -> 4441;
	4457 [label="Update boolean KeepZabirAlive",color=orange];
		4457 -> 4414;
	4458 [label="你可真折磨死我了",shape=box,color=blue];
		4458 -> 4461;
	4462 [label="“你启动飞船，正要按下按钮收起舷梯并关上门时，扎比尔说，‘等等！我们不能丢下它们。’”",shape=box,color=blue];
		4462 -> 4463;
		4462 -> 4464;
	4461 [label="Chat ends.",color=orange];
	4463 [label="你说得对，我们得去救它们。",shape=box,color=red];
		4463 -> 4465;
	4464 [label="求你了，不要。我们真的应该留下它们。",shape=box,color=red];
		4464 -> 4466;
	4465 [label="“扎比尔举起哨子吹了一声。”",shape=box,color=blue];
		4465 -> 4467;
	4466 [label="“‘驳回！’扎比尔说。”",shape=box,color=blue];
		4466 -> 4465;
	4467 [label="“几秒钟后，成群的老鼠涌上飞船。扎比尔转头朝你大喊：‘走！’”",shape=box,color=blue];
		4467 -> 4468;
	4468 [label="“飞船升空了。Grineer 疯狂扫射，但子弹在坚固的航道星舰冲出机库时，全部被弹开。”",shape=box,color=blue];
		4468 -> 4469;
	4469 [label="“当老鼠在舰桥上四处乱窜，你望向浩瀚的太空，然后你信心满满地说，‘航道驱舰，启动。’与此同时，航道星舰一闪而过，消失在远方。”",shape=box,color=blue];
		4469 -> 4470;
	4470 [label="“完结。”",shape=box,color=blue];
		4470 -> 4471;
	4471 [label="哇哦。",shape=box,color=red];
		4471 -> 4472;
	4472 [label="那，你觉得结局怎么样？是不是太疯了？",shape=box,color=blue];
		4472 -> 4473;
		4472 -> 4474;
	4473 [label="我无话可说。",shape=box,color=red];
		4473 -> 4475;
	4474 [label="是的，我很喜欢它。",shape=box,color=red];
		4474 -> 4476;
	4475 [label="我还收到过更差的评价",shape=box,color=blue];
		4475 -> 4477;
	4476 [label="呼，我还担心我把剧情写得太疯了",shape=box,color=blue];
		4476 -> 4477;
	4477 [label="话说，关于库存盘点。",shape=box,color=red];
		4477 -> 4478;
	4478 [label="哦那件事？",shape=box,color=blue];
