	4373 [label="现在不行，抱歉。[结束]",shape=box,color=red];
		4373 -> 4376;
	4374 [label="如果你的游戏准备好了，那我也准备好了。",shape=box,color=red];
		4374 -> 4377;
	4375 [label="我想多了解一下那个帅气的扎比尔。看来你有竞争对手了。",shape=box,color=red];
		4375 -> 4378;
	4372 [label="Chat ends. Next chat will be AmirRank6Convo3.",color=orange];
