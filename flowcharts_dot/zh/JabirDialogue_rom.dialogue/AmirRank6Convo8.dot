		j2662935952 -> j2510635899 [label=false,color=brown];
	j2510635899 [label="咱们用那个老鼠哨子吧。",shape=box,color=red];
		j2510635899 -> j1367335945;
	j1707091392 [label="使用控制面板。",shape=box,color=red];
		j1707091392 -> j1398257888;
	j49674756 [label="冲去航道星舰。",shape=box,color=red];
		j49674756 -> j462149636;
	j3916342922 [label="让扎比尔去攻击舷梯守卫。",shape=box,color=red];
		j3916342922 -> j664511161;
	j1367335945 [label="“扎比尔拿起哨子，吹出一个长音。你什么也听不到，只有呼吸声。你们坐等了一会，但什么也没发生。没有老鼠，什么也没出现。扎比尔耸了耸肩。”",shape=box,color=blue];
		j1367335945 -> j1050877937;
	j1398257888 [label="“你来到控制面板前，但被一名警觉的守卫发现了。你试图举起双手投降，结果他们还是开枪打死了你，因为 Grineer 就是这么狠。”",shape=box,color=blue];
		j1398257888 -> j1690139243;
		j1398257888 -> j4227407256;
	j462149636 [label="“你冲向飞船，但舷梯的守卫发现了你并向你开火。你的这一天，乃至你的人生，就这样痛苦地结束了。”",shape=box,color=blue];
		j462149636 -> j1690139243;
		j462149636 -> j3650263195;
	j664511161 [label="哦当然，有危险的时候就知道推阿米尔出去",shape=box,color=blue];
		j664511161 -> j2818020256;
	j1050877937 [label="“突然，你听到一阵嘎吱嘎吱的声音，像在啃东西。突然间，老鼠从机库周围的通风口窜了出来。Grineer 守卫尖叫得像小学生一样，然后乱枪扫射。子弹四处乱飞。”",shape=box,color=blue];
		j1050877937 -> j3344438637;
	j1690139243 [label="我需要休息一下。[结束]",shape=box,color=red];
		j1690139243 -> j3604831743;
	j4227407256 [label="再来一次。",shape=box,color=red];
		j4227407256 -> j318932394;
	j3650263195 [label="再来一次！",shape=box,color=red];
		j3650263195 -> j1595881847;
	j2818020256 [label="我是说扎比尔",shape=box,color=blue];
		j2818020256 -> j2215656072;
	j3344438637 [label="“老鼠分散了守卫的注意力。现在怎么办？”",shape=box,color=blue];
		j3344438637 -> j2374376113;
		j3344438637 -> j4175829390;
	j3604831743 [label="你会回来的",shape=box,color=blue];
		j3604831743 -> "Chat ends.";
	j318932394 [label="Boolean OneMoreTime is now true.",color=orange];
		j318932394 -> j774369477;
	j1595881847 [label="Boolean Again is now true.",color=orange];
		j1595881847 -> j774369477;
	j2215656072 [label="行吧",shape=box,color=blue];
		j2215656072 -> j132697163;
	j2374376113 [label="让扎比尔去电舷梯守卫！",shape=box,color=red];
		j2374376113 -> j277233552;
	j4175829390 [label="用控制面板打开门。",shape=box,color=red];
		j4175829390 -> j3827145831;
	j132697163 [label="“你一边指着舷梯守卫，一边大喊‘扎比尔，干掉他！'”",shape=box,color=blue];
		j132697163 -> j3559237387;
	j277233552 [label="“扎比尔冲向守卫，电了他一下。对方瘫软倒地。”",shape=box,color=blue];
		j277233552 -> j3028613594;
	j3827145831 [label="“你悄悄溜到控制台，试图操作控制台，同时尽量藏好自己。你成功启动了机库大门的开关。”",shape=box,color=blue];
		j3827145831 -> j1820069768;
	j3559237387 [label="“明知这不是明智之举，扎比尔还是勇敢地冲了进去。但即使他再快，也没能瞒过守卫的眼睛。守卫开枪射击，扎比尔不幸身亡。”",shape=box,color=blue];
		j3559237387 -> j3640256834;
	j3028613594 [label="Boolean RampGuardZapped is now true.",color=orange];
		j3028613594 -> j1915017362;
	j1820069768 [label="“守卫们正被老鼠吸引注意，根本没注意到你。”",shape=box,color=blue];
		j1820069768 -> j256735146;
	j3640256834 [label="游戏结束",shape=box,color=blue];
		j3640256834 -> j3737136848;
	j1915017362 [label="Check boolean HangarDoorsOpen",color=orange];
		j1915017362 -> j589798185 [label=true,color=green];
		j1915017362 -> j733608371 [label=false,color=brown];
	j256735146 [label="Boolean HangarDoorsOpen is now true.",color=orange];
		j256735146 -> j1087431613;
	j3737136848 [label="再试一次？这次让扎比尔活下来？",shape=box,color=blue];
		j3737136848 -> j3666397411;
		j3737136848 -> j1195912243;
	j589798185 [label="“你感觉到机会来了，并冲向航道星舰。”",shape=box,color=blue];
		j589798185 -> j485601451;
	j733608371 [label="“扎比尔向你挥手，示意你打开机库门。”",shape=box,color=blue];
		j733608371 -> j4175829390;
	j1087431613 [label="Check boolean RampGuardZapped",color=orange];
		j1087431613 -> j589798185 [label=true,color=green];
		j1087431613 -> j348005301 [label=false,color=brown];
	j3666397411 [label="我保证这次不会让你挂了。",shape=box,color=red];
		j3666397411 -> j769413847;
	j1195912243 [label="我想我们可以先玩到这里。[结束]",shape=box,color=red];
		j1195912243 -> j3663116621;
	j485601451 [label="“你看着扎比尔说，‘希望你会开这玩意，'扎比尔说，‘我不会，不过你会啊。'”",shape=box,color=blue];
		j485601451 -> j2301871544;
	j348005301 [label="“扎比尔指了指舷梯守卫。”",shape=box,color=blue];
		j348005301 -> j2374376113;
	j769413847 [label="Boolean KeepZabirAlive is now true.",color=orange];
		j769413847 -> j774369477;
	j3663116621 [label="你可真折磨死我了",shape=box,color=blue];
		j3663116621 -> "Chat ends.";
	j2301871544 [label="“你启动飞船，正要按下按钮收起舷梯并关上门时，扎比尔说，‘等等！我们不能丢下它们。'”",shape=box,color=blue];
		j2301871544 -> j3090225445;
		j2301871544 -> j926161937;
	j3090225445 [label="你说得对，我们得去救它们。",shape=box,color=red];
		j3090225445 -> j3461288493;
	j926161937 [label="求你了，不要。我们真的应该留下它们。",shape=box,color=red];
		j926161937 -> j2518883680;
	j3461288493 [label="“扎比尔举起哨子吹了一声。”",shape=box,color=blue];
		j3461288493 -> j2652945839;
	j2518883680 [label="“‘驳回！’扎比尔说。”",shape=box,color=blue];
		j2518883680 -> j3461288493;
	j2652945839 [label="“几秒钟后，成群的老鼠涌上飞船。扎比尔转头朝你大喊：‘走！’”",shape=box,color=blue];
		j2652945839 -> j3295825715;
	j3295825715 [label="“飞船升空了。Grineer 疯狂扫射，但子弹在坚固的航道星舰冲出机库时，全部被弹开。”",shape=box,color=blue];
		j3295825715 -> j3192512016;
	j3192512016 [label="“当老鼠在舰桥上四处乱窜，你望向浩瀚的太空，然后你信心满满地说，‘航道驱舰，启动。'与此同时，航道星舰一闪而过，消失在远方。”",shape=box,color=blue];
		j3192512016 -> j3125095894;
	j3125095894 [label="“完结。”",shape=box,color=blue];
		j3125095894 -> j3770776877;
	j3770776877 [label="哇哦。",shape=box,color=red];
		j3770776877 -> j653074113;
	j653074113 [label="那，你觉得结局怎么样？是不是太疯了？",shape=box,color=blue];
		j653074113 -> j2056277040;
		j653074113 -> j2636684249;
	j2056277040 [label="我无话可说。",shape=box,color=red];
		j2056277040 -> j3229277609;
