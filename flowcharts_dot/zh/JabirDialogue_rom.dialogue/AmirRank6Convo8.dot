	4423 [label="咱们用那个老鼠哨子吧。",shape=box,color=red];
		4423 -> 4427;
	4421 [label="使用控制面板。",shape=box,color=red];
		4421 -> 4425;
	4424 [label="冲去航道星舰。",shape=box,color=red];
		4424 -> 4428;
	4422 [label="让扎比尔去攻击舷梯守卫。",shape=box,color=red];
		4422 -> 4426;
	4427 [label="“扎比尔拿起哨子，吹出一个长音。你什么也听不到，只有呼吸声。你们坐等了一会，但什么也没发生。没有老鼠，什么也没出现。扎比尔耸了耸肩。”",shape=box,color=blue];
		4427 -> 4432;
	4425 [label="“你来到控制面板前，但被一名警觉的守卫发现了。你试图举起双手投降，结果他们还是开枪打死了你，因为 Grineer 就是这么狠。”",shape=box,color=blue];
		4425 -> 4429;
		4425 -> 4430;
	4428 [label="“你冲向飞船，但舷梯的守卫发现了你并向你开火。你的这一天，乃至你的人生，就这样痛苦地结束了。”",shape=box,color=blue];
		4428 -> 4429;
		4428 -> 4433;
	4426 [label="哦当然，有危险的时候就知道推阿米尔出去",shape=box,color=blue];
		4426 -> 4431;
	4432 [label="“突然，你听到一阵嘎吱嘎吱的声音，像在啃东西。突然间，老鼠从机库周围的通风口窜了出来。Grineer 守卫尖叫得像小学生一样，然后乱枪扫射。子弹四处乱飞。”",shape=box,color=blue];
		4432 -> 4437;
	4429 [label="我需要休息一下。[结束]",shape=box,color=red];
		4429 -> 4434;
	4430 [label="再来一次。",shape=box,color=red];
		4430 -> 4435;
	4433 [label="再来一次！",shape=box,color=red];
		4433 -> 4438;
	4431 [label="我是说扎比尔",shape=box,color=blue];
		4431 -> 4436;
	4437 [label="“老鼠分散了守卫的注意力。现在怎么办？”",shape=box,color=blue];
		4437 -> 4441;
		4437 -> 4442;
	4434 [label="你会回来的",shape=box,color=blue];
		4434 -> 4439;
	4435 [label="Update boolean OneMoreTime",color=orange];
		4435 -> 4414;
	4438 [label="Update boolean Again",color=orange];
		4438 -> 4414;
	4436 [label="行吧",shape=box,color=blue];
		4436 -> 4440;
	4441 [label="让扎比尔去电舷梯守卫！",shape=box,color=red];
		4441 -> 4444;
	4442 [label="用控制面板打开门。",shape=box,color=red];
		4442 -> 4445;
	4439 [label="Chat ends.",color=orange];
	4440 [label="“你一边指着舷梯守卫，一边大喊‘扎比尔，干掉他！’”",shape=box,color=blue];
		4440 -> 4443;
	4444 [label="“扎比尔冲向守卫，电了他一下。对方瘫软倒地。”",shape=box,color=blue];
		4444 -> 4447;
	4445 [label="“你悄悄溜到控制台，试图操作控制台，同时尽量藏好自己。你成功启动了机库大门的开关。”",shape=box,color=blue];
		4445 -> 4448;
	4443 [label="“明知这不是明智之举，扎比尔还是勇敢地冲了进去。但即使他再快，也没能瞒过守卫的眼睛。守卫开枪射击，扎比尔不幸身亡。”",shape=box,color=blue];
		4443 -> 4446;
	4447 [label="Update boolean RampGuardZapped",color=orange];
		4447 -> 4450;
	4448 [label="“守卫们正被老鼠吸引注意，根本没注意到你。”",shape=box,color=blue];
		4448 -> 4451;
	4446 [label="游戏结束",shape=box,color=blue];
		4446 -> 4449;
