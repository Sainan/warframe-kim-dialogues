	4204 [label="Update boolean BrutalDeath3",color=orange];
		4204 -> 4124;
	4205 [label="Chat ends.",color=orange];
	4206 [label="“你发现自己在一个空荡荡的大房间里。也许是个地窖？唯一值得注意的是一扇沉重的金属门。”",shape=box,color=blue];
		4206 -> 4207;
		4206 -> 4208;
