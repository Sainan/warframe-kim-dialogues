		4207 -> 4209;
	4208 [label="我能开门吗？",shape=box,color=red];
		4208 -> 4209;
	4209 [label="“门是锁着的。”",shape=box,color=blue];
		4209 -> 4210;
	4210 [label="“你开始注意到一种微弱的声音。是……吱吱声吗？”",shape=box,color=blue];
		4210 -> 4211;
		4210 -> 4212;
	4211 [label="别告诉我是老鼠。",shape=box,color=red];
		4211 -> 4213;
	4212 [label="是老鼠吧？",shape=box,color=red];
		4212 -> 4213;
	4213 [label="就是该死的老鼠！！",shape=box,color=blue];
		4213 -> 4214;
	4214 [label="我是说……",shape=box,color=blue];
		4214 -> 4215;
	4215 [label="“吱吱声越来越大，接着是爪子拍打石头的嗒嗒声。突然，你的火把投射出一片阴影。一只猫……不……狗那么大的老鼠向你冲来。”",shape=box,color=blue];
		4215 -> 4216;
	4216 [label="“但不只它一只，它们从四面八方涌来。”",shape=box,color=blue];
		4216 -> 4217;
		4216 -> 4218;
		4216 -> 4219;
	4217 [label="跟鼠群拼了。",shape=box,color=red];
		4217 -> 4220;
	4218 [label="向它们挥舞我的火把。",shape=box,color=red];
		4218 -> 4220;
	4219 [label="你给莱蒂看过这部分内容吗？",shape=box,color=red];
		4219 -> 4221;
	4220 [label="“老鼠包围了你。你站了起来，准备战斗，但它们没有攻击。相反，最大的那只向你弯下了脖子。你发现它戴着一条项链。银链滑落，掉在地上。老鼠好像在说：‘这是给你的。‘ ”",shape=box,color=blue];
		4220 -> 4222;
		4220 -> 4223;
	4221 [label="没有，我也不打算给她看",shape=box,color=blue];
		4221 -> 4224;
	4222 [label="捡起项链。",shape=box,color=red];
		4222 -> 4225;
	4223 [label="问问那只老鼠是谁给了他项链？",shape=box,color=red];
		4223 -> 4226;
	4224 [label="老鼠向你扑来，你有什么打算？",shape=box,color=blue];
		4224 -> 4217;
		4224 -> 4218;
	4225 [label="“你拿起项链。项链上有钥匙。”",shape=box,color=blue];
		4225 -> 4227;
	4226 [label="“老鼠不会说话。毕竟它是只老鼠。”",shape=box,color=blue];
		4226 -> 4227;
	4227 [label="\"老鼠们转身一溜烟跑了。给他们钥匙的人知道你在下面，只有一个人有这样的能力……Lotus。” ",shape=box,color=blue];
		4227 -> 4228;
	4228 [label="钥匙？它能打开那扇门吗？",shape=box,color=red];
		4228 -> 4229;
	4229 [label="“你把钥匙插进门里，门开了。门那边的强光射进来，你痛苦地眯起眼睛。你简直不敢相信眼前的一切……”",shape=box,color=blue];
		4229 -> 4230;
