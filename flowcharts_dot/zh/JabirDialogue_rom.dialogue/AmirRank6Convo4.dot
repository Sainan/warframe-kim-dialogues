		4123 -> 4126 [label=true,color=green];
		4123 -> 4127 [label=false,color=brown];
	4124 [label="“你小心翼翼地溜出牢房。你的右边是一扇大门，那是出口。门只开了一条缝。你听到很多 Grineer 守卫在另一边窸窸窣窣。你的左边是地牢大厅，但是太黑了，看不清。”",shape=box,color=blue];
		4124 -> 4128;
	4125 [label="好吧",shape=box,color=blue];
		4125 -> 4129;
	4126 [label="“你再次搜查守卫的尸体，但没有发现任何有价值的东西。你想吃那块发霉的饼干，但你闻到了它的味道，便很快改变了主意。”",shape=box,color=blue];
		4126 -> 4130;
	4127 [label="“你在守卫身上翻找有没有值钱的东西。除了一块打火石和一块发霉的饼干，什么都没有。你拿走了打火石。”",shape=box,color=blue];
