	4114 [label="是啊 是啊",shape=box,color=blue];
		4114 -> 4117;
	4115 [label="“你站在牢房里看着刚被你杀死的 Grineer 的尸体。他临死前的话一直在你耳边响起，‘你永远找不到 Lotus’。”",shape=box,color=blue];
