		4146 -> 4153 [label=false,color=brown];
	4147 [label="“你脑海深处有个声音在说：‘嘿，蠢货，这是你最后的机会了。这守卫身上还是没有好东西。别胡闹了。’”",shape=box,color=blue];
		4147 -> 4154;
