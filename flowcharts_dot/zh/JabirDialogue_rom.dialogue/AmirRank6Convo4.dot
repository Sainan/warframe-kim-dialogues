		j1175397331 -> j183157388 [label=true,color=green];
		j1175397331 -> j2619078221 [label=false,color=brown];
	j316638822 [label="“你脑海深处有个声音在说：‘嘿，蠢货，这是你最后的机会了。这守卫身上还是没有好东西。别胡闹了。’”",shape=box,color=blue];
		j316638822 -> j2946575703;
	j113254323 [label="“你拿起火把，希望火焰不会熄灭。你经过走廊。经过空荡荡的牢房。每一间都和上一间一样荒芜。”",shape=box,color=blue];
		j113254323 -> j468103781;
	j3222770523 [label="“你在黑暗中摸索，寻找着……什么……每走一步，你都感到更加迷茫。突然，你被一个边界绊倒了。”",shape=box,color=blue];
		j3222770523 -> j324839033;
