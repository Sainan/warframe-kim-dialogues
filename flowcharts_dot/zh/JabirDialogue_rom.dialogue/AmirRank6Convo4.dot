		j2946575703 -> j2681815718;
	j468103781 [label="“当你小心翼翼地爬向大厅尽头时，火把的光亮开始在你面前显现出一个黑暗的深渊。你站在一个蓄水池上方。向下望去，你看不到底部。要不是有火把你肯定会摔个狗吃屎。”",shape=box,color=blue];
		j468103781 -> j2241119208;
