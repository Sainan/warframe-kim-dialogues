	j3627824781 [label="就因为我表现得像台电脑，把大部分时间都花在电脑上……嗯…… ",shape=box,color=blue];
		j3627824781 -> j2140824670;
	j1521155866 [label="好吧，我想知道接下来的文字冒险游戏有什么内容。",shape=box,color=red];
