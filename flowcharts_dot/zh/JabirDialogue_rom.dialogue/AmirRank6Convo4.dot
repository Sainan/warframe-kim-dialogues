		4197 -> 4202;
	4195 [label="Chat ends.",color=orange];
	4198 [label="“你蹲下来，进入隧道。痛苦地慢慢爬行，似乎永远都爬不完。这里又冷又湿，而且非常非常脏。”",shape=box,color=blue];
		4198 -> 4203;
