		j3440532661 -> j2828911590;
	j3059614825 [label="就这？？我才刚开始投入。",shape=box,color=red];
		j3059614825 -> j3936802210;
	j3730992480 [label="太棒了。所以你现在要不要去盘点库存？",shape=box,color=red];
		j3730992480 -> j4038485984;
	j2828911590 [label="打火石是做什么用的？我以为我的火把要熄灭了。",shape=box,color=red];
