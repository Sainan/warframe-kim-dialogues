		j1860162822 -> j46106887;
	j1038537987 [label="拜托，这是用来通风的，即使是中世纪幻想生物 Grineer 也是需要新鲜空气的",shape=box,color=blue];
		j1038537987 -> j1864535153;
	j656598015 [label="“到处都是血迹斑斑。显然，其他曾经的囚犯尝试过一些不太……有效的方法。所以从他们致命的试验和错误中，你可以推断出该怎么做！”",shape=box,color=blue];
		j656598015 -> j113254323;
	j2091874412 [label="算了。你到底还想不想去？哈哈",shape=box,color=blue];
		j2091874412 -> j301997489;
		j2091874412 -> j1205092685;
	j2476629475 [label="里面最好别有什么恐怖的东西。",shape=box,color=red];
		j2476629475 -> j2962817931;
	j46106887 [label="我要一头扎进去！",shape=box,color=red];
		j46106887 -> j2962817931;
	j1864535153 [label="“你想干嘛？”",shape=box,color=blue];
		j1864535153 -> j2108549421;
		j1864535153 -> j4131971651;
	j301997489 [label="……想去。",shape=box,color=red];
		j301997489 -> j336556103;
	j1205092685 [label="我先撤了。[结束]",shape=box,color=red];
		j1205092685 -> j3331344489;
	j2962817931 [label="“你蹲下来，进入隧道。痛苦地慢慢爬行，似乎永远都爬不完。这里又冷又湿，而且非常非常脏。”",shape=box,color=blue];
		j2962817931 -> j2395391830;
	j2108549421 [label="如果只有一条路可走，那就走隧道吧。",shape=box,color=red];
		j2108549421 -> j2962817931;
	j4131971651 [label="我想我要进去了。",shape=box,color=red];
		j4131971651 -> j2962817931;
	j336556103 [label="四转功成",shape=box,color=blue];
		j336556103 -> j1347308416;
	j3331344489 [label="这可能是最好的结局了，虽然有点像虐待动物，哈哈",shape=box,color=blue];
		j3331344489 -> "Chat ends.";
	j2395391830 [label="“最终，爬出隧道了。你如释重负，站起来环顾四周。”",shape=box,color=blue];
		j2395391830 -> j2725147804;
	j1347308416 [label="Boolean BrutalDeath3 is now true.",color=orange];
		j1347308416 -> j1022424251;
	j2725147804 [label="“你发现自己在一个空荡荡的大房间里。也许是个地窖？唯一值得注意的是一扇沉重的金属门。”",shape=box,color=blue];
		j2725147804 -> j2327308320;
		j2725147804 -> j485934806;
	j2327308320 [label="让我猜猜——门是锁着的吗？",shape=box,color=red];
		j2327308320 -> j1012401056;
	j485934806 [label="我能开门吗？",shape=box,color=red];
		j485934806 -> j1012401056;
	j1012401056 [label="“门是锁着的。”",shape=box,color=blue];
		j1012401056 -> j1985922313;
	j1985922313 [label="“你开始注意到一种微弱的声音。是……吱吱声吗？”",shape=box,color=blue];
		j1985922313 -> j3416983024;
		j1985922313 -> j607951858;
	j3416983024 [label="别告诉我是老鼠。",shape=box,color=red];
		j3416983024 -> j3302741997;
	j607951858 [label="是老鼠吧？",shape=box,color=red];
		j607951858 -> j3302741997;
	j3302741997 [label="就是该死的老鼠！！",shape=box,color=blue];
		j3302741997 -> j3747310087;
	j3747310087 [label="我是说……",shape=box,color=blue];
		j3747310087 -> j662319663;
	j662319663 [label="“吱吱声越来越大，接着是爪子拍打石头的嗒嗒声。突然，你的火把投射出一片阴影。一只猫……不……狗那么大的老鼠向你冲来。”",shape=box,color=blue];
		j662319663 -> j946498948;
	j946498948 [label="“但不只它一只，它们从四面八方涌来。”",shape=box,color=blue];
		j946498948 -> j439847264;
		j946498948 -> j1929005557;
		j946498948 -> j2502477605;
	j439847264 [label="跟鼠群拼了。",shape=box,color=red];
		j439847264 -> j1943885293;
	j1929005557 [label="向它们挥舞我的火把。",shape=box,color=red];
		j1929005557 -> j1943885293;
	j2502477605 [label="你给莱蒂看过这部分内容吗？",shape=box,color=red];
		j2502477605 -> j3302268320;
	j1943885293 [label="“老鼠包围了你。你站了起来，准备战斗，但它们没有攻击。相反，最大的那只向你弯下了脖子。你发现它戴着一条项链。银链滑落，掉在地上。老鼠好像在说：‘这是给你的。‘ ”",shape=box,color=blue];
		j1943885293 -> j2070618419;
		j1943885293 -> j181791867;
	j3302268320 [label="没有，我也不打算给她看",shape=box,color=blue];
		j3302268320 -> j3562732570;
	j2070618419 [label="捡起项链。",shape=box,color=red];
		j2070618419 -> j558945587;
	j181791867 [label="问问那只老鼠是谁给了他项链？",shape=box,color=red];
		j181791867 -> j1162727040;
	j3562732570 [label="老鼠向你扑来，你有什么打算？",shape=box,color=blue];
		j3562732570 -> j439847264;
		j3562732570 -> j1929005557;
	j558945587 [label="“你拿起项链。项链上有钥匙。”",shape=box,color=blue];
		j558945587 -> j1441522278;
	j1162727040 [label="“老鼠不会说话。毕竟它是只老鼠。”",shape=box,color=blue];
		j1162727040 -> j1441522278;
	j1441522278 [label="\"老鼠们转身一溜烟跑了。给他们钥匙的人知道你在下面，只有一个人有这样的能力……Lotus。” ",shape=box,color=blue];
		j1441522278 -> j754249356;
	j754249356 [label="钥匙？它能打开那扇门吗？",shape=box,color=red];
		j754249356 -> j341036512;
	j341036512 [label="“你把钥匙插进门里，门开了。门那边的强光射进来，你痛苦地眯起眼睛。你简直不敢相信眼前的一切……”",shape=box,color=blue];
		j341036512 -> j1335339034;
	j1335339034 [label="然后呢……",shape=box,color=blue];
		j1335339034 -> j3440532661;
	j3440532661 [label="这就是我目前写好的部分",shape=box,color=blue];
		j3440532661 -> j3059614825;
