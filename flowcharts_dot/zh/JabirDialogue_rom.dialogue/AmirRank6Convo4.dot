		j663078310 -> j2992419960;
	j1708413961 [label="一起来看看！",shape=box,color=red];
		j1708413961 -> j3423335896;
	j463240430 [label="阿米尔，我连上一个都没完成呢。",shape=box,color=red];
		j463240430 -> j951557725;
	j285040374 [label="我们刚说到哪儿了？ 噢，对了",shape=box,color=blue];
		j285040374 -> j3423335896;
	j2992419960 [label="是啊 是啊",shape=box,color=blue];
		j2992419960 -> j3876057973;
	j3423335896 [label="“你站在牢房里看着刚被你杀死的 Grineer 的尸体。他临死前的话一直在你耳边响起，‘你永远找不到 Lotus’。”",shape=box,color=blue];
		j3423335896 -> j2681815718;
	j951557725 [label="没问题",shape=box,color=blue];
		j951557725 -> j3558946766;
	j3876057973 [label="但首先……",shape=box,color=blue];
		j3876057973 -> j3423335896;
	j2681815718 [label="“你看了眼敞开的牢门。你的下一步会是什么？”",shape=box,color=blue];
		j2681815718 -> j179745326;
		j2681815718 -> j4287615642;
		j2681815718 -> j2516237681;
	j3558946766 [label="现在我需要有人来测试下一部分",shape=box,color=blue];
		j3558946766 -> j3423335896;
	j179745326 [label="把门关上等待救援，我去完成我的库存盘点。[结束]",shape=box,color=red];
		j179745326 -> j2512351517;
	j4287615642 [label="我可以搜查守卫的尸体吗？",shape=box,color=red];
		j4287615642 -> j221085784;
	j2516237681 [label="我想去大厅。",shape=box,color=red];
		j2516237681 -> j1022424251;
	j2512351517 [label="真的吗，这就是你的举动吗？？",shape=box,color=blue];
		j2512351517 -> j2111205744;
	j221085784 [label="Check boolean FlintTaken",color=orange];
		j221085784 -> j687541059 [label=true,color=green];
		j221085784 -> j3942062395 [label=false,color=brown];
	j1022424251 [label="“你小心翼翼地溜出牢房。你的右边是一扇大门，那是出口。门只开了一条缝。你听到很多 Grineer 守卫在另一边窸窸窣窣。你的左边是地牢大厅，但是太黑了，看不清。”",shape=box,color=blue];
		j1022424251 -> j1405298677;
	j2111205744 [label="好吧",shape=box,color=blue];
		j2111205744 -> j607368419;
	j687541059 [label="“你再次搜查守卫的尸体，但没有发现任何有价值的东西。你想吃那块发霉的饼干，但你闻到了它的味道，便很快改变了主意。”",shape=box,color=blue];
		j687541059 -> j3451620922;
	j3942062395 [label="“你在守卫身上翻找有没有值钱的东西。除了一块打火石和一块发霉的饼干，什么都没有。你拿走了打火石。”",shape=box,color=blue];
		j3942062395 -> j1699277802;
	j1405298677 [label="Check boolean TorchTaken",color=orange];
		j1405298677 -> j3863452790 [label=true,color=green];
		j1405298677 -> j1907762943 [label=false,color=brown];
	j607368419 [label="“你关上门等待救援，但没有人来救你。相反，守卫来了，他们气愤于你杀死了他们的朋友，于是对你做了各种可怕而卑鄙的事情，直至你无人问津地惨死。”",shape=box,color=blue];
		j607368419 -> j3740528846;
