		j1788024189 -> j1045494505;
	j2881541696 [label="“你试着用火把照亮木板的缝隙。一阵风吹过，火苗一闪一闪。你听到水滴的声音。”",shape=box,color=blue];
		j2881541696 -> j17361656;
	j1467287400 [label="“你用尽全身力气把木板剥开，露出一些生锈的铁栏杆。还有空间可以挤过去。再过去，是一条低矮狭窄的隧道。”",shape=box,color=blue];
		j1467287400 -> j1588109434;
