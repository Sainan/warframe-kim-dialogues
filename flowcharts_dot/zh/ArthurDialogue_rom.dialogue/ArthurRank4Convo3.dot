	1474 [label="Update boolean ArthurSorrowSpiral",color=orange];
		1474 -> 1475;
	1475 [label="但当所有这些都消亡后，其他的东西就会取而代之。",shape=box,color=red];
		1475 -> 1476;
	1476 [label="其他更糟糕、更阴险的东西。",shape=box,color=red];
