		1439 -> 1444;
	1440 [label="我知道这令人害怕。",shape=box,color=red];
		1440 -> 1445;
	1441 [label="有一阵子，我老是笑眯眯的，假装没事。",shape=box,color=red];
		1441 -> 1446;
	1442 [label="我真的很嫉妒那些没有被抛弃的人。",shape=box,color=red];
		1442 -> 1447;
	1443 [label="我当时非常非常*愤怒*。",shape=box,color=red];
		1443 -> 1448;
	1444 [label="屈服于悲伤太容易了。",shape=box,color=red];
		1444 -> 1449;
	1445 [label="扯淡我才不怕呢",shape=box,color=blue];
		1445 -> 1450;
	1446 [label="什么？为什么？",shape=box,color=blue];
		1446 -> 1451;
	1447 [label="是指其他 tenno 吗？",shape=box,color=blue];
		1447 -> 1452;
	1448 [label="对什么愤怒？",shape=box,color=blue];
		1448 -> 1453;
	1449 [label="悲伤是一种毒药",shape=box,color=blue];
		1449 -> 1454;
	1450 [label="我没有侮辱你的意思，只是在说*事实*。",shape=box,color=red];
		1450 -> 1455;
	1451 [label="因为虚假的幸福在那时比任何东西都好。",shape=box,color=red];
		1451 -> 1456;
	1452 [label="见鬼，甚至连我已故的父母都算进去了。包括任何人。除了*我*以外的任何人。",shape=box,color=red];
		1452 -> 1457;
	1453 [label="不是对什么。是对*谁*。",shape=box,color=red];
		1453 -> 1458;
	1454 [label="没错。它会吞噬你。瓦解你。让你支离破碎、空虚不堪。",shape=box,color=red];
		1454 -> 1459;
	1455 [label="这玩意儿是真的*恐怖*。",shape=box,color=red];
		1455 -> 1460;
	1456 [label="因为如果我让那笑容溜走，那么*其他一切*就会趁虚而入。",shape=box,color=red];
		1456 -> 1461;
	1457 [label="因为那样我就不用再忍受那种痛苦、那种孤独。",shape=box,color=red];
		1457 -> 1462;
	1458 [label="对那些没有被抛弃的人愤怒。对我的父母愤怒。对奥罗金愤怒。",shape=box,color=red];
		1458 -> 1463;
	1459 [label="它夺走了世界上所有的色彩。但是它也是……安全的。纯粹的。简单的。",shape=box,color=red];
		1459 -> 1464;
	1460 [label="而恐惧会渗透到每个角落。接着它会让你情绪失控。",shape=box,color=red];
		1460 -> 1465;
	1461 [label="那种痛苦、那种孤独。",shape=box,color=red];
		1461 -> 1466;
	1462 [label="那个我被*永远*困住了的事实。",shape=box,color=red];
		1462 -> 1467;
	1463 [label="对每个人都感到愤怒，不管是谁。对每个人都感到愤怒，是因为这。全。都。是。他。们。的。错。",shape=box,color=red];
		1463 -> 1468;
	1464 [label="就像一条温暖舒适的毯子，却早已变冷。",shape=box,color=red];
		1464 -> 1469;
	1465 [label="它会化为痛苦。化为折磨。然后化为孤独。",shape=box,color=red];
		1465 -> 1470;
	1466 [label="那种喜悦只不过是徒有其表。",shape=box,color=red];
		1466 -> 1471;
	1467 [label="我想成为其他人。去其他地方。做梦都想。",shape=box,color=red];
		1467 -> 1472;
	1468 [label="但最重要的是？我对自己很极其愤怒。",shape=box,color=red];
		1468 -> 1473;
	1469 [label="这是一件在黑暗中很容易抓住的东西。",shape=box,color=red];
