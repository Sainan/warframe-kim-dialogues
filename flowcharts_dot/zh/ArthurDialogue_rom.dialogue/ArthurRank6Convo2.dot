digraph {
	"ArthurRank6Convo2 begins." [color=orange];
		"ArthurRank6Convo2 begins." -> j3183822770;
	j3183822770 [label="我一直在想。你觉得还有多少像我们这样的人？",shape=box,color=blue];
		j3183822770 -> j3494322734;
		j3183822770 -> j3062574656;
	j3494322734 [label="你指的是在 1999 年，还是更广义上的意思？",shape=box,color=red];
		j3494322734 -> j2713600686;
	j3062574656 [label="“我们”是指？",shape=box,color=red];
		j3062574656 -> j2374712265;
	j2713600686 [label="我想两者都是。此时、此地、过去——未来。",shape=box,color=blue];
		j2713600686 -> j1511562110;
	j2374712265 [label="原型战甲。在这里，或者任何地方。或者，我想，任何时间都可以。",shape=box,color=blue];
		j2374712265 -> j1511562110;
	j1511562110 [label="英择谛创造我们，是有目的的。带着多重目的。显然，他创造的远不止我们六个人。 ",shape=box,color=blue];
		j1511562110 -> j857052055;
		j1511562110 -> j3731866735;
	j857052055 [label="一开始我以为他是在给我做“备用”的战甲，以防我的战甲没能撑过 Helminth。现在我不太确定了。",shape=box,color=red];
		j857052055 -> j386271297;
	j3731866735 [label="我只希望知道他在做什么。或者他创造更多原型战甲背后的真正动机是什么。",shape=box,color=red];
		j3731866735 -> j3455271100;
	j386271297 [label="当只有我们六个人时，这听起来有些道理。",shape=box,color=blue];
		j386271297 -> j3455271100;
	j3455271100 [label="你真的相信他的真正动机是为了阻止虚空无情之物吗？",shape=box,color=blue];
		j3455271100 -> j3657618480;
	j3657618480 [label="我们*真的*可以信任他吗？",shape=box,color=blue];
		j3657618480 -> j688078557;
		j3657618480 -> j3314131944;
		j3657618480 -> j2941155226;
	j688078557 [label="说实话，我不知道。我压根就不相信他，能把他扔多远就信多远的那种。再说了，要是没有战甲，我这胳膊根本扔不动东西。",shape=box,color=red];
		j688078557 -> j96701499;
	j3314131944 [label="不，我们既不能相信他的动机，也不能相信他采取的方法。",shape=box,color=red];
		j3314131944 -> j3282637937;
		j3314131944 -> j122589906;
	j2941155226 [label="可以。虽然我并不总是认同他的做法。但是，可以信任他。他想阻止那个东西。",shape=box,color=red];
		j2941155226 -> j122589906;
		j2941155226 -> j3282637937;
	j96701499 [label="+5 Chemistry",color=orange];
		j96701499 -> j2257267083;
	j3282637937 [label="他已经在试图挽回局面了，如果能实现的话。而这本身是一个混乱的过程。",shape=box,color=red];
		j3282637937 -> j951166131;
	j122589906 [label="但我们真的没得选，不是吗？我和那个孩子能做的就只有跟在他后面，帮他收拾残局了。 ",shape=box,color=red];
		j122589906 -> j4293296670;
		j122589906 -> j238427461;
	j2257267083 [label="呵呵。",shape=box,color=blue];
		j2257267083 -> j3282637937;
		j2257267083 -> j122589906;
	j951166131 [label="那我们就像是学校的清洁工，帮他擦地板。真好。",shape=box,color=blue];
		j951166131 -> j4293296670;
		j951166131 -> j238427461;
	j4293296670 [label="现在卡娅对时间旅行有了自己的看法，我来回穿越可能会变得更容易些了。",shape=box,color=red];
		j4293296670 -> j1153759301;
	j238427461 [label="不过我要留在这里，所以现在就靠那个孩子了。",shape=box,color=red];
		j238427461 -> j161265069;
	j1153759301 [label="那孩子有时候挺烦人的，但我确实很感激她所做的事。",shape=box,color=blue];
		j1153759301 -> j2807998942;
	j161265069 [label="Check boolean ArthurDating",color=orange];
		j161265069 -> j2812746515 [label=true,color=green];
		j161265069 -> j516112316 [label=false,color=brown];
	j2807998942 [label="这样挺好，能知道你只是去趟商店……知道你可能还会回来……:/",shape=box,color=blue];
		j2807998942 -> j2613732724;
	j2812746515 [label="呃。我们再看吧。亲爱的，我太了解你了。你总是不知道什么时候该低调。",shape=box,color=blue];
		j2812746515 -> j3071124742;
	j516112316 [label="呃。我们再看吧。漂泊者，我太了解你了。你总是不知道什么时候该低调。",shape=box,color=blue];
		j516112316 -> j442298292;
	j2613732724 [label="Check boolean ArthurDating",color=orange];
		j2613732724 -> j1430440255 [label=true,color=green];
		j2613732724 -> j1357357776 [label=false,color=brown];
		j2613732724 -> j1415639705 [label=false,color=brown];
	j3071124742 [label="这也是我这么喜欢你的原因之一。;)",shape=box,color=blue];
		j3071124742 -> j1415639705;
	j442298292 [label="这也是我愿意忍受你，把你留在我身边的原因之一。;)",shape=box,color=blue];
		j442298292 -> j1357357776;
	j1430440255 [label="我欠她很多，是她让我多少能安心一点。:)",shape=box,color=blue];
		j1430440255 -> j1357357776;
		j1430440255 -> j1415639705;
	j1357357776 [label="竟然是个表情符号！:D",shape=box,color=red];
		j1357357776 -> j1595534659;
	j1415639705 [label="别对我这么煽情。 ",shape=box,color=red];
		j1415639705 -> j200455242;
	j1595534659 [label="是，是。别太习惯我用这个。还是感觉很奇怪。",shape=box,color=blue];
		j1595534659 -> j1222458787;
	j200455242 [label="嗯，你知道我的。外脆里嫩。就像阿米尔和维利米尔一直念叨的那种难吃的甜点，还是变质的版本。",shape=box,color=blue];
		j200455242 -> j2067167166;
	j1222458787 [label="那我要飘了。",shape=box,color=red];
		j1222458787 -> j1488965160;
	j2067167166 [label="好像是叫甜饼？",shape=box,color=blue];
		j2067167166 -> j1488965160;
	j1488965160 [label="好了，回到正题。有时候我总有种不祥的预感，觉得英择谛对我们所有人都另有所图。",shape=box,color=blue];
		j1488965160 -> j2358887583;
		j1488965160 -> j3258506044;
		j1488965160 -> j2975268946;
	j2358887583 [label="你为什么会这么说？",shape=box,color=red];
		j2358887583 -> j80967972;
	j3258506044 [label="嗯，你可能是对的。",shape=box,color=red];
		j3258506044 -> j1846334018;
	j2975268946 [label="那会不会只是你在一厢情愿？",shape=box,color=red];
		j2975268946 -> j2839261477;
	j80967972 [label="他为了创造我们付出了多少心血？而且还不止我们六个……",shape=box,color=blue];
		j80967972 -> j2149400252;
	j1846334018 [label="你觉得他图的是什么？还有他在等什么？",shape=box,color=blue];
		j1846334018 -> j2253564882;
		j1846334018 -> j3301424082;
	j2839261477 [label="什么意思？",shape=box,color=blue];
		j2839261477 -> j1939269449;
		j2839261477 -> j1165747650;
	j2149400252 [label="伙计，你不会去制造这样的武器，除非你知道要把武器用在什么地方。",shape=box,color=blue];
		j2149400252 -> j1280455050;
	j2253564882 [label="<RETRO_EMOJI_SHRUG>",shape=box,color=red];
		j2253564882 -> j489246088;
	j3301424082 [label="这两个问题，我也想知道。",shape=box,color=red];
		j3301424082 -> j489246088;
	j1939269449 [label="有时候，真的很难接受自己已经“不重要”了。",shape=box,color=red];
		j1939269449 -> j1178077698;
	j1165747650 [label="嗯，我只是想说……也许你只是不想感觉到被他抛弃了。",shape=box,color=red];
		j1165747650 -> j453677800;
	j1280455050 [label="除非你*知道*即将会发生战争。",shape=box,color=blue];
		j1280455050 -> j1155358417;
		j1280455050 -> j381325898;
		j1280455050 -> j3698217706;
	j489246088 [label="也许他需要一支军队？也许他正在努力寻找他认为能够战胜虚空无情之物的“唯一东西”。也许还有很多其他原因。",shape=box,color=red];
		j489246088 -> j157917122;
	j1178077698 [label="对……",shape=box,color=blue];
		j1178077698 -> "Chat ends.";
	j453677800 [label="无论他来这里是为了什么，无论他对你做了什么，那些都依然重要。依然成立。这一切并没有失败。",shape=box,color=red];
		j453677800 -> j3498197105;
		j453677800 -> j2561991734;
	j1155358417 [label="那我们能做的就是做好准备，以防这种情况发生。",shape=box,color=red];
		j1155358417 -> j3222625424;
	j381325898 [label="有可能。不过英择谛似乎也是那种有应急计划的人。 ",shape=box,color=red];
		j381325898 -> j3883047977;
	j3698217706 [label="我不知道。米尼娃和维利米尔跟我提过……“冷战？”听起来那时人们似乎造了很多疯狂的武器，但从来没用过。",shape=box,color=red];
		j3698217706 -> j3687597064;
	j157917122 [label="忍不住会想，我们就像枪里的子弹，注定要被使用，被消耗，然后被扔掉。",shape=box,color=blue];
		j157917122 -> j4122739786;
		j157917122 -> j1726319928;
	"Chat ends." [color=orange];
	j3498197105 [label="我得说清楚，你依然很重要。",shape=box,color=red];
		j3498197105 -> j458810091;
		j3498197105 -> j2342347048;
		j3498197105 -> j2562750157;
	j2561991734 [label="我得说清楚，对*我*来说你依然很重要。 ",shape=box,color=red];
		j2561991734 -> j458810091;
		j2561991734 -> j2342347048;
		j2561991734 -> j2562750157;
	j3222625424 [label="+5 Chemistry",color=orange];
		j3222625424 -> j586277145;
	j3883047977 [label="也许吧。",shape=box,color=blue];
		j3883047977 -> j291573585;
	j3687597064 [label="反驳得有道理。但那是国家之间的博弈，涉及外交。有很多变数。",shape=box,color=blue];
		j3687597064 -> j1717885796;
	j4122739786 [label="我也希望我能告诉你。但我会尽一切努力阻止这种事情发生。",shape=box,color=red];
		j4122739786 -> j1185259283;
	j1726319928 [label="你觉得你的使命还没结束？",shape=box,color=red];
		j1726319928 -> j4141961330;
	j458810091 [label="但是一想到你的故事就此结束，而结局又没你的份？那种感觉真的很糟心。",shape=box,color=red];
		j458810091 -> j846570826;
	j2342347048 [label="但也许让你感到难过的，是想到你已经被某个地方的亚瑟 2.0 取代。",shape=box,color=red];
		j2342347048 -> j2848776141;
	j2562750157 [label="但也许你只是希望，你的牺牲在宇宙层面上仍然有意义？",shape=box,color=red];
		j2562750157 -> j1608218424;
	j586277145 [label="同意。",shape=box,color=blue];
		j586277145 -> j1237902203;
	j291573585 [label="我内心深处是希望外面能有更多像我们这样的人。但如果他们最终都来这里了呢？我们可能会需要一个更大的商场。",shape=box,color=blue];
		j291573585 -> "Chat ends.";
	j1717885796 [label="而这是一位真正的神与一位自认为是神的人之间的博弈。",shape=box,color=blue];
		j1717885796 -> j4282182405;
	j1185259283 [label="我知道你会的。我们会一起面对那一天，我对此充满信心。",shape=box,color=blue];
		j1185259283 -> j2397353713;
	j4141961330 [label="不。伙计，你不会去制造这样的武器，除非你知道要把武器用在什么地方。",shape=box,color=blue];
		j4141961330 -> j399161769;
		j4141961330 -> j381325898;
		j4141961330 -> j1155358417;
	j846570826 [label="这或许是原因之一。如果虚空无情之物是让我变成这样的原因？并且这是我必须经历的？",shape=box,color=blue];
		j846570826 -> j2623070499;
	j2848776141 [label="伙计，我本来都准备要退休了，没想到竟然被卷入这种荒唐事。真是的。",shape=box,color=blue];
		j2848776141 -> j2574573403;
	j1608218424 [label="也许是，些许不是。但在人生中，有多少人的牺牲是毫无意义的？绝大多数。",shape=box,color=blue];
		j1608218424 -> j82243888;
	j1237902203 [label="希望如果有更多我们这样的人来这里，我们最后不会需要一个更大的商场吧？",shape=box,color=blue];
		j1237902203 -> "Chat ends.";
	j4282182405 [label="我赌这场冲突是避免不了的。我认为以他们的自尊心，这件事注定不会有其他结局。",shape=box,color=blue];
		j4282182405 -> j1527487755;
		j4282182405 -> j2118450402;
	j2397353713 [label="+5 Chemistry",color=orange];
		j2397353713 -> j1648722223;
	j399161769 [label="我不知道。米尼娃和维利米尔跟我提过……“冷战？”听起来那时人们似乎造了很多疯狂的武器，但从来没用过。",shape=box,color=red];
		j399161769 -> j3708259310;
	j2623070499 [label="我想要亲手摧毁它。",shape=box,color=blue];
		j2623070499 -> j202873607;
	j2574573403 [label="有时我仍然对你说错话的能力感到惊讶。",shape=box,color=blue];
		j2574573403 -> "Chat ends.";
	j82243888 [label="也许我感到悲哀的是，我们这支军队竟然是由一个疯子制造出来的，根本不知道原因。或者说，为了什么。",shape=box,color=blue];
		j82243888 -> j2330007220;
	j1527487755 [label="你可能是对的。",shape=box,color=red];
		j1527487755 -> j1578382471;
	j2118450402 [label="我真希望你想错了。",shape=box,color=red];
		j2118450402 -> j4174248474;
	j1648722223 [label="Check boolean ArthurDating",color=orange];
		j1648722223 -> j68577492 [label=true,color=green];
		j1648722223 -> j1309272853 [label=false,color=brown];
	j3708259310 [label="反驳得有道理。但那是国家之间的博弈，涉及外交。有很多变数。",shape=box,color=blue];
		j3708259310 -> j3071998891;
	j202873607 [label="+5 Chemistry",color=orange];
		j202873607 -> j3244503248;
	j2330007220 [label="被告知要受苦，被告知要牺牲——却不知道为什么。或者为了什么。",shape=box,color=blue];
		j2330007220 -> j1152085105;
	j1578382471 [label="+5 Chemistry",color=orange];
		j1578382471 -> j3934137045;
	j4174248474 [label="+5 Chemistry",color=orange];
		j4174248474 -> j514288810;
	j68577492 [label="亲爱的，谢谢你。",shape=box,color=blue];
		j68577492 -> "Chat ends.";
	j1309272853 [label="漂泊者，谢谢你。",shape=box,color=blue];
		j1309272853 -> "Chat ends.";
	j3071998891 [label="而这是一位真正的神与一位自认为是神的人之间的博弈。",shape=box,color=blue];
		j3071998891 -> j3956836533;
	j3244503248 [label="我不想被遗忘在历史的脚注里。我要把这把空刃直接捅进它屁股里。",shape=box,color=blue];
		j3244503248 -> j1256781881;
		j3244503248 -> j1934052302;
	j1152085105 [label="伙计，也许这就是我难以接受的事实。",shape=box,color=blue];
		j1152085105 -> "Chat ends.";
	j3934137045 [label="不管怎样，我希望我是错的。",shape=box,color=blue];
		j3934137045 -> j1050012734;
	j514288810 [label="不管怎样，我也希望我想错了。",shape=box,color=blue];
		j514288810 -> j1050012734;
	j3956836533 [label="我赌这场冲突是避免不了的。我认为以他们的自尊心，这件事注定不会有其他结局。",shape=box,color=blue];
		j3956836533 -> j1594365724;
		j3956836533 -> j2118450402;
	j1256781881 [label="我看看能不能帮上忙吧。;)",shape=box,color=red];
		j1256781881 -> j2681000272;
