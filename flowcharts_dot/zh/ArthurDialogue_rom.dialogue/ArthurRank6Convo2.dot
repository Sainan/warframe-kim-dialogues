digraph {
	3229 [label="ArthurRank6Convo2 begins.",color=orange];
		3229 -> 3230;
	3230 [label="我一直在想。你觉得还有多少像我们这样的人？",shape=box,color=blue];
		3230 -> 3231;
		3230 -> 3232;
	3231 [label="你指的是在 1999 年，还是更广义上的意思？",shape=box,color=red];
		3231 -> 3233;
	3232 [label="“我们”是指？",shape=box,color=red];
		3232 -> 3234;
	3233 [label="我想两者都是。此时、此地、过去——未来。",shape=box,color=blue];
		3233 -> 3235;
	3234 [label="原型战甲。在这里，或者任何地方。或者，我想，任何时间都可以。",shape=box,color=blue];
		3234 -> 3235;
	3235 [label="英择谛创造我们，是有目的的。带着多重目的。显然，他创造的远不止我们六个人。 ",shape=box,color=blue];
		3235 -> 3236;
		3235 -> 3237;
	3236 [label="一开始我以为他是在给我做“备用”的战甲，以防我的战甲没能撑过 Helminth。现在我不太确定了。",shape=box,color=red];
		3236 -> 3238;
	3237 [label="我只希望知道他在做什么。或者他创造更多原型战甲背后的真正动机是什么。",shape=box,color=red];
		3237 -> 3239;
	3238 [label="当只有我们六个人时，这听起来有些道理。",shape=box,color=blue];
		3238 -> 3239;
	3239 [label="你真的相信他的真正动机是为了阻止虚空无情之物吗？",shape=box,color=blue];
		3239 -> 3240;
	3240 [label="我们*真的*可以信任他吗？",shape=box,color=blue];
		3240 -> 3241;
		3240 -> 3242;
		3240 -> 3243;
	3241 [label="说实话，我不知道。我压根就不相信他，能把他扔多远就信多远的那种。再说了，要是没有战甲，我这胳膊根本扔不动东西。",shape=box,color=red];
		3241 -> 3244;
	3242 [label="不，我们既不能相信他的动机，也不能相信他采取的方法。",shape=box,color=red];
		3242 -> 3245;
		3242 -> 3246;
	3243 [label="可以。虽然我并不总是认同他的做法。但是，可以信任他。他想阻止那个东西。",shape=box,color=red];
		3243 -> 3246;
		3243 -> 3245;
	3244 [label="+5 Chemistry",color=orange];
		3244 -> 3247;
	3245 [label="他已经在试图挽回局面了，如果能实现的话。而这本身是一个混乱的过程。",shape=box,color=red];
		3245 -> 3248;
	3246 [label="但我们真的没得选，不是吗？我和那个孩子能做的就只有跟在他后面，帮他收拾残局了。 ",shape=box,color=red];
		3246 -> 3249;
		3246 -> 3250;
	3247 [label="呵呵。",shape=box,color=blue];
		3247 -> 3245;
		3247 -> 3246;
	3248 [label="那我们就像是学校的清洁工，帮他擦地板。真好。",shape=box,color=blue];
		3248 -> 3249;
		3248 -> 3250;
	3249 [label="现在卡娅对时间旅行有了自己的看法，我来回穿越可能会变得更容易些了。",shape=box,color=red];
		3249 -> 3251;
	3250 [label="不过我要留在这里，所以现在就靠那个孩子了。",shape=box,color=red];
		3250 -> 3254;
	3251 [label="那孩子有时候挺烦人的，但我确实很感激她所做的事。",shape=box,color=blue];
		3251 -> 3253;
	3254 [label="Check boolean ArthurDating",color=orange];
		3254 -> 3603 [label=true,color=green];
		3254 -> 3252 [label=false,color=brown];
	3253 [label="这样挺好，能知道你只是去趟商店……知道你可能还会回来……:/",shape=box,color=blue];
		3253 -> 3255;
	3603 [label="呃。我们再看吧。亲爱的，我太了解你了。你总是不知道什么时候该低调。",shape=box,color=blue];
		3603 -> 3257;
	3252 [label="呃。我们再看吧。漂泊者，我太了解你了。你总是不知道什么时候该低调。",shape=box,color=blue];
		3252 -> 3256;
	3255 [label="Check boolean ArthurDating",color=orange];
