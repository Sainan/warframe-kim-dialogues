	3258 [label="竟然是个表情符号！:D",shape=box,color=red];
		3258 -> 3261;
	3259 [label="别对我这么煽情。 ",shape=box,color=red];
		3259 -> 3262;
	3261 [label="是，是。别太习惯我用这个。还是感觉很奇怪。",shape=box,color=blue];
		3261 -> 3263;
	3262 [label="嗯，你知道我的。外脆里嫩。就像阿米尔和维利米尔一直念叨的那种难吃的甜点，还是变质的版本。",shape=box,color=blue];
		3262 -> 3264;
	3263 [label="那我要飘了。",shape=box,color=red];
		3263 -> 3265;
	3264 [label="好像是叫甜饼？",shape=box,color=blue];
		3264 -> 3265;
	3265 [label="好了，回到正题。有时候我总有种不祥的预感，觉得英择谛对我们所有人都另有所图。",shape=box,color=blue];
		3265 -> 3266;
		3265 -> 3267;
		3265 -> 3268;
	3266 [label="你为什么会这么说？",shape=box,color=red];
		3266 -> 3269;
	3267 [label="嗯，你可能是对的。",shape=box,color=red];
		3267 -> 3270;
	3268 [label="那会不会只是你在一厢情愿？",shape=box,color=red];
		3268 -> 3271;
	3269 [label="他为了创造我们付出了多少心血？而且还不止我们六个……",shape=box,color=blue];
		3269 -> 3272;
	3270 [label="你觉得他图的是什么？还有他在等什么？",shape=box,color=blue];
		3270 -> 3273;
		3270 -> 3274;
	3271 [label="什么意思？",shape=box,color=blue];
		3271 -> 3275;
		3271 -> 3276;
	3272 [label="伙计，你不会去制造这样的武器，除非你知道要把武器用在什么地方。",shape=box,color=blue];
		3272 -> 3277;
	3273 [label="<RETRO_EMOJI_SHRUG>",shape=box,color=red];
		3273 -> 3278;
	3274 [label="这两个问题，我也想知道。",shape=box,color=red];
		3274 -> 3278;
	3275 [label="有时候，真的很难接受自己已经“不重要”了。",shape=box,color=red];
		3275 -> 3279;
	3276 [label="嗯，我只是想说……也许你只是不想感觉到被他抛弃了。",shape=box,color=red];
		3276 -> 3280;
	3277 [label="除非你*知道*即将会发生战争。",shape=box,color=blue];
		3277 -> 3281;
		3277 -> 3282;
		3277 -> 3283;
	3278 [label="也许他需要一支军队？也许他正在努力寻找他认为能够战胜虚空无情之物的“唯一东西”。也许还有很多其他原因。",shape=box,color=red];
		3278 -> 3284;
	3279 [label="对……",shape=box,color=blue];
		3279 -> 3285;
	3280 [label="无论他来这里是为了什么，无论他对你做了什么，那些都依然重要。依然成立。这一切并没有失败。",shape=box,color=red];
		3280 -> 3286;
		3280 -> 3287;
	3281 [label="那我们能做的就是做好准备，以防这种情况发生。",shape=box,color=red];
		3281 -> 3288;
	3282 [label="有可能。不过英择谛似乎也是那种有应急计划的人。 ",shape=box,color=red];
		3282 -> 3289;
	3283 [label="我不知道。米尼娃和维利米尔跟我提过……“冷战？”听起来那时人们似乎造了很多疯狂的武器，但从来没用过。",shape=box,color=red];
		3283 -> 3290;
	3284 [label="忍不住会想，我们就像枪里的子弹，注定要被使用，被消耗，然后被扔掉。",shape=box,color=blue];
		3284 -> 3291;
		3284 -> 3292;
	3285 [label="Chat ends.",color=orange];
	3286 [label="我得说清楚，你依然很重要。",shape=box,color=red];
		3286 -> 3293;
		3286 -> 3294;
