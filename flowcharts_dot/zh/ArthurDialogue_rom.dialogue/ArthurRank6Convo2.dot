	3296 [label="同意。",shape=box,color=blue];
		3296 -> 3304;
	3297 [label="我内心深处是希望外面能有更多像我们这样的人。但如果他们最终都来这里了呢？我们可能会需要一个更大的商场。",shape=box,color=blue];
		3297 -> 3305;
	3298 [label="而这是一位真正的神与一位自认为是神的人之间的博弈。",shape=box,color=blue];
