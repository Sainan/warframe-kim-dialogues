		3293 -> 3301;
	3294 [label="但也许让你感到难过的，是想到你已经被某个地方的亚瑟 2.0 取代。",shape=box,color=red];
		3294 -> 3302;
	3295 [label="但也许你只是希望，你的牺牲在宇宙层面上仍然有意义？",shape=box,color=red];
