	3257 [label="这也是我这么喜欢你的原因之一。;)",shape=box,color=blue];
		3257 -> 3259;
	3256 [label="这也是我愿意忍受你，把你留在我身边的原因之一。;)",shape=box,color=blue];
		3256 -> 3258;
	3260 [label="我欠她很多，是她让我多少能安心一点。:)",shape=box,color=blue];
		3260 -> 3258;
