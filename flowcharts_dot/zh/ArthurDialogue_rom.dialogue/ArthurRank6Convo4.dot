digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo4 begins." [color=orange];
		"ArthurRank6Convo4 begins." -> j4012955172;
	j4012955172 [label="问个奇怪的问题。太空里有玩具吗？",shape=box,color=blue];
		j4012955172 -> j175364299;
		j4012955172 -> j3706338638;
	j175364299 [label="像是儿童玩具？当然了。",shape=box,color=red];
		j175364299 -> j1285000899;
	j3706338638 [label="什么样的……玩具？",shape=box,color=red];
		j3706338638 -> j1105576776;
	j1285000899 [label="呵呵。真的吗？",shape=box,color=blue];
		j1285000899 -> j4025136678;
	j1105576776 [label="哦，天。我不是那个意思，你知道的！",shape=box,color=blue];
		j1105576776 -> j2820728264;
	j4025136678 [label="很难想象在几千上万年后的未来，",shape=box,color=blue];
		j4025136678 -> j3522898970;
	j2820728264 [label="我是指儿童玩具。洋娃娃。玩偶。诸如此类的东西。",shape=box,color=blue];
		j2820728264 -> j885680170;
		j2820728264 -> j2665980821;
	j3522898970 [label="孩子们仍然会围坐在一起，用玩偶重演故事，玩“强盗”或“拯救公主”的游戏。",shape=box,color=blue];
		j3522898970 -> j2118707449;
		j3522898970 -> j3974411816;
		j3522898970 -> j3291929481;
	j885680170 [label="刚才只是想逗逗你而已。:P",shape=box,color=red];
		j885680170 -> j4062361687;
	j2665980821 [label="不，我们没有。[结束]",shape=box,color=red];
		j2665980821 -> "Chat ends.";
	j2118707449 [label="怎么突然说起这个了？",shape=box,color=red];
		j2118707449 -> j1219274626;
	j3974411816 [label="你小时候都玩什么？",shape=box,color=red];
		j3974411816 -> j960693628;
	j3291929481 [label="我们玩的游戏有不同的叫法，但我确实有玩具。",shape=box,color=red];
		j3291929481 -> j3194418494;
	j4062361687 [label="有啊，我们当然有。 ",shape=box,color=red];
		j4062361687 -> j1285000899;
	"Chat ends." [color=orange];
	j1219274626 [label="其实是因为我看到阿米尔在玩他的一款街机游戏。 ",shape=box,color=blue];
		j1219274626 -> j1817469775;
	j960693628 [label="令人欣慰的是，尽管我们的文化存在很多差异，但孩子们仍然只是……坐下来玩玩具。",shape=box,color=blue];
		j960693628 -> j86171261;
	j3194418494 [label="比如什么？",shape=box,color=blue];
		j3194418494 -> j4194220755;
		j3194418494 -> j1756829622;
	j1817469775 [label="然后我就在想——要是能再次拥有这样的快乐，我愿意付出一切。",shape=box,color=blue];
		j1817469775 -> j3601599718;
	j86171261 [label="我有一个玩偶。安格斯玩偶。他是个士兵，一点也不稀奇。",shape=box,color=blue];
		j86171261 -> j1518930234;
	j4194220755 [label="各种各样的小玩偶、毛绒玩具和积木。典型的小孩子玩意儿。 ",shape=box,color=red];
		j4194220755 -> j960693628;
	j1756829622 [label="我有这样一个——我想你可以称它为小玩偶——禁卫小孩，嗯，我用我一本书里的一个角色的名字来命名它。士魂大帝。",shape=box,color=red];
		j1756829622 -> j1893299575;
	j3601599718 [label="我从来没有因为碧、阿米尔，甚至现在的卡娅喜欢玩那些“幼稚”的东西而看不起他们。我从来不觉得这有什么问题。",shape=box,color=blue];
		j3601599718 -> j1195026337;
	j1518930234 [label="在一次仲冬节庆典上，一群大男孩从我这偷走了它，还有一堆我的其他玩具，然后……",shape=box,color=blue];
		j1518930234 -> j1898201854;
	j1893299575 [label="哦，不好。我早该知道的。很抱歉又提起这件事。",shape=box,color=blue];
		j1893299575 -> j1327384268;
		j1893299575 -> j2536920687;
	j1195026337 [label="但有时我担心，我身上能够感受到这种感觉的那部分，很久以前就已经蜷缩起来消亡了。",shape=box,color=blue];
		j1195026337 -> j1084069282;
	j1898201854 [label="说来话长。但长话短说？他们说我“年纪太大了”，不适合玩洋娃娃。那是我最后一次玩玩具了。",shape=box,color=blue];
		j1898201854 -> j560492401;
	j1327384268 [label="我不想谈这个话题。",shape=box,color=red];
		j1327384268 -> j2301995460;
	j2536920687 [label="没关系，这不是你的错。",shape=box,color=red];
		j2536920687 -> j2620279919;
	j1084069282 [label="这有点悲哀，不是吗？我们告诉孩子们要热爱某样东西，然后又告诉他们，等他们“成熟”了就该放弃。",shape=box,color=blue];
		j1084069282 -> j2800565780;
		j1084069282 -> j1415812557;
	j560492401 [label="前几天，我看阿米尔玩他的一款游戏。看得出来他有多喜欢这个游戏，它给他带来多少快乐。我有点嫉妒，我的生活中竟然没有这样的东西。",shape=box,color=blue];
		j560492401 -> j1084069282;
	j2301995460 [label="我这下简直像个白痴。",shape=box,color=blue];
		j2301995460 -> "Chat ends.";
	j2620279919 [label="我想，你能想到的普通玩具，我们都有。积木、毛绒玩具、小玩偶、洋娃娃。",shape=box,color=red];
		j2620279919 -> j43453300;
	j2800565780 [label="我不知道。我们终究要长大。我们不能用幻想来掩饰自己。我吃过不少苦头才明白这一点。",shape=box,color=red];
		j2800565780 -> j2103004420;
	j1415812557 [label="我认为人生可以是丑陋的、痛苦的、短暂的。我们应该用尽可能多的乐趣、欢笑和爱来充实它。",shape=box,color=red];
		j1415812557 -> j3518555605;
	j43453300 [label="只是我的玩具变得比较棘手，因为这一整个……虚空的事情。",shape=box,color=red];
		j43453300 -> j960693628;
	j2103004420 [label="你说得有道理。我觉得如果它变成了现实的替代品，就会出问题。不过我可没这么建议啊。",shape=box,color=blue];
		j2103004420 -> j1984660260;
	j3518555605 [label="你说得对。我希望我们都能铭记这一点，当我们一起走下去的时候……无论我们身处何方的时候。",shape=box,color=blue];
		j3518555605 -> j1984660260;
	j1984660260 [label="你知道吗，我发现埃莉诺、维利米尔、碧和阿米尔，跟弗莱尔和丽兹玩捉迷藏。（昆西说他们不让他玩，因为那混蛋作弊，用瞄准镜透视墙壁。）",shape=box,color=blue];
		j1984660260 -> j3734193305;
	j3734193305 [label="他们都看着我，担心我会不高兴，因为我撞见了他们在该干正事的时候瞎混。",shape=box,color=blue];
		j3734193305 -> j1471281945;
	j1471281945 [label="其实我更难过的是没被邀请。呵呵。不过我得装出一副领导不爽的样子，假装因为没人守岗而生气之类的。",shape=box,color=blue];
		j1471281945 -> j2258852437;
	j2258852437 [label="阿米尔有他的游戏。碧有线上时代。就连卡娅也有她的贴纸和吉尼梦，尽管这个世界让她变得早熟。",shape=box,color=blue];
		j2258852437 -> j572945660;
		j2258852437 -> j2028947750;
	j572945660 [label="你想表达什么观点吗？",shape=box,color=red];
		j572945660 -> j686814669;
	j2028947750 [label="我觉得只要你努力，就能找回。我的意思是，在玩具和游戏中寻找快乐。",shape=box,color=red];
		j2028947750 -> j3138418181;
	j686814669 [label="老实说？我自己都不知道。我只是觉得我失去了什么东西，一些很久以前就从我生活中消失的东西。",shape=box,color=blue];
		j686814669 -> j2717790763;
	j3138418181 [label="我仿佛已经听到他们在笑我了。不过我想这才是真正让我迟迟不敢踏出那一步的原因吧？尴尬。",shape=box,color=blue];
		j3138418181 -> j642953724;
	j2717790763 [label="我不确定我是否还能找回它。或者说，它是否已经离我太远了。但谁知道呢。只要有足够的时间，也许一切皆有可能。",shape=box,color=blue];
		j2717790763 -> "Chat ends.";
	j642953724 [label="就算我能克服那一瞬间的羞耻感，我也不确定还能不能把它找回来。不过谁知道呢。只要循环足够多，也许一切皆有可能。",shape=box,color=blue];
		j642953724 -> "Chat ends.";
}