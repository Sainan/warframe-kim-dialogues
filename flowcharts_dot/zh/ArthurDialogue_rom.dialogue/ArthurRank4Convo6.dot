	3007 [label="我觉得会很有趣，而且对我们所有人来说也是一次很好的增进感情的经历。",shape=box,color=red];
		3007 -> 3010;
	3008 [label="他觉得自己不格格不入——不是军事人员，又是个书呆子，有点局外人的感觉。如果我们都坐下来和他一起玩他的游戏，对他来说意义重大。",shape=box,color=red];
