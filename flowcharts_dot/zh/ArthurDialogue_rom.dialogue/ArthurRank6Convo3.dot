digraph {
	3360 [label="ArthurRank6Convo3 begins.",color=orange];
		3360 -> 3361;
	3361 [label="我前几天和那个吉他说话了。",shape=box,color=blue];
		3361 -> 3362;
		3361 -> 3363;
	3362 [label="就我个人而言，我不太喜欢。",shape=box,color=red];
		3362 -> 3364;
	3363 [label="丽兹？聊得怎么样？",shape=box,color=red];
		3363 -> 3365;
	3364 [label="老实说，我挺喜欢她的。只要你克服了……那种……怪异的感觉……？",shape=box,color=blue];
		3364 -> 3366;
	3365 [label="比我想象的要好。我挺喜欢她的。",shape=box,color=blue];
		3365 -> 3366;
	3366 [label="再说了，",shape=box,color=blue];
		3366 -> 3367;
	3367 [label="她和埃莉诺似乎总是在笑一些别人听不到的笑话。",shape=box,color=blue];
		3367 -> 3368;
	3368 [label="我觉得我应该去好好介绍一下我自己。",shape=box,color=blue];
		3368 -> 3369;
	3369 [label="她有很多很有用的见解。弗莱尔也很棒。说实话，酒吧里那群人真是让人耳目一新。 ",shape=box,color=blue];
		3369 -> 3370;
	3370 [label="嗯。只是打个比方。",shape=box,color=blue];
		3370 -> 3371;
		3370 -> 3372;
		3370 -> 3373;
	3371 [label="你已经厌倦了六人组吗？",shape=box,color=red];
		3371 -> 3374;
	3372 [label="她有什么见解？",shape=box,color=red];
		3372 -> 3375;
	3373 [label="我很高兴你交到了朋友。哈哈。 ",shape=box,color=red];
		3373 -> 3376;
	3374 [label="什么？不！当然不是。",shape=box,color=blue];
		3374 -> 3377;
	3375 [label="令人着迷的见解，关于这一年已经循环了多少次。",shape=box,color=blue];
		3375 -> 3378;
	3376 [label="我想，能和一些没有一起经历太多的人聊聊天，也挺好的。",shape=box,color=blue];
		3376 -> 3379;
	3377 [label="六人组是我的家人。我的团队。你知道的。",shape=box,color=blue];
		3377 -> 3376;
	3378 [label="我或许忘记了多少次过去的岁月。但她是如何……超脱时间而活的？而为何我们却不是这样的。",shape=box,color=blue];
		3378 -> 3380;
	3379 [label="我不知道这样说合不合理。我了解他们，也信任他们，只是我没有和他们一起经历过什么*地狱般的磨难*。",shape=box,color=blue];
		3379 -> 3381;
	3380 [label="在你开口之前，我先告诉你，不。我不想知道。我也没有权利知道。",shape=box,color=blue];
		3380 -> 3382;
	3381 [label="所以有时候和他们一起坐着喝酒反而更轻松。",shape=box,color=blue];
		3381 -> 3383;
		3381 -> 3384;
		3381 -> 3385;
	3382 [label="我只是想说——不管你有没有？没关系。我不会怪你的。",shape=box,color=blue];
		3382 -> 3386;
	3383 [label="我倒是从来都没得选。",shape=box,color=red];
		3383 -> 3387;
	3384 [label="是啊，我懂。",shape=box,color=red];
		3384 -> 3388;
	3385 [label="他们当中一些人年纪比较大，并且有军事经验，这也有帮助。",shape=box,color=red];
		3385 -> 3389;
	3386 [label="我们的处境？并不正常。我们，我指的是人类，本就不是为了这种事情而生的。",shape=box,color=blue];
		3386 -> 3390;
	3387 [label="我想也是。",shape=box,color=blue];
		3387 -> 3391;
	3388 [label="没有那么多的……负担。没有那么多过去。也就是阿米尔所说的包袱。",shape=box,color=blue];
		3388 -> 3391;
	3389 [label="天。没错。一开始我还不知道自由国人是怎么样的。现在嘛？很高兴他们来了。",shape=box,color=blue];
		3389 -> 3391;
	3390 [label="这种事情又没有指南。无论你选择做什么，我相信你都有充分的理由去做。",shape=box,color=blue];
		3390 -> 3392;
	3391 [label="但这一切让我不禁会想到。",shape=box,color=blue];
		3391 -> 3393;
		3391 -> 3394;
	3392 [label="Check boolean ArthurDating",color=orange];
		3392 -> 3396 [label=true,color=green];
		3392 -> 3395 [label=false,color=brown];
	3393 [label="呃哦。",shape=box,color=red];
		3393 -> 3397;
	3394 [label="什么？",shape=box,color=red];
		3394 -> 3398;
	3396 [label="我爱你。即使我忘了？即使你选择走另一条路？也没关系。",shape=box,color=blue];
		3396 -> 3400;
	3395 [label="我把我的生命托付给你。没有什么能改变这一点。即使我暂时忘记了。",shape=box,color=blue];
		3395 -> 3399;
	3397 [label="呵。听我说完。这可是关于你的。",shape=box,color=blue];
		3397 -> 3401;
	3398 [label="想到你。 ",shape=box,color=blue];
		3398 -> 3401;
	3400 [label="在你来这里之前，我想我无法接受那种事。我会害怕失去你。失去这一切。",shape=box,color=blue];
		3400 -> 3402;
	3399 [label="在你来这里之前，我想我无法接受那种事。我会害怕失去属于自己的一部分。",shape=box,color=blue];
		3399 -> 3402;
	3401 [label="这一整个……循环往复的时间线。这让我不禁思考，有多少个 1999 年可能已经被我遗忘了。",shape=box,color=blue];
		3401 -> 3403;
		3401 -> 3404;
		3401 -> 3405;
	3402 [label="我想要紧紧抓住它，就像一个绝望的人在海上紧紧抓住木筏一样。但也许我已经陷入这种循环太多次了，又或者……也许只有你是这样，我不知道。",shape=box,color=blue];
		3402 -> 3406;
	3403 [label="我发誓，吉他告诉你的一切都只是诽谤。",shape=box,color=red];
		3403 -> 3407;
	3404 [label="我有麻烦了吗？",shape=box,color=red];
		3404 -> 3407;
	3405 [label="亚瑟，我……我想我们还是别谈这个了。",shape=box,color=red];
		3405 -> 3407;
	3406 [label="你给我带来的这份幸福——这份平静——此刻的它们的价值已经远超于它是否会永远持续下去。",shape=box,color=blue];
		3406 -> 3408;
	3407 [label="等一下，好吗？你知道我打字比你慢。",shape=box,color=blue];
		3407 -> 3409;
	3408 [label="如果说作为一名士兵，你在生活中能学到的一件事，就是一切都是短暂的。",shape=box,color=blue];
		3408 -> 3410;
	3409 [label="我想说的是：",shape=box,color=blue];
		3409 -> 3411;
	3410 [label="前一秒还在，后一秒就过去了。我想我已经接受了这个现实。就这样。",shape=box,color=blue];
		3410 -> 3412;
	3411 [label="无论你是否让我，或者六人组的其他人，忘记了我们过去的互动？其实没关系的。",shape=box,color=blue];
		3411 -> 3413;
	3412 [label="所以，在你捶完地板，我忘记了一切之后，我们在一起的时光是不是也会随之结束？",shape=box,color=blue];
		3412 -> 3414;
	3413 [label="我不会怨你。",shape=box,color=blue];
		3413 -> 3386;
	3414 [label="还是说我们的时光会因为哪一天虚空无情之物突然抓到你了而结束？",shape=box,color=blue];
		3414 -> 3415;
	3415 [label="我要珍惜当下。这里和此时此刻。因为这是我所拥有的。",shape=box,color=blue];
		3415 -> 3416;
	3416 [label="这也是我唯一可以确定的事情。",shape=box,color=blue];
		3416 -> 3417;
		3416 -> 3418;
		3416 -> 3419;
	3417 [label="并不是针对你。主要是因为我跟你姐姐约会时总是搞砸。:P",shape=box,color=red];
		3417 -> 3420;
	3418 [label="亚瑟，谢谢你……这对我来说很重要，重要到超出了我的想象。",shape=box,color=red];
		3418 -> 3421;
	3419 [label="我希望有时候我能有你这样冷静的头脑。 <3",shape=box,color=red];
		3419 -> 3422;
	3420 [label="哈哈。好吧，还好你有这种神奇的超能力，能把卡在气管里的脚复原，不是吗？",shape=box,color=blue];
		3420 -> 3423;
	3421 [label="有时，我会试着不那么正经，说点有意义的话。",shape=box,color=blue];
		3421 -> 3424;
	3422 [label="更是因为我知道，我实际上别无选择，只能强颜欢笑。这就是不列颠尼克人的行事作风。 ",shape=box,color=blue];
		3422 -> 3425;
	3423 [label="我们其他人还需要学会如何去沟通。不过，这倒是个问题。",shape=box,color=blue];
		3423 -> 3426;
	3424 [label="嗯，我想该喝点东西了。去吗？",shape=box,color=blue];
		3424 -> 3427;
		3424 -> 3428;
	3425 [label="正如俗话说的，“保持镇定，继续前进。”",shape=box,color=blue];
		3425 -> 3424;
	3426 [label="每次重置后她都会降低自己的标准吗？",shape=box,color=blue];
		3426 -> 3429;
	3427 [label="也许过会儿吧。",shape=box,color=red];
		3427 -> 3430;
	3428 [label="到那儿见。:)",shape=box,color=red];
		3428 -> 3431;
	3429 [label="Chat ends.",color=orange];
	3430 [label="随你。",shape=box,color=blue];
		3430 -> 3432;
	3431 [label="Chat ends.",color=orange];
	3432 [label="Chat ends.",color=orange];
