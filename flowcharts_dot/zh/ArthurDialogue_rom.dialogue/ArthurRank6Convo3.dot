digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo3 begins." [color=orange];
		"ArthurRank6Convo3 begins." -> j741521367;
	j741521367 [label="我前几天和那个吉他说话了。",shape=box,color=blue];
		j741521367 -> j2302561431;
		j741521367 -> j4177848;
	j2302561431 [label="就我个人而言，我不太喜欢。",shape=box,color=red];
		j2302561431 -> j702782920;
	j4177848 [label="丽兹？聊得怎么样？",shape=box,color=red];
		j4177848 -> j1244592331;
	j702782920 [label="老实说，我挺喜欢她的。只要你克服了……那种……怪异的感觉……？",shape=box,color=blue];
		j702782920 -> j3997128412;
	j1244592331 [label="比我想象的要好。我挺喜欢她的。",shape=box,color=blue];
		j1244592331 -> j3997128412;
	j3997128412 [label="再说了，",shape=box,color=blue];
		j3997128412 -> j251272580;
	j251272580 [label="她和埃莉诺似乎总是在笑一些别人听不到的笑话。",shape=box,color=blue];
		j251272580 -> j2890878416;
	j2890878416 [label="我觉得我应该去好好介绍一下我自己。",shape=box,color=blue];
		j2890878416 -> j428790096;
	j428790096 [label="她有很多很有用的见解。弗莱尔也很棒。说实话，酒吧里那群人真是让人耳目一新。 ",shape=box,color=blue];
		j428790096 -> j45864780;
	j45864780 [label="嗯。只是打个比方。",shape=box,color=blue];
		j45864780 -> j2482446466;
		j45864780 -> j1956082583;
		j45864780 -> j3850186281;
	j2482446466 [label="你已经厌倦了六人组吗？",shape=box,color=red];
		j2482446466 -> j3648276653;
	j1956082583 [label="她有什么见解？",shape=box,color=red];
		j1956082583 -> j2784899470;
	j3850186281 [label="我很高兴你交到了朋友。哈哈。 ",shape=box,color=red];
		j3850186281 -> j1459944245;
	j3648276653 [label="什么？不！当然不是。",shape=box,color=blue];
		j3648276653 -> j391951989;
	j2784899470 [label="令人着迷的见解，关于这一年已经循环了多少次。",shape=box,color=blue];
		j2784899470 -> j1244126055;
	j1459944245 [label="我想，能和一些没有一起经历太多的人聊聊天，也挺好的。",shape=box,color=blue];
		j1459944245 -> j1535781037;
	j391951989 [label="六人组是我的家人。我的团队。你知道的。",shape=box,color=blue];
		j391951989 -> j1459944245;
	j1244126055 [label="我或许忘记了多少次过去的岁月。但她是如何……超脱时间而活的？而为何我们却不是这样的。",shape=box,color=blue];
		j1244126055 -> j4144275441;
	j1535781037 [label="我不知道这样说合不合理。我了解他们，也信任他们，只是我没有和他们一起经历过什么*地狱般的磨难*。",shape=box,color=blue];
		j1535781037 -> j4118234998;
	j4144275441 [label="在你开口之前，我先告诉你，不。我不想知道。我也没有权利知道。",shape=box,color=blue];
		j4144275441 -> j2041661364;
	j4118234998 [label="所以有时候和他们一起坐着喝酒反而更轻松。",shape=box,color=blue];
		j4118234998 -> j1465023810;
		j4118234998 -> j1124269359;
		j4118234998 -> j1699005268;
	j2041661364 [label="我只是想说——不管你有没有？没关系。我不会怪你的。",shape=box,color=blue];
		j2041661364 -> j2009529896;
	j1465023810 [label="我倒是从来都没得选。",shape=box,color=red];
		j1465023810 -> j1188934966;
	j1124269359 [label="是啊，我懂。",shape=box,color=red];
		j1124269359 -> j3316197012;
	j1699005268 [label="他们当中一些人年纪比较大，并且有军事经验，这也有帮助。",shape=box,color=red];
		j1699005268 -> j2090870970;
	j2009529896 [label="我们的处境？并不正常。我们，我指的是人类，本就不是为了这种事情而生的。",shape=box,color=blue];
		j2009529896 -> j2238400120;
	j1188934966 [label="我想也是。",shape=box,color=blue];
		j1188934966 -> j95854493;
	j3316197012 [label="没有那么多的……负担。没有那么多过去。也就是阿米尔所说的包袱。",shape=box,color=blue];
		j3316197012 -> j95854493;
	j2090870970 [label="天。没错。一开始我还不知道自由国人是怎么样的。现在嘛？很高兴他们来了。",shape=box,color=blue];
		j2090870970 -> j95854493;
	j2238400120 [label="这种事情又没有指南。无论你选择做什么，我相信你都有充分的理由去做。",shape=box,color=blue];
		j2238400120 -> j2674809731;
	j95854493 [label="但这一切让我不禁会想到。",shape=box,color=blue];
		j95854493 -> j4232729207;
		j95854493 -> j2771431628;
	j2674809731 [label="Check boolean ArthurDating",color=orange];
		j2674809731 -> j2651298451 [label=true,color=green];
		j2674809731 -> j2317538663 [label=false,color=brown];
	j4232729207 [label="呃哦。",shape=box,color=red];
		j4232729207 -> j2035251004;
	j2771431628 [label="什么？",shape=box,color=red];
		j2771431628 -> j247727457;
	j2651298451 [label="我爱你。即使我忘了？即使你选择走另一条路？也没关系。",shape=box,color=blue];
		j2651298451 -> j1908335667;
	j2317538663 [label="我把我的生命托付给你。没有什么能改变这一点。即使我暂时忘记了。",shape=box,color=blue];
		j2317538663 -> j576592201;
	j2035251004 [label="呵。听我说完。这可是关于你的。",shape=box,color=blue];
		j2035251004 -> j4024034915;
	j247727457 [label="想到你。 ",shape=box,color=blue];
		j247727457 -> j4024034915;
	j1908335667 [label="在你来这里之前，我想我无法接受那种事。我会害怕失去你。失去这一切。",shape=box,color=blue];
		j1908335667 -> j739451604;
	j576592201 [label="在你来这里之前，我想我无法接受那种事。我会害怕失去属于自己的一部分。",shape=box,color=blue];
		j576592201 -> j739451604;
	j4024034915 [label="这一整个……循环往复的时间线。这让我不禁思考，有多少个 1999 年可能已经被我遗忘了。",shape=box,color=blue];
		j4024034915 -> j3863355668;
		j4024034915 -> j2646935673;
		j4024034915 -> j3791507871;
	j739451604 [label="我想要紧紧抓住它，就像一个绝望的人在海上紧紧抓住木筏一样。但也许我已经陷入这种循环太多次了，又或者……也许只有你是这样，我不知道。",shape=box,color=blue];
		j739451604 -> j957894615;
	j3863355668 [label="我发誓，吉他告诉你的一切都只是诽谤。",shape=box,color=red];
		j3863355668 -> j1211675983;
	j2646935673 [label="我有麻烦了吗？",shape=box,color=red];
		j2646935673 -> j1211675983;
	j3791507871 [label="亚瑟，我……我想我们还是别谈这个了。",shape=box,color=red];
		j3791507871 -> j1211675983;
	j957894615 [label="你给我带来的这份幸福——这份平静——此刻的它们的价值已经远超于它是否会永远持续下去。",shape=box,color=blue];
		j957894615 -> j2065352679;
	j1211675983 [label="等一下，好吗？你知道我打字比你慢。",shape=box,color=blue];
		j1211675983 -> j1862345762;
	j2065352679 [label="如果说作为一名士兵，你在生活中能学到的一件事，就是一切都是短暂的。",shape=box,color=blue];
		j2065352679 -> j2900978295;
	j1862345762 [label="我想说的是：",shape=box,color=blue];
		j1862345762 -> j1093351487;
	j2900978295 [label="前一秒还在，后一秒就过去了。我想我已经接受了这个现实。就这样。",shape=box,color=blue];
		j2900978295 -> j3012818710;
	j1093351487 [label="无论你是否让我，或者六人组的其他人，忘记了我们过去的互动？其实没关系的。",shape=box,color=blue];
		j1093351487 -> j3690389401;
	j3012818710 [label="所以，在你捶完地板，我忘记了一切之后，我们在一起的时光是不是也会随之结束？",shape=box,color=blue];
		j3012818710 -> j2981766074;
	j3690389401 [label="我不会怨你。",shape=box,color=blue];
		j3690389401 -> j2009529896;
	j2981766074 [label="还是说我们的时光会因为哪一天虚空无情之物突然抓到你了而结束？",shape=box,color=blue];
		j2981766074 -> j3001423503;
	j3001423503 [label="我要珍惜当下。这里和此时此刻。因为这是我所拥有的。",shape=box,color=blue];
		j3001423503 -> j2728464638;
	j2728464638 [label="这也是我唯一可以确定的事情。",shape=box,color=blue];
		j2728464638 -> j1445554088;
		j2728464638 -> j1068572725;
		j2728464638 -> j726795338;
	j1445554088 [label="并不是针对你。主要是因为我跟你姐姐约会时总是搞砸。:P",shape=box,color=red];
		j1445554088 -> j2808461572;
	j1068572725 [label="亚瑟，谢谢你……这对我来说很重要，重要到超出了我的想象。",shape=box,color=red];
		j1068572725 -> j4163218555;
	j726795338 [label="我希望有时候我能有你这样冷静的头脑。 <3",shape=box,color=red];
		j726795338 -> j1992440263;
	j2808461572 [label="哈哈。好吧，还好你有这种神奇的超能力，能把卡在气管里的脚复原，不是吗？",shape=box,color=blue];
		j2808461572 -> j2832385442;
	j4163218555 [label="有时，我会试着不那么正经，说点有意义的话。",shape=box,color=blue];
		j4163218555 -> j1352219662;
	j1992440263 [label="更是因为我知道，我实际上别无选择，只能强颜欢笑。这就是不列颠尼克人的行事作风。 ",shape=box,color=blue];
		j1992440263 -> j1953080053;
	j2832385442 [label="我们其他人还需要学会如何去沟通。不过，这倒是个问题。",shape=box,color=blue];
		j2832385442 -> j241209697;
	j1352219662 [label="嗯，我想该喝点东西了。去吗？",shape=box,color=blue];
		j1352219662 -> j2045942466;
		j1352219662 -> j2237943523;
	j1953080053 [label="正如俗话说的，“保持镇定，继续前进。”",shape=box,color=blue];
		j1953080053 -> j1352219662;
	j241209697 [label="每次重置后她都会降低自己的标准吗？",shape=box,color=blue];
		j241209697 -> "Chat ends.";
	j2045942466 [label="也许过会儿吧。",shape=box,color=red];
		j2045942466 -> j3000096968;
	j2237943523 [label="到那儿见。:)",shape=box,color=red];
		j2237943523 -> "Chat ends.";
	"Chat ends." [color=orange];
	j3000096968 [label="随你。",shape=box,color=blue];
		j3000096968 -> "Chat ends.";
}