	3530 [label="你接触过的最恐怖的战甲是哪个？",shape=box,color=blue];
		3530 -> 3531;
		3530 -> 3532;
		3530 -> 3533;
		3530 -> 3534;
		3530 -> 3535;
	3531 [label="Sevagoth。他以死者的灵魂为食，从而起死回生。",shape=box,color=red];
		3531 -> 3536;
	3532 [label="Nidus。由纯正、不掺杂的感染者制成。",shape=box,color=red];
		3532 -> 3536;
	3533 [label="Kullervo。被他自己的匕首刺穿。",shape=box,color=red];
		3533 -> 3536;
	3534 [label="Xaku。三款战甲，从根本上粘在一起，由虚空之灵驱动。",shape=box,color=red];
		3534 -> 3536;
	3535 [label="Grendel。他把人整个吃掉，然后把他们溶解。",shape=box,color=red];
		3535 -> 3536;
	3536 [label="为什么问这个？",shape=box,color=red];
		3536 -> 3537;
	3537 [label="……我只是想弄清楚炽蛇军通讯时在喊什么。",shape=box,color=blue];
