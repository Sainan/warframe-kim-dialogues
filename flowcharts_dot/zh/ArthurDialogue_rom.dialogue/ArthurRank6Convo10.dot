digraph {
	3571 [label="ArthurRank6Convo10 begins.",color=orange];
		3571 -> 3572;
		3571 -> 3573;
	3572 [label="嘿！亚瑟。最近怎么样？",shape=box,color=red];
		3572 -> 3574;
	3573 [label="你今天要做什么？",shape=box,color=red];
		3573 -> 3575;
	3574 [label="我做了一个蠢决定，和阿米尔玩《奥利的极速赛道》。",shape=box,color=blue];
		3574 -> 3576;
	3575 [label="我和昆西准备一起出去侦察。这是他的主意，不是我的。",shape=box,color=blue];
		3575 -> 3577;
	3576 [label="然后我现在很气，他一直在破我的记录。",shape=box,color=blue];
		3576 -> 3578;
	3577 [label="我们的关系，很奇怪。我们说的话不多。",shape=box,color=blue];
		3577 -> 3579;
	3578 [label="……我这两天花了二十六个小时玩这游戏。",shape=box,color=blue];
		3578 -> 3580;
	3579 [label="但我们都知道，如果真的到了那一步，我们愿意为彼此而死。",shape=box,color=blue];
		3579 -> 3581;
	3580 [label="要是我再靠近那台该死的东西，请让莱蒂给我注射镇静剂。",shape=box,color=blue];
		3580 -> 3582;
	3581 [label="我想有时候，这就是家人的意义，“不是吗？”",shape=box,color=blue];
		3581 -> 3583;
	3582 [label="Chat ends.",color=orange];
	3583 [label="Chat ends.",color=orange];
}