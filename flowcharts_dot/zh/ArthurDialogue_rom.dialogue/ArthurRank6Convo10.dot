digraph {
	"ArthurRank6Convo10 begins." [color=orange];
		"ArthurRank6Convo10 begins." -> j1234001653;
		"ArthurRank6Convo10 begins." -> j3893561927;
	j1234001653 [label="嘿！亚瑟。最近怎么样？",shape=box,color=red];
		j1234001653 -> j2325409687;
	j3893561927 [label="你今天要做什么？",shape=box,color=red];
		j3893561927 -> j1572817213;
	j2325409687 [label="我做了一个蠢决定，和阿米尔玩《奥利的极速赛道》。",shape=box,color=blue];
		j2325409687 -> j3551599018;
	j1572817213 [label="我和昆西准备一起出去侦察。这是他的主意，不是我的。",shape=box,color=blue];
		j1572817213 -> j79800600;
	j3551599018 [label="然后我现在很气，他一直在破我的记录。",shape=box,color=blue];
		j3551599018 -> j456321235;
	j79800600 [label="我们的关系，很奇怪。我们说的话不多。",shape=box,color=blue];
		j79800600 -> j2149850707;
	j456321235 [label="……我这两天花了二十六个小时玩这游戏。",shape=box,color=blue];
		j456321235 -> j3335553045;
	j2149850707 [label="但我们都知道，如果真的到了那一步，我们愿意为彼此而死。",shape=box,color=blue];
		j2149850707 -> j3499652693;
	j3335553045 [label="要是我再靠近那台该死的东西，请让莱蒂给我注射镇静剂。",shape=box,color=blue];
		j3335553045 -> "Chat ends.";
	j3499652693 [label="我想有时候，这就是家人的意义，“不是吗？”",shape=box,color=blue];
		j3499652693 -> "Chat ends.";
	"Chat ends." [color=orange];
}