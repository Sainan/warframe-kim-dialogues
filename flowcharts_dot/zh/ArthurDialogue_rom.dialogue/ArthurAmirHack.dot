digraph {
	2929 [label="ArthurAmirHack begins.",color=orange];
		2929 -> 2930;
	2930 [label="嘿——……亚瑟……怎么样？",shape=box,color=red];
		2930 -> 2927;
	2927 [label="br00dsw0rd: 嗯？哦，很好。你呢？",shape=box,color=blue];
		2927 -> 2931;
		2927 -> 2932;
		2927 -> 2933;
	2931 [label="太好了——那——……最近有什么新鲜事吗？",shape=box,color=red];
		2931 -> 2928;
	2932 [label="咱们赶上的这是什么破天气，哈？",shape=box,color=red];
		2932 -> 2934;
	2933 [label="那个当地运动队呢，怎么样？",shape=box,color=red];
		2933 -> 2935;
	2928 [label="br00dsw0rd: 伙计，我们一小时前刚聊过，关于——",shape=box,color=blue];
		2928 -> 2936;
	2934 [label="br00dsw0rd: 没那么有趣，因为每次都——",shape=box,color=blue];
		2934 -> 2936;
	2935 [label="br00dsw0rd: 什么当地运动队——",shape=box,color=blue];
		2935 -> 2936;
	2936 [label="br00dsw0rd: 发生什么事了？你怪怪的。",shape=box,color=blue];
		2936 -> 2937;
		2936 -> 2938;
	2937 [label="……没发生什么。",shape=box,color=red];
		2937 -> 2939;
	2938 [label="阿米尔又无聊了。看看你的昵称。",shape=box,color=red];
		2938 -> 2941;
	2939 [label="br00dsw0rd: 我才不信你呢，我——",shape=box,color=blue];
		2939 -> 2940;
	2941 [label="br00dsw0rd: 愁剑？！",shape=box,color=blue];
		2941 -> 2942;
	2940 [label="br00dsw0rd: 等等。",shape=box,color=blue];
		2940 -> 2941;
	2942 [label="br00dsw0rd: 我——不——愁！",shape=box,color=blue];
		2942 -> 2943;
		2942 -> 2944;
		2942 -> 2945;
	2943 [label=":| 哥们儿。那个图标可不是这个意思。",shape=box,color=red];
		2943 -> 2946;
	2944 [label="明明就有。",shape=box,color=red];
		2944 -> 2947;
	2945 [label="诶，他只是在开玩笑。你知道他很崇拜你的。哈哈",shape=box,color=red];
		2945 -> 2947;
	2946 [label="br00dsw0rd: ……好吧。好吧。可能我有点愁吧。",shape=box,color=blue];
		2946 -> 2948;
	2947 [label="br00dsw0rd: 唉。",shape=box,color=blue];
		2947 -> 2948;
	2948 [label="br00dsw0rd: 就……让他改回来，可以吗？在别人注意之前。",shape=box,color=blue];
		2948 -> 2950;
	2950 [label="+20 Chemistry",color=orange];
		2950 -> 2949;
	2949 [label="br00dsw0rd: 那小子就是游手好闲的典范……我们得给他找点爱好……",shape=box,color=blue];
		2949 -> 241;
