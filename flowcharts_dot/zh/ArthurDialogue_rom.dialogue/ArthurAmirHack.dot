		j378078706 -> j868563280;
	j2785814203 [label="br00dsw0rd: 什么当地运动队——",shape=box,color=blue];
		j2785814203 -> j868563280;
	j868563280 [label="br00dsw0rd: 发生什么事了？你怪怪的。",shape=box,color=blue];
		j868563280 -> j2324394209;
