	1524 [label="我已经开始后悔找你了……",shape=box,color=blue];
		1524 -> 1530;
	1532 [label="你对我已经够有耐心的了。如果你还想听我为什么离开不列颠尼克军队的故事……我现在估计欠你两次解释。",shape=box,color=blue];
