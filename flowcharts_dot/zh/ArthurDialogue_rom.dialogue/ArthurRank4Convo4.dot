	1573 [label="哦，那我们都能买个热水浴缸了！",shape=box,color=red];
		1573 -> 1578;
	1574 [label="我就是……做不到。六人组的其他人也做不到。所以——我们就到了现在这个局面。",shape=box,color=blue];
