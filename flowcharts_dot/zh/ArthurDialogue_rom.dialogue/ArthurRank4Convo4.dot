		1568 -> 1570;
	1569 [label="是的。而且又掉进了同样天真的陷阱。我以为领导会在乎平民。",shape=box,color=blue];
		1569 -> 1571;
	1570 [label="要是每次埃莉诺跟我说这句话我都能得到一块钱的话……",shape=box,color=blue];
		1570 -> 1572;
		1570 -> 1573;
	1571 [label="他们要杀光所有可能被感染的无辜者，无论是真是假。",shape=box,color=blue];
