	1526 [label="怎么了，詹姆斯？",shape=box,color=red];
		1526 -> 1524;
	1530 [label="忍不住，抱歉。:P 你刚才说什么来着？",shape=box,color=red];
		1530 -> 1531;
	1533 [label="如果你确定要说的话。",shape=box,color=red];
		1533 -> 1537;
	1534 [label="我洗耳恭听。",shape=box,color=red];
		1534 -> 1538;
	1535 [label="不了，谢谢。",shape=box,color=red];
		1535 -> 1536;
	1531 [label="呵呵。",shape=box,color=blue];
		1531 -> 1532;
	1537 [label="我确定。",shape=box,color=blue];
		1537 -> 1538;
	1538 [label="每个人参军的理由都不一样。对我来说，我参军是为了……荣誉、为了寻找意义。",shape=box,color=blue];
		1538 -> 1539;
	1536 [label="Chat ends.",color=orange];
	1539 [label="我那时像个该死的蠢货，想要成为英雄。",shape=box,color=blue];
		1539 -> 1540;
	1540 [label="我的意思是，我抱着伟大的理想去参军。",shape=box,color=blue];
		1540 -> 1541;
	1541 [label="认为参军就是保卫王子和国家。",shape=box,color=blue];
		1541 -> 1542;
	1542 [label="但后来我才知道那些全是谎言。",shape=box,color=blue];
		1542 -> 1543;
		1542 -> 1544;
		1542 -> 1545;
	1543 [label="发生了什么？",shape=box,color=red];
		1543 -> 1547;
	1544 [label="哦？",shape=box,color=red];
		1544 -> 1547;
	1545 [label="我得走了。[结束]",shape=box,color=red];
		1545 -> 1546;
	1547 [label="作为一名士兵，你的职责不是思考，而是服从命令。",shape=box,color=blue];
		1547 -> 1548;
	1546 [label="Chat ends.",color=orange];
	1548 [label="不管是什么命令。",shape=box,color=blue];
		1548 -> 1549;
	1549 [label="所以，当我被派到敌占区，并被要求消灭所有“潜在的敌方战斗人员”时？",shape=box,color=blue];
		1549 -> 1550;
	1550 [label="我做了一个优秀士兵该做的事。我服从了命令。",shape=box,color=blue];
		1550 -> 1551;
		1550 -> 1552;
	1551 [label="我大概猜到会发生什么了……",shape=box,color=red];
		1551 -> 1553;
	1552 [label="天，不会吧……",shape=box,color=red];
		1552 -> 1554;
	1553 [label="这不需要多聪明就能猜到。",shape=box,color=blue];
		1553 -> 1555;
	1554 [label="就是这样。",shape=box,color=blue];
		1554 -> 1555;
	1555 [label="我不知道那天我们杀了多少无辜的人。",shape=box,color=blue];
		1555 -> 1556;
	1556 [label="但数量实在太多了。",shape=box,color=blue];
		1556 -> 1557;
	1557 [label="当我四处质问为什么我们要屠杀无辜者时，上级威胁我要把我踢出军队。",shape=box,color=blue];
		1557 -> 1558;
	1558 [label="闭嘴。做好你的工作。开枪。像个优秀士兵那样杀人。",shape=box,color=blue];
		1558 -> 1559;
	1559 [label="不要。问。问题。",shape=box,color=blue];
		1559 -> 1560;
	1560 [label="他们是对的，我不该问问题。我本就不擅长弄清楚事情的真相。",shape=box,color=blue];
		1560 -> 1561;
		1560 -> 1562;
	1561 [label="但——",shape=box,color=red];
		1561 -> 1563;
	1562 [label="亚瑟……",shape=box,color=red];
		1562 -> 1563;
	1563 [label="不，让我说完。我很不擅长解开谜团。但你知道谁擅长吗？",shape=box,color=blue];
		1563 -> 1564;
	1564 [label="谁当过记者？而且当时和各大报社都有联系？",shape=box,color=blue];
		1564 -> 3144;
	3144 [label="*是埃莉诺。*",shape=box,color=blue];
		3144 -> 1565;
	1565 [label="所以很快就达成了共识：要么让我提前退休，要么把真相公之于众。他们觉得我无足轻重，不值得费心思。于是没怎么纠缠就放我走了。",shape=box,color=blue];
		1565 -> 1566;
	1566 [label="Update boolean ArthurSoldierTold",color=orange];
		1566 -> 1567;
