	2046 [label="Update boolean ArthurNoDate",color=orange];
		2046 -> 2047;
	2050 [label="我的一生几乎都是在死亡边缘徘徊。我一直活得如同行尸走肉。",shape=box,color=blue];
		2050 -> 2051;
	2047 [label="Chat ends.",color=orange];
	2051 [label="这从未像现在这样真切过。看看我。我是说，真的*看看我*。",shape=box,color=blue];
