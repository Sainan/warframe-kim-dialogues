		2962 -> 2966;
	2963 [label="他跟我说了他想和大家一起玩的游戏。寓言与边疆？",shape=box,color=red];
		2963 -> 2969;
	2964 [label="他想玩一个很白痴的游戏，我说我会问问大家想不想一起玩。",shape=box,color=red];
