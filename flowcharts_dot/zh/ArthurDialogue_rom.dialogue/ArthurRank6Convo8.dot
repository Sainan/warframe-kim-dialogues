digraph {
	"ArthurRank6Convo8 begins." [color=orange];
		"ArthurRank6Convo8 begins." -> j3637655117;
	j3637655117 [label="你知道吗，我今天早上才意识到一些事情，结果笑到停不下来。",shape=box,color=blue];
		j3637655117 -> j793336931;
		j3637655117 -> j4100676625;
	j793336931 [label="请告诉我。",shape=box,color=red];
		j793336931 -> j533270845;
	j4100676625 [label="哦？是什么？",shape=box,color=red];
		j4100676625 -> j533270845;
	j533270845 [label="维德诺伊居然不知道传识是怎么回事。 ",shape=box,color=blue];
		j533270845 -> j2800644429;
	j2800644429 [label="你就像肯特·克拉克和超级猛男一样，他从来没有见过你的两个战甲出现在同一个地方。",shape=box,color=blue];
		j2800644429 -> j4147073178;
	j4147073178 [label="在他的认知里，有一群……精神失常的超级士兵在和六人组疯跑！",shape=box,color=blue];
		j4147073178 -> j2302202208;
		j4147073178 -> j3643687185;
	j2302202208 [label="他不知道，但还是*会*伤害到他，对吧？ <RETRO_EMOJI_COOLARMSUP>",shape=box,color=red];
		j2302202208 -> j784352955;
	j3643687185 [label="哈哈！！我倒是没想过这个。",shape=box,color=red];
		j3643687185 -> j2875341141;
	j784352955 [label="没错。反正我不会去纠正他。",shape=box,color=blue];
		j784352955 -> j553303218;
	j2875341141 [label="我不打算去纠正他。但我根本无法想象他到底是怎么想的。",shape=box,color=blue];
		j2875341141 -> j553303218;
	j553303218 [label="难怪他对我们这么多疑。哈哈！差点要替这个可怜的小混蛋感到难过了呢。",shape=box,color=blue];
		j553303218 -> j3988000676;
	j3988000676 [label="差点。",shape=box,color=blue];
		j3988000676 -> "Chat ends.";
	"Chat ends." [color=orange];
}