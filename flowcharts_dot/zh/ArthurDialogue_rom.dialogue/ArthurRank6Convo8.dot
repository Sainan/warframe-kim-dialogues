digraph {
	3541 [label="ArthurRank6Convo8 begins.",color=orange];
		3541 -> 3542;
	3542 [label="你知道吗，我今天早上才意识到一些事情，结果笑到停不下来。",shape=box,color=blue];
		3542 -> 3543;
		3542 -> 3544;
	3543 [label="请告诉我。",shape=box,color=red];
		3543 -> 3545;
	3544 [label="哦？是什么？",shape=box,color=red];
		3544 -> 3545;
	3545 [label="维德诺伊居然不知道传识是怎么回事。 ",shape=box,color=blue];
		3545 -> 3546;
	3546 [label="你就像肯特·克拉克和超级猛男一样，他从来没有见过你的两个战甲出现在同一个地方。",shape=box,color=blue];
		3546 -> 3547;
	3547 [label="在他的认知里，有一群……精神失常的超级士兵在和六人组疯跑！",shape=box,color=blue];
		3547 -> 3548;
		3547 -> 3549;
	3548 [label="他不知道，但还是*会*伤害到他，对吧？ <RETRO_EMOJI_COOLARMSUP>",shape=box,color=red];
		3548 -> 3550;
	3549 [label="哈哈！！我倒是没想过这个。",shape=box,color=red];
		3549 -> 3551;
	3550 [label="没错。反正我不会去纠正他。",shape=box,color=blue];
		3550 -> 3552;
	3551 [label="我不打算去纠正他。但我根本无法想象他到底是怎么想的。",shape=box,color=blue];
		3551 -> 3552;
	3552 [label="难怪他对我们这么多疑。哈哈！差点要替这个可怜的小混蛋感到难过了呢。",shape=box,color=blue];
		3552 -> 3553;
	3553 [label="差点。",shape=box,color=blue];
		3553 -> 3554;
	3554 [label="Chat ends.",color=orange];
}