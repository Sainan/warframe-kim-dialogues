		j972778441 -> j1569221931 [label=true,color=green];
		j972778441 -> "Chat ends." [label=false,color=brown];
	j3359901635 [label="亚瑟，我们能聊聊吗？[征求多个伴侣关系的同意]",shape=box,color=red];
		j3359901635 -> j2018314705;
	j2947380706 [label="[结束]",shape=box,color=red];
		j2947380706 -> j3652224286;
	j2018314705 [label="随时都可以。发生什么事了吗？",shape=box,color=blue];
		j2018314705 -> j2045429111;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j2045429111 [label="没，没什么。我只是想跟你谈谈一件事，希望不会让你感到尴尬。",shape=box,color=red];
		j2045429111 -> j1600488360;
	j1600488360 [label="我不想让你陷入一种你无法接受的情况。我知道我们之前没有讨论过这件事。所以如果你拒绝，那也没关系。我希望你清楚这一点。",shape=box,color=red];
		j1600488360 -> j2133406535;
	j2133406535 [label="我们之间的感情对我很重要——非常重要——而且它是真实的。我不希望你怀疑这一点。",shape=box,color=red];
		j2133406535 -> j2684441739;
	j2684441739 [label="啊。我大概知道你要说什么了。你也喜欢上别人了？",shape=box,color=blue];
		j2684441739 -> j3029536006;
		j2684441739 -> j1221935760;
	j3029536006 [label="是的。我知道这可能很难理解，但这并不意味着我对你的感情有任何减少。",shape=box,color=red];
		j3029536006 -> j4099901004;
	j1221935760 [label="是的。但现在想想，我觉得我们或许应该就此结束。[分手]",shape=box,color=red];
		j1221935760 -> j2080568470;
	j4099901004 [label="亲爱的，你真的觉得我在军队待了那么多年，会没见过各种各样的关系吗？",shape=box,color=blue];
		j4099901004 -> j3381344329;
	j2080568470 [label="如果你真的想要那样的话……",shape=box,color=blue];
		j2080568470 -> j3701883258;
	j3381344329 [label="当你的人生长期与死神擦肩而过，你就会知道什么才是生命中真正重要的东西，什么是无关紧要的东西。",shape=box,color=blue];
		j3381344329 -> j2746343122;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j2746343122 [label="所以如果你不再质疑那些划定的界限。我完全理解。",shape=box,color=blue];
		j2746343122 -> j1040030546;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j1040030546 [label="事实是？你对我来说很重要。如果他对你很重要，那么他对我来说也很重要。",shape=box,color=blue];
		j1040030546 -> j1406491472;
	j1406491472 [label="只是。​千万千万，​千万​不​要​是​六​人​组，​好​吗？​如果​这​种​事​发生​在​“家人”​身上，​我​恐怕​受​不​了。​",shape=box,color=blue];
		j1406491472 -> j445455263;
	j445455263 [label="一想到这会让我做噩梦。",shape=box,color=blue];
		j445455263 -> j1754697536;
		j445455263 -> j2425288663;
	j1754697536 [label="好的。我保证。",shape=box,color=red];
		j1754697536 -> j3941766568;
	j2425288663 [label="恕我直言，我觉得你肯定会喜欢他。",shape=box,color=red];
		j2425288663 -> j1968247091;
	j3941766568 [label="谢谢。我希望有一天能见到他。当然，这是出于……私人原因。",shape=box,color=blue];
		j3941766568 -> j1141339274;
	j1968247091 [label="我希望有一天能见到他。当然，这是出于……私人原因。",shape=box,color=blue];
		j1968247091 -> j1141339274;
	j1141339274 [label="+20 Chemistry",color=orange];
		j1141339274 -> j424507146;
	j424507146 [label="亲爱的，在外面一定要照顾好自己。",shape=box,color=blue];
		j424507146 -> j3652224286;
}