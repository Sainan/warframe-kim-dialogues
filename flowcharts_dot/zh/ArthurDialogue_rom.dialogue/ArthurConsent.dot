		j972778441 -> j1569221931 [label=true,color=green];
		j972778441 -> "Chat ends." [label=false,color=brown];
	j2742494526 [label="亚瑟，我们能聊聊吗？[征求是否同意多重伴侣关系]",shape=box,color=red];
		j2742494526 -> j1310855037;
	j2947380706 [label="[结束]",shape=box,color=red];
		j2947380706 -> j3652224286;
	j1310855037 [label="随时都可以。发生什么事了吗？",shape=box,color=blue];
		j1310855037 -> j2158474210;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j2158474210 [label="没，没什么。我只是想跟你谈谈一件事，希望不会让你感到尴尬。",shape=box,color=red];
		j2158474210 -> j3015238764;
	j3015238764 [label="我不想让你陷入一种你无法接受的情况。我知道我们之前没有讨论过这件事。所以如果你拒绝，那也没关系。我希望你清楚这一点。",shape=box,color=red];
		j3015238764 -> j4171157563;
	j4171157563 [label="我们之间的感情对我很重要——非常重要——而且它是真实的。我不希望你怀疑这一点。",shape=box,color=red];
		j4171157563 -> j4210774692;
	j4210774692 [label="啊。我大概知道你要说什么了。你……也喜欢上别人了，是吗？",shape=box,color=blue];
		j4210774692 -> j996049524;
		j4210774692 -> j1221935760;
	j996049524 [label="是的。我知道这可能很难理解，但这并不意味着我对你的感情有任何减少。",shape=box,color=red];
		j996049524 -> j2285833164;
	j1221935760 [label="是的。但现在想想，我觉得我们或许应该就此结束。[分手]",shape=box,color=red];
		j1221935760 -> j2080568470;
	j2285833164 [label="亲爱的，你真的觉得我在军队待了那么多年，会没见过各种各样的关系吗？",shape=box,color=blue];
		j2285833164 -> j3720917173;
	j2080568470 [label="如果你真的想要那样的话……",shape=box,color=blue];
		j2080568470 -> j3701883258;
	j3720917173 [label="当你的人生长期与死神擦肩而过，你就会知道什么才是生命中真正重要的东西，什么是无关紧要的东西。",shape=box,color=blue];
		j3720917173 -> j3440588550;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j3440588550 [label="我不知道这会怎么发展。但你对我很重要，我愿意尝试。",shape=box,color=blue];
		j3440588550 -> j2499999133;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j2499999133 [label="我在乎你。如果你在乎他，那我也会在乎他。",shape=box,color=blue];
		j2499999133 -> j3077674541;
	j3077674541 [label="只是。不要是商场里的人。好吗？",shape=box,color=blue];
		j3077674541 -> j1888205485;
	j1888205485 [label="事情已经够混乱了。",shape=box,color=blue];
		j1888205485 -> j3116416075;
		j1888205485 -> j2425288663;
	j3116416075 [label="哈哈。我保证不是。",shape=box,color=red];
		j3116416075 -> j3941766568;
	j2425288663 [label="恕我直言，我觉得你肯定会喜欢他。",shape=box,color=red];
		j2425288663 -> j1968247091;
	j3941766568 [label="谢谢。我希望有一天能见到他。当然，这是出于……私人原因。",shape=box,color=blue];
		j3941766568 -> j1141339274;
	j1968247091 [label="我希望有一天能见到他。当然，这是出于……私人原因。",shape=box,color=blue];
		j1968247091 -> j1141339274;
	j1141339274 [label="+20 Chemistry",color=orange];
		j1141339274 -> j424507146;
	j424507146 [label="亲爱的，在外面一定要照顾好自己。",shape=box,color=blue];
		j424507146 -> j3652224286;
}