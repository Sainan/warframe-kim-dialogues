	3612 [label="Chat ends.",color=orange];
	3613 [label="亚瑟，我们能聊聊吗？[征求多个伴侣关系的同意]",shape=box,color=red];
		3613 -> 3615;
	3611 [label="[结束]",shape=box,color=red];
		3611 -> 3614;
	3610 [label="Chat ends.",color=orange];
	3615 [label="随时都可以。发生什么事了吗？",shape=box,color=blue];
		3615 -> 3617;
	3614 [label="Update boolean ArthurConsentComplete",color=orange];
		3614 -> 3616;
	3617 [label="没，没什么。我只是想跟你谈谈一件事，希望不会让你感到尴尬。",shape=box,color=red];
		3617 -> 3618;
	3616 [label="Chat ends.",color=orange];
	3618 [label="我不想让你陷入一种你无法接受的情况。我知道我们之前没有讨论过这件事。所以如果你拒绝，那也没关系。我希望你清楚这一点。",shape=box,color=red];
		3618 -> 3619;
	3619 [label="我们之间的感情对我很重要——非常重要——而且它是真实的。我不希望你怀疑这一点。",shape=box,color=red];
		3619 -> 3620;
	3620 [label="啊。我大概知道你要说什么了。你也喜欢上别人了？",shape=box,color=blue];
		3620 -> 3621;
		3620 -> 3622;
	3621 [label="是的。我知道这可能很难理解，但这并不意味着我对你的感情有任何减少。",shape=box,color=red];
		3621 -> 3623;
	3622 [label="是的。但现在想想，我觉得我们或许应该就此结束。[分手]",shape=box,color=red];
		3622 -> 3624;
	3623 [label="亲爱的，你真的觉得我在军队待了那么多年，会没见过各种各样的关系吗？",shape=box,color=blue];
		3623 -> 3625;
	3624 [label="如果你真的想要那样的话……",shape=box,color=blue];
		3624 -> 3626;
	3625 [label="当你的人生长期与死神擦肩而过，你就会知道什么才是生命中真正重要的东西，什么是无关紧要的东西。",shape=box,color=blue];
		3625 -> 3627;
	3626 [label="Update boolean IsDating",color=orange];
		3626 -> 3628;
	3627 [label="所以如果你不再质疑那些划定的界限。我完全理解。",shape=box,color=blue];
		3627 -> 3629;
	3628 [label="Update boolean ArthurDating",color=orange];
		3628 -> 3630;
	3629 [label="事实是？你对我来说很重要。如果他对你很重要，那么他对我来说也很重要。",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="Chat ends.",color=orange];
	3631 [label="只是。​千万千万，​千万​不​要​是​六​人​组，​好​吗？​如果​这​种​事​发生​在​“家人”​身上，​我​恐怕​受​不​了。​",shape=box,color=blue];
		3631 -> 3632;
	3632 [label="一想到这会让我做噩梦。",shape=box,color=blue];
		3632 -> 3634;
		3632 -> 3633;
	3634 [label="好的。我保证。",shape=box,color=red];
		3634 -> 3636;
	3633 [label="恕我直言，我觉得你肯定会喜欢他。",shape=box,color=red];
		3633 -> 3635;
	3636 [label="谢谢。我希望有一天能见到他。当然，这是出于……私人原因。",shape=box,color=blue];
		3636 -> 3637;
	3635 [label="我希望有一天能见到他。当然，这是出于……私人原因。",shape=box,color=blue];
		3635 -> 3637;
	3637 [label="+20 Chemistry",color=orange];
		3637 -> 3638;
	3638 [label="亲爱的，在外面一定要照顾好自己。",shape=box,color=blue];
		3638 -> 3639;
	3639 [label="Update boolean ArthurConsentComplete",color=orange];
		3639 -> 3640;
	3640 [label="Chat ends.",color=orange];
