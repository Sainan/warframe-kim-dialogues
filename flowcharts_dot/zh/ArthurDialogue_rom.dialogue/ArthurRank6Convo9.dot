digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo9 begins." [color=orange];
		"ArthurRank6Convo9 begins." -> j2244645456;
	j2244645456 [label="我搞不太懂埃莉诺正在收集的这些……感染枪支。",shape=box,color=blue];
		j2244645456 -> j1709902054;
		j2244645456 -> j3983028630;
	j1709902054 [label="怎么了？",shape=box,color=red];
		j1709902054 -> j1009267723;
	j3983028630 [label="至少它们不会说话。",shape=box,color=red];
		j3983028630 -> j3689447194;
	j1009267723 [label="除了我认为她可以和它们交流之外？",shape=box,color=blue];
		j1009267723 -> j587096466;
	j3689447194 [label="只是不对*我们*说。我不太确定它们有没有和*她*说话。",shape=box,color=blue];
		j3689447194 -> j587096466;
	j587096466 [label="我知道它们会和吉他说话。但我真的不想多想。",shape=box,color=blue];
		j587096466 -> j223829639;
	j223829639 [label="但我们应该担心它们的……扩散吗？它们确实是在变多。",shape=box,color=blue];
		j223829639 -> j983903512;
	j983903512 [label="我不明白。我也不想去细想它们的弹药从何而来，或者它到底是由什么组成的。",shape=box,color=blue];
		j983903512 -> j243600310;
		j983903512 -> j2111077554;
	j243600310 [label="至少这些感染的东西是站在我们这边的？",shape=box,color=red];
		j243600310 -> j2842635889;
	j2111077554 [label="那你还是继续用普通的枪好了。",shape=box,color=red];
		j2111077554 -> j2320406512;
	j2842635889 [label="当然。*目前*是这样。",shape=box,color=blue];
		j2842635889 -> j677609836;
	j2320406512 [label="我想我会的。",shape=box,color=blue];
		j2320406512 -> j677609836;
	j677609836 [label="至少如果我的次要武器在我的脚上炸出一个洞，我也知道是我自己蠢造成的。",shape=box,color=blue];
		j677609836 -> j2217650614;
	j2217650614 [label="而不是因为我的枪决定重新考虑换主人，也不是因为我的枪在半夜想吃零食。",shape=box,color=blue];
		j2217650614 -> "Chat ends.";
	"Chat ends." [color=orange];
}