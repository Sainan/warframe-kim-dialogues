digraph {
	3555 [label="ArthurRank6Convo9 begins.",color=orange];
		3555 -> 3556;
	3556 [label="我搞不太懂埃莉诺正在收集的这些……感染枪支。",shape=box,color=blue];
		3556 -> 3557;
		3556 -> 3558;
	3557 [label="怎么了？",shape=box,color=red];
		3557 -> 3559;
	3558 [label="至少它们不会说话。",shape=box,color=red];
		3558 -> 3560;
	3559 [label="除了我认为她可以和它们交流之外？",shape=box,color=blue];
		3559 -> 3561;
	3560 [label="只是不对*我们*说。我不太确定它们有没有和*她*说话。",shape=box,color=blue];
		3560 -> 3561;
	3561 [label="我知道它们会和吉他说话。但我真的不想多想。",shape=box,color=blue];
		3561 -> 3562;
	3562 [label="但我们应该担心它们的……扩散吗？它们确实是在变多。",shape=box,color=blue];
		3562 -> 3563;
	3563 [label="我不明白。我也不想去细想它们的弹药从何而来，或者它到底是由什么组成的。",shape=box,color=blue];
		3563 -> 3564;
		3563 -> 3565;
	3564 [label="至少这些感染的东西是站在我们这边的？",shape=box,color=red];
		3564 -> 3566;
	3565 [label="那你还是继续用普通的枪好了。",shape=box,color=red];
		3565 -> 3567;
	3566 [label="当然。*目前*是这样。",shape=box,color=blue];
		3566 -> 3568;
	3567 [label="我想我会的。",shape=box,color=blue];
		3567 -> 3568;
	3568 [label="至少如果我的次要武器在我的脚上炸出一个洞，我也知道是我自己蠢造成的。",shape=box,color=blue];
		3568 -> 3569;
	3569 [label="而不是因为我的枪决定重新考虑换主人，也不是因为我的枪在半夜想吃零食。",shape=box,color=blue];
		3569 -> 3570;
	3570 [label="Chat ends.",color=orange];
}