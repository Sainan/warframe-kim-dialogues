digraph {
	1188 [label="ArthurRank3Convo6 begins.",color=orange];
		1188 -> 1189;
	1189 [label="我们来玩“人质事实”交换吧。",shape=box,color=blue];
		1189 -> 1190;
		1189 -> 1191;
	1190 [label="哈哈，什么玩意？",shape=box,color=red];
		1190 -> 1192;
	1191 [label="过去真奇怪。",shape=box,color=red];
		1191 -> 1192;
	1192 [label="嘿。这是我在不列颠尼克军队时玩的一个游戏。",shape=box,color=blue];
		1192 -> 1193;
	1193 [label="你告诉我一个关于你的尴尬事实，我也告诉你一个我的。",shape=box,color=blue];
		1193 -> 1194;
	1194 [label="我们互相把对方的事实当作“人质”。",shape=box,color=blue];
		1194 -> 1195;
	1195 [label="“人质事实”。这是一种“信任练习”。我甚至可以先来。",shape=box,color=blue];
		1195 -> 1196;
		1195 -> 1197;
		1195 -> 1198;
	1196 [label="一般来说，我觉得你应该去参加绳索课程吧……但行吧。",shape=box,color=red];
		1196 -> 1202;
	1197 [label="当然。为什么不呢？",shape=box,color=red];
		1197 -> 1202;
	1198 [label="不了，我不玩。",shape=box,color=red];
		1198 -> 1199;
	1202 [label="这是我的：我有一只名叫塞巴斯蒂安的泰迪熊。",shape=box,color=blue];
		1202 -> 1203;
	1199 [label="随便你。",shape=box,color=blue];
		1199 -> 1200;
	1203 [label="现在，在你想到我晚上会抱着他睡觉之前，我可不会。",shape=box,color=blue];
		1203 -> 1204;
	1200 [label="Chat ends.",color=orange];
	1204 [label="我是多年前在一个任务中，在一个被轰炸的住宅区找到他的。",shape=box,color=blue];
		1204 -> 1205;
	1205 [label="我把他放在一个架子上。当我没人可以说话的时候呢？",shape=box,color=blue];
		1205 -> 1206;
	1206 [label="我就和他说。这个破破的小家伙。让我不至于发疯。",shape=box,color=blue];
		1206 -> 1201;
		1206 -> 1207;
		1206 -> 1208;
	1201 [label="笑死我了哈哈哈哈",shape=box,color=red];
		1201 -> 1214;
	1207 [label="这真是……可爱得让人心疼。",shape=box,color=red];
		1207 -> 1211;
	1208 [label="有机会的话我能抱一下塞巴斯蒂安吗？",shape=box,color=red];
		1208 -> 1210;
	1214 [label="是啊，是啊。",shape=box,color=blue];
		1214 -> 1213;
	1211 [label="我感觉我的心有点要融化了。",shape=box,color=red];
		1211 -> 1212;
	1210 [label="+20 Chemistry",color=orange];
		1210 -> 1209;
	1213 [label="我都快尿出来了，简直太好笑了！哈哈",shape=box,color=red];
		1213 -> 1215;
	1212 [label="亚瑟，你还真是个充满惊喜的人。",shape=box,color=red];
		1212 -> 1217;
	1209 [label="我不觉得有什么不行。",shape=box,color=blue];
		1209 -> 1218;
	1215 [label="是啊，我懂。",shape=box,color=blue];
		1215 -> 1218;
	1217 [label="+20 Chemistry",color=orange];
		1217 -> 1216;
	1218 [label="该你了。",shape=box,color=blue];
		1218 -> 1219;
		1218 -> 1220;
		1218 -> 1221;
		1218 -> 1222;
	1216 [label="呵。",shape=box,color=blue];
		1216 -> 1218;
	1219 [label="在双衍王境，我总是不经意间召唤出我儿时的卧室，因为我想找个地方躲起来。",shape=box,color=red];
		1219 -> 1227;
	1220 [label="有一次，当隆沌砍我的头时，我的头飞得太快了，直接卡在了树上！",shape=box,color=red];
		1220 -> 1226;
	1221 [label="我用了六百八十七个循环才学会怎么骑好绝灵骥。",shape=box,color=red];
		1221 -> 1225;
	1222 [label="不，我就算了。不过谢谢你告诉我塞巴斯蒂安的事。",shape=box,color=red];
		1222 -> 1223;
	1227 [label="等我搞清楚怎么离开那里时，我已经不记得召唤了多少次卧室了。",shape=box,color=red];
		1227 -> 1228;
	1226 [label="你知道头被砍下来后还能活多久吗？我可是*知道*的。哈哈",shape=box,color=red];
		1226 -> 1228;
	1225 [label="我开始记录我每次的骨折，那个单子我应该还留着。",shape=box,color=red];
		1225 -> 1228;
	1223 [label="早该知道。",shape=box,color=blue];
		1223 -> 1224;
	1228 [label="我的天……伙计，我觉得你可能把这个游戏理解错了。",shape=box,color=blue];
		1228 -> 1229;
	1224 [label="Chat ends.",color=orange];
	1229 [label="不过，呃——还是谢谢你尝试了。",shape=box,color=blue];
		1229 -> 978;
	978 [label="Chat ends.",color=orange];
}