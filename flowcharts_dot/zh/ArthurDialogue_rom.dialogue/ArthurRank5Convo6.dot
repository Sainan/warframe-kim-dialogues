	2497 [label="埃莉诺已经跟我讲过她那段关于克里斯托弗的事了。",shape=box,color=red];
		2497 -> 2502;
	2499 [label="他叫克里斯托弗。他总是为街区里那些需要帮助的孩子挺身而出。",shape=box,color=blue];
		2499 -> 2500;
	2506 [label="我告诉过你我是怎么得到它的。英择谛用它刺了我一刀，就在他把我变成这个样子之后……",shape=box,color=blue];
		2506 -> 2517;
