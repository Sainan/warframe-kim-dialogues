		2552 -> 2553;
	2569 [label="我们都是战争的产物，只是呈现的方式不同。我们的生命中都失去了很多。",shape=box,color=blue];
		2569 -> 2570;
	2553 [label="但我还是个天真的傻子。我像个蠢人一样，急于接过他留下的职责……",shape=box,color=blue];
