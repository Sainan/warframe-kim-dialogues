	2562 [label="他们让我们记得为什么我们还留在这里。我们曾经是谁。",shape=box,color=blue];
		2562 -> 2563;
	2538 [label="想象一下可怜的埃莉诺，不得不眼看她的未婚夫和她的双胞胎弟弟去参战。",shape=box,color=blue];
