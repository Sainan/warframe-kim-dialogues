		2504 -> 2505;
	2501 [label="简而言之？我小时候就超想成为他。尽我所能追随他的脚步。",shape=box,color=blue];
		2501 -> 2540;
	2518 [label="但当你问到那条头巾时，我回避了你的问题。",shape=box,color=blue];
		2518 -> 2520;
