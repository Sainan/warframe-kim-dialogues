		j2570260744 -> j3853752810;
	j1255256975 [label="呸 ！好吧。我们俩倒是有一样共同点……都对甜食毫无抵抗力。恶魔经常从商店偷走糕点，带回到 Cathédrale。",shape=box,color=blue];
		j1255256975 -> j60490455;
