		"MarieRank2Convo4 begins." -> j4198785104;
		"MarieRank2Convo4 begins." -> j1038552372;
	j1849389618 [label="我可以问你关于罗瑟的事吗？还是说，这样问会让你骂个不停？",shape=box,color=red];
		j1849389618 -> j3141815225;
	j4198785104 [label="我能问个显而易见的问题吗？（房间里的大象）",shape=box,color=red];
		j4198785104 -> j2302642938;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j3141815225 [label="Ce diable est un imbécile qui se croit au-dessus de tout reproche ！Je préfèrerais boire un pot de vernis à bois plutôt que de passer une minute de plus à l'écouter s'enorgueillir comme un chat qui se lèche le pelage ！",shape=box,color=blue];
		j3141815225 -> j2706084190;
		j3141815225 -> j2081729453;
	j2302642938 [label="Quoi ！ Où ça ？Un éléphant ？！",shape=box,color=blue];
		j2302642938 -> j1075290423;
	"Chat ends." [color=orange];
	j2706084190 [label="你刚才那些话真有创意。",shape=box,color=red];
		j2706084190 -> j3851810666;
	j2081729453 [label="我……就当你这不是什么好话吧。",shape=box,color=red];
		j2081729453 -> j3029434544;
	j1075290423 [label="我只看到一条鱼、一只鸟，还有……不管标弃先生是什么。我在这个圣所里看到很多奇怪的东西，就是没看到 éléphant——你在开玩笑吧 ？",shape=box,color=blue];
		j1075290423 -> j151674493;
	j3851810666 [label="+5 Chemistry",color=orange];
		j3851810666 -> j1871431249;
	j3029434544 [label="+5 Chemistry",color=orange];
		j3029434544 -> j970091209;
	j151674493 [label="哦！抱歉。这是我 1999 年的朋友教我的比喻…… ",shape=box,color=red];
		j151674493 -> j377862377;
		j151674493 -> j3169011656;
	j1871431249 [label="Merci。是很有创意，但你只是问了我一个问题，我不该把气撒在你身上，抱歉。",shape=box,color=blue];
		j1871431249 -> j3218359144;
	j970091209 [label="的确不是好话。抱歉，我不该把气撒在你身上。",shape=box,color=blue];
		j970091209 -> j3218359144;
	j377862377 [label="恐怕这并不是指真的大象。",shape=box,color=red];
		j377862377 -> j4247763788;
	j3169011656 [label="现在我明白了为什么我一困惑他们总是认为这很可爱……",shape=box,color=red];
		j3169011656 -> j423711351;
	j3218359144 [label="Evaluate expressions",color=orange];
		j3218359144 -> j319993709 [label="MarieRoatheWarning",color=purple];
		j3218359144 -> j1563368783 [label="DrifterRoathe",color=purple];
		j3218359144 -> j2209982151 [label="MarieRoatheSoldier",color=purple];
		j3218359144 -> j1532489199 [label="false",color=purple];
	j4247763788 [label="+5 Chemistry",color=orange];
		j4247763788 -> j3190172873;
	j423711351 [label="+5 Chemistry",color=orange];
		j423711351 -> j447030123;
	j319993709 [label="不过你又来问我的想法我还是挺意外的。上次你已经说得很清楚，你不想再听我诋毁他与那一类人。",shape=box,color=blue];
		j319993709 -> j234617285;
		j319993709 -> j227676007;
	j1563368783 [label="我承认，说实话，我不知道该不该继续这个话题。你似乎被他吸引，就像飞蛾扑火一样。",shape=box,color=blue];
		j1563368783 -> j3834420689;
		j1563368783 -> j2931834519;
	j2209982151 [label="还在想找他做盟友吗？把他拉进你的狼群，你在玩一场危险的游戏。他很可能会在你最意想不到的时候撕碎你的喉咙。",shape=box,color=blue];
		j2209982151 -> j2592069407;
		j2209982151 -> j3118343822;
	j1532489199 [label="我很惊讶你会来找我。显然我对那个恶魔的印象很差。",shape=box,color=blue];
		j1532489199 -> j1870836;
		j1532489199 -> j201253880;
	j3190172873 [label="如果真有的话我倒一点也不会惊讶 ！我看这里似乎还有其他各种各样的动物。",shape=box,color=blue];
		j3190172873 -> j1648062895;
	j447030123 [label="Oui，那确实挺可爱的，不是吗 ？我经常跟洛德先生说些什么，他看着我的眼神就好像我打了他一个措手不及。",shape=box,color=blue];
		j447030123 -> j1934879526;
	j234617285 [label="我之前说的话太重了，为此我想要道歉。我现在还不想谴责他的行为——我正在努力从各个角度理解他。",shape=box,color=red];
		j234617285 -> j940175028;
	j227676007 [label="我确实不想。他的经历难以理解。不过我很好奇，你能告诉我你们是怎么认识的吗？",shape=box,color=red];
		j227676007 -> j1409754952;
	j3834420689 [label="我只是想找到他为什么会这样的原因。我想尝试理解他。",shape=box,color=red];
		j3834420689 -> j219943543;
	j2931834519 [label="如果我能多了解他，也许能帮助我弄清楚如何引导他走上一条稍微……更温和的道路。",shape=box,color=red];
		j2931834519 -> j3212224045;
	j2592069407 [label="我知道。但我没法恨他，因为他只是为了他的人民做了该做的事。我也曾做过同样的事。",shape=box,color=red];
		j2592069407 -> j344287012;
	j3118343822 [label="他是奥罗金史上最危险的奥罗金人之一。拒绝这样的助力，才是真的蠢。",shape=box,color=red];
		j3118343822 -> j3030259955;
	j1870836 [label="我知道，但你肯定对他很了解。我正在尝试更好地理解他。",shape=box,color=red];
		j1870836 -> j373288638;
	j201253880 [label="这就是我来问你关于他的事情的原因。我想更了解他，但我不太相信他自己讲的那一面。",shape=box,color=red];
		j201253880 -> j2756778833;
	j1648062895 [label="这句话是什么意思 ？如果房间里有大象，我们为什么去不谈论它呢 ？",shape=box,color=blue];
		j1648062895 -> j4018031039;
	j1934879526 [label="对于一个本可以成为女王侍从的人来说，我还挺为此感到自豪。",shape=box,color=blue];
		j1934879526 -> j1648062895;
	j940175028 [label="Add 1 to Thermostat counter",color=orange];
		j940175028 -> j2542187129;
	j1409754952 [label="Add 1 to Thermostat counter",color=orange];
		j1409754952 -> j2147021289;
	j219943543 [label="Add -1 to Thermostat counter",color=orange];
		j219943543 -> j2768914017;
	j3212224045 [label="Add 1 to Thermostat counter",color=orange];
		j3212224045 -> j809073719;
	j344287012 [label="Add 1 to Thermostat counter",color=orange];
		j344287012 -> j4069203894;
	j3030259955 [label="Add -1 to Thermostat counter",color=orange];
		j3030259955 -> j739252912;
	j373288638 [label="Add -1 to Thermostat counter",color=orange];
		j373288638 -> j1984532100;
	j2756778833 [label="Add 1 to Thermostat counter",color=orange];
		j2756778833 -> j1899084471;
	j4018031039 [label="我无法想象，对于身边没有会飞的头和会说话的动物的大多数人来说，大象难道不会成为谈话的话题吗。",shape=box,color=blue];
		j4018031039 -> j2738389522;
	j2542187129 [label="+5 Chemistry",color=orange];
		j2542187129 -> j1152693770;
	j2147021289 [label="你以为我看不懂吗 ？我并非傻子——我还没有歇斯底里，即使我被带走，即使我被转化。",shape=box,color=blue];
		j2147021289 -> j3618081744;
		j2147021289 -> j1523591517;
	j2768914017 [label="我担心的是，这种理解会导向什么。不过你不需要我的教导，我又不是你的母亲，也不想破坏这段刚开始的友谊……",shape=box,color=blue];
		j2768914017 -> j2421395738;
	j809073719 [label="+5 Chemistry",color=orange];
		j809073719 -> j527589368;
	j4069203894 [label="+5 Chemistry",color=orange];
		j4069203894 -> j4264555202;
	j739252912 [label="我​只​是​劝​你​谨​慎点。​我​估计，​他​甚至​可以​迷惑月​神，​让​她​把​天上​的​星星​送​给​他。​",shape=box,color=blue];
		j739252912 -> j1400251601;
	j1984532100 [label="我担心的是，这种理解会导向什么。不过你不需要我的教导。",shape=box,color=blue];
		j1984532100 -> j4241344843;
	j1899084471 [label="+5 Chemistry",color=orange];
		j1899084471 -> j413399847;
	j2738389522 [label="……我怀疑我已经回答了我自己的问题，对吗 ？",shape=box,color=blue];
		j2738389522 -> j3044683495;
	j1152693770 [label="我感谢也接受你的道歉，但请想想，我被带走，被转化，然后发现自己身处 l'impossible。 ",shape=box,color=blue];
		j1152693770 -> j3469156942;
	j3618081744 [label="算了，我还是自己去跟恶魔谈谈吧。",shape=box,color=red];
		j3618081744 -> j2114977682;
	j1523591517 [label="对不起。我不是有意跟你争论，我不是那个意思。 ",shape=box,color=red];
		j1523591517 -> j2459951763;
		j1523591517 -> j2222852115;
	j2421395738 [label="我只是担心你。他是个诡计多端、善于操纵人心的野兽…… ",shape=box,color=blue];
		j2421395738 -> j3265866454;
	j527589368 [label="如果你能尝试这么做，我都可以称你为太阳神的圣徒了。",shape=box,color=blue];
		j527589368 -> j3265866454;
	j4264555202 [label="是的，这就是士兵的诅咒……烧毁城镇来拯救国家。杀死敌人来拯救家人。然而，恐怖何时才能终结 ？",shape=box,color=blue];
		j4264555202 -> j2200627437;
	j1400251601 [label="请记住，他是谁，是怎样的人，归根结底……他不是神，甚至也不是野兽，而是一个额凡人。一个自视过高的人。",shape=box,color=blue];
		j1400251601 -> j3265866454;
	j4241344843 [label="我​估计，​他​甚至​可以​迷惑月​神，​让​她​把​天上​的​星星​送​给​他。​我只能说，小心点。",shape=box,color=blue];
		j4241344843 -> j3265866454;
	j413399847 [label="那你真明智，不听他的甜言蜜语。我​估计，​他​甚至​可以​迷惑月​神，​让​她​把​天上​的​星星​送​给​他。​",shape=box,color=blue];
		j413399847 -> j3265866454;
	j3044683495 [label="对。它的意思是“我们能不能谈谈我们都在回避的话题，就好像我们不去讨论房间里的大象一样。”",shape=box,color=red];
		j3044683495 -> j2867616894;
	j3469156942 [label="当你以为我无法理解或无法同情他人的故事时，请你三思，oui ？",shape=box,color=blue];
		j3469156942 -> j3845619279;
	j2114977682 [label="Qu'il en soit ainsi。",shape=box,color=blue];
		j2114977682 -> "Chat ends.";
	j2459951763 [label="他是个士兵。为了“更伟大的使命”，他不得不做出可怕的事情。我懂那种感觉。有时候，那样的生活会让你变得……嗯。像他那样。",shape=box,color=red];
		j2459951763 -> j2802657048;
	j2222852115 [label="他活了几百年，甚至几千年。谁知道这对一个人会造成什么？多少痛苦，多少折磨？我懂那种感觉。",shape=box,color=red];
		j2222852115 -> j3273762163;
	j3265866454 [label="不过你不是想问我关于恶魔的事吗 ？你想知道什么 ？",shape=box,color=blue];
		j3265866454 -> j342109428;
		j3265866454 -> j1620503438;
		j3265866454 -> j2629815240;
	j2200627437 [label="我们必须从统计学家的眼光来看待战争，因为如果我们通过死者的眼光来看待战争，我们的哭泣将永远不会停止 。",shape=box,color=blue];
		j2200627437 -> j3265866454;
	j2867616894 [label="如果可以的话我再猜一下这头 éléphant 的种类……他的皮肤是蓝色的吗？",shape=box,color=blue];
		j2867616894 -> j3218359144;
	j3845619279 [label="而我，我也会尽量不再对你指手画脚。",shape=box,color=blue];
		j3845619279 -> j3618081744;
		j3845619279 -> j1921191952;
	j2802657048 [label="+5 Chemistry",color=orange];
		j2802657048 -> j92637822;
	j3273762163 [label="+5 Chemistry",color=orange];
		j3273762163 -> j3816435235;
	j342109428 [label="为什么你这么不喜欢他？",shape=box,color=red];
		j342109428 -> j301965319;
	j1620503438 [label="为什么英择谛把他留给你和里昂？",shape=box,color=red];
		j1620503438 -> j90661708;
	j2629815240 [label="我很好奇你们是怎么认识的？",shape=box,color=red];
		j2629815240 -> j3430126544;
	j1921191952 [label="一言为定。",shape=box,color=red];
		j1921191952 -> j1822235016;
	j92637822 [label="啊，​那​现在​我​还​真像​个​傻子。​是​的，​你​当然​知道，​以​你​所​谓​“使命”​的​名义杀人​是​什么​感觉……​你​自然​会​试图理解​做​过​同样​事情​的​人。​",shape=box,color=blue];
		j92637822 -> j1638645894;
	j3816435235 [label="啊，​那​现在​我​还​真像​个​傻子。​当然，​你​最​清楚​一​遍​又​一​遍​地​活​着​是​什么​滋味……​你​当然​会​想​了解​一​个​有​同样​经历​的​人。​",shape=box,color=blue];
		j3816435235 -> j1638645894;
	j301965319 [label="这难道不明显吗 ？他的举止就像一只大猫，坚持要标记自己的领地，还要把架子上的东西推下来。",shape=box,color=blue];
		j301965319 -> j1922258235;
		j301965319 -> j2870508486;
	j90661708 [label="当星期日主教——也就是英择谛——最后一次离开时，他把恶魔留在了我们家门口。他遍体鳞伤，浑身是血，甚至连自己的名字也记不起。",shape=box,color=blue];
		j90661708 -> j268990289;
	j3430126544 [label="恶魔降临的那天晚上，暴风雨肆虐。一声可怕的雷鸣震彻了 Cathédrale 的墙壁。",shape=box,color=blue];
		j3430126544 -> j4132570505;
	j1822235016 [label="Boolean MarieRoatheWarning is now false.",color=orange];
		j1822235016 -> j2087797349;
	j1638645894 [label="我们就这么说定吧。当你以为我无法理解或无法同情他人的故事时，请你三思，oui ？",shape=box,color=blue];
		j1638645894 -> j3845619279;
	j1922258235 [label="就我个人而言，我比较喜欢猫。 ",shape=box,color=red];
		j1922258235 -> j1806767067;
	j2870508486 [label="你不喜欢猫吗？",shape=box,color=red];
		j2870508486 -> j2646980501;
	j268990289 [label="我现在才知道，他当时刚被注射了血清，这种转化，如果不是自愿的话……是非常痛苦的。",shape=box,color=blue];
		j268990289 -> j1392292874;
	j4132570505 [label="Check boolean MarieLyonVisions",color=orange];
		j4132570505 -> j963518400 [label=true,color=green];
		j4132570505 -> j758420072 [label=false,color=brown];
	j2087797349 [label="Magnifique ！现在，你不是想问我关于恶魔的事吗 ？你想知道什么 ？",shape=box,color=blue];
		j2087797349 -> j342109428;
		j2087797349 -> j1620503438;
		j2087797349 -> j2629815240;
	j1806767067 [label="猫​很​可爱，​但​只有​当猫​还​是​猫​的​时候 ！​可​他​是​个​男人，​一​个​成年​人，​而且​还​已经​活​了​好​多​年​了​  ！​",shape=box,color=blue];
		j1806767067 -> j4012130566;
	j2646980501 [label=" 我喜欢，但只有当猫还是猫的时候！可他是个男人，一个成年人，而且还已经活了好多年了 ！",shape=box,color=blue];
		j2646980501 -> j4012130566;
	j1392292874 [label="主教俯视着恶魔，说：“Uriel，Xata 的异端者，在放逐中，作出回答吧——奥罗金能否得到宽恕？”",shape=box,color=blue];
		j1392292874 -> j1814339666;
	j963518400 [label="这一次，如果里昂告诉你那场动摇我们家的风暴，他讲述的是真的，那是我们的共同经历。",shape=box,color=blue];
		j963518400 -> j758420072;
	j758420072 [label="我觉得，如此邪恶的人物在这么巨大的暴风中出场，实在是太老套了。",shape=box,color=blue];
		j758420072 -> j90661708;
	j4012130566 [label="比任何一个人，无论是蓝皮肤还是被转化得面目全非的人，都活得更久。",shape=box,color=blue];
		j4012130566 -> j3953370432;
		j4012130566 -> j3602519587;
		j4012130566 -> j2627475258;
	j1814339666 [label="随即一声雷鸣，仿佛是众神亲自召唤他，主教便就此消失了。",shape=box,color=blue];
		j1814339666 -> j3882458814;
	j3953370432 [label="在奥罗金时代，基因改造外形曾是一种时尚。但他们和我们一样，都是人类。或者说，我猜，曾经是。",shape=box,color=red];
		j3953370432 -> j1289636685;
	j3602519587 [label="除了尾巴之外，他真的看起来……比过去的许多奥罗金人更像人类。",shape=box,color=red];
		j3602519587 -> j513577203;
	j2627475258 [label="别担心，我觉得你比他漂亮多了。",shape=box,color=red];
		j2627475258 -> j2617491924;
	j3882458814 [label="留下的，只有……他。那恶魔。",shape=box,color=blue];
		j3882458814 -> j2690674598;
	j1289636685 [label="是的，我想我已经不知道自己是什么了。一部分是玛丽，一部分是……“Wisp”……一部分是现在与我血管相连的感染生物。",shape=box,color=blue];
		j1289636685 -> j4097133263;
	j513577203 [label="是的，我之前在看一幅主教的旧画像，那时的他看起来更像恶魔。他跟我讲了奥罗金人的行事方式，以及他们过去是如何自我改造的。",shape=box,color=blue];
		j513577203 -> j2075075579;
	j2617491924 [label="Check boolean DrifterMarie",color=orange];
		j2617491924 -> j1019473888 [label=true,color=green];
		j2617491924 -> j2125914857 [label=false,color=brown];
	j2690674598 [label="主教把他留给我们……或许是要我们看好他的灵魂 ？或者至少看好他身上的锁链。Je préférerais le renvoyer en enfer。",shape=box,color=blue];
		j2690674598 -> j480127959;
		j2690674598 -> j3710899934;
	j4097133263 [label="或许下次再聊这个吧。",shape=box,color=blue];
		j4097133263 -> j769513893;
	j2075075579 [label="这和我那个时代的贵妇们戴着高耸入云的华丽假发，或者穿着能容纳整个孤儿院的裙子是多么相似，却又如此陌生 ！",shape=box,color=blue];
		j2075075579 -> j4050956741;
	j1019473888 [label="别再让我脸红了 ！洛德先生会好奇我坐在这里干什么 ！",shape=box,color=blue];
		j1019473888 -> j1810991665;
	j2125914857 [label="Boolean DrifterMarie is now true.",color=orange];
		j2125914857 -> j1606839706;
	j480127959 [label="你觉得每个人最终都能得到宽恕吗？",shape=box,color=red];
		j480127959 -> j269040462;
