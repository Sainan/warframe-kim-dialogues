	652 [label="你以为我看不懂吗 ？我并非傻子——我还没有歇斯底里，即使我被带走，即使我被转化。",shape=box,color=blue];
		652 -> 661;
		652 -> 662;
	649 [label="我担心的是，这种理解会导向什么。不过你不需要我的教导，我又不是你的母亲，也不想破坏这段刚开始的友谊……",shape=box,color=blue];
		649 -> 658;
	650 [label="+5 Chemistry",color=orange];
		650 -> 659;
	647 [label="+5 Chemistry",color=orange];
		647 -> 656;
	648 [label="我​只​是​劝​你​谨​慎点。​我​估计，​他​甚至​可以​迷惑月​神，​让​她​把​天上​的​星星​送​给​他。​",shape=box,color=blue];
		648 -> 657;
	645 [label="我担心的是，这种理解会导向什么。不过你不需要我的教导。",shape=box,color=blue];
		645 -> 654;
	646 [label="+5 Chemistry",color=orange];
		646 -> 655;
	644 [label="……我怀疑我已经回答了我自己的问题，对吗 ？",shape=box,color=blue];
		644 -> 653;
	660 [label="我感谢也接受你的道歉，但请想想，我被带走，被转化，然后发现自己身处 l'impossible。 ",shape=box,color=blue];
		660 -> 666;
	661 [label="算了，我还是自己去跟恶魔谈谈吧。",shape=box,color=red];
		661 -> 667;
	662 [label="对不起。我不是有意跟你争论，我不是那个意思。 ",shape=box,color=red];
		662 -> 668;
		662 -> 669;
	658 [label="我只是担心你。他是个诡计多端、善于操纵人心的野兽…… ",shape=box,color=blue];
		658 -> 664;
	659 [label="如果你能尝试这么做，我都可以称你为太阳神的圣徒了。",shape=box,color=blue];
		659 -> 664;
	656 [label="是的，这就是士兵的诅咒……烧毁城镇来拯救国家。杀死敌人来拯救家人。然而，恐怖何时才能终结 ？",shape=box,color=blue];
		656 -> 665;
	657 [label="请记住，他是谁，是怎样的人，归根结底……他不是神，甚至也不是野兽，而是一个额凡人。一个自视过高的人。",shape=box,color=blue];
		657 -> 664;
	654 [label="我​估计，​他​甚至​可以​迷惑月​神，​让​她​把​天上​的​星星​送​给​他。​我只能说，小心点。",shape=box,color=blue];
		654 -> 664;
	655 [label="那你真明智，不听他的甜言蜜语。我​估计，​他​甚至​可以​迷惑月​神，​让​她​把​天上​的​星星​送​给​他。​",shape=box,color=blue];
		655 -> 664;
	653 [label="对。它的意思是“我们能不能谈谈我们都在回避的话题，就好像我们不去讨论房间里的大象一样。”",shape=box,color=red];
		653 -> 663;
	666 [label="当你以为我无法理解或无法同情他人的故事时，请你三思，oui ？",shape=box,color=blue];
		666 -> 673;
	667 [label="Qu'il en soit ainsi。",shape=box,color=blue];
		667 -> 674;
	668 [label="他是个士兵。为了“更伟大的使命”，他不得不做出可怕的事情。我懂那种感觉。有时候，那样的生活会让你变得……嗯。像他那样。",shape=box,color=red];
		668 -> 675;
	669 [label="他活了几百年，甚至几千年。谁知道这对一个人会造成什么？多少痛苦，多少折磨？我懂那种感觉。",shape=box,color=red];
		669 -> 676;
	664 [label="不过你不是想问我关于恶魔的事吗 ？你想知道什么 ？",shape=box,color=blue];
		664 -> 670;
		664 -> 671;
		664 -> 672;
	665 [label="我们必须从统计学家的眼光来看待战争，因为如果我们通过死者的眼光来看待战争，我们的哭泣将永远不会停止 。",shape=box,color=blue];
		665 -> 664;
	663 [label="如果可以的话我再猜一下这头 éléphant 的种类……他的皮肤是蓝色的吗？",shape=box,color=blue];
		663 -> 618;
	673 [label="而我，我也会尽量不再对你指手画脚。",shape=box,color=blue];
