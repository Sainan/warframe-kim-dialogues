	694 [label="Magnifique ！现在，你不是想问我关于恶魔的事吗 ？你想知道什么 ？",shape=box,color=blue];
		694 -> 670;
		694 -> 671;
		694 -> 672;
	689 [label="猫​很​可爱，​但​只有​当猫​还​是​猫​的​时候 ！​可​他​是​个​男人，​一​个​成年​人，​而且​还​已经​活​了​好​多​年​了​  ！​",shape=box,color=blue];
		689 -> 695;
	690 [label=" 我喜欢，但只有当猫还是猫的时候！可他是个男人，一个成年人，而且还已经活了好多年了 ！",shape=box,color=blue];
		690 -> 695;
	691 [label="主教俯视着恶魔，说：“Uriel，Xata 的异端者，在放逐中，作出回答吧——奥罗金能否得到宽恕？”",shape=box,color=blue];
		691 -> 696;
	693 [label="这一次，如果里昂告诉你那场动摇我们家的风暴，他讲述的是真的，那是我们的共同经历。",shape=box,color=blue];
		693 -> 692;
	692 [label="我觉得，如此邪恶的人物在这么巨大的暴风中出场，实在是太老套了。",shape=box,color=blue];
		692 -> 678;
	695 [label="比任何一个人，无论是蓝皮肤还是被转化得面目全非的人，都活得更久。",shape=box,color=blue];
		695 -> 697;
		695 -> 698;
		695 -> 3906;
	696 [label="随即一声雷鸣，仿佛是众神亲自召唤他，主教便就此消失了。",shape=box,color=blue];
		696 -> 699;
	697 [label="在奥罗金时代，基因改造外形曾是一种时尚。但他们和我们一样，都是人类。或者说，我猜，曾经是。",shape=box,color=red];
		697 -> 700;
	698 [label="除了尾巴之外，他真的看起来……比过去的许多奥罗金人更像人类。",shape=box,color=red];
		698 -> 701;
	3906 [label="别担心，我觉得你比他漂亮多了。",shape=box,color=red];
		3906 -> 3907;
	699 [label="留下的，只有……他。那恶魔。",shape=box,color=blue];
		699 -> 702;
	700 [label="是的，我想我已经不知道自己是什么了。一部分是玛丽，一部分是……“Wisp”……一部分是现在与我血管相连的感染生物。",shape=box,color=blue];
		700 -> 703;
	701 [label="是的，我之前在看一幅主教的旧画像，那时的他看起来更像恶魔。他跟我讲了奥罗金人的行事方式，以及他们过去是如何自我改造的。",shape=box,color=blue];
		701 -> 704;
	3907 [label="Check boolean DrifterMarie",color=orange];
		3907 -> 3908 [label=true,color=green];
		3907 -> 3909 [label=false,color=brown];
	702 [label="主教把他留给我们……或许是要我们看好他的灵魂 ？或者至少看好他身上的锁链。Je préférerais le renvoyer en enfer。",shape=box,color=blue];
		702 -> 705;
		702 -> 706;
	703 [label="或许下次再聊这个吧。",shape=box,color=blue];
		703 -> 707;
	704 [label="这和我那个时代的贵妇们戴着高耸入云的华丽假发，或者穿着能容纳整个孤儿院的裙子是多么相似，却又如此陌生 ！",shape=box,color=blue];
		704 -> 708;
	3908 [label="别再让我脸红了 ！洛德先生会好奇我坐在这里干什么 ！",shape=box,color=blue];
		3908 -> 3911;
	3909 [label="Update boolean DrifterMarie",color=orange];
		3909 -> 3910;
	705 [label="你觉得每个人最终都能得到宽恕吗？",shape=box,color=red];
		705 -> 709;
	706 [label="他身上就没有什么你喜欢的地方吗？哪怕一点点？",shape=box,color=red];
		706 -> 710;
	707 [label="Update boolean MarieInfestation",color=orange];
		707 -> 711;
	708 [label="人类终究是人类——不满足于太阳神赐予他们的模样。渴望像黏土一样塑造自己的肉体。我想我也不例外。",shape=box,color=blue];
		708 -> 712;
	3911 [label="而且，比恶魔漂亮又不难，不是吗？他的五官是很英俊，但是那蓝色的皮肤……ce n'est pas pour moi。",shape=box,color=blue];
		3911 -> 3912;
	3910 [label="啊 ！你弄得我脸红了 ！如果洛德先生看到我这样坐在这里，他会怎么想 ？",shape=box,color=blue];
		3910 -> 3911;
	709 [label="我觉得 ？是的。我相信所有犯过错的人都是可以被宽恕的。",shape=box,color=blue];
		709 -> 713;
	710 [label="没有。永远也不会有。",shape=box,color=blue];
		710 -> 714;
		710 -> 715;
	711 [label="我受不了他的点是，他具有猫科动物的那种杀气腾腾的自负，却没有任何作为可爱小伙伴所具有的迷人天性。",shape=box,color=blue];
		711 -> 716;
	712 [label="就像我当时非常高兴能够注射这种血清，它让我一部分变成了玛丽，一部分变成了……“Wisp”，一部分变成了……现在与我血管相连的感染生物。",shape=box,color=blue];
		712 -> 703;
	3912 [label="如果你的赞美是真心的，那么我欣然接受。我只是有点惊讶。我们……可以回到正题了吗 ？",shape=box,color=blue];
		3912 -> 707;
	713 [label="还有一个问题是……他一开始有觉得自己需要宽恕吗 ？",shape=box,color=blue];
		713 -> 717;
	714 [label="嗯，谢谢你的分享。所以英择谛希望他……被宽恕？为了什么？Tau 星系？还是仅仅因为他是奥罗金人？",shape=box,color=red];
		714 -> 718;
	715 [label="好吧，我相信你。我想你是不会骗我的。",shape=box,color=red];
		715 -> 719;
	716 [label="他自视过高。他毫不犹豫地夺去生命。他玩弄敌人，仿佛他们只是被他逼到墙角的老鼠。",shape=box,color=blue];
		716 -> 702;
	717 [label="那些认为自己不需要宽恕的人，是得不到宽恕的。还不如去教鱼怎么飞。",shape=box,color=blue];
		717 -> 720;
	718 [label="我不知道。还有一个问题是，他一开始有觉得自己需要宽恕吗 ？",shape=box,color=blue];
		718 -> 717;
	719 [label="呸 ！好吧。我们俩倒是有一样共同点……都对甜食毫无抵抗力。恶魔经常从商店偷走糕点，带回到 Cathédrale。",shape=box,color=blue];
		719 -> 721;
	720 [label="但是如果想知道你面临的是什么几乎不可能的挑战，如果想赢过这一把，那就亲自去和他谈谈这个话题吧。",shape=box,color=blue];
		720 -> 722;
	721 [label="我告诉他那是偷窃，然后他就会滔滔不绝地诡辩，说什么奥罗金很快就会统治太阳系所以从宏观上来说这不是偷窃……",shape=box,color=blue];
		721 -> 723;
	722 [label="我只能祝你好运了。",shape=box,color=blue];
		722 -> 724;
	723 [label="然后我会吼他，里昂将被迫出面调解……",shape=box,color=blue];
