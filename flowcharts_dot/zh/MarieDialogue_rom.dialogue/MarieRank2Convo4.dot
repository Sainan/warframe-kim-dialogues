		608 -> 611;
	606 [label="我只看到一条鱼、一只鸟，还有……不管标弃先生是什么。我在这个圣所里看到很多奇怪的东西，就是没看到 éléphant——你在开玩笑吧 ？",shape=box,color=blue];
		606 -> 609;
