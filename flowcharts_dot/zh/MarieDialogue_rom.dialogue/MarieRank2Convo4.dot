	670 [label="为什么你这么不喜欢他？",shape=box,color=red];
		670 -> 677;
	671 [label="为什么英择谛把他留给你和里昂？",shape=box,color=red];
		671 -> 678;
	672 [label="我很好奇你们是怎么认识的？",shape=box,color=red];
		672 -> 679;
	680 [label="一言为定。",shape=box,color=red];
		680 -> 687;
	681 [label="啊，​那​现在​我​还​真像​个​傻子。​是​的，​你​当然​知道，​以​你​所​谓​“使命”​的​名义杀人​是​什么​感觉……​你​自然​会​试图理解​做​过​同样​事情​的​人。​",shape=box,color=blue];
		681 -> 688;
	682 [label="啊，​那​现在​我​还​真像​个​傻子。​当然，​你​最​清楚​一​遍​又​一​遍​地​活​着​是​什么​滋味……​你​当然​会​想​了解​一​个​有​同样​经历​的​人。​",shape=box,color=blue];
		682 -> 688;
	677 [label="这难道不明显吗 ？他的举止就像一只大猫，坚持要标记自己的领地，还要把架子上的东西推下来。",shape=box,color=blue];
		677 -> 683;
		677 -> 684;
	678 [label="当星期日主教——也就是英择谛——最后一次离开时，他把恶魔留在了我们家门口。他遍体鳞伤，浑身是血，甚至连自己的名字也记不起。",shape=box,color=blue];
		678 -> 685;
	679 [label="恶魔降临的那天晚上，暴风雨肆虐。一声可怕的雷鸣震彻了 Cathédrale 的墙壁。",shape=box,color=blue];
		679 -> 686;
	687 [label="Update boolean MarieRoatheWarning",color=orange];
		687 -> 694;
	688 [label="我们就这么说定吧。当你以为我无法理解或无法同情他人的故事时，请你三思，oui ？",shape=box,color=blue];
		688 -> 673;
	683 [label="就我个人而言，我比较喜欢猫。 ",shape=box,color=red];
		683 -> 689;
	684 [label="你不喜欢猫吗？",shape=box,color=red];
		684 -> 690;
	685 [label="我现在才知道，他当时刚被注射了血清，这种转化，如果不是自愿的话……是非常痛苦的。",shape=box,color=blue];
		685 -> 691;
	686 [label="Check boolean MarieLyonVisions",color=orange];
