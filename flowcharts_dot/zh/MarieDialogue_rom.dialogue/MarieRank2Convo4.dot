	624 [label="不过你又来问我的想法我还是挺意外的。上次你已经说得很清楚，你不想再听我诋毁他与那一类人。",shape=box,color=blue];
		624 -> 633;
		624 -> 634;
	623 [label="我承认，说实话，我不知道该不该继续这个话题。你似乎被他吸引，就像飞蛾扑火一样。",shape=box,color=blue];
		623 -> 631;
		623 -> 632;
	622 [label="还在想找他做盟友吗？把他拉进你的狼群，你在玩一场危险的游戏。他很可能会在你最意想不到的时候撕碎你的喉咙。",shape=box,color=blue];
		622 -> 629;
		622 -> 630;
	621 [label="我很惊讶你会来找我。显然我对那个恶魔的印象很差。",shape=box,color=blue];
		621 -> 627;
		621 -> 628;
	619 [label="如果真有的话我倒一点也不会惊讶 ！我看这里似乎还有其他各种各样的动物。",shape=box,color=blue];
		619 -> 625;
	620 [label="Oui，那确实挺可爱的，不是吗 ？我经常跟洛德先生说些什么，他看着我的眼神就好像我打了他一个措手不及。",shape=box,color=blue];
		620 -> 626;
	633 [label="我之前说的话太重了，为此我想要道歉。我现在还不想谴责他的行为——我正在努力从各个角度理解他。",shape=box,color=red];
		633 -> 642;
	634 [label="我确实不想。他的经历难以理解。不过我很好奇，你能告诉我你们是怎么认识的吗？",shape=box,color=red];
		634 -> 643;
	631 [label="我只是想找到他为什么会这样的原因。我想尝试理解他。",shape=box,color=red];
		631 -> 640;
	632 [label="如果我能多了解他，也许能帮助我弄清楚如何引导他走上一条稍微……更温和的道路。",shape=box,color=red];
		632 -> 641;
	629 [label="我知道。但我没法恨他，因为他只是为了他的人民做了该做的事。我也曾做过同样的事。",shape=box,color=red];
		629 -> 638;
	630 [label="他是奥罗金史上最危险的奥罗金人之一。拒绝这样的助力，才是真的蠢。",shape=box,color=red];
		630 -> 639;
	627 [label="我知道，但你肯定对他很了解。我正在尝试更好地理解他。",shape=box,color=red];
		627 -> 636;
	628 [label="这就是我来问你关于他的事情的原因。我想更了解他，但我不太相信他自己讲的那一面。",shape=box,color=red];
		628 -> 637;
	625 [label="这句话是什么意思 ？如果房间里有大象，我们为什么去不谈论它呢 ？",shape=box,color=blue];
		625 -> 635;
	626 [label="对于一个本可以成为女王侍从的人来说，我还挺为此感到自豪。",shape=box,color=blue];
