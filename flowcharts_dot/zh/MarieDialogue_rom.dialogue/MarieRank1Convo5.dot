digraph {
	3964 [label="MarieRank1Convo5 begins.",color=orange];
		3964 -> 3965;
	3965 [label="Bonjour，Bonjour ！你一定是漂泊者吧？洛德先生跟我讲过很多关于你的事。我很高兴能在这里“见到”你……",shape=box,color=blue];
		3965 -> 3966;
	3966 [label="Appareil cliquetant，即便很聪明 ！",shape=box,color=blue];
		3966 -> 3967;
	3967 [label="我是玛丽·勒鲁修女，不过你可以叫我玛丽。我最近和我的灵魂兄弟里昂·阿拉德神父一起来到这里……嗯，我想洛德先生可能已经警告过你恶魔的存在了，n'est-ce pas ？",shape=box,color=blue];
		3967 -> 3968;
		3967 -> 3969;
		3967 -> 3970;
	3968 [label="很高兴见到你们。别误会，欢迎你们来，但是……你们都在这里做什么呢？",shape=box,color=red];
		3968 -> 3972;
	3969 [label="恶魔？你是说那个奥罗金人？",shape=box,color=red];
		3969 -> 3974;
	3970 [label="[结束]",shape=box,color=red];
		3970 -> 3971;
	3972 [label="+5 Chemistry",color=orange];
		3972 -> 3973;
	3974 [label="Oui，就是主教委托我们照看的那个 ce monstre irritant à la peau bleue。我想你认识主教，他叫阿尔布雷希特·英择谛？我们之所以在这里，都是因为他。不过，j'en ai bien peur，那是个很长的故事。",shape=box,color=blue];
		3974 -> 3975;
		3974 -> 3976;
	3971 [label="Chat ends.",color=orange];
	3973 [label="Merci ！我们为何会来到这里， j'en ai bien peur 说来话长。我们是主教派来的。我想你认识他，他叫阿尔布雷希特·英择谛吧？他把那个蓝皮肤的讨厌鬼托付给了我们。",shape=box,color=blue];
		3973 -> 3975;
		3973 -> 3976;
	3975 [label="我会尽我所能提供帮助。",shape=box,color=red];
		3975 -> 3980;
	3976 [label="“托付？”",shape=box,color=red];
		3976 -> 3977;
	3980 [label="+5 Chemistry",color=orange];
		3980 -> 3981;
	3977 [label="我们应该尽我们所能引导他的灵魂，如果可能的话。如果不可能呢？那么我们至少必须确保他不再造成任何伤害。",shape=box,color=blue];
		3977 -> 3978;
		3977 -> 3979;
	3981 [label="你就像洛德先生和科维兽描述的那样 ！我想我们一定会成为好朋友。",shape=box,color=blue];
		3981 -> 3983;
	3978 [label="我愿意帮助你尝试。",shape=box,color=red];
		3978 -> 3980;
	3979 [label="他是奥罗金人。你唯一能做到的办法就是一枪爆他的头。",shape=box,color=red];
		3979 -> 3982;
	3983 [label="啊 ！我得走了，请原谅。希望我们很快能再见面 ！À la revoyure ！",shape=box,color=blue];
		3983 -> 3984;
	3982 [label="你的语气听起来真像里昂。我不会放弃希望的。至少现在不会。",shape=box,color=blue];
		3982 -> 3983;
	3984 [label="Chat ends.",color=orange];
}