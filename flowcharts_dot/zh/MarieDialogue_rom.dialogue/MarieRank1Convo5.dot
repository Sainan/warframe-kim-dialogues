digraph {
	"MarieRank1Convo5 begins." [color=orange];
		"MarieRank1Convo5 begins." -> j2807966532;
	j2807966532 [label="Bonjour，Bonjour ！你一定是漂泊者吧？洛德先生跟我讲过很多关于你的事。我很高兴能在这里“见到”你……",shape=box,color=blue];
		j2807966532 -> j1162329362;
	j1162329362 [label="Appareil cliquetant，即便很聪明 ！",shape=box,color=blue];
		j1162329362 -> j3770686385;
	j3770686385 [label="我是玛丽·勒鲁修女，不过你可以叫我玛丽。我最近和我的灵魂兄弟里昂·阿拉德神父一起来到这里……嗯，我想洛德先生可能已经警告过你恶魔的存在了，n'est-ce pas ？",shape=box,color=blue];
		j3770686385 -> j2250003846;
		j3770686385 -> j4194769183;
		j3770686385 -> j1038552372;
	j2250003846 [label="很高兴见到你们。别误会，欢迎你们来，但是……你们都在这里做什么呢？",shape=box,color=red];
		j2250003846 -> j2106552108;
	j4194769183 [label="恶魔？你是说那个奥罗金人？",shape=box,color=red];
		j4194769183 -> j1150791486;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j2106552108 [label="+5 Chemistry",color=orange];
		j2106552108 -> j2515653162;
	j1150791486 [label="Oui，就是主教委托我们照看的那个 ce monstre irritant à la peau bleue。我想你认识主教，他叫阿尔布雷希特·英择谛？我们之所以在这里，都是因为他。不过，j'en ai bien peur，那是个很长的故事。",shape=box,color=blue];
		j1150791486 -> j1811546552;
		j1150791486 -> j3290133263;
	"Chat ends." [color=orange];
	j2515653162 [label="Merci ! The what and the how of our being here is a very long story, j'en ai bien peur. We were sent here by le Cardinal. I believe you know him as Albrecht Entrati ? He entrusted us with that blue-skinned monstre irritant.",shape=box,color=blue];
		j2515653162 -> j1811546552;
		j2515653162 -> j3290133263;
	j1811546552 [label="我会尽我所能提供帮助。",shape=box,color=red];
		j1811546552 -> j1000937851;
	j3290133263 [label="“托付？”",shape=box,color=red];
		j3290133263 -> j2332754214;
	j1000937851 [label="+5 Chemistry",color=orange];
		j1000937851 -> j3695632310;
	j2332754214 [label="我们应该尽我们所能引导他的灵魂，如果可能的话。如果不可能呢？那么我们至少必须确保他不再造成任何伤害。",shape=box,color=blue];
		j2332754214 -> j296324462;
		j2332754214 -> j696154117;
	j3695632310 [label="你就像洛德先生和科维兽描述的那样 ！我想我们一定会成为好朋友。",shape=box,color=blue];
		j3695632310 -> j1463390185;
	j296324462 [label="我愿意帮助你尝试。",shape=box,color=red];
		j296324462 -> j1000937851;
	j696154117 [label="他是奥罗金人。你唯一能做到的办法就是一枪爆他的头。",shape=box,color=red];
		j696154117 -> j2706005633;
	j1463390185 [label="啊 ！我得走了，请原谅。希望我们很快能再见面 ！À la revoyure ！",shape=box,color=blue];
		j1463390185 -> "Chat ends.";
	j2706005633 [label="你的语气听起来真像里昂。我不会放弃希望的。至少现在不会。",shape=box,color=blue];
		j2706005633 -> j1463390185;
}