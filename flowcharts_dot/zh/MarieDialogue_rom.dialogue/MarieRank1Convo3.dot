		165 -> 171;
	173 [label="Update boolean MarieSecretPower",color=orange];
		173 -> 179;
	174 [label="Ce qui est fait est fait。我无法向太阳神祈求奇迹，当身边有太多人承受着更深的伤痛，当有太多人需要更迫切的帮助。双耀神已赐予我太多恩惠。",shape=box,color=blue];
		174 -> 180;
	175 [label="但凡事皆如此，我欣然接受了我的，里昂也接受了他的……哦，我怕自己像在告发他似的，我可不该这么做。",shape=box,color=blue];
		175 -> 181;
		175 -> 182;
	172 [label="Pauvre petit……",shape=box,color=blue];
		172 -> 178;
	170 [label="虽然我能理解那个决定背后的逻辑，就是为了保护他们免受主教必须离开而造成的痛苦……",shape=box,color=blue];
		170 -> 176;
	171 [label="+10 Chemistry",color=orange];
		171 -> 177;
	179 [label="Oui ！你明白的。我曾以另一种视角看世界。我的臂膀更强壮，我的耐心更持久。我懂得何为享受当下。",shape=box,color=blue];
		179 -> 190;
	180 [label="我得走了。谢谢你带来的这段美妙的消遣。 ",shape=box,color=blue];
		180 -> 191;
	181 [label="没关系。你愿意告诉我什么就告诉我什么，不必勉强。",shape=box,color=red];
		181 -> 192;
	182 [label="请继续。我很难让他理解我的话。",shape=box,color=red];
		182 -> 193;
	178 [label="因此，他被转移到了这个主要的殁世械灵——唯一剩下的殁世械灵——并且……嗯？这很难解释。",shape=box,color=red];
		178 -> 187;
		178 -> 188;
		178 -> 189;
	176 [label="但我确实觉得这太残忍了，你不觉得吗？他们可能会以为他死了。或者更糟 ！而我们，住在这里，comme des rats d'égout ？",shape=box,color=blue];
		176 -> 183;
		176 -> 184;
		176 -> 185;
	177 [label="Oui……我明白其中的逻辑。如果可以的话，我也会努力修复他们的家庭，non ？这似乎是我们所有人离开这里的唯一希望。 ",shape=box,color=blue];
		177 -> 186;
	190 [label="抵达目的地时，我沉醉于它的优雅之中。我不会像长着无数条小腿的甲虫那样匆匆忙忙地四处奔走。",shape=box,color=blue];
		190 -> 202;
	191 [label="Chat ends.",color=orange];
	192 [label="+5 Chemistry",color=orange];
		192 -> 203;
	193 [label="+5 Chemistry",color=orange];
		193 -> 204;
	187 [label="说实话，我真希望我们能修复他。把真正的奥塔带回来。",shape=box,color=red];
		187 -> 199;
	188 [label="他能让我笑。他很有趣，但那幽默之下却隐藏着某种悲剧性的破碎。",shape=box,color=red];
		188 -> 200;
	189 [label="可惜的是，他已经变不回去了。而且我觉得他挺让人心烦的。 ",shape=box,color=red];
		189 -> 201;
	183 [label="你说得对。真希望我们能做点什么。",shape=box,color=red];
		183 -> 194;
	184 [label="其实这不是我做出的决定。",shape=box,color=red];
		184 -> 195;
	185 [label="我其实有个朋友很喜欢老鼠。我也觉得它们很可爱。",shape=box,color=red];
		185 -> 196;
	186 [label="以免我们余生都被困在这里，comme des rats d'égout。 ",shape=box,color=blue];
		186 -> 197;
		186 -> 198;
	202 [label="我只是希望我亲爱的里昂能像你这样看待世界。愿所有不便都如你所言，成为一种隐秘的力量。",shape=box,color=blue];
		202 -> 213;
	203 [label="我感激你的好意，漂泊者。就此打住吧，以免给你添太多麻烦—— ",shape=box,color=blue];
		203 -> 214;
	204 [label="漂泊者，你并非唯一如此的人。里昂于我如同家人，可有时我仍怀疑自己对他了解的程度，是否比得上大教堂里的圣徒雕像。",shape=box,color=blue];
