		861 -> 152 [label=true,color=green];
		861 -> 153 [label=false,color=brown];
	155 [label="虽然，​我​并不​怀念​以前​需要​推着​轮椅​的​日子。​里昂​想必​也​是​如此。​飞翔​是​多么​自由​啊​ ！​",shape=box,color=blue];
