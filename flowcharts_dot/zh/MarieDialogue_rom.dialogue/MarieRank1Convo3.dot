digraph {
	77 [label="MarieRank1Convo3 begins.",color=orange];
		77 -> 78;
	78 [label="Il y a un crâne volant ！Keksekça ？！有一个会飞会说话的骷髅头，而所有人却像什么都没发生似的继续过日子，我需要有人承认他们整个存在有多么诡异。",shape=box,color=blue];
		78 -> 79;
		78 -> 81;
		78 -> 80;
	79 [label="那只是殁世械灵。嗯，一个殁世械灵。说来话长。",shape=box,color=red];
		79 -> 82;
	81 [label="那是殁世械灵。他是个中枢，不会伤害你的。",shape=box,color=red];
		81 -> 84;
	80 [label="[结束]",shape=box,color=red];
		80 -> 83;
	82 [label="请问，这是个人名还是物名 ？",shape=box,color=blue];
		82 -> 85;
		82 -> 86;
	84 [label="我并不认为他是威胁 ！他吓不倒我。",shape=box,color=blue];
		84 -> 87;
	83 [label="Chat ends.",color=orange];
	85 [label="我……其实不太清楚。",shape=box,color=red];
		85 -> 88;
	86 [label="两者都是。",shape=box,color=red];
		86 -> 89;
	87 [label="确实，我觉得他很有魅力，只是在交谈中有些固执。这与他现实中的原型倒也颇为相似。不过鉴于我这位最爱旅伴的性情，想必你也能看出这点倒不至于让我太过在意。",shape=box,color=blue];
		87 -> 90;
	88 [label="首先，这些“殁世械灵”究竟出自谁之手 ？这既是个名称，又或许是一种标识 ？",shape=box,color=blue];
		88 -> 91;
		88 -> 92;
	89 [label="我……不太明白。那洛德又和这件事有什么关系 ？",shape=box,color=blue];
		89 -> 88;
	90 [label="不，我向你保证，你可能觉得他面容可怖之处，并非我当前所关切的问题。",shape=box,color=blue];
		90 -> 93;
		90 -> 94;
	91 [label="你的星期日主教。英择谛。",shape=box,color=red];
		91 -> 95;
	92 [label="英择谛创造了它。但关于它们本质的概念——中枢——是由奥罗金发明的。",shape=box,color=red];
		92 -> 95;
	93 [label="我真没想到骷髅头居然不会让你反感。",shape=box,color=red];
		93 -> 96;
	94 [label="我承认，断章取义的话，他确实很古怪。但具体是什么让你感到不安？",shape=box,color=red];
		94 -> 97;
	95 [label="Excusez-moi，你的意思是说主教仿照他的同伴造了一个会飞的骷髅仆人，并给他们起了这个名字吗 ？",shape=box,color=blue];
		95 -> 98;
	96 [label="你对我了解并不多，这不是你的错。我一生中的大部分时间都在照料逝者及其长眠之所。 ",shape=box,color=blue];
		96 -> 99;
	97 [label="我好奇他后面为何还刻着另一张脸，那模样活像小朋友的涂鸦。",shape=box,color=blue];
		97 -> 100;
	98 [label="那为什么这样的殁世械灵不多呢 ？",shape=box,color=blue];
		98 -> 101;
		98 -> 102;
		98 -> 103;
	99 [label="确实，我一生中大部分时间都与他们形影不离。他们热衷倾听我每日的烦恼。",shape=box,color=blue];
		99 -> 104;
	100 [label="我分别询问了殁世械灵先生和洛德先生，但两人都避而不谈此事，只告诉我一个名字：奥塔。他们说出这个名字时，语气中带着深深的悲伤。",shape=box,color=blue];
		100 -> 105;
	101 [label="也许他意识到，将爱人制作成数字副本是件多么可怕的事。",shape=box,color=red];
		101 -> 106;
	102 [label="也许他原本就只打算做这一个。",shape=box,color=red];
		102 -> 107;
	103 [label="我不确定。也许他一直没来得及再做更多？",shape=box,color=red];
		103 -> 108;
	104 [label="Update boolean MarieGraveyard1",color=orange];
		104 -> 109;
		104 -> 110;
	105 [label="所以我在这里和你交谈，希望你能帮助我。",shape=box,color=blue];
		105 -> 111;
		105 -> 112;
	106 [label="Ou bien，作为对他爱戴与敬重的致意，他认为没有洛德先生，这个奇怪的实验室便无法继续运转。",shape=box,color=blue];
		106 -> 113;
		106 -> 114;
	107 [label="+5 Chemistry",color=orange];
		107 -> 115;
	108 [label="想象一下，一群飞行的骷髅头，动作轻盈又精准无比 ！",shape=box,color=blue];
		108 -> 114;
		108 -> 116;
	109 [label="你喜欢看守墓地吗？",shape=box,color=red];
		109 -> 117;
	110 [label="他们有回应吗？",shape=box,color=red];
		110 -> 118;
	111 [label="你想了解奥塔吗？还是想知道为什么你无法和他交谈？",shape=box,color=red];
		111 -> 119;
	112 [label="奥塔​的​事情​很​难​解释……",shape=box,color=red];
		112 -> 2918;
	113 [label="我倒觉得这算是一种奇特的浪漫举动，不过我实在没资格说三道四。",shape=box,color=red];
		113 -> 122;
	114 [label="说真的，我倒不介意有个殁世械灵在我家周围嗡嗡乱飞。",shape=box,color=red];
		114 -> 123;
	115 [label="从某种角度来看，悲剧而又美丽，non ？作为对他爱戴与敬重的致意，他认为没有洛德先生，这个奇怪的实验室便无法继续运转。",shape=box,color=blue];
		115 -> 124;
		115 -> 113;
	116 [label="说实话，我真庆幸他只有一个。我觉得这个世界还承受不了更多这样的家伙。",shape=box,color=red];
		116 -> 125;
	117 [label="还有陵墓和墓穴，哦，是的。但我确实更喜欢户外空间，尽管我的椅子在其中穿行颇具挑战。不过比起台阶来，这算不了什么。",shape=box,color=blue];
		117 -> 126;
	118 [label="哈 ！没有，谢天谢地。直到你那张病态面容的“殁世械灵”回应我时才如此。如果与亡者对话是双耀神所赐的恩赐，那也超出了我的认知范畴。",shape=box,color=blue];
		118 -> 127;
	119 [label="我想我终究都会去了解这两者，但开始从哪里由你决定。après tout，我也不知道哪一个更重要。",shape=box,color=blue];
		119 -> 2918;
