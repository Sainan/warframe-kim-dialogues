	156 [label="Update boolean MarieInvalid",color=orange];
		156 -> 163;
	154 [label="后来不知道是什么原因，他被改造成了一个中枢，并获得了自己的殁世械灵外壳。",shape=box,color=red];
		154 -> 159;
	152 [label="她已经接受了他离开的事实，他们也和好了，但那来之不易。",shape=box,color=red];
		152 -> 157;
	153 [label="她还没有接受他离开的事实，而且他们之间总是争吵不停。",shape=box,color=red];
		153 -> 158;
	160 [label="我试着把残疾看作是改变我们自身的东西。它们在某些方面限制了我们，没错，但它们也能赋予我们别人所不具备的优势。",shape=box,color=red];
		160 -> 167;
	161 [label="你从来没有认为你的状况是个问题吗？",shape=box,color=red];
		161 -> 168;
	162 [label="你知道原型战甲血清会这样影响你吗？",shape=box,color=red];
		162 -> 169;
	163 [label="Chat ends.",color=orange];
	159 [label="不是所有中枢都是因刑罚而被造的。但当时火卫二这边的情况……变得很糟糕，他受了重伤。",shape=box,color=red];
		159 -> 166;
	157 [label="可​要​是​知道他还在外面四处惹事，却连一句都没有跟她说，甚至连封信都没寄……？",shape=box,color=red];
		157 -> 164;
	158 [label="可​要​是​知道他还在外面四处惹事，却连一句都没有跟她说，甚至连封信都没寄……？",shape=box,color=red];
		158 -> 165;
	167 [label="+5 Chemistry",color=orange];
		167 -> 173;
	168 [label="我从来不觉得抱怨有什么意义。老实说，能不用帮手就从高架子上拿东西，我倒是挺享受的。",shape=box,color=blue];
		168 -> 174;
	169 [label="Oui，主教告诉里昂和我服用改变形态的血清会带来什么后果。我们心知肚明。",shape=box,color=blue];
		169 -> 175;
	166 [label="+5 Chemistry",color=orange];
		166 -> 172;
	164 [label="我无法想象这对她、对他们来说有多么痛苦。",shape=box,color=red];
		164 -> 170;
