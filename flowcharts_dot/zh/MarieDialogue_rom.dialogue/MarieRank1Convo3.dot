digraph {
	"MarieRank1Convo3 begins." [color=orange];
		"MarieRank1Convo3 begins." -> j1119646414;
	j1119646414 [label="Il y a un crâne volant ！Keksekça ？！有一个会飞会说话的骷髅头，而所有人却像什么都没发生似的继续过日子，我需要有人承认他们整个存在有多么诡异。",shape=box,color=blue];
		j1119646414 -> j991439947;
		j1119646414 -> j3028316972;
		j1119646414 -> j1038552372;
	j991439947 [label="那只是殁世械灵。嗯，一个殁世械灵。说来话长。",shape=box,color=red];
		j991439947 -> j2229124865;
	j3028316972 [label="那是殁世械灵。他是个中枢，不会伤害你的。",shape=box,color=red];
		j3028316972 -> j795789971;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j2229124865 [label="请问，这是个人名还是物名 ？",shape=box,color=blue];
		j2229124865 -> j3222039941;
		j2229124865 -> j230128454;
	j795789971 [label="我并不认为他是威胁 ！他吓不倒我。",shape=box,color=blue];
		j795789971 -> j61861648;
	"Chat ends." [color=orange];
	j3222039941 [label="我……其实不太清楚。",shape=box,color=red];
		j3222039941 -> j3972995344;
	j230128454 [label="两者都是。",shape=box,color=red];
		j230128454 -> j1139835355;
	j61861648 [label="确实，我觉得他很有魅力，只是在交谈中有些固执。这与他现实中的原型倒也颇为相似。不过鉴于我这位最爱旅伴的性情，想必你也能看出这点倒不至于让我太过在意。",shape=box,color=blue];
		j61861648 -> j1816526342;
	j3972995344 [label="首先，这些“殁世械灵”究竟出自谁之手 ？这既是个名称，又或许是一种标识 ？",shape=box,color=blue];
		j3972995344 -> j3792985903;
		j3972995344 -> j1764551679;
	j1139835355 [label="我……不太明白。那洛德又和这件事有什么关系 ？",shape=box,color=blue];
		j1139835355 -> j3972995344;
	j1816526342 [label="不，我向你保证，你可能觉得他面容可怖之处，并非我当前所关切的问题。",shape=box,color=blue];
		j1816526342 -> j2685997148;
		j1816526342 -> j3153046433;
	j3792985903 [label="你的星期日主教。英择谛。",shape=box,color=red];
		j3792985903 -> j459894669;
	j1764551679 [label="英择谛创造了它。但关于它们本质的概念——中枢——是由奥罗金发明的。",shape=box,color=red];
		j1764551679 -> j459894669;
	j2685997148 [label="我真没想到骷髅头居然不会让你反感。",shape=box,color=red];
		j2685997148 -> j135069675;
	j3153046433 [label="我承认，断章取义的话，他确实很古怪。但具体是什么让你感到不安？",shape=box,color=red];
		j3153046433 -> j703927751;
	j459894669 [label="Excusez-moi，你的意思是说主教仿照他的同伴造了一个会飞的骷髅仆人，并给他们起了这个名字吗 ？",shape=box,color=blue];
		j459894669 -> j1743076765;
	j135069675 [label="你对我了解并不多，这不是你的错。我一生中的大部分时间都在照料逝者及其长眠之所。 ",shape=box,color=blue];
		j135069675 -> j3679941574;
	j703927751 [label="我好奇他后面为何还刻着另一张脸，那模样活像小朋友的涂鸦。",shape=box,color=blue];
		j703927751 -> j2512631862;
	j1743076765 [label="那为什么这样的殁世械灵不多呢 ？",shape=box,color=blue];
		j1743076765 -> j2365056897;
		j1743076765 -> j1827647062;
		j1743076765 -> j2609338393;
	j3679941574 [label="确实，我一生中大部分时间都与他们形影不离。他们热衷倾听我每日的烦恼。",shape=box,color=blue];
		j3679941574 -> j4063127048;
	j2512631862 [label="我分别询问了殁世械灵先生和洛德先生，但两人都避而不谈此事，只告诉我一个名字：奥塔。他们说出这个名字时，语气中带着深深的悲伤。",shape=box,color=blue];
		j2512631862 -> j310603012;
	j2365056897 [label="也许他意识到，将爱人制作成数字副本是件多么可怕的事。",shape=box,color=red];
		j2365056897 -> j1479452135;
	j1827647062 [label="也许他原本就只打算做这一个。",shape=box,color=red];
		j1827647062 -> j15122835;
	j2609338393 [label="我不确定。也许他一直没来得及再做更多？",shape=box,color=red];
		j2609338393 -> j1871438122;
	j4063127048 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j4063127048 -> j3331545142;
		j4063127048 -> j2704514464;
	j310603012 [label="所以我在这里和你交谈，希望你能帮助我。",shape=box,color=blue];
		j310603012 -> j589572556;
		j310603012 -> j2184414992;
	j1479452135 [label="Ou bien，作为对他爱戴与敬重的致意，他认为没有洛德先生，这个奇怪的实验室便无法继续运转。",shape=box,color=blue];
		j1479452135 -> j2701178830;
		j1479452135 -> j3928588488;
	j15122835 [label="+5 Chemistry",color=orange];
		j15122835 -> j1138762963;
	j1871438122 [label="想象一下，一群飞行的骷髅头，动作轻盈又精准无比 ！",shape=box,color=blue];
		j1871438122 -> j3928588488;
		j1871438122 -> j2625249330;
	j3331545142 [label="你喜欢看守墓地吗？",shape=box,color=red];
		j3331545142 -> j1307845962;
	j2704514464 [label="他们有回应吗？",shape=box,color=red];
		j2704514464 -> j3208857685;
	j589572556 [label="你想了解奥塔吗？还是想知道为什么你无法和他交谈？",shape=box,color=red];
		j589572556 -> j963115428;
	j2184414992 [label="奥塔​的​事情​很​难​解释……",shape=box,color=red];
		j2184414992 -> j3287217001;
	j2701178830 [label="我倒觉得这算是一种奇特的浪漫举动，不过我实在没资格说三道四。",shape=box,color=red];
		j2701178830 -> j3308328100;
	j3928588488 [label="说真的，我倒不介意有个殁世械灵在我家周围嗡嗡乱飞。",shape=box,color=red];
		j3928588488 -> j349544321;
	j1138762963 [label="从某种角度来看，悲剧而又美丽，non ？作为对他爱戴与敬重的致意，他认为没有洛德先生，这个奇怪的实验室便无法继续运转。",shape=box,color=blue];
		j1138762963 -> j1306932720;
		j1138762963 -> j2701178830;
	j2625249330 [label="说实话，我真庆幸他只有一个。我觉得这个世界还承受不了更多这样的家伙。",shape=box,color=red];
		j2625249330 -> j1708902460;
	j1307845962 [label="还有陵墓和墓穴，哦，是的。但我确实更喜欢户外空间，尽管我的椅子在其中穿行颇具挑战。不过比起台阶来，这算不了什么。",shape=box,color=blue];
		j1307845962 -> j2427967412;
	j3208857685 [label="哈 ！没有，谢天谢地。直到你那张病态面容的“殁世械灵”回应我时才如此。如果与亡者对话是双耀神所赐的恩赐，那也超出了我的认知范畴。",shape=box,color=blue];
		j3208857685 -> j3066194172;
	j963115428 [label="我想我终究都会去了解这两者，但开始从哪里由你决定。après tout，我也不知道哪一个更重要。",shape=box,color=blue];
		j963115428 -> j3287217001;
	j3287217001 [label="Check boolean LoidFamilyComplete",color=orange];
		j3287217001 -> j1970069347 [label=true,color=green];
		j3287217001 -> j1970069347 [label=false,color=brown];
		j3287217001 -> j3781860734 [label=false,color=brown];
	j3308328100 [label="现在我很好奇，但这似乎是另一个故事了。Cela dit……",shape=box,color=blue];
		j3308328100 -> j703927751;
	j349544321 [label="那么我完全肯定，你很可能是需要陪伴或需要加入个组织，或两者都有。但那是另一个话题了。",shape=box,color=blue];
		j349544321 -> j703927751;
	j1306932720 [label="我认为这更多是为了确保这个地方不至于分崩离析，而非其他任何原因。",shape=box,color=red];
		j1306932720 -> j3511443265;
	j1708902460 [label="确实 ！我也是。这让我想到下一个问题。",shape=box,color=blue];
		j1708902460 -> j703927751;
	j2427967412 [label="Boolean MarieSerum1 is now true.",color=orange];
		j2427967412 -> j2555543571;
		j2427967412 -> j3816249617;
	j3066194172 [label="不，听见灵魂和声音这种事，我亲爱的里昂可比我擅长多了。不过看着那张孩子涂鸦般的脸，我倒怀疑殁世械灵先生是否也同样被鬼魂缠身。",shape=box,color=blue];
		j3066194172 -> j4286003941;
	j1970069347 [label="奥塔曾是一位哲士、奥罗金科学家和学者。关于他的经历，实在算不上一个幸福的故事。",shape=box,color=red];
		j1970069347 -> j2397343372;
	j3781860734 [label="嗯……简而言之，英择谛家族有几位在楼上，而他们……完全不知道我们就在楼下。",shape=box,color=red];
		j3781860734 -> j621166768;
	j3511443265 [label="你说的或许没错。这具飞行的并合体似乎失去了真实的洛德先生大部分的 raison d'être 与细微差别。Cela dit……",shape=box,color=blue];
		j3511443265 -> j703927751;
	j2555543571 [label="我不知道该不该问你，你的脚是不是被血清改变了……",shape=box,color=red];
		j2555543571 -> j3717388046;
	j3816249617 [label="你的椅子？",shape=box,color=red];
		j3816249617 -> j496622326;
	j4286003941 [label="其实我来找你的目的正是为此，如果你不介意的话。",shape=box,color=blue];
		j4286003941 -> j2512631862;
	j2397343372 [label="Boolean MarieOtak1 is now true.",color=orange];
		j2397343372 -> j1232386737;
	j621166768 [label="Boolean MarieFamily1 is now true.",color=orange];
		j621166768 -> j2928983370;
	j3717388046 [label="+10 Chemistry",color=orange];
		j3717388046 -> j263909051;
	j496622326 [label="我不知道你会怎么叫它 ？Un fauteuil roulant，还是……或许是一个我深恶痛绝的词——un fauteuil pour invalide。",shape=box,color=blue];
		j496622326 -> j4015500749;
	j1232386737 [label="Par les Luminaires……请继续说。",shape=box,color=blue];
		j1232386737 -> j782221982;
	j2928983370 [label="Par les Luminaires……你是说我们都在这里秘密活动？！所以才不让我们离开这里？！Mais pourquoi？！",shape=box,color=blue];
		j2928983370 -> j474427536;
	j263909051 [label="哦 ！哦，你这可怜的家伙。想象你坐在那里，心想我的双脚是否被主教夺走了 ！Non，Non，Non——绝无此事。",shape=box,color=blue];
		j263909051 -> j249705167;
	j4015500749 [label="就像我们现在这样，坐在这些可爱的小设备前进行沟通。但两侧装有轮子，以便移动。如果你愿意的话，可称之为带轮子的椅子。",shape=box,color=blue];
		j4015500749 -> j3339857910;
		j4015500749 -> j3033883517;
	j782221982 [label="众所周知，他是一位天才，也是驾驭氩结晶的幕后推手。",shape=box,color=red];
		j782221982 -> j2489302035;
	j474427536 [label="是因为他的女儿欧拉瑞娅——人称“母亲”，以及她的家人，一直都在照顾着火卫二。",shape=box,color=red];
		j474427536 -> j3939036451;
	j249705167 [label="太阳神在我生命中安排了与生俱来的不便——那双传统意义上笨重的脚。我无法行走。 ",shape=box,color=blue];
		j249705167 -> j1210593056;
	j3339857910 [label="在成为原型战甲之前你是个残疾人？",shape=box,color=red];
		j3339857910 -> j1648638589;
	j3033883517 [label="信不信由你，我们管它们叫轮椅。",shape=box,color=red];
		j3033883517 -> j2297761996;
	j2489302035 [label="这些力量源自虚空——正是它们让我们能够制造出众多强大的战甲与武器。",shape=box,color=red];
		j2489302035 -> j3059975287;
	j3939036451 [label="守护着这个地方，以及那颗向始源星系输送虚空能量的心脏，自英择谛离开后，它始终维系着我们所有人的……存续。",shape=box,color=red];
		j3939036451 -> j3032412102;
	j1210593056 [label="但这不过是件麻烦事罢了。",shape=box,color=blue];
		j1210593056 -> j1900237359;
	j1648638589 [label="Non。我绝对不是。",shape=box,color=blue];
		j1648638589 -> j3350176257;
	j2297761996 [label="哈 ！哦，我坐在这里笑自己真是个傻瓜。是啊，我想你们会称它们为轮椅，毕竟它们是带轮子的椅子。我真是糊涂。",shape=box,color=blue];
		j2297761996 -> j1900237359;
	j3059975287 [label="他专攻晶体学。他的研究成果都保存在这里的实验室里。",shape=box,color=red];
		j3059975287 -> j3229330961;
	j3032412102 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3032412102 -> j3281759167 [label=true,color=green];
		j3032412102 -> j2362593335 [label=false,color=brown];
	j1900237359 [label="虽然，​我​并不​怀念​以前​需要​推着​轮椅​的​日子。​里昂​想必​也​是​如此。​飞翔​是​多么​自由​啊​ ！​",shape=box,color=blue];
		j1900237359 -> j4109446661;
		j1900237359 -> j3263231631;
		j1900237359 -> j3267940454;
	j3350176257 [label="Boolean MarieInvalid is now true.",color=orange];
		j3350176257 -> "Chat ends.";
	j3229330961 [label="后来不知道是什么原因，他被改造成了一个中枢，并获得了自己的殁世械灵外壳。",shape=box,color=red];
		j3229330961 -> j577674493;
	j3281759167 [label="她已经接受了他离开的事实，他们也和好了，但那来之不易。",shape=box,color=red];
		j3281759167 -> j3175411152;
	j2362593335 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j2362593335 -> j3281759167 [label=true,color=green];
		j2362593335 -> j2761277344 [label=false,color=brown];
	j4109446661 [label="我试着把残疾看作是改变我们自身的东西。它们在某些方面限制了我们，没错，但它们也能赋予我们别人所不具备的优势。",shape=box,color=red];
		j4109446661 -> j2231902206;
	j3263231631 [label="你从来没有认为你的状况是个问题吗？",shape=box,color=red];
		j3263231631 -> j3013166407;
	j3267940454 [label="你知道原型战甲血清会这样影响你吗？",shape=box,color=red];
		j3267940454 -> j699135003;
	j577674493 [label="不是所有中枢都是因刑罚而被造的。但当时火卫二这边的情况……变得很糟糕，他受了重伤。",shape=box,color=red];
		j577674493 -> j1867146787;
	j3175411152 [label="可​要​是​知道他还在外面四处惹事，却连一句都没有跟她说，甚至连封信都没寄……？",shape=box,color=red];
		j3175411152 -> j3353286182;
	j2761277344 [label="她还没有接受他离开的事实，而且他们之间总是争吵不停。",shape=box,color=red];
		j2761277344 -> j3522574522;
	j2231902206 [label="+5 Chemistry",color=orange];
		j2231902206 -> j3045056100;
	j3013166407 [label="我从来不觉得抱怨有什么意义。老实说，能不用帮手就从高架子上拿东西，我倒是挺享受的。",shape=box,color=blue];
		j3013166407 -> j1575173399;
	j699135003 [label="Oui，主教告诉里昂和我服用改变形态的血清会带来什么后果。我们心知肚明。",shape=box,color=blue];
		j699135003 -> j3485234754;
	j1867146787 [label="+5 Chemistry",color=orange];
		j1867146787 -> j4432627;
	j3353286182 [label="我无法想象这对她、对他们来说有多么痛苦。",shape=box,color=red];
		j3353286182 -> j1438348297;
	j3522574522 [label="可​要​是​知道他还在外面四处惹事，却连一句都没有跟她说，甚至连封信都没寄……？",shape=box,color=red];
		j3522574522 -> j2001409333;
	j3045056100 [label="Boolean MarieSecretPower is now true.",color=orange];
		j3045056100 -> j1639453275;
	j1575173399 [label="Ce qui est fait est fait。我无法向太阳神祈求奇迹，当身边有太多人承受着更深的伤痛，当有太多人需要更迫切的帮助。双耀神已赐予我太多恩惠。",shape=box,color=blue];
		j1575173399 -> j3580434073;
	j3485234754 [label="但凡事皆如此，我欣然接受了我的，里昂也接受了他的……哦，我怕自己像在告发他似的，我可不该这么做。",shape=box,color=blue];
		j3485234754 -> j3199766866;
		j3485234754 -> j2043682347;
	j4432627 [label="Pauvre petit……",shape=box,color=blue];
		j4432627 -> j3551091367;
	j1438348297 [label="虽然我能理解那个决定背后的逻辑，就是为了保护他们免受主教必须离开而造成的痛苦……",shape=box,color=blue];
		j1438348297 -> j2038971131;
	j2001409333 [label="这会毁掉他们之间仅存的那点和解机会。",shape=box,color=red];
		j2001409333 -> j325002326;
	j1639453275 [label="Oui ！你明白的。我曾以另一种视角看世界。我的臂膀更强壮，我的耐心更持久。我懂得何为享受当下。",shape=box,color=blue];
		j1639453275 -> j4060847977;
	j3580434073 [label="我得走了。谢谢你带来的这段美妙的消遣。 ",shape=box,color=blue];
		j3580434073 -> "Chat ends.";
	j3199766866 [label="没关系。你愿意告诉我什么就告诉我什么，不必勉强。",shape=box,color=red];
		j3199766866 -> j3034910671;
	j2043682347 [label="请继续。我很难让他理解我的话。",shape=box,color=red];
		j2043682347 -> j3400822569;
	j3551091367 [label="因此，他被转移到了这个主要的殁世械灵——唯一剩下的殁世械灵——并且……嗯？这很难解释。",shape=box,color=red];
		j3551091367 -> j4286662159;
		j3551091367 -> j885126608;
		j3551091367 -> j961759316;
	j2038971131 [label="但我确实觉得这太残忍了，你不觉得吗？他们可能会以为他死了。或者更糟 ！而我们，住在这里，comme des rats d'égout ？",shape=box,color=blue];
		j2038971131 -> j916541016;
		j2038971131 -> j3561435853;
		j2038971131 -> j4009188978;
	j325002326 [label="+10 Chemistry",color=orange];
		j325002326 -> j920169083;
	j4060847977 [label="抵达目的地时，我沉醉于它的优雅之中。我不会像长着无数条小腿的甲虫那样匆匆忙忙地四处奔走。",shape=box,color=blue];
		j4060847977 -> j1809334749;
	j3034910671 [label="+5 Chemistry",color=orange];
		j3034910671 -> j1680841144;
