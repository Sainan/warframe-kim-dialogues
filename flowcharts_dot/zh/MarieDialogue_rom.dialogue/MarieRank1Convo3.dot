		2918 -> 120 [label=false,color=brown];
	122 [label="现在我很好奇，但这似乎是另一个故事了。Cela dit……",shape=box,color=blue];
		122 -> 97;
	123 [label="那么我完全肯定，你很可能是需要陪伴或需要加入个组织，或两者都有。但那是另一个话题了。",shape=box,color=blue];
		123 -> 97;
	124 [label="我认为这更多是为了确保这个地方不至于分崩离析，而非其他任何原因。",shape=box,color=red];
		124 -> 130;
	125 [label="确实 ！我也是。这让我想到下一个问题。",shape=box,color=blue];
		125 -> 97;
	126 [label="Update boolean MarieSerum1",color=orange];
		126 -> 131;
		126 -> 132;
	127 [label="不，听见灵魂和声音这种事，我亲爱的里昂可比我擅长多了。不过看着那张孩子涂鸦般的脸，我倒怀疑殁世械灵先生是否也同样被鬼魂缠身。",shape=box,color=blue];
		127 -> 133;
	121 [label="奥塔曾是一位哲士、奥罗金科学家和学者。关于他的经历，实在算不上一个幸福的故事。",shape=box,color=red];
		121 -> 129;
	120 [label="嗯……简而言之，英择谛家族有几位在楼上，而他们……完全不知道我们就在楼下。",shape=box,color=red];
		120 -> 128;
	130 [label="你说的或许没错。这具飞行的并合体似乎失去了真实的洛德先生大部分的 raison d'être 与细微差别。Cela dit……",shape=box,color=blue];
		130 -> 97;
	131 [label="我不知道该不该问你，你的脚是不是被血清改变了……",shape=box,color=red];
		131 -> 136;
	132 [label="你的椅子？",shape=box,color=red];
		132 -> 137;
