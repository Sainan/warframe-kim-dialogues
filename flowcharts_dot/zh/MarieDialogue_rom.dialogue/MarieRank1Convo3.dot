	136 [label="+10 Chemistry",color=orange];
		136 -> 140;
	137 [label="我不知道你会怎么叫它 ？Un fauteuil roulant，还是……或许是一个我深恶痛绝的词——un fauteuil pour invalide。",shape=box,color=blue];
		137 -> 141;
	135 [label="Par les Luminaires……请继续说。",shape=box,color=blue];
		135 -> 139;
	134 [label="Par les Luminaires……你是说我们都在这里秘密活动？！所以才不让我们离开这里？！Mais pourquoi？！",shape=box,color=blue];
		134 -> 138;
	140 [label="哦 ！哦，你这可怜的家伙。想象你坐在那里，心想我的双脚是否被主教夺走了 ！Non，Non，Non——绝无此事。",shape=box,color=blue];
		140 -> 144;
	141 [label="就像我们现在这样，坐在这些可爱的小设备前进行沟通。但两侧装有轮子，以便移动。如果你愿意的话，可称之为带轮子的椅子。",shape=box,color=blue];
		141 -> 145;
		141 -> 146;
	139 [label="众所周知，他是一位天才，也是驾驭氩结晶的幕后推手。",shape=box,color=red];
		139 -> 143;
	138 [label="是因为他的女儿欧拉瑞娅——人称“母亲”，以及她的家人，一直都在照顾着火卫二。",shape=box,color=red];
		138 -> 142;
	144 [label="太阳神在我生命中安排了与生俱来的不便——那双传统意义上笨重的脚。我无法行走。 ",shape=box,color=blue];
		144 -> 149;
	145 [label="在成为原型战甲之前你是个残疾人？",shape=box,color=red];
		145 -> 150;
	146 [label="信不信由你，我们管它们叫轮椅。",shape=box,color=red];
		146 -> 151;
	143 [label="这些力量源自虚空——正是它们让我们能够制造出众多强大的战甲与武器。",shape=box,color=red];
		143 -> 148;
	142 [label="守护着这个地方，以及那颗向始源星系输送虚空能量的心脏，自英择谛离开后，它始终维系着我们所有人的……存续。",shape=box,color=red];
		142 -> 861;
	149 [label="但这不过是件麻烦事罢了。",shape=box,color=blue];
		149 -> 155;
	150 [label="Non。我绝对不是。",shape=box,color=blue];
		150 -> 156;
	151 [label="哈 ！哦，我坐在这里笑自己真是个傻瓜。是啊，我想你们会称它们为轮椅，毕竟它们是带轮子的椅子。我真是糊涂。",shape=box,color=blue];
		151 -> 155;
	148 [label="他专攻晶体学。他的研究成果都保存在这里的实验室里。",shape=box,color=red];
