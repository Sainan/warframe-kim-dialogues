digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo3 begins." [color=orange];
		"MarieRank4Convo3 begins." -> j2818232021;
		"MarieRank4Convo3 begins." -> j1038552372;
	j2818232021 [label="玛丽，你今天过得怎么样 ？",shape=box,color=red];
		j2818232021 -> j3431069515;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j3431069515 [label="我没那么高尚。你明天再来找我聊吧。我可不是个好伙伴。",shape=box,color=blue];
		j3431069515 -> j397906742;
		j3431069515 -> j872600811;
		j3431069515 -> j1881633653;
	"Chat ends." [color=orange];
	j397906742 [label="如果你想的话，我会走开，但如果你想谈谈，我很乐意倾听。",shape=box,color=red];
		j397906742 -> j2667830170;
	j872600811 [label="好的，我明白了。",shape=box,color=red];
		j872600811 -> "Chat ends.";
	j1881633653 [label="请问是出了什么事吗…… ？",shape=box,color=red];
		j1881633653 -> j2667830170;
	j2667830170 [label="C'est vraiment gentil，不过这已经是个老问题了……不值得你费心。我会没事的。",shape=box,color=blue];
		j2667830170 -> j3096270068;
	j3096270068 [label="Boolean MarieChronicPain is now true.",color=orange];
		j3096270068 -> j1860421622;
		j3096270068 -> j3671053659;
		j3096270068 -> j3808902223;
	j1860421622 [label="如果你真的这样想的话。但如果你想谈谈，我一直在。",shape=box,color=red];
		j1860421622 -> j378427189;
	j3671053659 [label="我……知道那种感觉。在我开始“循环”之前，我在双衍王境受了很重的伤。虽然已经痊愈了，但还是时不时地疼得厉害。每次疼起来，我都尽量掩饰自己畏缩的表情。",shape=box,color=red];
		j3671053659 -> j387664301;
	j3808902223 [label="旧问题有时和新问题一样棘手。即使它们来来去去，并且一直萦绕在我们身边，也不意味着它们不值得讨论。",shape=box,color=red];
		j3808902223 -> j461045801;
	j378427189 [label="你真是太好了，而且……好吧。​我​又​变回​那个​有点​固执​的​玛丽​了。",shape=box,color=blue];
		j378427189 -> j1374624222;
	j387664301 [label="Boolean DrifterChronicPain is now true.",color=orange];
		j387664301 -> j3222699836;
	j461045801 [label="Oui，tu as raison。​我​又​变回​那个​有点​固执​的​玛丽​了。",shape=box,color=blue];
		j461045801 -> j1374624222;
	j1374624222 [label="这很难解释，但我会尽力解释。Mes pieds，oui ？是关于我的脚。血清改变了我，让我可以飞翔——",shape=box,color=blue];
		j1374624222 -> j2146025894;
	j3222699836 [label="Par les Luminaires，我真的很抱歉。那么你明白那是什么感受，oui ？",shape=box,color=blue];
		j3222699836 -> j2794034511;
	j2146025894 [label="但我仍然能感觉到它们，那些扭曲的东西威胁着要吞噬我，威胁着要粉碎我灵魂中的所有希望和欢乐。",shape=box,color=blue];
		j2146025894 -> j3208147492;
	j2794034511 [label="拥有一具背叛你的身体，它拖慢你的精神。即使是现在，这感觉也如此奇怪。血清改变了我，给了我飞翔的能力——",shape=box,color=blue];
		j2794034511 -> j2146025894;
	j3208147492 [label="它们还是很痛。一直都是。即使现在，我坐在这里，只要一想到它们，我就会感到疼痛。只是并不总是强烈到我会注意。",shape=box,color=blue];
		j3208147492 -> j3263868316;
	j3263868316 [label="直到现在，它们还是会在夜里让我从疼痛中惊醒。我不禁纳闷，太阳神，pourquoi ？为什么我还要感到这种……无休止的痛苦 ？",shape=box,color=blue];
		j3263868316 -> j3185644121;
	j3185644121 [label="这究竟有什么意义呢？啊，但第二天早晨来临，我笑了，并告诉自己：“安静点，玛丽，你是被祝福的。看看你拥有的一切，看看你能做的一切。”",shape=box,color=blue];
		j3185644121 -> j3000413195;
	j3000413195 [label="在 Cathédrale 里，我会对自己说“你可以读书，可以写字，可以吃饭，可以睡觉。你可以自由行动。你有眼睛可以看，有舌头可以说话，有双手可以书写，还有那些关心你的人。” 现在，我可以飞翔了 ！我可以保护未来免受虚空、免受虚空无情之物的侵袭 ！",shape=box,color=blue];
		j3000413195 -> j2632670378;
	j2632670378 [label="“哭吧，傻丫头，这持续的痛苦会让你坚强地面对未来的一切。”我对自己说。一天又一天过去了，新的一天到来时，似乎也没有那么痛了。",shape=box,color=blue];
		j2632670378 -> j830269311;
	j830269311 [label="Check boolean DrifterChronicPain",color=orange];
		j830269311 -> j3781649833 [label=true,color=green];
		j830269311 -> j3776880452 [label=true,color=green];
		j830269311 -> j97148942 [label=false,color=brown];
		j830269311 -> j1037244696 [label=false,color=brown];
	j3781649833 [label="如果说它赋予了我们什么，我想那就是对痛苦的忍耐力。",shape=box,color=red];
		j3781649833 -> j2939504697;
	j3776880452 [label="但有时候……我醒来，感觉那又是我崩溃的一天。",shape=box,color=red];
		j3776880452 -> j2939504697;
	j97148942 [label="它……真的从来没有好过吗？玛丽，我真的很为你感到难过……",shape=box,color=red];
		j97148942 -> j3108283228;
	j1037244696 [label="一点药也没有吗 ？一点治疗办法也没有 ？",shape=box,color=red];
		j1037244696 -> j3154457300;
	j2939504697 [label="一位教友曾经问我：“你还疼吗 ？一直都疼吗 ？”我回答说：“Oui，monsieur。Je le suis。” 他惊讶的表情中夹杂着恐惧。",shape=box,color=blue];
		j2939504697 -> j3513319240;
	j3108283228 [label="有​时​我​坐下​后，​一​想到​如果​我​没有​那么​痛苦，​我​能​做​多​少​事情，​ou​i ？​如果​我​没有​那么​……​被​困​在​一​个​处处​阻​碍​我​的​肉体​牢​笼里。​",shape=box,color=blue];
		j3108283228 -> j727205297;
	j3154457300 [label="我当然希望有。Mais non，并没有。在我的时代没有，恐怕这在这里也不太可能。",shape=box,color=blue];
		j3154457300 -> j89820097;
	j3513319240 [label="“那你是怎么撑下去的？”他接着问。我记得我笑着回答：“Monsieur，我还有别的选择吗…… ？”",shape=box,color=blue];
		j3513319240 -> j1254577414;
		j3513319240 -> j2460155078;
	j727205297 [label="我就会感到非常愤怒 ！非常嫉妒那些生来没有被身体背叛的人。但到头来，这又能给我们带来什么益处呢 ？à part rendre nos vies plus amères ？只会愈加苦涩吗 ？",shape=box,color=blue];
		j727205297 -> j3602801486;
	j89820097 [label="有些疾病，是人类、科学和信仰都无法治愈的。",shape=box,color=blue];
		j89820097 -> j3108283228;
	j1254577414 [label="我也被人这样问过好多次……",shape=box,color=red];
		j1254577414 -> j3108283228;
	j2460155078 [label="确实……我很抱歉。",shape=box,color=red];
		j2460155078 -> j892768405;
	j3602801486 [label="Aucun。我就是我，我会坚持下去。",shape=box,color=blue];
		j3602801486 -> j2980398560;
	j892768405 [label="Non，我只是很抱歉你也经历了这种相似的痛苦。 ",shape=box,color=blue];
		j892768405 -> j3108283228;
	j2980398560 [label="Check boolean DrifterChronicPain",color=orange];
		j2980398560 -> j180855125 [label=true,color=green];
		j2980398560 -> j1908324613 [label=false,color=brown];
	j180855125 [label="而你也一样。你也一样。对此，我充满信心。",shape=box,color=blue];
		j180855125 -> j1908324613;
	j1908324613 [label="+20 Chemistry",color=orange];
		j1908324613 -> j2732325991;
	j2732325991 [label="我无法用言语表达这次对话对我有多重要。所以漂泊者，我只想说声 merci。",shape=box,color=blue];
		j2732325991 -> j3473268686;
	j3473268686 [label="Et encore merci。",shape=box,color=blue];
		j3473268686 -> "Chat ends.";
}