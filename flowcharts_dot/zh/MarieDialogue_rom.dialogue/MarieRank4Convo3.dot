digraph {
	2239 [label="MarieRank4Convo3 begins.",color=orange];
		2239 -> 2240;
		2239 -> 2241;
	2240 [label="玛丽，你今天过得怎么样 ？",shape=box,color=red];
		2240 -> 2242;
	2241 [label="[结束]",shape=box,color=red];
		2241 -> 2243;
	2242 [label="我没那么高尚。你明天再来找我聊吧。我可不是个好伙伴。",shape=box,color=blue];
		2242 -> 2244;
		2242 -> 2245;
		2242 -> 2246;
	2243 [label="Chat ends.",color=orange];
	2244 [label="如果你想的话，我会走开，但如果你想谈谈，我很乐意倾听。",shape=box,color=red];
		2244 -> 2247;
	2245 [label="好的，我明白了。",shape=box,color=red];
		2245 -> 2248;
	2246 [label="请问是出了什么事吗…… ？",shape=box,color=red];
		2246 -> 2247;
	2247 [label="C'est vraiment gentil，不过这已经是个老问题了……不值得你费心。我会没事的。",shape=box,color=blue];
		2247 -> 2249;
	2248 [label="Chat ends.",color=orange];
	2249 [label="Update boolean MarieChronicPain",color=orange];
		2249 -> 2250;
		2249 -> 2251;
		2249 -> 2252;
	2250 [label="如果你真的这样想的话。但如果你想谈谈，我一直在。",shape=box,color=red];
		2250 -> 2253;
	2251 [label="我……知道那种感觉。在我开始“循环”之前，我在双衍王境受了很重的伤。虽然已经痊愈了，但还是时不时地疼得厉害。每次疼起来，我都尽量掩饰自己畏缩的表情。",shape=box,color=red];
		2251 -> 2254;
	2252 [label="旧问题有时和新问题一样棘手。即使它们来来去去，并且一直萦绕在我们身边，也不意味着它们不值得讨论。",shape=box,color=red];
		2252 -> 2255;
	2253 [label="你真是太好了，而且……好吧。​我​又​变回​那个​有点​固执​的​玛丽​了。",shape=box,color=blue];
		2253 -> 2256;
	2254 [label="Update boolean DrifterChronicPain",color=orange];
		2254 -> 2257;
	2255 [label="Oui，tu as raison。​我​又​变回​那个​有点​固执​的​玛丽​了。",shape=box,color=blue];
		2255 -> 2256;
	2256 [label="这很难解释，但我会尽力解释。Mes pieds，oui ？是关于我的脚。血清改变了我，让我可以飞翔——",shape=box,color=blue];
		2256 -> 2258;
	2257 [label="Par les Luminaires，我真的很抱歉。那么你明白那是什么感受，oui ？",shape=box,color=blue];
		2257 -> 2259;
	2258 [label="但我仍然能感觉到它们，那些扭曲的东西威胁着要吞噬我，威胁着要粉碎我灵魂中的所有希望和欢乐。",shape=box,color=blue];
		2258 -> 2260;
	2259 [label="拥有一具背叛你的身体，它拖慢你的精神。即使是现在，这感觉也如此奇怪。血清改变了我，给了我飞翔的能力——",shape=box,color=blue];
		2259 -> 2258;
	2260 [label="它们还是很痛。一直都是。即使现在，我坐在这里，只要一想到它们，我就会感到疼痛。只是并不总是强烈到我会注意。",shape=box,color=blue];
		2260 -> 2261;
	2261 [label="直到现在，它们还是会在夜里让我从疼痛中惊醒。我不禁纳闷，太阳神，pourquoi ？为什么我还要感到这种……无休止的痛苦 ？",shape=box,color=blue];
		2261 -> 2262;
	2262 [label="这究竟有什么意义呢？啊，但第二天早晨来临，我笑了，并告诉自己：“安静点，玛丽，你是被祝福的。看看你拥有的一切，看看你能做的一切。”",shape=box,color=blue];
		2262 -> 2263;
	2263 [label="在 Cathédrale 里，我会对自己说“你可以读书，可以写字，可以吃饭，可以睡觉。你可以自由行动。你有眼睛可以看，有舌头可以说话，有双手可以书写，还有那些关心你的人。” 现在，我可以飞翔了 ！我可以保护未来免受虚空、免受虚空无情之物的侵袭 ！",shape=box,color=blue];
		2263 -> 2264;
	2264 [label="“哭吧，傻丫头，这持续的痛苦会让你坚强地面对未来的一切。”我对自己说。一天又一天过去了，新的一天到来时，似乎也没有那么痛了。",shape=box,color=blue];
		2264 -> 2265;
	2265 [label="Check boolean DrifterChronicPain",color=orange];
		2265 -> 2266 [label=true,color=green];
		2265 -> 2269 [label=true,color=green];
		2265 -> 2267 [label=false,color=brown];
		2265 -> 2268 [label=false,color=brown];
	2266 [label="如果说它赋予了我们什么，我想那就是对痛苦的忍耐力。",shape=box,color=red];
		2266 -> 2270;
	2269 [label="但有时候……我醒来，感觉那又是我崩溃的一天。",shape=box,color=red];
		2269 -> 2270;
	2267 [label="它……真的从来没有好过吗？玛丽，我真的很为你感到难过……",shape=box,color=red];
		2267 -> 2271;
	2268 [label="一点药也没有吗 ？一点治疗办法也没有 ？",shape=box,color=red];
		2268 -> 2272;
	2270 [label="一位教友曾经问我：“你还疼吗 ？一直都疼吗 ？”我回答说：“Oui，monsieur。Je le suis。” 他惊讶的表情中夹杂着恐惧。",shape=box,color=blue];
		2270 -> 2273;
	2271 [label="有​时​我​坐下​后，​一​想到​如果​我​没有​那么​痛苦，​我​能​做​多​少​事情，​ou​i ？​如果​我​没有​那么​……​被​困​在​一​个​处处​阻​碍​我​的​肉体​牢​笼里。​",shape=box,color=blue];
		2271 -> 2274;
	2272 [label="我当然希望有。Mais non，并没有。在我的时代没有，恐怕这在这里也不太可能。",shape=box,color=blue];
		2272 -> 2275;
	2273 [label="“那你是怎么撑下去的？”他接着问。我记得我笑着回答：“Monsieur，我还有别的选择吗…… ？”",shape=box,color=blue];
		2273 -> 2276;
		2273 -> 2277;
	2274 [label="我就会感到非常愤怒 ！非常嫉妒那些生来没有被身体背叛的人。但到头来，这又能给我们带来什么益处呢 ？à part rendre nos vies plus amères ？只会愈加苦涩吗 ？",shape=box,color=blue];
		2274 -> 2278;
	2275 [label="有些疾病，是人类、科学和信仰都无法治愈的。",shape=box,color=blue];
		2275 -> 2271;
	2276 [label="我也被人这样问过好多次……",shape=box,color=red];
		2276 -> 2271;
	2277 [label="确实……我很抱歉。",shape=box,color=red];
		2277 -> 2279;
	2278 [label="Aucun。我就是我，我会坚持下去。",shape=box,color=blue];
		2278 -> 2280;
	2279 [label="Non，我只是很抱歉你也经历了这种相似的痛苦。 ",shape=box,color=blue];
		2279 -> 2271;
	2280 [label="Check boolean DrifterChronicPain",color=orange];
		2280 -> 2281 [label=true,color=green];
		2280 -> 2282 [label=false,color=brown];
	2281 [label="而你也一样。你也一样。对此，我充满信心。",shape=box,color=blue];
		2281 -> 2282;
	2282 [label="+20 Chemistry",color=orange];
		2282 -> 2283;
	2283 [label="我无法用言语表达这次对话对我有多重要。所以漂泊者，我只想说声 merci。",shape=box,color=blue];
		2283 -> 2284;
	2284 [label="Et encore merci。",shape=box,color=blue];
		2284 -> 2285;
	2285 [label="Chat ends.",color=orange];
}