		j2122694569 -> j444690423;
	"Chat ends." [color=orange];
	j1351982758 [label="恐怕我现在得称他为“我们”的恶魔了，non ？因为他一时半会儿是不会离开的。哈 ！",shape=box,color=blue];
		j1351982758 -> j2936237717;
	j1534202239 [label="我觉得这个问题应该问你才对，non ？现在和他厮混的可是你啊 ！",shape=box,color=blue];
		j1534202239 -> j751709286;
	j4207913643 [label="我不知道你是如何做到的，但他已经告诉我们注射血清的真相。",shape=box,color=blue];
		j4207913643 -> j2401562145;
	j4076236802 [label="我不知道你是如何做到的，但他已经告诉我们注射血清的真相。",shape=box,color=blue];
	j1283421182 [label="我很担心他。我觉得他伤害自己的程度比他表现出来的要严重得多，n'est-ce pas ？",shape=box,color=blue];
		j1283421182 -> j4167516197;
	j444690423 [label="如果这让你觉得莫名其妙，我先说对不起，但我之前一直不知道该怎么跟你说。",shape=box,color=red];
		j444690423 -> j4053300227;
	j2936237717 [label="你能让他帮忙说服洛德先生，做得非常好。我原本以为这事不可能办到。",shape=box,color=blue];
		j2936237717 -> j1364930561;
	j751709286 [label="我正在努力克制自己，不去问你 toutes sortes de commérages。",shape=box,color=blue];
		j751709286 -> j1364930561;
	j2401562145 [label="天，这让我心碎。他说话的时候声音没有丝毫颤抖。Mais je l'ai vu dans ses yeux。",shape=box,color=blue];
		j2401562145 -> j1364930561;
	j4167516197 [label="这让我心如刀割。我希望他的心脏不会有一天在他胸口碎裂。我不知道他能否挺过去。我也不知道我们之中是否有谁能挺过去。",shape=box,color=blue];
		j4167516197 -> "Chat ends.";
	j4053300227 [label="我喜欢你。我真的非常喜欢你。",shape=box,color=red];
		j4053300227 -> j3353259994;
	j1364930561 [label="他变了。虽然很细微，但他确实变了。 ",shape=box,color=blue];
		j1364930561 -> j3520259502;
	j3353259994 [label="嗯，​我​在​想……​你​是否，​嗯……​愿意​和​我​成为​情侣？​",shape=box,color=red];
		j3353259994 -> j2298753926;
	j3520259502 [label="+5 Chemistry",color=orange];
		j3520259502 -> j3406043906;
	j2298753926 [label="Evaluate expressions",color=orange];
		j2298753926 -> j2907711014 [label="MarieNoDate",color=purple];
		j2298753926 -> j89926060 [label="MarieWillDate",color=purple];
		j2298753926 -> j2907711014 [label="false",color=purple];
	j3406043906 [label="我知道这一切都要感谢你。",shape=box,color=blue];
		j3406043906 -> j3844230574;
	j2907711014 [label="哦！哦，漂泊者。我不知道该怎么说，所以我就直说了吧。 ",shape=box,color=blue];
		j2907711014 -> j3987996817;
	j89926060 [label="哦，我也喜欢你 ！Mais je ne sais pas comment te l'écrire， je n'ose pas taper les mots ！光是想那种事，我就觉得自己像个傻瓜 ！",shape=box,color=blue];
		j89926060 -> j4040885522;
	j3844230574 [label="我不知道他是否会接受，但他永远都会拥有这份友谊。",shape=box,color=blue];
		j3844230574 -> j4018502236;
	j3987996817 [label="Non。",shape=box,color=blue];
		j3987996817 -> "Chat ends.";
	j4040885522 [label="啊！你太让我高兴了 ！",shape=box,color=blue];
		j4040885522 -> j1911231842;
	j4018502236 [label="虽然我觉得我永远不会厌倦对他大喊大叫！",shape=box,color=blue];
		j4018502236 -> j448541074;
		j4018502236 -> j815588867;
	j1911231842 [label="​如果​你​是​想​要​一​种​更……​正式​的​追求​关系，​那么​——oui ！​Ou​i！​我​愿意​ ！​",shape=box,color=blue];
		j1911231842 -> j3685975049;
		j1911231842 -> j1870143743;
	j448541074 [label="不​管怎样，​我​觉得​他​就​是​喜欢​捉​弄​你。​",shape=box,color=red];
		j448541074 -> j2071788406;
	j815588867 [label="我很高兴你们俩找到了某种亲近感。",shape=box,color=red];
		j815588867 -> j2196542160;
	j3685975049 [label="我​绝​对​不​是​在​跟​你​求婚，​还​没​到​那个​阶段。​",shape=box,color=red];
		j3685975049 -> j2990745304;
	j1870143743 [label="这些​事确实​发展​了​一些。​我​不​会​称​它们​为​更​“正式”​的​关系，​但是​我​绝​对​很​开心​能……​给​你​展示​一下​现在​是​怎么​回事。​",shape=box,color=red];
		j1870143743 -> j1635266969;
	j2071788406 [label="Comme un gros chat de gouttière。我已经习惯了有他。",shape=box,color=blue];
		j2071788406 -> j1844469853;
	j2196542160 [label="Oui ！我也是。他每天都变得不那么讨人厌了。",shape=box,color=blue];
		j2196542160 -> j2071788406;
	j2990745304 [label="现在​轮到​我​来​打趣​你​了，​别担心。​不过​无论​如何，​je suis ravie ！​也​很​期​待去​了解​这些​新​的​……​浪​漫习俗。​",shape=box,color=blue];
		j2990745304 -> j1952162065;
	j1635266969 [label="哈 ！​我​知道​你​什么​时候​在​开玩笑。​好​吧​——​我​很​期待。​",shape=box,color=blue];
		j1635266969 -> j1952162065;
	j1844469853 [label="如果他走了，我想我会很难过的。",shape=box,color=blue];
		j1844469853 -> "Chat ends.";
