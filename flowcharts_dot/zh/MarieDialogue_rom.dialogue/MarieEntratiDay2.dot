		2649 -> 2659;
	2650 [label="Non​, ​我​明白……​有​多​少​谋杀​是​以​“激情​犯罪”​的​名义​犯​下​的，​ o​u​i ？​当然，​也​有​同样​多​的​孩子​是​在​那样​的​激情​时​刻​中​诞生​的。​",shape=box,color=blue];
		2650 -> 2660;
	2651 [label="并且​你​在​这么​短​的​时间​里​就​变得​对​我​如此​重要​……​我们​的​每​次​谈话​都​让​我​感到​无比 joye​ux。​",shape=box,color=blue];
