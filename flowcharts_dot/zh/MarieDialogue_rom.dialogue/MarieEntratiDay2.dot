	2646 [label="因为​我​曾流落​街头，​我​的​一​生​都​伴随着​肉体​的​痛苦。​我​体会​过心碎，​也​体会​过​爱情，​经历​过​恐惧​与​被​拒绝。​我​体验​过​新生，​也​见​过​失去。​",shape=box,color=blue];
		2646 -> 2655;
	2647 [label="哪怕​举起利剑​是​必要​之举，​为了​不​让​这个​世界​沦陷于​他们​的​同类​之手，​这​也​不​该​被​颂扬。​更​不​该​以​此​为​借口​去​伤​及​无辜。​",shape=box,color=blue];
		2647 -> 2656;
	2648 [label="而​你​竟试​图用​它​来​“击败”​我​ ？​那​是​懦夫​的​手段。​但​我们​当时​都​怒气​上头，​我​会……​原谅​你，​如果​你​也​愿意​原谅​我​那些​出于​愤怒​的​言语​的话。​",shape=box,color=blue];
		2648 -> 2657;
