	3576 [label="Chat ends.",color=orange];
	3580 [label="嗨，当然可以。最近怎么样？",shape=box,color=red];
		3580 -> 3582;
	3579 [label="[结束]",shape=box,color=red];
		3579 -> 3581;
	3582 [label="我只想说……我知道你的心也属于另一个人。虽然我不认识对方，但我为此感到由衷的高兴。",shape=box,color=blue];
		3582 -> 3584;
	3581 [label="Update boolean MarieConsentComplete",color=orange];
		3581 -> 3583;
	3584 [label="我相信你，如果他们在你心中占有一席之地，那么我也非常愿意与他们分享你。",shape=box,color=blue];
		3584 -> 3585;
	3583 [label="Chat ends.",color=orange];
	3585 [label="我只希望有朝一日能有机会见到他们，oui ？因此，我爱人的爱人，也可以是我的爱人……",shape=box,color=blue];
		3585 -> 3586;
	3586 [label="当然，如果你觉得他也会愿意的话。",shape=box,color=blue];
		3586 -> 3587;
		3586 -> 3588;
		3586 -> 3589;
	3587 [label="说实话，你可能不是他喜欢的类型。",shape=box,color=red];
		3587 -> 3590;
	3588 [label="玛丽，他们会非常喜欢你的。就像我一样。",shape=box,color=red];
		3588 -> 3591;
	3589 [label="我觉得他不会拒绝你。",shape=box,color=red];
		3589 -> 3591;
	3590 [label="呸 ！我的狼，你真坏。让我做我的梦吧。在那之前，我想我只能等到有机会的时候再见到你了 ！",shape=box,color=blue];
		3590 -> 3592;
	3591 [label="在那之前，我会珍惜与你相处的每一刻。我也很乐意与那些像我一样关心你的人分享你。",shape=box,color=blue];
		3591 -> 3592;
	3592 [label="毕竟，在你四处游玩玩乐的时候，总得要有人守着，抵御低语者吧 ！",shape=box,color=blue];
		3592 -> 3593;
	3593 [label="说到这里，我得去履行职责了。À la revoyure ！",shape=box,color=blue];
