	"Chat ends." [color=orange];
	j1985950621 [label="Check boolean MarieConsentComplete",color=orange];
		j1985950621 -> "Chat ends." [label=true,color=green];
		j1985950621 -> j2407094117 [label=false,color=brown];
	j1134465740 [label="Check boolean MariePolyamorySuccess",color=orange];
		j1134465740 -> j1985950621 [label=true,color=green];
		j1134465740 -> "Chat ends." [label=false,color=brown];
	j2407094117 [label="Mon cœur，我们可以说会儿话吗 ？就一会儿。 ",shape=box,color=blue];
		j2407094117 -> j3040716482;
		j2407094117 -> j1484992267;
	j3040716482 [label="嗨，当然可以。最近怎么样？",shape=box,color=red];
		j3040716482 -> j1706164399;
	j1484992267 [label="[结束]",shape=box,color=red];
		j1484992267 -> j952339130;
	j1706164399 [label="我只想说……我知道你的心也属于另一个人。虽然我不认识对方，但我为此感到由衷的高兴。",shape=box,color=blue];
		j1706164399 -> j4068346408;
	j952339130 [label="Boolean MarieConsentComplete is now true.",color=orange];
		j952339130 -> "Chat ends.";
	j4068346408 [label="我相信你，如果他们在你心中占有一席之地，那么我也非常愿意与他们分享你。",shape=box,color=blue];
		j4068346408 -> j476803773;
	j476803773 [label="我只希望有朝一日能有机会见到他们，oui ？因此，我爱人的爱人，也可以是我的爱人……",shape=box,color=blue];
		j476803773 -> j3549820795;
	j3549820795 [label="当然，如果你觉得他也会愿意的话。",shape=box,color=blue];
		j3549820795 -> j3008490302;
		j3549820795 -> j1836432895;
		j3549820795 -> j130517171;
	j3008490302 [label="说实话，你可能不是他喜欢的类型。",shape=box,color=red];
		j3008490302 -> j1556910337;
	j1836432895 [label="玛丽，他们会非常喜欢你的。就像我一样。",shape=box,color=red];
		j1836432895 -> j2193962777;
	j130517171 [label="我觉得他不会拒绝你。",shape=box,color=red];
		j130517171 -> j2193962777;
	j1556910337 [label="呸 ！我的狼，你真坏。让我做我的梦吧。在那之前，我想我只能等到有机会的时候再见到你了 ！",shape=box,color=blue];
		j1556910337 -> j3429469287;
	j2193962777 [label="在那之前，我会珍惜与你相处的每一刻。我也很乐意与那些像我一样关心你的人分享你。",shape=box,color=blue];
		j2193962777 -> j3429469287;
	j3429469287 [label="毕竟，在你四处游玩玩乐的时候，总得要有人守着，抵御低语者吧 ！",shape=box,color=blue];
		j3429469287 -> j2439003153;
	j2439003153 [label="说到这里，我得去履行职责了。À la revoyure ！",shape=box,color=blue];
		j2439003153 -> j952339130;
}