digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo1 begins." [color=orange];
		"MarieRank1Convo1 begins." -> j789527933;
	j789527933 [label="Bonjour，bonjour，漂泊者 ！这大好的日子你过得如何 ？或者该说是今晚？我实在搞不清这地方究竟是什么时间了。",shape=box,color=blue];
		j789527933 -> j4234349531;
	j4234349531 [label="我确信洛德先生收藏的这些 bibelots 里有一件是钟表，但我怎么也认不出是哪一件。",shape=box,color=blue];
		j4234349531 -> j2147634634;
	j2147634634 [label="我不敢触碰这座奇妙圣所里的任何装置。我深信把自己冲向遥远时光的概率，与泡好一杯热茶的概率相差无几。",shape=box,color=blue];
		j2147634634 -> j3693184965;
		j2147634634 -> j1415143050;
		j2147634634 -> j1038552372;
	j3693184965 [label="那最好别按那些你不确定的按钮。 ",shape=box,color=red];
		j3693184965 -> j3420548706;
	j1415143050 [label="我相信你会没事的。",shape=box,color=red];
		j1415143050 -> j2783144574;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j3420548706 [label="确实是很好的建议。我从洛德先生那里听说，你自己也经历过 aventure temporelle。我想知道——",shape=box,color=blue];
		j3420548706 -> j3704403145;
	j2783144574 [label="C'est très gentil de votre part，不过……你又不是那个被抛到另一个……啊。对对 ！没错  ！",shape=box,color=blue];
		j2783144574 -> j3138345857;
	"Chat ends." [color=orange];
	j3704403145 [label="它有这次这么危险吗 ？",shape=box,color=blue];
		j3704403145 -> j2491943457;
		j3704403145 -> j2276462501;
	j3138345857 [label="你当然知道，对吧？抱歉。你自己的冒险经历也像这次一样危险吗 ？",shape=box,color=blue];
		j3138345857 -> j2491943457;
		j3138345857 -> j2276462501;
	j2491943457 [label="是整个时期？还是我在那里时候的体验？",shape=box,color=red];
		j2491943457 -> j2233107487;
	j2276462501 [label="那是不同的情况，但我保证你在这里很安全。",shape=box,color=red];
		j2276462501 -> j54142315;
	j2233107487 [label="+10 Chemistry",color=orange];
		j2233107487 -> j1602266446;
	j54142315 [label="我非常感谢你这番振奋人心的信任，但我并不完全认同。尤其当我连分辨时间都这么困难的情况下。",shape=box,color=blue];
		j54142315 -> j3035491155;
	j1602266446 [label="区分这一点很好。我十分确信你过去的经历在总体标准下算不上“正常”。不过就从你描述的情况来看，我当然希望不是这样。",shape=box,color=blue];
		j1602266446 -> j1908276407;
	j3035491155 [label="按理说这个……“屏幕”的角落里应该会显示，可根本没有 ！要我说，Mauvaise qualité。",shape=box,color=blue];
		j3035491155 -> j2106781207;
	j1908276407 [label="我指的是“时间段”本身。请让我调整下措辞——",shape=box,color=blue];
		j1908276407 -> j3530427884;
	j2106781207 [label="不管怎样，我们已经离我的问题偏离得相当远了 ！",shape=box,color=blue];
		j2106781207 -> j3530427884;
	j3530427884 [label="你去过的那个“过去”时代，它确实更接近我所来自的“更遥远的过去”，与当下我们所处的时代相比，是否存在或多或少的潜在危险 ？",shape=box,color=blue];
		j3530427884 -> j865312982;
	j865312982 [label="（天哪 ！我真是太喜欢聊这些了，这可比擦拭圣餐器皿有趣多了。）",shape=box,color=blue];
		j865312982 -> j2761714186;
		j865312982 -> j2804971681;
		j865312982 -> j2455127443;
		j865312982 -> j999876545;
	j2761714186 [label="我觉得差不多。武器装备不同，他们或许还不清楚自己将面对什么，但战争就是战争，死亡就是死亡。",shape=box,color=red];
		j2761714186 -> j927920627;
	j2804971681 [label="我觉得这次没那么危险。我们更有能力应对当前面临的挑战。他们才刚刚起步。",shape=box,color=red];
		j2804971681 -> j3172592264;
	j2455127443 [label="我觉得这次更危险。虽然我们仍面临共同的感染者，但他们当时使用的武器远不如现在先进。",shape=box,color=red];
		j2455127443 -> j3172592264;
	j999876545 [label="说实话，我很高兴你玩得开心。突然要适应这么多新变化，确实不容易。",shape=box,color=red];
		j999876545 -> j367790677;
	j927920627 [label="+5 Chemistry",color=orange];
		j927920627 -> j2822371444;
	j3172592264 [label="你说的或许有道理。我会好好考虑的。谢谢你。",shape=box,color=blue];
		j3172592264 -> "Chat ends.";
	j367790677 [label="+5 Chemistry",color=orange];
		j367790677 -> j1613238296;
	j2822371444 [label="凡事皆如此，我想终究是相对的，non ？如今猎杀我们的掠食者与当年追捕我们的一样凶残。只是磨利了獠牙罢了。",shape=box,color=blue];
		j2822371444 -> j1283374093;
		j2822371444 -> j3264707533;
	j1613238296 [label="星期日主教——也就是你们的阿尔布雷希特·英择谛——早已为我铺垫了这一切。与我亲爱的里昂不同的是，我把他的话当作事实。也与里昂不同的是，我认为这是我们伟大的冒险，而不是负担。",shape=box,color=blue];
		j1613238296 -> j2628411158;
	j1283374093 [label="除非你是奥罗金，他们找到了避免死亡的方法……至少理论上如此，实践中未必能实现。",shape=box,color=red];
		j1283374093 -> j3613863751;
	j3264707533 [label="我也为你能很好地适应未来感到高兴。",shape=box,color=red];
		j3264707533 -> j1001891664;
	j2628411158 [label="侍奉双耀神不必是种苦行。在这点上，我们始终存在分歧。",shape=box,color=blue];
		j2628411158 -> j1790780475;
	j3613863751 [label="而我相信恶魔正是完美的例子，说明为什么死亡是月神赐予我们最伟大的礼物。",shape=box,color=blue];
		j3613863751 -> j2938065817;
	j1001891664 [label="+5 Chemistry",color=orange];
		j1001891664 -> j2142591970;
	j1790780475 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j1790780475 -> j3145552086;
	j2938065817 [label="Boolean MarieRoathe1 is now true.",color=orange];
		j2938065817 -> j1649077506;
	j2142591970 [label="星期日主教——也就是你们的阿尔布雷希特·英择谛——早已为我铺垫了这一切。与我亲爱的里昂不同的是，我把他的话当作事实。也与里昂不同的是，我认为这是我们伟大的冒险，而不是负担。",shape=box,color=blue];
		j2142591970 -> j4050848584;
	j3145552086 [label="别回避我的问题，傻瓜 ！你觉得哪个更危险 ？",shape=box,color=blue];
		j3145552086 -> j2815734403;
		j3145552086 -> j231228465;
		j3145552086 -> j848294529;
	j1649077506 [label="哦 ！这倒是我听得出的钟声，虽然还是没法确定这该死的东西藏在哪里。不管怎样，我怕是得走了。跟你聊的真是很开心。期待我们下次“再见” ！Aux Dieux ！",shape=box,color=blue];
		j1649077506 -> "Chat ends.";
	j4050848584 [label="侍奉双耀神不必是种苦行。在这点上，我们始终存在分歧。",shape=box,color=blue];
		j4050848584 -> j895307943;
	j2815734403 [label="我相信这次更危险。有多少不可能打倒的敌人想置我们于死地？",shape=box,color=red];
		j2815734403 -> j3172592264;
	j231228465 [label="我认为我们这个时代没那么危险。他们只是在探索新的自相残杀方式。我们的手段或许在形式上更刺激些罢了。",shape=box,color=red];
		j231228465 -> j3172592264;
	j848294529 [label="我认为最终结果大概相差无几。死亡就是死亡，不是吗？",shape=box,color=red];
		j848294529 -> j149667702;
	j895307943 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j895307943 -> j1649077506;
	j149667702 [label="+5 Chemistry",color=orange];
		j149667702 -> j4165002899;
	j4165002899 [label="凡事皆如此，我想终究是相对的，不是吗 ？如今猎杀我们的掠食者与当年追捕我们的一样凶残。只是磨利了獠牙罢了。",shape=box,color=blue];
		j4165002899 -> j707158578;
		j4165002899 -> j1283374093;
	j707158578 [label="作为一个试图抵御狼的人，我常常为此感到精疲力竭。",shape=box,color=red];
		j707158578 -> j3576226089;
	j3576226089 [label="我认为你啊，我亲爱的漂泊者，更可能一头扎进狼群，而非坐守防线。这话我可是真心实意地夸你。",shape=box,color=blue];
		j3576226089 -> j1649077506;
}