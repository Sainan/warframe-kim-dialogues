digraph {
	0 [label="MarieRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Bonjour，bonjour，漂泊者 ！这大好的日子你过得如何 ？或者该说是今晚？我实在搞不清这地方究竟是什么时间了。",shape=box,color=blue];
		1 -> 2;
	2 [label="我确信洛德先生收藏的这些 bibelots 里有一件是钟表，但我怎么也认不出是哪一件。",shape=box,color=blue];
		2 -> 3;
	3 [label="我不敢触碰这座奇妙圣所里的任何装置。我深信把自己冲向遥远时光的概率，与泡好一杯热茶的概率相差无几。",shape=box,color=blue];
		3 -> 5;
		3 -> 6;
		3 -> 4;
	5 [label="那最好别按那些你不确定的按钮。 ",shape=box,color=red];
		5 -> 8;
	6 [label="我相信你会没事的。",shape=box,color=red];
		6 -> 9;
	4 [label="[结束]",shape=box,color=red];
		4 -> 7;
	8 [label="确实是很好的建议。我从洛德先生那里听说，你自己也经历过 aventure temporelle。我想知道——",shape=box,color=blue];
		8 -> 10;
	9 [label="C'est très gentil de votre part，不过……你又不是那个被抛到另一个……啊。对对 ！没错  ！",shape=box,color=blue];
		9 -> 11;
	7 [label="Chat ends.",color=orange];
	10 [label="它有这次这么危险吗 ？",shape=box,color=blue];
		10 -> 12;
		10 -> 13;
	11 [label="你当然知道，对吧？抱歉。你自己的冒险经历也像这次一样危险吗 ？",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="是整个时期？还是我在那里时候的体验？",shape=box,color=red];
		12 -> 14;
	13 [label="那是不同的情况，但我保证你在这里很安全。",shape=box,color=red];
		13 -> 15;
	14 [label="+10 Chemistry",color=orange];
		14 -> 16;
	15 [label="我非常感谢你这番振奋人心的信任，但我并不完全认同。尤其当我连分辨时间都这么困难的情况下。",shape=box,color=blue];
		15 -> 17;
	16 [label="区分这一点很好。我十分确信你过去的经历在总体标准下算不上“正常”。不过就从你描述的情况来看，我当然希望不是这样。",shape=box,color=blue];
		16 -> 18;
	17 [label="按理说这个……“屏幕”的角落里应该会显示，可根本没有 ！要我说，Mauvaise qualité。",shape=box,color=blue];
		17 -> 19;
	18 [label="我指的是“时间段”本身。请让我调整下措辞——",shape=box,color=blue];
		18 -> 20;
	19 [label="不管怎样，我们已经离我的问题偏离得相当远了 ！",shape=box,color=blue];
		19 -> 20;
	20 [label="你去过的那个“过去”时代，它确实更接近我所来自的“更遥远的过去”，与当下我们所处的时代相比，是否存在或多或少的潜在危险 ？",shape=box,color=blue];
		20 -> 21;
	21 [label="（天哪 ！我真是太喜欢聊这些了，这可比擦拭圣餐器皿有趣多了。）",shape=box,color=blue];
		21 -> 22;
		21 -> 23;
		21 -> 24;
		21 -> 25;
	22 [label="我觉得差不多。武器装备不同，他们或许还不清楚自己将面对什么，但战争就是战争，死亡就是死亡。",shape=box,color=red];
		22 -> 26;
	23 [label="我觉得这次没那么危险。我们更有能力应对当前面临的挑战。他们才刚刚起步。",shape=box,color=red];
		23 -> 27;
	24 [label="我觉得这次更危险。虽然我们仍面临共同的感染者，但他们当时使用的武器远不如现在先进。",shape=box,color=red];
		24 -> 27;
	25 [label="说实话，我很高兴你玩得开心。突然要适应这么多新变化，确实不容易。",shape=box,color=red];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="你说的或许有道理。我会好好考虑的。谢谢你。",shape=box,color=blue];
		27 -> 30;
	28 [label="+5 Chemistry",color=orange];
		28 -> 31;
	29 [label="凡事皆如此，我想终究是相对的，non ？如今猎杀我们的掠食者与当年追捕我们的一样凶残。只是磨利了獠牙罢了。",shape=box,color=blue];
		29 -> 32;
		29 -> 33;
	30 [label="Chat ends.",color=orange];
	31 [label="星期日主教——也就是你们的阿尔布雷希特·英择谛——早已为我铺垫了这一切。与我亲爱的里昂不同的是，我把他的话当作事实。也与里昂不同的是，我认为这是我们伟大的冒险，而不是负担。",shape=box,color=blue];
		31 -> 34;
	32 [label="除非你是奥罗金，他们找到了避免死亡的方法……至少理论上如此，实践中未必能实现。",shape=box,color=red];
		32 -> 35;
	33 [label="我也为你能很好地适应未来感到高兴。",shape=box,color=red];
		33 -> 36;
	34 [label="侍奉双耀神不必是种苦行。在这点上，我们始终存在分歧。",shape=box,color=blue];
		34 -> 37;
	35 [label="而我相信恶魔正是完美的例子，说明为什么死亡是月神赐予我们最伟大的礼物。",shape=box,color=blue];
		35 -> 38;
	36 [label="+5 Chemistry",color=orange];
		36 -> 39;
	37 [label="Update boolean MarieLyonSuffering1",color=orange];
		37 -> 40;
	38 [label="Update boolean MarieRoathe1",color=orange];
		38 -> 41;
	39 [label="星期日主教——也就是你们的阿尔布雷希特·英择谛——早已为我铺垫了这一切。与我亲爱的里昂不同的是，我把他的话当作事实。也与里昂不同的是，我认为这是我们伟大的冒险，而不是负担。",shape=box,color=blue];
		39 -> 42;
	40 [label="别回避我的问题，傻瓜 ！你觉得哪个更危险 ？",shape=box,color=blue];
		40 -> 43;
		40 -> 44;
		40 -> 45;
	41 [label="哦 ！这倒是我听得出的钟声，虽然还是没法确定这该死的东西藏在哪里。不管怎样，我怕是得走了。跟你聊的真是很开心。期待我们下次“再见” ！Aux Dieux ！",shape=box,color=blue];
		41 -> 46;
	42 [label="侍奉双耀神不必是种苦行。在这点上，我们始终存在分歧。",shape=box,color=blue];
		42 -> 47;
	43 [label="我相信这次更危险。有多少不可能打倒的敌人想置我们于死地？",shape=box,color=red];
		43 -> 48;
	44 [label="我认为我们这个时代没那么危险。他们只是在探索新的自相残杀方式。我们的手段或许在形式上更刺激些罢了。",shape=box,color=red];
		44 -> 48;
	45 [label="我认为最终结果大概相差无几。死亡就是死亡，不是吗？",shape=box,color=red];
		45 -> 49;
	46 [label="Chat ends.",color=orange];
	47 [label="Update boolean MarieLyonSuffering1",color=orange];
		47 -> 41;
	48 [label="你说的或许有道理。我会好好考虑的。谢谢你。",shape=box,color=blue];
		48 -> 50;
	49 [label="+5 Chemistry",color=orange];
		49 -> 51;
	50 [label="Chat ends.",color=orange];
	51 [label="凡事皆如此，我想终究是相对的，不是吗 ？如今猎杀我们的掠食者与当年追捕我们的一样凶残。只是磨利了獠牙罢了。",shape=box,color=blue];
		51 -> 52;
		51 -> 53;
	52 [label="作为一个试图抵御狼的人，我常常为此感到精疲力竭。",shape=box,color=red];
		52 -> 54;
	53 [label="除非你是奥罗金，他们找到了避免死亡的方法……至少理论上如此，实践中未必能实现。",shape=box,color=red];
		53 -> 55;
	54 [label="我认为你啊，我亲爱的漂泊者，更可能一头扎进狼群，而非坐守防线。这话我可是真心实意地夸你。",shape=box,color=blue];
		54 -> 41;
	55 [label="而我相信恶魔正是完美的例子，说明为什么死亡是月神赐予我们最伟大的礼物。",shape=box,color=blue];
		55 -> 56;
	56 [label="Update boolean MarieRoathe1",color=orange];
		56 -> 41;
}