		2308 -> 2310 [label="false",color=purple];
		2308 -> 2312 [label="false",color=purple];
	2310 [label="他不需要告诉我，我就能猜到。是因为英择谛吧。",shape=box,color=red];
		2310 -> 2314;
	2311 [label="是的。不过他似乎最关心的是你。",shape=box,color=red];
		2311 -> 2315;
	2309 [label="是的。他很关心这个情况，是因为我觉得他同情科维兽。 ",shape=box,color=red];
		2309 -> 2313;
	2312 [label="没有，老实说。他只是说我应该去看看你。",shape=box,color=red];
		2312 -> 2316;
	2314 [label="是的。标弃先生因为主教的话题一直在吵。",shape=box,color=blue];
		2314 -> 2318;
		2314 -> 2319;
	2315 [label="我不知道恶魔为何要让你相信这样的事。也不知道这对他有何好处。",shape=box,color=blue];
		2315 -> 2320;
	2313 [label="恶魔看到三只受伤的动物，就知道他可以轻易地运用他的 charisme 让它们对他俯首称臣。",shape=box,color=blue];
		2313 -> 2317;
	2316 [label="我不知道恶魔为何要让你做这样的事。也不知道他认为这对他有何好处。",shape=box,color=blue];
		2316 -> 2321;
	2318 [label="标弃并不是英择谛的支持者。",shape=box,color=red];
		2318 -> 2323;
	2319 [label="看来这场争吵很激烈。",shape=box,color=red];
		2319 -> 2324;
	2320 [label="恶魔对我所有所谓的好心，都是为了实现他的目的——让我背叛主教。我知道。 ",shape=box,color=blue];
		2320 -> 2322;
	2317 [label="他这么做是为了扭转局势，使局势对我不利。他想引诱我堕落，让我背叛主教。他想让我背叛他。我知道。",shape=box,color=blue];
		2317 -> 2322;
	2321 [label="但……你来这不是为了讨论这个。这场争吵是因为主教。 ",shape=box,color=blue];
		2321 -> 2318;
		2321 -> 2319;
	2323 [label="这正是我不明白的地方 ！看看他们都得到了什么 ！",shape=box,color=blue];
		2323 -> 2325;
		2323 -> 2326;
	2324 [label="Oui ！他骂我是笨蛋。他说我除了是孩子就什么都不是。",shape=box,color=blue];
		2324 -> 2327;
		2324 -> 2325;
	2322 [label="我和标弃先生争论的话题就是关于主教。",shape=box,color=blue];
		2322 -> 2318;
		2322 -> 2319;
	2325 [label="请从头说起吧。这场争吵是怎么开始的 ？",shape=box,color=red];
		2325 -> 2328;
	2326 [label="我开始明白这场争吵发生的原因了。",shape=box,color=red];
		2326 -> 2328;
	2327 [label="他真的有说你是笨蛋和小孩子吗 ？",shape=box,color=red];
		2327 -> 2329;
	2328 [label="Oui。我只是提到了主教，但我甚至都不知道原因是什么。 ",shape=box,color=blue];
		2328 -> 2330;
	2329 [label="或许更糟。",shape=box,color=blue];
		2329 -> 2331;
	2330 [label="标弃先生翻了个白眼，哼了一声。然后我请他解释一下他为什么嘲笑我。",shape=box,color=blue];
		2330 -> 2332;
	2331 [label="“玛丽，你只是个小崽子 ！天真。一辈子都要依赖别人。蜷缩在你那盲目信仰的小窝里 ！”",shape=box,color=blue];
		2331 -> 2333;
	2332 [label="“阿尔布雷希特就是个肮脏、臭气熏天的骗子 ！”",shape=box,color=blue];
		2332 -> 2334;
	2333 [label="“靠着长辈们嚼碎并吐进你那张大嘴巴里的东西活着 ！”",shape=box,color=blue];
		2333 -> 2335;
	2334 [label="Et j'ai répondu，“看看你被赋予的恩赐——思想的恩赐、语言的恩赐、自我的恩赐！”",shape=box,color=blue];
		2334 -> 2336;
