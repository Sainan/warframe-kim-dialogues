		j946548047 -> j3913177543 [label="false",color=purple];
	j1805302709 [label="那也不能成为他说那些话的理由 ！我不知道他是否意识到他的话伤我有多深。En outre——",shape=box,color=blue];
		j1805302709 -> j946548047;
	j679363616 [label="Merci，我不知道他是否意识到他的话伤我有多深。",shape=box,color=blue];
		j679363616 -> j147974256;
		j679363616 -> j2087567358;
		j679363616 -> j1258266472;
	j333975766 [label="如果这就是主教期待归来时受到的“欢迎”，那么他不回来也就不足为奇了 ！",shape=box,color=blue];
		j333975766 -> j1312833712;
		j333975766 -> j815531726;
	j1483032177 [label="我敢肯定，对于这一切事，你是站在标弃先生一边的，non ？你和野兽一样，都认为主教是个怪物。",shape=box,color=blue];
		j1483032177 -> j1312833712;
		j1483032177 -> j1451459024;
	j94002003 [label="我很惊讶，je pensais que tu étais de mon côté ！你刚才不是和我一起支持主教的事业吗 ？",shape=box,color=blue];
		j94002003 -> j2001040150;
	j1059407272 [label="就像你之前说的，这有什么关系 ？我们只管服侍他，评判的事留到以后。这场争吵毫无意义，non ？",shape=box,color=blue];
		j1059407272 -> j1782291837;
		j1059407272 -> j4179173841;
	j3913177543 [label="我知道它们是通过主教之手在虚空中被造的。我们所有人都曾被主教赐予了恩赐，但若以一颗破碎的心去看待，它们就如同咒诅 ！",shape=box,color=blue];
		j3913177543 -> j2336690355;
	j147974256 [label="那你知道你的话伤他有多深吗 ？你知道他们的全部故事吗 ？",shape=box,color=red];
		j147974256 -> j3913177543;
	j2087567358 [label="你说的话也同样伤害了他。",shape=box,color=red];
		j2087567358 -> j1694787961;
	j1258266472 [label="老实说，我是站在你这边的，但是玛丽……我们必须努力保持和平。",shape=box,color=red];
		j1258266472 -> j2972770010;
		j1258266472 -> j3481130694;
	j1312833712 [label="玛丽，拜托了。我不是想吵架。我只是想让你明白他们经历了什么。",shape=box,color=red];
		j1312833712 -> j2893274268;
	j815531726 [label="如果英择谛留下来帮忙收拾自己造成的烂摊子，他在这个世界上可能会有更多的朋友。",shape=box,color=red];
		j815531726 -> j1292638115;
	j1451459024 [label="是的，我站在他那边。因为你不讲道理。你得明白，“主教”并非表面看起来的那样。",shape=box,color=red];
		j1451459024 -> j2893274268;
	j2001040150 [label="你这是在扮演个大骗子吗 ？你跟小玛丽在玩什么 un jeu ？",shape=box,color=blue];
		j2001040150 -> j1027080212;
		j2001040150 -> j3433415367;
	j1782291837 [label="如果只有我们还在为这件事争吵，而其他人早已不相信英择谛，那就有关系了。他们经历了太多。",shape=box,color=red];
		j1782291837 -> j2893274268;
	j4179173841 [label="我相信他会放下的。我相信你也会。",shape=box,color=red];
		j4179173841 -> j3855669700;
	j2336690355 [label="我们​所有​人​都​被​他​抛弃​了​ ！​那​你​告诉​我，​他们​究竟​受​了​多​少​冤屈，​我​凭​什么​还​要​承受​这样​的​仇恨​ ？！​",shape=box,color=blue];
		j2336690355 -> j1639327012;
	j1694787961 [label="Oui ？！那告诉我为什么 ！",shape=box,color=blue];
		j1694787961 -> j3913177543;
	j2972770010 [label="科维兽的经历……很艰难。",shape=box,color=red];
		j2972770010 -> j3913177543;
	j3481130694 [label="他们是动物，即便他们被赋予了智慧，他们仍然是动物。他们的能力是有限的。",shape=box,color=red];
		j3481130694 -> j572628020;
	j2893274268 [label="Oui ？那就请你扮演 La Lumière Sacrée de Sol，驱散黑暗吧 ！启发愚蠢的小玛丽 ！",shape=box,color=blue];
		j2893274268 -> j3913177543;
	j1292638115 [label="Oui ！是的，他在尽力从虚空之神手中拯救这个宇宙，这还不够吗，non ？！",shape=box,color=blue];
		j1292638115 -> j3380051056;
	j1027080212 [label="不，我没有撒谎。我是站在你这边的。我只是说他们的经历……很艰难。",shape=box,color=red];
		j1027080212 -> j2893274268;
	j3433415367 [label="不，确切地说，不是游戏…… ？英择​谛不​可信，除了假装站在你这边，我不知道还有什么其他办法可以说服你。",shape=box,color=red];
		j3433415367 -> j40932329;
	j3855669700 [label="Non ！是你开始了这话题的，你得说完。Explique ！",shape=box,color=blue];
		j3855669700 -> j3913177543;
