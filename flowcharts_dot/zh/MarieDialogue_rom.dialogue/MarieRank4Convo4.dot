		2347 -> 2355;
		2347 -> 2356;
	2348 [label="我敢肯定，对于这一切事，你是站在标弃先生一边的，non ？你和野兽一样，都认为主教是个怪物。",shape=box,color=blue];
		2348 -> 2357;
		2348 -> 2358;
	2349 [label="我很惊讶，je pensais que tu étais de mon côté ！你刚才不是和我一起支持主教的事业吗 ？",shape=box,color=blue];
		2349 -> 2359;
	2351 [label="就像你之前说的，这有什么关系 ？我们只管服侍他，评判的事留到以后。这场争吵毫无意义，non ？",shape=box,color=blue];
		2351 -> 2361;
		2351 -> 2362;
	2350 [label="我知道它们是通过主教之手在虚空中被造的。我们所有人都曾被主教赐予了恩赐，但若以一颗破碎的心去看待，它们就如同咒诅 ！",shape=box,color=blue];
		2350 -> 2360;
	2352 [label="那你知道你的话伤他有多深吗 ？你知道他们的全部故事吗 ？",shape=box,color=red];
		2352 -> 2350;
	2353 [label="你说的话也同样伤害了他。",shape=box,color=red];
		2353 -> 2363;
	2354 [label="老实说，我是站在你这边的，但是玛丽……我们必须努力保持和平。",shape=box,color=red];
		2354 -> 2364;
		2354 -> 2365;
	2355 [label="玛丽，拜托了。我不是想吵架。我只是想让你明白他们经历了什么。",shape=box,color=red];
		2355 -> 2366;
	2356 [label="如果英择谛留下来帮忙收拾自己造成的烂摊子，他在这个世界上可能会有更多的朋友。",shape=box,color=red];
		2356 -> 2367;
	2357 [label="玛丽，拜托了。我不是想吵架。我只是想让你明白他们经历了什么。",shape=box,color=red];
		2357 -> 2366;
	2358 [label="是的，我站在他那边。因为你不讲道理。你得明白，“主教”并非表面看起来的那样。",shape=box,color=red];
		2358 -> 2366;
	2359 [label="你这是在扮演个大骗子吗 ？你跟小玛丽在玩什么 un jeu ？",shape=box,color=blue];
		2359 -> 2368;
		2359 -> 2369;
	2361 [label="如果只有我们还在为这件事争吵，而其他人早已不相信英择谛，那就有关系了。他们经历了太多。",shape=box,color=red];
		2361 -> 2366;
	2362 [label="我相信他会放下的。我相信你也会。",shape=box,color=red];
		2362 -> 2371;
	2360 [label="我们​所有​人​都​被​他​抛弃​了​ ！​那​你​告诉​我，​他们​究竟​受​了​多​少​冤屈，​我​凭​什么​还​要​承受​这样​的​仇恨​ ？！​",shape=box,color=blue];
		2360 -> 2370;
	2363 [label="Oui ？！那告诉我为什么 ！",shape=box,color=blue];
		2363 -> 2350;
	2364 [label="科维兽的经历……很艰难。",shape=box,color=red];
		2364 -> 2350;
	2365 [label="他们是动物，即便他们被赋予了智慧，他们仍然是动物。他们的能力是有限的。",shape=box,color=red];
		2365 -> 2372;
	2366 [label="Oui ？那就请你扮演 La Lumière Sacrée de Sol，驱散黑暗吧 ！启发愚蠢的小玛丽 ！",shape=box,color=blue];
		2366 -> 2350;
	2367 [label="Oui ！是的，他在尽力从虚空之神手中拯救这个宇宙，这还不够吗，non ？！",shape=box,color=blue];
		2367 -> 2373;
	2368 [label="不，我没有撒谎。我是站在你这边的。我只是说他们的经历……很艰难。",shape=box,color=red];
		2368 -> 2366;
	2369 [label="不，确切地说，不是游戏…… ？英择​谛不​可信，除了假装站在你这边，我不知道还有什么其他办法可以说服你。",shape=box,color=red];
