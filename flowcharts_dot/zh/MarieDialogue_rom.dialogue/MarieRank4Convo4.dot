		2297 -> 2293;
	2298 [label="Si je le pouvais，je prendrais ce couteau qu'il aime tant utiliser pour agacer les autres et je le fourrerais là où seule Lua peut le voir ！",shape=box,color=blue];
		2298 -> 2301;
	2299 [label="确实，但我觉得你大概是不想让我心情更糟。所以……我就不追问了。",shape=box,color=blue];
		2299 -> 2302;
	2300 [label="我觉得你大概是不想让我心情更糟而撒谎。所以……我就不追问了。",shape=box,color=blue];
		2300 -> 2302;
	2301 [label="请原谅我。那……太不合适了。我是 une Sœur de Sol，我不能这样发脾气，也不能这样乱说话。",shape=box,color=blue];
		2301 -> 2303;
	2302 [label="+5 Chemistry",color=orange];
		2302 -> 2304;
	2303 [label="+5 Chemistry",color=orange];
		2303 -> 2305;
	2304 [label="我希望在这次谈话中，还能保留我那一点点尊严。",shape=box,color=blue];
		2304 -> 2306;
	2305 [label="我的愤怒并非针对你。而且我也一直感激你的坦诚。",shape=box,color=blue];
		2305 -> 2307;
