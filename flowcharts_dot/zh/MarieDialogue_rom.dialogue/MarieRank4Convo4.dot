		2373 -> 2381;
	2374 [label="Oui ？可惜，我很高兴地告诉你，你失败了。",shape=box,color=blue];
		2374 -> 2382;
	2375 [label="科维兽是实验中意外诞生的。本不该存在的实验室动物。是虚空赋予了它们智慧。",shape=box,color=red];
		2375 -> 2383;
	2377 [label="你自己说过，“没有名字，这是最残酷的事。” 英择谛从来就不会费心去给他们起名，因为他们太没价值了。",shape=box,color=red];
		2377 -> 2385;
	2378 [label="你跟我讲过你在街头长大的故事。你的家人因为你不够好而把你赶出家门。",shape=box,color=red];
		2378 -> 2386;
	2379 [label="想想看，如果有人不顾你的意愿把你变成了一个原型战甲，然后抛弃了你，你会有什么感受 ？",shape=box,color=red];
		2379 -> 2387;
	2376 [label="想象一下，如果英择谛突然出现，将里昂变成原型战甲，然后抛弃他，你会有何感想 ？",shape=box,color=red];
		2376 -> 2384;
	2380 [label="也​许​我们​最好​就​此​打住。​以免​大家​的​情绪​失控。​",shape=box,color=blue];
		2380 -> 2388;
	2381 [label="Chat ends.",color=orange];
	2382 [label="Update boolean MarieEntratiFan1",color=orange];
		2382 -> 2389;
	2383 [label="当英择谛看到自己的所作所为 ？当他意识到自己创造了什么时 ？这些说着虚空之语的可怜动物，却患了虚空暴露症 ？",shape=box,color=red];
		2383 -> 2390;
	2385 [label="对他来说，他们只是些东西。用完就扔的东西。“标弃 ？”意思是“标记为弃品”。",shape=box,color=red];
		2385 -> 2392;
	2386 [label="你的家人认为你一文不值。",shape=box,color=red];
		2386 -> 2393;
	2387 [label="想象一下，如果你的血液中被感染，痛苦不堪，却没有人关心，那会是什么感觉 ？",shape=box,color=red];
		2387 -> 2394;
	2384 [label="把他当成廉价的科学实验品，然后就甩手不管了 ？你们在被改造前后​尚且​可以互相依靠。而科维兽却不行。",shape=box,color=red];
		2384 -> 2391;
	2388 [label="Chat ends.",color=orange];
	2389 [label="Update boolean MarieEntratiFan2",color=orange];
		2389 -> 2395;
	2390 [label="他一点也不在乎。 ",shape=box,color=red];
		2390 -> 2396;
	2392 [label="鸟三 ？它是一只用数字命名的鸟。倒是斐波那契给自己取了个名字。",shape=box,color=red];
		2392 -> 2397;
	2393 [label="对英择谛来说，科维兽就是那样的存在。一次性实验动物。“标弃？”意思是“标记为弃品”。",shape=box,color=red];
		2393 -> 2392;
	2394 [label="你所受的痛苦真的那么重要吗 ？对英择谛来说，科维兽曾是——现在也是——一次性实验动物。“标弃？”意思是“标记为弃品”。",shape=box,color=red];
		2394 -> 2392;
	2391 [label="对英择谛来说，科维兽不过是一次性实验动物，毫无价值。“标弃 ？”意思是“标记为弃品”。",shape=box,color=red];
		2391 -> 2392;
	2395 [label="Update boolean MarieNoDate",color=orange];
		2395 -> 2398;
	2396 [label="对英择谛来说，科维兽就是那样的存在。一次性的。“标弃 ？”意思是“标记为弃品”。",shape=box,color=red];
		2396 -> 2399;
	2397 [label="他们被用于虚空实验。是一连串死去动物中的幸存者。本不该存在。",shape=box,color=red];
		2397 -> 2400;
	2398 [label="Chat ends.",color=orange];
	2399 [label="他是他们种族的最后一个了。被标记为弃品。而他的伴侣小敏 ？也是唯二剩下的 ？在实验中死了。",shape=box,color=red];
		2399 -> 2401;
	2400 [label="正是因为洛德，他们才得以存活。他之所以会保住他们，是因为他无法“按照英择谛的指示”对他们实施安乐死。",shape=box,color=red];
		2400 -> 2402;
	2401 [label="玛丽，这就是他生气的原因。也是他憎恨英择谛的原因。而且，他可能永远都会憎恨英择谛。",shape=box,color=red];
		2401 -> 2403;
	2402 [label="哦，还有标弃 ？他是他们种族的最后一个了。他的伴侣小敏 ？也是唯二剩下的 ？在实验中死了。",shape=box,color=red];
		2402 -> 2404;
