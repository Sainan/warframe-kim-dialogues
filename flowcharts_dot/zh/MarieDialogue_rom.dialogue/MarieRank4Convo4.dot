		j1639327012 -> j2463657715 [label="false",color=purple];
	j572628020 [label="如果你是在试图激起我的同情，让我转而同情他们，并将我的愤怒发泄到你身上，我突然很想这么做。",shape=box,color=blue];
		j572628020 -> j3380051056;
	j3380051056 [label="也​许​我们​最好​就​此​打住。​以免​大家​的​情绪​失控。​",shape=box,color=blue];
		j3380051056 -> "Chat ends.";
	j40932329 [label="Oui ？可惜，我很高兴地告诉你，你失败了。",shape=box,color=blue];
		j40932329 -> j1509439757;
	j2463657715 [label="科维兽是实验中意外诞生的。本不该存在的实验室动物。是虚空赋予了它们智慧。",shape=box,color=red];
		j2463657715 -> j3705306499;
	j259163012 [label="你自己说过，“没有名字，这是最残酷的事。” 英择谛从来就不会费心去给他们起名，因为他们太没价值了。",shape=box,color=red];
		j259163012 -> j1105968509;
	j334057811 [label="你跟我讲过你在街头长大的故事。你的家人因为你不够好而把你赶出家门。",shape=box,color=red];
		j334057811 -> j2598062017;
	j3527277532 [label="想想看，如果有人不顾你的意愿把你变成了一个原型战甲，然后抛弃了你，你会有什么感受 ？",shape=box,color=red];
		j3527277532 -> j1185317098;
	j710401768 [label="想象一下，如果英择谛突然出现，将里昂变成原型战甲，然后抛弃他，你会有何感想 ？",shape=box,color=red];
		j710401768 -> j2226738528;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j3705306499 [label="当英择谛看到自己的所作所为 ？当他意识到自己创造了什么时 ？这些说着虚空之语的可怜动物，却患了虚空暴露症 ？",shape=box,color=red];
		j3705306499 -> j2354435803;
	j1105968509 [label="对他来说，他们只是些东西。用完就扔的东西。“标弃 ？”意思是“标记为弃品”。",shape=box,color=red];
		j1105968509 -> j4194583038;
