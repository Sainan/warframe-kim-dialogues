	2404 [label="玛丽，这就是他生气的原因。也是他憎恨英择谛的原因。而且，他可能永远都会憎恨英择谛。",shape=box,color=red];
		2404 -> 2407;
	2405 [label="我知道你认为他正在做该做的事。我也知道你相信宽恕。我也是。但你得明白，为什么对某些人来说，宽恕是不可能的。至少现在还不可能。",shape=box,color=red];
		2405 -> 2408;
