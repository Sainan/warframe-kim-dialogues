		j4194583038 -> j3233762281;
	j913740948 [label="对英择谛来说，科维兽就是那样的存在。一次性实验动物。“标弃？”意思是“标记为弃品”。",shape=box,color=red];
		j913740948 -> j4194583038;
	j185968547 [label="你所受的痛苦真的那么重要吗 ？对英择谛来说，科维兽曾是——现在也是——一次性实验动物。“标弃？”意思是“标记为弃品”。",shape=box,color=red];
		j185968547 -> j4194583038;
	j607570750 [label="对英择谛来说，科维兽不过是一次性实验动物，毫无价值。“标弃 ？”意思是“标记为弃品”。",shape=box,color=red];
		j607570750 -> j4194583038;
