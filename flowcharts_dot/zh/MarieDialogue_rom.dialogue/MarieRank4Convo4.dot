	j3186214478 [label="玛丽 ？我们可以谈谈吗 ？",shape=box,color=red];
		j3186214478 -> j1078373964;
	j182667486 [label="罗瑟跟我提过……你和标弃的那场争吵。我们可以聊聊吗 ？",shape=box,color=red];
		j182667486 -> j3155937148;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	"Chat ends." [color=orange];
	j1078373964 [label="Oui，虽然我感觉我知道你要谈什么……我表现得很糟糕。是谁告诉你的 ？",shape=box,color=blue];
		j1078373964 -> j1828537046;
		j1078373964 -> j3628487448;
		j1078373964 -> j942641761;
	j3155937148 [label="Bien sûr，ce salaud de diable ouvre sa bouche et vous raconte tout ！Il ne cherche qu'à m'embarrasser ！",shape=box,color=blue];
		j3155937148 -> j2303580527;
	j1828537046 [label="这不重要。",shape=box,color=red];
		j1828537046 -> j1421730323;
	j3628487448 [label="洛德。",shape=box,color=red];
		j3628487448 -> j4194520929;
	j942641761 [label="罗瑟。",shape=box,color=red];
		j942641761 -> j3155937148;
	j2303580527 [label="Si je le pouvais，je prendrais ce couteau qu'il aime tant utiliser pour agacer les autres et je le fourrerais là où seule Lua peut le voir ！",shape=box,color=blue];
		j2303580527 -> j556956039;
	j1421730323 [label="确实，但我觉得你大概是不想让我心情更糟。所以……我就不追问了。",shape=box,color=blue];
		j1421730323 -> j3324534878;
	j4194520929 [label="我觉得你大概是不想让我心情更糟而撒谎。所以……我就不追问了。",shape=box,color=blue];
		j4194520929 -> j3324534878;
	j556956039 [label="请原谅我。那……太不合适了。我是 une Sœur de Sol，我不能这样发脾气，也不能这样乱说话。",shape=box,color=blue];
		j556956039 -> j1902574017;
	j3324534878 [label="+5 Chemistry",color=orange];
		j3324534878 -> j347270882;
	j1902574017 [label="+5 Chemistry",color=orange];
		j1902574017 -> j698451963;
	j347270882 [label="我希望在这次谈话中，还能保留我那一点点尊严。",shape=box,color=blue];
		j347270882 -> j1566429399;
	j698451963 [label="我的愤怒并非针对你。而且我也一直感激你的坦诚。",shape=box,color=blue];
		j698451963 -> j3198532228;
	j1566429399 [label="如果你是为我和标弃先生之间的争吵而来，我不会否认，这件事确实发生过。",shape=box,color=blue];
		j1566429399 -> j3198532228;
	j3198532228 [label="我猜恶魔已经告诉你这场争吵是为了什么了 ？",shape=box,color=blue];
		j3198532228 -> j370765590;
	j370765590 [label="Evaluate expressions",color=orange];
		j370765590 -> j286071477 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j1277265807 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j133101861 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j286071477 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j286071477 [label="false",color=purple];
		j370765590 -> j1376085586 [label="false",color=purple];
	j286071477 [label="他不需要告诉我，我就能猜到。是因为英择谛吧。",shape=box,color=red];
		j286071477 -> j3996557073;
	j1277265807 [label="是的。不过他似乎最关心的是你。",shape=box,color=red];
		j1277265807 -> j2199741103;
	j133101861 [label="是的。他很关心这个情况，是因为我觉得他同情科维兽。 ",shape=box,color=red];
		j133101861 -> j3207634329;
	j1376085586 [label="没有，老实说。他只是说我应该去看看你。",shape=box,color=red];
		j1376085586 -> j1447658614;
	j3996557073 [label="是的。标弃先生因为主教的话题一直在吵。",shape=box,color=blue];
		j3996557073 -> j1908780337;
		j3996557073 -> j3951307385;
	j2199741103 [label="我不知道恶魔为何要让你相信这样的事。也不知道这对他有何好处。",shape=box,color=blue];
		j2199741103 -> j1838922841;
	j3207634329 [label="恶魔看到三只受伤的动物，就知道他可以轻易地运用他的 charisme 让它们对他俯首称臣。",shape=box,color=blue];
		j3207634329 -> j1474481811;
	j1447658614 [label="我不知道恶魔为何要让你做这样的事。也不知道他认为这对他有何好处。",shape=box,color=blue];
		j1447658614 -> j787992686;
	j1908780337 [label="标弃并不是英择谛的支持者。",shape=box,color=red];
		j1908780337 -> j2810149202;
	j3951307385 [label="看来这场争吵很激烈。",shape=box,color=red];
		j3951307385 -> j182061592;
	j1838922841 [label="恶魔对我所有所谓的好心，都是为了实现他的目的——让我背叛主教。我知道。 ",shape=box,color=blue];
		j1838922841 -> j1100826096;
	j1474481811 [label="他这么做是为了扭转局势，使局势对我不利。他想引诱我堕落，让我背叛主教。他想让我背叛他。我知道。",shape=box,color=blue];
		j1474481811 -> j1100826096;
	j787992686 [label="但……你来这不是为了讨论这个。这场争吵是因为主教。 ",shape=box,color=blue];
		j787992686 -> j1908780337;
		j787992686 -> j3951307385;
	j2810149202 [label="这正是我不明白的地方 ！看看他们都得到了什么 ！",shape=box,color=blue];
		j2810149202 -> j377065560;
		j2810149202 -> j2538921458;
	j182061592 [label="Oui ！他骂我是笨蛋。他说我除了是孩子就什么都不是。",shape=box,color=blue];
		j182061592 -> j2987299299;
		j182061592 -> j377065560;
	j1100826096 [label="我和标弃先生争论的话题就是关于主教。",shape=box,color=blue];
		j1100826096 -> j1908780337;
		j1100826096 -> j3951307385;
	j377065560 [label="请从头说起吧。这场争吵是怎么开始的 ？",shape=box,color=red];
		j377065560 -> j3111416065;
	j2538921458 [label="我开始明白这场争吵发生的原因了。",shape=box,color=red];
		j2538921458 -> j3111416065;
	j2987299299 [label="他真的有说你是笨蛋和小孩子吗 ？",shape=box,color=red];
		j2987299299 -> j1197040222;
	j3111416065 [label="Oui。我只是提到了主教，但我甚至都不知道原因是什么。 ",shape=box,color=blue];
		j3111416065 -> j3918990295;
	j1197040222 [label="或许更糟。",shape=box,color=blue];
		j1197040222 -> j3999568420;
	j3918990295 [label="标弃先生翻了个白眼，哼了一声。然后我请他解释一下他为什么嘲笑我。",shape=box,color=blue];
		j3918990295 -> j2617997332;
	j3999568420 [label="“玛丽，你只是个小崽子 ！天真。一辈子都要依赖别人。蜷缩在你那盲目信仰的小窝里 ！”",shape=box,color=blue];
		j3999568420 -> j3048637207;
	j2617997332 [label="“阿尔布雷希特就是个肮脏、臭气熏天的骗子 ！”",shape=box,color=blue];
		j2617997332 -> j3281080859;
	j3048637207 [label="“靠着长辈们嚼碎并吐进你那张大嘴巴里的东西活着 ！”",shape=box,color=blue];
		j3048637207 -> j471012429;
	j3281080859 [label="Et j'ai répondu，“看看你被赋予的恩赐——思想的恩赐、语言的恩赐、自我的恩赐！”",shape=box,color=blue];
		j3281080859 -> j682529979;
	j471012429 [label="Boolean MarieEntrati3 is now true.",color=orange];
		j471012429 -> j1538950731;
		j471012429 -> j3948637741;
		j471012429 -> j1953019456;
	j682529979 [label="“你应该感谢主教给予你的一切祝福。”",shape=box,color=blue];
		j682529979 -> j3949269392;
		j682529979 -> j3137076251;
	j1538950731 [label="标弃只知道他那边的故事。英择谛真正的动机或想法……并没有说清楚。",shape=box,color=red];
		j1538950731 -> j3761638253;
	j3948637741 [label="我知道你对“依赖”他人的感受，我很抱歉他对你说了那些话。",shape=box,color=red];
		j3948637741 -> j3835015047;
	j1953019456 [label="标弃也有他自己的理由。",shape=box,color=red];
		j1953019456 -> j946548047;
