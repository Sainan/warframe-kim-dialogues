	1855 [label="他从你和我们这里，需要一些东西。 ",shape=box,color=blue];
		1855 -> 1857;
	1856 [label="Non，我没想建议你这么做。只是他……不值得信任。现在，甚至永远都不值得信任。",shape=box,color=blue];
		1856 -> 1851;
