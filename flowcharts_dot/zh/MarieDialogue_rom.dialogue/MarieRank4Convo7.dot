	1880 [label="Chat ends.",color=orange];
	1881 [label="我觉得你对他有点不公平。",shape=box,color=red];
		1881 -> 1885;
	1882 [label="我会小心的。我保证。",shape=box,color=red];
		1882 -> 1886;
	1883 [label="即使你们相信这背后的力量不是来自神，而是来自我们自己的意念，它仍然是一种威胁。",shape=box,color=blue];
		1883 -> 1878;
	1884 [label="即使他相信这背后的力量不是来自神，而是来自我们自己的意念，它仍然是一种威胁。",shape=box,color=blue];
