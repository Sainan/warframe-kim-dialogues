	1891 [label="他在几个世纪的时间里，做着他认为必要的事情。我们只是对什么是必要的有不认同的看法。",shape=box,color=red];
		1891 -> 1895;
		1891 -> 1897;
	1892 [label="我觉得他的很多……举止可能会激怒你，而不是他的行为。",shape=box,color=red];
		1892 -> 1897;
		1892 -> 1895;
	1893 [label="Chat ends.",color=orange];
	1894 [label="他是一位高级军官，社交名流。而这两个身份有时候需要他做出一些阴暗的决定。",shape=box,color=red];
		1894 -> 1898;
	1895 [label="我觉得一个人可以做我们认为是“错误的事情”，并且怀着好的意图这样做。",shape=box,color=red];
		1895 -> 1899;
	1896 [label="他所做的一切都是以拯救奥罗金帝国为名义——而他所得到的回报，却是违背他的意愿，被迫陷入这场混乱。",shape=box,color=red];
		1896 -> 1898;
	1897 [label="我觉得他惹恼你，是因为他为自己所做的事而感到自豪。",shape=box,color=red];
