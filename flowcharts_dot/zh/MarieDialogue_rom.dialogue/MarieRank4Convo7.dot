		1859 -> 1862 [label="false",color=purple];
	1858 [label="他失去的记忆，Tau 过去的恐怖……我担心它们预示着什么。",shape=box,color=blue];
		1858 -> 1860;
		1858 -> 1861;
	1863 [label="我知道你认为我们已经揭开了他破碎心灵中所有的秘密。",shape=box,color=blue];
		1863 -> 1866;
		1863 -> 1861;
	1862 [label="我们了解得越多，对他破碎的心灵探究得越深入，我就越感到不安。危险也越清晰。",shape=box,color=blue];
		1862 -> 1861;
		1862 -> 1860;
	1860 [label="我不认为他一恢复记忆，就会立刻消失。事情远不止于此。",shape=box,color=red];
		1860 -> 1864;
	1861 [label="他可能还在找寻更多。不在他的记忆里，而在我们这里。",shape=box,color=red];
		1861 -> 1865;
	1866 [label="我相信他，当他说我们能发现的就这些了。如果真是这样，那他为什么还在这里 ？",shape=box,color=red];
		1866 -> 1864;
	1864 [label="我承认我更担心的是，他打算用这些知识做什么，而不是知识本身。",shape=box,color=blue];
		1864 -> 1867;
	1865 [label="Oui ！这正是，我担心的。但那会是什么呢 ？我们现在帮他的目的是什么？",shape=box,color=blue];
		1865 -> 1867;
	1867 [label="不管他打算如何运用他的新身份，我担心他有意将我们卷入其中。我只希望我们不要被他某种程度上的仁慈所蒙蔽而参与进去。",shape=box,color=blue];
		1867 -> 1868;
		1867 -> 1869;
		1867 -> 1870;
	1868 [label="我同意你的看法。我不信任他。",shape=box,color=red];
		1868 -> 1871;
	1869 [label="他强大又博学。我更希望有他站在我这边。",shape=box,color=red];
		1869 -> 1872;
	1870 [label="担心他会不会背叛我们，没有任何好处——他还没这样做。我不会在人们还没犯罪时，就判定他们有罪。",shape=box,color=red];
		1870 -> 1873;
	1871 [label="+20 Chemistry",color=orange];
		1871 -> 1874;
	1872 [label="Add -1 to Thermostat",color=orange];
		1872 -> 1875;
	1873 [label="Add 1 to Thermostat",color=orange];
		1873 -> 1876;
	1874 [label="Bien ！这样我至少能安心了，因为我知道还有另一双眼睛盯着那个恶魔。这也许能有助我的睡眠。Merci。",shape=box,color=blue];
		1874 -> 1877;
	1875 [label="Oui，但我想知道这种结盟最终的代价到底是什么。你可能不会为所付的代价而高兴。",shape=box,color=blue];
		1875 -> 1878;
	1876 [label="Oui……我想你是对的。我们不能盲目跟风。我们必须和任何希望看到虚空无情之物被击败的人并肩站在一起。",shape=box,color=blue];
		1876 -> 1879;
	1877 [label="Update boolean MarieRoatheNoTrust",color=orange];
		1877 -> 1880;
	1878 [label="我只想劝你小心点……他是个披着绅士外衣的怪物。小心他，s'il te plaît ？",shape=box,color=blue];
		1878 -> 1881;
		1878 -> 1882;
