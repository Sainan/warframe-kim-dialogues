		1885 -> 1887;
	1886 [label="+20 Chemistry",color=orange];
		1886 -> 1888;
	1887 [label="Oui ？你怎么会这么觉得 ？我不是故意那么残忍的，我只是真的很好奇。",shape=box,color=blue];
		1887 -> 1889;
		1887 -> 1890;
		1887 -> 1891;
		1887 -> 1892;
	1888 [label="Merci。这就是我唯一的请求。",shape=box,color=blue];
		1888 -> 1893;
	1889 [label="他在一个不同的社会、不同的时代长大——背负着不同的期望。我们或许不喜欢，但他就是他。",shape=box,color=red];
		1889 -> 1894;
	1890 [label="你和里昂接受了英择谛的原型战甲血清。你们心甘情愿。他却没有。你能想象那是什么感觉吗？",shape=box,color=red];
		1890 -> 1895;
		1890 -> 1896;
