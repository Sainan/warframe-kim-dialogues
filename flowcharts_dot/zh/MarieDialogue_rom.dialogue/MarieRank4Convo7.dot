	1850 [label="[结束]",shape=box,color=red];
		1850 -> 1854;
	1851 [label="他是个野性十足的家伙。当你给他提供食物和温暖的住处时，他或许会靠近你，但一旦你对他不再有用，这一切便会消失殆尽。",shape=box,color=blue];
