digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo7 begins." [color=orange];
		"MarieRank4Convo7 begins." -> j3255816954;
	j3255816954 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j3255816954 -> j2046521972 [label="x >= 0",color=purple];
		j3255816954 -> "Chat ends." [label="x <= 0",color=purple];
		j3255816954 -> "Chat ends." [label="false",color=purple];
	j2046521972 [label="漂泊者，excusez-moi……你真的认为帮助恶魔是明智的吗 ？",shape=box,color=blue];
		j2046521972 -> j1941755081;
	"Chat ends." [color=orange];
	j1941755081 [label="我不想拒绝那些寻求赦免或援助的人，但是……我认为这两者都不是恶魔要找的。",shape=box,color=blue];
		j1941755081 -> j3530459007;
		j1941755081 -> j3797722922;
		j1941755081 -> j1185446669;
		j1941755081 -> j1038552372;
	j3530459007 [label="你觉得他真正要找的是什么 ？",shape=box,color=red];
		j3530459007 -> j199324220;
	j3797722922 [label="我知道你们俩关系不好，对此我感到很抱歉。但我又不能把他赶出去。",shape=box,color=red];
		j3797722922 -> j850690955;
	j1185446669 [label="罗瑟对奥罗金的遗忘——确切地说——比我们所知道的还要多。我们需要他。",shape=box,color=red];
		j1185446669 -> j1062218268;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j199324220 [label="他是个野性十足的家伙。当你给他提供食物和温暖的住处时，他或许会靠近你，但一旦你对他不再有用，这一切便会消失殆尽。",shape=box,color=blue];
		j199324220 -> j1373790415;
	j850690955 [label="Add 1 to Thermostat counter",color=orange];
		j850690955 -> j1358041076;
	j1062218268 [label="Add -1 to Thermostat counter",color=orange];
		j1062218268 -> j199324220;
	j1373790415 [label="他从你和我们这里，需要一些东西。 ",shape=box,color=blue];
		j1373790415 -> j863296879;
	j1358041076 [label="Non，我没想建议你这么做。只是他……不值得信任。现在，甚至永远都不值得信任。",shape=box,color=blue];
		j1358041076 -> j199324220;
	j863296879 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j863296879 -> j4093421340 [label="x > 5",color=purple];
		j863296879 -> j3833410741 [label="x <= 5",color=purple];
		j863296879 -> j3833410741 [label="false",color=purple];
	j4093421340 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4093421340 -> j995562484 [label="x >= 21",color=purple];
		j4093421340 -> j260562511 [label="x < 21",color=purple];
		j4093421340 -> j260562511 [label="false",color=purple];
	j3833410741 [label="他失去的记忆，Tau 过去的恐怖……我担心它们预示着什么。",shape=box,color=blue];
		j3833410741 -> j4071025646;
		j3833410741 -> j2667219862;
	j995562484 [label="我知道你认为我们已经揭开了他破碎心灵中所有的秘密。",shape=box,color=blue];
		j995562484 -> j719493662;
		j995562484 -> j2667219862;
	j260562511 [label="我们了解得越多，对他破碎的心灵探究得越深入，我就越感到不安。危险也越清晰。",shape=box,color=blue];
		j260562511 -> j2667219862;
		j260562511 -> j4071025646;
	j4071025646 [label="我不认为他一恢复记忆，就会立刻消失。事情远不止于此。",shape=box,color=red];
		j4071025646 -> j1309334345;
	j2667219862 [label="他可能还在找寻更多。不在他的记忆里，而在我们这里。",shape=box,color=red];
		j2667219862 -> j4188896377;
	j719493662 [label="我相信他，当他说我们能发现的就这些了。如果真是这样，那他为什么还在这里 ？",shape=box,color=red];
		j719493662 -> j1309334345;
	j1309334345 [label="我承认我更担心的是，他打算用这些知识做什么，而不是知识本身。",shape=box,color=blue];
		j1309334345 -> j426226291;
	j4188896377 [label="Oui ！这正是，我担心的。但那会是什么呢 ？我们现在帮他的目的是什么？",shape=box,color=blue];
		j4188896377 -> j426226291;
	j426226291 [label="不管他打算如何运用他的新身份，我担心他有意将我们卷入其中。我只希望我们不要被他某种程度上的仁慈所蒙蔽而参与进去。",shape=box,color=blue];
		j426226291 -> j1426051374;
		j426226291 -> j4278380209;
		j426226291 -> j3199792150;
	j1426051374 [label="我同意你的看法。我不信任他。",shape=box,color=red];
		j1426051374 -> j863697792;
	j4278380209 [label="他强大又博学。我更希望有他站在我这边。",shape=box,color=red];
		j4278380209 -> j1132415465;
	j3199792150 [label="担心他会不会背叛我们，没有任何好处——他还没这样做。我不会在人们还没犯罪时，就判定他们有罪。",shape=box,color=red];
		j3199792150 -> j994412647;
	j863697792 [label="+20 Chemistry",color=orange];
		j863697792 -> j3293594139;
	j1132415465 [label="Add -1 to Thermostat counter",color=orange];
		j1132415465 -> j151829166;
	j994412647 [label="Add 1 to Thermostat counter",color=orange];
		j994412647 -> j3725859887;
	j3293594139 [label="Bien ！这样我至少能安心了，因为我知道还有另一双眼睛盯着那个恶魔。这也许能有助我的睡眠。Merci。",shape=box,color=blue];
		j3293594139 -> j3984234322;
	j151829166 [label="Oui，但我想知道这种结盟最终的代价到底是什么。你可能不会为所付的代价而高兴。",shape=box,color=blue];
		j151829166 -> j1727882608;
	j3725859887 [label="Oui……我想你是对的。我们不能盲目跟风。我们必须和任何希望看到虚空无情之物被击败的人并肩站在一起。",shape=box,color=blue];
		j3725859887 -> j808986917;
	j3984234322 [label="Boolean MarieRoatheNoTrust is now true.",color=orange];
		j3984234322 -> "Chat ends.";
	j1727882608 [label="我只想劝你小心点……他是个披着绅士外衣的怪物。小心他，s'il te plaît ？",shape=box,color=blue];
		j1727882608 -> j3943094073;
		j1727882608 -> j1569557033;
	j808986917 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j808986917 -> j2692978963 [label=true,color=green];
		j808986917 -> j3187573776 [label=false,color=brown];
	j3943094073 [label="我觉得你对他有点不公平。",shape=box,color=red];
		j3943094073 -> j861322676;
	j1569557033 [label="我会小心的。我保证。",shape=box,color=red];
		j1569557033 -> j3995640108;
	j2692978963 [label="即使你们相信这背后的力量不是来自神，而是来自我们自己的意念，它仍然是一种威胁。",shape=box,color=blue];
		j2692978963 -> j1727882608;
	j3187573776 [label="即使他相信这背后的力量不是来自神，而是来自我们自己的意念，它仍然是一种威胁。",shape=box,color=blue];
		j3187573776 -> j1727882608;
	j861322676 [label="Add -1 to Thermostat counter",color=orange];
		j861322676 -> j2923592210;
	j3995640108 [label="+20 Chemistry",color=orange];
		j3995640108 -> j615867328;
	j2923592210 [label="Oui ？你怎么会这么觉得 ？我不是故意那么残忍的，我只是真的很好奇。",shape=box,color=blue];
		j2923592210 -> j2660710171;
		j2923592210 -> j3255467542;
		j2923592210 -> j4021350990;
		j2923592210 -> j965610206;
	j615867328 [label="Merci。这就是我唯一的请求。",shape=box,color=blue];
		j615867328 -> "Chat ends.";
	j2660710171 [label="他在一个不同的社会、不同的时代长大——背负着不同的期望。我们或许不喜欢，但他就是他。",shape=box,color=red];
		j2660710171 -> j2669775189;
	j3255467542 [label="你和里昂接受了英择谛的原型战甲血清。你们心甘情愿。他却没有。你能想象那是什么感觉吗？",shape=box,color=red];
		j3255467542 -> j899205682;
		j3255467542 -> j2292418484;
		j3255467542 -> j2669775189;
	j4021350990 [label="他在几个世纪的时间里，做着他认为必要的事情。我们只是对什么是必要的有不认同的看法。",shape=box,color=red];
		j4021350990 -> j899205682;
		j4021350990 -> j1859605253;
	j965610206 [label="我觉得他的很多……举止可能会激怒你，而不是他的行为。",shape=box,color=red];
		j965610206 -> j1859605253;
		j965610206 -> j899205682;
	j2669775189 [label="他是一位高级军官，社交名流。而这两个身份有时候需要他做出一些阴暗的决定。",shape=box,color=red];
		j2669775189 -> j681163897;
	j899205682 [label="我觉得一个人可以做我们认为是“错误的事情”，并且怀着好的意图这样做。",shape=box,color=red];
		j899205682 -> j3534211162;
	j2292418484 [label="他所做的一切都是以拯救奥罗金帝国为名义——而他所得到的回报，却是违背他的意愿，被迫陷入这场混乱。",shape=box,color=red];
		j2292418484 -> j681163897;
	j1859605253 [label="我觉得他惹恼你，是因为他为自己所做的事而感到自豪。",shape=box,color=red];
		j1859605253 -> j1705855535;
	j681163897 [label="Check boolean MarieGrineer",color=orange];
		j681163897 -> j1525151150 [label=true,color=green];
		j681163897 -> j1958282427 [label=false,color=brown];
	j3534211162 [label="你可能会觉得他是一个恶魔，但在他看来，这与事实相去甚远。",shape=box,color=red];
		j3534211162 -> j681163897;
	j1705855535 [label="Oui，我不喜欢那些陶醉于死亡的人。而且我发现他对流血的渴望很可怕。而你却没觉得不安，这也同样令人不安。",shape=box,color=blue];
		j1705855535 -> j554669716;
	j1525151150 [label="我想，那些指挥着你们对抗的 “Corpus” 或 “Grineer” 的人也会这么说。他们并不认为自己错了。",shape=box,color=blue];
		j1525151150 -> j1527880418;
	j1958282427 [label="我想，那些指挥着你们对抗的 “Corpus” 或 “Grin-ire” 的人也会这么说。他们并不认为自己错了。",shape=box,color=blue];
		j1958282427 -> j1527880418;
	j554669716 [label="人们很容易适应克制暴力之罪的道路，拒绝暴力的恐怖，以“重要”的名义说暴力毫无意义。",shape=box,color=blue];
		j554669716 -> j2721401558;
	j1527880418 [label="他们相信自己的行为是正义的、善良的、必要的。你怎么能宽恕一个恶魔，却不宽恕另一个呢？",shape=box,color=blue];
		j1527880418 -> j3871264540;
		j1527880418 -> j1582402884;
		j1527880418 -> j4031696323;
		j1527880418 -> j2371933832;
	j2721401558 [label="为这种行为本身感到自豪……对我来说太过分了。如果我必须杀死一个生命，我并不高兴，但他却高兴。所以从这个角度来说 ？我们很不一样。",shape=box,color=blue];
		j2721401558 -> j3548957519;
	j3871264540 [label="我会尽力阻止他们，当他们做我不同意的事情时。但是……需要时，我也会与他们并肩作战。",shape=box,color=red];
		j3871264540 -> j583641629;
	j1582402884 [label="我认为这些群体本身并没有“好”或“坏”的定义，只取决于他们选择采取的行动。",shape=box,color=red];
		j1582402884 -> j2998189365;
	j4031696323 [label="我没有资格断言某些行为是“好的”，某些行为是“坏的”。我所做的一切都是为了保护那些需要保护的人。",shape=box,color=red];
		j4031696323 -> j583641629;
	j2371933832 [label="你要我用评判一个人的标准来评判一整个群体的人。",shape=box,color=red];
		j2371933832 -> j2998189365;
	j3548957519 [label="我只能祈祷，如果恶魔决定把刀插进你的肋骨，我还来得及救你。我不希望你临终前想的是“玛丽警告过我的”。",shape=box,color=blue];
		j3548957519 -> j429956564;
		j3548957519 -> j4224596800;
	j583641629 [label="你相信恶魔不是个威胁吗 ？相信他对周围的人不 dangereux 吗 ？他可能会造成很大的伤害。",shape=box,color=blue];
		j583641629 -> j4276597189;
		j583641629 -> j1461940949;
	j2998189365 [label="那他犯下的那些恐怖罪行又如何呢 ？所有的死亡，所有的屠杀 ？在你看来，这些都是正当的行为吗 ？",shape=box,color=blue];
		j2998189365 -> j1461940949;
	j429956564 [label="他不会的。如果他真那样做，我会阻止他的。",shape=box,color=red];
		j429956564 -> j2069740096;
	j4224596800 [label="我保证这不会是我临终前的想法。",shape=box,color=red];
		j4224596800 -> j190392552;
	j4276597189 [label="如果他真的背叛我们，我会采取行动。在那之前，他已经证明自己只不过是个盟友。也许……有点夸张。",shape=box,color=red];
		j4276597189 -> j2132396131;
	j1461940949 [label="我不认为他的危险特质是个问题。他是一件武器。武器可以用来杀人，也可以用来保护人。",shape=box,color=red];
		j1461940949 -> j1137183158;
	j2069740096 [label="我敬佩你对自己的信心，即便我为你对他的信心感到惋惜。所以，反过来，我也会对你有信心，我想。",shape=box,color=blue];
		j2069740096 -> j3438845888;
	j190392552 [label="我相信你这些话的意思并不是我希望的那样，但我不会过多地解读它们。",shape=box,color=blue];
		j190392552 -> j3438845888;
	j2132396131 [label="Add 1 to Thermostat counter",color=orange];
		j2132396131 -> j3548957519;
	j1137183158 [label="Add -1 to Thermostat counter",color=orange];
		j1137183158 -> j3548957519;
	j3438845888 [label="我​得​走​了。​不过，​我​再次​请​求​你​——​小​心点。​就算​不​是​为了​你，​为了​我，​d'accor​d ？​",shape=box,color=blue];
		j3438845888 -> j367054140;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
}