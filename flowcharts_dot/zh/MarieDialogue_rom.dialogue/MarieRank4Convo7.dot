	1847 [label="你觉得他真正要找的是什么 ？",shape=box,color=red];
		1847 -> 1851;
	1848 [label="我知道你们俩关系不好，对此我感到很抱歉。但我又不能把他赶出去。",shape=box,color=red];
		1848 -> 1852;
	1849 [label="罗瑟对奥罗金的遗忘——确切地说——比我们所知道的还要多。我们需要他。",shape=box,color=red];
