	1844 [label="漂泊者，excusez-moi……你真的认为帮助恶魔是明智的吗 ？",shape=box,color=blue];
		1844 -> 1846;
	1845 [label="Chat ends.",color=orange];
	1846 [label="我不想拒绝那些寻求赦免或援助的人，但是……我认为这两者都不是恶魔要找的。",shape=box,color=blue];
		1846 -> 1847;
