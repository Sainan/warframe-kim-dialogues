		1898 -> 1901 [label=false,color=brown];
	1899 [label="你可能会觉得他是一个恶魔，但在他看来，这与事实相去甚远。",shape=box,color=red];
		1899 -> 1898;
	1900 [label="Oui，我不喜欢那些陶醉于死亡的人。而且我发现他对流血的渴望很可怕。而你却没觉得不安，这也同样令人不安。",shape=box,color=blue];
		1900 -> 1903;
	1902 [label="我想，那些指挥着你们对抗的 “Corpus” 或 “Grineer” 的人也会这么说。他们并不认为自己错了。",shape=box,color=blue];
		1902 -> 1904;
	1901 [label="我想，那些指挥着你们对抗的 “Corpus” 或 “Grin-ire” 的人也会这么说。他们并不认为自己错了。",shape=box,color=blue];
		1901 -> 1904;
	1903 [label="人们很容易适应克制暴力之罪的道路，拒绝暴力的恐怖，以“重要”的名义说暴力毫无意义。",shape=box,color=blue];
		1903 -> 1905;
	1904 [label="他们相信自己的行为是正义的、善良的、必要的。你怎么能宽恕一个恶魔，却不宽恕另一个呢？",shape=box,color=blue];
		1904 -> 1906;
		1904 -> 1907;
		1904 -> 1908;
		1904 -> 1909;
	1905 [label="为这种行为本身感到自豪……对我来说太过分了。如果我必须杀死一个生命，我并不高兴，但他却高兴。所以从这个角度来说 ？我们很不一样。",shape=box,color=blue];
		1905 -> 1910;
	1906 [label="我会尽力阻止他们，当他们做我不同意的事情时。但是……需要时，我也会与他们并肩作战。",shape=box,color=red];
		1906 -> 1911;
	1907 [label="我认为这些群体本身并没有“好”或“坏”的定义，只取决于他们选择采取的行动。",shape=box,color=red];
		1907 -> 1912;
	1908 [label="我没有资格断言某些行为是“好的”，某些行为是“坏的”。我所做的一切都是为了保护那些需要保护的人。",shape=box,color=red];
		1908 -> 1911;
	1909 [label="你要我用评判一个人的标准来评判一整个群体的人。",shape=box,color=red];
		1909 -> 1912;
	1910 [label="我只能祈祷，如果恶魔决定把刀插进你的肋骨，我还来得及救你。我不希望你临终前想的是“玛丽警告过我的”。",shape=box,color=blue];
		1910 -> 1913;
		1910 -> 1914;
	1911 [label="你相信恶魔不是个威胁吗 ？相信他对周围的人不 dangereux 吗 ？他可能会造成很大的伤害。",shape=box,color=blue];
		1911 -> 1915;
		1911 -> 1916;
	1912 [label="那他犯下的那些恐怖罪行又如何呢 ？所有的死亡，所有的屠杀 ？在你看来，这些都是正当的行为吗 ？",shape=box,color=blue];
		1912 -> 1916;
	1913 [label="他不会的。如果他真那样做，我会阻止他的。",shape=box,color=red];
		1913 -> 1917;
	1914 [label="我保证这不会是我临终前的想法。",shape=box,color=red];
		1914 -> 1918;
	1915 [label="如果他真的背叛我们，我会采取行动。在那之前，他已经证明自己只不过是个盟友。也许……有点夸张。",shape=box,color=red];
		1915 -> 1919;
	1916 [label="我不认为他的危险特质是个问题。他是一件武器。武器可以用来杀人，也可以用来保护人。",shape=box,color=red];
		1916 -> 1920;
	1917 [label="我敬佩你对自己的信心，即便我为你对他的信心感到惋惜。所以，反过来，我也会对你有信心，我想。",shape=box,color=blue];
		1917 -> 1921;
	1918 [label="我相信你这些话的意思并不是我希望的那样，但我不会过多地解读它们。",shape=box,color=blue];
		1918 -> 1921;
