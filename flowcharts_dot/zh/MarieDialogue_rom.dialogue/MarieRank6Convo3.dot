	3680 [label="+10 Chemistry",color=orange];
		3680 -> 3687;
	3679 [label="+10 Chemistry",color=orange];
		3679 -> 3686;
	3684 [label="+5 Chemistry",color=orange];
		3684 -> 3697;
	3685 [label="我完全不明白你的意思 ！我并没有暗示什么。我只是一个单纯无辜的 Sœur de Sol。",shape=box,color=blue];
		3685 -> 3698;
	3683 [label="Evaluate expressions",color=orange];
		3683 -> 3692 [label="RoatheVillain",color=purple];
