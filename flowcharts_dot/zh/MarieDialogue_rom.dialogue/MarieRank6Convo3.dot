		3652 -> 3661 [label=false,color=brown];
	3647 [label="那么我也会支持你的选择。",shape=box,color=blue];
		3647 -> 3653;
	3657 [label="同时我也会跟里昂沟通，但我并不抱太大希望。",shape=box,color=blue];
		3657 -> 3666;
	3656 [label="+20 Chemistry",color=orange];
		3656 -> 3665;
	3654 [label="至少他会帮忙。而且我会确保他不会真的把威胁变成现实。",shape=box,color=red];
		3654 -> 3663;
	3655 [label="我觉得这只是他掩盖真相的借口。",shape=box,color=red];
		3655 -> 3664;
	3659 [label="Oui，我知道。我觉得你一定有一套能说服他的特别方法，因为其他人都失败了，non ？",shape=box,color=blue];
		3659 -> 3669;
		3659 -> 3670;
	3658 [label="Oui，我太知道了。那家伙一向固执得要命。有时候，我觉得他就是喜欢唱反调 ！",shape=box,color=blue];
		3658 -> 3667;
		3658 -> 3668;
	3660 [label="我觉得你一定有一套能说服他的特别方法，因为其他人都失败了，non ？",shape=box,color=blue];
		3660 -> 3669;
		3660 -> 3670;
	3661 [label="祝你好运。那家伙一向固执得要命。有时候，我觉得他就是喜欢唱反调 ！",shape=box,color=blue];
		3661 -> 3667;
		3661 -> 3668;
	3653 [label="Update boolean MarieFamilyFail",color=orange];
		3653 -> 3662;
	3666 [label="+20 Chemistry",color=orange];
		3666 -> 3674;
	3665 [label="我严重看错了我们这个恶魔……",shape=box,color=blue];
		3665 -> 3673;
	3663 [label="Oui。至少有你在，我们至少还能不让他顺着那些……原始本能乱来。",shape=box,color=blue];
		3663 -> 3672;
	3664 [label="Oui，我希望你是对的。",shape=box,color=blue];
		3664 -> 3672;
	3669 [label="我不想利用我和他的关系作为谈判筹码。",shape=box,color=red];
		3669 -> 3677;
	3670 [label="玛丽，​你​这​是​在​暗示​什么​？​",shape=box,color=red];
		3670 -> 3678;
	3667 [label="虽然听起来很奇怪，但我其实还挺享受的。我们相处得很好。",shape=box,color=red];
		3667 -> 3675;
	3668 [label="他或许可以，但我认为很多时候只是为了装装样子。",shape=box,color=red];
		3668 -> 3676;
	3662 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3662 -> 3671;
	3674 [label="恶魔善变 ！正如人们所说的，C'est la vie ！",shape=box,color=blue];
		3674 -> 3682;
	3673 [label="我也不是傻子，当然看得出你为了促成这一切所付出的努力 ！",shape=box,color=blue];
		3673 -> 3681;
	3672 [label="Check boolean MarieDating",color=orange];
		3672 -> 3680 [label=true,color=green];
		3672 -> 3679 [label=false,color=brown];
	3677 [label="哦 ！我不是那个意思，pardonne-moi ！我只是说他似乎更偏爱你，所以虽然他不理其他人，但他可能肯和你说话。",shape=box,color=blue];
		3677 -> 3684;
	3678 [label="+5 Chemistry",color=orange];
		3678 -> 3685;
	3675 [label="是的，他似乎真的更喜欢你。也许是因为你们身处同一时空，而我们不在同一个时空？不然他为什么会这样呢？",shape=box,color=blue];
		3675 -> 3683;
	3676 [label="Oui ？这是什么意思 ？",shape=box,color=blue];
		3676 -> 3683;
	3671 [label="Chat ends.",color=orange];
