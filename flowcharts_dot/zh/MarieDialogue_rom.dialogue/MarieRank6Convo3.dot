	3607 [label="Chat ends.",color=orange];
	3609 [label="我一直在想怎样才能说服洛德走上楼梯，去和家族的人谈谈，而且……我有个主意，但我认为你不会喜欢。",shape=box,color=red];
		3609 -> 3614;
	3610 [label="你有没有想过如何说服洛德去和楼上的英择谛家族谈谈？",shape=box,color=red];
		3610 -> 3615;
	3611 [label="关于让洛德和英择谛家族对话这件事，我……想知道你有没有重新考虑过让罗瑟参与？",shape=box,color=red];
		3611 -> 3616;
	3612 [label="玛丽，你还在想……试着说服洛德去跟“楼上的邻居”谈谈吗？我知道我们上次说到这儿的时候气氛有点尴尬。",shape=box,color=red];
		3612 -> 3616;
	3608 [label="我一直在想，洛德先生为什么那么害怕与主教的家人交谈。",shape=box,color=blue];
		3608 -> 3613;
	3614 [label="Check boolean MarieDating",color=orange];
		3614 -> 3619 [label=true,color=green];
		3614 -> 3618 [label=false,color=brown];
	3615 [label="Check boolean MarieDating",color=orange];
		3615 -> 3621 [label=true,color=green];
		3615 -> 3620 [label=false,color=brown];
	3616 [label="Check boolean MarieDating",color=orange];
		3616 -> 3623 [label=true,color=green];
		3616 -> 3622 [label=false,color=brown];
	3613 [label="我们必须打破这种僵局。我们现在陷入的这种炼狱不应该继续下去。这种痛苦似乎完全没有必要。",shape=box,color=blue];
		3613 -> 3617;
	3619 [label="Bonjour，mon cœur ！你怕我不喜欢什么呢 ？",shape=box,color=blue];
		3619 -> 3625;
	3618 [label="Bonjour ！哦 ？你怕我不喜欢什么呢 ？",shape=box,color=blue];
		3618 -> 3625;
	3621 [label="Bonjour mon cœur ！我仔细想过了，oui……但我真的不愿意承认。说出这些话让我一点也不开心。",shape=box,color=blue];
		3621 -> 3626;
	3620 [label="Bonjour mon cœur ！我仔细想过了，oui……但我真的不愿意承认。说出这些话让我一点也不开心。",shape=box,color=blue];
		3620 -> 3626;
	3623 [label="Bonjour，bonjour，mon cœur ！我仔细想过了，oui……但我真的不愿意承认。说出这些话让我一点也不开心。",shape=box,color=blue];
		3623 -> 3627;
	3622 [label="Bonjour——我仔细想过了，oui……但我真的不愿意承认。说出这些话让我一点也不开心。",shape=box,color=blue];
		3622 -> 3627;
	3617 [label="但我感觉我们需要……某种意义上的堡垒，non ？你有什么想法吗 ？",shape=box,color=blue];
		3617 -> 3624;
		3617 -> 3625;
	3625 [label="我认为我们需要罗瑟的帮助才能说服洛德与英择谛家族交谈。除非能保证英择谛家族和他本人的安全，否则，我认为他是不会答应的。",shape=box,color=red];
		3625 -> 3629;
	3626 [label="但我想……我只是想想——啊，太阳神，请原谅我——我们或许需要恶魔的帮助。否则，我想洛德先生是不会听我们的。",shape=box,color=blue];
		3626 -> 3630;
	3627 [label="我相信你说的或许是对的。恶魔或许正是我们需要的那块拼图。啊，光是打出这些字都让我感到痛苦 ！ ",shape=box,color=blue];
		3627 -> 3631;
	3624 [label="我实在想不出什么好主意，除了能想到一些不靠谱的办法。这些办法很可能会在以后给我们带来大麻烦。比如，罗瑟。",shape=box,color=red];
		3624 -> 3628;
	3629 [label="我……很不愿意承认，但我认为你可能是对的……太阳神，请原谅我。",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="恶魔很有能力，而且在事情出错时总会用力量来引诱人，non ？",shape=box,color=blue];
		3630 -> 3634;
		3630 -> 3635;
	3631 [label="Evaluate expressions",color=orange];
		3631 -> 3638 [label="RoatheFamilyFail",color=purple];
		3631 -> 3637 [label="RoatheRedeemed, RoatheFamilyDelay
",color=purple];
