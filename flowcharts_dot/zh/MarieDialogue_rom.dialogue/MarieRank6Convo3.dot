		3683 -> 3691 [label="false",color=purple];
	3690 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3690 -> 3701;
	3689 [label="Merci，merci，merci，mon cœur ！",shape=box,color=blue];
		3689 -> 3700;
	3688 [label="Merci，merci，merci ！",shape=box,color=blue];
		3688 -> 3700;
	3687 [label="那么 ！到时候我会做好准备，静候佳音 ！在此之前，merci，mon cœur。",shape=box,color=blue];
		3687 -> 3699;
	3686 [label="那么 ！到时候我会做好准备，静候佳音 ！在此之前，merci。",shape=box,color=blue];
		3686 -> 3699;
	3697 [label="你开心我很高兴。而且如果恶魔也有地方可以消耗他的……精力……那就更好了，non ？",shape=box,color=blue];
		3697 -> 3708;
	3698 [label="我​绝不​会​暗示，​既然​恶魔​似乎​偏袒​你，​那么​他​或许​就​会​听​你​的话，​因为​他​根本​不​会​听​其他​人​的话。​",shape=box,color=blue];
		3698 -> 3709;
	3692 [label="他生命中的每个人都试图把他当成某种怪物。我想我是第一个没有这么做的人。",shape=box,color=red];
		3692 -> 3703;
	3693 [label="他有很多事情不知道该如何表达。也不是说他在伪装——而是他不信任别人，害怕别人会伤害他。",shape=box,color=red];
		3693 -> 3704;
	3695 [label="他这些年来……经历过不少伤心事。伤口都结痂长满了刺，仅此而已。",shape=box,color=red];
		3695 -> 3706;
	3696 [label="我大概能理解他那些年是怎么过来的。我见过的死亡和他一样多。",shape=box,color=red];
		3696 -> 3707;
	3694 [label="他一直以来都只是想做正确的事。确实，或许他的方式不对——但他是为了拯救始源星系免遭奥罗金人的蹂躏。",shape=box,color=red];
		3694 -> 3705;
	3691 [label="我喜欢他那种略带讽刺的幽默感。抛开他的自负，他其实很聪明。",shape=box,color=red];
		3691 -> 3702;
	3701 [label="Chat ends.",color=orange];
	3700 [label="那么 ！到时候我会做好准备，静候佳音 ！直到那一天 ！",shape=box,color=blue];
		3700 -> 3711;
	3699 [label="Update boolean MarieFamilySuccess",color=orange];
		3699 -> 3710;
	3708 [label="如果你能在他身边当个 un ange 让他冷静下来，这对我们所有人都是好事。",shape=box,color=blue];
		3708 -> 3716;
		3708 -> 3717;
	3709 [label="而且在私下的时候绝对不会。Non。Jamais。",shape=box,color=blue];
		3709 -> 3718;
		3709 -> 3719;
	3703 [label="想必​我​算​是​这些​人​中​带头​指责​的​人​了​吧？​我​想​我​应该​……​想​想​他​变成​现在​这样​的​原因。​定罪​救​不​了​任何​人。​",shape=box,color=blue];
		3703 -> 3713;
	3704 [label="每个人都有一些不愿示人的痛苦吧。我们会小心将它保护起来，唯恐别人会利用它。如果你说的是真的，我想我应该对他好一点。",shape=box,color=blue];
		3704 -> 3713;
	3706 [label="我无法想象一个人在那些年里要承受多少爱与失去。即便我亲眼所见，这一切仍然让我觉得难以置信。",shape=box,color=blue];
		3706 -> 3714;
	3707 [label="有时和他交谈时，我会忘记他已经活了很多个世纪了。即便我亲眼目睹了这一切，也仍然觉得难以置信。",shape=box,color=blue];
		3707 -> 3715;
	3705 [label="事情总会有……细微差别，oui ？每一种行为的背后都有其缘由。如果你说的是真的，我想我应该试着对他更友善一些。",shape=box,color=blue];
		3705 -> 3713;
	3702 [label="从来没有人否认过恶魔的聪明。",shape=box,color=blue];
		3702 -> 3712;
	3711 [label="Update boolean MarieFamilySuccess",color=orange];
		3711 -> 3721;
	3710 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3710 -> 3720;
	3716 [label="谁说我是在试图让他冷静下来？",shape=box,color=red];
		3716 -> 3723;
	3717 [label="我没法保证什么。",shape=box,color=red];
		3717 -> 3724;
	3718 [label="我从未发现你还有这一面。",shape=box,color=red];
		3718 -> 3684;
	3719 [label="你倒是让我意外了。不错。 ",shape=box,color=red];
		3719 -> 3684;
	3713 [label="+10 Chemistry",color=orange];
		3713 -> 3722;
	3714 [label="Oui，那会对灵魂造成什么伤害呢？我明白你为什么会想找一个能理解你的人。而他，也找到了你。",shape=box,color=blue];
		3714 -> 3713;
	3715 [label="活了这么久，目睹了这么多死亡——其中不少还是自己亲手造成的 ？",shape=box,color=blue];
		3715 -> 3714;
	3712 [label="+5 Chemistry",color=orange];
		3712 -> 3722;
	3721 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3721 -> 3725;
	3720 [label="Chat ends.",color=orange];
	3723 [label="Add -1 to Thermostat",color=orange];
		3723 -> 3726;
	3724 [label="Add 1 to Thermostat",color=orange];
		3724 -> 3727;
	3722 [label="我很高兴终于有人肯和恶魔交谈，或许还能让他有所收敛。你就像他肩上的 Un ange。",shape=box,color=blue];
		3722 -> 3716;
		3722 -> 3717;
	3725 [label="Chat ends.",color=orange];
	3726 [label="+10 Chemistry",color=orange];
		3726 -> 3728;
	3727 [label="+10 Chemistry",color=orange];
		3727 -> 3729;
	3728 [label="或许你是对的……没有 son diable，un ange 又算什么呢？是他提醒了我们所有人，我们应该努力去避免的事。",shape=box,color=blue];
		3728 -> 3730;
	3729 [label="Oui，我担心他身上有一种无法真正治愈的邪恶。他太享受这种邪恶了。",shape=box,color=blue];
		3729 -> 3730;
	3730 [label="那么 ！如果哪天你成功说服恶魔帮助我们完成任务，我随时待命！直到那一天！",shape=box,color=blue];
		3730 -> 3731;
	3731 [label="Update boolean MarieFamilySuccess",color=orange];
