		j148501058 -> j3591454211 [label="MarieFamilyOther",color=purple];
		j148501058 -> j2820191996 [label="false",color=purple];
	j2289505064 [label="我一直在想怎样才能说服洛德走上楼梯，去和家族的人谈谈，而且……我有个主意，但我认为你不会喜欢。",shape=box,color=red];
		j2289505064 -> j3431982611;
	j3591454211 [label="你有没有想过如何说服洛德去和楼上的英择谛家族谈谈？",shape=box,color=red];
		j3591454211 -> j2607534784;
	j1130193759 [label="关于让洛德和英择谛家族对话这件事，我……想知道你有没有重新考虑过让罗瑟参与？",shape=box,color=red];
		j1130193759 -> j1903226774;
	j3009084873 [label="玛丽，你还在想……试着说服洛德去跟“楼上的邻居”谈谈吗？我知道我们上次说到这儿的时候气氛有点尴尬。",shape=box,color=red];
		j3009084873 -> j1903226774;
	j2820191996 [label="我一直在想，洛德先生为什么那么害怕与主教的家人交谈。",shape=box,color=blue];
		j2820191996 -> j110493347;
	j3431982611 [label="Check boolean MarieDating",color=orange];
		j3431982611 -> j2714551884 [label=true,color=green];
		j3431982611 -> j1825597366 [label=false,color=brown];
	j2607534784 [label="Check boolean MarieDating",color=orange];
		j2607534784 -> j2535128466 [label=true,color=green];
		j2607534784 -> j2535128466 [label=false,color=brown];
	j1903226774 [label="Check boolean MarieDating",color=orange];
		j1903226774 -> j3138883344 [label=true,color=green];
		j1903226774 -> j669950647 [label=false,color=brown];
	j110493347 [label="我们必须打破这种僵局。我们现在陷入的这种炼狱不应该继续下去。这种痛苦似乎完全没有必要。",shape=box,color=blue];
		j110493347 -> j2942828732;
	j2714551884 [label="Bonjour，mon cœur ！你怕我不喜欢什么呢 ？",shape=box,color=blue];
		j2714551884 -> j1532254579;
	j1825597366 [label="Bonjour ！哦 ？你怕我不喜欢什么呢 ？",shape=box,color=blue];
		j1825597366 -> j1532254579;
	j2535128466 [label="Bonjour mon cœur ！我仔细想过了，oui……但我真的不愿意承认。说出这些话让我一点也不开心。",shape=box,color=blue];
		j2535128466 -> j621263970;
	j3138883344 [label="Bonjour，bonjour，mon cœur ！我仔细想过了，oui……但我真的不愿意承认。说出这些话让我一点也不开心。",shape=box,color=blue];
		j3138883344 -> j4226961018;
	j669950647 [label="Bonjour——我仔细想过了，oui……但我真的不愿意承认。说出这些话让我一点也不开心。",shape=box,color=blue];
		j669950647 -> j4226961018;
	j2942828732 [label="但我感觉我们需要……某种意义上的堡垒，non ？你有什么想法吗 ？",shape=box,color=blue];
		j2942828732 -> j2662339493;
		j2942828732 -> j1532254579;
	j1532254579 [label="我认为我们需要罗瑟的帮助才能说服洛德与英择谛家族交谈。除非能保证英择谛家族和他本人的安全，否则，我认为他是不会答应的。",shape=box,color=red];
		j1532254579 -> j2335169452;
	j621263970 [label="但我想……我只是想想——啊，太阳神，请原谅我——我们或许需要恶魔的帮助。否则，我想洛德先生是不会听我们的。",shape=box,color=blue];
		j621263970 -> j2208838733;
	j4226961018 [label="我相信你说的或许是对的。恶魔或许正是我们需要的那块拼图。啊，光是打出这些字都让我感到痛苦 ！ ",shape=box,color=blue];
		j4226961018 -> j636489540;
	j2662339493 [label="我实在想不出什么好主意，除了能想到一些不靠谱的办法。这些办法很可能会在以后给我们带来大麻烦。比如，罗瑟。",shape=box,color=red];
		j2662339493 -> j1388407095;
	j2335169452 [label="我……很不愿意承认，但我认为你可能是对的……太阳神，请原谅我。",shape=box,color=blue];
		j2335169452 -> j636489540;
	j2208838733 [label="恶魔很有能力，而且在事情出错时总会用力量来引诱人，non ？",shape=box,color=blue];
		j2208838733 -> j1897891311;
		j2208838733 -> j3209863324;
	j636489540 [label="Evaluate expressions",color=orange];
		j636489540 -> j3982034879 [label="RoatheFamilyFail",color=purple];
		j636489540 -> j3638458276 [label="RoatheRedeemed, RoatheFamilyDelay
",color=purple];
		j636489540 -> j3638458276 [label="RoatheRedeemed, RoatheFamilySuccess
",color=purple];
		j636489540 -> j26564505 [label="RoatheVillain, RoatheFamilyDelay
",color=purple];
		j636489540 -> j26564505 [label="RoatheVillain, RoatheFamilySuccess",color=purple];
		j636489540 -> j1362041673 [label="false",color=purple];
	j1388407095 [label="你这么确定吗？如果连我都能放下与恶魔的 différences，你当然也能，non ？",shape=box,color=blue];
		j1388407095 -> j2670954198;
		j1388407095 -> j2895070192;
	j1897891311 [label="不，肯定还有别的办法。我拒绝在这件事上寻求他的帮助。",shape=box,color=red];
		j1897891311 -> j1388407095;
	j3209863324 [label="你说得对。我没想到你会同意。我不敢问。",shape=box,color=red];
		j3209863324 -> j636489540;
	j3982034879 [label="他会在这件事上帮助我们吗 ？",shape=box,color=blue];
		j3982034879 -> j1971281437;
	j3638458276 [label="他会在这件事上帮助我们吗 ？",shape=box,color=blue];
		j3638458276 -> j3343221917;
	j26564505 [label="他会在这件事上帮助我们吗 ？",shape=box,color=blue];
		j26564505 -> j2866408419;
	j1362041673 [label="你觉得你能说服他帮助我们吗 ？",shape=box,color=blue];
		j1362041673 -> j437269689;
		j1362041673 -> j636098072;
	j2670954198 [label="不行，对不起。 ",shape=box,color=red];
		j2670954198 -> j3678443680;
	j2895070192 [label="好的。如果你觉得没问题，我也没问题。",shape=box,color=red];
		j2895070192 -> j633858764;
	j1971281437 [label="不，很可惜……我想这条路在他那是行不通了。你觉得还有别的办法吗？",shape=box,color=red];
		j1971281437 -> j3360549135;
	j3343221917 [label="他会的。我已经说服他去帮忙让他们团聚——你铁定想不到——我猜这样他就能保护英择谛的家人。毕竟，他们是仅存的奥罗金人了。",shape=box,color=red];
		j3343221917 -> j4254028491;
	j2866408419 [label="他会的。我已经说服他去帮忙让他们团聚——你一定不会惊讶——我猜主要是为了在阿尔布雷希特不在的时候恶心恶心他。",shape=box,color=red];
		j2866408419 -> j2709361244;
	j437269689 [label="一切都还没定下来。他……嗯，你知道他是什么样的人。",shape=box,color=red];
		j437269689 -> j2913252443;
	j636098072 [label="我还在尝试，但我想我能说服他。",shape=box,color=red];
		j636098072 -> j1104176810;
	j3678443680 [label="+20 Chemistry",color=orange];
		j3678443680 -> j2152454172;
	j633858764 [label="Oui，我也不喜欢这样，但我想，这是我们不得不吞下的 un médicament。",shape=box,color=blue];
		j633858764 -> j636489540;
	j3360549135 [label="哦 ！那真是……太可惜了。我不知道 ？我想不到……你能想到其他办法说服恶魔吗 ？或者再试一次 ？",shape=box,color=blue];
		j3360549135 -> j1309901026;
	j4254028491 [label="他​居然​在帮忙保护那个男人的家人，尽管那个男人违背了他的意愿将他改造成原型战甲、剥夺了他记忆并将他放逐到过去……",shape=box,color=blue];
		j4254028491 -> j2423065021;
	j2709361244 [label="你说得对，我……确实不惊讶。",shape=box,color=blue];
		j2709361244 -> j997754823;
		j2709361244 -> j2950770870;
	j2913252443 [label="Check boolean RoatheDating",color=orange];
		j2913252443 -> j2843794308 [label=true,color=green];
		j2913252443 -> j4136202506 [label=false,color=brown];
	j1104176810 [label="Check boolean RoatheDating",color=orange];
		j1104176810 -> j2577332022 [label=true,color=green];
		j1104176810 -> j3008218210 [label=false,color=brown];
	j2152454172 [label="那么我也会支持你的选择。",shape=box,color=blue];
		j2152454172 -> j1179567760;
	j1309901026 [label="同时我也会跟里昂沟通，但我并不抱太大希望。",shape=box,color=blue];
		j1309901026 -> j3304857646;
	j2423065021 [label="+20 Chemistry",color=orange];
		j2423065021 -> j1269853294;
	j997754823 [label="至少他会帮忙。而且我会确保他不会真的把威胁变成现实。",shape=box,color=red];
		j997754823 -> j30945805;
	j2950770870 [label="我觉得这只是他掩盖真相的借口。",shape=box,color=red];
		j2950770870 -> j2960948445;
	j2843794308 [label="Oui，我知道。我觉得你一定有一套能说服他的特别方法，因为其他人都失败了，non ？",shape=box,color=blue];
		j2843794308 -> j3191506564;
		j2843794308 -> j1931863854;
	j4136202506 [label="Oui，我太知道了。那家伙一向固执得要命。有时候，我觉得他就是喜欢唱反调 ！",shape=box,color=blue];
		j4136202506 -> j3293711071;
		j4136202506 -> j3248431516;
	j2577332022 [label="我觉得你一定有一套能说服他的特别方法，因为其他人都失败了，non ？",shape=box,color=blue];
		j2577332022 -> j3191506564;
		j2577332022 -> j1931863854;
	j3008218210 [label="祝你好运。那家伙一向固执得要命。有时候，我觉得他就是喜欢唱反调 ！",shape=box,color=blue];
		j3008218210 -> j3293711071;
		j3008218210 -> j3248431516;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j3304857646 [label="+20 Chemistry",color=orange];
		j3304857646 -> j964676720;
	j1269853294 [label="我严重看错了我们这个恶魔……",shape=box,color=blue];
		j1269853294 -> j1646784887;
	j30945805 [label="Oui。至少有你在，我们至少还能不让他顺着那些……原始本能乱来。",shape=box,color=blue];
		j30945805 -> j2198758823;
	j2960948445 [label="Oui，我希望你是对的。",shape=box,color=blue];
		j2960948445 -> j2198758823;
	j3191506564 [label="我不想利用我和他的关系作为谈判筹码。",shape=box,color=red];
		j3191506564 -> j1409011486;
	j1931863854 [label="玛丽，​你​这​是​在​暗示​什么​？​",shape=box,color=red];
		j1931863854 -> j1799982239;
	j3293711071 [label="虽然听起来很奇怪，但我其实还挺享受的。我们相处得很好。",shape=box,color=red];
		j3293711071 -> j2173172861;
	j3248431516 [label="他或许可以，但我认为很多时候只是为了装装样子。",shape=box,color=red];
		j3248431516 -> j3062226377;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j964676720 [label="恶魔善变 ！正如人们所说的，C'est la vie ！",shape=box,color=blue];
		j964676720 -> j3569999725;
	j1646784887 [label="我也不是傻子，当然看得出你为了促成这一切所付出的努力 ！",shape=box,color=blue];
		j1646784887 -> j3242583483;
	j2198758823 [label="Check boolean MarieDating",color=orange];
		j2198758823 -> j664285814 [label=true,color=green];
		j2198758823 -> j4134539283 [label=false,color=brown];
	j1409011486 [label="哦 ！我不是那个意思，pardonne-moi ！我只是说他似乎更偏爱你，所以虽然他不理其他人，但他可能肯和你说话。",shape=box,color=blue];
		j1409011486 -> j1419747791;
	j1799982239 [label="+5 Chemistry",color=orange];
		j1799982239 -> j3622862201;
	j2173172861 [label="是的，他似乎真的更喜欢你。也许是因为你们身处同一时空，而我们不在同一个时空？不然他为什么会这样呢？",shape=box,color=blue];
		j2173172861 -> j3822691405;
	j3062226377 [label="Oui ？这是什么意思 ？",shape=box,color=blue];
		j3062226377 -> j3822691405;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j3242583483 [label="Check boolean MarieDating",color=orange];
		j3242583483 -> j2546824479 [label=true,color=green];
		j3242583483 -> j3322862889 [label=false,color=brown];
	j664285814 [label="+10 Chemistry",color=orange];
		j664285814 -> j4076230461;
	j4134539283 [label="+10 Chemistry",color=orange];
		j4134539283 -> j2214641703;
	j1419747791 [label="+5 Chemistry",color=orange];
		j1419747791 -> j1833559102;
	j3622862201 [label="我完全不明白你的意思 ！我并没有暗示什么。我只是一个单纯无辜的 Sœur de Sol。",shape=box,color=blue];
		j3622862201 -> j3259934930;
	j3822691405 [label="Evaluate expressions",color=orange];
		j3822691405 -> j2191450585 [label="RoatheVillain",color=purple];
		j3822691405 -> j4159373886 [label="RoatheRedeemed",color=purple];
		j3822691405 -> j202123543 [label="RoatheUnloved3",color=purple];
		j3822691405 -> j1451156907 [label="RoatheTraitor2",color=purple];
		j3822691405 -> j243251247 [label="RoatheExecutor2",color=purple];
		j3822691405 -> j354256485 [label="false",color=purple];
	j2546824479 [label="Merci，merci，merci，mon cœur ！",shape=box,color=blue];
		j2546824479 -> j2733589392;
	j3322862889 [label="Merci，merci，merci ！",shape=box,color=blue];
		j3322862889 -> j2733589392;
	j4076230461 [label="那么 ！到时候我会做好准备，静候佳音 ！在此之前，merci，mon cœur。",shape=box,color=blue];
		j4076230461 -> j3569999725;
	j2214641703 [label="那么 ！到时候我会做好准备，静候佳音 ！在此之前，merci。",shape=box,color=blue];
		j2214641703 -> j3569999725;
	j1833559102 [label="你开心我很高兴。而且如果恶魔也有地方可以消耗他的……精力……那就更好了，non ？",shape=box,color=blue];
		j1833559102 -> j3468266979;
	j3259934930 [label="我​绝不​会​暗示，​既然​恶魔​似乎​偏袒​你，​那么​他​或许​就​会​听​你​的话，​因为​他​根本​不​会​听​其他​人​的话。​",shape=box,color=blue];
		j3259934930 -> j1731288606;
	j2191450585 [label="他生命中的每个人都试图把他当成某种怪物。我想我是第一个没有这么做的人。",shape=box,color=red];
		j2191450585 -> j1256604785;
	j4159373886 [label="他有很多事情不知道该如何表达。也不是说他在伪装——而是他不信任别人，害怕别人会伤害他。",shape=box,color=red];
		j4159373886 -> j1321246557;
	j202123543 [label="他这些年来……经历过不少伤心事。伤口都结痂长满了刺，仅此而已。",shape=box,color=red];
		j202123543 -> j4091967031;
	j1451156907 [label="我大概能理解他那些年是怎么过来的。我见过的死亡和他一样多。",shape=box,color=red];
		j1451156907 -> j4137944565;
	j243251247 [label="他一直以来都只是想做正确的事。确实，或许他的方式不对——但他是为了拯救始源星系免遭奥罗金人的蹂躏。",shape=box,color=red];
		j243251247 -> j154688830;
	j354256485 [label="我喜欢他那种略带讽刺的幽默感。抛开他的自负，他其实很聪明。",shape=box,color=red];
		j354256485 -> j3833200931;
	j2733589392 [label="那么 ！到时候我会做好准备，静候佳音 ！直到那一天 ！",shape=box,color=blue];
		j2733589392 -> j3569999725;
	j3468266979 [label="如果你能在他身边当个 un ange 让他冷静下来，这对我们所有人都是好事。",shape=box,color=blue];
		j3468266979 -> j1819021561;
		j3468266979 -> j3976602596;
	j1731288606 [label="而且在私下的时候绝对不会。Non。Jamais。",shape=box,color=blue];
		j1731288606 -> j2129205181;
		j1731288606 -> j1965559988;
	j1256604785 [label="想必​我​算​是​这些​人​中​带头​指责​的​人​了​吧？​我​想​我​应该​……​想​想​他​变成​现在​这样​的​原因。​定罪​救​不​了​任何​人。​",shape=box,color=blue];
		j1256604785 -> j1512905296;
	j1321246557 [label="每个人都有一些不愿示人的痛苦吧。我们会小心将它保护起来，唯恐别人会利用它。如果你说的是真的，我想我应该对他好一点。",shape=box,color=blue];
		j1321246557 -> j1512905296;
	j4091967031 [label="我无法想象一个人在那些年里要承受多少爱与失去。即便我亲眼所见，这一切仍然让我觉得难以置信。",shape=box,color=blue];
		j4091967031 -> j3897774875;
	j4137944565 [label="有时和他交谈时，我会忘记他已经活了很多个世纪了。即便我亲眼目睹了这一切，也仍然觉得难以置信。",shape=box,color=blue];
		j4137944565 -> j4045879923;
	j154688830 [label="事情总会有……细微差别，oui ？每一种行为的背后都有其缘由。如果你说的是真的，我想我应该试着对他更友善一些。",shape=box,color=blue];
		j154688830 -> j1512905296;
	j3833200931 [label="从来没有人否认过恶魔的聪明。",shape=box,color=blue];
		j3833200931 -> j2148257020;
	j1819021561 [label="谁说我是在试图让他冷静下来？",shape=box,color=red];
		j1819021561 -> j1938134031;
