		j573739633 -> j123032870;
	j329802783 [label="玛丽，Mon cœur t'appartient également！",shape=box,color=red];
		j329802783 -> j2287938160;
	j3356862470 [label="相爱时彼此带来快乐，仇恨时彼此带来痛苦。这才是人性的馈赠——而虚空无情之物绝非如此。",shape=box,color=blue];
		j3356862470 -> j1542999897;
	j3043702608 [label="不​管虚空​无情​之物​的​起源​是​什么，​它​能​教会​我们​什么​呢​ ？​难道​不​是​要​我们​紧紧​抓住​它​所​抵挡​的​一切、​它​所​摧毁​的​一切​吗 ？​",shape=box,color=blue];
		j3043702608 -> j2148308487;
	j811449374 [label="我常常想起我们在一起度过的时光。在你漫长的人生中，这段时光又是多么短暂。",shape=box,color=blue];
		j811449374 -> j3331741212;
	j978545703 [label="这样的话 ？那么……漂泊者，恐怕你必须先解开自己心中的纠结。我无法替你做到。",shape=box,color=blue];
		j978545703 -> j3699890413;
	j1192361456 [label="也许真是这样。我不是那种会嫉妒的人，但知道有人俘获了你的芳心，而我又不认识那个人，我或许还能接受——",shape=box,color=blue];
		j1192361456 -> j3398750836;
	j2308873614 [label="+10 Chemistry",color=orange];
		j2308873614 -> j3103734964;
	j4107962621 [label="我——哦 ！哦，mon cœur ！",shape=box,color=blue];
		j4107962621 -> j2684936294;
	j3294834306 [label="恐怕……你还是应该选择别人。你对我的喜欢，我无法以同样的方式回应。请原谅我。",shape=box,color=blue];
		j3294834306 -> j269424064;
