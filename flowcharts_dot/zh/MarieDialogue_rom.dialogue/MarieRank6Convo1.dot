	j3877771079 [label="我常常想起我们在一起度过的时光。在你漫长的人生中，这段时光又是多么短暂。",shape=box,color=blue];
		j3877771079 -> j3087112945;
	j1889283027 [label="Non，让我先说，不然我会没勇气的 ！",shape=box,color=blue];
		j1889283027 -> j1471879296;
	j3123983086 [label="我会想这些时光对我有多么重要。它们改变了我，改变了我的人生轨迹，就像一艘航行在大海上的船。",shape=box,color=blue];
