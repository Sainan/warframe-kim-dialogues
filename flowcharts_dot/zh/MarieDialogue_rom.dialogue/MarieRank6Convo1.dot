		j3352154434 -> j2326108942 [label="LyonFaith3Maybe",color=purple];
		j3352154434 -> j2326108942 [label="false",color=purple];
	j3470333215 [label="Evaluate expressions",color=orange];
		j3470333215 -> j1899974685 [label="LoidFamilyComplete",color=purple];
		j3470333215 -> j1378522768 [label="RoatheRedeemed",color=purple];
		j3470333215 -> j1529978723 [label="RoatheVillain",color=purple];
		j3470333215 -> j3177663220 [label="RoatheHellComplete",color=purple];
		j3470333215 -> j103175398 [label="false",color=purple];
	j2798784178 [label="我知道你之前说过喜欢我。可是现在我却看到你和别人在一起。我只是想告诉你，我替你感到高兴 ！",shape=box,color=blue];
		j2798784178 -> j3322854993;
	j13354907 [label="你曾经跟我说过……哦，我甚至不知道该怎么开口。你说过你喜欢我，但我知道还喜欢别人。",shape=box,color=blue];
		j13354907 -> j163147;
		j13354907 -> j2001841011;
	j1357275005 [label="你曾经跟我说过……哦，我甚至不知道该怎么开口。你说过你喜欢我。",shape=box,color=blue];
		j1357275005 -> j1928846357;
	j3087112945 [label="我会想这些时光对我有多么重要。它们改变了我，改变了我的人生轨迹，就像一艘航行在大海上的船。",shape=box,color=blue];
		j3087112945 -> j3331248306;
	j1471879296 [label="Evaluate expressions",color=orange];
		j1471879296 -> j642695568 [label="MarieNoDate",color=purple];
		j1471879296 -> j4165647696 [label="MarieWillDate",color=purple];
		j1471879296 -> j642695568 [label="false",color=purple];
	j1026998488 [label="然后我心想，那种可以影响他人的力量 ？就是虚空无情之物想要摧毁的吗 ？就是虚空无情之物所吞噬的吗 ？",shape=box,color=blue];
		j1026998488 -> j1739807672;
	j1474288015 [label="你给我的灵魂兄弟带来了如此的平安。你让他确信我们有一个真正的敌人需要对抗——并给了他希望。",shape=box,color=blue];
		j1474288015 -> j336023173;
	j2245942539 [label="你给我的灵魂兄弟带来了慰藉和安宁，这是他之前从未感受过的。我想，你的陪伴对他来说意义非凡，远超他所能表达。",shape=box,color=blue];
		j2245942539 -> j336023173;
	j2326108942 [label="我们或许永远无法得知虚空无情之物的真相，但我们知道这并不重要。我们必须正视它所带来的挑战——而这挑战是真实存在的。",shape=box,color=blue];
		j2326108942 -> j336023173;
	j1899974685 [label="我原以为我们这位恶魔不会答应帮助洛德先生和主教一家重归于好。我知道他的理由……或许有些可疑，而且我仍然无法完全信任他。 ",shape=box,color=blue];
		j1899974685 -> j2402780911;
	j1378522768 [label="我原以为我们这位恶魔永远不会醒悟，永远不会对那些被他夺去生命的无辜者感到丝毫悔意。你证明我错了。",shape=box,color=blue];
		j1378522768 -> j2857089831;
	j1529978723 [label="无论你用什么锁链束缚着我们的恶魔，它们都有效地控制住了他。他似乎比以前更……温和了。这一切都要感谢你。",shape=box,color=blue];
		j1529978723 -> j2857089831;
	j3177663220 [label="我们帮助他找回的那些记忆似乎让他变得更加沉稳。或许，回忆起所有逝去亲人的悲痛，让他时刻铭记着未来可能失去的亲人。",shape=box,color=blue];
		j3177663220 -> j2857089831;
	j103175398 [label="或许是他对你的喜爱让他变得温和，我不知道。但不管是什么原因，我知道这都要感谢你。",shape=box,color=blue];
		j103175398 -> j2857089831;
	j3322854993 [label="我对你们没有任何恶意，只有对你们俩的 joie，oui ？",shape=box,color=blue];
		j3322854993 -> j375091286;
		j3322854993 -> j193515805;
	j163147 [label="现在情况变了，而且……我必须对对方忠诚，对不起。",shape=box,color=red];
		j163147 -> j1845575624;
	j2001841011 [label="我知道，这或许难以置信，甚至难以接受。但我……爱你。我也爱他们。你们同等重要。",shape=box,color=red];
		j2001841011 -> j3734127592;
	j1928846357 [label="Evaluate expressions",color=orange];
		j1928846357 -> j467575438 [label="MarieNoDate",color=purple];
		j1928846357 -> j2097921966 [label="MarieWillDate",color=purple];
