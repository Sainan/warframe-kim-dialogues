		j834976628 -> j593413424;
	j3628934934 [label="我只祈祷你不要误导里昂，也不要无谓地伤害他。他外表坚硬如石，内心却很脆弱。",shape=box,color=blue];
		j3628934934 -> j4294399376;
	j2033136050 [label="我并不希望罗瑟受苦，虽然我总是批评他、训斥他。如果可以的话，请不要让他痛苦。",shape=box,color=blue];
		j2033136050 -> j4294399376;
	j2250620131 [label="如果是别人与我共享你，我或许会感到平静，甚至欣喜——但如果是与家人或敌人 ？我觉得这对我来说太难接受了。",shape=box,color=blue];
