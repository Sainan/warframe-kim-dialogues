	3304 [label="然后我心想，那种可以影响他人的力量 ？就是虚空无情之物想要摧毁的吗 ？就是虚空无情之物所吞噬的吗 ？",shape=box,color=blue];
		3304 -> 3321;
	3309 [label="你给我的灵魂兄弟带来了如此的平安。你让他确信我们有一个真正的敌人需要对抗——并给了他希望。",shape=box,color=blue];
		3309 -> 3329;
	3310 [label="你给我的灵魂兄弟带来了慰藉和安宁，这是他之前从未感受过的。我想，你的陪伴对他来说意义非凡，远超他所能表达。",shape=box,color=blue];
		3310 -> 3329;
	3311 [label="我们或许永远无法得知虚空无情之物的真相，但我们知道这并不重要。我们必须正视它所带来的挑战——而这挑战是真实存在的。",shape=box,color=blue];
		3311 -> 3329;
	3312 [label="我原以为我们这位恶魔不会答应帮助洛德先生和主教一家重归于好。我知道他的理由……或许有些可疑，而且我仍然无法完全信任他。 ",shape=box,color=blue];
		3312 -> 3330;
	3313 [label="我原以为我们这位恶魔永远不会醒悟，永远不会对那些被他夺去生命的无辜者感到丝毫悔意。你证明我错了。",shape=box,color=blue];
		3313 -> 3331;
	3314 [label="无论你用什么锁链束缚着我们的恶魔，它们都有效地控制住了他。他似乎比以前更……温和了。这一切都要感谢你。",shape=box,color=blue];
		3314 -> 3331;
	3315 [label="我们帮助他找回的那些记忆似乎让他变得更加沉稳。或许，回忆起所有逝去亲人的悲痛，让他时刻铭记着未来可能失去的亲人。",shape=box,color=blue];
		3315 -> 3331;
	3316 [label="或许是他对你的喜爱让他变得温和，我不知道。但不管是什么原因，我知道这都要感谢你。",shape=box,color=blue];
		3316 -> 3331;
	3308 [label="我对你们没有任何恶意，只有对你们俩的 joie，oui ？",shape=box,color=blue];
		3308 -> 3327;
		3308 -> 3328;
