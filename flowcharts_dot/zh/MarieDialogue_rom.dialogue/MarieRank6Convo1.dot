		j3103734964 -> j1881227487;
	j2684936294 [label="我……不知道该说什么，除了我相信你……而且我……也喜欢你。 Mon cœur t'appartient depuis notre première rencontre。",shape=box,color=blue];
		j2684936294 -> j981362844;
