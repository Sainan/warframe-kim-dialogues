		j269424064 -> "Chat ends.";
	j1674485542 [label="我……不知道该说什么，除了我……我也有同样的感觉。 Mon cœur t'appartient depuis notre première rencontre。",shape=box,color=blue];
		j1674485542 -> j981362844;
	j3675843760 [label="+10 Chemistry",color=orange];
		j3675843760 -> j2378876570;
	j3308856963 [label="人性并不纯净，也不完美，但它像天上的繁星一样美丽。无数细小的光点组成了一片光的海洋。",shape=box,color=blue];
