		j3699890413 -> j3628934934 [label="LyonDating",color=purple];
		j3699890413 -> j2033136050 [label="RoatheDating",color=purple];
	j3398750836 [label="但如果是我的​灵魂​兄弟，或者是我每天都要对付的恶魔时，那我就无法接受了。",shape=box,color=blue];
		j3398750836 -> j2250620131;
