		j1787441187 -> j3675843760;
	j1791563483 [label="相爱时彼此带来快乐，仇恨时彼此带来痛苦。这才是人性的馈赠——而虚空无情之物绝非如此。",shape=box,color=blue];
		j1791563483 -> j3308856963;
	j811392455 [label="我不知道该怎么说才不会显得那么残酷，所以我……就简单地说吧。",shape=box,color=blue];
		j811392455 -> j341058280;
	j123032870 [label="Oui，我知道 ！这就是重点 ！我太害怕说出口……说出口我有多么在乎你。 ",shape=box,color=blue];
		j123032870 -> j1475751432;
	j2287938160 [label="+10 Chemistry",color=orange];
		j2287938160 -> j3980150027;
	j1542999897 [label="人性并不纯净，也不完美，但它像天上的繁星一样美丽。无数细小的光点组成了一片光的海洋。",shape=box,color=blue];
