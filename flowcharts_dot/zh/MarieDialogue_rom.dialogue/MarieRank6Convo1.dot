	j3331248306 [label="然后我心想，那种可以影响他人的力量 ？就是虚空无情之物想要摧毁的吗 ？就是虚空无情之物所吞噬的吗 ？",shape=box,color=blue];
		j3331248306 -> j253768924;
	j642695568 [label="我担心你接下来要说的话。会让我们之间再也回不到从前。",shape=box,color=blue];
		j642695568 -> j3883137633;
	j4165647696 [label="Mon cœur t'appartient depuis notre première rencontre……",shape=box,color=blue];
		j4165647696 -> j573739633;
		j4165647696 -> j329802783;
	j1739807672 [label="彼此逗乐的礼物。彼此哭泣的礼物。彼此说服对方相信真话或谎言的礼物。彼此改变想法的礼物。在彼此痛苦时互相安慰的礼物。在愚蠢中互相伤害的礼物。",shape=box,color=blue];
		j1739807672 -> j3356862470;
	j336023173 [label="这又有什么区别呢 ？当你陪伴里昂度过最黑暗的时刻，在他痛苦难耐的时候给予他支持和鼓励时 ？",shape=box,color=blue];
		j336023173 -> j3043702608;
	j2402780911 [label="毫无疑问，这一切都要感谢你。罗瑟之所以能在这里，保护主教的家人，都是因为你。",shape=box,color=blue];
		j2402780911 -> j2857089831;
	j2857089831 [label="我​知道​我们​的​恶魔​不​是​敌人，​ou​i ？​虚空​无情​之​物​才​是。​而​虚空​无情​之物​又​教会​了​我们​什么​呢​ ？​难道​不​是​让​我们​紧紧​抓住​它​所​抵挡、​所​摧毁​的​一切​吗 ？​",shape=box,color=blue];
		j2857089831 -> j811449374;
	j375091286 [label="但是……如果 ",shape=box,color=red];
		j375091286 -> j978545703;
	j193515805 [label="玛丽，我也喜欢你。",shape=box,color=red];
		j193515805 -> j1192361456;
	j1845575624 [label="Oui，我明白。当然，我明白 ！我怎么能责怪你去追随自己的内心呢 ？",shape=box,color=blue];
		j1845575624 -> j2308873614;
	j3734127592 [label="Evaluate expressions",color=orange];
		j3734127592 -> j467575438 [label="MarieNoDate",color=purple];
		j3734127592 -> j4107962621 [label="MarieWillDate",color=purple];
		j3734127592 -> j467575438 [label="false",color=purple];
	j467575438 [label="我不知道该怎么说才不会显得那么残酷，所以我……就简单地说吧。",shape=box,color=blue];
		j467575438 -> j3294834306;
	j2097921966 [label="我是喜欢你。我……不知道你是否也同样喜欢我？",shape=box,color=red];
		j2097921966 -> j3373142171;
	j3133027859 [label="情况已经变了……我很抱歉。",shape=box,color=red];
		j3133027859 -> j1787441187;
	j253768924 [label="彼此逗乐的礼物。彼此哭泣的礼物。彼此说服对方相信真话或谎言的礼物。彼此改变想法的礼物。在彼此痛苦时互相安慰的礼物。在愚蠢中互相伤害的礼物。",shape=box,color=blue];
		j253768924 -> j1791563483;
	j3883137633 [label="而我要在你说出口之前阻止你，这让我感到很难过，哦，真的无比难过。",shape=box,color=blue];
		j3883137633 -> j811392455;
