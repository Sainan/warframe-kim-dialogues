		3329 -> 3343;
	3330 [label="毫无疑问，这一切都要感谢你。罗瑟之所以能在这里，保护主教的家人，都是因为你。",shape=box,color=blue];
		3330 -> 3331;
	3331 [label="我​知道​我们​的​恶魔​不​是​敌人，​ou​i ？​虚空​无情​之​物​才​是。​而​虚空​无情​之物​又​教会​了​我们​什么​呢​ ？​难道​不​是​让​我们​紧紧​抓住​它​所​抵挡、​所​摧毁​的​一切​吗 ？​",shape=box,color=blue];
