	65 [label="哈 ！他可是我见过学得最快的家伙之一，漂泊者 ！要是换作是我，可不敢跟他赌钱玩任何谜题游戏。",shape=box,color=blue];
		65 -> 67;
	66 [label="Non，他对新事物很在行。我毫不怀疑他早已研究过那些在地下巢穴里来回穿梭的移动机器，不久后定会设计出自己的东西。",shape=box,color=blue];
		66 -> 67;
	67 [label="他只是不认识你罢了。里昂向来……不太善于交际。他绝无意冒犯于你。",shape=box,color=blue];
