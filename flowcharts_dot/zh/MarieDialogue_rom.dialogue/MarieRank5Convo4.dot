		j3827853471 -> j3150944404 [label=true,color=green];
		j3827853471 -> j3244521586 [label=false,color=brown];
	j2152454172 [label="那么我也会支持你的选择。",shape=box,color=blue];
		j2152454172 -> j1179567760;
	j1309901026 [label="同时我也会跟里昂沟通，但我并不抱太大希望。",shape=box,color=blue];
		j1309901026 -> j3304857646;
	j3973854986 [label="+20 Chemistry",color=orange];
		j3973854986 -> j760047159;
	j3308718150 [label="我觉得这只是他掩盖真相的借口。",shape=box,color=red];
		j3308718150 -> j2027235156;
	j455399712 [label="至少他会帮忙。而且我会确保他不会真的把威胁变成现实。",shape=box,color=red];
		j455399712 -> j183451439;
	j2925080570 [label="我觉得你一定有一套能说服他的特别方法，因为其他人都失败了，non ？",shape=box,color=blue];
		j2925080570 -> j3606170425;
		j2925080570 -> j1709865174;
	j496902619 [label="祝你好运。那家伙一向固执得要命。有时候，我觉得他就是喜欢唱反调 ！",shape=box,color=blue];
		j496902619 -> j3637689818;
		j496902619 -> j3031377963;
	j3150944404 [label="Oui，我知道。我觉得你一定有一套能说服他的特别方法，因为其他人都失败了，non ？",shape=box,color=blue];
		j3150944404 -> j3606170425;
		j3150944404 -> j1709865174;
	j3244521586 [label="Oui，我太知道了。那家伙一向固执得要命。有时候，我觉得他就是喜欢唱反调 ！",shape=box,color=blue];
		j3244521586 -> j3637689818;
		j3244521586 -> j3031377963;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j3304857646 [label="+20 Chemistry",color=orange];
		j3304857646 -> j964676720;
	j760047159 [label="我严重看错了我们这个恶魔……",shape=box,color=blue];
		j760047159 -> j1755363659;
	j2027235156 [label="Oui，我希望你是对的。",shape=box,color=blue];
		j2027235156 -> j70687620;
	j183451439 [label="Oui。至少有你在，我们至少还能不让他顺着那些……原始本能乱来。",shape=box,color=blue];
		j183451439 -> j70687620;
	j3606170425 [label="玛丽，​你​这​是​在​暗示​什么​？​",shape=box,color=red];
		j3606170425 -> j3825265719;
	j1709865174 [label="我不想利用我和他的关系作为谈判筹码。",shape=box,color=red];
		j1709865174 -> j323159700;
	j3637689818 [label="他或许可以，但我认为很多时候只是为了装装样子。",shape=box,color=red];
		j3637689818 -> j2642533898;
	j3031377963 [label="虽然听起来很奇怪，但我其实还挺享受的。我们相处得很好。",shape=box,color=red];
		j3031377963 -> j4121238430;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j964676720 [label="恶魔善变 ！正如人们所说的，C'est la vie ！",shape=box,color=blue];
		j964676720 -> j3569999725;
	j1755363659 [label="我也不是傻子，当然看得出你为了促成这一切所付出的努力 ！",shape=box,color=blue];
		j1755363659 -> j1263896752;
	j70687620 [label="Check boolean MarieDating",color=orange];
		j70687620 -> j664285814 [label=true,color=green];
		j70687620 -> j4134539283 [label=false,color=brown];
	j3825265719 [label="+5 Chemistry",color=orange];
		j3825265719 -> j2756289175;
	j323159700 [label="哦 ！我不是那个意思，pardonne-moi ！我只是说他似乎更偏爱你，所以虽然他不理其他人，但他可能肯和你说话。",shape=box,color=blue];
		j323159700 -> j4023489044;
	j2642533898 [label="Oui ？这是什么意思 ？",shape=box,color=blue];
		j2642533898 -> j1155893159;
	j4121238430 [label="是的，他似乎真的更喜欢你。也许是因为你们身处同一时空，而我们不在同一个时空？不然他为什么会这样呢？",shape=box,color=blue];
		j4121238430 -> j1155893159;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j1263896752 [label="Check boolean MarieDating",color=orange];
		j1263896752 -> j2546824479 [label=true,color=green];
		j1263896752 -> j3322862889 [label=false,color=brown];
	j664285814 [label="+10 Chemistry",color=orange];
		j664285814 -> j4076230461;
	j4134539283 [label="+10 Chemistry",color=orange];
		j4134539283 -> j2214641703;
	j2756289175 [label="我完全不明白你的意思 ！我并没有暗示什么。我只是一个单纯无辜的 Sœur de Sol。",shape=box,color=blue];
		j2756289175 -> j1699929363;
	j4023489044 [label="+5 Chemistry",color=orange];
		j4023489044 -> j56242066;
	j1155893159 [label="Evaluate expressions",color=orange];
		j1155893159 -> j2496959965 [label="RoatheVillain",color=purple];
		j1155893159 -> j1856589500 [label="RoatheRedeemed",color=purple];
		j1155893159 -> j4045007779 [label="RoatheUnloved3",color=purple];
		j1155893159 -> j4037374738 [label="RoatheTraitor2",color=purple];
		j1155893159 -> j4135282209 [label="RoatheExecutor2",color=purple];
		j1155893159 -> j515383368 [label="false",color=purple];
	j2546824479 [label="Merci，merci，merci，mon cœur ！",shape=box,color=blue];
		j2546824479 -> j2733589392;
	j3322862889 [label="Merci，merci，merci ！",shape=box,color=blue];
		j3322862889 -> j2733589392;
	j4076230461 [label="那么 ！到时候我会做好准备，静候佳音 ！在此之前，merci，mon cœur。",shape=box,color=blue];
		j4076230461 -> j3569999725;
	j2214641703 [label="那么 ！到时候我会做好准备，静候佳音 ！在此之前，merci。",shape=box,color=blue];
		j2214641703 -> j3569999725;
	j1699929363 [label="我​绝不​会​暗示，​既然​恶魔​似乎​偏袒​你，​那么​他​或许​就​会​听​你​的话，​因为​他​根本​不​会​听​其他​人​的话。​",shape=box,color=blue];
		j1699929363 -> j2961448566;
	j56242066 [label="你开心我很高兴。而且如果恶魔也有地方可以消耗他的……精力……那就更好了，non ？",shape=box,color=blue];
		j56242066 -> j1737618716;
	j2496959965 [label="他生命中的每个人都试图把他当成某种怪物。我想我是第一个没有这么做的人。",shape=box,color=red];
		j2496959965 -> j3791449497;
	j1856589500 [label="他有很多事情不知道该如何表达。也不是说他在伪装——而是他不信任别人，害怕别人会伤害他。",shape=box,color=red];
		j1856589500 -> j1785684203;
	j4045007779 [label="他这些年来……经历过不少伤心事。伤口都结痂长满了刺，仅此而已。",shape=box,color=red];
		j4045007779 -> j617750783;
	j4037374738 [label="我大概能理解他那些年是怎么过来的。我见过的死亡和他一样多。",shape=box,color=red];
		j4037374738 -> j1558198830;
	j4135282209 [label="他一直以来都只是想做正确的事。确实，或许他的方式不对——但他是为了拯救始源星系免遭奥罗金人的蹂躏。",shape=box,color=red];
		j4135282209 -> j3545006868;
	j515383368 [label="我喜欢他那种略带讽刺的幽默感。抛开他的自负，他其实很聪明。",shape=box,color=red];
		j515383368 -> j400601659;
	j2733589392 [label="那么 ！到时候我会做好准备，静候佳音 ！直到那一天 ！",shape=box,color=blue];
		j2733589392 -> j3569999725;
	j2961448566 [label="而且在私下的时候绝对不会。Non。Jamais。",shape=box,color=blue];
		j2961448566 -> j516217346;
		j2961448566 -> j1619889363;
	j1737618716 [label="如果你能在他身边当个 un ange 让他冷静下来，这对我们所有人都是好事。",shape=box,color=blue];
		j1737618716 -> j3976602596;
		j1737618716 -> j1819021561;
	j3791449497 [label="想必​我​算​是​这些​人​中​带头​指责​的​人​了​吧？​我​想​我​应该​……​想​想​他​变成​现在​这样​的​原因。​定罪​救​不​了​任何​人。​",shape=box,color=blue];
		j3791449497 -> j2252614151;
	j1785684203 [label="每个人都有一些不愿示人的痛苦吧。我们会小心将它保护起来，唯恐别人会利用它。如果你说的是真的，我想我应该对他好一点。",shape=box,color=blue];
		j1785684203 -> j2252614151;
	j617750783 [label="我无法想象一个人在那些年里要承受多少爱与失去。即便我亲眼所见，这一切仍然让我觉得难以置信。",shape=box,color=blue];
		j617750783 -> j522671229;
	j1558198830 [label="有时和他交谈时，我会忘记他已经活了很多个世纪了。即便我亲眼目睹了这一切，也仍然觉得难以置信。",shape=box,color=blue];
		j1558198830 -> j2072756233;
	j3545006868 [label="事情总会有……细微差别，oui ？每一种行为的背后都有其缘由。如果你说的是真的，我想我应该试着对他更友善一些。",shape=box,color=blue];
		j3545006868 -> j2252614151;
	j400601659 [label="从来没有人否认过恶魔的聪明。",shape=box,color=blue];
		j400601659 -> j1035427790;
	j516217346 [label="你倒是让我意外了。不错。 ",shape=box,color=red];
		j516217346 -> j4023489044;
	j1619889363 [label="我从未发现你还有这一面。",shape=box,color=red];
		j1619889363 -> j4023489044;
	j3976602596 [label="我没法保证什么。",shape=box,color=red];
		j3976602596 -> j3118842960;
	j1819021561 [label="谁说我是在试图让他冷静下来？",shape=box,color=red];
		j1819021561 -> j1938134031;
	j2252614151 [label="+10 Chemistry",color=orange];
		j2252614151 -> j3527507793;
	j522671229 [label="Oui，那会对灵魂造成什么伤害呢？我明白你为什么会想找一个能理解你的人。而他，也找到了你。",shape=box,color=blue];
		j522671229 -> j2252614151;
	j2072756233 [label="活了这么久，目睹了这么多死亡——其中不少还是自己亲手造成的 ？",shape=box,color=blue];
		j2072756233 -> j522671229;
	j1035427790 [label="+5 Chemistry",color=orange];
		j1035427790 -> j3527507793;
	j3118842960 [label="Add 1 to Thermostat counter",color=orange];
		j3118842960 -> j27078807;
	j1938134031 [label="Add -1 to Thermostat counter",color=orange];
		j1938134031 -> j314533659;
	j3527507793 [label="我很高兴终于有人肯和恶魔交谈，或许还能让他有所收敛。你就像他肩上的 Un ange。",shape=box,color=blue];
		j3527507793 -> j1819021561;
		j3527507793 -> j3976602596;
	j27078807 [label="+10 Chemistry",color=orange];
		j27078807 -> j3238953365;
	j314533659 [label="+10 Chemistry",color=orange];
		j314533659 -> j4003143480;
	j3238953365 [label="Oui，我担心他身上有一种无法真正治愈的邪恶。他太享受这种邪恶了。",shape=box,color=blue];
		j3238953365 -> j4132339266;
	j4003143480 [label="或许你是对的……没有 son diable，un ange 又算什么呢？是他提醒了我们所有人，我们应该努力去避免的事。",shape=box,color=blue];
		j4003143480 -> j4132339266;
	j4132339266 [label="那么 ！如果哪天你成功说服恶魔帮助我们完成任务，我随时待命！直到那一天！",shape=box,color=blue];
		j4132339266 -> j3569999725;
}