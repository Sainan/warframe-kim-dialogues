		j374072022 -> j206995480 [label=true,color=green];
		j374072022 -> j3294948827 [label=false,color=brown];
	j2604673824 [label="我们必须打破这种僵局。我们现在陷入的这种炼狱不应该继续下去。这种痛苦似乎完全没有必要。",shape=box,color=blue];
		j2604673824 -> j1833866074;
	j2768654365 [label="Boolean MarieWillDate is now true.",color=orange];
		j2768654365 -> "Chat ends.";
	j880951260 [label="Bonjour mon cœur ！我仔细想过了……但我真的不愿意承认。说出这些话让我一点也不开心。",shape=box,color=blue];
		j880951260 -> j3473985436;
	j3169168027 [label="Bonjour——我仔细想过了……但我真的不愿意承认。说出这些话让我一点也不开心。",shape=box,color=blue];
		j3169168027 -> j3473985436;
	j2261063377 [label="Bonjour，mon cœur ！你怕我不喜欢什么呢 ？",shape=box,color=blue];
		j2261063377 -> j1064382078;
	j1906921075 [label="Bonjour ！哦 ？你怕我不喜欢什么呢 ？",shape=box,color=blue];
