	j1945085136 [label="S'il te plaît，别再这样下去——再这么下去我怕连他的笑话都会逗笑自己。到那时，我就真的是堕落了 ！",shape=box,color=blue];
		j1945085136 -> j758933647;
	j3284538837 [label="你有没有想过如何说服洛德去和楼上的英择谛家族谈谈？",shape=box,color=red];
		j3284538837 -> j3487613436;
	j1922061567 [label="我一直在想怎样才能说服洛德走上楼梯，去和家族的人谈谈，而且……我有个主意，但我认为你不会喜欢。",shape=box,color=red];
		j1922061567 -> j668862974;
	j2345183778 [label="玛丽，你还在想……试着说服洛德去跟“楼上的邻居”谈谈吗？我知道我们上次说到这儿的时候气氛有点尴尬。",shape=box,color=red];
		j2345183778 -> j374072022;
	j1884948745 [label="关于让洛德和英择谛家族对话这件事，我……想知道你有没有重新考虑过让罗瑟参与？",shape=box,color=red];
		j1884948745 -> j374072022;
	j1907860843 [label="我一直在想，洛德先生为什么那么害怕与主教的家人交谈。",shape=box,color=blue];
		j1907860843 -> j2604673824;
	j758933647 [label="Check boolean MarieNoDate",color=orange];
