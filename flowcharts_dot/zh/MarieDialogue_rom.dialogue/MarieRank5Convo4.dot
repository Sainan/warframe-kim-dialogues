		2999 -> 3006;
	3000 [label="他会的。我已经说服他去帮忙让他们团聚——你铁定想不到——我猜这样他就能保护英择谛的家人。毕竟，他们是仅存的奥罗金人了。",shape=box,color=red];
		3000 -> 3007;
	3001 [label="他会的。我已经说服他去帮忙让他们团聚——你一定不会惊讶——我猜主要是为了在阿尔布雷希特不在的时候恶心恶心他。",shape=box,color=red];
