		j409794056 -> j316367711 [label="false",color=purple];
	j2820557571 [label="你这么确定吗？如果连我都能放下与恶魔的 différences，你当然也能，non ？",shape=box,color=blue];
		j2820557571 -> j17353689;
		j2820557571 -> j2670954198;
	j2111033008 [label="你说得对。我没想到你会同意。我不敢问。",shape=box,color=red];
		j2111033008 -> j409794056;
	j3340113046 [label="不，肯定还有别的办法。我拒绝在这件事上寻求他的帮助。",shape=box,color=red];
		j3340113046 -> j2820557571;
	j3982034879 [label="他会在这件事上帮助我们吗 ？",shape=box,color=blue];
		j3982034879 -> j1971281437;
	j1068283745 [label="他会在这件事上帮助我们吗 ？",shape=box,color=blue];
		j1068283745 -> j4079436679;
	j4195831563 [label="他会在这件事上帮助我们吗 ？",shape=box,color=blue];
		j4195831563 -> j1487571505;
	j316367711 [label="你觉得你能说服他帮助我们吗 ？",shape=box,color=blue];
		j316367711 -> j961627032;
		j316367711 -> j2433013659;
	j17353689 [label="好的。如果你觉得没问题，我也没问题。",shape=box,color=red];
		j17353689 -> j1398897156;
	j2670954198 [label="不行，对不起。 ",shape=box,color=red];
		j2670954198 -> j3678443680;
	j1971281437 [label="不，很可惜……我想这条路在他那是行不通了。你觉得还有别的办法吗？",shape=box,color=red];
		j1971281437 -> j3360549135;
	j4079436679 [label="他会的。我已经说服他去帮忙让他们团聚——你铁定想不到——我猜这样他就能保护英择谛的家人。毕竟，他们是仅存的奥罗金人了。",shape=box,color=red];
		j4079436679 -> j2723070985;
	j1487571505 [label="他会的。我已经说服他去帮忙让他们团聚——你一定不会惊讶——我猜主要是为了在阿尔布雷希特不在的时候恶心恶心他。",shape=box,color=red];
		j1487571505 -> j4165142682;
	j961627032 [label="我还在尝试，但我想我能说服他。",shape=box,color=red];
		j961627032 -> j961489522;
	j2433013659 [label="一切都还没定下来。他……嗯，你知道他是什么样的人。",shape=box,color=red];
		j2433013659 -> j3827853471;
	j1398897156 [label="Oui，我也不喜欢这样，但我想，这是我们不得不吞下的 un médicament。",shape=box,color=blue];
		j1398897156 -> j409794056;
	j3678443680 [label="+20 Chemistry",color=orange];
		j3678443680 -> j2152454172;
	j3360549135 [label="哦 ！那真是……太可惜了。我不知道 ？我想不到……你能想到其他办法说服恶魔吗 ？或者再试一次 ？",shape=box,color=blue];
		j3360549135 -> j1309901026;
	j2723070985 [label="他​居然​在帮忙保护那个男人的家人，尽管那个男人违背了他的意愿将他改造成原型战甲、剥夺了他记忆并将他放逐到过去……",shape=box,color=blue];
		j2723070985 -> j3973854986;
