		3052 -> 3065;
	3054 [label="那么 ！到时候我会做好准备，静候佳音 ！在此之前，merci，mon cœur。",shape=box,color=blue];
		3054 -> 3066;
	3055 [label="那么 ！到时候我会做好准备，静候佳音 ！在此之前，merci。",shape=box,color=blue];
		3055 -> 3066;
	3049 [label="我​绝不​会​暗示，​既然​恶魔​似乎​偏袒​你，​那么​他​或许​就​会​听​你​的话，​因为​他​根本​不​会​听​其他​人​的话。​",shape=box,color=blue];
		3049 -> 3062;
	3050 [label="你开心我很高兴。而且如果恶魔也有地方可以消耗他的……精力……那就更好了，non ？",shape=box,color=blue];
		3050 -> 3063;
	3045 [label="他生命中的每个人都试图把他当成某种怪物。我想我是第一个没有这么做的人。",shape=box,color=red];
		3045 -> 3058;
	3044 [label="他有很多事情不知道该如何表达。也不是说他在伪装——而是他不信任别人，害怕别人会伤害他。",shape=box,color=red];
		3044 -> 3057;
	3047 [label="他这些年来……经历过不少伤心事。伤口都结痂长满了刺，仅此而已。",shape=box,color=red];
		3047 -> 3060;
	3048 [label="我大概能理解他那些年是怎么过来的。我见过的死亡和他一样多。",shape=box,color=red];
		3048 -> 3061;
	3043 [label="他一直以来都只是想做正确的事。确实，或许他的方式不对——但他是为了拯救始源星系免遭奥罗金人的蹂躏。",shape=box,color=red];
		3043 -> 3056;
	3046 [label="我喜欢他那种略带讽刺的幽默感。抛开他的自负，他其实很聪明。",shape=box,color=red];
		3046 -> 3059;
	3064 [label="Chat ends.",color=orange];
	3065 [label="那么 ！到时候我会做好准备，静候佳音 ！直到那一天 ！",shape=box,color=blue];
		3065 -> 3075;
	3066 [label="Update boolean MarieFamilySuccess",color=orange];
		3066 -> 3076;
	3062 [label="而且在私下的时候绝对不会。Non。Jamais。",shape=box,color=blue];
		3062 -> 3071;
		3062 -> 3072;
	3063 [label="如果你能在他身边当个 un ange 让他冷静下来，这对我们所有人都是好事。",shape=box,color=blue];
		3063 -> 3073;
		3063 -> 3074;
	3058 [label="想必​我​算​是​这些​人​中​带头​指责​的​人​了​吧？​我​想​我​应该​……​想​想​他​变成​现在​这样​的​原因。​定罪​救​不​了​任何​人。​",shape=box,color=blue];
		3058 -> 3067;
	3057 [label="每个人都有一些不愿示人的痛苦吧。我们会小心将它保护起来，唯恐别人会利用它。如果你说的是真的，我想我应该对他好一点。",shape=box,color=blue];
		3057 -> 3067;
	3060 [label="我无法想象一个人在那些年里要承受多少爱与失去。即便我亲眼所见，这一切仍然让我觉得难以置信。",shape=box,color=blue];
		3060 -> 3069;
	3061 [label="有时和他交谈时，我会忘记他已经活了很多个世纪了。即便我亲眼目睹了这一切，也仍然觉得难以置信。",shape=box,color=blue];
		3061 -> 3070;
	3056 [label="事情总会有……细微差别，oui ？每一种行为的背后都有其缘由。如果你说的是真的，我想我应该试着对他更友善一些。",shape=box,color=blue];
		3056 -> 3067;
	3059 [label="从来没有人否认过恶魔的聪明。",shape=box,color=blue];
		3059 -> 3068;
	3075 [label="Update boolean MarieFamilySuccess",color=orange];
		3075 -> 3080;
