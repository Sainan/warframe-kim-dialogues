		3067 -> 3077;
	3069 [label="Oui，那会对灵魂造成什么伤害呢？我明白你为什么会想找一个能理解你的人。而他，也找到了你。",shape=box,color=blue];
		3069 -> 3067;
	3070 [label="活了这么久，目睹了这么多死亡——其中不少还是自己亲手造成的 ？",shape=box,color=blue];
