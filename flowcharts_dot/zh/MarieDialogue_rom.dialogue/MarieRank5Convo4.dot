		2974 -> 2981;
	2980 [label="但我感觉我们需要……某种意义上的堡垒，non ？你有什么想法吗 ？",shape=box,color=blue];
		2980 -> 2984;
		2980 -> 2983;
	2982 [label="但我想……我只是想想——啊，太阳神，请原谅我——我们或许需要恶魔的帮助。否则，我想洛德先生是不会听我们的。",shape=box,color=blue];
		2982 -> 2986;
	2983 [label="我认为我们需要罗瑟的帮助才能说服洛德与英择谛家族交谈。除非能保证英择谛家族和他本人的安全，否则，我认为他是不会答应的。",shape=box,color=red];
		2983 -> 2987;
	2981 [label="我相信你说的或许是对的。恶魔或许正是我们需要的那块拼图。啊，光是打出这些字都让我感到痛苦 ！ ",shape=box,color=blue];
		2981 -> 2985;
	2984 [label="我实在想不出什么好主意，除了能想到一些不靠谱的办法。这些办法很可能会在以后给我们带来大麻烦。比如，罗瑟。",shape=box,color=red];
		2984 -> 2988;
