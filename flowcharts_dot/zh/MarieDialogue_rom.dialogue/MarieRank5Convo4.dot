	j206995480 [label="Bonjour，bonjour，mon cœur ！我仔细想过了……但我真的不愿意承认。说出这些话让我一点也不开心。",shape=box,color=blue];
		j206995480 -> j142353178;
	j3294948827 [label="Bonjour——我仔细想过了……但我真的不愿意承认。说出这些话让我一点也不开心。",shape=box,color=blue];
		j3294948827 -> j142353178;
	j1833866074 [label="但我感觉我们需要……某种意义上的堡垒，non ？你有什么想法吗 ？",shape=box,color=blue];
		j1833866074 -> j1031569306;
		j1833866074 -> j1064382078;
	j3473985436 [label="但我想……我只是想想——啊，太阳神，请原谅我——我们或许需要恶魔的帮助。否则，我想洛德先生是不会听我们的。",shape=box,color=blue];
		j3473985436 -> j2298569625;
	j1064382078 [label="我认为我们需要罗瑟的帮助才能说服洛德与英择谛家族交谈。除非能保证英择谛家族和他本人的安全，否则，我认为他是不会答应的。",shape=box,color=red];
		j1064382078 -> j854013817;
	j142353178 [label="我相信你说的或许是对的。恶魔或许正是我们需要的那块拼图。啊，光是打出这些字都让我感到痛苦 ！ ",shape=box,color=blue];
		j142353178 -> j409794056;
	j1031569306 [label="我实在想不出什么好主意，除了能想到一些不靠谱的办法。这些办法很可能会在以后给我们带来大麻烦。比如，罗瑟。",shape=box,color=red];
		j1031569306 -> j2820557571;
	j2298569625 [label="恶魔很有能力，而且在事情出错时总会用力量来引诱人，non ？",shape=box,color=blue];
		j2298569625 -> j2111033008;
		j2298569625 -> j3340113046;
	j854013817 [label="我……很不愿意承认，但我认为你可能是对的……太阳神，请原谅我。",shape=box,color=blue];
		j854013817 -> j409794056;
	j409794056 [label="Evaluate expressions",color=orange];
		j409794056 -> j3982034879 [label="RoatheFamilyFail",color=purple];
