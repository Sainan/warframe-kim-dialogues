		j4253852536 -> j2949354110;
	j227286332 [label="这已经总结得相当厉害了。",shape=box,color=red];
		j227286332 -> j3550271036;
	j494757286 [label="我希望人们眼中的我不只是这样，说实话。",shape=box,color=red];
		j494757286 -> j2220289127;
	j2413679992 [label="我感激你这么想。他很坚强，能承受所有对他的打击。但所有重担，一起扛都会轻松很多。",shape=box,color=blue];
		j2413679992 -> j753607743;
		j2413679992 -> j151693410;
