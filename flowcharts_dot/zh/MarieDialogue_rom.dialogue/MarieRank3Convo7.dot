		j724527557 -> j1848821135;
	j4258163334 [label="大家都说，你是狼，可你却对我这么有礼貌 ！真是太贴心了。我觉得我知道你想问什么。我为什么会流落街头 ？",shape=box,color=blue];
		j4258163334 -> j2034523640;
	j1514319684 [label="你们俩是怎么认识的 ？",shape=box,color=red];
		j1514319684 -> j2921416091;
	j366690549 [label="我已经有点习惯是“本地景点”了，我理解你为什么会有防御心理。",shape=box,color=red];
		j366690549 -> j3178600648;
	j1755815102 [label="没事的，我只是担心他。",shape=box,color=red];
		j1755815102 -> j1410189085;
	j3251262111 [label="我……为我的粗鲁道歉。我只是习惯了好奇的围观者四处走动，敲打他的笼子栏杆，就像他是 monstre de cirque 一样。",shape=box,color=blue];
		j3251262111 -> j366690549;
		j3251262111 -> j1755815102;
	j1848821135 [label="你可以想象，在我们那个年代，对于像我这种双腿无法行走的人来说，在光城没有什么工作可以做，也没有什么地方可以去。",shape=box,color=blue];
		j1848821135 -> j3461271454;
	j2921416091 [label="我亲爱的里昂，早在 Mère Supérieure 收留我的时候，就已经在 Cathédrale 里安顿了很久，之后我加入了双耀神教会，成为了一名修女。",shape=box,color=blue];
		j2921416091 -> j4163057655;
		j2921416091 -> j4253852536;
	j3178600648 [label="Oui，我猜你肯定是，一个时间旅行生物，能循环时间，还能凭空召唤整个世界 ！有点像个魔术师，non ？",shape=box,color=blue];
		j3178600648 -> j227286332;
		j3178600648 -> j494757286;
	j1410189085 [label="+5 Chemistry",color=orange];
		j1410189085 -> j2413679992;
	j3461271454 [label="我想，这就是为什么我和里昂这么快就成了家人。他从没用怜悯的眼光看过我，一次也没有。我对他也没有过。",shape=box,color=blue];
		j3461271454 -> j4242016216;
	j4163057655 [label="你……需要住的地方吗 ？",shape=box,color=red];
		j4163057655 -> j4087191105;
