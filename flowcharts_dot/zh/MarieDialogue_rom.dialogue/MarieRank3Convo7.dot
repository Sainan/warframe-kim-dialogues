		j3059179687 -> j4097536591;
	j2248365081 [label="[结束。]",shape=box,color=red];
		j2248365081 -> "Chat ends.";
	j2928813001 [label="我亲爱的里昂，早在 Mère Supérieure 收留我的时候，就已经在 Cathédrale 里安顿了很久，之后我加入了双耀神教会，成为了一名修女。（听到你们开始聊天了，我好兴奋 ！）",shape=box,color=blue];
		j2928813001 -> j2470830941;
		j2928813001 -> j2915981367;
	j4097536591 [label="在我们继续之前，我想请你先定义。而且请你温柔地定义，并且我小心地提醒你，他是我灵里的弟兄。",shape=box,color=blue];
		j4097536591 -> j621654737;
		j4097536591 -> j3231216511;
	"Chat ends." [color=orange];
	j2470830941 [label="你……需要住的地方吗 ？",shape=box,color=red];
		j2470830941 -> j2034523640;
	j2915981367 [label="我可以问一个不太礼貌的问题吗 ？",shape=box,color=red];
		j2915981367 -> j1067621763;
	j621654737 [label="如果这个谈话让你不舒服，我们可以换个话题。",shape=box,color=red];
		j621654737 -> j3854149755;
	j3231216511 [label="我一点也不想让你难过。我只是担心他。他看起来很镇定，但我感觉他很痛苦，仅此而已。",shape=box,color=red];
		j3231216511 -> j1453741619;
	j2034523640 [label="因为很多年前，当我还是个小女孩的时候，我被 ma famille 抛弃在街头。我当了很多年的乞丐，想尽一切办法过活。",shape=box,color=blue];
		j2034523640 -> j724527557;
	j1067621763 [label="+5 Chemistry",color=orange];
		j1067621763 -> j4258163334;
	j3854149755 [label="不，不。没事。我只是习惯了好奇的围观者四处走动，敲打他的笼子栏杆，就像他是 monstre de cirque 一样。",shape=box,color=blue];
		j3854149755 -> j1514319684;
		j3854149755 -> j366690549;
		j3854149755 -> j1755815102;
	j1453741619 [label="+5 Chemistry",color=orange];
		j1453741619 -> j3251262111;
