	1527 [label="大家都说，你是狼，可你却对我这么有礼貌！真是太贴心了。我觉得我知道你想问什么。我为什么会流落街头 ？",shape=box,color=blue];
		1527 -> 1519;
	1528 [label="总有一天，会有一本关于你的故事书，我觉得。这个想法多美妙啊。我应该去写。虽然会用高卢语 ！ Imaginez cela ！",shape=box,color=blue];
		1528 -> 1533;
	1529 [label="那你就真的明白了。我不只是玛丽修女，那个脚没被赋予飞翔力量的可怜女孩。里昂也不只是一个默默承受重担的悲剧神父。",shape=box,color=blue];
		1529 -> 1534;
	1530 [label="+10 Chemistry",color=orange];
		1530 -> 1535;
	1536 [label="我已经有点习惯是“本地景点”了，我理解你们的感受。不，不是这样的。 ",shape=box,color=red];
		1536 -> 1541;
	1537 [label="不，我只是好奇。而且说实话，我有点担心他。我觉得他掩盖了很多自己的痛苦。",shape=box,color=red];
		1537 -> 1542;
	1532 [label="你可以想象，在我们那个年代，对于像我这种双腿无法行走的人来说，在光城没有什么工作可以做，也没有什么地方可以去。",shape=box,color=blue];
		1532 -> 1538;
	1533 [label="或者干脆别去想这些，它可能会成真。哈 ！说了这么多，我恐怕得跟你告别了。Murmure 真是永不停歇 ！",shape=box,color=blue];
		1533 -> 1539;
	1534 [label="记住这一点，我们会成为好朋友的，我觉得。说到这美好的盼望，我恐怕得跟你告别了。Murmure 真是永不停歇 ！",shape=box,color=blue];
		1534 -> 1540;
	1535 [label="耐心点。他……一开始不会主动。但时机成熟时，他会来找你的。如果你是好意，他会知道的。但现在，我恐怕得跟你告别了。",shape=box,color=blue];
		1535 -> 2424;
