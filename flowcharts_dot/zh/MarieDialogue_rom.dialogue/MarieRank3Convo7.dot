		j3245910825 -> j4087191105;
	j348890991 [label="总有一天，会有一本关于你的故事书，我觉得。这个想法多美妙啊。我应该去写。虽然会用高卢语 ！ Imaginez cela ！",shape=box,color=blue];
		j348890991 -> j4090853423;
	j1384281964 [label="那你就真的明白了。我不只是玛丽修女，那个脚没被赋予飞翔力量的可怜女孩。里昂也不只是一个默默承受重担的悲剧神父。",shape=box,color=blue];
