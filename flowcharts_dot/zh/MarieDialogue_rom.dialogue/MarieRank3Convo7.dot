		1489 -> 1492;
	1494 [label="我亲爱的里昂，早在 Mère Supérieure 收留我的时候，就已经在 Cathédrale 里安顿了很久，之后我加入了双耀神教会，成为了一名修女。（听到你们开始聊天了，我好兴奋 ！）",shape=box,color=blue];
		1494 -> 1497;
		1494 -> 1498;
	1493 [label="在我们继续之前，我想请你先定义。而且请你温柔地定义，并且我小心地提醒你，他是我灵里的弟兄。",shape=box,color=blue];
		1493 -> 1495;
		1493 -> 1496;
	1492 [label="Chat ends.",color=orange];
	1497 [label="你……需要住的地方吗 ？",shape=box,color=red];
		1497 -> 1501;
	1498 [label="我可以问一个不太礼貌的问题吗 ？",shape=box,color=red];
		1498 -> 1502;
	1495 [label="如果这个谈话让你不舒服，我们可以换个话题。",shape=box,color=red];
		1495 -> 1499;
	1496 [label="我一点也不想让你难过。我只是担心他。他看起来很镇定，但我感觉他很痛苦，仅此而已。",shape=box,color=red];
		1496 -> 1500;
	1501 [label="因为很多年前，当我还是个小女孩的时候，我被 ma famille 抛弃在街头。我当了很多年的乞丐，想尽一切办法过活。",shape=box,color=blue];
		1501 -> 1507;
	1502 [label="+5 Chemistry",color=orange];
		1502 -> 1508;
	1499 [label="不，不。没事。我只是习惯了好奇的围观者四处走动，敲打他的笼子栏杆，就像他是 monstre de cirque 一样。",shape=box,color=blue];
		1499 -> 1503;
		1499 -> 1504;
		1499 -> 1505;
	1500 [label="+5 Chemistry",color=orange];
		1500 -> 1506;
	1507 [label="Update boolean MarieBeggar1",color=orange];
		1507 -> 1512;
	1508 [label="大家都说，你是狼，可你却对我这么有礼貌 ！真是太贴心了。我觉得我知道你想问什么。我为什么会流落街头 ？",shape=box,color=blue];
		1508 -> 1501;
	1503 [label="你们俩是怎么认识的 ？",shape=box,color=red];
		1503 -> 1509;
	1504 [label="我已经有点习惯是“本地景点”了，我理解你为什么会有防御心理。",shape=box,color=red];
		1504 -> 1510;
	1505 [label="没事的，我只是担心他。",shape=box,color=red];
		1505 -> 1511;
	1506 [label="我……为我的粗鲁道歉。我只是习惯了好奇的围观者四处走动，敲打他的笼子栏杆，就像他是 monstre de cirque 一样。",shape=box,color=blue];
		1506 -> 1504;
		1506 -> 1505;
	1512 [label="你可以想象，在我们那个年代，对于像我这种双腿无法行走的人来说，在光城没有什么工作可以做，也没有什么地方可以去。",shape=box,color=blue];
		1512 -> 1518;
	1509 [label="我亲爱的里昂，早在 Mère Supérieure 收留我的时候，就已经在 Cathédrale 里安顿了很久，之后我加入了双耀神教会，成为了一名修女。",shape=box,color=blue];
		1509 -> 1513;
		1509 -> 1514;
	1510 [label="Oui，我猜你肯定是，一个时间旅行生物，能循环时间，还能凭空召唤整个世界 ！有点像个魔术师，non ？",shape=box,color=blue];
		1510 -> 1515;
		1510 -> 1516;
	1511 [label="+5 Chemistry",color=orange];
		1511 -> 1517;
	1518 [label="我想，这就是为什么我和里昂这么快就成了家人。他从没用怜悯的眼光看过我，一次也没有。我对他也没有过。",shape=box,color=blue];
		1518 -> 1525;
	1513 [label="你……需要住的地方吗 ？",shape=box,color=red];
		1513 -> 1519;
