		1546 -> 1522;
	1547 [label="你说得对，他确实会这么做。但他觉得为了保护他身边的人，有必要这么做。等他觉得你不再需要这些东西时，他就会告诉你他的烦恼。耐心一点。他迟早会找你倾诉的。",shape=box,color=blue];
