		1514 -> 1520;
	1515 [label="这已经总结得相当厉害了。",shape=box,color=red];
		1515 -> 1521;
	1516 [label="我希望人们眼中的我不只是这样，说实话。",shape=box,color=red];
		1516 -> 1522;
	1517 [label="我感激你这么想。他很坚强，能承受所有对他的打击。但所有重担，一起扛都会轻松很多。",shape=box,color=blue];
		1517 -> 1523;
		1517 -> 1524;
