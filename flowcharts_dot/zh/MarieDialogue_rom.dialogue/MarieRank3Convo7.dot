		j2274898879 -> j904060833;
	j4090853423 [label="或者干脆别去想这些，它可能会成真。哈 ！说了这么多，我恐怕得跟你告别了。Murmure 真是永不停歇 ！",shape=box,color=blue];
		j4090853423 -> "Chat ends.";
	j2646140331 [label="记住这一点，我们会成为好朋友的，我觉得。说到这美好的盼望，我恐怕得跟你告别了。Murmure 真是永不停歇 ！",shape=box,color=blue];
		j2646140331 -> "Chat ends.";
	j3562692710 [label="耐心点。他……一开始不会主动。但时机成熟时，他会来找你的。如果你是好意，他会知道的。但现在，我恐怕得跟你告别了。",shape=box,color=blue];
