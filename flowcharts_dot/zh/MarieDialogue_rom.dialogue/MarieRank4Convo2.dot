		j2740352176 -> j2606481031;
	j4272721184 [label="Oui，我也知道自己很幸运。而这种平安很容易让人想强加给别人——不管对方是否愿意。",shape=box,color=blue];
		j4272721184 -> j4238753936;
	j2936116283 [label="有啊，很多次。每当那时，我会反思为什么。也许那段路我注定要自己摸索，non ？Ou peut-être que je suis une folle après tout，哈哈 ！不是所有事我们都能知晓的。",shape=box,color=blue];
		j2936116283 -> j4238753936;
