	j2707191370 [label="你想知道，是什么让我如此确信 ？毕竟你说过，我们无法了解宇宙 ？",shape=box,color=blue];
		j2707191370 -> j2227135354;
	j1444968926 [label="对于一个没有信仰的人，我能理解为什么这看起来很奇怪，oui。",shape=box,color=blue];
