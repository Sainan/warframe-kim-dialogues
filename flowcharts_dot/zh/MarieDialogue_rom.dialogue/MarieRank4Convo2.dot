		j3443044352 -> j2735141707;
	j3639536286 [label="Oui ！我不喜欢鲜切花。如果你想送我礼物，我希望不要是插在花瓶里的玫瑰。",shape=box,color=blue];
		j3639536286 -> j2634921592;
