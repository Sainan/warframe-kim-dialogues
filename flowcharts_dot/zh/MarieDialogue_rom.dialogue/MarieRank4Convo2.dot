	j3799424915 [label="不过​我​在想，​你有没有觉得自己处​于​十字​路口，​需要思​考​该​走哪​条路的感觉，​non ？​",shape=box,color=blue];
		j3799424915 -> j181021969;
	j3884558206 [label="一个灵魂不只有信仰。我虽然是 une Sœur de Sol，但我希望你看到的不只我这一面，non ？",shape=box,color=blue];
		j3884558206 -> j2276715616;
	j1869863158 [label="这便是我信的理由。在我最迷茫的时候，我能感觉得到太阳神就在我身边。我闭上双眼，et il est là，带领我前行。",shape=box,color=blue];
		j1869863158 -> j1320206251;
