		j1869863158 -> j4199813473;
	j4088987295 [label="我不知道你能否找到它，但我祈祷你能找到。因为如果你发现了什么，那必定是一个神迹。 ",shape=box,color=blue];
		j4088987295 -> j3865777603;
	j4137268904 [label="真的很美好……",shape=box,color=blue];
		j4137268904 -> j3865777603;
