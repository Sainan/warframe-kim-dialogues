		j3505524140 -> j2948099446;
	j2927568332 [label="老实说 ？是有点。不过我本来不想这么说。",shape=box,color=red];
		j2927568332 -> j1084088820;
	j3089604242 [label="我​更​想​知道​是​不​是​有​一​个​事件，​或者​是​某个​时刻……​让​你​去信。​",shape=box,color=red];
		j3089604242 -> j2227135354;
	j3424206580 [label="我也不知道！但现在可能性是无穷无尽的 ！",shape=box,color=blue];
		j3424206580 -> j2562785494;
	j2915490074 [label="Peut-être ！但现在可能性是无穷无尽的 ！",shape=box,color=blue];
		j2915490074 -> j2562785494;
	j1690170963 [label="因为恶魔告诉我你会这么问。",shape=box,color=blue];
		j1690170963 -> j3808512584;
	j3578612871 [label="哦 ！哦，请原谅我 ！对不起。你想问什么 ？Et maintenant，je suis mortifiée……",shape=box,color=blue];
		j3578612871 -> j2713907971;
		j3578612871 -> j1038552372;
	j2519776880 [label="而你说过这并没有给你带来多少平安……这让我感到心碎。",shape=box,color=blue];
		j2519776880 -> j810558110;
	j810558110 [label="我不会告诉你该去做什么。我也不会告诉你该寻找什么路。",shape=box,color=blue];
		j810558110 -> j2767111008;
	j1689171944 [label="坦白说，我不知道。那是一时冲动。",shape=box,color=red];
		j1689171944 -> j89020684;
	j3167226639 [label="我当时觉得这是一个更好地了解你的机会……",shape=box,color=red];
		j3167226639 -> j4236962542;
	j3865777603 [label="但你刚刚问问我的是我为什么信，我却失礼地将问题抛回给你，je m'excuse。",shape=box,color=blue];
		j3865777603 -> j2227135354;
	j1106178501 [label="即便如此，那也是人类和科学的成果，而不是双耀神，non ？这个赐予了我飞行能力的血清——",shape=box,color=blue];
		j1106178501 -> j523820356;
	j561766653 [label="但是你说过这并没有给你带来多少平安 ？这让我感到心碎……",shape=box,color=blue];
		j561766653 -> j3938764377;
	j1586958323 [label="我认为你的信仰可能是所有人中最坚定的，non ？",shape=box,color=blue];
		j1586958323 -> j3198171455;
	j1413326738 [label="那你不觉得英择谛的血清就是一个神迹 ？",shape=box,color=red];
		j1413326738 -> j1106178501;
	j2948099446 [label="连里昂的那些声音也不算吗？或者那个虚空无情之物 ？",shape=box,color=red];
		j2948099446 -> j4170721077;
	j1084088820 [label="哦，如果别人只是觉得我信双耀神有点傻，那已经算是对不同信仰的人非常客气了。",shape=box,color=blue];
		j1084088820 -> j1195158433;
	j2562785494 [label="恶魔应该非常害怕 ！小心，邪恶之人 ！光将从上方击打你 ！",shape=box,color=blue];
		j2562785494 -> j995118923;
	j3808512584 [label="Non，non，non……你不是要问我这个，是吗 ？啊 ！！Je vais lui faire bouffer un de ces livres ！",shape=box,color=blue];
		j3808512584 -> j1971387406;
	j2767111008 [label="因为在你们所处的这场虚空风暴中，我只是一个简陋的避难所。",shape=box,color=blue];
		j2767111008 -> j3799424915;
	j89020684 [label="我不知道是什么本能驱使你对我说了这样的话。但我很高兴你现在说的是真话。",shape=box,color=blue];
		j89020684 -> j3884558206;
