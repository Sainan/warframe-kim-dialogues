		j3080931226 -> j1586958323 [label=false,color=brown];
	j3505524140 [label="Non，我只是一直感觉到我的生命里好像有一个 présence 一直在带领我。像一位在我走到十字路口时微笑着指引我的恩人，仅此而已。",shape=box,color=blue];
