		j3198171455 -> j4137268904;
	j4170721077 [label="可能吧，我不知道。也许恶魔是对的，这些事只是我们尚不了解的科学。可这两者并不矛盾，non ？",shape=box,color=blue];
		j4170721077 -> j1869863158;
