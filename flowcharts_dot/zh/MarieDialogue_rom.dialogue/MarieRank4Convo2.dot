	j2619901242 [label="我想要信。因此，我信。",shape=box,color=red];
		j2619901242 -> j3080931226;
	j2227135354 [label="狼，恐怕我的答案会让你失望。没有什么伟大的神迹。天空中也没有什么光芒照耀着我。",shape=box,color=blue];
		j2227135354 -> j3505524140;
