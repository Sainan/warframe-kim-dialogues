	2885 [label="+5 Chemistry",color=orange];
		2885 -> 2872;
	2883 [label="我也是 ！但同样地，这也成为了我们自身的一部分，non ？我们凭什么说我们身上的哪些部分重要，哪些部分不重要呢 ？",shape=box,color=blue];
		2883 -> 2886;
	2884 [label="哦 ！一个小家伙，黄黑相间，身上有条纹， derrière 上还带根针……会产蜜吗 ？",shape=box,color=blue];
