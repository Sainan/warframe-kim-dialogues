	j245696372 [label="哦，你问得如此体贴……但一如既往，这恐怕……不过是种比较而已。",shape=box,color=blue];
		j245696372 -> j965038964;
		j245696372 -> j2208593831;
	j3848614734 [label="如果我问起这件事让你想起了你的脚并感到不适的话，真的很抱歉。",shape=box,color=red];
		j3848614734 -> j2957460538;
	j1041435290 [label="有什么我能做的事能让情况好转，或者转移你的注意力吗？",shape=box,color=red];
		j1041435290 -> j3988336518;
	j965038964 [label="哦，对不起……今天疼痛特别严重吗？ ",shape=box,color=red];
		j965038964 -> j1687951355;
	j2208593831 [label="我能做点什么吗？",shape=box,color=red];
		j2208593831 -> j8875265;
	j473243910 [label="你真是 Vraiment gentil，不过这已经是个老问题了，不值得你费心。我会没事的。",shape=box,color=blue];
		j473243910 -> j3359734167;
	j3859078798 [label="+10 Chemistry",color=orange];
