		j2957460538 -> j900328916;
	j3988336518 [label="+10 Chemistry",color=orange];
		j3988336518 -> j1426725535;
	j1687951355 [label="是的，恐怕如此。心灵真是奇妙的存在。最令人着迷的是，那些疼痛永远都在，无时无刻不在折磨着我，而我却学会了全然无视它们。",shape=box,color=blue];
		j1687951355 -> j4237729904;
		j1687951355 -> j1063856288;
		j1687951355 -> j2756753226;
	j8875265 [label="你现在跟我聊天就是在帮我了。心灵真是奇妙的存在，不是吗 ？Mes pieds 肯定时刻都在疼痛，而我却学会了全然无视它们。",shape=box,color=blue];
		j8875265 -> j4237729904;
		j8875265 -> j1063856288;
		j8875265 -> j2756753226;
	j3359734167 [label="Boolean MarieChronicPain is now true.",color=orange];
		j3359734167 -> j533815429;
		j3359734167 -> j204405186;
		j3359734167 -> j3744162769;
	j46001693 [label="Oui，我很好，放心吧。但 merci。你的关心我很感激。",shape=box,color=blue];
		j46001693 -> "Chat ends.";
	j900328916 [label="哈！有趣吧，现实就是这样，non ？你说得对。我原本没在想 mes pieds，但现在想起来了，现在它们疼了。 ",shape=box,color=blue];
		j900328916 -> j2814836010;
	j1426725535 [label="Oui ！你现在跟我聊天就是在帮我了。心灵真是奇妙的存在，不是吗 ？Mes pieds 肯定时刻都在疼痛，而我却学会了全然无视它们。",shape=box,color=blue];
		j1426725535 -> j3287366061;
		j1426725535 -> j3935532263;
		j1426725535 -> j3493594743;
	j4237729904 [label="听起来真累人啊……",shape=box,color=red];
		j4237729904 -> j2893724686;
	j1063856288 [label="这听起来很沮丧。",shape=box,color=red];
		j1063856288 -> j2716662205;
	j2756753226 [label="真的没有治愈的方法吗？永远都不会好？",shape=box,color=red];
		j2756753226 -> j4275614665;
	j533815429 [label="如果你真的这样想的话。但如果你想谈谈，我一直在。",shape=box,color=red];
		j533815429 -> j1755849366;
	j204405186 [label="我……知道那种感觉。在我开始“循环”之前，我在双衍王境受了很重的伤。虽然已经痊愈了，但还是时不时地疼得厉害。每次疼起来，我都尽量掩饰自己畏缩的表情。",shape=box,color=red];
		j204405186 -> j383536557;
	j3744162769 [label="旧问题有时和新问题一样棘手。即使它们来来去去，并且一直萦绕在我们身边，也不意味着它们不值得讨论。",shape=box,color=red];
		j3744162769 -> j1125401696;
	j2814836010 [label="心灵真是奇妙的存在。最令人着迷的是，那些疼痛永远都在，无时无刻不在折磨着我，而我却学会了全然无视它们。",shape=box,color=blue];
		j2814836010 -> j3287366061;
		j2814836010 -> j3935532263;
		j2814836010 -> j3493594743;
	j3287366061 [label="我也是这样。只要一专注——噢，疼痛就来了。有时我怀疑自己是否正因如此才这样忙得不可开交。",shape=box,color=red];
		j3287366061 -> j341747105;
	j3935532263 [label="有时想到如果没有疼痛的折磨，我本该能完成多少事情，就会感到愤怒。",shape=box,color=red];
		j3935532263 -> j1378819069;
	j3493594743 [label="你也是整天都累得要命吗？有时我怀疑自己是否因此精疲力竭，总在不知不觉中耗费精力忍受疼痛。",shape=box,color=red];
		j3493594743 -> j3502871747;
	j2893724686 [label="+10 Chemistry",color=orange];
		j2893724686 -> j877424715;
