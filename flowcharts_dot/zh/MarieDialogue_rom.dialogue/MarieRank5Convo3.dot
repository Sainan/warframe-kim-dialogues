		j2427033551 -> j1486154761 [label="DrifterFaithNoMITW",color=purple];
		j2427033551 -> j3035173419 [label="false",color=purple];
	j1301935320 [label="哦，是蜜蜂！",shape=box,color=red];
		j1301935320 -> j302802897;
	j1968228449 [label="不，没明白……继续说。",shape=box,color=red];
		j1968228449 -> j1444843598;
	j1736955846 [label="我不想谈论信仰，只是想说……纵然我们从这有限的视角来看，难免认为自身存在缺陷，但我们必须……与自己和解，non ？这是我们所能拥有的一切。",shape=box,color=blue];
		j1736955846 -> j2548984291;
	j353599404 [label="我知道我们的信仰形式相似，所以我想说……太阳神认为应当将我塑造成现在的模样。我理应相信他的安排，non ？纵使以我有限的视角来看，这似乎也存在缺陷。不知道你是不是也以同样方式看待你的信仰。",shape=box,color=blue];
		j353599404 -> j2548984291;
	j3854618380 [label="我知道我们的信仰形式不同，所以我不会在不了解的情况下妄加评论。但我只是想说太阳神认为应当将我塑造成现在的模样。我理应相信他的安排，non ？纵使以我有限的视角来看，这似乎也存在缺陷。不知道你是不是也以同样方式看待你的信仰。",shape=box,color=blue];
