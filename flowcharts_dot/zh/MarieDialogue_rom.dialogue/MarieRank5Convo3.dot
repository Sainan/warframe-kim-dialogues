		j1378819069 -> j1326666492 [label=false,color=brown];
	j3502871747 [label="+5 Chemistry",color=orange];
		j3502871747 -> j1975738273;
	j877424715 [label="Oui，确实如此。Par exemple——",shape=box,color=blue];
		j877424715 -> j2004108057;
	j2213390618 [label="但就像你说的，non ？所有像我这样的不便之处都蕴藏着一种隐秘力量。我们只需去发现它们。",shape=box,color=blue];
		j2213390618 -> j1187753878;
	j4016267746 [label="Oui，确实如此。我时常坐在那里，盯着着书架顶端的一本书，想着自己够不着它，多么不公平啊。",shape=box,color=blue];
		j4016267746 -> j1105954743;
	j3674771282 [label="前些天我在圣所里擦拭所有的吊灯，洛德先生恳求我停手。",shape=box,color=blue];
		j3674771282 -> j3876688828;
	j3797665311 [label="这很难解释，但我会尽力解释。Mes pieds，oui ？是关于我的脚。血清改变了我，让我可以飞翔——",shape=box,color=blue];
		j3797665311 -> j3714194948;
	j2487056134 [label="Par les Luminaires，我真的很抱歉。那么你明白那是什么感受，oui ？",shape=box,color=blue];
		j2487056134 -> j521758867;
	j4108207830 [label="Oui ！哦，前些天我在圣所里擦拭所有的吊灯，洛德先生恳求我停手。",shape=box,color=blue];
		j4108207830 -> j2371821466;
	j1480977500 [label="但就像你说的，non ？所有像我们这样的不便之处都蕴藏着一种隐秘力量。我们只需去发现它们。",shape=box,color=blue];
		j1480977500 -> j2779841988;
	j1326666492 [label="Oui，我懂你的沮丧。我时常坐在那里，盯着着书架顶端的一本书，想着自己够不着它，多么不公平啊。",shape=box,color=blue];
		j1326666492 -> j1037821876;
	j1975738273 [label="Oui ！！哦，你确实明白 ！！Par exemple——",shape=box,color=blue];
		j1975738273 -> j1445120367;
	j2004108057 [label="你知道当其他人可以行走，但你却只能 jour après jour, heure après heure 地被迫漂浮有多累吗？",shape=box,color=blue];
		j2004108057 -> j2906073018;
	j1187753878 [label="但确实，这令人沮丧。我时常坐在那里，盯着着书架顶端的一本书，想着自己够不着它，多么不公平啊。",shape=box,color=blue];
		j1187753878 -> j1105954743;
	j1105954743 [label="它承载着我珍视的知识，其他人都不在意，为什么我却被剥夺 ？然后总会有热心人出于怜悯，帮我从高处取过来……",shape=box,color=blue];
		j1105954743 -> j2074927269;
	j3876688828 [label="我告诉他我需要让自己忙起来，需要让双手不停地动。我认为他不太理解我为何必须如此活跃。",shape=box,color=blue];
		j3876688828 -> j3076233152;
	j3714194948 [label="但我仍然能感觉到它们，那些扭曲的东西威胁着要吞噬我，威胁着要粉碎我灵魂中的所有希望和欢乐。",shape=box,color=blue];
		j3714194948 -> j2989294185;
	j521758867 [label="拥有一具背叛你的身体，它拖慢你的精神。即使是现在，这感觉也如此奇怪。血清改变了我，给了我飞翔的能力——",shape=box,color=blue];
		j521758867 -> j3940693432;
	j2371821466 [label="我告诉他我需要让自己忙起来，需要让双手不停地动。我认为他不太理解我为何必须如此活跃。",shape=box,color=blue];
		j2371821466 -> j318239984;
	j2779841988 [label="但我懂你的沮丧。哦，我深有体会。我时常坐在那里，盯着着书架顶端的一本书，想着自己够不着它，多么不公平啊。",shape=box,color=blue];
		j2779841988 -> j1037821876;
	j1037821876 [label="它承载着我珍视的知识，其他人都不在意，为什么我却被剥夺 ？然后总会有热心人出于怜悯，帮我从高处取过来……",shape=box,color=blue];
		j1037821876 -> j995509756;
		j1037821876 -> j590561460;
	j1445120367 [label="你知道当其他人可以行走，但你却只能 jour après jour, heure après heure 地被迫漂浮有多累吗？",shape=box,color=blue];
		j1445120367 -> j2165530254;
	j2906073018 [label="我很 ravie 能如此灵活自如，随心所欲到达任何我想去的地方，别误会我的意思。可这依然会疲惫不堪 ！",shape=box,color=blue];
		j2906073018 -> j3076233152;
	j2074927269 [label="这不是他们的问题，因为他们是在行善——我也确实需要帮助。而我需要帮助也并非他们的错。但是，哦，需要这种帮助是多么令人沮丧啊。",shape=box,color=blue];
		j2074927269 -> j2795477782;
		j2074927269 -> j2560814446;
	j3076233152 [label="能倾诉这一切……真是太好了。我实在难以言表。能讨论这种无形无声的瘟疫、我所承受的折磨，实在太难得了。",shape=box,color=blue];
		j3076233152 -> j1349670506;
	j2989294185 [label="它们还是很痛。一直都是。即使现在，我坐在这里，只要一想到它们，我就会感到疼痛。只是并不总是强烈到我会注意。",shape=box,color=blue];
		j2989294185 -> j2208593831;
		j2989294185 -> j965038964;
	j3940693432 [label="但我仍然能感觉到它们，那些扭曲的东西威胁着要吞噬我，威胁着要粉碎我灵魂中的所有希望和欢乐。",shape=box,color=blue];
		j3940693432 -> j4080118191;
	j318239984 [label="啊，知道这里有人能体会这种感受，我便感到无比欣慰。这实在太难得了。我们承受着这场无声无息的瘟疫。",shape=box,color=blue];
		j318239984 -> j307337633;
	j995509756 [label="那有什么问题吗？",shape=box,color=red];
		j995509756 -> j4039219535;
	j590561460 [label="是啊。我明白。而且这也不是他们的错。",shape=box,color=red];
		j590561460 -> j3798684727;
	j2165530254 [label="我很 ravie 能如此灵活自如，随心所欲到达任何我想去的地方，别误会我的意思。可这依然会疲惫不堪 ！！",shape=box,color=blue];
		j2165530254 -> j318239984;
	j2795477782 [label="很抱歉你不得不忍受这一切。 ",shape=box,color=red];
		j2795477782 -> j3726953581;
	j2560814446 [label="而你甚至无法表达那种沮丧。",shape=box,color=red];
		j2560814446 -> j3726953581;
	j1349670506 [label="就像一只小 abeille 停驻在我的肩头，日日蜇我。虽不足以致命，却足以惹人烦。",shape=box,color=blue];
		j1349670506 -> j1569726905;
		j1349670506 -> j786401463;
	j4080118191 [label="它们还是很痛。一直都是。即使现在，我坐在这里，只要一想到它们，我就会感到疼痛。只是并不总是强烈到我会注意。",shape=box,color=blue];
		j4080118191 -> j1041435290;
		j4080118191 -> j3848614734;
	j307337633 [label="就像一只小 abeille 停驻在我们身上，日日蜇我们。虽不足以致命，却足以让我们感到烦躁。",shape=box,color=blue];
		j307337633 -> j786401463;
		j307337633 -> j1569726905;
	j4039219535 [label="没问题 ！没什么不对。我确实需要帮助。但这就是问题的根源——我需要帮助。正如你所说……这令人沮丧。",shape=box,color=blue];
		j4039219535 -> j1132239877;
	j3798684727 [label="Oui ！这不是他们的问题，因为他们是在行善——我也确实需要帮助。而我需要帮助也并非他们的错。但是，哦，需要这种帮助是多么令人沮丧啊。",shape=box,color=blue];
		j3798684727 -> j1132239877;
	j3726953581 [label="+10 Chemistry",color=orange];
		j3726953581 -> j3076233152;
	j1569726905 [label="唉，真希望它能消失……",shape=box,color=red];
		j1569726905 -> j1015694833;
	j786401463 [label="什么是“abeille”？",shape=box,color=red];
		j786401463 -> j1519621878;
	j1132239877 [label="+5 Chemistry",color=orange];
		j1132239877 -> j318239984;
	j1015694833 [label="我也是 ！但同样地，这也成为了我们自身的一部分，non ？我们凭什么说我们身上的哪些部分重要，哪些部分不重要呢 ？",shape=box,color=blue];
		j1015694833 -> j2427033551;
	j1519621878 [label="哦 ！一个小家伙，黄黑相间，身上有条纹， derrière 上还带根针……它还会产蜜 ？",shape=box,color=blue];
		j1519621878 -> j1301935320;
		j1519621878 -> j1968228449;
	j2427033551 [label="Evaluate expressions",color=orange];
