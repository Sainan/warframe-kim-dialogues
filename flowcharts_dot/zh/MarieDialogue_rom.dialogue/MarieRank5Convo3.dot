		2857 -> 2866;
	2850 [label="你知道当其他人可以行走，但你却只能 jour après jour, heure après heure 地被迫漂浮有多累吗？",shape=box,color=blue];
		2850 -> 2860;
	2851 [label="但确实，这令人沮丧。我时常坐在那里，盯着着书架顶端的一本书，想着自己够不着它，多么不公平啊。",shape=box,color=blue];
		2851 -> 2852;
	2852 [label="它承载着我珍视的知识，其他人都不在意，为什么我却被剥夺 ？然后总会有热心人出于怜悯，帮我从高处取过来……",shape=box,color=blue];
		2852 -> 2861;
	2853 [label="我告诉他我需要让自己忙起来，需要让双手不停地动。我认为他不太理解我为何必须如此活跃。",shape=box,color=blue];
		2853 -> 2862;
	2858 [label="但我仍然能感觉到它们，那些扭曲的东西威胁着要吞噬我，威胁着要粉碎我灵魂中的所有希望和欢乐。",shape=box,color=blue];
		2858 -> 2867;
	2859 [label="拥有一具背叛你的身体，它拖慢你的精神。即使是现在，这感觉也如此奇怪。血清改变了我，给了我飞翔的能力——",shape=box,color=blue];
		2859 -> 2868;
	2863 [label="我告诉他我需要让自己忙起来，需要让双手不停地动。我认为他不太理解我为何必须如此活跃。",shape=box,color=blue];
		2863 -> 2872;
	2864 [label="但我懂你的沮丧。哦，我深有体会。我时常坐在那里，盯着着书架顶端的一本书，想着自己够不着它，多么不公平啊。",shape=box,color=blue];
		2864 -> 2865;
	2865 [label="它承载着我珍视的知识，其他人都不在意，为什么我却被剥夺 ？然后总会有热心人出于怜悯，帮我从高处取过来……",shape=box,color=blue];
		2865 -> 2873;
		2865 -> 2874;
	2866 [label="你知道当其他人可以行走，但你却只能 jour après jour, heure après heure 地被迫漂浮有多累吗？",shape=box,color=blue];
		2866 -> 2875;
	2860 [label="我很 ravie 能如此灵活自如，随心所欲到达任何我想去的地方，别误会我的意思。可这依然会疲惫不堪 ！",shape=box,color=blue];
		2860 -> 2862;
	2861 [label="这不是他们的问题，因为他们是在行善——我也确实需要帮助。而我需要帮助也并非他们的错。但是，哦，需要这种帮助是多么令人沮丧啊。",shape=box,color=blue];
		2861 -> 2869;
		2861 -> 2870;
	2862 [label="能倾诉这一切……真是太好了。我实在难以言表。能讨论这种无形无声的瘟疫、我所承受的折磨，实在太难得了。",shape=box,color=blue];
		2862 -> 2871;
	2867 [label="它们还是很痛。一直都是。即使现在，我坐在这里，只要一想到它们，我就会感到疼痛。只是并不总是强烈到我会注意。",shape=box,color=blue];
		2867 -> 2811;
		2867 -> 2810;
	2868 [label="但我仍然能感觉到它们，那些扭曲的东西威胁着要吞噬我，威胁着要粉碎我灵魂中的所有希望和欢乐。",shape=box,color=blue];
		2868 -> 2876;
	2872 [label="啊，知道这里有人能体会这种感受，我便感到无比欣慰。这实在太难得了。我们承受着这场无声无息的瘟疫。",shape=box,color=blue];
		2872 -> 2880;
	2873 [label="那有什么问题吗？",shape=box,color=red];
		2873 -> 2881;
	2874 [label="是啊。我明白。而且这也不是他们的错。",shape=box,color=red];
		2874 -> 2882;
	2875 [label="我很 ravie 能如此灵活自如，随心所欲到达任何我想去的地方，别误会我的意思。可这依然会疲惫不堪 ！！",shape=box,color=blue];
		2875 -> 2872;
	2869 [label="很抱歉你不得不忍受这一切。 ",shape=box,color=red];
		2869 -> 2877;
	2870 [label="而你甚至无法表达那种沮丧。",shape=box,color=red];
		2870 -> 2877;
	2871 [label="就像一只小 abeille 停驻在我的肩头，日日蜇我。虽不足以致命，却足以惹人烦。",shape=box,color=blue];
		2871 -> 2878;
		2871 -> 2879;
	2876 [label="它们还是很痛。一直都是。即使现在，我坐在这里，只要一想到它们，我就会感到疼痛。只是并不总是强烈到我会注意。",shape=box,color=blue];
		2876 -> 2813;
		2876 -> 2812;
	2880 [label="就像一只小 abeille 停驻在我们身上，日日蜇我们。虽不足以致命，却足以让我们感到烦躁。",shape=box,color=blue];
		2880 -> 2879;
		2880 -> 2878;
	2881 [label="没问题 ！没什么不对。我确实需要帮助。但这就是问题的根源——我需要帮助。正如你所说……这令人沮丧。",shape=box,color=blue];
		2881 -> 2885;
	2882 [label="Oui ！这不是他们的问题，因为他们是在行善——我也确实需要帮助。而我需要帮助也并非他们的错。但是，哦，需要这种帮助是多么令人沮丧啊。",shape=box,color=blue];
		2882 -> 2885;
