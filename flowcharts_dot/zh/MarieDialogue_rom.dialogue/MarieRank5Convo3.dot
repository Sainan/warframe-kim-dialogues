	2825 [label="哈！有趣吧，现实就是这样，non ？你说得对。我原本没在想 mes pieds，但现在想起来了，现在它们疼了。 ",shape=box,color=blue];
		2825 -> 2834;
	2826 [label="Oui ！你现在跟我聊天就是在帮我了。心灵真是奇妙的存在，不是吗 ？Mes pieds 肯定时刻都在疼痛，而我却学会了全然无视它们。",shape=box,color=blue];
