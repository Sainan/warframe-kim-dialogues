		j2716662205 -> j2213390618 [label=true,color=green];
		j2716662205 -> j4016267746 [label=false,color=brown];
	j4275614665 [label="Non……永远不会。我只能转移注意力，比如像这样聊天。或者让自己忙起来。",shape=box,color=blue];
		j4275614665 -> j3674771282;
	j1755849366 [label="你真是太好了，而且……好吧。​我​又​变回​那个​有点​固执​的​玛丽​了。",shape=box,color=blue];
