		2844 -> 2853;
	2848 [label="这很难解释，但我会尽力解释。Mes pieds，oui ？是关于我的脚。血清改变了我，让我可以飞翔——",shape=box,color=blue];
		2848 -> 2858;
	2849 [label="Par les Luminaires，我真的很抱歉。那么你明白那是什么感受，oui ？",shape=box,color=blue];
		2849 -> 2859;
	2854 [label="Oui ！哦，前些天我在圣所里擦拭所有的吊灯，洛德先生恳求我停手。",shape=box,color=blue];
