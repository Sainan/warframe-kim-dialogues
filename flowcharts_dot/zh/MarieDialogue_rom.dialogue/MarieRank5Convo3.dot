		2887 -> 2899;
	2888 [label="不，没明白……继续说。",shape=box,color=red];
		2888 -> 2900;
	2892 [label="我不想谈论信仰，只是想说……纵然我们从这有限的视角出发，难免认为自身存在缺陷，但我们必须……与自己和解，non ？这是我们所能拥有的一切。",shape=box,color=blue];
		2892 -> 2901;
	2891 [label="我知道我们的信仰形式相似，所以我想说……太阳神认为应当将我塑造成现在的模样。我理应相信他的安排，non ？纵使以我有限的视角来看，这似乎也存在缺陷。不知道你是不是也以同样方式看待你的信仰。",shape=box,color=blue];
		2891 -> 2901;
	2893 [label="我知道我们的信仰形式不同，所以我不会在不了解的情况下妄加评论。但我只是想说太阳神认为应当将我塑造成现在的模样。我理应相信他的安排，non ？纵使以我有限的视角来看，这似乎也存在缺陷。不知道你是不是也以同样方式看待你的信仰。",shape=box,color=blue];
		2893 -> 2901;
	2894 [label="我知道信仰是你的私事，所以我不会多问。但我只是想说太阳神认为应当将我塑造成现在的模样。我理应相信他的安排，non ？纵使以我有限的视角来看，这似乎也存在缺陷。不知道你是不是也以同样方式看待你的信仰。",shape=box,color=blue];
		2894 -> 2901;
	2898 [label="太阳神将我们塑造成如今这个样子，我们理应相信他的安排，non ？纵使以我们有限的视角来看，这似乎也存在缺陷。",shape=box,color=blue];
		2898 -> 2901;
	2889 [label="月神认为应当将你塑造成现在的模样，而太阳神认为应当将我塑造成现在的模样。我们理应相信他们的安排，non ？纵使以我们有限的视角来看，这似乎也存在缺陷。",shape=box,color=blue];
		2889 -> 2901;
	2890 [label="双耀神将我们塑造成如今这个样子，我们理应相信他的安排，non ？纵使以我们有限的视角来看，这似乎也存在缺陷。",shape=box,color=blue];
		2890 -> 2901;
	2895 [label="我知道你坚信我们无人能知晓宇宙的真谛，对此我深表赞赏与尊重。但我只想说，太阳神认为应当将我塑造成现在的模样。我理应相信他的安排，non ？纵使以我有限的视角来看，这似乎也存在缺陷。",shape=box,color=blue];
		2895 -> 2901;
	2896 [label="我知道你没有自己的信仰，我尊重这一点。但我只想说，太阳神认为应当将我塑造成现在的模样。我理应相信他的安排，non ？纵使以我有限的视角来看，这似乎也存在缺陷。",shape=box,color=blue];
		2896 -> 2901;
	2897 [label="我只想说，太阳神认为应当将我塑造成现在的模样。我理应相信他的安排，non ？纵使以我有限的视角来看，这似乎也存在缺陷。",shape=box,color=blue];
		2897 -> 2901;
