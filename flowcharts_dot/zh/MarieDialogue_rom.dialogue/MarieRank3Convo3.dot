		j971302504 -> j2566525509 [label=false,color=brown];
		j971302504 -> j2472642555 [label=false,color=brown];
		j971302504 -> j1038552372 [label=false,color=brown];
	j3850509312 [label="你能跟我详细讲讲在英择谛到来之前，住在大教堂里是什么样的吗？",shape=box,color=red];
		j3850509312 -> j3777683664;
	j2472642555 [label="玛丽，你在哪里长大？",shape=box,color=red];
		j2472642555 -> j2349464574;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j2566525509 [label="在英择谛出现之前，你在大教堂的生活是什么样的？",shape=box,color=red];
		j2566525509 -> j2305651024;
	j3777683664 [label="我想，那时候其实真的很孤独。虽然里昂在，但你知道他有时候是什么样的。（哦 ！我很高兴你和他现在说上话了 ！）",shape=box,color=blue];
		j3777683664 -> j2238093574;
	j2349464574 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j2349464574 -> j1789931501;
	"Chat ends." [color=orange];
	j2305651024 [label="哦，没想到这会让你那么感兴趣，但如果你很好奇，我还是会告诉你。 ",shape=box,color=blue];
		j2305651024 -> j2167287573;
	j2238093574 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j2238093574 -> j3983622967;
	j1789931501 [label="我本来以为我说的话已经透露了我的所在，但随即我想起你并不来自我所知道的世界，哈哈 ！",shape=box,color=blue];
		j1789931501 -> j2246222674;
	j2167287573 [label="我​把​时间​都​用​来​履行​我​作为​太阳神​修女​的​职责​了，​擦​干​净圣餐器皿，​为​教友​准备​奉​献物。​",shape=box,color=blue];
		j2167287573 -> j3764244574;
	j3983622967 [label="但这并不是我花这么多时间与死者交谈的原因。",shape=box,color=blue];
		j3983622967 -> j2631465746;
	j2246222674 [label="我来自 la Cité de la Lumière，是高卢国的首都。从世界地图上看，它离霍瓦尼亚并不远。",shape=box,color=blue];
		j2246222674 -> j1436012452;
	j3764244574 [label="照料墓穴和墓地。那是我最喜欢的工作。",shape=box,color=blue];
		j3764244574 -> j3561579894;
		j3764244574 -> j3723651104;
	j2631465746 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j2631465746 -> j3302234775;
	j1436012452 [label="我想知道我的 Cathédrale 在 1999 年是否还在？真是个有趣的想法 ！",shape=box,color=blue];
		j1436012452 -> j1193223552;
		j1436012452 -> j1492577509;
	j3561579894 [label="为什么它是你最喜欢的？",shape=box,color=red];
		j3561579894 -> j602364526;
	j3723651104 [label="不好意思。能再说说最后一句吗？",shape=box,color=red];
		j3723651104 -> j1019111139;
	j3302234775 [label="那些地方有一种美，一种 tranquillité。那里如此安静，如此平和。",shape=box,color=blue];
		j3302234775 -> j2804303006;
	j1193223552 [label="你又跑题了，是吧？",shape=box,color=red];
		j1193223552 -> j2497515004;
	j1492577509 [label="我或许可以问问我另外两个朋友，他们旅行经历很丰富。我记得他们甚至提到过他们去过那座城市。",shape=box,color=red];
		j1492577509 -> j2694149102;
	j602364526 [label="我很喜欢和那些已经安息的人交谈。他们会倾听我的担忧，并且不会对我评头论足。",shape=box,color=blue];
		j602364526 -> j3865734343;
	j1019111139 [label="我的职责是照顾 Cathédrale 里的死者。我会清扫墓穴地板上的灰尘，除去院子里的杂草。",shape=box,color=blue];
		j1019111139 -> j602364526;
	j2804303006 [label="我想我喜欢告诉他们我的烦恼和 et les activités des autres，因为他们的烦恼已经结束了，oui ？",shape=box,color=blue];
		j2804303006 -> j963808641;
	j2497515004 [label="+5 Chemistry",color=orange];
		j2497515004 -> j4267181061;
	j2694149102 [label="+5 Chemistry",color=orange];
		j2694149102 -> j4123260427;
	j3865734343 [label="好吧，其实他们一句话也没回应，mais cela me convenait tout à fait ！我宁愿他们保持沉默。",shape=box,color=blue];
		j3865734343 -> j319800146;
	j963808641 [label="现在对他们来说一切都是小事，这让我感到安慰。",shape=box,color=blue];
		j963808641 -> j1035898543;
		j963808641 -> j1055372419;
		j963808641 -> j453934336;
	j4267181061 [label="被你发现了，oui ？里昂总是笑我，说我是阳光下的一粒微尘，随风飘荡。（我真高兴你和他现在能说上话了 ！）",shape=box,color=blue];
		j4267181061 -> j1474900646;
	j4123260427 [label="哦，还是别打扰他们了，这只是个愚蠢的想法。一想到它消失了，我真不知道自己会有多难过。",shape=box,color=blue];
		j4123260427 -> j1474900646;
	j319800146 [label="+5 Chemistry",color=orange];
		j319800146 -> j2724663957;
	j1035898543 [label="我不知道，我……害怕真正死去，我从来都不喜欢与死亡为伴。",shape=box,color=red];
		j1035898543 -> j1517375713;
	j1055372419 [label="我从来没有从这种角度想过。",shape=box,color=red];
		j1055372419 -> j2952281275;
	j453934336 [label="我在墓地和公墓里也找到了同样的平静感。我完全能理解你。",shape=box,color=red];
		j453934336 -> j2505085262;
	j1474900646 [label="我只是好奇，non ？我想知道 tout ce qui existe——世间的一切。我想这就是我和主教命中注定相遇的原因。",shape=box,color=blue];
		j1474900646 -> j1162912476;
	j2724663957 [label="想象一下 ？会说话的骷髅，就像你的殁世械灵一样 ？哈 ！",shape=box,color=blue];
		j2724663957 -> j1816203271;
		j2724663957 -> j2506529137;
	j1517375713 [label="我明白，morbide 玛丽 ！真奇怪。不过每个人都有自己的想法，不是吗 ？",shape=box,color=blue];
		j1517375713 -> j4160420556;
	j2952281275 [label="不只有你是这样。我们都不喜欢花太多时间去思考接下来会发生什么。除非我们快要接近死亡了。",shape=box,color=blue];
		j2952281275 -> j450789175;
	j2505085262 [label="我很高兴你能理解 ！",shape=box,color=blue];
		j2505085262 -> j450789175;
	j1162912476 [label="Où en étais-je ？啊 ！Oui。继续我的故事。",shape=box,color=blue];
		j1162912476 -> j2336988355;
	j1816203271 [label="考虑到你坐着轮椅，这不可能是最简单的工作。",shape=box,color=red];
		j1816203271 -> j1955366669;
	j2506529137 [label="你没有其他朋友可以聊天吗 ？",shape=box,color=red];
		j2506529137 -> j2331711146;
	j4160420556 [label="总得有人照顾他们。而我很乐意。",shape=box,color=blue];
		j4160420556 -> j450789175;
	j450789175 [label="里昂总开玩笑说我太贴近地面，所以才老想着坟墓。",shape=box,color=blue];
		j450789175 -> j2970098046;
	j2336988355 [label="我出生在一个富裕的家庭，这可能会让你感到意外。资产阶级，离奥罗金挺近的那种。",shape=box,color=blue];
		j2336988355 -> j4201561439;
	j1955366669 [label="Non，确实不是。不过，里昂会在特定时间帮我过墓穴的楼梯，剩下的事我可以自己慢慢处理。",shape=box,color=blue];
		j1955366669 -> j2965375497;
	j2331711146 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j2331711146 -> j2466566831;
	j2970098046 [label=" 我就问他，是不是脑袋里空空的，所以才被一堆鬼魂塞满。",shape=box,color=blue];
		j2970098046 -> j3943636033;
	j4201561439 [label="然而我一出生就是个……畸形的孩子，mes pieds tordus et inutilisables ？哦，ma mère 无法接受。",shape=box,color=blue];
		j4201561439 -> j2217515859;
	j2965375497 [label="一个人凭借固执能做到的事，是很不得了的，oui ？",shape=box,color=blue];
		j2965375497 -> j1605180878;
	j2466566831 [label="当然，我有里昂。不过你也知道，他的情况有时候会发展成什么样。",shape=box,color=blue];
		j2466566831 -> j2631465746;
	j3943636033 [label="然后他会威胁要把我推下山，而我会威胁要用荨麻塞满他的哥萨克服。",shape=box,color=blue];
		j3943636033 -> j3821110915;
	j2217515859 [label="毕竟要维护家族的体面与规矩，oui ？",shape=box,color=blue];
		j2217515859 -> j712227013;
	j1605180878 [label="好吧。是固执和上肢力量，哈哈 ！",shape=box,color=blue];
		j1605180878 -> j2630576945;
	j3821110915 [label="La famille。",shape=box,color=blue];
		j3821110915 -> j1177185501;
		j3821110915 -> j2607204943;
		j3821110915 -> j3915067337;
		j3821110915 -> j708470595;
	j712227013 [label="那么，那个可怜的畸形玛丽该怎么处置呢 ？我被带到了 la Cité de la Lumière，我本该会死在那里……",shape=box,color=blue];
		j712227013 -> j3962930975;
	j2630576945 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j2630576945 -> j2631465746;
	j1177185501 [label="我很抱歉英择谛打乱了你的一切。",shape=box,color=red];
		j1177185501 -> j2691414192;
	j2607204943 [label="我很高兴你们俩有彼此。",shape=box,color=red];
		j2607204943 -> j1691437427;
	j3915067337 [label="你们两个真会逗我笑。",shape=box,color=red];
		j3915067337 -> j473951094;
	j708470595 [label="所以你和他……从来没有谈过恋爱？",shape=box,color=red];
		j708470595 -> j1938341551;
	j3962930975 [label="被抛弃在那，等死。",shape=box,color=blue];
		j3962930975 -> j4002906590;
		j3962930975 -> j398269391;
	j2691414192 [label="+10 Chemistry",color=orange];
		j2691414192 -> j2615271939;
	j1691437427 [label="+20 Chemistry",color=orange];
		j1691437427 -> j3562916477;
	j473951094 [label="+20 Chemistry",color=orange];
		j473951094 -> j2345320175;
	j1938341551 [label="哦，天 ！Non ！他就像我的亲兄弟一样，只是我们没有血缘关系。光是想到这一点，我就 complètement dégoûtée by the very notion ！",shape=box,color=blue];
		j1938341551 -> j2762541889;
		j1938341551 -> j2035265010;
	j4002906590 [label="你的家人就这么放任你去死 ？",shape=box,color=red];
		j4002906590 -> j1239886202;
	j398269391 [label="你当时多大 ？",shape=box,color=red];
		j398269391 -> j1672564882;
	j2615271939 [label="英择谛并没有打乱什么。里昂和我依然坚强如初。只是一切都变了，non ？",shape=box,color=blue];
		j2615271939 -> j257404273;
	j3562916477 [label="没有他，我哪儿也去不了。或许，除了山脚下。哈哈 ！",shape=box,color=blue];
		j3562916477 -> j1039562055;
	j2345320175 [label="他​总是​用​最​奇怪​的​方式​逗​我​笑。​不过​狼，​我​发现，​你​也​一样。​我​觉得​自己​在​这里​越来越​快乐​了。​",shape=box,color=blue];
		j2345320175 -> j294992249;
	j2762541889 [label="我只是好奇而已。",shape=box,color=red];
		j2762541889 -> j3385888755;
	j2035265010 [label="我承认，我有点松了口气。",shape=box,color=red];
		j2035265010 -> j1335227973;
	j1239886202 [label="在他们眼里，他们觉得多年来已经竭尽全力地帮助我了。他们请家教教我走路，给我戴上支架，给我穿鞋。",shape=box,color=blue];
		j1239886202 -> j3646394411;
	j1672564882 [label="六岁 ？七岁 ？在他们眼里，他们觉得多年来已经竭尽全力地帮助我了。他们请家教教我走路，给我戴上支架，给我穿鞋。",shape=box,color=blue];
		j1672564882 -> j3646394411;
	j257404273 [label="月球瞬息万变。即便太阳的运行轨迹恒定，也是会受到其影响的。",shape=box,color=blue];
		j257404273 -> j679295143;
	j1039562055 [label="他​真的​是​我​灵魂​兄弟。​我​觉得​自己​在​这里​越来越​快乐​了。​",shape=box,color=blue];
		j1039562055 -> j294992249;
	j294992249 [label="我只希望他也能很快发现这一点……但恶魔总用他的低语和谎言困扰着他。",shape=box,color=blue];
		j294992249 -> j1501712741;
	j3385888755 [label="+10 Chemistry",color=orange];
		j3385888755 -> j1930259134;
	j1335227973 [label="Check boolean DrifterMarie",color=orange];
		j1335227973 -> j4030768152 [label=true,color=green];
		j1335227973 -> j2475485514 [label=false,color=brown];
	j3646394411 [label="他们厌倦了这种负担。于是，在我连数字和字母都不太会读写的时候，我被丢进了泥地里。",shape=box,color=blue];
		j3646394411 -> j3042054520;
		j3646394411 -> j4101960403;
	j679295143 [label="狼，我们不能固执己见，否则会被它们摧毁。再说，我觉得自己在这里越来越快乐了。",shape=box,color=blue];
		j679295143 -> j294992249;
	j1501712741 [label="呸 ！一提到他，他就喊我。我得走了。",shape=box,color=blue];
		j1501712741 -> "Chat ends.";
	j1930259134 [label="Check boolean DrifterMarie",color=orange];
		j1930259134 -> j3391818763 [label=true,color=green];
		j1930259134 -> j1929402502 [label=false,color=brown];
	j4030768152 [label="Oui，你已经表明了你的意图。我必须警告你，我不会抛弃他。我认识里昂的时间比你长得多。",shape=box,color=blue];
		j4030768152 -> j1929402502;
	j2475485514 [label="Oui ？那你打算狩猎我们中的哪一个呢 ？",shape=box,color=blue];
		j2475485514 -> j2368085404;
		j2475485514 -> j3249907368;
	j3042054520 [label="你是怎么活下来的 ？",shape=box,color=red];
		j3042054520 -> j251854413;
	j4101960403 [label="这太可怕了。",shape=box,color=red];
		j4101960403 -> j251854413;
	j3391818763 [label="Oui。只是“好奇”而已。别想骗我。我必须警告你，我不会抛弃他。我认识里昂的时间比你长得多。",shape=box,color=blue];
		j3391818763 -> j1929402502;
	j1929402502 [label="+20 Chemistry",color=orange];
		j1929402502 -> j2815197738;
	j2368085404 [label="你。",shape=box,color=red];
		j2368085404 -> j341708646;
	j3249907368 [label="里昂。",shape=box,color=red];
		j3249907368 -> j366167548;
	j251854413 [label="Check boolean MarieSecretPower",color=orange];
		j251854413 -> j1943702321 [label=true,color=green];
		j251854413 -> j3229924902 [label=false,color=brown];
	j2815197738 [label="没有他，我真不知道该怎么办。或许，除了躲到山脚下之外，什么都做不了。哈哈！",shape=box,color=blue];
		j2815197738 -> j919246417;
	j341708646 [label="Boolean DrifterMarie is now true.",color=orange];
		j341708646 -> j1246866234;
	j366167548 [label="Vraiment ？！",shape=box,color=blue];
		j366167548 -> j2161347534;
	j1943702321 [label="就像你说的，non ？不便之处都蕴藏着一种隐秘力量。",shape=box,color=blue];
		j1943702321 -> j3229924902;
	j3229924902 [label="我在 ma mère 眼里是 une indésirable 的，但我在街头孩子的眼里却很受欢迎。",shape=box,color=blue];
		j3229924902 -> j755335063;
	j919246417 [label="不过，狼，你还是让我很感兴趣。我发现自己越来越喜欢待在这里。",shape=box,color=blue];
		j919246417 -> j294992249;
	j1246866234 [label="+10 Chemistry",color=orange];
		j1246866234 -> j2134378773;
	j2161347534 [label="+10 Chemistry",color=orange];
		j2161347534 -> j1835556258;
	j755335063 [label="还有什么比一个没有脚的孩子更可悲呢，oui ？我张开手掌，一天赚的钱比他们一周抢的还多。",shape=box,color=blue];
		j755335063 -> j1386062065;
	j2134378773 [label="哦！太阳神啊。说实话，你真是让我措手不及。现在我正脸红着坐在这里，躲着洛德先生……",shape=box,color=blue];
		j2134378773 -> j3801489677;
	j1835556258 [label="你不知道这让我有多高兴，但请你三思而后行。",shape=box,color=blue];
		j1835556258 -> j1853871625;
	j1386062065 [label="正是因为这样，让我才会在街头被太阳神的 les Sœurs 发现。她们提出收留我。",shape=box,color=blue];
		j1386062065 -> j2149488093;
		j1386062065 -> j2484243727;
	j3801489677 [label="我必须警告你，我不会抛弃他。我认识里昂的时间比你长得多。",shape=box,color=blue];
		j3801489677 -> j1233545876;
	j1853871625 [label="Boolean DrifterLyon is now true.",color=orange];
		j1853871625 -> j4106224932;
	j2149488093 [label="那其他的孩子呢 ？",shape=box,color=red];
		j2149488093 -> j2495945105;
	j2484243727 [label="显然，你答应了。",shape=box,color=red];
		j2484243727 -> j1274603316;
	j1233545876 [label="+10 Chemistry",color=orange];
		j1233545876 -> j294992249;
	j4106224932 [label="里昂是我的兄弟。我爱他胜过你所能想象，但他是个饱受折磨的人。在你追他之前，请务必三思，n'est-ce pas ？",shape=box,color=blue];
		j4106224932 -> j3675606689;
	j2495945105 [label="+5 Chemistry",color=orange];
		j2495945105 -> j1757337332;
	j1274603316 [label="Oui，我能怎么办 ？我病倒是迟早的事。即便当时我还只是个孩子，我也明白。",shape=box,color=blue];
		j1274603316 -> j1343180210;
		j1274603316 -> j3971562950;
	j3675606689 [label="我想我们很快还会再谈这件事。别误会，我是在鼓励你 ！我只是希望你好好想想。",shape=box,color=blue];
		j3675606689 -> j1233545876;
	j1757337332 [label="你真是个好心人。显然，她们不可能把他们都带走……但我没有忘记我的朋友们。",shape=box,color=blue];
		j1757337332 -> j3766060501;
	j1343180210 [label="那些修女是什么样的 ？",shape=box,color=red];
		j1343180210 -> j867386695;
	j3971562950 [label="那你是如何适应大教堂的生活的 ？",shape=box,color=red];
		j3971562950 -> j3237638331;
	j3766060501 [label="我每周都会带着我的工资，和从厨房或其他地方收集到的剩饭回来。",shape=box,color=blue];
		j3766060501 -> j1330954504;
	j867386695 [label="Les Sœurs 对我非常好 ！不过我知道你肯定不这么想，non ？",shape=box,color=blue];
		j867386695 -> j3734277676;
	j3237638331 [label="我可太喜欢那里了 ！不过我知道你肯定不这么想，non ？",shape=box,color=blue];
		j3237638331 -> j3734277676;
	j1330954504 [label="只要我的朋友们还在，我就尽力照顾他们。许多人都死于 variole ou tuberculose……",shape=box,color=blue];
		j1330954504 -> j584111440;
	j3734277676 [label="一日三餐，一张温暖的床，一个栖身之所。我不再需要担心被打，被抢，或者更糟的事情发生 ？",shape=box,color=blue];
		j3734277676 -> j812783420;
	j584111440 [label="一些人搬走了，一些人死于战斗或暴力。大多数人找到了正当的工作，并逐渐成长起来。组建了自己的家庭。",shape=box,color=blue];
		j584111440 -> j915737290;
	j812783420 [label="我​受到​了​正规​的​教育。​学习​了​太阳神​和​月神​的​福音，​并​被​告知​要​凭​着​信心​找到​自己​的​道路。​如果​我​想​的话，​我​本​可以​离开。​",shape=box,color=blue];
		j812783420 -> j3124323324;
	j915737290 [label="还​有些​人​甚至会​顺便​去​ Cathédrale ​看​看​我。​这​让​我​心里​很​温暖。​",shape=box,color=blue];
		j915737290 -> j3124323324;
	j3124323324 [label="很长一段时间以来，我都感到内疚，因为只有我从街上被带走，而其他人却没有。直到今天，我有时仍然有这种感觉。",shape=box,color=blue];
		j3124323324 -> j1580094349;
		j3124323324 -> j694407261;
	j1580094349 [label="当我想起身边所有的人都死去了，而我却活了下来时，我也有同样的感受。但我们不能这样折磨自己。我们必须继续努力，争取让情况变得更好。",shape=box,color=red];
		j1580094349 -> j1086797701;
	j694407261 [label="你已经尽你所能去帮助其他人了。你曾被他人托举，而如今你有了机会，也在托举他人。",shape=box,color=red];
		j694407261 -> j2811858260;
	j1086797701 [label="难道这一切永远都会如此吗 ？一场战斗 ？一场对抗那想要淹没我们的浪潮的战争 ？",shape=box,color=blue];
		j1086797701 -> j2515494533;
	j2811858260 [label="Add 1 to Thermostat counter",color=orange];
		j2811858260 -> j2443217542;
	j2515494533 [label="Add -1 to Thermostat counter",color=orange];
		j2515494533 -> j3037922498;
	j2443217542 [label="+10 Chemistry",color=orange];
		j2443217542 -> j1436022901;
	j3037922498 [label="+10 Chemistry",color=orange];
		j3037922498 -> j4201838242;
	j1436022901 [label="Oui，正是如此。我曾被人托举上木筏，现在我也要去为他人这么做。 ",shape=box,color=blue];
		j1436022901 -> j4074174101;
	j4201838242 [label="但我懂你的意思。你的核心意思是不要放弃。我被赐予这些恩典，是为了成为他人的盾牌。",shape=box,color=blue];
		j4201838242 -> j4074174101;
	j4074174101 [label="Merci。不过现在我得走了。",shape=box,color=blue];
		j4074174101 -> "Chat ends.";
}