		1114 -> 1116 [label=false,color=brown];
		1114 -> 1117 [label=false,color=brown];
		1114 -> 1118 [label=false,color=brown];
	1115 [label="你能跟我详细讲讲在英择谛到来之前，住在大教堂里是什么样的吗？",shape=box,color=red];
		1115 -> 1119;
	1117 [label="玛丽，你在哪里长大？",shape=box,color=red];
		1117 -> 2425;
	1118 [label="[结束]",shape=box,color=red];
		1118 -> 1122;
	1116 [label="在英择谛出现之前，你在大教堂的生活是什么样的？",shape=box,color=red];
		1116 -> 1120;
	1119 [label="我想，那时候其实真的很孤独。虽然里昂在，但你知道他有时候是什么样的。（哦 ！我很高兴你和他现在说上话了 ！）",shape=box,color=blue];
		1119 -> 1123;
	2425 [label="Update boolean MarieBackstory1",color=orange];
		2425 -> 1121;
	1122 [label="Chat ends.",color=orange];
	1120 [label="哦，没想到这会让你那么感兴趣，但如果你很好奇，我还是会告诉你。 ",shape=box,color=blue];
		1120 -> 1124;
	1123 [label="Update boolean MarieGraveyard2",color=orange];
		1123 -> 1126;
	1121 [label="我本来以为我说的话已经透露了我的所在，但随即我想起你并不来自我所知道的世界，哈哈 ！",shape=box,color=blue];
		1121 -> 1125;
	1124 [label="我​把​时间​都​用​来​履行​我​作为​太阳神​修女​的​职责​了，​擦​干​净圣餐器皿，​为​教友​准备​奉​献物。​",shape=box,color=blue];
		1124 -> 1127;
	1126 [label="但这并不是我花这么多时间与死者交谈的原因。",shape=box,color=blue];
		1126 -> 1129;
	1125 [label="我来自 la Cité de la Lumière，是高卢国的首都。从世界地图上看，它离霍瓦尼亚并不远。",shape=box,color=blue];
		1125 -> 1128;
	1127 [label="照料墓穴和墓地。那是我最喜欢的工作。",shape=box,color=blue];
		1127 -> 1130;
		1127 -> 1131;
	1129 [label="Update boolean MarieGraveyard2",color=orange];
		1129 -> 1134;
	1128 [label="我想知道我的 Cathédrale 在 1999 年是否还在？真是个有趣的想法 ！",shape=box,color=blue];
		1128 -> 1132;
		1128 -> 1133;
	1130 [label="为什么它是你最喜欢的？",shape=box,color=red];
		1130 -> 1135;
	1131 [label="不好意思。能再说说最后一句吗？",shape=box,color=red];
		1131 -> 1136;
	1134 [label="那些地方有一种美，一种 tranquillité。那里如此安静，如此平和。",shape=box,color=blue];
		1134 -> 1139;
	1132 [label="你又跑题了，是吧？",shape=box,color=red];
		1132 -> 1137;
	1133 [label="我或许可以问问我另外两个朋友，他们旅行经历很丰富。我记得他们甚至提到过他们去过那座城市。",shape=box,color=red];
		1133 -> 1138;
	1135 [label="我很喜欢和那些已经安息的人交谈。他们会倾听我的担忧，并且不会对我评头论足。",shape=box,color=blue];
		1135 -> 1140;
	1136 [label="我的职责是照顾 Cathédrale 里的死者。我会清扫墓穴地板上的灰尘，除去院子里的杂草。",shape=box,color=blue];
		1136 -> 1135;
	1139 [label="我想我喜欢告诉他们我的烦恼和 et les activités des autres，因为他们的烦恼已经结束了，oui ？",shape=box,color=blue];
		1139 -> 1143;
	1137 [label="+5 Chemistry",color=orange];
		1137 -> 1141;
	1138 [label="+5 Chemistry",color=orange];
		1138 -> 1142;
	1140 [label="好吧，其实他们一句话也没回应，mais cela me convenait tout à fait ！我宁愿他们保持沉默。",shape=box,color=blue];
		1140 -> 1144;
	1143 [label="现在对他们来说一切都是小事，这让我感到安慰。",shape=box,color=blue];
		1143 -> 1146;
		1143 -> 1147;
		1143 -> 1148;
	1141 [label="被你发现了，oui ？里昂总是笑我，说我是阳光下的一粒微尘，随风飘荡。（我真高兴你和他现在能说上话了 ！）",shape=box,color=blue];
		1141 -> 1145;
	1142 [label="哦，还是别打扰他们了，这只是个愚蠢的想法。一想到它消失了，我真不知道自己会有多难过。",shape=box,color=blue];
		1142 -> 1145;
	1144 [label="+5 Chemistry",color=orange];
		1144 -> 1149;
	1146 [label="我不知道，我……害怕真正死去，我从来都不喜欢与死亡为伴。",shape=box,color=red];
		1146 -> 1151;
	1147 [label="我从来没有从这种角度想过。",shape=box,color=red];
		1147 -> 1152;
	1148 [label="我在墓地和公墓里也找到了同样的平静感。我完全能理解你。",shape=box,color=red];
		1148 -> 1153;
	1145 [label="我只是好奇，non ？我想知道 tout ce qui existe——世间的一切。我想这就是我和主教命中注定相遇的原因。",shape=box,color=blue];
		1145 -> 1150;
	1149 [label="想象一下 ？会说话的骷髅，就像你的殁世械灵一样 ？哈 ！",shape=box,color=blue];
		1149 -> 1154;
		1149 -> 1155;
	1151 [label="我明白，morbide 玛丽 ！真奇怪。不过每个人都有自己的想法，不是吗 ？",shape=box,color=blue];
		1151 -> 1157;
	1152 [label="不只有你是这样。我们都不喜欢花太多时间去思考接下来会发生什么。除非我们快要接近死亡了。",shape=box,color=blue];
		1152 -> 1158;
	1153 [label="我很高兴你能理解 ！",shape=box,color=blue];
		1153 -> 1158;
	1150 [label="Où en étais-je ？啊 ！Oui。继续我的故事。",shape=box,color=blue];
		1150 -> 1156;
	1154 [label="考虑到你坐着轮椅，这不可能是最简单的工作。",shape=box,color=red];
		1154 -> 1159;
	1155 [label="你没有其他朋友可以聊天吗 ？",shape=box,color=red];
		1155 -> 1160;
	1157 [label="总得有人照顾他们。而我很乐意。",shape=box,color=blue];
		1157 -> 1158;
	1158 [label="里昂总开玩笑说我太贴近地面，所以才老想着坟墓。",shape=box,color=blue];
		1158 -> 1162;
	1156 [label="我出生在一个富裕的家庭，这可能会让你感到意外。资产阶级，离奥罗金挺近的那种。",shape=box,color=blue];
		1156 -> 1161;
	1159 [label="Non，确实不是。不过，里昂会在特定时间帮我过墓穴的楼梯，剩下的事我可以自己慢慢处理。",shape=box,color=blue];
		1159 -> 1163;
	1160 [label="Update boolean MarieGraveyard1",color=orange];
		1160 -> 1164;
	1162 [label=" 我就问他，是不是脑袋里空空的，所以才被一堆鬼魂塞满。",shape=box,color=blue];
		1162 -> 1166;
	1161 [label="然而我一出生就是个……畸形的孩子，mes pieds tordus et inutilisables ？哦，ma mère 无法接受。",shape=box,color=blue];
		1161 -> 1165;
	1163 [label="一个人凭借固执能做到的事，是很不得了的，oui ？",shape=box,color=blue];
		1163 -> 1167;
	1164 [label="当然，我有里昂。不过你也知道，他的情况有时候会发展成什么样。",shape=box,color=blue];
		1164 -> 1129;
	1166 [label="然后他会威胁要把我推下山，而我会威胁要用荨麻塞满他的哥萨克服。",shape=box,color=blue];
		1166 -> 1169;
	1165 [label="毕竟要维护家族的体面与规矩，oui ？",shape=box,color=blue];
		1165 -> 1168;
	1167 [label="好吧。是固执和上肢力量，哈哈 ！",shape=box,color=blue];
		1167 -> 1170;
	1169 [label="La famille。",shape=box,color=blue];
		1169 -> 1172;
		1169 -> 1173;
		1169 -> 1174;
		1169 -> 3921;
	1168 [label="那么，那个可怜的畸形玛丽该怎么处置呢 ？我被带到了 la Cité de la Lumière，我本该会死在那里……",shape=box,color=blue];
		1168 -> 1171;
	1170 [label="Update boolean MarieGraveyard1",color=orange];
		1170 -> 1129;
	1172 [label="我很抱歉英择谛打乱了你的一切。",shape=box,color=red];
		1172 -> 1177;
	1173 [label="我很高兴你们俩有彼此。",shape=box,color=red];
		1173 -> 1178;
	1174 [label="你们两个真会逗我笑。",shape=box,color=red];
		1174 -> 1179;
	3921 [label="所以你和他……从来没有谈过恋爱？",shape=box,color=red];
		3921 -> 3922;
	1171 [label="被抛弃在那，等死。",shape=box,color=blue];
		1171 -> 1175;
		1171 -> 1176;
	1177 [label="+10 Chemistry",color=orange];
		1177 -> 1182;
	1178 [label="+20 Chemistry",color=orange];
		1178 -> 1183;
	1179 [label="+20 Chemistry",color=orange];
		1179 -> 1184;
	3922 [label="哦，天 ！Non ！他就像我的亲兄弟一样，只是我们没有血缘关系。光是想到这一点，我就 complètement dégoûtée by the very notion ！",shape=box,color=blue];
		3922 -> 3923;
		3922 -> 3924;
	1175 [label="你的家人就这么放任你去死 ？",shape=box,color=red];
		1175 -> 1180;
	1176 [label="你当时多大 ？",shape=box,color=red];
		1176 -> 1181;
	1182 [label="英择谛并没有打乱什么。里昂和我依然坚强如初。只是一切都变了，non ？",shape=box,color=blue];
		1182 -> 1186;
	1183 [label="没有他，我哪儿也去不了。或许，除了山脚下。哈哈 ！",shape=box,color=blue];
		1183 -> 1187;
	1184 [label="他​总是​用​最​奇怪​的​方式​逗​我​笑。​不过​狼，​我​发现，​你​也​一样。​我​觉得​自己​在​这里​越来越​快乐​了。​",shape=box,color=blue];
		1184 -> 1188;
	3923 [label="我只是好奇而已。",shape=box,color=red];
		3923 -> 3925;
	3924 [label="我承认，我有点松了口气。",shape=box,color=red];
		3924 -> 3931;
	1180 [label="在他们眼里，他们觉得多年来已经竭尽全力地帮助我了。他们请家教教我走路，给我戴上支架，给我穿鞋。",shape=box,color=blue];
		1180 -> 1185;
	1181 [label="六岁 ？七岁 ？在他们眼里，他们觉得多年来已经竭尽全力地帮助我了。他们请家教教我走路，给我戴上支架，给我穿鞋。",shape=box,color=blue];
		1181 -> 1185;
	1186 [label="月球瞬息万变。即便太阳的运行轨迹恒定，也是会受到其影响的。",shape=box,color=blue];
		1186 -> 1191;
	1187 [label="他​真的​是​我​灵魂​兄弟。​我​觉得​自己​在​这里​越来越​快乐​了。​",shape=box,color=blue];
		1187 -> 1188;
	1188 [label="我只希望他也能很快发现这一点……但恶魔总用他的低语和谎言困扰着他。",shape=box,color=blue];
		1188 -> 1192;
	3925 [label="+10 Chemistry",color=orange];
		3925 -> 3926;
	3931 [label="Check boolean DrifterMarie",color=orange];
		3931 -> 3932 [label=true,color=green];
		3931 -> 3933 [label=false,color=brown];
	1185 [label="他们厌倦了这种负担。于是，在我连数字和字母都不太会读写的时候，我被丢进了泥地里。",shape=box,color=blue];
		1185 -> 1189;
		1185 -> 1190;
	1191 [label="狼，我们不能固执己见，否则会被它们摧毁。再说，我觉得自己在这里越来越快乐了。",shape=box,color=blue];
		1191 -> 1188;
	1192 [label="呸 ！一提到他，他就喊我。我得走了。",shape=box,color=blue];
		1192 -> 1194;
	3926 [label="Check boolean DrifterMarie",color=orange];
		3926 -> 3927 [label=true,color=green];
		3926 -> 3928 [label=false,color=brown];
	3932 [label="Oui，你已经表明了你的意图。我必须警告你，我不会抛弃他。我认识里昂的时间比你长得多。",shape=box,color=blue];
		3932 -> 3928;
	3933 [label="Oui ？那你打算狩猎我们中的哪一个呢 ？",shape=box,color=blue];
		3933 -> 3934;
		3933 -> 3935;
	1189 [label="你是怎么活下来的 ？",shape=box,color=red];
		1189 -> 1193;
	1190 [label="这太可怕了。",shape=box,color=red];
		1190 -> 1193;
	1194 [label="Chat ends.",color=orange];
	3927 [label="Oui。只是“好奇”而已。别想骗我。我必须警告你，我不会抛弃他。我认识里昂的时间比你长得多。",shape=box,color=blue];
		3927 -> 3928;
	3928 [label="+20 Chemistry",color=orange];
		3928 -> 3929;
	3934 [label="你。",shape=box,color=red];
		3934 -> 3936;
	3935 [label="里昂。",shape=box,color=red];
		3935 -> 3941;
	1193 [label="Check boolean MarieSecretPower",color=orange];
		1193 -> 1196 [label=true,color=green];
		1193 -> 1195 [label=false,color=brown];
	3929 [label="没有他，我真不知道该怎么办。或许，除了躲到山脚下之外，什么都做不了。哈哈！",shape=box,color=blue];
		3929 -> 3930;
	3936 [label="Update boolean DrifterMarie",color=orange];
		3936 -> 3937;
	3941 [label="Vraiment ？！",shape=box,color=blue];
		3941 -> 3942;
	1196 [label="就像你说的，non ？不便之处都蕴藏着一种隐秘力量。",shape=box,color=blue];
		1196 -> 1195;
	1195 [label="我在 ma mère 眼里是 une indésirable 的，但我在街头孩子的眼里却很受欢迎。",shape=box,color=blue];
		1195 -> 1197;
	3930 [label="不过，狼，你还是让我很感兴趣。我发现自己越来越喜欢待在这里。",shape=box,color=blue];
		3930 -> 1188;
	3937 [label="+10 Chemistry",color=orange];
		3937 -> 3938;
	3942 [label="+10 Chemistry",color=orange];
		3942 -> 3943;
	1197 [label="还有什么比一个没有脚的孩子更可悲呢，oui ？我张开手掌，一天赚的钱比他们一周抢的还多。",shape=box,color=blue];
		1197 -> 1198;
	3938 [label="哦！太阳神啊。说实话，你真是让我措手不及。现在我正脸红着坐在这里，躲着洛德先生……",shape=box,color=blue];
		3938 -> 3939;
	3943 [label="你不知道这让我有多高兴，但请你三思而后行。",shape=box,color=blue];
		3943 -> 3944;
	1198 [label="正是因为这样，让我才会在街头被太阳神的 les Sœurs 发现。她们提出收留我。",shape=box,color=blue];
		1198 -> 1199;
		1198 -> 1200;
	3939 [label="我必须警告你，我不会抛弃他。我认识里昂的时间比你长得多。",shape=box,color=blue];
		3939 -> 3940;
	3944 [label="Update boolean DrifterLyon",color=orange];
		3944 -> 3945;
	1199 [label="那其他的孩子呢 ？",shape=box,color=red];
		1199 -> 1201;
	1200 [label="显然，你答应了。",shape=box,color=red];
		1200 -> 1202;
	3940 [label="+10 Chemistry",color=orange];
		3940 -> 1188;
	3945 [label="里昂是我的兄弟。我爱他胜过你所能想象，但他是个饱受折磨的人。在你追他之前，请务必三思，n'est-ce pas ？",shape=box,color=blue];
		3945 -> 3946;
	1201 [label="+5 Chemistry",color=orange];
		1201 -> 1203;
	1202 [label="Oui，我能怎么办 ？我病倒是迟早的事。即便当时我还只是个孩子，我也明白。",shape=box,color=blue];
		1202 -> 1204;
		1202 -> 1205;
	3946 [label="我想我们很快还会再谈这件事。别误会，我是在鼓励你 ！我只是希望你好好想想。",shape=box,color=blue];
		3946 -> 3940;
	1203 [label="你真是个好心人。显然，她们不可能把他们都带走……但我没有忘记我的朋友们。",shape=box,color=blue];
		1203 -> 1206;
	1204 [label="那些修女是什么样的 ？",shape=box,color=red];
		1204 -> 1207;
	1205 [label="那你是如何适应大教堂的生活的 ？",shape=box,color=red];
		1205 -> 1208;
	1206 [label="我每周都会带着我的工资，和从厨房或其他地方收集到的剩饭回来。",shape=box,color=blue];
		1206 -> 1209;
	1207 [label="Les Sœurs 对我非常好 ！不过我知道你肯定不这么想，non ？",shape=box,color=blue];
		1207 -> 1210;
	1208 [label="我可太喜欢那里了 ！不过我知道你肯定不这么想，non ？",shape=box,color=blue];
		1208 -> 1210;
	1209 [label="只要我的朋友们还在，我就尽力照顾他们。许多人都死于 variole ou tuberculose……",shape=box,color=blue];
		1209 -> 1211;
	1210 [label="一日三餐，一张温暖的床，一个栖身之所。我不再需要担心被打，被抢，或者更糟的事情发生 ？",shape=box,color=blue];
		1210 -> 1212;
	1211 [label="一些人搬走了，一些人死于战斗或暴力。大多数人找到了正当的工作，并逐渐成长起来。组建了自己的家庭。",shape=box,color=blue];
		1211 -> 1213;
	1212 [label="我​受到​了​正规​的​教育。​学习​了​太阳神​和​月神​的​福音，​并​被​告知​要​凭​着​信心​找到​自己​的​道路。​如果​我​想​的话，​我​本​可以​离开。​",shape=box,color=blue];
		1212 -> 1214;
	1213 [label="还​有些​人​甚至会​顺便​去​ Cathédrale ​看​看​我。​这​让​我​心里​很​温暖。​",shape=box,color=blue];
		1213 -> 1214;
	1214 [label="很长一段时间以来，我都感到内疚，因为只有我从街上被带走，而其他人却没有。直到今天，我有时仍然有这种感觉。",shape=box,color=blue];
		1214 -> 1215;
		1214 -> 1216;
	1215 [label="当我想起身边所有的人都死去了，而我却活了下来时，我也有同样的感受。但我们不能这样折磨自己。我们必须继续努力，争取让情况变得更好。",shape=box,color=red];
		1215 -> 1217;
	1216 [label="你已经尽你所能去帮助其他人了。你曾被他人托举，而如今你有了机会，也在托举他人。",shape=box,color=red];
		1216 -> 1218;
	1217 [label="难道这一切永远都会如此吗 ？一场战斗 ？一场对抗那想要淹没我们的浪潮的战争 ？",shape=box,color=blue];
		1217 -> 1219;
	1218 [label="Add 1 to Thermostat",color=orange];
		1218 -> 1220;
	1219 [label="Add -1 to Thermostat",color=orange];
		1219 -> 1221;
	1220 [label="+10 Chemistry",color=orange];
		1220 -> 1222;
	1221 [label="+10 Chemistry",color=orange];
		1221 -> 1223;
	1222 [label="Oui，正是如此。我曾被人托举上木筏，现在我也要去为他人这么做。 ",shape=box,color=blue];
		1222 -> 1224;
	1223 [label="但我懂你的意思。你的核心意思是不要放弃。我被赐予这些恩典，是为了成为他人的盾牌。",shape=box,color=blue];
		1223 -> 1224;
	1224 [label="Merci。不过现在我得走了。",shape=box,color=blue];
		1224 -> 1225;
	1225 [label="Chat ends.",color=orange];
}