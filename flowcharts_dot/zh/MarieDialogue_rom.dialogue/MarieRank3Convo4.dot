	1244 [label="+10 Chemistry",color=orange];
		1244 -> 1248;
	1245 [label="我只是有点惊讶你现在比我还了解他。",shape=box,color=red];
		1245 -> 1244;
	1246 [label="我认识洛德已经有一段时间了，而到现在我对他的过去还一无所知。",shape=box,color=red];
		1246 -> 1244;
	1243 [label="这种事挺常见的。你不是唯一的一个。",shape=box,color=red];
