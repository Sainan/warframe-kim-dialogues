	j4034924529 [label="什么问题 ？",shape=box,color=red];
		j4034924529 -> j3391589816;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j3050692177 [label="他跟我说了他青年时代的故事。Ai-je fait quelque chose qui vous a offensé ？",shape=box,color=blue];
		j3050692177 -> j147038418;
		j3050692177 -> j3837334629;
	j3033615828 [label="我没看懂。Ai-je fait quelque chose qui vous avez offensé ？",shape=box,color=blue];
		j3033615828 -> j147038418;
		j3033615828 -> j3837334629;
	j3391589816 [label="哲士——他们是奥罗金人吗 ？还是说他们不是 ？这个词用得太随便了。",shape=box,color=blue];
		j3391589816 -> j2337839066;
	"Chat ends." [color=orange];
	j147038418 [label="我想我只是……很嫉妒。",shape=box,color=red];
		j147038418 -> j1235248880;
	j3837334629 [label="我想我只是……很惊讶。",shape=box,color=red];
		j3837334629 -> j1567830042;
	j2337839066 [label="我想，我是可以去问恶魔。但我能不跟他说话就不跟他说话。",shape=box,color=blue];
		j2337839066 -> j458549024;
		j2337839066 -> j151498653;
	j1235248880 [label="De la jalousie ？Pourquoi ？",shape=box,color=blue];
		j1235248880 -> j516006036;
	j1567830042 [label="Pourquoi ？",shape=box,color=blue];
		j1567830042 -> j3113547297;
		j1567830042 -> j3074095247;
	j458549024 [label="不​是，​哲士​的​阶级​低于奥罗金人。​",shape=box,color=red];
		j458549024 -> j2708950112;
	j151498653 [label="奥罗金帝国之所以被称为奥罗金帝国，是因为奥罗金人统治着它，但奥罗金也只是统治阶级的名称。",shape=box,color=red];
		j151498653 -> j2708950112;
	j516006036 [label="+10 Chemistry",color=orange];
		j516006036 -> j1567156136;
	j3113547297 [label="我只是有点惊讶你现在比我还了解他。",shape=box,color=red];
		j3113547297 -> j516006036;
	j3074095247 [label="我认识洛德已经有一段时间了，而到现在我对他的过去还一无所知。",shape=box,color=red];
		j3074095247 -> j516006036;
	j2708950112 [label="这种事挺常见的。你不是唯一的一个。",shape=box,color=red];
		j2708950112 -> j2729896594;
	j1567156136 [label="哦 ！别往心里去，s'il vous plaît ！",shape=box,color=blue];
		j1567156136 -> j2291474266;
	j2729896594 [label="奥罗金人是故意让他们的社会变得混乱和愚钝吗 ？",shape=box,color=blue];
		j2729896594 -> j689784766;
		j2729896594 -> j1219694494;
		j2729896594 -> j3236482010;
	j2291474266 [label="洛德先生，怎么说呢，给人感觉有点疏远 ？",shape=box,color=blue];
		j2291474266 -> j1099620295;
		j2291474266 -> j1040713673;
	j689784766 [label="几千年来，人们一直掌权，最后都会……感到无聊。无聊的人就会创造出复杂的系统。",shape=box,color=red];
		j689784766 -> j880690706;
	j1219694494 [label="他们热衷于华丽和复杂的事物，这种品味也延伸到了官僚机构中。",shape=box,color=red];
		j1219694494 -> j880690706;
	j3236482010 [label="老实说 ？我现在开始这么想了。",shape=box,color=red];
		j3236482010 -> j880690706;
	j1099620295 [label="其实我对他一点都不了解。",shape=box,color=red];
		j1099620295 -> j303869309;
	j1040713673 [label="是的，他有点冷淡。",shape=box,color=red];
		j1040713673 -> j303869309;
	j880690706 [label="+10 Chemistry",color=orange];
		j880690706 -> j1262287890;
	j303869309 [label="看看我都和谁相处，oui ？一旦学会解读一个雕像，再学习解读另一个雕像就没那么难了。",shape=box,color=blue];
		j303869309 -> j4007258873;
	j1262287890 [label="我觉得他们那样做就是为了让人厌烦 ！",shape=box,color=blue];
		j1262287890 -> j3031339830;
	j4007258873 [label="+10 Chemistry",color=orange];
		j4007258873 -> j197995888;
	j3031339830 [label="Et ils se demandent pourquoi des rébellions éclatent。Vous aviez peut-être vos warframes，mais nous avions nos guillotines ！",shape=box,color=blue];
		j3031339830 -> j898448936;
	j197995888 [label="不过我承认，洛德先生比亲爱的里昂更……更有个性一些。",shape=box,color=blue];
		j197995888 -> j1866463551;
		j197995888 -> j1206667354;
	j898448936 [label="Vive la révolution ！",shape=box,color=blue];
		j898448936 -> j2408151883;
		j898448936 -> j2623213021;
		j898448936 -> j3197028660;
	j1866463551 [label="他自有他的理由。",shape=box,color=red];
		j1866463551 -> j2898303582;
	j1206667354 [label="好吧……你的问题是什么 ？",shape=box,color=red];
		j1206667354 -> j2146603570;
	j2408151883 [label="我应该担心吗 ？",shape=box,color=red];
		j2408151883 -> j3953816696;
	j2623213021 [label="Vive la révolution ！大概吧。",shape=box,color=red];
		j2623213021 -> j2120976697;
	j3197028660 [label="我不太清楚刚才发生了什么，但我想我赞同 ？",shape=box,color=red];
		j3197028660 -> j2120976697;
	j2898303582 [label="是啊，肯定有。",shape=box,color=blue];
		j2898303582 -> j2420775490;
	j2146603570 [label="啊 ！对了。",shape=box,color=blue];
		j2146603570 -> j2420775490;
	j3953816696 [label="别介意，我只是开个玩笑而已。傻傻的 la révolutionnaire 玛丽。",shape=box,color=blue];
		j3953816696 -> j1253875958;
	j2120976697 [label="+10 Chemistry",color=orange];
		j2120976697 -> j3953816696;
	j2420775490 [label="我现在竟然完全忘了来这里要问你什么了 ！哈 ！算了，我会想起来。",shape=box,color=blue];
		j2420775490 -> j2395317073;
	j1253875958 [label="感谢你回答我的问题，我应该让你继续忙了。 ",shape=box,color=blue];
		j1253875958 -> j2395317073;
	j2395317073 [label="很抱歉打扰你了，无论是白天、晚上或任何时间，无论你身在何处。",shape=box,color=blue];
		j2395317073 -> j4101990552;
