	1247 [label="奥罗金人是故意让他们的社会变得混乱和愚钝吗 ？",shape=box,color=blue];
		1247 -> 1249;
		1247 -> 1250;
		1247 -> 1251;
	1252 [label="洛德先生，怎么说呢，给人感觉有点疏远 ？",shape=box,color=blue];
		1252 -> 1254;
		1252 -> 1255;
	1249 [label="几千年来，人们一直掌权，最后都会……感到无聊。无聊的人就会创造出复杂的系统。",shape=box,color=red];
		1249 -> 1253;
