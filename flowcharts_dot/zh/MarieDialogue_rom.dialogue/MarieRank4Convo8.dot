	j882561005 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j882561005 -> j65505275;
	j2502495836 [label="后来不知道是什么原因，他被改造成了一个中枢，并获得了自己的殁世械灵外壳。",shape=box,color=red];
		j2502495836 -> j3315074692;
	j160267044 [label="Boolean MarieCephalonNoSoul is now false.",color=orange];
		j160267044 -> j3379678324;
