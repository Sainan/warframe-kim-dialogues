		1948 -> 1560 [label="false",color=purple];
	1949 [label="Oui ！你说得对，这才是事情的核心——或者说是源“头”——哈哈。一个人认为它是神圣的，另一个人却认为它是假的。",shape=box,color=blue];
		1949 -> 1948;
	1947 [label="众所周知，他是一位天才，也是驾驭氩结晶的幕后推手。",shape=box,color=red];
		1947 -> 1556;
	1558 [label="如果殁世械灵先生连自己的骨头都没有，他又怎么会拥有灵魂呢 ？",shape=box,color=blue];
		1558 -> 1562;
		1558 -> 1563;
		1558 -> 1564;
	1557 [label="这是否进一步证明了殁世械灵先生没有灵魂 ？",shape=box,color=blue];
		1557 -> 1562;
		1557 -> 1563;
		1557 -> 1564;
	1559 [label="我知道你不确定殁世械灵先生是否拥有灵魂。但我不明白如果殁世械灵先生连自己的骨头都没有，他又怎么会拥有灵魂呢。",shape=box,color=blue];
		1559 -> 1562;
		1559 -> 1563;
		1559 -> 1564;
	1560 [label="我说的是一件非常精巧的仿人科技装置，对吧 ？一台精妙复杂很多倍的留声机。",shape=box,color=blue];
		1560 -> 1565;
		1560 -> 1566;
		1560 -> 1567;
		1560 -> 1568;
		1560 -> 1569;
	1556 [label="这些力量源自虚空——正是它们让我们能够制造出众多强大的战甲与武器。",shape=box,color=red];
		1556 -> 1561;
	1562 [label="也许你是对的。也许它们真的只是人的复制品。但我不确定，而且无论如何，我们得把它们当人来对待。",shape=box,color=red];
		1562 -> 1571;
	1563 [label="我认为殁世械灵是个例外，而非常规。他是按照一个人复制出来的，而不是从人身上衍生出来的。",shape=box,color=red];
		1563 -> 1572;
	1564 [label="你说得对。如果他们不是被困在精密科学中的灵魂，那可能更好，也更人道……",shape=box,color=red];
		1564 -> 1573;
	1565 [label="殁世械灵或许没有灵魂，但他很独特。其他中枢，比如奥塔，都有灵魂。它们在诞生之初就被毁坏了。",shape=box,color=red];
		1565 -> 1574;
	1566 [label="你说得对。那么你希望我做什么呢 ？",shape=box,color=red];
		1566 -> 1575;
	1567 [label="你说得对，他们确实没有。但这并不意味着我们可以随意虐待他们。",shape=box,color=red];
		1567 -> 1576;
	1568 [label="我不知道你说的是不是对的。但他们仍能思考，能感受，我们不能把他们当成物品来对待。",shape=box,color=red];
		1568 -> 1577;
	1569 [label="殁世械灵有灵魂。所有中枢都有。",shape=box,color=red];
		1569 -> 1578;
	1561 [label="他专攻晶体学。他的研究成果都保存在这里的实验室里。",shape=box,color=red];
