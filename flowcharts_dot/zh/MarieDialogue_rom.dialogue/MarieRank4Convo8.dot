	"MarieRank4Convo8 begins." [color=orange];
		"MarieRank4Convo8 begins." -> j1666837665;
	j1666837665 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j1666837665 -> j2786051379;
	j2786051379 [label="Check boolean MarieOtak1",color=orange];
		j2786051379 -> j1504529688 [label=true,color=green];
		j2786051379 -> j789020760 [label=false,color=brown];
	j1504529688 [label="漂泊者，我越是了解殁世械灵先生和奥塔先生，就越是觉得困惑……",shape=box,color=blue];
		j1504529688 -> j3397356122;
		j1504529688 -> j2675288894;
	j789020760 [label="漂泊者，我可以和你说会儿话吗 ？",shape=box,color=blue];
		j789020760 -> j3706873168;
		j789020760 -> j1038552372;
	j3397356122 [label="为什么 ？",shape=box,color=red];
		j3397356122 -> j3387609044;
	j2675288894 [label="具体是什么问题 ？",shape=box,color=red];
		j2675288894 -> j3387609044;
	j3706873168 [label="当然可以，什么事 ？",shape=box,color=red];
		j3706873168 -> j4241843045;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j3387609044 [label="我问殁世械灵先生，他身上装饰的头骨是否属于某个曾经活着的人。",shape=box,color=blue];
		j3387609044 -> j3094567635;
	j4241843045 [label="我好奇他后面为何还刻着另一张脸，那模样活像小朋友的涂鸦。",shape=box,color=blue];
		j4241843045 -> j4006193418;
	"Chat ends." [color=orange];
	j3094567635 [label="然后殁世械灵先生告诉我，那是“他的”头骨，尽管他承认洛德先生才是“真品”。然后洛德先生插嘴说，那是他自己头骨的“复制品”。",shape=box,color=blue];
		j3094567635 -> j923099967;
	j4006193418 [label="我分别询问了殁世械灵先生和洛德先生，但两人都避而不谈此事，只告诉我一个名字：奥塔。他们说出这个名字时，语气中带着深深的悲伤。",shape=box,color=blue];
		j4006193418 -> j565897713;
	j923099967 [label="怎么会这样 ？“复制品”是什么意思 ？是真的头骨还是假的 ？为什么殁世械灵先生和洛德先生的答案会不一样 ？",shape=box,color=blue];
		j923099967 -> j746938605;
		j923099967 -> j1145197651;
		j923099967 -> j1382610908;
	j565897713 [label="所以我在这里和你交谈，希望你能帮助我。",shape=box,color=blue];
		j565897713 -> j190624482;
	j746938605 [label="我想，从殁世械灵的角度来看，没错，那的确是他的头骨。但从洛德的角度来看，那只是个复制品。",shape=box,color=red];
		j746938605 -> j706285990;
	j1145197651 [label="我还真的不知道它是什么材质的。可能是骨头，也可能是某种聚合物……",shape=box,color=red];
		j1145197651 -> j3917954845;
	j1382610908 [label="我认为你所思考的问题的根源是“殁世械灵是真实的吗”，而不是“头骨是真实的吗”。",shape=box,color=red];
		j1382610908 -> j1025888233;
	j190624482 [label="你能告诉我那个可怜的奥塔先生的故事吗 ？",shape=box,color=blue];
		j190624482 -> j3200908423;
	j706285990 [label="我想这就是让我困扰的地方。是两位先生对这其来源的看法。一位认为它是神圣的，另一位认为是假的。",shape=box,color=blue];
		j706285990 -> j3408858168;
	j3917954845 [label="恐怕不是因为这个头骨的材质让我如此困扰，而是它的来源。又或许是因为那两位先生对它来源的看法。一位认为它是神圣的，另一位则认为它是假的。",shape=box,color=blue];
		j3917954845 -> j3408858168;
	j1025888233 [label="+5 Chemistry",color=orange];
		j1025888233 -> j1303393480;
	j3200908423 [label="奥塔曾是一位哲士、奥罗金科学家和学者。关于他的经历，实在算不上一个幸福的故事。",shape=box,color=red];
		j3200908423 -> j209739540;
	j3408858168 [label="Evaluate expressions",color=orange];
		j3408858168 -> j3442752518 [label="MarieCephalonSoul",color=purple];
		j3408858168 -> j2981506746 [label="MarieCephalonNoSoul",color=purple];
		j3408858168 -> j437683021 [label="MarieCephalonUnsure",color=purple];
		j3408858168 -> j1906721674 [label="false",color=purple];
	j1303393480 [label="Oui ！你说得对，这才是事情的核心——或者说是源“头”——哈哈。一个人认为它是神圣的，另一个人却认为它是假的。",shape=box,color=blue];
		j1303393480 -> j3408858168;
	j209739540 [label="众所周知，他是一位天才，也是驾驭氩结晶的幕后推手。",shape=box,color=red];
		j209739540 -> j3655822768;
	j3442752518 [label="如果殁世械灵先生连自己的骨头都没有，他又怎么会拥有灵魂呢 ？",shape=box,color=blue];
		j3442752518 -> j1967855029;
		j3442752518 -> j2035947345;
		j3442752518 -> j3319419592;
	j2981506746 [label="这是否进一步证明了殁世械灵先生没有灵魂 ？",shape=box,color=blue];
		j2981506746 -> j1967855029;
		j2981506746 -> j2035947345;
		j2981506746 -> j3319419592;
	j437683021 [label="我知道你不确定殁世械灵先生是否拥有灵魂。但我不明白如果殁世械灵先生连自己的骨头都没有，他又怎么会拥有灵魂呢。",shape=box,color=blue];
		j437683021 -> j1967855029;
		j437683021 -> j2035947345;
		j437683021 -> j3319419592;
	j1906721674 [label="我说的是一件非常精巧的仿人科技装置，对吧 ？一台精妙复杂很多倍的留声机。",shape=box,color=blue];
		j1906721674 -> j1145192725;
		j1906721674 -> j3448936976;
		j1906721674 -> j4074087941;
		j1906721674 -> j635134371;
		j1906721674 -> j423298403;
	j3655822768 [label="这些力量源自虚空——正是它们让我们能够制造出众多强大的战甲与武器。",shape=box,color=red];
		j3655822768 -> j2214849902;
	j1967855029 [label="也许你是对的。也许它们真的只是人的复制品。但我不确定，而且无论如何，我们得把它们当人来对待。",shape=box,color=red];
		j1967855029 -> j3377595575;
	j2035947345 [label="我认为殁世械灵是个例外，而非常规。他是按照一个人复制出来的，而不是从人身上衍生出来的。",shape=box,color=red];
		j2035947345 -> j3312717658;
	j3319419592 [label="你说得对。如果他们不是被困在精密科学中的灵魂，那可能更好，也更人道……",shape=box,color=red];
		j3319419592 -> j335117254;
	j1145192725 [label="殁世械灵或许没有灵魂，但他很独特。其他中枢，比如奥塔，都有灵魂。它们在诞生之初就被毁坏了。",shape=box,color=red];
		j1145192725 -> j3485480178;
	j3448936976 [label="你说得对。那么你希望我做什么呢 ？",shape=box,color=red];
		j3448936976 -> j967672985;
	j4074087941 [label="你说得对，他们确实没有。但这并不意味着我们可以随意虐待他们。",shape=box,color=red];
		j4074087941 -> j638782318;
	j635134371 [label="我不知道你说的是不是对的。但他们仍能思考，能感受，我们不能把他们当成物品来对待。",shape=box,color=red];
		j635134371 -> j498727185;
	j423298403 [label="殁世械灵有灵魂。所有中枢都有。",shape=box,color=red];
		j423298403 -> j882561005;
	j2214849902 [label="他专攻晶体学。他的研究成果都保存在这里的实验室里。",shape=box,color=red];
		j2214849902 -> j2502495836;
	j3377595575 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
		j3377595575 -> j160267044;
