	1591 [label="Update boolean MarieCephalonUnsure",color=orange];
		1591 -> 1599;
	1592 [label="这进一步证明对恶魔及其同类的谴责是正确的。不过，或许你对奥塔及其同类的看法也是正确的，又或许相信这一点能给你带来内心的平安。",shape=box,color=blue];
		1592 -> 1593;
	1593 [label="归根结底，我或许错了。展现善意和尊重永远不会有坏处。 ",shape=box,color=blue];
		1593 -> 1600;
	1594 [label="也许你是对的，但我不认为那些奥罗金恶魔比我们更了解灵魂的事情。他们并不是什么伟大的神。",shape=box,color=blue];
