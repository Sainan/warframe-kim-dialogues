	j359627961 [label="Boolean MarieCephalonUnsure is now false.",color=orange];
		j359627961 -> j3429031909;
	j344513155 [label="这进一步证明对恶魔及其同类的谴责是正确的。不过，或许你对奥塔及其同类的看法也是正确的，又或许相信这一点能给你带来内心的平安。",shape=box,color=blue];
		j344513155 -> j501624834;
	j501624834 [label="归根结底，我或许错了。展现善意和尊重永远不会有坏处。 ",shape=box,color=blue];
		j501624834 -> j2916404837;
	j3884166434 [label="也许你是对的，但我不认为那些奥罗金恶魔比我们更了解灵魂的事情。他们并不是什么伟大的神。",shape=box,color=blue];
		j3884166434 -> j501624834;
	j4080017735 [label="也许你是对的，也许相信这一点，能让你感到平安。",shape=box,color=blue];
		j4080017735 -> j501624834;
	j438681722 [label="Pauvre petit……",shape=box,color=blue];
		j438681722 -> j3134774711;
	j1939896691 [label="+5 Chemistry",color=orange];
		j1939896691 -> j3505313882;
	j1629212074 [label="+5 Chemistry",color=orange];
		j1629212074 -> j825084938;
	j3429031909 [label="+5 Chemistry",color=orange];
		j3429031909 -> j1820752689;
	j2916404837 [label="不管怎样，我都要回去给殁世械灵先生编个花冠。即便他抱怨，我也不会听他的 ！",shape=box,color=blue];
		j2916404837 -> j3054687713;
		j2916404837 -> j3710330155;
		j2916404837 -> j1938329520;
	j3134774711 [label="Boolean MarieOtak1 is now true.",color=orange];
		j3134774711 -> j3951815689;
	j3505313882 [label="是的，这话很智慧。我只是这么一想，也想知道对于你来说他们是什么。你说得对，表达善意和尊重永远不会有坏处。",shape=box,color=blue];
		j3505313882 -> j255069278;
	j825084938 [label="也许你是对的。并且我也希望你是对的 ！无论情况如何，我们都必须善待它们——因为它们是有思想的生物。凡是能思考的，就必然会有感觉。",shape=box,color=blue];
		j825084938 -> j255069278;
	j1820752689 [label="无论情况如何，我们都必须善待它们——因为它们是有思想的生物。凡是能思考的，就必然会有感觉。",shape=box,color=blue];
		j1820752689 -> j501624834;
