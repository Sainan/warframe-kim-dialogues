	j255069278 [label="归根结底，我们或许错了。展现善意和尊重永远不会有坏处。 ",shape=box,color=blue];
		j255069278 -> j2916404837;
	j368863751 [label="+5 Chemistry",color=orange];
		j368863751 -> j2090081900;
	j2515899664 [label="+10 Chemistry",color=orange];
		j2515899664 -> j2901339834;
	j1577052375 [label="+5 Chemistry",color=orange];
		j1577052375 -> j4067164306;
	j711962741 [label="你是怎么想到这个问题的 ？",shape=box,color=red];
		j711962741 -> j3387609044;
	j3226163204 [label="我希望有一天你能见到他。",shape=box,color=red];
		j3226163204 -> j1433703049;
	j2090081900 [label="Merci ！À la revoyure ！",shape=box,color=blue];
		j2090081900 -> "Chat ends.";
	j2901339834 [label="哦 ！这是月神的仪式之一。在亡灵逝去的周年纪念日，人们会编织一顶花冠或花环，然后将它放在他们的头骨或坟墓上。 ",shape=box,color=blue];
		j2901339834 -> j334135102;
	j4067164306 [label="Merci，我会的 ！À la revoyure ！",shape=box,color=blue];
		j4067164306 -> "Chat ends.";
	j1433703049 [label="Oui。不过我想，困扰我的并非他的沉默。我问过殁世械灵先生，他身上的那颗头骨是否属于某个曾经活着的人。",shape=box,color=blue];
		j1433703049 -> j3094567635;
	j334135102 [label="传统的墓穴通常都是将尸体暴露在外的，Oui ？这样人们就可以给他们戴上。我想有些传统仍保存至今。",shape=box,color=blue];
		j334135102 -> j414692186;
	j414692186 [label="我看到奥罗金的一些艺术作品反映了他们对头骨的热爱。 ",shape=box,color=blue];
		j414692186 -> j758568990;
		j414692186 -> j1405529186;
		j414692186 -> j156664656;
	j758568990 [label="原来如此。",shape=box,color=red];
		j758568990 -> j4077990017;
	j1405529186 [label="万变不离其宗呐？",shape=box,color=red];
		j1405529186 -> j4077990017;
	j156664656 [label="我​想​“女儿”​以前​曾​尝​试过​这样​做，​你​会​让​她​嫉妒​的。​",shape=box,color=red];
		j156664656 -> j239074870;
	j4077990017 [label="Oui ！时间过去这么久了，但影响依然存在。知道哪怕是一点点痕迹依然存在，也让我感到欣慰。",shape=box,color=blue];
		j4077990017 -> j2130443128;
	j239074870 [label="Oui ？那我期待着见到她的那一天 ！我会告诉她，我可一点都没留情。",shape=box,color=blue];
		j239074870 -> j2130443128;
	j2130443128 [label="不管是不是假头骨，殁世械灵先生都应该戴上花冠。我宠他的时候，他竟然会害羞 ！我想，要是能脸红的话，他肯定也会脸红。想想就觉得开心。",shape=box,color=blue];
		j2130443128 -> j4101990552;
	j4101990552 [label="À la revoyure !",shape=box,color=blue];
		j4101990552 -> "Chat ends.";
