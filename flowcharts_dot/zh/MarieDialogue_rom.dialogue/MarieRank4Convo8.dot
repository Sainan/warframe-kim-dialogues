	1927 [label="漂泊者，我越是了解殁世械灵先生和奥塔先生，就越是觉得困惑……",shape=box,color=blue];
		1927 -> 1930;
		1927 -> 1931;
	1926 [label="漂泊者，我可以和你说会儿话吗 ？",shape=box,color=blue];
		1926 -> 1928;
		1926 -> 1929;
	1930 [label="为什么 ？",shape=box,color=red];
		1930 -> 1934;
	1931 [label="具体是什么问题 ？",shape=box,color=red];
		1931 -> 1934;
	1928 [label="当然可以，什么事 ？",shape=box,color=red];
		1928 -> 1932;
	1929 [label="[结束]",shape=box,color=red];
		1929 -> 1933;
	1934 [label="我问殁世械灵先生，他身上装饰的头骨是否属于某个曾经活着的人。",shape=box,color=blue];
		1934 -> 1936;
	1932 [label="我好奇他后面为何还刻着另一张脸，那模样活像小朋友的涂鸦。",shape=box,color=blue];
		1932 -> 1935;
	1933 [label="Chat ends.",color=orange];
	1936 [label="然后殁世械灵先生告诉我，那是“他的”头骨，尽管他承认洛德先生才是“真品”。然后洛德先生插嘴说，那是他自己头骨的“复制品”。",shape=box,color=blue];
		1936 -> 1938;
	1935 [label="我分别询问了殁世械灵先生和洛德先生，但两人都避而不谈此事，只告诉我一个名字：奥塔。他们说出这个名字时，语气中带着深深的悲伤。",shape=box,color=blue];
		1935 -> 1937;
	1938 [label="怎么会这样 ？“复制品”是什么意思 ？是真的头骨还是假的 ？为什么殁世械灵先生和洛德先生的答案会不一样 ？",shape=box,color=blue];
		1938 -> 1940;
		1938 -> 1941;
		1938 -> 1942;
	1937 [label="所以我在这里和你交谈，希望你能帮助我。",shape=box,color=blue];
		1937 -> 1939;
	1940 [label="我想，从殁世械灵的角度来看，没错，那的确是他的头骨。但从洛德的角度来看，那只是个复制品。",shape=box,color=red];
		1940 -> 1944;
	1941 [label="我还真的不知道它是什么材质的。可能是骨头，也可能是某种聚合物……",shape=box,color=red];
		1941 -> 1945;
	1942 [label="我认为你所思考的问题的根源是“殁世械灵是真实的吗”，而不是“头骨是真实的吗”。",shape=box,color=red];
		1942 -> 1946;
	1939 [label="你能告诉我那个可怜的奥塔先生的故事吗 ？",shape=box,color=blue];
		1939 -> 1943;
	1944 [label="我想这就是让我困扰的地方。是两位先生对这其来源的看法。一位认为它是神圣的，另一位认为是假的。",shape=box,color=blue];
		1944 -> 1948;
	1945 [label="恐怕不是因为这个头骨的材质让我如此困扰，而是它的来源。又或许是因为那两位先生对它来源的看法。一位认为它是神圣的，另一位则认为它是假的。",shape=box,color=blue];
		1945 -> 1948;
	1946 [label="+5 Chemistry",color=orange];
		1946 -> 1949;
	1943 [label="奥塔曾是一位哲士、奥罗金科学家和学者。关于他的经历，实在算不上一个幸福的故事。",shape=box,color=red];
		1943 -> 1947;
