	1614 [label="Merci ！À la revoyure ！",shape=box,color=blue];
		1614 -> 1617;
	1615 [label="哦 ！这是月神的权能之一。在亡灵逝去的周年纪念日，人们会编织一顶花冠或花环，然后将它放在他们的头骨或坟墓上。 ",shape=box,color=blue];
		1615 -> 1618;
	1616 [label="Merci，我会的 ！À la revoyure ！",shape=box,color=blue];
		1616 -> 1617;
	1609 [label="Oui。不过我想，困扰我的并非他的沉默。我问过殁世械灵先生，他身上的那颗头骨是否属于某个曾经活着的人。",shape=box,color=blue];
		1609 -> 1936;
	1617 [label="Chat ends.",color=orange];
	1618 [label="传统的墓穴通常都是将尸体暴露在外的，Oui ？这样人们就可以给他们戴上。我想有些传统仍保存至今。",shape=box,color=blue];
		1618 -> 1619;
	1619 [label="我看到奥罗金的一些艺术作品反映了他们对头骨的热爱。 ",shape=box,color=blue];
		1619 -> 1620;
		1619 -> 1621;
		1619 -> 1622;
	1620 [label="原来如此。",shape=box,color=red];
		1620 -> 1623;
	1621 [label="万变不离其宗呐？",shape=box,color=red];
		1621 -> 1623;
	1622 [label="我​想​“女儿”​以前​曾​尝​试过​这样​做，​你​会​让​她​嫉妒​的。​",shape=box,color=red];
		1622 -> 1624;
	1623 [label="Oui ！时间过去这么久了，但影响依然存在。知道哪怕是一点点痕迹依然存在，也让我感到欣慰。",shape=box,color=blue];
		1623 -> 1625;
	1624 [label="Oui ？那我期待着见到她的那一天 ！我会告诉她，我可一点都没留情。",shape=box,color=blue];
		1624 -> 1625;
	1625 [label="不管是不是假头骨，殁世械灵先生都应该戴上花冠。我宠他的时候，他竟然会害羞 ！我想，要是能脸红的话，他肯定也会脸红。想想就觉得开心。",shape=box,color=blue];
