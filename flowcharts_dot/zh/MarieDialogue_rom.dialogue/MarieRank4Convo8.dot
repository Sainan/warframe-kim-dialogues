		j1368823231 -> j359627961;
	j2891280981 [label="+5 Chemistry",color=orange];
		j2891280981 -> j344513155;
	j2213963728 [label="哦，千万别以为我让你残忍 ！Non ！要珍惜他们，因为他们很宝贵，他们变成现在这个样子并非他们的错 ！",shape=box,color=blue];
		j2213963728 -> j501624834;
	j2172334018 [label="+5 Chemistry",color=orange];
		j2172334018 -> j2213963728;
	j2564184194 [label="+5 Chemistry",color=orange];
		j2564184194 -> j3884166434;
	j65505275 [label="+5 Chemistry",color=orange];
		j65505275 -> j4080017735;
	j3315074692 [label="不是所有中枢都是因刑罚而被造的。但当时火卫二这边的情况……变得很糟糕，他受了重伤。",shape=box,color=red];
		j3315074692 -> j438681722;
	j3379678324 [label="Boolean MarieCephalonSoul is now false.",color=orange];
		j3379678324 -> j1939896691;
