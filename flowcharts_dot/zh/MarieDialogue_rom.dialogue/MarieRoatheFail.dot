	j3099875259 [label="我正在努力说服罗瑟帮我们让洛德和英择谛家族团聚。但他在注射血清这件事情上仍然很固执。我需要你的帮助来和他谈谈。",shape=box,color=red];
		j3099875259 -> j2135670459;
	j3854788569 [label="我正在努力让罗瑟意识到他可以改变，他可以原谅自己过去的所作所为。而我需要你的帮助才能做到这一点。",shape=box,color=red];
		j3854788569 -> j812281567;
	j2790437594 [label="罗瑟正为自己所做的一切而备受煎熬。如果没有你的帮助，我担心如果他不能正视自己的问题，他只会继续自我毁灭。",shape=box,color=red];
		j2790437594 -> j12114135;
	j2501150044 [label="罗瑟得知了血清的真相。他是自愿注射的。而这个真相正在摧毁他。我需要你的帮助来安抚他。",shape=box,color=red];
		j2501150044 -> j2135670459;
