	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo4 begins." [color=orange];
		"MarieRank1Convo4 begins." -> j4167218553;
	j4167218553 [label="我​能​问​个​问题​吗 ？​希望​不​会​太​冒昧。​我们​的​友谊​才​刚刚​开始，​对​你​而​言尤其​如此，​听说​你​已经​活​过​很多​岁​月​了。",shape=box,color=blue];
		j4167218553 -> j29900567;
		j4167218553 -> j407852194;
		j4167218553 -> j1038552372;
	j29900567 [label="其实我已经不太记得大部分的岁月了。 ",shape=box,color=red];
		j29900567 -> j1439295378;
	j407852194 [label="当然，我不介意。问吧。",shape=box,color=red];
		j407852194 -> j2947588656;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j1439295378 [label="太阳神啊 ！你的话太让我心痛了。你和恶魔都觉得自己的脑子一片空白，就像一本被撕去了几章的书，non ？",shape=box,color=blue];
		j1439295378 -> j39543158;
		j1439295378 -> j1168227382;
	j2947588656 [label="+5 Chemistry",color=orange];
		j2947588656 -> j523704316;
	"Chat ends." [color=orange];
	j39543158 [label="我并不怀念那些我失去的过去。",shape=box,color=red];
		j39543158 -> j3286498852;
	j1168227382 [label="只​不过​原​因​完全​不同，是的。",shape=box,color=red];
		j1168227382 -> j2474280684;
	j523704316 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j523704316 -> j3453352867 [label="x > 0",color=purple];
		j523704316 -> j1080594081 [label="x <= 0",color=purple];
		j523704316 -> j1080594081 [label="false",color=purple];
	j3286498852 [label="真的吗 ？看来只有你是这么想的。无论是孩子还是恶魔，似乎他俩都在寻找被遗忘的那部分自我。",shape=box,color=blue];
		j3286498852 -> j3658123097;
		j3286498852 -> j4009953221;
	j2474280684 [label="我这样问会不会太冒昧，为什么你看起来那么失落 ？孩子和恶魔的原因我知道，但你的我不知道。",shape=box,color=blue];
		j2474280684 -> j3658123097;
		j2474280684 -> j4009953221;
	j3453352867 [label="你为什么要答应帮助恶魔完成他的阴谋 ？我听说你要去为屠杀他族人的事负责。",shape=box,color=blue];
		j3453352867 -> j475177452;
		j3453352867 -> j1312070401;
		j3453352867 -> j3932599654;
	j1080594081 [label="你是打算帮助恶魔完成他的阴谋吗 ？我听说你要去为屠杀他族人的事负责。",shape=box,color=blue];
		j1080594081 -> j475177452;
		j1080594081 -> j1312070401;
		j1080594081 -> j3932599654;
	j3658123097 [label="我在无数岁月中已经死过很多次了，死在……呃？死在我自己手里。我不介意自己记不清那些事。",shape=box,color=red];
		j3658123097 -> j3595898467;
	j4009953221 [label="简而言之，我受了……很多年的苦。我猜这大概是一种自我防御机制吧，选择遗忘。",shape=box,color=red];
		j4009953221 -> j3555116673;
	j475177452 [label="那是另一个我做的事。我相信应该把责任归咎于个人，而不是群体。",shape=box,color=red];
		j475177452 -> j1302948217;
	j1312070401 [label="那不是我干的，是那个孩子。但我跟那孩子一样恨奥罗金。",shape=box,color=red];
		j1312070401 -> j2969191437;
	j3932599654 [label="在长胴鼓之夜，Tenno 攻击奥罗金的时候，我并不在场。是那个孩子干的。",shape=box,color=red];
		j3932599654 -> j1624058914;
	j3595898467 [label="不怪你。如果我也遭受那样的虐待，我会迫不及待地把一切都藏起来。至少，我绝不会再去找回它们。",shape=box,color=blue];
		j3595898467 -> j4216468475;
	j3555116673 [label="毋庸置疑！如果我也遭受那样的虐待，我的灵魂大概也会做出类似的反应。把所有无法修复、毫无益处的记忆都藏起来。",shape=box,color=blue];
		j3555116673 -> j4216468475;
	j1302948217 [label="Add 1 to Thermostat counter",color=orange];
		j1302948217 -> j227804296;
	j2969191437 [label="Add -1 to Thermostat counter",color=orange];
		j2969191437 -> j1882809129;
	j1624058914 [label="长胴鼓之夜。哦，我可以想象出来。Quelles couleurs magnifiques ！",shape=box,color=blue];
		j1624058914 -> j2387173610;
	j4216468475 [label="+5 Chemistry",color=orange];
		j4216468475 -> j2954016309;
	j227804296 [label="Oui, je comprends。明明是只是墙里老鼠带来的臭味，我们却急着要放火烧屋。",shape=box,color=blue];
		j227804296 -> j3722533636;
	j1882809129 [label="Je meurs d'envie de savoir pourquoi ！不过这些话我们改日再谈，否则会聊个没完，而洛德先生会对我生气的。",shape=box,color=blue];
		j1882809129 -> j4192617946;
	j2387173610 [label="我需要和洛德先生谈谈更多细节。但是 ！",shape=box,color=blue];
		j2387173610 -> j4192617946;
	j2954016309 [label="不过，这可能让我对我想和你谈论的事情有些头绪了。",shape=box,color=blue];
		j2954016309 -> j523704316;
	j3722533636 [label="不过这些话我们改日再谈，否则会聊个没完，而洛德先生会对我生气的。",shape=box,color=blue];
		j3722533636 -> j4192617946;
	j4192617946 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4192617946 -> j2370243200 [label="x > 0",color=purple];
		j4192617946 -> j3490532208 [label="x <= 0",color=purple];
		j4192617946 -> j3490532208 [label="false",color=purple];
	j2370243200 [label="Pardonnez​-moi ！​我​没​给​到​你​回答​的​机会。​那么，​你为什么要​帮助​恶魔 ​？​",shape=box,color=blue];
		j2370243200 -> j4161602025;
		j2370243200 -> j3935433283;
		j2370243200 -> j1297645942;
		j2370243200 -> j960167888;
	j3490532208 [label="Pardonnez​-moi ！​我​没​给​到​你​回答​的​机会。​那么，​你​会​帮助​恶魔​吗 ？​",shape=box,color=blue];
		j3490532208 -> j960167888;
		j3490532208 -> j1297645942;
		j3490532208 -> j3935433283;
		j3490532208 -> j4161602025;
	j4161602025 [label="他还没有做出让我觉得他不值得帮助的事情……至少目前还没有。",shape=box,color=red];
		j4161602025 -> j4139245347;
	j3935433283 [label="我觉得我不能拒绝盟友。",shape=box,color=red];
		j3935433283 -> j3315132776;
	j1297645942 [label="[承认对罗瑟感兴趣] 他身上有一种令人着迷的东西……",shape=box,color=red];
		j1297645942 -> j398321122;
	j960167888 [label="他看起来是为了活下去而做的那些事。我不能因此怪他。",shape=box,color=red];
		j960167888 -> j446769907;
	j4139245347 [label="Add 1 to Thermostat counter",color=orange];
		j4139245347 -> j265885375;
	j3315132776 [label="Boolean MarieRoatheSoldier is now true.",color=orange];
		j3315132776 -> j1672919855;
	j398321122 [label="Boolean DrifterRoathe is now true.",color=orange];
		j398321122 -> j4195795733;
	j446769907 [label="Add -1 to Thermostat counter",color=orange];
		j446769907 -> j201743793;
	j265885375 [label="+5 Chemistry",color=orange];
		j265885375 -> j423324826;
	j1672919855 [label="啊，我明白了。你只是在收集士兵罢了。但那恶魔宁愿在你肋间捅刀，也不会替你守护后背。",shape=box,color=blue];
		j1672919855 -> j45810986;
	j4195795733 [label="Le diable séduit les cœurs les plus forts。他玩的是诡诈的游戏，但务必小心。确保你们只是表面交流，千万别深入交流。",shape=box,color=blue];
		j4195795733 -> j3933407769;
	j201743793 [label="可在我看来，他活得比任何人都长。我想，或许地狱该来把它自己的东西收回去，他似乎已经迷失了方向。",shape=box,color=blue];
		j201743793 -> j3933407769;
	j423324826 [label="我称颂你的怜悯之心，这让我心生喜悦。双耀神教导我们，众生皆可得助。众生皆可得赦。但……前提是他们主动去寻求。",shape=box,color=blue];
		j423324826 -> j1269302184;
	j45810986 [label="他不是你的盟友，也永远不会是。那个恶魔只会和那些对他有用的人站在一起。",shape=box,color=blue];
		j45810986 -> j2637509389;
		j45810986 -> j2260303211;
		j45810986 -> j4179388325;
	j3933407769 [label="+5 Chemistry",color=orange];
		j3933407769 -> j332222459;
	j1269302184 [label="若无休止地帮助那些从不耕耘自己救赎之田的人，那便是空虚的奴隶命运。",shape=box,color=blue];
		j1269302184 -> j2637509389;
		j1269302184 -> j2260303211;
		j1269302184 -> j4179388325;
	j2637509389 [label="我比你更了解奥罗金和他的处境。我不需要你的帮助。",shape=box,color=red];
		j2637509389 -> j3890824149;
	j2260303211 [label="我很感谢你的提醒。我和他打交道时会记住这些的。",shape=box,color=red];
		j2260303211 -> j165605812;
	j4179388325 [label="谢谢。但我自己能应付。而且，关键是？我经历过比他更糟糕的事。",shape=box,color=red];
		j4179388325 -> j1904962039;
	j332222459 [label="但我这样说有点失礼了……你并不了解他。也没看清他的真面目。我只是不希望你受到伤害。",shape=box,color=blue];
		j332222459 -> j2637509389;
		j332222459 -> j2260303211;
		j332222459 -> j4179388325;
	j3890824149 [label="Boolean MarieRoatheWarning is now true.",color=orange];
		j3890824149 -> j1537320959;
	j165605812 [label="+10 Chemistry",color=orange];
		j165605812 -> j1317925023;
	j1904962039 [label="+5 Chemistry",color=orange];
		j1904962039 -> j193407149;
	j1537320959 [label="Pardon。我对你和你那抵抗操纵的能力几乎一无所知。我只是担心，毕竟我们把我们的苦难都加到你身上了。",shape=box,color=blue];
		j1537320959 -> j1047331576;
	j1317925023 [label="这便是我想要请求的。Merci，Merci，Merci。现在，恐怕我得走了。",shape=box,color=blue];
		j1317925023 -> "Chat ends.";
	j193407149 [label="Oui，vous avez raison。我对你和你那抵抗操纵的能力几乎一无所知。我只是担心，毕竟我们把我们的苦难都加到你身上了。",shape=box,color=blue];
		j193407149 -> j1741756533;
	j1047331576 [label="我不会再逾越了。",shape=box,color=blue];
		j1047331576 -> "Chat ends.";
	j1741756533 [label="而现在，我恐怕得走了。",shape=box,color=blue];
