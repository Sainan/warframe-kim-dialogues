		257 -> 262;
	258 [label="Add -1 to Thermostat",color=orange];
		258 -> 263;
	259 [label="长胴鼓之夜。哦，我可以想象出来。Quelles couleurs magnifiques ！",shape=box,color=blue];
		259 -> 264;
	265 [label="+5 Chemistry",color=orange];
		265 -> 268;
	262 [label="Oui, je comprends。明明是只是墙里老鼠带来的臭味，我们却急着要放火烧屋。",shape=box,color=blue];
		262 -> 266;
	263 [label="Je meurs d'envie de savoir pourquoi ！不过这些话我们改日再谈，否则会聊个没完，而洛德先生会对我生气的。",shape=box,color=blue];
		263 -> 267;
	264 [label="我需要和洛德先生谈谈更多细节。但是 ！",shape=box,color=blue];
