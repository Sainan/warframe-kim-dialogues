		282 -> 285;
	281 [label="啊，我明白了。你只是在收集士兵罢了。但那恶魔宁愿在你肋间捅刀，也不会替你守护后背。",shape=box,color=blue];
		281 -> 284;
	280 [label="Le diable séduit les cœurs les plus forts。他玩的是诡诈的游戏，但务必小心。确保你们只是表面交流，千万别深入交流。",shape=box,color=blue];
		280 -> 283;
	279 [label="可在我看来，他活得比任何人都长。我想，或许地狱该来把它自己的东西收回去，他似乎已经迷失了方向。",shape=box,color=blue];
		279 -> 283;
	285 [label="我称颂你的怜悯之心，这让我心生喜悦。双耀神教导我们，众生皆可得助。众生皆可得赦。但……前提是他们主动去寻求。",shape=box,color=blue];
		285 -> 290;
	284 [label="他不是你的盟友，也永远不会是。那个恶魔只会和那些对他有用的人站在一起。",shape=box,color=blue];
		284 -> 287;
		284 -> 288;
