	283 [label="+5 Chemistry",color=orange];
		283 -> 286;
	290 [label="若无休止地帮助那些从不耕耘自己救赎之田的人，那便是空虚的奴隶命运。",shape=box,color=blue];
		290 -> 287;
		290 -> 288;
		290 -> 289;
	287 [label="我比你更了解奥罗金和他的处境。我不需要你的帮助。",shape=box,color=red];
		287 -> 291;
	288 [label="我很感谢你的提醒。我和他打交道时会记住这些的。",shape=box,color=red];
		288 -> 292;
	289 [label="谢谢。但我自己能应付。而且，关键是？我经历过比他更糟糕的事。",shape=box,color=red];
		289 -> 293;
	286 [label="但我这样说有点失礼了……你并不了解他。也没看清他的真面目。我只是不希望你受到伤害。",shape=box,color=blue];
