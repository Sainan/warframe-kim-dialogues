digraph {
	237 [label="MarieRank1Convo4 begins.",color=orange];
		237 -> 238;
	238 [label="我​能​问​个​问题​吗 ？​希望​不​会​太​冒昧。​我们​的​友谊​才​刚刚​开始，​对​你​而​言尤其​如此，​听说​你​已经​活​过​很多​岁​月​了。",shape=box,color=blue];
		238 -> 241;
