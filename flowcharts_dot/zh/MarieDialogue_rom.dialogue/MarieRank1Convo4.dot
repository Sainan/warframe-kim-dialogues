		238 -> 239;
	241 [label="其实我已经不太记得大部分的岁月了。 ",shape=box,color=red];
		241 -> 244;
	240 [label="当然，我不介意。问吧。",shape=box,color=red];
		240 -> 243;
	239 [label="[结束]",shape=box,color=red];
		239 -> 242;
	244 [label="太阳神啊 ！你的话太让我心痛了。你和恶魔都觉得自己的脑子一片空白，就像一本被撕去了几章的书，non ？",shape=box,color=blue];
		244 -> 246;
		244 -> 247;
	243 [label="+5 Chemistry",color=orange];
