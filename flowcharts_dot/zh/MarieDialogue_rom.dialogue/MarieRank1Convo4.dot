		245 -> 249 [label="x > 0",color=purple];
		245 -> 248 [label="x <= 0",color=purple];
		245 -> 248 [label="false",color=purple];
	250 [label="真的吗 ？看来只有你是这么想的。无论是孩子还是恶魔，似乎他俩都在寻找被遗忘的那部分自我。",shape=box,color=blue];
		250 -> 255;
		250 -> 256;
	251 [label="我这样问会不会太冒昧，为什么你看起来那么失落 ？孩子和恶魔的原因我知道，但你的我不知道。",shape=box,color=blue];
		251 -> 255;
		251 -> 256;
	249 [label="你为什么要答应帮助恶魔完成他的阴谋 ？我听说你要去为屠杀他族人的事负责。",shape=box,color=blue];
		249 -> 252;
		249 -> 253;
		249 -> 254;
	248 [label="你是打算帮助恶魔完成他的阴谋吗 ？我听说你要去为屠杀他族人的事负责。",shape=box,color=blue];
		248 -> 252;
		248 -> 253;
		248 -> 254;
	255 [label="我在无数岁月中已经死过很多次了，死在……呃？死在我自己手里。我不介意自己记不清那些事。",shape=box,color=red];
		255 -> 260;
	256 [label="简而言之，我受了……很多年的苦。我猜这大概是一种自我防御机制吧，选择遗忘。",shape=box,color=red];
		256 -> 261;
	252 [label="那是另一个我做的事。我相信应该把责任归咎于个人，而不是群体。",shape=box,color=red];
		252 -> 257;
	253 [label="那不是我干的，是那个孩子。但我跟那孩子一样恨奥罗金。",shape=box,color=red];
		253 -> 258;
	254 [label="在长胴鼓之夜，Tenno 攻击奥罗金的时候，我并不在场。是那个孩子干的。",shape=box,color=red];
		254 -> 259;
	260 [label="不怪你。如果我也遭受那样的虐待，我会迫不及待地把一切都藏起来。至少，我绝不会再去找回它们。",shape=box,color=blue];
		260 -> 265;
	261 [label="毋庸置疑！如果我也遭受那样的虐待，我的灵魂大概也会做出类似的反应。把所有无法修复、毫无益处的记忆都藏起来。",shape=box,color=blue];
		261 -> 265;
