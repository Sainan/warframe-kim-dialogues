	j3151953893 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3151953893 -> j2529015854;
	j1165661703 [label="正是洛德的清醒洞察力，让我得以透过自己蒙蔽的双眼看清真相。因为洛德深爱着主教——也就是他的阿尔布雷希特——但他同时也看清了他所有的缺点。",shape=box,color=blue];
		j1165661703 -> j900270973;
	j1053239024 [label="是的，他的确如此。然而他仍然能看清他所有的缺点。正是这种清醒的洞察力，让我得以透过自己蒙蔽的双眼看清真相。",shape=box,color=blue];
		j1053239024 -> j900270973;
