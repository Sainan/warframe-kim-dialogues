	"Chat ends." [color=orange];
	j55848547 [label="的确如此。",shape=box,color=red];
		j55848547 -> j177182544;
	j651587065 [label="他真这么做了？",shape=box,color=red];
		j651587065 -> j3492418713;
	j373983818 [label="的确如此。",shape=box,color=red];
		j373983818 -> j1982122406;
	j3122078050 [label="的确如此。",shape=box,color=red];
		j3122078050 -> j1575921918;
	j177182544 [label="我真的非常抱歉。我知道我伤到你了。我真的不是故意的。我最不想做的，就是伤害你。",shape=box,color=red];
		j177182544 -> j3034259054;
	j3492418713 [label="Je vais le tuer ！Je savais que ce démon était rempli de la pire merde qui soit ！Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses ！",shape=box,color=blue];
		j3492418713 -> "Chat ends.";
	j1982122406 [label="我不会花太多时间谈这个，因为你不在的时候他已经说了不少有说服力的话了。而且，恶魔总是这样，他确实说得很有道理。",shape=box,color=blue];
		j1982122406 -> j2243952661;
	j1575921918 [label="我不会花太多时间谈这个，因为你不在的时候他已经说了不少有说服力的话了。而且，恶魔总是这样，他确实说得很有道理。",shape=box,color=blue];
		j1575921918 -> j3495032487;
	j3034259054 [label="那你为什么要这样做 ？",shape=box,color=blue];
		j3034259054 -> j1475651963;
		j3034259054 -> j2629038953;
	j2243952661 [label="我承认，我……越来越厌倦被困在这里，没有任何出路。",shape=box,color=blue];
		j2243952661 -> j3498747929;
	j3495032487 [label="但​你​应该​感谢​的​并非​他​的话，​而​是​他​的​机智。​他​让​我​和​洛德​先生​坐​下来谈。​",shape=box,color=blue];
		j3495032487 -> j1112157429;
		j3495032487 -> j2748213913;
	j1475651963 [label="[表白心意] 因为我非常在乎你，玛丽。我喜欢你。",shape=box,color=red];
		j1475651963 -> j1251470410;
	j2629038953 [label="算了，这显然是个错误。",shape=box,color=red];
		j2629038953 -> j3656558376;
	j3498747929 [label="所以，我说，好的。我会帮你。你会得到我的帮助。",shape=box,color=blue];
