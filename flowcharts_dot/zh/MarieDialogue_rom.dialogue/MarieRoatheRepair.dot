		3816 -> 3820 [label="false",color=purple];
	3817 [label="漂泊者。我被那个恶魔缠上了。他带着他那些小恶魔不停来烦我 ！还说是替你说的 ！他说你跪着求我原谅。",shape=box,color=blue];
		3817 -> 3821;
		3817 -> 3822;
	3818 [label="我被那个恶魔缠上了。他带着他那些小恶魔不停来烦我 ！还说是替你说的 ！他说你想谈谈让我帮你说服洛德先生上楼的事 ？",shape=box,color=blue];
		3818 -> 3823;
		3818 -> 3824;
	3819 [label="我被那个恶魔缠上了。他带着他那些小恶魔不停来烦我 ！还说是替你说的 ！他说你想谈谈我对主教的坚持 ？",shape=box,color=blue];
		3819 -> 3825;
		3819 -> 3826;
	3820 [label="Chat ends.",color=orange];
	3821 [label="的确如此。",shape=box,color=red];
		3821 -> 3827;
	3822 [label="他真这么做了？",shape=box,color=red];
		3822 -> 3828;
	3823 [label="的确如此。",shape=box,color=red];
		3823 -> 3829;
	3824 [label="他真这么做了？",shape=box,color=red];
		3824 -> 3828;
	3825 [label="的确如此。",shape=box,color=red];
		3825 -> 3830;
	3826 [label="他真这么做了？",shape=box,color=red];
		3826 -> 3828;
	3827 [label="我真的非常抱歉。我知道我伤到你了。我真的不是故意的。我最不想做的，就是伤害你。",shape=box,color=red];
		3827 -> 3831;
	3828 [label="Je vais le tuer ！Je savais que ce démon était rempli de la pire merde qui soit ！Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses ！",shape=box,color=blue];
		3828 -> 3832;
	3829 [label="我不会花太多时间谈这个，因为你不在的时候他已经说了不少有说服力的话了。而且，恶魔总是这样，他确实说得很有道理。",shape=box,color=blue];
		3829 -> 3833;
	3830 [label="我不会花太多时间谈这个，因为你不在的时候他已经说了不少有说服力的话了。而且，恶魔总是这样，他确实说得很有道理。",shape=box,color=blue];
		3830 -> 3834;
	3831 [label="那你为什么要这样做 ？",shape=box,color=blue];
		3831 -> 3835;
		3831 -> 3836;
	3832 [label="Chat ends.",color=orange];
	3833 [label="我承认，我……越来越厌倦被困在这里，没有任何出路。",shape=box,color=blue];
		3833 -> 3837;
	3834 [label="但​你​应该​感谢​的​并非​他​的话，​而​是​他​的​机智。​他​让​我​和​洛德​先生​坐​下来谈。​",shape=box,color=blue];
		3834 -> 3838;
		3834 -> 3839;
	3835 [label="[表白心意] 因为我非常在乎你，玛丽。我喜欢你。",shape=box,color=red];
		3835 -> 3840;
	3836 [label="算了，这显然是个错误。",shape=box,color=red];
		3836 -> 3841;
	3837 [label="所以，我说，好的。我会帮你。你会得到我的帮助。",shape=box,color=blue];
		3837 -> 3842;
	3838 [label="哦？",shape=box,color=red];
		3838 -> 3843;
	3839 [label="但洛德爱着阿尔布雷希特，不是吗？",shape=box,color=red];
		3839 -> 3844;
	3840 [label="我知道自己会说错话。果不其然，我真的说错了话。",shape=box,color=red];
		3840 -> 3845;
	3841 [label="你和他一样恶劣。",shape=box,color=blue];
		3841 -> 3846;
	3842 [label="Update boolean MarieFamilySuccess",color=orange];
		3842 -> 3847;
	3843 [label="正是洛德的清醒洞察力，让我得以透过自己蒙蔽的双眼看清真相。因为洛德深爱着主教——也就是他的阿尔布雷希特——但他同时也看清了他所有的缺点。",shape=box,color=blue];
		3843 -> 3848;
	3844 [label="是的，他的确如此。然而他仍然能看清他所有的缺点。正是这种清醒的洞察力，让我得以透过自己蒙蔽的双眼看清真相。",shape=box,color=blue];
		3844 -> 3848;
	3845 [label="我很抱歉让罗瑟帮忙来引起你的注意，但我不知道还能找谁帮忙。",shape=box,color=red];
		3845 -> 3849;
	3846 [label="Chat ends.",color=orange];
	3847 [label="Update boolean MarieFamilyFail",color=orange];
		3847 -> 3850;
	3848 [label="爱一个人意味着什么 ？不就是接受他的一切，无论对方的好坏，无论对方是怎样 ？",shape=box,color=blue];
		3848 -> 3851;
	3849 [label="哦，漂泊者……我可怜的漂泊者。你不必费这么大劲去得到我的原谅。 ",shape=box,color=blue];
		3849 -> 3852;
	3850 [label="Chat ends.",color=orange];
	3851 [label="Update boolean MarieEntratiCompleteA",color=orange];
		3851 -> 3853;
	3852 [label="只要你开口，我肯定会原谅你的。你知道吗 ？你已经在我心里占有一席之地了。",shape=box,color=blue];
		3852 -> 3854;
		3852 -> 3855;
	3853 [label="Update boolean MarieEntratiCompleteB",color=orange];
		3853 -> 3856;
	3854 [label="我……真的吗？",shape=box,color=red];
		3854 -> 3857;
	3855 [label="但我搞出了这么多事……",shape=box,color=red];
		3855 -> 3858;
	3856 [label="Update boolean MarieEntratiCompleteC",color=orange];
		3856 -> 3859;
	3857 [label="Oui ！如果你也想和我在一起，那我也很愿意。",shape=box,color=blue];
		3857 -> 3860;
		3857 -> 3861;
	3858 [label="那都是你自己的错，不是我的 ！但如果你想和我在一起，那我也很愿意。",shape=box,color=blue];
		3858 -> 3861;
		3858 -> 3860;
	3859 [label="Chat ends.",color=orange];
	3860 [label="玛丽，我非常愿意。",shape=box,color=red];
		3860 -> 3862;
	3861 [label="想了一下，还是算了。",shape=box,color=red];
		3861 -> 3863;
	3862 [label="啊！你太让我高兴了 ！",shape=box,color=blue];
