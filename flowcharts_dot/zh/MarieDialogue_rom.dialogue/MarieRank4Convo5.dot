	"MarieRank4Convo5 begins." [color=orange];
		"MarieRank4Convo5 begins." -> j1316635360;
	j1316635360 [label="Evaluate expressions",color=orange];
		j1316635360 -> j3680727912 [label="LoidFamilyComplete",color=purple];
		j1316635360 -> j3766718224 [label="MarieFamilyOther",color=purple];
		j1316635360 -> j436396400 [label="MarieFamily2",color=purple];
		j1316635360 -> j436396400 [label="MarieFamily1",color=purple];
		j1316635360 -> j1845397173 [label="false",color=purple];
	j3680727912 [label="漂泊者 ！我一直在谋划。",shape=box,color=blue];
		j3680727912 -> j3696322345;
		j3680727912 -> j1038552372;
	j3766718224 [label="漂泊者 ！我一直在想，琢磨着你说的那些关于楼上那家人的话。他们可能会把我们当成闯入者什么的。",shape=box,color=blue];
		j3766718224 -> j4080180068;
	j436396400 [label="漂泊者 ！我一直在想你说的那些关于楼上那家人的话。我为他们感到难过……",shape=box,color=blue];
		j436396400 -> j1000557311;
	j1845397173 [label="为什么我们不能去楼上 ？为什么我们不能和那些主教的 famille 说话 ？",shape=box,color=blue];
		j1845397173 -> j2013391633;
		j1845397173 -> j1038552372;
	j3696322345 [label="我应该开始担心吗 ？",shape=box,color=red];
		j3696322345 -> j61392362;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j4080180068 [label="作为 compétition 中的“另一个家庭”，oui ？这让我很困扰。",shape=box,color=blue];
		j4080180068 -> j1000557311;
	j1000557311 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j1000557311 -> j1681302097 [label=true,color=green];
		j1000557311 -> j3642914 [label=false,color=brown];
	j2013391633 [label="嗯……简而言之，英择谛家族有几位在楼上，而他们……完全不知道我们就在楼下。",shape=box,color=red];
		j2013391633 -> j1227332441;
	j61392362 [label="Oui ！那些飞来飞去的小机器人。殁世……殁世……你管他们叫什么 ?",shape=box,color=blue];
		j61392362 -> j3049800667;
	"Chat ends." [color=orange];
	j1681302097 [label="我们不是来抢主教的爱，我们该怎么让他们明白这一点呢 ？",shape=box,color=blue];
		j1681302097 -> j3962190319;
		j1681302097 -> j1611487104;
		j1681302097 -> j108166670;
	j3642914 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j3642914 -> j1681302097 [label=true,color=green];
		j3642914 -> j927981519 [label=false,color=brown];
	j1227332441 [label="Boolean MarieFamily1 is now true.",color=orange];
		j1227332441 -> j2967879603;
	j3049800667 [label="殁世微灵 ?",shape=box,color=red];
		j3049800667 -> j1298682163;
	j3962190319 [label="你说得对。你没法去争取一个人根本就没有的东西。",shape=box,color=red];
		j3962190319 -> j380005824;
	j1611487104 [label="揭开那些结痂的伤口很危险。你可能会清除掉感染……也可能因此失血过多。",shape=box,color=red];
		j1611487104 -> j2952898253;
	j108166670 [label="你们——和我们——都有一个共同点。都是在某个时刻，都被英择谛遗弃了。",shape=box,color=red];
		j108166670 -> j2515192195;
	j927981519 [label="你调解他们家庭矛盾的进展如何 ？",shape=box,color=blue];
		j927981519 -> j809002160;
		j927981519 -> j4279909817;
		j927981519 -> j1897580892;
		j927981519 -> j1038552372;
	j2967879603 [label="Par les Luminaires……你是说我们都在这里秘密活动 ？！所以才不让我们离开这里 ？！Mais pourquoi ？！",shape=box,color=blue];
		j2967879603 -> j858278087;
	j1298682163 [label="Oui ！哈 ！他们总是执着地要换家具，不是吗 ？可我发现，就算你挪动一下位置……他们还是会照样干同样的事。",shape=box,color=blue];
		j1298682163 -> j3560835919;
	j380005824 [label="Evaluate expressions",color=orange];
		j380005824 -> j949241298 [label="MarieEntrati3a",color=purple];
		j380005824 -> j949241298 [label="MarieEntrati3b",color=purple];
		j380005824 -> j949241298 [label="MarieEntrati3",color=purple];
		j380005824 -> j2499263280 [label="MarieEntratiFamily",color=purple];
		j380005824 -> j1114116457 [label="MarieEntratiMonster1",color=purple];
		j380005824 -> j1114116457 [label="MarieEntratiMonster2",color=purple];
		j380005824 -> j3208801776 [label="MarieEntratiFan1",color=purple];
		j380005824 -> j3208801776 [label="MarieEntratiFan2",color=purple];
		j380005824 -> j2898887132 [label="MarieEntratiNeutral",color=purple];
		j380005824 -> j2499263280 [label="false",color=purple];
	j2952898253 [label="Evaluate expressions",color=orange];
		j2952898253 -> j2133975953 [label="MarieEntrati3a",color=purple];
		j2952898253 -> j2133975953 [label="MarieEntrati3b",color=purple];
		j2952898253 -> j1897023875 [label="MarieEntrati3",color=purple];
		j2952898253 -> j3580511699 [label="MarieEntratiFamily",color=purple];
		j2952898253 -> j2631798094 [label="MarieEntratiMonster1",color=purple];
		j2952898253 -> j2631798094 [label="MarieEntratiMonster2",color=purple];
		j2952898253 -> j1787607364 [label="MarieEntratiFan1",color=purple];
		j2952898253 -> j1787607364 [label="MarieEntratiFan2",color=purple];
		j2952898253 -> j1041032613 [label="MarieEntratiNeutral",color=purple];
		j2952898253 -> j2205522650 [label="false",color=purple];
	j2515192195 [label="Evaluate expressions",color=orange];
		j2515192195 -> j3160111932 [label="MarieEntrati3a",color=purple];
		j2515192195 -> j3160111932 [label="MarieEntrati3b",color=purple];
		j2515192195 -> j2384495092 [label="MarieEntrati3",color=purple];
		j2515192195 -> j75477350 [label="MarieEntratiFamily",color=purple];
		j2515192195 -> j2631798094 [label="MarieEntratiMonster1",color=purple];
		j2515192195 -> j2631798094 [label="MarieEntratiMonster2",color=purple];
		j2515192195 -> j1787607364 [label="MarieEntratiFan1",color=purple];
		j2515192195 -> j1787607364 [label="MarieEntratiFan2",color=purple];
		j2515192195 -> j1041032613 [label="MarieEntratiNeutral",color=purple];
		j2515192195 -> j2562883536 [label="false",color=purple];
	j809002160 [label="说实话 ？我有点分心了。",shape=box,color=red];
		j809002160 -> j781627411;
	j4279909817 [label="还能再好一点吧。",shape=box,color=red];
		j4279909817 -> j1048086681;
	j1897580892 [label="已经有点进展了。",shape=box,color=red];
		j1897580892 -> j3298227091;
	j858278087 [label="是因为他的女儿欧拉瑞娅——人称“母亲”，以及她的家人，一直都在照顾着火卫二。",shape=box,color=red];
		j858278087 -> j3382264515;
	j3560835919 [label="要是我们干脆把所有家具都搬走，让他们再去换一遍，然后……再来一次呢 ？我们还能把那些东西都卖掉，赚一笔 de ce mobilier étrange ! ",shape=box,color=blue];
		j3560835919 -> j66860200;
		j3560835919 -> j2171992054;
		j3560835919 -> j4254410165;
	j949241298 [label="我很清楚我们在主教问题上仍有分歧。但我有在尽力保持这次对话的 civilisée。",shape=box,color=blue];
		j949241298 -> j1655088434;
	j2499263280 [label="我理解，如果没有找到机会指责那些你认为应该受到指责的人，你可能不太愿意谈如何修复裂痕。",shape=box,color=blue];
		j2499263280 -> j1655088434;
	j1114116457 [label="Oui ！毕竟你经常提醒我，你认为他是个怪物 ！他心里只有怨恨和空虚 ！",shape=box,color=blue];
		j1114116457 -> j1655088434;
	j3208801776 [label="我还以为在这场为主教的灵魂而战的战争中，你是站在我这边的 ？",shape=box,color=blue];
		j3208801776 -> j1739734393;
	j2898887132 [label="我记得你还没想好怎么看待主教的事 ？还是说现在你的想法已经改变了 ？",shape=box,color=blue];
		j2898887132 -> j119168467;
		j2898887132 -> j2943419526;
	j2133975953 [label="Oui。我正从标弃先生那学到这个……",shape=box,color=blue];
		j2133975953 -> j3395758968;
	j1897023875 [label="狼，别跟我提那些结痂的伤口了。上次我们讨论主教留下的伤口，我至今还在舔舐。",shape=box,color=blue];
		j1897023875 -> j1655088434;
	j3580511699 [label="是的，但你之前说过——我们应该停止为我们遭受的这些伤害互相指责。",shape=box,color=blue];
		j3580511699 -> j2169794508;
	j2631798094 [label="我知道你认为主教是个可怕的怪物，因为是他造成了这些伤口。",shape=box,color=blue];
		j2631798094 -> j1655088434;
	j1787607364 [label="我知道在这场为主教的灵魂而战的战争中，你是站在我这边的，对此我将永远心怀感激。",shape=box,color=blue];
		j1787607364 -> j2205522650;
	j1041032613 [label="我知道你不会对他做出评判，对此我深表感激。",shape=box,color=blue];
		j1041032613 -> j2205522650;
	j2205522650 [label="虽然我知道其他人急于怪罪于他，但我不希望看到本可以团结一致的我们却陷入分裂和流血。",shape=box,color=blue];
		j2205522650 -> j3512518222;
	j3160111932 [label="Oui。尽管我正从标弃先生那——学到这个，但也许每个人的情况并不相同。",shape=box,color=blue];
		j3160111932 -> j3395758968;
	j2384495092 [label="而且我了解到，不是每个人的情况都相同，正如你如此“好心”地向我指出的那样，non ？",shape=box,color=blue];
		j2384495092 -> j1655088434;
	j75477350 [label="Oui，是的 ！不过我并不怪主教的离开，因为他所做的事是神圣的——",shape=box,color=blue];
		j75477350 -> j2205522650;
	j2562883536 [label="尽管其他人急于将他们的痛苦怪罪于他，但我只是不希望看到我们分裂和受苦。",shape=box,color=blue];
		j2562883536 -> j3512518222;
	j781627411 [label="还有什么能让你分心呢 ？还有什么比坐下来处理那些 mécontents 的抱怨更重要呢 ？",shape=box,color=blue];
		j781627411 -> j841618336;
	j1048086681 [label="坐下来处理那些 mécontents 的抱怨有什么困难呢 ？",shape=box,color=blue];
		j1048086681 -> j2527764904;
	j3298227091 [label="哦，magnifique ！",shape=box,color=blue];
		j3298227091 -> j1077346059;
	j3382264515 [label="守护着这个地方，以及那颗向始源星系输送虚空能量的心脏，自英择谛离开后，它始终维系着我们所有人的……存续。",shape=box,color=red];
		j3382264515 -> j3916832970;
	j66860200 [label="我可不觉得英择谛的椅子能卖出什么价……",shape=box,color=red];
		j66860200 -> j931039529;
	j2171992054 [label="我们迟早会把市场都冲垮吧 ？到时候只能贱卖了……",shape=box,color=red];
		j2171992054 -> j931039529;
	j4254410165 [label="完美。我看这主意一点毛病都没有。",shape=box,color=red];
		j4254410165 -> j3828365329;
	j1655088434 [label="虽然我知道这两个话题是密不可分的，但我还是希望今天的谈话是有成效的，oui ？",shape=box,color=blue];
		j1655088434 -> j3376996716;
	j1739734393 [label="狼，这是你的什么骗局？还是说小玛丽只是你的 un jeu ？",shape=box,color=blue];
		j1739734393 -> j1733080525;
		j1739734393 -> j2943419526;
	j119168467 [label="我还没想好他的行为是否必要。但他冷酷无情的本性毋庸置疑。",shape=box,color=red];
		j119168467 -> j1655088434;
	j2943419526 [label="我厌倦了作戏，对不起。",shape=box,color=red];
		j2943419526 -> j2365463455;
	j3395758968 [label="我们应该停止为我们遭受的这些伤害互相指责。",shape=box,color=blue];
		j3395758968 -> j2169794508;
	j2169794508 [label="我​并不​认同​对​主教​的​责怪，​但​我​不​希望​看到​本​可以​团结​一​致​的​我们​却​陷入​分裂​和​流血。​",shape=box,color=blue];
		j2169794508 -> j2676019227;
		j2169794508 -> j1541102486;
	j3512518222 [label="我们应该停止为我们遭受的这些伤害互相指责，无论最终是谁的错。",shape=box,color=blue];
		j3512518222 -> j2676019227;
		j3512518222 -> j1541102486;
	j841618336 [label="我开玩笑的，开玩笑的 ！我真无法想象你有多忙，有太多的地方、太多的年代都需要你。",shape=box,color=blue];
		j841618336 -> j1077346059;
	j2527764904 [label="我开玩笑的，开玩笑的 ！我无法理解他们经历了什么。而你要解开这一切又是多么困难。",shape=box,color=blue];
		j2527764904 -> j1077346059;
	j1077346059 [label="我只是担心，如果他们的问题不解决，我们永远不可能被他们接纳。更大的问题仍然没有解决——",shape=box,color=blue];
		j1077346059 -> j1681302097;
	j3916832970 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3916832970 -> j987288472 [label=true,color=green];
		j3916832970 -> j3337182392 [label=false,color=brown];
	j931039529 [label="呸 ！我依然觉得这是个值得一试的实验。或许我们能用书柜之海把恶魔困在其中 ！",shape=box,color=blue];
		j931039529 -> j3948803883;
	j3828365329 [label="我会无视你的讽刺，因为我认为这是值得一试的实验。或许我们可以用成排书架，把那位恶魔困在书海中央 ！",shape=box,color=blue];
		j3828365329 -> j3948803883;
	j3376996716 [label="我想帮助我们所有人解决这个……我们发现的奇怪的共存问题，而不是吵架。",shape=box,color=blue];
		j3376996716 -> j3395758968;
	j1733080525 [label="不，不是游戏。但英择​谛不​可信，除了假装站在你这边，我不知道还有什么其他办法可以说服你。",shape=box,color=red];
		j1733080525 -> j40932329;
	j2365463455 [label="Oui ？很好，我很高兴地告诉你，你不需要再这么做了。",shape=box,color=blue];
		j2365463455 -> j1509439757;
	j2676019227 [label="我们团结一心，就像一个……奇怪的家庭。但无论如何，我们依然是一家人。",shape=box,color=red];
		j2676019227 -> j1625808289;
	j1541102486 [label="我们团结起来会比各自为战更加强大。",shape=box,color=red];
		j1541102486 -> j1937755344;
		j1541102486 -> j2825662750;
	j987288472 [label="她已经接受了他离开的事实，他们也和好了，但那是来之不易的。",shape=box,color=red];
		j987288472 -> j996567794;
	j3337182392 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j3337182392 -> j987288472 [label=true,color=green];
		j3337182392 -> j1878110857 [label=false,color=brown];
	j3948803883 [label="+20 Chemistry",color=orange];
		j3948803883 -> j3261815546;
	j40932329 [label="Oui ？可惜，我很高兴地告诉你，你失败了。",shape=box,color=blue];
		j40932329 -> j1509439757;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j1625808289 [label="Add +1 to Family counter",color=orange];
		j1625808289 -> j1937755344;
		j1625808289 -> j2825662750;
	j1937755344 [label="在我们受苦受难的时候，有时我们真正拥有的只有彼此。无论是我们被赐予的，还是我们自己遇到的。",shape=box,color=red];
		j1937755344 -> j1241430807;
	j2825662750 [label="我不知道长远来看，这究竟是好是坏。但这……像这样的炼狱，也不是对的。",shape=box,color=red];
		j2825662750 -> j3012007554;
	j996567794 [label="可​要​是​知道他还在外面四处惹事，却连一句都没有跟她说，甚至连封信都没寄……？",shape=box,color=red];
		j996567794 -> j2393849825;
	j1878110857 [label="她还没有接受他离开的事实，而且他们之间总是争吵不停。",shape=box,color=red];
		j1878110857 -> j2860352627;
	j3261815546 [label="事情很多 ！ À la revoyure ！",shape=box,color=blue];
		j3261815546 -> "Chat ends.";
	j2631316640 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j2631316640 -> j1508231473;
	j1241430807 [label="Add +1 to Family counter",color=orange];
		j1241430807 -> j3012007554;
	j3012007554 [label="Oui，我同意。但我无法成为弥合我们之间裂痕的人。我根本不知道该怎么做 ！对楼上的人来说我就是个陌生人……",shape=box,color=blue];
		j3012007554 -> j2786659239;
		j3012007554 -> j3731969706;
	j2393849825 [label="我无法想象这对她、对他们来说有多么痛苦。",shape=box,color=red];
		j2393849825 -> j4214298203;
	j2860352627 [label="可​要​是​知道他还在外面四处惹事，却连一句都没有跟她说，甚至连封信都没寄……？",shape=box,color=red];
		j2860352627 -> j1743367598;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j2786659239 [label="洛德认识英择谛家族。该由他来做这件事。然而，说服他……又是另一回事。",shape=box,color=red];
		j2786659239 -> j2985519360;
	j3731969706 [label="也许让罗瑟来 ？他是奥罗金人，他认识他们所有人。",shape=box,color=red];
		j3731969706 -> j2601224490;
	j4214298203 [label="虽然我能理解那个决定背后的逻辑，就是为了保护他们免受主教必须离开而造成的痛苦……",shape=box,color=blue];
		j4214298203 -> j4156680689;
	j1743367598 [label="这会毁掉他们之间仅存的那点和解机会。",shape=box,color=red];
		j1743367598 -> j2466784021;
	j2985519360 [label="+5 Chemistry",color=orange];
		j2985519360 -> j4097183833;
	j2601224490 [label="Non，不能是恶魔——除了恶魔，谁都可以。不过你说对了。首选自然是洛德先生，non ？",shape=box,color=blue];
		j2601224490 -> j1316935698;
	j4156680689 [label="但我确实觉得这太残忍了，你不觉得吗 ？他们可能会以为他死了。或者更糟 ！而我们，住在这里，comme des rats d'égout ？",shape=box,color=blue];
		j4156680689 -> j1604972283;
		j4156680689 -> j4037902021;
		j4156680689 -> j1572381365;
	j2466784021 [label="Oui……我明白其中的逻辑。如果可以的话，我也会努力修复他们的家庭，non ？这似乎是我们所有人离开这里的唯一希望。 ",shape=box,color=blue];
		j2466784021 -> j2740140460;
	j4097183833 [label="Oui，Oui ！C'est ça ！但我们怎么说服他呢 ？他可是一向立场坚定，non ？",shape=box,color=blue];
		j4097183833 -> j3505728167;
		j4097183833 -> j163898555;
	j1316935698 [label="但我们怎么说服他呢 ？他可是一向立场坚定，non ？",shape=box,color=blue];
		j1316935698 -> j163898555;
		j1316935698 -> j3505728167;
	j1604972283 [label="我其实有个朋友很喜欢老鼠。我也觉得它们很可爱。",shape=box,color=red];
		j1604972283 -> j1599147623;
	j4037902021 [label="其实这不是我做出的决定。",shape=box,color=red];
		j4037902021 -> j349913030;
	j1572381365 [label="你会建议我做什么 ？",shape=box,color=red];
		j1572381365 -> j1024024106;
	j2740140460 [label="以免我们余生都被困在这里，comme des rats d'égout。 ",shape=box,color=blue];
		j2740140460 -> j2540281546;
		j2740140460 -> j1254212036;
	j3505728167 [label="那你觉得里昂可以说服他吗 ？",shape=box,color=red];
		j3505728167 -> j89235684;
	j163898555 [label="玛丽，你不会喜欢我的答案的……",shape=box,color=red];
		j163898555 -> j2370007581;
	j1599147623 [label="我也很想哪天见一下那位朋友，但这不是我要说的重点，傻狼。",shape=box,color=blue];
		j1599147623 -> j1024024106;
	j349913030 [label="我知道。是否让自己被世人知道，是洛德先生，以及所有人的决定。",shape=box,color=blue];
		j349913030 -> j1024024106;
	j1024024106 [label="我认为，将我们困守于此的并非崇高情操，而是负罪感。",shape=box,color=blue];
		j1024024106 -> j2267884797;
	j2540281546 [label="我其实有个朋友很喜欢老鼠。我也觉得它们很可爱。 ",shape=box,color=red];
		j2540281546 -> j1599147623;
	j1254212036 [label="我确实疏忽了。你说得是对。我现在就着手处理。",shape=box,color=red];
		j1254212036 -> j3637057092;
	j89235684 [label="他挺喜欢我们的，他很善良，也很温柔。但我们对他来说是 étrangers，是新来的。",shape=box,color=blue];
		j89235684 -> j4132669452;
	j2370007581 [label="Ah bon ？",shape=box,color=blue];
		j2370007581 -> j190646624;
	j2267884797 [label="我们是在躲避某种重大而可怕的罪。",shape=box,color=blue];
		j2267884797 -> j3698713015;
	j3637057092 [label="谢谢。我不知道你是否会成功，但有时候，我们能做的只有去尝试。",shape=box,color=blue];
		j3637057092 -> j1024024106;
	j4132669452 [label="我会好好想想的。你也一样 ！一定会找到答案的，毕竟太阳神已经带领我们走到今天 ！",shape=box,color=blue];
		j4132669452 -> j1684486802;
	j190646624 [label="洛德或许会听罗瑟的。他作为奥罗金人——他们有着共同的经历——或许能派上用场。",shape=box,color=red];
		j190646624 -> j3426858020;
	j3698713015 [label="或许，这种罪孽必须被宽恕，或者被证明是错误的 ？",shape=box,color=blue];
		j3698713015 -> j1550579301;
		j3698713015 -> j3857598188;
	j1684486802 [label="+15 Chemistry",color=orange];
		j1684486802 -> j815512608;
	j3426858020 [label="Non ！他是个骗子，是个操纵者，他这么做只是为了换取更大的回报 ！",shape=box,color=blue];
		j3426858020 -> j2171333431;
	j1550579301 [label="楼上的情况……即使在最好的情况下也依旧脆弱。我不想让他们难过。",shape=box,color=red];
		j1550579301 -> j3926768905;
	j3857598188 [label="我们只能小心一点。恐怕一半的人会把另一半人当成“另一个家族”。",shape=box,color=red];
		j3857598188 -> j257761011;
	j815512608 [label="我们会找到办法说服洛德先生走上那些楼梯……我深知。",shape=box,color=blue];
		j815512608 -> j109088158;
	j2171333431 [label="我们会找到另一种办法说服洛德先生走上那些楼梯……我深知。",shape=box,color=blue];
		j2171333431 -> j2115168504;
	j3926768905 [label="灵魂的韧性会让人惊叹。而如今我身边的存在，都如此古老，如此饱经时间的磨砺。",shape=box,color=blue];
		j3926768905 -> j4251943579;
