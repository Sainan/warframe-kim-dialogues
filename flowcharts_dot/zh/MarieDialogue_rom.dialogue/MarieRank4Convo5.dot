		1651 -> 1674 [label="false",color=purple];
	1652 [label="还有什么能让你分心呢 ？还有什么比坐下来处理那些 mécontents 的抱怨更重要呢 ？",shape=box,color=blue];
		1652 -> 1676;
	1653 [label="坐下来处理那些 mécontents 的抱怨有什么困难呢 ？",shape=box,color=blue];
		1653 -> 1677;
	1654 [label="哦，magnifique ！",shape=box,color=blue];
		1654 -> 1678;
	1655 [label="Chat ends.",color=orange];
	1656 [label="是因为他的女儿欧拉瑞娅——人称“母亲”，以及她的家人，一直都在照顾着火卫二。",shape=box,color=red];
		1656 -> 1679;
	2937 [label="要是我们干脆把所有家具都搬走，让他们再去换一遍，然后……再来一次呢 ？我们还能把那些东西都卖掉，赚一笔 de ce mobilier étrange ! ",shape=box,color=blue];
		2937 -> 2938;
		2937 -> 2939;
		2937 -> 2940;
	1658 [label="我很清楚我们在主教问题上仍有分歧。但我有在尽力保持这次对话的 civilisée。",shape=box,color=blue];
		1658 -> 1680;
	1661 [label="我理解，如果没有找到机会指责那些你认为应该受到指责的人，你可能不太愿意谈如何修复裂痕。",shape=box,color=blue];
		1661 -> 1680;
	1657 [label="Oui ！毕竟你经常提醒我，你认为他是个怪物 ！他心里只有怨恨和空虚 ！",shape=box,color=blue];
		1657 -> 1680;
	1659 [label="我还以为在这场为主教的灵魂而战的战争中，你是站在我这边的 ？",shape=box,color=blue];
		1659 -> 1681;
	1660 [label="我记得你还没想好怎么看待主教的事 ？还是说现在你的想法已经改变了 ？",shape=box,color=blue];
		1660 -> 1682;
		1660 -> 1683;
	1668 [label="Oui。我正从标弃先生那学到这个……",shape=box,color=blue];
		1668 -> 1686;
	1662 [label="狼，别跟我提那些结痂的伤口了。上次我们讨论主教留下的伤口，我至今还在舔舐。",shape=box,color=blue];
		1662 -> 1680;
	1663 [label="是的，但你之前说过——我们应该停止为我们遭受的这些伤害互相指责。",shape=box,color=blue];
		1663 -> 1684;
	1664 [label="我知道你认为主教是个可怕的怪物，因为是他造成了这些伤口。",shape=box,color=blue];
		1664 -> 1680;
	1665 [label="我知道在这场为主教的灵魂而战的战争中，你是站在我这边的，对此我将永远心怀感激。",shape=box,color=blue];
		1665 -> 1666;
	1667 [label="我知道你不会对他做出评判，对此我深表感激。",shape=box,color=blue];
		1667 -> 1666;
	1666 [label="虽然我知道其他人急于怪罪于他，但我不希望看到本可以团结一致的我们却陷入分裂和流血。",shape=box,color=blue];
		1666 -> 1685;
	1675 [label="Oui。尽管我正从标弃先生那——学到这个，但也许每个人的情况并不相同。",shape=box,color=blue];
		1675 -> 1686;
	1669 [label="而且我了解到，不是每个人的情况都相同，正如你如此“好心”地向我指出的那样，non ？",shape=box,color=blue];
		1669 -> 1680;
	1670 [label="Oui，是的 ！不过我并不怪主教的离开，因为他所做的事是神圣的——",shape=box,color=blue];
		1670 -> 1666;
	1671 [label="我知道你认为主教是个可怕的怪物，因为是他造成了这些伤口。",shape=box,color=blue];
		1671 -> 1680;
	1672 [label="我知道在这场为主教的灵魂而战的战争中，你是站在我这边的，对此我将永远心怀感激。",shape=box,color=blue];
		1672 -> 1666;
	1673 [label="我知道你不会对他做出评判，对此我深表感激。",shape=box,color=blue];
		1673 -> 1666;
	1674 [label="尽管其他人急于将他们的痛苦怪罪于他，但我只是不希望看到我们分裂和受苦。",shape=box,color=blue];
		1674 -> 1685;
	1676 [label="我开玩笑的，开玩笑的 ！我真无法想象你有多忙，有太多的地方、太多的年代都需要你。",shape=box,color=blue];
		1676 -> 1678;
	1677 [label="我开玩笑的，开玩笑的 ！我无法理解他们经历了什么。而你要解开这一切又是多么困难。",shape=box,color=blue];
		1677 -> 1678;
	1678 [label="我只是担心，如果他们的问题不解决，我们永远不可能被他们接纳。更大的问题仍然没有解决——",shape=box,color=blue];
		1678 -> 1637;
	1679 [label="守护着这个地方，以及那颗向始源星系输送虚空能量的心脏，自英择谛离开后，它始终维系着我们所有人的……存续。",shape=box,color=red];
		1679 -> 1687;
	2938 [label="我可不觉得英择谛的椅子能卖出什么价……",shape=box,color=red];
		2938 -> 2942;
	2939 [label="我们迟早会把市场都冲垮吧 ？到时候只能贱卖了……",shape=box,color=red];
		2939 -> 2942;
	2940 [label="完美。我看这主意一点毛病都没有。",shape=box,color=red];
		2940 -> 2941;
	1680 [label="虽然我知道这两个话题是密不可分的，但我还是希望今天的谈话是有成效的，oui ？",shape=box,color=blue];
		1680 -> 1688;
	1681 [label="狼，这是你的什么骗局？还是说小玛丽只是你的 un jeu ？",shape=box,color=blue];
		1681 -> 1689;
		1681 -> 1683;
	1682 [label="我还没想好他的行为是否必要。但他冷酷无情的本性毋庸置疑。",shape=box,color=red];
		1682 -> 1680;
	1683 [label="我厌倦了作戏，对不起。",shape=box,color=red];
		1683 -> 1690;
	1686 [label="我们应该停止为我们遭受的这些伤害互相指责。",shape=box,color=blue];
		1686 -> 1684;
	1684 [label="我​并不​认同​对​主教​的​责怪，​但​我​不​希望​看到​本​可以​团结​一​致​的​我们​却​陷入​分裂​和​流血。​",shape=box,color=blue];
		1684 -> 1691;
		1684 -> 1692;
	1685 [label="我们应该停止为我们遭受的这些伤害互相指责，无论最终是谁的错。",shape=box,color=blue];
		1685 -> 1691;
		1685 -> 1692;
	1687 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1687 -> 1693 [label=true,color=green];
		1687 -> 1694 [label=false,color=brown];
	2942 [label="呸 ！我依然觉得这是个值得一试的实验。或许我们能用书柜之海把恶魔困在其中 ！",shape=box,color=blue];
		2942 -> 2943;
	2941 [label="我会无视你的讽刺，因为我认为这是值得一试的实验。或许我们可以用成排书架，把那位恶魔困在书海中央 ！",shape=box,color=blue];
		2941 -> 2943;
	1688 [label="我想帮助我们所有人解决这个……我们发现的奇怪的共存问题，而不是吵架。",shape=box,color=blue];
		1688 -> 1686;
	1689 [label="不，不是游戏。但英择​谛不​可信，除了假装站在你这边，我不知道还有什么其他办法可以说服你。",shape=box,color=red];
		1689 -> 1695;
	1690 [label="Oui ？很好，我很高兴地告诉你，你不需要再这么做了。",shape=box,color=blue];
		1690 -> 1696;
	1691 [label="我们团结一心，就像一个……奇怪的家庭。但无论如何，我们依然是一家人。",shape=box,color=red];
		1691 -> 1697;
	1692 [label="我们团结起来会比各自为战更加强大。",shape=box,color=red];
		1692 -> 1698;
		1692 -> 1699;
	1693 [label="她已经接受了他离开的事实，他们也和好了，但那是来之不易的。",shape=box,color=red];
		1693 -> 1700;
	1694 [label="她还没有接受他离开的事实，而且他们之间总是争吵不停。",shape=box,color=red];
		1694 -> 1701;
	2943 [label="+20 Chemistry",color=orange];
		2943 -> 2944;
	1695 [label="Oui ？可惜，我很高兴地告诉你，你失败了。",shape=box,color=blue];
		1695 -> 1696;
	1696 [label="Update boolean MarieEntratiFan1",color=orange];
		1696 -> 1702;
	1697 [label="Add +1 to Family",color=orange];
		1697 -> 1698;
		1697 -> 1699;
	1698 [label="在我们受苦受难的时候，有时我们真正拥有的只有彼此。无论是我们被赐予的，还是我们自己遇到的。",shape=box,color=red];
		1698 -> 1703;
	1699 [label="我不知道长远来看，这究竟是好是坏。但这……像这样的炼狱，也不是对的。",shape=box,color=red];
		1699 -> 1704;
	1700 [label="可​要​是​知道他还在外面四处惹事，却连一句都没有跟她说，甚至连封信都没寄……？",shape=box,color=red];
		1700 -> 1705;
	1701 [label="可​要​是​知道他还在外面四处惹事，却连一句都没有跟她说，甚至连封信都没寄……？",shape=box,color=red];
		1701 -> 1706;
	2944 [label="事情很多 ！ À la revoyure ！",shape=box,color=blue];
		2944 -> 2929;
	1702 [label="Update boolean MarieEntratiFan2",color=orange];
		1702 -> 1707;
	1703 [label="Add +1 to Family",color=orange];
		1703 -> 1704;
	1704 [label="Oui，我同意。但我无法成为弥合我们之间裂痕的人。我根本不知道该怎么做 ！对楼上的人来说我就是个陌生人……",shape=box,color=blue];
		1704 -> 1708;
		1704 -> 1709;
	1705 [label="我无法想象这对她、对他们来说有多么痛苦。",shape=box,color=red];
		1705 -> 1710;
	1706 [label="这会毁掉他们之间仅存的那点和解机会。",shape=box,color=red];
		1706 -> 1711;
	2929 [label="Chat ends.",color=orange];
	1707 [label="Update boolean MarieNoDate",color=orange];
		1707 -> 1712;
	1708 [label="洛德认识英择谛家族。该由他来做这件事。然而，说服他……又是另一回事。",shape=box,color=red];
		1708 -> 1713;
	1709 [label="也许让罗瑟来 ？他是奥罗金人，他认识他们所有人。",shape=box,color=red];
		1709 -> 1714;
	1710 [label="虽然我能理解那个决定背后的逻辑，就是为了保护他们免受主教必须离开而造成的痛苦……",shape=box,color=blue];
		1710 -> 1715;
	1711 [label="Oui……我明白其中的逻辑。如果可以的话，我也会努力修复他们的家庭，non ？这似乎是我们所有人离开这里的唯一希望。 ",shape=box,color=blue];
		1711 -> 1716;
	1712 [label="Chat ends.",color=orange];
	1713 [label="+5 Chemistry",color=orange];
		1713 -> 1717;
	1714 [label="Non，不能是恶魔——除了恶魔，谁都可以。不过你说对了。首选自然是洛德先生，non ？",shape=box,color=blue];
		1714 -> 1718;
	1715 [label="但我确实觉得这太残忍了，你不觉得吗 ？他们可能会以为他死了。或者更糟 ！而我们，住在这里，comme des rats d'égout ？",shape=box,color=blue];
		1715 -> 1719;
		1715 -> 1720;
		1715 -> 1721;
	1716 [label="以免我们余生都被困在这里，comme des rats d'égout。 ",shape=box,color=blue];
		1716 -> 1722;
		1716 -> 1723;
	1717 [label="Oui，Oui ！C'est ça ！但我们怎么说服他呢 ？他可是一向立场坚定，non ？",shape=box,color=blue];
		1717 -> 1724;
		1717 -> 1725;
	1718 [label="但我们怎么说服他呢 ？他可是一向立场坚定，non ？",shape=box,color=blue];
		1718 -> 1725;
		1718 -> 1724;
	1719 [label="我其实有个朋友很喜欢老鼠。我也觉得它们很可爱。",shape=box,color=red];
		1719 -> 1726;
	1720 [label="其实这不是我做出的决定。",shape=box,color=red];
		1720 -> 1727;
	1721 [label="你会建议我做什么 ？",shape=box,color=red];
		1721 -> 1728;
	1722 [label="我其实有个朋友很喜欢老鼠。我也觉得它们很可爱。 ",shape=box,color=red];
		1722 -> 1729;
	1723 [label="我确实疏忽了。你说得是对。我现在就着手处理。",shape=box,color=red];
		1723 -> 1730;
	1724 [label="那你觉得里昂可以说服他吗 ？",shape=box,color=red];
		1724 -> 1731;
	1725 [label="玛丽，你不会喜欢我的答案的……",shape=box,color=red];
		1725 -> 1732;
	1726 [label="我也很想哪天见一下那位朋友，但这不是我要说的重点，傻狼。",shape=box,color=blue];
		1726 -> 1728;
	1727 [label="我知道。是否让自己被世人知道，是洛德先生，以及所有人的决定。",shape=box,color=blue];
		1727 -> 1728;
	1728 [label="我认为，将我们困守于此的并非崇高情操，而是负罪感。",shape=box,color=blue];
		1728 -> 1733;
	1729 [label="我也很想哪天见一下那位朋友，但这不是我要说的重点，傻狼。",shape=box,color=blue];
		1729 -> 1728;
	1730 [label="谢谢。我不知道你是否会成功，但有时候，我们能做的只有去尝试。",shape=box,color=blue];
		1730 -> 1728;
	1731 [label="他挺喜欢我们的，他很善良，也很温柔。但我们对他来说是 étrangers，是新来的。",shape=box,color=blue];
		1731 -> 1734;
	1732 [label="Ah bon ？",shape=box,color=blue];
		1732 -> 1735;
	1733 [label="我们是在躲避某种重大而可怕的罪。",shape=box,color=blue];
		1733 -> 1736;
	1734 [label="我会好好想想的。你也一样 ！一定会找到答案的，毕竟太阳神已经带领我们走到今天 ！",shape=box,color=blue];
		1734 -> 1737;
	1735 [label="洛德或许会听罗瑟的。他作为奥罗金人——他们有着共同的经历——或许能派上用场。",shape=box,color=red];
		1735 -> 1738;
	1736 [label="或许，这种罪孽必须被宽恕，或者被证明是错误的 ？",shape=box,color=blue];
		1736 -> 1739;
		1736 -> 1740;
