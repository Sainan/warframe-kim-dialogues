	2930 [label="漂泊者 ！我一直在谋划。",shape=box,color=blue];
		2930 -> 2931;
		2930 -> 2932;
	1630 [label="漂泊者 ！我一直在想，琢磨着你说的那些关于楼上那家人的话。他们可能会把我们当成闯入者什么的。",shape=box,color=blue];
		1630 -> 1633;
	1631 [label="漂泊者 ！我一直在想你说的那些关于楼上那家人的话。我为他们感到难过……",shape=box,color=blue];
		1631 -> 1634;
	1632 [label="为什么我们不能去楼上 ？为什么我们不能和那些主教的 famille 说话 ？",shape=box,color=blue];
		1632 -> 1635;
		1632 -> 1636;
	2931 [label="我应该开始担心吗 ？",shape=box,color=red];
		2931 -> 2934;
	2932 [label="[结束]",shape=box,color=red];
		2932 -> 2933;
	1633 [label="作为 compétition 中的“另一个家庭”，oui ？这让我很困扰。",shape=box,color=blue];
		1633 -> 1634;
	1634 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1634 -> 1637 [label=true,color=green];
		1634 -> 1638 [label=false,color=brown];
	1635 [label="嗯……简而言之，英择谛家族有几位在楼上，而他们……完全不知道我们就在楼下。",shape=box,color=red];
		1635 -> 1639;
	1636 [label="[结束]",shape=box,color=red];
		1636 -> 1640;
	2934 [label="Oui ！那些飞来飞去的小机器人。殁世……殁世……你管他们叫什么 ?",shape=box,color=blue];
		2934 -> 2935;
	2933 [label="Chat ends.",color=orange];
	1637 [label="我们不是来抢主教的爱，我们该怎么让他们明白这一点呢 ？",shape=box,color=blue];
		1637 -> 1641;
		1637 -> 1642;
		1637 -> 1643;
	1638 [label="你调解他们家庭矛盾的进展如何 ？",shape=box,color=blue];
		1638 -> 1644;
		1638 -> 1645;
		1638 -> 1646;
		1638 -> 1647;
	1639 [label="Update boolean MarieFamily1",color=orange];
		1639 -> 1648;
	1640 [label="Chat ends.",color=orange];
	2935 [label="殁世微灵 ?",shape=box,color=red];
		2935 -> 2936;
	1641 [label="你说得对。你没法去争取一个人根本就没有的东西。",shape=box,color=red];
		1641 -> 1649;
	1642 [label="揭开那些结痂的伤口很危险。你可能会清除掉感染……也可能因此失血过多。",shape=box,color=red];
		1642 -> 1650;
	1643 [label="你们——和我们——都有一个共同点。都是在某个时刻，都被英择谛遗弃了。",shape=box,color=red];
		1643 -> 1651;
	1644 [label="说实话 ？我有点分心了。",shape=box,color=red];
		1644 -> 1652;
	1645 [label="还能再好一点吧。",shape=box,color=red];
		1645 -> 1653;
	1646 [label="已经有点进展了。",shape=box,color=red];
		1646 -> 1654;
	1647 [label="[结束]",shape=box,color=red];
		1647 -> 1655;
	1648 [label="Par les Luminaires……你是说我们都在这里秘密活动 ？！所以才不让我们离开这里 ？！Mais pourquoi ？！",shape=box,color=blue];
		1648 -> 1656;
	2936 [label="Oui ！哈 ！他们总是执着地要换家具，不是吗 ？可我发现，就算你挪动一下位置……他们还是会照样干同样的事。",shape=box,color=blue];
		2936 -> 2937;
