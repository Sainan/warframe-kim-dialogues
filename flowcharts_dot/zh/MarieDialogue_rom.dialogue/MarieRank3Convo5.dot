	1381 [label="+20 Chemistry",color=orange];
		1381 -> 1388;
	1382 [label="别让恶魔靠近。Sinon，il va les voler！他吃不饱的时候就会偷糕点！",shape=box,color=blue];
		1382 -> 1389;
	1390 [label="他们还在疗伤。他们的旅程还没结束呢。",shape=box,color=red];
		1390 -> 1398;
	1391 [label="我真希望自己能为他们做更多的事情。 ",shape=box,color=red];
		1391 -> 1398;
	1392 [label="Oui，你说得对。很多人寻求信仰，就是希望它能给他们带来目的，带来方向。",shape=box,color=blue];
		1392 -> 1399;
	1393 [label="（原来是这样拼写的，谢谢 ！）听到你这么说我真的很欣慰。即使是一个被灌输视战争为唯一目的的种族，也仍然能找到另一条路。",shape=box,color=blue];
		1393 -> 1400;
	1386 [label="这就对了！我想，就算是恶魔，偶尔也该吃些糕点。",shape=box,color=blue];
		1386 -> 1394;
	1387 [label="Je vous en prie。真希望我能让你开心，哪怕只是一点点。我知道你有让我觉得开心。",shape=box,color=blue];
		1387 -> 1402;
	1388 [label="啊，​这​我​要​抱怨​一下，​但​即使​是​最​卑微​的​恶魔​也​应该​偶尔​吃些​糕点，​ou​i ？​",shape=box,color=blue];
