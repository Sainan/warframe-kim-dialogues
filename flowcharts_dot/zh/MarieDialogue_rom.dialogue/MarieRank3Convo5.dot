	1362 [label="+10 Chemistry",color=orange];
		1362 -> 1366;
	1360 [label="但如果没有呢 ？我这有一个万无一失的解决方案 ！",shape=box,color=blue];
		1360 -> 1364;
	1363 [label="哈哈 ！Oui，确实如此。太好了，听你这么说我很高兴。",shape=box,color=blue];
		1363 -> 1367;
	1365 [label="Oui，但那样的你就不是我们所熟知和喜爱的那只放荡不羁的狼了，对吧 ？我觉得太阳神把你放在了该走的路上。",shape=box,color=blue];
		1365 -> 1369;
	1366 [label="Oui，我完全同意。没有人生来就是为了投入到战争。好吧，除非是那些我听说的“Grin-ire”，但即便如此……",shape=box,color=blue];
		1366 -> 1370;
	1364 [label="Des pâtisseries ！",shape=box,color=blue];
		1364 -> 1368;
	1367 [label="啊 ！午餐准备好了。我得走了。回头见，狼。很高兴我们聊了天。",shape=box,color=blue];
		1367 -> 1371;
	1369 [label="但我明白你的意思。你看到了另一个你所拥有的框架和指导，不免会希望自己当初也拥有同样的东西。尤其是在你那么孤独的时候。",shape=box,color=blue];
		1369 -> 1376;
