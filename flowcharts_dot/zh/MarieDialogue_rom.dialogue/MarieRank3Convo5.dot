	j3777421692 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3777421692 -> j1402799028;
	j1402799028 [label="Check boolean DrifterFaithSol",color=orange];
		j1402799028 -> j3729336356 [label=true,color=green];
		j1402799028 -> j2256643707 [label=false,color=brown];
	j3729336356 [label="Ma famille à Sol ！​我​同侍奉太​阳神​的​家人，​你​今天​过​得​怎么样​ ？​",shape=box,color=blue];
		j3729336356 -> j2465675095;
		j3729336356 -> j2086054221;
		j3729336356 -> j3219491300;
		j3729336356 -> j1280177187;
		j3729336356 -> j1038552372;
	j2256643707 [label="Bonjour ！今天过得怎么样？",shape=box,color=blue];
		j2256643707 -> j2465675095;
		j2256643707 -> j2086054221;
		j2256643707 -> j3219491300;
		j2256643707 -> j1280177187;
		j2256643707 -> j1038552372;
	j2465675095 [label="我很好，你呢？",shape=box,color=red];
		j2465675095 -> j3082783407;
	j2086054221 [label="不如以前，不过还是谢谢你关心。你好吗 ？",shape=box,color=red];
		j2086054221 -> j2219153595;
	j3219491300 [label="我……现在应该向你忏悔我之前撒了谎，我……并不是太阳神的追随者。",shape=box,color=red];
		j3219491300 -> j2848196261;
	j1280177187 [label="跟你说话之后感觉好多了。你的存在让我的每一天都更加美好。",shape=box,color=red];
		j1280177187 -> j2409975641;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j3082783407 [label="我也过得不错。不过仔细想想，我感觉自己不应该这样。",shape=box,color=blue];
		j3082783407 -> j477419532;
		j3082783407 -> j3890945771;
	j2219153595 [label="我挺好的，但现在你让我很好奇。Qu'y a-t-il ？",shape=box,color=blue];
		j2219153595 -> j1003094086;
		j2219153595 -> j3784377670;
		j2219153595 -> j1468824585;
		j2219153595 -> j4276144423;
	j2848196261 [label="哦 ！我……知道了。Pourquoi ？",shape=box,color=blue];
		j2848196261 -> j3151304635;
		j2848196261 -> j817028461;
		j2848196261 -> j3897256069;
	j2409975641 [label="狼 ！你让我差点从椅子上摔下来了 ！",shape=box,color=blue];
		j2409975641 -> j19905978;
		j2409975641 -> j4084220665;
	"Chat ends." [color=orange];
	j477419532 [label="这是什么意思？",shape=box,color=red];
		j477419532 -> j3121162059;
	j3890945771 [label="我曾经也踩过相同的坑。",shape=box,color=red];
		j3890945771 -> j1584078489;
	j1003094086 [label="这……很难解释。",shape=box,color=red];
		j1003094086 -> j995790845;
	j3784377670 [label="要担心的事情太多，留给我的时间却太少。",shape=box,color=red];
		j3784377670 -> j2107765285;
	j1468824585 [label="我的一个朋友曾经把它描述成“蜘蛛”。它们会时不时地爬进来。",shape=box,color=red];
		j1468824585 -> j3945769924;
	j4276144423 [label="有时候，所有事……会一下子都压到我身上。但我会没事的。",shape=box,color=red];
		j4276144423 -> j2524365762;
	j3151304635 [label="我当时觉得这是一个更好地了解你的机会……",shape=box,color=red];
		j3151304635 -> j1371295969;
	j817028461 [label="我以为这会很有趣？",shape=box,color=red];
		j817028461 -> j1951179224;
	j3897256069 [label="我真的不知道。只是一时冲动。",shape=box,color=red];
		j3897256069 -> j3834577550;
	j19905978 [label="我是认真的。如果我让你感到不舒服，我很抱歉。",shape=box,color=red];
		j19905978 -> j4147140803;
	j4084220665 [label="对不起，我只是开玩笑。",shape=box,color=red];
		j4084220665 -> j4147140803;
	j3121162059 [label="我是 une Sœur de Sol。我不应该……战斗。杀戮。Murmure 并非生灵，至少科维兽是这么告诉我的——但我面对的其他人呢？",shape=box,color=blue];
		j3121162059 -> j3572123891;
	j1584078489 [label="+5 Chemistry",color=orange];
		j1584078489 -> j2163318243;
	j995790845 [label="那我就不多问了。我明白有些事很难说出口。",shape=box,color=blue];
		j995790845 -> j4006997567;
	j2107765285 [label="Cathédrale 里有一位修女也是这样。她总是忙来忙去。有一次我凌晨三点看到她还在擦银器。",shape=box,color=blue];
		j2107765285 -> j2774501327;
	j3945769924 [label="啊，oui。我想我知道你在说什么。一种……云，在太阳下方移动。 ",shape=box,color=blue];
		j3945769924 -> j2349958123;
	j2524365762 [label="就像一个杯子，一滴一滴地被水填满，non ？",shape=box,color=blue];
		j2524365762 -> j1020958530;
	j1371295969 [label="你不必为了了解我去撒这样的 mensonge。",shape=box,color=blue];
		j1371295969 -> j2331875877;
	j1951179224 [label="Je ne comprends pas votre humour。也许在未来“有趣”的定义是不一样的 ？",shape=box,color=blue];
		j1951179224 -> j2104172092;
	j3834577550 [label="我不知道是什么本能驱使你对我说了这样的 mensonge。 ",shape=box,color=blue];
		j3834577550 -> j3436397731;
	j4147140803 [label="Bon，où en étais-je ？",shape=box,color=blue];
		j4147140803 -> j2256643707;
	j3572123891 [label="以太阳神之名战斗……难道这就是我的路吗 ？难道我真的要以他的名义去杀人吗 ？我Moi，petite 玛丽 ？",shape=box,color=blue];
		j3572123891 -> j1728110415;
		j3572123891 -> j2433663582;
	j2163318243 [label="我知道你是在用比喻，但我真的要笑到不行 ！我觉得就算你现在想再踩一次，也进不去 ！",shape=box,color=blue];
		j2163318243 -> j1236113752;
	j4006997567 [label="我们的生活和思想中有很多地方会让人走偏。它会找到一些黑洞让我们深陷其中，non ？",shape=box,color=blue];
		j4006997567 -> j193220700;
	j2774501327 [label="我问她为什么这么做，她说她睡不着，因为她太烦躁了。",shape=box,color=blue];
		j2774501327 -> j690753417;
	j2349958123 [label="我们有个词来形容这种感觉，叫做 ennui。一种疲惫和不满，让一切都显得……毫无意义。",shape=box,color=blue];
		j2349958123 -> j1396237239;
	j1020958530 [label="它会变满，溢出来。甚至里面的水可能会倾倒。​看起来​一​片​狼藉。",shape=box,color=blue];
		j1020958530 -> j4097879014;
	j2331875877 [label="一个灵魂不只有信仰。我虽然是 une Sœur de Sol，但我希望你看到的不只我这一面，non ？",shape=box,color=blue];
		j2331875877 -> j1311219135;
	j2104172092 [label="我觉得一点也不有趣。",shape=box,color=blue];
		j2104172092 -> j1097657522;
	j3436397731 [label="我只能希望这只是个善意的玩笑，而不是一个用来捉弄我的残酷玩笑。所以，我选择效法太阳神那样——",shape=box,color=blue];
		j3436397731 -> j2292882940;
	j1728110415 [label="我没有受过当兵的训练。不像那孩子。你也一样。",shape=box,color=red];
		j1728110415 -> j3753688964;
	j2433663582 [label="我并非……一直像现在这样。不是天生的战士。我是经历了很多痛苦才学会的。",shape=box,color=red];
		j2433663582 -> j2083663699;
	j1236113752 [label="光是脑中里浮现的画面就要把我笑死了。趁我还没笑得喘不过气，告诉我——你指的是什么 ？",shape=box,color=blue];
		j1236113752 -> j1728110415;
		j1236113752 -> j2433663582;
	j193220700 [label="当这种情况发生时，我们只能尽可能善待自己并保持耐心。",shape=box,color=blue];
		j193220700 -> j1231292778;
	j690753417 [label="每次看到她这样，我都会问要不要我陪她。有时候她说要，有时候又说不要。",shape=box,color=blue];
		j690753417 -> j4006997567;
	j1396237239 [label="或许你所渴望的，是想躲起来、想哭泣，更像是绝望，我也说不清。",shape=box,color=blue];
		j1396237239 -> j3562467667;
	j4097879014 [label="你清理好混乱的地方，把杯子扶正……然后一切又重新开始，oui ？",shape=box,color=blue];
		j4097879014 -> j2161081046;
	j1311219135 [label="我们能谈的话题跟天上的星星一样多 ！",shape=box,color=blue];
		j1311219135 -> j2630995916;
		j1311219135 -> j1363976945;
	j1097657522 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j1097657522 -> j1508231473;
	j2292882940 [label="——无论你是否信奉，他是我追随的信仰，并且原谅你。如果你像里昂那样，我会说，你应当受十鞭子作为代价。",shape=box,color=blue];
		j2292882940 -> j4119606844;
	j3753688964 [label="Oui ！一想到那个小小的复制品和他们悲伤的故事……我就想哭。竟然被他们自认为的家人变成了战争机器 ？",shape=box,color=blue];
		j3753688964 -> j1367700227;
	j2083663699 [label="Oui ！我听说过，你吃了很多苦才练成如今的身手。死亡是残酷的老师，我无法想象……",shape=box,color=blue];
		j2083663699 -> j1367700227;
	j1231292778 [label="我​不​知道​这些​话​对​你​是否​有​意义。​或者，​它们​不过​是​机器​上​发光​的​点。​",shape=box,color=blue];
		j1231292778 -> j3530525353;
	j3562467667 [label="我不认识你的这位朋友，但我想——他们能有你在身边，真是太好了。",shape=box,color=blue];
		j3562467667 -> j4006997567;
	j2161081046 [label="我觉得教堂里有一位神父，他的脾气和你很像。他能承受一切——直到有一天他再也承受不住。",shape=box,color=blue];
		j2161081046 -> j3821298971;
	j2630995916 [label="对不起。我做了件傻事。",shape=box,color=red];
		j2630995916 -> j2239413394;
	j1363976945 [label="那么​你​会​原谅​我​吗？​",shape=box,color=red];
		j1363976945 -> j1240213754;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j4119606844 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j4119606844 -> j1148049701;
	j1367700227 [label="Non。我宁愿保持现在的样子。我选择接受主教的帮助，接受他提供的血清。",shape=box,color=blue];
		j1367700227 -> j2164446637;
	j3530525353 [label="事实上，当你考虑到事情的现实时，当我写下这些话时，很可能已经是几天或很多年以前的事情了，这取决于你身处在什么时候。",shape=box,color=blue];
		j3530525353 -> j3425407788;
	j3821298971 [label="当他被压得透不过气，一切看起来一团糟时，我会问他是否希望我陪他。Des fois，oui，des fois，non。",shape=box,color=blue];
		j3821298971 -> j4006997567;
	j2239413394 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j2239413394 -> j1235427625;
	j1240213754 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j1240213754 -> j2334839344;
	j1148049701 [label="我们都像盲人一样，试图在这个世界上找到自己的路。",shape=box,color=blue];
		j1148049701 -> j2525876932;
	j2164446637 [label="可是你知道吗，我内心充满了悲伤和不确定性。我并不是在这种战争的环境中出生或成长的。",shape=box,color=blue];
		j2164446637 -> j3043013969;
		j2164446637 -> j2985377457;
	j3425407788 [label="话虽如此，我明白当我写下你并不孤单时，你可能还是会感到空虚。",shape=box,color=blue];
		j3425407788 -> j1720411615;
	j1235427625 [label="+10 Chemistry",color=orange];
		j1235427625 -> j2091643484;
	j2334839344 [label="+5 Chemistry",color=orange];
		j2334839344 -> j3330112537;
	j2525876932 [label="但我刚刚问的是今天过得怎么样。你还没回答，petit mensonge ou non。",shape=box,color=blue];
		j2525876932 -> j1229378767;
		j2525876932 -> j3449348233;
		j2525876932 -> j3260099442;
	j3043013969 [label="有时，我会想，有很多事情都是靠我自己摸索学习的，我其实有点羡慕那个孩子，能够受到真正的训练。",shape=box,color=red];
		j3043013969 -> j3314299237;
	j2985377457 [label="我觉得，不管​是​为了什么，​一​个​人​被​卷入​战争​中​总不​是​什么​好事。无论是生来就要适应战乱、为了成长，还是自己选择的。最终，这取决于你是谁，以及你应对的方式。",shape=box,color=red];
		j2985377457 -> j3002723579;
	j1720411615 [label="尽管你周围的人可能看起来很遥远、或是虚拟的、或耐心地坐着等你打招呼。",shape=box,color=blue];
		j1720411615 -> j1306546780;
	j2091643484 [label="Oui，如果你像里昂那样，我会说，你应当受十鞭子作为代价。但你不是。你已被原谅了。",shape=box,color=blue];
		j2091643484 -> j1148049701;
	j3330112537 [label="Oui，我原谅你。如果你像里昂那样，我会说，你应当受十鞭子作为代价。",shape=box,color=blue];
		j3330112537 -> j1148049701;
	j1229378767 [label="老实说，我……已经好多了。",shape=box,color=red];
		j1229378767 -> j2754860116;
	j3449348233 [label="老实说，还挺好。你呢？",shape=box,color=red];
		j3449348233 -> j3082783407;
	j3260099442 [label="现在好多了。谢谢你。我听说忏悔对人有好处，对吗？",shape=box,color=red];
		j3260099442 -> j299792783;
	j3314299237 [label="Add -1 to Thermostat counter",color=orange];
		j3314299237 -> j262797038;
	j3002723579 [label="Add 1 to Thermostat counter",color=orange];
		j3002723579 -> j1276548846;
	j1306546780 [label="我希望你的这一刻能过得快一些。",shape=box,color=blue];
		j1306546780 -> j2307725679;
	j2754860116 [label="Qu'y at-il ？发生什么事了 ？",shape=box,color=blue];
		j2754860116 -> j1003094086;
		j2754860116 -> j3784377670;
		j2754860116 -> j1468824585;
		j2754860116 -> j4276144423;
	j299792783 [label="+5 Chemistry",color=orange];
		j299792783 -> j1412542083;
	j262797038 [label="+10 Chemistry",color=orange];
		j262797038 -> j3346854677;
	j1276548846 [label="+10 Chemistry",color=orange];
		j1276548846 -> j3258227045;
	j2307725679 [label="但如果没有呢 ？我这有一个万无一失的解决方案 ！",shape=box,color=blue];
		j2307725679 -> j522598160;
	j1412542083 [label="哈哈 ！Oui，确实如此。太好了，听你这么说我很高兴。",shape=box,color=blue];
		j1412542083 -> j3050003739;
	j3346854677 [label="Oui，但那样的你就不是我们所熟知和喜爱的那只放荡不羁的狼了，对吧 ？我觉得太阳神把你放在了该走的路上。",shape=box,color=blue];
		j3346854677 -> j1438600875;
	j3258227045 [label="Oui，我完全同意。没有人生来就是为了投入到战争。好吧，除非是那些我听说的“Grin-ire”，但即便如此……",shape=box,color=blue];
		j3258227045 -> j2835331622;
	j522598160 [label="Des pâtisseries ！",shape=box,color=blue];
		j522598160 -> j4132951681;
	j3050003739 [label="啊 ！午餐准备好了。我得走了。回头见，狼。很高兴我们聊了天。",shape=box,color=blue];
		j3050003739 -> "Chat ends.";
	j1438600875 [label="但我明白你的意思。你看到了另一个你所拥有的框架和指导，不免会希望自己当初也拥有同样的东西。尤其是在你那么孤独的时候。",shape=box,color=blue];
		j1438600875 -> j817964740;
	j2835331622 [label="我在想，如果真的有选择的话，他们会不会走上另一条道路 ？",shape=box,color=blue];
		j2835331622 -> j2688616156;
		j2835331622 -> j1365961592;
	j4132951681 [label="Check boolean MarieRoathePastry1",color=orange];
		j4132951681 -> j1453237586 [label=true,color=green];
		j4132951681 -> j698496921 [label=true,color=green];
		j4132951681 -> j1709216101 [label=true,color=green];
		j4132951681 -> j698496921 [label=false,color=brown];
		j4132951681 -> j1653533944 [label=false,color=brown];
	j817964740 [label="现在，我不禁看见，一个非常孤独的小小复制品……和一只与狼群一起奔跑的狼。",shape=box,color=blue];
		j817964740 -> j2303908198;
	j2688616156 [label="当你从小就被灌输“这就是你唯一的目的，你唯一的存在意义”的观念时，要打破这种框架是很困难的。目的能给人安慰。",shape=box,color=red];
		j2688616156 -> j2123649212;
	j1365961592 [label="我想他们会的。我遇到过几个 Grineer，他们向我证明了 Grineer 并不只有战争和死亡那一面。",shape=box,color=red];
		j1365961592 -> j2031001862;
	j1453237586 [label="我​只​需要​确保​带够​大家​的​份。​",shape=box,color=red];
		j1453237586 -> j3072999384;
	j698496921 [label="玛丽，谢谢你。",shape=box,color=red];
		j698496921 -> j1863041340;
	j1709216101 [label="我不会让罗瑟靠近它们。",shape=box,color=red];
		j1709216101 -> j1860821743;
	j1653533944 [label="糕点永远不会出错。",shape=box,color=red];
		j1653533944 -> j2058128318;
	j2303908198 [label="我​想​也​许​情况​已经​反​过​来​了，​non ？​",shape=box,color=blue];
		j2303908198 -> j2912689271;
		j2303908198 -> j49144341;
	j2123649212 [label="Add -1 to Thermostat counter",color=orange];
		j2123649212 -> j512568635;
	j2031001862 [label="Add 1 to Thermostat counter",color=orange];
		j2031001862 -> j2772557227;
	j3072999384 [label="+20 Chemistry",color=orange];
		j3072999384 -> j782227835;
	j1863041340 [label="+20 Chemistry",color=orange];
		j1863041340 -> j725565460;
	j1860821743 [label="+20 Chemistry",color=orange];
		j1860821743 -> j1645376535;
	j2058128318 [label="别让恶魔靠近。Sinon，il va les voler！他吃不饱的时候就会偷糕点！",shape=box,color=blue];
		j2058128318 -> j420323306;
	j2912689271 [label="他们还在疗伤。他们的旅程还没结束呢。",shape=box,color=red];
		j2912689271 -> j566536791;
	j49144341 [label="我真希望自己能为他们做更多的事情。 ",shape=box,color=red];
		j49144341 -> j566536791;
	j512568635 [label="Oui，你说得对。很多人寻求信仰，就是希望它能给他们带来目的，带来方向。",shape=box,color=blue];
		j512568635 -> j872113223;
	j2772557227 [label="（原来是这样拼写的，谢谢 ！）听到你这么说我真的很欣慰。即使是一个被灌输视战争为唯一目的的种族，也仍然能找到另一条路。",shape=box,color=blue];
		j2772557227 -> j1519136503;
