	1282 [label="[结束]",shape=box,color=red];
		1282 -> 1286;
	1285 [label="我也过得不错。不过仔细想想，我感觉自己不应该这样。",shape=box,color=blue];
		1285 -> 1292;
		1285 -> 1293;
	1284 [label="我挺好的，但现在你让我很好奇。Qu'y a-t-il ？",shape=box,color=blue];
		1284 -> 1288;
		1284 -> 1289;
		1284 -> 1290;
