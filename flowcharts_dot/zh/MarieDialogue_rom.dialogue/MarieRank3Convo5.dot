	1371 [label="Chat ends.",color=orange];
	1376 [label="现在，我不禁看见，一个非常孤独的小小复制品……和一只与狼群一起奔跑的狼。",shape=box,color=blue];
		1376 -> 1383;
	1377 [label="当你从小就被灌输“这就是你唯一的目的，你唯一的存在意义”的观念时，要打破这种框架是很困难的。目的能给人安慰。",shape=box,color=red];
		1377 -> 1384;
	1378 [label="我想他们会的。我遇到过几个 Grineer，他们向我证明了 Grineer 并不只有战争和死亡那一面。",shape=box,color=red];
		1378 -> 1385;
	1372 [label="我​只​需要​确保​带够​大家​的​份。​",shape=box,color=red];
		1372 -> 1379;
	1373 [label="玛丽，谢谢你。",shape=box,color=red];
