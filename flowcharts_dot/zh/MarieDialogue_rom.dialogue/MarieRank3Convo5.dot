	1278 [label="Bonjour ！今天过得怎么样？",shape=box,color=blue];
		1278 -> 1281;
		1278 -> 1280;
		1278 -> 1283;
		1278 -> 3947;
		1278 -> 1282;
	1281 [label="我很好，你呢？",shape=box,color=red];
		1281 -> 1285;
	1280 [label="不如以前，不过还是谢谢你关心。你好吗 ？",shape=box,color=red];
		1280 -> 1284;
	1283 [label="我……现在应该向你忏悔我之前撒了谎，我……并不是太阳神的追随者。",shape=box,color=red];
		1283 -> 1287;
	3947 [label="跟你说话之后感觉好多了。你的存在让我的每一天都更加美好。",shape=box,color=red];
