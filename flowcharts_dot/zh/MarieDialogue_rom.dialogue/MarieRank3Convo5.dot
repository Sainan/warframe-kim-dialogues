	1287 [label="哦 ！我……知道了。Pourquoi ？",shape=box,color=blue];
		1287 -> 1294;
		1287 -> 1295;
		1287 -> 1296;
	3948 [label="狼 ！你让我差点从椅子上摔下来了 ！",shape=box,color=blue];
		3948 -> 3949;
		3948 -> 3950;
	1286 [label="Chat ends.",color=orange];
	1292 [label="这是什么意思？",shape=box,color=red];
		1292 -> 1301;
	1293 [label="我曾经也踩过相同的坑。",shape=box,color=red];
		1293 -> 1302;
	1288 [label="这……很难解释。",shape=box,color=red];
		1288 -> 1297;
	1289 [label="要担心的事情太多，留给我的时间却太少。",shape=box,color=red];
		1289 -> 1298;
	1290 [label="我的一个朋友曾经把它描述成“蜘蛛”。它们会时不时地爬进来。",shape=box,color=red];
		1290 -> 1299;
	1291 [label="有时候，所有事……会一下子都压到我身上。但我会没事的。",shape=box,color=red];
		1291 -> 1300;
	1294 [label="我当时觉得这是一个更好地了解你的机会……",shape=box,color=red];
		1294 -> 1303;
	1295 [label="我以为这会很有趣？",shape=box,color=red];
		1295 -> 1304;
	1296 [label="我真的不知道。只是一时冲动。",shape=box,color=red];
		1296 -> 1305;
	3949 [label="我是认真的。如果我让你感到不舒服，我很抱歉。",shape=box,color=red];
		3949 -> 3951;
	3950 [label="对不起，我只是开玩笑。",shape=box,color=red];
		3950 -> 3951;
	1301 [label="我是 une Sœur de Sol。我不应该……战斗。杀戮。Murmure 并非生灵，至少科维兽是这么告诉我的——但我面对的其他人呢？",shape=box,color=blue];
		1301 -> 1310;
	1302 [label="+5 Chemistry",color=orange];
		1302 -> 1311;
	1297 [label="那我就不多问了。我明白有些事很难说出口。",shape=box,color=blue];
		1297 -> 1306;
	1298 [label="Cathédrale 里有一位修女也是这样。她总是忙来忙去。有一次我凌晨三点看到她还在擦银器。",shape=box,color=blue];
		1298 -> 1307;
	1299 [label="啊，oui。我想我知道你在说什么。一种……云，在太阳下方移动。 ",shape=box,color=blue];
		1299 -> 1308;
	1300 [label="就像一个杯子，一滴一滴地被水填满，non ？",shape=box,color=blue];
		1300 -> 1309;
	1303 [label="你不必为了了解我去撒这样的 mensonge。",shape=box,color=blue];
		1303 -> 1312;
	1304 [label="Je ne comprends pas votre humour。也许在未来“有趣”的定义是不一样的 ？",shape=box,color=blue];
		1304 -> 1313;
	1305 [label="我不知道是什么本能驱使你对我说了这样的 mensonge。 ",shape=box,color=blue];
		1305 -> 1314;
	3951 [label="Bon，où en étais-je ？",shape=box,color=blue];
		3951 -> 1278;
	1310 [label="以太阳神之名战斗……难道这就是我的路吗 ？难道我真的要以他的名义去杀人吗 ？我Moi，petite 玛丽 ？",shape=box,color=blue];
		1310 -> 1319;
		1310 -> 1320;
	1311 [label="我知道你是在用比喻，但我真的要笑到不行 ！我觉得就算你现在想再踩一次，也进不去 ！",shape=box,color=blue];
		1311 -> 1321;
	1306 [label="我们的生活和思想中有很多地方会让人走偏。它会找到一些黑洞让我们深陷其中，non ？",shape=box,color=blue];
		1306 -> 1315;
	1307 [label="我问她为什么这么做，她说她睡不着，因为她太烦躁了。",shape=box,color=blue];
		1307 -> 1316;
	1308 [label="我们有个词来形容这种感觉，叫做 ennui。一种疲惫和不满，让一切都显得……毫无意义。",shape=box,color=blue];
		1308 -> 1317;
	1309 [label="它会变满，溢出来。甚至里面的水可能会倾倒。​看起来​一​片​狼藉。",shape=box,color=blue];
		1309 -> 1318;
	1312 [label="一个灵魂不只有信仰。我虽然是 une Sœur de Sol，但我希望你看到的不只我这一面，non ？",shape=box,color=blue];
		1312 -> 1322;
	1313 [label="我觉得一点也不有趣。",shape=box,color=blue];
		1313 -> 1323;
	1314 [label="我只能希望这只是个善意的玩笑，而不是一个用来捉弄我的残酷玩笑。所以，我选择效法太阳神那样——",shape=box,color=blue];
		1314 -> 1324;
	1319 [label="我没有受过当兵的训练。不像那孩子。你也一样。",shape=box,color=red];
		1319 -> 1328;
	1320 [label="我并非……一直像现在这样。不是天生的战士。我是经历了很多痛苦才学会的。",shape=box,color=red];
		1320 -> 1329;
	1321 [label="光是脑中里浮现的画面就要把我笑死了。趁我还没笑得喘不过气，告诉我——你指的是什么 ？",shape=box,color=blue];
		1321 -> 1319;
		1321 -> 1320;
	1315 [label="当这种情况发生时，我们只能尽可能善待自己并保持耐心。",shape=box,color=blue];
		1315 -> 1325;
	1316 [label="每次看到她这样，我都会问要不要我陪她。有时候她说要，有时候又说不要。",shape=box,color=blue];
		1316 -> 1306;
	1317 [label="或许你所渴望的，是想躲起来、想哭泣，更像是绝望，我也说不清。",shape=box,color=blue];
		1317 -> 1335;
	1318 [label="你清理好混乱的地方，把杯子扶正……然后一切又重新开始，oui ？",shape=box,color=blue];
		1318 -> 1327;
	1322 [label="我们能谈的话题跟天上的星星一样多 ！",shape=box,color=blue];
		1322 -> 1330;
		1322 -> 1331;
	1323 [label="Update boolean DrifterFaithSol",color=orange];
		1323 -> 1332;
	1324 [label="——无论你是否信奉，他是我追随的信仰，并且原谅你。如果你像里昂那样，我会说，你应当受十鞭子作为代价。",shape=box,color=blue];
		1324 -> 1333;
	1328 [label="Oui ！一想到那个小小的复制品和他们悲伤的故事……我就想哭。竟然被他们自认为的家人变成了战争机器 ？",shape=box,color=blue];
		1328 -> 1337;
	1329 [label="Oui ！我听说过，你吃了很多苦才练成如今的身手。死亡是残酷的老师，我无法想象……",shape=box,color=blue];
		1329 -> 1337;
	1325 [label="我​不​知道​这些​话​对​你​是否​有​意义。​或者，​它们​不过​是​机器​上​发光​的​点。​",shape=box,color=blue];
		1325 -> 1334;
	1335 [label="我不认识你的这位朋友，但我想——他们能有你在身边，真是太好了。",shape=box,color=blue];
		1335 -> 1306;
	1327 [label="我觉得教堂里有一位神父，他的脾气和你很像。他能承受一切——直到有一天他再也承受不住。",shape=box,color=blue];
		1327 -> 1336;
	1330 [label="对不起。我做了件傻事。",shape=box,color=red];
		1330 -> 1338;
	1331 [label="那么​你​会​原谅​我​吗？​",shape=box,color=red];
