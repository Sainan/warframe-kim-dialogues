		1333 -> 1341;
	1337 [label="Non。我宁愿保持现在的样子。我选择接受主教的帮助，接受他提供的血清。",shape=box,color=blue];
		1337 -> 1343;
	1334 [label="事实上，当你考虑到事情的现实时，当我写下这些话时，很可能已经是几天或很多年以前的事情了，这取决于你身处在什么时候。",shape=box,color=blue];
		1334 -> 1342;
	1336 [label="当他被压得透不过气，一切看起来一团糟时，我会问他是否希望我陪他。Des fois，oui，des fois，non。",shape=box,color=blue];
		1336 -> 1306;
	1338 [label="Update boolean DrifterFaithSol",color=orange];
		1338 -> 1344;
	1339 [label="Update boolean DrifterFaithSol",color=orange];
		1339 -> 1345;
	1340 [label="Chat ends.",color=orange];
	1341 [label="我们都像盲人一样，试图在这个世界上找到自己的路。",shape=box,color=blue];
		1341 -> 1346;
	1343 [label="可是你知道吗，我内心充满了悲伤和不确定性。我并不是在这种战争的环境中出生或成长的。",shape=box,color=blue];
		1343 -> 1348;
		1343 -> 1349;
	1342 [label="话虽如此，我明白当我写下你并不孤单时，你可能还是会感到空虚。",shape=box,color=blue];
		1342 -> 1347;
	1344 [label="+10 Chemistry",color=orange];
		1344 -> 1350;
	1345 [label="+5 Chemistry",color=orange];
		1345 -> 1351;
	1346 [label="但我刚刚问的是今天过得怎么样。你还没回答，petit mensonge ou non。",shape=box,color=blue];
		1346 -> 1352;
		1346 -> 1353;
		1346 -> 1354;
	1348 [label="有时，我会想，有很多事情都是靠我自己摸索学习的，我其实有点羡慕那个孩子，能够受到真正的训练。",shape=box,color=red];
		1348 -> 1356;
	1349 [label="我觉得，不管​是​为了什么，​一​个​人​被​卷入​战争​中​总不​是​什么​好事。无论是生来就要适应战乱、为了成长，还是自己选择的。最终，这取决于你是谁，以及你应对的方式。",shape=box,color=red];
		1349 -> 1357;
	1347 [label="尽管你周围的人可能看起来很遥远、或是虚拟的、或耐心地坐着等你打招呼。",shape=box,color=blue];
		1347 -> 1355;
	1350 [label="Oui，如果你像里昂那样，我会说，你应当受十鞭子作为代价。但你不是。你已被原谅了。",shape=box,color=blue];
		1350 -> 1341;
	1351 [label="Oui，我原谅你。如果你像里昂那样，我会说，你应当受十鞭子作为代价。",shape=box,color=blue];
		1351 -> 1341;
	1352 [label="老实说，我……已经好多了。",shape=box,color=red];
		1352 -> 1358;
	1353 [label="老实说，还挺好。你呢？",shape=box,color=red];
		1353 -> 1285;
	1354 [label="现在好多了。谢谢你。我听说忏悔对人有好处，对吗？",shape=box,color=red];
