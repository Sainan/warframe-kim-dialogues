	"MarieRank3Convo6 begins." [color=orange];
		"MarieRank3Convo6 begins." -> j1367698353;
	j1367698353 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j1367698353 -> j1819878890;
	j1819878890 [label="我必须问你一个问题，漂泊者，同时也请你别因此评判我。",shape=box,color=blue];
		j1819878890 -> j2301682424;
		j1819878890 -> j408144977;
		j1819878890 -> j1038552372;
	j2301682424 [label="你被卷入了一场荒诞的处境。我当然不会评判你。",shape=box,color=red];
		j2301682424 -> j1565145829;
	j408144977 [label="我会尽力的。",shape=box,color=red];
		j408144977 -> j717521149;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j1565145829 [label="Vraiment gentil，在不了解我，也不知我要问点什么的情况下就对我如此宽厚。",shape=box,color=blue];
		j1565145829 -> j3301170058;
	j717521149 [label="+10 Chemistry",color=orange];
		j717521149 -> j2822039969;
	"Chat ends." [color=orange];
	j3301170058 [label="但是……那个大脑袋会说话的鱼，也会让你头疼吗 ？斐波那契 ？",shape=box,color=blue];
		j3301170058 -> j2764240396;
		j3301170058 -> j1739180603;
		j3301170058 -> j2925197954;
	j2822039969 [label="我非常感激，谢谢。",shape=box,color=blue];
		j2822039969 -> j3301170058;
	j2764240396 [label="是的。是的，当然。多谢你提出来。",shape=box,color=red];
		j2764240396 -> j277628376;
	j1739180603 [label="你对斐波那契感到烦躁的念头真是可爱极了。",shape=box,color=red];
		j1739180603 -> j4024621796;
	j2925197954 [label="其实，并不会。我非常喜欢他。",shape=box,color=red];
		j2925197954 -> j1262665987;
	j277628376 [label="那我很庆幸自己并非孤身一人。不过先说明，这绝非对他的侮辱之意。如果我因为现状而心神不宁，想必他也是竭尽全力在忍受。",shape=box,color=blue];
		j277628376 -> j1695232688;
	j4024621796 [label="哦 ？怎么会呢 ？我猜我应该为此感到高兴，但实在不明白为什么。我的头痛可没这么迷人。",shape=box,color=blue];
		j4024621796 -> j4106591458;
		j4024621796 -> j3966046077;
	j1262665987 [label="那么我只能请求你的原谅，这绝非对他的侮辱之意。如果我因为现状而心神不宁，想必他也是竭尽全力在忍受。",shape=box,color=blue];
		j1262665987 -> j573550150;
	j1695232688 [label="他这样做的方式，只是当我长时间被迫承受时，实在难以认同罢了。",shape=box,color=blue];
		j1695232688 -> j4186962429;
	j4106591458 [label="我大部分时间都在为生存而战。像这样的人性微光……某种程度上是支撑我活下去的意义。",shape=box,color=red];
		j4106591458 -> j3338154100;
	j3966046077 [label="我想偶尔还是得退一步，反思这一切的荒谬。一个诺格和一位太阳神祭司……",shape=box,color=red];
		j3966046077 -> j3874583067;
	j573550150 [label="他这样做的方式，只是当我长时间被迫承受时，实在难以认同罢了。",shape=box,color=blue];
		j573550150 -> j4186962429;
	j4186962429 [label="唉。我不该抱怨的。今晚必须给里昂送晚餐，他又被严重的偏头风折磨得动弹不得了。",shape=box,color=blue];
		j4186962429 -> j1953653778;
		j4186962429 -> j1946142614;
	j3338154100 [label="+5 Chemistry",color=orange];
		j3338154100 -> j2298896146;
	j3874583067 [label="+5 Chemistry",color=orange];
		j3874583067 -> j595356723;
	j1953653778 [label="他经常会这样吗 ？",shape=box,color=red];
		j1953653778 -> j1025399871;
	j1946142614 [label="不好意思……什么 ？",shape=box,color=red];
		j1946142614 -> j2429150855;
	j2298896146 [label="永远不要失去你生命中那部分，漂泊者。永远不要放弃你内心追寻生命火花的那部分。",shape=box,color=blue];
		j2298896146 -> j456094789;
	j595356723 [label="天啊，这么一说就明白啦。这确实像那些幼稚的笑话，n'est-ce pas ？",shape=box,color=blue];
		j595356723 -> j3491345155;
	j1025399871 [label="Oui，oui。几周一次 ？两个月一次 ？我记得他最久一次没犯病的记录大概是半年吧。",shape=box,color=blue];
		j1025399871 -> j547018639;
	j2429150855 [label="哦 ！亲爱的。嗯。就像是头痛，但要剧烈得多。我听说有人称之为胆汁性头痛。这种头痛在女性中更为常见。",shape=box,color=blue];
		j2429150855 -> j3944922123;
		j2429150855 -> j1850550469;
	j456094789 [label="这世界总爱把自己装扮成阴郁沉重之地，随时准备在每个转角处向我们施加苦难。",shape=box,color=blue];
		j456094789 -> j1313788556;
	j3491345155 [label="一位修女、一位神父和来自未来的恶魔被送往过去……又被送往未来……途中遇见了鱼、鹿形生物、巨鸟和管家……",shape=box,color=blue];
		j3491345155 -> j1921013787;
	j547018639 [label="Check boolean Megrim",color=orange];
		j547018639 -> j3565635996 [label=true,color=green];
		j547018639 -> j527469073 [label=true,color=green];
		j547018639 -> j1905919877 [label=true,color=green];
		j547018639 -> j3565635996 [label=false,color=brown];
		j547018639 -> j527469073 [label=false,color=brown];
		j547018639 -> j83786649 [label=false,color=brown];
	j3944922123 [label="我想我们现在都称它们为“偏头痛”了。",shape=box,color=red];
		j3944922123 -> j1783059903;
	j1850550469 [label="呃。偏头风。谢谢。",shape=box,color=red];
		j1850550469 -> j3384214037;
	j1313788556 [label="我们必须寻找一切可能的明媚与轻松，哪怕不得不以幼稚的形式出现。",shape=box,color=blue];
		j1313788556 -> j912988314;
	j1921013787 [label="这真是有趣得很，你说得太对了 ！",shape=box,color=blue];
		j1921013787 -> j2814781890;
	j3565635996 [label="我在想是什么原因导致的。",shape=box,color=red];
		j3565635996 -> j2475216879;
	j527469073 [label="听起来糟透了……",shape=box,color=red];
		j527469073 -> j714409761;
	j1905919877 [label="我也会得偏头风。那感觉糟透了。",shape=box,color=red];
		j1905919877 -> j3699352939;
	j83786649 [label="我也会有这种头痛，简直要命。",shape=box,color=red];
		j83786649 -> j3699352939;
	j1783059903 [label="真想知道我们还会发现哪些迷人的历史 particularités ！太令人兴奋了。我确实热爱学习新事物。“偏头痛。”这趟旅程显然不远。",shape=box,color=blue];
		j1783059903 -> j1740242577;
	j3384214037 [label="Boolean Megrim is now true.",color=orange];
		j3384214037 -> j1068107790;
	j912988314 [label="要是里昂也能这么想就好了。",shape=box,color=blue];
		j912988314 -> j2520677407;
	j2814781890 [label="但愿我亲爱的里昂也能同样看到其中的光芒。",shape=box,color=blue];
		j2814781890 -> j2520677407;
	j2475216879 [label="他自有他的理论。 ",shape=box,color=blue];
		j2475216879 -> j1802629475;
	j714409761 [label="如果你想表达慰问，我相信他定会欣然接受。尽管可能看起来并非如此，但他其实很享受有人陪伴。",shape=box,color=blue];
		j714409761 -> j321203759;
	j3699352939 [label="你也有吗 ？你该告诉里昂。他需要知道其他人也可能经历如此相似的痛苦。",shape=box,color=blue];
		j3699352939 -> j3309745157;
	j1740242577 [label="Boolean Migraine is now true.",color=orange];
		j1740242577 -> j1068107790;
	j1068107790 [label="不管叫什么名字，里昂都被它打倒，直到天亮才能转好。可怜的他眼前一片模糊，手脚也毫无知觉。他说这痛苦简直难以忍受。",shape=box,color=blue];
		j1068107790 -> j547018639;
	j2520677407 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j2520677407 -> j482108438;
	j1802629475 [label="虽然更准确的说法是，直到最近他才有了自己的理论。",shape=box,color=blue];
		j1802629475 -> j2373486287;
	j321203759 [label="尽管他的举止或许试图劝阻你，我恳请你坚守信念，漂泊者。在那看似坚毅冷峻的外表之下，深藏着一个亟需帮助的人。",shape=box,color=blue];
		j321203759 -> j3576691455;
		j321203759 -> j2315905475;
		j321203759 -> j289155125;
	j3309745157 [label="+5 Chemistry",color=orange];
		j3309745157 -> j2955276240;
	j482108438 [label="啊，说到这个。我为抱怨头痛感到很愧疚。今晚必须给里昂送晚餐，他又被严重的偏头风折磨得动弹不得了。",shape=box,color=blue];
		j482108438 -> j1946142614;
		j482108438 -> j1953653778;
	j2373486287 [label="Boolean MarieLyonFaith1 is now true.",color=orange];
		j2373486287 -> j321203759;
	j3576691455 [label="我可固执得很。你别担心。",shape=box,color=red];
		j3576691455 -> j4049721317;
	j2315905475 [label="我已经有一个墙中人了……为什么不能有两个 ？",shape=box,color=red];
		j2315905475 -> j135693404;
	j289155125 [label="他是个成年人了。要是他愿意开口，自然会说。",shape=box,color=red];
		j289155125 -> j1266137462;
	j2955276240 [label="双耀神深知，若非如此，他宁愿独自承受痛苦……",shape=box,color=blue];
		j2955276240 -> j3046141950;
	j4049721317 [label="+5 Chemistry",color=orange];
		j4049721317 -> j2211160496;
	j135693404 [label="你可以这样跟我开玩笑，但别对他讲这种话。关于虚空无情之物的话对他而言是个痛处。",shape=box,color=blue];
		j135693404 -> j3206710022;
	j1266137462 [label="他是成年人了，没错。他是个男人了，也没错。我相信他也渴望倾诉。但我要问你，他真能开口吗。",shape=box,color=blue];
		j1266137462 -> j914191975;
	j3046141950 [label="Boolean MarieLyonSuffering2 is now true.",color=orange];
		j3046141950 -> j321203759;
	j2211160496 [label="恐怕你和他在一起时会需要这份固执的。谢谢你，漂泊者。他是我最亲密的朋友，也像我的兄弟。看着他承受如此痛苦，我的心都碎了。",shape=box,color=blue];
		j2211160496 -> j2514800743;
	j3206710022 [label="要坚韧。要耐心。要善良。他就像我的兄弟，也是我最亲密的朋友，漂泊者。看到他承受如此痛苦，我的心都碎了。",shape=box,color=blue];
		j3206710022 -> j2514800743;
	j914191975 [label="我们并非生而就拥有同等天赋，也不都觉得自己理应享有这些。他正承受着痛苦，并认为痛苦就是他注定的命运。",shape=box,color=blue];
		j914191975 -> j2185111156;
	j2514800743 [label="我们很快会再聊。Par la grâce de Sol。",shape=box,color=blue];
		j2514800743 -> "Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j2185111156 [label="他就像我的兄弟，也是我最亲密的朋友。想到他，我的心便碎成千片。因此我只能恳请你……耐心些。温柔些。如果你能做到的话。",shape=box,color=blue];
		j2185111156 -> j2514800743;
	"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
