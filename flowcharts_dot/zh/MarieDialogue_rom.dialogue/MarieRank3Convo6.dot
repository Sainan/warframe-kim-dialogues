digraph {
	1418 [label="MarieRank3Convo6 begins.",color=orange];
		1418 -> 3740;
	3740 [label="Update boolean MarieLyonAvailable",color=orange];
		3740 -> 1419;
	1419 [label="我必须问你一个问题，漂泊者，同时也请你别因此评判我。",shape=box,color=blue];
		1419 -> 1420;
		1419 -> 1421;
		1419 -> 1422;
	1420 [label="你被卷入了一场荒诞的处境。我当然不会评判你。",shape=box,color=red];
		1420 -> 1423;
	1421 [label="我会尽力的。",shape=box,color=red];
		1421 -> 1424;
	1422 [label="[结束]",shape=box,color=red];
		1422 -> 1425;
	1423 [label="Vraiment gentil，在不了解我，也不知我要问点什么的情况下就对我如此宽厚。",shape=box,color=blue];
		1423 -> 1426;
	1424 [label="+10 Chemistry",color=orange];
		1424 -> 1427;
	1425 [label="Chat ends.",color=orange];
	1426 [label="但是……那个大脑袋会说话的鱼，也会让你头疼吗 ？斐波那契 ？",shape=box,color=blue];
		1426 -> 1428;
		1426 -> 1429;
		1426 -> 1430;
	1427 [label="我非常感激，谢谢。",shape=box,color=blue];
		1427 -> 1426;
	1428 [label="是的。是的，当然。多谢你提出来。",shape=box,color=red];
		1428 -> 1431;
	1429 [label="你对斐波那契感到烦躁的念头真是可爱极了。",shape=box,color=red];
		1429 -> 1432;
	1430 [label="其实，并不会。我非常喜欢他。",shape=box,color=red];
		1430 -> 1433;
	1431 [label="那我很庆幸自己并非孤身一人。不过先说明，这绝非对他的侮辱之意。如果我因为现状而心神不宁，想必他也是竭尽全力在忍受。",shape=box,color=blue];
		1431 -> 1434;
	1432 [label="哦 ？怎么会呢 ？我猜我应该为此感到高兴，但实在不明白为什么。我的头痛可没这么迷人。",shape=box,color=blue];
		1432 -> 1435;
		1432 -> 1436;
	1433 [label="那么我只能请求你的原谅，这绝非对他的侮辱之意。如果我因为现状而心神不宁，想必他也是竭尽全力在忍受。",shape=box,color=blue];
		1433 -> 1437;
	1434 [label="他这样做的方式，只是当我长时间被迫承受时，实在难以认同罢了。",shape=box,color=blue];
		1434 -> 1438;
	1435 [label="我大部分时间都在为生存而战。像这样的人性微光……某种程度上是支撑我活下去的意义。",shape=box,color=red];
		1435 -> 1439;
	1436 [label="我想偶尔还是得退一步，反思这一切的荒谬。一个诺格和一位太阳神祭司……",shape=box,color=red];
		1436 -> 1440;
	1437 [label="他这样做的方式，只是当我长时间被迫承受时，实在难以认同罢了。",shape=box,color=blue];
		1437 -> 1441;
	1438 [label="唉。我不该抱怨的。今晚必须给里昂送晚餐，他又被严重的偏头风折磨得动弹不得了。",shape=box,color=blue];
		1438 -> 1442;
		1438 -> 1443;
	1439 [label="+5 Chemistry",color=orange];
		1439 -> 1444;
	1440 [label="+5 Chemistry",color=orange];
		1440 -> 1445;
	1441 [label="唉。我不该抱怨的。今晚必须给里昂送晚餐，他又被严重的偏头风折磨得动弹不得了。",shape=box,color=blue];
		1441 -> 1442;
		1441 -> 1443;
	1442 [label="他经常会这样吗 ？",shape=box,color=red];
		1442 -> 1446;
	1443 [label="不好意思……什么 ？",shape=box,color=red];
		1443 -> 1447;
	1444 [label="永远不要失去你生命中那部分，漂泊者。永远不要放弃你内心追寻生命火花的那部分。",shape=box,color=blue];
		1444 -> 1448;
	1445 [label="天啊，这么一说就明白啦。这确实像那些幼稚的笑话，n'est-ce pas ？",shape=box,color=blue];
		1445 -> 1449;
	1446 [label="Oui，oui。几周一次 ？两个月一次 ？我记得他最久一次没犯病的记录大概是半年吧。",shape=box,color=blue];
		1446 -> 1450;
	1447 [label="哦 ！亲爱的。嗯。就像是头痛，但要剧烈得多。我听说有人称之为胆汁性头痛。这种头痛在女性中更为常见。",shape=box,color=blue];
		1447 -> 1451;
		1447 -> 1452;
	1448 [label="这世界总爱把自己装扮成阴郁沉重之地，随时准备在每个转角处向我们施加苦难。",shape=box,color=blue];
		1448 -> 1453;
	1449 [label="一位修女、一位神父和来自未来的恶魔被送往过去……又被送往未来……途中遇见了鱼、鹿形生物、巨鸟和管家……",shape=box,color=blue];
		1449 -> 1454;
	1450 [label="Check boolean Megrim",color=orange];
		1450 -> 1455 [label=true,color=green];
		1450 -> 1456 [label=true,color=green];
		1450 -> 1458 [label=true,color=green];
		1450 -> 1455 [label=false,color=brown];
		1450 -> 1456 [label=false,color=brown];
		1450 -> 1457 [label=false,color=brown];
	1451 [label="我想我们现在都称它们为“偏头痛”了。",shape=box,color=red];
		1451 -> 1459;
	1452 [label="呃。偏头风。谢谢。",shape=box,color=red];
		1452 -> 1460;
	1453 [label="我们必须寻找一切可能的明媚与轻松，哪怕不得不以幼稚的形式出现。",shape=box,color=blue];
		1453 -> 1461;
	1454 [label="这真是有趣得很，你说得太对了 ！",shape=box,color=blue];
		1454 -> 1462;
	1455 [label="我在想是什么原因导致的。",shape=box,color=red];
		1455 -> 1463;
	1456 [label="听起来糟透了……",shape=box,color=red];
		1456 -> 1464;
	1458 [label="我也会得偏头风。那感觉糟透了。",shape=box,color=red];
		1458 -> 1465;
	1457 [label="我也会有这种头痛，简直要命。",shape=box,color=red];
		1457 -> 1465;
	1459 [label="真想知道我们还会发现哪些迷人的历史 particularités ！太令人兴奋了。我确实热爱学习新事物。“偏头痛。”这趟旅程显然不远。",shape=box,color=blue];
		1459 -> 1466;
	1460 [label="Update boolean Megrim",color=orange];
		1460 -> 1467;
	1461 [label="要是里昂也能这么想就好了。",shape=box,color=blue];
		1461 -> 1468;
	1462 [label="但愿我亲爱的里昂也能同样看到其中的光芒。",shape=box,color=blue];
		1462 -> 1468;
	1463 [label="他自有他的理论。 ",shape=box,color=blue];
		1463 -> 1469;
	1464 [label="如果你想表达慰问，我相信他定会欣然接受。尽管可能看起来并非如此，但他其实很享受有人陪伴。",shape=box,color=blue];
		1464 -> 1470;
	1465 [label="你也有吗 ？你该告诉里昂。他需要知道其他人也可能经历如此相似的痛苦。",shape=box,color=blue];
		1465 -> 1471;
	1466 [label="Update boolean Migraine",color=orange];
		1466 -> 1467;
	1467 [label="不管叫什么名字，里昂都被它打倒，直到天亮才能转好。可怜的他眼前一片模糊，手脚也毫无知觉。他说这痛苦简直难以忍受。",shape=box,color=blue];
		1467 -> 1450;
	1468 [label="Update boolean MarieLyonSuffering1",color=orange];
		1468 -> 1472;
	1469 [label="虽然更准确的说法是，直到最近他才有了自己的理论。",shape=box,color=blue];
		1469 -> 1473;
	1470 [label="尽管他的举止或许试图劝阻你，我恳请你坚守信念，漂泊者。在那看似坚毅冷峻的外表之下，深藏着一个亟需帮助的人。",shape=box,color=blue];
		1470 -> 1474;
		1470 -> 1475;
		1470 -> 1476;
	1471 [label="+5 Chemistry",color=orange];
		1471 -> 1477;
	1472 [label="啊，说到这个。我为抱怨头痛感到很愧疚。今晚必须给里昂送晚餐，他又被严重的偏头风折磨得动弹不得了。",shape=box,color=blue];
		1472 -> 1443;
		1472 -> 1442;
	1473 [label="Update boolean MarieLyonFaith1",color=orange];
		1473 -> 1470;
	1474 [label="我可固执得很。你别担心。",shape=box,color=red];
		1474 -> 1478;
	1475 [label="我已经有一个墙中人了……为什么不能有两个 ？",shape=box,color=red];
		1475 -> 1479;
	1476 [label="他是个成年人了。要是他愿意开口，自然会说。",shape=box,color=red];
		1476 -> 1480;
	1477 [label="双耀神深知，若非如此，他宁愿独自承受痛苦……",shape=box,color=blue];
		1477 -> 1481;
	1478 [label="+5 Chemistry",color=orange];
		1478 -> 1482;
	1479 [label="你可以这样跟我开玩笑，但别对他讲这种话。关于虚空无情之物的话对他而言是个痛处。",shape=box,color=blue];
		1479 -> 1483;
	1480 [label="他是成年人了，没错。他是个男人了，也没错。我相信他也渴望倾诉。但我要问你，他真能开口吗。",shape=box,color=blue];
		1480 -> 1484;
	1481 [label="Update boolean MarieLyonSuffering2",color=orange];
		1481 -> 1470;
	1482 [label="恐怕你和他在一起时会需要这份固执的。谢谢你，漂泊者。他是我最亲密的朋友，也像我的兄弟。看着他承受如此痛苦，我的心都碎了。",shape=box,color=blue];
		1482 -> 1485;
	1483 [label="要坚韧。要耐心。要善良。他就像我的兄弟，也是我最亲密的朋友，漂泊者。看到他承受如此痛苦，我的心都碎了。",shape=box,color=blue];
		1483 -> 1485;
	1484 [label="我们并非生而就拥有同等天赋，也不都觉得自己理应享有这些。他正承受着痛苦，并认为痛苦就是他注定的命运。",shape=box,color=blue];
		1484 -> 1486;
	1485 [label="我们很快会再聊。Par la grâce de Sol。",shape=box,color=blue];
		1485 -> 3734;
	1486 [label="他就像我的兄弟，也是我最亲密的朋友。想到他，我的心便碎成千片。因此我只能恳请你……耐心些。温柔些。如果你能做到的话。",shape=box,color=blue];
		1486 -> 1485;
	3734 [label="{\"Id\":3734,\"Incoming\":[1485],\"Outgoing\":[1487],\"GraphPos\":[12826,24521],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue\",\"Tag\":\"LyonHeadaches\",\"Value\":0}]}",color=orange];
		3734 -> 1487;
	1487 [label="Chat ends.",color=orange];
