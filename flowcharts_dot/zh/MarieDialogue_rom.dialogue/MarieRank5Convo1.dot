		2461 -> 2468 [label="MarieEntratiFan2",color=purple];
		2461 -> 2470 [label="false",color=purple];
	2462 [label="Evaluate expressions",color=orange];
		2462 -> 2473 [label="MarieEntratiMonster1",color=purple];
		2462 -> 2473 [label="MarieEntratiMonster2",color=purple];
		2462 -> 2471 [label="MarieEntratiFan1",color=purple];
		2462 -> 2471 [label="MarieEntratiFan2",color=purple];
		2462 -> 2472 [label="false",color=purple];
	2463 [label="这​就​是​你​建议​我们​去​做​的​事 ？​驱逐主教 ？​我​认为​似乎​他​自己​就​是​这样​做​的，​non ？​",shape=box,color=blue];
		2463 -> 2474;
		2463 -> 2467;
	2464 [label="我​认为​里昂​承受​着​许多​痛苦，​很​大​一​部分​是​源于​他​对​自己​和​自身​精神​的​怀疑。​而​主教​似乎……​只​是​加速​了​事情​的​发展。​",shape=box,color=blue];
		2464 -> 2475;
		2464 -> 2467;
	2465 [label="那你想让我怎么做 ？烧毁主教的肖像并谴责他 ？把他打入虚空，像诅咒标弃先生那样诅咒他 ？",shape=box,color=blue];
		2465 -> 2474;
		2465 -> 2467;
	2466 [label="玛丽，这就是问题所在。​是你​在对​别人​的​要求，​而​不​是​他们​对​你、​或者​对​英择谛​的​要求。​",shape=box,color=red];
		2466 -> 2476;
	2467 [label="英择谛所到之处，都会留下伤痕累累的人。我所做的，只是想帮助这些人重拾生活。至于他所谓的“善”或“恶”，我并不在意。",shape=box,color=red];
		2467 -> 2477;
	2469 [label="Oui，你对他的恨意还真是始终如一 ！我说的话难道一点也没让你对主教心软吗 ？",shape=box,color=blue];
		2469 -> 2482;
	2468 [label="你刚才不是还跟我说过你和我一样偏向英择谛吗？那现在为什么变了？",shape=box,color=blue];
		2468 -> 2478;
		2468 -> 2479;
		2468 -> 2480;
		2468 -> 2481;
	2470 [label="O​ui，​你​似乎​认定英择谛​是​个​ monstre ！​你​如此​轻易​就​否定​了​他​的​善意​ ！​",shape=box,color=blue];
		2470 -> 2482;
	2473 [label="你刚才不是还跟我说过英择谛的 monstruosité 吗？那现在为什么变了？",shape=box,color=blue];
		2473 -> 2478;
		2473 -> 2479;
		2473 -> 2480;
		2473 -> 2481;
	2471 [label="Merci，你一直是我在这场征途中坚定的伙伴 ！恐怕只有我们这么想——就连洛德先生也怀有同样的怨恨……",shape=box,color=blue];
		2471 -> 2483;
	2472 [label="Merci，听到你这么说我真是太高兴了 ！恐怕只有我们这么想——就连洛德先生也怀有同样的怨恨……",shape=box,color=blue];
		2472 -> 2483;
	2474 [label="我​认为​问题​更​多​在​于​你​对​别人​的​要求，​而​不​是​他们​对​你、​或者​对​英择谛​的​要求。​",shape=box,color=red];
		2474 -> 2476;
	2475 [label="这一点也没有困扰到你吗？",shape=box,color=red];
		2475 -> 2484;
	2476 [label="难道我向别人提出的要求很荒谬吗 ？要他们去宽恕很荒谬吗 ？",shape=box,color=blue];
		2476 -> 2485;
		2476 -> 2486;
	2477 [label="穿越时空去帮助他那些 mécontents，这固然高尚，但或许也令人疲惫，non ？你肯定会因此怨恨他吧……",shape=box,color=blue];
		2477 -> 2487;
		2477 -> 2488;
	2482 [label="这场对话就是个错误……",shape=box,color=blue];
		2482 -> 2493;
		2482 -> 2494;
	2478 [label="说实话，我一直觉得跟你讨论这个话题很难，真的非常难。我个人觉得他……既不好也不坏，而是两者兼具。",shape=box,color=red];
		2478 -> 2489;
	2479 [label="我改变主意了。我选择站在他这边。也站在你这边。你说服我了。",shape=box,color=red];
		2479 -> 2490;
	2480 [label="[表白心意] 恐怕是我一直都在努力……讨你欢心。我喜欢你。其实比我表现出来的要强烈得多。",shape=box,color=red];
		2480 -> 2491;
	2481 [label="我改变主意了，我认定他就是个怪物。就这么定了。",shape=box,color=red];
		2481 -> 2492;
	2483 [label="或许我们可以携手抵挡那些企图玷污他善行的人，oui ？但我想知道，在你所处的一切之中……你为何会站在我这边 ？",shape=box,color=blue];
		2483 -> 2495;
	2484 [label="Check boolean LyonDating",color=orange];
		2484 -> 2496 [label=true,color=green];
		2484 -> 2497 [label=false,color=brown];
	2485 [label="玛丽，​你​把​英择​谛捧​得​太​高​了。​你​还​要求​其他​人​像​傻子​一样​效仿​你。​",shape=box,color=red];
		2485 -> 2498;
	2486 [label="我认为你要求他们做的不仅仅是原谅英择谛，而是要他们假装他所做的一切都没有错。",shape=box,color=red];
		2486 -> 2499;
	2487 [label="当然。​但​我​也​要​感谢​他，​因为​他​让​我​结识​了​一些​我​人生​中​最​重要​的​爱人​和​朋友。​",shape=box,color=red];
		2487 -> 2500;
	2488 [label="不，其实没有。他需要我这么做，所以我就做了。等一切尘埃落定，我自然会评判他的。",shape=box,color=red];
		2488 -> 2500;
	2493 [label="玛丽，等等。求你了。让我解释一下。",shape=box,color=red];
		2493 -> 2505;
		2493 -> 2506;
		2493 -> 2507;
		2493 -> 2508;
	2494 [label="我已经明确表达了我对英择谛的看法。很抱歉，在有些事情上，我们就是意见不一致。",shape=box,color=red];
		2494 -> 2509;
	2489 [label="Update boolean MarieEntratiMonster1",color=orange];
		2489 -> 2501;
	2490 [label="Update boolean MarieEntratiMonster1",color=orange];
		2490 -> 2502;
	2491 [label="Update boolean DrifterMarieWhoops",color=orange];
		2491 -> 2503;
	2492 [label="Update boolean MarieEntratiFan1",color=orange];
		2492 -> 2504;
	2495 [label="当然，我不是在抱怨 ！",shape=box,color=blue];
		2495 -> 2510;
		2495 -> 2511;
		2495 -> 2512;
	2496 [label="我​知道​他​已经​在​你​心里​占据​了​一席​之地，​对​此​我​由​衷​地​感激​——​也​许​我​终于​可以​不​再​担心​他​了，​所有​这些​争吵​很​快​就​会​变得​毫​无意义​——​",shape=box,color=blue];
		2496 -> 2497;
	2497 [label="但​这​当然​让​我​心烦。​他​是​我​的​灵魂​兄弟！​我​的​里昂​是​我​这​世​上​最​珍贵​的​人，​看到​他​痛苦​的​样子，​我​的​胸口​也​一​阵​剧痛，​仿佛​他​的​痛苦​就​是​我​自己​的​痛苦。​",shape=box,color=blue];
		2497 -> 2513;
	2498 [label="漂泊者，​注意​你​的​言辞。​",shape=box,color=blue];
		2498 -> 2514;
	2499 [label="Je ne suis pas naïve，你​不​必​这样​来​跟​我​说话​ ！",shape=box,color=blue];
		2499 -> 2515;
	2500 [label="也​许​他​只是​以​毒​攻毒，​而​这​种​残忍​是​必要​的。​",shape=box,color=blue];
		2500 -> 2516;
		2500 -> 2517;
	2505 [label="[坦白心意] 我很在乎你。比我表现出来的还要在乎。而且……我很抱歉我之前对你很苛刻，但我不能让他伤害你。毕竟他已经伤害了那么多人。",shape=box,color=red];
		2505 -> 2523;
	2506 [label="我亲眼目睹英择谛毁掉了所有他关心的人、所有他声称爱过的人。我不想看到他对你也这样做……",shape=box,color=red];
		2506 -> 2524;
	2507 [label="我不太擅长表达自己，对此我很抱歉。但是……我恐怕他是在利用你，利用你的善良来操控你。仅此而已。",shape=box,color=red];
		2507 -> 2525;
	2508 [label="你或许视英择谛为救世主，但我却视他为一个惊恐的老人，正苦苦寻找答案。或许答案就在两者之间。",shape=box,color=red];
		2508 -> 2498;
	2509 [label="Oui。看起来是这样。",shape=box,color=blue];
		2509 -> 2526;
	2501 [label="Update boolean MarieEntratiMonster2",color=orange];
		2501 -> 2518;
	2502 [label="Update boolean MarieEntratiMonster2",color=orange];
		2502 -> 2519;
	2503 [label="所以你欺骗我是为了博取我的好感……je vois。",shape=box,color=blue];
		2503 -> 2520;
		2503 -> 2521;
	2504 [label="Update boolean MarieEntratiFan2",color=orange];
		2504 -> 2522;
	2510 [label="[坦白心意] 我很在乎你。比我表现出来的还要在乎。",shape=box,color=red];
		2510 -> 2527;
	2511 [label="我认为在这场战争中，任何手段都是必要的。毕竟，我们是在试图拯救宇宙，对抗虚空无情之物，不是吗？",shape=box,color=red];
		2511 -> 2528;
	2512 [label="我相信英择谛。真的。我认为他有解决这个问题的计划，而且这一切最终都是为了大家好。",shape=box,color=red];
		2512 -> 2529;
	2513 [label="但​他​的​信仰​崩塌​并​非​主教​的​错。​根基早​已​崩塌，​其实​这​只​是​增加​了​更​多​压力​而​已，​oui ？​",shape=box,color=blue];
		2513 -> 2500;
	2514 [label="Update boolean MarieWarning",color=orange];
		2514 -> 2499;
	2515 [label="我​很​清楚，​主教​是​月神，​也​是​太阳神​——​光明​与​黑暗​——善良​与​邪恶。​他​既​非​光明，​又​非​黑暗，​既善良​又​残忍。​",shape=box,color=blue];
		2515 -> 2530;
		2515 -> 2531;
	2516 [label="这​就​是​为什么​其他​人​一​听​你​提到​他​就​会​生气。​你​对​他​伤害​过​他们​的​一​切视而​不见，​像​个​傻子​一样​假装​什么​都​没​发生​过。​",shape=box,color=red];
		2516 -> 2498;
	2517 [label="玛丽，​别说​了。​你​得​接受，​他​这么​做，​并​不​是​因为​他​是​个​好人。​他​不​是​那样​的​人。​他​比​你​想​的​要​更​复杂。​",shape=box,color=red];
		2517 -> 2499;
	2523 [label="Update boolean DrifterMarie",color=orange];
		2523 -> 2536;
	2524 [label="漂泊者，​注意​你​的​言辞。​",shape=box,color=blue];
		2524 -> 2537;
	2525 [label="我不需要像现在这样被保护 ！Je ne suis pas une enfant naïve ！",shape=box,color=blue];
		2525 -> 2538;
	2526 [label="Update boolean MarieEntrati5g",color=orange];
		2526 -> 2539;
	2518 [label="Update boolean MarieEntratiFan1",color=orange];
		2518 -> 2532;
	2519 [label="Update boolean MarieEntratiFan2",color=orange];
		2519 -> 2533;
	2520 [label="嗯，你这么一说…… ",shape=box,color=red];
		2520 -> 2534;
	2521 [label="这只是一部分原因。",shape=box,color=red];
		2521 -> 2534;
	2522 [label="Update boolean MarieEntratiMonster2",color=orange];
		2522 -> 2535;
	2527 [label="Update boolean DrifterMarieWhoops",color=orange];
		2527 -> 2540;
	2528 [label="没错 ！正是如此 ！终于有人明白事理了。这场战争中无辜者遭受伤害，我也感到无比痛心，但一切都岌岌可危。 ",shape=box,color=blue];
		2528 -> 2541;
	2529 [label="Update boolean MarieWillDate",color=orange];
		2529 -> 2542;
	2530 [label="玛丽，​他​不​是​神。​他​只​是​一​个​凡人。​他​和​罗瑟​一样​傲慢，​一样​危险。​他​来自​同​一​个​世界，​遭受​着​同样​的​问题。​",shape=box,color=red];
		2530 -> 2543;
	2531 [label="我知道他对你很好。我知道他待你或许和待很多人不一样。或许他甚至把你当女儿一样待……但请你从大局着眼。",shape=box,color=red];
		2531 -> 2544;
	2536 [label="我……我不知道该如何回应这话，考虑到……考虑到我们目前的谈话。我……真的被吓了一跳。 ",shape=box,color=blue];
		2536 -> 2549;
