		j709500590 -> j277491295 [label="MarieEntrati3b",color=purple];
		j709500590 -> j3607493956 [label="MarieEntrati3",color=purple];
		j709500590 -> j2673071154 [label="false",color=purple];
	j1136199229 [label="我​一直​在​思考​你​对​主教​的​评价。​他​的​行为……既​有善，​也​有恶。​",shape=box,color=blue];
		j1136199229 -> j3162986909;
	j507450512 [label="我​一直​在​思考​你​对​主教​的​评价。你说他的行为给里昂带来了痛苦。",shape=box,color=blue];
		j507450512 -> j3162986909;
	j1113420421 [label="我一直在思考我们关于标弃先生的谈话，以及你对他为何如此憎恨主教那令人信服的论据。",shape=box,color=blue];
		j1113420421 -> j3162986909;
	j277491295 [label="我一直在思考我和标弃先生的争论，以及他如此憎恨主教的原因。",shape=box,color=blue];
		j277491295 -> j3162986909;
	j3607493956 [label="我一直在思考我和标弃先生的争吵，以及我们围绕那次争吵展开的争论。",shape=box,color=blue];
		j3607493956 -> j3162986909;
	j2673071154 [label="我觉得关于主教，还有很多话没说。其他人似乎在我面前小心翼翼，不敢提起他。",shape=box,color=blue];
		j2673071154 -> j3162986909;
	j3162986909 [label="我​知道​别人​会​把​他​描绘成​一​个​混蛋、​一​个​疯子、​一​个​叛徒。​但​在​我​看来，​他​不​是​那样​的​人。​",shape=box,color=blue];
		j3162986909 -> j2718976672;
	j2718976672 [label="Check boolean MarieBackstory1",color=orange];
		j2718976672 -> j476222056 [label=true,color=green];
		j2718976672 -> j2570294835 [label=false,color=brown];
	j476222056 [label="或许是因为我已经习惯了被抛弃。",shape=box,color=blue];
		j476222056 -> j1016149362;
	j2570294835 [label="我​小时候​就​被​家​人​抛弃，​流落​街头，​只​因……​不​正常。​身体残缺。​不​适合​上​流​社会。​",shape=box,color=blue];
		j2570294835 -> j1016149362;
	j1016149362 [label="也​许正​是​因为​我​从​来​没有​过​父亲，​所以​我​才​如此​愿意​原谅​他​的​缺席。​",shape=box,color=blue];
		j1016149362 -> j4106479212;
	j4106479212 [label="Evaluate expressions",color=orange];
		j4106479212 -> j3625886785 [label="MarieEntrati4a",color=purple];
		j4106479212 -> j4136309410 [label="MarieEntrati4b",color=purple];
		j4106479212 -> j266689259 [label="MarieEntrati3a",color=purple];
		j4106479212 -> j337406265 [label="MarieEntrati3b",color=purple];
		j4106479212 -> j3115856101 [label="MarieEntrati3",color=purple];
		j4106479212 -> j4029836667 [label="false",color=purple];
	j3625886785 [label="但​事实​是，​我​确实​原谅​了​他。​因为​我​认为​他​的​善行​比​他​的​恶行​更​有​价值。​",shape=box,color=blue];
		j3625886785 -> j595487253;
		j3625886785 -> j2972835518;
		j3625886785 -> j2957758457;
		j3625886785 -> j2273158357;
		j3625886785 -> j333155484;
	j4136309410 [label="我祈祷里昂能够坚强地度过他所遭受的信仰危机，但我并不认为这完全是主教的错。",shape=box,color=blue];
		j4136309410 -> j595487253;
		j4136309410 -> j2972835518;
		j4136309410 -> j2957758457;
		j4136309410 -> j389424919;
		j4136309410 -> j2596579812;
	j266689259 [label="你对标弃先生以及那些受他伤害的人提出的论点很令人信服，我也很理解……但我仍然认为他的善行比他的恶行更有价值。",shape=box,color=blue];
		j266689259 -> j595487253;
		j266689259 -> j2972835518;
		j266689259 -> j2957758457;
		j266689259 -> j470594056;
		j266689259 -> j3957154648;
	j337406265 [label="虽然我理解标弃先生的愤怒，也能体会他的观点，但他必须从内心深处找到原谅主教的理由。因为在我看来，主教的善行远比他的恶行更有价值。",shape=box,color=blue];
		j337406265 -> j595487253;
		j337406265 -> j2972835518;
		j337406265 -> j2957758457;
		j337406265 -> j1253773825;
		j337406265 -> j402533645;
	j3115856101 [label="虽然我很理解大家与主教的过往，尤其是标弃先生，但我仍然更看重他的善行，而不是他的恶行。",shape=box,color=blue];
		j3115856101 -> j595487253;
		j3115856101 -> j2972835518;
		j3115856101 -> j2957758457;
		j3115856101 -> j275895013;
	j4029836667 [label="虽然我很理解大家与主教的过往，但我仍然更看重他的善行，而不是他的恶行。",shape=box,color=blue];
		j4029836667 -> j595487253;
		j4029836667 -> j2972835518;
		j4029836667 -> j2957758457;
	j595487253 [label="我不会责怪你感激他给你的生活带来的益处，就像我不会责怪其他人怨恨他给他们的人生带来的伤害一样。",shape=box,color=red];
		j595487253 -> j1739051442;
	j2972835518 [label="我​不​知道。​我​倒​觉得​他​的​行为​弊​大于利。​真希望​你​也​能​看清​这​一点。​",shape=box,color=red];
		j2972835518 -> j4288371264;
	j2957758457 [label="玛丽，我支持你。我不能责怪英择谛所做的一切。他是在对抗虚空无情之物。",shape=box,color=red];
		j2957758457 -> j3142094137;
	j2273158357 [label="你​原谅​英择谛​是​对​的。​我​希望​其他​人​也​能​像​你​一样。​",shape=box,color=red];
		j2273158357 -> j3142094137;
	j333155484 [label="我​永远​不​会​因为​原谅​而​责怪​别人。​你​可以​原谅​别人，​但​同时​也​要​明白​你​必须​保护​自己​和​他​人​不​受​伤害。​",shape=box,color=red];
		j333155484 -> j4291386165;
	j389424919 [label="你认为里昂的遭遇是他咎由自取吗？",shape=box,color=red];
		j389424919 -> j963399809;
	j2596579812 [label="玛丽，里昂面临的远不止信仰危机。而这很大程度上与英择谛有关。",shape=box,color=red];
		j2596579812 -> j4288371264;
	j470594056 [label="难道我说的话一点都没有让双方的立场有所缓和吗？",shape=box,color=red];
		j470594056 -> j3498248267;
	j3957154648 [label="纵观英择谛所做的一切，你怎么还能认为利大于弊呢？",shape=box,color=red];
		j3957154648 -> j4288371264;
	j1253773825 [label="我认为你低估了科维兽和标弃所遭受的苦难。",shape=box,color=red];
		j1253773825 -> j4288371264;
	j402533645 [label="宽恕固然重要，但承认英择谛比你想象的要复杂得多也同样重要。",shape=box,color=red];
		j402533645 -> j3498248267;
	j275895013 [label="我还是觉得你不明白标弃和科维兽经历了什么。他们比你经历的要糟糕得多。",shape=box,color=red];
		j275895013 -> j4288371264;
	j1739051442 [label="但你明白这两者价值并不相等吗 ？怨恨和敬仰 ？我希望其他人能够放下他们的恶意仇恨。",shape=box,color=blue];
		j1739051442 -> j3141590385;
		j1739051442 -> j4032391300;
	j4288371264 [label="Evaluate expressions",color=orange];
		j4288371264 -> j671039592 [label="MarieEntratiMonster1",color=purple];
		j4288371264 -> j671039592 [label="MarieEntratiMonster2",color=purple];
		j4288371264 -> j3875683959 [label="MarieEntratiFan1",color=purple];
		j4288371264 -> j3875683959 [label="MarieEntratiFan2",color=purple];
		j4288371264 -> j1107859971 [label="false",color=purple];
	j3142094137 [label="Evaluate expressions",color=orange];
		j3142094137 -> j3587944048 [label="MarieEntratiMonster1",color=purple];
		j3142094137 -> j3587944048 [label="MarieEntratiMonster2",color=purple];
		j3142094137 -> j2964868185 [label="MarieEntratiFan1",color=purple];
		j3142094137 -> j2964868185 [label="MarieEntratiFan2",color=purple];
		j3142094137 -> j2817871624 [label="false",color=purple];
	j4291386165 [label="这​就​是​你​建议​我们​去​做​的​事 ？​驱逐主教 ？​我​认为​似乎​他​自己​就​是​这样​做​的，​non ？​",shape=box,color=blue];
		j4291386165 -> j3387837033;
		j4291386165 -> j4032391300;
	j963399809 [label="我​认为​里昂​承受​着​许多​痛苦，​很​大​一​部分​是​源于​他​对​自己​和​自身​精神​的​怀疑。​而​主教​似乎……​只​是​加速​了​事情​的​发展。​",shape=box,color=blue];
		j963399809 -> j2777920098;
		j963399809 -> j4032391300;
	j3498248267 [label="那你想让我怎么做 ？烧毁主教的肖像并谴责他 ？把他打入虚空，像标弃先生那样诅咒他 ？",shape=box,color=blue];
		j3498248267 -> j3387837033;
		j3498248267 -> j4032391300;
	j3141590385 [label="玛丽，这就是问题所在。​是你​在对​别人​的​要求，​而​不​是​他们​对​你、​或者​对​英择谛​的​要求。​",shape=box,color=red];
		j3141590385 -> j3259482952;
	j4032391300 [label="英择谛所到之处，都会留下伤痕累累的人。我所做的，只是想帮助这些人重拾生活。至于他所谓的“善”或“恶”，我并不在意。",shape=box,color=red];
		j4032391300 -> j2556564582;
	j671039592 [label="Oui，你对他的恨意还真是始终如一 ！我说的话难道一点也没让你对主教心软吗 ？",shape=box,color=blue];
		j671039592 -> j1461280222;
	j3875683959 [label="你刚才不是还跟我说过你和我一样偏向英择谛吗？那现在为什么变了？",shape=box,color=blue];
		j3875683959 -> j1323625753;
		j3875683959 -> j307965264;
		j3875683959 -> j4230287718;
		j3875683959 -> j3968858809;
	j1107859971 [label="O​ui，​你​似乎​认定英择谛​是​个​ monstre ！​你​如此​轻易​就​否定​了​他​的​善意​ ！​",shape=box,color=blue];
		j1107859971 -> j1461280222;
	j3587944048 [label="你刚才不是还跟我说过英择谛的 monstruosité 吗？那现在为什么变了？",shape=box,color=blue];
		j3587944048 -> j1323625753;
		j3587944048 -> j307965264;
		j3587944048 -> j4230287718;
		j3587944048 -> j3968858809;
	j2964868185 [label="Merci，你一直是我在这场征途中坚定的伙伴 ！恐怕只有我们这么想——就连洛德先生也怀有同样的怨恨……",shape=box,color=blue];
		j2964868185 -> j1460658568;
	j2817871624 [label="Merci，听到你这么说我真是太高兴了 ！恐怕只有我们这么想——就连洛德先生也怀有同样的怨恨……",shape=box,color=blue];
		j2817871624 -> j1460658568;
	j3387837033 [label="我​认为​问题​更​多​在​于​你​对​别人​的​要求，​而​不​是​他们​对​你、​或者​对​英择谛​的​要求。​",shape=box,color=red];
		j3387837033 -> j3259482952;
	j2777920098 [label="这一点也没有困扰到你吗？",shape=box,color=red];
		j2777920098 -> j2159116448;
	j3259482952 [label="难道我向别人提出的要求很荒谬吗 ？要他们去宽恕很荒谬吗 ？",shape=box,color=blue];
		j3259482952 -> j1475946782;
		j3259482952 -> j159671899;
	j2556564582 [label="穿越时空去帮助他那些 mécontents，这固然高尚，但或许也令人疲惫，non ？你肯定会因此怨恨他吧……",shape=box,color=blue];
		j2556564582 -> j1860169024;
		j2556564582 -> j2512985486;
	j1461280222 [label="这场对话就是个错误……",shape=box,color=blue];
		j1461280222 -> j2415904359;
		j1461280222 -> j3304823545;
	j1323625753 [label="说实话，我一直觉得跟你讨论这个话题很难，真的非常难。我个人觉得他……既不好也不坏，而是两者兼具。",shape=box,color=red];
		j1323625753 -> j2974015157;
	j307965264 [label="我改变主意了。我选择站在他这边。也站在你这边。你说服我了。",shape=box,color=red];
		j307965264 -> j540748619;
	j4230287718 [label="[表白心意] 恐怕是我一直都在努力……讨你欢心。我喜欢你。其实比我表现出来的要强烈得多。",shape=box,color=red];
		j4230287718 -> j2262479532;
	j3968858809 [label="我改变主意了，我认定他就是个怪物。就这么定了。",shape=box,color=red];
		j3968858809 -> j2303802154;
	j1460658568 [label="或许我们可以携手抵挡那些企图玷污他善行的人，oui ？但我想知道，在你所处的一切之中……你为何会站在我这边 ？",shape=box,color=blue];
		j1460658568 -> j1389496114;
	j2159116448 [label="Check boolean LyonDating",color=orange];
		j2159116448 -> j2748085380 [label=true,color=green];
		j2159116448 -> j265031875 [label=false,color=brown];
	j1475946782 [label="玛丽，​你​把​英择​谛捧​得​太​高​了。​你​还​要求​其他​人​像​傻子​一样​效仿​你。​",shape=box,color=red];
		j1475946782 -> j2878608851;
	j159671899 [label="我认为你要求他们做的不仅仅是原谅英择谛，而是要他们假装他所做的一切都没有错。",shape=box,color=red];
		j159671899 -> j3395387371;
	j1860169024 [label="当然。​但​我​也​要​感谢​他，​因为​他​让​我​结识​了​一些​我​人生​中​最​重要​的​爱人​和​朋友。​",shape=box,color=red];
		j1860169024 -> j1455446316;
	j2512985486 [label="不，其实没有。他需要我这么做，所以我就做了。等一切尘埃落定，我自然会评判他的。",shape=box,color=red];
		j2512985486 -> j1455446316;
	j2415904359 [label="玛丽，等等。求你了。让我解释一下。",shape=box,color=red];
		j2415904359 -> j4171671900;
		j2415904359 -> j4113856505;
		j2415904359 -> j3230335339;
		j2415904359 -> j3830830877;
	j3304823545 [label="我已经明确表达了我对英择谛的看法。很抱歉，在有些事情上，我们就是意见不一致。",shape=box,color=red];
		j3304823545 -> j4248249632;
	j2974015157 [label="Boolean MarieEntratiMonster1 is now false.",color=orange];
		j2974015157 -> j1238660470;
	j540748619 [label="Boolean MarieEntratiMonster1 is now false.",color=orange];
		j540748619 -> j2700101464;
	j2262479532 [label="Boolean DrifterMarieWhoops is now true.",color=orange];
		j2262479532 -> j3443285823;
	j2303802154 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j2303802154 -> j3358539780;
	j1389496114 [label="当然，我不是在抱怨 ！",shape=box,color=blue];
		j1389496114 -> j206973647;
		j1389496114 -> j3314407186;
		j1389496114 -> j16441185;
	j2748085380 [label="我​知道​他​已经​在​你​心里​占据​了​一席​之地，​对​此​我​由​衷​地​感激​——​也​许​我​终于​可以​不​再​担心​他​了，​所有​这些​争吵​很​快​就​会​变得​毫​无意义​——​",shape=box,color=blue];
		j2748085380 -> j265031875;
	j265031875 [label="但​这​当然​让​我​心烦。​他​是​我​的​灵魂​兄弟！​我​的​里昂​是​我​这​世​上​最​珍贵​的​人，​看到​他​痛苦​的​样子，​我​的​胸口​也​一​阵​剧痛，​仿佛​他​的​痛苦​就​是​我​自己​的​痛苦。​",shape=box,color=blue];
		j265031875 -> j1704740538;
	j2878608851 [label="漂泊者，​注意​你​的​言辞。​",shape=box,color=blue];
		j2878608851 -> j2799561336;
	j3395387371 [label="Je ne suis pas naïve，你​不​必​这样​来​跟​我​说话​ ！",shape=box,color=blue];
		j3395387371 -> j3650775866;
	j1455446316 [label="也​许​他​只是​以​毒​攻毒，​而​这​种​残忍​是​必要​的。​",shape=box,color=blue];
		j1455446316 -> j236167127;
		j1455446316 -> j1392780902;
	j4171671900 [label="[坦白心意] 我很在乎你。比我表现出来的还要在乎。而且……我很抱歉我之前对你很苛刻，但我不能让他伤害你。毕竟他已经伤害了那么多人。",shape=box,color=red];
		j4171671900 -> j1907725786;
	j4113856505 [label="我亲眼目睹英择谛毁掉了所有他关心的人、所有他声称爱过的人。我不想看到他对你也这样做……",shape=box,color=red];
		j4113856505 -> j1944346341;
	j3230335339 [label="我不太擅长表达自己，对此我很抱歉。但是……我恐怕他是在利用你，利用你的善良来操控你。仅此而已。",shape=box,color=red];
		j3230335339 -> j3327673408;
	j3830830877 [label="你或许视英择谛为救世主，但我却视他为一个惊恐的老人，正苦苦寻找答案。或许答案就在两者之间。",shape=box,color=red];
		j3830830877 -> j2878608851;
	j4248249632 [label="Oui。看起来是这样。",shape=box,color=blue];
		j4248249632 -> j3051126039;
	j1238660470 [label="Boolean MarieEntratiMonster2 is now false.",color=orange];
		j1238660470 -> j2485882029;
	j2700101464 [label="Boolean MarieEntratiMonster2 is now false.",color=orange];
		j2700101464 -> j1533364808;
	j3443285823 [label="所以你欺骗我是为了博取我的好感……je vois。",shape=box,color=blue];
		j3443285823 -> j3025465622;
		j3443285823 -> j2856030789;
	j3358539780 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j3358539780 -> j1126076085;
	j206973647 [label="[坦白心意] 我很在乎你。比我表现出来的还要在乎。",shape=box,color=red];
		j206973647 -> j329094708;
	j3314407186 [label="我认为在这场战争中，任何手段都是必要的。毕竟，我们是在试图拯救宇宙，对抗虚空无情之物，不是吗？",shape=box,color=red];
		j3314407186 -> j3888693211;
	j16441185 [label="我相信英择谛。真的。我认为他有解决这个问题的计划，而且这一切最终都是为了大家好。",shape=box,color=red];
