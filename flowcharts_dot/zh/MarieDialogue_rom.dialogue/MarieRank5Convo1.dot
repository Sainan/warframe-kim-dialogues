		2429 -> 2435 [label="false",color=purple];
	2430 [label="我​一直​在​思考​你​对​主教​的​评价。​他​的​行为……既​有善，​也​有恶。​",shape=box,color=blue];
		2430 -> 2436;
	2431 [label="我​一直​在​思考​你​对​主教​的​评价。你说他的行为给里昂带来了痛苦。",shape=box,color=blue];
		2431 -> 2436;
	2432 [label="我一直在思考我们关于标弃先生的谈话，以及你对他为何如此憎恨主教那令人信服的论据。",shape=box,color=blue];
		2432 -> 2436;
	2433 [label="我一直在思考我和标弃先生的争论，以及他如此憎恨主教的原因。",shape=box,color=blue];
		2433 -> 2436;
	2434 [label="我一直在思考我和标弃先生的争吵，以及我们围绕那次争吵展开的争论。",shape=box,color=blue];
		2434 -> 2436;
	2435 [label="我觉得关于主教，还有很多话没说。其他人似乎在我面前小心翼翼，不敢提起他。",shape=box,color=blue];
		2435 -> 2436;
	2436 [label="我​知道​别人​会​把​他​描绘成​一​个​混蛋、​一​个​疯子、​一​个​叛徒。​但​在​我​看来，​他​不​是​那样​的​人。​",shape=box,color=blue];
		2436 -> 2437;
	2437 [label="Check boolean MarieBackstory1",color=orange];
		2437 -> 2439 [label=true,color=green];
		2437 -> 2438 [label=false,color=brown];
	2439 [label="或许是因为我已经习惯了被抛弃。",shape=box,color=blue];
		2439 -> 2440;
	2438 [label="我​小时候​就​被​家​人​抛弃，​流落​街头，​只​因……​不​正常。​身体残缺。​不​适合​上​流​社会。​",shape=box,color=blue];
		2438 -> 2440;
	2440 [label="也​许正​是​因为​我​从​来​没有​过​父亲，​所以​我​才​如此​愿意​原谅​他​的​缺席。​",shape=box,color=blue];
		2440 -> 2441;
	2441 [label="Evaluate expressions",color=orange];
		2441 -> 2442 [label="MarieEntrati4a",color=purple];
		2441 -> 2443 [label="MarieEntrati4b",color=purple];
		2441 -> 2444 [label="MarieEntrati3a",color=purple];
		2441 -> 2445 [label="MarieEntrati3b",color=purple];
		2441 -> 2446 [label="MarieEntrati3",color=purple];
		2441 -> 2447 [label="false",color=purple];
	2442 [label="但​事实​是，​我​确实​原谅​了​他。​因为​我​认为​他​的​善行​比​他​的​恶行​更​有​价值。​",shape=box,color=blue];
		2442 -> 2448;
		2442 -> 2449;
		2442 -> 2450;
		2442 -> 2451;
		2442 -> 2452;
	2443 [label="我祈祷里昂能够坚强地度过他所遭受的信仰危机，但我并不认为这完全是主教的错。",shape=box,color=blue];
		2443 -> 2448;
		2443 -> 2449;
		2443 -> 2450;
		2443 -> 2453;
		2443 -> 2454;
	2444 [label="你对标弃先生以及那些受他伤害的人提出的论点很令人信服，我也很理解……但我仍然认为他的善行比他的恶行更有价值。",shape=box,color=blue];
		2444 -> 2448;
		2444 -> 2449;
		2444 -> 2450;
		2444 -> 2455;
		2444 -> 2456;
	2445 [label="虽然我理解标弃先生的愤怒，也能体会他的观点，但他必须从内心深处找到原谅主教的理由。因为在我看来，主教的善行远比他的恶行更有价值。",shape=box,color=blue];
		2445 -> 2448;
		2445 -> 2449;
		2445 -> 2450;
		2445 -> 2457;
		2445 -> 2458;
	2446 [label="虽然我很理解大家与主教的过往，尤其是标弃先生，但我仍然更看重他的善行，而不是他的恶行。",shape=box,color=blue];
		2446 -> 2448;
		2446 -> 2449;
		2446 -> 2450;
		2446 -> 2459;
	2447 [label="虽然我很理解大家与主教的过往，但我仍然更看重他的善行，而不是他的恶行。",shape=box,color=blue];
		2447 -> 2448;
		2447 -> 2449;
		2447 -> 2450;
	2448 [label="我不会责怪你感激他给你的生活带来的益处，就像我不会责怪其他人怨恨他给他们的人生带来的伤害一样。",shape=box,color=red];
		2448 -> 2460;
	2449 [label="我​不​知道。​我​倒​觉得​他​的​行为​弊​大于利。​真希望​你​也​能​看清​这​一点。​",shape=box,color=red];
		2449 -> 2461;
	2450 [label="玛丽，我支持你。我不能责怪英择谛所做的一切。他是在对抗虚空无情之物。",shape=box,color=red];
		2450 -> 2462;
	2451 [label="你​原谅​英择谛​是​对​的。​我​希望​其他​人​也​能​像​你​一样。​",shape=box,color=red];
		2451 -> 2462;
	2452 [label="我​永远​不​会​因为​原谅​而​责怪​别人。​你​可以​原谅​别人，​但​同时​也​要​明白​你​必须​保护​自己​和​他​人​不​受​伤害。​",shape=box,color=red];
		2452 -> 2463;
	2453 [label="你认为里昂的遭遇是他咎由自取吗？",shape=box,color=red];
		2453 -> 2464;
	2454 [label="玛丽，里昂面临的远不止信仰危机。而这很大程度上与英择谛有关。",shape=box,color=red];
		2454 -> 2461;
	2455 [label="难道我说的话一点都没有让双方的立场有所缓和吗？",shape=box,color=red];
		2455 -> 2465;
	2456 [label="纵观英择谛所做的一切，你怎么还能认为利大于弊呢？",shape=box,color=red];
		2456 -> 2461;
	2457 [label="我认为你低估了科维兽和标弃所遭受的苦难。",shape=box,color=red];
		2457 -> 2461;
	2458 [label="宽恕固然重要，但承认英择谛比你想象的要复杂得多也同样重要。",shape=box,color=red];
		2458 -> 2465;
	2459 [label="我还是觉得你不明白标弃和科维兽经历了什么。他们比你经历的要糟糕得多。",shape=box,color=red];
		2459 -> 2461;
	2460 [label="但你明白这两者价值并不相等吗 ？怨恨和敬仰 ？我希望其他人能够放下他们的恶意仇恨。",shape=box,color=blue];
		2460 -> 2466;
		2460 -> 2467;
	2461 [label="Evaluate expressions",color=orange];
		2461 -> 2469 [label="MarieEntratiMonster1",color=purple];
		2461 -> 2469 [label="MarieEntratiMonster2",color=purple];
