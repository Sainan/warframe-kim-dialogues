		1789 -> 1795 [label="LyonRell1",color=purple];
		1789 -> 1796 [label="false",color=purple];
	1790 [label="这就是英择谛这类人的问题所在。他们并非单纯的“善”或“恶”，而是二者的混合体。",shape=box,color=red];
		1790 -> 1799;
	1791 [label="请别在这儿提主教的事，oui ？我只关心我的灵魂​兄弟。",shape=box,color=blue];
		1791 -> 1781;
	1792 [label="我也认为并非如此，但事实已经发生，oui ？不过我理解你的心意。Cela dit……",shape=box,color=blue];
		1792 -> 1791;
	3962 [label="Update boolean DrifterMarie",color=orange];
		3962 -> 3963;
	1793 [label="里昂正在努力接受虚空无情之物并不是真正的神这一事实。",shape=box,color=red];
		1793 -> 1800;
	1795 [label="我认为这并非由单一因素造成，而是被诸多因素所困。",shape=box,color=red];
		1795 -> 1802;
	1797 [label="里昂听到了一位 Tenno 的声音，一个叫 Rell 的孩子。Rell......死了。我觉得他没能很好地应对这一切。",shape=box,color=red];
		1797 -> 1804;
	1798 [label="罗瑟一直都在向他散播谎言，有关墙中人的谎言。",shape=box,color=red];
		1798 -> 1805;
	1794 [label="我猜英择谛曾低语告诉他，他信奉的神的声音其实是来自虚空的声音，这恐怕对他没什么帮助。",shape=box,color=red];
		1794 -> 1801;
	1796 [label="说实话，我不知道，不知道。",shape=box,color=red];
		1796 -> 1803;
	1799 [label="请别在这儿提主教的事，oui ？我只关心我的灵魂​兄弟。但……我知道你说的……正越来越成为不争的事实。",shape=box,color=blue];
		1799 -> 1806;
	3963 [label="别以为我没看到你干的好事，你偷偷先混进去的吧，狼。",shape=box,color=blue];
		3963 -> 1799;
	1800 [label="若你用这种方式与他交谈，在这些事上你可帮不上什么忙。即使你说的是真话，也必须小心表达方式。",shape=box,color=blue];
		1800 -> 1807;
	1802 [label="Oui，他曾是许多人风雨中的避难所……而如今，他自己却深陷风暴之中。",shape=box,color=blue];
		1802 -> 1809;
	1804 [label="我曾听他说过那个名字，Rell——想到那孩子的命运便令人心碎。",shape=box,color=blue];
		1804 -> 1811;
	1805 [label="那个恶魔在他漫长的一生中造成的苦难比任何人都多 ！但我认为这不是他一切纷争的唯一原因，不是吗 ？",shape=box,color=blue];
		1805 -> 1812;
	1801 [label="S'il te plaît，别再提主教了。我并不否认他的言论加剧了里昂的纷争，但那绝非唯一的原因。",shape=box,color=blue];
		1801 -> 1808;
	1803 [label="那么我想……我们能做的就是耐心等待，希望找到困扰他的原因。",shape=box,color=blue];
		1803 -> 1810;
	1806 [label="Update boolean MarieEntrati4a",color=orange];
		1806 -> 1781;
	1807 [label="手术不是用斧头完成的。这里又不是不列颠尼克海军。",shape=box,color=blue];
		1807 -> 1813;
	1809 [label="四面受敌，不知该往哪处前进……",shape=box,color=blue];
		1809 -> 1815;
		1809 -> 1816;
	1811 [label="但我认为这并非他内心冲突的唯一原因 ？里昂跟随着月神的道路。La mort est une compagne qui marche à ses côtés",shape=box,color=blue];
		1811 -> 1813;
	1812 [label="这加剧了他的迷茫……但他怎么如此轻信恶魔的三言两语 ？我的里昂绝不会如此轻率。我想，如今压垮他的，是诸多因素交织而成的重担。",shape=box,color=blue];
		1812 -> 1818;
		1812 -> 1819;
	1808 [label="Update boolean MarieEntrati4b",color=orange];
		1808 -> 1814;
	1810 [label="+15 Chemistry",color=orange];
		1810 -> 1817;
	1813 [label="不，我认为是许多事情如今都压在他身上。",shape=box,color=blue];
		1813 -> 1818;
		1813 -> 1819;
	1815 [label="那么，我们必须成为他的避风港。一个他确信不会伤害他的地方。",shape=box,color=red];
		1815 -> 1820;
	1816 [label="那么，我们需要为他指引回归安全的道路。成为黑暗中的明灯。",shape=box,color=red];
		1816 -> 1821;
	1818 [label="我想……我们需要为他指引回归安全的道路。成为黑暗中的明灯。",shape=box,color=red];
		1818 -> 1821;
	1819 [label="我想……那么，我们必须成为他的避风港。一个他确信不会伤害他的地方。",shape=box,color=red];
		1819 -> 1823;
	1814 [label="他并未将主教的话放在心上，以至于陷入如此黑暗的境地。我想是种种因素共同压垮了他。",shape=box,color=blue];
		1814 -> 1819;
		1814 -> 1818;
	1817 [label="Merci。 我知道你已经尽力了。为此，我深表感激。",shape=box,color=blue];
		1817 -> 1822;
	1820 [label="+10 Chemistry",color=orange];
		1820 -> 1824;
	1821 [label="如何帮助一个听不到你的呼唤、看不见你的光芒的人 ？Non，月神已将他笼罩在这片黑暗之中。",shape=box,color=blue];
		1821 -> 1825;
	1823 [label="+5 Chemistry",color=orange];
		1823 -> 1824;
	1822 [label="Chat ends.",color=orange];
	1824 [label="Oui，我想你是对的。当一切都让他失望时，我们必须成为他可以依靠的人。",shape=box,color=blue];
		1824 -> 1826;
	1825 [label="我认为即便是太阳神的光芒也无法穿透那层帷幕。",shape=box,color=blue];
		1825 -> 1826;
	1826 [label="当他的信仰摇摇欲坠时，我们必须成为他脚下坚实的土地。 ",shape=box,color=blue];
		1826 -> 1827;
	1827 [label="倘若所有无形的声响，都已从欢迎的幽灵，化作困扰他暗影中的恶魔——",shape=box,color=blue];
		1827 -> 1828;
	1828 [label="我们更该让自己变得真实，non ？",shape=box,color=blue];
		1828 -> 1829;
		1828 -> 1830;
