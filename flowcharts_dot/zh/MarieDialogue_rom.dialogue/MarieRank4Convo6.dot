		j2411453274 -> j557122002 [label="LyonRell1",color=purple];
		j2411453274 -> j483334740 [label="false",color=purple];
	j1013849325 [label="这就是英择谛这类人的问题所在。他们并非单纯的“善”或“恶”，而是二者的混合体。",shape=box,color=red];
		j1013849325 -> j4218546428;
	j3296168544 [label="请别在这儿提主教的事，oui ？我只关心我的灵魂​兄弟。",shape=box,color=blue];
		j3296168544 -> j1271617294;
	j3333270633 [label="我也认为并非如此，但事实已经发生，oui ？不过我理解你的心意。Cela dit……",shape=box,color=blue];
		j3333270633 -> j3296168544;
	j2955265672 [label="Boolean DrifterMarie is now true.",color=orange];
		j2955265672 -> j4092517837;
	j2178834068 [label="里昂正在努力接受虚空无情之物并不是真正的神这一事实。",shape=box,color=red];
		j2178834068 -> j4231738602;
	j557122002 [label="我认为这并非由单一因素造成，而是被诸多因素所困。",shape=box,color=red];
		j557122002 -> j3128048301;
	j812734468 [label="里昂听到了一位 Tenno 的声音，一个叫 Rell 的孩子。Rell......死了。我觉得他没能很好地应对这一切。",shape=box,color=red];
		j812734468 -> j330214878;
	j837033189 [label="罗瑟一直都在向他散播谎言，有关墙中人的谎言。",shape=box,color=red];
		j837033189 -> j2421835480;
	j1311685881 [label="我猜英择谛曾低语告诉他，他信奉的神的声音其实是来自虚空的声音，这恐怕对他没什么帮助。",shape=box,color=red];
		j1311685881 -> j1775054052;
	j483334740 [label="说实话，我不知道，不知道。",shape=box,color=red];
		j483334740 -> j3196459621;
	j4218546428 [label="请别在这儿提主教的事，oui ？我只关心我的灵魂​兄弟。但……我知道你说的……正越来越成为不争的事实。",shape=box,color=blue];
		j4218546428 -> j2347306047;
	j4092517837 [label="别以为我没看到你干的好事，你偷偷先混进去的吧，狼。",shape=box,color=blue];
		j4092517837 -> j4218546428;
	j4231738602 [label="若你用这种方式与他交谈，在这些事上你可帮不上什么忙。即使你说的是真话，也必须小心表达方式。",shape=box,color=blue];
		j4231738602 -> j3768232640;
	j3128048301 [label="Oui，他曾是许多人风雨中的避难所……而如今，他自己却深陷风暴之中。",shape=box,color=blue];
		j3128048301 -> j2844237558;
	j330214878 [label="我曾听他说过那个名字，Rell——想到那孩子的命运便令人心碎。",shape=box,color=blue];
		j330214878 -> j2287543874;
	j2421835480 [label="那个恶魔在他漫长的一生中造成的苦难比任何人都多 ！但我认为这不是他一切纷争的唯一原因，不是吗 ？",shape=box,color=blue];
		j2421835480 -> j1526087443;
	j1775054052 [label="S'il te plaît，别再提主教了。我并不否认他的言论加剧了里昂的纷争，但那绝非唯一的原因。",shape=box,color=blue];
		j1775054052 -> j4277532052;
	j3196459621 [label="那么我想……我们能做的就是耐心等待，希望找到困扰他的原因。",shape=box,color=blue];
		j3196459621 -> j4124305020;
	j2347306047 [label="Boolean MarieEntrati4a is now true.",color=orange];
		j2347306047 -> j1271617294;
	j3768232640 [label="手术不是用斧头完成的。这里又不是不列颠尼克海军。",shape=box,color=blue];
		j3768232640 -> j3535512644;
	j2844237558 [label="四面受敌，不知该往哪处前进……",shape=box,color=blue];
		j2844237558 -> j3394952340;
		j2844237558 -> j3944792184;
	j2287543874 [label="但我认为这并非他内心冲突的唯一原因 ？里昂跟随着月神的道路。La mort est une compagne qui marche à ses côtés。",shape=box,color=blue];
		j2287543874 -> j3535512644;
	j1526087443 [label="这加剧了他的迷茫……但他怎么如此轻信恶魔的三言两语 ？我的里昂绝不会如此轻率。我想，如今压垮他的，是诸多因素交织而成的重担。",shape=box,color=blue];
		j1526087443 -> j3765819151;
		j1526087443 -> j1025635175;
	j4277532052 [label="Boolean MarieEntrati4b is now true.",color=orange];
		j4277532052 -> j2715802086;
	j4124305020 [label="+15 Chemistry",color=orange];
		j4124305020 -> j3413562864;
	j3535512644 [label="不，我认为是许多事情如今都压在他身上。",shape=box,color=blue];
		j3535512644 -> j3765819151;
		j3535512644 -> j1025635175;
	j3394952340 [label="那么，我们必须成为他的避风港。一个他确信不会伤害他的地方。",shape=box,color=red];
		j3394952340 -> j2305606808;
	j3944792184 [label="那么，我们需要为他指引回归安全的道路。成为黑暗中的明灯。",shape=box,color=red];
		j3944792184 -> j3469653041;
	j3765819151 [label="我想……我们需要为他指引回归安全的道路。成为黑暗中的明灯。",shape=box,color=red];
		j3765819151 -> j3469653041;
	j1025635175 [label="我想……那么，我们必须成为他的避风港。一个他确信不会伤害他的地方。",shape=box,color=red];
		j1025635175 -> j1927768902;
	j2715802086 [label="他并未将主教的话放在心上，以至于陷入如此黑暗的境地。我想是种种因素共同压垮了他。",shape=box,color=blue];
		j2715802086 -> j1025635175;
		j2715802086 -> j3765819151;
