		j3413562864 -> "Chat ends.";
	j2305606808 [label="+10 Chemistry",color=orange];
		j2305606808 -> j722690412;
	j3469653041 [label="如何帮助一个听不到你的呼唤、看不见你的光芒的人 ？Non，月神已将他笼罩在这片黑暗之中。",shape=box,color=blue];
		j3469653041 -> j2861277005;
	j1927768902 [label="+5 Chemistry",color=orange];
		j1927768902 -> j722690412;
	j722690412 [label="Oui，我想你是对的。当一切都让他失望时，我们必须成为他可以依靠的人。",shape=box,color=blue];
		j722690412 -> j798600673;
	j2861277005 [label="我认为即便是太阳神的光芒也无法穿透那层帷幕。",shape=box,color=blue];
		j2861277005 -> j798600673;
