	j1091306009 [label="我不知道如何帮助他。",shape=box,color=red];
		j1091306009 -> j3663016813;
	j1262108910 [label="当你被困在这片自己创造的世界里，陷入无尽的死亡循环时，可曾有什么帮助你逃脱 ？",shape=box,color=blue];
		j1262108910 -> j3563549511;
		j1262108910 -> j693386143;
	j3101343819 [label="Oui，看着他受苦令人心痛......尤其此刻，我明白你已在心中为他留下了位置。",shape=box,color=blue];
		j3101343819 -> j3663016813;
	j3663016813 [label="预测他的边界所在实属不易。那些界限往往日复一日地变幻。",shape=box,color=blue];
		j3663016813 -> j2564022300;
	j3563549511 [label="如果我不愿接受帮助，他们的任何帮助都毫无价值。",shape=box,color=red];
		j3563549511 -> j1160399818;
		j3563549511 -> j3876832229;
	j693386143 [label="我得到过朋友们的帮助。",shape=box,color=red];
		j693386143 -> j1160399818;
		j693386143 -> j3876832229;
	j2564022300 [label="我曾目睹他承受诸神加诸肩头的苦痛。我懂得何时在他身旁保持沉默，何时化作那句谚语中的墙壁任他挥舞。",shape=box,color=blue];
		j2564022300 -> j136041721;
	j1160399818 [label="我不认为里昂想要我的帮助。",shape=box,color=red];
		j1160399818 -> j3007379909;
	j3876832229 [label="我正努力支持他，但他根本不听。",shape=box,color=red];
		j3876832229 -> j85214335;
	j136041721 [label="Mais ça ？这 ？这个地方，恶魔的言语，主教造成的不确定性......这一切都给他带来了痛苦，我祈祷他能从中恢复过来。",shape=box,color=blue];
		j136041721 -> j514756942;
		j136041721 -> j2112815871;
	j3007379909 [label="那么我想……除了耐心等待之外别无他法了，不是吗 ？",shape=box,color=blue];
		j3007379909 -> j1332450813;
	j85214335 [label="我自己也一样，这正是我前来与你商谈此事的原因。我向来都能安抚他——",shape=box,color=blue];
		j85214335 -> j1271617294;
	j514756942 [label="所以你承认英择谛伤害了里昂 ？你对此作何感想 ？",shape=box,color=red];
		j514756942 -> j3565449591;
	j2112815871 [label="我觉得他正站在悬崖边缘摇摇欲坠。我该如何拉他回来 ？",shape=box,color=red];
		j2112815871 -> j2962291795;
	j1332450813 [label="谢谢。很抱歉耽误了你的时间。",shape=box,color=blue];
		j1332450813 -> "Chat ends.";
	j1271617294 [label="面对他那股狂怒，他那份désespoir……他回避我的方式前所未有，令我措手不及。",shape=box,color=blue];
		j1271617294 -> j4114329636;
	j3565449591 [label="Pas bien……可我该如何在对哥哥的爱与对主教的崇拜之间抉择 ？我又该如何在家人之间做出选择 ？",shape=box,color=blue];
		j3565449591 -> j4152141904;
		j3565449591 -> j2639196444;
		j3565449591 -> j209467036;
		j3565449591 -> j1152005826;
	j2962291795 [label="我不知道，这正是我前来与你商谈此事的原因。我向来都能安抚他—— ",shape=box,color=blue];
		j2962291795 -> j1271617294;
	j4114329636 [label="是什么让他如此不安 ？你知道原因吗 ？",shape=box,color=blue];
		j4114329636 -> j2411453274;
	j4152141904 [label="你不必选择，玛丽。他人在我们生活中的存在方式本就是复杂的。",shape=box,color=red];
		j4152141904 -> j1013849325;
	j2639196444 [label="我会选择那个依然陪伴在身边的家人，而不是那个离开你的人。",shape=box,color=red];
		j2639196444 -> j3296168544;
	j209467036 [label="我确信英择谛并非有意让里昂承受这样的痛苦。",shape=box,color=red];
		j209467036 -> j3333270633;
	j1152005826 [label="你可以选择一个新的家庭。就像我一样。还有那些关心你的人，不加上英择谛。",shape=box,color=red];
		j1152005826 -> j2955265672;
	j2411453274 [label="Evaluate expressions",color=orange];
