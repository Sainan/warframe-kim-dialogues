		1765 -> 1769;
	1766 [label="当你被困在这片自己创造的世界里，陷入无尽的死亡循环时，可曾有什么帮助你逃脱 ？",shape=box,color=blue];
		1766 -> 1770;
		1766 -> 1771;
	1767 [label="Oui，看着他受苦令人心痛......尤其此刻，我明白你已在心中为他留下了位置。",shape=box,color=blue];
		1767 -> 1769;
	1768 [label="Chat ends.",color=orange];
	1769 [label="预测他的边界所在实属不易。那些界限往往日复一日地变幻。",shape=box,color=blue];
		1769 -> 1772;
	1770 [label="如果我不愿接受帮助，他们的任何帮助都毫无价值。",shape=box,color=red];
		1770 -> 1773;
		1770 -> 1774;
	1771 [label="我得到过朋友们的帮助。",shape=box,color=red];
		1771 -> 1773;
		1771 -> 1774;
	1772 [label="我曾目睹他承受诸神加诸肩头的苦痛。我懂得何时在他身旁保持沉默，何时化作那句谚语中的墙壁任他挥舞。",shape=box,color=blue];
		1772 -> 1775;
	1773 [label="我不认为里昂想要我的帮助。",shape=box,color=red];
		1773 -> 1776;
	1774 [label="我正努力支持他，但他根本不听。",shape=box,color=red];
		1774 -> 1777;
	1775 [label="Mais ça ？这 ？这个地方，恶魔的言语，主教造成的不确定性......这一切都给他带来了痛苦，我祈祷他能从中恢复过来。",shape=box,color=blue];
		1775 -> 1778;
		1775 -> 1779;
	1776 [label="那么我想……除了耐心等待之外别无他法了，不是吗 ？",shape=box,color=blue];
		1776 -> 1780;
	1777 [label="我自己也一样，这正是我前来与你商谈此事的原因。我向来都能安抚他——",shape=box,color=blue];
		1777 -> 1781;
	1778 [label="所以你承认英择谛伤害了里昂 ？你对此作何感想 ？",shape=box,color=red];
		1778 -> 1782;
	1779 [label="我觉得他正站在悬崖边缘摇摇欲坠。我该如何拉他回来 ？",shape=box,color=red];
		1779 -> 1783;
	1780 [label="谢谢。很抱歉耽误了你的时间。",shape=box,color=blue];
		1780 -> 1784;
	1781 [label="面对他那股狂怒，他那份désespoir……他回避我的方式前所未有，令我措手不及。",shape=box,color=blue];
		1781 -> 1785;
	1782 [label="Pas bien……可我该如何在对哥哥的爱与对主教的崇拜之间抉择 ？我又该如何在家人之间做出选择 ？",shape=box,color=blue];
		1782 -> 1786;
		1782 -> 1787;
		1782 -> 1788;
		1782 -> 3961;
	1783 [label="我不知道，这正是我前来与你商谈此事的原因。我向来都能安抚他—— ",shape=box,color=blue];
		1783 -> 1781;
	1784 [label="Chat ends.",color=orange];
	1785 [label="是什么让他如此不安 ？你知道原因吗 ？",shape=box,color=blue];
		1785 -> 1789;
	1786 [label="你不必选择，玛丽。他人在我们生活中的存在方式本就是复杂的。",shape=box,color=red];
		1786 -> 1790;
	1787 [label="我会选择那个依然陪伴在身边的家人，而不是那个离开你的人。",shape=box,color=red];
		1787 -> 1791;
	1788 [label="我确信英择谛并非有意让里昂承受这样的痛苦。",shape=box,color=red];
		1788 -> 1792;
	3961 [label="你可以选择一个新的家庭。就像我一样。还有那些关心你的人，不加上英择谛。",shape=box,color=red];
		3961 -> 3962;
	1789 [label="Evaluate expressions",color=orange];
		1789 -> 1793 [label="DrifterFaithNoMITW",color=purple];
