	j1668304031 [label="他是个成年人。他自己可以决定何时愿意开口。",shape=box,color=red];
		j1668304031 -> j1262108910;
	j2686595201 [label="看到他承受如此痛苦，我的心都碎了。我不知道该如何帮助他。",shape=box,color=red];
