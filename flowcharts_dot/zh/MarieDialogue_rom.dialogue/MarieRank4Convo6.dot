	1831 [label="+10 Chemistry",color=orange];
		1831 -> 1833;
	1832 [label="+5 Chemistry",color=orange];
		1832 -> 1834;
	1833 [label="到头来，这就是我们所能做的全部了。",shape=box,color=blue];
		1833 -> 1835;
	1834 [label="Oui……我也一样。但我们能做的，只是站在他身边祈祷，non ？",shape=box,color=blue];
		1834 -> 1836;
	1835 [label="尝试。祈祷。",shape=box,color=blue];
		1835 -> 1837;
	1836 [label="只盼为时不晚。",shape=box,color=blue];
		1836 -> 1837;
	1837 [label="Merci……我必须走了。若这次谈话未能提供多少帮助，还请见谅。当我无法行动时，内心便充满焦虑。",shape=box,color=blue];
		1837 -> 1838;
