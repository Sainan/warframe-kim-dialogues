	j425869254 [label="哈 ！现在才说这些可太迟了。玛丽，au travail ！Il y a de l'amour dans l'air ！",shape=box,color=blue];
		j425869254 -> "Chat ends.";
	j1565345085 [label="Oui ！即使你想阻止我也做不到。玛丽，快去干活 ！",shape=box,color=blue];
		j1565345085 -> "Chat ends.";
	j2473113609 [label="Oui，当然。À bientôt。",shape=box,color=blue];
		j2473113609 -> "Chat ends.";
	j1519331103 [label="Oui，当然。",shape=box,color=blue];
		j1519331103 -> j2671566173;
	j739409664 [label="你知道我的故事是如何开始的，但我还有一部分没告诉你。",shape=box,color=blue];
		j739409664 -> j569876874;
	j1740252827 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j1740252827 -> j3372060290;
	j833816209 [label="这虽然会伤害他自己，但终究是他的一部分。如果你带着 colère 靠近他，如果你态度粗暴，他便会畏缩着躲开你的触碰。",shape=box,color=blue];
		j833816209 -> j3163067507;
	j569876874 [label="我告诉过你，当我还是个 jeune fille 时，曾流落街头乞讨为生。我也说过后来我过得不错，还结交了许多朋友。",shape=box,color=blue];
		j569876874 -> j1088139958;
	j3372060290 [label="我出生在一个富裕的家庭，这可能会让你感到意外。资产阶级，离奥罗金挺近的那种。",shape=box,color=blue];
		j3372060290 -> j2627246067;
	j3163067507 [label="你必须赢得流浪动物的信任。让他主动靠近你，non ？这样说的通吧 ？",shape=box,color=blue];
		j3163067507 -> j2109486991;
		j3163067507 -> j1537532203;
		j3163067507 -> j1759810822;
	j1088139958 [label="其中有一个叫雨果的大男孩。",shape=box,color=blue];
		j1088139958 -> j1300719253;
	j2627246067 [label="然而我一出生就是个……畸形的孩子，mes pieds tordus et inutilisables ？哦，ma mère 无法接受。",shape=box,color=blue];
		j2627246067 -> j322171810;
	j2109486991 [label="是的，确实如此。谢谢。",shape=box,color=red];
		j2109486991 -> j2139100202;
	j1537532203 [label="出乎意料的说得通，谢谢。",shape=box,color=red];
		j1537532203 -> j214295294;
	j1759810822 [label="不太行。不过谢了。",shape=box,color=red];
		j1759810822 -> j1998920077;
	j1300719253 [label="他是这群孩子中的领头羊。他总会确保没人欺负我，也保证我所需的一切都得到满足。",shape=box,color=blue];
		j1300719253 -> j1718304970;
	j322171810 [label="毕竟要维护家族的体面与规矩，oui ？",shape=box,color=blue];
		j322171810 -> j3151332618;
	j2139100202 [label="Bien ！我怕我又让比喻跑偏了。",shape=box,color=blue];
		j2139100202 -> j4039902437;
	j214295294 [label="玛丽和她的比喻。啊，bon。",shape=box,color=blue];
		j214295294 -> j4039902437;
	j1998920077 [label="Mince alors。我就知道我又让我的比喻跑偏了。",shape=box,color=blue];
		j1998920077 -> j4039902437;
	j1718304970 [label="他甚至帮我用捡来的木头搭了副 des béquilles——你们管它叫……呃……拐杖吧 ？让我能拄着它拖着身子走动。",shape=box,color=blue];
		j1718304970 -> j2853088938;
	j3151332618 [label="那么，那个可怜的畸形玛丽该怎么处置呢 ？我被带到了 la Cité de la Lumière，我本该会死在那里……",shape=box,color=blue];
		j3151332618 -> j353672789;
	j4039902437 [label="嗯。我忽然想到，或许把里昂比作流浪狗并不是最得体的比喻……",shape=box,color=blue];
		j4039902437 -> j975924575;
	j2853088938 [label="有天早上，我们去叫醒他，却发现他——",shape=box,color=blue];
		j2853088938 -> j1290531716;
	j353672789 [label="并任其自生自灭。",shape=box,color=blue];
		j353672789 -> j2872534703;
		j353672789 -> j1032099461;
	j975924575 [label="或许不必告诉他我这么形容，oui…… ?",shape=box,color=blue];
		j975924575 -> j1672678032;
	j1290531716 [label="Je……细节我就不多说了……我想你肯定能猜得到。",shape=box,color=blue];
		j1290531716 -> j1944969885;
	j2872534703 [label="你当时多大 ？",shape=box,color=red];
		j2872534703 -> j940100077;
	j1032099461 [label="你的家人就这么放任你去死 ？",shape=box,color=red];
		j1032099461 -> j4080598434;
	j1672678032 [label="Boolean LyonStrayDog is now true.",color=orange];
		j1672678032 -> j3272868026;
		j1672678032 -> j3213786629;
	j1944969885 [label="但他留了张纸条。字迹模糊得几乎辨认不清。他是其他孩子中唯一识字的，所以我不得不把它读给其他人听。 ",shape=box,color=blue];
		j1944969885 -> j888104361;
	j940100077 [label="六岁 ？七岁 ？在他们眼里，这些年他们已竭尽全力地帮助我了。请来导师教我行走，配戴支架，更换特殊鞋具。",shape=box,color=blue];
		j940100077 -> j2731931909;
	j4080598434 [label="在他们眼里，这些年他们已竭尽全力地帮助我了。请来导师教我行走，配戴支架，更换特殊鞋具。",shape=box,color=blue];
		j4080598434 -> j2731931909;
	j3272868026 [label="我觉得这么说很可爱，他也会这么想。",shape=box,color=red];
		j3272868026 -> j758510050;
	j3213786629 [label="我会守住秘密的。",shape=box,color=red];
		j3213786629 -> j4266371083;
	j888104361 [label="我至今仍记得自己哽咽的声音。但我必须保持坚强。因为即使在那时，我也明白自己对其他人负有责任。 ",shape=box,color=blue];
		j888104361 -> j1089777273;
	j2731931909 [label="他们厌倦了这种负担。于是，在我连数字和字母都不太会读写的时候，我被丢进了泥地里。",shape=box,color=blue];
		j2731931909 -> j451816794;
		j2731931909 -> j3430659988;
	j758510050 [label="Quelle horrible personne ! J'espère que votre chaise va s'effondrer et vous donner plein d'échardes douloureuses !",shape=box,color=blue];
		j758510050 -> "Chat ends.";
	j4266371083 [label="Merci ！真是松了一口气……",shape=box,color=blue];
		j4266371083 -> "Chat ends.";
	j1089777273 [label="他们对我说，雨果看起来总是那么快乐。Si joyeux。永远用笑声和冷嘲热讽面对生活。",shape=box,color=blue];
		j1089777273 -> j4082216656;
	j451816794 [label="这太可怕了。",shape=box,color=red];
		j451816794 -> j714426695;
	j3430659988 [label="你是怎么活下来的 ？",shape=box,color=red];
		j3430659988 -> j714426695;
	j4082216656 [label="即便我们遭人驱赶，或是他因偷窃或游手好闲挨棍打，他似乎都无所谓。",shape=box,color=blue];
		j4082216656 -> j1298668456;
	j714426695 [label="Check boolean MarieSecretPower",color=orange];
		j714426695 -> j3086129760 [label=true,color=green];
		j714426695 -> j2491258161 [label=false,color=brown];
	j1298668456 [label="但我们永远无法知晓他人内心的伤痛有多深。而从那封信里，我明白他曾与月神一同流泪。",shape=box,color=blue];
		j1298668456 -> j2829059204;
	j3086129760 [label="就像你说的，non ？不便之处都蕴藏着一种隐秘力量。",shape=box,color=blue];
		j3086129760 -> j2491258161;
	j2491258161 [label="我在 pour ma mère 眼里是 indésirable，但我在街头孩子眼里却很受欢迎。",shape=box,color=blue];
		j2491258161 -> j4207775489;
	j2829059204 [label="但他此刻已安息在她身旁。有一段时间，我怨恨他的离去。因为其他人都在向我寻求指引。而我怨恨他抛弃了我。",shape=box,color=blue];
		j2829059204 -> j4211882509;
	j4207775489 [label="还有什么比一个没有脚的孩子更 pathétique 呢，oui ？我一天伸手乞讨赚的钱，比他们一周抢劫的还多。",shape=box,color=blue];
		j4207775489 -> j354416288;
	j4211882509 [label="但随着时间的推移，我逐渐明白了其中的道理。",shape=box,color=blue];
		j4211882509 -> j278827422;
	j354416288 [label="我向来乐于分享，因此结交了许多朋友，他们总会照顾我、保护我。其中有一个叫雨果的大男孩。",shape=box,color=blue];
		j354416288 -> j1300719253;
	j278827422 [label="我们只能原谅自己身为凡人的软弱，原谅自己承受他们离去带来的痛苦。",shape=box,color=blue];
		j278827422 -> j3640726344;
	j3640726344 [label="他们的缺席令我们心痛。更痛的是，我们无力为他们多做些什么。",shape=box,color=blue];
		j3640726344 -> j693396287;
	j693396287 [label="他人背负的重担，我们永远无从知晓。",shape=box,color=blue];
		j693396287 -> j3686320987;
	j3686320987 [label="这真是一场巨大的 tragédie。但这正是身为凡人要经历的。",shape=box,color=blue];
		j3686320987 -> j28679005;
	j28679005 [label="不知道这个故事是否对你有所帮助。但我只能祈祷它确实如此。我得走了，洛德先生在叫我。",shape=box,color=blue];
		j28679005 -> j999819613;
		j28679005 -> j951032988;
	j999819613 [label="谢谢你，玛丽。",shape=box,color=red];
		j999819613 -> j2243815720;
