	2095 [label="或许不必告诉他我这么形容，oui…… ?",shape=box,color=blue];
		2095 -> 2099;
	2096 [label="Je……细节我就不多说了……我想你肯定能猜得到。",shape=box,color=blue];
		2096 -> 2100;
	2097 [label="你当时多大 ？",shape=box,color=red];
		2097 -> 2101;
	2098 [label="你的家人就这么放任你去死 ？",shape=box,color=red];
		2098 -> 2102;
	2099 [label="Update boolean LyonStrayDog",color=orange];
		2099 -> 2103;
		2099 -> 2104;
	2100 [label="但他留了张纸条。字迹模糊得几乎辨认不清。他是其他孩子中唯一识字的，所以我不得不把它读给其他人听。 ",shape=box,color=blue];
		2100 -> 2105;
	2101 [label="六岁 ？七岁 ？在他们眼里，这些年他们已竭尽全力地帮助我了。请来导师教我行走，配戴支架，更换特殊鞋具。",shape=box,color=blue];
		2101 -> 2106;
	2102 [label="在他们眼里，这些年他们已竭尽全力地帮助我了。请来导师教我行走，配戴支架，更换特殊鞋具。",shape=box,color=blue];
		2102 -> 2106;
	2103 [label="我觉得这么说很可爱，他也会这么想。",shape=box,color=red];
		2103 -> 2107;
	2104 [label="我会守住秘密的。",shape=box,color=red];
		2104 -> 2108;
	2105 [label="我至今仍记得自己哽咽的声音。但我必须保持坚强。因为即使在那时，我也明白自己对其他人负有责任。 ",shape=box,color=blue];
		2105 -> 2109;
	2106 [label="他们厌倦了这种负担。于是，在我连数字和字母都不太会读写的时候，我被丢进了泥地里。",shape=box,color=blue];
		2106 -> 2110;
		2106 -> 2111;
	2107 [label="Quelle horrible personne ! J'espère que votre chaise va s'effondrer et vous donner plein d'échardes douloureuses !",shape=box,color=blue];
		2107 -> 2112;
	2108 [label="Merci ！真是松了一口气……",shape=box,color=blue];
		2108 -> 2113;
	2109 [label="他们对我说，雨果看起来总是那么快乐。Si joyeux。永远用笑声和冷嘲热讽面对生活。",shape=box,color=blue];
		2109 -> 2114;
	2110 [label="这太可怕了。",shape=box,color=red];
		2110 -> 2115;
	2111 [label="你是怎么活下来的 ？",shape=box,color=red];
		2111 -> 2115;
	2112 [label="Chat ends.",color=orange];
	2113 [label="Chat ends.",color=orange];
	2114 [label="即便我们遭人驱赶，或是他因偷窃或游手好闲挨棍打，他似乎都无所谓。",shape=box,color=blue];
		2114 -> 2116;
	2115 [label="Check boolean MarieSecretPower",color=orange];
		2115 -> 2117 [label=true,color=green];
		2115 -> 2118 [label=false,color=brown];
	2116 [label="但我们永远无法知晓他人内心的伤痛有多深。而从那封信里，我明白他曾与月神一同流泪。",shape=box,color=blue];
		2116 -> 2119;
	2117 [label="就像你说的，non ？不便之处都蕴藏着一种隐秘力量。",shape=box,color=blue];
		2117 -> 2118;
	2118 [label="我在 pour ma mère 眼里是 indésirable，但我在街头孩子眼里却很受欢迎。",shape=box,color=blue];
		2118 -> 2120;
	2119 [label="但他此刻已安息在她身旁。有一段时间，我怨恨他的离去。因为其他人都在向我寻求指引。而我怨恨他抛弃了我。",shape=box,color=blue];
		2119 -> 2121;
	2120 [label="还有什么比一个没有脚的孩子更 pathétique 呢，oui ？我一天伸手乞讨赚的钱，比他们一周抢劫的还多。",shape=box,color=blue];
		2120 -> 2122;
	2121 [label="但随着时间的推移，我逐渐明白了其中的道理。",shape=box,color=blue];
		2121 -> 2123;
	2122 [label="我向来乐于分享，因此结交了许多朋友，他们总会照顾我、保护我。其中有一个叫雨果的大男孩。",shape=box,color=blue];
		2122 -> 2085;
	2123 [label="我们只能原谅自己身为凡人的软弱，原谅自己承受他们离去带来的痛苦。",shape=box,color=blue];
		2123 -> 2124;
	2124 [label="他们的缺席令我们心痛。更痛的是，我们无力为他们多做些什么。",shape=box,color=blue];
		2124 -> 2125;
	2125 [label="他人背负的重担，我们永远无从知晓。",shape=box,color=blue];
		2125 -> 2126;
	2126 [label="这真是一场巨大的 tragédie。但这正是身为凡人要经历的。",shape=box,color=blue];
		2126 -> 2127;
	2127 [label="不知道这个故事是否对你有所帮助。但我只能祈祷它确实如此。我得走了，洛德先生在叫我。",shape=box,color=blue];
		2127 -> 2128;
		2127 -> 2129;
	2128 [label="谢谢你，玛丽。",shape=box,color=red];
		2128 -> 2130;
	2129 [label="[保持沉默]",shape=box,color=red];
		2129 -> 2131;
	2130 [label="+20 Chemistry",color=orange];
		2130 -> 2132;
	2131 [label="+20 Chemistry",color=orange];
		2131 -> 2133;
	2132 [label="不客气。À bientôt。",shape=box,color=blue];
		2132 -> 2134;
	2133 [label="À la revoyure。",shape=box,color=blue];
		2133 -> 2135;
	2134 [label="Chat ends.",color=orange];
