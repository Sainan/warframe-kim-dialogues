		j3387399653 -> j2551486445;
	j2789788248 [label="啊，就像对着大理石雕像说话，non ？我懂你的感受。我常发现自己讲了二十分钟故事，才意识到他根本没在听。",shape=box,color=blue];
		j2789788248 -> j3309261214;
	j2328545377 [label="你必须学会读懂弦外之音，non ？他的语言是故事。是 paraboles。如果他沉默，就聆听他的行动。",shape=box,color=blue];
		j2328545377 -> j1624099518;
	j1866846680 [label="我……请让我避开这个话题吧。我做不到。 ",shape=box,color=red];
		j1866846680 -> j101708466;
