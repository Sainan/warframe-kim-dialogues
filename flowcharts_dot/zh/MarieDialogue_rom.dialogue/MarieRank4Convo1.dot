	j2725558027 [label="我发现，在他需要我时陪伴在他身边……倾听他，当他哭泣时仅仅坐在他身旁 ？",shape=box,color=blue];
		j2725558027 -> j2899896016;
	j789915809 [label="真的吗 ？我不知道你会怎么想。",shape=box,color=red];
