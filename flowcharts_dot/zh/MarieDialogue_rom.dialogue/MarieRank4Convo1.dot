	j394549806 [label="[禁用所有关于自残的对话。你不会因此损失与任何角色的好感度点数。]",shape=box,color=red];
		j394549806 -> j1339141718;
	j3580654760 [label="说实话，我真不知道自己更希望他的这些幻象是真实的还是虚假的。",shape=box,color=red];
		j3580654760 -> j3180904829;
	j3486721121 [label="谈论他目睹的所有可怕之事。那些描述……",shape=box,color=red];
		j3486721121 -> j3180904829;
	j2392614956 [label="他总有一天可能会让自己陷入万劫不复的地步 ？",shape=box,color=red];
		j2392614956 -> j253633798;
	j3328317141 [label="你在他身边的时候会不会感到不安全 ？担心他会不经意地伤害你 ？",shape=box,color=red];
		j3328317141 -> j935468791;
	j1339141718 [label="Boolean LyonPainOff is now true.",color=orange];
		j1339141718 -> j1702251208;
	j3180904829 [label="+5 Chemistry",color=orange];
		j3180904829 -> j3479826175;
	j253633798 [label="啊……这真是个令人难堪的话题，oui ？抱歉，我实在不知该如何开口，不至于让自己陷入窘境。",shape=box,color=blue];
		j253633798 -> j2181817208;
	j935468791 [label="我相信里昂宁可自尽也绝不会伤害我。我对众神与恶魔都怀有绝对信心——",shape=box,color=blue];
		j935468791 -> j772801941;
	j1702251208 [label="+20 Chemistry",color=orange];
		j1702251208 -> j3850875123;
	j3479826175 [label="你指的是充斥他脑海的噩梦——月神正引领他踏上艰难之路，oui ？",shape=box,color=blue];
		j3479826175 -> j891331114;
	j2181817208 [label="但我会尽力而为。我想你这么问是出于对他关心的缘故吧 ？",shape=box,color=blue];
		j2181817208 -> j3907036359;
		j2181817208 -> j2458847384;
	j772801941 [label="——就连你的虚空无情之物也无法诱使他对我施加暴力。",shape=box,color=blue];
		j772801941 -> j591911784;
	j3850875123 [label="[该选项将绕过所有涉及自残的对话。]",shape=box,color=blue];
		j3850875123 -> "Chat ends.";
	j891331114 [label="我怕这实在难以启齿。因为我知道这本不该发生，oui ？",shape=box,color=blue];
		j891331114 -> j2481587040;
	j3907036359 [label="他被注射的战甲血清……呃……",shape=box,color=red];
		j3907036359 -> j1338751767;
		j3907036359 -> j3433518482;
		j3907036359 -> j1227332284;
	j2458847384 [label="看他那副样子就很明显了……没冒犯的意思。猜出来并不难。",shape=box,color=red];
		j2458847384 -> j1338751767;
		j2458847384 -> j3433518482;
		j2458847384 -> j1227332284;
	j591911784 [label="我也许会害怕一只蝴蝶会将我吞噬殆尽，而不是害怕我灵魂的兄弟。",shape=box,color=blue];
		j591911784 -> j891331114;
	j2481587040 [label="我真想阻止他。保护他远离这种自残的念头。",shape=box,color=blue];
		j2481587040 -> j4060566350;
	j1338751767 [label="我只是担心他哪天可能会做得太过分。",shape=box,color=red];
		j1338751767 -> j891331114;
	j3433518482 [label="我们需要他完好无损。",shape=box,color=red];
		j3433518482 -> j3718387848;
	j1227332284 [label="我可不想费心去收拾他的尸体。",shape=box,color=red];
		j1227332284 -> j3960103821;
	j4060566350 [label="如果说我对里昂有哪点深信不疑，那就是他永远会在需要时挺身而出。",shape=box,color=blue];
		j4060566350 -> j1573426832;
	j3718387848 [label="你竟然重复着恶魔的话。难道你只是冷酷无情地需要得力的帮手吗 ？",shape=box,color=blue];
		j3718387848 -> j686328154;
		j3718387848 -> j544297628;
	j3960103821 [label="Dégoûtant。",shape=box,color=blue];
		j3960103821 -> j1508231473;
	j1573426832 [label="他是伟大的守护者，le bouclier sacré de Lua……是黑夜中闪耀的光芒。",shape=box,color=blue];
		j1573426832 -> j1043807766;
	j686328154 [label="不，我很在意他。只是担心当我们需要他时，他不会出现。",shape=box,color=red];
		j686328154 -> j4060566350;
	j544297628 [label="我只想知道他是否值得信赖，还是他早已伤痕累累。",shape=box,color=red];
		j544297628 -> j2570475847;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j1043807766 [label="他施加给自身的痛苦……只是为了聆听自己的思绪。感受自己的身体。 ",shape=box,color=blue];
		j1043807766 -> j1729448846;
	j2570475847 [label="我倒要看看，当你身受重创、需要援手之时，究竟谁会来帮助你。",shape=box,color=blue];
		j2570475847 -> j519027005;
	j1729448846 [label="天空布满繁星，每颗星星都在向他低语，而他，如同月神一样，会在星海中迷失。",shape=box,color=blue];
		j1729448846 -> j1498405444;
	j519027005 [label="还是你认为那段时光早已过去，现在你已凌驾于这样的非议之上 ？",shape=box,color=blue];
		j519027005 -> j3960103821;
	j1498405444 [label="如同月神一样，他经历了自身的蜕变。他被虚空吞噬，却最终绽放出耀眼光芒，使我们得以在黑暗中无惧前行。",shape=box,color=blue];
		j1498405444 -> j1793670972;
	j1793670972 [label="但就像所有的祝福一样，它也伴随着诅咒。我说的有道理吗 ？恐怕我只是在胡言乱语。",shape=box,color=blue];
		j1793670972 -> j3074470070;
		j1793670972 -> j2926304452;
		j1793670972 -> j4230083801;
		j1793670972 -> j1946691934;
		j1793670972 -> j12168747;
	j3074470070 [label="我完全理解。而且我……有件事要坦白。[表露对里昂的心意]",shape=box,color=red];
		j3074470070 -> j3535616384;
	j2926304452 [label="我明白你的意思，但我不能纵容他伤害自己。他应该停止这样做。",shape=box,color=red];
		j2926304452 -> j1113195861;
	j4230083801 [label="[警告：涉及自杀话题] 我曾失去过一个人，正是死于这种自残行为。我无法……我无法容忍这种行为。",shape=box,color=red];
		j4230083801 -> j652133070;
	j1946691934 [label="他的情况一定还有别的办法。",shape=box,color=red];
		j1946691934 -> j2998323447;
	j12168747 [label="你说得完全有道理。我只是……真希望我能帮到他。",shape=box,color=red];
		j12168747 -> j2998323447;
	j3535616384 [label="Boolean DrifterLyon is now true.",color=orange];
		j3535616384 -> j391161600;
	j1113195861 [label="Boolean DrifterHarmStop is now true.",color=orange];
		j1113195861 -> j2795427123;
	j652133070 [label="Boolean DrifterHarmLoss is now true.",color=orange];
		j652133070 -> j2687939373;
	j2998323447 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j2998323447 -> j329970946;
	j391161600 [label="恐怕他……已经俘获了我的心，而得知他身陷痛苦，我的心都碎了。",shape=box,color=red];
		j391161600 -> j1526761655;
	j2795427123 [label="他承受的痛苦远比他施加在肉体的伤痛更深。此刻他对自身的所作所为，也无法帮他逃离困境。",shape=box,color=blue];
		j2795427123 -> j950632889;
	j2687939373 [label="哦 ！我不知道，我非常非常抱歉……此刻我能献上的那些陈词滥调与祈祷，想必都显得空洞无物——",shape=box,color=blue];
		j2687939373 -> j3623582386;
	j329970946 [label="+20 Chemistry",color=orange];
		j329970946 -> j2608085240;
	j1526761655 [label="+20 Chemistry",color=orange];
		j1526761655 -> j1619030054;
	j950632889 [label="它澄清他的思绪，安定他的灵魂。而今，作为原型战甲——一部分是……Harrow，就像我是 Wisp 的一部分，它不会杀死他，oui ？ ",shape=box,color=blue];
		j950632889 -> j2745602663;
		j950632889 -> j2500992924;
	j3623582386 [label="——毕竟面对如此悲剧，一个素不相识之人所能表达的哀悼，又怎能成为抚慰心灵的良药 ？",shape=box,color=blue];
		j3623582386 -> j570992250;
	j2608085240 [label="为此，我不能再崇拜你了。但帮助的形式可以是多种多样的，non ？",shape=box,color=blue];
		j2608085240 -> j402835861;
	j1619030054 [label="噢 ！！我刚才像看见老鼠一样尖叫起来，把洛德先生吓了一跳 ！请原谅 ！！",shape=box,color=blue];
		j1619030054 -> j7513478;
	j2745602663 [label="不，这不会要了他的命。但这样做还是不对。",shape=box,color=red];
		j2745602663 -> j2564664901;
	j2500992924 [label="我大概明白你的意思。",shape=box,color=red];
		j2500992924 -> j4008481694;
	j570992250 [label="你所说的那个失去的灵魂……你们很亲近吗 ？",shape=box,color=blue];
		j570992250 -> j660792252;
		j570992250 -> j4111313477;
	j402835861 [label="救助幼鸟可能反而害了它。助燃烛火可能因过犹不及而吹灭它。",shape=box,color=blue];
		j402835861 -> j2725558027;
	j7513478 [label="噢，但这真是个好消息 ！",shape=box,color=blue];
		j7513478 -> j789915809;
		j7513478 -> j1519577417;
	j2564664901 [label="我发现，在他需要我时陪伴在他身边……倾听他，在他哭泣时拥抱他 ？",shape=box,color=blue];
		j2564664901 -> j3898306885;
	j4008481694 [label="+10 Chemistry",color=orange];
