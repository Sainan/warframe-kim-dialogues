	j1541709704 [label="狼 ！我的狼 ！我见到奥塔了 ！我终于见到他了 ！",shape=box,color=blue];
		j1541709704 -> j2179184649;
		j1541709704 -> j1477796655;
	j1499906163 [label="我见到奥塔了 ！我终于见到他了 ！",shape=box,color=blue];
		j1499906163 -> j2179184649;
		j1499906163 -> j1477796655;
	j2224564034 [label="狼 ！我的狼 ！殁世械灵先生背上的那张脸 ！我终于见到他了 ！",shape=box,color=blue];
		j2224564034 -> j2264063054;
		j2224564034 -> j3250925796;
		j2224564034 -> j504958262;
	j2300686480 [label="殁世械灵先生背上的那张脸 ！我终于见到他了 ！",shape=box,color=blue];
		j2300686480 -> j2264063054;
		j2300686480 -> j3250925796;
		j2300686480 -> j504958262;
	j2179184649 [label="你喜欢和他聊天吗？",shape=box,color=red];
		j2179184649 -> j3179415331;
	j1477796655 [label="你们聊得怎么样？",shape=box,color=red];
		j1477796655 -> j2033908277;
	j2264063054 [label="可怜的奥塔……结果怎么样？",shape=box,color=red];
		j2264063054 -> j2606080955;
	j3250925796 [label="很高兴你们终于见面了。奥塔的情况可能有点难解释。",shape=box,color=red];
		j3250925796 -> j720737959;
	j504958262 [label="你见到奥塔了？我的天……你们见面怎么样？",shape=box,color=red];
		j504958262 -> j3069914766;
	j3179415331 [label="喜欢。不过我当时有点想哭。因为在同一个对话中，他……向我介绍了三次，仿佛我们从未互相认识过一样。",shape=box,color=blue];
		j3179415331 -> j4078733005;
	j2033908277 [label="在同一个对话中，他……向我介绍了三次，仿佛我们从未互相认识过一样。",shape=box,color=blue];
		j2033908277 -> j4078733005;
	j2606080955 [label="我觉得他非常可爱迷人！但在这层幽默之下，我却感到无比心痛。",shape=box,color=blue];
		j2606080955 -> j1329124872;
	j720737959 [label="是的，我也这么觉得。一个潦草的孩子笔迹写在机器的背面。我觉得他真是可爱又迷人 ！",shape=box,color=blue];
		j720737959 -> j2929622760;
	j3069914766 [label="为什么听上去你并不怎么高兴我见到他 ？",shape=box,color=blue];
		j3069914766 -> j2121961200;
		j3069914766 -> j1028242424;
		j3069914766 -> j775857009;
	j4078733005 [label="他​像​之前​一样，​毫​不​犹豫、​兴高​采烈​地​迎接​我。​不过​他​居然​认出​我​是​一​位​ S​œur de Sol ！​",shape=box,color=blue];
		j4078733005 -> j4220146339;
	j1329124872 [label="你能告诉我那个可怜的奥塔先生的故事吗？",shape=box,color=blue];
		j1329124872 -> j356950814;
	j2929622760 [label="但幽默之下，却隐藏着巨大的伤痛。",shape=box,color=blue];
		j2929622760 -> j1329124872;
	j2121961200 [label="他有时候还挺烦人的，仅此而已。 ",shape=box,color=red];
		j2121961200 -> j1186817558;
	j1028242424 [label="我不是那个意思。他只是可能有点……让人难以接受。",shape=box,color=red];
		j1028242424 -> j2828908934;
	j775857009 [label="我很抱歉。他有时候确实挺让人恼火的。这不是他的错。",shape=box,color=red];
		j775857009 -> j2828908934;
	j4220146339 [label="实际上，他对双耀神了解颇多 ！我们聊了很多，聊了那些他称之为“奥罗金帝国之前”的“古代宗教”。",shape=box,color=blue];
		j4220146339 -> j2945209384;
	j356950814 [label="奥塔曾是一位哲士、奥罗金科学家和学者。关于他的经历，实在算不上一个幸福的故事。",shape=box,color=red];
		j356950814 -> j4200891753;
	j1186817558 [label="我希望你能对这位明显体弱多病的人更加友善。Mais par la grâce de 太阳神，指引我们所有人。",shape=box,color=blue];
		j1186817558 -> j3165745878;
	j2828908934 [label="我希望大家能对他保持友善和耐心。 Mais par la grâce de 太阳神，指引我们所有人。",shape=box,color=blue];
		j2828908934 -> j3165745878;
	j2945209384 [label="虽然他说很多这类知识现在都已遗失，深埋在档案馆里，而且是绝对禁止查阅的。他让我发誓保密。",shape=box,color=blue];
		j2945209384 -> j4282282766;
	j4200891753 [label="众所周知，他是一位天才，也是驾驭氩结晶的幕后推手。",shape=box,color=red];
		j4200891753 -> j3301242372;
	j3165745878 [label="这样的命运可能发生在任何人身上，包括你。",shape=box,color=blue];
		j3165745878 -> j462123908;
		j3165745878 -> j714614685;
	j4282282766 [label="他告诉我，他非常担心执行者 Ballas（虽然我不知道他是谁）可能会发现我的异端教派，并处决我。",shape=box,color=blue];
		j4282282766 -> j1777049177;
		j4282282766 -> j3890651907;
	j3301242372 [label="这些力量源自虚空——正是它们让我们能够制造出众多强大的战甲与武器。",shape=box,color=red];
		j3301242372 -> j1835906579;
	j462123908 [label="你​说​得​对，​对​不起，​我​不​是​故意​的。​",shape=box,color=red];
		j462123908 -> j1329124872;
	j714614685 [label="我很抱歉，我实在没有多余的时间花在他身上。",shape=box,color=red];
		j714614685 -> j530205863;
	j1777049177 [label="Ballas 早​就​死​了​……​继续​说。​",shape=box,color=red];
		j1777049177 -> j635793225;
	j3890651907 [label="那……是不会发生的。继续说。",shape=box,color=red];
		j3890651907 -> j635793225;
	j1835906579 [label="他专攻晶体学。他的研究成果都保存在这里的实验室里。",shape=box,color=red];
		j1835906579 -> j3378234210;
	j530205863 [label="那我真抱歉我浪费了更多。",shape=box,color=blue];
		j530205863 -> j3007723528;
	j635793225 [label="+5 Chemistry",color=orange];
		j635793225 -> j1820589964;
	j3378234210 [label="后来不知道是什么原因，他被改造成了一个中枢，并获得了自己的殁世械灵外壳。",shape=box,color=red];
		j3378234210 -> j666408403;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j1820589964 [label="我当时也是这么想的……嗯，他问我来自哪里，当我告诉他之后，他笑了，说“不，这不可能！我应该知道，因为我——”",shape=box,color=blue];
		j1820589964 -> j431523533;
	j666408403 [label="不是所有中枢都是因刑罚而被造的。但当时火卫二这边的情况……变得很糟糕，他受了重伤。",shape=box,color=red];
		j666408403 -> j1492782021;
	j431523533 [label="然后他……又向我做了自我介绍，并问我是不是带着矿物样本从平野过来……",shape=box,color=blue];
		j431523533 -> j2876918426;
		j431523533 -> j3565871337;
	j1492782021 [label="Pauvre petit……",shape=box,color=blue];
		j1492782021 -> j253530729;
	j2876918426 [label="没错……奥塔就是这样。",shape=box,color=red];
		j2876918426 -> j2786832664;
	j3565871337 [label="哦，玛丽。我真抱歉……",shape=box,color=red];
		j3565871337 -> j2786832664;
	j253530729 [label="Boolean MarieOtak1 is now true.",color=orange];
		j253530729 -> j2179184649;
		j253530729 -> j1477796655;
	j2786832664 [label="想到对他无能为力，我的心都要碎了。",shape=box,color=blue];
		j2786832664 -> j457335464;
	j457335464 [label="Evaluate expressions",color=orange];
		j457335464 -> j2301411974 [label="MarieCephalonSoul",color=purple];
		j457335464 -> j3793762514 [label="MarieCephalonNoSoul",color=purple];
		j457335464 -> j3286281678 [label="MarieCephalonUnsure",color=purple];
		j457335464 -> j2618028167 [label="false",color=purple];
	j2301411974 [label="哦，双耀神——你们为他创造了何等的地狱，将他的灵魂囚禁在科学和闪烁光芒的牢笼之中 ？",shape=box,color=blue];
		j2301411974 -> j1552117406;
	j3793762514 [label="我只能向双耀神祈祷，愿你是对的，愿那外壳里剩下的只有……只有科学和闪烁的光。",shape=box,color=blue];
		j3793762514 -> j382340956;
	j3286281678 [label="我知道你不确定中枢是否有灵魂——但我只能向双耀神祈祷……愿可怜的奥塔不要受苦。",shape=box,color=blue];
		j3286281678 -> j1124075906;
	j2618028167 [label="我只能向双耀神祈祷，愿那外壳里剩下的只有……只有科学和闪烁的光。",shape=box,color=blue];
		j2618028167 -> j237775851;
	j1552117406 [label="为什么要把他留在那里，让他痛苦地等待死亡，直到他死去才能获得安宁？我只能祈祷……如果那里真的有某种存在——",shape=box,color=blue];
		j1552117406 -> j2089871445;
	j382340956 [label="并且没有灵魂被困在那破碎的躯壳里，只有等待着最终死去才能获得安宁。",shape=box,color=blue];
		j382340956 -> j1729745893;
	j1124075906 [label="愿没有灵魂被困在那破碎的躯壳里，只有等待着最终死去才能获得安宁。",shape=box,color=blue];
		j1124075906 -> j1961308988;
	j237775851 [label="并且没有灵魂被困在那破碎的躯壳里，只有等待着最终死去才能获得安宁。",shape=box,color=blue];
		j237775851 -> j1961308988;
	j2089871445 [label="愿那是因为他自己选择留下来，作为一个孤独的守夜人……",shape=box,color=blue];
		j2089871445 -> j2154099862;
	j1729745893 [label="因为如果你错了呢，那个灵魂是被迫被困在那个牢笼里呢？",shape=box,color=blue];
		j1729745893 -> j1500698050;
	j1961308988 [label="或者，如果那里真的有他的存在，愿那是因为他选择留下来，以某种孤独的方式守望。",shape=box,color=blue];
		j1961308988 -> j2154099862;
	j2154099862 [label="否则，人便不免要质疑众神是否真的仁慈，non ？",shape=box,color=blue];
		j2154099862 -> j1833572379;
	j1500698050 [label="那就足以让人质疑众神的仁慈，non ？",shape=box,color=blue];
		j1500698050 -> j1833572379;
	j1833572379 [label="那我又该置身何处呢？",shape=box,color=blue];
		j1833572379 -> j3146527363;
	j3146527363 [label="请原谅，我……我今天心情很低落。 ",shape=box,color=blue];
		j3146527363 -> j3251038745;
