	3555 [label="+5 Chemistry",color=orange];
		3555 -> 3558;
	3556 [label="Merci。嗯，我不想再这样了。我要去做些更快乐的事情 ！我觉得斐波那契先生的鱼缸该除尘了。",shape=box,color=blue];
