		3530 -> 3534 [label="false",color=purple];
	3531 [label="哦，双耀神——你们为他创造了何等的地狱，将他的灵魂囚禁在科学和闪烁光芒的牢笼之中 ？",shape=box,color=blue];
		3531 -> 3535;
	3532 [label="我只能向双耀神祈祷，愿你是对的，愿那外壳里剩下的只有……只有科学和闪烁的光。",shape=box,color=blue];
		3532 -> 3536;
	3533 [label="我知道你不确定中枢是否有灵魂——但我只能向双耀神祈祷……愿可怜的奥塔不要受苦。",shape=box,color=blue];
		3533 -> 3537;
	3534 [label="我只能向双耀神祈祷，愿那外壳里剩下的只有……只有科学和闪烁的光。",shape=box,color=blue];
		3534 -> 3538;
	3535 [label="为什么要把他留在那里，让他痛苦地等待死亡，直到他死去才能获得安宁？我只能祈祷……如果那里真的有某种存在——",shape=box,color=blue];
		3535 -> 3539;
	3536 [label="并且没有灵魂被困在那破碎的躯壳里，只有等待着最终死去才能获得安宁。",shape=box,color=blue];
		3536 -> 3540;
	3537 [label="愿没有灵魂被困在那破碎的躯壳里，只有等待着最终死去才能获得安宁。",shape=box,color=blue];
		3537 -> 3541;
	3538 [label="并且没有灵魂被困在那破碎的躯壳里，只有等待着最终死去才能获得安宁。",shape=box,color=blue];
		3538 -> 3541;
	3539 [label="愿那是因为他自己选择留下来，作为一个孤独的守夜人……",shape=box,color=blue];
		3539 -> 3542;
	3540 [label="因为如果你错了呢，那个灵魂是被迫被困在那个牢笼里呢？",shape=box,color=blue];
		3540 -> 3543;
	3541 [label="或者，如果那里真的有他的存在，愿那是因为他选择留下来，以某种孤独的方式守望。",shape=box,color=blue];
		3541 -> 3544;
	3542 [label="否则，人便不免要质疑众神是否真的仁慈，non ？",shape=box,color=blue];
