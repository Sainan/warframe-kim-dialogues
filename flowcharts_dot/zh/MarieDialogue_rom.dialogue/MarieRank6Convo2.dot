		3485 -> 3491;
	3486 [label="殁世械灵先生背上的那张脸 ！我终于见到他了 ！",shape=box,color=blue];
		3486 -> 3489;
		3486 -> 3490;
		3486 -> 3491;
	3487 [label="你喜欢和他聊天吗？",shape=box,color=red];
		3487 -> 3492;
	3488 [label="你们聊得怎么样？",shape=box,color=red];
		3488 -> 3493;
	3489 [label="可怜的奥塔……结果怎么样？",shape=box,color=red];
		3489 -> 3494;
	3490 [label="很高兴你们终于见面了。奥塔的情况可能有点难解释。",shape=box,color=red];
		3490 -> 3495;
	3491 [label="你见到奥塔了？我的天……你们见面怎么样？",shape=box,color=red];
		3491 -> 3496;
	3492 [label="喜欢。不过我当时有点想哭。因为在同一个对话中，他……向我介绍了三次，仿佛我们从未互相认识过一样。",shape=box,color=blue];
		3492 -> 3497;
	3493 [label="在同一个对话中，他……向我介绍了三次，仿佛我们从未互相认识过一样。",shape=box,color=blue];
		3493 -> 3497;
	3494 [label="我觉得他非常可爱迷人！但在这层幽默之下，我却感到无比心痛。",shape=box,color=blue];
		3494 -> 3498;
	3495 [label="是的，我也这么觉得。一个潦草的孩子笔迹写在机器的背面。我觉得他真是可爱又迷人 ！",shape=box,color=blue];
		3495 -> 3499;
	3496 [label="为什么听上去你并不怎么高兴我见到他 ？",shape=box,color=blue];
		3496 -> 3500;
		3496 -> 3501;
		3496 -> 3502;
	3497 [label="他​像​之前​一样，​毫​不​犹豫、​兴高​采烈​地​迎接​我。​不过​他​居然​认出​我​是​一​位​ S​œur de Sol ！​",shape=box,color=blue];
		3497 -> 3503;
	3498 [label="你能告诉我那个可怜的奥塔先生的故事吗？",shape=box,color=blue];
		3498 -> 3504;
	3499 [label="但幽默之下，却隐藏着巨大的伤痛。",shape=box,color=blue];
		3499 -> 3498;
	3500 [label="他有时候还挺烦人的，仅此而已。 ",shape=box,color=red];
		3500 -> 3505;
	3501 [label="我不是那个意思。他只是可能有点……让人难以接受。",shape=box,color=red];
		3501 -> 3506;
	3502 [label="我很抱歉。他有时候确实挺让人恼火的。这不是他的错。",shape=box,color=red];
		3502 -> 3506;
	3503 [label="实际上，他对双耀神了解颇多 ！我们聊了很多，聊了那些他称之为“奥罗金帝国之前”的“古代宗教”。",shape=box,color=blue];
		3503 -> 3507;
	3504 [label="奥塔曾是一位哲士、奥罗金科学家和学者。关于他的经历，实在算不上一个幸福的故事。",shape=box,color=red];
		3504 -> 3508;
	3505 [label="我希望你能对这位明显体弱多病的人更加友善。Mais par la grâce de 太阳神，指引我们所有人。",shape=box,color=blue];
		3505 -> 3509;
	3506 [label="我希望大家能对他保持友善和耐心。 Mais par la grâce de 太阳神，指引我们所有人。",shape=box,color=blue];
		3506 -> 3509;
	3507 [label="虽然他说很多这类知识现在都已遗失，深埋在档案馆里，而且是绝对禁止查阅的。他让我发誓保密。",shape=box,color=blue];
		3507 -> 3510;
	3508 [label="众所周知，他是一位天才，也是驾驭氩结晶的幕后推手。",shape=box,color=red];
		3508 -> 3511;
	3509 [label="这样的命运可能发生在任何人身上，包括你。",shape=box,color=blue];
		3509 -> 3512;
		3509 -> 3513;
	3510 [label="他告诉我，他非常担心执行者 Ballas（虽然我不知道他是谁）可能会发现我的异端教派，并处决我。",shape=box,color=blue];
		3510 -> 3514;
		3510 -> 3515;
	3511 [label="这些力量源自虚空——正是它们让我们能够制造出众多强大的战甲与武器。",shape=box,color=red];
		3511 -> 3516;
	3512 [label="你​说​得​对，​对​不起，​我​不​是​故意​的。​",shape=box,color=red];
		3512 -> 3498;
	3513 [label="我很抱歉，我实在没有多余的时间花在他身上。",shape=box,color=red];
		3513 -> 3517;
	3514 [label="Ballas 早​就​死​了​……​继续​说。​",shape=box,color=red];
		3514 -> 3518;
	3515 [label="那……是不会发生的。继续说。",shape=box,color=red];
		3515 -> 3518;
	3516 [label="他专攻晶体学。他的研究成果都保存在这里的实验室里。",shape=box,color=red];
		3516 -> 3519;
	3517 [label="那我真抱歉我浪费了更多。",shape=box,color=blue];
		3517 -> 3520;
	3518 [label="+5 Chemistry",color=orange];
		3518 -> 3521;
	3519 [label="后来不知道是什么原因，他被改造成了一个中枢，并获得了自己的殁世械灵外壳。",shape=box,color=red];
		3519 -> 3522;
	3520 [label="Update boolean MarieOtakComplete",color=orange];
		3520 -> 3523;
	3521 [label="我当时也是这么想的……嗯，他问我来自哪里，当我告诉他之后，他笑了，说“不，这不可能！我应该知道，因为我——”",shape=box,color=blue];
		3521 -> 3524;
	3522 [label="不是所有中枢都是因刑罚而被造的。但当时火卫二这边的情况……变得很糟糕，他受了重伤。",shape=box,color=red];
		3522 -> 3525;
	3523 [label="Chat ends.",color=orange];
	3524 [label="然后他……又向我做了自我介绍，并问我是不是带着矿物样本从平野过来……",shape=box,color=blue];
		3524 -> 3526;
		3524 -> 3527;
