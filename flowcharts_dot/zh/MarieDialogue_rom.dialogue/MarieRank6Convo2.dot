		j3251038745 -> j2530206210 [label="false",color=purple];
		j3251038745 -> j1643333713 [label="false",color=purple];
	j2726800268 [label="没关系，你有充分的理由感到难过。",shape=box,color=red];
		j2726800268 -> j1811364540;
	j2530206210 [label="我​能​做些​什么​让​你​开心​起来​呢？​我们​要​不​要​去​捉​弄罗瑟。​",shape=box,color=red];
		j2530206210 -> j2552706994;
	j817277228 [label="我能做些什么让你开心起来呢？比如偷些糕点？",shape=box,color=red];
		j817277228 -> j1686936682;
	j1643333713 [label="玛丽，​有时候​神​就​是​很​残酷。​这​就​是​人生。​",shape=box,color=red];
		j1643333713 -> j4083866532;
	j1811364540 [label="+20 Chemistry",color=orange];
		j1811364540 -> j2470267089;
	j2552706994 [label="+15 Chemistry",color=orange];
		j2552706994 -> j573529795;
	j1686936682 [label="+20 Chemistry",color=orange];
		j1686936682 -> j573529795;
	j4083866532 [label="+5 Chemistry",color=orange];
		j4083866532 -> j19138245;
	j2470267089 [label="Merci。嗯，我不想再这样了。我要去做些更快乐的事情 ！我觉得斐波那契先生的鱼缸该除尘了。",shape=box,color=blue];
		j2470267089 -> j2486340526;
	j573529795 [label="哈 ！Merci。这下我肯定能止住这些傻眼泪了。你真会哄傻乎乎的小玛丽开心，Non ？",shape=box,color=blue];
		j573529795 -> j772798158;
		j573529795 -> j3197954309;
	j19138245 [label="Oui，你说得对。确实如此。像奥塔先生这样的故事比比皆是，世上还有许多比他更悲惨的故事。我不该只为一个故事哭泣。 ",shape=box,color=blue];
		j19138245 -> j807393625;
	j2486340526 [label="Check boolean MarieDating",color=orange];
		j2486340526 -> j1618107538 [label=true,color=green];
		j2486340526 -> j2411020663 [label=false,color=brown];
	j772798158 [label="这是至少是我能为你做的事。",shape=box,color=red];
		j772798158 -> j1350233930;
	j3197954309 [label="你一点也不傻。我也有同感。",shape=box,color=red];
		j3197954309 -> j1350233930;
	j807393625 [label="然而，我却坐在这里，做着这种事情。谢谢你提醒我有多愚蠢。呸！傻女孩玛丽。嗯……我想斐波那契先生的鱼缸该除尘了。",shape=box,color=blue];
		j807393625 -> j2486340526;
	j1618107538 [label="我的狼，À la revoyure。",shape=box,color=blue];
		j1618107538 -> j3007723528;
	j2411020663 [label="À la revoyure ！",shape=box,color=blue];
		j2411020663 -> j3007723528;
