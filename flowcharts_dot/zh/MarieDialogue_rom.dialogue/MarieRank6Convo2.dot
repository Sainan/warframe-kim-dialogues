		3548 -> 3552;
	3549 [label="我​能​做些​什么​让​你​开心​起来​呢？​我们​要​不​要​去​捉​弄罗瑟。​",shape=box,color=red];
		3549 -> 3553;
	3550 [label="我能做些什么让你开心起来呢？比如偷些糕点？",shape=box,color=red];
		3550 -> 3554;
	3551 [label="玛丽，​有时候​神​就​是​很​残酷。​这​就​是​人生。​",shape=box,color=red];
