		j1591510439 -> j166346039 [label="DrifterFaithSol",color=purple];
		j1591510439 -> j1441375885 [label="DrifterFaithLua",color=purple];
		j1591510439 -> j3280113145 [label="DrifterFaithBalance",color=purple];
		j1591510439 -> j987640233 [label="false",color=purple];
	j1267154960 [label="我只听说过感染者，对此知之甚少……但我相信你。如果我的感觉是真的，而且我也祈祷它是真的，我不认为她被困住了。",shape=box,color=blue];
		j1267154960 -> j3810524797;
	j2065668432 [label="你这么说真是太贴心了。如果我的感觉是真的，而且我也祈祷它是真的，那么 oui，你说得对。他们留下来是为了帮助我们。我不认为她被困住了。",shape=box,color=blue];
		j2065668432 -> j3810524797;
	j756881162 [label="如果我的感觉是真的，而且我也祈祷它是真的，那么 non，我不认为她被困住了。",shape=box,color=blue];
		j756881162 -> j3810524797;
	j3510088536 [label="如果我的感觉是真的，而且我也祈祷它是真的，那么 oui，你说得对。他们留下来是为了帮助我们。我不认为她被困住了。",shape=box,color=blue];
		j3510088536 -> j3810524797;
	j2915707766 [label="Oui，我蒙受了主教的祝福……但我知道或许我是唯一爱他的人，因为我的爱没有被悲伤、仇恨或怨恨所玷污。",shape=box,color=blue];
		j2915707766 -> j3420792063;
	j1242607952 [label="我知道你觉得他是个可怕的怪物。但我必须问，是什么原因让你如此不信任他？",shape=box,color=blue];
		j1242607952 -> j3919968124;
		j1242607952 -> j1218815221;
		j1242607952 -> j792849047;
	j3328563692 [label="我以为你相信他 ？怎么突然改变想法了 ？你这么善变吗 ？ ",shape=box,color=blue];
		j3328563692 -> j2342286302;
		j3328563692 -> j3448980140;
	j4055884185 [label="你为什么这么不信任他？",shape=box,color=blue];
		j4055884185 -> j3919968124;
		j4055884185 -> j792849047;
		j4055884185 -> j1218815221;
	j178517678 [label="是的，你这就改口了吗 ？你在撒谎。我不知道你撒谎的目的是什么。 Et je ne veux pas le savoir。",shape=box,color=blue];
		j178517678 -> j1508231473;
	j3630802108 [label="+5 Chemistry",color=orange];
		j3630802108 -> j3752869127;
	j412733022 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j412733022 -> j3752869127;
	j166346039 [label="对于我们这些追随太阳神之道的人来说，我们必须成为引路的光，永远照亮那些在十字路口迷失的人，non ？ ",shape=box,color=blue];
		j166346039 -> j2561143228;
	j1441375885 [label="你是月神的追随者，你应该知道我们教导有些人必须独自在阴影中行走，oui ？",shape=box,color=blue];
		j1441375885 -> j2561143228;
	j3280113145 [label="你是双耀神的追随者，你应该知道我们教导有些人独自走在未知的道路上，oui ？",shape=box,color=blue];
		j3280113145 -> j2561143228;
	j987640233 [label="我相信，我们知道那些走在人生道路上的人，终会发现自己处在月神和太阳神相遇的十字路口。 ",shape=box,color=blue];
		j987640233 -> j2561143228;
	j3810524797 [label="从她那里，我只感受到太阳神笑容的温暖。我想，主教的选择是明智的。我很荣幸能将她融入我的血液。",shape=box,color=blue];
		j3810524797 -> j2928948506;
		j3810524797 -> j1367849025;
		j3810524797 -> j1928690267;
		j3810524797 -> j656157286;
	j3420792063 [label="我原谅他离开我们。我想没人能做到这一点……",shape=box,color=blue];
		j3420792063 -> j749624480;
		j3420792063 -> j2946720850;
		j3420792063 -> j3919968124;
		j3420792063 -> j792849047;
	j3919968124 [label="他​……​有​来​过​双衍​王境。​很​久​以前……",shape=box,color=red];
		j3919968124 -> j605423674;
	j1218815221 [label="嗯，首先，他朝我的胸前开了一枪，然后把我丢在那里等死。",shape=box,color=red];
		j1218815221 -> j1746938568;
	j792849047 [label="他所留下的只有痛苦、死亡和遗弃。",shape=box,color=red];
		j792849047 -> j1591510439;
	j2342286302 [label="我从来没有信任过他，我只是不想吓跑你。",shape=box,color=red];
		j2342286302 -> j435895236;
	j3448980140 [label="我刚才不是故意撒谎，只是不知道该怎么开口。很显然你崇拜他……",shape=box,color=red];
		j3448980140 -> j1153794016;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j3752869127 [label="是的，我们一定要坚强 ！Braves contre les ténèbres，pour toujours et à jamais ！",shape=box,color=blue];
		j3752869127 -> j1286012332;
	j2561143228 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j2561143228 -> j262866212;
	j749624480 [label="你说得对，他伤害过很多人，也抛弃过很多人。我觉得他认为自己是不得已的这么做的。",shape=box,color=red];
		j749624480 -> j834233555;
	j2946720850 [label="当一个对你如此重要、你深爱、依赖的人离去，这真的很难受。尤其是当你不知道原因，或者他们再也不会回来的时候。",shape=box,color=red];
		j2946720850 -> j1091507451;
	j605423674 [label="太阳神​啊​ ！​是​那个​你​创造​的、​从​他​女儿写​的​书中​召唤​而​来​的​世界，​ou​i ？​洛德​先生​提到​过……​主教​居然​在​那 ？​为什么​ ？​",shape=box,color=blue];
		j605423674 -> j3384949274;
		j605423674 -> j168762165;
		j605423674 -> j4235210484;
	j1746938568 [label="Et pourtant，vous êtes toujours en vie ？你不是还活着吗？而且活得还好的？活得很幸福，如果洛德先生对你过去的未来冒险经历的讲述是可信的话。",shape=box,color=blue];
		j1746938568 -> j4231093281;
	j435895236 [label="啊，je vois ！Je suis une idiote, c'est ça ？！Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même ？！Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer ！",shape=box,color=blue];
		j435895236 -> j3119520729;
	j1153794016 [label="啊，oui……是我让你难以说出实话了，n'est-ce pas ？",shape=box,color=blue];
		j1153794016 -> j266005673;
	j1286012332 [label="我已经原谅他离开我们。我想没人能做到这一点……",shape=box,color=blue];
		j1286012332 -> j749624480;
		j1286012332 -> j2946720850;
	j262866212 [label="主教​一定​会​找到​回到​我们​身边​的​路。​我们​只​能​在​他​召唤​我们​的​时候​尽力​帮助​他，​并​按照​那些​像​他​一样​蒙福​的​人​的​吩咐​去行。​",shape=box,color=blue];
		j262866212 -> j989297039;
	j834233555 [label="+5 Chemistry",color=orange];
		j834233555 -> j2263435416;
	j1091507451 [label="+5 Chemistry",color=orange];
		j1091507451 -> j1457811830;
	j3384949274 [label="我想，一开始，他内心深处总在追寻他留下的女儿。但他最终找到了一种对抗虚空无情之物的方法——用他试图疏远的情感。",shape=box,color=red];
		j3384949274 -> j3998613332;
	j168762165 [label="他的笔记讲了一个非常令人讨厌的自吹自擂的故事，讲述了他如何去研究概念成形，却最终变成研究对抗虚空无情之物的价值。",shape=box,color=red];
		j168762165 -> j1879853757;
	j4235210484 [label="如果他的笔记属实，他去那里是为了教会双衍王境——以及我——如何抵抗虚空无情之物。可到头来一点用也没有。",shape=box,color=red];
		j4235210484 -> j37171757;
	j4231093281 [label="Check boolean IsDating",color=orange];
		j4231093281 -> j579605279 [label=true,color=green];
		j4231093281 -> j1900026487 [label=false,color=brown];
	j3119520729 [label="Va t'asseoir sur une ruche。",shape=box,color=blue];
		j3119520729 -> j1508231473;
	j266005673 [label="那现在就告诉我实话吧，狼。你为什么认为他不值得信任 ？我会尽量控制自己的脾气。",shape=box,color=blue];
		j266005673 -> j2946720850;
		j266005673 -> j3919968124;
