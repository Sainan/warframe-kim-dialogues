		j989297039 -> j2637783154 [label="false",color=purple];
	j2263435416 [label="Oui，你说得对。我觉得他做的一切都让他愧疚不已。我觉得他是故意疏远别人的。",shape=box,color=blue];
		j2263435416 -> j61863822;
	j1457811830 [label="是的，这真是令人悲伤心痛不已。知道有人……还活着，却似乎选择不在你身边 ？",shape=box,color=blue];
		j1457811830 -> j61863822;
	j3998613332 [label="Mon cœur se brise dans la tragédie——我认为我无法承受那种悲伤……她还是没有原谅他吗 ？",shape=box,color=blue];
		j3998613332 -> j1073738317;
		j3998613332 -> j3358736623;
	j1879853757 [label="你知道他为什么离开吗 ？",shape=box,color=blue];
		j1879853757 -> j1073738317;
		j1879853757 -> j1489804048;
	j37171757 [label="这是什么意思 ？",shape=box,color=blue];
		j37171757 -> j1936787251;
		j37171757 -> j1840317193;
	j579605279 [label="事实上，如果科维兽中的传言属实，vous y avez vraiment trouvé beaucoup de joie，non ？",shape=box,color=blue];
		j579605279 -> j1900026487;
	j1900026487 [label="Non，主教对其他人所做的要糟糕得多，你只是因为给自己带来了不便而感到不安。",shape=box,color=blue];
		j1900026487 -> j1591510439;
	j471036847 [label="我只是希望……我们可以让英择谛周围的每个人都不再为所发生的事情自责和互相指责。",shape=box,color=red];
		j471036847 -> j2711406271;
	j2024907195 [label="我不觉得他是蒙福​的​人​。",shape=box,color=red];
		j2024907195 -> j2976297424;
	j1407739433 [label="如果我能理解英择谛的所作所为，也许宽恕就没那么难了。",shape=box,color=red];
		j1407739433 -> j1975385344;
	j2637783154 [label="我​会​按照​他​的​要求​去​做，​解决​这个​问题。​然后，​等​一切​都​尘埃​落定，​我​再​评判​他。​",shape=box,color=red];
		j2637783154 -> j2349279963;
	j61863822 [label="Il inflige la douleur dans le cœur des autres, car la douleur vaut mieux que rien du tout。因为痛苦总比空虚好，non ？",shape=box,color=blue];
		j61863822 -> j1649583217;
	j1073738317 [label="当​他​不​为​自己​解释​时，​恐怕​我们​所​能​做​的​就​是​自己​编​造理由。​",shape=box,color=red];
		j1073738317 -> j3011841748;
	j3358736623 [label="你没抓住重点。他把我留在那里了。看到有人被遗弃在虚空中，然后他就把我留在那里了。",shape=box,color=red];
		j3358736623 -> j1268305758;
	j1489804048 [label="不。我只知道他把我留在那里了。看到有人被遗弃在虚空中，然后他就把我……留在那里了。",shape=box,color=red];
		j1489804048 -> j3011841748;
	j1936787251 [label="他把我留在那里了。在我不知道的时候，他来过——看到有人被遗弃在虚空中，然后……就把我留在那里了。",shape=box,color=red];
		j1936787251 -> j1268305758;
	j1840317193 [label="不管怎样，虚空无情之物最终还是来到了双衍王境。（虽然也带来了意想不到的帮助。但这无关紧要。）",shape=box,color=red];
		j1840317193 -> j2049606644;
	j2711406271 [label="Boolean MarieEntratiFamily is now true.",color=orange];
		j2711406271 -> j400101242;
	j2976297424 [label="那或许我们就先各有各的想法吧。",shape=box,color=blue];
		j2976297424 -> j2046866174;
	j1975385344 [label="我祈祷终有一日我们都能理解。也祈祷最终我们都能活下来见证这一切。但现在，我看着身边的家人，祈求他们能在心中寻得宽恕。为了他们自己的幸福。",shape=box,color=blue];
		j1975385344 -> j1991724318;
	j2349279963 [label="+10 Chemistry",color=orange];
		j2349279963 -> j2459248188;
	j1649583217 [label="这是我最亲爱的里昂收到的最深刻教训……我很高兴他现在和你说话。不过，今天我们谈论的是主教。",shape=box,color=blue];
		j1649583217 -> j221931327;
	j3011841748 [label="我只能推测这发生在……无限谋杀之前。",shape=box,color=red];
		j3011841748 -> j3767779490;
	j1268305758 [label="那你知道他为什么把你留在那里吗 ？",shape=box,color=blue];
		j1268305758 -> j1537361021;
		j1268305758 -> j3011841748;
		j1268305758 -> j4005582538;
	j2049606644 [label="Non。等一下。 L'Indifférence 有……盟友 ？",shape=box,color=blue];
		j2049606644 -> j3609857964;
		j2049606644 -> j1640565240;
	j400101242 [label="Add 1 to Family counter",color=orange];
		j400101242 -> j2116200429;
	j2046866174 [label="Boolean MarieEntratiMonster2 is now true.",color=orange];
		j2046866174 -> j1387472653;
	j1991724318 [label="Boolean MarieEntratiFan2 is now true.",color=orange];
		j1991724318 -> j1387472653;
	j2459248188 [label="Oui，c'est raisonnable，而且很公平，考虑到你所见所闻。我不能再奢求你更多了。",shape=box,color=blue];
		j2459248188 -> j2365614228;
	j221931327 [label="Boolean MarieLyonSuffering3 is now true.",color=orange];
		j221931327 -> j1591510439;
	j3767779490 [label="那么我必须恳请你不要先以最坏的角度揣测他，因为这会让你的心变得苦毒。 ",shape=box,color=blue];
		j3767779490 -> j874089075;
	j1537361021 [label="我​只​希望​他​给​出​一​个​好​的​理由。​",shape=box,color=red];
		j1537361021 -> j504277969;
	j4005582538 [label="不知道，不过这不重要。他本来可以救我的。但他没有。",shape=box,color=red];
		j4005582538 -> j2357154930;
	j3609857964 [label="它只不过是戴着另一张脸而已。",shape=box,color=red];
		j3609857964 -> j3382444694;
	j1640565240 [label="也许吧 ？或者说是人质。或者只是戴着她的脸。我们并不知道真相。",shape=box,color=red];
		j1640565240 -> j3382444694;
	j2116200429 [label="+10 Chemistry",color=orange];
		j2116200429 -> j1719422475;
	j1387472653 [label="啊，里昂在叫我。À la revoyure ！",shape=box,color=blue];
		j1387472653 -> "Chat ends.";
	j2365614228 [label="Boolean MarieEntratiNeutral is now true.",color=orange];
		j2365614228 -> j1387472653;
	j874089075 [label="也许你还不想抛弃双衍王境。也许当时事情对你来说还没有变糟。也许你还舍不得离开你的朋友们 ？",shape=box,color=blue];
		j874089075 -> j2701128683;
	j504277969 [label="+5 Chemistry",color=orange];
		j504277969 -> j1365220575;
	j2357154930 [label="你能说，无论从哪个角度看，你都找不到他离开你的理由吗 ？ ",shape=box,color=blue];
		j2357154930 -> j874089075;
	j3382444694 [label="Boolean MarieNeci is now true.",color=orange];
		j3382444694 -> j2366556393;
	j1719422475 [label="哦，好主意。我觉得这是一件值得支持的事情 ！",shape=box,color=blue];
		j1719422475 -> j130896092;
	j2701128683 [label="也许他也不知道能否带你离开那世界，担心它会因此而崩溃。也许他以为，如果你走了，l'Indifférence 就会收回它。Peut-être，Peut-être，Peut-être。",shape=box,color=blue];
		j2701128683 -> j1591510439;
	j1365220575 [label="Merci，Merci——这正是我所珍视的信念。我们不能往坏处想，因为那只会让我们的心变得苦毒。",shape=box,color=blue];
		j1365220575 -> j228375062;
	j2366556393 [label="我不知道该怎么看待这件事……但这确实听起来很奇怪…… ",shape=box,color=blue];
		j2366556393 -> j1268305758;
