	j784940574 [label="恐怕我们对那些被改造成原始战甲的人了解不多。",shape=box,color=red];
		j784940574 -> j2543736962;
	j3389412983 [label="恐怕我们对原始的 Wisp 了解不多。",shape=box,color=red];
		j3389412983 -> j2543736962;
	j3859591551 [label="告诉我，狼，这个叫“Wisp”的人是谁，她的腐化血液在我体内流淌，却赐予了我飞翔和自由的恩赐。在夜幕中，我能感觉到她的灵魂与我的灵魂是如此接近。",shape=box,color=blue];
		j3859591551 -> j2049394510;
		j3859591551 -> j555321091;
	j2531324477 [label="告诉我，狼，这个叫“Wisp”的人是谁，她的腐化血液在我体内流淌，却赐予了我飞翔和自由的恩赐。在夜幕中，我能感觉到她的灵魂与我的灵魂是如此接近。",shape=box,color=blue];
		j2531324477 -> j3162662316;
	j2543736962 [label="Vraiment ？这些记录是随着时间的流逝而丢失的吗？还是你怀疑他们只是被认为不够重要，不值得记住？",shape=box,color=blue];
		j2543736962 -> j3661421872;
		j2543736962 -> j2677253228;
		j2543736962 -> j3366063415;
	j2049394510 [label="恐怕我们对那些被改造成原始战甲的人了解不多。",shape=box,color=red];
		j2049394510 -> j409533648;
	j555321091 [label="恐怕我们对原始的 Wisp 了解不多。",shape=box,color=red];
		j555321091 -> j409533648;
	j3162662316 [label="希望关于灵魂的探讨不会让你感到困扰 ？如果确实会困扰你，我理解的。我们可以讨论一些更实际的事情，我不想让你感到不舒服。",shape=box,color=blue];
		j3162662316 -> j1934895181;
		j3162662316 -> j3214635490;
		j3162662316 -> j1038552372;
	j3661421872 [label="我认为他们不够重要，不值得记住。",shape=box,color=red];
		j3661421872 -> j3124301395;
	j2677253228 [label="我认为他们的资料随着时间的流逝已经消失了。",shape=box,color=red];
		j2677253228 -> j3124301395;
	j3366063415 [label="说​到​底，​都​有​可能。​对于​他们​的​主要​创造者​来说……他们​既​是​武器，​又​是​艺术品。​",shape=box,color=red];
		j3366063415 -> j152329565;
	j409533648 [label="Vraiment ？可我却感觉我认识她，就像她是我的亲姐妹一样——她就像是我的血亲，而不是 Cathédrale 里的人。",shape=box,color=blue];
		j409533648 -> j1674388868;
	j1934895181 [label="没关系，我们可以聊聊灵魂。",shape=box,color=red];
		j1934895181 -> j2049394510;
		j1934895181 -> j555321091;
		j1934895181 -> j1038552372;
	j3214635490 [label="我不信有灵魂的存在，所以如果可以的话，我们应该用确凿的事实来解释 ？",shape=box,color=red];
		j3214635490 -> j382008529;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j3124301395 [label="你看到了吗 ？ Ces奥罗金，他们是恶魔。",shape=box,color=blue];
		j3124301395 -> j1406236293;
		j3124301395 -> j2734670197;
	j152329565 [label="+5 Chemistry",color=orange];
		j152329565 -> j177350814;
	j1674388868 [label="我听不到她的声音，不像里昂听到众神和守护灵的声音那样。我也看不到她。我只是能感觉她就在这里，在我身边。",shape=box,color=blue];
		j1674388868 -> j2454944195;
	j382008529 [label="Boolean DrifterFaithStop is now true.",color=orange];
		j382008529 -> j3475300287;
	"Chat ends." [color=orange];
	j1406236293 [label="武器既可以用来保护，也可以用来伤害。我们并不喜欢依赖它们，但……我们确实需要它们。",shape=box,color=red];
		j1406236293 -> j3055373479;
	j2734670197 [label="他们不全是恶魔。但那一个？他一定是。还有一些人我不会现在谴责。",shape=box,color=red];
		j2734670197 -> j1833892940;
	j177350814 [label="Une horrible toile d'os peinte avec du sang……你看到了吗 ？ Ces奥罗金，他们是恶魔。",shape=box,color=blue];
		j177350814 -> j1406236293;
		j177350814 -> j2734670197;
	j2454944195 [label="也许，就像一位老朋友吧。我知道她喜欢什么，我知道她如何行动。我还记得她笑声在风中飘荡……",shape=box,color=blue];
		j2454944195 -> j182205497;
	j3475300287 [label="+5 Chemistry",color=orange];
		j3475300287 -> j4002760872;
	j3055373479 [label="Add -1 to Thermostat counter",color=orange];
		j3055373479 -> j132941633;
	j1833892940 [label="Add 1 to Thermostat counter",color=orange];
		j1833892940 -> j3564800625;
	j182205497 [label="你一定觉得我疯了吧？抱歉。",shape=box,color=blue];
		j182205497 -> j840418613;
		j182205497 -> j3094231829;
		j182205497 -> j3214152963;
		j182205497 -> j4202502585;
	j4002760872 [label="Oui，bien sû ！没人喜欢被说教，尤其是被修女说教。我理解。Merci，我不想让自己出丑。",shape=box,color=blue];
		j4002760872 -> j784940574;
		j4002760872 -> j3389412983;
		j4002760872 -> j1038552372;
	j132941633 [label="是的，确实如此。我现在成了一件武器，这一点 Murmure 知道 ！但我仍想追随主教为我安排的道路，这是一条蒙福的路。",shape=box,color=blue];
		j132941633 -> j1928690267;
		j132941633 -> j656157286;
	j3564800625 [label="就​像​主教。​他​是​奥罗金​ 人，​不​是​吗 ？​而且​我​绝​对​不​会​谴责​他。​没有​他，​就​没有​我​今天​这个​蒙福​的​人。​",shape=box,color=blue];
		j3564800625 -> j1367849025;
		j3564800625 -> j2928948506;
	j840418613 [label="战甲的制造方法……并不美好。我只希望她没被感染困住了。",shape=box,color=red];
		j840418613 -> j3880280751;
	j3094231829 [label="我想无论 Wisp 是谁，她都会很高兴认识你。",shape=box,color=red];
		j3094231829 -> j3581932123;
	j3214152963 [label="我希望他们的灵魂能够彻底得到安息，但我想，他们的部分记忆仍然存在。",shape=box,color=red];
		j3214152963 -> j170061914;
	j4202502585 [label="完全没有。我相信被改造成战甲的人，他们的核心构造中仍然残存着他们一部分。",shape=box,color=red];
		j4202502585 -> j2295660071;
	j1928690267 [label="我有很多事可以跟他争论，但我得说，他似乎在选择原型战甲血清类型和注射的对象上，有着敏锐的直觉。即使我不明白他为什么这么做。",shape=box,color=red];
		j1928690267 -> j950641154;
	j656157286 [label="我希望你别那么相信英择谛。我们不知道他为什么要这么做，他的动机也不清楚。",shape=box,color=red];
		j656157286 -> j1722407835;
	j1367849025 [label="我们必须跟着英择谛。我觉得无论他去哪我们只能跟着他。他是我们阻止虚空无情之物的唯一机会。",shape=box,color=red];
		j1367849025 -> j737842484;
	j2928948506 [label="玛丽，他是个骗子。他抛弃并伤害了他生命中的每一个人。他已经抛弃你了，你难道还不明白吗？ ",shape=box,color=red];
		j2928948506 -> j1591510439;
