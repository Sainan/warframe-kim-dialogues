digraph {
	"MarieRank5Convo5 begins." [color=orange];
		"MarieRank5Convo5 begins." -> j20182927;
	j20182927 [label="Check boolean MarieDating",color=orange];
		j20182927 -> j1046758907 [label=true,color=green];
		j20182927 -> j2801850301 [label=false,color=brown];
	j1046758907 [label="Bonjour，bonjour，mon cœur ！我得告诉你一件特别傻的事。",shape=box,color=blue];
		j1046758907 -> j2166463722;
		j1046758907 -> j1038552372;
	j2801850301 [label="Bonjour ！我得告诉你一件特别傻的事。",shape=box,color=blue];
		j2801850301 -> j2166463722;
		j2801850301 -> j1038552372;
	j2166463722 [label="哦？发生什么事了？",shape=box,color=red];
		j2166463722 -> j3089796867;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j3089796867 [label="我问鸟 Trois 先生他的生日是什么时候，他竟然不知道 ！真是太悲伤了 ！",shape=box,color=blue];
		j3089796867 -> j3812376289;
	"Chat ends." [color=orange];
	j3812376289 [label="科维兽都不知道自己的生日，我可以理解，因为他们不是一出生就能说话，也不像我们一样知道历法。",shape=box,color=blue];
		j3812376289 -> j3985164587;
	j3985164587 [label="所以我觉得，这真是个 tragédie ！我们必须立刻纠正这件事，non ？",shape=box,color=blue];
		j3985164587 -> j4165167727;
		j3985164587 -> j1327992980;
		j3985164587 -> j1277894217;
	j4165167727 [label="我倒是没想过这个。",shape=box,color=red];
		j4165167727 -> j2886705994;
	j1327992980 [label="那你要如何得知他们的出生日期？",shape=box,color=red];
		j1327992980 -> j4085290857;
	j1277894217 [label="你会让他们自己选择生日吗？",shape=box,color=red];
		j1277894217 -> j1558034742;
	j2886705994 [label="Oui ！洛伊德先生也没有。当我发现这一点时，他脸上满是悲伤……",shape=box,color=blue];
		j2886705994 -> j1903700972;
	j4085290857 [label="起初，我想查阅一下主教的记录——或许他记录了他们的出生日期，oui ？",shape=box,color=blue];
		j4085290857 -> j2402114516;
	j1558034742 [label="“让？”你这话说的好像这由我决定似的 ！ ",shape=box,color=blue];
		j1558034742 -> j4085290857;
	j1903700972 [label="他竟然认为是自己的错，说自己没有预先想到这一点，这让我心碎。这不是他的错，他为那么多人做了那么多事……",shape=box,color=blue];
		j1903700972 -> j1993799257;
	j2402114516 [label="Evaluate expressions",color=orange];
		j2402114516 -> j835558439 [label="MarieEntratiComplete",color=purple];
		j2402114516 -> j835558439 [label="MarieEntrati3a",color=purple];
		j2402114516 -> j383169130 [label="false",color=purple];
	j1993799257 [label="能遇见洛德先生的善良，我们都是有福的。他的慷慨无私，如活泉一般，永不枯干。",shape=box,color=blue];
		j1993799257 -> j236211799;
		j1993799257 -> j1374984785;
	j835558439 [label="但我随即想起了……我和标弃先生以及其他人的对话，我想……这样做可能不太明智。",shape=box,color=blue];
		j835558439 -> j3195114261;
	j383169130 [label="但他们似乎对寻找自己的过去毫无兴趣。我知道，思考自己的身世是多么痛苦。",shape=box,color=blue];
		j383169130 -> j3195114261;
	j236211799 [label="有他真是我们的幸运。",shape=box,color=red];
		j236211799 -> j3084140734;
	j1374984785 [label="我只是希望他有时能开心一点。",shape=box,color=red];
		j1374984785 -> j3949071119;
	j3195114261 [label="毕竟我也不知道自己的生日。 ",shape=box,color=blue];
		j3195114261 -> j3276459816;
		j3195114261 -> j4009157294;
		j3195114261 -> j1375182734;
	j3084140734 [label="Oui，是的。我们都很幸运。",shape=box,color=blue];
		j3084140734 -> j3542593548;
	j3949071119 [label="他是个严肃的人，但我见过他笑。他身上有种幽默感，总是在意想不到的时候流露出来。你只需要耐心一点。",shape=box,color=blue];
		j3949071119 -> j3542593548;
	j3276459816 [label="我也一样，如果这能让你好受些。我猜那孩子也不记得了。",shape=box,color=red];
		j3276459816 -> j358267160;
	j4009157294 [label="生日被赋予太多意义了。",shape=box,color=red];
		j4009157294 -> j1810075979;
	j1375182734 [label="反正自己挑选更有趣，也更有 poignant。 ",shape=box,color=red];
		j1375182734 -> j862338933;
	j3542593548 [label="Check boolean MarieDating",color=orange];
		j3542593548 -> j743491151 [label=true,color=green];
		j3542593548 -> j397238821 [label=false,color=brown];
	j358267160 [label="真替你和那小小的复制品感到惋惜。我们又多了些共同点 ！",shape=box,color=blue];
		j358267160 -> j3542593548;
	j1810075979 [label="我不这么认为 ！理应给那些还在我们身边的人好好庆祝，离开的那些人也值得我们纪念。",shape=box,color=blue];
		j1810075979 -> j3542593548;
	j862338933 [label="Poignan​t ？​我​竟然​不​知道​你​会​说​高卢语​ ！​你​是​从​我​这​儿学​的​吗 ？​",shape=box,color=blue];
		j862338933 -> j3606868482;
		j862338933 -> j1125244190;
	j743491151 [label="+20 Chemistry",color=orange];
		j743491151 -> j3312660947;
	j397238821 [label="+20 Chemistry",color=orange];
		j397238821 -> j226258097;
	j3606868482 [label="我只是觉得……这词在两种语言中的意思是一样的……",shape=box,color=red];
		j3606868482 -> j35388178;
	j1125244190 [label="一定是跟你学的。",shape=box,color=red];
		j1125244190 -> j336394535;
	j3312660947 [label="现在 ！加入我们吧，mon cœur ！就算最后什么结果都没有也没关系，心意最重要！Au calendrier！",shape=box,color=blue];
		j3312660947 -> "Chat ends.";
	j226258097 [label="现在 ！加入我们吧 ！就算最后什么结果都没有也没关系，心意最重要！Au calendrier！",shape=box,color=blue];
		j226258097 -> "Chat ends.";
	j35388178 [label="呸 ！其他语言总是窃取高卢语的精华，然后照搬不误 ！时代永远不会改变 ！",shape=box,color=blue];
		j35388178 -> j3542593548;
	j336394535 [label="那你真是聪明 ！高卢语是历史上最美丽的语言之一，我很高兴能把它带到未来。",shape=box,color=blue];
		j336394535 -> j3542593548;
}