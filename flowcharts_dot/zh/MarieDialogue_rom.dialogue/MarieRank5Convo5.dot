	3093 [label="Bonjour，bonjour，mon cœur ！我得告诉你一件特别傻的事。",shape=box,color=blue];
		3093 -> 3095;
		3093 -> 3096;
	3094 [label="Bonjour ！我得告诉你一件特别傻的事。",shape=box,color=blue];
		3094 -> 3095;
		3094 -> 3096;
	3095 [label="哦？发生什么事了？",shape=box,color=red];
		3095 -> 3097;
	3096 [label="[结束]",shape=box,color=red];
		3096 -> 3098;
	3097 [label="我问鸟 Trois 先生他的生日是什么时候，他竟然不知道 ！真是太悲伤了 ！",shape=box,color=blue];
		3097 -> 3099;
	3098 [label="Chat ends.",color=orange];
	3099 [label="科维兽都不知道自己的生日，我可以理解，因为他们不是一出生就能说话，也不像我们一样知道历法。",shape=box,color=blue];
		3099 -> 3100;
	3100 [label="所以我觉得，这真是个 tragédie ！我们必须立刻纠正这件事，non ？",shape=box,color=blue];
		3100 -> 3101;
		3100 -> 3102;
		3100 -> 3103;
	3101 [label="我倒是没想过这个。",shape=box,color=red];
		3101 -> 3104;
	3102 [label="那你要如何得知他们的出生日期？",shape=box,color=red];
		3102 -> 3105;
	3103 [label="你会让他们自己选择生日吗？",shape=box,color=red];
		3103 -> 3106;
	3104 [label="Oui ！洛伊德先生也没有。当我发现这一点时，他脸上满是悲伤……",shape=box,color=blue];
		3104 -> 3107;
	3105 [label="起初，我想查阅一下主教的记录——或许他记录了他们的出生日期，oui ？",shape=box,color=blue];
		3105 -> 3108;
	3106 [label="“让？”你这话说的好像这由我决定似的 ！ ",shape=box,color=blue];
		3106 -> 3105;
	3107 [label="他竟然认为是自己的错，说自己没有预先想到这一点，这让我心碎。这不是他的错，他为那么多人做了那么多事……",shape=box,color=blue];
		3107 -> 3109;
	3108 [label="Evaluate expressions",color=orange];
		3108 -> 3110 [label="MarieEntratiComplete",color=purple];
		3108 -> 3110 [label="MarieEntrati3a",color=purple];
		3108 -> 3111 [label="false",color=purple];
	3109 [label="能遇见洛德先生的善良，我们都是有福的。他的慷慨无私，如活泉一般，永不枯干。",shape=box,color=blue];
		3109 -> 3112;
		3109 -> 3113;
	3110 [label="但我随即想起了……我和标弃先生以及其他人的对话，我想……这样做可能不太明智。",shape=box,color=blue];
		3110 -> 3114;
	3111 [label="但他们似乎对寻找自己的过去毫无兴趣。我知道，思考自己的身世是多么痛苦。",shape=box,color=blue];
		3111 -> 3114;
	3112 [label="有他真是我们的幸运。",shape=box,color=red];
		3112 -> 3115;
	3113 [label="我只是希望他有时能开心一点。",shape=box,color=red];
		3113 -> 3116;
	3114 [label="毕竟我也不知道自己的生日。 ",shape=box,color=blue];
		3114 -> 3117;
		3114 -> 3118;
		3114 -> 3119;
	3115 [label="Oui，是的。我们都很幸运。",shape=box,color=blue];
		3115 -> 3120;
	3116 [label="他是个严肃的人，但我见过他笑。他身上有种幽默感，总是在意想不到的时候流露出来。你只需要耐心一点。",shape=box,color=blue];
		3116 -> 3120;
	3117 [label="我也一样，如果这能让你好受些。我猜那孩子也不记得了。",shape=box,color=red];
		3117 -> 3121;
	3118 [label="生日被赋予太多意义了。",shape=box,color=red];
		3118 -> 3122;
	3119 [label="反正自己挑选更有趣，也更有 poignant。 ",shape=box,color=red];
		3119 -> 3123;
	3120 [label="Check boolean MarieDating",color=orange];
		3120 -> 3125 [label=true,color=green];
		3120 -> 3124 [label=false,color=brown];
	3121 [label="真替你和那小小的复制品感到惋惜。我们又多了些共同点 ！",shape=box,color=blue];
		3121 -> 3120;
	3122 [label="我不这么认为 ！理应给那些还在我们身边的人好好庆祝，离开的那些人也值得我们纪念。",shape=box,color=blue];
		3122 -> 3120;
	3123 [label="Poignan​t ？​我​竟然​不​知道​你​会​说​高卢语​ ！​你​是​从​我​这​儿学​的​吗 ？​",shape=box,color=blue];
		3123 -> 3126;
		3123 -> 3127;
	3125 [label="+20 Chemistry",color=orange];
		3125 -> 3129;
	3124 [label="+20 Chemistry",color=orange];
		3124 -> 3128;
	3126 [label="我只是觉得……这词在两种语言中的意思是一样的……",shape=box,color=red];
		3126 -> 3130;
	3127 [label="一定是跟你学的。",shape=box,color=red];
		3127 -> 3131;
	3129 [label="现在 ！加入我们吧，mon cœur ！就算最后什么结果都没有也没关系，心意最重要！Au calendrier！",shape=box,color=blue];
		3129 -> 3132;
	3128 [label="现在 ！加入我们吧 ！就算最后什么结果都没有也没关系，心意最重要！Au calendrier！",shape=box,color=blue];
		3128 -> 3132;
	3130 [label="呸 ！其他语言总是窃取高卢语的精华，然后照搬不误 ！时代永远不会改变 ！",shape=box,color=blue];
		3130 -> 3120;
	3131 [label="那你真是聪明 ！高卢语是历史上最美丽的语言之一，我很高兴能把它带到未来。",shape=box,color=blue];
		3131 -> 3120;
	3132 [label="Chat ends.",color=orange];
}