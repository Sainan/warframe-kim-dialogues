	800 [label="+15 Chemistry",color=orange];
		800 -> 806;
	801 [label="在她当时的状态下会发生什么呢？她会像阳光下的一幅画，日渐褪色，直至消失殆尽。 ",shape=box,color=blue];
		801 -> 807;
	802 [label="+10 Chemistry",color=orange];
		802 -> 808;
	803 [label="+5 Chemistry",color=orange];
		803 -> 809;
	792 [label="可​要​是​知道他还在外面四处惹事，却连一句都没有跟她说，甚至连封信都没寄……？",shape=box,color=red];
		792 -> 798;
	793 [label="可​要​是​知道他还在外面四处惹事，却连一句都没有跟她说，甚至连封信都没寄……？",shape=box,color=red];
		793 -> 799;
	806 [label="这个问题问得真明智。非常明智。我想有很多原因促使我这么做。我想是善意让我与她同坐一桌。",shape=box,color=blue];
		806 -> 812;
	807 [label="之后她离开了我们，我们为她举行了烛光守夜。我希望她最终能记住那些真心待她的人。 ",shape=box,color=blue];
		807 -> 813;
	808 [label="我相信在她的内心深处她是知道的。",shape=box,color=blue];
		808 -> 813;
	809 [label="是出于善意吗 ？还是因为愧疚才这么做的 ？啊，不过你这么说，也只是出于善意罢了。 ",shape=box,color=blue];
		809 -> 813;
	798 [label="我无法想象这对她、对他们来说有多么痛苦。",shape=box,color=red];
		798 -> 804;
	799 [label="这会毁掉他们之间仅存的那点和解机会。",shape=box,color=red];
		799 -> 805;
	812 [label="但我想，或许是内心深处的愧疚。如果我不这么做，我就忽视了她。就像忽视一个孩子一样。",shape=box,color=blue];
		812 -> 813;
	813 [label="我更愿意相信你们的奥塔知道谁对他友善又耐心。可是，话说回来，其实他并不在那里，对吗？",shape=box,color=blue];
		813 -> 817;
	804 [label="虽然我能理解那个决定背后的逻辑，就是为了保护他们免受主教必须离开而造成的痛苦……",shape=box,color=blue];
		804 -> 810;
	805 [label="+10 Chemistry",color=orange];
		805 -> 811;
	817 [label="我说的是一件非常精巧的仿人科技装置，对吧 ？一台精妙复杂很多倍的留声机。就像殁世械灵一样，他没有灵魂。",shape=box,color=blue];
		817 -> 822;
		817 -> 823;
		817 -> 824;
		817 -> 825;
		817 -> 826;
	810 [label="但我确实觉得这太残忍了，你不觉得吗？他们可能会以为他死了。或者更糟 ！而我们，住在这里，comme des rats d'égout ？",shape=box,color=blue];
		810 -> 814;
		810 -> 815;
	811 [label="Oui……我明白其中的逻辑。如果可以的话，我也会努力修复他们的家庭，non ？这似乎是我们所有人离开这里的唯一希望。 ",shape=box,color=blue];
		811 -> 816;
	822 [label="殁世械灵或许没有灵魂，但他很独特。其他中枢，比如奥塔，都有灵魂。它们在诞生之初就被毁坏了。",shape=box,color=red];
		822 -> 831;
	823 [label="你说得对。那么你希望我做什么呢？",shape=box,color=red];
		823 -> 832;
	824 [label="你说得对，他们确实没有。但这并不意味着我们可以随意虐待他们。",shape=box,color=red];
		824 -> 833;
	825 [label="我不知道你说的是不是对的。但他们仍能思考，能感受，我们不能把他们当成物品来对待。",shape=box,color=red];
		825 -> 834;
	826 [label="殁世械灵有灵魂。所有中枢都有。",shape=box,color=red];
		826 -> 835;
	814 [label="其实这不是我做出的决定。",shape=box,color=red];
		814 -> 818;
	815 [label="我其实有个朋友很喜欢老鼠。我也觉得它们很可爱。",shape=box,color=red];
		815 -> 819;
	816 [label="以免我们余生都被困在这里，comme des rats d'égout。 ",shape=box,color=blue];
		816 -> 820;
		816 -> 821;
