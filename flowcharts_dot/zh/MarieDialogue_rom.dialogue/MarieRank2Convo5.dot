	739 [label="我一直在思考你告诉我的有关奥塔先生的事情。",shape=box,color=blue];
		739 -> 743;
	738 [label="我一直在思考你告诉我的有关主教家族的事情。",shape=box,color=blue];
		738 -> 742;
	737 [label="我可以再向你问一个有关“殁世械灵”先生的问题吗？",shape=box,color=blue];
		737 -> 741;
		737 -> 740;
	743 [label="我想知道这是否与我自己的故事相似。如果你有时间，我可以讲给你听吗？",shape=box,color=blue];
		743 -> 749;
		743 -> 748;
	742 [label="我在想，你能告诉我奥塔的故事吗 ？那张殁世械灵头骨后面的孩子般的脸。",shape=box,color=blue];
		742 -> 747;
		742 -> 746;
	741 [label="当然可以，什么问题？",shape=box,color=red];
