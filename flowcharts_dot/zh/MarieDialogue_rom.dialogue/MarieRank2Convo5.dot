	827 [label="我认为，将我们困守于此的并非崇高情操，而是负罪感。",shape=box,color=blue];
		827 -> 836;
	828 [label="我也很想哪天见一下那位朋友，但这不是我要说的重点，傻狼。",shape=box,color=blue];
		828 -> 827;
	829 [label="+5 Chemistry",color=orange];
		829 -> 837;
	830 [label="+5 Chemistry",color=orange];
		830 -> 838;
	845 [label="这进一步证明对恶魔及其同类的谴责是正确的。不过，或许你对奥塔及其同类的看法也是正确的，又或许相信这一点能给你带来内心的平安。",shape=box,color=blue];
		845 -> 850;
	846 [label="让我心痛的，是那些被奥罗金恶魔留下的残骸。他们不是神，而是吞噬一切的凶手。看看与我们同行的那一位就知道了。",shape=box,color=blue];
		846 -> 851;
	847 [label="也许你是对的，但我不认为那些奥罗金恶魔比我们更了解灵魂的事情。他们并不是什么伟大的神。",shape=box,color=blue];
		847 -> 852;
	848 [label="也许你是对的，也许相信这一点，能让你感到平安。",shape=box,color=blue];
		848 -> 851;
	836 [label="我们是在躲避某种重大而可怕的罪。",shape=box,color=blue];
		836 -> 844;
	837 [label="谢谢。我不知道你是否会成功，但有时候，我们能做的只有去尝试。",shape=box,color=blue];
		837 -> 827;
	838 [label="我也很想哪天见一下那位朋友，但这不是我要说的重点，傻狼。",shape=box,color=blue];
		838 -> 827;
	850 [label="无论如何，我更愿相信，那个早已去世的奥塔，如果你能善待承载了他生命的殁世械灵先生，那么他也会微笑吧。",shape=box,color=blue];
		850 -> 2920;
	851 [label="只是当洛德就站在殁世械灵旁边时，我很难说殁世械灵真的有灵魂，oui ？",shape=box,color=blue];
		851 -> 850;
	852 [label="科技，也许是——科学，是——但灵魂 ？他们连自己的内心都无法掌控 ！如果你还需要更多证据，看看那个与我们同行的恶魔就知道了。",shape=box,color=blue];
		852 -> 851;
	844 [label="而正是那份罪需要被宽恕。",shape=box,color=blue];
