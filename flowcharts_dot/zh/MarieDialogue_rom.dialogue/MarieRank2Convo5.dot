digraph {
	"MarieRank2Convo5 begins." [color=orange];
		"MarieRank2Convo5 begins." -> j1631090094;
	j1631090094 [label="Evaluate expressions",color=orange];
		j1631090094 -> j3782013982 [label="MarieOtak1",color=purple];
		j1631090094 -> j3257897845 [label="MarieFamily1",color=purple];
		j1631090094 -> j2132138210 [label="false",color=purple];
	j3782013982 [label="我一直在思考你告诉我的有关奥塔先生的事情。",shape=box,color=blue];
		j3782013982 -> j3315178768;
	j3257897845 [label="我一直在思考你告诉我的有关主教家族的事情。",shape=box,color=blue];
		j3257897845 -> j3368291071;
	j2132138210 [label="我可以再向你问一个有关“殁世械灵”先生的问题吗？",shape=box,color=blue];
		j2132138210 -> j119512287;
		j2132138210 -> j1038552372;
	j3315178768 [label="我想知道这是否与我自己的故事相似。如果你有时间，我可以讲给你听吗？",shape=box,color=blue];
		j3315178768 -> j2646447301;
		j3315178768 -> j1038552372;
	j3368291071 [label="我在想，你能告诉我奥塔的故事吗 ？那张殁世械灵头骨后面的孩子般的脸。",shape=box,color=blue];
		j3368291071 -> j2943902556;
		j3368291071 -> j2859944693;
	j119512287 [label="当然可以，什么问题？",shape=box,color=red];
		j119512287 -> j2744659624;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j2646447301 [label="请讲。",shape=box,color=red];
		j2646447301 -> j3152012040;
	j2943902556 [label="当然。",shape=box,color=red];
		j2943902556 -> j3387025280;
	j2859944693 [label="也许以后吧。[结束]",shape=box,color=red];
		j2859944693 -> "Chat ends.";
	j2744659624 [label="我好奇他后面为何还刻着另一张脸，那模样活像小朋友的涂鸦。",shape=box,color=blue];
		j2744659624 -> j4266362990;
	"Chat ends." [color=orange];
	j3152012040 [label="Cathédrale 里有一位修女，她曾经迷失在她过去的回忆中。她就是塞西莉亚修女。",shape=box,color=blue];
		j3152012040 -> j1056515585;
	j3387025280 [label="众所周知，他是一位天才，也是驾驭氩结晶的幕后推手。",shape=box,color=red];
		j3387025280 -> j1841873739;
	j4266362990 [label="我分别询问了殁世械灵先生和洛德先生，但两人都避而不谈此事，只告诉我一个名字：奥塔。他们说出这个名字时，语气中带着深深的悲伤。",shape=box,color=blue];
		j4266362990 -> j2226001018;
	j1056515585 [label="她常常站在大厅里的大钟前，宣称现在是下午两点，但其实并她不知道具体时间。",shape=box,color=blue];
		j1056515585 -> j1340780234;
	j1841873739 [label="这些力量源自虚空——正是它们让我们能够制造出众多强大的战甲与武器。",shape=box,color=red];
		j1841873739 -> j2827762253;
	j2226001018 [label="所以我在这里和你交谈，希望你能帮助我。",shape=box,color=blue];
		j2226001018 -> j2867361340;
		j2226001018 -> j108728221;
	j1340780234 [label="我们往往会发现走廊里的所有画都摆错了方向，她说它们在向她低声讲述可怕的阴谋。",shape=box,color=blue];
		j1340780234 -> j196427357;
	j2827762253 [label="他专攻晶体学。他的研究成果都保存在这里的实验室里。",shape=box,color=red];
		j2827762253 -> j2540984397;
	j2867361340 [label="你想了解奥塔吗？还是想知道为什么你无法和他交谈？",shape=box,color=red];
		j2867361340 -> j698440215;
	j108728221 [label="奥塔​的​事情​很​难​解释……",shape=box,color=red];
		j108728221 -> j2100059297;
	j196427357 [label="后来我们了解到她只是听到了其他房间里的谈话，并以为是画作在说话……",shape=box,color=blue];
		j196427357 -> j2966699743;
	j2540984397 [label="后来不知道是什么原因，他被改造成了一个中枢，并获得了自己的殁世械灵外壳。",shape=box,color=red];
		j2540984397 -> j3771220000;
	j698440215 [label="我想我终究都会去了解这两者，但开始从哪里由你决定。après tout，我也不知道哪一个更重要。",shape=box,color=blue];
		j698440215 -> j2100059297;
	j2100059297 [label="Check boolean LoidFamilyComplete",color=orange];
		j2100059297 -> j827131678 [label=true,color=green];
		j2100059297 -> j827131678 [label=false,color=brown];
		j2100059297 -> j1180812017 [label=false,color=brown];
	j2966699743 [label="有一次，她甚至把休息室里的所有垫子都当成了孩子，并招待它们喝茶……",shape=box,color=blue];
		j2966699743 -> j792587242;
	j3771220000 [label="不是所有中枢都是因刑罚而被造的。但当时火卫二这边的情况……变得很糟糕，他受了重伤。",shape=box,color=red];
		j3771220000 -> j2660790475;
	j827131678 [label="奥塔曾是一位哲士、奥罗金科学家和学者。关于他的经历，实在算不上一个幸福的故事。",shape=box,color=red];
		j827131678 -> j1475445318;
	j1180812017 [label="嗯……简而言之，英择谛家族有几位在楼上，而他们……完全不知道我们就在楼下。",shape=box,color=red];
		j1180812017 -> j4056453502;
	j792587242 [label="当我走进房间时，她抬头看着我说道：“哦，奥黛特修女，你来了 ！孤儿院的孩子们来了，你要一起吗？”",shape=box,color=blue];
		j792587242 -> j3824766974;
		j792587242 -> j1273381741;
	j2660790475 [label="+5 Chemistry",color=orange];
		j2660790475 -> j2731710704;
	j1475445318 [label="Boolean MarieOtak1 is now true.",color=orange];
		j1475445318 -> j919539480;
	j4056453502 [label="Boolean MarieFamily1 is now true.",color=orange];
		j4056453502 -> j1838862134;
	j3824766974 [label="你当时怎么做的 ？",shape=box,color=red];
		j3824766974 -> j2372325831;
	j1273381741 [label="奥黛特修女是谁 ？",shape=box,color=red];
		j1273381741 -> j536966639;
	j2731710704 [label="Pauvre petit……",shape=box,color=blue];
		j2731710704 -> j1667237994;
	j919539480 [label="Par les Luminaires……请继续说。",shape=box,color=blue];
		j919539480 -> j3387025280;
	j1838862134 [label="Par les Luminaires……你是说我们都在这里秘密活动？！所以才不让我们离开这里？！Mais pourquoi？！",shape=box,color=blue];
		j1838862134 -> j485437493;
	j2372325831 [label="我还能怎么办 ？我把椅子移到桌子旁边的一个空位上，和她和垫子一起喝茶。",shape=box,color=blue];
		j2372325831 -> j1579572719;
	j536966639 [label="恐怕奥黛特修女已经去世三十年了。",shape=box,color=blue];
		j536966639 -> j3233405540;
	j1667237994 [label="因此，他被转移到了这个主要的殁世械灵——唯一剩下的殁世械灵——并且……嗯？这很难解释。",shape=box,color=red];
		j1667237994 -> j2391179490;
		j1667237994 -> j236049507;
		j1667237994 -> j4035257489;
	j485437493 [label="是因为他的女儿欧拉瑞娅——人称“母亲”，以及她的家人，一直都在照顾着火卫二。",shape=box,color=red];
		j485437493 -> j3525090723;
	j1579572719 [label="当她给我讲她过去的故事时，我们一起笑得很开心。塞西莉亚修女从未告诉过任何人这些故事，至少据我所知没有。",shape=box,color=blue];
		j1579572719 -> j738451895;
	j3233405540 [label="我把椅子移到桌子旁边的一个空位上，和她和垫子一起喝茶。",shape=box,color=blue];
		j3233405540 -> j1579572719;
	j2391179490 [label="说实话，我真希望我们能修复他。把真正的奥塔带回来。",shape=box,color=red];
		j2391179490 -> j3152012040;
	j236049507 [label="他能让我笑。他很有趣，但背后却隐藏着一些悲伤和破碎的东西。",shape=box,color=red];
		j236049507 -> j3152012040;
	j4035257489 [label="可惜的是，他已经变不回去了。而且我觉得他挺让人心烦的。 ",shape=box,color=red];
		j4035257489 -> j3152012040;
	j3525090723 [label="守护着这个地方，以及那颗向始源星系输送虚空能量的心脏，自英择谛离开后，它始终维系着我们所有人的……存续。",shape=box,color=red];
		j3525090723 -> j3850907693;
	j738451895 [label="她的眼睛有时明亮，有时暗淡，就像孩子的洋娃娃……",shape=box,color=blue];
		j738451895 -> j1534376290;
		j738451895 -> j36828390;
		j738451895 -> j3315304343;
		j738451895 -> j93882351;
	j3850907693 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j3850907693 -> j2482030180 [label=true,color=green];
		j3850907693 -> j232071376 [label=false,color=brown];
	j1534376290 [label="你为什么要和她坐在一起？",shape=box,color=red];
		j1534376290 -> j3676963445;
	j36828390 [label="塞西莉亚修女怎么了？",shape=box,color=red];
		j36828390 -> j453504177;
	j3315304343 [label="我希望你的出现对她来说是有意义的。",shape=box,color=red];
		j3315304343 -> j2537673618;
	j93882351 [label="你心里有善意，愿意和她坐在一起。",shape=box,color=red];
		j93882351 -> j24877881;
	j2482030180 [label="她已经接受了他离开的事实，他们也和好了，但那是来之不易的。",shape=box,color=red];
		j2482030180 -> j2585020156;
	j232071376 [label="她还没有接受他离开的事实，而且他们之间总是争吵不停。",shape=box,color=red];
		j232071376 -> j598049040;
	j3676963445 [label="+15 Chemistry",color=orange];
		j3676963445 -> j1134475055;
	j453504177 [label="在她当时的状态下会发生什么呢？她会像阳光下的一幅画，日渐褪色，直至消失殆尽。 ",shape=box,color=blue];
		j453504177 -> j1865139592;
	j2537673618 [label="+10 Chemistry",color=orange];
		j2537673618 -> j2142318126;
	j24877881 [label="+5 Chemistry",color=orange];
		j24877881 -> j2233386151;
	j2585020156 [label="可​要​是​知道他还在外面四处惹事，却连一句都没有跟她说，甚至连封信都没寄……？",shape=box,color=red];
		j2585020156 -> j3290033297;
	j598049040 [label="可​要​是​知道他还在外面四处惹事，却连一句都没有跟她说，甚至连封信都没寄……？",shape=box,color=red];
		j598049040 -> j233860464;
	j1134475055 [label="这个问题问得真明智。非常明智。我想有很多原因促使我这么做。我想是善意让我与她同坐一桌。",shape=box,color=blue];
		j1134475055 -> j1102012758;
	j1865139592 [label="之后她离开了我们，我们为她举行了烛光守夜。我希望她最终能记住那些真心待她的人。 ",shape=box,color=blue];
		j1865139592 -> j3735893084;
	j2142318126 [label="我相信在她的内心深处她是知道的。",shape=box,color=blue];
		j2142318126 -> j3735893084;
	j2233386151 [label="是出于善意吗 ？还是因为愧疚才这么做的 ？啊，不过你这么说，也只是出于善意罢了。 ",shape=box,color=blue];
		j2233386151 -> j3735893084;
	j3290033297 [label="我无法想象这对她、对他们来说有多么痛苦。",shape=box,color=red];
		j3290033297 -> j4265801189;
	j233860464 [label="这会毁掉他们之间仅存的那点和解机会。",shape=box,color=red];
		j233860464 -> j2856004473;
	j1102012758 [label="但我想，或许是内心深处的愧疚。如果我不这么做，我就忽视了她。就像忽视一个孩子一样。",shape=box,color=blue];
		j1102012758 -> j3735893084;
	j3735893084 [label="我更愿意相信你们的奥塔知道谁对他友善又耐心。可是，话说回来，其实他并不在那里，对吗？",shape=box,color=blue];
		j3735893084 -> j58670411;
	j4265801189 [label="虽然我能理解那个决定背后的逻辑，就是为了保护他们免受主教必须离开而造成的痛苦……",shape=box,color=blue];
		j4265801189 -> j2213463000;
	j2856004473 [label="+10 Chemistry",color=orange];
		j2856004473 -> j3414175637;
	j58670411 [label="我说的是一件非常精巧的仿人科技装置，对吧 ？一台精妙复杂很多倍的留声机。就像殁世械灵一样，他没有灵魂。",shape=box,color=blue];
		j58670411 -> j3525273577;
		j58670411 -> j4039724246;
		j58670411 -> j2570519757;
		j58670411 -> j3932088812;
		j58670411 -> j800266365;
	j2213463000 [label="但我确实觉得这太残忍了，你不觉得吗？他们可能会以为他死了。或者更糟 ！而我们，住在这里，comme des rats d'égout ？",shape=box,color=blue];
		j2213463000 -> j2225864321;
		j2213463000 -> j3264497638;
	j3414175637 [label="Oui……我明白其中的逻辑。如果可以的话，我也会努力修复他们的家庭，non ？这似乎是我们所有人离开这里的唯一希望。 ",shape=box,color=blue];
		j3414175637 -> j363203367;
	j3525273577 [label="殁世械灵或许没有灵魂，但他很独特。其他中枢，比如奥塔，都有灵魂。它们在诞生之初就被毁坏了。",shape=box,color=red];
		j3525273577 -> j342639224;
	j4039724246 [label="你说得对。那么你希望我做什么呢？",shape=box,color=red];
		j4039724246 -> j2540561;
	j2570519757 [label="你说得对，他们确实没有。但这并不意味着我们可以随意虐待他们。",shape=box,color=red];
		j2570519757 -> j429833228;
	j3932088812 [label="我不知道你说的是不是对的。但他们仍能思考，能感受，我们不能把他们当成物品来对待。",shape=box,color=red];
		j3932088812 -> j4067733200;
	j800266365 [label="殁世械灵有灵魂。所有中枢都有。",shape=box,color=red];
		j800266365 -> j1529552548;
	j2225864321 [label="其实这不是我做出的决定。",shape=box,color=red];
		j2225864321 -> j2848476491;
	j3264497638 [label="我其实有个朋友很喜欢老鼠。我也觉得它们很可爱。",shape=box,color=red];
		j3264497638 -> j2823565881;
	j363203367 [label="以免我们余生都被困在这里，comme des rats d'égout。 ",shape=box,color=blue];
		j363203367 -> j2497667013;
		j363203367 -> j4176358174;
	j342639224 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j342639224 -> j1133482747;
	j2540561 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j2540561 -> j2422997513;
	j429833228 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j429833228 -> j2792848557;
	j4067733200 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
		j4067733200 -> j1485163047;
	j1529552548 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j1529552548 -> j3826636279;
	j2848476491 [label="我知道。是否让自己被世人知道，是洛德先生，以及所有人的决定。",shape=box,color=blue];
		j2848476491 -> j2276748949;
	j2823565881 [label="+15 Chemistry",color=orange];
		j2823565881 -> j348271994;
	j2497667013 [label="我是有点疏忽了。你说得对。我会开始着手去做。",shape=box,color=red];
		j2497667013 -> j3604686625;
	j4176358174 [label="我其实有个朋友很喜欢老鼠。我也觉得它们很可爱。",shape=box,color=red];
		j4176358174 -> j833829015;
	j1133482747 [label="+5 Chemistry",color=orange];
		j1133482747 -> j2571410502;
	j2422997513 [label="哦，千万别以为我让你残忍 ！Non ！要珍惜他们，因为他们很宝贵，他们变成现在这个样子并非他们的错！",shape=box,color=blue];
		j2422997513 -> j2519192608;
	j2792848557 [label="+5 Chemistry",color=orange];
		j2792848557 -> j2422997513;
	j1485163047 [label="+5 Chemistry",color=orange];
		j1485163047 -> j2239609412;
	j3826636279 [label="+5 Chemistry",color=orange];
		j3826636279 -> j2105880618;
	j2276748949 [label="我认为，将我们困守于此的并非崇高情操，而是负罪感。",shape=box,color=blue];
		j2276748949 -> j928245160;
	j348271994 [label="我也很想哪天见一下那位朋友，但这不是我要说的重点，傻狼。",shape=box,color=blue];
		j348271994 -> j2276748949;
	j3604686625 [label="+5 Chemistry",color=orange];
		j3604686625 -> j1167897228;
	j833829015 [label="+5 Chemistry",color=orange];
		j833829015 -> j348271994;
	j2571410502 [label="这进一步证明对恶魔及其同类的谴责是正确的。不过，或许你对奥塔及其同类的看法也是正确的，又或许相信这一点能给你带来内心的平安。",shape=box,color=blue];
		j2571410502 -> j2618772831;
	j2519192608 [label="让我心痛的，是那些被奥罗金恶魔留下的残骸。他们不是神，而是吞噬一切的凶手。看看与我们同行的那一位就知道了。",shape=box,color=blue];
		j2519192608 -> j3417516841;
	j2239609412 [label="也许你是对的，但我不认为那些奥罗金恶魔比我们更了解灵魂的事情。他们并不是什么伟大的神。",shape=box,color=blue];
		j2239609412 -> j3543054741;
	j2105880618 [label="也许你是对的，也许相信这一点，能让你感到平安。",shape=box,color=blue];
		j2105880618 -> j3417516841;
	j928245160 [label="我们是在躲避某种重大而可怕的罪。",shape=box,color=blue];
		j928245160 -> j3551028550;
	j1167897228 [label="谢谢。我不知道你是否会成功，但有时候，我们能做的只有去尝试。",shape=box,color=blue];
		j1167897228 -> j2276748949;
	j2618772831 [label="无论如何，我更愿相信，那个早已去世的奥塔，如果你能善待承载了他生命的殁世械灵先生，那么他也会微笑吧。",shape=box,color=blue];
		j2618772831 -> j1531393501;
	j3417516841 [label="只是当洛德就站在殁世械灵旁边时，我很难说殁世械灵真的有灵魂，oui ？",shape=box,color=blue];
		j3417516841 -> j2618772831;
	j3543054741 [label="科技，也许是——科学，是——但灵魂 ？他们连自己的内心都无法掌控 ！如果你还需要更多证据，看看那个与我们同行的恶魔就知道了。",shape=box,color=blue];
		j3543054741 -> j3417516841;
	j3551028550 [label="而正是那份罪需要被宽恕。",shape=box,color=blue];
		j3551028550 -> j3176761270;
	j1531393501 [label="Check boolean LoidFamilyComplete",color=orange];
		j1531393501 -> j2863611458 [label=true,color=green];
