		767 -> 771;
	777 [label="你当时怎么做的 ？",shape=box,color=red];
		777 -> 781;
	778 [label="奥黛特修女是谁 ？",shape=box,color=red];
		778 -> 782;
	776 [label="Pauvre petit……",shape=box,color=blue];
		776 -> 780;
	772 [label="Par les Luminaires……请继续说。",shape=box,color=blue];
		772 -> 752;
	771 [label="Par les Luminaires……你是说我们都在这里秘密活动？！所以才不让我们离开这里？！Mais pourquoi？！",shape=box,color=blue];
		771 -> 775;
	781 [label="我还能怎么办 ？我把椅子移到桌子旁边的一个空位上，和她和垫子一起喝茶。",shape=box,color=blue];
		781 -> 787;
	782 [label="恐怕奥黛特修女已经去世三十年了。",shape=box,color=blue];
		782 -> 788;
	780 [label="因此，他被转移到了这个主要的殁世械灵——唯一剩下的殁世械灵——并且……嗯？这很难解释。",shape=box,color=red];
		780 -> 784;
		780 -> 785;
		780 -> 786;
	775 [label="是因为他的女儿欧拉瑞娅——人称“母亲”，以及她的家人，一直都在照顾着火卫二。",shape=box,color=red];
		775 -> 779;
	787 [label="当她给我讲她过去的故事时，我们一起笑得很开心。塞西莉亚修女从未告诉过任何人这些故事，至少据我所知没有。",shape=box,color=blue];
		787 -> 791;
	788 [label="我把椅子移到桌子旁边的一个空位上，和她和垫子一起喝茶。",shape=box,color=blue];
		788 -> 787;
	784 [label="说实话，我真希望我们能修复他。把真正的奥塔带回来。",shape=box,color=red];
		784 -> 754;
	785 [label="他能让我笑。他很有趣，但背后却隐藏着一些悲伤和破碎的东西。",shape=box,color=red];
		785 -> 754;
	786 [label="可惜的是，他已经变不回去了。而且我觉得他挺让人心烦的。 ",shape=box,color=red];
		786 -> 754;
	779 [label="守护着这个地方，以及那颗向始源星系输送虚空能量的心脏，自英择谛离开后，它始终维系着我们所有人的……存续。",shape=box,color=red];
		779 -> 783;
	791 [label="她的眼睛有时明亮，有时暗淡，就像孩子的洋娃娃……",shape=box,color=blue];
		791 -> 794;
		791 -> 795;
		791 -> 796;
		791 -> 797;
