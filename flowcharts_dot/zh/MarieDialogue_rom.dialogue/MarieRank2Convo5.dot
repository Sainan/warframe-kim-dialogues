		740 -> 744;
	749 [label="请讲。",shape=box,color=red];
		749 -> 754;
	748 [label="[结束]",shape=box,color=red];
		748 -> 753;
	747 [label="当然。",shape=box,color=red];
		747 -> 752;
	746 [label="也许以后吧。[结束]",shape=box,color=red];
		746 -> 751;
	745 [label="我好奇他后面为何还刻着另一张脸，那模样活像小朋友的涂鸦。",shape=box,color=blue];
		745 -> 750;
	744 [label="Chat ends.",color=orange];
	754 [label="Cathédrale 里有一位修女，她曾经迷失在她过去的回忆中。她就是塞西莉亚修女。",shape=box,color=blue];
		754 -> 757;
	753 [label="Chat ends.",color=orange];
	752 [label="众所周知，他是一位天才，也是驾驭氩结晶的幕后推手。",shape=box,color=red];
		752 -> 756;
	751 [label="Chat ends.",color=orange];
	750 [label="我分别询问了殁世械灵先生和洛德先生，但两人都避而不谈此事，只告诉我一个名字：奥塔。他们说出这个名字时，语气中带着深深的悲伤。",shape=box,color=blue];
		750 -> 755;
	757 [label="她常常站在大厅里的大钟前，宣称现在是下午两点，但其实并她不知道具体时间。",shape=box,color=blue];
		757 -> 761;
	756 [label="这些力量源自虚空——正是它们让我们能够制造出众多强大的战甲与武器。",shape=box,color=red];
		756 -> 760;
	755 [label="所以我在这里和你交谈，希望你能帮助我。",shape=box,color=blue];
		755 -> 758;
		755 -> 759;
	761 [label="我们往往会发现走廊里的所有画都摆错了方向，她说它们在向她低声讲述可怕的阴谋。",shape=box,color=blue];
		761 -> 766;
	760 [label="他专攻晶体学。他的研究成果都保存在这里的实验室里。",shape=box,color=red];
		760 -> 765;
	758 [label="你想了解奥塔吗？还是想知道为什么你无法和他交谈？",shape=box,color=red];
		758 -> 762;
	759 [label="奥塔​的​事情​很​难​解释……",shape=box,color=red];
		759 -> 2919;
	766 [label="后来我们了解到她只是听到了其他房间里的谈话，并以为是画作在说话……",shape=box,color=blue];
		766 -> 770;
	765 [label="后来不知道是什么原因，他被改造成了一个中枢，并获得了自己的殁世械灵外壳。",shape=box,color=red];
		765 -> 769;
	762 [label="我想我终究都会去了解这两者，但开始从哪里由你决定。après tout，我也不知道哪一个更重要。",shape=box,color=blue];
		762 -> 2919;
	2919 [label="Check boolean LoidFamilyComplete",color=orange];
		2919 -> 764 [label=true,color=green];
		2919 -> 764 [label=false,color=brown];
		2919 -> 763 [label=false,color=brown];
	770 [label="有一次，她甚至把休息室里的所有垫子都当成了孩子，并招待它们喝茶……",shape=box,color=blue];
		770 -> 774;
	769 [label="不是所有中枢都是因刑罚而被造的。但当时火卫二这边的情况……变得很糟糕，他受了重伤。",shape=box,color=red];
		769 -> 773;
	764 [label="奥塔曾是一位哲士、奥罗金科学家和学者。关于他的经历，实在算不上一个幸福的故事。",shape=box,color=red];
		764 -> 768;
	763 [label="嗯……简而言之，英择谛家族有几位在楼上，而他们……完全不知道我们就在楼下。",shape=box,color=red];
		763 -> 767;
	774 [label="当我走进房间时，她抬头看着我说道：“哦，奥黛特修女，你来了 ！孤儿院的孩子们来了，你要一起吗？”",shape=box,color=blue];
		774 -> 777;
		774 -> 778;
	773 [label="+5 Chemistry",color=orange];
		773 -> 776;
