		3189 -> 3193;
	3188 [label="我知道你不确定中枢是否有灵魂——但我只能向双耀神祈祷……愿可怜的奥塔不要受苦。",shape=box,color=blue];
		3188 -> 3192;
	3187 [label="我只能向双耀神祈祷，愿那外壳里剩下的只有……只有科学和闪烁的光。",shape=box,color=blue];
		3187 -> 3191;
	3194 [label="为什么要把他留在那里，让他痛苦地等待死亡，直到他死去才能获得安宁？我只能祈祷……如果那里真的有某种存在——",shape=box,color=blue];
		3194 -> 3197;
	3193 [label="并且没有灵魂被困在那破碎的躯壳里，只有等待着最终死去才能获得安宁。",shape=box,color=blue];
		3193 -> 3196;
	3192 [label="愿没有灵魂被困在那破碎的躯壳里，只有等待着最终死去才能获得安宁。",shape=box,color=blue];
		3192 -> 3195;
	3191 [label="并且没有灵魂被困在那破碎的躯壳里，只有等待着最终死去才能获得安宁。",shape=box,color=blue];
		3191 -> 3195;
	3197 [label="愿那是因为他自己选择留下来，作为一个孤独的守夜人……",shape=box,color=blue];
		3197 -> 3200;
	3196 [label="因为如果你错了呢，那个灵魂是被迫被困在那个牢笼里呢？",shape=box,color=blue];
		3196 -> 3199;
	3195 [label="或者，如果那里真的有他的存在，愿那是因为他选择留下来，以某种孤独的方式守望。",shape=box,color=blue];
		3195 -> 3198;
