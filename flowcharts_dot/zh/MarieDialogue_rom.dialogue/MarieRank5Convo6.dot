		j3097375491 -> j2181352629 [label=true,color=green];
		j3097375491 -> j3732789320 [label=false,color=brown];
	j1189358805 [label="狼 ！我的狼 ！我见到奥塔了 ！我终于见到他了 ！",shape=box,color=blue];
		j1189358805 -> j2047570814;
		j1189358805 -> j3260095162;
	j1477544383 [label="我见到奥塔了 ！我终于见到他了 ！",shape=box,color=blue];
		j1477544383 -> j2047570814;
		j1477544383 -> j3260095162;
	j2181352629 [label="狼 ！我的狼 ！殁世械灵先生背上的那张脸 ！我终于见到他了 ！",shape=box,color=blue];
		j2181352629 -> j1277940077;
		j2181352629 -> j597377144;
		j2181352629 -> j1701296392;
	j3732789320 [label="殁世械灵先生背上的那张脸 ！我终于见到他了 ！",shape=box,color=blue];
		j3732789320 -> j1277940077;
		j3732789320 -> j597377144;
		j3732789320 -> j1701296392;
	j2047570814 [label="你们聊得怎么样？",shape=box,color=red];
		j2047570814 -> j1500363743;
	j3260095162 [label="你喜欢和他聊天吗？",shape=box,color=red];
		j3260095162 -> j1257761934;
	j1277940077 [label="你见到奥塔了？我的天……你们见面怎么样？",shape=box,color=red];
		j1277940077 -> j2990107904;
	j597377144 [label="很高兴你们终于见面了。奥塔的情况可能有点难解释。",shape=box,color=red];
		j597377144 -> j655403139;
	j1701296392 [label="可怜的奥塔……结果怎么样？",shape=box,color=red];
		j1701296392 -> j3208960978;
	j1500363743 [label="在同一个对话中，他……向我介绍了三次，仿佛我们从未互相认识过一样。",shape=box,color=blue];
		j1500363743 -> j2431108394;
	j1257761934 [label="喜欢。不过我当时有点想哭。因为在同一个对话中，他……向我介绍了三次，仿佛我们从未互相认识过一样。",shape=box,color=blue];
		j1257761934 -> j2431108394;
	j2990107904 [label="为什么听上去你并不怎么高兴我见到他 ？",shape=box,color=blue];
		j2990107904 -> j1866337013;
		j2990107904 -> j3076906992;
		j2990107904 -> j2096476004;
	j655403139 [label="是的，我也这么觉得。一个潦草的孩子笔迹写在机器的背面。我觉得他真是可爱又迷人 ！",shape=box,color=blue];
		j655403139 -> j2841371740;
	j3208960978 [label="我觉得他非常可爱迷人！但在这层幽默之下，我却感到无比心痛。",shape=box,color=blue];
		j3208960978 -> j1154147944;
	j2431108394 [label="他​像​之前​一样，​毫​不​犹豫、​兴高​采烈​地​迎接​我。​不过​他​居然​认出​我​是​一​位​ S​œur de Sol ！​",shape=box,color=blue];
		j2431108394 -> j3697350283;
	j1866337013 [label="我很抱歉。他有时候确实挺让人恼火的。这不是他的错。",shape=box,color=red];
		j1866337013 -> j1228906297;
	j3076906992 [label="我不是那个意思。他只是可能有点……让人难以接受。",shape=box,color=red];
		j3076906992 -> j1228906297;
	j2096476004 [label="他有时候还挺烦人的，仅此而已。 ",shape=box,color=red];
		j2096476004 -> j302023592;
	j2841371740 [label="但幽默之下，却隐藏着巨大的伤痛。",shape=box,color=blue];
		j2841371740 -> j1154147944;
	j1154147944 [label="你能告诉我那个可怜的奥塔先生的故事吗？",shape=box,color=blue];
		j1154147944 -> j3179398628;
	j3697350283 [label="实际上，他对双耀神了解颇多 ！我们聊了很多，聊了那些他称之为“奥罗金帝国之前”的“古代宗教”。",shape=box,color=blue];
		j3697350283 -> j4050773209;
	j1228906297 [label="我希望大家能对他保持友善和耐心。但愿我们都能蒙受太阳神的恩典。",shape=box,color=blue];
		j1228906297 -> j248827182;
	j302023592 [label="我希望你能对这位明显体弱多病的人更加友善。毕竟，我们最终都只能仰赖太阳神的恩典。",shape=box,color=blue];
		j302023592 -> j248827182;
	j3179398628 [label="奥塔曾是一位哲士、奥罗金科学家和学者。关于他的经历，实在算不上一个幸福的故事。",shape=box,color=red];
		j3179398628 -> j1683547388;
	j4050773209 [label="虽然他说很多这类知识现在都已遗失，深埋在档案馆里，而且是绝对禁止查阅的。他让我发誓保密。",shape=box,color=blue];
		j4050773209 -> j2029927345;
	j248827182 [label="这样的命运可能发生在任何人身上，包括你。",shape=box,color=blue];
		j248827182 -> j714614685;
		j248827182 -> j3984705937;
	j1683547388 [label="众所周知，他是一位天才，也是驾驭氩结晶的幕后推手。",shape=box,color=red];
		j1683547388 -> j3009667636;
	j2029927345 [label="他告诉我，他非常担心执行者 Ballas（虽然我不知道他是谁）可能会发现我的异端教派，并处决我。",shape=box,color=blue];
		j2029927345 -> j2320075248;
		j2029927345 -> j537004814;
	j714614685 [label="我很抱歉，我实在没有多余的时间花在他身上。",shape=box,color=red];
		j714614685 -> j530205863;
	j3984705937 [label="你​说​得​对，​对​不起，​我​不​是​故意​的。​",shape=box,color=red];
		j3984705937 -> j1154147944;
	j3009667636 [label="这些力量源自虚空——正是它们让我们能够制造出众多强大的战甲与武器。",shape=box,color=red];
		j3009667636 -> j2256080833;
	j2320075248 [label="那……是不会发生的。继续说。",shape=box,color=red];
		j2320075248 -> j3235845888;
	j537004814 [label="Ballas 早​就​死​了​……​继续​说。​",shape=box,color=red];
		j537004814 -> j3235845888;
	j530205863 [label="那我真抱歉我浪费了更多。",shape=box,color=blue];
		j530205863 -> j3007723528;
	j2256080833 [label="他专攻晶体学。他的研究成果都保存在这里的实验室里。",shape=box,color=red];
		j2256080833 -> j1471554700;
	j3235845888 [label="+5 Chemistry",color=orange];
		j3235845888 -> j513709421;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j1471554700 [label="后来不知道是什么原因，他被改造成了一个中枢，并获得了自己的殁世械灵外壳。",shape=box,color=red];
		j1471554700 -> j1209984094;
	j513709421 [label="我当时也是这么想的……嗯，他问我来自哪里，当我告诉他之后，他笑了，说“不，这不可能！我应该知道，因为我——”",shape=box,color=blue];
		j513709421 -> j1742062777;
	j1209984094 [label="不是所有中枢都是因刑罚而被造的。但当时火卫二这边的情况……变得很糟糕，他受了重伤。",shape=box,color=red];
		j1209984094 -> j2761182189;
	j1742062777 [label="然后他……又向我做了自我介绍，并问我是不是带着矿物样本从平野过来……",shape=box,color=blue];
		j1742062777 -> j1404461840;
		j1742062777 -> j571707397;
	j2761182189 [label="Pauvre petit……",shape=box,color=blue];
		j2761182189 -> j1698645168;
	j1404461840 [label="哦，玛丽。我真抱歉……",shape=box,color=red];
		j1404461840 -> j2537734436;
	j571707397 [label="没错……奥塔就是这样。",shape=box,color=red];
		j571707397 -> j2537734436;
	j1698645168 [label="Boolean MarieOtak1 is now true.",color=orange];
		j1698645168 -> j2047570814;
		j1698645168 -> j3260095162;
	j2537734436 [label="想到对他无能为力，我的心都要碎了。",shape=box,color=blue];
		j2537734436 -> j1970966774;
	j1970966774 [label="Evaluate expressions",color=orange];
		j1970966774 -> j1757393267 [label="MarieCephalonSoul",color=purple];
		j1970966774 -> j2272178778 [label="MarieCephalonNoSoul",color=purple];
		j1970966774 -> j2889595641 [label="MarieCephalonUnsure",color=purple];
		j1970966774 -> j2157307681 [label="false",color=purple];
	j1757393267 [label="哦，双耀神——你们为他创造了何等的地狱，将他的灵魂囚禁在科学和闪烁光芒的牢笼之中 ？",shape=box,color=blue];
		j1757393267 -> j3206762777;
	j2272178778 [label="我只能向双耀神祈祷，愿你是对的，愿那外壳里剩下的只有……只有科学和闪烁的光。",shape=box,color=blue];
		j2272178778 -> j1380090974;
	j2889595641 [label="我知道你不确定中枢是否有灵魂——但我只能向双耀神祈祷……愿可怜的奥塔不要受苦。",shape=box,color=blue];
		j2889595641 -> j2177779373;
	j2157307681 [label="我只能向双耀神祈祷，愿那外壳里剩下的只有……只有科学和闪烁的光。",shape=box,color=blue];
		j2157307681 -> j243758475;
	j3206762777 [label="为什么要把他留在那里，让他痛苦地等待死亡，直到他死去才能获得安宁？我只能祈祷……如果那里真的有某种存在——",shape=box,color=blue];
		j3206762777 -> j977646707;
	j1380090974 [label="并且没有灵魂被困在那破碎的躯壳里，只有等待着最终死去才能获得安宁。",shape=box,color=blue];
		j1380090974 -> j2589844355;
	j2177779373 [label="愿没有灵魂被困在那破碎的躯壳里，只有等待着最终死去才能获得安宁。",shape=box,color=blue];
		j2177779373 -> j1129984991;
	j243758475 [label="并且没有灵魂被困在那破碎的躯壳里，只有等待着最终死去才能获得安宁。",shape=box,color=blue];
		j243758475 -> j1129984991;
	j977646707 [label="愿那是因为他自己选择留下来，作为一个孤独的守夜人……",shape=box,color=blue];
		j977646707 -> j547400123;
	j2589844355 [label="因为如果你错了呢，那个灵魂是被迫被困在那个牢笼里呢？",shape=box,color=blue];
		j2589844355 -> j3622264215;
	j1129984991 [label="或者，如果那里真的有他的存在，愿那是因为他选择留下来，以某种孤独的方式守望。",shape=box,color=blue];
		j1129984991 -> j547400123;
	j547400123 [label="否则，人便不免要质疑众神是否真的仁慈，non ？",shape=box,color=blue];
		j547400123 -> j734760191;
	j3622264215 [label="那就足以让人质疑众神的仁慈，non ？",shape=box,color=blue];
		j3622264215 -> j734760191;
	j734760191 [label="那我又该置身何处呢？",shape=box,color=blue];
		j734760191 -> j1699539697;
	j1699539697 [label="请原谅我，我……je suis mélancolique aujourd'hui。",shape=box,color=blue];
		j1699539697 -> j4190999030;
