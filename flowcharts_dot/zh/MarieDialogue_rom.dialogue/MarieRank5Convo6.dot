	3213 [label="Oui，你说得对。确实如此。像奥塔先生这样的故事比比皆是，世上还有许多比他更悲惨的故事。我不该只为一个故事哭泣。 ",shape=box,color=blue];
		3213 -> 3217;
	3214 [label="Merci。嗯，我不想再这样了。我要去做些更快乐的事情 ！我觉得斐波那契先生的鱼缸该除尘了。",shape=box,color=blue];
