		j4190999030 -> j3534626873 [label="false",color=purple];
		j4190999030 -> j487352961 [label="false",color=purple];
	j1440862444 [label="我​能​做些​什么​让​你​开心​起来​呢？​我们​要​不​要​去​捉​弄罗瑟。​",shape=box,color=red];
		j1440862444 -> j3515906909;
	j1712730381 [label="我能做些什么让你开心起来呢？比如偷些糕点？",shape=box,color=red];
		j1712730381 -> j2824528155;
	j3534626873 [label="玛丽，​有时候​神​就​是​很​残酷。​这​就​是​人生。​",shape=box,color=red];
		j3534626873 -> j1178717568;
	j487352961 [label="没关系，你有充分的理由感到难过。",shape=box,color=red];
		j487352961 -> j3659672140;
	j3515906909 [label="+15 Chemistry",color=orange];
		j3515906909 -> j1809623265;
	j2824528155 [label="+20 Chemistry",color=orange];
		j2824528155 -> j1809623265;
	j1178717568 [label="+5 Chemistry",color=orange];
		j1178717568 -> j51623970;
	j3659672140 [label="+20 Chemistry",color=orange];
		j3659672140 -> j2218092552;
	j1809623265 [label="哈 ！Merci。这下我肯定能止住这些傻眼泪了。你真会哄傻乎乎的小玛丽开心，Non ？",shape=box,color=blue];
		j1809623265 -> j2917878630;
		j1809623265 -> j2348867484;
	j51623970 [label="Oui，你说得对。确实如此。像奥塔先生这样的故事比比皆是，世上还有许多比他更悲惨的故事。我不该只为一个故事哭泣。 ",shape=box,color=blue];
		j51623970 -> j1588060082;
	j2218092552 [label="Merci。嗯，我不想再这样了。我要去做些更快乐的事情 ！我觉得斐波那契先生的鱼缸该除尘了。",shape=box,color=blue];
		j2218092552 -> j2425134241;
	j2917878630 [label="你一点也不傻。我也有同感。",shape=box,color=red];
		j2917878630 -> j2235898819;
	j2348867484 [label="这是至少是我能为你做的事。",shape=box,color=red];
		j2348867484 -> j2235898819;
	j1588060082 [label="然而，我却坐在这里，做着这样的事情。谢谢你提醒我有多愚蠢。呸 ！傻女孩玛丽。嗯……我想斐波那契先生的鱼缸该除尘了。",shape=box,color=blue];
		j1588060082 -> j2425134241;
