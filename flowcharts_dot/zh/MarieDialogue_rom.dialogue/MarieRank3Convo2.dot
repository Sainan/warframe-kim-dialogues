digraph {
	"MarieRank3Convo2 begins." [color=orange];
		"MarieRank3Convo2 begins." -> j3102612293;
	j3102612293 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3102612293 -> j369807617;
	j369807617 [label="Check boolean LoidFamilyComplete",color=orange];
		j369807617 -> j2807002784 [label=true,color=green];
		j369807617 -> j1668831657 [label=false,color=brown];
	j2807002784 [label="希望你不会觉得我问这个问题很无礼，但我真的很好奇。你有信仰吗 ？比如信奉双耀神还是其他什么宗教 ？",shape=box,color=blue];
		j2807002784 -> j3674091088;
	j1668831657 [label="Check boolean MarieFamily1",color=orange];
		j1668831657 -> j4205129476 [label=true,color=green];
		j1668831657 -> j4073208857 [label=false,color=brown];
	j3674091088 [label="曾有过这些对话……见过这些人……可这明明是不可能的，对吧 ？",shape=box,color=blue];
		j3674091088 -> j3810803667;
	j4205129476 [label="你能告诉我更多关于主教家族的事吗 ？我很想知道他的过去。",shape=box,color=blue];
		j4205129476 -> j658054599;
		j4205129476 -> j309447118;
		j4205129476 -> j1038552372;
	j4073208857 [label="你能告诉我关于主教家族的事吗 ？我很想知道他的过去。",shape=box,color=blue];
		j4073208857 -> j658054599;
		j4073208857 -> j309447118;
		j4073208857 -> j1038552372;
	j3810803667 [label="+20 Chemistry",color=orange];
		j3810803667 -> j3787659588;
	j658054599 [label="我会告诉你我所知道的一切，但恐怕我知道的没有你想象的那么多。",shape=box,color=red];
		j658054599 -> j3697341380;
	j309447118 [label="哦。当然，不过……去和洛德谈这个更合适吧 ？",shape=box,color=red];
		j309447118 -> j1634231825;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j3787659588 [label="我们称之为 déjà vu。一定是血清和时间旅行的缘故。C’est la vie ！",shape=box,color=blue];
		j3787659588 -> "Chat ends.";
	j3697341380 [label="无论你告诉我什么，我都会珍惜。Promis ！",shape=box,color=blue];
		j3697341380 -> j2899562834;
	j1634231825 [label="提起主教……对洛德先生来说似乎是件很痛苦的事。我不太想老提这件事。",shape=box,color=blue];
		j1634231825 -> j2899562834;
	"Chat ends." [color=orange];
	j2899562834 [label="尤其是当我谈起这些事时，是带着愉悦的，而其他人似乎没有。",shape=box,color=blue];
		j2899562834 -> j4224721830;
		j2899562834 -> j1644360602;
	j4224721830 [label="你想了解谁 ？",shape=box,color=red];
		j4224721830 -> j2213147742;
	j1644360602 [label="嗯，楼上有“母亲”、“父亲”、“儿子”、“女儿”和“祖母”。",shape=box,color=red];
		j1644360602 -> j2213147742;
	j2213147742 [label="先一个一个来，好吗 ？每次我这么问，恶魔都会笑我，就好像这是个他自己的梗。Grand-mère。“祖母”。",shape=box,color=blue];
		j2213147742 -> j1300978633;
	j1300978633 [label="她并不是主教的妻子，non ？",shape=box,color=blue];
		j1300978633 -> j1859851619;
	j1859851619 [label="不，她是“父亲”的母亲。“母亲”的婆婆。",shape=box,color=red];
		j1859851619 -> j2778800013;
	j2778800013 [label="Je……vois。还有……为什么他们不用自己的名字呢 ？Ne serait-ce pas plus simple ？",shape=box,color=blue];
		j2778800013 -> j3300854917;
		j2778800013 -> j2649397317;
	j3300854917 [label="你想听长一点的版本吗 ？",shape=box,color=red];
		j3300854917 -> j742925674;
	j2649397317 [label="那我给你一个简短的版本。",shape=box,color=red];
		j2649397317 -> j3784431256;
	j742925674 [label="Oui ！反正我暂时也没别的地方可去。",shape=box,color=blue];
		j742925674 -> j2885786201;
	j3784431256 [label="奥罗金帝国分崩离析时，楼上的家族被困在这里。“儿子”，也就是英择谛的孙子，将感染者引入了这里。",shape=box,color=red];
		j3784431256 -> j3070755372;
	j2885786201 [label="好吧，我们现在位于一颗名为火卫二的卫星上。很久以前，为了驱逐 Sentient，这里曾引爆过一枚生化炸弹。",shape=box,color=red];
		j2885786201 -> j1998571468;
	j3070755372 [label="Par 太阳神 ！是故意的吗 ？",shape=box,color=blue];
		j3070755372 -> j2753523360;
	j1998571468 [label="就是当年奥罗金与之交战的那些敌人 ？是我们在深溯池看到的与恶魔交战那些敌人，oui ？",shape=box,color=blue];
		j1998571468 -> j159745288;
	j2753523360 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j2753523360 -> j47630582 [label=true,color=green];
		j2753523360 -> j3686957791 [label=true,color=green];
		j2753523360 -> j3686957791 [label=false,color=brown];
		j2753523360 -> j2859655006 [label=false,color=brown];
	j159745288 [label="是的。他们试图利用感染者来对抗 Sentient。但火卫二被彻底吞噬了。他们只能把自己封锁在我们上方的殁世幽都里避难。",shape=box,color=red];
		j159745288 -> j4121381151;
	j47630582 [label="不，​应该​是​个​意外。​我​觉得​他​是​出于​好意。​",shape=box,color=red];
		j47630582 -> j1861303104;
	j3686957791 [label="我还不知道真相，但我会保留意见，直到了解更多信息。",shape=box,color=red];
		j3686957791 -> j1861303104;
	j2859655006 [label="我还不知道真相，但我可以告诉你，他很傲慢。",shape=box,color=red];
		j2859655006 -> j251522152;
	j4121381151 [label="然而，“儿子”，英择谛的孙子，却一心想保育和研究被感染的动物。",shape=box,color=red];
		j4121381151 -> j2640318944;
	j1861303104 [label="+10 Chemistry",color=orange];
		j1861303104 -> j62372490;
	j251522152 [label="真可耻。为了他，也为了我们，我希望这不是真的。请继续。",shape=box,color=blue];
		j251522152 -> j4107227458;
	j2640318944 [label="哦，太阳神……他是出于好意吗 ？",shape=box,color=blue];
		j2640318944 -> j2755410679;
	j62372490 [label="你真是太好了。Continuez，s'il vous plaît。",shape=box,color=blue];
		j62372490 -> j4107227458;
	j4107227458 [label="嗯，他们被困在殁世幽都，悲痛欲绝，没有奥罗金帝国来拯救他们，就在这时感染者又开始入侵了……",shape=box,color=red];
		j4107227458 -> j1811002770;
	j2755410679 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j2755410679 -> j3202160623 [label=true,color=green];
		j2755410679 -> j397200968 [label=true,color=green];
		j2755410679 -> j2010211175 [label=true,color=green];
		j2755410679 -> j3202160623 [label=false,color=brown];
		j2755410679 -> j397200968 [label=false,color=brown];
		j2755410679 -> j1094782420 [label=false,color=brown];
	j1811002770 [label="他们互相反目，从内到外互相撕扯。剩下的就由感染者完成了。就连他们的名字都被夺走了。 ",shape=box,color=red];
		j1811002770 -> j2672296437;
	j3202160623 [label="是的，我相信他是。他的确关心这些生物。",shape=box,color=red];
		j3202160623 -> j196878635;
	j397200968 [label="可悲的是，这已经不重要了，鲁莽已经造成了破坏。",shape=box,color=red];
		j397200968 -> j848745077;
	j2010211175 [label="不，是傲慢驱使了他。哪怕他声称这只是一场意外。",shape=box,color=red];
		j2010211175 -> j251522152;
	j1094782420 [label="我还不知道真相，但我可以告诉你，他很傲慢。",shape=box,color=red];
		j1094782420 -> j251522152;
	j2672296437 [label="没有名字，这是最残酷的事……",shape=box,color=blue];
		j2672296437 -> j482800561;
	j196878635 [label="+10 Chemistry",color=orange];
		j196878635 -> j2473617095;
	j848745077 [label="+5 Chemistry",color=orange];
		j848745077 -> j2519991816;
	j482800561 [label="Boolean MarieFamily2 is now true.",color=orange];
		j482800561 -> j576648086;
		j482800561 -> j4212480064;
		j482800561 -> j136193981;
	j2473617095 [label="我不知道他会怎么看科维兽……可惜他不能见到它们……",shape=box,color=blue];
		j2473617095 -> j1161038874;
		j2473617095 -> j3079850955;
	j2519991816 [label="如果一个人的动机纯粹就能决定一切，那么世界将会是一个美丽的地方，non ？C'est la vie。",shape=box,color=blue];
		j2519991816 -> j3381786185;
	j576648086 [label="除非你是自己送人，就像“祖母”那样。",shape=box,color=red];
		j576648086 -> j1194809661;
	j4212480064 [label="其实这并没有那么糟糕，你会习惯的。",shape=box,color=red];
		j4212480064 -> j1351130798;
	j136193981 [label="动物没有名字，它们看起来却非常快乐。我们给它们起名字，只是为了满足我们自己。",shape=box,color=red];
		j136193981 -> j1896651087;
	j1161038874 [label="这个想法有点好笑。其实我觉得这不太明智。",shape=box,color=red];
		j1161038874 -> j2709820766;
	j3079850955 [label="我希望会有这样一天。我真的希望。",shape=box,color=red];
		j3079850955 -> j3948333923;
	j3381786185 [label="Et ensuite ？",shape=box,color=blue];
		j3381786185 -> j4107227458;
	j1194809661 [label="+5 Chemistry",color=orange];
		j1194809661 -> j3924302083;
	j1351130798 [label="啊啊 ！Quelle horreur ！我不是故意的 ！哦，实在是太丢脸了 ！对不起，请原谅我，我不是故意的——哦，我是个傻瓜 ！",shape=box,color=blue];
		j1351130798 -> j2707207870;
		j1351130798 -> j2538576835;
	j1896651087 [label="+5 Chemistry",color=orange];
		j1896651087 -> j185542592;
	j2709820766 [label="为什么呢 ？",shape=box,color=blue];
		j2709820766 -> j2681296990;
		j2709820766 -> j3986859566;
	j3948333923 [label="Add 1 to Family counter",color=orange];
		j3948333923 -> j1827137725;
	j3924302083 [label="现在她听起来像是一位我会很想见到的女士…… ",shape=box,color=blue];
		j3924302083 -> j1721036519;
	j2707207870 [label="你要怎样补偿我呢 ？",shape=box,color=red];
		j2707207870 -> j1454486382;
	j2538576835 [label="没事，我只是开玩笑而已，我没有生气。",shape=box,color=red];
		j2538576835 -> j1778312279;
	j185542592 [label="确实如此 ！我从来没这么想过。而能够选择属于自己的名字。也是一种自由。",shape=box,color=blue];
		j185542592 -> j1721036519;
	j2681296990 [label="恐怕一半的人会把另一半人当成“另一个家族”。",shape=box,color=red];
		j2681296990 -> j3782553599;
	j3986859566 [label="楼上的情况……即使在最好的情况下也依旧脆弱。我不想让他们难过。",shape=box,color=red];
		j3986859566 -> j2111826692;
	j1827137725 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j1827137725 -> j149740023 [label=true,color=green];
		j1827137725 -> j3696617613 [label=false,color=brown];
	j1721036519 [label="这次谈话真是精彩，不过恐怕轮到我准备午餐了。洛德​先生​正​在​教​我​如何​像​他​那样​端​茶 ！",shape=box,color=blue];
		j1721036519 -> "Chat ends.";
	j1454486382 [label="Maintenant，vous parlez aussi mal que le diable。不，我不会中你的诡计。",shape=box,color=blue];
		j1454486382 -> "Chat ends.";
	j1778312279 [label="+5 Chemistry",color=orange];
		j1778312279 -> j4037147666;
	j3782553599 [label="Add 1 to Family counter",color=orange];
		j3782553599 -> j147952371;
	j2111826692 [label="灵魂的韧性会让人惊叹。而如今我身边的存在，都如此古老，如此饱经时间的磨砺。",shape=box,color=blue];
		j2111826692 -> j1222465852;
	j149740023 [label="这是可以做到的。或许比你想象的还要简单。我们只需要想想怎么做。 ",shape=box,color=blue];
		j149740023 -> j2656251451;
		j149740023 -> j3986859566;
	j3696617613 [label="Oui ？你和你那个小小的复制品还有上面的家族情况怎么样了 ？",shape=box,color=blue];
		j3696617613 -> j2902492687;
		j3696617613 -> j3986859566;
	j4037147666 [label="哦，太阳神，loué soi ！不过，这倒是引出了一个问题……你知道你的绰号是怎么来的吗？“漂泊者” ？",shape=box,color=blue];
		j4037147666 -> j3489914184;
		j4037147666 -> j3217245989;
	j147952371 [label="+5 Chemistry",color=orange];
		j147952371 -> j2986277448;
	j1222465852 [label="+5 Chemistry",color=orange];
		j1222465852 -> j3897902047;
	j2656251451 [label="我们只能小心一点。恐怕一半的人会把另一半人当成“另一个家族”。",shape=box,color=red];
		j2656251451 -> j3782553599;
	j2902492687 [label="慢且小心翼翼。恐怕一半的人会把另一半人当成“另一个家族”。",shape=box,color=red];
		j2902492687 -> j3782553599;
	j3489914184 [label="我希望这是我自己选的。",shape=box,color=red];
		j3489914184 -> j1456669326;
	j3217245989 [label="老实说，我不记得了。",shape=box,color=red];
		j3217245989 -> j757233144;
	j2986277448 [label="哦……太阳神啊，我想你可能已经解决了 ！",shape=box,color=blue];
		j2986277448 -> j2810638451;
	j3897902047 [label="你已经让他们惊喜过很多次了。就让他们给你一次惊喜吧。",shape=box,color=blue];
		j3897902047 -> j3877306272;
	j1456669326 [label="那该有多自由啊 ！可以自己选名字。在 Cathédrale 里，我连自己的衣服都不能选。哈哈 ！",shape=box,color=blue];
		j1456669326 -> j1721036519;
	j757233144 [label="你的身上充满了 mystères ！ ",shape=box,color=blue];
		j757233144 -> j1721036519;
	j2810638451 [label="Boolean MarieFamilyOther is now true.",color=orange];
		j2810638451 -> j3891970862;
	j3877306272 [label="不过，拜托，s'il vous plaît，请你继续你的故事。你的小狼玛丽在正式狩猎之前，肯定得先了解她的猎物，non ？",shape=box,color=blue];
		j3877306272 -> j2661353111;
		j3877306272 -> j2432063958;
		j3877306272 -> j1186195113;
	j3891970862 [label="我很兴奋——je suis assise ici，remuant sur ma chaise ！",shape=box,color=blue];
		j3891970862 -> j3877306272;
	j2661353111 [label="我说到哪了 ？",shape=box,color=red];
		j2661353111 -> j3572578794;
	j2432063958 [label="你这样是不是有点太坏了 ？",shape=box,color=red];
		j2432063958 -> j1052444208;
	j1186195113 [label="或许我希望你来狩猎我……",shape=box,color=red];
		j1186195113 -> j1297179325;
	j3572578794 [label="“儿子”把 Animaux Infestés 请得太近了。",shape=box,color=blue];
		j3572578794 -> j4107227458;
	j1052444208 [label="Peut-être ！但是以善的名义做一点坏事又有什么害处呢，嗯 ？",shape=box,color=blue];
		j1052444208 -> j1053420989;
		j1052444208 -> j4091869154;
	j1297179325 [label="Boolean DrifterMarie is now true.",color=orange];
		j1297179325 -> j2245681203;
	j1053420989 [label="好吧……无论怎样，回到故事。",shape=box,color=red];
		j1053420989 -> j4107227458;
	j4091869154 [label="别误会。我喜欢这样。",shape=box,color=red];
		j4091869154 -> j1414793380;
	j2245681203 [label="你真是要害惨我了 ！我忍不住尖叫了一声，洛德先生问我有没有事。我只好撒谎说我看到了老鼠，结果他告诉我，这个时代根本没有老鼠 ！",shape=box,color=blue];
		j2245681203 -> j1437223074;
	j1414793380 [label="哈 ！我就知道你喜欢。好了，别再胡闹了，回到你的故事。“儿子”把 Animaux Infestés 引得太近了，oui ？",shape=box,color=blue];
		j1414793380 -> j4107227458;
	j1437223074 [label="+5 Chemistry",color=orange];
		j1437223074 -> j2968875325;
	j2968875325 [label="Quelle méchanceté，tu es terrible ！Je te déteste et tu me fais rougir maintenant ！",shape=box,color=blue];
		j2968875325 -> j400705752;
		j2968875325 -> j1053420989;
	j400705752 [label="你是在对我生气吗？",shape=box,color=red];
		j400705752 -> j1663271002;
	j1663271002 [label="Non ！继续说你的故事 ！",shape=box,color=blue];
		j1663271002 -> j4107227458;
}