digraph {
	1015 [label="MarieRank3Convo2 begins.",color=orange];
		1015 -> 3736;
	3736 [label="Update boolean MarieLyonAvailable",color=orange];
		3736 -> 2923;
	2923 [label="Check boolean LoidFamilyComplete",color=orange];
		2923 -> 2924 [label=true,color=green];
		2923 -> 1016 [label=false,color=brown];
	2924 [label="希望你不会觉得我问这个问题很无礼，但我真的很好奇。你有信仰吗 ？比如信奉双耀神还是其他什么宗教 ？",shape=box,color=blue];
		2924 -> 2925;
	1016 [label="Check boolean MarieFamily1",color=orange];
		1016 -> 1017 [label=true,color=green];
		1016 -> 1018 [label=false,color=brown];
	2925 [label="曾有过这些对话……见过这些人……可这明明是不可能的，对吧 ？",shape=box,color=blue];
		2925 -> 2926;
	1017 [label="你能告诉我更多关于主教家族的事吗 ？我很想知道他的过去。",shape=box,color=blue];
		1017 -> 1020;
		1017 -> 1021;
		1017 -> 1019;
	1018 [label="你能告诉我关于主教家族的事吗 ？我很想知道他的过去。",shape=box,color=blue];
		1018 -> 1020;
		1018 -> 1021;
		1018 -> 1019;
	2926 [label="+20 Chemistry",color=orange];
		2926 -> 2927;
	1020 [label="我会告诉你我所知道的一切，但恐怕我知道的没有你想象的那么多。",shape=box,color=red];
		1020 -> 1023;
	1021 [label="哦。当然，不过……去和洛德谈这个更合适吧 ？",shape=box,color=red];
		1021 -> 1024;
	1019 [label="[结束]",shape=box,color=red];
		1019 -> 1022;
	2927 [label="我们称之为 déjà vu。一定是血清和时间旅行的缘故。C’est la vie ！",shape=box,color=blue];
		2927 -> 2928;
	1023 [label="无论你告诉我什么，我都会珍惜。Promis ！",shape=box,color=blue];
		1023 -> 1025;
	1024 [label="提起主教……对洛德先生来说似乎是件很痛苦的事。我不太想老提这件事。",shape=box,color=blue];
		1024 -> 1025;
	1022 [label="Chat ends.",color=orange];
	2928 [label="Chat ends.",color=orange];
	1025 [label="尤其是当我谈起这些事时，是带着愉悦的，而其他人似乎没有。",shape=box,color=blue];
		1025 -> 1026;
		1025 -> 1027;
	1026 [label="你想了解谁 ？",shape=box,color=red];
		1026 -> 1028;
	1027 [label="嗯，楼上有“母亲”、“父亲”、“儿子”、“女儿”和“祖母”。",shape=box,color=red];
		1027 -> 1028;
	1028 [label="先一个一个来，好吗 ？每次我这么问，恶魔都会笑我，就好像这是个他自己的梗。Grand-mère。“祖母”。",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="她并不是主教的妻子，non ？",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="不，她是“父亲”的母亲。“母亲”的婆婆。",shape=box,color=red];
		1030 -> 1031;
	1031 [label="Je……vois。还有……为什么他们不用自己的名字呢 ？Ne serait-ce pas plus simple ？",shape=box,color=blue];
		1031 -> 1032;
		1031 -> 1033;
	1032 [label="你想听长一点的版本吗 ？",shape=box,color=red];
		1032 -> 1034;
	1033 [label="那我给你一个简短的版本。",shape=box,color=red];
		1033 -> 1035;
	1034 [label="Oui ！反正我暂时也没别的地方可去。",shape=box,color=blue];
		1034 -> 1036;
	1035 [label="奥罗金帝国分崩离析时，楼上的家族被困在这里。“儿子”，也就是英择谛的孙子，将感染者引入了这里。",shape=box,color=red];
		1035 -> 1037;
	1036 [label="好吧，我们现在位于一颗名为火卫二的卫星上。很久以前，为了驱逐 Sentient，这里曾引爆过一枚生化炸弹。",shape=box,color=red];
		1036 -> 1038;
	1037 [label="Par 太阳神 ！是故意的吗 ？",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="就是当年奥罗金与之交战的那些敌人 ？是我们在深溯池看到的与恶魔交战那些敌人，oui ？",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1039 -> 1041 [label=true,color=green];
		1039 -> 1042 [label=true,color=green];
		1039 -> 1042 [label=false,color=brown];
		1039 -> 1043 [label=false,color=brown];
	1040 [label="是的。他们试图利用感染者来对抗 Sentient。但火卫二被彻底吞噬了。他们只能把自己封锁在我们上方的殁世幽都里避难。",shape=box,color=red];
		1040 -> 1044;
	1041 [label="不，​应该​是​个​意外。​我​觉得​他​是​出于​好意。​",shape=box,color=red];
		1041 -> 1045;
	1042 [label="我还不知道真相，但我会保留意见，直到了解更多信息。",shape=box,color=red];
		1042 -> 1045;
	1043 [label="我还不知道真相，但我可以告诉你，他很傲慢。",shape=box,color=red];
		1043 -> 1046;
	1044 [label="然而，“儿子”，英择谛的孙子，却一心想保育和研究被感染的动物。",shape=box,color=red];
		1044 -> 1047;
	1045 [label="+10 Chemistry",color=orange];
		1045 -> 1048;
	1046 [label="真可耻。为了他，也为了我们，我希望这不是真的。请继续。",shape=box,color=blue];
		1046 -> 1049;
	1047 [label="哦，太阳神……他是出于好意吗 ？",shape=box,color=blue];
		1047 -> 1076;
	1048 [label="你真是太好了。Continuez，s'il vous plaît。",shape=box,color=blue];
		1048 -> 1049;
	1049 [label="嗯，他们被困在殁世幽都，悲痛欲绝，没有奥罗金帝国来拯救他们，就在这时感染者又开始入侵了……",shape=box,color=red];
		1049 -> 1053;
	1076 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1076 -> 1051 [label=true,color=green];
		1076 -> 1052 [label=true,color=green];
		1076 -> 1055 [label=true,color=green];
		1076 -> 1051 [label=false,color=brown];
		1076 -> 1052 [label=false,color=brown];
		1076 -> 1054 [label=false,color=brown];
	1053 [label="他们互相反目，从内到外互相撕扯。剩下的就由感染者完成了。就连他们的名字都被夺走了。 ",shape=box,color=red];
		1053 -> 1058;
	1051 [label="是的，我相信他是。他的确关心这些生物。",shape=box,color=red];
		1051 -> 1056;
	1052 [label="可悲的是，这已经不重要了，鲁莽已经造成了破坏。",shape=box,color=red];
		1052 -> 1057;
	1055 [label="不，是傲慢驱使了他。哪怕他声称这只是一场意外。",shape=box,color=red];
		1055 -> 1059;
	1054 [label="我还不知道真相，但我可以告诉你，他很傲慢。",shape=box,color=red];
		1054 -> 1059;
	1058 [label="没有名字，这是最残酷的事……",shape=box,color=blue];
		1058 -> 1062;
	1056 [label="+10 Chemistry",color=orange];
		1056 -> 1060;
	1057 [label="+5 Chemistry",color=orange];
		1057 -> 1061;
	1059 [label="真可耻。为了他，也为了我们，我希望这不是真的。请继续。",shape=box,color=blue];
		1059 -> 1049;
	1062 [label="Update boolean MarieFamily2",color=orange];
		1062 -> 1066;
		1062 -> 1067;
		1062 -> 1068;
	1060 [label="我不知道他会怎么看科维兽……可惜他不能见到它们……",shape=box,color=blue];
		1060 -> 1063;
		1060 -> 1064;
	1061 [label="如果一个人的动机纯粹就能决定一切，那么世界将会是一个美丽的地方，non ？C'est la vie。",shape=box,color=blue];
		1061 -> 1065;
	1066 [label="除非你是自己送人，就像“祖母”那样。",shape=box,color=red];
		1066 -> 1071;
	1067 [label="其实这并没有那么糟糕，你会习惯的。",shape=box,color=red];
		1067 -> 1072;
	1068 [label="动物没有名字，它们看起来却非常快乐。我们给它们起名字，只是为了满足我们自己。",shape=box,color=red];
		1068 -> 1073;
	1063 [label="这个想法有点好笑。其实我觉得这不太明智。",shape=box,color=red];
		1063 -> 1069;
	1064 [label="我希望会有这样一天。我真的希望。",shape=box,color=red];
		1064 -> 1070;
	1065 [label="Et ensuite ？",shape=box,color=blue];
		1065 -> 1049;
	1071 [label="+5 Chemistry",color=orange];
		1071 -> 1077;
	1072 [label="啊啊 ！Quelle horreur ！我不是故意的 ！哦，实在是太丢脸了 ！对不起，请原谅我，我不是故意的——哦，我是个傻瓜 ！",shape=box,color=blue];
		1072 -> 1078;
		1072 -> 1079;
	1073 [label="+5 Chemistry",color=orange];
		1073 -> 1080;
	1069 [label="为什么呢 ？",shape=box,color=blue];
		1069 -> 1074;
		1069 -> 1075;
	1070 [label="Add 1 to Family",color=orange];
		1070 -> 1050;
	1077 [label="现在她听起来像是一位我会很想见到的女士…… ",shape=box,color=blue];
		1077 -> 1085;
	1078 [label="你要怎样补偿我呢 ？",shape=box,color=red];
		1078 -> 1086;
	1079 [label="没事，我只是开玩笑而已，我没有生气。",shape=box,color=red];
		1079 -> 1087;
	1080 [label="确实如此 ！我从来没这么想过。而能够选择属于自己的名字。也是一种自由。",shape=box,color=blue];
		1080 -> 1085;
	1074 [label="恐怕一半的人会把另一半人当成“另一个家族”。",shape=box,color=red];
		1074 -> 1081;
	1075 [label="楼上的情况……即使在最好的情况下也依旧脆弱。我不想让他们难过。",shape=box,color=red];
		1075 -> 1082;
	1050 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1050 -> 1083 [label=true,color=green];
		1050 -> 1084 [label=false,color=brown];
	1085 [label="这次谈话真是精彩，不过恐怕轮到我准备午餐了。洛德​先生​正​在​教​我​如何​像​他​那样​端​茶 ！",shape=box,color=blue];
		1085 -> 1094;
	1086 [label="Maintenant，vous parlez aussi mal que le diable。不，我不会中你的诡计。",shape=box,color=blue];
		1086 -> 1095;
	1087 [label="+5 Chemistry",color=orange];
		1087 -> 1096;
	1081 [label="Add 1 to Family",color=orange];
		1081 -> 1088;
	1082 [label="灵魂的韧性会让人惊叹。而如今我身边的存在，都如此古老，如此饱经时间的磨砺。",shape=box,color=blue];
		1082 -> 1089;
	1083 [label="这是可以做到的。或许比你想象的还要简单。我们只需要想想怎么做。 ",shape=box,color=blue];
		1083 -> 1090;
		1083 -> 1091;
	1084 [label="Oui ？你和你那个小小的复制品还有上面的家族情况怎么样了 ？",shape=box,color=blue];
		1084 -> 1092;
		1084 -> 1093;
	1094 [label="Chat ends.",color=orange];
	1095 [label="Chat ends.",color=orange];
	1096 [label="哦，太阳神，loué soi ！不过，这倒是引出了一个问题……你知道你的绰号是怎么来的吗？“漂泊者” ？",shape=box,color=blue];
		1096 -> 1099;
		1096 -> 1100;
	1088 [label="+5 Chemistry",color=orange];
		1088 -> 1097;
	1089 [label="+5 Chemistry",color=orange];
		1089 -> 1098;
	1090 [label="我们只能小心一点。恐怕一半的人会把另一半人当成“另一个家族”。",shape=box,color=red];
		1090 -> 1081;
	1091 [label="楼上的情况……即使在最好的情况下也依旧脆弱。我不想让他们难过。",shape=box,color=red];
		1091 -> 1082;
	1092 [label="慢且小心翼翼。恐怕一半的人会把另一半人当成“另一个家族”。",shape=box,color=red];
		1092 -> 1081;
	1093 [label="楼上的情况……即使在最好的情况下也依旧脆弱。我不想让他们难过。",shape=box,color=red];
		1093 -> 1082;
	1099 [label="我希望这是我自己选的。",shape=box,color=red];
		1099 -> 1103;
	1100 [label="老实说，我不记得了。",shape=box,color=red];
		1100 -> 1104;
	1097 [label="哦……太阳神啊，我想你可能已经解决了 ！",shape=box,color=blue];
		1097 -> 1101;
	1098 [label="你已经让他们惊喜过很多次了。就让他们给你一次惊喜吧。",shape=box,color=blue];
		1098 -> 1102;
	1103 [label="那该有多自由啊 ！可以自己选名字。在 Cathédrale 里，我连自己的衣服都不能选。哈哈 ！",shape=box,color=blue];
		1103 -> 1085;
	1104 [label="你的身上充满了 mystères ！ ",shape=box,color=blue];
		1104 -> 1085;
	1101 [label="Update boolean MarieFamilyOther",color=orange];
		1101 -> 1105;
	1102 [label="不过，拜托，s'il vous plaît，请你继续你的故事。你的小狼玛丽在正式狩猎之前，肯定得先了解她的猎物，non ？",shape=box,color=blue];
		1102 -> 1106;
		1102 -> 1107;
		1102 -> 3914;
	1105 [label="我很兴奋——je suis assise ici，remuant sur ma chaise ！",shape=box,color=blue];
		1105 -> 1102;
	1106 [label="我说到哪了 ？",shape=box,color=red];
		1106 -> 1108;
	1107 [label="你这样是不是有点太坏了 ？",shape=box,color=red];
		1107 -> 1109;
	3914 [label="或许我希望你来狩猎我……",shape=box,color=red];
		3914 -> 3915;
	1108 [label="“儿子”把 Animaux Infestés 请得太近了。",shape=box,color=blue];
		1108 -> 1049;
	1109 [label="Peut-être ！但是以善的名义做一点坏事又有什么害处呢，嗯 ？",shape=box,color=blue];
		1109 -> 1110;
		1109 -> 1111;
	3915 [label="Update boolean DrifterMarie",color=orange];
		3915 -> 3913;
	1110 [label="好吧……无论怎样，回到故事。",shape=box,color=red];
		1110 -> 1049;
	1111 [label="别误会。我喜欢这样。",shape=box,color=red];
		1111 -> 1112;
	3913 [label="你真是要害惨我了 ！我忍不住尖叫了一声，洛德先生问我有没有事。我只好撒谎说我看到了老鼠，结果他告诉我，这个时代根本没有老鼠 ！",shape=box,color=blue];
		3913 -> 3916;
	1112 [label="哈 ！我就知道你喜欢。好了，别再胡闹了，回到你的故事。“儿子”把 Animaux Infestés 引得太近了，oui ？",shape=box,color=blue];
		1112 -> 1049;
	3916 [label="+5 Chemistry",color=orange];
		3916 -> 3917;
	3917 [label="Quelle méchanceté，tu es terrible ！Je te déteste et tu me fais rougir maintenant ！",shape=box,color=blue];
		3917 -> 3918;
		3917 -> 3919;
	3918 [label="你是在对我生气吗？",shape=box,color=red];
		3918 -> 3920;
	3919 [label="好吧……无论怎样，回到故事。",shape=box,color=red];
		3919 -> 1049;
	3920 [label="Non ！继续说你的故事 ！",shape=box,color=blue];
		3920 -> 1049;
