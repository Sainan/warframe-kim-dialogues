digraph {
	"MarieRank2Convo1 begins." [color=orange];
		"MarieRank2Convo1 begins." -> j1357457165;
	j1357457165 [label="希望你不会觉得我问这个问题很无礼，但我真的很好奇。你有信仰吗 ？比如信奉双耀神还是其他什么宗教。",shape=box,color=blue];
		j1357457165 -> j4123248830;
		j1357457165 -> j1032182061;
		j1357457165 -> j1038552372;
	j4123248830 [label="如果我说我更喜欢你呢？那样做算不算亵渎神明？",shape=box,color=red];
		j4123248830 -> j628110459;
	j1032182061 [label="不，这完全不失礼。",shape=box,color=red];
		j1032182061 -> j2154545265;
		j1032182061 -> j2597653906;
		j1032182061 -> j2400706541;
		j1032182061 -> j4240153500;
		j1032182061 -> j3147917826;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j628110459 [label="Boolean DrifterMarie is now true.",color=orange];
		j628110459 -> j987385389;
	j2154545265 [label="这……有点复杂。我相信世间有某种存在，但我并没有一个确切的信仰。",shape=box,color=red];
		j2154545265 -> j3711478567;
	j2597653906 [label="是的，我有信仰，尽管你可能不知道。",shape=box,color=red];
		j2597653906 -> j3628501973;
	j2400706541 [label="我和你一样，信双耀神。",shape=box,color=red];
		j2400706541 -> j121768548;
	j4240153500 [label="不，我没有。我不信神。那只是我们还不懂的科学。",shape=box,color=red];
		j4240153500 -> j307796249;
	j3147917826 [label="说实话，我不知道。我觉得这个世界太复杂了，我找不到答案。",shape=box,color=red];
		j3147917826 -> j471440481;
	"Chat ends." [color=orange];
	j987385389 [label="啊，oui ？这是什么话？Quelle audace，我真没想到你会这样 ！我完全没想到……",shape=box,color=blue];
		j987385389 -> j2585046881;
	j3711478567 [label="Boolean DrifterFaithPersonal is now true.",color=orange];
		j3711478567 -> j3534282161;
	j3628501973 [label="+5 Chemistry",color=orange];
		j3628501973 -> j109458011;
	j121768548 [label="+5 Chemistry",color=orange];
		j121768548 -> j2829273199;
	j307796249 [label="+5 Chemistry",color=orange];
		j307796249 -> j3677927874;
	j471440481 [label="Boolean DrifterFaithAgnostic is now true.",color=orange];
		j471440481 -> j139011238;
	j2585046881 [label="但你是在试图转移我的注意力 ！虽然我不反对，但现在谈这种事还太早了，n'est pas ？",shape=box,color=blue];
		j2585046881 -> j3716000148;
	j3534282161 [label="+5 Chemistry",color=orange];
		j3534282161 -> j2189391136;
	j109458011 [label="无论信仰以何种名称出现，我都能在其中发现美。告诉我，它是新诞生的？还是古老的？我能认出它吗？",shape=box,color=blue];
		j109458011 -> j1100193192;
		j109458011 -> j1551921576;
	j2829273199 [label="你竟然信 ！哦，comme c'est fascinant ！想到在那么遥远的未来，仍有人抱有如此坚定的信仰，cela remplit mon cœur de joie。我太高兴了。不过我觉得这可能与你过去的经历有关，对吗？啊，没关系。",shape=box,color=blue];
		j2829273199 -> j2844290171;
	j3677927874 [label="我尊重你的回答。但我必须问一句，你怎么这么肯定 ？这难道不是一种信仰吗？你们那个 Indifférence……如果不是神，那又是什么呢 ？",shape=box,color=blue];
		j3677927874 -> j2738766712;
		j3677927874 -> j1739431925;
		j3677927874 -> j567466146;
	j139011238 [label="+10 Chemistry",color=orange];
		j139011238 -> j177782418;
	j3716000148 [label="我……还是想请你回答我的问题，s'il vous plait，如果你不介意的话。不过现在你让我都脸红了 ！",shape=box,color=blue];
		j3716000148 -> j2154545265;
		j3716000148 -> j2597653906;
		j3716000148 -> j2400706541;
		j3716000148 -> j4240153500;
		j3716000148 -> j3147917826;
	j2189391136 [label="啊，oui。你是个流浪者，正如你的名字那样。你见识过许多文化，许多信仰，许多世界。Cela est très spirituel，non ？你像捡贝壳一样把它们的一部分收集起来。",shape=box,color=blue];
		j2189391136 -> j1421501614;
		j2189391136 -> j1631154659;
	j1100193192 [label="我认为你根本不会认出它，一定不会。",shape=box,color=red];
		j1100193192 -> j3564351768;
	j1551921576 [label="你也许会认出其中的一部分，但其他部分对你来说可能完全陌生。",shape=box,color=red];
		j1551921576 -> j672551609;
	j2844290171 [label="我想知道，你是虔诚地信奉其中一方，还是寻求平衡？",shape=box,color=blue];
		j2844290171 -> j3177011021;
		j2844290171 -> j3364304831;
		j2844290171 -> j3434948774;
	j2738766712 [label="我不确定自己是否完全正确，没人能确定。但我个人依然不相信神的存在。",shape=box,color=red];
		j2738766712 -> j1358062875;
	j1739431925 [label="我认为宗教的存在是为了填补人们生命中对死亡和未知恐惧所留下的空洞。",shape=box,color=red];
		j1739431925 -> j411011651;
	j567466146 [label="我不知道虚空无情之物是什么，但它不是神。我们只需要弄清楚它的本质。 ",shape=box,color=red];
		j567466146 -> j3927154658;
	j177782418 [label="啊，这或许是最智慧的答案 ！我们这些凡人——如果我们还能自称是凡人的话——又怎能妄图描绘神的旨意 ？",shape=box,color=blue];
		j177782418 -> j1106152527;
	j1421501614 [label="我认为还有某种更古老、更真实、更深远的存在在与我们所有人对话。某种程度上，就像联结的组织一样。",shape=box,color=red];
		j1421501614 -> j3567835435;
	j1631154659 [label="正是。我从每一种信仰都看到了各自的美好，我不知道谁对谁错。",shape=box,color=red];
		j1631154659 -> j3567835435;
	j3564351768 [label="Boolean DrifterFaithYesForeign is now true.",color=orange];
		j3564351768 -> j3668711563;
	j672551609 [label="Boolean DrifterFaithYesSimilar is now true.",color=orange];
		j672551609 -> j1960204358;
	j3177011021 [label="我想我更加被太阳神所吸引。 ",shape=box,color=red];
		j3177011021 -> j743606075;
	j3364304831 [label="我想我更加被月神所吸引。 ",shape=box,color=red];
		j3364304831 -> j782853893;
	j3434948774 [label="我追求平衡。我认为这才是万物的自然规律。",shape=box,color=red];
		j3434948774 -> j731036724;
	j1358062875 [label="Boolean DrifterFaithNoMaybe is now true.",color=orange];
		j1358062875 -> j1399649135;
	j411011651 [label="Boolean DrifterFaithNoFear is now true.",color=orange];
		j411011651 -> j3384931160;
	j3927154658 [label="Boolean DrifterFaithNoMITW is now true.",color=orange];
		j3927154658 -> j2424896756;
	j1106152527 [label="我常常坐在我的 Cathédrale 圣所里，兴高采烈地与那些陌生的慕道友聊天。",shape=box,color=blue];
		j1106152527 -> j1154900507;
	j3567835435 [label="+5 Chemistry",color=orange];
		j3567835435 -> j3256736824;
	j3668711563 [label="+5 Chemistry",color=orange];
		j3668711563 -> j630439807;
	j1960204358 [label="+5 Chemistry",color=orange];
		j1960204358 -> j2940584687;
	j743606075 [label="Boolean DrifterFaithSol is now true.",color=orange];
		j743606075 -> j1107953219;
	j782853893 [label="Boolean DrifterFaithLua is now true.",color=orange];
		j782853893 -> j1420064358;
	j731036724 [label="Boolean DrifterFaithBalance is now true.",color=orange];
		j731036724 -> j2207900524;
	j1399649135 [label="Oui，je vois……你或许需要你自己的“证据”才能确定？你的生命中有没有发生过什么事，让你产生如此强烈的情感，就像我们感受到的信仰和火热一样？",shape=box,color=blue];
		j1399649135 -> j3949286359;
		j1399649135 -> j2619279079;
	j3384931160 [label="O​ui，​c'est vrai ​—— 确实。​信仰​解答​了​无数人​的​疑问。​难道​你​不​惧怕​死​后​会​发生​什么​吗 ？​",shape=box,color=blue];
		j3384931160 -> j1017781447;
		j3384931160 -> j2748331807;
	j2424896756 [label="Comme c'est fascinant……现在有两个人重复着同样的话……恶魔也低声说了同样的话。",shape=box,color=blue];
		j2424896756 -> j3717982780;
	j1154900507 [label="他们对我们的信仰感到好奇，但又不想说“是的，是的，这就是真理。”我只希望我能给他们带来一些我们的喜乐。",shape=box,color=blue];
		j1154900507 -> j2058568781;
		j1154900507 -> j2703137324;
	j3256736824 [label="Je comprends et c'est magnifique。我常常在想，双耀神是否曾以其他面孔、以其他名字示人。",shape=box,color=blue];
		j3256736824 -> j120740836;
	j630439807 [label="哦，comme c'est fascinant ！我真希望有一天能了解你们的信仰，听听你们的仪式。",shape=box,color=blue];
		j630439807 -> j847578843;
		j630439807 -> j630136848;
	j2940584687 [label="哦，comme c'est fascinant ！真希望有一天听到它为何如此相似却又如此不同。",shape=box,color=blue];
		j2940584687 -> j847578843;
		j2940584687 -> j630136848;
	j1107953219 [label="+10 Chemistry",color=orange];
		j1107953219 -> j3382650455;
	j1420064358 [label="+5 Chemistry",color=orange];
		j1420064358 -> j3318661319;
	j2207900524 [label="+5 Chemistry",color=orange];
		j2207900524 -> j2906950745;
	j3949286359 [label="不，我就是不信。",shape=box,color=red];
		j3949286359 -> j853768259;
	j2619279079 [label="没错。我从未……“感受”过信仰。或者说，我不需要它。",shape=box,color=red];
		j2619279079 -> j1344466720;
	j1017781447 [label="人​都​会​死。​害怕​死亡​是​愚蠢​的。​死亡会​来​找到​我们。​或者​至少……​它​本​该​如此。​",shape=box,color=red];
		j1017781447 -> j3687667936;
	j2748331807 [label="我已经死了够多次了。我不惧怕死后的一切，我反而渴望死后的一切。",shape=box,color=red];
		j2748331807 -> j855468835;
	j3717982780 [label="+5 Chemistry",color=orange];
		j3717982780 -> j1854531724;
	j2058568781 [label="我​有点惊讶​你​竟然会​对不信你们信仰的人​保持​开放​态度。​",shape=box,color=red];
		j2058568781 -> j1721610179;
	j2703137324 [label="就是这样。我并不想说哪个是“对”或“错”。",shape=box,color=red];
		j2703137324 -> j3283538633;
	j120740836 [label="众所周知，他们会为了与其他教派的信徒更亲近而改变自己的形象。但这是我的信仰，不是你的。",shape=box,color=blue];
		j120740836 -> j379487327;
	j847578843 [label="我​也​希望。​",shape=box,color=red];
		j847578843 -> j2275772802;
	j630136848 [label="我​很​惊讶​你​竟然会​对​其他​宗教​保持​开放​态度。​",shape=box,color=red];
		j630136848 -> j1636095272;
	j3382650455 [label="真是个与我志同道合的流浪者 ！你太让我开心了。希望你没有为了讨好我而撒谎。",shape=box,color=blue];
		j3382650455 -> j1830604943;
	j3318661319 [label="啊，流浪者就像我亲爱的里昂一样，追寻着夜色的足迹。等他准备好了，你应该跟他聊聊他那位暗夜女士之道，他一定会欣喜若狂的。",shape=box,color=blue];
		j3318661319 -> j1830604943;
	j2906950745 [label="平衡而不犹豫。能在人生旅途中，知道太阳何时升起，月亮何时回应，却又永远不会陷入怀疑 ？",shape=box,color=blue];
		j2906950745 -> j3993824079;
	j853768259 [label="+5 Chemistry",color=orange];
		j853768259 -> j837116546;
	j1344466720 [label="+5 Chemistry",color=orange];
		j1344466720 -> j1908118714;
	j3687667936 [label="+5 Chemistry",color=orange];
		j3687667936 -> j1445675181;
	j855468835 [label="+5 Chemistry",color=orange];
		j855468835 -> j1766241267;
	j1854531724 [label="我​实在​是​难​以​相信​他，​但​在​这​件​事​上​ ？​或许​你​应该​跟​他​谈谈。​只是​要​小心。​恶魔玩​的​可是​危险​的​游戏。​",shape=box,color=blue];
		j1854531724 -> j2669805933;
		j1854531724 -> j1063410780;
	j1721610179 [label="我想，这或许会让人感到惊讶，发现一个身披圣袍的人对别人的要求并不严格。我发现，向那些不寻求慰藉的人传教，往往会招人嫌。",shape=box,color=blue];
		j1721610179 -> j1716220990;
	j3283538633 [label="+5 Chemistry",color=orange];
		j3283538633 -> j2690077181;
	j379487327 [label="我只希望你的信仰，能带给你平安 ？",shape=box,color=blue];
		j379487327 -> j2344029014;
		j379487327 -> j3485995624;
		j379487327 -> j1966635911;
	j2275772802 [label="Ô joie ！我常常在想，双耀神是否曾以其他面孔、以其他名字示人。",shape=box,color=blue];
		j2275772802 -> j2880630363;
	j1636095272 [label="我想，这或许会让人感到惊讶，发现一个身披圣袍的人对别人的要求并不严格。我发现，向那些不寻求慰藉的人传教，往往会招人嫌。",shape=box,color=blue];
		j1636095272 -> j2475609082;
	j1830604943 [label="我只是想问，我们的信仰能给你带来平安吗 ？",shape=box,color=blue];
		j1830604943 -> j2344029014;
		j1830604943 -> j3485995624;
		j1830604943 -> j1966635911;
	j3993824079 [label="那是罕见的天赋……我希望你能拥有。若在十字路口徘徊太久，恐怕会被纷争吞噬。",shape=box,color=blue];
		j3993824079 -> j2924613100;
	j837116546 [label="那​你​活得​一定​更​简单。不用受神明和教会的规矩约束。我承认我有点嫉妒。",shape=box,color=blue];
		j837116546 -> j3174231734;
	j1908118714 [label="那我真羡慕你，流浪者！活了这么长时间，竟然没有认识神的需要。",shape=box,color=blue];
		j1908118714 -> j3174231734;
	j1445675181 [label="你​听​起来​像​是​月神​的​信徒，​我​并​无​冒犯​之意。​Oui，​老妇​终究会​来​找到​我们，​并​流下​她​银色​的​泪水。​但​你​的​话​让​我​在​想……​",shape=box,color=blue];
		j1445675181 -> j3578169394;
	j1766241267 [label="是的，这让我不禁想知道。我看着你，那个孩子，那个恶魔，甚至洛德先生，或者主教……在你们身后，都跨越了多少个世纪。",shape=box,color=blue];
		j1766241267 -> j1883673858;
	j2669805933 [label="什么样的危险游戏？",shape=box,color=red];
		j2669805933 -> j1824585328;
	j1063410780 [label="他也不相信墙中人是真的？",shape=box,color=red];
		j1063410780 -> j1594483072;
	j1716220990 [label="+5 Chemistry",color=orange];
		j1716220990 -> j3752012520;
	j2690077181 [label="我为你对他人信仰的展现智慧和善良感到欣慰。",shape=box,color=blue];
		j2690077181 -> j3635011985;
	j2344029014 [label="它并没有带给我平安。",shape=box,color=red];
		j2344029014 -> j3631941428;
	j3485995624 [label="说实话我没想太多。",shape=box,color=red];
		j3485995624 -> j3839625582;
	j1966635911 [label="它有​带给​我​平安。​",shape=box,color=red];
		j1966635911 -> j2887791112;
	j2880630363 [label="众所周知，他们会为了与其他教派的信徒更亲近而改变自己的形象。但这是我的信仰，不是你的。我不会向那些不寻求慰藉的人传教。因为我发现这样往往会招人嫌。",shape=box,color=blue];
		j2880630363 -> j2475609082;
	j2475609082 [label="不，我的信仰属于我，而你的信仰属于你。我只是希望它能给你带来平安 ？",shape=box,color=blue];
		j2475609082 -> j2344029014;
		j2475609082 -> j3485995624;
		j2475609082 -> j1966635911;
	j2924613100 [label="最终，每个人都必须选择一条要走的路。但十字路口是我们所有人的起点，平衡，才是一切构筑的基石。",shape=box,color=blue];
		j2924613100 -> j2606588142;
	j3174231734 [label="只是，我想问……这种不信会给你带来平安吗？",shape=box,color=blue];
		j3174231734 -> j2344029014;
		j3174231734 -> j3485995624;
		j3174231734 -> j1966635911;
	j3578169394 [label="你说“它​本​该​如此”找到​我们，你指的是谁？我看着你，那个孩子，那个恶魔，甚至洛德先生，或者主教……在你们身后，都跨越了多少个世纪。",shape=box,color=blue];
		j3578169394 -> j1883673858;
	j1883673858 [label="我想知道，在月神降临之前，我们还要经历多少个世纪。我也想知道，当那一天到来时，我又会如何热切地拥抱她。但那是我的信仰，不是你的。",shape=box,color=blue];
		j1883673858 -> j3174231734;
	j1824585328 [label="我还不知道。他像个善于伪装的恶魔一样，把阴谋都藏在心里。不过他不信神。或许，只信他自己。",shape=box,color=blue];
		j1824585328 -> j3174231734;
	j1594483072 [label="不，他不信。他跟你很像，不信任何神。或许，只信他自己。",shape=box,color=blue];
		j1594483072 -> j3174231734;
	j3752012520 [label="Non，任何带着开放心态的人都会得到开放的怀抱。",shape=box,color=blue];
		j3752012520 -> j3635011985;
	j3635011985 [label="我只是想问，这能给你带来平安吗 ？",shape=box,color=blue];
		j3635011985 -> j2344029014;
		j3635011985 -> j3485995624;
		j3635011985 -> j1966635911;
	j3631941428 [label="Boolean DrifterFaithNoPeace is now true.",color=orange];
		j3631941428 -> j1341502026;
	j3839625582 [label="+10 Chemistry",color=orange];
		j3839625582 -> j4015889553;
	j2887791112 [label="+10 Chemistry",color=orange];
		j2887791112 -> j3171639148;
	j2606588142 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j2606588142 -> j2896456126;
	j1341502026 [label="+10 Chemistry",color=orange];
		j1341502026 -> j3034264704;
	j4015889553 [label="我心中的嫉妒几乎要将我吞没。如果你允许的话，我……很想再和你聊聊这件事。我并不是想说教，也不想打探你的隐私。我只是不想让你难过。",shape=box,color=blue];
		j4015889553 -> j1313766957;
	j3171639148 [label="这样，我知道不管你有没有向我所信仰的太阳神祈祷，他都会对你微笑。因为你已经找到了你所需要的唯一道路。",shape=box,color=blue];
		j3171639148 -> j1756000585;
	j2896456126 [label="啊，pardonne-mo ！小玛丽竟然在说教，真不好意思 ！我来这里可不是来当你的老师的。",shape=box,color=blue];
		j2896456126 -> j1830604943;
	j3034264704 [label="你的诚实深深地感动了我，流浪者。如果你允许的话，我……很想再和你聊聊这件事。我并不是想说教，也不想打探你的隐私。我只是不想让你难过。",shape=box,color=blue];
		j3034264704 -> j1313766957;
	j1313766957 [label="我只是好奇，也希望看看能不能帮得上忙。也请放心拒绝我，这样我们以后绝不会再提这件事。",shape=box,color=blue];
		j1313766957 -> j2118854187;
		j1313766957 -> j212073705;
	j1756000585 [label="我在想，我们以后可以再聊聊这个吗？我非常好奇，想知道更多。",shape=box,color=blue];
		j1756000585 -> j2118854187;
		j1756000585 -> j212073705;
	j2118854187 [label="不了，谢谢。",shape=box,color=red];
		j2118854187 -> j2389081238;
	j212073705 [label="当然可以。",shape=box,color=red];
		j212073705 -> j3327122983;
	j2389081238 [label="Boolean DrifterFaithStop is now true.",color=orange];
		j2389081238 -> j759118116;
	j3327122983 [label="Merci，merci ！你刚刚回我的话，蕴含着巨大的信任。我不会辜负这份信任。回头见。",shape=box,color=blue];
		j3327122983 -> "Chat ends.";
	j759118116 [label="我完全理解，而且我并没有生气。谢谢你听我倾诉，我很感激你分享的一切。我们以后再聊其他话题吧，太阳神知道我们有很多事情可以谈！",shape=box,color=blue];
