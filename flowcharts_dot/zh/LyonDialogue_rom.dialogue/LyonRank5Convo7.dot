	"Chat ends." [color=orange];
	j1779988773 [label="Mon miracle，我……必须确保你清楚明白一件事，才能告诉你我的下一个轶事。 ",shape=box,color=blue];
		j1779988773 -> j1997560879;
	j2116643454 [label="玛丽像捕捉蝴蝶般俘获了你的心，我并不感到意外。她确实……非同寻常。",shape=box,color=blue];
		j2116643454 -> j2183298434;
