	2081 [label="向我发誓吧，mon miracle——如果真有那么一天，我对你而言成了空荡的牢笼……你便从我这里获得自由。",shape=box,color=blue];
		2081 -> 2083;
	2082 [label="散步时我……突然意识到这种时刻暗藏的危险。你可能会……开始觉得这是种责任——开始视我为桎梏你的枷锁。",shape=box,color=blue];
