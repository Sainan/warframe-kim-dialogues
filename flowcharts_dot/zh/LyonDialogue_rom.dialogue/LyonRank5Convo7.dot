		j1243665097 -> j524820714 [label="false",color=purple];
	j1814530572 [label="里昂，你今天过得还好吗？",shape=box,color=red];
		j1814530572 -> j2561563977;
	j1464582944 [label="[表白心意] 里昂？我在想我们能不能谈谈。",shape=box,color=red];
		j1464582944 -> j616096176;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j1997560879 [label="你必须全神贯注地听我接下来要说的话。明白吗？",shape=box,color=blue];
		j1997560879 -> j701858565;
		j1997560879 -> j3194523915;
	j2183298434 [label="Check boolean LyonHasDated",color=orange];
		j2183298434 -> j1340733142 [label=true,color=green];
		j2183298434 -> j460760748 [label=true,color=green];
		j2183298434 -> j989792438 [label=true,color=green];
		j2183298434 -> j460760748 [label=false,color=brown];
		j2183298434 -> j989792438 [label=false,color=brown];
	j4269099889 [label="我很高兴有人能鼓起勇气，穿过罗瑟性格中的荆棘丛，看见那颗深埋其中的破碎心灵。",shape=box,color=blue];
		j4269099889 -> j3115370561;
	j524820714 [label="朋友，我能否问一个恐怕有些冒昧的问题？",shape=box,color=blue];
		j524820714 -> j1293128384;
		j524820714 -> j409987415;
	j2561563977 [label="多么美好又平淡的问题啊。我很少被人这样问。",shape=box,color=blue];
		j2561563977 -> j691903694;
	j616096176 [label="好的，怎么了？发生什么事了吗？",shape=box,color=blue];
		j616096176 -> j2392807584;
		j616096176 -> j2645431033;
	j701858565 [label="你让我很紧张。怎么了？",shape=box,color=red];
		j701858565 -> j2638482383;
	j3194523915 [label="明白，我在听。请说。",shape=box,color=red];
		j3194523915 -> j1367165725;
	j1340733142 [label="我不知道你会作何感想，毕竟……",shape=box,color=red];
		j1340733142 -> j1984916948;
	j460760748 [label="我对她……心怀敬畏。",shape=box,color=red];
		j460760748 -> j4229999075;
	j989792438 [label="这是在威胁我吗？还是？",shape=box,color=red];
		j989792438 -> j1347012958;
	j3115370561 [label="虽然他极力否认，但我知道他内心认定自己是个懦夫。我不会如此定义他。",shape=box,color=blue];
		j3115370561 -> j780893799;
	j1293128384 [label="当然可以。我问过你不少呢。",shape=box,color=red];
		j1293128384 -> j162474270;
	j409987415 [label="我为什么会和罗瑟约会？",shape=box,color=red];
		j409987415 -> j582196882;
	j691903694 [label="我……很好，谢谢。",shape=box,color=blue];
		j691903694 -> j3719887335;
	j2392807584 [label="算了。抱歉。其实我忘了要说什么了。",shape=box,color=red];
		j2392807584 -> j1754798671;
	j2645431033 [label="我不知道该怎么说才好，所以直说吧——我喜欢你。",shape=box,color=red];
		j2645431033 -> j699865075;
	j2638482383 [label="并非出了什么问题——恰恰相反。这正是你必须理解的关键——我试图让你免于承受的，正是那些你认定会随之而来的可怕后果。",shape=box,color=blue];
		j2638482383 -> j3007085790;
		j2638482383 -> j1065746826;
		j2638482383 -> j1277447069;
	j1367165725 [label="+5 Chemistry",color=orange];
		j1367165725 -> j1180380587;
	j1984916948 [label="哈。你以为我会惊讶吗？我始终站在她的光芒之下，从未改变。不，我的朋友——我发誓，对此我并不会怨恨或是嫉妒。",shape=box,color=blue];
		j1984916948 -> j2254823111;
	j4229999075 [label="我们都如此。我的灵魂姐妹永远让我惊叹不已。我为你们二人感到的喜悦已远超言语所能表达。",shape=box,color=blue];
		j4229999075 -> j2421536473;
	j1347012958 [label="嗯？不。我可没那么狂妄，不会趾高气扬地充当她的守护者。要是她觉得你够格，完全有能力把你打得满地找牙。",shape=box,color=blue];
		j1347012958 -> j2320731788;
	j780893799 [label="英择谛告诉他，未来需要他去拯救——一个他全然未知的未来。他没有统治权的未来，没有臣民在他脚下匍匐，没有仆从对他顶礼膜拜。",shape=box,color=blue];
		j780893799 -> j482802143;
	j162474270 [label="你究竟看中了罗瑟什么，竟让你们两人走到……恋爱这步？",shape=box,color=blue];
		j162474270 -> j4110087423;
		j162474270 -> j4035704736;
		j162474270 -> j3545537986;
	j582196882 [label="看来你不是早有心理准备，就是早就料到了。没错。正是如此。你……看上他哪一点？",shape=box,color=blue];
		j582196882 -> j4110087423;
		j582196882 -> j4035704736;
		j582196882 -> j3545537986;
	j3719887335 [label="+20 Chemistry",color=orange];
		j3719887335 -> j3218652898;
	j1754798671 [label="我经常这样。尤其穿过门框时。我常在想为什么会这样。",shape=box,color=blue];
		j1754798671 -> j3305723258;
	j699865075 [label="我……你……确定吗？你没事吧？最近没撞到头吧？",shape=box,color=blue];
		j699865075 -> j2841510152;
		j699865075 -> j3331832184;
	j3007085790 [label="我在听。",shape=box,color=red];
		j3007085790 -> j2454631564;
	j1065746826 [label="你说的完全不合逻辑。",shape=box,color=red];
		j1065746826 -> j1957308012;
	j1277447069 [label="可怕后果……是什么？",shape=box,color=red];
		j1277447069 -> j532514601;
	j1180380587 [label="谢谢。在开始之前，我想向你保证一切安好——然而，我试图让你免于承受的，正是那些你认定会随之而来的可怕后果。",shape=box,color=blue];
		j1180380587 -> j3007085790;
		j1180380587 -> j1065746826;
		j1180380587 -> j1277447069;
	j2254823111 [label="对于我们过往的种种我毫无怨怼，至今仍只愿为共度的时光献上感恩的心。",shape=box,color=blue];
		j2254823111 -> j2935593347;
	j2421536473 [label="每当她提及你时，眼中便闪烁着喜悦的光芒。一想到你可能会来，她就兴奋得轻飘飘的。",shape=box,color=blue];
		j2421536473 -> j4239554494;
	j2320731788 [label="我只想告诉你，她的幸福具有感染力——想到这里，连我也忍不住微笑。为此，同样要感谢你。",shape=box,color=blue];
		j2320731788 -> j3657611099;
	j482802143 [label="他或许会认为注射血清并忘却导致这一切的行为，不过是懦夫的逃避——如同老鼠逃离沉船。 ",shape=box,color=blue];
		j482802143 -> j144496739;
	j4110087423 [label="直白点说？你见过他吗？",shape=box,color=red];
		j4110087423 -> j1739864651;
	j4035704736 [label="我觉得他内心深处藏着某种痛苦，深藏在那些幽默与个性之下。",shape=box,color=red];
		j4035704736 -> j1811046914;
	j3545537986 [label="我……情不自禁。他身上那股黑暗与危险的气质，对我有着莫大的吸引力。让我无法自拔。",shape=box,color=red];
		j3545537986 -> j3745181485;
	j3218652898 [label="嗯，我觉得今天确实感觉相当不错。",shape=box,color=blue];
		j3218652898 -> j3645143899;
	j3305723258 [label="+5 Chemistry",color=orange];
		j3305723258 -> j3645143899;
	j2841510152 [label="为什么这么难相信？",shape=box,color=red];
		j2841510152 -> j155616375;
	j3331832184 [label="里昂，我确定。我没有脑震荡。",shape=box,color=red];
		j3331832184 -> j155616375;
	j2454631564 [label="+5 Chemistry",color=orange];
		j2454631564 -> j4076489026;
	j1957308012 [label="是的。我对此深有体会。",shape=box,color=blue];
		j1957308012 -> j532514601;
	j532514601 [label="请允许我重新开始。",shape=box,color=blue];
		j532514601 -> j4076489026;
	j2935593347 [label="+10 Chemistry",color=orange];
		j2935593347 -> j1337690529;
	j4239554494 [label="+10 Chemistry",color=orange];
		j4239554494 -> j2320731788;
	j3657611099 [label="——里昂",shape=box,color=blue];
		j3657611099 -> "Chat ends.";
	j144496739 [label="我视他为洞悉战场局势之人，深谙何时该弃守已无挽回余地的战舰。因为战争尚未终结。",shape=box,color=blue];
		j144496739 -> j1494212890;
	j1739864651 [label="我绝不敢指责你。",shape=box,color=blue];
		j1739864651 -> j59142664;
	j1811046914 [label="+5 Chemistry",color=orange];
		j1811046914 -> j3509123184;
	j3745181485 [label="我能理解它的吸引力。我也不否认自己同样感受到了。但为了你自己，我衷心希望你不要被它吞噬。",shape=box,color=blue];
		j3745181485 -> j2337714855;
	j3645143899 [label="祝你有个美好的一天。——里昂",shape=box,color=blue];
		j3645143899 -> "Chat ends.";
	j155616375 [label="坦白说——当你面前有其他选择时……玛丽或罗瑟，或者……宇宙中任何其他任何人……",shape=box,color=blue];
		j155616375 -> j2361803853;
	j4076489026 [label="我深知自己可能被许多人解读为——事实上，现实中很可能确实如此——一个……不正常的人。至少，我的精神状态远非完全健全。",shape=box,color=blue];
		j4076489026 -> j2270351745;
	j1337690529 [label="如今，我很高兴你能与她相伴。她将为你带来欢乐，而我曾带给你的只有悲伤。愿你与她幸福美满。我将永远祝福你们。",shape=box,color=blue];
		j1337690529 -> j3657611099;
	j1494212890 [label="Evaluate expressions",color=orange];
		j1494212890 -> j126765298 [label="RoatheVillian",color=purple];
		j1494212890 -> j1022024942 [label="RoatheVillian",color=purple];
		j1494212890 -> j2304523362 [label="RoatheVillian",color=purple];
		j1494212890 -> j126765298 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j1022024942 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j2064262635 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j2304523362 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j126765298 [label="false",color=purple];
		j1494212890 -> j1022024942 [label="false",color=purple];
	j59142664 [label="不过，为了你好，我真心希望这阵迷恋快快过去，别变成瘾症。我见过这般执念毁掉多少人。",shape=box,color=blue];
		j59142664 -> j3016432279;
	j3509123184 [label="是的，我亲眼见过。虽然被深埋在心底。但他可能并不欢迎你试图窥探。我相信他享受现在的自己。",shape=box,color=blue];
		j3509123184 -> j3016432279;
	j2337714855 [label="这样的关系不该仅建立在……简单的黑暗之上。不过，我不会对你说教。",shape=box,color=blue];
		j2337714855 -> j3016432279;
	j2361803853 [label="我很难相信你会选择与我这样的破碎彩窗为伴……除非你病得不轻。",shape=box,color=blue];
		j2361803853 -> j94454860;
		j2361803853 -> j3019064396;
	j2270351745 [label="我早已与这一切和解。它不再困扰我。那些折磨我的异象——那些声音——我已学会与之共处，不再恐惧也不再憎恨。",shape=box,color=blue];
		j2270351745 -> j810114197;
	j126765298 [label="我只是很高兴能在他身边，尽我所能地支持他。",shape=box,color=red];
		j126765298 -> j1364216928;
	j1022024942 [label="他遭遇的事情……很复杂。我想他得花很长时间才能理清头绪。",shape=box,color=red];
		j1022024942 -> j1364216928;
	j2304523362 [label="没错。他这么做是为了赢得战争——有时这意味着要输掉几场战役。",shape=box,color=red];
		j2304523362 -> j1364216928;
	j2064262635 [label="终有一日他会原谅自己。但那层外壳，恐怕永远不会真正改变。",shape=box,color=red];
		j2064262635 -> j1364216928;
	j3016432279 [label="你自己最清楚自己的心思和底线。愿你们一切安好。",shape=box,color=blue];
		j3016432279 -> j3129093504;
	j94454860 [label="里昂？我喜欢你。我在乎你。如果愿意，我想和你在一起。",shape=box,color=red];
		j94454860 -> j4200030873;
	j3019064396 [label="如果你说那不是两情相悦……",shape=box,color=red];
		j3019064396 -> j3161087821;
	j810114197 [label="（最近，说实话，我倒觉得这多少有些出于报复心理，不过这无关紧要。）",shape=box,color=blue];
		j810114197 -> j2962978941;
	j1364216928 [label="+10 Chemistry",color=orange];
		j1364216928 -> j1576665472;
	j3129093504 [label="+10 Chemistry",color=orange];
		j3129093504 -> j3444094641;
	j4200030873 [label="原谅我，请原谅我——我只是——我以为这不可能，这根本不是我……能够……想象到的……",shape=box,color=blue];
		j4200030873 -> j283124057;
	j3161087821 [label="绝非如此！我不是这个意思！恰恰相反——我只是——我以为这不可能，这根本不是我……能够……想象到的……",shape=box,color=blue];
		j3161087821 -> j283124057;
	j2962978941 [label="但我希望你明白，如果你要结束我们之间的这段关系，这段我曾以为此生不可能与他人建立的羁绊——",shape=box,color=blue];
		j2962978941 -> j894060064;
	j1576665472 [label="我衷心祝愿你们俩好运。",shape=box,color=blue];
		j1576665472 -> j3444094641;
	j3444094641 [label="况且，既然他似乎“憋着一口气想出头”，也就不再挑衅玛丽，避免公开冲突了。",shape=box,color=blue];
		j3444094641 -> j1070449644;
	j283124057 [label="+20 Chemistry",color=orange];
		j283124057 -> j1372629671;
	j894060064 [label="如果你的心某天真的从我身边飘然远去？ ",shape=box,color=blue];
		j894060064 -> j781633861;
	j1070449644 [label="嗯。反正没那么频繁了。先再见了。",shape=box,color=blue];
		j1070449644 -> j3657611099;
	j1372629671 [label="你真是 mon miracle……",shape=box,color=blue];
		j1372629671 -> j1374158912;
	j781633861 [label="我自会承受，mon miracle。",shape=box,color=blue];
		j781633861 -> j3552331051;
	j1374158912 [label="Boolean LyonDating is now true.",color=orange];
		j1374158912 -> j4115967391;
	j3552331051 [label="我不会被困扰我的那些东西吞噬。 ",shape=box,color=blue];
		j3552331051 -> j1697539566;
	j4115967391 [label="Boolean IsDating is now true.",color=orange];
		j4115967391 -> j3642226382;
	j1697539566 [label="Check boolean LyonAllRight",color=orange];
		j1697539566 -> j372183272 [label=true,color=green];
		j1697539566 -> j389636924 [label=false,color=brown];
	j3642226382 [label="Boolean LyonHasDated is now true.",color=orange];
		j3642226382 -> "Chat ends.";
	j372183272 [label="用你的俗语来说，我会“没事的”。我会找到再次微笑和欢笑的理由。",shape=box,color=blue];
		j372183272 -> j4032711573;
		j372183272 -> j2353779868;
	j389636924 [label="我会挺过去。我会好起来。我会找到再次微笑和欢笑的理由。",shape=box,color=blue];
		j389636924 -> j4032711573;
		j389636924 -> j2353779868;
	j4032711573 [label="哦，里昂……你对我来说，从来都不是负担。",shape=box,color=red];
		j4032711573 -> j3809648741;
	j2353779868 [label="你……是说想结束我们之间的关系？",shape=box,color=red];
		j2353779868 -> j3383646092;
	j3809648741 [label="我只是想让你摆脱因我而产生的任何困扰……",shape=box,color=blue];
		j3809648741 -> j834068775;
		j3809648741 -> j280407106;
		j3809648741 -> j4105888485;
	j3383646092 [label="不！绝无此事！我只是想让你摆脱因我而产生的任何困扰。",shape=box,color=blue];
		j3383646092 -> j834068775;
		j3383646092 -> j280407106;
		j3383646092 -> j4105888485;
	j834068775 [label="你的痛苦……与我内心某种痛楚相呼应。帮助你度过难关，对我而言永远不是负担。",shape=box,color=red];
		j834068775 -> j4232266702;
	j280407106 [label="我无法形容你对我的吸引力。但你永远不会成为责任或负担。",shape=box,color=red];
		j280407106 -> j928070220;
	j4105888485 [label="[分手] 这一切对我而言已不堪重负，抱歉。或许到此为止才是最好的选择。",shape=box,color=red];
		j4105888485 -> j2079164388;
	j4232266702 [label="我无法言喻自己因你而心碎的程度。但永远感激的是，我们孤独痛苦的幽魂终于彼此相遇。",shape=box,color=blue];
		j4232266702 -> j1151243604;
	j928070220 [label="对此我无从表达感激，我想任何言语都无法承载这份心意。",shape=box,color=blue];
		j928070220 -> j1151243604;
	j2079164388 [label="是的。当然。在此时此刻接受任何其他答案……都显得虚伪…… ",shape=box,color=blue];
		j2079164388 -> j3054693092;
	j1151243604 [label="但既然我已经费尽心力写了这段堪称极致自恋的铺垫……",shape=box,color=blue];
		j1151243604 -> j3369100807;
		j1151243604 -> j3265121585;
		j1151243604 -> j1636748294;
	j3054693092 [label="我完全理解。愿你永远幸福。我会永远珍藏我们共度的每一刻时光。",shape=box,color=blue];
		j3054693092 -> j2319541193;
	j3369100807 [label="一个刚开始沉默寡言的人，现在倒真是能说会道起来了。",shape=box,color=red];
		j3369100807 -> j2275005074;
	j3265121585 [label="别担心，我觉得它们很可爱。",shape=box,color=red];
		j3265121585 -> j665437872;
	j1636748294 [label="你完全可以直接说：“如果我们真的分道扬镳，我也会过得很好。”",shape=box,color=red];
		j1636748294 -> j1602326059;
	j2319541193 [label="纵使记忆褪色，灵魂仍将铭刻。再见了。",shape=box,color=blue];
		j2319541193 -> j3769853518;
	j2275005074 [label="+5 Chemistry",color=orange];
		j2275005074 -> j4239901581;
	j665437872 [label="+5 Chemistry",color=orange];
		j665437872 -> j1312677447;
	j1602326059 [label="+5 Chemistry",color=orange];
		j1602326059 -> j4237759352;
	j3769853518 [label="Boolean LyonDating is now false.",color=orange];
		j3769853518 -> j1786736805;
	j4239901581 [label="呸！若你不想窥见我脑海中的思绪，就不该到处乱探。这全是你咎由自取。",shape=box,color=blue];
		j4239901581 -> j900411716;
	j1312677447 [label="很高兴你喜欢我的絮叨。正因如此，我才选择如此寡言。你能想象若当面听这些会怎样吗？玛丽早该把我当疯狗一样揍扁了。",shape=box,color=blue];
		j1312677447 -> j900411716;
	j4237759352 [label="你天生就带着某种不羁与讽讥之气，这是我永远望尘莫及的高度。就留给你去展现吧。",shape=box,color=blue];
		j4237759352 -> j900411716;
	j1786736805 [label="Boolean IsDating is now false.",color=orange];
		j1786736805 -> j3657611099;
	j900411716 [label="不过，这一切不过是为接下来的故事铺垫——相比之下，这个故事显得相当简短……",shape=box,color=blue];
		j900411716 -> j2376102103;
	j2376102103 [label="昨夜我从噩梦中惊醒。醒来时，阴影已将我团团围住。这种状态对我来说并不陌生。它们在床边萦绕盘旋，久久不肯散去。",shape=box,color=blue];
		j2376102103 -> j3266506824;
	j3266506824 [label="我并不惧怕它们，因我深知它们无法伤害我。然而它们也始终萦绕心头，挥之不去。我知道只有一种方法能摆脱它们。",shape=box,color=blue];
		j3266506824 -> j985662244;
	j985662244 [label="我撑身下床，在持续噩梦的模糊视野中踉跄前行，勉强穿好衣物。抓起聚能焚炉跪倒在地板中央，准备……嗯。 ",shape=box,color=blue];
		j985662244 -> j1025303501;
	j1025303501 [label="准备“净化心灵”。就此打住。",shape=box,color=blue];
		j1025303501 -> j1353078845;
	j1353078845 [label="但当我闭上双眼，思绪却飘向远方。我的心绪飘荡……飘向了你，mon miracle……",shape=box,color=blue];
		j1353078845 -> j647533751;
	j647533751 [label="你的声音。你手掌抚过我肩头的触感…… ",shape=box,color=blue];
		j647533751 -> j4086087717;
	j4086087717 [label="那些异象……尽数消散。它们落荒而逃，被更强大的幽灵……你的幽灵驱散了。",shape=box,color=blue];
		j4086087717 -> j2838188794;
	j2838188794 [label="我……站了起来。将聚能焚炉放在床头柜上，然后……选择踏过圣所的沙地前行……",shape=box,color=blue];
		j2838188794 -> j3140817217;
		j2838188794 -> j19872005;
	j3140817217 [label="现在我明白你为什么觉得需要这个铺垫了。",shape=box,color=red];
		j3140817217 -> j632244016;
	j19872005 [label="我不知道该说什么……",shape=box,color=red];
		j19872005 -> j1257999115;
	j632244016 [label="是的。嗯。散步时我……突然意识到这种时刻暗藏的危险。你可能会……开始觉得这是种责任——开始视我为桎梏你的枷锁。",shape=box,color=blue];
		j632244016 -> j2426228300;
	j1257999115 [label="+5 Chemistry",color=orange];
		j1257999115 -> j273699273;
	j2426228300 [label="我恳求你——我祈祷，无论向天上还是地下的神——愿你永不如此。这是你赠予我的礼物，每次当它焕发新生时，我都会珍视它。",shape=box,color=blue];
		j2426228300 -> j1844531142;
	j273699273 [label="无需言语，mon miracle…… ",shape=box,color=blue];
		j273699273 -> j4075127107;
	j1844531142 [label="向我发誓吧，mon miracle——如果真有那么一天，我对你而言成了空荡的牢笼……你便从我这里获得自由。",shape=box,color=blue];
		j1844531142 -> j3789333436;
	j4075127107 [label="散步时我……突然意识到这种时刻暗藏的危险。你可能会……开始觉得这是种责任——开始视我为桎梏你的枷锁。",shape=box,color=blue];
		j4075127107 -> j2426228300;
	j3789333436 [label="我绝不会成为所爱之人的空洞牢笼。不会对你如此。不会对玛丽如此。",shape=box,color=blue];
		j3789333436 -> j1135170884;
		j3789333436 -> j827034121;
	j1135170884 [label="[分手] 我——我做不到。我无法许下这个承诺，对不起。",shape=box,color=red];
		j1135170884 -> j616705855;
	j827034121 [label="我发誓。 ",shape=box,color=red];
		j827034121 -> j1210312736;
	j616705855 [label="+10 Chemistry",color=orange];
		j616705855 -> j1600917975;
	j1210312736 [label="+10 Chemistry",color=orange];
		j1210312736 -> j3365793437;
	j1600917975 [label="谢谢你。谢谢你，mon miracle，感谢你的坦诚。在这个时刻说出这些需要勇气，我为此向你致敬。",shape=box,color=blue];
		j1600917975 -> j1696381631;
	j3365793437 [label="谢谢你。谢谢你，mon miracle……",shape=box,color=blue];
		j3365793437 -> j1148481610;
	j1696381631 [label="我会珍藏我们共度的每一刻。这份珍视，远超你的想象。",shape=box,color=blue];
		j1696381631 -> j2319541193;
	j1148481610 [label="我突然感到无比疲惫，仿佛……肩上的重担终于卸下了。恐怕我得去躺下歇歇了。",shape=box,color=blue];
		j1148481610 -> j1864845913;
	j1864845913 [label="——里昂",shape=box,color=blue];
		j1864845913 -> j3446510588;
	j3446510588 [label="Boolean LyonDatingConfession is now true.",color=orange];
		j3446510588 -> "Chat ends.";
}