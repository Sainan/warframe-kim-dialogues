digraph {
	"LyonRank4Convo2 begins." [color=orange];
		"LyonRank4Convo2 begins." -> j2634932653;
		"LyonRank4Convo2 begins." -> j3834754982;
		"LyonRank4Convo2 begins." -> j1038552372;
	j2634932653 [label="你和玛丽是如何做到既是神父又是修女，同时又……犯下暴力罪行的呢？",shape=box,color=red];
		j2634932653 -> j2248255768;
		j2634932653 -> j3045882686;
		j2634932653 -> j2875009245;
	j3834754982 [label="里昂，我可以问你一个有点奇怪的问题吗？",shape=box,color=red];
		j3834754982 -> j480026184;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j2248255768 [label="我听到玛丽喊着“païens！”然后冲进打斗中，然而……我很难相信她会是那种因为别人信仰不同而谴责别人的人。我想你也应该和她差不多。她显然很欣赏你。",shape=box,color=red];
		j2248255768 -> j216606211;
	j3045882686 [label="你们教会对你和玛丽在这里所做的事情会有什么看法？对……你们被要求以他们的名义做的事情又会有什么看法？",shape=box,color=red];
		j3045882686 -> j2623903247;
	j2875009245 [label="我见过你和玛丽在战场上的样子，然后我私下和她交谈，看到你安静地读书……我想我很难把你们不同的样子都联系起来。",shape=box,color=red];
	j480026184 [label="如果你觉得用“奇怪”来形容我们目前的困境就足够了，那我要么佩服你的勇气，要么对你词汇量的匮乏感到失望。不过，我猜想应该是前者。",shape=box,color=blue];
		j480026184 -> j3048757597;
	"Chat ends." [color=orange];
	j216606211 [label="你说得很对。玛丽不会因为别人心中怀有古老的树神信仰而谴责他们——相反，她会努力寻找自己与他们共同的信仰。",shape=box,color=blue];
		j216606211 -> j4044619252;
	j2623903247 [label="在那个时代，许多圣战以太阳神或月神的名义发动。血腥的“圣战”是为了击退“异教徒”或“夺取圣地”，或者是为了其他任何当时流行的牵强附会的理由。",shape=box,color=blue];
		j2623903247 -> j1263626387;
	j3048757597 [label="+5 Chemistry",color=orange];
		j3048757597 -> j2926928201;
	j4044619252 [label="难道这棵树不是沐浴着太阳神的光芒吗？难道她就不能和他们一起擘饼吗？她更愿意坐下来倾听他们的故事，而不是因为他们的信仰而伤害他们。",shape=box,color=blue];
		j4044619252 -> j2896753190;
	j1263626387 [label="双耀神正教没有军队，也不发动战争。但他们不阻止其信徒采取行动或保护他人。",shape=box,color=blue];
		j1263626387 -> j3797345102;
	j2926928201 [label="也就是说，可以，请继续吧。就算你再问你好奇的那些事，也不会让我觉得更“奇怪”了。",shape=box,color=blue];
		j2926928201 -> j2248255768;
		j2926928201 -> j3045882686;
		j2926928201 -> j2875009245;
	j2896753190 [label="当她在战场上与敌人交战时，我认为只有两种可能：要么她是在享受战斗的乐趣，扮演着古代圣战士兵的角色，想象自己身披闪亮的太阳神骑士盔甲——",shape=box,color=blue];
		j2896753190 -> j3123974485;
	j3797345102 [label="当玛丽在战场上与敌人交战时，我认为只有两种可能：要么她是在享受战斗的乐趣，扮演着古代圣战士兵的角色，想象自己身披闪亮的太阳神骑士盔甲——",shape=box,color=blue];
		j3797345102 -> j3123974485;
	j3123974485 [label="或者，​更​有​可能​的​是，​她​谨记​《阿斯塔记》​第 ​8​ 章 23​ 节：​“那些​试图用​暴力​进入​我​殿宇​的​人​是​孤独​的，​因为​他们​是​被​太阳神​之光​所​抛弃​的​人。”​",shape=box,color=blue];
		j3123974485 -> j2894059106;
	j2894059106 [label="在她看来，她所犯下的暴力行为是为了捍卫更大的利益而进行的正义行为——我想，你也会这么认为，你并肩作战的人也会这么认为。 ",shape=box,color=blue];
		j2894059106 -> j2356223145;
	j2356223145 [label="因此，凡是与她交战的人——无论其信仰如何——都会被逐出太阳神的殿。即便他们身着她教团的圣袍，在她眼中，他们也是异教徒。",shape=box,color=blue];
		j2356223145 -> j4284602547;
		j2356223145 -> j2397708138;
	j4284602547 [label="我注意到你把自己排除在外了。你对所有这些争斗有什么看法？",shape=box,color=red];
		j4284602547 -> j3748836415;
	j2397708138 [label="有道理。谢谢。",shape=box,color=red];
		j2397708138 -> j996929825;
	j3748836415 [label="漂泊者，我是故意避开这个话题的。",shape=box,color=blue];
		j3748836415 -> j3781914179;
		j3748836415 -> j1829937356;
	j996929825 [label="+5 Chemistry",color=orange];
		j996929825 -> j3006234220;
	j3781914179 [label="神父，我要坚持问这个问题。",shape=box,color=red];
		j3781914179 -> j2580131761;
	j1829937356 [label="好吧。今天能知道什么就知道什么吧。",shape=box,color=red];
		j1829937356 -> j996929825;
	j3006234220 [label="不管怎样，玛丽告诉我你是好意。即使我不相信自己，也会相信她。",shape=box,color=blue];
		j3006234220 -> j607430534;
	j2580131761 [label="+10 Chemistry",color=orange];
		j2580131761 -> j2632971513;
	j607430534 [label="到头来，我或许只能恳求你的耐心了。月神知道，大多数时候我对自己都缺乏耐心。",shape=box,color=blue];
		j607430534 -> j82610256;
	j2632971513 [label="好吧。既然你执意不肯罢休，而且你又如此好奇？我并不像你想象的那样，对造成的死亡感到不安。",shape=box,color=blue];
		j2632971513 -> j578938451;
	j82610256 [label="——里昂·阿拉德神父",shape=box,color=blue];
		j82610256 -> "Chat ends.";
	j578938451 [label="或者说，对于像我这样的神职人员和学者来说，这可能不算是“恰当的”。",shape=box,color=blue];
		j578938451 -> j2964067353;
		j578938451 -> j4211057624;
	j2964067353 [label="里昂，我这辈子经历过的战争比和平多得多。如果我让战争的阴影笼罩我，我想我可能早就不在人世了。但这并不意味着战争没有带来真正的负担——真正的代价。",shape=box,color=red];
		j2964067353 -> j359349855;
	j4211057624 [label="我相信其他人已经告诉过你我是谁，我是什么，我来自哪里，我背负的死亡——来自于我的死亡，定义了我的死亡。难道你觉得你的任何感受会让我感到惊讶吗？",shape=box,color=red];
		j4211057624 -> j4015942466;
	j359349855 [label="Add 1 to Thermostat counter",color=orange];
		j359349855 -> j3863545123;
	j4015942466 [label="Add -1 to Thermostat counter",color=orange];
		j4015942466 -> j4063786011;
	j3863545123 [label="是的，​这代价确实​笼罩​了​我。​",shape=box,color=blue];
		j3863545123 -> j1703192710;
		j3863545123 -> j118261609;
	j4063786011 [label="是的，你会惊讶的。",shape=box,color=blue];
		j4063786011 -> j1703192710;
		j4063786011 -> j118261609;
	j1703192710 [label="对不起，我觉得我让你不高兴了，那不是我的本意。",shape=box,color=red];
		j1703192710 -> j3885154494;
	j118261609 [label="你能详细说明一下吗？",shape=box,color=red];
		j118261609 -> j3857241210;
	j3885154494 [label="漂泊者，这不是你的错。正如我们来自自由国的兄弟姐妹们可能会说的那样，我“很难对付”。",shape=box,color=blue];
		j3885154494 -> j2800872577;
	j3857241210 [label="萦绕在我脑海中的恐怖景象似乎没有尽头。我亲眼目睹的曾经鲜红欲滴的人类筋腱，如今已变得脆弱焦黑。",shape=box,color=blue];
		j3857241210 -> j3259336581;
	j2800872577 [label="我只是个被围困的个体。我坚守着城墙。打开城门就等于威胁到防御工事的完整性。",shape=box,color=blue];
		j2800872577 -> j2124649255;
		j2800872577 -> j2031160739;
	j3259336581 [label="我看到了成千上万张与我相似的面孔，却又陌生。空洞的棺材，扭曲破碎的人类血肉之躯，悬浮在生死之间的帷幕之中。",shape=box,color=blue];
		j3259336581 -> j1368438730;
	j2124649255 [label="我​理解。​等​你​准备​好​了，​我们​再谈。​",shape=box,color=red];
		j2124649255 -> j754296089;
	j2031160739 [label="你这话是什么意思？",shape=box,color=red];
		j2031160739 -> j3857241210;
	j1368438730 [label="他们脸上的表情被空洞的平静面具所掩盖。但在他们灵魂残存的微光中，在那些徘徊不去的余烬里，我听到了他们的呐喊。他们无休止地呼喊着复仇，呼喊着自由。",shape=box,color=blue];
		j1368438730 -> j2472620803;
	j754296089 [label="我开始越来越清楚地意识到，在这件事上我别无选择。",shape=box,color=blue];
		j754296089 -> j280624168;
	j2472620803 [label="呼喊着死亡。",shape=box,color=blue];
		j2472620803 -> j567791478;
	j280624168 [label="+15 Chemistry",color=orange];
		j280624168 -> j3963071868;
	j567791478 [label="这些异象在我清醒的时候、在我做梦的时候萦绕着我。我没有噩梦，因为我所经历的只有这些——让我变成了这样。",shape=box,color=blue];
		j567791478 -> j1274675553;
	j3963071868 [label="但不管怎样，玛丽告诉我你是好意。即使我不相信自己，也会相信她。",shape=box,color=blue];
		j3963071868 -> j3326268624;
	j1274675553 [label="Check boolean LyonPainOff",color=orange];
		j1274675553 -> j3258955102 [label=true,color=green];
		j1274675553 -> j2857152393 [label=false,color=brown];
	j3326268624 [label="到头来，我或许只能恳求你的耐心了。月神知道，大多数时候我对自己都缺乏耐心。",shape=box,color=blue];
		j3326268624 -> j665438825;
	j3258955102 [label="只有当我顺从内心深处的低语时，世界才会以你可能熟悉的方式反映在我面前。",shape=box,color=blue];
		j3258955102 -> j3371152481;
	j2857152393 [label="只有当我将血肉从身体上撕裂，作为献祭给灵魂深处回荡的低语时，世界才会以你可能熟悉的方式反映在我面前。",shape=box,color=blue];
		j2857152393 -> j3371152481;
	j665438825 [label="——里昂·阿拉德神父",shape=box,color=blue];
		j665438825 -> j2522325746;
	j3371152481 [label="漂泊者，请不要假装了解我的“感受”。恐怕你的明白，才刚刚开始。",shape=box,color=blue];
		j3371152481 -> j223483094;
		j3371152481 -> j1394983618;
		j3371152481 -> j3150059750;
	j2522325746 [label="Boolean LyonVisions2d is now true.",color=orange];
		j2522325746 -> "Chat ends.";
	j223483094 [label="我……对不起。我不知道。",shape=box,color=red];
		j223483094 -> j1707732792;
	j1394983618 [label="里昂，我还看过更多你无法理解的恐怖和痛苦。",shape=box,color=red];
		j1394983618 -> j2500852453;
	j3150059750 [label="如果你觉得我说话不合时宜，我很抱歉。但我很想知道。你看到的这些异象……",shape=box,color=red];
		j3150059750 -> j1707732792;
	j1707732792 [label="好了。嗯。这么多年来我都挺过来了。我相信我还能再坚持几年。你不用太担心。",shape=box,color=blue];
		j1707732792 -> j4270520825;
	j2500852453 [label="我非常肯定你有看过，因为从这个地方的景象中就能看出一些端倪。但你认为自己高人一等吗？是洞悉一切恐怖与苦难的至高无上的存在吗？",shape=box,color=blue];
		j2500852453 -> j2078219251;
		j2500852453 -> j2742018429;
	j4270520825 [label="Boolean LyonVisions2a is now true.",color=orange];
		j4270520825 -> j1573017903;
		j4270520825 -> j3548266251;
	j2078219251 [label="我的意思是，我或许比你想象的更能理解你的感受。",shape=box,color=red];
		j2078219251 -> j3894722221;
	j2742018429 [label="里昂，我的意思是，我经历过很多死亡和恐怖。所以我不喜欢别人用居高临下的语气跟我说话。",shape=box,color=red];
		j2742018429 -> j596574670;
	j1573017903 [label="里昂，你所描述的……这种异象是在你成为原型战甲之前还是之后产生的？",shape=box,color=red];
		j1573017903 -> j3945376248;
	j3548266251 [label="我们能再谈谈这件事吗？拜托？",shape=box,color=red];
		j3548266251 -> j2413254114;
	j3894722221 [label="Boolean LyonVisions2b is now true.",color=orange];
		j3894722221 -> j2296975144;
	j596574670 [label="Boolean LyonVisions2c is now true.",color=orange];
		j596574670 -> j1659019020;
	j3945376248 [label="如果这个问题真像你认为的那样简单就好了。不过，我今天不想回答这个问题。我感觉头要疼了。",shape=box,color=blue];
		j3945376248 -> j2190732239;
	j2413254114 [label="我开始越来越清楚地意识到，在这件事上我别无选择。",shape=box,color=blue];
		j2413254114 -> j2190732239;
	j2296975144 [label="漂泊者，或许你会觉得奇怪，我并非寻求共情。当一切都是幻象和谎言之时，我寻求的是答案，是确定性，是苍穹。",shape=box,color=blue];
		j2296975144 -> j163553922;
		j2296975144 -> j3775461080;
	j1659019020 [label="那么，请允许我匍匐在你的脚下。赞美你所承受的一切。惊叹于你目睹了那么多，为何还能保持清醒。",shape=box,color=blue];
		j1659019020 -> j708208983;
	j2190732239 [label="+10 Chemistry",color=orange];
		j2190732239 -> j2466535248;
	j163553922 [label="我会看看我能做什么。",shape=box,color=red];
		j163553922 -> j3230213415;
	j3775461080 [label="那或许我可以帮上忙。我们能再谈谈这件事吗？拜托了？",shape=box,color=red];
		j3775461080 -> j2413254114;
	j708208983 [label="惊叹于你那么高高在上，却仍然抽出时间来关心我们这些被你视为低下的人。",shape=box,color=blue];
		j708208983 -> "Chat ends.";
	j2466535248 [label="但不管怎样，玛丽告诉我你是好意。即使我不相信自己，也会相信她。",shape=box,color=blue];
		j2466535248 -> j607430534;
	j3230213415 [label="+5 Chemistry",color=orange];
		j3230213415 -> j4160081911;
	j4160081911 [label="这不就是我们所奢求的吗？",shape=box,color=blue];
		j4160081911 -> "Chat ends.";
}