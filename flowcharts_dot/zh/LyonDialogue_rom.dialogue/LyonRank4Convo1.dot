		j1073023867 -> j1024549831 [label="DrifterFaithNoMaybe",color=purple];
		j1073023867 -> j3978164254 [label="DrifterFaithNoMaybe",color=purple];
		j1073023867 -> j989018787 [label="DrifterFaithNoMITW",color=purple];
		j1073023867 -> j3978164254 [label="DrifterFaithNoMITW",color=purple];
		j1073023867 -> j3978164254 [label="false",color=purple];
	j3373658560 [label="恐怕我可以详细讨论的话题太多了。不过别误会，我很乐意，只是不想让你觉得太无聊。你想从哪里开始呢？",shape=box,color=blue];
		j3373658560 -> j3668884279;
		j3373658560 -> j1861886122;
	j3978164254 [label="不，我只是好奇而已。",shape=box,color=red];
		j3978164254 -> j2305594065;
	j303387749 [label="我有信仰。我的信仰和你的很相似，虽然你可能认不出来。",shape=box,color=red];
		j303387749 -> j3399666172;
	j912217452 [label="我有信仰。不过，你肯定认不出我们的宗教习俗。",shape=box,color=red];
		j912217452 -> j2521672590;
	j1075641713 [label="我有信仰。这是一种我个人的信仰——它并没有一个确切的名称。",shape=box,color=red];
		j1075641713 -> j4202494142;
	j3047651256 [label="和​玛丽​一样，​我​追随​太​阳神​之道。​",shape=box,color=red];
		j3047651256 -> j2832828231;
	j2231369797 [label="我和你一样，也追随月神之道。",shape=box,color=red];
		j2231369797 -> j2832828231;
	j2307067238 [label="我追随双耀神，但我在努力保持平衡的道路。",shape=box,color=red];
		j2307067238 -> j2832828231;
	j3204443607 [label="我相信一定会有神的存在，但我认为最终人们都不可能真正知道答案。",shape=box,color=red];
		j3204443607 -> j3479332401;
	j1426724078 [label="我没有信仰。我个人认为宗教是恐惧者的拐杖——无意冒犯。",shape=box,color=red];
		j1426724078 -> j680789951;
	j1024549831 [label="我没有信仰。我不会说这世上绝对没有宗教，但这并非我所担忧的事情。",shape=box,color=red];
		j1024549831 -> j3542670274;
	j989018787 [label="我没有信仰。我认为所有的神——甚至包括虚空无情之物——都是我们想象的产物。无意冒犯。",shape=box,color=red];
		j989018787 -> j4137715509;
	j3668884279 [label="你能跟我说说你的节日吗？",shape=box,color=red];
		j3668884279 -> j3235984180;
	j1861886122 [label="你能给我讲讲太阳神和月神吗？",shape=box,color=red];
		j1861886122 -> j3710335878;
	j2305594065 [label="Check boolean LyonSuspicious",color=orange];
		j2305594065 -> j3911804021 [label=true,color=green];
		j2305594065 -> j1082156676 [label=false,color=brown];
	j3399666172 [label="+20 Chemistry",color=orange];
		j3399666172 -> j1596600694;
	j2521672590 [label="+20 Chemistry",color=orange];
		j2521672590 -> j1280629517;
	j4202494142 [label="请问你是如何形成如此个人化的信仰的？",shape=box,color=blue];
		j4202494142 -> j4037192226;
		j4202494142 -> j2339025649;
		j4202494142 -> j3754143006;
	j2832828231 [label="+20 Chemistry",color=orange];
		j2832828231 -> j2624553881;
	j3479332401 [label="+20 Chemistry",color=orange];
		j3479332401 -> j2357306551;
	j680789951 [label="+20 Chemistry",color=orange];
		j680789951 -> j1422777758;
	j3542670274 [label="+20 Chemistry",color=orange];
		j3542670274 -> j1853850430;
	j4137715509 [label="Boolean LyonMITW2 is now true.",color=orange];
		j4137715509 -> j4046208362;
	j3235984180 [label="Boolean LyonLectureHolidays is now true.",color=orange];
		j3235984180 -> j1952900584;
	j3710335878 [label="Boolean LyonLectureSolLua is now true.",color=orange];
		j3710335878 -> j3030297976;
	j3911804021 [label="Boolean DrifterLiar is now true.",color=orange];
		j3911804021 -> j2768150891;
	j1082156676 [label="Boolean LyonSuspicious is now true.",color=orange];
		j1082156676 -> j2768150891;
	j1596600694 [label="我想知道我们的信仰在多大程度上会相互影响，无论是有意还是无意。",shape=box,color=blue];
		j1596600694 -> j3979752970;
	j1280629517 [label="太棒了！作为一名宗教学者，我真心希望我们能有时间深入地互相学习各自的信仰。",shape=box,color=blue];
		j1280629517 -> j3979752970;
	j4037192226 [label="说来话长。",shape=box,color=red];
		j4037192226 -> j88273693;
	j2339025649 [label="我​研究​过​很​多​种​不同​的​宗教，​但​没有​一​种​真正​适合​我。​最终，​我​悟出​了​一​个​有点​怪异​的​人性​集合体。​",shape=box,color=red];
		j2339025649 -> j954075332;
	j3754143006 [label="我相信自己的感觉。我不需要某个建筑或书籍来告诉我那是什么。",shape=box,color=red];
		j3754143006 -> j4285876755;
	j2624553881 [label="真的吗？我……很惊讶。惊讶之余，也很高兴。难怪你会好奇。我们的教义一定与你所了解的截然不同。毕竟时间已经过去这么久了。",shape=box,color=blue];
		j2624553881 -> j3979752970;
	j2357306551 [label="我尊重你的看法。认识到我们无法知晓的事物，认识到人类境况的渺小，这本身就是一种荣耀。",shape=box,color=blue];
		j2357306551 -> j3979752970;
	j1422777758 [label="请​相信​我，​我​并​没有​被​冒犯到。​在​很多​情况​下，​你​的​说法​完全​正确。​",shape=box,color=blue];
		j1422777758 -> j2538566537;
		j1422777758 -> j1680571382;
	j1853850430 [label="我承认，我羡慕你从不为死后的世界忧虑。要是其他人也能如此就好了，我们的世界或许会更加和平。",shape=box,color=blue];
		j1853850430 -> j3979752970;
	j4046208362 [label="这是一个我很想和你深入探讨的话题。只是现在还不是时候，我还没有准备好进行这样的讨论。",shape=box,color=blue];
		j4046208362 -> j3979752970;
	j1952900584 [label="这是一个明智的开头。了解一个文化的节日，就如同了解它的灵魂。因为一个民族如何庆祝，就决定了他们将被后人铭记的方式。因为那些共同经历的时刻，是那些最珍贵的回忆。",shape=box,color=blue];
		j1952900584 -> j3844817971;
	j3030297976 [label="当然可以。我们先从你可能已经知道的说起：太阳神和月神。他们是永恒变化的神祇。",shape=box,color=blue];
		j3030297976 -> j1906335171;
	j2768150891 [label="嗯。​那​就​先​让​我​来​解答​你​的​问题。​为了​避免​让​你​感到​无聊，​你​想​从​哪里​开始​呢？​",shape=box,color=blue];
		j2768150891 -> j1861886122;
		j2768150891 -> j3668884279;
	j3979752970 [label="是我疏忽了，没有围绕主题说。恐怕我已经远远离题。",shape=box,color=blue];
		j3979752970 -> j2094461876;
	j88273693 [label="+20 Chemistry",color=orange];
		j88273693 -> j4202265173;
	j954075332 [label="+20 Chemistry",color=orange];
		j954075332 -> j3399341725;
	j4285876755 [label="+20 Chemistry",color=orange];
		j4285876755 -> j2093931171;
	j2538566537 [label="不过这并不代表我不愿意继续学习。",shape=box,color=red];
		j2538566537 -> j3540695704;
	j1680571382 [label="你的情况又如何呢？",shape=box,color=red];
		j1680571382 -> j810309354;
	j3844817971 [label="我们最主要、最常见的节日是仲冬节和仲夏节，分别标志着一年中白昼最短和最长的一天。",shape=box,color=blue];
		j3844817971 -> j3762625898;
	j1906335171 [label="多个世纪以来，他们以多种形象出现在众多信徒面前。有时是男性，有时是女性。但始终是太阳神和月神。",shape=box,color=blue];
		j1906335171 -> j1134890227;
		j1906335171 -> j1823468889;
	j2094461876 [label="你想了解双耀神的正教，对吗？为了避免让你感到无聊，你想从哪里开始呢？",shape=box,color=blue];
		j2094461876 -> j1861886122;
		j2094461876 -> j3668884279;
	j4202265173 [label="嗯。这种事最好跟信任的朋友说。我完全理解。再说，是你来问我问题，而不是我来问你。",shape=box,color=blue];
		j4202265173 -> j3979752970;
	j3399341725 [label="灵魂的彩色玻璃窗。分开时破碎不堪，但重新拼合时却能描绘出一幅异常美丽的画面。",shape=box,color=blue];
		j3399341725 -> j3979752970;
	j2093931171 [label="如果​世人​与​你​拥有​相同​的​信仰，​那​将​会​是​一​个​更​美​好​的​世界。​",shape=box,color=blue];
		j2093931171 -> j3979752970;
	j3540695704 [label="为此，我赞赏你的好奇心和求知欲。 ",shape=box,color=blue];
		j3540695704 -> j3979752970;
	j810309354 [label="我的情况……很复杂。但我不会撒谎说我从未感到恐惧。尽管宗教给我的生活带来了无尽的恐惧，它也从未消除过我的恐惧。",shape=box,color=blue];
		j810309354 -> j3979752970;
	j3762625898 [label="这两个节日都以盛宴为标志，但它们的区别在于与谁共进宴席。仲冬节是与家人和挚友共享的节日，而仲夏节则是与陌生人共享的节日。",shape=box,color=blue];
		j3762625898 -> j1075816431;
		j3762625898 -> j3491881559;
	j1134890227 [label="哦，怪不得。",shape=box,color=red];
		j1134890227 -> j3518944524;
	j1823468889 [label="[让他继续]",shape=box,color=red];
		j1823468889 -> j198970301;
	j1075816431 [label="真的吗？跟我说说仲夏节吧。",shape=box,color=red];
		j1075816431 -> j3562314681;
	j3491881559 [label="跟我说说仲冬节吧。",shape=box,color=red];
		j3491881559 -> j2859354713;
	j3518944524 [label="是的，有些教派在圣像的选择上可能比较严格，宣称太阳神“必须”是这样或“必须”是那样，但正教并不承认这是真理。",shape=box,color=blue];
		j3518944524 -> j1331859141;
	j198970301 [label="圣光双神中的两个神都蕴含着多重身份。每一种身份都可以被视为整体的一个组成部分。例如，月神既是母亲，又是少女，又是老妪。",shape=box,color=blue];
		j198970301 -> j3661120288;
	j3562314681 [label="仲​夏节​是​分享丰收​成果、​让​素​未​谋面​的​陌生​人​相聚​的​日子。​人们​会​聚集​在​田野​里，​带来​自己​制作​的​食物​和​物品，​带​什么​都​可以。​",shape=box,color=blue];
		j3562314681 -> j2158089867;
	j2859354713 [label="仲​冬节​是​抵御​严寒、​感恩​那些​在​最​黑暗​的​时刻​给​予​我们​温暖​的​人​的​日子。​人们​用​蜡烛​装​饰​星树，​每​一​盏​灯​都​代表​一​位​先人，​他们​如同​天​上​的​繁星，​指​引​着​我们​前行​的​道路。​",shape=box,color=blue];
		j2859354713 -> j1444325474;
	j1331859141 [label="我估计，关于我们信仰流传至今的记载，最终会变得……有些混乱。",shape=box,color=blue];
		j1331859141 -> j2196665335;
	j3661120288 [label="但月神也可以是引领灵魂沿着泪河走向无尽黑夜的那一位。即死神本身、先驱者和使者。",shape=box,color=blue];
		j3661120288 -> j2669606465;
	j2158089867 [label="蜡烛、面包、衣物、画作，或是诗集，或是花环。即便空手而来，但“带着喜讯”，也被视为一种祝福。",shape=box,color=blue];
		j2158089867 -> j839871565;
	j1444325474 [label="而头顶上的太阳神，在黑暗中，于星树之巅饱受煎熬。他虽已黯淡，却未被遗忘。因为这是月神的时代。在这阴影笼罩的时刻，我们颂扬她。",shape=box,color=blue];
		j1444325474 -> j1783932337;
	j2196665335 [label="我发现自己成了一件活着的考古文物。真令人沮丧。不过，我扯远了。",shape=box,color=blue];
		j2196665335 -> j198970301;
	j2669606465 [label="在其他教派中，死神是一位蒙着面纱的老妇人。虽然各有不同，但都指向同一个精神层面，那就是在生命的最后一刻，那只银色的手指引着我们。",shape=box,color=blue];
		j2669606465 -> j3843705432;
	j839871565 [label="在这个漫长的太阳神之日中，人们庆祝生命——欢笑——音乐——分享这一切。 ",shape=box,color=blue];
		j839871565 -> j996675533;
	j1783932337 [label="当我们围坐一桌，享用烤禽、根茎类蔬菜以及所有在冰冻土地上无法新鲜生长的食材时，我们拥抱着我们所爱的人，讲述着那些逝去亲人的故事。",shape=box,color=blue];
		j1783932337 -> j1908948612;
	j3843705432 [label="日食期间，月亮遮蔽了太阳，在看似一切都已失去的十字路口，指引着我们前行。",shape=box,color=blue];
		j3843705432 -> j1402025786;
	j996675533 [label="所有人都可以结识陌生人并交朋友，还可以带走自己需要的东西。",shape=box,color=blue];
		j996675533 -> j1732644477;
	j1908948612 [label="在月神最漫长的夜晚，我们铭记着，她最终会指引我们和我们的家人度过难关。",shape=box,color=blue];
		j1908948612 -> j1732644477;
	j1402025786 [label="Boolean DrifterEclipse is now true.",color=orange];
		j1402025786 -> j1704025367;
	j1732644477 [label="但对双耀神信徒来说，最神圣的节日是至善日。这是一个罕见的现象，当太阳和月亮完美对齐，形成一次完美的日食或月食时就是这个节日。",shape=box,color=blue];
		j1732644477 -> j3593451961;
	j1704025367 [label="Check boolean VelimirEclipse",color=orange];
		j1704025367 -> j2598429917 [label=true,color=green];
		j1704025367 -> j2244835157 [label=false,color=brown];
	j3593451961 [label="这是一个奇妙而神圣的景象，大自然万物都在响应。你有没有幸亲眼目睹过呢？",shape=box,color=blue];
		j3593451961 -> j1351788480;
	j2598429917 [label="等一下……",shape=box,color=red];
		j2598429917 -> j2042953705;
	j2244835157 [label="你亲眼见过日食吗？",shape=box,color=red];
		j2244835157 -> j2976546696;
	j1351788480 [label="Boolean DrifterEclipse is now true.",color=orange];
		j1351788480 -> j2702204293;
	j2042953705 [label="这看起来……非常眼熟。",shape=box,color=red];
		j2042953705 -> j362871012;
	j2976546696 [label="我有幸两次亲眼见证。两次都让我感到……震撼人心。如果可以，我真想永远停留在那短暂的瞬间。",shape=box,color=blue];
		j2976546696 -> j305475311;
	j2702204293 [label="Evaluate expressions",color=orange];
		j2702204293 -> j2894012433 [label="Megrim",color=purple];
		j2702204293 -> j95920046 [label="Megrim",color=purple];
		j2702204293 -> j3655402387 [label="Megrim",color=purple];
		j2702204293 -> j2504908136 [label="Megrim",color=purple];
		j2702204293 -> j2077032279 [label="Megrim",color=purple];
		j2702204293 -> j2894012433 [label="Migraine",color=purple];
		j2702204293 -> j95920046 [label="Migraine",color=purple];
		j2702204293 -> j3655402387 [label="Migraine",color=purple];
		j2702204293 -> j2504908136 [label="Migraine",color=purple];
		j2702204293 -> j643308018 [label="Migraine",color=purple];
		j2702204293 -> j2894012433 [label="false",color=purple];
		j2702204293 -> j95920046 [label="false",color=purple];
		j2702204293 -> j3655402387 [label="false",color=purple];
		j2702204293 -> j2504908136 [label="false",color=purple];
	j362871012 [label="为什么？",shape=box,color=blue];
		j362871012 -> j1053265429;
	j305475311 [label="我改天再跟你讲我第一次亲眼目睹的日食的故事。现在天色已晚，或许还很早，我也说不准。",shape=box,color=blue];
