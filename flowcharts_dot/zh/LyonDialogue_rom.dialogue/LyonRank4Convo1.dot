		745 -> 751 [label="Migraine",color=purple];
		745 -> 752 [label="Migraine",color=purple];
		745 -> 748 [label="false",color=purple];
		745 -> 749 [label="false",color=purple];
		745 -> 750 [label="false",color=purple];
		745 -> 751 [label="false",color=purple];
	755 [label="为什么？",shape=box,color=blue];
		755 -> 760;
	754 [label="我改天再跟你讲我第一次亲眼目睹的日食的故事。现在天色已晚，或许还很早，我也说不准。",shape=box,color=blue];
		754 -> 759;
	748 [label="我没有。",shape=box,color=red];
		748 -> 756;
	749 [label="我看过。感觉没那么惊艳。",shape=box,color=red];
		749 -> 757;
	750 [label="我看过。还行吧。",shape=box,color=red];
		750 -> 757;
	751 [label="我看过。非常壮观。",shape=box,color=red];
		751 -> 746;
	753 [label="我有看过。说出来你可能不信，它让我得了很严重的眼部​偏头风。但真的很壮观。",shape=box,color=red];
		753 -> 758;
	752 [label="我有看过。说出来你可能不信，它让我得了很严重的眼部偏头痛。但真的很壮观。",shape=box,color=red];
		752 -> 758;
	760 [label="这句话你是否觉得眼熟？“于静寂歧路，追寻日蚀——当日月汇聚，迷途者终将寻得归途。”",shape=box,color=red];
		760 -> 764;
	759 [label="Update boolean LyonFirstEclipse",color=orange];
		759 -> 762;
		759 -> 763;
	756 [label="如果有机会，一定要去看。",shape=box,color=blue];
		756 -> 746;
	757 [label="但愿我也能像你一样对这件事漠不关心……",shape=box,color=blue];
		757 -> 746;
	758 [label="你一定是受到了双耀神的感召，他们的存在让你感到难以承受。或许他们想惩罚你犯下的滔天罪行。反正都一样。呵呵。",shape=box,color=blue];
		758 -> 761;
	764 [label="是《月神正教经》的第三卷书——《塞莱斯廷书》18 章 19 节。你究竟是从哪里听来的？",shape=box,color=blue];
		764 -> 767;
		764 -> 768;
	762 [label="随时都可以。",shape=box,color=red];
		762 -> 765;
	763 [label="我很期待。里昂，谢谢你抽出时间。",shape=box,color=red];
		763 -> 766;
	761 [label="这就是神明的行事方式。他们的征兆往往可以有多种解读。",shape=box,color=blue];
		761 -> 754;
	767 [label="说来话长。但毋庸置疑，我认为你们的一些经文现在已经被虚空无情之物所用了。",shape=box,color=red];
		767 -> 770;
	768 [label="从一些老朋友那儿。他们用这句话作为间谍暗语的一部分，和他们的女儿……算了，其实没什么大不了的。",shape=box,color=red];
		768 -> 771;
	765 [label="+5 Chemistry",color=orange];
		765 -> 769;
