	769 [label="好​的，​嗯。​这……​似乎​不​可​避免​了。​",shape=box,color=blue];
		769 -> 772;
	773 [label="我……明白了。如果可以的话，关于这件事，我想尽快再问你一些问题。我现在还没做好准备，而且时间已经不早了。或许现在还早，我也不确定。",shape=box,color=blue];
