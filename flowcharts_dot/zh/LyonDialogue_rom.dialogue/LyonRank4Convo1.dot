	699 [label="Update boolean DrifterLiar",color=orange];
		699 -> 710;
	700 [label="Update boolean LyonSuspicious",color=orange];
		700 -> 710;
	701 [label="我想知道我们的信仰在多大程度上会相互影响，无论是有意还是无意。",shape=box,color=blue];
		701 -> 704;
	698 [label="太棒了！作为一名宗教学者，我真心希望我们能有时间深入地互相学习各自的信仰。",shape=box,color=blue];
		698 -> 704;
	695 [label="说来话长。",shape=box,color=red];
		695 -> 707;
	696 [label="我​研究​过​很​多​种​不同​的​宗教，​但​没有​一​种​真正​适合​我。​最终，​我​悟出​了​一​个​有点​怪异​的​人性​集合体。​",shape=box,color=red];
		696 -> 708;
	697 [label="我相信自己的感觉。我不需要某个建筑或书籍来告诉我那是什么。",shape=box,color=red];
		697 -> 709;
	690 [label="真的吗？我……很惊讶。惊讶之余，也很高兴。难怪你会好奇。我们的教义一定与你所了解的截然不同。毕竟时间已经过去这么久了。",shape=box,color=blue];
		690 -> 704;
	691 [label="我尊重你的看法。认识到我们无法知晓的事物，认识到人类境况的渺小，这本身就是一种荣耀。",shape=box,color=blue];
		691 -> 704;
	692 [label="请​相信​我，​我​并​没有​被​冒犯到。​在​很多​情况​下，​你​的​说法​完全​正确。​",shape=box,color=blue];
		692 -> 705;
		692 -> 706;
	693 [label="我承认，我羡慕你从不为死后的世界忧虑。要是其他人也能如此就好了，我们的世界或许会更加和平。",shape=box,color=blue];
		693 -> 704;
	694 [label="这是一个我很想和你深入探讨的话题。只是现在还不是时候，我还没有准备好进行这样的讨论。",shape=box,color=blue];
		694 -> 704;
	688 [label="这是一个明智的开头。了解一个文化，就如同了解它的灵魂。因为一个民族如何庆祝，就决定了他们将被后人铭记的方式。因为那些共同经历的时刻，是那些最珍贵的回忆。",shape=box,color=blue];
		688 -> 702;
	689 [label="当然可以。我们先从你可能已经知道的说起：太阳神和月神。他们是永恒变化的神祇。",shape=box,color=blue];
		689 -> 703;
	710 [label="嗯。​那​就​先​让​我​来​解答​你​的​问题。​为了​避免​让​你​感到​无聊，​你​想​从​哪里​开始​呢？​",shape=box,color=blue];
		710 -> 665;
		710 -> 664;
	704 [label="是我疏忽了，没有围绕主题说。恐怕我已经远远离题。",shape=box,color=blue];
		704 -> 714;
	707 [label="+20 Chemistry",color=orange];
		707 -> 717;
	708 [label="+20 Chemistry",color=orange];
		708 -> 718;
	709 [label="+20 Chemistry",color=orange];
		709 -> 719;
	705 [label="不过这并不代表我不愿意继续学习。",shape=box,color=red];
		705 -> 715;
	706 [label="你的情况又如何呢？",shape=box,color=red];
		706 -> 716;
	702 [label="我们最主要、最常见的节日是仲冬节和仲夏节，分别标志着一年中白昼最短和最长的一天。",shape=box,color=blue];
		702 -> 711;
	703 [label="多个世纪以来，他们以多种形象出现在众多信徒面前。有时是男性，有时是女性。但始终是太阳神和月神。",shape=box,color=blue];
		703 -> 712;
		703 -> 713;
	714 [label="你想了解双耀神的正教，对吗？为了避免让你感到无聊，你想从哪里开始呢？",shape=box,color=blue];
		714 -> 665;
		714 -> 664;
	717 [label="嗯。这种事最好跟信任的朋友说。我完全理解。再说，是你来问我问题，而不是我来问你。",shape=box,color=blue];
		717 -> 704;
	718 [label="灵魂的彩色玻璃窗。分开时破碎不堪，但重新拼合时却能描绘出一幅异常美丽的画面。",shape=box,color=blue];
		718 -> 704;
	719 [label="如果​世人​与​你​拥有​相同​的​信仰，​那​将​会​是​一​个​更​美​好​的​世界。​",shape=box,color=blue];
		719 -> 704;
	715 [label="为此，我赞赏你的好奇心和求知欲。 ",shape=box,color=blue];
		715 -> 704;
	716 [label="我的情况……很复杂。但我不会撒谎说我从未感到恐惧。尽管宗教给我的生活带来了无尽的恐惧，它也从未消除过我的恐惧。",shape=box,color=blue];
		716 -> 704;
	711 [label="这两个节日都以盛宴为标志，但它们的区别在于与谁共进宴席。仲冬节是与家人和挚友共享的节日，而仲夏节则是与陌生人共享的节日。",shape=box,color=blue];
		711 -> 720;
		711 -> 721;
	712 [label="哦，怪不得。",shape=box,color=red];
		712 -> 722;
	713 [label="[让他继续]",shape=box,color=red];
		713 -> 723;
	720 [label="真的吗？跟我说说仲夏节吧。",shape=box,color=red];
		720 -> 724;
	721 [label="跟我说说仲冬节吧。",shape=box,color=red];
		721 -> 725;
	722 [label="是的，有些教派在圣像的选择上可能比较严格，宣称太阳神“必须”是这样或“必须”是那样，但正教并不承认这是真理。",shape=box,color=blue];
		722 -> 726;
	723 [label="圣光双神中的两个神都蕴含着多重身份。每一种身份都可以被视为整体的一个组成部分。例如，月神既是母亲，又是少女，又是老妪。",shape=box,color=blue];
		723 -> 731;
	724 [label="仲​夏节​是​分享丰收​成果、​让​素​未​谋面​的​陌生​人​相聚​的​日子。​人们​会​聚集​在​田野​里，​带来​自己​制作​的​食物​和​物品，​带​什么​都​可以。​",shape=box,color=blue];
		724 -> 728;
	725 [label="仲​冬节​是​抵御​严寒、​感恩​那些​在​最​黑暗​的​时刻​给​予​我们​温暖​的​人​的​日子。​人们​用​蜡烛​装​饰​星树，​每​一​盏​灯​都​代表​一​位​先人，​他们​如同​天​上​的​繁星，​指​引​着​我们​前行​的​道路。​",shape=box,color=blue];
		725 -> 729;
	726 [label="我估计，关于我们信仰流传至今的记载，最终会变得……有些混乱。",shape=box,color=blue];
		726 -> 730;
	731 [label="但月神也可以是引领灵魂沿着泪河走向无尽黑夜的那一位。即死神本身、先驱者和使者。",shape=box,color=blue];
		731 -> 734;
	728 [label="蜡烛、面包、衣物、画作，或是诗集，或是花环。即便空手而来，但“带着喜讯”，也被视为一种祝福。",shape=box,color=blue];
		728 -> 732;
	729 [label="而头顶上的太阳神，在黑暗中，于星树之巅饱受煎熬。他虽已黯淡，却未被遗忘。因为这是月神的时代。在这阴影笼罩的时刻，我们颂扬她。",shape=box,color=blue];
		729 -> 733;
	730 [label="我发现自己成了一件活着的考古文物。真令人沮丧。不过，我扯远了。",shape=box,color=blue];
		730 -> 723;
	734 [label="在其他教派中，死神是一位蒙着面纱的老妇人。虽然各有不同，但都指向同一个精神层面，那就是在生命的最后一刻，那只银色的手指引着我们。",shape=box,color=blue];
		734 -> 737;
	732 [label="在这个漫长的太阳神之日中，人们庆祝生命——欢笑——音乐——分享这一切。 ",shape=box,color=blue];
		732 -> 735;
	733 [label="当我们围坐一桌，享用烤禽、根茎类蔬菜以及所有在冰冻土地上无法新鲜生长的食材时，我们拥抱着我们所爱的人，讲述着那些逝去亲人的故事。",shape=box,color=blue];
		733 -> 736;
	737 [label="日食期间，月亮遮蔽了太阳，在看似一切都已失去的十字路口，指引着我们前行。",shape=box,color=blue];
		737 -> 739;
	735 [label="所有人都可以结识陌生人并交朋友，还可以带走自己需要的东西。",shape=box,color=blue];
		735 -> 738;
	736 [label="在月神最漫长的夜晚，我们铭记着，她最终会指引我们和我们的家人度过难关。",shape=box,color=blue];
		736 -> 738;
	739 [label="Update boolean DrifterEclipse",color=orange];
		739 -> 741;
	738 [label="但对双耀神信徒来说，最神圣的节日是至善日。这是一个罕见的现象，当太阳和月亮完美对齐，形成一次完美的日食或月食时就是这个节日。",shape=box,color=blue];
		738 -> 740;
	741 [label="Check boolean VelimirEclipse",color=orange];
		741 -> 744 [label=true,color=green];
		741 -> 743 [label=false,color=brown];
	740 [label="这是一个奇妙而神圣的景象，大自然万物都在响应。你有没有幸亲眼目睹过呢？",shape=box,color=blue];
		740 -> 742;
	744 [label="等一下……",shape=box,color=red];
		744 -> 747;
	743 [label="你亲眼见过日食吗？",shape=box,color=red];
		743 -> 746;
	742 [label="Update boolean DrifterEclipse",color=orange];
		742 -> 745;
	747 [label="这看起来……非常眼熟。",shape=box,color=red];
		747 -> 755;
	746 [label="我有幸两次亲眼见证。两次都让我感到……震撼人心。如果可以，我真想永远停留在那短暂的瞬间。",shape=box,color=blue];
		746 -> 754;
	745 [label="Evaluate expressions",color=orange];
		745 -> 748 [label="Megrim",color=purple];
		745 -> 749 [label="Megrim",color=purple];
		745 -> 750 [label="Megrim",color=purple];
		745 -> 751 [label="Megrim",color=purple];
