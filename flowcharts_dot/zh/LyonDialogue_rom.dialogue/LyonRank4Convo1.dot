		663 -> 675 [label="DrifterFaithNoMITW",color=purple];
		663 -> 675 [label="false",color=purple];
	662 [label="恐怕我可以详细讨论的话题太多了。不过别误会，我很乐意，只是不想让你觉得太无聊。你想从哪里开始呢？",shape=box,color=blue];
		662 -> 664;
		662 -> 665;
	675 [label="不，我只是好奇而已。",shape=box,color=red];
		675 -> 686;
	676 [label="我有信仰。我的信仰和你的很相似，虽然你可能认不出来。",shape=box,color=red];
		676 -> 687;
	674 [label="我有信仰。不过，你肯定认不出我们的宗教习俗。",shape=box,color=red];
		674 -> 685;
	673 [label="我有信仰。这是一种我个人的信仰——它并没有一个确切的名称。",shape=box,color=red];
		673 -> 684;
	672 [label="和​玛丽​一样，​我​追随​太​阳神​之道。​",shape=box,color=red];
		672 -> 679;
	671 [label="我和你一样，也追随月神之道。",shape=box,color=red];
		671 -> 679;
	666 [label="我追随双耀神，但我在努力保持平衡的道路。",shape=box,color=red];
		666 -> 679;
	667 [label="我相信一定会有神的存在，但我认为最终人们都不可能真正知道答案。",shape=box,color=red];
		667 -> 680;
	668 [label="我没有信仰。我个人认为宗教是恐惧者的拐杖——无意冒犯。",shape=box,color=red];
		668 -> 681;
	669 [label="我没有信仰。我不会说这世上绝对没有宗教，但这并非我所担忧的事情。",shape=box,color=red];
		669 -> 682;
	670 [label="我没有信仰。我认为所有的神——甚至包括虚空无情之物——都是我们想象的产物。无意冒犯。",shape=box,color=red];
		670 -> 683;
	664 [label="你能跟我说说你的假期吗？",shape=box,color=red];
		664 -> 677;
	665 [label="你能给我讲讲太阳神和月神吗？",shape=box,color=red];
		665 -> 678;
