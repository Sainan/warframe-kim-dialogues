digraph {
	2100 [label="LyonRank5Convo9 begins.",color=orange];
		2100 -> 2101;
	2101 [label="Evaluate expressions",color=orange];
		2101 -> 2102 [label="LyonDating, LyonDatingConfession",color=purple];
		2101 -> 2103 [label="LyonDating",color=purple];
		2101 -> 2102 [label="false",color=purple];
	2102 [label="Chat ends.",color=orange];
	2103 [label="Mon miracle，我……必须确保你清楚明白一件事，才能告诉你我的下一个轶事。 ",shape=box,color=blue];
		2103 -> 2104;
	2104 [label="你必须全神贯注地听我接下来要说的话。明白吗？",shape=box,color=blue];
		2104 -> 2105;
		2104 -> 2106;
	2105 [label="你让我很紧张。怎么了？",shape=box,color=red];
		2105 -> 2107;
	2106 [label="明白，我在听。请说。",shape=box,color=red];
		2106 -> 2108;
	2107 [label="并非出了什么问题——恰恰相反。这正是你必须理解的关键——我试图让你免于承受的，正是那些你认定会随之而来的可怕后果。",shape=box,color=blue];
		2107 -> 2109;
		2107 -> 2110;
		2107 -> 2111;
	2108 [label="+5 Chemistry",color=orange];
		2108 -> 2112;
	2109 [label="我在听。",shape=box,color=red];
		2109 -> 2113;
	2110 [label="你说的完全不合逻辑。",shape=box,color=red];
		2110 -> 2114;
	2111 [label="可怕后果……是什么？",shape=box,color=red];
		2111 -> 2115;
	2112 [label="谢谢。在开始之前，我想向你保证一切安好——然而，我试图让你免于承受的，正是那些你认定会随之而来的可怕后果。",shape=box,color=blue];
		2112 -> 2109;
		2112 -> 2110;
		2112 -> 2111;
	2113 [label="+5 Chemistry",color=orange];
		2113 -> 2116;
	2114 [label="是的。我对此深有体会。",shape=box,color=blue];
		2114 -> 2115;
	2115 [label="请允许我重新开始。",shape=box,color=blue];
		2115 -> 2116;
	2116 [label="我深知自己可能被许多人解读为——事实上，现实中很可能确实如此——一个……不正常的人。至少，我的精神状态远非完全健全。",shape=box,color=blue];
		2116 -> 2117;
	2117 [label="我早已与这一切和解。它不再困扰我。那些折磨我的异象——那些声音——我已学会与之共处，不再恐惧也不再憎恨。",shape=box,color=blue];
		2117 -> 2118;
	2118 [label="（最近，说实话，我倒觉得这多少有些出于报复心理，不过这无关紧要。）",shape=box,color=blue];
		2118 -> 2119;
	2119 [label="但我希望你明白，如果你要结束我们之间的这段关系，这段我曾以为此生不可能与他人建立的羁绊——",shape=box,color=blue];
		2119 -> 2120;
	2120 [label="如果你的心某天真的从我身边飘然远去？ ",shape=box,color=blue];
		2120 -> 2121;
	2121 [label="我自会承受，mon miracle。",shape=box,color=blue];
		2121 -> 2122;
	2122 [label="我不会被困扰我的那些东西吞噬。 ",shape=box,color=blue];
		2122 -> 2123;
	2123 [label="Check boolean LyonAllRight",color=orange];
		2123 -> 2125 [label=true,color=green];
		2123 -> 2124 [label=false,color=brown];
	2125 [label="用你的俗语来说，我会“没事的”。我会找到再次微笑和欢笑的理由。",shape=box,color=blue];
		2125 -> 2126;
		2125 -> 2127;
	2124 [label="我会挺过去。我会好起来。我会找到再次微笑和欢笑的理由。",shape=box,color=blue];
		2124 -> 2126;
		2124 -> 2127;
	2126 [label="哦，里昂……你对我来说，从来都不是负担。",shape=box,color=red];
		2126 -> 2128;
	2127 [label="你……是说想结束我们之间的关系？",shape=box,color=red];
		2127 -> 2129;
	2128 [label="我只是想让你摆脱因我而产生的任何困扰……",shape=box,color=blue];
		2128 -> 2130;
		2128 -> 2131;
		2128 -> 2132;
	2129 [label="不！绝无此事！我只是想让你摆脱因我而产生的任何困扰。",shape=box,color=blue];
		2129 -> 2130;
		2129 -> 2131;
		2129 -> 2132;
	2130 [label="你的痛苦……与我内心某种痛楚相呼应。帮助你度过难关，对我而言永远不是负担。",shape=box,color=red];
		2130 -> 2133;
	2131 [label="我无法形容你对我的吸引力。但你永远不会成为责任或负担。",shape=box,color=red];
		2131 -> 2134;
	2132 [label="[分手] 这一切对我而言已不堪重负，抱歉。或许到此为止才是最好的选择。",shape=box,color=red];
		2132 -> 2135;
	2133 [label="我无法言喻自己因你而心碎的程度。但永远感激的是，我们孤独痛苦的幽魂终于彼此相遇。",shape=box,color=blue];
		2133 -> 2136;
	2134 [label="对此我无从表达感激，我想任何言语都无法承载这份心意。",shape=box,color=blue];
		2134 -> 2136;
	2135 [label="是的。当然。在此时此刻接受任何其他答案……都显得虚伪…… ",shape=box,color=blue];
		2135 -> 2137;
	2136 [label="但既然我已经费尽心力写了这段堪称极致自恋的铺垫……",shape=box,color=blue];
		2136 -> 2138;
		2136 -> 2139;
		2136 -> 2140;
	2137 [label="我完全理解。愿你永远幸福。我会永远珍藏我们共度的每一刻时光。",shape=box,color=blue];
		2137 -> 2141;
	2138 [label="一个刚开始沉默寡言的人，现在倒真是能说会道起来了。",shape=box,color=red];
		2138 -> 2142;
	2139 [label="别担心，我觉得它们很可爱。",shape=box,color=red];
		2139 -> 2143;
	2140 [label="你完全可以直接说：“如果我们真的分道扬镳，我也会过得很好。”",shape=box,color=red];
		2140 -> 2144;
	2141 [label="纵使记忆褪色，灵魂仍将铭刻。再见了。",shape=box,color=blue];
		2141 -> 2145;
	2142 [label="+5 Chemistry",color=orange];
		2142 -> 2146;
	2143 [label="+5 Chemistry",color=orange];
		2143 -> 2147;
	2144 [label="+5 Chemistry",color=orange];
		2144 -> 2148;
	2145 [label="Update boolean LyonDating",color=orange];
		2145 -> 2149;
	2146 [label="呸！若你不想窥见我脑海中的思绪，就不该到处乱探。这全是你咎由自取。",shape=box,color=blue];
		2146 -> 2150;
	2147 [label="很高兴你喜欢我的絮叨。正因如此，我才选择如此寡言。你能想象若当面听这些会怎样吗？玛丽早该把我当疯狗一样揍扁了。",shape=box,color=blue];
		2147 -> 2150;
	2148 [label="你天生就带着某种不羁与讽讥之气，这是我永远望尘莫及的高度。就留给你去展现吧。",shape=box,color=blue];
		2148 -> 2150;
	2149 [label="Update boolean IsDating",color=orange];
		2149 -> 2151;
	2150 [label="不过，这一切不过是为接下来的故事铺垫——相比之下，这个故事显得相当简短……",shape=box,color=blue];
		2150 -> 2152;
	2151 [label="——里昂",shape=box,color=blue];
		2151 -> 2153;
	2152 [label="昨夜我从噩梦中惊醒。醒来时，阴影已将我团团围住。这种状态对我来说并不陌生。它们在床边萦绕盘旋，久久不肯散去。",shape=box,color=blue];
		2152 -> 2154;
	2153 [label="Chat ends.",color=orange];
	2154 [label="我并不惧怕它们，因我深知它们无法伤害我。然而它们也始终萦绕心头，挥之不去。我知道只有一种方法能摆脱它们。",shape=box,color=blue];
		2154 -> 2155;
	2155 [label="我撑身下床，在持续噩梦的模糊视野中踉跄前行，勉强穿好衣物。抓起聚能焚炉跪倒在地板中央，准备……嗯。 ",shape=box,color=blue];
		2155 -> 2156;
	2156 [label="准备“净化心灵”。就此打住。",shape=box,color=blue];
		2156 -> 2157;
	2157 [label="但当我闭上双眼，思绪却飘向远方。我的心绪飘荡……飘向了你，mon miracle……",shape=box,color=blue];
		2157 -> 2158;
	2158 [label="你的声音。你手掌抚过我肩头的触感…… ",shape=box,color=blue];
		2158 -> 2159;
	2159 [label="那些异象……尽数消散。它们落荒而逃，被更强大的幽灵……你的幽灵驱散了。",shape=box,color=blue];
		2159 -> 2160;
	2160 [label="我……站了起来。将聚能焚炉放在床头柜上，然后……选择踏过圣所的沙地前行……",shape=box,color=blue];
		2160 -> 2161;
		2160 -> 2162;
	2161 [label="现在我明白你为什么觉得需要这个铺垫了。",shape=box,color=red];
		2161 -> 2163;
	2162 [label="我不知道该说什么……",shape=box,color=red];
		2162 -> 2164;
	2163 [label="是的。嗯。散步时我……突然意识到这种时刻暗藏的危险。你可能会……开始觉得这是种责任——开始视我为桎梏你的枷锁。",shape=box,color=blue];
		2163 -> 2165;
	2164 [label="+5 Chemistry",color=orange];
		2164 -> 2166;
	2165 [label="我恳求你——我祈祷，无论向天上还是地下的神——愿你永不如此。这是你赠予我的礼物，每次当它焕发新生时，我都会珍视它。",shape=box,color=blue];
		2165 -> 2167;
	2166 [label="无需言语，mon miracle…… ",shape=box,color=blue];
		2166 -> 2168;
	2167 [label="向我发誓吧，mon miracle——如果真有那么一天，我对你而言成了空荡的牢笼……你便从我这里获得自由。",shape=box,color=blue];
		2167 -> 2169;
	2168 [label="散步时我……突然意识到这种时刻暗藏的危险。你可能会……开始觉得这是种责任——开始视我为桎梏你的枷锁。",shape=box,color=blue];
		2168 -> 2165;
	2169 [label="我绝不会成为所爱之人的空洞牢笼。不会对你如此。不会对玛丽如此。",shape=box,color=blue];
		2169 -> 2170;
		2169 -> 2171;
	2170 [label="[分手] 我——我做不到。我无法许下这个承诺，对不起。",shape=box,color=red];
		2170 -> 2172;
	2171 [label="我发誓。 ",shape=box,color=red];
		2171 -> 2173;
	2172 [label="+10 Chemistry",color=orange];
		2172 -> 2174;
	2173 [label="+10 Chemistry",color=orange];
		2173 -> 2175;
	2174 [label="谢谢你。谢谢你，mon miracle，感谢你的坦诚。在这个时刻说出这些需要勇气，我为此向你致敬。",shape=box,color=blue];
		2174 -> 2176;
	2175 [label="谢谢你。谢谢你，mon miracle……",shape=box,color=blue];
		2175 -> 2177;
	2176 [label="我会珍藏我们共度的每一刻。这份珍视，远超你的想象。",shape=box,color=blue];
		2176 -> 2178;
	2177 [label="我突然感到无比疲惫，仿佛……肩上的重担终于卸下了。恐怕我得去躺下歇歇了。",shape=box,color=blue];
		2177 -> 2179;
	2178 [label="纵使记忆褪色，灵魂仍将铭刻。再见了。",shape=box,color=blue];
		2178 -> 2180;
	2179 [label="——里昂",shape=box,color=blue];
		2179 -> 2181;
	2180 [label="Update boolean LyonDating",color=orange];
		2180 -> 2182;
	2181 [label="Update boolean LyonDatingConfession",color=orange];
		2181 -> 2183;
	2182 [label="Update boolean IsDating",color=orange];
		2182 -> 2184;
	2183 [label="Chat ends.",color=orange];
	2184 [label="——里昂",shape=box,color=blue];
		2184 -> 2185;
	2185 [label="Chat ends.",color=orange];
}