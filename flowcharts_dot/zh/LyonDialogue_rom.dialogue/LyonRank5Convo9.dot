digraph {
	"LyonRank5Convo9 begins." [color=orange];
		"LyonRank5Convo9 begins." -> j3594191379;
	j3594191379 [label="Evaluate expressions",color=orange];
		j3594191379 -> "Chat ends." [label="LyonDating, LyonDatingConfession",color=purple];
		j3594191379 -> j4068903269 [label="LyonDating",color=purple];
		j3594191379 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j4068903269 [label="Mon miracle，我……必须确保你清楚明白一件事，才能告诉你我的下一个轶事。 ",shape=box,color=blue];
		j4068903269 -> j1648174719;
	j1648174719 [label="你必须全神贯注地听我接下来要说的话。明白吗？",shape=box,color=blue];
		j1648174719 -> j4176357629;
		j1648174719 -> j756713331;
	j4176357629 [label="你让我很紧张。怎么了？",shape=box,color=red];
		j4176357629 -> j3348424548;
	j756713331 [label="明白，我在听。请说。",shape=box,color=red];
		j756713331 -> j510485681;
	j3348424548 [label="并非出了什么问题——恰恰相反。这正是你必须理解的关键——我试图让你免于承受的，正是那些你认定会随之而来的可怕后果。",shape=box,color=blue];
		j3348424548 -> j2825731931;
		j3348424548 -> j3757602551;
		j3348424548 -> j1816631144;
	j510485681 [label="+5 Chemistry",color=orange];
		j510485681 -> j662339773;
	j2825731931 [label="我在听。",shape=box,color=red];
		j2825731931 -> j2505657283;
	j3757602551 [label="你说的完全不合逻辑。",shape=box,color=red];
		j3757602551 -> j2167314521;
	j1816631144 [label="可怕后果……是什么？",shape=box,color=red];
		j1816631144 -> j1525608198;
	j662339773 [label="谢谢。在开始之前，我想向你保证一切安好——然而，我试图让你免于承受的，正是那些你认定会随之而来的可怕后果。",shape=box,color=blue];
		j662339773 -> j2825731931;
		j662339773 -> j3757602551;
		j662339773 -> j1816631144;
	j2505657283 [label="+5 Chemistry",color=orange];
		j2505657283 -> j2263195365;
	j2167314521 [label="是的。我对此深有体会。",shape=box,color=blue];
		j2167314521 -> j1525608198;
	j1525608198 [label="请允许我重新开始。",shape=box,color=blue];
		j1525608198 -> j2263195365;
	j2263195365 [label="我深知自己可能被许多人解读为——事实上，现实中很可能确实如此——一个……不正常的人。至少，我的精神状态远非完全健全。",shape=box,color=blue];
		j2263195365 -> j2552217689;
	j2552217689 [label="我早已与这一切和解。它不再困扰我。那些折磨我的异象——那些声音——我已学会与之共处，不再恐惧也不再憎恨。",shape=box,color=blue];
		j2552217689 -> j3006517061;
	j3006517061 [label="（最近，说实话，我倒觉得这多少有些出于报复心理，不过这无关紧要。）",shape=box,color=blue];
		j3006517061 -> j2077319679;
	j2077319679 [label="但我希望你明白，如果你要结束我们之间的这段关系，这段我曾以为此生不可能与他人建立的羁绊——",shape=box,color=blue];
		j2077319679 -> j3538165692;
	j3538165692 [label="如果你的心某天真的从我身边飘然远去？ ",shape=box,color=blue];
		j3538165692 -> j1250845159;
	j1250845159 [label="我自会承受，mon miracle。",shape=box,color=blue];
		j1250845159 -> j2119649163;
	j2119649163 [label="我不会被困扰我的那些东西吞噬。 ",shape=box,color=blue];
		j2119649163 -> j2851720794;
	j2851720794 [label="Check boolean LyonAllRight",color=orange];
		j2851720794 -> j1169353273 [label=true,color=green];
		j2851720794 -> j3342096233 [label=false,color=brown];
	j1169353273 [label="用你的俗语来说，我会“没事的”。我会找到再次微笑和欢笑的理由。",shape=box,color=blue];
		j1169353273 -> j3914536761;
		j1169353273 -> j1746904281;
	j3342096233 [label="我会挺过去。我会好起来。我会找到再次微笑和欢笑的理由。",shape=box,color=blue];
		j3342096233 -> j3914536761;
		j3342096233 -> j1746904281;
	j3914536761 [label="哦，里昂……你对我来说，从来都不是负担。",shape=box,color=red];
		j3914536761 -> j642751876;
	j1746904281 [label="你……是说想结束我们之间的关系？",shape=box,color=red];
		j1746904281 -> j2319815847;
	j642751876 [label="我只是想让你摆脱因我而产生的任何困扰……",shape=box,color=blue];
		j642751876 -> j1671491638;
		j642751876 -> j3429628509;
		j642751876 -> j4105888485;
	j2319815847 [label="不！绝无此事！我只是想让你摆脱因我而产生的任何困扰。",shape=box,color=blue];
		j2319815847 -> j1671491638;
		j2319815847 -> j3429628509;
		j2319815847 -> j4105888485;
	j1671491638 [label="你的痛苦……与我内心某种痛楚相呼应。帮助你度过难关，对我而言永远不是负担。",shape=box,color=red];
		j1671491638 -> j1708253853;
	j3429628509 [label="我无法形容你对我的吸引力。但你永远不会成为责任或负担。",shape=box,color=red];
		j3429628509 -> j1355277004;
	j4105888485 [label="[分手] 这一切对我而言已不堪重负，抱歉。或许到此为止才是最好的选择。",shape=box,color=red];
		j4105888485 -> j2079164388;
	j1708253853 [label="我无法言喻自己因你而心碎的程度。但永远感激的是，我们孤独痛苦的幽魂终于彼此相遇。",shape=box,color=blue];
		j1708253853 -> j379928545;
	j1355277004 [label="对此我无从表达感激，我想任何言语都无法承载这份心意。",shape=box,color=blue];
		j1355277004 -> j379928545;
	j2079164388 [label="是的。当然。在此时此刻接受任何其他答案……都显得虚伪…… ",shape=box,color=blue];
		j2079164388 -> j3054693092;
	j379928545 [label="但既然我已经费尽心力写了这段堪称极致自恋的铺垫……",shape=box,color=blue];
		j379928545 -> j2246844095;
		j379928545 -> j4191155223;
		j379928545 -> j801002208;
	j3054693092 [label="我完全理解。愿你永远幸福。我会永远珍藏我们共度的每一刻时光。",shape=box,color=blue];
		j3054693092 -> j2319541193;
	j2246844095 [label="一个刚开始沉默寡言的人，现在倒真是能说会道起来了。",shape=box,color=red];
		j2246844095 -> j2297872586;
	j4191155223 [label="别担心，我觉得它们很可爱。",shape=box,color=red];
		j4191155223 -> j3935685409;
	j801002208 [label="你完全可以直接说：“如果我们真的分道扬镳，我也会过得很好。”",shape=box,color=red];
		j801002208 -> j315375791;
	j2319541193 [label="纵使记忆褪色，灵魂仍将铭刻。再见了。",shape=box,color=blue];
		j2319541193 -> j3769853518;
	j2297872586 [label="+5 Chemistry",color=orange];
		j2297872586 -> j4116030698;
	j3935685409 [label="+5 Chemistry",color=orange];
		j3935685409 -> j519906844;
	j315375791 [label="+5 Chemistry",color=orange];
		j315375791 -> j3827532908;
	j3769853518 [label="Boolean LyonDating is now false.",color=orange];
		j3769853518 -> j1786736805;
	j4116030698 [label="呸！若你不想窥见我脑海中的思绪，就不该到处乱探。这全是你咎由自取。",shape=box,color=blue];
		j4116030698 -> j2241610832;
	j519906844 [label="很高兴你喜欢我的絮叨。正因如此，我才选择如此寡言。你能想象若当面听这些会怎样吗？玛丽早该把我当疯狗一样揍扁了。",shape=box,color=blue];
		j519906844 -> j2241610832;
	j3827532908 [label="你天生就带着某种不羁与讽讥之气，这是我永远望尘莫及的高度。就留给你去展现吧。",shape=box,color=blue];
		j3827532908 -> j2241610832;
	j1786736805 [label="Boolean IsDating is now false.",color=orange];
		j1786736805 -> j3657611099;
	j2241610832 [label="不过，这一切不过是为接下来的故事铺垫——相比之下，这个故事显得相当简短……",shape=box,color=blue];
		j2241610832 -> j3103537932;
	j3657611099 [label="——里昂",shape=box,color=blue];
		j3657611099 -> "Chat ends.";
	j3103537932 [label="昨夜我从噩梦中惊醒。醒来时，阴影已将我团团围住。这种状态对我来说并不陌生。它们在床边萦绕盘旋，久久不肯散去。",shape=box,color=blue];
		j3103537932 -> j69712276;
	j69712276 [label="我并不惧怕它们，因我深知它们无法伤害我。然而它们也始终萦绕心头，挥之不去。我知道只有一种方法能摆脱它们。",shape=box,color=blue];
		j69712276 -> j3980612129;
	j3980612129 [label="我撑身下床，在持续噩梦的模糊视野中踉跄前行，勉强穿好衣物。抓起聚能焚炉跪倒在地板中央，准备……嗯。 ",shape=box,color=blue];
		j3980612129 -> j1672766579;
	j1672766579 [label="准备“净化心灵”。就此打住。",shape=box,color=blue];
		j1672766579 -> j4141410461;
	j4141410461 [label="但当我闭上双眼，思绪却飘向远方。我的心绪飘荡……飘向了你，mon miracle……",shape=box,color=blue];
		j4141410461 -> j2888016762;
	j2888016762 [label="你的声音。你手掌抚过我肩头的触感…… ",shape=box,color=blue];
		j2888016762 -> j965057966;
	j965057966 [label="那些异象……尽数消散。它们落荒而逃，被更强大的幽灵……你的幽灵驱散了。",shape=box,color=blue];
		j965057966 -> j2438364385;
	j2438364385 [label="我……站了起来。将聚能焚炉放在床头柜上，然后……选择踏过圣所的沙地前行……",shape=box,color=blue];
		j2438364385 -> j352987565;
		j2438364385 -> j2535091678;
	j352987565 [label="现在我明白你为什么觉得需要这个铺垫了。",shape=box,color=red];
		j352987565 -> j1336004529;
	j2535091678 [label="我不知道该说什么……",shape=box,color=red];
		j2535091678 -> j3630637281;
	j1336004529 [label="是的。嗯。散步时我……突然意识到这种时刻暗藏的危险。你可能会……开始觉得这是种责任——开始视我为桎梏你的枷锁。",shape=box,color=blue];
		j1336004529 -> j2702711353;
	j3630637281 [label="+5 Chemistry",color=orange];
		j3630637281 -> j1425055633;
	j2702711353 [label="我恳求你——我祈祷，无论向天上还是地下的神——愿你永不如此。这是你赠予我的礼物，每次当它焕发新生时，我都会珍视它。",shape=box,color=blue];
		j2702711353 -> j848143903;
	j1425055633 [label="无需言语，mon miracle…… ",shape=box,color=blue];
		j1425055633 -> j59248715;
	j848143903 [label="向我发誓吧，mon miracle——如果真有那么一天，我对你而言成了空荡的牢笼……你便从我这里获得自由。",shape=box,color=blue];
		j848143903 -> j1905044932;
	j59248715 [label="散步时我……突然意识到这种时刻暗藏的危险。你可能会……开始觉得这是种责任——开始视我为桎梏你的枷锁。",shape=box,color=blue];
		j59248715 -> j2702711353;
	j1905044932 [label="我绝不会成为所爱之人的空洞牢笼。不会对你如此。不会对玛丽如此。",shape=box,color=blue];
		j1905044932 -> j1135170884;
		j1905044932 -> j827034121;
	j1135170884 [label="[分手] 我——我做不到。我无法许下这个承诺，对不起。",shape=box,color=red];
		j1135170884 -> j616705855;
	j827034121 [label="我发誓。 ",shape=box,color=red];
		j827034121 -> j1210312736;
	j616705855 [label="+10 Chemistry",color=orange];
		j616705855 -> j1600917975;
	j1210312736 [label="+10 Chemistry",color=orange];
		j1210312736 -> j3365793437;
	j1600917975 [label="谢谢你。谢谢你，mon miracle，感谢你的坦诚。在这个时刻说出这些需要勇气，我为此向你致敬。",shape=box,color=blue];
		j1600917975 -> j1696381631;
	j3365793437 [label="谢谢你。谢谢你，mon miracle……",shape=box,color=blue];
		j3365793437 -> j1148481610;
	j1696381631 [label="我会珍藏我们共度的每一刻。这份珍视，远超你的想象。",shape=box,color=blue];
		j1696381631 -> j2319541193;
	j1148481610 [label="我突然感到无比疲惫，仿佛……肩上的重担终于卸下了。恐怕我得去躺下歇歇了。",shape=box,color=blue];
		j1148481610 -> j1864845913;
	j1864845913 [label="——里昂",shape=box,color=blue];
		j1864845913 -> j3446510588;
	j3446510588 [label="Boolean LyonDatingConfession is now true.",color=orange];
		j3446510588 -> "Chat ends.";
}