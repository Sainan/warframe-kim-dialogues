digraph {
	1556 [label="LyonRank5Convo3 begins.",color=orange];
		1556 -> 1557;
	1557 [label="Evaluate expressions",color=orange];
		1557 -> 1559 [label="LyonDating",color=purple];
		1557 -> 1560 [label="LyonConvession1",color=purple];
		1557 -> 1560 [label="LyonRell2a",color=purple];
		1557 -> 1560 [label="LyonRell2b",color=purple];
		1557 -> 1560 [label="LyonRell1",color=purple];
		1557 -> 1558 [label="false",color=purple];
	1559 [label="mon miracle，我知道这不值得骄傲，但我把一整瓶酒都喝了，现在我准备把我一直拼命想隐瞒的事情告诉你……",shape=box,color=blue];
		1559 -> 1561;
	1560 [label="我知道这不值得骄傲，但我把一整瓶酒都喝了，现在我准备把我一直拼命想隐瞒的事情告诉你……",shape=box,color=blue];
		1560 -> 1561;
	1558 [label="Chat ends.",color=orange];
	1561 [label="如果这瓶酒真的是葡萄酒的话，因为它的标签上并没有明确标明——而且洛德先生也不确定我们那个年代的葡萄酒和他所理解的葡萄酒是不是同一种东西。",shape=box,color=blue];
		1561 -> 1562;
	1562 [label="我辩解说，我并没有打算喝光整瓶……我只是想确认一下它是否真的是同一种物质，然后它就不见了……",shape=box,color=blue];
		1562 -> 1563;
		1562 -> 1564;
		1562 -> 1565;
	1563 [label="不，我现在不想听。",shape=box,color=red];
		1563 -> 1566;
	1564 [label="味道是一样的吗？",shape=box,color=red];
		1564 -> 1567;
	1565 [label="你喝醉了吗？",shape=box,color=red];
		1565 -> 1568;
	1566 [label="要是我也能这么轻易逃脱就好了。我不怪你。",shape=box,color=blue];
		1566 -> 1569;
	1567 [label="我不知道！这才是整件事最让人沮丧的地方！但这并非重点。重点是喝醉。而且我甚至不知道自己是否真的喝醉了。不过，我肯定不是清醒的——",shape=box,color=blue];
		1567 -> 1570;
	1568 [label="或许吧。反正我肯定算不上他们眼中的清醒状态。",shape=box,color=blue];
		1568 -> 1571;
	1569 [label="Update boolean LyonConfessionFail",color=orange];
		1569 -> 1572;
	1570 [label="所以我想这样就足够了。",shape=box,color=blue];
		1570 -> 1573;
		1570 -> 1574;
	1571 [label="这正是我们做这件事的目的。所以我想这样就足够了。",shape=box,color=blue];
		1571 -> 1573;
		1571 -> 1574;
	1572 [label="Chat ends.",color=orange];
	1573 [label="到底是什么可怕的事情，让你非得喝醉了才能跟我说出来？",shape=box,color=red];
		1573 -> 1575;
	1574 [label="我准备好了，你可以随时开始……",shape=box,color=red];
		1574 -> 1575;
	1575 [label="哒……哒……哒……",shape=box,color=blue];
		1575 -> 1576;
		1575 -> 1577;
	1576 [label="……哦。",shape=box,color=red];
		1576 -> 1578;
	1577 [label="那样就够了。",shape=box,color=red];
		1577 -> 1578;
	1578 [label="我很确定，在我的一生中，他们从未在我的脑海中出现过。那个名叫 Rell 的 Tenno 和他的守护者 Harrow。他们也不可能存在于我童年的家中。",shape=box,color=blue];
		1578 -> 1579;
	1579 [label="他们不可能像我多年来在异象中听到的那些低语、含糊不清的声音那样，在我的脑海中不断回响。然而，我仍然能在我的记忆中看到他们，听到他的声音。",shape=box,color=blue];
		1579 -> 1580;
	1580 [label="Check boolean LyonTime1",color=orange];
		1580 -> 1581 [label=true,color=green];
		1580 -> 1582 [label=false,color=brown];
	1581 [label="从哲学意义上讲，我理解英择谛所说的能量如何在时间和空间中同时存在。但直到我注射了血清，我才从情感上真正理解了这一点。",shape=box,color=blue];
		1581 -> 1583;
	1582 [label="我注射血清的那一刻——万物仿佛合而为一。当英择谛揭示了他自己，以及他存在的全部真相—— ",shape=box,color=blue];
		1582 -> 1584;
	1583 [label="我有时在脑海中会看到一个巨大而浅的静谧湖泊，向四面八方延伸。湖面漆黑光滑，宛如一面缟玛瑙镜。",shape=box,color=blue];
		1583 -> 1585;
	1584 [label="他向我详细阐述了他所了解的“量子纠缠”、“叠加”、“永恒论”等等概念。",shape=box,color=blue];
		1584 -> 1586;
	1585 [label="一片浩瀚无垠的黑色湖泊，仿佛流淌到无尽的深渊。令人难以理解。",shape=box,color=blue];
		1585 -> 1587;
	1586 [label="我科学的角度，而不是哲学的角度理解这一切。但直到我注射了血清，我才从情感上真正理解了它。",shape=box,color=blue];
		1586 -> 1583;
	1587 [label="我会在那里找到它们。我们会在那里相遇。我也会在那里感受到它们……",shape=box,color=blue];
		1587 -> 1588;
	1588 [label="它们？",shape=box,color=red];
		1588 -> 1589;
	1589 [label="其他的 Harrow……空洞的雕像，回荡着回荡的回荡……他们向四面八方无限地回荡……",shape=box,color=blue];
		1589 -> 1590;
	1590 [label="Rell 把自己置身于其中一个世界。迷失其中。如此一来，他也迷失在所有世界之中……",shape=box,color=blue];
		1590 -> 1591;
	1591 [label="包括我。包括那铸就现在的我的 Harrow。",shape=box,color=blue];
		1591 -> 1592;
		1591 -> 1593;
	1592 [label="虚空啊，我竟然都没意识到……",shape=box,color=red];
		1592 -> 1594;
	1593 [label="哦，不——",shape=box,color=red];
		1593 -> 1594;
	1594 [label="在我的脑海里，他们与我同在——Rell 和他的哈罗，他们与我如此相似，却又如此不同。",shape=box,color=blue];
		1594 -> 1595;
	1595 [label="他毫不畏惧，而且信心十足。这两点我都非常不具备。",shape=box,color=blue];
		1595 -> 1596;
	1596 [label="他坚决对抗虚空无情之物，不在乎它是什么或不是什么。他只知道该做什么。",shape=box,color=blue];
		1596 -> 1597;
	1597 [label="即使经历了所有残酷的折磨，在那漫长的岁月里，在“现在”和“过去”的永恒中，在我注射血清的那一刻……在“之前”和“之后”，他始终都在那里。",shape=box,color=blue];
		1597 -> 1598;
	1598 [label="他既是我的朋友，也是我的兄弟。",shape=box,color=blue];
		1598 -> 1599;
	1599 [label="“过去”？在“现在”？",shape=box,color=blue];
		1599 -> 1600;
	1600 [label="我又感觉不到他了。",shape=box,color=blue];
		1600 -> 1601;
		1600 -> 1602;
	1601 [label="他……他已经死了，里昂……他已经安息了。",shape=box,color=red];
		1601 -> 1603;
	1602 [label="哦，里昂……",shape=box,color=red];
		1602 -> 1604;
	1603 [label="我知道。他离开的时候，我感觉到了。我哭了。我非常想念他。我知道他仍然以某种方式、以某种方式存在着，尽管我并不完全明白其中的缘由。",shape=box,color=blue];
		1603 -> 1605;
		1603 -> 1606;
	1604 [label="我非常想念他。我知道他仍然以某种方式、以某种方式存在着，尽管我并不完全明白其中的缘由。",shape=box,color=blue];
		1604 -> 1605;
		1604 -> 1606;
	1605 [label="Rell 是我们所有人中最坚强的。我很高兴你曾有机会认识他。",shape=box,color=red];
		1605 -> 1607;
	1606 [label="Rell 因为孩子们的无知和残忍而被排斥……他不应该遭受这样的对待。",shape=box,color=red];
		1606 -> 1608;
	1607 [label="我也很高兴认识他。至于他的力量？或许有，或许没有。但最终，他只是明白自己需要做什么，并且有足够的力量去完成这件事。",shape=box,color=blue];
		1607 -> 1609;
	1608 [label="或许吧。但最终，他做了他该做的事。而且他有足够的勇气去完成这件事。",shape=box,color=blue];
		1608 -> 1609;
	1609 [label="在这样的时刻，我想我们唯一能祈祷的就是“足够强大”。",shape=box,color=blue];
		1609 -> 1610;
	1610 [label="可惜的是，这款酒并非如此……它的酒劲很足，只是起效比较慢。",shape=box,color=blue];
		1610 -> 1611;
	1611 [label="我应该走先。 ",shape=box,color=blue];
		1611 -> 1612;
	1612 [label="我该走了。",shape=box,color=blue];
		1612 -> 1613;
	1613 [label="Check boolean LyonDating",color=orange];
		1613 -> 1614 [label=true,color=green];
		1613 -> 1615 [label=false,color=brown];
	1614 [label="+20 Chemistry",color=orange];
		1614 -> 1616;
	1615 [label="+20 Chemistry",color=orange];
		1615 -> 1617;
	1616 [label="我的爱人，谢谢你。",shape=box,color=blue];
		1616 -> 1618;
	1617 [label="我的朋友，谢谢你。",shape=box,color=blue];
		1617 -> 1618;
	1618 [label="——里昂",shape=box,color=blue];
		1618 -> 1619;
	1619 [label="Update boolean LyonConfession2",color=orange];
		1619 -> 1620;
	1620 [label="Update boolean LyonWillDate",color=orange];
		1620 -> 1621;
	1621 [label="Chat ends.",color=orange];
}