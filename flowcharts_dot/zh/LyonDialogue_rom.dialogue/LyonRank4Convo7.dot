digraph {
	"LyonRank4Convo7 begins." [color=orange];
		"LyonRank4Convo7 begins." -> j3016609261;
	j3016609261 [label="漂泊者？我能为一件事向你道歉吗？",shape=box,color=blue];
		j3016609261 -> j3326573734;
		j3016609261 -> j2322762287;
		j3016609261 -> j1038552372;
	j3326573734 [label="能？什么事？",shape=box,color=red];
		j3326573734 -> j4240211242;
	j2322762287 [label="里昂，你不需要这么做。你没做错任何事。",shape=box,color=red];
		j2322762287 -> j386964692;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j4240211242 [label="+5 Chemistry",color=orange];
		j4240211242 -> j2556908040;
	j386964692 [label="虽然我很感激，但我仍然觉得你理应得到一个道歉。我会尽量言简意赅，避免赘述不必要的术语。",shape=box,color=blue];
		j386964692 -> j3984005011;
	"Chat ends." [color=orange];
	j2556908040 [label="谢谢。我会尽量言简意赅，避免赘述不必要的术语。",shape=box,color=blue];
		j2556908040 -> j3984005011;
	j3984005011 [label="对我来说，交流很困难。尤其是在亲密的交流中，这种困难远比在冷冰冰、机械式的交流或书信往来中要严重得多。",shape=box,color=blue];
		j3984005011 -> j2227367323;
	j2227367323 [label="我不知道该如何形容——只能说……就像我拼命想抓住什么东西，却眼睁睁地看着灰尘从指缝间溜走。 ",shape=box,color=blue];
		j2227367323 -> j3106323283;
	j3106323283 [label="我常常觉得自己像一张空白的画布，在上面涂抹油彩——徒劳地试图勾勒出我脑海中所见图像的轮廓。",shape=box,color=blue];
		j3106323283 -> j3716021474;
	j3716021474 [label="然而，我越努力，就越感到绝望。",shape=box,color=blue];
		j3716021474 -> j3209388626;
	j3209388626 [label="我越尝试，就越是失败。所以我干脆就什么都不尝试了。",shape=box,color=blue];
		j3209388626 -> j3900987115;
	j3900987115 [label="这就是我一开始躲着你的原因。也是为什么我至今仍然……容易陷入独处。我不知该如何表达。",shape=box,color=blue];
		j3900987115 -> j2527644757;
		j3900987115 -> j3316382860;
		j3900987115 -> j1584130384;
	j2527644757 [label="我永远都愿意让你静静地待在我身边。",shape=box,color=red];
		j2527644757 -> j1836209078;
	j3316382860 [label="我有时也会这样。没关系。",shape=box,color=red];
		j3316382860 -> j1670169427;
	j1584130384 [label="接受你的道歉了。",shape=box,color=red];
		j1584130384 -> j3063212471;
	j1836209078 [label="+15 Chemistry",color=orange];
		j1836209078 -> j3676840518;
	j1670169427 [label="+15 Chemistry",color=orange];
		j1670169427 -> j1671876640;
	j3063212471 [label="+10 Chemistry",color=orange];
		j3063212471 -> j1236857034;
	j3676840518 [label="我……会记住的。漂泊者，谢谢你。",shape=box,color=blue];
		j3676840518 -> j82610256;
	j1671876640 [label="我之前没意识到。我会记住，在这个世界上我不是一个人……漂泊者，谢谢你。",shape=box,color=blue];
		j1671876640 -> j82610256;
	j1236857034 [label="当然。漂泊者，谢谢你。",shape=box,color=blue];
		j1236857034 -> j82610256;
	j82610256 [label="——里昂·阿拉德神父",shape=box,color=blue];
		j82610256 -> "Chat ends.";
}