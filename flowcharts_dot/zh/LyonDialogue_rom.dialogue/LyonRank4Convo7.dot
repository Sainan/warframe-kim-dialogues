digraph {
	1285 [label="LyonRank4Convo7 begins.",color=orange];
		1285 -> 1286;
	1286 [label="漂泊者？我能为一件事向你道歉吗？",shape=box,color=blue];
		1286 -> 1287;
		1286 -> 1288;
		1286 -> 1289;
	1287 [label="能？什么事？",shape=box,color=red];
		1287 -> 1290;
	1288 [label="里昂，你不需要这么做。你没做错任何事。",shape=box,color=red];
		1288 -> 1291;
	1289 [label="[结束]",shape=box,color=red];
		1289 -> 1292;
	1290 [label="+5 Chemistry",color=orange];
		1290 -> 1293;
	1291 [label="虽然我很感激，但我仍然觉得你理应得到一个道歉。我会尽量言简意赅，避免赘述不必要的术语。",shape=box,color=blue];
		1291 -> 1294;
	1292 [label="Chat ends.",color=orange];
	1293 [label="谢谢。我会尽量言简意赅，避免赘述不必要的术语。",shape=box,color=blue];
		1293 -> 1294;
	1294 [label="对我来说，交流很困难。尤其是在亲密的交流中，这种困难远比在冷冰冰、机械式的交流或书信往来中要严重得多。",shape=box,color=blue];
		1294 -> 1295;
	1295 [label="我不知道该如何形容——只能说……就像我拼命想抓住什么东西，却眼睁睁地看着灰尘从指缝间溜走。 ",shape=box,color=blue];
		1295 -> 1296;
	1296 [label="我常常觉得自己像一张空白的画布，在上面涂抹油彩——徒劳地试图勾勒出我脑海中所见图像的轮廓。",shape=box,color=blue];
		1296 -> 1297;
	1297 [label="然而，我越努力，就越感到绝望。",shape=box,color=blue];
		1297 -> 1298;
	1298 [label="我越尝试，就越是失败。所以我干脆就什么都不尝试了。",shape=box,color=blue];
		1298 -> 1299;
	1299 [label="这就是我一开始躲着你的原因。也是为什么我至今仍然……容易陷入独处。我不知该如何表达。",shape=box,color=blue];
		1299 -> 1300;
		1299 -> 1301;
		1299 -> 1302;
	1300 [label="我永远都愿意让你静静地待在我身边。",shape=box,color=red];
		1300 -> 1303;
	1301 [label="我有时也会这样。没关系。",shape=box,color=red];
		1301 -> 1304;
	1302 [label="接受你的道歉了。",shape=box,color=red];
		1302 -> 1305;
	1303 [label="+15 Chemistry",color=orange];
		1303 -> 1306;
	1304 [label="+15 Chemistry",color=orange];
		1304 -> 1307;
	1305 [label="+10 Chemistry",color=orange];
		1305 -> 1308;
	1306 [label="我……会记住的。漂泊者，谢谢你。",shape=box,color=blue];
		1306 -> 1309;
	1307 [label="我之前没意识到。我会记住，在这个世界上我不是一个人……漂泊者，谢谢你。",shape=box,color=blue];
		1307 -> 1309;
	1308 [label="当然。漂泊者，谢谢你。",shape=box,color=blue];
		1308 -> 1309;
	1309 [label="——里昂·阿拉德神父",shape=box,color=blue];
		1309 -> 1310;
	1310 [label="Chat ends.",color=orange];
}