digraph {
	1076 [label="LyonRank4Convo5 begins.",color=orange];
		1076 -> 1077;
	1077 [label="Check boolean LyonSerum1",color=orange];
		1077 -> 1079 [label=true,color=green];
		1077 -> 1080 [label=true,color=green];
		1077 -> 1078 [label=false,color=brown];
		1077 -> 1080 [label=false,color=brown];
	1079 [label="里昂，我想听听剩下的故事，罗瑟是如何和你还有玛丽一起来到教堂的？",shape=box,color=red];
		1079 -> 1082;
	1080 [label="[结束]",shape=box,color=red];
		1080 -> 1083;
	1078 [label="里昂，我想听听罗瑟是如何和你还有玛丽一起来到教堂的？",shape=box,color=red];
		1078 -> 1081;
	1082 [label="如你所愿。不过，这可不是什么愉快的故事。他像一只受伤的野猫一样被扔在我们家门口。",shape=box,color=blue];
		1082 -> 1084;
	1083 [label="Chat ends.",color=orange];
	1081 [label="如你所愿。他像一只受伤的野猫一样被扔在我们家门口。这故事并不愉快。",shape=box,color=blue];
		1081 -> 1084;
	1084 [label="Evaluate expressions",color=orange];
		1084 -> 1087 [label="LyonStray",color=purple];
		1084 -> 1086 [label="RoatheSerum1",color=purple];
		1084 -> 1085 [label="false",color=purple];
	1087 [label="我猜对了，那个故事原来是在说罗瑟。",shape=box,color=red];
		1087 -> 1090;
	1086 [label="据他自己描述，他出现的时候，完全有理由表现得有点……野性。",shape=box,color=red];
		1086 -> 1089;
	1085 [label="好吧，继续。",shape=box,color=red];
		1085 -> 1088;
	1090 [label="那是一个关于一只经常光顾教堂的流浪猫的故事。至于你从中领受到什么含义，或者我为什么要讲这个故事，完全取决于你自己。我可是个神父，不是吗？",shape=box,color=blue];
		1090 -> 1088;
	1089 [label="以他的地位和性格，被英择谛那样对待会有怨气再正常不过。说实话，如果他能以德报怨，我反而会更加惊讶。",shape=box,color=blue];
		1089 -> 1088;
	1088 [label="Evaluate expressions",color=orange];
		1088 -> 1092 [label="LyonSerum1",color=purple];
		1088 -> 1091 [label="false",color=purple];
	1092 [label="我记得上次说到，在失踪了一段时间后，英择谛刚和罗瑟一起回来，就像我们现在看到的他一样，已经被转化了。英择谛向我们揭露了他三年多来说的所有谎言。",shape=box,color=blue];
		1092 -> 1094;
	1091 [label="我将尝试概括导致那一刻发生的事件，否则它看起来……充其量也只能说是毫无意义的。",shape=box,color=blue];
		1091 -> 1093;
	1094 [label="他向我们提供了“原型战甲血清”，使我们变成了现在的样子，而一旦我们接受了它们……他又立即抛弃了我们。",shape=box,color=blue];
		1094 -> 1096;
	1093 [label="在长达三年两个月零十一天的时间里，他担任我们教堂的星期日主教。在那段时间里，我和玛丽一直侍奉着他，却对他为我们所做的安排一无所知。",shape=box,color=blue];
		1093 -> 1095;
	1096 [label="于是，​我们​被​留​了​下来，​如同​刚失去​父母​的​混合体，​身体​和​灵魂​被​重塑成​我们​几乎​无法​理解​的​造物，​更别​说​掌控​它们。​",shape=box,color=blue];
		1096 -> 1098;
	1095 [label="在你开口之前，我就知道你想问什么了。他究竟在密谋什么？他是否像我听说的对霍瓦尼亚那样，也感染了这座城市？他的计划是什么？他发现了什么？",shape=box,color=blue];
		1095 -> 1097;
	1098 [label="我们被困在了这座曾经是我们的家，却不再对我们友好的城市里。我们……被迫躲藏起来。",shape=box,color=blue];
		1098 -> 1100;
		1098 -> 1101;
	1097 [label="问这些的人，你们会失望的。在那三年两个月零十一天里，他只是传道、学习、休息、祷告。然后，在一个夜晚，他在一场可怕的风暴中消失了。这场风暴和他出现时的风暴一模一样。",shape=box,color=blue];
		1097 -> 1099;
	1100 [label="因为你们的外观？",shape=box,color=red];
		1100 -> 1104;
	1101 [label="教堂把你们赶出去了吗？",shape=box,color=red];
		1101 -> 1105;
	1099 [label="Check boolean MarieLyonVisions",color=orange];
		1099 -> 1103 [label=true,color=green];
		1099 -> 1102 [label=false,color=brown];
	1104 [label="我不知道你是否注意到，玛丽会飞，而罗瑟……是蓝色的，除此之外还有其他一些问题。",shape=box,color=blue];
		1104 -> 1107;
	1105 [label="不……确切地说。我们是被迫退出公众视野的。但我们的兄弟姐妹们并没有把我们流放到街头，也没有把我们绑在火刑柱上烧死。“星期日主教”让他们相信，我们的改变是……双耀神的杰作。",shape=box,color=blue];
		1105 -> 1108;
	1103 [label="虽然我知道其他人可能没有感受到这场风暴，但我却真切地感受到了它。",shape=box,color=blue];
		1103 -> 1102;
	1102 [label="一年后的同一天，他最后一次出现，而……罗瑟，正如你现在看到的，倒在他脚下，昏迷不醒。",shape=box,color=blue];
		1102 -> 1106;
	1107 [label="我知道你整天和会说话的动物、骷髅头玩耍，思考宇宙虚空的问题，但这对于大多数人类来说并不是正常的事情。",shape=box,color=blue];
		1107 -> 1110;
	1108 [label="我们被藏在墓穴里，不为人知。我们以前的弟兄们虽然害怕我们，但还是会给我们送来补给。",shape=box,color=blue];
		1108 -> 1111;
	1106 [label="他简直就是恶魔的化身，至少看起来是这样。就在那时，英择谛告诉我们他的真实身份——他来自哪里——以及托付我们的真正任务。他选中我们俩去执行一项“神圣的使命”。",shape=box,color=blue];
		1106 -> 1109;
	1110 [label="事实上，如果我把自己伪装得足够好，我们三人中或许只有我能混入人群。 ",shape=box,color=blue];
		1110 -> 1113;
		1110 -> 1114;
	1111 [label="他们……坚持只和玛丽交流，尽管玛丽总是像幽灵一样突然出现在楼梯上迎接他们。",shape=box,color=blue];
		1111 -> 1115;
		1111 -> 1116;
	1109 [label="玛丽欣然接受了血清。当然，她会接受的。她怎么可能不接受呢？而我又怎能不跟随她呢？我又怎能不去追寻真相，无论真相会将我引向何方呢？",shape=box,color=blue];
		1109 -> 1112;
	1113 [label="你们​住​在​哪儿？​",shape=box,color=red];
		1113 -> 1120;
	1114 [label="你们是怎么来到这里的？",shape=box,color=red];
		1114 -> 1121;
	1115 [label="我能理解他们想避开罗瑟，但是……他们宁愿避开罗瑟也不愿意跟你说话？",shape=box,color=red];
		1115 -> 1122;
	1116 [label="她人很好……",shape=box,color=red];
		1116 -> 1123;
	1112 [label="Update boolean LyonSerum1",color=orange];
		1112 -> 1117;
		1112 -> 1118;
		1112 -> 1119;
	1120 [label="我们的兄弟姐妹们并没有把我们流放到街头，也没有把我们绑在火刑柱上烧死。“星期日主教”让他们相信，我们的改变是……双耀神的杰作。",shape=box,color=blue];
		1120 -> 1127;
	1121 [label="具体“如何”做到只有罗瑟知道，但在经过多年的研究，他利用我们的血液样本创造了一个“Helminth”。",shape=box,color=blue];
		1121 -> 1128;
	1122 [label="我相信你是见过我那一面的，对吗？",shape=box,color=blue];
		1122 -> 1129;
	1123 [label="正是。",shape=box,color=blue];
		1123 -> 1130;
	1117 [label="我觉得她对英择谛的崇拜还是有点过头了。",shape=box,color=red];
		1117 -> 1124;
	1118 [label="接下来发生了什么？",shape=box,color=red];
		1118 -> 1125;
	1119 [label="你后悔吗？",shape=box,color=red];
		1119 -> 1126;
	1127 [label="我们被藏在墓穴里，不为人知。我们以前的弟兄们虽然害怕我们，但还是会给我们送来补给。",shape=box,color=blue];
		1127 -> 1134;
	1128 [label="我相信 Infestation 能通过……时间……以某种方式相互联系……虽然细节我完全不明白。",shape=box,color=blue];
		1128 -> 1135;
		1128 -> 1136;
	1129 [label="你们被困在下面多久了？",shape=box,color=red];
		1129 -> 1137;
	1130 [label="所以……他们把你们都关在地下室里了？",shape=box,color=red];
		1130 -> 1138;
	1124 [label="Update boolean LyonMarieEntrati",color=orange];
		1124 -> 1131;
	1125 [label="罗瑟醒了过来。起初，他几乎记不起自己的名字。英择谛临别前对这个混蛋说了一句话：“Uriel，Xata 的异端者，在放逐中，作出回答吧——奥罗金能否得到宽恕？”",shape=box,color=blue];
		1125 -> 1132;
	1126 [label="漂泊者，我对一切都感到后悔。是的，我当然后悔。但我还会再做一次吗？答案是，我当然会。我不能让玛丽一个人待着。",shape=box,color=blue];
		1126 -> 1133;
	1134 [label="他们……坚持只和玛丽交流，尽管玛丽总是像幽灵一样突然出现在楼梯上迎接他们。",shape=box,color=blue];
		1134 -> 1139;
		1134 -> 1140;
	1135 [label="他居然逆向工程出了 Helminth？！这花了多长时间？！",shape=box,color=red];
		1135 -> 1141;
	1136 [label="我觉得没人能理解。这是一项新发现。",shape=box,color=red];
		1136 -> 1142;
	1137 [label="或许你不应该问我，自从我们变成会说话的融合感染体之后过了多少年。从那以后，我对时间流逝的感知一直……很混乱。",shape=box,color=blue];
		1137 -> 1143;
		1137 -> 1144;
	1138 [label="听起来或许比实际情况更残酷。我们别无选择。钟楼太敞开了，太容易受到恶劣天气的影响。而墓穴则温暖隐蔽。",shape=box,color=blue];
		1138 -> 1145;
	1131 [label="在这点上，我们意见一致。但我也不能因此责怪她。给她点时间，她会想明白的。她非常聪明，漂泊者。别把她当傻瓜。",shape=box,color=blue];
		1131 -> 1133;
	1132 [label="英择谛就此永远地离开了。他把罗瑟留给了我们，而罗瑟如今已焕然一新，变成了你们现在看到的样子——更有能力对抗那喜怒无常的魔鬼。",shape=box,color=blue];
		1132 -> 1096;
	1133 [label="故事继续……英择谛就此永远地离开了。他把罗瑟留给了我们，而罗瑟如今已焕然一新，变成了你们现在看到的样子——更有能力对抗那喜怒无常的魔鬼。",shape=box,color=blue];
		1133 -> 1096;
	1139 [label="我能理解他们想避开罗瑟，但是……他们宁愿避开罗瑟也不愿意跟你说话？",shape=box,color=red];
		1139 -> 1146;
	1140 [label="她人很好……",shape=box,color=red];
		1140 -> 1147;
	1141 [label="Update boolean LyonRoatheHelminth",color=orange];
		1141 -> 1148;
	1142 [label="我不知道知道这件事是令人欣慰还是令人沮丧，谢谢。现在知道这些 Infestation 居然会说话，真是匪夷所思。",shape=box,color=blue];
		1142 -> 1149;
		1142 -> 1150;
	1143 [label="混乱？怎么会这样？",shape=box,color=red];
		1143 -> 1151;
	1144 [label="我不确定是否应该告诉你，这些 Infestation 还会说话……",shape=box,color=red];
		1144 -> 1152;
	1145 [label="不幸的是，我们还发现它有出口，罗瑟则利用这些出口……四处游荡。",shape=box,color=blue];
		1145 -> 1153;
	1146 [label="我相信你是见过我那一面的，对吗？",shape=box,color=blue];
		1146 -> 1129;
		1146 -> 1130;
	1147 [label="正是。",shape=box,color=blue];
		1147 -> 1130;
		1147 -> 1129;
	1148 [label="或许你不该问我这个问题。从那以后，我对时间流逝的感知变得……混乱。或许说“更加混乱”会更准确一些。说得事情还不够可怕似的……",shape=box,color=blue];
		1148 -> 1143;
		1148 -> 1144;
	1149 [label="并非所有家居用品都是如此。椅子有时可能会……嗯……算了，请继续。",shape=box,color=red];
		1149 -> 1154;
	1150 [label="关于吉他的事我就不跟你细说了。",shape=box,color=red];
		1150 -> 1155;
	1151 [label="Update boolean LyonTime1",color=orange];
		1151 -> 1156;
	1152 [label="相信我，我懂。这确实令人不安，谢谢。虽然感觉这地方的每个物件都会说话。",shape=box,color=blue];
		1152 -> 1149;
		1152 -> 1150;
	1153 [label="Evaluate expressions",color=orange];
		1153 -> 1157 [label="MarieRoathePastry1",color=purple];
		1153 -> 1157 [label="RoatheMariePastry1",color=purple];
		1153 -> 1158 [label="false",color=purple];
	1154 [label="漂泊者，如果你要说的词是“占据”，那么我也见过。就是那个会低语的。墙里的那个。我听到了哒哒声……",shape=box,color=blue];
		1154 -> 1159;
	1155 [label="请你说说。不过，我觉得让一件乐器成为某种转瞬即逝的半神，远比让其他那些萦绕在我心头、最终离我而去的东西来得更令人欣慰。奇怪的是，自从他……",shape=box,color=blue];
		1155 -> 1160;
	1156 [label="我​不​确定​这​仅​仅​是​因为​我​对​这​件​事格​外敏感，​还是​因为​……​我​自己​的​情况，​或者……​因为​他​——​",shape=box,color=blue];
		1156 -> 1161;
	1157 [label="我听说了。",shape=box,color=red];
		1157 -> 1162;
	1158 [label="哦？",shape=box,color=red];
		1158 -> 1163;
	1159 [label="我听到一个声音，那是我一生中从未听过的，但它却从我的过去一直延伸到我的未来……",shape=box,color=blue];
		1159 -> 1164;
	1160 [label="他？",shape=box,color=red];
		1160 -> 1159;
	1161 [label="我知道我说这话你会觉得我疯了，但我对时间的体验并不是……纯粹的……线性方式。",shape=box,color=blue];
		1161 -> 1165;
		1161 -> 1166;
	1162 [label="我​认为​这​是​他​为​数​不​多​的​可贵​之处​之一。​我​指​的​不​是​偷窃​本身，​而​是​偷窃​背后​的​动机。​我​的​推测​是，​他​偷来​这些​赃物​是​为了​诱惑​玛丽​和​他​说话。​",shape=box,color=blue];
		1162 -> 1167;
	1163 [label="这无关紧要。",shape=box,color=blue];
		1163 -> 1168;
		1163 -> 1169;
	1164 [label="它并不是一直都出现。然而，我现在仍能清晰地回忆起它，就像月神那银色的光芒一样，在我小时候家里的墙后闪耀。还有一个年轻人的声音……“哒、哒、哒……”",shape=box,color=blue];
		1164 -> 1170;
	1165 [label="“他”？“他”是谁？",shape=box,color=red];
		1165 -> 1159;
	1166 [label="里昂，我曾体验过无数个世纪的时间，它们如同循环往复的螺旋。",shape=box,color=red];
		1166 -> 1171;
	1167 [label="或许是因为它们让她露出了笑容，在她以为他没注意的时候。有一次，他对我说：“她如此被剥夺了生命，真是命运的一大憾事。”",shape=box,color=blue];
		1167 -> 1172;
	1168 [label="你们花了多久才恢复到……现在的状态？",shape=box,color=red];
		1168 -> 1173;
	1169 [label="接下来发生了什么？",shape=box,color=red];
		1169 -> 1121;
	1170 [label="我……抱歉。我必须走了。我现在还不能说这件事。我……我很抱歉。请不要再问我这件事了。",shape=box,color=blue];
		1170 -> 1174;
	1171 [label="那么，​当​我​说​起​一​个​超越​我​的​理性​思维、​指引​我​的​声音​时，​你​又​会​作何​感想​呢？​我​知道​我​并​非​一生​都​听见​它。​它​并不​是​一直​都​出现。​",shape=box,color=blue];
		1171 -> 1175;
	1172 [label="Update boolean LyonRoathePastry",color=orange];
		1172 -> 1176;
		1172 -> 1168;
	1173 [label="或许你不应该问我，自从我们变成会说话的融合感染体之后过了多少年。从那以后，我对时间流逝的感知一直……很混乱。",shape=box,color=blue];
		1173 -> 1144;
		1173 -> 1143;
	1174 [label="里昂，等等！",shape=box,color=red];
		1174 -> 1177;
	1175 [label="然而，我现在仍能清晰地回忆起它，就像月神那银色的光芒一样，在我小时候家里的墙后闪耀。还有一个年轻人的声音……“哒、哒、哒……”",shape=box,color=blue];
		1175 -> 1170;
	1176 [label="你说得对，他那样做真是太可爱了。接下来发生了什么？",shape=box,color=red];
		1176 -> 1121;
	1177 [label="Update boolean LyonRell1",color=orange];
		1177 -> 1178;
	1178 [label="+20 Chemistry",color=orange];
