	"LyonRank4Convo5 begins." [color=orange];
		"LyonRank4Convo5 begins." -> j3425926750;
	j3425926750 [label="Check boolean LyonSerum1",color=orange];
		j3425926750 -> j2791196941 [label=true,color=green];
		j3425926750 -> j1038552372 [label=true,color=green];
		j3425926750 -> j2225565714 [label=false,color=brown];
		j3425926750 -> j1038552372 [label=false,color=brown];
	j2791196941 [label="里昂，我想听听剩下的故事，罗瑟是如何来到教堂，和你还有玛丽一起的？",shape=box,color=red];
		j2791196941 -> j3509173122;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j2225565714 [label="里昂，我想知道罗瑟是如何来到教堂，和你还有玛丽一起的？",shape=box,color=red];
		j2225565714 -> j1423209201;
	j3509173122 [label="如你所愿。不过，这可不是什么愉快的故事。他像一只受伤的野猫一样被扔在我们家门口。",shape=box,color=blue];
		j3509173122 -> j3769319211;
	"Chat ends." [color=orange];
	j1423209201 [label="如你所愿。他像一只受伤的野猫一样被扔在我们家门口。这故事并不愉快。",shape=box,color=blue];
		j1423209201 -> j3769319211;
	j3769319211 [label="Evaluate expressions",color=orange];
		j3769319211 -> j3529421258 [label="LyonStray",color=purple];
		j3769319211 -> j2273409688 [label="RoatheSerum1",color=purple];
		j3769319211 -> j611873752 [label="false",color=purple];
	j3529421258 [label="我猜对了，那个故事原来是在说罗瑟。",shape=box,color=red];
		j3529421258 -> j2518014401;
	j2273409688 [label="据他自己描述，他出现的时候，完全有理由表现得有点……野性。",shape=box,color=red];
		j2273409688 -> j3761838779;
	j611873752 [label="好吧，继续。",shape=box,color=red];
		j611873752 -> j2266356665;
	j2518014401 [label="那是一个关于一只经常光顾教堂的流浪猫的故事。至于你从中领受到什么含义，或者我为什么要讲这个故事，完全取决于你自己。我可是个神父，不是吗？",shape=box,color=blue];
		j2518014401 -> j2266356665;
	j3761838779 [label="以他的地位和性格，被英择谛那样对待会有怨气再正常不过。说实话，如果他能以德报怨，我反而会更加惊讶。",shape=box,color=blue];
		j3761838779 -> j2266356665;
	j2266356665 [label="Evaluate expressions",color=orange];
		j2266356665 -> j2652240478 [label="LyonSerum1",color=purple];
		j2266356665 -> j4166443012 [label="false",color=purple];
	j2652240478 [label="我记得上次说到，在失踪了一段时间后，英择谛刚和罗瑟一起回来，罗瑟就像我们现在看到的一样，已经被转化了。英择谛向我们揭露了他三年多来说的所有谎言。",shape=box,color=blue];
		j2652240478 -> j2515734305;
	j4166443012 [label="我将尝试概括导致那一刻发生的事件，否则它看起来……充其量也只能说是很荒谬的。",shape=box,color=blue];
		j4166443012 -> j2357625570;
	j2515734305 [label="他向我们提供了“原型战甲血清”，使我们变成了现在的样子，而一旦我们接受了它们……他又立即抛弃了我们。",shape=box,color=blue];
		j2515734305 -> j532490320;
	j2357625570 [label="在长达三年两个月零十一天的时间里，他担任我们教堂的星期日主教。在那段时间里，我和玛丽一直侍奉着他，却对他为我们所做的安排一无所知。",shape=box,color=blue];
		j2357625570 -> j3369218661;
	j532490320 [label="于是，​我们​被​留​了​下来，​如同​刚失去​父母​的​混合体，​身体​和​灵魂​被​重塑成​我们​几乎​无法​理解​的​造物，​更别​说​掌控​它们。​",shape=box,color=blue];
		j532490320 -> j1412013601;
	j3369218661 [label="在你开口之前，我就知道你想问什么了。他究竟在密谋什么？他是否像我听说的对霍瓦尼亚那样，也感染了这座城市？他的计划是什么？他发现了什么？",shape=box,color=blue];
		j3369218661 -> j159943905;
	j1412013601 [label="我们被困在了这座曾经是我们的家，却不再对我们友好的城市里。我们……被迫躲藏起来。",shape=box,color=blue];
		j1412013601 -> j144321223;
		j1412013601 -> j2661091786;
	j159943905 [label="知道了这些问题的答案，你们会失望的。在那三年两个月零十一天里，他只是传道、学习、休息、祷告。然后，在一个夜晚，他在一场可怕的风暴中消失了。这场风暴和他出现时的风暴一模一样。",shape=box,color=blue];
		j159943905 -> j2575044127;
	j144321223 [label="因为你们的外观？",shape=box,color=red];
		j144321223 -> j771243647;
	j2661091786 [label="教堂把你们赶出去了吗？",shape=box,color=red];
		j2661091786 -> j1797308887;
	j2575044127 [label="Check boolean MarieLyonVisions",color=orange];
		j2575044127 -> j1650236864 [label=true,color=green];
		j2575044127 -> j2741513907 [label=false,color=brown];
	j771243647 [label="我不知道你是否注意到，玛丽会飞，而罗瑟……是蓝色的，除此之外还有其他一些问题。",shape=box,color=blue];
		j771243647 -> j691440535;
	j1797308887 [label="不……确切地说。我们是被迫退出公众视野的。但教堂的修士与修女们并没有把我们流放到街头，也没有把我们绑在火刑柱上烧死。“星期日主教”让他们相信，我们的改变是……双耀神的杰作。",shape=box,color=blue];
		j1797308887 -> j364264529;
	j1650236864 [label="虽然我知道其他人可能没有感受到这场风暴，但我却真切地感受到了它。",shape=box,color=blue];
		j1650236864 -> j2741513907;
	j2741513907 [label="一年后的同一天，他最后一次出现，而……罗瑟，正如你现在看到的样子，倒在他脚下，昏迷不醒。",shape=box,color=blue];
		j2741513907 -> j1405032494;
	j691440535 [label="我知道你整天和会说话的动物、骷髅头玩耍，思考宇宙虚空的问题，但这对于大多数人类来说并不是正常的事情。",shape=box,color=blue];
		j691440535 -> j2858363786;
	j364264529 [label="我们被藏在墓穴里，不为人知。我们以前的弟兄们虽然害怕我们，但还是会给我们送来补给。",shape=box,color=blue];
		j364264529 -> j3019109492;
	j1405032494 [label="他简直就是恶魔的化身，至少看起来是这样。就在那时，英择谛告诉我们他的真实身份——他来自哪个时代——以及托付我们的真正任务。他选中我们俩去执行一项“神圣的使命”。",shape=box,color=blue];
		j1405032494 -> j1248644549;
	j2858363786 [label="事实上，如果我把自己伪装得足够好，我们三人中或许只有我能混入人群。 ",shape=box,color=blue];
		j2858363786 -> j2053956923;
		j2858363786 -> j1960707282;
	j3019109492 [label="他们……坚持只和玛丽交流，尽管玛丽总是像幽灵一样突然出现在楼梯上迎接他们。",shape=box,color=blue];
		j3019109492 -> j3889697584;
		j3019109492 -> j4087747002;
	j1248644549 [label="玛丽欣然接受了血清。当然，她会接受的。她怎么可能不接受呢？而我又怎能不跟随她呢？我又怎能不去追寻真相，无论真相会将我引向何方呢？",shape=box,color=blue];
		j1248644549 -> j249472217;
	j2053956923 [label="你们​住​在​哪儿？​",shape=box,color=red];
		j2053956923 -> j4137011807;
	j1960707282 [label="你们是怎么来到这里的？",shape=box,color=red];
		j1960707282 -> j2398169029;
	j3889697584 [label="我能理解他们想避开罗瑟，但是……他们宁愿避开罗瑟也不愿意跟你说话？",shape=box,color=red];
		j3889697584 -> j532074807;
	j4087747002 [label="她人很好……",shape=box,color=red];
		j4087747002 -> j3123242579;
	j249472217 [label="Boolean LyonSerum1 is now true.",color=orange];
		j249472217 -> j74641079;
		j249472217 -> j2391207409;
		j249472217 -> j3793027886;
	j4137011807 [label="我们的兄弟姐妹们并没有把我们流放到街头，也没有把我们绑在火刑柱上烧死。“星期日主教”让他们相信，我们的改变是……双耀神的杰作。",shape=box,color=blue];
		j4137011807 -> j2812304871;
	j2398169029 [label="具体“如何”做到只有罗瑟知道，但在经过多年的研究，他利用我们的血液样本创造了一个“Helminth”。",shape=box,color=blue];
		j2398169029 -> j1532686401;
	j532074807 [label="我相信你是见过我那一面的，对吗？",shape=box,color=blue];
		j532074807 -> j486672855;
	j3123242579 [label="正是。",shape=box,color=blue];
		j3123242579 -> j2156651143;
	j74641079 [label="我觉得她对英择谛的崇拜还是有点过头了。",shape=box,color=red];
		j74641079 -> j2885963146;
	j2391207409 [label="接下来发生了什么？",shape=box,color=red];
		j2391207409 -> j3953312597;
	j3793027886 [label="你后悔吗？",shape=box,color=red];
		j3793027886 -> j3212883208;
	j2812304871 [label="我们被藏在墓穴里，不为人知。我们以前的弟兄们虽然害怕我们，但还是会给我们送来补给。",shape=box,color=blue];
		j2812304871 -> j2022130833;
	j1532686401 [label="我相信 Infestation 能通过……时间……以某种方式相互联系……虽然细节我完全不明白。",shape=box,color=blue];
		j1532686401 -> j706988085;
		j1532686401 -> j4019028643;
	j486672855 [label="你们被困在下面多久了？",shape=box,color=red];
		j486672855 -> j375778368;
	j2156651143 [label="所以……他们把你们都关在地下室里了？",shape=box,color=red];
		j2156651143 -> j2140476988;
	j2885963146 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j2885963146 -> j4249411616;
	j3953312597 [label="罗瑟醒了过来。起初，他几乎记不起自己的名字。英择谛临别前对这个混蛋说了一句话：“Uriel，Xata 的异端者，在放逐中，作出回答吧——奥罗金能否得到宽恕？”",shape=box,color=blue];
		j3953312597 -> j3412314009;
	j3212883208 [label="漂泊者，我对一切都感到后悔。是的，我当然后悔。但我还会再做一次吗？答案是，我当然会。我不能让玛丽一个人待着。",shape=box,color=blue];
		j3212883208 -> j2339712570;
	j2022130833 [label="他们……坚持只和玛丽交流，尽管玛丽总是像幽灵一样突然出现在楼梯上迎接他们。",shape=box,color=blue];
		j2022130833 -> j1506127343;
		j2022130833 -> j4161291040;
	j706988085 [label="他居然逆向工程出了 Helminth？！这花了多长时间？！",shape=box,color=red];
		j706988085 -> j171211055;
	j4019028643 [label="我觉得没人能理解。这是一项新发现。",shape=box,color=red];
		j4019028643 -> j845562550;
	j375778368 [label="或许你不应该问我，自从我们变成会说话的融合感染体之后过了多少年。从那以后，我对时间流逝的感知一直……很混乱。",shape=box,color=blue];
		j375778368 -> j3266992302;
		j375778368 -> j1261532297;
	j2140476988 [label="听起来或许比实际情况更残酷。我们别无选择。钟楼太敞开了，太容易受到恶劣天气的影响。而墓穴则温暖隐蔽。",shape=box,color=blue];
		j2140476988 -> j1681302802;
	j4249411616 [label="在这点上，我们意见一致。但我也不能因此责怪她。给她点时间，她会想明白的。她非常聪明，漂泊者。别把她当傻瓜。",shape=box,color=blue];
		j4249411616 -> j2339712570;
	j3412314009 [label="英择谛就此永远地离开了。他把罗瑟留给了我们，而我和玛丽如今已焕然一新，变成了你们现在看到的样子——更有能力对抗那喜怒无常的恶魔。",shape=box,color=blue];
		j3412314009 -> j532490320;
	j2339712570 [label="故事继续……英择谛就此永远地离开了。他把罗瑟留给了我们，而罗瑟如今已焕然一新，变成了你们现在看到的样子——更有能力对抗那喜怒无常的魔鬼。",shape=box,color=blue];
		j2339712570 -> j532490320;
	j1506127343 [label="我能理解他们想避开罗瑟，但是……他们宁愿避开罗瑟也不愿意跟你说话？",shape=box,color=red];
		j1506127343 -> j1232501315;
	j4161291040 [label="她人很好……",shape=box,color=red];
		j4161291040 -> j2602090390;
	j171211055 [label="Boolean LyonRoatheHelminth is now true.",color=orange];
		j171211055 -> j4238264382;
	j845562550 [label="我不知道知道这件事是令人欣慰还是令人沮丧，谢谢。现在知道这些 Infestation 居然会说话，真是匪夷所思。",shape=box,color=blue];
		j845562550 -> j1633739398;
		j845562550 -> j3166548412;
	j3266992302 [label="混乱？怎么会这样？",shape=box,color=red];
		j3266992302 -> j1640315801;
	j1261532297 [label="我不确定是否应该告诉你，这些 Infestation 还会说话……",shape=box,color=red];
		j1261532297 -> j2885375378;
	j1681302802 [label="不幸的是，我们还发现它有出口，罗瑟则利用这些出口……四处游荡。",shape=box,color=blue];
		j1681302802 -> j845860967;
	j1232501315 [label="我相信你是见过我那一面的，对吗？",shape=box,color=blue];
		j1232501315 -> j486672855;
		j1232501315 -> j2156651143;
	j2602090390 [label="正是。",shape=box,color=blue];
		j2602090390 -> j2156651143;
		j2602090390 -> j486672855;
	j4238264382 [label="或许你不该问我这个问题。从那以后，我对时间流逝的感知变得……混乱。或许说“更加混乱”会更准确一些。说得事情还不够可怕似的……",shape=box,color=blue];
		j4238264382 -> j3266992302;
		j4238264382 -> j1261532297;
	j1633739398 [label="并非所有家居用品都是如此。椅子有时可能会……嗯……算了，请继续。",shape=box,color=red];
		j1633739398 -> j2992423107;
	j3166548412 [label="关于吉他的事我就不跟你细说了。",shape=box,color=red];
		j3166548412 -> j909138089;
	j1640315801 [label="Boolean LyonTime1 is now true.",color=orange];
		j1640315801 -> j1138212560;
	j2885375378 [label="相信我，我懂。这确实令人不安，谢谢。虽然感觉这地方的每个物件都会说话。",shape=box,color=blue];
		j2885375378 -> j1633739398;
		j2885375378 -> j3166548412;
	j845860967 [label="Evaluate expressions",color=orange];
		j845860967 -> j2806906758 [label="MarieRoathePastry1",color=purple];
		j845860967 -> j2806906758 [label="RoatheMariePastry1",color=purple];
		j845860967 -> j2861127819 [label="false",color=purple];
	j2992423107 [label="漂泊者，如果你要说的词是“占据”，那么我也见过。就是那个会低语的。墙里的那个。我听到了哒哒声……",shape=box,color=blue];
		j2992423107 -> j1242976487;
	j909138089 [label="请你说说。不过，我觉得让一件乐器成为某种转瞬即逝的半神，远比让其他那些萦绕在我心头、最终离我而去的东西来得更令人欣慰。奇怪的是，自从他……",shape=box,color=blue];
		j909138089 -> j3304377914;
	j1138212560 [label="我​不​确定​这​仅​仅​是​因为​我​对​这​件​事格​外敏感，​还是​因为​……​我​自己​的​情况，​或者……​因为​他​——​",shape=box,color=blue];
		j1138212560 -> j3926835865;
	j2806906758 [label="我听说了。",shape=box,color=red];
		j2806906758 -> j920322418;
	j2861127819 [label="哦？",shape=box,color=red];
		j2861127819 -> j1712407038;
	j1242976487 [label="我听到一个声音，那是我一生中从未听过的，但它却从我的过去一直延伸到我的未来……",shape=box,color=blue];
		j1242976487 -> j2033116551;
	j3304377914 [label="他？",shape=box,color=red];
		j3304377914 -> j1242976487;
	j3926835865 [label="我知道我说这话你会觉得我疯了，但我对时间的体验并不是……纯粹的……线性方式。",shape=box,color=blue];
		j3926835865 -> j2946092544;
		j3926835865 -> j431432970;
	j920322418 [label="我​认为​这​是​他​为​数​不​多​的​可贵​之处​之一。​我​指​的​不​是​偷窃​本身，​而​是​偷窃​背后​的​动机。​我​的​推测​是，​他​偷来​这些​赃物​是​为了​诱惑​玛丽​和​他​说话。​",shape=box,color=blue];
		j920322418 -> j2278780412;
	j1712407038 [label="这无关紧要。",shape=box,color=blue];
		j1712407038 -> j2771030695;
		j1712407038 -> j164796378;
	j2033116551 [label="它并不是一直都出现。然而，我现在仍能清晰地回忆起它，就像月神那银色的光芒一样，在我小时候家里的墙后闪耀。还有一个年轻人的声音……“哒、哒、哒……”",shape=box,color=blue];
		j2033116551 -> j1235681225;
	j2946092544 [label="“他”？“他”是谁？",shape=box,color=red];
		j2946092544 -> j1242976487;
	j431432970 [label="里昂，我曾体验过无数个世纪的时间，它们如同循环往复的螺旋。",shape=box,color=red];
		j431432970 -> j1838379593;
	j2278780412 [label="或许是因为它们让她露出了笑容，在她以为他没注意的时候。有一次，他对我说：“她如此被剥夺了生命，真是命运的一大憾事。”",shape=box,color=blue];
		j2278780412 -> j3733610902;
	j2771030695 [label="你们花了多久才回到……现在？",shape=box,color=red];
		j2771030695 -> j1331055554;
	j164796378 [label="接下来发生了什么？",shape=box,color=red];
		j164796378 -> j2398169029;
	j1235681225 [label="我……抱歉。我必须走了。我现在还不能说这件事。我……我很抱歉。请不要再问我这件事了。",shape=box,color=blue];
		j1235681225 -> j3043571755;
	j1838379593 [label="那么，​当​我​说​起​一​个​超越​我​的​理性​思维、​指引​我​的​声音​时，​你​又​会​作何​感想​呢？​我​知道​我​并​非​一生​都​听见​它。​它​并不​是​一直​都​在。​",shape=box,color=blue];
		j1838379593 -> j1649778417;
	j3733610902 [label="Boolean LyonRoathePastry is now true.",color=orange];
		j3733610902 -> j1356554709;
		j3733610902 -> j2771030695;
	j1331055554 [label="或许你不应该问我，自从我们变成会说话的融合感染体之后过了多少年。从那以后，我对时间流逝的感知一直……很混乱。",shape=box,color=blue];
		j1331055554 -> j1261532297;
