		j1684428913 -> "Chat ends.";
	j10934505 [label="你让他学会了自我反省，指明了方向。对此，我感激不尽。我知道玛丽也一样。",shape=box,color=blue];
		j10934505 -> j2218417586;
	j306701568 [label="你给他带来了踏实感和目标感。对此，我感激不尽。我知道玛丽也一样。",shape=box,color=blue];
		j306701568 -> j2218417586;
	j1205608672 [label="我不知道他的命运将会如何。我希望我们能解决这个问题。因为我担心，如果任由他独自生活太久，他会把自己扭曲成什么样子。",shape=box,color=blue];
