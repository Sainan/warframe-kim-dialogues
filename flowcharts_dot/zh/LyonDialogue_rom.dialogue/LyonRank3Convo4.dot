	j383237897 [label="Boolean DrifterLiar is now true.",color=orange];
		j383237897 -> j1381098605;
	j1498185065 [label="Boolean LyonSuspicious is now true.",color=orange];
		j1498185065 -> j1381098605;
	j3192159372 [label="我知道恶魔曾向你灌输过他的那些理论。而我，在深夜里，不禁会想，这些理论是否也有着一定的道理。",shape=box,color=blue];
		j3192159372 -> j1024394039;
	j3071353214 [label="+20 Chemistry",color=orange];
		j3071353214 -> j1236132767;
	j3005438895 [label="一个对人类心智一无所知的神，为何要嘲笑我们的愚蠢？为何要折磨我们？为何要嘲弄我们的失败，模仿我们的形态？",shape=box,color=blue];
		j3005438895 -> j4103037845;
	j3096314558 [label="我再次道歉，因为我不想讨论这件事。我想，鉴于你对情况的了解，不难推断出其中的原因。",shape=box,color=blue];
		j3096314558 -> j2756476514;
		j3096314558 -> j749162469;
	j1150333934 [label="Boolean LyonFaith1 is now true.",color=orange];
		j1150333934 -> j3096314558;
	j1381098605 [label="嗯，的确如此。一个不可知的神，变成像我们一样的蚂蚁，那会是什么感觉呢？",shape=box,color=blue];
		j1381098605 -> j1236132767;
	j4103037845 [label="难道没有什么比凝视虚无的深渊，发现虚无也在凝视着你更可怕的吗？难道没有什么比意识到我们自身有多么渺小更可怕的吗？ ",shape=box,color=blue];
		j4103037845 -> j2086019663;
	j2756476514 [label="我认为这可能与英择谛有关，或许也与虚空无情之物有关。",shape=box,color=red];
		j2756476514 -> j653899326;
	j749162469 [label="是的，但我们来到这里，正是因为我对别人的动机做出了假设，不是吗？",shape=box,color=red];
		j749162469 -> j3893902654;
	j2086019663 [label="我多么渴望虚空的寂静，渴望它所预示的宁静。我愿意付出任何代价——换掉那些纠缠不休、令人抓狂的声音……",shape=box,color=blue];
		j2086019663 -> j2925117430;
	j653899326 [label="那么我的判断是正确的，我们就不必再谈这件事了。",shape=box,color=blue];
		j653899326 -> "Chat ends.";
	j3893902654 [label="+10 Chemistry",color=orange];
		j3893902654 -> j4129004952;
	j2925117430 [label="漂泊者，正是这些声音让我如此怀疑。也正是这些声音让我敲下这些文字时双手颤抖……",shape=box,color=blue];
		j2925117430 -> j1947213285;
	j4129004952 [label="我……是的，你说得对。谢谢。那我修改一下我的说法，我现在……实在不愿谈论此事。",shape=box,color=blue];
		j4129004952 -> j1748452297;
	j1947213285 [label="+10 Chemistry",color=orange];
		j1947213285 -> j915523459;
