		336 -> 347;
	341 [label="嗯，是的。玛丽跟我说过这件事。你不相信我们这个世界存在无形的力量——包括虚空无情之物的力量。是这样吗？",shape=box,color=blue];
		341 -> 352;
		341 -> 353;
	340 [label="有意思。这已经是我第二次从你身上感受到，你似乎并不相信你们虚空无情之物的真实性了。是这样吗？",shape=box,color=blue];
		340 -> 350;
		340 -> 351;
	339 [label="有意思。我似乎从你的言谈中看出，你近来自己的信仰也动摇了？还是你从一开始就从未相信过虚空无情之物？",shape=box,color=blue];
		339 -> 350;
		339 -> 351;
	337 [label="我并不确定虚空无情之物是否真实存在，直到我们把它变成现实。我想我们创造它的方式，和我创造双衍王境的方式一样。",shape=box,color=red];
		337 -> 348;
	338 [label="我确实认为虚空无情之物是一种真实存在的神灵——它背后有着真正的意识。",shape=box,color=red];
		338 -> 349;
	342 [label="有时候，我会想，这或许就是为什么那么多人最终会转向信仰的原因……",shape=box,color=blue];
		342 -> 354;
	343 [label="恕我直言，当任何人觉得自己的任何行为都是“有理由”时，我都会开始感到担忧，尤其是在预测他人动机方面。",shape=box,color=blue];
		343 -> 355;
		343 -> 356;
	344 [label="我们​是否​应该​担心，​如果​它​开始​影响​那些​不​那么​明显​的​部分​会​发生​什么？​",shape=box,color=blue];
		344 -> 357;
	345 [label="我认为虚空无情之物在试图学习如何成为“人”。它一直以来都是某种更宏大、更独特的存在。所以它正在学习如何以更渺小的形式存在，如何成为我们。",shape=box,color=red];
		345 -> 358;
