	j3760835956 [label="虚空是什么？不就是虚无吗？",shape=box,color=blue];
		j3760835956 -> j2241303796;
	j3049624369 [label="我们试图在自身中寻找永恒的曙光——寻找一种恩赐，希望它能超越我们短暂的生命余晖。在那些阴影中，这种空虚会滋生怎样的恐怖，以我们内心的黑暗、我们空虚的灵魂为食？",shape=box,color=blue];
		j3049624369 -> j3676795045;
