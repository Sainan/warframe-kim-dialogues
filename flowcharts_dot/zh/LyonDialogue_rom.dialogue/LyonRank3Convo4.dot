		j3733577529 -> j1236132767;
	j851675519 [label="谢谢。我想今天就到此为止吧。",shape=box,color=blue];
		j851675519 -> j869677712;
	j3151274255 [label="+10 Chemistry",color=orange];
		j3151274255 -> j403702255;
	j2756199173 [label="+10 Chemistry",color=orange];
		j2756199173 -> j2568436707;
	j2449728344 [label="不管怎样，我不知道它为什么要模仿人类的器官。我想它是为了弄清楚是什么让我们“运转”起来。",shape=box,color=red];
		j2449728344 -> j4056244274;
	j3245630323 [label="那个画面大概会在我脑海中停留很久。至于你觉得是哪一样——是那十鞭，还是低语者，就由你来决定吧。",shape=box,color=red];
		j3245630323 -> j891041929;
