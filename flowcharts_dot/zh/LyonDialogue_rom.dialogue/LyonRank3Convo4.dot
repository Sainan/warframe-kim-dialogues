	328 [label="真有意思。我一直以为你把你的虚空无情之物奉为神明，就像我们把月神或太阳神奉为神明一样。难道我理解错了？",shape=box,color=blue];
		328 -> 337;
		328 -> 338;
	333 [label="不。但我认为，想到自己最终能够猜到虚空无情之物在做什么，会让我感到一种平静。",shape=box,color=red];
		333 -> 342;
	334 [label="不，说到底，我还是不确定。但我接触它很多次了，我觉得我有理由去弄明白它。",shape=box,color=red];
		334 -> 343;
	335 [label="那还能是什么呢？我认为虚空无情之物似乎正在逐一探究人体各个部位的用途。",shape=box,color=red];
		335 -> 344;
