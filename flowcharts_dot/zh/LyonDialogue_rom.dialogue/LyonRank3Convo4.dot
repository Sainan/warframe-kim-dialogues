		j4235260738 -> j3368949293;
	j3210214466 [label="Boolean LyonReal1 is now false.",color=orange];
		j3210214466 -> j3760835956;
	j1024394039 [label="虚空是什么？不就是虚无吗？是不是就像一面光滑的缟玛瑙镜，上面旋转着漩涡，供我们凝视，等待着我们的倒影扭曲变形？",shape=box,color=blue];
		j1024394039 -> j3049624369;
