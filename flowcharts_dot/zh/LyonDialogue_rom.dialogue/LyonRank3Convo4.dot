		j1236132767 -> j82610256;
	j869677712 [label="——里昂·阿拉德神父",shape=box,color=blue];
		j869677712 -> j2379301672;
	j403702255 [label="是的……恐怕真是如此。我非常不愿看到你如此武断又因为误会而改变对我的看法。",shape=box,color=blue];
		j403702255 -> j637016252;
	j2568436707 [label="你已被原谅。",shape=box,color=blue];
		j2568436707 -> j3077773152;
	j4056244274 [label="嗯，有趣。但你的见解之局限，有点令人失望。你认为这不过是个孩子在玩玩具而已。我得回去工作了。",shape=box,color=blue];
		j4056244274 -> j2537477029;
