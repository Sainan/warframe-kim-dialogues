digraph {
	"LyonRank3Convo4 begins." [color=orange];
		"LyonRank3Convo4 begins." -> j2338278270;
	j2338278270 [label="请原谅我的问题如此直接，但我不知道该如何更好地表达。这些低语者究竟是什么？",shape=box,color=blue];
		j2338278270 -> j2037042500;
		j2338278270 -> j2875996256;
		j2338278270 -> j988397961;
	j2037042500 [label="我​告诉​你​的​所有​事​都​只​是​对​“虚空​无情​之物”​的​“想法”​的​猜测。​",shape=box,color=red];
		j2037042500 -> j1307355008;
	j2875996256 [label="我​觉得​它们​是​虚空……理解人类​形态​的​一​种​尝试。​",shape=box,color=red];
		j2875996256 -> j3329725101;
	j988397961 [label="你是指字面意思还是象征意思？",shape=box,color=red];
		j988397961 -> j117384857;
	j1307355008 [label="Evaluate expressions",color=orange];
		j1307355008 -> j2689608455 [label="DrifterFaithNoMITW",color=purple];
		j1307355008 -> j232248665 [label="LyonFake1",color=purple];
		j1307355008 -> j1756165859 [label="LyonFaith1",color=purple];
		j1307355008 -> j1804275623 [label="LyonReal1",color=purple];
		j1307355008 -> j2069518981 [label="false",color=purple];
	j3329725101 [label="真是这样吗？你这么确定吗？",shape=box,color=blue];
		j3329725101 -> j967227409;
		j3329725101 -> j1963404580;
		j3329725101 -> j2799923295;
	j117384857 [label="啊，对，很好的阐明。我想我是指象征意思。它们显然确实是由尘土和灰烬构成的。",shape=box,color=blue];
		j117384857 -> j735796696;
	j2689608455 [label="+10 Chemistry",color=orange];
		j2689608455 -> j296699675;
	j232248665 [label="+10 Chemistry",color=orange];
		j232248665 -> j489846359;
	j1756165859 [label="+10 Chemistry",color=orange];
		j1756165859 -> j2306409013;
	j1804275623 [label="+10 Chemistry",color=orange];
		j1804275623 -> j2069518981;
	j2069518981 [label="真有意思。我一直以为你把你的虚空无情之物奉为神明，就像我们把月神或太阳神奉为神明一样。难道我理解错了？",shape=box,color=blue];
		j2069518981 -> j4069329409;
		j2069518981 -> j2503594239;
	j967227409 [label="不。但我认为，想到自己最终能够猜到虚空无情之物在做什么，会让我感到一种平静。",shape=box,color=red];
		j967227409 -> j2047061376;
	j1963404580 [label="不，说到底，我还是不确定。但我接触它很多次了，我觉得我有理由去弄明白它。",shape=box,color=red];
		j1963404580 -> j4276328237;
	j2799923295 [label="那还能是什么呢？我认为虚空无情之物似乎正在逐一探究人体各个部位的用途。",shape=box,color=red];
		j2799923295 -> j477221928;
	j735796696 [label="因为它们死后都会变成那样。我们已经无数次证明了这一点。",shape=box,color=blue];
		j735796696 -> j2357806243;
		j735796696 -> j2885321573;
		j735796696 -> j3318660679;
	j296699675 [label="嗯，是的。玛丽跟我说过这件事。你不相信我们这个世界存在无形的力量——包括虚空无情之物的力量。是这样吗？",shape=box,color=blue];
		j296699675 -> j2515172535;
		j296699675 -> j2680200692;
	j489846359 [label="有意思。这已经是我第二次从你身上感受到，你似乎并不相信你们虚空无情之物的真实性了。是这样吗？",shape=box,color=blue];
		j489846359 -> j944523854;
		j489846359 -> j628093460;
	j2306409013 [label="有意思。我似乎从你的言谈中看出，你近来自己的信仰也动摇了？还是你从一开始就从未相信过虚空无情之物？",shape=box,color=blue];
		j2306409013 -> j944523854;
		j2306409013 -> j628093460;
	j4069329409 [label="我并不确定虚空无情之物是否真实存在，直到我们把它变成现实。我想我们创造它的方式，和我创造双衍王境的方式一样。",shape=box,color=red];
		j4069329409 -> j336246172;
	j2503594239 [label="我确实认为虚空无情之物是一种真实存在的神灵——它背后有着真正的意识。",shape=box,color=red];
		j2503594239 -> j1338592549;
	j2047061376 [label="有时候，我会想，这或许就是为什么那么多人最终会转向信仰的原因……",shape=box,color=blue];
		j2047061376 -> j4078924602;
	j4276328237 [label="恕我直言，当任何人觉得自己的任何行为都是“有理由”时，我都会开始感到担忧，尤其是在预测他人动机方面。",shape=box,color=blue];
		j4276328237 -> j3462155016;
		j4276328237 -> j1384586390;
	j477221928 [label="我们​是否​应该​担心，​如果​它​开始​影响​那些​不​那么​明显​的​部分​会​发生​什么？​",shape=box,color=blue];
		j477221928 -> j4276685282;
	j2357806243 [label="我认为虚空无情之物在试图学习如何成为“人”。它一直以来都是某种更宏大、更独特的存在。所以它正在学习如何以更渺小的形式存在，如何成为我们。",shape=box,color=red];
		j2357806243 -> j2741587556;
	j2885321573 [label="有时我会想，在我们与虚空无情之物互动之前，它是否从未真正拥有过自己的实体。所以，它现在正在学习如何存在。",shape=box,color=red];
		j2885321573 -> j1319847560;
	j3318660679 [label="我认为虚空无情之物似乎正在逐一探究人体各个部位的用途。",shape=box,color=red];
		j3318660679 -> j477221928;
	j2515172535 [label="我并不确定虚空无情之物是否真实存在，直到我们把它变成现实。我想我们创造它的方式，和我创造双衍王境的方式一样。",shape=box,color=red];
		j2515172535 -> j1057175126;
	j2680200692 [label="我很抱歉她跟你说了那些。我确实认为虚空无情之物是一种真实存在的神灵——它背后有着真正的意识。",shape=box,color=red];
		j2680200692 -> j4217905354;
	j944523854 [label="有时我会想，在我们与虚空无情之物互动之前，它是否从未真正拥有过自己的实体。所以，它现在正在学习如何存在。",shape=box,color=red];
		j944523854 -> j336246172;
	j628093460 [label="不。对不起，我并不是那个意思。我依然认为虚空无情之物是一种真实存在的神灵——它背后有着真正的意识。",shape=box,color=red];
		j628093460 -> j383566171;
	j336246172 [label="Boolean LyonFake1 is now true.",color=orange];
		j336246172 -> j2839706525;
	j1338592549 [label="啊，请原谅我。看来是我误解了。我感谢你即便在不确定中也仍然坦诚，只是这样我得自己去想了。",shape=box,color=blue];
		j1338592549 -> j3733577529;
	j4078924602 [label="当找不到真正的答案时，就能从自己编出的理由中找到平静。",shape=box,color=blue];
		j4078924602 -> j851675519;
	j3462155016 [label="恕我直言，你不是一位决定谁是“义人”谁是“罪人”的神父吗？这难道这样不是有点虚伪吗？",shape=box,color=red];
		j3462155016 -> j3151274255;
	j1384586390 [label="请​你​原谅​我，​我​无意​冒​犯​你。​",shape=box,color=red];
		j1384586390 -> j2756199173;
	j4276685282 [label="刚才那个玩笑开得实在拙劣，请原谅。我将自罚十鞭作为补偿。",shape=box,color=blue];
		j4276685282 -> j2449728344;
		j4276685282 -> j3245630323;
