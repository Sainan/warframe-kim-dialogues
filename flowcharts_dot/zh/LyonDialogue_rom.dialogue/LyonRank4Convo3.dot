		884 -> 887;
		884 -> 888;
	885 [label="或许这是明智之举。我真不希望看到他继续操纵那些生物，让它们沦为他的工具。",shape=box,color=blue];
		885 -> 881;
	886 [label="罗瑟与人交谈时总是别有用心。我真不希望看到他继续操纵那些生物，让它们沦为他的工具。",shape=box,color=blue];
		886 -> 889;
	887 [label="那个​孩子……​他​自己​有​一​堆​烦心事​要​处理。​我们​不​能​对​他们​要求​太​多​了。​这​不​公平。​",shape=box,color=red];
