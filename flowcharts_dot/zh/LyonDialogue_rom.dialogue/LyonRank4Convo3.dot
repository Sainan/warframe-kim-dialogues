		j1234119346 -> j1469607468;
	j2859407209 [label="当然可以。里昂，你想什么时候说都可以。",shape=box,color=red];
		j2859407209 -> j2998710769;
	j3583414205 [label="我​确信，​在​这样​的​情况​下，​肯定​有​人​会​在​他​人​的​怀抱​中​找到​慰藉，​但​我​不​是​那个​幸运儿。​",shape=box,color=blue];
		j3583414205 -> j2728639907;
	j2654697756 [label="+20 Chemistry",color=orange];
		j2654697756 -> j3050167282;
	j1238005177 [label="我喜欢你。但我也喜欢其他人。对我来说，这两种感觉都是真实的。",shape=box,color=red];
		j1238005177 -> j2892280911;
	j971071634 [label="+20 Chemistry",color=orange];
		j971071634 -> j4023748123;
	j3568365407 [label="+10 Chemistry",color=orange];
		j3568365407 -> j3813005102;
	j3683938308 [label="抱歉。这个故事我不太想对任何人说起。所以，如果我不太愿意分享，还请谅解。或许下次吧。",shape=box,color=blue];
		j3683938308 -> j1234119346;
		j3683938308 -> j2859407209;
	j1563755962 [label="我抵触的不是爱的存在——而是它在我家庭中的缺失。抱歉。这个故事我不太想对任何人说起。所以，如果我不太愿意分享，还请谅解。或许下次吧。",shape=box,color=blue];
		j1563755962 -> j1234119346;
