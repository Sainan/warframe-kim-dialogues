	875 [label="我很喜欢听他们闲聊，不过正如你所想，我自己并不参与其中。我没什么可补充的。",shape=box,color=blue];
		875 -> 878;
	876 [label="我觉得他非常讨人喜欢。事实上，在我新结识的这些伙伴中，我最喜欢和他待在一起。",shape=box,color=blue];
		876 -> 879;
	877 [label="Chat ends.",color=orange];
	878 [label="不过，当我发现罗瑟站着和鸟三长时间交谈时，我感到很担忧。我不知道他这样做的目的是什么。",shape=box,color=blue];
		878 -> 880;
