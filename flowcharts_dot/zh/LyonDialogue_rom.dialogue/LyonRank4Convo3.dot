	j2602225172 [label="你和科维兽相处得怎么样？",shape=box,color=red];
		j2602225172 -> j3216569583;
	j2663004710 [label="你觉得洛德怎么样？",shape=box,color=red];
		j2663004710 -> j3835629702;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j3216569583 [label="我很喜欢听他们闲聊，不过正如你所想，我自己并不参与其中。我没什么可补充的。",shape=box,color=blue];
		j3216569583 -> j397473390;
	j3835629702 [label="我觉得他非常讨人喜欢。事实上，在我新结识的这些伙伴中，我最喜欢和他待在一起。",shape=box,color=blue];
		j3835629702 -> j3424630754;
	"Chat ends." [color=orange];
	j397473390 [label="不过，当我发现罗瑟站着和鸟三长时间交谈时，我感到很担忧。我不知道他这样做的目的是什么。",shape=box,color=blue];
		j397473390 -> j2507757158;
	j3424630754 [label="不过我想，这大概并不令人意外。乍一看，我们的性格非常相似。",shape=box,color=blue];
		j3424630754 -> j215510816;
	j2507757158 [label="Boolean LyonRoatheCavia1 is now true.",color=orange];
		j2507757158 -> j3363662032;
		j2507757158 -> j922221746;
	j215510816 [label="我觉得更奇怪的是那个年轻的指挥官……还有他们口中的“Lotus”。以及我们和他们之间那种疏离感。",shape=box,color=blue];
		j215510816 -> j2789768667;
	j3363662032 [label="嗯，我会问问他。",shape=box,color=red];
		j3363662032 -> j2246312338;
	j922221746 [label="你觉得他到底想干什么？",shape=box,color=red];
		j922221746 -> j410888503;
	j2789768667 [label="我们​当然​可以​交流，​但​不​是​以​这​种​方式，​不​是​在​这里。​为什么​会​这样​呢？​",shape=box,color=blue];
		j2789768667 -> j3300632892;
		j2789768667 -> j3668410839;
	j2246312338 [label="或许这是明智之举。我真不希望看到他继续操纵那些生物，让它们沦为他的工具。",shape=box,color=blue];
		j2246312338 -> j215510816;
	j410888503 [label="罗瑟与人交谈时总是别有用心。我真不希望看到他继续操纵那些生物，让它们沦为他的工具。",shape=box,color=blue];
		j410888503 -> j589839861;
	j3300632892 [label="那个​孩子……​他​自己​有​一​堆​烦心事​要​处理。​我们​不​能​对​他们​要求​太​多​了。​这​不​公平。​",shape=box,color=red];
		j3300632892 -> j2063605894;
	j3668410839 [label="我猜……大概是因为我有原型战甲的“使用经验”吧？",shape=box,color=red];
		j3668410839 -> j3260070664;
	j589839861 [label="如果你有时间，也许可以去了解一下。当然，一切看你的意愿。",shape=box,color=blue];
		j589839861 -> j215510816;
	j2063605894 [label="是的。我听说他们被迫忍受的苦难。战争的故事，还有……破碎的友谊，支离破碎的友谊。",shape=box,color=blue];
		j2063605894 -> j343800736;
	j3260070664 [label="Check boolean IsDating",color=orange];
		j3260070664 -> j2705244661 [label=true,color=green];
		j3260070664 -> j3825867497 [label=false,color=brown];
	j343800736 [label="战争所摧毁的一切令我心痛，而战争能孕育出的东西，则更令我感到不可思议。",shape=box,color=blue];
		j343800736 -> j3825867497;
	j2705244661 [label="嗯。现在都这么叫了吗？“使用经验”？真是妙极了。虽然英择谛似乎把事情搞得一团糟，但我很高兴你……找到了自娱自乐的方式。",shape=box,color=blue];
		j2705244661 -> j202454093;
		j2705244661 -> j102224342;
		j2705244661 -> j2662294371;
	j3825867497 [label="洛德先生跟我讲过你之前，也就是在我们的未来，在霍瓦尼亚的“不幸遭遇”。英择谛确实把事情搞得一团糟。",shape=box,color=blue];
		j3825867497 -> j2390347693;
		j3825867497 -> j3264206138;
	j202454093 [label="我做错什么了吗？",shape=box,color=red];
		j202454093 -> j3487893497;
	j102224342 [label="神父，小心说话，否则我可能会以为你在想，围墙另一边的草是不是更绿一些。",shape=box,color=red];
		j102224342 -> j619519124;
	j2662294371 [label="里昂，你说的好像这只是一段露水情缘似的。请不要这样侮辱我。",shape=box,color=red];
		j2662294371 -> j1331458418;
	j2390347693 [label="相信我，事情本来可以更糟。",shape=box,color=red];
		j2390347693 -> j425554863;
	j3264206138 [label="那些原型战甲都是我的好朋友，他们就像我的家人一样。",shape=box,color=red];
		j3264206138 -> j3691202250;
	j3487893497 [label="Check boolean LyonFirstFlirt",color=orange];
		j3487893497 -> j1559905045 [label=true,color=green];
		j3487893497 -> j2480013384 [label=false,color=brown];
	j619519124 [label="Check boolean LyonFirstFlirt",color=orange];
		j619519124 -> j1559905045 [label=true,color=green];
		j619519124 -> j4091017649 [label=false,color=brown];
	j1331458418 [label="Check boolean LyonFirstFlirt",color=orange];
		j1331458418 -> j1559905045 [label=true,color=green];
		j1331458418 -> j942744893 [label=false,color=brown];
	j425554863 [label="我确信这一切都是因为英择谛宏伟而精妙的计划。他要将未来的命运托付给你和一群乌合之众。",shape=box,color=blue];
		j425554863 -> j92647662;
	j3691202250 [label="我的祖父母就是在​高卢革命期间相遇。战争与死亡总是会用最奇特的方式促成了友谊的诞生。",shape=box,color=blue];
		j3691202250 -> j3628502303;
	j1559905045 [label="请原谅我。我只是觉得，上次我们讨论事情的时候，你…… ",shape=box,color=blue];
		j1559905045 -> j1968676541;
	j2480013384 [label="对不起。​我​不​了解​你​的​内心，​也​不​了解​别人​的​内心。​你​私下里​和​别人​做​什么，​纯属​你​的​事。​",shape=box,color=blue];
		j2480013384 -> j247663206;
		j2480013384 -> j2888946094;
	j4091017649 [label="对​不起。​不​是，​你​说​得​对。​我​并非​是​嫉妒​的​意思，​也​不​是​想​挑衅。​你​在​私人​时间​与​其他​人​怎么​相处，​纯属​你​个人​的​事。​",shape=box,color=blue];
		j4091017649 -> j247663206;
		j4091017649 -> j2888946094;
	j942744893 [label="当然。对不起。​我​不​了解​你​的​内心，​也​不​了解​别人​的​内心。​你​私下里​和​别人​做​什么，​纯属​你​的​事。​",shape=box,color=blue];
		j942744893 -> j247663206;
		j942744893 -> j2888946094;
	j92647662 [label="漂泊者，我——我知道我可能不太好相处，而且你还不得不和我打交道，为此我要再次向你表示歉意。",shape=box,color=blue];
		j92647662 -> j813689779;
	j3628502303 [label="Boolean LyonBackstory2 is now true.",color=orange];
		j3628502303 -> j1422888401;
		j3628502303 -> j826728917;
	j1968676541 [label="算了……我早该料到人心善变。尤其是当我牵涉其中时，更是如此。",shape=box,color=blue];
		j1968676541 -> j1798040228;
		j1968676541 -> j243538573;
	j247663206 [label="我和他们一起……经历了很多。这往往会拉近人与人之间的距离。",shape=box,color=red];
		j247663206 -> j517800669;
	j2888946094 [label="[表白心意] ​说​实话，​我​一直​在​想​该​找​个​时间​和​你​聊聊​这​件​事。​",shape=box,color=red];
		j2888946094 -> j1677251880;
	j813689779 [label="我就是这样的人，我不知道该如何改变。事实上，那些恶鬼一直纠缠着我，它们对我的灵魂造成了无法弥补伤害。",shape=box,color=blue];
		j813689779 -> j1520688282;
	j1422888401 [label="纵观历史，好像确实是这么回事。",shape=box,color=red];
		j1422888401 -> j2261468901;
	j826728917 [label="我很想多了解一下你的家庭。",shape=box,color=red];
		j826728917 -> j818290997;
	j1798040228 [label="等等。你误会了。不是我误导你。只是事情——嗯，有点复杂。",shape=box,color=red];
		j1798040228 -> j3554803293;
	j243538573 [label="我以为你对我没兴趣。",shape=box,color=red];
		j243538573 -> j3771828709;
	j517800669 [label="我的祖父母就是在​高卢革命期间相遇。战争与死亡总是会用最奇特的方式交织在一起，孕育出激情与爱情。",shape=box,color=blue];
		j517800669 -> j3628502303;
	j1677251880 [label="我现在非常紧张……请问是为什么吗？",shape=box,color=blue];
		j1677251880 -> j1223335880;
		j1677251880 -> j238044371;
	j1520688282 [label="在这层破碎的玻璃表象之下，藏着的其实是……",shape=box,color=blue];
		j1520688282 -> j449833068;
		j1520688282 -> j2215449429;
	j2261468901 [label="的确如此。我不该对战争的黑暗与破坏所带来的那些积极影响心生抵触。",shape=box,color=blue];
		j2261468901 -> j3988363573;
		j2261468901 -> j2750212672;
	j818290997 [label="这个故事我不太想对任何人说起。所以，如果我不太愿意分享，还请谅解。或许下次吧。",shape=box,color=blue];
		j818290997 -> j1234119346;
		j818290997 -> j2859407209;
	j3554803293 [label="请继续。",shape=box,color=blue];
		j3554803293 -> j1223335880;
		j3554803293 -> j238044371;
	j3771828709 [label="恕我直言，我并不认识你。而且，即便我肩负着诸多责任，与陌生人发展恋情也绝非我的优先事项。",shape=box,color=blue];
		j3771828709 -> j3583414205;
	j1223335880 [label="我——我们会改天再聊一次，我很抱歉。 ",shape=box,color=red];
		j1223335880 -> j2654697756;
	j238044371 [label="我不确定你是否能理解，也不知道这样说会不会显得疯狂，但是——对我来说，我……可以同时对不止一个人怀有强烈的感情。",shape=box,color=red];
		j238044371 -> j1238005177;
	j449833068 [label="没事的，里昂。我们会好起来的。相信我，我不着急。",shape=box,color=red];
		j449833068 -> j971071634;
	j2215449429 [label="是什么？",shape=box,color=red];
		j2215449429 -> j3568365407;
