	902 [label="我的祖父母就是在​高卢革命期间相遇。战争与死亡总是会用最奇特的方式促成了友谊的诞生。",shape=box,color=blue];
		902 -> 907;
	908 [label="请原谅我。我只是觉得，上次我们讨论事情的时候，你…… ",shape=box,color=blue];
		908 -> 915;
	909 [label="对不起。​我​不​了解​你​的​内心，​也​不​了解​别人​的​内心。​你​私下里​和​别人​做​什么，​纯属​你​的​事。​",shape=box,color=blue];
