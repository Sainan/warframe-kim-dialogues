	j2998710769 [label="+20 Chemistry",color=orange];
		j2998710769 -> j82519650;
	j2728639907 [label="请你不妨在他们中找另一位。祝你今天愉快。",shape=box,color=blue];
		j2728639907 -> j82610256;
	j3050167282 [label="好的。如果您愿意，我们可以改日再谈此事。在此之前，我将继续处理我今天的工作。",shape=box,color=blue];
		j3050167282 -> j82610256;
	j2892280911 [label="这种想法对我来说并不像你以为的那样陌生。事实上，真正让我犹豫的并非这种想法本身，而是其中牵涉到的每一个人——我并无冒犯之意。",shape=box,color=blue];
		j2892280911 -> j1909012769;
