	892 [label="战争所摧毁的一切令我心痛，而战争能孕育出的东西，则更令我感到不可思议。",shape=box,color=blue];
		892 -> 895;
	894 [label="嗯。现在都这么叫了吗？“使用经验”？真是妙极了。虽然英择谛似乎把事情搞得一团糟，但我很高兴你……找到了自娱自乐的方式。",shape=box,color=blue];
		894 -> 898;
		894 -> 899;
		894 -> 900;
	893 [label="洛德先生跟我讲过你之前，也就是在我们的未来，在霍瓦尼亚的“不幸遭遇”。英择谛确实把事情搞得一团糟。",shape=box,color=blue];
		893 -> 896;
		893 -> 897;
	895 [label="洛德先生跟我讲过你之前，也就是在我们的未来，在霍瓦尼亚的“不幸遭遇”。英择谛确实把事情搞得一团糟。",shape=box,color=blue];
