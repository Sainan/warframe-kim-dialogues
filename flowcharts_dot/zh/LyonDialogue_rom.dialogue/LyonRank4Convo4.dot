	j3108087090 [label="如果你不想的话，那就算了。",shape=box,color=red];
		j3108087090 -> j791751941;
	j3663131439 [label="我觉得你完全可以把精力放在更有意义的事情上，比如保卫堡垒抵御敌人入侵、探索未知的知识……或者整理衣物。",shape=box,color=blue];
