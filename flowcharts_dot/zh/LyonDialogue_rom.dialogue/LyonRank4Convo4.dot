		1054 -> 1058;
	1055 [label="是什么让你走进了教会？",shape=box,color=red];
		1055 -> 1059;
	1056 [label="有些人不配为人父母。",shape=box,color=red];
		1056 -> 1060;
	2233 [label="但我向你保证，它给我带来了一丝平静，尽管我知道这对你来说一定很奇怪。",shape=box,color=blue];
		2233 -> 1049;
	1058 [label="这是教堂里另一位神父教给我的，目的是为了帮助我……清空思绪。那些被月神选中的人常常会得到“异象”的“祝福”。",shape=box,color=blue];
		1058 -> 1061;
