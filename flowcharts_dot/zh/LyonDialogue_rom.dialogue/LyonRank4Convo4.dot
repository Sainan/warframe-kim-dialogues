		j1584197471 -> j4110408558 [label="false",color=purple];
	j791751941 [label="不，对不起。我……很抱歉我处理这件事的方式不太好。",shape=box,color=blue];
		j791751941 -> j2422099811;
	j3912865899 [label="里昂，如果你希望我离开，请直说。",shape=box,color=red];
		j3912865899 -> j1617708008;
