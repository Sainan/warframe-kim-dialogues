		1048 -> 1051 [label=false,color=brown];
	1049 [label="然而，即便我母亲再残忍，也没有我父亲残忍。细节我就不赘述了。",shape=box,color=blue];
		1049 -> 1052;
	1050 [label="或许吧。我常常在想，这会不会是某种驱使。但正如我之前跟你说过的，这也是月神的方式。",shape=box,color=blue];
		1050 -> 1053;
	1051 [label="或许吧。我常常在想，这会不会是某种驱使。但这也是圣光双神之月神的方法。我并不是唯一一个实践过这种方法的人。",shape=box,color=blue];
		1051 -> 1054;
	1052 [label="随着我长大，那些异象变成了声音。那些低语不时在我耳边响起，无论醒着还是在梦里。我的农活因此受到影响，而我自身也饱受折磨。",shape=box,color=blue];
		1052 -> 1055;
