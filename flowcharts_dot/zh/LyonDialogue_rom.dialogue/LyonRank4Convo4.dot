	j2578653569 [label="因为里面是空的。",shape=box,color=blue];
		j2578653569 -> j671329365;
	j1673147934 [label="三个月后，村里一名妇女被发现死在家中，双眼被老鼠啃噬殆尽。",shape=box,color=blue];
		j1673147934 -> j3353103351;
	j671329365 [label="三个月后，村里一名妇女被发现死在家中，双眼被老鼠啃噬殆尽。",shape=box,color=blue];
		j671329365 -> j1559388301;
	j3353103351 [label="我把那天晚上醒来时看到的异象也告诉过母亲。而她也记得那景象，和我看到的一模一样。",shape=box,color=blue];
		j3353103351 -> j3834561238;
		j3353103351 -> j1045103506;
	j1559388301 [label="是的，漂泊者。那些异象吓到我了。",shape=box,color=blue];
		j1559388301 -> j3353103351;
	j3834561238 [label="她当时有什么反应？",shape=box,color=red];
		j3834561238 -> j599517181;
	j1045103506 [label="那她有没有觉得这是巧合，还是某种预兆？",shape=box,color=red];
		j1045103506 -> j4278475236;
	j599517181 [label="她用鞭子抽打我，直到我再也站不起来。我的背上鲜血淋漓，直到我被迫脸朝下躺着睡觉。我至今仍记得她抽打我时嘴里骂着“Diable ！Sorcier ！”",shape=box,color=blue];
		j599517181 -> j2491600642;
		j599517181 -> j1669807818;
		j599517181 -> j545393527;
		j599517181 -> j1143976719;
	j4278475236 [label="我不知道。她用鞭子抽打我，直到我再也站不起来。我的背上鲜血淋漓，直到我被迫脸朝下躺着睡觉。我至今仍记得她鞭打我时嘴里骂着“Diable ！Sorcier ！”",shape=box,color=blue];
		j4278475236 -> j2491600642;
		j4278475236 -> j1669807818;
		j4278475236 -> j545393527;
		j4278475236 -> j1143976719;
	j2491600642 [label="你当时多大？",shape=box,color=red];
		j2491600642 -> j4125271529;
	j1669807818 [label="哦，里昂……我真的，为你感到抱歉……",shape=box,color=red];
		j1669807818 -> j2600868766;
	j545393527 [label="太糟糕了……",shape=box,color=red];
		j545393527 -> j2600868766;
	j1143976719 [label="她很无知，她什么都不知道。",shape=box,color=red];
		j1143976719 -> j2600868766;
	j4125271529 [label="也许是四岁吧。最多六岁。我不知道。我们不像你们现在这样热衷于记录年龄。",shape=box,color=blue];
		j4125271529 -> j2698478763;
	j2600868766 [label="+5 Chemistry",color=orange];
		j2600868766 -> j2133716382;
	j2698478763 [label="Check boolean LyonPainOff",color=orange];
		j2698478763 -> j3563438305 [label=true,color=green];
		j2698478763 -> j2360325816 [label=false,color=brown];
		j2698478763 -> j3563438305 [label=false,color=brown];
	j2133716382 [label="我们动身来这里的时候，我母亲早已去世。如今，她也化作了尘土。她一生饱受苦难……而且注定要将苦难散播下去。",shape=box,color=blue];
		j2133716382 -> j2361004025;
	j3563438305 [label="伤害​孩子……​这​是​不​可​原谅​的。​",shape=box,color=red];
		j3563438305 -> j2600868766;
	j2360325816 [label="这就是为什么你会这样……？",shape=box,color=red];
		j2360325816 -> j2933368378;
	j2361004025 [label="她很害怕。无论我患了什么病，无论是神明的重担、疯狂，还是诅咒，她都无力应对。",shape=box,color=blue];
		j2361004025 -> j3523256318;
	j2933368378 [label="Check boolean LyonLecture2",color=orange];
		j2933368378 -> j3100832467 [label=true,color=green];
		j2933368378 -> j245608473 [label=false,color=brown];
	j3523256318 [label="然而，即便我母亲再残忍，也没有我父亲残忍。细节我就不赘述了。",shape=box,color=blue];
		j3523256318 -> j3436866058;
	j3100832467 [label="或许吧。我常常在想，这会不会是某种驱使。但正如我之前跟你说过的，这也是月神的方式。",shape=box,color=blue];
		j3100832467 -> j129603053;
	j245608473 [label="或许吧。我常常在想，这会不会是某种驱使。但这也是双耀神中月神的方法。我并不是唯一一个实践过这种方法的人。",shape=box,color=blue];
		j245608473 -> j650845326;
	j3436866058 [label="随着我长大，那些异象变成了声音。那些低语不时在我耳边响起，无论醒着还是在梦里。我的农活因此受到影响，而我自身也饱受折磨。",shape=box,color=blue];
		j3436866058 -> j3449281470;
		j3436866058 -> j279413526;
	j129603053 [label="+5 Chemistry",color=orange];
		j129603053 -> j3646123057;
	j650845326 [label="+5 Chemistry",color=orange];
		j650845326 -> j3733737158;
	j3449281470 [label="是什么让你走进了教会？",shape=box,color=red];
		j3449281470 -> j4013567020;
	j279413526 [label="有些人不配为人父母。",shape=box,color=red];
		j279413526 -> j3037974152;
	j3646123057 [label="但我向你保证，它给我带来了一丝平静，尽管我知道这对你来说一定很奇怪。",shape=box,color=blue];
		j3646123057 -> j3523256318;
	j3733737158 [label="这是教堂里另一位神父教给我的，目的是为了帮助我……清空思绪。那些被月神选中的人常常会得到“异象”的“祝福”。",shape=box,color=blue];
		j3733737158 -> j2805836015;
	j4013567020 [label="Check boolean LyonPainOff",color=orange];
		j4013567020 -> j3241825066 [label=true,color=green];
		j4013567020 -> j3033639193 [label=false,color=brown];
	j3037974152 [label="我很感激你的好意，但我得承认我小时候很难管教，尤其是我比他们更高更壮之后。",shape=box,color=blue];
		j3037974152 -> j4013567020;
	j2805836015 [label="Boolean LyonLecture2 is now true.",color=orange];
		j2805836015 -> j3523256318;
	j3241825066 [label="漂泊者，我的那些异象和声音常常让我陷入狂暴。折磨自己往往是我唯一能从异象中醒来的方法。",shape=box,color=blue];
		j3241825066 -> j894252121;
	j3033639193 [label="漂泊者，我的那些异象和声音常常让我陷入狂暴。我常常会拿刀割伤自己的身体，因为只有疼痛才能让我从痛苦中醒来。",shape=box,color=blue];
		j3033639193 -> j894252121;
	j894252121 [label="但​就​在​那​时，​那些​声音​指引​我​",shape=box,color=blue];
		j894252121 -> j1535583040;
	j1535583040 [label="我……我不想说了。我真的说不下去。抱歉。我打字的时候双手都在颤抖。我必须先停下来。",shape=box,color=blue];
		j1535583040 -> j3765641745;
		j1535583040 -> j2702812600;
	j3765641745 [label="当然可以。没关系。不急。我随时都在，等你准备好了再说。",shape=box,color=red];
		j3765641745 -> j2712694973;
	j2702812600 [label="我知道，这已经够让人疲惫的了。好好休息，好吗？还有……谢谢你。这对我意义重大。",shape=box,color=red];
		j2702812600 -> j3717669094;
	j2712694973 [label="+10 Chemistry",color=orange];
		j2712694973 -> j3952195480;
	j3717669094 [label="+15 Chemistry",color=orange];
		j3717669094 -> j702995283;
	j3952195480 [label="谢谢。我们很快再联系。",shape=box,color=blue];
		j3952195480 -> j3544122631;
	j702995283 [label="这对我意义也远超你的想象。朋友，也谢谢你。我们很快再聊。",shape=box,color=blue];
