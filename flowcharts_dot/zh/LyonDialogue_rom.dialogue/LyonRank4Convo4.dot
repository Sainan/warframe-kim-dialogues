		j2706019229 -> j791751941;
	j2238681857 [label="+5 Chemistry",color=orange];
		j2238681857 -> j4288055339;
	j3827518239 [label="你已经决定好要走哪条路了吗？还是说，你的神经比我更绷紧？",shape=box,color=blue];
		j3827518239 -> j2209609147;
		j3827518239 -> j899997881;
	j4110408558 [label="+5 Chemistry",color=orange];
		j4110408558 -> j136442182;
	j2422099811 [label="我不太清楚在这种情况下，对于别人过往经历的好奇，甚至是善意的友谊表达，应该如何恰当地回应。",shape=box,color=blue];
		j2422099811 -> j3977874460;
	j1617708008 [label="+5 Chemistry",color=orange];
		j1617708008 -> j791751941;
	j4288055339 [label="行，但我必须承认，正是这种……情绪让我越来越忐忑不安。为了让我安心，请你向我确认一下，你的意思是否和我越来越担心的一样。",shape=box,color=blue];
		j4288055339 -> j777992596;
		j4288055339 -> j869441024;
	j2209609147 [label="很抱歉之前没理你……",shape=box,color=red];
		j2209609147 -> j485763881;
	j899997881 [label="这是什么意思……？",shape=box,color=red];
		j899997881 -> j485763881;
	j136442182 [label="说实话，你用的措辞让我有些不安。虽然我不知道你的意思是否和我理解的一样。",shape=box,color=blue];
		j136442182 -> j777992596;
		j136442182 -> j869441024;
	j3977874460 [label="不管怎样——你刚才是在问我的过去，对吧？",shape=box,color=blue];
		j3977874460 -> j2081579719;
	j777992596 [label="那我就让你放心吧——我不喜欢你。",shape=box,color=red];
		j777992596 -> j2527456601;
	j869441024 [label="里昂，你难道就这么难以相信我喜欢你吗？",shape=box,color=red];
		j869441024 -> j1893893094;
	j485763881 [label="你放弃追求的热情和你开始追求的热情一样高涨。我以为你已经正确地意识到这是一个糟糕的决定。",shape=box,color=blue];
		j485763881 -> j500301152;
		j485763881 -> j580850257;
	j2081579719 [label="你​可能​已经​注意到，​我​能​看见……​异象。​自从​我​还​是​个​小​孩子​的​时候​起，​这​便​是​我​生活​的​一​部分​了。​",shape=box,color=blue];
		j2081579719 -> j1574456470;
	j2527456601 [label="我并非有意冷落你，只是我觉得我们需要先弄清我们之间的关系。我……很抱歉我处理这件事的方式不太好。",shape=box,color=blue];
		j2527456601 -> j2422099811;
	j1893893094 [label="Boolean DrifterLyon is now true.",color=orange];
		j1893893094 -> j3160864831;
	j500301152 [label="你说得对，这一切都是个错误。",shape=box,color=red];
		j500301152 -> j1480560127;
	j580850257 [label="我只是不确定你是否能接受我的示好。 ",shape=box,color=red];
		j580850257 -> j932852565;
	j1574456470 [label="这些异象，说得委婉点，往往都不是什么令人愉快的异象。",shape=box,color=blue];
		j1574456470 -> j291317331;
		j1574456470 -> j3467980187;
		j1574456470 -> j297897310;
	j3160864831 [label="简单来说？嗯，是的。我……并非有意拒绝你的表白。漂泊者，我只是……不习惯……任何形式的爱意。",shape=box,color=blue];
		j3160864831 -> j233798634;
	j1480560127 [label="我猜也是这样。因此，我只想祝你今天余下的时间过得愉快。",shape=box,color=blue];
		j1480560127 -> "Chat ends.";
	j932852565 [label="+5 Chemistry",color=orange];
		j932852565 -> j3032263750;
	j291317331 [label="而你相信这些异象来自月神？",shape=box,color=red];
		j291317331 -> j3727647845;
	j3467980187 [label="它们具体有什么？",shape=box,color=red];
		j3467980187 -> j3727647845;
	j297897310 [label="它们吓到你了吗？",shape=box,color=red];
		j297897310 -> j2428785449;
	j233798634 [label="如果你决心走这条路，我不会劝阻你，而且……我发现这条路对我来说既令人不安又……陌生？",shape=box,color=blue];
		j233798634 -> j572744602;
	j3032263750 [label="我……没有不接受？这样的示好……只会令人费解，因为它们的存在本身就令人费解。",shape=box,color=blue];
		j3032263750 -> j1196929472;
		j3032263750 -> j869441024;
	j3727647845 [label="有一次我在半夜醒来，看到一位老妇人坐在我的床脚。",shape=box,color=blue];
		j3727647845 -> j2381635220;
