		j2428785449 -> j3642904046;
	j572744602 [label="+5 Chemistry",color=orange];
		j572744602 -> j111919863;
	j1196929472 [label="你希望我停下吗？",shape=box,color=red];
		j1196929472 -> j2910039614;
	j2381635220 [label="她瘦骨嶙峋，仿佛已经死去多年，皮肤紧紧贴着骨头，我甚至能看到骨头之间的缝隙。",shape=box,color=blue];
		j2381635220 -> j2349793602;
	j3642904046 [label="她瘦骨嶙峋，仿佛已经死去多年，皮肤紧紧贴着骨头，我甚至能看到骨头之间的缝隙。",shape=box,color=blue];
		j3642904046 -> j193078590;
	j111919863 [label="我……或许，带着些谨慎的期待，想看看这条新路会把我引向何方。不过——你刚才是在问我的过去，对吧？",shape=box,color=blue];
		j111919863 -> j1540234746;
	j2910039614 [label="不，我……并非有意拒绝你的表白。漂泊者，我只是……不习惯……任何形式的爱意。",shape=box,color=blue];
		j2910039614 -> j233798634;
	j2349793602 [label="她的头发几乎只剩下几缕稀疏的白发，无力地垂在头上。但让我最难忘的还是她的眼睛。 ",shape=box,color=blue];
		j2349793602 -> j4202383940;
	j193078590 [label="她的头发几乎只剩下几缕稀疏的白发，无力地垂在头上。但让我最难忘的还是她的眼睛。 ",shape=box,color=blue];
