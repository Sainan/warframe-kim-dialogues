		1059 -> 1062 [label=false,color=brown];
	1060 [label="我很感激你的好意，但我得承认我小时候很难管教，尤其是我比他们更高更壮之后。",shape=box,color=blue];
		1060 -> 1059;
	1061 [label="Update boolean LyonLecture2",color=orange];
		1061 -> 1049;
	1063 [label="漂泊者，我的那些异象和声音常常让我陷入狂暴。折磨自己往往是我唯一能从异象中醒来的方法。",shape=box,color=blue];
		1063 -> 1064;
	1062 [label="漂泊者，我的那些异象和声音常常让我陷入狂暴。我常常会拿刀割伤自己的身体，因为只有疼痛才能让我从痛苦中醒来。",shape=box,color=blue];
		1062 -> 1064;
	1064 [label="但​就​在​那​时，​那些​声音​指引​我​",shape=box,color=blue];
		1064 -> 1065;
	1065 [label="我……我不想说了。我真的说不下去。抱歉。我打字的时候双手都在颤抖。我必须先停下来。",shape=box,color=blue];
		1065 -> 1066;
		1065 -> 1067;
	1066 [label="当然可以。没关系。不急。我随时都在，等你准备好了再说。",shape=box,color=red];
		1066 -> 1068;
	1067 [label="我知道，这已经够让人疲惫的了。好好休息，好吗？还有……谢谢你。这对我意义重大。",shape=box,color=red];
