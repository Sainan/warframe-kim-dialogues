		j3956629060 -> j3275779057;
	j2679308477 [label="看来你和那个奥罗金人的关系搞得一团糟。我倒也不觉得意外。",shape=box,color=blue];
		j2679308477 -> j272503971;
		j2679308477 -> j2665205344;
	j2260588952 [label="我向你保证会解决管家的问题，但看起来计划出现了点问题。",shape=box,color=blue];
		j2260588952 -> j3291097851;
	j2964131535 [label="Mon miracle，我感觉自己心不在焉。我必须道歉。",shape=box,color=blue];
		j2964131535 -> j1448787334;
	j2450475377 [label="我的朋友，我感觉自己心不在焉。我必须道歉。",shape=box,color=blue];
		j2450475377 -> j1448787334;
	j2538369393 [label="别再说了。我可受不了神父的谴责，谢谢。",shape=box,color=red];
		j2538369393 -> j3044139948;
	j1833751743 [label="其实我觉得，如果我朋友的老鼠睡在键盘上乱按键盘，敲出来的文字都比这个强。",shape=box,color=red];
		j1833751743 -> j1732376989;
	j1926588315 [label="她误会了我的意思。",shape=box,color=red];
		j1926588315 -> j591704506;
	j3275779057 [label="我……说了些不该说的话。真希望我能对她做得更好一些。我觉得我没能很好地表达我的意图。",shape=box,color=red];
