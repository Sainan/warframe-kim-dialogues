	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j106281722 [label="玛丽是我的灵魂姐妹，而恶魔欠我一个人情。我不会说是什么事，这是个我打算带进坟墓的秘密，所以别费心来追问了。",shape=box,color=blue];
		j106281722 -> j1699550191;
	j1935018480 [label="听起来，你做得挺不错的。",shape=box,color=blue];
		j1935018480 -> "Chat ends.";
	j4029126843 [label="我会和她谈谈。看看我能做些什么。",shape=box,color=blue];
