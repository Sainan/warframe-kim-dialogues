digraph {
	"LyonRoatheFail begins." [color=orange];
		"LyonRoatheFail begins." -> j3577328385;
		"LyonRoatheFail begins." -> j1038552372;
	j3577328385 [label="里昂，在罗瑟的事情上我需要你的帮忙。",shape=box,color=red];
		j3577328385 -> j421763245;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j421763245 [label="Check boolean LyonDating",color=orange];
		j421763245 -> j3907289728 [label=true,color=green];
		j421763245 -> j2151068622 [label=false,color=brown];
	"Chat ends." [color=orange];
	j3907289728 [label="mon miracle，如果有什么我能帮上忙的，我一定尽力。你们俩之间到底出了什么问题？",shape=box,color=blue];
		j3907289728 -> j1618578127;
	j2151068622 [label="朋友，如果有什么我能帮上忙的，我一定尽力。你们俩之间到底出了什么问题？",shape=box,color=blue];
		j2151068622 -> j1618578127;
	j1618578127 [label="Evaluate expressions",color=orange];
		j1618578127 -> j1791312875 [label="RoatheFail",color=purple];
		j1618578127 -> j1791312875 [label="RoatheFailStall",color=purple];
		j1618578127 -> j335547999 [label="RoatheFailUltimate",color=purple];
		j1618578127 -> j3345371546 [label="RoatheFailNot21",color=purple];
		j1618578127 -> j2781852016 [label="RoatheFailUnloved",color=purple];
	j1791312875 [label="罗瑟一直在努力接受他……嗯……自愿注射血清的事实。我不知道为什么，但我感觉我没能很好地帮助他度过这一关。",shape=box,color=red];
		j1791312875 -> j3036893342;
	j335547999 [label="我不确定。我觉得我说了些不该说的话。",shape=box,color=red];
		j335547999 -> j4190640491;
	j3345371546 [label="他告诉我不要再深入探究他的记忆。所以我没再问。现在我们似乎……卡在这里了？",shape=box,color=red];
		j3345371546 -> j10162985;
	j2781852016 [label="我告诉他我只是想和他保持普通朋友的关系，虽然他似乎并不介意，但现在我觉得我们的关系倒退了。",shape=box,color=red];
		j2781852016 -> j4190640491;
	j3036893342 [label="我明白了。当过去的所作所为被重新审视时，要接受它们确实很难。我诅咒英择谛把他、把我们，逼到了这种可耻的境地。",shape=box,color=blue];
		j3036893342 -> j292936224;
	j4190640491 [label="我明白了。恐怕我必须告诉你，在这件事上我能做的并不多，因为你是在“自食其果”。",shape=box,color=blue];
		j4190640491 -> j4016358685;
	j10162985 [label="我明白了。有时候，出于好意行事并不等同于完全按照对方的要求去做。",shape=box,color=blue];
		j10162985 -> j387085963;
	j292936224 [label="我会尽我所能说服他听你的话。但我建议你为这种行为的解读准备更有力的理由，否则他只会觉得他的行为是懦弱的表现。",shape=box,color=blue];
		j292936224 -> j1303847639;
	j4016358685 [label="如此冷酷无情地对待他人，必然会招致同样的报复。尤其当你面对像罗瑟这样的人时，更是如此。",shape=box,color=blue];
		j4016358685 -> j2921998043;
	j387085963 [label="违背他人的意愿，尤其是像翻看他人的私人记忆和思想这种行为，是非常恶劣的。",shape=box,color=blue];
		j387085963 -> j3308657573;
	j1303847639 [label="因为我知道，正是这件事从内到外地吞噬了他。",shape=box,color=blue];
		j1303847639 -> j681226070;
	j2921998043 [label="我不知道你还有什么办法来纠正这件事。恕我直言，我认为我和玛丽都没办法帮你解决这件事。",shape=box,color=blue];
		j2921998043 -> j3065103088;
	j3308657573 [label="我诅咒英择谛，是他把我们也逼到了如此可耻的境地。",shape=box,color=blue];
		j3308657573 -> j654807268;
	j681226070 [label="我知道这件事上我们还需要玛丽的帮助。不过，说服她可能比较困难，因为你也知道，他们俩之间没什么情谊可言。",shape=box,color=blue];
		j681226070 -> j2001096134;
	j3065103088 [label="或许你现在最好考虑其他方案。",shape=box,color=blue];
		j3065103088 -> "Chat ends.";
	j654807268 [label="但依我看来，帮助他的唯一方法，恐怕只能这样了。而且要继续探索沉沦之地，直到所有记忆都被揭开为止。",shape=box,color=blue];
		j654807268 -> j374150406;
	j2001096134 [label="Boolean LyonRoatheFailFix is now true.",color=orange];
		j2001096134 -> j3958977332;
	j374150406 [label="不管恶魔怎么抗议。",shape=box,color=blue];
		j374150406 -> "Chat ends.";
	j3958977332 [label="月神会指引你。",shape=box,color=blue];
		j3958977332 -> "Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
}