	2265 [label="Chat ends.",color=orange];
	2267 [label="mon miracle，如果有什么我能帮上忙的，我一定尽力。你们俩之间到底出了什么问题？",shape=box,color=blue];
		2267 -> 2269;
	2268 [label="朋友，如果有什么我能帮上忙的，我一定尽力。你们俩之间到底出了什么问题？",shape=box,color=blue];
		2268 -> 2269;
	2269 [label="Evaluate expressions",color=orange];
		2269 -> 2273 [label="RoatheFail",color=purple];
		2269 -> 2273 [label="RoatheFailStall",color=purple];
		2269 -> 2272 [label="RoatheFailUltimate",color=purple];
		2269 -> 2271 [label="RoatheFailNot21",color=purple];
		2269 -> 2270 [label="RoatheFailUnloved",color=purple];
	2273 [label="罗瑟一直在努力接受他……嗯……自愿注射血清的事实。我不知道为什么，但我感觉我没能很好地帮助他度过这一关。",shape=box,color=red];
		2273 -> 2277;
	2272 [label="我不确定。我觉得我说了些不该说的话。",shape=box,color=red];
		2272 -> 2276;
	2271 [label="他告诉我不要再深入探究他的记忆。所以我没再问。现在我们似乎……卡在这里了？",shape=box,color=red];
		2271 -> 2275;
	2270 [label="我告诉他我只是想和他保持普通朋友的关系，虽然他似乎并不介意，但现在我觉得我们的关系倒退了。",shape=box,color=red];
		2270 -> 2274;
	2277 [label="我明白了。当过去的所作所为被重新审视时，要接受它们确实很难。我诅咒英择谛把他、把我们，逼到了这种可耻的境地。",shape=box,color=blue];
		2277 -> 2280;
	2276 [label="我明白了。恐怕我必须告诉你，在这件事上我能做的并不多，因为你是在“自食其果”。",shape=box,color=blue];
		2276 -> 2278;
	2275 [label="我明白了。有时候，出于好意行事并不等同于完全按照对方的要求去做。",shape=box,color=blue];
		2275 -> 2279;
	2274 [label="我明白了。恐怕我必须告诉你，在这件事上我能做的并不多，因为你是在“自食其果”。",shape=box,color=blue];
		2274 -> 2278;
	2280 [label="我会尽我所能说服他听你的话。但我建议你为这种行为的解读准备更有力的理由，否则他只会觉得他的行为是懦弱的表现。",shape=box,color=blue];
		2280 -> 2282;
	2278 [label="如此冷酷无情地对待他人，必然会招致同样的报复。尤其当你面对像罗瑟这样的人时，更是如此。",shape=box,color=blue];
		2278 -> 2281;
	2279 [label="违背他人的意愿，尤其是像翻看他人的私人记忆和思想这种行为，是非常恶劣的。",shape=box,color=blue];
		2279 -> 2341;
	2282 [label="因为我知道，正是这件事从内到外地吞噬了他。",shape=box,color=blue];
		2282 -> 2284;
	2281 [label="我不知道你还有什么办法来纠正这件事。恕我直言，我认为我和玛丽都没办法帮你解决这件事。",shape=box,color=blue];
		2281 -> 2283;
	2341 [label="我诅咒英择谛，是他把我们也逼到了如此可耻的境地。",shape=box,color=blue];
		2341 -> 2342;
	2284 [label="我知道这件事上我们还需要玛丽的帮助。不过，说服她可能比较困难，因为你也知道，他们俩之间没什么情谊可言。",shape=box,color=blue];
		2284 -> 2286;
	2283 [label="或许你现在最好考虑其他方案。",shape=box,color=blue];
		2283 -> 2285;
	2342 [label="但依我看来，帮助他的唯一方法，恐怕只能这样了。而且要继续探索沉沦之地，直到所有记忆都被揭开为止。",shape=box,color=blue];
		2342 -> 2343;
	2286 [label="Update boolean LyonRoatheFailFix",color=orange];
		2286 -> 2287;
	2285 [label="Chat ends.",color=orange];
	2343 [label="不管恶魔怎么抗议。",shape=box,color=blue];
		2343 -> 2344;
	2287 [label="月神会指引你。",shape=box,color=blue];
		2287 -> 2288;
	2344 [label="Chat ends.",color=orange];
	2288 [label="Update boolean MarieRoatheFail",color=orange];
		2288 -> 2339;
