digraph {
	114 [label="LyonRank3Convo3 begins.",color=orange];
		114 -> 115;
	115 [label="我在图书馆帮洛德先生整理书，往书架上放，虽然他坚持说那些奇特的飞行器……也能做这些工作——",shape=box,color=blue];
		115 -> 116;
	116 [label="然后我看到了一本奇特的儿童故事书，描绘的是一个虚构的世界，作者是欧拉瑞娅·英择谛。",shape=box,color=blue];
		116 -> 117;
	117 [label="我立刻注意到，作者与我们“星期日主教”的本名是同姓的，于是我便立即把这本书留给自己。",shape=box,color=blue];
		117 -> 120;
		117 -> 119;
		117 -> 118;
	120 [label="我想我知道你指的是哪本书了……",shape=box,color=red];
		120 -> 123;
	119 [label="我们可以跳过铺垫吗？你想知道什么就问吧。",shape=box,color=red];
		119 -> 122;
	118 [label="[无视]",shape=box,color=red];
		118 -> 121;
	123 [label="+5 Chemistry",color=orange];
		123 -> 125;
	122 [label="Update boolean LyonMITW1",color=orange];
		122 -> 124;
	121 [label="Chat ends.",color=orange];
	125 [label="我就知道。从洛德先生惊恐的表情，还有他立刻叫我把书放回去，说“以免惹你不高兴”来看，我就猜你肯定会知道一些内情。",shape=box,color=blue];
		125 -> 128;
	124 [label="我的问题与“概念成形”的本质有关。读完之后，我明白这本书的目的是教导孩子们如何避免自己的情绪与虚空互动。",shape=box,color=blue];
		124 -> 126;
		124 -> 127;
	128 [label="《双衍王境故事集》。虽然我从洛德先生那里得到了相当……疲惫和漫长的解释，听到你所遭受的苦难，但我还有一件事想问一下。",shape=box,color=blue];
		128 -> 131;
	126 [label="其实并没什么用，尤其对我而言更是如此。",shape=box,color=red];
		126 -> 129;
	127 [label="强烈的情绪与虚空相互作用会造成……严重的问题。",shape=box,color=red];
		127 -> 130;
	131 [label="当然，前提是这样问不会造成太大麻烦？",shape=box,color=blue];
		131 -> 134;
		131 -> 135;
	129 [label="我们​生活​中​有​多​少​东西​是​别人​强加给​我们​的，​并​被​当作​事实，​却​经不​起​考验​并​被​证明毫​无​用处？​",shape=box,color=blue];
		129 -> 132;
	130 [label="看来也确实如此。我见过科维兽。我听说过虚空天使。我亲眼看见低语者。 ",shape=box,color=blue];
		130 -> 133;
	134 [label="不会。你继续。",shape=box,color=red];
		134 -> 122;
	135 [label="这完全取决于具体情况。我完全不知道你想问我什么。",shape=box,color=red];
		135 -> 140;
	132 [label="Update boolean LyonFaith1",color=orange];
		132 -> 136;
	133 [label="这就是我好奇的地方。我之所以把这个问题“说出口”，是想看看你是否能对此多加阐述。当虚空被赋予形态时，从中出来的是什么——它们是“真实”的吗？",shape=box,color=blue];
		133 -> 137;
		133 -> 138;
		133 -> 139;
	140 [label="+5 Chemistry",color=orange];
		140 -> 146;
	136 [label="我常常纳闷，为什么要用这些毫无用处的谎言来蒙蔽他人？他们是为了追求权力？影响力？还是他们真的相信自己所说的话，对自己的谎言浑然不觉？",shape=box,color=blue];
		136 -> 142;
		136 -> 141;
	137 [label="不，我认为虚空所创造的一切都只是……暂时的。是创造它的存在或事物的碎片。是记忆的幽灵。",shape=box,color=red];
		137 -> 143;
	138 [label="我相信是的。就像艺术家创作的一幅画，它可能源于某人的想象，但一旦创作完成，它就是真实的。",shape=box,color=red];
		138 -> 144;
	139 [label="这完全取决于你对“真实”的定义。",shape=box,color=red];
		139 -> 145;
	146 [label="是的，请原谅我。我不太擅长直接沟通，尤其是不擅长用这种奇怪的方式。但我现在会努力尝试。",shape=box,color=blue];
		146 -> 122;
	142 [label="我认为欧拉瑞娅·英择谛的本意是希望她写的东西能有用。只是在我需要的时候，它并没有帮到我。",shape=box,color=red];
		142 -> 148;
	141 [label="我不知道。里昂，那么你的脑子里装着哪些谎言？",shape=box,color=red];
		141 -> 147;
	143 [label="那么，虚空中的这些元素所造成的影响难道不是“真实的”吗？",shape=box,color=blue];
		143 -> 149;
	144 [label="但你用的这个比喻不太准确，对吧？从虚空中提取的物质最终不会回归虚空吗？",shape=box,color=blue];
		144 -> 150;
	145 [label="+5 Chemistry",color=orange];
		145 -> 151;
	148 [label="说句公道话，我患虚空暴露症的时间远远超过了她希望这本书能指导的时间。",shape=box,color=red];
		148 -> 153;
	147 [label="这不是我来找你讨论的事情。",shape=box,color=blue];
		147 -> 152;
	149 [label="许多回忆都曾使人酗酒，甚至促使他们结束自己的生命。难道这些回忆就不是“真实的”吗？",shape=box,color=blue];
		149 -> 154;
	150 [label="很好，这只是一个想法。诗歌或歌曲即使没有被写下来，也依然存在。",shape=box,color=red];
		150 -> 155;
	151 [label="可否请你详细说明一下吗？",shape=box,color=blue];
		151 -> 156;
	153 [label="+5 Chemistry",color=orange];
		153 -> 157;
	152 [label="Chat ends.",color=orange];
	154 [label="但我的意思是，那些都是他自身内在的力量在作用于他，而不是外在的力量。",shape=box,color=red];
		154 -> 158;
	155 [label="但如果它被遗忘，它就不复存在了。一段被时间遗忘的故事，就永远消失了。",shape=box,color=blue];
		155 -> 159;
	156 [label="你怎么判断“真实”？",shape=box,color=red];
		156 -> 160;
		156 -> 161;
		156 -> 162;
	157 [label="若要说我们能希望的最好情况，便是他人的恶意只是源于无知，而非刻意为之。",shape=box,color=blue];
		157 -> 163;
	158 [label="但我的问题是，区别到底是什么？如果最终结果相同，那么这还重要吗？",shape=box,color=blue];
		158 -> 164;
		158 -> 165;
		158 -> 166;
	159 [label="一场被革命者遗忘的革命，其锋芒自然也随之钝化。",shape=box,color=blue];
		159 -> 164;
		159 -> 165;
		159 -> 166;
	160 [label="是凭物理上的永远存在？凭重量和质量？来自虚空的东西，只是暂时暂存于此。",shape=box,color=red];
		160 -> 167;
	161 [label="是根据它对历史进程的影响？来自虚空的事物已经改变了历史的进程。",shape=box,color=red];
		161 -> 168;
	162 [label="是根据它对其他人的影响？来自虚空的“事物”的影响无疑产生了这种影响。",shape=box,color=red];
		162 -> 169;
	163 [label="然而，我的好奇心并非在于这本书本身或其用途。请允许我稍稍抒发一下情感。",shape=box,color=blue];
		163 -> 170;
	164 [label="你不是在问它们是否“真实”，而是在问它们是否“成立”，也就是是否应该被承认或拒绝。",shape=box,color=red];
		164 -> 171;
	165 [label="我也想问，既然你们都无法与太阳神或月神握手，那你们的双耀神还是否“真实存在”？",shape=box,color=red];
		165 -> 172;
	166 [label="你​是​在​拐弯​抹角​地问，​虚空​中​的​所有​“事物”​是否仅仅​是​因为​我们​用意志力​将​它们​创造​出来​的。​",shape=box,color=red];
		166 -> 173;
	167 [label="你是说，来自虚空的事物终将回归虚空？但虚空，从定义上来说，不就是由虚无构成的吗？",shape=box,color=blue];
		167 -> 174;
	168 [label="有道理。难道仅仅因为革命无法被量化，它就不算是“真实的”革命吗？",shape=box,color=blue];
		168 -> 169;
	169 [label="它确实夺去了许多人的生命。他们自然会为其合理性辩护。然而，不妨这样思考：",shape=box,color=blue];
		169 -> 175;
	170 [label="我之所以把这个问题“说出口”，是想看看你是否能对此多加阐述。当虚空被赋予形态时，从中出来的是什么——它们是“真实”的吗？",shape=box,color=blue];
		170 -> 137;
		170 -> 139;
		170 -> 138;
	171 [label="+5 Chemistry",color=orange];
		171 -> 176;
	172 [label="我们讨论的不是双耀神，而是虚空。",shape=box,color=blue];
		172 -> 177;
		172 -> 178;
		172 -> 179;
		172 -> 180;
	173 [label="+5 Chemistry",color=orange];
		173 -> 181;
	174 [label="我想也许是吧？我接触过的虚空部分似乎都已被我们烙印。我们已经赋予了它某种形状或形态。或者说，我们已经模糊了现实之间的界限。",shape=box,color=red];
		174 -> 182;
		174 -> 183;
	175 [label="一场革命只有在发动革命的人心中存在时才成立。",shape=box,color=blue];
		175 -> 184;
	176 [label="是的，我想你可以这么说。我们是不是应该对萦绕在我们大厅里的幽灵视而不见？还是说，如果我们对它们给予关注，反而会助长它们的气焰？",shape=box,color=blue];
		176 -> 177;
		176 -> 178;
		176 -> 179;
		176 -> 180;
	177 [label="我认为我们目前面临的挑战是危险的，极其危险。我们应该以对待危险的态度来对待它们。",shape=box,color=red];
		177 -> 185;
	178 [label="鬼魂的真实存在已经足以给我们带来痛苦了。但它们无法用子弹消灭。至少我还没找到能做到这一点的子弹。",shape=box,color=red];
		178 -> 186;
	179 [label="里昂，你到底想表达什？说真的？",shape=box,color=red];
		179 -> 187;
	180 [label="说实话，里昂，我真的不知道。我也希望我知道。",shape=box,color=red];
		180 -> 188;
	181 [label="是的，我想你可以这么说。我们怎么能确定我们没有……让我们自己的恶化型呢？",shape=box,color=blue];
		181 -> 177;
		181 -> 178;
		181 -> 179;
		181 -> 180;
	182 [label="整个船体，甚至包括月球本身，都曾被放入虚空并被取回。因此，所以在虚空中，虚空并不会直接吞噬物质。",shape=box,color=red];
		182 -> 189;
	183 [label="你是在暗示还有一个“更深的”虚空，在那里任何东西都无法存在。对此我真的无法给出回答。",shape=box,color=red];
		183 -> 190;
	184 [label="如果从周围所有人的记忆中将它抹去，那它就会不复存在，不是吗？",shape=box,color=blue];
		184 -> 165;
		184 -> 164;
		184 -> 166;
	185 [label="Update boolean LyonReal1",color=orange];
		185 -> 191;
	186 [label="Update boolean LyonFake1",color=orange];
		186 -> 192;
	187 [label="Update boolean LyonFaith1",color=orange];
		187 -> 193;
	188 [label="你能坦诚承认自己不知道的事情，这种精神令人耳目一新。但愿更多的人都能拥有这样的品质。",shape=box,color=blue];
		188 -> 194;
	189 [label="我不关心那些被放入虚空又被取出的物质。我关心的是那些完全凭空从虚空中创造出来的东西。",shape=box,color=blue];
		189 -> 164;
		189 -> 165;
		189 -> 166;
	190 [label="我感谢你的坦诚。我想我好奇的不是什么不可存在，而是那些已经存在的。",shape=box,color=blue];
		190 -> 164;
		190 -> 165;
		190 -> 166;
	191 [label="是的，我想你应该很清楚哪些东西可以用武力从虚空中击落，哪些不能……",shape=box,color=blue];
		191 -> 195;
	192 [label="或许这就是为什么那么多人选择沉溺……为了止住那看不见却隐隐作痛的伤口。这伤口其实是可以治愈的，但靠的是心灵的力量，而非武器。",shape=box,color=blue];
		192 -> 195;
	193 [label="我显然完全搞错了方向。我们改天再谈。请原谅我的打扰。",shape=box,color=blue];
		193 -> 196;
	194 [label="然而，我对这件事的看法仍然完全没有定论。",shape=box,color=blue];
		194 -> 193;
	195 [label="虽然我还是心存疑虑。但请原谅我的打扰。漂泊者，谢谢你抽出时间。",shape=box,color=blue];
		195 -> 196;
	196 [label="——里昂·阿拉德神父",shape=box,color=blue];
		196 -> 197;
	197 [label="Chat ends.",color=orange];
}