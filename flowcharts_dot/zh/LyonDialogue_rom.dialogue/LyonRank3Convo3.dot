digraph {
	"LyonRank3Convo3 begins." [color=orange];
		"LyonRank3Convo3 begins." -> j436010504;
	j436010504 [label="我在图书馆帮洛德先生整理书，往书架上放，虽然他坚持说那些奇特的飞行器……也能做这些工作——",shape=box,color=blue];
		j436010504 -> j1520759890;
	j1520759890 [label="然后我看到了一本奇特的儿童故事书，描绘的是一个虚构的世界，作者是欧拉瑞娅·英择谛。",shape=box,color=blue];
		j1520759890 -> j1006314780;
	j1006314780 [label="我立刻注意到，作者与我们“星期日主教”的本名是同姓的，于是我便立即把这本书留给自己。",shape=box,color=blue];
		j1006314780 -> j2883885020;
		j1006314780 -> j1239515796;
		j1006314780 -> j2424094220;
	j2883885020 [label="我想我知道你指的是哪本书了……",shape=box,color=red];
		j2883885020 -> j4010235484;
	j1239515796 [label="我们可以跳过铺垫吗？你想知道什么就问吧。",shape=box,color=red];
		j1239515796 -> j771142124;
	j2424094220 [label="[无视]",shape=box,color=red];
		j2424094220 -> "Chat ends.";
	j4010235484 [label="+5 Chemistry",color=orange];
		j4010235484 -> j1045033531;
	j771142124 [label="Boolean LyonMITW1 is now true.",color=orange];
		j771142124 -> j2004953835;
	"Chat ends." [color=orange];
	j1045033531 [label="我就知道。从洛德先生惊恐的表情，还有他立刻叫我把书放回去，说“以免惹你不高兴”来看，我就猜你肯定会知道一些内情。",shape=box,color=blue];
		j1045033531 -> j3131526090;
	j2004953835 [label="我的问题与“概念成形”的本质有关。读完之后，我明白这本书的目的是教导孩子们如何避免自己的情绪与虚空互动。",shape=box,color=blue];
		j2004953835 -> j2323317338;
		j2004953835 -> j3208714693;
	j3131526090 [label="我看到的就是《双衍王境故事集》。虽然我从洛德先生那里得到了相当……疲惫和漫长的解释，听到你所遭受的苦难，但我还有一件事想问一下。",shape=box,color=blue];
		j3131526090 -> j70698043;
	j2323317338 [label="其实并没什么用，尤其对我而言更是如此。",shape=box,color=red];
		j2323317338 -> j2540391104;
	j3208714693 [label="强烈的情绪与虚空相互作用会造成……严重的问题。",shape=box,color=red];
		j3208714693 -> j1444009198;
	j70698043 [label="当然，前提是这样问不会造成太大麻烦？",shape=box,color=blue];
		j70698043 -> j1602994817;
		j70698043 -> j2822981335;
	j2540391104 [label="我们​生活​中​有​多​少​东西​是​别人​强加给​我们​的，​并​被​当作​事实，​却​经不​起​考验​并​被​证明毫​无​用处？​",shape=box,color=blue];
		j2540391104 -> j1638123023;
	j1444009198 [label="看来也确实如此。我见过科维兽。我听说过虚空天使。我亲眼看见低语者。 ",shape=box,color=blue];
		j1444009198 -> j2004781492;
	j1602994817 [label="不会。你继续。",shape=box,color=red];
		j1602994817 -> j771142124;
	j2822981335 [label="这完全取决于具体情况。我完全不知道你想问我什么。",shape=box,color=red];
		j2822981335 -> j1285989777;
	j1638123023 [label="Boolean LyonFaith1 is now true.",color=orange];
		j1638123023 -> j625179215;
	j2004781492 [label="这就是我好奇的地方。我之所以把这个问题“说出口”，是想看看你是否能对此多加阐述。当虚空被赋予形态时，从中出来的是什么——它们是“真实”的吗？",shape=box,color=blue];
		j2004781492 -> j2992642518;
		j2004781492 -> j3561162796;
		j2004781492 -> j320443429;
	j1285989777 [label="+5 Chemistry",color=orange];
		j1285989777 -> j3118638517;
	j625179215 [label="我常常纳闷，为什么要用这些毫无用处的谎言来蒙蔽他人？他们是为了追求权力？影响力？还是他们真的相信自己所说的话，对自己的谎言浑然不觉？",shape=box,color=blue];
		j625179215 -> j1962537547;
		j625179215 -> j3024168267;
	j2992642518 [label="不，我认为虚空所创造的一切都只是……暂时的。是创造它的存在或事物的碎片。是记忆的幽灵。",shape=box,color=red];
		j2992642518 -> j2743156850;
	j3561162796 [label="我相信是的。就像艺术家创作的一幅画，它可能源于某人的想象，但一旦创作完成，它就是真实的。",shape=box,color=red];
		j3561162796 -> j2463600390;
	j320443429 [label="这完全取决于你对“真实”的定义。",shape=box,color=red];
		j320443429 -> j3244992209;
	j3118638517 [label="是的，请原谅我。我不太擅长直接沟通，尤其是不擅长用这种奇怪的方式。但我现在会努力尝试。",shape=box,color=blue];
		j3118638517 -> j771142124;
	j1962537547 [label="我认为欧拉瑞娅·英择谛的本意是希望她写的东西能有用。只是在我需要的时候，它并没有帮到我。",shape=box,color=red];
		j1962537547 -> j314860889;
	j3024168267 [label="我不知道。里昂，那么你的脑子里装着哪些谎言？",shape=box,color=red];
		j3024168267 -> j1835663389;
	j2743156850 [label="那么，虚空中的这些元素所造成的影响难道不是“真实的”吗？",shape=box,color=blue];
		j2743156850 -> j3871887924;
	j2463600390 [label="但你用的这个比喻不太准确，对吧？从虚空中提取的物质最终不会回归虚空吗？",shape=box,color=blue];
		j2463600390 -> j2239942498;
	j3244992209 [label="+5 Chemistry",color=orange];
		j3244992209 -> j92172623;
	j314860889 [label="说句公道话，我患虚空暴露症的时间远远超过了她希望这本书能指导的时间。",shape=box,color=red];
		j314860889 -> j2743743357;
	j1835663389 [label="这不是我来找你讨论的事情。",shape=box,color=blue];
		j1835663389 -> "Chat ends.";
	j3871887924 [label="许多回忆都曾使人酗酒，甚至促使他们结束自己的生命。难道这些回忆就不是“真实的”吗？",shape=box,color=blue];
		j3871887924 -> j2792422945;
	j2239942498 [label="那我们换个比喻，比如说像个想法。诗歌或歌曲即使没有被写下来，也依然存在。",shape=box,color=red];
		j2239942498 -> j894725065;
	j92172623 [label="可否请你详细说明一下吗？",shape=box,color=blue];
		j92172623 -> j369108663;
	j2743743357 [label="+5 Chemistry",color=orange];
		j2743743357 -> j3363557650;
	j2792422945 [label="但我的意思是，那些都是他自身内在的力量在作用于他，而不是外在的力量。",shape=box,color=red];
		j2792422945 -> j3924264862;
	j894725065 [label="但如果它被遗忘，它就不复存在了。一段被时间遗忘的故事，就永远消失了。",shape=box,color=blue];
		j894725065 -> j1355169631;
	j369108663 [label="你怎么判断“真实”？",shape=box,color=red];
		j369108663 -> j4084160907;
		j369108663 -> j4198257351;
		j369108663 -> j2665343017;
	j3363557650 [label="若要说我们能希望的最好情况，便是他人的恶意只是源于无知，而非刻意为之。",shape=box,color=blue];
		j3363557650 -> j1815775470;
	j3924264862 [label="但我的问题是，区别到底是什么？如果最终结果相同，那么这还重要吗？",shape=box,color=blue];
		j3924264862 -> j965702967;
		j3924264862 -> j2504658083;
		j3924264862 -> j4019110946;
	j1355169631 [label="一场被革命者遗忘的革命，其锋芒自然也随之钝化。",shape=box,color=blue];
		j1355169631 -> j965702967;
		j1355169631 -> j2504658083;
		j1355169631 -> j4019110946;
	j4084160907 [label="是凭物理上的永远存在？凭重量和质量？来自虚空的东西，只是暂时暂存于此。",shape=box,color=red];
		j4084160907 -> j3106333112;
	j4198257351 [label="是根据它对历史进程的影响？来自虚空的事物已经改变了历史的进程。",shape=box,color=red];
		j4198257351 -> j1787881432;
	j2665343017 [label="是根据它对其他人的影响？来自虚空的“事物”的影响无疑产生了这种影响。",shape=box,color=red];
		j2665343017 -> j732104708;
	j1815775470 [label="然而，我的好奇心并非在于这本书本身或其用途。请允许我稍稍抒发一下情感。",shape=box,color=blue];
		j1815775470 -> j3067783343;
	j965702967 [label="你不是在问它们是否“真实”，而是在问它们是否“成立”，也就是是否应该被承认或拒绝。",shape=box,color=red];
		j965702967 -> j3758932507;
	j2504658083 [label="我也想问，既然你们都无法与太阳神或月神握手，那你们的双耀神还是否“真实存在”？",shape=box,color=red];
		j2504658083 -> j1260590588;
	j4019110946 [label="你​是​在​拐弯​抹角​地问，​虚空​中​的​所有​“事物”​是否仅仅​是​因为​我们​用意志力​将​它们​创造​出来​的。​",shape=box,color=red];
		j4019110946 -> j1698661654;
	j3106333112 [label="你是说，来自虚空的事物终将回归虚空？但虚空，从定义上来说，不就是由虚无构成的吗？",shape=box,color=blue];
		j3106333112 -> j716783399;
	j1787881432 [label="有道理。难道仅仅因为革命无法被量化，它就不算是“真实的”革命吗？",shape=box,color=blue];
		j1787881432 -> j732104708;
	j732104708 [label="它确实夺去了许多人的生命。他们自然会为其合理性辩护。然而，不妨这样思考：",shape=box,color=blue];
		j732104708 -> j3117635420;
	j3067783343 [label="我之所以把这个问题“说出口”，是想看看你是否能对此多加阐述。当虚空被赋予形态时，从中出来的是什么——它们是“真实”的吗？",shape=box,color=blue];
		j3067783343 -> j2992642518;
		j3067783343 -> j320443429;
		j3067783343 -> j3561162796;
	j3758932507 [label="+5 Chemistry",color=orange];
		j3758932507 -> j3944871140;
	j1260590588 [label="我们讨论的不是双耀神，而是虚空。",shape=box,color=blue];
		j1260590588 -> j3998695868;
		j1260590588 -> j1886854247;
		j1260590588 -> j426515982;
		j1260590588 -> j3043037462;
	j1698661654 [label="+5 Chemistry",color=orange];
		j1698661654 -> j3927454222;
	j716783399 [label="我想也许是吧？我接触过的虚空部分似乎都已被我们烙印。我们已经赋予了它某种形状或形态。或者说，我们已经模糊了现实之间的界限。",shape=box,color=red];
		j716783399 -> j2912000388;
		j716783399 -> j492366969;
	j3117635420 [label="一场革命只有在发动革命的人心中存在时才成立。",shape=box,color=blue];
		j3117635420 -> j1876982970;
	j3944871140 [label="是的，我想你可以这么说。我们是不是应该对萦绕在我们大厅里的幽灵视而不见？还是说，如果我们对它们给予关注，反而会助长它们的气焰？",shape=box,color=blue];
		j3944871140 -> j3998695868;
		j3944871140 -> j1886854247;
		j3944871140 -> j426515982;
		j3944871140 -> j3043037462;
	j3998695868 [label="我认为我们目前面临的挑战是危险的，极其危险。我们应该以对待危险的态度来对待它们。",shape=box,color=red];
		j3998695868 -> j3884408560;
	j1886854247 [label="鬼魂的真实存在已经足以给我们带来痛苦了。但它们无法用子弹消灭。至少我还没找到能做到这一点的子弹。",shape=box,color=red];
		j1886854247 -> j329153961;
	j426515982 [label="说真的。里昂，你到底想表达什么？",shape=box,color=red];
		j426515982 -> j3783783896;
	j3043037462 [label="说实话，里昂，我真的不知道。我也希望我知道。",shape=box,color=red];
		j3043037462 -> j433217323;
	j3927454222 [label="是的，我想你可以这么说。我们怎么能确定我们没有……让我们自己的恶化型呢？",shape=box,color=blue];
		j3927454222 -> j3998695868;
		j3927454222 -> j1886854247;
		j3927454222 -> j426515982;
		j3927454222 -> j3043037462;
	j2912000388 [label="整个船体，甚至包括月球本身，都曾被放入虚空并被取回。因此，所以在虚空中，虚空并不会直接吞噬物质。",shape=box,color=red];
		j2912000388 -> j2321182372;
	j492366969 [label="你是在暗示还有一个“更深的”虚空，在那里任何东西都无法存在。对此我真的无法给出回答。",shape=box,color=red];
		j492366969 -> j1302393950;
	j1876982970 [label="如果从周围所有人的记忆中将它抹去，那它就会不复存在，不是吗？",shape=box,color=blue];
		j1876982970 -> j2504658083;
		j1876982970 -> j965702967;
		j1876982970 -> j4019110946;
	j3884408560 [label="Boolean LyonReal1 is now true.",color=orange];
		j3884408560 -> j1333783860;
	j329153961 [label="Boolean LyonFake1 is now true.",color=orange];
		j329153961 -> j2627572845;
	j3783783896 [label="Boolean LyonFaith1 is now true.",color=orange];
		j3783783896 -> j2290116147;
	j433217323 [label="你能坦诚承认自己不知道的事情，这种精神令人耳目一新。但愿更多的人都能拥有这样的品质。",shape=box,color=blue];
		j433217323 -> j576375211;
	j2321182372 [label="我不关心那些被放入虚空又被取出的物质。我关心的是那些完全凭空从虚空中创造出来的东西。",shape=box,color=blue];
		j2321182372 -> j965702967;
		j2321182372 -> j2504658083;
		j2321182372 -> j4019110946;
	j1302393950 [label="我感谢你的坦诚。我想我好奇的不是什么不可存在，而是那些已经存在的。",shape=box,color=blue];
		j1302393950 -> j965702967;
		j1302393950 -> j2504658083;
		j1302393950 -> j4019110946;
	j1333783860 [label="是的，我想你应该很清楚哪些东西可以用武力从虚空中击落，哪些不能……",shape=box,color=blue];
		j1333783860 -> j3486928248;
	j2627572845 [label="或许这就是为什么那么多人选择沉溺……为了止住那看不见却隐隐作痛的伤口。这伤口其实是可以治愈的，但靠的是心灵的力量，而非武器。",shape=box,color=blue];
		j2627572845 -> j3486928248;
	j2290116147 [label="我显然完全搞错了方向。我们改天再谈。请原谅我的打扰。",shape=box,color=blue];
		j2290116147 -> j82610256;
	j576375211 [label="然而，我对这件事的看法仍然完全没有定论。",shape=box,color=blue];
		j576375211 -> j2290116147;
	j3486928248 [label="虽然我还是心存疑虑。但请原谅我的打扰。漂泊者，谢谢你抽出时间。",shape=box,color=blue];
		j3486928248 -> j82610256;
	j82610256 [label="——里昂·阿拉德神父",shape=box,color=blue];
		j82610256 -> "Chat ends.";
}