	j523882009 [label="里昂？我们可以聊聊吗？ ",shape=box,color=red];
		j523882009 -> j4261959532;
	j2644301460 [label="里昂？如果我说的话让你感到不舒服，我非常非常抱歉。那并非我的本意。",shape=box,color=red];
		j2644301460 -> j4150743085;
	j1539310692 [label="[结束]",shape=box,color=red];
		j1539310692 -> j2883342425;
	j4261959532 [label="漂泊者，你想聊些什么？",shape=box,color=blue];
		j4261959532 -> j3224575815;
	j4150743085 [label="那么，我只能纳闷了，如果你不是为了好玩而故意和我调情让我感到不舒服……那你当初为什么要和我调情呢？",shape=box,color=blue];
		j4150743085 -> j1220017637;
		j4150743085 -> j2816210041;
		j4150743085 -> j525879401;
	j2883342425 [label="Boolean LyonFlirtIgnored is now true.",color=orange];
		j2883342425 -> "Chat ends.";
	j3224575815 [label="你这些轻佻的话只是为了自娱自乐吗？还是你想换个话题？",shape=box,color=blue];
		j3224575815 -> j3177739519;
		j3224575815 -> j2258718083;
		j3224575815 -> j525879401;
	j1220017637 [label="里昂，我对你很感兴趣。就这么简单。",shape=box,color=red];
		j1220017637 -> j1152138603;
	j2816210041 [label="里昂，我不知道自己当时是怎么了。显然这一切都是个错误。我非常抱歉。",shape=box,color=red];
		j2816210041 -> j1718133512;
	j525879401 [label="我……说的都是真心话。但这一切发生得太快了，我明白。",shape=box,color=red];
		j525879401 -> j1718133512;
	"Chat ends." [color=orange];
	j3177739519 [label="里昂，我跟你调情不是为了取乐。如果你误会了，我很抱歉。",shape=box,color=red];
		j3177739519 -> j1718133512;
	j2258718083 [label="我不是故意冒犯你的，我只是开玩笑。对不起。",shape=box,color=red];
		j2258718083 -> j3210715488;
	j1152138603 [label="我对你并没有。就这么简单。",shape=box,color=blue];
		j1152138603 -> "Chat ends.";
	j1718133512 [label="我……漂泊者，请原谅我。",shape=box,color=blue];
		j1718133512 -> j3403998329;
	j3210715488 [label="我知道了。",shape=box,color=blue];
		j3210715488 -> "Chat ends.";
	j3403998329 [label="请原谅我再次直言不讳，我想表达一下最近一直萦绕在我心头的各种事情：",shape=box,color=blue];
		j3403998329 -> j2239334939;
	j2239334939 [label="我现在身处一个充满奇幻疯狂和看似无休止的肆意杀戮的世界，周围都是陌生人和会说话的野兽。",shape=box,color=blue];
		j2239334939 -> j826891424;
	j826891424 [label="我的一切认知都被“翠玉之光”的耀眼光束、“奥罗金帝国”和“虚空”席卷而去，并受到“低语者”的威胁。",shape=box,color=blue];
		j826891424 -> j2314724935;
	j2314724935 [label="所以，如果我觉得你这番喜欢我的提议天真得有些可笑，还请你见谅。我既不认识你，也不信任你。事实上，我所能相信的，只是别人的一面之词。",shape=box,color=blue];
		j2314724935 -> j1282478905;
	j1282478905 [label="那些我既不认识也不信任的人的话。",shape=box,color=blue];
		j1282478905 -> j3726542096;
	j3726542096 [label="所有这些都压在玛丽和我的身上，更别提那些看不见的挑战了。",shape=box,color=blue];
		j3726542096 -> j2872606016;
	j2872606016 [label="我很感谢你的坦白。我知道你的好意，并为此感谢你。我希望，如果将来我重新考虑你的提议，你仍然愿意回应。",shape=box,color=blue];
		j2872606016 -> j1522197615;
		j2872606016 -> j1622429278;
		j2872606016 -> j3685006932;
	j1522197615 [label="神父，话别说那么死。",shape=box,color=red];
		j1522197615 -> j333045108;
	j1622429278 [label="用我一位挚友的话来说，“伙计，我这个人很固执。”",shape=box,color=red];
		j1622429278 -> j2979574567;
