digraph {
	32 [label="LyonRank3Convo2 begins.",color=orange];
		32 -> 33;
	33 [label="如果可以的话，我想给你讲一个故事，是关于一只经常出没于教堂后面的流浪猫的。",shape=box,color=blue];
		33 -> 36;
		33 -> 35;
		33 -> 34;
	36 [label="请继续说。",shape=box,color=red];
		36 -> 39;
	35 [label="为什么？",shape=box,color=red];
		35 -> 38;
	34 [label="[无视]",shape=box,color=red];
		34 -> 37;
	39 [label="谢谢。",shape=box,color=blue];
		39 -> 41;
	38 [label="我觉得解释起来会很费劲，不值得。",shape=box,color=blue];
		38 -> 40;
	37 [label="Chat ends.",color=orange];
	41 [label="虽然我觉得这个故事并非这只老流浪猫独有，而且我与他的交集似乎也不算什么大事，但无论如何，它仍值得被讲述。",shape=box,color=blue];
		41 -> 43;
	40 [label="算了，不说了。",shape=box,color=blue];
		40 -> 42;
	43 [label="他每天都会来讨点残羹剩饭，以及我和其他疼爱他的兄弟姐妹的那点的微薄的关爱。",shape=box,color=blue];
		43 -> 44;
	42 [label="Chat ends.",color=orange];
	44 [label="他的毛很凌乱，腿一瘸一拐，耳朵还缺了一块。 ",shape=box,color=blue];
		44 -> 45;
	45 [label="他有几天都没来，玛丽担心得快要疯了。可是，对于一只已经走到了生命的尽头的流浪猫，除了向月神祈祷，我们又能做什么呢？",shape=box,color=blue];
		45 -> 46;
	46 [label="Update boolean LyonStray",color=orange];
		46 -> 47;
		46 -> 48;
		46 -> 49;
	47 [label="[让他继续]",shape=box,color=red];
		47 -> 50;
	48 [label="你们的宗教允许这样做吗？我是说，为动物祈祷。",shape=box,color=red];
		48 -> 51;
	49 [label="你会为死去的流浪猫祈祷吗？",shape=box,color=red];
		49 -> 52;
	50 [label="不过，当我在市场买面包时，我看到那只老猫坐在摊主旁边，我感到非常惊讶。",shape=box,color=blue];
		50 -> 53;
	51 [label="+10 Chemistry",color=orange];
		51 -> 54;
	52 [label="当然。这些是我所遇到的一些最纯洁、最聪慧的灵魂，却被包裹在野兽的肉身之中。当然，我无权评判双耀神是如何指引它们走上这条道路。",shape=box,color=blue];
		52 -> 55;
	53 [label="他像往常一样，用沙哑的喵叫声向我打招呼，然后跳下来蹭我的腿。",shape=box,color=blue];
		53 -> 56;
	54 [label="问得好。在某些教派中，不可以，这会被视为异端邪说。但在我们教派中，可以。我们认为动物拥有灵魂。",shape=box,color=blue];
		54 -> 55;
	55 [label="圣徒伊丽莎白以善待动物而闻名，尽管许多传统教派并不承认圣徒是双耀神的使徒。",shape=box,color=blue];
		55 -> 57;
	56 [label="而值得一提的是，漂泊者，他那天走路一点都不跛了。",shape=box,color=blue];
		56 -> 58;
	57 [label="我不禁会想，我们这个修会的影响是否延续至今……但这并非我们谈话的重点。",shape=box,color=blue];
		57 -> 59;
	58 [label="“啊，我看你也是被老德福罗骗过的傻瓜之一啊。”那人一边笑着一边把我的面包装进袋子里。",shape=box,color=blue];
		58 -> 60;
	59 [label="Update boolean LyonLecture1",color=orange];
		59 -> 50;
	60 [label="原来那只老猫一直在耍我们和附近的邻居。它既没有挨饿，也没有生病，更没有受到任何虐待。",shape=box,color=blue];
		60 -> 61;
	61 [label="如果那人的话属实，他在附近的鸟群中是有名的刽子手。",shape=box,color=blue];
		61 -> 62;
		61 -> 63;
		61 -> 64;
	62 [label="老德福罗再来的时候，你有停止喂它吗？",shape=box,color=red];
		62 -> 65;
	63 [label="你是想警告我关于罗瑟的事吗？",shape=box,color=red];
		63 -> 66;
	64 [label="你就是故事里的那只流浪猫吗？",shape=box,color=red];
		64 -> 67;
	65 [label="+10 Chemistry",color=orange];
		65 -> 68;
	66 [label="还有很多事情需要警告你，关于我们家门口的恶魔“星期日主教”。也许这算是其中之一，也许不是。",shape=box,color=blue];
		66 -> 69;
	67 [label="双耀神们都知道，我近来确实疲惫不堪。但这是否意在警示我呢？或许是，或许不是。",shape=box,color=blue];
		67 -> 69;
	68 [label="没有，我们没有停。事实上，玛丽反而更加喜爱他，还逗他，说他是“她的小淘气”。",shape=box,color=blue];
		68 -> 70;
	69 [label="这只是一个例子，说明有时候，当一个生物似乎需要帮助时——",shape=box,color=blue];
		69 -> 71;
	70 [label="但我们不再为他操心了。我们知道老德福罗完全可以照顾好自己。他不需要我们。",shape=box,color=blue];
		70 -> 72;
		70 -> 73;
	71 [label="+15 Chemistry",color=orange];
		71 -> 74;
	72 [label="你知道老德福罗后来怎么样了吗？",shape=box,color=red];
		72 -> 75;
	73 [label="你觉得如果不是出于必要，那是什么原因促使老德福罗来找你呢？",shape=box,color=red];
		73 -> 76;
	74 [label="——先检查一下它的爪子有多锋利。",shape=box,color=blue];
		74 -> 77;
	75 [label="两年后，他的再次失踪变成了永久失踪。",shape=box,color=blue];
		75 -> 78;
		75 -> 79;
	76 [label="我给出的答案或许会带有讽刺意味：“贪欲”。既然可以吃一次大餐，为什么不能吃两次？为什么不能吃十次？",shape=box,color=blue];
		76 -> 80;
		76 -> 81;
	77 [label="Chat ends.",color=orange];
	78 [label="你有为他祷告过吗？",shape=box,color=red];
		78 -> 82;
	79 [label="我希望他离开这个世界时是带着安详和爱的。",shape=box,color=red];
		79 -> 83;
	80 [label="有没有一个不带愤世嫉俗的答案？",shape=box,color=red];
		80 -> 84;
	81 [label="如果他只是想要被爱呢？",shape=box,color=red];
		81 -> 85;
	82 [label="得知他去世的那天晚上，我为他点燃了一支蜡烛，并向月神祈祷，希望她能引导他的灵魂去往……她愿意收留像他这样的小精灵的地方。",shape=box,color=blue];
		82 -> 86;
	83 [label="请问为什么？",shape=box,color=blue];
		83 -> 87;
		83 -> 88;
	84 [label="+10 Chemistry",color=orange];
		84 -> 89;
	85 [label="对爱的贪婪渴望也是一种贪欲，只不过它不是用肉食和美酒来满足饥渴罢了。更何况他是靠装可怜来换取？",shape=box,color=blue];
		85 -> 90;
		85 -> 91;
	86 [label="也感谢了老德福罗给玛丽带来的所有快乐，而我们只需提供好吃的鸡软骨和摸摸头。",shape=box,color=blue];
		86 -> 92;
	87 [label="他是一只动物。他只是在寻找满足感——食物、住所、爱——他的动机与人类截然不同。他并非“撒谎”，他只是用不同的工具去狩猎。",shape=box,color=red];
		87 -> 93;
	88 [label="里昂，我见过太多暴力了，其中很多都是我造成的。我现在希望，每个人，无论他们是谁，无论他们做过什么，都能在爱他们的人的陪伴下安详地离世。",shape=box,color=red];
		88 -> 94;
	89 [label="我发现自己竟然……对这只猫心生敬意，因为它在这个世界上找到了属于自己的位置。",shape=box,color=blue];
		89 -> 95;
	90 [label="里昂，他只是一只猫，他几乎不知道自己在做什么。",shape=box,color=red];
		90 -> 96;
	91 [label="我们还在谈论猫，对吧？",shape=box,color=red];
		91 -> 97;
	92 [label="谢谢你。我先不打扰你了。",shape=box,color=blue];
		92 -> 98;
	93 [label="他并没有从人们身上夺走什么，反而让你们都成了他的“傻瓜”。如果要说有什么的话……你们似乎都从他的来访中获得更多东西。",shape=box,color=red];
		93 -> 99;
	94 [label="真有趣。我原以为你会痛恨你的敌人。但这是我的愚昧之处——我竟然自以为知道当今世代的人们会如何行事。",shape=box,color=blue];
		94 -> 100;
	95 [label="这是一个学会利用自身状况——外貌、年龄、伤疤——作为武器来对抗周围那些看不穿他诡计的“傻瓜”的生物。",shape=box,color=blue];
		95 -> 101;
	96 [label="他可是很清楚该如何装跛脚。 ",shape=box,color=blue];
		96 -> 84;
	97 [label="漂泊者，你想从这段对话中得出什么结论都行。",shape=box,color=blue];
		97 -> 84;
	98 [label="——里昂·阿拉德神父",shape=box,color=blue];
		98 -> 102;
	99 [label="Add -1 to Thermostat",color=orange];
		99 -> 103;
	100 [label="Add 1 to Thermostat",color=orange];
		100 -> 104;
	101 [label="他真是个毛茸茸的小淘气，浑身乱糟糟的。可每次他来拜访，我还是忍不住想摸摸他。",shape=box,color=blue];
		101 -> 105;
	102 [label="Chat ends.",color=orange];
	103 [label="是的，我想我们确实如此。我们并不缺那几块鸡软骨或那几下摸摸头。",shape=box,color=blue];
		103 -> 106;
	104 [label="更何况是像你这样有着特别精彩成长经历的人。 ",shape=box,color=blue];
		104 -> 107;
	105 [label="两年后，他的再次失踪却是永久性的，这让我同样心碎。",shape=box,color=blue];
		105 -> 78;
		105 -> 79;
	106 [label="也许正因如此，我才为他点燃了一支蜡烛，并向月神祈祷，希望她能带走他的灵魂，引导他去往……她愿意收留像他这样的小精灵的地方。",shape=box,color=blue];
		106 -> 108;
	107 [label="+5 Chemistry",color=orange];
		107 -> 109;
	108 [label="+5 Chemistry",color=orange];
		108 -> 110;
	109 [label="谢谢。我先不打扰你了。这次谈话非常有趣。期待下次再聊。",shape=box,color=blue];
		109 -> 111;
	110 [label="那天晚上，我也在祈祷中感谢了老德福罗，感谢他给玛丽带来的所有快乐。",shape=box,color=blue];
		110 -> 112;
	111 [label="——里昂·阿拉德神父",shape=box,color=blue];
		111 -> 113;
	112 [label="或许他那些小小的恶行，从某种意义上来说，也算是一件好事。",shape=box,color=blue];
		112 -> 109;
	113 [label="Chat ends.",color=orange];
}