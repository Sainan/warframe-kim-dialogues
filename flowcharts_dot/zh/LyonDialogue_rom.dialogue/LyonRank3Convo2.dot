digraph {
	"LyonRank3Convo2 begins." [color=orange];
		"LyonRank3Convo2 begins." -> j969526213;
	j969526213 [label="如果可以的话，我想给你讲一个故事，是关于一只经常出没于教堂后面的流浪猫的。",shape=box,color=blue];
		j969526213 -> j475206872;
		j969526213 -> j2339187645;
		j969526213 -> j2424094220;
	j475206872 [label="请继续说。",shape=box,color=red];
		j475206872 -> j4275235271;
	j2339187645 [label="为什么？",shape=box,color=red];
		j2339187645 -> j736657381;
	j2424094220 [label="[无视]",shape=box,color=red];
		j2424094220 -> "Chat ends.";
	j4275235271 [label="谢谢。",shape=box,color=blue];
		j4275235271 -> j638029314;
	j736657381 [label="我觉得解释起来会很费劲，不值得。",shape=box,color=blue];
		j736657381 -> j1187564040;
	"Chat ends." [color=orange];
	j638029314 [label="虽然我觉得这个故事并非这只老流浪猫独有，而且我与他的交集似乎也不算什么大事，但无论如何，它仍值得被讲述。",shape=box,color=blue];
		j638029314 -> j2729917416;
	j1187564040 [label="算了，不说了。",shape=box,color=blue];
		j1187564040 -> "Chat ends.";
	j2729917416 [label="他每天都会来讨点残羹剩饭，以及我和其他疼爱他的兄弟姐妹的那点的微薄的关爱。",shape=box,color=blue];
		j2729917416 -> j4275828888;
	j4275828888 [label="他的毛很凌乱，腿一瘸一拐，耳朵还缺了一块。 ",shape=box,color=blue];
		j4275828888 -> j2456850911;
	j2456850911 [label="他有几天都没来，玛丽担心得快要疯了。可是，对于一只已经走到了生命的尽头的流浪猫，除了向月神祈祷，我们又能做什么呢？",shape=box,color=blue];
		j2456850911 -> j3437213928;
	j3437213928 [label="Boolean LyonStray is now true.",color=orange];
		j3437213928 -> j2855268816;
		j3437213928 -> j4001500590;
		j3437213928 -> j4094205180;
	j2855268816 [label="[让他继续]",shape=box,color=red];
		j2855268816 -> j4116286133;
	j4001500590 [label="你们的宗教允许这样做吗？我是说，为动物祈祷。",shape=box,color=red];
		j4001500590 -> j3981184175;
	j4094205180 [label="你会为死去的流浪猫祈祷吗？",shape=box,color=red];
		j4094205180 -> j3221610916;
	j4116286133 [label="不过，当我在市场买面包时，我看到那只老猫坐在摊主旁边，我感到非常惊讶。",shape=box,color=blue];
		j4116286133 -> j458076052;
	j3981184175 [label="+10 Chemistry",color=orange];
		j3981184175 -> j4286898735;
	j3221610916 [label="当然。有些我遇到的最纯洁、最聪慧的灵魂，却被包裹在野兽的肉身之中。当然，我无权评判双耀神是如何指引它们走上这条道路。",shape=box,color=blue];
		j3221610916 -> j2908890577;
	j458076052 [label="他像往常一样，用沙哑的喵叫声向我打招呼，然后跳下来蹭我的腿。",shape=box,color=blue];
		j458076052 -> j1386004526;
	j4286898735 [label="问得好。在某些教派中，不可以，这会被视为异端邪说。但在我们教派中，可以。我们认为动物拥有灵魂。",shape=box,color=blue];
		j4286898735 -> j2908890577;
	j2908890577 [label="圣徒伊丽莎白以善待动物而闻名，尽管许多传统教派并不承认圣徒是双耀神的使徒。",shape=box,color=blue];
		j2908890577 -> j735071542;
	j1386004526 [label="而值得一提的是，漂泊者，他那天走路一点都不跛了。",shape=box,color=blue];
		j1386004526 -> j4059705989;
	j735071542 [label="我不禁会想，我们这个修会的影响是否延续至今……但这并非我们谈话的重点。",shape=box,color=blue];
		j735071542 -> j1715766087;
	j4059705989 [label="“啊，我看你也是被老德福罗骗过的傻瓜之一啊。”那人一边笑着一边把我的面包装进袋子里。",shape=box,color=blue];
		j4059705989 -> j3566165059;
	j1715766087 [label="Boolean LyonLecture1 is now true.",color=orange];
		j1715766087 -> j4116286133;
	j3566165059 [label="原来那只老猫一直在耍我们和附近的邻居。它既没有挨饿，也没有生病，更没有受到任何虐待。",shape=box,color=blue];
		j3566165059 -> j1267848302;
	j1267848302 [label="如果那人的话属实，他在附近的鸟群中是有名的刽子手。",shape=box,color=blue];
		j1267848302 -> j2010636859;
		j1267848302 -> j1873363840;
		j1267848302 -> j2032047694;
	j2010636859 [label="老德福罗再来的时候，你有停止喂它吗？",shape=box,color=red];
		j2010636859 -> j4197426260;
	j1873363840 [label="你是想警告我关于罗瑟的事吗？",shape=box,color=red];
		j1873363840 -> j3018818173;
	j2032047694 [label="你就是故事里的那只流浪猫吗？",shape=box,color=red];
		j2032047694 -> j1013686648;
	j4197426260 [label="+10 Chemistry",color=orange];
		j4197426260 -> j2130821989;
	j3018818173 [label="还有很多事情需要警告你，关于“星期日主教”留在我们家门口的恶魔。也许这算是其中之一，也许不是。",shape=box,color=blue];
		j3018818173 -> j3653911268;
	j1013686648 [label="双耀神们都知道，我近来确实疲惫不堪。但这是否意在警示我关于你的事呢？或许是，或许不是。",shape=box,color=blue];
		j1013686648 -> j3653911268;
	j2130821989 [label="没有，我们没有停。事实上，玛丽反而更加喜爱他，还逗他，说他是“她的小淘气”。",shape=box,color=blue];
		j2130821989 -> j4034472756;
	j3653911268 [label="这只是一个例子，说明有时候，当一个生物似乎需要帮助时——",shape=box,color=blue];
		j3653911268 -> j3375323307;
	j4034472756 [label="但我们不再为他操心了。我们知道老德福罗完全可以照顾好自己。他不需要我们。",shape=box,color=blue];
		j4034472756 -> j241012652;
		j4034472756 -> j1178794706;
	j3375323307 [label="+15 Chemistry",color=orange];
		j3375323307 -> j1697526414;
	j241012652 [label="你知道老德福罗后来怎么样了吗？",shape=box,color=red];
		j241012652 -> j2738834349;
	j1178794706 [label="你觉得如果不是出于必要，那是什么原因促使老德福罗来找你呢？",shape=box,color=red];
		j1178794706 -> j1259457810;
	j1697526414 [label="——先检查一下它的爪子有多锋利。",shape=box,color=blue];
		j1697526414 -> "Chat ends.";
	j2738834349 [label="两年后，他的再次失踪变成了永久失踪。",shape=box,color=blue];
		j2738834349 -> j2405383944;
		j2738834349 -> j3995085897;
	j1259457810 [label="我给出的答案或许会有点愤世嫉俗：“贪欲”。既然可以吃一次大餐，为什么不能吃两次？为什么不能吃十次？",shape=box,color=blue];
		j1259457810 -> j847166383;
		j1259457810 -> j4192481576;
	j2405383944 [label="你有为他祷告过吗？",shape=box,color=red];
		j2405383944 -> j1435287199;
	j3995085897 [label="我希望他离开这个世界时是带着安详和爱的。",shape=box,color=red];
		j3995085897 -> j2659116178;
	j847166383 [label="有没有一个不带愤世嫉俗的答案？",shape=box,color=red];
		j847166383 -> j141840425;
	j4192481576 [label="如果他只是想要被爱呢？",shape=box,color=red];
		j4192481576 -> j353701057;
	j1435287199 [label="得知他去世的那天晚上，我为他点燃了一支蜡烛，并向月神祈祷，希望她能引导他的灵魂去往……她愿意收留像他这样的小精灵的地方。",shape=box,color=blue];
		j1435287199 -> j66689435;
	j2659116178 [label="请问为什么？",shape=box,color=blue];
		j2659116178 -> j1024396663;
		j2659116178 -> j3328947056;
	j141840425 [label="+10 Chemistry",color=orange];
		j141840425 -> j2908768837;
	j353701057 [label="对爱的贪婪渴望也是一种贪欲，只不过它不是用肉食和美酒来满足饥渴罢了。更何况他是靠装可怜来换取？",shape=box,color=blue];
		j353701057 -> j3586559051;
		j353701057 -> j576730125;
	j66689435 [label="也感谢了老德福罗给玛丽带来的所有快乐，而我们只需提供好吃的鸡软骨和摸摸头。",shape=box,color=blue];
		j66689435 -> j804568835;
	j1024396663 [label="他是一只动物。他只是在寻找满足感——食物、住所、爱——他的动机与人类截然不同。他并非“撒谎”，他只是用不同的工具去狩猎。",shape=box,color=red];
		j1024396663 -> j1041984903;
	j3328947056 [label="里昂，我见过太多暴力了，其中很多都是我造成的。我现在希望，每个人，无论他们是谁，无论他们做过什么，都能在爱他们的人的陪伴下安详地离世。",shape=box,color=red];
		j3328947056 -> j1561149497;
	j2908768837 [label="我发现自己竟然……对这只猫心生敬意，因为它在这个世界上找到了属于自己的位置。",shape=box,color=blue];
		j2908768837 -> j3507359263;
	j3586559051 [label="里昂，他只是一只猫，他几乎不知道自己在做什么。",shape=box,color=red];
		j3586559051 -> j2203427072;
	j576730125 [label="我们还在谈论猫，对吧？",shape=box,color=red];
		j576730125 -> j1319420123;
	j804568835 [label="谢谢你。我先不打扰你了。",shape=box,color=blue];
		j804568835 -> j82610256;
	j1041984903 [label="他并没有通过把人当成“傻瓜”来从你们身上夺走什么。如果要说有什么的话……你们似乎都从他的来访中获得更多东西。",shape=box,color=red];
		j1041984903 -> j848154395;
	j1561149497 [label="真有趣。我原以为你会痛恨你的敌人。但这是我的愚昧之处——我竟然自以为知道当今世代的人们会如何行事。",shape=box,color=blue];
		j1561149497 -> j3107605472;
	j3507359263 [label="这是一个学会利用自身状况——外貌、年龄、伤疤——作为武器来对抗周围那些看不穿他诡计的“傻瓜”的生物。",shape=box,color=blue];
		j3507359263 -> j2529957806;
	j2203427072 [label="他可是很清楚该如何装跛脚。 ",shape=box,color=blue];
		j2203427072 -> j141840425;
	j1319420123 [label="漂泊者，你想从这段对话中得出什么结论都行。",shape=box,color=blue];
		j1319420123 -> j141840425;
	j82610256 [label="——里昂·阿拉德神父",shape=box,color=blue];
		j82610256 -> "Chat ends.";
	j848154395 [label="Add -1 to Thermostat counter",color=orange];
		j848154395 -> j2180703051;
	j3107605472 [label="Add 1 to Thermostat counter",color=orange];
		j3107605472 -> j2196789484;
	j2529957806 [label="他真是个毛茸茸的小淘气，浑身乱糟糟的。可每次他来拜访，我还是忍不住想摸摸他。",shape=box,color=blue];
		j2529957806 -> j2627042677;
	j2180703051 [label="是的，我想我们确实如此。我们并不缺那几块鸡软骨或那几下摸摸头。",shape=box,color=blue];
		j2180703051 -> j2555706049;
	j2196789484 [label="更何况是像你这样有着特别精彩成长经历的人。 ",shape=box,color=blue];
		j2196789484 -> j2729351465;
	j2627042677 [label="两年后，他的再次失踪却是永久性的，这让我同样心碎。",shape=box,color=blue];
		j2627042677 -> j2405383944;
		j2627042677 -> j3995085897;
	j2555706049 [label="也许正因如此，我才为他点燃了一支蜡烛，并向月神祈祷，希望她能带走他的灵魂，引导他去往……她愿意收留像他这样的小精灵的地方。",shape=box,color=blue];
		j2555706049 -> j521244884;
	j2729351465 [label="+5 Chemistry",color=orange];
		j2729351465 -> j2514370558;
	j521244884 [label="+5 Chemistry",color=orange];
		j521244884 -> j2129408814;
	j2514370558 [label="谢谢。我先不打扰你了。这次谈话非常有趣。期待下次再聊。",shape=box,color=blue];
		j2514370558 -> j82610256;
	j2129408814 [label="那天晚上，我也在祈祷中感谢了老德福罗，感谢他给玛丽带来的所有快乐。",shape=box,color=blue];
		j2129408814 -> j3004946700;
	j3004946700 [label="或许他那些小小的恶行，从某种意义上来说，也算是一件好事。",shape=box,color=blue];
		j3004946700 -> j2514370558;
}