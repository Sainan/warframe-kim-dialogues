	1741 [label="我一直在思考我们昨天谈话的内容，以及 Rell 和 Harrow 的存在如此不可避免地融入我的生活意味着什么——",shape=box,color=blue];
		1741 -> 1746;
	1740 [label="我一直在思考我们昨天谈话的内容，以及 Rell 和 Harrow 的存在如此不可避免地融入我的生活意味着什么——",shape=box,color=blue];
		1740 -> 1745;
	1739 [label="我一直想跟你说件事，现在才找到机会说出口。当……Rell、Harrow 和我纠缠在一起的时候——至于怎么发生的，为什么会发生，并不重要——",shape=box,color=blue];
		1739 -> 1744;
	1743 [label="Chat ends.",color=orange];
	1747 [label="他们的身影终究会再次从我的灵魂深处抹去，只留下记忆。而这，或许正是月神赐予我的礼物……",shape=box,color=blue];
		1747 -> 1751;
	1746 [label="他们的身影终究会再次从我的灵魂中抹去，只留下记忆。你说得对，这或许意味着世上根本没有神。",shape=box,color=blue];
		1746 -> 1750;
	1745 [label="他们的身影终究会从我的灵魂深处被抹去，只留下记忆。我不知道这是否意味着世间真的存在神，还是根本不存在。",shape=box,color=blue];
		1745 -> 1749;
	1744 [label="我被卷入了他们的过去，就像他们被卷入了我的过去一样。我看到了所有扎里曼 10-0 号的记忆，看到了远古之战的片段，同样，他们也看到了我所有的过去。",shape=box,color=blue];
		1744 -> 1748;
	1751 [label="我逐渐意识到，我们这位银发女神只会赐予如此悲怆的祝福。她不愿就像罗瑟那样，抹去痛苦的记忆。",shape=box,color=blue];
		1751 -> 1754;
	1750 [label="但我认为这并不能改变我多年来为一个以行善为宗旨的组织服务的经历。",shape=box,color=blue];
		1750 -> 1753;
	1749 [label="正如你所说，我们……或许永远不会知道。也许我们也不应该知道。世事就是如此。但我认为这并不能改变我多年来为一个以行善为宗旨的组织服务的经历。",shape=box,color=blue];
		1749 -> 1753;
	1748 [label="它……让我对很多事情产生了疑问，尤其是……我的信仰。它像烧焦的纸一样，皱巴巴地崩塌了，化为尘埃。我痛恨自己的这种软弱……",shape=box,color=blue];
		1748 -> 1752;
	1754 [label="她也不会帮我抹去鞭笞带来的刺痛。保护我免受他离去的悲痛，也不是她的作风。",shape=box,color=blue];
		1754 -> 1763;
	1753 [label="在人们几乎要被痛苦淹没、并且想要减轻痛苦的时候，帮助他们。",shape=box,color=blue];
		1753 -> 1762;
	1752 [label="Evaluate expressions",color=orange];
		1752 -> 1760 [label="LyonDating",color=purple];
