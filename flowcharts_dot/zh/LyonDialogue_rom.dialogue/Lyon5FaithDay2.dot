		1775 -> 1782;
	1785 [label="看来确实如此。 ",shape=box,color=blue];
		1785 -> 1791;
	1786 [label="很难说。我​不​知道，​像​我​这样​的​人​是否​真的​“找到”​或​“失去”​过那样的东西，​还是​只是​永远​在​寻找。​永远​在​质疑​——​永远​在​寻求​答案。​",shape=box,color=blue];
		1786 -> 1792;
