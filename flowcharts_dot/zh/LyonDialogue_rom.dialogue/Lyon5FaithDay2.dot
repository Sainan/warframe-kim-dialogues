	1793 [label="正如你所说，我们……或许永远不会知道。也许我们也不应该知道。世事就是如此。但我认为这并不能改变我多年来为一个以行善为宗旨的组织服务的经历。",shape=box,color=blue];
		1793 -> 1753;
	1794 [label="或许你是对的。或许我们这位银发女神只会赐予如此悲怆的祝福。她不愿就像罗瑟那样，抹去痛苦的记忆。",shape=box,color=blue];
		1794 -> 1754;
	1795 [label="但我认为这并不能改变我多年来为一个以行善为宗旨的组织服务的经历。",shape=box,color=blue];
		1795 -> 1753;
	1797 [label="你是不是认同罗瑟和我的观点，认为墙中人并非真正的神？",shape=box,color=red];
		1797 -> 1800;
	1799 [label="你认为虚空无情之物在这里算什么？",shape=box,color=red];
		1799 -> 1801;
	1798 [label="你是不是也认同罗瑟的观点，认为虚空无情之物是真正的神，或根本不是？",shape=box,color=red];
		1798 -> 1800;
	1800 [label="我不知道自己对此持什么立场。我没有足够的证据来做出任何决定。但我想，这大概也改变不了什么，不是吗？",shape=box,color=blue];
		1800 -> 1802;
		1800 -> 1803;
	1801 [label="至于虚空无情之物是不是神，我不知道自己对此持什么立场。我没有足够的证据来做出任何决定。但我想，这大概也改变不了什么，不是吗？",shape=box,color=blue];
		1801 -> 1802;
		1801 -> 1803;
	1802 [label="我认为这会带来很大的改变。如果它不是真正的神——它是人创造的。这意味着它也可以被人打败。",shape=box,color=red];
		1802 -> 1804;
	1803 [label="这是什么意思？",shape=box,color=red];
		1803 -> 1805;
	1804 [label="既然你认为我们无法战胜它，当初又何必费力与之对抗呢？你真是个令人费解的家伙。",shape=box,color=blue];
		1804 -> 1806;
	1805 [label="它进入我们宇宙的方式并不会改变我们战胜它的方法。",shape=box,color=blue];
		1805 -> 1807;
	1806 [label="你不可能真心实意说出这些话。那你只是在随波逐流吗？还是因为无所事事才勉强反抗？",shape=box,color=blue];
		1806 -> 1808;
	1807 [label="看哪：我们创造的神，由我们自身的空虚缝制而成。",shape=box,color=blue];
		1807 -> 1809;
	1808 [label="你肯定能想到比这更好的爱好。",shape=box,color=blue];
		1808 -> 1810;
		1808 -> 1811;
	1809 [label="我们可能会把悲伤、痛苦、愤怒、煎熬都倾注到布娃娃身上，直到布娃娃的缝线快要被这些情绪撑破。",shape=box,color=blue];
		1809 -> 1812;
	1810 [label="不，我并不认为毫无希望——我不是那个意思。",shape=box,color=red];
		1810 -> 1813;
	1811 [label="我的意思是，这改变了我们如何消灭它，如何理解它的思考方式。",shape=box,color=red];
		1811 -> 1814;
	1812 [label="如果​我​觉得​这​种​事带​给​我​的​恐惧，​远比​我们​发现​它​是​神​要​强烈​得​多，​还​请​你谅解。​",shape=box,color=blue];
		1812 -> 1815;
	1813 [label="说话前思考并非必要条件，发射子弹也一样。 ",shape=box,color=blue];
		1813 -> 1807;
	1814 [label="我不认为这是真的。我觉得，我们现在对它的动机的了解，和对某个“伟大而不可知的神”的了解一样少。",shape=box,color=blue];
		1814 -> 1807;
	1815 [label="没错，​事实​上，​我​觉得​那样​更好。​",shape=box,color=blue];
		1815 -> 1816;
	1816 [label="或许还能抱有一线希望，它可能比整个人类更加智能。",shape=box,color=blue];
		1816 -> 1817;
	1817 [label="带着这样……极其悲观的想法，我想我今天就到此为止吧。",shape=box,color=blue];
		1817 -> 1818;
