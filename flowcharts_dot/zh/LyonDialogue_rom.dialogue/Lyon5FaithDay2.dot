		1752 -> 1757 [label="DrifterFaithNoMaybe",color=purple];
		1752 -> 1755 [label="false",color=purple];
	1763 [label="太阳神会像热刀烧灼伤口一样，将痛苦化为乌有——而月神则会用拥抱来温暖我，抚慰他离去带来的痛苦。",shape=box,color=blue];
		1763 -> 1770;
	1762 [label="而且​我​知道，​如果​我​还​能​找到​ Rel​l ​和​他​的​ Harrow，​他们​一定​不​希望​我​为​他们​的​离去​而​痛苦。​他们​已经​安息​了。​",shape=box,color=blue];
		1762 -> 1769;
	1760 [label="哦，里昂……你经历了太多。怀疑不是软弱的表现，而是痛苦的产物。",shape=box,color=red];
		1760 -> 1764;
		1760 -> 1765;
		1760 -> 1766;
		1760 -> 1767;
		1760 -> 1768;
	1761 [label="信仰不必一成不变，也不应该如此。不是还有很多故事是关于人们失去信仰，最终又重新找回信仰吗？",shape=box,color=red];
		1761 -> 1764;
		1761 -> 1765;
		1761 -> 1766;
	1759 [label="里昂，你一生都奉献给了我们的双耀神。你认为他们会因为这种事而疏远你吗？",shape=box,color=red];
		1759 -> 1764;
		1759 -> 1765;
		1759 -> 1766;
	1758 [label="里昂，我不知道世上有没有神——我觉得我们永远也无法真正知道。但我知道的是，你经历了很多。",shape=box,color=red];
		1758 -> 1764;
		1758 -> 1766;
		1758 -> 1767;
	1757 [label="虽然我个人不相信世上有神，但我知道这对你的人生有多么重要。我不想轻视这一点。",shape=box,color=red];
		1757 -> 1766;
		1757 -> 1768;
	1756 [label="里昂，虚空无情之物是我们造成的——他不是神。别让英择谛的错误毁了你。至于你的信仰？",shape=box,color=red];
		1756 -> 1766;
		1756 -> 1768;
	1755 [label="我很不忍心看到你这样，被卷入这些荒唐事之中。你不应该承受这些。",shape=box,color=red];
		1755 -> 1764;
		1755 -> 1765;
		1755 -> 1766;
		1755 -> 1767;
		1755 -> 1768;
	1770 [label="因为没有痛苦也等同于过多的痛苦淹没我们，足以摧毁我们。",shape=box,color=blue];
		1770 -> 1778;
		1770 -> 1779;
		1770 -> 1777;
	1769 [label="我也不认为我所遭受的一切苦难都是徒劳的。这并不能否定我所承受的一切。",shape=box,color=blue];
		1769 -> 1776;
	1764 [label="我不是说你需要重新找回你的信仰。我的意思是，如果你想——如果你觉得你需要——信仰并不是永远失去的东西。",shape=box,color=red];
		1764 -> 1771;
	1765 [label="月神肯定能看到你所经历的一切，你为了她所承受的一切。 ",shape=box,color=red];
		1765 -> 1772;
	1766 [label="我认为你需要专注于在内心深处找到某种平静——无论以何种方式，你都需要找到它。",shape=box,color=red];
		1766 -> 1773;
	1767 [label="如果真有神，如果你的月神真的存在——她肯定能看到你所经历的一切，你为了她所承受的一切。这对她来说一定意义非凡。",shape=box,color=red];
		1767 -> 1774;
	1768 [label="我认为你应该放下任何对神是否存在的想法，先专注于治愈自己。",shape=box,color=red];
		1768 -> 1775;
	1778 [label="相信我……我知道麻木有多危险。",shape=box,color=red];
		1778 -> 1785;
	1779 [label="这是否意味着你重新找回了信仰？",shape=box,color=red];
		1779 -> 1786;
	1777 [label="[结束]",shape=box,color=red];
