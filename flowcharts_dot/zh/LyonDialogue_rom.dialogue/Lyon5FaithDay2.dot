	1783 [label="这是否意味着你已经放弃了信仰？",shape=box,color=red];
		1783 -> 1786;
	1780 [label="我一直在思考 Rell 和 Harrow 的存在如此不可避免地融入我的生活意味着什么——",shape=box,color=blue];
		1780 -> 1787;
	1781 [label="我回想起那些年为一个以行善为宗旨的组织服务的日子……回想起 Rell 和 Harrow 在我生命中是如此不可或缺的存在——",shape=box,color=blue];
		1781 -> 1788;
	1782 [label="我一直在思考 Rell 和 Harrow 的存在如此不可避免地融入我的生活意味着什么——",shape=box,color=blue];
		1782 -> 1789;
	1791 [label="我​不​知道，​像​我​这样​的​人​是否​真的​“找到”​或​“失去”​过信仰​之类​的​东西，​还是​只是​永远​在​寻找。​永远​在​质疑​——​永远​在​寻求​答案。​",shape=box,color=blue];
		1791 -> 1792;
	1792 [label="但我认为，就像对待痛苦一样，要找到一个平衡点，以确保既不会沉溺于痛苦之中，也不会变得麻木不仁甚至毫无感觉。",shape=box,color=blue];
