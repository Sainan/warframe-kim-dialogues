		1312 -> 1316 [label="false",color=purple];
		1312 -> 1313 [label="false",color=purple];
	1315 [label="你之前提到过你想谈谈我不认为“虚空无情之物”是“真正的神”这件事。现在合适吗？",shape=box,color=red];
		1315 -> 1320;
	1313 [label="[结束]",shape=box,color=red];
		1313 -> 1318;
	1314 [label="前几天你问我关于概念成形和虚空无情之物的问题。是不是有什么问题困扰到你？",shape=box,color=red];
		1314 -> 1319;
	1317 [label="罗瑟坚信墙中人并非真正的神，而是“概念成形”的产物。你怎么看？",shape=box,color=red];
		1317 -> 1322;
	1316 [label="里昂，你和罗瑟之间到底发生了什么？我只听到了一些零星的消息。",shape=box,color=red];
		1316 -> 1321;
	1320 [label="漂泊者，我不确定现在算不算一个“合适”的时间去讨论这个问题，因为它确实已经对我造成了实际影响。",shape=box,color=blue];
		1320 -> 1324;
	1318 [label="Chat ends.",color=orange];
	1319 [label="漂泊者，困扰我的事情很多。恐怕关于虚空无情之物和概念成形的话题只是其中之一。",shape=box,color=blue];
		1319 -> 1323;
	1322 [label="漂泊者，问题是我不知道。如果我知道答案，我就不会陷入如此痛苦的内心挣扎了。",shape=box,color=blue];
		1322 -> 1326;
	1321 [label="我会简单说说，不过我很惊讶你竟然没看过他在这个话题上的长篇大论。他可是恨不得抓住一切机会来发表这些言论。",shape=box,color=blue];
		1321 -> 1325;
	1324 [label="不过，现在也算是“合适”的时机了。令我感到好奇的是，你似乎赞同罗瑟的观点，认为虚空无情之物并非真正的神。",shape=box,color=blue];
		1324 -> 1326;
	1323 [label="或者这两者都是，这取决于你如何解读这种情况。不过我想，这的确是我困境的核心所在。",shape=box,color=blue];
		1323 -> 1326;
	1326 [label="不过，我应该……从头说起。如果你不了解一些背景，就无法明白为什么这个话题对我如此重要……",shape=box,color=blue];
		1326 -> 1328;
	1325 [label="他认为，虚空无情之物并非虚空之神，无论从哪个意义上来说都是如此，它实际上是由英择谛以及之后所有与它接触过的人共同创造的。",shape=box,color=blue];
		1325 -> 1327;
	1328 [label="我是属于月神兄弟会的。我毕生致力于对她的崇拜。我一生都坚信这一点。",shape=box,color=blue];
		1328 -> 1330;
	1327 [label="——通过你所知的“概念成形”从虚空中创造出来。 ",shape=box,color=blue];
		1327 -> 1329;
	1330 [label="自从我来到教会以来，这么多年来，我一直坚守着我的信仰——我坚信，我的苦难、我的痛苦和我的异象——",shape=box,color=blue];
		1330 -> 1331;
	1329 [label="我相信，你创造双衍王境的方式也与之非常相似。",shape=box,color=blue];
		1329 -> 1326;
	1331 [label="——都是侍奉于她。都是以她之名。都是为了她的旨意而存在。",shape=box,color=blue];
		1331 -> 1332;
	1332 [label="直到“星期日主教”说他自己是阿尔布雷希特·英择谛。",shape=box,color=blue];
		1332 -> 1333;
	1333 [label="他向我们坦白了他的真实身份，讲述了他与虚空之间的种种罪行，以及由此产生的一切后果。更确切地说……是从中逃出的一切东西。",shape=box,color=blue];
		1333 -> 1334;
		1333 -> 1335;
	1334 [label="虚空无情之物。",shape=box,color=red];
		1334 -> 1336;
	1335 [label="然后呢？",shape=box,color=red];
		1335 -> 1337;
	1336 [label="没错。他告诉我们迎接他的那个冷笑的东西，以及他从那个酷似他实验室的地方取出的手指。",shape=box,color=blue];
		1336 -> 1338;
	1337 [label="他告诉我们他乘坐玻璃钟舱下降到虚无之中的情景。那个地方酷似他的实验室。 ",shape=box,color=blue];
		1337 -> 1338;
	1338 [label="此外，他还告诉我们他非常恐惧，因为他知道自己释放的东西不仅可以穿越空间，还可以穿越时间跟随他。",shape=box,color=blue];
		1338 -> 1339;
	1339 [label="那是虚无之神。是必须被禁锢之物。那根手指的主人，在墙后不停地抓挠，渴望挣脱束缚。",shape=box,color=blue];
		1339 -> 1340;
	1340 [label="那是一个可怕而又吞噬一切的神，他既是自由的，又是不自由的。",shape=box,color=blue];
		1340 -> 1341;
		1340 -> 1342;
	1341 [label="这是什么意思？",shape=box,color=red];
		1341 -> 1343;
	1342 [label="既是自由的，又是不自由的？",shape=box,color=red];
		1342 -> 1343;
	1343 [label="Check boolean LyonRell1",color=orange];
		1343 -> 1345 [label=true,color=green];
		1343 -> 1344 [label=false,color=brown];
	1345 [label="时间……对于像我这种状态的人来说，是纠缠不清的。很难描述。我曾经尝试解释过一次，结果却很糟糕。",shape=box,color=blue];
		1345 -> 1346;
	1344 [label="对于像我这种状态的人来说，时间是……纠缠不清的。很难描述，而且我在这方面做得非常糟糕。",shape=box,color=blue];
		1344 -> 1346;
	1346 [label="我想以后再解释细节，因为这不是我今天想表达的核心内容。",shape=box,color=blue];
		1346 -> 1347;
	1347 [label="Check boolean LyonRell1",color=orange];
		1347 -> 1348 [label=true,color=green];
		1347 -> 1349 [label=true,color=green];
		1347 -> 1350 [label=true,color=green];
		1347 -> 1349 [label=false,color=brown];
		1347 -> 1350 [label=false,color=brown];
	1348 [label="但是，如果能听到——或者听过——Rell 的话……我想谈谈这件事。",shape=box,color=red];
		1348 -> 1351;
	1349 [label="好的，你说了算。",shape=box,color=red];
		1349 -> 1352;
	1350 [label="我确实想深入探讨一下这个问题……",shape=box,color=red];
		1350 -> 1353;
	1351 [label="我知道。而且我一直在刻意回避这个话题。光是他的名字我都想避而不谈。",shape=box,color=blue];
		1351 -> 1354;
	1352 [label="我知道我一直极力回避这个话题，对此我深表歉意。但这个问题可能会让我陷入一种难以摆脱的异象中。",shape=box,color=blue];
		1352 -> 1355;
	1353 [label="我向你保证，我们会的。我知道我一直极力回避这个话题，对此我深表歉意。但这个问题可能会让我陷入一种难以摆脱的异象中。",shape=box,color=blue];
		1353 -> 1355;
	1354 [label="它在威胁着",shape=box,color=blue];
		1354 -> 1356;
	1355 [label="我​不​想​再次​因为​自身​的​体弱​而​不得不​中断​这​次​谈话。​",shape=box,color=blue];
		1355 -> 1357;
		1355 -> 1358;
		1355 -> 1359;
	1356 [label="它带来了锁链的景象",shape=box,color=blue];
		1356 -> 1360;
	1357 [label="里昂，鉴于你所经历过的一切，我不认为你是“体弱”的人。",shape=box,color=red];
		1357 -> 1361;
	1358 [label="用“体弱”来形容“被自己不愿看到的异象所诅咒”实在太糟糕了。不过，随你便吧。",shape=box,color=red];
		1358 -> 1361;
	1359 [label="你知道自己的极限，所以我会听你的安排。",shape=box,color=red];
		1359 -> 1362;
	1360 [label="以血铸成",shape=box,color=blue];
		1360 -> 1363;
	1361 [label="我感激你的好意，但我知道，即便在最好的情况下，我也只不过是一扇破碎的彩色玻璃窗。我站在这里，茫然地想着，许多碎片都去了哪里。",shape=box,color=blue];
		1361 -> 1364;
	1362 [label="谢谢你。你的耐心让我惊叹。我知道，即便在最好的情况下，我也只不过是一扇破碎的彩色玻璃窗。我站在这里，茫然地想着，许多碎片都去了哪里。",shape=box,color=blue];
		1362 -> 1364;
	1363 [label="以筋腱和血肉凿成",shape=box,color=blue];
		1363 -> 1365;
	1364 [label="每次我找到丢失的碎片时，我更有可能被碎片的边缘划伤，而不是把它放回原位。",shape=box,color=blue];
		1364 -> 1366;
	1365 [label="求你让它停下",shape=box,color=blue];
		1365 -> 1367;
	1366 [label="有时我会想，如果我能成为我脑海中其中一个空洞的 Harrow，是不是会更好，这种感觉会随着我的噩梦延伸到极致。",shape=box,color=blue];
		1366 -> 1368;
	1367 [label="他们的脸
成千上万
空洞而破碎
于永恒的破碎的祈祷中
被永远封锁
而我将成为什么",shape=box,color=blue];
		1367 -> 1369;
		1367 -> 1370;
	1368 [label="Evaluate expressions",color=orange];
		1368 -> 1372 [label="MarieDating",color=purple];
		1368 -> 1371 [label="MarieDating",color=purple];
		1368 -> 1371 [label="RoatheDating",color=purple];
		1368 -> 1372 [label="RoatheDating",color=purple];
		1368 -> 1371 [label="false",color=purple];
		1368 -> 1372 [label="false",color=purple];
		1368 -> 1373 [label="false",color=purple];
	1369 [label="里昂，深呼吸。深呼吸。他们不是真的在那里。",shape=box,color=red];
		1369 -> 1374;
	1370 [label="我——里昂，对不起。专心看屏幕。我在这里。",shape=box,color=red];
		1370 -> 1375;
	1372 [label="我知道这是你被迫承担的沉重负担。也许这样做是不对的。但我不知道该如何摆脱这种困境。",shape=box,color=red];
		1372 -> 1377;
	1371 [label="你对玛丽来说就是全世界。你也成了我非常亲密的朋友。我想即使是罗瑟也会想念你，虽然他不会承认。",shape=box,color=red];
		1371 -> 1376;
	1373 [label="[表白心意] 里昂，如果你让那种事发生在你身上，我会心碎的。我……我很在乎你。",shape=box,color=red];
		1373 -> 1378;
	1374 [label="你错了
他们就在那里
他们永远不会离开我
永远不会
英择谛确保了这一点
原谅我",shape=box,color=blue];
		1374 -> 1379;
	1375 [label="撕裂我的血肉
将它从我的骨头上剥离
为什么？为了什么目的？
这究竟是为了满足谁的饥饿？",shape=box,color=blue];
		1375 -> 1380;
		1375 -> 1381;
	1377 [label="除非诉诸……难以想象的手段。或者说，就只能那样了。",shape=box,color=red];
		1377 -> 1383;
	1376 [label="你被珍视着，被爱着，拥有家人和朋友。即使有时你可能感觉不到这一点。",shape=box,color=red];
		1376 -> 1382;
	1378 [label="我——你肯定是在开玩笑吧？在你亲眼目睹了这一切之后，你怎么可能会真心地说出这些话？要么你失去了理智，要么你的同情心蒙蔽了你的双眼。",shape=box,color=blue];
		1378 -> 1384;
		1378 -> 1385;
	1379 [label="+10 Chemistry",color=orange];
		1379 -> 1386;
	1380 [label="这里并没有人。你无需再这样痛苦了。放下吧。",shape=box,color=red];
		1380 -> 1387;
	1381 [label="我​知道。​我​知道​这​很​痛苦。​对​不起。​真的​很​抱歉。​从​房间​里​走​出来​吧。​",shape=box,color=red];
		1381 -> 1388;
	1383 [label="+10 Chemistry",color=orange];
		1383 -> 1390;
	1382 [label="里昂，你不是一个人。大家都在想着你。",shape=box,color=red];
		1382 -> 1389;
	1384 [label="不，里昂。我是认真的。你对我来说就是一切，我只希望我能让你相信这一点。",shape=box,color=red];
		1384 -> 1391;
	1385 [label="我……也许你是对的。也许现在还不是时候。",shape=box,color=red];
		1385 -> 1392;
	1386 [label="Update boolean LyonRell2b",color=orange];
		1386 -> 1393;
	1387 [label="如果事情真有那么简单就好了
这些锁链我已束缚太久
比语言更长
比我的名字更长
请原谅我",shape=box,color=blue];
		1387 -> 1379;
	1388 [label="转身，在脑海中走出这个房间。",shape=box,color=red];
		1388 -> 1394;
	1390 [label="我​看见​了​殁世械灵​先生，​也​听​说​了​关于​ O​rdis ​先生​或​奥塔​先生​的​故事。​我​想​起​了​那些​空洞​的​战甲，​它们​的​思想​仿佛​被​从头骨​中​抽​离​出来。​",shape=box,color=blue];
		1390 -> 1396;
	1389 [label="+10 Chemistry",color=orange];
		1389 -> 1395;
	1391 [label="我。",shape=box,color=blue];
		1391 -> 1397;
	1392 [label="很好。很高兴你终于从刚才的疯狂中清醒过来。看来这玩意儿确实会传染。或许我们应该暂时放下这个设备，因为我担心它已经开始腐蚀你的大脑了。",shape=box,color=blue];
		1392 -> 1398;
	1393 [label="Chat ends.",color=orange];
	1394 [label="是的
他们还会再来
这血与锁链的密室
等待的牢笼
永无止境的等待",shape=box,color=blue];
		1394 -> 1399;
	1396 [label="Check boolean LyonPainOff",color=orange];
		1396 -> 1400 [label=true,color=green];
		1396 -> 1401 [label=false,color=brown];
	1395 [label="谢谢……但我不知道，这种悲伤能持续多久，才能随着时间的推移，变成另一种更容易承受的负担？",shape=box,color=blue];
		1395 -> 1390;
	1397 [label="Evaluate expressions",color=orange];
		1397 -> 1403 [label="DrifterLiar",color=purple];
		1397 -> 1402 [label="LyonNoDate",color=purple];
		1397 -> 1404 [label="false",color=purple];
	1398 [label="Chat ends.",color=orange];
	1399 [label="我必须请你原谅我。有时我会神志不清，我讨厌别人看到我这副模样。",shape=box,color=blue];
		1399 -> 1405;
	1400 [label="屈服是如此容易。放弃是如此容易。将我的痛苦献祭给苦难的祭坛，然后说不再承受了也如此容易。",shape=box,color=blue];
		1400 -> 1406;
	1401 [label="屈服是如此容易。放弃是如此容易。将我的痛苦献祭给苦难的祭坛，然后说不再承受了也如此容易。或者做出更糟糕的事——做出大家担心我会在黑夜里用刀刃做的事。",shape=box,color=blue];
		1401 -> 1406;
	1403 [label="漂泊者，只是……有一个问题。我知道你以前说过谎，你要我怎么相信你说的是真话呢？",shape=box,color=blue];
		1403 -> 1408;
	1402 [label="虽然我深感荣幸，但我恐怕我的回答非常简单明了的“不行”。",shape=box,color=blue];
		1402 -> 1407;
	1404 [label="我无言以对。",shape=box,color=blue];
		1404 -> 1409;
	1405 [label="Evaluate expressions",color=orange];
		1405 -> 1410 [label="MarieDating",color=purple];
		1405 -> 1412 [label="MarieDating",color=purple];
		1405 -> 1410 [label="RoatheDating",color=purple];
		1405 -> 1412 [label="RoatheDating",color=purple];
		1405 -> 1410 [label="false",color=purple];
		1405 -> 1411 [label="false",color=purple];
		1405 -> 1412 [label="false",color=purple];
	1406 [label="但这……并非……真正的我。也永远不会成为真正的我。我注定要永远是这……破碎的堡垒，这破碎的盾牌……",shape=box,color=blue];
		1406 -> 1413;
	1408 [label="我已经发现你撒谎了。虽然我不知道你这次撒谎的目的是什么，但恐怕你已经完全摧毁了我对你的信任。",shape=box,color=blue];
		1408 -> 1414;
	1407 [label="Chat ends.",color=orange];
	1409 [label="我知道这种情况对我来说并非完全罕见，但是，我觉得我应该就此作出一些回应。",shape=box,color=blue];
		1409 -> 1415;
	1410 [label="你想停下吗？还是可以继续谈？无论你怎么选择我都可以理解。",shape=box,color=red];
		1410 -> 1416;
	1412 [label="没事的，我会陪着你。你会没事的吧？",shape=box,color=red];
		1412 -> 1418;
	1411 [label="[表白心意]里昂，我……我在乎你。如果你愿意，我想在你经历这些时刻的时候陪伴在你身边。",shape=box,color=red];
		1411 -> 1417;
	1413 [label="血流不止，却永远不死……",shape=box,color=blue];
		1413 -> 1419;
	1414 [label="所以，虽然我深感荣幸，但我恐怕我的回答非常简单明了——",shape=box,color=blue];
		1414 -> 1420;
	1415 [label="——以某种巧妙的方式，或者至少以某种似乎适合这种情况的方式，而不是——",shape=box,color=blue];
		1415 -> 1421;
	1416 [label="我可以继续，谢谢你。一切都过去了，就像它们总是会过去一样。我这些……异象就像掠过月球的云朵。它们可能完全笼罩在黑暗之中，但通常转瞬即逝。",shape=box,color=blue];
		1416 -> 1422;
	1418 [label="没事，谢谢你。一切都过去了，就像它们总是会过去一样。我这些……异象就像掠过月球的云朵。它们可能完全笼罩在黑暗之中，但通常转瞬即逝。",shape=box,color=blue];
		1418 -> 1422;
	1417 [label="你肯定是在开玩笑吧？在你亲眼目睹了这一切之后，你怎么可能会真心地说出这些话？要么你失去了理智，要么你的同情心蒙蔽了你的双眼。",shape=box,color=blue];
		1417 -> 1423;
		1417 -> 1424;
	1419 [label="C'est la vie，不是吗？",shape=box,color=blue];
		1419 -> 1425;
	1420 [label="不行。​",shape=box,color=blue];
		1420 -> 1426;
	1421 [label="——不是让你觉得这种付出没有得到回报，因为事实并非如此——",shape=box,color=blue];
		1421 -> 1427;
		1421 -> 1428;
	1422 [label="+10 Chemistry",color=orange];
		1422 -> 1429;
	1423 [label="不，里昂。我是认真的。你对我来说就是一切，我只希望我能让你相信这一点。",shape=box,color=red];
		1423 -> 1391;
	1424 [label="我……也许你是对的。也许现在还不是时候。",shape=box,color=red];
		1424 -> 1430;
	1425 [label="我们好像偏离了谈话的主题，对吧？我非常抱歉。你不需要忍受这么多自以为是、矫揉造作的话。",shape=box,color=blue];
		1425 -> 1431;
