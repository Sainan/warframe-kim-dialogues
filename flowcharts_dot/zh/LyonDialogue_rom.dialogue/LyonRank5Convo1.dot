		1454 -> 1458;
	1455 [label="然而他带来了证据，证明了他口中那些不可能的事。我知道他是阿尔布雷希特·英择谛，而不是星期日主教。但要说我的一切——我所信仰的一切——都是出自虚空无情之物？",shape=box,color=blue];
		1455 -> 1459;
	1456 [label="起初我不知道该相信什么。然而他带来了证据，证明了他口中那些不可能的事。我知道他是阿尔布雷希特·英择谛，而不是星期日主教。但要说我的一切——我所信仰的一切——都是出自虚空无情之物？",shape=box,color=blue];
		1456 -> 1459;
	1457 [label="Update boolean LyonDating",color=orange];
		1457 -> 1460;
	1458 [label="虽然从表面上看，这一切在科学上都说得通，但我并没有真正理解。",shape=box,color=blue];
