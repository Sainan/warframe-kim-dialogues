digraph {
	"LyonRank5Convo1 begins." [color=orange];
		"LyonRank5Convo1 begins." -> j3626627435;
	j3626627435 [label="Evaluate expressions",color=orange];
		j3626627435 -> j711493412 [label="LyonMITW2",color=purple];
		j3626627435 -> j1038552372 [label="LyonMITW2",color=purple];
		j3626627435 -> j4130256135 [label="LyonMITW1",color=purple];
		j3626627435 -> j1038552372 [label="LyonMITW1",color=purple];
		j3626627435 -> j2910528506 [label="RoatheMITW3",color=purple];
		j3626627435 -> j1038552372 [label="RoatheMITW3",color=purple];
		j3626627435 -> j2910528506 [label="RoatheMITW2",color=purple];
		j3626627435 -> j1038552372 [label="RoatheMITW2",color=purple];
		j3626627435 -> j2910528506 [label="RoatheMITW1",color=purple];
		j3626627435 -> j1038552372 [label="RoatheMITW1",color=purple];
		j3626627435 -> j3160464552 [label="false",color=purple];
		j3626627435 -> j1038552372 [label="false",color=purple];
	j711493412 [label="你之前提到过你想谈谈我不认为“虚空无情之物”是“真正的神”这件事。现在合适吗？",shape=box,color=red];
		j711493412 -> j3638324424;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j4130256135 [label="前几天你问我关于概念成形和虚空无情之物的问题。是不是有什么问题困扰你？",shape=box,color=red];
		j4130256135 -> j1757826844;
	j2910528506 [label="罗瑟坚信墙中人并非真正的神，而是“概念成形”的产物。你怎么看？",shape=box,color=red];
		j2910528506 -> j3846205387;
	j3160464552 [label="里昂，你和罗瑟之间到底发生了什么？我只听到了一些零星的消息。",shape=box,color=red];
		j3160464552 -> j2718164746;
	j3638324424 [label="漂泊者，我不确定现在算不算一个“合适”的时间去讨论这个问题，因为它确实已经对我造成了实际影响。",shape=box,color=blue];
		j3638324424 -> j3301849090;
	"Chat ends." [color=orange];
	j1757826844 [label="漂泊者，困扰我的事情很多。恐怕关于虚空无情之物和概念成形的话题只是其中之一。",shape=box,color=blue];
		j1757826844 -> j967483574;
	j3846205387 [label="漂泊者，问题是我不知道。如果我知道答案，我就不会陷入如此痛苦的内心挣扎了。",shape=box,color=blue];
		j3846205387 -> j1783401320;
	j2718164746 [label="我会简单说说，不过我很惊讶你竟然没看过他在这个话题上的长篇大论。他可是恨不得抓住一切机会来发表这些言论。",shape=box,color=blue];
		j2718164746 -> j2630572637;
	j3301849090 [label="不过，现在也算是“合适”的时机了。令我感到好奇的是，你似乎赞同罗瑟的观点，认为虚空无情之物并非真正的神。",shape=box,color=blue];
		j3301849090 -> j1783401320;
	j967483574 [label="或者这两者都是，这取决于你如何解读这种情况。不过我想，这的确是我困境的核心。",shape=box,color=blue];
		j967483574 -> j1783401320;
	j1783401320 [label="不过，我应该……从头说起。如果你不了解一些背景，就无法明白为什么这个话题对我如此重要……",shape=box,color=blue];
		j1783401320 -> j1699517740;
	j2630572637 [label="他认为，虚空无情之物并非虚空之神，无论从哪个意义上来说都是如此，它实际上是由英择谛以及之后所有与它接触过的人共同创造的。",shape=box,color=blue];
		j2630572637 -> j4068301686;
	j1699517740 [label="我是属于月神兄弟会的。我毕生致力于对她的崇拜。我一生都坚信这一点。",shape=box,color=blue];
		j1699517740 -> j2124052509;
	j4068301686 [label="——通过你所知的“概念成形”从虚空中创造出来。 ",shape=box,color=blue];
		j4068301686 -> j2982887598;
	j2124052509 [label="自从我来到教会以来，这么多年来，我一直坚守着我的信仰——我坚信，我的苦难、我的痛苦和我的异象——",shape=box,color=blue];
		j2124052509 -> j465048364;
	j2982887598 [label="我相信，你创造双衍王境的方式也与之非常相似。",shape=box,color=blue];
		j2982887598 -> j1783401320;
	j465048364 [label="——都是为了侍奉她。都是以她的名。都是为了她的旨意而存在。",shape=box,color=blue];
		j465048364 -> j1854876641;
	j1854876641 [label="直到“星期日主教”说他自己是阿尔布雷希特·英择谛。",shape=box,color=blue];
		j1854876641 -> j3294842689;
	j3294842689 [label="他向我们坦白了他的真实身份，讲述了他与虚空之间的种种罪行，以及由此产生的一切后果。更确切地说……是从中逃出的一切东西。",shape=box,color=blue];
		j3294842689 -> j702817764;
		j3294842689 -> j2121073967;
	j702817764 [label="虚空无情之物。",shape=box,color=red];
		j702817764 -> j1558330823;
	j2121073967 [label="然后呢？",shape=box,color=red];
		j2121073967 -> j1626130007;
	j1558330823 [label="没错。他告诉我们迎接他的那个冷笑的东西，以及他从那个酷似他实验室的地方取出的手指。",shape=box,color=blue];
		j1558330823 -> j3036631901;
	j1626130007 [label="他告诉我们他乘坐玻璃钟舱下降到虚无之中的情景。那个地方酷似他的实验室。 ",shape=box,color=blue];
		j1626130007 -> j3036631901;
	j3036631901 [label="此外，他还告诉我们他非常恐惧，因为他知道自己释放的东西不仅可以穿越空间，还可以穿越时间跟随他。",shape=box,color=blue];
		j3036631901 -> j1482192229;
	j1482192229 [label="那是虚无之神。是必须被禁锢之物。那根手指的主人，在墙后不停地抓挠，渴望挣脱束缚。",shape=box,color=blue];
		j1482192229 -> j3064517873;
	j3064517873 [label="那是一个可怕而又吞噬一切的神，他既是自由的，又是不自由的。",shape=box,color=blue];
		j3064517873 -> j404241319;
		j3064517873 -> j3796376089;
	j404241319 [label="这是什么意思？",shape=box,color=red];
		j404241319 -> j3826452011;
	j3796376089 [label="既是自由的，又是不自由的？",shape=box,color=red];
		j3796376089 -> j3826452011;
	j3826452011 [label="Check boolean LyonRell1",color=orange];
		j3826452011 -> j2295117327 [label=true,color=green];
		j3826452011 -> j2286689009 [label=false,color=brown];
	j2295117327 [label="时间……对于像我这种状态的人来说，是纠缠不清的。很难描述。我曾经尝试解释过一次，结果却很糟糕。",shape=box,color=blue];
		j2295117327 -> j2554214065;
	j2286689009 [label="对于像我这种状态的人来说，时间是……纠缠不清的。很难描述，而且我在这方面做得非常糟糕。",shape=box,color=blue];
		j2286689009 -> j2554214065;
	j2554214065 [label="我想以后再解释细节，因为这不是我今天想表达的核心内容。",shape=box,color=blue];
		j2554214065 -> j366078008;
	j366078008 [label="Check boolean LyonRell1",color=orange];
		j366078008 -> j1652533875 [label=true,color=green];
		j366078008 -> j2415394267 [label=true,color=green];
		j366078008 -> j3449362637 [label=true,color=green];
		j366078008 -> j2415394267 [label=false,color=brown];
		j366078008 -> j3449362637 [label=false,color=brown];
	j1652533875 [label="但是，如果能听到——或者听过——Rell 的话……我想谈谈这件事。",shape=box,color=red];
		j1652533875 -> j2241405910;
	j2415394267 [label="好的，你说了算。",shape=box,color=red];
		j2415394267 -> j1069555285;
	j3449362637 [label="我确实想深入探讨一下这个问题……",shape=box,color=red];
		j3449362637 -> j2413007029;
	j2241405910 [label="我知道。而且我一直在刻意回避这个话题。光是他的名字我都想避而不谈。",shape=box,color=blue];
		j2241405910 -> j3370596907;
	j1069555285 [label="我知道我一直极力回避这个话题，对此我深表歉意。但这个问题可能会让我陷入一种难以摆脱的异象中。",shape=box,color=blue];
		j1069555285 -> j4095024667;
	j2413007029 [label="我向你保证，我们会的。我知道我一直极力回避这个话题，对此我深表歉意。但这个问题可能会让我陷入一种难以摆脱的异象中。",shape=box,color=blue];
		j2413007029 -> j4095024667;
	j3370596907 [label="它在威胁着",shape=box,color=blue];
		j3370596907 -> j3668064193;
	j4095024667 [label="我​不​想​再次​因为​自身​的​体弱​而​不得不​中断​这​次​谈话。​",shape=box,color=blue];
		j4095024667 -> j4209938014;
		j4095024667 -> j3774156982;
		j4095024667 -> j810958999;
	j3668064193 [label="它带来了锁链的景象",shape=box,color=blue];
		j3668064193 -> j1584544201;
	j4209938014 [label="里昂，鉴于你所经历过的一切，我不认为你是“体弱”的人。",shape=box,color=red];
		j4209938014 -> j2988441887;
	j3774156982 [label="用“体弱”来形容“被自己不愿看到的异象所诅咒”实在太糟糕了。不过，随你便吧。",shape=box,color=red];
		j3774156982 -> j2988441887;
	j810958999 [label="你知道自己的极限，所以我会听你的安排。",shape=box,color=red];
		j810958999 -> j1161079545;
	j1584544201 [label="以血铸成",shape=box,color=blue];
		j1584544201 -> j1133947237;
	j2988441887 [label="我感激你的好意，但我知道，即便在最好的情况下，我也只不过是一扇破碎的彩色玻璃窗。我站在这里，茫然地想着，许多碎片都去了哪里。",shape=box,color=blue];
		j2988441887 -> j1400202095;
	j1161079545 [label="谢谢你。你的耐心让我惊叹。我知道，即便在最好的情况下，我也只不过是一扇破碎的彩色玻璃窗。我站在这里，茫然地想着，许多碎片都去了哪里。",shape=box,color=blue];
		j1161079545 -> j1400202095;
	j1133947237 [label="以筋腱和血肉凿成",shape=box,color=blue];
		j1133947237 -> j2840297063;
	j1400202095 [label="每次我找到丢失的碎片时，我更有可能被碎片的边缘划伤，而不是把它放回原位。",shape=box,color=blue];
		j1400202095 -> j909893592;
	j2840297063 [label="求你让它停下",shape=box,color=blue];
		j2840297063 -> j3725189003;
	j909893592 [label="有时我会想，如果我能成为我脑海中其中一个空洞的 Harrow，是不是会更好，这种感觉会随着我的噩梦延伸到极致。",shape=box,color=blue];
		j909893592 -> j3090338735;
	j3725189003 [label="他们的脸\n成千上万\n空洞而破碎\n于永恒的破碎的祈祷中\n被永远封锁\n而我将成为什么",shape=box,color=blue];
		j3725189003 -> j1340352868;
		j3725189003 -> j1128779546;
	j3090338735 [label="Evaluate expressions",color=orange];
		j3090338735 -> j4211700668 [label="MarieDating",color=purple];
		j3090338735 -> j1671169776 [label="MarieDating",color=purple];
		j3090338735 -> j1671169776 [label="RoatheDating",color=purple];
		j3090338735 -> j4211700668 [label="RoatheDating",color=purple];
		j3090338735 -> j1671169776 [label="false",color=purple];
		j3090338735 -> j4211700668 [label="false",color=purple];
		j3090338735 -> j2901811805 [label="false",color=purple];
	j1340352868 [label="里昂，深呼吸。深呼吸。他们不是真的在那里。",shape=box,color=red];
		j1340352868 -> j1997410972;
	j1128779546 [label="我——里昂，对不起。专心看屏幕。我在这里。",shape=box,color=red];
		j1128779546 -> j195573481;
	j4211700668 [label="我知道这是你被迫承担的沉重负担。也许这样做是不对的。但我不知道该如何摆脱这种困境。",shape=box,color=red];
		j4211700668 -> j3645211880;
	j1671169776 [label="对玛丽来说，你就是全世界。你也成了我非常亲密的朋友。我想即使是罗瑟也会想念你，虽然他不会承认。",shape=box,color=red];
		j1671169776 -> j877637253;
	j2901811805 [label="[表白心意] 里昂，如果你让那种事发生在你身上，我会心碎的。我……我很在乎你。",shape=box,color=red];
		j2901811805 -> j2795048820;
	j1997410972 [label="你错了\n他们就在那里\n他们永远不会离开我\n永远不会\n英择谛确保了这一点\n原谅我",shape=box,color=blue];
		j1997410972 -> j2862131335;
	j195573481 [label="撕裂我的血肉\n将它从我的骨头上剥离\n为什么？为了什么目的？\n这究竟是为了满足谁的饥饿？",shape=box,color=blue];
		j195573481 -> j1304126301;
		j195573481 -> j3803339010;
	j3645211880 [label="除非诉诸……难以想象的手段。或者说，就只能那样了。",shape=box,color=red];
		j3645211880 -> j2414504991;
	j877637253 [label="你被珍视着，被爱着，拥有家人和朋友。即使有时你可能感觉不到这一点。",shape=box,color=red];
		j877637253 -> j585075633;
	j2795048820 [label="我——你肯定是在开玩笑吧？在你亲眼目睹了这一切之后，你怎么可能会真心地说出这些话？要么你失去了理智，要么你的同情心蒙蔽了你的双眼。",shape=box,color=blue];
		j2795048820 -> j2825673513;
		j2795048820 -> j366085230;
	j2862131335 [label="+10 Chemistry",color=orange];
		j2862131335 -> j4006363057;
	j1304126301 [label="没有人。你无需再这样痛苦了。放下吧。",shape=box,color=red];
		j1304126301 -> j824039708;
	j3803339010 [label="我​知道。​我​知道​这​很​痛苦。​对​不起。​真的​很​抱歉。​走​出​房间​​吧。​",shape=box,color=red];
		j3803339010 -> j2577259194;
	j2414504991 [label="+10 Chemistry",color=orange];
		j2414504991 -> j591241105;
	j585075633 [label="里昂，你不是一个人。大家都在想着你。",shape=box,color=red];
		j585075633 -> j3495413632;
	j2825673513 [label="不，里昂。我是认真的。对我来说，你就是一切，我只希望我能让你相信这一点。",shape=box,color=red];
		j2825673513 -> j2925491369;
	j366085230 [label="我……也许你是对的。也许现在还不是时候。",shape=box,color=red];
		j366085230 -> j1950210230;
	j4006363057 [label="Boolean LyonRell2b is now true.",color=orange];
		j4006363057 -> "Chat ends.";
	j824039708 [label="如果事情真有那么简单就好了\n这些锁链我已束缚太久\n比语言更长\n比我的名字更长\n请原谅我",shape=box,color=blue];
		j824039708 -> j2862131335;
	j2577259194 [label="转身，在脑海中走出这个房间。",shape=box,color=red];
		j2577259194 -> j3064937258;
	j591241105 [label="我​看见​了​殁世械灵​先生，​也​听​说​了​关于​ O​rdis ​先生​或​奥塔​先生​的​故事。​我​想​起​了​那些​空洞​的​战甲，​它们​的​思想​仿佛​​从头骨​中​被抽​离​出来。​",shape=box,color=blue];
		j591241105 -> j798816541;
	j3495413632 [label="+10 Chemistry",color=orange];
		j3495413632 -> j863431205;
	j2925491369 [label="我。",shape=box,color=blue];
		j2925491369 -> j2228720352;
	j1950210230 [label="很好。很高兴你终于从刚才的疯狂中清醒过来。看来这玩意儿确实会传染。或许我们应该暂时放下这个设备，因为我担心它已经开始腐蚀你的大脑了。",shape=box,color=blue];
		j1950210230 -> "Chat ends.";
	j3064937258 [label="是的\n他们还会再来\n这血与锁链的密室\n等待的牢笼\n永无止境的等待",shape=box,color=blue];
		j3064937258 -> j2133520101;
	j798816541 [label="Check boolean LyonPainOff",color=orange];
		j798816541 -> j1396882042 [label=true,color=green];
		j798816541 -> j2556143399 [label=false,color=brown];
	j863431205 [label="谢谢……但我不知道，这种悲伤能持续多久，才能随着时间的推移，变成另一种更容易承受的负担？",shape=box,color=blue];
		j863431205 -> j591241105;
	j2228720352 [label="Evaluate expressions",color=orange];
		j2228720352 -> j2959392406 [label="DrifterLiar",color=purple];
		j2228720352 -> j3483859711 [label="LyonNoDate",color=purple];
		j2228720352 -> j4146642731 [label="false",color=purple];
	j2133520101 [label="我必须请你原谅我。有时我会神志不清，我讨厌别人看到我这副模样。",shape=box,color=blue];
		j2133520101 -> j1242024200;
	j1396882042 [label="屈服是如此容易。放弃是如此容易。将我的痛苦献祭给苦难的祭坛，然后说不再承受了也如此容易。",shape=box,color=blue];
		j1396882042 -> j1826488100;
	j2556143399 [label="屈服是如此容易。放弃是如此容易。将我的痛苦献祭给苦难的祭坛，然后说不再承受了也如此容易。或者做出更糟糕的事——做出大家担心我会在黑夜里用刀刃做的事。",shape=box,color=blue];
		j2556143399 -> j1826488100;
	j2959392406 [label="漂泊者，只是……有一个问题。我知道你以前说过谎，你要我怎么相信你说的是真话呢？",shape=box,color=blue];
		j2959392406 -> j3265065666;
	j3483859711 [label="虽然我深感荣幸，但我恐怕我的回答是非常简单明了的“不行”。",shape=box,color=blue];
		j3483859711 -> "Chat ends.";
	j4146642731 [label="我无言以对。",shape=box,color=blue];
		j4146642731 -> j274923146;
	j1242024200 [label="Evaluate expressions",color=orange];
		j1242024200 -> j4289126747 [label="MarieDating",color=purple];
		j1242024200 -> j3015365333 [label="MarieDating",color=purple];
		j1242024200 -> j4289126747 [label="RoatheDating",color=purple];
		j1242024200 -> j3015365333 [label="RoatheDating",color=purple];
		j1242024200 -> j4289126747 [label="false",color=purple];
		j1242024200 -> j3764753682 [label="false",color=purple];
		j1242024200 -> j3015365333 [label="false",color=purple];
	j1826488100 [label="但这……并非……真正的我。也永远不会成为真正的我。我注定要永远是这……破碎的堡垒，这破碎的盾牌……",shape=box,color=blue];
		j1826488100 -> j3846933983;
	j3265065666 [label="我已经发现你撒谎了。虽然我不知道你这次撒谎的目的是什么，但恐怕你已经完全摧毁了我对你的信任。",shape=box,color=blue];
		j3265065666 -> j815984007;
	j274923146 [label="我知道这种情况对我来说并非完全罕见，但是，我觉得我应该就此作出一些回应。",shape=box,color=blue];
		j274923146 -> j1914473703;
