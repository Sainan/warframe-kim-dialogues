		1440 -> 1444;
	1441 [label="没错。是的。为了避免陷入循环论证，我们还是跳过故事中的这一点吧。",shape=box,color=blue];
		1441 -> 1445;
	1442 [label="这让我忍不住笑了。谢谢。",shape=box,color=blue];
