	j3866864669 [label="我只是——我只是对你们俩所经历的一切感到非常抱歉。",shape=box,color=red];
		j3866864669 -> j335675350;
	j4121199807 [label="里昂，我只是……很高兴 Rell 和 Harrow 能和你在一起……即使只是在回忆里。",shape=box,color=red];
		j4121199807 -> j1318384913;
	j902177194 [label="你能不能考虑一下这种可能性……也许这一切都是一个神或多个神所为？为了安慰你？",shape=box,color=red];
		j902177194 -> j1894259748;
	j2004526413 [label="你​能​不​能​考虑​一下​这​种​可能​性……​也​许​这​一切​都​是​月​神​所​为？​为了​安慰​你？​",shape=box,color=red];
		j2004526413 -> j1894259748;
	j2652621334 [label="我不知道，因为这两者必定是互斥的，但是……我不知道。我不知道我们是否永远都会知道。",shape=box,color=red];
		j2652621334 -> j2262821776;
	j3812990086 [label="里昂，我只是……很高兴 Rell 和 Harrow 能和你在一起……即使只是在回忆里。",shape=box,color=red];
		j3812990086 -> j335675350;
	j335675350 [label="谢谢你。我很想念他们。但是……我逐渐明白，在这个地方，能理解我痛苦的人比不能理解我的人要多。",shape=box,color=blue];
		j335675350 -> j1815161237;
	j1318384913 [label="谢谢。我很想念他们。但我……不再孤单了，对吗，mon miracle？",shape=box,color=blue];
		j1318384913 -> j1815161237;
	j1894259748 [label="是的。别以为我没考虑过。我不确定我的信仰是否能如此轻易地修复，但是……无论如何，思考这个问题总归是一种安慰。",shape=box,color=blue];
		j1894259748 -> j1815161237;
	j2262821776 [label="的确如此。别以为我没有想过 Rell 和 Harrow 是不是双耀神派来安慰我的。但正如你所说，这并非我们该知晓之事。",shape=box,color=blue];
		j2262821776 -> j1815161237;
	j1815161237 [label="+20 Chemistry",color=orange];
		j1815161237 -> j648001505;
	j648001505 [label="终于能跟你倾诉这一切，我感到无比轻松。这就像卸下了我的一块重担，我无法用言语表达我的感激之情。",shape=box,color=blue];
		j648001505 -> j918154824;
