	1626 [label="Chat ends.",color=orange];
	2348 [label="Update boolean LyonRell3",color=orange];
		2348 -> 2350;
	1628 [label="我听说这非常痛苦。",shape=box,color=red];
		1628 -> 1632;
	1629 [label="我简直无法想象。 ",shape=box,color=red];
		1629 -> 1633;
	1630 [label="[警告：文中简要提及自残和虐童内容。点击此处结束。你不会因此失去里昂好感度。]",shape=box,color=red];
		1630 -> 1634;
	1627 [label="[结束]",shape=box,color=red];
		1627 -> 1631;
	2350 [label="Update boolean LyonWillDate",color=orange];
		2350 -> 2351;
	1632 [label="我也这么想。不过我相信我在这方面已经有多年的经验，因此，英择谛的警告让我感觉比实际情况严重得多。",shape=box,color=blue];
		1632 -> 1633;
	1633 [label="玛丽和我决定私下使用血清。我请求她先让我用，先试过转变过程，然后再指导她使用——但可想而知，她坚决拒绝了。",shape=box,color=blue];
		1633 -> 1636;
	1634 [label="+20 Chemistry",color=orange];
		1634 -> 1637;
	1631 [label="Update boolean LyonConfessionFail",color=orange];
		1631 -> 1635;
	2351 [label="Chat ends. Next chat will be Lyon5FaithDay2.",color=orange];
	1636 [label="她对我会离开她独自一人去任何地方或做任何事情的想法嗤之以鼻，然后径直走向了自己的房间。",shape=box,color=blue];
		1636 -> 1638;
	1637 [label="Update boolean LyonFamilySuccess",color=orange];
		1637 -> 1639;
	1635 [label="Chat ends.",color=orange];
	1638 [label="我锁上门，脱光衣服，坐在地板中央，尽可能远离任何物体，然后把针头扎进我的侧腹。",shape=box,color=blue];
		1638 -> 1640;
	1639 [label="Update boolean LyonRell3",color=orange];
		1639 -> 1641;
	1640 [label="我亲眼目睹了 Infestation 对罗瑟造成的伤害，它扭曲了他的血肉，就像当时他身上穿的某种东西一样——我可不想成为同样受害者。",shape=box,color=blue];
		1640 -> 1642;
	1641 [label="Update boolean LyonFaith3Unknown",color=orange];
		1641 -> 1643;
	1642 [label="痛苦过后，我原本就模糊不清的视线……变得更加模糊。不知为何，眼前像是出现了……重影？仿佛我看到的不是一个东西，而是两个东西。",shape=box,color=blue];
		1642 -> 1644;
	1643 [label="Chat ends. Next chat will be Lyon5FaithDay2.",color=orange];
	1644 [label="不过，我为自己的韧性感到非常自豪，因为我在呕吐和失去意识之前设法穿上了裤子。",shape=box,color=blue];
		1644 -> 1645;
	1645 [label="醒来​时，​我​并不​是​一​个​人。​然而，​我​也​不​在​我​房间​的​地板​上。​我​正坐​在​儿时​的​卧室​里，​那​吱​吱​作响​的​旧地​板​上，​我​无比​熟悉​的​地方。​",shape=box,color=blue];
		1645 -> 1646;
	1646 [label="坐在我旁边的是一位年轻人。他身旁站着一个人，我现在才知道他叫 Harrow。年轻人手里拿着一个木制小雕像。雕像的四肢是关节连接的——油漆早已褪色，或许只有缝隙和裂缝里还残留着一些。这雕像曾属于我的父亲。它描绘的是一位士兵。",shape=box,color=blue];
		1646 -> 1647;
	1647 [label="那是我小时候唯一属于自己的玩具。",shape=box,color=blue];
		1647 -> 1648;
		1647 -> 1649;
	1648 [label="我小时候也有一个类似的玩偶，那是我最喜欢的玩具之一。",shape=box,color=red];
		1648 -> 1650;
	1649 [label="Rell？",shape=box,color=red];
		1649 -> 1651;
	1650 [label="我听说了。不过，我相信我的情况比你好多了。",shape=box,color=blue];
		1650 -> 1652;
		1650 -> 1653;
		1650 -> 1654;
	1651 [label="正是。",shape=box,color=blue];
		1651 -> 1655;
	1652 [label="士魂大帝是一个复杂的话题，我不想在这里深入探讨。",shape=box,color=red];
		1652 -> 1656;
	1653 [label="其实这不是他的错。在那一刻，他正是我需要的那种人。",shape=box,color=red];
		1653 -> 1657;
	1654 [label="没关系。他在变好。虽然很慢。但总算有点进展。看似不可能的事情也能改变。",shape=box,color=red];
		1654 -> 1658;
	1655 [label="梦中出现的那个年轻人和他沉默的守护者——在我的脑海里——对我来说既陌生又熟悉，就像我们一起长大的兄弟姐妹一样。",shape=box,color=blue];
		1655 -> 1659;
	1656 [label="确实。我们可能会在这里耗上几个小时，争论双衍王境事件的道德和神学意义。",shape=box,color=blue];
		1656 -> 1655;
	1657 [label="每当我只是想象一下如果我是你，我会做出什么事来，我都会感到一阵阵的恐惧袭来。但我们可能会在这里花上几个小时讨论这件事。",shape=box,color=blue];
		1657 -> 1655;
	1658 [label="如果他表现出变化的迹象，而他的行为又受到你的情绪影响，那或许预示着其他问题。不过，这或许是以后再讨论的话题。",shape=box,color=blue];
		1658 -> 1655;
	1659 [label="请原谅我使用过于夸张的比喻，但我们就像三棵树，它们的根系交织在一起，彼此之间难以区分——",shape=box,color=blue];
		1659 -> 1660;
	1660 [label="他们仿佛凭空出现在我眼前，就处于这种状态。我还能回忆起没有 Rell 和 Harrow 的生活。然而，他们却一直都在。每一刻，每一刻，都在我身边。",shape=box,color=blue];
		1660 -> 1661;
	1661 [label="顺便提一下，我真希望能够和英择谛谈谈这件事，我迫切地想知道这件事背后的科学原理是什么——没有双关的意思——但是当我们最终从转变中恢复过来时，英择谛已经不在了。",shape=box,color=blue];
		1661 -> 1662;
	1662 [label="Check boolean LoidFamilyComplete",color=orange];
		1662 -> 1664 [label=true,color=green];
		1662 -> 1663 [label=false,color=brown];
		1662 -> 1664 [label=false,color=brown];
	1664 [label="关于 Infestation 及其运作方式，我所了解的的信息很少，似乎有点……也许……我不知道，跟外面的时间有关？",shape=box,color=red];
		1664 -> 1666;
	1663 [label="英择谛的女儿在楼上。她曾和他一起学习和工作。她或许能帮上忙。",shape=box,color=red];
		1663 -> 1665;
	1666 [label="有一把……吉他……这一切都很难解释，我们俩都通过 Helminth 穿越了时空……",shape=box,color=red];
		1666 -> 1668;
	1665 [label="Update boolean LyonFamilySuccess",color=orange];
		1665 -> 1667;
	1668 [label="我相信，那段经历会在我的噩梦中萦绕很久很久。无论如何，我并不清楚 Rell、Harrow 和我究竟是如何在如此……分子层面、精神层面建立起联系的。",shape=box,color=blue];
		1668 -> 1670;
	1667 [label="Add 1 to Family",color=orange];
		1667 -> 1669;
	1670 [label="但人生的十字路口是双向的。他们在我生命中，我也在他们的生命中。我看到了虚空无情之物。我明白了他们究竟在守护什么。我瞥见了 Harrow，看到了他曾经的模样。",shape=box,color=blue];
		1670 -> 1672;
	1669 [label="要是我们能跟她谈谈就好了。我怀疑已经有人在策划这件事了。如果真是这样，你们可以指望我……帮忙。必要时，我可以很会说服人。",shape=box,color=blue];
		1669 -> 1671;
	1672 [label="但虚空无情之物的压力袭来，我能感觉到——也能听到，就像他们那样，敲击着墙壁。哒……哒……哒……",shape=box,color=blue];
		1672 -> 1673;
	1671 [label="不管怎样，我不知道 Rell、Harrow 和我究竟是如何在如此……分子、精神层面上建立起联系的。",shape=box,color=blue];
		1671 -> 1670;
	1673 [label="我​年轻时​的​所有​异象，​我​所​目睹​的​所有​恐怖​——​难道​它们​都​只​是​来自于​虚空​无情​之物？​难道​是​我​记错​了？​还是，​我​是​真的​受到​了​月神​的​“祝福”？​",shape=box,color=blue];
		1673 -> 1674;
	1674 [label="我内心的信仰……彻底崩溃瓦解了。它就像烧焦的纸片，化为尘埃。哦，我多么痛恨自己的软弱……",shape=box,color=blue];
		1674 -> 1675;
	1675 [label="Evaluate expressions",color=orange];
		1675 -> 1681 [label="LyonDating",color=purple];
		1675 -> 1682 [label="DrifterFaithYesSimilar",color=purple];
		1675 -> 1682 [label="DrifterFaithYesForeign",color=purple];
		1675 -> 1682 [label="DrifterFaithPersonal",color=purple];
		1675 -> 1680 [label="DrifterFaithSol",color=purple];
		1675 -> 1680 [label="DrifterFaithLua",color=purple];
		1675 -> 1680 [label="DrifterFaithBalance",color=purple];
		1675 -> 1679 [label="DrifterFaithAgnostic",color=purple];
		1675 -> 1678 [label="DrifterFaithNoFear",color=purple];
		1675 -> 1677 [label="DrifterFaithNoMITW",color=purple];
		1675 -> 1678 [label="DrifterFaithNoMaybe",color=purple];
		1675 -> 1676 [label="false",color=purple];
	1681 [label="哦，里昂……你经历了太多。怀疑不是软弱的表现，而是痛苦的产物。",shape=box,color=red];
		1681 -> 1683;
		1681 -> 1684;
		1681 -> 1685;
		1681 -> 1686;
		1681 -> 1687;
	1682 [label="信仰不必一成不变，也不应该如此。不是还有很多故事是关于人们失去信仰，最终又重新找回信仰吗？",shape=box,color=red];
		1682 -> 1683;
		1682 -> 1684;
		1682 -> 1685;
	1680 [label="里昂，你一生都奉献给了我们的双耀神。你认为他们会因为这种事而疏远你吗？",shape=box,color=red];
		1680 -> 1683;
		1680 -> 1684;
		1680 -> 1685;
	1679 [label="里昂，我不知道世上有没有神——我觉得我们永远也无法真正知道。但我知道的是，你经历了很多。",shape=box,color=red];
		1679 -> 1683;
		1679 -> 1685;
		1679 -> 1686;
	1678 [label="虽然我个人不相信世上有神，但我知道这对你的人生有多么重要。我不想轻视这一点。",shape=box,color=red];
		1678 -> 1685;
		1678 -> 1687;
	1677 [label="里昂，虚空无情之物是我们造成的——他不是神。别让英择谛的错误毁了你。至于你的信仰？",shape=box,color=red];
		1677 -> 1685;
		1677 -> 1687;
	1676 [label="我很不忍心看到你这样，被卷入这些荒唐事之中。你不应该承受这些。",shape=box,color=red];
		1676 -> 1683;
		1676 -> 1684;
		1676 -> 1685;
		1676 -> 1686;
		1676 -> 1687;
	1683 [label="我不是说你需要重新找回你的信仰。我的意思是，如果你想——如果你觉得你需要——信仰并不是永远失去的东西。",shape=box,color=red];
		1683 -> 1688;
	1684 [label="月神肯定能看到你所经历的一切，你为了她所承受的一切。 ",shape=box,color=red];
		1684 -> 1689;
	1685 [label="我认为你需要专注于在内心深处找到某种平静——无论以何种方式，你都需要找到它。",shape=box,color=red];
		1685 -> 1690;
	1686 [label="如果真有神，如果你的月神真的存在——她肯定能看到你所经历的一切，你为了她所承受的一切。这对她来说一定意义非凡。",shape=box,color=red];
		1686 -> 1691;
	1687 [label="我认为你应该放下任何对神是否存在的想法，先专注于治愈自己。",shape=box,color=red];
		1687 -> 1692;
	1688 [label="Update boolean LyonFaith3Maybe",color=orange];
		1688 -> 1693;
	1689 [label="Update boolean LyonFaith3Yes",color=orange];
		1689 -> 1693;
	1690 [label="Update boolean LyonFaith3Maybe",color=orange];
		1690 -> 1693;
	1691 [label="Update boolean LyonFaith3Yes",color=orange];
		1691 -> 1693;
	1692 [label="Update boolean LyonFaith3No",color=orange];
		1692 -> 1693;
	1693 [label="或许你是对的……我刚才那段充满疑虑的悲惨经历其实并非重点。但我会认真考虑你的话。我们明天再详细讨论这个问题。",shape=box,color=blue];
		1693 -> 1694;
	1694 [label="我看见了 Rell 在扎里曼 10-0 号上的生活，以及他之后所遭受的一切。我目睹了 Harrow 作为一名士兵的生涯，尽管在 Infestation 的侵蚀下逐渐消逝。正如他们目睹了我在高卢的生活以及我所遭受的一切苦难一样。",shape=box,color=blue];
		1694 -> 1695;
	1695 [label="或许你会觉得奇怪，我们之间竟然从未说过一句话。我们觉得没有必要。我们之间只有一种……默契。",shape=box,color=blue];
		1695 -> 1696;
		1695 -> 1697;
	1696 [label="真的吗？从来没有？",shape=box,color=red];
		1696 -> 1698;
	1697 [label="是的……我能看得出来。",shape=box,color=red];
		1697 -> 1699;
	1698 [label="我能听到他们的声音——我知道他们一生中说过的所有话。虽然那些话从来都不是说给我听的。",shape=box,color=blue];
		1698 -> 1699;
	1699 [label="微笑需要言语表达吗？皱眉呢？你需要听到孩子的哭泣才能知道他感到痛苦或感到害怕吗？不，我们只是心照不宣地知道彼此之间的想法。",shape=box,color=blue];
		1699 -> 1700;
	1700 [label="直到它……直到它不再存在。",shape=box,color=blue];
		1700 -> 1701;
	1701 [label="Check boolean LyonDating",color=orange];
		1701 -> 1703 [label=true,color=green];
		1701 -> 1702 [label=false,color=brown];
	1703 [label="mon miracle，他们并没有消失……他们只是死了。",shape=box,color=blue];
		1703 -> 1704;
	1702 [label="我的朋友，他们并没有消失……他们只是死了。",shape=box,color=blue];
		1702 -> 1704;
	1704 [label="我再也听不到那些尚未听过的部分了。现在，我相信，我只能听到那些已经听过的部分了。",shape=box,color=blue];
		1704 -> 1705;
		1704 -> 1706;
	1705 [label="不好意思，听过？",shape=box,color=red];
		1705 -> 1707;
	1706 [label="你是什么时候……开始听不到他的？",shape=box,color=red];
		1706 -> 1708;
	1707 [label="我已经尽力解释了，实在无法再多解释。我不知道该怎么做。请原谅我。",shape=box,color=blue];
		1707 -> 1708;
	1708 [label="我们和罗瑟一起穿过 Helminth，来到这里，来到圣所的那一刻……我不知道……为什么。也不知道是怎么回事。",shape=box,color=blue];
		1708 -> 1709;
	1709 [label="但是，在穿越时间的帷幕时，我的朋友，我的兄弟……那些根系与我的灵魂紧密相连的树木……都在我身边枯萎凋零。",shape=box,color=blue];
		1709 -> 1710;
	1710 [label="如今那里一片空虚，腐朽不堪。关于他们的记忆仍在腐蚀着我。但即便有机会，我也不会放弃它……",shape=box,color=blue];
		1710 -> 1711;
		1710 -> 1712;
	1711 [label="哦？",shape=box,color=red];
		1711 -> 1713;
	1712 [label="为什么不呢？",shape=box,color=red];
		1712 -> 1713;
	1713 [label="我至今仍记得母亲第一次打我的情景。我记得有两种版本，清晰得如同太阳神最耀眼的光芒，而且我知道两种版本都是真的。",shape=box,color=blue];
		1713 -> 1714;
	1714 [label="一个版本是……我独自在黑暗的房间里哭泣。而另一个版本，是两个身影站在我身旁的阴影里。",shape=box,color=blue];
		1714 -> 1715;
	1715 [label="我​记得​第一​次​用​刀​片​划破​皮肤，​试图​驱​散​脑海​中​的​声音，​那​次​我​一​共​划​了​两​次。​其中​一​个​版本​是，​房间​里​空无​一​人。​",shape=box,color=blue];
		1715 -> 1716;
	1716 [label="而在另一个版本中，我听到身后传来嗡嗡声。我感到一位沉稳的守护者默默地存在着。",shape=box,color=blue];
		1716 -> 1717;
	1717 [label="如果我失去了对月神的信仰，却因此获得了他们的指引……这或许是我愿意做出的交易。",shape=box,color=blue];
		1717 -> 1718;
	1718 [label="Evaluate expressions",color=orange];
		1718 -> 1719 [label="LyonDating",color=purple];
		1718 -> 1724 [label="LyonDating",color=purple];
