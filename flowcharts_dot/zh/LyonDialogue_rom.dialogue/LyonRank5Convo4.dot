	"Chat ends." [color=orange];
	j1028404978 [label="Boolean LyonRell3 is now true.",color=orange];
		j1028404978 -> j4075781927;
	j590114124 [label="我听说这非常痛苦。",shape=box,color=red];
		j590114124 -> j835495994;
	j1203255052 [label="我简直无法想象。 ",shape=box,color=red];
		j1203255052 -> j2796351680;
	j663556417 [label="[警告：这段对话会短暂提及虐童内容。点击此处结束此轮对话。你不会因此失去里昂好感度。]",shape=box,color=red];
		j663556417 -> j1843578849;
	j249954929 [label="[结束]",shape=box,color=red];
		j249954929 -> j3856020424;
	j4075781927 [label="Boolean LyonWillDate is now true.",color=orange];
		j4075781927 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j835495994 [label="我也这么想。不过我相信我在这方面已经有多年的经验，因此，英择谛的警告让我感觉比实际情况严重得多。",shape=box,color=blue];
		j835495994 -> j2796351680;
	j2796351680 [label="玛丽和我决定私下使用血清。我请求她先让我用，先试过转变过程，然后再指导她使用——但可想而知，她坚决拒绝了。",shape=box,color=blue];
		j2796351680 -> j3023104890;
	j1843578849 [label="+20 Chemistry",color=orange];
		j1843578849 -> j2698387260;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	"Chat ends. Next chat will be Lyon5FaithDay2." [color=orange];
	j3023104890 [label="她对我会离开她独自一人去任何地方或做任何事情的想法嗤之以鼻，然后径直走向了自己的房间。",shape=box,color=blue];
		j3023104890 -> j3718163908;
	j2698387260 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j2698387260 -> j2559080857;
	j3718163908 [label="我锁上门，脱光衣服，坐在地板中央，尽可能远离任何物体，然后把针头扎进我的侧腹。",shape=box,color=blue];
		j3718163908 -> j3104774977;
	j2559080857 [label="Boolean LyonRell3 is now true.",color=orange];
		j2559080857 -> j4008758555;
	j3104774977 [label="我亲眼目睹了 Infestation 对罗瑟造成的伤害，它扭曲了他的血肉，就像当时他身上穿的某种东西一样——我可不想成为同样受害者。",shape=box,color=blue];
		j3104774977 -> j1989194425;
	j4008758555 [label="Boolean LyonFaith3Unknown is now true.",color=orange];
		j4008758555 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j1989194425 [label="痛苦过后，我原本就模糊不清的视线……变得更加模糊。不知为何，眼前像是出现了……重影？仿佛我看到的不是一个东西，而是两个东西。",shape=box,color=blue];
		j1989194425 -> j2500235155;
	j2500235155 [label="不过，我为自己的韧性感到非常自豪，因为我在呕吐和失去意识之前设法穿上了裤子。",shape=box,color=blue];
		j2500235155 -> j1726091089;
	j1726091089 [label="醒来​时，​我​并不​是​一​个​人。​然而，​我​也​不​在​我​房间​的​地板​上。​我​正坐​在​儿时​的​卧室​里，​那​吱​吱​作响​的​旧地​板​上，​我​无比​熟悉​的​地方。​",shape=box,color=blue];
		j1726091089 -> j3269368258;
	j3269368258 [label="坐在我旁边的是一位年轻人。他身旁站着一个人，我现在才知道他叫 Harrow。年轻人手里拿着一个木制小雕像。雕像的四肢是关节连接的——油漆早已褪色，或许只有缝隙和裂缝里还残留着一些。这雕像曾属于我的父亲。它描绘的是一位士兵。",shape=box,color=blue];
		j3269368258 -> j3481835193;
	j3481835193 [label="那是我小时候唯一属于自己的玩具。",shape=box,color=blue];
		j3481835193 -> j1407483113;
		j3481835193 -> j221988284;
	j1407483113 [label="我小时候也有一个类似的玩偶，那是我最喜欢的玩具之一。",shape=box,color=red];
		j1407483113 -> j339036076;
	j221988284 [label="Rell？",shape=box,color=red];
		j221988284 -> j2721941351;
	j339036076 [label="我听说了。不过，我相信我的情况比你好多了。",shape=box,color=blue];
		j339036076 -> j1114984266;
		j339036076 -> j18329811;
		j339036076 -> j4045565754;
	j2721941351 [label="正是。",shape=box,color=blue];
		j2721941351 -> j269118477;
	j1114984266 [label="士魂大帝是一个复杂的话题，我不想在这里深入探讨。",shape=box,color=red];
		j1114984266 -> j1477893908;
	j18329811 [label="其实这不是他的错。在那一刻，他正是我需要的那种人。",shape=box,color=red];
		j18329811 -> j1838534984;
	j4045565754 [label="没关系。他在变好。虽然很慢。但总算有点进展。看似不可能的事情也能改变。",shape=box,color=red];
		j4045565754 -> j2359378973;
	j269118477 [label="梦中出现的那个年轻人和他沉默的守护者——在我的脑海里——对我来说既陌生又熟悉，就像我们一起长大的兄弟姐妹一样。",shape=box,color=blue];
		j269118477 -> j418656315;
	j1477893908 [label="确实。我们可能会在这里耗上几个小时，争论双衍王境事件的道德和神学意义。",shape=box,color=blue];
		j1477893908 -> j269118477;
	j1838534984 [label="每当我只是想象一下如果我是你，我会做出什么事来，我都会感到一阵阵的恐惧袭来。但我们可能会在这里花上几个小时讨论这件事。",shape=box,color=blue];
		j1838534984 -> j269118477;
	j2359378973 [label="如果他表现出变化的迹象，而他的行为又受到你的情绪影响，那或许预示着其他问题。不过，这或许是以后再讨论的话题。",shape=box,color=blue];
		j2359378973 -> j269118477;
	j418656315 [label="请原谅我使用过于夸张的比喻，但我们就像三棵树，它们的根系交织在一起，彼此之间难以区分——",shape=box,color=blue];
		j418656315 -> j3313721774;
	j3313721774 [label="他们仿佛凭空出现在我眼前，就处于这种状态。我还能回忆起没有 Rell 和 Harrow 的生活。然而，他们却一直都在。每一刻，每一刻，都在我身边。",shape=box,color=blue];
		j3313721774 -> j2239571157;
	j2239571157 [label="顺便提一下，我真希望能够和英择谛谈谈这件事，我迫切地想知道这件事背后的科学原理是什么——没有双关的意思——但是当我们最终从转变中恢复过来时，英择谛已经不在了。",shape=box,color=blue];
		j2239571157 -> j1937133691;
	j1937133691 [label="Check boolean LoidFamilyComplete",color=orange];
		j1937133691 -> j1779399507 [label=true,color=green];
		j1937133691 -> j637083009 [label=false,color=brown];
		j1937133691 -> j1779399507 [label=false,color=brown];
	j1779399507 [label="关于 Infestation 及其运作方式，我所了解的的信息很少，似乎有点……也许……我不知道，跟外面的时间有关？",shape=box,color=red];
		j1779399507 -> j1128079113;
	j637083009 [label="英择谛的女儿在楼上。她曾和他一起学习和工作。她或许能帮上忙。",shape=box,color=red];
		j637083009 -> j486403651;
	j1128079113 [label="有一把……吉他……这一切都很难解释，我们俩都通过 Helminth 穿越了时空……",shape=box,color=red];
		j1128079113 -> j3146019030;
	j486403651 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j486403651 -> j2366605515;
	j3146019030 [label="我相信，那段经历会在我的噩梦中萦绕很久很久。无论如何，我并不清楚 Rell、Harrow 和我究竟是如何在如此……分子层面、精神层面建立起联系的。",shape=box,color=blue];
		j3146019030 -> j4208012692;
	j2366605515 [label="Add 1 to Family counter",color=orange];
		j2366605515 -> j1755417570;
	j4208012692 [label="但人生的十字路口是双向的。他们在我生命中，我也在他们的生命中。我看到了虚空无情之物。我明白了他们究竟在守护什么。我瞥见了 Harrow，看到了他曾经的模样。",shape=box,color=blue];
		j4208012692 -> j1036729898;
	j1755417570 [label="要是我们能跟她谈谈就好了。我怀疑已经有人在策划这件事了。如果真是这样，你们可以指望我……帮忙。必要时，我可以很会说服人。",shape=box,color=blue];
		j1755417570 -> j2870553478;
	j1036729898 [label="但虚空无情之物的压力袭来，我能感觉到——也能听到，就像他们那样，敲击着墙壁。哒……哒……哒……",shape=box,color=blue];
		j1036729898 -> j392606352;
	j2870553478 [label="不管怎样，我不知道 Rell、Harrow 和我究竟是如何在如此……分子、精神层面上建立起联系的。",shape=box,color=blue];
		j2870553478 -> j4208012692;
	j392606352 [label="我​年轻时​的​所有​异象，​我​所​目睹​的​所有​恐怖​——​难道​它们​都​只​是​来自于​虚空​无情​之物？​难道​是​我​记错​了？​还是，​我​是​真的​受到​了​月神​的​“祝福”？​",shape=box,color=blue];
		j392606352 -> j24355718;
	j24355718 [label="我内心的信仰……彻底崩溃瓦解了。它就像烧焦的纸片，化为尘埃。哦，我多么痛恨自己的软弱……",shape=box,color=blue];
		j24355718 -> j2547210604;
	j2547210604 [label="Evaluate expressions",color=orange];
		j2547210604 -> j377064886 [label="LyonDating",color=purple];
		j2547210604 -> j265324541 [label="DrifterFaithYesSimilar",color=purple];
		j2547210604 -> j265324541 [label="DrifterFaithYesForeign",color=purple];
		j2547210604 -> j265324541 [label="DrifterFaithPersonal",color=purple];
		j2547210604 -> j1949423083 [label="DrifterFaithSol",color=purple];
		j2547210604 -> j1949423083 [label="DrifterFaithLua",color=purple];
		j2547210604 -> j1949423083 [label="DrifterFaithBalance",color=purple];
		j2547210604 -> j2939059169 [label="DrifterFaithAgnostic",color=purple];
		j2547210604 -> j2849818629 [label="DrifterFaithNoFear",color=purple];
		j2547210604 -> j1086759083 [label="DrifterFaithNoMITW",color=purple];
		j2547210604 -> j2849818629 [label="DrifterFaithNoMaybe",color=purple];
		j2547210604 -> j1849329857 [label="false",color=purple];
	j377064886 [label="哦，里昂……你经历了太多。怀疑不是软弱的表现，而是痛苦的产物。",shape=box,color=red];
		j377064886 -> j1985350958;
		j377064886 -> j3015809591;
		j377064886 -> j3084205883;
		j377064886 -> j579844439;
		j377064886 -> j3062245508;
	j265324541 [label="信仰不必一成不变，也不应该如此。不是还有很多故事是关于人们失去信仰，最终又重新找回信仰吗？",shape=box,color=red];
		j265324541 -> j1985350958;
		j265324541 -> j3015809591;
		j265324541 -> j3084205883;
	j1949423083 [label="里昂，你一生都奉献给了我们的双耀神。你认为他们会因为这种事而疏远你吗？",shape=box,color=red];
		j1949423083 -> j1985350958;
		j1949423083 -> j3015809591;
		j1949423083 -> j3084205883;
	j2939059169 [label="里昂，我不知道世上有没有神——我觉得我们永远也无法真正知道。但我知道的是，你经历了很多。",shape=box,color=red];
		j2939059169 -> j1985350958;
		j2939059169 -> j3084205883;
		j2939059169 -> j579844439;
	j2849818629 [label="虽然我个人不相信世上有神，但我知道这对你的人生有多么重要。我不想轻视这一点。",shape=box,color=red];
		j2849818629 -> j3084205883;
		j2849818629 -> j3062245508;
	j1086759083 [label="里昂，虚空无情之物是我们造成的——他不是神。别让英择谛的错误毁了你。至于你的信仰？",shape=box,color=red];
		j1086759083 -> j3084205883;
		j1086759083 -> j3062245508;
	j1849329857 [label="我很不忍心看到你这样，被卷入这些荒唐事之中。你不应该承受这些。",shape=box,color=red];
		j1849329857 -> j1985350958;
		j1849329857 -> j3015809591;
		j1849329857 -> j3084205883;
		j1849329857 -> j579844439;
		j1849329857 -> j3062245508;
	j1985350958 [label="我不是说你需要重新找回你的信仰。我的意思是，如果你想——如果你觉得你需要——信仰并不是永远失去的东西。",shape=box,color=red];
		j1985350958 -> j954271302;
	j3015809591 [label="月神肯定能看到你所经历的一切，你为了她所承受的一切。 ",shape=box,color=red];
		j3015809591 -> j2639331916;
	j3084205883 [label="我认为你需要专注于在内心深处找到某种平静——无论以何种方式，你都需要找到它。",shape=box,color=red];
		j3084205883 -> j954271302;
	j579844439 [label="如果真有神，如果你的月神真的存在——她肯定能看到你所经历的一切，你为了她所承受的一切。这对她来说一定意义非凡。",shape=box,color=red];
		j579844439 -> j2639331916;
	j3062245508 [label="我认为你应该放下任何对神是否存在的想法，先专注于治愈自己。",shape=box,color=red];
		j3062245508 -> j3082621799;
	j954271302 [label="Boolean LyonFaith3Maybe is now true.",color=orange];
		j954271302 -> j485240123;
	j2639331916 [label="Boolean LyonFaith3Yes is now true.",color=orange];
		j2639331916 -> j485240123;
	j3082621799 [label="Boolean LyonFaith3No is now true.",color=orange];
		j3082621799 -> j485240123;
	j485240123 [label="或许你是对的……我刚才那段充满疑虑的悲惨经历其实并非重点。但我会认真考虑你的话。我们明天再详细讨论这个问题。",shape=box,color=blue];
		j485240123 -> j511682020;
	j511682020 [label="我看见了 Rell 在扎里曼 10-0 号上的生活，以及他之后所遭受的一切。我目睹了 Harrow 作为一名士兵的生涯，尽管在 Infestation 的侵蚀下逐渐消逝。正如他们目睹了我在高卢的生活以及我所遭受的一切苦难一样。",shape=box,color=blue];
		j511682020 -> j3909649278;
	j3909649278 [label="或许你会觉得奇怪，我们之间竟然从未说过一句话。我们觉得没有必要。我们之间只有一种……默契。",shape=box,color=blue];
		j3909649278 -> j841740459;
		j3909649278 -> j496143314;
	j841740459 [label="真的吗？从来没有？",shape=box,color=red];
		j841740459 -> j4123955959;
	j496143314 [label="是的……我能看得出来。",shape=box,color=red];
		j496143314 -> j2955124800;
	j4123955959 [label="我能听到他们的声音——我知道他们一生中说过的所有话。虽然那些话从来都不是说给我听的。",shape=box,color=blue];
		j4123955959 -> j2955124800;
	j2955124800 [label="微笑需要言语表达吗？皱眉呢？你需要听到孩子的哭泣才能知道他感到痛苦或感到害怕吗？不，我们只是心照不宣地知道彼此之间的想法。",shape=box,color=blue];
		j2955124800 -> j2302830597;
	j2302830597 [label="直到它……直到它不再存在。",shape=box,color=blue];
		j2302830597 -> j944777217;
	j944777217 [label="Check boolean LyonDating",color=orange];
		j944777217 -> j190757095 [label=true,color=green];
		j944777217 -> j231336657 [label=false,color=brown];
	j190757095 [label="mon miracle，他们并没有消失……他们只是死了。",shape=box,color=blue];
		j190757095 -> j3271235986;
	j231336657 [label="我的朋友，他们并没有消失……他们只是死了。",shape=box,color=blue];
		j231336657 -> j3271235986;
	j3271235986 [label="我再也听不到那些尚未听过的部分了。现在，我相信，我只能听到那些已经听过的部分了。",shape=box,color=blue];
		j3271235986 -> j3740716620;
		j3271235986 -> j4084932244;
	j3740716620 [label="不好意思，听过？",shape=box,color=red];
		j3740716620 -> j2011857730;
	j4084932244 [label="你是什么时候……开始听不到他的？",shape=box,color=red];
		j4084932244 -> j2802464947;
	j2011857730 [label="我已经尽力解释了，实在无法再多解释。我不知道该怎么做。请原谅我。",shape=box,color=blue];
		j2011857730 -> j2802464947;
	j2802464947 [label="我们和罗瑟一起穿过 Helminth，来到这里，来到圣所的那一刻……我不知道……为什么。也不知道是怎么回事。",shape=box,color=blue];
		j2802464947 -> j285345772;
	j285345772 [label="但是，在穿越时间的帷幕时，我的朋友，我的兄弟……那些根系与我的灵魂紧密相连的树木……都在我身边枯萎凋零。",shape=box,color=blue];
		j285345772 -> j770928671;
	j770928671 [label="如今那里一片空虚，腐朽不堪。关于他们的记忆仍在腐蚀着我。但即便有机会，我也不会放弃它……",shape=box,color=blue];
		j770928671 -> j1101910764;
		j770928671 -> j4173786756;
	j1101910764 [label="哦？",shape=box,color=red];
		j1101910764 -> j1705548459;
	j4173786756 [label="为什么不呢？",shape=box,color=red];
		j4173786756 -> j1705548459;
	j1705548459 [label="我至今仍记得母亲第一次打我的情景。我记得有两种版本，清晰得如同太阳神最耀眼的光芒，而且我知道两种版本都是真的。",shape=box,color=blue];
		j1705548459 -> j2493824978;
	j2493824978 [label="一个版本是……我独自在黑暗的房间里哭泣。而另一个版本，是两个身影站在我身旁的阴影里。",shape=box,color=blue];
		j2493824978 -> j4209498849;
	j4209498849 [label="我​记得​第一​次​用​刀​片​划破​皮肤，​试图​驱​散​脑海​中​的​声音，​那​次​我​一​共​划​了​两​次。​其中​一​个​版本​是，​房间​里​空无​一​人。​",shape=box,color=blue];
		j4209498849 -> j4236285575;
	j4236285575 [label="而在另一个版本中，我听到身后传来嗡嗡声。我感到一位沉稳的守护者默默地存在着。",shape=box,color=blue];
		j4236285575 -> j3943539958;
	j3943539958 [label="如果我失去了对月神的信仰，却因此获得了他们的指引……这或许是我愿意做出的交易。",shape=box,color=blue];
		j3943539958 -> j2400849994;
