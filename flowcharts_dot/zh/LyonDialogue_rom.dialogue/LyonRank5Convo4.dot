		1718 -> 1720 [label="DrifterFaithNoMITW",color=purple];
		1718 -> 1719 [label="DrifterFaithNoMaybe",color=purple];
		1718 -> 1720 [label="DrifterFaithNoMaybe",color=purple];
		1718 -> 1719 [label="false",color=purple];
		1718 -> 1720 [label="false",color=purple];
	1719 [label="我只是——我只是对你们俩所经历的一切感到非常抱歉。",shape=box,color=red];
		1719 -> 1725;
	1724 [label="里昂，我只是……很高兴 Rell 和 Harrow 能和你在一起……即使只是在回忆里。",shape=box,color=red];
		1724 -> 1728;
	1723 [label="你能不能考虑一下这种可能性……也许这一切都是一个神或多个神所为？为了安慰你？",shape=box,color=red];
		1723 -> 1727;
	1722 [label="你​能​不​能​考虑​一下​这​种​可能​性……​也​许​这​一切​都​是​月​神​所​为？​为了​安慰​你？​",shape=box,color=red];
		1722 -> 1727;
	1721 [label="我不知道，因为这两者必定是互斥的，但是……我不知道。我不知道我们是否永远都会知道。",shape=box,color=red];
		1721 -> 1726;
	1720 [label="里昂，我只是……很高兴 Rell 和 Harrow 能和你在一起……即使只是在回忆里。",shape=box,color=red];
		1720 -> 1725;
	1725 [label="谢谢你。我很想念他们。但是……我逐渐明白，在这个地方，能理解我痛苦的人比不能理解我的人要多。",shape=box,color=blue];
		1725 -> 1729;
	1728 [label="谢谢。我很想念他们。但我……不再孤单了，对吗，mon miracle？",shape=box,color=blue];
		1728 -> 1729;
	1727 [label="是的。别以为我没考虑过。我不确定我的信仰是否能如此轻易地修复，但是……无论如何，思考这个问题总归是一种安慰。",shape=box,color=blue];
		1727 -> 1729;
	1726 [label="的确如此。别以为我没有想过 Rell 和 Harrow 是不是双耀神派来安慰我的。但正如你所说，这并非我们该知晓之事。",shape=box,color=blue];
		1726 -> 1729;
