	"Chat ends." [color=orange];
	j1181132753 [label="Check boolean LyonConsentComplete",color=orange];
		j1181132753 -> "Chat ends." [label=true,color=green];
		j1181132753 -> j1482858032 [label=false,color=brown];
	j1316396836 [label="Check boolean LyonPolyamorySuccess",color=orange];
		j1316396836 -> j1181132753 [label=true,color=green];
		j1316396836 -> "Chat ends." [label=false,color=brown];
	j1482858032 [label="如果可以的话，我希望能简短聊一些事，相信这样我们俩都会安心些，mon miracle。",shape=box,color=blue];
		j1482858032 -> j2120075793;
		j1482858032 -> j1982180512;
	j2120075793 [label="[结束]",shape=box,color=red];
		j2120075793 -> j3944516755;
	j1982180512 [label="怎么了，里昂？",shape=box,color=red];
		j1982180512 -> j245861248;
	j3944516755 [label="Boolean LyonConsentComplete is now true.",color=orange];
		j3944516755 -> "Chat ends.";
	j245861248 [label="不，没什么。我只是想说，我知道当你不在我身边时，你会以……亲密的方式与他人相处。",shape=box,color=blue];
		j245861248 -> j2405951118;
	j2405951118 [label="而我只想向你保证，这丝毫不会让我犹豫或不安。你出现在我的生命里，带给我的只有平静和快乐……",shape=box,color=blue];
		j2405951118 -> j961819155;
	j961819155 [label="我又怎么能拒绝将这般馈赠赐予他人？",shape=box,color=blue];
		j961819155 -> j2326158038;
		j961819155 -> j749020501;
	j2326158038 [label="我确信他们会喜欢你，尽管这或许无关紧要。",shape=box,color=red];
		j2326158038 -> j2517785254;
	j749020501 [label="谢谢，这对我意义非凡。",shape=box,color=red];
		j749020501 -> j1598809199;
	j2517785254 [label="想到这里我不就忍不住微笑。谁知道呢，或许在另一世，或某一天，我们终将相遇。 ",shape=box,color=blue];
		j2517785254 -> j428498691;
	j1598809199 [label="我们现在的样子——我现在的样子，带着你给予我的所有，带着我们所代表的一切……我很满足。不，是……幸福。这是我很久以来头一回有这样的感觉。",shape=box,color=blue];
		j1598809199 -> j1576377227;
	j428498691 [label="但此刻，我心怀满足。不，是……幸福。这是我很久以来头一回有这样的感觉。",shape=box,color=blue];
		j428498691 -> j1576377227;
	j1576377227 [label="这一切都要感谢你。不过现在，我要跟你说再见了。",shape=box,color=blue];
		j1576377227 -> j3973223123;
	j3973223123 [label="——里昂",shape=box,color=blue];
		j3973223123 -> j3944516755;
}