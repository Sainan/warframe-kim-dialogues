		2345 -> 2213 [label=true,color=green];
		2345 -> 2214 [label=false,color=brown];
	2215 [label="Chat ends.",color=orange];
	2216 [label="如果可以的话，我希望能简短谈谈一些事，相信这样我们俩都会安心些，mon miracle。",shape=box,color=blue];
		2216 -> 2217;
		2216 -> 2218;
	2214 [label="Chat ends.",color=orange];
	2217 [label="[结束]",shape=box,color=red];
		2217 -> 2219;
	2218 [label="怎么了，里昂？",shape=box,color=red];
		2218 -> 2220;
	2219 [label="Update boolean LyonConsentComplete",color=orange];
		2219 -> 2221;
	2220 [label="不，没什么。我只是想说，我知道当你不在我身边时，你会以……亲密的方式与他人相处。",shape=box,color=blue];
		2220 -> 2222;
	2221 [label="Chat ends.",color=orange];
	2222 [label="而我只想向你保证，这丝毫不会让我犹豫或不安。你出现在我的生命里，带给我的只有平静和快乐……",shape=box,color=blue];
		2222 -> 2223;
	2223 [label="我又怎么能拒绝将这般馈赠赐予他人？",shape=box,color=blue];
		2223 -> 2224;
		2223 -> 2225;
	2224 [label="我确信他们会喜欢你，尽管这或许无关紧要。",shape=box,color=red];
		2224 -> 2226;
	2225 [label="谢谢，这对我意义非凡。",shape=box,color=red];
		2225 -> 2227;
	2226 [label="想到这里我不就忍不住微笑。谁知道呢，或许在另一世，或某一天，我们终将相遇。 ",shape=box,color=blue];
		2226 -> 2228;
	2227 [label="我们现在的样子——我现在的样子，带着你给予我的所有，带着我们所代表的一切……我很满足。不，是……幸福。这是我很久以来头一回有这样的感觉。",shape=box,color=blue];
		2227 -> 2229;
	2228 [label="但此刻，我心怀满足。不，是……幸福。这是我很久以来头一回有这样的感觉。",shape=box,color=blue];
		2228 -> 2229;
	2229 [label="这一切都要感谢你。不过现在，我要跟你说再见了。",shape=box,color=blue];
		2229 -> 2230;
	2230 [label="——里昂",shape=box,color=blue];
		2230 -> 1193;
	1193 [label="Update boolean LyonConsentComplete",color=orange];
		1193 -> 1187;
	1187 [label="Chat ends.",color=orange];
