	j3320592400 [label="+20 Chemistry",color=orange];
		j3320592400 -> j2200842474;
	j895778444 [label="里昂，我和玛丽聊到了你的……习惯，我想问问我们能不能谈谈？",shape=box,color=red];
		j895778444 -> j201451900;
	j3244986586 [label="[​禁用​所有关于​自残​的​对话。​你​不​会​因此​损失​与​里昂​的​好​感度​点数。​]",shape=box,color=red];
		j3244986586 -> j1212109973;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j3429167014 [label="里昂？我们能聊一些可能让你有点……不舒服的话题吗？",shape=box,color=red];
		j3429167014 -> j2640871339;
	j1027186356 [label="里昂，如果可以的话，我想跟你谈谈你为什么——嗯……为什么会伤害自己？",shape=box,color=red];
		j1027186356 -> j1761478398;
	j2200842474 [label="[由于之前设置的触发警告，对话已跳过]",shape=box,color=blue];
		j2200842474 -> "Chat ends.";
	j201451900 [label="她告诉我你们俩已经聊过了——是的，当然。你或许会讶异我谈起我的这个特点时有多么不自在。",shape=box,color=blue];
		j201451900 -> j3656253851;
	j1212109973 [label="Boolean LyonPainOff is now true.",color=orange];
		j1212109973 -> j706142495;
	"Chat ends." [color=orange];
	j2640871339 [label="你可以问，但在我觉得提到我不想讨论领域时，我有权利停止对话的权利。 ",shape=box,color=blue];
		j2640871339 -> j4216129176;
	j1761478398 [label="嗯。说实话，我很惊讶你过了这么久才问起我的这个特点。通常来说，这恰恰是大多数人最容易注意到并加以评论的。",shape=box,color=blue];
		j1761478398 -> j1853156475;
	j3656253851 [label="通常情况下，这恰恰是大多数人最容易注意到并加以论断的事物。可能是出于担忧、厌恶，或是出于病态的好奇心。",shape=box,color=blue];
		j3656253851 -> j897187574;
	j706142495 [label="如果你因此觉得自己是个懦夫，那么我恳求你——不要这样想。因为这痛苦不该由你承受，而是由我承受。这一切并不是你自己选择承受的。",shape=box,color=blue];
		j706142495 -> j2074440849;
	j4216129176 [label="是关于你有时会伤害自己的事。我只是想谨慎地跟你提起这个话题而已。",shape=box,color=red];
		j4216129176 -> j2761937878;
	j1853156475 [label="或许是出于担忧、厌恶，又或许是出于一种病态的好奇心——就像有人会透过疯子的笼子窥视一样。我想知道，你是哪一种？",shape=box,color=blue];
		j1853156475 -> j469386369;
		j1853156475 -> j172143033;
		j1853156475 -> j832434133;
		j1853156475 -> j4033755553;
	j897187574 [label="Evaluate expressions",color=orange];
