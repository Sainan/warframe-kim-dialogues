		1204 -> 1199 [label="DrifterHarmLoss",color=purple];
		1204 -> 1200 [label="DrifterHarmLoss",color=purple];
		1204 -> 1199 [label="false",color=purple];
	1198 [label="我们用的这台机械装置给人一种冷漠疏离的感觉。仿佛我们被某种方式保护起来，免受他人通过它敲出的文字可能造成的伤害。",shape=box,color=blue];
		1198 -> 1205;
	1203 [label="+5 Chemistry",color=orange];
		1203 -> 1209;
	1199 [label="抱歉——我想，我不想继续聊下去了。[结束]",shape=box,color=red];
		1199 -> 1194;
	1200 [label="[警告：本文涉及自杀话题] 我……曾经因为这种“习惯”失去了一位亲人，而我……",shape=box,color=red];
		1200 -> 1206;
	1201 [label="我只是想帮帮你，确保你一切安好。仅此而已。",shape=box,color=red];
		1201 -> 1207;
	1202 [label="我感觉这样不健康——这种事应该停止。 ",shape=box,color=red];
		1202 -> 1208;
	1210 [label="我​知道​你​说​过​在​注射​血清​之前​你​经常​伤害​自己，​但是​……​我​无法​想象​这样​能​让​你​好​受​一些。​",shape=box,color=red];
		1210 -> 1215;
	1205 [label="我反而认为恰恰相反——当我们卸下在日常社交互动中穿戴的盔甲时，我们就失去了那些可以用来保护我们的东西。",shape=box,color=blue];
		1205 -> 1211;
	1209 [label="漂泊者，我很感激你处理这件事的谨慎态度。谢谢。但我已经习惯了这成为人们的谈资。人们讨论它的原因可能是出于担忧、厌恶，或是病态的好奇——虽然我认为你已经证明了你是前者。",shape=box,color=blue];
		1209 -> 1199;
		1209 -> 1200;
		1209 -> 1201;
		1209 -> 1202;
	1206 [label="Update boolean DrifterHarmLoss",color=orange];
		1206 -> 1212;
	1207 [label="Update boolean DrifterHarmHelp",color=orange];
		1207 -> 1213;
	1208 [label="Update boolean DrifterHarmStop",color=orange];
		1208 -> 1214;
	1215 [label="不，​恐怕​并​没有。​它​只是​把​原本​是​为了​清除​那些​困扰​我​的​异象​而​必须​做​的​事情，​变成​了​为了​运用​这​种​血清​的​“恩赐”​而​必须​做​的​事情。​",shape=box,color=blue];
		1215 -> 1221;
	1211 [label="因此，在类似情况下……我深知我射出的箭可能射中的不是准备战斗的士兵，而是树林里毫无防备的鹿。",shape=box,color=blue];
		1211 -> 1216;
	1212 [label="哦，朋友……我无法用言语表达出我对你所遭受的一切的同情。",shape=box,color=blue];
		1212 -> 1217;
	1213 [label="Check boolean LyonAllRight",color=orange];
		1213 -> 1219 [label=true,color=green];
		1213 -> 1218 [label=false,color=brown];
	1214 [label="我想你来得太晚了，已经晚了好几年，而且还没赶上那支原型战甲血清之前，你已经无法阻止我这种特殊的冲动了——事实上，恐怕现在这更像是一种我不得不做的事了，不是吗？",shape=box,color=blue];
		1214 -> 1220;
	1221 [label="+5 Chemistry",color=orange];
		1221 -> 1226;
	1216 [label="因此，我最后要告诉你的是：",shape=box,color=blue];
		1216 -> 1222;
	1217 [label="在这种时候，语言显得苍白无力。我们想尽办法去运用语言，但它似乎总是无法传达真正的意思。",shape=box,color=blue];
		1217 -> 1223;
	1219 [label="我再次努力克制自己，不让自己因为想到自己终于接近“一切安好”这个概念而笑出声来。但漂泊者，我非常感谢你的好意。",shape=box,color=blue];
		1219 -> 1224;
	1218 [label="我在努力克制自己，不让自己因为想到自己终于接近“一切安好”这个概念而笑出声来。但漂泊者，我非常感谢你的好意。",shape=box,color=blue];
		1218 -> 1224;
	1220 [label="+5 Chemistry",color=orange];
		1220 -> 1225;
	1226 [label="如果说在注射血清之前我还能控制自己去治愈自残的冲动，那么我相信，与“Harrow”战甲结合已经使这一切变得完全不可能了。",shape=box,color=blue];
		1226 -> 1231;
	1222 [label="我们必须时刻提醒自己，即使我们自己没有勇气站起来，也要有力量去帮助别人站起来。",shape=box,color=blue];
		1222 -> 1227;
	1223 [label="鉴于你的坦白，如果你不介意的话，我可以做三件事。",shape=box,color=blue];
		1223 -> 1228;
	1224 [label="+5 Chemistry",color=orange];
		1224 -> 1229;
		1224 -> 1230;
	1225 [label="但我并非有意轻率对待那些我认为是对我身心健康的关切，我很抱歉。我只是觉得我无法停止这种行为。",shape=box,color=blue];
		1225 -> 1229;
		1225 -> 1230;
	1231 [label="恕我直言，漂泊者，我认为我再也无法以这种方式对自己造成任何真正的永久性伤害了。",shape=box,color=blue];
		1231 -> 1235;
	1227 [label="这就是故事的真正目的。",shape=box,color=blue];
		1227 -> 1232;
	1228 [label="第一，我要向你保证，我没有陷入任何危险。如果你认为我伤害自己的欲望是由某种深藏的、可怕的自我厌恶所驱使的，我会很想消除这些恐惧。",shape=box,color=blue];
		1228 -> 1233;
	1229 [label="我可以问下你为什么要这样做？",shape=box,color=red];
		1229 -> 1234;
	1230 [label="我只是担心你会做得太过火。",shape=box,color=red];
		1230 -> 1231;
	1235 [label="虽然我没有那种自负到认为自己刀枪不入，但这种行为似乎……我们不妨说……是命中注定的。",shape=box,color=blue];
		1235 -> 1241;
	1232 [label="+20 Chemistry",color=orange];
		1232 -> 1236;
	1233 [label="虽然我……了解那种深深的忧郁，但它并不能激发我使用香炉的欲望。（况且，玛丽绝不会允许我这样做。她宁愿把这种忧郁喂给我，也绝不会让我再靠近香炉。）",shape=box,color=blue];
		1233 -> 1237;
	1234 [label="Evaluate expressions",color=orange];
		1234 -> 1240 [label="LyonBackstory3a, LyonLecture2",color=purple];
		1234 -> 1240 [label="LyonBackstory3b, LyonLecture2",color=purple];
		1234 -> 1239 [label="LyonBackstory3a",color=purple];
		1234 -> 1239 [label="LyonBackstory3b",color=purple];
		1234 -> 1238 [label="false",color=purple];
	1241 [label="+5 Chemistry",color=orange];
		1241 -> 1246;
	1236 [label="漂泊者，保重。我们很快会再联系。",shape=box,color=blue];
		1236 -> 1242;
	1237 [label="但朋友，我从未在夜里听到过如此深切的痛苦低语。我可以向你发誓，我以我所珍视的一切向你保证。",shape=box,color=blue];
		1237 -> 1243;
	1240 [label="我已经向你坦白过我行为的真正动力——痛苦能让我摆脱困扰我的异象。而且，这种做法在月神兄弟会中，并不像在你们文化中那样令人羞耻。我可以以我所珍视的一切发誓，我没有任何隐瞒。",shape=box,color=blue];
		1240 -> 1245;
	1239 [label="这​是​一​个​复杂​的​话题，​因为​我​自残​的​原因​并​非​单一​的。​我​曾​告诉​过​你​那些​困扰​我​的​异象，​以及​疼痛​如何​让​我​头脑​清醒。​但​这​种​行为​本身​并​不​像​你​想象​的​那样​禁忌。​",shape=box,color=blue];
		1239 -> 1244;
	1238 [label="这是一个复杂的问题，因为我自残的原因并非单一的。首先我必须声明，在我们那个时代，这种行为本身并不像你想象的那样禁忌。",shape=box,color=blue];
		1238 -> 1244;
	1246 [label="我不认为我做的事情是“正确的”。我也不认为别人应该效仿我做的事情。也不认为我做的事情值得羡慕。",shape=box,color=blue];
		1246 -> 1251;
	1242 [label="——里昂·阿拉德神父",shape=box,color=blue];
		1242 -> 1247;
	1243 [label="第二，我必须赞扬你的勇气，你竟然能把这些话告诉我。你完全可以避而不谈，但你没有。",shape=box,color=blue];
		1243 -> 1248;
	1245 [label="如果你认为我伤害自己的欲望是由某种深藏的、可怕的自我厌恶所驱使的，我会很想消除这些恐惧。",shape=box,color=blue];
		1245 -> 1250;
	1244 [label="在​月​神​兄弟会​中，​有​一​种​古老​的​鞭笞​习俗。​这​种​习俗​十分​罕见，​即使​在​我​那个​年代，​它​也​被​视为​一​种​古老​的​习俗，​只有​那些​“蒙受​她​异象”​的​人​才​会​使用​这个​方法。​",shape=box,color=blue];
		1244 -> 1249;
	1251 [label="然而，就我这种极其独特且在最字面意义上可以说是“超自然”的状态而言，这种事对我来说也并非绝对危险。",shape=box,color=blue];
		1251 -> 1256;
	1247 [label="Update boolean LyonSpeech",color=orange];
		1247 -> 1252;
	1248 [label="第三，我无法也永远无法理解你同伴所遭受的苦难。某种程度上，除了他们自己，恐怕没有人能够真正理解。",shape=box,color=blue];
		1248 -> 1253;
	1250 [label="虽然我……了解那种深深的忧郁，但它并不能激发我使用香炉的欲望。况且，玛丽绝不会允许我这样做。",shape=box,color=blue];
		1250 -> 1255;
	1249 [label="我刚来不久，教堂的一位神父就教了我这方法，因为他看到我也同样“蒙福”，觉得应该帮助我。 ",shape=box,color=blue];
		1249 -> 1254;
	1256 [label="的​确，​我​常​常​想，​现代​科学​是否​有​某​种​奇迹​能够​帮助​我​摆脱​痛苦。​如果​我​的​身体​状况​允许，​我​一定​会​接受​这样​的​帮助。​但​我​现在​怀疑​我​的​生理​机​能​根本​就​没有​这个​选项。​",shape=box,color=blue];
		1256 -> 1261;
	1252 [label="Chat ends.",color=orange];
	1253 [label="如此令人身心俱疲的痛苦，从本质上来说，是一种孤独的体验。",shape=box,color=blue];
		1253 -> 1257;
	1255 [label="Update boolean LyonSNo",color=orange];
		1255 -> 1260;
		1255 -> 1259;
		1255 -> 1258;
	1254 [label="Update boolean LyonLecture2",color=orange];
		1254 -> 1258;
		1254 -> 1259;
		1254 -> 1260;
	1261 [label="无论如何，我向你保证——我不会因此丧命。这是我从小就背负的重担。而且，我认为这种症状总比让伤口溃烂化脓要好，如果我不去揭开结痂的话。",shape=box,color=blue];
		1261 -> 1264;
	1257 [label="我只向我的神、你的神、他人的神祈祷，愿你心中不要怀有愧疚。因为如果说这世间或来世有什么值得被宽恕的，那就是对一个曾遭受如此苦难的人心存善意。",shape=box,color=blue];
		1257 -> 1262;
	1260 [label="你确定你永远不会……做得太过分吗？",shape=box,color=red];
		1260 -> 1231;
	1259 [label="宗教习俗有时真是奇怪，这让我很惊讶。",shape=box,color=red];
		1259 -> 1263;
	1258 [label="这让我感觉好多了。",shape=box,color=red];
		1258 -> 1231;
	1264 [label="Check boolean LyonSNo",color=orange];
		1264 -> 1267 [label=true,color=green];
		1264 -> 1268 [label=false,color=brown];
	1262 [label="+15 Chemistry",color=orange];
		1262 -> 1265;
	1263 [label="我同意你的看法。我对宗教仪式之间的差异非常着迷，也十分喜欢研究所有相关的文献资料。",shape=box,color=blue];
		1263 -> 1266;
	1267 [label="+10 Chemistry",color=orange];
		1267 -> 1271;
	1268 [label="如果你认为我伤害自己的欲望是由某种深藏的、可怕的自我厌恶所驱使的，我会很想消除这些恐惧。",shape=box,color=blue];
		1268 -> 1272;
	1265 [label="漂泊者，保重。我们很快会再联系。",shape=box,color=blue];
		1265 -> 1269;
	1266 [label="宗教人类学是我非常喜爱的一门学科。通过研究一个社会和一个民族的仪式，我们可以了解很多关于他们的信息。 ",shape=box,color=blue];
		1266 -> 1270;
	1271 [label="但我可以向你保证——如果我真到了某种时刻，我再也无法相信自己，我一定会说出来。",shape=box,color=blue];
		1271 -> 1275;
	1272 [label="虽然我……了解那种深深的忧郁，但它并不能激发我使用香炉的欲望。况且，玛丽绝不会允许我这样做。",shape=box,color=blue];
		1272 -> 1267;
	1269 [label="——里昂·阿拉德神父",shape=box,color=blue];
		1269 -> 1273;
	1270 [label="在极北之地，有一个圣光者教派，他们崇拜着一具从消融的冰川中挖掘出的尸体。尸体保存完好，无人知晓它的确切年代。但它脖子上佩戴的黄铜圆盘上，刻着太阳的图案。",shape=box,color=blue];
		1270 -> 1274;
	1275 [label="对玛丽，对你，对洛德先生，甚至对罗阿特说，不管是谁。我会说出来。我发誓。",shape=box,color=blue];
		1275 -> 1277;
		1275 -> 1278;
	1273 [label="Chat ends.",color=orange];
	1274 [label="他们相信这具木乃伊就是太阳神的遗体。他们相信他终有一天会复活，再次降临。每隔一百年，他们都会筹备“大前夜”，许多信徒会在前夜饮用掺有毒药的葡萄酒。",shape=box,color=blue];
		1274 -> 1276;
	1277 [label="这就足够了。里昂，谢谢你。",shape=box,color=red];
		1277 -> 1280;
	1278 [label="我相信你。我只是想和你一起经历这个过程。",shape=box,color=red];
		1278 -> 1280;
	1276 [label="可想而知，当第二天早上他们的木乃伊尸体没有复活时，他们就有了充分的理由来解释为什么他们的计算是错误的，日期又被推迟了一个世纪左右。",shape=box,color=blue];
		1276 -> 1279;
	1280 [label="我非常感激你希望确认我的行为并非出于某种不受约束的自毁冲动。",shape=box,color=blue];
		1280 -> 1281;
	1279 [label="但我似乎已经偏离主题太远了。",shape=box,color=blue];
		1279 -> 1241;
	1281 [label="我​还​不​太​习惯​生活​中​有​你​这样​的​朋友。​",shape=box,color=blue];
		1281 -> 1282;
	1282 [label="漂泊者，保重。我们很快会再联系。",shape=box,color=blue];
		1282 -> 1283;
	1283 [label="——里昂·阿拉德神父",shape=box,color=blue];
		1283 -> 1284;
	1284 [label="Chat ends.",color=orange];
