		"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
	j568815230 [label="那我别无选择，只能原谅你。 ",shape=box,color=blue];
		j568815230 -> j106665696;
	j537348092 [label="是什么改变了你，让你突然变得现在在意，而之前你却并不在意？",shape=box,color=blue];
		j537348092 -> j1439219866;
		j537348092 -> j1229918771;
	j2163685293 [label="我别无选择，只能原谅你。我不明白你为什么会想要我这样一个残缺不全的人，来占据你的空间。",shape=box,color=blue];
		j2163685293 -> j2945421463;
	j106665696 [label="Boolean LyonConfessionFail is now false.",color=orange];
		j106665696 -> "Chat ends.";
	j1439219866 [label="我改变对你的看法了。",shape=box,color=red];
		j1439219866 -> j568815230;
	j1229918771 [label="我觉得，在听了你们的故事之后，可能会有点阻碍到我们的发展。",shape=box,color=red];
		j1229918771 -> j578500578;
	j2945421463 [label="但是，当我了解到你为了让我留在你身边会采取多么匪夷所思的手段时，我对你那些话的恼怒感就消退了。",shape=box,color=blue];
