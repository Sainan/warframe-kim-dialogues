	2307 [label="说实话，这件事的滑稽之处正是促使我前来调查的原因之一。你真的这么难过吗？我实在无法想象，生活中缺少我的陪伴会是件多么可怕的事情。",shape=box,color=blue];
		2307 -> 2313;
	2302 [label="如你所愿，我将竭诚协助。我真同情你那个恶魔打手接下来会对玛丽做什么。",shape=box,color=blue];
		2302 -> 2308;
