	j748916005 [label="你是真的走投无路了，以至于不得不请求罗瑟代表你来纠缠我，以便把洛德先生送上楼吗？",shape=box,color=blue];
		j748916005 -> j1479095564;
	j755542552 [label="你是真的走投无路了，以至于不得不请求罗瑟代表你来纠缠我吗？",shape=box,color=blue];
		j755542552 -> j4009243317;
	"Chat ends." [color=orange];
	j4277757160 [label="你知道这听起来有多荒谬吗？",shape=box,color=blue];
		j4277757160 -> j1875744735;
		j4277757160 -> j2702537809;
	j1479095564 [label="我不想再浪费时间听他争论了。我只想说，很好。",shape=box,color=blue];
		j1479095564 -> j2169173578;
	j4009243317 [label="如果我理解有误请指正，问题在于你不想深究我的过去。现在你似乎改变主意了？",shape=box,color=blue];
		j4009243317 -> j456729325;
	j1875744735 [label="我不知道他说了我会道歉。",shape=box,color=red];
		j1875744735 -> j3210715488;
	j2702537809 [label="我当时不知道该怎么办。现在回想起来，我知道这很荒谬。",shape=box,color=red];
		j2702537809 -> j3250612979;
	j2169173578 [label="Check boolean MarieFamilyFail",color=orange];
		j2169173578 -> j339939255 [label=true,color=green];
		j2169173578 -> j3388556277 [label=false,color=brown];
	j456729325 [label="我不明白。我们回不去了。泼出去的水就收不回来了。",shape=box,color=blue];
		j456729325 -> j1179997806;
		j456729325 -> j1277964139;
	j3210715488 [label="我知道了。",shape=box,color=blue];
		j3210715488 -> "Chat ends.";
	j3250612979 [label="说实话，这件事的滑稽之处正是促使我前来调查的原因之一。你真的这么难过吗？我实在无法想象，生活中缺少我的陪伴会是件多么可怕的事情。",shape=box,color=blue];
		j3250612979 -> j1654224760;
	j339939255 [label="如你所愿，我将竭诚协助。我真同情你那个恶魔打手接下来会对玛丽做什么。",shape=box,color=blue];
		j339939255 -> j92487004;
	j3388556277 [label="我将按你的要求提供帮助。现在，把你的恶魔打手叫回去。",shape=box,color=blue];
		j3388556277 -> j770168571;
	j1179997806 [label="哦，那岂不是白费力气了吗？",shape=box,color=red];
		j1179997806 -> "Chat ends.";
	j1277964139 [label="那我……就简单地说声对不起吧。对不起，我没有听你的话。",shape=box,color=red];
		j1277964139 -> j326397467;
	j1654224760 [label="很可怕，里昂。我非常在乎你。我知道我之前对你做错了很严重的事。",shape=box,color=red];
		j1654224760 -> j483357631;
	j92487004 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j92487004 -> j547953661;
	j770168571 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j770168571 -> j3711686580;
	j326397467 [label="请问你为什么不听我的话？你是害怕这个话题吗？还是觉得无聊？又或者你觉得自己不够坚强，无法承受？",shape=box,color=blue];
		j326397467 -> j3431942465;
		j326397467 -> j752346193;
		j326397467 -> j2752891530;
	j483357631 [label="我真的非常非常抱歉。",shape=box,color=red];
		j483357631 -> j654715546;
