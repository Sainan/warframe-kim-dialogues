	edge [fontname="Roboto Condensed"];

	"LyonRank3Convo6 begins." [color=orange];
		"LyonRank3Convo6 begins." -> j812357926;
		"LyonRank3Convo6 begins." -> j1038552372;
	j812357926 [label="在罗瑟来之前，英择谛和你们在大教堂待了多久？",shape=box,color=red];
		j812357926 -> j3484673210;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j3484673210 [label="你为什么问我这个问题？",shape=box,color=blue];
		j3484673210 -> j4196769031;
	"Chat ends." [color=orange];
	j4196769031 [label="Evaluate expressions",color=orange];
		j4196769031 -> j3478195890 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j2130035981 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j2087717673 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j1874316490 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j2130035981 [label="LyonVisions1",color=purple];
		j4196769031 -> j2087717673 [label="LyonVisions1",color=purple];
		j4196769031 -> j1874316490 [label="LyonVisions1",color=purple];
		j4196769031 -> j3478195890 [label="LyonVisions1",color=purple];
		j4196769031 -> j2130035981 [label="false",color=purple];
		j4196769031 -> j2087717673 [label="false",color=purple];
	j3478195890 [label="有人提醒我，你对事物的看法可能和我们不一样。但这并不会困扰我。我对你的见解很感兴趣。",shape=box,color=red];
		j3478195890 -> j1460992770;
	j2130035981 [label="玛丽似乎只偏向“主教”。而罗瑟显然恨透了他。我需要一个中立的第三方。你是我能找到的最接近的人选。",shape=box,color=red];
		j2130035981 -> j2993791727;
	j2087717673 [label="我……不知道还能问你什么？",shape=box,color=red];
		j2087717673 -> j908393289;
	j1874316490 [label="有人提醒我，你看待事物的方式可能和我们不一样。但我认为，你或许能看到别人看不到的真相。",shape=box,color=red];
		j1874316490 -> j1128870945;
	j1460992770 [label="嗯。你不介意和疯子、精神病患者混在一起吗？真奇怪。不过你似乎也和会说话的动物以及……来自异时代的生物为伍。我想我和其他那些家伙一样，也算不上什么怪胎吧。",shape=box,color=blue];
		j1460992770 -> j2845885253;
	j2993791727 [label="看来你真是找不到什么明智的选择，竟然想从一个疯子和神经病患者那里寻求“中立”的意见。我实在不明白你为什么还要跟我说话。",shape=box,color=blue];
		j2993791727 -> j2845885253;
	j908393289 [label="你为什么非要跟我说话？你知道，这根本没必要。如果你想和玛丽交朋友——甚至追求她——我既不是她的监护人，也不是她的父亲。至于你对那个混蛋罗瑟有什么企图，我根本不在乎，我只关心他欠我的那些答案。",shape=box,color=blue];
		j908393289 -> j2845885253;
	j1128870945 [label="“真相。”我真希望你能明白，现在的我觉得这话有多么可笑。你不介意和疯子、精神病患者混在一起吗？真奇怪。不过你似乎也和会说话的动物以及……来自异时代的生物为伍。我想我和其他那些家伙一样，也算不上什么怪胎吧。",shape=box,color=blue];
		j1128870945 -> j2845885253;
	j2845885253 [label="Evaluate expressions",color=orange];
		j2845885253 -> j2085602256 [label="LyonFirstFlirt",color=purple];
		j2845885253 -> j2085602256 [label="DrifterLyon",color=purple];
		j2845885253 -> j178346283 [label="LyonOffer",color=purple];
		j2845885253 -> j2134106487 [label="false",color=purple];
	j2085602256 [label="拜托，别再让我们俩都陷入尴尬的境地了，好吗？我知道你找我谈话的理由。虽然我觉得受宠若惊，但也觉得这些理由虚伪得可笑。",shape=box,color=blue];
		j2085602256 -> j1522567929;
		j2085602256 -> j3897356597;
		j2085602256 -> j1888322274;
	j178346283 [label="拜托，别再跟我们俩讲你多么想“帮助”我了，好吗？我知道你是出于好意，但这种虚伪可笑的话实在令人反感。",shape=box,color=blue];
		j178346283 -> j1522567929;
		j178346283 -> j3897356597;
		j178346283 -> j1888322274;
	j2134106487 [label="拜托，别再长篇大论地跟我讲你想如何“帮助”我或者你想如何“做我的朋友”。我知道你是出于好意，但这种虚伪可笑的话实在令人反感。",shape=box,color=blue];
		j2134106487 -> j1522567929;
		j2134106487 -> j3897356597;
		j2134106487 -> j1888322274;
	j1522567929 [label="你觉得我说的话虚伪是因为你认为我言不由衷，还是因为你认为我说的关于你的事不可能是真心的？",shape=box,color=red];
		j1522567929 -> j711914658;
	j3897356597 [label="神父，我只想知道英择谛冒充主教的时间有多长。仅此而已。",shape=box,color=red];
		j3897356597 -> j1193844504;
	j1888322274 [label="你说的“虚伪”是什么意思？你是在说我撒谎吗？",shape=box,color=red];
		j1888322274 -> j5625625;
	j711914658 [label="都不是。你的话如同施舍，对我来说既不需要也不想要。",shape=box,color=blue];
		j711914658 -> j390900459;
		j711914658 -> j3981034694;
	j1193844504 [label="对了。三年两个月零十一天，他担任我们教堂的星期日主教。在那段时间里，我和玛丽一直侍奉着他，却对他为我们所做的安排一无所知。",shape=box,color=blue];
		j1193844504 -> j1084473418;
	j5625625 [label="Evaluate expressions",color=orange];
		j5625625 -> j1672209570 [label="DrifterLiar",color=purple];
		j5625625 -> j4001590746 [label="LyonSuspicious",color=purple];
		j5625625 -> j2541748629 [label="false",color=purple];
	j390900459 [label="玛丽是怎么忍受你的……？",shape=box,color=red];
		j390900459 -> j3647395014;
	j3981034694 [label="你认为选择与你交往的人都是在施舍吗？",shape=box,color=red];
		j3981034694 -> j938091793;
	j1084473418 [label="在你开口之前，我就知道你想问什么了。他究竟在密谋什么？他是否像我听说的对霍瓦尼亚那样，也感染了这座城市？他的计划是什么？他发现了什么？",shape=box,color=blue];
		j1084473418 -> j2355073138;
	j1672209570 [label="漂泊者，你有什么想要坦白的吗？你有什么想要赎罪的吗？",shape=box,color=blue];
		j1672209570 -> j97466585;
	j4001590746 [label="嗯。不是。或许还没到那个时候。",shape=box,color=blue];
		j4001590746 -> j2541748629;
	j2541748629 [label="你的虚伪并非因为说谎，而是因为施舍。我不需要也不想要这样的施舍。",shape=box,color=blue];
		j2541748629 -> j390900459;
		j2541748629 -> j3981034694;
	j3647395014 [label="最好你自己去问她。我也常常有同样的疑问。",shape=box,color=blue];
		j3647395014 -> "Chat ends.";
	j938091793 [label="简单来说？是的。",shape=box,color=blue];
		j938091793 -> j3994772085;
	j2355073138 [label="这些问题的答案，会让你们会失望的。在那三年两个月零十一天里，他只是传道、学习、休息、祷告。",shape=box,color=blue];
		j2355073138 -> j3548445049;
		j2355073138 -> j1049414745;
		j2355073138 -> j4224919664;
	j97466585 [label="这无关紧要。你这次来谈话并非为了寻求原谅，你过去的谎言也与你现在的虚伪并非同一回事。",shape=box,color=blue];
		j97466585 -> j4007269821;
	j3994772085 [label="Boolean LyonHate1 is now true.",color=orange];
		j3994772085 -> j2294440686;
		j3994772085 -> j4094206744;
		j3994772085 -> j2760858044;
	j3548445049 [label="他什么时候把你变成原型战甲的？",shape=box,color=red];
		j3548445049 -> j46750204;
	j1049414745 [label="我很难想象英择谛祈祷的样子。",shape=box,color=red];
		j1049414745 -> j2943077674;
	j4224919664 [label="所以他……是在休假？！",shape=box,color=red];
		j4224919664 -> j3712647835;
	j4007269821 [label="你现在所说的不过是施舍而已。我不需要也不想要这样的施舍。",shape=box,color=blue];
		j4007269821 -> j390900459;
		j4007269821 -> j3981034694;
	j2294440686 [label="这个话题以后再说——我感觉这个谈话正在逐渐失控。",shape=box,color=red];
		j2294440686 -> j3503423428;
	j4094206744 [label="那玛丽呢……？",shape=box,color=red];
		j4094206744 -> j1228376015;
	j2760858044 [label="你一定非常看轻自己。",shape=box,color=red];
		j2760858044 -> j1329338139;
	j46750204 [label="三年又几天后，他在一场可怕的风暴中消失了。这场风暴和他出现时的风暴一模一样。",shape=box,color=blue];
		j46750204 -> j3307858394;
	j2943077674 [label="我们不可能了解别人的内心世界。他跪在祭坛前，低着头。他是在祈祷吗？还是只是沉浸在自己的思绪中？我不知道。",shape=box,color=blue];
		j2943077674 -> j46750204;
	j3712647835 [label="+5 Chemistry",color=orange];
		j3712647835 -> j2615278727;
	j3503423428 [label="+5 Chemistry",color=orange];
		j3503423428 -> j3283200758;
	j1228376015 [label="如果玛丽认为这样做能给这头疯熊带来片刻安宁，她甚至会把疯熊抱在怀里，任由它撕开自己的喉咙。",shape=box,color=blue];
		j1228376015 -> j2564854743;
	j1329338139 [label="我认为这是一种对实用主义的坚定不移的坚持，但你可以随意定义它。",shape=box,color=blue];
		j1329338139 -> j1088019874;
	j3307858394 [label="Evaluate expressions",color=orange];
		j3307858394 -> j3600561722 [label="MarieLyonVisions",color=purple];
		j3307858394 -> j3600561722 [label="LyonVisions1",color=purple];
		j3307858394 -> j797422906 [label="false",color=purple];
	j2615278727 [label="呵呵。我之前没这么想过，不过——或许他真是这样。这对你们其他人来说真是太气人了。这似乎也符合我们对他真实面目的些许了解。",shape=box,color=blue];
		j2615278727 -> j46750204;
	j3283200758 [label="这或许是个明智的决定。你问的是“星期日主教”及其在教堂的任期。",shape=box,color=blue];
		j3283200758 -> j1435968233;
	j2564854743 [label="她拥有独一无二的美丽灵魂，我会守护她直到生命的最后一刻。",shape=box,color=blue];
		j2564854743 -> j1088019874;
	j1088019874 [label="+5 Chemistry",color=orange];
		j1088019874 -> j1533334514;
	j3600561722 [label="虽然我知道其他人可能没有感受到这场风暴，但我却真切地感受到了它。",shape=box,color=blue];
		j3600561722 -> j797422906;
	j797422906 [label="一年后的同一天，他最后一次出现，而……罗瑟，正如你现在看到的样子，倒在他脚下，昏迷不醒。",shape=box,color=blue];
		j797422906 -> j3058926673;
	j1435968233 [label="三年两个月零十一天，他担任我们教堂的星期日主教。在那段时间里，我和玛丽一直侍奉着他，却对他为我们所做的安排一无所知。",shape=box,color=blue];
		j1435968233 -> j1084473418;
	j1533334514 [label="但你必须预料到这种情况，问一个疯子一个简单的问题，往往会引出很多无关紧要的话题。请允许我把话题拉回到你最初的主题，而不是我自己的。",shape=box,color=blue];
		j1533334514 -> j1435968233;
	j3058926673 [label="他简直就是恶魔的化身，至少看起来是这样。就在那时，英择谛告诉我们他的真实身份——他来自哪个时代——以及托付我们的真正任务。",shape=box,color=blue];
		j3058926673 -> j2985165968;
	j2985165968 [label="他选中我们俩去执行一项“神圣的使命”。",shape=box,color=blue];
		j2985165968 -> j534091382;
		j2985165968 -> j24046514;
	j534091382 [label="为什么要加引号？",shape=box,color=red];
		j534091382 -> j1307712182;
	j24046514 [label="听起来你并不相信他。",shape=box,color=red];
		j24046514 -> j1307712182;
	j1307712182 [label="我知道的事越多，就越让我怀疑英择谛是不是真的承认任何自然或任何神灵的神圣信仰……如果真有这种东西存在的话……",shape=box,color=blue];
		j1307712182 -> j1164089340;
		j1307712182 -> j96232932;
	j1164089340 [label="如果​真有​这​种​东西​存在​的话？​里昂，​你​这​话​是​什么​意思？​",shape=box,color=red];
		j1164089340 -> j3516235948;
	j96232932 [label="请继续说。",shape=box,color=red];
		j96232932 -> j3727501290;
	j3516235948 [label="Boolean LyonFaith2 is now true.",color=orange];
		j3516235948 -> j3445237398;
	j3727501290 [label="玛丽欣然接受了血清。当然，她会接受的。她怎么可能不接受呢？而我又怎能不跟随她呢？我又怎能不去追寻真相，无论真相会将我引向何方呢？",shape=box,color=blue];
		j3727501290 -> j1813802388;
	j3445237398 [label="此事留待日后再说。",shape=box,color=blue];
		j3445237398 -> j3727501290;
	j1813802388 [label="Boolean LyonSerum1 is now true.",color=orange];
		j1813802388 -> j1866497953;
		j1813802388 -> j2608854145;
		j1813802388 -> j3974964152;
	j1866497953 [label="我觉得她对英择谛的崇拜还是有点过头了。",shape=box,color=red];
		j1866497953 -> j2632145969;
	j2608854145 [label="之后发生了什么？",shape=box,color=red];
		j2608854145 -> j3428866558;
	j3974964152 [label="你后悔吗？",shape=box,color=red];
		j3974964152 -> j2511877039;
	j2632145969 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j2632145969 -> j2649791464;
	j3428866558 [label="罗瑟醒了过来。起初，他几乎记不起自己的名字。英择谛临别前对这个混蛋说了一句话：“Uriel，Xata 的异端者，在放逐中，作出回答吧——奥罗金能否得到宽恕？”",shape=box,color=blue];
		j3428866558 -> j808213190;
	j2511877039 [label="漂泊者，我对一切都感到后悔。是的，我当然后悔。但我还会再做一次吗？答案是，我当然会。我不能让玛丽一个人待着。",shape=box,color=blue];
		j2511877039 -> j3670139298;
	j2649791464 [label="在这点上，我们意见一致。但我也不能因此责怪她。给她点时间，她会想明白的。她非常聪明，漂泊者。别把她当傻瓜。",shape=box,color=blue];
		j2649791464 -> j3670139298;
	j808213190 [label="英择谛就此永远地离开了。他把罗瑟留给了我们，而我和玛丽如今已焕然一新，变成了你们现在看到的样子——更有能力对抗那喜怒无常的恶魔。",shape=box,color=blue];
		j808213190 -> j2008329184;
	j3670139298 [label="故事到此结束……英择谛就此永远地离开了。他把罗瑟留给了我们，而罗瑟如今已焕然一新，变成了你们现在看到的样子——更有能力对抗那喜怒无常的魔鬼。",shape=box,color=blue];
		j3670139298 -> j2008329184;
	j2008329184 [label="恐怕剩下的故事只能以后再讲了。洛德先生需要使用石榴 2 代电脑，而我急着把它交还给他。希望这至少能解答你的一些疑问。",shape=box,color=blue];
		j2008329184 -> j3312940823;
		j2008329184 -> j3634404004;
	j3312940823 [label="也带来了更多的疑惑。",shape=box,color=red];
		j3312940823 -> j1894728411;
	j3634404004 [label="有解答到，谢谢你。",shape=box,color=red];
		j3634404004 -> j3049545239;
	j1894728411 [label="+15 Chemistry",color=orange];
		j1894728411 -> j808081647;
	j3049545239 [label="+10 Chemistry",color=orange];
		j3049545239 -> j1546536903;
	j808081647 [label="那么，我已尽到神父的职责。我祝你晚安。",shape=box,color=blue];
		j808081647 -> j82610256;
	j1546536903 [label="那么，我就祝你晚安了。",shape=box,color=blue];
		j1546536903 -> j82610256;
	j82610256 [label="——里昂·阿拉德神父",shape=box,color=blue];
		j82610256 -> "Chat ends.";
}