digraph {
	"LyonRank3Convo1 begins." [color=orange];
		"LyonRank3Convo1 begins." -> j1171531539;
	j1171531539 [label="漂泊者，你好。",shape=box,color=blue];
		j1171531539 -> j3714942516;
	j3714942516 [label="我听说你想和我谈谈。",shape=box,color=blue];
		j3714942516 -> j760279151;
		j3714942516 -> j890598536;
		j3714942516 -> j931984873;
	j760279151 [label="里昂，很高兴能在这里和你交谈——谢谢你。",shape=box,color=red];
		j760279151 -> j1353561220;
	j890598536 [label="玛丽终于说服你我不会构成威胁了吗？",shape=box,color=red];
		j890598536 -> j3735449566;
	j931984873 [label="哦！里昂，你好。说实话，我真没想到你会来找我。很高兴你改变了主意。",shape=box,color=red];
		j931984873 -> j1050628163;
	j1353561220 [label="你​最终​或许会​后​悔​自己​当初​那么​急于​求成，​不过​没​关系，​不​用​客气。​",shape=box,color=blue];
		j1353561220 -> j257888766;
		j1353561220 -> j980030902;
	j3735449566 [label="不要让我这么快就找到改变主意的理由。",shape=box,color=blue];
		j3735449566 -> j1933300832;
	j1050628163 [label="是的。不过，等一切尘埃落定之后，你可能就不会那么高兴了。",shape=box,color=blue];
		j1050628163 -> j257888766;
		j1050628163 -> j980030902;
	j257888766 [label="从其他人的描述来看，我了解到你有一些事情需要和我讨论。有什么我可以帮忙的吗？",shape=box,color=red];
		j257888766 -> j3281699863;
	j980030902 [label="你怎么了？",shape=box,color=red];
		j980030902 -> j3922493051;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j3281699863 [label="或许以后再说吧。我们才刚刚开始交谈而已。我来这里只是想告诉你，我屈服于玛丽的坚持，她说在谈话方面你是值得信任的。",shape=box,color=blue];
		j3281699863 -> j2777944732;
	j3922493051 [label="这个问题未免太荒谬了，我甚至懒得回答，我们才刚刚开始交谈而已。我来这里只是想告诉你，我屈服于玛丽的坚持，她说在谈话方面你是值得信任的。",shape=box,color=blue];
		j3922493051 -> j2777944732;
	"Chat ends." [color=orange];
	j2777944732 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j2777944732 -> j1234177536 [label="x > 0",color=purple];
		j2777944732 -> j766903152 [label="x <= 0",color=purple];
		j2777944732 -> j766903152 [label="false",color=purple];
	j1234177536 [label="既然我们现在共同参与了罗瑟“铁了心”要推进的这件事，那么我们最好还是互相认识一下。看来你也更喜欢这种方式。所以，我来了。",shape=box,color=blue];
		j1234177536 -> j1910117489;
		j1234177536 -> j3903396821;
	j766903152 [label="鉴于我们可能要永远参与罗瑟“铁了心”要推进的这件事，那么我们最好还是互相认识一下。看来你也更喜欢这种方式。所以，我来了。",shape=box,color=blue];
		j766903152 -> j1910117489;
		j766903152 -> j3903396821;
	j1910117489 [label="我感觉自己好像一开始就做错了。",shape=box,color=red];
		j1910117489 -> j935276277;
	j3903396821 [label="那……你有更喜欢的方式吗？",shape=box,color=red];
		j3903396821 -> j2302751862;
	j935276277 [label="不，你没有。只是我可能不是你习惯与之交谈的那种人而已。就这一点而言，你至今为止已经很幸运了，毕竟像我这样的疯子实属罕见。",shape=box,color=blue];
		j935276277 -> j2126602571;
	j2302751862 [label="不，这样很好。事实上，这样给了我时间按照自己的想法整理思路。我能理解为什么这种设备会让人着迷。",shape=box,color=blue];
		j2302751862 -> j3994551543;
	j2126602571 [label="话说回来，恐怕我不会在这里花太多时间“打字”，这大概会让你失望。我只是想告诉你我已经投降了。",shape=box,color=blue];
		j2126602571 -> j968280041;
		j2126602571 -> j1529935551;
	j3994551543 [label="然而，恐怕我不会在这里花太多时间“打字”，这大概会让你失望。我只是想告诉你我已经投降了。",shape=box,color=blue];
		j3994551543 -> j1529935551;
		j3994551543 -> j968280041;
	j968280041 [label="玛丽比她看起来更危险，不是吗？",shape=box,color=red];
		j968280041 -> j219413691;
	j1529935551 [label="那我再次，对你说声谢谢。",shape=box,color=red];
		j1529935551 -> j3139061955;
	j219413691 [label="+20 Chemistry",color=orange];
		j219413691 -> j217423131;
	j3139061955 [label="+15 Chemistry",color=orange];
		j3139061955 -> j2502325133;
	j217423131 [label="你才刚刚开始察觉到这片水有多深。",shape=box,color=blue];
		j217423131 -> j82610256;
	j2502325133 [label="无论如何，不客气。",shape=box,color=blue];
		j2502325133 -> j82610256;
	j82610256 [label="——里昂·阿拉德神父",shape=box,color=blue];
		j82610256 -> "Chat ends.";
