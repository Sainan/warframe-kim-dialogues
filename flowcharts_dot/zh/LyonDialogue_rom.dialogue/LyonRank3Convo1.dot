digraph {
	0 [label="LyonRank3Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="漂泊者，你好。",shape=box,color=blue];
		1 -> 2;
	2 [label="我听说你想和我谈谈。",shape=box,color=blue];
		2 -> 3;
		2 -> 4;
		2 -> 5;
	3 [label="里昂，很高兴在这里和你交谈——谢谢你。",shape=box,color=red];
		3 -> 6;
	4 [label="玛丽终于说服你我不会构成威胁了吗？",shape=box,color=red];
		4 -> 7;
	5 [label="哦！里昂，你好。说实话，我真没想到你会改变主意。很高兴你改变了主意。",shape=box,color=red];
		5 -> 8;
	6 [label="你​最终​或许会​后​悔​自己​当初​那么​急于​求成，​不过​没​关系，​不​用​客气。​",shape=box,color=blue];
		6 -> 9;
		6 -> 10;
	7 [label="不要让我这么快找到改变主意的理由。",shape=box,color=blue];
		7 -> 11;
	8 [label="是的。不过，等一切尘埃落定之后，你可能就不会那么高兴了。",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
	9 [label="从其他人的描述来看，我了解到你有一些事情需要和我讨论。有什么我可以帮忙的吗？",shape=box,color=red];
		9 -> 12;
	10 [label="你怎么了？",shape=box,color=red];
		10 -> 13;
	11 [label="+10 Chemistry",color=orange];
		11 -> 14;
	12 [label="或许以后再说吧。我们才刚刚开始交谈而已。我来这里只是想告诉你，我屈服于玛丽的坚持，她说在谈话方面你是值得信任的。",shape=box,color=blue];
		12 -> 15;
	13 [label="这个问题未免太荒谬了，我甚至懒得回答，我们才刚刚开始交谈而已。我来这里只是想告诉你，我屈服于玛丽的坚持，她说在谈话方面你是值得信任的。",shape=box,color=blue];
		13 -> 15;
	14 [label="Chat ends.",color=orange];
	15 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		15 -> 16 [label="x > 0",color=purple];
		15 -> 17 [label="x <= 0",color=purple];
		15 -> 17 [label="false",color=purple];
	16 [label="既然我们现在共同参与了罗瑟“铁了心”要推进的这件事，那么我们最好还是互相认识一下。看来你也更喜欢这种方式。所以，我来了。",shape=box,color=blue];
		16 -> 18;
		16 -> 19;
	17 [label="鉴于我们可能要永远参与罗瑟“铁了心”要推进的这件事，那么我们最好还是互相认识一下。看来你也更喜欢这种方式。所以，我来了。",shape=box,color=blue];
		17 -> 18;
		17 -> 19;
	18 [label="我感觉自己好像一开始就做错了。",shape=box,color=red];
		18 -> 20;
	19 [label="那……你有更喜欢的方式吗？",shape=box,color=red];
		19 -> 21;
	20 [label="不，你没有。只是我可能不是你习惯与之交谈的那种人而已。就这一点而言，你至今为止已经很幸运了，毕竟像我这样的疯子实属罕见。",shape=box,color=blue];
		20 -> 22;
	21 [label="不，这样很好。事实上，这样给了我时间按照自己的想法整理思路。我能理解为什么这种设备会让人着迷。",shape=box,color=blue];
		21 -> 23;
	22 [label="话说回来，恐怕我不会在这里花太多时间“打字”，这大概会让你失望。我只是想告诉你我已经投降了。",shape=box,color=blue];
		22 -> 24;
		22 -> 25;
	23 [label="然而，恐怕我不会在这里花太多时间“打字”，这大概会让你失望。我只是想告诉你我已经投降了。",shape=box,color=blue];
		23 -> 25;
		23 -> 24;
	24 [label="玛丽比她看起来更危险，不是吗？",shape=box,color=red];
		24 -> 26;
	25 [label="那我再次，对你说声谢谢。",shape=box,color=red];
		25 -> 27;
	26 [label="+20 Chemistry",color=orange];
		26 -> 28;
	27 [label="+15 Chemistry",color=orange];
		27 -> 29;
	28 [label="你才刚刚开始察觉到这片水有多深。",shape=box,color=blue];
		28 -> 30;
	29 [label="无论如何，不客气。",shape=box,color=blue];
		29 -> 30;
	30 [label="——里昂·阿拉德神父",shape=box,color=blue];
		30 -> 31;
	31 [label="Chat ends.",color=orange];
}