digraph {
	1485 [label="LyonRank5Convo2 begins.",color=orange];
		1485 -> 1486;
	1486 [label="Evaluate expressions",color=orange];
		1486 -> 1487 [label="LyonPainOff",color=purple];
		1486 -> 1491 [label="LyonBackstory3a",color=purple];
		1486 -> 1490 [label="LyonBackstory3b",color=purple];
		1486 -> 1489 [label="LyonBackstory2",color=purple];
		1486 -> 1489 [label="LyonBackstory1",color=purple];
		1486 -> 1488 [label="false",color=purple];
	1487 [label="+20 Chemistry",color=orange];
		1487 -> 490;
	1491 [label="我的朋友，你一直对我非常耐心，也给了我不配得到的善意。我知道你一定也对我的故事的这一部分感到好奇——关于月黑风高的那个夜晚。",shape=box,color=blue];
		1491 -> 1493;
	1490 [label="我的朋友，你一直对我非常耐心。我知道你一定也对我的故事的这一部分感到好奇——关于月黑风高的那个夜晚。",shape=box,color=blue];
		1490 -> 1493;
	1489 [label="我的朋友，你一直对我的过去感到好奇。我知道你一定也对我的故事的这一部分感到好奇——关于月黑风高的那个夜晚。",shape=box,color=blue];
		1489 -> 1493;
	1488 [label="我的朋友，我知道你听了我的故事后一定很想知道，也想知道月黑风高的那个夜晚。",shape=box,color=blue];
		1488 -> 1493;
	490 [label="[由于之前设置的触发警告，对话已跳过]",shape=box,color=blue];
		490 -> 1492;
	1493 [label="我曾发誓永远不会说出这个故事。只有玛丽知道，因为她从我的日记里读到过。而现在，我要把它写在这里，告诉你。",shape=box,color=blue];
		1493 -> 1495;
	1492 [label="Update boolean LyonConfession1",color=orange];
		1492 -> 1494;
	1495 [label="一旦我开始，就无法停止，因为我无法重新开始。所以，如果我不允许你问我问题，请你原谅。",shape=box,color=blue];
		1495 -> 1499;
		1495 -> 1498;
		1495 -> 1497;
		1495 -> 1496;
	1494 [label="Chat ends.",color=orange];
	1499 [label="当然。",shape=box,color=red];
		1499 -> 1503;
	1498 [label="[让他继续]",shape=box,color=red];
		1498 -> 1502;
	1497 [label="[警告：文中提及虐童内容。点击此处结束。你不会因此失去里昂好感度。]",shape=box,color=red];
		1497 -> 1501;
	1496 [label="[结束]",shape=box,color=red];
		1496 -> 1500;
	1503 [label="谢谢你。",shape=box,color=blue];
		1503 -> 1507;
	1502 [label="+5 Chemistry",color=orange];
		1502 -> 1503;
	1501 [label="Check boolean LyonSpeech",color=orange];
		1501 -> 1505 [label=true,color=green];
		1501 -> 1506 [label=false,color=brown];
	1500 [label="Update boolean LyonConfessionFail",color=orange];
		1500 -> 1504;
	1507 [label="Evaluate expressions",color=orange];
		1507 -> 1511 [label="LyonBackstory3a",color=purple];
		1507 -> 1511 [label="LyonBackstory3b",color=purple];
		1507 -> 1510 [label="false",color=purple];
	1505 [label="+20 Chemistry",color=orange];
		1505 -> 1508;
	1506 [label="如果你因此觉得自己是个懦夫，那么我恳求你——不要这样想。因为这痛苦不该由你承受，而是由我承受。这一切并不是你自己选择承受的。",shape=box,color=blue];
		1506 -> 1509;
	1504 [label="Chat ends.",color=orange];
	1511 [label="我们谈起了我的家人，谈起了我在农场长大的时光，谈起了那些一直困扰着我、驱使我走向暴力的异象。",shape=box,color=blue];
		1511 -> 1515;
	1510 [label="我知道我很少跟你们提起养育我的人。其实这是有原因的。",shape=box,color=blue];
		1510 -> 1514;
	1508 [label="Update boolean LyonConfession1",color=orange];
		1508 -> 1512;
	1509 [label="我们用的这台机械装置给人一种冷漠疏离的感觉。仿佛我们被某种方式保护起来，免受他人通过它敲出的文字可能造成的伤害。",shape=box,color=blue];
		1509 -> 1513;
	1515 [label="我跟你说过我听到的声音，它们从其他房间里传来，低声对我说话，呼唤我。有时，它们听起来就像在叫我的名字——",shape=box,color=blue];
		1515 -> 1518;
	1514 [label="我的母亲……把我的异象视为魔鬼的伎俩，并尝试用鞭子抽打我，让我无法再看到它们。她常常把我打得连站都站不稳。",shape=box,color=blue];
		1514 -> 1517;
	1512 [label="Chat ends.",color=orange];
	1513 [label="我反而认为恰恰相反——当我们卸下在日常社交互动中穿戴的盔甲时，我们就失去了那些可以用来保护我们的东西。",shape=box,color=blue];
		1513 -> 1516;
	1518 [label="有时，它们听起来什么都不是。全是含糊不清的胡言乱语，或是魔鬼的语言。",shape=box,color=blue];
		1518 -> 1521;
	1517 [label="至于我父亲？唉。尽管我母亲已经够残忍了，但我父亲更甚。细节我就不赘述了。",shape=box,color=blue];
		1517 -> 1520;
	1516 [label="因此，在类似情况下……我深知我射出的箭可能射中的不是准备战斗的士兵，而是树林里毫无防备的鹿。",shape=box,color=blue];
		1516 -> 1519;
	1521 [label="起初，那些语无伦次的胡言乱语让我感到恐惧。我祈求它们能有意义。我向月神祈祷，希望她的灵能告诉我它们想要我做什么。",shape=box,color=blue];
		1521 -> 1524;
	1520 [label="但我也反抗了他们的暴力。我的异象常常让我难以对付——尤其是我长大成人后，身形甚至比我的父亲还要高大强壮。",shape=box,color=blue];
		1520 -> 1523;
	1519 [label="因此，我最后要告诉你的是：",shape=box,color=blue];
		1519 -> 1522;
	1524 [label="但当我开始弄明白它们的意图时，我对自己曾经如此拼命祈祷的事感到后悔。因为现在，我知道了它们要求我以它们的名义去做的那些事。",shape=box,color=blue];
		1524 -> 1526;
	1523 [label="这些异象常常以声音的形式出现。有时，它们听起来像是在呼唤我的名字——",shape=box,color=blue];
		1523 -> 1518;
	1522 [label="我们必须时刻提醒自己，即使我们自己没有勇气站起来，也要有力量去帮助别人站起来。",shape=box,color=blue];
		1522 -> 1525;
	1526 [label="哦，他们为此付出了非常惨痛的代价。",shape=box,color=blue];
		1526 -> 1528;
	1525 [label="这就是故事的真正目的。",shape=box,color=blue];
		1525 -> 1527;
	1528 [label="别误会我的意思。我对我的父亲和母亲都没有爱。我对他们可能曾经有过的一点亲情，也早已被无数的伤痕和淤青掩盖殆尽。",shape=box,color=blue];
		1528 -> 1530;
	1527 [label="+20 Chemistry",color=orange];
		1527 -> 1529;
	1530 [label="但它们呼唤我为它们做什么……？在那最黑暗的夜晚，它们又强迫我做了什么……？",shape=box,color=blue];
		1530 -> 1532;
	1529 [label="漂泊者，保重。我们很快会再联系。",shape=box,color=blue];
		1529 -> 1531;
	1532 [label="我当时还是只个男孩——甚至算不上一个男人。也许我十六岁？十八岁？起初，我以为这一切都只是另一场可怕的噩梦——一场扭曲的梦。",shape=box,color=blue];
		1532 -> 1534;
	1531 [label="——里昂·阿拉德神父",shape=box,color=blue];
		1531 -> 1533;
	1534 [label="我周围站着一些身影，面容憔悴扭曲，完全由恶意和阴影构成。",shape=box,color=blue];
		1534 -> 1536;
	1533 [label="Update boolean LyonConfession1",color=orange];
		1533 -> 1535;
	1536 [label="他们嘲笑我，逼迫我去做必须做的事——如果那些声称爱我的人想要我的肉体……那么，我反过来也必须拥有他们的肉体……",shape=box,color=blue];
		1536 -> 1537;
	1535 [label="Chat ends.",color=orange];
	1537 [label="当我从噩梦中醒来时——或许我一直都醒着，我也不确定——我手里拿着一把猎刀。我站在父母房间的门口。",shape=box,color=blue];
		1537 -> 1538;
	1538 [label="月亮是新月，乌云密布，一丝光线都看不见，一片漆黑。 ",shape=box,color=blue];
		1538 -> 1539;
	1539 [label="月神抛弃了我。",shape=box,color=blue];
		1539 -> 1540;
	1540 [label="我无法回应那些声音的召唤。我无法将我父母的灵魂交给他们。",shape=box,color=blue];
		1540 -> 1541;
	1541 [label="我逃进了空旷的夜色中，逃进了幽深的森林，树枝刮伤了我裸露的皮肤，但我对疼痛毫不在意。",shape=box,color=blue];
		1541 -> 1542;
	1542 [label="我一路狂奔，直到双腿再也支撑不住，再也跑不动了。我当时可能在哭泣，我不知道。",shape=box,color=blue];
		1542 -> 1543;
	1543 [label="但那些情感具化还是跟过来了。而且，它们仍然低声渴望鲜血。",shape=box,color=blue];
		1543 -> 1544;
	1544 [label="我当时想，如果我看不见它们，它们或许就会消失……就在这时，我把刀子刺进了我的眼眶……",shape=box,color=blue];
		1544 -> 1545;
	1545 [label="真可惜我当时昏过去了，不知道后来发生了什么。现在，我永远也无法知道了。",shape=box,color=blue];
		1545 -> 1546;
	1546 [label="我醒来时，发现自己身处当地的月神教堂。一位弟兄找到了我，并为我包扎了伤口。他问我，我一直在逃避什么。",shape=box,color=blue];
		1546 -> 1547;
	1547 [label="我当时情绪极度激动，无法对他撒谎。我把一切都告诉了他——那些异象，以及它们指示我去做的事情。我以为自己会受到谴责。",shape=box,color=blue];
		1547 -> 1548;
	1548 [label="说完后，他只是带着一种洞悉一切的悲伤微笑，然后将一枚月神的护身符放在我的掌心。“我的孩子，她既是福也是祸”",shape=box,color=blue];
		1548 -> 1549;
	1549 [label="他把我送到光城的教堂。我就一直待在那里，直到英择谛找到我……",shape=box,color=blue];
		1549 -> 1550;
	1550 [label="就这样……现在你明白了。",shape=box,color=blue];
		1550 -> 1551;
	1551 [label="好了……我现在必须走了。",shape=box,color=blue];
		1551 -> 1552;
	1552 [label="Update boolean LyonConfession1",color=orange];
		1552 -> 1553;
	1553 [label="+20 Chemistry",color=orange];
		1553 -> 1554;
	1554 [label="——里昂",shape=box,color=blue];
		1554 -> 1555;
	1555 [label="Chat ends.",color=orange];
}