digraph {
	"LyonRank3Convo5 begins." [color=orange];
		"LyonRank3Convo5 begins." -> j1537355588;
	j1537355588 [label="“星期日主教”来到我们这里的那晚，正值雷雨交加。他站在教堂的圣殿里，丝毫没有受到外面狂风暴雨的影响。",shape=box,color=blue];
		j1537355588 -> j1700783042;
	j1700783042 [label="我本应首先为此感到担忧。然而，我却向他低头致意，像迎接圣母派来的一位新使者一样向他问好。",shape=box,color=blue];
		j1700783042 -> j2151073929;
	j2151073929 [label="毕竟，自从上一任主教几个月前因病离职后，我们就一直在期待一位新主教到来。",shape=box,color=blue];
		j2151073929 -> j1490529703;
	j1490529703 [label="星期日主教热情地和我握手，脸上带着温暖的笑容。我问他旅途是否漫长。他的回答我永远不会忘记。",shape=box,color=blue];
		j1490529703 -> j4120363504;
	j4120363504 [label="“虽然很艰难……但时间并不长。”",shape=box,color=blue];
		j4120363504 -> j3089647732;
	j3089647732 [label="当时我感到很困惑，还有他那件干透的大衣也让我百思不得其解。但我没太在意，就像所有人遇到不寻常的事情时都会做的那样。",shape=box,color=blue];
		j3089647732 -> j2080514330;
	j2080514330 [label="我还没来得及细想，玛丽就急切地赶来了。",shape=box,color=blue];
		j2080514330 -> j2989879356;
	j2989879356 [label="他单膝跪地，与坐在椅子上的她平视，握住了她的手。我当时就应该看穿他的伎俩。",shape=box,color=blue];
		j2989879356 -> j1725578279;
	j1725578279 [label="毕竟，他并不是唯一一个在暴风雨中来到我们家门口的恶魔。",shape=box,color=blue];
		j1725578279 -> j1928339452;
	j1928339452 [label="Boolean LyonEntrati1 is now true.",color=orange];
		j1928339452 -> j2100050873;
	j2100050873 [label="Check boolean MarieEntrati1",color=orange];
		j2100050873 -> j3457889121 [label=true,color=green];
		j2100050873 -> j3084563332 [label=true,color=green];
		j2100050873 -> j1322243627 [label=true,color=green];
		j2100050873 -> j4289730779 [label=false,color=brown];
		j2100050873 -> j3457889121 [label=false,color=brown];
	j3457889121 [label="另一个恶魔是罗瑟吗？",shape=box,color=red];
		j3457889121 -> j511742609;
	j3084563332 [label="她口中的这个故事完全不一样。",shape=box,color=red];
		j3084563332 -> j2679358313;
	j1322243627 [label="她仍然相信他的本意是好的。你相信吗？",shape=box,color=red];
		j1322243627 -> j3490527464;
	j4289730779 [label="看来你不是英择谛的盟友？",shape=box,color=red];
		j4289730779 -> j44777226;
	j511742609 [label="是的。不过那是另一个故事了。如果我开始谈论他，我原本就糟糕的心情会变得更加…… ",shape=box,color=blue];
		j511742609 -> j3536432566;
	j2679358313 [label="是​啊，​如果​是​她​她​会​说​得​不​一样。​",shape=box,color=blue];
		j2679358313 -> j2601760268;
		j2679358313 -> j3667519789;
	j3490527464 [label="+5 Chemistry",color=orange];
		j3490527464 -> j3995139948;
	j44777226 [label="在忍受了他的谎言和背叛之后，在我们继续承受他对玛丽的操纵之苦时，你以为我屈服吗？不，我绝对不会。",shape=box,color=blue];
		j44777226 -> j3217445092;
	j3536432566 [label="……一发不可收拾。如果你不介意的话，我更愿意把注意力集中在英择谛的恶行上。",shape=box,color=blue];
		j3536432566 -> j1428371468;
	j2601760268 [label="她告诉我，有时候你能看到别人看不到的东西。",shape=box,color=red];
		j2601760268 -> j2141654297;
	j3667519789 [label="然后呢？",shape=box,color=red];
		j3667519789 -> j3742184677;
	j3995139948 [label="玛丽​相信​每​个​人​心​中​都​有​善良​的​一面。​这​是​她​不断​磨练、​完善​的​能力，​以​此​作为​抵御​周围​世界​的​盾。​",shape=box,color=blue];
		j3995139948 -> j2485558308;
		j3995139948 -> j3919813540;
	j3217445092 [label="+5 Chemistry",color=orange];
		j3217445092 -> j2376168238;
	j1428371468 [label="Check boolean RoatheSerum1",color=orange];
		j1428371468 -> j3654110860 [label=true,color=green];
		j1428371468 -> j2463351137 [label=true,color=green];
		j1428371468 -> j3654110860 [label=false,color=brown];
		j1428371468 -> j2111658969 [label=false,color=brown];
	j2141654297 [label="如果这句话是真的，漂泊者，你会怎么看待这件事？",shape=box,color=blue];
		j2141654297 -> j2821822155;
	j3742184677 [label="没有​“然后”。​我​已经​把​我​亲眼​目睹​的​事件​经过​告诉​了​你，​这​就​是​我​亲身​经历​的​真实​情况。​仅此​而​已。​",shape=box,color=blue];
		j3742184677 -> j3995139948;
	j2485558308 [label="玛丽并不了解英择谛的真实能力，以及他以“进展”和现在的“救赎”之名所犯下的那些可憎行径。",shape=box,color=red];
		j2485558308 -> j3105099538;
	j3919813540 [label="玛丽是个成年人了。我理解你想保护她的心情，但她有权自己决定相信什么，以及信仰谁。",shape=box,color=red];
		j3919813540 -> j895860641;
	j2376168238 [label="玷污我们的身体，摧毁我们的未来，腐蚀我们的过去——这一切，或许我都能原谅。",shape=box,color=blue];
		j2376168238 -> j1532822305;
	j3654110860 [label="英择谛或许不擅长待人接物，但他正在努力拯救宇宙。",shape=box,color=red];
		j3654110860 -> j2376168238;
	j2463351137 [label="他​是​不​是​强迫​你​成为​像​罗瑟​那样​的​原型​战甲？​",shape=box,color=red];
		j2463351137 -> j2009324441;
	j2111658969 [label="当然。你为什么对英择谛感到不满？",shape=box,color=red];
		j2111658969 -> j3217445092;
	j2821822155 [label="Check boolean LyonVisions1",color=orange];
		j2821822155 -> j2310198722 [label=true,color=green];
		j2821822155 -> j2082260271 [label=true,color=green];
		j2821822155 -> j2507060979 [label=true,color=green];
		j2821822155 -> j2310198722 [label=false,color=brown];
		j2821822155 -> j3147445133 [label=false,color=brown];
		j2821822155 -> j2082260271 [label=false,color=brown];
	j3105099538 [label="信任就像一扇彩色玻璃窗。制作精巧，绚丽夺目；破碎时令人扼腕叹息；一旦损毁，便危机四伏。",shape=box,color=blue];
		j3105099538 -> j2720527137;
	j895860641 [label="信任就像一扇彩色玻璃窗。制作精巧，绚丽夺目；破碎时令人扼腕叹息；一旦损毁，便危机四伏。",shape=box,color=blue];
		j895860641 -> j1059310;
	j1532822305 [label="但看看他是如何扭曲玛丽的……利用她对他人善良的信念来达到自己的目的？",shape=box,color=blue];
		j1532822305 -> j3213700090;
	j2009324441 [label="不。我接受那血清自有我的理由。我知道它会把我变成非常扭曲的怪物。玛丽也知道。",shape=box,color=blue];
		j2009324441 -> j3724089368;
	j2310198722 [label="我猜我其实都不太在意吧？",shape=box,color=red];
		j2310198722 -> j3549319025;
	j2082260271 [label="我唯一的问题是，如果你能看到幻象，这些幻象会让你感到困扰吗？",shape=box,color=red];
		j2082260271 -> j429830070;
	j2507060979 [label="你​前​几​天​说​的​话​——​让​我​有点​担心​你​是否​一切​都​好。​",shape=box,color=red];
		j2507060979 -> j3947779362;
	j3147445133 [label="我只是想知道你是否一切都好。",shape=box,color=red];
		j3147445133 -> j3947779362;
	j2720527137 [label="+15 Chemistry",color=orange];
		j2720527137 -> j4223069483;
	j1059310 [label="她沐浴在在太阳温暖的光芒中，却看不见太阳表面形成的裂痕，也听不见越来越深的裂缝。",shape=box,color=blue];
		j1059310 -> j2185615087;
	j3213700090 [label="唯独这事，我永不原谅。我愿用我的香炉鞭打他，直到他乞求救赎。",shape=box,color=blue];
		j3213700090 -> j2485558308;
		j3213700090 -> j3919813540;
	j3724089368 [label="我们并非像恶魔那样……被强行摧毁。我为罗瑟所遭受的一切感到难过。",shape=box,color=blue];
		j3724089368 -> j2650715447;
	j3549319025 [label="那么，我认为没有必要继续这个话题了。",shape=box,color=blue];
		j3549319025 -> "Chat ends.";
	j429830070 [label="漂泊者，恕我直言，我不知道该如何回答这个问题。",shape=box,color=blue];
		j429830070 -> j1392402513;
	j3947779362 [label="Boolean LyonAllRight is now true.",color=orange];
		j3947779362 -> j1692607801;
	j4223069483 [label="但愿我能将他灌输到她心中的邪念驱除。我只能祈祷我做不到的事情，你能做到。",shape=box,color=blue];
		j4223069483 -> j82610256;
	j2185615087 [label="她浑然不知，自己一手打造的杰作的碎片很快就会被用来对付她。她选择对即将到来的灾难视而不见。",shape=box,color=blue];
		j2185615087 -> j1347641992;
	j2650715447 [label="直到他张嘴说话。",shape=box,color=blue];
		j2650715447 -> j2232545217;
		j2650715447 -> j2549833489;
	"Chat ends." [color=orange];
	j1392402513 [label="这么多年来，我目睹过无数恐怖景象，足以把人送进精神病院。更悲惨的是，我的异象有时会变成现实。",shape=box,color=blue];
		j1392402513 -> j4183687613;
	j1692607801 [label="我“是否​一切​都​好？”漂泊者，恕我直言，我不知道该如何回答这个问题。",shape=box,color=blue];
		j1692607801 -> j1392402513;
	j82610256 [label="——里昂·阿拉德神父",shape=box,color=blue];
		j82610256 -> "Chat ends.";
	j1347641992 [label="如果我能替她承受那份痛苦该有多好，我多么愿意将它刻进我心里。但这只属于她，也只属于她。",shape=box,color=blue];
		j1347641992 -> j339713111;
	j2232545217 [label="你要知道他成长的环境，知道那个逼着他学会生存的环境。他过去是——现在仍然是——奥罗金人。",shape=box,color=red];
		j2232545217 -> j679589140;
		j2232545217 -> j1139511085;
	j2549833489 [label="说实话，我觉得他没那么糟糕。我越来越喜欢他了。",shape=box,color=red];
		j2549833489 -> j966231161;
	j4183687613 [label="Boolean LyonVisions1 is now true.",color=orange];
		j4183687613 -> j2123184515;
	j339713111 [label="所以，漂泊者，我会尽量避免这种痛苦。 ",shape=box,color=blue];
		j339713111 -> j1473208027;
	j679589140 [label="这并不意味着他所做的是对的，但或许能帮助你学会与他妥协。",shape=box,color=red];
		j679589140 -> j3107278831;
	j1139511085 [label="他只是在做他认为自己必须做的事。",shape=box,color=red];
		j1139511085 -> j3228199085;
	j966231161 [label="如果是我我会打算去找洛德先生开点药膏治疗这种病，以免病情扩散。",shape=box,color=blue];
		j966231161 -> j2456710825;
		j966231161 -> j2688120274;
	j2123184515 [label="Boolean LyonBackstory1 is now true.",color=orange];
		j2123184515 -> j4172387200;
	j1473208027 [label="若你敢将她的善良视为渺小？",shape=box,color=blue];
		j1473208027 -> j294406785;
	j3107278831 [label="Add 1 to Thermostat counter",color=orange];
		j3107278831 -> j821424707;
	j3228199085 [label="Add -1 to Thermostat counter",color=orange];
		j3228199085 -> j1331070414;
	j2456710825 [label="恶魔总有一种独特的魅力。",shape=box,color=red];
		j2456710825 -> j1280102644;
	j2688120274 [label="别担心，我不会被他的魅力所迷惑。",shape=box,color=red];
		j2688120274 -> j2956129725;
	j4172387200 [label="因此，我当时认为这是月神的指引，是双耀神选中我来承担这份重任。至少我当时是这么认为的。这就是我想要成为神父的原因。",shape=box,color=blue];
		j4172387200 -> j2857729598;
		j4172387200 -> j1337465293;
		j4172387200 -> j995859838;
	j294406785 [label="那就愿月神怜悯你的灵魂。",shape=box,color=blue];
		j294406785 -> j82610256;
	j821424707 [label="我们的经文教导我们不要与恶魔谈判，而是要驱逐他们。但经文并没有教我们怎么应对这种情况。",shape=box,color=blue];
		j821424707 -> j4288380225;
	j1331070414 [label="或许吧。我还不能确定那家伙心中是否毫无疑虑。",shape=box,color=blue];
		j1331070414 -> j4288380225;
	j1280102644 [label="Add -1 to Thermostat counter",color=orange];
		j1280102644 -> j1419201920;
	j2956129725 [label="Add 1 to Thermostat counter",color=orange];
		j2956129725 -> j1578083192;
	j2857729598 [label="你​之前​相信​那些​幻象​来自​月​神？​现在​你​不​这么​相信​了？​",shape=box,color=red];
		j2857729598 -> j1825225808;
	j1337465293 [label="什么样的恐怖……？",shape=box,color=red];
		j1337465293 -> j2835416769;
	j995859838 [label="那你现在怎么想？",shape=box,color=red];
		j995859838 -> j406914884;
	j4288380225 [label="我们很快就会看到那个恶魔会选择走哪条路，不是吗？",shape=box,color=blue];
		j4288380225 -> j4035119830;
	j1419201920 [label="而这正是令我不安的地方。当所有人都在胡言乱语时，魔鬼却反倒能面带微笑，说出有道理的话。 ",shape=box,color=blue];
		j1419201920 -> j2991733231;
	j1578083192 [label="+20 Chemistry",color=orange];
		j1578083192 -> j3000233546;
	j1825225808 [label="由于​最近​出现​的​新​信息，​我​所​相信​的​一切​都​变得……​复杂​了。​",shape=box,color=blue];
		j1825225808 -> j406914884;
	j2835416769 [label="漂泊者，我们才刚刚开始谈论这些事。并非我不相信你亲眼目睹过最惨绝人寰的苦难，也并非我不相信你能承受我所说的苍白无力的内容。",shape=box,color=blue];
		j2835416769 -> j1231353614;
	j406914884 [label="漂泊者，坦白说，我不知道该相信什么。",shape=box,color=blue];
		j406914884 -> j2029797409;
	j4035119830 [label="——里昂·阿拉德神父",shape=box,color=blue];
		j4035119830 -> j367054140;
	j2991733231 [label="他总是在我们最不经意的时候——在我们最脆弱的时候，在我们最无助的时候，在我们最需要答案的时候——出现。",shape=box,color=blue];
		j2991733231 -> j1755012725;
		j2991733231 -> j3568307610;
	j3000233546 [label="很好。你最好别那样。我可不想费劲教训你。你看上去像是那种会还击的人。",shape=box,color=blue];
		j3000233546 -> j3345328449;
	j1231353614 [label="跟一个刚认识的人谈论这些事，然后对方再也不理我，只会让我精疲力竭。由于短期内我们似乎不得不一起工作，我最好避免这种情况发生。",shape=box,color=blue];
		j1231353614 -> j3975313332;
		j1231353614 -> j3042417276;
	j2029797409 [label="Boolean LyonFaith1 is now true.",color=orange];
		j2029797409 -> j3013869614;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
	j1755012725 [label="我能保护好自己。我保证不会让他影响我。",shape=box,color=red];
		j1755012725 -> j544522093;
	j3568307610 [label="你似乎是过来人。他给了你什么答案？",shape=box,color=red];
		j3568307610 -> j2223878934;
	j3345328449 [label="到时候我们两个打起来会是怎样的一种局面呢？",shape=box,color=blue];
		j3345328449 -> "Chat ends.";
	j3975313332 [label="如果你想等到更信任我之后再说，我能理解。",shape=box,color=red];
		j3975313332 -> j3379892796;
	j3042417276 [label="里昂，我不会离你而去。你可以相信我。",shape=box,color=red];
		j3042417276 -> j3619144228;
	j3013869614 [label="但我恐怕这是改日再谈的事了。",shape=box,color=blue];
		j3013869614 -> j1828723774;
	j544522093 [label="+20 Chemistry",color=orange];
		j544522093 -> j834062339;
	j2223878934 [label="我担心这些答案……已经让很多事情变得扑朔迷离。但我恐怕这一切都只能留待以后再谈了。",shape=box,color=blue];
		j2223878934 -> j886150449;
	j3379892796 [label="+20 Chemistry",color=orange];
		j3379892796 -> j3077487779;
	j3619144228 [label="+15 Chemistry",color=orange];
		j3619144228 -> j1990558094;
	j1828723774 [label="+20 Chemistry",color=orange];
		j1828723774 -> j1779636995;
	j834062339 [label="很好。你最好别被他影响到。我可不想费劲教训你。你看上去像是那种会还击的人。",shape=box,color=blue];
		j834062339 -> j3345328449;
	j886150449 [label="Boolean LyonFaith1 is now true.",color=orange];
		j886150449 -> j1828723774;
	j3077487779 [label="谢谢你。并非我不相信你字里行间流露出的诚意，只是我的经历告诉我情况往往是这样。 ",shape=box,color=blue];
		j3077487779 -> j1779636995;
	j1990558094 [label="并非我不相信你字里行间流露出的诚意，只是我的经历告诉我情况往往是这样。 ",shape=box,color=blue];
		j1990558094 -> j1779636995;
	j1779636995 [label="在此期间，我恳请你的原谅和耐心。 ",shape=box,color=blue];
		j1779636995 -> j82610256;
