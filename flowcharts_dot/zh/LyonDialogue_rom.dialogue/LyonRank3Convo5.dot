	457 [label="另一个恶魔是罗瑟吗？",shape=box,color=red];
		457 -> 461;
	459 [label="她口中的这个故事完全不一样。",shape=box,color=red];
		459 -> 463;
	460 [label="她仍然相信他的本意是好的。你相信吗？",shape=box,color=red];
		460 -> 464;
	458 [label="看来你不是英择谛的盟友？",shape=box,color=red];
		458 -> 462;
	461 [label="是的。不过那是另一个故事了。如果我开始谈论他，我原本就糟糕的心情会变得更加…… ",shape=box,color=blue];
		461 -> 465;
	463 [label="是​啊，​如果​是​她​她​会​说​得​不​一样。​",shape=box,color=blue];
		463 -> 467;
		463 -> 468;
	464 [label="+5 Chemistry",color=orange];
		464 -> 469;
	462 [label="在忍受了他的谎言和背叛之后，在我们继续承受他对玛丽的操纵之苦时，你以为我屈服吗？不，我绝对不会。",shape=box,color=blue];
		462 -> 466;
	465 [label="……一发不可收拾。如果你不介意的话，我更愿意把注意力集中在英择谛的恶行上。",shape=box,color=blue];
		465 -> 470;
	467 [label="她告诉我，有时候你能看到别人看不到的东西。",shape=box,color=red];
		467 -> 472;
	468 [label="然后呢？",shape=box,color=red];
		468 -> 473;
	469 [label="玛丽​相信​每​个​人​心​中​都​有​善良​的​一面。​这​是​她​不断​磨练、​完善​的​能力，​以​此​作为​抵御​周围​世界​的​盾。​",shape=box,color=blue];
		469 -> 474;
