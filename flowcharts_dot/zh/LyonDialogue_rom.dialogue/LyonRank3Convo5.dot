	491 [label="她沐浴在在太阳温暖的光芒中，却看不见太阳表面形成的裂痕，也听不见越来越深的裂缝。",shape=box,color=blue];
		491 -> 497;
	485 [label="唯独这事，我永不原谅。我愿用我的香炉鞭打他，直到他乞求救赎。",shape=box,color=blue];
		485 -> 474;
		485 -> 475;
	492 [label="我们并非像恶魔那样……被强行摧毁。我为罗瑟所遭受的一切感到难过。",shape=box,color=blue];
		492 -> 498;
	493 [label="那么，我认为没有必要继续这个话题了。",shape=box,color=blue];
		493 -> 499;
	495 [label="漂泊者，恕我直言，我不知道该如何回答这个问题。",shape=box,color=blue];
		495 -> 501;
	494 [label="Update boolean LyonAllRight",color=orange];
		494 -> 500;
	502 [label="但愿我能将他灌输到她心中的邪念驱除。我只能祈祷我做不到的事情，你能做到。",shape=box,color=blue];
		502 -> 507;
	497 [label="她浑然不知，自己一手打造的杰作的碎片很快就会被用来对付她。她选择对即将到来的灾难视而不见。",shape=box,color=blue];
		497 -> 503;
	498 [label="直到他张嘴说话。",shape=box,color=blue];
