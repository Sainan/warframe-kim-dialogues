	503 [label="如果我能替她承受那份痛苦该有多好，我多么愿意将它刻进我心里。但这只属于她，也只属于她。",shape=box,color=blue];
		503 -> 508;
	504 [label="你要知道他成长的环境，知道那个逼着他学会生存的环境。他过去是——现在仍然是——奥罗金人。",shape=box,color=red];
		504 -> 509;
