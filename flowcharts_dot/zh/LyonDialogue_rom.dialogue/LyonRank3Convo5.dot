digraph {
	445 [label="LyonRank3Convo5 begins.",color=orange];
		445 -> 446;
	446 [label="“星期日主教”来到我们这里的那晚，正值雷雨交加。他站在教堂的圣殿里，丝毫没有受到外面狂风暴雨的影响。",shape=box,color=blue];
		446 -> 447;
	447 [label="我本应首先为此感到担忧。然而，我却向他低头致意，像迎接圣母派来的一位新使者一样向他问好。",shape=box,color=blue];
		447 -> 448;
	448 [label="毕竟，自从上一任主教几个月前因病离职后，我们就一直在期待一位新主教到来。",shape=box,color=blue];
		448 -> 449;
	449 [label="星期日主教热情地和我握手，脸上带着温暖的笑容。我问他旅途是否漫长。他的回答我永远不会忘记。",shape=box,color=blue];
		449 -> 450;
	450 [label="“虽然很艰难……但时间并不长。”",shape=box,color=blue];
		450 -> 451;
	451 [label="当时我感到很困惑，还有他那件干透的大衣也让我百思不得其解。但我没太在意，就像所有人遇到不寻常的事情时都会做的那样。",shape=box,color=blue];
		451 -> 452;
	452 [label="我还没来得及细想，玛丽就急切地赶来了。",shape=box,color=blue];
		452 -> 453;
	453 [label="他单膝跪地，与坐在椅子上的她平视，握住了她的手。我当时就应该看穿他的伎俩。",shape=box,color=blue];
		453 -> 454;
	454 [label="毕竟，他并不是唯一一个在暴风雨中来到我们家门口的恶魔。",shape=box,color=blue];
		454 -> 455;
