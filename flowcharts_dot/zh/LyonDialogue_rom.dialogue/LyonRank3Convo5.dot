	501 [label="这么多年来，我目睹过无数恐怖景象，足以把人送进精神病院。更悲惨的是，我的异象有时会变成现实。",shape=box,color=blue];
		501 -> 506;
	500 [label="我“是否​一切​都​好？”漂泊者，恕我直言，我不知道该如何回答这个问题。",shape=box,color=blue];
