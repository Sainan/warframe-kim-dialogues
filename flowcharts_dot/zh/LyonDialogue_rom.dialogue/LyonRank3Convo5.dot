	484 [label="+5 Chemistry",color=orange];
		484 -> 471;
	486 [label="我猜我其实都不太在意吧？",shape=box,color=red];
		486 -> 493;
	488 [label="我唯一的问题是，如果你能看到幻象，这些幻象会让你感到困扰吗？",shape=box,color=red];
		488 -> 495;
	489 [label="你​前​几​天​说​的​话​——​让​我​有点​担心​你​是否​一切​都​好。​",shape=box,color=red];
