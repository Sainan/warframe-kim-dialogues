	481 [label="信任就像一扇彩色玻璃窗。制作精巧，绚丽夺目；破碎时令人扼腕叹息；一旦损毁，便危机四伏。",shape=box,color=blue];
		481 -> 496;
	482 [label="信任就像一扇彩色玻璃窗。制作精巧，绚丽夺目；破碎时令人扼腕叹息；一旦损毁，便危机四伏。",shape=box,color=blue];
		482 -> 491;
	479 [label="但看看他是如何扭曲玛丽的……利用她对他人善良的信念来达到自己的目的？",shape=box,color=blue];
		479 -> 485;
	483 [label="不。我接受那血清自有我的理由。我知道它会把我变成非常扭曲的怪物。玛丽也知道。",shape=box,color=blue];
