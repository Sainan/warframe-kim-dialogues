	472 [label="如果这句话是真的，漂泊者，你会怎么看待这件事？",shape=box,color=blue];
		472 -> 480;
	473 [label="没有​“然后”。​我​已经​把​我​亲眼​目睹​的​事件​经过​告诉​了​你，​这​就​是​我​亲身​经历​的​真实​情况。​仅此​而​已。​",shape=box,color=blue];
		473 -> 469;
	474 [label="玛丽并不了解英择谛的真实能力，以及他以“进展”和现在的“救赎”之名所犯下的那些可憎行径。",shape=box,color=red];
		474 -> 481;
	475 [label="玛丽是个成年人了。我理解你想保护她的心情，但她有权自己决定相信什么，以及信仰谁。",shape=box,color=red];
		475 -> 482;
	471 [label="玷污我们的身体，摧毁我们的未来，腐蚀我们的过去——这一切，或许我都能原谅。",shape=box,color=blue];
		471 -> 479;
	476 [label="英择谛或许不擅长待人接物，但他正在努力拯救宇宙。",shape=box,color=red];
		476 -> 471;
	477 [label="他​是​不​是​强迫​你​成为​像​罗瑟​那样​的​原型​战甲？​",shape=box,color=red];
