		1851 -> 1861 [label="false",color=purple];
	1850 [label="哈！我怎么可能为了你背叛她的信任？Mon miracle，虽然你对我来说很珍贵——但她多年来一直是我灵魂姐妹。",shape=box,color=blue];
		1850 -> 1852;
	1849 [label="哈！我怎么可能为了你背叛她的信任？我的朋友，虽然你对我来说很珍贵——但她多年来一直是我灵魂姐妹。",shape=box,color=blue];
		1849 -> 1852;
	1853 [label="满意。我觉得让她帮忙修复洛德和楼上家族之间的关系。这……意义重大，里昂。我简直无法形容它有多重要。",shape=box,color=red];
		1853 -> 1862;
	1854 [label="不——说实话，就我们之间目前的情况来看，我已经彻底断送了让她帮忙修复洛德和楼上那家人之间关系的任何机会。",shape=box,color=red];
		1854 -> 1863;
	1858 [label="不——说实话，就我们之间目前的情况来看，我已经彻底断送了让她帮忙修复洛德和楼上那家人之间关系的任何机会。",shape=box,color=red];
		1858 -> 1866;
	1859 [label="满意。她不会帮我修复洛德和楼上家族的关系，我倒觉得这样也无所谓。",shape=box,color=red];
		1859 -> 1867;
	1860 [label="满意。我很高兴她意识到英择谛可能并非完全“善良”，而且……嗯，他也不是完全“邪恶”，对吧？",shape=box,color=red];
		1860 -> 1868;
	1855 [label="我对事情目前的进展很满意。说实话，我越想越觉得，在英择谛这件事上，我是站在她这边的。",shape=box,color=red];
		1855 -> 1867;
	1856 [label="我们在英择谛这件事上意见并不一致。我没能说服她……我真希望我当时能做得更好。",shape=box,color=red];
		1856 -> 1864;
	1857 [label="我们在英择谛的问题上“求同存异”，我想这大概就是我们在这个问题上能达成的最好结果了。我觉得再多讨论也于事无补。",shape=box,color=red];
		1857 -> 1865;
	1861 [label="老实说，还好。我觉得现在情况不会再好转也不会再恶化了。",shape=box,color=red];
		1861 -> 1865;
	1852 [label="不，她对我说的话我恐怕只能保守秘密。不过，那些话对她来说确实很感人。只是，我很好奇，你对你们之间事情的处理方式满意吗？",shape=box,color=blue];
		1852 -> 1851;
	1862 [label="我相信我能体会到这件事的伟大，即便无法完全理解它的规模。能以某种方式参与其中，我深感荣幸。",shape=box,color=blue];
		1862 -> 1869;
		1862 -> 1870;
	1863 [label="真有意思……嗯，你现在是她的恋人了，对吧？如果这里有人能说服她，那肯定是你，是吧？",shape=box,color=blue];
		1863 -> 1871;
	1866 [label="真有意思……嗯，我确实对她有一些……影响力，虽然可能有限。你觉得修复洛德先生和英择谛疏远的家人之间的关系很重要吗？",shape=box,color=blue];
		1866 -> 1874;
		1866 -> 1875;
	1867 [label="我无法判断这究竟是任性、傲慢、无知还是麻木的语气。因此，我姑且认为这四种情绪都有，然后继续我的一天。",shape=box,color=blue];
		1867 -> 1876;
	1868 [label="确实。我的想法和你类似。我也认为他不是只有一面的，而是……他的动机很复杂。",shape=box,color=blue];
		1868 -> 1877;
	1864 [label="嗯。唉，可惜的是，万事万物终有尽头。面团揉过头会变形，艺术家画作上的内容也会过多，争论当然也会过度。",shape=box,color=blue];
		1864 -> 1872;
	1865 [label="是的，或许让话题转向更有吸引力的方向会更好。",shape=box,color=blue];
		1865 -> 1873;
	1869 [label="我没想到你会主动提出帮忙。",shape=box,color=red];
		1869 -> 1878;
	1870 [label="你的意思是你会帮我劝洛德上楼去和他们谈谈？",shape=box,color=red];
		1870 -> 1879;
	1871 [label="我只是希望你没有在对她说的那些话里做出某种牺牲——为了讨好她而把一件事情看得比另一件事情更重要。",shape=box,color=blue];
		1871 -> 1880;
	1874 [label="里昂，这世上有太多孤独，太多悲伤。为什么我们不能在力所能及的时候，终结其中的一些呢？ ",shape=box,color=red];
		1874 -> 1882;
	1875 [label="我不确定，这只是一种直觉——一种预感。我觉得你们三个在这个时候被英择谛带到这里是有原因的。",shape=box,color=red];
		1875 -> 1883;
	1876 [label="真丢人。",shape=box,color=blue];
		1876 -> 1884;
	1877 [label="傲慢驱使着他。那是对知识的贪婪。如今，或许是对宽恕的贪婪。谁又能说得准呢？我甚至怀疑他自己是否明白。",shape=box,color=blue];
		1877 -> 1881;
	1872 [label="我想如果是我我会选择放手。也希望有一天她能有机会看清英择谛的真面目——充其量，他只是个复杂的人。",shape=box,color=blue];
		1872 -> 1881;
	1873 [label="我个人而言，我已经准备好不用再听他们无休止地谈论那位奇妙而完美的“主教”了。",shape=box,color=blue];
		1873 -> 1881;
	1878 [label="我知道我不太和善，但我也不是什么恶人。如果你需要我的帮助，我随时乐意效劳。",shape=box,color=blue];
		1878 -> 1885;
	1879 [label="当然。如果你需要我的帮助，我随时乐意效劳。",shape=box,color=blue];
		1879 -> 1885;
