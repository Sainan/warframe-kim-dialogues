	1835 [label="[结束]",shape=box,color=red];
		1835 -> 1840;
	1837 [label="请​劝玛丽别再​用​那些​殁世微灵复制​家​具​了。​我​现在​都​不​知道​该​怎么​处理​那些​椅子​了。​",shape=box,color=blue];
		1837 -> 1841;
	1836 [label="Chat ends.",color=orange];
	1839 [label="“激情犯罪”这个词的出现是有原因的。我想，如果我们人类不坚守自己的信仰，生活将会多么乏味啊。",shape=box,color=blue];
		1839 -> 1844;
	1838 [label="确实如此。我们每天晚上都会聊聊当天发生的事情。你跟我谈话之后，她立刻就跑到我身边，详细地告诉了我她的想法。",shape=box,color=blue];
		1838 -> 1842;
