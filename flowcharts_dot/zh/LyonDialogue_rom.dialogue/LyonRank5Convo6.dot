		1841 -> 1845;
	1844 [label="当然会更安静，更平和，但也更乏味，肯定不会有什么艺术可言。",shape=box,color=blue];
		1844 -> 1847;
	1842 [label="她跟你说了什么？",shape=box,color=red];
		1842 -> 1846;
