	j529193934 [label="+20 Chemistry",color=orange];
		j529193934 -> j1830816199;
	j2365026405 [label="我很欣赏你如此轻易地承认谎言。我也很感激你明白，在你所接触的人当中，我并不是……容易相处的人。",shape=box,color=blue];
