		j341548996 -> j3826619744;
	j996275704 [label="她​似乎​暗示​你​对​自己​头痛​的​原因​有​一些​看法？​",shape=box,color=red];
		j996275704 -> j609575487;
	j190390451 [label="玛丽觉得你一个人承担了所有的一切。我想让你知道我一直都在。",shape=box,color=red];
		j190390451 -> j3088870960;
	j3216607716 [label="玛丽觉得你完全没必要在这件事上受苦。我想知道我是否能帮上忙。",shape=box,color=red];
