		j4196473239 -> j1682288962;
	j2120467639 [label="我​只是​从​自身​的​经验​中学到，​有时候​我们​最​不​想​接受​别人​帮助​的​时候，​恰恰​是​我们​最​需要​帮助​的​时候。​",shape=box,color=red];
