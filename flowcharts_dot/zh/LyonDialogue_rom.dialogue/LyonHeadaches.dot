	j3088870960 [label="漂泊者，恕我直言：",shape=box,color=blue];
		j3088870960 -> j154880505;
	j4164547748 [label="嗯。我也有同样的症状。我实在无法想象盯着这玩意儿发光会有什么帮助。你应该去躺一会儿。",shape=box,color=blue];
		j4164547748 -> j641724870;
