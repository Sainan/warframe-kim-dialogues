		j2182348050 -> j2615420711;
	j309460874 [label="不知道为什么，他能配音我一点也不吃惊。",shape=box,color=red];
		j309460874 -> j2113328144;
	j2615420711 [label="我也不知道，但我现在有点怕听到答案了",shape=box,color=blue];
		j2615420711 -> j2113328144;
	j2113328144 [label="妈呀，伙计",shape=box,color=blue];
		j2113328144 -> j1746041434;
		j2113328144 -> j3304451352;
	j1746041434 [label="也许我们可以利用这一点来整蛊亚瑟。或者维克多。",shape=box,color=red];
		j1746041434 -> j778154702;
	j3304451352 [label="你当时有说什么吗？",shape=box,color=red];
		j3304451352 -> j4190349507;
	j778154702 [label="噢这我喜欢",shape=box,color=blue];
		j778154702 -> j389269596;
	j4190349507 [label="说什么？你傻了吗？我当时真的被震撼到了哈哈",shape=box,color=blue];
		j4190349507 -> j389269596;
	j389269596 [label="小兄弟有发现我像个惊掉下巴的呆瓜一样站在那里",shape=box,color=blue];
		j389269596 -> j67079924;
	j67079924 [label="然后他突然就害羞得跟啥似的，搞得好像刚才不是他自己在表演什么魔术",shape=box,color=blue];
		j67079924 -> j2622997244;
	j2622997244 [label="不过我也不怪他……毕竟以我们以前那点事来看？他大概以为我又要取笑他了吧",shape=box,color=blue];
		j2622997244 -> j1183349296;
		j2622997244 -> j3226685154;
	j1183349296 [label="我想他可能也习惯了平时被人取笑吧。",shape=box,color=red];
		j1183349296 -> j2769428626;
	j3226685154 [label="那你做了什么？",shape=box,color=red];
		j3226685154 -> j1502173071;
	j2769428626 [label="是啊……我其实挺后悔当初没跟他说清楚我为什么对他那么凶。不是因为我觉得他是可笑的人。我只是不想看他栽得太惨……不过",shape=box,color=blue];
		j2769428626 -> j332346096;
	j1502173071 [label="首先我问他——兄弟那些声音真的是你自己配的？所有的声音？！真的吗？！",shape=box,color=blue];
		j1502173071 -> j3038074553;
	j332346096 [label="我还是忍不住问了他一句那些声音真的是他自己配的？所有的声音？！真的吗？！",shape=box,color=blue];
		j332346096 -> j3038074553;
	j3038074553 [label="然后他说是，他真的能配所有角色的声音，伙计！连帕娜福特公主都能配，什么鬼",shape=box,color=blue];
		j3038074553 -> j62344210;
