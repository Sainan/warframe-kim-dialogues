		j1485457921 -> j4022177102;
	j4022177102 [label="什么鬼",shape=box,color=blue];
		j4022177102 -> j119884322;
	j119884322 [label="我不是说他只是在模仿他们。我是说，他简直就是他们本尊啊。",shape=box,color=blue];
		j119884322 -> j2182348050;
		j119884322 -> j309460874;
