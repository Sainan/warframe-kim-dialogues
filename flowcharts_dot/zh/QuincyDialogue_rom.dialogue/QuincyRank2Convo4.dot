		1023 -> 1024;
	993 [label="是吗？好吧。你想要真相？给你。我想要对我有利的东西，如果通过告诉你你想听的话能得到？我就会说出来。这并不意味着它是假的。这只是意味着我知道怎么玩这个游戏",shape=box,color=blue];
