digraph {
	1845 [label="QuincyAmirSoldier begins.",color=orange];
		1845 -> 1846;
	1846 [label="嘿",shape=box,color=blue];
		1846 -> 1847;
	1847 [label="按照你说的，跟那个小飞毛腿谈过了",shape=box,color=blue];
		1847 -> 1850;
		1847 -> 1848;
		1847 -> 1853;
	1850 [label="结果怎样？",shape=box,color=red];
		1850 -> 1849;
	1848 [label="哇。你真的听我说的做了吗？",shape=box,color=red];
		1848 -> 1851;
	1853 [label="在忙一些事，抱歉。[结束]",shape=box,color=red];
		1853 -> 1852;
	1849 [label="一开始他以为我要揍他呢，笑死。但后来我把他带到屋顶上，我们坐下来谈了谈",shape=box,color=blue];
		1849 -> 1854;
	1851 [label="妈的闭嘴，让我说完，好吗？",shape=box,color=blue];
		1851 -> 1849;
	1852 [label="Chat ends.",color=orange];
	1854 [label="我告诉他我当初怎么加入军队，怎么成为了一名狙击手",shape=box,color=blue];
		1854 -> 1856;
		1854 -> 1855;
	1856 [label="话说，你*是*怎么成为狙击手的？",shape=box,color=red];
		1856 -> 1857;
	1855 [label="然后呢？",shape=box,color=red];
		1855 -> 1858;
	1857 [label="现在这不重要",shape=box,color=blue];
		1857 -> 1858;
	1858 [label="跟他讲了我第一次杀人的经历",shape=box,color=blue];
		1858 -> 1859;
	1859 [label="第一次瞄准镜下看着一个人，然后夺走他的生命",shape=box,color=blue];
		1859 -> 1860;
	1860 [label="近身肉搏是一回事……一些暴徒拿着枪或刀向你冲过来……",shape=box,color=blue];
		1860 -> 1861;
	1861 [label="但当你在三百码外的屋顶上，而他们甚至不知道你在那里……完全是另一回事",shape=box,color=blue];
		1861 -> 1864;
	1864 [label="你有时间去*思考*他们。他们是谁。他们为什么会在那里。他们有家庭吗？有孩子吗？",shape=box,color=blue];
		1864 -> 1862;
	1862 [label="然后……你扣动扳机。砰",shape=box,color=blue];
		1862 -> 1863;
	1863 [label="现在这些都不重要了",shape=box,color=blue];
		1863 -> 1865;
	1865 [label="他们死了，而我夺走了那条生命",shape=box,color=blue];
		1865 -> 1866;
	1866 [label="那张脸一直留在我的脑海中",shape=box,color=blue];
		1866 -> 1867;
	1867 [label="之后的每一个都是如此",shape=box,color=blue];
		1867 -> 1868;
		1867 -> 1869;
	1868 [label="他有什么反应……？",shape=box,color=red];
		1868 -> 1871;
	1869 [label="听起来……挺令人振奋的。",shape=box,color=red];
		1869 -> 1871;
	1871 [label="很长时间没有说话。我们只是默默地坐在那里",shape=box,color=blue];
		1871 -> 1877;
	1877 [label="然后他……告诉我他一直在做的噩梦",shape=box,color=blue];
		1877 -> 1874;
	1874 [label="他觉得自己好像不是团队的一部分，因为他不是士兵",shape=box,color=blue];
		1874 -> 1872;
	1872 [label="所以我就跟他说，当我第一次作为士兵杀人时，我也是有多么恐惧",shape=box,color=blue];
		1872 -> 1873;
	1873 [label="而且我以前还经常做噩梦，比我小时候的噩梦还要可怕",shape=box,color=blue];
		1873 -> 1875;
	1875 [label="我也向他道歉了，因为我一直把他当傻子一样对待",shape=box,color=blue];
		1875 -> 1876;
	1876 [label="还说了他和任何人一样是我们的一员。我就是这样的人，就像他也有他的个性，这就是我们，你明白吗？",shape=box,color=blue];
		1876 -> 1870;
	1870 [label="……然后你知道他说什么了吗……？",shape=box,color=blue];
		1870 -> 1878;
		1870 -> 1879;
	1878 [label="说了什么？",shape=box,color=red];
		1878 -> 1882;
	1879 [label="不知道？",shape=box,color=red];
		1879 -> 1882;
	1882 [label="“你说得对，你就是个混蛋”",shape=box,color=blue];
		1882 -> 1884;
	1884 [label="但就在我正要把他从屋顶推下去的时候？",shape=box,color=blue];
		1884 -> 1883;
	1883 [label="他拥抱了我。他妈的拥抱了我。然后说“但你也是我哥哥”",shape=box,color=blue];
		1883 -> 1881;
	1881 [label="什么鬼",shape=box,color=blue];
		1881 -> 1880;
	1880 [label="不过……算了。值了。我觉得这对他来说真的很重要……而且……对我也是，我想",shape=box,color=blue];
		1880 -> 1886;
	1886 [label="+20 Chemistry",color=orange];
		1886 -> 1885;
	1885 [label="所以……谢谢",shape=box,color=blue];
		1885 -> 1887;
	1887 [label="Chat ends.",color=orange];
}