		2234 -> 2238 [label=true,color=green];
		2234 -> 2235 [label=false,color=brown];
	2242 [label="*不能*进化。我……想离开双衍王境。至少可以说，他对此不太能接受。就在这时，处决开始了。",shape=box,color=red];
