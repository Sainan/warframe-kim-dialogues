		2246 -> 2249;
		2246 -> 2250;
	2247 [label="你会吗？把他一个人永远留在黑暗中？",shape=box,color=blue];
		2247 -> 2253;
		2247 -> 2252;
		2247 -> 2251;
	2248 [label="有吧。我觉得他和其他人一样真实，尽管他不是以传统方式“出生”的。至于灵魂？可能有？是吧？我不知道。",shape=box,color=red];
		2248 -> 2260;
	2249 [label="我……说实话，我不知道。虚空中总有奇怪的东西进进出出。那里有灵魂也说不定。",shape=box,color=red];
		2249 -> 2257;
	2250 [label="不。他不是*真实*的。他的情感和书中的人物一样。这都是假装的。",shape=box,color=red];
		2250 -> 2254;
	2253 [label="不会。我会回去的。即使在他做了那些事之后，我仍然会经常回到双衍王境。",shape=box,color=red];
		2253 -> 2261;
	2252 [label="嗯。我的意思是。他不是*真实的*。当你读完一本书，把它放在书架上时，你会为它感到难过吗？",shape=box,color=red];
		2252 -> 2263;
	2251 [label="老实说，我不知道。生活轨迹发生了改变。没法说我会或不会做什么。",shape=box,color=red];
		2251 -> 2266;
	2260 [label="所以如果他是真实的，并且他的痛苦很重要，难道你不明白为什么他害怕你永远离开吗？",shape=box,color=blue];
		2260 -> 2258;
	2257 [label="好吧，假设他确实很重要，而且他是真实的，你不明白为什么他害怕你永远离开吗？",shape=box,color=blue];
		2257 -> 2258;
	2254 [label="我希望我能像你那样，对自己不确定的事情有这样的信念。你还真是挺有种的",shape=box,color=blue];
