	2241 [label="而士魂大帝就是这一切的化身。但随着我长大，也开始逐渐改变……他却没有。我不再需要他了。但他所基于的那本小孩子的故事书并没有进化。",shape=box,color=red];
		2241 -> 2242;
	2237 [label="我*有生以来*第一次感到安全。我身边有一个社区，就像我小时候那样——不过这个社区是真正在乎我的",shape=box,color=red];
		2237 -> 2241;
