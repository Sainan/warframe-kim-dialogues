	3968 [label="嘿，昆？还有空吗？[征求多个伴侣关系的同意]",shape=box,color=red];
		3968 -> 3971;
	3967 [label="[结束]",shape=box,color=red];
		3967 -> 3970;
	3966 [label="Chat ends.",color=orange];
	3971 [label="有啊，怎么了宝贝？",shape=box,color=blue];
		3971 -> 3973;
	3970 [label="Update boolean QuincyConsentComplete",color=orange];
		3970 -> 3972;
	3973 [label="我想跟你说件事，我想先确定你能接受。",shape=box,color=red];
		3973 -> 3974;
	3972 [label="Chat ends.",color=orange];
	3974 [label="对我来说重要的是，你不会觉得我在对你撒谎，或者对你不坦诚。",shape=box,color=red];
		3974 -> 3975;
	3975 [label="哈哈，你到底干嘛了",shape=box,color=blue];
		3975 -> 3976;
	3976 [label="你杀了谁？陛下死了？",shape=box,color=blue];
		3976 -> 3977;
	3977 [label="没！没有。亚瑟活着。我只是想跟你说点事，希望不会让你觉得尴尬。",shape=box,color=red];
		3977 -> 3978;
	3978 [label="我不想让你陷入一种你无法接受的情况。所以如果你拒绝，那也没关系。我希望你清楚这一点。",shape=box,color=red];
		3978 -> 3979;
	3979 [label="我们之间的感情对我很重要——非常重要——而且它是真实的。我不希望你怀疑这一点。",shape=box,color=red];
		3979 -> 3980;
	3980 [label="Check boolean QuincyForgiven",color=orange];
		3980 -> 3982 [label=true,color=green];
		3980 -> 3981 [label=false,color=brown];
	3982 [label="哦，天——哪宝贝，你是想告诉我你在别的城市还有别的人吗？",shape=box,color=blue];
		3982 -> 3984;
	3981 [label="哦，天——哪宝贝，你是想告诉我你在别的城市还有别的感情吗？",shape=box,color=blue];
		3981 -> 3983;
	3984 [label="我想在事情还没到不可收拾的地步之前，跟你聊聊征求你的同意。我不想让你难过，而且这是我们以前从没谈过的话题。",shape=box,color=red];
		3984 -> 3986;
	3983 [label="我想在事情还没到不可收拾的地步之前，跟你聊聊征求你的同意。我不想让你难过，而且这是我们以前从没谈过的话题。",shape=box,color=red];
		3983 -> 3985;
	3986 [label="谁说我生气了？宝贝，我才没生气呢，我正琢磨着怎么让那个粉头发的家伙帮我搭个顺风车呢 哈哈哈哈",shape=box,color=blue];
		3986 -> 3988;
	3985 [label="不会！不会，我尊重会玩的人",shape=box,color=blue];
		3985 -> 3987;
	3988 [label="不会的，不过说真的，我懂。我知道那种感觉。有时候你坠入爱河，然后又再坠入爱河了，这只能说明你有一颗能这么做的心，不丢人",shape=box,color=blue];
		3988 -> 3990;
	3987 [label="不会的，不过说真的，我懂。我知道那种感觉。有时候你爱上一个，然后又爱上一个，这只能说明你有一颗能这么做的心，不丢人",shape=box,color=blue];
		3987 -> 3989;
	3990 [label="+20 Chemistry",color=orange];
		3990 -> 3992;
	3989 [label="+20 Chemistry",color=orange];
		3989 -> 3991;
	3992 [label="如果你说我们之间是真的，那我相信你",shape=box,color=blue];
		3992 -> 3993;
	3991 [label="如果你说我们之间还没结束，那我相信你",shape=box,color=blue];
		3991 -> 3993;
	3993 [label="你最好别开始用什么奇怪的表情盯着六人组或老圆桌的成员看",shape=box,color=blue];
		3993 -> 3994;
	3994 [label="可别是六人组的，我会彻底疯掉的",shape=box,color=blue];
		3994 -> 3995;
	3995 [label="Update boolean QuincyConsentComplete",color=orange];
		3995 -> 3996;
