	j186252931 [label="嘿，昆？还有空吗？[征求是否同意多重伴侣关系]",shape=box,color=red];
		j186252931 -> j1409210975;
	j1012959090 [label="[结束]",shape=box,color=red];
		j1012959090 -> j3870760305;
	j1409210975 [label="有啊，怎么了宝贝？",shape=box,color=blue];
		j1409210975 -> j2941464425;
	j3870760305 [label="Boolean QuincyConsentComplete is now true.",color=orange];
		j3870760305 -> "Chat ends.";
	j2941464425 [label="我想跟你说件事，我想先确定你能接受。",shape=box,color=red];
		j2941464425 -> j2179235026;
	j2179235026 [label="对我来说重要的是，你不会觉得我在对你撒谎，或者对你不坦诚。",shape=box,color=red];
		j2179235026 -> j2456724375;
	j2456724375 [label="哈哈，你到底干嘛了",shape=box,color=blue];
		j2456724375 -> j2721149109;
	j2721149109 [label="你杀了谁？陛下死了？",shape=box,color=blue];
		j2721149109 -> j369685224;
	j369685224 [label="没！没有。亚瑟活着。我只是想跟你说点事，希望不会让你觉得尴尬。",shape=box,color=red];
		j369685224 -> j2942610652;
	j2942610652 [label="我不想让你陷入一种你无法接受的情况。所以如果你拒绝，那也没关系。我希望你清楚这一点。",shape=box,color=red];
		j2942610652 -> j4079748735;
	j4079748735 [label="我们之间的感情对我很重要——非常重要——而且它是真实的。我不希望你怀疑这一点。",shape=box,color=red];
		j4079748735 -> j1148984836;
	j1148984836 [label="Check boolean QuincyForgiven",color=orange];
		j1148984836 -> j2796893819 [label=true,color=green];
		j1148984836 -> j1904723261 [label=false,color=brown];
	j2796893819 [label="哦，天——哪宝贝，你是想告诉我你在别的城市还有别的人吗？",shape=box,color=blue];
		j2796893819 -> j1511476941;
	j1904723261 [label="哦，天——哪宝贝，你是想告诉我你在别的城市还有别的感情吗？",shape=box,color=blue];
		j1904723261 -> j2510004991;
	j1511476941 [label="我想在事情还没到不可收拾的地步之前，跟你聊聊征求你的同意。我不想让你难过，而且这是我们以前从没谈过的话题。",shape=box,color=red];
		j1511476941 -> j3028180996;
	j2510004991 [label="我想在事情还没到不可收拾的地步之前，跟你聊聊征求你的同意。我不想让你难过，而且这是我们以前从没谈过的话题。",shape=box,color=red];
		j2510004991 -> j426097605;
	j3028180996 [label="谁说我生气了？宝贝，我才没生气呢，我正琢磨着怎么让那个粉头发的家伙帮我搭个顺风车呢 哈哈哈哈",shape=box,color=blue];
		j3028180996 -> j1283687617;
	j426097605 [label="不会！不会，我尊重会玩的人",shape=box,color=blue];
		j426097605 -> j1879896029;
	j1283687617 [label="不会的，不过说真的，我懂。我知道那种感觉。有时候你坠入爱河，然后又再坠入爱河了，这只能说明你有一颗能这么做的心，不丢人",shape=box,color=blue];
		j1283687617 -> j984966398;
	j1879896029 [label="不会的，不过说真的，我懂。我知道那种感觉。有时候你爱上一个，然后又爱上一个，这只能说明你有一颗能这么做的心，不丢人",shape=box,color=blue];
		j1879896029 -> j4084393813;
	j984966398 [label="+20 Chemistry",color=orange];
		j984966398 -> j2319479769;
	j4084393813 [label="+20 Chemistry",color=orange];
		j4084393813 -> j3100836560;
	j2319479769 [label="如果你说我们之间是真的，那我相信你",shape=box,color=blue];
		j2319479769 -> j3408842588;
	j3100836560 [label="如果你说我们之间还没结束，那我相信你",shape=box,color=blue];
		j3100836560 -> j3408842588;
	j3408842588 [label="只要你别开始用什么奇怪的表情盯着六人组或老圆桌的成员看",shape=box,color=blue];
		j3408842588 -> j1435532953;
	j1435532953 [label="最好不是六人组里的谁，我会彻底疯掉的",shape=box,color=blue];
		j1435532953 -> j3870760305;
}