digraph {
	3451 [label="QuincyAmirTrick2 begins.",color=orange];
		3451 -> 3450;
	3450 [label="你知道吗，每次我以为我已经弄懂那个小飞毛腿了，他总能给我惊喜，笑死我了",shape=box,color=blue];
		3450 -> 3452;
		3450 -> 3453;
		3450 -> 3454;
	3452 [label="怎么说？",shape=box,color=red];
		3452 -> 3457;
	3453 [label="他因为那些包装泡沫花生生气了吗？",shape=box,color=red];
		3453 -> 3456;
	3454 [label="[无视]",shape=box,color=red];
		3454 -> 3455;
	3457 [label="好吧，我用纸板把房间堵住了，并在上面剪了个洞，用反向的工业吸尘器把整个房间填满泡沫花生，明白了吗？得把那玩意堆满整个房间",shape=box,color=blue];
		3457 -> 3459;
		3457 -> 3458;
	3456 [label="根本不是那回事",shape=box,color=blue];
		3456 -> 3457;
	3455 [label="Chat ends.",color=orange];
	3459 [label="我很佩服。",shape=box,color=red];
		3459 -> 3460;
	3458 [label="你以前肯定做过这种事。",shape=box,color=red];
		3458 -> 3460;
	3460 [label="在军事基地里的生活有时候真的会很无聊，我也不知道该怎么跟你说，哈哈",shape=box,color=blue];
		3460 -> 3461;
	3461 [label="然后就是关门，从门底下抽出纸板，这样当他开门时，所有的东西都会倒出来，就这么简单",shape=box,color=blue];
		3461 -> 3462;
	3462 [label="他过来的时候，一切都按计划进行。他说，“咦，我的门怎么关上了，真奇怪。”然后他一开门，砰隆隆一声",shape=box,color=blue];
		3462 -> 3463;
	3463 [label="他就像一个小女孩看到老鼠一样尖叫，还一条腿跳了起来，真是太精彩了",shape=box,color=blue];
		3463 -> 3467;
	3467 [label="然后他听到我在笑，我还以为他会生气。结果他竟然开始大笑",shape=box,color=blue];
		3467 -> 3464;
	3464 [label="他还问我这是怎么做到的！所以我就教他怎么做。那个小飞毛腿似乎……很佩服？甚至要了我用的纸板。把自己的下半部分门封上，像是围栏一样，是吧？",shape=box,color=blue];
		3464 -> 3465;
	3465 [label="这个小怪胎把他的房间变成了一个装满泡沫花生的球池，就像你在汉堡店看到的那种。我发现他和碧在里面玩，两个人互相扔泡沫花生，就像在玩雪球一样",shape=box,color=blue];
		3465 -> 3466;
	3466 [label="他们问我要不要一起加入",shape=box,color=blue];
		3466 -> 3468;
		3466 -> 3469;
	3468 [label="那你加入了吗？",shape=box,color=red];
		3468 -> 3470;
	3469 [label="怎么样了？",shape=box,color=red];
		3469 -> 3470;
	3470 [label="切，我？昆西-克？！我？！大佬本人？这个老滑头？你觉得你会看到我跟那些年轻人一起混吗？！",shape=box,color=blue];
		3470 -> 3471;
	3471 [label="我当然跳进去了！",shape=box,color=blue];
		3471 -> 3472;
	3472 [label="在你出现之前，我是绝对不会这么做的。绝对不会。所以……嗯。谢谢你帮我放开自己",shape=box,color=blue];
		3472 -> 3473;
	3473 [label="+20 Chemistry",color=orange];
		3473 -> 3474;
	3474 [label="下一个恶作剧对象？亚瑟。;)",shape=box,color=blue];
		3474 -> 3475;
	3475 [label="Chat ends.",color=orange];
}