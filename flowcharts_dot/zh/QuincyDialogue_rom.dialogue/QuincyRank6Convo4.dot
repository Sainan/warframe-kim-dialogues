	j625045568 [label="好啦，搞笑的是，我所有书都听完了",shape=box,color=blue];
		j625045568 -> j992168086;
	j2695393032 [label="所以我就养成了用磁带听有声书的习惯，什么类型都听",shape=box,color=blue];
		j2695393032 -> j1015776167;
	j3779431790 [label="我想粉毛听到了我跟莱蒂抱怨这事了",shape=box,color=blue];
		j3779431790 -> j1735610180;
	j992168086 [label="也不奇怪，毕竟现在都末世了嘛",shape=box,color=blue];
		j992168086 -> j2792054875;
	j1735610180 [label="我指的是卡娅，那个傲娇小妹。我很讨厌她经历的那些事，但伙计，那个女孩该放轻松点了",shape=box,color=blue];
		j1735610180 -> j2332284691;
	j2792054875 [label="但我发现，原来我们这群人里不止我一个爱听有声书",shape=box,color=blue];
		j2792054875 -> j3011377924;
	j2332284691 [label="总之她走过来，说了一些很装的话，说这种书不适合我，我应该也看不懂，不过如果我太无聊的话，她有量子物理的书可以借我。",shape=box,color=blue];
		j2332284691 -> j1818305878;
