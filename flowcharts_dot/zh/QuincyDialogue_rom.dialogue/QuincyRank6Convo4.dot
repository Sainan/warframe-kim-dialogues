		j148297208 -> j502457911;
	j2979593782 [label="糟糕。",shape=box,color=red];
		j2979593782 -> j1889480944;
	j1070171262 [label="是弗莱尔？",shape=box,color=red];
		j1070171262 -> j1990191519;
	j576405011 [label="是米尼娃？",shape=box,color=red];
		j576405011 -> j577155963;
	j3228367693 [label="是卡娅？",shape=box,color=red];
		j3228367693 -> j1668660933;
	j139321676 [label="……是丽兹?",shape=box,color=red];
		j139321676 -> j2961938228;
	j1935365533 [label="是维利米尔？",shape=box,color=red];
		j1935365533 -> j2324246109;
	j2614608361 [label="嗯，你知道我的，我就喜欢别人觉得我傻",shape=box,color=blue];
		j2614608361 -> j3099607951;
	j502457911 [label="没有，我那时候表现得很乖。不过你知道我的，我就喜欢别人觉得我傻",shape=box,color=blue];
		j502457911 -> j3099607951;
	j1889480944 [label="是的，你知道我的，我就喜欢别人觉得我傻",shape=box,color=blue];
		j1889480944 -> j3099607951;
	j1990191519 [label="哈哈，不过说不定他会喜欢其中几本。其实是米尼娃",shape=box,color=blue];
		j1990191519 -> j1981325360;
	j577155963 [label="+5 Chemistry",color=orange];
		j577155963 -> j3374355718;
	j1668660933 [label="我靠才不是呢，粉毛太严肃了。就算她听了，她也死都不会承认的吧，毕竟她那个年纪，还有她现在要做的事。其实是米尼娃",shape=box,color=blue];
		j1668660933 -> j1981325360;
	j2961938228 [label="妈呀，才不是。这怪吉他估计更想把 CD 吃了，哪还会听啊。哈哈，是米尼娃",shape=box,color=blue];
		j2961938228 -> j1981325360;
	j2324246109 [label="不，但很接近，说来有趣。是米尼娃",shape=box,color=blue];
		j2324246109 -> j1981325360;
	j3099607951 [label="尤其对方看起来像是才 12 岁大",shape=box,color=blue];
		j3099607951 -> j1525863585;
	j1981325360 [label="她喜欢各种奇怪的类型，CD 堆得跟小山一样高，然后开始跟我说我们可以交换来听",shape=box,color=blue];
		j1981325360 -> j1640941536;
	j3374355718 [label="哈哈你猜对了 ",shape=box,color=blue];
		j3374355718 -> j1981325360;
	j1525863585 [label="所以我问她，她有哪些量子物理的书，",shape=box,color=blue];
		j1525863585 -> j48137685;
	j1640941536 [label="我还以为维利米尔会当场拍死我",shape=box,color=blue];
		j1640941536 -> j2912284614;
	j48137685 [label="因为如果只是波粒二象性的东西那就没问题，我学过那玩意，也懂那玩意",shape=box,color=blue];
		j48137685 -> j3439883781;
	j2912284614 [label="结果大兄弟只是笑着耸耸肩，说道：“我才不会干涉老婆的兴趣爱好。”",shape=box,color=blue];
		j2912284614 -> j2240083694;
	j3439883781 [label="其实我更感兴趣的是分数量子霍尔效应，或者量子力学的关系诠释",shape=box,color=blue];
		j3439883781 -> j251757692;
		j3439883781 -> j759640428;
	j2240083694 [label="然后紧接着他说“我最喜欢《火星外星军阀》”",shape=box,color=blue];
		j2240083694 -> j3560405803;
	j251757692 [label="卡娅听了这些是怎么反应的？",shape=box,color=red];
		j251757692 -> j3899771725;
	j759640428 [label="嗯，每个字都认识但连起来看不懂。",shape=box,color=red];
		j759640428 -> j3346744291;
	j3560405803 [label="这都什么神人啊，笑死我了",shape=box,color=blue];
		j3560405803 -> j3821510355;
		j3560405803 -> j3322942245;
	j3899771725 [label="她眼睛睁得老大，哈哈，然后她问我会怎么知道我刚才说的东西。我我直接回她一句滚蛋",shape=box,color=blue];
		j3899771725 -> j574372683;
	j3346744291 [label="伙计，我不是说了嘛，在屋顶上超级无聊。好吗",shape=box,color=blue];
		j3346744291 -> j3899771725;
	j3821510355 [label="听着像维利米尔会说的。",shape=box,color=red];
		j3821510355 -> j3500562968;
	j3322942245 [label="是我们的新朋友。哈哈。",shape=box,color=red];
		j3322942245 -> j3500562968;
	j574372683 [label="那天下午我又出去跑了个连着几小时的任务",shape=box,color=blue];
		j574372683 -> j1809465965;
	j3500562968 [label="他是个真大佬，别误会我的意思，哈哈。我挺喜欢他和米尼娃的",shape=box,color=blue];
		j3500562968 -> j562381859;
	j1809465965 [label="然后突然收音机里传来滋滋滋的声音，是粉毛",shape=box,color=blue];
		j1809465965 -> j1122189383;
	j562381859 [label="他们我是真的搞不懂，但我还挺喜欢他们的，哈哈",shape=box,color=blue];
		j562381859 -> j4286430130;
	j1122189383 [label="她一上来就开始读她的教科书哈哈哈",shape=box,color=blue];
		j1122189383 -> j2810844995;
	j4286430130 [label="不过这也就是他们能融入得那么自然的原因吧，呵呵",shape=box,color=blue];
		j4286430130 -> j3747314940;
	j2810844995 [label="一句道歉都没有，什么也没有。很好。我也不需要。她翻到那一章就开始念",shape=box,color=blue];
		j2810844995 -> j161459383;
	j3747314940 [label="我想这也是他们会成为一家人的原因",shape=box,color=blue];
		j3747314940 -> j482057360;
	j161459383 [label="然后我们居然就开始讨论什么传递性虚空的属性，还有我是怎么穿墙射击的等等",shape=box,color=blue];
		j161459383 -> j1437821055;
	j482057360 [label="不对，等等，我收回刚才的话。我才不要和家人交换言情小说，啊啊啊啊",shape=box,color=blue];
		j482057360 -> j1669224619;
		j482057360 -> j1430840310;
	j1437821055 [label="还有就是你可以把虚空属性传递给其他物体，毕竟你每次用你那奇怪的虚空力量，从另一边跳出来的时候都不是光着屁股的，哈哈",shape=box,color=blue];
		j1437821055 -> j1310659823;
