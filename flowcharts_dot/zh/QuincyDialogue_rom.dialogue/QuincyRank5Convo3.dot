	3231 [label="这没什么丢人的。我希望我也能那样，那会让我的生活轻松很——多，哈哈。那样就不会有这么多乱七八糟的事",shape=box,color=blue];
		3231 -> 3232;
	3235 [label="哦，是吗? 好吧，说出来。告诉你的兄弟昆西-克，他怎么能帮你",shape=box,color=blue];
