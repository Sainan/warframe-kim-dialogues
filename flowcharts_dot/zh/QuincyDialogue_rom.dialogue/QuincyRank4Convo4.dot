		2316 -> 2317 [label=true,color=green];
		2316 -> 2318 [label=false,color=brown];
	2317 [label="嘿，性感宝贝，我有个问题想问你",shape=box,color=blue];
		2317 -> 2319;
	2318 [label="我有个问题想问你",shape=box,color=blue];
		2318 -> 2319;
	2319 [label="Check boolean QuincyParvos",color=orange];
		2319 -> 2320 [label=true,color=green];
		2319 -> 2321 [label=false,color=brown];
	2320 [label="你提到这个叫帕尔沃斯的家伙，这个有钱人",shape=box,color=blue];
		2320 -> 2322;
	2321 [label="在你的未来世界里没有什么……大公司的人物？",shape=box,color=blue];
		2321 -> 2323;
		2321 -> 2324;
	2322 [label="你觉得他幸福吗？",shape=box,color=blue];
		2322 -> 2328;
		2322 -> 2327;
		2322 -> 2329;
	2323 [label="大公司？你指的是什么？",shape=box,color=red];
		2323 -> 2325;
	2324 [label="公司，是企业的意思吗？",shape=box,color=red];
		2324 -> 2326;
	2328 [label="幸福？昆，我真的不太了解那个人。我们又不来往。",shape=box,color=red];
		2328 -> 2331;
	2327 [label="你为什么这么问？",shape=box,color=red];
		2327 -> 2332;
	2329 [label="我没空聊这个。[结束]",shape=box,color=red];
		2329 -> 2330;
	2325 [label="企业的。公司的。那种富得流油的有钱人",shape=box,color=blue];
		2325 -> 2335;
		2325 -> 2334;
	2326 [label="对，你懂的。那种富得流油的有钱人",shape=box,color=blue];
		2326 -> 2335;
		2326 -> 2334;
	2331 [label="是，但你和他有过接触。你听过他说话，你和他来往的人也有来往",shape=box,color=blue];
		2331 -> 2333;
	2332 [label="因为这个世界是靠有钱人和没钱人运转的，对吧？一直都是这样，我想知道它是不是永远都这样",shape=box,color=blue];
		2332 -> 2340;
		2332 -> 2338;
		2332 -> 2339;
	2330 [label="Chat ends.",color=orange];
	2335 [label="其实有。帕尔沃斯·格拉努，Corpus 的头儿",shape=box,color=red];
		2335 -> 2337;
	2334 [label="我没空聊这个，抱歉。[结束]",shape=box,color=red];
		2334 -> 2336;
	2333 [label="你觉得他对自己的生活感到快乐吗？甚至是满足？",shape=box,color=blue];
		2333 -> 2340;
		2333 -> 2338;
		2333 -> 2339;
	2340 [label="我不认为金钱能买到幸福。",shape=box,color=red];
		2340 -> 2341;
	2338 [label="我觉得那些说金钱买不到幸福的人缺乏创造力。",shape=box,color=red];
		2338 -> 2343;
	2339 [label="据我所知似乎是这样的。有些人支持他的原因似乎不*只是*金钱。",shape=box,color=red];
		2339 -> 2344;
	2337 [label="Update boolean QuincyParvos",color=orange];
		2337 -> 2333;
	2336 [label="Chat ends.",color=orange];
	2341 [label="那我觉得你还不够努力，哈哈",shape=box,color=blue];
		2341 -> 2342;
	2343 [label="对。你懂的。他们还不够努力，哈哈哈",shape=box,color=blue];
		2343 -> 2342;
	2344 [label="哦是吗？详细说说",shape=box,color=blue];
		2344 -> 2346;
		2344 -> 2345;
	2342 [label="那他有家人吗？有支持他的人在身边吗？",shape=box,color=blue];
		2342 -> 2346;
		2342 -> 2345;
	2346 [label="有个女人，薇拉·格拉里斯。原本只是他的一个下属。她与她的船一起被击落，炮火轰鸣，怒吼着抗争到底",shape=box,color=red];
		2346 -> 2347;
	2345 [label="他训练这些姐妹们，让她们围绕在他身边。我可以看出他真的为她们感到骄傲。把她们当作家人。",shape=box,color=red];
		2345 -> 2349;
	2347 [label="他打开了一个虚空口袋，嗯，这是一个很长的故事，不重要。他救了她的命。我觉得他真的很欣赏她。重视她。把她当作姐姐。",shape=box,color=red];
		2347 -> 2348;
	2349 [label="说实话，这有点像邪教。但你能怎么办呢？钱就是这样的。",shape=box,color=red];
		2349 -> 2351;
	2348 [label="我想她也把他当作家人看待。",shape=box,color=red];
		2348 -> 2353;
	2351 [label="只要你有钱，钱就能买到忠诚。世上没有比黄金邪教更古老的邪教了",shape=box,color=blue];
		2351 -> 2350;
		2351 -> 2352;
	2353 [label="没有人是完全邪恶或完全善良的，你知道吗？听起来这家伙知道他的帮派成员是谁，明白我的意思吗？",shape=box,color=blue];
		2353 -> 2354;
	2350 [label="我真的不喜欢你听起来这么像那个家伙。生命中除了金钱还有更重要的事情。",shape=box,color=red];
		2350 -> 2361;
	2352 [label="你们俩肯定会相处得很好。太像了。",shape=box,color=red];
		2352 -> 2361;
	2354 [label="他有资源照顾他关心的人，周围的人也看到了这一点",shape=box,color=blue];
		2354 -> 2357;
		2354 -> 2358;
		2354 -> 2355;
		2354 -> 2356;
	2361 [label="老表，我不是说这混蛋是英雄，哈哈哈。在这个世界上没有英雄。他只是有办法让自己快乐起来，照顾他在乎的人",shape=box,color=blue];
		2361 -> 2362;
	2357 [label="他为了生存做了他该做的事。我可以尊重这一点。即使这通常意味着我们站在对立面。",shape=box,color=red];
		2357 -> 2359;
	2358 [label="他只会将那些对他有价值的人留在他身边。我敢肯定，一旦这些人成为累赘，他们马上就会被抛弃。",shape=box,color=red];
		2358 -> 2361;
	2355 [label="这并不意味着他不是一个冷酷无情的混蛋。我无论如何都不会相信他，他的人总是妨碍我的行动。",shape=box,color=red];
		2355 -> 2361;
	2356 [label="我真的不认同他对剥削宇宙的看法。我更喜欢帮助需要帮助的人，而不是单纯追求贪婪。",shape=box,color=red];
		2356 -> 2361;
	2362 [label="对我来说？那简直就是梦想。为我和我的伙计们还有我的家人安排好一切。没有人会缺衣少食。要做到这一点？你需要很多钱",shape=box,color=blue];
		2362 -> 2365;
		2362 -> 2363;
		2362 -> 2364;
	2359 [label="+10 Chemistry",color=orange];
		2359 -> 2360;
	2365 [label="所以你想变富有是为了别人？",shape=box,color=red];
		2365 -> 2366;
	2363 [label="所以你想变富有是为了自己？",shape=box,color=red];
		2363 -> 2369;
	2364 [label="这一切归根到底还是纯粹的贪婪。",shape=box,color=red];
		2364 -> 2370;
	2360 [label="这就是我要说的。他不是什么英雄，在这个世界上没有英雄。他只是有办法让自己快乐起来，照顾他在乎的人",shape=box,color=blue];
		2360 -> 2362;
	2366 [label="+10 Chemistry",color=orange];
		2366 -> 2367;
	2369 [label="你还没明白。如果我有钱了，那我就能帮助别人。小罗宾女搞错了。你不能通过贫穷来帮助穷人。你要通过富有来帮助穷人，那才是所有的力量所在",shape=box,color=blue];
		2369 -> 2368;
	2370 [label="你不懂。你真的不懂。金钱就是力量，力量就是你在这个世界上改变事情的方式",shape=box,color=blue];
		2370 -> 2371;
	2367 [label="没错！这就是力量所在。一旦你富起来，你就可以帮助别人。那时候你才能真正改变事情。在那之前？你只会被贴上麻烦制造者的标签，懂吗？",shape=box,color=blue];
		2367 -> 2368;
	2368 [label="不过我得走了",shape=box,color=blue];
		2368 -> 2372;
	2371 [label="算了，不想和你争论",shape=box,color=blue];
		2371 -> 2372;
	2372 [label="我倒是有点想见见这个帕尔沃斯",shape=box,color=blue];
		2372 -> 2373;
	2373 [label="听起来挺有意思。虽然有点像个混蛋。但所有大公司的人到头来都是这样",shape=box,color=blue];
		2373 -> 2374;
	2374 [label="因为那是你取得成功的方式，对吧",shape=box,color=blue];
		2374 -> 2375;
	2375 [label="Chat ends.",color=orange];
}