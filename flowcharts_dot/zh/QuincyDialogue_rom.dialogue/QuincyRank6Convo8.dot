		j1078089104 -> j3443509509;
	j3272329481 [label="也没必要？碧就是碧。她并非坚不可摧，但她也从没带来过什么麻烦",shape=box,color=blue];
		j3272329481 -> j4197352956;
	j3443509509 [label="哈哈哈哈哈哈",shape=box,color=blue];
		j3443509509 -> j2421371625;
	j4197352956 [label="那个女人知道自己是谁，也知道如何处理自己的事情",shape=box,color=blue];
		j4197352956 -> j1392971238;
	j2421371625 [label="我喜欢那种对自己了如指掌、完全不在乎别人眼光的男人，伙计",shape=box,color=blue];
		j2421371625 -> j2039665173;
	j1392971238 [label="她从第一天起就看透了我哈哈",shape=box,color=blue];
		j1392971238 -> j2702760739;
