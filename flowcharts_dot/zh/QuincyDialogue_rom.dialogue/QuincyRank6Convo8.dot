	j2025202023 [label="我最近一直在店里帮碧，主要在研究原摩",shape=box,color=blue];
		j2025202023 -> j1326521563;
	j1326521563 [label="她和维利米尔相处得像家人一样，这简直太可爱了无法用语言形容，哈哈",shape=box,color=blue];
		j1326521563 -> j4273449657;
