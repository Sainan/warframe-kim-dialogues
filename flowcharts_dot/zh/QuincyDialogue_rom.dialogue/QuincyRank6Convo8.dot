		j2039665173 -> j3464231561;
	j2702760739 [label="一开始让我有点紧张，以为她要试图“纠正”我之类的",shape=box,color=blue];
		j2702760739 -> j2195748866;
	j3464231561 [label="尽管他叫我“长枪麦极致不列颠尼克” ",shape=box,color=blue];
		j3464231561 -> j2067372609;
	j2195748866 [label="但不是。她懂。她就像我的大姐姐一样",shape=box,color=blue];
		j2195748866 -> j2005062976;
	j2067372609 [label="……我不是那种典型的不列颠尼克人吧？",shape=box,color=blue];
		j2067372609 -> j1924165876;
		j2067372609 -> j4065253141;
	j2005062976 [label="别告诉她，不然我可要一枪把你打穿墙了，哈哈",shape=box,color=blue];
		j2005062976 -> "Chat ends.";
	j1924165876 [label="是的。没错，你就是。而我甚至都没去过那里，但我就是知道。",shape=box,color=red];
		j1924165876 -> j2370156366;
	j4065253141 [label="我不知道，我只能参考你和亚瑟的情况。",shape=box,color=red];
