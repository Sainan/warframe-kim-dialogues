		1122 -> 1123;
		1122 -> 1124;
	1123 [label="好吧，那么……等我把话说完再做决定，好吗？那个……有个游戏。",shape=box,color=red];
		1123 -> 1127;
		1123 -> 1128;
		1123 -> 1129;
