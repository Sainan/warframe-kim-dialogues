	2716 [label="阿米尔正在组织一场桌游，这是我们大家一起出来玩的好机会。",shape=box,color=red];
		2716 -> 2718;
		2716 -> 2717;
	2718 [label="我知道这种宅男的东西不是你的菜，但我敢打赌如果你尝试一下，你会发现这比你想象的更有趣",shape=box,color=red];
		2718 -> 2720;
	2717 [label="你知道的。一起笑、一起玩、一起喝酒、一起吃零食，玩得开心。这对他来说意义重大。",shape=box,color=red];
