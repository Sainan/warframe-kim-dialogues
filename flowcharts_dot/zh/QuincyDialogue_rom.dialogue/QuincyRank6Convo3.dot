digraph {
	"QuincyRank6Convo3 begins." [color=orange];
		"QuincyRank6Convo3 begins." -> j3710771318;
	j3710771318 [label="Check boolean QuincyDating",color=orange];
		j3710771318 -> j2923738337 [label=true,color=green];
		j3710771318 -> j664249213 [label=false,color=brown];
	j2923738337 [label="宝贝，有个奇怪的问题",shape=box,color=blue];
		j2923738337 -> j669828914;
		j2923738337 -> j1117479212;
	j664249213 [label="家人，有个奇怪的问题",shape=box,color=blue];
		j664249213 -> j669828914;
		j664249213 -> j1117479212;
	j669828914 [label="来吧。等等。我说不是让你真的动手。*你*可能真的能从你现在的位置打中我。",shape=box,color=red];
		j669828914 -> j3192486430;
	j1117479212 [label="说吧。",shape=box,color=red];
		j1117479212 -> j3192486430;
	j3192486430 [label="那个我一直在城镇里发现这些奇怪的……像是…… ",shape=box,color=blue];
		j3192486430 -> j2772161423;
	j2772161423 [label="我甚至不知道该怎么叫它们",shape=box,color=blue];
		j2772161423 -> j3863071542;
	j3863071542 [label="它们可不像熔岩灯或那些会喝水的鸟",shape=box,color=blue];
		j3863071542 -> j160636362;
	j160636362 [label="我把找到的一个给粉头发看，她称之为“潜在的永动机”",shape=box,color=blue];
		j160636362 -> j817147349;
		j160636362 -> j3198400782;
		j160636362 -> j2477231631;
	j817147349 [label="不知道你在说什么。",shape=box,color=red];
		j817147349 -> j4388228;
	j3198400782 [label="我想我知道你在说什么。",shape=box,color=red];
		j3198400782 -> j2822515208;
	j2477231631 [label="粉头发？噢。卡娅？",shape=box,color=red];
		j2477231631 -> j1220456149;
	j4388228 [label="好吧，随便吧",shape=box,color=blue];
		j4388228 -> "Chat ends.";
	j2822515208 [label="听你这么说真好，他们肯定不是来自这里，伙计，哈哈",shape=box,color=blue];
		j2822515208 -> j2135537224;
		j2822515208 -> j1999019130;
	j1220456149 [label="对。她说它们来自未来。我的意思是，当然了，它们绝对不是来自这里的，哈哈",shape=box,color=blue];
		j1220456149 -> j2135537224;
		j1220456149 -> j1999019130;
	"Chat ends." [color=orange];
	j2135537224 [label="嗯……你确定阿米尔没有“超频”他桌上的玩具吗？",shape=box,color=red];
		j2135537224 -> j3961010874;
	j1999019130 [label="我想你说的是“阿耶檀识塑像”。",shape=box,color=red];
		j1999019130 -> j421543369;
	j3961010874 [label="我非常肯定",shape=box,color=blue];
		j3961010874 -> j792623214;
		j3961010874 -> j484454087;
	j421543369 [label="天啊。又来了。这是一个“让昆西-克后悔问未来的问题”的时刻，对吧？",shape=box,color=blue];
		j421543369 -> j184497764;
		j421543369 -> j1553461741;
	j792623214 [label="不知道，抱歉。",shape=box,color=red];
		j792623214 -> j85250612;
	j484454087 [label="可能是“阿耶檀识塑像”？",shape=box,color=red];
		j484454087 -> j421543369;
	j184497764 [label="我是说，这不是我的错。未来只是……",shape=box,color=red];
		j184497764 -> j1849142960;
	j1553461741 [label="是的。没错，它是。",shape=box,color=red];
		j1553461741 -> j4192874885;
	j85250612 [label="好",shape=box,color=blue];
		j85250612 -> "Chat ends.";
	j1849142960 [label="全他妈的塞满了更糟糕的东西？",shape=box,color=blue];
		j1849142960 -> j4069678207;
	j4192874885 [label="我不想知道，但是……好吧……告诉我，这是什么鬼东西？",shape=box,color=blue];
		j4192874885 -> j3429738185;
		j4192874885 -> j1862651083;
	j4069678207 [label="Check boolean QuincySpaceTrauma",color=orange];
		j4069678207 -> j31424218 [label=true,color=green];
		j4069678207 -> j1682089147 [label=false,color=brown];
	j3429738185 [label="好吧，详细来说就是——",shape=box,color=red];
		j3429738185 -> j1302427685;
	j1862651083 [label="好吧，长话短说就是——",shape=box,color=red];
		j1862651083 -> j1400120463;
	j31424218 [label="我本来想说“太空创伤”的，不过这么说也行。",shape=box,color=red];
		j31424218 -> j4192874885;
	j1682089147 [label="简而言之呢？是的。",shape=box,color=red];
		j1682089147 -> j4192874885;
	j1302427685 [label="阿耶檀识塑像是古老的奥罗金神器，与奥罗金“延续”的仪式有关。",shape=box,color=red];
		j1302427685 -> j2867745828;
		j1302427685 -> j1507539880;
	j1400120463 [label="阿耶檀识塑像是用来储存奥罗金最美好的回忆的……",shape=box,color=red];
		j1400120463 -> j595644140;
		j1400120463 -> j2635322503;
	j2867745828 [label="这个我们……现在就不讲了，因为那可是另一个麻烦的开始。",shape=box,color=red];
		j2867745828 -> j802370630;
	j1507539880 [label="延续是奥罗金人用来将他们的意识转移到另一个身体的仪式。",shape=box,color=red];
		j1507539880 -> j681685409;
	j595644140 [label="他们自诩为神。他们最美好的回忆往往是关于酷刑、鞭打、屠杀……处决的场景。",shape=box,color=red];
		j595644140 -> j4097434343;
	j2635322503 [label="当你长生不老的时候，你可以随时把你的意识放到另一个身体里……",shape=box,color=red];
		j2635322503 -> j4097434343;
	j802370630 [label="嗯，好的，没问题。直接跳过那部分，为什么不呢",shape=box,color=blue];
		j802370630 -> j1840104165;
		j802370630 -> j1582002951;
	j681685409 [label="喂，等等，什么",shape=box,color=blue];
		j681685409 -> j512368917;
	j4097434343 [label="宇宙级残酷事件被永久保存于软盘中",shape=box,color=blue];
		j4097434343 -> j2654380210;
	j1840104165 [label="如果我说完奥罗金做过的每一件坏事我们就得在这里待上一整年了。",shape=box,color=red];
		j1840104165 -> j2278570342;
		j1840104165 -> j3577027678;
	j1582002951 [label="我大概总结了一下，可能解释得有点多，抱歉。",shape=box,color=red];
		j1582002951 -> j2278570342;
		j1582002951 -> j3577027678;
	j512368917 [label="基本上，奥罗金人是“不朽的”，因为他们可以将自己的意识永久地放入其他身体。",shape=box,color=red];
		j512368917 -> j1645367342;
	j2654380210 [label="来自地狱的家庭电影……",shape=box,color=blue];
		j2654380210 -> j2123549508;
		j2654380210 -> j187562091;
	j2278570342 [label="总之，总结一下，阿耶檀识塑像是用来储存奥罗金最美好的回忆的……",shape=box,color=red];
		j2278570342 -> j2079735702;
	j3577027678 [label="所以，阿耶檀识塑像可以装上阿耶檀识之星。装上后，它们就会动起来。",shape=box,color=red];
		j3577027678 -> j2616061381;
	j1645367342 [label="他们会挑选年轻漂亮的“青春之躯”作为被迫的宿主，用赤毒摧毁原主人的意识，用自己的意识取而代之。",shape=box,color=red];
		j1645367342 -> j3628591196;
	j2123549508 [label="它们还包含了战甲的蓝图。很多我们还在探索中。",shape=box,color=red];
		j2123549508 -> j3933075606;
	j187562091 [label="好消息是，它们在未来会派上用场。我们可以把它们熔化，用来升级我们的武器。",shape=box,color=red];
		j187562091 -> j1067844201;
	j2079735702 [label="所以接下来就是会让我做噩梦的部分，对吧",shape=box,color=blue];
		j2079735702 -> j595644140;
		j2079735702 -> j2635322503;
	j2616061381 [label="阿耶檀识之星充满了阿耶精华。",shape=box,color=red];
		j2616061381 -> j43465699;
	j3628591196 [label="我要是再遇到这些混蛋中我一定要揍他一顿，伙计",shape=box,color=blue];
		j3628591196 -> j1630991079;
		j3628591196 -> j3242210055;
		j3628591196 -> j327275888;
	j3933075606 [label="很高兴它们还有点用",shape=box,color=blue];
		j3933075606 -> j1379409598;
	j1067844201 [label="Check boolean QuincyDating",color=orange];
		j1067844201 -> j2984396476 [label=true,color=green];
		j1067844201 -> j2361463243 [label=false,color=brown];
	j43465699 [label="而阿耶精华就像……Ordis 曾称它为“记忆等离子体”。它几乎可以存储任何东西。",shape=box,color=red];
		j43465699 -> j3000583038;
	j1630991079 [label="嗯，他们……总体来说，都不是什么好人。",shape=box,color=red];
		j1630991079 -> j1151257293;
	j3242210055 [label="当整个社会都围绕着告诉你某件事不仅“没问题”，而且“备受尊崇”时，有时在当下很难看清它的本质。",shape=box,color=red];
		j3242210055 -> j2050942748;
	j327275888 [label="我们才刚刚开始。",shape=box,color=red];
		j327275888 -> j1575161634;
	j1379409598 [label="总有一天，我真希望你用完那些令人毛骨悚然的太空创伤案例来教我",shape=box,color=blue];
		j1379409598 -> j740798375;
	j2984396476 [label="说起来，你一定会*非常*喜欢瓦奇娅和 Maroo。而他们也会*非常*喜欢你。可能有点过头了。;)",shape=box,color=red];
		j2984396476 -> j2197783168;
	j2361463243 [label="说起来，你一定会*非常*喜欢瓦奇娅和 Maroo。而他们也会*非常*喜欢你。",shape=box,color=red];
		j2361463243 -> j2452556305;
	j3000583038 [label="你得用另一种方式跟我解释，伙计",shape=box,color=blue];
		j3000583038 -> j3202439112;
	j1151257293 [label="所以你打算告诉我他妈的那些古老的、满是灰尘的、永远活着的蛋蛋和这个乱七八糟的桌面玩具有什么关系吗哈哈哈",shape=box,color=blue];
		j1151257293 -> j2278570342;
		j1151257293 -> j3577027678;
	j2050942748 [label="直到奥罗金处决了哲士 Margulis，Tenno 才有了动机反抗奥罗金。而这并非因为“延续”或“青春厅堂”之类的原因。",shape=box,color=red];
		j2050942748 -> j434991326;
	j1575161634 [label="是的，我想说",shape=box,color=blue];
		j1575161634 -> j362791396;
	j740798375 [label="再见啦",shape=box,color=blue];
		j740798375 -> "Chat ends.";
	j2197783168 [label="哈哈哈哈，别嫉妒啦宝贝，我们只有在你同意的情况下才会那样玩噢哈哈哈",shape=box,color=blue];
		j2197783168 -> j3704594173;
	j2452556305 [label="哈哈哈哈，真的吗？也许我得去找粉头发聊聊，让我搭个顺风车",shape=box,color=blue];
		j2452556305 -> j604291234;
	j3202439112 [label="这样想吧。阿耶精华就像录像系统中的磁带。阿耶檀识之星就像你把磁带放入录像带盒后的样子。 ",shape=box,color=red];
		j3202439112 -> j1039248806;
	j434991326 [label="+5 Chemistry",color=orange];
		j434991326 -> j400526365;
	j362791396 [label="你到现在还没告诉我这个破玩意儿到底是什么鬼，还有它跟那些古老的、满是灰尘的、永远活着的蛋蛋有什么关系啊哈哈哈",shape=box,color=blue];
		j362791396 -> j2278570342;
		j362791396 -> j3577027678;
	j3704594173 [label="还有，每当我对未来了解得越多，我就越庆幸自己被困在过去",shape=box,color=blue];
		j3704594173 -> j2108734085;
	j604291234 [label="开玩笑的，开玩笑的，每当我对未来了解得越多，我就越庆幸自己被困在过去",shape=box,color=blue];
		j604291234 -> j2108734085;
	j1039248806 [label="阿耶檀识塑像就像是录像系统一样。",shape=box,color=red];
		j1039248806 -> j3258215409;
	j400526365 [label="不，你说得对。人们很容易将发生的事情视为恶人所为，但当整个社会都这样做时，就不是这样了，不是吗？",shape=box,color=blue];
		j400526365 -> j2755946406;
	j2108734085 [label="我很高兴它们被善加利用了，而且被熔化了",shape=box,color=blue];
		j2108734085 -> j1379409598;
	j3258215409 [label="……我想知道什么样的显示器可以播放那些破旧的未来录像带吗……？",shape=box,color=blue];
		j3258215409 -> j2823794196;
	j2755946406 [label="人们在那个世界中成长，被那个世界养育，相信那个世界，并为之努力建设",shape=box,color=blue];
		j2755946406 -> j3182766009;
	j2823794196 [label="奥罗金他们自己。比如，一个奥罗金个体。他们主要用这些来存储自己最美好的回忆。",shape=box,color=red];
		j2823794196 -> j2079735702;
	j3182766009 [label="拆掉它也花了不少功夫。你的世界还在处理这件事吗？",shape=box,color=blue];
		j3182766009 -> j367245501;
	j367245501 [label="同样的狗屁，不同的时间。我想有一件事是永远不变的，对吧？无论何时何地，人就是人。",shape=box,color=blue];
		j367245501 -> j362791396;
}