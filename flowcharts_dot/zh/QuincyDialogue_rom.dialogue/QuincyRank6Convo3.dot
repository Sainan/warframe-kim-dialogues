		3664 -> 3668;
	3665 [label="延续是奥罗金人用来将他们的意识转移到另一个身体的仪式。",shape=box,color=red];
		3665 -> 3669;
	3666 [label="他们自诩为神。他们最美好的回忆往往是关于酷刑、鞭打、屠杀……处决的场景。",shape=box,color=red];
		3666 -> 3670;
	3667 [label="当你长生不老的时候，你可以随时把你的意识放到另一个身体里……",shape=box,color=red];
		3667 -> 3670;
	3668 [label="嗯，好的，没问题。直接跳过那部分，为什么不呢",shape=box,color=blue];
