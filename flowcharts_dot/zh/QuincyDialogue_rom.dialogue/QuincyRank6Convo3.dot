	3672 [label="我大概总结了一下，可能解释得有点多，抱歉。",shape=box,color=red];
		3672 -> 3675;
		3672 -> 3676;
	3673 [label="基本上，奥罗金人是“不朽的”，因为他们可以将自己的意识永久地放入其他身体。",shape=box,color=red];
