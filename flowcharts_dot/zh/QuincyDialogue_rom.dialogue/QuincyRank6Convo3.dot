		3693 -> 3675;
		3693 -> 3676;
	3694 [label="直到奥罗金处决了哲士 Margulis，Tenno 才有了动机反抗奥罗金。而这并非因为“延续”或“青春厅堂”之类的原因。",shape=box,color=red];
