digraph {
	1351 [label="QuincyRank3Convo3 begins.",color=orange];
		1351 -> 1352;
	1352 [label="那个……巨大怪异的无毛猫怪物是怎么回事？",shape=box,color=blue];
		1352 -> 1353;
		1352 -> 1354;
		1352 -> 1355;
	1353 [label="你是在问我关于卡利莫斯的事吗？老实说，我也不太清楚。",shape=box,color=red];
		1353 -> 1356;
	1354 [label="你是指她是只巨型猫怪物，还是她的具体情况？",shape=box,color=red];
		1354 -> 1357;
	1355 [label="马上回来，得去喂那只巨大怪异的无毛猫怪物。[结束]",shape=box,color=red];
		1355 -> 1359;
	1356 [label="哈哈，这可真是个好兆头。如果连你都不知道，我们该怎么办？",shape=box,color=blue];
		1356 -> 1361;
	1357 [label="嗯，好吧，既然你这么问？哈哈。两者都有",shape=box,color=blue];
		1357 -> 1362;
		1357 -> 1363;
		1357 -> 1364;
	1359 [label="+20 Chemistry",color=orange];
		1359 -> 1358;
	1361 [label="有点觉得我不应该对它掉以轻心。我是不是该担心它还在为英择谛干活？",shape=box,color=blue];
		1361 -> 1364;
		1361 -> 1363;
	1362 [label="那么，据我所知，库娃，也就是卡利莫斯，是从体型较小的“猫”进化而来的。",shape=box,color=red];
		1362 -> 1365;
	1363 [label="老实说，我觉得卡利莫斯已经受够了英择谛的那些破事。就像很多人一样。",shape=box,color=red];
		1363 -> 1369;
	1364 [label="有这种可能？我的意思是，它毕竟是只库娃。它们总是有*那么点*狡猾的，对吧？哈哈。",shape=box,color=red];
		1364 -> 1370;
	1358 [label="……嗯好吧，挺搞笑的，哈哈，6/10 分",shape=box,color=blue];
		1358 -> 1360;
	1365 [label="太棒了。巨型杀人猫",shape=box,color=blue];
		1365 -> 1366;
	1369 [label="这说明她比普通猫聪明，不是吗",shape=box,color=blue];
		1369 -> 1372;
	1370 [label="这正是我喜欢狗的原因，你明白我的意思吗？即使猫再爱你，你也不能完全信任它们",shape=box,color=blue];
		1370 -> 1371;
	1360 [label="Chat ends.",color=orange];
	1366 [label="但我是不是该担心它还在为英择谛干活",shape=box,color=blue];
		1366 -> 1367;
		1366 -> 1368;
	1372 [label="我的意思是，我们是在讨论类似人类的智力水平吗？实话告诉我",shape=box,color=blue];
		1372 -> 1374;
	1371 [label="我奶奶有时候会把我留在她朋友家。那是个和蔼的老太太。她养了一只猫，那猫简直是疯了",shape=box,color=blue];
		1371 -> 1373;
	1367 [label="我的意思是，“猫”总是有那么点狡猾的，对吧？哈哈。",shape=box,color=red];
		1367 -> 1370;
	1368 [label="如果你是英择谛的宠物，你也会对他的所作所为感到不满吗？",shape=box,color=red];
		1368 -> 1369;
	1374 [label="Check boolean LettieCavia",color=orange];
		1374 -> 1375 [label=true,color=green];
		1374 -> 1376 [label=false,color=brown];
	1373 [label="伙计，它一开始看起来都挺好的，温柔、甜美，还会呼噜呼噜地表达爱意，然后就在你以为自己很安全的时候……突然来一爪子挠你脸",shape=box,color=blue];
		1373 -> 1380;
	1375 [label="她是不是像莱蒂跟我提到的那些科维兽一样？她当时简直气得炸了，真是好久没见她这么生气了",shape=box,color=blue];
		1375 -> 1378;
		1375 -> 1379;
	1376 [label="我的意思是……英择谛以前也创造过具有人类智力的动物。但它们通常都会说话。",shape=box,color=red];
		1376 -> 1377;
	1380 [label="猫啊。它们总是一炸毛就准备抓瞎你的眼睛",shape=box,color=blue];
		1380 -> 1382;
		1380 -> 1383;
	1378 [label="我觉得她和我们一样聪明。她只是在装酷，我不打算去和她对峙，因为我还想保住我的脸。",shape=box,color=red];
		1378 -> 1381;
	1379 [label="我敢肯定，如果卡利莫斯有那么聪明，她应该早就让我们知道了……对吧？",shape=box,color=red];
		1379 -> 1381;
	1377 [label="它们被称为科维兽。但我敢肯定，如果卡利莫斯是其中之一，她应该早就让我们知道了……对吧？",shape=box,color=red];
		1377 -> 1381;
	1382 [label="不过，我喜欢库娃。聪明、优雅。它们爱你是因为它们选择爱你。库狛——不好意思，是狗——它们天生就是那样的。",shape=box,color=red];
		1382 -> 1385;
	1383 [label="我同意你的观点。我也是个爱库狛——不好意思，是爱狗——的人。",shape=box,color=red];
		1383 -> 1384;
	1381 [label="哈哈，我可以给你讲我一个前任的故事",shape=box,color=blue];
		1381 -> 1389;
	1385 [label="猫总是在搞鬼",shape=box,color=blue];
		1385 -> 1386;
	1384 [label="狗总是很高兴见到你。只想要爱。",shape=box,color=blue];
		1384 -> 1385;
	1389 [label="她以前总是这样装羞涩。然后在你最意想不到的时候……？谋杀。大家都低估了她。包括我",shape=box,color=blue];
		1389 -> 1390;
	1386 [label="我感觉那只怪异猫现在可能没恶意，但它肯定有什么企图",shape=box,color=blue];
		1386 -> 1387;
		1386 -> 1388;
	1390 [label="我再也不会犯同样的错误了。不管是对人还是对一只巨型怪物猫",shape=box,color=blue];
		1390 -> 1391;
	1387 [label="我不知道。我知道被利用和被忽视是什么感觉。如果她想留下来？她可以有个温暖的床位，还有我随时给她挠痒痒。",shape=box,color=red];
		1387 -> 1397;
	1388 [label="明智的建议。谢谢。",shape=box,color=red];
		1388 -> 1394;
	1391 [label="我可不打算对那东西掉以轻心，你也最好小心点",shape=box,color=blue];
		1391 -> 1387;
		1391 -> 1388;
	1397 [label="+20 Chemistry",color=orange];
		1397 -> 1392;
	1394 [label="+10 Chemistry",color=orange];
		1394 -> 1395;
	1392 [label="……是的，你说得对。我们都在某种程度上是被那个混蛋抛弃的流浪者，对吧",shape=box,color=blue];
		1392 -> 1393;
	1395 [label="Chat ends.",color=orange];
	1393 [label="就像另一件被利用后丢弃的东西，即使她是只怪异的变异猫。……如果她吃了我，我希望你知道这都是你的错",shape=box,color=blue];
		1393 -> 1396;
	1396 [label="Update boolean QuincyToySoldier1",color=orange];
		1396 -> 1398;
	1398 [label="Chat ends.",color=orange];
}