digraph {
	1132 [label="QuincyRank3Convo1 begins.",color=orange];
		1132 -> 1175;
		1132 -> 1176;
		1132 -> 1177;
	1175 [label="我觉得问你准没错。除了线上时代之外，这个时代还有其他音乐吗？",shape=box,color=red];
		1175 -> 1178;
	1176 [label="昆西，你听什么音乐？",shape=box,color=red];
		1176 -> 1178;
	1177 [label="[无视]",shape=box,color=red];
		1177 -> 1179;
	1178 [label="为什么这么问？你厌倦了那些男孩和他们唱的歌吗？哈哈",shape=box,color=blue];
		1178 -> 1180;
	1179 [label="Chat ends.",color=orange];
	1180 [label="真没什么，说真的。我不会贬低那些靠这个谋生的人",shape=box,color=blue];
		1180 -> 1181;
	1181 [label="我知道名利是要付出代价的，生活中没有免费的午餐，但看起来还不错",shape=box,color=blue];
		1181 -> 1182;
		1181 -> 1183;
		1181 -> 1184;
		1181 -> 1185;
	1182 [label="我只是需要听点别的。这个只是……不太合我胃口。",shape=box,color=red];
		1182 -> 1188;
	1183 [label="我不认为我想那样谋生……压力太大了。太多曝光了。",shape=box,color=red];
		1183 -> 1186;
	1184 [label="所有那些崇拜你的粉丝？所有那些想要一睹你风采的人们？那肯定很棒。",shape=box,color=red];
		1184 -> 1187;
	1185 [label="我只希望我能忽略他们。我不知道碧是怎么忍受他们的。",shape=box,color=red];
		1185 -> 1190;
	1188 [label="明白，明白。老表，我个人也不太喜欢。我会看看能帮你找点什么。末日铁指、莫斯·普博、德瑞教授",shape=box,color=blue];
		1188 -> 1193;
	1186 [label="Update boolean QuincyFamous",color=orange];
		1186 -> 1189;
	1187 [label="Update boolean QuincyFamous",color=orange];
		1187 -> 1191;
	1190 [label="别敢小看她的喜好。这个世界上的快乐本就不够大家分享，不要试图夺走她仅有的一点",shape=box,color=blue];
		1190 -> 1192;
	1193 [label="给你找到感觉，然后来点炸场的韵脚，很快就能让你改变看法",shape=box,color=blue];
		1193 -> 1194;
		1193 -> 1195;
	1189 [label="真的吗？不，那才是我的梦想。站在聚光灯下？男人、女人都对我垂涎三尺？钱源源不断地进来，每晚都开派对？",shape=box,color=blue];
		1189 -> 1196;
	1191 [label="你懂我。那才是梦想。站在聚光灯下？男人、女人都对我垂涎三尺？钱源源不断地进来，每晚都开派对？",shape=box,color=blue];
		1191 -> 1196;
	1192 [label="那是最容易让她生气的方式，也会让我觉得你没有你想的那么了不起",shape=box,color=blue];
		1192 -> 1222;
		1192 -> 1223;
	1194 [label="听起来挺不错。:)",shape=box,color=red];
		1194 -> 1203;
	1195 [label="我感觉我就是来给自己找麻烦的。",shape=box,color=red];
		1195 -> 1942;
	1196 [label="伙计，太他妈棒了。不过现在不太可能实现了。除非你有厉害的魔术招数",shape=box,color=blue];
		1196 -> 1198;
		1196 -> 1199;
	1222 [label="哎呀……对不起。对不起。它们只是不是我的菜。",shape=box,color=red];
		1222 -> 1224;
	1223 [label="我没意识到你这么护着她。",shape=box,color=red];
		1223 -> 1225;
	1203 [label="+20 Chemistry",color=orange];
		1203 -> 1201;
	1942 [label="+20 Chemistry",color=orange];
		1942 -> 1202;
	1198 [label="话说，商场里有个舞台的……",shape=box,color=red];
		1198 -> 1197;
	1199 [label="我不认为我有*那种*魔术招数。抱歉。",shape=box,color=red];
		1199 -> 1200;
	1224 [label="老表，那你为什么非得扯上别人名字？为什么不直接开始？",shape=box,color=blue];
		1224 -> 1237;
	1225 [label="Check boolean QuincyDrifterNoHome",color=orange];
		1225 -> 1226 [label=true,color=green];
		1225 -> 1227 [label=false,color=brown];
	1201 [label="老表，说得对",shape=box,color=blue];
		1201 -> 1204;
	1202 [label="老表，这就是最好的生活方式。我会帮你的，别担心",shape=box,color=blue];
		1202 -> 1204;
	1197 [label="哈哈，我不是在说什么开放麦克风之夜啦，但还是谢谢你的支持。……再说了，我唱歌可是一塌糊涂。虽然多少有些节奏感，但我还是有自知之明的",shape=box,color=blue];
		1197 -> 1205;
	1200 [label="嗯，没关系。反正只是白日梦而已。我唱歌可是一塌糊涂，哈哈。虽然多少有些节奏感，但我还是有自知之明的",shape=box,color=blue];
		1200 -> 1205;
	1237 [label="明白，明白。老表，我个人也不太喜欢。我会看看能帮你找点什么。末日铁指、莫斯·普博、德瑞教授",shape=box,color=blue];
		1237 -> 1243;
		1237 -> 1241;
	1226 [label="哈哈哈哈你真的不懂怎么交朋友啊",shape=box,color=blue];
		1226 -> 1228;
		1226 -> 1229;
	1227 [label="这不是——妈的，你怎么这么笨？难怪你没朋友",shape=box,color=blue];
		1227 -> 1228;
		1227 -> 1229;
	1204 [label="Chat ends.",color=orange];
	1205 [label="我之所以拿着瞄准镜干活是有原因的，哈哈哈哈，你绝对不想听我拿着麦克风唱歌。之前在国危部的时候，碧把我灌得醉醺醺的，我们那时还在休假，莱蒂、亚瑟、碧，还有其他几个人，然后我们……唱了卡啦OK？不知道有没有写对这词",shape=box,color=blue];
		1205 -> 1206;
	1243 [label="听起来挺不错。:)",shape=box,color=red];
		1243 -> 1239;
	1241 [label="我感觉我就是来给自己找麻烦的。",shape=box,color=red];
		1241 -> 1943;
	1228 [label="我……有朋友。",shape=box,color=red];
		1228 -> 1230;
	1229 [label="我只是想问问你有没有音乐推荐。我们为什么要吵架呢？",shape=box,color=red];
		1229 -> 1231;
	1206 [label="我把场子给清空了，哈哈哈哈。你知道谁有一副铁肺吗？英雄仔。有个好故事。等大家都走后……他已经喝了 5 大杯啤酒，是吧？",shape=box,color=blue];
		1206 -> 1207;
	1239 [label="+5 Chemistry",color=orange];
		1239 -> 1242;
	1943 [label="+5 Chemistry",color=orange];
		1943 -> 1240;
	1230 [label="呵呵。看吧，伙计。选择你的小队可以有很多理由。但因为音乐品味而瞧不起人，那可不行",shape=box,color=blue];
		1230 -> 1232;
	1231 [label="因为你带着那种高人一等的态度来，我可受不了这一套",shape=box,color=blue];
		1231 -> 1233;
		1231 -> 1234;
	1207 [label="Update boolean QuincyArthur2",color=orange];
		1207 -> 1208;
	1242 [label="老表，说得对",shape=box,color=blue];
		1242 -> 1238;
	1240 [label="老表，这就是最好的生活方式。我会帮你的，别担心",shape=box,color=blue];
		1240 -> 1238;
	1232 [label="碧喜欢什么就让她去喜欢。你可以不加入。只是别嘲讽人家",shape=box,color=blue];
		1232 -> 1233;
		1232 -> 1234;
	1233 [label="抱歉。我并不想假装自己比别人优秀。那些东西真的让我受不了。",shape=box,color=red];
		1233 -> 1235;
	1234 [label="伙计，我只是说出我所看到的。",shape=box,color=red];
		1234 -> 1236;
	1208 [label="他开始在大腿上捶打，然后开始不用麦克风唱歌。闭着眼睛。不知道歌名是什么。但听他唱那歌词真的让人起鸡皮疙瘩。就像有幽灵回来摸了我一样",shape=box,color=blue];
		1208 -> 1209;
	1238 [label="Chat ends.",color=orange];
	1235 [label="那你只要这么说就好",shape=box,color=blue];
		1235 -> 1237;
	1236 [label="随便吧，白痴",shape=box,color=blue];
		1236 -> 1244;
	1209 [label="“为什么你坐在我的坟墓上，让死去的嘴唇说话？为什么你在我的坟墓上哭泣，不让我安睡？”",shape=box,color=blue];
		1209 -> 1210;
	1244 [label="Chat ends.",color=orange];
	1210 [label="“我的胸膛冰冷如泥土，我的呼吸带着尘土。如果你亲吻我冰冷的泥土嘴唇，你的日子将不会长久”",shape=box,color=blue];
		1210 -> 1211;
	1211 [label="……光是想想，我又起鸡皮疙瘩了，靠",shape=box,color=blue];
		1211 -> 1212;
	1212 [label="他唱完后，我们全都静静地坐在那里……盯着他看了几分钟，不知道该怎么办",shape=box,color=blue];
		1212 -> 1213;
	1213 [label="我是第一个开口的。我得说点什么。告诉他我的想法",shape=box,color=blue];
		1213 -> 1214;
		1213 -> 1215;
	1214 [label="那你说了什么……？",shape=box,color=red];
		1214 -> 1220;
	1215 [label="你当时在想什么？",shape=box,color=red];
		1215 -> 1220;
	1220 [label="+20 Chemistry",color=orange];
		1220 -> 1216;
	1216 [label="“扫兴王！！”",shape=box,color=blue];
		1216 -> 1217;
	1217 [label="哈哈哈，他看起来好生气。伙计，宇宙定律都有：重力、税收、财迷总能赚到钱……",shape=box,color=blue];
		1217 -> 1218;
	1218 [label="还有陛下开不起玩笑，哈哈",shape=box,color=blue];
		1218 -> 1219;
