	3146 [label="行了，自作聪明，哈哈，好吧，那你给我讲讲吧？那些是什么东西？",shape=box,color=blue];
		3146 -> 3147;
		3146 -> 3148;
	3143 [label="灵化武器是……很奇怪。哪怕是在我用的武器里也很特别。",shape=box,color=red];
		3143 -> 3145;
	3144 [label="我的就这样。:)",shape=box,color=red];
		3144 -> 3146;
	3147 [label="灵化武器是接触过虚空的武器。有近战武器和枪械。它们……对能量有反应。",shape=box,color=red];
		3147 -> 3150;
	3148 [label="是这样，扎里曼号上有个人。他叫卡瓦莱罗……我突然很想让你们认识一下。",shape=box,color=red];
		3148 -> 3149;
	3145 [label="能给我讲讲这个吗？那些东西是什么？",shape=box,color=blue];
		3145 -> 3147;
		3145 -> 3148;
	3150 [label="你听起来好像不太确定",shape=box,color=blue];
		3150 -> 3153;
		3150 -> 3152;
	3149 [label="话说回来。他开始制造这些接触过虚空的武器。近战武器和枪械。它们对能量有反应。……我猜的。",shape=box,color=red];
		3149 -> 3151;
	3153 [label="我的意思是……我会让枪口朝外，远离我的脸。其他的我不需要太在意。",shape=box,color=red];
		3153 -> 3161;
		3153 -> 3160;
	3152 [label="好吧，你看。虽然我*使用*虚空的力量，但这并不意味着我完全懂它是怎么运作的。这些武器接入虚空进行变形。",shape=box,color=red];
		3152 -> 3161;
		3152 -> 3160;
	3151 [label="你听起来好像不太确定。还有，卡瓦莱罗是谁？",shape=box,color=blue];
		3151 -> 3152;
		3151 -> 3154;
	3161 [label="据我所知，它们能从我杀死的敌人那里吸取能量。这就是它们能够变形的原因。",shape=box,color=red];
		3161 -> 3162;
	3160 [label="虚空……对很多东西都有一些奇怪的……作用。真的……很难每次都解释清楚。但你可以这么想……",shape=box,color=red];
		3160 -> 3163;
	3154 [label="卡瓦莱罗是扎里曼号上的一名坚守者。一个幽灵，找不到更好的词来形容他。他脾气暴躁。负责管理武器。基本上是个讨厌鬼。你会喜欢他的。",shape=box,color=red];
		3154 -> 3155;
	3162 [label="它们……吃人。你的武器会吃人",shape=box,color=blue];
