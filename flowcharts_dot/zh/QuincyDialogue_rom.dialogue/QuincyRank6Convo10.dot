		3901 -> 3905;
	3902 [label="那是什么？我没听到。哈哈",shape=box,color=red];
		3902 -> 3906;
	3903 [label="对！或者……那什么……泡博？或者你们时代用的称呼也行",shape=box,color=blue];
		3903 -> 3904;
	3904 [label="于是我低头一看，发现有一只小老鼠像个黑帮老大一样，悠哉游哉趴在我的腿上，抬头看着我，好像在说“怎么了，兄弟”",shape=box,color=blue];
		3904 -> 3907;
	3905 [label="对，你知道，就像老鼠发出的滋滋声",shape=box,color=blue];
		3905 -> 3908;
		3905 -> 3900;
	3906 [label="闭嘴，笨蛋",shape=box,color=blue];
		3906 -> 3904;
	3907 [label="我想“哦，嘿，是莱蒂家的老鼠来跟我打个招呼了，“嘿，小家伙”——所以我坐在那里和这个小家伙说话，喂他一些我的披萨，对吧？",shape=box,color=blue];
		3907 -> 3909;
	3908 [label="我认应该要这样写：“吱”。",shape=box,color=red];
		3908 -> 3910;
	3909 [label="给那只小老大一些水，跟他讲解我正在做的事情，教他如何清洁枪里的弹簧，哈哈",shape=box,color=blue];
		3909 -> 3911;
	3910 [label="我之前从来没有写过这个字，所以伙计，我特么谢谢你",shape=box,color=blue];
		3910 -> 3912;
	3911 [label="他一直坐在那里，就这么看着我，听着我说，还清理他的小胡须",shape=box,color=blue];
		3911 -> 3913;
	3912 [label="你还想不想听这个故事了？！",shape=box,color=blue];
		3912 -> 3914;
		3912 -> 3915;
		3912 -> 3916;
	3913 [label="可爱死了",shape=box,color=blue];
		3913 -> 3917;
	3914 [label="其实，我不想听。",shape=box,color=red];
		3914 -> 3918;
	3915 [label="对不起。:(",shape=box,color=red];
		3915 -> 3919;
	3916 [label="抱歉。请继续。",shape=box,color=red];
		3916 -> 3920;
	3917 [label="然后我忙完了，我就对他说“好了小家伙，我带你回去找妈妈”，所以他就像没事人一样跳到我的肩膀上，我就带他去找莱蒂了……",shape=box,color=blue];
		3917 -> 3921;
		3917 -> 3922;
	3918 [label="Chat ends.",color=orange];
	3919 [label="+5 Chemistry",color=orange];
		3919 -> 3923;
	3920 [label="嗯哼",shape=box,color=blue];
		3920 -> 3904;
	3921 [label="我大概猜到会发生什么了…… ",shape=box,color=red];
		3921 -> 3924;
	3922 [label="然后呢？",shape=box,color=red];
		3922 -> 3925;
	3923 [label="不用……对不起，我有时会因为这种事变得暴躁，我的错。话说回来",shape=box,color=blue];
