		3924 -> 3927 [label=false,color=brown];
	3925 [label="我来到莱蒂面前，说“这是你家的老鼠”，结果她说",shape=box,color=blue];
		3925 -> 3928;
	3926 [label="宝贝，没错，你猜对了",shape=box,color=blue];
