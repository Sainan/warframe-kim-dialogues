	"QuincyRank6Convo10 begins." [color=orange];
		"QuincyRank6Convo10 begins." -> j4065868373;
	j4065868373 [label="那啥我就坐在那做自己的事情，擦着军械库的枪，好吧？",shape=box,color=blue];
		j4065868373 -> j1665263192;
		j4065868373 -> j4109826591;
	j1665263192 [label="出什么事了。",shape=box,color=red];
		j1665263192 -> j3773503207;
	j4109826591 [label="然后呢？",shape=box,color=red];
		j4109826591 -> j3538930018;
	j3773503207 [label="不不，是个好事",shape=box,color=blue];
		j3773503207 -> j3209405857;
	j3538930018 [label="我正拆着一把艾弗旺-5，忽然听到一声“滋”",shape=box,color=blue];
		j3538930018 -> j3483136314;
		j3538930018 -> j3701638895;
		j3538930018 -> j1479684170;
		j3538930018 -> j3424814426;
	j3209405857 [label="言归正传",shape=box,color=blue];
		j3209405857 -> j3538930018;
	j3483136314 [label="像“老鼠”那样？",shape=box,color=red];
		j3483136314 -> j2848037388;
	j3701638895 [label="[让他继续]",shape=box,color=red];
		j3701638895 -> j3076309547;
	j1479684170 [label="滋？",shape=box,color=red];
		j1479684170 -> j3878178514;
	j3424814426 [label="那是什么？我没听到。哈哈",shape=box,color=red];
		j3424814426 -> j3274618430;
	j2848037388 [label="对！或者……那什么……泡博？或者你们时代用的称呼也行",shape=box,color=blue];
		j2848037388 -> j3076309547;
	j3076309547 [label="于是我低头一看，发现有一只小老鼠像个黑帮老大一样，悠哉游哉趴在我的腿上，抬头看着我，好像在说“怎么了，兄弟”",shape=box,color=blue];
		j3076309547 -> j4049261786;
	j3878178514 [label="对，你知道，就像老鼠发出的滋滋声",shape=box,color=blue];
		j3878178514 -> j784907391;
		j3878178514 -> j3701638895;
	j3274618430 [label="闭嘴，笨蛋",shape=box,color=blue];
		j3274618430 -> j3076309547;
	j4049261786 [label="我想“哦，嘿，是莱蒂家的老鼠来跟我打个招呼了，“嘿，小家伙”——所以我坐在那里和这个小家伙说话，喂他一些我的披萨，对吧？",shape=box,color=blue];
		j4049261786 -> j633138609;
	j784907391 [label="我认应该要这样写：“吱”。",shape=box,color=red];
		j784907391 -> j1095467759;
	j633138609 [label="给那只小老大一些水，跟他讲解我正在做的事情，教他如何清洁枪里的弹簧，哈哈",shape=box,color=blue];
		j633138609 -> j1278538903;
	j1095467759 [label="我之前从来没有写过这个字，所以伙计，我特么谢谢你",shape=box,color=blue];
		j1095467759 -> j2997899611;
	j1278538903 [label="他一直坐在那里，就这么看着我，听着我说，还清理他的小胡须",shape=box,color=blue];
		j1278538903 -> j451607799;
	j2997899611 [label="你还想不想听这个故事了？！",shape=box,color=blue];
		j2997899611 -> j2395994649;
		j2997899611 -> j651990255;
		j2997899611 -> j2430390057;
	j451607799 [label="可爱死了",shape=box,color=blue];
		j451607799 -> j1402287435;
	j2395994649 [label="其实，我不想听。",shape=box,color=red];
		j2395994649 -> "Chat ends.";
	j651990255 [label="对不起。:(",shape=box,color=red];
		j651990255 -> j3044102254;
	j2430390057 [label="抱歉。请继续。",shape=box,color=red];
		j2430390057 -> j2836246125;
	j1402287435 [label="然后我忙完了，我就对他说“好了小家伙，我带你回去找妈妈”，所以他就像没事人一样跳到我的肩膀上，我就带他去找莱蒂了……",shape=box,color=blue];
		j1402287435 -> j2783437980;
		j1402287435 -> j1306557885;
	"Chat ends." [color=orange];
	j3044102254 [label="+5 Chemistry",color=orange];
		j3044102254 -> j4064907275;
	j2836246125 [label="嗯哼",shape=box,color=blue];
		j2836246125 -> j3076309547;
	j2783437980 [label="我大概猜到会发生什么了…… ",shape=box,color=red];
		j2783437980 -> j3163411611;
	j1306557885 [label="然后呢？",shape=box,color=red];
		j1306557885 -> j3209210523;
	j4064907275 [label="不用……对不起，我有时会因为这种事变得暴躁，我的错。话说回来",shape=box,color=blue];
		j4064907275 -> j3076309547;
	j3163411611 [label="Check boolean QuincyDating",color=orange];
		j3163411611 -> j2482002242 [label=true,color=green];
		j3163411611 -> j2963734371 [label=false,color=brown];
	j3209210523 [label="我来到莱蒂面前，说“这是你家的老鼠”，结果她说",shape=box,color=blue];
		j3209210523 -> j686976059;
	j2482002242 [label="宝贝，没错，你猜对了",shape=box,color=blue];
		j2482002242 -> j3209210523;
	j2963734371 [label="家人，没错，你猜对了",shape=box,color=blue];
		j2963734371 -> j3209210523;
	j686976059 [label="“你疯了吧，我的小鼠都在我这”",shape=box,color=blue];
		j686976059 -> j3165974901;
	j3165974901 [label="我敢情是花了四个小时陪一只商场的野老鼠吃东西、陪他玩……",shape=box,color=blue];
		j3165974901 -> j929223101;
		j3165974901 -> j3470454306;
	j929223101 [label="那你后来怎么办了？",shape=box,color=red];
		j929223101 -> j617245721;
	j3470454306 [label="真的假的。",shape=box,color=red];
		j3470454306 -> j617245721;
	j617245721 [label="我现在看着他那张小脸",shape=box,color=blue];
		j617245721 -> j2748822193;
	j2748822193 [label="莱蒂已经笑到不行了",shape=box,color=blue];
		j2748822193 -> j3557435460;
	j3557435460 [label="然后……我现在有了一只宠物鼠……",shape=box,color=blue];
		j3557435460 -> j3209773114;
	j3209773114 [label="Boolean QuincyRat is now true.",color=orange];
		j3209773114 -> j4164993652;
	j4164993652 [label="还不知道该给他起什么名字……",shape=box,color=blue];
		j4164993652 -> j15688382;
	j15688382 [label="我本来想叫他“亚瑟”，但莱蒂说不行。哈哈。我晚点再决定吧。她说她会帮我给他准备小鼠用品",shape=box,color=blue];
		j15688382 -> j3473555632;
	j3473555632 [label="Check boolean QuincyRomance",color=orange];
		j3473555632 -> j901000014 [label=true,color=green];
		j3473555632 -> j1936152778 [label=false,color=brown];
		j3473555632 -> j2557624268 [label=false,color=brown];
	j901000014 [label="不过别担心，我会把他放在商场里的旧房间，我不想让你的动物变得奇怪",shape=box,color=blue];
		j901000014 -> j1009606776;
	j1936152778 [label="这听起来太可爱了。",shape=box,color=red];
		j1936152778 -> j2477373225;
	j2557624268 [label="在我看来，你不像是那种喜欢养小鼠的人。",shape=box,color=red];
		j2557624268 -> j3867449153;
	j1009606776 [label="你已经有个动物园了，哈哈哈",shape=box,color=blue];
		j1009606776 -> j2557624268;
		j1009606776 -> j1936152778;
	j2477373225 [label="我知道，我甚至都没有把他关在笼子里，他就一直跟着我 ",shape=box,color=blue];
		j2477373225 -> j2537344815;
	j3867449153 [label="有时候，只有经历了才会看清自己原来是什么样的人",shape=box,color=blue];
		j3867449153 -> j1425840325;
	j2537344815 [label="我实在狠不下心赶走他，也不忍心叫他别跟着我",shape=box,color=blue];
		j2537344815 -> j4274908132;
	j1425840325 [label="这是昆西-克今天的鸡汤语录",shape=box,color=blue];
		j1425840325 -> "Chat ends.";
	j4274908132 [label="……也许我应该给他起名叫阿米尔哈哈哈",shape=box,color=blue];
		j4274908132 -> j1018560734;
	j1018560734 [label="算了……",shape=box,color=blue];
		j1018560734 -> j176838411;
	j176838411 [label="行吧。我要去给他搭几个纸箱玩了，等会再聊",shape=box,color=blue];
		j176838411 -> "Chat ends.";
}