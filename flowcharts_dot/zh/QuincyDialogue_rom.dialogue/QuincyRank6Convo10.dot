		3927 -> 3925;
	3928 [label="“你疯了吧，我的小鼠都在我这”",shape=box,color=blue];
		3928 -> 3929;
	3929 [label="我敢情是花了四个小时陪一只商场的野老鼠吃东西、陪他玩……",shape=box,color=blue];
		3929 -> 3930;
		3929 -> 3931;
	3930 [label="那你后来怎么办了？",shape=box,color=red];
		3930 -> 3932;
	3931 [label="真的假的。",shape=box,color=red];
