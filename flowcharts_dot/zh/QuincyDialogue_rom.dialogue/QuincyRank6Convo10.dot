		3935 -> 3936;
	3936 [label="还不知道该给他起什么名字……",shape=box,color=blue];
		3936 -> 3937;
	3937 [label="我本来想叫他“亚瑟”，但莱蒂说不行。哈哈。我晚点再决定吧。她说她会帮我给他准备小鼠用品",shape=box,color=blue];
