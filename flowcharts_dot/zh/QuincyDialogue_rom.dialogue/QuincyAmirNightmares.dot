digraph {
	1898 [label="QuincyAmirNightmares begins.",color=orange];
		1898 -> 1897;
	1897 [label="嘿",shape=box,color=blue];
		1897 -> 1888;
	1888 [label="按照你说的，跟那个小飞毛腿谈过了",shape=box,color=blue];
		1888 -> 1901;
		1888 -> 1899;
		1888 -> 1904;
	1901 [label="结果怎样？",shape=box,color=red];
		1901 -> 1900;
	1899 [label="哇。你真的听我说的做了吗？",shape=box,color=red];
		1899 -> 1902;
	1904 [label="在忙一些事，抱歉。[结束]",shape=box,color=red];
		1904 -> 1903;
	1900 [label="一开始他以为我要揍他呢，笑死。但后来我把他带到屋顶上，我们坐下来谈了谈",shape=box,color=blue];
		1900 -> 1905;
	1902 [label="妈的闭嘴，让我说完，好吗？",shape=box,color=blue];
		1902 -> 1900;
	1903 [label="Chat ends.",color=orange];
	1905 [label="我跟他说了我知道他常做那些噩梦。也知道他过的并不好",shape=box,color=blue];
		1905 -> 1907;
		1905 -> 1906;
	1907 [label="然后呢？",shape=box,color=red];
		1907 -> 1908;
	1906 [label="他说了什么？",shape=box,color=red];
		1906 -> 1908;
	1908 [label="一开始什么也没说",shape=box,color=blue];
		1908 -> 1909;
	1909 [label="只是坐在那里，看上去很羞愧",shape=box,color=blue];
		1909 -> 1910;
	1910 [label="可能以为我会取笑他",shape=box,color=blue];
		1910 -> 1911;
	1911 [label="说实话，看到他那么慌张，确实让我很想这么做",shape=box,color=blue];
		1911 -> 1912;
	1912 [label="所以……我跟他讲了我第一次杀人的经历。第一次瞄准镜下看着一个人，然后夺走他的生命",shape=box,color=blue];
		1912 -> 1893;
	1893 [label="近身肉搏是一回事……一些暴徒拿着枪或刀向你冲过来……",shape=box,color=blue];
		1893 -> 1913;
	1913 [label="但当你在三百码外的屋顶上，而他们甚至不知道你在那里……完全是另一回事",shape=box,color=blue];
		1913 -> 1914;
	1914 [label="你有时间去*思考*他们。他们是谁。他们为什么会在那里。他们有家庭吗？有孩子吗？",shape=box,color=blue];
		1914 -> 1931;
	1931 [label="然后……你扣动扳机。砰",shape=box,color=blue];
		1931 -> 1928;
	1928 [label="现在这些都不重要了",shape=box,color=blue];
		1928 -> 1889;
	1889 [label="他们死了，而我夺走了那条生命",shape=box,color=blue];
		1889 -> 1892;
	1892 [label="那张脸一直留在我的脑海中",shape=box,color=blue];
		1892 -> 1915;
	1915 [label="之后的每一个都是如此",shape=box,color=blue];
		1915 -> 1896;
		1915 -> 1930;
	1896 [label="他有什么反应……？",shape=box,color=red];
		1896 -> 1916;
	1930 [label="听起来……挺令人振奋的。",shape=box,color=red];
		1930 -> 1916;
	1916 [label="很长时间没有说话。我们只是默默地坐在那里",shape=box,color=blue];
		1916 -> 1927;
	1927 [label="然后他……告诉我他一直在做的噩梦",shape=box,color=blue];
		1927 -> 1894;
	1894 [label="他觉得自己好像不是团队的一部分，因为他不是士兵",shape=box,color=blue];
		1894 -> 1890;
	1890 [label="所以我告诉他我以前做过的噩梦。就像我小时候做的那些",shape=box,color=blue];
		1890 -> 1891;
	1891 [label="我也向他道歉了，因为我一直把他当傻子一样对待",shape=box,color=blue];
		1891 -> 1895;
	1895 [label="还说了他和任何人一样是我们的一员。我就是这样的人，就像他也有他的个性，这就是我们，你明白吗？",shape=box,color=blue];
		1895 -> 1929;
	1929 [label="……然后你知道他说什么了吗……？",shape=box,color=blue];
		1929 -> 1926;
		1929 -> 1925;
	1926 [label="说了什么？",shape=box,color=red];
		1926 -> 1922;
	1925 [label="不知道？",shape=box,color=red];
		1925 -> 1922;
	1922 [label="“你说得对，你就是个混蛋”",shape=box,color=blue];
		1922 -> 1920;
	1920 [label="但就在我正要把他从屋顶推下去的时候？",shape=box,color=blue];
		1920 -> 1921;
	1921 [label="他拥抱了我。他妈的拥抱了我。然后说“但你也是我哥哥”",shape=box,color=blue];
		1921 -> 1923;
	1923 [label="什么鬼",shape=box,color=blue];
		1923 -> 1924;
	1924 [label="不过……算了。值了。我觉得这对他来说真的很重要……而且……对我也是，我想",shape=box,color=blue];
		1924 -> 1918;
	1918 [label="+20 Chemistry",color=orange];
		1918 -> 1919;
	1919 [label="所以……谢谢",shape=box,color=blue];
		1919 -> 1917;
	1917 [label="Chat ends.",color=orange];
}