		1321 -> 1322;
	1320 [label="伙计，这话可以刻在我的灵魂上了。看看我们，讨论得越来越深入了。哈哈哈。呃，我讨厌这种严肃的话题，你呢？我们就聊到这吧。我们以后再继续",shape=box,color=blue];
