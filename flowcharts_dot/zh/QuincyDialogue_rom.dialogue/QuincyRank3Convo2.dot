	1307 [label="我其实不太愿意深究他们是如何被制造出来的……但无论如何。你说得对。他们不应该被剥削。但他们也不应该发动战争。",shape=box,color=red];
		1307 -> 1308;
	1308 [label="其中一个叫 Erra 的人——他是送我来这里的 Lotus 的弟弟——与奥罗金的混蛋首领 Ballas 联手，占领了始源星系。",shape=box,color=red];
		1308 -> 1309;
