		2479 -> 2480;
	2422 [label="各种类型的，不过大多数是听有声书。当你进行长时间的观察——我指的是在那种持续两三天的狙击哨位，你得在一个地方待很长时间",shape=box,color=blue];
		2422 -> 2448;
	2429 [label="哈哈，你真的是从太空来的。是的。你可以这么说，大多数人确实这么认为，哈哈。可能是因为我的性格或者我打字的方式，他们都以为他们知道我的能力",shape=box,color=blue];
		2429 -> 2428;
	2480 [label="真的吗？那太好了，是的。我很想看看你来自的那个遥远的未来里，事情发生了怎样的变化",shape=box,color=blue];
		2480 -> 2460;
	2448 [label="真的。太。无聊了。所以我喜欢在那儿坐着，戴上一个耳机听有声书，懂吗？",shape=box,color=blue];
		2448 -> 2449;
	2428 [label="而且他们认为我几乎什么都做不了。我和碧都有这个共同点。每个人看到她，都只看到她漂亮的脸蛋，并以为她跟砖头一样无脑",shape=box,color=blue];
		2428 -> 2426;
