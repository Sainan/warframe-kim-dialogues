digraph {
	"QuincyRank6Convo5 begins." [color=orange];
		"QuincyRank6Convo5 begins." -> j3799017051;
	j3799017051 [label="我有个理论",shape=box,color=blue];
		j3799017051 -> j2208126531;
	j2208126531 [label="我并不需要你来确认或否认，我只是好奇",shape=box,color=blue];
		j2208126531 -> j3330446453;
	j3330446453 [label="所以我只是在“随口说说”或者随便什么的",shape=box,color=blue];
		j3330446453 -> j3000569589;
		j3330446453 -> j328206645;
	j3000569589 [label="你觉得谁对谁有好感？",shape=box,color=red];
		j3000569589 -> j1780535912;
	j328206645 [label="噢？我洗耳恭听。",shape=box,color=red];
		j328206645 -> j3464677845;
	j1780535912 [label="哈哈哈，不，你要是问我的话，我觉得这个队里的一半人都需要发泄一下",shape=box,color=blue];
		j1780535912 -> j160153155;
	j3464677845 [label="所以我当时在楼顶和老板一起殴打科腐者",shape=box,color=blue];
		j3464677845 -> j169936997;
		j3464677845 -> j352519618;
		j3464677845 -> j4291162330;
		j3464677845 -> j160387163;
	j160153155 [label="不过，这里不是八卦的地方，虽然八卦总是能让人发笑哈哈",shape=box,color=blue];
		j160153155 -> j3464677845;
	j169936997 [label="那……听起来像是虐待动物…… ",shape=box,color=red];
		j169936997 -> j3067740961;
	j352519618 [label="我觉得我明白了。",shape=box,color=red];
		j352519618 -> j4170936986;
	j4291162330 [label="老板？",shape=box,color=red];
		j4291162330 -> j3814648262;
	j160387163 [label="殴打？",shape=box,color=red];
		j160387163 -> j1912821930;
	j3067740961 [label="哦天啊",shape=box,color=blue];
		j3067740961 -> j1490714809;
	j4170936986 [label="你学到了真不错哈哈",shape=box,color=blue];
		j4170936986 -> j2447872911;
	j3814648262 [label="是亚瑟哈哈",shape=box,color=blue];
		j3814648262 -> j2447872911;
	j1912821930 [label="哈哈，这次是枪杀",shape=box,color=blue];
		j1912821930 -> j2447872911;
	j1490714809 [label="意思是我当时在屋顶上和亚瑟一起击杀科腐者，你这个傻瓜",shape=box,color=blue];
		j1490714809 -> j2447872911;
	j2447872911 [label="是的，他用狙击镜瞄准时一塌糊涂。所以我就在那，我们正在击杀一些游荡的敌人，只是为了好玩",shape=box,color=blue];
		j2447872911 -> j2608977255;
	j2608977255 [label="给他一些指点，对吧？ 就是在那时我意识到",shape=box,color=blue];
		j2608977255 -> j3141380048;
	j3141380048 [label="等等",shape=box,color=blue];
		j3141380048 -> j599707025;
	j599707025 [label="我这是在干什么啊",shape=box,color=blue];
		j599707025 -> j727165450;
	j727165450 [label="和陛下一起闲逛，就像我们是好伙计一样",shape=box,color=blue];
		j727165450 -> j274260469;
	j274260469 [label="嗯我知道你已经解决了问题，我们不再那个循环中不断死亡了，但",shape=box,color=blue];
		j274260469 -> j1670241709;
	j1670241709 [label="亚瑟和我从来都不是好兄弟，伙计",shape=box,color=blue];
		j1670241709 -> j1238403144;
		j1670241709 -> j605092832;
	j1238403144 [label="我……对不起？",shape=box,color=red];
		j1238403144 -> j121440070;
	j605092832 [label="那你这是在暗示什么？",shape=box,color=red];
		j605092832 -> j1041692632;
	j121440070 [label="所以问题就在这里，这似乎是你的“错”，我能感觉到，但我就是不明白",shape=box,color=blue];
		j121440070 -> j1041692632;
	j1041692632 [label="我们已经循环了多少次？你知道吗？",shape=box,color=blue];
		j1041692632 -> j3329263986;
		j1041692632 -> j2208931454;
	j3329263986 [label="很多次。怎么了？",shape=box,color=red];
		j3329263986 -> j1644588181;
	j2208931454 [label="我没有具体数过。",shape=box,color=red];
		j2208931454 -> j1644588181;
	j1644588181 [label="我其实不记得所有这些，对吧？ 不，别回答了",shape=box,color=blue];
		j1644588181 -> j1399649105;
	j1399649105 [label="但即使我记不起来，我的某个部分也肯定会感受到它，对吧？",shape=box,color=blue];
		j1399649105 -> j1757024505;
	j1757024505 [label="因为我知道我应该有某种感觉，但实际上我感觉不同",shape=box,color=blue];
		j1757024505 -> j3097414345;
	j3097414345 [label="我唯一能想到的是，某种程度上……我们的一部分……我也不知道……是否存在于循环之外？",shape=box,color=blue];
		j3097414345 -> j203466540;
	j203466540 [label="我在胡说八道，我讨厌这些香薰和水晶的破玩意儿，这是埃莉诺的胡说八道",shape=box,color=blue];
		j203466540 -> j1163078993;
	j1163078993 [label="我这样说有道理吗？",shape=box,color=blue];
		j1163078993 -> j982948860;
		j1163078993 -> j2315722123;
		j1163078993 -> j2154125671;
	j982948860 [label="没有，抱歉。",shape=box,color=red];
		j982948860 -> j1623694070;
	j2315722123 [label="我实在想不通这怎么可能。或许是你被感染的那部分？还是虚空……之类的东西？",shape=box,color=red];
		j2315722123 -> j792080869;
	j2154125671 [label="很有道理。我相信你。",shape=box,color=red];
		j2154125671 -> j3760424670;
	j1623694070 [label="哎，随它去吧我试过了",shape=box,color=blue];
		j1623694070 -> "Chat ends.";
	j792080869 [label="+5 Chemistry",color=orange];
		j792080869 -> j2667183882;
	j3760424670 [label="+5 Chemistry",color=orange];
		j3760424670 -> j3134294000;
	"Chat ends." [color=orange];
	j2667183882 [label="不知道，我真的不在乎为什么会发生，只是它确实发生了",shape=box,color=blue];
		j2667183882 -> j2938936488;
	j3134294000 [label="至少我不是个彻头彻尾的疯子。或者说，至少我不是唯一一个这样的人，哈哈",shape=box,color=blue];
		j3134294000 -> j2938936488;
	j2938936488 [label="我想知道我们还能继续进化和学习是件好事",shape=box,color=blue];
		j2938936488 -> j3645349587;
	j3645349587 [label="或者其他什么的",shape=box,color=blue];
		j3645349587 -> j3168472703;
	j3168472703 [label="好了，够了，别再谈这些深奥的东西了，我要去喝个烂醉，和那该死的会说话的吉他一起",shape=box,color=blue];
		j3168472703 -> j4170006321;
	j4170006321 [label="如果你给她吃一些腐臭的口粮，她会告诉你一些离谱的故事，但别告诉弗莱尔，哈哈哈哈",shape=box,color=blue];
		j4170006321 -> "Chat ends.";
}