		1531 -> 1532 [label=false,color=brown];
	1516 [label="有一天，我还是个小孩，翻箱倒柜的时候，我找到了这个小小的荧光绿的长方形相机",shape=box,color=blue];
		1516 -> 1517;
	1514 [label="Chat ends.",color=orange];
	1530 [label="我敢肯定终有一天我会厌倦它然后疯掉，但不是现在。现在我挺好的。你的男人很坚强",shape=box,color=blue];
		1530 -> 1533;
	1534 [label="我想我没提过。我有个姐姐，还有奶奶。还有我姨妈。姐姐和奶奶在拉德斯顿。阿姨在夏马卡。那是海外热带地区一个美丽的小岛。我跟你说，这场灾难选了个破镇。我们本来可以去夏马卡的",shape=box,color=blue];
		1534 -> 1537;
		1534 -> 1538;
