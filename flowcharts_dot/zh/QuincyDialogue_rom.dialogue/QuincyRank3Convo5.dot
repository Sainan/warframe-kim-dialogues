		1532 -> 1535 [label=true,color=green];
		1532 -> 1536 [label=false,color=brown];
	1517 [label="它的闪光灯在充电时会发出可怕的声音。我想是电容器之类的",shape=box,color=blue];
		1517 -> 1518;
	1533 [label="我不认为莱蒂能很好地接受这件事……还有陛下也是",shape=box,color=blue];
		1533 -> 1544;
		1533 -> 1545;
	1537 [label="你和她们还有保持联系吗？我们有电话、即时通。",shape=box,color=red];
