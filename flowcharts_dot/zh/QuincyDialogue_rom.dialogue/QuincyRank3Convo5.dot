digraph {
	1431 [label="QuincyRank3Convo5 begins.",color=orange];
		1431 -> 1503;
		1431 -> 1504;
	1503 [label="好吧。我终于得问一问了。你为什么这么喜欢摄影呢？",shape=box,color=red];
		1503 -> 1505;
	1504 [label="你以前想做什么？在……这一切发生之前？",shape=box,color=red];
		1504 -> 1506;
	1505 [label="你的哥们不能有点爱好啊？伙计，每个人都有爱好的，哈哈",shape=box,color=blue];
		1505 -> 1507;
		1505 -> 1508;
	1506 [label="唉，伙计，不知道像我这样的人是否真的能有未来的梦想",shape=box,color=blue];
		1506 -> 1525;
	1507 [label="我真的很喜欢你拍的一些照片。它们拍得太美了。",shape=box,color=red];
		1507 -> 1509;
		1507 -> 1510;
	1508 [label="我只是真的很好奇。",shape=box,color=red];
		1508 -> 1509;
		1508 -> 1510;
	1525 [label="对我们这样的人来说，生活本就不是那么回事，你懂我的意思吧。我曾梦想有一天能成名，带着一大笔钱回家给奶奶和姐姐",shape=box,color=blue];
		1525 -> 1526;
	1509 [label="我只是想知道你是从哪里学的。",shape=box,color=red];
		1509 -> 1511;
	1510 [label="在我看来，你不像是一个玩摄影的人。",shape=box,color=red];
		1510 -> 1512;
	1526 [label="但现在这些都不会实现了，对吧？我在这里。我们在这里。一直循环。直到永远。或者直到某些东西脱钩，一切都崩溃，谁知道呢",shape=box,color=blue];
		1526 -> 1527;
		1526 -> 1528;
	1511 [label="是我爸。他去世后，我们还留着他所有的东西，对吧？老天可不让你带行李",shape=box,color=blue];
		1511 -> 1515;
	1512 [label="难道我非得一直保持一副街头范儿？",shape=box,color=blue];
		1512 -> 1513;
	1527 [label="你看起来很好地接受了“永远被困在这里”这件事。",shape=box,color=red];
		1527 -> 1529;
	1528 [label="你没怎么提过你的家人。",shape=box,color=red];
		1528 -> 1531;
	1515 [label="我们卖掉了所有值钱的东西，当然了，老表，得付房租嘛。但还是有几箱杂物",shape=box,color=blue];
		1515 -> 1516;
	1513 [label="拜托，老表，看点深层次的东西行不？",shape=box,color=blue];
		1513 -> 1514;
	1529 [label="又解决不了，为什么要烦恼呢？我们还有事要做。也有好的一面",shape=box,color=blue];
		1529 -> 1530;
	1531 [label="Check boolean QuincyHome1",color=orange];
