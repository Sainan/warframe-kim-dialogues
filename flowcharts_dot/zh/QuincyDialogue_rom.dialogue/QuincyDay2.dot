digraph {
	3001 [label="QuincyDay2 begins.",color=orange];
		3001 -> 3002;
	3002 [label="你失败了",shape=box,color=blue];
		3002 -> 3003;
		3002 -> 3004;
		3002 -> 3005;
	3003 [label="好。",shape=box,color=red];
		3003 -> 3007;
	3004 [label="什么失败？",shape=box,color=red];
		3004 -> 3007;
	3005 [label="哦好吧，我们还在继续。",shape=box,color=red];
		3005 -> 3006;
	3007 [label="你应该让我恨你才对",shape=box,color=blue];
		3007 -> 3008;
	3006 [label="闭嘴",shape=box,color=blue];
		3006 -> 3007;
	3008 [label="这是整个破任务的重点，但你却失败了",shape=box,color=blue];
		3008 -> 3009;
	3009 [label="而现在……操，操……",shape=box,color=blue];
		3009 -> 3010;
	3010 [label="Check boolean QuincySorted",color=orange];
		3010 -> 3011 [label=true,color=green];
		3010 -> 3013 [label=false,color=brown];
	3011 [label="我早就告诉过你，讲我怎么加入六人组的故事会有不好的事情发生",shape=box,color=blue];
		3011 -> 3012;
	3013 [label="现在轮到我告诉你这个会让你恨我的故事了",shape=box,color=blue];
		3013 -> 3014;
	3012 [label="但现在它就要发生了。因为现在轮到我告诉你这个会让你恨我的故事了",shape=box,color=blue];
		3012 -> 3014;
	3014 [label="因为总得有人做这件事，如果不是你，那就只能是我了。就像以往那样",shape=box,color=blue];
		3014 -> 3015;
		3014 -> 3016;
		3014 -> 3017;
	3015 [label="好吧。我在听。",shape=box,color=red];
		3015 -> 3024;
	3016 [label="昆西，你没必要这么做。",shape=box,color=red];
		3016 -> 3023;
	3017 [label="我走了。我不玩这个游戏了。[结束]",shape=box,color=red];
		3017 -> 3022;
	3024 [label="也许等你听了我要说的，你最后可能会明白为什么",shape=box,color=blue];
		3024 -> 3025;
	3023 [label="不，我得做。等你听了我要说的，或许你最后会明白为什么",shape=box,color=blue];
		3023 -> 3025;
	3022 [label="嗯，行吧。你倒是让我轻松了。谢谢",shape=box,color=blue];
		3022 -> 3021;
	3025 [label="Check boolean QuincyArthur3",color=orange];
		3025 -> 3026 [label=true,color=green];
		3025 -> 3027 [label=false,color=brown];
	3021 [label="Update boolean QuincyNoDate",color=orange];
		3021 -> 3020;
	3026 [label="我告诉过你我为什么加入军队。因为我想让我和我的家人过上更好的生活",shape=box,color=blue];
		3026 -> 3119;
	3027 [label="我从没告诉过你我为什么要加入军队。我快速说一下。原因很简单。我想让我和我的家人过上更好的生活",shape=box,color=blue];
		3027 -> 3028;
	3020 [label="Update boolean QuincyDating",color=orange];
		3020 -> 3019;
	3119 [label="并且在我有这个机会之前，一切都乱了套",shape=box,color=blue];
		3119 -> 3038;
	3028 [label="在我长大的地方？你没有免费的机会去实现这一点。不，你得出去找机会实现",shape=box,color=blue];
		3028 -> 3029;
	3019 [label="Update boolean IsDating",color=orange];
		3019 -> 3018;
	3038 [label="不用是天才也能想明白，正是因为那位陛下，我的生活才出了问题。也是为什么我发誓再也不对任何人敞开心扉了",shape=box,color=blue];
		3038 -> 3035;
	3029 [label="而对我这样的人来说，最简单的出路就是军队。军队提供奖学金——让士兵有机会上大学",shape=box,color=blue];
		3029 -> 3032;
	3018 [label="Chat ends.",color=orange];
	3035 [label="那么",shape=box,color=blue];
		3035 -> 3036;
	3032 [label="所以我想，为他们杀几年人，然后我就能顺利进入商学院，主修金融或者读个工商管理硕士之类的",shape=box,color=blue];
		3032 -> 3030;
	3036 [label="就这么巧，通过一次偶然的机会，我加入了和陛下相同的团，第三营，赤色守望",shape=box,color=blue];
		3036 -> 3034;
	3030 [label="回家后让我的家人过得更好，做些真正有意义的改变",shape=box,color=blue];
		3030 -> 3031;
	3034 [label="他当时已经是指挥官了，是吧？我则是刚从军校出来",shape=box,color=blue];
		3034 -> 3039;
	3031 [label="但在我有这个机会之前，一切都乱了套",shape=box,color=blue];
		3031 -> 3033;
	3039 [label="有一段时间，我都在努力遵守规则，做一个合格的小兵。但随着时间的推移……我意识到情况仍然对我不利",shape=box,color=blue];
		3039 -> 3037;
	3033 [label="Update boolean QuincyArthur3",color=orange];
		3033 -> 3038;
	3037 [label="生活从来是不公平的。无论你去哪里。裙带关系。偏袒。偏见。到处都是。人们看不起我，因为我的出身",shape=box,color=blue];
		3037 -> 3044;
	3044 [label="因为我是谁",shape=box,color=blue];
		3044 -> 3041;
	3041 [label="所以我……开始变得愚蠢。开始做一些我现在后悔的事情。开始用愚蠢的方式反击。如果他们想从我这里拿走什么？我也会从他们那拿",shape=box,color=blue];
		3041 -> 3042;
	3042 [label="因为如果他们不保护我，我为什么要保护他们？所以我只关心我自己，只有我自己，听明白了吗？",shape=box,color=blue];
		3042 -> 3040;
	3040 [label="我没有偷东西。没有违反规定。我是个好士兵。但如果你听过“恶意服从”这个词，那你就会明白我的行为了",shape=box,color=blue];
		3040 -> 3045;
	3045 [label="我一生中不会有一秒钟是浪费在为别人做额外的事上。我只想做完自己的工作然后拿到工资走人",shape=box,color=blue];
		3045 -> 3049;
	3049 [label="但后来一切都乱套了。我们正在执行一个任务。我当时在观察。从我的视角来看，我可以看到反对派——敌人——突然开始向我们发起攻击。他们知道我们在那里",shape=box,color=blue];
		3049 -> 3046;
	3046 [label="亚瑟和其他部队都在下面的战场上，我必须在一瞬间做出决定。其实我可以暴露我的位置，向那些突然出现的敌人开火，给陛下和其他人发出警告，争取时间让他们撤离到安全地带",shape=box,color=blue];
		3046 -> 3047;
	3047 [label="但这样做会让我处于极大的危险之中，可以肯定那些敌人会迅速朝我这里来。所以……",shape=box,color=blue];
		3047 -> 3051;
	3051 [label="我收拾好我的东西，并用无线电报告我们的位置已经暴露……无论如何，我以为陛下和其他人已经凶多吉少了……",shape=box,color=blue];
		3051 -> 3050;
	3050 [label="我正要离开我藏身的房间，拐个弯就对上了一个敌人的枪口",shape=box,color=blue];
		3050 -> 3048;
	3048 [label="不是，老表。他们一直都知道我在那里。他们从一开始就盯上了我",shape=box,color=blue];
		3048 -> 3054;
	3054 [label="他们把我拖到街上，逼我跪下，把手枪顶在我的后脑勺上",shape=box,color=blue];
		3054 -> 3053;
	3053 [label="砰砰",shape=box,color=blue];
		3053 -> 3561;
	3561 [label="是他妈的亚瑟，他妈的陛下突然出现救了我",shape=box,color=blue];
		3561 -> 3562;
	3562 [label="我当时气疯了。立马站起来对着他就是一顿骂",shape=box,color=blue];
		3562 -> 3055;
		3562 -> 3056;
	3055 [label="是因为你情愿让他去死，但他却不愿意让你去死？",shape=box,color=red];
		3055 -> 3062;
	3056 [label="因为你现在欠他一条命？",shape=box,color=red];
		3056 -> 3062;
	3062 [label="是",shape=box,color=blue];
		3062 -> 3063;
	3063 [label="操",shape=box,color=blue];
		3063 -> 3067;
	3067 [label="你难道不明白吗？！我过去只为我和我的家人而活。那是我最在乎的，是我唯一在乎的",shape=box,color=blue];
		3067 -> 3065;
	3065 [label="而现在……现在我得关心这个混蛋——这个该死的混蛋——现在我得管他的死活了",shape=box,color=blue];
		3065 -> 3064;
	3064 [label="这不在我的计划里",shape=box,color=blue];
		3064 -> 3059;
	3059 [label="所以几个月后当他让我们陷入大麻烦，而且在他快被开除的时候？！",shape=box,color=blue];
		3059 -> 3066;
	3066 [label="我得做选择。我是不是该对上头撒一堆谎？我是不是该像之前那样背叛他？还是我该做正确的事",shape=box,color=blue];
		3066 -> 3057;
	3057 [label="我选择了做正确的事，因为我欠他的，然后……我和他一起离开了军队，也就此和大学梦说再见了",shape=box,color=blue];
		3057 -> 3061;
	3061 [label="我为自己和家人带来更好生活的梦想？没了。但是亚瑟说：“没事的，伙计，一切都会好起来的。”",shape=box,color=blue];
		3061 -> 3060;
	3060 [label="“我已经为我们找好了一份新工作，是跟一个维和组织合作的。他们的薪水更高，而且是预付的。你会没事的。”",shape=box,color=blue];
		3060 -> 3058;
	3058 [label="所以我当时像个傻瓜一样跟他一起去了国危部",shape=box,color=blue];
		3058 -> 3069;
		3058 -> 3068;
	3069 [label="然后是科腐者……",shape=box,color=red];
		3069 -> 3070;
	3068 [label="噢不……",shape=box,color=red];
		3068 -> 3071;
	3070 [label="是的，然后是科腐者……一切变成了真正的地狱，那时……他比以往更需要我",shape=box,color=blue];
		3070 -> 3074;
	3071 [label="然后那个科腐者出现了……而一切变成了真正的地狱，那时……他比以往更需要我",shape=box,color=blue];
		3071 -> 3074;
	3074 [label="但我不能就这样……走开。那个时候早就过去了，对吧？那时候没能走开……现在也走不开……",shape=box,color=blue];
		3074 -> 3072;
	3072 [label="每次我让别人进入我的生活，我最终都变成了他们的小玩具士兵……",shape=box,color=blue];
		3072 -> 3073;
	3073 [label="所以当你出现……大摇大摆地进来……",shape=box,color=blue];
		3073 -> 3075;
	3075 [label="踢开我紧锁的门……",shape=box,color=blue];
		3075 -> 3076;
	3076 [label="Check boolean QuincyDating",color=orange];
		3076 -> 3077 [label=true,color=green];
		3076 -> 3078 [label=false,color=brown];
	3077 [label="然后说“不行，伙计，现在你和我得在一起了，故事到此为止，虽然没有什么好理由”",shape=box,color=blue];
		3077 -> 3079;
	3078 [label="然后说“不行，虽然没有什么好理由，但我还是关心你“",shape=box,color=blue];
		3078 -> 3079;
	3079 [label="我他妈该怎么办？上一次发生这种事的时候……它毁了我的生活……",shape=box,color=blue];
		3079 -> 3081;
		3079 -> 3080;
		3079 -> 3082;
	3081 [label="我很抱歉你觉得你必须这样生活。但之前发生的事并不是我的错。",shape=box,color=red];
		3081 -> 3084;
	3080 [label="我理解你为什么觉得需要保护自己。",shape=box,color=red];
		3080 -> 3083;
	3082 [label="我本来还期待听到一些更加震撼的事情。听完我的故事，你就只有这些？",shape=box,color=red];
		3082 -> 3089;
	3084 [label="我知道。你是对的。而且……我很抱歉。我害怕这样做？“我们”？无论这意味着什么？只会再次毁了我",shape=box,color=blue];
		3084 -> 3086;
	3083 [label="……谢谢。这对我很重要。但并不意味着它是正确的。对不起。我……我想在我内心深处，我……很害怕，“我们”这个词——不管“我们”意味着什么？只会再次毁了我",shape=box,color=blue];
		3083 -> 3085;
	3089 [label="Update boolean QuincyNoDate",color=orange];
		3089 -> 3087;
	3086 [label="无论是你重置世界让我忘记你——你别说你做不到——还是你在事情变糟或你需要的时候逃到未来",shape=box,color=blue];
		3086 -> 3091;
	3085 [label="Update boolean Day2_20",color=orange];
		3085 -> 3086;
	3087 [label="Update boolean QuincyDating",color=orange];
		3087 -> 3090;
	3091 [label="但这就是生活，不是吗？生活就像你说的……一次一段关系",shape=box,color=blue];
		3091 -> 3094;
	3090 [label="Update boolean IsDating",color=orange];
		3090 -> 3088;
	3094 [label="Check boolean QuincyDating",color=orange];
		3094 -> 3093 [label=true,color=green];
		3094 -> 3092 [label=false,color=brown];
	3088 [label="Chat ends.",color=orange];
	3093 [label="我想知道的是，宝贝，你能原谅我吗？我们这次能真正继续下去吗？",shape=box,color=blue];
		3093 -> 3095;
		3093 -> 3096;
	3092 [label="我想知道的是，你能原谅我吗？我们这次能真正继续下去吗？",shape=box,color=blue];
		3092 -> 3097;
		3092 -> 3096;
	3095 [label="我当然原谅你了。你对我来说很重要。",shape=box,color=red];
		3095 -> 3099;
	3096 [label="我……不能。对不起。",shape=box,color=red];
		3096 -> 3098;
	3097 [label="我当然原谅你了。",shape=box,color=red];
		3097 -> 3100;
	3099 [label="Update boolean QuincyForgiven",color=orange];
		3099 -> 3105;
	3098 [label="……好吧。我应得的。如果我再也不给你发信息，对不起，我……不想回想那些不愉快，好吗？拜拜。回头见",shape=box,color=blue];
