		1002 -> 1005;
	1003 [label="那个，我还没听你讲过你是怎么认识亚瑟的。",shape=box,color=red];
		1003 -> 1011;
	1004 [label="莱蒂，你有空聊聊吗？还是你很忙？",shape=box,color=red];
		1004 -> 1008;
	1005 [label="[结束]",shape=box,color=red];
		1005 -> 1006;
	1011 [label="呃，挺复杂的 
