	j2534360155 [label="哎呀，你一点也不好玩\n好吧，solecito\n话说回来\nNo me distraigas",shape=box,color=blue];
		j2534360155 -> j839595943;
	j2734142610 [label="Sí，Sí\n早该知道的\nNo me distraigas",shape=box,color=blue];
		j2734142610 -> j839595943;
	j4261291323 [label="……\nAaaahhhhhgggh mierda\nSíííííí……好吧\n如果我自己都做不到向前看\n又怎么去劝亚瑟呢",shape=box,color=blue];
		j4261291323 -> j949949718;
	j950003048 [label="知道它不会在今天或明天就建好\n可能短时间内也不太会实现\n但是光想一想感觉挺好的\n¿Qué te parece?",shape=box,color=blue];
