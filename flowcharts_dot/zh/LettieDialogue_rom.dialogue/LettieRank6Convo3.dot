	j737380114 [label="我能说声抱歉吗？我说的话让你不开心了。我觉得我无意中说错了话。",shape=box,color=red];
		j737380114 -> j4261291323;
	j1033803830 [label="Jajaja，不是，不过，也许吧\n非常让人心动\n我在想也许我们可以建一个温室",shape=box,color=blue];
