	j1226065260 [label="Sí，sí\n新鲜食物（Si como más Pizza voy a gritar）\n我可以种 cempasúchil 花\n只不过……呃，别笑",shape=box,color=blue];
		j1226065260 -> j1582992800;
	j4248895727 [label="+5 Chemistry",color=orange];
		j4248895727 -> j1496041701;
	j3895481202 [label="很多原因\n新鲜食物（Si como más Pizza voy a gritar）\n我可以种 cempasúchil 花\n只不过……呃，别笑",shape=box,color=blue];
		j3895481202 -> j1582992800;
