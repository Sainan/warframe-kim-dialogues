		j1582992800 -> j3167250287;
		j1582992800 -> j1944631736;
		j1582992800 -> j3373610717;
	j1496041701 [label="啊，别让我哭\n为我的 panquecitos 着想，你真是太好了\nGracias\n其实我是有考虑到别的事情\n只不过……呃，别笑",shape=box,color=blue];
		j1496041701 -> j1582992800;
	j3167250287 [label="我记得她喜欢植物。我想她一定会喜欢的。",shape=box,color=red];
		j3167250287 -> j511199411;
	j1944631736 [label="我很高兴你们俩已经和好了。 ",shape=box,color=red];
		j1944631736 -> j1035832103;
	j3373610717 [label="我为什么要笑？",shape=box,color=red];
		j3373610717 -> j2308149880;
	j511199411 [label="这里太沉闷了\nNo necesitamos mantenerlo lúgubre y sucio\n我宁愿让她和植物说话而不是……\n好吧……和枪说话……",shape=box,color=blue];
		j511199411 -> j3277211997;
	j1035832103 [label="Sí\n有时候很难放下一些事情\n很难承认事情会改变\n我宁愿让她和植物说话而不是……\n好吧……和枪说话……",shape=box,color=blue];
		j1035832103 -> j3277211997;
	j2308149880 [label="她和我并不总是“最好的朋友”\n有时候很难放下一些事情\n很难承认事情会改变\n我宁愿让她和植物说话而不是……\n好吧……和枪说话……",shape=box,color=blue];
		j2308149880 -> j3277211997;
	j3277211997 [label="但我发现当她微笑时\n我也会微笑\n可能更像是 su onda de bruja jajaja",shape=box,color=blue];
		j3277211997 -> j2380934635;
	j2380934635 [label="无论如何\n想想就觉得很好\n“死亡商场”不需要如此直白",shape=box,color=blue];
