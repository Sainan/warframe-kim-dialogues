		j4172583155 -> j2985555336 [label=true,color=green];
		j4172583155 -> "Chat ends." [label=false,color=brown];
	j2039231216 [label="嘿，莱蒂？你忙吗？[征求是否同意多重伴侣关系]",shape=box,color=red];
		j2039231216 -> j970608473;
	j2614805810 [label="[结束]",shape=box,color=red];
		j2614805810 -> j3702107533;
	j970608473 [label="总有的忙\n但为了你的话……\n¿Qué?",shape=box,color=blue];
		j970608473 -> j2530161990;
	j3702107533 [label="Boolean LettieConsentComplete is now true.",color=orange];
		j3702107533 -> "Chat ends.";
	j2530161990 [label="我想跟你说件事，我想先确定你能接受。",shape=box,color=red];
		j2530161990 -> j3214339997;
	j3214339997 [label="对我来说重要的是，你不会觉得我在用任何方式对你撒谎，或者对你不坦诚。",shape=box,color=red];
		j3214339997 -> j3441440107;
		j3214339997 -> j3622446856;
		j3214339997 -> j586098267;
	j3441440107 [label="请别伤害我。",shape=box,color=red];
		j3441440107 -> j1603317876;
	j3622446856 [label="请别生气。",shape=box,color=red];
		j3622446856 -> j3571061319;
	j586098267 [label="我希望你能理解。",shape=box,color=red];
		j586098267 -> j2220948430;
	j1603317876 [label="Jajajajaj\n我们聊过这个\n我只会用你喜欢的方式伤害你\n现在你到底在说什么",shape=box,color=blue];
		j1603317876 -> j1219762383;
	j3571061319 [label="¿Sí?\n有什么好生气的？",shape=box,color=blue];
		j3571061319 -> j1219762383;
	j2220948430 [label="¿Sí?\n有什么要理解的？",shape=box,color=blue];
		j2220948430 -> j1219762383;
	j1219762383 [label="我不想让你陷入一种你无法接受的情况。我知道我们之前没有讨论过这件事。所以如果你拒绝，那也没关系。我希望你清楚这一点。",shape=box,color=red];
		j1219762383 -> j2794305065;
	j2794305065 [label="我们之间的感情对我很重要——非常重要——而且它是真实的。我不希望你怀疑这一点。",shape=box,color=red];
		j2794305065 -> j1035680492;
	j1035680492 [label="啊，entiendo……\n你知道我平时不是这样的\n我只是想知道\n你真的在乎他吗，solecito？\n¿Quiénes son？\n你真的关心他吗？",shape=box,color=blue];
		j1035680492 -> j1781213886;
		j1035680492 -> j3441748294;
	j1781213886 [label="我的确在乎他。但我也深深地在乎你。",shape=box,color=red];
		j1781213886 -> j853241613;
	j3441748294 [label="我早该想到你很快会明白我的意思的。",shape=box,color=red];
		j3441748294 -> j59627336;
	j853241613 [label="哎，sí\n很难责怪你，毕竟你见识那么多\n旅行也那么多\n只是别让我加入\n这件事我没问题",shape=box,color=blue];
		j853241613 -> j83627951;
	j59627336 [label="我作弊了\n埃莉诺警告过我\nJajaja 她真是个可怕的八卦婆",shape=box,color=blue];
		j59627336 -> j1248409742;
	j83627951 [label="但可别是六人组的\nMi familia no, ¿por favor?\n不然我得用消毒棉片把自己搓上一个礼拜",shape=box,color=blue];
		j83627951 -> j4198142991;
	j1248409742 [label="很难责怪你，毕竟你见识那么多\n旅行也那么多\n只是别让我加入\n这件事我没问题",shape=box,color=blue];
		j1248409742 -> j83627951;
	j4198142991 [label="+20 Chemistry",color=orange];
		j4198142991 -> j21012992;
	j21012992 [label="你对我已经变得非常重要了， solecito\n而如果他能给你带来快乐？\n那么他也给我带来同样的快乐\n就这么简单",shape=box,color=blue];
		j21012992 -> j3356701480;
	j3356701480 [label="哦\n哪天想办法把他带到这里来\n我想见见他",shape=box,color=blue];
		j3356701480 -> j2431444808;
		j3356701480 -> j553420880;
	j2431444808 [label="遵命，女士。:)",shape=box,color=red];
		j2431444808 -> j3702107533;
	j553420880 [label="我看看我能做些什么。",shape=box,color=red];
		j553420880 -> j3702107533;
}