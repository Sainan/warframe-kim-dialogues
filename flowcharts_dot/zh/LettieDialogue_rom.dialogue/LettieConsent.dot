		j259236231 -> j225138302;
		j259236231 -> j635549014;
	j225138302 [label="我的确在乎他。但我也深深地在乎你。",shape=box,color=red];
		j225138302 -> j3079958996;
	j635549014 [label="我早该想到你很快会明白我的意思的。",shape=box,color=red];
		j635549014 -> j1656071525;
	j3079958996 [label="哎，sí
