		j3498001059 -> j259293617;
	j3876405857 [label="¿Sí?
有什么好生气的？",shape=box,color=blue];
		j3876405857 -> j259293617;
	j202454941 [label="¿Sí?
有什么要理解的？",shape=box,color=blue];
		j202454941 -> j259293617;
	j259293617 [label="我不想让你陷入一种你无法接受的情况。我知道我们之前没有讨论过这件事。所以如果你拒绝，那也没关系。我希望你清楚这一点。",shape=box,color=red];
		j259293617 -> j1892887638;
	j1892887638 [label="我们之间的感情对我很重要——非常重要——而且它是真实的。我不希望你怀疑这一点。",shape=box,color=red];
		j1892887638 -> j259236231;
	j259236231 [label="啊——，entiendo...
