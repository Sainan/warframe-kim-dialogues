digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LettieRank6Convo9 begins." [color=orange];
		"LettieRank6Convo9 begins." -> j1586281925;
	j1586281925 [label="嘿\n我看到你带着什么奇怪的小动物跑来跑去\n看起来不正常",shape=box,color=blue];
		j1586281925 -> j735737128;
		j1586281925 -> j1479811679;
	j735737128 [label="你可能会惊讶地发现，问了等于没问。",shape=box,color=red];
		j735737128 -> j2596118862;
	j1479811679 [label="它是金属的还是活的？",shape=box,color=red];
		j1479811679 -> j62768275;
	j2596118862 [label="Jajaja 确实\n好吧，它的头上长了一些奇怪的东西。",shape=box,color=blue];
		j2596118862 -> j3110503321;
		j2596118862 -> j3316222712;
		j2596118862 -> j2153705740;
		j2596118862 -> j2751531852;
	j62768275 [label="我想……是活的\n软软的，所以不是金属\n头上长着又大又怪的东西",shape=box,color=blue];
		j62768275 -> j3110503321;
		j62768275 -> j3316222712;
		j62768275 -> j2153705740;
		j62768275 -> j2751531852;
	j3110503321 [label="不知道。你看到的可能是感染者在追我。",shape=box,color=red];
		j3110503321 -> j4093388285;
	j3316222712 [label="会不会是狐帕菲拉？它看起来像一只“狐狸”或者一只瘦瘦的“狗”，长着长长的大耳朵，耳朵上还有发光的东西？",shape=box,color=red];
		j3316222712 -> j3248196080;
	j2153705740 [label="会不会是笑面型库娃？它看起来有点像卡利莫斯，只不过长着尖尖的大耳朵？",shape=box,color=red];
		j2153705740 -> j3182196227;
	j2751531852 [label="会不会是宰相扑猎达赛？它看起来像……一只头上长着发光东西的大“狗”？还有一双大蝙蝠耳朵？",shape=box,color=red];
		j2751531852 -> j2165006248;
	j4093388285 [label="No me gusta\nNo me gusta nadita",shape=box,color=blue];
		j4093388285 -> "Chat ends.";
	j3248196080 [label="¡¡Sí！！\n¡¿Qué demonios es esa cosa？！",shape=box,color=blue];
		j3248196080 -> j2707455799;
		j3248196080 -> j1241873062;
		j3248196080 -> j630756208;
		j3248196080 -> j3467926017;
	j3182196227 [label="呃，不是\n不完全是\n它耳朵上有发光的东西",shape=box,color=blue];
		j3182196227 -> j1534021099;
		j3182196227 -> j1625825621;
	j2165006248 [label="呃，不，接近了\n又长又细的耳朵",shape=box,color=blue];
		j2165006248 -> j2707455799;
		j2165006248 -> j3467926017;
		j2165006248 -> j630756208;
		j2165006248 -> j1241873062;
	"Chat ends." [color=orange];
	j2707455799 [label="好吧……不知道，抱歉。",shape=box,color=red];
		j2707455799 -> j4093388285;
	j1241873062 [label="那是我的狡黠狐帕菲拉。它来自火卫二，那颗 Infested 星球。在火卫二之外很少能见到。:) 它们无害。嗯，至少对你来说是这样。",shape=box,color=red];
		j1241873062 -> j2133604381;
	j630756208 [label="那是我的月刃狐帕菲拉。它来自火卫二，那颗 Infested 星球。在火卫二之外很少能见到。:) 它们无害。嗯，至少对你来说是这样。",shape=box,color=red];
		j630756208 -> j2133604381;
	j3467926017 [label="那是我的铁甲狐帕菲拉。它来自火卫二，那颗 Infested 星球。:) 它们无害。嗯，至少对你来说是这样。",shape=box,color=red];
		j3467926017 -> j2133604381;
	j1534021099 [label="大大的发光蝙蝠耳朵？",shape=box,color=red];
		j1534021099 -> j2165006248;
	j1625825621 [label="又长又细、发光的耳朵？",shape=box,color=red];
		j1625825621 -> j3248196080;
	j2133604381 [label="Bien……\n更多 Infested……\n正是我们需要的……\n让它离我远点，¿sí？",shape=box,color=blue];
		j2133604381 -> j4081823699;
		j2133604381 -> j1039921140;
	j4081823699 [label="我保证，它非常温顺。",shape=box,color=red];
		j4081823699 -> j1563875520;
	j1039921140 [label="但它只是一只可爱的 Infested 动物，莱蒂。你是想抚摸它的对吧。",shape=box,color=red];
		j1039921140 -> j2919462450;
	j1563875520 [label="我确信这就是大家之前对科腐者的评价\n直到它吃掉他们的脸",shape=box,color=blue];
		j1563875520 -> "Chat ends.";
	j2919462450 [label="+5 Chemistry",color=orange];
		j2919462450 -> j3030887100;
	j3030887100 [label="啊啊啊\n我就讨厌你这样\n好吧，对，我想抚摸它\n行了吧！！",shape=box,color=blue];
		j3030887100 -> j153365410;
	j153365410 [label="它可以留下来……",shape=box,color=blue];
		j153365410 -> "Chat ends.";
}