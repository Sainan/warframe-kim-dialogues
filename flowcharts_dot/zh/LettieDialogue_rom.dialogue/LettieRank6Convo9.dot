digraph {
	2718 [label="LettieRank6Convo9 begins.",color=orange];
		2718 -> 2719;
	2719 [label="嘿
我看到你带着什么奇怪的小动物跑来跑去
看起来不正常",shape=box,color=blue];
		2719 -> 2720;
		2719 -> 2721;
