digraph {
	"LettieRank6Convo8 begins." [color=orange];
		"LettieRank6Convo8 begins." -> j381923459;
	j381923459 [label="我听说卡娅的事了\n关于一些小 comadreja de mierda 对她做的事情",shape=box,color=blue];
		j381923459 -> j783758880;
		j381923459 -> j3916628783;
	j783758880 [label="糟了。",shape=box,color=red];
		j783758880 -> j1423358446;
	j3916628783 [label="好吧……",shape=box,color=red];
		j3916628783 -> j1423358446;
	j1423358446 [label="我不知道要怎么做到\n我也不知道是否有可能\n但你打破了时间和空间的规律",shape=box,color=blue];
		j1423358446 -> j2221136717;
	j2221136717 [label="我想找到他\n我想把他带到这里\n然后让他坐在我们大家面前",shape=box,color=blue];
		j2221136717 -> j25798005;
		j2221136717 -> j4119069891;
	j25798005 [label="然后呢？",shape=box,color=red];
		j25798005 -> j1750823771;
	j4119069891 [label="我们不能去伤害一个青少年。",shape=box,color=red];
		j4119069891 -> j1541236291;
	j1750823771 [label="我想让他感受一下当他害怕时，全世界都与他为敌是什么感觉\n当每个人都在嘲笑他\n都在讽刺他",shape=box,color=blue];
		j1750823771 -> j2483895207;
	j1541236291 [label="谁说要这么做了\n我知道他这种人\n他们都是懦夫，只会在他们自认为安全的地方满嘴喷粪",shape=box,color=blue];
		j1541236291 -> j1750823771;
	j2483895207 [label="你知道，像我顶着这个样子长大是什么感觉吗？\n像我这样说话？\n像我这样打扮？\n在军事基地里，周围却是和我截然不同的孩子？",shape=box,color=blue];
		j2483895207 -> j3117808353;
	j3117808353 [label="我经常会因为自己不肯忍气吞声而带着伤回家，\nMi mamá 总是咂嘴，说我应该低头忍让\n¿Quedarme callada？\n才不呢",shape=box,color=blue];
		j3117808353 -> j580547789;
	j580547789 [label="Check boolean KayaFutureWin2",color=orange];
		j580547789 -> j3556668846 [label=true,color=green];
		j580547789 -> j4277268638 [label=false,color=brown];
	j3556668846 [label="我不怪她想逃跑\n如果可以的话，我早就逃跑了\n但是\n注意到她并没有离开吗？",shape=box,color=blue];
		j3556668846 -> j2294089101;
		j3556668846 -> j2340137777;
	j4277268638 [label="我不怪她想逃跑\n如果可以的话，我早就逃跑了\n等她再长大一些，这种感觉会慢慢淡去",shape=box,color=blue];
		j4277268638 -> j3935652602;
		j4277268638 -> j4023290442;
	j2294089101 [label="没有？",shape=box,color=red];
		j2294089101 -> j1587866291;
	j2340137777 [label="也是，她是唯一一个可以在时光科研上帮忙的人。",shape=box,color=red];
		j2340137777 -> j1857253457;
	j3935652602 [label="我很抱歉没能帮到她。",shape=box,color=red];
		j3935652602 -> j650218146;
	j4023290442 [label="这是你能帮到她的事吗？",shape=box,color=red];
		j4023290442 -> j650218146;
	j1587866291 [label="JAJAJA 提醒我永远不要将你设置为紧急联系人\nSííí，她只是出去了一下，但她迟早会回到这里\n为了那什么时间科\n不过，我想，也是为了……我们",shape=box,color=blue];
		j1587866291 -> j1928002349;
	j1857253457 [label="Sííí，为了那什么时光科\n不过，我想，也是为了……我们",shape=box,color=blue];
		j1857253457 -> j1928002349;
	j650218146 [label="有时只是需要时间\n但如果可以的话我会尽力帮助她\n月神知道她对医学科学足够好奇 jajaja\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j650218146 -> j1145910176;
	j1928002349 [label="我喜欢有她在我身边\n我想她也知道\n不过她喜欢在手术中帮助我……\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j1928002349 -> j3065575715;
	j1145910176 [label="她的瞬移总是添乱\n不过我喜欢看她吓到阿米尔\n这个混蛋活该，平时总这样吓我们 JAJAJAJA",shape=box,color=blue];
		j1145910176 -> "Chat ends.";
	j3065575715 [label="她的瞬移总是添乱\n不过我喜欢看她吓到阿米尔\n这个混蛋活该，平时总这样吓我们 JAJAJAJA\n希望她永远不会走了就不再回来",shape=box,color=blue];
