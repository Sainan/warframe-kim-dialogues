		1829 -> 1830;
	1833 [label="我并不是来告诉你你的行为是否可以被原谅的。那不是我能做的事情，而且说实话——我不认为你所描述的事情是可以被原谅的。",shape=box,color=red];
		1833 -> 1839;
	1834 [label="英择谛来到这里，找到了他想要的东西——有用、有技术的人，他可以诱骗他们做他想做的事。谁都不会对此想太多。你就像许多人一样，被他的把戏耍得团团转。",shape=box,color=red];
		1834 -> 1837;
	1836 [label="发生这些事不是你的错。你被欺骗了。是的，当然——当事情开始出错时，也许你有点自欺欺人。但谁能责怪你呢？希望是一种危险的毒品。而他给你注入了满满的希望。",shape=box,color=red];
		1836 -> 1838;
	1830 [label="Update boolean IsDating",color=orange];
		1830 -> 1831;
	1839 [label="有人死了。这些人再也不会回来了。因为你想要相信某个“穿着难看风衣的老头”兜售的神奇药物。",shape=box,color=red];
		1839 -> 1842;
	1837 [label="你想相信他的谎言。所以，你相信了。这是你的错。那些因此而生病的人？那也是你的错。",shape=box,color=red];
		1837 -> 1839;
		1837 -> 1840;
	1838 [label="所以，你自然会配合他。当然，你愿意相信还有机会。",shape=box,color=red];
		1838 -> 1841;
	1831 [label="Update boolean LettieNoDate",color=orange];
		1831 -> 1832;
	1842 [label="而且我也没有权利赦免你。抱歉。",shape=box,color=red];
		1842 -> 1845;
	1840 [label="但人都会犯错。人也会承认错误。而你在这里，正试图承认这些错误。所以……我看到的是一个试图用正确的方式来纠正自己过错的人。",shape=box,color=red];
		1840 -> 1843;
