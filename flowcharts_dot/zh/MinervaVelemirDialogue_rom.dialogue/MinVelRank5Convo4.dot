		j3894668790 -> j3096432737;
	j2694318540 [label="PapaPolar: 不过，爸爸叛逃到了自由国。然后我就在这儿了。 ",shape=box,color=blue];
		j2694318540 -> j3539930626;
		j2694318540 -> j3743092973;
	j3096432737 [label="PapaPolar: 嗯。米？",shape=box,color=blue];
		j3096432737 -> j2578432807;
	j3539930626 [label="你到底为什么要找他的牙齿相机？",shape=box,color=red];
		j3539930626 -> j1875861561;
	j3743092973 [label="还在纠结“牙齿相机”的事。",shape=box,color=red];
		j3743092973 -> j15804900;
