	1691 [label="PapaPolar: 我想那会是个很棒的生日礼物。",shape=box,color=blue];
		1691 -> 1694;
		1691 -> 1695;
	1692 [label="PapaPolar: 然后你被抓住了。带着相机。坏事发生了。",shape=box,color=blue];
		1692 -> 1696;
	1693 [label="PapaPolar: 我很抱歉当时没相信你和你有关炽蛇军的情报，尽管我本该这样做。我知道内奇在向我征求去留的意见，而且……",shape=box,color=blue];
		1693 -> 1697;
	1694 [label="……那好吧。",shape=box,color=red];
		1694 -> 1698;
	1695 [label="你闯入一家大型博物馆，就为了把他的牙齿偷回来……当生日礼物？",shape=box,color=red];
		1695 -> 1698;
	1696 [label="PapaPolar: 所以他们在放置照相设备时变得非常谨慎。 ",shape=box,color=blue];
		1696 -> 1699;
	1697 [label="PapaPolar: 不管我做什么事，我爸都没真正同意过。我不想对她那样。我想让她自己做选择。",shape=box,color=blue];
		1697 -> 1700;
	1698 [label="PapaPolar: 怎么了？难道他们未来不会这么做吗？",shape=box,color=blue];
		1698 -> 1701;
	1699 [label="PapaPolar: 而爸爸嘴的正前部有一颗大金牙，所以他们在里面装了一个小小的相机",shape=box,color=blue];
		1699 -> 1702;
	1700 [label="PapaPolar: 但我应该听你的。所以，我很抱歉。",shape=box,color=blue];
		1700 -> 1703;
	1701 [label="MomToxicated: 我们是个奇怪的家庭，亲爱的维利米尔。",shape=box,color=blue];
		1701 -> 1704;
	1702 [label="PapaPolar: 好吧，小小的是相对的，它仍然是一个在牙齿里的该死的相机",shape=box,color=blue];
		1702 -> 1704;
	1703 [label="MomToxicated: 但你是对的。这是她的选择。我不应该因为她的选择而责怪你。",shape=box,color=blue];
		1703 -> 1705;
	1704 [label="MomToxicated: 遗憾的是，他一直没能把相机从储藏室里拿出来。",shape=box,color=blue];
		1704 -> 1706;
