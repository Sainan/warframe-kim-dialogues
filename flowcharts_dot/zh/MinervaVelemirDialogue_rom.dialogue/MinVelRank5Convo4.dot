	1711 [label="MomToxicated: 你娶我。",shape=box,color=blue];
		1711 -> 1713;
	1712 [label="PapaPolar: 她不想推倒一件无价之宝。",shape=box,color=blue];
		1712 -> 1714;
	1713 [label="PapaPolar: 哈哈。那倒是真的。他非常——喜欢——你。有哪个女人能像他一样喝得了伏特加，——还能——在零度以下的天气里修得了卡车？！就她了。",shape=box,color=blue];
		1713 -> 1715;
