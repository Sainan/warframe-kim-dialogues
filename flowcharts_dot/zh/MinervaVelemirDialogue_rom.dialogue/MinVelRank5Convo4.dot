		1688 -> 1691;
	1689 [label="PapaPolar: 对。所以。就说。你是一个间谍。你在从事间谍活动。",shape=box,color=blue];
		1689 -> 1692;
	1690 [label="PapaPolar: 我知道这为时已晚也微不足道，我要亲口对你说，而且我要再说上一千遍，但是……",shape=box,color=blue];
