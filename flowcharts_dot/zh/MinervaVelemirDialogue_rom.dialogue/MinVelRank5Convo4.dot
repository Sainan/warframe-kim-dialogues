		j1875861561 -> j3134930890;
	j15804900 [label="PapaPolar: 对。所以。就说。你是一个间谍。你在从事间谍活动。",shape=box,color=blue];
		j15804900 -> j2874324701;
	j1957341807 [label="PapaPolar: 我知道这为时已晚也微不足道，我要亲口对你说，而且我要再说上一千遍，但是……",shape=box,color=blue];
		j1957341807 -> j2097396209;
	j3134930890 [label="PapaPolar: 我想那会是个很棒的生日礼物。",shape=box,color=blue];
		j3134930890 -> j458295125;
		j3134930890 -> j2208104272;
	j2874324701 [label="PapaPolar: 然后你被抓住了。带着相机。坏事发生了。",shape=box,color=blue];
		j2874324701 -> j3033384292;
	j2097396209 [label="PapaPolar: 我很抱歉当时没相信你和你有关炽蛇军的情报，尽管我本该这样做。我知道内奇在向我征求去留的意见，而且……",shape=box,color=blue];
		j2097396209 -> j1912075766;
	j458295125 [label="……那好吧。",shape=box,color=red];
		j458295125 -> j931136723;
	j2208104272 [label="你闯入一家大型博物馆，就为了把他的牙齿偷回来……当生日礼物？",shape=box,color=red];
		j2208104272 -> j931136723;
	j3033384292 [label="PapaPolar: 所以他们在放置照相设备时变得非常谨慎。 ",shape=box,color=blue];
		j3033384292 -> j4109504844;
	j1912075766 [label="PapaPolar: 不管我做什么事，我爸都没真正同意过。我不想对她那样。我想让她自己做选择。",shape=box,color=blue];
		j1912075766 -> j4047337529;
	j931136723 [label="PapaPolar: 怎么了？难道他们未来不会这么做吗？",shape=box,color=blue];
		j931136723 -> j1769856335;
	j4109504844 [label="PapaPolar: 而爸爸嘴的正前部有一颗大金牙，所以他们在里面装了一个小小的相机",shape=box,color=blue];
		j4109504844 -> j1441683575;
	j4047337529 [label="PapaPolar: 但我应该听你的。所以，我很抱歉。",shape=box,color=blue];
		j4047337529 -> j241708562;
	j1769856335 [label="MomToxicated: 我们是个奇怪的家庭，亲爱的维利米尔。",shape=box,color=blue];
		j1769856335 -> j2755282532;
	j1441683575 [label="PapaPolar: 好吧，小小的是相对的，它仍然是一个在牙齿里的该死的相机",shape=box,color=blue];
		j1441683575 -> j2755282532;
	j241708562 [label="MomToxicated: 但你是对的。这是她的选择。我不应该因为她的选择而责怪你。",shape=box,color=blue];
		j241708562 -> j579425018;
