		1714 -> 1716;
	1715 [label="PapaPolar: 很遗憾我们没能把那台相机从储藏室里拿出来给他，做个很棒的生日礼物。哦，好吧。",shape=box,color=blue];
		1715 -> 1706;
		1715 -> 1707;
