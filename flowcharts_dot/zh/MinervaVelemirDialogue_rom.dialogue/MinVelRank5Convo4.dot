		j858595603 -> j1025372319;
	j1276875549 [label="PapaPolar: 哈哈。那倒是真的。他非常——喜欢——你。有哪个女人能像他一样喝得了伏特加，——还能——在零度以下的天气里修得了卡车？！就她了。",shape=box,color=blue];
		j1276875549 -> j1660048729;
