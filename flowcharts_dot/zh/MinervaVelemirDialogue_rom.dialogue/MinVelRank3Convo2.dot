		719 -> 722;
	720 [label="PapaPolar: 这就是军人之歌。从我在这群快乐的小怪胎中收集到的信息来看，你和我们一样陷入了英择谛制造的混乱中。",shape=box,color=blue];
		720 -> 723;
	721 [label="PapaPolar: 哈哈，听起来是这样，如果我从我们那群快乐的小怪胎那里听到的疯狂故事有一半是真的话。",shape=box,color=blue];
		721 -> 724;
