	732 [label="+5 Chemistry",color=orange];
		732 -> 737;
	733 [label="PapaPolar: 你在开玩笑吧？他们这儿有什么鬼东西？拜托，真是够了。哈哈。得想办法用这里的油桶做个烟熏炉 ",shape=box,color=blue];
