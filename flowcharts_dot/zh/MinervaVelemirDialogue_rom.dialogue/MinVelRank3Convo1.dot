		j1685634906 -> j2186467634;
	j2970940338 [label="MomToxicated: 每个行业都有会议……无论好坏。而且不管什么行业，这些会议都一样无聊。",shape=box,color=blue];
		j2970940338 -> j2996933815;
	j2186467634 [label="MomToxicated: 好吧，既然维利米尔已经破坏了协议，那就把剩下的都毁了吧。“国际跨文化领导与咨询协会。”",shape=box,color=blue];
		j2186467634 -> j466881238;
	j2996933815 [label="MomToxicated: 好吧，既然维利米尔已经破坏了协议，那就把剩下的都毁了吧。“国际跨文化领导与咨询协会。”",shape=box,color=blue];
		j2996933815 -> j1733217352;
