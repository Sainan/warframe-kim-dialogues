		j3570484472 -> j4285030982;
	j4285030982 [label="PapaPolar: 突然间，[已屏蔽] 走进了酒吧。他们拿出了这个特别巨大的东西，说真的，你得看看这个东西，它是一个巨大的 [已屏蔽]",shape=box,color=blue];
