		j302266763 -> j368906919;
	j2028329320 [label="那看上去应该像个人吗？",shape=box,color=red];
		j2028329320 -> j722532835;
	j4034050482 [label="我……要去拯救世界了。或者……对抗邪恶势力……或者……收拾我的袜子……或者别的什么的。[结束]",shape=box,color=red];
		j4034050482 -> j1046679789;
	j3996662282 [label="我想知道。为什么？",shape=box,color=red];
		j3996662282 -> j1509395383;
	j368906919 [label="Check boolean MinVelTogether",color=orange];
		j368906919 -> j4016045622 [label=true,color=green];
		j368906919 -> j3829577002 [label=false,color=brown];
	j722532835 [label="PapaPolar: 我的意思是，应该是吧？但也不是？这不是重点——这是人们在某些时候会做的一件事—— ",shape=box,color=blue];
		j722532835 -> j368906919;
	j1509395383 [label="PapaPolar: 因为——",shape=box,color=blue];
		j1509395383 -> j2314073102;
	j4016045622 [label="MomToxicated: 这只是一件下雪的时候，当整个世界都慢下来，在户外做的很有意思的事。",shape=box,color=blue];
		j4016045622 -> j3516408848;
	j3829577002 [label="PapaPolar: 呃。我又想了一下，算了。",shape=box,color=blue];
		j3829577002 -> j1046679789;
	j2314073102 [label="PapaPolar: 啊该死",shape=box,color=blue];
		j2314073102 -> j853014663;
	j3516408848 [label="MomToxicated: 而且“球”是一种用雪很容易做出来的形状。",shape=box,color=blue];
		j3516408848 -> j301579086;
	j853014663 [label="PapaPolar: 该死，我忘了。可恶。",shape=box,color=blue];
		j853014663 -> j3955951634;
	j301579086 [label="MomToxicated: 此外，当一切变得寒冷又苍白时，它们却显得很愉快。",shape=box,color=blue];
		j301579086 -> j1005259732;
		j301579086 -> j375186402;
	j3955951634 [label="Check boolean MinVelTogether",color=orange];
		j3955951634 -> j2996087573 [label=true,color=green];
		j3955951634 -> j1407917477 [label=false,color=brown];
	j1005259732 [label="我想堆一个雪人。:)",shape=box,color=red];
		j1005259732 -> j3457787412;
	j375186402 [label="哦。真不错。 ",shape=box,color=red];
		j375186402 -> j3864477038;
	j2996087573 [label="MomToxicated: 因为要挑个好鼻子挖鼻孔。",shape=box,color=blue];
		j2996087573 -> j4162469964;
	j1407917477 [label="PapaPolar: 那算了。",shape=box,color=blue];
		j1407917477 -> j2669580780;
		j1407917477 -> j1663960872;
	j3457787412 [label="PapaPolar: 我很乐意教你怎么堆。:-D",shape=box,color=blue];
		j3457787412 -> j586036507;
	j3864477038 [label="PapaPolar: 正是！",shape=box,color=blue];
		j3864477038 -> j586036507;
	j4162469964 [label="PapaPolar: 哈哈！对！谢了，米",shape=box,color=blue];
		j4162469964 -> j697172353;
	j2669580780 [label="……等一下。但我要知道答案！！",shape=box,color=red];
		j2669580780 -> j2055024705;
	j1663960872 [label="不会吧？",shape=box,color=red];
		j1663960872 -> j2055024705;
	j586036507 [label="PapaPolar: 所以，那个笑话。",shape=box,color=blue];
		j586036507 -> j221659783;
	j697172353 [label="PapaPolar: 你怎么知道的？",shape=box,color=blue];
		j697172353 -> j146294564;
	j2055024705 [label="PapaPolar: 呃，我最后会想起来的。",shape=box,color=blue];
		j2055024705 -> j1046679789;
	j221659783 [label="PapaPolar: 雪人为什么要去做心理治疗？",shape=box,color=blue];
		j221659783 -> j1191146763;
	j146294564 [label="MomToxicated: 我们之前在光城的时候，你给外国代表团委员会讲过这个笑话。",shape=box,color=blue];
		j146294564 -> j1655916772;
	j1655916772 [label="PapaPolar: 哦对！哈哈哈。我把那次旅行忘得一干二净的。我以为你光往总理的酒里下毒就忙不过来了。",shape=box,color=blue];
		j1655916772 -> j2663619077;
	j2663619077 [label="MomToxicated: 我当时很忙，但这并不代表我当时没听你说。你是我的掩护。你差点就把我的行动搞砸了，因为我当时大笑了。",shape=box,color=blue];
		j2663619077 -> j3251400077;
	j3251400077 [label="PapaPolar: 啊啊啊",shape=box,color=blue];
		j3251400077 -> j1473396529;
	j1473396529 [label="PapaPolar: 如果我没记错的话，我们之后还去了那个地方试了神奇的蜗牛，不是吗？",shape=box,color=blue];
		j1473396529 -> j1805460944;
	j1805460944 [label="MomToxicated: 没错。那时候俄人像一群蜜蜂一样愤怒地出现，我们不得不赶紧离开。",shape=box,color=blue];
		j1805460944 -> j1145915000;
	j1145915000 [label="MomToxicated: 连那瓶酒还没来得及喝完",shape=box,color=blue];
		j1145915000 -> j4228306130;
	j4228306130 [label="PapaPolar: 好吧，特别不列颠尼克的远射先生和朋友们弄了一批新的自酿酒",shape=box,color=blue];
		j4228306130 -> j3613339646;
	j3613339646 [label="PapaPolar: 这酒虽然没贵到要我一年的工资，但是嘿，这次要喝个痛快吗？",shape=box,color=blue];
		j3613339646 -> j560988447;
	j560988447 [label="MomToxicated: 嗯。有得选就不错了，还讲究什么。算我一个。",shape=box,color=blue];
		j560988447 -> j1046679789;
}