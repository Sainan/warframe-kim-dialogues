	j2614376837 [label="导致她现在这样的，是一个巨大、不可知的虚空之神。你想跟他斗吗？请便，去排队吧。",shape=box,color=red];
		j2614376837 -> j1011375459;
	j3549380422 [label="有也没有？听着，我可没有对着她的头开枪。我没有。即便我有机会也没那样做。……好吧，是用过那些火箭，不过那是另外一回事。",shape=box,color=red];
