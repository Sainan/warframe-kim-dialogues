		j2413206994 -> j1808759084;
	j1516195160 [label="MomToxicated: 我忍不住在想，如果内奇知道我们被困在这里会怎么想。",shape=box,color=blue];
		j1516195160 -> j3300587217;
	j1808759084 [label="PapaPolar: 我希望她看到我们之间的问题解决了会很高兴。",shape=box,color=blue];
		j1808759084 -> j750076949;
		j1808759084 -> j48694725;
