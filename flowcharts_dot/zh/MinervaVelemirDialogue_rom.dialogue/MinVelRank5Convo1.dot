	1494 [label="PapaPolar: 我们上次和她通话是在一个加密线路上。 ",shape=box,color=blue];
		1494 -> 1496;
	1495 [label="Chat ends. Next chat will be MinVelRank5Convo2.",color=orange];
	1496 [label="PapaPolar: 她那只长相怪异的小鼬鼠可能也在偷听",shape=box,color=blue];
		1496 -> 1497;
	1497 [label="PapaPolar: 那时我们虽然*名义上*来说还在一起，但关系已经急转直下了……",shape=box,color=blue];
		1497 -> 1498;
	1498 [label="MomToxicated: 我敢打赌她肯定知道。她能听出来。即使我们当时还没意识到。",shape=box,color=blue];
		1498 -> 1499;
		1498 -> 1500;
	1499 [label="你当时能分辨出她是不是……你知道。“他”了吗？",shape=box,color=red];
		1499 -> 1501;
	1500 [label="你们三个当时聊了什么？",shape=box,color=red];
		1500 -> 1502;
	1501 [label="PapaPolar: 如果你是想问这个的话，她听起来确实像我们的小女孩。知道该说什么，还有怎么说。",shape=box,color=blue];
		1501 -> 1503;
	1502 [label="MomToxicated: 从公事开始聊。聊她如何指挥。当然，她不能告诉我们数字或细节。",shape=box,color=blue];
		1502 -> 1504;
	1503 [label="MomToxicated: 但是所有厉害的绑架犯都知道如何让囚鸟按照命令唱歌。",shape=box,color=blue];
		1503 -> 1505;
	1504 [label="MomToxicated: 我们又不是炽蛇军。对电话另一端的人来说，我们只不过是平民而已。所以她不可能给我们提供机密情报。",shape=box,color=blue];
		1504 -> 1506;
	1505 [label="MomToxicated: 这并不能说明这个“虚空无情之物”什么时候或如何，绑架了她。",shape=box,color=blue];
		1505 -> 1507;
	1506 [label="PapaPolar: 但她听起来……很紧张。你可以听得出来。",shape=box,color=blue];
		1506 -> 1508;
		1506 -> 1509;
	1507 [label="MomToxicated: 或者那天我们和她通话时是谁在控制她的身体。",shape=box,color=blue];
		1507 -> 1510;
	1508 [label="她？紧张？很难想象。",shape=box,color=red];
		1508 -> 1511;
	1509 [label="紧张什么？",shape=box,color=red];
		1509 -> 1512;
	1510 [label="PapaPolar: 我不知道怎么去找到一个神然后一拳打在它 [已屏蔽] 脸上，但我会 [已屏蔽] 尝试",shape=box,color=blue];
		1510 -> 1506;
	1511 [label="MomToxicated: 呵。谁都会有这种情况，哪怕是最优秀的人。尤其是当你在追捕“逃犯”的时候。",shape=box,color=blue];
		1511 -> 1513;
	1512 [label="MomToxicated: 一个“逃犯”。",shape=box,color=blue];
		1512 -> 1513;
	1513 [label="MomToxicated: 是英择谛。当时，我以为他“只是”当地的一个毒枭或反抗军领袖。",shape=box,color=blue];
		1513 -> 1514;
	1514 [label="PapaPolar: 几乎没有提到可怕的烤面包机怪物电视僵尸。你可能会以为这些更值得一提。",shape=box,color=blue];
		1514 -> 1515;
	1515 [label="MomToxicated: 我不知道那时她是不是已经失去了手臂。也没法知道，我想。",shape=box,color=blue];
		1515 -> 1516;
		1515 -> 1517;
	1516 [label="你们是怎么结束通话的？",shape=box,color=red];
		1516 -> 1518;
	1517 [label="你告诉她你要来霍瓦尼亚了吗？",shape=box,color=red];
		1517 -> 1519;
	1518 [label="MomToxicated: 间谍结束通话的惯用方式——互相撒谎。",shape=box,color=blue];
		1518 -> 1520;
	1519 [label="PapaPolar: 哈哈。当然没有。还记得吗，当时城市被封锁了？我们完全是秘密行动，偷偷潜入。",shape=box,color=blue];
		1519 -> 1521;
	1520 [label="MomToxicated: 我们告诉她我们要去其他地方执行任务，其实当时我们是在计划部署到她所在的封锁城市。",shape=box,color=blue];
		1520 -> 1522;
	1521 [label="MomToxicated: 我们按照间谍惯用的方式结束了通话——撒了谎。",shape=box,color=blue];
		1521 -> 1520;
	1522 [label="PapaPolar: 然后我们对彼此撒了最大的谎。",shape=box,color=blue];
		1522 -> 1523;
	1523 [label="PapaPolar: 我们都说“别担心，我们会没事的。”",shape=box,color=blue];
		1523 -> 1524;
	1524 [label="MomToxicated: 至少在挂断电话之前，我们对她说了最后一句实话。",shape=box,color=blue];
		1524 -> 1525;
	1525 [label="PapaPolar: 是的，我们说了。",shape=box,color=blue];
		1525 -> 1526;
