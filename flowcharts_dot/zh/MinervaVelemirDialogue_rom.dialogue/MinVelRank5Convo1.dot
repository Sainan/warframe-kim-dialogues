		j858961491 -> j3469037119;
	j3469037119 [label="+20 Chemistry",color=orange];
		j3469037119 -> "Chat ends. Next chat will be MinVelRank5Convo2.";
	j2995377614 [label="MomToxicated: 她很敏锐。比大多数人都敏锐。比我们把她训练得更好。",shape=box,color=blue];
		j2995377614 -> j2578459131;
	"Chat ends. Next chat will be MinVelRank5Convo2." [color=orange];
	j2578459131 [label="PapaPolar: 我们上次和她通话是在一个加密线路上。 ",shape=box,color=blue];
		j2578459131 -> j1477092874;
	j1477092874 [label="PapaPolar: 她那只长相怪异的小鼬鼠可能也在偷听",shape=box,color=blue];
		j1477092874 -> j2301243750;
	j2301243750 [label="PapaPolar: 那时我们虽然*名义上*来说还在一起，但关系已经急转直下了……",shape=box,color=blue];
		j2301243750 -> j1815936117;
	j1815936117 [label="MomToxicated: 我敢打赌她肯定知道。她能听出来。即使我们当时还没意识到。",shape=box,color=blue];
		j1815936117 -> j402021960;
		j1815936117 -> j2393347561;
	j402021960 [label="你当时能分辨出她是不是……你知道。“他”了吗？",shape=box,color=red];
		j402021960 -> j2268028417;
	j2393347561 [label="你们三个当时聊了什么？",shape=box,color=red];
		j2393347561 -> j1926448972;
	j2268028417 [label="PapaPolar: 如果你是想问这个的话，她听起来确实像我们的小女孩。知道该说什么，还有怎么说。",shape=box,color=blue];
		j2268028417 -> j986221084;
	j1926448972 [label="MomToxicated: 从公事开始聊。聊她如何指挥。当然，她不能告诉我们数字或细节。",shape=box,color=blue];
		j1926448972 -> j612580966;
	j986221084 [label="MomToxicated: 但是所有厉害的绑架犯都知道如何让囚鸟按照命令唱歌。",shape=box,color=blue];
		j986221084 -> j1448156002;
	j612580966 [label="MomToxicated: 我们又不是炽蛇军。对电话另一端的人来说，我们只不过是平民而已。所以她不可能给我们提供机密情报。",shape=box,color=blue];
		j612580966 -> j3032003337;
	j1448156002 [label="MomToxicated: 这并不能说明这个“虚空无情之物”什么时候或如何，绑架了她。",shape=box,color=blue];
		j1448156002 -> j2911611745;
	j3032003337 [label="PapaPolar: 但她听起来……很紧张。你可以听得出来。",shape=box,color=blue];
		j3032003337 -> j4114455249;
		j3032003337 -> j2241410921;
	j2911611745 [label="MomToxicated: 或者那天我们和她通话时是谁在控制她的身体。",shape=box,color=blue];
		j2911611745 -> j321969310;
	j4114455249 [label="她？紧张？很难想象。",shape=box,color=red];
		j4114455249 -> j2296518405;
	j2241410921 [label="紧张什么？",shape=box,color=red];
		j2241410921 -> j3837527080;
	j321969310 [label="PapaPolar: 我不知道怎么去找到一个神然后一拳打在它 [已屏蔽] 脸上，但我会 [已屏蔽] 尝试",shape=box,color=blue];
		j321969310 -> j3032003337;
	j2296518405 [label="MomToxicated: 呵。谁都会有这种情况，哪怕是最优秀的人。尤其是当你在追捕“逃犯”的时候。",shape=box,color=blue];
		j2296518405 -> j3072602287;
	j3837527080 [label="MomToxicated: 一个“逃犯”。",shape=box,color=blue];
		j3837527080 -> j3072602287;
	j3072602287 [label="MomToxicated: 是英择谛。当时，我以为他“只是”当地的一个毒枭或反抗军领袖。",shape=box,color=blue];
		j3072602287 -> j3507118948;
	j3507118948 [label="PapaPolar: 几乎没有提到可怕的烤面包机怪物电视僵尸。你可能会以为这些更值得一提。",shape=box,color=blue];
		j3507118948 -> j2938472557;
	j2938472557 [label="MomToxicated: 我不知道那时她是不是已经失去了手臂。也没法知道，我想。",shape=box,color=blue];
		j2938472557 -> j2055546105;
		j2938472557 -> j3921465183;
	j2055546105 [label="你们是怎么结束通话的？",shape=box,color=red];
		j2055546105 -> j838019008;
	j3921465183 [label="你告诉她你要来霍瓦尼亚了吗？",shape=box,color=red];
		j3921465183 -> j76541313;
	j838019008 [label="MomToxicated: 间谍结束通话的惯用方式——互相撒谎。",shape=box,color=blue];
		j838019008 -> j2782081763;
	j76541313 [label="PapaPolar: 哈哈。当然没有。还记得吗，当时城市被封锁了？我们完全是秘密行动，偷偷潜入。",shape=box,color=blue];
		j76541313 -> j2333933092;
	j2782081763 [label="MomToxicated: 我们告诉她我们要去其他地方执行任务，其实当时我们是在计划部署到她所在的封锁城市。",shape=box,color=blue];
		j2782081763 -> j453866850;
	j2333933092 [label="MomToxicated: 我们按照间谍惯用的方式结束了通话——撒了谎。",shape=box,color=blue];
		j2333933092 -> j2782081763;
	j453866850 [label="PapaPolar: 然后我们对彼此撒了最大的谎。",shape=box,color=blue];
		j453866850 -> j3187550468;
	j3187550468 [label="PapaPolar: 我们都说“别担心，我们会没事的。”",shape=box,color=blue];
		j3187550468 -> j1258513221;
	j1258513221 [label="MomToxicated: 至少在挂断电话之前，我们对她说了最后一句实话。",shape=box,color=blue];
		j1258513221 -> j892613878;
	j892613878 [label="PapaPolar: 是的，我们说了。",shape=box,color=blue];
		j892613878 -> j3905103607;
		j892613878 -> j1884658485;
	j3905103607 [label="哦？",shape=box,color=red];
		j3905103607 -> j666870648;
	j1884658485 [label="是什么？",shape=box,color=red];
		j1884658485 -> j666870648;
	j666870648 [label="PapaPolar: “你是我们的宝贝女儿。没有什么可以改变这一点。”",shape=box,color=blue];
		j666870648 -> j2431594200;
	j2431594200 [label="MomToxicated: “无论你走多远，我们都会永远爱你。”",shape=box,color=blue];
		j2431594200 -> j1233429403;
		j2431594200 -> j103308920;
	j1233429403 [label="我相信她依然知道的，不管她到底发生了什么。",shape=box,color=red];
		j1233429403 -> j4143240552;
	j103308920 [label="有你们这两位父母，她真是幸运。",shape=box,color=red];
