		j571637331 -> j340905357 [label=false,color=brown];
	j2521024550 [label="MomToxicated: 我又开始想念内奇了。 ",shape=box,color=blue];
		j2521024550 -> j3686287855;
	j1633939233 [label="鲁莎卡会笑吗？我是说真的笑吗？不是那种邪恶的笑。",shape=box,color=red];
		j1633939233 -> j1572433800;
	j340905357 [label="那个，鲁莎卡一直以来都是这么……嗯，怎么说好呢……",shape=box,color=red];
		j340905357 -> j4201792889;
	j3686287855 [label="MomToxicated: 还有那次我带她出去给维利买生日礼物。",shape=box,color=blue];
		j3686287855 -> j3945879596;
	j1572433800 [label="PapaPolar: 内奇喜欢笑。",shape=box,color=blue];
		j1572433800 -> j775301232;
		j1572433800 -> j2195157158;
	j4201792889 [label="PapaPolar: 邪恶？",shape=box,color=blue];
		j4201792889 -> j263621242;
		j4201792889 -> j3165689550;
	j3945879596 [label="PapaPolar: 那年你送了我项链。",shape=box,color=blue];
		j3945879596 -> j1582502480;
	j775301232 [label="我可以想象到那一幕。",shape=box,color=red];
		j775301232 -> j3285888434;
	j2195157158 [label="你在开玩笑吧。",shape=box,color=red];
		j2195157158 -> j3285888434;
	j263621242 [label="差不多吧？",shape=box,color=red];
		j263621242 -> j4235068343;
	j3165689550 [label="这是你说的，我可没有。",shape=box,color=red];
		j3165689550 -> j4235068343;
	j1582502480 [label="MomToxicated: 而她送了你打火机。",shape=box,color=blue];
		j1582502480 -> j4127564022;
	j3285888434 [label="PapaPolar: 伙计，你以为我为什么会讲这么多故事？",shape=box,color=blue];
		j3285888434 -> j4260687943;
	j4235068343 [label="PapaPolar: 确实像她妈。但是她也充满了快乐。",shape=box,color=blue];
		j4235068343 -> j3285888434;
	j4127564022 [label="MomToxicated: 没有什么比一个 12 岁的小女孩走到柜台前，把打火机拍在柜台上，瞪着柜台后面的男人更有趣的了。",shape=box,color=blue];
		j4127564022 -> j1215532816;
	j4260687943 [label="PapaPolar: 这是我和她在一起时养成的习惯。她喜欢听这些。总想知道我和米在做什么",shape=box,color=blue];
		j4260687943 -> j4162097165;
	j1215532816 [label="MomToxicated: 然后她严肃要求按照她的方式进行雕刻。",shape=box,color=blue];
		j1215532816 -> j1468636236;
		j1215532816 -> j584606745;
	j4162097165 [label="PapaPolar: 然后我就跟她讲这事那事，“还有什么‘不是吧，就这样了’”",shape=box,color=blue];
		j4162097165 -> j2244651182;
	j1468636236 [label="她小时候笑过吗？就像正常的笑一样。不是那种邪恶的笑。",shape=box,color=red];
		j1468636236 -> j2040625262;
	j584606745 [label="我可以想象到那一幕。",shape=box,color=red];
		j584606745 -> j2891560881;
	j2244651182 [label="PapaPolar: 还有这事搞得一塌糊涂",shape=box,color=blue];
		j2244651182 -> j3540326021;
	j2040625262 [label="PapaPolar: 你在跟我开玩笑吗？她经常笑！内奇喜欢笑。",shape=box,color=blue];
		j2040625262 -> j2195157158;
		j2040625262 -> j2354258;
	j2891560881 [label="PapaPolar: 确实像她妈。但是她也充满了快乐。",shape=box,color=blue];
		j2891560881 -> j1187843516;
	j3540326021 [label="PapaPolar: 她就坐在那里笑啊笑",shape=box,color=blue];
		j3540326021 -> j619727511;
	j2354258 [label="哦？她觉得什么好笑？（请不要再讲老爸笑话了。）",shape=box,color=red];
		j2354258 -> j3285888434;
	j1187843516 [label="PapaPolar: 内奇喜欢笑。",shape=box,color=blue];
		j1187843516 -> j2354258;
		j1187843516 -> j2195157158;
	j619727511 [label="PapaPolar: 没有人像她那样只喜欢听精彩的倒霉故事",shape=box,color=blue];
		j619727511 -> j2103314280;
	j2103314280 [label="MomToxicated: 我们会给她带一些小玩意儿。不管是什么。",shape=box,color=blue];
		j2103314280 -> j2834670939;
	j2834670939 [label="MomToxicated: 但对她来说，这是那段故事的一部分。一段回忆。它也被收进了她的收藏中。",shape=box,color=blue];
		j2834670939 -> j4162513529;
	j4162513529 [label="MomToxicated: 她可能不在故事里，但东西在。",shape=box,color=blue];
		j4162513529 -> j2503007650;
	j2503007650 [label="Check boolean MinVelTogether",color=orange];
		j2503007650 -> j2625978212 [label=true,color=green];
		j2503007650 -> j3646511707 [label=false,color=brown];
	j2625978212 [label="PapaPolar: 我不知道她还有没有保留着这些东西……或者曾经保留过。不指望虚空无情之物会拿着行李箱",shape=box,color=blue];
		j2625978212 -> j2845226559;
	j3646511707 [label="PapaPolar: 我想，这些可能全都被扔进垃圾箱了。虚空无情之物可不会带着装满杂物的箱子到处跑。",shape=box,color=blue];
		j3646511707 -> j3189931124;
	j2845226559 [label="MomToxicated: 你可能是对的。但这就是故事的意义，不是吗？",shape=box,color=blue];
		j2845226559 -> j716695041;
	j3189931124 [label="MomToxicated: 你可能是对的。",shape=box,color=blue];
		j3189931124 -> j3258259251;
	j716695041 [label="MomToxicated: 事情来来去去。但故事永远不会离开我们。",shape=box,color=blue];
		j716695041 -> j2998547895;
	j3258259251 [label="+20 Chemistry",color=orange];
		j3258259251 -> "Chat ends. Next chat will be MinVelRank5Convo4.";
