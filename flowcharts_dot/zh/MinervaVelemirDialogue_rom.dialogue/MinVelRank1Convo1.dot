digraph {
	0 [label="MinVelRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="MomToxicated: 她怎么了？我需要答案。",shape=box,color=blue];
		1 -> 2;
	2 [label="MomToxicated: 真正的答案。而不是其他人给我的那些“很难解释”的废话。",shape=box,color=blue];
		2 -> 3;
		2 -> 4;
		2 -> 5;
		2 -> 6;
	3 [label="呵呵。",shape=box,color=red];
		3 -> 7;
	4 [label="你好？",shape=box,color=red];
		4 -> 7;
	5 [label="呃。",shape=box,color=red];
		5 -> 7;
	6 [label="你是……？",shape=box,color=red];
		6 -> 7;
	7 [label="PapaPolar: 没必要这样。可以先来一句“嗨，你好吗？”",shape=box,color=blue];
		7 -> 8;
	8 [label="PapaPolar: 对不起，伙计。当米锁定目标时，就只知道冲冲冲。",shape=box,color=blue];
		8 -> 9;
	9 [label="MomToxicated: 我不需要你来干扰我。",shape=box,color=blue];
		9 -> 10;
	10 [label="PapaPolar: 我没有干扰吧？",shape=box,color=blue];
		10 -> 11;
	11 [label="MomToxicated: 哈。是啊。对。说的好像你在亚尔切斯科没有干扰我似的。",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="我猜你们是米尼娃和维利米尔？",shape=box,color=red];
		12 -> 14;
	13 [label="行了……我们能不能倒带一下？到底发生了什么？",shape=box,color=red];
		13 -> 15;
	14 [label="PapaPolar: 是的。抱歉。嗨。我可能是更容易猜到的那个，对吧？哈哈",shape=box,color=blue];
		14 -> 16;
	15 [label="PapaPolar: 哈哈！抱歉，伙计。我是维利米尔。那位 MomToxicated 是米尼娃。",shape=box,color=blue];
		15 -> 17;
	16 [label="PapaPolar: 那位 MomToxicated 是米尼娃。",shape=box,color=blue];
		16 -> 17;
	17 [label="MomToxicated: 维利米尔。用这个用户名又有什么意义，如果你只是—— ",shape=box,color=blue];
		17 -> 18;
	18 [label="MomToxicated: 该死。",shape=box,color=blue];
		18 -> 19;
	19 [label="PapaPolar: 米，理智点。用排除法。这个聊天系统上会有多少个像我们这样的怪胎？",shape=box,color=blue];
		19 -> 20;
		19 -> 21;
		19 -> 22;
	20 [label="我感觉随着时间的推移，类似的怪胎只会越来越多。",shape=box,color=red];
		20 -> 23;
	21 [label="你们俩能不能先把眼前事解决了*再*来找我？",shape=box,color=red];
		21 -> 24;
	22 [label="我现在真的超困惑。",shape=box,color=red];
		22 -> 25;
	23 [label="Update boolean VelimirFamily1",color=orange];
		23 -> 26;
	24 [label="PapaPolar: 伙计，那你可能要等很久了。哈。",shape=box,color=blue];
		24 -> 27;
	25 [label="PapaPolar: 好吧，如果连*你*都困惑的话，那我们就都完蛋了。哈哈！",shape=box,color=blue];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="PapaPolar: 简而言之，米有一些问题想要得到答案，她希望你能回答。",shape=box,color=blue];
		27 -> 30;
	28 [label="PapaPolar: 因为我们来这里就是为了向你寻求答案。",shape=box,color=blue];
		28 -> 30;
	29 [label="PapaPolar: 我倒是希望如此！我觉得，人越多越好。就像那句老话说的，邪教和宗教的唯一区别就是人数，哈哈。",shape=box,color=blue];
		29 -> 31;
	30 [label="PapaPolar: 好了。米，这样可以了吧？这更符合你的“好警察/坏警察”套路吗？",shape=box,color=blue];
		30 -> 32;
	31 [label="PapaPolar: 这算是一句谚语吗？",shape=box,color=blue];
		31 -> 33;
	32 [label="MomToxicated: 太阳神在上，我要疯了……",shape=box,color=blue];
		32 -> 34;
		32 -> 35;
		32 -> 36;
	33 [label="PapaPolar: 我不太确定。你懂我的意思。我是这么看的，水很棒，大家一起下水吧！好吧，反正就这样。",shape=box,color=blue];
		33 -> 27;
	34 [label="为什么我感觉自己像是在被审问？",shape=box,color=red];
		34 -> 37;
	35 [label="嗯，我倒希望你不要试图在对话中玩什么“套路”。",shape=box,color=red];
		35 -> 38;
	36 [label="你有什么问题？如果可以的话我会尽力帮助你。",shape=box,color=red];
		36 -> 39;
	37 [label="MomToxicated: 维利米尔，一句话也别说。",shape=box,color=blue];
		37 -> 40;
	38 [label="MomToxicated: 这根本不是什么套路。",shape=box,color=blue];
		38 -> 41;
	39 [label="MomToxicated: “漂泊者”，你的配合行为已经被记录。",shape=box,color=blue];
		39 -> 42;
	40 [label="PapaPolar: :-X",shape=box,color=blue];
		40 -> 43;
	41 [label="MomToxicated: 你打算回答我的问题吗？是或否？",shape=box,color=blue];
		41 -> 44;
		41 -> 45;
	42 [label="MomToxicated: 如果那是你的真名的话。",shape=box,color=blue];
		42 -> 46;
	43 [label="MomToxicated: 感觉就像在应对——算了。算了。不重要。",shape=box,color=blue];
