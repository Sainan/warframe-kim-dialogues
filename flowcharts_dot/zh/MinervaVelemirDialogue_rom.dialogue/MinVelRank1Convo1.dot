		"MinVelRank1Convo1 begins." -> j1891629484;
	j1891629484 [label="MomToxicated: 她怎么了？我需要答案。",shape=box,color=blue];
		j1891629484 -> j196654938;
	j196654938 [label="MomToxicated: 真正的答案。而不是其他人给我的那些“很难解释”的废话。",shape=box,color=blue];
		j196654938 -> j2723720696;
		j196654938 -> j3267311411;
		j196654938 -> j477781370;
		j196654938 -> j2533061713;
	j2723720696 [label="呵呵。",shape=box,color=red];
		j2723720696 -> j3275202084;
	j3267311411 [label="你好？",shape=box,color=red];
		j3267311411 -> j3275202084;
	j477781370 [label="呃。",shape=box,color=red];
		j477781370 -> j3275202084;
	j2533061713 [label="你是……？",shape=box,color=red];
		j2533061713 -> j3275202084;
	j3275202084 [label="PapaPolar: 没必要这样。可以先来一句“嗨，你好吗？”",shape=box,color=blue];
		j3275202084 -> j1155429491;
	j1155429491 [label="PapaPolar: 对不起，伙计。当米锁定目标时，就只知道冲冲冲。",shape=box,color=blue];
		j1155429491 -> j4024959465;
	j4024959465 [label="MomToxicated: 我不需要你来干扰我。",shape=box,color=blue];
		j4024959465 -> j828300424;
	j828300424 [label="PapaPolar: 我没有干扰吧？",shape=box,color=blue];
		j828300424 -> j2085812962;
	j2085812962 [label="MomToxicated: 哈。是啊。对。说的好像你在亚尔切斯科没有干扰我似的。",shape=box,color=blue];
		j2085812962 -> j3119240710;
		j2085812962 -> j1993733229;
	j3119240710 [label="我猜你们是米尼娃和维利米尔？",shape=box,color=red];
		j3119240710 -> j732732268;
	j1993733229 [label="行了……我们能不能倒带一下？到底发生了什么？",shape=box,color=red];
		j1993733229 -> j3951211226;
	j732732268 [label="PapaPolar: 是的。抱歉。嗨。我可能是更容易猜到的那个，对吧？哈哈",shape=box,color=blue];
		j732732268 -> j3872812801;
	j3951211226 [label="PapaPolar: 哈哈！抱歉，伙计。我是维利米尔。那位 MomToxicated 是米尼娃。",shape=box,color=blue];
		j3951211226 -> j3407191832;
	j3872812801 [label="PapaPolar: 那位 MomToxicated 是米尼娃。",shape=box,color=blue];
		j3872812801 -> j3407191832;
	j3407191832 [label="MomToxicated: 维利米尔。用这个用户名又有什么意义，如果你只是—— ",shape=box,color=blue];
		j3407191832 -> j2263421105;
	j2263421105 [label="MomToxicated: 该死。",shape=box,color=blue];
		j2263421105 -> j1337760904;
	j1337760904 [label="PapaPolar: 米，理智点。用排除法。这个聊天系统上会有多少个像我们这样的怪胎？",shape=box,color=blue];
		j1337760904 -> j1135249501;
		j1337760904 -> j4236717986;
		j1337760904 -> j1449575101;
	j1135249501 [label="我感觉随着时间的推移，类似的怪胎只会越来越多。",shape=box,color=red];
		j1135249501 -> j2918631250;
	j4236717986 [label="你们俩能不能先把眼前事解决了*再*来找我？",shape=box,color=red];
		j4236717986 -> j1342680291;
	j1449575101 [label="我现在真的超困惑。",shape=box,color=red];
		j1449575101 -> j359637537;
	j2918631250 [label="Boolean VelimirFamily1 is now true.",color=orange];
		j2918631250 -> j17092469;
	j1342680291 [label="PapaPolar: 伙计，那你可能要等很久了。哈。",shape=box,color=blue];
		j1342680291 -> j2936508938;
	j359637537 [label="PapaPolar: 好吧，如果连*你*都困惑的话，那我们就都完蛋了。哈哈！",shape=box,color=blue];
		j359637537 -> j2589595458;
	j17092469 [label="+5 Chemistry",color=orange];
		j17092469 -> j4113285797;
	j2936508938 [label="PapaPolar: 简而言之，米有一些问题想要得到答案，她希望你能回答。",shape=box,color=blue];
		j2936508938 -> j758971236;
	j2589595458 [label="PapaPolar: 因为我们来这里就是为了向你寻求答案。",shape=box,color=blue];
		j2589595458 -> j758971236;
	j4113285797 [label="PapaPolar: 我倒是希望如此！我觉得，人越多越好。就像那句老话说的，邪教和宗教的唯一区别就是人数，哈哈。",shape=box,color=blue];
		j4113285797 -> j1917992549;
	j758971236 [label="PapaPolar: 好了。米，这样可以了吧？这更符合你的“好警察/坏警察”套路吗？",shape=box,color=blue];
		j758971236 -> j2004805286;
	j1917992549 [label="PapaPolar: 这算是一句谚语吗？",shape=box,color=blue];
		j1917992549 -> j606410136;
	j2004805286 [label="MomToxicated: 太阳神在上，我要疯了……",shape=box,color=blue];
		j2004805286 -> j1932088476;
		j2004805286 -> j277562771;
		j2004805286 -> j3985887377;
	j606410136 [label="PapaPolar: 我不太确定。你懂我的意思。我是这么看的，水很棒，大家一起下水吧！好吧，反正就这样。",shape=box,color=blue];
		j606410136 -> j2936508938;
	j1932088476 [label="为什么我感觉自己像是在被审问？",shape=box,color=red];
		j1932088476 -> j790209011;
	j277562771 [label="嗯，我倒希望你不要试图在对话中玩什么“套路”。",shape=box,color=red];
		j277562771 -> j4069467299;
	j3985887377 [label="你有什么问题？如果可以的话我会尽力帮助你。",shape=box,color=red];
		j3985887377 -> j218391264;
	j790209011 [label="MomToxicated: 维利米尔，一句话也别说。",shape=box,color=blue];
		j790209011 -> j4021937198;
	j4069467299 [label="MomToxicated: 这根本不是什么套路。",shape=box,color=blue];
		j4069467299 -> j4120743843;
	j218391264 [label="MomToxicated: “漂泊者”，你的配合行为已经被记录。",shape=box,color=blue];
