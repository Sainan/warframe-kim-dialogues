		j2456185885 -> j1628000483;
	j1883421415 [label="我猜你指的是阿米尔。",shape=box,color=red];
		j1883421415 -> j3093421072;
	j737055299 [label="PapaPolar: 我看起来像是科特·吉士尼公主吗？你觉得我指的是谁？",shape=box,color=blue];
