		j3093421072 -> j2987373398;
	j3517150278 [label="PapaPolar: 就是那个心胸宽阔、活泼可爱的米尔",shape=box,color=blue];
		j3517150278 -> j996885832;
	j2394882636 [label="PapaPolar: 嘿，嗯。嘿",shape=box,color=blue];
		j2394882636 -> j996885832;
