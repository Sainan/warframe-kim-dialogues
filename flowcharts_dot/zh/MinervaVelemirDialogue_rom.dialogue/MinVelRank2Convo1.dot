		j1000399741 -> j3517572101;
	j3976632845 [label="是的，看起来你们已经不在一起了。",shape=box,color=red];
		j3976632845 -> j3223817380;
	j117472070 [label="PapaPolar: 然后，她还紧抱着一个小兔子毛绒玩具。米告诉她，她会用生命来保护它，保证它的安全。",shape=box,color=blue];
		j117472070 -> j3994746794;
