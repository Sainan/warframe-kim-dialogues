		j2987373398 -> j996885832;
	j996885832 [label="PapaPolar: 话说回来，我跟他聊天——或者更确切地说，他在对着我说",shape=box,color=blue];
		j996885832 -> j1792421806;
	j1792421806 [label="PapaPolar: ……我感觉你应该非常能理解这种感觉……",shape=box,color=blue];
		j1792421806 -> j3417219925;
