		j3994746794 -> j3396204079;
	j3848954863 [label="PapaPolar: 但现在只是纸面上的关系。而且，考虑到那个国家大概在 1982 年就已经不复存在了，你可以自己判断这段婚姻算不算数",shape=box,color=blue];
		j3848954863 -> j1000399741;
