		j1308054258 -> j3012341225;
	j3012341225 [label="PapaPolar: 我是以每小时八十几亿里的速度听到的，别担心，伙计",shape=box,color=blue];
		j3012341225 -> j3046342512;
	j3046342512 [label="PapaPolar: 靠。我大概只听懂了三分之一。而且这三分之一已经超出了我的承受范围。你需要个拥抱吗，伙计？",shape=box,color=blue];
		j3046342512 -> j3253363467;
