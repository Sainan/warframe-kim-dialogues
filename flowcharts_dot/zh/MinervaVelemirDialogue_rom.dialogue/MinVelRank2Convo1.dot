		j422652130 -> j917679871;
	j2406507059 [label="PapaPolar: 嗯。可以这么说。我们结过婚，不过现在不算了。只是纸面上的关系。在某个大约在 1982 年就不复存在的国家？",shape=box,color=blue];
		j2406507059 -> j4276514666;
	j2437001781 [label="PapaPolar: 我们当时在国外，从这往南距离有几个国家的一个小镇。那里被炸得粉碎。我们在那里发现了个小女孩。小小的，才到膝盖那么高，一头红发，脾气爆得像被捅了的蜂窝一样 ",shape=box,color=blue];
		j2437001781 -> j2937061048;
