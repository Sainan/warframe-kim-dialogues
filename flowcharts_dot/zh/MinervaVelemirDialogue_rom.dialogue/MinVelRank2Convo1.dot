		j3253363467 -> j924652561;
	j2895773000 [label="只要你抱的时候别把我的脊椎折断就行，大块头。",shape=box,color=red];
		j2895773000 -> j4059835622;
	j961242516 [label="我可不会拒绝免费的拥抱。 ",shape=box,color=red];
		j961242516 -> j1596231182;
	j924652561 [label="PapaPolar: 很高兴你找到了可以能让你填补空白的地方。这比很多人一辈子能得到的都多。",shape=box,color=blue];
		j924652561 -> j2453893078;
	j4059835622 [label="PapaPolar: 哈哈。免费正骨按摩，而且我还自带冰敷服务呢",shape=box,color=blue];
		j4059835622 -> j4007350778;
	j1596231182 [label="PapaPolar: 不错嘛。人生已经够糟了，能让它好一点的事情可不能放过。",shape=box,color=blue];
		j1596231182 -> j4007350778;
