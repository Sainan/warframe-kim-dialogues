digraph {
	"MinVelRusalka begins." [color=orange];
		"MinVelRusalka begins." -> j1138299529;
	j1138299529 [label="Check boolean VelimirEclipse",color=orange];
		j1138299529 -> j4173473723 [label=true,color=green];
		j1138299529 -> "Chat ends." [label=false,color=brown];
	j4173473723 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:CheckDuviriMitwCollectibles()",color=orange];
		j4173473723 -> j1034440004 [label=true,color=green];
		j4173473723 -> "Chat ends." [label=false,color=brown];
	"Chat ends." [color=orange];
	j1034440004 [label="嘿。伙计们？",shape=box,color=red];
		j1034440004 -> j4140054304;
	j4140054304 [label="MomToxicated: 什么事？",shape=box,color=blue];
		j4140054304 -> j2679310799;
	j2679310799 [label="PapaPolar: 怎么了，小伙计？",shape=box,color=blue];
		j2679310799 -> j3610164376;
		j2679310799 -> j109480605;
		j2679310799 -> j3966030205;
	j3610164376 [label="我有一个好消息和一个坏消息。都是关于内奇的。",shape=box,color=red];
		j3610164376 -> j2509591066;
	j109480605 [label="你们先别太激动。我有内奇的消息了，不过……情况有些复杂。目前还没有定论。",shape=box,color=red];
		j109480605 -> j3903584153;
	j3966030205 [label="唉……算了，没事。[结束]",shape=box,color=red];
		j3966030205 -> "Chat ends.";
	j2509591066 [label="PapaPolar: 都是成年人了。先说坏消息。",shape=box,color=blue];
		j2509591066 -> j2706886100;
	j3903584153 [label="+5 Chemistry",color=orange];
		j3903584153 -> j1229464783;
	j2706886100 [label="MomToxicated: 同意。总是要先听坏消息的。",shape=box,color=blue];
		j2706886100 -> j1128471090;
	j1229464783 [label="MomToxicated: 生活本就如此。但还是谢谢你的提醒。",shape=box,color=blue];
		j1229464783 -> j1857870774;
	j1128471090 [label="那个，虚空无情之物进到双衍王境里了，然后……它还把内奇带到那里了。",shape=box,color=red];
		j1128471090 -> j1518988271;
	j1857870774 [label="+5 Chemistry",color=orange];
		j1857870774 -> j3491313398;
	j1518988271 [label="PapaPolar: 等等，等等。你是说进到那个故事书里了？",shape=box,color=blue];
		j1518988271 -> j3494916102;
	j3491313398 [label="PapaPolar: 我做好心理准备了，不过听你这么说……她起码还活着，对吧？",shape=box,color=blue];
		j3491313398 -> j946760107;
	j3494916102 [label="MomToxicated: 是那个有个小孩独裁者，一遍遍杀死你的地方？",shape=box,color=blue];
		j3494916102 -> j1038388729;
		j3494916102 -> j1708984311;
	j946760107 [label="我……不确定。我觉得她可能不在了。我还是先把我知道的都告诉你们吧，剩下的你们自己判断。",shape=box,color=red];
		j946760107 -> j1128471090;
	j1038388729 [label="结果这反而对他来说算是个成长的契机？但这不是重点。总之——",shape=box,color=red];
		j1038388729 -> j2234821962;
	j1708984311 [label="就是那里。",shape=box,color=red];
		j1708984311 -> j2234821962;
	j2234821962 [label="内奇……坐上了王位。低语者——也就是虚空无情之物所谓的“军队”，抱歉我想不到更好的词来形容了。它们发起了入侵，然后她趁机掌控了局面。",shape=box,color=red];
		j2234821962 -> j2725701839;
	j2725701839 [label="MomToxicated: 呵，不愧是我的小女孩。",shape=box,color=blue];
		j2725701839 -> j340396310;
	j340396310 [label="PapaPolar: 可那还是*她*吗？还是说是那个东西顶着她的脸？",shape=box,color=blue];
		j340396310 -> j462326449;
		j340396310 -> j1528172871;
	j462326449 [label="我不知道。",shape=box,color=red];
		j462326449 -> j230410666;
	j1528172871 [label="我就是想跟你们聊聊这个事。",shape=box,color=red];
		j1528172871 -> j230410666;
	j230410666 [label="我发现了这些记录。虽然一开始乱七八糟的，但我把它们拼起来以后，我……发现了一条信息。",shape=box,color=red];
		j230410666 -> j2871934032;
	j2871934032 [label="我想知道，你们能看懂吗。",shape=box,color=red];
		j2871934032 -> j619116709;
	j619116709 [label="MomToxicated: 破解谜语和奇怪的信息？我们很在行。",shape=box,color=blue];
		j619116709 -> j3555404495;
	j3555404495 [label="PapaPolar: 1-800-间谍-热线，你算是找对人了。",shape=box,color=blue];
		j3555404495 -> j2351045861;
	j2351045861 [label="那条信息是这样的：“当日月汇聚，迷途者终将寻得归途。”",shape=box,color=red];
		j2351045861 -> j731450944;
	j731450944 [label="PapaPolar: ……该死。米，糟了。",shape=box,color=blue];
		j731450944 -> j1005641603;
	j1005641603 [label="MomToxicated: 别上当。如果那东西已经入侵了她的意识，它会知道她所知道的一切。",shape=box,color=blue];
		j1005641603 -> j3433307255;
		j1005641603 -> j712397376;
	j3433307255 [label="什么？那条信息是什么意思？",shape=box,color=red];
		j3433307255 -> j3066940459;
	j712397376 [label="这句话是另一半，对吧？",shape=box,color=red];
		j712397376 -> j2690956542;
	j3066940459 [label="PapaPolar: “于静寂歧路，追寻日蚀。”",shape=box,color=blue];
		j3066940459 -> j4289030176;
	j2690956542 [label="+5 Chemistry",color=orange];
		j2690956542 -> j3583751588;
	j4289030176 [label="PapaPolar: 我之前跟你说过，要是再遇到了我们的小女孩，就告诉她那句话。",shape=box,color=blue];
		j4289030176 -> j3613912926;
	j3583751588 [label="PapaPolar: 没错……",shape=box,color=blue];
		j3583751588 -> j944882814;
	j3613912926 [label="PapaPolar: 这句话是我们俩这边的暗语。每次打电话前都会对这个暗语，来确认线路安全，万无一失。",shape=box,color=blue];
		j3613912926 -> j23440374;
	j944882814 [label="PapaPolar: 我们设了个暗语。每次打电话前都会对这个暗语，来确认线路安全，万无一失。",shape=box,color=blue];
		j944882814 -> j23440374;
	j23440374 [label="MomToxicated: 确认彼此……依然是真正的自己。",shape=box,color=blue];
		j23440374 -> j4138448653;
	j4138448653 [label="PapaPolar: “于静寂歧路，追寻日蚀”是我们俩的部分。",shape=box,color=blue];
		j4138448653 -> j1656275256;
	j1656275256 [label="MomToxicated: 暗语的下半部分，就是“当日月汇聚，迷途者终将寻得归途。”",shape=box,color=blue];
		j1656275256 -> j2400572754;
	j2400572754 [label="MomToxicated: 是*她*要对上的部分。",shape=box,color=blue];
		j2400572754 -> j2343976136;
		j2400572754 -> j66872123;
	j2343976136 [label="米尼娃，就像你说的，我们没法确定那还是她。虚空无情之物清楚她知道的一切。",shape=box,color=red];
		j2343976136 -> j3485989879;
	j66872123 [label="我不知道虚空无情之物为什么要告诉你们这个……",shape=box,color=red];
		j66872123 -> j3433106234;
	j3485989879 [label="MomToxicated: 可是它为什么要给我们一丝希望呢？除非它是想折磨我们。",shape=box,color=blue];
		j3485989879 -> j4165328479;
	j3433106234 [label="MomToxicated: 也许是想给我们一点虚假的希望？然后借此来加深我们的痛苦？",shape=box,color=blue];
		j3433106234 -> j3207263568;
	j4165328479 [label="PapaPolar: 这很痛苦吗？",shape=box,color=blue];
		j4165328479 -> j2430290788;
	j3207263568 [label="PapaPolar: 这是假的吗？这很痛苦吗？",shape=box,color=blue];
		j3207263568 -> j2430290788;
	j2430290788 [label="PapaPolar: 还是说，在知道了我们小女孩还活着，她就在某个地方后，其实生出了一丝平静。",shape=box,color=blue];
		j2430290788 -> j2802706867;
	j2802706867 [label="PapaPolar: 哪怕是她经历了这么多之后，还在顽强的战斗，活得精彩？",shape=box,color=blue];
		j2802706867 -> j1421079587;
	j1421079587 [label="PapaPolar: 甚至哪怕不在我们的身边？",shape=box,color=blue];
		j1421079587 -> j2233062147;
	j2233062147 [label="PapaPolar: 光是想到这些，足以让我这颗迟钝的心，心头一热了。不知道你是不是也这么觉得。",shape=box,color=blue];
		j2233062147 -> j76101119;
	j76101119 [label="PapaPolar: 而且我总觉得，那个所谓的虚空无情之物，不会干这种事。",shape=box,color=blue];
		j76101119 -> j288077454;
	j288077454 [label="MomToxicated: 你说得对。听到那句暗语，哪怕只是心里想想她*也许*还活着，并不会痛苦。",shape=box,color=blue];
		j288077454 -> j2555882307;
	j2555882307 [label="MomToxicated: 我很为她自豪。",shape=box,color=blue];
		j2555882307 -> j1348463201;
		j2555882307 -> j267453886;
		j2555882307 -> j2845541991;
	j1348463201 [label="哪怕是她现在还被虚空无情之物挟持着？",shape=box,color=red];
		j1348463201 -> j922345138;
	j267453886 [label="哪怕这是虚空无情之物的诡计？",shape=box,color=red];
		j267453886 -> j4060139619;
	j2845541991 [label="也有可能，她是自愿和虚空无情之物合作的。",shape=box,color=red];
		j2845541991 -> j2235242375;
	j922345138 [label="PapaPolar: 她可是像嵌在钛合金板上的钢钉一样坚韧。",shape=box,color=blue];
		j922345138 -> j2241147393;
	j4060139619 [label="MomToxicated: 它为什么这么做？图什么？它能从我们身上得到什么好处？",shape=box,color=blue];
		j4060139619 -> j1869221412;
	j2235242375 [label="MomToxicated: 那么她就有了整个宇宙，甚至整个存在里最强大的盟友之一。她选好了自己的立场，我们也是。",shape=box,color=blue];
		j2235242375 -> j2635903393;
	j2241147393 [label="PapaPolar: 我敢打赌，你们那个“墙中人”早就看出来了，所以才会带走她。",shape=box,color=blue];
		j2241147393 -> j3794850388;
	j1869221412 [label="PapaPolar: 我们对它来说只是个小虾米。当然，我是往好处想的",shape=box,color=blue];
		j1869221412 -> j2052674429;
	j2635903393 [label="MomToxicated: 希望永远不会有一天我们要把枪口对准彼此。但如果真有那么一天？那就面对它。",shape=box,color=blue];
		j2635903393 -> j59690121;
	j3794850388 [label="PapaPolar: 放心吧，她不会有事的。她要不就是早就不在了，要么就是他们谈好了条件，或者其实是她绑走了那个东西。哈哈哈",shape=box,color=blue];
		j3794850388 -> j2052674429;
	j2052674429 [label="MomToxicated: 所以，我觉得那条信息是真的。就是我们的小女孩发来的。她在告诉我们……她还活着。",shape=box,color=blue];
		j2052674429 -> j1510625429;
	j59690121 [label="PapaPolar: 她能照顾好自己。我们就是这样教导她的。",shape=box,color=blue];
		j59690121 -> j2052674429;
	j1510625429 [label="MomToxicated: 用她自己的方式告诉我们，她“还好”。",shape=box,color=blue];
		j1510625429 -> j1587363484;
	j1587363484 [label="MomToxicated: 让我们放心。",shape=box,color=blue];
		j1587363484 -> j2920926965;
	j2920926965 [label="PapaPolar: 呵，说的好像我们能做到似的。",shape=box,color=blue];
		j2920926965 -> j4021444597;
	j4021444597 [label="MomToxicated: 为人父母，又甜又苦。",shape=box,color=blue];
		j4021444597 -> j3375089360;
	j3375089360 [label="PapaPolar: 漂泊者，你有想过要孩子吗？呃，算了还是别回答了。估计你又要说什么虚空乱七八糟的东西，我可不想知道。",shape=box,color=blue];
		j3375089360 -> j3637154291;
		j3375089360 -> j2634192644;
		j3375089360 -> j2293901816;
	j3637154291 [label="喝一杯去？喝一杯。",shape=box,color=red];
		j3637154291 -> j417199925;
	j2634192644 [label="好主意",shape=box,color=red];
		j2634192644 -> j2197112357;
	j2293901816 [label="<RETRO_EMOJI_OHNO>",shape=box,color=red];
		j2293901816 -> j1859271673;
	j417199925 [label="+5 Chemistry",color=orange];
		j417199925 -> j1369111666;
	j2197112357 [label="PapaPolar: 不过，这种感觉也不是单纯的开心，算是参杂着忧伤的欣慰吧？",shape=box,color=blue];
		j2197112357 -> j3916316091;
	j1859271673 [label="MomToxicated: 这是个很合理的回答，我赞成，呵。要不要去喝几杯？",shape=box,color=blue];
		j1859271673 -> j3443468225;
	j1369111666 [label="MomToxicated: 这下你说到我们心坎上了。",shape=box,color=blue];
		j1369111666 -> j3916316091;
	j3916316091 [label="PapaPolar: 我想去好好喝几杯，给你讲讲我们小女孩的故事。",shape=box,color=blue];
		j3916316091 -> j2044040959;
	j3443468225 [label="PapaPolar: 这才对嘛",shape=box,color=blue];
		j3443468225 -> j3916316091;
	j2044040959 [label="MomToxicated: 还有……漂泊者？真的谢谢你。感谢你做的一切。",shape=box,color=blue];
		j2044040959 -> j127772316;
	j127772316 [label="PapaPolar: 没错，小伙计，说真的，我都不知道该怎么报答你。但将来有机会的话，我们一定在。",shape=box,color=blue];
		j127772316 -> j3347995488;
	j3347995488 [label="PapaPolar: 从今以后，不管你愿不愿意，我们就是一家人了。8-)",shape=box,color=blue];
		j3347995488 -> "Chat ends.";
}