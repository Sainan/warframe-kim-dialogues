	1965 [label="Chat ends.",color=orange];
	1879 [label="MomToxicated: 什么事？",shape=box,color=blue];
		1879 -> 1880;
	1880 [label="PapaPolar: 怎么了，小伙计？",shape=box,color=blue];
		1880 -> 1881;
		1880 -> 1882;
		1880 -> 1883;
	1881 [label="我有一个好消息和一个坏消息。都是关于内奇的。",shape=box,color=red];
		1881 -> 1886;
	1882 [label="你们先别太激动。我有内奇的消息了，不过……情况有些复杂。目前还没有定论。",shape=box,color=red];
		1882 -> 1885;
	1883 [label="唉……算了，没事。[结束]",shape=box,color=red];
		1883 -> 1884;
	1886 [label="PapaPolar: 都是成年人了。先说坏消息。",shape=box,color=blue];
		1886 -> 1888;
	1885 [label="+5 Chemistry",color=orange];
		1885 -> 1887;
	1884 [label="Chat ends.",color=orange];
	1888 [label="MomToxicated: 同意。总是要先听坏消息的。",shape=box,color=blue];
		1888 -> 1892;
	1887 [label="MomToxicated: 生活本就如此。但还是谢谢你的提醒。",shape=box,color=blue];
		1887 -> 1889;
	1892 [label="那个，虚空无情之物进到双衍王境里了，然后……它还把内奇带到那里了。",shape=box,color=red];
		1892 -> 1893;
	1889 [label="+5 Chemistry",color=orange];
		1889 -> 1890;
	1893 [label="PapaPolar: 等等，等等。你是说进到那个故事书里了？",shape=box,color=blue];
		1893 -> 1894;
	1890 [label="PapaPolar: 我做好心理准备了，不过听你这么说……她起码还活着，对吧？",shape=box,color=blue];
		1890 -> 1891;
	1894 [label="MomToxicated: 是那个有个小孩独裁者，一遍遍杀死你的地方？",shape=box,color=blue];
		1894 -> 1895;
		1894 -> 1896;
	1891 [label="我……不确定。我觉得她可能不在了。我还是先把我知道的都告诉你们吧，剩下的你们自己判断。",shape=box,color=red];
		1891 -> 1892;
	1895 [label="结果这反而对他来说算是个成长的契机？但这不是重点。总之——",shape=box,color=red];
		1895 -> 1897;
	1896 [label="就是那里。",shape=box,color=red];
		1896 -> 1897;
	1897 [label="内奇……坐上了王位。低语者——也就是虚空无情之物所谓的“军队”，抱歉我想不到更好的词来形容了。它们发起了入侵，然后她趁机掌控了局面。",shape=box,color=red];
		1897 -> 1898;
	1898 [label="MomToxicated: 呵，不愧是我的小女孩。",shape=box,color=blue];
		1898 -> 1899;
	1899 [label="PapaPolar: 可那还是*她*吗？还是说是那个东西顶着她的脸？",shape=box,color=blue];
		1899 -> 1900;
		1899 -> 1901;
	1900 [label="我不知道。",shape=box,color=red];
		1900 -> 1902;
	1901 [label="我就是想跟你们聊聊这个事。",shape=box,color=red];
		1901 -> 1902;
	1902 [label="我发现了这些记录。虽然一开始乱七八糟的，但我把它们拼起来以后，我……发现了一条信息。",shape=box,color=red];
		1902 -> 1903;
	1903 [label="我想知道，你们能看懂吗。",shape=box,color=red];
		1903 -> 1904;
	1904 [label="MomToxicated: 破解谜语和奇怪的信息？我们很在行。",shape=box,color=blue];
		1904 -> 1905;
	1905 [label="PapaPolar: 1-800-间谍-热线，你算是找对人了。",shape=box,color=blue];
		1905 -> 1906;
	1906 [label="那条信息是这样的：“当日月汇聚，迷途者终将寻得归途。”",shape=box,color=red];
		1906 -> 1907;
	1907 [label="PapaPolar: ……该死。米，糟了。",shape=box,color=blue];
		1907 -> 1908;
	1908 [label="MomToxicated: 别上当。如果那东西已经入侵了她的意识，它会知道她所知道的一切。",shape=box,color=blue];
		1908 -> 1909;
		1908 -> 1910;
	1909 [label="什么？那条信息是什么意思？",shape=box,color=red];
		1909 -> 1911;
	1910 [label="这句话是另一半，对吧？",shape=box,color=red];
		1910 -> 1912;
	1911 [label="PapaPolar: “于静寂歧路，追寻日蚀。”",shape=box,color=blue];
		1911 -> 1914;
	1912 [label="+5 Chemistry",color=orange];
		1912 -> 1915;
	1914 [label="PapaPolar: 我之前跟你说过，要是再遇到了我们的小女孩，就告诉她那句话。",shape=box,color=blue];
		1914 -> 1913;
	1915 [label="PapaPolar: 没错……",shape=box,color=blue];
		1915 -> 1916;
	1913 [label="PapaPolar: 这句话是我们俩这边的暗语。每次打电话前都会对这个暗语，来确认线路安全，万无一失。",shape=box,color=blue];
		1913 -> 1917;
	1916 [label="PapaPolar: 我们设了个暗语。每次打电话前都会对这个暗语，来确认线路安全，万无一失。",shape=box,color=blue];
		1916 -> 1917;
	1917 [label="MomToxicated: 确认彼此……依然是真正的自己。",shape=box,color=blue];
		1917 -> 1918;
	1918 [label="PapaPolar: “于静寂歧路，追寻日蚀”是我们俩的部分。",shape=box,color=blue];
		1918 -> 1919;
	1919 [label="MomToxicated: 暗语的下半部分，就是“当日月汇聚，迷途者终将寻得归途。”",shape=box,color=blue];
		1919 -> 1920;
	1920 [label="MomToxicated: 是*她*要对上的部分。",shape=box,color=blue];
		1920 -> 1921;
		1920 -> 1922;
	1921 [label="米尼娃，就像你说的，我们没法确定那还是她。虚空无情之物清楚她知道的一切。",shape=box,color=red];
		1921 -> 1923;
	1922 [label="我不知道虚空无情之物为什么要告诉你们这个……",shape=box,color=red];
		1922 -> 1924;
	1923 [label="MomToxicated: 可是它为什么要给我们一丝希望呢？除非它是想折磨我们。",shape=box,color=blue];
		1923 -> 1925;
	1924 [label="MomToxicated: 也许是想给我们一点虚假的希望？然后借此来加深我们的痛苦？",shape=box,color=blue];
		1924 -> 1926;
	1925 [label="PapaPolar: 这很痛苦吗？",shape=box,color=blue];
		1925 -> 1927;
	1926 [label="PapaPolar: 这是假的吗？这很痛苦吗？",shape=box,color=blue];
		1926 -> 1927;
	1927 [label="PapaPolar: 还是说，在知道了我们小女孩还活着，她就在某个地方后，其实生出了一丝平静。",shape=box,color=blue];
		1927 -> 1928;
	1928 [label="PapaPolar: 哪怕是她经历了这么多之后，还在顽强的战斗，活得精彩？",shape=box,color=blue];
		1928 -> 1929;
	1929 [label="PapaPolar: 甚至哪怕不在我们的身边？",shape=box,color=blue];
		1929 -> 1930;
	1930 [label="PapaPolar: 光是想到这些，足以让我这颗迟钝的心，心头一热了。不知道你是不是也这么觉得。",shape=box,color=blue];
		1930 -> 1931;
	1931 [label="PapaPolar: 而且我总觉得，那个所谓的虚空无情之物，不会干这种事。",shape=box,color=blue];
		1931 -> 1932;
	1932 [label="MomToxicated: 你说得对。听到那句暗语，哪怕只是心里想想她*也许*还活着，并不会痛苦。",shape=box,color=blue];
		1932 -> 1933;
	1933 [label="MomToxicated: 我很为她自豪。",shape=box,color=blue];
		1933 -> 1934;
		1933 -> 1935;
		1933 -> 1936;
	1934 [label="哪怕是她现在还被虚空无情之物挟持着？",shape=box,color=red];
		1934 -> 1937;
	1935 [label="哪怕这是虚空无情之物的诡计？",shape=box,color=red];
		1935 -> 1938;
	1936 [label="也有可能，她是自愿和虚空无情之物合作的。",shape=box,color=red];
		1936 -> 1939;
	1937 [label="PapaPolar: 她可是像嵌在钛合金板上的钢钉一样坚韧。",shape=box,color=blue];
		1937 -> 1940;
	1938 [label="MomToxicated: 它为什么这么做？图什么？它能从我们身上得到什么好处？",shape=box,color=blue];
		1938 -> 1942;
	1939 [label="MomToxicated: 那么她就有了整个宇宙，甚至整个存在里最强大的盟友之一。她选好了自己的立场，我们也是。",shape=box,color=blue];
		1939 -> 1943;
	1940 [label="PapaPolar: 我敢打赌，你们那个“墙中人”早就看出来了，所以才会带走她。",shape=box,color=blue];
		1940 -> 1941;
	1942 [label="PapaPolar: 我们对它来说只是个小虾米。当然，我是往好处想的",shape=box,color=blue];
		1942 -> 1945;
	1943 [label="MomToxicated: 希望永远不会有一天我们要把枪口对准彼此。但如果真有那么一天？那就面对它。",shape=box,color=blue];
		1943 -> 1944;
	1941 [label="PapaPolar: 放心吧，她不会有事的。她要不就是早就不在了，要么就是他们谈好了条件，或者其实是她绑走了那个东西。哈哈哈",shape=box,color=blue];
		1941 -> 1945;
	1945 [label="MomToxicated: 所以，我觉得那条信息是真的。就是我们的小女孩发来的。她在告诉我们……她还活着。",shape=box,color=blue];
		1945 -> 1946;
	1944 [label="PapaPolar: 她能照顾好自己。我们就是这样教导她的。",shape=box,color=blue];
		1944 -> 1945;
	1946 [label="MomToxicated: 用她自己的方式告诉我们，她“还好”。",shape=box,color=blue];
		1946 -> 1947;
	1947 [label="MomToxicated: 让我们放心。",shape=box,color=blue];
		1947 -> 1948;
	1948 [label="PapaPolar: 呵，说的好像我们能做到似的。",shape=box,color=blue];
		1948 -> 1949;
	1949 [label="MomToxicated: 为人父母，又甜又苦。",shape=box,color=blue];
		1949 -> 1950;
	1950 [label="PapaPolar: 漂泊者，你有想过要孩子吗？呃，算了还是别回答了。估计你又要说什么虚空乱七八糟的东西，我可不想知道。",shape=box,color=blue];
		1950 -> 1951;
		1950 -> 1952;
		1950 -> 1953;
	1951 [label="喝一杯去？喝一杯。",shape=box,color=red];
		1951 -> 1955;
	1952 [label="好主意",shape=box,color=red];
		1952 -> 1956;
	1953 [label="<RETRO_EMOJI_OHNO>",shape=box,color=red];
		1953 -> 1957;
	1955 [label="+5 Chemistry",color=orange];
		1955 -> 1954;
	1956 [label="PapaPolar: 不过，这种感觉也不是单纯的开心，算是参杂着忧伤的欣慰吧？",shape=box,color=blue];
		1956 -> 1959;
	1957 [label="MomToxicated: 这是个很合理的回答，我赞成，呵。要不要去喝几杯？",shape=box,color=blue];
		1957 -> 1958;
	1954 [label="MomToxicated: 这下你说到我们心坎上了。",shape=box,color=blue];
		1954 -> 1959;
	1959 [label="PapaPolar: 我想去好好喝几杯，给你讲讲我们小女孩的故事",shape=box,color=blue];
		1959 -> 1960;
	1958 [label="PapaPolar: 这才对嘛",shape=box,color=blue];
		1958 -> 1959;
	1960 [label="MomToxicated: 还有……漂泊者？真的谢谢你。感谢你做的一切。",shape=box,color=blue];
		1960 -> 1961;
	1961 [label="PapaPolar: 没错，小伙计，说真的，我都不知道该怎么报答你。但将来有机会的话，我们一定在。",shape=box,color=blue];
		1961 -> 1962;
	1962 [label="PapaPolar: 从今以后，不管你愿不愿意，我们就是一家人了。8-)",shape=box,color=blue];
		1962 -> 1963;
	1963 [label="Chat ends.",color=orange];
}