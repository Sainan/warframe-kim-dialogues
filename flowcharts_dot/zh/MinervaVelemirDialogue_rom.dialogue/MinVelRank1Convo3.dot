digraph {
	179 [label="MinVelRank1Convo3 begins.",color=orange];
		179 -> 180;
	180 [label="MomToxicated: 漂泊者。我们可以谈谈吗？",shape=box,color=blue];
		180 -> 181;
		180 -> 182;
		180 -> 183;
		180 -> 184;
	181 [label="早上好，米尼娃。如果这是你的真名的话。",shape=box,color=red];
		181 -> 185;
	182 [label="看来我们不再用“引号”了。",shape=box,color=red];
		182 -> 186;
	183 [label="你终于会先问一下了？",shape=box,color=red];
		183 -> 186;
	184 [label="什么事？",shape=box,color=red];
		184 -> 187;
	185 [label="+5 Chemistry",color=orange];
		185 -> 188;
	186 [label="MomToxicated: 有人刚刚训了我，说我所谓的待人接物有问题。",shape=box,color=blue];
		186 -> 189;
	187 [label="+5 Chemistry",color=orange];
		187 -> 190;
	188 [label="MomToxicated: 信不信由你，这是我的真名。",shape=box,color=blue];
		188 -> 191;
	189 [label="MomToxicated: 结合实际情况来看，真是笑死人。",shape=box,color=blue];
		189 -> 192;
	190 [label="MomToxicated: 直奔主题。很好。",shape=box,color=blue];
		190 -> 192;
	191 [label="MomToxicated: 但那不是重点。",shape=box,color=blue];
		191 -> 192;
	192 [label="MomToxicated: 我们来到霍瓦尼亚是为了解决一个问题。而你能帮我解决这个问题。",shape=box,color=blue];
		192 -> 193;
	193 [label="MomToxicated: 所以我需要你——这也是我在请求你——来帮助我。",shape=box,color=blue];
		193 -> 194;
		193 -> 195;
		193 -> 196;
	194 [label="我应该解决的是什么问题？",shape=box,color=red];
		194 -> 197;
	195 [label="我为什么要帮你？",shape=box,color=red];
		195 -> 197;
	196 [label="这和鲁莎卡有什么关系？",shape=box,color=red];
		196 -> 197;
	197 [label="MomToxicated: 这是个非常好的问题。",shape=box,color=blue];
		197 -> 198;
	198 [label="MomToxicated: 你不需要为了我而帮助我。我们有一个共同的敌人。就是这个“墙中人”。",shape=box,color=blue];
		198 -> 199;
	199 [label="MomToxicated: 据我所知，我们都想知道他的去向、他的目的，以及为什么他一开始就盯上了鲁莎卡。",shape=box,color=blue];
		199 -> 200;
	200 [label="MomToxicated: 我的评估还算正确吗？",shape=box,color=blue];
		200 -> 201;
		200 -> 202;
		200 -> 203;
	201 [label="你能不能倒回去一下，花点时间解释一下为什么你这么在乎鲁莎卡？",shape=box,color=red];
		201 -> 204;
	202 [label="对于前两点来说，你评估的很正确。我其实根本不在乎他为什么要对鲁莎卡下手。",shape=box,color=red];
		202 -> 205;
	203 [label="当然。很正确。你分析得对。",shape=box,color=red];
		203 -> 206;
	204 [label="MomToxicated: 原因并不重要。",shape=box,color=blue];
		204 -> 207;
	205 [label="MomToxicated: 如果你对她的安危一点都不关心，为什么还像我们所知的那样放过她一命？我们都听说过那件事。",shape=box,color=blue];
		205 -> 208;
		205 -> 209;
		205 -> 210;
	206 [label="不过我得告诉你，我们可能需要等到墙中人下一次出手。",shape=box,color=red];
		206 -> 211;
	207 [label="PapaPolar: 其实挺重要的。而且他可能早就猜到了。反正我们也没怎么掩饰",shape=box,color=blue];
		207 -> 212;
	208 [label="因为那样的话，我就和虚空无情之物、炽蛇军、英择谛没什么两样了。我不是无缘无故杀人的人。",shape=box,color=red];
		208 -> 213;
	209 [label="因为真正让她陷入那种境地的决定并不是她自己做的。就因为我当时不会因此杀了她，并不意味着我足够*在乎*去不惜一切代价救她。",shape=box,color=red];
		209 -> 214;
	210 [label="因为我没打算替英择谛干他的脏活。如果他想除掉虚空无情之物的新傀儡，他可以自己动手。",shape=box,color=red];
		210 -> 215;
	211 [label="MomToxicated: 为什么会这样呢？你没办法追踪他吗？它？不管它是什么？还是说你不知道它的真正目的是什么吗？",shape=box,color=blue];
		211 -> 216;
		211 -> 217;
	212 [label="PapaPolar: 也许，*只是也许*如果你信任我们的新朋友，给他一些信息，他可能更愿意*帮助我们*",shape=box,color=blue];
		212 -> 218;
	213 [label="这说明我是有目的地杀人。但我并非如此。我的意思是。我确实杀了人。但情况不一样。你懂我的意思。",shape=box,color=red];
		213 -> 219;
	214 [label="我又不*认识*她。",shape=box,color=red];
		214 -> 220;
	215 [label="但正如我所预料的，那个老混账只喜欢射杀那些他知道能够重新站起来的人。",shape=box,color=red];
		215 -> 221;
	216 [label="是的，我们无法就这样给一个半神这样的存在放个追踪器。",shape=box,color=red];
		216 -> 222;
	217 [label="是的，他的动机，现在我们也有点摸不清楚。但肯定没什么好事。",shape=box,color=red];
		217 -> 222;
	218 [label="PapaPolar: 有时候人们差不多就是这样行事的。 ",shape=box,color=blue];
		218 -> 223;
	219 [label="+5 Chemistry",color=orange];
		219 -> 224;
	220 [label="PapaPolar: 我们其实也没给你什么理由去在乎，对吧，米？",shape=box,color=blue];
		220 -> 225;
	221 [label="PapaPolar: 这话说得挺怪的，但行吧",shape=box,color=blue];
		221 -> 226;
		221 -> 227;
	222 [label="MomToxicated: 所以你是建议我们就这样坐着等。等它……干嘛？冒出头来？然后我们玩一轮打地鼠游戏吗？！",shape=box,color=blue];
		222 -> 228;
	223 [label="MomToxicated: 这样做有什么好处呢？",shape=box,color=blue];
		223 -> 229;
	224 [label="PapaPolar: 你现在是跟两个前军事特工说话，我们懂。哈哈",shape=box,color=blue];
		224 -> 230;
	225 [label="MomToxicated: 闭嘴，维利米尔。",shape=box,color=blue];
		225 -> 204;
	226 [label="没关系，我死过很多次，已经习惯了。",shape=box,color=red];
		226 -> 231;
	227 [label="这并不重要。",shape=box,color=red];
		227 -> 206;
		227 -> 232;
	228 [label="PapaPolar: 至少这个地方有好伙伴和不错的酒吧？",shape=box,color=blue];
		228 -> 233;
	229 [label="PapaPolar: 米，在这个世界上多个朋友总没坏处。",shape=box,color=blue];
		229 -> 234;
	230 [label="PapaPolar: 我们为了所谓的“大义”而不得不去做的事情有时候会变得有些模糊",shape=box,color=blue];
		230 -> 235;
	231 [label="PapaPolar: 哦，好吧……当然，小伙计……当然……",shape=box,color=blue];
		231 -> 236;
	232 [label="你为什么这么迫切想知道鲁莎卡发生了什么事？",shape=box,color=red];
		232 -> 204;
	233 [label="PapaPolar: 音乐也不错。那个亚瑟看起来很适合做我的酒友",shape=box,color=blue];
		233 -> 237;
	234 [label="MomToxicated: 我们为什么需要“朋友”呢？！反正我们一旦弄清楚去哪里可以救内奇，就会立刻离开这。",shape=box,color=blue];
		234 -> 238;
	235 [label="PapaPolar: 这就是为什么，当我们能做一些有意义的事情时，我们就会去做。也是为什么我们现在来到这里，试图救内奇",shape=box,color=blue];
		235 -> 206;
		235 -> 232;
	236 [label="PapaPolar: 总之……",shape=box,color=blue];
		236 -> 206;
		236 -> 232;
	237 [label="MomToxicated: 然后呢，我们就这样继续过不知道她究竟发生了什么的日子？！不知道她是否安好？！她还是原来的她吗？！",shape=box,color=blue];
		237 -> 239;
	238 [label="PapaPolar: 那可不一定。看起来预测一个半神虚空怪物……东西的动向会很难……对吧，小伙计？",shape=box,color=blue];
		238 -> 217;
		238 -> 216;
	239 [label="MomToxicated: 维利米尔，你怎么能一副若无其事的样子坐在那里？！",shape=box,color=blue];
		239 -> 240;
	240 [label="PapaPolar: 米，我从来没有说我对这事无所谓！我只是明白有时我们需要坐下来等待机会！",shape=box,color=blue];
		240 -> 241;
	241 [label="MomToxicated: 我和埃莉诺谈过了。她告诉我当她接触到内奇的思维时感觉到了什么。或者说，她心灵剩下的部分。",shape=box,color=blue];
		241 -> 242;
	242 [label="MomToxicated: 那个我们共同抚养的女人。我们视如己出的女人。",shape=box,color=blue];
		242 -> 243;
	243 [label="MomToxicated: 谁知道会发生什么——",shape=box,color=blue];
		243 -> 244;
	244 [label="MomToxicated: 而你却还想谈谈和亚瑟喝酒的事。",shape=box,color=blue];
		244 -> 245;
	245 [label="MomToxicated: Du-te dracu，维利米尔。",shape=box,color=blue];
		245 -> 246;
	246 [label="PapaPolar: 她又下了……",shape=box,color=blue];
		246 -> 247;
		246 -> 248;
	247 [label="她说的是什么……？",shape=box,color=red];
		247 -> 249;
	248 [label="我猜她说的那些是粗话。",shape=box,color=red];
		248 -> 250;
	249 [label="PapaPolar: 这就是在海外执行众多任务的一大乐趣。被 100 种语言骂过",shape=box,color=blue];
		249 -> 251;
		249 -> 252;
	250 [label="PapaPolar: 是的。这就是在海外执行众多任务的一大乐趣。被 100 种语言骂过",shape=box,color=blue];
		250 -> 251;
		250 -> 252;
	251 [label="你们俩……是夫妻吗？",shape=box,color=red];
		251 -> 253;
	252 [label="你们两个……抚养了鲁莎卡？",shape=box,color=red];
		252 -> 254;
	253 [label="Update boolean MinervaVelimir1",color=orange];
		253 -> 255;
	254 [label="Update boolean MinervaNeci3a",color=orange];
		254 -> 256;
	255 [label="PapaPolar: 嗯。可以这么说。不过现在不算了。只是纸面上的关系。在某个大约在 1982 年就不复存在的国家？",shape=box,color=blue];
		255 -> 257;
	256 [label="PapaPolar: 差不多吧。我们在从这往南距离有几个国家的小镇上待过。那里被炸得粉碎。我们在一栋楼里找到了她，一头红发，气呼呼的。",shape=box,color=blue];
		256 -> 258;
	257 [label="PapaPolar: 这样还算吗？",shape=box,color=blue];
		257 -> 259;
		257 -> 260;
	258 [label="PapaPolar: 她试图用勺子刺了我六次，哈哈哈，真是你见过的最可爱的小东西。",shape=box,color=blue];
		258 -> 261;
	259 [label="是的，看起来你们已经不在一起了。",shape=box,color=red];
		259 -> 262;
	260 [label="这样就解释了你们争吵的原因。",shape=box,color=red];
		260 -> 263;
	261 [label="PapaPolar: 然后，她还紧抱着一个小兔子毛绒玩具。米告诉她，她会用生命来保护它，保证它的安全。",shape=box,color=blue];
		261 -> 264;
	262 [label="PapaPolar: 是哪里让你看出来的。",shape=box,color=blue];
		262 -> 263;
	263 [label="PapaPolar: 当内奇离开去加入炽蛇军后……我们之间的关系就再也不像以前一样了。我想，那是压死骆驼的最后一根稻草吧。",shape=box,color=blue];
		263 -> 265;
	264 [label="PapaPolar: 这很快就赢得了内奇的信任。她直接跑向米，抱住了她。之后我们就退伍了。好吧。正式地。变成了“顾问”。",shape=box,color=blue];
		264 -> 266;
	265 [label="PapaPolar: 唉。",shape=box,color=blue];
		265 -> 267;
	266 [label="PapaPolar: 所以……是的，你可以说我们抚养了她。",shape=box,color=blue];
		266 -> 267;
	267 [label="PapaPolar: 好了，我得去做我最擅长的事情了。",shape=box,color=blue];
		267 -> 268;
	268 [label="PapaPolar: 假装我知道我说错了什么，再假装我以后不会再犯同样的错误。",shape=box,color=blue];
