	"MinVelRank1Convo3 begins." [color=orange];
		"MinVelRank1Convo3 begins." -> j4212765733;
	j4212765733 [label="MomToxicated: 漂泊者。我们可以谈谈吗？",shape=box,color=blue];
		j4212765733 -> j1083936037;
		j4212765733 -> j235181194;
		j4212765733 -> j3997523371;
		j4212765733 -> j1293975211;
	j1083936037 [label="早上好，米尼娃。如果这是你的真名的话。",shape=box,color=red];
		j1083936037 -> j4248259036;
	j235181194 [label="看来我们不再用“引号”了。",shape=box,color=red];
		j235181194 -> j894132264;
	j3997523371 [label="你终于会先问一下了？",shape=box,color=red];
		j3997523371 -> j894132264;
	j1293975211 [label="什么事？",shape=box,color=red];
		j1293975211 -> j1347406769;
	j4248259036 [label="+5 Chemistry",color=orange];
		j4248259036 -> j3914445046;
	j894132264 [label="MomToxicated: 有人刚刚训了我，说我所谓的待人接物有问题。",shape=box,color=blue];
		j894132264 -> j2007085362;
	j1347406769 [label="+5 Chemistry",color=orange];
		j1347406769 -> j2464882140;
	j3914445046 [label="MomToxicated: 信不信由你，这是我的真名。",shape=box,color=blue];
		j3914445046 -> j1330967068;
	j2007085362 [label="MomToxicated: 结合实际情况来看，真是笑死人。",shape=box,color=blue];
		j2007085362 -> j3880827767;
	j2464882140 [label="MomToxicated: 直奔主题。很好。",shape=box,color=blue];
		j2464882140 -> j3880827767;
	j1330967068 [label="MomToxicated: 但那不是重点。",shape=box,color=blue];
		j1330967068 -> j3880827767;
	j3880827767 [label="MomToxicated: 我们来到霍瓦尼亚是为了解决一个问题。而你能帮我解决这个问题。",shape=box,color=blue];
		j3880827767 -> j2767632947;
	j2767632947 [label="MomToxicated: 所以我需要你——这也是我在请求你——来帮助我。",shape=box,color=blue];
		j2767632947 -> j1434240437;
		j2767632947 -> j3193828963;
		j2767632947 -> j1479303391;
	j1434240437 [label="我应该解决的是什么问题？",shape=box,color=red];
		j1434240437 -> j1785570083;
	j3193828963 [label="我为什么要帮你？",shape=box,color=red];
		j3193828963 -> j1785570083;
	j1479303391 [label="这和鲁莎卡有什么关系？",shape=box,color=red];
		j1479303391 -> j1785570083;
	j1785570083 [label="MomToxicated: 这是个非常好的问题。",shape=box,color=blue];
		j1785570083 -> j2659637945;
	j2659637945 [label="MomToxicated: 你不需要为了我而帮助我。我们有一个共同的敌人。就是这个“墙中人”。",shape=box,color=blue];
		j2659637945 -> j4274213823;
	j4274213823 [label="MomToxicated: 据我所知，我们都想知道他的去向、他的目的，以及为什么他一开始就盯上了鲁莎卡。",shape=box,color=blue];
		j4274213823 -> j2985778078;
	j2985778078 [label="MomToxicated: 我的评估还算正确吗？",shape=box,color=blue];
		j2985778078 -> j3450746822;
		j2985778078 -> j164026767;
		j2985778078 -> j1704775976;
	j3450746822 [label="你能不能倒回去一下，花点时间解释一下为什么你这么在乎鲁莎卡？",shape=box,color=red];
		j3450746822 -> j3142084613;
	j164026767 [label="对于前两点来说，你评估的很正确。我其实根本不在乎他为什么要对鲁莎卡下手。",shape=box,color=red];
		j164026767 -> j2315571337;
	j1704775976 [label="当然。很正确。你分析得对。",shape=box,color=red];
		j1704775976 -> j821309242;
	j3142084613 [label="MomToxicated: 原因并不重要。",shape=box,color=blue];
		j3142084613 -> j628095620;
	j2315571337 [label="MomToxicated: 如果你对她的安危一点都不关心，为什么还像我们所知的那样放过她一命？我们都听说过那件事。",shape=box,color=blue];
		j2315571337 -> j2894012738;
		j2315571337 -> j356724718;
		j2315571337 -> j3353327233;
	j821309242 [label="不过我得告诉你，我们可能需要等到墙中人下一次出手。",shape=box,color=red];
		j821309242 -> j61176194;
	j628095620 [label="PapaPolar: 其实挺重要的。而且他可能早就猜到了。反正我们也没怎么掩饰",shape=box,color=blue];
		j628095620 -> j1379630866;
	j2894012738 [label="因为那样的话，我就和虚空无情之物、炽蛇军、英择谛没什么两样了。我不是无缘无故杀人的人。",shape=box,color=red];
		j2894012738 -> j2858712524;
	j356724718 [label="因为真正让她陷入那种境地的决定并不是她自己做的。就因为我当时不会因此杀了她，并不意味着我足够*在乎*去不惜一切代价救她。",shape=box,color=red];
		j356724718 -> j1443677592;
	j3353327233 [label="因为我没打算替英择谛干他的脏活。如果他想除掉虚空无情之物的新傀儡，他可以自己动手。",shape=box,color=red];
		j3353327233 -> j3705090664;
	j61176194 [label="MomToxicated: 为什么会这样呢？你没办法追踪他吗？它？不管它是什么？还是说你不知道它的真正目的是什么吗？",shape=box,color=blue];
		j61176194 -> j3745130729;
		j61176194 -> j2552730704;
	j1379630866 [label="PapaPolar: 也许，*只是也许*如果你信任我们的新朋友，给他一些信息，他可能更愿意*帮助我们*",shape=box,color=blue];
		j1379630866 -> j1905309291;
	j2858712524 [label="这说明我是有目的地杀人。但我并非如此。我的意思是。我确实杀了人。但情况不一样。你懂我的意思。",shape=box,color=red];
		j2858712524 -> j1077511834;
	j1443677592 [label="我又不*认识*她。",shape=box,color=red];
		j1443677592 -> j2444072712;
	j3705090664 [label="但正如我所预料的，那个老混账只喜欢射杀那些他知道能够重新站起来的人。",shape=box,color=red];
		j3705090664 -> j437309261;
	j3745130729 [label="是的，我们无法就这样给一个半神这样的存在放个追踪器。",shape=box,color=red];
		j3745130729 -> j3755676355;
	j2552730704 [label="是的，他的动机，现在我们也有点摸不清楚。但肯定没什么好事。",shape=box,color=red];
		j2552730704 -> j3755676355;
	j1905309291 [label="PapaPolar: 有时候人们差不多就是这样行事的。 ",shape=box,color=blue];
		j1905309291 -> j1036469457;
	j1077511834 [label="+5 Chemistry",color=orange];
		j1077511834 -> j3800917555;
	j2444072712 [label="PapaPolar: 我们其实也没给你什么理由去在乎，对吧，米？",shape=box,color=blue];
		j2444072712 -> j477243080;
	j437309261 [label="PapaPolar: 这话说得挺怪的，但行吧",shape=box,color=blue];
		j437309261 -> j1109916616;
		j437309261 -> j4149418171;
	j3755676355 [label="MomToxicated: 所以你是建议我们就这样坐着等。等它……干嘛？冒出头来？然后我们玩一轮打地鼠游戏吗？！",shape=box,color=blue];
		j3755676355 -> j1312366734;
	j1036469457 [label="MomToxicated: 这样做有什么好处呢？",shape=box,color=blue];
		j1036469457 -> j3162748836;
	j3800917555 [label="PapaPolar: 你现在是跟两个前军事特工说话，我们懂。哈哈",shape=box,color=blue];
		j3800917555 -> j1013434663;
	j477243080 [label="MomToxicated: 闭嘴，维利米尔。",shape=box,color=blue];
		j477243080 -> j3142084613;
	j1109916616 [label="没关系，我死过很多次，已经习惯了。",shape=box,color=red];
		j1109916616 -> j3642985131;
	j4149418171 [label="这并不重要。",shape=box,color=red];
		j4149418171 -> j821309242;
		j4149418171 -> j980482614;
	j1312366734 [label="PapaPolar: 至少这个地方有好伙伴和不错的酒吧？",shape=box,color=blue];
		j1312366734 -> j3220580866;
	j3162748836 [label="PapaPolar: 米，在这个世界上多个朋友总没坏处。",shape=box,color=blue];
		j3162748836 -> j3876404543;
	j1013434663 [label="PapaPolar: 我们为了所谓的“大义”而不得不去做的事情有时候会变得有些模糊",shape=box,color=blue];
		j1013434663 -> j3816913185;
	j3642985131 [label="PapaPolar: 哦，好吧……当然，小伙计……当然……",shape=box,color=blue];
		j3642985131 -> j1934645320;
	j980482614 [label="你为什么这么迫切想知道鲁莎卡发生了什么事？",shape=box,color=red];
		j980482614 -> j3142084613;
	j3220580866 [label="PapaPolar: 音乐也不错。那个亚瑟看起来很适合做我的酒友",shape=box,color=blue];
		j3220580866 -> j1185285517;
	j3876404543 [label="MomToxicated: 我们为什么需要“朋友”呢？！反正我们一旦弄清楚去哪里可以救内奇，就会立刻离开这。",shape=box,color=blue];
		j3876404543 -> j4002051249;
	j3816913185 [label="PapaPolar: 这就是为什么，当我们能做一些有意义的事情时，我们就会去做。也是为什么我们现在来到这里，试图救内奇",shape=box,color=blue];
		j3816913185 -> j821309242;
		j3816913185 -> j980482614;
	j1934645320 [label="PapaPolar: 总之……",shape=box,color=blue];
		j1934645320 -> j821309242;
		j1934645320 -> j980482614;
	j1185285517 [label="MomToxicated: 然后呢，我们就这样继续过不知道她究竟发生了什么的日子？！不知道她是否安好？！她还是原来的她吗？！",shape=box,color=blue];
		j1185285517 -> j2154497724;
	j4002051249 [label="PapaPolar: 那可不一定。看起来预测一个半神虚空怪物……东西的动向会很难……对吧，小伙计？",shape=box,color=blue];
		j4002051249 -> j2552730704;
		j4002051249 -> j3745130729;
	j2154497724 [label="MomToxicated: 维利米尔，你怎么能一副若无其事的样子坐在那里？！",shape=box,color=blue];
		j2154497724 -> j3435726043;
	j3435726043 [label="PapaPolar: 米，我从来没有说我对这事无所谓！我只是明白有时我们需要坐下来等待机会！",shape=box,color=blue];
		j3435726043 -> j781768654;
	j781768654 [label="MomToxicated: 我和埃莉诺谈过了。她告诉我当她接触到内奇的思维时感觉到了什么。或者说，她心灵剩下的部分。",shape=box,color=blue];
		j781768654 -> j3476165153;
	j3476165153 [label="MomToxicated: 那个我们共同抚养的女人。我们视如己出的女人。",shape=box,color=blue];
		j3476165153 -> j2680123934;
	j2680123934 [label="MomToxicated: 谁知道会发生什么——",shape=box,color=blue];
		j2680123934 -> j826148863;
	j826148863 [label="MomToxicated: 而你却还想谈谈和亚瑟喝酒的事。",shape=box,color=blue];
		j826148863 -> j2592077004;
	j2592077004 [label="MomToxicated: Du-te dracu，维利米尔。",shape=box,color=blue];
		j2592077004 -> j1643573248;
	j1643573248 [label="PapaPolar: 她又下了……",shape=box,color=blue];
		j1643573248 -> j583925868;
		j1643573248 -> j1933019177;
	j583925868 [label="她说的是什么……？",shape=box,color=red];
		j583925868 -> j4058901902;
	j1933019177 [label="我猜她说的那些是粗话。",shape=box,color=red];
		j1933019177 -> j2914582560;
	j4058901902 [label="PapaPolar: 这就是在海外执行众多任务的一大乐趣。被 100 种语言骂过",shape=box,color=blue];
		j4058901902 -> j997856678;
		j4058901902 -> j840007584;
	j2914582560 [label="PapaPolar: 是的。这就是在海外执行众多任务的一大乐趣。被 100 种语言骂过",shape=box,color=blue];
		j2914582560 -> j997856678;
		j2914582560 -> j840007584;
	j997856678 [label="你们俩……是夫妻吗？",shape=box,color=red];
		j997856678 -> j2976039086;
	j840007584 [label="你们两个……抚养了鲁莎卡？",shape=box,color=red];
		j840007584 -> j137500542;
	j2976039086 [label="Boolean MinervaVelimir1 is now true.",color=orange];
		j2976039086 -> j1873508389;
	j137500542 [label="Boolean MinervaNeci3a is now true.",color=orange];
		j137500542 -> j2800575680;
	j1873508389 [label="PapaPolar: 嗯。可以这么说。不过现在不算了。只是纸面上的关系。在某个大约在 1982 年就不复存在的国家？",shape=box,color=blue];
		j1873508389 -> j2439753895;
	j2800575680 [label="PapaPolar: 差不多吧。我们在从这往南距离有几个国家的小镇上待过。那里被炸得粉碎。我们在一栋楼里找到了她，一头红发，气呼呼的。",shape=box,color=blue];
		j2800575680 -> j482703730;
	j2439753895 [label="PapaPolar: 这样还算吗？",shape=box,color=blue];
		j2439753895 -> j1254171253;
		j2439753895 -> j3406829663;
	j482703730 [label="PapaPolar: 她试图用勺子刺了我六次，哈哈哈，真是你见过的最可爱的小东西。",shape=box,color=blue];
		j482703730 -> j874482775;
	j1254171253 [label="是的，看起来你们已经不在一起了。",shape=box,color=red];
		j1254171253 -> j4112131013;
	j3406829663 [label="这样就解释了你们争吵的原因。",shape=box,color=red];
		j3406829663 -> j1384110694;
	j874482775 [label="PapaPolar: 然后，她还紧抱着一个小兔子毛绒玩具。米告诉她，她会用生命来保护它，保证它的安全。",shape=box,color=blue];
		j874482775 -> j1812922580;
	j4112131013 [label="PapaPolar: 是哪里让你看出来的。",shape=box,color=blue];
		j4112131013 -> j1384110694;
	j1384110694 [label="PapaPolar: 当内奇离开去加入炽蛇军后……我们之间的关系就再也不像以前一样了。我想，那是压死骆驼的最后一根稻草吧。",shape=box,color=blue];
		j1384110694 -> j1975003224;
	j1812922580 [label="PapaPolar: 这很快就赢得了内奇的信任。她直接跑向米，抱住了她。之后我们就退伍了。好吧。正式地。变成了“顾问”。",shape=box,color=blue];
		j1812922580 -> j97011949;
	j1975003224 [label="PapaPolar: 唉。",shape=box,color=blue];
		j1975003224 -> j462567701;
	j97011949 [label="PapaPolar: 所以……是的，你可以说我们抚养了她。",shape=box,color=blue];
		j97011949 -> j462567701;
	j462567701 [label="PapaPolar: 好了，我得去做我最擅长的事情了。",shape=box,color=blue];
		j462567701 -> j2465628170;
	j2465628170 [label="PapaPolar: 假装我知道我说错了什么，再假装我以后不会再犯同样的错误。",shape=box,color=blue];
		j2465628170 -> j2017522426;
	j2017522426 [label="+20 Chemistry",color=orange];
