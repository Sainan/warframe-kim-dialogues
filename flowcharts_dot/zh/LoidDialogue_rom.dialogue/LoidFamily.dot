	20 [label="漂泊者。我妥协了。罗瑟、玛丽和里昂说服了我，时机终于到了。",shape=box,color=blue];
		20 -> 22;
	21 [label="Chat ends.",color=orange];
	22 [label="我对自己必须要做的事从骨髓深处感到恐惧。确实，当戈迈特鲁和她的家人发现这些年在他们脚底下发生的一切时，他们一定会怒不可遏地将我肢解，连骨髓可能都留不下来。",shape=box,color=blue];
		22 -> 23;
	23 [label="如今再以那个名字称呼她竟然觉如此陌生，我们之间已经发生了太多改变。而更多改变，转瞬即至。",shape=box,color=blue];
		23 -> 24;
		23 -> 25;
	24 [label="这件事早就该做了。你会没事的。",shape=box,color=red];
		24 -> 26;
	25 [label="你可以的。",shape=box,color=red];
		25 -> 26;
	26 [label="是啊，好吧。麻烦你务必过来确认我的内脏没有被当作节日装饰品摆在殁世幽都里，行吗？毕竟事到如今，我还是需要一些安慰。",shape=box,color=blue];
		26 -> 27;
	27 [label="Update boolean LoidFamilyComplete",color=orange];
