	"LoidRank1Convo1 begins." [color=orange];
		"LoidRank1Convo1 begins." -> j188065699;
	j188065699 [label="漂泊者。请原谅我冒昧打扰。我本不想通过这个装置联系你。但事态已近紧急，我实在不知道还能向谁求助。",shape=box,color=blue];
		j188065699 -> j1678423718;
		j188065699 -> j4183223850;
	j1678423718 [label="POM2_LAB1 是谁？",shape=box,color=red];
		j1678423718 -> j1411205710;
	j4183223850 [label="这是谁……？",shape=box,color=red];
		j4183223850 -> j1411205710;
	j1411205710 [label="啊，是的。这装置还是默认设置。我是洛德。我本该……先说明身份的，但解剖圣所这里近来实在是一片混乱。",shape=box,color=blue];
		j1411205710 -> j584456029;
	j584456029 [label="正因如此我才联系你。我需要你的协助。在我所处的这个时代，有三位原型战甲出现在圣所。而且都是我们之前没见过的。",shape=box,color=blue];
		j584456029 -> j1555994390;
	j1555994390 [label="其中一位是……",shape=box,color=blue];
		j1555994390 -> j479187441;
	j479187441 [label="抱歉",shape=box,color=blue];
		j479187441 -> j3935644316;
	j3935644316 [label="漂泊者，其中一位是奥罗金人。",shape=box,color=blue];
		j3935644316 -> j33352338;
		j3935644316 -> j4171734765;
		j3935644316 -> j483220425;
	j33352338 [label="Lotus 在哪？",shape=box,color=red];
		j33352338 -> j3173728276;
	j4171734765 [label="噢，不…… ",shape=box,color=red];
		j4171734765 -> j4165017475;
	j483220425 [label="什么？！",shape=box,color=red];
		j483220425 -> j4165017475;
	j3173728276 [label="请相信我，Lotus 和指挥官另有要务在身。他们已被压榨到极限，实在不堪重负。如果不是万不得已，我不会求助于你处理这些事务。",shape=box,color=blue];
		j3173728276 -> j1312855374;
	j4165017475 [label="如果不是万不得已，我不会求助于你处理这些事务。你……似乎成了这方面事务的新专家。",shape=box,color=blue];
		j4165017475 -> j357328;
	j1312855374 [label="你……似乎成了这方面事务的新专家。",shape=box,color=blue];
		j1312855374 -> j357328;
	j357328 [label="我实在不知该如何形容他们。但如果你来到圣所，想必很难不注意到他们。其中两位已经同意通过石榴 2 代跟你交流，另一位或许还需要再劝说一下。",shape=box,color=blue];
		j357328 -> j4220134785;
	j4220134785 [label="我……坚信……你会成功的。",shape=box,color=blue];
