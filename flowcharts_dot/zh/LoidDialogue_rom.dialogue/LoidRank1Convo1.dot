digraph {
	0 [label="LoidRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="漂泊者。请原谅我冒昧打扰。我本不想通过这个装置联系你。但事态已近紧急，我实在不知道还能向谁求助。",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="POM2_LAB1 是谁？",shape=box,color=red];
		2 -> 4;
	3 [label="这是谁……？",shape=box,color=red];
		3 -> 4;
	4 [label="啊，是的。这装置还是默认设置。我是洛德。我本该……先说明身份的，但解剖圣所这里近来实在是一片混乱。",shape=box,color=blue];
		4 -> 5;
	5 [label="正因如此我才联系你。我需要你的协助。在我所处的这个时代，有三位原型战甲出现在圣所。而且都是我们之前没见过的。",shape=box,color=blue];
		5 -> 6;
	6 [label="其中一位是……",shape=box,color=blue];
		6 -> 7;
	7 [label="抱歉",shape=box,color=blue];
		7 -> 8;
	8 [label="漂泊者，其中一位是 奥罗金人。",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
		8 -> 11;
	9 [label="Lotus 在哪？",shape=box,color=red];
		9 -> 12;
	10 [label="噢，不…… ",shape=box,color=red];
		10 -> 13;
	11 [label="什么？！",shape=box,color=red];
		11 -> 13;
	12 [label="请相信我，Lotus 和指挥官另有要务在身。他们已被压榨到极限，实在不堪重负。如果不是万不得已，我不会求助于你处理这些事务。",shape=box,color=blue];
		12 -> 14;
	13 [label="如果不是万不得已，我不会求助于你处理这些事务。你……似乎成了这方面事务的新专家。",shape=box,color=blue];
		13 -> 15;
	14 [label="你……似乎成了这方面事务的新专家。",shape=box,color=blue];
		14 -> 15;
	15 [label="我实在不知该如何形容他们。但如果你来到圣所，想必很难不注意到他们。其中两位已经同意通过石榴 2 代跟你交流，另一位或许还需要再劝说一下。",shape=box,color=blue];
		15 -> 16;
	16 [label="我……坚信……你会成功的。",shape=box,color=blue];
		16 -> 29;
	29 [label="Update boolean LoidTriadAvailable",color=orange];
		29 -> 17;
	17 [label="Chat ends. Next chat will be LoidFamily.",color=orange];
}