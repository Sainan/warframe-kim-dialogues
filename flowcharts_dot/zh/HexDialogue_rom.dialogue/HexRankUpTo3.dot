digraph {
	4 [label="HexRankUpTo3 begins.",color=orange];
		4 -> 85;
	85 [label="Soldja1Shot1kil: 假设有个人饿了……",shape=box,color=blue];
		85 -> 86;
	86 [label="H16h V0l7463: 哈！饿坏了的昆西。你知道吗，我小时候玩过类似的桌游，我打赌我可以——",shape=box,color=blue];
		86 -> 87;
