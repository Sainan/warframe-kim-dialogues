		86 -> 89;
	87 [label="团队午餐？",shape=box,color=red];
		87 -> 188;
	88 [label="随时欢迎加入我。",shape=box,color=red];
		88 -> 189;
	89 [label="这可是个大美食广场，来吧。",shape=box,color=red];
		89 -> 190;
	188 [label="Update boolean HexTeamLunch",color=orange];
		188 -> 90;
	189 [label="Update boolean HexJoinLunch",color=orange];
		189 -> 90;
	190 [label="Update boolean HexAllLunch",color=orange];
		190 -> 90;
	90 [label="Soldja1Shot1kil: 让我说完。假设有个人饿了，但是在那个美食广场里，那些被美化的恶心商业广告不断在轰炸我们的耳朵。如果我用枪来解决这些叫个不停的设备，你会怎么说？",shape=box,color=blue];
		90 -> 91;
	91 [label="xX GLIMMER Xx: 哦哦，让我来解决它们。我会小心点，不伤到兹克！<RETRO_EMOJI_PUMPEDUP> ",shape=box,color=blue];
		91 -> 92;
	92 [label="Belladonna ~{@: ¡Ay, no!
我跟你说过了，我们可能需要把病人安置在这里，外面的那些人
不能有弹片，不能有碎片
我需要干净的空间",shape=box,color=blue];
		92 -> 93;
	93 [label="Salem: 好了好了，亲爱的莱蒂。难道没有人注意到吗？",shape=box,color=blue];
		93 -> 94;
	94 [label="Broadsword: 埃莉，注意到什么？",shape=box,color=blue];
		94 -> 95;
	95 [label="Salem: 外面围着商场的不是病人，而是那些好奇的市民，他们似乎觉得……这里更安全。",shape=box,color=blue];
		95 -> 96;
	96 [label="H16h V0l7463: 等等等等。你是说我们……真的有在改善这个地方吗？",shape=box,color=blue];
		96 -> 97;
		96 -> 98;
		96 -> 99;
	97 [label="当然有了。",shape=box,color=red];
		97 -> 191;
	98 [label="我们有。",shape=box,color=red];
		98 -> 192;
	99 [label="我想是这样。",shape=box,color=red];
		99 -> 193;
	191 [label="Update boolean HexMakeADiffSure",color=orange];
		191 -> 100;
	192 [label="Update boolean HexMakeADiff",color=orange];
		192 -> 100;
	193 [label="Update boolean HexMakeADiffHope",color=orange];
		193 -> 100;
	100 [label="Broadsword: 我们不是一个坏团",shape=box,color=blue];
		100 -> 101;
	101 [label="H16h V0l7463: 他要说那个词了",shape=box,color=blue];
		101 -> 102;
	102 [label="Broadsword: ……团队。",shape=box,color=blue];
		102 -> 103;
	103 [label="Soldja1Shot1kil: 还有更多的嘴要喂……即使亚瑟陛下觉得我们已经过得很好了？这不是个好主意",shape=box,color=blue];
		103 -> 104;
	104 [label="Salem: 我可以打发他们。只要一个念头就够了……",shape=box,color=blue];
		104 -> 105;
	105 [label="xX GLIMMER Xx: 我总觉得……即使我们尽了最大努力，为什么要让人们产生一种错觉，觉得我们能救他们中的任何一个？最后的结果对谁都不好。",shape=box,color=blue];
		105 -> 106;
		105 -> 107;
		105 -> 108;
	106 [label="如果这不是错觉呢？",shape=box,color=red];
		106 -> 194;
	107 [label="也许这就是意义所在。知道我们能够做出改变。",shape=box,color=red];
		107 -> 195;
	108 [label="现在越多的人能感受到希望，就越好。",shape=box,color=red];
		108 -> 196;
	194 [label="Update boolean HexGiveComfort",color=orange];
		194 -> 109;
	195 [label="Update boolean HexGiveAssurance",color=orange];
		195 -> 109;
	196 [label="Update boolean HexGiveHope",color=orange];
		196 -> 109;
	109 [label="H16h V0l7463: 嗯，虽然我不想泼冷水？但是，我觉得我们可能是在邀请更多人来参加失望派对。",shape=box,color=blue];
		109 -> 110;
	110 [label="Salem: 可我们难道不应该试试改变命运的天平吗？哪怕只是轻轻一碰，也可能会非常有趣。",shape=box,color=blue];
		110 -> 111;
	111 [label="Belladonna ~{@: 好吧，那我就是负责处理流鼻涕和截肢的人了？
我姨妈总是说“空腹时不要做重大决定”
我们去美食广场见面，讨论一下接下来该怎么办",shape=box,color=blue];
		111 -> 112;
	112 [label="xX GLIMMER Xx: <RETRO_EMOJI_HAPPY2> 噢！团队午餐！",shape=box,color=blue];
		112 -> 113;
	113 [label="Broadsword: 团队午餐。",shape=box,color=blue];
		113 -> 114;
	114 [label="Soldja1Shot1kil: 我会来。还有大家不必客气，帮你们开了这个头",shape=box,color=blue];
