		172 -> 50;
	84 [label="Soldja1Shot1kil: 哈哈，果然",shape=box,color=blue];
		84 -> 173;
	50 [label="Broadsword: 我们已经有够多的装备要保养了。漂泊者，这是你的了。如果它坏了，你得负责修理费。或者处理掉它。",shape=box,color=blue];
		50 -> 51;
	173 [label="Update boolean HexDroneFree",color=orange];
		173 -> 50;
	51 [label="H16h V0l7463: 阿米尔的维修折扣马上就到，但请用硬币付款。",shape=box,color=blue];
		51 -> 52;
	52 [label="xX GLIMMER Xx: 嘿？之前的问题？怎么喂它？我不太清楚未来的……东西是怎么用的……",shape=box,color=blue];
		52 -> 53;
		52 -> 54;
		52 -> 55;
	53 [label="不用，假装它是魔法吧。",shape=box,color=red];
		53 -> 174;
	54 [label="连面包渣都不要，但是它可能会吸到什么。",shape=box,color=red];
