		170 -> 45;
	45 [label="Salem: 碧指的是我们那个快乐的小无人机。",shape=box,color=blue];
		45 -> 46;
	46 [label="Soldja1Shot1kil: 你的意思是，未来人的无人机。不是我的，也不是我们的",shape=box,color=blue];
		46 -> 47;
		46 -> 48;
		46 -> 49;
	47 [label="那是个礼物。",shape=box,color=red];
		47 -> 171;
	48 [label="现在属于商场了。",shape=box,color=red];
		48 -> 172;
	49 [label="如果你弄坏它，下一个就得收费了。",shape=box,color=red];
		49 -> 84;
