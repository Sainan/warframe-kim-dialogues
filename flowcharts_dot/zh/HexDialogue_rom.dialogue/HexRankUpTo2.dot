		56 -> 57;
	175 [label="Update boolean HexFixFaster",color=orange];
		175 -> 56;
	57 [label="Soldja1Shot1kil: 可是你不是已经加了四张嘴了吗？你那些小鼠什么的",shape=box,color=blue];
		57 -> 58;
	58 [label="H16h V0l7463: 唔，*严格来说*应该是五个，因为还有一只想要吃小鼠的大猫……",shape=box,color=blue];
		58 -> 59;
	59 [label="xX GLIMMER Xx: 阿米尔！谁都不会吃谁！",shape=box,color=blue];
		59 -> 60;
	60 [label="Salem: 真可惜。",shape=box,color=blue];
		60 -> 61;
	61 [label="Broadsword: 该死的，我打字速度可不像",shape=box,color=blue];
		61 -> 62;
	62 [label="H16h V0l7463: 像我我我我？我我我？我吗？",shape=box,color=blue];
		62 -> 63;
	63 [label="Broadsword: 停。够了！",shape=box,color=blue];
		63 -> 64;
	64 [label="Broadsword: 我们的食物够多的。我数过了。而且我注意到午餐轮流情况：昆西第一个吃午餐，自己一个人。然后是莱蒂，自己一个人，小鼠不算。阿米尔，吃得很快，自己一个人。碧和我总是在阿米尔之后吃饭，通常是她先吃。埃莉诺总是最后一个吃。自己一个人。",shape=box,color=blue];
		64 -> 65;
		64 -> 66;
		64 -> 67;
	65 [label="那我呢？",shape=box,color=red];
		65 -> 177;
	66 [label="你有关注过我的时间安排吗？",shape=box,color=red];
		66 -> 178;
	67 [label="我每次都是自己一个人吃。",shape=box,color=red];
		67 -> 179;
	177 [label="Update boolean HexFoodNotMe",color=orange];
		177 -> 68;
	178 [label="Update boolean HexFoodSchedule",color=orange];
		178 -> 68;
	179 [label="Update boolean HexFoodAlone",color=orange];
		179 -> 68;
	68 [label="xX GLIMMER Xx: 或许下次你可以和我一起吃饭？大家都可以和我一起吃午餐……我以为大家都想要自己的独处时间……",shape=box,color=blue];
		68 -> 69;
	69 [label="H16h V0l7463: 我超喜欢吃，我会跟大家一起吃，给阿米尔来 6 片披萨！哈哈哈哈",shape=box,color=blue];
		69 -> 70;
	70 [label="Soldja1Shot1kil: 好吧，既然亚瑟说我们的食物够了，那就得喂饱那个还在长身体的小男孩",shape=box,color=blue];
		70 -> 71;
	71 [label="H16h V0l7463: 嘿，我真觉得我比你高，那你为什么这么说？这样我岂不是能长得更大吗！哈！",shape=box,color=blue];
		71 -> 72;
		71 -> 73;
		71 -> 74;
	72 [label="如果我们大家一起吃，可能是个不错的团队时刻。",shape=box,color=red];
		72 -> 180;
	73 [label="我很想有一个团队午餐。",shape=box,color=red];
