digraph {
	12 [label="HexRankUpTo1 begins.",color=orange];
		12 -> 16;
	16 [label="Broadsword: 我们被困在这里了，明白吗？所以你们自己打扫一下吧——这个美食广场比街道还脏。这可不是该死的动物园。",shape=box,color=blue];
		16 -> 17;
	17 [label="Salem: 莱蒂可能会帮忙让这里变成动物园——",shape=box,color=blue];
		17 -> 18;
	18 [label="Belladonna ~{@: 别说了。",shape=box,color=blue];
		18 -> 35;
	35 [label="Soldja1Shot1kil: 哈，上钩了。",shape=box,color=blue];
		35 -> 19;
	19 [label="H16h V0l7463: 哇哦，你们终于开始用我的群聊了？！好兴奋哦！！",shape=box,color=blue];
		19 -> 20;
	20 [label="xX GLIMMER Xx: :) <3 阿米尔，我就说嘛！",shape=box,color=blue];
		20 -> 21;
		20 -> 22;
		20 -> 23;
	21 [label="其实我有个东西可以帮忙清理——这是|ITEM|。",shape=box,color=red];
