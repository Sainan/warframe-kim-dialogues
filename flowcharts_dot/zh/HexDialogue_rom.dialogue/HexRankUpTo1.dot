	24 [label="H16h V0l7463: 你什么意思，你居然有一个清洁机器人",shape=box,color=blue];
		24 -> 25;
	25 [label="Broadsword: 好吧。不过如果它让我睡不着，碧会把它变成废铁。",shape=box,color=blue];
		25 -> 26;
	26 [label="Soldja1Shot1kil: 不，伙计，先让我用它当靶子",shape=box,color=blue];
		26 -> 27;
	27 [label="Belladonna ~{@: 亚瑟说的正是我一直在想的
自己收拾吧
万一哪天我们真要把这美食广场当手术室用呢
¿Entendieron?",shape=box,color=blue];
		27 -> 28;
	28 [label="Salem: 拜托，莱蒂，乐观一点。我们现在有个新成员加入了。",shape=box,color=blue];
		28 -> 29;
	29 [label="xX GLIMMER Xx: 对吧！？乐观一点！没错！那么，漂泊者，既然你的是新视角。你觉得这个美食广场怎么样？<RETRO_EMOJI_FOOD>",shape=box,color=blue];
		29 -> 30;
		29 -> 31;
	30 [label="看起来我们大家都能在这里吃饭。",shape=box,color=red];
		30 -> 186;
	31 [label="这让我想到，能够有个地方吃饭，几乎像是在放松一样。",shape=box,color=red];
		31 -> 187;
	186 [label="Update boolean HexFoodCourtSit",color=orange];
		186 -> 32;
	187 [label="Update boolean HexFoodCourtMemory",color=orange];
