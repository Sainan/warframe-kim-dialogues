	32 [label="H16h V0l7463: 好吧，行，但如果你看到亚瑟在里面，最好离远点。提前警告：他喜欢一个人待着……",shape=box,color=blue];
		32 -> 33;
	33 [label="Broadsword: 阿米尔。",shape=box,color=blue];
		33 -> 34;
