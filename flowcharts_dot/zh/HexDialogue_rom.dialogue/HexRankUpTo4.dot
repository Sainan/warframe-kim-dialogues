digraph {
	7 [label="HexRankUpTo4 begins.",color=orange];
		7 -> 119;
	119 [label="H16h V0l7463: 这是续集吗！？我是《阿米尔 2：寻找更多阿米尔》？！《阿米尔 1》怎么了？！",shape=box,color=blue];
		119 -> 120;
	120 [label="Salem: 我的漂泊者。",shape=box,color=blue];
		120 -> 121;
	121 [label="Belladonna ~{@: 这里甚至感觉更明亮了
太阳神真的很高兴",shape=box,color=blue];
		121 -> 122;
	122 [label="Soldja1Shot1kil: 这才叫风格。看清楚了。",shape=box,color=blue];
		122 -> 123;
	123 [label="xX GLIMMER Xx: <RETRO_EMOJI_GIVELOVE>",shape=box,color=blue];
		123 -> 124;
	124 [label="Broadsword: 天。你到底*做*了什么？",shape=box,color=blue];
		124 -> 125;
		124 -> 126;
	125 [label="只是做了我觉得对的事。",shape=box,color=red];
		125 -> 200;
	126 [label="只做了我唯一知道怎么做的事。",shape=box,color=red];
		126 -> 201;
	200 [label="Update boolean HexWhatFeltRight",color=orange];
		200 -> 127;
	201 [label="Update boolean HexWhatIKnow",color=orange];
		201 -> 127;
	127 [label="H16h V0l7463: 但我是谁？你又是谁？发生了什么事？",shape=box,color=blue];
		127 -> 128;
	128 [label="Soldja1Shot1kil: 喂，冷静点。我们还是我们。看，兄弟。那个小无人机还在这里清理我们的垃圾",shape=box,color=blue];
		128 -> 129;
	129 [label="Salem: 就像我们亲爱的漂泊者所做的那样。清理了一大堆垃圾。",shape=box,color=blue];
		129 -> 130;
	130 [label="xX GLIMMER Xx: 我倒觉得是，你把我们的歌做了个重制版？嗯？",shape=box,color=blue];
		130 -> 131;
		130 -> 132;
		130 -> 133;
	131 [label="你可以把它当做最好的防守策略。",shape=box,color=red];
		131 -> 202;
	132 [label="可以看作是一次品牌重塑。",shape=box,color=red];
		132 -> 203;
	133 [label="我只是按照我们自己的方式做事。",shape=box,color=red];
		133 -> 204;
	202 [label="Update boolean HexDefensivePlay",color=orange];
		202 -> 134;
	203 [label="Update boolean HexRebrand",color=orange];
		203 -> 134;
	204 [label="Update boolean HexOurWay",color=orange];
		204 -> 134;
	134 [label="Broadsword: 但是怎么做到的？",shape=box,color=blue];
		134 -> 135;
	135 [label="Salem: 弟弟，这个问题简单，难的是为什么？",shape=box,color=blue];
		135 -> 136;
		135 -> 137;
		135 -> 138;
	136 [label="因为我们是一个团队。",shape=box,color=red];
		136 -> 205;
	137 [label="你难道没发现我们是一个团队吗？",shape=box,color=red];
		137 -> 206;
	138 [label="一个人是没有未来的。",shape=box,color=red];
		138 -> 207;
	205 [label="Update boolean HexWereATeam",color=orange];
		205 -> 139;
	206 [label="Update boolean HexSeeWereATeam",color=orange];
		206 -> 139;
	207 [label="Update boolean HexNoFutureAlone",color=orange];
		207 -> 139;
	139 [label="xX GLIMMER Xx: 我们是一个团队，是的！ <RETRO_EMOJI_THUMBSUP>",shape=box,color=blue];
		139 -> 140;
	140 [label="Soldja1Shot1kil: 可是伙计，这游戏怎么玩？",shape=box,color=blue];
		140 -> 141;
	141 [label="H16h V0l7463: 也许游戏的目标是拯救霍瓦尼亚！然后我们还能收集 NPC！！",shape=box,color=blue];
		141 -> 142;
	142 [label="Belladonna ~{@: 唉，月神，sálvame
阿米尔，你是说人",shape=box,color=blue];
		142 -> 143;
		142 -> 144;
		142 -> 145;
	143 [label="如果这是一局游戏，我做的只是重置了棋子。",shape=box,color=red];
		143 -> 150;
	144 [label="无论这是什么游戏，我只是迈出了一步。",shape=box,color=red];
		144 -> 209;
	145 [label="英择谛似乎总是领先一步。",shape=box,color=red];
		145 -> 210;
	150 [label="Soldja1Shot1kil: 不，老表。听起来像是你改变了游戏规则。向你致敬",shape=box,color=blue];
		150 -> 208;
	209 [label="Update boolean HexWhatGameIsThis",color=orange];
		209 -> 146;
	210 [label="Update boolean HexEntratiAhead",color=orange];
		210 -> 146;
	208 [label="Update boolean HexResetPieces",color=orange];
		208 -> 146;
	146 [label="Broadsword: 不管谁在这局里，我觉得我们已经把这一年、这个地方、这个时刻变成属于我们自己的了。我们要永不放手。要保护这里的人们和彼此。",shape=box,color=blue];
		146 -> 147;
	147 [label="xX GLIMMER Xx: 是的，我们要让这一切成真！比如值得期待的事情、回忆、更多的事。去拯救其他人，不只是我们自己。",shape=box,color=blue];
		147 -> 148;
	148 [label="Salem: 我们是开始，而不是结束。",shape=box,color=blue];
		148 -> 149;
	149 [label="Belladonna ~{@: Bruja，就这一次？
我同意。",shape=box,color=blue];
		149 -> 38;
	38 [label="{\"Id\":38,\"Incoming\":[149],\"Outgoing\":[8],\"GraphPos\":[9318,-2019],\"CompletionType\":3,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/AoiDialogue_rom.dialogue\",\"Tag\":\"\",\"Value\":30},{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/ArthurDialogue_rom.dialogue\",\"Tag\":\"\",\"Value\":30},{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/EleanorDialogue_rom.dialogue\",\"Tag\":\"\",\"Value\":30},{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/JabirDialogue_rom.dialogue\",\"Tag\":\"\",\"Value\":30},{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/LettieDialogue_rom.dialogue\",\"Tag\":\"\",\"Value\":30},{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/QuincyDialogue_rom.dialogue\",\"Tag\":\"\",\"Value\":30}]}",color=orange];
		38 -> 8;
	8 [label="Chat ends.",color=orange];
