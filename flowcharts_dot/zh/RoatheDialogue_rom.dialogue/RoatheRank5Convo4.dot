	j2060527101 [label="Boolean RoatheResetDealComplete is now true.",color=orange];
		j2060527101 -> j3088359878;
	j1654679497 [label="我们达成协议了，漂泊者。你对玛丽的态度，以及她对阿尔布雷希特的看法感到满意吗？在我看来，那个飘来飘去的谄媚之徒依然如故地坚定不移。",shape=box,color=blue];
		j1654679497 -> j2264716046;
	j3413259824 [label="我们达成协议了，漂泊者。你自己对和里昂之间的结果满意吗？在我看来，那可怜的混蛋还是像往常一样心烦意乱。",shape=box,color=blue];
		j3413259824 -> j2099623384;
	j3434300120 [label="你觉得尼托发生了什么事？",shape=box,color=red];
		j3434300120 -> j3090064213;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j496007956 [label="我们达成协议了，漂泊者。虽然看来你终究不需要我帮你对付玛丽，但记住，恶魔总会讨回它的债。",shape=box,color=blue];
		j496007956 -> j3939409377;
	j3088359878 [label="我们达成协议了，漂泊者。虽然看来你终究不需要我帮你对付里昂，但记住，恶魔总会讨回它的债。",shape=box,color=blue];
		j3088359878 -> j3939409377;
	j2264716046 [label="Boolean RoatheResetDealComplete is now true.",color=orange];
		j2264716046 -> j2311538922;
