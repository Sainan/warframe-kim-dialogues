	j2217935356 [label="Boolean RoatheMarieEntratiDeal is now false.",color=orange];
		j2217935356 -> j1615273926;
	j2653516504 [label="随你便。但记住，唯一比恶魔更可怕的……就是有你这种欠着债的朋友的恶魔。",shape=box,color=blue];
		j2653516504 -> "Chat ends.";
	j2004294550 [label="Boolean RoatheLyonConfessionDeal is now false.",color=orange];
		j2004294550 -> j956432861;
	j904457515 [label="我希望这不会引起你的嫉妒。那并非本意，我只是想解释一下她给我带来了多少伤害。",shape=box,color=blue];
		j904457515 -> j917447900;
	j2456514120 [label="如果没有她，就不会有今天的我。我所知的一切皆源于她。她将未经雕琢的泥土，塑造成了现在的我。",shape=box,color=blue];
		j2456514120 -> j459449423;
		j2456514120 -> j535382994;
		j2456514120 -> j1995060749;
	j1615273926 [label="+5 Chemistry",color=orange];
		j1615273926 -> j4221158973;
	j956432861 [label="+5 Chemistry",color=orange];
		j956432861 -> j1959590517;
	j917447900 [label="然而，我同样欠她太多。如果没有她，就不会有今天的我。我所知的一切皆源于她。她将未经雕琢的泥土，塑造成了现在的我。",shape=box,color=blue];
		j917447900 -> j459449423;
		j917447900 -> j1285233305;
		j917447900 -> j3701047710;
	j459449423 [label="我懂。我也曾有过类似的经历。",shape=box,color=red];
		j459449423 -> j425681646;
	j535382994 [label="听起来你似乎还没完全放下对她的感情。",shape=box,color=red];
		j535382994 -> j2289647460;
	j1995060749 [label="你觉得她还活着吗？还是你觉得她已经死了？",shape=box,color=red];
		j1995060749 -> j3955859770;
	j4221158973 [label="说定了。但记住，唯一比恶魔更可怕的……就是有你这种欠债的朋友的恶魔。",shape=box,color=blue];
		j4221158973 -> "Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j1959590517 [label="说定了。但记住，唯一比恶魔更可怕的……就是有你这种欠债的朋友的恶魔。",shape=box,color=blue];
		j1959590517 -> "Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j1285233305 [label="我明白。没关系。",shape=box,color=red];
		j1285233305 -> j2017054991;
	j3701047710 [label="我希望你不要再提起她。",shape=box,color=red];
		j3701047710 -> j2763146856;
	j425681646 [label="+5 Chemistry",color=orange];
		j425681646 -> j822932665;
	j2289647460 [label="这话不太准确。我确实放下了。我不再爱她了。我不再在乎她是否会死于我的残暴之手。但我发现自己强烈地想知道她的故事最终如何收场。",shape=box,color=blue];
		j2289647460 -> j2158403910;
	j3955859770 [label="很难想象一个如此嗜血好杀的人，竟能在这几个世纪里保持如此沉寂。",shape=box,color=blue];
		j3955859770 -> j2754096483;
	"Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
	"Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j2017054991 [label="正因这段过往，我才好奇她的下落。仅仅是因为我想知道她的故事如何收场。如果真的有结局的话。",shape=box,color=blue];
		j2017054991 -> j2158403910;
	j2763146856 [label="抱歉，是你先提起的。亲爱的漂泊者，你这人真是让人费解。",shape=box,color=blue];
		j2763146856 -> "Chat ends.";
	j822932665 [label="那么你就能理解我为何好奇她的下落。仅仅是因为我想知道她的故事如何收场。如果真的有结局的话。",shape=box,color=blue];
		j822932665 -> j2158403910;
	j2158403910 [label="那些在你人生故事中扮演过关键角色的人，无论他们多么恶毒，都很难从你生命里彻底抹去。",shape=box,color=blue];
		j2158403910 -> j3955859770;
	j2754096483 [label="如果她还活着，就不是自愿在暗处埋伏的。",shape=box,color=blue];
		j2754096483 -> j2669208373;
