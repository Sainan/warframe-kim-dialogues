	j2099623384 [label="Boolean RoatheResetDealComplete is now true.",color=orange];
		j2099623384 -> j3504730581;
		j2099623384 -> j2257011453;
	j3090064213 [label="真是个惊人的问题。自从我变成这具融合感染体以来，我自己也反复思考过这个问题。",shape=box,color=blue];
		j3090064213 -> j1601518961;
	j3939409377 [label="无论你是否履行协议，我都将讨回应得之物。",shape=box,color=blue];
		j3939409377 -> j2368672370;
		j3939409377 -> j976844474;
	j2311538922 [label="我怎么也说不动她……",shape=box,color=red];
		j2311538922 -> j2507901781;
	j889233061 [label="这事就这么放着也行。我不需要你的帮忙。",shape=box,color=red];
		j889233061 -> j2146501541;
	j3504730581 [label="不，我觉得我辜负了他。",shape=box,color=red];
		j3504730581 -> j1430690382;
	j2257011453 [label="这事就这么放着也行。我不需要你的帮忙。",shape=box,color=red];
		j2257011453 -> j1255195842;
	j1601518961 [label="但如今记忆完全恢复，我发现自己想起她的次数越来越频繁。",shape=box,color=blue];
		j1601518961 -> j2173970786;
	j2368672370 [label="你究竟要收取什么？你从来没说过你希望从这得到什么。",shape=box,color=red];
		j2368672370 -> j2035078609;
	j976844474 [label="我觉得你是在虚张声势。我甚至觉得你根本没有想要什么的计划。 ",shape=box,color=red];
		j976844474 -> j1624084912;
	j2507901781 [label="那么，我就替你解决这个问题吧。很快，我便会来取回应得的一切。",shape=box,color=blue];
		j2507901781 -> j544054243;
		j2507901781 -> j2283898274;
	j2146501541 [label="你不如利用这个机会。无论你是否履行协议，我都将讨回应得之物。",shape=box,color=blue];
		j2146501541 -> j2283898274;
		j2146501541 -> j544054243;
	j1430690382 [label="那么，我就替你解决这个问题吧。很快，我便会来取回应得的一切。",shape=box,color=blue];
		j1430690382 -> j2906095410;
		j1430690382 -> j2544856958;
	j1255195842 [label="你不如利用这个机会。无论你是否履行协议，我都将讨回应得之物。",shape=box,color=blue];
		j1255195842 -> j2906095410;
		j1255195842 -> j2544856958;
	j2173970786 [label="你必须明白，我和那个女人的关系究竟有多么复杂……多么有害。很难确切描述我有多么爱她，又多么恨她。 ",shape=box,color=blue];
		j2173970786 -> j477184975;
	j2035078609 [label="你难道不知道你有多强大吗？不知道把你掌控在我身边有多么重要吗？",shape=box,color=blue];
		j2035078609 -> j260072654;
	j1624084912 [label="篡位者，“什么”远不如“谁”重要。",shape=box,color=blue];
		j1624084912 -> j2035078609;
	j544054243 [label="我觉得你是在虚张声势。我甚至觉得你根本没有想要什么的计划。 ",shape=box,color=red];
		j544054243 -> j2814848180;
	j2283898274 [label="你究竟要收取什么？你从来没说过你希望从这得到什么。",shape=box,color=red];
		j2283898274 -> j1630149024;
	j2906095410 [label="你究竟要收取什么？你从来没说过你希望从这得到什么。",shape=box,color=red];
		j2906095410 -> j1750087030;
	j2544856958 [label="我觉得你是在虚张声势。我甚至觉得你根本没有想要什么的计划。 ",shape=box,color=red];
		j2544856958 -> j2719866231;
	j477184975 [label="更重要的是，她让我憎恶自己的一切，直至灵魂深处。然而没有她，我就不存在。我就不会成为现在的我。",shape=box,color=blue];
		j477184975 -> j4015852170;
	j260072654 [label="我猜这就是以前所谓的“空白支票”吧？而且你是心甘情愿地签的。",shape=box,color=blue];
		j260072654 -> j1270460462;
	j2814848180 [label="篡位者，“什么”远不如“谁”重要。",shape=box,color=blue];
		j2814848180 -> j1630149024;
	j1630149024 [label="你难道不知道你有多强大吗？不知道把你掌控在我身边有多么重要吗？",shape=box,color=blue];
		j1630149024 -> j1961028449;
	j1750087030 [label="你难道不知道你有多强大吗？不知道把你掌控在我身边有多么重要吗？",shape=box,color=blue];
		j1750087030 -> j2695388432;
	j2719866231 [label="篡位者，“什么”远不如“谁”重要。",shape=box,color=blue];
		j2719866231 -> j1750087030;
	j4015852170 [label="她成就了我。她也摧毁了我。 ",shape=box,color=blue];
		j4015852170 -> j3079596363;
	j1270460462 [label="+5 Chemistry",color=orange];
		j1270460462 -> j1000385256;
	j1961028449 [label="我猜这就是以前所谓的“空白支票”吧？而且你是心甘情愿地签的。那么你意下如何？要不要我帮你处理玛丽的事？",shape=box,color=blue];
		j1961028449 -> j1008721178;
		j1961028449 -> j297939107;
	j2695388432 [label="我猜这就是以前所谓的“空白支票”吧？而且你是心甘情愿地签的。那么你意下如何？要不要我帮你处理里昂的事？",shape=box,color=blue];
		j2695388432 -> j2430777804;
		j2695388432 -> j2241385178;
	j3079596363 [label="我爱过她。我恨不得她死。",shape=box,color=blue];
		j3079596363 -> j2162170889;
	j1000385256 [label="唯一比恶魔更可怕的……就是有你这种欠债的朋友的恶魔。",shape=box,color=blue];
		j1000385256 -> "Chat ends.";
	j1008721178 [label="好吧，行……",shape=box,color=red];
		j1008721178 -> j2771214308;
