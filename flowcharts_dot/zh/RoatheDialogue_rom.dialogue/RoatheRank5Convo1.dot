	"Chat ends." [color=orange];
	j112766104 [label="亲爱​的​漂泊者，​我​现在​想​起来​了。​我​记得​我​曾经​那么​拼命​地求​你​帮忙​摆脱​它们。​你​也​发誓​你​会​做到。​而​你​也​做​到​了。​",shape=box,color=blue];
		j112766104 -> j951464098;
	j193499239 [label="亲爱​的​漂泊者，​我​现在​想​起来​了。现在我想起来了，我曾请求你做什么，而你却拒绝了。我请求你帮我清除这些记忆，你却拒绝了。然而，我们最终还是走到这一步，不是吗？",shape=box,color=blue];
