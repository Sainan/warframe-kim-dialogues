		j3431854068 -> j480410511;
	j3422432914 [label="我告诉过你，趁现在还来得及，停止你对我记忆的探索！我告诉过你，停止你的工作，可是……可是！",shape=box,color=blue];
		j3422432914 -> j3621741871;
	j661229553 [label="你一直瞒着我，现在才告诉我？这一切对你来说是不是一场变态的游戏？！你明知我会因此受到惩罚，却还故意放纵我内心深处的欲望？！",shape=box,color=blue];
		j661229553 -> j1485563542;
	j2279807039 [label="现在怎么办，亲爱的？现在怎么办……？我感觉自己已经走投无路了。至少以前，我还有屈辱作为庇护！",shape=box,color=blue];
		j2279807039 -> j1267733576;
	j1079638197 [label="现在怎么办，篡位者？现在怎么办……？我感觉自己已经走投无路了。至少以前，我还有屈辱作为庇护！",shape=box,color=blue];
		j1079638197 -> j1689655563;
	j490834244 [label="我明白。相信我，我比你更明白。我明白。",shape=box,color=blue];
		j490834244 -> j300161806;
