	j1082879245 [label="你曾向我许诺，你曾许诺！但现在我发现你不过是个骗子！",shape=box,color=blue];
		j1082879245 -> j1593662720;
		j1082879245 -> j3503052037;
	j874338918 [label="我早该知道的。我早该知道不该相信你，你这个虚空的异类！你知道等着我的真相是什么？！你知道真相，而我却一无所知？！",shape=box,color=blue];
		j874338918 -> j1653888246;
		j874338918 -> j2819662770;
	j951464098 [label="我们又一次回到了原点，再次踏上了过去的尸骸。我们和以前一样，并没有变得更好。",shape=box,color=blue];
		j951464098 -> j3877935883;
	j377063911 [label="看来这结果并不是因为我求来的！但我仍然记得当初选择注射血清时的痛苦。",shape=box,color=blue];
		j377063911 -> j3877935883;
	j2141436946 [label="我们又一次回到了原点，再次踏上了过去的尸骸。我们和以前一样，并没有变得更好。",shape=box,color=blue];
		j2141436946 -> j255429879;
	j1480214069 [label="看来这结果并不是因为我求来的！但我仍然记得当初选择注射血清时的痛苦。",shape=box,color=blue];
		j1480214069 -> j255429879;
	j243498131 [label="你曾对我说过一些话，我当时觉得它们根本不可能成真。请你再告诉我一次，那些话都是真的。请你再说一遍。求你了。我现在比以往任何时候都更需要它们。",shape=box,color=blue];
		j243498131 -> j1349307062;
		j243498131 -> j791204470;
	j2337224787 [label="你曾向我许下诺言。你的诺言！你还用甜言蜜语美化了它。但现在我发现，你不过是个骗子！",shape=box,color=blue];
		j2337224787 -> j1464805816;
		j2337224787 -> j861998019;
	j2161168021 [label="你知道吗？！你知道吗？！你是不是偷偷溜到我身边，轻声细语地安慰我，希望能减轻接下来的打击？",shape=box,color=blue];
		j2161168021 -> j2701414545;
