	j3120092511 [label="遭人诋毁，被人误解，被人唾弃。从天上被贬下，任其腐朽。我们真是让我惺惺相惜啊！",shape=box,color=blue];
		j3120092511 -> j1160991920;
	j3380873735 [label="我知道这一切不是我们的第一次经历了。我记得之前也发展到这里。我也知道这或许不会是最后一次。我一直恳求你停下来，重新开始，而你真的这么做了，这对我意义重大。",shape=box,color=blue];
		j3380873735 -> j2596252113;
	j3871131252 [label="我知道这一切不是我们的第一次经历了。我记得之前也发展到这里。我也知道这或许不会是最后一次。我一直恳求你停下来，重新开始，而你真的这么做了，这对我意义重大。",shape=box,color=blue];
		j3871131252 -> j2944672520;
	j871961817 [label="我知道这一切不是我们的第一次经历了。我记得之前也发展到这里。我也知道这或许不会是最后一次。我一直恳求你停下来，重新开始，而你真的这么做了，这对我意义重大。",shape=box,color=blue];
		j871961817 -> j895819700;
	j1305709823 [label="篡位者，我必须称赞你，因为你听从了我的要求，没有进一步深入深溯池，也没有触及我在沉沦之地中的记忆。尽管我们之间没有任何约定。",shape=box,color=blue];
		j1305709823 -> j2406004455;
	j3352036643 [label="亲爱的，我必须称赞你信守承诺，没有继续深入沉沦之地和深溯池，也没有找回我最后的记忆。这对我意义重大。",shape=box,color=blue];
		j3352036643 -> j1987304125;
	j4287179799 [label="亲爱的，我必须称赞你听从了我的请求，没有继续深入深溯池，也没有触及我在沉沦之地中的记忆。这对我意义重大。",shape=box,color=blue];
