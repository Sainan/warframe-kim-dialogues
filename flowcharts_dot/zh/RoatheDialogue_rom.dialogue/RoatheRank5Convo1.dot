	j529780876 [label="篡位者，我必须称赞你，因为你听从了我的要求，没有进一步深入深溯池，也没有触及我在沉沦之地中的记忆。尽管我们之间没有任何约定。",shape=box,color=blue];
		j529780876 -> j276843583;
	j1160991920 [label="当那些征召者到来时，我体内三种能量交织在一起，第四种能量的出现也就不足为奇了。这股巨大而可怕的力量渴望将我撕裂，如同行星的地壳倾泻而出。",shape=box,color=blue];
		j1160991920 -> j3226932297;
	j2596252113 [label="我记得你对我的承诺。而我竟然在你心中占据了如此重要的位置，以至于你让我一直处于这种炼狱般的境地？谢谢你，我的宠物。谢谢你。",shape=box,color=blue];
		j2596252113 -> j1987304125;
	j2944672520 [label="而我竟然在你心中占据了如此重要的位置，以至于你让我一直处于这种炼狱般的境地？谢谢你，我的宠物。谢谢你。",shape=box,color=blue];
		j2944672520 -> j1987304125;
	j895819700 [label="我记得你对我的承诺。而我竟然与你建立了如此深厚的友谊，以至于你让我一直处于这种炼狱般的境地？谢谢你，我的朋友。",shape=box,color=blue];
		j895819700 -> j276843583;
	j2406004455 [label="而我竟然与你建立了如此深厚的友谊，以至于你让我一直处于这种炼狱般的境地？谢谢你，我的朋友。",shape=box,color=blue];
		j2406004455 -> j276843583;
	j1987304125 [label="虽然这件事仍然让我耿耿于怀，但它就像一只被拴着的库狛，吠叫着，可以被控制，可以被训练。",shape=box,color=blue];
