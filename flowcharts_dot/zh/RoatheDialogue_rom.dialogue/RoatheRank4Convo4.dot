digraph {
	"RoatheRank4Convo4 begins." [color=orange];
		"RoatheRank4Convo4 begins." -> j1880082678;
	j1880082678 [label=" 篡位者，我有个哲学问题想问你。在你对我指的是谁做出任何结论之前，无论我指的是我自己，Ballas、或者是虚空禁止的阿尔布雷希特，这纯粹是个思想实验。我们来玩玩吧？",shape=box,color=blue];
		j1880082678 -> j1287240239;
		j1880082678 -> j2441460801;
		j1880082678 -> j952226364;
	j1287240239 [label="现在我很好奇。",shape=box,color=red];
		j1287240239 -> j1743662791;
	j2441460801 [label="当然，尽管问。",shape=box,color=red];
		j2441460801 -> j1458763066;
	j952226364 [label="我没心情。[结束。]",shape=box,color=red];
		j952226364 -> j1033767323;
	j1743662791 [label="+5 Chemistry",color=orange];
		j1743662791 -> j564407028;
	j1458763066 [label="这个问题很简单，但意义深远：你是否相信每个人都值得被爱？",shape=box,color=blue];
