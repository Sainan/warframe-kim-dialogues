digraph {
	2564 [label="RoatheRank4Convo4 begins.",color=orange];
		2564 -> 2565;
	2565 [label=" 篡位者，我有个哲学问题想问你。在你对我指的是谁做出任何结论之前，无论我指的是我自己，Ballas、或者是虚空禁止的阿尔布雷希特，这纯粹是个思想实验。我们来玩玩吧？",shape=box,color=blue];
		2565 -> 2566;
		2565 -> 2567;
		2565 -> 2568;
	2566 [label="现在我很好奇。",shape=box,color=red];
		2566 -> 2569;
	2567 [label="当然，尽管问。",shape=box,color=red];
		2567 -> 2570;
	2568 [label="我没心情。[结束。]",shape=box,color=red];
		2568 -> 2571;
	2569 [label="+5 Chemistry",color=orange];
		2569 -> 2572;
	2570 [label="这个问题很简单，但意义深远：你是否相信每个人都值得被爱？",shape=box,color=blue];
		2570 -> 2573;
	2571 [label="真可惜。",shape=box,color=blue];
		2571 -> 2574;
	2572 [label="很好！这个问题很简单，但意义深远：你是否相信每个人都值得被爱？",shape=box,color=blue];
		2572 -> 2573;
	2573 [label="Evaluate expressions",color=orange];
		2573 -> 2575 [label="RoatheMargulis1",color=purple];
		2573 -> 2578 [label="RoatheMargulis1",color=purple];
		2573 -> 2579 [label="RoatheMargulis1",color=purple];
		2573 -> 2576 [label="RoatheUnloved1",color=purple];
		2573 -> 2578 [label="RoatheUnloved1",color=purple];
		2573 -> 2579 [label="RoatheUnloved1",color=purple];
		2573 -> 2577 [label="RoatheExecutor1",color=purple];
		2573 -> 2577 [label="RoatheTraitor1",color=purple];
		2573 -> 2578 [label="RoatheTraitor1",color=purple];
		2573 -> 2579 [label="RoatheTraitor1",color=purple];
		2573 -> 2578 [label="false",color=purple];
		2573 -> 2579 [label="false",color=purple];
		2573 -> 2580 [label="false",color=purple];
	2574 [label="Chat ends.",color=orange];
	2575 [label="你跟我讲了 Ballas 和 Margulis 的故事之后，却问我这个问题，还说这不是在说他？",shape=box,color=red];
		2575 -> 2581;
	2578 [label="阿尔布雷希特对你做了那样的事，再加上你那些“奥罗金人能否得到救赎”的话题，还说这不是在说他？",shape=box,color=red];
		2578 -> 2581;
	2579 [label="好吧，我就配合一下。我是否相信“每个人都值得被爱”？这显然是一个关于道德和价值观的问题。",shape=box,color=red];
		2579 -> 2582;
	2576 [label="这个​告诉​我​他​从​未​体验​过​爱情​的​奥罗金人​居然问​了​我​这个​问题，​还说这不是在说他？​",shape=box,color=red];
		2576 -> 2581;
	2577 [label="这个​曾​做​过​执行者​的​男宠，​后来​却​密谋背叛​她​的​奥罗金人​居然问​我​这个​问题，还说这不是在说他？​",shape=box,color=red];
		2577 -> 2581;
	2580 [label="你真以为我会相信这只是个哲学问题吗？",shape=box,color=red];
		2580 -> 2581;
	2581 [label="我不想纠缠于细节。那样会把整件事拖入琐碎的争论中。“你看，这个人做了这个，那个人做了那个，这就否定了这个，”然后我们所有人都会在这个小小的争论圈子里站在被告席上。",shape=box,color=blue];
		2581 -> 2583;
		2581 -> 2584;
	2582 [label="+5 Chemistry",color=orange];
		2582 -> 2585;
	2583 [label="要么直说，要么就别说。如果你不打算告诉我这个问题到底是关于谁的，那我就不会浪费时间跟你谈。",shape=box,color=red];
		2583 -> 2586;
	2584 [label="好吧，咱们来玩你这套小游戏。",shape=box,color=red];
		2584 -> 2587;
	2585 [label="谢谢！把名字去掉，就更容易让人接受了。不然你会纠结于细节，我们就什么也谈不上了。",shape=box,color=blue];
		2585 -> 2588;
	2586 [label="我也不会让你得逞，就这么简单。",shape=box,color=blue];
		2586 -> 2589;
	2587 [label="很好。问题正如我所说：每个人都值得被爱吗？",shape=box,color=blue];
		2587 -> 2590;
	2588 [label="没错，正是如此。没有人质疑正义的英雄是否值得爱与被爱。在我们的伟大寓言故事中，这个问题从未被摆上台面讨论，不是吗？",shape=box,color=blue];
		2588 -> 2591;
	2589 [label="Update boolean RoatheNoDate",color=orange];
		2589 -> 2592;
	2590 [label="没有人质疑正义的英雄是否值得爱与被爱。在我们的伟大寓言故事中，这个问题从未被摆上台面讨论，不是吗？",shape=box,color=blue];
		2590 -> 2591;
	2591 [label="除了坏人。反派。怪物。道德沦丧的世界毁灭者。",shape=box,color=blue];
		2591 -> 2593;
		2591 -> 2594;
	2592 [label="Chat ends.",color=orange];
	2593 [label="[让他继续]",shape=box,color=red];
		2593 -> 2595;
	2594 [label="恶魔？",shape=box,color=red];
		2594 -> 2596;
	2595 [label="Add 1 to Thermostat",color=orange];
		2595 -> 2597;
	2596 [label="篡位者，配合一下。",shape=box,color=blue];
		2596 -> 2598;
	2597 [label="我提出以下观点：这些生物之所以在道德上被排斥，唯一的原因是它们有其他生物可以借此在道德上排斥它们。",shape=box,color=blue];
		2597 -> 2599;
	2598 [label="Add -1 to Thermostat",color=orange];
		2598 -> 2600;
		2598 -> 2601;
	2599 [label="如果一个人在与世隔绝的环境中，作为一个孤立无援的人，没有任何其他人在周围评判他，那么就不会有人评判他是邪恶的，对吧？",shape=box,color=blue];
		2599 -> 2602;
	2600 [label="我是说……",shape=box,color=red];
		2600 -> 2603;
	2601 [label="抱歉。",shape=box,color=red];
		2601 -> 2603;
	2602 [label="如果一个混蛋烧毁了一片森林，周围却没有人听到，那这事能算数吗？我们评判“善”与“恶”的唯一标准，就是他人的行为。",shape=box,color=blue];
		2602 -> 2604;
		2602 -> 2605;
		2602 -> 2606;
	2603 [label="好吧，既然你坚持要提，那就是说恶魔吧！万恶之源！",shape=box,color=blue];
		2603 -> 2597;
	2604 [label="有些行为本身就是纯粹的邪恶。",shape=box,color=red];
		2604 -> 2607;
	2605 [label="你的意思是说，一个人需要另一个人才能“作恶”？",shape=box,color=red];
		2605 -> 2608;
	2606 [label="我不太确定我是否同意这种说法。",shape=box,color=red];
		2606 -> 2607;
	2607 [label="一个人所能犯下的所有最骇人听闻的罪行，至少都需要另一个人来成立。一个人，孤立地待着，是做不出任何值得谴责的事的。毁灭一颗无人居住的星球？哦，真是可怕呢。",shape=box,color=blue];
		2607 -> 2609;
	2608 [label="没错。想想看。一个人所能犯下的所有最骇人听闻的罪行，至少都需要另一个人来成立。一个人，孤立地待着，是做不出任何值得谴责的事的。毁灭一颗无人居住的星球？哦，真是可怕呢。",shape=box,color=blue];
		2608 -> 2609;
	2609 [label="然而，如果没有社会对他们指手画脚，说“你不应该做那样可怕的事情”，我们又怎能知道那件事有多么骇人听闻呢？我们根本不会知道。",shape=box,color=blue];
		2609 -> 2610;
	2610 [label="正如我所说，它只不过是社会用来衡量你和他人行为的标尺而已。",shape=box,color=blue];
		2610 -> 2611;
		2610 -> 2612;
	2611 [label="假设你是对的。假设你说服了我，善恶只是……社会建构。那又会怎样？",shape=box,color=red];
		2611 -> 2613;
	2612 [label="我认为行为本身可以脱离其社会背景而具有善恶之分。否则，为什么在截然不同的社会中，许多行为会如此相似呢？",shape=box,color=red];
		2612 -> 2614;
	2613 [label="Add -1 to Thermostat",color=orange];
		2613 -> 2615;
	2614 [label="Add 1 to Thermostat",color=orange];
		2614 -> 2616;
		2614 -> 2617;
	2615 [label="+5 Chemistry",color=orange];
		2615 -> 2618;
	2616 [label="但为了方便讨论，我们继续下去。 ",shape=box,color=red];
		2616 -> 2615;
	2617 [label="我们最好就此打住。我觉得这个话题不会有好结果。[结束]",shape=box,color=red];
		2617 -> 2619;
	2618 [label="很好。如果我们说“邪恶”不是一种存在状态，而是一种社会建构，那么我们就可以认同，所有关于大恶人的故事，反过来也都是社会建构，都是寓言故事。",shape=box,color=blue];
		2618 -> 2620;
	2619 [label="如你所愿。",shape=box,color=blue];
		2619 -> 2621;
	2620 [label="那么，为什么在所有伟大的寓言故事中，那些犯下滔天罪行的人最终都被遗弃，独自腐烂呢？",shape=box,color=blue];
		2620 -> 2622;
		2620 -> 2623;
		2620 -> 2624;
		2620 -> 2625;
	2621 [label="Chat ends.",color=orange];
	2622 [label="因为他们不具备爱的能力？",shape=box,color=red];
		2622 -> 2626;
	2623 [label="因为他们的心中没有爱的位置？",shape=box,color=red];
		2623 -> 2627;
	2624 [label="因为他们不值得被爱？",shape=box,color=red];
		2624 -> 2628;
	2625 [label="因为我们想给他们一个教训？",shape=box,color=red];
		2625 -> 2629;
	2626 [label="有时候，他们确实被描绘成某种非人般的邪恶，不具备爱的能力。但为什么呢？我认为所有伟大的寓言故事都是为了传授某种教训，不是吗？",shape=box,color=blue];
		2626 -> 2630;
	2627 [label="有时候，他们的确会表现得过于专注于自己的罪恶，以至于无暇顾及这些所谓的“琐事”。但这是为什么呢？所有伟大的寓言故事都是为了传授教训，不是吗？",shape=box,color=blue];
		2627 -> 2630;
	2628 [label="嗯，你现在只不过是在鹦鹉学舌地重复我的话，篡位者。我们已经决定了“值得”是相对的。想想吧。所有伟大的寓言故事都是为了传授教训，不是吗？",shape=box,color=blue];
		2628 -> 2630;
	2629 [label="+5 Chemistry",color=orange];
		2629 -> 2631;
	2630 [label="如果我们展现一个邪恶之人过着和平、幸福、美好的爱情生活……那么……这会给我们带来什么样的教训呢？",shape=box,color=blue];
		2630 -> 2632;
		2630 -> 2633;
		2630 -> 2634;
	2631 [label="我的理论正是如此！所有伟大的寓言故事都是为了传授人生道理，不是吗？",shape=box,color=blue];
		2631 -> 2630;
	2632 [label="很难理解一个人既是“邪恶的”，又是有爱的。",shape=box,color=red];
		2632 -> 2635;
	2633 [label="或许他们的“恶行”仍然可以通过爱来救赎？",shape=box,color=red];
		2633 -> 2636;
	2634 [label="那些做了“坏事”的人，对世界上其他人来说仍然可能具有价值，因此他们并非“纯粹的恶人”？",shape=box,color=red];
		2634 -> 2637;
	2635 [label="Check boolean RoatheMargulis1",color=orange];
		2635 -> 2638 [label=true,color=green];
		2635 -> 2639 [label=false,color=brown];
	2636 [label="Add 1 to Thermostat",color=orange];
		2636 -> 2640;
	2637 [label="Add -1 to Thermostat",color=orange];
		2637 -> 2641;
	2638 [label="+5 Chemistry",color=orange];
		2638 -> 2642;
	2639 [label="+5 Chemistry",color=orange];
		2639 -> 2643;
	2640 [label="你听起来像个狂热分子。“救赎。”但你正在叩响真理之门。因为你的意思是，爱与恶在我们的世界里无法同时存在，而这不正是事实吗？爱与恶不能在社会中共存。",shape=box,color=blue];
		2640 -> 2644;
	2641 [label="你已经很接近答案了，但还差一点。是的，但请更进一步思考。如果一个作恶多端的人仍然被他人所爱，这意味着什么？这会对社会造成什么影响？",shape=box,color=blue];
		2641 -> 2644;
	2642 [label="没错！这两件事在我们脑海里是无法共存的，对吧？当我给你讲 Ballas 和 Margulis 的故事时，你很难相信他们曾经真心相爱，对吧？",shape=box,color=blue];
		2642 -> 2645;
	2643 [label="没错！这两件事在我们脑海里根本无法共存，对吧？如果我告诉你， Ballas 和 Margulis 在一切变质之前曾经非常相爱，你会相信吗？",shape=box,color=blue];
		2643 -> 2645;
	2644 [label="Check boolean RoatheMargulis1",color=orange];
		2644 -> 2646 [label=true,color=green];
		2644 -> 2647 [label=false,color=brown];
	2645 [label="不去深入探讨细节，也不偏离我一贯坚持的纯粹哲学原则——他们是我们两人的共同参照点。",shape=box,color=blue];
		2645 -> 2648;
	2646 [label="当我跟你讲 Ballas 和 Margulis 的故事时，你很难相信他们曾经真的相爱，对吧？",shape=box,color=blue];
		2646 -> 2645;
	2647 [label="如果我告诉你，Ballas 和 Margulis 在一切变糟之前曾经非常相爱，你会相信我吗？",shape=box,color=blue];
		2647 -> 2645;
	2648 [label="毫无疑问，Ballas 能够做出人类历史上最纯粹、最残忍的事情。然而，他也懂得爱。相互的爱。 ",shape=box,color=blue];
		2648 -> 2649;
	2649 [label="这是事实，虽然你现在可能想否认，但 Ballas 和 Margulis 曾经深爱着彼此。只是结局非常糟糕。",shape=box,color=blue];
		2649 -> 2650;
	2650 [label="Update boolean RoatheMargulis1",color=orange];
		2650 -> 2651;
	2651 [label="但我们必须彻底抹去他们爱情故事中的痕迹。我们必须说它根本不存在。我们必须说它不是真的，那只是个谎言。为什么？",shape=box,color=blue];
		2651 -> 2652;
		2651 -> 2653;
		2651 -> 2654;
	2652 [label="我不知道。",shape=box,color=red];
		2652 -> 2655;
	2653 [label="因为爱是人类最深沉的情感，如果我们允许自己认为某人可以被爱，那就赋予了他们人性。",shape=box,color=red];
		2653 -> 2656;
	2654 [label="因为邪恶必须反省自身，努力改过自新。它必须受到惩罚。而爱与被爱，是最终的奖赏。",shape=box,color=red];
		2654 -> 2657;
	2655 [label="我说了这么多，全都白费了。真丢人。",shape=box,color=blue];
		2655 -> 2658;
	2656 [label="Add -2 to Thermostat",color=orange];
		2656 -> 2659;
	2657 [label="Add 2 to Thermostat",color=orange];
		2657 -> 2660;
	2658 [label="Chat ends.",color=orange];
	2659 [label="很好，篡位者。很好。正是如此。邪恶之源必须永远是“他者”，我们绝不能同情他。如果我们允许他感受爱，允许他被爱呢？我想整个世界都会在我们周围崩塌。",shape=box,color=blue];
		2659 -> 2661;
	2660 [label="很好，篡位者。很好。正是如此。我们必须追究邪恶之人的责任。如果我们允许他感受爱，并被爱呢？我想整个世界都会在我们周围崩塌。",shape=box,color=blue];
		2660 -> 2661;
	2661 [label="Update boolean RoatheUnloved3",color=orange];
		2661 -> 2662;
	2662 [label="那么，​我们​又​会​变成​什么样​呢？​",shape=box,color=blue];
		2662 -> 2663;
	2663 [label="Chat ends.",color=orange];
}