		j821815412 -> j1057466318 [label="false",color=purple];
	"Chat ends." [color=orange];
	j2940541252 [label="你跟我讲了 Ballas 和 Margulis 的故事之后，却问我这个问题，还说这不是在说他？",shape=box,color=red];
		j2940541252 -> j984600773;
	j112959259 [label="阿尔布雷希特对你做了那样的事，再加上你那些“奥罗金人能否得到救赎”的话题，还说这不是在说他？",shape=box,color=red];
		j112959259 -> j984600773;
	j2632076260 [label="好吧，我就配合一下。我是否相信“每个人都值得被爱”？这显然是一个关于道德和价值观的问题。",shape=box,color=red];
		j2632076260 -> j3265008083;
	j3930906595 [label="这个​告诉​我​他​从​未​体验​过​爱情​的​奥罗金人​居然问​了​我​这个​问题，​还说这不是在说他？​",shape=box,color=red];
		j3930906595 -> j984600773;
	j3530486965 [label="这个​曾​做​过​执行者​的​男宠，​后来​却​密谋背叛​她​的​奥罗金人​居然问​我​这个​问题，还说这不是在说他？​",shape=box,color=red];
		j3530486965 -> j984600773;
	j1057466318 [label="你真以为我会相信这只是个哲学问题吗？",shape=box,color=red];
		j1057466318 -> j984600773;
	j984600773 [label="我不想纠缠于细节。那样会把整件事拖入琐碎的争论中。“你看，这个人做了这个，那个人做了那个，这就否定了这个，”然后我们所有人都会在这个小小的争论圈子里站在被告席上。",shape=box,color=blue];
		j984600773 -> j477170897;
		j984600773 -> j4268423158;
	j3265008083 [label="+5 Chemistry",color=orange];
		j3265008083 -> j1283233758;
	j477170897 [label="要么直说，要么就别说。如果你不打算告诉我这个问题到底是关于谁的，那我就不会浪费时间跟你谈。",shape=box,color=red];
		j477170897 -> j3794207683;
	j4268423158 [label="好吧，咱们来玩你这套小游戏。",shape=box,color=red];
		j4268423158 -> j115286033;
	j1283233758 [label="谢谢！把名字去掉，就更容易让人接受了。不然你会纠结于细节，我们就什么也谈不上了。",shape=box,color=blue];
		j1283233758 -> j3874797066;
	j3794207683 [label="我也不会让你得逞，就这么简单。",shape=box,color=blue];
		j3794207683 -> j155006797;
	j115286033 [label="很好。问题正如我所说：每个人都值得被爱吗？",shape=box,color=blue];
		j115286033 -> j1054195616;
	j3874797066 [label="没错，正是如此。没有人质疑正义的英雄是否值得爱与被爱。在我们的伟大寓言故事中，这个问题从未被摆上台面讨论，不是吗？",shape=box,color=blue];
		j3874797066 -> j3750026474;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j1054195616 [label="没有人质疑正义的英雄是否值得爱与被爱。在我们的伟大寓言故事中，这个问题从未被摆上台面讨论，不是吗？",shape=box,color=blue];
		j1054195616 -> j3750026474;
	j3750026474 [label="除了坏人。反派。怪物。道德沦丧的世界毁灭者。",shape=box,color=blue];
		j3750026474 -> j152309989;
		j3750026474 -> j4257350421;
	j152309989 [label="[让他继续]",shape=box,color=red];
		j152309989 -> j2008424499;
	j4257350421 [label="恶魔？",shape=box,color=red];
		j4257350421 -> j3972838277;
	j2008424499 [label="Add 1 to Thermostat counter",color=orange];
		j2008424499 -> j2707030710;
	j3972838277 [label="篡位者，配合一下。",shape=box,color=blue];
		j3972838277 -> j1817221348;
	j2707030710 [label="我提出以下观点：这些生物之所以在道德上被排斥，唯一的原因是它们有其他生物可以借此在道德上排斥它们。",shape=box,color=blue];
		j2707030710 -> j4194759790;
	j1817221348 [label="Add -1 to Thermostat counter",color=orange];
		j1817221348 -> j3636333481;
		j1817221348 -> j3212082773;
	j4194759790 [label="如果一个人在与世隔绝的环境中，作为一个孤立无援的人，没有任何其他人在周围评判他，那么就不会有人评判他是邪恶的，对吧？",shape=box,color=blue];
		j4194759790 -> j4084234850;
	j3636333481 [label="我是说……",shape=box,color=red];
		j3636333481 -> j1312839004;
	j3212082773 [label="抱歉。",shape=box,color=red];
		j3212082773 -> j1312839004;
	j4084234850 [label="如果一个混蛋烧毁了一片森林，周围却没有人听到，那这事能算数吗？我们评判“善”与“恶”的唯一标准，就是他人的行为。",shape=box,color=blue];
		j4084234850 -> j1472187582;
		j4084234850 -> j2095478853;
		j4084234850 -> j2769737172;
	j1312839004 [label="好吧，既然你坚持要提，那就是说恶魔吧！万恶之源！",shape=box,color=blue];
		j1312839004 -> j2707030710;
	j1472187582 [label="有些行为本身就是纯粹的邪恶。",shape=box,color=red];
		j1472187582 -> j846101521;
	j2095478853 [label="你的意思是说，一个人需要另一个人才能“作恶”？",shape=box,color=red];
		j2095478853 -> j4056725981;
	j2769737172 [label="我不太确定我是否同意这种说法。",shape=box,color=red];
		j2769737172 -> j846101521;
	j846101521 [label="一个人所能犯下的所有最骇人听闻的罪行，至少都需要另一个人来成立。一个人，孤立地待着，是做不出任何值得谴责的事的。毁灭一颗无人居住的星球？哦，真是可怕呢。",shape=box,color=blue];
		j846101521 -> j2912496032;
	j4056725981 [label="没错。想想看。一个人所能犯下的所有最骇人听闻的罪行，至少都需要另一个人来成立。一个人，孤立地待着，是做不出任何值得谴责的事的。毁灭一颗无人居住的星球？哦，真是可怕呢。",shape=box,color=blue];
		j4056725981 -> j2912496032;
	j2912496032 [label="然而，如果没有社会对他们指手画脚，说“你不应该做那样可怕的事情”，我们又怎能知道那件事有多么骇人听闻呢？我们根本不会知道。",shape=box,color=blue];
		j2912496032 -> j1688148231;
	j1688148231 [label="正如我所说，它只不过是社会用来衡量你和他人行为的标尺而已。",shape=box,color=blue];
		j1688148231 -> j1126304797;
		j1688148231 -> j2978042854;
	j1126304797 [label="假设你是对的。假设你说服了我，善恶只是……社会建构。那又会怎样？",shape=box,color=red];
		j1126304797 -> j1200598189;
	j2978042854 [label="我认为行为本身可以脱离其社会背景而具有善恶之分。否则，为什么在截然不同的社会中，许多行为会如此相似呢？",shape=box,color=red];
		j2978042854 -> j597069442;
	j1200598189 [label="Add -1 to Thermostat counter",color=orange];
		j1200598189 -> j729853341;
	j597069442 [label="Add 1 to Thermostat counter",color=orange];
		j597069442 -> j591767072;
		j597069442 -> j12625762;
	j729853341 [label="+5 Chemistry",color=orange];
		j729853341 -> j727721391;
	j591767072 [label="但为了方便讨论，我们继续下去。 ",shape=box,color=red];
		j591767072 -> j729853341;
	j12625762 [label="我们最好就此打住。我觉得这个话题不会有好结果。[结束]",shape=box,color=red];
		j12625762 -> j2599300993;
	j727721391 [label="很好。如果我们说“邪恶”不是一种存在状态，而是一种社会建构，那么我们就可以认同，所有关于大恶人的故事，反过来也都是社会建构，都是寓言故事。",shape=box,color=blue];
		j727721391 -> j785368607;
	j2599300993 [label="如你所愿。",shape=box,color=blue];
		j2599300993 -> "Chat ends.";
	j785368607 [label="那么，为什么在所有伟大的寓言故事中，那些犯下滔天罪行的人最终都被遗弃，独自腐烂呢？",shape=box,color=blue];
		j785368607 -> j20823626;
		j785368607 -> j1180424225;
		j785368607 -> j2930208190;
		j785368607 -> j2958207218;
	j20823626 [label="因为他们不具备爱的能力？",shape=box,color=red];
		j20823626 -> j1642528736;
	j1180424225 [label="因为他们的心中没有爱的位置？",shape=box,color=red];
		j1180424225 -> j3166707150;
	j2930208190 [label="因为他们不值得被爱？",shape=box,color=red];
		j2930208190 -> j3613073864;
	j2958207218 [label="因为我们想给他们一个教训？",shape=box,color=red];
		j2958207218 -> j3205687372;
	j1642528736 [label="有时候，他们确实被描绘成某种非人般的邪恶，不具备爱的能力。但为什么呢？我认为所有伟大的寓言故事都是为了传授某种教训，不是吗？",shape=box,color=blue];
		j1642528736 -> j4245557932;
	j3166707150 [label="有时候，他们的确会表现得过于专注于自己的罪恶，以至于无暇顾及这些所谓的“琐事”。但这是为什么呢？所有伟大的寓言故事都是为了传授教训，不是吗？",shape=box,color=blue];
		j3166707150 -> j4245557932;
	j3613073864 [label="嗯，你现在只不过是在鹦鹉学舌地重复我的话，篡位者。我们已经决定了“值得”是相对的。想想吧。所有伟大的寓言故事都是为了传授教训，不是吗？",shape=box,color=blue];
		j3613073864 -> j4245557932;
	j3205687372 [label="+5 Chemistry",color=orange];
		j3205687372 -> j3417531755;
	j4245557932 [label="如果我们展现一个邪恶之人过着和平、幸福、美好的爱情生活……那么……这会给我们带来什么样的教训呢？",shape=box,color=blue];
		j4245557932 -> j219001710;
		j4245557932 -> j749871463;
		j4245557932 -> j3440767919;
	j3417531755 [label="我的理论正是如此！所有伟大的寓言故事都是为了传授人生道理，不是吗？",shape=box,color=blue];
		j3417531755 -> j4245557932;
	j219001710 [label="很难理解一个人既是“邪恶的”，又是有爱的。",shape=box,color=red];
		j219001710 -> j362925635;
	j749871463 [label="或许他们的“恶行”仍然可以通过爱来救赎？",shape=box,color=red];
		j749871463 -> j2748441242;
	j3440767919 [label="那些做了“坏事”的人，对世界上其他人来说仍然可能具有价值，因此他们并非“纯粹的恶人”？",shape=box,color=red];
		j3440767919 -> j1471609370;
	j362925635 [label="Check boolean RoatheMargulis1",color=orange];
		j362925635 -> j1505763845 [label=true,color=green];
		j362925635 -> j1205209444 [label=false,color=brown];
	j2748441242 [label="Add 1 to Thermostat counter",color=orange];
		j2748441242 -> j210927850;
	j1471609370 [label="Add -1 to Thermostat counter",color=orange];
		j1471609370 -> j1120766760;
	j1505763845 [label="+5 Chemistry",color=orange];
		j1505763845 -> j1307126011;
	j1205209444 [label="+5 Chemistry",color=orange];
		j1205209444 -> j1452125888;
	j210927850 [label="你听起来像个狂热分子。“救赎。”但你正在叩响真理之门。因为你的意思是，爱与恶在我们的世界里无法同时存在，而这不正是事实吗？爱与恶不能在社会中共存。",shape=box,color=blue];
		j210927850 -> j603738447;
	j1120766760 [label="你已经很接近答案了，但还差一点。是的，但请更进一步思考。如果一个作恶多端的人仍然被他人所爱，这意味着什么？这会对社会造成什么影响？",shape=box,color=blue];
		j1120766760 -> j603738447;
	j1307126011 [label="没错！这两件事在我们脑海里是无法共存的，对吧？当我给你讲 Ballas 和 Margulis 的故事时，你很难相信他们曾经真心相爱，对吧？",shape=box,color=blue];
		j1307126011 -> j1590528419;
	j1452125888 [label="没错！这两件事在我们脑海里根本无法共存，对吧？如果我告诉你， Ballas 和 Margulis 在一切变质之前曾经非常相爱，你会相信吗？",shape=box,color=blue];
		j1452125888 -> j1590528419;
	j603738447 [label="Check boolean RoatheMargulis1",color=orange];
		j603738447 -> j3276273459 [label=true,color=green];
		j603738447 -> j1318496763 [label=false,color=brown];
	j1590528419 [label="不去深入探讨细节，也不偏离我一贯坚持的纯粹哲学原则——他们是我们两人的共同参照点。",shape=box,color=blue];
		j1590528419 -> j2715054719;
	j3276273459 [label="当我跟你讲 Ballas 和 Margulis 的故事时，你很难相信他们曾经真的相爱，对吧？",shape=box,color=blue];
		j3276273459 -> j1590528419;
	j1318496763 [label="如果我告诉你，Ballas 和 Margulis 在一切变糟之前曾经非常相爱，你会相信我吗？",shape=box,color=blue];
		j1318496763 -> j1590528419;
	j2715054719 [label="毫无疑问，Ballas 能够做出人类历史上最纯粹、最残忍的事情。然而，他也懂得爱。相互的爱。 ",shape=box,color=blue];
		j2715054719 -> j4293317810;
	j4293317810 [label="这是事实，虽然你现在可能想否认，但 Ballas 和 Margulis 曾经深爱着彼此。只是结局非常糟糕。",shape=box,color=blue];
		j4293317810 -> j3687052647;
	j3687052647 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j3687052647 -> j3625655879;
	j3625655879 [label="但我们必须彻底抹去他们爱情故事中的痕迹。我们必须说它根本不存在。我们必须说它不是真的，那只是个谎言。为什么？",shape=box,color=blue];
		j3625655879 -> j2863326750;
		j3625655879 -> j2205522142;
		j3625655879 -> j765276272;
	j2863326750 [label="我不知道。",shape=box,color=red];
		j2863326750 -> j4158902546;
	j2205522142 [label="因为爱是人类最深沉的情感，如果我们允许自己认为某人可以被爱，那就赋予了他们人性。",shape=box,color=red];
		j2205522142 -> j809488021;
	j765276272 [label="因为邪恶必须反省自身，努力改过自新。它必须受到惩罚。而爱与被爱，是最终的奖赏。",shape=box,color=red];
		j765276272 -> j2950861784;
	j4158902546 [label="我说了这么多，全都白费了。真丢人。",shape=box,color=blue];
		j4158902546 -> "Chat ends.";
	j809488021 [label="Add -2 to Thermostat counter",color=orange];
		j809488021 -> j2735653882;
	j2950861784 [label="Add 2 to Thermostat counter",color=orange];
		j2950861784 -> j2000781379;
	j2735653882 [label="很好，篡位者。很好。正是如此。邪恶之源必须永远是“他者”，我们绝不能同情他。如果我们允许他感受爱，允许他被爱呢？我想整个世界都会在我们周围崩塌。",shape=box,color=blue];
		j2735653882 -> j4147733658;
	j2000781379 [label="很好，篡位者。很好。正是如此。我们必须追究邪恶之人的责任。如果我们允许他感受爱，并被爱呢？我想整个世界都会在我们周围崩塌。",shape=box,color=blue];
		j2000781379 -> j4147733658;
	j4147733658 [label="Boolean RoatheUnloved3 is now true.",color=orange];
		j4147733658 -> j3590845661;
	j3590845661 [label="那么，​我们​又​会​变成​什么样​呢？​",shape=box,color=blue];
		j3590845661 -> "Chat ends.";
}