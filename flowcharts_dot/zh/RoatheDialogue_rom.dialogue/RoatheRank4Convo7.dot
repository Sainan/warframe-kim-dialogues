	j3890918994 [label="你以为我会在乎吗？！那两个狂热分子根本不会察觉。就像鱼缸里的傻鱼一样（无意冒犯斐波那契），他们会继续浑然不觉地快乐生活。",shape=box,color=blue];
		j3890918994 -> j1722253115;
	j1722253115 [label="篡位者，可怕的事情正在等着我。山顶之上，我将领悟到某种可怕的真相。我能感觉到它像暴风雨前的乌云一样在我脑海中聚集。我能看到地平线上那病态的黄色光芒。",shape=box,color=blue];
