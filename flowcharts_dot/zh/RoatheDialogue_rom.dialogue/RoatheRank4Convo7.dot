		j1217747977 -> j3944775277;
	j3326130779 [label="我明白了！这难道不是典型的套路吗？！因为残忍而被嘲笑，因为是“恶魔”而被讥讽，因为是奥罗金人而被囚禁和谴责。但当我表现得“友善”时，却成了被怀疑的理由？！",shape=box,color=blue];
