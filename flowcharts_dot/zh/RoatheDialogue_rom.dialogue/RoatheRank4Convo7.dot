		j3821076670 -> j4085938328 [label=true,color=green];
		j3821076670 -> j2757532102 [label=false,color=brown];
	j708501251 [label="篡位者，我很高兴地告诉你，你在深溯池中的工作已经完成，你可以停止挖掘我的记忆了。",shape=box,color=blue];
		j708501251 -> j3968379408;
	j1953530187 [label="篡位者，虽然在深溯池中恢复我的记忆还剩一些工作，但我很高兴地宣布，我认为我已经彻底结束了这该死的整个事情。",shape=box,color=blue];
		j1953530187 -> j3968379408;
	j1910335318 [label="篡位者，虽然你确实……一事无成，在深溯池那里没有开始任何工作，但我很高兴地宣布，我认为我已经彻底结束了这该死的整个事件。",shape=box,color=blue];
		j1910335318 -> j2577300783;
	j1705495754 [label="虽然你可能认为对于发生的一切，我应该向你表示感谢和道歉，但我要求你抹去我的记忆并重新开始，我认为这只是让我们“扯平”了我因此遭受的所有痛苦。",shape=box,color=blue];
		j1705495754 -> j726345943;
		j1705495754 -> j2566947183;
	j1278927241 [label="感觉好空虚，整天都在记忆的尾巴。我想只有你才能体会。好吧，让我们坚持下去，好吗？",shape=box,color=blue];
		j1278927241 -> j726345943;
		j1278927241 -> j1087553052;
	j4085938328 [label="篡位者，我有一个难以启齿的请求。这个请求绝非我乐意之举。我知道你至少对我有所求，也希望你心中对我留有一丝好感……",shape=box,color=blue];
		j4085938328 -> j4149487381;
		j4085938328 -> j268376679;
		j4085938328 -> j794743085;
	j2757532102 [label="篡位者，我有一个难以启齿的请求，一个我并不乐意提出的请求。但首先，我想问……我们成了朋友吗？你心中是否对我产生了一丝好感？",shape=box,color=blue];
		j2757532102 -> j3411195797;
		j2757532102 -> j3934760510;
		j2757532102 -> j2189211859;
	j3968379408 [label="我们可以停止在我脑海里喋喋不休，让大家都经历这种虚构的折磨了吗？（即使那位神父确实乐在其中。）",shape=box,color=blue];
		j3968379408 -> j776905815;
	j2577300783 [label="你现在可以把这件事忘得一干二净了。我相信你今天肯定有比这种虚构的鞭笞更有意义的事情要做，对吧？（即使那位神父真的喜欢这种事。）",shape=box,color=blue];
		j2577300783 -> j3077456970;
	j726345943 [label="我们会渡过这一关的。 ",shape=box,color=red];
		j726345943 -> j2508391059;
	j2566947183 [label="罗瑟，我只是因为你要求我这么做才这么做的。你警告过我你会生气。 ",shape=box,color=red];
		j2566947183 -> j3722308722;
	j1087553052 [label="正如你所说，我们快要到找到了。",shape=box,color=red];
		j1087553052 -> j591892796;
	j4149487381 [label="罗瑟，我在乎你。至于我是否应该在乎你，那就见仁见智了。",shape=box,color=red];
		j4149487381 -> j1152877307;
	j268376679 [label="在​更​了解​你​之后，​我​改变​了​之前​所有​的​想法。​我​无法​忍​受​你。​",shape=box,color=red];
		j268376679 -> j3373083040;
	j794743085 [label="罗瑟，我非常在乎你。真的，我是认真的。我不确定自己是否应该这样，但是……我想我爱上你了。",shape=box,color=red];
		j794743085 -> j1305416782;
	j3411195797 [label="不仅限于此。[表白心意]",shape=box,color=red];
		j3411195797 -> j2142790369;
	j3934760510 [label="我希望我们是朋友。至少在我看来是这样。",shape=box,color=red];
		j3934760510 -> j2957971875;
	j2189211859 [label="罗瑟，老实说？我真受不了你。",shape=box,color=red];
		j2189211859 -> j63539835;
	j776905815 [label="事实上，我坚决要求我们这样做。",shape=box,color=blue];
