	j2508391059 [label="如果我们做不到，我想你应该有解决办法吧？好吧，明天又是新的一天，也许感觉就像昨天一样。",shape=box,color=blue];
		j2508391059 -> j298080266;
	j3722308722 [label="是的，我想我会那样做。而且我想我是对的。好吧，明天又是新的一天，也许感觉就像昨天一样。",shape=box,color=blue];
		j3722308722 -> j298080266;
	j591892796 [label="是的。随之而来的是一种难以承受的恐惧感。唉。明天又是新的一天，或许感觉就像昨天一样。",shape=box,color=blue];
		j591892796 -> j298080266;
