	j3891221223 [label="语音留言：谎言",shape=box,color=blue];
		j3891221223 -> j57579881;
	j57579881 [label="文字记录：我精通我们许多武器，但我最擅长的是这一种：谎言。",shape=box,color=blue];
		j57579881 -> j3900504681;
	j3900504681 [label="我最常用它来对付自己的部下。我用关于责任和纪律的谎言把他们鞭笞得筋疲力尽。",shape=box,color=blue];
		j3900504681 -> j2286142916;
	j2286142916 [label="我用战争可以取胜的谎言淹没了他们。我用对他们的宠爱和最崇高的敬意的谎言刺穿了他们。",shape=box,color=blue];
		j2286142916 -> j1546942134;
	j1546942134 [label="独自一人时，我私下里用这把武器刺向了自己。哦，我流了多少血啊。",shape=box,color=blue];
		j1546942134 -> j1648694156;
	j1648694156 [label="Add 1 to HellStory counter",color=orange];
		j1648694156 -> "Chat ends. Next chat will be RoatheStory16.";
	"Chat ends. Next chat will be RoatheStory16." [color=orange];
