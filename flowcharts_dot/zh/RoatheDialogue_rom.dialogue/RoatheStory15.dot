	2269 [label="文字记录：我精通我们许多武器，但我最擅长的是这一种：谎言。",shape=box,color=blue];
		2269 -> 5711;
	5711 [label="我最常用它来对付自己的部下。我用关于责任和纪律的谎言把他们鞭笞得筋疲力尽。",shape=box,color=blue];
		5711 -> 5712;
	5712 [label="我用战争可以取胜的谎言淹没了他们。我用对他们的宠爱和最崇高的敬意的谎言刺穿了他们。",shape=box,color=blue];
		5712 -> 2265;
