		1895 -> 1901;
		1895 -> 1902;
	1896 [label="真的吗？从我的角度来看，似乎确实如此。他打了个响指，你便像训练有素的库狛一样，乖乖地跪坐在他的脚踝旁。他甚至低声念出“Tau”这个名字，你们便开始拼命回忆失去的那个地方的每一个记忆。",shape=box,color=blue];
		1896 -> 1903;
		1896 -> 1904;
	1897 [label="真是神秘，难以捉摸！还是一派胡言。如果你不愿意承认自己对他言听计从，那就随你便吧。",shape=box,color=blue];
		1897 -> 1905;
	1898 [label="你为什么老是纠缠这个问题？你到底想问我什么？",shape=box,color=red];
