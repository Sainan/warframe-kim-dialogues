		1899 -> 1907;
	1900 [label="我一定会让他为造成的混乱付出代价。他有很多罪过需要弥补。 ",shape=box,color=red];
		1900 -> 1908;
	1901 [label="你是说，假设我能活下来的话？",shape=box,color=red];
		1901 -> 1909;
	1902 [label="哪里需要我，我就去哪里，就像我一直以来做的那样。麻烦总是会找上门来。",shape=box,color=red];
		1902 -> 1910;
	1903 [label="你为什么这么努力地想惹我生气？",shape=box,color=red];
		1903 -> 1911;
	1904 [label="我只是在做我该做的事，帮助人们摆脱他们所处的悲惨境地。",shape=box,color=red];
		1904 -> 1912;
	1905 [label="因为在我看来，他只要打了个响指，你便像训练有素的库狛一样，乖乖地跪坐在他的脚踝旁。他甚至低声念出“Tau”这个名字，你们便开始拼命回忆失去的那个地方的每一个记忆。",shape=box,color=blue];
		1905 -> 1903;
