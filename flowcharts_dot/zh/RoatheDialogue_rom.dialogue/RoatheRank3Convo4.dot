digraph {
	"RoatheRank3Convo4 begins." [color=orange];
		"RoatheRank3Convo4 begins." -> j3861032797;
	j3861032797 [label="篡位者，你能回答我一个问题吗？这个问题困扰我很久了。",shape=box,color=blue];
		j3861032797 -> j3602946874;
		j3861032797 -> j2066056739;
		j3861032797 -> j1038552372;
	j3602946874 [label="尽管问。 ",shape=box,color=red];
		j3602946874 -> j3218177850;
	j2066056739 [label="有什么会困扰到你吗？",shape=box,color=red];
		j2066056739 -> j1037776848;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j3218177850 [label="你为什么要做这一切？",shape=box,color=blue];
		j3218177850 -> j3524964328;
	j1037776848 [label="我可以一股脑儿地把所有问题都列出来，但这样的话我担心我们会在这儿待一下午。不，我今天的问题只针对一个特定主题。至少今天是这样。",shape=box,color=blue];
		j1037776848 -> j3218177850;
	"Chat ends." [color=orange];
	j3524964328 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3524964328 -> j2355071031 [label=true,color=green];
		j3524964328 -> j2768280751 [label=false,color=brown];
	j2355071031 [label="我说的不是你篡改我的记忆，我指的是更广义上的“这一切”。",shape=box,color=blue];
		j2355071031 -> j2768280751;
	j2768280751 [label="Check boolean LoidFamilyComplete",color=orange];
		j2768280751 -> j848203100 [label=true,color=green];
		j2768280751 -> j2306868094 [label=false,color=brown];
	j848203100 [label="你似乎铁了心要跟在阿尔布雷希特后面，拎着拖把桶到处跑。看看你跟他管家干的那些事儿。 ",shape=box,color=blue];
		j848203100 -> j2476974658;
	j2306868094 [label="你似乎铁了心要跟在阿尔布雷希特后面，拎着拖把桶到处跑。",shape=box,color=blue];
		j2306868094 -> j2476974658;
	j2476974658 [label="Check boolean IsDating",color=orange];
		j2476974658 -> j2138598451 [label=true,color=green];
		j2476974658 -> j1646443538 [label=false,color=brown];
	j2138598451 [label="看起来你这段时间也有自己的事情要忙——我对此表示赞赏，我绝无评判的意思。只是让我觉得奇怪的是，一个平时如此……无礼又无耻的人，竟然会在其他方面如此顺从。 ",shape=box,color=blue];
		j2138598451 -> j320489626;
		j2138598451 -> j3086563218;
		j2138598451 -> j1615104923;
	j1646443538 [label="只是让我觉得奇怪的是，一个平时如此……古怪又疯狂的人，竟然会在其他方面如此顺从。",shape=box,color=blue];
		j1646443538 -> j320489626;
		j1646443538 -> j3086563218;
		j1646443538 -> j1615104923;
	j320489626 [label="任由虚空无情之物摧毁始源星系——或者摧毁任何其他地方——对任何人都没有好处。",shape=box,color=red];
		j320489626 -> j2034994848;
	j3086563218 [label="我并不服从英择谛。",shape=box,color=red];
		j3086563218 -> j1536970152;
	j1615104923 [label="我有我自己的理由。而且这些理由我不会告诉任何人。",shape=box,color=red];
		j1615104923 -> j3471509126;
	j2034994848 [label="啊，我明白了。这只是你提供的临时服务，直到“虚空无情之物”问题得到解决为止。那么之后你打算怎么做呢？",shape=box,color=blue];
		j2034994848 -> j3907814702;
		j2034994848 -> j1448285584;
		j2034994848 -> j2822309071;
		j2034994848 -> j1424099781;
		j2034994848 -> j350498555;
	j1536970152 [label="真的吗？从我的角度来看，似乎确实如此。他打了个响指，你便像训练有素的库狛一样，乖乖地跪坐在他的脚踝旁。他甚至低声念出“Tau”这个名字，你们便开始拼命回忆失去的那个地方的每一个记忆。",shape=box,color=blue];
		j1536970152 -> j1483282634;
		j1536970152 -> j3555799221;
	j3471509126 [label="真是神秘，难以捉摸！还是一派胡言。如果你不愿意承认自己对他言听计从，那就随你便吧。",shape=box,color=blue];
		j3471509126 -> j779898785;
	j3907814702 [label="你为什么老是纠缠这个问题？你到底想问我什么？",shape=box,color=red];
		j3907814702 -> j76573472;
	j1448285584 [label="说实话，我真的还没考虑过那么远。",shape=box,color=red];
		j1448285584 -> j398508373;
	j2822309071 [label="我一定会让他为造成的混乱付出代价。他有很多罪过需要弥补。 ",shape=box,color=red];
		j2822309071 -> j2687958468;
	j1424099781 [label="你是说，假设我能活下来的话？",shape=box,color=red];
		j1424099781 -> j2422942395;
	j350498555 [label="哪里需要我，我就去哪里，就像我一直以来做的那样。麻烦总是会找上门来。",shape=box,color=red];
		j350498555 -> j1597256729;
	j1483282634 [label="你为什么这么努力地想惹我生气？",shape=box,color=red];
		j1483282634 -> j1098169873;
	j3555799221 [label="我只是在做我该做的事，帮助人们摆脱他们所处的悲惨境地。",shape=box,color=red];
		j3555799221 -> j1468846647;
	j779898785 [label="因为在我看来，他只要打了个响指，你便像训练有素的库狛一样，乖乖地跪坐在他的脚踝旁。他甚至低声念出“Tau”这个名字，你们便开始拼命回忆失去的那个地方的每一个记忆。",shape=box,color=blue];
		j779898785 -> j1483282634;
		j779898785 -> j3555799221;
	j76573472 [label="+5 Chemistry",color=orange];
		j76573472 -> j1727615570;
	j398508373 [label="啊！你居然承认自己是白痴！真是耳目一新。我最喜欢看傻瓜们毫不掩饰自己的愚蠢，这样我操纵他们就容易多了。",shape=box,color=blue];
		j398508373 -> j375249408;
	j2687958468 [label="啊！原来你追求的是卑劣、原始的复仇！太棒了。你就像一头狂暴的野兽，准备啃噬那些伤害过你的人的骨头。",shape=box,color=blue];
		j2687958468 -> j1714786514;
	j2422942395 [label="+5 Chemistry",color=orange];
		j2422942395 -> j2143124187;
	j1597256729 [label="啊，我明白了。虚伪的冷漠披着高贵的外衣。你不知道自己属于哪里，应该留在哪里，所以才用这层“正义的牺牲”来伪装自己，听命于人？",shape=box,color=blue];
		j1597256729 -> j2248745269;
	j1098169873 [label="因为​我​无论​如何​也​无法​理解，​你，​一​个​据​我​所​知来自​完全​另​一​个​现实​版本​的​实体，​为什么​执意​要​在​时间​和​空间​中​横​冲​直​撞，​“扮演心理​治疗师”。​",shape=box,color=blue];
		j1098169873 -> j522335593;
	j1468846647 [label="没错，这才是问题的关键！你为什么非要游荡在时空之中“扮演心理治疗师”呢？据我推测，你来自完全不同的现实版本， ",shape=box,color=blue];
		j1468846647 -> j522335593;
	j1727615570 [label="精明。好的，我会更直接地切入正题。我之前故意激怒你，只是想看看你能不能说出更诚实的话。",shape=box,color=blue];
		j1727615570 -> j2552347409;
	j375249408 [label="你就像一只终于抓到绝灵骥的库狛，现在你的牙齿咬住了它的腿，却不知道该怎么办。",shape=box,color=blue];
		j375249408 -> j3555799221;
		j375249408 -> j1483282634;
	j1714786514 [label="这是人类最简单、最古老的动机之一，因此也是最容易理解的动机之一。",shape=box,color=blue];
		j1714786514 -> j3555799221;
	j2143124187 [label="虽然你从未正式当过兵，但从你的语气中，我听出了身经百战的老兵的疲惫。",shape=box,color=blue];
		j2143124187 -> j102133235;
	j2248745269 [label="真是太可悲了。",shape=box,color=blue];
		j2248745269 -> j3515406544;
		j2248745269 -> j1374710996;
	j522335593 [label="如果我是你，我会回到双衍王境，尝试探索虚空结构中还有哪些漏洞可以突破！想想那该有多大的可能性！想想那些唾手可得的世界！",shape=box,color=blue];
		j522335593 -> j3598366346;
		j522335593 -> j2481117316;
	j2552347409 [label="但​我​想，​这样​也​够​了。​",shape=box,color=blue];
		j2552347409 -> j4188347574;
	j102133235 [label="好的。出于尊重，我会更直接地切入正题。我之前故意激怒你，只是想看看你能不能说出更诚实的话。",shape=box,color=blue];
		j102133235 -> j4188347574;
	j3515406544 [label="我有属于我的地方。",shape=box,color=red];
		j3515406544 -> j3152326481;
	j1374710996 [label="你根本不知道自己在说什么。",shape=box,color=red];
		j1374710996 -> j1295832584;
	j3598366346 [label="你和阿尔布雷希特没什么两样。他穿越时空，制造了这么多问题。而你竟然想对整个维度都这么做？！",shape=box,color=red];
		j3598366346 -> j3459936561;
	j2481117316 [label="这就是你们奥罗金人的问题所在。你以为整个世界都只是你的私有财产，你可以随心所欲地支配它们。 ",shape=box,color=red];
		j2481117316 -> j4002440162;
	j4188347574 [label="+5 Chemistry",color=orange];
		j4188347574 -> j2420175047;
	j3152326481 [label="那就告诉我！是这个霍瓦尼亚吗？还是双衍王境？又或者是你坠毁在地球残骸上的轨道飞行器？",shape=box,color=blue];
		j3152326481 -> j3555799221;
		j3152326481 -> j1483282634;
	j1295832584 [label="那就告诉我你的家乡在哪里吧！是这个霍瓦尼亚吗？还是双衍王境？又或者是你坠毁在地球残骸上的轨道飞行器？",shape=box,color=blue];
		j1295832584 -> j3555799221;
		j1295832584 -> j1483282634;
	j3459936561 [label="我们为什么不应该这样做？我们才是更高级的造物，不是吗？阿尔布雷希特随心所欲，你也乐意替他收拾残局！我为什么就没有权利这样做？怎么他追求的就是“正义”，而我的就不是？",shape=box,color=blue];
		j3459936561 -> j287846216;
	j4002440162 [label="我们为什么不应该这样做呢？我们才是更高级的造物，不是吗？阿尔布雷希特随心所欲，在时间长河中横冲直撞，用一种他几乎不了解的疾病感染大众，这一切都是为了“打败一个所谓的神”。",shape=box,color=blue];
		j4002440162 -> j287846216;
	j2420175047 [label="​我​无论​如何​也​无法​理解，​你，​一​个​据​我​所​知来自​完全​另​一​个​现实​版本​的​实体，​为什么​执意​要​在​时间​和​空间​中​横​冲​直​撞，​“扮演心理​治疗师”。​",shape=box,color=blue];
		j2420175047 -> j3956801596;
	j287846216 [label="但看看你！ ",shape=box,color=blue];
		j287846216 -> j965779903;
	j3956801596 [label="Check boolean IsDating",color=orange];
		j3956801596 -> j3881481745 [label=true,color=green];
		j3956801596 -> j1176476102 [label=false,color=brown];
	j965779903 [label="Check boolean IsDating",color=orange];
		j965779903 -> j832916153 [label=true,color=green];
		j965779903 -> j1475493227 [label=false,color=brown];
	j3881481745 [label="你拥有我从未听说过其他生物拥有的力量？循环时间，创造口袋维度。然而你却在这里……修复人际关系（同时也收获了一些属于你的关系）。",shape=box,color=blue];
		j3881481745 -> j4202375611;
	j1176476102 [label="你拥有我从未听说过其他生物拥有的力量？循环时间，创造口袋维度。然而你却在这里……修复人际关系。",shape=box,color=blue];
		j1176476102 -> j4202375611;
	j832916153 [label="你拥有我从未听说过其他生物拥有的力量？循环时间，创造口袋维度。然而你却在这里……修复人际关系（同时也收获了一些属于你的关系）。",shape=box,color=blue];
		j832916153 -> j1041062857;
	j1475493227 [label="你拥有我从未听说过其他生物拥有的力量？循环时间，创造口袋维度。然而你却在这里……修复人际关系。",shape=box,color=blue];
		j1475493227 -> j1041062857;
	j4202375611 [label="我简直震惊了。我无法理解。为什么？为什么？你明明完全可以统治某个宇宙啊！",shape=box,color=blue];
		j4202375611 -> j2885917332;
		j4202375611 -> j1057217075;
		j4202375611 -> j820351089;
	j1041062857 [label="我简直震惊了。我无法理解。为什么？为什么？你明明完全可以统治某个宇宙啊！",shape=box,color=blue];
		j1041062857 -> j1559100522;
		j1041062857 -> j1505628071;
		j1041062857 -> j2230106258;
	j2885917332 [label="我很喜欢我现在做的事情。我正在以我想要的方式帮助别人。",shape=box,color=red];
		j2885917332 -> j3517091880;
	j1057217075 [label="我不知道你能不能理解，但请试着想想：我不想统治一个宇宙。",shape=box,color=red];
		j1057217075 -> j3536600500;
	j820351089 [label="那样我就跟阿尔布雷希特或者奥罗金人没什么两样了，到处横行霸道，按照我的意愿重塑世界。我对那种事没兴趣。",shape=box,color=red];
		j820351089 -> j3536600500;
	j1559100522 [label="我很喜欢我现在做的事情。我正在以我想要的方式帮助别人。",shape=box,color=red];
		j1559100522 -> j3517091880;
	j1505628071 [label="我不知道你能不能理解，但请试着想想：我不想统治一个宇宙。",shape=box,color=red];
		j1505628071 -> j2932543898;
	j2230106258 [label="那样我就跟阿尔布雷希特或者奥罗金人没什么两样了，到处横行霸道，按照我的意愿重塑世界。我对那种事没兴趣。",shape=box,color=red];
		j2230106258 -> j2932543898;
	j3517091880 [label="但为什么呢？我不明白。",shape=box,color=blue];
		j3517091880 -> j1990388149;
	j3536600500 [label="所以你甘心……这样？渺小？",shape=box,color=blue];
		j3536600500 -> j4272439704;
		j3536600500 -> j2860919697;
	j2932543898 [label="所以你甘心……这样？渺小？",shape=box,color=blue];
		j2932543898 -> j2860919697;
		j2932543898 -> j4272439704;
	j1990388149 [label="Check boolean RoatheUnloved1",color=orange];
		j1990388149 -> j688938196 [label=true,color=green];
		j1990388149 -> j2624918695 [label=true,color=green];
		j1990388149 -> j3618009463 [label=true,color=green];
		j1990388149 -> j688938196 [label=false,color=brown];
		j1990388149 -> j2624918695 [label=false,color=brown];
		j1990388149 -> j787973826 [label=false,color=brown];
	j4272439704 [label="如果你觉得我做的事渺小，那没问题。那是你的看法。但我所做的事已经改写了历史。",shape=box,color=red];
		j4272439704 -> j4195824494;
	j2860919697 [label="不是渺小。只是不显眼。让别人去吸引注意吧，我自会待在暗处。",shape=box,color=red];
		j2860919697 -> j4142924987;
	j688938196 [label="因为在人们需要帮助的时候伸出援手，才是我们最终摆脱困境的办法。",shape=box,color=red];
		j688938196 -> j147810976;
	j2624918695 [label="因为我只是在做我该做的事。仅此而已。",shape=box,color=red];
		j2624918695 -> j785611460;
	j3618009463 [label="你说你从未体会过被爱的滋味。我想你永远不会明白，爱能有多么强大，它能改变你周围的世界。",shape=box,color=red];
		j3618009463 -> j3890538144;
	j787973826 [label="罗瑟，你恋爱过吗？或者，你有没有那么深爱过一个人，以至于愿意为他毁灭整个宇宙？",shape=box,color=red];
		j787973826 -> j1413040970;
	j4195824494 [label="这正是我要说的！那就让我们去改写历史吧！而不是坐在这里试图说服大家手拉手唱歌！",shape=box,color=blue];
		j4195824494 -> j3231653200;
		j4195824494 -> j2939292315;
		j4195824494 -> j1600791187;
	j4142924987 [label="啊，我明白了，你喜欢做潜伏在暗处的安静刺客，是吗？在最不引人怀疑的时候出手？不，我不这么认为。我觉得你只是在白费力气。",shape=box,color=blue];
		j4142924987 -> j228643402;
	j147810976 [label="嗯哼。替陌生人跑腿直到他们把你当成当地英雄一样崇拜？还是说服他们手拉手唱歌？恕我先去斐波那契的鱼缸里吐一吐。",shape=box,color=blue];
		j147810976 -> j56539792;
		j147810976 -> j3626858997;
	j785611460 [label="而你“做”的似乎是到处游说大家手拉手唱歌，同时穿插着令人瞠目结舌的暴力表演。暴力本身还说得通，但其他的一切都令人作呕。 ",shape=box,color=blue];
		j785611460 -> j56539792;
		j785611460 -> j3626858997;
	j3890538144 [label="如果你坚持认为我们要通过手拉手唱歌来从“虚空无情之物”手中将宇宙救出来，那恕我直言，我要去斐波那契的鱼缸里吐一吐。",shape=box,color=blue];
		j3890538144 -> j1661637706;
		j3890538144 -> j56539792;
		j3890538144 -> j3626858997;
	j1413040970 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j1413040970 -> j1248277970;
	j3231653200 [label="耐心点。我们首先要对付的是虚空无情之物。",shape=box,color=red];
		j3231653200 -> j3522701764;
	j2939292315 [label="或许等这一切风波过去之后吧。但现在还不是时候。",shape=box,color=red];
		j2939292315 -> j189981301;
	j1600791187 [label="你觉得我会选你一起做这件事吗？别逗我笑了。",shape=box,color=red];
		j1600791187 -> j1989641525;
	j228643402 [label="你不知道自己在做什么，也不知道为什么这么做，你只是奉命行事。又一个自以为是的奥罗金人的爪牙。真丢人。",shape=box,color=blue];
		j228643402 -> "Chat ends.";
	j56539792 [label="我只是想说，你似乎对人们不再痛苦这件事非常生气，而且你好像把这件事看得太重了。",shape=box,color=red];
		j56539792 -> j3022224188;
	j3626858997 [label="我想要表达的观点很简单：如果“虚空无情之物”源于情感的匮乏，那么拥有情感或许就是战胜它的关键。",shape=box,color=red];
		j3626858997 -> j3229721060;
