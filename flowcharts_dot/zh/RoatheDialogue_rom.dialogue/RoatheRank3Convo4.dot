	1906 [label="+5 Chemistry",color=orange];
		1906 -> 1913;
	1907 [label="啊！你居然承认自己是白痴！真是耳目一新。我最喜欢看傻瓜们毫不掩饰自己的愚蠢，这样我操纵他们就容易多了。",shape=box,color=blue];
		1907 -> 1914;
	1908 [label="啊！原来你追求的是卑劣、原始的复仇！太棒了。你就像一头狂暴的野兽，准备啃噬那些伤害过你的人的骨头。",shape=box,color=blue];
		1908 -> 1915;
	1909 [label="+5 Chemistry",color=orange];
		1909 -> 1916;
	1910 [label="啊，我明白了。虚伪的冷漠披着高贵的外衣。你不知道自己属于哪里，应该留在哪里，所以才用这层“正义的牺牲”来伪装自己，听命于人？",shape=box,color=blue];
		1910 -> 1917;
	1911 [label="因为​我​无论​如何​也​无法​理解，​你，​一​个​据​我​所​知来自​完全​另​一​个​现实​版本​的​实体，​为什么​执意​要​在​时间​和​空间​中​横​冲​直​撞，​“扮演心理​治疗师”。​",shape=box,color=blue];
		1911 -> 1918;
	1912 [label="没错，这才是问题的关键！你为什么非要游荡在时空之中“扮演心理治疗师”呢？据我推测，你来自完全不同的现实版本， ",shape=box,color=blue];
		1912 -> 1918;
	1913 [label="精明。好的，我会更直接地切入正题。我之前故意激怒你，只是想看看你能不能说出更诚实的话。",shape=box,color=blue];
		1913 -> 1919;
	1914 [label="你就像一只终于抓到绝灵骥的库狛，现在你的牙齿咬住了它的腿，却不知道该怎么办。",shape=box,color=blue];
		1914 -> 1904;
		1914 -> 1903;
	1915 [label="这是人类最简单、最古老的动机之一，因此也是最容易理解的动机之一。",shape=box,color=blue];
		1915 -> 1904;
	1916 [label="虽然你从未正式当过兵，但从你的语气中，我听出了身经百战的老兵的疲惫。",shape=box,color=blue];
		1916 -> 1920;
	1917 [label="真是太可悲了。",shape=box,color=blue];
		1917 -> 1921;
		1917 -> 1922;
	1918 [label="如果我是你，我会回到双衍王境，尝试探索虚空结构中还有哪些漏洞可以突破！想想那该有多大的可能性！想想那些唾手可得的世界！",shape=box,color=blue];
		1918 -> 1923;
		1918 -> 1924;
	1919 [label="但​我​想，​这样​也​够​了。​",shape=box,color=blue];
