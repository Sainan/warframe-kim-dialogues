	2244 [label="文字记录：过去，残暴和放纵曾为我们带来辉煌的战果。我被要求将它们运用到战争策略中。",shape=box,color=blue];
		2244 -> 2239;
	2239 [label="我们的祖先是如何驯服 Infestation 的？当然是像撕开玫瑰花蕾一样撕开原子的核心！",shape=box,color=blue];
		2239 -> 2236;
	2236 [label="七人众合谋，命令我化身为手持三叉戟的恶魔，成为狂暴辐射的播种者。",shape=box,color=blue];
		2236 -> 5704;
	5704 [label="就在那天，我们得知，Sentient 不仅能够摧毁我们的科技，还能将其据为己用。",shape=box,color=blue];
		5704 -> 5705;
	5705 [label="我们派出的那群邪恶低等无人机欢快地飞回我们身边，身上还带着沉重的炸弹，发出不知名的音节，在派遣它们的母舰中间爆炸。",shape=box,color=blue];
