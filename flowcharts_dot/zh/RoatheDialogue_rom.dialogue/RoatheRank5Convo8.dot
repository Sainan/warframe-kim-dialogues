	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j3560287657 [label="我感觉自己对自己的认知，我赖以生存的根基，就像该死的月球一样，被彻底撕裂、崩裂！一切都被墨迹改写，荡然无存。懦夫！",shape=box,color=blue];
