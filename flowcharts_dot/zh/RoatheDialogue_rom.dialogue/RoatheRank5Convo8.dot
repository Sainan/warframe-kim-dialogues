digraph {
	"RoatheRank5Convo8 begins." [color=orange];
		"RoatheRank5Convo8 begins." -> j4125803273;
	j4125803273 [label="Check boolean RoatheFailNot21",color=orange];
		j4125803273 -> j1758133089 [label=true,color=green];
		j4125803273 -> "Chat ends." [label=false,color=brown];
	j1758133089 [label="Evaluate expressions on HellStory counter",color=orange];
		j1758133089 -> j2441343428 [label="x >= 21",color=purple];
		j1758133089 -> "Chat ends." [label="x <= 21",color=purple];
		j1758133089 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j2441343428 [label="你这个蠢人！你都做了些什么？！为什么，为什么要擅闯那些不欢迎你的洞穴？！",shape=box,color=blue];
		j2441343428 -> j199801165;
	j199801165 [label="我要求你解决这个问题。这是你的错。我能感觉到，这些记忆就像一头巨大的野兽，在撕咬着我。",shape=box,color=blue];
		j199801165 -> j4286327157;
	j4286327157 [label="让我摆脱这一切。让我摆脱这场瘟疫。清除我脑海中的这些记忆。我知道你能做到。运用你拥有的天赋，结束这一切。现在就结束。",shape=box,color=blue];
		j4286327157 -> j2194033198;
		j4286327157 -> j3338162646;
		j4286327157 -> j240093149;
	j2194033198 [label="你确定吗？但是……你很聪明，我感觉你会察觉到有些不对劲。",shape=box,color=red];
		j2194033198 -> j3291369357;
	j3338162646 [label="罗瑟，这段记忆，是不一样的。这段记忆是抹不去的。因为它深埋在你潜意识深处。",shape=box,color=red];
		j3338162646 -> j1673103309;
	j240093149 [label="逃避真相是行不通的。我们最终只会回到原点。 ",shape=box,color=red];
		j240093149 -> j3332805101;
	j3291369357 [label="很有可能。我会把所有线索联系起来，然后怪你做了我没让你做的事。我相信你能挺过难关。",shape=box,color=blue];
		j3291369357 -> j1568724507;
	j1673103309 [label="也许是这样。你说的很可能没错。但我现在也没有其他办法了，不是吗？值得一试。",shape=box,color=blue];
		j1673103309 -> j1568724507;
	j3332805101 [label="如果真是那样，你完全可以再做一遍。这就像你拥有取之不尽的天赋，不是吗？",shape=box,color=blue];
		j3332805101 -> j1568724507;
	j1568724507 [label="当然，一旦我发现你篡改了我的记忆，我一定会非常生气。而且，亲爱的，我建议你最好别告诉我这是应我的要求。",shape=box,color=blue];
		j1568724507 -> j1954787866;
	j1954787866 [label="我会直接认定你在撒谎，这很可能会让我对你的看法彻底崩塌。",shape=box,color=blue];
		j1954787866 -> j491116279;
		j1954787866 -> j264855857;
	j491116279 [label="不行，我做不到，我不会这么做。我们必须一起面对这个问题。我们能不能好好谈谈？",shape=box,color=red];
		j491116279 -> j891629138;
	j264855857 [label="我……真的没有其他办法了吗？",shape=box,color=red];
		j264855857 -> j891629138;
	j891629138 [label="不行？如果你还想让管家上楼？那就按我说的，帮我把脑子里所有这些乱七八糟的事情都忘掉。如果你不在乎？那就随你便。我也不在乎。",shape=box,color=blue];
		j891629138 -> j157318649;
	j157318649 [label="当然，还有一点，我们之间依然存在私人友谊，是我在这件事上唯一能用的筹码。就这么简单。",shape=box,color=blue];
		j157318649 -> j759520029;
	j759520029 [label="你觉得呢？",shape=box,color=blue];
		j759520029 -> j4025707691;
		j759520029 -> j731214231;
	j4025707691 [label="好吧。我……会做的。我会抹去你的记忆。即使这也会抹去玛丽和里昂的记忆。",shape=box,color=red];
		j4025707691 -> j3100051817;
	j731214231 [label="不，我拒绝。我会想其他办法说服你继续向前看。",shape=box,color=red];
		j731214231 -> j1645019543;
	j3100051817 [label="+10 Chemistry",color=orange];
		j3100051817 -> j2861417858;
	j1645019543 [label="那祝你好运。",shape=box,color=blue];
		j1645019543 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j2861417858 [label="很好，去做吧。 ",shape=box,color=blue];
		j2861417858 -> j4072107213;
	"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
}