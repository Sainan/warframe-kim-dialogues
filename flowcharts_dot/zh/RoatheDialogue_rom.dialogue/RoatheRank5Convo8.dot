	j211878632 [label="我不知道该如何满足它。我不知道我是否能够满足它。我曾希望这些谈话能为我指明方向；但我现在明白，这一切都是徒劳的。",shape=box,color=blue];
		j211878632 -> j3456532649;
	j340777621 [label="罗瑟，你的过去并不能定义你，你的未来才能定义你。而且，你还有美好的未来可以去体验，不像那些在长胴鼓之夜死去的奥罗金人。",shape=box,color=red];
		j340777621 -> j3977689577;
	j2963539957 [label="周围人的意见或他们对你行为的看法定义不了你，唯一能定义你自己的，是你如何看待自己以及你的选择。",shape=box,color=red];
		j2963539957 -> j3318256747;
	j1091196057 [label="你这是在让愤怒吞噬自己。你本可以利用它来对抗那些至今仍在破坏这个世界的人。就在此刻。就在这里。",shape=box,color=red];
		j1091196057 -> j3958296820;
	j1983723567 [label="你​这是在把​矛头​指向​了​自己。​你​应该​指向​的​是​这个​世界，​你​尽​了​全力​去​拯救​它​免​遭奥罗金​帝国​的​蹂躏，​它​却​在​责怪​你。",shape=box,color=red];
		j1983723567 -> j1274528833;
