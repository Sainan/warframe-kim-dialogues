digraph {
	5151 [label="RoatheRank5Convo8 begins.",color=orange];
		5151 -> 5152;
	5152 [label="Check boolean RoatheFailNot21",color=orange];
		5152 -> 5154 [label=true,color=green];
		5152 -> 5153 [label=false,color=brown];
	5154 [label="Evaluate expressions on HellStory",color=orange];
		5154 -> 5155 [label="x >= 21",color=purple];
		5154 -> 5156 [label="x <= 21",color=purple];
		5154 -> 5156 [label="false",color=purple];
	5153 [label="Chat ends.",color=orange];
	5155 [label="你这个蠢人！你都做了些什么？！为什么，为什么要擅闯那些不欢迎你的洞穴？！",shape=box,color=blue];
		5155 -> 5157;
	5156 [label="Chat ends.",color=orange];
	5157 [label="我要求你解决这个问题。这是你的错。我能感觉到，这些记忆就像一头巨大的野兽，在撕咬着我。",shape=box,color=blue];
		5157 -> 5158;
	5158 [label="让我摆脱这一切。让我摆脱这场瘟疫。清除我脑海中的这些记忆。我知道你能做到。运用你拥有的天赋，结束这一切。现在就结束。",shape=box,color=blue];
		5158 -> 5159;
		5158 -> 5160;
		5158 -> 5161;
	5159 [label="你确定吗？但是……你很聪明，我感觉你会察觉到有些不对劲。",shape=box,color=red];
		5159 -> 5162;
	5160 [label="罗瑟，这段记忆，是不一样的。这段记忆是抹不去的。因为它深埋在你潜意识深处。",shape=box,color=red];
		5160 -> 5163;
	5161 [label="逃避真相是行不通的。我们最终只会回到原点。 ",shape=box,color=red];
		5161 -> 5164;
	5162 [label="很有可能。我会把所有线索联系起来，然后怪你做了我没让你做的事。我相信你能挺过难关。",shape=box,color=blue];
		5162 -> 5165;
	5163 [label="也许是这样。你说的很可能没错。但我现在也没有其他办法了，不是吗？值得一试。",shape=box,color=blue];
		5163 -> 5165;
	5164 [label="如果真是那样，你完全可以再做一遍。这就像你拥有取之不尽的天赋，不是吗？",shape=box,color=blue];
		5164 -> 5165;
	5165 [label="当然，一旦我发现你篡改了我的记忆，我一定会非常生气。而且，亲爱的，我建议你最好别告诉我这是应我的要求。",shape=box,color=blue];
		5165 -> 5166;
	5166 [label="我会直接认定你在撒谎，这很可能会让我对你的看法彻底崩塌。",shape=box,color=blue];
		5166 -> 5167;
		5166 -> 5168;
	5167 [label="不行，我做不到，我不会这么做。我们必须一起面对这个问题。我们能不能好好谈谈？",shape=box,color=red];
		5167 -> 5169;
	5168 [label="我……真的没有其他办法了吗？",shape=box,color=red];
		5168 -> 5169;
	5169 [label="不行？如果你还想让管家上楼？那就按我说的，帮我把脑子里所有这些乱七八糟的事情都忘掉。如果你不在乎？那就随你便。我也不在乎。",shape=box,color=blue];
		5169 -> 5170;
	5170 [label="当然，还有一点，我们之间依然存在私人友谊，是我在这件事上唯一能用的筹码。就这么简单。",shape=box,color=blue];
		5170 -> 5171;
	5171 [label="你觉得呢？",shape=box,color=blue];
		5171 -> 5172;
		5171 -> 5173;
	5172 [label="好吧。我……会做的。我会抹去你的记忆。即使这也会抹去玛丽和里昂的记忆。",shape=box,color=red];
		5172 -> 5174;
	5173 [label="不，我拒绝。我会想其他办法说服你继续向前看。",shape=box,color=red];
		5173 -> 5175;
	5174 [label="+10 Chemistry",color=orange];
		5174 -> 5176;
	5175 [label="那祝你好运。",shape=box,color=blue];
		5175 -> 5179;
	5176 [label="很好，去做吧。 ",shape=box,color=blue];
		5176 -> 5178;
	5179 [label="Update boolean LyonRoatheRepair",color=orange];
		5179 -> 5177;
	5178 [label="Add 1 to Promise",color=orange];
		5178 -> 5180;
	5177 [label="Chat ends.",color=orange];
	5180 [label="Update boolean RoatheWillReset",color=orange];
		5180 -> 5181;
	5181 [label="Chat ends.",color=orange];
}