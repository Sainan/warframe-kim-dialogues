	j4012117081 [label="我体内有一头狂暴的野兽，正从内而外地啃噬我的肋骨。",shape=box,color=blue];
		j4012117081 -> j211878632;
	j928355870 [label="如果你想寻求宽恕，你可以。但你必须真心想要宽恕。你必须自己选择这条路。没有人能替你做决定。",shape=box,color=red];
		j928355870 -> j340777621;
	j3087305202 [label="如果你想选择走出一条属于自己的道路？为了你自己？那就去做吧。不要道歉。但那是你自己的选择，不是别人的。",shape=box,color=red];
		j3087305202 -> j2963539957;
	j1621085179 [label="罗瑟，生气解决不了任何问题。你生气是因为你害怕面对你所做的一切，以及你变成了什么样的人。",shape=box,color=red];
		j1621085179 -> j1091196057;
