		j856786849 -> j147574907;
	j2861417858 [label="很好，去做吧。 ",shape=box,color=blue];
		j2861417858 -> j4072107213;
	j2915477322 [label="你竟敢——你竟敢跟我提什么“冷静点”！难道你不觉得我有充分的理由感到自己快要被撕成两半吗？！",shape=box,color=blue];
		j2915477322 -> j3560287657;
