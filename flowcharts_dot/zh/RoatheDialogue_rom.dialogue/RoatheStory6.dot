	j2957779264 [label="语音留言：Sentient",shape=box,color=blue];
		j2957779264 -> j1009408700;
	j1009408700 [label="文字记录：我们并不把那些 Sentient 视为“它们”，而是视为一整个“它”。 ",shape=box,color=blue];
		j1009408700 -> j218087820;
	j218087820 [label="我们面对的是成群结队的敌人，它们的个体生命就像是微不足道的细胞一样。",shape=box,color=blue];
		j218087820 -> j2420789849;
	j2420789849 [label="他们只是庞大而邪恶的群体中的细胞。",shape=box,color=blue];
		j2420789849 -> j1062891112;
	j1062891112 [label="我想，我们太容易受到 Infestation 的影响了——那是一种截然不同的群体意识。",shape=box,color=blue];
		j1062891112 -> j3721837019;
	j3721837019 [label="Sentient 被赋予的使命是不断进化，而它们进化终点的唯一范本，就是我们。",shape=box,color=blue];
		j3721837019 -> j2804677883;
	j2804677883 [label="它们返回始源星系不仅是为了消灭奥罗金人，更是为了取代他们，并最终……完善他们。",shape=box,color=blue];
		j2804677883 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}