	2153 [label="当 Sentient 发动攻击时，我们才感受到了久违的团结。禁卫拔刀相向的不再是傲慢的农民或偷窃的商人。",shape=box,color=blue];
		2153 -> 2154;
	2154 [label="而那些名义上的帝国统治者、实权却掌握在执行者手中的皇帝们，从布满灰尘的金色王座上猛然惊醒。",shape=box,color=blue];
		2154 -> 5683;
	5683 [label="战争，辉煌的战争！帝国终于有了意义。在比太阳消亡更迫在眉睫的灭绝威胁下，我们尽情畅饮了生命的甘露。",shape=box,color=blue];
