	"Chat ends." [color=orange];
	j3200555101 [label="语音留言：奥罗金",shape=box,color=blue];
		j3200555101 -> j197196314;
	j197196314 [label="文字记录：长久以来，奥罗金帝国没有敌人。它的军队存在仅仅是为了追究琐碎的恩怨，家族之间互相残杀，执行者之间互相征战。",shape=box,color=blue];
		j197196314 -> j3397048474;
	j3397048474 [label="当 Sentient 发动攻击时，我们才感受到了久违的团结。禁卫拔刀相向的不再是傲慢的农民或偷窃的商人。",shape=box,color=blue];
		j3397048474 -> j494876398;
	j494876398 [label="而那些名义上的帝国统治者、实权却掌握在执行者手中的皇帝们，从布满灰尘的金色王座上猛然惊醒。",shape=box,color=blue];
		j494876398 -> j1117157429;
	j1117157429 [label="战争，辉煌的战争！帝国终于有了意义。在比太阳消亡更迫在眉睫的灭绝威胁下，我们尽情畅饮了生命的甘露。",shape=box,color=blue];
		j1117157429 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}