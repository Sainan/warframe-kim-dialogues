	"Chat ends." [color=orange];
	j1941496630 [label="语音留言：旗帜",shape=box,color=blue];
		j1941496630 -> j64906273;
	j64906273 [label="文字记录：要说最能反映我们人类是如何以自大的姿态对待战争屠戮的，那非旗手莫属。",shape=box,color=blue];
		j64906273 -> j1239513540;
	j1239513540 [label="那些必须不惜一切代价保护——且不得有丝毫质疑的追随之人。",shape=box,color=blue];
		j1239513540 -> j2633214917;
	j2633214917 [label="而且，我还要补充一点，他们可能被威胁，被迫执行任何理智的士兵都不会执行的命令，否则他们将遭受更可怕的命运。尽管这听起来很荒谬。",shape=box,color=blue];
		j2633214917 -> j2584796406;
	j2584796406 [label="尽管这听起来很荒谬。",shape=box,color=blue];
		j2584796406 -> j2848712974;
	j2848712974 [label="虽然他们残缺的躯体与其他尸体并无二致，但我的目光总是会被他们的身形所吸引。",shape=box,color=blue];
		j2848712974 -> j3878430356;
	j3878430356 [label="吸引我的总是他们高举的旗帜，闪耀着奥罗金的金色光芒，点缀着斑驳的深红色。",shape=box,color=blue];
		j3878430356 -> j1571110031;
	j1571110031 [label="每次离开前，我都会确保它骄傲地矗立在战场上。",shape=box,color=blue];
		j1571110031 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}