	"Chat ends." [color=orange];
	j2545964271 [label="语音留言：外交",shape=box,color=blue];
		j2545964271 -> j2128535205;
	j2128535205 [label="在七人众执行者中，Ballas 自诩为平等者中的第一人。",shape=box,color=blue];
		j2128535205 -> j311147393;
	j311147393 [label="他一向擅长外交，总能用甜言蜜语劝服众人，化解其他人之间的怨恨和争端。",shape=box,color=blue];
		j311147393 -> j44985379;
	j44985379 [label="令我欣喜若狂的是，我发现他现在就像一朵被夹在两丛荆棘之间的玫瑰。 ",shape=box,color=blue];
		j44985379 -> j2944774326;
	j2944774326 [label="以尼托为首的主战派朝着一个方向努力，而以斯卡恩为首的主和派则朝着另一个方向努力。",shape=box,color=blue];
		j2944774326 -> j1585490658;
	j1585490658 [label="Ballas 不得不做出抉择，而无论他选择站在哪一边，都将招致另外一群人的强烈仇恨。",shape=box,color=blue];
		j1585490658 -> j2847698843;
	j2847698843 [label="出于我无法揣测的原因，他选择了和平；最终票数为四比三，于是，那些曾经的豺狼虎豹 Sentient 突然变成了盟友和朋友。",shape=box,color=blue];
		j2847698843 -> j2367076551;
	j2367076551 [label="“无论如何，他都会改变主意的，”尼托承诺道，与此同时，我被派去寻找深藏在禁卫中的不满分子。",shape=box,color=blue];
		j2367076551 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}