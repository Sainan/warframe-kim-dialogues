	j1316081675 [label="语音留言：适应性",shape=box,color=blue];
		j1316081675 -> j2188651267;
	j2188651267 [label="文字记录：许多 Sentient 在每次遭遇战之间都会进化，所以我们永远无法确定下一次面对的还是不是同一种敌人。但也有一些 Sentient 保持着稳定的形态，仿佛它们很久以前就达到了某种巅峰状态。",shape=box,color=blue];
		j2188651267 -> j1648172985;
	j1648172985 [label="它们是完美的杀手，带来的冷酷恐怖与鲨鱼如出一辙。",shape=box,color=blue];
		j1648172985 -> j3592164275;
	j3592164275 [label="这简直是疯了。我刚完善了针对 Sentient 的螃蟹飞船的战术，螃蟹飞船就被蠕虫飞船取代了，我该如何制定应对策略呢？",shape=box,color=blue];
		j3592164275 -> j490421236;
	j490421236 [label="而那些蠕虫状的飞船，又会多久被某种新的怪物所取代？",shape=box,color=blue];
		j490421236 -> j4214484459;
	j4214484459 [label="我们所能做的只有倒退。先进科技反而是致命的。古老的传统，那些历经岁月洗礼的荣誉与纪律之路，理应得到应有的尊重。",shape=box,color=blue];
		j4214484459 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}