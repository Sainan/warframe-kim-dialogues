	2098 [label="你不太习惯有很多朋友，是吗？",shape=box,color=red];
		2098 -> 2101;
	2099 [label="我放下心中的重担，与那只巨大而又憨态可掬、不知情的鸟坐在一起交谈，然后发现自己……很平静。这么久以来第一次。",shape=box,color=blue];
