		"RoatheRank3Convo6 begins." -> j1038552372;
	j648926257 [label="罗瑟，你为何总花这么多时间在科维兽上？",shape=box,color=red];
		j648926257 -> j3308314599;
	j226749648 [label="罗瑟，离科维兽远点。你这样让我总觉得不安。",shape=box,color=red];
		j226749648 -> j2226412015;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j3308314599 [label="嗯？好吧，我觉得他们是我在整个天杀的始源星系中见过的最悲惨、最可怜的造物之一。 ",shape=box,color=blue];
		j3308314599 -> j293952322;
	j2226412015 [label="为了尽可能避免误解，我将避免冗长的叙述，简单来说： ",shape=box,color=blue];
		j2226412015 -> j738423125;
	"Chat ends." [color=orange];
	j293952322 [label="实验动物。阿尔布雷希特，实验动物！你把动物扔进天杀的虚空，然后当他们出来用你编造的儿童语言叽叽喳喳的时候，你竟然让你的管家对它们实施安乐死？！",shape=box,color=blue];
		j293952322 -> j501968337;
	j738423125 [label="不要。",shape=box,color=blue];
		j738423125 -> "Chat ends.";
	j501968337 [label="总是把脏活累活都留给别人干。不过，我扯远了。你问我为什么坐下来和他们说话，尤其是那只鸟。原因很简单。但我想让你猜猜看。我想看看你能不能猜出来。",shape=box,color=blue];
		j501968337 -> j1261591471;
		j501968337 -> j1688467438;
		j501968337 -> j3837561415;
		j501968337 -> j3746172356;
		j501968337 -> j1362410674;
	j1261591471 [label="他不知道你是谁。",shape=box,color=red];
		j1261591471 -> j2654456264;
	j1688467438 [label="鸟三喜欢所有人。",shape=box,color=red];
		j1688467438 -> j1334300287;
	j3837561415 [label="你喜欢和那些让你觉得自己很聪明的人在一起。",shape=box,color=red];
		j3837561415 -> j1507003396;
	j3746172356 [label="他对周围的人观察力敏锐。",shape=box,color=red];
		j3746172356 -> j1917757994;
	j1362410674 [label="他很容易操纵。",shape=box,color=red];
		j1362410674 -> j1507003396;
	j2654456264 [label="没错。某种程度上来说，正是如此。他不知道我是谁。他对“Tau 之恶魔”一无所知。而且他……也毫不在乎。",shape=box,color=blue];
		j2654456264 -> j1338363123;
	j1334300287 [label="确实如此。他那傻乎乎的天真劲儿挺讨人喜欢的。但你这是在换个更委婉、更绕口的方式说，除了他，没人会爱我，是这样吗？",shape=box,color=blue];
		j1334300287 -> j1970230465;
	j1507003396 [label="我希望你能明白你错得有多离谱，你的箭射得离目标有多偏……但你并非唯一一个这样看待我的人。",shape=box,color=blue];
		j1507003396 -> j2566543975;
	j1917757994 [label="确实如此。他的观察很有价值，但这些观点我自己也能在几分钟内得出。",shape=box,color=blue];
		j1917757994 -> j3007531333;
	j1338363123 [label="+10 Chemistry",color=orange];
		j1338363123 -> j986231792;
	j1970230465 [label="所以我只能靠这只笨鸟作伴了？不过你说的也算接近真相了，我想我就给你……及格分吧。",shape=box,color=blue];
		j1970230465 -> j986231792;
	j2566543975 [label="绝对不止你一个。",shape=box,color=blue];
		j2566543975 -> j3705997063;
	j3007531333 [label="你​委婉​一点​的​意思​是，​你​认为​我​利用​那​只​聒噪​大鸟​达到​自己​的​目的？​是​这样​吗？​",shape=box,color=blue];
		j3007531333 -> j3736957068;
	j986231792 [label="对​他​来说，​我​不​是​罗瑟，​我​不​是​奥罗金​ 人，​我​不​是​罪犯，​也​不​是​叛徒，​更​不​是​懦夫。​我​只​是​我​自己。​",shape=box,color=blue];
		j986231792 -> j851547198;
	j3705997063 [label="Boolean RoatheAlone1 is now true.",color=orange];
		j3705997063 -> j4081414586;
	j3736957068 [label="我没有。但你并非唯一一个这样看待我的人。真是一点也不孤单。",shape=box,color=blue];
		j3736957068 -> j3705997063;
	j851547198 [label="我无法向你描述那种简单而又难得的解脱感……",shape=box,color=blue];
		j851547198 -> j2623066763;
		j851547198 -> j685234429;
		j851547198 -> j4289109805;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j2623066763 [label="你知道，你可以放下一切。你可以改变。即便是在这里，即便是现在。",shape=box,color=red];
		j2623066763 -> j4092601250;
	j685234429 [label="这一定是一个沉重的负担。无论走到哪里，即使在这里，你都得承受人们对你恶名的期望。",shape=box,color=red];
		j685234429 -> j2375306167;
	j4289109805 [label="你的意思是说，剩下的部分都是你精心策划的一场表演吗？",shape=box,color=red];
		j4289109805 -> j842923580;
	j4092601250 [label="Add 2 to Thermostat counter",color=orange];
		j4092601250 -> j3061656364;
	j2375306167 [label="Add -1 to Thermostat counter",color=orange];
		j2375306167 -> j365484840;
	j842923580 [label="如果​事情​真​那么​简单​就​好​了，​如果​这​一切​都​只​是​我​可以​像​换面​具​一样，​可以​随意​更换​的​华丽​外衣​就​好​了！​不，​篡位者。​但​这​才​是​真正​的​我，​彻头​彻尾​的​腐朽。​",shape=box,color=blue];
		j842923580 -> j3854487002;
	j3061656364 [label="篡位者，如果真有那么简单就好了。你说的听起来太诱人了。我能吗？或许……或许还不算太晚，即使对我这样一个悲惨的恶魔来说也是如此。",shape=box,color=blue];
		j3061656364 -> j3523866510;
	j365484840 [label="+10 Chemistry",color=orange];
		j365484840 -> j3522998140;
	j3854487002 [label="尽管如此，能在上一两个小时里，放下我过去的一切，与一个不知我罪行的人交谈……这样的时光，我很珍惜。",shape=box,color=blue];
		j3854487002 -> j172570375;
	j3523866510 [label="+10 Chemistry",color=orange];
		j3523866510 -> j1369369545;
	j3522998140 [label="篡位者，真的很累。我真希望能够像摘掉面具一样，卸下这副伪装，永远不再穿上。但这才是真正的我，彻头彻尾的腐朽。",shape=box,color=blue];
		j3522998140 -> j3854487002;
	j172570375 [label="Boolean RoatheBirdThree is now true.",color=orange];
		j172570375 -> j3065233978;
		j172570375 -> j3640100770;
	j1369369545 [label="这难道这只是我精心伪装的面具吗？还是早已深埋在我腐朽的骨子里？我尚不清楚。我只能说，只要有机会，我仍然很享受放下一切、放松身心的时光。",shape=box,color=blue];
		j1369369545 -> j1598544833;
	j3065233978 [label="如果这话听起来冒犯了你，请见谅……听起来你的生活似乎很孤独。",shape=box,color=red];
		j3065233978 -> j2902082429;
	j3640100770 [label="你不太习惯有很多朋友，是吗？",shape=box,color=red];
		j3640100770 -> j2539663690;
	j1598544833 [label="我放下心中的重担，与那只巨大而又憨态可掬、不知情的鸟坐在一起交谈，然后发现自己……很平静。这么久以来第一次。",shape=box,color=blue];
		j1598544833 -> j3957337131;
