	2088 [label="Add -1 to Thermostat",color=orange];
		2088 -> 2091;
	2089 [label="如果​事情​真​那么​简单​就​好​了，​如果​这​一切​都​只​是​我​可以​像​换面​具​一样，​可以​随意​更换​的​华丽​外衣​就​好​了！​不，​篡位者。​但​这​才​是​真正​的​我，​彻头​彻尾​的​腐朽。​",shape=box,color=blue];
		2089 -> 2092;
	2090 [label="篡位者，如果真有那么简单就好了。你说的听起来太诱人了。我能吗？或许……或许还不算太晚，即使对我这样一个悲惨的恶魔来说也是如此。",shape=box,color=blue];
		2090 -> 2093;
	2091 [label="+10 Chemistry",color=orange];
		2091 -> 2094;
	2092 [label="尽管如此，能在上一两个小时里，放下我过去的一切，与一个不知我罪行的人交谈……这样的时光，我很珍惜。",shape=box,color=blue];
		2092 -> 2095;
	2093 [label="+10 Chemistry",color=orange];
		2093 -> 2096;
	2094 [label="篡位者，真的很累。我真希望能够像摘掉面具一样，卸下这副伪装，永远不再穿上。但这才是真正的我，彻头彻尾的腐朽。",shape=box,color=blue];
		2094 -> 2092;
	2095 [label="Update boolean RoatheBirdThree",color=orange];
		2095 -> 2097;
		2095 -> 2098;
	2096 [label="这难道这只是我精心伪装的面具吗？还是早已深埋在我腐朽的骨子里？我尚不清楚。我只能说，只要有机会，我仍然很享受放下一切、放松身心的时光。",shape=box,color=blue];
		2096 -> 2099;
	2097 [label="如果这话听起来冒犯了你，请见谅……听起来你的生活似乎很孤独。",shape=box,color=red];
