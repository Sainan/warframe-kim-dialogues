	2102 [label="或许你说的话是有希望的。又或许我只是在自欺欺人。而这，不过是片刻的喘息而已。",shape=box,color=blue];
		2102 -> 2109;
	2106 [label="是的，的确如此。或者至少，我能回忆起的部分是这样。又或者说，篡位者，你曾经抹去过的记忆？我们曾是恋人，我曾向你表白，而你却没有同样的感觉？",shape=box,color=blue];
		2106 -> 2113;
	2105 [label="我承认确实如此。至少就我现在能记得的。如果我告诉你我从未真正恋爱过，你会不会感到震惊？至少从未有过双向恋爱。也许​这​不​会​让​你​感到​震惊。毕竟，我们可能以前也经历过这些。",shape=box,color=blue];
		2105 -> 2112;
	2104 [label="确实​如此。​漫长​而​孤独。​但是​篡位者，​这​都​是​我​咎由​自取。​我​来​这里​并​非为了​博取​你​的​同情​或​怜悯。​",shape=box,color=blue];
		2104 -> 2111;
	2103 [label="我承认确实如此。至少就我现在能记得的。如果我告诉你我从未真正恋爱过，你会不会感到震惊？但是篡位者，这都是我咎由自取。我来这里不是为了博取你的同情或怜悯。",shape=box,color=blue];
		2103 -> 2110;
	2108 [label="谁知道呢？说不定我曾经有朋友，只是记不清了。你我曾经是朋友，而你却抹去了这段记忆，对吗？",shape=box,color=blue];
		2108 -> 2114;
	2107 [label="谁​知道​呢？​说​不定​我​曾经​有​过​朋友，​只是​因为​英择​谛​在​我​搅乱​了​我​的​脑子，​夺走​了​我​对​他们​的​记忆，​所以​我​才​想​不​起​他们​了。​",shape=box,color=blue];
