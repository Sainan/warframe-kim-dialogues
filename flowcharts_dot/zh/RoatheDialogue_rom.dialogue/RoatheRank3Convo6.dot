		2063 -> 2068;
	2064 [label="他很容易操纵。",shape=box,color=red];
		2064 -> 2069;
	2065 [label="没错。某种程度上来说，正是如此。他不知道我是谁。他对“Tau 之恶魔”一无所知。而且他……也毫不在乎。",shape=box,color=blue];
		2065 -> 2070;
	2066 [label="确实如此。他那傻乎乎的天真劲儿挺讨人喜欢的。但你这是在换个更委婉、更绕口的方式说，除了他，没人会爱我，是这样吗？",shape=box,color=blue];
		2066 -> 2071;
	2067 [label="我希望你能明白你错得有多离谱，你的箭射得离目标有多偏……但你并非唯一一个这样看待我的人。",shape=box,color=blue];
		2067 -> 2072;
	2068 [label="确实如此。他的观察很有价值，但这些观点我自己也能在几分钟内得出。",shape=box,color=blue];
		2068 -> 2073;
	2069 [label="我希望你能明白你错得有多离谱，你的箭射得离目标有多偏……但你并非唯一一个这样看待我的人。",shape=box,color=blue];
		2069 -> 2074;
	2070 [label="+10 Chemistry",color=orange];
		2070 -> 2075;
	2071 [label="所以我只能靠这只笨鸟作伴了？不过你说的也算接近真相了，我想我就给你……及格分吧。",shape=box,color=blue];
		2071 -> 2075;
	2072 [label="绝对不止你一个。",shape=box,color=blue];
		2072 -> 2076;
	2073 [label="你​委婉​一点​的​意思​是，​你​认为​我​利用​那​只​聒噪​大鸟​达到​自己​的​目的？​是​这样​吗？​",shape=box,color=blue];
		2073 -> 2077;
	2074 [label="绝对不止你一个。",shape=box,color=blue];
		2074 -> 2078;
	2075 [label="对​他​来说，​我​不​是​罗瑟，​我​不​是​奥罗金​ 人，​我​不​是​罪犯，​也​不​是​叛徒，​更​不​是​懦夫。​我​只​是​我​自己。​",shape=box,color=blue];
		2075 -> 2079;
	2076 [label="Update boolean RoatheAlone1",color=orange];
		2076 -> 2080;
