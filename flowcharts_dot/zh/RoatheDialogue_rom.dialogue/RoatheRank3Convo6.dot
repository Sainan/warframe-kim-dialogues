		2060 -> 2065;
	2061 [label="鸟三喜欢所有人。",shape=box,color=red];
		2061 -> 2066;
	2062 [label="你喜欢和那些让你觉得自己很聪明的人在一起。",shape=box,color=red];
		2062 -> 2067;
