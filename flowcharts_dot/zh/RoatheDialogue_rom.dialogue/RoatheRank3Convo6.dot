		2053 -> 2056;
	2054 [label="Chat ends.",color=orange];
	2057 [label="实验动物。阿尔布雷希特，实验动物！你把动物扔进天杀的虚空，然后当他们出来用你编造的儿童语言叽叽喳喳的时候，你竟然让你的管家对它们实施安乐死？！",shape=box,color=blue];
		2057 -> 2059;
	2056 [label="不要。",shape=box,color=blue];
		2056 -> 2058;
	2059 [label="总是把脏活累活都留给别人干。不过，我扯远了。你问我为什么坐下来和他们说话，尤其是那只鸟。原因很简单。但我想让你猜猜看。我想看看你能不能猜出来。",shape=box,color=blue];
		2059 -> 2060;
