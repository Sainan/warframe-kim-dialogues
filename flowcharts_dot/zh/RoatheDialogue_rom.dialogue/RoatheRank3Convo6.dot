	2051 [label="[结束]",shape=box,color=red];
		2051 -> 2054;
	2055 [label="嗯？好吧，我觉得他们是我在整个天杀的始源星系中见过的最悲惨、最可怜的造物之一。 ",shape=box,color=blue];
		2055 -> 2057;
