digraph {
	"RoatheRank4Convo5 begins." [color=orange];
		"RoatheRank4Convo5 begins." -> j2408745963;
	j2408745963 [label="篡位者，你对你在帝国的日子还有多少记忆？充其量也只能说是零碎的记忆。当然，我不是有意去妄加评判。",shape=box,color=blue];
		j2408745963 -> j8495873;
		j2408745963 -> j1165069401;
		j2408745963 -> j3814668300;
		j2408745963 -> j1038552372;
	j8495873 [label="足以让我明白你们都罪有应得。",shape=box,color=red];
		j8495873 -> j1810878917;
	j1165069401 [label="就一些片段。为什么这么问？",shape=box,color=red];
		j1165069401 -> j2646133892;
	j3814668300 [label="我很小的时候就被送上了扎里曼号。之后……嗯。",shape=box,color=red];
		j3814668300 -> j2646133892;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j1810878917 [label="这很公平。但是，你忽略了我们历史和文化的很大一部分。我知道在帝国覆灭之后，我们不受待见，只是……",shape=box,color=blue];
		j1810878917 -> j3654286651;
	j2646133892 [label="嗯。令我感到奇怪的是，我们社会和文化的完整记录竟然如此之少。我知道在帝国覆灭之后，我们不受待见，只是……",shape=box,color=blue];
		j2646133892 -> j2152768068;
	"Chat ends." [color=orange];
	j3654286651 [label="完全​没​人​提到​过低​温冢​的​事吗？​",shape=box,color=blue];
		j3654286651 -> j1460327653;
		j3654286651 -> j812481975;
	j2152768068 [label="完全​没​人​提到​过低​温冢​的​事吗？​",shape=box,color=blue];
		j2152768068 -> j1183916336;
		j2152768068 -> j3074657965;
	j1460327653 [label="这​最​后​不​会​变成​某​种​极其​残酷​的​奥罗金酷刑​吧？​",shape=box,color=red];
		j1460327653 -> j12505628;
	j812481975 [label="我觉得要是我以前听过这个词，我应该会有印象。",shape=box,color=red];
		j812481975 -> j707679243;
	j1183916336 [label="那是……什么？",shape=box,color=red];
		j1183916336 -> j695734770;
	j3074657965 [label="我觉得要是我以前听过这个词，我应该会有印象。",shape=box,color=red];
		j3074657965 -> j695734770;
	j12505628 [label="令人震惊的是？不会。也许是因为我过去……太多年都和这两个狂热分子被困在墓穴里，但令我震惊的是，数千年来，奥罗金人如何处理死者的记录竟然完全没有留存下来。",shape=box,color=blue];
		j12505628 -> j2940056051;
		j12505628 -> j2661787749;
	j707679243 [label="也许是因为我过去……太多年都和这两个狂热分子被困在墓穴里，但令我震惊的是，数千年来，奥罗金人如何处理死者的记录竟然完全没有留存下来。",shape=box,color=blue];
		j707679243 -> j3556146020;
		j707679243 -> j2007019578;
	j695734770 [label="也许是因为我过去……太多年都和这两个狂热分子被困在墓穴里，但令我震惊的是，数千年来，奥罗金人如何处理死者的记录竟然完全没有留存下来。",shape=box,color=blue];
		j695734770 -> j2911973846;
		j695734770 -> j530481451;
	j2940056051 [label="我不认为你们会死。你们只是在青春厅堂偷了新的肉体而已。",shape=box,color=red];
		j2940056051 -> j2092092048;
	j2661787749 [label="我以为你们已经通过偷走人类解决了这个问题。你所做的只是在嘲弄死亡。",shape=box,color=red];
		j2661787749 -> j742946598;
	j3556146020 [label="我不认为你们会死。你们只是在青春厅堂偷了新的肉体而已。",shape=box,color=red];
		j3556146020 -> j2092092048;
	j2007019578 [label="继续说。",shape=box,color=red];
		j2007019578 -> j136152689;
	j2911973846 [label="我不认为你们会死。你们只是在青春厅堂偷了新的肉体而已。",shape=box,color=red];
		j2911973846 -> j2391567939;
	j530481451 [label="继续说。",shape=box,color=red];
		j530481451 -> j2050714283;
	j2092092048 [label="没错，但那些“关系密切”但“不够重要”的人呢？哲士呢？地位较低的奥罗金人呢？等级制度中总是存在着层层嵌套。即使天花板是透明的，它们也确实存在。相信我。",shape=box,color=blue];
		j2092092048 -> j1997688980;
	j742946598 [label="的确如此。我们是无所不用其极。但并非所有人都幸免于难，不是吗？那些“关系密切”但“不够重要”的人呢？哲士呢？地位较低的奥罗金人呢？",shape=box,color=blue];
		j742946598 -> j1950257437;
	j136152689 [label="想想那些“关系密切”但“不够重要”的人呢？哲士呢？地位较低的奥罗金人呢？等级制度中总是存在着层层嵌套。即使天花板是透明的，它们也确实存在。相信我。",shape=box,color=blue];
		j136152689 -> j1997688980;
	j2391567939 [label="没错，但那些“关系密切”但“不够重要”的人呢？哲士呢？地位较低的奥罗金人呢？等级制度中总是存在着层层嵌套。即使天花板是透明的，它们也确实存在。相信我。",shape=box,color=blue];
		j2391567939 -> j2966498524;
	j2050714283 [label="想想那些“关系密切”但“不够重要”的人呢？哲士呢？地位较低的奥罗金人呢？等级制度中总是存在着层层嵌套。即使天花板是透明的，它们也确实存在。相信我。",shape=box,color=blue];
		j2050714283 -> j2966498524;
	j1997688980 [label="并非所有人都那么幸运，每次旧躯体燃尽都能获得新生。但我确信你觉得青春厅堂的这种做法令人作呕，对吗？",shape=box,color=blue];
		j1997688980 -> j2476599752;
		j1997688980 -> j1832709732;
	j1950257437 [label="并非所有人都那么幸运，每次旧躯体燃尽都能获得新生。显然，你觉得青春厅堂的这种做法令人作呕。",shape=box,color=blue];
		j1950257437 -> j1829977995;
		j1950257437 -> j1832709732;
	j2966498524 [label="并非所有人都那么幸运，每次旧躯体燃尽都能获得新生。但我确信你觉得青春厅堂的这种做法令人作呕，对吗？",shape=box,color=blue];
		j2966498524 -> j2931925007;
		j2966498524 -> j3220478415;
	j2476599752 [label="我对这种做法了解不够，无法做出判断。",shape=box,color=red];
		j2476599752 -> j1074669095;
	j1832709732 [label="对。我觉得你们的所作所为令人作呕。所有关于青春厅堂的记载都说你们拐走了孩子，还抹去了他们的意识。",shape=box,color=red];
		j1832709732 -> j2334526459;
	j1829977995 [label="我怎么可能不作呕？你们把孩子们从他们的家中掳走，抹去他们的记忆，换上你们自己的记忆！",shape=box,color=red];
		j1829977995 -> j2455693698;
	j2931925007 [label="我对这种做法了解不够，无法做出判断。",shape=box,color=red];
		j2931925007 -> j4184676582;
	j3220478415 [label="对。我觉得你们的所作所为令人作呕。所有关于青春厅堂的记载都说你们拐走了孩子，还抹去了他们的意识。",shape=box,color=red];
		j3220478415 -> j3749816905;
	j1074669095 [label="+5 Chemistry",color=orange];
		j1074669095 -> j879271657;
	j2334526459 [label="“所有关于青春厅堂的记载都说……”这些记载都在哪里？更重要的是，这些记载是谁写的？",shape=box,color=blue];
		j2334526459 -> j4167092418;
	j2455693698 [label="那你是怎么知道这一切的？你亲眼见过青春厅堂吗？",shape=box,color=blue];
		j2455693698 -> j1867862427;
		j2455693698 -> j3513496754;
		j2455693698 -> j307185048;
	j4184676582 [label="+5 Chemistry",color=orange];
		j4184676582 -> j879271657;
	j3749816905 [label="然而你刚才说，我们的历史和文化记录只剩下零星碎片。那么，这些记载都在哪里？更重要的是，这些记载是谁写的？",shape=box,color=blue];
		j3749816905 -> j4167092418;
	j879271657 [label="在掌握所有信息之前暂不下结论？我的天哪，篡位者！听起来你真聪明！真是难得一见！",shape=box,color=blue];
		j879271657 -> j4273131006;
	j4167092418 [label="那些都是某些别有用心之人编写的故事，他们刻意把奥罗金的每一面都描绘成灾难与邪恶。",shape=box,color=blue];
		j4167092418 -> j2067393791;
	j1867862427 [label="没有。",shape=box,color=red];
		j1867862427 -> j241925827;
	j3513496754 [label="见过。",shape=box,color=red];
		j3513496754 -> j2476920841;
	j307185048 [label="我见没见过并不重要，记录写得很清楚。",shape=box,color=red];
		j307185048 -> j617651710;
	j4273131006 [label="那么，请允许我为你转换一下历史的视角。请思考一下你可能听说过的关于青春厅堂的那些说法源自何处。",shape=box,color=blue];
		j4273131006 -> j4167092418;
	j2067393791 [label="那些摧毁始源星系社会所有支撑结构、并使其陷入彻底混乱的人，必须给那些依赖该社会的人一个合理的理由。",shape=box,color=blue];
		j2067393791 -> j4041018109;
	j241925827 [label="那么你就是在依赖二手信息。想想这些记录出自哪里。更重要的是，想想是谁写的。",shape=box,color=blue];
		j241925827 -> j4167092418;
	j2476920841 [label="哈！骗子。 ",shape=box,color=blue];
		j2476920841 -> j3979973115;
	j617651710 [label="真是如此吗？想想这些记录都写在哪里。更重要的是，想想这些记录都是谁写的。",shape=box,color=blue];
		j617651710 -> j4167092418;
	j4041018109 [label="篡位者，想想一个普通人在中继站中的生活吧。他远离 Tenno 的种种磨难，对那场大战漠不关心。",shape=box,color=blue];
		j4041018109 -> j3954084684;
	j3979973115 [label="你就是在依赖二手信息。想想这些记录出自哪里。更重要的是，想想是谁写的。",shape=box,color=blue];
		j3979973115 -> j4167092418;
	j3954084684 [label="奥罗金陨落后，随之而来的权力真空让他们的生活陷入了彻底的地狱。他们不得不编造各种解释，制作并焚烧人偶，把其他人塑造成黑暗中的怪物。",shape=box,color=blue];
		j3954084684 -> j2847015244;
		j3954084684 -> j759408004;
	j2847015244 [label="你是说你没有为了青春厅堂而违背儿童意愿绑架他们？",shape=box,color=red];
		j2847015244 -> j570198548;
	j759408004 [label="那么，青春厅堂究竟发生了什么？",shape=box,color=red];
		j759408004 -> j1470159728;
	j570198548 [label="没错，我没有。",shape=box,color=blue];
		j570198548 -> j592061715;
	j1470159728 [label="+5 Chemistry",color=orange];
		j1470159728 -> j1371686870;
	j592061715 [label="我只是想提醒你注意一下信息来源。",shape=box,color=blue];
		j592061715 -> j1672234578;
	j1371686870 [label="说我们没有违背他们的意愿牺牲他们是不对的。因为我们确实这样做了。但这并非全部真相。事情很少如此简单，也从来都不是非黑即白的。",shape=box,color=blue];
		j1371686870 -> j2038382095;
	j1672234578 [label="因为这并非全部真相。事情很少如此简单，也绝非非黑即白。篡位者，世界是灰色的，界限并非如此泾渭分明。 ",shape=box,color=blue];
		j1672234578 -> j299421841;
	j2038382095 [label="篡位者，世界是灰色的，界限并非如此泾渭分明。",shape=box,color=blue];
		j2038382095 -> j299421841;
	j299421841 [label="这种做法最初并非如此可耻。起初，它被视为至高无上的荣誉。为了帝国的延续，甘愿献出自己，坚不可摧，只为让帝国得以继续运转。",shape=box,color=blue];
		j299421841 -> j337553591;
	j337553591 [label="这并非始于年轻人，而是始于那些拥有更多时间的人。但后来，那些献身奉献的人却越来越年轻。奉献是一种强大的精神力量。",shape=box,color=blue];
		j337553591 -> j2130058454;
	j2130058454 [label="我在报名参战的人身上也看到过类似的情况。他们在报名表上谎报年龄，说是为了“打一场正义的仗”。他们却浑然不知，自己正在为后来那些被迫参战的人树立一个危险的先例。",shape=box,color=blue];
		j2130058454 -> j477456523;
	j477456523 [label="不知从何时起，某个执行者意识到，这可以作为一种……惩罚手段。如果​把​青春厅堂​作为​一​种​威胁，某些城市甚至……整个星球都能被控制。如果以特别强硬的方式征收祭品，情况就更是如此。",shape=box,color=blue];
		j477456523 -> j1410839544;
		j477456523 -> j2125215105;
	j1410839544 [label="那你对此有何感想？",shape=box,color=red];
		j1410839544 -> j1629219848;
	j2125215105 [label="你有没有参与过违背他人意愿的献祭？",shape=box,color=red];
		j2125215105 -> j78644576;
	j1629219848 [label="+5 Chemistry",color=orange];
		j1629219848 -> j1632668860;
	j78644576 [label="我不会对你撒谎。我参与过。你可以把我当成怪物。当你的整个社会建立在数百年来对某种事物习以为常的基础上时，很难完全否定它。",shape=box,color=blue];
		j78644576 -> j2295201544;
	j1632668860 [label="嗯，感觉很复杂。一方面，我自己也多次参与过厅堂的事情。如果我谴责它，那我就太虚伪了。当你的整个社会建立在数百年来对某种事物习以为常的基础上时，很难完全否定它。",shape=box,color=blue];
		j1632668860 -> j789825289;
	j2295201544 [label="即使在事后回想，或者在清醒的瞬间，这一点也十分清楚。 ",shape=box,color=blue];
		j2295201544 -> j1320820736;
	j789825289 [label="另一方面，不管是抽离开来看，还是事后再回头看，这种行为的恐怖就十分明显了。",shape=box,color=blue];
		j789825289 -> j1320820736;
	j1320820736 [label="+5 Chemistry",color=orange];
		j1320820736 -> j281220979;
	j281220979 [label="篡位者，没有人应该永生。而这厅堂就是个例证。",shape=box,color=blue];
		j281220979 -> "Chat ends.";
}