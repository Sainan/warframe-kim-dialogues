digraph {
	2664 [label="RoatheRank4Convo5 begins.",color=orange];
		2664 -> 2665;
	2665 [label="篡位者，你对你在帝国的日子还有多少记忆？充其量也只能说是零碎的记忆。当然，我不是有意去妄加评判。",shape=box,color=blue];
		2665 -> 2668;
		2665 -> 2666;
		2665 -> 2667;
		2665 -> 2669;
	2668 [label="足以让我明白你们都罪有应得。",shape=box,color=red];
		2668 -> 2671;
	2666 [label="就一些片段。为什么这么问？",shape=box,color=red];
		2666 -> 2670;
	2667 [label="我很小的时候就被送上了扎里曼号。之后……嗯。",shape=box,color=red];
		2667 -> 2670;
	2669 [label="[结束]",shape=box,color=red];
		2669 -> 2672;
	2671 [label="这很公平。但是，你忽略了我们历史和文化的很大一部分。我知道在帝国覆灭之后，我们不受待见，只是……",shape=box,color=blue];
		2671 -> 2674;
	2670 [label="嗯。令我感到奇怪的是，我们社会和文化的完整记录竟然如此之少。我知道在帝国覆灭之后，我们不受待见，只是……",shape=box,color=blue];
		2670 -> 2673;
	2672 [label="Chat ends.",color=orange];
	2674 [label="完全​没​人​提到​过低​温冢​的​事吗？​",shape=box,color=blue];
		2674 -> 2677;
		2674 -> 2678;
	2673 [label="完全​没​人​提到​过低​温冢​的​事吗？​",shape=box,color=blue];
		2673 -> 2675;
		2673 -> 2676;
	2677 [label="这​最​后​不​会​变成​某​种​极其​残酷​的​奥罗金酷刑​吧？​",shape=box,color=red];
		2677 -> 2680;
	2678 [label="我觉得要是我以前听过这个词，我应该会有印象。",shape=box,color=red];
		2678 -> 2681;
	2675 [label="那是……什么？",shape=box,color=red];
		2675 -> 2679;
	2676 [label="我觉得要是我以前听过这个词，我应该会有印象。",shape=box,color=red];
		2676 -> 2679;
	2680 [label="令人震惊的是？不会。也许是因为我过去……太多年都和这两个狂热分子被困在墓穴里，但令我震惊的是，数千年来，奥罗金人如何处理死者的记录竟然完全没有留存下来。",shape=box,color=blue];
		2680 -> 2684;
		2680 -> 2685;
	2681 [label="也许是因为我过去……太多年都和这两个狂热分子被困在墓穴里，但令我震惊的是，数千年来，奥罗金人如何处理死者的记录竟然完全没有留存下来。",shape=box,color=blue];
		2681 -> 2686;
		2681 -> 2687;
	2679 [label="也许是因为我过去……太多年都和这两个狂热分子被困在墓穴里，但令我震惊的是，数千年来，奥罗金人如何处理死者的记录竟然完全没有留存下来。",shape=box,color=blue];
		2679 -> 2682;
		2679 -> 2683;
	2684 [label="我不认为你们会死。你们只是在青春厅堂偷了新的尸体而已。",shape=box,color=red];
		2684 -> 2690;
	2685 [label="我以为你们已经通过偷走人类解决了这个问题。你所做的只是在嘲弄死亡。",shape=box,color=red];
		2685 -> 2691;
	2686 [label="我不认为你们会死。你们只是在青春厅堂偷了新的尸体而已。",shape=box,color=red];
		2686 -> 2692;
	2687 [label="继续说。",shape=box,color=red];
		2687 -> 2693;
	2682 [label="我不认为你们会死。你们只是在青春厅堂偷了新的尸体而已。",shape=box,color=red];
		2682 -> 2688;
	2683 [label="继续说。",shape=box,color=red];
		2683 -> 2689;
	2690 [label="没错，但那些“关系密切”但“不够重要”的人呢？哲士呢？地位较低的奥罗金人呢？等级制度中总是存在着层层嵌套。即使天花板是玻璃做的，它们也确实存在。相信我。",shape=box,color=blue];
		2690 -> 2695;
	2691 [label="的确如此。我们是无所不用其极。但并非所有人都幸免于难，不是吗？那些“关系密切”但“不够重要”的人呢？哲士呢？地位较低的奥罗金人呢？",shape=box,color=blue];
		2691 -> 2696;
	2692 [label="没错，但那些“关系密切”但“不够重要”的人呢？哲士呢？地位较低的奥罗金人呢？等级制度中总是存在着层层嵌套。即使天花板是玻璃做的，它们也确实存在。相信我。",shape=box,color=blue];
		2692 -> 2695;
	2693 [label="想想那些“关系密切”但“不够重要”的人呢？哲士呢？地位较低的奥罗金人呢？等级制度中总是存在着层层嵌套。即使天花板是玻璃做的，它们也确实存在。相信我。",shape=box,color=blue];
		2693 -> 2695;
	2688 [label="没错，但那些“关系密切”但“不够重要”的人呢？哲士呢？地位较低的奥罗金人呢？等级制度中总是存在着层层嵌套。即使天花板是玻璃做的，它们也确实存在。相信我。",shape=box,color=blue];
		2688 -> 2694;
	2689 [label="想想那些“关系密切”但“不够重要”的人呢？哲士呢？地位较低的奥罗金人呢？等级制度中总是存在着层层嵌套。即使天花板是玻璃做的，它们也确实存在。相信我。",shape=box,color=blue];
		2689 -> 2694;
	2695 [label="并非所有人都那么幸运，每次旧躯体燃尽都能获得新生。但我确信你觉得青春厅堂的这种做法令人作呕，对吗？",shape=box,color=blue];
		2695 -> 2699;
		2695 -> 2700;
	2696 [label="并非所有人都那么幸运，每次旧躯体燃尽都能获得新生。显然，你觉得青春厅堂的这种做法令人作呕。",shape=box,color=blue];
		2696 -> 2701;
		2696 -> 2700;
	2694 [label="并非所有人都那么幸运，每次旧躯体燃尽都能获得新生。但我确信你觉得青春厅堂的这种做法令人作呕，对吗？",shape=box,color=blue];
		2694 -> 2697;
		2694 -> 2698;
	2699 [label="我对这种做法了解不够，无法做出判断。",shape=box,color=red];
		2699 -> 2704;
	2700 [label="对。我觉得你们的所作所为令人作呕。所有关于青春厅堂的记载都说你们拐走了孩子，还抹去了他们的记忆。",shape=box,color=red];
		2700 -> 2705;
	2701 [label="我怎么可能不作呕？你们从孩子们的家中掳走他们，抹去他们的记忆，换上你们自己的记忆！",shape=box,color=red];
		2701 -> 2706;
	2697 [label="我对这种做法了解不够，无法做出判断。",shape=box,color=red];
		2697 -> 2702;
	2698 [label="对。我觉得你们的所作所为令人作呕。所有关于青春厅堂的记载都说你们拐走了孩子，还抹去了他们的记忆。",shape=box,color=red];
		2698 -> 2703;
	2704 [label="+5 Chemistry",color=orange];
		2704 -> 2709;
	2705 [label="“所有关于青春厅堂的记载都说……”这些记载都在哪里？更重要的是，这些记载是谁写的？",shape=box,color=blue];
		2705 -> 2708;
	2706 [label="那你是怎么知道这一切的？你亲眼见过青春厅堂吗？",shape=box,color=blue];
		2706 -> 2710;
		2706 -> 2711;
		2706 -> 2712;
	2702 [label="+5 Chemistry",color=orange];
		2702 -> 2707;
	2703 [label="然而你刚才说，我们的历史和文化记录只剩下零星碎片。那么，这些记载都在哪里？更重要的是，这些记载是谁写的？",shape=box,color=blue];
		2703 -> 2708;
	2709 [label="在掌握所有信息之前暂不下结论？我的天哪，篡位者！听起来你真聪明！真是难得一见！",shape=box,color=blue];
		2709 -> 2713;
	2708 [label="那些都是某些别有用心之人编写的故事，他们刻意把奥罗金的每一面都描绘成灾难与邪恶。",shape=box,color=blue];
		2708 -> 2714;
	2710 [label="没有。",shape=box,color=red];
		2710 -> 2715;
	2711 [label="见过。",shape=box,color=red];
		2711 -> 2716;
	2712 [label="我见没见过并不重要，记录写得很清楚。",shape=box,color=red];
		2712 -> 2717;
	2707 [label="在掌握所有信息之前暂不下结论？我的天哪，篡位者！听起来你真聪明！真是难得一见！",shape=box,color=blue];
		2707 -> 2713;
	2713 [label="那么，请允许我为你转换一下历史的视角。请思考一下你可能听说过的关于青春厅堂的那些说法源自何处。",shape=box,color=blue];
		2713 -> 2708;
	2714 [label="那些摧毁始源星系社会所有支撑结构、并使其陷入彻底混乱的人，必须给那些依赖该社会的人一个合理的理由。",shape=box,color=blue];
		2714 -> 2718;
	2715 [label="那么你就是在依赖二手信息。想想这些记录出自哪里。更重要的是，想想是谁写的。",shape=box,color=blue];
		2715 -> 2708;
	2716 [label="哈！骗子。 ",shape=box,color=blue];
		2716 -> 2719;
	2717 [label="真是如此吗？想想这些记录都写在哪里。更重要的是，想想这些记录都是谁写的。",shape=box,color=blue];
		2717 -> 2708;
	2718 [label="篡位者，想想一个普通人在中继站中的生活吧。他远离 Tenno 的种种磨难，对那场大战漠不关心。",shape=box,color=blue];
		2718 -> 2720;
	2719 [label="你就是在依赖二手信息。想想这些记录出自哪里。更重要的是，想想是谁写的。",shape=box,color=blue];
		2719 -> 2708;
	2720 [label="奥罗金陨落后，随之而来的权力真空让他们的生活陷入了彻底的地狱。他们不得不编造各种解释，制作并焚烧人偶，把自己塑造成黑暗中的怪物。",shape=box,color=blue];
		2720 -> 2721;
		2720 -> 2722;
	2721 [label="你是说你没有为了青春厅堂而违背儿童意愿绑架他们？",shape=box,color=red];
		2721 -> 2723;
	2722 [label="那么，青春厅堂究竟发生了什么？",shape=box,color=red];
		2722 -> 2724;
	2723 [label="没错，我没有。",shape=box,color=blue];
		2723 -> 2725;
	2724 [label="+5 Chemistry",color=orange];
		2724 -> 2726;
	2725 [label="我只是想提醒你注意一下信息来源。",shape=box,color=blue];
		2725 -> 2727;
	2726 [label="说我们没有违背他们的意愿牺牲他们是不对的。因为我们确实这样做了。但这并非全部真相。事情很少如此简单，也从来都不是非黑即白的。",shape=box,color=blue];
		2726 -> 2728;
	2727 [label="因为这并非全部真相。事情很少如此简单，也绝非非黑即白。篡位者，世界是灰色的，界限并非如此泾渭分明。 ",shape=box,color=blue];
		2727 -> 2729;
	2728 [label="篡位者，世界是灰色的，界限并非如此泾渭分明。",shape=box,color=blue];
		2728 -> 2729;
	2729 [label="这种做法最初并非如此可耻。起初，它被视为至高无上的荣誉。为了帝国的延续，甘愿献出自己，坚不可摧，只为让帝国得以继续运转。",shape=box,color=blue];
		2729 -> 2730;
	2730 [label="这并非始于年轻人，而是始于那些拥有更多时间的人。但后来，那些献身奉献的人却越来越年轻。奉献是一种强大的精神力量。",shape=box,color=blue];
		2730 -> 2731;
	2731 [label="我在报名参战的人身上也看到过类似的情况。他们在报名表上谎报年龄，说是为了“打一场正义的仗”。他们却浑然不知，自己正在为后来那些被迫参战的人树立一个危险的先例。",shape=box,color=blue];
		2731 -> 2732;
	2732 [label="不知从何时起，某个执行者意识到，这可以作为一种……惩罚手段。如果以青春厅堂的威胁为名，某些城市甚至……整个星球都能被控制。如果以特别强硬的方式征收祭品，情况就更是如此。",shape=box,color=blue];
		2732 -> 2733;
		2732 -> 2734;
	2733 [label="那你对此有何感想？",shape=box,color=red];
		2733 -> 2735;
	2734 [label="你有没有参与过违背他人意愿的献祭？",shape=box,color=red];
		2734 -> 2736;
	2735 [label="+5 Chemistry",color=orange];
		2735 -> 2737;
	2736 [label="我不会对你撒谎。我参与过。你可以把我当成怪物。当你的整个社会建立在数百年来对某种事物习以为常的基础上时，很难完全否定它。",shape=box,color=blue];
		2736 -> 2738;
	2737 [label="嗯，感觉很复杂。一方面，我自己也多次参与过厅堂的事情。如果我谴责它，那我就太虚伪了。当你的整个社会建立在数百年来对某种事物习以为常的基础上时，很难完全否定它。",shape=box,color=blue];
		2737 -> 2739;
	2738 [label="即使在事后回想，或者在清醒的瞬间，这一点也十分清楚。 ",shape=box,color=blue];
		2738 -> 2740;
	2739 [label="另一方面，不管是抽离开来看，还是事后再回头看，这种行为的恐怖就十分明显了。",shape=box,color=blue];
		2739 -> 2740;
	2740 [label="+5 Chemistry",color=orange];
		2740 -> 2741;
	2741 [label="篡位者，没有人应该永生。而这座厅堂就是个例证。",shape=box,color=blue];
		2741 -> 2742;
	2742 [label="Chat ends.",color=orange];
}