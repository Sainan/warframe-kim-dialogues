digraph {
	"RoatheRank4Convo5 begins." [color=orange];
		"RoatheRank4Convo5 begins." -> j2408745963;
	j2408745963 [label="篡位者，你对你在帝国的日子还有多少记忆？充其量也只能说是零碎的记忆。当然，我不是有意去妄加评判。",shape=box,color=blue];
		j2408745963 -> j8495873;
		j2408745963 -> j1165069401;
		j2408745963 -> j3814668300;
		j2408745963 -> j1038552372;
	j8495873 [label="足以让我明白你们都罪有应得。",shape=box,color=red];
		j8495873 -> j1810878917;
	j1165069401 [label="就一些片段。为什么这么问？",shape=box,color=red];
		j1165069401 -> j2646133892;
	j3814668300 [label="我很小的时候就被送上了扎里曼号。之后……嗯。",shape=box,color=red];
		j3814668300 -> j2646133892;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j1810878917 [label="这很公平。但是，你忽略了我们历史和文化的很大一部分。我知道在帝国覆灭之后，我们不受待见，只是……",shape=box,color=blue];
		j1810878917 -> j3654286651;
	j2646133892 [label="嗯。令我感到奇怪的是，我们社会和文化的完整记录竟然如此之少。我知道在帝国覆灭之后，我们不受待见，只是……",shape=box,color=blue];
		j2646133892 -> j2152768068;
	"Chat ends." [color=orange];
	j3654286651 [label="完全​没​人​提到​过低​温冢​的​事吗？​",shape=box,color=blue];
		j3654286651 -> j1460327653;
		j3654286651 -> j812481975;
	j2152768068 [label="完全​没​人​提到​过低​温冢​的​事吗？​",shape=box,color=blue];
		j2152768068 -> j1183916336;
		j2152768068 -> j3074657965;
	j1460327653 [label="这​最​后​不​会​变成​某​种​极其​残酷​的​奥罗金酷刑​吧？​",shape=box,color=red];
		j1460327653 -> j12505628;
	j812481975 [label="我觉得要是我以前听过这个词，我应该会有印象。",shape=box,color=red];
		j812481975 -> j707679243;
	j1183916336 [label="那是……什么？",shape=box,color=red];
		j1183916336 -> j695734770;
	j3074657965 [label="我觉得要是我以前听过这个词，我应该会有印象。",shape=box,color=red];
		j3074657965 -> j695734770;
	j12505628 [label="令人震惊的是？不会。也许是因为我过去……太多年都和这两个狂热分子被困在墓穴里，但令我震惊的是，数千年来，奥罗金人如何处理死者的记录竟然完全没有留存下来。",shape=box,color=blue];
		j12505628 -> j3130163405;
		j12505628 -> j2661787749;
	j707679243 [label="也许是因为我过去……太多年都和这两个狂热分子被困在墓穴里，但令我震惊的是，数千年来，奥罗金人如何处理死者的记录竟然完全没有留存下来。",shape=box,color=blue];
		j707679243 -> j3707487671;
		j707679243 -> j2733619510;
	j695734770 [label="也许是因为我过去……太多年都和这两个狂热分子被困在墓穴里，但令我震惊的是，数千年来，奥罗金人如何处理死者的记录竟然完全没有留存下来。",shape=box,color=blue];
		j695734770 -> j1637696533;
		j695734770 -> j408662240;
	j3130163405 [label="我不认为你们会死。你们只是在青春厅堂偷了新的尸体而已。",shape=box,color=red];
		j3130163405 -> j65094752;
	j2661787749 [label="我以为你们已经通过偷走人类解决了这个问题。你所做的只是在嘲弄死亡。",shape=box,color=red];
		j2661787749 -> j742946598;
	j3707487671 [label="我不认为你们会死。你们只是在青春厅堂偷了新的尸体而已。",shape=box,color=red];
		j3707487671 -> j65094752;
	j2733619510 [label="继续说。",shape=box,color=red];
		j2733619510 -> j3656878513;
	j1637696533 [label="我不认为你们会死。你们只是在青春厅堂偷了新的尸体而已。",shape=box,color=red];
		j1637696533 -> j505968878;
	j408662240 [label="继续说。",shape=box,color=red];
		j408662240 -> j3884295373;
	j65094752 [label="没错，但那些“关系密切”但“不够重要”的人呢？哲士呢？地位较低的奥罗金人呢？等级制度中总是存在着层层嵌套。即使天花板是玻璃做的，它们也确实存在。相信我。",shape=box,color=blue];
		j65094752 -> j1997688980;
	j742946598 [label="的确如此。我们是无所不用其极。但并非所有人都幸免于难，不是吗？那些“关系密切”但“不够重要”的人呢？哲士呢？地位较低的奥罗金人呢？",shape=box,color=blue];
		j742946598 -> j1950257437;
	j3656878513 [label="想想那些“关系密切”但“不够重要”的人呢？哲士呢？地位较低的奥罗金人呢？等级制度中总是存在着层层嵌套。即使天花板是玻璃做的，它们也确实存在。相信我。",shape=box,color=blue];
		j3656878513 -> j1997688980;
	j505968878 [label="没错，但那些“关系密切”但“不够重要”的人呢？哲士呢？地位较低的奥罗金人呢？等级制度中总是存在着层层嵌套。即使天花板是玻璃做的，它们也确实存在。相信我。",shape=box,color=blue];
		j505968878 -> j2966498524;
	j3884295373 [label="想想那些“关系密切”但“不够重要”的人呢？哲士呢？地位较低的奥罗金人呢？等级制度中总是存在着层层嵌套。即使天花板是玻璃做的，它们也确实存在。相信我。",shape=box,color=blue];
		j3884295373 -> j2966498524;
	j1997688980 [label="并非所有人都那么幸运，每次旧躯体燃尽都能获得新生。但我确信你觉得青春厅堂的这种做法令人作呕，对吗？",shape=box,color=blue];
		j1997688980 -> j193447583;
		j1997688980 -> j2955112620;
	j1950257437 [label="并非所有人都那么幸运，每次旧躯体燃尽都能获得新生。显然，你觉得青春厅堂的这种做法令人作呕。",shape=box,color=blue];
		j1950257437 -> j1522778091;
		j1950257437 -> j2955112620;
	j2966498524 [label="并非所有人都那么幸运，每次旧躯体燃尽都能获得新生。但我确信你觉得青春厅堂的这种做法令人作呕，对吗？",shape=box,color=blue];
		j2966498524 -> j2014322602;
		j2966498524 -> j4096360477;
	j193447583 [label="我对这种做法了解不够，无法做出判断。",shape=box,color=red];
		j193447583 -> j1829594699;
	j2955112620 [label="对。我觉得你们的所作所为令人作呕。所有关于青春厅堂的记载都说你们拐走了孩子，还抹去了他们的记忆。",shape=box,color=red];
		j2955112620 -> j3465343048;
	j1522778091 [label="我怎么可能不作呕？你们从孩子们的家中掳走他们，抹去他们的记忆，换上你们自己的记忆！",shape=box,color=red];
		j1522778091 -> j2455693698;
	j2014322602 [label="我对这种做法了解不够，无法做出判断。",shape=box,color=red];
		j2014322602 -> j2259097986;
	j4096360477 [label="对。我觉得你们的所作所为令人作呕。所有关于青春厅堂的记载都说你们拐走了孩子，还抹去了他们的记忆。",shape=box,color=red];
		j4096360477 -> j3308272856;
	j1829594699 [label="+5 Chemistry",color=orange];
		j1829594699 -> j1369767320;
	j3465343048 [label="“所有关于青春厅堂的记载都说……”这些记载都在哪里？更重要的是，这些记载是谁写的？",shape=box,color=blue];
		j3465343048 -> j121000907;
	j2455693698 [label="那你是怎么知道这一切的？你亲眼见过青春厅堂吗？",shape=box,color=blue];
		j2455693698 -> j622637890;
		j2455693698 -> j1139904164;
		j2455693698 -> j3230779633;
	j2259097986 [label="+5 Chemistry",color=orange];
		j2259097986 -> j1369767320;
	j3308272856 [label="然而你刚才说，我们的历史和文化记录只剩下零星碎片。那么，这些记载都在哪里？更重要的是，这些记载是谁写的？",shape=box,color=blue];
		j3308272856 -> j121000907;
	j1369767320 [label="在掌握所有信息之前暂不下结论？我的天哪，篡位者！听起来你真聪明！真是难得一见！",shape=box,color=blue];
		j1369767320 -> j4079916942;
	j121000907 [label="那些都是某些别有用心之人编写的故事，他们刻意把奥罗金的每一面都描绘成灾难与邪恶。",shape=box,color=blue];
		j121000907 -> j197706362;
	j622637890 [label="没有。",shape=box,color=red];
		j622637890 -> j1393731364;
	j1139904164 [label="见过。",shape=box,color=red];
		j1139904164 -> j3055668476;
	j3230779633 [label="我见没见过并不重要，记录写得很清楚。",shape=box,color=red];
		j3230779633 -> j3761228391;
	j4079916942 [label="那么，请允许我为你转换一下历史的视角。请思考一下你可能听说过的关于青春厅堂的那些说法源自何处。",shape=box,color=blue];
		j4079916942 -> j121000907;
	j197706362 [label="那些摧毁始源星系社会所有支撑结构、并使其陷入彻底混乱的人，必须给那些依赖该社会的人一个合理的理由。",shape=box,color=blue];
		j197706362 -> j1784874902;
	j1393731364 [label="那么你就是在依赖二手信息。想想这些记录出自哪里。更重要的是，想想是谁写的。",shape=box,color=blue];
		j1393731364 -> j121000907;
	j3055668476 [label="哈！骗子。 ",shape=box,color=blue];
		j3055668476 -> j3539720815;
	j3761228391 [label="真是如此吗？想想这些记录都写在哪里。更重要的是，想想这些记录都是谁写的。",shape=box,color=blue];
		j3761228391 -> j121000907;
	j1784874902 [label="篡位者，想想一个普通人在中继站中的生活吧。他远离 Tenno 的种种磨难，对那场大战漠不关心。",shape=box,color=blue];
		j1784874902 -> j1584758895;
	j3539720815 [label="你就是在依赖二手信息。想想这些记录出自哪里。更重要的是，想想是谁写的。",shape=box,color=blue];
		j3539720815 -> j121000907;
	j1584758895 [label="奥罗金陨落后，随之而来的权力真空让他们的生活陷入了彻底的地狱。他们不得不编造各种解释，制作并焚烧人偶，把自己塑造成黑暗中的怪物。",shape=box,color=blue];
		j1584758895 -> j1248393552;
		j1584758895 -> j116058979;
	j1248393552 [label="你是说你没有为了青春厅堂而违背儿童意愿绑架他们？",shape=box,color=red];
		j1248393552 -> j3677559942;
	j116058979 [label="那么，青春厅堂究竟发生了什么？",shape=box,color=red];
		j116058979 -> j4121870870;
	j3677559942 [label="没错，我没有。",shape=box,color=blue];
		j3677559942 -> j853379304;
	j4121870870 [label="+5 Chemistry",color=orange];
		j4121870870 -> j3187648034;
	j853379304 [label="我只是想提醒你注意一下信息来源。",shape=box,color=blue];
		j853379304 -> j995219596;
	j3187648034 [label="说我们没有违背他们的意愿牺牲他们是不对的。因为我们确实这样做了。但这并非全部真相。事情很少如此简单，也从来都不是非黑即白的。",shape=box,color=blue];
		j3187648034 -> j2279523925;
	j995219596 [label="因为这并非全部真相。事情很少如此简单，也绝非非黑即白。篡位者，世界是灰色的，界限并非如此泾渭分明。 ",shape=box,color=blue];
		j995219596 -> j1159376259;
	j2279523925 [label="篡位者，世界是灰色的，界限并非如此泾渭分明。",shape=box,color=blue];
		j2279523925 -> j1159376259;
	j1159376259 [label="这种做法最初并非如此可耻。起初，它被视为至高无上的荣誉。为了帝国的延续，甘愿献出自己，坚不可摧，只为让帝国得以继续运转。",shape=box,color=blue];
		j1159376259 -> j183355560;
	j183355560 [label="这并非始于年轻人，而是始于那些拥有更多时间的人。但后来，那些献身奉献的人却越来越年轻。奉献是一种强大的精神力量。",shape=box,color=blue];
		j183355560 -> j3849617747;
	j3849617747 [label="我在报名参战的人身上也看到过类似的情况。他们在报名表上谎报年龄，说是为了“打一场正义的仗”。他们却浑然不知，自己正在为后来那些被迫参战的人树立一个危险的先例。",shape=box,color=blue];
		j3849617747 -> j2272273545;
	j2272273545 [label="不知从何时起，某个执行者意识到，这可以作为一种……惩罚手段。如果以青春厅堂的威胁为名，某些城市甚至……整个星球都能被控制。如果以特别强硬的方式征收祭品，情况就更是如此。",shape=box,color=blue];
		j2272273545 -> j4248500727;
		j2272273545 -> j4072513095;
	j4248500727 [label="那你对此有何感想？",shape=box,color=red];
		j4248500727 -> j1058139410;
	j4072513095 [label="你有没有参与过违背他人意愿的献祭？",shape=box,color=red];
		j4072513095 -> j2651730326;
	j1058139410 [label="+5 Chemistry",color=orange];
		j1058139410 -> j2144254697;
	j2651730326 [label="我不会对你撒谎。我参与过。你可以把我当成怪物。当你的整个社会建立在数百年来对某种事物习以为常的基础上时，很难完全否定它。",shape=box,color=blue];
		j2651730326 -> j3398902973;
	j2144254697 [label="嗯，感觉很复杂。一方面，我自己也多次参与过厅堂的事情。如果我谴责它，那我就太虚伪了。当你的整个社会建立在数百年来对某种事物习以为常的基础上时，很难完全否定它。",shape=box,color=blue];
		j2144254697 -> j3012702695;
	j3398902973 [label="即使在事后回想，或者在清醒的瞬间，这一点也十分清楚。 ",shape=box,color=blue];
		j3398902973 -> j3130104647;
	j3012702695 [label="另一方面，不管是抽离开来看，还是事后再回头看，这种行为的恐怖就十分明显了。",shape=box,color=blue];
		j3012702695 -> j3130104647;
	j3130104647 [label="+5 Chemistry",color=orange];
		j3130104647 -> j1039302344;
	j1039302344 [label="篡位者，没有人应该永生。而这座厅堂就是个例证。",shape=box,color=blue];
		j1039302344 -> "Chat ends.";
}