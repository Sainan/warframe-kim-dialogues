digraph {
	1095 [label="RoatheRank2Convo4 begins.",color=orange];
		1095 -> 1096;
	1096 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1096 -> 1097 [label=true,color=green];
		1096 -> 1098 [label=false,color=brown];
	1097 [label="Check boolean RoatheKnowsReset2",color=orange];
		1097 -> 1099 [label=true,color=green];
		1097 -> 1100 [label=false,color=brown];
	1098 [label="Chat ends.",color=orange];
	1099 [label="嗯。告诉我。上次我们这样讨论时，我是否成功说服你相信你的“虚空无情之物”不过是拼凑而成的儿童玩具，还是你最终还是坚信它是什么“来自虚空的伟大未知存在”。",shape=box,color=blue];
		1099 -> 1101;
	1100 [label="Check boolean RoatheMITW1",color=orange];
		1100 -> 1102 [label=true,color=green];
		1100 -> 1103 [label=false,color=brown];
	1101 [label="要是说这世间有我最厌恶之事，那就是徒劳无功。我突然意识到，这个比喻如今已远不如从前那样脍炙人口了。",shape=box,color=blue];
		1101 -> 1104;
		1101 -> 1105;
		1101 -> 1106;
	1102 [label="那么，在我们继续之前，我想确认下我的理解是否正确。你认为虚空无情之物是某种来自虚空的可怕未知存在，因阿尔布雷希特的错误而渗入我们的现实？",shape=box,color=blue];
		1102 -> 1107;
	1103 [label="这个疯人院里和我交谈过的每个人都完全相信这个“墙中人”是个货真价实、滑稽可笑的神。一个真正的神。就连那两个狂热分子似乎也在接受这种说法！",shape=box,color=blue];
		1103 -> 1108;
		1103 -> 1109;
		1103 -> 1110;
	1104 [label="不，你没说服我。抱歉。 ",shape=box,color=red];
		1104 -> 1111;
	1105 [label="你确实做到了。",shape=box,color=red];
		1105 -> 1112;
	1106 [label="我们从未完全站到任何一方的立场上。",shape=box,color=red];
		1106 -> 1113;
	1107 [label="请允许我如此表述问题，免得我们原地打转，徒劳无功。这……我突然意识到这个比喻如今​已​远​不​如​从​前​那样​脍炙​人口​了，不过我扯远了。",shape=box,color=blue];
		1107 -> 1114;
	1108 [label="你不信他是真实存在的？",shape=box,color=red];
		1108 -> 1115;
	1109 [label="如果你不认为他是神，那你觉得他是什么？",shape=box,color=red];
		1109 -> 1116;
	1110 [label="而你却不这么认为？",shape=box,color=red];
		1110 -> 1117;
	1111 [label="Update boolean RoatheMITWSkip",color=orange];
		1111 -> 1118;
	1112 [label="Update boolean RoatheMITWSkip",color=orange];
		1112 -> 1119;
	1113 [label="啊！好吧，那么看来我还有些工作要做。",shape=box,color=blue];
		1113 -> 1120;
	1114 [label="你认为那个如今被称你为虚空无情之物的存在，是在阿尔布雷希特与之接触之前就已存在？还是你认为他在第一次与虚空接触时就创造了它？",shape=box,color=blue];
		1114 -> 1121;
		1114 -> 1122;
		1114 -> 1123;
		1114 -> 1124;
	1115 [label="等等，我说过这种话吗？别急着歪曲我的意思，哦，短暂的篡位者。我并没有否认虚空无情之物是“真实存在的”。我否认的是它是神。",shape=box,color=blue];
		1115 -> 1125;
		1115 -> 1126;
	1116 [label="只需两个你理应熟知且能深刻理解的词语，我就能为你揭穿这个虚假神明的真面目：",shape=box,color=blue];
		1116 -> 1127;
	1117 [label="绝不！首先，根本没有神，这种想法太荒谬了。其次，想想阿尔布雷希特竟然释放了一个虚空之神？就更可笑了！",shape=box,color=blue];
		1117 -> 1128;
	1118 [label="Update boolean RoatheMITW5Real",color=orange];
		1118 -> 1129;
	1119 [label="Update boolean RoatheMITW5Fake",color=orange];
		1119 -> 1130;
	1120 [label="Update boolean RoatheMITW1",color=orange];
		1120 -> 1131;
	1121 [label="我不知道。而且我觉得你也不可能知道。",shape=box,color=red];
		1121 -> 1132;
	1122 [label="我认为它是在英择谛接触它之前就已存在的实体。他只是通过概念成形赋予了它形态与形貌。",shape=box,color=red];
		1122 -> 1133;
	1123 [label="说实话……我不知道。",shape=box,color=red];
		1123 -> 1134;
	1124 [label="你真的认为英择谛凭空捏造出了一个邪恶的虚空神？",shape=box,color=red];
		1124 -> 1135;
	1125 [label="那东西比我对抗过的任何东西都强大。",shape=box,color=red];
		1125 -> 1136;
	1126 [label="那么你认为他是什么？",shape=box,color=red];
		1126 -> 1116;
	1127 [label="概念成形。",shape=box,color=blue];
		1127 -> 1137;
		1127 -> 1138;
		1127 -> 1139;
	1128 [label="虚空中空无一物。正因如此，它才被称为虚空！ ",shape=box,color=blue];
		1128 -> 1140;
		1128 -> 1141;
	1129 [label="+10 Chemistry",color=orange];
		1129 -> 1142;
	1130 [label="+20 Chemistry",color=orange];
		1130 -> 5772;
	1131 [label="不过在我们继续之前，我想确认下我的理解是否正确。你认为虚空无情之物是某种来自虚空的可怕未知存在，因阿尔布雷希特的错误而渗入我们的现实？",shape=box,color=blue];
		1131 -> 1107;
	1132 [label="能！我当然能！事情的真相如此显而易见，你们竟都坚信窗外有巨兽啃咬窗框，实际上不过是风中摇曳的树枝罢了，这样荒谬至极的错觉实在可笑至极。",shape=box,color=blue];
		1132 -> 1143;
	1133 [label="别你也这样。我曾对你寄予厚望。事情的真相如此显而易见，你们竟都坚信窗外有巨兽啃咬窗框，实际上不过是风中摇曳的树枝罢了，这样荒谬至极的错觉实在可笑至极。",shape=box,color=blue];
		1133 -> 1143;
	1134 [label="事情的真相如此显而易见，你们竟都坚信窗外有巨兽啃咬窗框，实际上不过是风中摇曳的树枝罢了，这样荒谬至极的错觉实在可笑至极。",shape=box,color=blue];
		1134 -> 1143;
	1135 [label="是的！我确信如此！事情的真相如此显而易见，你们竟都坚信窗外有巨兽啃咬窗框，实际上不过是风中摇曳的树枝罢了，这样荒谬至极的错觉实在可笑至极。",shape=box,color=blue];
		1135 -> 1143;
	1136 [label="我什么时候否认过这一点？说真的，你们似乎都把自己卷入了一场毫无必要的歇斯底里和巨大的苦难之中。",shape=box,color=blue];
		1136 -> 1144;
		1136 -> 1145;
	1137 [label="虚空以及我们能利用它创造出来的东西既危险又强大——相信我，我深有体会。但它终究也有局限性。你真的以为它能够展现出这样的能力吗？能够创造完整的语言，拥有能够驱动飞船穿梭虚空的手指？",shape=box,color=red];
		1137 -> 1146;
	1138 [label="罗瑟，说实话……把这当成床底下的怪物确实很诱人。但我亲眼见过那东西，面对“面”地见过，实在无法理解这种东西怎么可能只是我们脑子里的产物。",shape=box,color=red];
		1138 -> 1147;
	1139 [label="概念成形无法做到墙中人能做到的事。虽然英择谛可能显化了那东西——也对将它带到这里负责——但我认为他并不是那东西的最初来源。",shape=box,color=red];
		1139 -> 1148;
	1140 [label="我...... ",shape=box,color=red];
		1140 -> 1149;
	1141 [label="不，我见过来自虚空的东西。天使。歌唱。鬼魂。",shape=box,color=red];
		1141 -> 1149;
	1142 [label="虽然你坚持立场令我失望，但你的坦率却让我倍感清新。至少往后不必再浪费时间了。相信我们一定能找到其他的消遣方式。",shape=box,color=blue];
		1142 -> 1150;
	5772 [label="太棒了。我很高兴过去的自己如此令人信服。我也希望你是在坦诚相待，而不是为了“让我闭嘴”而对我撒谎。不过，我别无选择，只能相信你。",shape=box,color=blue];
		5772 -> 5773;
	1143 [label="如今，在虚空的影响下，你们所有人向它倾注了过多的恐惧与力量，以至于它如同反馈回路般，把自己扭曲成了这个……东西。墙中人。",shape=box,color=blue];
		1143 -> 1151;
	1144 [label="你说什么？",shape=box,color=red];
		1144 -> 1152;
	1145 [label="等等。这怎么能怪我们呢？该怪阿尔布雷希特才对，是他放出来的。",shape=box,color=red];
		1145 -> 1153;
	1146 [label="人类在发明创造各种新式苦难方面，真是五花八门，花样翻新，不是吗？你自己亲眼目睹了许多残酷暴行，我相信在咱们那群狂热分子的年代，没有人能想象到这些暴行竟会发生。",shape=box,color=blue];
		1146 -> 1154;
	1147 [label="啊，你离真相如此之近，却又如此轻易地否定它。你觉得相信它是自己脑海中的产物很“诱人”，因为这样更容易将其抛诸脑后？不，我认为面对自己创造的产物，远比面对神更危险。",shape=box,color=blue];
		1147 -> 1155;
	1148 [label="虽然我欣赏你的谦逊，但我挑战你对人类创造力的有限理解——尤其是如何创造出新的苦难形式这方面。难道你不是凭空捏造出你自己的宇宙吗？",shape=box,color=blue];
		1148 -> 1156;
	1149 [label="虚空中唯一存在的，是我们放入其中的，以及从中返回的。它能改变物质和能量——但它无法创造它们。",shape=box,color=blue];
		1149 -> 1157;
	1150 [label="至少我庆幸自己免于再次陷入关于概念成形的细枝末节，不必再经历那场漫无目的的循环辩论。",shape=box,color=blue];
		1150 -> 1158;
	5773 [label="无论如何，我相信我们一定能找到其他消遣方式，而不是沉溺于关于概念成形细枝末节的漫无目的的争论。",shape=box,color=blue];
		5773 -> 5774;
	1151 [label="阿尔布雷希特或许是这场闹剧的始作俑者，但你们所有人都在火上浇油，直至烈焰吞噬一切。虚空无情之物本不存在。直到某天，它突然出现了。 ",shape=box,color=blue];
		1151 -> 1159;
	1152 [label="我是说：阿尔布雷希特或许正是最初目睹自己狂妄自大如毁灭之神般狞笑着凝视着他的人，没错。",shape=box,color=blue];
		1152 -> 1160;
	1153 [label="阿尔布雷希特或许正是最初目睹自己狂妄自大如毁灭之神般狞笑着凝视着他的人，没错。",shape=box,color=blue];
		1153 -> 1160;
	1154 [label="+5 Chemistry",color=orange];
		1154 -> 1161;
	1155 [label="一个外部敌人可以被理解，被操纵，被击败。甚至必要时，还可以去和他谈判。他们有可以利用的弱点。但一个内部敌人呢？我们自己造出来的敌人呢？那可就阴险得多了。",shape=box,color=blue];
		1155 -> 1162;
	1156 [label="你自己亲眼目睹了许多残酷暴行，我相信在咱们那群狂热分子的年代，没有人能想象到这些暴行竟会发生。 ",shape=box,color=blue];
		1156 -> 1163;
	1157 [label="想想吧，漂泊者。你说的这些“虚空天使”，这些幽灵，它们是不是从那些已经消失在虚空的人转化而来？",shape=box,color=blue];
		1157 -> 1164;
	1158 [label="虽然​这​意​味​着​要​多​花​时间​听狂​热​分子们​说​教……唉。​选择​选择​选择……",shape=box,color=blue];
		1158 -> 1165;
	5774 [label="至少我很庆幸自己免于再经历第二轮折磨。",shape=box,color=blue];
		5774 -> 1158;
	1159 [label="而你们都难辞其咎。",shape=box,color=blue];
		1159 -> 1166;
		1159 -> 1167;
		1159 -> 1168;
	1160 [label="可你们都难辞其咎，竟让这坨朱巴虫粪球一路从山坡往下滚了这么久，沿途每沾一丁点粪渣就越滚越大！",shape=box,color=blue];
		1160 -> 1169;
	1161 [label="作为一个物种，我们有一种惊人的能力，那就是不断给恐惧输送素材，从而让想象创造出比现实更糟的自我毁灭场景。",shape=box,color=blue];
		1161 -> 1170;
	1162 [label="+5 Chemistry",color=orange];
		1162 -> 1171;
	1163 [label="+5 Chemistry",color=orange];
		1163 -> 1161;
	1164 [label="它们只不过是能量的回流，就像色彩斑斓的库塔克鸟通过反刍来喂养它的孩子们一样。",shape=box,color=blue];
		1164 -> 1169;
	1165 [label="Chat ends.",color=orange];
	1166 [label="罗瑟，我早就跟你说过——我们绝不可能创造那样的存在。概念成形自有其局限性。",shape=box,color=red];
		1166 -> 1172;
	1167 [label="别把这事怪到我们头上。那东西造成的破坏与我们无关。",shape=box,color=red];
		1167 -> 1173;
	1168 [label="请详细解释一下你的的推论依据。通过虚空概念成形诞生的存在，大多都无法脱离虚空——至少无法持久存在。",shape=box,color=red];
		1168 -> 1174;
	1169 [label="让我用更简洁的方式解释一下。只需两个你理应熟知且能深刻理解的词语，我就能为你揭穿这个虚假神明的真面目：",shape=box,color=blue];
		1169 -> 1127;
	1170 [label="Update boolean RoatheMITW1",color=orange];
		1170 -> 1107;
	1171 [label="因为那样我们就必须对抗自己的恶魔。而人类……从来都赢不了这样的战争，不是吗？",shape=box,color=blue];
		1171 -> 1170;
	1172 [label="这话从你这个凭一己之力开辟了平行时空的人嘴里说出的？拜托，漂泊者……像很久以前那样发挥你的想象力吧。",shape=box,color=blue];
		1172 -> 1174;
	1173 [label="我不是在责备你！这事在你出现之前就酝酿已久了。是阿尔布雷希特搞的鬼。",shape=box,color=blue];
		1173 -> 1175;
	1174 [label="概念成形的原理如下——当与虚空互动或接近虚空时，强烈的情感与思绪可具现为实体形态。我们都心知肚明。",shape=box,color=blue];
		1174 -> 1176;
		1174 -> 1177;
		1174 -> 1178;
	1175 [label="他看见了自己的倒影，感受到了真正的恐惧。于是，那第一缕火花就此点燃，燃起了一场足以焚毁万物的烈火。而你们，却只是不断往火中添柴。",shape=box,color=blue];
		1175 -> 1174;
	1176 [label="没错。就像双衍王境，它通过扎里曼号与这个世界保持着联系。 ",shape=box,color=red];
		1176 -> 1179;
	1177 [label="正如扎里曼号、坚守者和虚空天使一样。在那艘飞船上虚空无处不在。",shape=box,color=red];
		1177 -> 1179;
	1178 [label="是的。然后呢？",shape=box,color=red];
		1178 -> 1180;
	1179 [label="正是如此。虚空所至之处，概念成形便能追随。也仅限于此。",shape=box,color=blue];
		1179 -> 1181;
		1179 -> 1182;
	1180 [label="虚空所至之处，概念成形便能追随。也仅限于此。",shape=box,color=blue];
		1180 -> 1181;
		1180 -> 1182;
	1181 [label="但它曾现身 1999 年。它如影随形地跟随阿尔布雷希特。也跟着我。",shape=box,color=red];
		1181 -> 1183;
	1182 [label="等一下……",shape=box,color=red];
		1182 -> 1184;
	1183 [label="那些该死的手指。我们曾用那些被诅咒的手指，在绝望而疯狂的尝试中试图触及 Tau，而我们奥罗金人找到了复制它们的方法，不是吗？",shape=box,color=blue];
		1183 -> 1185;
	1184 [label="是的。你现在看见了。那些该死的手指。我们曾用那些被诅咒的手指，在绝望而疯狂的尝试中试图触及 Tau，而我们奥罗金人找到了复制它们的方法，不是吗？",shape=box,color=blue];
		1184 -> 1185;
	1185 [label="虚空的碎片，无处不在……沟渠与隧道交织成网任那东西可以在任何角落出现。更糟的是？",shape=box,color=blue];
		1185 -> 1186;
	1186 [label="Tenno。还有你。你们所有人，都被虚空侵蚀。你们所有人，都被那东西纠缠，因为无论你们走到哪里，它都能尾随而至。",shape=box,color=blue];
		1186 -> 1187;
	1187 [label="任何与它接触过一段时间的人恐怕都难逃厄运。英择谛本人。他的管家。科维兽。我本人，还有狂热分子们，都因为靠近这座圣所而沾染。名单还会增加。",shape=box,color=blue];
		1187 -> 1188;
		1187 -> 1189;
	1188 [label="所以你的推论是，任何暴露于虚空足够久的人——或者任何成为“电池”的人，都会变成墙中人窥视世界的另一扇窗口？",shape=box,color=red];
		1188 -> 1190;
	1189 [label="但我想不出来，它究竟是如何侵入鲁莎卡的？",shape=box,color=red];
		1189 -> 1191;
	1190 [label="没错。 ",shape=box,color=blue];
		1190 -> 1192;
	1191 [label="谁？",shape=box,color=blue];
		1191 -> 1193;
		1191 -> 1194;
	1192 [label="这就能解释它为何无法显现自身面容了吧？它只能以正在折磨之人的形态，向那些它试图折磨的对象显现。",shape=box,color=blue];
		1192 -> 1195;
	1193 [label="内奇·鲁莎卡少校。1999 年，她在霍瓦尼亚负责指挥一支名为炽蛇军的军事力量。",shape=box,color=red];
		1193 -> 1196;
	1194 [label="总而言之，我万万不能让你们俩见面。",shape=box,color=red];
		1194 -> 1197;
	1195 [label="事实上，当它竭力展现某种宏大而异质的存在时，会显现建筑形态的面容。当它极力试图唤起某种宏伟感和神性时，它才会如此。",shape=box,color=blue];
		1195 -> 1198;
		1195 -> 1199;
	1196 [label="她曾——或正在——被虚空无情之物附身。那力量正占据她的意识，像操纵傀儡一样控制着她。或者说她主动放任它入侵。我们不得而知。同样也无法确认她是否已重新夺回了掌控。",shape=box,color=red];
		1196 -> 1200;
	1197 [label="你真是毫无乐趣可言，篡位者。但她究竟如何牵扯到我们的……虚空无情之物？",shape=box,color=blue];
		1197 -> 1196;
	1198 [label="所以你认为它用着所有接触过的人的面容……因为它没有自己的？",shape=box,color=red];
		1198 -> 1201;
	1199 [label="我认为墙中人选择用我们的面容，是因为它无法理解人类的存在状态。否则它就太“宏大”了。",shape=box,color=red];
		1199 -> 1202;
	1200 [label="听起来她确实是个令人着迷的强悍任务。简直妙不可言。但眼下这些都无关紧要。你说虚空无情之物已经占据了她的意识？而这一切始于你那段短暂的过去之旅？",shape=box,color=blue];
		1200 -> 1203;
	1201 [label="不，傻瓜。因为它只是在模仿创造它的存在。它并非完整实体——它只是由各种恐惧、惊骇与苦难的残片拼凑而成的玩物，这些残片正是它被喂养的养料。 ",shape=box,color=blue];
		1201 -> 1204;
	1202 [label="不，傻瓜。它只是在模仿创造它的存在。它并非完整实体——它只是由各种恐惧、惊骇与苦难的残片拼凑而成的玩物，这些残片正是它被喂养的养料。",shape=box,color=blue];
