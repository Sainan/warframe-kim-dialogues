	1211 [label="我不过是和那些算命先生一样坐在这揣测玄机罢了，篡位者。我可不敢暗示阿尔布雷希特是故意在霍瓦尼亚撕开虚空之门，让虚空无情之物侵入，好为它创造一个化身……",shape=box,color=blue];
		1211 -> 1215;
	1212 [label="当然！我不过是和那些算命先生一样坐在这揣测玄机罢了，篡位者。我可不敢暗示阿尔布雷希特是故意在霍瓦尼亚撕开虚空之门，让虚空无情之物侵入，好为它创造一个化身……",shape=box,color=blue];
