		1208 -> 1212;
	1209 [label="如果他在 1999 年撕开通往虚空的裂缝故意放任其侵入……这也能解释战甲为何能在那里使用……你的时空也是如此——当然，前提是没有火卫二上的那颗“心”。",shape=box,color=red];
