		j1965646806 -> j278063035;
	j1324091492 [label="好吧，无论你想要什么，现在都别想得到了。你最好就此作罢，让我彻底忘记我们之间这段荒唐的经历。",shape=box,color=blue];
		j1324091492 -> j235719813;
	j2002281527 [label="别这么愤愤不平，就算你现在意识到自己被我耍了也一样。我当初就把交易条款都告诉你了，却从未明确说明我的条件。难道你没注意到吗？",shape=box,color=blue];
		j2002281527 -> j1295868552;
	j3596613725 [label="我向你提供了交易条款，但从未明确说明我的义务。难道你没注意到吗？",shape=box,color=blue];
		j3596613725 -> j1295868552;
	j1726897146 [label="“我还需要有人帮我记录记忆，并帮助我整理它们。算是一个临时的助手吧。”",shape=box,color=blue];
		j1726897146 -> j2500287955;
	j3166267096 [label="我会直接认定你在撒谎，这很可能会让我对你的看法彻底崩塌。",shape=box,color=blue];
		j3166267096 -> j3641211652;
		j3166267096 -> j1142125098;
	j919439102 [label="每次我们交谈，我都会忍不住想，我们踏上的这片土地，对你来说是熟悉还是陌生？我只是在重复自己说过的话，还是会给你带来新的惊喜？",shape=box,color=blue];
		j919439102 -> j1731176738;
	j3706251063 [label="你履行了交易义务。现在我们来到了倒数第二个阶段，必须敲定我们进攻策略的具体细节。",shape=box,color=blue];
		j3706251063 -> j76443315;
	j278063035 [label="Boolean RoatheDating is now false.",color=orange];
		j278063035 -> j1091908143;
	j1295868552 [label="我只是告诉你能从这项安排中得到什么。我从没说过你必须做什么，也没说过为什么要这样做才能得到它们。而你却盲目地同意了。",shape=box,color=blue];
		j1295868552 -> j214064850;
	j2500287955 [label="虽然你满足了第一个标准“记录我的记忆”，但你在第二个标准“帮助我整理它们”上却彻底失败了。",shape=box,color=blue];
		j2500287955 -> j2059229448;
	j3641211652 [label="不行，我做不到，我不会这么做。我们必须一起面对这个问题。我们能不能好好谈谈？",shape=box,color=red];
