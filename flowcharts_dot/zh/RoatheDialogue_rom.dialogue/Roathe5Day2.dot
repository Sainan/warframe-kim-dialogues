		j617454213 -> "Chat ends." [label="false",color=purple];
	j1088539381 [label="新的一天来临，我发现自己很久以来第一次开始规划未来。我思考着如何重塑我周围的世界，如何运用我的知识和能力，如何更好地发挥我的优势。",shape=box,color=blue];
		j1088539381 -> j3984658869;
	j1813922517 [label="新的一天来临，我发现自己很久以来第一次开始规划未来。我思考着这对我意味着什么，我想要什么，以及我希望如何改造我的环境以适应我的需求。",shape=box,color=blue];
		j1813922517 -> j2558396776;
	j3915901740 [label="请问你究竟在等什么？我坐在这里，对发生的一切记忆依然清晰。你曾向我保证，你会把它们从我的记忆中抹去。",shape=box,color=blue];
		j3915901740 -> j4067420534;
		j3915901740 -> j1372280059;
		j3915901740 -> j1961529518;
	j1260023864 [label="你决定好了吗？我这人耐心得很，但也是有限度的。你会抹去我脑海中的这些记忆，还是想让我继续陷入其中？",shape=box,color=blue];
		j1260023864 -> j1231136997;
		j1260023864 -> j2193856033;
	j2131331591 [label="我们现在身处此情此景，也将永远停留于此。在这炼狱之中。我希望你们能享受这里的一切，因为我想我们再也无法离开这里了。",shape=box,color=blue];
		j2131331591 -> j2171950327;
	j4118098284 [label="这是什么意思？",shape=box,color=red];
		j4118098284 -> j288150501;
	j168200977 [label="两边各占一点吧？",shape=box,color=red];
		j168200977 -> j3422622736;
	j2007574131 [label="这一切都与你无关，罗瑟。从来都与你无关。",shape=box,color=red];
		j2007574131 -> j29410721;
	j2025940461 [label="你这个蠢人！你都做了些什么？！为什么，为什么要擅闯那些不欢迎你的洞穴？！",shape=box,color=blue];
		j2025940461 -> j531735750;
	"Chat ends." [color=orange];
