		j2084223989 -> j365354272;
	j834325949 [label="如果真是那样，你完全可以再做一遍。这就像你拥有取之不尽的天赋，不是吗？",shape=box,color=blue];
		j834325949 -> j365354272;
	j3557389900 [label="很有可能。我会把所有线索联系起来，然后怪你做了我没让你做的事。我相信你能挺过难关。",shape=box,color=blue];
