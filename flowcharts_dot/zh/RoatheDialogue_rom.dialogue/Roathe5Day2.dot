		j76443315 -> j2062762917;
	j1091908143 [label="好吧，无论你想要什么，现在都别想得到。你最好就此作罢，让我彻底忘记我们之间这段荒唐的经历。“亲爱的漂泊者”。",shape=box,color=blue];
		j1091908143 -> j235719813;
	j214064850 [label="我猜这就是以前所谓的“空白支票”吧？而且你是心甘情愿地签的。",shape=box,color=blue];
		j214064850 -> j3432216018;
		j214064850 -> j3826159643;
	j2059229448 [label="我很难说已经跟这些记忆和解了，你觉得呢？",shape=box,color=blue];
		j2059229448 -> j1355384336;
	j3140673527 [label="不行？如果你还想让管家上楼？那就按我说的，帮我把脑子里所有这些乱七八糟的事情都忘掉。如果你不在乎？那就随你便。我也不在乎。",shape=box,color=blue];
		j3140673527 -> j1567825783;
	j1014880991 [label="昨晚我睡得比以往任何时候都好。要说“好到我都记不清有多久了”，那可就太没品了。",shape=box,color=blue];
		j1014880991 -> j647659567;
	j153921077 [label="什么？",shape=box,color=red];
		j153921077 -> j2306362208;
	j2062762917 [label="我们是在说洛德的事吗？",shape=box,color=red];
		j2062762917 -> j945935995;
	j3432216018 [label="有没有什么办法能让你改变主意？",shape=box,color=red];
		j3432216018 -> j1404331548;
	j3826159643 [label="那我该怎么办？",shape=box,color=red];
		j3826159643 -> j3201682745;
	j1355384336 [label="你没有履行你的承诺，所以我也不会履行我的承诺。",shape=box,color=blue];
		j1355384336 -> j1444372719;
		j1355384336 -> j162595447;
	j1567825783 [label="当然，还有一点，我们之间依然存在私人友谊，是我在这件事上唯一能用的筹码。就这么简单。",shape=box,color=blue];
		j1567825783 -> j438415004;
	j647659567 [label="所以，现在轮到我来帮你了。那个管家。你还想让他和楼上的阿尔布雷希特一家团聚吗？",shape=box,color=blue];
		j647659567 -> j744968765;
	j2306362208 [label="管家。让他与阿尔布雷希特的家人团聚。你还想这么做，是吗？",shape=box,color=blue];
		j2306362208 -> j1949841813;
	j945935995 [label="是​的。​请​尽量​跟​上。​我​猜​你​仍然​想​让​他​和​楼上​的​阿尔布雷​希特一​家​团聚，​对​吗？​",shape=box,color=blue];
		j945935995 -> j1949841813;
