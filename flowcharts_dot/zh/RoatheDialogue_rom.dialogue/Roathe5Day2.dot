		j2558396776 -> j1694297174 [label=false,color=brown];
	j4067420534 [label="我知道。但这些事情需要时间，我们需要等待。",shape=box,color=red];
		j4067420534 -> j3529867103;
	j1372280059 [label="我改变主意了。对不起。",shape=box,color=red];
		j1372280059 -> j620426460;
	j1961529518 [label="我会的。我在努力着呢。我保证。",shape=box,color=red];
		j1961529518 -> j1656622805;
	j1231136997 [label="不，我做不到。对不起，我不能这样对你。",shape=box,color=red];
		j1231136997 -> j3821853249;
	j2193856033 [label="好吧，我妥协了，我照你说的做。",shape=box,color=red];
		j2193856033 -> j1637991612;
	j2171950327 [label="Check boolean LoidFamilyComplete",color=orange];
		j2171950327 -> j2334562450 [label=true,color=green];
		j2171950327 -> j3198460575 [label=false,color=brown];
	j288150501 [label="无论你想要什么，现在都别想得到。你最好就此作罢，让我彻底忘记我们之间这段荒唐的经历。",shape=box,color=blue];
		j288150501 -> j235719813;
	j3422622736 [label="好吧，无论你想要什么，现在都别想得到。你最好就此作罢，让我彻底忘记我们之间这段荒唐的经历。",shape=box,color=blue];
		j3422622736 -> j235719813;
	j29410721 [label="这一点很清楚，你不必担心。",shape=box,color=blue];
		j29410721 -> "Chat ends.";
	j531735750 [label="我要求你解决这个问题。这是你的错。我能感觉到，这些记忆就像一头巨大的野兽，在撕咬着我。",shape=box,color=blue];
		j531735750 -> j1942637921;
	j2793813435 [label="亲爱的，如果我不感谢你的帮助，那就太失礼了。谢谢你。",shape=box,color=blue];
		j2793813435 -> j2292093829;
		j2793813435 -> j1093409253;
	j1138144464 [label="篡位者，如果我不感谢你的帮助，那就太失礼了。谢谢你。",shape=box,color=blue];
		j1138144464 -> j1287659454;
		j1138144464 -> j2231557222;
	j1880958246 [label="亲爱的，如果我还不承认这很大程度上要归功于你的帮助，那就太失礼了。",shape=box,color=blue];
		j1880958246 -> j3047369850;
		j1880958246 -> j1746743530;
	j1694297174 [label="篡位者，如果我还不承认这很大程度上要归功于你的帮助，那就太失礼了。",shape=box,color=blue];
		j1694297174 -> j1828271869;
		j1694297174 -> j1529776318;
	j3529867103 [label="嗯，好吧。我这个人很有耐心，但相信我，耐心也是有限度的。",shape=box,color=blue];
		j3529867103 -> "Chat ends.";
	j620426460 [label="我明白了。就这么轻易改变了，是吗？",shape=box,color=blue];
		j620426460 -> j431793363;
	j1656622805 [label="嗯。请你一定要这么做。我这人很有耐心，但相信我，时间长了，井里的水也会干涸。",shape=box,color=blue];
		j1656622805 -> "Chat ends.";
	j3821853249 [label="即使这意味着我们将永远被困在这个僵局中？你这可怜的、悲哀的篡位者……好吧。对恶魔来说，炼狱总比地狱好，不是吗？",shape=box,color=blue];
		j3821853249 -> j4291943583;
	j1637991612 [label="很好。赶紧行动吧。我厌倦了把这些信息记在脑子里。",shape=box,color=blue];
		j1637991612 -> j378811769;
	j2334562450 [label="不过，这对你又有什么关系呢？你还想从我空荡荡的尸体上割下什么呢。我的肋骨光秃秃的，已经褪色了。",shape=box,color=blue];
		j2334562450 -> j1776100240;
	j3198460575 [label="真是悲剧，不是吗？英择谛家族的那些渣滓永远不会知道，管家就这么孤零零地躺在这里，双手紧紧地绞在一起，悲痛欲绝。",shape=box,color=blue];
		j3198460575 -> j1776100240;
	j235719813 [label="如果你执意如此，那这将是你唯一的出路。如果你不在乎，那我也不在乎。随你便吧。",shape=box,color=blue];
		j235719813 -> j863140661;
	j1942637921 [label="让我摆脱这一切。让我摆脱这场瘟疫。清除我脑海中的这些记忆。我知道你能做到。运用你拥有的天赋，结束这一切。现在就结束。",shape=box,color=blue];
		j1942637921 -> j3706469946;
		j1942637921 -> j3408045867;
		j1942637921 -> j1461326918;
