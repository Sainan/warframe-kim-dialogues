	j1142125098 [label="我……真的没有其他办法了吗？",shape=box,color=red];
		j1142125098 -> j3140673527;
	j1731176738 [label="总之，我宁愿你别告诉我。我讨厌自己太容易被人猜到。不过，你确实帮我解决了一个对我来说非常重要的问题。 ",shape=box,color=blue];
