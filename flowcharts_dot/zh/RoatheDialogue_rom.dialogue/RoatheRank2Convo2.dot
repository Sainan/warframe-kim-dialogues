	j475549112 [label="我不知道还能怎么办。我别无选择。",shape=box,color=red];
		j475549112 -> j3772047713;
	j3684402489 [label="是的。我没想到你会……变成这样，记忆有些模糊。对不起。",shape=box,color=red];
		j3684402489 -> j3566206265;
	j3615609195 [label="罗瑟，说实话？我……从没想过我能这样做竟然会这么重要。",shape=box,color=red];
