		j872499818 -> j3566700837;
	j2230011423 [label="人其实变化不大。从本质上讲，他一直都有能力做出他所做的事。",shape=box,color=red];
		j2230011423 -> j350709798;
	j1035709705 [label="你​之前​说​过​你​把​我们​之间​的​关系​“搞砸​了”，​或者​说​和​那些​狂热​分子​之间​的​事情​纠缠​不清，​难以​解决。​所以​你​真的​认为​这​是​你​当时​最​好​的​选择​吗？​",shape=box,color=blue];
