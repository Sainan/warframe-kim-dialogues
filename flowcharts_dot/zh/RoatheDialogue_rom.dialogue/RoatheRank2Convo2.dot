	j743174603 [label="你知道吗，他们曾经相爱过。",shape=box,color=blue];
		j743174603 -> j463907764;
		j743174603 -> j3371002201;
		j743174603 -> j1038552372;
	j892678857 [label="你操纵我们所有人的思想……这一切仅仅是为了欲望？爱？还是什么？你会如何称呼它？我只是在想，这一切是否值得。或许你还不知道，因为你的回报尚未到来。",shape=box,color=blue];
		j892678857 -> j1583194989;
	j2584057610 [label="你​操纵​我们​的​思想……​这​一切​究竟​是​为了​什么？​是​为了​完成​某​个……​看​不见​的​任务​清单​吗？​还是​这​一切​都​是​为了​打败​你们​臆造​出来​的​所谓​的​“神”？​",shape=box,color=blue];
		j2584057610 -> j2375206068;
	j463907764 [label="谁？",shape=box,color=red];
		j463907764 -> j2125145403;
	j3371002201 [label="我很难相信这件事。",shape=box,color=red];
		j3371002201 -> j453140443;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j1583194989 [label="我想，为了赢得心上人的心（和/或身体）而采取如此极端的做法，这种浪漫虽然有点……反乌托邦，但也颇为奇特。",shape=box,color=blue];
		j1583194989 -> j2217397260;
	j2375206068 [label="或者更糟的是，你只是出于好奇想看看会发生什么？你只是坐在那里，拔掉昆虫的腿？我们已经弄清楚了你做了“什么”。现在，我想探究你“为什么”这么做。",shape=box,color=blue];
		j2375206068 -> j3362610447;
	j2125145403 [label="Ballas 和 Margulis。",shape=box,color=blue];
		j2125145403 -> j2464228105;
	j453140443 [label="没​错！​我​仿佛​都​能​在圣所里听到​你​嗤之​以鼻​的​声音​了。​但​ Ballas ​和​ Margulis ​曾经​是​真心​相爱​的。​",shape=box,color=blue];
		j453140443 -> j2933206020;
	j2217397260 [label="或者更糟的是，你只是出于好奇想看看会发生什么？你只是坐在那里，拔掉昆虫的腿？我们已经弄清楚了你做了“什么”。现在，我想探究你“为什么”这么做。",shape=box,color=blue];
