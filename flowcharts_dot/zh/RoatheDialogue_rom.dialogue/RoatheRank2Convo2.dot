		j2868117985 -> j251209250 [label=false,color=brown];
	j2105234816 [label="你之前说把我们之间的事“搞砸了”，或者说和那些狂热分子之间的事情纠缠不清，难以解决。所以你真的认为这是你当时最好的选择吗？",shape=box,color=blue];
		j2105234816 -> j3615609195;
		j2105234816 -> j1509263982;
		j2105234816 -> j3684402489;
