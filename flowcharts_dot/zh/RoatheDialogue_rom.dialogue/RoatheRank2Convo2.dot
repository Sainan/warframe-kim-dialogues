	j3566206265 [label="嗯，行。好吧，你可能没遇到过像我这样记忆支离破碎的原型战甲。从这个角度来说，我大概能稍微理解你。",shape=box,color=blue];
		j3566206265 -> j1356819711;
	j675300054 [label="啊，我明白了……习惯了这种不用承担后果的行为。你可能没遇到过像我这样记忆支离破碎的原型战甲。",shape=box,color=blue];
