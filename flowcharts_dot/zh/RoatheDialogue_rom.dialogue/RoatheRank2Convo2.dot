		j1646847578 -> j784906788 [label="x < 21",color=purple];
		j1646847578 -> j784906788 [label="false",color=purple];
	j4103849826 [label="啊，原来你也是奥罗金帝国的人啊。真是太好了。我很难相信你会以“爱”的名义做这一切。",shape=box,color=blue];
		j4103849826 -> j2137144176;
	j430787691 [label="啊，我明白了……习惯了这种不用承担后果的行为。你可能没遇到过像我这样记忆支离破碎的原型战甲。从这个角度来说，我大概能稍微理解你。而这一切都是以“爱”的名义做的。",shape=box,color=blue];
		j430787691 -> j206220018;
	j259610152 [label="嗯，行。好吧，你可能没遇到过像我这样记忆支离破碎的原型战甲。从这个角度来说，我大概能稍微理解你。而这一切都是以“爱”的名义做的。",shape=box,color=blue];
		j259610152 -> j206220018;
	j1735693143 [label="所以，篡位者，我开始明白你当初是怎么“搞砸”的了。",shape=box,color=blue];
		j1735693143 -> j1356819711;
	j3585784528 [label="+5 Chemistry",color=orange];
		j3585784528 -> j1329703563;
	j2308076030 [label="+5 Chemistry",color=orange];
		j2308076030 -> j202745904;
	j1356819711 [label="我本想斥责你为了达到目所做的一切，但我惊讶地发现，奥罗金人做过更糟糕甚至更有“创意”的事情。",shape=box,color=blue];
		j1356819711 -> j3509380505;
	j1385258607 [label="当然，是你。或者更确切地说，是孩子们做的。Tenno。有时候，我会想，这一切的发生真的是不可避免的吗。或者，他是否有可能被说服改变自己的道路。",shape=box,color=blue];
		j1385258607 -> j3619377888;
	j973864441 [label="或许你是对的。又或许，归根结底，我们都是未经雕琢的宝石。我们都有缺点，都有各自的特点。这里有纹路，那里有瑕疵。",shape=box,color=blue];
		j973864441 -> j1799407022;
	j1877878510 [label="看来，篡位者，我开始明白你当初是怎么“搞砸”的了。我很难相信你是以“爱”的名义做这一切的。",shape=box,color=blue];
		j1877878510 -> j2137144176;
	j3679504104 [label="+5 Chemistry",color=orange];
		j3679504104 -> j3379044358;
	j784906788 [label="+5 Chemistry",color=orange];
		j784906788 -> j2189399878;
	j2137144176 [label="但我想，奥罗金人表达情感的方式一向都很奇怪。",shape=box,color=blue];
		j2137144176 -> j3509380505;
	j206220018 [label="我本想斥责你以所谓的“爱”的名义所做的一切，但我惊讶地发现，奥罗金人做过更糟糕甚至更有“创意”的事情。",shape=box,color=blue];
		j206220018 -> j3509380505;
	j1329703563 [label="我建议大家静下心来面对自己的错误，坦然接受失败，但这岂不是会让我变成一个彻头彻尾的伪君子吗？",shape=box,color=blue];
		j1329703563 -> j2931125286;
	j202745904 [label="我建议大家静下心来面对自己的错误，坦然接受失败，但我没有虚空赋予的那种穿越时空、抹除记忆的能力。",shape=box,color=blue];
		j202745904 -> j2807665513;
	j3509380505 [label="我跟你讲过 Ballas 和 Margulis 的故事吗？我希望你能对我诚实，否则我根本无从得知真相。",shape=box,color=blue];
		j3509380505 -> j3100691852;
	j3619377888 [label="我更愿意相信我们都是未经雕琢的宝石。我们都有缺点，都有各自的特点。这里有纹路，那里有瑕疵。",shape=box,color=blue];
		j3619377888 -> j1799407022;
	j1799407022 [label="我们或许会被雕琢出某些特质，要么捕捉光芒，制成精美的艺术品……要么被磨砺成武器……要么化为尘埃。",shape=box,color=blue];
		j1799407022 -> j4030327632;
	j3379044358 [label="我建议大家静下心来面对自己的错误，坦然接受失败，但这岂不是会让我变成一个彻头彻尾的伪君子吗？",shape=box,color=blue];
		j3379044358 -> j3061217564;
	j2189399878 [label="我建议大家静下心来面对自己的错误，坦然接受失败，但我没有虚空赋予的那种穿越时空、抹除记忆的能力。",shape=box,color=blue];
		j2189399878 -> j4118177571;
	j2931125286 [label="谁又能说我不会好好利用虚空赋予我的循环时间和抹除记忆的能力呢？",shape=box,color=blue];
		j2931125286 -> j2807665513;
	j2807665513 [label="不过，这到底……是怎么运作的？",shape=box,color=blue];
		j2807665513 -> j231084262;
		j2807665513 -> j2204928311;
		j2807665513 -> j1038552372;
	j3100691852 [label="我多么憎恶这一点，让我来告诉你。",shape=box,color=blue];
		j3100691852 -> j179402447;
		j3100691852 -> j1083191479;
		j3100691852 -> j1958005804;
		j3100691852 -> j1426694980;
	j4030327632 [label="或许这是一种天真的想法，我们或许真的都是一成不变的。你肯定比我更清楚这一点，至少我是这么听说的。",shape=box,color=blue];
		j4030327632 -> j660029204;
	j3061217564 [label="谁又能说我不会好好利用虚空赋予我的循环时间和抹除记忆的能力呢？",shape=box,color=blue];
		j3061217564 -> j4118177571;
	j4118177571 [label="不过，这到底……是怎么运作的？",shape=box,color=blue];
		j4118177571 -> j2877766878;
		j4118177571 -> j1425217417;
		j4118177571 -> j1038552372;
	j231084262 [label="你现在是 Infested。而且你与用于制造所有原型战甲血清批次的感染菌株有着某种联系。",shape=box,color=red];
		j231084262 -> j3705822985;
	j2204928311 [label="一把会说话的吉他欠我一些人情。",shape=box,color=red];
		j2204928311 -> j1918460139;
	j179402447 [label="我已经听过了。",shape=box,color=red];
		j179402447 -> j3190918749;
	j1083191479 [label="我已经听过了，但请继续说。",shape=box,color=red];
		j1083191479 -> j192463406;
	j1958005804 [label="其实，我还没听说过。",shape=box,color=red];
		j1958005804 -> j1901213885;
	j1426694980 [label="不，我还没听过这个故事，而这……其实也是我们今天在这聊的原因之一。我知道我第一次错失了一些机会。",shape=box,color=red];
		j1426694980 -> j2145072663;
	j660029204 [label="但你让我把事情顺序搞乱了。让我从头开始讲吧。",shape=box,color=blue];
		j660029204 -> j3455999767;
	j2877766878 [label="你现在是 Infested。而且你与用于制造所有原型战甲血清批次的感染菌株有着某种联系。",shape=box,color=red];
		j2877766878 -> j4114352492;
	j1425217417 [label="一把会说话的吉他欠我一些人情。",shape=box,color=red];
		j1425217417 -> j2783039127;
	j3705822985 [label="据我所知——而且她的话也不太可靠，所以听听就好——每批原型战甲的感染菌株都可以被单独影响。",shape=box,color=red];
		j3705822985 -> j2857513701;
	j1918460139 [label="我……明白了。",shape=box,color=blue];
		j1918460139 -> j893290178;
	j3190918749 [label="+10 Chemistry",color=orange];
		j3190918749 -> j1415870860;
	j192463406 [label="要么你是想讨好我的自尊心，这一点我得佩服你；要么你只是对今天的生活极其提不起劲。作为同样经历过无数人生轮回的人，我几乎能感同身受。",shape=box,color=blue];
		j192463406 -> j3660756293;
	j1901213885 [label="真有意思。要么你在撒谎，要么我还有你没挖出来的秘密。或许这就是你再次来到这里，重读那些已被翻阅过的篇章的原因吧。",shape=box,color=blue];
		j1901213885 -> j3277230518;
	j2145072663 [label="嗯，你一点一点地，快要说服我原谅你造成的这一切混乱了。",shape=box,color=blue];
		j2145072663 -> j4129939457;
	j3455999767 [label="远在扎里曼 10-0 号启航之前，甚至连 Tenno 都还未出现在人们的视野里时，哲士 Margulis 和 Ballas 在一个新穹顶温室的开幕式上相遇了。",shape=box,color=blue];
		j3455999767 -> j2329363683;
	j4114352492 [label="据我所知——而且她的话也不太可靠，所以听听就好——每批原型战甲的感染菌株都可以被单独影响。",shape=box,color=red];
		j4114352492 -> j899313120;
	j2783039127 [label="我……明白了。",shape=box,color=blue];
		j2783039127 -> j2101789172;
	j2857513701 [label="它们各自都存在于自己的“连续性”或时间里。所有感染菌株都相互关联，但它们似乎也存在于……结节状的结构中。这一切都非常复杂。",shape=box,color=red];
		j2857513701 -> j1342524951;
	j893290178 [label="自从我离开之后，宇宙的确变得更加奇异了……",shape=box,color=blue];
		j893290178 -> j3713355620;
		j893290178 -> j4070889324;
	j1415870860 [label="那么我就不再赘述这个故事，以免让你感到厌烦，也好让你在剩下的时间里寻找其他乐子吧。",shape=box,color=blue];
		j1415870860 -> j2888030837;
	j3660756293 [label="如果​我​不​是​你​的​消遣​对​象​就​好​了。​",shape=box,color=blue];
		j3660756293 -> j3277230518;
	j3277230518 [label="但是？不管怎样…… ",shape=box,color=blue];
		j3277230518 -> j3303046945;
	j4129939457 [label="Boolean RoatheResetForgiven is now true.",color=orange];
		j4129939457 -> j3277230518;
	j2329363683 [label="Ballas 到场只是为了参加仪式——我们当然喜欢盛大的场面和隆重的仪式——而 Margulis 则拼命地想不引人注目。",shape=box,color=blue];
		j2329363683 -> j85615391;
	j899313120 [label="它们各自都存在于自己的“连续性”或时间里。所有感染菌株都相互关联，但它们似乎也存在于……结节状的结构中。这一切都非常复杂。",shape=box,color=red];
		j899313120 -> j1839431543;
	j2101789172 [label="自从我离开之后，宇宙的确变得更加奇异了……",shape=box,color=blue];
		j2101789172 -> j1664457460;
		j2101789172 -> j1096382351;
	j1342524951 [label="因为我可以循环时间，所以我可以在一定限度内循环感染者“批次”。",shape=box,color=red];
		j1342524951 -> j963753197;
	j3713355620 [label="你根本想象不到。",shape=box,color=red];
		j3713355620 -> j1356819711;
	j4070889324 [label="她才是真正的佼佼者。好吧……算了。",shape=box,color=red];
		j4070889324 -> j1356819711;
	j2888030837 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j2888030837 -> "Chat ends.";
	j3303046945 [label="Ballas 和 Margulis。",shape=box,color=blue];
		j3303046945 -> j3455999767;
	j85615391 [label="我的篡位者，你必须明白一点，Ballas 根本没有理由和她来往。绝对没有理由，除非他是真的爱上她了。",shape=box,color=blue];
		j85615391 -> j382015853;
	j1839431543 [label="因为我可以循环时间，所以我可以在一定限度内循环感染者“批次”。",shape=box,color=red];
		j1839431543 -> j3463594576;
	j1664457460 [label="你根本想象不到。",shape=box,color=red];
		j1664457460 -> j2391789492;
	j1096382351 [label="她才是真正的佼佼者。好吧……算了。",shape=box,color=red];
		j1096382351 -> j2391789492;
	j963753197 [label="“她”是谁？",shape=box,color=blue];
		j963753197 -> j1538867699;
		j963753197 -> j271626435;
	j382015853 [label="这不仅仅是欲望，因为他想要谁就能得到谁——而且他经常这么做。如果他想要她，他完全可以轻易得到她，然后就此结束。",shape=box,color=blue];
		j382015853 -> j779683192;
	j3463594576 [label="“她”是谁？",shape=box,color=blue];
		j3463594576 -> j542393450;
		j3463594576 -> j3763523376;
	j2391789492 [label="不管怎样，这一切，都打着“爱”的旗号？",shape=box,color=blue];
		j2391789492 -> j206220018;
	j1538867699 [label="丽兹，她会喜欢你的。",shape=box,color=red];
		j1538867699 -> j1918460139;
	j271626435 [label="一把会说话的吉他。",shape=box,color=red];
		j271626435 -> j1918460139;
	j779683192 [label="他是执行者。是七人众之一。事实上，还是其中最有权势的一位。他完全可以把她召到他的寝宫，而她也会毫不犹豫地赴约。",shape=box,color=blue];
		j779683192 -> j2898372170;
	j542393450 [label="丽兹，她会喜欢你的。",shape=box,color=red];
		j542393450 -> j2783039127;
	j3763523376 [label="一把会说话的吉他。",shape=box,color=red];
		j3763523376 -> j2783039127;
	j2898372170 [label="但他并没有那样做。漂泊者，那天晚上，Ballas 只看了她一眼……他就彻底沦陷了。整个人都乱了。",shape=box,color=blue];
		j2898372170 -> j1669241413;
	j1669241413 [label="我从未见过这样的场面。仿佛房间里除了 Margulis 之外，其他人都不存在似的。他甚至……害羞得连话都不敢说。你敢信！这居然是 Ballas！",shape=box,color=blue];
		j1669241413 -> j827711977;
		j1669241413 -> j893083884;
	j827711977 [label="真的吗？",shape=box,color=red];
		j827711977 -> j3480092069;
	j893083884 [label="你在编故事。",shape=box,color=red];
		j893083884 -> j979680996;
	j3480092069 [label="我以我仅存的荣誉发誓！我有什么理由撒谎？我才不在乎你对他们关系的真实性有什么看法！",shape=box,color=blue];
		j3480092069 -> j2070040774;
	j979680996 [label="我以我仅存的荣誉发誓，我没有！我有什么理由撒谎？我才不在乎你对他们关系的真实性有什么看法！",shape=box,color=blue];
		j979680996 -> j2070040774;
	j2070040774 [label="让我感到难过的是，你竟然这么快就简化一件远比你们想象的复杂得多的事情。",shape=box,color=blue];
		j2070040774 -> j2749309096;
	j2749309096 [label="无论你信不信，他们确实相爱了。Ballas 不顾一切阶级规则和传统，迎娶了一位哲士，作为他的爱人——也作为他唯一的爱侣。",shape=box,color=blue];
		j2749309096 -> j3418266527;
	j3418266527 [label="只有真爱才能让一个男人如此疯狂，尤其是在一切走向崩坏时……",shape=box,color=blue];
		j3418266527 -> j471119031;
		j3418266527 -> j227929340;
	j471119031 [label="你是怎么得出这个结论的？难道他不是害死她的凶手吗？",shape=box,color=red];
		j471119031 -> j852124521;
	j227929340 [label="是 Ballas 下令处决了她。",shape=box,color=red];
		j227929340 -> j852124521;
	j852124521 [label="首先，我们假设你所知道的一切都是正确的，并且他在那里的行为完全是出于他自己的意愿。我们假设没有任何其他政治操纵、勒索或其他幕后因素迫使他采取这种行动。",shape=box,color=blue];
		j852124521 -> j1778244554;
	j1778244554 [label="即便真是如此，即便 Ballas 完全没有受到任何影响就下令处死她，也要想想，一切都为时已晚。他感受到的背叛已经让他痛苦不堪。",shape=box,color=blue];
		j1778244554 -> j3971743947;
	j3971743947 [label="他的心和精神早已破碎。",shape=box,color=blue];
		j3971743947 -> j1914462709;
		j3971743947 -> j115816007;
	j1914462709 [label="如果你是想让我同情他，那我可不会这么做。",shape=box,color=red];
		j1914462709 -> j3528167984;
	j115816007 [label="是因为 Tenno 吗？还是因为他们对她所做的事？",shape=box,color=red];
		j115816007 -> j1037289747;
	j3528167984 [label="我并不是要你那样！哪怕一滴你能省出来撒在你埋他尸体地方的尿，Ballas 都配不上——如果他真的有坟墓的话。",shape=box,color=blue];
		j3528167984 -> j335394358;
	j1037289747 [label="某种程度上，两者都是。某种程度上，两者也不是。那天他下令处死她时，他已经彻底疯了。事实上，如果他内心深处对这件事的记忆有所缺失，我也不会感到惊讶。",shape=box,color=blue];
		j1037289747 -> j1882065657;
	j335394358 [label="我只是想说，在他下令处决她的那天，他已经是个疯子了。事后看来，如果他对自己所做的事情有些记忆模糊，我也不会感到惊讶。",shape=box,color=blue];
		j335394358 -> j1882065657;
	j1882065657 [label="Ballas 深爱着 Margulis。他倾尽所有，全心全意地爱着她。他愿意为她牺牲一切。他的灵魂，他的肉体，奥罗金帝国。任何你能想象到的东西。",shape=box,color=blue];
		j1882065657 -> j1719894471;
	j1719894471 [label="不惜任何代价。不惜牺牲任何道德。就算你递给他一个刚出生的婴儿，告诉他 Margulis 希望婴儿的脑浆摔在石头上，在你话还没说完之前，婴儿就已经死了。",shape=box,color=blue];
		j1719894471 -> j2102297130;
	j2102297130 [label="他本会将始源星系烧成灰烬，然后按照她的形象重建它，篡位者……但悲剧就在这里。",shape=box,color=blue];
		j2102297130 -> j778072446;
	j778072446 [label="Margulis？啊，Margulis。亲爱的、甜美的、可爱的 Margulis……她仍然有良知。",shape=box,color=blue];
		j778072446 -> j1166676519;
	j1166676519 [label="当她看到那些可怜的 Tenno，那些可怜的、被虚空撕裂的孩子们…… ",shape=box,color=blue];
		j1166676519 -> j3712650149;
	j3712650149 [label="她生命中有比 Ballas 更重要的东西。她生命中有值得她为之牺牲的东西……而那却不是他。",shape=box,color=blue];
		j3712650149 -> j1957336854;
	j1957336854 [label="也不是她对他的爱。",shape=box,color=blue];
		j1957336854 -> j2025820523;
	j2025820523 [label="我亲爱的漂泊者，而他明白这一点。从她第一眼看到他们起，他就明白了。而当她那些“疯狂的野兽”成了她最后看到的画面时，这一点更是彻底印证了他的想法。至少，在我们奥罗金人之间，流传着这样的传言。",shape=box,color=blue];
		j2025820523 -> j1457557889;
	j1457557889 [label="你能想象奥罗金人看到 Ballas 珍爱的哲士，被虚空撕裂、被狂暴的幼崽们烧瞎双眼时的喜悦吗？",shape=box,color=blue];
		j1457557889 -> j3167895699;
	j3167895699 [label="但​我​认为，​正​是​在​那​之前，​在​ Margulis ​奋力​拯​救 Tenno ​的​那​一​刻，​Ballas ​的​心碎成​了​无​数片，​再​也​没有​恢复​过来。​",shape=box,color=blue];
		j3167895699 -> j1921767364;
	j1921767364 [label="因为他知道，自己在她心里已经被取代了。",shape=box,color=blue];
		j1921767364 -> j1312355597;
	j1312355597 [label="我想正是因为这个原因，我才同情他。但之后发生的事呢？一段足以载入史册的爱情故事……最终却以如此令人心碎的悲剧收场。 ",shape=box,color=blue];
		j1312355597 -> j1406912607;
	j1406912607 [label="我真希望你能看到他们彼此对视时那种笑容……",shape=box,color=blue];
		j1406912607 -> j4032439670;
		j1406912607 -> j3996391372;
	j4032439670 [label="你可以美化他们之间的感情，但这并不能为他的人品开脱。Ballas 所做的一切，都不可饶恕。",shape=box,color=red];
		j4032439670 -> j646741833;
	j3996391372 [label="我很高兴他们的爱情是真挚的。他当时确实……很复杂。而且 Margulis 并非一直都被他玩弄于股掌之间。",shape=box,color=red];
		j3996391372 -> j3847998092;
	j646741833 [label="Add 1 to Thermostat counter",color=orange];
		j646741833 -> j2220937354;
	j3847998092 [label="Add -1 to Thermostat counter",color=orange];
		j3847998092 -> j3559189227;
	j2220937354 [label="+10 Chemistry",color=orange];
		j2220937354 -> j1454322755;
	j3559189227 [label="+10 Chemistry",color=orange];
		j3559189227 -> j3396772008;
	j1454322755 [label="篡位者，我并没有试图将两者相提并论。我只是想说，一个人既可以被爱，也可以做出可怕的事情。唉……看来我们这些堕落的傻瓜也无药可救了……",shape=box,color=blue];
		j1454322755 -> j1825289938;
	j3396772008 [label="确实如此。有时候想到，如果连那位堕落之王都能找到伴侣，我们其他人还有希望，这便让我感到一丝慰藉，嗯？哈！",shape=box,color=blue];
		j3396772008 -> j1825289938;
	j1825289938 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j1825289938 -> j2569814382;
	j2569814382 [label="今天我已经占用你太多时间了。你现在就可以走了。 ",shape=box,color=blue];
		j2569814382 -> "Chat ends.";
}