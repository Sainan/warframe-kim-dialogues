digraph {
	1995 [label="RoatheRank3Convo5 begins.",color=orange];
		1995 -> 1996;
	1996 [label="阿尔布雷希特从一开始就是个麻烦。他和他跟虚空的一切纠葛。我觉得把他交给格丽维娜，是希望有了家庭之后他就能安定下来。",shape=box,color=blue];
		1996 -> 1997;
	1997 [label="我觉得这反而让事情变得更糟。有了孩子之后，他就把他们当成额外的帮手，他疯狂实验的帮凶。",shape=box,color=blue];
		1997 -> 1998;
	1998 [label="可有可无。就像他生命中的所有事情一样。",shape=box,color=blue];
		1998 -> 2001;
		1998 -> 2000;
		1998 -> 1999;
	2001 [label="格丽维娜？",shape=box,color=red];
		2001 -> 2004;
	2000 [label="他觉得人不只是可有可无的消耗品。",shape=box,color=red];
		2000 -> 2003;
	1999 [label="[结束。]",shape=box,color=red];
		1999 -> 2002;
	2004 [label="一个可能已被历史遗忘的名字……阿尔布雷希特·英择谛的妻子，篡位者。他孩子们的母亲。",shape=box,color=blue];
		2004 -> 2006;
	2003 [label="好吧，我承认他会像任何执行者一样冷酷无情地杀害他生命中的任何人和物。但他不会无缘无故地这么做。",shape=box,color=blue];
		2003 -> 2005;
	2002 [label="Chat ends.",color=orange];
	2006 [label="Check boolean LoidFamilyComplete",color=orange];
		2006 -> 2009 [label=true,color=green];
		2006 -> 2010 [label=false,color=brown];
	2005 [label="你知道吗，现在我回想起来，正是他冷酷无情的本性让他在我们这个时代是如此的危险。以实现自己的目标为名义，他可以牺牲一切。什么都可以。",shape=box,color=blue];
		2005 -> 2007;
		2005 -> 2008;
	2009 [label="但你又来了，很可能又把我当傻子耍了——因为管家现在已经和他们重新联系上了，你已经知道这些信息的可能性很高。",shape=box,color=blue];
		2009 -> 2013;
	2010 [label="我们安然无恙地坐在这破败圣所深处，还有那些对我们的存在浑然不知的人们。我至今仍觉得这非常可笑。",shape=box,color=blue];
		2010 -> 2005;
	2007 [label="我原以为奥罗金人不会介意牺牲他们在乎的东西。你们看起来对彼此极其冷酷无情。",shape=box,color=red];
		2007 -> 2011;
	2008 [label="你怎么知道的？",shape=box,color=red];
		2008 -> 2012;
	2013 [label="但我不想再和你争论这个了。我没心情。",shape=box,color=blue];
		2013 -> 2005;
	2011 [label="漂流者，你对自己一无所知的事情，总是急于猜测。",shape=box,color=blue];
		2011 -> 2014;
	2012 [label="+10 Chemistry",color=orange];
		2012 -> 2015;
	2014 [label="或者你的皮肤上是不是有我没注意到的蓝色痕迹？你是奥罗金人吗？如果是的话，我致以最深切和最诚挚的歉意！ ",shape=box,color=blue];
		2014 -> 2016;
		2014 -> 2017;
	2015 [label="人们或许普遍误解我们奥罗金人只会互相背叛和残杀。没错，这种事确实不少，别误会我的意思。我们几乎是不死的，除此之外也没什么事可做。",shape=box,color=blue];
		2015 -> 2018;
	2016 [label="对不起，我不是有意冒犯你。老实说，我自己对奥罗金社会也没什么印象——我是局外人，只是旁观而已。",shape=box,color=red];
		2016 -> 2019;
	2017 [label="如果我对奥罗金社会的记忆不太美好，请见谅。我记忆中大多是扬声器系统里传出的录音命令。那是在我被困于虚空之前的事了……",shape=box,color=red];
		2017 -> 2020;
	2018 [label="但我们也是一个深深充满激情的民族。没有人像奥罗金人那样创作艺术。没有人像我们那样创作音乐、戏剧或诗歌。",shape=box,color=blue];
		2018 -> 2021;
	2019 [label="道歉我接受了。这就这一次。我​受够​了​这里​所有​人​的​这​种​不尊重。​就​算​你​很​迷人，​我​也​不​是​你们​的​活靶子。​我​有​更​好​的​方式​过​生活。​",shape=box,color=blue];
		2019 -> 2022;
	2020 [label="Update boolean RoatheInsulted",color=orange];
		2020 -> 2023;
	2021 [label="当我们的心爱上另一个人时，没有人比我们爱得更深。",shape=box,color=blue];
		2021 -> 2024;
	2022 [label="我刚才说到哪里了？啊，对。我们那冷漠的英择谛。",shape=box,color=blue];
		2022 -> 2015;
	2023 [label="警告你。我受够了这里所有人的这种不尊重。就算你很迷人，我也不是你们的活靶子。我有更好的方式过生活。",shape=box,color=blue];
		2023 -> 2022;
	2024 [label="除了阿尔布雷希特。他所做的每一件事，和他互动的每一个人，都像是他透过自己心爱的玻璃窗的一部分来观察的。",shape=box,color=blue];
		2024 -> 2025;
	2025 [label="疏离。冷漠。漠不关心。无动于衷。即使在格丽维娜去世时，留下他独自抚养他那可怜的小女儿，他也依旧如此。",shape=box,color=blue];
		2025 -> 2026;
	2026 [label="Check boolean LoidFamilyComplete",color=orange];
		2026 -> 2028 [label=true,color=green];
		2026 -> 2027 [label=false,color=brown];
	2028 [label="按理说，他很可能预期要取得比他以往任何时候都要多的成就。如果她没被感染，也可以离开的话。太可惜了。",shape=box,color=blue];
		2028 -> 2031;
		2028 -> 2032;
	2027 [label="按理说，她很可能预期要取得比他以往任何时候都要多的成就。我迫不及待地想看看她和英择谛家族最终的下场。看看他们所有的…… Infested 辉煌。",shape=box,color=blue];
		2027 -> 2029;
		2027 -> 2030;
	2031 [label="我很高兴我们成功说服洛德上了楼。",shape=box,color=red];
		2031 -> 2035;
	2032 [label="我知道你可能不记得我们为什么要这么做了，但我们成功地让洛德上楼是件好事。",shape=box,color=red];
		2032 -> 2036;
	2029 [label="我​还​在​想​这​是​不​是​最好​的​想法……",shape=box,color=red];
		2029 -> 2033;
	2030 [label="如果我们成功说服洛德上楼，你接下来打算做什么？",shape=box,color=red];
		2030 -> 2034;
	2035 [label="你说得轻松。而我却像个傻瓜一样站在那里，守着他们，听他们谈论重聚的话题，就好像我记得那件事发生似的。你知道这有多尴尬吗？！",shape=box,color=blue];
		2035 -> 2039;
	2036 [label="你知道有多尴尬吗？我明明什么都想不起来，却还要站在那里假装记得团聚发生过？！",shape=box,color=blue];
		2036 -> 2039;
	2033 [label="嗯，很可能不是。我很好奇，你恰好有阿尔布雷希特的转寄地址吗？",shape=box,color=blue];
		2033 -> 2037;
	2034 [label="我还没想好。或许我会开始砍掉他们的四肢，然后把它们泡在液体里保存起来。你不会刚好有阿尔布雷希特的转寄地址吧？",shape=box,color=blue];
		2034 -> 2038;
	2039 [label="这就像你站在一个盛大的晚会现场，有人朝你走过来，清楚地知道你是谁，可你对这个人一点印象都没有，却不得不装作记得，而且还要继续交谈！",shape=box,color=blue];
		2039 -> 2042;
	2037 [label="没有，你为什么这么问？",shape=box,color=red];
		2037 -> 2040;
	2038 [label="什么？！",shape=box,color=red];
		2038 -> 2041;
	2042 [label="你就一点都不知道你让我陷入了怎样的地狱般的境地吗？！哪怕一丝一毫？！站在那儿简直是煎熬，而这一切都是你的错！ ",shape=box,color=blue];
		2042 -> 2044;
	2040 [label="我当时想，等我上了楼，我就要开始砍掉他家人的四肢，然后把它们装进很多罐子里，一个接一个地寄给阿尔布雷希特。",shape=box,color=blue];
		2040 -> 5776;
	2041 [label="+10 Chemistry",color=orange];
		2041 -> 2043;
	2044 [label="唉，够了。我得喝一杯。",shape=box,color=blue];
		2044 -> 2046;
	5776 [label="什么？！",shape=box,color=red];
		5776 -> 2041;
	2043 [label="你冷静点！这里没人开得了玩笑吗？",shape=box,color=blue];
		2043 -> 2045;
	2046 [label="+10 Chemistry",color=orange];
		2046 -> 2048;
	2045 [label="无论如何，哪来的人帮我寄出去呢？",shape=box,color=blue];
		2045 -> 2047;
	2048 [label="Chat ends.",color=orange];
	2047 [label="Chat ends.",color=orange];
}