	"Chat ends." [color=orange];
	j968802257 [label="语音留言：遗忘",shape=box,color=blue];
		j968802257 -> j1708749846;
	j1708749846 [label="文字记录：懦夫。",shape=box,color=blue];
		j1708749846 -> j4107206337;
	j4107206337 [label="他们都这么叫我，不是吗？我读了那些散落在这座布满灰尘的大厅里的历史书。这是谎言。他们不知道真相。我在完成我的工作之前，就被强行从属于我的时代里夺走了。",shape=box,color=blue];
		j4107206337 -> j4160353027;
	j4160353027 [label="懦夫。",shape=box,color=blue];
		j4160353027 -> j3451967873;
	j3451967873 [label="我现在想起来了。他在金碧辉煌的大厅里向我走来。他戴着一张我不认识的面具。但这对于我们这类人来说并不算什么稀奇事。我认得他的声音。我认得他的举止。",shape=box,color=blue];
		j3451967873 -> j3920582274;
	j3920582274 [label="懦夫！",shape=box,color=blue];
		j3920582274 -> j1772771386;
	j1772771386 [label="他只问了我一个问题。我真的相信在我把一切都烧成灰烬之后，我能得到宽恕吗？",shape=box,color=blue];
		j1772771386 -> j3157285895;
	j3157285895 [label="懦夫！",shape=box,color=blue];
		j3157285895 -> j863949458;
	j863949458 [label="在那只苍白、伸向我的手中……握着的是一支注射器。它闪耀着自由的光芒……闪耀着另一次机会……闪耀着新生。",shape=box,color=blue];
		j863949458 -> j1904437146;
	j1904437146 [label="我接过了它。",shape=box,color=blue];
		j1904437146 -> j3663093416;
	j3663093416 [label="懦夫！",shape=box,color=blue];
		j3663093416 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}