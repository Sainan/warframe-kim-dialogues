	2325 [label="Chat ends.",color=orange];
	2321 [label="文字记录：懦夫。",shape=box,color=blue];
		2321 -> 5725;
	5725 [label="他们都这么叫我，不是吗？我读了那些散落在这座布满灰尘的大厅里的历史书。这是谎言。他们不知道真相。我在完成我的工作之前，就被强行从属于我的时代里夺走了。",shape=box,color=blue];
		5725 -> 5726;
	5726 [label="懦夫。",shape=box,color=blue];
		5726 -> 5727;
	5727 [label="我现在想起来了。他在金碧辉煌的大厅里向我走来。他戴着一张我不认识的面具。但这对于我们这类人来说并不算什么稀奇事。我认得他的声音。我认得他的举止。",shape=box,color=blue];
		5727 -> 5728;
	5728 [label="懦夫！",shape=box,color=blue];
		5728 -> 5729;
	5729 [label="他只问了我一个问题。我真的相信在我把一切都烧成灰烬之后，我能得到宽恕吗？",shape=box,color=blue];
		5729 -> 5730;
	5730 [label="懦夫！",shape=box,color=blue];
		5730 -> 2320;
	2320 [label="在那只苍白、伸向我的手中……握着的是一支注射器。它闪耀着自由的光芒……闪耀着另一次机会……闪耀着新生。",shape=box,color=blue];
		2320 -> 2324;
	2324 [label="我接过了它。",shape=box,color=blue];
		2324 -> 5735;
	5735 [label="懦夫！",shape=box,color=blue];
		5735 -> 2319;
	2319 [label="Add 1 to HellStory",color=orange];
		2319 -> 2348;
	2348 [label="{\"Id\":2348,\"Incoming\":[2319],\"Outgoing\":[2323],\"GraphPos\":[6245,-3270],\"CompletionType\":1}",color=orange];
		2348 -> 2323;
	2323 [label="Chat ends.",color=orange];
}