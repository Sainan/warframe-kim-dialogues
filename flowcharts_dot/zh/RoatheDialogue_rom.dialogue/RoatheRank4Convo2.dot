	2409 [label="你有手段，也有实力，你已经充分表达了对现状的不满。",shape=box,color=red];
		2409 -> 2413;
	2410 [label="我实在不明白，为什么“Tau 之恶魔”甘愿待在墓穴里无所事事。尤其是在我们达成了交易。",shape=box,color=red];
		2410 -> 2414;
	2411 [label="你是奥罗金人。很显然你憎恨周围的每一个人。是什么让你没这么做？",shape=box,color=red];
		2411 -> 2415;
	2408 [label="我实在不明白，为什么“Tau 之恶魔”甘愿待在墓穴里无所事事。尤其是在我们之间没有任何交易的情况下。",shape=box,color=red];
		2408 -> 2412;
	2413 [label="+5 Chemistry",color=orange];
		2413 -> 2418;
	2414 [label="Check boolean RoatheKnowsReset2",color=orange];
		2414 -> 2420 [label=true,color=green];
		2414 -> 2419 [label=false,color=brown];
	2415 [label="请允许我花点时间整理一下思绪，然后再开始这段充满愤怒和怨恨的对话。",shape=box,color=blue];
		2415 -> 2421;
	2412 [label="Check boolean RoatheKnowsReset2",color=orange];
		2412 -> 2417 [label=true,color=green];
		2412 -> 2416 [label=false,color=brown];
	2418 [label="我很高兴你意识到，我完全有能力轻而易举地把这里变成屠宰场。",shape=box,color=blue];
		2418 -> 2424;
	2420 [label="因为我至今仍搞不懂，我为何如此信任你，告诉你那么多事，而你却背叛了这份信任，篡位者。",shape=box,color=blue];
		2420 -> 2423;
	2419 [label="篡位者，我还有事情要做。如果我把附近所有人都杀光，你又怎么能帮我恢复所有记忆呢？",shape=box,color=blue];
		2419 -> 2422;
	2421 [label="我正在努力克制自己，不立刻证明你的观点是正确的。",shape=box,color=blue];
		2421 -> 2425;
	2417 [label="因为我至今仍搞不懂，我为何如此信任你，告诉你那么多事，而你却背叛了这份信任，篡位者。",shape=box,color=blue];
		2417 -> 2423;
	2416 [label="也许我希望你能幡然醒悟，改变主意。如果我把附近所有人都屠杀殆尽，那么成功的几率就会急剧下降，不是吗？",shape=box,color=blue];
		2416 -> 2422;
	2424 [label="但这样做也于事无补吧？战争教会我们的一件事就是，杀戮最终带来的收益少得惊人。",shape=box,color=blue];
		2424 -> 2427;
	2423 [label="如果我把附近所有人都屠杀殆尽，那么成功的几率就会急剧下降，不是吗？战争教会我们的一件事就是，杀戮最终带来的收益少得惊人。",shape=box,color=blue];
		2423 -> 2426;
	2422 [label="此外，这样做也于事无补吧？战争教会我们的一件事就是，杀戮最终带来的收益少得惊人。",shape=box,color=blue];
		2422 -> 2426;
	2425 [label="我理解你对奥罗金人的憎恨。相信我，大多数奥罗金人都鄙视自己。我并非不了解我们犯下的罪行，我们犯下的种种暴行。 ",shape=box,color=blue];
		2425 -> 2428;
	2427 [label="尽管偶尔也会忍不住想去这么干，其实这样做也挺让人愉快的。",shape=box,color=blue];
		2427 -> 2431;
		2427 -> 2430;
		2427 -> 2429;
	2426 [label="尽管偶尔也会忍不住想去这么干，其实这样做也挺让人愉快的。",shape=box,color=blue];
		2426 -> 2429;
		2426 -> 2430;
		2426 -> 2431;
	2428 [label="单单是青春厅堂这件事就足以让我们的社会彻底毁灭。但你却怪罪整个民族——顺便一提，你也是这个民族的产物，而我的篡位者，你还是这个民族的元老！",shape=box,color=blue];
		2428 -> 2432;
	2431 [label="所以，你放过所有人的唯一原因就是因为杀了他们毫无意义？",shape=box,color=red];
		2431 -> 2435;
	2430 [label="除此之外，你没有其他让所有人都活下来的理由吗？",shape=box,color=red];
		2430 -> 2434;
	2429 [label="连玛丽和里昂也算在内吗？",shape=box,color=red];
		2429 -> 2433;
	2432 [label="你对那些曾在金碧辉煌的建筑内辛勤劳作、最终逝去的善良灵魂一无所知。那些关于他们的传奇故事，如今已湮没在历史长河中。",shape=box,color=blue];
		2432 -> 2436;
	2435 [label="杀了他们毫无意义，不是吗？你是想说服我改变想法吗？篡位者，我真是佩服你——我万万没想到你居然是这么阴险狡诈的家伙！",shape=box,color=blue];
		2435 -> 2438;
		2435 -> 2439;
	2434 [label="篡位者，如果你想故弄玄虚地暗示什么，那就直接说出来吧。",shape=box,color=blue];
		2434 -> 2438;
		2434 -> 2439;
	2433 [label="我相当肯定，如果你来到墓穴，发现狂热分子曾经站立的地方有两处血迹，我肯定会被狠狠训斥一顿，对吧？",shape=box,color=blue];
		2433 -> 2437;
	2436 [label="仅仅因为你对此一无所知，人们早已为那些因无人知晓的悲剧泪流成河。",shape=box,color=blue];
		2436 -> 2440;
	2438 [label="承认自己享受与人相处的时光也无妨。人存在的意义远不止于提供实用价值。",shape=box,color=red];
		2438 -> 2441;
	2439 [label="承认我们能排解你的孤独感也无妨，虽然我们会惹你心烦。",shape=box,color=red];
		2439 -> 2442;
	2437 [label="可能是你，也可能是管家，或者是那个Tenno，又或者是 Tenno 那可怕的“母亲”。唉，那个人。那个人让我很烦。以后再说吧。",shape=box,color=blue];
		2437 -> 2439;
		2437 -> 2438;
	2440 [label="我听到你那个孩子一遍遍地哭喊着阿迪斯的名字。 ",shape=box,color=blue];
		2440 -> 2443;
	2441 [label="Add 1 to Thermostat",color=orange];
		2441 -> 2444;
	2442 [label="Add -1 to Thermostat",color=orange];
		2442 -> 2445;
	2443 [label="阿迪斯只是芸芸众生中的一个。",shape=box,color=blue];
		2443 -> 2446;
	2444 [label="Evaluate expressions",color=orange];
		2444 -> 2448 [label="RoatheUnloved2",color=purple];
		2444 -> 2448 [label="RoatheUnloved1",color=purple];
		2444 -> 2448 [label="RoatheAlone1",color=purple];
		2444 -> 2448 [label="RoatheBirdThree",color=purple];
		2444 -> 2447 [label="false",color=purple];
	2445 [label="Evaluate expressions",color=orange];
		2445 -> 2449 [label="RoatheUnloved2",color=purple];
		2445 -> 2449 [label="RoatheUnloved1",color=purple];
		2445 -> 2449 [label="RoatheAlone1",color=purple];
		2445 -> 2449 [label="RoatheBirdThree",color=purple];
		2445 -> 2450 [label="false",color=purple];
	2446 [label="他​的​名字​对​你​来说​是​独特​的。​",shape=box,color=blue];
		2446 -> 2451;
	2448 [label="篡位者，别得寸进尺。“享受”说得有点夸张了。更确切地说，你只是渐渐融入我的生活罢了。就像霉菌一样。",shape=box,color=blue];
		2448 -> 2453;
	2447 [label="“享受？”这就是享受吗？我从未意识到自己竟然如此受虐。嗯。或者，这仅仅是我身体逐渐腐烂的感觉，以及你们所有人“渐渐融入我的生活”的感觉？",shape=box,color=blue];
		2447 -> 2452;
	2449 [label="有​人​可以​聊天​还是​挺​让​人​享受​的。​即使​你们​有时候​确实像​你​说​的​那样，​挺​让​人​心烦。​",shape=box,color=blue];
		2449 -> 2454;
	2450 [label="孤独？呸。你们唯一阻止的，就是我生活中那一点点正在恢复的理智。如果你想暗示你们这帮人“渐渐融入我的生活”，你知道还有什么也像你们这样的吗？",shape=box,color=blue];
		2450 -> 2455;
	2451 [label="但​对于​星系来​说​不​是。​",shape=box,color=blue];
		2451 -> 2456;
	2453 [label="+5 Chemistry",color=orange];
		2453 -> 2457;
	2452 [label="就像霉菌一样。",shape=box,color=blue];
		2452 -> 2457;
	2454 [label="+5 Chemistry",color=orange];
		2454 -> 2458;
	2455 [label="是霉菌。",shape=box,color=blue];
		2455 -> 2457;
	2456 [label="随便你，尽管将我们族人染成血红吧。熔化奥罗金黄金，称我们为怪物吧。我们罪有应得，你可以尽情地对我们恶语相向。",shape=box,color=blue];
		2456 -> 2459;
	2457 [label="Update boolean RoatheAlone2",color=orange];
		2457 -> 2460;
	2458 [label="我得承认，你……就像霉菌一样，在我身上蔓延开来。",shape=box,color=blue];
		2458 -> 2457;
	2459 [label="但千万不要以为我们就只有那点本事。",shape=box,color=blue];
		2459 -> 2461;
	2460 [label="Check boolean LoidFamilyComplete",color=orange];
		2460 -> 2462 [label=true,color=green];
		2460 -> 2463 [label=false,color=brown];
	2461 [label="如果你想彻底消灭所有奥罗金人？那就走上楼梯。你会看到一些幸存的奥罗金人，他们逃不出你的魔爪。就从“祖母”开始吧。",shape=box,color=blue];
		2461 -> 2464;
	2462 [label="+10 Chemistry",color=orange];
		2462 -> 2465;
	2463 [label="篡位者，我不去做出那些疯狂、嗜血、骇人听闻的暴行，其实还有另一个原因。",shape=box,color=blue];
		2463 -> 2466;
	2464 [label="毕竟，她见识过我们这类人最多。",shape=box,color=blue];
		2464 -> 2467;
	2465 [label="Chat ends.",color=orange];
	2466 [label="我还没看到我们亲爱的管家和楼上阿尔布雷希特疏远的家人之间的小插曲的结局。",shape=box,color=blue];
		2466 -> 2468;
	2467 [label="Update boolean RoatheNoDate",color=orange];
		2467 -> 2469;
	2468 [label="别忘了，无论我们是否达成交易，我在这件事上都投入了个人利益。我想要保证当阿尔布雷希特第一次踏入这圣所时，他看到的第一张脸是——",shape=box,color=blue];
		2468 -> 2470;
	2469 [label="Chat ends.",color=orange];
	2470 [label="我。",shape=box,color=blue];
		2470 -> 2471;
	2471 [label="我只是还没决定好，当他死去的时候，我要不要让他亲人的尸体也倒在我周围。",shape=box,color=blue];
		2471 -> 2472;
	2472 [label="这可怎么选呢……",shape=box,color=blue];
		2472 -> 2473;
	2473 [label="+10 Chemistry",color=orange];
		2473 -> 2474;
	2474 [label="Chat ends.",color=orange];
