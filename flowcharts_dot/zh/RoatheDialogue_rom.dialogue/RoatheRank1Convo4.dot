	508 [label="+5 Chemistry",color=orange];
		508 -> 516;
	509 [label="Check boolean DrifterRoathe",color=orange];
		509 -> 517 [label=true,color=green];
		509 -> 518 [label=false,color=brown];
	510 [label="所以你承认你是在浪费我的时间。太好了！我可不是什么满脸皱纹、老态龙钟的老人，因为记不起其他战争故事，所以只能反复讲述这唯一的故事。",shape=box,color=blue];
		510 -> 519;
	515 [label="我正准备开始滔滔不绝地讲述奥罗金社会，想着或许你会有点兴趣。然后我又提醒自己，这些你很可能早就听过了，不是吗？",shape=box,color=blue];
		515 -> 500;
		515 -> 501;
		515 -> 502;
	514 [label="这也好，因为如果没有你或孩子先完成这一步，我们几乎不可能取得任何进展。否则，我担心我们一派管家上楼，他就会立刻被揍成肉酱。",shape=box,color=blue];
		514 -> 522;
	513 [label="对了，你有没有重新考虑过我的提议？我安静地坐在这里，帮你调解管家和楼上那些被感染的、被遗弃的奥罗金流放者之间的矛盾？",shape=box,color=blue];
		513 -> 520;
		513 -> 521;
	512 [label="你最好先想办法解决这个问题，然后再考虑让管家上楼。免得他在这个过程中变成肉酱。",shape=box,color=blue];
		512 -> 522;
	511 [label="对​了，​你​有​没​有​重新​考虑​过​我​的​提议？​我​安静​地​坐​在​这里，​帮​你​调解​管家​和​楼上​那些​被​感染​的、​被​遗弃​的​ O​rokin 流放者​之间​的​矛盾？​调解​家庭​矛盾​是​第一步，​不过……​",shape=box,color=blue];
		511 -> 520;
		511 -> 521;
	516 [label="你竟然让一个奥罗金人开口说话。你根本不知道自己做了什么。要是一个不注意，你得在这里待上一个小时。",shape=box,color=blue];
		516 -> 523;
	517 [label="+5 Chemistry",color=orange];
		517 -> 524;
	518 [label="哦？那么，“请问”这是为什么呢？",shape=box,color=blue];
		518 -> 528;
		518 -> 527;
		518 -> 525;
		518 -> 526;
	519 [label="我之所以记不起这段对话，就是因为你，看着你就像照镜子一样！",shape=box,color=blue];
		519 -> 529;
	522 [label="你必须明白一点，管家和英择谛家族虽然与奥罗金关系疏远，但他们终究还是奥罗金人。他们出生并成长于这个社会，尽管这个社会……存在诸多缺陷。",shape=box,color=blue];
		522 -> 532;
	520 [label="不，罗瑟，我不会改变主意。这并不重要。",shape=box,color=red];
		520 -> 530;
	521 [label="我有。我……同意。",shape=box,color=red];
		521 -> 531;
	523 [label="不过漂泊者，我想你可能没多少机会和奥罗金人接触吧？毕竟那孩子过着和你截然不同的生活。",shape=box,color=blue];
		523 -> 533;
	524 [label="嗯，没错。我们都知道为什么，对吧？但你必须耐心等待。",shape=box,color=blue];
		524 -> 534;
	528 [label="[表白心意] 我想你知道的。",shape=box,color=red];
		528 -> 538;
	527 [label="我觉得你很有意思。",shape=box,color=red];
		527 -> 537;
	525 [label="我几乎没什么和奥罗金人接触的机会。除了……和他们战斗。倒是你非常不错。",shape=box,color=red];
		525 -> 535;
	526 [label="算了。[结束]",shape=box,color=red];
		526 -> 536;
	529 [label="Chat ends.",color=orange];
	532 [label="尽管罪恶滔天，等级和秩序却从未受到质疑。无论是在军队中，还是在社会结构中，皆是如此。哲士服从奥罗金人，奥罗金人服从执行者，执行者服从皇帝……至少名义上如此。",shape=box,color=blue];
		532 -> 541;
	530 [label="随你便吧。但这扇门不会一直开着。",shape=box,color=blue];
		530 -> 539;
	531 [label="Update boolean RoatheNoDeal",color=orange];
		531 -> 540;
	533 [label="据我所知，你的人生就是在扎里曼 10-0 号悲剧发生时偏离了轨道。",shape=box,color=blue];
		533 -> 542;
		533 -> 543;
		533 -> 544;
	534 [label="与此同时，如果你想“听听”，我很乐意奉陪。不过，先提醒你一下，你请的是一位奥罗金人说话。",shape=box,color=blue];
		534 -> 545;
	538 [label="+5 Chemistry",color=orange];
		538 -> 549;
	537 [label="+5 Chemistry",color=orange];
		537 -> 548;
	535 [label="知己知彼，是吗？或者仅仅是出于好奇，想与一个不可能的人面对面交流？ ",shape=box,color=blue];
		535 -> 546;
	536 [label="鱼儿，你想怎么挣扎都行，是你自己游到我这儿来的。",shape=box,color=blue];
		536 -> 547;
	541 [label="即便你不相信，即便过了这么久，传统也许能让洛德听我的话？想想看，我可是很有说服力的。毕竟，我曾是那些最邪恶的执行者的得力助手。",shape=box,color=blue];
		541 -> 551;
		541 -> 552;
		541 -> 553;
	539 [label="Chat ends.",color=orange];
	540 [label="Update boolean RoatheDeal",color=orange];
		540 -> 550;
	542 [label="对。在扎里曼之前，我没和奥罗金人打过交道——至于之后嘛……我想你大概已经听说了。",shape=box,color=red];
		542 -> 554;
	543 [label="我跟奥罗金人打过不少交道，知道千万别相信他们。",shape=box,color=red];
		543 -> 555;
	544 [label="很遗憾，我对你们这类人并没有比那孩子更多的爱。",shape=box,color=red];
		544 -> 555;
	545 [label="你根本不知道自己做了什么。要是一个不注意，你得在这里待上一个小时。",shape=box,color=blue];
		545 -> 523;
	549 [label="嗯，我知道。我还以为你会好心写出来给我看呢。唉……",shape=box,color=blue];
		549 -> 557;
	548 [label="你这么觉得吗？嗯。那我们就看看我能把这条鱼叉住多久吧。",shape=box,color=blue];
		548 -> 534;
	546 [label="+5 Chemistry",color=orange];
		546 -> 556;
	547 [label="Chat ends.",color=orange];
	551 [label="执行者中最坏的是 Ballas。",shape=box,color=red];
		551 -> 559;
	552 [label="你侍奉的是哪一位？",shape=box,color=red];
		552 -> 560;
	553 [label="怎么说？",shape=box,color=red];
		553 -> 561;
	550 [label="+5 Chemistry",color=orange];
		550 -> 558;
	554 [label="确实如此。啊，Ballas。你或许会惊讶地发现，他并非他们中最恶劣的一个。",shape=box,color=blue];
		554 -> 562;
		554 -> 563;
	555 [label="我想我不会责怪你。我以为他们还能挽救。某种程度上来说，可以熔化——重塑，重铸，就像黄金一样。",shape=box,color=blue];
		555 -> 564;
	557 [label="或许改日再说吧。篡位者啊，你得学会珍惜这些时刻。",shape=box,color=blue];
		557 -> 566;
	556 [label="令人尊敬，甚至睿智。如果我也有机会与一位 Sentient 生物交谈，甚至成为朋友，我也会这样做。 ",shape=box,color=blue];
		556 -> 565;
	559 [label="我尊重你的观点，也不会因此责怪你。Ballas 是个蠢货，但他确实是数一数二的堕落者，这一点我不会和你争论。",shape=box,color=blue];
		559 -> 567;
	560 [label="Evaluate expressions on HellStory",color=orange];
		560 -> 569 [label="x >= 1",color=purple];
		560 -> 568 [label="x <= 1",color=purple];
		560 -> 568 [label="false",color=purple];
	561 [label="我​知道​你​曾​与​ Ballas ​有​过私下​接触，​所以​你​认为​他​是​七位​黄金之​主中​最​邪恶​的​一​个，​我​完全​理解。​他​的​确​是​数​一​数二​的​堕落者，​这​一​点​我​同意。​",shape=box,color=blue];
		561 -> 570;
	558 [label="太好了！我很高兴你终于醒悟了。现在我们终于可以取得一些进展了。",shape=box,color=blue];
		558 -> 522;
	562 [label="真的吗？",shape=box,color=red];
		562 -> 571;
	563 [label="你很难让我相信这一点。",shape=box,color=red];
		563 -> 571;
	564 [label="好​吧。​除了​那些​执行者。​他们​已经​没​救​了。​你​或许会​惊讶​地​发现，​Ballas ​还​不​是​他们​中​最​坏​的。​",shape=box,color=blue];
		564 -> 563;
		564 -> 562;
	566 [label="Update boolean DrifterRoathe",color=orange];
		566 -> 534;
	565 [label="如果你在战场上遇到他们——甚至是你的前盟友——这会给你带来心理上的好处。",shape=box,color=blue];
		565 -> 572;
	567 [label="虽然事实上​我​并​没有​亲眼​目睹​这个​“合​一众”​事件​的​恐怖​之处，​只​从​管家​那里、​以及​从​这​台​石榴 2 代​机器​上​的​记录​中​了解​而​已。",shape=box,color=blue];
		567 -> 573;
	569 [label="你以前听我提起过她。更重要的是，我还透露过我们的计划。不过，那是另一个故事了。执行者尼托。确切地说，是摄政王执行者尼托。我们所有军队的统帅，也是黄金七人众中最凶残、最致命的一位。",shape=box,color=blue];
		569 -> 574;
	568 [label="执行者尼托。准确地说，是摄政王执行者尼托。奥罗金帝国所有军队的统帅。也是黄金七人众中最凶残、最致命的一位。",shape=box,color=blue];
		568 -> 574;
	570 [label="甚至很有可能，他在这场我从管家那里听说的、以及我在石榴 2 代中读到的“合一众”事件中，超越了过去那些执行者。",shape=box,color=blue];
		570 -> 573;
	571 [label="我不是说他是圣人。我只是告诉你，即使是最邪恶的恶魔，也只是比他的同辈略逊一筹而已。篡位者，我这不过是吹毛求疵罢了。",shape=box,color=blue];
		571 -> 575;
	572 [label="好吧，如果你想“听听”，我很乐意奉陪。不过，先提醒你一下，你竟然让一个奥罗金人开口说话。",shape=box,color=blue];
		572 -> 545;
	573 [label="不过，我也认为，这或许是因为你与 Ballas 的私人关系非常密切，而与其他六位的互动却非常有限，才让你产生了这种印象。",shape=box,color=blue];
		573 -> 574;
	574 [label="黄金七人众？呸。漂泊者，你知道黄金最好的一点是什么吗？它可以无限熔化，然后重新制成更好的东西。",shape=box,color=blue];
		574 -> 576;
	575 [label="但 Ballas 是罪大恶极的吗？或许对你而言是。而且，或许他在这个时期的罪行比以前那些执行者还要严重。",shape=box,color=blue];
		575 -> 577;
	576 [label="我曾相信——某种程度上现在依然相信——奥罗金人还有救。我们本可以扭转帝国的颓势。但执行者呢？不，必须阻止他们。他们在每一种程度上，都是人类所能展现的最邪恶的化身。",shape=box,color=blue];
		576 -> 578;
	577 [label="但如果你亲眼见过那片血红的湖泊，以及遍地弯曲破碎的尸体，就像许多被丢弃的儿童玩具——",shape=box,color=blue];
		577 -> 579;
	578 [label="篡位者，这话是我说的。所以，请允许我，Tau 的恶魔本人，以一个行家的身份向你保证，Ballas 并非他们中最差的。",shape=box,color=blue];
		578 -> 580;
	579 [label="如果你亲眼目睹过尼托几乎不费吹灰之力就能造成的毁灭性破坏…… ",shape=box,color=blue];
		579 -> 581;
	580 [label="Check boolean RoatheUsurper",color=orange];
		580 -> 583 [label=true,color=green];
		580 -> 584 [label=true,color=green];
		580 -> 582 [label=false,color=brown];
		580 -> 583 [label=false,color=brown];
		580 -> 584 [label=false,color=brown];
	581 [label="但除非亲眼目睹，否则很难体会到这种恐怖。这种悲剧无法用数字来衡量。我可以长篇大论地讲述我所见所闻，但对你而言，它们仅仅是故事而已。",shape=box,color=blue];
		581 -> 585;
	583 [label="你很难让我相信这一点。",shape=box,color=red];
		583 -> 587;
	584 [label="真的吗？",shape=box,color=red];
		584 -> 587;
	582 [label="你为什么老是叫我“篡位者”？",shape=box,color=red];
		582 -> 586;
	585 [label="对你来说，Ballas 永远是那个更加真实、更加令人恐惧的恶棍。这也在情理之中。",shape=box,color=blue];
		585 -> 588;
