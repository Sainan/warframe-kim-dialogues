		490 -> 495 [label=false,color=brown];
	492 [label="Update boolean RoatheKnowsReset",color=orange];
		492 -> 500;
		492 -> 501;
		492 -> 502;
	498 [label="我正准备开始滔滔不绝地讲述奥罗金社会，想着或许你会有点兴趣。然后我又提醒自己，你来找我不是为了这个，对吧漂泊者？你还有别的把戏要玩……",shape=box,color=blue];
		498 -> 506;
	497 [label="我正准备开始滔滔不绝地讲述奥罗金社会，想着或许你会有点兴趣。然后我又提醒自己，这些你很可能早就听过了，不是吗？",shape=box,color=blue];
		497 -> 505;
	499 [label="你希望我只是配合你吗？还是……你这么做另有目的？我实在不明白你玩这种残酷的游戏到底想得到什么。",shape=box,color=blue];
		499 -> 507;
	494 [label="是的，我从殁世械灵那里听说了。不过自从你或孩子努力解决这些问题后，他们的问题似乎减少了。至少他们不再像以前那样——字面意思上——互相撕裂了。",shape=box,color=blue];
		494 -> 504;
	493 [label="是的，我从殁世械灵那里听说了。看来他们仍然执意撕得四分五裂。",shape=box,color=blue];
		493 -> 503;
	496 [label="嗯？啊。那个殁世械灵告诉我，你或者那个孩子四处乱窜，帮他们编造假名，因为他们忘记了自己原来的名字。你喊他叫“维尔科”。但我认识他时，他叫彼得罗·沃顿。是自豪的殁世机甲舰队发明者。",shape=box,color=blue];
		496 -> 504;
	495 [label="嗯？啊。我以前认识他，他叫彼得罗·沃顿，是自豪的殁世机甲舰队发明者。但殁世械灵告诉我，他们都忘了自己的名字。你可能只知道他叫“父亲”。",shape=box,color=blue];
		495 -> 503;
	500 [label="不，我以前没听过。请继续。",shape=box,color=red];
		500 -> 508;
	501 [label="罗瑟，我跟你说话……是因为我想跟你说话。",shape=box,color=red];
		501 -> 509;
	502 [label="没错，我之前听说过。但请你再说一遍。",shape=box,color=red];
		502 -> 510;
