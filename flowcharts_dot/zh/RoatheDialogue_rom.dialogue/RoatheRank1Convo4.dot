digraph {
	472 [label="RoatheRank1Convo4 begins.",color=orange];
		472 -> 473;
	473 [label="Check boolean LoidFamilyComplete",color=orange];
		473 -> 474 [label=true,color=green];
		473 -> 475 [label=false,color=brown];
	474 [label="欧拉瑞娅和彼得罗的遭遇简直令人唏嘘。我们之间从来就不是朋友，这一点毋庸置疑。但他们毕竟是奥罗金人。如今，我们奥罗金人所剩无几。不过，我想我还是应该谨言慎行——谁知道假以时日，我会变成什么样呢？",shape=box,color=blue];
		474 -> 476;
	475 [label="我觉得欧拉瑞娅和彼得罗竟然一点儿都没察觉到我们在这里，真是太滑稽了。我们就像老鼠一样，在他们脚下乱窜。你和孩子们是怎么把这一切瞒这么久的？",shape=box,color=blue];
		475 -> 477;
	476 [label="最让我毫不意外的是，“祖母”居然还活着。（想想也是，竟然把 Dagath 这么好的名字送人了。）",shape=box,color=blue];
		476 -> 478;
		476 -> 479;
	477 [label="Evaluate expressions on HellStory",color=orange];
		477 -> 481 [label="x >= 21",color=purple];
		477 -> 480 [label="x < 21",color=purple];
		477 -> 480 [label="false",color=purple];
	478 [label="彼得罗？",shape=box,color=red];
		478 -> 482;
	479 [label="你觉得他们的孩子怎么样？",shape=box,color=red];
		479 -> 483;
	481 [label="说实话，我更惊讶的是“祖母”居然搞不清状况。（想想也是，居然把 Dagath 这么好的名字白白送人了。）我还以为她看得更清楚一些。",shape=box,color=blue];
		481 -> 486;
	480 [label="说实话，我更惊讶的是“祖母”居然搞不清状况。（想想也是，居然把 Dagath 这么好的名字白白送人了。）我还以为她更聪明一些。",shape=box,color=blue];
		480 -> 484;
		480 -> 485;
	482 [label="嗯？啊。那个殁世械灵告诉我，你或者那个孩子四处乱窜，帮他们编造假名，因为他们忘记了自己原来的名字。你喊他叫“维尔科”。",shape=box,color=blue];
		482 -> 487;
	483 [label="男孩任性、烦人、以自我为中心，简直就是个典型的奥罗金人。“凯莉”（她现在更喜欢别人这么叫她），我觉得她非常聪明，几乎值得我忍受她的存在。",shape=box,color=blue];
		483 -> 488;
	486 [label="我。这太荒谬了。我知道我们以前讨论过这些问题，也谈过这件事。但这件事还是让我觉得不安。",shape=box,color=blue];
		486 -> 491;
	484 [label="他们有各自的问题……需要关注。",shape=box,color=red];
		484 -> 489;
	485 [label="彼得罗？",shape=box,color=red];
		485 -> 490;
	487 [label="但我认识他时，他叫彼得罗·沃顿，是自豪的殁世机甲舰队发明者。想到对他来说时间已经过去了那么久，而对我来说——相对而言——时间却过得那么快，真是令人感慨万千。",shape=box,color=blue];
		487 -> 488;
	488 [label="但你怎么会不知道这些呢？篡位者，你是在耍我吗？难道我们只是在……老调重弹吗？",shape=box,color=blue];
		488 -> 492;
	491 [label="Evaluate expressions",color=orange];
		491 -> 498 [label="RoatheDatingDeal",color=purple];
		491 -> 498 [label="RoatheMarieDatingDeal",color=purple];
		491 -> 498 [label="RoatheLyonDatingDeal",color=purple];
		491 -> 498 [label="RoatheSerumDeal",color=purple];
		491 -> 497 [label="RoatheFamilyDeal",color=purple];
		491 -> 498 [label="RoatheMarieEntratiDeal",color=purple];
		491 -> 498 [label="RoatheLyonConfessionDeal",color=purple];
		491 -> 499 [label="false",color=purple];
	489 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		489 -> 494 [label=true,color=green];
		489 -> 493 [label=false,color=brown];
	490 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
