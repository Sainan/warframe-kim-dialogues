digraph {
	"RoatheRank1Convo4 begins." [color=orange];
		"RoatheRank1Convo4 begins." -> j86368880;
	j86368880 [label="Check boolean LoidFamilyComplete",color=orange];
		j86368880 -> j64307291 [label=true,color=green];
		j86368880 -> j252930896 [label=false,color=brown];
	j64307291 [label="欧拉瑞娅和彼得罗的遭遇简直令人唏嘘。我们之间从来就不是朋友，这一点毋庸置疑。但他们毕竟是奥罗金人。如今，我们奥罗金人所剩无几。不过，我想我还是应该谨言慎行——谁知道假以时日，我会变成什么样呢？",shape=box,color=blue];
		j64307291 -> j2844575021;
	j252930896 [label="我觉得欧拉瑞娅和彼得罗竟然一点儿都没察觉到我们在这里，真是太滑稽了。我们就像老鼠一样，在他们脚下乱窜。你和孩子们是怎么把这一切瞒这么久的？",shape=box,color=blue];
		j252930896 -> j348115237;
	j2844575021 [label="最让我毫不意外的是，“祖母”居然还活着。（想想也是，竟然把 Dagath 这么好的名字送人了。）",shape=box,color=blue];
		j2844575021 -> j1429698087;
		j2844575021 -> j2713184118;
	j348115237 [label="Evaluate expressions on HellStory counter",color=orange];
		j348115237 -> j1070122499 [label="x >= 21",color=purple];
		j348115237 -> j449930324 [label="x < 21",color=purple];
		j348115237 -> j449930324 [label="false",color=purple];
	j1429698087 [label="彼得罗？",shape=box,color=red];
		j1429698087 -> j2817260018;
	j2713184118 [label="你觉得他们的孩子怎么样？",shape=box,color=red];
		j2713184118 -> j406526717;
	j1070122499 [label="说实话，我更惊讶的是“祖母”居然搞不清状况。（想想也是，居然把 Dagath 这么好的名字白白送人了。）我还以为她看得更清楚一些。",shape=box,color=blue];
		j1070122499 -> j3764479475;
	j449930324 [label="说实话，我更惊讶的是“祖母”居然搞不清状况。（想想也是，居然把 Dagath 这么好的名字白白送人了。）我还以为她更聪明一些。",shape=box,color=blue];
		j449930324 -> j3972280104;
		j449930324 -> j964266774;
	j2817260018 [label="嗯？啊。那个殁世械灵告诉我，你或者那个孩子四处乱窜，帮他们编造假名，因为他们忘记了自己原来的名字。你喊他叫“维尔科”。",shape=box,color=blue];
		j2817260018 -> j1075629251;
	j406526717 [label="男孩任性、烦人、以自我为中心，简直就是个典型的奥罗金人。“凯莉”（她现在更喜欢别人这么叫她），我觉得她非常聪明，几乎值得我忍受她的存在。",shape=box,color=blue];
		j406526717 -> j3515629956;
	j3764479475 [label="我。这太荒谬了。我知道我们以前讨论过这些问题，也谈过这件事。但这件事还是让我觉得不安。",shape=box,color=blue];
		j3764479475 -> j2782860910;
	j3972280104 [label="他们有各自的问题……需要关注。",shape=box,color=red];
		j3972280104 -> j3658285805;
	j964266774 [label="彼得罗？",shape=box,color=red];
		j964266774 -> j922668640;
	j1075629251 [label="但我认识他时，他叫彼得罗·沃顿，是自豪的殁世机甲舰队发明者。想到对他来说时间已经过去了那么久，而对我来说——相对而言——时间却过得那么快，真是令人感慨万千。",shape=box,color=blue];
		j1075629251 -> j3515629956;
	j3515629956 [label="但你怎么会不知道这些呢？篡位者，你是在耍我吗？难道我们只是在……老调重弹吗？",shape=box,color=blue];
		j3515629956 -> j139011919;
	j2782860910 [label="Evaluate expressions",color=orange];
		j2782860910 -> j1644652630 [label="RoatheDatingDeal",color=purple];
		j2782860910 -> j1644652630 [label="RoatheMarieDatingDeal",color=purple];
		j2782860910 -> j1644652630 [label="RoatheLyonDatingDeal",color=purple];
		j2782860910 -> j1644652630 [label="RoatheSerumDeal",color=purple];
		j2782860910 -> j3388087811 [label="RoatheFamilyDeal",color=purple];
		j2782860910 -> j1644652630 [label="RoatheMarieEntratiDeal",color=purple];
		j2782860910 -> j1644652630 [label="RoatheLyonConfessionDeal",color=purple];
		j2782860910 -> j2061085224 [label="false",color=purple];
	j3658285805 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j3658285805 -> j1423144760 [label=true,color=green];
		j3658285805 -> j2599554731 [label=false,color=brown];
	j922668640 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j922668640 -> j1428206732 [label=true,color=green];
		j922668640 -> j1064089846 [label=false,color=brown];
	j139011919 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j139011919 -> j2622754760;
		j139011919 -> j3644511763;
		j139011919 -> j2491617656;
	j1644652630 [label="我正准备开始滔滔不绝地讲述奥罗金社会，想着或许你会有点兴趣。然后我又提醒自己，你来找我不是为了这个，对吧漂泊者？你还有别的把戏要玩……",shape=box,color=blue];
		j1644652630 -> j139011919;
	j3388087811 [label="我正准备开始滔滔不绝地讲述奥罗金社会，想着或许你会有点兴趣。然后我又提醒自己，这些你很可能早就听过了，不是吗？",shape=box,color=blue];
		j3388087811 -> j139011919;
	j2061085224 [label="你希望我只是配合你吗？还是……你这么做另有目的？我实在不明白你玩这种残酷的游戏到底想得到什么。",shape=box,color=blue];
		j2061085224 -> j2866522698;
	j1423144760 [label="是的，我从殁世械灵那里听说了。不过自从你或孩子努力解决这些问题后，他们的问题似乎减少了。至少他们不再像以前那样——字面意思上——互相撕裂了。",shape=box,color=blue];
		j1423144760 -> j3572873736;
	j2599554731 [label="是的，我从殁世械灵那里听说了。看来他们仍然执意撕得四分五裂。",shape=box,color=blue];
		j2599554731 -> j3930011928;
	j1428206732 [label="嗯？啊。那个殁世械灵告诉我，你或者那个孩子四处乱窜，帮他们编造假名，因为他们忘记了自己原来的名字。你喊他叫“维尔科”。但我认识他时，他叫彼得罗·沃顿。是自豪的殁世机甲舰队发明者。",shape=box,color=blue];
		j1428206732 -> j3572873736;
	j1064089846 [label="嗯？啊。我以前认识他，他叫彼得罗·沃顿，是自豪的殁世机甲舰队发明者。但殁世械灵告诉我，他们都忘了自己的名字。你可能只知道他叫“父亲”。",shape=box,color=blue];
		j1064089846 -> j3930011928;
	j2622754760 [label="不，我以前没听过。请继续。",shape=box,color=red];
		j2622754760 -> j3180462347;
	j3644511763 [label="罗瑟，我跟你说话……是因为我想跟你说话。",shape=box,color=red];
		j3644511763 -> j862518501;
	j2491617656 [label="没错，我之前听说过。但请你再说一遍。",shape=box,color=red];
		j2491617656 -> j2391973681;
	j2866522698 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j2866522698 -> j1204515776;
	j3572873736 [label="Evaluate expressions",color=orange];
		j3572873736 -> j1771880736 [label="RoatheDeal",color=purple];
		j3572873736 -> j3421947487 [label="RoatheNoDeal",color=purple];
		j3572873736 -> j3421947487 [label="false",color=purple];
	j3930011928 [label="Evaluate expressions",color=orange];
		j3930011928 -> j1201403983 [label="RoatheDeal",color=purple];
		j3930011928 -> j398238219 [label="RoatheNoDeal",color=purple];
		j3930011928 -> j398238219 [label="false",color=purple];
	j3180462347 [label="+5 Chemistry",color=orange];
		j3180462347 -> j638206529;
	j862518501 [label="Check boolean DrifterRoathe",color=orange];
		j862518501 -> j992726529 [label=true,color=green];
		j862518501 -> j901613458 [label=false,color=brown];
	j2391973681 [label="所以你承认你是在浪费我的时间。太好了！我可不是什么满脸皱纹、老态龙钟的老人，因为记不起其他战争故事，所以只能反复讲述这唯一的故事。",shape=box,color=blue];
		j2391973681 -> j3241710391;
	j1204515776 [label="我正准备开始滔滔不绝地讲述奥罗金社会，想着或许你会有点兴趣。然后我又提醒自己，这些你很可能早就听过了，不是吗？",shape=box,color=blue];
		j1204515776 -> j2622754760;
		j1204515776 -> j3644511763;
		j1204515776 -> j2491617656;
	j1771880736 [label="这也好，因为如果没有你或孩子先完成这一步，我们几乎不可能取得任何进展。否则，我担心我们一派管家上楼，他就会立刻被揍成肉酱。",shape=box,color=blue];
		j1771880736 -> j2336317248;
	j3421947487 [label="对了，你有没有重新考虑过我的提议？我安静地坐在这里，帮你调解管家和楼上那些被感染的、被遗弃的奥罗金流放者之间的矛盾？",shape=box,color=blue];
		j3421947487 -> j672762728;
		j3421947487 -> j3771061957;
	j1201403983 [label="你最好先想办法解决这个问题，然后再考虑让管家上楼。免得他在这个过程中变成肉酱。",shape=box,color=blue];
		j1201403983 -> j2336317248;
	j398238219 [label="对​了，​你​有​没​有​重新​考虑​过​我​的​提议？​我​安静​地​坐​在​这里，​帮​你​调解​管家​和​楼上​那些​被​感染​的、​被​遗弃​的​ O​rokin 流放者​之间​的​矛盾？​调解​家庭​矛盾​是​第一步，​不过……​",shape=box,color=blue];
		j398238219 -> j672762728;
		j398238219 -> j3771061957;
	j638206529 [label="你竟然让一个奥罗金人开口说话。你根本不知道自己做了什么。要是一个不注意，你得在这里待上一个小时。",shape=box,color=blue];
		j638206529 -> j1467000320;
	j992726529 [label="+5 Chemistry",color=orange];
		j992726529 -> j1962714270;
	j901613458 [label="哦？那么，“请问”这是为什么呢？",shape=box,color=blue];
		j901613458 -> j2575401798;
		j901613458 -> j2850664042;
		j901613458 -> j751023308;
		j901613458 -> j2595214579;
	j3241710391 [label="我之所以记不起这段对话，就是因为你，看着你就像照镜子一样！",shape=box,color=blue];
		j3241710391 -> "Chat ends.";
	j2336317248 [label="你必须明白一点，管家和英择谛家族虽然与奥罗金关系疏远，但他们终究还是奥罗金人。他们出生并成长于这个社会，尽管这个社会……存在诸多缺陷。",shape=box,color=blue];
		j2336317248 -> j1363001356;
	j672762728 [label="不，罗瑟，我不会改变主意。这并不重要。",shape=box,color=red];
		j672762728 -> j1271630929;
	j3771061957 [label="我有。我……同意。",shape=box,color=red];
		j3771061957 -> j3972301566;
	j1467000320 [label="不过漂泊者，我想你可能没多少机会和奥罗金人接触吧？毕竟那孩子过着和你截然不同的生活。",shape=box,color=blue];
		j1467000320 -> j496644812;
	j1962714270 [label="嗯，没错。我们都知道为什么，对吧？但你必须耐心等待。",shape=box,color=blue];
		j1962714270 -> j2131403312;
	j2575401798 [label="[表白心意] 我想你知道的。",shape=box,color=red];
		j2575401798 -> j502212297;
	j2850664042 [label="我觉得你很有意思。",shape=box,color=red];
		j2850664042 -> j751807616;
	j751023308 [label="我几乎没什么和奥罗金人接触的机会。除了……和他们战斗。倒是你非常不错。",shape=box,color=red];
		j751023308 -> j3923192342;
	j2595214579 [label="算了。[结束]",shape=box,color=red];
		j2595214579 -> j3189039807;
	"Chat ends." [color=orange];
	j1363001356 [label="尽管罪恶滔天，等级和秩序却从未受到质疑。无论是在军队中，还是在社会结构中，皆是如此。哲士服从奥罗金人，奥罗金人服从执行者，执行者服从皇帝……至少名义上如此。",shape=box,color=blue];
		j1363001356 -> j1220048306;
	j1271630929 [label="随你便吧。但这扇门不会一直开着。",shape=box,color=blue];
		j1271630929 -> "Chat ends.";
	j3972301566 [label="Boolean RoatheNoDeal is now false.",color=orange];
		j3972301566 -> j4187660806;
	j496644812 [label="据我所知，你的人生就是在扎里曼 10-0 号悲剧发生时偏离了轨道。",shape=box,color=blue];
		j496644812 -> j2615175381;
		j496644812 -> j1791663068;
		j496644812 -> j3446584603;
	j2131403312 [label="与此同时，如果你想“听听”，我很乐意奉陪。不过，先提醒你一下，你请的是一位奥罗金人说话。",shape=box,color=blue];
		j2131403312 -> j1344565263;
	j502212297 [label="+5 Chemistry",color=orange];
		j502212297 -> j2802658234;
	j751807616 [label="+5 Chemistry",color=orange];
		j751807616 -> j903739144;
	j3923192342 [label="知己知彼，是吗？或者仅仅是出于好奇，想与一个不可能的人面对面交流？ ",shape=box,color=blue];
		j3923192342 -> j3509164653;
	j3189039807 [label="鱼儿，你想怎么挣扎都行，是你自己游到我这儿来的。",shape=box,color=blue];
		j3189039807 -> "Chat ends.";
	j1220048306 [label="即便你不相信，即便过了这么久，传统也许能让洛德听我的话？想想看，我可是很有说服力的。毕竟，我曾是那些最邪恶的执行者的得力助手。",shape=box,color=blue];
		j1220048306 -> j1474389292;
		j1220048306 -> j958923081;
		j1220048306 -> j853987132;
	j4187660806 [label="Boolean RoatheDeal is now true.",color=orange];
		j4187660806 -> j1555491164;
	j2615175381 [label="对。在扎里曼之前，我没和奥罗金人打过交道——至于之后嘛……我想你大概已经听说了。",shape=box,color=red];
		j2615175381 -> j4168093446;
	j1791663068 [label="我跟奥罗金人打过不少交道，知道千万别相信他们。",shape=box,color=red];
		j1791663068 -> j279459027;
	j3446584603 [label="很遗憾，我对你们这类人并没有比那孩子更多的爱。",shape=box,color=red];
		j3446584603 -> j279459027;
	j1344565263 [label="你根本不知道自己做了什么。要是一个不注意，你得在这里待上一个小时。",shape=box,color=blue];
		j1344565263 -> j1467000320;
	j2802658234 [label="嗯，我知道。我还以为你会好心写出来给我看呢。唉……",shape=box,color=blue];
		j2802658234 -> j1780415163;
	j903739144 [label="你这么觉得吗？嗯。那我们就看看我能把这条鱼叉住多久吧。",shape=box,color=blue];
		j903739144 -> j2131403312;
	j3509164653 [label="+5 Chemistry",color=orange];
		j3509164653 -> j1416935635;
	j1474389292 [label="执行者中最坏的是 Ballas。",shape=box,color=red];
		j1474389292 -> j4115044815;
	j958923081 [label="你侍奉的是哪一位？",shape=box,color=red];
		j958923081 -> j3317686772;
	j853987132 [label="怎么说？",shape=box,color=red];
		j853987132 -> j2228864185;
	j1555491164 [label="+5 Chemistry",color=orange];
		j1555491164 -> j1883173975;
	j4168093446 [label="确实如此。啊，Ballas。你或许会惊讶地发现，他并非他们中最恶劣的一个。",shape=box,color=blue];
		j4168093446 -> j56364023;
		j4168093446 -> j1978497063;
	j279459027 [label="我想我不会责怪你。我以为他们还能挽救。某种程度上来说，可以熔化——重塑，重铸，就像黄金一样。",shape=box,color=blue];
		j279459027 -> j1624265026;
	j1780415163 [label="或许改日再说吧。篡位者啊，你得学会珍惜这些时刻。",shape=box,color=blue];
		j1780415163 -> j467084638;
	j1416935635 [label="令人尊敬，甚至睿智。如果我也有机会与一位 Sentient 生物交谈，甚至成为朋友，我也会这样做。 ",shape=box,color=blue];
		j1416935635 -> j3006018765;
	j4115044815 [label="我尊重你的观点，也不会因此责怪你。Ballas 是个蠢货，但他确实是数一数二的堕落者，这一点我不会和你争论。",shape=box,color=blue];
		j4115044815 -> j4034680267;
	j3317686772 [label="Evaluate expressions on HellStory counter",color=orange];
		j3317686772 -> j2071718107 [label="x >= 1",color=purple];
		j3317686772 -> j1636371228 [label="x <= 1",color=purple];
		j3317686772 -> j1636371228 [label="false",color=purple];
	j2228864185 [label="我​知道​你​曾​与​ Ballas ​有​过私下​接触，​所以​你​认为​他​是​七位​黄金之​主中​最​邪恶​的​一​个，​我​完全​理解。​他​的​确​是​数​一​数二​的​堕落者，​这​一​点​我​同意。​",shape=box,color=blue];
		j2228864185 -> j4218578578;
	j1883173975 [label="太好了！我很高兴你终于醒悟了。现在我们终于可以取得一些进展了。",shape=box,color=blue];
		j1883173975 -> j2336317248;
	j56364023 [label="真的吗？",shape=box,color=red];
		j56364023 -> j2487717974;
	j1978497063 [label="你很难让我相信这一点。",shape=box,color=red];
		j1978497063 -> j2487717974;
	j1624265026 [label="好​吧。​除了​那些​执行者。​他们​已经​没​救​了。​你​或许会​惊讶​地​发现，​Ballas ​还​不​是​他们​中​最​坏​的。​",shape=box,color=blue];
		j1624265026 -> j1978497063;
		j1624265026 -> j56364023;
	j467084638 [label="Boolean DrifterRoathe is now true.",color=orange];
		j467084638 -> j2131403312;
	j3006018765 [label="如果你在战场上遇到他们——甚至是你的前盟友——这会给你带来心理上的好处。",shape=box,color=blue];
		j3006018765 -> j112405490;
	j4034680267 [label="虽然事实上​我​并​没有​亲眼​目睹​这个​“合​一众”​事件​的​恐怖​之处，​只​从​管家​那里、​以及​从​这​台​石榴 2 代​机器​上​的​记录​中​了解​而​已。",shape=box,color=blue];
		j4034680267 -> j1599305734;
	j2071718107 [label="你以前听我提起过她。更重要的是，我还透露过我们的计划。不过，那是另一个故事了。执行者尼托。确切地说，是摄政王执行者尼托。我们所有军队的统帅，也是黄金七人众中最凶残、最致命的一位。",shape=box,color=blue];
		j2071718107 -> j573798827;
	j1636371228 [label="执行者尼托。准确地说，是摄政王执行者尼托。奥罗金帝国所有军队的统帅。也是黄金七人众中最凶残、最致命的一位。",shape=box,color=blue];
		j1636371228 -> j573798827;
	j4218578578 [label="甚至很有可能，他在这场我从管家那里听说的、以及我在石榴 2 代中读到的“合一众”事件中，超越了过去那些执行者。",shape=box,color=blue];
		j4218578578 -> j1599305734;
	j2487717974 [label="我不是说他是圣人。我只是告诉你，即使是最邪恶的恶魔，也只是比他的同辈略逊一筹而已。篡位者，我这不过是吹毛求疵罢了。",shape=box,color=blue];
		j2487717974 -> j319237166;
	j112405490 [label="好吧，如果你想“听听”，我很乐意奉陪。不过，先提醒你一下，你竟然让一个奥罗金人开口说话。",shape=box,color=blue];
		j112405490 -> j1344565263;
	j1599305734 [label="不过，我也认为，这或许是因为你与 Ballas 的私人关系非常密切，而与其他六位的互动却非常有限，才让你产生了这种印象。",shape=box,color=blue];
		j1599305734 -> j573798827;
	j573798827 [label="黄金七人众？呸。漂泊者，你知道黄金最好的一点是什么吗？它可以无限熔化，然后重新制成更好的东西。",shape=box,color=blue];
		j573798827 -> j1809619520;
	j319237166 [label="但 Ballas 是罪大恶极的吗？或许对你而言是。而且，或许他在这个时期的罪行比以前那些执行者还要严重。",shape=box,color=blue];
		j319237166 -> j1505541209;
	j1809619520 [label="我曾相信——某种程度上现在依然相信——奥罗金人还有救。我们本可以扭转帝国的颓势。但执行者呢？不，必须阻止他们。他们在每一种程度上，都是人类所能展现的最邪恶的化身。",shape=box,color=blue];
		j1809619520 -> j3152550789;
	j1505541209 [label="但如果你亲眼见过那片血红的湖泊，以及遍地弯曲破碎的尸体，就像许多被丢弃的儿童玩具——",shape=box,color=blue];
		j1505541209 -> j2500047250;
	j3152550789 [label="篡位者，这话是我说的。所以，请允许我，Tau 的恶魔本人，以一个行家的身份向你保证，Ballas 并非他们中最差的。",shape=box,color=blue];
		j3152550789 -> j581353866;
	j2500047250 [label="如果你亲眼目睹过尼托几乎不费吹灰之力就能造成的毁灭性破坏…… ",shape=box,color=blue];
		j2500047250 -> j290450365;
	j581353866 [label="Check boolean RoatheUsurper",color=orange];
		j581353866 -> j4244030644 [label=true,color=green];
		j581353866 -> j3425825129 [label=true,color=green];
		j581353866 -> j1198634900 [label=false,color=brown];
		j581353866 -> j4244030644 [label=false,color=brown];
		j581353866 -> j3425825129 [label=false,color=brown];
	j290450365 [label="但除非亲眼目睹，否则很难体会到这种恐怖。这种悲剧无法用数字来衡量。我可以长篇大论地讲述我所见所闻，但对你而言，它们仅仅是故事而已。",shape=box,color=blue];
		j290450365 -> j1032710767;
	j4244030644 [label="你很难让我相信这一点。",shape=box,color=red];
		j4244030644 -> j1505541209;
	j3425825129 [label="真的吗？",shape=box,color=red];
		j3425825129 -> j1505541209;
	j1198634900 [label="你为什么老是叫我“篡位者”？",shape=box,color=red];
		j1198634900 -> j4091970192;
	j1032710767 [label="对你来说，Ballas 永远是那个更加真实、更加令人恐惧的恶棍。这也在情理之中。",shape=box,color=blue];
		j1032710767 -> j3703782588;
	j4091970192 [label="啊！你就是这种人，对吧？Tenno 从奥罗金手中夺取了始源星系。而你，就像巢穴里的小冒牌货，从你自己的世界偷偷溜进了这个世界。",shape=box,color=blue];
		j4091970192 -> j3520058172;
	j3703782588 [label="但你对他的了解还远远不够。关于那个蠢货，已经说得够多了。而我担心还有更多的话不得不说。",shape=box,color=blue];
		j3703782588 -> j3888423939;
		j3703782588 -> j1829737048;
	j3520058172 [label="这样看来，至少从这两点来说，你都是个篡位者。（如果算上管家告诉我的关于双衍王境的那些事，或许还有第三点，但这又是另一个话题了。）",shape=box,color=blue];
		j3520058172 -> j2104247511;
	j3888423939 [label="比如什么？",shape=box,color=red];
		j3888423939 -> j3343490081;
	j1829737048 [label="我对 Ballas 的生平事迹不感兴趣。",shape=box,color=red];
		j1829737048 -> j2965261056;
	j2104247511 [label="篡位者，别打岔。我知道你可能很难相信我，但如果你亲眼见过那片血红的湖泊，以及遍地弯曲破碎的尸体，就像许多被丢弃的儿童玩具——",shape=box,color=blue];
		j2104247511 -> j3407701738;
	j3343490081 [label="Boolean RoatheBallas1 is now true.",color=orange];
		j3343490081 -> j3828068019;
	j2965261056 [label="嗯，是的。好吧，看来你只能听我讲讲我的人生故事了。真滑稽。",shape=box,color=blue];
		j2965261056 -> j2436505268;
	j3407701738 [label="Boolean RoatheUsurper is now true.",color=orange];
		j3407701738 -> j2500047250;
	j3828068019 [label="那说来话长，我现在没时间细说。管家就在旁边，我最讨厌被人盯着。",shape=box,color=blue];
		j3828068019 -> j576014479;
	j2436505268 [label="+5 Chemistry",color=orange];
