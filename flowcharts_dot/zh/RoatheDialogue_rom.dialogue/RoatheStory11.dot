	j3704551919 [label="语音留言：分开",shape=box,color=blue];
		j3704551919 -> j750541368;
	j750541368 [label="文字记录：在 Sentient 首次入侵星系以及 Orokin 的灾难性反击之后，一片奇异的寂静笼罩着一切。",shape=box,color=blue];
		j750541368 -> j1220292309;
	j1220292309 [label="我们与被困在 Tau 的同胞没有任何联系，也无法得知他们的信号是被干扰了还是彻底中断了。",shape=box,color=blue];
		j1220292309 -> j763745453;
	j763745453 [label="结果大家都来找我征求意见。作为战略家，我必须了解敌人。",shape=box,color=blue];
		j763745453 -> j3186017753;
	j3186017753 [label="Sentient 随时都可能摧毁 Tau 星球上空的星际航道终点站，然而轨道还在运行。",shape=box,color=blue];
		j3186017753 -> j1367805916;
	j1367805916 [label="为什么？他们敞开大门能得到什么好处？",shape=box,color=blue];
		j1367805916 -> j1667859574;
	j1667859574 [label="他们是团结一致地采取侵略行动，还是其中仍有人抱有和平共处的希望？",shape=box,color=blue];
		j1667859574 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}