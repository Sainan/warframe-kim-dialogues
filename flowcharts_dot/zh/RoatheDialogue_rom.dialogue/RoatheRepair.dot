	"RoatheRepair begins." [color=orange];
		"RoatheRepair begins." -> j2688688654;
	j2688688654 [label="Evaluate expressions",color=orange];
		j2688688654 -> j507087307 [label="LyonRoatheFailFix, MarieRoatheFailFix",color=purple];
		j2688688654 -> "Chat ends." [label="false",color=purple];
	j507087307 [label="够了！够了！我认输了！别让狂热分子来弄我了！他们比疯库狛顿还可怕！这些该死的家伙，我走到哪儿他们就跟到哪。我连觉都没法睡！",shape=box,color=blue];
		j507087307 -> j3824754521;
	"Chat ends." [color=orange];
	j3824754521 [label="是什么？！你想要什么？！",shape=box,color=blue];
		j3824754521 -> j3385917687;
		j3824754521 -> j2125639628;
		j3824754521 -> j3404023400;
	j3385917687 [label="再跟你谈谈你接受血清的事。罗瑟，别再逃避了。 ",shape=box,color=red];
		j3385917687 -> j1979205857;
	j2125639628 [label="罗瑟。接受血清并不会让你变成懦夫。它只会让你成为唯一幸存的奥罗金人。接受这个事实吧。",shape=box,color=red];
		j2125639628 -> j1420398166;
	j3404023400 [label="罗瑟。接受血清并不会让你变成懦夫。它给了你第二次生命，让你有机会真正改变人生。",shape=box,color=red];
		j3404023400 -> j62611055;
	j1979205857 [label="Evaluate expressions on Thermostat counter",color=orange];
		j1979205857 -> j2282449739 [label="x >= 5",color=purple];
		j1979205857 -> j706598826 [label="x <= 0",color=purple];
		j1979205857 -> j707666221 [label="x > 0 && x < 5",color=purple];
		j1979205857 -> j707666221 [label="false",color=purple];
	j1420398166 [label="Add -5 to Thermostat counter",color=orange];
		j1420398166 -> j1979205857;
	j62611055 [label="Add 5 to Thermostat counter",color=orange];
		j62611055 -> j1979205857;
	j2282449739 [label="你这是在让愤怒吞噬自己。你本可以利用它来对抗那些至今仍在破坏这个世界的人。就在此刻。就在这里。",shape=box,color=red];
		j2282449739 -> j212302354;
	j706598826 [label="你​这是在把​矛头​指向​了​自己。​你​应该​指向​的​是​这个​世界，​你​尽​了​全力​去​拯救​它​免​遭奥罗金​帝国​的​蹂躏，​它​却​在​责怪​你。​",shape=box,color=red];
		j706598826 -> j3750112083;
	j707666221 [label="这就是你唆使他们日夜骚扰我的原因？就为了这个？想做最后的挣扎，让我听听你那可笑的论点？",shape=box,color=blue];
		j707666221 -> j1576664856;
	j212302354 [label="罗瑟，你的过去并不能定义你，你的未来才能定义你。而且，你还有美好的未来可以去体验，不像那些在长胴鼓之夜死去的奥罗金人。",shape=box,color=red];
		j212302354 -> j1563323475;
	j3750112083 [label="周围人的意见或他们对你行为的看法定义不了你，你唯一能定义你自己的，是你如何看待自己以及你的选择。",shape=box,color=red];
		j3750112083 -> j4288691603;
	j1576664856 [label="不。",shape=box,color=blue];
		j1576664856 -> j747124469;
	j1563323475 [label="现在，只有这件样才能定义你。你可以改变，也可以改变你周围的世界。我想问的只是，你至少愿意尝试一下吗？",shape=box,color=red];
		j1563323475 -> j1696215419;
	j4288691603 [label="事实很简单：你是极少数的、在我们所知的在长胴鼓之夜幸存下来的奥罗金人之一。在我看来，那是一次战略性撤退。",shape=box,color=red];
		j4288691603 -> j2593558554;
	j747124469 [label="你的失败真是可悲。而且不是一次，而是两次。",shape=box,color=blue];
		j747124469 -> j528311290;
	j1696215419 [label="试着原谅自己，然后继续向前走？",shape=box,color=red];
		j1696215419 -> j4016148039;
	j2593558554 [label="不多不少，仅此而已。",shape=box,color=red];
		j2593558554 -> j3337032399;
	j528311290 [label="我觉得你最好不要去竞选公职。",shape=box,color=blue];
		j528311290 -> "Chat ends.";
	j4016148039 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j4016148039 -> j1737509025;
	j3337032399 [label="Boolean RoatheVillain is now true.",color=orange];
		j3337032399 -> j3748345265;
	j1737509025 [label="+20 Chemistry",color=orange];
		j1737509025 -> j3967535439;
	j3748345265 [label="+20 Chemistry",color=orange];
		j3748345265 -> j2648369307;
	j3967535439 [label="原谅自己所做的一切？然后继续向前走？嗯。",shape=box,color=blue];
		j3967535439 -> j2890633906;
	j2648369307 [label="以退为进。嗯。 ",shape=box,color=blue];
		j2648369307 -> j3084795929;
	j2890633906 [label="虽然我对你重新解读局势的方式略有怀疑，但我……太渴望这个新的未来以及它可能带给我的意义，以至于无法抗拒，亲爱的漂泊者。",shape=box,color=blue];
		j2890633906 -> j3194527253;
	j3084795929 [label="虽然我对……你将这件事重新定义为战术性撤退的说法略有怀疑，但我承认，我仍然赞同这种说法，亲爱的漂泊者。",shape=box,color=blue];
		j3084795929 -> j2755303160;
	j3194527253 [label="这简直是我人生的“新生”。好吧。我承认也接受你的观点。虽然来得有点晚，但它确实有效。",shape=box,color=blue];
		j3194527253 -> j460608745;
	j2755303160 [label="好吧。我承认也接受你的观点。虽然来得有点晚，但它确实有效。",shape=box,color=blue];
		j2755303160 -> j460608745;
	j460608745 [label="我很感激。比你想象的还要感激。",shape=box,color=blue];
