digraph {
	5182 [label="RoatheRepair begins.",color=orange];
		5182 -> 5183;
	5183 [label="Evaluate expressions",color=orange];
		5183 -> 5185 [label="LyonRoatheFailFix, MarieRoatheFailFix",color=purple];
		5183 -> 5184 [label="false",color=purple];
	5185 [label="够了！够了！我认输了！别让狂热分子来弄我了！他们比疯库狛顿还可怕！这些该死的家伙，我走到哪儿他们就跟到哪。我连觉都没法睡！",shape=box,color=blue];
		5185 -> 5186;
	5184 [label="Chat ends.",color=orange];
	5186 [label="是什么？！你想要什么？！",shape=box,color=blue];
		5186 -> 5188;
		5186 -> 5187;
		5186 -> 5189;
	5188 [label="再跟你谈谈你接受血清的事。罗瑟，别再逃避了。 ",shape=box,color=red];
		5188 -> 5191;
	5187 [label="罗瑟。接受血清并不会让你变成懦夫。它只会让你成为唯一幸存的奥罗金人。接受这个事实吧。",shape=box,color=red];
		5187 -> 5190;
	5189 [label="罗瑟。接受血清并不会让你变成懦夫。它给了你第二次生命，让你有机会真正改变人生。",shape=box,color=red];
		5189 -> 5192;
	5191 [label="Evaluate expressions on Thermostat",color=orange];
		5191 -> 5195 [label="x >= 5",color=purple];
		5191 -> 5194 [label="x <= 0",color=purple];
		5191 -> 5193 [label="x > 0 && x < 5",color=purple];
		5191 -> 5193 [label="false",color=purple];
	5190 [label="Add -5 to Thermostat",color=orange];
		5190 -> 5191;
	5192 [label="Add 5 to Thermostat",color=orange];
		5192 -> 5191;
	5195 [label="你这是在让愤怒吞噬自己。你本可以利用它来对抗那些至今仍在破坏这个世界的人。就在此刻。就在这里。",shape=box,color=red];
		5195 -> 5198;
	5194 [label="你​这是在把​矛头​指向​了​自己。​你​应该​指向​的​是​这个​世界，​你​尽​了​全力​去​拯救​它​免​遭奥罗金​帝国​的​蹂躏，​它​却​在​责怪​你。​",shape=box,color=red];
		5194 -> 5197;
	5193 [label="这就是你唆使他们日夜骚扰我的原因？就为了这个？想做最后的挣扎，让我听听你那可笑的论点？",shape=box,color=blue];
		5193 -> 5196;
	5198 [label="罗瑟，你的过去并不能定义你，你的未来才能定义你。而且，你还有美好的未来可以去体验，不像那些在长胴鼓之夜死去的奥罗金人。",shape=box,color=red];
		5198 -> 5201;
	5197 [label="周围人的意见或他们对你行为的看法定义不了你，你唯一能定义你自己的，是你如何看待自己以及你的选择。",shape=box,color=red];
		5197 -> 5200;
	5196 [label="不。",shape=box,color=blue];
		5196 -> 5199;
	5201 [label="现在，只有这件样才能定义你。你可以改变，也可以改变你周围的世界。我想问的只是，你至少愿意尝试一下吗？",shape=box,color=red];
		5201 -> 5204;
	5200 [label="事实很简单：你是极少数的、在我们所知的在长胴鼓之夜幸存下来的奥罗金人之一。在我看来，那是一次战略性撤退。",shape=box,color=red];
		5200 -> 5203;
	5199 [label="你的失败真是可悲。而且不是一次，而是两次。",shape=box,color=blue];
		5199 -> 5202;
	5204 [label="试着原谅自己，然后继续向前走？",shape=box,color=red];
		5204 -> 5207;
	5203 [label="不多不少，仅此而已。",shape=box,color=red];
		5203 -> 5206;
	5202 [label="我觉得你最好不要去竞选公职。",shape=box,color=blue];
		5202 -> 5205;
	5207 [label="Update boolean RoatheRedeemed",color=orange];
		5207 -> 5209;
	5206 [label="Update boolean RoatheVillain",color=orange];
		5206 -> 5208;
	5205 [label="Chat ends.",color=orange];
	5209 [label="+20 Chemistry",color=orange];
		5209 -> 5211;
	5208 [label="+20 Chemistry",color=orange];
		5208 -> 5210;
	5211 [label="原谅自己所做的一切？然后继续向前走？嗯。",shape=box,color=blue];
		5211 -> 5213;
	5210 [label="以退为进。嗯。 ",shape=box,color=blue];
		5210 -> 5212;
	5213 [label="虽然我对你重新解读局势的方式略有怀疑，但我……太渴望这个新的未来以及它可能带给我的意义，以至于无法抗拒，亲爱的漂泊者。",shape=box,color=blue];
		5213 -> 5215;
	5212 [label="虽然我对……你将这件事重新定义为战术性撤退的说法略有怀疑，但我承认，我仍然赞同这种说法，亲爱的漂泊者。",shape=box,color=blue];
		5212 -> 5214;
	5215 [label="这简直是我人生的“新生”。好吧。我承认也接受你的观点。虽然来得有点晚，但它确实有效。",shape=box,color=blue];
		5215 -> 5216;
	5214 [label="好吧。我承认也接受你的观点。虽然来得有点晚，但它确实有效。",shape=box,color=blue];
		5214 -> 5216;
	5216 [label="我很感激。比你想象的还要感激。",shape=box,color=blue];
		5216 -> 5217;
	5217 [label="Update boolean RoatheFail",color=orange];
		5217 -> 5218;
	5218 [label="Update boolean RoatheFamilyFail",color=orange];
