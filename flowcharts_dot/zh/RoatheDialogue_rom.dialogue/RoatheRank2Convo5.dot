	1309 [label="Evaluate expressions on HellStory",color=orange];
		1309 -> 1312 [label="x >= 21",color=purple];
		1309 -> 5777 [label="x < 21",color=purple];
		1309 -> 5777 [label="false",color=purple];
	1310 [label="你说得对，这显而易见！在我和尼托设下陷阱准备对付执行者后，阿尔布雷希特就在那条走廊里遇到了我。",shape=box,color=blue];
		1310 -> 1313;
	1311 [label="对，显然没有。在我和尼托设下陷阱准备对付执行者后，我就被阿尔布雷希特强行变成了这种……东西。",shape=box,color=blue];
		1311 -> 1314;
	1312 [label="你很清楚我们的计划出了什么问题，对吧？！在我和尼托设下陷阱准备对付执行者后，阿尔布雷希特就在那条走廊里遇到了我。",shape=box,color=blue];
		1312 -> 1315;
	5777 [label="在我和尼托设下陷阱准备对付执行者后，我就被阿尔布雷希特强行变成了这种……东西。",shape=box,color=blue];
		5777 -> 1314;
	1313 [label="然后​他​给​了​我​原型​战甲​血清。​之后……​嗯……​我们​都​知道​接​下来​发生​了​什么。​",shape=box,color=blue];
		1313 -> 1316;
	1314 [label="我记得前一刻还站在一条金色的大厅里，下一刻就痛苦地尖叫着，身处“高卢”某个偏僻的地狱般的地方。",shape=box,color=blue];
		1314 -> 1317;
	1315 [label="然后​他​给​了​我​原型​战甲​血清。​​我们​都​知道​接​下来​发生​了​什么！",shape=box,color=blue];
		1315 -> 1316;
	1316 [label="对于这件事我至今仍然很生气。为什么？！我为什么要向你坦白？！你怎么会知道？！ ",shape=box,color=blue];
		1316 -> 1318;
	1317 [label="我失踪后，尼托肯定放弃了那个计划。很有可能，她把整个叛国事件都栽赃给了我，让我成了方便的替罪羊。",shape=box,color=blue];
		1317 -> 1319;
	1318 [label="呸！算了。我得走了，免得一时冲动把这该死的电脑砸了。",shape=box,color=blue];
		1318 -> 1320;
	1319 [label="这解释了我查阅的记录中所有称我为“懦夫”的说法。他们当然会认为我是懦夫——他们以为我逃跑了！呸。",shape=box,color=blue];
		1319 -> 1321;
	1320 [label="+10 Chemistry",color=orange];
		1320 -> 1322;
	1321 [label="+10 Chemistry",color=orange];
		1321 -> 1323;
	1322 [label="Chat ends.",color=orange];
	1323 [label="得知我对这个计划至关重要，我感到很欣慰；然而，我离开后，这个计划却不得不彻底取消。",shape=box,color=blue];
		1323 -> 1324;
		1323 -> 1325;
	1324 [label="我不太确定……那是不是你该从这件事里得出的结论。",shape=box,color=red];
		1324 -> 1326;
	1325 [label="被需要的感觉真好。",shape=box,color=red];
		1325 -> 1327;
	1326 [label="Add 1 to Thermostat",color=orange];
		1326 -> 1328;
	1327 [label="+5 Chemistry",color=orange];
		1327 -> 1329;
	1328 [label="漂泊者，你想在哪里找到自己的价值就在哪里找吧，而我的价值让我自己去找。",shape=box,color=blue];
		1328 -> 1330;
	1329 [label="Add -1 to Thermostat",color=orange];
		1329 -> 1331;
	1330 [label="Chat ends.",color=orange];
	1331 [label="你看？你能明白。",shape=box,color=blue];
