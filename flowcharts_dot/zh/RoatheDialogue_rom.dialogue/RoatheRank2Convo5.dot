		1226 -> 1229 [label=true,color=green];
		1226 -> 1228 [label=false,color=brown];
	1227 [label="Chat ends.",color=orange];
	1229 [label="之前的罗瑟究竟跟你说过多少他和执行者尼托之间的交易？唉。我在尽力调和这一切：过去的我竟然信任你，把这些私人信息告诉你……结果你却把它们从我的记忆中彻底抹去？",shape=box,color=blue];
		1229 -> 1232;
	1228 [label="Evaluate expressions on HellStory",color=orange];
		1228 -> 1231 [label="x >= 1",color=purple];
		1228 -> 1230 [label="x <= 1",color=purple];
		1228 -> 1230 [label="false",color=purple];
	1232 [label="这让我的心好痛。我曾经把一切都告诉你，所有的一切——毫无保留地袒露心扉，直抵我内心最深处，而你……却把我的一切都抹去了。就好像我只不过是你的一个玩物。",shape=box,color=blue];
		1232 -> 1234;
	1231 [label="你之前听我提起过执行者尼托，以及我和她之间的……来往。你必须明白，奥罗金帝国并非全然邪恶。",shape=box,color=blue];
		1231 -> 1233;
	1230 [label="Chat ends.",color=orange];
	1234 [label="我想，这也算是报应吧。我们奥罗金人就是这样对待人类的，不是吗？青春厅堂？炫耀美丽的肉体，随意选择新的自我，用病态的游戏互相折磨，只为取乐……",shape=box,color=blue];
		1234 -> 1236;
	1233 [label="令我痛心的是，人们最终只会记住它带来的破坏和堕落。没错，它的破坏和堕落确实罄竹难书，这一点我并不否认。",shape=box,color=blue];
		1233 -> 1235;
	1236 [label="我讨厌这样。我非常非常讨厌这样。",shape=box,color=blue];
		1236 -> 1239;
		1236 -> 1240;
		1236 -> 1238;
	1235 [label="但它也创造了如此的美学，如此的欢乐，如此的爱，如此多的科学和艺术成就。看看我们曾经取得的成就吧！ ",shape=box,color=blue];
		1235 -> 1237;
	1239 [label="虽然我不是故意这样伤害你，对此我深感抱歉，但如果这件事让你体会到了奥罗金帝国另一边的感受，那也是一个宝贵的教训。",shape=box,color=red];
		1239 -> 1245;
	1240 [label="我从未想过这件事会以这种方式伤害你。你不必为奥罗金社会的运作方式道歉——它并非你一手缔造的，你只是试图挽救它。",shape=box,color=red];
		1240 -> 1246;
	1238 [label="[结束]",shape=box,color=red];
		1238 -> 1244;
	1237 [label="所以，当尼托召我到她身边，告诉我她想杀光所有奥罗金人时，我立刻同意了。我渴望斩断这条毒蛇的头颅，我渴望用一个更仁慈的制度，一个更仁慈的统治者来取代它。",shape=box,color=blue];
		1237 -> 1241;
		1237 -> 1242;
		1237 -> 1243;
	1245 [label="Add 3 to Thermostat",color=orange];
		1245 -> 1250;
	1246 [label="Add -3 to Thermostat",color=orange];
		1246 -> 1251;
	1244 [label="Chat ends.",color=orange];
	1241 [label="你的意思是，你想用自己取代皇帝和执行者？",shape=box,color=red];
		1241 -> 1247;
	1242 [label="那位统治者会是谁呢？",shape=box,color=red];
		1242 -> 1248;
	1243 [label="[结束]",shape=box,color=red];
		1243 -> 1249;
	1250 [label="奥罗金帝国并非全然邪恶。令我痛心的是，人们最终只会记住它带来的破坏和堕落。没错，它的破坏和堕落确实罄竹难书，这一点我并不否认。",shape=box,color=blue];
		1250 -> 1253;
	1251 [label="如果其他人也能这样想就好了。如果尼托也能这样想就好了。 ",shape=box,color=blue];
		1251 -> 1254;
	1247 [label="当然！",shape=box,color=blue];
		1247 -> 1252;
	1248 [label="当然是我自己。",shape=box,color=blue];
		1248 -> 1252;
	1249 [label="Chat ends.",color=orange];
	1253 [label="但它也创造了如此的美学，如此的欢乐，如此的爱，如此多的科学和艺术成就。看看我们曾经取得的成就吧！ ",shape=box,color=blue];
		1253 -> 1256;
	1254 [label="奥罗金帝国并非全然邪恶。令我痛心的是，人们最终只会记住它带来的破坏和堕落。没错，它的破坏和堕落确实罄竹难书，这一点我并不否认。",shape=box,color=blue];
		1254 -> 1253;
	1252 [label="我会确保所有执行者和皇帝都被……罢免，我将担任临时执行者，直到新的制度建立起来。",shape=box,color=blue];
		1252 -> 1255;
	1256 [label="所以，当尼托召我到她身边，告诉我她想杀光所有奥罗金人时，我立刻同意了。我渴望斩断这条毒蛇的头颅，我渴望用一个更仁慈的制度，一个更仁慈的统治者来取代它。",shape=box,color=blue];
		1256 -> 1260;
		1256 -> 1261;
	1255 [label="我不知道这需要多长时间，但这总比那场大战之后的情况要好，不是吗？",shape=box,color=blue];
		1255 -> 1257;
		1255 -> 1258;
		1255 -> 1259;
	1260 [label="你的意思是，你想用自己取代皇帝和执行者？",shape=box,color=red];
		1260 -> 1265;
	1261 [label="那位统治者会是谁呢？",shape=box,color=red];
		1261 -> 1266;
	1257 [label="那场大战？",shape=box,color=red];
		1257 -> 1262;
	1258 [label="扪心自问，你认为自己会放弃权力吗？",shape=box,color=red];
		1258 -> 1263;
	1259 [label="罗瑟，我不信你会甘愿放弃权力。",shape=box,color=red];
		1259 -> 1264;
	1265 [label="当然！​别装作​不​知道，​你​肯定​听过。​",shape=box,color=blue];
		1265 -> 1270;
	1266 [label="当然是我自己！​别装作​不​知道，​你​肯定​听过。​",shape=box,color=blue];
		1266 -> 1270;
	1262 [label="就是你现在称为“远古之战”的那场战役。但对我来说，它根本算不上“远古”，在我记忆中，它仿佛就发生在几年前。",shape=box,color=blue];
		1262 -> 1267;
	1263 [label="嗯，我不知道。现在这似乎已经不重要了，不是吗？但当时，我坚信我会的。",shape=box,color=blue];
		1263 -> 1268;
	1264 [label="+5 Chemistry",color=orange];
		1264 -> 1269;
	1270 [label="我会确保所有执行者和皇帝都被……罢免，我将担任临时执行者，直到新的制度建立起来。",shape=box,color=blue];
		1270 -> 1274;
	1267 [label="时间旅行就是这么奇妙。",shape=box,color=blue];
		1267 -> 1271;
	1268 [label="我费尽周折才回到这里，却发现……我的族人都死了。如果我当时也在对话，我也会和他们一起被处决。",shape=box,color=blue];
		1268 -> 1272;
	1269 [label="你，闭嘴。",shape=box,color=blue];
		1269 -> 1273;
	1274 [label="我不知道这需要多长时间，但这总比那场大战之后的情况要好，不是吗？",shape=box,color=blue];
		1274 -> 1258;
		1274 -> 1259;
		1274 -> 1257;
	1271 [label="在我看来，短短几年内，现实中已经过去了数千年——帝国覆灭，我的人民全部死去。 ",shape=box,color=blue];
		1271 -> 5775;
	1272 [label="在长胴鼓之夜，我本该和其他人一起被 Tenno 屠杀殆尽。我可能也会为了救尼托而牺牲。",shape=box,color=blue];
		1272 -> 1275;
	1273 [label="当时我深信自己会做到。但现在看来，这似乎已经无关紧要了，不是吗？",shape=box,color=blue];
		1273 -> 1268;
	5775 [label="我已经明白了，我当时是否会交出权力，其实根本无关紧要，尽管那时的我深信自己会这么做。",shape=box,color=blue];
		5775 -> 1272;
	1275 [label="我想知道她后来怎么样了？记录里甚至没有提到她的名字……所有以她的名义犯下的暴行，所有的死亡，所有的丑恶行径……也许只有我知道这些事。",shape=box,color=blue];
		1275 -> 1276;
	1276 [label="嗯，通过深溯池，将来可能会从 Tenno 的脑袋里解锁更多信息。但这并非我需要解决的问题。",shape=box,color=blue];
		1276 -> 1277;
		1276 -> 1278;
		1276 -> 1279;
	1277 [label="你好像有点被这孩子吓到了。",shape=box,color=red];
		1277 -> 1280;
	1278 [label="你和尼托之间发生了什么事？",shape=box,color=red];
		1278 -> 1281;
	1279 [label="所以你原本计划背叛奥罗金人？",shape=box,color=red];
		1279 -> 1282;
	1280 [label="我亲眼目睹一群学龄儿童，他们饱受虚空之苦，远程操控着被感染的战争机器。这些机器曾经是士兵，现在被改造成了怪诞、美丽而又嗜杀的艺术品，摧毁了整营的士兵。 ",shape=box,color=blue];
		1280 -> 1283;
	1281 [label="很多事情。",shape=box,color=blue];
		1281 -> 1284;
	1282 [label="是的，我们俩都是。虽然我相信尼托计划背叛我，而我也计划背叛尼托。你知道的，我们奥罗金人就是这样。",shape=box,color=blue];
		1282 -> 1285;
	1283 [label="我得知他们摧毁了我的帝国。一个统治整个始源星系的帝国。而且他们当时正准备剿灭 Tau 上的叛乱。",shape=box,color=blue];
		1283 -> 1286;
	1284 [label="尼托和我之间发生过太多事。",shape=box,color=blue];
		1284 -> 1287;
	1285 [label="每个人都在暗中算计别人。这就是我们的日常。",shape=box,color=blue];
		1285 -> 1288;
	1286 [label="他们居然花了一个晚上就做到了。",shape=box,color=blue];
		1286 -> 1289;
	1287 [label="甚至还有更多。",shape=box,color=blue];
		1287 -> 1290;
	1288 [label="奥罗金人之间的背叛司空见惯。但背叛整个帝国？这种叛国罪行不仅应由翠玉之光处决，更应用中枢计划处罚。",shape=box,color=blue];
		1288 -> 1291;
	1289 [label="难道你不觉得可怕吗？！",shape=box,color=blue];
		1289 -> 1292;
	1290 [label="我暂时不想多说。",shape=box,color=blue];
		1290 -> 1293;
	1291 [label="Update boolean RoatheTraitor1",color=orange];
		1291 -> 1294;
		1291 -> 1295;
	1292 [label="篡位者，我无法表达我们试图谋杀执行者们所冒的风险有多大，更不用说所有奥罗金人了。",shape=box,color=blue];
		1292 -> 1288;
	1293 [label="Update boolean RoatheExecutor1",color=orange];
		1293 -> 1292;
	1294 [label="这两种你认为哪一个更可怕？",shape=box,color=red];
		1294 -> 1296;
	1295 [label="所以那种手段居然不算正常？",shape=box,color=red];
		1295 -> 1297;
	1296 [label="毫无疑问，无刹的中枢计划。玻璃匠的作品都……",shape=box,color=blue];
		1296 -> 1298;
	1297 [label="奥罗金帝国的存亡如同一把匕首，岌岌可危，它时刻徘徊在毁灭的边缘。只有一件事能维持它的运转：",shape=box,color=blue];
		1297 -> 1299;
	1298 [label="翠玉之光对那些没有盔甲或护盾，无法抵挡一次爆炸的人来说，死的太快了。这是一种仁慈的死亡。",shape=box,color=blue];
		1298 -> 1300;
	1299 [label="社会规范。",shape=box,color=blue];
		1299 -> 1301;
	1300 [label="而中枢，如果是由自愿者转化而来，则可以做到无痛，甚至做到无损。但是……如果用于惩罚呢？",shape=box,color=blue];
		1300 -> 1302;
	1301 [label="谁都不会起来屠杀奥罗金人！漂泊者，这绝对不行！不可思议！简直是愚蠢至极！",shape=box,color=blue];
		1301 -> 1303;
	1302 [label="漂泊者，对奥罗金人来说，记忆是神圣的。归根结底，记忆就是我们的一切。我们的肉体是暂时的。我们的容貌、声音、血液，一切都会改变。一切都可以像时尚一样随意更换。",shape=box,color=blue];
		1302 -> 1304;
	1303 [label="也​正​因为​如此，​最后​这种事​做​起来​反而​容易​得​可笑。​我​相信​你​的​ Tenno ​分身​肯定​深​有​体会。​",shape=box,color=blue];
		1303 -> 1305;
		1303 -> 1306;
	1304 [label="Check boolean RoatheKnowsReset2",color=orange];
		1304 -> 1307 [label=true,color=green];
		1304 -> 1305 [label=false,color=brown];
		1304 -> 1306 [label=false,color=brown];
	1305 [label="但你显然从未走到尝试的地步。",shape=box,color=red];
		1305 -> 1308;
	1306 [label="你的计划后来怎么了？",shape=box,color=red];
		1306 -> 1309;
	1307 [label="顺便一提，也许这正是我这么生气的原因，因为你干涉了这些记忆。 ",shape=box,color=blue];
		1307 -> 1305;
		1307 -> 1306;
	1308 [label="Evaluate expressions on HellStory",color=orange];
