digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank2Convo5 begins." [color=orange];
		"RoatheRank2Convo5 begins." -> j2554321341;
	j2554321341 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		j2554321341 -> j364889355 [label=true,color=green];
		j2554321341 -> "Chat ends." [label=false,color=brown];
	j364889355 [label="Check boolean RoatheKnowsReset2",color=orange];
		j364889355 -> j3592496449 [label=true,color=green];
		j364889355 -> j1918363296 [label=false,color=brown];
	"Chat ends." [color=orange];
	j3592496449 [label="之前的罗瑟究竟跟你说过多少他和执行者尼托之间的交易？唉。我在尽力调和这一切：过去的我竟然信任你，把这些私人信息告诉你……结果你却把它们从我的记忆中彻底抹去？",shape=box,color=blue];
		j3592496449 -> j4111565513;
	j1918363296 [label="Evaluate expressions on HellStory counter",color=orange];
		j1918363296 -> j3858095843 [label="x >= 1",color=purple];
		j1918363296 -> "Chat ends." [label="x <= 1",color=purple];
		j1918363296 -> "Chat ends." [label="false",color=purple];
	j4111565513 [label="这让我的心好痛。我曾经把一切都告诉你，所有的一切——毫无保留地袒露心扉，直抵我内心最深处，而你……却把我的一切都抹去了。就好像我只不过是你的一个玩物。",shape=box,color=blue];
		j4111565513 -> j4025674432;
	j3858095843 [label="你之前听我提起过执行者尼托，以及我和她之间的……来往。你必须明白，奥罗金帝国并非全然邪恶。",shape=box,color=blue];
		j3858095843 -> j1067406791;
	j4025674432 [label="我想，这也算是报应吧。我们奥罗金人就是这样对待人类的，不是吗？青春厅堂？炫耀美丽的肉体，随意选择新的自我，用病态的游戏互相折磨，只为取乐……",shape=box,color=blue];
		j4025674432 -> j640284256;
	j1067406791 [label="令我痛心的是，人们最终只会记住它带来的破坏和堕落。没错，它的破坏和堕落确实罄竹难书，这一点我并不否认。",shape=box,color=blue];
		j1067406791 -> j2033142266;
	j640284256 [label="我讨厌这样。我非常非常讨厌这样。",shape=box,color=blue];
		j640284256 -> j4242971724;
		j640284256 -> j1404924650;
		j640284256 -> j1038552372;
	j2033142266 [label="但它也创造了如此的美学，如此的欢乐，如此的爱，如此多的科学和艺术成就。看看我们曾经取得的成就吧！ ",shape=box,color=blue];
		j2033142266 -> j1866771946;
	j4242971724 [label="虽然我不是故意这样伤害你，对此我深感抱歉，但如果这件事让你体会到了奥罗金帝国另一边的感受，那也是一个宝贵的教训。",shape=box,color=red];
		j4242971724 -> j447501273;
	j1404924650 [label="我从未想过这件事会以这种方式伤害你。你不必为奥罗金社会的运作方式道歉——它并非你一手缔造的，你只是试图挽救它。",shape=box,color=red];
		j1404924650 -> j2866530162;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j1866771946 [label="所以，当尼托召我到她身边，告诉我她想杀光所有奥罗金人时，我立刻同意了。我渴望斩断这条毒蛇的头颅，我渴望用一个更仁慈的制度，一个更仁慈的统治者来取代它。",shape=box,color=blue];
		j1866771946 -> j836421658;
		j1866771946 -> j1221669767;
		j1866771946 -> j1038552372;
	j447501273 [label="Add 3 to Thermostat counter",color=orange];
		j447501273 -> j3988925699;
	j2866530162 [label="Add -3 to Thermostat counter",color=orange];
		j2866530162 -> j766817468;
	j836421658 [label="你的意思是，你想用自己取代皇帝和执行者？",shape=box,color=red];
		j836421658 -> j692492767;
	j1221669767 [label="那位统治者会是谁呢？",shape=box,color=red];
		j1221669767 -> j2425322156;
	j3988925699 [label="奥罗金帝国并非全然邪恶。令我痛心的是，人们最终只会记住它带来的破坏和堕落。没错，它的破坏和堕落确实罄竹难书，这一点我并不否认。",shape=box,color=blue];
		j3988925699 -> j960121917;
	j766817468 [label="如果其他人也能这样想就好了。如果尼托也能这样想就好了。 ",shape=box,color=blue];
		j766817468 -> j3988925699;
	j692492767 [label="当然！",shape=box,color=blue];
		j692492767 -> j1547390951;
	j2425322156 [label="当然是我自己。",shape=box,color=blue];
		j2425322156 -> j1547390951;
	j960121917 [label="但它也创造了如此的美学，如此的欢乐，如此的爱，如此多的科学和艺术成就。看看我们曾经取得的成就吧！ ",shape=box,color=blue];
		j960121917 -> j6235700;
	j1547390951 [label="我会确保所有执行者和皇帝都被……罢免，我将担任临时执行者，直到新的制度建立起来。",shape=box,color=blue];
		j1547390951 -> j4260023839;
	j6235700 [label="所以，当尼托召我到她身边，告诉我她想杀光所有奥罗金人时，我立刻同意了。我渴望斩断这条毒蛇的头颅，我渴望用一个更仁慈的制度，一个更仁慈的统治者来取代它。",shape=box,color=blue];
		j6235700 -> j1534303634;
		j6235700 -> j2261431763;
	j4260023839 [label="我不知道这需要多长时间，但这总比那场大战之后的情况要好，不是吗？",shape=box,color=blue];
		j4260023839 -> j3165108905;
		j4260023839 -> j2951490365;
		j4260023839 -> j1890497984;
	j1534303634 [label="你的意思是，你想用自己取代皇帝和执行者？",shape=box,color=red];
		j1534303634 -> j2903117420;
	j2261431763 [label="那位统治者会是谁呢？",shape=box,color=red];
		j2261431763 -> j225620653;
	j3165108905 [label="那场大战？",shape=box,color=red];
		j3165108905 -> j3717921562;
	j2951490365 [label="扪心自问，你认为自己会放弃权力吗？",shape=box,color=red];
		j2951490365 -> j2725785373;
	j1890497984 [label="罗瑟，我不信你会甘愿放弃权力。",shape=box,color=red];
		j1890497984 -> j3296264942;
	j2903117420 [label="当然！​别装作​不​知道，​你​肯定​听过。​",shape=box,color=blue];
		j2903117420 -> j1069586578;
	j225620653 [label="当然是我自己！​别装作​不​知道，​你​肯定​听过。​",shape=box,color=blue];
		j225620653 -> j1069586578;
	j3717921562 [label="就是你现在称为“远古之战”的那场战役。但对我来说，它根本算不上“远古”，在我记忆中，它仿佛就发生在几年前。",shape=box,color=blue];
		j3717921562 -> j3122813204;
	j2725785373 [label="嗯，我不知道。现在这似乎已经不重要了，不是吗？但当时，我坚信我会的。",shape=box,color=blue];
		j2725785373 -> j2936670663;
	j3296264942 [label="+5 Chemistry",color=orange];
		j3296264942 -> j2893256907;
	j1069586578 [label="我会确保所有执行者和皇帝都被……罢免，我将担任临时执行者，直到新的制度建立起来。",shape=box,color=blue];
		j1069586578 -> j3008425890;
	j3122813204 [label="时间旅行就是这么奇妙。",shape=box,color=blue];
		j3122813204 -> j275005926;
	j2936670663 [label="我费尽周折才回到这里，却发现……我的族人都死了。如果我当时也在对话，我也会和他们一起被处决。",shape=box,color=blue];
		j2936670663 -> j3228290991;
	j2893256907 [label="你，闭嘴。",shape=box,color=blue];
		j2893256907 -> j202487240;
	j3008425890 [label="我不知道这需要多长时间，但这总比那场大战之后的情况要好，不是吗？",shape=box,color=blue];
		j3008425890 -> j2951490365;
		j3008425890 -> j1890497984;
		j3008425890 -> j3165108905;
	j275005926 [label="在我看来，短短几年内，现实中已经过去了数千年——帝国覆灭，我的人民全部死去。 ",shape=box,color=blue];
		j275005926 -> j3587780968;
	j3228290991 [label="在长胴鼓之夜，我本该和其他人一起被 Tenno 屠杀殆尽。我可能也会为了救尼托而牺牲。",shape=box,color=blue];
		j3228290991 -> j3935934634;
	j202487240 [label="当时我深信自己会做到。但现在看来，这似乎已经无关紧要了，不是吗？",shape=box,color=blue];
		j202487240 -> j2936670663;
	j3587780968 [label="我已经明白了，我当时是否会交出权力，其实根本无关紧要，尽管那时的我深信自己会这么做。",shape=box,color=blue];
		j3587780968 -> j3228290991;
	j3935934634 [label="我想知道她后来怎么样了？记录里甚至没有提到她的名字……所有以她的名义犯下的暴行，所有的死亡，所有的丑恶行径……也许只有我知道这些事。",shape=box,color=blue];
		j3935934634 -> j4203268350;
	j4203268350 [label="嗯，通过深溯池，将来可能会从 Tenno 的脑袋里解锁更多信息。但这并非我需要解决的问题。",shape=box,color=blue];
		j4203268350 -> j3508329931;
		j4203268350 -> j4228498595;
		j4203268350 -> j3531611798;
	j3508329931 [label="你好像有点被这孩子吓到了。",shape=box,color=red];
		j3508329931 -> j1580877253;
	j4228498595 [label="你和尼托之间发生了什么事？",shape=box,color=red];
		j4228498595 -> j4052685997;
	j3531611798 [label="所以你原本计划背叛奥罗金人？",shape=box,color=red];
		j3531611798 -> j2584170732;
	j1580877253 [label="我亲眼目睹一群学龄儿童，他们饱受虚空之苦，远程操控着被感染的战争机器。这些机器曾经是士兵，现在被改造成了怪诞、美丽而又嗜杀的艺术品，摧毁了整营的士兵。 ",shape=box,color=blue];
		j1580877253 -> j2075076372;
	j4052685997 [label="很多事情。",shape=box,color=blue];
		j4052685997 -> j492632712;
	j2584170732 [label="是的，我们俩都是。虽然我相信尼托计划背叛我，而我也计划背叛尼托。你知道的，我们奥罗金人就是这样。",shape=box,color=blue];
		j2584170732 -> j2712409656;
	j2075076372 [label="我得知他们摧毁了我的帝国。一个统治整个始源星系的帝国。而且他们当时正准备剿灭 Tau 上的叛乱。",shape=box,color=blue];
		j2075076372 -> j3193915999;
	j492632712 [label="尼托和我之间发生过太多事。",shape=box,color=blue];
		j492632712 -> j3444374133;
	j2712409656 [label="每个人都在暗中算计别人。这就是我们的日常。",shape=box,color=blue];
		j2712409656 -> j1903838267;
	j3193915999 [label="他们居然花了一个晚上就做到了。",shape=box,color=blue];
		j3193915999 -> j1284063966;
	j3444374133 [label="甚至还有更多。",shape=box,color=blue];
		j3444374133 -> j459086022;
	j1903838267 [label="奥罗金人之间的背叛司空见惯。但背叛整个帝国？这种叛国罪行不仅应由翠玉之光处决，更应用中枢计划处罚。",shape=box,color=blue];
		j1903838267 -> j1500183088;
	j1284063966 [label="难道你不觉得可怕吗？！",shape=box,color=blue];
		j1284063966 -> j1941586021;
	j459086022 [label="我暂时不想多说。",shape=box,color=blue];
		j459086022 -> j3700526275;
	j1500183088 [label="Boolean RoatheTraitor1 is now true.",color=orange];
		j1500183088 -> j3205614941;
		j1500183088 -> j1114212944;
	j1941586021 [label="篡位者，我无法表达我们试图谋杀执行者们所冒的风险有多大，更不用说所有奥罗金人了。",shape=box,color=blue];
		j1941586021 -> j1903838267;
	j3700526275 [label="Boolean RoatheExecutor1 is now true.",color=orange];
		j3700526275 -> j1941586021;
	j3205614941 [label="这两种你认为哪一个更可怕？",shape=box,color=red];
		j3205614941 -> j3405315655;
	j1114212944 [label="所以那种手段居然不算正常？",shape=box,color=red];
		j1114212944 -> j3952232768;
	j3405315655 [label="毫无疑问，无刹的中枢计划。玻璃匠的作品都……",shape=box,color=blue];
		j3405315655 -> j1596168001;
	j3952232768 [label="奥罗金帝国的存亡如同一把匕首，岌岌可危，它时刻徘徊在毁灭的边缘。只有一件事能维持它的运转：",shape=box,color=blue];
		j3952232768 -> j3114390717;
	j1596168001 [label="翠玉之光对那些没有盔甲或护盾，无法抵挡一次爆炸的人来说，死的太快了。这是一种仁慈的死亡。",shape=box,color=blue];
		j1596168001 -> j1663930502;
	j3114390717 [label="社会规范。",shape=box,color=blue];
		j3114390717 -> j3034820475;
	j1663930502 [label="而中枢，如果是由自愿者转化而来，则可以做到无痛，甚至做到无损。但是……如果用于惩罚呢？",shape=box,color=blue];
		j1663930502 -> j903300000;
	j3034820475 [label="谁都不会起来屠杀奥罗金人！漂泊者，这绝对不行！不可思议！简直是愚蠢至极！",shape=box,color=blue];
		j3034820475 -> j2771472228;
	j903300000 [label="漂泊者，对奥罗金人来说，记忆是神圣的。归根结底，记忆就是我们的一切。我们的肉体是暂时的。我们的容貌、声音、血液，一切都会改变。一切都可以像时尚一样随意更换。",shape=box,color=blue];
		j903300000 -> j4186474857;
	j2771472228 [label="也​正​因为​如此，​最后​这种事​做​起来​反而​容易​得​可笑。​我​相信​你​的​ Tenno ​分身​肯定​深​有​体会。​",shape=box,color=blue];
		j2771472228 -> j2225508643;
		j2771472228 -> j3352160829;
	j4186474857 [label="Check boolean RoatheKnowsReset2",color=orange];
		j4186474857 -> j3911566889 [label=true,color=green];
		j4186474857 -> j2225508643 [label=false,color=brown];
		j4186474857 -> j3352160829 [label=false,color=brown];
	j2225508643 [label="但你显然从未走到尝试的地步。",shape=box,color=red];
		j2225508643 -> j2745098065;
	j3352160829 [label="你的计划后来怎么了？",shape=box,color=red];
		j3352160829 -> j652053828;
	j3911566889 [label="顺便一提，也许这正是我这么生气的原因，因为你干涉了这些记忆。 ",shape=box,color=blue];
		j3911566889 -> j2225508643;
		j3911566889 -> j3352160829;
	j2745098065 [label="Evaluate expressions on HellStory counter",color=orange];
		j2745098065 -> j3058348119 [label="x >= 21",color=purple];
		j2745098065 -> j3761874180 [label="x < 21",color=purple];
		j2745098065 -> j3761874180 [label="false",color=purple];
	j652053828 [label="Evaluate expressions on HellStory counter",color=orange];
		j652053828 -> j1991924989 [label="x >= 21",color=purple];
		j652053828 -> j1638422674 [label="x < 21",color=purple];
		j652053828 -> j1638422674 [label="false",color=purple];
	j3058348119 [label="你说得对，这显而易见！在我和尼托设下陷阱准备对付执行者后，阿尔布雷希特就在那条走廊里遇到了我。",shape=box,color=blue];
		j3058348119 -> j442372092;
	j3761874180 [label="对，显然没有。在我和尼托设下陷阱准备对付执行者后，我就被阿尔布雷希特强行变成了这种……东西。",shape=box,color=blue];
		j3761874180 -> j3293449159;
	j1991924989 [label="你很清楚我们的计划出了什么问题，对吧？！在我和尼托设下陷阱准备对付执行者后，阿尔布雷希特就在那条走廊里遇到了我。",shape=box,color=blue];
		j1991924989 -> j3532514431;
	j1638422674 [label="在我和尼托设下陷阱准备对付执行者后，我就被阿尔布雷希特强行变成了这种……东西。",shape=box,color=blue];
		j1638422674 -> j3293449159;
	j442372092 [label="然后​他​给​了​我​原型​战甲​血清。​之后……​嗯……​我们​都​知道​接​下来​发生​了​什么。​",shape=box,color=blue];
		j442372092 -> j2148066981;
	j3293449159 [label="我记得前一刻还站在一条金色的大厅里，下一刻就痛苦地尖叫着，身处“高卢”某个偏僻的地狱般的地方。",shape=box,color=blue];
		j3293449159 -> j399992206;
	j3532514431 [label="然后​他​给​了​我​原型​战甲​血清。​​我们​都​知道​接​下来​发生​了​什么！",shape=box,color=blue];
		j3532514431 -> j2148066981;
	j2148066981 [label="对于这件事我至今仍然很生气。为什么？！我为什么要向你坦白？！你怎么会知道？！ ",shape=box,color=blue];
		j2148066981 -> j1168210689;
	j399992206 [label="我失踪后，尼托肯定放弃了那个计划。很有可能，她把整个叛国事件都栽赃给了我，让我成了方便的替罪羊。",shape=box,color=blue];
		j399992206 -> j3129825728;
	j1168210689 [label="呸！算了。我得走了，免得一时冲动把这该死的电脑砸了。",shape=box,color=blue];
		j1168210689 -> j1933300832;
	j3129825728 [label="这解释了我查阅的记录中所有称我为“懦夫”的说法。他们当然会认为我是懦夫——他们以为我逃跑了！呸。",shape=box,color=blue];
		j3129825728 -> j974587442;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j974587442 [label="+10 Chemistry",color=orange];
		j974587442 -> j3685705035;
	j3685705035 [label="得知我对这个计划至关重要，我感到很欣慰；然而，我离开后，这个计划却不得不彻底取消。",shape=box,color=blue];
		j3685705035 -> j667841635;
		j3685705035 -> j3344954414;
	j667841635 [label="我不太确定……那是不是你该从这件事里得出的结论。",shape=box,color=red];
		j667841635 -> j3000607883;
	j3344954414 [label="被需要的感觉真好。",shape=box,color=red];
		j3344954414 -> j178302827;
	j3000607883 [label="Add 1 to Thermostat counter",color=orange];
		j3000607883 -> j2504859060;
	j178302827 [label="+5 Chemistry",color=orange];
		j178302827 -> j598536398;
	j2504859060 [label="漂泊者，你想在哪里找到自己的价值就在哪里找吧，而我的价值让我自己去找。",shape=box,color=blue];
		j2504859060 -> "Chat ends.";
	j598536398 [label="Add -1 to Thermostat counter",color=orange];
		j598536398 -> j3091581660;
	j3091581660 [label="你看？你能明白。",shape=box,color=blue];
		j3091581660 -> "Chat ends.";
}