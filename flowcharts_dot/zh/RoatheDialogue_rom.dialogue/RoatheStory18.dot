		2292 -> 5717;
	5717 [label="她的声音如同碎玻璃般刺耳。",shape=box,color=blue];
		5717 -> 5718;
	5718 [label="执行者尼托很不高兴。她原本期待的是一场辉煌的升级，一场接一场的战斗，最终以奥罗金人覆灭的狂喜告终。",shape=box,color=blue];
		5718 -> 5719;
	5719 [label="之后她便会从藏身处现身……嗯，后面的我只能猜测了。或许她希望能够获得 Sentient 的信任。",shape=box,color=blue];
		5719 -> 2291;
	2291 [label="或许她以为他们会抛弃始源星系那片焦土和污染的残骸，让她得以建立属于自己的新王国。",shape=box,color=blue];
		2291 -> 2297;
