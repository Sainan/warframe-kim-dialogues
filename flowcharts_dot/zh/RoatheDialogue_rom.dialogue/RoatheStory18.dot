	j1561723044 [label="语音留言：叛国",shape=box,color=blue];
		j1561723044 -> j1443888261;
	j1443888261 [label="文字记录：“和平？”",shape=box,color=blue];
		j1443888261 -> j1672112133;
	j1672112133 [label="她的声音如同碎玻璃般刺耳。",shape=box,color=blue];
		j1672112133 -> j4140623031;
	j4140623031 [label="执行者尼托很不高兴。她原本期待的是一场辉煌的升级，一场接一场的战斗，最终以奥罗金人覆灭的狂喜告终。",shape=box,color=blue];
		j4140623031 -> j2951681724;
	j2951681724 [label="之后她便会从藏身处现身……嗯，后面的我只能猜测了。或许她希望能够获得 Sentient 的信任。",shape=box,color=blue];
		j2951681724 -> j2899117038;
	j2899117038 [label="或许她以为他们会抛弃始源星系那片焦土和污染的残骸，让她得以建立属于自己的新王国。",shape=box,color=blue];
		j2899117038 -> j1940766156;
	j1940766156 [label="无论如何，和平是无法容忍的。所以我们开始着手破坏和平。",shape=box,color=blue];
		j1940766156 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}