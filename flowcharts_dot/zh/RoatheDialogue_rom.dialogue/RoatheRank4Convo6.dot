	j3609398078 [label="Boolean RoatheWeaponPoison is now true.",color=orange];
		j3609398078 -> j2990602366;
		j3609398078 -> j1292901753;
		j3609398078 -> j755572460;
	j1500299692 [label="因为这就是艺术。而且你也心知肚明。实际上，你存在的另一半，从字面上讲，都是建立在将杀戮视为一种艺术形式这一概念之上的！",shape=box,color=blue];
		j1500299692 -> j3517028364;
	j1344561614 [label="哦？真的吗？让我们花点时间来仔细分析一下。",shape=box,color=blue];
		j1344561614 -> j1890799743;
	j240145305 [label="已经变了。这让我非常困扰。",shape=box,color=blue];
		j240145305 -> j780454234;
		j240145305 -> j2983637600;
	j3517028364 [label="我​见​过​ Tenno ​使用​的​那些​“学派”，​而​你​只​是​间接​地​借用​了​它们。​更别​提禁​卫​的​教导​了。​无论​我们​告诉​他们​多​少​次​这​是​禁播​频道，​他们​都​会​没​完没​了​地​在​通讯​频道里​说​个​不​停。​",shape=box,color=blue];
		j3517028364 -> j1534262553;
	j1890799743 [label="告诉我一些事情，请务必诚实回答。因为此时此刻说谎对我们双方都没有好处，尤其对你自身而言更是如此：",shape=box,color=blue];
		j1890799743 -> j34775007;
	j780454234 [label="变了，怎么会？",shape=box,color=red];
		j780454234 -> j1272293431;
	j2983637600 [label="因为 Uriel？",shape=box,color=red];
		j2983637600 -> j830318861;
	j1534262553 [label="如果我再也不用听他们对我说“我是一把刀”和“我存在的意义就是出击”，那么我死而无憾了，篡位者。",shape=box,color=blue];
		j1534262553 -> j4064322583;
	j34775007 [label="你是否曾经想过为自己打造一件符合个人喜好的武器或战甲？比如，为其涂装独一无二的图案，或者选择一种更符合你心情的外观？",shape=box,color=blue];
		j34775007 -> j2710328700;
		j34775007 -> j3979002447;
		j34775007 -> j4141271099;
	j1272293431 [label="我过去最喜欢用剑。优雅，迅捷。我可以穿梭于战场，在触手可及的范围内斩杀敌人。鲜红的剑刃闪耀在银光之中，如同蓝色的星辰。",shape=box,color=blue];
		j1272293431 -> j1965533751;
	j830318861 [label="我想应该是这样。或许是因为我缺失了一些记忆。我不知道还有什么其他原因。",shape=box,color=blue];
		j830318861 -> j1272293431;
	j4064322583 [label="人类历来视“谋杀”为罪恶，却视“杀戮”为艺术。你难道从未觉得这很奇怪吗？挥舞利刃，在战斗中击败敌人，被视为近乎超凡脱俗的存在。",shape=box,color=blue];
		j4064322583 -> j3399706108;
	j2710328700 [label=" 我有……这跟这件事有什么关系？",shape=box,color=red];
		j2710328700 -> j3166569158;
	j3979002447 [label="没有，从来没有。",shape=box,color=red];
		j3979002447 -> j2028959303;
	j4141271099 [label="我不想跟你玩这个。[结束]",shape=box,color=red];
		j4141271099 -> j578323833;
	j1965533751 [label="但现在呢？现在我只想尝尝牙齿上的血腥味，感受鲜血在利爪下喷涌而出。我只想把手指深深插入血肉和骨骼，将它们撕成碎片。",shape=box,color=blue];
		j1965533751 -> j363786372;
	j3399706108 [label="在小巷里用磨尖的金属片杀人，是懦夫和堕落的行为。 ",shape=box,color=blue];
		j3399706108 -> j868026908;
	j3166569158 [label="我很欣赏你的坦诚。当然，我不会否认你很可能并不享受冷血的谋杀，杀害无辜生命也不是你会感到愉悦的事情（尽管也许之前的说法是谎言，而你真的享受，如果能揭穿这一点该是多么令人兴奋啊，但这并非我们今天要讨论的重点）。",shape=box,color=blue];
		j3166569158 -> j2543069248;
	j2028959303 [label="请你花点时间好好想想。我亲眼看到你的那些 Tenno 朋友在这里横冲直撞，就像一群五彩斑斓的马戏团噩梦，就像野兽掉进了艺术家的颜料罐里。 ",shape=box,color=blue];
		j2028959303 -> j344281900;
	j578323833 [label="非常好。",shape=box,color=blue];
		j578323833 -> "Chat ends.";
	j363786372 [label="我想痛饮那鲜血，同时折断筋腱，感受身躯在我身下撕裂成血淋淋的碎片。像剥开甜美的果实一样，将它层层剥开，让骨髓流淌。",shape=box,color=blue];
		j363786372 -> j2326541898;
		j363786372 -> j1299821547;
	j868026908 [label="区别在哪儿？“荣誉”？谁来决定什么是荣誉，什么是不荣誉？是失败者？还是胜利者？或者仅仅是因为存在足够多的传统，才足以界定什么是荣誉，什么是不荣誉？",shape=box,color=blue];
		j868026908 -> j1507849920;
		j868026908 -> j1480499324;
		j868026908 -> j3266533987;
	j2543069248 [label="但假设情况并非如此，你只是像你所说的那样因为“不得不”而杀人，那么请问，你为什么要花时间以个性化的方式装饰你的杀人武器呢？",shape=box,color=blue];
		j2543069248 -> j4270233196;
	j344281900 [label="你从未感到过必须这样做吗？一次也没有？我向你保证，即使你承认这一点，我也不会因此而看不起你。",shape=box,color=blue];
		j344281900 -> j2455721722;
		j344281900 -> j1394052136;
	j2326541898 [label="罗瑟？",shape=box,color=red];
		j2326541898 -> j2880387018;
	j1299821547 [label="这……对你来说不正常吗？",shape=box,color=red];
		j1299821547 -> j3748575689;
	j1507849920 [label="我明白你的意思。界限确实模糊不清。 ",shape=box,color=red];
		j1507849920 -> j3821933013;
	j1480499324 [label="一种需要练习和投入，另一种则纯粹是……残暴。",shape=box,color=red];
		j1480499324 -> j128687311;
	j3266533987 [label="我不想继续这个话题。[结束]",shape=box,color=red];
		j3266533987 -> j578323833;
	j4270233196 [label="为什么要在意自己在死亡战场上的形象？当然不是为了方便别人辨认你的尸体。你这副模样，谁也认不出来。不，因为如果你非要当杀人犯，我亲爱的篡位者，我敢打赌，你肯定想死得轰轰烈烈。",shape=box,color=blue];
		j4270233196 -> j236269461;
	j2455721722 [label="没有。",shape=box,color=red];
		j2455721722 -> j578323833;
	j1394052136 [label="好，我有。那又怎么了？",shape=box,color=red];
		j1394052136 -> j3166569158;
	j2880387018 [label="是的，我知道！我知道。但我不会做这些事，请注意。我也不会把周围的一切都烧成灰烬，尽管我很想这么做。",shape=box,color=blue];
		j2880387018 -> j2313833228;
	j3748575689 [label="不！绝对不！想到要把周围的一切都烧成灰烬，我就流口水，这也不正常！",shape=box,color=blue];
		j3748575689 -> j2313833228;
	j3821933013 [label="所有这些界限都是人为划定的。我们越早明白这一点，就能越快达成共识，比如哪些仗值得打、哪些仗不值得打。",shape=box,color=blue];
		j3821933013 -> j2026143385;
	j128687311 [label="很好，我们就顺着这个思路推演下去。杀人练得足够多就能变得光荣？所以你的意思是，如果我像禁卫那样，只要把谋杀包装得足够隆重隆重，就能把它变成艺术？",shape=box,color=blue];
		j128687311 -> j1244742401;
	j236269461 [label="那如果这种行为不是享受，那又是什么呢？",shape=box,color=blue];
		j236269461 -> j1147552886;
	j2313833228 [label="一定是 Uriel 的错。虽然我承认以前也有过类似的毁灭性和嗜血的想法，但远没有现在这么可怕。",shape=box,color=blue];
		j2313833228 -> j2266929136;
	j2026143385 [label="判断一次杀戮是否光荣，就好比判断死于火刑还是溺水更惨。两者都是极其痛苦的死法。",shape=box,color=blue];
		j2026143385 -> j1529701267;
	j1244742401 [label="现在我们正在游走在仪式和宗教的边缘。",shape=box,color=blue];
		j1244742401 -> j4029105686;
	j1147552886 [label="别误会！我不是在评判你。你已经尽力做到最好了！死神让你成为她在这场人生闹剧中的舞伴，你除了听从她的召唤，别无选择。",shape=box,color=blue];
		j1147552886 -> j142042448;
	j2266929136 [label="当然，也远没有那么……末日味。",shape=box,color=blue];
		j2266929136 -> "Chat ends.";
	j1529701267 [label="反正​殊途同归，​何必斤​斤计较？​我们​还​有​更​重要​的​问题​需要​解决。​",shape=box,color=blue];
		j1529701267 -> "Chat ends.";
	j4029105686 [label="至少，用刀捅死这种简单直接的死法还比较真诚。它不带任何虔诚，也不张扬或矫揉造作。就这样结束。",shape=box,color=blue];
		j4029105686 -> j1511744084;
	j142042448 [label="如果你放下武器，我不知道会有多少人会死在你身边。不，为什么不为自己的工作感到一丝自豪？为什么不享受一下这其中的乐趣？我问你，你还能选择什么？疯狂？遗忘？",shape=box,color=blue];
		j142042448 -> j29128888;
	j1511744084 [label="难道这其中就没有艺术性吗？",shape=box,color=blue];
		j1511744084 -> "Chat ends.";
	j29128888 [label="我见过太多人走上这条路，最终落得个绞刑架的下场。不，我说，篡位者，随你便吧。因为生活终究会按照它它自己的意愿，把你塑造成现在的模样。",shape=box,color=blue];
		j29128888 -> "Chat ends.";
}