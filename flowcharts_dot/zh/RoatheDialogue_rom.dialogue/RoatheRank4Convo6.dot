digraph {
	"RoatheRank4Convo6 begins." [color=orange];
		"RoatheRank4Convo6 begins." -> j4277984778;
	j4277984778 [label="篡位者，你最喜欢用哪种方式杀人？",shape=box,color=blue];
		j4277984778 -> j605138612;
		j4277984778 -> j3971353817;
		j4277984778 -> j1038552372;
	j605138612 [label="你说什么？",shape=box,color=red];
		j605138612 -> j2288830653;
	j3971353817 [label="你这是想打听些什么吗？",shape=box,color=red];
		j3971353817 -> j3537302254;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j2288830653 [label="最近我发现自己经常会思考一些哲学问题，我只是单纯地好奇。",shape=box,color=blue];
		j2288830653 -> j3919319166;
	j3537302254 [label="哈！不是。不过……跟你打几局应该挺有意思的。不，最近我发现自己经常会思考一些哲学问题，我只是单纯地好奇。",shape=box,color=blue];
		j3537302254 -> j3919319166;
	"Chat ends." [color=orange];
	j3919319166 [label="论人数，我觉得你我差不多。至于杀伤力嘛……我可不想打赌，也对这种比拼剑术的比赛没什么兴趣。",shape=box,color=blue];
		j3919319166 -> j1680612110;
	j1680612110 [label="杀手对杀手，你更喜欢哪种？你喜欢近身肉搏吗？你喜欢潜行，还是喜欢战场上的混乱？",shape=box,color=blue];
		j1680612110 -> j3176621857;
		j1680612110 -> j3651115282;
		j1680612110 -> j3282908923;
		j1680612110 -> j3773863406;
	j3176621857 [label="我喜欢混乱。爆炸声。枪声。巨响。越多越好。",shape=box,color=red];
		j3176621857 -> j4080212651;
	j3651115282 [label="潜行。我喜欢在敌人察觉到我之前就解决掉他们。如果可以的话，我会在他们睡觉的地方动手。",shape=box,color=red];
		j3651115282 -> j2428380604;
	j3282908923 [label="我讨厌战斗。我希望永远不用战斗。",shape=box,color=red];
		j3282908923 -> j2103344192;
	j3773863406 [label="这话题简直让人作呕。",shape=box,color=red];
		j3773863406 -> j672769189;
	j4080212651 [label="Boolean RoatheSoldier is now true.",color=orange];
		j4080212651 -> j3327560905;
	j2428380604 [label="Boolean RoatheAssassin is now true.",color=orange];
		j2428380604 -> j4133791141;
	j2103344192 [label="哦，我可怜的篡位者，如果你能听到我刚才的笑声……",shape=box,color=blue];
		j2103344192 -> j3579512783;
	j672769189 [label="那么，走吧。",shape=box,color=blue];
		j672769189 -> "Chat ends.";
	j3327560905 [label="像我一样身经百战的老兵。鉴于我对你过往的了解，我并不感到意外。你走到哪里，哪里就有鲜血。先是双衍王境，然后是“合一众”，接着是霍瓦尼亚，现在又是这出闹剧。",shape=box,color=blue];
		j3327560905 -> j2517903771;
	j4133791141 [label="啊，我们中间竟然藏着一位刺客！如此有用，却又如此不被赏识。我一直觉得刺客就像技艺高超的管家。",shape=box,color=blue];
		j4133791141 -> j410046528;
	j3579512783 [label="你这个可怜的、一无所有的家伙。为了你自己着想，我希望你是在骗我。",shape=box,color=blue];
		j3579512783 -> j2984675845;
	j2517903771 [label="谁知道还有什么，或者之后发生了什么，或者你这段时间里忘记了什么。死亡是你的艺术，你用它描绘世界。",shape=box,color=blue];
		j2517903771 -> j2007675534;
	j410046528 [label="当他们把工作做得非常出色时，往往不为人知。",shape=box,color=blue];
		j410046528 -> j2085178399;
	j2984675845 [label="+20 Chemistry",color=orange];
		j2984675845 -> j3003604376;
	j2007675534 [label="那么！你最喜欢的画笔是什么？让我们来深入探讨一下。",shape=box,color=blue];
		j2007675534 -> j2571923588;
		j2007675534 -> j3809631820;
		j2007675534 -> j4132307951;
		j2007675534 -> j2619280354;
	j2085178399 [label="那么，是匕首？毒药？还是弓箭？",shape=box,color=blue];
		j2085178399 -> j1195587350;
		j2085178399 -> j3287893226;
		j2085178399 -> j3778062110;
		j2085178399 -> j2094964778;
		j2085178399 -> j3154032602;
	j3003604376 [label="否则，那可能是我这么多年来听过的最悲伤的事情了。",shape=box,color=blue];
		j3003604376 -> j2927459171;
	j2571923588 [label="说实话，我会就地取材。我喜欢随机应变。",shape=box,color=red];
		j2571923588 -> j1821977982;
	j3809631820 [label="一把弓。优雅而致命。",shape=box,color=red];
		j3809631820 -> j214944810;
	j4132307951 [label="一把刀。我喜欢近距离接触。",shape=box,color=red];
		j4132307951 -> j1519165463;
	j2619280354 [label="步枪和各种枪械。声音大，但能完成任务。",shape=box,color=red];
		j2619280354 -> j749012654;
	j1195587350 [label="说实话，我会就地取材。我喜欢随机应变。",shape=box,color=red];
		j1195587350 -> j657179978;
	j3287893226 [label="弓箭。优雅而无声。",shape=box,color=red];
		j3287893226 -> j2767896085;
	j3778062110 [label="狙击步枪。一枪毙命。",shape=box,color=red];
		j3778062110 -> j1623069280;
	j2094964778 [label="毒药。我走的时候，他们甚至还没意识到自己已经死了。",shape=box,color=red];
		j2094964778 -> j2599571804;
	j3154032602 [label="匕首。我喜欢它带来的贴身感。",shape=box,color=red];
		j3154032602 -> j4286031449;
	j2927459171 [label="Boolean RoatheWeaponNone is now true.",color=orange];
		j2927459171 -> "Chat ends.";
	j1821977982 [label="我坐在这里，想象着你扛着医疗椅在战场上横冲直撞，用绑在弯曲管道上的轮胎撕碎士兵。",shape=box,color=blue];
		j1821977982 -> j2521514822;
	j214944810 [label="在激烈的战斗中挥舞弓箭，需要极强的意志力和清晰的头脑，这几乎是人人都难以企及的。当然，还需要一双稳健的手。",shape=box,color=blue];
		j214944810 -> j2417166933;
	j1519165463 [label="嗯，小心点。别让我太兴奋，篡位者。我多么想看到你手持武器，在战场上翩翩起舞，鲜血如盛开的花瓣般飞溅……",shape=box,color=blue];
		j1519165463 -> j4230675390;
	j749012654 [label="篡位者，它们自发明之日起就一直是战争的主力军，这绝非偶然。然而，不可否认的是，当它们射中预定目标时，便能完成其使命。",shape=box,color=blue];
		j749012654 -> j4077100163;
	j657179978 [label="我坐在这里，想象着你用刀叉或椅子腿刺杀某人，用窗帘的系带夺走某人的生命。",shape=box,color=blue];
		j657179978 -> j2304485743;
	j2767896085 [label="猎人之道。看似简单，实则精妙。有时，最简单、最古老的方法，其本质才是最有效的。",shape=box,color=blue];
		j2767896085 -> j1432687866;
	j1623069280 [label="对我来说，这有点冷冰冰的，缺乏人情味，但我不能就效率问题来评判它。这份平静自有其可取之处。",shape=box,color=blue];
		j1623069280 -> j1049127675;
	j2599571804 [label="那个阴险的药剂师？他是不是在调制酊剂，然后把药瓶里的药水倒入毫无戒心的人的杯子里？或者在刀和子弹里掺入毒液，让战场上哪怕最轻微的擦伤都变成致命一击？",shape=box,color=blue];
		j2599571804 -> j719659950;
	j4286031449 [label="嗯，小心点。别让我太兴奋，篡位者。多么诱人啊，想象一下，某天夜里醒来，你潜伏在阴影里，匕首已就位，随时准备出手……",shape=box,color=blue];
		j4286031449 -> j3548185222;
	j2521514822 [label="+10 Chemistry",color=orange];
		j2521514822 -> j268730430;
	j2417166933 [label="一切都如此静谧，值得细细品味。搭箭、拉弓、等待释放……然后，当箭矢命中目标，带来甜蜜的死亡？",shape=box,color=blue];
		j2417166933 -> j526850990;
	j4230675390 [label="我欣赏这种亲力亲为的渴望。看着受害者的四肢在你终结他们生命时逐渐消散。看着他们毫无生气的躯体在你面前瘫倒。知道这一切都是你亲手完成的，而不是别人。",shape=box,color=blue];
		j4230675390 -> j3056245838;
	j4077100163 [label="混乱、大声、价格极其昂贵。但杀伤力却非常非常强。",shape=box,color=blue];
		j4077100163 -> j3183571583;
	j2304485743 [label="+10 Chemistry",color=orange];
		j2304485743 -> j3844386251;
	j1432687866 [label="一切都如此静谧，值得细细品味。搭箭、拉弓、等待释放……然后，当箭矢命中目标，带来甜蜜的死亡？",shape=box,color=blue];
		j1432687866 -> j61072420;
	j1049127675 [label="在看似永无止境的战场喧嚣中，狙击手必须像潮汐般找到呼吸的节奏。吸气，呼气，然后夺走一条生命。",shape=box,color=blue];
		j1049127675 -> j916937495;
	j719659950 [label="我曾亲眼目睹，仅仅一个士兵手臂上的一个小伤口，就导致整个营的士兵化为灰烬。一种毒素从血液扩散到肺部，再扩散到另一个人的肺部，足以摧毁一个国家。",shape=box,color=blue];
		j719659950 -> j98108232;
	j3548185222 [label="我欣赏这种对亲自动手的渴望。凝视着另一个人的眼睛，看着它们变得空洞黯淡，随着光线渐暗，身体的温度也随之消逝。",shape=box,color=blue];
		j3548185222 -> j1158691359;
	j268730430 [label="我……无法决定这究竟是让你更可怕还是更不可怕，篡位者。我想我还是倾向于认为你更可怕。无论如何，我觉得这本身就很有趣，也很引人注目。",shape=box,color=blue];
		j268730430 -> j777855750;
