		j777855750 -> j755572460;
	j1677000911 [label="真美。",shape=box,color=blue];
		j1677000911 -> j2888608214;
	j422209834 [label="这一刻多么美好。",shape=box,color=blue];
		j422209834 -> j918012326;
	j436413849 [label="它有一种独特的美感。",shape=box,color=blue];
		j436413849 -> j4290874667;
	j1653276171 [label="真美。",shape=box,color=blue];
		j1653276171 -> j2888608214;
	j3919066059 [label="其中蕴含着美。",shape=box,color=blue];
		j3919066059 -> j4290874667;
	j2509120544 [label="如此大规模的死亡？其中也蕴含着美。",shape=box,color=blue];
		j2509120544 -> j3609398078;
	j3763402612 [label="这一刻多么美好。",shape=box,color=blue];
		j3763402612 -> j918012326;
	j2990602366 [label="你这话说的好像这是某种……艺术形式似的。",shape=box,color=red];
		j2990602366 -> j1500299692;
	j1292901753 [label="罗瑟，我不喜欢杀人。 ",shape=box,color=red];
		j1292901753 -> j1344561614;
