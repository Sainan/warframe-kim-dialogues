digraph {
	2743 [label="RoatheRank4Convo6 begins.",color=orange];
		2743 -> 2744;
	2744 [label="篡位者，你最喜欢用哪种方式杀人？",shape=box,color=blue];
		2744 -> 2746;
		2744 -> 2747;
		2744 -> 2745;
	2746 [label="你说什么？",shape=box,color=red];
		2746 -> 2749;
	2747 [label="你这是想打听些什么吗？",shape=box,color=red];
		2747 -> 2750;
	2745 [label="[结束]",shape=box,color=red];
		2745 -> 2748;
	2749 [label="最近我发现自己经常会思考一些哲学问题，我只是单纯地好奇。",shape=box,color=blue];
		2749 -> 2751;
	2750 [label="哈！不是。不过……跟你打几局应该挺有意思的。不，最近我发现自己经常会思考一些哲学问题，我只是单纯地好奇。",shape=box,color=blue];
		2750 -> 2751;
	2748 [label="Chat ends.",color=orange];
	2751 [label="论人数，我觉得你我差不多。至于杀伤力嘛……我可不想打赌，也对这种比拼剑术的比赛没什么兴趣。",shape=box,color=blue];
		2751 -> 2752;
	2752 [label="杀手对杀手，你更喜欢哪种？你喜欢近身肉搏吗？你喜欢潜行，还是喜欢战场上的混乱？",shape=box,color=blue];
		2752 -> 2753;
		2752 -> 2754;
		2752 -> 2755;
		2752 -> 2756;
	2753 [label="我喜欢混乱。爆炸声。枪声。巨响。越多越好。",shape=box,color=red];
		2753 -> 2757;
	2754 [label="潜行。我喜欢在敌人察觉到我之前就解决掉他们。如果可以的话，我会在他们睡觉的地方动手。",shape=box,color=red];
		2754 -> 2758;
	2755 [label="我讨厌战斗。我希望永远不用战斗。",shape=box,color=red];
		2755 -> 2759;
	2756 [label="这话题简直让人作呕。",shape=box,color=red];
		2756 -> 2760;
	2757 [label="Update boolean RoatheSoldier",color=orange];
		2757 -> 2761;
	2758 [label="Update boolean RoatheAssassin",color=orange];
		2758 -> 2762;
	2759 [label="哦，我可怜的篡位者，如果你能听到我刚才的笑声……",shape=box,color=blue];
		2759 -> 2763;
	2760 [label="那么，走吧。",shape=box,color=blue];
		2760 -> 2764;
	2761 [label="像我一样身经百战的老兵。鉴于我对你过往的了解，我并不感到意外。你走到哪里，哪里就有鲜血。先是双衍王境，然后是“合一众”，接着是霍瓦尼亚，现在又是这出闹剧。",shape=box,color=blue];
		2761 -> 2765;
	2762 [label="啊，我们中间竟然藏着一位刺客！如此有用，却又如此不被赏识。我一直觉得刺客就像技艺高超的管家。",shape=box,color=blue];
		2762 -> 2766;
	2763 [label="你这个可怜的、一无所有的家伙。为了你自己着想，我希望你是在骗我。",shape=box,color=blue];
		2763 -> 2767;
	2764 [label="Chat ends.",color=orange];
	2765 [label="谁知道还有什么，或者之后发生了什么，或者你这段时间里忘记了什么。死亡是你的艺术，你用它描绘世界。",shape=box,color=blue];
		2765 -> 2768;
	2766 [label="当他们把工作做得非常出色时，往往不为人知。",shape=box,color=blue];
		2766 -> 2769;
	2767 [label="+20 Chemistry",color=orange];
		2767 -> 2770;
	2768 [label="那么！你最喜欢的画笔是什么？让我们来深入探讨一下。",shape=box,color=blue];
		2768 -> 2771;
		2768 -> 2772;
		2768 -> 2773;
		2768 -> 2774;
	2769 [label="那么，是匕首？毒药？还是弓箭？",shape=box,color=blue];
		2769 -> 2775;
		2769 -> 2776;
		2769 -> 2777;
		2769 -> 2778;
		2769 -> 2779;
	2770 [label="否则，那可能是我这么多年来听过的最悲伤的事情了。",shape=box,color=blue];
		2770 -> 2780;
	2771 [label="说实话，我会就地取材。我喜欢随机应变。",shape=box,color=red];
		2771 -> 2781;
	2772 [label="一把弓。优雅而致命。",shape=box,color=red];
		2772 -> 2782;
	2773 [label="一把刀。我喜欢近距离接触。",shape=box,color=red];
		2773 -> 2783;
	2774 [label="步枪和各种枪械。声音大，但能完成任务。",shape=box,color=red];
		2774 -> 2784;
	2775 [label="说实话，我会就地取材。我喜欢随机应变。",shape=box,color=red];
		2775 -> 2785;
	2776 [label="弓箭。优雅而无声。",shape=box,color=red];
		2776 -> 2786;
	2777 [label="狙击步枪。一枪毙命。",shape=box,color=red];
		2777 -> 2787;
	2778 [label="毒药。我走的时候，他们甚至还没意识到自己已经死了。",shape=box,color=red];
		2778 -> 2788;
	2779 [label="匕首。我喜欢它带来的贴身感。",shape=box,color=red];
		2779 -> 2789;
	2780 [label="Update boolean RoatheWeaponNone",color=orange];
		2780 -> 2790;
	2781 [label="我坐在这里，想象着你扛着医疗椅在战场上横冲直撞，用绑在弯曲管道上的轮胎撕碎士兵。",shape=box,color=blue];
		2781 -> 2791;
	2782 [label="在激烈的战斗中挥舞弓箭，需要极强的意志力和清晰的头脑，这几乎是人人都难以企及的。当然，还需要一双稳健的手。",shape=box,color=blue];
		2782 -> 2792;
	2783 [label="嗯，小心点。别让我太兴奋，篡位者。我多么想看到你手持武器，在战场上翩翩起舞，鲜血如盛开的花瓣般飞溅……",shape=box,color=blue];
		2783 -> 2793;
	2784 [label="篡位者，它们自发明之日起就一直是战争的主力军，这绝非偶然。然而，不可否认的是，当它们射中预定目标时，便能完成其使命。",shape=box,color=blue];
		2784 -> 2794;
	2785 [label="我坐在这里，想象着你用刀叉或椅子腿刺杀某人，用窗帘的系带夺走某人的生命。",shape=box,color=blue];
		2785 -> 2795;
	2786 [label="猎人之道。看似简单，实则精妙。有时，最简单、最古老的方法，其本质才是最有效的。",shape=box,color=blue];
		2786 -> 2796;
	2787 [label="对我来说，这有点冷冰冰的，缺乏人情味，但我不能就效率问题来评判它。这份平静自有其可取之处。",shape=box,color=blue];
		2787 -> 2797;
	2788 [label="那个阴险的药剂师？他是不是在调制酊剂，然后把药瓶里的药水倒入毫无戒心的人的杯子里？或者在刀和子弹里掺入毒液，让战场上哪怕最轻微的擦伤都变成致命一击？",shape=box,color=blue];
		2788 -> 2798;
	2789 [label="嗯，小心点。别让我太兴奋，篡位者。多么诱人啊，想象一下，某天夜里醒来，你潜伏在阴影里，匕首已就位，随时准备出手……",shape=box,color=blue];
		2789 -> 2799;
	2790 [label="Chat ends.",color=orange];
	2791 [label="+10 Chemistry",color=orange];
		2791 -> 2800;
	2792 [label="一切都如此静谧，值得细细品味。搭箭、拉弓、等待释放……然后，当箭矢命中目标，带来甜蜜的死亡？",shape=box,color=blue];
		2792 -> 2801;
	2793 [label="我欣赏这种亲力亲为的渴望。看着受害者的四肢在你终结他们生命时逐渐消散。看着他们毫无生气的躯体在你面前瘫倒。知道这一切都是你亲手完成的，而不是别人。",shape=box,color=blue];
		2793 -> 2802;
	2794 [label="混乱、大声、价格极其昂贵。但杀伤力却非常非常强。",shape=box,color=blue];
		2794 -> 2803;
	2795 [label="+10 Chemistry",color=orange];
		2795 -> 2804;
	2796 [label="一切都如此静谧，值得细细品味。搭箭、拉弓、等待释放……然后，当箭矢命中目标，带来甜蜜的死亡？",shape=box,color=blue];
		2796 -> 2805;
	2797 [label="在看似永无止境的战场喧嚣中，狙击手必须像潮汐般找到呼吸的节奏。吸气，呼气，然后夺走一条生命。",shape=box,color=blue];
		2797 -> 2806;
	2798 [label="我曾亲眼目睹，仅仅一个士兵手臂上的一个小伤口，就导致整个营的士兵化为灰烬。一种毒素从血液扩散到肺部，再扩散到另一个人的肺部，足以摧毁一个国家。",shape=box,color=blue];
		2798 -> 2807;
	2799 [label="我欣赏这种对亲自动手的渴望。凝视着另一个人的眼睛，看着它们变得空洞黯淡，随着光线渐暗，身体的温度也随之消逝。",shape=box,color=blue];
		2799 -> 2808;
	2800 [label="我……无法决定这究竟是让你更可怕还是更不可怕，篡位者。我想我还是倾向于认为你更可怕。无论如何，我觉得这本身就很有趣，也很引人注目。",shape=box,color=blue];
		2800 -> 2809;
	2801 [label="+10 Chemistry",color=orange];
		2801 -> 2810;
	2802 [label="+10 Chemistry",color=orange];
		2802 -> 2811;
	2803 [label="+10 Chemistry",color=orange];
		2803 -> 2812;
	2804 [label="我……无法决定这究竟是让你更可怕还是更不可怕，篡位者。我想我还是倾向于认为你更可怕。无论如何，我觉得这本身就很有趣，也很引人注目。",shape=box,color=blue];
