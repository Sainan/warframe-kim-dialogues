	2809 [label="Update boolean RoatheWeaponImprov",color=orange];
		2809 -> 2818;
		2809 -> 2819;
		2809 -> 2820;
	2810 [label="真美。",shape=box,color=blue];
		2810 -> 2821;
	2811 [label="这一刻多么美好。",shape=box,color=blue];
		2811 -> 2822;
	2812 [label="它有一种独特的美感。",shape=box,color=blue];
		2812 -> 2823;
	2813 [label="Update boolean RoatheWeaponImprov",color=orange];
		2813 -> 2818;
		2813 -> 2819;
		2813 -> 2820;
	2814 [label="真美。",shape=box,color=blue];
		2814 -> 2824;
	2815 [label="其中蕴含着美。",shape=box,color=blue];
		2815 -> 2825;
	2816 [label="如此大规模的死亡？其中也蕴含着美。",shape=box,color=blue];
		2816 -> 2826;
	2817 [label="这一刻多么美好。",shape=box,color=blue];
		2817 -> 2827;
	2818 [label="你这话说的好像这是某种……艺术形式似的。",shape=box,color=red];
		2818 -> 2828;
	2819 [label="罗瑟，我不喜欢杀人。 ",shape=box,color=red];
		2819 -> 2829;
	2820 [label="你最喜欢哪个？",shape=box,color=red];
		2820 -> 2830;
	2821 [label="Update boolean RoatheWeaponBow",color=orange];
		2821 -> 2818;
		2821 -> 2819;
		2821 -> 2820;
	2822 [label="Update boolean RoatheWeaponDagger",color=orange];
		2822 -> 2818;
		2822 -> 2819;
		2822 -> 2820;
	2823 [label="Update boolean RoatheWeaponSniper",color=orange];
		2823 -> 2818;
		2823 -> 2819;
		2823 -> 2820;
	2824 [label="Update boolean RoatheWeaponBow",color=orange];
		2824 -> 2818;
		2824 -> 2819;
		2824 -> 2820;
	2825 [label="Update boolean RoatheWeaponSniper",color=orange];
		2825 -> 2818;
		2825 -> 2819;
		2825 -> 2820;
	2826 [label="Update boolean RoatheWeaponPoison",color=orange];
		2826 -> 2818;
		2826 -> 2819;
		2826 -> 2820;
	2827 [label="Update boolean RoatheWeaponDagger",color=orange];
		2827 -> 2818;
		2827 -> 2819;
		2827 -> 2820;
	2828 [label="因为这就是艺术。而且你也心知肚明。实际上，你存在的另一半，从字面上讲，都是建立在将杀戮视为一种艺术形式这一概念之上的！",shape=box,color=blue];
		2828 -> 2831;
	2829 [label="哦？真的吗？让我们花点时间来仔细分析一下。",shape=box,color=blue];
		2829 -> 2832;
	2830 [label="已经变了。这让我非常困扰。",shape=box,color=blue];
		2830 -> 2833;
		2830 -> 2834;
	2831 [label="我​见​过​ Tenno ​使用​的​那些​“学派”，​而​你​只​是​间接​地​借用​了​它们。​更别​提禁​卫​的​教导​了。​无论​我们​告诉​他们​多​少​次​这​是​禁播​频道，​他们​都​会​没​完没​了​地​在​通讯​频道里​说​个​不​停。​",shape=box,color=blue];
		2831 -> 2835;
	2832 [label="告诉我一些事情，请务必诚实回答。因为此时此刻说谎对我们双方都没有好处，尤其对你自身而言更是如此：",shape=box,color=blue];
		2832 -> 2836;
	2833 [label="变了，怎么会？",shape=box,color=red];
		2833 -> 2837;
	2834 [label="因为 Uriel？",shape=box,color=red];
		2834 -> 2838;
	2835 [label="如果我再也不用听他们对我说“我是一把刀”和“我存在的意义就是出击”，那么我死而无憾了，篡位者。",shape=box,color=blue];
		2835 -> 2839;
	2836 [label="你是否曾经想过为自己打造一件符合个人喜好的武器或战甲？比如，为其涂装独一无二的图案，或者选择一种更符合你心情的外观？",shape=box,color=blue];
		2836 -> 2840;
		2836 -> 2842;
		2836 -> 2841;
	2837 [label="我过去最喜欢用剑。优雅，迅捷。我可以穿梭于战场，在触手可及的范围内斩杀敌人。鲜红的剑刃闪耀在银光之中，如同蓝色的星辰。",shape=box,color=blue];
		2837 -> 2843;
	2838 [label="我想应该是这样。或许是因为我缺失了一些记忆。我不知道还有什么其他原因。",shape=box,color=blue];
		2838 -> 2837;
	2839 [label="人类历来视“谋杀”为罪恶，却视“杀戮”为艺术。你难道从未觉得这很奇怪吗？挥舞利刃，在战斗中击败敌人，被视为近乎超凡脱俗的存在。",shape=box,color=blue];
		2839 -> 2844;
	2840 [label=" 我有……这跟这件事有什么关系？",shape=box,color=red];
		2840 -> 2845;
	2842 [label="没有，从来没有。",shape=box,color=red];
		2842 -> 2847;
	2841 [label="我不想跟你玩这个。[结束]",shape=box,color=red];
		2841 -> 2846;
	2843 [label="但现在呢？现在我只想尝尝牙齿上的血腥味，感受鲜血在利爪下喷涌而出。我只想把手指深深插入血肉和骨骼，将它们撕成碎片。",shape=box,color=blue];
		2843 -> 2848;
	2844 [label="在小巷里用磨尖的金属片杀人，是懦夫和堕落的行为。 ",shape=box,color=blue];
		2844 -> 2849;
	2845 [label="我很欣赏你的坦诚。当然，我不会否认你很可能并不享受冷血的谋杀，杀害无辜生命也不是你会感到愉悦的事情（尽管也许之前的说法是谎言，而你真的享受，如果能揭穿这一点该是多么令人兴奋啊，但这并非我们今天要讨论的重点）。",shape=box,color=blue];
		2845 -> 2850;
	2847 [label="请你花点时间好好想想。我亲眼看到你的那些 Tenno 朋友在这里横冲直撞，就像一群五彩斑斓的马戏团噩梦，就像野兽掉进了艺术家的颜料罐里。 ",shape=box,color=blue];
		2847 -> 2852;
	2846 [label="非常好。",shape=box,color=blue];
		2846 -> 2851;
	2848 [label="我想痛饮那鲜血，同时折断筋腱，感受身躯在我身下撕裂成血淋淋的碎片。像剥开甜美的果实一样，将它层层剥开，让骨髓流淌。",shape=box,color=blue];
		2848 -> 2853;
		2848 -> 2854;
	2849 [label="区别在哪儿？“荣誉”？谁来决定什么是荣誉，什么是不荣誉？是失败者？还是胜利者？或者仅仅是因为存在足够多的传统，才足以界定什么是荣誉，什么是不荣誉？",shape=box,color=blue];
		2849 -> 2857;
		2849 -> 2855;
		2849 -> 2856;
	2850 [label="但假设情况并非如此，你只是像你所说的那样因为“不得不”而杀人，那么请问，你为什么要花时间以个性化的方式装饰你的杀人武器呢？",shape=box,color=blue];
		2850 -> 2858;
	2852 [label="你从未感到过必须这样做吗？一次也没有？我向你保证，即使你承认这一点，我也不会因此而看不起你。",shape=box,color=blue];
		2852 -> 2859;
		2852 -> 2860;
	2851 [label="Chat ends.",color=orange];
	2853 [label="罗瑟？",shape=box,color=red];
		2853 -> 2861;
	2854 [label="这……对你来说不正常吗？",shape=box,color=red];
		2854 -> 2862;
	2857 [label="我明白你的意思。界限确实模糊不清。 ",shape=box,color=red];
		2857 -> 2865;
	2855 [label="一种需要练习和投入，另一种则纯粹是……残暴。",shape=box,color=red];
		2855 -> 2863;
	2856 [label="我不想继续这个话题。[结束]",shape=box,color=red];
		2856 -> 2864;
	2858 [label="为什么要在意自己在死亡战场上的形象？当然不是为了方便别人辨认你的尸体。你这副模样，谁也认不出来。不，因为如果你非要当杀人犯，我亲爱的篡位者，我敢打赌，你肯定想死得轰轰烈烈。",shape=box,color=blue];
		2858 -> 2866;
	2859 [label="没有。",shape=box,color=red];
		2859 -> 2846;
	2860 [label="好，我有。那又怎么了？",shape=box,color=red];
		2860 -> 2845;
	2861 [label="是的，我知道！我知道。但我不会做这些事，请注意。我也不会把周围的一切都烧成灰烬，尽管我很想这么做。",shape=box,color=blue];
		2861 -> 2867;
	2862 [label="不！绝对不！想到要把周围的一切都烧成灰烬，我就流口水，这也不正常！",shape=box,color=blue];
		2862 -> 2867;
	2865 [label="所有这些界限都是人为划定的。我们越早明白这一点，就能越快达成共识，比如哪些仗值得打、哪些仗不值得打。",shape=box,color=blue];
		2865 -> 2870;
	2863 [label="很好，我们就顺着这个思路推演下去。杀人练得足够多就能变得光荣？所以你的意思是，如果我像禁卫那样，只要把谋杀包装得足够隆重隆重，就能把它变成艺术？",shape=box,color=blue];
		2863 -> 2868;
	2864 [label="非常好。",shape=box,color=blue];
		2864 -> 2869;
	2866 [label="那如果这种行为不是享受，那又是什么呢？",shape=box,color=blue];
		2866 -> 2871;
	2867 [label="一定是 Uriel 的错。虽然我承认以前也有过类似的毁灭性和嗜血的想法，但远没有现在这么可怕。",shape=box,color=blue];
		2867 -> 2872;
	2870 [label="判断一次杀戮是否光荣，就好比判断死于火刑还是溺水更惨。两者都是极其痛苦的死法。",shape=box,color=blue];
		2870 -> 2874;
	2868 [label="现在我们正在游走在仪式和宗教的边缘。",shape=box,color=blue];
		2868 -> 2873;
	2869 [label="Chat ends.",color=orange];
	2871 [label="别误会！我不是在评判你。你已经尽力做到最好了！死神让你成为她在这场人生闹剧中的舞伴，你除了听从她的召唤，别无选择。",shape=box,color=blue];
		2871 -> 2875;
	2872 [label="当然，也远没有那么……末日味。",shape=box,color=blue];
		2872 -> 2876;
	2874 [label="反正​殊途同归，​何必斤​斤计较？​我们​还​有​更​重要​的​问题​需要​解决。​",shape=box,color=blue];
		2874 -> 2878;
	2873 [label="至少，用刀捅死这种简单直接的死法还比较真诚。它不带任何虔诚，也不张扬或矫揉造作。就这样结束。",shape=box,color=blue];
		2873 -> 2877;
	2875 [label="如果你放下武器，我不知道会有多少人会死在你身边。不，为什么不为自己的工作感到一丝自豪？为什么不享受一下这其中的乐趣？我问你，你还能选择什么？疯狂？遗忘？",shape=box,color=blue];
		2875 -> 2879;
	2876 [label="Chat ends.",color=orange];
	2878 [label="Chat ends.",color=orange];
	2877 [label="难道这其中就没有艺术性吗？",shape=box,color=blue];
		2877 -> 2880;
	2879 [label="我见过太多人走上这条路，最终落得个绞刑架的下场。不，我说，篡位者，随你便吧。因为生活终究会按照它它自己的意愿，把你塑造成现在的模样。",shape=box,color=blue];
		2879 -> 2881;
	2880 [label="Chat ends.",color=orange];
	2881 [label="Chat ends.",color=orange];
}