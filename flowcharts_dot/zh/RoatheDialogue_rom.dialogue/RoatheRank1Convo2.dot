digraph {
	"RoatheRank1Convo2 begins." [color=orange];
		"RoatheRank1Convo2 begins." -> j152584948;
	j152584948 [label="你难道不明白你所谓的“虚空无情之物”并不是真正的“神”吗？",shape=box,color=blue];
		j152584948 -> j3348403616;
		j152584948 -> j2413349558;
		j152584948 -> j2248365081;
	j3348403616 [label="他已经很接近是神了。",shape=box,color=red];
		j3348403616 -> j3553503648;
	j2413349558 [label="你凭什么这么肯定？",shape=box,color=red];
		j2413349558 -> j2265235214;
	j2248365081 [label="[结束。]",shape=box,color=red];
		j2248365081 -> "Chat ends.";
	j3553503648 [label="这个疯人院里和我交谈过的每个人都完全相信这个“墙中人”是个货真价实、滑稽可笑的神，一个真正的神。就连那两个狂热分子似乎也在考虑这个想法！",shape=box,color=blue];
		j3553503648 -> j1408112401;
		j3553503648 -> j2689853269;
		j3553503648 -> j845079175;
	j2265235214 [label="好吧，先不说任何对神或众神的信仰都来自白痴的残酷现实，这些人执迷不悟是因为：第一，当一个人走向死亡时面对灵魂最终结局的残酷恐惧，他们迫切地需要紧紧抓住一个毛绒玩具，",shape=box,color=blue];
		j2265235214 -> j94075994;
	"Chat ends." [color=orange];
	j1408112401 [label="你觉得他不真实吗？",shape=box,color=red];
		j1408112401 -> j4251185346;
	j2689853269 [label="如果你觉得他不是神，那你觉得他是什么？",shape=box,color=red];
		j2689853269 -> j1732309790;
	j845079175 [label="但你不这么觉得吗?",shape=box,color=red];
		j845079175 -> j202475118;
	j94075994 [label="第二，那种当你意识到并没有什么“更强大的力量”在我们前面安排我们的人生，因此我们只能为自己的行为负责时，所产生的焦虑，相关地，",shape=box,color=blue];
		j94075994 -> j2734037154;
	j4251185346 [label="等等，我说过这种话吗？别急着歪曲我的意思，哦，短暂的篡位者。我并没有否认虚空无情之物是“真实存在的”。我否认的是它是神。",shape=box,color=blue];
		j4251185346 -> j2791830248;
		j4251185346 -> j2623635975;
	j1732309790 [label="只需两个你理应熟知且能深刻理解的词语，我就能为你揭穿这个虚假神明的真面目：",shape=box,color=blue];
		j1732309790 -> j1803498860;
	j202475118 [label="绝不！首先，根本没有神，这种想法太荒谬了。其次，想想阿尔布雷希特竟然释放了一个虚空之神？就更可笑了！",shape=box,color=blue];
		j202475118 -> j1616711514;
	j2734037154 [label="第三，伴随着焦虑和恐惧而来的义愤，当所有这一切让你顿悟：并没有等候魔鬼的“地狱”，也没有守候天使的“天堂”。",shape=box,color=blue];
		j2734037154 -> j3998253560;
	j2791830248 [label="那东西比我遇到过的任何对手都更强大。",shape=box,color=red];
		j2791830248 -> j3540842028;
	j2623635975 [label="那你觉得他是什么呢？",shape=box,color=red];
		j2623635975 -> j1732309790;
	j1803498860 [label="概念成形。",shape=box,color=blue];
		j1803498860 -> j1529642400;
		j1803498860 -> j1248482236;
		j1803498860 -> j655678078;
	j1616711514 [label="虚空中空无一物。正因如此，它才被称为虚空！ ",shape=box,color=blue];
		j1616711514 -> j374881005;
		j1616711514 -> j3479619252;
	j3998253560 [label="我假设你并非那种沉溺于愤怒、恐惧或焦虑的狂热分子。在这个假设的基础上，我将继续阐述第二个论点，以揭穿“虚空无情之物”的神性：",shape=box,color=blue];
		j3998253560 -> j1803498860;
	j3540842028 [label="我什么时候否认过这一点？说真的，你们似乎都把自己卷入了一场毫无必要的歇斯底里和巨大的苦难之中。",shape=box,color=blue];
		j3540842028 -> j3514721329;
		j3540842028 -> j339534213;
	j1529642400 [label="虚空以及我们能利用它创造出来的东西既危险又强大——相信我，我深有体会。但它终究也有局限性。你真的以为它能够展现出这样的能力吗？能够创造完整的语言，拥有能够驱动飞船穿梭虚空的手指？",shape=box,color=red];
		j1529642400 -> j4130040900;
	j1248482236 [label="罗瑟，说实话……把这当成床底下的怪物确实很诱人。但我亲眼见过那东西，面对“面”地见过，实在无法理解这种东西怎么可能只是我们脑子里的产物。",shape=box,color=red];
		j1248482236 -> j3810409727;
	j655678078 [label="概念成形无法做到墙中人能做到的事。虽然英择谛可能显化了那东西——也对将它带到这里负责——但我认为他并不是那东西的最初来源。",shape=box,color=red];
		j655678078 -> j4163235294;
	j374881005 [label="不，我见过来自虚空的东西。天使。歌唱。鬼魂。",shape=box,color=red];
		j374881005 -> j15061212;
	j3479619252 [label="我...... ",shape=box,color=red];
		j3479619252 -> j15061212;
	j3514721329 [label="你说什么？",shape=box,color=red];
		j3514721329 -> j2862442622;
	j339534213 [label="等等。这怎么能怪我们呢？该怪阿尔布雷希特才对，是他放出来的。",shape=box,color=red];
		j339534213 -> j3512359855;
	j4130040900 [label="人类在发明创造各种新式苦难方面，真是五花八门，花样翻新，不是吗？你自己亲眼目睹了许多残酷暴行，我相信在咱们那群狂热分子的年代，没有人能想象到这些暴行竟会发生。",shape=box,color=blue];
		j4130040900 -> j4235711662;
	j3810409727 [label="啊，你离真相如此之近，却又如此轻易地否定它。你觉得相信它是自己脑海中的产物很“诱人”，因为这样更容易将其抛诸脑后？不，我认为面对自己创造的产物，远比面对神更危险。",shape=box,color=blue];
		j3810409727 -> j4082848820;
	j4163235294 [label="虽然我欣赏你的谦逊，但我挑战你对人类创造力的有限理解——尤其是如何创造出新的苦难形式这方面。难道你不是凭空捏造出你自己的宇宙吗？",shape=box,color=blue];
		j4163235294 -> j2680977746;
	j15061212 [label="虚空中唯一存在的，是我们放入其中的，以及从中返回的。它能改变物质和能量——但它无法创造它们。",shape=box,color=blue];
		j15061212 -> j180965728;
	j2862442622 [label="我​是​说：​没错，​阿尔布雷​希特​可能​是​第一​个​意识​到​自己​的​傲慢，​如同​一​张​狞笑​的​毁灭​之神​的​脸，​凝视​着​自己​的​人。​",shape=box,color=blue];
		j2862442622 -> j4247550145;
	j3512359855 [label="阿尔布雷希特或许正是最初目睹自己狂妄自大如毁灭之神般狞笑着凝视着他的人，没错。",shape=box,color=blue];
		j3512359855 -> j4247550145;
	j4235711662 [label="+15 Chemistry",color=orange];
		j4235711662 -> j1350717331;
	j4082848820 [label="一个外部敌人可以被理解，被操纵，被击败。甚至必要时，还可以去和他谈判。他们有可以利用的弱点。但一个内部敌人呢？我们自己造出来的敌人呢？那可就阴险得多了。",shape=box,color=blue];
		j4082848820 -> j4046802353;
	j2680977746 [label="你自己亲眼目睹了许多残酷暴行，我相信在咱们亲爱的狂热分子年代，没有人能想象到这些暴行竟会发生。 ",shape=box,color=blue];
		j2680977746 -> j2358110311;
	j180965728 [label="想想吧，漂泊者。你说的这些“虚空天使”，这些幽灵，它们是不是从那些已经迷失在虚空里的人转化而来？",shape=box,color=blue];
		j180965728 -> j1502640135;
	j4247550145 [label="可你们都难辞其咎，竟让这坨朱巴虫粪球一路从山坡往下滚了这么久，沿途每沾一丁点粪渣就越滚越大！",shape=box,color=blue];
		j4247550145 -> j4041947403;
	j1350717331 [label="作为一个物种，我们有一种惊人的能力，那就是不断给恐惧输送素材，从而让想象创造出比现实更糟的自我毁灭场景。",shape=box,color=blue];
		j1350717331 -> j1288363900;
	j4046802353 [label="+20 Chemistry",color=orange];
		j4046802353 -> j39151073;
	j2358110311 [label="+10 Chemistry",color=orange];
		j2358110311 -> j1350717331;
	j1502640135 [label="它们只不过是能量的回流，就像色彩斑斓的库塔克鸟通过反刍来喂养它的孩子们一样。",shape=box,color=blue];
		j1502640135 -> j4041947403;
	j4041947403 [label="让我用更简洁的方式解释一下。只需两个你理应熟知且能深刻理解的词语，我就能为你揭穿这个虚假神明的真面目：",shape=box,color=blue];
		j4041947403 -> j1803498860;
	j1288363900 [label="嗯。恐怕我得走了。正好让你有时间，可以好好想想我的话。",shape=box,color=blue];
		j1288363900 -> j346728943;
		j1288363900 -> j2411974238;
	j39151073 [label="因为那样我们就必须对抗自己的恶魔。而人类……从来都赢不了这样的战争，不是吗？",shape=box,color=blue];
		j39151073 -> j1288363900;
	j346728943 [label="我会的。谢谢。",shape=box,color=red];
		j346728943 -> j3819439049;
	j2411974238 [label="仔细想想我的观点，当你真的要面对一个反神的人时，你最终可能会想要相信它们。",shape=box,color=red];
		j2411974238 -> j3819439049;
	j3819439049 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j3819439049 -> "Chat ends.";
}