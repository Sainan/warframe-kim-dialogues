		j216863090 -> j2694130358 [label="RoatheNoDeal",color=purple];
		j216863090 -> j2694130358 [label="false",color=purple];
	j558093179 [label="你竟然和我合谋……来安排我的道路，这让我觉得无比着迷。恶魔也以己身为筹码，真是讽刺。",shape=box,color=blue];
		j558093179 -> j886882487;
	j3305429925 [label="我的篡位者，你那边进展如何？我一直在积极为你施展各种关系和手段，虽然我的影响力至今可能不为人知，也感觉不到。",shape=box,color=blue];
		j3305429925 -> j886882487;
	j1975577694 [label="告诉​我，​对于​我​的​提议，​你​已经​改变​主意​了。​以前，​我​或许会​成为​你​……恋爱​计划​中​的​一​道​阻碍？​现在，​我​会​像​雪​地​里​的​野兽​一样​温顺。​嗯，​除非​你​并不​想​要​这样。​这​由​你​来​决定。​",shape=box,color=blue];
		j1975577694 -> j3908234370;
	j927738151 [label="告诉我，对于我的提议，你已经改变主意了。我可以帮你解决玛丽的问题，确保你和她之间的恋爱关系进展顺利。",shape=box,color=blue];
		j927738151 -> j3908234370;
	j2716172542 [label="告诉我，对于我的提议，你已经改变主意了。我可以帮你解决里昂的问题，确保你和他之间的恋爱关系进展顺利。",shape=box,color=blue];
		j2716172542 -> j3908234370;
	j2248091742 [label="告诉我，对于我的提议，你已经改变主意了。之前我或许会成为你抗拒的障碍，比如我注射血清这件事？现在我会像雪地里的野兽一样温顺。",shape=box,color=blue];
		j2248091742 -> j3908234370;
	j3711672537 [label="告诉我，对于我的提议，你已经改变主意了。以前我或许会成为阻碍，让管家和他的家族团聚？现在我会像雪地里的野兽一样温顺。",shape=box,color=blue];
		j3711672537 -> j3908234370;
	j2975143431 [label="告诉我，对于我的提议，你已经改变主意了——我可以帮你解决玛丽的问题。确保你和她沟通起来得心应手。",shape=box,color=blue];
		j2975143431 -> j3908234370;
	j2715865663 [label="告诉我，对于我的提议，你已经改变主意了——我可以帮你解决里昂的问题。确保你和他沟通起来得心应手。",shape=box,color=blue];
		j2715865663 -> j3908234370;
	j2605793796 [label="篡位者，我不禁在想，你之所以一直参与我们的谈话，肯定是有原因的。或许我能帮上你的忙。",shape=box,color=blue];
		j2605793796 -> j2561047694;
	j2694130358 [label="Evaluate expressions on HellStory counter",color=orange];
		j2694130358 -> j3869625108 [label="x >= 21",color=purple];
		j2694130358 -> j2075111951 [label="x < 21",color=purple];
		j2694130358 -> j2075111951 [label="false",color=purple];
	j886882487 [label="从我的角度来看，这是一种奇怪的挑战，我只能带着不完整的记忆行动，而你却掌握着剩下那半副牌。",shape=box,color=blue];
		j886882487 -> j18406308;
	j3908234370 [label="但​你​这样​磨磨​蹭蹭​的​……​纯粹​是​在​浪费​时间。​所以，​别犹豫​了，​把​那​句​话​说​出来，​你​的​问题​就​解决​了。​",shape=box,color=blue];
		j3908234370 -> j313198367;
		j3908234370 -> j4217992006;
	j2561047694 [label="告诉我你的目的，然后我们达成一致。这样磨磨蹭蹭只会浪费时间。",shape=box,color=blue];
		j2561047694 -> j2953660143;
	j2075111951 [label="Evaluate expressions",color=orange];
		j2075111951 -> j4698777 [label="RoatheDeal",color=purple];
		j2075111951 -> j2102817205 [label="RoatheNoDeal",color=purple];
		j2075111951 -> j2102817205 [label="false",color=purple];
	j18406308 [label="既然也没什么更好的事可做，我就继续吧。“对了，我们那个会飘的小马屁精怎么样了？我猜神父还是没有和你说话吧” 呸。真是荒唐可笑。",shape=box,color=blue];
		j18406308 -> j507309808;
		j18406308 -> j1944908327;
		j18406308 -> j3601318829;
	j313198367 [label="不，抱歉。我不和奥罗金做任何交易。过去不做，现在不做，以后也不会做。",shape=box,color=red];
		j313198367 -> j3355258856;
	j4217992006 [label="罗瑟，我真希望你不会让我后悔。好吧，同意。我需要你的帮助。",shape=box,color=red];
		j4217992006 -> j1876832257;
	j2953660143 [label="Check boolean LoidFamilyComplete",color=orange];
