		j2953660143 -> j2295439602 [label=false,color=brown];
		j2953660143 -> j3674254333 [label=false,color=brown];
	j4698777 [label="你和我们那个会飘的小马屁精进展如何？我猜神父还是没有和你说话吧。",shape=box,color=blue];
		j4698777 -> j1208800526;
		j4698777 -> j2217863183;
		j4698777 -> j3577881381;
	j2102817205 [label="告诉我，对于我的提议，你已经改变主意了。篡位者，这是你最后的机会。我这人耐心十足，但我可不喜欢像个傻瓜一样被人闲着没事干，一直开着门。",shape=box,color=blue];
		j2102817205 -> j2091568587;
		j2102817205 -> j2942231147;
	j507309808 [label="至少到目前为止，我和玛丽相处得还不错。",shape=box,color=red];
		j507309808 -> j3169951410;
	j1944908327 [label="对，​但​他​会​想​通​的。​",shape=box,color=red];
		j1944908327 -> j3496331715;
	j3601318829 [label="你似乎不太喜欢他们。为什么？",shape=box,color=red];
		j3601318829 -> j1798636922;
	j3355258856 [label="如你所愿。不过我得提醒你，这是你最后的机会了。现在，一切都得靠你自己了。",shape=box,color=blue];
		j3355258856 -> j4290174647;
	j1876832257 [label="Evaluate expressions",color=orange];
		j1876832257 -> j4040334296 [label="RoatheDatingDealNo",color=purple];
		j1876832257 -> j2649611303 [label="RoatheMarieDatingDealNo",color=purple];
		j1876832257 -> j3202141974 [label="RoatheLyonDatingDealNo",color=purple];
		j1876832257 -> j3686822968 [label="RoatheSerumDealNo",color=purple];
		j1876832257 -> j887832338 [label="RoatheFamilyDealNo",color=purple];
		j1876832257 -> j3594507908 [label="RoatheMarieEntratiDealNo",color=purple];
		j1876832257 -> j1778826642 [label="RoatheLyonConfessionDealNo",color=purple];
		j1876832257 -> j3305664873 [label="false",color=purple];
	j2148972281 [label="里昂他……要处理的事情太多了。我不知道该怎么帮他度过这一切。",shape=box,color=red];
		j2148972281 -> j1780842578;
	j3522660989 [label="玛丽就是看不清英择谛的真面目。无论我做什么，都无法让她明白真相。",shape=box,color=red];
		j3522660989 -> j1291393198;
	j3887610590 [label="那个，你看，你之前说你有注射那血清的……理由，而我……只是恰好在不该说的时候，说了不该说的话。",shape=box,color=red];
		j3887610590 -> j3014786452;
	j2295439602 [label="虽然说出来有点尴尬，但是……我对你们三个中的一个有好感。",shape=box,color=red];
		j2295439602 -> j702325155;
		j2295439602 -> j51216485;
		j2295439602 -> j1992660239;
	j3674254333 [label="我想让你们帮帮我，让洛德和楼上的家族团聚，可是……我……做不到……",shape=box,color=red];
		j3674254333 -> j1698570480;
	j1208800526 [label="对，里昂……似乎不太爱说话。",shape=box,color=red];
		j1208800526 -> j2736303337;
	j2217863183 [label="我和玛丽相处得很好。你为什么说她是马屁精？",shape=box,color=red];
		j2217863183 -> j2022192921;
	j3577881381 [label="你似乎不太喜欢他们。为什么？",shape=box,color=red];
		j3577881381 -> j3503058617;
	j2091568587 [label="不，抱歉。我不和奥罗金做任何交易。过去不做，现在不做，以后也不会做。",shape=box,color=red];
		j2091568587 -> j1644622802;
	j2942231147 [label="罗瑟，我真希望你不会让我后悔。好吧，同意。",shape=box,color=red];
		j2942231147 -> j1324444501;
	j3169951410 [label="“至少到目前为止”。真耐人寻味。难道我们真的都在原地踏步，就像朝臣们重复着舞步一样？一遍又一遍，注定要​自​我​重复？",shape=box,color=blue];
		j3169951410 -> j1363418222;
		j3169951410 -> j804168704;
	j3496331715 [label="我想你应该知道吧？真有意思，一切都这么容易预料。很高兴知道，即使像他这样心力交瘁的人，偶尔还是能让人放心的。",shape=box,color=blue];
		j3496331715 -> j3390446022;
	j1798636922 [label="你难道还不知道吗？嗯。或许你还没了解得那么深。或者，在这段小小的循环中，不管是重复一遍还是两万遍，你都没想过去问。",shape=box,color=blue];
		j1798636922 -> j3390446022;
	j4290174647 [label="哦，还有一件事，我差点忘了。",shape=box,color=blue];
		j4290174647 -> j698047340;
	j4040334296 [label="你竟然真的将灵魂出卖给恶魔，而且还出卖了两次……精心算计就为了确保我会将你带上我的床？还是说，篡位者，你想要的是我的心？嗯，我们拭目以待。以后总会知道的。",shape=box,color=blue];
		j4040334296 -> j2541409476;
	j2649611303 [label="篡位者，等时机成熟，我定会为你扫清障碍，好去让你追求我们那个漂在空中的小马屁精。就当这件事已经办妥了。",shape=box,color=blue];
		j2649611303 -> j2541409476;
	j3202141974 [label="篡位者，等时机成熟，我定会为你扫清障碍，好去让你追求我们那个可怜兮兮、心灰意冷的神父。就当这件事已经办妥了。",shape=box,color=blue];
		j3202141974 -> j302998222;
	j3686822968 [label="时机成熟时，我会记住这一点。如果我们以后再对我的记忆产生分歧，我们绝不会重蹈覆辙。",shape=box,color=blue];
		j3686822968 -> j1604888609;
	j887832338 [label="等时机成熟，我定会确保那小管家走上那几级台阶。就当这件事已经办妥了。",shape=box,color=blue];
		j887832338 -> j2541409476;
	j3594507908 [label="就当你对玛丽以及她对英择谛的谄媚崇拜的问题已经办妥了。等时机成熟，我会亲自处理。",shape=box,color=blue];
		j3594507908 -> j2365300068;
	j1778826642 [label="篡位者，就当你与里昂及其恐惧之间的问题已经办妥了。时机成熟时，我会亲自处理。",shape=box,color=blue];
		j1778826642 -> j2718448495;
	j3305664873 [label="我……好像忘了你想要什么。都怪你篡改了我的记忆。到底是什么来着？",shape=box,color=blue];
		j3305664873 -> j2953660143;
	j1780842578 [label="我本想建议你耐心等待，但是……既然旁边就有激光切割器，我又怎么会建议你用凿子呢？",shape=box,color=blue];
		j1780842578 -> j4292466619;
	j1291393198 [label="嗯，我明白了。说实话，这的确是一件高尚的事。我自己也尝试过很多很多次，但都以失败告终。",shape=box,color=blue];
		j1291393198 -> j3385724212;
	j3014786452 [label="嗯。",shape=box,color=blue];
		j3014786452 -> j317055309;
	j702325155 [label="里昂。",shape=box,color=red];
		j702325155 -> j3541749476;
	j51216485 [label="……你。",shape=box,color=red];
		j51216485 -> j2849018888;
	j1992660239 [label="玛丽。",shape=box,color=red];
		j1992660239 -> j3651689264;
	j1698570480 [label="嗯，我明白了。我给你开出了条件，但你却没能履行承诺，所以眼睁睁地看着你的奖赏从眼前消失。",shape=box,color=blue];
		j1698570480 -> j621397115;
	j2736303337 [label="他说话的话通常分两种——要么极其愚蠢，要么极其疯狂。",shape=box,color=blue];
		j2736303337 -> j3563101005;
	j2022192921 [label="嗯？你到现在还没被波及到吗？我真是太羡慕你了。不过，你很快也会被卷入冲击范围，所以最好提前做好心理准备。",shape=box,color=blue];
		j2022192921 -> j3516812552;
	j3503058617 [label="我可怜的漂泊者。你难道忘了我们奥罗金人是如何彻底摒弃一切神圣神祇的吗？我们唯一崇拜的只有我们自己。",shape=box,color=blue];
		j3503058617 -> j2753763751;
	j1644622802 [label="如你所愿。但我警告你，你的这个决定无法逆转，而且后果不堪设想。",shape=box,color=blue];
		j1644622802 -> j2470675349;
	j1324444501 [label="你乖乖听话，帮我劝洛德上楼去和家族和解，我就帮你整理记忆。",shape=box,color=red];
		j1324444501 -> j2347456338;
	j1363418222 [label="这并不意味着你缺乏自主性，只是意味着有些事情需要多尝试几次。",shape=box,color=red];
		j1363418222 -> j4133079152;
	j804168704 [label="希望这不会让你不高兴。",shape=box,color=red];
		j804168704 -> j1641613525;
	j3390446022 [label="​难道我们就​像​朝臣们​重复​着​舞步​一样？​一​遍​又​一遍，​注定​要​自​我​重复？​",shape=box,color=blue];
		j3390446022 -> j1363418222;
		j3390446022 -> j804168704;
	j698047340 [label="不久前，我向你坦白了一个可怕的真相。如今，我却想不起为什么了。",shape=box,color=blue];
		j698047340 -> j1727381592;
	j2541409476 [label="Boolean RoatheFamilyDealNo is now false.",color=orange];
		j2541409476 -> j2770620044;
	j302998222 [label="Boolean RoatheLyonDatingDealNo is now false.",color=orange];
		j302998222 -> j4121453686;
	j1604888609 [label="Boolean RoatheSerumDealNo is now false.",color=orange];
		j1604888609 -> j2200488173;
	j2365300068 [label="Boolean RoatheMarieEntratiDealNo is now false.",color=orange];
		j2365300068 -> j576168096;
	j2718448495 [label="Boolean RoatheLyonConfessionDealNo is now false.",color=orange];
		j2718448495 -> j486525639;
	j4292466619 [label="我想我渐渐明白你为什么要抹去我们的记忆了。看到你所有失败的尝试和努力……为什么不重头再来呢？",shape=box,color=blue];
		j4292466619 -> j3354251604;
	j3385724212 [label="你沮丧地发现你再也无法让她相信事情的真相，于是你诉诸于唯一可行的办法——利用你的这份……天赋。",shape=box,color=blue];
		j3385724212 -> j2025429531;
	j317055309 [label="漂泊者，我不赞同你为了弥补自己的错误而扰乱我的心智。但是，你这么做是为了我……我想，某种程度上来说，这也可以接受。",shape=box,color=blue];
		j317055309 -> j893910723;
	j3541749476 [label="Boolean DrifterLyon is now true.",color=orange];
		j3541749476 -> j3094219795;
	j2849018888 [label="Boolean DrifterRoathe is now true.",color=orange];
		j2849018888 -> j2289849673;
	j3651689264 [label="Boolean DrifterMarie is now true.",color=orange];
		j3651689264 -> j1951382656;
	j621397115 [label="所以，当你知道自己再也无法做到以前能做到的事，你就转而利用你所拥有的……天赋。",shape=box,color=blue];
		j621397115 -> j2284970607;
	j3563101005 [label="总是像抛硬币一样，看你最终会得到哪一个，我永远也无法决定我更喜欢哪一个。",shape=box,color=blue];
		j3563101005 -> j545600044;
	j3516812552 [label="那个女人对阿尔布雷希特的忠诚和痴迷简直没完没了。我觉得管家应该担心，但我真心相信这是一种纯粹的爱。这话可是我说的。",shape=box,color=blue];
		j3516812552 -> j2898238255;
	j2753763751 [label="这两个狂热分子每分每秒都离不开“太阳神”这个“月神”那个，连尿壶都要祝福一下。",shape=box,color=blue];
		j2753763751 -> j71544986;
	j2470675349 [label="Boolean RoatheFamilyFail is now true.",color=orange];
		j2470675349 -> j695887015;
	j2347456338 [label="+5 Chemistry",color=orange];
		j2347456338 -> j3050200434;
	j4133079152 [label="你的乐观真是让我哭笑不得。英雄。我发誓，你们这些人不过是些空洞的血肉之躯，靠着乐观和希望活着。真是让人笑得牙疼。",shape=box,color=blue];
		j4133079152 -> j3541932656;
	j1641613525 [label="不，你误会我的意思了。某种程度上，我觉得这很令人欣慰。这意味着，即使你把我们剥离到最基本的组成部分，我们依然是原来的我们。我们无法改变。",shape=box,color=blue];
		j1641613525 -> j2631304166;
	j1727381592 [label="你们俩也许是我唯一想要信任的灵魂……也是我现在想不起来当初为什么敢于信任你们的原因。",shape=box,color=blue];
		j1727381592 -> j1446654287;
	j2770620044 [label="Boolean RoatheFamilyDeal is now true.",color=orange];
