	j893933041 [label="漂泊者，我需要知道我失去了什么。我需要知道阿尔布雷希特强迫我注射这种血清时，他从我身上夺走了什么。",shape=box,color=blue];
		j893933041 -> j1953388891;
		j893933041 -> j4211465753;
	j293259423 [label="我需要知道阿尔布雷希特强迫我注射这种血清时，他从我身上夺走了什么。漂泊者，我需要知道我的脑子里究竟封存着什么。当然，前提是你有时间的话……",shape=box,color=blue];
		j293259423 -> j1932936542;
		j293259423 -> j2812577799;
	j3462060459 [label="你是我唯一想要信任的灵魂……也是我现在想不起来当初为什么敢于信任你的原因。",shape=box,color=blue];
		j3462060459 -> j1446654287;
	j537240823 [label="漂泊者，我为什么会生气？",shape=box,color=blue];
		j537240823 -> j437449028;
		j537240823 -> j398037624;
		j537240823 -> j76751296;
	j3428717072 [label="“篡改了我的记忆。”就好像我是一个被当成玩物摆弄的阿耶檀识塑像一样。你做的远不止篡改我的记忆，你是把它彻底抹去了。",shape=box,color=blue];
		j3428717072 -> j59705250;
		j3428717072 -> j1725359285;
	j1039741645 [label="原来是真的。你会偷偷溜到高卢去偷巧克力？看起来像……？",shape=box,color=red];
		j1039741645 -> j735326918;
	j243026218 [label="你是怎么弄到它们的？",shape=box,color=red];
		j243026218 -> j4132483558;
	j3008878103 [label="哈哈！好样的。那座偏僻鬼地方唯一的好处就是巧克力了。",shape=box,color=blue];
		j3008878103 -> j2824238423;
	j1953388891 [label="我保证。",shape=box,color=red];
		j1953388891 -> j2336865182;
	j4211465753 [label="我们会找到真相的。但这需要时间。",shape=box,color=red];
		j4211465753 -> j1953545830;
	j1932936542 [label="我会做到的。",shape=box,color=red];
		j1932936542 -> j2942434328;
	j2812577799 [label="我已经在努力了，但你一直把事情变复杂。",shape=box,color=red];
		j2812577799 -> j237982197;
	j437449028 [label="你说你并不气我抹去了你的记忆，但我知道你在撒谎。因为……这已经不是我第一次这么做了。",shape=box,color=red];
		j437449028 -> j816475876;
	j398037624 [label="因为你痛恨自己竟然自愿注射了那种血清。你恨自己，这种恨意让你怒火中烧——因为你只剩下你自己了。",shape=box,color=red];
		j398037624 -> j1447724366;
	j76751296 [label="你说你并不气我抹去了你的记忆，但我无法想象，你怎么可能不愤怒。",shape=box,color=red];
		j76751296 -> j1447724366;
	j59705250 [label="你并没有失去任何值得保留的记忆，只是失去了我们的对话。",shape=box,color=red];
		j59705250 -> j931882210;
	j1725359285 [label="但并非所有——只是抹去了我们在此刻进行的对话。你其他所有记忆都还在，甚至包括我们在沉沦之地中恢复的那些。",shape=box,color=red];
		j1725359285 -> j931882210;
	j735326918 [label="没错，连蓝色的皮肤、尾巴、被感染的血肉全都在。一件斗篷、一顶帽子和一个面具就能糊弄过去了，真是不可思议。",shape=box,color=blue];
		j735326918 -> j1979043337;
	j4132483558 [label="这很容易。再说，作为一个“原型战甲”和身经百战的奥罗金精英，我觉得我完全有能力不引起当局的注意从市场上顺手拿些糕点。",shape=box,color=blue];
		j4132483558 -> j3175565415;
	j2824238423 [label="在你问之前，我得说，这个故事最好由玛丽来讲述，免得那些狂热分子又对我大喊大叫、咆哮不休。",shape=box,color=blue];
		j2824238423 -> j2615987806;
	j2336865182 [label="向恶魔保证……是一件危险的事。",shape=box,color=blue];
		j2336865182 -> j3866645924;
	j1953545830 [label="而我正好是耐心的恶魔。",shape=box,color=blue];
		j1953545830 -> j3866645924;
	j2942434328 [label="你最好做到。",shape=box,color=blue];
		j2942434328 -> j3866645924;
	j237982197 [label="那当然了！不然还有什么乐趣可言？",shape=box,color=blue];
		j237982197 -> j3866645924;
	j816475876 [label="真是太有趣了！我一点也不觉得意外！至于这是真是假，我又何必在意呢？！而且——",shape=box,color=blue];
		j816475876 -> j1447724366;
	j1447724366 [label="错！错得离谱，错得不能再错，错得近乎极致！别跟我装作你了解那种愤怒，我觉得你根本就无法理解。",shape=box,color=blue];
		j1447724366 -> j2816012501;
	j931882210 [label="漂泊者，你竟敢对我指手画脚，告诉我什么有价值什么没价值。这并非你的私有物，你无权据为己有。",shape=box,color=blue];
		j931882210 -> j2816012501;
	j1979043337 [label="人类总是轻易地将他们不想见到的人拒之门外。再说，作为一个“原型战甲”和身经百战的奥罗金精英，我觉得我完全有能力不引起当局的注意从市场上顺手拿些糕点。",shape=box,color=blue];
		j1979043337 -> j4202875018;
	j3175565415 [label="没错，连蓝色的皮肤、尾巴、被感染的血肉全都在。一件斗篷、一顶帽子和一个面具就能糊弄过去了，真是不可思议。",shape=box,color=blue];
		j3175565415 -> j4202875018;
	j2615987806 [label="他们对我大喊大叫，已经指责过我犯了罪，需要好好忏悔，不用再把“我又一次撒谎编造故事”也算进去。",shape=box,color=blue];
		j2615987806 -> j3302424192;
		j2615987806 -> j2898915167;
		j2615987806 -> j2620030655;
		j2615987806 -> j110387474;
	j4202875018 [label="Boolean RoatheMariePastry1 is now true.",color=orange];
		j4202875018 -> j3568544017;
		j4202875018 -> j4216167518;
	j3568544017 [label="但你带回来的东西够玛丽和里昂吃吗？",shape=box,color=red];
		j3568544017 -> j1538717029;
	j4216167518 [label="所以你就偷了那些糕点。",shape=box,color=red];
		j4216167518 -> j3833479103;
	j1538717029 [label="啊。你以为我会怎样？只拿走自己需要的量，不留给他们？就因为我不喜欢和他们待在一起，想摆脱他们吗？",shape=box,color=blue];
		j1538717029 -> j4174389649;
	j3833479103 [label="那颗星球上的一切很快都将属于奥罗金帝国。反正按理说，那本来就是我的。",shape=box,color=blue];
		j3833479103 -> j3662063798;
	j4174389649 [label="你认为我厌恶他们就必然意味着我要残忍对待他们。因为你是恶魔，所以才会做出这种事，这就是你接下来的逻辑。",shape=box,color=blue];
		j4174389649 -> j2468341991;
	j3662063798 [label="再说，我身无分文。你指望我能怎么办？",shape=box,color=blue];
		j3662063798 -> j925156132;
	j2468341991 [label="真是令人失望透顶。这种肤浅的行为只有极其无趣的人和校园恶霸才会做。 ",shape=box,color=blue];
		j2468341991 -> j1748876301;
	j925156132 [label="我还知道你横冲直撞地闯入飞船，夺取你需要或想要的一切——篡位者，不要用你那无辜的眼神对我眨眼。",shape=box,color=blue];
		j925156132 -> j1529396093;
		j925156132 -> j701469369;
	j1748876301 [label="我讨厌他们。但我不得不和他们共存。我不希望他们连一块小小的糕点都吃不到。它只是一块糕点而已。何必让事情变得更糟呢？",shape=box,color=blue];
		j1748876301 -> j1753682254;
		j1748876301 -> j3431839994;
		j1748876301 -> j2271536445;
	j1529396093 [label="算了。",shape=box,color=red];
		j1529396093 -> j504307419;
	j701469369 [label="你说的有道理。",shape=box,color=red];
		j701469369 -> j1647456761;
	j1753682254 [label="或者，你也可以出于善意而善待他们。",shape=box,color=red];
		j1753682254 -> j1597599181;
	j3431839994 [label="所以也就是——你对他们友好，是因为你讨厌他们。",shape=box,color=red];
		j3431839994 -> j2288959089;
	j2271536445 [label="我从来没有从这种角度想过。",shape=box,color=red];
		j2271536445 -> j2150122265;
	j504307419 [label="真是棒极了。又一个死不认输的人。好像那些狂热分子还不够似的，整天对我大喊大叫，求我忏悔。",shape=box,color=blue];
		j504307419 -> j3302424192;
		j504307419 -> j2898915167;
		j504307419 -> j2620030655;
		j504307419 -> j110387474;
	j1647456761 [label="+5 Chemistry",color=orange];
		j1647456761 -> j1085318446;
	j1597599181 [label="行，那你试试让他们日夜不停地在你耳边嗡嗡叫，诅咒你的名字，哭喊着让你忏悔。",shape=box,color=blue];
		j1597599181 -> j3302424192;
		j1597599181 -> j2898915167;
		j1597599181 -> j2620030655;
		j1597599181 -> j110387474;
	j2288959089 [label="正是如此。这有什么难理解的？篡位者，我知道你是在讽刺我。不过别担心，我觉得挺有意思的。",shape=box,color=blue];
		j2288959089 -> j303973121;
	j2150122265 [label="+5 Chemistry",color=orange];
		j2150122265 -> j3573663892;
	j1085318446 [label="谢谢。终于有人能承认自己该让步了！要是那两个狂热分子也能这样就好了，他们就不会整天对我大喊大叫，求我忏悔了。",shape=box,color=blue];
		j1085318446 -> j3302424192;
		j1085318446 -> j2898915167;
		j1085318446 -> j2620030655;
		j1085318446 -> j110387474;
	j303973121 [label="至少比狂热分子没完没了的腐臭说教要好——他们不断地骂我，喊着要我悔改。",shape=box,color=blue];
		j303973121 -> j3302424192;
		j303973121 -> j2898915167;
		j303973121 -> j2620030655;
		j303973121 -> j110387474;
	j3573663892 [label="不客气。能遇到一个愿意改变观点的人真是太好了。要是那两个狂热分子也能这样就好了，他们就不会整天对我大喊大叫，求我忏悔了。",shape=box,color=blue];
		j3573663892 -> j3302424192;
		j3573663892 -> j2898915167;
		j3573663892 -> j2620030655;
		j3573663892 -> j110387474;
}