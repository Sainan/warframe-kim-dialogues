	2210 [label="语音留言：统领",shape=box,color=blue];
		2210 -> 2208;
	2209 [label="Chat ends.",color=orange];
	2208 [label="文字记录：我现在想起来了。一群群欢笑的奥罗金青年。",shape=box,color=blue];
		2208 -> 2212;
	2212 [label="身着尚未被玷污的、象征着统治者的贵族服饰。",shape=box,color=blue];
		2212 -> 2205;
	2205 [label="儿时的朋友如今统领着成群的禁卫、Grineer，他们是无质细胞、自我复制的致癌体、原始的生物无人机刃蛛、低科技士兵罐。",shape=box,color=blue];
		2205 -> 2213;
	2213 [label="一群黄金天子骄子，身边簇拥着一群如狼似虎的恶徒。",shape=box,color=blue];
		2213 -> 2215;
	2215 [label="他们的傲慢如同刺痛的汗水，渗入我的脑海。他们饮酒歌唱，吹嘘着未来的辉煌。",shape=box,color=blue];
		2215 -> 5696;
	5696 [label="炫耀他们终将扬名立万。要让他们的家族荣耀加身。",shape=box,color=blue];
		5696 -> 5697;
	5697 [label="但他们中的许多人都牺牲了。甚至连遗体都没能找回。",shape=box,color=blue];
		5697 -> 5698;
	5698 [label="为了防止敌人窃取我们的机密，他们都被会被赤毒震击，这样他们死后会化为液体。",shape=box,color=blue];
		5698 -> 5699;
	5699 [label="一代人的希望化作一滩油腻的水坑，被 Grineer 的靴子踩踏殆尽。",shape=box,color=blue];
		5699 -> 2211;
	2211 [label="Add 1 to HellStory",color=orange];
		2211 -> 2336;
	2336 [label="{\"Id\":2336,\"Incoming\":[2211],\"Outgoing\":[2207],\"GraphPos\":[5512,-8267],\"CompletionType\":1}",color=orange];
		2336 -> 2207;
