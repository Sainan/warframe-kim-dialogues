	"Chat ends." [color=orange];
	j3930795726 [label="语音留言：统领",shape=box,color=blue];
		j3930795726 -> j960216475;
	j960216475 [label="文字记录：我现在想起来了。一群群欢笑的奥罗金青年。",shape=box,color=blue];
		j960216475 -> j1898688663;
	j1898688663 [label="身着尚未被玷污的、象征着统治者的贵族服饰。",shape=box,color=blue];
		j1898688663 -> j1145997957;
	j1145997957 [label="儿时的朋友如今统领着成群的禁卫、Grineer，他们是无质细胞、自我复制的致癌体、原始的生物无人机刃蛛、低科技士兵罐。",shape=box,color=blue];
		j1145997957 -> j2379853309;
	j2379853309 [label="一群黄金天子骄子，身边簇拥着一群如狼似虎的恶徒。",shape=box,color=blue];
		j2379853309 -> j1976292301;
	j1976292301 [label="他们的傲慢如同刺痛的汗水，渗入我的脑海。他们饮酒歌唱，吹嘘着未来的辉煌。",shape=box,color=blue];
		j1976292301 -> j332901585;
	j332901585 [label="炫耀他们终将扬名立万。要让他们的家族荣耀加身。",shape=box,color=blue];
		j332901585 -> j2951415345;
	j2951415345 [label="但他们中的许多人都牺牲了。甚至连遗体都没能找回。",shape=box,color=blue];
		j2951415345 -> j76113357;
	j76113357 [label="为了防止敌人窃取我们的机密，他们都被会被赤毒震击，这样他们死后会化为液体。",shape=box,color=blue];
		j76113357 -> j2886507499;
	j2886507499 [label="一代人的希望化作一滩油腻的水坑，被 Grineer 的靴子踩踏殆尽。",shape=box,color=blue];
		j2886507499 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}