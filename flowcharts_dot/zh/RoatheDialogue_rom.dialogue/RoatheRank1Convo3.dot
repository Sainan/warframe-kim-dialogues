	299 [label="我记得当时我被扔到冰冷的楼梯上。现在我知道了那是教堂的楼梯，因为里昂和玛丽根据他们的回忆告诉我了。",shape=box,color=blue];
		299 -> 307;
	300 [label="我不会好心称它们为“简陋”的医院。阿尔布雷希特用一只 Helminth 把我们传送到了过去。​我​不​知道​它​在​过去​是​如何​生长​的​，因为它必须事先就在那里，我们才能到达那里。它在传送过程中就枯萎死去了——我猜想或许可以用另一只 Helminth 进行返程。",shape=box,color=blue];
		300 -> 308;
