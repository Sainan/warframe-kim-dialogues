		216 -> 224;
	219 [label="据我所知，你曾体验过永无止境的死亡。这远比什么都有趣——然而，最终你却依然选择了麻木。",shape=box,color=blue];
		219 -> 220;
	220 [label="我的意思是——事实上，我早已习惯，非常习惯——我们奥罗金人为了取乐而互相耍的各种阴谋诡计。这不过是我们消磨时间的方式而已。",shape=box,color=blue];
