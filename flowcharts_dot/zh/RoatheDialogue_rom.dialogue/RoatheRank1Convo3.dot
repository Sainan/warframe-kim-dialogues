		231 -> 238;
	234 [label="他把我丢在那儿，在某个极其古老的年代，在始源星系某个偏僻的犄角旮旯！你知道吗，那座被虚空遗弃的“大教堂”当时甚至连电都没有？！没有电啊！",shape=box,color=blue];
