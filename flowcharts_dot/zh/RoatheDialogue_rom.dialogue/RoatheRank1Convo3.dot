	191 [label="我的篡位者，我怎么感觉你早就非常清楚这个问题的答案？如果你已经洞悉我的心思，为何还要追问这些琐事？",shape=box,color=blue];
		191 -> 193;
	192 [label="是的，你可以问！这让我有机会炫耀自己的才华，并抱怨阿尔布雷希特这个既能无脑乱窜，又能在关键时刻表现得无与伦比的胆怯蠢货！",shape=box,color=blue];
		192 -> 194;
