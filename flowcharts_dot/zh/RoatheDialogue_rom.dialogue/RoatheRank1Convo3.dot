		287 -> 295;
	291 [label="我的身体被撕裂，又被重塑。这一切都是强加给我的。这不是我选择的。我不知道其他人是否也经历了同样的遭遇。",shape=box,color=blue];
		291 -> 299;
	292 [label="我利用自己的血液样本，通过反复试验，逆向工程了一种 Helminth。这并非易事，因为我没有任何奥罗金设备可以用。事实上，除了我能从……那里偷到的东西之外，我根本无法获得任何设备。",shape=box,color=blue];
