		274 -> 282;
	271 [label="是背叛。",shape=box,color=blue];
		271 -> 279;
	275 [label="但我脑海中会闪过一些画面。破碎的金色走廊，残缺不全的影像。一个我熟悉的声音——却看不清脸。是阿尔布雷希特，但不是我认识的那个。",shape=box,color=blue];
