	194 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		194 -> 197 [label="x >= 1",color=purple];
		194 -> 198 [label="x <= 0",color=purple];
		194 -> 198 [label="false",color=purple];
	196 [label="你和阿尔布雷希特一样卑鄙，玩弄身边人的思想——把他们当成你的玩具！所以告诉我，既然你已经知道答案，为什么还要问呢？嗯？",shape=box,color=blue];
		196 -> 201;
		196 -> 202;
	195 [label="告诉我，我理解的没错吧？你已经找到了你想要的答案。你已经知道我是如何带着狂热分子回到这里的——确切地说，我们是从哪里来的。而且你可能知道的远不止这些，对吗？",shape=box,color=blue];
		195 -> 199;
		195 -> 200;
	197 [label="我猜你不是自愿让阿尔布雷希特安排你到那里去的。",shape=box,color=red];
		197 -> 203;
	198 [label="啊。所以你并非自愿被放逐到过去。",shape=box,color=red];
		198 -> 203;
	201 [label="我正在努力帮助大家适应这个过程，但上次我彻底搞砸了。这次我再试一次，可以说是“从头开始”。",shape=box,color=red];
		201 -> 206;
	202 [label="我真的不知道该怎么解释这一切。我也没想要拥有抹去你们记忆的能力，我现在只能尽力去驾驭这种能力。",shape=box,color=red];
		202 -> 207;
	199 [label="不。我不知道。",shape=box,color=red];
		199 -> 204;
	200 [label="没错，​我​承认​……​我​确实知道。​",shape=box,color=red];
		200 -> 205;
	203 [label="不，我绝对不是。现在，关于奥罗金人，你必须明白一点：我们经常——更准确地说，是过去经常——互相玩游戏。各种各样的游戏。政治的、心理的、性方面的。什么都行。",shape=box,color=blue];
		203 -> 208;
	206 [label="+5 Chemistry",color=orange];
		206 -> 211;
	207 [label="我的老相识，那你做得实在不怎么样啊。你究竟想追求什么呢，是以前没有实现过的事吗？",shape=box,color=blue];
		207 -> 212;
	204 [label="哈。篡位者，现在我知道你不光是窃取记忆的贼，还是个骗子。",shape=box,color=blue];
		204 -> 209;
	205 [label="Update boolean RoatheKnowsReset",color=orange];
		205 -> 210;
	208 [label="借助赤毒和青春厅堂，我们从根本上和实际上获得了永生。你能想象这有多么令人筋疲力竭吗？",shape=box,color=blue];
		208 -> 213;
		208 -> 214;
