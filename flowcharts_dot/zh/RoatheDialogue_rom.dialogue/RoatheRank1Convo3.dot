		5741 -> 5742;
	288 [label="其次：你得有多无能啊？！我相当肯定，如果你每天只喂神父吃饭喝水，你就会得到他永恒的爱戴和崇拜。",shape=box,color=blue];
		288 -> 296;
	289 [label="其次：你有没有试过在她面前装出一瘸一拐？装病？抛媚眼？或者直接夸她漂亮？她看起来并不难追。",shape=box,color=blue];
