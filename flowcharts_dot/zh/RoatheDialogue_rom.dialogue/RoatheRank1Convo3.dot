		214 -> 220;
	215 [label="现在我​发现​这​很​有意思……​你​是​跟​我​“搞砸​了”，​还是​跟​里昂​或​玛丽​“搞砸​了”？​",shape=box,color=blue];
		215 -> 221;
		215 -> 222;
		215 -> 223;
	217 [label="那个，你看，你之前说你对注射那血清……有点敏感，而我……只是恰好在不该说的时候，说了不该说的话。",shape=box,color=red];
		217 -> 225;
