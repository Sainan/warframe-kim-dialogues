		267 -> 275;
	268 [label="没错！就是你猜的那样！而且还是用我自己的血！我告诉你，我可不是在我们离开的那一年就开始干这事的！以虚空之名，只要我一看到他那张愚蠢又自鸣得意的脸，我就要用我这双新长出来的利爪把他的皮肉撕下来——",shape=box,color=blue];
