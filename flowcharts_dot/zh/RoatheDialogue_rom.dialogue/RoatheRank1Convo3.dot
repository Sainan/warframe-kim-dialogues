	224 [label="嗯，我明白了。我们之前达成了协议，但不知何故你没能履行你的承诺，所以你眼睁睁地看着你的奖赏从眼前消失。",shape=box,color=blue];
		224 -> 231;
	227 [label="但有些底线我们不能逾越，有些事请我们不能做。我可以详细说说，但我不会。我简单地总结一下：阿尔布雷希特打破了所有这些底线。",shape=box,color=blue];
		227 -> 234;
