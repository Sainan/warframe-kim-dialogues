		j511900548 -> j77455891 [label=false,color=brown];
		j511900548 -> j593540702 [label=false,color=brown];
	j4082858284 [label="Check boolean RoathePolyamorySuccess",color=orange];
		j4082858284 -> j511900548 [label=true,color=green];
		j4082858284 -> "Chat ends." [label=false,color=brown];
	j77455891 [label="嘿，罗瑟？你有空吗？ [征求是否同意多重伴侣关系]",shape=box,color=red];
		j77455891 -> j808610939;
	j593540702 [label="[结束]",shape=box,color=red];
		j593540702 -> j604242687;
	j808610939 [label="嗯？亲爱的，什么事？",shape=box,color=blue];
		j808610939 -> j1505982482;
	j604242687 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j604242687 -> "Chat ends.";
	j1505982482 [label="我想跟你说件事，我想先确定你能接受。",shape=box,color=red];
		j1505982482 -> j536514572;
	j536514572 [label="对我来说重要的是，你不会觉得我在对你撒谎，或者对你不坦诚。",shape=box,color=red];
		j536514572 -> j746144334;
	j746144334 [label="请继续。听起来很不错。",shape=box,color=blue];
		j746144334 -> j4189525621;
	j4189525621 [label="我不想让你陷入一种你无法接受的情况。所以如果你拒绝，那也没关系。我希望你清楚这一点。",shape=box,color=red];
		j4189525621 -> j3569233690;
	j3569233690 [label="我们之间的感情对我很重要——非常重要——而且它是真实的。我不希望你怀疑这一点。",shape=box,color=red];
		j3569233690 -> j952711905;
	j952711905 [label="等等。我的天，你是想偷偷摸摸地隐瞒你有了另一个伴侣这件事吗？",shape=box,color=blue];
		j952711905 -> j1865216126;
	j1865216126 [label="你觉得我有多傻？亲爱的漂泊者，我早就知道了！",shape=box,color=blue];
		j1865216126 -> j1201863931;
		j1865216126 -> j3756255337;
	j1201863931 [label="看来你不介意吧？",shape=box,color=red];
		j1201863931 -> j3727412271;
	j3756255337 [label="你……知道？",shape=box,color=red];
		j3756255337 -> j4145792867;
	j3727412271 [label="要是你现在能在圣所里听到我的笑声就好了。漂泊者，亲爱的。我亲爱的可爱的漂泊者。我可是奥罗金人。我当然不介意。",shape=box,color=blue];
		j3727412271 -> j1995834990;
	j4145792867 [label="要是你现在能在圣所里听到我的笑声就好了。漂泊者，亲爱的。我亲爱的可爱的漂泊者。",shape=box,color=blue];
		j4145792867 -> j2279344567;
	j1995834990 [label="你可以随意看待我的社会，以及我们享受与他人相处的方式，你可能会觉得这种方式轻蔑和贬低他人，但我们也懂得爱的滋味。",shape=box,color=blue];
		j1995834990 -> j865811758;
	j2279344567 [label="事情发生的那一刻我就知道了。我有自己的方法。而且，我一点也不介意。我可是奥罗金人。",shape=box,color=blue];
		j2279344567 -> j1995834990;
	j865811758 [label="没有人比奥罗金人更懂得爱。我们知道，一颗心中可以容纳不止一个爱人。 ",shape=box,color=blue];
		j865811758 -> j2091708665;
	j2091708665 [label="我只是感到失望，那些狂热分子可能太过思想封闭，无法参与到这场游戏中来。",shape=box,color=blue];
		j2091708665 -> j1148306343;
	j1148306343 [label="唉。仔细想想，这或许是最好的结果。你能想象那会造成多大的混乱吗？",shape=box,color=blue];
		j1148306343 -> j661050424;
	j661050424 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j661050424 -> j2825734496;
	j2825734496 [label="好吧，不管怎样。如果让你快乐，那就和他一起享受吧。但你要知道，当我和你在一起的时候……",shape=box,color=blue];
		j2825734496 -> j3994920624;
	j3994920624 [label="+5 Chemistry",color=orange];
		j3994920624 -> j3227101146;
	j3227101146 [label="你是我的，只属于我。",shape=box,color=blue];
		j3227101146 -> "Chat ends.";
}