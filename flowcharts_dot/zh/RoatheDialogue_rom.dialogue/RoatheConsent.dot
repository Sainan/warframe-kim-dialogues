		5404 -> 5408 [label=true,color=green];
		5404 -> 5407 [label=false,color=brown];
		5404 -> 5406 [label=false,color=brown];
	5799 [label="Check boolean RoathePolyamorySuccess",color=orange];
		5799 -> 5404 [label=true,color=green];
		5799 -> 5405 [label=false,color=brown];
	5408 [label="Chat ends.",color=orange];
	5407 [label="嘿，罗瑟？你有空吗？ [征求多个伴侣关系的同意]",shape=box,color=red];
		5407 -> 5410;
	5406 [label="[结束]",shape=box,color=red];
		5406 -> 5409;
	5405 [label="Chat ends.",color=orange];
	5410 [label="嗯？亲爱的，什么事？",shape=box,color=blue];
		5410 -> 5412;
	5409 [label="Update boolean RoatheConsentComplete",color=orange];
		5409 -> 5411;
	5412 [label="我想跟你说件事，我想先确定你能接受。",shape=box,color=red];
		5412 -> 5413;
	5411 [label="Chat ends.",color=orange];
	5413 [label="对我来说重要的是，你不会觉得我在对你撒谎，或者对你不坦诚。",shape=box,color=red];
		5413 -> 5414;
	5414 [label="请继续。听起来很不错。",shape=box,color=blue];
		5414 -> 5415;
	5415 [label="我不想让你陷入一种你无法接受的情况。所以如果你拒绝，那也没关系。我希望你清楚这一点。",shape=box,color=red];
		5415 -> 5416;
	5416 [label="我们之间的感情对我很重要——非常重要——而且它是真实的。我不希望你怀疑这一点。",shape=box,color=red];
		5416 -> 5417;
	5417 [label="等等。我的天，你是想偷偷摸摸地隐瞒你有了另一个伴侣这件事吗？",shape=box,color=blue];
		5417 -> 5418;
	5418 [label="你觉得我有多傻？亲爱的漂泊者，我早就知道了！",shape=box,color=blue];
		5418 -> 5419;
		5418 -> 5420;
	5419 [label="看来你不介意吧？",shape=box,color=red];
		5419 -> 5421;
	5420 [label="你……知道？",shape=box,color=red];
		5420 -> 5422;
	5421 [label="要是你现在能在圣所里听到我的笑声就好了。漂泊者，亲爱的。我亲爱的可爱的漂泊者。我可是奥罗金人。我当然不介意。",shape=box,color=blue];
		5421 -> 5423;
	5422 [label="要是你现在能在圣所里听到我的笑声就好了。漂泊者，亲爱的。我亲爱的可爱的漂泊者。",shape=box,color=blue];
		5422 -> 5424;
	5423 [label="你可以随意看待我的社会，以及我们享受与他人相处的方式，你可能会觉得这种方式轻蔑和贬低他人，但我们也懂得爱的滋味。",shape=box,color=blue];
		5423 -> 5425;
	5424 [label="事情发生的那一刻我就知道了。我有自己的方法。而且，我一点也不介意。我可是奥罗金人。",shape=box,color=blue];
		5424 -> 5423;
	5425 [label="没有人比奥罗金人更懂得爱。我们知道，一颗心中可以容纳不止一个爱人。 ",shape=box,color=blue];
		5425 -> 5426;
	5426 [label="我只是感到失望，那些狂热分子可能太过思想封闭，无法参与到这场游戏中来。",shape=box,color=blue];
		5426 -> 5427;
	5427 [label="唉。仔细想想，这或许是最好的结果。你能想象那会造成多大的混乱吗？",shape=box,color=blue];
		5427 -> 5428;
	5428 [label="Update boolean RoatheConsentComplete",color=orange];
		5428 -> 5429;
	5429 [label="好吧，不管怎样。如果让你快乐，那就和他一起享受吧。但你要知道，当我和我在一起的时候……",shape=box,color=blue];
		5429 -> 5430;
	5430 [label="+5 Chemistry",color=orange];
		5430 -> 5431;
	5431 [label="你是我的，只属于我。",shape=box,color=blue];
		5431 -> 5432;
	5432 [label="Chat ends.",color=orange];
}