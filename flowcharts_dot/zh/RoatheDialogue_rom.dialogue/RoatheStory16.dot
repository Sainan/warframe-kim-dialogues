	2274 [label="Chat ends.",color=orange];
	2275 [label="文字记录：特雷文。我亲眼看着你驾驶着你的航道星舰冲进了布拉喀萨的巨口。她当时正忙着贪婪地吞噬你和你的部下，根本没注意到我的飞船已经疾驰而去。你为了你的上级献出了生命。",shape=box,color=blue];
		2275 -> 5713;
	5713 [label="你为了你的上级献出了生命。你的无私仿佛一记耳光打在我脸上。",shape=box,color=blue];
		5713 -> 5714;
	5714 [label="玛丽娜，你把你的身体给了我。在那条战壕里，我们一起喝下赤毒。我的手颤抖着，被割破的喉咙鲜血直流，但我还是努力咽下了几滴，让它发挥作用。",shape=box,color=blue];
		5714 -> 2278;
	2278 [label="我记得你最后一次敬礼。那道逐渐消逝的身影。然后我睁开了曾属于你的眼睛，看到自己被开膛破肚的尸体躺在泥泞里。",shape=box,color=blue];
		2278 -> 2272;
	2272 [label="罗斯蒂格。他们说，是克隆过程出了问题。还有什么能让一个 Grineer 士兵在被活活烧死的情况下还坚守炮塔？就连老鼠都懂得自保！",shape=box,color=blue];
		2272 -> 2279;
	2279 [label="不，是你的“缺陷”反倒让你比他们更优秀。",shape=box,color=blue];
		2279 -> 2271;
	2271 [label="Add 1 to HellStory",color=orange];
		2271 -> 2343;
	2343 [label="{\"Id\":2343,\"Incoming\":[2271],\"Outgoing\":[2270],\"GraphPos\":[4809,-5333],\"CompletionType\":1}",color=orange];
		2343 -> 2270;
	2270 [label="Chat ends.",color=orange];
