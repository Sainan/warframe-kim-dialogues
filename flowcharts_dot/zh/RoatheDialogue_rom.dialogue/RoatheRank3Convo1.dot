digraph {
	"RoatheRank3Convo1 begins." [color=orange];
		"RoatheRank3Convo1 begins." -> j565144863;
	j565144863 [label="你终于跟我们亲爱的里昂说上话了吗？还是他依然没理你？说实话，你最好还是跟他保持距离。",shape=box,color=blue];
		j565144863 -> j4029808236;
		j565144863 -> j2514554588;
		j565144863 -> j1038552372;
	j4029808236 [label="你和他关系不好吗？",shape=box,color=red];
		j4029808236 -> j166138292;
	j2514554588 [label="如果你对玛丽和里昂友善一些，他们或许也会对你友善一些。",shape=box,color=red];
		j2514554588 -> j185432025;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j166138292 [label="如果他能努力来多了解我，了解我的出身，我们或许能相处得更好。我就是我，几个世纪以来一直如此。我不会因为他们现在的要求就改变自己。",shape=box,color=blue];
		j166138292 -> j3060654953;
	j185432025 [label="篡位者，他们对我的恩情又算什么？我就是我，几个世纪以来一直如此。我不会因为他们现在的要求就改变自己。",shape=box,color=blue];
		j185432025 -> j3060654953;
	"Chat ends." [color=orange];
	j3060654953 [label="Evaluate expressions on HellStory counter",color=orange];
		j3060654953 -> j2527217469 [label="x >= 21",color=purple];
		j3060654953 -> j625880234 [label="x < 21",color=purple];
		j3060654953 -> j625880234 [label="false",color=purple];
	j2527217469 [label="我或许是自愿注射了那瓶血清——但我知道我可不会自愿被那两个忘恩负义的人无时无刻骚扰。  ",shape=box,color=blue];
		j2527217469 -> j4113085997;
	j625880234 [label="都是阿尔布雷希特的错，我才会变成这样！我​跟​他们​一起​困​在​这里，都是他的错，不是我的错！这可怕的安排跟我一点关系都没有！",shape=box,color=blue];
		j625880234 -> j4113085997;
	j4113085997 [label="他们可以向他们尊贵的“主教”投诉，而不是向我投诉。",shape=box,color=blue];
		j4113085997 -> j3786063967;
		j4113085997 -> j3814805840;
		j4113085997 -> j4289637451;
	j3786063967 [label="他们的出发点是好的，即使他们用的方式并不完美。",shape=box,color=red];
		j3786063967 -> j958371309;
	j3814805840 [label="你难道不觉得你需要为你所做的事情寻求宽恕吗？",shape=box,color=red];
		j3814805840 -> j153772671;
	j4289637451 [label="他们​只​是​想​帮助​你​而​已。​",shape=box,color=red];
		j4289637451 -> j2508068801;
	j958371309 [label="Add -1 to Thermostat counter",color=orange];
		j958371309 -> j1701456495;
	j153772671 [label="Add 1 to Thermostat counter",color=orange];
		j153772671 -> j1335828427;
	j2508068801 [label="“帮助。”​ 可​不​是​嘛。​“帮助。”​ 不​好意思，​我​觉得​他们​这​种​“帮助”​的​方式​实​在​“无济于​事”。​",shape=box,color=blue];
		j2508068801 -> j2025656049;
	j1701456495 [label="是的，这就是整件事的悲剧所在。他们真心相信自己是在做好事。",shape=box,color=blue];
		j1701456495 -> j3497981577;
	j1335828427 [label="被谁宽恕？你？他们？管家？阿尔布雷希特？还是“神明”？",shape=box,color=blue];
		j1335828427 -> j3261155099;
		j1335828427 -> j1170806822;
		j1335828427 -> j1727105410;
	j2025656049 [label="篡位者，事实上，如果他们把我的酒换成一种腐蚀性的收敛剂，我会觉得更有“帮助”。",shape=box,color=blue];
		j2025656049 -> j144651583;
	j3497981577 [label="那​你​觉得​呢？​你​认为​我​需要​某​种​“伟大​的​救赎”​吗？​需要​某​种​“神圣​的​宽恕”​吗？​",shape=box,color=blue];
		j3497981577 -> j937239071;
	j3261155099 [label="你还漏掉了一个重要的忏悔对象。",shape=box,color=red];
		j3261155099 -> j3069731883;
	j1170806822 [label="你是奥罗金人。在战争中犯下了滔天罪行，并且你的出身本身就是罪。你有很多需要赎罪的地方。",shape=box,color=red];
		j1170806822 -> j4210164021;
	j1727105410 [label="难道你一点也不觉得自己这辈子做过很多可怕的事情吗？",shape=box,color=red];
		j1727105410 -> j760995997;
	j144651583 [label="至少这样效率会更高。",shape=box,color=blue];
		j144651583 -> j1862221451;
	j937239071 [label="Evaluate expressions",color=orange];
		j937239071 -> j681086418 [label="RoatheTraitor2",color=purple];
		j937239071 -> j817265400 [label="RoatheTraitor2",color=purple];
		j937239071 -> j2302229268 [label="RoatheTraitor2",color=purple];
		j937239071 -> j3486908575 [label="RoatheTraitor2",color=purple];
		j937239071 -> j681086418 [label="RoatheTraitor1",color=purple];
		j937239071 -> j817265400 [label="RoatheTraitor1",color=purple];
		j937239071 -> j2302229268 [label="RoatheTraitor1",color=purple];
		j937239071 -> j3486908575 [label="RoatheTraitor1",color=purple];
		j937239071 -> j681086418 [label="RoatheExecutor2",color=purple];
		j937239071 -> j817265400 [label="RoatheExecutor2",color=purple];
		j937239071 -> j2302229268 [label="RoatheExecutor2",color=purple];
		j937239071 -> j3486908575 [label="RoatheExecutor2",color=purple];
		j937239071 -> j681086418 [label="false",color=purple];
		j937239071 -> j817265400 [label="false",color=purple];
		j937239071 -> j2302229268 [label="false",color=purple];
	j3069731883 [label="请告诉我是谁。 ",shape=box,color=blue];
		j3069731883 -> j3137709282;
		j3069731883 -> j1326109012;
		j3069731883 -> j1715489644;
	j4210164021 [label="我不会为奥罗金社会道歉，因为我并非它的缔造者，而只是其中的一员。如果你要指责所有身处这个体制中的人，那么你那出于傲慢的自以为是，将会定罪数十亿人。至于其他人呢？",shape=box,color=blue];
		j4210164021 -> j3793385;
	j760995997 [label="就算我真的做了又怎样？现在也无法改变了。内疚又有什么用呢？",shape=box,color=blue];
		j760995997 -> j905365988;
		j760995997 -> j1915466630;
	j1862221451 [label="不过，我得承认，在这他俩之间，我更喜欢那位神父。他能听进去道理。他或许最终会明白，虚空无情之物并非真正的神。",shape=box,color=blue];
		j1862221451 -> j3155720055;
	j681086418 [label="我认为反思我们伤害他人的行为并努力理解如何弥补是值得的。但我认为他们俩的做法完全不对。",shape=box,color=red];
		j681086418 -> j1827584800;
	j817265400 [label="说到底，我认为除了自己以外，没有必要原谅任何人。如果你能对自己做过的事释怀，那就这样吧。",shape=box,color=red];
		j817265400 -> j3681039002;
	j2302229268 [label="你出生在一个奥罗金的社会，在那种社会里，很多奥罗金人的行为都被视为……正常，理所当然。在你看来，这些行为并没有“错”。我并不是说这就能让这些行为变得合理，只是说这可以理解。",shape=box,color=red];
		j2302229268 -> j3818860213;
	j3486908575 [label="你原本计划推翻奥罗金人。你知道他们腐败堕落，你想改变他们。",shape=box,color=red];
		j3486908575 -> j3560173707;
	j3137709282 [label="你自己。",shape=box,color=red];
		j3137709282 -> j959970570;
	j1326109012 [label="你即将背叛的自己人。",shape=box,color=red];
		j1326109012 -> j1072983976;
	j1715489644 [label="那些被你屠杀的 Sentient。",shape=box,color=red];
		j1715489644 -> j3793385;
	j3793385 [label="那是战争。而战争的本质就是大量杀戮敌人。你会为被你杀死的 Grineer 或 Corpus 哭泣吗？",shape=box,color=blue];
		j3793385 -> j180042694;
		j3793385 -> j2936035190;
		j3793385 -> j2227879696;
	j905365988 [label="得到他人的宽恕还是很重要的。",shape=box,color=red];
		j905365988 -> j2586731350;
	j1915466630 [label="你可以改变你未来的行事方式。",shape=box,color=red];
		j1915466630 -> j427830404;
	j3155720055 [label="事实上，我或许还能说服他彻底看穿他的宗教——真是不可思议。一个既能看到奇幻血腥的幻觉，又能保持理智和逻辑的人。真是罕见。",shape=box,color=blue];
		j3155720055 -> j769607937;
		j3155720055 -> j3827544892;
	j1827584800 [label="嗯，我明白了。你反对的不是行为本身，而是方法。我在此撤回我之前的赞同，取而代之的是震惊。",shape=box,color=blue];
		j1827584800 -> "Chat ends.";
	j3681039002 [label="Boolean RoatheVillainSelf is now true.",color=orange];
		j3681039002 -> j4032813566;
	j3818860213 [label="Boolean RoatheVillainOrokin is now true.",color=orange];
		j3818860213 -> j4032813566;
	j3560173707 [label="所以我觉得，即使你打算按照自己的想法重新塑造它，你也知道它必须改变。",shape=box,color=red];
		j3560173707 -> j3856407844;
		j3560173707 -> j441836548;
	j959970570 [label="Check boolean RoatheKnowsReset2",color=orange];
		j959970570 -> j796689239 [label=true,color=green];
		j959970570 -> j884899951 [label=false,color=brown];
	j1072983976 [label="篡位者，我从未因背叛自己的人民而彻夜难眠，相信我。",shape=box,color=blue];
		j1072983976 -> j4281920862;
	j180042694 [label="不会。但 Sentient 的情况是不一样的。",shape=box,color=red];
		j180042694 -> j2688504496;
	j2936035190 [label="是的。我会。",shape=box,color=red];
		j2936035190 -> j1701347145;
	j2227879696 [label="我对于自己必须夺走的生命有何感受，那是我的私事。我们现在说的是你。",shape=box,color=red];
		j2227879696 -> j4159914737;
	j2586731350 [label="为什么？就为了让我一个人待着？就为了让我不至于成为什么……异类？什么社会弃儿？ ",shape=box,color=blue];
		j2586731350 -> j2647973673;
	j427830404 [label="从错误中吸取教训固然重要，但理解“失败”并不需要感到“内疚”。",shape=box,color=blue];
		j427830404 -> j489000207;
	j769607937 [label="里昂似乎已经够忙的了，你不觉得吗？",shape=box,color=red];
		j769607937 -> j2668054735;
	j3827544892 [label="不好意思，你要做什么？",shape=box,color=red];
		j3827544892 -> j2709052102;
	j4032813566 [label="你们所处的时代和我们现在的时代不同。而我们眼中的残酷和可怕，在你们从小接受的教育中，只是世界运转的一部分。",shape=box,color=red];
		j4032813566 -> j1180647787;
	j3856407844 [label="但这并不能为你的所作所为开脱——暴行就是暴行，恐怖事件就是恐怖事件。但你至少尝试过了。",shape=box,color=red];
		j3856407844 -> j897979035;
	j441836548 [label="在我看来，你当时身处战乱之中，一边要周旋于一群反社会人格者组成的社会，一边还要计划推翻他们。结果他们却因此给你贴上恶魔的标签。我觉得这不公平。",shape=box,color=red];
		j441836548 -> j511151443;
	j796689239 [label="因为你的逃避。",shape=box,color=red];
		j796689239 -> j2340587127;
	j884899951 [label="因为你的失败。",shape=box,color=red];
		j884899951 -> j2340587127;
	j4281920862 [label="我不会为奥罗金帝国道歉，因为我并非它的缔造者，而只是其中的一员。但我也不会为策划摧毁它而承担任何责任。我们罪有应得，甚至该受更重的惩罚。",shape=box,color=blue];
		j4281920862 -> j3256543799;
	j2688504496 [label="篡位者，每一种情况都是“不一样的情况”。背景永远是关键。而你只不过是用马后炮的眼光看待那场“远古之战”罢了。",shape=box,color=blue];
		j2688504496 -> j609662791;
	j1701347145 [label="那么，我对你，篡位者，深感同情。我建议你要么接受你所肩负的使命，要么就此隐退种田去。",shape=box,color=blue];
		j1701347145 -> j1194601532;
	j4159914737 [label="嗯。我就喜欢你这么明显地表现出我触碰到了你的痛点，真是妙不可言。你拙劣地转移了话题。",shape=box,color=blue];
		j4159914737 -> j1069192518;
	j2647973673 [label="篡位者，看看我。看看我是什么人。一个被逐出帝国的奥罗金人。",shape=box,color=blue];
		j2647973673 -> j3535959632;
	j489000207 [label="还有，宽恕的意义何在？我应该努力获得谁的宽恕？其他人吗？这样我才不会成为众矢之的吗？",shape=box,color=blue];
		j489000207 -> j2647973673;
	j2668054735 [label="而这正是我想要帮助他的地方！关于虚空无情之物以及英择谛告诉他的事情，我只是想帮他理清一些的疑惑。",shape=box,color=blue];
		j2668054735 -> j3693832747;
	j2709052102 [label="当然​都是​些​无害​的​事，​不​用​管​那​只​烦人​的​飞​虫​是怎么​说的。​我​只​是​想​帮​他​解惑，​让​他​明白虚空​无情​之物​和​英择​谛告诉​他​的​那些​话​到​底​是​什么​意思。​",shape=box,color=blue];
		j2709052102 -> j3693832747;
	j1180647787 [label="+10 Chemistry",color=orange];
		j1180647787 -> j2128049340;
	j897979035 [label="Boolean RoatheVillainOrokin is now true.",color=orange];
		j897979035 -> j1180647787;
	j511151443 [label="Boolean RoatheVillainShortcut is now true.",color=orange];
		j511151443 -> j3771258726;
	j2340587127 [label="Boolean RoatheForgivenessShortcut is now true.",color=orange];
		j2340587127 -> j1933300832;
	j3256543799 [label="如果说我有什么愧疚的话，那就是最终毁掉这一切的是 Tenno，而不是我。",shape=box,color=blue];
		j3256543799 -> j533316691;
	j609662791 [label="如果你用未来掌握的所有信息去评判人们过去的行为，你将会感到无比羞愧。",shape=box,color=blue];
		j609662791 -> j3340575232;
	j1194601532 [label="虽然那样就太可惜了。看你做事真是赏心悦目。效率不算很高，但绝对精彩炫目。",shape=box,color=blue];
		j1194601532 -> j3010280924;
	j1069192518 [label="不过我想，独自一人度过几个世纪，除了用自己童话般的想象力所创造的人物之外，没有人可以交谈，这确实会限制一个人磨练社交能力的机会。",shape=box,color=blue];
		j1069192518 -> j3751179794;
	j3535959632 [label="我以前是“Tau 之恶魔”。而在这里，对于所有见到我的人来说，我已然成了“恶魔”。",shape=box,color=blue];
		j3535959632 -> j2329909156;
	j3693832747 [label="英择谛告诉他，他的“异象”并非来自月神，而是来自虚空无情之物。这让他陷入了某种“信仰危机”。",shape=box,color=blue];
		j3693832747 -> j2048441695;
	j2128049340 [label="真是令人欣慰啊，原来“分寸”与“细微”的概念还没有消亡。是的，你说得对。我是另一个时期、另一个时代、另一个社会的产物。",shape=box,color=blue];
		j2128049340 -> j4157057596;
	j3771258726 [label="+20 Chemistry",color=orange];
		j3771258726 -> j4049250051;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j533316691 [label="Boolean RoatheForgivenessNoGuilt is now true.",color=orange];
		j533316691 -> j1933300832;
	j3340575232 [label="接受过去发生的一切，然后继续前进。",shape=box,color=blue];
		j3340575232 -> j1314188072;
	j3010280924 [label="就算别的什么都没做，至少你让战场变得“有趣”了。 ",shape=box,color=blue];
		j3010280924 -> j1314188072;
	j3751179794 [label="去和神父切磋一下，你们俩都需要练习。 ",shape=box,color=blue];
		j3751179794 -> j4081414586;
	j2329909156 [label="阿尔布雷希特认为有必要确保这个绰号永久保留下来。 ",shape=box,color=blue];
		j2329909156 -> j1314188072;
	j2048441695 [label="然而，​我​正试图​让​他​相信​事实​并​非​如此，​也​不​是​来自于​“神”，​因为​根本​没有​“神”。​他​只​是​生病​了。​",shape=box,color=blue];
		j2048441695 -> j3464216237;
		j2048441695 -> j2176161059;
	j4157057596 [label="然而，我能认清我族人的残忍和暴行。我的许多同胞堕落到的地步，连我都无法忍受。",shape=box,color=blue];
		j4157057596 -> j341794902;
	j4049250051 [label="篡位者，我就知道我喜欢你是有原因的。终于！有人欣赏我了！这花了……多少个世纪啊？！",shape=box,color=blue];
		j4049250051 -> j1119865337;
	j1314188072 [label="我给你的建议是：像我一样，把对自己行为的所有愧疚都杀掉。用刀刺入它的胸膛，直到它死去。",shape=box,color=blue];
		j1314188072 -> j1143454379;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j3464216237 [label="里昂需要你的帮助吗？",shape=box,color=red];
		j3464216237 -> j2264671402;
	j2176161059 [label="你觉得这样对他来说会更好吗？",shape=box,color=red];
		j2176161059 -> j349660840;
	j341794902 [label="但这类事情……很复杂。我很感激你能明白这一点。唉。管家正瞪着我。我得结束这次谈话了。我们很快会再谈。",shape=box,color=blue];
		j341794902 -> "Chat ends.";
	j1119865337 [label="唉。管家正瞪着我。我得结束这次谈话了。我们很快再聊。",shape=box,color=blue];
		j1119865337 -> "Chat ends.";
	j1143454379 [label="内疚就像黑夜里的叛徒，会夺走你珍视的一切。它只会给你带来伤害。",shape=box,color=blue];
		j1143454379 -> j533316691;
	j2264671402 [label="他并没有拒绝倾听，也没有叫我停止说话。如果他叫我停下，我会照做的。",shape=box,color=blue];
		j2264671402 -> j1473784601;
	j349660840 [label="难道有宗教倾向的人就可以去操纵他吗？只是把他的幻觉称为“异象”，而不是去帮助他？",shape=box,color=blue];
		j349660840 -> j2260362417;
	j1473784601 [label="看到里昂身边的人利用和操纵他，无论这些人是否意识到这一点，我都感到愤怒。这一切都打着“宗教”和“信仰”的旗号。",shape=box,color=blue];
		j1473784601 -> j2260362417;
	j2260362417 [label="我一直在阅读相关的历史记载。这个……“血色面纱”本可以尝试在几个世纪里将那位 Tenno 从他的 Harrow 体内救出。但他们没有。他们任由他枯萎死去。",shape=box,color=blue];
		j2260362417 -> j4240277856;
	j4240277856 [label="为什么？为了防范某个……理论上的“虚空之神”。",shape=box,color=blue];
		j4240277856 -> j4177006762;
		j4240277856 -> j1826702334;
	j4177006762 [label="你认为 Rell 的牺牲毫无意义吗？",shape=box,color=red];
		j4177006762 -> j4039913894;
	j1826702334 [label="这么多年来，只有 Rell 才能阻止这件事发生。",shape=box,color=red];
		j1826702334 -> j588191431;
	j4039913894 [label="不，他是在防范某种东西。但谁知道他把事情搞得这么糟糕？谁知道几个世纪以来，他究竟在滋养了多少自己的恐惧和恐慌？",shape=box,color=blue];
		j4039913894 -> j3331366286;
	j588191431 [label="或者说，这么多年来，它唯一的食物来源就是他。",shape=box,color=blue];
		j588191431 -> j3331366286;
	j3331366286 [label="概念成形只能显现其所拥有的创造素材。虚空也只能利用其所拥有的素材进行创作。",shape=box,color=blue];
		j3331366286 -> j4255829775;
	j4255829775 [label="我想知道，那个 Tenno 究竟为它的存在倾注了多少心血？他简直就是痛苦、折磨、背叛、悲伤……以及孤独的化身……",shape=box,color=blue];
		j4255829775 -> j237889349;
	j237889349 [label="还有，他在那地方独自待了数千年，对着虚无说话，必然会变得麻木。在那之后，还能剩下什么？除了虚空无情之物？",shape=box,color=blue];
		j237889349 -> j675411564;
		j237889349 -> j2797485656;
	j675411564 [label="你说的或许是真的。我只是……不确定那个“它”是不是虚空无情之物。",shape=box,color=red];
		j675411564 -> j355557756;
	j2797485656 [label="在它找上 Rell 之前，它就已经非常强大了。如果没有充分的理由，他是不会那样牺牲自己的。",shape=box,color=red];
		j2797485656 -> j834255367;
	j355557756 [label="+10 Chemistry",color=orange];
		j355557756 -> j393161528;
	j834255367 [label="孩子的噩梦也是一样。在六岁孩子眼里，那是宇宙中最强大的怪物。但对成年人来说，它们只不过是一缕飘到通风口的灰尘，只是太靠近光而已。",shape=box,color=blue];
		j834255367 -> j1506343415;
	j393161528 [label="我所能要求的，不过是希望你承认你并不确定我们究竟在面对什么。",shape=box,color=blue];
		j393161528 -> j880640926;
	j1506343415 [label="我们总是把尘埃夸成高山，只因为我们需要理由去痛苦，去毁灭自己。",shape=box,color=blue];
		j1506343415 -> j545889175;
	j880640926 [label="这​是​一​个​绝妙​的​开始。​而且，​能够​坦然​地​说​“我​不​知道”​也​是​每​个​人​都​应该​具备​的​一​种​优秀​品质。​",shape=box,color=blue];
		j880640926 -> j3938427713;
	j545889175 [label="这就是人类。",shape=box,color=blue];
		j545889175 -> j3208040028;
	j3938427713 [label="如果我们奥罗金人偶尔也能做到这一点，我们或许就能活下来。",shape=box,color=blue];
		j3938427713 -> j3208040028;
	j3208040028 [label="Boolean RoatheMITW3 is now true.",color=orange];
		j3208040028 -> j1933300832;
}