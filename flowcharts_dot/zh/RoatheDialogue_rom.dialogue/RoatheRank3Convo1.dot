digraph {
	1333 [label="RoatheRank3Convo1 begins.",color=orange];
		1333 -> 1334;
	1334 [label="你终于跟我们亲爱的里昂说上话了吗？还是他依然没理你？说实话，你最好还是跟他保持距离。",shape=box,color=blue];
		1334 -> 1337;
		1334 -> 1336;
		1334 -> 1335;
	1337 [label="你和他关系不好吗？",shape=box,color=red];
		1337 -> 1340;
	1336 [label="如果你对玛丽和里昂友善一些，他们或许也会对你友善一些。",shape=box,color=red];
		1336 -> 1339;
	1335 [label="[结束]",shape=box,color=red];
		1335 -> 1338;
	1340 [label="如果他能努力多了解我，了解我的出身，我们或许能相处得更好。我就是我，几个世纪以来一直如此。我不会因为他们现在的要求就改变自己。",shape=box,color=blue];
		1340 -> 1341;
	1339 [label="篡位者，他们对我的恩情又算什么？我就是我，几个世纪以来一直如此。我不会因为他们现在的要求就改变自己。",shape=box,color=blue];
		1339 -> 1341;
	1338 [label="Chat ends.",color=orange];
	1341 [label="Evaluate expressions on HellStory",color=orange];
		1341 -> 1343 [label="x >= 21",color=purple];
		1341 -> 1342 [label="x < 21",color=purple];
		1341 -> 1342 [label="false",color=purple];
	1343 [label="我或许是自愿注射了那瓶血清——但我知道我可不会自愿要被那两个忘恩负义的人无时无刻骚扰。  ",shape=box,color=blue];
		1343 -> 1344;
	1342 [label="都是阿尔布雷希特的错，我才会变成这样！我​跟​他们​一起​困​在​这里，都是他的错，不是我的错！这可怕的安排跟我一点关系都没有！",shape=box,color=blue];
		1342 -> 1344;
	1344 [label="他们可以向他们尊贵的“主教”投诉，而不是向我投诉。",shape=box,color=blue];
		1344 -> 1345;
		1344 -> 1346;
		1344 -> 1347;
	1345 [label="他们的出发点是好的，即使他们用的方式并不完美。",shape=box,color=red];
		1345 -> 1348;
	1346 [label="你难道不觉得你需要为你所做的事情寻求宽恕吗？",shape=box,color=red];
		1346 -> 1349;
	1347 [label="他们​只​是​想​帮助​你​而​已。​",shape=box,color=red];
		1347 -> 1350;
	1348 [label="Add -1 to Thermostat",color=orange];
		1348 -> 1351;
	1349 [label="Add 1 to Thermostat",color=orange];
		1349 -> 1352;
	1350 [label="“帮助。”​ 可​不​是​嘛。​“帮助。”​ 不​好意思，​我​觉得​他们​这​种​“帮助”​的​方式​实​在​“无济于​事”。​",shape=box,color=blue];
		1350 -> 1353;
	1351 [label="是的，这就是整件事的悲剧所在。他们真心相信自己是在做好事。",shape=box,color=blue];
		1351 -> 1354;
	1352 [label="被谁宽恕？你？他们？管家？阿尔布雷希特？还是“神明”？",shape=box,color=blue];
		1352 -> 1355;
		1352 -> 1356;
		1352 -> 1357;
	1353 [label="篡位者，事实上，如果他们把我的酒换成一种腐蚀性的收敛剂，我会觉得更有“帮助”。",shape=box,color=blue];
		1353 -> 1358;
	1354 [label="那​你​觉得​呢？​你​认为​我​需要​某​种​“伟大​的​救赎”​吗？​需要​某​种​“神圣​的​宽恕”​吗？​",shape=box,color=blue];
		1354 -> 1359;
	1355 [label="你还漏掉了一个重要的忏悔对象。",shape=box,color=red];
		1355 -> 1360;
	1356 [label="你是奥罗金人。你在战争中犯下了滔天罪行，并且你的出身本身就是罪。你有很多需要赎罪的地方。",shape=box,color=red];
		1356 -> 1361;
	1357 [label="难道你一点也不觉得自己这辈子做过很多可怕的事情吗？",shape=box,color=red];
		1357 -> 1362;
	1358 [label="至少这样效率会更高。",shape=box,color=blue];
		1358 -> 1363;
	1359 [label="Evaluate expressions",color=orange];
		1359 -> 1364 [label="RoatheTraitor2",color=purple];
		1359 -> 1365 [label="RoatheTraitor2",color=purple];
		1359 -> 1366 [label="RoatheTraitor2",color=purple];
		1359 -> 1367 [label="RoatheTraitor2",color=purple];
		1359 -> 1364 [label="RoatheTraitor1",color=purple];
		1359 -> 1365 [label="RoatheTraitor1",color=purple];
		1359 -> 1366 [label="RoatheTraitor1",color=purple];
		1359 -> 1367 [label="RoatheTraitor1",color=purple];
		1359 -> 1364 [label="RoatheExecutor2",color=purple];
		1359 -> 1365 [label="RoatheExecutor2",color=purple];
		1359 -> 1366 [label="RoatheExecutor2",color=purple];
		1359 -> 1367 [label="RoatheExecutor2",color=purple];
		1359 -> 1364 [label="false",color=purple];
		1359 -> 1365 [label="false",color=purple];
		1359 -> 1366 [label="false",color=purple];
	1360 [label="请告诉我。 ",shape=box,color=blue];
		1360 -> 1368;
		1360 -> 1369;
		1360 -> 1370;
	1361 [label="我不会为奥罗金社会道歉，因为我并非它的缔造者，而只是其中的一员。如果你要指责所有身处这个体制中的人，那么你那出于傲慢的自以为是，将会定罪数十亿人。至于其他人呢？",shape=box,color=blue];
		1361 -> 1371;
	1362 [label="就算我真的做了又怎样？现在也无法改变了。内疚又有什么用呢？",shape=box,color=blue];
		1362 -> 1372;
		1362 -> 1373;
	1363 [label="不过，我得承认，在这他俩之间，我更喜欢那位神父。他能听取道理。他或许最终会明白，虚空无情之物并非真正的神。",shape=box,color=blue];
		1363 -> 1374;
	1364 [label="我认为反思我们伤害他人的行为并努力理解如何弥补是值得的。但我认为他们俩的做法完全不对。",shape=box,color=red];
		1364 -> 1375;
	1365 [label="说到底，我认为除了自己以外，没有必要原谅任何人。如果你能对自己做过的事释怀，那就这样吧。",shape=box,color=red];
		1365 -> 1376;
	1366 [label="你出生在一个奥罗金的社会，在那种社会里，很多奥罗金人的行为都被视为……正常，理所当然。在你看来，这些行为并没有“错”。我并不是说这就能让这些行为变得合理，只是说这可以理解。",shape=box,color=red];
		1366 -> 1377;
	1367 [label="你原本计划推翻奥罗金人。你知道他们腐败堕落，你想改变他们。",shape=box,color=red];
		1367 -> 1378;
	1368 [label="你自己。",shape=box,color=red];
		1368 -> 1379;
	1369 [label="你即将背叛的自己人。",shape=box,color=red];
		1369 -> 1380;
	1370 [label="那些被你屠杀的 Sentient。",shape=box,color=red];
		1370 -> 1371;
	1371 [label="那是战争。而战争的本质就是大量杀戮敌人。你会为被你杀死的 Grineer 或 Corpus 哭泣吗？",shape=box,color=blue];
		1371 -> 1381;
		1371 -> 1382;
		1371 -> 1383;
	1372 [label="得到他人的宽恕很重要。",shape=box,color=red];
		1372 -> 1384;
	1373 [label="你可以改变你未来的行为方式。",shape=box,color=red];
		1373 -> 1385;
	1374 [label="事实上，我或许还能说服他彻底看穿他的宗教——真是不可思议。一个既能看到奇幻血腥的幻觉，又能保持理智和逻辑的人。真是罕见。",shape=box,color=blue];
		1374 -> 1386;
		1374 -> 1387;
	1375 [label="嗯，我明白了。你反对的不是行为本身，而是方法。我在此撤回我之前的赞同，取而代之的是震惊。",shape=box,color=blue];
		1375 -> 1388;
	1376 [label="Update boolean RoatheVillainSelf",color=orange];
		1376 -> 1389;
	1377 [label="Update boolean RoatheVillainOrokin",color=orange];
		1377 -> 1389;
	1378 [label="所以我觉得，即使你打算按照自己的想法重新塑造它，你也知道它必须改变。",shape=box,color=red];
		1378 -> 1390;
		1378 -> 1391;
	1379 [label="Check boolean RoatheKnowsReset2",color=orange];
		1379 -> 1392 [label=true,color=green];
		1379 -> 1393 [label=false,color=brown];
	1380 [label="篡位者，我从未因背叛自己的人民而彻夜难眠，相信我。",shape=box,color=blue];
		1380 -> 1394;
	1381 [label="不会。但 Sentient 的情况是不一样的。",shape=box,color=red];
		1381 -> 1395;
	1382 [label="是的。我会。",shape=box,color=red];
		1382 -> 1396;
	1383 [label="我对于自己必须夺走的生命有何感受，那是我的私事。我们现在说的是你。",shape=box,color=red];
		1383 -> 1397;
	1384 [label="为什么？就为了让我一个人待着？就为了让我不至于成为什么……异类？什么社会弃儿？ ",shape=box,color=blue];
		1384 -> 1398;
	1385 [label="从错误中吸取教训固然重要，但理解“失败”并不需要感到“内疚”。",shape=box,color=blue];
		1385 -> 1399;
	1386 [label="里昂似乎已经够忙的了，你不觉得吗？",shape=box,color=red];
		1386 -> 1400;
	1387 [label="不好意思，你要做什么？",shape=box,color=red];
		1387 -> 1401;
	1388 [label="Chat ends.",color=orange];
	1389 [label="你们所处的时代和我们现在的时代不同。而我们眼中的残酷和可怕，在你们从小接受的教育中，只是世界运转的一部分。",shape=box,color=red];
		1389 -> 1402;
	1390 [label="但这并不能为你的所作所为开脱——暴行就是暴行，恐怖事件就是恐怖事件。但你至少尝试过了。",shape=box,color=red];
		1390 -> 1403;
	1391 [label="在我看来，你当时身处战乱之中，一边要周旋于一群反社会人格者组成的社会，一边还要计划推翻他们。结果他们却因此给你贴上恶魔的标签。我觉得这不公平。",shape=box,color=red];
		1391 -> 1404;
	1392 [label="为了你的逃走。",shape=box,color=red];
		1392 -> 1405;
	1393 [label="为了你的失败。",shape=box,color=red];
		1393 -> 1405;
	1394 [label="我不会为奥罗金帝国道歉，因为我并非它的缔造者，而只是其中的一员。但我也不会为策划摧毁它而承担任何责任。我们罪有应得，甚至该受更重的惩罚。",shape=box,color=blue];
		1394 -> 1406;
	1395 [label="篡位者，每一种情况都是“不一样的情况”。背景永远是关键。而你只不过是用马后炮的眼光看待那场“远古之战”罢了。",shape=box,color=blue];
		1395 -> 1407;
	1396 [label="那么，我对你，篡位者，深感同情。我建议你要么接受你所肩负的使命，要么就此隐退种田去。",shape=box,color=blue];
		1396 -> 1408;
	1397 [label="嗯。我就喜欢你这么明显地表现出我触碰到了你的痛点，真是妙不可言。你拙劣地转移了话题。",shape=box,color=blue];
		1397 -> 1409;
	1398 [label="篡位者，看看我。看看我是什么人。一个被逐出帝国的奥罗金人。",shape=box,color=blue];
		1398 -> 1410;
	1399 [label="还有，宽恕的意义何在？我应该努力获得谁的宽恕？其他人吗？这样我才不会成为众矢之的吗？",shape=box,color=blue];
		1399 -> 1398;
	1400 [label="而这正是我想要帮助他的！关于虚空无情之物以及英择谛告诉他的事情，我只是想帮他理清一些的疑惑。",shape=box,color=blue];
		1400 -> 1411;
	1401 [label="当然​是​些​无害​的​事，​不​用​管​那​只​烦人​的​飞​虫​怎么​说。​我​只​是​想​帮​他​解惑，​让​他​明白虚空​无情​之物​和​英择​谛告诉​他​的​那些​话​到​底​是​什么​意思。​",shape=box,color=blue];
		1401 -> 1411;
	1402 [label="+10 Chemistry",color=orange];
		1402 -> 1412;
	1403 [label="Update boolean RoatheVillainOrokin",color=orange];
		1403 -> 1402;
	1404 [label="Update boolean RoatheVillainShortcut",color=orange];
		1404 -> 1413;
	1405 [label="Update boolean RoatheForgivenessShortcut",color=orange];
		1405 -> 1414;
	1406 [label="如果说我有什么愧疚的话，那就是最终毁掉这一切的是 Tenno，而不是我。",shape=box,color=blue];
		1406 -> 1415;
	1407 [label="如果你用未来掌握的所有信息去评判人们过去的行为，你将会感到无比羞愧。",shape=box,color=blue];
		1407 -> 1416;
	1408 [label="虽然那样就太可惜了。看你做事真是赏心悦目。效率不算很高，但绝对精彩炫目。",shape=box,color=blue];
		1408 -> 1417;
	1409 [label="不过我想，独自一人度过几个世纪，除了用自己童话般的想象力所创造的人物之外，没有人可以交谈，这确实会限制一个人磨练社交能力的机会。",shape=box,color=blue];
		1409 -> 1418;
	1410 [label="我以前是“Tau 之恶魔”。而在这里，对于所有见到我的人来说，我已然成了“恶魔”。",shape=box,color=blue];
		1410 -> 1419;
	1411 [label="英择谛告诉他，他的“异象”并非来自月神，而是来自虚空无情之物。这让他陷入了某种“信仰危机”。",shape=box,color=blue];
		1411 -> 1420;
	1412 [label="真是令人欣慰啊，原来“分寸”与“细微”的概念还没有消亡。是的，你说得对。我是另一个时期、另一个时代、另一个社会的产物。",shape=box,color=blue];
		1412 -> 1421;
	1413 [label="+20 Chemistry",color=orange];
		1413 -> 1422;
	1414 [label="+10 Chemistry",color=orange];
		1414 -> 1423;
	1415 [label="Update boolean RoatheForgivenessNoGuilt",color=orange];
		1415 -> 1424;
	1416 [label="接受过去发生的一切，然后继续前进。",shape=box,color=blue];
		1416 -> 1425;
	1417 [label="就算别的什么都没做，至少你让战场变得“有趣”了。 ",shape=box,color=blue];
		1417 -> 1425;
	1418 [label="去和神父切磋一下，你们俩都需要练习。 ",shape=box,color=blue];
		1418 -> 1426;
	1419 [label="阿尔布雷希特认为有必要确保这个绰号永久保留下来。 ",shape=box,color=blue];
		1419 -> 1425;
	1420 [label="然而，​我​正试图​让​他​相信​事实​并​非​如此，​也​不​是​来自于​“神”，​因为​根本​没有​“神”。​他​只​是​生病​了。​",shape=box,color=blue];
		1420 -> 1427;
		1420 -> 1428;
	1421 [label="然而，我能认清我族人的残忍和暴行。我的许多同胞堕落到的地步，连我都无法忍受。",shape=box,color=blue];
		1421 -> 1429;
	1422 [label="篡位者，我就知道我喜欢你是有原因的。终于！有人欣赏我了！这花了……多少个世纪啊？！",shape=box,color=blue];
		1422 -> 1430;
	1423 [label="Chat ends.",color=orange];
	1424 [label="+10 Chemistry",color=orange];
		1424 -> 1431;
	1425 [label="我给你的建议是：像我一样，把对自己行为的所有愧疚都杀掉。用刀刺入它的胸膛，直到它死去。",shape=box,color=blue];
		1425 -> 1432;
	1426 [label="+5 Chemistry",color=orange];
		1426 -> 1433;
	1427 [label="里昂需要你的帮助吗？",shape=box,color=red];
		1427 -> 1434;
	1428 [label="你觉得这样对他来说会更好吗？",shape=box,color=red];
		1428 -> 1435;
	1429 [label="但这类事情……很复杂。我很感激你能明白这一点。唉。管家正瞪着我。我得结束这次谈话了。我们很快会再谈。",shape=box,color=blue];
		1429 -> 1436;
	1430 [label="唉。管家正瞪着我。我得结束这次谈话了。我们很快再聊。",shape=box,color=blue];
		1430 -> 1437;
	1431 [label="Chat ends.",color=orange];
	1432 [label="内疚就像黑夜里的叛徒，会夺走你珍视的一切。它只会给你带来伤害。",shape=box,color=blue];
		1432 -> 1438;
	1433 [label="Chat ends.",color=orange];
	1434 [label="他并没有拒绝倾听，也没有叫我停止说话。如果他叫我停下，我会照做的。",shape=box,color=blue];
		1434 -> 1439;
	1435 [label="难道有宗教倾向的人就可以去操纵他吗？只是把他的幻觉称为“异象”，而不是去帮助他？",shape=box,color=blue];
		1435 -> 1440;
	1436 [label="Chat ends.",color=orange];
	1437 [label="Chat ends.",color=orange];
	1438 [label="Update boolean RoatheForgivenessNoGuilt",color=orange];
		1438 -> 1441;
	1439 [label="看到里昂身边的人利用和操纵他，无论这些人是否意识到这一点，我都感到愤怒。这一切都打着“宗教”和“信仰”的旗号。",shape=box,color=blue];
		1439 -> 1440;
	1440 [label="我一直在阅读相关的历史记载。这个……“血色面纱”本可以尝试在几个世纪里将那位 Tenno 从他的 Harrow 体内救出。但他们没有。他们任由他枯萎死去。",shape=box,color=blue];
		1440 -> 1442;
	1441 [label="+10 Chemistry",color=orange];
		1441 -> 1443;
	1442 [label="为什么？为了防范某个……理论上的“虚空之神”。",shape=box,color=blue];
		1442 -> 1444;
		1442 -> 1445;
	1443 [label="Chat ends.",color=orange];
	1444 [label="你认为 Rell 的牺牲毫无意义吗？",shape=box,color=red];
		1444 -> 1446;
	1445 [label="这么多年来，只有 Rell 才能阻止这件事发生。",shape=box,color=red];
		1445 -> 1447;
	1446 [label="不，他是在防范某种东西。但谁知道他把事情搞得这么糟糕？谁知道几个世纪以来，他究竟在滋养了多少自己的恐惧和恐慌？",shape=box,color=blue];
		1446 -> 1448;
	1447 [label="或者说，这么多年来，它唯一的食物来源就是他。",shape=box,color=blue];
		1447 -> 1448;
	1448 [label="概念成形只能显现其所拥有的创造素材。虚空也只能利用其所拥有的素材进行创作。",shape=box,color=blue];
		1448 -> 1449;
	1449 [label="我想知道，那个 Tenno 究竟为它的存在倾注了多少心血？他简直就是痛苦、折磨、背叛、悲伤……以及孤独的化身……",shape=box,color=blue];
		1449 -> 1450;
	1450 [label="还有，他在那地方独自待了数千年，对着虚无说话，必然会变得麻木。在那之后，还能剩下什么？除了虚空无情之物？",shape=box,color=blue];
		1450 -> 1451;
		1450 -> 1452;
	1451 [label="你说的或许是真的。我只是……不确定那个“它”是不是虚空无情之物。",shape=box,color=red];
		1451 -> 1453;
	1452 [label="在它找上 Rell 之前，它就已经非常强大了。如果没有充分的理由，他是不会那样牺牲自己的。",shape=box,color=red];
		1452 -> 1454;
	1453 [label="+10 Chemistry",color=orange];
		1453 -> 1455;
	1454 [label="孩子的噩梦也是一样。在六岁孩子眼里，那是宇宙中最强大的怪物。但对成年人来说，它们只不过是一缕飘到通风口的灰尘，只是太靠近光而已。",shape=box,color=blue];
		1454 -> 1456;
	1455 [label="我所能要求的，不过是希望你承认你并不确定我们究竟在面对什么。",shape=box,color=blue];
		1455 -> 1457;
	1456 [label="我们总是把尘埃夸成高山，只因为我们需要理由去痛苦，去毁灭自己。",shape=box,color=blue];
