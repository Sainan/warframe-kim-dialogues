	"Chat ends." [color=orange];
	j828190482 [label="语音留言：委任",shape=box,color=blue];
		j828190482 -> j4237539808;
	j4237539808 [label="文字记录：在七人众之中，据我所知——我被视为尼托的玩物和男宠。",shape=box,color=blue];
		j4237539808 -> j3435656242;
	j3435656242 [label="战争初期，在她的撺掇下，他们任命我为副摄政王总司令，还以为这只是个玩笑。",shape=box,color=blue];
		j3435656242 -> j3085747803;
	j3085747803 [label="当我带回一场场胜利的消息时，他们的笑声很快变成了庄严的掌声。",shape=box,color=blue];
		j3085747803 -> j2714166303;
	j2714166303 [label="那些比我强的人，他们的鲜血像勋章一样洒在我身上。我暗中为尼托积攒武器。",shape=box,color=blue];
		j2714166303 -> j4120005707;
	j4120005707 [label="这很容易就能做到。我当时的声望太高，没人会怀疑我。",shape=box,color=blue];
		j4120005707 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}