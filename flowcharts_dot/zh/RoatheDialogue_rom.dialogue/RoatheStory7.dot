	2191 [label="文字记录：在七人众之中，据我所知——我被视为尼托的玩物和男宠。",shape=box,color=blue];
		2191 -> 5688;
	5688 [label="战争初期，在她的撺掇下，他们任命我为副摄政王总司令，还以为这只是个玩笑。",shape=box,color=blue];
		5688 -> 5689;
	5689 [label="当我带回一场场胜利的消息时，他们的笑声很快变成了庄严的掌声。",shape=box,color=blue];
		5689 -> 2187;
	2187 [label="那些比我强的人，他们的鲜血像勋章一样洒在我身上。我暗中为尼托积攒武器。",shape=box,color=blue];
		2187 -> 2188;
	2188 [label="这很容易就能做到。我当时的声望太高，没人会怀疑我。",shape=box,color=blue];
		2188 -> 2186;
	2186 [label="Add 1 to HellStory",color=orange];
