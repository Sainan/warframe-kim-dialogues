	"Chat ends." [color=orange];
	j256191473 [label="我不太清楚具体细节，只知道我被叫去制止玛丽和标弃之间的激烈争吵。 ",shape=box,color=blue];
		j256191473 -> j4228802352;
	j4228802352 [label="鸟三伤心欲绝，不肯告诉我谈话的内容，洛德也没有亲眼目睹发生了什么。只有斐波那契告诉我，这“跟英择谛有关”。",shape=box,color=blue];
