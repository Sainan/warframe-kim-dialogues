		4732 -> 4744;
		4732 -> 4745;
	4733 [label="啊，我明白了。问题就在这里。是的，我们的定义并不一致。既然你所描述的这种“虚空无情之物”是一种实体，没错。我们达成共识了。",shape=box,color=blue];
		4733 -> 4746;
