		4671 -> 4676;
	4672 [label="我能否说服你重新考虑我的立场？还是你对这个话题的观点已成定局？",shape=box,color=blue];
		4672 -> 4677;
		4672 -> 4678;
	4674 [label="我真没想到你会如此敏感，亲爱的漂泊者。不过照狂热分子的话说，“C'est la vie”。",shape=box,color=blue];
		4674 -> 4680;
