		4716 -> 4728;
		4716 -> 4729;
	4717 [label="这对我们有什么好处？这世间所有的好处！当然，你向来孤军奋战。从未经历过军队作战的策略。",shape=box,color=blue];
		4717 -> 4730;
	4718 [label="何必呢？你这可怜的家伙。当然，你向来孤军奋战。从未经历过军队作战的策略。",shape=box,color=blue];
		4718 -> 4730;
