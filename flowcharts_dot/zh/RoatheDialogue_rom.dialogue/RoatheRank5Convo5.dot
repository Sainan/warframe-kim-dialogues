	"Chat ends." [color=orange];
	j3706604706 [label="你有没有再考虑过，我关于你的“虚空无情之物”的观点？",shape=box,color=blue];
		j3706604706 -> j1251805817;
		j3706604706 -> j1837838865;
		j3706604706 -> j326958739;
		j3706604706 -> j1551560306;
	j1251805817 [label="我有。我认为英择谛从虚空释放的，是存在于以太中、在我们抵达前就已存在的无形之神。",shape=box,color=red];
		j1251805817 -> j3080532500;
	j1837838865 [label="我有。我觉得你满嘴胡说八道。",shape=box,color=red];
		j1837838865 -> j4099310853;
	j326958739 [label="我有。我觉得你是对的。在英择谛接触它之前，它并不存在。他想找到一位神……于是虚空吐出了某种伪装成神的东西。",shape=box,color=red];
		j326958739 -> j1865898510;
	j1551560306 [label="我有。我认为答案介于两者之间。它或许曾经不是神，但现在是了。英择谛在打开虚空的瞬间便凭空创造了它。",shape=box,color=red];
		j1551560306 -> j350145220;
	j3080532500 [label="它根本无法理解我们是什么。 ",shape=box,color=red];
		j3080532500 -> j3717317562;
	j4099310853 [label="Check boolean RoatheDating",color=orange];
		j4099310853 -> j3124649742 [label=true,color=green];
		j4099310853 -> j965824659 [label=false,color=brown];
	j1865898510 [label="而我们自那以后就不断在喂养这种恐惧。",shape=box,color=red];
		j1865898510 -> j65333704;
	j350145220 [label="正如 Rell 如今既存在又不存在，虚空无情之物从来都不是神，却又始终如一地存在着。",shape=box,color=red];
		j350145220 -> j2010769060;
	j3717317562 [label="我能否说服你重新考虑我的立场？还是你对这个话题的观点已成定局？",shape=box,color=blue];
		j3717317562 -> j2078551697;
		j3717317562 -> j3032416984;
	j3124649742 [label="我真没想到你会如此敏感，亲爱的漂泊者。不过照狂热分子的话说，“C'est la vie”。",shape=box,color=blue];
		j3124649742 -> j650387292;
	j965824659 [label="照狂热分子的话说，“C'est la vie”。",shape=box,color=blue];
		j965824659 -> "Chat ends.";
	j65333704 [label="Boolean DrifterMITWNotGod is now true.",color=orange];
		j65333704 -> j2428020534;
	j2010769060 [label="我恨死你们这些永恒论者了。你们总拿它当万事万物的借口。哲士一旦自以为参透了它，就立刻逃之夭夭。",shape=box,color=blue];
		j2010769060 -> j1808335782;
	j2078551697 [label="你可以试试。",shape=box,color=red];
		j2078551697 -> j1847952936;
	j3032416984 [label="没用的。",shape=box,color=red];
		j3032416984 -> j965824659;
	j650387292 [label="Boolean RoatheNoDate is now true.",color=orange];
		j650387292 -> j776748929;
	j2428020534 [label="+5 Chemistry",color=orange];
		j2428020534 -> j221064405;
	j1808335782 [label="“我没忘记按承诺给你办公室的绿植浇水，它只是正经历着与我们平行的另一条永恒论分支。”",shape=box,color=blue];
		j1808335782 -> j1393607702;
	j1847952936 [label="虽然你今天听起来不太像在谈论哲学，但我还是要试一试。",shape=box,color=blue];
		j1847952936 -> j589790930;
	j776748929 [label="Boolean RoatheDating is now false.",color=orange];
		j776748929 -> j178902881;
	j221064405 [label="太棒了！终于有进展了。吹响号角，敲响钟声，终于有人清醒了！",shape=box,color=blue];
		j221064405 -> j4290145;
	j1393607702 [label="这简直让人抓狂！你们这群可怜虫，能不能在可悲的人生里至少坚持做成一件事？！",shape=box,color=blue];
		j1393607702 -> j3842989149;
		j1393607702 -> j2702423878;
	j589790930 [label="反正我也没什么更好的事情可做。",shape=box,color=blue];
		j589790930 -> j2811133121;
	j178902881 [label="Boolean IsDating is now false.",color=orange];
		j178902881 -> "Chat ends.";
	j4290145 [label="Check boolean RoatheDating",color=orange];
		j4290145 -> j2117823053 [label=true,color=green];
		j4290145 -> j3690392553 [label=false,color=brown];
	j3842989149 [label="我想说的是，它以前不是神，但现在是了。",shape=box,color=red];
		j3842989149 -> j2506109997;
	j2702423878 [label="算了。",shape=box,color=red];
		j2702423878 -> j1704295971;
	j2811133121 [label="我们从头开始讨论如何？你如何定义“神”？",shape=box,color=blue];
		j2811133121 -> j2609009871;
		j2811133121 -> j3003733769;
		j2811133121 -> j3982939914;
	j2117823053 [label="不过我从不怀疑你会转变观点，亲爱的漂泊者。你早已展现出独到的见识。",shape=box,color=blue];
		j2117823053 -> j2499697931;
	j3690392553 [label="不过我从不怀疑你会转变观点，漂泊者。我的说服力向来很强。 ",shape=box,color=blue];
		j3690392553 -> j2499697931;
	j2506109997 [label="明白了。它是阿尔布雷希特从虚空中塑成的“神”。现在我们竟有个“神”在四处游荡。多美妙啊。",shape=box,color=blue];
		j2506109997 -> j694100986;
		j2506109997 -> j1267704435;
	j1704295971 [label="确实。",shape=box,color=blue];
		j1704295971 -> "Chat ends.";
	j2609009871 [label="至高无上的存在。拥有绝对且无可置疑的权威或力量之物。 ",shape=box,color=red];
		j2609009871 -> j1225197920;
	j3003733769 [label="一种超自然的存在或生物，能够掌控造物或人类命运的特定方面。",shape=box,color=red];
		j3003733769 -> j1981432793;
	j3982939914 [label="我不确定。你先说。",shape=box,color=red];
		j3982939914 -> j1382848686;
	j2499697931 [label="现在，要是我们能找到办法说服精神病院里其他疯子就好了……",shape=box,color=blue];
		j2499697931 -> j198559659;
		j2499697931 -> j4068458862;
	j694100986 [label="没错，正是如此。",shape=box,color=red];
		j694100986 -> j407886732;
	j1267704435 [label="是的，但我觉得我们可能陷入了对“神”这个概念的定义之争。",shape=box,color=red];
		j1267704435 -> j730302148;
	j1225197920 [label="而你认为你那虚空无情之物正是这样的至高存在？",shape=box,color=blue];
		j1225197920 -> j824762085;
		j1225197920 -> j3675362321;
	j1981432793 [label="而你所说的虚空无情之物，就​是​这​种​至高​无上​的​存在​或​生物？它掌控着…………某种力量？是无情？",shape=box,color=blue];
		j1981432793 -> j3675362321;
		j1981432793 -> j824762085;
	j1382848686 [label="现在谁是懦夫？很好。容我直截了当地问：",shape=box,color=blue];
		j1382848686 -> j2151028425;
	j198559659 [label="我不明白的是，这对我们有什么好处？",shape=box,color=red];
		j198559659 -> j1805718074;
	j4068458862 [label="何必呢？",shape=box,color=red];
		j4068458862 -> j2857634050;
	j407886732 [label="那么让我直截了当地问吧：你认为“神”会死亡吗？",shape=box,color=blue];
		j407886732 -> j3333093440;
	j730302148 [label="言之有理。你如何定义“神”？",shape=box,color=blue];
		j730302148 -> j457583660;
		j730302148 -> j1089017205;
		j730302148 -> j2883036288;
	j824762085 [label="我不知道。",shape=box,color=red];
		j824762085 -> j284688524;
	j3675362321 [label="是的。我认为是这样。",shape=box,color=red];
		j3675362321 -> j3323216182;
	j2151028425 [label="你认为“神”会死吗？",shape=box,color=blue];
		j2151028425 -> j931387588;
		j2151028425 -> j4166527081;
		j2151028425 -> j11910682;
		j2151028425 -> j2390607521;
		j2151028425 -> j1272033983;
	j1805718074 [label="这对我们有什么好处？这世间所有的好处！当然，你向来孤军奋战。从未经历过军队作战的策略。",shape=box,color=blue];
		j1805718074 -> j766905779;
	j2857634050 [label="何必呢？你这可怜的家伙。当然，你向来孤军奋战。从未经历过军队作战的策略。",shape=box,color=blue];
		j2857634050 -> j766905779;
	j3333093440 [label="“神”是否可能以任何形式消亡？",shape=box,color=blue];
		j3333093440 -> j2151028425;
	j457583660 [label="我不确定。你先说。",shape=box,color=red];
		j457583660 -> j1816248124;
	j1089017205 [label="一种超自然的存在或生物，能够掌控造物或人类命运的特定方面。",shape=box,color=red];
		j1089017205 -> j200092671;
	j2883036288 [label="一个超越我们理解范畴的存在。一个存在于我们之外的维度中的生物，因此它并不“像我们一样”存在。",shape=box,color=red];
		j2883036288 -> j2144108667;
	j284688524 [label="别再兜圈子了。容我直截了当地问：",shape=box,color=blue];
		j284688524 -> j2151028425;
	j3323216182 [label="Check boolean RoatheDating",color=orange];
		j3323216182 -> j1056197096 [label=true,color=green];
		j3323216182 -> j1483205463 [label=false,color=brown];
	j931387588 [label="我希望把他送回他来的地方。",shape=box,color=red];
		j931387588 -> j1105912074;
	j4166527081 [label="我不知道。而且我认为没有人会知道。",shape=box,color=red];
		j4166527081 -> j1133276476;
	j11910682 [label="不。我不这么认为。考虑到物质的不灭性之类的。",shape=box,color=red];
		j11910682 -> j1663171078;
	j2390607521 [label="是的，我认为会。否则，我们早就被他们的数量彻底淹没了，对吧？",shape=box,color=red];
		j2390607521 -> j3744069481;
	j1272033983 [label="我真心希望如此。",shape=box,color=red];
		j1272033983 -> j3129159766;
	j766905779 [label="知己知彼，百战不殆。现在，我有个问题要问你。你认为这生物能被杀死吗？",shape=box,color=blue];
		j766905779 -> j2199100192;
		j766905779 -> j335413460;
