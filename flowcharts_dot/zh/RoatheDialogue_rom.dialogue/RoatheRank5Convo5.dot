	4675 [label="Update boolean DrifterMITWNotGod",color=orange];
		4675 -> 4681;
	4676 [label="我恨死你们这些永恒论者了。你们总拿它当万事万物的借口。哲士一旦自以为参透了它，就立刻逃之夭夭。",shape=box,color=blue];
		4676 -> 4682;
