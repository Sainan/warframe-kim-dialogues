	4662 [label="Chat ends.",color=orange];
	4664 [label="我有。我认为英择谛从虚空释放的，是存在于以太中、在我们抵达前就已存在的无形之神。",shape=box,color=red];
		4664 -> 4668;
	4665 [label="我有。我觉得你满嘴胡说八道。",shape=box,color=red];
		4665 -> 4669;
	4666 [label="我有。我觉得你是对的。在英择谛接触它之前，它并不存在。他想找到一位神……于是虚空吐出了某种伪装成神的东西。",shape=box,color=red];
		4666 -> 4670;
	4667 [label="我有。我认为答案介于两者之间。它或许曾经不是神，但现在是了。英择谛在打开虚空的瞬间便凭空创造了它。",shape=box,color=red];
