	j1816248124 [label="现在谁是懦夫？那好。容我直截了当地问：",shape=box,color=blue];
		j1816248124 -> j3333093440;
	j200092671 [label="而你所说的虚空无情之物，是至高无上的存在还是某种生物？它掌控着虚空无情之物…………某种力量？是无情？",shape=box,color=blue];
		j200092671 -> j3551240390;
		j200092671 -> j1940617525;
	j2144108667 [label="啊，我明白了。问题就在这里。是的，我们的定义并不一致。既然你所描述的这种“虚空无情之物”是一种实体，没错。我们达成共识了。",shape=box,color=blue];
		j2144108667 -> j2325090280;
	j1056197096 [label="令人失望。我还以为你比这更聪明些。但容我直截了当地问：",shape=box,color=blue];
		j1056197096 -> j2151028425;
	j1483205463 [label="令人失望。但容我直截了当地问：",shape=box,color=blue];
		j1483205463 -> j2151028425;
	j1105912074 [label="和平主义者。为什么总要有个和平主义者。",shape=box,color=blue];
		j1105912074 -> j2492321075;
	j1133276476 [label="因此，你以谦逊的无知暗示，我们都在黑暗中摸索前行。",shape=box,color=blue];
		j1133276476 -> j4108793302;
	j1663171078 [label="哦，太好了。你认为“神”不会死！",shape=box,color=blue];
		j1663171078 -> j2492321075;
	j3744069481 [label="你的逻辑是……神会死亡因为……“神”就像泡博？",shape=box,color=blue];
		j3744069481 -> j608276881;
	j3129159766 [label="这答案显而易见，但听我说，漂泊者。我需要你保持专注。",shape=box,color=blue];
		j3129159766 -> j608276881;
	j2199100192 [label="说实话，我真不知道。",shape=box,color=red];
		j2199100192 -> j2720460047;
