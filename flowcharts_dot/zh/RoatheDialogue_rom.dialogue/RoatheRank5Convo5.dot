		4694 -> 4702;
	4695 [label="Chat ends.",color=orange];
	4696 [label="不过我从不怀疑你会转变观点，亲爱的漂泊者。你早已展现出独到的见识。",shape=box,color=blue];
		4696 -> 4703;
	4697 [label="不过我从不怀疑你会转变观点，漂泊者。我的说服力向来很强。 ",shape=box,color=blue];
		4697 -> 4703;
	4698 [label="明白了。它是阿尔布雷希特从虚空中塑成的“神”。现在我们竟有个“神”在四处游荡。多美妙啊。",shape=box,color=blue];
		4698 -> 4704;
