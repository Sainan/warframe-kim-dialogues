digraph {
	1042 [label="RoatheRank2Convo3 begins.",color=orange];
		1042 -> 1043;
	1043 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1043 -> 1044 [label=true,color=green];
		1043 -> 1045 [label=false,color=brown];
	1044 [label="Check boolean RoatheKnowsReset2",color=orange];
		1044 -> 1046 [label=true,color=green];
		1044 -> 1047 [label=false,color=brown];
	1045 [label="Chat ends.",color=orange];
	1046 [label="我知道你可能听过这话，可今天我不在乎——我实在没那个耐心。",shape=box,color=blue];
		1046 -> 1047;
	1047 [label="我认为导致奥罗金帝国覆灭的原因在于那层层叠叠的隔离，人们始终无法看清帝国内部的情况。",shape=box,color=blue];
		1047 -> 1048;
		1047 -> 1049;
		1047 -> 1050;
	1048 [label="为什么这么说？",shape=box,color=red];
		1048 -> 1051;
	1049 [label="太没有人情味了吗？",shape=box,color=red];
		1049 -> 1052;
	1050 [label="[结束]",shape=box,color=red];
		1050 -> 1053;
	1051 [label="想象一个建立在这样的认知之上的社会：无论从任何意义上说，你都永远是安全的。受到保护的。即使面对死亡的巨大阴影。",shape=box,color=blue];
		1051 -> 1054;
	1052 [label="+5 Chemistry",color=orange];
		1052 -> 1055;
	1053 [label="Chat ends.",color=orange];
	1054 [label="那里没有任何东西能伤害你。",shape=box,color=blue];
		1054 -> 1056;
	1055 [label="确实如此。距离危险和现实太远了。",shape=box,color=blue];
		1055 -> 1051;
	1056 [label="这会导致一种无聊，开始编织出自己的危险，篡位者。政治。宫廷阴谋。我们突然间又想出了新的妙招来置自身于险境——毕竟，旧的那些招数早已被淘汰了。",shape=box,color=blue];
		1056 -> 1057;
		1056 -> 1058;
	1057 [label="怎么突然提起这个？",shape=box,color=red];
		1057 -> 1059;
	1058 [label="哪一种更糟？被人开枪射击，还是不得不时刻提防背后？",shape=box,color=red];
		1058 -> 1060;
	1059 [label="我被迫滞留“高卢”的这段日子里，鲜有有趣或是愉悦的片段。食物算是其中之一。然而第二件……便是那些风暴。",shape=box,color=blue];
		1059 -> 1061;
	1060 [label="哈！说实话我难以抉择——这两种滋味我都尝遍了。你呢？",shape=box,color=blue];
		1060 -> 1062;
		1060 -> 1063;
	1061 [label="在我作为奥罗金人的漫长岁月里，从未见过如此惊人的雷暴。它们撼动大地，震得木窗哐当作响。即便在尘封墓穴深处——他们囚禁我们的地方——我也能听见它们的轰鸣。",shape=box,color=blue];
		1061 -> 1064;
	1062 [label="我喜欢清楚地知道谁是我的敌人，简单明了。让他们放马过来吧。",shape=box,color=red];
		1062 -> 1065;
	1063 [label="被人开枪射击。我更喜欢能暗中操纵来完成任务。这样我就能从容行事。",shape=box,color=red];
		1063 -> 1066;
	1064 [label="每当雷暴席卷城市，我就会爬上钟楼，尽可能地靠近。我渴望感受空气中的电流——倾盆大雨打在皮肤上的感觉。",shape=box,color=blue];
		1064 -> 1067;
		1064 -> 1068;
		1064 -> 1069;
	1065 [label="Add 1 to Thermostat",color=orange];
		1065 -> 1070;
	1066 [label="Add -1 to Thermostat",color=orange];
		1066 -> 1071;
	1067 [label="那不是很危险吗？",shape=box,color=red];
		1067 -> 1072;
	1068 [label="听起来太棒了。",shape=box,color=red];
		1068 -> 1073;
	1069 [label="玛丽和里昂对你偷偷溜走这件事是什么看法？",shape=box,color=red];
		1069 -> 1074;
	1070 [label="我明白你的意思，不得不承认这种简单性确实有其可取之处。当敌人把枪口抵在你脸上时，你很难把他们认作其他什么东西。",shape=box,color=blue];
		1070 -> 1075;
	1071 [label="嗯，妙不可言，不是吗？精心策划的布局，巧妙铺陈的计谋，最终水到渠成？看着所有棋子各就各位……实在妙趣横生。",shape=box,color=blue];
		1071 -> 1075;
	1072 [label="这正是冒险的意义所在！那种原始力量的震撼难以言表。不，远不止于此——那是真实的力量。我凝视着翻腾的乌云间肆虐的闪电，终于见识到祖先们毕生追寻却未能驾驭的力量。",shape=box,color=blue];
		1072 -> 1076;
	1073 [label="+5 Chemistry",color=orange];
		1073 -> 1077;
	1074 [label="你写的这些话，就好像我想过似的。如果你问的是他们有没有追来，他们没有。神父大概根本不在乎我被雷电击中而死。至于玛丽？她多半正忙着膜拜她的虚假偶像们。太阳神还是阿尔布雷希特，随你挑。",shape=box,color=blue];
		1074 -> 1078;
	1075 [label="+5 Chemistry",color=orange];
		1075 -> 1079;
	1076 [label="更何况我深知身处此地可能丧命，而附近没有赤毒能让我复活。更重要的是，神圣的赤毒对我这副扭曲变形的躯体毫无作用。 ",shape=box,color=blue];
		1076 -> 1080;
	1077 [label="确实如此！那种原始力量的震撼难以言表。不，远不止于此——那是真实的力量。我凝视着翻腾的乌云间肆虐的闪电，终于见识到祖先们毕生追寻却未能驾驭的力量。",shape=box,color=blue];
		1077 -> 1076;
	1078 [label="但感受那般原始的力量？不，远不止于此——那是真实的力量。我凝视着翻腾的乌云间肆虐的闪电，终于见识到祖先们毕生追寻却未能驾驭的力量。",shape=box,color=blue];
		1078 -> 1076;
	1079 [label="然而我发现，就像生活中的一切事物，适度与兼容并蓄才是成功的真谛。如果沉溺于其中一方，就有可能放弃另一方。",shape=box,color=blue];
		1079 -> 1081;
	1080 [label="这让我感到恐惧。漂泊者，是恐惧。这恐怕是我……几个世纪以来的第一次？",shape=box,color=blue];
		1080 -> 1082;
		1080 -> 1083;
	1081 [label="恐怕正是如此，我们才造就了 Ballas 和尼托这样的存在。操纵者与血之女王。呸。",shape=box,color=blue];
		1081 -> 1084;
	1082 [label="你害怕死亡？",shape=box,color=red];
		1082 -> 1085;
	1083 [label="你做了什么？",shape=box,color=red];
		1083 -> 1086;
	1084 [label="不过我来这里是为了谈谈风暴。",shape=box,color=blue];
		1084 -> 1059;
	1085 [label="是的，还真是这样！而且相当强烈，我得说。那一刻我才发现这个事实。我并不是畏惧死后的世界，漂泊者。只是还没有准备好结束生命。我的旅程尚未终结。",shape=box,color=blue];
		1085 -> 1087;
	1086 [label="我爬上那个合成兽像边上的石栏杆，张开双臂，然后……我笑了。我对着风暴放声大笑。",shape=box,color=blue];
		1086 -> 1088;
	1087 [label="这本身就是个惊人的发现。我爬上那个合成兽像边上的石栏杆，张开双臂，然后……我笑了。我对着风暴放声大笑。",shape=box,color=blue];
		1087 -> 1089;
	1088 [label="因为我突然明白，我并不是畏惧死后的世界，漂泊者。只是还没有准备好结束生命。我的旅程尚未终结。",shape=box,color=blue];
		1088 -> 1089;
	1089 [label="纵使经历了一切。纵使 Tau 已成荒芜。纵使奥罗金帝国的覆灭已成定局。纵使我的躯体被扭曲成……这般模样。纵使被抛回过去，任凭命运摆布。",shape=box,color=blue];
		1089 -> 1090;
	1090 [label="我知道终会找到归途。回到这个时代。回到这个地方。回到阿尔布雷希特珍藏所有至宝的地方。",shape=box,color=blue];
		1090 -> 1091;
	1091 [label="+5 Chemistry",color=orange];
		1091 -> 1092;
	1092 [label="因为我的人生尚未终结。但以虚空之名，我一定会确保他的人生就此终结。",shape=box,color=blue];
		1092 -> 1093;
	1093 [label="Update boolean RoatheEntrati1",color=orange];
		1093 -> 1094;
	1094 [label="Chat ends.",color=orange];
}