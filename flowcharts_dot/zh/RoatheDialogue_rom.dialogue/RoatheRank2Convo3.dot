digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank2Convo3 begins." [color=orange];
		"RoatheRank2Convo3 begins." -> j4208251187;
	j4208251187 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		j4208251187 -> j3438455715 [label=true,color=green];
		j4208251187 -> "Chat ends." [label=false,color=brown];
	j3438455715 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3438455715 -> j32851408 [label=true,color=green];
		j3438455715 -> j1797267680 [label=false,color=brown];
	"Chat ends." [color=orange];
	j32851408 [label="我知道你可能听过这话，可今天我不在乎——我实在没那个耐心。",shape=box,color=blue];
		j32851408 -> j1797267680;
	j1797267680 [label="我认为导致奥罗金帝国覆灭的原因在于那层层叠叠的隔离，人们始终无法看清帝国内部的情况。",shape=box,color=blue];
		j1797267680 -> j3256575853;
		j1797267680 -> j375224614;
		j1797267680 -> j1038552372;
	j3256575853 [label="为什么这么说？",shape=box,color=red];
		j3256575853 -> j1159960114;
	j375224614 [label="太没有人情味了吗？",shape=box,color=red];
		j375224614 -> j1538528711;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j1159960114 [label="想象一个建立在这样的认知之上的社会：无论从任何意义上说，你都永远是安全的。受到保护的。即使面对死亡的巨大阴影。",shape=box,color=blue];
		j1159960114 -> j370522828;
	j1538528711 [label="+5 Chemistry",color=orange];
		j1538528711 -> j663269384;
	j370522828 [label="那里没有任何东西能伤害你。",shape=box,color=blue];
		j370522828 -> j3922587858;
	j663269384 [label="确实如此。距离危险和现实太远了。",shape=box,color=blue];
		j663269384 -> j1159960114;
	j3922587858 [label="这会导致一种无聊，开始编织出自己的危险，篡位者。政治。宫廷阴谋。我们突然间又想出了新的妙招来置自身于险境——毕竟，旧的那些招数早已被淘汰了。",shape=box,color=blue];
		j3922587858 -> j3378332900;
		j3922587858 -> j3879027553;
	j3378332900 [label="怎么突然提起这个？",shape=box,color=red];
		j3378332900 -> j593016537;
	j3879027553 [label="哪一种更糟？被人开枪射击，还是不得不时刻提防背后？",shape=box,color=red];
		j3879027553 -> j3980392966;
	j593016537 [label="我被迫滞留“高卢”的这段日子里，鲜有有趣或是愉悦的片段。食物算是其中之一。然而第二件……便是那些风暴。",shape=box,color=blue];
		j593016537 -> j3497626983;
	j3980392966 [label="哈！说实话我难以抉择——这两种滋味我都尝遍了。你呢？",shape=box,color=blue];
		j3980392966 -> j2958545382;
		j3980392966 -> j2030332257;
	j3497626983 [label="在我作为奥罗金人的漫长岁月里，从未见过如此惊人的雷暴。它们撼动大地，震得木窗哐当作响。即便在尘封墓穴深处——他们囚禁我们的地方——我也能听见它们的轰鸣。",shape=box,color=blue];
		j3497626983 -> j3042790155;
	j2958545382 [label="我喜欢清楚地知道谁是我的敌人，简单明了。让他们放马过来吧。",shape=box,color=red];
		j2958545382 -> j4205451475;
	j2030332257 [label="被人开枪射击。我更喜欢能暗中操纵来完成任务。这样我就能从容行事。",shape=box,color=red];
		j2030332257 -> j597963763;
	j3042790155 [label="每当雷暴席卷城市，我就会爬上钟楼，尽可能地靠近。我渴望感受空气中的电流——倾盆大雨打在皮肤上的感觉。",shape=box,color=blue];
		j3042790155 -> j87322289;
		j3042790155 -> j3265675662;
		j3042790155 -> j226637767;
	j4205451475 [label="Add 1 to Thermostat counter",color=orange];
		j4205451475 -> j3272049771;
	j597963763 [label="Add -1 to Thermostat counter",color=orange];
		j597963763 -> j570491768;
	j87322289 [label="那不是很危险吗？",shape=box,color=red];
		j87322289 -> j2237726315;
	j3265675662 [label="听起来太棒了。",shape=box,color=red];
		j3265675662 -> j2048146307;
	j226637767 [label="玛丽和里昂对你偷偷溜走这件事是什么看法？",shape=box,color=red];
		j226637767 -> j4036156682;
	j3272049771 [label="我明白你的意思，不得不承认这种简单性确实有其可取之处。当敌人把枪口抵在你脸上时，你很难把他们认作其他什么东西。",shape=box,color=blue];
		j3272049771 -> j395959281;
	j570491768 [label="嗯，妙不可言，不是吗？精心策划的布局，巧妙铺陈的计谋，最终水到渠成？看着所有棋子各就各位……实在妙趣横生。",shape=box,color=blue];
		j570491768 -> j395959281;
	j2237726315 [label="这正是冒险的意义所在！那种原始力量的震撼难以言表。不，远不止于此——那是真实的力量。我凝视着翻腾的乌云间肆虐的闪电，终于见识到祖先们毕生追寻却未能驾驭的力量。",shape=box,color=blue];
		j2237726315 -> j3513947928;
	j2048146307 [label="+5 Chemistry",color=orange];
		j2048146307 -> j3498946928;
	j4036156682 [label="你写的这些话，就好像我想过似的。如果你问的是他们有没有追来，他们没有。神父大概根本不在乎我被雷电击中而死。至于玛丽？她多半正忙着膜拜她的虚假偶像们。太阳神还是阿尔布雷希特，随你挑。",shape=box,color=blue];
		j4036156682 -> j3279658298;
	j395959281 [label="+5 Chemistry",color=orange];
		j395959281 -> j1638940361;
	j3513947928 [label="更何况我深知身处此地可能丧命，而附近没有赤毒能让我复活。更重要的是，神圣的赤毒对我这副扭曲变形的躯体毫无作用。 ",shape=box,color=blue];
		j3513947928 -> j2517009963;
	j3498946928 [label="确实如此！那种原始力量的震撼难以言表。不，远不止于此——那是真实的力量。我凝视着翻腾的乌云间肆虐的闪电，终于见识到祖先们毕生追寻却未能驾驭的力量。",shape=box,color=blue];
		j3498946928 -> j3513947928;
	j3279658298 [label="但感受那般原始的力量？不，远不止于此——那是真实的力量。我凝视着翻腾的乌云间肆虐的闪电，终于见识到祖先们毕生追寻却未能驾驭的力量。",shape=box,color=blue];
		j3279658298 -> j3513947928;
	j1638940361 [label="然而我发现，就像生活中的一切事物，适度与兼容并蓄才是成功的真谛。如果沉溺于其中一方，就有可能放弃另一方。",shape=box,color=blue];
		j1638940361 -> j536068418;
	j2517009963 [label="这让我感到恐惧。漂泊者，是恐惧。这恐怕是我……几个世纪以来的第一次？",shape=box,color=blue];
		j2517009963 -> j2497857643;
		j2517009963 -> j739597280;
	j536068418 [label="恐怕正是如此，我们才造就了 Ballas 和尼托这样的存在。操纵者与血之女王。呸。",shape=box,color=blue];
		j536068418 -> j48999171;
	j2497857643 [label="你害怕死亡？",shape=box,color=red];
		j2497857643 -> j795593377;
	j739597280 [label="你做了什么？",shape=box,color=red];
		j739597280 -> j4280386436;
	j48999171 [label="不过我来这里是为了谈谈风暴。",shape=box,color=blue];
		j48999171 -> j593016537;
	j795593377 [label="是的，还真是这样！而且相当强烈，我得说。那一刻我才发现这个事实。我并不是畏惧死后的世界，漂泊者。只是还没有准备好结束生命。我的旅程尚未终结。",shape=box,color=blue];
		j795593377 -> j1904062928;
	j4280386436 [label="我爬上那个合成兽像边上的石栏杆，张开双臂，然后……我笑了。我对着风暴放声大笑。",shape=box,color=blue];
		j4280386436 -> j384647917;
	j1904062928 [label="这本身就是个惊人的发现。我爬上那个合成兽像边上的石栏杆，张开双臂，然后……我笑了。我对着风暴放声大笑。",shape=box,color=blue];
		j1904062928 -> j3292041379;
	j384647917 [label="因为我突然明白，我并不是畏惧死后的世界，漂泊者。只是还没有准备好结束生命。我的旅程尚未终结。",shape=box,color=blue];
		j384647917 -> j3292041379;
	j3292041379 [label="纵使经历了一切。纵使 Tau 已成荒芜。纵使奥罗金帝国的覆灭已成定局。纵使我的躯体被扭曲成……这般模样。纵使被抛回过去，任凭命运摆布。",shape=box,color=blue];
		j3292041379 -> j2457659065;
	j2457659065 [label="我知道终会找到归途。回到这个时代。回到这个地方。回到阿尔布雷希特珍藏所有至宝的地方。",shape=box,color=blue];
		j2457659065 -> j3878277523;
	j3878277523 [label="+5 Chemistry",color=orange];
		j3878277523 -> j326875469;
	j326875469 [label="因为我的人生尚未终结。但以虚空之名，我一定会确保他的人生就此终结。",shape=box,color=blue];
		j326875469 -> j3359792563;
	j3359792563 [label="Boolean RoatheEntrati1 is now true.",color=orange];
		j3359792563 -> "Chat ends.";
}