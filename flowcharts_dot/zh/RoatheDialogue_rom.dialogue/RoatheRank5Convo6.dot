	j2437223770 [label="玛丽是什么反应？",shape=box,color=red];
		j2437223770 -> j761478386;
	j3738218908 [label="尤其是里昂。我想他理解直面过去和我们做出的决定有多么艰难。请原谅这个双关语，看看那眼罩吧。",shape=box,color=blue];
		j3738218908 -> j32725969;
	j1368351552 [label="他坐在我旁边，告诉我自从英择谛给他注射血清后，他就一直在质疑自己的信仰。他为这份质疑感到羞愧，更后悔当初注射了血清。",shape=box,color=blue];
		j1368351552 -> j3705067728;
	j2279252693 [label="我本以为他们会用嘲讽来迎接我的耻辱，用“恶魔终于被击垮了”讥诮来嘲弄我。结果却恰恰相反。他们几乎没提过这件事。",shape=box,color=blue];
		j2279252693 -> j187124383;
	j761478386 [label="出乎我的意料。她什么也没说。她只是……抱住了我。 ",shape=box,color=blue];
		j761478386 -> j598317519;
	j32725969 [label="Check boolean LyonConfession2",color=orange];
		j32725969 -> j2540400467 [label=true,color=green];
		j32725969 -> j3062291196 [label=true,color=green];
		j32725969 -> j3062291196 [label=false,color=brown];
	j3705067728 [label="最重要的是，他多么希望能够忘掉这一切。也许在更深层面上，我们三人并不完全相同。",shape=box,color=blue];
		j3705067728 -> j1054783957;
		j3705067728 -> j175780582;
	j187124383 [label="尤其是玛丽。我想她明白，一再就过去的事与我争执没有益处。",shape=box,color=blue];
		j187124383 -> j3137425038;
	j598317519 [label="Evaluate expressions",color=orange];
		j598317519 -> j3853946455 [label="RoatheRedeemed",color=purple];
		j598317519 -> j2692829807 [label="RoatheVillain",color=purple];
		j598317519 -> j984897571 [label="false",color=purple];
	j2540400467 [label="我想他也明白成为社会产物和环境产物是什么滋味。他对你过去的经历可能比你想象中更感同身受。",shape=box,color=red];
		j2540400467 -> j1045488346;
	j3062291196 [label="我只是单纯地为你们俩能建立任何形式的友谊而感到高兴。哪怕这只是暂时的休战。 ",shape=box,color=red];
