		j1826066742 -> j3794154050;
		j1826066742 -> j2437223770;
	j886158285 [label="我本以为他们会用嘲讽来迎接我的耻辱，用“恶魔终于被击垮了”讥诮来嘲弄我。结果却恰恰相反。他们几乎没提过这件事。",shape=box,color=blue];
		j886158285 -> j3738218908;
	j2408214028 [label="出乎我的意料。有天晚上我一个人静静看书的时候，他主动走了过来。",shape=box,color=blue];
		j2408214028 -> j1368351552;
