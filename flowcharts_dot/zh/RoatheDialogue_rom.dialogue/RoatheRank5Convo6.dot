	4917 [label="他几乎没提过这件事。对此我深表感激。我本以为会听到嘲笑和讥讽。“恶魔终于被击垮了”。结果却恰恰相反。他们照常生活，仿佛没什么变化。",shape=box,color=blue];
		4917 -> 4882;
	4918 [label="昔日的罗瑟本会趁机摘除她的肾脏，但我发现自己已经不再有这种想法了。 ",shape=box,color=blue];
		4918 -> 4926;
	4919 [label="我竭尽全力控制才没有去摘除她的肾脏。但她只是想给我一点安慰。",shape=box,color=blue];
		4919 -> 4927;
	4920 [label="她只是想给我一点安慰。",shape=box,color=blue];
		4920 -> 4928;
	4921 [label="确实如此。这都要感谢你，对吧？",shape=box,color=blue];
		4921 -> 4929;
	4922 [label="我认为最终它会证明远不止于此。即便我厌恶这个事实。毕竟，我终究无法摆脱与他们纠缠的命运。",shape=box,color=blue];
		4922 -> 4929;
	4923 [label="他坐在我旁边，告诉我自从英择谛给他注射血清后，他就一直在质疑自己的信仰。他为这份质疑感到羞愧，更后悔当初注射了血清。",shape=box,color=blue];
		4923 -> 4930;
	4924 [label="自那以后？",shape=box,color=blue];
		4924 -> 4931;
	4925 [label="一个已经支离破碎的人，却始终没有彻底崩塌。",shape=box,color=blue];
		4925 -> 4932;
	4926 [label="在我凄惨的一生中，第一次坦然接受了这份简单的安慰。",shape=box,color=blue];
		4926 -> 4927;
	4927 [label="她只是用这样一种简单的方式告诉我，或许她根本没有我这么在乎这件事。同时她为我因此承受的痛苦感到抱歉。",shape=box,color=blue];
		4927 -> 4928;
	4928 [label="自那以后？",shape=box,color=blue];
		4928 -> 4933;
	4929 [label="那位太阳神​修女。如果要我以一句话作结，那就是：她的仁慈如同时间本身般无穷无尽。",shape=box,color=blue];
		4929 -> 4934;
	4930 [label="最重要的是，他多么希望能够忘掉这一切。也许在更深层面上，我们三人并不完全相同。",shape=box,color=blue];
		4930 -> 4924;
