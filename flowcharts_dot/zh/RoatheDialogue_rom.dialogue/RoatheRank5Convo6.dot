	j1385133995 [label="有天晚上我一个人静静看书的时候，他主动走了过来。",shape=box,color=blue];
		j1385133995 -> j3342442708;
	j1794679053 [label="我当然也回抱了她。我是奥罗金人，但我不是怪物。",shape=box,color=blue];
		j1794679053 -> j2216243546;
	j796247035 [label="那位神父。如果要我以一句话作结，那就是：他的韧性如同时间本身般无穷无尽。 ",shape=box,color=blue];
		j796247035 -> j2776120940;
	j1895458443 [label="他几乎没提过这件事。对此我深表感激。我本以为会听到嘲笑和讥讽。“恶魔终于被击垮了”。结果却恰恰相反。他们照常生活，仿佛没什么变化。",shape=box,color=blue];
		j1895458443 -> j3738218908;
	j2249219359 [label="昔日的罗瑟本会趁机摘除她的肾脏，但我发现自己已经不再有这种想法了。 ",shape=box,color=blue];
		j2249219359 -> j4276587731;
	j1925588373 [label="我竭尽全力控制才没有去摘除她的肾脏。但她只是想给我一点安慰。",shape=box,color=blue];
