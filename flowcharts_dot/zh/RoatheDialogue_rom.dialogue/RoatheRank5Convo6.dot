		j2813753334 -> j3294951910 [label="RoatheVillain",color=purple];
		j2813753334 -> j214169093 [label="RoatheRedeemed",color=purple];
		j2813753334 -> j828074756 [label="false",color=purple];
	j1512838608 [label="我对玛丽怎么看？除了想说服你让她跟我们住上一两晚，亲爱的漂泊者？（开玩笑的。开玩笑的。）",shape=box,color=blue];
		j1512838608 -> j2758033101;
	j2912177284 [label="我对玛丽怎么看？除了想说服你让我加入一两晚之外？（开玩笑的。开玩笑的。）",shape=box,color=blue];
		j2912177284 -> j3796813264;
	j3561907118 [label="你究竟是如何说服她改变对阿尔布雷希特纯洁性的看法？你可真是个“奇迹制造者”。或许他们不该崇拜太阳神和月神，而该崇拜你才对。",shape=box,color=blue];
		j3561907118 -> j3635268229;
	j944448848 [label="我从未意识到她每日都在忍受着痛苦。她却将痛苦隐藏得仿佛不存在一般。直到她向你倾诉，才提起这件事。你已某种方式弥合了我们之间的隔阂。",shape=box,color=blue];
		j944448848 -> j1280807428;
	j2385031725 [label="直到最近我才知道她的成长经历。她从未向我提起过自己的故事，直到她向你倾诉。你弥合了我们之间某种隔阂。",shape=box,color=blue];
		j2385031725 -> j2536389411;
	j2444812964 [label="一如往常。我每时每刻都在竭力克制自己，不让自己为压过她那声音的绝望而用爪子撕下自己的脸。",shape=box,color=blue];
		j2444812964 -> "Chat ends.";
	j3323437136 [label="现在好多了，毕竟有人能让我发泄不满。但说真的，我们之间的紧张关系确实缓和多了。",shape=box,color=blue];
		j3323437136 -> j4178894268;
	j475833783 [label="我可没跟里昂“打得火热”，对吧？哈！抱歉开了个糟糕的玩笑。我实在忍不住，你把这梗铺得太明显了。",shape=box,color=blue];
		j475833783 -> j1972459047;
	j2075315164 [label="比​你们​俩表面上​的​相处​看​起来​要​好​得​多。你到底怎么搞砸了？他需要的不过是个愿意倾听的人。 ",shape=box,color=blue];
		j2075315164 -> j4174479910;
	j2596742520 [label="我们之间的紧张关系确实缓和多了，特别是自从你让他有信心说出自己一直困扰的事情之后。",shape=box,color=blue];
		j2596742520 -> j119567306;
	j3489110359 [label="我们之间的紧张关系确实缓和多了，特别是自从你让他有信心说出自己一直困扰的事情之后。",shape=box,color=blue];
		j3489110359 -> j683279453;
	j3997268181 [label="一如往常。我每时每刻都在竭力克制自己，不让自己为压过他那声音的绝望而用爪子撕下自己的脸。",shape=box,color=blue];
		j3997268181 -> "Chat ends.";
	j3294951910 [label="我承认自己正渐渐觉得他们稍微好相处些了。我想这主要因为他们也在一点点放弃我。",shape=box,color=blue];
		j3294951910 -> j385858971;
	j214169093 [label="我承认自己正渐渐觉得他们稍微好相处些了。我想这或许与我最近的发现有关。",shape=box,color=blue];
		j214169093 -> j881909312;
	j828074756 [label="我时常在想，尽管身为原型战甲，我无法借助深溯池来恢复记忆……",shape=box,color=blue];
		j828074756 -> j593055892;
	j2758033101 [label="我不知道她有没有意识到，我的挑衅已从真诚的恼怒转变为愉快的戏谑？",shape=box,color=blue];
		j2758033101 -> j2983240409;
	j3796813264 [label="我必须承认，我一点也不怪你。而且不仅仅是因为她美得惊人。我又不是瞎子。那位女士身上蕴藏的慈悲心，远超我对她这个年纪的预期。",shape=box,color=blue];
		j3796813264 -> j2758033101;
	j3635268229 [label="呸。正是这种言论导致了奥罗金帝国的崛起。这个星系绝不能重蹈覆辙。",shape=box,color=blue];
		j3635268229 -> j2758033101;
	j1280807428 [label="我承认自己正是她所说的愚人之一，无法理解有人竟能日复一日地如此生活。",shape=box,color=blue];
		j1280807428 -> j2871362033;
	j2536389411 [label="想到她的家人竟将她抛弃在街头。她。玛丽。那个玛丽。那个心怀超乎寻常慈悲的人？！",shape=box,color=blue];
		j2536389411 -> j998059465;
	j4178894268 [label="他们知道我的……秘密。知道我自愿注射血清的真相。",shape=box,color=blue];
		j4178894268 -> j1160102591;
		j4178894268 -> j2977745806;
	j1972459047 [label="我佩服你敢于面对那个可怜的疯子。他需要陪伴。也需要同情。",shape=box,color=blue];
		j1972459047 -> j3042091287;
	j4174479910 [label="可你却将他拒之门外。真该死。",shape=box,color=blue];
		j4174479910 -> "Chat ends.";
	j119567306 [label="他向我提起那个他一直听见的 Tenno 小孩。以及他如今已听不见那声音了。",shape=box,color=blue];
		j119567306 -> j2839785312;
	j683279453 [label="我对他遭受的一切竟知之甚少。直到他向你倾诉后，他才终于愿意告诉我。 ",shape=box,color=blue];
		j683279453 -> j780427993;
	j385858971 [label="开个玩笑。尽管我重新下决心要屏蔽他们对我人生抉择的批评，却莫名地对他们越来越喜欢了。",shape=box,color=blue];
		j385858971 -> j3032697116;
		j385858971 -> j3228674246;
	j881909312 [label="我本以为他们会用嘲讽来回应我的忏悔，用“终于醒悟了”或“早该如此”之类的讥诮来嘲弄我。结果却恰恰相反。他们几乎没提过这件事。",shape=box,color=blue];
		j881909312 -> j281541717;
	j593055892 [label="……但这未必能阻止我沉溺其中。",shape=box,color=blue];
		j593055892 -> "Chat ends.";
	j2983240409 [label="我希望如此。捉弄她实在太有趣了。看着她火冒三丈地用母语朝我吼叫，成了我最近最爱的消遣。",shape=box,color=blue];
		j2983240409 -> j3247195894;
	j2871362033 [label="她怎么还能保持如此镇定？更别说心存怜悯了？换作是我，恐怕早就像那位神父一样发疯了。",shape=box,color=blue];
		j2871362033 -> j2758033101;
	j998059465 [label="我无法向你描述自己多么渴望用 Helminth 穿越回过去杀光她全家。要慢慢杀。但她大概会反对吧。 ",shape=box,color=blue];
		j998059465 -> j1188766401;
	j1160102591 [label="我没有告诉他们。",shape=box,color=red];
		j1160102591 -> j2654701623;
	j2977745806 [label="他们是怎么知道的？",shape=box,color=red];
		j2977745806 -> j2611744034;
	j3042091287 [label="但说真的，我们之间的紧张关系确实缓和多了。",shape=box,color=blue];
		j3042091287 -> j4178894268;
	j2839785312 [label="我想那声音仍会在他清醒的噩梦中萦绕不去。那个可怜人将永远在现实与虚构的界限间徘徊。",shape=box,color=blue];
		j2839785312 -> j1616060688;
	j780427993 [label="我无法向你描述自己多么渴望用 Helminth 穿越回过去杀死他的父母。要慢慢杀。但我怕他会反对。",shape=box,color=blue];
		j780427993 -> j3011395980;
	j3032697116 [label="反正你们三个注定形影不离。英择谛早就安排好了。所以，尽量享受这段时光也不错。",shape=box,color=red];
		j3032697116 -> j1681875164;
	j3228674246 [label="我很欣慰。我觉得他们是真的关心你。",shape=box,color=red];
		j3228674246 -> j2860351378;
	j281541717 [label="幸好他们没有这么做。我可不想被当成弄脏地毯的小狗般被当面羞辱。眼下我已经够烦心了。",shape=box,color=blue];
		j281541717 -> j3032697116;
		j281541717 -> j3228674246;
	j3247195894 [label="我们之间关系改善的另一个原因？他们知道了我的秘密。知道我自愿注射血清的真相。",shape=box,color=blue];
		j3247195894 -> j3478718530;
		j3247195894 -> j1875024712;
	j1188766401 [label="复仇杀人很可能遭到太阳神的谴责之类什么的。 ",shape=box,color=blue];
		j1188766401 -> j2758033101;
	j2654701623 [label="我也没有说是你干的，亲爱的漂泊者。是我告诉他们的。",shape=box,color=blue];
		j2654701623 -> j1806500125;
	j2611744034 [label="亲爱的漂泊者，我告诉他们的。",shape=box,color=blue];
		j2611744034 -> j1806500125;
	j1616060688 [label="我们之间关系改善的另一个原因？",shape=box,color=blue];
		j1616060688 -> j4178894268;
