	j1115483435 [label="我与他握手。以朋友的身份向他表示感谢。我是奥罗金人，但我不是怪物。",shape=box,color=blue];
		j1115483435 -> j2119372242;
	j531449725 [label="当我把真相告诉她时，她什么也没说。她只是……抱住了我。",shape=box,color=blue];
		j531449725 -> j1093047434;
	j3817711576 [label="尤其是在她了解了英择谛的一切之后。她知道人的本性远比简单的非黑即白要复杂得多。",shape=box,color=red];
		j3817711576 -> j350822195;
	j2681736855 [label="我只是单纯地为你们俩能建立任何形式的友谊而感到高兴。哪怕这只是暂时的休战。",shape=box,color=red];
		j2681736855 -> j840261130;
	j655335958 [label="在我凄惨的一生中，第一次坦然接受了这份简单的安慰。",shape=box,color=blue];
		j655335958 -> j190342042;
	j190342042 [label="她只是用这样一种简单的方式告诉我，或许她根本没有我这么在乎这件事。同时她为我因此承受的痛苦感到抱歉。",shape=box,color=blue];
		j190342042 -> j578797561;
		j190342042 -> j2995613097;
	j578797561 [label="里昂呢？",shape=box,color=red];
		j578797561 -> j1385133995;
	j2995613097 [label="你做了什么？",shape=box,color=red];
		j2995613097 -> j1794679053;
	j2920289644 [label="恐怕你说的没错。命运给他发了手烂牌，而他已竭尽全力去抗争了。",shape=box,color=blue];
		j2920289644 -> j796247035;
	j1211257281 [label="我认为最终它会证明远不止于此。即便我厌恶这个事实。毕竟，我终究无法摆脱与他们纠缠的命运。",shape=box,color=blue];
		j1211257281 -> j796247035;
	j2119372242 [label="自那以后？",shape=box,color=blue];
