	4882 [label="尤其是里昂。我想他理解直面过去和我们做出的决定有多么艰难。请原谅这个双关语，看看那眼罩吧。",shape=box,color=blue];
		4882 -> 4886;
	4883 [label="他坐在我旁边，告诉我自从英择谛给他注射血清后，他就一直在质疑自己的信仰。他为这份质疑感到羞愧，更后悔当初注射了血清。",shape=box,color=blue];
