		j3011395980 -> j965502383;
	j1681875164 [label="说得对。没必要和新室友结仇。这就是当年我在高卢老偷点心的原因。",shape=box,color=blue];
		j1681875164 -> j2554882699;
	j2860351378 [label="尽管我尽了最大努力，是的。这实在令人费解。然而，事实就是如此。",shape=box,color=blue];
