	4806 [label="我对玛丽怎么看？除了想说服你让她跟我们住上一两晚，亲爱的漂泊者？（开玩笑的。开玩笑的。）",shape=box,color=blue];
		4806 -> 4821;
	4807 [label="我对玛丽怎么看？除了想说服你让我加入一两晚之外？（开玩笑的。开玩笑的。）",shape=box,color=blue];
		4807 -> 4822;
	4808 [label="你究竟是如何说服她改变对阿尔布雷希特纯洁性的看法？你可真是个“奇迹制造者”。或许他们不该崇拜太阳神和月神，而该崇拜你才对。",shape=box,color=blue];
		4808 -> 4823;
	4810 [label="我从未意识到她每日都在忍受着痛苦。她却将痛苦隐藏得仿佛不存在一般。直到她向你倾诉，才提起这件事。你已某种方式弥合了我们之间的隔阂。",shape=box,color=blue];
		4810 -> 4825;
	4809 [label="直到最近我才知道她的成长经历。她从未向我提起过自己的故事，直到她向你倾诉。你弥合了我们之间某种隔阂。",shape=box,color=blue];
		4809 -> 4824;
	4811 [label="一如往常。我每时每刻都在竭力克制自己，不让自己为压过她那声音的绝望而用爪子撕下自己的脸。",shape=box,color=blue];
		4811 -> 4826;
	4812 [label="现在好多了，毕竟有人能让我发泄不满。但说真的，我们之间的紧张关系确实缓和多了。",shape=box,color=blue];
		4812 -> 4827;
	4813 [label="我可没跟里昂“打得火热”，对吧？哈！抱歉开了个糟糕的玩笑。我实在忍不住，你把这梗铺得太明显了。",shape=box,color=blue];
		4813 -> 4828;
	4814 [label="你们俩的相处比表面上看起来要好得多。你到底怎么搞砸了？他需要的不过是个愿意倾听的人。 ",shape=box,color=blue];
		4814 -> 4829;
	4815 [label="我们之间的紧张关系确实缓和多了，特别是自从你让他有信心说出自己一直困扰的事情之后。",shape=box,color=blue];
		4815 -> 4830;
	4816 [label="我们之间的紧张关系确实缓和多了，特别是自从你让他有信心说出自己一直困扰的事情之后。",shape=box,color=blue];
		4816 -> 4831;
	4817 [label="一如往常。我每时每刻都在竭力克制自己，不让自己为压过他那声音的绝望而用爪子撕下自己的脸。",shape=box,color=blue];
		4817 -> 4832;
	4820 [label="我承认自己正渐渐觉得他们稍微好相处些了。我想这主要因为他们也在一点点放弃我。",shape=box,color=blue];
		4820 -> 4835;
	4819 [label="我承认自己正渐渐觉得他们稍微好相处些了。我想这或许与我最近的发现有关。",shape=box,color=blue];
		4819 -> 4834;
	4818 [label="我时常在想，尽管身为原型战甲，我无法借助深溯池来恢复记忆……",shape=box,color=blue];
		4818 -> 4833;
	4821 [label="我不知道她有没有意识到，我的挑衅已从真诚的恼怒转变为愉快的戏谑？",shape=box,color=blue];
		4821 -> 4836;
	4822 [label="我必须承认，我一点也不怪你。而且不仅仅是因为她美得惊人。我又不是瞎子。那位女士身上蕴藏的慈悲心，远超我对她这个年纪的预期。",shape=box,color=blue];
		4822 -> 4821;
	4823 [label="呸。正是这种言论导致了奥罗金帝国的崛起。这个星系绝不能重蹈覆辙。",shape=box,color=blue];
		4823 -> 4821;
	4825 [label="我承认自己正是她所说的愚人之一，无法理解有人竟能日复一日地如此生活。",shape=box,color=blue];
		4825 -> 4838;
	4824 [label="想到她的家人竟将她抛弃在街头。她。玛丽。那个玛丽。那个心怀超乎寻常慈悲的人？！",shape=box,color=blue];
		4824 -> 4837;
	4826 [label="Chat ends.",color=orange];
	4827 [label="他们知道我的……秘密。知道我自愿注射血清的真相。",shape=box,color=blue];
		4827 -> 4839;
		4827 -> 4840;
	4828 [label="我佩服你敢于面对那个可怜的疯子。他需要陪伴。也需要同情。",shape=box,color=blue];
		4828 -> 4841;
	4829 [label="可你却将他拒之门外。真该死。",shape=box,color=blue];
		4829 -> 4842;
	4830 [label="他向我提起那个他一直听见的 Tenno 小孩。以及他如今已听不见那声音了。",shape=box,color=blue];
		4830 -> 4843;
	4831 [label="我对他遭受的一切竟知之甚少。直到他向你倾诉后，他才终于愿意告诉我。 ",shape=box,color=blue];
		4831 -> 4844;
	4832 [label="Chat ends.",color=orange];
	4835 [label="开个玩笑。尽管我重新下决心要屏蔽他们对我人生抉择的批评，却莫名地对他们越来越喜欢了。",shape=box,color=blue];
		4835 -> 4847;
		4835 -> 4848;
	4834 [label="我本以为他们会用嘲讽来回应我的忏悔，用“终于醒悟了”或“早该如此”之类的讥诮来嘲弄我。结果却恰恰相反。他们几乎没提过这件事。",shape=box,color=blue];
		4834 -> 4846;
	4833 [label="……但这未必能阻止我沉溺其中。",shape=box,color=blue];
		4833 -> 4845;
	4836 [label="我希望如此。捉弄她实在太有趣了。看着她火冒三丈地用母语朝我吼叫，成了我最近最爱的消遣。",shape=box,color=blue];
		4836 -> 4849;
	4838 [label="她怎么还能保持如此镇定？更别说心存怜悯了？换作是我，恐怕早就像那位神父一样发疯了。",shape=box,color=blue];
		4838 -> 4821;
	4837 [label="我无法向你描述自己多么渴望用 Helminth 穿越回过去杀光她全家。要慢慢杀。但她大概会反对吧。 ",shape=box,color=blue];
		4837 -> 4850;
