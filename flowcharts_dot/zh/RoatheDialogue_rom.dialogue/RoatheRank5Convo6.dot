		j3137425038 -> j2681736855 [label=false,color=brown];
	j3853946455 [label="昔日的罗瑟本会趁机摘除她的肾脏，但我发现自己已经不再有这种想法了。 ",shape=box,color=blue];
		j3853946455 -> j655335958;
