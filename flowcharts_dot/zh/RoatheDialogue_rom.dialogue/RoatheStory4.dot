	j981118007 [label="语音留言：傲慢",shape=box,color=blue];
		j981118007 -> j644663251;
	j644663251 [label="文字记录：我们没想到会输。",shape=box,color=blue];
		j644663251 -> j2020945309;
	j2020945309 [label="我们没想到会输。在 Sentient 的第一次远征打击之后，我们已经准备好了惩罚性的反击。",shape=box,color=blue];
		j2020945309 -> j860971946;
	j860971946 [label="“镀金玻璃魔女号”从谷神星的迷雾中升起，展开致命的双翼，这艘帆船战舰满载着无人机和身披银甲的密尔弥多。",shape=box,color=blue];
		j860971946 -> j4152648875;
	j4152648875 [label="如薄雾细密的电路，在它们半透明的甲壳下交织成精致的蕾丝纹路。 ",shape=box,color=blue];
		j4152648875 -> j3711422929;
	j3711422929 [label="她体型如此庞大，几乎都无法越过星际航道的边缘。",shape=box,color=blue];
		j3711422929 -> j4053880775;
	j4053880775 [label="那些 Sentient 让我们亲眼目睹了这一切。它们歌唱，而我们的科技却被打败了。我们的战士在闪亮的战甲中挣扎窒息。",shape=box,color=blue];
		j4053880775 -> j1326891272;
	j1326891272 [label="“镀金玻璃魔女号”失去动力、俯冲穿过 Tau 的天空上，她的船员被活活烧死，这是一场复杂而昂贵的烟火秀。",shape=box,color=blue];
		j1326891272 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}