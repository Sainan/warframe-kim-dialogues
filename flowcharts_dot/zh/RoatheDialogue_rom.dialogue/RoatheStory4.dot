	2159 [label="“镀金玻璃魔女号”从谷神星的迷雾中升起，展开致命的双翼，这艘帆船战舰满载着无人机和身披银甲的密尔弥多。",shape=box,color=blue];
		2159 -> 2160;
	2160 [label="如薄雾细密的电路，在它们半透明的甲壳下交织成精致的蕾丝纹路。 ",shape=box,color=blue];
		2160 -> 5693;
	5693 [label="她体型如此庞大，几乎都无法越过星际航道的边缘。",shape=box,color=blue];
		5693 -> 2167;
	2167 [label="那些 Sentient 让我们亲眼目睹了这一切。它们歌唱，而我们的科技却被打败了。我们的战士在闪亮的战甲中挣扎窒息。",shape=box,color=blue];
		2167 -> 5684;
	5684 [label="“镀金玻璃魔女号”失去动力、俯冲穿过 Tau 的天空上，她的船员被活活烧死，这是一场复杂而昂贵的烟火秀。",shape=box,color=blue];
