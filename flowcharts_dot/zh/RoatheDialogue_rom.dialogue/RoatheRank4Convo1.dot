		j3652665456 -> j1038552372;
	j2997301697 [label="你一直叫我“篡位者”。这是在侮辱我吗？",shape=box,color=red];
		j2997301697 -> j3033637487;
	j1874628564 [label="Boolean RoatheUsurper is now true.",color=orange];
		j1874628564 -> j3439333019;
	j4253271518 [label="我只是想说，你这样称呼我来侮辱人，真是讽刺，因为你自己也犯了同样的错。",shape=box,color=red];
		j4253271518 -> j1647456323;
	j292996850 [label="我只是想弄清楚你为什么一直给我起这个外号。",shape=box,color=red];
		j292996850 -> j23270100;
	j3033637487 [label="哈！​才​不​是​！​要​是​你​觉得​我​已经​连续​几​天​当面​如此​随意​地​侮​辱​你，​那​你​真​是​太​有​耐心​了。​",shape=box,color=blue];
		j3033637487 -> j2389195802;
	j3439333019 [label="嗯，你就是这种人，对吧？Tenno 从奥罗金手中夺取了始源星系。而你，就像巢穴里的小冒牌货，从你自己的世界偷偷溜进了这个世界。",shape=box,color=blue];
		j3439333019 -> j2555463059;
	j1647456323 [label="哈！侮辱？​要​是​你​觉得​我​已经​连续​几​天​当面​如此​随意​地​侮​辱​你，​那​你​真​是​太​有​耐心​了。​",shape=box,color=blue];
		j1647456323 -> j1583718725;
	j23270100 [label="+5 Chemistry",color=orange];
		j23270100 -> j1737517077;
	j2389195802 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2389195802 -> j4125528550 [label=true,color=green];
		j2389195802 -> j2082219475 [label=false,color=brown];
	j2555463059 [label="这样看来，至少从这两点来说，你都是个篡位者。（如果算上管家告诉我的关于双衍王境的那些事，或许还有第三点，但这又是另一个话题了。）",shape=box,color=blue];
		j2555463059 -> j3178505233;
		j2555463059 -> j1581551917;
	j1583718725 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1583718725 -> j309326968 [label=true,color=green];
		j1583718725 -> j3382692143 [label=false,color=brown];
	j1737517077 [label="因为它的确只是一个外号，一个荣誉称号。你已经实现了我一直以来的愿望。 ",shape=box,color=blue];
		j1737517077 -> j685849082;
	j4125528550 [label="尤其是在这种情况下，你明显拥有巨大的能力，而这种能力几乎并非单方面的，嗯？",shape=box,color=blue];
		j4125528550 -> j3217400873;
	j2082219475 [label="尤其是我知道你可以随时利用虚空赋予你的力量穿墙而过，然后朝我的后脑勺开几枪。",shape=box,color=blue];
		j2082219475 -> j3217400873;
	j3178505233 [label="所以……你是在侮辱我。",shape=box,color=red];
		j3178505233 -> j1647456323;
	j1581551917 [label="好​吧。​那​为什么​还​一直​叫​我​这个​外号？​",shape=box,color=red];
		j1581551917 -> j23270100;
	j309326968 [label="尤其是在这种情况下，你明显拥有巨大的能力，而这种能力几乎并非单方面的，嗯？",shape=box,color=blue];
		j309326968 -> j3004110824;
	j3382692143 [label="尤其是我知道你可以随时利用虚空赋予你的力量穿墙而过，然后朝我的后脑勺开几枪。",shape=box,color=blue];
		j3382692143 -> j3004110824;
	j685849082 [label="这个外号仅仅表达了我淡淡的赞赏。哪怕它带有恰到好处的讽刺意味来满足我的需要。是的，这点我承认。",shape=box,color=blue];
		j685849082 -> j684916100;
		j685849082 -> j3110165702;
		j685849082 -> j1988415883;
		j685849082 -> j3772527620;
	j3217400873 [label="篡位者，我没心情与你为敌。不，这不是侮辱。只是因为你的疏忽大意，才没意识到我的过去与你的经历有很多相似之处。",shape=box,color=blue];
		j3217400873 -> j3581679918;
	j3004110824 [label="篡位者，我没心情与你为敌。不，这充其量只是一种尊称。你已经做到了我一直渴望做的事，仅此而已。",shape=box,color=blue];
		j3004110824 -> j685849082;
	j684916100 [label="所有奥罗金人都像你一样吗？",shape=box,color=red];
		j684916100 -> j2223499469;
	j3110165702 [label="如果我好好跟你说请你换个称呼，你会吗？",shape=box,color=red];
		j3110165702 -> j307829048;
	j1988415883 [label="我忍。",shape=box,color=red];
		j1988415883 -> j114771097;
	j3772527620 [label="别再叫我篡位者了。",shape=box,color=red];
		j3772527620 -> j751400365;
	j3581679918 [label="我一心想要推翻奥罗金政权，就像你的那个 Tenno 复制体和他的同伙一样。只是在我有机会推翻之前，就被从时间线中抹去了。",shape=box,color=blue];
		j3581679918 -> j2325413592;
	j2223499469 [label="+10 Chemistry",color=orange];
		j2223499469 -> j604854866;
	j307829048 [label="+5 Chemistry",color=orange];
		j307829048 -> j2730710331;
	j114771097 [label="+5 Chemistry",color=orange];
		j114771097 -> j533258471;
	j751400365 [label="嗯……",shape=box,color=blue];
		j751400365 -> j2853135994;
	j2325413592 [label="Boolean RoatheTraitor1 is now true.",color=orange];
		j2325413592 -> j685849082;
	j604854866 [label="哈！我仿佛在圣所里都能听到叹息。他们都和我一样吗？不。他们远不如我。而且恐怕更令人恼火。",shape=box,color=blue];
		j604854866 -> j3889080848;
	j2730710331 [label="嗯……不会。但我很欣赏你展现出的礼貌。篡位者，你得凭本事从我这儿赢回去称呼。你知道的。",shape=box,color=blue];
		j2730710331 -> j3889080848;
	j533258471 [label="很好。无论如何，你对此别无选择。 ",shape=box,color=blue];
