	2358 [label="你一直叫我“篡位者”。这是在侮辱我吗？",shape=box,color=red];
		2358 -> 2364;
	2359 [label="[结束]",shape=box,color=red];
		2359 -> 2365;
	2361 [label="Update boolean RoatheUsurper",color=orange];
		2361 -> 2367;
	2362 [label="我只是想说，你这样叫人来侮辱人，真是讽刺，因为你自己也犯了同样的错。",shape=box,color=red];
		2362 -> 2368;
	2363 [label="我只是想弄清楚你为什么一直给我起这个外号。",shape=box,color=red];
		2363 -> 2369;
	2366 [label="[结束]",shape=box,color=red];
		2366 -> 2371;
	2364 [label="哈！​才​不​是​！​要​是​你​觉得​我​已经​连续​几​天​当面​如此​随意​地​侮​辱​你，​那​你​真​是​太​有​耐心​了。​",shape=box,color=blue];
		2364 -> 2370;
	2365 [label="Chat ends.",color=orange];
	2367 [label="嗯，你就是这种人，对吧？Tenno 从奥罗金手中夺取了始源星系。而你，就像巢穴里的小冒牌货，从你自己的世界偷偷溜进了这个世界。",shape=box,color=blue];
		2367 -> 2372;
	2368 [label="哈！侮辱？​要​是​你​觉得​我​已经​连续​几​天​当面​如此​随意​地​侮​辱​你，​那​你​真​是​太​有​耐心​了。​",shape=box,color=blue];
		2368 -> 2373;
	2369 [label="+5 Chemistry",color=orange];
		2369 -> 2374;
	2371 [label="Chat ends.",color=orange];
	2370 [label="Check boolean RoatheKnowsReset2",color=orange];
		2370 -> 2375 [label=true,color=green];
		2370 -> 2376 [label=false,color=brown];
	2372 [label="这样看来，至少从这两点来说，你都是个篡位者。（如果算上管家告诉我的关于双衍王境的那些事，或许还有第三点，但这又是另一个话题了。）",shape=box,color=blue];
		2372 -> 2377;
		2372 -> 2378;
	2373 [label="Check boolean RoatheKnowsReset2",color=orange];
		2373 -> 2380 [label=true,color=green];
		2373 -> 2379 [label=false,color=brown];
	2374 [label="因为它的确只是一个外号，一个荣誉称号。你已经实现了我一直以来的愿望。 ",shape=box,color=blue];
		2374 -> 2381;
	2375 [label="尤其是在这种情况下，你明显拥有巨大的能力，而这种能力几乎并非单方面的，嗯？",shape=box,color=blue];
		2375 -> 2382;
	2376 [label="尤其是我知道你可以随时利用虚空赋予你的力量穿墙而过，然后朝我的后脑勺开几枪。",shape=box,color=blue];
		2376 -> 2382;
	2377 [label="所以……你是在侮辱我。",shape=box,color=red];
		2377 -> 2368;
	2378 [label="好​吧。​那​为什么​还​一直​叫​我​这个​外号？​",shape=box,color=red];
		2378 -> 2383;
	2380 [label="尤其是在这种情况下，你明显拥有巨大的能力，而这种能力几乎并非单方面的，嗯？",shape=box,color=blue];
		2380 -> 2384;
	2379 [label="尤其是我知道你可以随时利用虚空赋予你的力量穿墙而过，然后朝我的后脑勺开几枪。",shape=box,color=blue];
		2379 -> 2384;
	2381 [label="这个外号仅仅表达了我淡淡的赞赏。即便它带有恰到好处的讽刺意味以迎合我的需要，是的，我也会承认这一点。",shape=box,color=blue];
		2381 -> 2385;
		2381 -> 2386;
		2381 -> 2387;
		2381 -> 2388;
	2382 [label="篡位者，我没心情与你为敌。不，这不是侮辱。只是因为你的疏忽大意，才没意识到我的过去与你的经历有很多相似之处。",shape=box,color=blue];
		2382 -> 2389;
	2383 [label="+5 Chemistry",color=orange];
		2383 -> 2374;
	2384 [label="篡位者，我没心情与你为敌。不，这充其量只是一种尊称。你已经做到了我一直渴望做的事，仅此而已。",shape=box,color=blue];
		2384 -> 2381;
	2385 [label="所有奥罗金人都像你一样吗？",shape=box,color=red];
		2385 -> 2390;
	2386 [label="如果我好好请你换个称呼，你会吗？",shape=box,color=red];
		2386 -> 2391;
	2387 [label="我忍。",shape=box,color=red];
		2387 -> 2392;
	2388 [label="别再叫我篡位者了。",shape=box,color=red];
		2388 -> 2393;
	2389 [label="我一心想要推翻奥罗金政权，就像你的那个 Tenno 复制体和他的同伙一样。只是在我有机会推翻之前，就被从时间线中抹去了。",shape=box,color=blue];
		2389 -> 2394;
	2390 [label="+10 Chemistry",color=orange];
		2390 -> 2395;
	2391 [label="+5 Chemistry",color=orange];
		2391 -> 2396;
	2392 [label="+5 Chemistry",color=orange];
		2392 -> 2397;
	2393 [label="嗯……",shape=box,color=blue];
		2393 -> 2398;
	2394 [label="Update boolean RoatheTraitor1",color=orange];
		2394 -> 2381;
	2395 [label="哈！我仿佛都能听到圣所里传来的叹息。他们都和我一样吗？不。他们远不如我。而且恐怕更令人恼火。",shape=box,color=blue];
		2395 -> 2399;
	2396 [label="嗯……不会。但我很欣赏你展现出的礼仪。篡位者，你的称呼得凭本事从我这儿赢回去。你知道的。",shape=box,color=blue];
		2396 -> 2399;
	2397 [label="很好。无论如何，你对此别无选择。 ",shape=box,color=blue];
		2397 -> 2399;
	2398 [label="不行。",shape=box,color=blue];
		2398 -> 2399;
	2399 [label="+5 Chemistry",color=orange];
		2399 -> 2400;
	2400 [label="真的，你这样让这件事变得更有趣了。",shape=box,color=blue];
		2400 -> 2401;
	2401 [label="Chat ends.",color=orange];
