	5733 [label="他也参与了虚空中那些懦弱之塔的落成典礼。",shape=box,color=blue];
		5733 -> 2222;
	2222 [label="他心中对 Sentient 回归的恐惧是如此强烈，以至于他只能想象退守到虚空之海中的岛屿。",shape=box,color=blue];
		2222 -> 5700;
