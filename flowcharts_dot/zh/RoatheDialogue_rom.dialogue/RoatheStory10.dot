	2218 [label="文字记录：早在战前，脾气暴躁、思维缜密、言辞尖刻的斯卡恩就率先提出了这个计划。“我们必须离开巢穴，因为巢穴已经着火了。”",shape=box,color=blue];
		2218 -> 2221;
	2221 [label="由于过度开发和鲁莽的实验，我们已将星系破坏殆尽，使其无法再生。",shape=box,color=blue];
		2221 -> 2216;
	2216 [label="如今，向新的领域扩张是我们唯一的选择。 ",shape=box,color=blue];
