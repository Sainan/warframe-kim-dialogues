	j1269748414 [label="语音留言：惩罚",shape=box,color=blue];
		j1269748414 -> j3494329064;
	j3494329064 [label="文字记录：早在战前，脾气暴躁、思维缜密、言辞尖刻的斯卡恩就率先提出了这个计划。“我们必须离开巢穴，因为巢穴已经着火了。”",shape=box,color=blue];
		j3494329064 -> j4086115586;
	j4086115586 [label="由于过度开发和鲁莽的实验，我们已将星系破坏殆尽，使其无法再生。",shape=box,color=blue];
		j4086115586 -> j1970359190;
	j1970359190 [label="如今，向新的领域扩张是我们唯一的选择。 ",shape=box,color=blue];
		j1970359190 -> j3447496242;
	j3447496242 [label="他也参与了虚空中那些懦弱之塔的落成典礼。",shape=box,color=blue];
		j3447496242 -> j440274433;
	j440274433 [label="他心中对 Sentient 回归的恐惧是如此强烈，以至于他只能想象退守到虚空之海中的岛屿。",shape=box,color=blue];
		j440274433 -> j329011797;
	j329011797 [label="我们是多么低估了 Sentient 的勇气啊。",shape=box,color=blue];
		j329011797 -> j4239997113;
	j4239997113 [label="它们甘愿承受虚空的灼热烈焰，仅仅是为了有机会惩罚我们。",shape=box,color=blue];
		j4239997113 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}