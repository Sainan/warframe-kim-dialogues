	j1005857021 [label="这种挥之不去的念头，它日夜折磨着我、始终萦绕着我：不仅是我把所有最深的秘密都告诉了你，不只是你背叛了这份信任，抹去了一切，而现在我却想不起为什么……",shape=box,color=blue];
		j1005857021 -> j1787026705;
	j4237298 [label="我们正在努力寻找我脑海中的东西。阿尔布雷希特给我注射那种血清时，我感觉自己受到了很大的伤害。",shape=box,color=blue];
		j4237298 -> j2015095333;
		j4237298 -> j1335371021;
		j4237298 -> j1038552372;
	j3889387189 [label="你在帮助我找回记忆方面进展缓慢。如果你想履行约定，我希望你继续在沉沦之地工作。",shape=box,color=blue];
		j3889387189 -> j2633710812;
		j3889387189 -> j3807234177;
		j3889387189 -> j2296363501;
		j3889387189 -> j1038552372;
	j1959661264 [label="你至今仍未在沉沦之地中取得任何进展，未能找回我的记忆。如果你希望我履行承诺，你也应该努力履行你的承诺。",shape=box,color=blue];
		j1959661264 -> j3807234177;
