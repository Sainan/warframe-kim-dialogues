		j1580131748 -> j1593949861;
	j4086051892 [label="你觉得你能原谅我吗？",shape=box,color=red];
		j4086051892 -> j2923100383;
	j562856245 [label="我记得的一切足以让我确信，就算我在接下来的两千年里向双耀神祈求“宽恕”，也永远不会被宽恕。 ",shape=box,color=blue];
		j562856245 -> j1348029968;
	j4111303201 [label="我更倾向于自己了解所有事实，然后根据事实做出判断。",shape=box,color=blue];
		j4111303201 -> j1348029968;
	j3315970752 [label="我可以想象我对 Sentient、对奥罗金，或对两者所能做的一切事情，没什么能让我感到震惊或恐惧。",shape=box,color=blue];
		j3315970752 -> j998880615;
	j208228554 [label="篡位者，我已经尽力了，因为你身上有某种特质深深吸引了我。你魅力非凡，这在我的世界里实属罕见。",shape=box,color=blue];
