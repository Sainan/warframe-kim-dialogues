		j1787026705 -> j2698676512 [label=true,color=green];
		j1787026705 -> j3455040649 [label=false,color=brown];
	j2015095333 [label="那些记忆​看起来​并不​算愉快。​",shape=box,color=red];
		j2015095333 -> j3099732136;
	j1335371021 [label="那些记忆看起来不太愉快。你确定我们要继续下去吗？",shape=box,color=red];
		j1335371021 -> j1126958946;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j2633710812 [label="说实话，我一直有点儿吃力……不管我多么努力，我总是失败。",shape=box,color=red];
		j2633710812 -> j1260216089;
	j3807234177 [label="罗瑟，我不会听你的命令。",shape=box,color=red];
		j3807234177 -> j2031126362;
	j2296363501 [label="我最近很忙，我会尽快处理的。",shape=box,color=red];
		j2296363501 -> j250887628;
	j2698676512 [label="我不仅原谅了你抹去我那些回忆的行为……",shape=box,color=blue];
		j2698676512 -> j3117091328;
	j3455040649 [label="我不仅开始原谅你抹去我那些回忆的行为……",shape=box,color=blue];
		j3455040649 -> j3117091328;
	j3099732136 [label="对，​它们​并不愉快。​你​对​“Ta​u ​之​恶魔”​抱​有​什么​期​待？​是​阳光​明媚​的​午后，​在​公园​里躺​在​毯子​上，​吃​着​盘子​里​的​葡萄​的​美好​回忆​吗？​",shape=box,color=blue];
		j3099732136 -> j2758186947;
	j1126958946 [label="只有我找回一切，我才会知道他从我这里夺走了什么。当然，我们应该继续！漂泊者，那些记忆是我的。它们构成了现在的我，我曾经的模样。它们是我存在的根本。",shape=box,color=blue];
		j1126958946 -> j113763841;
	"Chat ends." [color=orange];
	j1260216089 [label="Boolean RoatheStrugglebus is now true.",color=orange];
		j1260216089 -> j1728716912;
	j2031126362 [label="不，你当然不会。你一天做什么对我来说无关紧要。我只是想说，如果你想让那个瘦弱的小管家走上楼梯，你就得做好自己的事。",shape=box,color=blue];
		j2031126362 -> j2242614491;
	j250887628 [label="请务必处理。你一天做什么对我来说无关紧要。我只是想说，如果你想让那个瘦弱的小管家走上楼梯，你就得做好自己的事。",shape=box,color=blue];
		j250887628 -> j487640174;
	j3117091328 [label="而且我发现自己又想信任你了。再一次！明明知道你都做了些什么。明明知道你很可能会再次背叛我！",shape=box,color=blue];
		j3117091328 -> j95379872;
	j2758186947 [label="我可怜的篡位者，我担心我们在我记忆深处发现的，只有鲜血、残暴和失败。",shape=box,color=blue];
		j2758186947 -> j3730593115;
		j2758186947 -> j3613932686;
	j113763841 [label="从其他人的描述中，我了解到你在双衍王境期间也曾有过类似的困扰，对吗？",shape=box,color=blue];
		j113763841 -> j3663797253;
		j113763841 -> j2382975348;
	j1728716912 [label="我听闻的尽是你战胜合一众、击败成群的 Grineer 士兵、一路击退低语者的英勇事迹。我的事竟然能让你束手无策？",shape=box,color=blue];
		j1728716912 -> j121748563;
	j2242614491 [label="如果你不在乎？那我也不在乎。我还有自己的事情要处理。",shape=box,color=blue];
		j2242614491 -> "Chat ends.";
	j487640174 [label="如果你不在乎？那我也不在乎。我还有自己的事情要处理。",shape=box,color=blue];
		j487640174 -> j1933300832;
	j95379872 [label="但我发现自己坐在那间墓穴里，我从椅子上站起来，心想：“不知道漂泊者是否在附近，他是否愿意谈谈。”",shape=box,color=blue];
		j95379872 -> j2341185090;
	j3730593115 [label="你是这艘船的驾驶员。如果你想继续驾驶它驶向黑洞，那就全速前进吧。",shape=box,color=red];
		j3730593115 -> j1594359166;
	j3613932686 [label="那你确定要继续下去吗？",shape=box,color=red];
		j3613932686 -> j3150021248;
	j3663797253 [label="罗瑟，​我们​完全​不​一样。​",shape=box,color=red];
		j3663797253 -> j1519557339;
	j2382975348 [label="是的。记忆和麻木。我至今仍然记不起……大段大段的时光。",shape=box,color=red];
		j2382975348 -> j628748244;
	j121748563 [label="+20 Chemistry",color=orange];
		j121748563 -> j260511343;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j2341185090 [label="这真是太可悲了！我竟然沦落到如此地步？我？！一个奥罗金人？！罗瑟！Tau 之恶魔！我如此躁动不安，如此想知道，如此渴望任何形式的刺激，以至于我才会在这里，与你交谈！",shape=box,color=blue];
		j2341185090 -> j2697657655;
		j2341185090 -> j832689313;
		j2341185090 -> j3619804836;
		j2341185090 -> j1038552372;
	j1594359166 [label="+10 Chemistry",color=orange];
		j1594359166 -> j3456288143;
	j3150021248 [label="只有我找回一切，我才会知道他从我这里夺走了什么。当然，我们应该继续！漂泊者，那些记忆是我的。它们构成了现在的我，我曾经的模样。它们是我存在的根本。",shape=box,color=blue];
		j3150021248 -> j2473894398;
		j3150021248 -> j3160289179;
	j1519557339 [label="也许是这样，但这并非我想表达的重点。而你却在回避承认这一点。好吧。假设你真的失去了记忆——如果可以的话，你会想方设法找回它们吗？",shape=box,color=blue];
		j1519557339 -> j2473894398;
		j1519557339 -> j3160289179;
	j628748244 [label="如果给你一次机会找回失去的记忆，你会去找吗？",shape=box,color=blue];
		j628748244 -> j3834647598;
		j628748244 -> j2473894398;
		j628748244 -> j3160289179;
	j260511343 [label="假设你没骗我？我承认这真是让我受宠若惊。可爱。极其悲哀。但确实让我受宠若惊。",shape=box,color=blue];
		j260511343 -> "Chat ends.";
	j2697657655 [label="无论你是否期待我们的对话，我都期待着。",shape=box,color=red];
		j2697657655 -> j3971559473;
	j832689313 [label="我会尽量不往心里去。",shape=box,color=red];
		j832689313 -> j3111620357;
	j3619804836 [label="或者，你只是喜欢和我聊天？",shape=box,color=red];
		j3619804836 -> j2215007429;
	j3456288143 [label="漂泊者，说得好。只有找回一切，我才能真正体会到失去的一切有多么珍贵。那些记忆构成了现在的我，塑造了过去的我。它们是我生命中不可分割的一部分。",shape=box,color=blue];
		j3456288143 -> j3834647598;
		j3456288143 -> j2473894398;
		j3456288143 -> j3160289179;
	j2473894398 [label="我认为知道总比不知道好，但是……我们必须做好准备。",shape=box,color=red];
		j2473894398 -> j2488294202;
	j3160289179 [label="有时候我觉得有些事应该永远埋藏起来是有原因的。",shape=box,color=red];
		j3160289179 -> j1885000441;
	j3834647598 [label="那是你的记忆。我们该去把它拿回来了。能有多糟？你是奥罗金人，你肯定做过更糟糕的事。",shape=box,color=red];
		j3834647598 -> j829863047;
	j3971559473 [label="那么，我真是太庆幸了，当你用叉子在我脑袋里乱捣乱的时候，我没有变成一个流着口水的白痴。",shape=box,color=blue];
		j3971559473 -> j3284677091;
	j3111620357 [label="也许你应该这么做。毕竟，是你拿着叉子在我脑子里乱捣鼓的。",shape=box,color=blue];
		j3111620357 -> j3284677091;
	j2215007429 [label="如果我不知道你曾用叉子在我脑子里乱捣鼓，或许我会喜欢。",shape=box,color=blue];
		j2215007429 -> j3284677091;
	j2488294202 [label="准备？​确切​来​说，​怎么​准备？​你​以​为​我​一旦​得​知​某些​骇人​听闻​的​战争​罪行​的​真相，​就​会​像​摇摇​欲坠​的​纸牌​屋​一样​轰然​倒塌​吗？​",shape=box,color=blue];
		j2488294202 -> j3283674114;
	j1885000441 [label="那么，我们岂不是注定要重蹈覆辙，永远不吸取教训，永远不进步，永远活在对过去的自己浑然不觉的幸福之中吗？",shape=box,color=blue];
		j1885000441 -> j3695479766;
	j829863047 [label="+10 Chemistry",color=orange];
		j829863047 -> j3021575166;
	j3284677091 [label="Check boolean RoatheResetForgiven",color=orange];
		j3284677091 -> j1122766147 [label=true,color=green];
		j3284677091 -> j189309236 [label=false,color=brown];
	j3283674114 [label="相信我，我可以想象我对 Sentient、对奥罗金，或对两者所能做的一切事情，没什么能让我感到震惊或恐惧。",shape=box,color=blue];
		j3283674114 -> j278915789;
	j3695479766 [label="嗯，我意识到，我刚才可能反而反驳了自己的论点，这对大多数人来说可能并不成立。",shape=box,color=blue];
		j3695479766 -> j1510375530;
	j3021575166 [label="说得对！我绝不会因为得​知​某些​骇人​听闻​的​战争​罪行​的​真相，​就​会​像​摇摇​欲坠​的​纸牌​屋​一样​轰然​倒塌。",shape=box,color=blue];
		j3021575166 -> j2480595523;
	j1122766147 [label="我说过我原谅你了。我也在努力遵守我对你的承诺。只是有时候言语并不能代表一切。说原谅一个人在理论上很美好，但有时情感上很难做到。",shape=box,color=blue];
		j1122766147 -> j166541374;
		j1122766147 -> j1401823129;
	j189309236 [label="真是太烦人了。我想和你谈谈，但同时又想掐死你，因为你玷污了我的思想。",shape=box,color=blue];
		j189309236 -> j1580131748;
		j189309236 -> j4086051892;
