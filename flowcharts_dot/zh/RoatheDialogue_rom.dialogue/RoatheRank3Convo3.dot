		j2480595523 -> j3315970752;
	j166541374 [label="我理解。这很难接受，你可能想接受，但却做不到。",shape=box,color=red];
		j166541374 -> j208228554;
	j1401823129 [label="所以你……不原谅我了？",shape=box,color=red];
		j1401823129 -> j208228554;
