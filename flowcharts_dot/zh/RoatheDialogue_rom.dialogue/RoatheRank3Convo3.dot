		j2923100383 -> j208228554;
	j1348029968 [label="我内心深处等待着我的并不会让我感到恐惧。我只想拿回那些被不公正地夺走的东西。",shape=box,color=blue];
		j1348029968 -> j3080254185;
	j998880615 [label="所以我内心深处等待着我的并不会让我感到恐惧。我只想拿回那些被不公正地夺走的东西。",shape=box,color=blue];
		j998880615 -> j3781110014;
