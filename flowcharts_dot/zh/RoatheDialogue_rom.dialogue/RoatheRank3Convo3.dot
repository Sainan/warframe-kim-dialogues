	1786 [label="这种挥之不去的念头，它日夜折磨着我、始终萦绕着我：我不仅把所有最深的秘密都告诉了你，而且你背叛了这份信任，抹去了一切，而现在我却想不起为什么……",shape=box,color=blue];
		1786 -> 1793;
	1785 [label="我们正在努力寻找我脑海中的东西。阿尔布雷希特给我注射那种血清时，我感觉自己受到了很大的伤害。",shape=box,color=blue];
