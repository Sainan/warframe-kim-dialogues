digraph {
	"RoatheRank1Convo1 begins." [color=orange];
		"RoatheRank1Convo1 begins." -> j3998890108;
	j3998890108 [label="Evaluate expressions on HellStory counter",color=orange];
		j3998890108 -> j1604221369 [label="x >= 21",color=purple];
		j3998890108 -> j1427563382 [label="x >= 6",color=purple];
		j3998890108 -> j2113850916 [label="x < 6",color=purple];
		j3998890108 -> j2113850916 [label="false",color=purple];
	j1604221369 [label="我真得佩服你的胆量！说真的，你确定你不是伪装起来的奥罗金人吗？或许你是为了不惊动其他人，隐藏了你蔚蓝色的皮肤？！",shape=box,color=blue];
		j1604221369 -> j1863143099;
		j1604221369 -> j2912678639;
		j1604221369 -> j3286082212;
	j1427563382 [label="Boolean RoatheResetEdgeCase is now true.",color=orange];
		j1427563382 -> j2113850916;
	j2113850916 [label="虚空诞生的异类。“漂泊者”。篡位者。终于，我们开口了。来吧。本恶魔有个提议……",shape=box,color=blue];
		j2113850916 -> j1794370112;
		j2113850916 -> j202738822;
		j2113850916 -> j3368575552;
		j2113850916 -> j3368414854;
	j1863143099 [label="罗瑟，你好。",shape=box,color=red];
		j1863143099 -> j2482185093;
	j2912678639 [label="你到底想把什么扣在我头上？",shape=box,color=red];
		j2912678639 -> j4006531070;
	j3286082212 [label="你说什么？",shape=box,color=red];
		j3286082212 -> j4006531070;
	j1794370112 [label="篡位者？",shape=box,color=red];
		j1794370112 -> j4249647559;
	j202738822 [label="什么样的……提议？",shape=box,color=red];
		j202738822 -> j4190637413;
	j3368575552 [label="“Tau 之恶魔”究竟会向我提出什么样的提议呢？",shape=box,color=red];
		j3368575552 -> j3370141172;
	j3368414854 [label="罗瑟，你好。",shape=box,color=red];
		j3368414854 -> j3877574769;
	j2482185093 [label="啊，太好了！原来你知道我的名字！我还以为你压根就没注意过，毕竟你当时忙着反复屠杀我呢！",shape=box,color=blue];
		j2482185093 -> j3838234041;
	j4006531070 [label="你真的就没有点更有意义的事情去做吗？！还是说，一遍又一遍地玩“给亚兹纳克贴角”的游戏真的是你最好的消遣方式？！",shape=box,color=blue];
		j4006531070 -> j3838234041;
	j4249647559 [label="Boolean RoatheUsurper is now true.",color=orange];
		j4249647559 -> j458642644;
	j4190637413 [label="嗯，你暂时无需担忧……或兴奋……这仅仅是两个互惠互利的人之间的一项商业协议。",shape=box,color=blue];
		j4190637413 -> j3877574769;
	j3370141172 [label="+5 Chemistry",color=orange];
		j3370141172 -> j3596487100;
	j3877574769 [label="现在，仔细看着。那两个狂热分子反复地、煞有介事地辱骂我，真是令人难以忍受，也乏味至极。我希望你会有更高的层次，别跟他们一样做这种事。",shape=box,color=blue];
		j3877574769 -> j3704733107;
		j3877574769 -> j2203658882;
	j3838234041 [label="我很难相信——我遭受的所有这些不公正待遇，所有这些对我精神的摧残，竟然不是出于你刻意的驱使！",shape=box,color=blue];
		j3838234041 -> j3273485563;
		j3838234041 -> j3035287234;
		j3838234041 -> j2856173744;
	j458642644 [label="+5 Chemistry",color=orange];
		j458642644 -> j1911773283;
	j3596487100 [label="看来我的名声在外。很好。这能节省我们一些时间。",shape=box,color=blue];
		j3596487100 -> j3290412680;
	j3704733107 [label="我不会听你指挥。",shape=box,color=red];
		j3704733107 -> j4026548805;
	j2203658882 [label="我尽量试试看吧。",shape=box,color=red];
		j2203658882 -> j3496019322;
	j3273485563 [label="这件事似乎并不重要？",shape=box,color=red];
		j3273485563 -> j3309065328;
	j3035287234 [label="我……只是之前没来得及做这件事。",shape=box,color=red];
		j3035287234 -> j1891811089;
	j2856173744 [label="你不记得了……但我们以前经历过这一切。",shape=box,color=red];
		j2856173744 -> j3587220755;
	j1911773283 [label="啊！你就是这种人，对吧？Tenno 从奥罗金手中夺取了始源星系。而你，就像巢穴里的小冒牌货，从你自己的世界偷偷溜进了这个世界。",shape=box,color=blue];
		j1911773283 -> j3149682505;
	j3290412680 [label="目前你无需担忧或兴奋……这仅仅是两个互惠互利的人之间的一项商业协议。",shape=box,color=blue];
		j3290412680 -> j3877574769;
	j4026548805 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4026548805 -> j375199226 [label="x >= 21",color=purple];
		j4026548805 -> j611694265 [label="x >= 1",color=purple];
		j4026548805 -> j3475402492 [label="x <= 0",color=purple];
		j4026548805 -> j3475402492 [label="false",color=purple];
	j3496019322 [label="你最好做到。",shape=box,color=blue];
		j3496019322 -> j3655855238;
	j3309065328 [label="这件事似乎——",shape=box,color=blue];
		j3309065328 -> j2006145687;
	j1891811089 [label="哦！那非常抱歉给你带来不便，我不知道你的舞会档期已经被预订了！",shape=box,color=blue];
		j1891811089 -> j4030199777;
	j3587220755 [label="+5 Chemistry",color=orange];
		j3587220755 -> j4032157283;
	j3149682505 [label="这样看来，至少从这两点来说，你都是个篡位者。（如果算上管家告诉我的关于双衍王境的那些事，或许还有第三点，但这又是另一个话题了。）",shape=box,color=blue];
		j3149682505 -> j3877574769;
	j375199226 [label="你已经反复且毫不留情地表明了这一点，谢谢。",shape=box,color=blue];
		j375199226 -> j3655855238;
	j611694265 [label="你已经说得很清楚了。",shape=box,color=blue];
		j611694265 -> j3655855238;
	j3475402492 [label="我们等着瞧。",shape=box,color=blue];
		j3475402492 -> j3655855238;
	j3655855238 [label="现在，这笔交易很简单，我这位迷人、不可靠、飘渺的新“朋友”。",shape=box,color=blue];
		j3655855238 -> j1071362491;
	j2006145687 [label="这件事似乎并不重要？！",shape=box,color=blue];
		j2006145687 -> j3824311077;
	j4030199777 [label="真是的。真令人大开眼界。漂泊者，你的教养简直糟糕透了。",shape=box,color=blue];
		j4030199777 -> j1654589563;
	j4032157283 [label="什么？我究竟是如何忘记，就像纳贝流士派对上的马利姆碗一样在我脑海中翻来覆去的你呢！",shape=box,color=blue];
		j4032157283 -> j2739139062;
		j4032157283 -> j3812019730;
	j1071362491 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1071362491 -> j496126459 [label="x >= 21",color=purple];
		j1071362491 -> j3547938240 [label="x >= 1",color=purple];
		j1071362491 -> j1663441048 [label="x <= 0",color=purple];
		j1071362491 -> j1663441048 [label="false",color=purple];
	j3824311077 [label="你是不是经常在别人的记忆里游荡，肆意破坏他们的形象，却连对方也不去了解一下？！",shape=box,color=blue];
		j3824311077 -> j4143374467;
	j1654589563 [label="但我想现在也无能为力了。你知道真相。我的一切都暴露在你面前，而我那令人作呕的懦弱无能也暴露无遗。",shape=box,color=blue];
		j1654589563 -> j244107927;
	j2739139062 [label="长话短说，Infestation 似乎已经蔓延到了原型战甲血清中……",shape=box,color=red];
		j2739139062 -> j700843039;
	j3812019730 [label="啊。那个。是这样。我能够循环时间。",shape=box,color=red];
		j3812019730 -> j700843039;
	j496126459 [label="既然你已经像喝醉的拉扎利翁在玻璃匠作坊里乱撞一样闯进了我的脑子里，我需要你的帮助来试着解读这一切到底意味着什么。",shape=box,color=blue];
		j496126459 -> j2164452167;
	j3547938240 [label="你和那两个狂热分子已经开始在我脑子里胡闹了，就像喝醉的拉扎利翁闯进玻璃匠作坊一样。我需要你们的帮助，帮我解读这一切到底意味着什么。",shape=box,color=blue];
		j3547938240 -> j2164452167;
	j1663441048 [label="当阿尔布雷希特把注射器扎进我的脖子，把我变成现在这个——东西——的时候，他还做了另一件事。奥罗金人之间的游戏是一回事，而这？这又是另一回事。",shape=box,color=blue];
		j1663441048 -> j3222862831;
	j4143374467 [label="你的教养简直糟糕透了！",shape=box,color=blue];
		j4143374467 -> j1654589563;
	j244107927 [label="我猜你来这里就是为了嘲笑我。我希望你一次嘲笑个够，好让我们继续。",shape=box,color=blue];
		j244107927 -> j3683345880;
	j700843039 [label="我原以为它在 1999 年的原型战甲上能用，是因为年份本身是循环的，但事实并非如此。 ",shape=box,color=red];
		j700843039 -> j2373016609;
	j2164452167 [label="我不仅需要你的帮助来恢复我的记忆——更糟糕的是，我自己似乎无法找到辨别真相的方法！",shape=box,color=blue];
		j2164452167 -> j2596932472;
		j2164452167 -> j2459195744;
	j3222862831 [label="他​夺走​了​我​太​多​的​记忆。​我​看到​那个​小小​的​……​你，​和​那些​同样​遭​受​创伤​的​ Tenno ​朋友们​一起​四处​逃窜。​我​看到​ Lotus ​正​在​帮助​它​找回​什么。​",shape=box,color=blue];
		j3222862831 -> j93471908;
		j3222862831 -> j3450302147;
	j3683345880 [label="我可不想整天像某些贵妇精心饲养、叫个不停的库狛，不断地忍受它碍事。",shape=box,color=blue];
		j3683345880 -> j44052904;
		j3683345880 -> j3653677553;
	j2373016609 [label="我觉得……这跟 Infestation 本身关系更大？有个会说话的吉他似乎暗示了这一点。而且你是乘坐 Helminth 来到这里的，对吧？",shape=box,color=red];
		j2373016609 -> j1088801848;
	j2596932472 [label="所以你的意思是，你……只是需要找人倾诉？",shape=box,color=red];
		j2596932472 -> j3579767509;
	j2459195744 [label="如果我能帮上忙，我很乐意，只是我不太清楚该怎么做。",shape=box,color=red];
		j2459195744 -> j739634668;
	j93471908 [label="所以……为什么你不自己进入深溯池呢？",shape=box,color=red];
		j93471908 -> j4061629749;
	j3450302147 [label="这个孩子不是“它”。",shape=box,color=red];
		j3450302147 -> j3507576831;
	j44052904 [label="你选择了逃避。但很多人都选择了逃避。关键在于能不能面对已经发生的事情。",shape=box,color=red];
		j44052904 -> j1434872152;
	j3653677553 [label="我不会嘲笑你。是你选择了继续战斗。",shape=box,color=red];
		j3653677553 -> j3284581274;
	j1088801848 [label="漂泊者，你似乎对整个谈话内容都不太确定，尤其是我脑袋里的记忆。",shape=box,color=blue];
		j1088801848 -> j1995850757;
	j3579767509 [label="哦，别把这说得好像我只需要躺在沙发上，倾诉我的“感受”就行了。",shape=box,color=blue];
		j3579767509 -> j739634668;
	j739634668 [label="我需要有人替我操作这台机器，因为我目前自己无法操作。 ",shape=box,color=blue];
		j739634668 -> j3411601575;
	j4061629749 [label="相信我，我本来可以亲自去的——但我没法这样做！那个混账阿尔布雷希特给我注射的原型战甲血清，让我根本无法独自操作那台该死的装置！",shape=box,color=blue];
		j4061629749 -> j3947143399;
	j3507576831 [label="我向你保证，它确实只是“它”。",shape=box,color=blue];
		j3507576831 -> j1932860629;
	j1434872152 [label="Add 1 to Thermostat counter",color=orange];
		j1434872152 -> j3490358941;
	j3284581274 [label="Add -1 to Thermostat counter",color=orange];
		j3284581274 -> j722367253;
	j1995850757 [label="没错，我的确是通过一只 Helminth 来到这里的。那是我自己设计培育的，谢谢。现在，你是说你……抹去了我的记忆？！抹去了我们之间的对话？！ ",shape=box,color=blue];
		j1995850757 -> j3079916332;
	j3411601575 [label="我还需要有人帮我记录记忆，并帮助我整理它们。算是一个临时的助手吧。",shape=box,color=blue];
		j3411601575 -> j303418533;
	j3947143399 [label="此外，我不仅需要你的帮助来恢复我的记忆——更糟糕的是，我自己似乎无法找到辨别真相的方法！",shape=box,color=blue];
		j3947143399 -> j2596932472;
		j3947143399 -> j2459195744;
	j1932860629 [label="要知道，我本来可以亲自去的——但我没法这样做！那个混账阿尔布雷希特给我注射的原型战甲血清，让我根本无法独自操作那台该死的装置！",shape=box,color=blue];
		j1932860629 -> j3947143399;
	j3490358941 [label="太好了。又有一只嗡嗡叫的小苍蝇在我耳边飞来飞去，告诉我我需要反省和忏悔吗？",shape=box,color=blue];
		j3490358941 -> j2329621203;
	j722367253 [label="+5 Chemistry",color=orange];
		j722367253 -> j2850666470;
	j3079916332 [label="因为我显然对你有“美好”的回忆，你为了满足你那嗜血的好玩念头，把我剁成肉酱。你觉得这说得通吗？",shape=box,color=blue];
		j3079916332 -> j3938173009;
		j3079916332 -> j292501258;
	j303418533 [label="作为回报——我郑重承诺，我会安然地坐在这里……不会对任何人构成威胁，这一点我向你保证……我完全有能力做到。我不会伤害那些狂热分子，也不会伤害管家，更不会伤害阿尔布雷希特那些被虚空腐化的动物。",shape=box,color=blue];
		j303418533 -> j2704853834;
	j2329621203 [label="我可真幸运。",shape=box,color=blue];
		j2329621203 -> j772537442;
	j2850666470 [label="目前，我所做的似乎是“与两个愚蠢的狂热分子一起在墓穴里腐烂，并向遭受战争创伤的儿童分发小饰品”。",shape=box,color=blue];
		j2850666470 -> j2579894349;
	j3938173009 [label="罗瑟，我不知道，而且我来这里也不是为了继续挨你的骂。我把大家拉进循环，可不是为了让你来骂我。",shape=box,color=red];
		j3938173009 -> j3629835744;
	j292501258 [label="依我看，我们的对话并不深入，只是一些浅层记忆。而我们刚才挖出来的那些过去……我想，算是你核心记忆的一部分吧？",shape=box,color=red];
		j292501258 -> j4076686108;
	j2704853834 [label="更​重要​的​是，​我​不​会​伤害阿尔布雷​希特​那​群​扭曲​的​家人，​他们​就​像​变异​的​植物​一样​在​坐​我们​头顶​上​空​——​也​完全​不​会​发现​我们​的​存在。​",shape=box,color=blue];
		j2704853834 -> j3461269237;
		j2704853834 -> j1962132294;
		j2704853834 -> j3104719889;
	j772537442 [label="漂泊者，我打算继续做我的事，不过事实摆在那儿——你对我过去的经历和所作所为了解得太多了。我们只能……以这种状态下相处下去。",shape=box,color=blue];
		j772537442 -> j3102979348;
	j2579894349 [label="但我猜现在他们肯定都管这叫“继续​战斗”了。",shape=box,color=blue];
		j2579894349 -> j772537442;
	j3629835744 [label="对。我大概能猜到你为何召唤虚空之力来抹去我们最近发生的记忆。真是意料之中。",shape=box,color=blue];
		j3629835744 -> j4011283900;
	j4076686108 [label="太好了！真是绝妙！我现在落入了一个疯子手里，一个能随心所欲抹去我记忆的疯子！真是太可爱了！",shape=box,color=blue];
		j4076686108 -> j4011283900;
	j3461269237 [label="我以为这是笔交易。现在你却在威胁我？",shape=box,color=red];
		j3461269237 -> j4033787123;
	j1962132294 [label="罗瑟？请先停下来听我说一会儿。",shape=box,color=red];
		j1962132294 -> j267083431;
	j3104719889 [label="你​需要​我​做​什么？​",shape=box,color=red];
		j3104719889 -> j264305342;
	j3102979348 [label="请你尽量别让我太难堪，我保证也会以同样的礼数回敬你。",shape=box,color=blue];
		j3102979348 -> j1186405622;
		j3102979348 -> j2826036232;
	j4011283900 [label="好吧。如果你说的是真的——而这荒诞的故事确实也足够真实——我会尽量不因为你知道了我内心深处这个可怕真相而怪你。",shape=box,color=blue];
		j4011283900 -> j4232682095;
	j4033787123 [label="你没在听吗？现在的人的阅读理解能力真是……篡位者，我没有威胁你。我也没有威胁任何人。",shape=box,color=blue];
		j4033787123 -> j3266972998;
	j267083431 [label="这一定会很精彩。请便，尽管去说吧；这出戏就交给你了。",shape=box,color=blue];
		j267083431 -> j2593458358;
		j267083431 -> j1329113585;
		j267083431 -> j1572794198;
	j264305342 [label="你没在听吗？现在的人的阅读理解能力真是……篡位者，我是在尝试和你达成协议。我难以相信你连这都搞不明白。",shape=box,color=blue];
		j264305342 -> j837217395;
	j1186405622 [label="不行。",shape=box,color=red];
		j1186405622 -> j3649971874;
	j2826036232 [label="我觉得这很合理。",shape=box,color=red];
		j2826036232 -> j396751862;
	j4232682095 [label="不过，如果可以的话，我希望你一次嘲笑个够，好让我们继续。",shape=box,color=blue];
		j4232682095 -> j3683345880;
	j3266972998 [label="我只是想说，如果到了我无法实现最终目标的地步，我可能就没有理由再保持沉默了。",shape=box,color=blue];
		j3266972998 -> j837217395;
	j2593458358 [label="Ballas 是我杀的。别逼我腾出时间来处理你。",shape=box,color=red];
		j2593458358 -> j228089495;
	j1329113585 [label="如果你想让我帮忙，用这种态度可不行。",shape=box,color=red];
		j1329113585 -> j2138194054;
	j1572794198 [label="我知道你我之间没什么交集——真的不多。但我来这里是为了帮助你。",shape=box,color=red];
		j1572794198 -> j1244824276;
	j837217395 [label="如果我的提议不符合你的标准，我是否该改进一下？",shape=box,color=blue];
