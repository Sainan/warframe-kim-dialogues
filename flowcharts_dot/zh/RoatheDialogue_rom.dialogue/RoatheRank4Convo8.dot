digraph {
	3120 [label="RoatheRank4Convo8 begins.",color=orange];
		3120 -> 3121;
		3120 -> 3122;
	3121 [label="罗瑟，你的童年是怎样的？",shape=box,color=red];
		3121 -> 3123;
	3122 [label="[结束]",shape=box,color=red];
		3122 -> 3124;
	3123 [label="嗯？有趣的问题。是“怎样”的？说实话，我记不太清了。而且，那些承载着记忆的阿耶檀识之星和塑像，我想现在大概早已化为尘埃，或者被烧成内融核心了吧。",shape=box,color=blue];
		3123 -> 3125;
	3124 [label="Chat ends.",color=orange];
	3125 [label="恐怕我只能回忆起一些零星的片段，因为那已经是很久以前的事了。很多时候，我甚至怀疑自己是不是在做梦，或者只是在把历史书上的情节想象出来。",shape=box,color=blue];
		3125 -> 3126;
	3126 [label="因此，我承认，我的记忆很可能非常不可靠。你为什么这么问？",shape=box,color=blue];
		3126 -> 3127;
		3126 -> 3128;
		3126 -> 3129;
	3127 [label="即使这些故事是虚构的，它们仍然是你对自己成长岁月的描述。它们仍然值得了解。",shape=box,color=red];
		3127 -> 3130;
	3128 [label="我很好奇作为奥罗金贵族长大是什么样的体验。",shape=box,color=red];
		3128 -> 3131;
	3129 [label="我想知道是什么造就了“你”。你怎么会变成这样？",shape=box,color=red];
		3129 -> 3132;
	3130 [label="+5 Chemistry",color=orange];
		3130 -> 3133;
	3131 [label="我小时候就被送往狂热分子所谓的“寄宿学校”，就像所有注定要成就伟业的奥罗金青年一样。在那里，我接受了各种倾向和天赋的测试和训练。",shape=box,color=blue];
		3131 -> 3134;
		3131 -> 3135;
	3132 [label="+5 Chemistry",color=orange];
		3132 -> 3136;
	3133 [label="我认同，我们对自己撒的谎往往比真相更重要。篡位者，真是精辟的见解。",shape=box,color=blue];
		3133 -> 3137;
	3134 [label="你父母就这样把你送走了？去了多久？",shape=box,color=red];
		3134 -> 3138;
	3135 [label="那里是怎么样的？",shape=box,color=red];
		3135 -> 3139;
	3136 [label="你是试图找出我究竟“做错了”什么？我明白了！真有趣。我还真不知道我的童年经历能给你什么答案。",shape=box,color=blue];
		3136 -> 3140;
	3137 [label="Add -1 to Thermostat",color=orange];
		3137 -> 3131;
	3138 [label="我的整个青春岁月。我想我再也没见过我的两位父母。或许是在宣布我获得班级第一名的典礼上见过？",shape=box,color=blue];
		3138 -> 3141;
	3139 [label="我认为这个问题会因人而异，看法也可能大相径庭。我刚到的时候，那些高年级的男生打我毫不留情，教训也极其残酷有效。",shape=box,color=blue];
		3139 -> 3142;
	3140 [label="Add 1 to Thermostat",color=orange];
		3140 -> 3131;
	3141 [label="我相信那是他们第一次声称拥有我的所有权。我并不太在意。",shape=box,color=blue];
		3141 -> 3143;
	3142 [label="但我学习能力很强，什么事都能很快上手。我明白，如果我想在科研的这个特定领域有所建树，最好运用创造性的技巧，以免沦为平庸之辈。",shape=box,color=blue];
		3142 -> 3144;
		3142 -> 3145;
	3143 [label="我对父母的记忆不多。虽然有些奥罗金人热衷于抚养自己的后代，但我的父母却并非如此。他们急于摆脱我，开始他们自己的生活。",shape=box,color=blue];
		3143 -> 3146;
		3143 -> 3147;
	3144 [label="哲士竟然允许这种事情发生？",shape=box,color=red];
		3144 -> 3148;
	3145 [label="那还真……可怕。",shape=box,color=red];
		3145 -> 3149;
	3146 [label="这似乎并没有对你的人生造成任何阻碍。",shape=box,color=red];
		3146 -> 3150;
	3147 [label="我很抱歉。这似乎是一种悲惨的结局。",shape=box,color=red];
		3147 -> 3150;
	3148 [label="我可怜的篡位者，当晚那些新生把事情闹得太过火，是校长亲自带来一瓶赤毒和一个男仆来收场的。",shape=box,color=blue];
		3148 -> 3151;
	3149 [label="篡位者，传统是一件强大的工具。一件强大而危险的工具，它能让许多理智的人陷入疯狂的思维模式。",shape=box,color=blue];
		3149 -> 3152;
	3150 [label="恰恰相反。由于缺乏家庭牵绊，我有更多的时间投入到那些在同龄人看来古老过时的军事战略中。 ",shape=box,color=blue];
		3150 -> 3153;
	3151 [label="传统是一件强大的工具。一件强大而危险的工具，它能让许多理智的人陷入疯狂的思维模式。",shape=box,color=blue];
		3151 -> 3154;
		3151 -> 3155;
	3152 [label="当晚那些新生把事情闹得太过火，是校长亲自带来一瓶赤毒和一个男仆来收场的。",shape=box,color=blue];
		3152 -> 3154;
		3152 -> 3155;
	3153 [label="他们当时并不知道，这件事日后会对我帮助有多大。",shape=box,color=blue];
		3153 -> 3156;
		3153 -> 3157;
	3154 [label="那你父母呢？",shape=box,color=red];
		3154 -> 3143;
	3155 [label="你在那里有朋友吗？",shape=box,color=red];
		3155 -> 3158;
	3156 [label="你觉得值得吗？",shape=box,color=red];
		3156 -> 3159;
	3157 [label="不过，你似乎过着孤独的生活。",shape=box,color=red];
		3157 -> 3160;
	3158 [label="不，我一直独来独往。我明白，恐惧很容易制造，也容易被他人利用，但它就像一层脆弱的冰，一遇阳光就会融化。",shape=box,color=blue];
		3158 -> 3161;
	3159 [label="我的同龄人当时并不知道这些学习经历会在未来对我的帮助有多大。但如果你问的是最终是得是失呢？",shape=box,color=blue];
		3159 -> 3162;
	3160 [label="是的。但这就是恶魔生活的必然结果，不是吗？即使在那时，人们要么把我视为无权无势的二流货色和男宠，要么把我视为嗜血的军阀和横冲直撞的怪物。",shape=box,color=blue];
		3160 -> 3163;
	3161 [label="怪物必须被关在黑暗中。如果我要一直保持危险的气场，那就只能独来独往。",shape=box,color=blue];
		3161 -> 3146;
		3161 -> 3147;
	3162 [label="嗯，我不知道。",shape=box,color=blue];
		3162 -> 3164;
		3162 -> 3165;
	3163 [label="我既不受高位人欢迎，也不受底下的人欢迎。而且，我也没有真正意义上的同辈人。",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="你还有一次机会弥补你所做的一切，而他们没有。 ",shape=box,color=red];
		3164 -> 3167;
	3165 [label="不过，他们都死了，你还活着。所以我想，是得。",shape=box,color=red];
		3165 -> 3168;
	3166 [label="Update boolean RoatheUnloved2",color=orange];
		3166 -> 3169;
		3166 -> 3170;
	3167 [label="Add 1 to Thermostat",color=orange];
		3167 -> 3171;
	3168 [label="Add -1 to Thermostat",color=orange];
		3168 -> 3171;
	3169 [label="你还有一次机会弥补你所做的一切，而他们没有。 ",shape=box,color=red];
		3169 -> 3172;
	3170 [label="至少你还有很长的未来，可以自己决定如何度过。而他们没有。",shape=box,color=red];
		3170 -> 3173;
	3171 [label="+5 Chemistry",color=orange];
		3171 -> 3174;
	3172 [label="Add 1 to Thermostat",color=orange];
		3172 -> 3171;
	3173 [label="Add -1 to Thermostat",color=orange];
		3173 -> 3171;
	3174 [label="我想我们很快就会知道了，不是吗？",shape=box,color=blue];
		3174 -> 3175;
	3175 [label="Chat ends.",color=orange];
}