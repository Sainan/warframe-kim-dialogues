digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank4Convo8 begins." [color=orange];
		"RoatheRank4Convo8 begins." -> j412737095;
		"RoatheRank4Convo8 begins." -> j1038552372;
	j412737095 [label="罗瑟，你的童年是怎样的？",shape=box,color=red];
		j412737095 -> j1198091329;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j1198091329 [label="嗯？有趣的问题。是“怎样”的？说实话，我记不太清了。而且，那些承载着记忆的阿耶檀识之星和塑像，我想现在大概早已化为尘埃，或者被烧成内融核心了吧。",shape=box,color=blue];
		j1198091329 -> j3324783405;
	"Chat ends." [color=orange];
	j3324783405 [label="恐怕我只能回忆起一些零星的片段，因为那已经是很久以前的事了。很多时候，我甚至怀疑自己是不是在做梦，或者只是在把历史书上的情节想象出来。",shape=box,color=blue];
		j3324783405 -> j1096769112;
	j1096769112 [label="因此，我承认，我的记忆很可能非常不可靠。你为什么这么问？",shape=box,color=blue];
		j1096769112 -> j2728488021;
		j1096769112 -> j317484664;
		j1096769112 -> j2151993938;
	j2728488021 [label="即使这些故事是虚构的，它们仍然是你对自己成长岁月的描述。它们仍然值得了解。",shape=box,color=red];
		j2728488021 -> j3314548914;
	j317484664 [label="我很好奇作为奥罗金贵族长大是什么样的体验。",shape=box,color=red];
		j317484664 -> j125379053;
	j2151993938 [label="我想知道是什么造就了“你”。你怎么会变成这样？",shape=box,color=red];
		j2151993938 -> j1463890057;
	j3314548914 [label="+5 Chemistry",color=orange];
		j3314548914 -> j1646112746;
	j125379053 [label="我小时候就被送往狂热分子所谓的“寄宿学校”，就像所有注定要成就伟业的奥罗金青年一样。在那里，我接受了各种倾向和天赋的测试和训练。",shape=box,color=blue];
		j125379053 -> j4245033751;
		j125379053 -> j2051043384;
	j1463890057 [label="+5 Chemistry",color=orange];
		j1463890057 -> j4111894961;
	j1646112746 [label="我认同，我们对自己撒的谎往往比真相更重要。篡位者，真是精辟的见解。",shape=box,color=blue];
		j1646112746 -> j3473822607;
	j4245033751 [label="你父母就这样把你送走了？去了多久？",shape=box,color=red];
		j4245033751 -> j532249447;
	j2051043384 [label="那里是怎么样的？",shape=box,color=red];
		j2051043384 -> j3711262984;
	j4111894961 [label="你是试图找出我究竟“做错了”什么？我明白了！真有趣。不过恐怕你在我的童年里，未必能找到你想要的答案。",shape=box,color=blue];
		j4111894961 -> j1005122700;
	j3473822607 [label="Add -1 to Thermostat counter",color=orange];
		j3473822607 -> j125379053;
	j532249447 [label="我的整个青春岁月。我想我再也没见过我的两位父母。或许是在宣布我获得班级第一名的典礼上见过？",shape=box,color=blue];
		j532249447 -> j1218948947;
	j3711262984 [label="我认为这个问题会因人而异，看法也可能大相径庭。我刚到的时候，那些高年级的男生打我毫不留情，教训也极其残酷有效。",shape=box,color=blue];
		j3711262984 -> j3741717160;
	j1005122700 [label="Add 1 to Thermostat counter",color=orange];
		j1005122700 -> j125379053;
	j1218948947 [label="我相信那是他们第一次声称拥有我的所有权。我并不太在意。",shape=box,color=blue];
		j1218948947 -> j4217826504;
	j3741717160 [label="但我学习能力很强，什么事都能很快上手。我明白，如果我想在科研的这个特定领域有所建树，最好运用创造性的技巧，以免沦为平庸之辈。",shape=box,color=blue];
		j3741717160 -> j3394879069;
		j3741717160 -> j2822478623;
	j4217826504 [label="我对父母的记忆不多。虽然有些奥罗金人热衷于抚养自己的后代，但我的父母却并非如此。他们急于摆脱我，开始他们自己的生活。",shape=box,color=blue];
		j4217826504 -> j2112876889;
		j4217826504 -> j1701929677;
	j3394879069 [label="哲士竟然允许这种事情发生？",shape=box,color=red];
		j3394879069 -> j888352004;
	j2822478623 [label="那还真……可怕。",shape=box,color=red];
		j2822478623 -> j1317226070;
	j2112876889 [label="这似乎并没有对你的人生造成任何阻碍。",shape=box,color=red];
		j2112876889 -> j1040266158;
	j1701929677 [label="我很抱歉。这似乎是一种悲惨的生活方式。",shape=box,color=red];
		j1701929677 -> j1040266158;
	j888352004 [label="我可怜的篡位者，当晚那些新生把事情闹得太过火，是校长亲自带来一瓶赤毒和一个男仆来收场的。",shape=box,color=blue];
		j888352004 -> j3116331272;
	j1317226070 [label="篡位者，传统是一件强大的工具。一件强大而危险的工具，它能让许多理智的人陷入疯狂的思维模式。",shape=box,color=blue];
		j1317226070 -> j1300718299;
	j1040266158 [label="恰恰相反。由于缺乏家庭牵绊，我有更多的时间投入到那些在同龄人看来古老过时的军事战略中。 ",shape=box,color=blue];
		j1040266158 -> j803474096;
	j3116331272 [label="传统是一件强大的工具。一件强大而危险的工具，它能让许多理智的人陷入疯狂的思维模式。",shape=box,color=blue];
		j3116331272 -> j2007600638;
		j3116331272 -> j1416125614;
	j1300718299 [label="当晚那些新生把事情闹得太过火，是校长亲自带来一瓶赤毒和一个男仆来收场的。",shape=box,color=blue];
		j1300718299 -> j2007600638;
		j1300718299 -> j1416125614;
	j803474096 [label="他们当时并不知道，这件事日后会对我帮助有多大。",shape=box,color=blue];
		j803474096 -> j3839586377;
		j803474096 -> j2488541520;
	j2007600638 [label="那你父母呢？",shape=box,color=red];
		j2007600638 -> j4217826504;
	j1416125614 [label="你在那里有朋友吗？",shape=box,color=red];
		j1416125614 -> j432086707;
	j3839586377 [label="你觉得值得吗？",shape=box,color=red];
		j3839586377 -> j3387935178;
	j2488541520 [label="不过，你似乎过着孤独的生活。",shape=box,color=red];
		j2488541520 -> j2937625235;
	j432086707 [label="不，我一直独来独往。我明白，恐惧很容易制造，也容易被他人利用，但它就像一层脆弱的冰，一遇阳光就会融化。",shape=box,color=blue];
		j432086707 -> j3705968347;
	j3387935178 [label="我的同龄人当时并不知道这些学习经历会在未来对我的帮助有多大。但如果你问的是最终是得是失呢？",shape=box,color=blue];
		j3387935178 -> j3419700352;
	j2937625235 [label="是的。但这就是恶魔生活的必然结果，不是吗？即使在那时，人们要么把我视为无权无势的二流货色和男宠，要么把我视为嗜血的军阀和横冲直撞的怪物。",shape=box,color=blue];
		j2937625235 -> j1756416107;
	j3705968347 [label="怪物必须被关在黑暗中。如果我要一直保持危险的气场，那就只能独来独往。",shape=box,color=blue];
		j3705968347 -> j2112876889;
		j3705968347 -> j1701929677;
	j3419700352 [label="嗯，我不知道。",shape=box,color=blue];
		j3419700352 -> j314123526;
		j3419700352 -> j3935905852;
	j1756416107 [label="我既不受高位人欢迎，也不受底下的人欢迎。而且，我也没有真正意义上的同辈人。",shape=box,color=blue];
		j1756416107 -> j299591844;
	j314123526 [label="你还有一次机会弥补你所做的一切，而他们没有。 ",shape=box,color=red];
		j314123526 -> j3913919809;
	j3935905852 [label="不过，他们都死了，你还活着。所以我想，是得。",shape=box,color=red];
		j3935905852 -> j4139461919;
	j299591844 [label="Boolean RoatheUnloved2 is now true.",color=orange];
		j299591844 -> j314123526;
		j299591844 -> j2920676639;
	j3913919809 [label="Add 1 to Thermostat counter",color=orange];
		j3913919809 -> j1058382200;
	j4139461919 [label="Add -1 to Thermostat counter",color=orange];
		j4139461919 -> j1058382200;
	j2920676639 [label="至少你还有很长的未来，可以自己决定如何度过。而他们没有。",shape=box,color=red];
		j2920676639 -> j4139461919;
	j1058382200 [label="+5 Chemistry",color=orange];
		j1058382200 -> j3082984559;
	j3082984559 [label="我想我们很快就会知道了，不是吗？",shape=box,color=blue];
		j3082984559 -> "Chat ends.";
}