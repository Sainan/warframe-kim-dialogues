	j3067666501 [label="语音留言：连接",shape=box,color=blue];
		j3067666501 -> j4177701590;
	j4177701590 [label="文字记录：当 Sentient 建成通往 Tau 的星际航道时，并没有举行盛大的仪式。它只是默默地开始运行。",shape=box,color=blue];
		j4177701590 -> j2856359257;
	j2856359257 [label="当然，仪式很快就被创造出来，因为没有哪个真正的奥罗金人会不讲究到忽略一些礼节和仪式就去擤鼻涕。",shape=box,color=blue];
		j2856359257 -> j2742580729;
	j2742580729 [label="第一批穿越过去的运输队引起了很大的轰动。",shape=box,color=blue];
		j2742580729 -> j413114533;
	j413114533 [label="那是执行者托尔米斯的庄严巡洋舰，选择由托尔米斯率领远征军舰，可以视为对执行者涂沃在扎里曼 10-0 号事件中犯下的骇人听闻的罪行的一种集体谴责。",shape=box,color=blue];
		j413114533 -> j3098843623;
	j3098843623 [label="托尔米斯出发了，又回来了，带来了对新星系和待殖民新世界的奇妙而珍贵的回忆。 ",shape=box,color=blue];
		j3098843623 -> j1385265958;
	j1385265958 [label="几天之内，一支殖民船队又出发了，渴望踏上这片处女地。",shape=box,color=blue];
		j1385265958 -> j3391699074;
	j3391699074 [label="随后发生的 Sentient 攻击破坏了气氛。",shape=box,color=blue];
		j3391699074 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}