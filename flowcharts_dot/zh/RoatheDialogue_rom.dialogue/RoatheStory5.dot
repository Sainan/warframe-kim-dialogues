	"Chat ends." [color=orange];
	j2039376441 [label="语音留言：发明",shape=box,color=blue];
		j2039376441 -> j1958446131;
	j1958446131 [label="文字记录：现在，我记得武术科研的发展最初是以娱乐的形式呈现的。 ",shape=box,color=blue];
		j1958446131 -> j442675274;
	j442675274 [label="就像一群放荡不羁的浪荡子在竞技场马戏团里观看罪犯被处死一样。",shape=box,color=blue];
		j442675274 -> j460490571;
	j460490571 [label="我们自以为想出了新颖刺激的方法来对付远逊于自己的敌人。",shape=box,color=blue];
		j460490571 -> j4009333483;
	j4009333483 [label="真是太自作多情了。事实上，我们只是在绝望中摸索，因为我们深知自己根本不是这些变化莫测的敌人的对手。",shape=box,color=blue];
		j4009333483 -> j651977542;
	j651977542 [label="它们像一群孩子吞噬臃肿的母亲一样，将我们撕碎。",shape=box,color=blue];
		j651977542 -> j1413190279;
	j1413190279 [label="我们干瘪枯萎，被时间的篇章挤压，最终被淘汰出局。",shape=box,color=blue];
		j1413190279 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}