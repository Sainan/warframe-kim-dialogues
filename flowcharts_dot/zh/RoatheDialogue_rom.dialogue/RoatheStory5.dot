	2173 [label="Chat ends.",color=orange];
	2172 [label="文字记录：现在，我记得武术科研的发展最初是以娱乐的形式呈现的。 ",shape=box,color=blue];
		2172 -> 5692;
	5692 [label="就像一群放荡不羁的浪荡子在竞技场马戏团里观看罪犯被处死一样。",shape=box,color=blue];
		5692 -> 2169;
	2169 [label="我们自以为想出了新颖刺激的方法来对付远逊于自己的敌人。",shape=box,color=blue];
		2169 -> 2170;
	2170 [label="真是太自作多情了。事实上，我们只是在绝望中摸索，因为我们深知自己根本不是这些变化莫测的敌人的对手。",shape=box,color=blue];
		2170 -> 5685;
	5685 [label="它们像一群孩子吞噬臃肿的母亲一样，将我们撕碎。",shape=box,color=blue];
		5685 -> 5686;
	5686 [label="我们干瘪枯萎，被时间的篇章挤压，最终被淘汰出局。",shape=box,color=blue];
		5686 -> 2168;
	2168 [label="Add 1 to HellStory",color=orange];
		2168 -> 2332;
