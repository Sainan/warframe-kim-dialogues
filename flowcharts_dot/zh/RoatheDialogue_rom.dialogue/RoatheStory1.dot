	2130 [label="语音留言：尼托",shape=box,color=blue];
		2130 -> 2132;
	2134 [label="Chat ends.",color=orange];
	2132 [label="文字记录：她的疯狂之所以具有诱惑力，是因为它明目张胆。",shape=box,color=blue];
		2132 -> 5636;
	5636 [label="你总能清楚地知道自己和她在一起的处境——就在深渊的边缘。",shape=box,color=blue];
		5636 -> 5635;
	5635 [label="跳进去吧，她的眼睛闪烁着某种宇宙级玩笑般的喜悦，对我说。",shape=box,color=blue];
		5635 -> 5637;
	5637 [label="透过她疯狂的幻象，我得以逃离奥罗金人漫长而黯淡的停滞生活。",shape=box,color=blue];
		5637 -> 2136;
	2136 [label="几个世纪前，我们所有的感官都麻木不仁。然而，她依然以她独特的方式，鲜活如初。",shape=box,color=blue];
		2136 -> 5638;
	5638 [label="永恒不灭，她的贪婪无止境。一天晚上，她叫我去她浴室。我迈着大步走过香水和鲜血交织的水洼，恭敬地立正站好。",shape=box,color=blue];
		5638 -> 5639;
	5639 [label="“罗瑟，我无聊死了。咱们把其他奥罗金人都杀了，然后接管吧。”",shape=box,color=blue];
		5639 -> 2135;
	2135 [label="Add 1 to HellStory",color=orange];
		2135 -> 2328;
