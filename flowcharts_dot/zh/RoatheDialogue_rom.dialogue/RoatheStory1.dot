	"Chat ends." [color=orange];
	j3123760954 [label="语音留言：尼托",shape=box,color=blue];
		j3123760954 -> j3653573851;
	j3653573851 [label="文字记录：她的疯狂之所以具有诱惑力，是因为它明目张胆。",shape=box,color=blue];
		j3653573851 -> j1997250375;
	j1997250375 [label="你总能清楚地知道自己和她在一起的处境——就在深渊的边缘。",shape=box,color=blue];
		j1997250375 -> j1655499864;
	j1655499864 [label="跳进去吧，她的眼睛闪烁着某种宇宙级玩笑般的喜悦，对我说。",shape=box,color=blue];
		j1655499864 -> j1038087607;
	j1038087607 [label="透过她疯狂的幻象，我得以逃离奥罗金人漫长而黯淡的停滞生活。",shape=box,color=blue];
		j1038087607 -> j2247856488;
	j2247856488 [label="几个世纪前，我们所有的感官都麻木不仁。然而，她依然以她独特的方式，鲜活如初。",shape=box,color=blue];
		j2247856488 -> j2723950051;
	j2723950051 [label="永恒不灭，她的贪婪无止境。一天晚上，她叫我去她浴室。我迈着大步走过香水和鲜血交织的水洼，恭敬地立正站好。",shape=box,color=blue];
		j2723950051 -> j166454535;
	j166454535 [label="“罗瑟，我无聊死了。咱们把其他奥罗金人都杀了，然后接管吧。”",shape=box,color=blue];
		j166454535 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}