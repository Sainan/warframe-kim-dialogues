	2287 [label="语音留言：战甲",shape=box,color=blue];
		2287 -> 2286;
	2284 [label="Chat ends.",color=orange];
	2286 [label="文字记录：起初，战甲看起来更像是一种艺术表达，而不是一种真正的武器。",shape=box,color=blue];
		2286 -> 2285;
	2285 [label="战争已经几乎败了；Sentient 不可战胜；那么，让我们创造这些奇异而超现实的战士，并为他们配备古老血统的武器。",shape=box,color=blue];
		2285 -> 2282;
	2282 [label="至少我们的失败会很壮烈，令人难忘。",shape=box,color=blue];
		2282 -> 2283;
	2283 [label="但出乎所有人意料的是，他们最终取得了胜利。很快，那些匪夷所思的英雄事迹就从前线传了回来。",shape=box,color=blue];
		2283 -> 5715;
	5715 [label="战甲如同天使般从天而降，解救俘虏，摧毁 Sentient 的据点。即使单独行动，它们也堪称奇迹；成群结队时，它们更是神一般的存在。",shape=box,color=blue];
		5715 -> 5716;
	5716 [label="难怪它们会被视为纯粹的宣传工具。",shape=box,color=blue];
		5716 -> 2281;
	2281 [label="Add 1 to HellStory",color=orange];
		2281 -> 2344;
	2344 [label="{\"Id\":2344,\"Incoming\":[2281],\"Outgoing\":[2280],\"GraphPos\":[4697,-4956],\"CompletionType\":1}",color=orange];
		2344 -> 2280;
