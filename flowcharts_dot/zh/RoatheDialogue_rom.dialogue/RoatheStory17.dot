	"Chat ends." [color=orange];
	j1930387735 [label="语音留言：战甲",shape=box,color=blue];
		j1930387735 -> j503532375;
	j503532375 [label="文字记录：起初，战甲看起来更像是一种艺术表达，而不是一种真正的武器。",shape=box,color=blue];
		j503532375 -> j2899844065;
	j2899844065 [label="战争已经几乎败了；Sentient 不可战胜；那么，让我们创造这些奇异而超现实的战士，并为他们配备古老血统的武器。",shape=box,color=blue];
		j2899844065 -> j2076965737;
	j2076965737 [label="至少我们的失败会很壮烈，令人难忘。",shape=box,color=blue];
		j2076965737 -> j2072073243;
	j2072073243 [label="但出乎所有人意料的是，他们最终取得了胜利。很快，那些匪夷所思的英雄事迹就从前线传了回来。",shape=box,color=blue];
		j2072073243 -> j2497973935;
	j2497973935 [label="战甲如同天使般从天而降，解救俘虏，摧毁 Sentient 的据点。即使单独行动，它们也堪称奇迹；成群结队时，它们更是神一般的存在。",shape=box,color=blue];
		j2497973935 -> j3517075292;
	j3517075292 [label="难怪它们会被视为纯粹的宣传工具。",shape=box,color=blue];
		j3517075292 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}