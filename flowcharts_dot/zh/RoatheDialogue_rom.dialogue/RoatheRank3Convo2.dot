	1569 [label="为了弥补​我们​以前​所犯​的​错误，我们​唯​一​能​做​的​，​​就​是​目光​坚定​地​向​前看。​",shape=box,color=red];
		1569 -> 1574;
	1564 [label="毕竟她是伟大的尼托，是一位执行者。",shape=box,color=blue];
		1564 -> 1561;
	1570 [label="虚空啊，当然不！如果她哪天下午喝醉了从气闸里溜出去，就能解决我很多该死的麻烦事了。",shape=box,color=blue];
		1570 -> 1575;
	1571 [label="+5 Chemistry",color=orange];
		1571 -> 1576;
	1572 [label="虚空啊，当然不！漂泊者，永远不要相信奥罗金人。包括我。尤其不要相信我！爱我们，恨我们，崇拜我们，鄙视我们都好——但永远，永远不要相信我们。",shape=box,color=blue];
