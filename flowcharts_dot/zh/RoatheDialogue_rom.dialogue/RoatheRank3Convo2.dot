	"Chat ends." [color=orange];
	j225248303 [label="你​为什么​问​我​这个​问题？​漂泊者，​你​想​知道​什么？​你​一定​不​是​在​问军需​的​下落。​",shape=box,color=blue];
		j225248303 -> j2026778178;
	j2914820103 [label="为什么这么问？打算回到过去打破指挥官创下的纪录？需要推翻极权政府的建议？寻找那个埋藏着的、足以引爆整个星球的军需？",shape=box,color=blue];
		j2914820103 -> j1870720405;
	j2026778178 [label="我为什么要信任你？我当初为什么会信任你？！",shape=box,color=blue];
		j2026778178 -> j2310817378;
	j1870720405 [label="或者你只是在闲聊？",shape=box,color=blue];
		j1870720405 -> j2603671966;
		j1870720405 -> j3360782121;
		j1870720405 -> j2599468583;
	j2310817378 [label="Check boolean RoatheResetForgiven",color=orange];
		j2310817378 -> j2901515391 [label=true,color=green];
		j2310817378 -> j2380960142 [label=false,color=brown];
	j2603671966 [label="我很想知道你是否后悔过这些决定，说实话。如果你可以重来，你会不会改变你之前的计划？",shape=box,color=red];
		j2603671966 -> j151156516;
	j3360782121 [label="我很好奇，要想出这样一个计划会是怎样。那一定是一项杰作。",shape=box,color=red];
		j3360782121 -> j2547955775;
	j2599468583 [label="老实说，如果能知道你把那些武器藏在了可以拿到的地方，或许是件好事。",shape=box,color=red];
		j2599468583 -> j509949719;
	j2901515391 [label="我已经原谅你做了那件事。我只是希望我能记起为什么——为什么！为什么偏偏是你？！",shape=box,color=blue];
		j2901515391 -> j280151164;
		j2901515391 -> j3107953835;
	j2380960142 [label="为什么！为什么偏偏是你？！",shape=box,color=blue];
		j2380960142 -> j3107953835;
		j2380960142 -> j3497966791;
	j151156516 [label="Add 1 to Thermostat counter",color=orange];
		j151156516 -> j1802021843;
	j2547955775 [label="Add -1 to Thermostat counter",color=orange];
		j2547955775 -> j355424757;
	j509949719 [label="+5 Chemistry",color=orange];
		j509949719 -> j289865832;
	j280151164 [label="我知道。我依然感到非常抱歉。",shape=box,color=red];
		j280151164 -> j4197934467;
	j3107953835 [label="我想让你明白其中的原因。",shape=box,color=red];
		j3107953835 -> j3754258782;
	j3497966791 [label="罗瑟，我仍然很抱歉辜负了你的信任。信不信由你，我不是故意的。",shape=box,color=red];
		j3497966791 -> j3958753056;
	j1802021843 [label="我唯一后悔的是它最终未能实现。我后悔浪费了时间。",shape=box,color=blue];
		j1802021843 -> j2368002744;
	j355424757 [label="篡位者，那的确是一部杰作。",shape=box,color=blue];
		j355424757 -> j2368002744;
	j289865832 [label="很实用。但是，很多我以前“藏”东西的地方，很可能在漫长的岁月中早已不知所踪。",shape=box,color=blue];
		j289865832 -> j3433254931;
	j4197934467 [label="是的，是的。我想我们应该继续这场愚蠢的对话，把我们之前的话题再重复一遍。",shape=box,color=blue];
		j4197934467 -> j40337457;
	j3754258782 [label="+5 Chemistry",color=orange];
		j3754258782 -> j3147535507;
	j3958753056 [label="是的，你可能认为自己的行为不会有任何后果。但不管怎样，我们还是应该继续这场愚蠢的对话，重复一遍，然后继续过我们自己的生活。",shape=box,color=blue];
		j3958753056 -> j40337457;
	j2368002744 [label="+5 Chemistry",color=orange];
		j2368002744 -> j4042152393;
	j3433254931 [label="许多地点甚至连我自己都不知道。计划极其复杂，层层叠叠，错综复杂。",shape=box,color=blue];
		j3433254931 -> j1268358770;
	j40337457 [label="你刚才问的是什么来着？啊！对了。“我打算怎么推翻那些执行者？” ",shape=box,color=blue];
		j40337457 -> j4045299969;
	j3147535507 [label="难道要一遍又一遍地重复那些毫无意义的对话，讨论我为什么要杀害那些早就成灰的人吗？至少这是一种务实的做法。",shape=box,color=blue];
		j3147535507 -> j40337457;
	j4042152393 [label="这个计划极其复杂，层层叠叠，层数不胜数。如果第一个刺客失败，其他刺客还会杀死他们手下的刺客。",shape=box,color=blue];
		j4042152393 -> j856034063;
	j1268358770 [label="如果第一个刺客失败，那么其他刺客就会把剩下的刺客杀死。",shape=box,color=blue];
		j1268358770 -> j856034063;
	j4045299969 [label="为什么​问​这个？​",shape=box,color=blue];
		j4045299969 -> j2603671966;
		j4045299969 -> j3360782121;
		j4045299969 -> j2599468583;
	j856034063 [label="很多建筑、整艘飞船甚至整颗卫星上都布满了炸弹，这些炸弹都已安装完毕，准备用偷来的炸药引爆。一条星际航道也随时可能脱离轨道。",shape=box,color=blue];
		j856034063 -> j1334926624;
	j1334926624 [label="这一切都被精心策划，以便在时机成熟时伪装成一场“巨大的 Sentient 灾难”。一旦那些执行者和皇帝被……解决掉，我和尼托就会宣布帝国进入紧急状态。",shape=box,color=blue];
		j1334926624 -> j1742364006;
	j1742364006 [label="Boolean RoatheTraitor2 is now true.",color=orange];
		j1742364006 -> j285070892;
	j285070892 [label="Check boolean RoatheExecutor1",color=orange];
		j285070892 -> j2530134458 [label=true,color=green];
		j285070892 -> j2419956282 [label=true,color=green];
		j285070892 -> j3373346116 [label=true,color=green];
		j285070892 -> j2530134458 [label=false,color=brown];
		j285070892 -> j2419956282 [label=false,color=brown];
	j2530134458 [label="如果你的计划失败了怎么办？",shape=box,color=red];
		j2530134458 -> j421408686;
	j2419956282 [label="那你之后打算怎么办？",shape=box,color=red];
		j2419956282 -> j491578784;
	j3373346116 [label="你打算如何对付尼托？",shape=box,color=red];
		j3373346116 -> j1932713100;
	j421408686 [label="这是我预想的成千上万种可能结果之一。 ",shape=box,color=blue];
		j421408686 -> j3155399866;
	j491578784 [label="我们原先的计划有上千种可能的结果。对于每一个可能影响结果的变量，我们都设计了一条可能的路径。 ",shape=box,color=blue];
		j491578784 -> j3544319977;
	j1932713100 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1932713100 -> j3994673865 [label=true,color=green];
		j1932713100 -> j2208324486 [label=false,color=brown];
	j3155399866 [label="如果我们彻底失败了，我就会吞“雷克斯”自杀，然后结束这一天。",shape=box,color=blue];
		j3155399866 -> j2731222028;
	j3544319977 [label="对于每一条路径，我都预先设定了结果。对于每一条路径，我都清楚自己打算怎么做。许多路径在总体上相似，但在细节上却截然不同。",shape=box,color=blue];
		j3544319977 -> j2461562927;
	j3994673865 [label="我之前跟你说过什么？因为我觉得我还不够信任你，所以不敢直接告诉你。",shape=box,color=blue];
		j3994673865 -> j3454853194;
		j3994673865 -> j3232760399;
	j2208324486 [label="这是一件非常复杂的事情，需要我们之间进行一番……谈判。",shape=box,color=blue];
		j2208324486 -> j2858338716;
		j2208324486 -> j2861996424;
	j2731222028 [label="为洒出来的赤毒哭泣毫无意义。",shape=box,color=blue];
		j2731222028 -> j1781429622;
		j2731222028 -> j1431195072;
	j2461562927 [label="如果我们彻底失败了，我就会吞“雷克斯”自杀，然后结束这一天。",shape=box,color=blue];
		j2461562927 -> j1386183589;
	j3454853194 [label="你把一切都告诉我了。",shape=box,color=red];
		j3454853194 -> j1477130070;
	j3232760399 [label="那我就不会强迫你告诉我你不想说的话。",shape=box,color=red];
		j3232760399 -> j4027180526;
	j2858338716 [label="这句话里蕴含着很多信息。",shape=box,color=red];
		j2858338716 -> j1247491493;
	j2861996424 [label="什么样的谈判？",shape=box,color=red];
		j2861996424 -> j760109559;
	j1781429622 [label="如果是我我会跑路。",shape=box,color=red];
		j1781429622 -> j282115608;
	j1431195072 [label="你就这样接受了死亡？",shape=box,color=red];
		j1431195072 -> j1935926545;
	j1386183589 [label="如果这次行动只是取得中等程度的成功（最​有​可能​的​结果），那么就需要进行善后工作，确保所有遗留问题都得到解决。当然，我自然也是其中之一。而且我已经采取了一些措施，以确保在短期内我仍然具有足够的价值，不会被像其他成员一样轻易放弃。",shape=box,color=blue];
		j1386183589 -> j1514831445;
	j1477130070 [label="那我再重复一遍也没用了，对吧？事实上，这场谈话根本毫无意义。祝你今天余下的时间愉快。",shape=box,color=blue];
		j1477130070 -> "Chat ends.";
	j4027180526 [label="+5 Chemistry",color=orange];
		j4027180526 -> j2738139024;
	j1247491493 [label="+5 Chemistry",color=orange];
		j1247491493 -> j3749708507;
	j760109559 [label="你能想到的各种谈判。",shape=box,color=blue];
		j760109559 -> j1861383400;
	j282115608 [label="我的篡位者，那你跑到哪里去？不是每个人在慌乱时都能躲进什么口袋维度的。",shape=box,color=blue];
		j282115608 -> j2003283383;
	j1935926545 [label="我别无选择，不是吗？无处可去，无处可藏。",shape=box,color=blue];
		j1935926545 -> j2003283383;
	j1514831445 [label="如果情况大获成功，我就会继续推进计划的第二阶段。",shape=box,color=blue];
		j1514831445 -> j2242015181;
		j1514831445 -> j3578113903;
	j2738139024 [label="很好。我得说，这的确是一件非常复杂的事情，需要我们之间进行一番……谈判。",shape=box,color=blue];
		j2738139024 -> j2858338716;
		j2738139024 -> j2861996424;
	j3749708507 [label="沙子下还埋藏了数百年呢。",shape=box,color=blue];
		j3749708507 -> j1861383400;
	j1861383400 [label="Boolean RoatheExecutor2 is now true.",color=orange];
		j1861383400 -> j1717274806;
	j2003283383 [label="尼托曾痛苦地表示，如果我们失败了，我将成为公众的牺牲品。",shape=box,color=blue];
		j2003283383 -> j1212197631;
		j2003283383 -> j888696274;
	j2242015181 [label="第二阶段是什么？",shape=box,color=red];
		j2242015181 -> j1705109456;
	j3578113903 [label="杀了尼托？",shape=box,color=red];
		j3578113903 -> j596495675;
	j1717274806 [label="Evaluate expressions on HellStory counter",color=orange];
		j1717274806 -> j1287100936 [label="x >= 7",color=purple];
		j1717274806 -> j2254126383 [label="x < 7",color=purple];
		j1717274806 -> j2254126383 [label="false",color=purple];
	j1212197631 [label="你对此不介意吗？",shape=box,color=red];
		j1212197631 -> j3593706745;
	j888696274 [label="如果​她​想​要​你​的​忠诚，​就​不​应该​威胁​你。​",shape=box,color=red];
		j888696274 -> j2990693885;
	j1705109456 [label="当然，杀了尼托。这几乎算不上什么意外。她自己也知道这很可能会发生，而且经常拿这件事来嘲讽我。",shape=box,color=blue];
		j1705109456 -> j734961898;
		j1705109456 -> j1076344337;
	j596495675 [label="+5 Chemistry",color=orange];
		j596495675 -> j1275536292;
	j1287100936 [label="你知道的，我是她众多玩物之一。",shape=box,color=blue];
		j1287100936 -> j1687532511;
	j2254126383 [label="我是她众多伙伴之一，你应该明白这一点。",shape=box,color=blue];
		j2254126383 -> j1473789588;
		j2254126383 -> j481825237;
	j3593706745 [label="+5 Chemistry",color=orange];
		j3593706745 -> j2468729017;
	j2990693885 [label="关于奥罗金人，你必须明白的一点是，我们总是互相算计。 ",shape=box,color=blue];
		j2990693885 -> j1493623017;
	j734961898 [label="她对此并不介意？",shape=box,color=red];
		j734961898 -> j1544944195;
	j1076344337 [label="你们俩早就知道彼此要杀了对方？",shape=box,color=red];
		j1076344337 -> j1135694983;
	j1275536292 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1275536292 -> j1763634413 [label=true,color=green];
		j1275536292 -> j776165341 [label=false,color=brown];
	j1687532511 [label="我曾以为我们是伙伴。在政治上，在阴谋上，在床上……",shape=box,color=blue];
		j1687532511 -> j97164154;
	j1473789588 [label="商业伙伴？",shape=box,color=red];
		j1473789588 -> j952198833;
	j481825237 [label="伙伴，什么伙伴？",shape=box,color=red];
		j481825237 -> j3602255420;
	j2468729017 [label="当然介意。只是你必须明白，奥罗金人一直以来都在互相算计。 ",shape=box,color=blue];
		j2468729017 -> j1493623017;
	j1493623017 [label="我知道，只要杀了我有可能帮助尼托实现目标，她随时都会毫不犹豫地杀了我。",shape=box,color=blue];
		j1493623017 -> j3828270781;
	j1544944195 [label="篡位者，我觉得她很享受这种挑战。那种危险感。那种知道自己正和一个想要她命的人睡的刺激感。",shape=box,color=blue];
		j1544944195 -> j779040486;
	j1135694983 [label="我倒想假装我们是第一个陷入这种境地的奥罗金人，但其实这种情况并不算罕见。",shape=box,color=blue];
		j1135694983 -> j779040486;
	j1763634413 [label="正是！说得你好像以前就听过这句话似的。但这几乎算不上什么意外，而且她经常也拿这件事来嘲讽我。",shape=box,color=blue];
		j1763634413 -> j734961898;
		j1763634413 -> j1076344337;
	j776165341 [label="没错！这几乎算不上什么意外。她自己也知道这很可能会发生，而且经常拿这件事来嘲讽我。",shape=box,color=blue];
		j776165341 -> j734961898;
		j776165341 -> j1076344337;
	j97164154 [label="我当然不认为我们是平等的。她是执行者，伟大的尼托。但我自认为在她手下之中，我是排第一的。",shape=box,color=blue];
		j97164154 -> j2483958087;
	j952198833 [label="你真可爱。是的，从某种意义上说，我们是商业伙伴。但我们在很多其他更重要的方面也是伙伴。",shape=box,color=blue];
		j952198833 -> j3602255420;
	j3602255420 [label="在战争上。在政治上。在阴谋上。在床上。",shape=box,color=blue];
		j3602255420 -> j178701763;
	j3828270781 [label="然而她也知道，我在她背后磨刀，热切地盼望着砍下她的头颅。",shape=box,color=blue];
		j3828270781 -> j1386929393;
	j779040486 [label="我活得越久，就越觉得我们人类或许并非天生就适合永生。",shape=box,color=blue];
		j779040486 -> j3949977916;
	j2483958087 [label="我真蠢……",shape=box,color=blue];
		j2483958087 -> j3121773792;
		j2483958087 -> j1058339010;
		j2483958087 -> j2638518142;
		j2483958087 -> j2928050111;
		j2483958087 -> j575691022;
	j178701763 [label="但我怀疑我可能记错了。我怀疑用“伙伴”这个词来形容我们之间的关系是否太过强烈。 ",shape=box,color=blue];
		j178701763 -> j3130748833;
	j1386929393 [label="可以说，我们的关系……很复杂。",shape=box,color=blue];
		j1386929393 -> j575691022;
		j1386929393 -> j2928050111;
		j1386929393 -> j2638518142;
		j1386929393 -> j3121773792;
		j1386929393 -> j1058339010;
	j3949977916 [label="但是，没错。可以说，我和尼托的关系……很复杂。",shape=box,color=blue];
		j3949977916 -> j575691022;
		j3949977916 -> j2928050111;
		j3949977916 -> j2638518142;
		j3949977916 -> j3121773792;
		j3949977916 -> j1058339010;
	j3121773792 [label="你在乎她吗？",shape=box,color=red];
		j3121773792 -> j3213265970;
	j1058339010 [label="你爱过她吗？",shape=box,color=red];
		j1058339010 -> j3381856206;
	j2638518142 [label="你信任她吗？",shape=box,color=red];
		j2638518142 -> j1008529655;
	j2928050111 [label="不要后悔你做过的事。你已经做出了选择，没有回头路，只能向前看。",shape=box,color=red];
		j2928050111 -> j1309714144;
	j575691022 [label="为了弥补​我们​以前​所犯​的​错误，我们​唯​一​能​做​的​，​​就​是​目光​坚定​地​向​前看。​",shape=box,color=red];
		j575691022 -> j76074366;
	j3130748833 [label="毕竟她是伟大的尼托，是一位执行者。",shape=box,color=blue];
		j3130748833 -> j2483958087;
	j3213265970 [label="虚空啊，当然不！如果她哪天下午喝醉了从气闸里溜出去，就能解决我很多该死的麻烦事了。",shape=box,color=blue];
		j3213265970 -> j4005974934;
	j3381856206 [label="+5 Chemistry",color=orange];
		j3381856206 -> j1905053856;
	j1008529655 [label="虚空啊，当然不！漂泊者，永远不要相信奥罗金人。包括我。尤其不要相信我！爱我们，恨我们，崇拜我们，鄙视我们都好——但永远，永远不要相信我们。",shape=box,color=blue];
		j1008529655 -> j2595835083;
	j1309714144 [label="Add -1 to Thermostat counter",color=orange];
		j1309714144 -> j374674693;
	j76074366 [label="Add 1 to Thermostat counter",color=orange];
		j76074366 -> j2557658375;
	j4005974934 [label="我绝对、肯定地憎恨她，我最渴望的就是用我的双手慢慢地、小心翼翼地、轻轻地把她身上的蓝色皮肤剥下来。",shape=box,color=blue];
		j4005974934 -> j2065195236;
		j4005974934 -> j3471772745;
