		1493 -> 1496;
	1492 [label="难道要一遍又一遍地重复那些毫无意义的对话，讨论我为什么要杀害那些早就成灰的人吗？至少这是一种务实的做法。",shape=box,color=blue];
		1492 -> 1493;
