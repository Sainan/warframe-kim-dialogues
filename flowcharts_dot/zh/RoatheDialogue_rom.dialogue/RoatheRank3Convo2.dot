		1552 -> 1559;
	1554 [label="正是！说得你好像以前就听过这句话似的。但这几乎算不上什么意外，而且她经常也拿这件事来嘲讽我。",shape=box,color=blue];
		1554 -> 1543;
		1554 -> 1544;
	1553 [label="没错！这几乎算不上什么意外。她自己也知道这很可能会发生，而且经常拿这件事来嘲讽我。",shape=box,color=blue];
		1553 -> 1543;
		1553 -> 1544;
	1557 [label="我当然不认为我们是平等的。她是执行者，伟大的尼托。但我自认为在她手下之中，我是排第一的。",shape=box,color=blue];
		1557 -> 1561;
	1555 [label="你真可爱。是的，从某种意义上说，我们是商业伙伴。但我们在很多其他更重要的方面也是伙伴。",shape=box,color=blue];
		1555 -> 1556;
	1556 [label="在战争上。在政治上。在阴谋上。在床上。",shape=box,color=blue];
		1556 -> 1560;
	1558 [label="然而她也知道，我在她背后磨刀，热切地盼望着砍下她的头颅。",shape=box,color=blue];
		1558 -> 1562;
	1559 [label="我活得越久，就越觉得我们人类或许并非天生就适合永生。",shape=box,color=blue];
