		1591 -> 1606;
		1591 -> 1607;
	1592 [label="重温过去的所作所为、过去的失败和遗憾有什么意义呢？我们无法改变它们——即使拥有穿越时空的能力，试图“重做”已经“做过”的事情也只会走向疯狂。",shape=box,color=blue];
		1592 -> 1608;
