		1489 -> 1493;
	1487 [label="+5 Chemistry",color=orange];
		1487 -> 1492;
	1488 [label="是的，你可能认为自己的行为不会有任何后果。但不管怎样，我们还是应该继续这场愚蠢的对话，重复一遍，然后继续过我们自己的生活。",shape=box,color=blue];
