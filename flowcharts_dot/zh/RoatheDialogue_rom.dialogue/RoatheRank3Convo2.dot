	1468 [label="你​为什么​问​我​这个​问题？​漂泊者，​你​想​知道​什么？​你​一定​不​是​在​问军需​的​下落。​",shape=box,color=blue];
		1468 -> 1470;
	1469 [label="为什么这么问？打算回到过去打破指挥官创下的纪录？需要推翻极权政府的建议？寻找那个埋藏着的、足以引爆整个星球的军需？",shape=box,color=blue];
