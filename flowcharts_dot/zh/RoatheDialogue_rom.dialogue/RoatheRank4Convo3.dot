	j1935202002 [label="我真的非常讨厌我竟然在某种程度上同意你的观点。",shape=box,color=red];
		j1935202002 -> j1591128285;
	j3431630818 [label="你知道我承受的痛苦和 Tenno 一样多，对吧？",shape=box,color=red];
		j3431630818 -> j749658614;
	j2006425143 [label="我不会背叛他们的信任。",shape=box,color=red];
