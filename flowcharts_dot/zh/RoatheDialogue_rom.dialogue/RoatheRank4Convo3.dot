	j3672194175 [label="+5 Chemistry",color=orange];
		j3672194175 -> j3355235175;
	j1591128285 [label="+5 Chemistry",color=orange];
		j1591128285 -> j655221049;
	j749658614 [label="谁又能说我没有和他们进行同样的对话呢？",shape=box,color=blue];
		j749658614 -> j1750528179;
