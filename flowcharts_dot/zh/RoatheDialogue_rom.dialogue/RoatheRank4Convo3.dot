	"RoatheRank4Convo3 begins." [color=orange];
		"RoatheRank4Convo3 begins." -> j3359810865;
	j3359810865 [label="篡位者，请回答我这个问题：如果真的到了生死之战，你觉得你能击败你的另一个自己——Tenno 吗？",shape=box,color=blue];
		j3359810865 -> j1007999976;
		j3359810865 -> j747556118;
		j3359810865 -> j1038552372;
	j1007999976 [label="什么？为什么……？",shape=box,color=red];
		j1007999976 -> j3685715198;
	j747556118 [label="我不想继续这个话题。",shape=box,color=red];
		j747556118 -> j2279200648;
	j1038552372 [label="[结束]",shape=box,color=red];
		j1038552372 -> "Chat ends.";
	j3685715198 [label="因为​不​知​你​有​没​有​注意​到，​“Lo​t​us”​不仅​是​ Sentient​——​她​更​是​把​月​球​送入​虚空​的​人​——​而且​她​的​神经线路​也​明显​出现​失控。​",shape=box,color=blue];
		j3685715198 -> j3588301063;
		j3685715198 -> j401957033;
		j3685715198 -> j1802270138;
		j3685715198 -> j2520954786;
		j3685715198 -> j1718443789;
	j2279200648 [label="我没有在冒犯你。你应该明白，我是认真的。这只是就事论事。",shape=box,color=blue];
		j2279200648 -> j3685715198;
	"Chat ends." [color=orange];
	j3588301063 [label="她没事。你根本不知道自己在说什么。",shape=box,color=red];
		j3588301063 -> j1578712261;
	j401957033 [label="她​的​神经线路​出现​失控？你这话是什么意思？",shape=box,color=red];
		j401957033 -> j4204911539;
	j1802270138 [label="不，我不会这么做。Lotus 救了我的命。她无数次拯救了 Tenno 的生命。我们的一切都归功于她。",shape=box,color=red];
		j1802270138 -> j1531540528;
	j2520954786 [label="罗瑟，闭嘴，我不和你聊了。[结束]",shape=box,color=red];
		j2520954786 -> j2820002516;
	j1718443789 [label="我知道，我也很担心。但她为我们做了那么多，我不能背弃她。我必须支持她。",shape=box,color=red];
		j1718443789 -> j3431244527;
	j1578712261 [label="我不知道吗？注意！看看周围！她究竟花了多少岁月站在悬崖边，拿着老式寻呼机，自己哼着歌？凝视着虚空？",shape=box,color=blue];
		j1578712261 -> j2255235818;
	j4204911539 [label="她究竟花了多少岁月站在悬崖边，拿着老式寻呼机，自己哼着歌？凝视着虚空？",shape=box,color=blue];
		j4204911539 -> j2255235818;
	j1531540528 [label="我并非冷漠无情。我理解你的感受。你欠她太多了。我不是要你杀了她，我是要你别再让她影响你身边的人。",shape=box,color=blue];
		j1531540528 -> j4204911539;
	j2820002516 [label="如你所愿。但当这一切崩塌的时候，别来找我帮忙。",shape=box,color=blue];
		j2820002516 -> "Chat ends.";
	j3431244527 [label="+5 Chemistry",color=orange];
		j3431244527 -> j2521701815;
	j2255235818 [label="而现在她只是……在黑暗中潜伏着？将你童年的自我一步步送入记忆深处，为了什么？仅仅因为阿尔布雷希特打了个响指，说了句魔法词，她就能找到回家的路？",shape=box,color=blue];
		j2255235818 -> j3475156583;
	j2521701815 [label="我并非冷漠无情。我理解你的感受。你欠她太多了。我不是要你杀了她，我是要你别再让她影响你身边的人。",shape=box,color=blue];
		j2521701815 -> j1080904475;
	j3475156583 [label="你不觉得可疑吗？你不觉得危险吗？这是个陷阱。她被人操纵了。要么是阿尔布雷希特在操纵，要么是这个所谓的“虚空无情之物”在操纵。她就像一个坏掉的程序。她的枢律失灵了。",shape=box,color=blue];
		j3475156583 -> j1534082412;
	j1080904475 [label="当她站在悬崖边，拿着老式寻呼机，自己哼着歌，凝视着虚空时，你难道没想过她会跳下去吗？",shape=box,color=blue];
		j1080904475 -> j2255235818;
	j1534082412 [label="我不认为她有意伤害你，我觉得她只是被人利用了。但一旦时机到了，你或许需要自卫，你或许需要亲手除掉她。",shape=box,color=blue];
		j1534082412 -> j572871944;
	j572871944 [label="虽然你（但愿如此）很可能明白避免 Lotus 再次失控的必要性，但她那群野性未驯的孩子却不会。所以我再问一遍：",shape=box,color=blue];
		j572871944 -> j2129242728;
	j2129242728 [label="如果那可怕的一天真的到来，你必须动用一切资源去应战，你觉得谁会赢？是你和你拥有的一切，还是 Tenno 与 Lotus 全部的力量？",shape=box,color=blue];
		j2129242728 -> j3849706109;
		j2129242728 -> j114816905;
		j2129242728 -> j4194130228;
	j3849706109 [label="这太蠢了。不行。",shape=box,color=red];
		j3849706109 -> j709909691;
	j114816905 [label="他们大概有……我不知道，一百个吧。还有一个是我，罗瑟。",shape=box,color=red];
		j114816905 -> j1415559942;
	j4194130228 [label="我甚至不知道该从哪里开始。",shape=box,color=red];
		j4194130228 -> j1145786953;
	j709909691 [label="如果你非要把它当成一个愚蠢的游戏，那就当成小孩子玩的理论游戏吧。 ",shape=box,color=blue];
		j709909691 -> j3002357759;
		j709909691 -> j305493293;
	j1415559942 [label="+5 Chemistry",color=orange];
		j1415559942 -> j3366624800;
	j1145786953 [label="那么，你能跟“Tau 之恶魔”对话真是太好了。我之所以被称为战略家是有原因的。让我们从最根本的层面开始：数字。你在这一方面远远落后于他们。 ",shape=box,color=blue];
		j1145786953 -> j4181059854;
	j3002357759 [label="这不是游戏。",shape=box,color=red];
		j3002357759 -> j2183940410;
	j305493293 [label="还要我说最后一次吗？不行。[结束]",shape=box,color=red];
		j305493293 -> "Chat ends.";
	j3366624800 [label="完美。我们已经确立了战场布局的第一条规则：数量。显然，你在数量上完全处于劣势。",shape=box,color=blue];
		j3366624800 -> j4181059854;
	j4181059854 [label="Check boolean IsDating",color=orange];
		j4181059854 -> j2170306665 [label=true,color=green];
		j4181059854 -> j2464378650 [label=false,color=brown];
	j2183940410 [label="你说得对，这不是游戏。而且，这或许会演变成生死之战。你将对抗你的……迷你版自己，以及他那群野性十足的同伴。",shape=box,color=blue];
		j2183940410 -> j2776274622;
	j2170306665 [label="不过嘛，如果你那些关于“私人活动”以及在其他时间线里与原型战甲之间的“绯闻”能被……利用一下，或许就能以某种方式调动那些资源。为此，需要对 Helminth 进行专门的研究和培育……",shape=box,color=blue];
		j2170306665 -> j65425837;
	j2464378650 [label="我曾听闻你在其他时间线里与其他原型战甲之间的互动。或许我们可以以某种方式调动那些资源。为此，需要对 Helminth 进行专门的研究和培育……",shape=box,color=blue];
		j2464378650 -> j65425837;
	j2776274622 [label="顺便一提，这些野性同伴已经被证明是充满暴力且桀骜不驯的，而且众所周知，他们会因为同伴与他们对“正常”的定义相差太远而残酷地驱逐他们。",shape=box,color=blue];
		j2776274622 -> j472320917;
		j2776274622 -> j391624612;
		j2776274622 -> j3478310725;
	j65425837 [label="我甚至不知道这是否可行，但它为我们提供了通往这里的通道，所以我认为没有理由不行……",shape=box,color=blue];
		j65425837 -> j2869709953;
		j65425837 -> j1015997277;
		j65425837 -> j2983921458;
	j472320917 [label="你现在是在暗示 Tenno 是邪恶的吗？",shape=box,color=red];
		j472320917 -> j2090226407;
	j391624612 [label="你在说什么？",shape=box,color=red];
		j391624612 -> j884935503;
	j3478310725 [label="不。我不想聊了。[结束]",shape=box,color=red];
		j3478310725 -> j136072407;
	j2869709953 [label="罗瑟？下地狱吧。",shape=box,color=red];
		j2869709953 -> j3746101777;
	j1015997277 [label="我不会把他们卷入这场混乱。",shape=box,color=red];
		j1015997277 -> j2548201470;
	j2983921458 [label="你在这件事上居然想了这么多，我都有点害怕了。",shape=box,color=red];
		j2983921458 -> j3351413441;
	j2090226407 [label="篡位者，不，不是邪恶。我不相信“邪恶”。我过去不相信，将来也不会相信。我相信 Tenno 和其他人一样，都是奇妙又美丽的人类。他们只是普通人。而且，他们还是孩子。",shape=box,color=blue];
		j2090226407 -> j1415084068;
	j884935503 [label="或许有一天，在某个可怕的日子里，你必须做好准备，去做那些难以想象的事情。",shape=box,color=blue];
		j884935503 -> j3763479871;
	j136072407 [label="你想逃避就逃避吧，但你很清楚我说的每一个字都是真的。你只是不愿意接受而已。",shape=box,color=blue];
		j136072407 -> "Chat ends.";
	j3746101777 [label="+5 Chemistry",color=orange];
		j3746101777 -> j3052765411;
	j2548201470 [label="啊！所以你承认这是场混乱。这算是一种进步。那我至少可以阐述一下我的观点吗？",shape=box,color=blue];
		j2548201470 -> j1531349889;
		j2548201470 -> j1734785293;
	j3351413441 [label="你在这件事上居然没想那么多，我才害怕呢。我能至少阐述一下我的观点吗？",shape=box,color=blue];
		j3351413441 -> j1531349889;
		j3351413441 -> j1734785293;
	j1415084068 [label="这些孩子被迫面对恐怖，犯下暴行，而我亲眼目睹，这种暴行甚至击垮了那些历经数百年磨砺的、意志坚定的奥罗金战士。",shape=box,color=blue];
		j1415084068 -> j499672979;
	j3763479871 [label="Tenno 和其他人一样，都是奇妙又美丽的人类。他们只是普通人。而且，他们还是孩子。",shape=box,color=blue];
		j3763479871 -> j1415084068;
	j3052765411 [label="我​早​就​下​了，​篡位者。​我​已经​在​地狱​里​了。​",shape=box,color=blue];
		j3052765411 -> j155006797;
	j1531349889 [label="好，没问题，请讲，我会听的。",shape=box,color=red];
		j1531349889 -> j3081663420;
	j1734785293 [label="不用了。我受够了。",shape=box,color=red];
		j1734785293 -> j2477637779;
	j499672979 [label="我亲眼见过禁卫——黄金精英禁卫！——在 Tenno 驾驶着战甲冲入战场时，丢下他们神圣的镀金宝剑，转身逃离。",shape=box,color=blue];
		j499672979 -> j863734517;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j3081663420 [label="+5 Chemistry",color=orange];
		j3081663420 -> j704480443;
	j2477637779 [label="我也是。",shape=box,color=blue];
		j2477637779 -> "Chat ends.";
	j863734517 [label="他们自以为那些 Infested 的茧能保护他们的肉体，却保护不了他们的心智。他们变成现在这个样子，并不是他们的错。",shape=box,color=blue];
		j863734517 -> j2143230604;
	j704480443 [label="谢谢。或许有一天，在某个可怕的日子里，你必须做好准备，去做那些难以想象的事情。",shape=box,color=blue];
		j704480443 -> j3763479871;
	j2143230604 [label="他们饱受虚空折磨……被迫杀害或亲眼目睹父母死亡……饱受战争蹂躏……记忆被窃取……被冷冻睡眠数个世纪……",shape=box,color=blue];
		j2143230604 -> j2395690439;
	j2395690439 [label="篡位者，他们居然没有完全变成疯子，这简直是个奇迹。我不是说事情一定会出错，我只是说有可能出错。所以你必须做好准备，以防万一。",shape=box,color=blue];
		j2395690439 -> j1319443507;
	j1319443507 [label="未雨绸缪并无坏处，而不做好准备才是最大的坏处。",shape=box,color=blue];
		j1319443507 -> j3905014435;
		j1319443507 -> j1935202002;
		j1319443507 -> j3431630818;
		j1319443507 -> j2006425143;
	j3905014435 [label="我会……密切关注事态发展。好吗？但我不会背着任何人做事。",shape=box,color=red];
