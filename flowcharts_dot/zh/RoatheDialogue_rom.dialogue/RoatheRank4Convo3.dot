digraph {
	2475 [label="RoatheRank4Convo3 begins.",color=orange];
		2475 -> 2476;
	2476 [label="篡位者，请回答我这个问题：如果真的到了生死之战，你觉得你能击败你的另一个自己——Tenno 吗？",shape=box,color=blue];
		2476 -> 2478;
		2476 -> 2477;
		2476 -> 2479;
	2478 [label="什么？为什么……？",shape=box,color=red];
		2478 -> 2481;
	2477 [label="我不想继续这个话题。",shape=box,color=red];
		2477 -> 2480;
	2479 [label="[结束]",shape=box,color=red];
		2479 -> 2482;
	2481 [label="因为​不​知​你​有​没​有​注意​到，​“Lo​t​us”​不仅​是​ Sentient​——​她​更​是​把​月​球​送入​虚空​的​人​——​而且​她​的​神经线路​也​明显​出现​失控。​",shape=box,color=blue];
		2481 -> 2483;
		2481 -> 2484;
		2481 -> 2485;
		2481 -> 2486;
		2481 -> 2487;
	2480 [label="我没有在冒犯你。你应该明白，我是认真的。这只是就事论事。",shape=box,color=blue];
		2480 -> 2481;
	2482 [label="Chat ends.",color=orange];
	2483 [label="她没事。你根本不知道自己在说什么。",shape=box,color=red];
		2483 -> 2488;
	2484 [label="她​的​神经线路​出现​失控？你这话是什么意思？",shape=box,color=red];
		2484 -> 2489;
	2485 [label="不，我不会这么做。Lotus 救了我的命。她无数次拯救了 Tenno 的生命。我们的一切都归功于她。",shape=box,color=red];
		2485 -> 2490;
	2486 [label="罗瑟，闭嘴，我不谈了。[结束]",shape=box,color=red];
		2486 -> 2491;
	2487 [label="我知道，我也很担心。但她为我们做了那么多，我不能背弃她。我必须支持她。",shape=box,color=red];
		2487 -> 2492;
	2488 [label="难道不是吗？注意！看看周围！她究竟花了多少岁月站在悬崖边，拿着老式寻呼机，自己哼着歌？凝视着虚空？",shape=box,color=blue];
		2488 -> 2493;
	2489 [label="她究竟花了多少岁月站在悬崖边，拿着老式寻呼机，自己哼着歌？凝视着虚空？",shape=box,color=blue];
		2489 -> 2493;
	2490 [label="我并非冷漠无情。我理解你的感受。你欠她太多了。我不是要你杀了她，我是要你别再让她影响你身边的人。",shape=box,color=blue];
		2490 -> 2489;
	2491 [label="如你所愿。但当这一切崩塌的时候，别来找我帮忙。",shape=box,color=blue];
		2491 -> 2494;
	2492 [label="+5 Chemistry",color=orange];
		2492 -> 2495;
	2493 [label="而现在她只是……在黑暗中潜伏着？将你童年的自我一步步送入记忆深处，为了什么？仅仅因为阿尔布雷希特打了个响指，说了句魔法词，她就能找到回家的路？",shape=box,color=blue];
		2493 -> 2496;
	2494 [label="Chat ends.",color=orange];
	2495 [label="我并非冷漠无情。我理解你的感受。你欠她太多了。我不是要你杀了她，我是要你别再让她影响你身边的人。",shape=box,color=blue];
		2495 -> 2497;
	2496 [label="你不觉得可疑吗？你不觉得危险吗？这是个陷阱。她被人操纵了。要么是阿尔布雷希特在操纵，要么是这个所谓的“虚空无情之物”在操纵。她就像一个坏掉的程序。她的枢律失灵了。",shape=box,color=blue];
		2496 -> 2498;
	2497 [label="当她站在悬崖边，拿着老式寻呼机，自己哼着歌，凝视着虚空时，你难道没想过她会跳下去吗？",shape=box,color=blue];
		2497 -> 2493;
	2498 [label="我不认为她有意伤害你，我觉得她只是被人利用了。但一旦时机到了，你或许需要自卫，你或许需要亲手除掉她。",shape=box,color=blue];
		2498 -> 2499;
	2499 [label="虽然你（但愿如此）很可能明白避免 Lotus 再次失控的必要性，但她那群野性未驯的孩子却不会。所以我再问一遍：",shape=box,color=blue];
		2499 -> 2500;
	2500 [label="如果那可怕的一天真的到来，你必须动用一切资源去应战，你觉得谁会赢？是你和你拥有的一切，还是 Tenno 与 Lotus 全部的力量？",shape=box,color=blue];
		2500 -> 2501;
		2500 -> 2502;
		2500 -> 2503;
	2501 [label="这太蠢了。不行。",shape=box,color=red];
		2501 -> 2504;
	2502 [label="他们大概有……我不知道，一百个吧。还有一个是我，罗瑟。",shape=box,color=red];
		2502 -> 2505;
	2503 [label="我甚至不知道该从哪里开始。",shape=box,color=red];
		2503 -> 2506;
	2504 [label="如果你非要把它当成一个愚蠢的游戏，那就当成小孩子玩的理论游戏吧。 ",shape=box,color=blue];
		2504 -> 2507;
		2504 -> 2508;
	2505 [label="+5 Chemistry",color=orange];
		2505 -> 2509;
	2506 [label="那么，你能跟“Tau 之恶魔”对话真是太好了。我之所以被称为战略家是有原因的。让我们从最根本的层面开始：数字。你在这一方面远远落后于他们。 ",shape=box,color=blue];
		2506 -> 2510;
	2507 [label="这不是游戏。",shape=box,color=red];
		2507 -> 2511;
	2508 [label="还要我说最后一次吗？不行。[结束]",shape=box,color=red];
		2508 -> 2512;
	2509 [label="完美。我们已经确立了战场布局的第一条规则：数量。显然，你在数量上完全处于劣势。",shape=box,color=blue];
		2509 -> 2510;
	2510 [label="Check boolean IsDating",color=orange];
		2510 -> 2513 [label=true,color=green];
		2510 -> 2514 [label=false,color=brown];
	2511 [label="你说得对，这不是游戏。而且，这或许会演变成生死之战。你将对抗你的……迷你版自己，以及他那群野性十足的同伴。",shape=box,color=blue];
		2511 -> 2515;
	2512 [label="Chat ends.",color=orange];
	2513 [label="不过嘛，如果你那些关于“私人活动”以及在其他时间线里与原型战甲之间的“绯闻”能被……利用一下，或许就能以某种方式调动那些资源。为此，需要对 Helminth 进行专门的研究和培育……",shape=box,color=blue];
		2513 -> 2516;
	2514 [label="我曾听闻你在其他时间线里与其他原型战甲之间的互动。或许我们可以以某种方式调动那些资源。为此，需要对 Helminth 进行专门的研究和培育……",shape=box,color=blue];
		2514 -> 2516;
	2515 [label="顺便一提，这些野性同伴已经被证明是暴力、桀骜不驯的，而且众所周知，他们会因为同伴与他们对“正常”的定义相差太远而残酷地驱逐他们。",shape=box,color=blue];
		2515 -> 2517;
		2515 -> 2518;
		2515 -> 2519;
	2516 [label="我甚至不知道这是否可行，但它为我们提供了通往这里的通道，所以我认为没有理由不行……",shape=box,color=blue];
		2516 -> 2520;
		2516 -> 2521;
		2516 -> 2522;
	2517 [label="你现在是在暗示 Tenno 是邪恶的吗？",shape=box,color=red];
		2517 -> 2523;
	2518 [label="你在说什么？",shape=box,color=red];
		2518 -> 2524;
	2519 [label="不。我不想聊了。[结束]",shape=box,color=red];
		2519 -> 2525;
	2520 [label="罗瑟？下地狱吧。",shape=box,color=red];
		2520 -> 2526;
	2521 [label="我不会把他们卷入这场混乱。",shape=box,color=red];
		2521 -> 2527;
	2522 [label="你在这件事上居然想了这么多，我都有点害怕了。",shape=box,color=red];
		2522 -> 2528;
	2523 [label="篡位者，不，不是邪恶。我不相信“邪恶”。我过去不相信，将来也不会相信。我相信 Tenno 和其他人一样，都是美好而善良的人。他们只是普通人。而且，他们还是孩子。",shape=box,color=blue];
		2523 -> 2529;
	2524 [label="或许有一天，在某个可怕的日子里，你必须做好准备，去做那些难以想象的事情。",shape=box,color=blue];
		2524 -> 2530;
	2525 [label="你想逃避就逃避吧，但你很清楚我说的每一个字都是真的。你只是不愿意接受而已。",shape=box,color=blue];
		2525 -> 2531;
	2526 [label="+5 Chemistry",color=orange];
		2526 -> 2532;
	2527 [label="啊！所以你承认这是场混乱。这算是一种进步。那我至少可以阐述一下我的观点吗？",shape=box,color=blue];
		2527 -> 2533;
		2527 -> 2534;
	2528 [label="你在这件事上居然没想那么多，我才害怕呢。我能至少阐述一下我的观点吗？",shape=box,color=blue];
		2528 -> 2533;
		2528 -> 2534;
	2529 [label="孩子们被迫面对恐怖，犯下暴行，而我亲眼目睹，这种暴行甚至击垮了那些历经数百年磨砺的、意志坚定的奥罗金战士。",shape=box,color=blue];
		2529 -> 2535;
	2530 [label="Tenno 和其他人一样，都是美好而善良的人类。他们只是普通人。而且，他们还是孩子。",shape=box,color=blue];
		2530 -> 2529;
	2531 [label="Chat ends.",color=orange];
	2532 [label="我​早​就​下​了，​篡位者。​我​已经​在​地狱​里​了。​",shape=box,color=blue];
		2532 -> 2536;
	2533 [label="好，没问题，请讲，我会听的。",shape=box,color=red];
		2533 -> 2537;
	2534 [label="不用了。我受够了。",shape=box,color=red];
		2534 -> 2538;
	2535 [label="我亲眼见过禁卫——黄金精英禁卫！——丢下他们神圣的镀金宝剑，逃离 Tenno 驾驶着战甲冲入的战场。",shape=box,color=blue];
		2535 -> 2539;
	2536 [label="Update boolean RoatheNoDate",color=orange];
		2536 -> 2540;
	2537 [label="+5 Chemistry",color=orange];
		2537 -> 2541;
	2538 [label="我也是。",shape=box,color=blue];
		2538 -> 2540;
	2539 [label="他们自以为那些 Infested 的茧能保护他们的肉体，却保护不了他们的心智。他们变成现在这个样子，并不是他们的错。",shape=box,color=blue];
		2539 -> 2542;
	2540 [label="Chat ends.",color=orange];
	2541 [label="谢谢。或许有一天，在某个可怕的日子里，你必须做好准备，去做那些难以想象的事情。",shape=box,color=blue];
		2541 -> 2530;
	2542 [label="他们饱受虚空折磨……被迫杀害或亲眼目睹父母死亡……饱受战争蹂躏……记忆被窃取……被冷冻睡眠数个世纪……",shape=box,color=blue];
		2542 -> 2543;
	2543 [label="篡位者，他们居然没有完全变成疯子，这简直是个奇迹。我不是说事情一定会出错，我只是说有可能出错。所以你必须做好准备，以防万一。",shape=box,color=blue];
		2543 -> 2544;
	2544 [label="未雨绸缪并无坏处，而不做好准备才是最大的坏处。",shape=box,color=blue];
		2544 -> 2545;
		2544 -> 2546;
		2544 -> 2547;
		2544 -> 2548;
	2545 [label="我会……密切关注事态发展。好吗？但我不会背着任何人做事。",shape=box,color=red];
		2545 -> 2549;
	2546 [label="我真的非常讨厌我竟然在某种程度上同意你的观点。",shape=box,color=red];
		2546 -> 2550;
	2547 [label="你知道我承受的痛苦和 Tenno 一样多，对吧？",shape=box,color=red];
		2547 -> 2551;
	2548 [label="我不会背叛他们的信任。",shape=box,color=red];
		2548 -> 2552;
	2549 [label="+5 Chemistry",color=orange];
		2549 -> 2553;
	2550 [label="+5 Chemistry",color=orange];
		2550 -> 2554;
	2551 [label="谁又能说我没有和他们进行同样的对话呢？",shape=box,color=blue];
		2551 -> 2555;
	2552 [label="我从来也没说要你做相反的事。",shape=box,color=blue];
		2552 -> 2556;
	2553 [label="当然！这正是恶魔能奢求的全部了，谢谢。",shape=box,color=blue];
		2553 -> 2557;
	2554 [label="嗯，这只是多年后大脑恢复理智的感觉而已。你会习惯的。",shape=box,color=blue];
		2554 -> 2558;
	2555 [label="篡位者，睡个好觉。 ",shape=box,color=blue];
		2555 -> 2559;
	2556 [label="Add 1 to Thermostat",color=orange];
		2556 -> 2560;
	2557 [label="Add 1 to Thermostat",color=orange];
		2557 -> 2561;
	2558 [label="Add -1 to Thermostat",color=orange];
		2558 -> 2562;
	2559 [label="Add -1 to Thermostat",color=orange];
		2559 -> 2563;
	2560 [label="Chat ends.",color=orange];
	2561 [label="Chat ends.",color=orange];
	2562 [label="Chat ends.",color=orange];
	2563 [label="Chat ends.",color=orange];
}