	j464208179 [label="JAJAJA me lembra de nunca te colocar como contato de emergência\nSííí, ela estica as pernas, mas sempre volta pra cá\nPra tal da Arqui… seja lá o que for… Temporal\nMas também pra nós, eu acho…",shape=box,color=blue];
