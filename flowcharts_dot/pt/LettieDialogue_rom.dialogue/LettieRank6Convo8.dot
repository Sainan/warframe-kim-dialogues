		j571301407 -> j4060508622;
	j13542406 [label="Às vezes, só leva tempo mesmo\nMas vou tentar ajudar ela, se der\nA Lua sabe o quanto ela é curiosa sobre medicina jajaja\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j13542406 -> j1192249648;
	j4060508622 [label="Gosto de ter ela por perto\nAcho que ela sabe disso\nEla gosta de me ajudar nas cirurgias, mas…\nSiempre hace preguntas espeluznantes",shape=box,color=blue];
