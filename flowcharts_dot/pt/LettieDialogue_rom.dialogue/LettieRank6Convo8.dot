	j1978588822 [label="Quem disse que esse era o plano\nConheço esse tipinho\nCovardes, todos eles, cuspindo veneno de onde acham que tão seguros",shape=box,color=blue];
		j1978588822 -> j2679771843;
	j2993817537 [label="Você sabe como foi crescer do jeito que eu sou?\nFalando como eu falo?\nSe vestindo como eu me visto?\nCercado por crianças em bases militares que eram diferentes?",shape=box,color=blue];
		j2993817537 -> j3161000909;
	j3161000909 [label="Eu chegava em casa quase sempre machucada porque tentava me defender\nMamá sempre revirava os olhos e dizia que eu devia ter baixado a cabeça\nQuedarme callada?\nNem cagando!",shape=box,color=blue];
