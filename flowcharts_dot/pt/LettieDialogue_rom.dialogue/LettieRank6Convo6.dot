	j4094929969 [label="E esse Velimir, confesso que curto o jeito dele\nGosto de homem que sabe exatamente o que é\nAlguien auténtico y fiel a sí mismo, sí?\nEle tava deixando a Aoi pintar as unhas do pé dele um dia desses jajajaja\nEnquanto falava sobre os carros clássicos ''libertários'' dele\nNa boa",shape=box,color=blue];
