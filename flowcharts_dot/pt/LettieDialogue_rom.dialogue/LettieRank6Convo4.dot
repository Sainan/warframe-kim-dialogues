		j2653937322 -> j3248462411;
	j1326707726 [label="Sólo las arañas\nSe sentindo em casa de novo\nMas daqui a pouco vão embora",shape=box,color=blue];
		j1326707726 -> j1777352409;
	j3248462411 [label="Não, nenhuma novidade\nSólo las arañas\nSe sentindo em casa de novo\nMas daqui a pouco vão embora",shape=box,color=blue];
		j3248462411 -> j1777352409;
	j1777352409 [label="Às vezes eu queria\nQue fosse tão fácil quanto um problema\nE aí eu conseguiria resolver, sí?\nConversar, dar uns tapas, jajaja",shape=box,color=blue];
		j1777352409 -> j224914552;
	j224914552 [label="Os problemas podem ser resolvidos\nOs problemas têm respostas\nLos sentimientos no se arreglan\nPode acreditar, eu tentei",shape=box,color=blue];
		j224914552 -> j1034197999;
		j224914552 -> j1142648753;
	j1034197999 [label="Mas você tem muitos motivos pra se alegrar, né?",shape=box,color=red];
		j1034197999 -> j3016936919;
	j1142648753 [label="Aprendi da maneira mais difícil em Duviri que \"consertar sentimentos\" muitas vezes é a pior opção.",shape=box,color=red];
		j1142648753 -> j1022707248;
	j3016936919 [label="Ay, sí, tenho\nE eu sei que tenho\nE eu queria que às vezes\nAs pessoas entendessem essa parte de mim\nO que não é fácil de assimilar",shape=box,color=blue];
		j3016936919 -> j27751308;
	j1022707248 [label="Síí…\nMas às vezes é tentador jajaja\nSó quero não sentir mais nada\nMas você me contou o que acontece\nQuando tudo fica anestesiado",shape=box,color=blue];
		j1022707248 -> j1392382240;
	j27751308 [label="Eu queria ser diferente\nMas eu sou quem eu sou\nE desisti de me desculpar por isso\nHá muito tempo",shape=box,color=blue];
		j27751308 -> "Chat ends.";
	j1392382240 [label="Não desejo isso pra ninguém\nTá, talvez pro Albrecht\nPinche güey\nMas aquele coração gelado já não sente nada mesmo",shape=box,color=blue];
		j1392382240 -> j1969260198;
		j1392382240 -> j627089083;
	j1969260198 [label="O que a gente pode fazer para te distrair? Ou prefere ficar em casa?",shape=box,color=red];
		j1969260198 -> j3914190489;
	j627089083 [label="Só da pra esperar que ele esteja jogando pro longo prazo.",shape=box,color=red];
		j627089083 -> j2484118926;
	j3914190489 [label="Hmm, buena pregunta…\nPra falar a verdade, não sei\nFicar em casa pode ser bom\nMas a gente pode sair pra dar uns tiros\nTe quedas? O vamos a matar unas cositas? \nAi que dúvida…",shape=box,color=blue];
		j3914190489 -> j3806423889;
		j3914190489 -> j2856969943;
	j2484118926 [label="A única coisa que espero envolvimento desse cabrón\nÉ uma longa viagem de elevador\nComigo\nE um taco de beisebol",shape=box,color=blue];
		j2484118926 -> j1788679554;
	j3806423889 [label="Voto em ficar em casa.",shape=box,color=red];
