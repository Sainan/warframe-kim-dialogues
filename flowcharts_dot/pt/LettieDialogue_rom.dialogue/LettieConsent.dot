	j1595498777 [label="Não fica brava, por favor",shape=box,color=red];
		j1595498777 -> j2424207659;
	j592763727 [label="Espero que você entenda",shape=box,color=red];
		j592763727 -> j2490429154;
	j298804810 [label="Jajajajaj\nA gente já falou sobre isso\nSó te bato quando você gosta\nAgora… o que você tá querendo me contar?",shape=box,color=blue];
		j298804810 -> j1687828219;
	j2424207659 [label="Sí?\nE por que eu ficaria brava?",shape=box,color=blue];
		j2424207659 -> j1687828219;
	j2490429154 [label="Sí?\nE o que eu deveria entender?",shape=box,color=blue];
		j2490429154 -> j1687828219;
	j1687828219 [label="Não quero te colocar numa situação que você se sinta desconfortável… sei que não falamos sobre algo parecido antes, então, se você falar que não, tudo bem",shape=box,color=red];
		j1687828219 -> j1534248564;
	j1534248564 [label="O que temos entre nós é importante pra mim, e muito… não quero que você duvide disso, jamais",shape=box,color=red];
		j1534248564 -> j4268131167;
	j4268131167 [label="Ah, entiendo…\nVocê sabe que normalmente não gosto disso\nAcho que só quero saber uma coisa\nVocê realmente se importa com essa pessoa, solecito?\nQuiénes son?",shape=box,color=blue];
		j4268131167 -> j4041486443;
		j4268131167 -> j1749884788;
	j4041486443 [label="Me importo muito com ela, mas também me importo muito com você",shape=box,color=red];
		j4041486443 -> j733732600;
	j1749884788 [label="Eu devia ter imaginado que você ia entender de cara…",shape=box,color=red];
		j1749884788 -> j1204356347;
	j733732600 [label="Ay, sí\nNão posso te culpar considerando o tanto que você vê por aí\nViajando por tanto lugar e época\nSó não me peça pra me juntar a vocês\nPor mim, não tem problema nenhum",shape=box,color=blue];
		j733732600 -> j1196408539;
	j1204356347 [label="\"Eu traí ela\"\nA Eleanor viu e me contou\nJajajaja ela é uma fofoqueira",shape=box,color=blue];
		j1204356347 -> j3998359552;
	j1196408539 [label="Mas… só não com o Hexa\nNão com mi família, por favor?\nEu ia ficar chorando por uma semana inteira",shape=box,color=blue];
		j1196408539 -> j427288534;
	j3998359552 [label="Não posso te culpar considerando o tanto que você vê por aí\nViajando por tanto lugar e época\nSó não me peça pra me juntar a vocês\nPor mim, não tem problema nenhum",shape=box,color=blue];
		j3998359552 -> j1196408539;
