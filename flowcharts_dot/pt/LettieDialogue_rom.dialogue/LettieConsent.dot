	j513510173 [label="Eu devia ter imaginado que você ia entender de cara…",shape=box,color=red];
		j513510173 -> j761135731;
	j3535849229 [label="Ay, sí\nNão posso te culpar considerando o tanto que você vê por aí\nViajando por tanto lugar e época\nPor mim, não tem problema nenhum",shape=box,color=blue];
		j3535849229 -> j1196408539;
	j761135731 [label="\"Eu traí ela\"\nA Eleanor viu e me contou\nJajajaja ela é uma fofoqueira",shape=box,color=blue];
		j761135731 -> j3974666231;
	j1196408539 [label="Mas… só não com o Hexa\nNão com mi família, por favor?\nEu ia ficar chorando por uma semana inteira",shape=box,color=blue];
		j1196408539 -> j427288534;
	j3974666231 [label="Não posso te culpar considerando o tanto que você vê por aí\nViajando por tanto lugar e época\nPor mim, não tem problema nenhum",shape=box,color=blue];
