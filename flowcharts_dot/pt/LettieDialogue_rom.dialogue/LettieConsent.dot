	j1822505317 [label="Não fica brava, por favor",shape=box,color=red];
		j1822505317 -> j1151131641;
	j2885452277 [label="Espero que você entenda",shape=box,color=red];
		j2885452277 -> j4041966001;
	j3158071735 [label="Jajajajaj\nA gente já falou sobre isso\nSó te bato quando você gosta\nAgora… o que você tá querendo me contar?",shape=box,color=blue];
		j3158071735 -> j3683909878;
	j1151131641 [label="Sí?\nE por que eu ficaria brava?",shape=box,color=blue];
		j1151131641 -> j3683909878;
	j4041966001 [label="Sí?\nE o que eu deveria entender?",shape=box,color=blue];
		j4041966001 -> j3683909878;
	j3683909878 [label="Não quero te colocar numa situação que você se sinta desconfortável… sei que não falamos sobre algo parecido antes, então, se você falar que não, tudo bem",shape=box,color=red];
		j3683909878 -> j3008744470;
	j3008744470 [label="O que temos entre nós é importante pra mim, e muito… não quero que você duvide disso, jamais",shape=box,color=red];
		j3008744470 -> j3752693308;
	j3752693308 [label="Ah, entendi…\nAcho que só quero saber uma coisa\nVocê realmente se importa com essa pessoa, solecito?\nQuiénes son?",shape=box,color=blue];
		j3752693308 -> j2024047079;
		j3752693308 -> j513510173;
	j2024047079 [label="Me importo muito com ela, mas também me importo muito com você",shape=box,color=red];
