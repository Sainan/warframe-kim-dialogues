	j2976639168 [label="Quero falar com você sobre algo… e quero ter certeza de que você não tem nenhum problema com isso",shape=box,color=red];
		j2976639168 -> j3570630936;
	j3570630936 [label="Pra mim, é importante que você não sinta que tô mentindo ou sendo desonesto com você em momento nenhum",shape=box,color=red];
