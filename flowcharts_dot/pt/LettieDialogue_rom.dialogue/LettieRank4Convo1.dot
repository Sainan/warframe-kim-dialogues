	j1028397098 [label="Então, eu nunca fiquei sabendo como você realmente conheceu o Arthur",shape=box,color=red];
		j1028397098 -> j763306091;
	j1290391309 [label="Lê, tem um segundo pra conversar? Ou você está ocupada?",shape=box,color=red];
		j1290391309 -> j3189362600;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j763306091 [label="Ah, foi uma bagunça \nAchei que você não queria saber dos detalhes violentos \nMas, se quiser saber mais, sí, posso te contar \nSem problemas",shape=box,color=blue];
		j763306091 -> j1041067730;
	j3189362600 [label="+5 Chemistry",color=orange];
		j3189362600 -> j2549214548;
	"Chat ends." [color=orange];
	j1041067730 [label="Estávamos posicionados na mesma base \nEle no exército britânico e eu no exército libertário\nPaíses diferentes, mas os mesmos inimigos",shape=box,color=blue];
		j1041067730 -> j4175803588;
	j2549214548 [label="Tô sempre ocupada \nMas posso fazer uma pausa \nQué onda?",shape=box,color=blue];
		j2549214548 -> j2849936044;
	j4175803588 [label="Eu era a médica de campo do meu regimento \nFomos enviados pra uma posição logo ao lado do dele \nO lugar virou um verdadeiro cagadero \nTudo num piscar de olhos",shape=box,color=blue];
		j4175803588 -> j3332856796;
	j2849936044 [label="Eu tava me perguntando aqui, como você conheceu o Arthur?",shape=box,color=red];
		j2849936044 -> j763306091;
	j3332856796 [label="A maioria da minha equipe não sobreviveu \nO mesmo aconteceu com a dele \nEntão, nós cuidamos um do outro \nLiteralmente \nCosturei o braço dele de um jeito que ficou belezinha \nQuando ele se aposentou e foi para o BRCI \nFui junto com ele sem nem perguntar \nTava de saco cheio de todo o drama que tinha no exército",shape=box,color=blue];
		j3332856796 -> j4195832624;
	j4195832624 [label="Decidi há muito tempo que ia estar ao lado dele até o fim \nSó não imaginava que o fim ia me levar até os confins de Mictlán",shape=box,color=blue];
		j4195832624 -> j1483270762;
	j1483270762 [label="Isso deve parecer fichinha pra você \nSó mais uma historinha besta \nVocê luta contra monstros e deuses \nE já dançou valsa com La Flaca um milhão de vezes",shape=box,color=blue];
		j1483270762 -> j3207784194;
	j3207784194 [label="Boolean LettieArthur1 is now true.",color=orange];
		j3207784194 -> j3474848316;
		j3207784194 -> j2595492769;
		j3207784194 -> j3704413110;
	j3474848316 [label="Só porque minhas lutas são dessa magnitude, não quer dizer que eu não compreenda o quão horrível isso deve ter sido pra vocês",shape=box,color=red];
		j3474848316 -> j3069846346;
	j2595492769 [label="Toda guerra é uma merda, não tem como mensurar nossas lutas",shape=box,color=red];
		j2595492769 -> j1411290762;
	j3704413110 [label="Fazer o quê… pessoas pequenas, histórias decepcionantes…",shape=box,color=red];
		j3704413110 -> j1162579118;
	j3069846346 [label="+10 Chemistry",color=orange];
		j3069846346 -> j1092761186;
	j1411290762 [label="+15 Chemistry",color=orange];
		j1411290762 -> j1258185671;
	j1162579118 [label="Deve ser…",shape=box,color=blue];
		j1162579118 -> j2703113057;
	j1092761186 [label="Ay, sí \nLutas majestosas, ou pequenas e breves \nLa Flaca sempre está presente em todas elas \nPelo menos… era assim que deveria ser \nMas não para nós, fantasmas",shape=box,color=blue];
		j1092761186 -> "Chat ends.";
	j1258185671 [label="Sí, é tudo a mesma coisa \nNão importa quão grandes e estúpidas sejam as armas usadas",shape=box,color=blue];
		j1258185671 -> "Chat ends.";
