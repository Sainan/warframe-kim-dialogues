		j3526029970 -> j2796728750 [label=true,color=green];
		j3526029970 -> j2171147880 [label=false,color=brown];
	j2796728750 [label="Solecito… \nTá por aí? \nTenho uns minutos de folga, queria bater um papo",shape=box,color=blue];
		j2796728750 -> j1437448620;
		j2796728750 -> j1969474932;
		j2796728750 -> j269513434;
	j2171147880 [label="Ei… \nTá por aí? \nTenho uns minutos de folga, queria bater um papo",shape=box,color=blue];
		j2171147880 -> j1969474932;
		j2171147880 -> j269513434;
	j1437448620 [label="Tu não tá terminando comigo, né?! Por favor, me diz que não…",shape=box,color=red];
		j1437448620 -> j2508443653;
	j1969474932 [label="VOCÊ querendo conversar?! Quem é você e o que fez com a Lê?! Alguém morreu?!",shape=box,color=red];
		j1969474932 -> j1906768807;
	j269513434 [label="Foi mal, agora não dá pra falar [Encerrar Conversa]",shape=box,color=red];
		j269513434 -> "Chat ends.";
	j2508443653 [label="Ay, não! \nNão não não \nNão é nada disso jajaja \nMas é possível que VOCÊ mude de ideia depois desse papo",shape=box,color=blue];
		j2508443653 -> j3171029576;
		j2508443653 -> j636628630;
	j1906768807 [label="Jajaja, muito engraçado \nTodo mundo aqui já morreu alguma vez \nAy, não, o que eu quero falar \nÉ sério \nE algo que eu tenho evitado bastante",shape=box,color=blue];
		j1906768807 -> j636628630;
		j1906768807 -> j3171029576;
	"Chat ends." [color=orange];
	j3171029576 [label="Tá… manda bala então",shape=box,color=red];
		j3171029576 -> j2818670173;
	j636628630 [label="Tudo bem, pode falar",shape=box,color=red];
		j636628630 -> j2818670173;
	j2818670173 [label="Check boolean LettieHexAsked",color=orange];
		j2818670173 -> j3459022853 [label=true,color=green];
		j2818670173 -> j3172424732 [label=false,color=brown];
	j3459022853 [label="Você tinha perguntado como que nós viramos esses monstros \nO que aquele pinche cabrón fez com a gente \nO motivo de eu odiar tanto ele \nO que aquele pedaço de merda nos fez fazer",shape=box,color=blue];
		j3459022853 -> j4036717455;
	j3172424732 [label="Check boolean LettieEntrati",color=orange];
		j3172424732 -> j2054738197 [label=true,color=green];
		j3172424732 -> j3038561522 [label=false,color=brown];
	j4036717455 [label="Então \nEu segui o Arthur pro BRCI \nFui enviada aqui para este cuchitril pra lidar com uma praga estranha que ninguém tinha visto antes",shape=box,color=blue];
		j4036717455 -> j2116961330;
	j2054738197 [label="É melhor você saber o que aquele pinche cabrón fez com a gente \nO por que eu odeio tanto ele \nO que aquele pedaço de merda nos fez fazer",shape=box,color=blue];
		j2054738197 -> j4036717455;
	j3038561522 [label="Check boolean LettieArthur1",color=orange];
		j3038561522 -> j35408445 [label=true,color=green];
		j3038561522 -> j3466932435 [label=false,color=brown];
	j2116961330 [label="Uma doença que devora pessoas \nQue transforma as pessoas em máquinas pela metade \nNem precisava ser pessoa, ela fazia isso até com computadores",shape=box,color=blue];
		j2116961330 -> j652662814;
	j35408445 [label="Já te contei como eu e o Arthur viramos hermanos \nMas não como nos transformamos nesses monstros \nÉ melhor você saber o que aquele pinche cabrón fez com a gente \nO por que eu odeio tanto ele \nO que aquele pedaço de merda nos fez fazer",shape=box,color=blue];
		j35408445 -> j4036717455;
	j3466932435 [label="Você já fez muito pela gente \nJá salvou nossas vidas, já nos fez companhia… sendo que poderia ter só ido embora \nSenta que lá vem história",shape=box,color=blue];
		j3466932435 -> j4036717455;
	j652662814 [label="Fomos enviados pra \"lidar com isso\" \nDa melhor maneira que pudermos\nSem muitas bandagens \nE sem muitas balas",shape=box,color=blue];
		j652662814 -> j3523700062;
	j3523700062 [label="Isso foi no início de 1998 \nAntes de você chegar \nAquele cabrón Entrati já tava aqui \nContando suas MENTIRAS",shape=box,color=blue];
		j3523700062 -> j2439780644;
	j2439780644 [label="As melhores mentiras são aquelas que acredita, né? \nNão tínhamos cura pra essa doença, exceto a La Flaca \nE aí, ele apareceu \nO Dr. E veio resolver tudo, com sua bolsa mágica de milagres \nDisse que podia consertar tudo com sua medicina milagrosa",shape=box,color=blue];
		j2439780644 -> j3787391606;
	j3787391606 [label="E nós, os trouxas, acreditamos nele \nE quando o BRCI disse \"não não, vocês não podem ajudar ele a distribuir essa droga\", nós deveríamos ter ouvido \nVacinas são feitas por cientistas, e não por velhos de sobretudo \nVendendo mentiras como se fossem milagres engarrafados \nMas com gente morrendo por todo lado? \nNós acabamos ajudando ele, porque queríamos ajudar as pessoas",shape=box,color=blue];
		j3787391606 -> j941453706;
	j941453706 [label="Então, nós ajudamos ele a injetar a droga nas pessoas desta cidade \nNós fizemos filas em nossas tendas, e aquele cabrón e eu tratamos diversas pessoas \nE os outros mantiveram a operação funcionando",shape=box,color=blue];
		j941453706 -> j1783488078;
	j1783488078 [label="NOSOTROS CREÍMOS EN ÉL! \nNós confiamos nele \nY por tan poco? \nParecia que tava funcionando \nAs pessoas que receberam a vacina não ficaram doentes \nE qual o problema, então?",shape=box,color=blue];
		j1783488078 -> j1223426195;
	j1223426195 [label="Todos AO REDOR deles ficaram doentes \nSabe o que são \"portadores silenciosos\"? \nNo passado, me voluntariei num abrigo de animais num verão quando ainda era uma chiquita \nTinha tantos guaxinins por lá \nMas eu não podia soltar, porque eles poderiam ser portadores silenciosos da raiva \nEles PARECIAM saudáveis e normais…",shape=box,color=blue];
		j1223426195 -> j1262848495;
	j1262848495 [label="Mas se nós soltássemos eles? \nEles infectariam tudo… \nFoi isso que fizemos com as pessoas \nERA ISSO QUE ELE QUERIA FAZER COM AS PESSOAS \nLO HIZO A PROPÓSITO!\nEste lugar virou a porta de Mictlán POR CAUSA DELE",shape=box,color=blue];
		j1262848495 -> j725978000;
	j725978000 [label="Mesmo quando começamos a suspeitar \nNão conseguíamos acreditar \nNós comentamos isso entre nós \nMas simplesmente ficamos em negação \n\"Não não, isso é impossível\" \n\"Ele não faria isso\" \n\"Não com a gente\"",shape=box,color=blue];
		j725978000 -> j1382766468;
	j1382766468 [label="Boolean LettieHex is now true.",color=orange];
		j1382766468 -> j86733959;
	j86733959 [label="Check boolean LettieDating",color=orange];
		j86733959 -> j1598939623 [label=true,color=green];
		j86733959 -> j2722494254 [label=false,color=brown];
	j1598939623 [label="Não queríamos acreditar no que estava na nossa cara \nNossa confiança havia sido quebrada \nNós… também tomamos aquela vacina, solecito… \nEstávamos espalhando a praga por aí…",shape=box,color=blue];
		j1598939623 -> j2639130787;
	j2722494254 [label="Não queríamos acreditar no que estava na nossa cara \nNossa confiança havia sido quebrada \nNós… também tomamos aquela vacina… \nEstávamos espalhando a praga por aí…",shape=box,color=blue];
		j2722494254 -> j2639130787;
	j2639130787 [label="Então, quando ele disse que a cepa do Tecnovírus havia sofrido uma mutação… quando disse que nós não estávamos mais seguros…",shape=box,color=blue];
		j2639130787 -> j4116520730;
	j4116520730 [label="Formamos uma fila \nComo bons soldaditos",shape=box,color=blue];
		j4116520730 -> j615699769;
	j615699769 [label="Ah Lua, aquilo doeu muito \nE não foi a dor boa… \nOs gritos da Aoi foram os piores \nEu não consegui ajudar ela, eu tava ocupada morrendo também \nEla chorava de medo, e eu só queria poder abraçar ela",shape=box,color=blue];
		j615699769 -> j2160115209;
	j2160115209 [label="Só queria falar que ia ficar tudo bem \nQue a dor ia passar, e La Flaca ia levar ela pra casa \nEla tava com tanto medo… e eu consegui ajudar em nada \nNem minhas pernas funcionavam direito…",shape=box,color=blue];
		j2160115209 -> j393928001;
	j393928001 [label="E vou continuar odiando esse merda \nPor todos os dias da minha vida eterna \nTudo por causa dessa traição",shape=box,color=blue];
		j393928001 -> j1486226254;
	j1486226254 [label="E se eu achar ele de novo? \nÉ melhor tu me segurar \nSenão ele vai ver o que é dor de verdade",shape=box,color=blue];
		j1486226254 -> j3842658063;
		j1486226254 -> j3576092854;
		j1486226254 -> j379120695;
		j1486226254 -> j4226776617;
	j3842658063 [label="Cara, guardar rancor assim não é saudável, mesmo que o que ele fez com você tenha sido horrível",shape=box,color=red];
		j3842658063 -> j2685762067;
	j3576092854 [label="Puta merda… eu… não fazia ideia disso. Eu… sinto muito que ele tenha te usado daquele jeito. Eu também odiaria ele no seu lugar",shape=box,color=red];
		j3576092854 -> j3141865103;
	j379120695 [label="Eu… peraí… então, todos vocês são parcialmente culpados pela disseminação do Tecnovírus?",shape=box,color=red];
		j379120695 -> j4282996212;
	j4226776617 [label="Opa… foi mal, acho que eu cochilei… onde você parou mesmo?",shape=box,color=red];
		j4226776617 -> j2548450594;
	j2685762067 [label="Olha só você \nTodos Saúdam San Babas \nA solução pra todos os pecados \nNão \nAlgumas coisas não podem ser perdoadas \nO que ele fez com a gente é uma delas \nO que fizemos com as pessoas desta cidade também",shape=box,color=blue];
		j2685762067 -> j1040120842;
		j2685762067 -> j1783300322;
		j2685762067 -> j3448365426;
	j3141865103 [label="Sí \nEu não aceito traição de jeito nenhum \nMas nós queríamos acreditar nele, e isso nos cegou \nSe você quiser distância da gente, eu vou entender \nOs outros também vão",shape=box,color=blue];
		j3141865103 -> j1040120842;
		j3141865103 -> j1783300322;
		j3141865103 -> j3448365426;
	j4282996212 [label="Sí \nNós somos \nMas nós queríamos acreditar nele, e isso nos cegou \nSe você quiser distância da gente, eu vou entender \nOs outros também vão",shape=box,color=blue];
		j4282996212 -> j1040120842;
