	1191 [label="Você pode perguntar, embora eu me reserve o direito de encerrar a conversa se sentir que ela está entrando em um assunto do qual não quero mais participar.",shape=box,color=blue];
		1191 -> 1196;
	1190 [label="Hum. Sinceramente, estou surpreso que tenha demorado tanto para você perguntar sobre essa minha característica em particular. Geralmente, é justamente o que a maioria das pessoas comenta com mais facilidade.",shape=box,color=blue];
		1190 -> 1195;
	1057 [label="Chat ends.",color=orange];
	1197 [label="Geralmente, é aquilo que a maioria das pessoas comenta com mais facilidade. Seja por motivos de preocupação, repulsa ou curiosidade mórbida.",shape=box,color=blue];
		1197 -> 1204;
	1194 [label="Se você se considera um covarde por ter feito essa escolha, eu imploro: não se considere. Pois essa é uma dor que não lhe cabe enfrentar. Ela é minha. Você não pediu para suportar este momento. ",shape=box,color=blue];
		1194 -> 1198;
	1196 [label="Tem a ver com o fato de você se machucar às vezes… eu só queria ter cuidado na forma como falar sobre isso, nada mais",shape=box,color=red];
		1196 -> 1203;
	1195 [label="Seja por preocupação, repulsa ou pela curiosidade mórbida que leva alguém a espiar através das grades da jaula de um maníaco. Em qual dos perfis você se encaixa?",shape=box,color=blue];
		1195 -> 1199;
