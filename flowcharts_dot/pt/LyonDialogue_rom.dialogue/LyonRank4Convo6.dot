	1186 [label="Lyon, eu tava conversando com a Marie sobre seus… hábitos, e fiquei pensando, podemos falar sobre isso?",shape=box,color=red];
		1186 -> 1192;
	1183 [label="[Clique aqui para desativar todas as conversas envolvendo menções sobre automutilação. Você não perderá pontos de Intimidade com isso.]",shape=box,color=red];
