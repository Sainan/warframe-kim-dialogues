		1182 -> 1188;
	1185 [label="Lyon? Podemos falar sobre algo que talvez seja um pouco… desconfortável pra você?",shape=box,color=red];
		1185 -> 1191;
	1184 [label="Lyon, eu tava pensando se poderia conversar com você sobre por que você… se machuca tanto, se não for incomodar?",shape=box,color=red];
		1184 -> 1190;
	2231 [label="[Conversa ocultada devido à escolha anterior de evitar tópicos sensíveis]",shape=box,color=blue];
		2231 -> 1057;
	1192 [label="Ela me avisou que vocês conversaram. Sim, claro. Você talvez se surpreenda com o quão pouco me incomoda falar sobre essa minha característica em particular.",shape=box,color=blue];
		1192 -> 1197;
