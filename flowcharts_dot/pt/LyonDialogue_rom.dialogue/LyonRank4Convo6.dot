		1204 -> 1200 [label="DrifterHarmLoss",color=purple];
		1204 -> 1199 [label="false",color=purple];
	1198 [label="Essa engenhoca mecânica em que estamos sentados cria uma impressão de impessoalidade velada. Como se estivéssemos, de alguma forma, protegidos de qualquer dano que alguém possa nos causar através das palavras digitadas nela.",shape=box,color=blue];
		1198 -> 1205;
	1203 [label="+5 Chemistry",color=orange];
		1203 -> 1209;
	1199 [label="Sinto muito, mas pensando bem, não posso fazer isso [Encerrar Conversa]",shape=box,color=red];
		1199 -> 1194;
	1200 [label="[Aviso: conversa envolvendo menções de suicídio] Eu… perdi alguém pra esse tipo de \"hábito\" uma vez, e eu…",shape=box,color=red];
		1200 -> 1206;
	1201 [label="Só quero te ajudar… pra ter certeza de que você tá bem, nada mais",shape=box,color=red];
		1201 -> 1207;
	1202 [label="Sinto que isso não é saudável… que é algo que deveria parar de acontecer",shape=box,color=red];
		1202 -> 1208;
	1210 [label="Sei que você disse que se machucava antes do soro, mas… não consigo imaginar que isso tenha melhorado",shape=box,color=red];
		1210 -> 1215;
	1205 [label="Eu argumentaria, ao contrário, que, livres da armadura que vestimos em nossas interações sociais mais corriqueiras, somos despojados daquilo que poderia nos proteger. ",shape=box,color=blue];
		1205 -> 1211;
	1209 [label="Eu… aprecio a delicadeza com que você está tratando disso, Peregrino. Obrigado. Mas já estou bastante acostumado a esse assunto ser discutido. Seja por preocupação, repulsa ou curiosidade mórbida. Embora eu ache que você já tenha provado que é a primeira opção.",shape=box,color=blue];
		1209 -> 1199;
		1209 -> 1200;
		1209 -> 1201;
		1209 -> 1202;
	1206 [label="Update boolean DrifterHarmLoss",color=orange];
		1206 -> 1212;
	1207 [label="Update boolean DrifterHarmHelp",color=orange];
		1207 -> 1213;
	1208 [label="Update boolean DrifterHarmStop",color=orange];
		1208 -> 1214;
	1215 [label="Não, receio que não. Transformou algo que era… um requisito para limpar minha mente das visões que me atormentavam, em um requisito para usar os \"dons\" deste soro.",shape=box,color=blue];
		1215 -> 1221;
	1211 [label="Portanto, em situações como essas… tenho plena consciência de que lancei uma flecha que pode atingir não o soldado pronto para a batalha, mas a jugular desavisada de um cervo na floresta.",shape=box,color=blue];
		1211 -> 1216;
	1212 [label="Ah, meu amigo… não há palavras que eu possa usar para expressar adequadamente a minha compaixão pelo que você passou.",shape=box,color=blue];
		1212 -> 1217;
	1213 [label="Check boolean LyonAllRight",color=orange];
		1213 -> 1219 [label=true,color=green];
		1213 -> 1218 [label=false,color=brown];
	1214 [label="Creio que você chegou vários anos e 1 soro de Protoframe tarde demais para pôr fim a essa minha compulsão em particular. Aliás, temo que agora seja uma necessidade, não é?",shape=box,color=blue];
		1214 -> 1220;
	1221 [label="+5 Chemistry",color=orange];
		1221 -> 1226;
	1216 [label="Portanto, deixo-lhe com isto:",shape=box,color=blue];
		1216 -> 1222;
	1217 [label="A linguagem parece insignificante quando momentos como esses acontecem. Tentamos usá-la da melhor maneira possível, mas ela sempre parece nos falhar. ",shape=box,color=blue];
		1217 -> 1223;
	1219 [label="Novamente, estou tentando não rir da ideia de que, um dia, eu possa chegar perto de estar \"bem\". Mas agradeço muito o sentimento, Peregrino.",shape=box,color=blue];
		1219 -> 1224;
	1218 [label="Estou tentando não rir da ideia de que, um dia, eu possa chegar perto de estar \"bem\". Mas agradeço muito o sentimento, Peregrino.",shape=box,color=blue];
		1218 -> 1224;
	1220 [label="+5 Chemistry",color=orange];
		1220 -> 1225;
	1226 [label="Se a capacidade de curar minha compulsão por me machucar estava ao meu alcance antes de injetar o soro, acredito que me unir ao Warframe \"Harrow\" tornou isso completamente impossível agora. ",shape=box,color=blue];
		1226 -> 1231;
	1222 [label="Precisamos nos lembrar de como encontrar forças para ajudar o outro a se levantar, mesmo quando não temos forças para ficar de pé. ",shape=box,color=blue];
		1222 -> 1227;
	1223 [label="Há 3 coisas que eu poderia fazer, se me permitisse, à luz da sua confissão.",shape=box,color=blue];
		1223 -> 1228;
	1224 [label="+5 Chemistry",color=orange];
		1224 -> 1229;
		1224 -> 1230;
	1225 [label="Mas não quero parecer tão leviano em relação ao que acredito ser uma expressão de preocupação com meu bem-estar físico e mental, me perdoe. Simplesmente não acho que esteja ao meu alcance parar com isso.",shape=box,color=blue];
		1225 -> 1229;
		1225 -> 1230;
	1231 [label="Se me permite ser bastante direto, Peregrino, não creio ser mais capaz de me causar qualquer dano permanente e real.",shape=box,color=blue];
		1231 -> 1235;
	1227 [label="Esse é o verdadeiro propósito de uma história. ",shape=box,color=blue];
		1227 -> 1232;
	1228 [label="Em primeiro lugar, quero assegurar-lhe prontamente que não corro nenhum perigo. Se você acredita que existe algum profundo e terrível ódio por mim mesmo que alimenta meu desejo de me machucar, eu ficaria muito feliz em dissipar esses medos. ",shape=box,color=blue];
		1228 -> 1233;
	1229 [label="Deixa eu perguntar… por que você faz isso?",shape=box,color=red];
		1229 -> 1234;
	1230 [label="Só tenho medo de que… você vá longe demais",shape=box,color=red];
		1230 -> 1231;
	1235 [label="Embora eu não seja capaz da arrogância necessária para me considerar invulnerável, tal ato parece… digamos… fazer parte do plano.",shape=box,color=blue];
		1235 -> 1241;
	1232 [label="+20 Chemistry",color=orange];
		1232 -> 1236;
	1233 [label="Embora eu… conheça essa grande melancolia, ela não inspira meu turíbulo. (A Marie jamais permitiria, para começar. Ela provavelmente tomaria meu lugar antes de me deixar chegar perto de um novamente.)",shape=box,color=blue];
		1233 -> 1237;
	1234 [label="Evaluate expressions",color=orange];
		1234 -> 1240 [label="LyonBackstory3a, LyonLecture2",color=purple];
		1234 -> 1240 [label="LyonBackstory3b, LyonLecture2",color=purple];
		1234 -> 1239 [label="LyonBackstory3a",color=purple];
