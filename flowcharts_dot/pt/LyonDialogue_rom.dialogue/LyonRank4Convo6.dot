	1241 [label="+5 Chemistry",color=orange];
		1241 -> 1246;
	1236 [label="Fique bem, Peregrino. Falaremos novamente em breve.",shape=box,color=blue];
		1236 -> 1242;
	1237 [label="Mas tais dores profundas jamais me sussurraram à noite, meu amigo. Isto eu posso te jurar. Isto eu te prometo, por tudo e todos que me são valiosos.",shape=box,color=blue];
		1237 -> 1243;
	1240 [label="Eu lhe contei a verdade sobre o que me inspira a agir: a dor limpa minha mente das visões que me atormentam. E essa prática não é tão vergonhosa entre os Irmãos da Lua quanto pode ser em sua cultura. Posso jurar, por tudo que me é valioso, que não estou escondendo nenhum segredo.",shape=box,color=blue];
		1240 -> 1245;
	1239 [label="Esse é um assunto complexo, pois os motivos que me levam a dilacerar minha própria carne não são únicos. Já lhe falei das visões que me atormentam e de como a dor clareia minha mente. Mas o ato em si não é tão tabu quanto você imagina. ",shape=box,color=blue];
		1239 -> 1244;
	1238 [label="Esse é um assunto complexo, pois os motivos que me levaram a rasgar minha própria carne não são únicos. Devo começar dizendo que o assunto não é tão tabu quanto pode parecer para você nos dias de hoje. ",shape=box,color=blue];
		1238 -> 1244;
	1246 [label="Não acho que o que faço seja \"certo\". Não acho que o que faço deva ser praticado por outros. Não acho que o que faço seja invejável. ",shape=box,color=blue];
		1246 -> 1251;
	1242 [label="- Padre Lyon Allard",shape=box,color=blue];
		1242 -> 1247;
	1243 [label="Em segundo lugar, devo parabenizá-lo pela coragem de me enviar essas palavras. Teria sido mais fácil evitá-las, mas você não o fez.",shape=box,color=blue];
		1243 -> 1248;
	1245 [label="Se você acredita que existe algum profundo e terrível ódio por mim mesmo que alimenta meu desejo de me machucar, eu ficaria muito feliz em dissipar esses medos. ",shape=box,color=blue];
		1245 -> 1250;
	1244 [label="Entre os Irmãos da Lua, existe uma antiga prática de flagelação. É rara, e mesmo na minha época, era vista como arcaica e usada somente por aqueles que eram \"abençoados por suas visões\".",shape=box,color=blue];
		1244 -> 1249;
	1251 [label="Contudo, no meu estado incrivelmente único e bastante \"sobrenatural\", no sentido mais literal da palavra, também não é estritamente \"perigoso\" para mim.",shape=box,color=blue];
		1251 -> 1256;
	1247 [label="Update boolean LyonSpeech",color=orange];
		1247 -> 1252;
	1248 [label="Em terceiro lugar: eu não compreendo, nem jamais compreenderei, o contexto do sofrimento da pessoa que você mencionou. E, de certa forma, ninguém além dela mesma jamais compreenderá.",shape=box,color=blue];
		1248 -> 1253;
	1250 [label="Embora eu… conheça essa grande melancolia, ela não inspira meu turíbulo. A Marie jamais permitiria, para começar.",shape=box,color=blue];
		1250 -> 1255;
	1249 [label="Um dos padres da catedral me ensinou isso, pouco depois da minha chegada, quando viu que eu também era… \"abençoado\", e achou por bem me ajudar. ",shape=box,color=blue];
		1249 -> 1254;
	1256 [label="De fato, muitas vezes me perguntei se não existiria algum milagre da ciência moderna que pudesse me ajudar com meus problemas. Se eu estivesse em condições de aceitar tal ajuda, eu a aceitaria. Duvido que minha fisiologia permita isso agora. ",shape=box,color=blue];
		1256 -> 1261;
	1252 [label="Chat ends.",color=orange];
	1253 [label="Sofrer de uma forma tão avassaladora é, por definição, algo solitário.",shape=box,color=blue];
		1253 -> 1257;
	1255 [label="Update boolean LyonSNo",color=orange];
		1255 -> 1260;
		1255 -> 1259;
		1255 -> 1258;
	1254 [label="Update boolean LyonLecture2",color=orange];
		1254 -> 1258;
		1254 -> 1259;
		1254 -> 1260;
	1261 [label="Independentemente disso, garanto-lhe: não morrerei por causa disso. É um fardo que carrego desde criança. E é um sintoma que decidi ser melhor do que a ferida infeccionada por baixo, caso eu deixe a crosta sem cutucar. ",shape=box,color=blue];
		1261 -> 1264;
	1257 [label="Simplesmente peço ao meu deus, ao seu e ao dos outros que você não guarde culpa em seu coração. Pois, se há algo neste mundo ou em qualquer outro que mereça perdão, é a bondade de conhecer alguém que sofreu tanto.",shape=box,color=blue];
		1257 -> 1262;
	1260 [label="E você tem certeza de que nunca vai… passar dos limites?",shape=box,color=red];
		1260 -> 1231;
	1259 [label="Fico impressionado com o quão estranhas as práticas religiosas podem ser…",shape=box,color=red];
		1259 -> 1263;
	1258 [label="Isso me faz sentir um pouco melhor, eu acho",shape=box,color=red];
		1258 -> 1231;
	1264 [label="Check boolean LyonSNo",color=orange];
		1264 -> 1267 [label=true,color=green];
		1264 -> 1268 [label=false,color=brown];
	1262 [label="+15 Chemistry",color=orange];
		1262 -> 1265;
	1263 [label="Não encontrarei motivos para discutir com você nesse ponto. Sou fascinado pelas diferenças entre as cerimônias religiosas. Gosto muito de estudar toda a documentação sobre elas. ",shape=box,color=blue];
		1263 -> 1266;
	1267 [label="+10 Chemistry",color=orange];
		1267 -> 1271;
	1268 [label="Se você acredita que existe algum profundo e terrível ódio por mim mesmo que alimenta meu desejo de me machucar, eu ficaria muito feliz em dissipar esses medos. ",shape=box,color=blue];
		1268 -> 1272;
	1265 [label="Fique bem, Peregrino. Falaremos novamente em breve.",shape=box,color=blue];
		1265 -> 1269;
	1266 [label="A antropologia religiosa é um tema que me é muito importante e valioso. Há muito que se pode aprender sobre uma sociedade e um povo através do estudo de seus rituais. ",shape=box,color=blue];
		1266 -> 1270;
	1271 [label="Mas prometo-te isto: se algum dia eu realmente temer que chegue o momento em que não possa mais confiar em mim mesmo, eu direi as palavras.",shape=box,color=blue];
		1271 -> 1275;
	1272 [label="Embora eu… conheça essa grande melancolia, ela não inspira meu turíbulo. A Marie jamais permitiria, para começar.",shape=box,color=blue];
		1272 -> 1267;
	1269 [label="- Padre Lyon Allard",shape=box,color=blue];
		1269 -> 1273;
	1270 [label="Existe uma seita dos Luminários no extremo norte congelado, que venera um cadáver desenterrado de uma geleira em recuo. Estava perfeitamente preservado, e ninguém sabe ao certo quantos anos tem. Mas o disco de latão que usava no pescoço tinha a imagem de um sol estampada.",shape=box,color=blue];
		1270 -> 1274;
	1275 [label="Para a Marie, para você, para o Sr. Loid, até mesmo para o Roathe, não fará diferença. Eu direi as palavras. Isto eu prometo.",shape=box,color=blue];
		1275 -> 1277;
		1275 -> 1278;
	1273 [label="Chat ends.",color=orange];
	1274 [label="Eles acreditam que o corpo mumificado seja o do próprio Sol. E acreditam que, um dia, ele retornará à vida e ressuscitará. A cada 100 anos, eles se preparam para \"A Grande Véspera\", e muitos de seus seguidores bebem vinho envenenado na noite anterior.",shape=box,color=blue];
		1274 -> 1276;
	1277 [label="Isso é o máximo que eu poderia pedir. Valeu, Lyon",shape=box,color=red];
		1277 -> 1280;
	1278 [label="Confio em você, só queria conversar direito sobre tudo isso",shape=box,color=red];
		1278 -> 1280;
	1276 [label="Nem é preciso dizer que, quando o corpo mumificado não retorna na manhã seguinte, eles têm uma razão perfeitamente válida para explicar por que seus cálculos estavam errados, e a data é alterada em mais um século… ou mais.",shape=box,color=blue];
		1276 -> 1279;
	1280 [label="E agradeço profundamente seu desejo de saber que não estou agindo por um impulso desenfreado de me autodestruir.",shape=box,color=blue];
		1280 -> 1281;
	1279 [label="Mas eu me desviei bastante do assunto em questão. ",shape=box,color=blue];
		1279 -> 1241;
	1281 [label="Não estou acostumado a ter esse tipo de companhia na minha vida. ",shape=box,color=blue];
		1281 -> 1282;
	1282 [label="Fique bem, Peregrino. Falaremos novamente em breve.",shape=box,color=blue];
		1282 -> 1283;
	1283 [label="- Padre Lyon Allard",shape=box,color=blue];
		1283 -> 1284;
	1284 [label="Chat ends.",color=orange];
}