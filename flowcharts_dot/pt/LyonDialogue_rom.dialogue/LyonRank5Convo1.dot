		j326220540 -> j3901094489;
	j496598382 [label="Você significa tudo pra Marie. Você se tornou um amigo muito querido pra mim. Acho que até o Roathe sentiria sua falta… embora ele não admita",shape=box,color=red];
		j496598382 -> j170883130;
