	1315 [label="Você mencionou antes que queria falar sobre o fato de eu não acreditar que a Indiferença seja um \"deus de verdade\"… agora seria um bom momento?",shape=box,color=red];
		1315 -> 1320;
	1313 [label="[Encerrar Conversa]",shape=box,color=red];
		1313 -> 1318;
	1314 [label="Outro dia, você me perguntou sobre a Incorporação Conceitual e sobre a Indiferença… tem algo te preocupando?",shape=box,color=red];
		1314 -> 1319;
	1317 [label="O Roathe tá convencido de que o Homem na Parede não é um deus de verdade, que ele é produto de uma \"Incorporação Conceitual\". O que você acha disso?",shape=box,color=red];
		1317 -> 1322;
	1316 [label="Lyon, o que tá acontecendo entre você e o Roathe? Só consegui entender alguns fragmentos da história toda",shape=box,color=red];
		1316 -> 1321;
	1320 [label="Não tenho certeza se qualquer momento é um \"bom\" momento para discutir o problema concreto que isso me causou, Peregrino.",shape=box,color=blue];
		1320 -> 1324;
	1318 [label="Chat ends.",color=orange];
	1319 [label="Há muitas coisas que me incomodam, Peregrino. O tema da Indiferença e da Incorporação Conceitual, receio, é somente uma delas.",shape=box,color=blue];
		1319 -> 1323;
	1322 [label="A questão, Peregrino, é que eu não sei. Se eu soubesse a resposta, não estaria me atormentando com esse debate interno.",shape=box,color=blue];
		1322 -> 1326;
	1321 [label="Vou resumir, embora esteja surpreso que você tenha evitado os discursos dele sobre o assunto. Ele está sempre muito ansioso para compartilhá-los em todas as oportunidades. ",shape=box,color=blue];
		1321 -> 1325;
	1324 [label="Mas, sendo assim, agora é um momento tão \"bom\" quanto qualquer outro. Me intrigou o fato de você parecer concordar com o Roathe em sua crença de que a Indiferença não era um deus verdadeiro.",shape=box,color=blue];
		1324 -> 1326;
	1323 [label="Ou possivelmente duas, dependendo de como você interpreta a situação. Embora eu suponha que esse seja, de fato, o cerne do meu dilema. ",shape=box,color=blue];
		1323 -> 1326;
	1326 [label="No entanto, devo… começar pelo começo. Você não entenderá exatamente porque este tópico em particular é tão importante para mim se não tiver algum contexto…",shape=box,color=blue];
		1326 -> 1328;
	1325 [label="Ele acredita que a Indiferença não é um deus do Void, em nenhum sentido da palavra, e que, na verdade, foi criada pelo Entrati e todos aqueles que interagiram com ela posteriormente.",shape=box,color=blue];
		1325 -> 1327;
	1328 [label="Sou um Irmão da Lua. Dediquei minha vida à sua adoração. Por toda a minha vida, acreditei nisso.",shape=box,color=blue];
		1328 -> 1330;
	1327 [label="Criaram-na a partir do Void, através do que você conhece como \"Incorporação Conceitual\".",shape=box,color=blue];
		1327 -> 1329;
	1330 [label="E ao longo de todos os anos desde que cheguei à igreja, mantive-me firme na minha fé… na certeza de que, meu sofrimento, minha dor e minhas visões…",shape=box,color=blue];
		1330 -> 1331;
	1329 [label="Acredito que você criou Duviri de maneira muito semelhante.",shape=box,color=blue];
		1329 -> 1326;
	1331 [label="Estiveram a seu serviço. Foram em seu nome. E foram para o seu propósito.",shape=box,color=blue];
		1331 -> 1332;
	1332 [label="Foi isso… até que o \"Cardeal Dimanche\" revelou ser Albrecht Entrati.",shape=box,color=blue];
		1332 -> 1333;
	1333 [label="E ele nos contou a verdade sobre quem ele era, a história de seus delitos com o Void e tudo o que aconteceu depois. Mais especificamente… tudo o que resultou disso.",shape=box,color=blue];
		1333 -> 1334;
		1333 -> 1335;
	1334 [label="A Indiferença",shape=box,color=red];
		1334 -> 1336;
	1335 [label="E aí?",shape=box,color=red];
		1335 -> 1337;
	1336 [label="Correto. Ele nos contou sobre a criatura zombeteira que o cumprimentou, sobre os dedos que recuperou daquele lugar que lembrava seu laboratório. ",shape=box,color=blue];
		1336 -> 1338;
	1337 [label="Ele nos contou sobre sua descida na campânula de vidro ao vazio imenso. Sobre o lugar que lembrava seu laboratório. ",shape=box,color=blue];
		1337 -> 1338;
	1338 [label="Além disso, ele nos contou sobre o grande pavor que sentia, sabendo que havia libertado algo que poderia segui-lo não somente pelo espaço, mas também pelo tempo.",shape=box,color=blue];
		1338 -> 1339;
	1339 [label="Um deus do nada. Uma coisa que precisa ser contida. Uma criatura da qual ele era feito de pedaços, que arranhava as paredes para se libertar. ",shape=box,color=blue];
		1339 -> 1340;
	1340 [label="Um deus terrível e devorador que era, e ao mesmo tempo não era, livre.",shape=box,color=blue];
		1340 -> 1341;
		1340 -> 1342;
	1341 [label="Como assim?",shape=box,color=red];
		1341 -> 1343;
	1342 [label="\"Era\" e \"não era\" livre?",shape=box,color=red];
		1342 -> 1343;
