		1352 -> 1355;
	1353 [label="Garanto que faremos isso. Sei que tenho evitado o assunto de forma gritante, e peço desculpas. Mas é provável que isso me leve a uma visão da qual não tenho certeza se conseguirei me recuperar facilmente. ",shape=box,color=blue];
