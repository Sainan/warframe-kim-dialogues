		j2228720352 -> j2403416966 [label="false",color=purple];
	j3744742653 [label="Peço-lhe perdão. Há momentos em que minha lucidez me falha, e detesto quando outros testemunham isso. ",shape=box,color=blue];
		j3744742653 -> j1242024200;
	j3123222448 [label="Seria tão fácil me render… desistir… depositar minha agonia no altar do sofrimento e dizer \"chega\".",shape=box,color=blue];
