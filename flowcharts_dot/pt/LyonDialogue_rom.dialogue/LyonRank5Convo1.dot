		1361 -> 1364;
	1362 [label="Obrigado. Admiro sua paciência. Sei que, mesmo nos melhores dias, não passo de um vitral estilhaçado. Fico aqui parado, me perguntando para onde foram muitos dos pedaços.",shape=box,color=blue];
