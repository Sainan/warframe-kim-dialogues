		1343 -> 1344 [label=false,color=brown];
	1345 [label="O tempo é… confuso, para alguém como eu, no estado em que me encontro agora. É difícil descrever. Já tentei explicar isso uma vez, e falhei miseravelmente.",shape=box,color=blue];
		1345 -> 1346;
	1344 [label="O tempo é… confuso, para alguém como eu, no estado em que me encontro agora. É difícil descrever, e estou fazendo um péssimo trabalho nisso.",shape=box,color=blue];
		1344 -> 1346;
