	j3425346075 [label="Seria tão fácil me render… desistir… depositar minha agonia no altar do sofrimento e dizer \"chega\". Ou fazer algo muito pior: fazer aquilo que muitos temiam que eu pudesse fazer com uma lâmina na escuridão da noite.",shape=box,color=blue];
		j3425346075 -> j338224732;
	j2635349050 [label="Há… somente uma questão, Peregrino. Como posso aceitar suas palavras como verdade, se sei que você já espalhou mentiras antes?",shape=box,color=blue];
		j2635349050 -> j397135362;
	j3412470038 [label="Embora me sinta lisonjeado, receio que minha resposta seja simplesmente e inequivocamente… não.",shape=box,color=blue];
