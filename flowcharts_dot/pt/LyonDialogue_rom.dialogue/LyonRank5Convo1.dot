		j3626627435 -> j17348121 [label="false",color=purple];
	j2622555860 [label="Você mencionou antes que queria falar sobre o fato de eu não acreditar que a Indiferença seja um \"deus de verdade\"… agora seria um bom momento?",shape=box,color=red];
		j2622555860 -> j490691846;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j143778973 [label="Outro dia, você me perguntou sobre a Incorporação Conceitual e sobre a Indiferença… tem algo te preocupando?",shape=box,color=red];
		j143778973 -> j4071213251;
	j1443657653 [label="O Roathe tá convencido de que o Homem na Parede não é um deus de verdade, que ele é produto de uma \"Incorporação Conceitual\". O que você acha disso?",shape=box,color=red];
		j1443657653 -> j1187185197;
	j3411200867 [label="Lyon, o que tá acontecendo entre você e o Roathe? Só consegui entender alguns fragmentos da história toda",shape=box,color=red];
		j3411200867 -> j4288732861;
	j490691846 [label="Não tenho certeza se qualquer momento é um \"bom\" momento para discutir o problema concreto que isso me causou, Peregrino.",shape=box,color=blue];
		j490691846 -> j834451982;
	"Chat ends." [color=orange];
	j4071213251 [label="Há muitas coisas que me incomodam, Peregrino. O tema da Indiferença e da Incorporação Conceitual, receio, é somente uma delas.",shape=box,color=blue];
		j4071213251 -> j2691114799;
	j1187185197 [label="A questão, Peregrino, é que eu não sei. Se eu soubesse a resposta, não estaria me atormentando com esse debate interno.",shape=box,color=blue];
		j1187185197 -> j87691079;
	j4288732861 [label="Vou resumir, embora esteja surpreso que você tenha evitado os discursos dele sobre o assunto. Ele está sempre muito ansioso para compartilhá-los em todas as oportunidades. ",shape=box,color=blue];
		j4288732861 -> j458033234;
	j834451982 [label="Mas, sendo assim, agora é um momento tão \"bom\" quanto qualquer outro. Me intrigou o fato de você parecer concordar com o Roathe em sua crença de que a Indiferença não era um deus verdadeiro.",shape=box,color=blue];
		j834451982 -> j87691079;
	j2691114799 [label="Ou possivelmente duas, dependendo de como você interpreta a situação. Embora eu suponha que esse seja, de fato, o cerne do meu dilema. ",shape=box,color=blue];
		j2691114799 -> j87691079;
	j87691079 [label="No entanto, devo… começar pelo começo. Você não entenderá exatamente porque este tópico em particular é tão importante para mim se não tiver algum contexto…",shape=box,color=blue];
		j87691079 -> j64755607;
	j458033234 [label="Ele acredita que a Indiferença não é um deus do Void, em nenhum sentido da palavra, e que, na verdade, foi criada pelo Entrati e todos aqueles que interagiram com ela posteriormente.",shape=box,color=blue];
		j458033234 -> j421972856;
	j64755607 [label="Sou um Irmão da Lua. Dediquei minha vida à sua adoração. Por toda a minha vida, acreditei nisso.",shape=box,color=blue];
		j64755607 -> j2070468558;
	j421972856 [label="Criaram-na a partir do Void, através do que você conhece como \"Incorporação Conceitual\".",shape=box,color=blue];
		j421972856 -> j287450948;
	j2070468558 [label="E ao longo de todos os anos desde que cheguei à igreja, mantive-me firme na minha fé… na certeza de que, meu sofrimento, minha dor e minhas visões…",shape=box,color=blue];
		j2070468558 -> j1802617951;
	j287450948 [label="Acredito que você criou Duviri de maneira muito semelhante.",shape=box,color=blue];
		j287450948 -> j87691079;
	j1802617951 [label="Estiveram a seu serviço. Foram em seu nome. E foram para o seu propósito.",shape=box,color=blue];
		j1802617951 -> j1007896448;
	j1007896448 [label="Foi isso… até que o \"Cardeal Dimanche\" revelou ser Albrecht Entrati.",shape=box,color=blue];
		j1007896448 -> j2151127590;
	j2151127590 [label="E ele nos contou a verdade sobre quem ele era, a história de seus delitos com o Void e tudo o que aconteceu depois. Mais especificamente… tudo o que resultou disso.",shape=box,color=blue];
		j2151127590 -> j1465101185;
		j2151127590 -> j382632303;
	j1465101185 [label="A Indiferença",shape=box,color=red];
		j1465101185 -> j4219156746;
	j382632303 [label="E aí?",shape=box,color=red];
		j382632303 -> j2250194422;
	j4219156746 [label="Correto. Ele nos contou sobre a criatura zombeteira que o cumprimentou, sobre os dedos que recuperou daquele lugar que lembrava seu laboratório. ",shape=box,color=blue];
		j4219156746 -> j3106040279;
	j2250194422 [label="Ele nos contou sobre sua descida na campânula de vidro ao vazio imenso. Sobre o lugar que lembrava seu laboratório. ",shape=box,color=blue];
		j2250194422 -> j3106040279;
	j3106040279 [label="Além disso, ele nos contou sobre o grande pavor que sentia, sabendo que havia libertado algo que poderia segui-lo não somente pelo espaço, mas também pelo tempo.",shape=box,color=blue];
		j3106040279 -> j1288077594;
	j1288077594 [label="Um deus do nada. Uma coisa que precisa ser contida. Uma criatura da qual ele era feito de pedaços, que arranhava as paredes para se libertar. ",shape=box,color=blue];
		j1288077594 -> j267803136;
	j267803136 [label="Um deus terrível e devorador que era, e ao mesmo tempo não era, livre.",shape=box,color=blue];
		j267803136 -> j1009324523;
		j267803136 -> j3877579478;
	j1009324523 [label="Como assim?",shape=box,color=red];
		j1009324523 -> j3826452011;
	j3877579478 [label="\"Era\" e \"não era\" livre?",shape=box,color=red];
		j3877579478 -> j3826452011;
	j3826452011 [label="Check boolean LyonRell1",color=orange];
		j3826452011 -> j614963951 [label=true,color=green];
		j3826452011 -> j197793497 [label=false,color=brown];
	j614963951 [label="O tempo é… confuso, para alguém como eu, no estado em que me encontro agora. É difícil descrever. Já tentei explicar isso uma vez, e falhei miseravelmente.",shape=box,color=blue];
		j614963951 -> j2593557654;
	j197793497 [label="O tempo é… confuso, para alguém como eu, no estado em que me encontro agora. É difícil descrever, e estou fazendo um péssimo trabalho nisso.",shape=box,color=blue];
		j197793497 -> j2593557654;
	j2593557654 [label="Prefiro explicar os detalhes em outra ocasião, pois esse não é o ponto principal do que estou tentando abordar hoje. ",shape=box,color=blue];
		j2593557654 -> j366078008;
	j366078008 [label="Check boolean LyonRell1",color=orange];
		j366078008 -> j3836625681 [label=true,color=green];
		j366078008 -> j2322408367 [label=true,color=green];
		j366078008 -> j4281086123 [label=true,color=green];
		j366078008 -> j2322408367 [label=false,color=brown];
		j366078008 -> j4281086123 [label=false,color=brown];
	j3836625681 [label="Mas se você tá ouvindo… ou ouviu o Rell falar… eu queria falar sobre isso",shape=box,color=red];
		j3836625681 -> j2436022765;
	j2322408367 [label="Certo, você que manda",shape=box,color=red];
		j2322408367 -> j1819059464;
	j4281086123 [label="Mas é esse assunto que eu quero abordar…",shape=box,color=red];
		j4281086123 -> j431798675;
	j2436022765 [label="Eu sei. E tenho evitado o assunto de forma gritante. Só o nome dele. ",shape=box,color=blue];
		j2436022765 -> j4074897540;
	j1819059464 [label="Sei que tenho evitado o assunto de forma gritante, e peço desculpas. Mas é provável que isso me leve a uma visão da qual não tenho certeza se conseguirei me recuperar facilmente. ",shape=box,color=blue];
		j1819059464 -> j1841580924;
	j431798675 [label="Garanto que faremos isso. Sei que tenho evitado o assunto de forma gritante, e peço desculpas. Mas é provável que isso me leve a uma visão da qual não tenho certeza se conseguirei me recuperar facilmente. ",shape=box,color=blue];
		j431798675 -> j1841580924;
	j4074897540 [label="ele me ameaça",shape=box,color=blue];
		j4074897540 -> j3279023235;
	j1841580924 [label="Não desejo ter que interromper esta conversa mais uma vez por não poder continuá-la devido às minhas próprias enfermidades e fraquezas. ",shape=box,color=blue];
		j1841580924 -> j120742410;
		j1841580924 -> j849594971;
		j1841580924 -> j4026988803;
	j3279023235 [label="evoca imagens de um homem acorrentado",shape=box,color=blue];
		j3279023235 -> j2162652456;
	j120742410 [label="Não chamaria de \"fraqueza\" alguém que teve que suportar o que você passou, Lyon",shape=box,color=red];
		j120742410 -> j4019712566;
	j849594971 [label="\"Fraqueza\" é uma forma terrível de dizer \"amaldiçoado com visões indesejadas\", mas você que manda",shape=box,color=red];
		j849594971 -> j4019712566;
	j4026988803 [label="Você sabe do que é capaz, então, seguirei sua orientação",shape=box,color=red];
		j4026988803 -> j1906309518;
	j2162652456 [label="banhado em sangue ",shape=box,color=blue];
		j2162652456 -> j2450848884;
	j4019712566 [label="Agradeço a intenção. Mas sei que, mesmo nos melhores dias, não passo de um vitral estilhaçado. Fico aqui me perguntando para onde foram muitos dos pedaços. ",shape=box,color=blue];
		j4019712566 -> j121504917;
	j1906309518 [label="Obrigado. Admiro sua paciência. Sei que, mesmo nos melhores dias, não passo de um vitral estilhaçado. Fico aqui parado, me perguntando para onde foram muitos dos pedaços.",shape=box,color=blue];
		j1906309518 -> j121504917;
	j2450848884 [label="tendões e carne lacerados",shape=box,color=blue];
		j2450848884 -> j1721270841;
	j121504917 [label="Cada vez que encontro um, corro mais risco de me cortar nas bordas do que de conseguir encaixá-lo de volta no lugar.",shape=box,color=blue];
		j121504917 -> j2386822346;
	j1721270841 [label="por favor faz isso parar",shape=box,color=blue];
		j1721270841 -> j2275496392;
	j2386822346 [label="Às vezes, me pergunto se não seria melhor me tornar um daqueles Harrows de olhos verdadeiramente vazios que vejo em minha mente, estendendo-se, até onde meus pesadelos permitirem.",shape=box,color=blue];
		j2386822346 -> j3090338735;
