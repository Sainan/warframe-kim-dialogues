		1757 -> 1766;
		1757 -> 1768;
	1756 [label="A Indiferença foi criada pela gente, ela não é um deus, Lyon. Não deixa o erro do Entrati te destruir. E quanto à sua fé?",shape=box,color=red];
		1756 -> 1766;
