		1800 -> 1802;
		1800 -> 1803;
	1801 [label="Se a Indiferença é ou não um deus, não sei qual é a minha posição sobre o assunto. Não tenho provas suficientes para tomar uma decisão em qualquer sentido. Mas suponho que isso não muda muita coisa, não é? ",shape=box,color=blue];
		1801 -> 1802;
		1801 -> 1803;
	1802 [label="Acho que muda muita coisa. Se não for um deus verdadeiro, é algo criado por pessoas. Isso significa que pode ser derrotado por pessoas também",shape=box,color=red];
		1802 -> 1804;
	1803 [label="Como assim?",shape=box,color=red];
		1803 -> 1805;
	1804 [label="Se você não tinha esperança de que ela pudesse ser derrotada pelos nossos esforços, por que se deu ao trabalho de se opor a ela em primeiro lugar? Verdadeiramente, você é uma criatura… desconcertante.",shape=box,color=blue];
		1804 -> 1806;
	1805 [label="O método pelo qual ela chegou ao nosso universo não altera os métodos pelos quais poderíamos derrotá-la.",shape=box,color=blue];
		1805 -> 1807;
	1806 [label="Você não pode estar falando sério. Então você está simplesmente \"concordando\" com as ações dos outros? Lutando contra isso, por falta de algo melhor para fazer?",shape=box,color=blue];
		1806 -> 1808;
	1807 [label="Eis que surge um deus de nossa criação, tecido a partir do próprio vazio do Void.",shape=box,color=blue];
		1807 -> 1809;
	1808 [label="Certamente, você poderia pensar em um hobby melhor.",shape=box,color=blue];
		1808 -> 1810;
		1808 -> 1811;
	1809 [label="Uma boneca de tecido que podemos encher demais com tristeza, nossa dor, nosso sofrimento, nossa raiva, nossa agonia… até que as costuras ameacem se romper.",shape=box,color=blue];
		1809 -> 1812;
	1810 [label="Não, eu não achei que fosse uma situação sem esperança… não foi isso que eu quis dizer",shape=box,color=red];
		1810 -> 1813;
	1811 [label="O que eu quis dizer é que isso muda a forma como podemos pensar sobre como matar isso… como compreender isso",shape=box,color=red];
		1811 -> 1814;
	1812 [label="Me perdoe, mas isso me causa muito mais pavor do que se fosse um deus antes de nós chegarmos aqui. ",shape=box,color=blue];
		1812 -> 1815;
	1813 [label="Pensar antes de falar não é um pré-requisito. O mesmo vale para as balas de suas armas. ",shape=box,color=blue];
		1813 -> 1807;
	1814 [label="Não acredito que isso seja verdade. Eu diria que entendemos tão pouco sobre suas motivações agora quanto entenderíamos se fosse algum \"deus grandioso e incognoscível\".",shape=box,color=blue];
		1814 -> 1807;
	1815 [label="Sim… na verdade, acho que prefiro assim.",shape=box,color=blue];
		1815 -> 1816;
	1816 [label="Talvez haja alguma esperança de que possa ser mais inteligente do que a humanidade em geral. ",shape=box,color=blue];
		1816 -> 1817;
