	"Chat ends." [color=orange];
	j2502669250 [label="Somente para que a presença deles fosse arrancada da minha alma novamente, restando somente como uma lembrança. E como isso pode ter sido uma dádiva da Lua…",shape=box,color=blue];
		j2502669250 -> j3953874398;
	j1738291918 [label="Somente para que a presença deles fosse arrancada da minha alma novamente, restando somente como uma lembrança. E você tem razão, isso pode significar que não existem deuses neste mundo.",shape=box,color=blue];
		j1738291918 -> j396193836;
	j3554616964 [label="Somente para que a presença deles fosse arrancada da minha alma novamente, restando somente como uma lembrança. E eu não sei se isso significa que existem deuses neste mundo ou não.",shape=box,color=blue];
		j3554616964 -> j3366476280;
	j1626639119 [label="Me envolvi com o passado deles da mesma forma que eles se envolveram com o meu. Vi toda a Zariman 10-0, vislumbres da Guerra Ancestral e, da mesma forma, eles viram todo o meu passado.",shape=box,color=blue];
		j1626639119 -> j414098055;
	j3953874398 [label="Cheguei à conclusão de que nossa dama prateada daria uma bênção tão trágica. Ela não desejaria apagar a memória da dor, como a que o Roathe sofreu.",shape=box,color=blue];
		j3953874398 -> j2400124821;
	j396193836 [label="Mas isso não muda, creio eu, os anos que passei a serviço de uma organização que, em sua essência, tinha como objetivo praticar boas ações neste mundo. ",shape=box,color=blue];
		j396193836 -> j3596744608;
	j3366476280 [label="Como você disse, nós… talvez nunca saibamos. E talvez nem nos caiba saber. Assim são as coisas. Mas isso não muda, creio eu, os anos que passei a serviço de uma organização que, em sua essência, tinha como objetivo praticar boas ações neste mundo.",shape=box,color=blue];
		j3366476280 -> j3596744608;
	j414098055 [label="Isso… colocou muitas coisas em questão para mim, principalmente… a minha fé. Ela desmoronou e se desfez, como papel carbonizado, virando pó. Eu me detesto por essa fraqueza…",shape=box,color=blue];
		j414098055 -> j3287457751;
	j2400124821 [label="Ela também não quis tirar a ardência do chicote da minha pele. Certamente não é do feitio dela me proteger da dor da sua morte. ",shape=box,color=blue];
		j2400124821 -> j4006403278;
	j3596744608 [label="Para ajudar aqueles que desejam aliviar a dor em suas vidas nos momentos em que ela os sufocaria. ",shape=box,color=blue];
		j3596744608 -> j3795006552;
	j3287457751 [label="Evaluate expressions",color=orange];
