	1745 [label="Somente para que a presença deles fosse arrancada da minha alma novamente, restando somente como uma lembrança. E eu não sei se isso significa que existem deuses neste mundo ou não.",shape=box,color=blue];
		1745 -> 1749;
	1744 [label="Me envolvi com o passado deles da mesma forma que eles se envolveram com o meu. Vi toda a Zariman 10-0, vislumbres da Guerra Ancestral e, da mesma forma, eles viram todo o meu passado.",shape=box,color=blue];
		1744 -> 1748;
	1751 [label="Cheguei à conclusão de que nossa dama prateada daria uma bênção tão trágica. Ela não desejaria apagar a memória da dor, como a que o Roathe sofreu.",shape=box,color=blue];
		1751 -> 1754;
	1750 [label="Mas isso não muda, creio eu, os anos que passei a serviço de uma organização que, em sua essência, tinha como objetivo praticar boas ações neste mundo. ",shape=box,color=blue];
		1750 -> 1753;
	1749 [label="Como você disse, nós… talvez nunca saibamos. E talvez nem nos caiba saber. Assim são as coisas. Mas isso não muda, creio eu, os anos que passei a serviço de uma organização que, em sua essência, tinha como objetivo praticar boas ações neste mundo.",shape=box,color=blue];
		1749 -> 1753;
	1748 [label="Isso… colocou muitas coisas em questão para mim, principalmente… a minha fé. Ela desmoronou e se desfez, como papel carbonizado, virando pó. Eu me detesto por essa fraqueza…",shape=box,color=blue];
		1748 -> 1752;
	1754 [label="Ela também não quis tirar a ardência do chicote da minha pele. Certamente não é do feitio dela me proteger da dor da sua morte. ",shape=box,color=blue];
