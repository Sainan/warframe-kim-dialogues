		j3255123417 -> j3503665597;
	j1551543455 [label="Pois é a ausência de dor que ameaça nos destruir, tanto quanto o excesso dela pode nos afogar. ",shape=box,color=blue];
		j1551543455 -> j360134701;
		j1551543455 -> j1905584503;
		j1551543455 -> j2062548298;
	j473660432 [label="Nem acredito que todo o meu sofrimento tenha sido em vão. Isso não invalida tudo o que eu suportei. ",shape=box,color=blue];
		j473660432 -> j3088700636;
	j822111764 [label="Não tô dizendo que você precisa reencontrar sua fé, tô dizendo que, se você quiser, se sentir que precisa, ela não tá perdida pra sempre",shape=box,color=red];
		j822111764 -> j2380680521;
	j863930429 [label="Com certeza, a Lua consegue ver o que você passou… o que você suportou em nome dela",shape=box,color=red];
		j863930429 -> j1661200155;
	j1552490761 [label="O que eu acho que você precisa fazer é se concentrar em encontrar algum tipo de paz interior… seja lá como ou onde for que você encontre isso",shape=box,color=red];
		j1552490761 -> j2380680521;
	j1909216496 [label="Se existe um deus, se a sua Lua realmente existe, certamente ela pode ver o que você passou… o que você suportou em nome dela… isso deve significar algo pra ela",shape=box,color=red];
		j1909216496 -> j1661200155;
	j3503665597 [label="Acho que você precisa abandonar qualquer noção sobre a existência ou não de deuses e se concentrar, primeiro, em curar a si mesmo",shape=box,color=red];
		j3503665597 -> j3327466084;
