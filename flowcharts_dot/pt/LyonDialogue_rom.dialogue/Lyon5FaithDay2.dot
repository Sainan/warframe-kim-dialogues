		j3416033096 -> j386370105;
	j386370105 [label="Não sei qual é a minha posição sobre o assunto. Não tenho provas suficientes para tomar uma decisão em qualquer sentido. Mas suponho que isso não muda muita coisa, não é? ",shape=box,color=blue];
		j386370105 -> j3438006515;
		j386370105 -> j3693779547;
	j3157715192 [label="Se a Indiferença é ou não um deus, não sei qual é a minha posição sobre o assunto. Não tenho provas suficientes para tomar uma decisão em qualquer sentido. Mas suponho que isso não muda muita coisa, não é? ",shape=box,color=blue];
		j3157715192 -> j3438006515;
		j3157715192 -> j3693779547;
	j3438006515 [label="Acho que muda muita coisa. Se não for um deus verdadeiro, é algo criado por pessoas. Isso significa que pode ser derrotado por pessoas também",shape=box,color=red];
		j3438006515 -> j1087863886;
	j3693779547 [label="Como assim?",shape=box,color=red];
		j3693779547 -> j1210515220;
	j1087863886 [label="Se você não tinha esperança de que ela pudesse ser derrotada pelos nossos esforços, por que se deu ao trabalho de se opor a ela em primeiro lugar? Verdadeiramente, você é uma criatura… desconcertante.",shape=box,color=blue];
		j1087863886 -> j3912350418;
	j1210515220 [label="O método pelo qual ela chegou ao nosso universo não altera os métodos pelos quais poderíamos derrotá-la.",shape=box,color=blue];
		j1210515220 -> j3825114270;
	j3912350418 [label="Você não pode estar falando sério. Então você está simplesmente \"concordando\" com as ações dos outros? Lutando contra isso, por falta de algo melhor para fazer?",shape=box,color=blue];
		j3912350418 -> j737731197;
	j3825114270 [label="Eis que surge um deus de nossa criação, tecido a partir do próprio vazio do Void.",shape=box,color=blue];
		j3825114270 -> j3341583791;
	j737731197 [label="Certamente, você poderia pensar em um hobby melhor.",shape=box,color=blue];
		j737731197 -> j495970606;
		j737731197 -> j2185142805;
	j3341583791 [label="Uma boneca de tecido que podemos encher demais com tristeza, nossa dor, nosso sofrimento, nossa raiva, nossa agonia… até que as costuras ameacem se romper.",shape=box,color=blue];
		j3341583791 -> j990163544;
	j495970606 [label="Não, eu não achei que fosse uma situação sem esperança… não foi isso que eu quis dizer",shape=box,color=red];
		j495970606 -> j1088747390;
	j2185142805 [label="O que eu quis dizer é que isso muda a forma como podemos pensar sobre como matar isso… como compreender isso",shape=box,color=red];
		j2185142805 -> j76067628;
	j990163544 [label="Me perdoe, mas isso me causa muito mais pavor do que se fosse um deus antes de nós chegarmos aqui. ",shape=box,color=blue];
		j990163544 -> j426976710;
	j1088747390 [label="Pensar antes de falar não é um pré-requisito. O mesmo vale para as balas de suas armas. ",shape=box,color=blue];
		j1088747390 -> j3825114270;
	j76067628 [label="Não acredito que isso seja verdade. Eu diria que entendemos tão pouco sobre suas motivações agora quanto entenderíamos se fosse algum \"deus grandioso e incognoscível\".",shape=box,color=blue];
		j76067628 -> j3825114270;
	j426976710 [label="Sim… na verdade, acho que prefiro assim.",shape=box,color=blue];
		j426976710 -> j4141790428;
	j4141790428 [label="Talvez haja alguma esperança de que possa ser mais inteligente do que a humanidade em geral. ",shape=box,color=blue];
		j4141790428 -> j3684190727;
	j3684190727 [label="Com esse pensamento… tão sombrio, acho que vou me despedir por hoje.",shape=box,color=blue];
		j3684190727 -> j742749064;
