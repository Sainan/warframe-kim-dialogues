		j924136248 -> j3554616964;
	j1403167378 [label="Há algo que eu queria lhe abordar, e só agora tenho a oportunidade de fazê-lo. Quando… o Rell, o Harrow e eu nos entrelaçamos… o como e o porquê disso não importam.",shape=box,color=blue];
