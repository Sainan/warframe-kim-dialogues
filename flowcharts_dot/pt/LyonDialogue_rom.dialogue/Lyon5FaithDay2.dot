		1763 -> 1770;
	1762 [label="E eu sei que, se ainda pudesse encontrar o Rell e a presença de seu Harrow, eles não gostariam que eu sofresse com a perda deles. Eles estão em paz.",shape=box,color=blue];
		1762 -> 1769;
	1760 [label="Ah, Lyon… você passou por tanta coisa. A dúvida não é sinal de fraqueza, mas de dor",shape=box,color=red];
