		j3287457751 -> j3255123417 [label="false",color=purple];
	j4006403278 [label="Enquanto o Sol dissipava a dor como uma faca quente cauteriza uma ferida, a Lua me fazia abraçar o calor da dor que sua ausência poderia trazer.",shape=box,color=blue];
		j4006403278 -> j1551543455;
	j3795006552 [label="E eu sei que, se ainda pudesse encontrar o Rell e a presença de seu Harrow, eles não gostariam que eu sofresse com a perda deles. Eles estão em paz.",shape=box,color=blue];
		j3795006552 -> j473660432;
	j661209348 [label="Ah, Lyon… você passou por tanta coisa. A dúvida não é sinal de fraqueza, mas de dor",shape=box,color=red];
		j661209348 -> j822111764;
