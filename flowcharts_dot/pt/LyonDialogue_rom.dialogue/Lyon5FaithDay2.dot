		j661209348 -> j1552490761;
		j661209348 -> j1909216496;
		j661209348 -> j3503665597;
	j1106813459 [label="A fé não precisa ser constante, nem se espera que seja. Quantas histórias são contadas sobre pessoas que perdem a fé, só pra reencontrar ela de novo?",shape=box,color=red];
		j1106813459 -> j822111764;
		j1106813459 -> j863930429;
		j1106813459 -> j1552490761;
	j2256705764 [label="Lyon, você dedicou sua vida aos nossos Luminários. Acha que eles te abandonariam por algo assim?",shape=box,color=red];
		j2256705764 -> j822111764;
		j2256705764 -> j863930429;
		j2256705764 -> j1552490761;
	j1790722990 [label="Não sei se existem deuses ou não, Lyon. Acho que ninguém pode saber ao certo. Mas o que eu sei é que você já passou por muita coisa",shape=box,color=red];
		j1790722990 -> j822111764;
		j1790722990 -> j1552490761;
		j1790722990 -> j1909216496;
	j2539637486 [label="Embora eu pessoalmente não acredite que existam deuses neste mundo, sei o quanto isso tem sido importante pra você em sua vida, não quero menosprezar isso",shape=box,color=red];
		j2539637486 -> j1552490761;
		j2539637486 -> j3503665597;
	j4266204051 [label="A Indiferença foi criada pela gente, ela não é um deus, Lyon. Não deixa o erro do Entrati te destruir. E quanto à sua fé?",shape=box,color=red];
		j4266204051 -> j1552490761;
		j4266204051 -> j3503665597;
	j3255123417 [label="Sinto muito em te ver assim, no meio de toda essa confusão… você não merecia isso",shape=box,color=red];
