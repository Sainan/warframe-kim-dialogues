		1760 -> 1768;
	1761 [label="A fé não precisa ser constante, nem se espera que seja. Quantas histórias são contadas sobre pessoas que perdem a fé, só pra reencontrar ela de novo?",shape=box,color=red];
		1761 -> 1764;
		1761 -> 1765;
		1761 -> 1766;
	1759 [label="Lyon, você dedicou sua vida aos nossos Luminários. Acha que eles te abandonariam por algo assim?",shape=box,color=red];
