		1077 -> 1079 [label=true,color=green];
		1077 -> 1080 [label=true,color=green];
		1077 -> 1078 [label=false,color=brown];
		1077 -> 1080 [label=false,color=brown];
	1079 [label="Lyon, eu queria saber o resto sobre como o Roathe chegou à Catedral com você e a Marie. Pode me contar mais?",shape=box,color=red];
		1079 -> 1082;
	1080 [label="[Encerrar Conversa]",shape=box,color=red];
		1080 -> 1083;
	1078 [label="Lyon, eu queria saber sobre como o Roathe chegou à Catedral com você e a Marie. Pode me contar mais?",shape=box,color=red];
		1078 -> 1081;
	1082 [label="Como desejar. No entanto, não é uma história muito agradável. Ele foi deixado à nossa porta como um gato selvagem ferido. ",shape=box,color=blue];
		1082 -> 1084;
	1083 [label="Chat ends.",color=orange];
	1081 [label="Como desejar. Ele foi abandonado à nossa porta como um gato selvagem ferido. A história não é nada agradável. ",shape=box,color=blue];
		1081 -> 1084;
	1084 [label="Evaluate expressions",color=orange];
		1084 -> 1087 [label="LyonStray",color=purple];
		1084 -> 1086 [label="RoatheSerum1",color=purple];
		1084 -> 1085 [label="false",color=purple];
	1087 [label="Eu tinha razão, aquela história era pra ser sobre o Roathe",shape=box,color=red];
		1087 -> 1090;
	1086 [label="Pelo que ouvi, ele tinha todos os motivos pra estar um pouco… selvagem quando chegou",shape=box,color=red];
		1086 -> 1089;
	1085 [label="Tudo bem, pode continuar",shape=box,color=red];
		1085 -> 1088;
	1090 [label="Era uma história sobre um gato de rua que costumava visitar a Catedral. O que você extrair do seu significado, ou da minha razão para contá-la, é inteiramente sua responsabilidade. Eu sou um padre, não sou? ",shape=box,color=blue];
		1090 -> 1088;
	1089 [label="Seria de se esperar que alguém do seu nível e caráter se sentisse injustiçado pelas ações do Entrati contra ele. Sinceramente, eu ficaria muito mais surpreso se ele tivesse lidado com a situação com elegância.",shape=box,color=blue];
		1089 -> 1088;
	1088 [label="Evaluate expressions",color=orange];
		1088 -> 1092 [label="LyonSerum1",color=purple];
		1088 -> 1091 [label="false",color=purple];
	1092 [label="Acredito que, no ponto em que parei, o Entrati havia retornado recentemente de seu desaparecimento com o Roathe, que, como o vemos agora, já estava mudado. O Entrati nos revelou todas as mentiras que havia contado por mais de 3 anos.",shape=box,color=blue];
		1092 -> 1094;
	1091 [label="Tentarei resumir os eventos que levaram a esse momento, caso contrário, poderá parecer… sem sentido, no mínimo.",shape=box,color=blue];
		1091 -> 1093;
	1094 [label="Ele nos ofereceu os soros de \"Protoframe\", que nos transformaram no que somos agora, e assim que os aceitamos… ele nos abandonou imediatamente, mais uma vez.",shape=box,color=blue];
		1094 -> 1096;
	1093 [label="Durante 3 anos, 2 meses e 11 dias, ele serviu como Cardeal Dimanche em nossa Catedral. E durante todo esse tempo, a Marie e eu o servimos, sem saber o que ele planejava para nós.",shape=box,color=blue];
		1093 -> 1095;
	1096 [label="E ali permanecemos, como amálgamas recém-órfãos, com corpos e almas recriados em criações que mal conseguíamos compreender, quanto mais reivindicar domínio.",shape=box,color=blue];
		1096 -> 1098;
	1095 [label="Eu já sei quais são as suas perguntas antes mesmo de você as fazer. O que ele estava tramando? Ele infectou a cidade, como ouvi dizer que fez com Holvânia? Quais eram os seus planos? Suas descobertas?",shape=box,color=blue];
		1095 -> 1097;
	1098 [label="Presos numa cidade que era nosso lar, mas que já não nos acolhia de braços abertos. Fomos… obrigados a nos esconder.",shape=box,color=blue];
		1098 -> 1100;
		1098 -> 1101;
	1097 [label="E eu digo: você ficará desapontado. Ele pregou. Ele estudou. Ele descansou. E ele orou. Então, certa noite, ele desapareceu em meio a uma terrível tempestade. A mesma em que ele apareceu.",shape=box,color=blue];
		1097 -> 1099;
	1100 [label="Por causa da sua aparência?",shape=box,color=red];
		1100 -> 1104;
	1101 [label="A Catedral te rejeitou?",shape=box,color=red];
		1101 -> 1105;
	1099 [label="Check boolean MarieLyonVisions",color=orange];
		1099 -> 1103 [label=true,color=green];
		1099 -> 1102 [label=false,color=brown];
	1104 [label="Não sei se você já percebeu, mas a Marie consegue voar, e o Roathe é… azul, entre outras coisas.",shape=box,color=blue];
		1104 -> 1107;
	1105 [label="Não exatamente… fomos forçados a sair da vida pública. Mas nossos irmãos e irmãs não nos exilaram às ruas, nem nos queimaram na fogueira. O \"Cardeal Dimanche\" os convenceu de que nossas mudanças eram… obra dos Luminários.",shape=box,color=blue];
		1105 -> 1108;
	1103 [label="Embora eu saiba que a tempestade não aconteceu com outras pessoas, ela foi bastante vívida para mim. ",shape=box,color=blue];
		1103 -> 1102;
	1102 [label="Exatamente 1 ano depois, ele reapareceu pela última vez, com… o Roathe, como você o vê agora, caído e inconsciente a seus pés.",shape=box,color=blue];
		1102 -> 1106;
	1107 [label="Sei que você passa seus dias lidando com animais falantes e crânios, ponderando sobre a questão do Void, mas isso não é algo comum para a maioria dos humanos.",shape=box,color=blue];
		1107 -> 1110;
	1108 [label="Estávamos escondidos nas criptas e mantidos fora da vista de todos. Nossos antigos irmãos, embora aterrorizados conosco, nos traziam suprimentos. ",shape=box,color=blue];
		1108 -> 1111;
	1106 [label="Um demônio em pessoa, ou assim parecia. Foi então que o Entrati nos revelou a verdade sobre quem ele era quando nos chamou, e a verdadeira tarefa que tinha para nós. Que ele nos havia escolhido para uma missão \"sagrada\".",shape=box,color=blue];
		1106 -> 1109;
	1110 [label="Na verdade, eu sou um dos 3 que talvez conseguisse se misturar à multidão, se me camuflasse bem o suficiente. ",shape=box,color=blue];
		1110 -> 1113;
		1110 -> 1114;
	1111 [label="Eles… insistiam em interagir só com a Marie, apesar de suas aparições repentinas, como um fantasma, na escadaria para cumprimentá-los. ",shape=box,color=blue];
		1111 -> 1115;
		1111 -> 1116;
	1109 [label="A Marie aceitou o soro prontamente. Claro que aceitou, como poderia recusar? E como eu poderia não segui-la? Como eu poderia não buscar a verdade, aonde quer que ela me levasse?",shape=box,color=blue];
		1109 -> 1112;
	1113 [label="Onde você ficou?",shape=box,color=red];
		1113 -> 1120;
	1114 [label="Como vocês vieram parar aqui?",shape=box,color=red];
		1114 -> 1121;
	1115 [label="Eu entendo evitar o Roathe, mas… eles preferiam isso em vez de falar com você?",shape=box,color=red];
		1115 -> 1122;
	1116 [label="Ela é muito doce…",shape=box,color=red];
		1116 -> 1123;
	1112 [label="Update boolean LyonSerum1",color=orange];
		1112 -> 1117;
		1112 -> 1118;
		1112 -> 1119;
	1120 [label="Nossos irmãos e irmãs não nos exilaram às ruas, nem nos queimaram na fogueira. O \"Cardeal Dimanche\" os convenceu de que nossas mudanças eram… obra dos Luminários.",shape=box,color=blue];
		1120 -> 1127;
	1121 [label="O Roathe saberá os detalhes de \"como\" exatamente, mas depois de… muitos anos de trabalho, ele criou um \"Helminte\" a partir de amostras do nosso sangue.",shape=box,color=blue];
		1121 -> 1128;
	1122 [label="Acho que já nos conhecemos, não é?",shape=box,color=blue];
		1122 -> 1129;
	1123 [label="Precisamente.",shape=box,color=blue];
		1123 -> 1130;
	1117 [label="Acho que ela idolatra o Entrati um pouco… demais",shape=box,color=red];
		1117 -> 1124;
	1118 [label="O que aconteceu depois?",shape=box,color=red];
		1118 -> 1125;
	1119 [label="Você se arrepende?",shape=box,color=red];
		1119 -> 1126;
	1127 [label="Estávamos escondidos nas criptas e mantidos fora da vista de todos. Nossos antigos irmãos, embora aterrorizados conosco, nos traziam suprimentos. ",shape=box,color=blue];
		1127 -> 1134;
	1128 [label="Acredito que a Infestação esteja conectada a si mesma através do… tempo… de alguma forma… embora os detalhes me sejam bastante desconhecidos.",shape=box,color=blue];
		1128 -> 1135;
		1128 -> 1136;
	1129 [label="Quanto tempo vocês ficaram presos lá?",shape=box,color=red];
		1129 -> 1137;
	1130 [label="Então… eles mantiveram vocês no porão?",shape=box,color=red];
		1130 -> 1138;
	1124 [label="Update boolean LyonMarieEntrati",color=orange];
		1124 -> 1131;
	1125 [label="O Roathe acordou. A princípio, mal conseguia se lembrar do próprio nome. O Entrati disse uma última frase ao bastardo: \"Uriel, Herege de Xata, exilado, responda: os Orokin poderão ser perdoados?\"",shape=box,color=blue];
		1125 -> 1132;
	1126 [label="Eu me arrependo de tudo, Peregrino. Sim, claro que me arrependo. Mas faria tudo de novo? Sim, claro que faria. Não posso deixar a Marie sozinha.",shape=box,color=blue];
		1126 -> 1133;
	1134 [label="Eles… insistiam em interagir só com a Marie, apesar de suas aparições repentinas, como um fantasma, na escadaria para cumprimentá-los. ",shape=box,color=blue];
		1134 -> 1139;
		1134 -> 1140;
	1135 [label="Ele fez engenharia reversa de um Helminte?! Quanto tempo isso levou?!",shape=box,color=red];
		1135 -> 1141;
	1136 [label="Acho que ninguém entende isso, é uma descoberta recente",shape=box,color=red];
		1136 -> 1142;
	1137 [label="Talvez eu não seja a pessoa mais indicada para responder sobre quantos anos se passaram depois que nos transformamos em amálgamas infestados e falantes. Minha noção da passagem do tempo desde então tem sido… confusa.",shape=box,color=blue];
		1137 -> 1143;
		1137 -> 1144;
	1138 [label="Parece talvez mais cruel do que realmente é. Não havia outro lugar para nos acomodar. O campanário era muito aberto, muito exposto às intempéries. A cripta era protegida e quente. ",shape=box,color=blue];
		1138 -> 1145;
	1131 [label="Nisso, concordamos. Mas também não posso culpá-la por isso. Dê-lhe tempo, ela vai entender. Ela é extremamente inteligente, Peregrino. Não a trate como uma tola.",shape=box,color=blue];
		1131 -> 1133;
	1132 [label="O Entrati partiu então pela última vez. E deixou o Roathe conosco, agora transformado no que você vê agora, mais capaz de lidar com seu temperamento do diabo.",shape=box,color=blue];
		1132 -> 1096;
	1133 [label="Para continuar a história… o Entrati partiu então, pela última vez. E deixou o Roathe conosco, agora transformado no que vocês veem agora, mais capaz de lidar com seu temperamento do diabo.",shape=box,color=blue];
		1133 -> 1096;
	1139 [label="Eu entendo evitar o Roathe, mas… eles preferiam isso em vez de falar com você?",shape=box,color=red];
		1139 -> 1146;
	1140 [label="Ela é muito doce…",shape=box,color=red];
		1140 -> 1147;
	1141 [label="Update boolean LyonRoatheHelminth",color=orange];
		1141 -> 1148;
	1142 [label="Não sei dizer se isso é reconfortante ou desanimador, obrigado. É estranho o suficiente saber agora que a Infestação pode falar.",shape=box,color=blue];
		1142 -> 1149;
		1142 -> 1150;
	1143 [label="\"Confusa\" em que sentido?",shape=box,color=red];
		1143 -> 1151;
	1144 [label="Não sei se devo te contar que a Infestação também pode falar…",shape=box,color=red];
		1144 -> 1152;
	1145 [label="E, infelizmente, descobrimos que havia saídas que o Roathe poderia usar para… vagar sem rumo.",shape=box,color=blue];
		1145 -> 1153;
	1146 [label="Acho que já nos conhecemos, não é?",shape=box,color=blue];
		1146 -> 1129;
		1146 -> 1130;
	1147 [label="Precisamente.",shape=box,color=blue];
		1147 -> 1130;
		1147 -> 1129;
	1148 [label="Talvez eu não seja a pessoa certa para responder. Minha compreensão da passagem do tempo desde então tornou-se… confusa. Embora talvez seja mais preciso dizer \"ainda mais confusa\". Como se isso não pudesse ficar mais assustador…",shape=box,color=blue];
		1148 -> 1143;
		1148 -> 1144;
	1149 [label="Nem todos os objetos da casa. Sem bem que as cadeiras podem ser… é… deixa pra lá, continua",shape=box,color=red];
		1149 -> 1154;
	1150 [label="Vou te poupar e não vou falar da guitarra então",shape=box,color=red];
		1150 -> 1155;
	1151 [label="Update boolean LyonTime1",color=orange];
		1151 -> 1156;
	1152 [label="Acredite, eu sei. E é desconcertante, obrigado. Embora pareça que qualquer objeto doméstico aleatório neste lugar possa falar.",shape=box,color=blue];
		1152 -> 1149;
		1152 -> 1150;
	1153 [label="Evaluate expressions",color=orange];
		1153 -> 1157 [label="MarieRoathePastry1",color=purple];
		1153 -> 1157 [label="RoatheMariePastry1",color=purple];
		1153 -> 1158 [label="false",color=purple];
	1154 [label="Se a palavra que você ia usar era \"possuída\", eu também já vi isso, Peregrino. Aquele que sussurrou. Aquele que estava dentro da parede. Eu ouvi as batidas…",shape=box,color=blue];
		1154 -> 1159;
	1155 [label="Por favor, faça isso. Embora eu ache muito mais reconfortante ter um instrumento musical como uma espécie de semideus passageiro do que… qualquer outra coisa que tenha vindo assombrar e abandonar minha mente. É estranho que eu… desde que ele…",shape=box,color=blue];
		1155 -> 1160;
	1156 [label="Não sei ao certo se é simplesmente devido à minha sensibilidade peculiar ao assunto, ou devido às circunstâncias individuais da minha criação, ou… a ele.",shape=box,color=blue];
		1156 -> 1161;
	1157 [label="Já ouvi essa história",shape=box,color=red];
		1157 -> 1162;
	1158 [label="Hein?",shape=box,color=red];
		1158 -> 1163;
	1159 [label="Há uma voz que me chama, uma voz que sei que não ouvi em toda a minha vida, mas que se estende ao meu passado e muito além do meu futuro…",shape=box,color=blue];
		1159 -> 1164;
	1160 [label="Ele?",shape=box,color=red];
		1160 -> 1159;
	1161 [label="E eu sei que vocês vão me achar um completo lunático quando eu disser isso, mas eu não vivencio o tempo de uma forma… puramente… linear.",shape=box,color=blue];
		1161 -> 1165;
		1161 -> 1166;
	1162 [label="Acho que essa é uma de suas poucas qualidades redentoras. Não o roubo em si, entenda bem. O raciocínio por trás dele. Minha teoria é que ele adquiriu os bens ilícitos para induzir a Marie a conversar com ele.",shape=box,color=blue];
		1162 -> 1167;
	1163 [label="Não é nem uma coisa, nem outra.",shape=box,color=blue];
		1163 -> 1168;
		1163 -> 1169;
	1164 [label="Não é possível que sempre tenha estado ali. No entanto, consigo me lembrar agora, tão claramente quanto a luz prateada da própria Lua, atrás da parede da casa da minha infância. A voz de um jovem. A presença de outro ao seu lado… \"Rap tap tap…\"",shape=box,color=blue];
		1164 -> 1170;
	1165 [label="\"Ele\"? Quem é \"ele\"?",shape=box,color=red];
		1165 -> 1159;
	1166 [label="Vivenciei o tempo por incontáveis séculos na forma de espirais em repetição, Lyon",shape=box,color=red];
		1166 -> 1171;
	1167 [label="E, talvez, porque a faziam sorrir, quando ela pensava que ele não estava olhando. Certa vez, ele me disse: \"é uma grande injustiça do destino que ela tenha sido tão privada da vida.\"",shape=box,color=blue];
		1167 -> 1172;
	1168 [label="Quanto tempo levou pra vocês voltarem a… bem, ao presente?",shape=box,color=red];
		1168 -> 1173;
	1169 [label="O que aconteceu depois?",shape=box,color=red];
		1169 -> 1121;
	1170 [label="Eu… me perdoe. Preciso ir. Não posso falar sobre isso ainda. Eu… eu sinto muito. Não me pergunte mais sobre isso.",shape=box,color=blue];
		1170 -> 1174;
	1171 [label="O que você diz, então, quando falo de uma voz que me chamou a atenção além da minha própria mente racional? Sei que não a ouvi durante toda a minha vida. Não é possível que ela sempre tenha estado lá. ",shape=box,color=blue];
		1171 -> 1175;
	1172 [label="Update boolean LyonRoathePastry",color=orange];
		1172 -> 1176;
		1172 -> 1168;
	1173 [label="Talvez eu não seja a pessoa mais indicada para responder sobre quantos anos se passaram depois que nos transformamos em amálgamas infestados e falantes. Minha noção da passagem do tempo desde então tem sido… confusa.",shape=box,color=blue];
		1173 -> 1144;
		1173 -> 1143;
	1174 [label="Lyon, peraí!",shape=box,color=red];
		1174 -> 1177;
	1175 [label="No entanto, consigo me lembrar agora, tão claramente quanto a luz prateada da própria Lua, atrás da parede da casa da minha infância. A voz de um jovem… \"Rap tap tap…\"",shape=box,color=blue];
		1175 -> 1170;
	1176 [label="Você tem razão, isso tá ficando adorável pra ele. O que aconteceu depois?",shape=box,color=red];
		1176 -> 1121;
	1177 [label="Update boolean LyonRell1",color=orange];
		1177 -> 1178;
	1178 [label="+20 Chemistry",color=orange];
		1178 -> 1179;
	1179 [label="Chat ends.",color=orange];
}