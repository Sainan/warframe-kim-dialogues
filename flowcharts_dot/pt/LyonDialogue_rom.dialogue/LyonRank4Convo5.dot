		j3425926750 -> j17348121 [label=false,color=brown];
	j2670431064 [label="Lyon, eu queria saber o resto sobre como o Roathe chegou à Catedral com você e a Marie. Pode me contar mais?",shape=box,color=red];
		j2670431064 -> j1072568266;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j2949429949 [label="Lyon, eu queria saber sobre como o Roathe chegou à Catedral com você e a Marie. Pode me contar mais?",shape=box,color=red];
		j2949429949 -> j4072589219;
	j1072568266 [label="Como desejar. No entanto, não é uma história muito agradável. Ele foi deixado à nossa porta como um gato selvagem ferido. ",shape=box,color=blue];
		j1072568266 -> j3769319211;
	"Chat ends." [color=orange];
	j4072589219 [label="Como desejar. Ele foi abandonado à nossa porta como um gato selvagem ferido. A história não é nada agradável. ",shape=box,color=blue];
		j4072589219 -> j3769319211;
	j3769319211 [label="Evaluate expressions",color=orange];
		j3769319211 -> j1238959596 [label="LyonStray",color=purple];
		j3769319211 -> j3197348615 [label="RoatheSerum1",color=purple];
		j3769319211 -> j2074488303 [label="false",color=purple];
	j1238959596 [label="Eu tinha razão, aquela história era pra ser sobre o Roathe",shape=box,color=red];
		j1238959596 -> j1144675758;
	j3197348615 [label="Pelo que ouvi, ele tinha todos os motivos pra estar um pouco… selvagem quando chegou",shape=box,color=red];
		j3197348615 -> j4147686775;
	j2074488303 [label="Tudo bem, pode continuar",shape=box,color=red];
		j2074488303 -> j2266356665;
	j1144675758 [label="Era uma história sobre um gato de rua que costumava visitar a Catedral. O que você extrair do seu significado, ou da minha razão para contá-la, é inteiramente sua responsabilidade. Eu sou um padre, não sou? ",shape=box,color=blue];
		j1144675758 -> j2266356665;
	j4147686775 [label="Seria de se esperar que alguém do seu nível e caráter se sentisse injustiçado pelas ações do Entrati contra ele. Sinceramente, eu ficaria muito mais surpreso se ele tivesse lidado com a situação com elegância.",shape=box,color=blue];
		j4147686775 -> j2266356665;
	j2266356665 [label="Evaluate expressions",color=orange];
		j2266356665 -> j1667323847 [label="LyonSerum1",color=purple];
		j2266356665 -> j766862262 [label="false",color=purple];
	j1667323847 [label="Acredito que, no ponto em que parei, o Entrati havia retornado recentemente de seu desaparecimento com o Roathe, que, como o vemos agora, já estava mudado. O Entrati nos revelou todas as mentiras que havia contado por mais de 3 anos.",shape=box,color=blue];
		j1667323847 -> j4219725698;
	j766862262 [label="Tentarei resumir os eventos que levaram a esse momento, caso contrário, poderá parecer… sem sentido, no mínimo.",shape=box,color=blue];
		j766862262 -> j96528471;
	j4219725698 [label="Ele nos ofereceu os soros de \"Protoframe\", que nos transformaram no que somos agora, e assim que os aceitamos… ele nos abandonou imediatamente, mais uma vez.",shape=box,color=blue];
		j4219725698 -> j4043164588;
	j96528471 [label="Durante 3 anos, 2 meses e 11 dias, ele serviu como Cardeal Dimanche em nossa Catedral. E durante todo esse tempo, a Marie e eu o servimos, sem saber o que ele planejava para nós.",shape=box,color=blue];
		j96528471 -> j2410305838;
	j4043164588 [label="E ali permanecemos, como amálgamas recém-órfãos, com corpos e almas recriados em criações que mal conseguíamos compreender, quanto mais reivindicar domínio.",shape=box,color=blue];
		j4043164588 -> j2791200304;
	j2410305838 [label="Eu já sei quais são as suas perguntas antes mesmo de você as fazer. O que ele estava tramando? Ele infectou a cidade, como ouvi dizer que fez com Holvânia? Quais eram os seus planos? Suas descobertas?",shape=box,color=blue];
		j2410305838 -> j2473856180;
	j2791200304 [label="Presos numa cidade que era nosso lar, mas que já não nos acolhia de braços abertos. Fomos… obrigados a nos esconder.",shape=box,color=blue];
		j2791200304 -> j1321084324;
		j2791200304 -> j2570673089;
	j2473856180 [label="E eu digo: você ficará desapontado. Ele pregou. Ele estudou. Ele descansou. E ele orou. Então, certa noite, ele desapareceu em meio a uma terrível tempestade. A mesma em que ele apareceu.",shape=box,color=blue];
		j2473856180 -> j2575044127;
	j1321084324 [label="Por causa da sua aparência?",shape=box,color=red];
		j1321084324 -> j4050409835;
	j2570673089 [label="A Catedral te rejeitou?",shape=box,color=red];
		j2570673089 -> j1315246319;
	j2575044127 [label="Check boolean MarieLyonVisions",color=orange];
		j2575044127 -> j4244813405 [label=true,color=green];
		j2575044127 -> j3072991282 [label=false,color=brown];
	j4050409835 [label="Não sei se você já percebeu, mas a Marie consegue voar, e o Roathe é… azul, entre outras coisas.",shape=box,color=blue];
		j4050409835 -> j752871226;
	j1315246319 [label="Não exatamente… fomos forçados a sair da vida pública. Mas nossos irmãos e irmãs não nos exilaram às ruas, nem nos queimaram na fogueira. O \"Cardeal Dimanche\" os convenceu de que nossas mudanças eram… obra dos Luminários.",shape=box,color=blue];
		j1315246319 -> j876424852;
	j4244813405 [label="Embora eu saiba que a tempestade não aconteceu com outras pessoas, ela foi bastante vívida para mim. ",shape=box,color=blue];
		j4244813405 -> j3072991282;
	j3072991282 [label="Exatamente 1 ano depois, ele reapareceu pela última vez, com… o Roathe, como você o vê agora, caído e inconsciente a seus pés.",shape=box,color=blue];
		j3072991282 -> j2311813082;
	j752871226 [label="Sei que você passa seus dias lidando com animais falantes e crânios, ponderando sobre a questão do Void, mas isso não é algo comum para a maioria dos humanos.",shape=box,color=blue];
		j752871226 -> j2155408350;
	j876424852 [label="Estávamos escondidos nas criptas e mantidos fora da vista de todos. Nossos antigos irmãos, embora aterrorizados conosco, nos traziam suprimentos. ",shape=box,color=blue];
		j876424852 -> j2563835269;
	j2311813082 [label="Um demônio em pessoa, ou assim parecia. Foi então que o Entrati nos revelou a verdade sobre quem ele era quando nos chamou, e a verdadeira tarefa que tinha para nós. Que ele nos havia escolhido para uma missão \"sagrada\".",shape=box,color=blue];
		j2311813082 -> j3537947590;
	j2155408350 [label="Na verdade, eu sou um dos 3 que talvez conseguisse se misturar à multidão, se me camuflasse bem o suficiente. ",shape=box,color=blue];
		j2155408350 -> j522691942;
		j2155408350 -> j2469150690;
	j2563835269 [label="Eles… insistiam em interagir só com a Marie, apesar de suas aparições repentinas, como um fantasma, na escadaria para cumprimentá-los. ",shape=box,color=blue];
		j2563835269 -> j942914278;
		j2563835269 -> j1587594441;
	j3537947590 [label="A Marie aceitou o soro prontamente. Claro que aceitou, como poderia recusar? E como eu poderia não segui-la? Como eu poderia não buscar a verdade, aonde quer que ela me levasse?",shape=box,color=blue];
		j3537947590 -> j249472217;
	j522691942 [label="Onde você ficou?",shape=box,color=red];
		j522691942 -> j2425965172;
	j2469150690 [label="Como vocês vieram parar aqui?",shape=box,color=red];
		j2469150690 -> j1380086609;
	j942914278 [label="Eu entendo evitar o Roathe, mas… eles preferiam isso em vez de falar com você?",shape=box,color=red];
		j942914278 -> j1088371005;
	j1587594441 [label="Ela é muito doce…",shape=box,color=red];
		j1587594441 -> j4217583703;
	j249472217 [label="Boolean LyonSerum1 is now true.",color=orange];
		j249472217 -> j2429606491;
		j249472217 -> j2048042658;
		j249472217 -> j3389417571;
	j2425965172 [label="Nossos irmãos e irmãs não nos exilaram às ruas, nem nos queimaram na fogueira. O \"Cardeal Dimanche\" os convenceu de que nossas mudanças eram… obra dos Luminários.",shape=box,color=blue];
		j2425965172 -> j1423045197;
	j1380086609 [label="O Roathe saberá os detalhes de \"como\" exatamente, mas depois de… muitos anos de trabalho, ele criou um \"Helminte\" a partir de amostras do nosso sangue.",shape=box,color=blue];
		j1380086609 -> j3830325445;
	j1088371005 [label="Acho que já nos conhecemos, não é?",shape=box,color=blue];
		j1088371005 -> j2067489654;
	j4217583703 [label="Precisamente.",shape=box,color=blue];
		j4217583703 -> j4076275527;
	j2429606491 [label="Acho que ela idolatra o Entrati um pouco… demais",shape=box,color=red];
		j2429606491 -> j3008629504;
	j2048042658 [label="O que aconteceu depois?",shape=box,color=red];
		j2048042658 -> j2257501354;
	j3389417571 [label="Você se arrepende?",shape=box,color=red];
		j3389417571 -> j1764100401;
	j1423045197 [label="Estávamos escondidos nas criptas e mantidos fora da vista de todos. Nossos antigos irmãos, embora aterrorizados conosco, nos traziam suprimentos. ",shape=box,color=blue];
		j1423045197 -> j3261927143;
	j3830325445 [label="Acredito que a Infestação esteja conectada a si mesma através do… tempo… de alguma forma… embora os detalhes me sejam bastante desconhecidos.",shape=box,color=blue];
		j3830325445 -> j1632640772;
		j3830325445 -> j1355517856;
	j2067489654 [label="Quanto tempo vocês ficaram presos lá?",shape=box,color=red];
		j2067489654 -> j781590831;
	j4076275527 [label="Então… eles mantiveram vocês no porão?",shape=box,color=red];
		j4076275527 -> j3045883148;
	j3008629504 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j3008629504 -> j3668470500;
	j2257501354 [label="O Roathe acordou. A princípio, mal conseguia se lembrar do próprio nome. O Entrati disse uma última frase ao bastardo: \"Uriel, Herege de Xata, exilado, responda: os Orokin poderão ser perdoados?\"",shape=box,color=blue];
		j2257501354 -> j3961700168;
	j1764100401 [label="Eu me arrependo de tudo, Peregrino. Sim, claro que me arrependo. Mas faria tudo de novo? Sim, claro que faria. Não posso deixar a Marie sozinha.",shape=box,color=blue];
		j1764100401 -> j254887098;
	j3261927143 [label="Eles… insistiam em interagir só com a Marie, apesar de suas aparições repentinas, como um fantasma, na escadaria para cumprimentá-los. ",shape=box,color=blue];
		j3261927143 -> j312512585;
		j3261927143 -> j526381817;
	j1632640772 [label="Ele fez engenharia reversa de um Helminte?! Quanto tempo isso levou?!",shape=box,color=red];
		j1632640772 -> j2605384512;
	j1355517856 [label="Acho que ninguém entende isso, é uma descoberta recente",shape=box,color=red];
		j1355517856 -> j2884020063;
	j781590831 [label="Talvez eu não seja a pessoa mais indicada para responder sobre quantos anos se passaram depois que nos transformamos em amálgamas infestados e falantes. Minha noção da passagem do tempo desde então tem sido… confusa.",shape=box,color=blue];
		j781590831 -> j4024534669;
		j781590831 -> j2353895643;
	j3045883148 [label="Parece talvez mais cruel do que realmente é. Não havia outro lugar para nos acomodar. O campanário era muito aberto, muito exposto às intempéries. A cripta era protegida e quente. ",shape=box,color=blue];
		j3045883148 -> j889685872;
	j3668470500 [label="Nisso, concordamos. Mas também não posso culpá-la por isso. Dê-lhe tempo, ela vai entender. Ela é extremamente inteligente, Peregrino. Não a trate como uma tola.",shape=box,color=blue];
		j3668470500 -> j254887098;
	j3961700168 [label="O Entrati partiu então pela última vez. E deixou o Roathe conosco, agora transformado no que você vê agora, mais capaz de lidar com seu temperamento do diabo.",shape=box,color=blue];
		j3961700168 -> j4043164588;
	j254887098 [label="Para continuar a história… o Entrati partiu então, pela última vez. E deixou o Roathe conosco, agora transformado no que vocês veem agora, mais capaz de lidar com seu temperamento do diabo.",shape=box,color=blue];
		j254887098 -> j4043164588;
	j312512585 [label="Eu entendo evitar o Roathe, mas… eles preferiam isso em vez de falar com você?",shape=box,color=red];
		j312512585 -> j1079865431;
	j526381817 [label="Ela é muito doce…",shape=box,color=red];
		j526381817 -> j1035594408;
	j2605384512 [label="Boolean LyonRoatheHelminth is now true.",color=orange];
		j2605384512 -> j3779402729;
	j2884020063 [label="Não sei dizer se isso é reconfortante ou desanimador, obrigado. É estranho o suficiente saber agora que a Infestação pode falar.",shape=box,color=blue];
		j2884020063 -> j3408754037;
		j2884020063 -> j3274011479;
	j4024534669 [label="\"Confusa\" em que sentido?",shape=box,color=red];
		j4024534669 -> j998155149;
	j2353895643 [label="Não sei se devo te contar que a Infestação também pode falar…",shape=box,color=red];
		j2353895643 -> j1107088051;
	j889685872 [label="E, infelizmente, descobrimos que havia saídas que o Roathe poderia usar para… vagar sem rumo.",shape=box,color=blue];
		j889685872 -> j845860967;
	j1079865431 [label="Acho que já nos conhecemos, não é?",shape=box,color=blue];
		j1079865431 -> j2067489654;
		j1079865431 -> j4076275527;
	j1035594408 [label="Precisamente.",shape=box,color=blue];
		j1035594408 -> j4076275527;
		j1035594408 -> j2067489654;
	j3779402729 [label="Talvez eu não seja a pessoa certa para responder. Minha compreensão da passagem do tempo desde então tornou-se… confusa. Embora talvez seja mais preciso dizer \"ainda mais confusa\". Como se isso não pudesse ficar mais assustador…",shape=box,color=blue];
		j3779402729 -> j4024534669;
		j3779402729 -> j2353895643;
	j3408754037 [label="Nem todos os objetos da casa. Sem bem que as cadeiras podem ser… é… deixa pra lá, continua",shape=box,color=red];
		j3408754037 -> j1558355630;
	j3274011479 [label="Vou te poupar e não vou falar da guitarra então",shape=box,color=red];
		j3274011479 -> j3989493206;
	j998155149 [label="Boolean LyonTime1 is now true.",color=orange];
		j998155149 -> j2389221929;
	j1107088051 [label="Acredite, eu sei. E é desconcertante, obrigado. Embora pareça que qualquer objeto doméstico aleatório neste lugar possa falar.",shape=box,color=blue];
		j1107088051 -> j3408754037;
		j1107088051 -> j3274011479;
	j845860967 [label="Evaluate expressions",color=orange];
		j845860967 -> j1708912584 [label="MarieRoathePastry1",color=purple];
		j845860967 -> j1708912584 [label="RoatheMariePastry1",color=purple];
		j845860967 -> j3896023953 [label="false",color=purple];
	j1558355630 [label="Se a palavra que você ia usar era \"possuída\", eu também já vi isso, Peregrino. Aquele que sussurrou. Aquele que estava dentro da parede. Eu ouvi as batidas…",shape=box,color=blue];
		j1558355630 -> j2808522485;
	j3989493206 [label="Por favor, faça isso. Embora eu ache muito mais reconfortante ter um instrumento musical como uma espécie de semideus passageiro do que… qualquer outra coisa que tenha vindo assombrar e abandonar minha mente. É estranho que eu… desde que ele…",shape=box,color=blue];
		j3989493206 -> j171396182;
	j2389221929 [label="Não sei ao certo se é simplesmente devido à minha sensibilidade peculiar ao assunto, ou devido às circunstâncias individuais da minha criação, ou… a ele.",shape=box,color=blue];
		j2389221929 -> j2579855246;
	j1708912584 [label="Já ouvi essa história",shape=box,color=red];
		j1708912584 -> j1134087606;
	j3896023953 [label="Hein?",shape=box,color=red];
		j3896023953 -> j2904701979;
	j2808522485 [label="Há uma voz que me chama, uma voz que sei que não ouvi em toda a minha vida, mas que se estende ao meu passado e muito além do meu futuro…",shape=box,color=blue];
		j2808522485 -> j1007501005;
	j171396182 [label="Ele?",shape=box,color=red];
		j171396182 -> j2808522485;
	j2579855246 [label="E eu sei que vocês vão me achar um completo lunático quando eu disser isso, mas eu não vivencio o tempo de uma forma… puramente… linear.",shape=box,color=blue];
		j2579855246 -> j1516741119;
		j2579855246 -> j3749018821;
	j1134087606 [label="Acho que essa é uma de suas poucas qualidades redentoras. Não o roubo em si, entenda bem. O raciocínio por trás dele. Minha teoria é que ele adquiriu os bens ilícitos para induzir a Marie a conversar com ele.",shape=box,color=blue];
		j1134087606 -> j2358174171;
	j2904701979 [label="Não é nem uma coisa, nem outra.",shape=box,color=blue];
		j2904701979 -> j1774974145;
		j2904701979 -> j2390499145;
	j1007501005 [label="Não é possível que sempre tenha estado ali. No entanto, consigo me lembrar agora, tão claramente quanto a luz prateada da própria Lua, atrás da parede da casa da minha infância. A voz de um jovem. A presença de outro ao seu lado… \"Rap tap tap…\"",shape=box,color=blue];
		j1007501005 -> j104375095;
	j1516741119 [label="\"Ele\"? Quem é \"ele\"?",shape=box,color=red];
		j1516741119 -> j2808522485;
	j3749018821 [label="Vivenciei o tempo por incontáveis séculos na forma de espirais em repetição, Lyon",shape=box,color=red];
		j3749018821 -> j1254170363;
	j2358174171 [label="E, talvez, porque a faziam sorrir, quando ela pensava que ele não estava olhando. Certa vez, ele me disse: \"é uma grande injustiça do destino que ela tenha sido tão privada da vida.\"",shape=box,color=blue];
		j2358174171 -> j3733610902;
	j1774974145 [label="Quanto tempo levou pra vocês voltarem a… bem, ao presente?",shape=box,color=red];
		j1774974145 -> j2390205397;
	j2390499145 [label="O que aconteceu depois?",shape=box,color=red];
		j2390499145 -> j1380086609;
	j104375095 [label="Eu… me perdoe. Preciso ir. Não posso falar sobre isso ainda. Eu… eu sinto muito. Não me pergunte mais sobre isso.",shape=box,color=blue];
		j104375095 -> j3177613646;
	j1254170363 [label="O que você diz, então, quando falo de uma voz que me chamou a atenção além da minha própria mente racional? Sei que não a ouvi durante toda a minha vida. Não é possível que ela sempre tenha estado lá. ",shape=box,color=blue];
		j1254170363 -> j451654789;
	j3733610902 [label="Boolean LyonRoathePastry is now true.",color=orange];
		j3733610902 -> j1888614192;
		j3733610902 -> j1774974145;
	j2390205397 [label="Talvez eu não seja a pessoa mais indicada para responder sobre quantos anos se passaram depois que nos transformamos em amálgamas infestados e falantes. Minha noção da passagem do tempo desde então tem sido… confusa.",shape=box,color=blue];
		j2390205397 -> j2353895643;
		j2390205397 -> j4024534669;
	j3177613646 [label="Lyon, peraí!",shape=box,color=red];
		j3177613646 -> j777162605;
	j451654789 [label="No entanto, consigo me lembrar agora, tão claramente quanto a luz prateada da própria Lua, atrás da parede da casa da minha infância. A voz de um jovem… \"Rap tap tap…\"",shape=box,color=blue];
		j451654789 -> j104375095;
	j1888614192 [label="Você tem razão, isso tá ficando adorável pra ele. O que aconteceu depois?",shape=box,color=red];
		j1888614192 -> j1380086609;
	j777162605 [label="Boolean LyonRell1 is now true.",color=orange];
		j777162605 -> j367054140;
