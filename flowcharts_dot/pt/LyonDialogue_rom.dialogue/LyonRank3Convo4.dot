	j2700254245 [label="É mesmo? Tem tanta certeza disso?",shape=box,color=blue];
		j2700254245 -> j1213423750;
		j2700254245 -> j2890984626;
		j2700254245 -> j2501853405;
	j3713363054 [label="Ah, sim. Um bom esclarecimento. Suponho que eu esteja usando uma metáfora. Eles são claramente feitos de pó e cinzas, literalmente.",shape=box,color=blue];
		j3713363054 -> j571962141;
