	j2159782493 [label="Peço desculpas pela franqueza da pergunta, mas não sei como formulá-la de outra maneira. O que são esses Murmúrios?",shape=box,color=blue];
		j2159782493 -> j2399506411;
		j2159782493 -> j2648852786;
		j2159782493 -> j3019879596;
	j2399506411 [label="Tudo o que eu falar vai ser só uma tentativa de adivinhar a \"mente\" da \"Indiferença\"",shape=box,color=red];
