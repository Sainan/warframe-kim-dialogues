	j3030106156 [label="Às vezes, me pergunto se a Indiferença nunca teve realmente um corpo próprio antes de interagirmos com ela. Então… ela tá aprendendo a existir",shape=box,color=red];
		j3030106156 -> j769688801;
	j217277407 [label="Não, não quis insinuar isso, foi mal. Eu realmente acredito que a Indiferença seja uma divindade real, com uma consciência real por trás dela",shape=box,color=red];
