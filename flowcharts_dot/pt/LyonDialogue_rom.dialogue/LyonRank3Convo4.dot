		j735341186 -> j3677044276;
	j3677044276 [label="Intrigante. Eu havia presumido que você acreditava que sua Indiferença fosse uma divindade, de forma semelhante à Lua ou ao Sol. Estava enganado?",shape=box,color=blue];
		j3677044276 -> j3525749338;
		j3677044276 -> j1603779985;
	j1213423750 [label="Não, mas acho que me dá uma certa paz pensar que, no fim das contas, consigo imaginar o que a Indiferença tá fazendo",shape=box,color=red];
		j1213423750 -> j524989653;
	j2890984626 [label="Não, acho que não. Mas já tive interações suficientes com isso pra me sentir justificado em tentar entender",shape=box,color=red];
		j2890984626 -> j1576771127;
	j2501853405 [label="O que mais poderiam ser? A Indiferença parece estar analisando cada parte do corpo humano e tentando descobrir sua função, uma de cada vez",shape=box,color=red];
		j2501853405 -> j3729114062;
	j571962141 [label="É nisso que eles se transformam depois de mortos. Todos nós já comprovamos isso inúmeras vezes.",shape=box,color=blue];
		j571962141 -> j2382139627;
		j571962141 -> j1833476872;
		j571962141 -> j3383709185;
	j3491304319 [label="Hum. Sim. A Marie me contou isso. Você não acredita na atuação de forças invisíveis em nosso mundo, incluindo a da Indiferença. É mesmo?",shape=box,color=blue];
		j3491304319 -> j1713261617;
		j3491304319 -> j3098356421;
	j2872545542 [label="Interessante. Esta é a segunda vez que tenho a impressão de que você não parece acreditar na realidade da sua Indiferença. É isso mesmo?",shape=box,color=blue];
		j2872545542 -> j3030106156;
		j2872545542 -> j217277407;
	j1215940597 [label="Interessante. Será que entendi que sua fé tem sido abalada ultimamente? Ou será que você nunca teve fé alguma, dada a sua Indiferença?",shape=box,color=blue];
		j1215940597 -> j3030106156;
		j1215940597 -> j217277407;
	j3525749338 [label="Não tenho certeza se a Indiferença era real até que a tornamos real. Acho que a conjuramos da mesma forma que eu conjurei Duviri",shape=box,color=red];
		j3525749338 -> j769688801;
	j1603779985 [label="Acredito que a Indiferença seja uma divindade real, com uma consciência real por trás dela",shape=box,color=red];
		j1603779985 -> j2638915088;
	j524989653 [label="Às vezes, me pergunto se não é essa a razão pela qual tantas pessoas se voltam para a fé no final das contas…",shape=box,color=blue];
		j524989653 -> j1228382413;
	j1576771127 [label="Com licença, mas começo a me preocupar quando alguém se sente \"justificado\" em qualquer ação, especialmente quando se trata de prever as motivações dos outros.",shape=box,color=blue];
		j1576771127 -> j337215472;
		j1576771127 -> j1488076455;
	j3729114062 [label="Devemos nos preocupar com o que pode acontecer quando a análise passar para as partes menos óbvias?",shape=box,color=blue];
		j3729114062 -> j3201945023;
	j2382139627 [label="Acho que a Indiferença tá tentando aprender a ser \"humana\". Ela sempre foi algo maior e diferente. Então, tá aprendendo a existir como algo menor, como nós",shape=box,color=red];
		j2382139627 -> j2741587556;
	j1833476872 [label="Às vezes, me pergunto se a Indiferença nunca teve realmente um corpo próprio antes de interagirmos com ela. Então… ela tá aprendendo a existir",shape=box,color=red];
		j1833476872 -> j4228378353;
	j3383709185 [label="Acho que a Indiferença parece estar analisando cada parte do corpo humano e tentando descobrir sua função, uma de cada vez",shape=box,color=red];
		j3383709185 -> j3729114062;
	j1713261617 [label="Não tenho certeza se a Indiferença era real até que a tornamos real. Acho que a conjuramos da mesma forma que eu conjurei Duviri",shape=box,color=red];
		j1713261617 -> j2967292690;
