		j1363424881 -> j2262751159;
	j2612574822 [label="O que eu não daria pelo silêncio do Void. Pela quietude que ele prenuncia. Qualquer coisa… qualquer coisa, menos as vozes enlouquecedoras que se perseguem…",shape=box,color=blue];
