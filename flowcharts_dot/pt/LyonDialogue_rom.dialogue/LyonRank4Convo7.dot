	j456424479 [label="Peregrino? Posso lhe pedir desculpas por algo?",shape=box,color=blue];
		j456424479 -> j252565258;
		j456424479 -> j611260398;
		j456424479 -> j17348121;
	j252565258 [label="Sim? Mas… pelo quê?",shape=box,color=red];
		j252565258 -> j3487062144;
	j611260398 [label="Não precisa, Lyon, você não fez nada de errado",shape=box,color=red];
		j611260398 -> j3178767902;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j3487062144 [label="+5 Chemistry",color=orange];
		j3487062144 -> j3533088925;
	j3178767902 [label="Embora eu aprecie isso, sinto que você merece uma resposta. Farei o possível para ser breve e não me sobrecarregar com erudição desnecessária. ",shape=box,color=blue];
		j3178767902 -> j1325005857;
	"Chat ends." [color=orange];
	j3533088925 [label="Obrigado. Farei o possível para ser breve e não me sobrecarregar com erudição desnecessária. ",shape=box,color=blue];
		j3533088925 -> j1325005857;
	j1325005857 [label="Conversas são difíceis para mim. Muito mais em encontros íntimos do que nesses tipos de conversas impessoais e mecânicas, ou por correspondência.",shape=box,color=blue];
		j1325005857 -> j1200686609;
	j1200686609 [label="Não sei como descrever… é como se eu estivesse tentando agarrar algo, só para ver partículas de poeira escorregarem por entre meus dedos. ",shape=box,color=blue];
		j1200686609 -> j926004924;
	j926004924 [label="Muitas vezes, me sinto como um pedaço de tela em branco, espalhando tinta sobre sua superfície… tentando, inutilmente, criar a sombra de uma imagem que vejo em minha mente.",shape=box,color=blue];
		j926004924 -> j938313772;
	j938313772 [label="Quanto mais trabalho, mais desesperador isso se torna.",shape=box,color=blue];
		j938313772 -> j2332606901;
	j2332606901 [label="Quanto mais tento, mais me escapa. Então, simplesmente aprendi… a não tentar, de jeito nenhum.",shape=box,color=blue];
		j2332606901 -> j2312443558;
	j2312443558 [label="Por isso te evitei no começo. E por isso ainda sou… propenso a momentos de solidão. As palavras me faltam.",shape=box,color=blue];
		j2312443558 -> j776354359;
		j2312443558 -> j47454317;
		j2312443558 -> j1774554151;
	j776354359 [label="Sempre ficarei feliz em ter você ao meu lado, até mesmo em silêncio",shape=box,color=red];
		j776354359 -> j4183473401;
	j47454317 [label="Às vezes, eu também sou assim… e tá tudo bem",shape=box,color=red];
		j47454317 -> j2211309496;
	j1774554151 [label="Desculpas aceitas",shape=box,color=red];
		j1774554151 -> j545654285;
	j4183473401 [label="+15 Chemistry",color=orange];
		j4183473401 -> j4176466781;
	j2211309496 [label="+15 Chemistry",color=orange];
		j2211309496 -> j1123073967;
	j545654285 [label="+10 Chemistry",color=orange];
		j545654285 -> j2339089195;
	j4176466781 [label="Eu… vou me lembrar disso. Obrigado, Peregrino.",shape=box,color=blue];
		j4176466781 -> j3855476688;
	j1123073967 [label="Eu não tinha me dado conta. Vou me lembrar de não presumir que estou tão sozinho neste mundo… Obrigado, Peregrino.",shape=box,color=blue];
		j1123073967 -> j3855476688;
	j2339089195 [label="Claro. Obrigado, Peregrino.",shape=box,color=blue];
