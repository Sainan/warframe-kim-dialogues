digraph {
	1285 [label="LyonRank4Convo7 begins.",color=orange];
		1285 -> 1286;
	1286 [label="Peregrino? Posso lhe pedir desculpas por algo?",shape=box,color=blue];
		1286 -> 1287;
		1286 -> 1288;
		1286 -> 1289;
	1287 [label="Sim? Mas… pelo quê?",shape=box,color=red];
		1287 -> 1290;
	1288 [label="Não precisa, Lyon, você não fez nada de errado",shape=box,color=red];
		1288 -> 1291;
	1289 [label="[Encerrar Conversa]",shape=box,color=red];
		1289 -> 1292;
	1290 [label="+5 Chemistry",color=orange];
		1290 -> 1293;
	1291 [label="Embora eu aprecie isso, sinto que você merece uma resposta. Farei o possível para ser breve e não me sobrecarregar com erudição desnecessária. ",shape=box,color=blue];
		1291 -> 1294;
	1292 [label="Chat ends.",color=orange];
	1293 [label="Obrigado. Farei o possível para ser breve e não me sobrecarregar com erudição desnecessária. ",shape=box,color=blue];
		1293 -> 1294;
	1294 [label="Conversas são difíceis para mim. Muito mais em encontros íntimos do que nesses tipos de conversas impessoais e mecânicas, ou por correspondência.",shape=box,color=blue];
		1294 -> 1295;
	1295 [label="Não sei como descrever… é como se eu estivesse tentando agarrar algo, só para ver partículas de poeira escorregarem por entre meus dedos. ",shape=box,color=blue];
		1295 -> 1296;
	1296 [label="Muitas vezes, me sinto como um pedaço de tela em branco, espalhando tinta sobre sua superfície… tentando, inutilmente, criar a sombra de uma imagem que vejo em minha mente.",shape=box,color=blue];
		1296 -> 1297;
	1297 [label="Quanto mais trabalho, mais desesperador isso se torna.",shape=box,color=blue];
		1297 -> 1298;
	1298 [label="Quanto mais tento, mais me escapa. Então, simplesmente aprendi… a não tentar, de jeito nenhum.",shape=box,color=blue];
		1298 -> 1299;
	1299 [label="Por isso te evitei no começo. E por isso ainda sou… propenso a momentos de solidão. As palavras me faltam.",shape=box,color=blue];
		1299 -> 1300;
		1299 -> 1301;
		1299 -> 1302;
	1300 [label="Sempre ficarei feliz em ter você ao meu lado, até mesmo em silêncio",shape=box,color=red];
		1300 -> 1303;
	1301 [label="Às vezes, eu também sou assim… e tá tudo bem",shape=box,color=red];
		1301 -> 1304;
	1302 [label="Desculpas aceitas",shape=box,color=red];
		1302 -> 1305;
	1303 [label="+15 Chemistry",color=orange];
		1303 -> 1306;
	1304 [label="+15 Chemistry",color=orange];
		1304 -> 1307;
	1305 [label="+10 Chemistry",color=orange];
		1305 -> 1308;
	1306 [label="Eu… vou me lembrar disso. Obrigado, Peregrino.",shape=box,color=blue];
		1306 -> 1309;
	1307 [label="Eu não tinha me dado conta. Vou me lembrar de não presumir que estou tão sozinho neste mundo… Obrigado, Peregrino.",shape=box,color=blue];
		1307 -> 1309;
	1308 [label="Claro. Obrigado, Peregrino.",shape=box,color=blue];
		1308 -> 1309;
	1309 [label="- Padre Lyon Allard",shape=box,color=blue];
