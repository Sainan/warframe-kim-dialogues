		j2793227429 -> "Chat ends." [label="false",color=purple];
	j2220031327 [label="[Conversa ocultada devido à escolha anterior de evitar tópicos sensíveis]",shape=box,color=blue];
		j2220031327 -> j1028404978;
	j1888996550 [label="Não creio que consiga descrever adequadamente o quão estranho foi o momento de injetar o soro, meu milagre.",shape=box,color=blue];
		j1888996550 -> j1180220670;
		j1888996550 -> j920242701;
		j1888996550 -> j1923139804;
