	j3456381362 [label="Não creio que consiga descrever adequadamente o quão estranho foi o momento de injetar o soro, meu amigo.",shape=box,color=blue];
		j3456381362 -> j1180220670;
		j3456381362 -> j920242701;
		j3456381362 -> j1923139804;
		j3456381362 -> j2062548298;
	"Chat ends." [color=orange];
	j1028404978 [label="Boolean LyonRell3 is now true.",color=orange];
		j1028404978 -> j4075781927;
	j1180220670 [label="Ouvi dizer que é… incrivelmente doloroso",shape=box,color=red];
		j1180220670 -> j2545138580;
	j920242701 [label="Nem consigo imaginar",shape=box,color=red];
		j920242701 -> j3257017838;
	j1923139804 [label="[Aviso: conversa envolvendo menções de violência contra crianças e automutilação. Clique aqui para encerrar o diálogo. Isso não causará perda de Intimidade com o Lyon]",shape=box,color=red];
		j1923139804 -> j1843578849;
	j2062548298 [label="[Encerrar Conversa]",shape=box,color=red];
		j2062548298 -> j3856020424;
	j4075781927 [label="Boolean LyonWillDate is now true.",color=orange];
		j4075781927 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j2545138580 [label="Suponho que sim. Embora eu acredite que tenho anos de prática nesse sentido e, portanto, os avisos do Entrati tenham feito tudo parecer mais impressionante do que realmente foi.",shape=box,color=blue];
		j2545138580 -> j3257017838;
	j3257017838 [label="A Marie e eu decidimos tomar os soros em particular. Pedi a ela que me deixasse ir primeiro, experimentar a mudança e depois guiá-la durante a dela… mas ela, é claro, recusou terminantemente.",shape=box,color=blue];
		j3257017838 -> j3672956903;
	j1843578849 [label="+20 Chemistry",color=orange];
		j1843578849 -> j2698387260;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	"Chat ends. Next chat will be Lyon5FaithDay2." [color=orange];
	j3672956903 [label="Desdenhando da mera ideia de que eu iria a algum lugar ou faria alguma coisa sem ela firmemente ao meu lado, ela dirigiu-se aos seus aposentos.",shape=box,color=blue];
		j3672956903 -> j387250758;
	j2698387260 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j2698387260 -> j2559080857;
	j387250758 [label="Tranquei a porta, tirei a roupa e sentei no meio do chão, o mais longe possível de qualquer objeto, antes de cravar a agulha na minha lateral.",shape=box,color=blue];
		j387250758 -> j377164975;
	j2559080857 [label="Boolean LyonRell3 is now true.",color=orange];
		j2559080857 -> j4008758555;
	j377164975 [label="Eu vi o que a Infestação fez com o Roathe, retorcendo sua carne com o que quer que ele estivesse vestindo na época… eu não tinha nenhum desejo de ser vítima do mesmo destino.",shape=box,color=blue];
		j377164975 -> j370788399;
	j4008758555 [label="Boolean LyonFaith3Unknown is now true.",color=orange];
		j4008758555 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j370788399 [label="Quando a agonia passou, minha visão, já debilitada, estava… turva. Dominada por… uma visão dupla, de alguma forma? Como se eu pudesse ver não uma, mas duas vezes.",shape=box,color=blue];
		j370788399 -> j2242101653;
	j2242101653 [label="Estou bastante orgulhoso da minha resiliência, no entanto, por ter conseguido vestir as calças antes de vomitar e perder a consciência.",shape=box,color=blue];
		j2242101653 -> j806203979;
	j806203979 [label="Quando acordei, não estava sozinho. Nem estava, porém, no chão dos meus aposentos. Estava sentado no meu quarto de infância, sobre o velho chão rangente que eu conhecia tão bem. ",shape=box,color=blue];
		j806203979 -> j143112449;
	j143112449 [label="E sentado ao meu lado, estava um jovem. Ao lado dele, estava uma figura que agora reconheço como Harrow. O jovem segurava uma pequena estatueta de madeira nas mãos. Era articulada nos membros, a tinta há muito desgastada, exceto talvez nas dobras e rachaduras. Pertenceu ao meu pai. Era de um soldado.",shape=box,color=blue];
		j143112449 -> j3672740607;
	j3672740607 [label="Era o único brinquedo que eu podia considerar meu, quando criança. ",shape=box,color=blue];
		j3672740607 -> j3460726969;
		j3672740607 -> j2255163872;
	j3460726969 [label="Eu tinha um boneco parecido quando criança, era um dos meus brinquedos favoritos",shape=box,color=red];
		j3460726969 -> j3093744324;
	j2255163872 [label="Rell?",shape=box,color=red];
		j2255163872 -> j1061177042;
	j3093744324 [label="Foi o que ouvi dizer. Acredito que, no final, o meu caso se revelou ser mais \"benigno\".",shape=box,color=blue];
		j3093744324 -> j1761850147;
		j3093744324 -> j489048904;
		j3093744324 -> j3554353034;
	j1061177042 [label="De fato.",shape=box,color=blue];
		j1061177042 -> j319429816;
	j1761850147 [label="O Thrax é um… assunto complexo, prefiro não entrar em detalhes agora",shape=box,color=red];
		j1761850147 -> j389976168;
	j489048904 [label="Na verdade, não foi culpa dele… ele era exatamente quem eu precisava que ele fosse naquele momento",shape=box,color=red];
		j489048904 -> j810731698;
	j3554353034 [label="Tá tudo bem, ele tá progredindo… lentamente. O que parece impossível, pode mudar",shape=box,color=red];
		j3554353034 -> j1227049761;
	j319429816 [label="O jovem e seu guardião silencioso que me visitaram em meu sonho, dentro da minha mente, eram, ao mesmo tempo, estranhos para mim e, ainda assim, familiares… como se tivéssemos crescido juntos, como irmãos.",shape=box,color=blue];
		j319429816 -> j3314717978;
	j389976168 [label="Com toda a razão. Poderíamos ficar aqui horas debatendo as implicações morais e teológicas de Duviri. ",shape=box,color=blue];
		j389976168 -> j319429816;
	j810731698 [label="Ao ponderar sobre a menor ideia do que eu teria imaginado em seu lugar, sou tomado por ondas de horror. Mas poderíamos ficar aqui por horas, discutindo tal coisa. ",shape=box,color=blue];
		j810731698 -> j319429816;
	j1227049761 [label="Se ele está demonstrando sinais de mudança, e isso é um produto das suas emoções, talvez seja indicativo de algo mais. Mas talvez seja um debate para outro dia. ",shape=box,color=blue];
		j1227049761 -> j319429816;
	j3314717978 [label="Perdoe-me pela metáfora exagerada, mas era como se fôssemos três árvores cujas raízes estivessem tão entrelaçadas que se tornassem indistinguíveis umas das outras. ",shape=box,color=blue];
		j3314717978 -> j3433028418;
	j3433028418 [label="Que haviam surgido do nada, num estado em que se encontravam. Eu conseguia me lembrar da minha vida sem o Rell e o Harrow. E, no entanto, lá estavam eles. Em cada momento, em cada instante, ao meu lado.",shape=box,color=blue];
		j3433028418 -> j3704819477;
	j3704819477 [label="Aliás, eu gostaria muito de poder falar com o Entrati sobre isso, estou desesperado para saber que tipo de ciência está na raiz disso (sem trocadilho), mas quando finalmente nos recuperamos da mudança, o Entrati já tinha ido embora.",shape=box,color=blue];
		j3704819477 -> j1937133691;
	j1937133691 [label="Check boolean LoidFamilyComplete",color=orange];
		j1937133691 -> j1390160101 [label=true,color=green];
		j1937133691 -> j2402295526 [label=false,color=brown];
		j1937133691 -> j1390160101 [label=false,color=brown];
	j1390160101 [label="Pelo pouco que sei sobre a Infestação e como ela funciona, parece ser meio… não sei… fora do tempo?",shape=box,color=red];
		j1390160101 -> j129494248;
	j2402295526 [label="A filha do Entrati tá lá em cima, ela estudou e trabalhou ao lado dele. Talvez ela possa ajudar",shape=box,color=red];
		j2402295526 -> j1310467055;
	j129494248 [label="Tem uma… guitarra… é tudo muito difícil de explicar, e a gente viajou no tempo através do Helminte…",shape=box,color=red];
		j129494248 -> j820250964;
	j1310467055 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j1310467055 -> j1505405557;
	j820250964 [label="Foi um processo que, acredito, permanecerá em meus pesadelos por muito tempo. De qualquer forma, os detalhes de como o Rell, o Harrow e eu nos conectamos em um nível tão… molecular, espiritual, eu não sei.",shape=box,color=blue];
		j820250964 -> j4222094287;
	j1505405557 [label="Add 1 to Family counter",color=orange];
		j1505405557 -> j2509848085;
	j4222094287 [label="Mas a encruzilhada era de mão dupla. Onde eles estavam na minha vida, eu estava na deles. Vi a Indiferença. Compreendi contra o que eles estavam combatendo. Vi vislumbres do Harrow e do homem que ele foi um dia.",shape=box,color=blue];
		j4222094287 -> j3435755723;
	j2509848085 [label="Se ao menos pudéssemos falar com ela. Suspeito que já existam planos nesse sentido em andamento. Se for o caso, podem contar comigo para… ajudar. Posso ser convincente, quando necessário.",shape=box,color=blue];
		j2509848085 -> j1483097428;
	j3435755723 [label="Mas a pressão da Indiferença tomou conta, eu podia senti-la ali… ouvi-la como eles, batendo nas paredes. Rap… tap… tap…",shape=box,color=blue];
		j3435755723 -> j2330777788;
	j1483097428 [label="De qualquer forma, os detalhes de como o Rell, o Harrow e eu nos conectamos em um nível tão… molecular, espiritual, eu não sei.",shape=box,color=blue];
		j1483097428 -> j4222094287;
	j2330777788 [label="Todas as visões da minha juventude, todos os horrores que presenciei… seriam eles somente a Indiferença? Estaria eu agora me lembrando errado? Ou teria eu sido de fato \"abençoado\" pela Lua?",shape=box,color=blue];
		j2330777788 -> j2388265775;
	j2388265775 [label="Minha fé dentro de mim… desmoronou e se desfez. Nada mais que papel carbonizado, transformado em pó. Ah, como me detesto por minha fraqueza…",shape=box,color=blue];
		j2388265775 -> j2547210604;
	j2547210604 [label="Evaluate expressions",color=orange];
		j2547210604 -> j3490115382 [label="LyonDating",color=purple];
		j2547210604 -> j2807889354 [label="DrifterFaithYesSimilar",color=purple];
		j2547210604 -> j2807889354 [label="DrifterFaithYesForeign",color=purple];
		j2547210604 -> j2807889354 [label="DrifterFaithPersonal",color=purple];
		j2547210604 -> j2294487623 [label="DrifterFaithSol",color=purple];
		j2547210604 -> j2294487623 [label="DrifterFaithLua",color=purple];
		j2547210604 -> j2294487623 [label="DrifterFaithBalance",color=purple];
		j2547210604 -> j1173460972 [label="DrifterFaithAgnostic",color=purple];
		j2547210604 -> j3970161186 [label="DrifterFaithNoFear",color=purple];
		j2547210604 -> j3053344899 [label="DrifterFaithNoMITW",color=purple];
		j2547210604 -> j3970161186 [label="DrifterFaithNoMaybe",color=purple];
		j2547210604 -> j4247966780 [label="false",color=purple];
	j3490115382 [label="Ah, Lyon… você passou por tanta coisa. A dúvida não é sinal de fraqueza, mas de dor",shape=box,color=red];
		j3490115382 -> j173853381;
		j3490115382 -> j3429689674;
		j3490115382 -> j623555814;
		j3490115382 -> j269785603;
		j3490115382 -> j674292693;
	j2807889354 [label="A fé não precisa ser constante, nem se espera que seja. Quantas histórias são contadas sobre pessoas que perdem a fé, só pra reencontrar ela de novo?",shape=box,color=red];
		j2807889354 -> j173853381;
		j2807889354 -> j3429689674;
		j2807889354 -> j623555814;
	j2294487623 [label="Lyon, você dedicou sua vida aos nossos Luminários. Acha que eles te abandonariam por algo assim?",shape=box,color=red];
		j2294487623 -> j173853381;
		j2294487623 -> j3429689674;
		j2294487623 -> j623555814;
	j1173460972 [label="Não sei se existem deuses ou não, Lyon. Acho que ninguém pode saber ao certo. Mas o que eu sei é que você já passou por muita coisa",shape=box,color=red];
		j1173460972 -> j173853381;
		j1173460972 -> j623555814;
		j1173460972 -> j269785603;
	j3970161186 [label="Embora eu pessoalmente não acredite que existam deuses neste mundo, sei o quanto isso tem sido importante pra você em sua vida, não quero menosprezar isso",shape=box,color=red];
		j3970161186 -> j623555814;
		j3970161186 -> j674292693;
	j3053344899 [label="A Indiferença foi criada pela gente, ela não é um deus, Lyon. Não deixa o erro do Entrati te destruir. E quanto à sua fé?",shape=box,color=red];
		j3053344899 -> j623555814;
		j3053344899 -> j674292693;
	j4247966780 [label="Sinto muito em te ver assim, no meio de toda essa confusão… você não merecia isso",shape=box,color=red];
		j4247966780 -> j173853381;
		j4247966780 -> j3429689674;
		j4247966780 -> j623555814;
		j4247966780 -> j269785603;
		j4247966780 -> j674292693;
	j173853381 [label="Não tô dizendo que você precisa reencontrar sua fé, tô dizendo que, se você quiser, se sentir que precisa, ela não tá perdida pra sempre",shape=box,color=red];
		j173853381 -> j654807375;
	j3429689674 [label="Com certeza, a Lua consegue ver o que você passou… o que você suportou em nome dela",shape=box,color=red];
		j3429689674 -> j749012639;
	j623555814 [label="O que eu acho que você precisa fazer é se concentrar em encontrar algum tipo de paz interior… seja lá como ou onde for que você encontre isso",shape=box,color=red];
		j623555814 -> j654807375;
	j269785603 [label="Se existe um deus, se a sua Lua realmente existe, certamente ela pode ver o que você passou… o que você suportou em nome dela… isso deve significar algo pra ela",shape=box,color=red];
		j269785603 -> j749012639;
	j674292693 [label="Acho que você precisa abandonar qualquer noção sobre a existência ou não de deuses e se concentrar, primeiro, em curar a si mesmo",shape=box,color=red];
		j674292693 -> j607529760;
	j654807375 [label="Boolean LyonFaith3Maybe is now true.",color=orange];
		j654807375 -> j508357121;
	j749012639 [label="Boolean LyonFaith3Yes is now true.",color=orange];
		j749012639 -> j508357121;
	j607529760 [label="Boolean LyonFaith3No is now true.",color=orange];
		j607529760 -> j508357121;
	j508357121 [label="Talvez você tenha razão… e minha triste história de dúvidas não era o ponto principal. Mas levarei suas palavras em consideração. Discutiremos isso com mais detalhes amanhã.",shape=box,color=blue];
		j508357121 -> j3577221028;
	j3577221028 [label="Vi a vida do Rell a bordo da Zariman 10-0, e tudo o que ele sofreu depois disso. Vi a vida do Harrow como soldado, desvanecida pela Infestação. Assim como eles viram minha vida e todo o meu sofrimento.",shape=box,color=blue];
		j3577221028 -> j3590289028;
	j3590289028 [label="Pode parecer estranho para você saber que nunca trocamos uma palavra sequer. Nunca sentimos necessidade disso. Simplesmente havia entre nós um… entendimento.",shape=box,color=blue];
		j3590289028 -> j3608264743;
		j3590289028 -> j2642051573;
	j3608264743 [label="Sério? Nunca? ",shape=box,color=red];
		j3608264743 -> j2832998798;
	j2642051573 [label="É… faz sentido",shape=box,color=red];
		j2642051573 -> j1974828118;
	j2832998798 [label="Eu conseguia ouvir suas vozes… eu conhecia todas as palavras que eles já haviam dito em suas vidas. Mas elas nunca foram dirigidas a mim.",shape=box,color=blue];
		j2832998798 -> j1974828118;
	j1974828118 [label="Um sorriso precisa de um discurso? E uma cara triste? É preciso ouvir uma criança chorando para saber que ela está com dor ou medo? Não, nós simplesmente sabíamos o que era transmitido entre nós.",shape=box,color=blue];
		j1974828118 -> j1227791091;
	j1227791091 [label="Até que… até que tudo acabou.",shape=box,color=blue];
		j1227791091 -> j944777217;
	j944777217 [label="Check boolean LyonDating",color=orange];
		j944777217 -> j464791010 [label=true,color=green];
		j944777217 -> j1023005773 [label=false,color=brown];
	j464791010 [label="Eles não se foram, meu milagre… só morreram.",shape=box,color=blue];
		j464791010 -> j2631714718;
	j1023005773 [label="Eles não se foram, meu amigo… só morreram.",shape=box,color=blue];
		j1023005773 -> j2631714718;
	j2631714718 [label="Já não consigo ouvir aquelas partes deles que eram indeterminadas. Agora, creio que só consigo ouvir aquela parte deles que era. ",shape=box,color=blue];
		j2631714718 -> j4272542646;
		j2631714718 -> j1212163204;
	j4272542646 [label="Desculpa, mas… \"partes indeterminadas\"?",shape=box,color=red];
		j4272542646 -> j3288428772;
	j1212163204 [label="Quando foi que você… parou de ouvir ele?",shape=box,color=red];
		j1212163204 -> j2252651296;
	j3288428772 [label="Não consigo explicar melhor do que já expliquei. Não sei como. Me perdoe.",shape=box,color=blue];
		j3288428772 -> j2252651296;
	j2252651296 [label="No momento em que atravessamos o Helminte com o Roathe e chegamos aqui, ao Sanctum. Eu não sei… por quê. Ou como.",shape=box,color=blue];
		j2252651296 -> j3517524247;
	j3517524247 [label="Mas ao atravessar esse véu do tempo, meus amigos, meus irmãos… as árvores cujas raízes se entrelaçaram tão intimamente em minha alma… murcharam e morreram ao meu lado.",shape=box,color=blue];
		j3517524247 -> j2610188903;
	j2610188903 [label="Agora, há um vazio. Apodrecendo. A lembrança deles ainda corrompe a minha. Mas eu não a trocaria se tivesse a chance…",shape=box,color=blue];
		j2610188903 -> j1097403095;
		j2610188903 -> j1794384466;
	j1097403095 [label="Sério?",shape=box,color=red];
		j1097403095 -> j3929525454;
	j1794384466 [label="Por que não?",shape=box,color=red];
		j1794384466 -> j3929525454;
	j3929525454 [label="Consigo me lembrar da primeira vez que minha mãe me bateu. Lembro-me de duas maneiras, tão nítidas quanto a luz mais brilhante do Sol, e sei que ambas as versões são verdadeiras. ",shape=box,color=blue];
		j3929525454 -> j1042661646;
	j1042661646 [label="Numa delas… choro sozinho na escuridão do meu quarto. Em outra, duas figuras estão ao meu lado, nas sombras.",shape=box,color=blue];
		j1042661646 -> j2790198636;
	j2790198636 [label="Lembro-me de duas vezes de quando usei uma lâmina para cortar minha pele e afastar as vozes da minha mente. Em uma delas, o quarto está vazio.",shape=box,color=blue];
		j2790198636 -> j818477888;
	j818477888 [label="Em outra, ouço um zumbido atrás de mim. Sinto a presença silenciosa de um guardião estoico. ",shape=box,color=blue];
		j818477888 -> j776256541;
	j776256541 [label="Se eu perdi a fé na minha deusa Lua e recebi a orientação dele em troca… talvez seja uma troca que eu esteja disposto a fazer.",shape=box,color=blue];
		j776256541 -> j2400849994;
	j2400849994 [label="Evaluate expressions",color=orange];
		j2400849994 -> j3909813719 [label="LyonDating",color=purple];
		j2400849994 -> j3952712256 [label="LyonDating",color=purple];
		j2400849994 -> j3909813719 [label="DrifterFaithYesSimilar",color=purple];
		j2400849994 -> j1823190399 [label="DrifterFaithYesSimilar",color=purple];
		j2400849994 -> j3909813719 [label="DrifterFaithYesForeign",color=purple];
		j2400849994 -> j1823190399 [label="DrifterFaithYesForeign",color=purple];
		j2400849994 -> j3909813719 [label="DrifterFaithPersonal",color=purple];
		j2400849994 -> j1823190399 [label="DrifterFaithPersonal",color=purple];
		j2400849994 -> j3909813719 [label="DrifterFaithSol",color=purple];
		j2400849994 -> j3994085586 [label="DrifterFaithSol",color=purple];
		j2400849994 -> j3909813719 [label="DrifterFaithLua",color=purple];
		j2400849994 -> j3994085586 [label="DrifterFaithLua",color=purple];
		j2400849994 -> j3909813719 [label="DrifterFaithBalance",color=purple];
		j2400849994 -> j3994085586 [label="DrifterFaithBalance",color=purple];
		j2400849994 -> j3909813719 [label="DrifterFaithAgnostic",color=purple];
		j2400849994 -> j3434330479 [label="DrifterFaithAgnostic",color=purple];
