		470 -> 476 [label=false,color=brown];
		470 -> 478 [label=false,color=brown];
	472 [label="E o que você acharia dessa afirmação, se fosse verdade, Peregrino?",shape=box,color=blue];
		472 -> 480;
	473 [label="\"E então…\", nada. Contei-lhe como testemunhei o evento, relatando a verdade da minha experiência. Nada mais.",shape=box,color=blue];
		473 -> 469;
	474 [label="A Marie não tem conhecimento de todos os fatos sobre o que o Entrati é realmente capaz de fazer, e de todas as coisas horríveis que ele fez em nome do \"progresso\" e, agora, da \"redenção\".",shape=box,color=red];
		474 -> 481;
	475 [label="A Marie é uma mulher adulta. Embora eu admire seu desejo de protegê-la, ela pode tomar suas próprias decisões sobre no que escolher acreditar e em quem escolher ter fé.",shape=box,color=red];
		475 -> 482;
	471 [label="Poluindo nossos corpos, destruindo nossos futuros, corrompendo nossos passados… tudo isso, talvez eu pudesse perdoar.",shape=box,color=blue];
		471 -> 479;
	476 [label="O Entrati pode não ter os melhores modos, mas ele tá tentando salvar o universo",shape=box,color=red];
		476 -> 471;
	477 [label="Ele te obrigou a se tornar um Protoframe, igual o Roathe?",shape=box,color=red];
		477 -> 483;
	478 [label="Entendi, mas por que você tá nervoso com o Entrati?",shape=box,color=red];
		478 -> 484;
