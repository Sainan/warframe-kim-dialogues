	482 [label="A confiança é como um vitral. Delicada em sua criação. Bela em seu esplendor. Trágica em sua quebra. E perigosa quando destruída.",shape=box,color=blue];
		482 -> 491;
	479 [label="Mas ver como ele distorceu a imagem da Marie… usou a fé dela na bondade dos outros para seus próprios fins…",shape=box,color=blue];
		479 -> 485;
	483 [label="Não. Eu tinha meu motivo para aceitar o elixir. Eu sabia em que criatura distorcida ele me transformaria. Assim como a Marie.",shape=box,color=blue];
		483 -> 492;
	484 [label="+5 Chemistry",color=orange];
		484 -> 471;
	486 [label="Acho que… tanto faz pra mim?",shape=box,color=red];
		486 -> 493;
	488 [label="Minha única pergunta é: se você tá vendo coisas, essas visões te incomodam?",shape=box,color=red];
		488 -> 495;
	489 [label="O que você disse outro dia me deixou pensando… só quero saber se você tá bem, só isso",shape=box,color=red];
		489 -> 494;
	487 [label="Só queria saber se você tá bem, nada mais",shape=box,color=red];
		487 -> 494;
	496 [label="+15 Chemistry",color=orange];
		496 -> 502;
	491 [label="Na luz quente do Sol, ela se banha em seu brilho, incapaz de ver as falhas que se formam em sua superfície. Incapaz de ouvir as rachaduras que se aprofundam.",shape=box,color=blue];
		491 -> 497;
	485 [label="Isto, eu jamais perdoarei. Isto, eu quero arrancar de sua carne com meu turíbulo, até que ele implore por salvação.",shape=box,color=blue];
		485 -> 474;
		485 -> 475;
	492 [label="Não fomos… forçados, como o diabo. Parte do meu coração se compadece pelo Roathe por tudo o que ele passou.",shape=box,color=blue];
		492 -> 498;
	493 [label="Então, não vejo necessidade de continuar esta conversa.",shape=box,color=blue];
		493 -> 499;
	495 [label="Serei bem franco ao dizer que não sei como responder a isso, Peregrino.",shape=box,color=blue];
		495 -> 501;
	494 [label="Update boolean LyonAllRight",color=orange];
		494 -> 500;
	502 [label="Quem me dera poder livrar-lhe da corrupção que ele semeou em sua mente. Só me resta rezar para que você tenha sucesso onde eu falhei. ",shape=box,color=blue];
		502 -> 507;
	497 [label="Sem saber que os fragmentos de sua própria obra-prima logo se voltariam contra ela, escolheu se cegar para o que inevitavelmente aconteceria.",shape=box,color=blue];
		497 -> 503;
	498 [label="Então, ele abre a boca para falar.",shape=box,color=blue];
		498 -> 504;
		498 -> 505;
	499 [label="Chat ends.",color=orange];
	501 [label="Ao longo da minha vida, presenciei horrores que levariam outros à loucura. E, mais tragicamente, de vez em quando, minhas visões se tornavam realidade.",shape=box,color=blue];
		501 -> 506;
	500 [label="Se eu \"estou bem\"? Serei bem franco ao dizer que não sei como responder a isso, Peregrino.",shape=box,color=blue];
		500 -> 501;
	507 [label="- Padre Lyon Allard",shape=box,color=blue];
		507 -> 513;
	503 [label="Quem me dera poder suportar esse sofrimento em seu lugar, como eu o teria tatuado em minha alma com alegria. Mas isso é por ela, e somente por ela. ",shape=box,color=blue];
		503 -> 508;
	504 [label="Você precisa se lembrar de como ele foi criado. Do ambiente em que ele teve que aprender a sobreviver. Ele é, e sempre foi, um Orokin",shape=box,color=red];
		504 -> 509;
		504 -> 510;
	505 [label="Sinceramente, não acho que ele seja tão terrível assim. Tô até começando a gostar dele",shape=box,color=red];
		505 -> 511;
	506 [label="Update boolean LyonVisions1",color=orange];
		506 -> 512;
