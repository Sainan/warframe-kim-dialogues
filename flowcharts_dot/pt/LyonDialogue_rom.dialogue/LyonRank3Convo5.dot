	536 [label="- Padre Lyon Allard",shape=box,color=blue];
		536 -> 541;
	537 [label="Ele nos pega desprevenidos… quando estamos vulneráveis, quando estamos fracos, quando precisamos de respostas.",shape=box,color=blue];
		537 -> 542;
