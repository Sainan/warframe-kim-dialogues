digraph {
	445 [label="LyonRank3Convo5 begins.",color=orange];
		445 -> 446;
	446 [label="Era uma noite de tempestade quando o \"Cardeal Dimanche\" nos visitou. Ele permaneceu no santuário da igreja, ileso pelo vendaval que rugia lá fora.",shape=box,color=blue];
		446 -> 447;
	447 [label="Isso deveria ter sido o primeiro motivo da minha preocupação. Em vez disso, inclinei a cabeça em sua direção e o cumprimentei como faria com qualquer novo enviado da Santa Maria.",shape=box,color=blue];
		447 -> 448;
	448 [label="Já estávamos à espera de um novo cardeal, visto que o último havia partido alguns meses antes devido a uma doença.",shape=box,color=blue];
		448 -> 449;
	449 [label="Dimanche me cumprimentou com um sorriso caloroso e um aperto de mão firme. Perguntei-lhe se sua viagem havia sido longa. Jamais esquecerei sua resposta.",shape=box,color=blue];
		449 -> 450;
	450 [label="\"Foi difícil… mas não durou muito.\"",shape=box,color=blue];
		450 -> 451;
	451 [label="Na época, isso me intrigou, assim como o fato de seu sobretudo estar completamente seco. Mas ignorei, como todos costumam fazer quando se deparam com algo incomum.",shape=box,color=blue];
		451 -> 452;
	452 [label="E eu não tive tempo de pensar nisso, pois a Marie, ansiosa, chegou um instante depois.",shape=box,color=blue];
		452 -> 453;
	453 [label="Ele se ajoelhou para cumprimentá-la, sentando-se à sua altura na cadeira, e pegou suas mãos nas dele. Eu deveria ter percebido a manipulação pelo que ela era.",shape=box,color=blue];
		453 -> 454;
	454 [label="Afinal, ele não foi o único demônio a aparecer à nossa porta durante uma tempestade.",shape=box,color=blue];
		454 -> 455;
	455 [label="Update boolean LyonEntrati1",color=orange];
		455 -> 456;
	456 [label="Check boolean MarieEntrati1",color=orange];
		456 -> 457 [label=true,color=green];
		456 -> 459 [label=true,color=green];
		456 -> 460 [label=true,color=green];
		456 -> 458 [label=false,color=brown];
		456 -> 457 [label=false,color=brown];
	457 [label="O outro demônio seria o Roathe?",shape=box,color=red];
		457 -> 461;
	459 [label="Ela conta essa história de uma maneira bem… diferente",shape=box,color=red];
		459 -> 463;
	460 [label="Ela ainda acredita nas boas intenções dele, e você?",shape=box,color=red];
		460 -> 464;
	458 [label="Presumo que você não seja um aliado do Entrati?",shape=box,color=red];
		458 -> 462;
	461 [label="Sim. Mas essa é uma história para outro dia. Se eu começar a falar dele, meu mau humor, que já está ruim, vai piorar…",shape=box,color=blue];
		461 -> 465;
	463 [label="Sim. Tem razão.",shape=box,color=blue];
		463 -> 467;
		463 -> 468;
	464 [label="+5 Chemistry",color=orange];
		464 -> 469;
	462 [label="Depois de suportar suas mentiras e traições, e enquanto continuamos a sofrer com sua manipulação de Marie, você quer que eu esteja bem? Não, de forma alguma.",shape=box,color=blue];
		462 -> 466;
	465 [label="Insustentável. Eu preferiria concentrar meu humor atual nas más ações do Entrati, se não se importar.",shape=box,color=blue];
		465 -> 470;
	467 [label="Ela me diz que, às vezes, você vê coisas que os outros não veem",shape=box,color=red];
		467 -> 472;
	468 [label="E então? ",shape=box,color=red];
		468 -> 473;
	469 [label="A Marie acredita no melhor de cada alma. É uma habilidade que ela aprimorou, aperfeiçoou e refinou como um escudo contra o mundo ao seu redor.",shape=box,color=blue];
		469 -> 474;
		469 -> 475;
	466 [label="+5 Chemistry",color=orange];
