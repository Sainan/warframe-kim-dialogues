		518 -> 524;
	519 [label="E, como tal, eu os considerava a orientação da Lua. Que eu havia sido escolhido pelos Luminários para carregar tal fardo. Ou assim eu acreditava na época. Essa é a razão pela qual busquei ingressar no sacerdócio.",shape=box,color=blue];
