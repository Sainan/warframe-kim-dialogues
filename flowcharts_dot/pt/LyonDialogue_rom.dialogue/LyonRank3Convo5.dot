	532 [label="Acredito que se tornou… complicado, ultimamente, com a introdução de novas informações.",shape=box,color=blue];
		532 -> 534;
	533 [label="Estamos somente começando a conversar sobre essas coisas, Peregrino. Não é que eu não acredite que você tenha visto, em primeira mão, sofrimento da pior espécie, nem que você precise de proteção contra quaisquer descrições insignificantes que eu possa conseguir evocar.",shape=box,color=blue];
