	j910576961 [label="+10 Chemistry",color=orange];
		j910576961 -> j3380712755;
	j2560428001 [label="+10 Chemistry",color=orange];
		j2560428001 -> j65947144;
	j2329045287 [label="Me perdoe, por favor, me perdoe. Eu simplesmente… eu pensei que fosse impossível, isso… não é algo que eu… poderia… ter… imaginado…",shape=box,color=blue];
		j2329045287 -> j4291643733;
	j216659058 [label="De jeito nenhum! Não é isso que eu quero dizer! Muito pelo contrário, na verdade, eu simplesmente… eu pensei que fosse impossível, isso… não é algo que eu… pudesse… ter… imaginado…",shape=box,color=blue];
		j216659058 -> j4291643733;
	j641515560 [label="Mas quero que você entenda que, se você terminasse isso entre nós… esse laço que eu antes considerava impossível entre mim e outra pessoa…",shape=box,color=blue];
