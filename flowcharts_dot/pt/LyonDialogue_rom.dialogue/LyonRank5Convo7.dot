	j4180370878 [label="Sim. Claro. Seria… hipócrita aceitar qualquer outra resposta neste momento… ",shape=box,color=blue];
		j4180370878 -> j2109564693;
	j3843475670 [label="Mas agora que me dei ao trabalho de escrever este preâmbulo extremamente egocêntrico…",shape=box,color=blue];
		j3843475670 -> j2229492962;
		j3843475670 -> j2619852713;
		j3843475670 -> j1282949720;
	j2109564693 [label="Entendo perfeitamente. E desejo-te tudo de bom. E guardarei com carinho todos os momentos que passamos juntos. ",shape=box,color=blue];
		j2109564693 -> j3824630816;
	j2229492962 [label="Pra um cara que era reservado, você realmente gosta de falar",shape=box,color=red];
		j2229492962 -> j4254435953;
	j2619852713 [label="Eu os acho adoráveis, não se preocupe",shape=box,color=red];
		j2619852713 -> j1081416979;
	j1282949720 [label="Você poderia simplesmente ter dito: \"eu ficarei bem, mesmo que um dia sigamos caminhos separados\"",shape=box,color=red];
		j1282949720 -> j281603886;
	j3824630816 [label="Guardarei eles na minha alma, mesmo que desapareçam da minha mente. Adeus.",shape=box,color=blue];
		j3824630816 -> j3994460333;
	j4254435953 [label="+5 Chemistry",color=orange];
		j4254435953 -> j2067133333;
	j1081416979 [label="+5 Chemistry",color=orange];
		j1081416979 -> j366922777;
	j281603886 [label="+5 Chemistry",color=orange];
		j281603886 -> j1837129390;
	j3994460333 [label="Boolean LyonDating is now false.",color=orange];
		j3994460333 -> j4254443866;
	j2067133333 [label="Bah! Se você não queria ter acesso aos meus pensamentos mais íntimos, não deveria ter se intrometido. A culpa é inteiramente sua.",shape=box,color=blue];
		j2067133333 -> j3668285595;
	j366922777 [label="Fico muito feliz que você goste das minhas andanças. É exatamente por isso que prefiro falar tão pouco. Consegue imaginar ter que aguentar isso pessoalmente? A Marie teria me massacrado há anos.",shape=box,color=blue];
		j366922777 -> j3668285595;
	j1837129390 [label="Existe um certo grau de irreverência e sarcasmo que naturalmente se destaca em você, algo que eu jamais conseguiria alcançar. Deixo isso para você.",shape=box,color=blue];
		j1837129390 -> j3668285595;
	j4254443866 [label="Boolean IsDating is now false.",color=orange];
		j4254443866 -> j3311435967;
	j3668285595 [label="No entanto, tudo isso serviu de pretexto para uma história que agora parecerá bastante curta em comparação com o resto…",shape=box,color=blue];
		j3668285595 -> j1275024670;
	j1275024670 [label="Acordei ontem à noite de um pesadelo. Quando acordei, sombras me cercavam. Isso não é nada estranho ou novo para o meu estado de espírito. Elas pairavam sobre minha cama e não desapareciam.",shape=box,color=blue];
		j1275024670 -> j1269877707;
	j1269877707 [label="Eu não tinha medo deles, pois sabia que não podiam me fazer mal. Contudo, eles também não desapareciam da minha mente. Só havia uma maneira que eu conhecia de me livrar deles.",shape=box,color=blue];
		j1269877707 -> j1796740192;
	j1796740192 [label="Levantando-me da cama, vesti-me o melhor que pude, cambaleando em meio à visão turva do pesadelo que persistia. Agarrei meu turíbulo, caí de joelhos no meio do chão e me preparei para… bem…",shape=box,color=blue];
		j1796740192 -> j1918822056;
	j1918822056 [label="Eu me preparei para \"esvaziar a mente\". Vamos deixar por isso mesmo.",shape=box,color=blue];
		j1918822056 -> j2840735830;
	j2840735830 [label="Mas, ao fechar os olhos, minha mente divagou. Meus pensamentos se voltaram… para você, meu milagre…",shape=box,color=blue];
		j2840735830 -> j1294634442;
	j1294634442 [label="O som da sua voz… o toque da sua mão no meu ombro…",shape=box,color=blue];
		j1294634442 -> j572489363;
	j572489363 [label="E as visões… fugiram. Abandonaram seu posto, expulsas pelo fantasma mais forte… de você.",shape=box,color=blue];
		j572489363 -> j1458447008;
	j1458447008 [label="Eu… me levantei. Coloquei meu turíbulo na mesa de cabeceira e… optei por caminhar pela areia do Sanctum.",shape=box,color=blue];
		j1458447008 -> j4049036900;
		j1458447008 -> j2341677873;
	j4049036900 [label="Agora entendo por que você queria o preâmbulo…",shape=box,color=red];
		j4049036900 -> j409618551;
	j2341677873 [label="Não sei o que dizer…",shape=box,color=red];
		j2341677873 -> j2369261543;
	j409618551 [label="Sim. Bem. Durante minha caminhada, eu… percebi instantaneamente o perigo sombrio de um momento como aquele. Que você pudesse… passar a considerá-lo uma responsabilidade… passar a me ver como correntes que te prendem.",shape=box,color=blue];
		j409618551 -> j2861075520;
	j2369261543 [label="+5 Chemistry",color=orange];
		j2369261543 -> j4102330096;
	j2861075520 [label="Eu te imploro… eu rogo, a qualquer deus ou deuses, no céu ou na terra… que nunca faças isso. Este é um presente que me deste, e a cada vez que o receberes, o apreciarei com carinho.",shape=box,color=blue];
		j2861075520 -> j905673458;
	j4102330096 [label="Não são necessárias palavras, meu milagre…",shape=box,color=blue];
		j4102330096 -> j611013361;
	j905673458 [label="Prometa-me, meu milagre, que se chegar o tempo em que eu me tornar para você uma gaiola vazia… você se libertará de mim.",shape=box,color=blue];
		j905673458 -> j1022868937;
	j611013361 [label="Durante minha caminhada, eu… percebi instantaneamente o perigo sombrio de um momento como aquele. Que você pudesse… passar a considerá-lo uma responsabilidade… passar a me ver como correntes que te prendem.",shape=box,color=blue];
		j611013361 -> j2861075520;
	j1022868937 [label="Não serei uma prisão vazia para aqueles que amo. Nem para você. Nem para a Marie.",shape=box,color=blue];
		j1022868937 -> j1596697316;
		j1022868937 -> j2925782454;
	j1596697316 [label="[Terminar com o Lyon] Eu… eu não posso… não posso prometer isso, me desculpe",shape=box,color=red];
		j1596697316 -> j2940765020;
	j2925782454 [label="Eu prometo",shape=box,color=red];
		j2925782454 -> j567940593;
	j2940765020 [label="+10 Chemistry",color=orange];
		j2940765020 -> j799096754;
	j567940593 [label="+10 Chemistry",color=orange];
		j567940593 -> j2306228915;
	j799096754 [label="Obrigado. Obrigado, meu milagre, pela sua honestidade. Isso exigiu coragem, neste momento, e eu te admiro por isso.",shape=box,color=blue];
		j799096754 -> j1288038853;
	j2306228915 [label="Obrigado. Obrigado, meu milagre…",shape=box,color=blue];
		j2306228915 -> j172289535;
	j1288038853 [label="Guardarei com carinho todos os momentos que passamos juntos. Isso significa muito mais do que você pode imaginar.",shape=box,color=blue];
		j1288038853 -> j3824630816;
	j172289535 [label="De repente, estou muito cansado, como se… um grande peso tivesse sido tirado dos meus ombros. Acho que preciso me deitar.",shape=box,color=blue];
