		j1886668075 -> j3454934997;
	j883639627 [label="Sim, eu mesmo vi. Embora esteja bem escondido. Mas talvez ele não goste das suas tentativas de bisbilhotar. Acredito que ele esteja satisfeito com o que se tornou.",shape=box,color=blue];
		j883639627 -> j3454934997;
	j2372573601 [label="Esses arranjos devem se basear em algo mais do que… simples escuridão. Não vou dar sermão, porém.",shape=box,color=blue];
		j2372573601 -> j3454934997;
	j779438417 [label="Tenho dificuldade em acreditar que você escolheria se envolver com um vitral quebrado como este… a menos que estivesse gravemente doente.",shape=box,color=blue];
		j779438417 -> j2283037533;
		j779438417 -> j1470390288;
	j1016195998 [label="Há muito tempo que me reconciliei com isso. Já não me perturba. As visões que me atormentam… as vozes… aprendi a conviver com elas sem medo, nem ódio.",shape=box,color=blue];
		j1016195998 -> j1402399621;
