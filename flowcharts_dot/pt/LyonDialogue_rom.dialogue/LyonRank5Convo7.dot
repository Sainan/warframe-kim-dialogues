		j1697539566 -> j1122478047 [label=false,color=brown];
	j2634210285 [label="Minha mente já é complexa o suficiente, receio, para imaginar você e ele, um homem que conheço tão bem, juntos. Talvez eu seja antiquado nesse aspecto. Parece que sou uma relíquia ambulante. Por isso, peço que me perdoe.",shape=box,color=blue];
		j2634210285 -> j3311435967;
