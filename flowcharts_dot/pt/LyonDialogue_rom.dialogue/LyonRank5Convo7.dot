		j2183298434 -> j2903824085 [label=false,color=brown];
	j1149674525 [label="Fico feliz que haja alguém capaz de encontrar forças para penetrar nas complexidades da personalidade do Roathe e enxergar a fragilidade que reside em seu interior.",shape=box,color=blue];
		j1149674525 -> j2207470104;
	j1505025916 [label="Posso fazer uma pergunta que temo ser indelicada, meu amigo?",shape=box,color=blue];
		j1505025916 -> j716714195;
		j1505025916 -> j3074957286;
	j3351579844 [label="Que pergunta maravilhosamente inofensiva e encantadoramente banal. Não me fazem essa pergunta com frequência. ",shape=box,color=blue];
		j3351579844 -> j4062197196;
	j1828505033 [label="Sim, o que foi? Aconteceu alguma coisa?",shape=box,color=blue];
		j1828505033 -> j1721003381;
		j1828505033 -> j2573888881;
	j2757957777 [label="Você tá me deixando nervoso… o que tem de errado?",shape=box,color=red];
		j2757957777 -> j2000642196;
	j594246249 [label="Sim, tô aqui. Pode prosseguir",shape=box,color=red];
		j594246249 -> j1261898927;
	j1086378500 [label="Eu não sabia como você se sentiria, já que…",shape=box,color=red];
		j1086378500 -> j1829556350;
	j4229680009 [label="Tô meio que… impressionado com ela",shape=box,color=red];
		j4229680009 -> j2888629629;
	j2903824085 [label="Essa conversa é uma ameaça pra mim… ou o quê?",shape=box,color=red];
		j2903824085 -> j4136996124;
	j2207470104 [label="Sei, embora ele negue veementemente, que se considera um covarde. Eu não o rotularia assim.",shape=box,color=blue];
		j2207470104 -> j1301086824;
	j716714195 [label="Claro, já te perguntei bastante",shape=box,color=red];
		j716714195 -> j318468674;
	j3074957286 [label="Por que eu tô… namorando o Roathe?",shape=box,color=red];
		j3074957286 -> j2237501548;
	j4062197196 [label="Estou… muito bem, obrigado.",shape=box,color=blue];
		j4062197196 -> j2361506291;
	j1721003381 [label="Deixa pra lá… esqueci o que eu ia falar",shape=box,color=red];
		j1721003381 -> j4028591310;
	j2573888881 [label="Não sei qual a melhor forma de dizer isso, então vou direto ao ponto: eu gosto muito de você",shape=box,color=red];
		j2573888881 -> j732224748;
	j2000642196 [label="Não há nada de errado, muito pelo contrário. É isso que é tão importante para você compreender. As terríveis consequências das quais desejo libertá-lo, caso você suponha que elas possam ocorrer.",shape=box,color=blue];
		j2000642196 -> j3014728964;
		j2000642196 -> j4099110230;
		j2000642196 -> j3473363414;
	j1261898927 [label="+5 Chemistry",color=orange];
		j1261898927 -> j92788334;
	j1829556350 [label="Ah, você acha que estou surpreso? Eu vivo à sombra da luz dela, e sempre vivi. Não, meu amigo, não estou amargurado nem com inveja por causa disso, eu lhe prometo.",shape=box,color=blue];
		j1829556350 -> j3898345749;
	j2888629629 [label="Assim como todos nós. A irmã da minha alma nunca deixa de me surpreender. Estou feliz por vocês, mais do que as palavras conseguem expressar.",shape=box,color=blue];
		j2888629629 -> j4197022837;
	j4136996124 [label="Hum? Não. Eu dificilmente seria tão arrogante a ponto de sair por aí fingindo ser o guardião dela. Ela é perfeitamente capaz de quebrar seus ossos se achar que você é digno disso. ",shape=box,color=blue];
		j4136996124 -> j337618739;
	j1301086824 [label="O Entrati disse-lhe que ele seria necessário para salvar um futuro que ele desconhecia. Um futuro sobre o qual ele não teria reinado, sem pessoas para se prostrarem a seus pés, sem servos para o adorarem.",shape=box,color=blue];
		j1301086824 -> j3534956255;
	j318468674 [label="O que… você vê no Roathe que levou vocês dois a… namorarem?",shape=box,color=blue];
		j318468674 -> j3813349401;
		j318468674 -> j2656883812;
		j318468674 -> j1491599493;
	j2237501548 [label="Vejo que você já enfrentou esse tipo de questionamento ou estava esperando por ele. Sim. Exatamente isso. O que… você vê nele?",shape=box,color=blue];
		j2237501548 -> j3813349401;
		j2237501548 -> j2656883812;
		j2237501548 -> j1491599493;
	j2361506291 [label="+20 Chemistry",color=orange];
		j2361506291 -> j1852386147;
	j4028591310 [label="Isso acontece comigo frequentemente. Muitas vezes, quando passo por portas. Já me perguntei várias vezes por quê. ",shape=box,color=blue];
		j4028591310 -> j2987939617;
	j732224748 [label="Eu… você tem… certeza? Você está bem? Você não bateu a cabeça recentemente, bateu?",shape=box,color=blue];
		j732224748 -> j337496494;
		j732224748 -> j672098959;
	j3014728964 [label="Sou todo ouvidos",shape=box,color=red];
		j3014728964 -> j547607306;
	j4099110230 [label="Você não tá fazendo muito sentido",shape=box,color=red];
		j4099110230 -> j3859154395;
	j3473363414 [label="Graves consequências… de quê?",shape=box,color=red];
		j3473363414 -> j1106259265;
	j92788334 [label="Obrigado. Antes de começar, quero assegurar-lhe que não há nada de errado; no entanto, é aí que talvez resida as graves consequências das quais desejo livrá-lo, caso você imagine que elas possam advir.",shape=box,color=blue];
		j92788334 -> j3014728964;
		j92788334 -> j4099110230;
		j92788334 -> j3473363414;
	j3898345749 [label="Não guardo ressentimentos pelo que aconteceu entre nós, só consigo expressar a minha profunda gratidão pelo tempo que passamos juntos.",shape=box,color=blue];
		j3898345749 -> j1066559305;
	j4197022837 [label="Há tanta alegria nos olhos dela quando ela fala de você. Ela fica radiante de felicidade sempre que pensa que você pode aparecer por aqui.",shape=box,color=blue];
		j4197022837 -> j3181266040;
	j337618739 [label="Eu só queria dizer que a felicidade dela é contagiante, e eu também me pego sorrindo ao pensar nisso. Por isso, também lhe agradeço.",shape=box,color=blue];
		j337618739 -> j3311435967;
	j3534956255 [label="Ele pode considerar isso um ato de medo, como um rato fugindo de um navio afundando… tomar o soro e esquecer as ações que o levaram a isso. ",shape=box,color=blue];
		j3534956255 -> j1767222617;
	j3813349401 [label="Honestamente… já parou pra olhar pra ele?",shape=box,color=red];
		j3813349401 -> j64254587;
	j2656883812 [label="Acho que existe uma dor nele, em algum lugar por baixo de todo o… humor e personalidade",shape=box,color=red];
		j2656883812 -> j1712905080;
	j1491599493 [label="Eu… não consigo evitar. Há uma escuridão e um perigo nele que me atraem. Isso me fascina",shape=box,color=red];
		j1491599493 -> j2262685212;
	j1852386147 [label="Sim, acho que hoje estou muito bem, de fato. ",shape=box,color=blue];
		j1852386147 -> j1387982643;
	j2987939617 [label="+5 Chemistry",color=orange];
		j2987939617 -> j1387982643;
	j337496494 [label="Por que é tão difícil de acreditar nisso?",shape=box,color=red];
