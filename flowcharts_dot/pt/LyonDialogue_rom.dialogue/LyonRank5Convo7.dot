		j876512705 -> j910576961;
	j895822866 [label="Com o tempo, ele vai se perdoar. Mas não acho que a aparência externa vá mudar",shape=box,color=red];
		j895822866 -> j910576961;
	j3454934997 [label="Você conhece a si mesmo e aos seus limites. Desejo tudo de bom para vocês dois.",shape=box,color=blue];
		j3454934997 -> j2560428001;
