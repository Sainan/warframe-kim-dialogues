		j3143966337 -> j2634210285;
	j457811102 [label="Você está atualmente envolvido com a Marie. Ela é muito querida para mim, e não acredito que meu relacionamento com você possa prejudicar o dela ou de alguma forma distrair a atenção dele.",shape=box,color=blue];
