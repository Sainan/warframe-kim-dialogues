	j3429599652 [label="[Terminar com o Lyon] Tudo isso tá ficando demais pra mim, me desculpe… talvez seja melhor terminarmos aqui",shape=box,color=red];
		j3429599652 -> j4180370878;
	j848094383 [label="Não consigo expressar o quanto meu coração se parte por você. Mas serei eternamente grato por nossos fantasmas solitários da dor terem se encontrado.",shape=box,color=blue];
		j848094383 -> j3843475670;
