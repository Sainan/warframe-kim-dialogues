		j3181266040 -> j337618739;
	j3311435967 [label="- Lyon",shape=box,color=blue];
		j3311435967 -> "Chat ends.";
	j1767222617 [label="Eu o vejo como um homem que compreendeu os cálculos do campo de batalha e soube a hora de abandonar um navio já perdido. Pois a guerra ainda não havia terminado.",shape=box,color=blue];
		j1767222617 -> j1494212890;
	j64254587 [label="Longe de mim condená-lo.",shape=box,color=blue];
		j64254587 -> j1886668075;
	j1712905080 [label="+5 Chemistry",color=orange];
		j1712905080 -> j883639627;
	j2262685212 [label="Eu entendo o fascínio. Não vou negar que também o percebo. No entanto, espero, pelo seu bem, que você não permita que ele te consuma.",shape=box,color=blue];
		j2262685212 -> j2372573601;
	j1387982643 [label="Tenha um ótimo resto de dia. - Lyon",shape=box,color=blue];
		j1387982643 -> "Chat ends.";
	j3528469638 [label="Bem, para ser honesto… quando você tem tantas outras opções diante de si… a Marie, o Roathe ou… qualquer outra pessoa no universo, aliás…",shape=box,color=blue];
		j3528469638 -> j779438417;
	j1611796078 [label="Tenho consciência de que posso ser interpretado por muitos, e de fato, posso muito bem ser, na realidade, como alguém que não está bem da cabeça. No mínimo, não estou totalmente em sã consciência.",shape=box,color=blue];
		j1611796078 -> j1016195998;
	j379186116 [label="Agora, fico feliz que você esteja passando esse tempo com ela. Ela lhe trará alegria, enquanto eu só poderia lhe trazer tristeza. Seja feliz com ela. Você tem toda a minha bênção.",shape=box,color=blue];
		j379186116 -> j3311435967;
