		2269 -> 2272 [label="RoatheFailUltimate",color=purple];
		2269 -> 2271 [label="RoatheFailNot21",color=purple];
		2269 -> 2270 [label="RoatheFailUnloved",color=purple];
	2273 [label="O Roathe tem enfrentado a verdade sobre… bem… ter tomado o soro. E não sei como, mas acho que não fiz um bom trabalho em ajudar ele a superar isso",shape=box,color=red];
		2273 -> 2277;
	2272 [label="Não tenho certeza… acho que falei algo que não devia",shape=box,color=red];
		2272 -> 2276;
	2271 [label="Ele me disse pra não me aprofundar mais em suas memórias. Então, não me aprofundei. E agora… parece que travei",shape=box,color=red];
		2271 -> 2275;
	2270 [label="Eu disse a ele que só tava com ele pra ter uma companhia casual, e embora ele não tenha parecido se importar… sinto que regredimos bastante",shape=box,color=red];
		2270 -> 2274;
	2277 [label="Entendo. Pode ser difícil reconciliar-se com as próprias ações passadas quando elas são vistas sob uma nova perspectiva. Amaldiçoo o Entrati por tê-lo forçado, e a nós também, a essa situação desprezível.",shape=box,color=blue];
		2277 -> 2280;
	2276 [label="Entendo. Receio ter que lhe dizer que pouco posso fazer a respeito, pois você está colhendo o que plantou neste assunto.",shape=box,color=blue];
		2276 -> 2278;
	2275 [label="Entendo. Às vezes, agir de acordo com os melhores desejos de alguém não é o mesmo que seguir seus desejos à risca.",shape=box,color=blue];
		2275 -> 2279;
	2274 [label="Entendo. Receio ter que lhe dizer que pouco posso fazer a respeito, pois você está colhendo o que plantou neste assunto.",shape=box,color=blue];
		2274 -> 2278;
	2280 [label="Farei o que estiver ao meu alcance para convencê-lo a ouvi-lo. Mas devo aconselhá-lo a preparar argumentos melhores para que ele reinterprete suas ações como algo além de… covardia.",shape=box,color=blue];
		2280 -> 2282;
	2278 [label="Agir com tamanha indiferença e descaso certamente resultará em uma resposta à altura. Principalmente quando se trata de alguém como o Roathe.",shape=box,color=blue];
		2278 -> 2281;
	2279 [label="É um ato terrível que devemos cometer, desobedecer aos desejos de alguém, especialmente em uma ação como vasculhar suas memórias e pensamentos íntimos.",shape=box,color=blue];
		2279 -> 2341;
	2282 [label="Pois eu sei que é isso que o consome por dentro.",shape=box,color=blue];
		2282 -> 2284;
	2281 [label="Não sei que recursos você tem para corrigir as coisas. Mas não acredito que você encontrará um caminho através da Marie ou de mim, me perdoe.",shape=box,color=blue];
		2281 -> 2283;
	2341 [label="Amaldiçoo o Entrati por tê-lo forçado, e a nós mesmos, a uma posição tão desprezível.",shape=box,color=blue];
		2341 -> 2342;
	2284 [label="Sei que também precisaremos da ajuda da Marie neste assunto. Ela pode ser mais difícil de convencer, pois, como você sabe, não há muita simpatia entre eles.",shape=box,color=blue];
		2284 -> 2286;
	2283 [label="Talvez seja melhor buscar outras opções neste momento.",shape=box,color=blue];
		2283 -> 2285;
	2342 [label="Mas parece-me que a única maneira de ajudá-lo é, infelizmente, fazer exatamente isso. E continuar a explorar a Descêndia, até que não reste nenhuma memória por descobrir.",shape=box,color=blue];
		2342 -> 2343;
	2286 [label="Update boolean LyonRoatheFailFix",color=orange];
		2286 -> 2287;
	2285 [label="Chat ends.",color=orange];
	2343 [label="Não importa quanto o diabo reclame.",shape=box,color=blue];
		2343 -> 2344;
	2287 [label="Que a Lua te guie.",shape=box,color=blue];
		2287 -> 2288;
	2344 [label="Chat ends.",color=orange];
	2288 [label="Update boolean MarieRoatheFail",color=orange];
