		j421763245 -> j2476457516 [label=true,color=green];
		j421763245 -> j1928979137 [label=false,color=brown];
	"Chat ends." [color=orange];
	j2476457516 [label="Se houver algo que eu possa fazer para ajudar, farei, meu milagre. O que parece ter dado errado entre vocês dois?",shape=box,color=blue];
		j2476457516 -> j1618578127;
	j1928979137 [label="Se houver algo que eu possa fazer para ajudar, farei, meu amigo. O que parece ter dado errado entre vocês dois?",shape=box,color=blue];
		j1928979137 -> j1618578127;
	j1618578127 [label="Evaluate expressions",color=orange];
		j1618578127 -> j1954744792 [label="RoatheFail",color=purple];
		j1618578127 -> j1954744792 [label="RoatheFailStall",color=purple];
		j1618578127 -> j2928699364 [label="RoatheFailUltimate",color=purple];
		j1618578127 -> j1942249561 [label="RoatheFailNot21",color=purple];
		j1618578127 -> j329995861 [label="RoatheFailUnloved",color=purple];
	j1954744792 [label="O Roathe tem enfrentado a verdade sobre… bem… ter tomado o soro. E não sei como, mas acho que não fiz um bom trabalho em ajudar ele a superar isso",shape=box,color=red];
		j1954744792 -> j2209051356;
	j2928699364 [label="Não tenho certeza… acho que falei algo que não devia",shape=box,color=red];
		j2928699364 -> j1351642928;
	j1942249561 [label="Ele me disse pra não me aprofundar mais em suas memórias. Então, não me aprofundei. E agora… parece que travei",shape=box,color=red];
		j1942249561 -> j2429209652;
	j329995861 [label="Eu disse a ele que só tava com ele pra ter uma companhia casual, e embora ele não tenha parecido se importar… sinto que regredimos bastante",shape=box,color=red];
		j329995861 -> j1351642928;
	j2209051356 [label="Entendo. Pode ser difícil reconciliar-se com as próprias ações passadas quando elas são vistas sob uma nova perspectiva. Amaldiçoo o Entrati por tê-lo forçado, e a nós também, a essa situação desprezível.",shape=box,color=blue];
		j2209051356 -> j812818206;
	j1351642928 [label="Entendo. Receio ter que lhe dizer que pouco posso fazer a respeito, pois você está colhendo o que plantou neste assunto.",shape=box,color=blue];
		j1351642928 -> j3761916962;
	j2429209652 [label="Entendo. Às vezes, agir de acordo com os melhores desejos de alguém não é o mesmo que seguir seus desejos à risca.",shape=box,color=blue];
		j2429209652 -> j844419942;
	j812818206 [label="Farei o que estiver ao meu alcance para convencê-lo a ouvi-lo. Mas devo aconselhá-lo a preparar argumentos melhores para que ele reinterprete suas ações como algo além de… covardia.",shape=box,color=blue];
		j812818206 -> j2289838222;
	j3761916962 [label="Agir com tamanha indiferença e descaso certamente resultará em uma resposta à altura. Principalmente quando se trata de alguém como o Roathe.",shape=box,color=blue];
		j3761916962 -> j2681598034;
	j844419942 [label="É um ato terrível que devemos cometer, desobedecer aos desejos de alguém, especialmente em uma ação como vasculhar suas memórias e pensamentos íntimos.",shape=box,color=blue];
		j844419942 -> j1227814451;
	j2289838222 [label="Pois eu sei que é isso que o consome por dentro.",shape=box,color=blue];
		j2289838222 -> j2673890843;
	j2681598034 [label="Não sei que recursos você tem para corrigir as coisas. Mas não acredito que você encontrará um caminho através da Marie ou de mim, me perdoe.",shape=box,color=blue];
		j2681598034 -> j4020265312;
	j1227814451 [label="Amaldiçoo o Entrati por tê-lo forçado, e a nós mesmos, a uma posição tão desprezível.",shape=box,color=blue];
		j1227814451 -> j206514760;
	j2673890843 [label="Sei que também precisaremos da ajuda da Marie neste assunto. Ela pode ser mais difícil de convencer, pois, como você sabe, não há muita simpatia entre eles.",shape=box,color=blue];
		j2673890843 -> j971752115;
	j4020265312 [label="Talvez seja melhor buscar outras opções neste momento.",shape=box,color=blue];
		j4020265312 -> "Chat ends.";
	j206514760 [label="Mas parece-me que a única maneira de ajudá-lo é, infelizmente, fazer exatamente isso. E continuar a explorar a Descêndia, até que não reste nenhuma memória por descobrir.",shape=box,color=blue];
		j206514760 -> j4086371992;
	j971752115 [label="Boolean LyonRoatheFailFix is now true.",color=orange];
		j971752115 -> j3259650781;
	j4086371992 [label="Não importa quanto o diabo reclame.",shape=box,color=blue];
		j4086371992 -> "Chat ends.";
	j3259650781 [label="Que a Lua te guie.",shape=box,color=blue];
		j3259650781 -> "Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
}