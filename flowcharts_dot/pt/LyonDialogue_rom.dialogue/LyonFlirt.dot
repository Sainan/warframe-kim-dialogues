	j1688885848 [label="Lyon? Podemos conversar? ",shape=box,color=red];
		j1688885848 -> j1441886508;
	j3755989174 [label="Lyon? Sinto muito, muito mesmo, se o que eu disse te deixou desconfortável… essa não era minha intenção",shape=box,color=red];
		j3755989174 -> j1867085887;
	j3925893263 [label="[Encerrar Conversa]",shape=box,color=red];
		j3925893263 -> j2883342425;
	j1441886508 [label="Sobre o que você gostaria de conversar, Peregrino?",shape=box,color=blue];
		j1441886508 -> j597037727;
	j1867085887 [label="Suponho então que me resta simplesmente perguntar: se você não estava flertando comigo para me deixar desconfortável para sua própria diversão… por que você estava flertando em primeiro lugar?",shape=box,color=blue];
		j1867085887 -> j2207563409;
		j1867085887 -> j3844792355;
		j1867085887 -> j3030084097;
	j2883342425 [label="Boolean LyonFlirtIgnored is now true.",color=orange];
		j2883342425 -> "Chat ends.";
	j597037727 [label="Seus comentários insinuantes são somente para sua diversão? Ou você gostaria de mudar de assunto?",shape=box,color=blue];
		j597037727 -> j1481851109;
		j597037727 -> j1878417140;
		j597037727 -> j3030084097;
	j2207563409 [label="Tenho interesse em você, Lyon, simples assim",shape=box,color=red];
		j2207563409 -> j3601311962;
	j3844792355 [label="Não sei o que me deu, Lyon… claramente, tudo isso foi um erro, sinto muito",shape=box,color=red];
		j3844792355 -> j575950778;
	j3030084097 [label="Eu… quis dizer o que disse. Mas tudo isso tá acontecendo muito rápido, eu sei",shape=box,color=red];
		j3030084097 -> j575950778;
	"Chat ends." [color=orange];
	j1481851109 [label="Eu não tava flertando com você pra me divertir, Lyon. Sinto muito se você pensa que era isso",shape=box,color=red];
		j1481851109 -> j575950778;
	j1878417140 [label="Não tive a intenção de te ofender, tava só brincando. Foi mal",shape=box,color=red];
		j1878417140 -> j3690260102;
	j3601311962 [label="E não é recíproco, simples assim.",shape=box,color=blue];
		j3601311962 -> "Chat ends.";
	j575950778 [label="Eu… me perdoe, Peregrino.",shape=box,color=blue];
		j575950778 -> j2921662499;
	j3690260102 [label="Entendo.",shape=box,color=blue];
		j3690260102 -> "Chat ends.";
	j2921662499 [label="E peço desculpas mais uma vez pela minha franqueza ao expressar tudo o que tem me dominado ultimamente:",shape=box,color=blue];
		j2921662499 -> j3193286062;
	j3193286062 [label="Agora, estou cercado por estranhos e criaturas falantes em um mundo de loucura fantástica e matança aparentemente interminável e desenfreada.",shape=box,color=blue];
		j3193286062 -> j3533537016;
	j3533537016 [label="Tudo o que eu conhecia foi varrido pelos raios brilhantes da \"Luz da Jade\", do \"Império Orokin\" e do \"Void\", e está ameaçado pelo \"Murmúrio\".",shape=box,color=blue];
		j3533537016 -> j480176167;
	j480176167 [label="Portanto, peço desculpas se achar esta… oferta de atração da sua parte estranhamente risível em sua ingenuidade. Não te conheço, nem confio em você. Na verdade, tudo o que tenho é a palavra de terceiros.",shape=box,color=blue];
		j480176167 -> j3224113229;
	j3224113229 [label="A palavra de outras pessoas que eu também não conheço, nem confio ainda.",shape=box,color=blue];
		j3224113229 -> j1238632957;
	j1238632957 [label="Entretanto, tudo isso são somente as forças externas que se acumulam diante de mim e de Marie. Sem falar de todo o resto com o qual luto e que vocês não podem ver.",shape=box,color=blue];
		j1238632957 -> j842184452;
	j842184452 [label="Agradeço sua franqueza. Sei o que você está tentando fazer e o parabenizo por isso. E espero que, caso chegue o momento em que eu… reconsidere sua oferta, ela ainda esteja de pé.",shape=box,color=blue];
		j842184452 -> j142513318;
		j842184452 -> j4003977668;
		j842184452 -> j3348024098;
	j142513318 [label="Sem promessas, padre",shape=box,color=red];
		j142513318 -> j634543695;
	j4003977668 [label="Nas palavras de um querido amigo: \"eu sou teimoso, cara\"",shape=box,color=red];
		j4003977668 -> j1063260773;
	j3348024098 [label="Vai sim",shape=box,color=red];
		j3348024098 -> j994705712;
	j634543695 [label="Claro. Ninguém esperava isso.",shape=box,color=blue];
		j634543695 -> j3280740522;
