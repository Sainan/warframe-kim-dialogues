		j410090499 -> j1249463991 [label="LyonRell1",color=purple];
		j410090499 -> "Chat ends." [label="false",color=purple];
	j1162688096 [label="Não me orgulho disso, mas bebi uma garrafa inteira de vinho, e estou pronto para contar todo o resto do que tenho tentado desesperadamente não contar, meu milagre…",shape=box,color=blue];
		j1162688096 -> j433644465;
	j1249463991 [label="Não me orgulho disso, mas bebi uma garrafa inteira de vinho, e estou pronto para contar todo o resto do que tenho tentado desesperadamente não contar…",shape=box,color=blue];
		j1249463991 -> j433644465;
	"Chat ends." [color=orange];
	j433644465 [label="Se o que esta garrafa contém é, de fato, vinho, já que não estava precisamente rotulado, e o Sr. Loid não tinha certeza se o que tínhamos na minha época e o que ele conhecia como vinho eram a mesma coisa.",shape=box,color=blue];
		j433644465 -> j862940163;
	j862940163 [label="Em minha defesa, eu não tinha a intenção de beber a garrafa inteira… mas estava tentando discernir se era de fato a mesma substância… e então, ela acabou…",shape=box,color=blue];
		j862940163 -> j4089344673;
		j862940163 -> j3665840496;
		j862940163 -> j1177201954;
	j4089344673 [label="Não, não vou fazer isso",shape=box,color=red];
		j4089344673 -> j2839275485;
	j3665840496 [label="Tem o mesmo gosto?",shape=box,color=red];
		j3665840496 -> j3919338110;
	j1177201954 [label="Você tá bêbado?",shape=box,color=red];
		j1177201954 -> j2306729166;
	j2839275485 [label="Quem me dera poder escapar tão facilmente. Não te culpo. ",shape=box,color=blue];
		j2839275485 -> j3856020424;
	j3919338110 [label="Não sei! Essa foi a parte mais frustrante de tudo! Mas esse não é o ponto. O objetivo era ficar bêbado. E nem sei se estou bêbado. Com certeza não estou sóbrio, no entanto…",shape=box,color=blue];
		j3919338110 -> j339761945;
	j2306729166 [label="Potencialmente. Certamente não sou o que eles considerariam sóbrio, de forma alguma.",shape=box,color=blue];
		j2306729166 -> j4177934724;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j339761945 [label="Então, suponho que isso terá que ser suficiente.",shape=box,color=blue];
		j339761945 -> j382439351;
		j339761945 -> j2987864081;
	j4177934724 [label="Que era exatamente o objetivo de todo esse esforço. Então, suponho que isso terá que ser suficiente. ",shape=box,color=blue];
		j4177934724 -> j382439351;
		j4177934724 -> j2987864081;
	j382439351 [label="O que é tão terrível assim, que você precisa encher a cara pra poder me contar?",shape=box,color=red];
		j382439351 -> j3921320055;
	j2987864081 [label="No seu tempo…",shape=box,color=red];
		j2987864081 -> j3921320055;
	j3921320055 [label="Rap… tap… tap…",shape=box,color=blue];
		j3921320055 -> j4227619068;
		j3921320055 -> j3191429673;
	j4227619068 [label="Ah, não…",shape=box,color=red];
		j4227619068 -> j307730210;
	j3191429673 [label="É… saquei agora…",shape=box,color=red];
		j3191429673 -> j307730210;
	j307730210 [label="Tenho certeza de que eles não estiveram presentes em minha mente durante toda a minha vida. O Tenno conhecido como Rell e seu guardião, Harrow. É impossível que eles estivessem dentro das paredes da casa onde passei minha infância. ",shape=box,color=blue];
		j307730210 -> j3619857342;
	j3619857342 [label="Não há possibilidade alguma de que eles tenham ecoado em minha mente com as vozes sussurradas e confusas das minhas visões ao longo de todos esses anos. Mesmo assim, eu os vejo lá, eu o ouço lá, em minhas memórias.",shape=box,color=blue];
		j3619857342 -> j252073137;
	j252073137 [label="Check boolean LyonTime1",color=orange];
		j252073137 -> j2290260152 [label=true,color=green];
		j252073137 -> j3892529477 [label=false,color=brown];
	j2290260152 [label="Eu entendi tudo o que o Entrati disse, sobre como a energia poderia existir no tempo em vários lugares ao mesmo tempo, em um sentido filosófico. Mas eu não entendi isso emocionalmente… até injetar o soro.",shape=box,color=blue];
		j2290260152 -> j1620364890;
	j3892529477 [label="Foi como se, no momento em que injetei o soro, tudo se tornasse um só. Quando o Entrati se revelou, e toda a verdade sobre sua existência…",shape=box,color=blue];
		j3892529477 -> j3392559693;
	j1620364890 [label="Às vezes, vejo em minha mente um grande lago raso e tranquilo, que se estende em todas as direções. Escuro e liso, como um espelho de ônix.",shape=box,color=blue];
		j1620364890 -> j3429861807;
	j3392559693 [label="Ele me explicou tudo o que sabia sobre \"entrelaçamento quântico\", \"superposição\", \"eternalismo\" e coisas do gênero. ",shape=box,color=blue];
		j3392559693 -> j1750687552;
	j3429861807 [label="Um grande lago escuro, que se estende até o infinito. Impossível de compreender.",shape=box,color=blue];
		j3429861807 -> j290936292;
	j1750687552 [label="Eu entendi tudo num sentido científico, quase filosófico. Mas não entendi emocionalmente… até injetar o soro.",shape=box,color=blue];
		j1750687552 -> j1620364890;
	j290936292 [label="E é lá que eu os encontraria. É foi lá que nos encontraríamos. E é lá que eu também os sentiria…",shape=box,color=blue];
		j290936292 -> j1721035424;
	j1721035424 [label="Eles?",shape=box,color=red];
		j1721035424 -> j2347597480;
	j2347597480 [label="Os outros Harrows… estátuas vazias de coisas, ecos de ecos de ecos… eles vagam e vagam e vagam por toda a eternidade, em todas as direções…",shape=box,color=blue];
		j2347597480 -> j502851217;
	j502851217 [label="O Rell se colocou dentro de um deles. Se perdeu dentro dele. E, ao fazer isso, se perdeu dentro de todos eles…",shape=box,color=blue];
		j502851217 -> j1539107390;
	j1539107390 [label="Incluindo eu. Incluindo o Harrow que estava no soro que me criou.",shape=box,color=blue];
		j1539107390 -> j1259936302;
		j1539107390 -> j2726834720;
	j1259936302 [label="Santo Void, eu nem tinha me dado conta…",shape=box,color=red];
		j1259936302 -> j777774064;
	j2726834720 [label="Ah, não…",shape=box,color=red];
		j2726834720 -> j777774064;
	j777774064 [label="Eles estavam lá comigo, em minha mente… Rell e seu Harrow, tão parecidos comigo, e ainda assim… tão diferentes.",shape=box,color=blue];
		j777774064 -> j3699208451;
	j3699208451 [label="Ele não tinha medo. Ele não tinha dúvidas… duas coisas que eu definitivamente tinha.",shape=box,color=blue];
		j3699208451 -> j4196681291;
	j4196681291 [label="Ele resistiu firmemente à Indiferença, sem se importar com o que ela era ou não era. Simplesmente sabia o que precisava ser feito. ",shape=box,color=blue];
		j4196681291 -> j1271212953;
	j1271212953 [label="Mesmo depois de toda a crueldade que ele sofreu… durante todos aqueles anos, no \"agora\" e no \"então\" daquela eternidade, do momento em que injetei o soro… do \"antes\" e do \"depois\"… ele estava lá.",shape=box,color=blue];
		j1271212953 -> j2526765733;
	j2526765733 [label="Ele era meu amigo… ele era meu irmão.",shape=box,color=blue];
		j2526765733 -> j3118449921;
	j3118449921 [label="Então? E agora? ",shape=box,color=blue];
		j3118449921 -> j2974545019;
	j2974545019 [label="Não consigo mais senti-lo.",shape=box,color=blue];
		j2974545019 -> j4220640197;
		j2974545019 -> j199263644;
	j4220640197 [label="Ele… ele tá em paz agora, Lyon… ele tá em paz",shape=box,color=red];
		j4220640197 -> j3993111677;
	j199263644 [label="Lyon…",shape=box,color=red];
		j199263644 -> j2605349869;
	j3993111677 [label="Eu sei. Senti isso quando ele se foi. E chorei. Sinto muita falta dele. Sei que ele ainda está presente, de alguma forma… embora eu não entenda completamente como.",shape=box,color=blue];
		j3993111677 -> j1854079966;
		j3993111677 -> j1819086427;
	j2605349869 [label="Sinto muita falta dele. Sei que ele ainda está presente, de alguma forma… embora eu não entenda completamente como.",shape=box,color=blue];
		j2605349869 -> j1854079966;
		j2605349869 -> j1819086427;
	j1854079966 [label="O Rell era o mais forte de todos nós… fico feliz que você tenha tido a oportunidade de conhecer ele",shape=box,color=red];
		j1854079966 -> j802546342;
	j1819086427 [label="O Rell foi marginalizado por causa da ignorância e da crueldade das crianças… ele não merecia o que aconteceu com ele",shape=box,color=red];
		j1819086427 -> j1601868375;
	j802546342 [label="Fico feliz por tê-lo conhecido também. Quanto à sua força? Talvez sim, talvez não. No fim, ele simplesmente sabia o que era necessário e era forte o suficiente para terminar a missão. ",shape=box,color=blue];
		j802546342 -> j2537735805;
	j1601868375 [label="Talvez. Mas, no fim, ele fez o que era preciso. E teve forças para terminar sua missão. ",shape=box,color=blue];
		j1601868375 -> j2537735805;
	j2537735805 [label="Em momentos como estes, \"força suficiente\" é tudo o que podemos pedir em oração.",shape=box,color=blue];
		j2537735805 -> j2557675463;
	j2557675463 [label="O que, infelizmente, não se pode dizer do mesmo deste vinho… que era muito forte mesmo, somente demorava a fazer efeito.",shape=box,color=blue];
		j2557675463 -> j60630597;
	j60630597 [label="Eu deveria ir, antes…",shape=box,color=blue];
		j60630597 -> j4208709583;
	j4208709583 [label="Eu deveria ir.",shape=box,color=blue];
		j4208709583 -> j111445917;
