		1557 -> 1560 [label="LyonRell1",color=purple];
		1557 -> 1558 [label="false",color=purple];
	1559 [label="Não me orgulho disso, mas bebi uma garrafa inteira de vinho, e estou pronto para contar todo o resto do que tenho tentado desesperadamente não contar, meu milagre…",shape=box,color=blue];
		1559 -> 1561;
	1560 [label="Não me orgulho disso, mas bebi uma garrafa inteira de vinho, e estou pronto para contar todo o resto do que tenho tentado desesperadamente não contar…",shape=box,color=blue];
		1560 -> 1561;
	1558 [label="Chat ends.",color=orange];
	1561 [label="Se o que esta garrafa contém é, de fato, vinho, já que não estava precisamente rotulado, e o Sr. Loid não tinha certeza se o que tínhamos na minha época e o que ele conhecia como vinho eram a mesma coisa.",shape=box,color=blue];
		1561 -> 1562;
	1562 [label="Em minha defesa, eu não tinha a intenção de beber a garrafa inteira… mas estava tentando discernir se era de fato a mesma substância… e então, ela acabou…",shape=box,color=blue];
		1562 -> 1563;
		1562 -> 1564;
		1562 -> 1565;
	1563 [label="Não, não vou fazer isso",shape=box,color=red];
		1563 -> 1566;
	1564 [label="Tem o mesmo gosto?",shape=box,color=red];
		1564 -> 1567;
	1565 [label="Você tá bêbado?",shape=box,color=red];
		1565 -> 1568;
	1566 [label="Quem me dera poder escapar tão facilmente. Não te culpo. ",shape=box,color=blue];
		1566 -> 1569;
	1567 [label="Não sei! Essa foi a parte mais frustrante de tudo! Mas esse não é o ponto. O objetivo era ficar bêbado. E nem sei se estou bêbado. Com certeza não estou sóbrio, no entanto…",shape=box,color=blue];
		1567 -> 1570;
	1568 [label="Potencialmente. Certamente não sou o que eles considerariam sóbrio, de forma alguma.",shape=box,color=blue];
		1568 -> 1571;
	1569 [label="Update boolean LyonConfessionFail",color=orange];
		1569 -> 1572;
	1570 [label="Então, suponho que isso terá que ser suficiente.",shape=box,color=blue];
		1570 -> 1573;
		1570 -> 1574;
	1571 [label="Que era exatamente o objetivo de todo esse esforço. Então, suponho que isso terá que ser suficiente. ",shape=box,color=blue];
		1571 -> 1573;
		1571 -> 1574;
	1572 [label="Chat ends.",color=orange];
	1573 [label="O que é tão terrível assim, que você precisa encher a cara pra poder me contar?",shape=box,color=red];
		1573 -> 1575;
	1574 [label="No seu tempo…",shape=box,color=red];
		1574 -> 1575;
	1575 [label="Rap… tap… tap…",shape=box,color=blue];
		1575 -> 1576;
		1575 -> 1577;
	1576 [label="Ah, não…",shape=box,color=red];
		1576 -> 1578;
	1577 [label="É… saquei agora…",shape=box,color=red];
		1577 -> 1578;
	1578 [label="Tenho certeza de que eles não estiveram presentes em minha mente durante toda a minha vida. O Tenno conhecido como Rell e seu guardião, Harrow. É impossível que eles estivessem dentro das paredes da casa onde passei minha infância. ",shape=box,color=blue];
		1578 -> 1579;
	1579 [label="Não há possibilidade alguma de que eles tenham ecoado em minha mente com as vozes sussurradas e confusas das minhas visões ao longo de todos esses anos. Mesmo assim, eu os vejo lá, eu o ouço lá, em minhas memórias.",shape=box,color=blue];
		1579 -> 1580;
	1580 [label="Check boolean LyonTime1",color=orange];
		1580 -> 1581 [label=true,color=green];
		1580 -> 1582 [label=false,color=brown];
	1581 [label="Eu entendi tudo o que o Entrati disse, sobre como a energia poderia existir no tempo em vários lugares ao mesmo tempo, em um sentido filosófico. Mas eu não entendi isso emocionalmente… até injetar o soro.",shape=box,color=blue];
		1581 -> 1583;
	1582 [label="Foi como se, no momento em que injetei o soro, tudo se tornasse um só. Quando o Entrati se revelou, e toda a verdade sobre sua existência…",shape=box,color=blue];
		1582 -> 1584;
	1583 [label="Às vezes, vejo em minha mente um grande lago raso e tranquilo, que se estende em todas as direções. Escuro e liso, como um espelho de ônix.",shape=box,color=blue];
		1583 -> 1585;
	1584 [label="Ele me explicou tudo o que sabia sobre \"entrelaçamento quântico\", \"superposição\", \"eternalismo\" e coisas do gênero. ",shape=box,color=blue];
		1584 -> 1586;
	1585 [label="Um grande lago escuro, que se estende até o infinito. Impossível de compreender.",shape=box,color=blue];
		1585 -> 1587;
	1586 [label="Eu entendi tudo num sentido científico, quase filosófico. Mas não entendi emocionalmente… até injetar o soro.",shape=box,color=blue];
		1586 -> 1583;
	1587 [label="E é lá que eu os encontraria. É foi lá que nos encontraríamos. E é lá que eu também os sentiria…",shape=box,color=blue];
		1587 -> 1588;
	1588 [label="Eles?",shape=box,color=red];
		1588 -> 1589;
	1589 [label="Os outros Harrows… estátuas vazias de coisas, ecos de ecos de ecos… eles vagam e vagam e vagam por toda a eternidade, em todas as direções…",shape=box,color=blue];
		1589 -> 1590;
	1590 [label="O Rell se colocou dentro de um deles. Se perdeu dentro dele. E, ao fazer isso, se perdeu dentro de todos eles…",shape=box,color=blue];
		1590 -> 1591;
	1591 [label="Incluindo eu. Incluindo o Harrow que estava no soro que me criou.",shape=box,color=blue];
		1591 -> 1592;
		1591 -> 1593;
	1592 [label="Santo Void, eu nem tinha me dado conta…",shape=box,color=red];
		1592 -> 1594;
	1593 [label="Ah, não…",shape=box,color=red];
		1593 -> 1594;
	1594 [label="Eles estavam lá comigo, em minha mente… Rell e seu Harrow, tão parecidos comigo, e ainda assim… tão diferentes.",shape=box,color=blue];
		1594 -> 1595;
	1595 [label="Ele não tinha medo. Ele não tinha dúvidas… duas coisas que eu definitivamente tinha.",shape=box,color=blue];
		1595 -> 1596;
	1596 [label="Ele resistiu firmemente à Indiferença, sem se importar com o que ela era ou não era. Simplesmente sabia o que precisava ser feito. ",shape=box,color=blue];
		1596 -> 1597;
	1597 [label="Mesmo depois de toda a crueldade que ele sofreu… durante todos aqueles anos, no \"agora\" e no \"então\" daquela eternidade, do momento em que injetei o soro… do \"antes\" e do \"depois\"… ele estava lá.",shape=box,color=blue];
		1597 -> 1598;
	1598 [label="Ele era meu amigo… ele era meu irmão.",shape=box,color=blue];
		1598 -> 1599;
	1599 [label="Então? E agora? ",shape=box,color=blue];
		1599 -> 1600;
	1600 [label="Não consigo mais senti-lo.",shape=box,color=blue];
		1600 -> 1601;
		1600 -> 1602;
	1601 [label="Ele… ele tá em paz agora, Lyon… ele tá em paz",shape=box,color=red];
		1601 -> 1603;
	1602 [label="Lyon…",shape=box,color=red];
		1602 -> 1604;
	1603 [label="Eu sei. Senti isso quando ele se foi. E chorei. Sinto muita falta dele. Sei que ele ainda está presente, de alguma forma… embora eu não entenda completamente como.",shape=box,color=blue];
		1603 -> 1605;
		1603 -> 1606;
	1604 [label="Sinto muita falta dele. Sei que ele ainda está presente, de alguma forma… embora eu não entenda completamente como.",shape=box,color=blue];
		1604 -> 1605;
		1604 -> 1606;
	1605 [label="O Rell era o mais forte de todos nós… fico feliz que você tenha tido a oportunidade de conhecer ele",shape=box,color=red];
		1605 -> 1607;
	1606 [label="O Rell foi marginalizado por causa da ignorância e da crueldade das crianças… ele não merecia o que aconteceu com ele",shape=box,color=red];
		1606 -> 1608;
	1607 [label="Fico feliz por tê-lo conhecido também. Quanto à sua força? Talvez sim, talvez não. No fim, ele simplesmente sabia o que era necessário e era forte o suficiente para terminar a missão. ",shape=box,color=blue];
		1607 -> 1609;
	1608 [label="Talvez. Mas, no fim, ele fez o que era preciso. E teve forças para terminar sua missão. ",shape=box,color=blue];
		1608 -> 1609;
	1609 [label="Em momentos como estes, \"força suficiente\" é tudo o que podemos pedir em oração.",shape=box,color=blue];
		1609 -> 1610;
	1610 [label="O que, infelizmente, não se pode dizer do mesmo deste vinho… que era muito forte mesmo, somente demorava a fazer efeito.",shape=box,color=blue];
		1610 -> 1611;
	1611 [label="Eu deveria ir, antes…",shape=box,color=blue];
		1611 -> 1612;
	1612 [label="Eu deveria ir.",shape=box,color=blue];
		1612 -> 1613;
	1613 [label="Check boolean LyonDating",color=orange];
		1613 -> 1614 [label=true,color=green];
		1613 -> 1615 [label=false,color=brown];
	1614 [label="+20 Chemistry",color=orange];
		1614 -> 1616;
	1615 [label="+20 Chemistry",color=orange];
		1615 -> 1617;
	1616 [label="Obrigado, meu amor.",shape=box,color=blue];
		1616 -> 1618;
	1617 [label="Obrigado, meu amigo.",shape=box,color=blue];
