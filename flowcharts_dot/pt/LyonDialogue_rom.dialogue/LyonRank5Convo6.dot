		j1424199455 -> j3744775317 [label="MarieFamilySuccess",color=purple];
		j1424199455 -> j3343062932 [label="MarieEntratiCompleteA",color=purple];
		j1424199455 -> j3666222847 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j144350591 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j3628520484 [label="MarieEntratiCompleteC",color=purple];
		j1424199455 -> j2124051050 [label="false",color=purple];
	j3037608365 [label="Ah! Como se eu fosse trair a confiança dela e te contar tudo! Por mais precioso que você seja para mim, meu milagre, ela tem sido minha irmã de alma por muitos e muitos anos.",shape=box,color=blue];
		j3037608365 -> j3673937501;
	j1409761758 [label="Ah! Como se eu fosse trair a confiança dela e te contar tudo! Por mais precioso que você seja para mim, meu amigo, ela tem sido minha irmã de alma por muitos e muitos anos.",shape=box,color=blue];
		j1409761758 -> j3673937501;
	j3744775317 [label="Sim. Acho que ela vai ajudar a resolver as coisas entre o Loid e a família lá de cima. E isso é… enorme, Lyon. Acho que não consigo nem explicar o quão enorme é",shape=box,color=red];
		j3744775317 -> j2226145481;
	j797576620 [label="Não… sinceramente, do jeito que as coisas ficaram, perdi qualquer chance que eu tinha de ela me ajudar a resolver as coisas entre o Loid e a família lá de cima",shape=box,color=red];
		j797576620 -> j3112357921;
	j2977187163 [label="Não… sinceramente, do jeito que as coisas ficaram, perdi qualquer chance que eu tinha de ela me ajudar a resolver as coisas entre o Loid e a família lá de cima",shape=box,color=red];
		j2977187163 -> j3429625985;
	j2940588685 [label="Sim. Ela não vai me ajudar a consertar as coisas entre o Loid e a família lá de cima, e tudo bem pra mim",shape=box,color=red];
		j2940588685 -> j1909442413;
	j3343062932 [label="Sim. Fico feliz que ela tenha percebido que o Entrati talvez não seja puramente \"bom\", e… bem, ele também não é puramente \"mau\", né?",shape=box,color=red];
		j3343062932 -> j671888328;
	j3666222847 [label="Tô satisfeito com a forma como as coisas terminaram. Sinceramente, quanto mais penso nisso, mais concordo com ela em relação ao Entrati",shape=box,color=red];
		j3666222847 -> j1909442413;
	j144350591 [label="Não chegamos a um consenso sobre o Entrati. Não consegui convencer ela… só queria ter feito melhor",shape=box,color=red];
		j144350591 -> j3704317229;
	j3628520484 [label="\"Concordamos em discordar\" sobre o Entrati, e acho que isso é o melhor que podemos esperar sobre o assunto. Não creio que mais conversa vá mudar alguma coisa",shape=box,color=red];
		j3628520484 -> j492004775;
	j2124051050 [label="Sinceramente, tá tudo bem. Não acho que vá melhorar nem piorar por enquanto",shape=box,color=red];
		j2124051050 -> j492004775;
	j3673937501 [label="Não, receio que as palavras dela para mim, permanecerão em segredo. Mas, mesmo assim, elas a comoveram. Fico pensando, você ficou satisfeito com a forma como isso deixou as coisas entre vocês?",shape=box,color=blue];
		j3673937501 -> j1424199455;
	j2226145481 [label="Acredito que consigo compreender a grandeza disso, senão a magnitude. Sinto-me… bastante honrado por fazer parte disso, mesmo que de uma forma pequena.",shape=box,color=blue];
		j2226145481 -> j1171018538;
		j2226145481 -> j1955076379;
	j3112357921 [label="Fascinante… bem, você é o amante dela agora, não é? Se alguém neste lugar tivesse influência suficiente para convencê-la, seria você, certo?",shape=box,color=blue];
		j3112357921 -> j1196215974;
	j3429625985 [label="Fascinante… bem, sabe-se que tenho alguma… influência sobre ela, por mais limitada que seja. Você acha que essa reconciliação entre o Sr. Loid e a família distante do Entrati é importante?",shape=box,color=blue];
		j3429625985 -> j553449749;
		j3429625985 -> j4119182073;
	j1909442413 [label="Não consigo dizer se esse tom é de petulância, arrogância, ignorância ou apatia. Portanto, optarei por uma mistura dos quatro e seguirei com o meu dia. ",shape=box,color=blue];
		j1909442413 -> j1108296316;
	j671888328 [label="Sim, eu compartilho da sua opinião. Não acredito que ele seja uma coisa ou outra, mas sim que suas motivações sejam complexas.",shape=box,color=blue];
		j671888328 -> j1490001213;
	j3704317229 [label="Hmm. Bem, infelizmente, chega um momento em que tudo precisa ser deixado de lado. Uma massa pode ser trabalhada demais. Um artista pode exagerar na pintura. E uma discussão certamente pode se… prolongar demais.",shape=box,color=blue];
		j3704317229 -> j1274146105;
	j492004775 [label="Sim, talvez seja melhor que os assuntos passem para temas mais… interessantes.",shape=box,color=blue];
		j492004775 -> j4179699202;
	j1171018538 [label="Não pensei que você se ofereceria pra me ajudar",shape=box,color=red];
		j1171018538 -> j1319412048;
	j1955076379 [label="Isso significa que você vai me ajudar a convencer o Loid a subir e falar com eles?",shape=box,color=red];
		j1955076379 -> j3982402563;
	j1196215974 [label="Espero sinceramente que você não tenha feito nenhum tipo de sacrifício em suas palavras para ela… colocando uma prioridade em detrimento de outra, na tentativa de conquistá-la.",shape=box,color=blue];
		j1196215974 -> j257031715;
	j553449749 [label="Existe tanta solidão neste mundo, Lyon, tanta tristeza… por que não acabar com um pouco disso enquanto ainda dá? ",shape=box,color=red];
		j553449749 -> j3050655135;
	j4119182073 [label="Não tenho certeza… é um instinto, uma intuição… sinto que vocês 3 foram trazidos aqui pelo Entrati por algum motivo",shape=box,color=red];
		j4119182073 -> j4081670530;
	j1108296316 [label="Deplorável.",shape=box,color=blue];
		j1108296316 -> j3497962379;
	j1490001213 [label="A arrogância o impulsionava. Uma sede de conhecimento. Agora, talvez, uma sede de perdão. Quem pode dizer? Pergunto-me até se ele próprio sabe. ",shape=box,color=blue];
		j1490001213 -> j2863619900;
	j1274146105 [label="Acho que eu simplesmente deixaria isso para lá. E esperaria que algum dia ela tivesse a chance de ver o Entrati pelo que sabemos que ele é… na melhor das hipóteses, uma pessoa complexa.",shape=box,color=blue];
		j1274146105 -> j2863619900;
	j4179699202 [label="Eu, por minha vez, estou pronto para que eles se afastem das intermináveis conversas sobre o maravilhoso e impecável \"Cardeal\".",shape=box,color=blue];
		j4179699202 -> j2863619900;
	j1319412048 [label="Sei que não sou muito afável, mas também não sou nenhum monstro. Se desejar minha ajuda, terá. ",shape=box,color=blue];
		j1319412048 -> j2800191596;
	j3982402563 [label="Claro. Se desejar minha ajuda, me terá à disposição.",shape=box,color=blue];
		j3982402563 -> j2800191596;
	j257031715 [label="Que situação lamentável seria essa…",shape=box,color=blue];
		j257031715 -> j632665587;
	j3050655135 [label="Hmm… e quanto à possível dor que uma reaproximação poderia causar entre as partes envolvidas quando tais revelações vierem à tona?",shape=box,color=blue];
		j3050655135 -> j2579864024;
		j3050655135 -> j2598453386;
