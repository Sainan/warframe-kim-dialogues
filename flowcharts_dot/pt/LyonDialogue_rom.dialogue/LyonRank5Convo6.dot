		j2579864024 -> j993843139;
	j2598453386 [label="Acho que o que temos a ganhar juntos é maior do que o que temos a perder separados",shape=box,color=red];
		j2598453386 -> j993843139;
	j3004126308 [label="Não, mas meu trabalho é proteger as pessoas que precisam. E eu não posso protegê-las, nem este lugar, do Murmúrio e da Infestação pra sempre. Mas vocês dois, e talvez até o Roathe, podem",shape=box,color=red];
		j3004126308 -> j993843139;
	j432742437 [label="Não confio nele tanto, mas ainda assim não acho que ele seja nosso inimigo. Tenho a sensação de que uma guerra tá chegando, e que tamo sendo colocado no tabuleiro, e é aqui o nosso lugar",shape=box,color=red];
		j432742437 -> j1364296948;
