	1869 [label="Não pensei que você se ofereceria pra me ajudar",shape=box,color=red];
		1869 -> 1878;
	1870 [label="Isso significa que você vai me ajudar a convencer o Loid a subir e falar com eles?",shape=box,color=red];
		1870 -> 1879;
	1871 [label="Espero sinceramente que você não tenha feito nenhum tipo de sacrifício em suas palavras para ela… colocando uma prioridade em detrimento de outra, na tentativa de conquistá-la.",shape=box,color=blue];
		1871 -> 1880;
	1874 [label="Existe tanta solidão neste mundo, Lyon, tanta tristeza… por que não acabar com um pouco disso enquanto ainda dá? ",shape=box,color=red];
		1874 -> 1882;
	1875 [label="Não tenho certeza… é um instinto, uma intuição… sinto que vocês 3 foram trazidos aqui pelo Entrati por algum motivo",shape=box,color=red];
		1875 -> 1883;
	1876 [label="Deplorável.",shape=box,color=blue];
		1876 -> 1884;
	1877 [label="A arrogância o impulsionava. Uma sede de conhecimento. Agora, talvez, uma sede de perdão. Quem pode dizer? Pergunto-me até se ele próprio sabe. ",shape=box,color=blue];
		1877 -> 1881;
	1872 [label="Acho que eu simplesmente deixaria isso para lá. E esperaria que algum dia ela tivesse a chance de ver o Entrati pelo que sabemos que ele é… na melhor das hipóteses, uma pessoa complexa.",shape=box,color=blue];
		1872 -> 1881;
	1873 [label="Eu, por minha vez, estou pronto para que eles se afastem das intermináveis conversas sobre o maravilhoso e impecável \"Cardeal\".",shape=box,color=blue];
		1873 -> 1881;
	1878 [label="Sei que não sou muito afável, mas também não sou nenhum monstro. Se desejar minha ajuda, terá. ",shape=box,color=blue];
		1878 -> 1885;
	1879 [label="Claro. Se desejar minha ajuda, me terá à disposição.",shape=box,color=blue];
