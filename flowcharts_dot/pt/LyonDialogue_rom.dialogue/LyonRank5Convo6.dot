		1837 -> 1841;
	1836 [label="Chat ends.",color=orange];
	1839 [label="Afinal, existe um motivo para a criação do termo \"crime passional\". Se nós, como seres humanos, não fôssemos fiéis às nossas crenças, a vida seria terrivelmente monótona, eu acho. ",shape=box,color=blue];
		1839 -> 1844;
