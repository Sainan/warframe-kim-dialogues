	1850 [label="Ah! Como se eu fosse trair a confiança dela e te contar tudo! Por mais precioso que você seja para mim, meu milagre, ela tem sido minha irmã de alma por muitos e muitos anos.",shape=box,color=blue];
		1850 -> 1852;
	1849 [label="Ah! Como se eu fosse trair a confiança dela e te contar tudo! Por mais precioso que você seja para mim, meu amigo, ela tem sido minha irmã de alma por muitos e muitos anos.",shape=box,color=blue];
		1849 -> 1852;
	1853 [label="Sim. Acho que ela vai ajudar a resolver as coisas entre o Loid e a família lá de cima. E isso é… enorme, Lyon. Acho que não consigo nem explicar o quão enorme é",shape=box,color=red];
		1853 -> 1862;
	1854 [label="Não… sinceramente, do jeito que as coisas ficaram, perdi qualquer chance que eu tinha de ela me ajudar a resolver as coisas entre o Loid e a família lá de cima",shape=box,color=red];
		1854 -> 1863;
	1858 [label="Não… sinceramente, do jeito que as coisas ficaram, perdi qualquer chance que eu tinha de ela me ajudar a resolver as coisas entre o Loid e a família lá de cima",shape=box,color=red];
		1858 -> 1866;
	1859 [label="Sim. Ela não vai me ajudar a consertar as coisas entre o Loid e a família lá de cima, e tudo bem pra mim",shape=box,color=red];
		1859 -> 1867;
	1860 [label="Sim. Fico feliz que ela tenha percebido que o Entrati talvez não seja puramente \"bom\", e… bem, ele também não é puramente \"mau\", né?",shape=box,color=red];
		1860 -> 1868;
	1855 [label="Tô satisfeito com a forma como as coisas terminaram. Sinceramente, quanto mais penso nisso, mais concordo com ela em relação ao Entrati",shape=box,color=red];
		1855 -> 1867;
	1856 [label="Não chegamos a um consenso sobre o Entrati. Não consegui convencer ela… só queria ter feito melhor",shape=box,color=red];
		1856 -> 1864;
	1857 [label="\"Concordamos em discordar\" sobre o Entrati, e acho que isso é o melhor que podemos esperar sobre o assunto. Não creio que mais conversa vá mudar alguma coisa",shape=box,color=red];
		1857 -> 1865;
	1861 [label="Sinceramente, tá tudo bem. Não acho que vá melhorar nem piorar por enquanto",shape=box,color=red];
		1861 -> 1865;
	1852 [label="Não, receio que as palavras dela para mim, permanecerão em segredo. Mas, mesmo assim, elas a comoveram. Fico pensando, você ficou satisfeito com a forma como isso deixou as coisas entre vocês?",shape=box,color=blue];
		1852 -> 1851;
	1862 [label="Acredito que consigo compreender a grandeza disso, senão a magnitude. Sinto-me… bastante honrado por fazer parte disso, mesmo que de uma forma pequena.",shape=box,color=blue];
		1862 -> 1869;
		1862 -> 1870;
	1863 [label="Fascinante… bem, você é o amante dela agora, não é? Se alguém neste lugar tivesse influência suficiente para convencê-la, seria você, certo?",shape=box,color=blue];
		1863 -> 1871;
	1866 [label="Fascinante… bem, sabe-se que tenho alguma… influência sobre ela, por mais limitada que seja. Você acha que essa reconciliação entre o Sr. Loid e a família distante do Entrati é importante?",shape=box,color=blue];
		1866 -> 1874;
		1866 -> 1875;
	1867 [label="Não consigo dizer se esse tom é de petulância, arrogância, ignorância ou apatia. Portanto, optarei por uma mistura dos quatro e seguirei com o meu dia. ",shape=box,color=blue];
		1867 -> 1876;
	1868 [label="Sim, eu compartilho da sua opinião. Não acredito que ele seja uma coisa ou outra, mas sim que suas motivações sejam complexas.",shape=box,color=blue];
		1868 -> 1877;
	1864 [label="Hmm. Bem, infelizmente, chega um momento em que tudo precisa ser deixado de lado. Uma massa pode ser trabalhada demais. Um artista pode exagerar na pintura. E uma discussão certamente pode se… prolongar demais.",shape=box,color=blue];
		1864 -> 1872;
	1865 [label="Sim, talvez seja melhor que os assuntos passem para temas mais… interessantes.",shape=box,color=blue];
