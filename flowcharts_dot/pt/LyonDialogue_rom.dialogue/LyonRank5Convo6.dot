		j17348121 -> "Chat ends.";
	j3815477014 [label="Não me orgulho exatamente de tudo que eu disse, mas… ",shape=box,color=red];
		j3815477014 -> j1653583498;
	j4262234742 [label="Ela te contou tudo, né?",shape=box,color=red];
		j4262234742 -> j2554649860;
	j1113353603 [label="Por favor, convença a Marie a parar de usar os Necramitas para replicar móveis. Eu já não sei o que fazer com todas essas cadeiras.",shape=box,color=blue];
		j1113353603 -> j4239683069;
	j1653583498 [label="Afinal, existe um motivo para a criação do termo \"crime passional\". Se nós, como seres humanos, não fôssemos fiéis às nossas crenças, a vida seria terrivelmente monótona, eu acho. ",shape=box,color=blue];
		j1653583498 -> j2528155203;
	j2554649860 [label="Sim, conversamos. Todas as noites, sobre o que aconteceu durante o dia. E, depois da nossa conversa, ela veio correndo até mim para me contar tudo o que achava.",shape=box,color=blue];
		j2554649860 -> j241685573;
		j2554649860 -> j333382993;
	j4239683069 [label="+20 Chemistry",color=orange];
		j4239683069 -> j1444129759;
	j2528155203 [label="Certamente mais silencioso. Mais tranquilo. Mas… sem graça. Com certeza não haveria arte digna.",shape=box,color=blue];
		j2528155203 -> j1326328722;
	j241685573 [label="O que ela te disse?",shape=box,color=red];
		j241685573 -> j3495933037;
	j333382993 [label="Então… e aí?",shape=box,color=red];
		j333382993 -> j3495933037;
	j1444129759 [label="E eu me recuso a aceitar as sugestões… pitorescas dela sobre onde, dentro da cabeça do Roathe, elas deveriam ser armazenadas.",shape=box,color=blue];
		j1444129759 -> "Chat ends.";
	j1326328722 [label="Mas estou me desviando do assunto. Em minhas conversas com ela, parece que suas palavras foram comoventes. Preciso perguntar: você ficou satisfeito com a forma como as coisas terminaram entre vocês? ",shape=box,color=blue];
		j1326328722 -> j1424199455;
