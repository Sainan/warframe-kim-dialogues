		j2877846046 -> j1332516863;
	j3946757805 [label="Embora eu precise sentar e pensar em como convencer o Roathe a mudar de ideia… o que não tenho certeza se conseguirei. E, sem ele, pode ser uma causa perdida.",shape=box,color=blue];
