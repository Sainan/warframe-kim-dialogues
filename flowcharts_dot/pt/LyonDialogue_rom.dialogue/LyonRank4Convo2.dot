digraph {
	781 [label="LyonRank4Convo2 begins.",color=orange];
		781 -> 782;
		781 -> 783;
		781 -> 784;
	782 [label="Como é que você e a Marie conseguem conciliar o fato de serem padre e freira, mas… cometem atos de violência?",shape=box,color=red];
		782 -> 785;
		782 -> 786;
		782 -> 787;
	783 [label="Posso te fazer uma pergunta um pouco… estranha, Lyon?",shape=box,color=red];
		783 -> 788;
	784 [label="[Encerrar Conversa]",shape=box,color=red];
		784 -> 789;
	785 [label="Escuto a Marie gritar \"païens!\" e correr pra briga, e… ainda assim, tenho dificuldade em imaginar ela como o tipo de pessoa que condenaria alguém por ter crenças diferentes. Não consigo imaginar que você seja muito diferente, ela claramente te considera muito",shape=box,color=red];
		785 -> 790;
	786 [label="Como sua igreja se sentiria em relação ao que você e a Marie fazem aqui? Em relação… ao que tão pedindo pra vocês fazerem em nome dela?",shape=box,color=red];
		786 -> 791;
	787 [label="Vejo você e a Marie no campo de batalha, depois converso com ela em particular e vejo você lendo livros em silêncio… e acho que tô tendo dificuldade em conciliar essas 2 pessoas na minha mente…",shape=box,color=red];
	788 [label="Se você considera a capacidade de descrever nossa situação atual simplesmente como \"estranha\", fico impressionado com sua força de vontade ou consternado com sua falta de vocabulário. Suspeito, no entanto, que seja a primeira opção. ",shape=box,color=blue];
		788 -> 793;
	789 [label="Chat ends.",color=orange];
	790 [label="Você tem toda a razão. A Marie não é do tipo que condena alguém por ter em seu coração um antigo deus das árvores; em vez disso, ela procuraria descobrir quais crenças compartilhava com essa pessoa.",shape=box,color=blue];
		790 -> 794;
	791 [label="Muitas guerras santas foram travadas em sua época em nome do Sol ou da Lua. Cruzadas sangrentas para expulsar os \"pagãos\", para \"conquistar a Terra Santa\" ou qualquer outro pretexto inventado que estivesse em voga na época.",shape=box,color=blue];
		791 -> 795;
	793 [label="+5 Chemistry",color=orange];
		793 -> 797;
	794 [label="Será que a árvore não é nutrida pela luz do Sol? Não haveria um terreno comum onde ela pudesse partilhar o pão com eles? Ela estaria mais disposta a sentar-se e ouvir as suas histórias do que a procurá-los prejudicar-lhes a sua fé. ",shape=box,color=blue];
		794 -> 798;
	795 [label="A Ortodoxia dos Luminários não possui exército e não trava guerras. Ela não impede que seus membros ajam ou protejam outros.",shape=box,color=blue];
		795 -> 727;
	797 [label="Ou seja, sim, prossiga. Você não pode tornar isso ainda mais \"estranho\" para mim perguntando o que quer que seja que esteja despertando sua curiosidade.",shape=box,color=blue];
		797 -> 785;
		797 -> 786;
		797 -> 787;
	798 [label="Quando ela enfrenta seus inimigos no campo de batalha, acredito que seja uma de duas coisas: ou ela está se divertindo um pouco, encenando o papel de uma antiga cruzada, imaginando-se na armadura brilhante de uma Cavaleira do Sol…",shape=box,color=blue];
		798 -> 796;
	727 [label="Quando a Marie enfrenta seus inimigos no campo de batalha, acredito que seja uma de duas coisas: ou ela está se divertindo um pouco, encenando o papel de uma antiga cruzada, imaginando-se na armadura brilhante de uma Cavaleira do Sol…",shape=box,color=blue];
		727 -> 796;
	796 [label="Ou, mais provavelmente, ela está se lembrando de Astafor 8:23: \"Solitárias são as almas que procuram entrar em minha casa pela violência, pois são elas que foram expulsas da luz do Sol.\"",shape=box,color=blue];
		796 -> 799;
	799 [label="Aos olhos dela, a violência que comete é justa em nome da defesa de um bem maior, assim como você. E presumo que também os vejam, assim como aqueles que lutam ao seu lado. ",shape=box,color=blue];
		799 -> 800;
	800 [label="E, portanto, aqueles contra quem ela luta, independentemente de sua religião, são expulsos pelo Sol. Mesmo que usem as vestes sagradas de sua própria ordem, aos seus olhos, são pagãos.",shape=box,color=blue];
		800 -> 801;
		800 -> 802;
	801 [label="Notei que você se excluiu disso… como você se sente em relação a tudo isso?",shape=box,color=red];
		801 -> 803;
	802 [label="Faz sentido, valeu",shape=box,color=red];
		802 -> 804;
	803 [label="Estou sendo propositalmente evasivo, Peregrino.",shape=box,color=blue];
		803 -> 805;
		803 -> 806;
	804 [label="+5 Chemistry",color=orange];
		804 -> 807;
	805 [label="E eu tô sendo propositalmente persistente, Padre",shape=box,color=red];
		805 -> 808;
	806 [label="Tudo bem, vou aceitar o que já consegui hoje",shape=box,color=red];
		806 -> 804;
	807 [label="Pelo que vale, a Marie… me disse que você tem boas intenções. E eu acredito nela, mesmo quando não acredito em mim mesmo.",shape=box,color=blue];
		807 -> 809;
	808 [label="+10 Chemistry",color=orange];
		808 -> 810;
	809 [label="No fim, tudo o que posso fazer é implorar pela sua paciência. A Lua sabe que, na maioria dos dias, eu também não tenho muita paciência comigo mesmo.",shape=box,color=blue];
		809 -> 811;
	810 [label="Muito bem. Se você não se deixar dissuadir, e está tão curioso… não me incomoda tanto a morte que causo quanto… talvez você esperasse o contrário.",shape=box,color=blue];
		810 -> 812;
	811 [label="- Padre Lyon Allard",shape=box,color=blue];
		811 -> 813;
	812 [label="Ou algo que alguém possa considerar \"apropriado\" para um homem da igreja e um erudito como eu. ",shape=box,color=blue];
		812 -> 814;
		812 -> 815;
	813 [label="Chat ends.",color=orange];
	814 [label="Vi mais guerras do que paz na minha vida, Lyon. Se eu deixasse isso me perturbar, acho que não estaria mais aqui. Mas isso não significa que não venha com um fardo real… um preço real a pagar",shape=box,color=red];
		814 -> 816;
	815 [label="Tenho certeza de que os outros já falaram quem eu sou e de onde eu vim. A morte que me persegue… a morte da qual eu vim, a morte que me define. Você acha que alguma coisa que você sente vai me surpreender?",shape=box,color=red];
		815 -> 817;
	816 [label="Add 1 to Thermostat",color=orange];
		816 -> 818;
	817 [label="Add -1 to Thermostat",color=orange];
		817 -> 819;
	818 [label="Sim, tem razão.",shape=box,color=blue];
		818 -> 820;
		818 -> 821;
	819 [label="Sim, acho que sim.",shape=box,color=blue];
		819 -> 820;
		819 -> 821;
	820 [label="Me desculpe, acho que te irritei. Essa não era minha intenção",shape=box,color=red];
		820 -> 822;
	821 [label="Você… poderia explicar?",shape=box,color=red];
		821 -> 823;
	822 [label="Você não tem culpa, Peregrino. Eu sou, como diriam nossos irmãos e irmãs da Libertátia, um \"osso duro de roer\".",shape=box,color=blue];
		822 -> 824;
	823 [label="Os horrores que ecoam em minha mente parecem não conhecer limites. Testemunho cadeias de tendões humanos que, outrora tingidas de um carmesim vivo, tornaram-se quebradiças e enegrecidas. ",shape=box,color=blue];
		823 -> 825;
	824 [label="Sou somente um indivíduo sitiado. Eu defendo a muralha. Abrir o portão significa ameaçar a integridade das defesas.",shape=box,color=blue];
		824 -> 826;
		824 -> 827;
	825 [label="Vejo 100.000 faces de mim mesmo, semelhantes, mas estranhas. Caixões vazios, cadáveres de carne humana retorcida e dilacerada, suspensos no véu entre a vida e a morte.",shape=box,color=blue];
		825 -> 828;
	826 [label="Entendo. Quando você estiver pronto, podemos falar sobre isso",shape=box,color=red];
		826 -> 829;
	827 [label="O que você quer dizer? ",shape=box,color=red];
		827 -> 823;
	828 [label="Expressões envoltas em uma máscara de vazio sereno. Mas nos resquícios fugazes de suas almas, brasas que persistem e não se extinguem, eu as ouço gritar. Uivando incessantemente por vingança. Por liberdade. ",shape=box,color=blue];
		828 -> 830;
	829 [label="Estou começando a ter a nítida impressão de que não tenho escolha nesta questão. ",shape=box,color=blue];
		829 -> 831;
	830 [label="Pela morte.",shape=box,color=blue];
		830 -> 832;
	831 [label="+15 Chemistry",color=orange];
		831 -> 833;
	832 [label="Essas visões me assombram durante o dia. Meus sonhos. Não tenho pesadelos, pois isso é tudo o que experimento… tudo em que me transformei.",shape=box,color=blue];
		832 -> 834;
	833 [label="Mas, pelo que vale, a Marie… me disse que você tem boas intenções. E eu acredito nela, mesmo quando não acredito em mim mesmo.",shape=box,color=blue];
		833 -> 835;
	834 [label="Check boolean LyonPainOff",color=orange];
		834 -> 836 [label=true,color=green];
		834 -> 837 [label=false,color=brown];
	835 [label="No fim, tudo o que posso fazer é implorar pela sua paciência. A Lua sabe que, na maioria dos dias, eu também não tenho muita paciência comigo mesmo.",shape=box,color=blue];
		835 -> 838;
	836 [label="Somente quando me entrego aos sussurros que ecoam em minha alma, o mundo se reflete para mim de uma maneira semelhante àquela que você talvez ache familiar. ",shape=box,color=blue];
		836 -> 839;
	837 [label="Somente quando arranco a carne do meu corpo como sacrifício aos sussurros que ecoam em minha alma, o mundo se reflete para mim de uma maneira semelhante àquela que você talvez ache familiar. ",shape=box,color=blue];
		837 -> 839;
	838 [label="- Padre Lyon Allard",shape=box,color=blue];
		838 -> 840;
	839 [label="Por favor, não finja saber o que eu \"sinto\", Peregrino. Temo que você tenha somente começado a entender.",shape=box,color=blue];
		839 -> 841;
		839 -> 842;
		839 -> 843;
	840 [label="Update boolean LyonVisions2d",color=orange];
		840 -> 844;
	841 [label="Eu… sinto muito. Não, eu não tinha noção",shape=box,color=red];
		841 -> 845;
	842 [label="E tem muito horror e dor que eu vi, e que você também não compreende, Lyon",shape=box,color=red];
		842 -> 846;
	843 [label="Peço desculpas se você achou que falei sem pensar. Mas eu quero entender… essas suas visões…",shape=box,color=red];
		843 -> 847;
	844 [label="Chat ends.",color=orange];
	845 [label="Sim. Bem, sobrevivi a esses longos anos. Tenho certeza de que aguentarei mais alguns. Você não precisa se preocupar muito.",shape=box,color=blue];
		845 -> 848;
	846 [label="Tenho quase certeza que sabe sim, pois vi parte disso refletido nas imagens deste lugar. Mas você se considera supremo? O conhecedor absoluto de todos os horrores e de todo o sofrimento?",shape=box,color=blue];
		846 -> 849;
		846 -> 850;
	847 [label="Sim. Bem, sobrevivi a esses longos anos. Tenho certeza de que aguentarei mais alguns. Você não precisa se preocupar muito.",shape=box,color=blue];
		847 -> 848;
	848 [label="Update boolean LyonVisions2a",color=orange];
		848 -> 851;
		848 -> 852;
	849 [label="Tô dizendo que talvez eu consiga me solidarizar mais com o que você tá passando do que você imagina",shape=box,color=red];
		849 -> 853;
	850 [label="Tô dizendo que passei por muita morte e horror, Lyon… então, não gosto que falem comigo de forma condescendente por causa disso",shape=box,color=red];
		850 -> 854;
	851 [label="O que você tá descrevendo, Lyon… essa visão começou antes ou depois de você se tornar um Protoframe?",shape=box,color=red];
		851 -> 855;
	852 [label="Vem cá, a gente pode falar disso de novo? Por favor?",shape=box,color=red];
		852 -> 856;
	853 [label="Update boolean LyonVisions2b",color=orange];
		853 -> 857;
	854 [label="Update boolean LyonVisions2c",color=orange];
		854 -> 858;
	855 [label="Se essa fosse uma pergunta tão simples quanto você pensa, eu não responderia hoje. Sinto a dor de cabeça chegando.",shape=box,color=blue];
		855 -> 859;
	856 [label="Estou começando a ter a nítida impressão de que não tenho escolha nesta questão. ",shape=box,color=blue];
		856 -> 859;
	857 [label="Pode parecer estranho para você que eu não esteja em busca de simpatia, Peregrino. O que eu busco são respostas, segurança, firmeza… onde tudo é ilusão e mentira.",shape=box,color=blue];
		857 -> 860;
		857 -> 861;
	858 [label="Permita-me, então, curvar-me aos seus pés. Louvá-lo por tudo o que suportou. Admiro como ainda mantém a sanidade diante de tudo o que testemunhou. ",shape=box,color=blue];
		858 -> 862;
	859 [label="+10 Chemistry",color=orange];
		859 -> 863;
	860 [label="Vou fazer o possível",shape=box,color=red];
		860 -> 864;
	861 [label="Talvez eu possa te ajudar com isso. Podemos falar sobre isso de novo? Por favor?",shape=box,color=red];
		861 -> 856;
	862 [label="E se maravilhe com o fato de você ainda reservar tempo para todos nós, que você considera tão inferiores perante sua posição privilegiada.",shape=box,color=blue];
		862 -> 865;
	863 [label="Mas, pelo que vale, a Marie… me disse que você tem boas intenções. E eu acredito nela, mesmo quando não acredito em mim mesmo.",shape=box,color=blue];
		863 -> 866;
	864 [label="+5 Chemistry",color=orange];
		864 -> 867;
	865 [label="Chat ends.",color=orange];
	866 [label="No fim, tudo o que posso fazer é implorar pela sua paciência. A Lua sabe que, na maioria dos dias, eu também não tenho muita paciência comigo mesmo.",shape=box,color=blue];
		866 -> 868;
	867 [label="Isso é tudo o que se pode pedir, não é? ",shape=box,color=blue];
		867 -> 869;
	868 [label="- Padre Lyon Allard",shape=box,color=blue];
		868 -> 870;
	869 [label="Chat ends.",color=orange];
	870 [label="Chat ends.",color=orange];
}