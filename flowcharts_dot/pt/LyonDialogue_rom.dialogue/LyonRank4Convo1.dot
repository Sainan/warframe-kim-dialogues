		j2702204293 -> j1303704292 [label="false",color=purple];
		j2702204293 -> j3241181332 [label="false",color=purple];
	j3357347946 [label="Como assim?",shape=box,color=blue];
		j3357347946 -> j3952327259;
	j2264712026 [label="Contarei a você a história do primeiro eclipse que presenciei em outra ocasião. Já está tarde por aqui. Ou talvez esteja mais cedo. Não sei ao certo.",shape=box,color=blue];
		j2264712026 -> j1544097519;
	j2880639191 [label="Não",shape=box,color=red];
		j2880639191 -> j4100387504;
	j507022828 [label="Já vi, não foi nada impressionante",shape=box,color=red];
		j507022828 -> j3821467052;
	j1303704292 [label="Já vi, foi ok",shape=box,color=red];
		j1303704292 -> j3821467052;
	j3241181332 [label="Já vi, foi incrível",shape=box,color=red];
		j3241181332 -> j3505152088;
	j1982618467 [label="Já vi. Acredite ou não, me deu uma baita megrim, mas foi incrível",shape=box,color=red];
		j1982618467 -> j549499748;
	j1104009540 [label="Já vi. Acredite ou não, me deu uma baita enxaqueca, mas foi incrível",shape=box,color=red];
		j1104009540 -> j549499748;
	j3952327259 [label="Essa frase te soa familiar: \"Pelas estradas vazias, procure pelo eclipse. Quando o Sol e a Lua se alinharem, os perdidos encontrarão o caminho de casa.\"",shape=box,color=red];
		j3952327259 -> j1700430797;
	j1544097519 [label="Boolean LyonFirstEclipse is now true.",color=orange];
		j1544097519 -> j1265457517;
		j1544097519 -> j1697059987;
	j4100387504 [label="Se você tiver a oportunidade, faça isso.",shape=box,color=blue];
		j4100387504 -> j3505152088;
	j3821467052 [label="Quem me dera poder compartilhar da sua impassibilidade diante do ocorrido…",shape=box,color=blue];
		j3821467052 -> j3505152088;
	j549499748 [label="Você deve ter sido tocado pelos Luminários, e a presença deles o dominou. Ou talvez eles quisessem puni-lo por algum grande pecado. Uma coisa ou outra. Heh.",shape=box,color=blue];
		j549499748 -> j182257526;
	j1700430797 [label="Celestinos 18:19, do 3º Livro Ortodoxo da Lua. Mas onde, em nome dos Luminários, você ouviu isso?",shape=box,color=blue];
		j1700430797 -> j4161956545;
		j1700430797 -> j1977100869;
