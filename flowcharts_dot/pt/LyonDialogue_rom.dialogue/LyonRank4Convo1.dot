		j1073023867 -> j3507990101 [label="DrifterFaithNoMITW",color=purple];
		j1073023867 -> j3507990101 [label="false",color=purple];
	j1509104081 [label="Receio que haja muitos assuntos que eu poderia abordar longamente. Mas não me interprete mal, eu ficaria feliz em fazê-lo, simplesmente não quero entediá-lo até as lágrimas. Por onde você gostaria de começar?",shape=box,color=blue];
		j1509104081 -> j1633583130;
		j1509104081 -> j2087081340;
	j3507990101 [label="Não, só tô curioso mesmo",shape=box,color=red];
		j3507990101 -> j2305594065;
	j1204584536 [label="Sou religioso. É semelhante à sua religião, embora você não a reconheça",shape=box,color=red];
		j1204584536 -> j2000809531;
	j909635460 [label="Sou religioso. Mas você não reconheceria nenhuma das nossas práticas",shape=box,color=red];
		j909635460 -> j3033112132;
	j1888011597 [label="Sou religioso. É uma crença pessoal, que não tem um nome específico",shape=box,color=red];
		j1888011597 -> j2637677228;
	j1658800361 [label="Sigo os passos do Sol, como a Marie",shape=box,color=red];
		j1658800361 -> j562704759;
	j1968090749 [label="Assim como você, eu sigo o caminho da Lua",shape=box,color=red];
		j1968090749 -> j562704759;
	j1625502655 [label="Sigo os Luminários, mas tento manter um caminho equilibrado",shape=box,color=red];
		j1625502655 -> j562704759;
	j1029550239 [label="Acredito que exista algo lá fora, mas não acho que as pessoas realmente possam saber as respostas de verdade",shape=box,color=red];
		j1029550239 -> j1484908101;
	j3358638268 [label="Não sou religioso, costumo achar que isso é uma muleta pra quem tem medo. Sem ofensas",shape=box,color=red];
		j3358638268 -> j383284539;
	j1086863280 [label="Não sou religioso, não vou dizer que não possa haver algo lá fora, mas não é algo que me preocupe",shape=box,color=red];
		j1086863280 -> j993129475;
	j626644488 [label="Não sou religioso. Acho que todos os deuses, até mesmo a Indiferença, são um produto da nossa imaginação. Sem ofensas",shape=box,color=red];
		j626644488 -> j221924138;
	j1633583130 [label="Poderia me contar sobre seus feriados?",shape=box,color=red];
		j1633583130 -> j3899013855;
	j2087081340 [label="Poderia me falar mais sobre o Sol e a Lua?",shape=box,color=red];
		j2087081340 -> j1897759245;
	j2305594065 [label="Check boolean LyonSuspicious",color=orange];
		j2305594065 -> j3841184875 [label=true,color=green];
		j2305594065 -> j2349004714 [label=false,color=brown];
	j2000809531 [label="+20 Chemistry",color=orange];
		j2000809531 -> j2513901704;
	j3033112132 [label="+20 Chemistry",color=orange];
		j3033112132 -> j3316293865;
	j2637677228 [label="E como você chegou a essa fé pessoal, se não se importa que eu pergunte? ",shape=box,color=blue];
		j2637677228 -> j1522570754;
		j2637677228 -> j3060575237;
		j2637677228 -> j644892344;
