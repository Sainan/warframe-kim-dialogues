	662 [label="Receio que haja muitos assuntos que eu poderia abordar longamente. Mas não me interprete mal, eu ficaria feliz em fazê-lo, simplesmente não quero entediá-lo até as lágrimas. Por onde você gostaria de começar?",shape=box,color=blue];
