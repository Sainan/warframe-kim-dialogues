	j993129475 [label="+20 Chemistry",color=orange];
		j993129475 -> j1968210358;
	j221924138 [label="Boolean LyonMITW2 is now true.",color=orange];
		j221924138 -> j775459619;
	j3899013855 [label="Boolean LyonLectureHolidays is now true.",color=orange];
		j3899013855 -> j3213026381;
	j1897759245 [label="Boolean LyonLectureSolLua is now true.",color=orange];
		j1897759245 -> j359704192;
	j3841184875 [label="Boolean DrifterLiar is now true.",color=orange];
		j3841184875 -> j1719896610;
	j2349004714 [label="Boolean LyonSuspicious is now true.",color=orange];
		j2349004714 -> j1719896610;
	j2513901704 [label="Fico pensando em quanto nossas crenças se influenciaram mutuamente, intencionalmente ou não, como pode ser o caso. ",shape=box,color=blue];
		j2513901704 -> j462944456;
	j3316293865 [label="Fascinante! Como estudioso da Igreja, espero que tenhamos tempo para aprender um com o outro detalhadamente sobre nossas respectivas crenças. ",shape=box,color=blue];
		j3316293865 -> j462944456;
	j1522570754 [label="É uma longa história",shape=box,color=red];
		j1522570754 -> j3609298863;
	j3060575237 [label="Estudei várias religiões diferentes, e nenhuma delas realmente me agradou. Acabei formando uma espécie de \"coleção peculiar\" da humanidade",shape=box,color=red];
		j3060575237 -> j3061243541;
	j644892344 [label="Acredito no que sinto, e não preciso de um prédio ou de um livro pra me dizer isso",shape=box,color=red];
		j644892344 -> j59146897;
	j2183512202 [label="Sério? Estou… surpreso. Surpreso, mas satisfeito. E não é de admirar que você esteja curioso, então. Nossos ensinamentos devem ser muito diferentes do que você conhece. Tanto tempo se passou.",shape=box,color=blue];
		j2183512202 -> j462944456;
	j2884916833 [label="Respeito isso. Há honra em reconhecer o que não podemos saber, em perceber a pequenez da condição humana. ",shape=box,color=blue];
		j2884916833 -> j462944456;
	j2423822018 [label="Acredite, não me ofendi. Em muitos casos, você tem toda a razão. ",shape=box,color=blue];
		j2423822018 -> j1308861447;
		j2423822018 -> j2380541636;
	j1968210358 [label="Confesso que sinto inveja por você não se preocupar com o que pode nos aguardar além do véu. Quem dera mais pessoas se preocupassem, nosso mundo teria conhecido mais paz em seus tempos. ",shape=box,color=blue];
		j1968210358 -> j462944456;
	j775459619 [label="Esse é um assunto sobre o qual eu gostaria de conversar longamente com você. Simplesmente não agora, em um momento em que não estou preparado para tal discussão. ",shape=box,color=blue];
		j775459619 -> j462944456;
	j3213026381 [label="Um ótimo ponto de partida. Conhecer uma cultura por meio de seus feriados é conhecer sua essência. Pois a forma como um povo celebra é a forma como será lembrado. Esses momentos são os mais preciosos para aqueles que os compartilham. ",shape=box,color=blue];
		j3213026381 -> j3484225270;
	j359704192 [label="Claro. Comecemos por aquilo que talvez você já saiba: o Sol e a Lua, são divindades que se transformam eternamente em seus aspectos.",shape=box,color=blue];
		j359704192 -> j3759318733;
	j1719896610 [label="Hum. Permita-me responder à sua curiosidade. Para não o aborrecer até às lágrimas, por onde gostaria de começar? ",shape=box,color=blue];
		j1719896610 -> j2087081340;
		j1719896610 -> j1633583130;
	j462944456 [label="E peço desculpas por não ter me mantido no assunto. Temo ter me desviado muito do tema em questão. ",shape=box,color=blue];
		j462944456 -> j107347196;
	j3609298863 [label="+20 Chemistry",color=orange];
		j3609298863 -> j1427397252;
	j3061243541 [label="+20 Chemistry",color=orange];
		j3061243541 -> j3307193953;
	j59146897 [label="+20 Chemistry",color=orange];
		j59146897 -> j1791299833;
	j1308861447 [label="Mas isso não significa que eu não tenha interesse em aprender",shape=box,color=red];
		j1308861447 -> j2765769231;
	j2380541636 [label="E no seu caso? ",shape=box,color=red];
		j2380541636 -> j771895097;
	j3484225270 [label="Nossos principais e mais comuns feriados são os Solstícios de Inverno e Verão, que marcam os dias mais curtos e mais longos do ano. ",shape=box,color=blue];
		j3484225270 -> j1889160770;
	j3759318733 [label="Aparecendo em muitas formas ao longo dos séculos para muitos crentes. Às vezes masculino, às vezes feminino. Mas sempre como o Sol e a Lua.",shape=box,color=blue];
		j3759318733 -> j3427108662;
		j3759318733 -> j35424700;
	j107347196 [label="Você queria saber mais sobre a Ortodoxia dos Luminários, não é? Para não te entediar até as lágrimas, por onde gostaria de começar?",shape=box,color=blue];
		j107347196 -> j2087081340;
		j107347196 -> j1633583130;
	j1427397252 [label="Hum. E é melhor contar isso a um amigo de confiança. Entendo perfeitamente. Além disso, você me procurou para obter informações, e não o contrário. ",shape=box,color=blue];
		j1427397252 -> j462944456;
	j3307193953 [label="Um vitral da alma. Quebrado quando separado, mas que bela imagem ele pinta quando montado. ",shape=box,color=blue];
		j3307193953 -> j462944456;
	j1791299833 [label="O mundo seria um lugar melhor se compartilhasse da sua fé. ",shape=box,color=blue];
		j1791299833 -> j462944456;
	j2765769231 [label="E por isso, elogio sua curiosidade e seu espírito erudito.",shape=box,color=blue];
		j2765769231 -> j462944456;
	j771895097 [label="Meu caso é… complexo. Mas não vou mentir e dizer que não houve medo. Embora a religião tenha trazido uma avalanche de medo para a minha vida, ela nunca o eliminou.",shape=box,color=blue];
		j771895097 -> j462944456;
	j1889160770 [label="Ambos os feriados são marcados por grandes banquetes, embora a distinção entre eles dependa de com quem você os compartilha. Enquanto o Solstício de Inverno é para ser compartilhado com a família e amigos próximos, o Solstício de Verão é para desconhecidos.",shape=box,color=blue];
		j1889160770 -> j2989249157;
		j1889160770 -> j171957467;
	j3427108662 [label="Ah, agora faz muito mais sentido",shape=box,color=red];
		j3427108662 -> j1886004240;
	j35424700 [label="[Deixá-lo continuar]",shape=box,color=red];
		j35424700 -> j3642147007;
	j2989249157 [label="Sério? Me conta mais sobre o Solstício de Verão",shape=box,color=red];
		j2989249157 -> j3134070471;
	j171957467 [label="Me conta mais sobre o Solstício de Inverno",shape=box,color=red];
		j171957467 -> j2448252460;
	j1886004240 [label="Sim, algumas seitas podem ser um pouco rigorosas na escolha da iconografia, declarando que o Sol \"deve\" ser de uma forma ou \"deve\" ser de outra, mas a Ortodoxia não reconhece isso como um fato.",shape=box,color=blue];
		j1886004240 -> j4033467199;
	j3642147007 [label="Cada um dos Luminários contém em si múltiplos aspectos. Cada aspecto pode ser visto como uma função do todo. A Lua, por exemplo, é a mãe, a donzela, a anciã.",shape=box,color=blue];
		j3642147007 -> j1591118220;
	j3134070471 [label="O Solstício de Verão é para compartilhar grandes farturas e reunir estranhos que nunca se viram. Vocês se reuniriam em um campo, trazendo comida e produtos de sua própria autoria, não importando o quê. ",shape=box,color=blue];
		j3134070471 -> j4281578372;
	j2448252460 [label="O Solstício de Inverno serve para nos fortalecermos contra o frio e valorizarmos aqueles que nos aquecem nos momentos mais sombrios. Decoramos uma árvore com velas, uma luz para cada um daqueles que partiram antes de nós e que nos guiam como as estrelas no céu. ",shape=box,color=blue];
		j2448252460 -> j4208019492;
	j4033467199 [label="Presumo que tudo o que sobreviveu até este futuro distante acabou sendo… um tanto confuso em sua documentação da minha religião.",shape=box,color=blue];
		j4033467199 -> j866196224;
	j1591118220 [label="Mas a Lua também pode ser aquela que guia as almas pelo rio de lágrimas até a noite eterna. A própria Morte. O arauto e mensageiro.",shape=box,color=blue];
		j1591118220 -> j2897597405;
	j4281578372 [label="Velas, pão, roupas ou pinturas. Ou livros de poesia. Ou coroas de flores. Mesmo chegar de mãos vazias, mas \"com boas novas\", deve ser visto como uma bênção. ",shape=box,color=blue];
		j4281578372 -> j2958585837;
	j4208019492 [label="E acima de tudo, o próprio Sol, sofrendo no topo da árvore estelar na escuridão. Ofuscado, mas não esquecido. Pois este é o tempo da Lua. E nós a celebramos neste tempo de sombra.",shape=box,color=blue];
		j4208019492 -> j301042021;
	j866196224 [label="Me considero uma relíquia arqueológica viva. Que deprimente. Mas estou divagando. ",shape=box,color=blue];
		j866196224 -> j3642147007;
	j2897597405 [label="E em outras seitas, a morte é uma velha mulher de véu. Varia, mas fala do mesmo espírito que se estende a todos nós. A mão prateada que deseja nos guiar naquele último momento.",shape=box,color=blue];
		j2897597405 -> j3599001940;
	j2958585837 [label="Uma celebração da vida. Risos, música, partilha de todas essas coisas, começaria naquele que seria o mais longo dos dias do Sol. ",shape=box,color=blue];
		j2958585837 -> j1266784669;
	j301042021 [label="E enquanto nos aproximamos, e nos banqueteamos com um frango assado, legumes de raiz e tudo o que não cresce fresco na terra congelada, abraçamos aqueles que amamos. E contamos histórias daqueles que se foram.",shape=box,color=blue];
		j301042021 -> j334675470;
	j3599001940 [label="A Lua que se encobre o sol durante o eclipse, guiando-nos através da encruzilhada naquele momento em que tudo parece perdido. ",shape=box,color=blue];
		j3599001940 -> j1402025786;
	j1266784669 [label="Todos eram bem-vindos para fazer novas amizades com estranhos e levar para casa o que precisassem. ",shape=box,color=blue];
		j1266784669 -> j3651669694;
	j334675470 [label="Na noite mais longa da Lua, lembramos que ela nos guiará, a nós e à nossa família, até o fim.",shape=box,color=blue];
		j334675470 -> j3651669694;
	j1402025786 [label="Boolean DrifterEclipse is now true.",color=orange];
		j1402025786 -> j1704025367;
	j3651669694 [label="Mas o feriado mais sagrado para os Luminários é o Summum Bonum. É um evento raro, quando o Sol e Lua se alinham em um eclipse perfeito.",shape=box,color=blue];
		j3651669694 -> j1841351967;
	j1704025367 [label="Check boolean VelimirEclipse",color=orange];
		j1704025367 -> j562594872 [label=true,color=green];
		j1704025367 -> j3820135995 [label=false,color=brown];
	j1841351967 [label="É uma ocasião maravilhosa e sagrada, onde toda a natureza responde. Você já teve a sorte de testemunhá-lo pessoalmente? ",shape=box,color=blue];
		j1841351967 -> j1351788480;
	j562594872 [label="Peraí…",shape=box,color=red];
		j562594872 -> j377055918;
	j3820135995 [label="Você já presenciou um eclipse pessoalmente? ",shape=box,color=red];
		j3820135995 -> j3505152088;
	j1351788480 [label="Boolean DrifterEclipse is now true.",color=orange];
		j1351788480 -> j2702204293;
	j377055918 [label="Isso me soa… muito familiar",shape=box,color=red];
		j377055918 -> j3357347946;
	j3505152088 [label="Tive a bênção de presenciá-lo duas vezes. E em ambas as ocasiões, achei… transformador. Se pudesse permanecer naquele breve momento, suspenso ali para sempre, eu o faria.",shape=box,color=blue];
		j3505152088 -> j2264712026;
	j2702204293 [label="Evaluate expressions",color=orange];
		j2702204293 -> j2880639191 [label="Megrim",color=purple];
		j2702204293 -> j507022828 [label="Megrim",color=purple];
		j2702204293 -> j1303704292 [label="Megrim",color=purple];
		j2702204293 -> j3241181332 [label="Megrim",color=purple];
		j2702204293 -> j1982618467 [label="Megrim",color=purple];
		j2702204293 -> j2880639191 [label="Migraine",color=purple];
		j2702204293 -> j507022828 [label="Migraine",color=purple];
		j2702204293 -> j1303704292 [label="Migraine",color=purple];
		j2702204293 -> j3241181332 [label="Migraine",color=purple];
		j2702204293 -> j1104009540 [label="Migraine",color=purple];
