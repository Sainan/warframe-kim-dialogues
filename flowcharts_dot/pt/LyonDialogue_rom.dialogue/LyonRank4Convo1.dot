		700 -> 710;
	701 [label="Fico pensando em quanto nossas crenças se influenciaram mutuamente, intencionalmente ou não, como pode ser o caso. ",shape=box,color=blue];
		701 -> 704;
	698 [label="Fascinante! Como estudioso da Igreja, espero que tenhamos tempo para aprender um com o outro detalhadamente sobre nossas respectivas crenças. ",shape=box,color=blue];
		698 -> 704;
	695 [label="É uma longa história",shape=box,color=red];
		695 -> 707;
	696 [label="Estudei várias religiões diferentes, e nenhuma delas realmente me agradou. Acabei formando uma espécie de \"coleção peculiar\" da humanidade",shape=box,color=red];
		696 -> 708;
	697 [label="Acredito no que sinto, e não preciso de um prédio ou de um livro pra me dizer isso",shape=box,color=red];
		697 -> 709;
	690 [label="Sério? Estou… surpreso. Surpreso, mas satisfeito. E não é de admirar que você esteja curioso, então. Nossos ensinamentos devem ser muito diferentes do que você conhece. Tanto tempo se passou.",shape=box,color=blue];
		690 -> 704;
	691 [label="Respeito isso. Há honra em reconhecer o que não podemos saber, em perceber a pequenez da condição humana. ",shape=box,color=blue];
		691 -> 704;
	692 [label="Acredite, não me ofendi. Em muitos casos, você tem toda a razão. ",shape=box,color=blue];
		692 -> 705;
		692 -> 706;
	693 [label="Confesso que sinto inveja por você não se preocupar com o que pode nos aguardar além do véu. Quem dera mais pessoas se preocupassem, nosso mundo teria conhecido mais paz em seus tempos. ",shape=box,color=blue];
		693 -> 704;
	694 [label="Esse é um assunto sobre o qual eu gostaria de conversar longamente com você. Simplesmente não agora, em um momento em que não estou preparado para tal discussão. ",shape=box,color=blue];
		694 -> 704;
	688 [label="Um ótimo ponto de partida. Conhecer uma cultura por meio de seus feriados é conhecer sua essência. Pois a forma como um povo celebra é a forma como será lembrado. Esses momentos são os mais preciosos para aqueles que os compartilham. ",shape=box,color=blue];
		688 -> 702;
	689 [label="Claro. Comecemos por aquilo que talvez você já saiba: o Sol e a Lua, são divindades que se transformam eternamente em seus aspectos.",shape=box,color=blue];
		689 -> 703;
	710 [label="Hum. Permita-me responder à sua curiosidade. Para não o aborrecer até às lágrimas, por onde gostaria de começar? ",shape=box,color=blue];
		710 -> 665;
		710 -> 664;
	704 [label="E peço desculpas por não ter me mantido no assunto. Temo ter me desviado muito do tema em questão. ",shape=box,color=blue];
		704 -> 714;
	707 [label="+20 Chemistry",color=orange];
		707 -> 717;
	708 [label="+20 Chemistry",color=orange];
		708 -> 718;
	709 [label="+20 Chemistry",color=orange];
		709 -> 719;
	705 [label="Mas isso não significa que eu não tenha interesse em aprender",shape=box,color=red];
		705 -> 715;
	706 [label="E no seu caso? ",shape=box,color=red];
		706 -> 716;
	702 [label="Nossos principais e mais comuns feriados são os Solstícios de Inverno e Verão, que marcam os dias mais curtos e mais longos do ano. ",shape=box,color=blue];
		702 -> 711;
	703 [label="Aparecendo em muitas formas ao longo dos séculos para muitos crentes. Às vezes masculino, às vezes feminino. Mas sempre como o Sol e a Lua.",shape=box,color=blue];
		703 -> 712;
		703 -> 713;
	714 [label="Você queria saber mais sobre a Ortodoxia dos Luminários, não é? Para não te entediar até as lágrimas, por onde gostaria de começar?",shape=box,color=blue];
		714 -> 665;
		714 -> 664;
	717 [label="Hum. E é melhor contar isso a um amigo de confiança. Entendo perfeitamente. Além disso, você me procurou para obter informações, e não o contrário. ",shape=box,color=blue];
		717 -> 704;
	718 [label="Um vitral da alma. Quebrado quando separado, mas que bela imagem ele pinta quando montado. ",shape=box,color=blue];
		718 -> 704;
	719 [label="O mundo seria um lugar melhor se compartilhasse da sua fé. ",shape=box,color=blue];
		719 -> 704;
	715 [label="E por isso, elogio sua curiosidade e seu espírito erudito.",shape=box,color=blue];
		715 -> 704;
	716 [label="Meu caso é… complexo. Mas não vou mentir e dizer que não houve medo. Embora a religião tenha trazido uma avalanche de medo para a minha vida, ela nunca o eliminou.",shape=box,color=blue];
		716 -> 704;
	711 [label="Ambos os feriados são marcados por grandes banquetes, embora a distinção entre eles dependa de com quem você os compartilha. Enquanto o Solstício de Inverno é para ser compartilhado com a família e amigos próximos, o Solstício de Verão é para desconhecidos.",shape=box,color=blue];
		711 -> 720;
		711 -> 721;
	712 [label="Ah, agora faz muito mais sentido",shape=box,color=red];
		712 -> 722;
	713 [label="[Deixá-lo continuar]",shape=box,color=red];
		713 -> 723;
	720 [label="Sério? Me conta mais sobre o Solstício de Verão",shape=box,color=red];
		720 -> 724;
	721 [label="Me conta mais sobre o Solstício de Inverno",shape=box,color=red];
		721 -> 725;
	722 [label="Sim, algumas seitas podem ser um pouco rigorosas na escolha da iconografia, declarando que o Sol \"deve\" ser de uma forma ou \"deve\" ser de outra, mas a Ortodoxia não reconhece isso como um fato.",shape=box,color=blue];
		722 -> 726;
	723 [label="Cada um dos Luminários contém em si múltiplos aspectos. Cada aspecto pode ser visto como uma função do todo. A Lua, por exemplo, é a mãe, a donzela, a anciã.",shape=box,color=blue];
		723 -> 731;
	724 [label="O Solstício de Verão é para compartilhar grandes farturas e reunir estranhos que nunca se viram. Vocês se reuniriam em um campo, trazendo comida e produtos de sua própria autoria, não importando o quê. ",shape=box,color=blue];
		724 -> 728;
	725 [label="O Solstício de Inverno serve para nos fortalecermos contra o frio e valorizarmos aqueles que nos aquecem nos momentos mais sombrios. Decoramos uma árvore com velas, uma luz para cada um daqueles que partiram antes de nós e que nos guiam como as estrelas no céu. ",shape=box,color=blue];
		725 -> 729;
	726 [label="Presumo que tudo o que sobreviveu até este futuro distante acabou sendo… um tanto confuso em sua documentação da minha religião.",shape=box,color=blue];
		726 -> 730;
	731 [label="Mas a Lua também pode ser aquela que guia as almas pelo rio de lágrimas até a noite eterna. A própria Morte. O arauto e mensageiro.",shape=box,color=blue];
		731 -> 734;
	728 [label="Velas, pão, roupas ou pinturas. Ou livros de poesia. Ou coroas de flores. Mesmo chegar de mãos vazias, mas \"com boas novas\", deve ser visto como uma bênção. ",shape=box,color=blue];
		728 -> 732;
	729 [label="E acima de tudo, o próprio Sol, sofrendo no topo da árvore estelar na escuridão. Ofuscado, mas não esquecido. Pois este é o tempo da Lua. E nós a celebramos neste tempo de sombra.",shape=box,color=blue];
		729 -> 733;
	730 [label="Me considero uma relíquia arqueológica viva. Que deprimente. Mas estou divagando. ",shape=box,color=blue];
		730 -> 723;
	734 [label="E em outras seitas, a morte é uma velha mulher de véu. Varia, mas fala do mesmo espírito que se estende a todos nós. A mão prateada que deseja nos guiar naquele último momento.",shape=box,color=blue];
		734 -> 737;
	732 [label="Uma celebração da vida. Risos, música, partilha de todas essas coisas, começaria naquele que seria o mais longo dos dias do Sol. ",shape=box,color=blue];
		732 -> 735;
	733 [label="E enquanto nos aproximamos, e nos banqueteamos com um frango assado, legumes de raiz e tudo o que não cresce fresco na terra congelada, abraçamos aqueles que amamos. E contamos histórias daqueles que se foram.",shape=box,color=blue];
		733 -> 736;
	737 [label="A Lua que se encobre o sol durante o eclipse, guiando-nos através da encruzilhada naquele momento em que tudo parece perdido. ",shape=box,color=blue];
		737 -> 739;
	735 [label="Todos eram bem-vindos para fazer novas amizades com estranhos e levar para casa o que precisassem. ",shape=box,color=blue];
		735 -> 738;
	736 [label="Na noite mais longa da Lua, lembramos que ela nos guiará, a nós e à nossa família, até o fim.",shape=box,color=blue];
		736 -> 738;
	739 [label="Update boolean DrifterEclipse",color=orange];
		739 -> 741;
	738 [label="Mas o feriado mais sagrado para os Luminários é o Summum Bonum. É um evento raro, quando o Sol e Lua se alinham em um eclipse perfeito.",shape=box,color=blue];
		738 -> 740;
	741 [label="Check boolean VelimirEclipse",color=orange];
		741 -> 744 [label=true,color=green];
		741 -> 743 [label=false,color=brown];
	740 [label="É uma ocasião maravilhosa e sagrada, onde toda a natureza responde. Você já teve a sorte de testemunhá-lo pessoalmente? ",shape=box,color=blue];
		740 -> 742;
	744 [label="Peraí…",shape=box,color=red];
