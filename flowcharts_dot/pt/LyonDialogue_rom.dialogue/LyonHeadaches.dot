		j3222343181 -> j3339833129;
	j3004437113 [label="É um assunto pessoal, Peregrino. Agradeço sua tentativa de conversar comigo. E agradeço o fato de eu não ser… a criatura mais afável com quem você possa interagir.",shape=box,color=blue];
