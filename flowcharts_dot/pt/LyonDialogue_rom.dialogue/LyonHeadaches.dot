		j235091773 -> j1021699327;
	j4093238643 [label="Imagino que essa seja a palavra usada hoje em dia para as fortes dores de cabeça que eu também tenho. Não consigo imaginar que ficar olhando para o brilho desse aparelho ajude. Você deveria ir se deitar.",shape=box,color=blue];
