		j1967441138 -> j1542190422;
	j1053193766 [label="Tudo o que eu conhecia foi varrido pelos raios brilhantes da \"Luz da Jade\", do \"Império Orokin\" e do \"Void\", e está ameaçado pelo \"Murmúrio\".",shape=box,color=blue];
		j1053193766 -> j1072000638;
	j2556896059 [label="Como você pode ver, estou completamente recuperado. E agora, você precisa se preocupar consigo mesmo. Agora, vá encontrar um lugar escuro para se recuperar.",shape=box,color=blue];
		j2556896059 -> j4144512823;
	j3339833129 [label="Posso ser franco e perguntar por que você está tentando socializar comigo?",shape=box,color=blue];
