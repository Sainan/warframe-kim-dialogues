		j3339833129 -> j1194447944;
		j3339833129 -> j191791765;
		j3339833129 -> j573886825;
	j1072000638 [label="Portanto, peço desculpas se achar esta… oferta de ajuda da sua parte estranhamente risível em sua ingenuidade. Não te conheço, nem confio em você. Na verdade, tudo o que tenho é a palavra de terceiros.",shape=box,color=blue];
		j1072000638 -> j4189315031;
	j4144512823 [label="Suma daqui, Peregrino. Antes que eu te encontre e te obrigue a descansar. E nenhum de nós vai gostar disso.",shape=box,color=blue];
		j4144512823 -> j1931485572;
		j4144512823 -> j3814169658;
	j4234273114 [label="Pra ser sincero, não consigo parar de pensar em você desde que nos conhecemos",shape=box,color=red];
		j4234273114 -> j2905931503;
	j1194447944 [label="O Entrati transformou vocês em Protoframes e agora vocês tão aqui do nada, sem qualquer preparação. Se puder, quero ajudar vocês a se adaptarem de alguma forma",shape=box,color=red];
		j1194447944 -> j1542190422;
	j191791765 [label="Bem… acho você fascinante, quero te conhecer melhor",shape=box,color=red];
		j191791765 -> j1542190422;
	j4189315031 [label="A palavra de outros que eu também não conheço, nem confio ainda. Tudo isso nos é imposto, sem falar dos fardos que você não vê.",shape=box,color=blue];
		j4189315031 -> j3524698154;
