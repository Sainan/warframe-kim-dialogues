		j106665696 -> "Chat ends.";
	j497470533 [label="Mudei de ideia a seu respeito",shape=box,color=red];
		j497470533 -> j4092880092;
	j1900853342 [label="Sinto que tem coisa sendo bloqueada pela falta de ouvir suas histórias",shape=box,color=red];
		j1900853342 -> j822495078;
	j2964761852 [label="Mas percebo que meu incômodo com suas palavras diminui, agora que sei das medidas absolutamente bizarras que você toma para me ter ao seu lado.",shape=box,color=blue];
