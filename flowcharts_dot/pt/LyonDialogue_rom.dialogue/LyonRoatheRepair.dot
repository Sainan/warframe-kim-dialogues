		"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
	j4092880092 [label="Então, não me resta outra opção senão te perdoar. ",shape=box,color=blue];
		j4092880092 -> j106665696;
	j3345139252 [label="E o que mudou para que você se importe de repente, quando antes não se importava?",shape=box,color=blue];
		j3345139252 -> j497470533;
		j3345139252 -> j1900853342;
	j1692087386 [label="Não me resta outra opção senão perdoar-te, claro. Não sei por que queres que uma coisa tão quebrada como eu ocupe espaço nos teus negócios.",shape=box,color=blue];
		j1692087386 -> j2964761852;
