	j347112513 [label="Você realmente se viu tão sem opções que recorreu a pedir ao Roathe que me importunasse, em seu nome, para… considerar um pedido de desculpas?",shape=box,color=blue];
		j347112513 -> j3690881643;
	j3254339216 [label="Você realmente se viu tão sem opções que recorreu a pedir ao Roathe que me importunasse, em seu nome, para que o Sr. Loid fosse chamado para o andar de cima?",shape=box,color=blue];
		j3254339216 -> j4096235569;
	j66466953 [label="Você realmente se viu tão sem opções que recorreu a pedir ao Roathe que me importunasse, em seu nome?",shape=box,color=blue];
		j66466953 -> j103913526;
	"Chat ends." [color=orange];
	j3690881643 [label="Você percebe o quão ridículo isso soa, não é?",shape=box,color=blue];
		j3690881643 -> j3103580512;
		j3690881643 -> j2605956978;
	j4096235569 [label="Não quero perder mais tempo do que já perdi ouvindo seus argumentos. Direi simplesmente: muito bem.",shape=box,color=blue];
		j4096235569 -> j2169173578;
	j103913526 [label="A questão, se não me engano, era que você não queria se aprofundar no meu passado. Agora, parece que você mudou de ideia?",shape=box,color=blue];
		j103913526 -> j3882370560;
	j3103580512 [label="Eu não sabia que ele tinha dito que eu me desculparia…",shape=box,color=red];
		j3103580512 -> j3690260102;
	j2605956978 [label="Eu não sabia mais o que fazer… sei que, olhando melhor agora, é ridículo",shape=box,color=red];
		j2605956978 -> j2152849344;
	j2169173578 [label="Check boolean MarieFamilyFail",color=orange];
		j2169173578 -> j3690938775 [label=true,color=green];
		j2169173578 -> j929751466 [label=false,color=brown];
	j3882370560 [label="Não entendo. Não podemos voltar atrás. Essas águas não podem ser percorridas novamente.",shape=box,color=blue];
		j3882370560 -> j2044258621;
		j3882370560 -> j1182403499;
	j3690260102 [label="Entendo.",shape=box,color=blue];
		j3690260102 -> "Chat ends.";
	j2152849344 [label="Admito que o caráter cômico da situação foi um dos motivos que me levaram a investigar. Você está tão angustiado assim? Não consigo imaginar que a ausência da minha companhia em sua vida seja algo tão terrível.",shape=box,color=blue];
		j2152849344 -> j2743373096;
	j3690938775 [label="Terá a minha ajuda conforme solicitado. Lamento o que o seu diabo fará a seguir com a Marie.",shape=box,color=blue];
		j3690938775 -> j92487004;
	j929751466 [label="Terá a minha ajuda, conforme solicitado. Agora, por favor, cesse o seu ataque, diabo.",shape=box,color=blue];
		j929751466 -> j770168571;
	j2044258621 [label="Ah… bom… então, isso foi uma enorme perda de tempo, né?",shape=box,color=red];
		j2044258621 -> "Chat ends.";
	j1182403499 [label="Acho que… vou só pedir desculpas, então… por não ter te escutado",shape=box,color=red];
		j1182403499 -> j2947317129;
	j2743373096 [label="Sim, Lyon… eu me importo muito com você, e sei que errei feio",shape=box,color=red];
		j2743373096 -> j2949340465;
	j92487004 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j92487004 -> j547953661;
	j770168571 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j770168571 -> j3711686580;
	j2947317129 [label="Posso perguntar por que você não o fez? Você tinha medo do assunto? Talvez estivesse entediado? Ou achou que não era forte o suficiente para suportá-lo?",shape=box,color=blue];
		j2947317129 -> j629782554;
		j2947317129 -> j4187267122;
		j2947317129 -> j3127716958;
	j2949340465 [label="E eu sinto muito, muito mesmo",shape=box,color=red];
