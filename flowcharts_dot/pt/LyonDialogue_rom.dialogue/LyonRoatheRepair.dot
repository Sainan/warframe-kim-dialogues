		j547953661 -> "Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j3711686580 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j3711686580 -> "Chat ends.";
	j629782554 [label="Eu tinha medo disso",shape=box,color=red];
		j629782554 -> j4092880092;
	j4187267122 [label="Não me achava forte o suficiente pra enfrentar isso",shape=box,color=red];
		j4187267122 -> j4092880092;
	j3127716958 [label="Antes, eu não ligava… mas agora me importo",shape=box,color=red];
