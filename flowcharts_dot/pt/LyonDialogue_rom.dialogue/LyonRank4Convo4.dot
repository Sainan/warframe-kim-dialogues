		1063 -> 1064;
	1062 [label="Minhas visões e as vozes frequentemente me levavam a ataques violentos, Peregrino. Muitas vezes, eu pegava uma faca para cortar minha própria carne, pois a dor era a única coisa que me despertava.",shape=box,color=blue];
