	j1869534147 [label="Não, me perdoe. Eu… peço desculpas pela forma inadequada como estou lidando com tudo isso.",shape=box,color=blue];
		j1869534147 -> j2433132819;
	j3352485992 [label="Lyon, se preferir que eu simplesmente vá embora, por favor, fala na lata",shape=box,color=red];
		j3352485992 -> j966362997;
	j2395792793 [label="Você não tá facilitando as coisas…",shape=box,color=red];
		j2395792793 -> j1869534147;
	j2306043641 [label="+5 Chemistry",color=orange];
		j2306043641 -> j3602484535;
	j2057676521 [label="Você já decidiu qual caminho seguir? Ou seus nervos estão simplesmente mais à flor da pele do que os meus?",shape=box,color=blue];
		j2057676521 -> j1889305065;
		j2057676521 -> j2031966384;
	j4126731842 [label="+5 Chemistry",color=orange];
		j4126731842 -> j1720007862;
	j2433132819 [label="Muitas vezes, não tenho certeza de como responder adequadamente em situações como a simples curiosidade sobre a história de alguém, ou mesmo expressões inocentes de amizade.",shape=box,color=blue];
		j2433132819 -> j1484898814;
	j966362997 [label="+5 Chemistry",color=orange];
		j966362997 -> j1869534147;
	j3602484535 [label="Sim, e é esse sentimento que… me deixa cada vez mais apreensivo, devo admitir. Para minha tranquilidade, basta confirmar que você está falando sério, o que eu cada vez mais temo que possa estar.",shape=box,color=blue];
		j3602484535 -> j4240879469;
		j3602484535 -> j3871203530;
	j1889305065 [label="Foi mal por ter te ignorado antes…",shape=box,color=red];
		j1889305065 -> j1220620591;
	j2031966384 [label="O que você quer dizer?",shape=box,color=red];
		j2031966384 -> j1220620591;
	j1720007862 [label="Devo admitir que… a sua escolha de palavras me deixa apreensivo. Embora eu não saiba se você as quer dizer da maneira como as estou interpretando.",shape=box,color=blue];
		j1720007862 -> j4240879469;
		j1720007862 -> j3871203530;
	j1484898814 [label="Independentemente disso, você estava perguntando sobre o meu passado, certo?",shape=box,color=blue];
		j1484898814 -> j3626198077;
	j4240879469 [label="Então, vou te tranquilizar: não tenho sentimentos por você",shape=box,color=red];
		j4240879469 -> j3560490080;
	j3871203530 [label="É tão difícil pra você acreditar que eu possa gostar de você, Lyon?",shape=box,color=red];
		j3871203530 -> j3467240423;
	j1220620591 [label="Você abandonou a busca com o mesmo fervor com que a iniciou. Presumi que você tivesse concluído, acertadamente, que era uma má decisão. ",shape=box,color=blue];
		j1220620591 -> j1776361869;
		j1220620591 -> j3037310359;
	j3626198077 [label="Provavelmente você já deve ter percebido que eu tenho… visões. Isso faz parte da minha vida, desde que eu era criança.",shape=box,color=blue];
		j3626198077 -> j3729022387;
	j3560490080 [label="Não era minha intenção te rejeitar, mas é bom saber qual é a nossa situação. Eu… peço desculpas pela forma inadequada como estou lidando com tudo isso.",shape=box,color=blue];
		j3560490080 -> j2433132819;
	j3467240423 [label="Boolean DrifterLyon is now true.",color=orange];
		j3467240423 -> j236808182;
	j1776361869 [label="Você tem razão, melhor parar aqui",shape=box,color=red];
		j1776361869 -> j3659038003;
	j3037310359 [label="Eu só não tinha certeza se meu diálogo seria bem-vindo",shape=box,color=red];
		j3037310359 -> j3806435064;
	j3729022387 [label="Essas visões, para dizer o mínimo, raramente foram agradáveis. ",shape=box,color=blue];
		j3729022387 -> j3268151988;
		j3729022387 -> j1842224568;
		j3729022387 -> j1245624080;
	j236808182 [label="Resumindo? Bem, sim. Eu… não quero rejeitar seus esforços. Eu simplesmente… não estou acostumado a… demonstrações de afeto, Peregrino. Nenhuma.",shape=box,color=blue];
		j236808182 -> j3543309049;
	j3659038003 [label="Eu já imaginava. Portanto, desejo-lhe um bom resto de dia. ",shape=box,color=blue];
		j3659038003 -> "Chat ends.";
	j3806435064 [label="+5 Chemistry",color=orange];
		j3806435064 -> j2943231231;
	j3268151988 [label="E você acha que as visões vieram da Lua?",shape=box,color=red];
