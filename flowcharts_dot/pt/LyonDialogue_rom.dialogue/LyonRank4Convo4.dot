	j3385775113 [label="Por que você acha que isso seria perda de tempo?",shape=box,color=red];
		j3385775113 -> j3176470071;
	j2690857265 [label="Pra mim, não é perda de tempo, Lyon. Eu adoraria te conhecer melhor",shape=box,color=red];
		j2690857265 -> j1584197471;
	j897387759 [label="Deixa pra lá, então. Se você não quiser, não vou te forçar",shape=box,color=red];
		j897387759 -> j1869534147;
	j3176470071 [label="Eu simplesmente acho que existem maneiras melhores para você gastar suas energias. Como defender algum bastião contra um grupo inimigo invasor, descobrir coisas… ou separar roupas.",shape=box,color=blue];
