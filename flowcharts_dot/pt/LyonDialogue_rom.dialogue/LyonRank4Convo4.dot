	j1245624080 [label="Elas te assustaram?",shape=box,color=red];
		j1245624080 -> j581744993;
	j3543309049 [label="Se você está decidido a seguir este caminho, não o impedirei… e eu também já achei isso tão instável e… estranho?",shape=box,color=blue];
		j3543309049 -> j2241726227;
	j2943231231 [label="Elas não são… indesejáveis, em si? Elas são simplesmente… intrigantes, pelo simples fato de existirem.",shape=box,color=blue];
		j2943231231 -> j693160245;
		j2943231231 -> j3871203530;
	j1071395422 [label="Certa vez, acordei no meio da noite e me deparei com a imagem de uma senhora sentada aos pés da minha cama. ",shape=box,color=blue];
		j1071395422 -> j3904380749;
	j581744993 [label="Certa vez, acordei no meio da noite e me deparei com a imagem de uma senhora sentada aos pés da minha cama. ",shape=box,color=blue];
		j581744993 -> j4060921129;
	j2241726227 [label="+5 Chemistry",color=orange];
		j2241726227 -> j112921882;
	j693160245 [label="Você quer que eu pare?",shape=box,color=red];
		j693160245 -> j680096311;
	j3904380749 [label="Tão magra e frágil que parecia já estar morta e enterrada há anos, sua pele estava tão aderida aos ossos que eu conseguia ver os espaços entre eles. ",shape=box,color=blue];
		j3904380749 -> j4179422748;
	j4060921129 [label="Tão magra e frágil que parecia já estar morta e enterrada há anos, sua pele estava tão aderida aos ossos que eu conseguia ver os espaços entre eles. ",shape=box,color=blue];
		j4060921129 -> j1402450253;
	j112921882 [label="Estou… talvez, cautelosamente esperançoso para ver aonde esse novo caminho me levará. No entanto, você estava perguntando sobre o meu passado, certo?",shape=box,color=blue];
		j112921882 -> j4015925620;
	j680096311 [label="Não, eu… não quero rejeitar seus esforços. Eu simplesmente… não estou acostumado a… demonstrações de afeto, Peregrino. Nenhuma.",shape=box,color=blue];
		j680096311 -> j3543309049;
	j4179422748 [label="Seus cabelos eram pouco mais que alguns fios brancos que pendiam sem vida de sua cabeça. Mas serão seus olhos que mais me marcarão.",shape=box,color=blue];
		j4179422748 -> j3346343059;
