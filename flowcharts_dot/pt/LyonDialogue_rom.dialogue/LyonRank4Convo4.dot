	1051 [label="Talvez. Muitas vezes me perguntei se não fazia parte da compulsão. Mas é um método da Lua, dos Luminários. Não estou sozinho nessa prática.",shape=box,color=blue];
		1051 -> 1054;
	1052 [label="Conforme fui crescendo, as visões se transformaram em vozes. Sussurros, que me vinham à mente a qualquer hora. Acordada e sonhando. Meu trabalho na fazenda sofreu com isso, e eu sofri em troca.",shape=box,color=blue];
