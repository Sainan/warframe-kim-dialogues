	j663996152 [label="Pois ela não tinha nenhum.",shape=box,color=blue];
		j663996152 -> j4044500375;
	j4098579323 [label="Três meses depois, uma mulher da aldeia foi encontrada morta em sua casa. Seus olhos haviam sido devorados por ratos. ",shape=box,color=blue];
		j4098579323 -> j3754166598;
	j4044500375 [label="Três meses depois, uma mulher da aldeia foi encontrada morta em sua casa. Seus olhos haviam sido devorados por ratos. ",shape=box,color=blue];
		j4044500375 -> j3669996208;
	j3754166598 [label="Contei à minha mãe o que tinha visto na noite em que a visão me acordou. Ela se lembrou do que eu tinha visto, assim como eu.",shape=box,color=blue];
		j3754166598 -> j3247872015;
		j3754166598 -> j24968726;
	j3669996208 [label="Sim, Peregrino. As visões me assustaram.",shape=box,color=blue];
		j3669996208 -> j3754166598;
	j3247872015 [label="O que ela fez?",shape=box,color=red];
		j3247872015 -> j3493320140;
	j24968726 [label="Ela achou que era uma coincidência… ou um sinal?",shape=box,color=red];
		j24968726 -> j704008428;
	j3493320140 [label="Ela me batia com um bastão, até eu não conseguir mais ficar de pé. Minhas costas sangravam, até eu ser obrigado a dormir de bruços. Ainda me lembro dos gritos dela enquanto me batia: \"Diable! Sorcier!\"",shape=box,color=blue];
		j3493320140 -> j1795680493;
		j3493320140 -> j2872278343;
		j3493320140 -> j4270190689;
		j3493320140 -> j779416361;
	j704008428 [label="Eu não sei. Tudo o que sei é que ela me batia com um bastão, até eu não conseguir mais ficar de pé. Minhas costas sangravam, até eu ser obrigado a dormir de bruços. Ainda me lembro dos gritos dela enquanto me batia: \"Diable! Sorcier!\"",shape=box,color=blue];
		j704008428 -> j1795680493;
		j704008428 -> j2872278343;
		j704008428 -> j4270190689;
		j704008428 -> j779416361;
	j1795680493 [label="Quantos anos você tinha?",shape=box,color=red];
		j1795680493 -> j2751753792;
	j2872278343 [label="Ah, Lyon… sinto muito, muito mesmo…",shape=box,color=red];
		j2872278343 -> j3908477418;
	j4270190689 [label="Isso é terrível…",shape=box,color=red];
		j4270190689 -> j3908477418;
	j779416361 [label="Ela era ignorante. Ela não sabia de nada.",shape=box,color=red];
		j779416361 -> j3908477418;
	j2751753792 [label="Acho que 4 anos, talvez. 6, no máximo. Não sei. Não costumávamos acompanhar nossos anos com a mesma veemência que vocês têm agora.",shape=box,color=blue];
		j2751753792 -> j2698478763;
	j3908477418 [label="+5 Chemistry",color=orange];
		j3908477418 -> j1085040520;
	j2698478763 [label="Check boolean LyonPainOff",color=orange];
		j2698478763 -> j1890550981 [label=true,color=green];
		j2698478763 -> j2911791029 [label=false,color=brown];
		j2698478763 -> j1890550981 [label=false,color=brown];
	j1085040520 [label="Minha mãe já havia falecido quando partimos para cá. E agora, ela não passa de pó. Ela viveu uma vida de miséria… e miséria ela estava fadada a espalhar.",shape=box,color=blue];
		j1085040520 -> j1593480470;
	j1890550981 [label="Machucar uma criança… é imperdoável",shape=box,color=red];
		j1890550981 -> j3908477418;
	j2911791029 [label="É por isso que você…",shape=box,color=red];
		j2911791029 -> j2933368378;
	j1593480470 [label="Ela estava assustada. Qualquer que fosse o meu mal, fosse um fardo dos deuses, loucura ou uma maldição… ela não estava preparada para lidar com ele.",shape=box,color=blue];
		j1593480470 -> j2578770697;
	j2933368378 [label="Check boolean LyonLecture2",color=orange];
		j2933368378 -> j3628962904 [label=true,color=green];
		j2933368378 -> j4121557153 [label=false,color=brown];
	j2578770697 [label="De qualquer forma, por mais cruel que minha mãe fosse, meu pai era pior. Vou poupá-lo dos detalhes.",shape=box,color=blue];
		j2578770697 -> j2817030283;
	j3628962904 [label="Talvez. Muitas vezes me perguntei se não fazia parte da compulsão. Mas, como já lhe disse antes, também é um método da Lua.",shape=box,color=blue];
		j3628962904 -> j2989504019;
	j4121557153 [label="Talvez. Muitas vezes me perguntei se não fazia parte da compulsão. Mas é um método da Lua, dos Luminários. Não estou sozinho nessa prática.",shape=box,color=blue];
		j4121557153 -> j1926478077;
	j2817030283 [label="Conforme fui crescendo, as visões se transformaram em vozes. Sussurros, que me vinham à mente a qualquer hora. Acordada e sonhando. Meu trabalho na fazenda sofreu com isso, e eu sofri em troca.",shape=box,color=blue];
		j2817030283 -> j1150396123;
		j2817030283 -> j4258324102;
	j2989504019 [label="+5 Chemistry",color=orange];
		j2989504019 -> j2459830603;
	j1926478077 [label="+5 Chemistry",color=orange];
		j1926478077 -> j1414332995;
	j1150396123 [label="O que te levou à igreja?",shape=box,color=red];
		j1150396123 -> j4013567020;
	j4258324102 [label="Algumas pessoas não merecem ser pais",shape=box,color=red];
		j4258324102 -> j3372711712;
	j2459830603 [label="Insisto que isso me traz um mínimo de paz, embora eu saiba que ainda lhe deve parecer estranho que o faça.",shape=box,color=blue];
		j2459830603 -> j2578770697;
	j1414332995 [label="Um dos outros padres da Catedral me ensinou isso para me ajudar a… clarear a mente. Aqueles que são escolhidos pela Lua são frequentemente \"abençoados\" por \"visões\".",shape=box,color=blue];
		j1414332995 -> j1572095108;
	j4013567020 [label="Check boolean LyonPainOff",color=orange];
		j4013567020 -> j700328699 [label=true,color=green];
		j4013567020 -> j2589587279 [label=false,color=brown];
	j3372711712 [label="Agradeço a intenção, mas não posso deixar de mencionar o quão difícil era lidar comigo quando criança, especialmente depois que fiquei mais alto e mais forte do que meus pais.",shape=box,color=blue];
		j3372711712 -> j4013567020;
	j1572095108 [label="Boolean LyonLecture2 is now true.",color=orange];
		j1572095108 -> j2578770697;
	j700328699 [label="Minhas visões e as vozes frequentemente me levavam a ataques violentos, Peregrino. Torturar-me era, muitas vezes, a única maneira de me libertar disso.",shape=box,color=blue];
		j700328699 -> j3075952952;
	j2589587279 [label="Minhas visões e as vozes frequentemente me levavam a ataques violentos, Peregrino. Muitas vezes, eu pegava uma faca para cortar minha própria carne, pois a dor era a única coisa que me despertava.",shape=box,color=blue];
		j2589587279 -> j3075952952;
	j3075952952 [label="Mas foi quando as vozes me instruíram a…",shape=box,color=blue];
		j3075952952 -> j413088146;
	j413088146 [label="Eu… eu não consigo. Simplesmente não consigo. Me perdoe. Minhas mãos estão tremendo enquanto digito isso. Preciso parar por agora.",shape=box,color=blue];
		j413088146 -> j1935033127;
		j413088146 -> j2828715927;
	j1935033127 [label="Claro, tá tudo bem. Não precisa ter pressa. Estarei aqui quando você estiver pronto",shape=box,color=red];
		j1935033127 -> j48448545;
	j2828715927 [label="Entendo, já foi muita coisa. Vê se descansa, ok? E… obrigado, isso significa muito pra mim",shape=box,color=red];
		j2828715927 -> j2697777883;
	j48448545 [label="+10 Chemistry",color=orange];
		j48448545 -> j1370150654;
	j2697777883 [label="+15 Chemistry",color=orange];
		j2697777883 -> j770385385;
	j1370150654 [label="Obrigado. Falarei com você em breve. ",shape=box,color=blue];
		j1370150654 -> j2611460763;
	j770385385 [label="E para mim, mais do que você pode imaginar, eu acho. Agradeço-lhe também, meu amigo. Falarei com você em breve.",shape=box,color=blue];
		j770385385 -> j998699806;
	j2611460763 [label="Boolean LyonBackstory3b is now true.",color=orange];
		j2611460763 -> j3855476688;
