	2214 [label="Chat ends.",color=orange];
	2217 [label="[Encerrar Conversa]",shape=box,color=red];
		2217 -> 2219;
	2218 [label="Tem algo de errado, Lyon?",shape=box,color=red];
		2218 -> 2220;
	2219 [label="Update boolean LyonConsentComplete",color=orange];
		2219 -> 2221;
	2220 [label="Não, não há nada de errado. Eu simplesmente queria dizer que sei que você passa tempo com outra pessoa de uma forma… amorosa, quando não está comigo.",shape=box,color=blue];
		2220 -> 2222;
	2221 [label="Chat ends.",color=orange];
	2222 [label="E eu simplesmente queria assegurar-lhe que isso não me causa hesitação, nem inquietação. Sua presença em minha vida só me trouxe paz, só alegria…",shape=box,color=blue];
		2222 -> 2223;
	2223 [label="E como eu poderia negar a alguém a oportunidade de receber um presente assim?",shape=box,color=blue];
		2223 -> 2224;
		2223 -> 2225;
	2224 [label="Sinceramente, acho que você ia gostar dessa pessoa",shape=box,color=red];
		2224 -> 2226;
	2225 [label="Valeu, isso significa muito pra mim",shape=box,color=red];
		2225 -> 2227;
	2226 [label="Só de pensar nisso, já me dá um sorriso. E quem sabe, talvez em outra vida, ou em outro dia, a gente se encontre. ",shape=box,color=blue];
		2226 -> 2228;
	2227 [label="Como estamos, como eu estou, com tudo que você me trouxe, tudo que representamos… estou contente. Aliás, estou… feliz. Pela primeira vez em muito, muito tempo.",shape=box,color=blue];
		2227 -> 2229;
	2228 [label="Mas nesta situação, estou contente como estamos. Aliás, estou… feliz. Pela primeira vez em muito, muito tempo.",shape=box,color=blue];
		2228 -> 2229;
	2229 [label="E devo isso a você. Por agora, porém, despeço-me.",shape=box,color=blue];
