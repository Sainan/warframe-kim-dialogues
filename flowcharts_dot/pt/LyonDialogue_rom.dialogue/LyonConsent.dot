	j1316396836 [label="Check boolean LyonPolyamorySuccess",color=orange];
		j1316396836 -> j1181132753 [label=true,color=green];
		j1316396836 -> "Chat ends." [label=false,color=brown];
	j1437599607 [label="Se me permite, gostaria de abordar brevemente algo que acredito que tranquilizará a ambos, meu milagre.",shape=box,color=blue];
		j1437599607 -> j1416413365;
		j1437599607 -> j1650602058;
	j1416413365 [label="[Encerrar Conversa]",shape=box,color=red];
		j1416413365 -> j3944516755;
	j1650602058 [label="Tem algo de errado, Lyon?",shape=box,color=red];
		j1650602058 -> j1117770244;
	j3944516755 [label="Boolean LyonConsentComplete is now true.",color=orange];
		j3944516755 -> "Chat ends.";
	j1117770244 [label="Não, não há nada de errado. Eu simplesmente queria dizer que sei que você passa tempo com outra pessoa de uma forma… amorosa, quando não está comigo.",shape=box,color=blue];
		j1117770244 -> j2761214677;
	j2761214677 [label="E eu simplesmente queria assegurar-lhe que isso não me causa hesitação, nem inquietação. Sua presença em minha vida só me trouxe paz, só alegria…",shape=box,color=blue];
		j2761214677 -> j3580086323;
	j3580086323 [label="E como eu poderia negar a alguém a oportunidade de receber um presente assim?",shape=box,color=blue];
		j3580086323 -> j3658089966;
		j3580086323 -> j1744128542;
	j3658089966 [label="Sinceramente, acho que você ia gostar dessa pessoa",shape=box,color=red];
		j3658089966 -> j3498588724;
	j1744128542 [label="Valeu, isso significa muito pra mim",shape=box,color=red];
		j1744128542 -> j943161208;
	j3498588724 [label="Só de pensar nisso, já me dá um sorriso. E quem sabe, talvez em outra vida, ou em outro dia, a gente se encontre. ",shape=box,color=blue];
		j3498588724 -> j990444963;
	j943161208 [label="Como estamos, como eu estou, com tudo que você me trouxe, tudo que representamos… estou contente. Aliás, estou… feliz. Pela primeira vez em muito, muito tempo.",shape=box,color=blue];
		j943161208 -> j3675487052;
	j990444963 [label="Mas nesta situação, estou contente como estamos. Aliás, estou… feliz. Pela primeira vez em muito, muito tempo.",shape=box,color=blue];
		j990444963 -> j3675487052;
	j3675487052 [label="E devo isso a você. Por agora, porém, despeço-me.",shape=box,color=blue];
		j3675487052 -> j698039068;
	j698039068 [label="- Lyon",shape=box,color=blue];
		j698039068 -> j3944516755;
