digraph {
	32 [label="LyonRank3Convo2 begins.",color=orange];
		32 -> 33;
	33 [label="Se me permitir, gostaria de lhe contar a história de um gato de rua que costumava aparecer atrás da igreja.",shape=box,color=blue];
		33 -> 36;
		33 -> 35;
		33 -> 34;
	36 [label="Vá em frente",shape=box,color=red];
		36 -> 39;
	35 [label="Por quê?",shape=box,color=red];
		35 -> 38;
	34 [label="[Ignorar]",shape=box,color=red];
		34 -> 37;
	39 [label="Agradeço.",shape=box,color=blue];
		39 -> 41;
	38 [label="Receio que uma explicação exigiria mais esforço do que valeria a pena.",shape=box,color=blue];
		38 -> 40;
	37 [label="Chat ends.",color=orange];
	41 [label="Embora suspeite que essa história não seja única desse gato velho e maltrapilho, e que minhas interações com ele não sejam dignas de nota, acredito valer a pena contá-la ainda assim.",shape=box,color=blue];
		41 -> 43;
	40 [label="Deixe estar.",shape=box,color=blue];
		40 -> 42;
	43 [label="Todos os dias ele vinha pedir restos de comida e qualquer migalha de afeto que pudesse receber de mim ou dos outros irmãos e irmãs que o adoravam.",shape=box,color=blue];
		43 -> 44;
	42 [label="Chat ends.",color=orange];
	44 [label="Ele era um bicho esfarrapado, mancava de uma pata e tinha um pedaço da orelha faltando. ",shape=box,color=blue];
		44 -> 45;
	45 [label="Quando ele não apareceu por alguns dias, Marie ficou preocupadíssima. Mas o que se poderia fazer por um gato de rua velho que encontrou seu fim, senão fazer uma oração a Lua?",shape=box,color=blue];
		45 -> 46;
	46 [label="Update boolean LyonStray",color=orange];
		46 -> 47;
		46 -> 48;
		46 -> 49;
	47 [label="[Deixá-lo continuar]",shape=box,color=red];
		47 -> 50;
	48 [label="Isso é permitido na sua religião? Rezar pelos animais, quero dizer",shape=box,color=red];
		48 -> 51;
	49 [label="Você rezaria pela alma de um gato de rua que partiu?",shape=box,color=red];
		49 -> 52;
	50 [label="De todo modo, imagine minha surpresa quando, ao ir comprar pão na feira, vi o gato velho sentado ao lado do dono da tenda.",shape=box,color=blue];
		50 -> 53;
	51 [label="+10 Chemistry",color=orange];
		51 -> 54;
	52 [label="Mas é claro. Algumas das almas mais puras e brilhantes que encontrei estavam aprisionadas na carne de uma besta. Não me cabe julgar como os Luminários as guiaram em seus caminhos.",shape=box,color=blue];
		52 -> 55;
	53 [label="Ele me cumprimentou com um miado rouco, como de costume, e se aproximou para se esfregar na minha perna.",shape=box,color=blue];
		53 -> 56;
	54 [label="Boa pergunta. Em algumas seitas, não. Seria considerado heresia. Mas na nossa, sim. Reconhecemos que os animais têm alma.",shape=box,color=blue];
		54 -> 55;
	55 [label="Santa Isabel, a Sábia, era conhecida por sua caridade com os animais, embora muitas tradições não reconheçam os Santos como apóstolos dos Luminários.",shape=box,color=blue];
		55 -> 57;
	56 [label="E eu gostaria de salientar, Peregrino, que ele fez isso sem mancar.",shape=box,color=blue];
		56 -> 58;
	57 [label="Me pergunto se alguma influência da nossa ordem perdurou no tempo… mas esse não era o ponto principal da conversa.",shape=box,color=blue];
		57 -> 59;
	58 [label="\"Ah, vejo ser mais uma das vítimas tolas do velho Devereaux.\" O homem riu enquanto ensacava meu pão.",shape=box,color=blue];
		58 -> 60;
	59 [label="Update boolean LyonLecture1",color=orange];
		59 -> 50;
	60 [label="Acontece que o gato velho estava nos enganando, assim como a vários outros vizinhos. Ele não estava faminto, doente ou sendo negligenciado de alguma forma.",shape=box,color=blue];
		60 -> 61;
	61 [label="Aliás, se as palavras daquele homem fossem dignas de fé, ele era um verdadeiro demônio assassino para a população local de pássaros.",shape=box,color=blue];
		61 -> 62;
		61 -> 63;
		61 -> 64;
	62 [label="Vocês pararam de alimentar o velho Devereaux quando ele apareceu novamente?",shape=box,color=red];
		62 -> 65;
	63 [label="Está tentando me alertar sobre o Roathe?",shape=box,color=red];
		63 -> 66;
	64 [label="Você é o gato de rua nesta história?",shape=box,color=red];
		64 -> 67;
	65 [label="+10 Chemistry",color=orange];
		65 -> 68;
	66 [label="Há muitas coisas que serviriam de alerta sobre o demônio que o \"Cardeal Dimanche\" deixou à nossa porta. Talvez esta seja uma delas. Talvez não.",shape=box,color=blue];
		66 -> 69;
	67 [label="Os Luminários sabem que ando bastante desgastado ultimamente. Mas será que isso é um aviso sobre mim mesmo? Talvez. Talvez não.",shape=box,color=blue];
		67 -> 69;
	68 [label="Não, não paramos. Na verdade, a Marie o recebeu com ainda mais carinho, chamando-o em tom de brincadeira de \"seu diabinho\".",shape=box,color=blue];
		68 -> 70;
	69 [label="É somente uma história para lembrar que, às vezes, quando uma criatura parece estar necessitada…",shape=box,color=blue];
		69 -> 71;
	70 [label="Mas já não nos preocupávamos mais com ele. Sabíamos que o velho Devereaux era perfeitamente capaz de cuidar de si. Não precisava de nós.",shape=box,color=blue];
		70 -> 72;
		70 -> 73;
	71 [label="+15 Chemistry",color=orange];
		71 -> 74;
	72 [label="O que aconteceu com o velho Devereaux, você sabe?",shape=box,color=red];
		72 -> 75;
	73 [label="O que acha que levou o velho Devereaux a visitá-los, se não foi por necessidade?",shape=box,color=red];
		73 -> 76;
	74 [label="…convém verificar quão afiadas são suas garras.",shape=box,color=blue];
		74 -> 77;
	75 [label="Seu desaparecimento subsequente, dois anos depois, tornou-se permanente.",shape=box,color=blue];
		75 -> 78;
		75 -> 79;
	76 [label="A resposta cínica que lhe daria seria \"ganância\". Pois se alguém pode ter um banquete, por que não dois? Por que não dez?",shape=box,color=blue];
		76 -> 80;
		76 -> 81;
	77 [label="Chat ends.",color=orange];
	78 [label="Você rezou por ele?",shape=box,color=red];
		78 -> 82;
	79 [label="Espero que tenha partido deste mundo em paz e amado",shape=box,color=red];
		79 -> 83;
	80 [label="Qual seria a resposta não cínica?",shape=box,color=red];
		80 -> 84;
	81 [label="A resposta seria a mesma se ele estivesse apenas buscando afeto?",shape=box,color=red];
		81 -> 85;
	82 [label="Na noite em que soube de sua morte, acendi uma vela para ele e rezei para Lua guiar sua alma para… qualquer lugar para onde ela guiaria um diabinho como ele.",shape=box,color=blue];
		82 -> 86;
	83 [label="Posso lhe perguntar a razão?",shape=box,color=blue];
		83 -> 87;
		83 -> 88;
	84 [label="+10 Chemistry",color=orange];
		84 -> 89;
	85 [label="Um desejo ganancioso por afeto ainda é gula, embora não seja uma fome saciada por carne e vinho. E ainda o buscar sob tais pretextos?",shape=box,color=blue];
		85 -> 90;
		85 -> 91;
	86 [label="E agradeci ao velho Devereaux por toda a alegria que ele trouxe a Marie em troca de todos aqueles preciosos pedaços de cartilagem de frango e carinhos na cabeça.",shape=box,color=blue];
		86 -> 92;
	87 [label="Ele era um animal, tava só em busca de satisfação. Comida, abrigo, amor… não era movido pelas mesmas motivações que as pessoas. Ele não tava \"mentindo\", ele caçava com ferramentas diferentes",shape=box,color=red];
		87 -> 93;
	88 [label="Vi muita violência, Lyon. Grande parte dela foi causada por mim. Passei a desejar que todos, não importa quem sejam ou o que tenham feito, possam morrer em paz, rodeados por aqueles que os amam",shape=box,color=red];
		88 -> 94;
	89 [label="Estranhamente, me vi… respeitando o gato, pelo lugar que ele havia conquistado no mundo.",shape=box,color=blue];
		89 -> 95;
	90 [label="Ele era um gato, Lyon. Mal sabia o que estava fazendo",shape=box,color=red];
		90 -> 96;
	91 [label="Ainda estamos falando de um gato, né?",shape=box,color=red];
		91 -> 97;
	92 [label="Agradeço. Não lhe importunarei mais em seu dia.",shape=box,color=blue];
		92 -> 98;
	93 [label="Ele não tava negando nada a ninguém ao fazer de vocês todos seus \"tolos\". Pelo contrário… parece que todos vocês se enriqueceram com as visitas dele",shape=box,color=red];
		93 -> 99;
	94 [label="Fascinante. Esperaria que você desprezasse seus inimigos. Mas essa é a minha própria tolice — presumir que sei como alguém se comportaria nos tempos de hoje.",shape=box,color=blue];
		94 -> 100;
	95 [label="Eis uma criatura que aprendeu a usar sua condição — sua aparência, sua idade, suas cicatrizes — como uma arma contra os \"tolos\" que o cercavam e não percebiam suas artimanhas.",shape=box,color=blue];
		95 -> 101;
	96 [label="Ele sabia o suficiente para fingir que estava mancando. ",shape=box,color=blue];
		96 -> 84;
	97 [label="Tire desta conversa o que melhor lhe parecer, Peregrino.",shape=box,color=blue];
		97 -> 84;
	98 [label="- Padre Lyon Allard",shape=box,color=blue];
		98 -> 102;
	99 [label="Add -1 to Thermostat",color=orange];
		99 -> 103;
	100 [label="Add 1 to Thermostat",color=orange];
		100 -> 104;
	101 [label="Era, de fato, um diabinho de pelos emaranhados. Ainda assim, sempre que vinha me visitar, acabava por lhe fazer um afago.",shape=box,color=blue];
		101 -> 105;
	102 [label="Chat ends.",color=orange];
	103 [label="Sim, acho que sim. E não estávamos com falta de pedaços de cartilagem e arranhões de frango…",shape=box,color=blue];
		103 -> 106;
	104 [label="Quem dirá alguém com a história de vida tão particularmente fascinante quanto a sua. ",shape=box,color=blue];
		104 -> 107;
	105 [label="E fiquei igualmente desolado quando, dois anos depois, seu desaparecimento subsequente se tornou permanente.",shape=box,color=blue];
		105 -> 78;
		105 -> 79;
	106 [label="Talvez seja por isso que acendi uma vela para ele e rezei para Lua levar sua alma e guiá-la para… onde quer que ela levasse um diabinho como ele.",shape=box,color=blue];
		106 -> 108;
	107 [label="+5 Chemistry",color=orange];
		107 -> 109;
	108 [label="+5 Chemistry",color=orange];
		108 -> 110;
	109 [label="Obrigado, não vou mais atrapalhar seu dia. Esta foi uma conversa muito interessante. Até a próxima.",shape=box,color=blue];
		109 -> 111;
	110 [label="E foi por isso que agradeci ao velho Devereaux em minhas orações naquela noite por toda a alegria que ele havia trazido a Marie.",shape=box,color=blue];
		110 -> 112;
	111 [label="- Padre Lyon Allard",shape=box,color=blue];
		111 -> 113;
	112 [label="Talvez sua pequena vilania tenha tido algum efeito positivo, mesmo que indireto.",shape=box,color=blue];
		112 -> 109;
	113 [label="Chat ends.",color=orange];
}