		j2722877627 -> j3219401655;
	j3883978941 [label="Meus avós se conheceram durante a Revolução Gaulesa. A guerra e a morte sempre foram parceiras numa dança que leva à paixão e ao amor das maneiras mais estranhas. ",shape=box,color=blue];
		j3883978941 -> j3628502303;
