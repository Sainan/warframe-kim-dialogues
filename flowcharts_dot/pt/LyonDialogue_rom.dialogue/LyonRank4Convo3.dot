	j1331458418 [label="Check boolean LyonFirstFlirt",color=orange];
		j1331458418 -> j3233227261 [label=true,color=green];
		j1331458418 -> j2135170222 [label=false,color=brown];
	j3931209737 [label="E tenho certeza de que tudo isso fazia parte do grande e magistral plano do Entrati: confiar o destino do futuro a você e a um bando de desajustados.",shape=box,color=blue];
		j3931209737 -> j3034624421;
	j2073969405 [label="Meus avós se conheceram durante a Revolução Gaulesa. A guerra e a morte sempre foram parceiras, conduzindo a uma dança de camaradagem das maneiras mais estranhas. ",shape=box,color=blue];
		j2073969405 -> j3628502303;
	j3233227261 [label="Me perdoe. Parece-me que, na última vez em que conversamos, você… ",shape=box,color=blue];
		j3233227261 -> j4138631249;
	j965717793 [label="Perdoe-me. Não conheço o seu coração, nem o coração dos outros. O que você faz no seu tempo livre com os outros é assunto exclusivamente seu. ",shape=box,color=blue];
		j965717793 -> j3191592553;
		j965717793 -> j2674426265;
	j2256799528 [label="Me perdoe. Não, você tem razão. Não quero parecer invejoso ou como se eu estivesse me considerando algum tipo de provocador. O que você faz no seu tempo livre com outras pessoas é assunto exclusivamente seu. ",shape=box,color=blue];
		j2256799528 -> j3191592553;
		j2256799528 -> j2674426265;
	j2135170222 [label="Claro. Perdoe-me. Não conheço o seu coração, nem o coração dos outros. O que você faz no seu tempo livre com os outros é assunto exclusivamente seu. ",shape=box,color=blue];
		j2135170222 -> j3191592553;
		j2135170222 -> j2674426265;
	j3034624421 [label="Eu… Peregrino, sei que não sou a pessoa mais… afável com quem você é obrigado a interagir, e por isso continuo a pedir desculpas.",shape=box,color=blue];
		j3034624421 -> j3461088531;
