		j3127594258 -> j2776950376;
	j11570963 [label="O que se esconde sob essa superfície de vidro estilhaçado é…",shape=box,color=blue];
		j11570963 -> j1546412242;
		j11570963 -> j305606156;
	j3189092416 [label="De fato. Suponho que não devo me ressentir de quaisquer aspectos positivos que possam surgir da escuridão e da destruição da guerra. ",shape=box,color=blue];
		j3189092416 -> j2918155468;
		j3189092416 -> j463882601;
	j4245479311 [label="Não é uma história que eu goste de contar. Para ninguém. Então, vocês me perdoarão se eu não estiver muito animado para compartilhá-la. Talvez em outra ocasião. ",shape=box,color=blue];
		j4245479311 -> j2517184074;
		j4245479311 -> j4125188309;
	j1174021646 [label="Por favor, continue. ",shape=box,color=blue];
		j1174021646 -> j690374150;
		j1174021646 -> j2776950376;
	j3219401655 [label="Com todo o respeito, eu não te conheço. E com tudo o mais que já acumulei sobre mim, um envolvimento romântico com um estranho dificilmente é minha prioridade. ",shape=box,color=blue];
		j3219401655 -> j4191778538;
	j690374150 [label="Eu… a gente tenta isso de novo depois… foi mal",shape=box,color=red];
		j690374150 -> j515587627;
