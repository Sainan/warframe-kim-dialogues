		j3628502303 -> j877308656;
		j3628502303 -> j1925283326;
	j4138631249 [label="Não importa… não deveria me surpreender quando os corações são volúveis e inconstantes. Principalmente quando estou envolvido.",shape=box,color=blue];
		j4138631249 -> j1018149796;
		j4138631249 -> j2722877627;
	j3191592553 [label="Passei por muita coisa com eles… isso tende a unir as pessoas",shape=box,color=red];
		j3191592553 -> j3883978941;
	j2674426265 [label="[Confessar Sentimentos] Sinceramente, eu já tava tentando descobrir como abordar esse assunto com você…",shape=box,color=red];
		j2674426265 -> j3127594258;
	j3461088531 [label="É simplesmente assim que sou, e não sei como mudar. Aliás, não creio ser capaz de desfazer o dano que minha alma sofreu nas mãos dos malditos que vieram me assombrar. ",shape=box,color=blue];
		j3461088531 -> j11570963;
