		j17348121 -> "Chat ends.";
	j428334408 [label="Eu me divirto muito ouvindo as conversas deles, embora, como você pode imaginar, eu mesmo não participe. Tenho pouco a acrescentar ao discurso deles. ",shape=box,color=blue];
		j428334408 -> j2175827605;
	j1779823323 [label="Acho-o extremamente agradável. Aliás, dentre meus novos… colegas, ele é aquele com quem mais me sinto atraído pela companhia.",shape=box,color=blue];
		j1779823323 -> j3536273299;
	"Chat ends." [color=orange];
	j2175827605 [label="No entanto, me preocupa ver o Roathe parado conversando longamente com o Pássaro 3. Não sei o que ele pretende alcançar com isso.",shape=box,color=blue];
		j2175827605 -> j2507757158;
	j3536273299 [label="Embora isso provavelmente não seja surpresa para absolutamente ninguém, eu suponho. À primeira vista, temos uma personalidade muito semelhante. ",shape=box,color=blue];
		j3536273299 -> j4271201351;
	j2507757158 [label="Boolean LyonRoatheCavia1 is now true.",color=orange];
		j2507757158 -> j207983192;
		j2507757158 -> j1123619369;
	j4271201351 [label="É o jovem Operador que me parece mais estranho… e aquela que chamam de Lótus. E como somos mantidos à distância deles.",shape=box,color=blue];
		j4271201351 -> j3915993686;
	j207983192 [label="Hmm… vou falar com ele sobre isso",shape=box,color=red];
		j207983192 -> j233552391;
	j1123619369 [label="Por que você acha que ele tá atrás de alguma coisa?",shape=box,color=red];
		j1123619369 -> j2588064055;
	j3915993686 [label="É claro que podemos interagir. Mas não assim, não aqui. Por quê?",shape=box,color=blue];
		j3915993686 -> j1968598084;
		j3915993686 -> j2053797432;
	j233552391 [label="Talvez seja uma atitude sábia. Eu detestaria vê-lo manipular essas criaturas para que se tornassem objetos de uso ainda maiores do que já são. ",shape=box,color=blue];
		j233552391 -> j4271201351;
	j2588064055 [label="O Roathe sempre tem uma motivação oculta quando conversa com alguém. Eu detestaria vê-lo manipular essas criaturas para que se tornassem objetos de uso ainda mais do que já são.",shape=box,color=blue];
		j2588064055 -> j2608993500;
	j1968598084 [label="A criança… tá passando por seus próprios problemas. Não podemos exigir ainda mais, não é certo",shape=box,color=red];
		j1968598084 -> j802066769;
	j2053797432 [label="Acho que é… porque tenho \"experiência\" com Protoframes?",shape=box,color=red];
		j2053797432 -> j3260070664;
	j2608993500 [label="Pode valer a pena investigar, se você tiver tempo. Embora isso seja inteiramente um direito seu. ",shape=box,color=blue];
		j2608993500 -> j4271201351;
	j802066769 [label="Sim. Ouvi rumores sobre o que eles foram forçados a suportar. Histórias de guerra e… amizades desfeitas, despedaçadas.",shape=box,color=blue];
		j802066769 -> j3837202410;
	j3260070664 [label="Check boolean IsDating",color=orange];
		j3260070664 -> j561666391 [label=true,color=green];
		j3260070664 -> j4156359328 [label=false,color=brown];
	j3837202410 [label="É de partir o coração ver o que é destruído em um ato de guerra. Mais estranho ainda é o que pode ser criado por ela. ",shape=box,color=blue];
		j3837202410 -> j4156359328;
	j561666391 [label="Hum. É assim que chamam agora? \"Experiência?\" Que bom gosto. Embora o Entrati pareça ter feito uma grande confusão, fico feliz que você tenha… encontrado uma maneira de se divertir.",shape=box,color=blue];
		j561666391 -> j1092891306;
		j561666391 -> j1026558912;
		j561666391 -> j3385969221;
	j4156359328 [label="Sr. Loid me contou sobre sua \"desventura\" em Holvânia do seu passado, nosso futuro. O Entrati certamente fez uma grande confusão.",shape=box,color=blue];
		j4156359328 -> j4068950490;
		j4156359328 -> j2063703228;
	j1092891306 [label="Fiz algo errado aqui?",shape=box,color=red];
		j1092891306 -> j3487893497;
	j1026558912 [label="Cuidado, ou posso achar que você tá se perguntando se a grama não é mais verde do outro lado da cerca, Padre",shape=box,color=red];
		j1026558912 -> j619519124;
	j3385969221 [label="Você tá falando como se fosse só um caso passageiro, Lyon. Por favor, não me insulte assim",shape=box,color=red];
		j3385969221 -> j1331458418;
	j4068950490 [label="Acredite, poderia ter sido muito pior",shape=box,color=red];
		j4068950490 -> j3931209737;
