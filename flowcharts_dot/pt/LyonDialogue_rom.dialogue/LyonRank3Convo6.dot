	577 [label="Me falaram que você nem sempre vê as coisas da mesma maneira que a gente, mas isso não me incomoda. Tô interessado no que você sabe",shape=box,color=red];
		577 -> 581;
	574 [label="A Marie parece obcecada pelo \"Cardeal\", e o Roathe claramente odeia ele. Tô procurando uma pessoa neutra, você é a pessoa mais próxima disso",shape=box,color=red];
		574 -> 578;
	575 [label="Eu… não sei mais o que te perguntar?",shape=box,color=red];
		575 -> 579;
	576 [label="Me falaram que você nem sempre vê as coisas da mesma maneira que a gente, mas acho que você pode enxergar a verdade onde os outros são cegos",shape=box,color=red];
		576 -> 580;
	581 [label="Hmm. Não te incomoda, se misturar com loucos e lunáticos? Curioso. Embora você pareça se associar a animais falantes e… criaturas de outro tempo. Suponho que eu não seja mais ou menos excêntrico do que qualquer outro membro da sua coleção.",shape=box,color=blue];
		581 -> 582;
	578 [label="Que escassez de opções sensatas você encontrou, quando um louco e um lunático são sua única fonte para uma opinião \"neutra\". Não consigo entender por que você se dá ao trabalho de falar comigo. ",shape=box,color=blue];
		578 -> 582;
	579 [label="Por que você insiste em falar comigo? Você não precisa, sabia disso? Se deseja se aproximar, ou até mesmo cortejar a Marie, eu não sou responsável por ela, nem o pai dela. E, sejam quais forem suas intenções com aquele desgraçado do Roathe, pouco me importa além das respostas que ele me deve.",shape=box,color=blue];
		579 -> 582;
	580 [label="\"Verdade.\" Gostaria que você entendesse o quão ridículo isso tem sido para mim ultimamente. Não te incomoda, se misturar com loucos e lunáticos? Curioso. Embora você pareça se associar a animais falantes e… criaturas de outro tempo. Suponho que eu não seja mais ou menos excêntrico do que qualquer outro membro da sua coleção.",shape=box,color=blue];
		580 -> 582;
	582 [label="Evaluate expressions",color=orange];
		582 -> 585 [label="LyonFirstFlirt",color=purple];
		582 -> 585 [label="DrifterLyon",color=purple];
		582 -> 584 [label="LyonOffer",color=purple];
		582 -> 583 [label="false",color=purple];
	585 [label="E, por favor, nos poupe de mais um… momento constrangedor, certo? Eu sei que o que você disse foram os motivos pelos quais você falou comigo. E, embora eu os ache lisonjeiros, também os considero ridiculamente insinceros.",shape=box,color=blue];
		585 -> 586;
		585 -> 587;
		585 -> 588;
	584 [label="E, por favor, poupe-nos de mais um sermão sobre como você deseja \"me ajudar\", certo? Tenho certeza de que sua intenção é ser gentil, mas a sua insinceridade ridícula é irritante.",shape=box,color=blue];
		584 -> 586;
		584 -> 587;
		584 -> 588;
	583 [label="E, por favor, poupe-nos de um longo sermão sobre como você deseja me \"ajudar\" ou como \"deseja ser meu amigo\". Tenho certeza de que sua intenção é ser gentil, mas a sua insinceridade ridícula é irritante. ",shape=box,color=blue];
		583 -> 586;
		583 -> 587;
		583 -> 588;
	586 [label="Insincero porque você acha que eu não tô falando sério, ou insincero porque você acha impossível eu falar isso sobre você?",shape=box,color=red];
		586 -> 589;
	587 [label="Padre, tudo o que eu queria era saber por quanto tempo o Entrati fingiu ser o Cardeal, só isso",shape=box,color=red];
		587 -> 590;
	588 [label="O que quer dizer com \"insincero\"? Tá me chamando de mentiroso?",shape=box,color=red];
		588 -> 591;
	589 [label="Nenhuma das opções. Suas palavras são uma caridade que eu não preciso, nem quero.",shape=box,color=blue];
		589 -> 592;
		589 -> 593;
	590 [label="Exatamente. Durante 3 anos, 2 meses e 11 dias, ele serviu como Cardeal Dimanche em nossa Catedral. E durante todo esse tempo, a Marie e eu o servimos, sem saber o que ele planejava para nós.",shape=box,color=blue];
		590 -> 594;
	591 [label="Evaluate expressions",color=orange];
		591 -> 597 [label="DrifterLiar",color=purple];
		591 -> 596 [label="LyonSuspicious",color=purple];
		591 -> 595 [label="false",color=purple];
	592 [label="Como é que a Marie aguenta isso…",shape=box,color=red];
		592 -> 598;
	593 [label="Você acha que qualquer pessoa que escolha socializar com você tá praticando um ato de \"caridade\", é?",shape=box,color=red];
		593 -> 599;
	594 [label="Eu já sei quais são as suas perguntas antes mesmo de você as fazer. O que ele estava tramando? Ele infectou a cidade, como ouvi dizer que fez com Holvânia? Quais eram os seus planos? Suas descobertas?",shape=box,color=blue];
		594 -> 600;
	597 [label="Tem algo que deseja confessar, Peregrino? Há alguma penitência que deseja pagar?",shape=box,color=blue];
		597 -> 601;
	596 [label="Hum. Não, talvez ainda não.",shape=box,color=blue];
		596 -> 595;
	595 [label="Sua insinceridade não é uma mentira, é uma demonstração de caridade. Caridade que eu não preciso, nem quero. ",shape=box,color=blue];
		595 -> 592;
		595 -> 593;
	598 [label="O melhor é perguntar a ela você mesmo. Eu também já me perguntei isso várias vezes. ",shape=box,color=blue];
		598 -> 602;
	599 [label="Em resumo… sim.",shape=box,color=blue];
		599 -> 603;
	600 [label="A essas pessoas, eu digo: vocês ficarão desapontados. Durante esses 3 anos, 2 meses e 11 dias? Ele pregou, estudou, descansou e orou.",shape=box,color=blue];
		600 -> 604;
		600 -> 605;
		600 -> 606;
	601 [label="Isso não vem ao caso. Você não veio a esta conversa buscando perdão, e suas mentiras passadas não são as mesmas que suas insinceridades atuais. ",shape=box,color=blue];
		601 -> 607;
	602 [label="Chat ends.",color=orange];
	603 [label="Update boolean LyonHate1",color=orange];
		603 -> 608;
		603 -> 609;
		603 -> 610;
	604 [label="Quando foi que ele transformou vocês em Protoframes?",shape=box,color=red];
		604 -> 611;
	605 [label="Tô tendo muita dificuldade em imaginar o Entrati rezando…",shape=box,color=red];
		605 -> 612;
	606 [label="Então ele estava… em período sabático?!",shape=box,color=red];
		606 -> 613;
	607 [label="O que você diz agora é mera caridade. Caridade que não preciso, nem quero.",shape=box,color=blue];
		607 -> 592;
		607 -> 593;
	608 [label="É algo pra analisarmos outro dia, sinto que esta conversa tá saindo do controle",shape=box,color=red];
		608 -> 614;
	609 [label="E quanto a Marie…",shape=box,color=red];
		609 -> 615;
	610 [label="Você deve ter uma péssima opinião de si mesmo",shape=box,color=red];
		610 -> 616;
	611 [label="Após esses 3 anos e alguns dias, ele desapareceu em meio a uma terrível tempestade. A mesma em que aparecera.",shape=box,color=blue];
		611 -> 617;
	612 [label="É impossível conhecer os meandros da mente de outra pessoa. Ele ajoelhou-se diante do altar e sua cabeça estava baixa. Estaria ele em oração? Ou estaria simplesmente perdido em seus próprios pensamentos? Eu não sei.",shape=box,color=blue];
		612 -> 611;
	613 [label="+5 Chemistry",color=orange];
		613 -> 618;
	614 [label="+5 Chemistry",color=orange];
		614 -> 619;
	615 [label="A Marie aconchegaria um urso raivoso no colo e deixaria que ele lhe rasgasse a garganta se achasse que isso traria ao animal um momento de paz.",shape=box,color=blue];
		615 -> 620;
	616 [label="Eu consideraria isso uma dedicação inabalável ao pragmatismo, mas defina-o como quiser. ",shape=box,color=blue];
		616 -> 621;
	617 [label="Evaluate expressions",color=orange];
		617 -> 622 [label="MarieLyonVisions",color=purple];
		617 -> 622 [label="LyonVisions1",color=purple];
		617 -> 623 [label="false",color=purple];
	618 [label="Heh. Não tinha pensado nisso dessa forma, mas sim, talvez você tenha razão. Que coisa mais irritante para todos vocês. Parece combinar com o pouco que sabemos sobre sua verdadeira personalidade.",shape=box,color=blue];
		618 -> 611;
	619 [label="Essa provavelmente é uma decisão sábia. Você estava perguntando sobre o \"Cardeal Dimanche\" e seu período na Catedral. ",shape=box,color=blue];
		619 -> 624;
	620 [label="Ela é uma alma singularmente bela, que protegerei até meu último suspiro. ",shape=box,color=blue];
		620 -> 621;
	621 [label="+5 Chemistry",color=orange];
		621 -> 625;
	622 [label="Embora eu saiba que a tempestade não aconteceu com outras pessoas, ela foi bastante vívida para mim. ",shape=box,color=blue];
		622 -> 623;
	623 [label="Exatamente 1 ano depois, ele reapareceu pela última vez, com… o Roathe, como você o vê agora, caído e inconsciente a seus pés.",shape=box,color=blue];
		623 -> 626;
	624 [label="Durante 3 anos, 2 meses e 11 dias, ele serviu como Cardeal Dimanche em nossa Catedral. E durante todo esse tempo, a Marie e eu o servimos, sem saber o que ele planejava para nós.",shape=box,color=blue];
		624 -> 594;
	625 [label="Mas é isso que você deve esperar, fazer uma pergunta simples a um louco geralmente é um caminho tortuoso. Permita-me redirecioná-lo ao seu tópico original e nos afastar do meu. ",shape=box,color=blue];
		625 -> 624;
	626 [label="Um demônio em pessoa, ou assim parecia. Foi então que o Entrati nos revelou a verdade sobre quem ele era quando nos chamou, e a verdadeira tarefa que tinha para nós.",shape=box,color=blue];
		626 -> 627;
	627 [label="Que ele nos havia escolhido a ambos para uma \"missão sagrada\".",shape=box,color=blue];
		627 -> 628;
		627 -> 629;
	628 [label="Por que as aspas? ",shape=box,color=red];
		628 -> 630;
	629 [label="Parece que você não acredita nele",shape=box,color=red];
		629 -> 630;
	630 [label="Aprendi muita coisa que me faz questionar a adesão do Entrati a qualquer coisa sacrossanta relacionada à natureza ou a qualquer deus… se é que tal coisa existe…",shape=box,color=blue];
		630 -> 631;
		630 -> 632;
	631 [label="Se é que tal coisa existe? Lyon, o que você quer dizer? ",shape=box,color=red];
		631 -> 633;
	632 [label="Prossiga",shape=box,color=red];
		632 -> 634;
	633 [label="Update boolean LyonFaith2",color=orange];
		633 -> 635;
	634 [label="A Marie aceitou o soro prontamente. Claro que aceitou, como poderia recusar? E como eu poderia não segui-la? Como eu poderia não buscar a verdade, aonde quer que ela me levasse?",shape=box,color=blue];
		634 -> 636;
	635 [label="Assunto para outra ocasião, por favor.",shape=box,color=blue];
		635 -> 634;
	636 [label="Update boolean LyonSerum1",color=orange];
		636 -> 637;
