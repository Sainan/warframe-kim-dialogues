		636 -> 639;
	637 [label="Acho que ela idolatra o Entrati um pouco… demais",shape=box,color=red];
		637 -> 640;
	638 [label="O que aconteceu depois?",shape=box,color=red];
		638 -> 641;
	639 [label="Você se arrepende?",shape=box,color=red];
		639 -> 642;
	640 [label="Update boolean LyonMarieEntrati",color=orange];
		640 -> 643;
	641 [label="O Roathe acordou. A princípio, mal conseguia se lembrar do próprio nome. O Entrati disse uma última frase ao bastardo: \"Uriel, Herege de Xata, exilado, responda: os Orokin poderão ser perdoados?\"",shape=box,color=blue];
		641 -> 644;
	642 [label="Eu me arrependo de tudo, Peregrino. Sim, claro que me arrependo. Mas faria tudo de novo? Sim, claro que faria. Não posso deixar a Marie sozinha.",shape=box,color=blue];
		642 -> 645;
	643 [label="Nisso, concordamos. Mas também não posso culpá-la por isso. Dê-lhe tempo, ela vai entender. Ela é extremamente inteligente, Peregrino. Não a trate como uma tola.",shape=box,color=blue];
		643 -> 645;
	644 [label="O Entrati partiu então pela última vez. E deixou o Roathe conosco, agora transformado no que você vê agora, mais capaz de lidar com seu temperamento do diabo.",shape=box,color=blue];
		644 -> 646;
	645 [label="Para concluir a história… o Entrati partiu então, pela última vez. E deixou o Roathe conosco, agora transformado no que vocês veem agora, mais capaz de lidar com seu temperamento do diabo.",shape=box,color=blue];
		645 -> 646;
	646 [label="O resto, receio, é uma história que terá de esperar. Sr. Loid requer o uso do POM-2 e estou ansioso para me desfazer dele. Espero que isto tenha ajudado a responder pelo menos algumas das suas perguntas.",shape=box,color=blue];
		646 -> 647;
		646 -> 648;
	647 [label="Respondeu algumas, e criou o dobro de novas…",shape=box,color=red];
