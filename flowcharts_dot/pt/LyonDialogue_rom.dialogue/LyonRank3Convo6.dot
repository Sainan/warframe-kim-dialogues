		j4196769031 -> j3492928251 [label="false",color=purple];
		j4196769031 -> j1600185028 [label="false",color=purple];
	j3254675632 [label="Me falaram que você nem sempre vê as coisas da mesma maneira que a gente, mas isso não me incomoda. Tô interessado no que você sabe",shape=box,color=red];
		j3254675632 -> j986302104;
	j3492928251 [label="A Marie parece obcecada pelo \"Cardeal\", e o Roathe claramente odeia ele. Tô procurando uma pessoa neutra, você é a pessoa mais próxima disso",shape=box,color=red];
		j3492928251 -> j1836744271;
	j1600185028 [label="Eu… não sei mais o que te perguntar?",shape=box,color=red];
		j1600185028 -> j3938185035;
	j3980505245 [label="Me falaram que você nem sempre vê as coisas da mesma maneira que a gente, mas acho que você pode enxergar a verdade onde os outros são cegos",shape=box,color=red];
		j3980505245 -> j4034696467;
	j986302104 [label="Hmm. Não te incomoda, se misturar com loucos e lunáticos? Curioso. Embora você pareça se associar a animais falantes e… criaturas de outro tempo. Suponho que eu não seja mais ou menos excêntrico do que qualquer outro membro da sua coleção.",shape=box,color=blue];
		j986302104 -> j2845885253;
	j1836744271 [label="Que escassez de opções sensatas você encontrou, quando um louco e um lunático são sua única fonte para uma opinião \"neutra\". Não consigo entender por que você se dá ao trabalho de falar comigo. ",shape=box,color=blue];
		j1836744271 -> j2845885253;
	j3938185035 [label="Por que você insiste em falar comigo? Você não precisa, sabia disso? Se deseja se aproximar, ou até mesmo cortejar a Marie, eu não sou responsável por ela, nem o pai dela. E, sejam quais forem suas intenções com aquele desgraçado do Roathe, pouco me importa além das respostas que ele me deve.",shape=box,color=blue];
		j3938185035 -> j2845885253;
	j4034696467 [label="\"Verdade.\" Gostaria que você entendesse o quão ridículo isso tem sido para mim ultimamente. Não te incomoda, se misturar com loucos e lunáticos? Curioso. Embora você pareça se associar a animais falantes e… criaturas de outro tempo. Suponho que eu não seja mais ou menos excêntrico do que qualquer outro membro da sua coleção.",shape=box,color=blue];
		j4034696467 -> j2845885253;
	j2845885253 [label="Evaluate expressions",color=orange];
		j2845885253 -> j1216804734 [label="LyonFirstFlirt",color=purple];
		j2845885253 -> j1216804734 [label="DrifterLyon",color=purple];
		j2845885253 -> j3841995405 [label="LyonOffer",color=purple];
		j2845885253 -> j3744403248 [label="false",color=purple];
	j1216804734 [label="E, por favor, nos poupe de mais um… momento constrangedor, certo? Eu sei que o que você disse foram os motivos pelos quais você falou comigo. E, embora eu os ache lisonjeiros, também os considero ridiculamente insinceros.",shape=box,color=blue];
		j1216804734 -> j2501079956;
		j1216804734 -> j2162322796;
		j1216804734 -> j3880295775;
	j3841995405 [label="E, por favor, poupe-nos de mais um sermão sobre como você deseja \"me ajudar\", certo? Tenho certeza de que sua intenção é ser gentil, mas a sua insinceridade ridícula é irritante.",shape=box,color=blue];
		j3841995405 -> j2501079956;
		j3841995405 -> j2162322796;
		j3841995405 -> j3880295775;
	j3744403248 [label="E, por favor, poupe-nos de um longo sermão sobre como você deseja me \"ajudar\" ou como \"deseja ser meu amigo\". Tenho certeza de que sua intenção é ser gentil, mas a sua insinceridade ridícula é irritante. ",shape=box,color=blue];
		j3744403248 -> j2501079956;
		j3744403248 -> j2162322796;
		j3744403248 -> j3880295775;
	j2501079956 [label="Insincero porque você acha que eu não tô falando sério, ou insincero porque você acha impossível eu falar isso sobre você?",shape=box,color=red];
		j2501079956 -> j2621276592;
	j2162322796 [label="Padre, tudo o que eu queria era saber por quanto tempo o Entrati fingiu ser o Cardeal, só isso",shape=box,color=red];
		j2162322796 -> j3901290835;
	j3880295775 [label="O que quer dizer com \"insincero\"? Tá me chamando de mentiroso?",shape=box,color=red];
		j3880295775 -> j5625625;
	j2621276592 [label="Nenhuma das opções. Suas palavras são uma caridade que eu não preciso, nem quero.",shape=box,color=blue];
		j2621276592 -> j2609808402;
		j2621276592 -> j239438281;
	j3901290835 [label="Exatamente. Durante 3 anos, 2 meses e 11 dias, ele serviu como Cardeal Dimanche em nossa Catedral. E durante todo esse tempo, a Marie e eu o servimos, sem saber o que ele planejava para nós.",shape=box,color=blue];
		j3901290835 -> j184901585;
	j5625625 [label="Evaluate expressions",color=orange];
		j5625625 -> j1809656118 [label="DrifterLiar",color=purple];
		j5625625 -> j3551930048 [label="LyonSuspicious",color=purple];
		j5625625 -> j1891596430 [label="false",color=purple];
	j2609808402 [label="Como é que a Marie aguenta isso…",shape=box,color=red];
		j2609808402 -> j1584877586;
	j239438281 [label="Você acha que qualquer pessoa que escolha socializar com você tá praticando um ato de \"caridade\", é?",shape=box,color=red];
		j239438281 -> j3855021406;
	j184901585 [label="Eu já sei quais são as suas perguntas antes mesmo de você as fazer. O que ele estava tramando? Ele infectou a cidade, como ouvi dizer que fez com Holvânia? Quais eram os seus planos? Suas descobertas?",shape=box,color=blue];
		j184901585 -> j1849600614;
	j1809656118 [label="Tem algo que deseja confessar, Peregrino? Há alguma penitência que deseja pagar?",shape=box,color=blue];
		j1809656118 -> j2717568980;
	j3551930048 [label="Hum. Não, talvez ainda não.",shape=box,color=blue];
		j3551930048 -> j1891596430;
	j1891596430 [label="Sua insinceridade não é uma mentira, é uma demonstração de caridade. Caridade que eu não preciso, nem quero. ",shape=box,color=blue];
		j1891596430 -> j2609808402;
		j1891596430 -> j239438281;
	j1584877586 [label="O melhor é perguntar a ela você mesmo. Eu também já me perguntei isso várias vezes. ",shape=box,color=blue];
		j1584877586 -> "Chat ends.";
	j3855021406 [label="Em resumo… sim.",shape=box,color=blue];
		j3855021406 -> j3994772085;
	j1849600614 [label="A essas pessoas, eu digo: vocês ficarão desapontados. Durante esses 3 anos, 2 meses e 11 dias? Ele pregou, estudou, descansou e orou.",shape=box,color=blue];
		j1849600614 -> j959732201;
		j1849600614 -> j4031053164;
		j1849600614 -> j2534634983;
	j2717568980 [label="Isso não vem ao caso. Você não veio a esta conversa buscando perdão, e suas mentiras passadas não são as mesmas que suas insinceridades atuais. ",shape=box,color=blue];
		j2717568980 -> j3197066639;
	j3994772085 [label="Boolean LyonHate1 is now true.",color=orange];
		j3994772085 -> j3746256104;
		j3994772085 -> j258901010;
		j3994772085 -> j1192219465;
	j959732201 [label="Quando foi que ele transformou vocês em Protoframes?",shape=box,color=red];
		j959732201 -> j553724126;
	j4031053164 [label="Tô tendo muita dificuldade em imaginar o Entrati rezando…",shape=box,color=red];
		j4031053164 -> j3191051565;
	j2534634983 [label="Então ele estava… em período sabático?!",shape=box,color=red];
		j2534634983 -> j2694599427;
	j3197066639 [label="O que você diz agora é mera caridade. Caridade que não preciso, nem quero.",shape=box,color=blue];
		j3197066639 -> j2609808402;
		j3197066639 -> j239438281;
	j3746256104 [label="É algo pra analisarmos outro dia, sinto que esta conversa tá saindo do controle",shape=box,color=red];
		j3746256104 -> j2208768070;
	j258901010 [label="E quanto a Marie…",shape=box,color=red];
		j258901010 -> j1886965553;
	j1192219465 [label="Você deve ter uma péssima opinião de si mesmo",shape=box,color=red];
		j1192219465 -> j1266035885;
	j553724126 [label="Após esses 3 anos e alguns dias, ele desapareceu em meio a uma terrível tempestade. A mesma em que aparecera.",shape=box,color=blue];
		j553724126 -> j3307858394;
	j3191051565 [label="É impossível conhecer os meandros da mente de outra pessoa. Ele ajoelhou-se diante do altar e sua cabeça estava baixa. Estaria ele em oração? Ou estaria simplesmente perdido em seus próprios pensamentos? Eu não sei.",shape=box,color=blue];
		j3191051565 -> j553724126;
	j2694599427 [label="+5 Chemistry",color=orange];
		j2694599427 -> j3248962491;
	j2208768070 [label="+5 Chemistry",color=orange];
		j2208768070 -> j4271725736;
	j1886965553 [label="A Marie aconchegaria um urso raivoso no colo e deixaria que ele lhe rasgasse a garganta se achasse que isso traria ao animal um momento de paz.",shape=box,color=blue];
		j1886965553 -> j1578714759;
	j1266035885 [label="Eu consideraria isso uma dedicação inabalável ao pragmatismo, mas defina-o como quiser. ",shape=box,color=blue];
		j1266035885 -> j1461136699;
	j3307858394 [label="Evaluate expressions",color=orange];
		j3307858394 -> j3167500939 [label="MarieLyonVisions",color=purple];
		j3307858394 -> j3167500939 [label="LyonVisions1",color=purple];
		j3307858394 -> j3413754359 [label="false",color=purple];
	j3248962491 [label="Heh. Não tinha pensado nisso dessa forma, mas sim, talvez você tenha razão. Que coisa mais irritante para todos vocês. Parece combinar com o pouco que sabemos sobre sua verdadeira personalidade.",shape=box,color=blue];
		j3248962491 -> j553724126;
	j4271725736 [label="Essa provavelmente é uma decisão sábia. Você estava perguntando sobre o \"Cardeal Dimanche\" e seu período na Catedral. ",shape=box,color=blue];
		j4271725736 -> j3013704755;
	j1578714759 [label="Ela é uma alma singularmente bela, que protegerei até meu último suspiro. ",shape=box,color=blue];
		j1578714759 -> j1461136699;
	j1461136699 [label="+5 Chemistry",color=orange];
		j1461136699 -> j2320139177;
	j3167500939 [label="Embora eu saiba que a tempestade não aconteceu com outras pessoas, ela foi bastante vívida para mim. ",shape=box,color=blue];
		j3167500939 -> j3413754359;
	j3413754359 [label="Exatamente 1 ano depois, ele reapareceu pela última vez, com… o Roathe, como você o vê agora, caído e inconsciente a seus pés.",shape=box,color=blue];
		j3413754359 -> j2725937716;
	j3013704755 [label="Durante 3 anos, 2 meses e 11 dias, ele serviu como Cardeal Dimanche em nossa Catedral. E durante todo esse tempo, a Marie e eu o servimos, sem saber o que ele planejava para nós.",shape=box,color=blue];
		j3013704755 -> j184901585;
	j2320139177 [label="Mas é isso que você deve esperar, fazer uma pergunta simples a um louco geralmente é um caminho tortuoso. Permita-me redirecioná-lo ao seu tópico original e nos afastar do meu. ",shape=box,color=blue];
		j2320139177 -> j3013704755;
	j2725937716 [label="Um demônio em pessoa, ou assim parecia. Foi então que o Entrati nos revelou a verdade sobre quem ele era quando nos chamou, e a verdadeira tarefa que tinha para nós.",shape=box,color=blue];
		j2725937716 -> j2023393300;
	j2023393300 [label="Que ele nos havia escolhido a ambos para uma \"missão sagrada\".",shape=box,color=blue];
		j2023393300 -> j2481738749;
		j2023393300 -> j4012335857;
	j2481738749 [label="Por que as aspas? ",shape=box,color=red];
		j2481738749 -> j477829876;
	j4012335857 [label="Parece que você não acredita nele",shape=box,color=red];
		j4012335857 -> j477829876;
	j477829876 [label="Aprendi muita coisa que me faz questionar a adesão do Entrati a qualquer coisa sacrossanta relacionada à natureza ou a qualquer deus… se é que tal coisa existe…",shape=box,color=blue];
		j477829876 -> j380718371;
		j477829876 -> j374756343;
	j380718371 [label="Se é que tal coisa existe? Lyon, o que você quer dizer? ",shape=box,color=red];
		j380718371 -> j1146336576;
	j374756343 [label="Prossiga",shape=box,color=red];
		j374756343 -> j2933879643;
	j1146336576 [label="Boolean LyonFaith2 is now true.",color=orange];
		j1146336576 -> j2632823287;
	j2933879643 [label="A Marie aceitou o soro prontamente. Claro que aceitou, como poderia recusar? E como eu poderia não segui-la? Como eu poderia não buscar a verdade, aonde quer que ela me levasse?",shape=box,color=blue];
		j2933879643 -> j1813802388;
	j2632823287 [label="Assunto para outra ocasião, por favor.",shape=box,color=blue];
		j2632823287 -> j2933879643;
	j1813802388 [label="Boolean LyonSerum1 is now true.",color=orange];
		j1813802388 -> j2612306671;
		j1813802388 -> j3763861533;
		j1813802388 -> j2751288685;
	j2612306671 [label="Acho que ela idolatra o Entrati um pouco… demais",shape=box,color=red];
		j2612306671 -> j1310883806;
	j3763861533 [label="O que aconteceu depois?",shape=box,color=red];
		j3763861533 -> j3906073929;
	j2751288685 [label="Você se arrepende?",shape=box,color=red];
		j2751288685 -> j1048950218;
	j1310883806 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j1310883806 -> j2456428562;
	j3906073929 [label="O Roathe acordou. A princípio, mal conseguia se lembrar do próprio nome. O Entrati disse uma última frase ao bastardo: \"Uriel, Herege de Xata, exilado, responda: os Orokin poderão ser perdoados?\"",shape=box,color=blue];
		j3906073929 -> j94442740;
	j1048950218 [label="Eu me arrependo de tudo, Peregrino. Sim, claro que me arrependo. Mas faria tudo de novo? Sim, claro que faria. Não posso deixar a Marie sozinha.",shape=box,color=blue];
		j1048950218 -> j606113946;
	j2456428562 [label="Nisso, concordamos. Mas também não posso culpá-la por isso. Dê-lhe tempo, ela vai entender. Ela é extremamente inteligente, Peregrino. Não a trate como uma tola.",shape=box,color=blue];
		j2456428562 -> j606113946;
	j94442740 [label="O Entrati partiu então pela última vez. E deixou o Roathe conosco, agora transformado no que você vê agora, mais capaz de lidar com seu temperamento do diabo.",shape=box,color=blue];
		j94442740 -> j1985263910;
	j606113946 [label="Para concluir a história… o Entrati partiu então, pela última vez. E deixou o Roathe conosco, agora transformado no que vocês veem agora, mais capaz de lidar com seu temperamento do diabo.",shape=box,color=blue];
		j606113946 -> j1985263910;
	j1985263910 [label="O resto, receio, é uma história que terá de esperar. Sr. Loid requer o uso do POM-2 e estou ansioso para me desfazer dele. Espero que isto tenha ajudado a responder pelo menos algumas das suas perguntas.",shape=box,color=blue];
		j1985263910 -> j589592964;
		j1985263910 -> j1144204180;
	j589592964 [label="Respondeu algumas, e criou o dobro de novas…",shape=box,color=red];
		j589592964 -> j2449941436;
	j1144204180 [label="Respondeu sim, valeu",shape=box,color=red];
		j1144204180 -> j1468545363;
	j2449941436 [label="+15 Chemistry",color=orange];
		j2449941436 -> j1312801657;
	j1468545363 [label="+10 Chemistry",color=orange];
		j1468545363 -> j3171838131;
	j1312801657 [label="Então, cumpri meu dever como sacerdote. Desejo-te uma boa noite. ",shape=box,color=blue];
		j1312801657 -> j3855476688;
	j3171838131 [label="Então, lhe desejo boa noite.",shape=box,color=blue];
		j3171838131 -> j3855476688;
	j3855476688 [label="- Padre Lyon Allard",shape=box,color=blue];
