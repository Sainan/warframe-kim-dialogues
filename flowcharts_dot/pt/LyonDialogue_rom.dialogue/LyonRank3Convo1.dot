digraph {
	0 [label="LyonRank3Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Saudações, Peregrino.",shape=box,color=blue];
		1 -> 2;
	2 [label="Soube que você deseja falar comigo.",shape=box,color=blue];
		2 -> 3;
		2 -> 4;
		2 -> 5;
	3 [label="É um prazer conversar com você aqui, Lyon. Agradeço!",shape=box,color=red];
		3 -> 6;
	4 [label="Marie finalmente te convenceu que não sou uma ameaça?",shape=box,color=red];
		4 -> 7;
	5 [label="Ah! Oi, Lyon. Sinceramente, não achei que você seria convencido. Fico feliz que tenha mudado de ideia",shape=box,color=red];
		5 -> 8;
	6 [label="No fim, talvez você se arrependa de ter insistido tanto, mas tudo bem. Não há de quê.",shape=box,color=blue];
		6 -> 9;
		6 -> 10;
	7 [label="Não me inspire a encontrar razões para mudar de ideia tão rapidamente.",shape=box,color=blue];
		7 -> 11;
	8 [label="É, bem. Talvez você não fique tão feliz com isso no fim.",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
	9 [label="Pelo que entendi das conversas com os outros, você tem assuntos que precisamos discutir. Posso te ajudar em algo?",shape=box,color=red];
		9 -> 12;
	10 [label="Tem algo de errado?",shape=box,color=red];
		10 -> 13;
	11 [label="+10 Chemistry",color=orange];
		11 -> 14;
	12 [label="Talvez, com o tempo. Mas mal começamos nossa conversa. Vim aqui somente para… dizer que cedi à insistência de Marie de que você é confiável, ao menos no que diz respeito a conversas.",shape=box,color=blue];
		12 -> 15;
	13 [label="Que pergunta insuficiente e quase cômica, uma que nem me darei ao trabalho de responder, já que mal começamos nossa conversa. Vim aqui somente para… dizer que cedi à insistência de Marie de que você é confiável, ao menos no que diz respeito a conversas.",shape=box,color=blue];
		13 -> 15;
	14 [label="Chat ends.",color=orange];
	15 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		15 -> 16 [label="x > 0",color=purple];
		15 -> 17 [label="x <= 0",color=purple];
		15 -> 17 [label="false",color=purple];
	16 [label="E, considerando que agora somos parceiros nesta missão que Roathe está \"infernalmente\" empenhado em perseguir, parece prudente que nos conheçamos melhor. Esse parece ser seu método de escolha. Portanto, aqui estou.",shape=box,color=blue];
		16 -> 18;
		16 -> 19;
	17 [label="E, considerando que podemos ou não ser parceiros eternos nesta missão que Roathe está \"infernalmente\" empenhado em perseguir, parece prudente que nos conheçamos melhor. Esse parece ser seu método de escolha. Portanto, aqui estou.",shape=box,color=blue];
		17 -> 18;
		17 -> 19;
	18 [label="Sinto que já comecei isso da maneira errada, de alguma forma",shape=box,color=red];
		18 -> 20;
	19 [label="Existe… outro método que você prefira?",shape=box,color=red];
		19 -> 21;
	20 [label="Não. De modo algum. Simplesmente não sou o tipo de indivíduo com quem você costuma conversar. Até agora, você tem sido uma pessoa abençoada, embora lunáticos do meu calibre sejam raros.",shape=box,color=blue];
		20 -> 22;
	21 [label="Não. Esse é aceitável. Aliás, me permite ter tempo para organizar meus pensamentos da forma que gostaria. Compreendo o apelo deste dispositivo.",shape=box,color=blue];
		21 -> 23;
	22 [label="Mas estou me desviando do assunto. Receio que não vim aqui para passar muito tempo \"digitando\", o que penso ser uma decepção para você. Somente desejava lhe informar da minha rendição.",shape=box,color=blue];
		22 -> 24;
		22 -> 25;
	23 [label="No entanto, receio que não vim aqui para passar muito tempo \"digitando\", o que penso ser uma decepção para você. Somente desejava lhe informar da minha rendição.",shape=box,color=blue];
		23 -> 25;
		23 -> 24;
	24 [label="Marie é ainda mais perigosa do que parece, né?",shape=box,color=red];
		24 -> 26;
	25 [label="Bem, mais uma vez, gostaria de agradecê-lo",shape=box,color=red];
		25 -> 27;
	26 [label="+20 Chemistry",color=orange];
		26 -> 28;
	27 [label="+15 Chemistry",color=orange];
		27 -> 29;
	28 [label="Você apenas começou a suspeitar da profundidade dessas águas.",shape=box,color=blue];
		28 -> 30;
	29 [label="Se lhe serve de algo, não há de quê.",shape=box,color=blue];
		29 -> 30;
	30 [label="- Padre Lyon Allard",shape=box,color=blue];
		30 -> 31;
	31 [label="Chat ends.",color=orange];
}