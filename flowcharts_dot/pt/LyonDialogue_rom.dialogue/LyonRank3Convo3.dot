digraph {
	114 [label="LyonRank3Convo3 begins.",color=orange];
		114 -> 115;
	115 [label="Eu estava ajudando o Sr. Loid em sua biblioteca, recolocando os livros nas prateleiras, embora ele insistisse que aquelas estranhas engenhocas voadoras… poderiam fazer o trabalho.",shape=box,color=blue];
		115 -> 116;
	116 [label="E deparei-me com um curioso volume que detalha contos infantis, ambientados num mundo fictício escrito por uma tal de Euleria Entrati.",shape=box,color=blue];
		116 -> 117;
	117 [label="Ao notar que o autor compartilhava o sobrenome com o verdadeiro nome do nosso \"Cardeal Dimanche\", imediatamente reservei o exemplar para mim.",shape=box,color=blue];
		117 -> 120;
		117 -> 119;
		117 -> 118;
	120 [label="Acho que sei a qual livro você está se referindo…",shape=box,color=red];
		120 -> 123;
	119 [label="Dá pra pular o preâmbulo, por favor? Pergunta o que você quer saber",shape=box,color=red];
		119 -> 122;
	118 [label="[Ignorar]",shape=box,color=red];
		118 -> 121;
	123 [label="+5 Chemistry",color=orange];
		123 -> 125;
	122 [label="Update boolean LyonMITW1",color=orange];
		122 -> 124;
	121 [label="Chat ends.",color=orange];
	125 [label="Eu suspeito, a julgar pelo olhar horrorizado que o Sr. Loid me lançou, e pela sua insistência para que eu devolvesse o livro imediatamente, \"para não a perturbar\", que você sabe alguma coisa sobre ele, sim.",shape=box,color=blue];
		125 -> 128;
	124 [label="Minha pergunta está relacionada à natureza da \"Incorporação Conceitual\". Após a leitura, ficou claro para mim que o livro tinha como objetivo ensinar crianças a impedir que suas emoções interagissem com o Void.",shape=box,color=blue];
		124 -> 126;
		124 -> 127;
	128 [label="\"Os Contos de Duviri\". Embora eu tenha recebido uma explicação bastante… exausta e longa do Sr. Loid sobre o que você passou, há uma questão específica sobre a qual eu gostaria de perguntar.",shape=box,color=blue];
		128 -> 131;
	126 [label="Para o pouco que serviu. Principalmente no meu caso.",shape=box,color=red];
		126 -> 129;
	127 [label="Emoções fortes interagindo com o Void podem causar… problemas sérios",shape=box,color=red];
		127 -> 130;
	131 [label="Se, é claro, não for muito incômodo fazê-lo?",shape=box,color=blue];
		131 -> 134;
		131 -> 135;
	129 [label="Quantas coisas em nossas vidas nos foram ditadas por outros como verdades absolutas, somente para se provarem inúteis quando testadas?",shape=box,color=blue];
		129 -> 132;
	130 [label="Assim parece. Encontrei as Cavias. Ouvi falar dos Anjos do Void. Presenciei o Murmúrio em primeira mão. ",shape=box,color=blue];
		130 -> 133;
	134 [label="Não, pode prosseguir",shape=box,color=red];
		134 -> 122;
	135 [label="Depende inteiramente dos detalhes, não tenho ideia do que você tá prestes a me perguntar",shape=box,color=red];
		135 -> 140;
	132 [label="Update boolean LyonFaith1",color=orange];
		132 -> 136;
	133 [label="E essa é a natureza da minha curiosidade. Vim a questionar isso \"em voz alta\" para ver se você seria capaz de explicar. Quando o Void ganha forma, o que emerge dele - é \"real\"?",shape=box,color=blue];
		133 -> 137;
		133 -> 138;
		133 -> 139;
	140 [label="+5 Chemistry",color=orange];
		140 -> 146;
	136 [label="Muitas vezes me pergunto: por que encher a cabeça dos outros com mentiras tão inúteis? Será que buscam poder? Influência? Ou será que acreditam sinceramente em suas próprias palavras e ignoram as próprias mentiras?",shape=box,color=blue];
		136 -> 142;
		136 -> 141;
	137 [label="Não, eu acho que tudo o que é criado pelo Void é simplesmente… temporário. Um fragmento de quem quer que o tenha criado, um fantasma de uma memória",shape=box,color=red];
		137 -> 143;
	138 [label="Acredito que sim. Como uma pintura feita por um artista, pode ter surgido da mente de alguém, mas se torna real depois de criada",shape=box,color=red];
		138 -> 144;
	139 [label="Isso depende inteiramente da sua definição de \"real\"",shape=box,color=red];
		139 -> 145;
	146 [label="Sim, me perdoe. Não sou muito bom em… conversar de forma direta. Principalmente de um jeito tão estranho quanto este. Mas vou me esforçar para fazer isso agora.",shape=box,color=blue];
		146 -> 122;
	142 [label="Neste caso, creio que a Euleria Entrati pretendia que o que escreveu fosse útil. Simplesmente não me ajudou quando precisei",shape=box,color=red];
		142 -> 148;
	141 [label="Não sei. De que mentiras sua cabeça estava cheia, Lyon?",shape=box,color=red];
		141 -> 147;
	143 [label="Então, os efeitos causados por tais elementos do Void não são \"reais\"?",shape=box,color=blue];
		143 -> 149;
	144 [label="Mas a analogia que você usa não é totalmente precisa, não é? A matéria retirada do Void retorna ao Void, não é?",shape=box,color=blue];
		144 -> 150;
	145 [label="+5 Chemistry",color=orange];
		145 -> 151;
	148 [label="Em sua defesa, minha exposição ao Void foi muito mais prolongada do que ela pretendia que o livro fosse usado como guia",shape=box,color=red];
		148 -> 153;
	147 [label="Nenhuma que eu tenha vindo discutir com você.",shape=box,color=blue];
		147 -> 152;
	149 [label="Muitas lembranças levaram homens à bebida ou os inspiraram a tirar a própria vida. Essas lembranças não são \"reais\"?",shape=box,color=blue];
		149 -> 154;
	150 [label="Muito bem, então, uma ideia: um poema ou uma canção existe, mesmo que não esteja escrito",shape=box,color=red];
		150 -> 155;
	151 [label="Poderia dar mais detalhes?",shape=box,color=blue];
		151 -> 156;
	153 [label="+5 Chemistry",color=orange];
		153 -> 157;
	152 [label="Chat ends.",color=orange];
	154 [label="Mas o meu ponto é que essas eram forças internas que o homem deixava agir sobre ele, não forças externas",shape=box,color=red];
		154 -> 158;
	155 [label="Mas se for esquecida, deixa de existir. Uma história perdida no tempo se perde para sempre.",shape=box,color=blue];
		155 -> 159;
	156 [label="Como se mede a \"realidade\"?",shape=box,color=red];
		156 -> 160;
		156 -> 161;
		156 -> 162;
	157 [label="A ignorância infeliz é a melhor coisa que qualquer um de nós pode esperar que cause a malignidade em outros.",shape=box,color=blue];
		157 -> 163;
	158 [label="Mas qual é a diferença, essa é a minha pergunta? Se o resultado final é o mesmo, isso importa?",shape=box,color=blue];
		158 -> 164;
		158 -> 165;
		158 -> 166;
	159 [label="Uma revolução que nasce na mente daqueles que a empunham é, de fato, uma espada sem fio.",shape=box,color=blue];
		159 -> 164;
		159 -> 165;
		159 -> 166;
	160 [label="Por permanência física? Peso e massa? O que veio do Void tá aqui só temporariamente",shape=box,color=red];
		160 -> 167;
	161 [label="Qual o seu efeito sobre os acontecimentos? O que veio do Void mudou o curso da história",shape=box,color=red];
		161 -> 168;
	162 [label="Pelo seu efeito sobre os outros? A influência de \"coisas\" que vieram do Void certamente teve esse efeito",shape=box,color=red];
		162 -> 169;
	163 [label="Minha curiosidade, no entanto, não se refere ao livro nem à sua utilidade. Perdoem-me por me deixar levar por um momento de poesia.",shape=box,color=blue];
		163 -> 170;
	164 [label="Você não está perguntando se eles são \"reais\", você está perguntando se eles são \"válidos\". Se eles devem ser descartados ou não",shape=box,color=red];
		164 -> 171;
	165 [label="Eu também perguntaria se seus Luminários são \"reais\", simplesmente porque você não pode apertar a mão do Sol ou da Lua",shape=box,color=red];
		165 -> 172;
	166 [label="Você tá perguntando, de forma indireta, se todas as \"coisas\" do Void só existem porque nós as trouxemos à existência por vontade própria",shape=box,color=red];
		166 -> 173;
	167 [label="O que vem do Void deve retornar a ele, é isso que você está dizendo? Mas o Void não é, por definição, composto de nada?",shape=box,color=blue];
		167 -> 174;
	168 [label="Um ponto válido. Uma revolução deixa de ser \"real\" simplesmente porque não se pode colocá-la numa cesta e pesá-la?",shape=box,color=blue];
		168 -> 169;
	169 [label="Certamente custou a vida de muitas pessoas. Elas argumentariam veementemente contra a sua validade. No entanto, considere o seguinte:",shape=box,color=blue];
		169 -> 175;
	170 [label="Vim a questionar isso \"em voz alta\" para ver se você seria capaz de explicar. Quando o Void ganha forma, o que emerge dele - é \"real\"?",shape=box,color=blue];
		170 -> 137;
		170 -> 139;
		170 -> 138;
	171 [label="+5 Chemistry",color=orange];
		171 -> 176;
	172 [label="Não estamos falando dos Luminários. Estamos falando do Void.",shape=box,color=blue];
		172 -> 177;
		172 -> 178;
		172 -> 179;
		172 -> 180;
	173 [label="+5 Chemistry",color=orange];
		173 -> 181;
	174 [label="Suponho que sim? As partes do Void com as quais interagi já tendem a estar impressas. Já lhes demos algum tipo de forma ou figura. Ou então, borramos demais a linha que separa as realidades",shape=box,color=red];
		174 -> 182;
		174 -> 183;
	175 [label="Uma revolução só adquire validade por existir na mente daqueles que a conduzem.",shape=box,color=blue];
		175 -> 184;
	176 [label="Sim, acho que você poderia formular a pergunta dessa maneira. Devemos ignorar os fantasmas que assombram nossos corredores ou, ao lhes darmos qualquer atenção, estaremos os fortalecendo?",shape=box,color=blue];
		176 -> 177;
		176 -> 178;
		176 -> 179;
		176 -> 180;
	177 [label="Acredito que os desafios que enfrentamos agora são perigosos, e muito. E devemos tratá-los como tal",shape=box,color=red];
		177 -> 185;
	178 [label="Fantasmas são reais o suficiente para nos causar dor. Mas não podem ser eliminados com uma bala… pelo menos não com uma que eu tenha encontrado",shape=box,color=red];
		178 -> 186;
	179 [label="Do que se trata tudo isso, Lyon?",shape=box,color=red];
		179 -> 187;
	180 [label="Eu… sinceramente não sei, Lyon. E gostaria de saber",shape=box,color=red];
		180 -> 188;
	181 [label="Sim, acho que você poderia formular dessa maneira. Como podemos ter certeza de que não… manifestamos nossos próprios demônios?",shape=box,color=blue];
		181 -> 177;
		181 -> 178;
		181 -> 179;
		181 -> 180;
	182 [label="Estruturas inteiras, inclusive a própria Lua, foram colocadas no Void e recuperadas. Portanto, ele não consome matéria simplesmente por existir",shape=box,color=red];
		182 -> 189;
	183 [label="O que você tá insinuando é a existência de um Void \"mais profundo\" onde nada pode existir, e sinceramente não sei falar sobre isso",shape=box,color=red];
		183 -> 190;
	184 [label="Se fosse apagado dos pensamentos de todos ao redor, deixaria de existir, não é mesmo?",shape=box,color=blue];
		184 -> 165;
		184 -> 164;
		184 -> 166;
	185 [label="Update boolean LyonReal1",color=orange];
		185 -> 191;
	186 [label="Update boolean LyonFake1",color=orange];
		186 -> 192;
	187 [label="Update boolean LyonFaith1",color=orange];
		187 -> 193;
	188 [label="Sua honestidade em admitir o que você não sabe é revigorante. Quem dera mais pessoas tivessem esse dom.",shape=box,color=blue];
		188 -> 194;
	189 [label="Não me importo com a matéria colocada no Void e recuperada. O que me importa é o que foi inventado a partir do Void, completamente do nada.",shape=box,color=blue];
		189 -> 164;
		189 -> 165;
		189 -> 166;
	190 [label="Agradeço a sinceridade. Suponho que me interesso menos pelo que não pode existir e mais pelo que existe atualmente.",shape=box,color=blue];
		190 -> 164;
		190 -> 165;
		190 -> 166;
	191 [label="Sim, suponho que você saiba o que pode ser arrancado do Void pela força e o que não pode…",shape=box,color=blue];
		191 -> 195;
	192 [label="Talvez seja por isso que tantos se entregam aos excessos… para estancar uma ferida sangrenta, invisível, mas dolorosa. Curável. Mas pela força da alma, não por armamentos.",shape=box,color=blue];
		192 -> 195;
	193 [label="Claramente, abordei tudo isso da maneira errada. Discutiremos isso em outra ocasião. Perdoe minha intromissão.",shape=box,color=blue];
		193 -> 196;
	194 [label="Independentemente disso, continuo com a minha opinião sobre o assunto completamente indefinida.",shape=box,color=blue];
		194 -> 193;
	195 [label="Embora, como sempre, eu ainda tenha dúvidas. Perdoe minha intromissão. Obrigado pelo seu tempo, Peregrino.",shape=box,color=blue];
		195 -> 196;
	196 [label="- Padre Lyon Allard",shape=box,color=blue];
		196 -> 197;
	197 [label="Chat ends.",color=orange];
}