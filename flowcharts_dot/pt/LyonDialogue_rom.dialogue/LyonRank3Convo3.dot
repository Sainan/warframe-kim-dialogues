digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank3Convo3 begins." [color=orange];
		"LyonRank3Convo3 begins." -> j1224226825;
	j1224226825 [label="Eu estava ajudando o Sr. Loid em sua biblioteca, recolocando os livros nas prateleiras, embora ele insistisse que aquelas estranhas engenhocas voadoras… poderiam fazer o trabalho.",shape=box,color=blue];
		j1224226825 -> j3280179846;
	j3280179846 [label="E deparei-me com um curioso volume que detalha contos infantis, ambientados num mundo fictício escrito por uma tal de Euleria Entrati.",shape=box,color=blue];
		j3280179846 -> j3712685292;
	j3712685292 [label="Ao notar que o autor compartilhava o sobrenome com o verdadeiro nome do nosso \"Cardeal Dimanche\", imediatamente reservei o exemplar para mim.",shape=box,color=blue];
		j3712685292 -> j1808424699;
		j3712685292 -> j1490593557;
		j3712685292 -> j1678137900;
	j1808424699 [label="Acho que sei a qual livro você está se referindo…",shape=box,color=red];
		j1808424699 -> j2002677732;
	j1490593557 [label="Dá pra pular o preâmbulo, por favor? Pergunta o que você quer saber",shape=box,color=red];
		j1490593557 -> j199829296;
	j1678137900 [label="[Ignorar]",shape=box,color=red];
		j1678137900 -> "Chat ends.";
	j2002677732 [label="+5 Chemistry",color=orange];
		j2002677732 -> j3354973431;
	j199829296 [label="Boolean LyonMITW1 is now true.",color=orange];
		j199829296 -> j818181967;
	"Chat ends." [color=orange];
	j3354973431 [label="Eu suspeito, a julgar pelo olhar horrorizado que o Sr. Loid me lançou, e pela sua insistência para que eu devolvesse o livro imediatamente, \"para não a perturbar\", que você sabe alguma coisa sobre ele, sim.",shape=box,color=blue];
		j3354973431 -> j3028397926;
	j818181967 [label="Minha pergunta está relacionada à natureza da \"Incorporação Conceitual\". Após a leitura, ficou claro para mim que o livro tinha como objetivo ensinar crianças a impedir que suas emoções interagissem com o Void.",shape=box,color=blue];
		j818181967 -> j483804678;
		j818181967 -> j987806764;
	j3028397926 [label="\"Os Contos de Duviri\". Embora eu tenha recebido uma explicação bastante… exausta e longa do Sr. Loid sobre o que você passou, há uma questão específica sobre a qual eu gostaria de perguntar.",shape=box,color=blue];
		j3028397926 -> j2151396669;
	j483804678 [label="Para o pouco que serviu. Principalmente no meu caso.",shape=box,color=red];
		j483804678 -> j197352980;
	j987806764 [label="Emoções fortes interagindo com o Void podem causar… problemas sérios",shape=box,color=red];
		j987806764 -> j94054985;
	j2151396669 [label="Se, é claro, não for muito incômodo fazê-lo?",shape=box,color=blue];
		j2151396669 -> j731540401;
		j2151396669 -> j3103817370;
	j197352980 [label="Quantas coisas em nossas vidas nos foram ditadas por outros como verdades absolutas, somente para se provarem inúteis quando testadas?",shape=box,color=blue];
		j197352980 -> j3560126128;
	j94054985 [label="Assim parece. Encontrei as Cavias. Ouvi falar dos Anjos do Void. Presenciei o Murmúrio em primeira mão. ",shape=box,color=blue];
		j94054985 -> j2350927569;
	j731540401 [label="Não, pode prosseguir",shape=box,color=red];
		j731540401 -> j199829296;
	j3103817370 [label="Depende inteiramente dos detalhes, não tenho ideia do que você tá prestes a me perguntar",shape=box,color=red];
		j3103817370 -> j1726290306;
	j3560126128 [label="Boolean LyonFaith1 is now true.",color=orange];
		j3560126128 -> j17354272;
	j2350927569 [label="E essa é a natureza da minha curiosidade. Vim a questionar isso \"em voz alta\" para ver se você seria capaz de explicar. Quando o Void ganha forma, o que emerge dele - é \"real\"?",shape=box,color=blue];
		j2350927569 -> j518242401;
		j2350927569 -> j1208497108;
		j2350927569 -> j1166756461;
	j1726290306 [label="+5 Chemistry",color=orange];
		j1726290306 -> j2675198256;
	j17354272 [label="Muitas vezes me pergunto: por que encher a cabeça dos outros com mentiras tão inúteis? Será que buscam poder? Influência? Ou será que acreditam sinceramente em suas próprias palavras e ignoram as próprias mentiras?",shape=box,color=blue];
		j17354272 -> j3987429950;
		j17354272 -> j1276452801;
	j518242401 [label="Não, eu acho que tudo o que é criado pelo Void é simplesmente… temporário. Um fragmento de quem quer que o tenha criado, um fantasma de uma memória",shape=box,color=red];
		j518242401 -> j804799854;
	j1208497108 [label="Acredito que sim. Como uma pintura feita por um artista, pode ter surgido da mente de alguém, mas se torna real depois de criada",shape=box,color=red];
		j1208497108 -> j925992893;
	j1166756461 [label="Isso depende inteiramente da sua definição de \"real\"",shape=box,color=red];
		j1166756461 -> j2098133789;
	j2675198256 [label="Sim, me perdoe. Não sou muito bom em… conversar de forma direta. Principalmente de um jeito tão estranho quanto este. Mas vou me esforçar para fazer isso agora.",shape=box,color=blue];
		j2675198256 -> j199829296;
	j3987429950 [label="Neste caso, creio que a Euleria Entrati pretendia que o que escreveu fosse útil. Simplesmente não me ajudou quando precisei",shape=box,color=red];
		j3987429950 -> j648067081;
	j1276452801 [label="Não sei. De que mentiras sua cabeça estava cheia, Lyon?",shape=box,color=red];
		j1276452801 -> j1795399223;
	j804799854 [label="Então, os efeitos causados por tais elementos do Void não são \"reais\"?",shape=box,color=blue];
		j804799854 -> j2704238407;
	j925992893 [label="Mas a analogia que você usa não é totalmente precisa, não é? A matéria retirada do Void retorna ao Void, não é?",shape=box,color=blue];
		j925992893 -> j271337318;
	j2098133789 [label="+5 Chemistry",color=orange];
		j2098133789 -> j4218013735;
	j648067081 [label="Em sua defesa, minha exposição ao Void foi muito mais prolongada do que ela pretendia que o livro fosse usado como guia",shape=box,color=red];
		j648067081 -> j952291830;
	j1795399223 [label="Nenhuma que eu tenha vindo discutir com você.",shape=box,color=blue];
		j1795399223 -> "Chat ends.";
	j2704238407 [label="Muitas lembranças levaram homens à bebida ou os inspiraram a tirar a própria vida. Essas lembranças não são \"reais\"?",shape=box,color=blue];
		j2704238407 -> j4037139831;
	j271337318 [label="Muito bem, então, uma ideia: um poema ou uma canção existe, mesmo que não esteja escrito",shape=box,color=red];
		j271337318 -> j1842841834;
	j4218013735 [label="Poderia dar mais detalhes?",shape=box,color=blue];
		j4218013735 -> j1287980798;
	j952291830 [label="+5 Chemistry",color=orange];
		j952291830 -> j2483085277;
	j4037139831 [label="Mas o meu ponto é que essas eram forças internas que o homem deixava agir sobre ele, não forças externas",shape=box,color=red];
		j4037139831 -> j42636721;
	j1842841834 [label="Mas se for esquecida, deixa de existir. Uma história perdida no tempo se perde para sempre.",shape=box,color=blue];
		j1842841834 -> j2319914442;
	j1287980798 [label="Como se mede a \"realidade\"?",shape=box,color=red];
		j1287980798 -> j1572952089;
		j1287980798 -> j1995075914;
		j1287980798 -> j1992148595;
	j2483085277 [label="A ignorância infeliz é a melhor coisa que qualquer um de nós pode esperar que cause a malignidade em outros.",shape=box,color=blue];
		j2483085277 -> j2250669605;
	j42636721 [label="Mas qual é a diferença, essa é a minha pergunta? Se o resultado final é o mesmo, isso importa?",shape=box,color=blue];
		j42636721 -> j3998634011;
		j42636721 -> j604053201;
		j42636721 -> j3558476842;
	j2319914442 [label="Uma revolução que nasce na mente daqueles que a empunham é, de fato, uma espada sem fio.",shape=box,color=blue];
		j2319914442 -> j3998634011;
		j2319914442 -> j604053201;
		j2319914442 -> j3558476842;
	j1572952089 [label="Por permanência física? Peso e massa? O que veio do Void tá aqui só temporariamente",shape=box,color=red];
		j1572952089 -> j162241903;
	j1995075914 [label="Qual o seu efeito sobre os acontecimentos? O que veio do Void mudou o curso da história",shape=box,color=red];
		j1995075914 -> j2204669643;
	j1992148595 [label="Pelo seu efeito sobre os outros? A influência de \"coisas\" que vieram do Void certamente teve esse efeito",shape=box,color=red];
		j1992148595 -> j1328808742;
	j2250669605 [label="Minha curiosidade, no entanto, não se refere ao livro nem à sua utilidade. Perdoem-me por me deixar levar por um momento de poesia.",shape=box,color=blue];
		j2250669605 -> j1449999476;
	j3998634011 [label="Você não está perguntando se eles são \"reais\", você está perguntando se eles são \"válidos\". Se eles devem ser descartados ou não",shape=box,color=red];
		j3998634011 -> j4056085462;
	j604053201 [label="Eu também perguntaria se seus Luminários são \"reais\", simplesmente porque você não pode apertar a mão do Sol ou da Lua",shape=box,color=red];
		j604053201 -> j4285883257;
	j3558476842 [label="Você tá perguntando, de forma indireta, se todas as \"coisas\" do Void só existem porque nós as trouxemos à existência por vontade própria",shape=box,color=red];
		j3558476842 -> j4203813101;
	j162241903 [label="O que vem do Void deve retornar a ele, é isso que você está dizendo? Mas o Void não é, por definição, composto de nada?",shape=box,color=blue];
		j162241903 -> j3904908019;
	j2204669643 [label="Um ponto válido. Uma revolução deixa de ser \"real\" simplesmente porque não se pode colocá-la numa cesta e pesá-la?",shape=box,color=blue];
		j2204669643 -> j1328808742;
	j1328808742 [label="Certamente custou a vida de muitas pessoas. Elas argumentariam veementemente contra a sua validade. No entanto, considere o seguinte:",shape=box,color=blue];
		j1328808742 -> j2895243005;
	j1449999476 [label="Vim a questionar isso \"em voz alta\" para ver se você seria capaz de explicar. Quando o Void ganha forma, o que emerge dele - é \"real\"?",shape=box,color=blue];
		j1449999476 -> j518242401;
		j1449999476 -> j1166756461;
		j1449999476 -> j1208497108;
	j4056085462 [label="+5 Chemistry",color=orange];
		j4056085462 -> j808118525;
	j4285883257 [label="Não estamos falando dos Luminários. Estamos falando do Void.",shape=box,color=blue];
		j4285883257 -> j142040164;
		j4285883257 -> j1873470701;
		j4285883257 -> j2490832152;
		j4285883257 -> j2793372815;
	j4203813101 [label="+5 Chemistry",color=orange];
		j4203813101 -> j3418492723;
	j3904908019 [label="Suponho que sim? As partes do Void com as quais interagi já tendem a estar impressas. Já lhes demos algum tipo de forma ou figura. Ou então, borramos demais a linha que separa as realidades",shape=box,color=red];
		j3904908019 -> j3478241158;
		j3904908019 -> j730057295;
	j2895243005 [label="Uma revolução só adquire validade por existir na mente daqueles que a conduzem.",shape=box,color=blue];
		j2895243005 -> j134419633;
	j808118525 [label="Sim, acho que você poderia formular a pergunta dessa maneira. Devemos ignorar os fantasmas que assombram nossos corredores ou, ao lhes darmos qualquer atenção, estaremos os fortalecendo?",shape=box,color=blue];
		j808118525 -> j142040164;
		j808118525 -> j1873470701;
		j808118525 -> j2490832152;
		j808118525 -> j2793372815;
	j142040164 [label="Acredito que os desafios que enfrentamos agora são perigosos, e muito. E devemos tratá-los como tal",shape=box,color=red];
		j142040164 -> j1489535837;
	j1873470701 [label="Fantasmas são reais o suficiente para nos causar dor. Mas não podem ser eliminados com uma bala… pelo menos não com uma que eu tenha encontrado",shape=box,color=red];
		j1873470701 -> j2842602630;
	j2490832152 [label="Do que se trata tudo isso, Lyon?",shape=box,color=red];
		j2490832152 -> j132613294;
	j2793372815 [label="Eu… sinceramente não sei, Lyon. E gostaria de saber",shape=box,color=red];
		j2793372815 -> j235589492;
	j3418492723 [label="Sim, acho que você poderia formular dessa maneira. Como podemos ter certeza de que não… manifestamos nossos próprios demônios?",shape=box,color=blue];
		j3418492723 -> j142040164;
		j3418492723 -> j1873470701;
		j3418492723 -> j2490832152;
		j3418492723 -> j2793372815;
	j3478241158 [label="Estruturas inteiras, inclusive a própria Lua, foram colocadas no Void e recuperadas. Portanto, ele não consome matéria simplesmente por existir",shape=box,color=red];
		j3478241158 -> j2213184549;
	j730057295 [label="O que você tá insinuando é a existência de um Void \"mais profundo\" onde nada pode existir, e sinceramente não sei falar sobre isso",shape=box,color=red];
		j730057295 -> j1526136294;
	j134419633 [label="Se fosse apagado dos pensamentos de todos ao redor, deixaria de existir, não é mesmo?",shape=box,color=blue];
		j134419633 -> j604053201;
		j134419633 -> j3998634011;
		j134419633 -> j3558476842;
	j1489535837 [label="Boolean LyonReal1 is now true.",color=orange];
		j1489535837 -> j4083158068;
	j2842602630 [label="Boolean LyonFake1 is now true.",color=orange];
		j2842602630 -> j2922220160;
	j132613294 [label="Boolean LyonFaith1 is now true.",color=orange];
		j132613294 -> j88853066;
	j235589492 [label="Sua honestidade em admitir o que você não sabe é revigorante. Quem dera mais pessoas tivessem esse dom.",shape=box,color=blue];
		j235589492 -> j1585430786;
	j2213184549 [label="Não me importo com a matéria colocada no Void e recuperada. O que me importa é o que foi inventado a partir do Void, completamente do nada.",shape=box,color=blue];
		j2213184549 -> j3998634011;
		j2213184549 -> j604053201;
		j2213184549 -> j3558476842;
	j1526136294 [label="Agradeço a sinceridade. Suponho que me interesso menos pelo que não pode existir e mais pelo que existe atualmente.",shape=box,color=blue];
		j1526136294 -> j3998634011;
		j1526136294 -> j604053201;
		j1526136294 -> j3558476842;
	j4083158068 [label="Sim, suponho que você saiba o que pode ser arrancado do Void pela força e o que não pode…",shape=box,color=blue];
		j4083158068 -> j3051226020;
	j2922220160 [label="Talvez seja por isso que tantos se entregam aos excessos… para estancar uma ferida sangrenta, invisível, mas dolorosa. Curável. Mas pela força da alma, não por armamentos.",shape=box,color=blue];
		j2922220160 -> j3051226020;
	j88853066 [label="Claramente, abordei tudo isso da maneira errada. Discutiremos isso em outra ocasião. Perdoe minha intromissão.",shape=box,color=blue];
		j88853066 -> j3855476688;
	j1585430786 [label="Independentemente disso, continuo com a minha opinião sobre o assunto completamente indefinida.",shape=box,color=blue];
		j1585430786 -> j88853066;
	j3051226020 [label="Embora, como sempre, eu ainda tenha dúvidas. Perdoe minha intromissão. Obrigado pelo seu tempo, Peregrino.",shape=box,color=blue];
		j3051226020 -> j3855476688;
	j3855476688 [label="- Padre Lyon Allard",shape=box,color=blue];
		j3855476688 -> "Chat ends.";
}