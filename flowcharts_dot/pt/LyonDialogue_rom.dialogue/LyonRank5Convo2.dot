		1486 -> 1488 [label="false",color=purple];
	1487 [label="+20 Chemistry",color=orange];
		1487 -> 490;
	1491 [label="Meu amigo, você foi paciente comigo e mais gentil do que deveria ser. Sei que você ficou curioso depois dessa parte da minha história, da noite em que a Lua estava em seu momento mais sombrio.",shape=box,color=blue];
		1491 -> 1493;
	1490 [label="Meu amigo, você foi paciente comigo. Sei que você ficou curioso depois dessa parte da minha história, da noite em que a Lua estava em seu momento mais sombrio.",shape=box,color=blue];
		1490 -> 1493;
	1489 [label="Meu amigo, você se perguntou sobre o meu passado. E sei que você também deve ter se perguntado sobre esta parte da minha história, sobre a noite em que a Lua estava em seu momento mais sombrio.",shape=box,color=blue];
		1489 -> 1493;
	1488 [label="Meu amigo, sei que você deve ter ficado curioso depois da minha história, e daquela noite em que a Lua estava em seu momento mais sombrio.",shape=box,color=blue];
		1488 -> 1493;
	490 [label="[Conversa ocultada devido à escolha anterior de evitar tópicos sensíveis]",shape=box,color=blue];
		490 -> 1492;
	1493 [label="É uma história que jurei nunca contar. Só a Marie a conhece, pois a leu nos meus diários. E agora, vou contá-la aqui para você.",shape=box,color=blue];
		1493 -> 1495;
	1492 [label="Update boolean LyonConfession1",color=orange];
		1492 -> 1494;
	1495 [label="Uma vez que eu comece, não posso parar, pois não conseguirei recomeçar. Portanto, peço que me perdoe se eu não permitir que você me faça perguntas.",shape=box,color=blue];
		1495 -> 1499;
		1495 -> 1498;
		1495 -> 1497;
		1495 -> 1496;
	1494 [label="Chat ends.",color=orange];
	1499 [label="Sem problemas",shape=box,color=red];
		1499 -> 1503;
	1498 [label="[Deixá-lo continuar]",shape=box,color=red];
		1498 -> 1502;
	1497 [label="[Aviso: conversa envolvendo menções de violência contra crianças e automutilação. Clique aqui para encerrar o diálogo. Isso não causará perda de Intimidade com o Lyon]",shape=box,color=red];
		1497 -> 1501;
	1496 [label="[Encerrar Conversa]",shape=box,color=red];
		1496 -> 1500;
	1503 [label="Obrigado.",shape=box,color=blue];
		1503 -> 1507;
	1502 [label="+5 Chemistry",color=orange];
		1502 -> 1503;
	1501 [label="Check boolean LyonSpeech",color=orange];
		1501 -> 1505 [label=true,color=green];
		1501 -> 1506 [label=false,color=brown];
	1500 [label="Update boolean LyonConfessionFail",color=orange];
		1500 -> 1504;
	1507 [label="Evaluate expressions",color=orange];
		1507 -> 1511 [label="LyonBackstory3a",color=purple];
		1507 -> 1511 [label="LyonBackstory3b",color=purple];
		1507 -> 1510 [label="false",color=purple];
	1505 [label="+20 Chemistry",color=orange];
		1505 -> 1508;
	1506 [label="Se você se considera um covarde por ter feito essa escolha, eu imploro: não se considere. Pois essa é uma dor que não lhe cabe enfrentar. Ela é minha. Você não pediu para suportar este momento. ",shape=box,color=blue];
		1506 -> 1509;
	1504 [label="Chat ends.",color=orange];
	1511 [label="Conversamos sobre minha família. Sobre o tempo que passei na fazenda onde cresci. Sobre as visões que me atormentaram e me levaram à violência. ",shape=box,color=blue];
		1511 -> 1515;
	1510 [label="Sei que não lhe contei muito sobre aqueles que me criaram. E temo que isso se deva a um bom motivo.",shape=box,color=blue];
		1510 -> 1514;
	1508 [label="Update boolean LyonConfession1",color=orange];
		1508 -> 1512;
	1509 [label="Essa engenhoca mecânica em que estamos sentados cria uma impressão de impessoalidade velada. Como se estivéssemos, de alguma forma, protegidos de qualquer dano que alguém possa nos causar através das palavras digitadas nela.",shape=box,color=blue];
		1509 -> 1513;
	1515 [label="Eu te contei sobre as vozes que eu ouvia, sussurrando para mim, me chamando de outros cômodos. Às vezes, pareciam estar chamando meu nome. ",shape=box,color=blue];
		1515 -> 1518;
	1514 [label="Minha mãe… interpretava minhas visões como obra do demônio. E tentava afastá-las de mim à força, me agredindo com um bastão. Muitas vezes, até que eu não conseguisse mais ficar de pé.",shape=box,color=blue];
		1514 -> 1517;
	1512 [label="Chat ends.",color=orange];
	1513 [label="Eu argumentaria, ao contrário, que, livres da armadura que vestimos em nossas interações sociais mais corriqueiras, somos despojados daquilo que poderia nos proteger. ",shape=box,color=blue];
		1513 -> 1516;
	1518 [label="Outras vezes, não pareciam nada. Um amontoado de palavras sem sentido, ou o idioma do diabo. ",shape=box,color=blue];
		1518 -> 1521;
	1517 [label="E meu pai? Bem, apesar de toda a crueldade da minha mãe, meu pai era pior. Vou poupá-lo dos detalhes.",shape=box,color=blue];
		1517 -> 1520;
	1516 [label="Portanto, em situações como essas… tenho plena consciência de que lancei uma flecha que pode atingir não o soldado pronto para a batalha, mas a jugular desavisada de um cervo na floresta.",shape=box,color=blue];
		1516 -> 1519;
	1521 [label="A princípio, os delírios sem sentido daquelas palavras me aterrorizaram. Implorei para que fizessem sentido. Rezei à Lua para que seus espíritos me dissessem o que desejavam de mim.",shape=box,color=blue];
		1521 -> 1524;
	1520 [label="Mas a violência deles não era sem paralelo com a minha. Minhas visões, muitas vezes, me tornavam difícil de enfrentar… principalmente quando cresci e me tornei mais alto e mais forte do que até mesmo meu pai.",shape=box,color=blue];
		1520 -> 1523;
	1519 [label="Portanto, deixo-lhe com isto:",shape=box,color=blue];
		1519 -> 1522;
	1524 [label="Mas quando comecei a decifrar o que era desejado, arrependi-me daquilo pelo qual havia orado com tanto fervor. Pois, agora, eu sabia os atos que me exigiam que realizasse em seu nome.",shape=box,color=blue];
		1524 -> 1526;
	1523 [label="E essas visões frequentemente assumiam a forma de vozes. Às vezes, pareciam chamar meu nome…",shape=box,color=blue];
		1523 -> 1518;
	1522 [label="Precisamos nos lembrar de como encontrar forças para ajudar o outro a se levantar, mesmo quando não temos forças para ficar de pé. ",shape=box,color=blue];
		1522 -> 1525;
	1526 [label="E, nossa, que preço terrível eles teriam pago. ",shape=box,color=blue];
		1526 -> 1528;
	1525 [label="Esse é o verdadeiro propósito de uma história. ",shape=box,color=blue];
		1525 -> 1527;
	1528 [label="Não me interprete mal. Eu não tinha amor pelo meu pai, nem pela minha mãe. Qualquer lealdade familiar que eu pudesse ter sentido por eles já havia desaparecido há muito tempo, enterrada sob uma série de hematomas e cicatrizes.",shape=box,color=blue];
		1528 -> 1530;
	1527 [label="+20 Chemistry",color=orange];
		1527 -> 1529;
	1530 [label="Mas o que eles me imploraram para fazer por eles… e o que eles me obrigaram a fazer, naquela noite tão escura…",shape=box,color=blue];
		1530 -> 1532;
	1529 [label="Fique bem, Peregrino. Falaremos novamente em breve.",shape=box,color=blue];
		1529 -> 1531;
	1532 [label="Eu era pouco mais que um menino, mal chegava a ser um homem. Talvez tivesse 16 anos? 18? A princípio, pensei que tudo fosse mais um terrível pesadelo… um sonho distorcido.",shape=box,color=blue];
		1532 -> 1534;
	1531 [label="- Padre Lyon Allard",shape=box,color=blue];
		1531 -> 1533;
	1534 [label="Figuras me cercavam, manifestações esqueléticas e retorcidas, feitas puramente de malícia e sombras. ",shape=box,color=blue];
		1534 -> 1536;
	1533 [label="Update boolean LyonConfession1",color=orange];
		1533 -> 1535;
	1536 [label="Provocando-me, exigindo que eu faça o que deve ser feito… que se aqueles que afirmam me amar desejam minha carne… então eu, por minha vez, devo desejar a deles…",shape=box,color=blue];
		1536 -> 1537;
	1535 [label="Chat ends.",color=orange];
	1537 [label="Quando acordei do pesadelo… ou, talvez, eu sempre estivesse acordado, não sei ao certo… eu tinha uma faca de caça na mão. E estava parado à porta do quarto dos meus pais.",shape=box,color=blue];
		1537 -> 1538;
	1538 [label="A lua era nova. E as nuvens, densas. Não havia a menor luz para enxergar. A escuridão era absoluta.",shape=box,color=blue];
		1538 -> 1539;
	1539 [label="A Lua me abandonou.",shape=box,color=blue];
		1539 -> 1540;
	1540 [label="Não consegui atender ao chamado das vozes. Não consegui entregar-lhes as almas de minha mãe e de meu pai. ",shape=box,color=blue];
		1540 -> 1541;
	1541 [label="Para a noite vazia, eu fugi. Para a mata fechada, os galhos rasgando minha pele nua, embora eu não me importasse nem um pouco com a dor.",shape=box,color=blue];
		1541 -> 1542;
	1542 [label="Corri, até minhas pernas cederem, incapazes de me levar mais longe. Talvez eu estivesse chorando… não sei.",shape=box,color=blue];
		1542 -> 1543;
	1543 [label="Mas as manifestações vieram depois. E ainda assim, sussurravam por sangue. ",shape=box,color=blue];
		1543 -> 1544;
	1544 [label="Eu esperava que, se não os visse, eles iriam embora… então, enfiei aquela faca em meu olho…",shape=box,color=blue];
		1544 -> 1545;
	1545 [label="Que pena que desmaiei e não consegui concluir minha tarefa. Agora, nunca saberei o que aconteceu.",shape=box,color=blue];
		1545 -> 1546;
	1546 [label="Quando acordei, estava na paróquia local da Lua. Um irmão me encontrou e enfaixou meus ferimentos. Ele me perguntou do que eu estava fugindo.",shape=box,color=blue];
		1546 -> 1547;
	1547 [label="Eu estava transtornado. Não conseguia mentir para ele. Confessei tudo… as visões, o que me disseram para fazer… eu esperava ser condenado.",shape=box,color=blue];
		1547 -> 1548;
	1548 [label="Quando terminei, ele simplesmente sorriu com uma tristeza profunda e colocou um amuleto da Lua na minha palma. \"Ela é uma bênção e uma maldição, meu filho.\"",shape=box,color=blue];
		1548 -> 1549;
	1549 [label="Ele me enviou para a Catedral na Cité de la Lumière. E lá, permaneci, até que o Entrati me encontrou…",shape=box,color=blue];
		1549 -> 1550;
	1550 [label="Pronto… agora você sabe tudo.",shape=box,color=blue];
		1550 -> 1551;
	1551 [label="E agora… eu preciso ir.",shape=box,color=blue];
		1551 -> 1552;
	1552 [label="Update boolean LyonConfession1",color=orange];
		1552 -> 1553;
	1553 [label="+20 Chemistry",color=orange];
		1553 -> 1554;
	1554 [label="- Lyon",shape=box,color=blue];
		1554 -> 1555;
	1555 [label="Chat ends.",color=orange];
}