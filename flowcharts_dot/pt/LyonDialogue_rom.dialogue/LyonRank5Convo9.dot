	"Chat ends." [color=orange];
	j1248719646 [label="Meu milagre, eu… preciso ter certeza de que você entendeu algo antes de lhe contar minha próxima anedota. ",shape=box,color=blue];
		j1248719646 -> j1135956859;
	j1135956859 [label="É importante para mim que você preste muita atenção às próximas palavras que lhe enviarei. Você entende? ",shape=box,color=blue];
		j1135956859 -> j2191080743;
		j1135956859 -> j2930035303;
	j2191080743 [label="Você tá me deixando nervoso… o que tem de errado?",shape=box,color=red];
		j2191080743 -> j2390594241;
	j2930035303 [label="Sim, tô aqui. Pode prosseguir",shape=box,color=red];
		j2930035303 -> j3782780839;
	j2390594241 [label="Não há nada de errado, muito pelo contrário. É isso que é tão importante para você compreender. As terríveis consequências das quais desejo libertá-lo, caso você suponha que elas possam ocorrer.",shape=box,color=blue];
		j2390594241 -> j1978466773;
		j2390594241 -> j3873513351;
		j2390594241 -> j3658588443;
	j3782780839 [label="+5 Chemistry",color=orange];
		j3782780839 -> j3401778057;
	j1978466773 [label="Sou todo ouvidos",shape=box,color=red];
		j1978466773 -> j802621253;
	j3873513351 [label="Você não tá fazendo muito sentido",shape=box,color=red];
		j3873513351 -> j4010610422;
	j3658588443 [label="Graves consequências… de quê?",shape=box,color=red];
		j3658588443 -> j3603635561;
	j3401778057 [label="Obrigado. Antes de começar, quero assegurar-lhe que não há nada de errado; no entanto, é aí que talvez resida as graves consequências das quais desejo livrá-lo, caso você imagine que elas possam advir.",shape=box,color=blue];
		j3401778057 -> j1978466773;
		j3401778057 -> j3873513351;
		j3401778057 -> j3658588443;
	j802621253 [label="+5 Chemistry",color=orange];
		j802621253 -> j2459240499;
	j4010610422 [label="Sim. Estou dolorosamente ciente disso.",shape=box,color=blue];
		j4010610422 -> j3603635561;
	j3603635561 [label="Permita-me começar novamente.",shape=box,color=blue];
		j3603635561 -> j2459240499;
	j2459240499 [label="Tenho consciência de que posso ser interpretado por muitos, e de fato, posso muito bem ser, na realidade, como alguém que não está bem da cabeça. No mínimo, não estou totalmente em sã consciência.",shape=box,color=blue];
		j2459240499 -> j216584488;
	j216584488 [label="Há muito tempo que me reconciliei com isso. Já não me perturba. As visões que me atormentam… as vozes… aprendi a conviver com elas sem medo, nem ódio.",shape=box,color=blue];
		j216584488 -> j2282848131;
	j2282848131 [label="(Ultimamente, acho que um pouco por desprezo por mim, para ser sincero, mas isso não vem ao caso.)",shape=box,color=blue];
		j2282848131 -> j2802805846;
	j2802805846 [label="Mas quero que você entenda que, se você terminasse isso entre nós… esse laço que eu antes considerava impossível entre mim e outra pessoa…",shape=box,color=blue];
		j2802805846 -> j3818312525;
	j3818312525 [label="E se algum dia você deixasse seu coração se afastar do meu? ",shape=box,color=blue];
		j3818312525 -> j4290850009;
	j4290850009 [label="Eu perseverarei, meu milagre.",shape=box,color=blue];
		j4290850009 -> j604572320;
	j604572320 [label="Não serei consumido por aquilo que me atormenta. ",shape=box,color=blue];
		j604572320 -> j2851720794;
	j2851720794 [label="Check boolean LyonAllRight",color=orange];
		j2851720794 -> j2117888734 [label=true,color=green];
		j2851720794 -> j901008998 [label=false,color=brown];
	j2117888734 [label="Para usar uma expressão coloquial, ficarei \"de boa\". Encontrarei motivos para sorrir e rir novamente.",shape=box,color=blue];
		j2117888734 -> j701774939;
		j2117888734 -> j2762318095;
	j901008998 [label="Eu vou sobreviver. Eu vou ficar bem. Vou encontrar motivos para sorrir e rir novamente. ",shape=box,color=blue];
		j901008998 -> j701774939;
		j901008998 -> j2762318095;
	j701774939 [label="Ah, Lyon… você não é um fardo pra mim",shape=box,color=red];
		j701774939 -> j3123435681;
	j2762318095 [label="Você tá dizendo que… quer terminar as coisas entre a gente?",shape=box,color=red];
		j2762318095 -> j3932060159;
	j3123435681 [label="Estou simplesmente tentando evitar que você sinta qualquer dificuldade que possa estar enfrentando por minha causa…",shape=box,color=blue];
		j3123435681 -> j3641303854;
		j3123435681 -> j245386240;
		j3123435681 -> j3429599652;
	j3932060159 [label="Não! Nada disso! Estou simplesmente tentando evitar que você sinta qualquer dificuldade que possa estar enfrentando por minha causa.",shape=box,color=blue];
		j3932060159 -> j3641303854;
		j3932060159 -> j245386240;
		j3932060159 -> j3429599652;
	j3641303854 [label="Sua dor… ecoa uma dor semelhante à minha. Nunca seria um sacrifício te ajudar a superar isso",shape=box,color=red];
		j3641303854 -> j1476069549;
	j245386240 [label="Não consigo descrever o que me atrai em você… mas você nunca será um fardo ou obrigação pra mim",shape=box,color=red];
		j245386240 -> j1046032596;
	j3429599652 [label="[Terminar com o Lyon] Tudo isso tá ficando demais pra mim, me desculpe… talvez seja melhor terminarmos aqui",shape=box,color=red];
		j3429599652 -> j4180370878;
	j1476069549 [label="Não consigo expressar o quanto meu coração se parte por você. Mas serei eternamente grato por nossos fantasmas solitários da dor terem se encontrado.",shape=box,color=blue];
		j1476069549 -> j1070746056;
	j1046032596 [label="A isso, não consigo expressar adequadamente minha gratidão, e creio que nenhuma palavra jamais conseguirá.",shape=box,color=blue];
		j1046032596 -> j1070746056;
	j4180370878 [label="Sim. Claro. Seria… hipócrita aceitar qualquer outra resposta neste momento… ",shape=box,color=blue];
		j4180370878 -> j2109564693;
	j1070746056 [label="Mas agora que me dei ao trabalho de escrever este preâmbulo extremamente egocêntrico…",shape=box,color=blue];
		j1070746056 -> j3260861012;
		j1070746056 -> j4128825691;
		j1070746056 -> j627133368;
	j2109564693 [label="Entendo perfeitamente. E desejo-te tudo de bom. E guardarei com carinho todos os momentos que passamos juntos. ",shape=box,color=blue];
		j2109564693 -> j3824630816;
	j3260861012 [label="Pra um cara que era reservado, você realmente gosta de falar",shape=box,color=red];
		j3260861012 -> j3175520835;
	j4128825691 [label="Eu os acho adoráveis, não se preocupe",shape=box,color=red];
		j4128825691 -> j3878635885;
	j627133368 [label="Você poderia simplesmente ter dito: \"eu ficarei bem, mesmo que um dia sigamos caminhos separados\"",shape=box,color=red];
		j627133368 -> j3726070805;
	j3824630816 [label="Guardarei eles na minha alma, mesmo que desapareçam da minha mente. Adeus.",shape=box,color=blue];
		j3824630816 -> j3994460333;
	j3175520835 [label="+5 Chemistry",color=orange];
		j3175520835 -> j2066855025;
	j3878635885 [label="+5 Chemistry",color=orange];
		j3878635885 -> j2360632022;
	j3726070805 [label="+5 Chemistry",color=orange];
		j3726070805 -> j1486868238;
	j3994460333 [label="Boolean LyonDating is now false.",color=orange];
		j3994460333 -> j4254443866;
	j2066855025 [label="Bah! Se você não queria ter acesso aos meus pensamentos mais íntimos, não deveria ter se intrometido. A culpa é inteiramente sua.",shape=box,color=blue];
		j2066855025 -> j989408002;
	j2360632022 [label="Fico muito feliz que você goste das minhas andanças. É exatamente por isso que prefiro falar tão pouco. Consegue imaginar ter que aguentar isso pessoalmente? A Marie teria me massacrado há anos.",shape=box,color=blue];
		j2360632022 -> j989408002;
	j1486868238 [label="Existe um certo grau de irreverência e sarcasmo que naturalmente se destaca em você, algo que eu jamais conseguiria alcançar. Deixo isso para você.",shape=box,color=blue];
		j1486868238 -> j989408002;
	j4254443866 [label="Boolean IsDating is now false.",color=orange];
		j4254443866 -> j3311435967;
	j989408002 [label="No entanto, tudo isso serviu de pretexto para uma história que agora parecerá bastante curta em comparação com o resto…",shape=box,color=blue];
		j989408002 -> j2688642866;
	j3311435967 [label="- Lyon",shape=box,color=blue];
		j3311435967 -> "Chat ends.";
	j2688642866 [label="Acordei ontem à noite de um pesadelo. Quando acordei, sombras me cercavam. Isso não é nada estranho ou novo para o meu estado de espírito. Elas pairavam sobre minha cama e não desapareciam.",shape=box,color=blue];
		j2688642866 -> j1855614580;
	j1855614580 [label="Eu não tinha medo deles, pois sabia que não podiam me fazer mal. Contudo, eles também não desapareciam da minha mente. Só havia uma maneira que eu conhecia de me livrar deles.",shape=box,color=blue];
		j1855614580 -> j1647031138;
	j1647031138 [label="Levantando-me da cama, vesti-me o melhor que pude, cambaleando em meio à visão turva do pesadelo que persistia. Agarrei meu turíbulo, caí de joelhos no meio do chão e me preparei para… bem…",shape=box,color=blue];
		j1647031138 -> j111192956;
	j111192956 [label="Eu me preparei para \"esvaziar a mente\". Vamos deixar por isso mesmo.",shape=box,color=blue];
		j111192956 -> j604886012;
	j604886012 [label="Mas, ao fechar os olhos, minha mente divagou. Meus pensamentos se voltaram… para você, meu milagre…",shape=box,color=blue];
		j604886012 -> j3910609147;
	j3910609147 [label="O som da sua voz… o toque da sua mão no meu ombro…",shape=box,color=blue];
		j3910609147 -> j11279534;
	j11279534 [label="E as visões… fugiram. Abandonaram seu posto, expulsas pelo fantasma mais forte… de você.",shape=box,color=blue];
		j11279534 -> j1841599960;
	j1841599960 [label="Eu… me levantei. Coloquei meu turíbulo na mesa de cabeceira e… optei por caminhar pela areia do Sanctum.",shape=box,color=blue];
		j1841599960 -> j833511799;
		j1841599960 -> j4109452140;
	j833511799 [label="Agora entendo por que você queria o preâmbulo…",shape=box,color=red];
		j833511799 -> j3111327925;
	j4109452140 [label="Não sei o que dizer…",shape=box,color=red];
		j4109452140 -> j4014135925;
	j3111327925 [label="Sim. Bem. Durante minha caminhada, eu… percebi instantaneamente o perigo sombrio de um momento como aquele. Que você pudesse… passar a considerá-lo uma responsabilidade… passar a me ver como correntes que te prendem.",shape=box,color=blue];
		j3111327925 -> j3165572740;
	j4014135925 [label="+5 Chemistry",color=orange];
		j4014135925 -> j1649619001;
	j3165572740 [label="Eu te imploro… eu rogo, a qualquer deus ou deuses, no céu ou na terra… que nunca faças isso. Este é um presente que me deste, e a cada vez que o receberes, o apreciarei com carinho.",shape=box,color=blue];
		j3165572740 -> j1041493013;
	j1649619001 [label="Não são necessárias palavras, meu milagre…",shape=box,color=blue];
		j1649619001 -> j3353250712;
	j1041493013 [label="Prometa-me, meu milagre, que se chegar o tempo em que eu me tornar para você uma gaiola vazia… você se libertará de mim.",shape=box,color=blue];
		j1041493013 -> j2646532929;
	j3353250712 [label="Durante minha caminhada, eu… percebi instantaneamente o perigo sombrio de um momento como aquele. Que você pudesse… passar a considerá-lo uma responsabilidade… passar a me ver como correntes que te prendem.",shape=box,color=blue];
		j3353250712 -> j3165572740;
	j2646532929 [label="Não serei uma prisão vazia para aqueles que amo. Nem para você. Nem para a Marie.",shape=box,color=blue];
		j2646532929 -> j1596697316;
		j2646532929 -> j2925782454;
	j1596697316 [label="[Terminar com o Lyon] Eu… eu não posso… não posso prometer isso, me desculpe",shape=box,color=red];
		j1596697316 -> j2940765020;
	j2925782454 [label="Eu prometo",shape=box,color=red];
		j2925782454 -> j567940593;
	j2940765020 [label="+10 Chemistry",color=orange];
		j2940765020 -> j799096754;
	j567940593 [label="+10 Chemistry",color=orange];
		j567940593 -> j2306228915;
	j799096754 [label="Obrigado. Obrigado, meu milagre, pela sua honestidade. Isso exigiu coragem, neste momento, e eu te admiro por isso.",shape=box,color=blue];
		j799096754 -> j1288038853;
	j2306228915 [label="Obrigado. Obrigado, meu milagre…",shape=box,color=blue];
		j2306228915 -> j172289535;
	j1288038853 [label="Guardarei com carinho todos os momentos que passamos juntos. Isso significa muito mais do que você pode imaginar.",shape=box,color=blue];
		j1288038853 -> j3824630816;
	j172289535 [label="De repente, estou muito cansado, como se… um grande peso tivesse sido tirado dos meus ombros. Acho que preciso me deitar.",shape=box,color=blue];
		j172289535 -> j21916968;
	j21916968 [label="- Lyon",shape=box,color=blue];
