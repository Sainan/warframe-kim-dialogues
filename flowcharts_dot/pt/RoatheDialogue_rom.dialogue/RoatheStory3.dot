	"Chat ends." [color=orange];
	j1483309397 [label="ÁUDIO: OROKIN",shape=box,color=blue];
		j1483309397 -> j1574343460;
	j1574343460 [label="Por muito tempo, o Império Orokin não teve inimigos. Seu exército existia somente para resolver pequenas disputas, casa contra casa, Executor contra Executor.",shape=box,color=blue];
		j1574343460 -> j1770715813;
	j1770715813 [label="Quando os Sentients atacaram, conhecemos uma união que nos fora negada por muito tempo. Os Dax desembainharam suas espadas contra algo além de um camponês insolente ou um comerciante desonesto.",shape=box,color=blue];
		j1770715813 -> j2093180994;
	j2093180994 [label="Os Imperadores, os governantes imortais do Império, cujo poder residia nos Executores, despertaram abruptamente em seus tronos dourados e empoeirados.",shape=box,color=blue];
		j2093180994 -> j2200809084;
	j2200809084 [label="Guerra, magnífica guerra! Finalmente, o Império tinha um propósito. Definido por uma extinção mais iminente que a morte do Sol, bebemos profundamente o néctar da vida.",shape=box,color=blue];
		j2200809084 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}