	2218 [label="Foi o Scarne, irritadiço, cerebral e mordaz, quem primeiro propôs o plano, nos tempos anteriores à guerra. \"Precisamos abandonar o ninho, ele está em chamas.\"",shape=box,color=blue];
		2218 -> 2221;
	2221 [label="Através da superexploração e de experimentos imprudentes, havíamos contaminado o Sistema além de qualquer esperança de regeneração.",shape=box,color=blue];
		2221 -> 2216;
	2216 [label="A expansão para novos horizontes era nossa única opção agora. ",shape=box,color=blue];
		2216 -> 5733;
	5733 [label="Ele também inaugurou as covardes Torres do Void.",shape=box,color=blue];
		5733 -> 2222;
	2222 [label="O temor do retorno dos Sentients era tão forte que ele só conseguia imaginar a fuga para ilhas no mar do Void.",shape=box,color=blue];
		2222 -> 5700;
	5700 [label="Quão pouco crédito demos aos Sentients por sua coragem.",shape=box,color=blue];
		5700 -> 5701;
	5701 [label="Eles suportaram, de bom grado, o fogo escaldante do Void, somente pela chance de nos punir.",shape=box,color=blue];
