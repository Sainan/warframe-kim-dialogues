	"Chat ends." [color=orange];
	j2385586344 [label="ÁUDIO: PUNIÇÃO",shape=box,color=blue];
		j2385586344 -> j2730929195;
	j2730929195 [label="Foi o Scarne, irritadiço, cerebral e mordaz, quem primeiro propôs o plano, nos tempos anteriores à guerra. \"Precisamos abandonar o ninho, ele está em chamas.\"",shape=box,color=blue];
		j2730929195 -> j1495405002;
	j1495405002 [label="Através da superexploração e de experimentos imprudentes, havíamos contaminado o Sistema além de qualquer esperança de regeneração.",shape=box,color=blue];
		j1495405002 -> j1414571227;
	j1414571227 [label="A expansão para novos horizontes era nossa única opção agora. ",shape=box,color=blue];
		j1414571227 -> j2828127715;
	j2828127715 [label="Ele também inaugurou as covardes Torres do Void.",shape=box,color=blue];
		j2828127715 -> j42974397;
	j42974397 [label="O temor do retorno dos Sentients era tão forte que ele só conseguia imaginar a fuga para ilhas no mar do Void.",shape=box,color=blue];
		j42974397 -> j4080381404;
	j4080381404 [label="Quão pouco crédito demos aos Sentients por sua coragem.",shape=box,color=blue];
		j4080381404 -> j4190682865;
	j4190682865 [label="Eles suportaram, de bom grado, o fogo escaldante do Void, somente pela chance de nos punir.",shape=box,color=blue];
		j4190682865 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}