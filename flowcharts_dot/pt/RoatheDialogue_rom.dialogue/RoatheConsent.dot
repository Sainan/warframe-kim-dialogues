	j2044822696 [label="Ei, Roathe… tem um minutinho? [Pedir consentimento para múltiplos parceiros românticos]",shape=box,color=red];
		j2044822696 -> j2481530104;
	j2142191314 [label="[Encerrar Conversa]",shape=box,color=red];
		j2142191314 -> j604242687;
	j2481530104 [label="Hmm? O que foi, querido?",shape=box,color=blue];
		j2481530104 -> j3809929745;
	j604242687 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j604242687 -> "Chat ends.";
	j3809929745 [label="Quero falar com você sobre algo… e quero ter certeza de que você não tem nenhum problema com isso",shape=box,color=red];
		j3809929745 -> j1931143444;
	j1931143444 [label="Pra mim, é importante que você não sinta que tô mentindo ou sendo desonesto com você",shape=box,color=red];
		j1931143444 -> j1802759677;
	j1802759677 [label="Continue. Parece que isso vai ser muito bom.",shape=box,color=blue];
		j1802759677 -> j4122481081;
	j4122481081 [label="Não quero te colocar numa situação que você se sinta desconfortável… então, se você falar que não, tudo bem",shape=box,color=red];
		j4122481081 -> j270037059;
	j270037059 [label="O que temos entre nós é importante pra mim, e muito… não quero que você duvide disso, jamais",shape=box,color=red];
		j270037059 -> j2365102165;
	j2365102165 [label="Espere. Santo Vazio, você está tentando contornar a notícia de que tem outro parceiro?",shape=box,color=blue];
		j2365102165 -> j1011228295;
	j1011228295 [label="O quanto você acha que eu sou tolo? Eu já sei, meu caro Peregrino!",shape=box,color=blue];
		j1011228295 -> j1907900112;
		j1011228295 -> j477442512;
	j1907900112 [label="Imagino que… não se importe, então?",shape=box,color=red];
		j1907900112 -> j2858903798;
	j477442512 [label="Você… sabe?",shape=box,color=red];
		j477442512 -> j69082525;
	j2858903798 [label="Se ao menos você pudesse me ouvir rindo no Sanctum agora. Peregrino, querido. Meu doce Peregrino. Eu sou Orokin. Claro que não me importo.",shape=box,color=blue];
		j2858903798 -> j2081155934;
	j69082525 [label="Se ao menos você pudesse me ouvir rindo no Sanctum agora. Peregrino, querido. Meu doce Peregrino.",shape=box,color=blue];
		j69082525 -> j24079095;
	j2081155934 [label="Pense o que quiser sobre a minha sociedade e a nossa inclinação para desfrutar da companhia dos outros de uma forma que você pode considerar desdenhosa e depreciativa, mas nós também entendíamos o que era amar.",shape=box,color=blue];
		j2081155934 -> j2751063813;
	j24079095 [label="Eu soube no instante em que aconteceu. Tenho meus métodos. E não, não me importo nem um pouco. Sou Orokin.",shape=box,color=blue];
		j24079095 -> j2081155934;
	j2751063813 [label="Ninguém entendia o amor como os Orokin. E nós sabíamos que um coração podia ter espaço para mais de uma pessoa. ",shape=box,color=blue];
		j2751063813 -> j1971191166;
	j1971191166 [label="Estou apenas desapontado porque os fanáticos provavelmente são fechados demais para participar da brincadeira.",shape=box,color=blue];
		j1971191166 -> j971355625;
	j971355625 [label="Bah. Pensando bem, provavelmente é melhor assim. Consegue imaginar o absurdo que isso causaria?",shape=box,color=blue];
		j971355625 -> j272271310;
	j272271310 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j272271310 -> j2521889904;
	j2521889904 [label="Bem, independentemente disso. Se essa pessoa te faz feliz, então aproveite. Mas saiba que, quando estiver comigo?",shape=box,color=blue];
		j2521889904 -> j1939873691;
	j1939873691 [label="+5 Chemistry",color=orange];
		j1939873691 -> j3619263511;
	j3619263511 [label="Você é meu, e só meu.",shape=box,color=blue];
