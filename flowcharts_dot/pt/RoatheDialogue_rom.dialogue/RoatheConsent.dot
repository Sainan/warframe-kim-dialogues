	5408 [label="Chat ends.",color=orange];
	5407 [label="Ei, Roathe… tem um minutinho? [Pedir consentimento para múltiplos parceiros românticos]",shape=box,color=red];
		5407 -> 5410;
	5406 [label="[Encerrar Conversa]",shape=box,color=red];
		5406 -> 5409;
	5405 [label="Chat ends.",color=orange];
	5410 [label="Hmm? O que foi, querido?",shape=box,color=blue];
		5410 -> 5412;
	5409 [label="Update boolean RoatheConsentComplete",color=orange];
		5409 -> 5411;
	5412 [label="Quero falar com você sobre algo… e quero ter certeza de que você não tem nenhum problema com isso",shape=box,color=red];
		5412 -> 5413;
	5411 [label="Chat ends.",color=orange];
	5413 [label="Pra mim, é importante que você não sinta que tô mentindo ou sendo desonesto com você",shape=box,color=red];
		5413 -> 5414;
	5414 [label="Continue. Parece que isso vai ser muito bom.",shape=box,color=blue];
		5414 -> 5415;
	5415 [label="Não quero te colocar numa situação que você se sinta desconfortável… então, se você falar que não, tudo bem",shape=box,color=red];
		5415 -> 5416;
	5416 [label="O que temos entre nós é importante pra mim, e muito… não quero que você duvide disso, jamais",shape=box,color=red];
		5416 -> 5417;
	5417 [label="Espere. Santo Vazio, você está tentando contornar a notícia de que tem outro parceiro?",shape=box,color=blue];
		5417 -> 5418;
	5418 [label="O quanto você acha que eu sou tolo? Eu já sei, meu caro Peregrino!",shape=box,color=blue];
		5418 -> 5419;
		5418 -> 5420;
	5419 [label="Imagino que… não se importe, então?",shape=box,color=red];
		5419 -> 5421;
	5420 [label="Você… sabe?",shape=box,color=red];
		5420 -> 5422;
	5421 [label="Se ao menos você pudesse me ouvir rindo no Sanctum agora. Peregrino, querido. Meu doce Peregrino. Eu sou Orokin. Claro que não me importo.",shape=box,color=blue];
		5421 -> 5423;
	5422 [label="Se ao menos você pudesse me ouvir rindo no Sanctum agora. Peregrino, querido. Meu doce Peregrino.",shape=box,color=blue];
		5422 -> 5424;
	5423 [label="Pense o que quiser sobre a minha sociedade e a nossa inclinação para desfrutar da companhia dos outros de uma forma que você pode considerar desdenhosa e depreciativa, mas nós também entendíamos o que era amar.",shape=box,color=blue];
		5423 -> 5425;
	5424 [label="Eu soube no instante em que aconteceu. Tenho meus métodos. E não, não me importo nem um pouco. Sou Orokin.",shape=box,color=blue];
		5424 -> 5423;
	5425 [label="Ninguém entendia o amor como os Orokin. E nós sabíamos que um coração podia ter espaço para mais de uma pessoa. ",shape=box,color=blue];
		5425 -> 5426;
	5426 [label="Estou apenas desapontado porque os fanáticos provavelmente são fechados demais para participar da brincadeira.",shape=box,color=blue];
		5426 -> 5427;
	5427 [label="Bah. Pensando bem, provavelmente é melhor assim. Consegue imaginar o absurdo que isso causaria?",shape=box,color=blue];
		5427 -> 5428;
	5428 [label="Update boolean RoatheConsentComplete",color=orange];
		5428 -> 5429;
	5429 [label="Bem, independentemente disso. Se essa pessoa te faz feliz, então aproveite. Mas saiba que, quando estiver comigo?",shape=box,color=blue];
		5429 -> 5430;
	5430 [label="+5 Chemistry",color=orange];
		5430 -> 5431;
	5431 [label="Você é meu, e só meu.",shape=box,color=blue];
		5431 -> 5432;
	5432 [label="Chat ends.",color=orange];
}