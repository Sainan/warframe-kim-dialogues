digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank3Convo5 begins." [color=orange];
		"RoatheRank3Convo5 begins." -> j3825976362;
	j3825976362 [label="Albrecht sempre foi um problema desde o início. Ele e toda essa história com o Void. Acho que a Gerivaine foi dada a ele na esperança de que ter uma família o acalmasse.",shape=box,color=blue];
		j3825976362 -> j2066985962;
	j2066985962 [label="Acho que, em vez disso, só piorou as coisas. Depois que teve filhos, passou a vê-los como um par de mãos extra. Cúmplices em seus experimentos insanos.",shape=box,color=blue];
		j2066985962 -> j2227725925;
	j2227725925 [label="Descartáveis. Como tudo em sua vida.",shape=box,color=blue];
		j2227725925 -> j2827958737;
		j2227725925 -> j2141377636;
		j2227725925 -> j17348121;
	j2827958737 [label="Gerivaine?",shape=box,color=red];
		j2827958737 -> j1701619252;
	j2141377636 [label="Ele vê as pessoas como algo a mais do que simplesmente descartáveis",shape=box,color=red];
		j2141377636 -> j2984067165;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j1701619252 [label="Um nome que talvez tenha se perdido nos confins do tempo… a esposa de Albrecht Entrati, Usurpador. A mãe de seus filhos.",shape=box,color=blue];
		j1701619252 -> j4103666644;
	j2984067165 [label="Muito bem, admito que ele será capaz de assassinar qualquer pessoa ou coisa em sua vida com a frieza de um Executor. Mas não o fará sem um propósito.",shape=box,color=blue];
		j2984067165 -> j3379096777;
	"Chat ends." [color=orange];
	j4103666644 [label="Check boolean LoidFamilyComplete",color=orange];
		j4103666644 -> j3633549530 [label=true,color=green];
		j4103666644 -> j2786672766 [label=false,color=brown];
	j3379096777 [label="Sabe, agora que reflito sobre isso, foi justamente sua natureza imparcial que o tornou tão profundamente perigoso em nossa época. Ele era capaz de sacrificar qualquer coisa para alcançar seus objetivos. Absolutamente qualquer coisa.",shape=box,color=blue];
		j3379096777 -> j143338823;
		j3379096777 -> j758387066;
	j3633549530 [label="Mas aí está você, provavelmente me fazendo de bobo de novo, já que as chances são bem altas de que você já soubesse dessa informação, agora que o mordomo voltou a ter contato com eles.",shape=box,color=blue];
		j3633549530 -> j1310915751;
	j2786672766 [label="Aqueles que permanecem tão alheios à nossa existência neste Sanctum em ruínas. Algo que, para mim, continua sendo absolutamente inestimável.",shape=box,color=blue];
		j2786672766 -> j3379096777;
	j143338823 [label="Achei que os Orokin não tinham problemas em sacrificar coisas que eram importantes. Vocês todos pareciam extremamente agressivos uns com os outros",shape=box,color=red];
		j143338823 -> j2040782522;
	j758387066 [label="Como você chegou a essa conclusão?",shape=box,color=red];
		j758387066 -> j724051414;
	j1310915751 [label="Mas não vou entrar em mais uma discussão sobre isso com você. Não estou com paciência para isso.",shape=box,color=blue];
		j1310915751 -> j3379096777;
	j2040782522 [label="Você está muito ansioso para presumir muito sobre o que não sabe nada, Peregrino.",shape=box,color=blue];
		j2040782522 -> j3199571851;
	j724051414 [label="+10 Chemistry",color=orange];
		j724051414 -> j1289037589;
	j3199571851 [label="Ou será que sua pele tem um tom azulado que eu não percebi? Você era um Orokin? Se sim, peço minhas mais sinceras e profundas desculpas! ",shape=box,color=blue];
		j3199571851 -> j1968684234;
		j3199571851 -> j4209334497;
	j1289037589 [label="Pode ser um equívoco comum pensar que nós, Orokin, só traímos e matamos uns aos outros. Mas isso acontecia bastante, não me interprete mal. Éramos praticamente imortais, não tínhamos muito mais o que fazer.",shape=box,color=blue];
		j1289037589 -> j2672677088;
	j1968684234 [label="Sinto muito, não quis te ofender. Sinceramente, eu mesmo não me lembro muito da sociedade Orokin, sempre observei as coisas de fora",shape=box,color=red];
		j1968684234 -> j3763369489;
	j4209334497 [label="Foi mal se minhas memórias da sociedade Orokin não são das melhores. Basicamente, eram mensagens gravadas com ordens gritadas por alto-falantes. Isso foi antes de eu ficar preso no Void…",shape=box,color=red];
		j4209334497 -> j1651794340;
	j2672677088 [label="Mas também éramos um povo profundamente apaixonado. Ninguém fazia arte como os Orokin. Ninguém compunha música, teatro ou poesia como nós compúnhamos.",shape=box,color=blue];
		j2672677088 -> j1019757527;
	j3763369489 [label="Desculpas aceitas. Desta vez. Já lido com esse tipo de desrespeito o suficiente por parte de todos aqui. Por mais fascinante que você seja, eu não sou o saco de pancadas de ninguém. Tenho coisas melhores para fazer.",shape=box,color=blue];
		j3763369489 -> j1558747906;
	j1651794340 [label="Boolean RoatheInsulted is now true.",color=orange];
		j1651794340 -> j216274713;
	j1019757527 [label="E ninguém amava tão profundamente quanto nós, quando nossos corações se apaixonavam por outra pessoa.",shape=box,color=blue];
		j1019757527 -> j2452226498;
	j1558747906 [label="Onde eu estava? Ah, sim. Nosso impassível Entrati.",shape=box,color=blue];
		j1558747906 -> j1289037589;
	j216274713 [label="Um aviso: já lido com esse tipo de desrespeito o suficiente por parte de todos aqui. Por mais fascinante que você seja, eu não sou o saco de pancadas de ninguém. Tenho coisas melhores para fazer.",shape=box,color=blue];
		j216274713 -> j1558747906;
	j2452226498 [label="Todos, exceto o Albrecht. Tudo o que ele fazia, todas as pessoas com quem interagia, era como se ele visse tudo através de uma seção de seu vitral serigrafado.",shape=box,color=blue];
		j2452226498 -> j1176744748;
	j1176744748 [label="Afastado. Desapegado. Desinteressado. Indiferente. Até mesmo quando Gerivaine morreu, e ele ficou sozinho para criar sua filhinha.",shape=box,color=blue];
		j1176744748 -> j1969269467;
	j1969269467 [label="Check boolean LoidFamilyComplete",color=orange];
		j1969269467 -> j79929724 [label=true,color=green];
		j1969269467 -> j3671234491 [label=false,color=brown];
	j79929724 [label="Quem, por direito, estava provavelmente destinada a realizar muito mais do que jamais realizou… se ela não tivesse ficado infestada e presa no lugar. Que desperdício.",shape=box,color=blue];
		j79929724 -> j2827764619;
		j79929724 -> j3097572905;
	j3671234491 [label="Quem, por direito, estava provavelmente destinada a realizar muito mais do que jamais realizou. Mal posso esperar para ver o que aconteceu com ela e com o resto dos Entrati. Em toda a sua… glória infestada.",shape=box,color=blue];
		j3671234491 -> j153829215;
		j3671234491 -> j2997009118;
	j2827764619 [label="Fico feliz que convencemos o Loid a subir",shape=box,color=red];
		j2827764619 -> j198501731;
	j3097572905 [label="Eu sei que você não se lembra do motivo, mas foi muito bom a gente conseguir levar o Loid lá em cima",shape=box,color=red];
		j3097572905 -> j1176867282;
	j153829215 [label="Ainda me pergunto se essa é uma boa ideia…",shape=box,color=red];
		j153829215 -> j109755876;
	j2997009118 [label="Se convencermos o Loid a subir, o que você pretende fazer depois?",shape=box,color=red];
		j2997009118 -> j451474923;
	j198501731 [label="É o que você diz. E, no entanto, eu fico ali parado como uma idiota, vigiando-os, ouvindo-os falar sobre o reencontro como se eu me lembrasse de tê-lo acontecido. Você sabe o quão constrangedor isso é?!",shape=box,color=blue];
		j198501731 -> j3952555601;
	j1176867282 [label="Você sabe o quão constrangedor é ter que ficar ali fingindo que me lembro do reencontro?! Quando, por mais que eu tente, não consigo me lembrar de nada?!",shape=box,color=blue];
		j1176867282 -> j3952555601;
	j109755876 [label="Hum, muito provavelmente não. Eu estava curioso, por acaso você tem o endereço do Albrecht?",shape=box,color=blue];
		j109755876 -> j2118276247;
	j451474923 [label="Ainda não me decidi. Talvez comece a cortar-lhes os membros e a conservá-los em líquido. Por acaso você teria o endereço do Albrecht?",shape=box,color=blue];
		j451474923 -> j77670885;
	j3952555601 [label="É como estar em um evento de gala quando alguém se aproxima e claramente sabe quem você é, mas você não se lembra absolutamente nada dessa pessoa, e mesmo assim é obrigado a continuar a conversa como se a conhecesse!",shape=box,color=blue];
		j3952555601 -> j1449781934;
	j2118276247 [label="Não, por quê?",shape=box,color=red];
		j2118276247 -> j756429240;
	j77670885 [label="Quê?!",shape=box,color=red];
		j77670885 -> j1203516817;
	j1449781934 [label="Você tem a mínima noção do inferno em que me colocou?! Alguma noção?! É uma miséria ficar lá, e a culpa é toda sua! ",shape=box,color=blue];
		j1449781934 -> j1419081272;
	j756429240 [label="Eu estava pensando em… assim que chegasse lá em cima, começaria a decepar os membros da família dele e a enviá-los para ele em potes, um de cada vez.",shape=box,color=blue];
		j756429240 -> j77670885;
	j1203516817 [label="+10 Chemistry",color=orange];
		j1203516817 -> j2012585656;
	j1419081272 [label="Bah, chega disso. Preciso de uma bebida.",shape=box,color=blue];
		j1419081272 -> j1933300832;
	j2012585656 [label="Calma aí! Ninguém por aqui sabe levar uma piada na esportiva?",shape=box,color=blue];
		j2012585656 -> j3192493733;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j3192493733 [label="Quem se disporia a enviá-los por mim, afinal?",shape=box,color=blue];
		j3192493733 -> "Chat ends.";
}