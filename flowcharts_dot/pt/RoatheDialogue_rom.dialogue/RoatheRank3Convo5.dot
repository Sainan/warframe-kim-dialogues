digraph {
	1995 [label="RoatheRank3Convo5 begins.",color=orange];
		1995 -> 1996;
	1996 [label="Albrecht sempre foi um problema desde o início. Ele e toda essa história com o Void. Acho que a Gerivaine foi dada a ele na esperança de que ter uma família o acalmasse.",shape=box,color=blue];
		1996 -> 1997;
	1997 [label="Acho que, em vez disso, só piorou as coisas. Depois que teve filhos, passou a vê-los como um par de mãos extra. Cúmplices em seus experimentos insanos.",shape=box,color=blue];
		1997 -> 1998;
	1998 [label="Descartáveis. Como tudo em sua vida.",shape=box,color=blue];
		1998 -> 2001;
		1998 -> 2000;
		1998 -> 1999;
	2001 [label="Gerivaine?",shape=box,color=red];
		2001 -> 2004;
	2000 [label="Ele vê as pessoas como algo a mais do que simplesmente descartáveis",shape=box,color=red];
		2000 -> 2003;
	1999 [label="[Encerrar Conversa]",shape=box,color=red];
		1999 -> 2002;
	2004 [label="Um nome que talvez tenha se perdido nos confins do tempo… a esposa de Albrecht Entrati, Usurpador. A mãe de seus filhos.",shape=box,color=blue];
		2004 -> 2006;
	2003 [label="Muito bem, admito que ele será capaz de assassinar qualquer pessoa ou coisa em sua vida com a frieza de um Executor. Mas não o fará sem um propósito.",shape=box,color=blue];
		2003 -> 2005;
	2002 [label="Chat ends.",color=orange];
	2006 [label="Check boolean LoidFamilyComplete",color=orange];
		2006 -> 2009 [label=true,color=green];
		2006 -> 2010 [label=false,color=brown];
	2005 [label="Sabe, agora que reflito sobre isso, foi justamente sua natureza imparcial que o tornou tão profundamente perigoso em nossa época. Ele era capaz de sacrificar qualquer coisa para alcançar seus objetivos. Absolutamente qualquer coisa.",shape=box,color=blue];
		2005 -> 2007;
		2005 -> 2008;
	2009 [label="Mas aí está você, provavelmente me fazendo de bobo de novo, já que as chances são bem altas de que você já soubesse dessa informação, agora que o mordomo voltou a ter contato com eles.",shape=box,color=blue];
		2009 -> 2013;
	2010 [label="Aqueles que permanecem tão alheios à nossa existência neste Sanctum em ruínas. Algo que, para mim, continua sendo absolutamente inestimável.",shape=box,color=blue];
		2010 -> 2005;
	2007 [label="Achei que os Orokin não tinham problemas em sacrificar coisas que eram importantes. Vocês todos pareciam extremamente agressivos uns com os outros",shape=box,color=red];
		2007 -> 2011;
	2008 [label="Como você chegou a essa conclusão?",shape=box,color=red];
		2008 -> 2012;
	2013 [label="Mas não vou entrar em mais uma discussão sobre isso com você. Não estou com paciência para isso.",shape=box,color=blue];
		2013 -> 2005;
	2011 [label="Você está muito ansioso para presumir muito sobre o que não sabe nada, Peregrino.",shape=box,color=blue];
		2011 -> 2014;
	2012 [label="+10 Chemistry",color=orange];
		2012 -> 2015;
	2014 [label="Ou será que sua pele tem um tom azulado que eu não percebi? Você era um Orokin? Se sim, peço minhas mais sinceras e profundas desculpas! ",shape=box,color=blue];
		2014 -> 2016;
		2014 -> 2017;
	2015 [label="Pode ser um equívoco comum pensar que nós, Orokin, só traímos e matamos uns aos outros. Mas isso acontecia bastante, não me interprete mal. Éramos praticamente imortais, não tínhamos muito mais o que fazer.",shape=box,color=blue];
		2015 -> 2018;
	2016 [label="Sinto muito, não quis te ofender. Sinceramente, eu mesmo não me lembro muito da sociedade Orokin, sempre observei as coisas de fora",shape=box,color=red];
		2016 -> 2019;
	2017 [label="Foi mal se minhas memórias da sociedade Orokin não são das melhores. Basicamente, eram mensagens gravadas com ordens gritadas por alto-falantes. Isso foi antes de eu ficar preso no Void…",shape=box,color=red];
		2017 -> 2020;
	2018 [label="Mas também éramos um povo profundamente apaixonado. Ninguém fazia arte como os Orokin. Ninguém compunha música, teatro ou poesia como nós compúnhamos.",shape=box,color=blue];
		2018 -> 2021;
	2019 [label="Desculpas aceitas. Desta vez. Já lido com esse tipo de desrespeito o suficiente por parte de todos aqui. Por mais fascinante que você seja, eu não sou o saco de pancadas de ninguém. Tenho coisas melhores para fazer.",shape=box,color=blue];
		2019 -> 2022;
	2020 [label="Update boolean RoatheInsulted",color=orange];
		2020 -> 2023;
	2021 [label="E ninguém amava tão profundamente quanto nós, quando nossos corações se apaixonavam por outra pessoa.",shape=box,color=blue];
		2021 -> 2024;
	2022 [label="Onde eu estava? Ah, sim. Nosso impassível Entrati.",shape=box,color=blue];
		2022 -> 2015;
	2023 [label="Um aviso: já lido com esse tipo de desrespeito o suficiente por parte de todos aqui. Por mais fascinante que você seja, eu não sou o saco de pancadas de ninguém. Tenho coisas melhores para fazer.",shape=box,color=blue];
		2023 -> 2022;
	2024 [label="Todos, exceto o Albrecht. Tudo o que ele fazia, todas as pessoas com quem interagia, era como se ele visse tudo através de uma seção de seu vitral serigrafado.",shape=box,color=blue];
		2024 -> 2025;
	2025 [label="Afastado. Desapegado. Desinteressado. Indiferente. Até mesmo quando Gerivaine morreu, e ele ficou sozinho para criar sua filhinha.",shape=box,color=blue];
		2025 -> 2026;
	2026 [label="Check boolean LoidFamilyComplete",color=orange];
		2026 -> 2028 [label=true,color=green];
		2026 -> 2027 [label=false,color=brown];
	2028 [label="Quem, por direito, estava provavelmente destinada a realizar muito mais do que jamais realizou… se ela não tivesse ficado infestada e presa no lugar. Que desperdício.",shape=box,color=blue];
		2028 -> 2031;
		2028 -> 2032;
	2027 [label="Quem, por direito, estava provavelmente destinada a realizar muito mais do que jamais realizou. Mal posso esperar para ver o que aconteceu com ela e com o resto dos Entrati. Em toda a sua… glória infestada.",shape=box,color=blue];
		2027 -> 2029;
		2027 -> 2030;
	2031 [label="Fico feliz que convencemos o Loid a subir",shape=box,color=red];
		2031 -> 2035;
	2032 [label="Eu sei que você não se lembra do motivo, mas foi muito bom a gente conseguir levar o Loid lá em cima",shape=box,color=red];
		2032 -> 2036;
	2029 [label="Ainda me pergunto se essa é uma boa ideia…",shape=box,color=red];
		2029 -> 2033;
	2030 [label="Se convencermos o Loid a subir, o que você pretende fazer depois?",shape=box,color=red];
		2030 -> 2034;
	2035 [label="É o que você diz. E, no entanto, eu fico ali parado como uma idiota, vigiando-os, ouvindo-os falar sobre o reencontro como se eu me lembrasse de tê-lo acontecido. Você sabe o quão constrangedor isso é?!",shape=box,color=blue];
		2035 -> 2039;
	2036 [label="Você sabe o quão constrangedor é ter que ficar ali fingindo que me lembro do reencontro?! Quando, por mais que eu tente, não consigo me lembrar de nada?!",shape=box,color=blue];
		2036 -> 2039;
	2033 [label="Hum, muito provavelmente não. Eu estava curioso, por acaso você tem o endereço do Albrecht?",shape=box,color=blue];
		2033 -> 2037;
	2034 [label="Ainda não me decidi. Talvez comece a cortar-lhes os membros e a conservá-los em líquido. Por acaso você teria o endereço do Albrecht?",shape=box,color=blue];
		2034 -> 2038;
	2039 [label="É como estar em um evento de gala quando alguém se aproxima e claramente sabe quem você é, mas você não se lembra absolutamente nada dessa pessoa, e mesmo assim é obrigado a continuar a conversa como se a conhecesse!",shape=box,color=blue];
		2039 -> 2042;
	2037 [label="Não, por quê?",shape=box,color=red];
		2037 -> 2040;
	2038 [label="Quê?!",shape=box,color=red];
		2038 -> 2041;
	2042 [label="Você tem a mínima noção do inferno em que me colocou?! Alguma noção?! É uma miséria ficar lá, e a culpa é toda sua! ",shape=box,color=blue];
		2042 -> 2044;
	2040 [label="Eu estava pensando em… assim que chegasse lá em cima, começaria a decepar os membros da família dele e a enviá-los para ele em potes, um de cada vez.",shape=box,color=blue];
		2040 -> 5776;
	2041 [label="+10 Chemistry",color=orange];
		2041 -> 2043;
	2044 [label="Bah, chega disso. Preciso de uma bebida.",shape=box,color=blue];
		2044 -> 2046;
	5776 [label="Quê?!",shape=box,color=red];
		5776 -> 2041;
	2043 [label="Calma aí! Ninguém por aqui sabe levar uma piada na esportiva?",shape=box,color=blue];
		2043 -> 2045;
	2046 [label="+10 Chemistry",color=orange];
		2046 -> 2048;
	2045 [label="Quem se disporia a enviá-los por mim, afinal?",shape=box,color=blue];
		2045 -> 2047;
	2048 [label="Chat ends.",color=orange];
	2047 [label="Chat ends.",color=orange];
}