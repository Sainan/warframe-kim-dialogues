		j2813753334 -> j4250892152 [label="false",color=purple];
	j334852197 [label="O que eu penso da Marie? Além de tentar te convencer a deixá-la passar uma ou duas noites conosco, querido Peregrino? (Estou brincando, estou brincando)",shape=box,color=blue];
		j334852197 -> j1215143185;
	j3701729389 [label="O que eu penso da Marie? Além de tentar te convencer a me deixar passar uma ou duas noites com vocês? (Estou brincando, estou brincando)",shape=box,color=blue];
		j3701729389 -> j350599049;
	j2400007898 [label="Mas como você conseguiu convencê-la a mudar de ideia sobre a pureza do Albrecht? Você é um verdadeiro \"milagre\". Talvez eles não devessem venerar o Sol e a Lua, mas sim você.",shape=box,color=blue];
		j2400007898 -> j390209906;
	j2021089499 [label="Eu nunca soube que ela ainda sente dores diariamente. Ela esconde isso como se não existisse. Ela não falava sobre isso até te contar. Você criou uma ponte entre nós.",shape=box,color=blue];
		j2021089499 -> j3340794205;
	j196368169 [label="Só recentemente tomei conhecimento da história dela. Ela nunca me contou sua história até que a contou para você. Você criou uma ponte entre nós.",shape=box,color=blue];
		j196368169 -> j1724701374;
	j4240255868 [label="Como sempre. Passo cada segundo acordado tentando não arrancar meu próprio rosto com as garras, num desejo desesperado de silenciá-la.",shape=box,color=blue];
		j4240255868 -> "Chat ends.";
	j1471752021 [label="Melhor agora que tenho alguém com quem desabafar minhas frustrações. Mas, falando sério, a tensão entre nós diminuiu bastante.",shape=box,color=blue];
		j1471752021 -> j1952165792;
	j501536702 [label="Não sou eu que estou \"me dando bem\" com o Lyon, né? Há! Desculpe a piada horrível. Não consigo me controlar, e você tornou isso muito fácil.",shape=box,color=blue];
		j501536702 -> j2648260903;
	j2909769494 [label="Melhor do que vocês dois, pelo que parece. Como você conseguiu estragar tudo com ele? Tudo o que ele precisava era de alguém que o ouvisse. ",shape=box,color=blue];
		j2909769494 -> j2313997974;
	j3246366882 [label="As tensões entre nós melhoraram bastante, principalmente depois que você lhe deu a confiança necessária para falar sobre o que o estava incomodando.",shape=box,color=blue];
		j3246366882 -> j3680163140;
	j2055944915 [label="As tensões entre nós melhoraram bastante, principalmente depois que você lhe deu a confiança necessária para falar sobre o que o estava incomodando.",shape=box,color=blue];
		j2055944915 -> j3180909975;
	j1269649375 [label="Como sempre. Passo cada segundo acordado tentando não arrancar meu próprio rosto com as garras, num desejo desesperado de silenciá-lo.",shape=box,color=blue];
		j1269649375 -> "Chat ends.";
	j3560908170 [label="Admito que, aos poucos, estou achando-os um pouco mais toleráveis. Acho que principalmente porque, aos poucos, eles estão desistindo de mim.",shape=box,color=blue];
		j3560908170 -> j3993751409;
	j4018161678 [label="Admito que, aos poucos, estou achando-os um pouco mais toleráveis. Acho que minhas revelações recentes podem ter algo a ver com isso.",shape=box,color=blue];
		j4018161678 -> j536918563;
	j4250892152 [label="Cada vez mais me pergunto por que, embora eu não possa usar o Refratário Obscuro para recuperar minhas memórias, já que agora sou um Protoframe…",shape=box,color=blue];
		j4250892152 -> j3557825445;
	j1215143185 [label="Será que ela percebe que minhas provocações, que antes eram apenas irritação genuína, agora se transformaram em brincadeiras amigáveis?",shape=box,color=blue];
		j1215143185 -> j3470208716;
	j350599049 [label="Devo admitir que não te culpo nem um pouco. E não é só porque ela é linda. Eu tenho olhos. Aquela mulher tem mais compaixão do que eu imaginaria que alguém pudesse ter, ainda mais considerando a época dela.",shape=box,color=blue];
		j350599049 -> j1215143185;
	j390209906 [label="Bah. Foi esse tipo de linguagem que levou à ascensão do Império Orokin. Esse é um erro que este sistema jamais deveria cometer duas vezes.",shape=box,color=blue];
		j390209906 -> j1215143185;
	j3340794205 [label="Admito que sou um dos tolos de quem ela fala, que não conseguem conceber viver dessa maneira, dia após dia.",shape=box,color=blue];
		j3340794205 -> j3590376698;
	j1724701374 [label="Pensar que sua família a jogou na rua. Ela, a Marie. Aquela Marie. Aquela que tinha mais compaixão do que se poderia imaginar?!",shape=box,color=blue];
		j1724701374 -> j1259085109;
	j1952165792 [label="Eles sabem do meu… segredo. A verdade sobre eu ter tomado o soro voluntariamente.",shape=box,color=blue];
		j1952165792 -> j88882316;
		j1952165792 -> j3682024967;
	j2648260903 [label="Eu te admiro por ter tido a coragem de enfrentar aquele pobre louco. Ele precisa de companhia. E de compaixão.",shape=box,color=blue];
		j2648260903 -> j739685031;
	j2313997974 [label="No entanto, você calou ele. Que vergonha!",shape=box,color=blue];
		j2313997974 -> "Chat ends.";
	j3680163140 [label="Ele me falou sobre a criança Tenno que ele vinha ouvindo. E como ele não a ouve mais.",shape=box,color=blue];
		j3680163140 -> j2493637703;
	j3180909975 [label="Eu sabia muito pouco sobre o que lhe tinha feito. Só depois de ele te contar é que ele teve coragem de me contar. ",shape=box,color=blue];
		j3180909975 -> j2832736105;
	j3993751409 [label="Eu brinco com eles. Estou começando a gostar estranhamente deles, apesar do meu renovado compromisso de ignorar as críticas que fazem às minhas decisões de vida.",shape=box,color=blue];
		j3993751409 -> j1038043057;
		j3993751409 -> j2419745031;
	j536918563 [label="Eu esperava que eles recebessem meu arrependimento com escárnio, com zombarias do tipo \"finalmente, ele viu a luz\" ou \"nós te avisamos\". Mas foi tudo, menos isso. Eles quase não mencionaram o assunto.",shape=box,color=blue];
		j536918563 -> j3722747977;
	j3557825445 [label="Se é que isso ainda não me impede de me afogar nisso…",shape=box,color=blue];
		j3557825445 -> "Chat ends.";
	j3470208716 [label="Espero que sim. É muito divertido importuná-la. Vê-la ficar brava e gritar comigo em sua língua nativa é meu novo esporte favorito.",shape=box,color=blue];
		j3470208716 -> j3405582322;
	j3590376698 [label="Como ela consegue manter tanta compostura? E quanto mais compaixão? Acho que eu teria enlouquecido como o padre naquele estado.",shape=box,color=blue];
		j3590376698 -> j1215143185;
	j1259085109 [label="Não consigo descrever o meu desejo de usar um Helminte para viajar no tempo e assassinar toda a família dela. Lentamente. Mas ela provavelmente se oporia a isso. ",shape=box,color=blue];
		j1259085109 -> j528030855;
	j88882316 [label="Eu não contei pra eles",shape=box,color=red];
		j88882316 -> j4115004764;
	j3682024967 [label="Como eles descobriram?",shape=box,color=red];
		j3682024967 -> j509575989;
	j739685031 [label="Mas, falando sério, as tensões entre nós melhoraram bastante.",shape=box,color=blue];
		j739685031 -> j1952165792;
	j2493637703 [label="Imagino que a voz o assombrará em seus pesadelos, mesmo quando estiver acordado. Coitado, sempre questionará a linha tênue entre realidade e ficção.",shape=box,color=blue];
		j2493637703 -> j1868548560;
	j2832736105 [label="Não consigo descrever o meu desejo de usar um Helminte para viajar no tempo e assassinar os pais dele. Lentamente. Mas temo que ele possa se opor a isso.",shape=box,color=blue];
		j2832736105 -> j2998400991;
	j1038043057 [label="Vocês três estão presos juntos de qualquer forma, cortesia do Entrati. Então, não há mal nenhum em tirar o melhor da situação",shape=box,color=red];
		j1038043057 -> j908021860;
	j2419745031 [label="Que bom, acho que eles realmente se importam com você",shape=box,color=red];
		j2419745031 -> j3286950517;
	j3722747977 [label="Ainda bem que não. Não quero que esfreguem meu nariz nisso como um cachorrinho que sujou o tapete. Já tenho com o que me preocupar.",shape=box,color=blue];
		j3722747977 -> j1038043057;
		j3722747977 -> j2419745031;
	j3405582322 [label="Outro motivo para a melhora das nossas relações? Eles sabem do meu segredo. A verdade sobre eu ter tomado o soro por vontade própria.",shape=box,color=blue];
		j3405582322 -> j2919256586;
		j3405582322 -> j1107441367;
	j528030855 [label="Assassinatos por vingança provavelmente são malvistos pelo Sol, etc., etc. ",shape=box,color=blue];
