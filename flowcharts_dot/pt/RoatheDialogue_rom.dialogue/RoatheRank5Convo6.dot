		j2782289518 -> j196229545;
	j3774114675 [label="Principalmente o Lyon. Acho que ele entende a dificuldade de encarar o passado e as decisões que tomamos. Veja bem: tapa-olho, se me permite o trocadilho.",shape=box,color=blue];
		j3774114675 -> j32725969;
	j2537555819 [label="Ele sentou-se ao meu lado e me contou como questionava sua fé desde que o Entrati lhe deu o soro. Como se envergonhava de seus questionamentos. Como se arrependia de ter tomado o soro.",shape=box,color=blue];
		j2537555819 -> j2668575682;
