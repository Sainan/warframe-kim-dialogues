		j88655537 -> j1093047434;
	j4213231669 [label="Principalmente depois de tudo o que ela aprendeu sobre o Entrati. Ela sabe que as pessoas podem ser mais complexas do que uma simples questão de preto e branco.",shape=box,color=red];
