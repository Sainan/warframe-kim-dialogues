	4805 [label="Chat ends.",color=orange];
	4806 [label="O que eu penso da Marie? Além de tentar te convencer a deixá-la passar uma ou duas noites conosco, querido Peregrino? (Estou brincando, estou brincando)",shape=box,color=blue];
		4806 -> 4821;
	4807 [label="O que eu penso da Marie? Além de tentar te convencer a me deixar passar uma ou duas noites com vocês? (Estou brincando, estou brincando)",shape=box,color=blue];
		4807 -> 4822;
	4808 [label="Mas como você conseguiu convencê-la a mudar de ideia sobre a pureza do Albrecht? Você é um verdadeiro \"milagre\". Talvez eles não devessem venerar o Sol e a Lua, mas sim você.",shape=box,color=blue];
		4808 -> 4823;
	4810 [label="Eu nunca soube que ela ainda sente dores diariamente. Ela esconde isso como se não existisse. Ela não falava sobre isso até te contar. Você criou uma ponte entre nós.",shape=box,color=blue];
		4810 -> 4825;
	4809 [label="Só recentemente tomei conhecimento da história dela. Ela nunca me contou sua história até que a contou para você. Você criou uma ponte entre nós.",shape=box,color=blue];
		4809 -> 4824;
	4811 [label="Como sempre. Passo cada segundo acordado tentando não arrancar meu próprio rosto com as garras, num desejo desesperado de silenciá-la.",shape=box,color=blue];
		4811 -> 4826;
	4812 [label="Melhor agora que tenho alguém com quem desabafar minhas frustrações. Mas, falando sério, a tensão entre nós diminuiu bastante.",shape=box,color=blue];
		4812 -> 4827;
	4813 [label="Não sou eu que estou \"me dando bem\" com o Lyon, né? Há! Desculpe a piada horrível. Não consigo me controlar, e você tornou isso muito fácil.",shape=box,color=blue];
		4813 -> 4828;
	4814 [label="Melhor do que vocês dois, pelo que parece. Como você conseguiu estragar tudo com ele? Tudo o que ele precisava era de alguém que o ouvisse. ",shape=box,color=blue];
		4814 -> 4829;
	4815 [label="As tensões entre nós melhoraram bastante, principalmente depois que você lhe deu a confiança necessária para falar sobre o que o estava incomodando.",shape=box,color=blue];
		4815 -> 4830;
	4816 [label="As tensões entre nós melhoraram bastante, principalmente depois que você lhe deu a confiança necessária para falar sobre o que o estava incomodando.",shape=box,color=blue];
		4816 -> 4831;
	4817 [label="Como sempre. Passo cada segundo acordado tentando não arrancar meu próprio rosto com as garras, num desejo desesperado de silenciá-lo.",shape=box,color=blue];
		4817 -> 4832;
	4820 [label="Admito que, aos poucos, estou achando-os um pouco mais toleráveis. Acho que principalmente porque, aos poucos, eles estão desistindo de mim.",shape=box,color=blue];
		4820 -> 4835;
	4819 [label="Admito que, aos poucos, estou achando-os um pouco mais toleráveis. Acho que minhas revelações recentes podem ter algo a ver com isso.",shape=box,color=blue];
		4819 -> 4834;
	4818 [label="Cada vez mais me pergunto por que, embora eu não possa usar o Refratário Obscuro para recuperar minhas memórias, já que agora sou um Protoframe…",shape=box,color=blue];
		4818 -> 4833;
	4821 [label="Será que ela percebe que minhas provocações, que antes eram apenas irritação genuína, agora se transformaram em brincadeiras amigáveis?",shape=box,color=blue];
		4821 -> 4836;
	4822 [label="Devo admitir que não te culpo nem um pouco. E não é só porque ela é linda. Eu tenho olhos. Aquela mulher tem mais compaixão do que eu imaginaria que alguém pudesse ter, ainda mais considerando a época dela.",shape=box,color=blue];
		4822 -> 4821;
	4823 [label="Bah. Foi esse tipo de linguagem que levou à ascensão do Império Orokin. Esse é um erro que este sistema jamais deveria cometer duas vezes.",shape=box,color=blue];
		4823 -> 4821;
	4825 [label="Admito que sou um dos tolos de quem ela fala, que não conseguem conceber viver dessa maneira, dia após dia.",shape=box,color=blue];
		4825 -> 4838;
	4824 [label="Pensar que sua família a jogou na rua. Ela, a Marie. Aquela Marie. Aquela que tinha mais compaixão do que se poderia imaginar?!",shape=box,color=blue];
		4824 -> 4837;
	4826 [label="Chat ends.",color=orange];
	4827 [label="Eles sabem do meu… segredo. A verdade sobre eu ter tomado o soro voluntariamente.",shape=box,color=blue];
		4827 -> 4839;
		4827 -> 4840;
	4828 [label="Eu te admiro por ter tido a coragem de enfrentar aquele pobre louco. Ele precisa de companhia. E de compaixão.",shape=box,color=blue];
		4828 -> 4841;
	4829 [label="No entanto, você calou ele. Que vergonha!",shape=box,color=blue];
		4829 -> 4842;
	4830 [label="Ele me falou sobre a criança Tenno que ele vinha ouvindo. E como ele não a ouve mais.",shape=box,color=blue];
		4830 -> 4843;
	4831 [label="Eu sabia muito pouco sobre o que lhe tinha feito. Só depois de ele te contar é que ele teve coragem de me contar. ",shape=box,color=blue];
		4831 -> 4844;
	4832 [label="Chat ends.",color=orange];
	4835 [label="Eu brinco com eles. Estou começando a gostar estranhamente deles, apesar do meu renovado compromisso de ignorar as críticas que fazem às minhas decisões de vida.",shape=box,color=blue];
		4835 -> 4847;
		4835 -> 4848;
	4834 [label="Eu esperava que eles recebessem meu arrependimento com escárnio, com zombarias do tipo \"finalmente, ele viu a luz\" ou \"nós te avisamos\". Mas foi tudo, menos isso. Eles quase não mencionaram o assunto.",shape=box,color=blue];
		4834 -> 4846;
	4833 [label="Se é que isso ainda não me impede de me afogar nisso…",shape=box,color=blue];
		4833 -> 4845;
	4836 [label="Espero que sim. É muito divertido importuná-la. Vê-la ficar brava e gritar comigo em sua língua nativa é meu novo esporte favorito.",shape=box,color=blue];
		4836 -> 4849;
	4838 [label="Como ela consegue manter tanta compostura? E quanto mais compaixão? Acho que eu teria enlouquecido como o padre naquele estado.",shape=box,color=blue];
		4838 -> 4821;
	4837 [label="Não consigo descrever o meu desejo de usar um Helminte para viajar no tempo e assassinar toda a família dela. Lentamente. Mas ela provavelmente se oporia a isso. ",shape=box,color=blue];
