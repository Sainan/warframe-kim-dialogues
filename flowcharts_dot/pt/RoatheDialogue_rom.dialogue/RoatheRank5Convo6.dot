	j3719152416 [label="+5 Chemistry",color=orange];
		j3719152416 -> j461491866;
	j3026249664 [label="Certa noite, enquanto eu lia em silêncio sozinho, alguns dias depois, ele se aproximou por conta própria.",shape=box,color=blue];
		j3026249664 -> j4029800438;
	j628887964 [label="É claro que a abracei de volta. Sou um Orokin, mas não sou um monstro.",shape=box,color=blue];
		j628887964 -> j2496170938;
	j1136154238 [label="Aquele padre. Se eu pudesse terminar com uma única observação, seria esta: sua resiliência é, de alguma forma, tão infinita quanto o próprio tempo. ",shape=box,color=blue];
		j1136154238 -> j4099865812;
	j1518268467 [label="Eles mal mencionaram isso. E sou profundamente grato por isso. Eu esperava vaias e escárnio. \"Finalmente, o diabo foi derrotado.\" Mas não foi o caso. Eles continuaram como se nada tivesse mudado.",shape=box,color=blue];
		j1518268467 -> j3774114675;
	j3687784681 [label="O Roathe de outrora teria aproveitado a oportunidade para remover os rins do próprio corpo, mas descobri que já não tinha esse desejo. ",shape=box,color=blue];
		j3687784681 -> j2756851877;
	j3002613652 [label="Foi preciso toda a minha força de vontade para não arrancar os rins dela do corpo. Mas ela só queria me oferecer um simples conforto.",shape=box,color=blue];
		j3002613652 -> j1551219989;
	j1271638547 [label="Ela só queria me oferecer um simples conforto.",shape=box,color=blue];
		j1271638547 -> j1302127877;
	j3207889860 [label="Sim, é verdade. E devo agradecer-lhe por isso, não é?",shape=box,color=blue];
		j3207889860 -> j3167388897;
	j461491866 [label="Acho que no fim das contas vai se provar mais do que isso. Mesmo que eu deteste esse fato. Afinal, não tenho como evitar ficar preso a eles.",shape=box,color=blue];
		j461491866 -> j3167388897;
	j4029800438 [label="Ele sentou-se ao meu lado e me contou como questionava sua fé desde que o Entrati lhe deu o soro. Como se envergonhava de seus questionamentos. Como se arrependia de ter tomado o soro.",shape=box,color=blue];
		j4029800438 -> j3289617576;
	j2496170938 [label="E então?",shape=box,color=blue];
		j2496170938 -> j2024193333;
	j4099865812 [label="Para um homem que já se despedaçou, ele ainda não se desfez completamente.",shape=box,color=blue];
		j4099865812 -> j1622505995;
	j2756851877 [label="Pela primeira vez em minha vida miserável, aceitei a simples oferta de conforto pelo que ela era.",shape=box,color=blue];
		j2756851877 -> j1551219989;
	j1551219989 [label="Era uma forma simples de me dizer que talvez ela não se importasse tanto quanto eu. E que ela lamentava toda a dor que eu havia me causado por causa disso.",shape=box,color=blue];
		j1551219989 -> j1302127877;
	j1302127877 [label="E então?",shape=box,color=blue];
		j1302127877 -> j1518268467;
	j3167388897 [label="Aquela Irmã do Sol. Se eu pudesse terminar com uma única observação, seria esta: sua bondade é, de alguma forma, tão infinita quanto o próprio tempo.",shape=box,color=blue];
		j3167388897 -> j226015943;
	j3289617576 [label="Acima de tudo, como ele desejava poder esquecer tudo. E que talvez, em um nível mais profundo, nós três fôssemos todos iguais.",shape=box,color=blue];
		j3289617576 -> j2496170938;
