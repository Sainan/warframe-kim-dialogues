	j2968105400 [label="Após o primeiro ataque expedicionário dos Sentients, havíamos preparado um contra-ataque punitivo.",shape=box,color=blue];
		j2968105400 -> j2609868601;
	j2609868601 [label="A Feiticeira de Vidro Áureo emergiu da névoa de Ceres com suas asas letais, um galeão carregado de drones e mirmidões com armaduras prateadas.",shape=box,color=blue];
		j2609868601 -> j3645495936;
	j3645495936 [label="Circuitos, tão finos quanto a névoa, formavam uma delicada renda sob suas armaduras translúcidas. ",shape=box,color=blue];
		j3645495936 -> j2346215748;
	j2346215748 [label="Era tão vasta que mal cabia nos limites do Trilho Solar.",shape=box,color=blue];
		j2346215748 -> j3006191610;
	j3006191610 [label="Os Sentients garantiram que víssemos o resultado. Eles entoaram cânticos, e nossa tecnologia falhou. Nossos guerreiros lutaram e sufocaram em seus trajes reluzentes.",shape=box,color=blue];
		j3006191610 -> j2484906531;
	j2484906531 [label="A tripulação da Feiticeira de Vidro Áureo foi queimada viva enquanto a nave mergulhava sem motores pelos céus de Tau, um espetáculo pirotécnico complexo e custoso.",shape=box,color=blue];
		j2484906531 -> j921430358;
