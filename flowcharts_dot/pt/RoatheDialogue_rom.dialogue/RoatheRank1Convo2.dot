digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank1Convo2 begins." [color=orange];
		"RoatheRank1Convo2 begins." -> j3275353133;
	j3275353133 [label="Você sabe que a sua suposta \"Indiferença\" não é um \"deus\" de verdade, certo?",shape=box,color=blue];
		j3275353133 -> j2304019474;
		j3275353133 -> j1366246955;
		j3275353133 -> j17348121;
	j2304019474 [label="Ele tá bem perto disso",shape=box,color=red];
		j2304019474 -> j362143380;
	j1366246955 [label="E o que te faz ter tanta certeza?",shape=box,color=red];
		j1366246955 -> j1642915425;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j362143380 [label="Todos com quem converso neste hospício estão absolutamente convencidos de que esse \"Homem na Parede\" é algum tipo de deus literal e ridículo. Um deus de verdade. Até aqueles dois fanáticos parecem comprar essa ideia!",shape=box,color=blue];
		j362143380 -> j2335847348;
		j362143380 -> j1461412960;
		j362143380 -> j742865302;
	j1642915425 [label="Bem, deixando de lado a dura realidade de que qualquer crença em um deus ou deuses surge de idiotas que se apegam a: primeiro, uma necessidade irresistível de conforto quando se deparam com o horror brutal da finalidade de sua alma no momento da morte,",shape=box,color=blue];
		j1642915425 -> j453839744;
	"Chat ends." [color=orange];
	j2335847348 [label="Você acha que ele não existe?",shape=box,color=red];
		j2335847348 -> j2554510554;
	j1461412960 [label="E se você não acha que ele é um deus, o que acha que ele é então?",shape=box,color=red];
		j1461412960 -> j2537959016;
	j742865302 [label="E você não?",shape=box,color=red];
		j742865302 -> j1740599606;
	j453839744 [label="Em segundo lugar, a ansiedade que se sente ao perceber que não existe um \"Poder Superior\" que trace o rumo de nossas vidas e que, consequentemente, somos simplesmente responsáveis ​​por nossas próprias ações e, portanto, por extensão,",shape=box,color=blue];
		j453839744 -> j1248606970;
	j2554510554 [label="Por acaso eu disse essas palavras? Não coloque palavras na minha boca, ó Ursupador transitório. Eu não nego que a Indiferença seja \"real\". Eu nego que seja um Deus.",shape=box,color=blue];
		j2554510554 -> j1671438738;
		j2554510554 -> j3930882764;
	j2537959016 [label="Consigo desmascarar essa falsa divindade em duas palavras simples que você deve conhecer e compreender muito bem:",shape=box,color=blue];
		j2537959016 -> j1954139959;
	j1740599606 [label="De jeito nenhum! Primeiro, não existe deus ou deuses. Essa ideia é absurda. Segundo, pensar que o Albrecht libertou um deus do Void? Mais absurdo ainda!",shape=box,color=blue];
		j1740599606 -> j1118429920;
	j1248606970 [label="Em terceiro lugar, a justa indignação que acompanha a angústia e o horror, quando tudo isso leva à revelação de que não existe \"Inferno\" esperando pelos demônios, nem \"Céu\" pelos anjos.",shape=box,color=blue];
		j1248606970 -> j1605380576;
	j1671438738 [label="Aquilo lá é mais poderoso do que qualquer coisa que eu já enfrentei",shape=box,color=red];
		j1671438738 -> j1387100192;
	j3930882764 [label="Você acha que ele é o que então?",shape=box,color=red];
		j3930882764 -> j2537959016;
	j1954139959 [label="Incorporação Conceitual.",shape=box,color=blue];
		j1954139959 -> j1472210997;
		j1954139959 -> j2948558484;
		j1954139959 -> j232746187;
	j1118429920 [label="Não há nada no Void. É por isso que ele se chama Void! ",shape=box,color=blue];
		j1118429920 -> j4148500019;
		j1118429920 -> j1435574888;
	j1605380576 [label="Presumo que você não seja um fanático babão que se agarra à raiva, ao horror ou à ansiedade. Partindo dessa premissa, vou prosseguir com o meu segundo argumento para desmascarar a divindade da \"Indiferença\":",shape=box,color=blue];
		j1605380576 -> j1954139959;
	j1387100192 [label="E quando foi que eu neguei isso? Aliás, parece que todos vocês se deixaram levar por um estado de histeria desnecessariamente exagerado.",shape=box,color=blue];
		j1387100192 -> j1797431359;
		j1387100192 -> j3459565031;
	j1472210997 [label="O Void e o que dá pra criar com ele é perigoso e poderoso, vai por mim, sei do que tô falando. Mas ele tem limites. Acha mesmo que ele é capaz de manifestar algo assim? De criar idiomas inteiros, dedos que conseguem impulsionar naves que atravessam o Void?",shape=box,color=red];
		j1472210997 -> j2815958378;
	j2948558484 [label="É… bem tentador acreditar que isso é apenas um monstro debaixo da cama, Roathe. Mas eu vi essa coisa, cara a cara, e não sei como algo assim simplesmente surge da nossa mente",shape=box,color=red];
		j2948558484 -> j2557983755;
	j232746187 [label="A Incorporação Conceitual não consegue fazer o que o Homem na Parede é capaz de fazer. Pode ser que o Entrati tenha manifestado essa coisa e seja responsável por trazer isso para cá, mas não acredito que ele seja a fonte original",shape=box,color=red];
		j232746187 -> j1823061784;
	j4148500019 [label="Não. Eu já vi coisas que surgiram do Void. Anjos cantando… fantasmas",shape=box,color=red];
		j4148500019 -> j2046908633;
	j1435574888 [label="Eu… ",shape=box,color=red];
		j1435574888 -> j2046908633;
	j1797431359 [label="Tá querendo dizer o que?",shape=box,color=red];
		j1797431359 -> j1161002727;
	j3459565031 [label="Pera lá. Como é que a culpa é nossa? A culpa é do Albrecht, ele que largou essa bomba",shape=box,color=red];
		j3459565031 -> j131403677;
	j2815958378 [label="A humanidade é certamente ilimitada em sua criatividade na escala e magnitude das novas formas de sofrimento que consegue infligir a si mesma, não é? Você mesmo testemunhou muitas crueldades que ninguém ousaria imaginar possíveis na época de nossos queridos fanáticos.",shape=box,color=blue];
		j2815958378 -> j260537950;
	j2557983755 [label="Ah, você está tão perto da verdade e, no entanto, é tão rápido em rejeitá-la. Você acha \"tentador\" acreditar que talvez seja uma criação da sua própria mente, porque seria mais fácil rejeitá-la se fosse esse o caso? Não, eu acho muito mais perigoso confrontar uma criação nossa do que um deus.",shape=box,color=blue];
		j2557983755 -> j3732553126;
	j1823061784 [label="Embora eu aprecie sua humildade, questiono sua compreensão limitada do potencial criativo humano — especialmente no que diz respeito à forma como ela pode conceber novas formas de sofrimento. Não é você, na verdade, o único responsável por criar seu próprio universo do nada?",shape=box,color=blue];
		j1823061784 -> j278921226;
	j2046908633 [label="A única coisa que vem do Void é aquilo que colocamos nele – e aquilo que dele retorna. Ele transforma matéria e energia, mas não pode criá-las.",shape=box,color=blue];
		j2046908633 -> j2708407329;
	j1161002727 [label="O que estou dizendo é: Albrecht pode ter sido o primeiro a vislumbrar sua própria arrogância refletida na face sorridente de um deus da destruição, de fato.",shape=box,color=blue];
		j1161002727 -> j2864282592;
	j131403677 [label="Albrecht pode ter sido o primeiro a vislumbrar sua própria arrogância refletida na face sorridente de um deus da destruição, de fato.",shape=box,color=blue];
		j131403677 -> j2864282592;
	j260537950 [label="+15 Chemistry",color=orange];
		j260537950 -> j283177696;
	j3732553126 [label="Um inimigo externo pode ser compreendido, manipulado, derrotado. Talvez seja até possível negociar com ele, se necessário. Ele possui fraquezas exploráveis. Mas um inimigo interno? Um inimigo que nós mesmos criamos? Esse é muito mais insidioso.",shape=box,color=blue];
		j3732553126 -> j2458355734;
	j278921226 [label="Você mesmo testemunhou muitas crueldades que ninguém ousaria imaginar possíveis na época de nossos queridos fanáticos. ",shape=box,color=blue];
		j278921226 -> j535436671;
	j2708407329 [label="Pensa direito, Peregrino. Esses \"Anjos do Void\" de que você fala. Esses fantasmas. Seriam eles feitos daqueles que já se perderam no Void?",shape=box,color=blue];
		j2708407329 -> j290013646;
	j2864282592 [label="Mas todos vocês são igualmente responsáveis por continuarem a empurrar esse besouro rola-bosta ladeira abaixo por tanto tempo, fazendo com que ele cresça a cada pedaço de fezes que coleta pelo caminho!",shape=box,color=blue];
		j2864282592 -> j1082651848;
	j283177696 [label="Como espécie, somos admiráveis em nossa capacidade de alimentar os nossos medos com novas formas de autodestruição.",shape=box,color=blue];
		j283177696 -> j3706229277;
	j2458355734 [label="+20 Chemistry",color=orange];
		j2458355734 -> j4161244379;
	j535436671 [label="+10 Chemistry",color=orange];
		j535436671 -> j283177696;
	j290013646 [label="Eram meros ecos de energia sendo regurgitados como um kutak colorido para alimentar seus filhotes.",shape=box,color=blue];
		j290013646 -> j1082651848;
	j1082651848 [label="Permita-me simplificar a questão para você. Eu consigo desmascarar essa falsa divindade em duas palavras simples que você deve conhecer e compreender muito bem:",shape=box,color=blue];
		j1082651848 -> j1954139959;
	j3706229277 [label="Hmm. Receio que devo partir. Deixarei que você reflita sobre isso por um tempo e pondere minhas palavras.",shape=box,color=blue];
		j3706229277 -> j3471552066;
		j3706229277 -> j1421484811;
	j4161244379 [label="Porque aí temos que lutar contra os nossos próprios demônios. E a humanidade… nunca vence esse tipo de guerra, não é?",shape=box,color=blue];
		j4161244379 -> j3706229277;
	j3471552066 [label="Vou fazer isso. Valeu",shape=box,color=red];
		j3471552066 -> j3819439049;
	j1421484811 [label="Pensa no que eu falei também. Você pode acabar querendo acreditar em mim quando estiver enfrentando um anti-deus",shape=box,color=red];
		j1421484811 -> j3819439049;
	j3819439049 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j3819439049 -> "Chat ends.";
}