	"Chat ends." [color=orange];
	j3849137069 [label="ÁUDIO: COMANDANTES",shape=box,color=blue];
		j3849137069 -> j1496413693;
	j1496413693 [label="Agora me lembro deles. Grupos de jovens Orokin risonhos.",shape=box,color=blue];
		j1496413693 -> j3600525146;
	j3600525146 [label="Nobreza vestida com as ainda intocadas vestes de comando.",shape=box,color=blue];
		j3600525146 -> j828308684;
	j828308684 [label="Amigos de infância, agora no comando de legiões de Dax, de Grineer, células de matéria nula, carcinômetros autorreplicantes, aranhas-lâmina primitivas, contêineres de tropas de baixa tecnologia.",shape=box,color=blue];
		j828308684 -> j366143562;
	j366143562 [label="Meninos e meninas dourados com diabos vorazes às suas ordens.",shape=box,color=blue];
		j366143562 -> j3014149257;
	j3014149257 [label="Sua arrogância escorre como suor ardente em minha mente. Eles bebiam e cantavam, vangloriando-se dos tempos vindouros.",shape=box,color=blue];
		j3014149257 -> j2466225580;
	j2466225580 [label="Eles deixariam sua marca. Elevariam suas famílias ao prestígio.",shape=box,color=blue];
		j2466225580 -> j94057199;
	j94057199 [label="Muitos caíram. Nem mesmo seus corpos foram recuperados.",shape=box,color=blue];
		j94057199 -> j1424879171;
	j1424879171 [label="Para impedir que o inimigo descobrisse nossos segredos, eles foram submetidos a uma explosão de Kuva que os liquefez após a morte.",shape=box,color=blue];
		j1424879171 -> j1738258476;
	j1738258476 [label="A esperança de uma geração transformada em uma poça de óleo, pisoteada pelas botas dos Grineers.",shape=box,color=blue];
		j1738258476 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}