	j2935560276 [label="Por que me pergunta isso? O que você está tentando descobrir, Peregrino? Certamente não está querendo saber sobre a localização de munições.",shape=box,color=blue];
		j2935560276 -> j1766173023;
	j2634606357 [label="Por quê? Planeja voltar no tempo e bater o recorde do seu eu mais novo? Precisa de conselhos sobre como derrubar um governo totalitário? Está procurando a localização de munições enterradas que poderiam destruir planetas inteiros?",shape=box,color=blue];
		j2634606357 -> j415697071;
