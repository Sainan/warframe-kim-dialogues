		j1275536292 -> j3335565695 [label=false,color=brown];
	j891819372 [label="Durante algum tempo, acreditei que éramos parceiros. Na política, nas intrigas, na cama…",shape=box,color=blue];
		j891819372 -> j2084411637;
	j2789616078 [label="Parceiros de negócios?",shape=box,color=red];
		j2789616078 -> j2584248111;
