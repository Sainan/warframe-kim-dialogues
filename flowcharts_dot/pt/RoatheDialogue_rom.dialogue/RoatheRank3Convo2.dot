		j3601973836 -> j1409161037;
	j3485997505 [label="Não muito. Mas uma coisa que você precisa entender sobre os Orokin é que estávamos sempre tramando uns contra os outros. ",shape=box,color=blue];
		j3485997505 -> j1602197464;
	j1602197464 [label="Eu sabia que Nitokh me mataria sem hesitar a qualquer momento, se isso a ajudasse, ainda que minimamente, a alcançar seus objetivos.",shape=box,color=blue];
		j1602197464 -> j3744362922;
	j2946570747 [label="Acho que ela gostava do desafio, Usurpador. Da sensação de perigo. Da emoção de saber que estava dormindo com alguém que desejava sua morte.",shape=box,color=blue];
		j2946570747 -> j1366691407;
	j1302743277 [label="Adoraria fingir que fomos os primeiros Orokin a nos encontrarmos em tal situação, mas nem isso era incomum.",shape=box,color=blue];
		j1302743277 -> j1366691407;
	j2877400824 [label="Exatamente! É quase como se você já tivesse ouvido isso antes. Mas não é nenhuma surpresa. Ela me provocava com essa ideia regularmente.",shape=box,color=blue];
		j2877400824 -> j4169374423;
		j2877400824 -> j808979521;
	j3335565695 [label="Exatamente! Mas não é nenhuma surpresa. Ela também já sabia disso e me provocava com frequência.",shape=box,color=blue];
		j3335565695 -> j4169374423;
		j3335565695 -> j808979521;
	j2084411637 [label="Obviamente, eu não nos considerava iguais. Ela era a Executora. A Grande Nitokh. Mas eu me considerava como o primeiro entre seus subordinados.",shape=box,color=blue];
		j2084411637 -> j2202922580;
	j2584248111 [label="Você é adorável. Sim, de alguma forma, éramos parceiros de negócios. Mas também éramos parceiros em outros sentidos mais importantes.",shape=box,color=blue];
		j2584248111 -> j1409161037;
	j1409161037 [label="Na guerra. Na política. Nas intrigas. Na cama.",shape=box,color=blue];
		j1409161037 -> j3646027450;
	j3744362922 [label="No entanto, ela sabia que eu estava afiando minhas facas pelas costas dela e aguardando ansiosamente o momento em que eu lhe cortaria a cabeça.",shape=box,color=blue];
		j3744362922 -> j3628903668;
	j1366691407 [label="Quanto mais vivo, mais vejo que talvez não sejamos uma espécie feita para a imortalidade.",shape=box,color=blue];
		j1366691407 -> j314463335;
	j2202922580 [label="Que idiota eu fui…",shape=box,color=blue];
		j2202922580 -> j520565029;
		j2202922580 -> j3540055047;
		j2202922580 -> j4163103906;
		j2202922580 -> j1480188590;
		j2202922580 -> j3167195467;
	j3646027450 [label="Mas talvez eu esteja me lembrando errado? Será que \"parceiro\" é uma palavra forte demais para descrever o que realmente éramos? ",shape=box,color=blue];
		j3646027450 -> j1112938453;
	j3628903668 [label="Pode-se dizer que tínhamos uma relação… complicada.",shape=box,color=blue];
		j3628903668 -> j3167195467;
		j3628903668 -> j1480188590;
		j3628903668 -> j4163103906;
		j3628903668 -> j520565029;
		j3628903668 -> j3540055047;
	j314463335 [label="Mas sim. Pode-se dizer que a Nitokh e eu tínhamos uma relação… complicada.",shape=box,color=blue];
		j314463335 -> j3167195467;
		j314463335 -> j1480188590;
		j314463335 -> j4163103906;
		j314463335 -> j520565029;
		j314463335 -> j3540055047;
	j520565029 [label="Ela era importante pra você?",shape=box,color=red];
		j520565029 -> j306711443;
	j3540055047 [label="Você amava ela?",shape=box,color=red];
		j3540055047 -> j4023210953;
	j4163103906 [label="Você confiava nela?",shape=box,color=red];
		j4163103906 -> j1807585450;
	j1480188590 [label="Não se arrependa do que fez. Você fez suas escolhas. Não dá pra voltar atrás agora. Só seguir em frente",shape=box,color=red];
		j1480188590 -> j2794814938;
	j3167195467 [label="A única coisa que a gente pode fazer pra compensar os erros do passado é olhar pro futuro com lucidez",shape=box,color=red];
		j3167195467 -> j4156266155;
	j1112938453 [label="Afinal, ela era a Grande Nitokh. Uma Executora.",shape=box,color=blue];
		j1112938453 -> j2202922580;
	j306711443 [label="Pelo Void, não! Se ela tivesse saído bêbada por uma câmara de descompressão numa tarde qualquer, teria resolvido boa parte dos meus malditos problemas.",shape=box,color=blue];
		j306711443 -> j2305543401;
	j4023210953 [label="+5 Chemistry",color=orange];
		j4023210953 -> j3191190827;
	j1807585450 [label="Pelo Void, não! Nunca confie em um Orokin, Peregrino. Nem em mim. Principalmente em mim! Ame-nos, odeie-nos, adore-nos, despreze-nos — mas nunca, jamais confie em nós.",shape=box,color=blue];
		j1807585450 -> j754848681;
