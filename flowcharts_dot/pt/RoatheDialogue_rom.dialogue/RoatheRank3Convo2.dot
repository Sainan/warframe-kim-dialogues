	j1932713100 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1932713100 -> j658035845 [label=true,color=green];
		j1932713100 -> j2204245397 [label=false,color=brown];
	j166159111 [label="Se tivéssemos falhado espetacularmente, eu simplesmente teria devorado um pedaço de Lex e encerrado o assunto.",shape=box,color=blue];
		j166159111 -> j3850387797;
	j2224678113 [label="E para cada um deles, eu havia definido um resultado. E para cada um, eu sabia qual era o plano. Muitos eram semelhantes em linhas gerais, mas diferentes nos detalhes.",shape=box,color=blue];
		j2224678113 -> j739250270;
