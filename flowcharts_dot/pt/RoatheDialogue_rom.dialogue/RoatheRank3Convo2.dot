	j2553355913 [label="Você acha que é a primeira pessoa que encontro que quer \"dançar com o diabo de Tau\"? Dificilmente. Resta saber o quão genuíno é o seu interesse, ou se ele simplesmente acaba depois de uma ou duas noites satisfazendo seu desejo.",shape=box,color=blue];
		j2553355913 -> j1407151388;
