		j2794814938 -> j1500081665;
	j4156266155 [label="Add 1 to Thermostat counter",color=orange];
		j4156266155 -> j1974572876;
	j2305543401 [label="Eu a detestava completamente, e nada teria me dado mais prazer do que arrancar lenta, cuidadosa e delicadamente sua pele azul com minhas próprias mãos.",shape=box,color=blue];
		j2305543401 -> j3263078477;
		j2305543401 -> j3142217771;
	j3191190827 [label="Que pergunta mais impertinente! Creio que adoro você por tê-la feito. Sabe, acho que eu amava ela, só um pouquinho. Sinceramente, nem tinha parado para pensar nisso até agora.",shape=box,color=blue];
		j3191190827 -> j26517311;
