	j3907510991 [label="Hm, sim. Tenho a impressão de que não estou conseguindo te conquistar com meu \"charme diabólico\", não é?",shape=box,color=blue];
		j3907510991 -> j1952923055;
		j3907510991 -> j3140715820;
	j2245660375 [label="Qual é o sentido de reviver nossos atos passados, nossos fracassos e arrependimentos? Não podemos mudá-los — mesmo com o dom da viagem no tempo, tentar \"refazer\" o que já foi \"feito\" é um caminho para a loucura.",shape=box,color=blue];
		j2245660375 -> j4034691275;
	j1117333108 [label="Mas também não podemos esquecer os erros do passado, ou corremos o risco de nos tornarmos nada mais do que loucos e déspotas, criaturas beligerantes que não enxergam defeitos em si mesmas, apenas nos outros.",shape=box,color=blue];
		j1117333108 -> j3505049483;
	j333706087 [label="Você tem esse tipo de pensamento em relação a todos os seus parceiros? Ou só com ela?",shape=box,color=red];
		j333706087 -> j2793860800;
	j1358589835 [label="Não precisa pedir desculpa. Só fico chocado com o quanto você odiava seu próprio povo",shape=box,color=red];
		j1358589835 -> j3436851;
	j2764847257 [label="Apenas recomendo que você não transforme esse tipo de relacionamento em algo permanente. Ele se torna extremamente prejudicial para ambos os lados. Geralmente termina em assassinato, seja de um ou dos dois.",shape=box,color=blue];
