	j739250270 [label="Se tivéssemos falhado espetacularmente, eu simplesmente teria devorado um pedaço de Lex e encerrado o assunto.",shape=box,color=blue];
		j739250270 -> j3836310620;
	j1917073007 [label="Você me contou tudo",shape=box,color=red];
