		j1273921168 -> j333706087;
		j1273921168 -> j1358589835;
	j4060615835 [label="O fato de você acreditar que essas duas coisas são incompatíveis é absolutamente adorável. Espero que você tenha a oportunidade de vivenciar uma noite com um \"conhecido\" assim algum dia; é algo verdadeiramente mágico.",shape=box,color=blue];
		j4060615835 -> j2764847257;
	j1303664462 [label="Você precisa entender que tudo isso também estava envolto no mais profundo e avassalador ódio. Eu a detestava profundamente e nada teria me dado mais prazer do que arrancar lenta, cuidadosa e delicadamente sua pele azul com minhas próprias mãos.",shape=box,color=blue];
		j1303664462 -> j235142191;
		j1303664462 -> j3008186083;
