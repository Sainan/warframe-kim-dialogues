		j1765859326 -> j2245660375;
	j3895769361 [label="Talvez tenha razão. Viver no passado é perigoso, pois nos sobrecarregamos com arrependimento e vergonha, e nada mais. ",shape=box,color=blue];
		j3895769361 -> j1117333108;
