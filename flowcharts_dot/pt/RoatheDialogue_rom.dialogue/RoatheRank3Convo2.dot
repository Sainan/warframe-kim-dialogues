	j2874623289 [label="Você teria aceitado a morte de boa?",shape=box,color=red];
		j2874623289 -> j853727941;
	j3836310620 [label="Se o resultado fosse um sucesso mediano, o que era o cenário mais provável, uma limpeza seria necessária para garantir que todas as pontas soltas fossem \"resolvidas\". Naturalmente, eu era uma dessas pontas soltas. E eu tinha medidas para garantir que, no curto prazo, eu ainda fosse valioso demais para ser eliminado junto com os outros.",shape=box,color=blue];
		j3836310620 -> j2153201333;
