		j3140715820 -> j4137689758;
	j4034691275 [label="Não. Eu sou o que sou. Eu sou quem eu sou. Sigo o caminho que escolhi e já passou da hora de me desculpar por isso. Não vou mudar quem eu sou para agradar os outros.",shape=box,color=blue];
		j4034691275 -> j2093836609;
	j3505049483 [label="Observei essa característica em muitos dos mais desprezíveis Executores e Imperadores: uma fé cega apenas em si mesmos, sem culpa e sem defeitos. Eu os desprezava por isso e jurei que jamais compartilharia de tamanha arrogância egocêntrica.",shape=box,color=blue];
		j3505049483 -> j2093836609;
