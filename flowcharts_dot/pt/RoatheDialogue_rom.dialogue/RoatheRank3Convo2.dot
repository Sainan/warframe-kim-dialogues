	j1693723800 [label="Sinceramente, fico curioso pra saber se você se arrepende de alguma coisa. Se voltaria atrás e mudaria algo do que planejou",shape=box,color=red];
		j1693723800 -> j3981045619;
	j2276044707 [label="Fico fascinado com a ideia de como deve ter sido elaborar um plano desses. Deve ter sido uma obra-prima",shape=box,color=red];
		j2276044707 -> j3981594412;
	j382871591 [label="Na real, seria bom mesmo saber se você escondeu alguma dessas armas em um lugar que ainda é acessível",shape=box,color=red];
		j382871591 -> j3529848696;
	j707757926 [label="Eu te perdoei pelos seus atos. Só queria me lembrar por quê – por quê?! Por que você, de todas as pessoas?!",shape=box,color=blue];
		j707757926 -> j4180690272;
		j707757926 -> j2905668704;
	j1331074942 [label="Por que você, de todas as pessoas?!",shape=box,color=blue];
		j1331074942 -> j2905668704;
		j1331074942 -> j1272307031;
