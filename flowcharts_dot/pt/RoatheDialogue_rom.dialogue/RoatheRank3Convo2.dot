		j3529848696 -> j3379985206;
	j4180690272 [label="Eu sei. E sinto muito ainda",shape=box,color=red];
		j4180690272 -> j3817792237;
	j2905668704 [label="Eu tô tentando te levar a um ponto em que você entenda o porquê",shape=box,color=red];
		j2905668704 -> j664663519;
	j1272307031 [label="Ainda sinto muito por ter quebrado sua confiança, Roathe. Não era a minha intenção, pode acreditar",shape=box,color=red];
		j1272307031 -> j3412178503;
	j3066829398 [label="A única coisa de que me arrependo é nunca ter concretizado o plano. Lamento o tempo perdido.",shape=box,color=blue];
		j3066829398 -> j2230808292;
	j3210980442 [label="E que obra-prima, Usurpador.",shape=box,color=blue];
		j3210980442 -> j2230808292;
	j3379985206 [label="Prático. Mas muitos dos lugares onde \"escondi\" meus suprimentos provavelmente… desapareceram com o decorrer do tempo.",shape=box,color=blue];
		j3379985206 -> j3210947591;
	j3817792237 [label="Sim, sim. Suponho que devemos continuar com esta conversa boba, onde repetimos nossas conversas anteriores mais uma vez.",shape=box,color=blue];
		j3817792237 -> j2891991753;
	j664663519 [label="+5 Chemistry",color=orange];
		j664663519 -> j625007980;
	j3412178503 [label="Sim, você provavelmente acreditava que não haveria consequências para seus atos. Mas, independentemente disso, devemos continuar com esta conversa boba, onde repetimos nossas conversas anteriores e seguimos.",shape=box,color=blue];
		j3412178503 -> j2891991753;
	j2230808292 [label="+5 Chemistry",color=orange];
		j2230808292 -> j4010587109;
	j3210947591 [label="E muitos dos locais eram secretos até para mim. O plano era extremamente complexo. Camadas e mais camadas de profundidade.",shape=box,color=blue];
		j3210947591 -> j714160133;
	j2891991753 [label="Qual era a sua dúvida mesmo? Ah! Sim. \"Como eu planejava derrubar os Executores?\" ",shape=box,color=blue];
		j2891991753 -> j2376584152;
	j625007980 [label="Ao repetir as mesmas conversas inúteis sobre a minha motivação para assassinar pessoas que já morreram há muito tempo e viraram pó? Pelo menos é uma abordagem pragmática.",shape=box,color=blue];
		j625007980 -> j2891991753;
	j4010587109 [label="O plano era extremamente complexo. Camadas e mais camadas de profundidade. Assassinos que, caso o primeiro assassino falhasse, matariam os assassinos de outros assassinos.",shape=box,color=blue];
		j4010587109 -> j1150967750;
	j714160133 [label="Assassinos que, caso o primeiro assassino falhasse, matariam os assassinos de outros assassinos.",shape=box,color=blue];
		j714160133 -> j1150967750;
	j2376584152 [label="Por quê?",shape=box,color=blue];
		j2376584152 -> j1693723800;
		j2376584152 -> j2276044707;
		j2376584152 -> j382871591;
	j1150967750 [label="Bombas espalhadas por vários prédios, naves inteiras e até mesmo uma lua toda preparada para ser detonada com explosivos roubados. Um trilho solar pronto para sair de órbita.",shape=box,color=blue];
		j1150967750 -> j3997605415;
	j3997605415 [label="E tudo armado para parecer um \"Grande Desastre Sentient\" quando chegasse a hora. Nitokh e eu declararíamos estado de emergência no Império, assim que os Executores e Imperadores fossem… eliminados.",shape=box,color=blue];
		j3997605415 -> j1742364006;
