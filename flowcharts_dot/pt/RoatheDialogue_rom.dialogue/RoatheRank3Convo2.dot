		j2382413373 -> j3386517895;
	j2104158186 [label="Apesar de todos os nossos avanços, de todo o trabalho que fizemos para salvar a humanidade, jamais resolvemos o maior problema que nos afligia em nossos corações. A maior falha que corroía nossas almas como um câncer maligno.",shape=box,color=blue];
		j2104158186 -> j906220776;
	j2861899715 [label="Veja bem, você parece estar se esforçando para viver uma boa vida, Peregrino. Para ser uma pessoa \"boa\". Eu detestaria ver você acabar como os Orokin. Éramos definidos pelos nossos excessos.",shape=box,color=blue];
