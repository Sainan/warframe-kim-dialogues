	j3003932241 [label="Hmm, mas isso nunca será um problema para você, não é? Você está de olho em algo muito mais próximo de casa, com a Marie, em nosso pequeno \"acordo\".",shape=box,color=blue];
		j3003932241 -> j3450121901;
	j99333970 [label="Hmm, mas isso nunca será um problema para você, não é? Você está de olho em algo muito mais próximo de casa, aquele padre maluco, não é?",shape=box,color=blue];
