	j3814912440 [label="ÁUDIO: COMISSÃO",shape=box,color=blue];
		j3814912440 -> j3443118029;
	j3443118029 [label="Entre os Sete, eu era (ou assim me diziam) considerado o brinquedo e concubino de Nitokh.",shape=box,color=blue];
		j3443118029 -> j3058085474;
	j3058085474 [label="No início da guerra, fui nomeado Vice-Regente e Temível Carnus, como uma provocação, uma espécie de piada.",shape=box,color=blue];
		j3058085474 -> j2618008163;
	j2618008163 [label="Suas risadas logo se transformaram em aplausos solenes quando eu trazia notícias de uma vitória após a outra.",shape=box,color=blue];
		j2618008163 -> j2856271664;
	j2856271664 [label="O sangue de homens superiores me adornava como medalhas. Em segredo, acumulei armas para Nitokh.",shape=box,color=blue];
		j2856271664 -> j2644164752;
	j2644164752 [label="Era fácil. Eu era uma figura gloriosa demais para levantar suspeitas.",shape=box,color=blue];
		j2644164752 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}