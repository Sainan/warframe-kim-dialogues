	j2834674706 [label="ÁUDIO: ADAPTAÇÃO",shape=box,color=blue];
		j2834674706 -> j3984924143;
	j3984924143 [label="Muitos dos Sentients evoluíram entre os encontros, então nunca podíamos ter certeza de que enfrentaríamos o mesmo inimigo duas vezes. Mas outros permaneceram com a mesma forma, como se tivessem atingido um patamar elevado há muito tempo.",shape=box,color=blue];
		j3984924143 -> j2174538975;
	j2174538975 [label="Assassinos perfeitos, eles inspiravam o mesmo horror gélido que um tubarão.",shape=box,color=blue];
		j2174538975 -> j3515658119;
	j3515658119 [label="Era insano. Como eu poderia elaborar estratégias em torno do comportamento das naves Sentients, se quando minhas táticas eram aperfeiçoadas, as naves já haviam evoluído?",shape=box,color=blue];
		j3515658119 -> j3612796664;
	j3612796664 [label="E quanto tempo levaria para que essas novas naves fossem substituídas por alguma nova monstruosidade?",shape=box,color=blue];
		j3612796664 -> j1745686816;
	j1745686816 [label="Tudo o que podíamos fazer era retroceder. O progresso havia sido fatal. As antigas tradições, os caminhos consagrados pelo tempo, de honra e disciplina, mereciam o seu devido valor.",shape=box,color=blue];
		j1745686816 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}