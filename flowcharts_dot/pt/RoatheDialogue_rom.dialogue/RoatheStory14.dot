	2257 [label="ÁUDIO: ADAPTAÇÃO",shape=box,color=blue];
		2257 -> 2259;
	2260 [label="Chat ends.",color=orange];
	2259 [label="Muitos dos Sentients evoluíram entre os encontros, então nunca podíamos ter certeza de que enfrentaríamos o mesmo inimigo duas vezes. Mas outros permaneceram com a mesma forma, como se tivessem atingido um patamar elevado há muito tempo.",shape=box,color=blue];
		2259 -> 5709;
	5709 [label="Assassinos perfeitos, eles inspiravam o mesmo horror gélido que um tubarão.",shape=box,color=blue];
		5709 -> 2256;
	2256 [label="Era insano. Como eu poderia elaborar estratégias em torno do comportamento das naves Sentients, se quando minhas táticas eram aperfeiçoadas, as naves já haviam evoluído?",shape=box,color=blue];
		2256 -> 2253;
	2253 [label="E quanto tempo levaria para que essas novas naves fossem substituídas por alguma nova monstruosidade?",shape=box,color=blue];
		2253 -> 5710;
	5710 [label="Tudo o que podíamos fazer era retroceder. O progresso havia sido fatal. As antigas tradições, os caminhos consagrados pelo tempo, de honra e disciplina, mereciam o seu devido valor.",shape=box,color=blue];
		5710 -> 2255;
	2255 [label="Add 1 to HellStory",color=orange];
