		j1990388149 -> j998792998 [label=false,color=brown];
		j1990388149 -> j2565879521 [label=false,color=brown];
	j4015708349 [label="Se você acha que é pouco fazer o que eu faço, tudo bem, é a sua opinião. O que eu fiz reescreveu a história",shape=box,color=red];
		j4015708349 -> j3937446068;
	j3073338405 [label="Insignificante não, invisível. Que todos corram por aí chamando a atenção, prefiro ficar nas sombras",shape=box,color=red];
		j3073338405 -> j2397255668;
	j545733272 [label="Porque ajudar as pessoas quando elas precisam é como a gente vai sair dessa situação",shape=box,color=red];
		j545733272 -> j440027557;
	j998792998 [label="Porque tô fazendo o que precisa ser feito. Nada mais, nada menos",shape=box,color=red];
		j998792998 -> j2576528830;
	j1448468227 [label="Você disse que nunca soube o que é ser amado. Acho que você não vai entender o quão poderoso isso pode ser pra mudar o funcionamento do mundo ao seu redor",shape=box,color=red];
		j1448468227 -> j4035507570;
	j2565879521 [label="Você já se apaixonou, Roathe? Ou se importou tanto com alguém a ponto de incendiar o universo por essa pessoa?",shape=box,color=red];
		j2565879521 -> j2982517975;
	j3937446068 [label="É exatamente esse o meu ponto! Vamos lá e reescrevamos a história, então! Em vez de ficarmos aqui tentando convencer todo mundo a dar as mãos e cantar músicas!",shape=box,color=blue];
		j3937446068 -> j890275919;
		j3937446068 -> j3790218861;
		j3937446068 -> j2090449496;
	j2397255668 [label="Ah, entendi. Você prefere ser o assassino silencioso nas sombras, é? Atacar quando menos se espera? Não. Não acho. Acho que você está apenas perdendo tempo.",shape=box,color=blue];
		j2397255668 -> j3878828030;
	j440027557 [label="Hum. Fazer favores para estranhos até que eles te idolatrem como um herói local? Ou convencê-los a dar as mãos e cantar músicas? Com licença, vou ali vomitar no aquário do Fibonacci.",shape=box,color=blue];
		j440027557 -> j4066328788;
		j440027557 -> j2513548459;
	j2576528830 [label="E o que você parece estar \"fazendo\" é tentar convencer todo mundo a dar as mãos e cantar músicas entre cenas de violência descomunal. A violência em si faz sentido. O resto é nauseante. ",shape=box,color=blue];
		j2576528830 -> j4066328788;
		j2576528830 -> j2513548459;
	j4035507570 [label="Se você insiste que vamos salvar o universo dessa \"Indiferença\" dando as mãos e cantando canções, com licença, vou ali vomitar no aquário do Fibonacci.",shape=box,color=blue];
		j4035507570 -> j3321376467;
		j4035507570 -> j4066328788;
		j4035507570 -> j2513548459;
	j2982517975 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j2982517975 -> j4016771778;
	j890275919 [label="Tenha paciência. Primeiro, precisamos lidar com a Indiferença",shape=box,color=red];
		j890275919 -> j1496711536;
	j3790218861 [label="Talvez, quando tudo isso passar. Mas não agora",shape=box,color=red];
		j3790218861 -> j973644625;
	j2090449496 [label="E você acha que eu escolheria você pra fazer isso comigo? Não me faça rir",shape=box,color=red];
		j2090449496 -> j3437040656;
	j3878828030 [label="Você não sabe o que faz nem por que faz, você simplesmente faz o que lhe mandam. Mais um capanga arrogante de um Orokin arrogante. Que vergonha.",shape=box,color=blue];
		j3878828030 -> "Chat ends.";
	j4066328788 [label="Só tô dizendo que você parece estar realmente irritado com a ideia de as pessoas não serem mais infelizes. E parece estar levando isso para o lado pessoal",shape=box,color=red];
		j4066328788 -> j50425878;
	j2513548459 [label="O que eu tava tentando dizer era simplesmente que, se a \"Indiferença\" se alimenta da falta de emoções, ter elas pode ser a chave pra ganhar dela",shape=box,color=red];
		j2513548459 -> j924568095;
	j3321376467 [label="Você acha impossível alguém te amar? Ou acha que você não é capaz de sentir amor por outra pessoa? Ou acha que simplesmente ainda não aconteceu?",shape=box,color=red];
		j3321376467 -> j3547089629;
	j4016771778 [label="Não. E se você insiste que vamos salvar o universo dessa \"Indiferença\" dando as mãos e cantando canções, com licença, vou ali vomitar no aquário do Fibonacci.",shape=box,color=blue];
		j4016771778 -> j3321376467;
