		j690458213 -> j1523307919;
	j1349684181 [label="Não sei se você consegue entender isso, mas tenta: eu não QUERO governar um universo",shape=box,color=red];
		j1349684181 -> j1491059276;
	j3259883918 [label="Isso não me tornaria melhor do que o Albrecht, nem que os Orokin. Causando destruição e remodelando o mundo à minha imagem… não tenho interesse nisso",shape=box,color=red];
