	1911 [label="Porque não consigo entender de jeito nenhum por que você, uma entidade que, pelo que consigo deduzir, veio de uma versão completamente diferente da realidade, está determinada a causar estragos no tempo e no espaço, \"brincando de terapeuta\".",shape=box,color=blue];
		1911 -> 1918;
	1912 [label="Sim, e isso nos leva ao ponto principal! Por que você insiste em vagar pelo tempo e espaço \"brincando de terapeuta\"? Você, que é uma entidade que, pelo que pude apurar, veio de uma versão completamente diferente da realidade.",shape=box,color=blue];
		1912 -> 1918;
