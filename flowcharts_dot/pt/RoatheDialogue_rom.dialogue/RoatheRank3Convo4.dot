		j4016771778 -> j2513548459;
	j1496711536 [label="+5 Chemistry",color=orange];
		j1496711536 -> j973644625;
	j973644625 [label="Ótimo. Ótimo! Vou esperar o momento certo, como você diz. Vamos jogar esses… jogos tolos.",shape=box,color=blue];
		j973644625 -> j348989677;
	j3437040656 [label="Boolean RoatheInsulted is now true.",color=orange];
		j3437040656 -> j4017155524;
	j50425878 [label="Porque a infelicidade gosta de companhia? Talvez. Ou simplesmente porque estou confuso com o fato de você estar por aí perdendo tempo quando há trabalho de verdade que poderíamos estar fazendo.",shape=box,color=blue];
		j50425878 -> j2562356127;
	j924568095 [label="Mais uma prova de que isso é fruto da sua imaginação! Que tipo de deus ou \"anti-deus\" seria derrotado pela \"bondade das emoções humanas\"? Ha! ",shape=box,color=blue];
		j924568095 -> j4287522236;
	j3547089629 [label="Boolean RoatheUnloved2 is now true.",color=orange];
		j3547089629 -> j3327608456;
	j348989677 [label="Suponho que ainda temos trabalho a fazer, como você disse. Simplesmente não consigo conceber que coisas tão… infantis possam ter um propósito. Mas, por outro lado, aqui estou eu, do outro lado da moeda, e você é quem detém as chaves do universo.",shape=box,color=blue];
		j348989677 -> j402831916;
	j4017155524 [label="Faz sentido. Por que alguém escolheria uma pessoa tão detestável quanto o Diabo de Tau?",shape=box,color=blue];
