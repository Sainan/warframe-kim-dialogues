		j1871254309 -> j1349684181;
		j1871254309 -> j3259883918;
	j212129120 [label="Sou feliz com o que faço. Tô ajudando as pessoas da maneira que gosto",shape=box,color=red];
		j212129120 -> j1523307919;
	j1827488970 [label="Não sei se você consegue entender isso, mas tenta: eu não QUERO governar um universo",shape=box,color=red];
		j1827488970 -> j302591755;
	j2899424918 [label="Isso não me tornaria melhor do que o Albrecht, nem que os Orokin. Causando destruição e remodelando o mundo à minha imagem… não tenho interesse nisso",shape=box,color=red];
		j2899424918 -> j302591755;
