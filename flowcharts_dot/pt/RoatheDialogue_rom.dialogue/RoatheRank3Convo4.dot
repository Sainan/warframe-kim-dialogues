	"RoatheRank3Convo4 begins." [color=orange];
		"RoatheRank3Convo4 begins." -> j3502124864;
	j3502124864 [label="Pode responder a uma pergunta para mim, Usurpador? Ela tem me incomodado há algum tempo.",shape=box,color=blue];
		j3502124864 -> j534141237;
		j3502124864 -> j171208317;
		j3502124864 -> j17348121;
	j534141237 [label="Pode perguntar",shape=box,color=red];
		j534141237 -> j1529089833;
	j171208317 [label="O que poderia estar te incomodando?",shape=box,color=red];
		j171208317 -> j1581209073;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j1529089833 [label="Por que você está fazendo isso?",shape=box,color=blue];
		j1529089833 -> j3524964328;
	j1581209073 [label="Eu poderia enumerar todos os itens, mas receio que ficaríamos aqui a tarde toda. Não, minhas perguntas a esse respeito se concentram em um tópico específico. Pelo menos hoje.",shape=box,color=blue];
		j1581209073 -> j1529089833;
	"Chat ends." [color=orange];
	j3524964328 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3524964328 -> j869794575 [label=true,color=green];
		j3524964328 -> j2768280751 [label=false,color=brown];
	j869794575 [label="E não estou falando de você mexendo com as minhas memórias. Quero dizer \"tudo isso\" num sentido mais amplo.",shape=box,color=blue];
		j869794575 -> j2768280751;
	j2768280751 [label="Check boolean LoidFamilyComplete",color=orange];
		j2768280751 -> j401701358 [label=true,color=green];
		j2768280751 -> j147970047 [label=false,color=brown];
	j401701358 [label="Você parece estar determinado a correr por este universo atrás do Albrecht com um balde e um esfregão na mão. Veja só o seu trabalho com o mordomo dele. ",shape=box,color=blue];
		j401701358 -> j2476974658;
	j147970047 [label="Você parece estar determinado a correr por este universo atrás do Albrecht com um balde e um esfregão na mão.",shape=box,color=blue];
		j147970047 -> j2476974658;
	j2476974658 [label="Check boolean IsDating",color=orange];
		j2476974658 -> j2161956855 [label=true,color=green];
		j2476974658 -> j1317065988 [label=false,color=brown];
	j2161956855 [label="Parece que você tem suas próprias vontades para satisfazer nesse meio tempo — e eu te aplaudo por isso, não estou te julgando. Só me parece estranho que alguém tão… maravilhosamente e descontroladamente desastrado seja tão obediente. ",shape=box,color=blue];
		j2161956855 -> j3591243853;
		j2161956855 -> j1212468344;
		j2161956855 -> j2676126863;
	j1317065988 [label="Acho estranho que alguém tão… maravilhosamente e descontroladamente desastrado seja tão obediente em outros aspectos. ",shape=box,color=blue];
		j1317065988 -> j3591243853;
		j1317065988 -> j1212468344;
		j1317065988 -> j2676126863;
	j3591243853 [label="Deixar a Indiferença destruir o Sistema de Origem, ou qualquer outro lugar, não ajuda ninguém",shape=box,color=red];
		j3591243853 -> j335584498;
	j1212468344 [label="Eu não obedeço o Entrati",shape=box,color=red];
		j1212468344 -> j104682077;
	j2676126863 [label="Tenho meus próprios motivos, e são só da minha conta",shape=box,color=red];
		j2676126863 -> j683835017;
	j335584498 [label="Ah, entendi. Trata-se simplesmente de um serviço temporário que você está oferecendo até que a situação com a \"Indiferença\" seja resolvida. E o que você pretende fazer depois disso?",shape=box,color=blue];
		j335584498 -> j298977714;
		j335584498 -> j730228380;
		j335584498 -> j3041620315;
		j335584498 -> j3709147411;
		j335584498 -> j2829074843;
	j104682077 [label="Sério? Parece que sim, do meu ponto de vista. Ele estala os dedos e você se ajoelha e senta aos seus tornozelos como um Kubrow treinado. Ele até sussurra o nome \"Tau\" e vocês se apressam para se lembrar de cada detalhe possível do lugar que perderam.",shape=box,color=blue];
		j104682077 -> j2316329367;
		j104682077 -> j2962567914;
	j683835017 [label="Tão misterioso, tão enigmático! E uma bela pilha de estrume ambulante. Se você simplesmente não quer admitir que está à mercê dele, que assim seja.",shape=box,color=blue];
		j683835017 -> j605165889;
	j298977714 [label="Por que você tá implicando com isso? O que você realmente tá querendo saber?",shape=box,color=red];
		j298977714 -> j1727693115;
	j730228380 [label="Pra ser sincero, não pensei muito nisso",shape=box,color=red];
		j730228380 -> j3816418557;
	j3041620315 [label="Pretendo fazer ele pagar por toda essa confusão, e a conta dele já tá cara",shape=box,color=red];
		j3041620315 -> j85586403;
	j3709147411 [label="Assumindo que eu sobreviva, né?",shape=box,color=red];
		j3709147411 -> j1648599255;
	j2829074843 [label="Vou aonde precisam de mim, como sempre. Os problemas normalmente me acham primeiro",shape=box,color=red];
		j2829074843 -> j1496706125;
	j2316329367 [label="Por que você tá se esforçando tanto pra me irritar?",shape=box,color=red];
		j2316329367 -> j3830966439;
	j2962567914 [label="Só faço o que é preciso pra ajudar as pessoas a saírem das situações miseráveis em que se encontram",shape=box,color=red];
		j2962567914 -> j2122095015;
	j605165889 [label="Pois, do meu ponto de vista, ele estala os dedos e você se ajoelha e senta aos seus tornozelos como um Kubrow treinado. Ele até sussurra o nome \"Tau\" e vocês se apressam para se lembrar de cada detalhe possível do lugar que perderam.",shape=box,color=blue];
		j605165889 -> j2316329367;
		j605165889 -> j2962567914;
	j1727693115 [label="+5 Chemistry",color=orange];
		j1727693115 -> j3664277400;
	j3816418557 [label="Ah! Então você admite que é um idiota! Que refrescante. Adoro quando os tolos expõem sua falta de inteligência sem pudor, isso facilita muito minha tarefa de manipulá-los.",shape=box,color=blue];
		j3816418557 -> j3334720202;
	j85586403 [label="Ah! Então é vingança primitiva e visceral que você busca! Glorioso. Um animal raivoso, pronto para roer os ossos daqueles que lhe fizeram mal.",shape=box,color=blue];
		j85586403 -> j3924120340;
	j1648599255 [label="+5 Chemistry",color=orange];
		j1648599255 -> j3603362751;
	j1496706125 [label="Ah, entendi. Apatia disfarçada de nobreza. Você não sabe a que lugar pertence, onde deveria ficar, então se envolve nessa fachada de \"sacrifício pela justiça\" e faz o que os outros mandam?",shape=box,color=blue];
		j1496706125 -> j481895396;
	j3830966439 [label="Porque não consigo entender de jeito nenhum por que você, uma entidade que, pelo que consigo deduzir, veio de uma versão completamente diferente da realidade, está determinada a causar estragos no tempo e no espaço, \"brincando de terapeuta\".",shape=box,color=blue];
		j3830966439 -> j764155193;
	j2122095015 [label="Sim, e isso nos leva ao ponto principal! Por que você insiste em vagar pelo tempo e espaço \"brincando de terapeuta\"? Você, que é uma entidade que, pelo que pude apurar, veio de uma versão completamente diferente da realidade.",shape=box,color=blue];
		j2122095015 -> j764155193;
	j3664277400 [label="Perspicaz. Sim, muito bem, vou direto ao ponto da minha pergunta. Eu estava tentando te provocar para ver se isso geraria uma resposta mais honesta.",shape=box,color=blue];
		j3664277400 -> j1344456548;
	j3334720202 [label="Você é como um Kubrow que finalmente capturou um Kaithe. Agora que seus dentes estão cravados na perna dele, você não sabe o que fazer.",shape=box,color=blue];
		j3334720202 -> j2962567914;
		j3334720202 -> j2316329367;
	j3924120340 [label="Uma das motivações humanas mais simples e antigas. E, portanto, uma das mais fáceis de entender.",shape=box,color=blue];
		j3924120340 -> j2962567914;
	j3603362751 [label="Embora eu nunca tenha sido oficialmente um soldado, em seu tom de voz percebo o cansaço do mais experiente em combate de todos.",shape=box,color=blue];
		j3603362751 -> j4160707128;
	j481895396 [label="Que tragédia.",shape=box,color=blue];
		j481895396 -> j1054929986;
		j481895396 -> j2920873489;
	j764155193 [label="Se eu fosse você, estaria de volta em Duviri tentando descobrir que outras brechas no tecido do Void eu poderia abrir! Imagine as possibilidades! Imagine os mundos, prontos para serem conquistados!",shape=box,color=blue];
		j764155193 -> j2949100126;
		j764155193 -> j3777515796;
	j1344456548 [label="Mas acho que isso terá que servir.",shape=box,color=blue];
		j1344456548 -> j4173818323;
	j4160707128 [label="Muito bem. De um para o outro, por respeito, irei direto ao ponto da minha pergunta. Eu estava tentando provocá-lo para ver se isso geraria uma resposta mais honesta.",shape=box,color=blue];
		j4160707128 -> j4173818323;
	j1054929986 [label="Tenho um lugar ao qual pertenço",shape=box,color=red];
		j1054929986 -> j2552169790;
	j2920873489 [label="Você não sabe do que tá falando",shape=box,color=red];
		j2920873489 -> j71035434;
	j2949100126 [label="Você é igualzinho ao Albrecht. Ele tá viajando no tempo, causando todos esses problemas, e tu quer fazer isso com dimensões inteiras?!",shape=box,color=red];
		j2949100126 -> j1550559828;
	j3777515796 [label="Esse é o problema de vocês, Orokin. Acham que mundos inteiros são seus parquinhos, pra fazer o que bem entender",shape=box,color=red];
		j3777515796 -> j592885050;
	j4173818323 [label="+5 Chemistry",color=orange];
		j4173818323 -> j988938355;
	j2552169790 [label="É mesmo?! É essa tal de Holvânia? Ou talvez Duviri? Ou talvez sua Orbital encalhada no que restou da Terra?",shape=box,color=blue];
		j2552169790 -> j2962567914;
		j2552169790 -> j2316329367;
	j71035434 [label="Então, me fala aonde que fica essa sua casa! É essa tal de Holvânia? Ou talvez Duviri? Ou talvez sua Orbital encalhada no que restou da Terra?",shape=box,color=blue];
		j71035434 -> j2962567914;
		j71035434 -> j2316329367;
	j1550559828 [label="E por que não deveríamos? Somos criações superiores, não somos? Albrecht faz o que bem entende, e você não tem problema nenhum em limpar a bagunça que ele faz! Por que eu não teria o direito de fazer o mesmo? O que torna a busca dele \"justificada\" e a minha não?",shape=box,color=blue];
		j1550559828 -> j3738521514;
	j592885050 [label="E por que não deveríamos? Somos criações superiores, não somos? Albrecht está fazendo o que bem entende, devastando o tempo, infectando as massas com uma doença que mal compreende, tudo em nome de \"derrotar um suposto deus\".",shape=box,color=blue];
		j592885050 -> j3738521514;
	j988938355 [label="Não consigo entender de jeito nenhum por que você, uma entidade que, pelo que consigo deduzir, veio de uma versão completamente diferente da realidade, está determinada a causar estragos no tempo e no espaço, \"brincando de terapeuta\".",shape=box,color=blue];
