	"Chat ends." [color=orange];
	j977751627 [label="ÁUDIO: SUBMISSÃO",shape=box,color=blue];
		j977751627 -> j2085747101;
	j2085747101 [label="Desde o início, compreendi. Tanto no campo de batalha quanto em momentos de descanso, vi que o caminho para a vitória seria através da aparente submissão.",shape=box,color=blue];
		j2085747101 -> j1222142596;
	j1222142596 [label="Onde o inimigo o encontra cedendo, pode ter certeza de que, ali, ele o pressionará. Assim, você pode facilmente derrubá-lo.",shape=box,color=blue];
		j1222142596 -> j201847175;
	j201847175 [label="\"Lacaio\", me chamavam. \"Cãozinho de Colo\". Nitokh se achava no controle. Como eu a guiava sutilmente. ",shape=box,color=blue];
		j201847175 -> j4206300764;
	j4206300764 [label="Roathe, o de mãos ensanguentadas. Roathe, o ogro que se fartava com os corpos de seus homens. Esbanjador de vidas.",shape=box,color=blue];
		j4206300764 -> j2502556874;
	j2502556874 [label="Como se eu lutasse somente pela luta em si! Não, o Império Orokin deve acabar.",shape=box,color=blue];
		j2502556874 -> j1439507123;
	j1439507123 [label="Para isso acontecer, a guerra deve continuar. Somente a derrota, absoluta e irrevogável, derrubaria aquelas sete gárgulas douradas.",shape=box,color=blue];
		j1439507123 -> j3506673944;
	j3506673944 [label="Nem mesmo Nitokh conhecia meu verdadeiro coração. Ela pensava que eu aspirava a governar ao seu lado.",shape=box,color=blue];
		j3506673944 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}