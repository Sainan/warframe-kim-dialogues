	2315 [label="Chat ends.",color=orange];
	2311 [label="Desde o início, compreendi. Tanto no campo de batalha quanto em momentos de descanso, vi que o caminho para a vitória seria através da aparente submissão.",shape=box,color=blue];
		2311 -> 5722;
	5722 [label="Onde o inimigo o encontra cedendo, pode ter certeza de que, ali, ele o pressionará. Assim, você pode facilmente derrubá-lo.",shape=box,color=blue];
		5722 -> 5723;
	5723 [label="\"Lacaio\", me chamavam. \"Cãozinho de Colo\". Nitokh se achava no controle. Como eu a guiava sutilmente. ",shape=box,color=blue];
		5723 -> 2310;
	2310 [label="Roathe, o de mãos ensanguentadas. Roathe, o ogro que se fartava com os corpos de seus homens. Esbanjador de vidas.",shape=box,color=blue];
		2310 -> 2314;
	2314 [label="Como se eu lutasse somente pela luta em si! Não, o Império Orokin deve acabar.",shape=box,color=blue];
		2314 -> 5724;
	5724 [label="Para isso acontecer, a guerra deve continuar. Somente a derrota, absoluta e irrevogável, derrubaria aquelas sete gárgulas douradas.",shape=box,color=blue];
		5724 -> 2316;
	2316 [label="Nem mesmo Nitokh conhecia meu verdadeiro coração. Ela pensava que eu aspirava a governar ao seu lado.",shape=box,color=blue];
		2316 -> 2309;
	2309 [label="Add 1 to HellStory",color=orange];
