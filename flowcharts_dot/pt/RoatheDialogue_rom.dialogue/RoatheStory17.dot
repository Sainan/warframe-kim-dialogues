	"Chat ends." [color=orange];
	j3677839418 [label="ÁUDIO: WARFRAMES",shape=box,color=blue];
		j3677839418 -> j2837431453;
	j2837431453 [label="A princípio, os Warframes pareciam mais uma expressão artística do que uma arma legítima.",shape=box,color=blue];
		j2837431453 -> j3212572141;
	j3212572141 [label="A guerra estava praticamente perdida, os Sentients eram invencíveis. Então, vamos criar esses guerreiros estranhos e surreais e armá-los com armas da linhagem ancestral.",shape=box,color=blue];
		j3212572141 -> j183899443;
	j183899443 [label="Ao menos, nossa derrota será bela e memorável.",shape=box,color=blue];
		j183899443 -> j3713651319;
	j3713651319 [label="Mas, contrariando todas as expectativas, eles prevaleceram. Logo, histórias de heroísmo inacreditável começaram a chegar das linhas de frente.",shape=box,color=blue];
		j3713651319 -> j801593976;
	j801593976 [label="Warframes surgiram do céu, angelicais, libertando cativos e devastando fortalezas Sentients. Mesmo sozinhos, eram milagres. Em grupo, eram deuses.",shape=box,color=blue];
		j801593976 -> j3470515064;
	j3470515064 [label="Não é de se admirar, portanto, que fossem vistos como mera propaganda.",shape=box,color=blue];
		j3470515064 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}