	2286 [label="A princípio, os Warframes pareciam mais uma expressão artística do que uma arma legítima.",shape=box,color=blue];
		2286 -> 2285;
	2285 [label="A guerra estava praticamente perdida, os Sentients eram invencíveis. Então, vamos criar esses guerreiros estranhos e surreais e armá-los com armas da linhagem ancestral.",shape=box,color=blue];
		2285 -> 2282;
	2282 [label="Ao menos, nossa derrota será bela e memorável.",shape=box,color=blue];
		2282 -> 2283;
	2283 [label="Mas, contrariando todas as expectativas, eles prevaleceram. Logo, histórias de heroísmo inacreditável começaram a chegar das linhas de frente.",shape=box,color=blue];
		2283 -> 5715;
	5715 [label="Warframes surgiram do céu, angelicais, libertando cativos e devastando fortalezas Sentients. Mesmo sozinhos, eram milagres. Em grupo, eram deuses.",shape=box,color=blue];
		5715 -> 5716;
	5716 [label="Não é de se admirar, portanto, que fossem vistos como mera propaganda.",shape=box,color=blue];
