digraph {
	1042 [label="RoatheRank2Convo3 begins.",color=orange];
		1042 -> 1043;
	1043 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1043 -> 1044 [label=true,color=green];
		1043 -> 1045 [label=false,color=brown];
	1044 [label="Check boolean RoatheKnowsReset2",color=orange];
		1044 -> 1046 [label=true,color=green];
		1044 -> 1047 [label=false,color=brown];
	1045 [label="Chat ends.",color=orange];
	1046 [label="Sei que você já deve ter ouvido isso antes, e hoje em dia não me importo mais - não tenho paciência.",shape=box,color=blue];
		1046 -> 1047;
	1047 [label="Acredito que o que causou a queda do Império Orokin foi o excesso de camadas de vidro.",shape=box,color=blue];
		1047 -> 1048;
		1047 -> 1049;
		1047 -> 1050;
	1048 [label="Como assim?",shape=box,color=red];
		1048 -> 1051;
	1049 [label="Muito impessoal?",shape=box,color=red];
		1049 -> 1052;
	1050 [label="[Encerrar Conversa]",shape=box,color=red];
		1050 -> 1053;
	1051 [label="Imagine uma sociedade fundada na certeza de que você está, para todos os efeitos, sempre seguro. Protegido. Até mesmo do grande espectro da morte.",shape=box,color=blue];
		1051 -> 1054;
	1052 [label="+5 Chemistry",color=orange];
		1052 -> 1055;
	1053 [label="Chat ends.",color=orange];
	1054 [label="Onde nada pode te fazer mal.",shape=box,color=blue];
		1054 -> 1056;
	1055 [label="Exatamente. Muito descolados do perigo e da realidade das coisas.",shape=box,color=blue];
		1055 -> 1051;
	1056 [label="Isso gera uma espécie de tédio que, por sua vez, começa a gerar seu próprio perigo, Ursupador. A Política. As intrigas da corte. Assim, inventamos novas e engenhosas maneiras de nos colocarmos em perigo, já que havíamos substituído as antigas.",shape=box,color=blue];
		1056 -> 1057;
		1056 -> 1058;
	1057 [label="Por que tá me dizendo isso agora?",shape=box,color=red];
		1057 -> 1059;
	1058 [label="O que é pior? Levar um tiro ou ter que ficar sempre em alerta?",shape=box,color=red];
		1058 -> 1060;
	1059 [label="Pouquíssimas partes foram interessantes ou agradáveis na minha… estadia forçada em \"Gaule\". A comida, sendo uma delas. A segunda… foram as tempestades.",shape=box,color=blue];
		1059 -> 1061;
	1060 [label="Ah! Eu realmente não tenho uma preferência, domino ambas as áreas, receio. E você, qual é a sua preferência?",shape=box,color=blue];
		1060 -> 1062;
		1060 -> 1063;
	1061 [label="Tempestades como nunca havia presenciado em todos os meus anos como Orokin. Elas tremiam a própria terra, faziam as janelas de madeira vibrarem. Eu podia ouvi-las até mesmo na cripta empoeirada onde nos mantinham.",shape=box,color=blue];
		1061 -> 1064;
	1062 [label="Gosto de saber quem são meus inimigos, simples assim. Que venham pra cima com tudo",shape=box,color=red];
		1062 -> 1065;
	1063 [label="Levar um tiro. Prefiro ter controle da situação pra que o trabalho seja feito. Posso ir no meu tempo",shape=box,color=red];
		1063 -> 1066;
	1064 [label="Quando invadiam a cidade, eu subia até o campanário para ficar o mais perto possível. Eu queria sentir a eletricidade no ar, a chuva torrencial na minha pele.",shape=box,color=blue];
		1064 -> 1067;
		1064 -> 1068;
		1064 -> 1069;
	1065 [label="Add 1 to Thermostat",color=orange];
		1065 -> 1070;
	1066 [label="Add -1 to Thermostat",color=orange];
		1066 -> 1071;
	1067 [label="Isso não era perigoso?",shape=box,color=red];
		1067 -> 1072;
	1068 [label="Isso parece incrível ",shape=box,color=red];
		1068 -> 1073;
	1069 [label="O que a Marie e o Lyon achavam de você sair escondido?",shape=box,color=red];
		1069 -> 1074;
	1070 [label="Compreendo seu ponto de vista e admito que há uma certa simplicidade nisso. É difícil confundir um inimigo com qualquer outra coisa quando ele está apontando uma arma para você.",shape=box,color=blue];
		1070 -> 1075;
	1071 [label="Hum, que delícia, não é? Um plano meticuloso e cuidadosamente elaborado que dá certo? Ver todas as peças se encaixando… pura diversão.",shape=box,color=blue];
		1071 -> 1075;
	1072 [label="Esse era exatamente o objetivo da empreitada! Não consigo descrever a sensação de um poder tão bruto. Não, era mais do que isso; era poder real. Olhei para aquelas nuvens escuras e rodopiantes, iluminadas por relâmpagos furiosos, e compreendi o que meus ancestrais tanto buscaram dominar.",shape=box,color=blue];
		1072 -> 1076;
	1073 [label="+5 Chemistry",color=orange];
		1073 -> 1077;
	1074 [label="Você escreve isso como se eu tivesse dado a mínima importância a eles. Eles não me seguiram, se é isso que você quer saber. O padre não se importaria se eu fosse atingido por um raio, tenho certeza. E a Marie? Ela provavelmente estava ocupada demais adorando seus falsos deuses. Sol ou Albrecht, pode escolher.",shape=box,color=blue];
		1074 -> 1078;
	1075 [label="+5 Chemistry",color=orange];
		1075 -> 1079;
	1076 [label="Além disso, eu sabia que minha presença ali poderia me matar e que não havia Kuva para me reviver. Ademais, eu sabia que a Kuva sagrada não teria efeito algum em meu corpo desfigurado e mutilado. ",shape=box,color=blue];
		1076 -> 1080;
	1077 [label="Muito! Não consigo descrever a sensação de um poder tão bruto. Não, era mais do que isso; era poder real. Olhei para aquelas nuvens escuras e rodopiantes, iluminadas por relâmpagos furiosos, e compreendi o que meus ancestrais tanto buscaram dominar.",shape=box,color=blue];
		1077 -> 1076;
	1078 [label="Mas sentir um poder tão bruto? Não, era mais do que isso; era poder real. Olhei para aquelas nuvens escuras e rodopiantes, iluminadas por relâmpagos furiosos, e compreendi o que meus ancestrais tanto buscaram dominar.",shape=box,color=blue];
		1078 -> 1076;
	1079 [label="No entanto, como em tudo na vida, acredito que a moderação e o equilíbrio entre ambos são a chave para o sucesso. Exagerar em um significa correr o risco de abandonar o outro.",shape=box,color=blue];
		1079 -> 1081;
	1080 [label="Isso era apavorante. Tive medo, Peregrino. Medo. Pela primeira vez em… séculos, talvez?",shape=box,color=blue];
		1080 -> 1082;
		1080 -> 1083;
	1081 [label="É assim que criaturas como Ballas e Nitokh foram criadas, acredito. O Manipulador e a Rainha de Sangue. Bah.",shape=box,color=blue];
		1081 -> 1084;
	1082 [label="Você tem medo de morrer?",shape=box,color=red];
		1082 -> 1085;
	1083 [label="E aí, o que você fez depois?",shape=box,color=red];
		1083 -> 1086;
	1084 [label="Mas vim aqui para falar sobre tempestades.",shape=box,color=blue];
		1084 -> 1059;
	1085 [label="Sim, pelo visto! E com bastante clareza, devo acrescentar. E isso foi uma descoberta para mim naquele momento. Não tenho medo do que acontece após a morte, Peregrino. Simplesmente não desejo que minha vida termine. Ainda não terminei de vivê-la.",shape=box,color=blue];
		1085 -> 1087;
	1086 [label="Subi no balaústre de pedra ao lado da gárgula, abri os braços bem abertos e… ri. Ri na cara da tempestade.",shape=box,color=blue];
		1086 -> 1088;
	1087 [label="O que, por si só, foi uma revelação. Subi no balaústre de pedra ao lado da gárgula, abri os braços bem abertos e… ri. Ri na cara da tempestade.",shape=box,color=blue];
		1087 -> 1089;
	1088 [label="Pois de repente percebi que não tenho medo do que acontece após a morte, Peregrino. Simplesmente não desejo que minha vida termine. Ainda não terminei de vivê-la.",shape=box,color=blue];
		1088 -> 1089;
	1089 [label="Apesar de tudo. Apesar da desolação de Tau. Apesar da destruição do Império Orokin que eu sabia ser inevitável. Apesar da transformação do meu corpo nessa… coisa. Apesar de ter sido jogado no passado e abandonado à própria sorte.",shape=box,color=blue];
		1089 -> 1090;
	1090 [label="Eu sabia que encontraria um jeito de voltar para cá. Para este tempo. Para este lugar. Para onde Albrecht havia deixado todos os seus bens mais preciosos.",shape=box,color=blue];
		1090 -> 1091;
	1091 [label="+5 Chemistry",color=orange];
		1091 -> 1092;
	1092 [label="Porque eu ainda não terminei de viver a minha vida. Mas, pelo Void, vou garantir que ele termine de viver a dele.",shape=box,color=blue];
		1092 -> 1093;
	1093 [label="Update boolean RoatheEntrati1",color=orange];
		1093 -> 1094;
	1094 [label="Chat ends.",color=orange];
}