digraph {
	2664 [label="RoatheRank4Convo5 begins.",color=orange];
		2664 -> 2665;
	2665 [label="O quanto você se lembra dos seus dias no Império, Usurpador? Parece fragmentado, na melhor das hipóteses. Não que eu seja alguém que deva julgar, claro.",shape=box,color=blue];
		2665 -> 2668;
