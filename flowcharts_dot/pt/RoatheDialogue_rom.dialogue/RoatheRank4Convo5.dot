	2677 [label="Isso vai acabar se tornando alguma forma terrível de… tortura Orokin?",shape=box,color=red];
		2677 -> 2680;
	2678 [label="Acho que seria difícil esquecer dessa palavra… se eu já tivesse ouvido ela antes",shape=box,color=red];
