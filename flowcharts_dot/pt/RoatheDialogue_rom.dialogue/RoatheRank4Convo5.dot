		2689 -> 2694;
	2695 [label="Nem todos tiveram a sorte de receber carne nova a cada vez que sua forma antiga se consumia. Mas tenho certeza de que você considera o Teatro Yuvan uma prática repugnante, não é?",shape=box,color=blue];
		2695 -> 2699;
		2695 -> 2700;
	2696 [label="Nem todos tiveram a sorte de receber carne nova cada vez que seu corpo antigo se consumia. Claramente, você considera o Teatro Yuvan uma prática repugnante.",shape=box,color=blue];
		2696 -> 2701;
		2696 -> 2700;
	2694 [label="Nem todos tiveram a sorte de receber carne nova a cada vez que sua forma antiga se consumia. Mas tenho certeza de que você considera o Teatro Yuvan uma prática repugnante, não é?",shape=box,color=blue];
		2694 -> 2697;
		2694 -> 2698;
	2699 [label="Não conheço o suficiente pra opinar",shape=box,color=red];
		2699 -> 2704;
	2700 [label="Sim. Acho repugnante o que vocês fizeram. Tudo o que foi escrito sobre o Teatro Yuvan diz que vocês sequestraram crianças e destruíram suas mentes",shape=box,color=red];
		2700 -> 2705;
	2701 [label="Como eu poderia pensar o oposto? Vocês sequestraram crianças de seus lares e apagaram suas mentes pra substituir pelas suas próprias!",shape=box,color=red];
		2701 -> 2706;
	2697 [label="Não conheço o suficiente pra opinar",shape=box,color=red];
		2697 -> 2702;
	2698 [label="Sim. Acho repugnante o que vocês fizeram. Tudo o que foi escrito sobre o Teatro Yuvan diz que vocês sequestraram crianças e destruíram suas mentes",shape=box,color=red];
		2698 -> 2703;
	2704 [label="+5 Chemistry",color=orange];
		2704 -> 2709;
	2705 [label="\"Tudo o que foi escrito sobre o Teatro Yuvan diz isso.\" Onde estão registrados todos esses registros? Mais importante ainda, quem escreveu tudo isso?",shape=box,color=blue];
		2705 -> 2708;
	2706 [label="E como você sabe de tudo isso? Você mesmo presenciou uma apresentação no Teatro Yuvan?",shape=box,color=blue];
		2706 -> 2710;
		2706 -> 2711;
		2706 -> 2712;
	2702 [label="+5 Chemistry",color=orange];
		2702 -> 2707;
	2703 [label="No entanto, você acabou de dizer que restam apenas fragmentos da nossa história e registros culturais. E onde estão todos esses registros? Mais importante ainda, quem escreveu tudo isso?",shape=box,color=blue];
		2703 -> 2708;
	2709 [label="Adiar o julgamento até ter todas as informações? Nossa, Usurpador! Você parece inteligente! Que raridade!",shape=box,color=blue];
		2709 -> 2713;
	2708 [label="São histórias contadas por aqueles que têm um interesse particular em retratar todos os aspectos dos Orokin sob uma luz o mais desastrosa e maligna possível.",shape=box,color=blue];
		2708 -> 2714;
	2710 [label="Não ",shape=box,color=red];
		2710 -> 2715;
	2711 [label="Sim ",shape=box,color=red];
		2711 -> 2716;
	2712 [label="Não importa, é tudo bem claro",shape=box,color=red];
		2712 -> 2717;
	2707 [label="Adiar o julgamento até ter todas as informações? Nossa, Usurpador! Você parece inteligente! Que raridade!",shape=box,color=blue];
		2707 -> 2713;
	2713 [label="Permita-me, então, mudar a perspectiva da história para você, se me permite. Considere a origem dos relatos sobre o Teatro Yuvan que você pode ter ouvido.",shape=box,color=blue];
		2713 -> 2708;
	2714 [label="Aqueles que destroem todas as estruturas de suporte da própria sociedade do Sistema de Origem e a mergulham no caos absoluto devem dar aos que dependem dessa sociedade uma boa razão para fazê-lo.",shape=box,color=blue];
		2714 -> 2718;
	2715 [label="Então você está se baseando em relatos de segunda mão. Considere onde esses relatos foram escritos. Mais importante ainda, considere quem os escreveu.",shape=box,color=blue];
		2715 -> 2708;
	2716 [label="Há! Mentiroso. ",shape=box,color=blue];
		2716 -> 2719;
	2717 [label="Será mesmo? Considere onde esses relatos foram escritos. Mais importante ainda, considere quem escreveu todos esses relatos.",shape=box,color=blue];
		2717 -> 2708;
	2718 [label="Imagine a vida de um humano comum em um posto de retransmissão, Usurpador. Alguém distante das provações e tribulações dos Tennos. Alguém que não se importava com a Grande Guerra.",shape=box,color=blue];
		2718 -> 2720;
	2719 [label="Você está se baseando em relatos de segunda mão. Considere onde esses relatos foram escritos. Mais importante ainda, considere quem os escreveu.",shape=box,color=blue];
		2719 -> 2708;
	2720 [label="Quando os Orokin caíram, suas vidas foram mergulhadas em um verdadeiro inferno no vácuo de poder que se seguiu. Explicações tiveram que ser inventadas. Efígies tiveram que ser feitas e queimadas. Tivemos que nos tornar os monstros da escuridão.",shape=box,color=blue];
		2720 -> 2721;
		2720 -> 2722;
	2721 [label="Você tá me dizendo que não sequestrou crianças pro Teatro Yuvan contra a vontade delas?",shape=box,color=red];
		2721 -> 2723;
	2722 [label="Então, o que realmente aconteceu no Teatro Yuvan?",shape=box,color=red];
		2722 -> 2724;
	2723 [label="Não, isso está totalmente correto.",shape=box,color=blue];
		2723 -> 2725;
	2724 [label="+5 Chemistry",color=orange];
		2724 -> 2726;
	2725 [label="Só quero que você leve em consideração suas fontes, é tudo.",shape=box,color=blue];
		2725 -> 2727;
	2726 [label="Dizer que não fizemos sacrifícios contra a vontade deles é incorreto. Fizemos, sim. Mas essa não é toda a verdade. Essas coisas raramente são tão simples e nunca são tão preto no branco.",shape=box,color=blue];
		2726 -> 2728;
	2727 [label="Porque não é toda a verdade. Essas coisas raramente são tão simples e nunca tão preto no branco. O mundo é cinza, Usurpador. Linhas não são tão fáceis de traçar. ",shape=box,color=blue];
		2727 -> 2729;
	2728 [label="O mundo é cinza, Usurpador. As linhas não são tão fáceis de traçar.",shape=box,color=blue];
		2728 -> 2729;
	2729 [label="A prática não começou de forma tão vergonhosa. No início, era vista como a maior honra. Entregar-se para que o Império continuasse intacto. Inabalável. Para que o trabalho pudesse prosseguir.",shape=box,color=blue];
		2729 -> 2730;
	2730 [label="E não começou com os jovens. Começou com aqueles que simplesmente tinham mais anos de vida pela frente. Mas então, aqueles que se ofereceram foram ficando… cada vez mais jovens. A devoção é uma droga poderosa.",shape=box,color=blue];
		2730 -> 2731;
	2731 [label="Vi algo semelhante com aqueles que se alistavam para a guerra. Mentiam sobre a idade nos documentos para \"lutar a boa luta\". Mal sabiam eles que estavam criando um precedente perigoso para aqueles que viriam depois, involuntariamente.",shape=box,color=blue];
		2731 -> 2732;
	2732 [label="Em algum momento, algum Executor percebeu que isso poderia ser usado como uma… medida punitiva. Que certas cidades ou… planetas inteiros poderiam ser mantidos sob controle se a ameaça do Teatro Yuvan fosse usada. Se a coleta de sacrifícios fosse exercida de maneira particularmente autoritária.",shape=box,color=blue];
		2732 -> 2733;
		2732 -> 2734;
	2733 [label="E qual a sua opinião sobre isso?",shape=box,color=red];
		2733 -> 2735;
	2734 [label="Você já participou de um sacrifício involuntário?",shape=box,color=red];
		2734 -> 2736;
	2735 [label="+5 Chemistry",color=orange];
		2735 -> 2737;
	2736 [label="Não vou mentir para você. Eu já fiz isso. E você pode me achar um monstro por isso o quanto quiser. Mas quando toda a sua sociedade é construída sobre centenas de anos de normalização de algo, é muito difícil virar as costas para isso.",shape=box,color=blue];
		2736 -> 2738;
	2737 [label="Hmm… uma mistura. Por um lado, eu mesmo já fui ao teatro muitas vezes. Seria a maior hipocrisia da minha parte condená-lo. Quando toda a sua sociedade é construída sobre séculos de normalização de algo, é muito difícil virar as costas para isso.",shape=box,color=blue];
		2737 -> 2739;
	2738 [label="Mesmo em retrospectiva, ou num momento de lucidez, tudo fica muito claro. ",shape=box,color=blue];
		2738 -> 2740;
	2739 [label="Por outro lado, isoladamente ou em retrospectiva, o horror do ato torna-se bastante evidente.",shape=box,color=blue];
		2739 -> 2740;
	2740 [label="+5 Chemistry",color=orange];
		2740 -> 2741;
	2741 [label="Ninguém deveria viver para sempre, Usurpador. E o Teatro é a prova disso.",shape=box,color=blue];
		2741 -> 2742;
	2742 [label="Chat ends.",color=orange];
}