		2683 -> 2689;
	2690 [label="Sim, mas e todos os outros que eram \"próximos\", mas \"não eram importantes o suficiente\"? Os Arquimedianos? Ou os Orokin de posição inferior? Sempre houve níveis dentro de níveis. Mesmo que os limites fossem de vidro, eles existiam. Acredite em mim.",shape=box,color=blue];
		2690 -> 2695;
	2691 [label="Sim, fizemos isso. Em todas as oportunidades possíveis. Mas nem todos foram poupados, não é? E aqueles que eram \"próximos\", mas \"não eram importantes o suficiente\"? Os Arquimedianos? Os Orokin de posição inferior?",shape=box,color=blue];
		2691 -> 2696;
	2692 [label="Sim, mas e todos os outros que eram \"próximos\", mas \"não eram importantes o suficiente\"? Os Arquimedianos? Ou os Orokin de posição inferior? Sempre houve níveis dentro de níveis. Mesmo que os limites fossem de vidro, eles existiam. Acredite em mim.",shape=box,color=blue];
