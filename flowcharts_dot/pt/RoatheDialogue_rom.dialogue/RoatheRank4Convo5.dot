	2675 [label="O que diabos é isso?",shape=box,color=red];
		2675 -> 2679;
	2676 [label="Acho que seria difícil esquecer dessa palavra… se eu já tivesse ouvido ela antes",shape=box,color=red];
		2676 -> 2679;
	2680 [label="Chocante? Não. Talvez seja porque passei os últimos… muitos anos preso em uma cripta com esses dois fanáticos, mas é chocante para mim que absolutamente nenhum registro de como os Orokin lidavam com seus mortos tenha sobrevivido ao longo dos milênios.",shape=box,color=blue];
		2680 -> 2684;
