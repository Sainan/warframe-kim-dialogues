	2679 [label="Talvez seja porque passei os últimos… muitos anos preso em uma cripta com esses dois fanáticos, mas é chocante para mim que absolutamente nenhum registro de como os Orokin lidavam com seus mortos tenha sobrevivido ao longo dos milênios.",shape=box,color=blue];
