	edge [fontname="Roboto Condensed"];

	"RoatheRank4Convo5 begins." [color=orange];
		"RoatheRank4Convo5 begins." -> j3157683966;
	j3157683966 [label="O quanto você se lembra dos seus dias no Império, Usurpador? Parece fragmentado, na melhor das hipóteses. Não que eu seja alguém que deva julgar, claro.",shape=box,color=blue];
		j3157683966 -> j1046851435;
		j3157683966 -> j1810149818;
		j3157683966 -> j2564218145;
		j3157683966 -> j17348121;
	j1046851435 [label="O suficiente pra saber que todos vocês mereciam queimar no inferno",shape=box,color=red];
		j1046851435 -> j3637820271;
	j1810149818 [label="Pedaços e fragmentos… por quê?",shape=box,color=red];
		j1810149818 -> j3105881307;
	j2564218145 [label="Eu era bem jovem quando embarcamos na Zariman E depois disso… é…",shape=box,color=red];
		j2564218145 -> j3105881307;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j3637820271 [label="Isso é bastante justo. No entanto, você está ignorando grandes partes da nossa história e do nosso patrimônio cultural. Eu sei que não havia muito carinho por nós depois da queda, mas…",shape=box,color=blue];
		j3637820271 -> j3275350968;
	j3105881307 [label="Hmm… acho estranho que existam tão poucos registros completos da nossa sociedade e da nossa cultura. Sei que havia pouco carinho por nós depois da queda, mas…",shape=box,color=blue];
		j3105881307 -> j193933465;
	"Chat ends." [color=orange];
	j3275350968 [label="Nem sequer uma menção ao que aconteceu aos Crioleums?",shape=box,color=blue];
		j3275350968 -> j1029308258;
		j3275350968 -> j1853666075;
	j193933465 [label="Nem sequer uma menção ao que aconteceu aos Crioleums?",shape=box,color=blue];
		j193933465 -> j2314731060;
		j193933465 -> j2906012693;
	j1029308258 [label="Isso vai acabar se tornando alguma forma terrível de… tortura Orokin?",shape=box,color=red];
		j1029308258 -> j2841418570;
	j1853666075 [label="Acho que seria difícil esquecer dessa palavra… se eu já tivesse ouvido ela antes",shape=box,color=red];
		j1853666075 -> j3962540821;
	j2314731060 [label="O que diabos é isso?",shape=box,color=red];
		j2314731060 -> j3326117547;
	j2906012693 [label="Acho que seria difícil esquecer dessa palavra… se eu já tivesse ouvido ela antes",shape=box,color=red];
		j2906012693 -> j3326117547;
	j2841418570 [label="Chocante? Não. Talvez seja porque passei os últimos… muitos anos preso em uma cripta com esses dois fanáticos, mas é chocante para mim que absolutamente nenhum registro de como os Orokin lidavam com seus mortos tenha sobrevivido ao longo dos milênios.",shape=box,color=blue];
		j2841418570 -> j1595987777;
		j2841418570 -> j1543392449;
	j3962540821 [label="Talvez seja porque passei os últimos… muitos anos preso em uma cripta com esses dois fanáticos, mas é chocante para mim que absolutamente nenhum registro de como os Orokin lidavam com seus mortos tenha sobrevivido ao longo dos milênios.",shape=box,color=blue];
		j3962540821 -> j4238938699;
		j3962540821 -> j517156144;
	j3326117547 [label="Talvez seja porque passei os últimos… muitos anos preso em uma cripta com esses dois fanáticos, mas é chocante para mim que absolutamente nenhum registro de como os Orokin lidavam com seus mortos tenha sobrevivido ao longo dos milênios.",shape=box,color=blue];
		j3326117547 -> j3836207953;
		j3326117547 -> j3422814747;
	j1595987777 [label="Eu não achei que você tivesse morrido… você só roubou novos corpos no Teatro Yuvan",shape=box,color=red];
		j1595987777 -> j2925016497;
	j1543392449 [label="Achei que você tivesse roubado humanos pra resolver esse problema… tudo o que você fez foi zombar da morte",shape=box,color=red];
		j1543392449 -> j3876820671;
	j4238938699 [label="Eu não achei que você tivesse morrido… você só roubou novos corpos no Teatro Yuvan",shape=box,color=red];
		j4238938699 -> j2925016497;
	j517156144 [label="Prossiga",shape=box,color=red];
		j517156144 -> j3926827111;
	j3836207953 [label="Eu não achei que você tivesse morrido… você só roubou novos corpos no Teatro Yuvan",shape=box,color=red];
		j3836207953 -> j3214563381;
	j3422814747 [label="Prossiga",shape=box,color=red];
		j3422814747 -> j3132473826;
	j2925016497 [label="Sim, mas e todos os outros que eram \"próximos\", mas \"não eram importantes o suficiente\"? Os Arquimedianos? Ou os Orokin de posição inferior? Sempre houve níveis dentro de níveis. Mesmo que os limites fossem de vidro, eles existiam. Acredite em mim.",shape=box,color=blue];
		j2925016497 -> j468552773;
	j3876820671 [label="Sim, fizemos isso. Em todas as oportunidades possíveis. Mas nem todos foram poupados, não é? E aqueles que eram \"próximos\", mas \"não eram importantes o suficiente\"? Os Arquimedianos? Os Orokin de posição inferior?",shape=box,color=blue];
		j3876820671 -> j1827646383;
	j3926827111 [label="Considere todos aqueles que eram \"próximos\", mas \"não eram importantes o suficiente\". Os Arquimedianos. Os Orokin de posição inferior. Sempre houve níveis dentro de níveis. Mesmo que os tetos fossem de vidro, eles existiam. Acredite em mim.",shape=box,color=blue];
		j3926827111 -> j468552773;
	j3214563381 [label="Sim, mas e todos os outros que eram \"próximos\", mas \"não eram importantes o suficiente\"? Os Arquimedianos? Ou os Orokin de posição inferior? Sempre houve níveis dentro de níveis. Mesmo que os limites fossem de vidro, eles existiam. Acredite em mim.",shape=box,color=blue];
		j3214563381 -> j1432443342;
	j3132473826 [label="Considere todos aqueles que eram \"próximos\", mas \"não eram importantes o suficiente\". Os Arquimedianos. Os Orokin de posição inferior. Sempre houve níveis dentro de níveis. Mesmo que os tetos fossem de vidro, eles existiam. Acredite em mim.",shape=box,color=blue];
		j3132473826 -> j1432443342;
	j468552773 [label="Nem todos tiveram a sorte de receber carne nova a cada vez que sua forma antiga se consumia. Mas tenho certeza de que você considera o Teatro Yuvan uma prática repugnante, não é?",shape=box,color=blue];
		j468552773 -> j436382334;
		j468552773 -> j1297782101;
	j1827646383 [label="Nem todos tiveram a sorte de receber carne nova cada vez que seu corpo antigo se consumia. Claramente, você considera o Teatro Yuvan uma prática repugnante.",shape=box,color=blue];
		j1827646383 -> j874081512;
		j1827646383 -> j1297782101;
	j1432443342 [label="Nem todos tiveram a sorte de receber carne nova a cada vez que sua forma antiga se consumia. Mas tenho certeza de que você considera o Teatro Yuvan uma prática repugnante, não é?",shape=box,color=blue];
		j1432443342 -> j928408869;
		j1432443342 -> j2078501329;
	j436382334 [label="Não conheço o suficiente pra opinar",shape=box,color=red];
		j436382334 -> j3617670410;
	j1297782101 [label="Sim. Acho repugnante o que vocês fizeram. Tudo o que foi escrito sobre o Teatro Yuvan diz que vocês sequestraram crianças e destruíram suas mentes",shape=box,color=red];
		j1297782101 -> j1787538317;
	j874081512 [label="Como eu poderia pensar o oposto? Vocês sequestraram crianças de seus lares e apagaram suas mentes pra substituir pelas suas próprias!",shape=box,color=red];
		j874081512 -> j581146873;
	j928408869 [label="Não conheço o suficiente pra opinar",shape=box,color=red];
		j928408869 -> j3528964727;
	j2078501329 [label="Sim. Acho repugnante o que vocês fizeram. Tudo o que foi escrito sobre o Teatro Yuvan diz que vocês sequestraram crianças e destruíram suas mentes",shape=box,color=red];
		j2078501329 -> j540557293;
	j3617670410 [label="+5 Chemistry",color=orange];
		j3617670410 -> j1253012714;
	j1787538317 [label="\"Tudo o que foi escrito sobre o Teatro Yuvan diz isso.\" Onde estão registrados todos esses registros? Mais importante ainda, quem escreveu tudo isso?",shape=box,color=blue];
		j1787538317 -> j3962622258;
	j581146873 [label="E como você sabe de tudo isso? Você mesmo presenciou uma apresentação no Teatro Yuvan?",shape=box,color=blue];
		j581146873 -> j831605524;
		j581146873 -> j3160657815;
		j581146873 -> j3254005152;
	j3528964727 [label="+5 Chemistry",color=orange];
		j3528964727 -> j1253012714;
	j540557293 [label="No entanto, você acabou de dizer que restam apenas fragmentos da nossa história e registros culturais. E onde estão todos esses registros? Mais importante ainda, quem escreveu tudo isso?",shape=box,color=blue];
		j540557293 -> j3962622258;
	j1253012714 [label="Adiar o julgamento até ter todas as informações? Nossa, Usurpador! Você parece inteligente! Que raridade!",shape=box,color=blue];
		j1253012714 -> j2309421596;
	j3962622258 [label="São histórias contadas por aqueles que têm um interesse particular em retratar todos os aspectos dos Orokin sob uma luz o mais desastrosa e maligna possível.",shape=box,color=blue];
		j3962622258 -> j833398659;
	j831605524 [label="Não ",shape=box,color=red];
		j831605524 -> j2799144668;
	j3160657815 [label="Sim ",shape=box,color=red];
		j3160657815 -> j1832195042;
	j3254005152 [label="Não importa, é tudo bem claro",shape=box,color=red];
		j3254005152 -> j1965463585;
	j2309421596 [label="Permita-me, então, mudar a perspectiva da história para você, se me permite. Considere a origem dos relatos sobre o Teatro Yuvan que você pode ter ouvido.",shape=box,color=blue];
		j2309421596 -> j3962622258;
	j833398659 [label="Aqueles que destroem todas as estruturas de suporte da própria sociedade do Sistema de Origem e a mergulham no caos absoluto devem dar aos que dependem dessa sociedade uma boa razão para fazê-lo.",shape=box,color=blue];
		j833398659 -> j2658755872;
	j2799144668 [label="Então você está se baseando em relatos de segunda mão. Considere onde esses relatos foram escritos. Mais importante ainda, considere quem os escreveu.",shape=box,color=blue];
		j2799144668 -> j3962622258;
	j1832195042 [label="Há! Mentiroso. ",shape=box,color=blue];
		j1832195042 -> j1698070564;
	j1965463585 [label="Será mesmo? Considere onde esses relatos foram escritos. Mais importante ainda, considere quem escreveu todos esses relatos.",shape=box,color=blue];
		j1965463585 -> j3962622258;
	j2658755872 [label="Imagine a vida de um humano comum em um posto de retransmissão, Usurpador. Alguém distante das provações e tribulações dos Tennos. Alguém que não se importava com a Grande Guerra.",shape=box,color=blue];
		j2658755872 -> j4104666418;
	j1698070564 [label="Você está se baseando em relatos de segunda mão. Considere onde esses relatos foram escritos. Mais importante ainda, considere quem os escreveu.",shape=box,color=blue];
		j1698070564 -> j3962622258;
	j4104666418 [label="Quando os Orokin caíram, suas vidas foram mergulhadas em um verdadeiro inferno no vácuo de poder que se seguiu. Explicações tiveram que ser inventadas. Efígies tiveram que ser feitas e queimadas. Tivemos que nos tornar os monstros da escuridão.",shape=box,color=blue];
		j4104666418 -> j271871429;
		j4104666418 -> j1188030862;
	j271871429 [label="Você tá me dizendo que não sequestrou crianças pro Teatro Yuvan contra a vontade delas?",shape=box,color=red];
		j271871429 -> j3650745779;
	j1188030862 [label="Então, o que realmente aconteceu no Teatro Yuvan?",shape=box,color=red];
		j1188030862 -> j1757351301;
	j3650745779 [label="Não, isso está totalmente correto.",shape=box,color=blue];
		j3650745779 -> j2030729626;
	j1757351301 [label="+5 Chemistry",color=orange];
		j1757351301 -> j1886129524;
	j2030729626 [label="Só quero que você leve em consideração suas fontes, é tudo.",shape=box,color=blue];
		j2030729626 -> j1867889793;
	j1886129524 [label="Dizer que não fizemos sacrifícios contra a vontade deles é incorreto. Fizemos, sim. Mas essa não é toda a verdade. Essas coisas raramente são tão simples e nunca são tão preto no branco.",shape=box,color=blue];
		j1886129524 -> j4173826559;
	j1867889793 [label="Porque não é toda a verdade. Essas coisas raramente são tão simples e nunca tão preto no branco. O mundo é cinza, Usurpador. Linhas não são tão fáceis de traçar. ",shape=box,color=blue];
		j1867889793 -> j488430451;
	j4173826559 [label="O mundo é cinza, Usurpador. As linhas não são tão fáceis de traçar.",shape=box,color=blue];
		j4173826559 -> j488430451;
	j488430451 [label="A prática não começou de forma tão vergonhosa. No início, era vista como a maior honra. Entregar-se para que o Império continuasse intacto. Inabalável. Para que o trabalho pudesse prosseguir.",shape=box,color=blue];
		j488430451 -> j1034547350;
	j1034547350 [label="E não começou com os jovens. Começou com aqueles que simplesmente tinham mais anos de vida pela frente. Mas então, aqueles que se ofereceram foram ficando… cada vez mais jovens. A devoção é uma droga poderosa.",shape=box,color=blue];
		j1034547350 -> j295777590;
	j295777590 [label="Vi algo semelhante com aqueles que se alistavam para a guerra. Mentiam sobre a idade nos documentos para \"lutar a boa luta\". Mal sabiam eles que estavam criando um precedente perigoso para aqueles que viriam depois, involuntariamente.",shape=box,color=blue];
		j295777590 -> j2605214870;
	j2605214870 [label="Em algum momento, algum Executor percebeu que isso poderia ser usado como uma… medida punitiva. Que certas cidades ou… planetas inteiros poderiam ser mantidos sob controle se a ameaça do Teatro Yuvan fosse usada. Se a coleta de sacrifícios fosse exercida de maneira particularmente autoritária.",shape=box,color=blue];
		j2605214870 -> j3807189013;
		j2605214870 -> j2254755745;
	j3807189013 [label="E qual a sua opinião sobre isso?",shape=box,color=red];
		j3807189013 -> j981158256;
	j2254755745 [label="Você já participou de um sacrifício involuntário?",shape=box,color=red];
		j2254755745 -> j826356993;
	j981158256 [label="+5 Chemistry",color=orange];
		j981158256 -> j577871053;
	j826356993 [label="Não vou mentir para você. Eu já fiz isso. E você pode me achar um monstro por isso o quanto quiser. Mas quando toda a sua sociedade é construída sobre centenas de anos de normalização de algo, é muito difícil virar as costas para isso.",shape=box,color=blue];
		j826356993 -> j174439879;
	j577871053 [label="Hmm… uma mistura. Por um lado, eu mesmo já fui ao teatro muitas vezes. Seria a maior hipocrisia da minha parte condená-lo. Quando toda a sua sociedade é construída sobre séculos de normalização de algo, é muito difícil virar as costas para isso.",shape=box,color=blue];
		j577871053 -> j1215814182;
	j174439879 [label="Mesmo em retrospectiva, ou num momento de lucidez, tudo fica muito claro. ",shape=box,color=blue];
		j174439879 -> j749023739;
	j1215814182 [label="Por outro lado, isoladamente ou em retrospectiva, o horror do ato torna-se bastante evidente.",shape=box,color=blue];
		j1215814182 -> j749023739;
	j749023739 [label="+5 Chemistry",color=orange];
		j749023739 -> j139029118;
	j139029118 [label="Ninguém deveria viver para sempre, Usurpador. E o Teatro é a prova disso.",shape=box,color=blue];
		j139029118 -> "Chat ends.";
}