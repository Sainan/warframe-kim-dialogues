		2667 -> 2670;
	2669 [label="[Encerrar Conversa]",shape=box,color=red];
		2669 -> 2672;
	2671 [label="Isso é bastante justo. No entanto, você está ignorando grandes partes da nossa história e do nosso patrimônio cultural. Eu sei que não havia muito carinho por nós depois da queda, mas…",shape=box,color=blue];
		2671 -> 2674;
	2670 [label="Hmm… acho estranho que existam tão poucos registros completos da nossa sociedade e da nossa cultura. Sei que havia pouco carinho por nós depois da queda, mas…",shape=box,color=blue];
		2670 -> 2673;
