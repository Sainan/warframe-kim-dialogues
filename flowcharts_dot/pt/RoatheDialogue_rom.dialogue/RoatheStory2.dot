	j4009957311 [label="ÁUDIO: CONEXÃO",shape=box,color=blue];
		j4009957311 -> j1591839782;
	j1591839782 [label="Quando os Sentients concluíram o Trilho Solar para Tau, não houve uma grande cerimônia. Ele simplesmente começou a operar.",shape=box,color=blue];
		j1591839782 -> j336419744;
	j336419744 [label="Claro, uma cerimônia foi improvisada, pois nenhum Orokin que se preze assoaria o nariz sem um mínimo de pompa e circunstância.",shape=box,color=blue];
		j336419744 -> j692861546;
	j692861546 [label="Houve um grande alvoroço em torno do primeiro transporte a fazer a travessia.",shape=box,color=blue];
		j692861546 -> j185178472;
	j185178472 [label="Era o imponente cruzador do Executor Tormis, e a escolha de Tormis como expedicionário poderia ser interpretada como uma repreensão coletiva ao Executor Tuvul pelo grotesco acidente da Zariman 10-0.",shape=box,color=blue];
		j185178472 -> j1659166635;
	j1659166635 [label="Tormis partiu e retornou, trazendo consigo memórias maravilhosas de um novo Sistema e novos mundos para colonizar. ",shape=box,color=blue];
		j1659166635 -> j3891969536;
	j3891969536 [label="Em poucos dias, uma flotilha de naves colonizadoras partiu, ansiosa para pisar na costa virgem.",shape=box,color=blue];
		j3891969536 -> j3012729372;
	j3012729372 [label="O subsequente ataque Sentient estragou um pouco o clima.",shape=box,color=blue];
		j3012729372 -> j921430358;
