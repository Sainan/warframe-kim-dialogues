		1359 -> 1367 [label="RoatheExecutor2",color=purple];
		1359 -> 1364 [label="false",color=purple];
		1359 -> 1365 [label="false",color=purple];
		1359 -> 1366 [label="false",color=purple];
	1360 [label="Diga, por gentileza. ",shape=box,color=blue];
		1360 -> 1368;
		1360 -> 1369;
		1360 -> 1370;
	1361 [label="Não vou me desculpar pela sociedade Orokin, pois não fui seu criador. Apenas um habitante. E se você culpar todos aqueles que participam de um sistema no qual nasceram, estará condenando bilhões em sua arrogância e presunção. E quanto ao resto?",shape=box,color=blue];
		1361 -> 1371;
	1362 [label="E se eu tiver feito? Não posso mudar isso agora. Que diferença faz sentir culpa?",shape=box,color=blue];
		1362 -> 1372;
		1362 -> 1373;
	1363 [label="Embora, entre os dois, eu prefira o padre, devo admitir. Ele ouve a razão.Talvez ele acabe aceitando que a Indiferença não é um deus de verdade.",shape=box,color=blue];
		1363 -> 1374;
	1364 [label="Acho importante refletir sobre nossas ações que prejudicaram os outros e tentar entender como reparar o dano que foi causado. Mas não acho que esses dois tão agindo da melhor maneira",shape=box,color=red];
		1364 -> 1375;
	1365 [label="Não acredito na necessidade de perdoar ninguém além de si mesmo, no fim das contas. Se você tá em paz com as suas ações, é isso que importa",shape=box,color=red];
		1365 -> 1376;
	1366 [label="Você nasceu numa sociedade onde muitos comportamentos Orokin eram… normalizados. Esperados. Não eram \"errados\" pra você. Não tô dizendo que isso torna tudo aceitável, só compreensível",shape=box,color=red];
		1366 -> 1377;
	1367 [label="Você tava planejando derrubar os Orokin. Sabia que eles eram corruptos e tava tentando corrigir a situação",shape=box,color=red];
		1367 -> 1378;
	1368 [label="Você mesmo.",shape=box,color=red];
		1368 -> 1379;
	1369 [label="Seu próprio povo, que você tava prestes a trair",shape=box,color=red];
		1369 -> 1380;
	1370 [label="Os Sentients que você massacrou",shape=box,color=red];
		1370 -> 1371;
	1371 [label="Era guerra. E é da natureza da guerra eliminar o máximo de inimigos possível. Você chora pelos Grineers ou pelos \"Corpus\" que mata?",shape=box,color=blue];
		1371 -> 1381;
		1371 -> 1382;
		1371 -> 1383;
	1372 [label="O perdão dos outros importa",shape=box,color=red];
		1372 -> 1384;
	1373 [label="Você pode mudar seu comportamento pro futuro",shape=box,color=red];
		1373 -> 1385;
	1374 [label="Na verdade, talvez eu ainda consiga convencê-lo a enxergar além da sua religião — imagine só. Um homem que enxerga alucinações fantasiosas e sangrentas, mas também bom senso e lógica. Que raridade.",shape=box,color=blue];
		1374 -> 1386;
		1374 -> 1387;
	1375 [label="Hmm. Entendo. Não é a ação em si, mas o método que lhe incomoda. Portanto, retiro minha aprovação anterior e a substituo por um sentimento de consternação.",shape=box,color=blue];
		1375 -> 1388;
	1376 [label="Update boolean RoatheVillainSelf",color=orange];
		1376 -> 1389;
	1377 [label="Update boolean RoatheVillainOrokin",color=orange];
		1377 -> 1389;
	1378 [label="Então, acho que mesmo que você tivesse planejando remodelar o Império à sua imagem, você sabia que ele precisava mudar",shape=box,color=red];
		1378 -> 1390;
		1378 -> 1391;
	1379 [label="Check boolean RoatheKnowsReset2",color=orange];
		1379 -> 1392 [label=true,color=green];
		1379 -> 1393 [label=false,color=brown];
	1380 [label="Eu nunca perdi uma noite de sono por peso na consciência de ter traído meu próprio povo, Usurpador. Pode acreditar.",shape=box,color=blue];
		1380 -> 1394;
	1381 [label="Não. Mas os Sentients são um caso diferente",shape=box,color=red];
		1381 -> 1395;
	1382 [label="Sim",shape=box,color=red];
		1382 -> 1396;
	1383 [label="Como eu me sinto sobre as vidas que tenho que tirar é problema meu. A gente tá falando de você aqui",shape=box,color=red];
		1383 -> 1397;
	1384 [label="Por qual motivo? Para que me deixem em paz? Para que eu não seja uma espécie de… anátema? Um pária social? ",shape=box,color=blue];
		1384 -> 1398;
	1385 [label="Aprender com os próprios erros é fundamental, sim. Mas não é necessário sentir \"culpa\" para entender o \"fracasso\".",shape=box,color=blue];
		1385 -> 1399;
	1386 [label="O Lyon parece já ter problema suficiente, não acha não?",shape=box,color=red];
		1386 -> 1400;
	1387 [label="Peraí… você tá fazendo o quê?",shape=box,color=red];
		1387 -> 1401;
	1388 [label="Chat ends.",color=orange];
	1389 [label="O seu contexto era diferente do nosso, naquela época. O que a gente considera cruel e terrível, vocês cresceram enxergando como só mais uma parte de como o mundo funcionava",shape=box,color=red];
		1389 -> 1402;
	1390 [label="O que ainda não justifica tudo o que você fez… atrocidades são atrocidades e horrores são horrores. Mas você tava tentando",shape=box,color=red];
		1390 -> 1403;
	1391 [label="Do meu ponto de vista, era uma guerra, e você tava tentando se virar em uma sociedade de sociopatas enquanto planejava acabar com tudo. E te rotularam de diabo por isso. Não acho justo",shape=box,color=red];
		1391 -> 1404;
	1392 [label="Por ter fugido",shape=box,color=red];
		1392 -> 1405;
	1393 [label="Por ter falhado",shape=box,color=red];
		1393 -> 1405;
	1394 [label="Não vou me desculpar pela sociedade Orokin, pois não fui seu criador. Apenas um habitante. E também não aceitarei a culpa por planejar sua queda. Merecemos o que nos aconteceu, e até pior.",shape=box,color=blue];
		1394 -> 1406;
	1395 [label="\"Cada caso é um caso\", Usurpador. O contexto é sempre fundamental. E você está simplesmente olhando para a \"Guerra Ancestral\" com a clareza da retrospectiva.",shape=box,color=blue];
		1395 -> 1407;
	1396 [label="Então, sinto imensa pena de você, Usurpador, e sugiro que você aceite a tarefa que lhe foi atribuída ou se retire desta vida e vá vender arte na praia.",shape=box,color=blue];
		1396 -> 1408;
	1397 [label="Hmm. Adoro quando você demonstra tão claramente que caiu na minha provocação, é muito satisfatório. Você tenta desviar do assunto sem muito talento.",shape=box,color=blue];
		1397 -> 1409;
	1398 [label="Olhe para mim, Usurpador. Veja quem eu sou. Um Orokin, expulso de seu império.",shape=box,color=blue];
		1398 -> 1410;
	1399 [label="E qual é o sentido do perdão, afinal? Por quem devo ser perdoado? Pelos outros? Para que eu não me torne uma espécie de anátema?",shape=box,color=blue];
		1399 -> 1398;
	1400 [label="E é exatamente por isso que eu quis ajudá-lo! Estou apenas tentando ajudá-lo a lidar com algumas de suas incertezas em relação à Indiferença e ao que o Entrati lhe disse.",shape=box,color=blue];
		1400 -> 1411;
	1401 [label="Absolutamente nada de mal, independentemente do que aquele mosquito irritante possa dizer. Estou apenas tentando ajudá-lo a lidar com algumas das suas incertezas em relação ao que a Indiferença e o que Entrati lhe disseram.",shape=box,color=blue];
		1401 -> 1411;
	1402 [label="+10 Chemistry",color=orange];
		1402 -> 1412;
	1403 [label="Update boolean RoatheVillainOrokin",color=orange];
		1403 -> 1402;
	1404 [label="Update boolean RoatheVillainShortcut",color=orange];
		1404 -> 1413;
	1405 [label="Update boolean RoatheForgivenessShortcut",color=orange];
		1405 -> 1414;
	1406 [label="Se há uma única coisa pela qual sinto culpa, é pelos Tennos terem sido os responsáveis por finalmente incendiar tudo, e não eu.",shape=box,color=blue];
		1406 -> 1415;
	1407 [label="Se você for julgar as ações passadas de todos os povos com base nas informações que possuir no futuro, ficará constantemente envergonhado.",shape=box,color=blue];
		1407 -> 1416;
	1408 [label="Seria uma pena, no entanto. É um prazer enorme ver você trabalhando. Não é muito eficiente, mas é maravilhosamente atraente.",shape=box,color=blue];
		1408 -> 1417;
	1409 [label="Embora eu imagine que passar séculos em isolamento, sem ninguém com quem conversar além das criações imaginárias da própria mente, limite as oportunidades de aprimorar as habilidades sociais.",shape=box,color=blue];
		1409 -> 1418;
	1410 [label="Eu era \"o Diabo de Tau\" na minha época. E aqui, já sou \"o diabo\" para todos que me conhecem.",shape=box,color=blue];
		1410 -> 1419;
	1411 [label="Entrati falou que as \"visões\" dele não eram obra da Lua, mas da Indiferença. Isto acarretou uma espécie de \"crise de fé\".",shape=box,color=blue];
		1411 -> 1420;
	1412 [label="Que bom saber que o conceito de nuances e sutilezas não está morto, afinal. Sim, você tem toda a razão. Sou um produto de outra época, outra era, outra sociedade.",shape=box,color=blue];
		1412 -> 1421;
	1413 [label="+20 Chemistry",color=orange];
		1413 -> 1422;
	1414 [label="+10 Chemistry",color=orange];
		1414 -> 1423;
	1415 [label="Update boolean RoatheForgivenessNoGuilt",color=orange];
		1415 -> 1424;
	1416 [label="Aceite o que aconteceu no passado e supere isso.",shape=box,color=blue];
		1416 -> 1425;
	1417 [label="Pelo menos você torna o campo de batalha \"divertido\". ",shape=box,color=blue];
		1417 -> 1425;
	1418 [label="Vá treinar com o Padre, vocês dois precisam praticar. ",shape=box,color=blue];
		1418 -> 1426;
	1419 [label="Albrecht fez questão de garantir que o apelido fosse permanente. ",shape=box,color=blue];
		1419 -> 1425;
	1420 [label="No entanto, estou tentando convencê-lo de que não é esse o caso, e que nenhum \"deus\" fez isso, pois não existem \"deuses\". Ele simplesmente não está bem.",shape=box,color=blue];
		1420 -> 1427;
		1420 -> 1428;
	1421 [label="No entanto, eu conseguia reconhecer a crueldade e as atrocidades cometidas pelo meu povo pelo que elas eram. Havia níveis de horrores praticados por muitos que nem eu conseguia suportar.",shape=box,color=blue];
		1421 -> 1429;
	1422 [label="Eu sabia que tinha simpatizado com você por algum motivo, Usurpador. Finalmente! Alguém que me valoriza! Só levou… quantos séculos?!",shape=box,color=blue];
		1422 -> 1430;
	1423 [label="Chat ends.",color=orange];
	1424 [label="+10 Chemistry",color=orange];
		1424 -> 1431;
	1425 [label="Aqui vai o meu conselho: elimine toda a culpa do seu coração, como eu fiz. Crave uma lâmina no peito até que não sinta mais nada.",shape=box,color=blue];
		1425 -> 1432;
	1426 [label="+5 Chemistry",color=orange];
		1426 -> 1433;
	1427 [label="O Lyon pediu a sua ajuda?",shape=box,color=red];
		1427 -> 1434;
	1428 [label="E você acha que isso melhora a situação?",shape=box,color=red];
		1428 -> 1435;
	1429 [label="Mas são questões… complexas. E agradeço que você entenda isso. Bah. O mordomo está me olhando torto. Preciso encerrar esta conversa. Falaremos novamente em breve.",shape=box,color=blue];
		1429 -> 1436;
	1430 [label="Bah. O mordomo está me olhando torto. Preciso encerrar esta conversa. Falaremos novamente em breve.",shape=box,color=blue];
		1430 -> 1437;
	1431 [label="Chat ends.",color=orange];
	1432 [label="A culpa nada mais é do que uma traidora na calada da noite, roubando tudo o que você mais preza. Ela só traz sofrimento.",shape=box,color=blue];
		1432 -> 1438;
	1433 [label="Chat ends.",color=orange];
	1434 [label="Ele não se recusou a ouvir. Ele não pediu para me calar. Eu faria, se ele tivesse pedido.",shape=box,color=blue];
		1434 -> 1439;
	1435 [label="É preferível deixar que os religiosos o manipulem simplesmente porque podem? Apontar para suas alucinações e chamá-las de \"visões\" em vez de ajudá-lo?",shape=box,color=blue];
		1435 -> 1440;
	1436 [label="Chat ends.",color=orange];
	1437 [label="Chat ends.",color=orange];
	1438 [label="Update boolean RoatheForgivenessNoGuilt",color=orange];
		1438 -> 1441;
	1439 [label="Me irrita ver o círculo íntimo de Lyon o usando e manipulando, mesmo que não tenham consciência disso. Tudo em nome da \"religião\" e das \"crenças\".",shape=box,color=blue];
		1439 -> 1440;
	1440 [label="Tenho lido os relatos do que aconteceu. Este… \"Véu Rubro\" poderia ter tentado resgatar aquele Tenno, aprisionando em seu Harrow durante todos esses séculos. Mas não fizeram isso. Deixaram ele definhar e morrer.",shape=box,color=blue];
		1440 -> 1442;
	1441 [label="+10 Chemistry",color=orange];
		1441 -> 1443;
	1442 [label="O motivo? Para proteção contra algum… hipotético \"Deus do Void\".",shape=box,color=blue];
		1442 -> 1444;
		1442 -> 1445;
	1443 [label="Chat ends.",color=orange];
	1444 [label="Você acha que o sacrifício de Rell foi inútil?",shape=box,color=red];
		1444 -> 1446;
	1445 [label="Rell foi a única coisa que impediu o avanço daquilo, durante todos esses anos",shape=box,color=red];
		1445 -> 1447;
	1446 [label="Não. Ele estava nos protegendo de algo. Mas quem sabe o quanto ele piorou a situação? Quem sabe o quanto ele alimentou aquilo com seu próprio medo e pavor, por séculos?",shape=box,color=blue];
		1446 -> 1448;
	1447 [label="Ou era a única coisa que alimentava aquilo, durante todos esses anos.",shape=box,color=blue];
		1447 -> 1448;
	1448 [label="A Incorporação Conceitual só manifesta aquilo com que lhe é dado para criar. E o Void só pode trabalhar com o tecido que lhe é dado para costurar.",shape=box,color=blue];
		1448 -> 1449;
	1449 [label="Imagino o quanto aquele Tenno sozinho alimentou sua existência? Ele era um verdadeiro banquete de agonia, dor, traição, tristeza… e solidão…",shape=box,color=blue];
		1449 -> 1450;
	1450 [label="E a dormência que deve advir dos milhares de anos que ele passou em solidão naquele lugar, falando para o Nada. O que resulta disso, senão a Indiferença?",shape=box,color=blue];
		1450 -> 1451;
		1450 -> 1452;
	1451 [label="Tem chance de ser verdade o que você tá falando. Eu só… não sei se é. E também não sei se não é",shape=box,color=red];
		1451 -> 1453;
	1452 [label="Era poderoso antes mesmo de chegar a Rell. Ele não teria se sacrificado daquela maneira sem um bom motivo",shape=box,color=red];
		1452 -> 1454;
	1453 [label="+10 Chemistry",color=orange];
		1453 -> 1455;
	1454 [label="Assim como os pesadelos infantis. Para uma criança de seis anos, são as criaturas mais poderosas do universo. Mas para um adulto, são apenas uma nuvem de poeira presa em um duto de ventilação que se aproximou demais da luz.",shape=box,color=blue];
		1454 -> 1456;
	1455 [label="Creio que eu não possa pedir nada além de que você simplesmente admita que não sabe ao certo com o que estamos lidando.",shape=box,color=blue];
		1455 -> 1457;
	1456 [label="Fazemos tempestade em copo d'água simplesmente porque precisamos de um motivo para sermos infelizes e nos punirmos.",shape=box,color=blue];
		1456 -> 1458;
	1457 [label="Esse é um ótimo ponto de partida. E uma característica admirável em qualquer pessoa: a simples capacidade de dizer… \"Eu não sei\".",shape=box,color=blue];
		1457 -> 1459;
	1458 [label="A humanidade em resumo.",shape=box,color=blue];
		1458 -> 1460;
	1459 [label="Se nós, Orokin, tivéssemos conseguido demonstrar isso de vez em quando, talvez tivéssemos sobrevivido.",shape=box,color=blue];
		1459 -> 1460;
	1460 [label="Update boolean RoatheMITW3",color=orange];
		1460 -> 1461;
