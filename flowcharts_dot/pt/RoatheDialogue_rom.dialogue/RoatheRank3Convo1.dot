digraph {
	1333 [label="RoatheRank3Convo1 begins.",color=orange];
		1333 -> 1334;
	1334 [label="Você finalmente conseguiu falar com o nosso querido Lyon? Ou ele continua te ignorando? Sinceramente, talvez seja melhor manter distância.",shape=box,color=blue];
		1334 -> 1337;
		1334 -> 1336;
		1334 -> 1335;
	1337 [label="Você se dá com ele?",shape=box,color=red];
		1337 -> 1340;
	1336 [label="Se você fosse um pouco mais gentil com a Marie e o Lyon, talvez eles fossem mais gentis com você",shape=box,color=red];
		1336 -> 1339;
	1335 [label="[Encerrar Conversa]",shape=box,color=red];
		1335 -> 1338;
	1340 [label="Eu me \"daria\" melhor com ele se ele se esforçasse para entender um pouco mais sobre quem eu sou e de onde venho. Eu sou o que sou. E tenho sido assim por muitos séculos. Não espero mudar simplesmente porque agora exigem isso.",shape=box,color=blue];
		1340 -> 1341;
	1339 [label="E quanto à gentileza deles para comigo, Usurpador? Eu sou o que sou. E tenho sido assim por muitos séculos. Não espero mudar simplesmente porque agora eles exigem isso.",shape=box,color=blue];
		1339 -> 1341;
	1338 [label="Chat ends.",color=orange];
	1341 [label="Evaluate expressions on HellStory",color=orange];
		1341 -> 1343 [label="x >= 21",color=purple];
		1341 -> 1342 [label="x < 21",color=purple];
		1341 -> 1342 [label="false",color=purple];
	1343 [label="Posso até ter tomado aquele soro de livre e espontânea vontade, mas sei que não me inscrevi para ser importunado a todo instante por aqueles dois ingratos.  ",shape=box,color=blue];
		1343 -> 1344;
	1342 [label="A culpa por eu ser assim é do Albrecht! A culpa de estar preso aqui com eles é dele, não minha! Eu não tive nada a ver com esse esquema horrível!",shape=box,color=blue];
		1342 -> 1344;
	1344 [label="Eles podem apresentar suas queixas com o precioso \"Cardinal\", não comigo.",shape=box,color=blue];
		1344 -> 1345;
		1344 -> 1346;
		1344 -> 1347;
	1345 [label="Eles têm boas intenções, mesmo que não estejam fazendo isso da melhor forma possível",shape=box,color=red];
		1345 -> 1348;
	1346 [label="Você não acha que precisa ser perdoado pelas coisas que fez?",shape=box,color=red];
		1346 -> 1349;
	1347 [label="Eles só tão tentando te ajudar",shape=box,color=red];
		1347 -> 1350;
	1348 [label="Add -1 to Thermostat",color=orange];
		1348 -> 1351;
	1349 [label="Add 1 to Thermostat",color=orange];
		1349 -> 1352;
	1350 [label="\"Ajudar.\" Sim. \"Ajudar.\" Peço desculpas por achar o estilo dessa \"ajuda\" deles profundamente \"inútil\".",shape=box,color=blue];
		1350 -> 1353;
	1351 [label="Sim, essa é a tragédia de tudo isso. Eles realmente acreditam que estão tentando fazer o \"bem\".",shape=box,color=blue];
		1351 -> 1354;
	1352 [label="Perdoado por quem? Por você? Por eles? Pelo mordomo? Pelo Albrecht? Ou pelos \"deuses\"?",shape=box,color=blue];
		1352 -> 1355;
		1352 -> 1356;
		1352 -> 1357;
	1353 [label="Na verdade, eu acharia \"mais útil\" se eles trocassem meu vinho por um líquido corrosivo, Usurpador.",shape=box,color=blue];
		1353 -> 1358;
	1354 [label="E qual é a sua opinião? Acredita que eu preciso de uma \"grande redenção\"? De um \"perdão sagrado\"?",shape=box,color=blue];
		1354 -> 1359;
	1355 [label="Você tá deixando de fora um item importante nessa lista aí",shape=box,color=red];
		1355 -> 1360;
	1356 [label="Você é um Orokin. Cometeu atrocidades na guerra e pela própria natureza da sua sociedade. Você tem muito a reparar",shape=box,color=red];
		1356 -> 1361;
	1357 [label="Você nem ao menos reconhece que fez coisas terríveis na sua vida?",shape=box,color=red];
		1357 -> 1362;
	1358 [label="Pelo menos seria mais eficiente.",shape=box,color=blue];
		1358 -> 1363;
