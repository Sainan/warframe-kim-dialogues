	2412 [label="Check boolean RoatheKnowsReset2",color=orange];
		2412 -> 2417 [label=true,color=green];
		2412 -> 2416 [label=false,color=brown];
	2418 [label="E fico satisfeito por você reconhecer que tenho ao meu alcance transformar este lugar em um matadouro com bastante facilidade.",shape=box,color=blue];
		2418 -> 2424;
	2420 [label="Porque ainda permanece o mistério de por que confiei o suficiente em você para lhe contar tanta coisa, apenas para você trair essa confiança, Usurpador.",shape=box,color=blue];
		2420 -> 2423;
	2419 [label="Ainda há trabalho a fazer, Usurpador. Não posso contar com sua ajuda para recuperar todas as minhas memórias se eu sair por aí assassinando todos ao meu redor, não é mesmo?",shape=box,color=blue];
		2419 -> 2422;
	2421 [label="Estou me esforçando muito para não provar imediatamente que seu argumento está correto.",shape=box,color=blue];
		2421 -> 2425;
	2417 [label="Porque ainda permanece o mistério de por que confiei o suficiente em você para lhe contar tanta coisa, apenas para você trair essa confiança, Usurpador.",shape=box,color=blue];
		2417 -> 2423;
	2416 [label="Talvez eu esteja esperando que você se dê conta do erro e mude de ideia. E as chances disso acontecer diminuem drasticamente se eu tiver massacrado todos ao meu redor, não é?",shape=box,color=blue];
		2416 -> 2422;
	2424 [label="Mas não adiantaria nada fazer isso, não é mesmo? Se há uma única coisa que se aprende com a guerra, é que, no fim das contas, matar resolve pouca coisa.",shape=box,color=blue];
		2424 -> 2427;
	2423 [label="E as chances disso acontecer diminuem drasticamente se eu tiver massacrado todos ao meu redor, não é? Se há uma única coisa que se aprende com a guerra, é que matar, no fim das contas, resolve pouca coisa.",shape=box,color=blue];
		2423 -> 2426;
	2422 [label="Além disso, não adiantaria nada fazer isso, não é mesmo? Se há uma única coisa que se aprende com a guerra, é que, no fim das contas, matar resolve pouca coisa.",shape=box,color=blue];
		2422 -> 2426;
	2425 [label="Compreendo seu ódio pelos Orokin. Acredite em mim. A maioria dos Orokin desprezava os Orokin. Não ignoro nossos crimes. As atrocidades que cometemos. ",shape=box,color=blue];
		2425 -> 2428;
	2427 [label="Por mais prazeroso que seja nutrir o desejo de cometer um pouco disso de vez em quando.",shape=box,color=blue];
		2427 -> 2431;
		2427 -> 2430;
		2427 -> 2429;
	2426 [label="Por mais prazeroso que seja nutrir o desejo de cometer um pouco disso de vez em quando.",shape=box,color=blue];
		2426 -> 2429;
		2426 -> 2430;
		2426 -> 2431;
	2428 [label="Só o teatro Yuvan já seria motivo suficiente para incendiar nossa sociedade. Mas você condena um povo inteiro (do qual você mesmo é produto, meu Usurpador) com um único golpe generalizado!",shape=box,color=blue];
		2428 -> 2432;
	2431 [label="Então, a única razão pela qual você deixou todos viverem é porque… seria inútil matar eles?",shape=box,color=red];
		2431 -> 2435;
	2430 [label="Não tem outro motivo pra você estar deixando todos viverem?",shape=box,color=red];
		2430 -> 2434;
	2429 [label="Até mesmo a Marie e o Lyon?",shape=box,color=red];
		2429 -> 2433;
	2432 [label="Você não sabe nada sobre todas as almas bondosas que trabalharam e morreram dentro daquelas paredes douradas. As sagas escritas sobre aquelas vidas que se perderam no tempo.",shape=box,color=blue];
		2432 -> 2436;
	2435 [label="Seria inútil matá-los. Não é? Está tentando me convencer do contrário? Usurpador, estou impressionado… nunca imaginei que você fosse um monstro tão ardiloso!",shape=box,color=blue];
		2435 -> 2438;
		2435 -> 2439;
	2434 [label="Se você vai tentar fazer alguma insinuação dissimulada, Usurpador, diga logo de uma vez.",shape=box,color=blue];
		2434 -> 2438;
		2434 -> 2439;
	2433 [label="Tenho quase certeza de que, se você descesse até a cripta e encontrasse duas manchas de sangue onde os fanáticos costumavam ficar, eu levaria uma bela bronca, não acha?",shape=box,color=blue];
		2433 -> 2437;
	2436 [label="Os rios de lágrimas derramadas pelas tragédias que permanecerão para sempre sem ser cantadas, simplesmente porque você não as conhece.",shape=box,color=blue];
		2436 -> 2440;
	2438 [label="Não tem problema admitir que você gosta da companhia. As pessoas podem ser mais além de um \"propósito utilitário\"",shape=box,color=red];
		2438 -> 2441;
	2439 [label="Não tem problema admitir que você tenta afastar a solidão, mesmo que isso te irrite",shape=box,color=red];
		2439 -> 2442;
	2437 [label="De você, ou do mordomo, ou do Tenno, ou da terrível \"Mãe\" do Tenno. Ugh… essa… essa me perturba. Um assunto para outra hora.",shape=box,color=blue];
		2437 -> 2439;
		2437 -> 2438;
