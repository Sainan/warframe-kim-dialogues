		j3235414511 -> j2490200343;
	j148791309 [label="Solidão? Bah. A única coisa que vocês afastam é a tentativa de sanidade de retornar à minha vida. Se vocês estão tentando insinuar que estão \"me conquistando\", sabe o que mais faria isso?",shape=box,color=blue];
