		2461 -> 2464;
	2462 [label="+10 Chemistry",color=orange];
		2462 -> 2465;
	2463 [label="Existe outro motivo pelo qual eu não me lancei em uma fúria insana, movida por sede de sangue e hedionda, Usurpador.",shape=box,color=blue];
		2463 -> 2466;
	2464 [label="Afinal, ela já viu a maioria dos nossos.",shape=box,color=blue];
