	2409 [label="Você tem os meios, tem a força e já expressou abertamente o seu descontentamento com a sua situação",shape=box,color=red];
		2409 -> 2413;
	2410 [label="Eu só não entendo por que o \"Diabo de Tau\" se contenta em ficar sentado em uma cripta sem fazer nada. Mesmo com acordo",shape=box,color=red];
		2410 -> 2414;
	2411 [label="Você é um Orokin, é evidente que você odeia todos ao seu redor. O que te impede?",shape=box,color=red];
		2411 -> 2415;
	2408 [label="Eu só não entendo por que o \"Diabo de Tau\" se contenta em ficar sentado em uma cripta sem fazer nada. Principalmente porque não temos nenhum tipo de acordo",shape=box,color=red];
