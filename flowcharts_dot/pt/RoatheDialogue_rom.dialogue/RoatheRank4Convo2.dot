		j600667172 -> j1926445273;
		j600667172 -> j2775445602;
	j1197323480 [label="Tenho quase certeza de que, se você descesse até a cripta e encontrasse duas manchas de sangue onde os fanáticos costumavam ficar, eu levaria uma bela bronca, não acha?",shape=box,color=blue];
		j1197323480 -> j2795723655;
