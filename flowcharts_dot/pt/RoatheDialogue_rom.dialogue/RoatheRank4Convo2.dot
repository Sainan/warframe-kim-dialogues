		j2235205033 -> j3214606927;
	j4194569072 [label="Só o teatro Yuvan já seria motivo suficiente para incendiar nossa sociedade. Mas você condena um povo inteiro (do qual você mesmo é produto, meu Usurpador) com um único golpe generalizado!",shape=box,color=blue];
		j4194569072 -> j2783225417;
	j3214606927 [label="Então, a única razão pela qual você deixou todos viverem é porque… seria inútil matar eles?",shape=box,color=red];
		j3214606927 -> j1847887677;
	j1822846329 [label="Não tem outro motivo pra você estar deixando todos viverem?",shape=box,color=red];
		j1822846329 -> j600667172;
	j2770585929 [label="Até mesmo a Marie e o Lyon?",shape=box,color=red];
		j2770585929 -> j1197323480;
	j2783225417 [label="Você não sabe nada sobre todas as almas bondosas que trabalharam e morreram dentro daquelas paredes douradas. As sagas escritas sobre aquelas vidas que se perderam no tempo.",shape=box,color=blue];
		j2783225417 -> j1409745578;
	j1847887677 [label="Seria inútil matá-los. Não é? Está tentando me convencer do contrário? Usurpador, estou impressionado… nunca imaginei que você fosse um monstro tão ardiloso!",shape=box,color=blue];
		j1847887677 -> j1926445273;
		j1847887677 -> j2775445602;
