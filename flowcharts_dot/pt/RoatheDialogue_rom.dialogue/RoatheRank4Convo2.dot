		j624117983 -> j1328807703;
	j576614065 [label="\"Alegria?\" Seria isso? Nunca imaginei que fosse tão masoquista. Hmm… ou será simplesmente a sensação do meu corpo se deteriorando e a impressão de que vocês estão \"me conquistando\"?",shape=box,color=blue];
