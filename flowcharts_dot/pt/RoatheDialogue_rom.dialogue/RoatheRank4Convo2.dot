	2466 [label="Ainda não vi o desfecho do pequeno drama entre nosso querido mordomo e a família distante do Albrecht, que mora no andar de cima.",shape=box,color=blue];
		2466 -> 2468;
	2467 [label="Update boolean RoatheNoDate",color=orange];
		2467 -> 2469;
	2468 [label="Não se esqueça, tenho um interesse pessoal em tudo isto, independentemente de termos ou não um acordo. Pretendo garantir que, quando o Albrecht voltar a pisar neste Sanctum, o primeiro rosto que ele veja seja…",shape=box,color=blue];
		2468 -> 2470;
