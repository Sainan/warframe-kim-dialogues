		2455 -> 2457;
	2456 [label="Pintem minha espécie de carmesim o quanto quiserem. Derretam o ouro Orokin e nos chamem de monstros. Merecemos cada gota de vitríolo que puderem nos dedicar.",shape=box,color=blue];
		2456 -> 2459;
