		j3657429577 -> j3306188345 [label=false,color=brown];
	j632087577 [label="E fico satisfeito por você reconhecer que tenho ao meu alcance transformar este lugar em um matadouro com bastante facilidade.",shape=box,color=blue];
		j632087577 -> j478814160;
	j3752542121 [label="Porque ainda permanece o mistério de por que confiei o suficiente em você para lhe contar tanta coisa, apenas para você trair essa confiança, Usurpador.",shape=box,color=blue];
		j3752542121 -> j2616763931;
	j380896423 [label="Ainda há trabalho a fazer, Usurpador. Não posso contar com sua ajuda para recuperar todas as minhas memórias se eu sair por aí assassinando todos ao meu redor, não é mesmo?",shape=box,color=blue];
		j380896423 -> j644035199;
	j3468161621 [label="Estou me esforçando muito para não provar imediatamente que seu argumento está correto.",shape=box,color=blue];
		j3468161621 -> j329454096;
	j3306188345 [label="Talvez eu esteja esperando que você se dê conta do erro e mude de ideia. E as chances disso acontecer diminuem drasticamente se eu tiver massacrado todos ao meu redor, não é?",shape=box,color=blue];
		j3306188345 -> j644035199;
	j478814160 [label="Mas não adiantaria nada fazer isso, não é mesmo? Se há uma única coisa que se aprende com a guerra, é que, no fim das contas, matar resolve pouca coisa.",shape=box,color=blue];
		j478814160 -> j679586169;
	j2616763931 [label="E as chances disso acontecer diminuem drasticamente se eu tiver massacrado todos ao meu redor, não é? Se há uma única coisa que se aprende com a guerra, é que matar, no fim das contas, resolve pouca coisa.",shape=box,color=blue];
		j2616763931 -> j2235205033;
	j644035199 [label="Além disso, não adiantaria nada fazer isso, não é mesmo? Se há uma única coisa que se aprende com a guerra, é que, no fim das contas, matar resolve pouca coisa.",shape=box,color=blue];
		j644035199 -> j2235205033;
	j329454096 [label="Compreendo seu ódio pelos Orokin. Acredite em mim. A maioria dos Orokin desprezava os Orokin. Não ignoro nossos crimes. As atrocidades que cometemos. ",shape=box,color=blue];
		j329454096 -> j4194569072;
	j679586169 [label="Por mais prazeroso que seja nutrir o desejo de cometer um pouco disso de vez em quando.",shape=box,color=blue];
		j679586169 -> j3214606927;
