	2446 [label="O nome dele é único para você.",shape=box,color=blue];
		2446 -> 2451;
	2448 [label="Não abuse da sorte, Usurpador. \"Agradável\" é um exagero. É mais que você está me conquistando aos poucos. Igual mofo.",shape=box,color=blue];
		2448 -> 2453;
	2447 [label="\"Alegria?\" Seria isso? Nunca imaginei que fosse tão masoquista. Hmm… ou será simplesmente a sensação do meu corpo se deteriorando e a impressão de que vocês estão \"me conquistando\"?",shape=box,color=blue];
		2447 -> 2452;
	2449 [label="É até agradável ter alguém com quem conversar. Mesmo que vocês sejam, como você mesmo disse, irritantes de vez em quando.",shape=box,color=blue];
		2449 -> 2454;
	2450 [label="Solidão? Bah. A única coisa que vocês afastam é a tentativa de sanidade de retornar à minha vida. Se vocês estão tentando insinuar que estão \"me conquistando\", sabe o que mais faria isso?",shape=box,color=blue];
		2450 -> 2455;
	2451 [label="Mas não até às estrelas.",shape=box,color=blue];
		2451 -> 2456;
	2453 [label="+5 Chemistry",color=orange];
