	j3607068861 [label="Não quero parecer superficial e grosseiro, mas… você já se olhou no espelho?",shape=box,color=red];
		j3607068861 -> j3934913078;
	j50078121 [label="Roathe… você pode não acreditar em mim, mas… eu te amo",shape=box,color=red];
		j50078121 -> j3072757972;
	j4035461529 [label="Você pode não acreditar em mim, mas eu me importo com você",shape=box,color=red];
		j4035461529 -> j4126191299;
	j3934913078 [label="+10 Chemistry",color=orange];
		j3934913078 -> j3422172791;
	j3072757972 [label="Oi?",shape=box,color=blue];
		j3072757972 -> j1782955667;
	j4126191299 [label="Tenho certeza de que há um fundo de sinceridade no que você diz. Ou, no mínimo, acredito que você desconhece a própria ilusão.",shape=box,color=blue];
		j4126191299 -> j496940218;
	j3422172791 [label="A honestidade é uma coisa maravilhosa, meu caro Peregrino. Você acha que eu o envergonharia por se divertir? De jeito nenhum.",shape=box,color=blue];
		j3422172791 -> j2709087093;
	j1782955667 [label="Não… certamente você está brincando?",shape=box,color=blue];
		j1782955667 -> j4146254828;
	j496940218 [label="Acredito que a maior conquista do Império Orokin foi sua capacidade de convencer seus membros a acreditarem em suas próprias ilusões.",shape=box,color=blue];
		j496940218 -> j2794163139;
	j2709087093 [label="Um brinde, a um relacionamento de satisfação mútua.",shape=box,color=blue];
		j2709087093 -> j3921499284;
	j4146254828 [label="Mas por que fazer tal acordo? A menos que…",shape=box,color=blue];
		j4146254828 -> j1008433288;
		j4146254828 -> j1800658339;
	j2794163139 [label="Na verdade, talvez esse seja o verdadeiro tecido conjuntivo da raça humana: nossa magistral capacidade de nos olharmos no espelho e nos enganarmos.",shape=box,color=blue];
		j2794163139 -> j3520569645;
	j3921499284 [label="Boolean RoatheUnloved4 is now true.",color=orange];
		j3921499284 -> j2965571546;
	j1008433288 [label="Eu estraguei tudo da última vez, não posso correr esse risco novamente",shape=box,color=red];
		j1008433288 -> j1442044643;
	j1800658339 [label="Fechei o acordo porque tava desesperado pra fazer isso direito",shape=box,color=red];
		j1800658339 -> j1442044643;
	j3520569645 [label="Tudo em nome de evitar a terrível vergonha de admitir quando precisamos mudar.",shape=box,color=blue];
