	j4054809389 [label="Que criaturinha incrivelmente peculiar você é. Delicioso, mas peculiar, querido Peregrino.",shape=box,color=blue];
		j4054809389 -> j4176710493;
	j4176710493 [label="Mas preciso perguntar. Por quê? Por que fazer um acordo tão absurdo? Você está tão curioso assim para provar a carne de um Orokin, depois de tantos séculos?",shape=box,color=blue];
		j4176710493 -> j3857720484;
	j3857720484 [label="Evaluate expressions",color=orange];
		j3857720484 -> j3607068861 [label="RoatheUnloved3",color=purple];
