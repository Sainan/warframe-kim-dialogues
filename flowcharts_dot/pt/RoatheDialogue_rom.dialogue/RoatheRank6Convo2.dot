	j2918760713 [label="Você entregou sua alma ao próprio diabo porque… ele, sem saber, já tinha seu coração partido.",shape=box,color=blue];
		j2918760713 -> j4236276379;
	j3250491684 [label="Não que eu soubesse alguma coisa sobre o assunto.",shape=box,color=blue];
		j3250491684 -> j4081414586;
	j2047399951 [label="Como você bem sabe, sou um tanto especialista no assunto.",shape=box,color=blue];
		j2047399951 -> j4081414586;
	j4236276379 [label="Peregrino… meu pobre e doce Peregrino…",shape=box,color=blue];
		j4236276379 -> j102879857;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j102879857 [label="Me perdoe. Por favor, me perdoe. Eu não sabia.",shape=box,color=blue];
		j102879857 -> j2829306106;
	j2829306106 [label="Você também precisa entender que, até agora, meu amor era uma mercadoria que ninguém havia buscado reivindicar. Não de uma forma significativa.",shape=box,color=blue];
		j2829306106 -> j235744320;
	j235744320 [label="Então você parecia disposto a vender sua alma por um único pedaço de sucata. Você pode imaginar minha confusão. Como fiquei perplexo.",shape=box,color=blue];
		j235744320 -> j760786771;
