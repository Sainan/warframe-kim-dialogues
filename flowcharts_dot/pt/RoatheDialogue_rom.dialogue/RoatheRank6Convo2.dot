		j2192890180 -> j4054809389;
	j1905408724 [label="A única coisa mais perigosa que um diabo… é um diabo com amigos como você, que lhe devem favores. Agora, licença? Tenho uma \"Irmã do Sol\" flutuante para importunar.",shape=box,color=blue];
		j1905408724 -> "Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j3941032937 [label="A única coisa mais perigosa que um diabo… é um diabo com amigos como você, que lhe devem favores. Agora, licença? Tenho um padre maluco para importunar.",shape=box,color=blue];
