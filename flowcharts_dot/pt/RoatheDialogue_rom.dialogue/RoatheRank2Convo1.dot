	j1905266750 [label="Bem Orokin de sua parte",shape=box,color=blue];
		j1905266750 -> j2368536612;
	j2626340950 [label="Por incrível que pareça, ainda prefiro ele à irmã. Pelo menos com ele dá para ter uma conversa.",shape=box,color=blue];
		j2626340950 -> j1344084253;
		j2626340950 -> j2685644958;
	j360724163 [label="Ela é simplesmente de uma hipocrisia absurda.",shape=box,color=blue];
		j360724163 -> j3196226533;
		j360724163 -> j2273651977;
	j1961001099 [label="Que, aliás, eles ainda estavam usando naquela maldita catedral! Sério…",shape=box,color=blue];
		j1961001099 -> j2502645407;
	j2775677471 [label="Mas como diz a pequena bajuladora flutuante? C'est la vie. Por falar nela, como estão as coisas? Imagino que o padre ainda não esteja falando com você.",shape=box,color=blue];
		j2775677471 -> j399472321;
