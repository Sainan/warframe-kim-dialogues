		j1876832257 -> j2986776847 [label="RoatheLyonConfessionDealNo",color=purple];
		j1876832257 -> j3201249645 [label="false",color=purple];
	j1769874056 [label="Lyon… está lidando com tanta coisa. E eu simplesmente não sei como chegar até ele",shape=box,color=red];
		j1769874056 -> j749735336;
	j3821954818 [label="Marie não enxerga o Entrati como ele realmente é. E eu simplesmente não consigo fazê-la enxergar a verdade, não importa o que eu tente",shape=box,color=red];
		j3821954818 -> j4007019955;
	j3094808293 [label="Bem, você tem toda essa… questão sobre o motivo de ter tomado o soro, e eu… estou sempre dizendo a coisa errada na hora errada",shape=box,color=red];
		j3094808293 -> j846894040;
	j1747162002 [label="Talvez seja um pouco constrangedor, mas… gosto muito de um de vocês três",shape=box,color=red];
		j1747162002 -> j2421214222;
		j1747162002 -> j2434633074;
		j1747162002 -> j3744245771;
	j2334241367 [label="Estou tentando convencer você e os outros a me ajudarem a reunir o Loid com a família lá de cima e… ainda não consegui…",shape=box,color=red];
		j2334241367 -> j2212958881;
	j2964372987 [label="Não, Lyon… não é de muitas palavras",shape=box,color=red];
		j2964372987 -> j1437566562;
	j1440980761 [label="Me dou bem com a Marie. Por que você a chama de bajuladora?",shape=box,color=red];
		j1440980761 -> j206730689;
	j399472321 [label="Parece que você não gosta muito deles. Por quê?",shape=box,color=red];
		j399472321 -> j1637916509;
	j3378182939 [label="Não. Sinto muito. Não faço acordos com Orokin. Nem antes, nem agora, nem nunca.",shape=box,color=red];
		j3378182939 -> j3299903721;
	j2131583490 [label="Sinceramente, espero que não me faça me arrepender disso, Roathe. Tudo bem, concordo.",shape=box,color=red];
		j2131583490 -> j1747875218;
	j2102662517 [label="\"Até agora.\" Intrigante. E será que estamos todos somente refazendo nossos passos, como cortesãos repetindo os movimentos de uma dança? De novo e de novo, condenados a nos repetir?",shape=box,color=blue];
		j2102662517 -> j3427499936;
		j2102662517 -> j2170370845;
	j3136803020 [label="Suponho que você saiba disso, não é? Interessante como tudo é previsível. É reconfortante saber que até mesmo alguém tão dilacerado quanto ele, ainda pode ser confiável ocasionalmente.",shape=box,color=blue];
		j3136803020 -> j3195559372;
	j585312350 [label="Você já não sabe disso? Hmm. Talvez você não tenha ido tão longe. Ou talvez você não tenha pensado em fazer a pergunta, nem na primeira vez, nem na milésima vez, durante essa pequena aventura.",shape=box,color=blue];
		j585312350 -> j3195559372;
	j590115148 [label="Ah. E mais uma coisa, antes que me esqueça?",shape=box,color=blue];
		j590115148 -> j2822645006;
	j1105017384 [label="Como você vendeu sua alma ao diabo duas vezes… fazendo um pacto para garantir que eu o leve para a minha cama? Ou você está de olho no meu coração, Usurpador? Hm. Veremos. Mas isso acontecerá.",shape=box,color=blue];
		j1105017384 -> j3493095593;
	j487988150 [label="Quando chegar a hora, garantirei que seu caminho esteja livre para cortejar nossa pequena bajuladora flutuante, Usurpador. Considere o assunto resolvido.",shape=box,color=blue];
		j487988150 -> j3493095593;
	j2960964432 [label="Quando chegar a hora, garantirei que seu caminho esteja livre para cortejar o pobre e decadente padre, Usurpador. Considere o assunto resolvido.",shape=box,color=blue];
		j2960964432 -> j1282577850;
	j2698849558 [label="Quando chegar a hora, lembrarei disso. Caso tenhamos mais alguma divergência sobre minhas memórias, não repetiremos seus erros anteriores.",shape=box,color=blue];
		j2698849558 -> j854835853;
	j1083543679 [label="Quando chegar a hora, eu me certificarei de que o pequeno mordomo suba aquelas escadas. Considere o assunto resolvido.",shape=box,color=blue];
		j1083543679 -> j3493095593;
	j2688398653 [label="Considere resolvido o seu problema com a Marie e sua adoração servil ao Entrati. Quando chegar a hora, cuidarei disso.",shape=box,color=blue];
		j2688398653 -> j1698479;
	j2986776847 [label="Considere o seu problema com o Lyon e seus tormentos resolvidos, Usurpador. Quando chegar a hora, cuidarei disso.",shape=box,color=blue];
		j2986776847 -> j606660727;
	j3201249645 [label="Eu… aparentemente esqueci o que você queria. A culpa é sua por brincar com as minhas memórias. O que era mesmo?",shape=box,color=blue];
		j3201249645 -> j2953660143;
	j749735336 [label="Eu recomendaria ter paciência, mas… longe de mim sugerir um cinzel quando uma picareta a laser está disponível bem ao seu lado.",shape=box,color=blue];
		j749735336 -> j2479515745;
	j4007019955 [label="Hm. Entendo. Uma empreitada nobre, sinceramente. Uma que tentei muitas e muitas vezes. E falhei da mesma forma.",shape=box,color=blue];
		j4007019955 -> j1611536828;
	j846894040 [label="Hm.",shape=box,color=blue];
		j846894040 -> j3815252096;
	j2421214222 [label="O Lyon",shape=box,color=red];
		j2421214222 -> j618064199;
	j2434633074 [label="Você…",shape=box,color=red];
		j2434633074 -> j1219921357;
	j3744245771 [label="A Marie",shape=box,color=red];
		j3744245771 -> j3130416029;
	j2212958881 [label="Hmm. Entendi. Eu lhe ofereci um acordo, e você não conseguiu cumprir a sua parte, então viu sua recompensa desaparecer de vista.",shape=box,color=blue];
		j2212958881 -> j3063431734;
	j1437566562 [label="Quando ele fala, geralmente se enquadra em duas categorias: terrivelmente insensato ou terrivelmente insano.",shape=box,color=blue];
		j1437566562 -> j1963585039;
	j206730689 [label="Hm? Você conseguiu escapar até agora? Que inveja de você. Mas logo a explosão lhe atingirá, então é melhor estar alerta para isso.",shape=box,color=blue];
		j206730689 -> j2421340482;
	j1637916509 [label="Meu pobre Peregrino. Você se esqueceu de como nós, Orokin, rejeitávamos qualquer forma de divindade sagrada? A única coisa que adorávamos éramos nós mesmos.",shape=box,color=blue];
		j1637916509 -> j2410617480;
	j3299903721 [label="Como desejar. Mas só um aviso, esta sua decisão não poderá ser desfeita sem consequências.",shape=box,color=blue];
		j3299903721 -> j1497842914;
	j1747875218 [label="Você vai se comportar e me ajudar a convencer o Loid a se reconciliar com a família? Em troca, te ajudo com suas memórias",shape=box,color=red];
		j1747875218 -> j808910262;
	j3427499936 [label="Não significa que você não tem autonomia, só que algumas coisas exigem mais tentativas",shape=box,color=red];
		j3427499936 -> j330507744;
	j2170370845 [label="Espero que isso não te aborreça",shape=box,color=red];
		j2170370845 -> j3423851311;
	j3195559372 [label="Estamos todos realmente condenados a nos repetir, como cortesãos repetindo os movimentos de uma dança?",shape=box,color=blue];
		j3195559372 -> j3427499936;
		j3195559372 -> j2170370845;
	j2822645006 [label="Há pouco tempo, confiei a você uma verdade terrível. Agora, já não me lembro o porquê.",shape=box,color=blue];
		j2822645006 -> j2848189303;
	j3493095593 [label="Boolean RoatheFamilyDealNo is now false.",color=orange];
		j3493095593 -> j2115904057;
	j1282577850 [label="Boolean RoatheLyonDatingDealNo is now false.",color=orange];
		j1282577850 -> j2912343570;
	j854835853 [label="Boolean RoatheSerumDealNo is now false.",color=orange];
		j854835853 -> j4088764595;
	j1698479 [label="Boolean RoatheMarieEntratiDealNo is now false.",color=orange];
		j1698479 -> j2185907731;
	j606660727 [label="Boolean RoatheLyonConfessionDealNo is now false.",color=orange];
		j606660727 -> j1686181139;
	j2479515745 [label="Creio que também estou começando a entender por que você apagou nossas memórias. Vendo todas as suas tentativas e fracassos… por que não recomeçar do zero?",shape=box,color=blue];
		j2479515745 -> j2365565318;
	j1611536828 [label="Ao perceber, com frustração, que não conseguia mais convencê-la da simples realidade das coisas, você recorreu a usar este… dom que possui.",shape=box,color=blue];
		j1611536828 -> j2926140647;
	j3815252096 [label="Não gosto que você esteja poluindo minha mente para corrigir seus erros, Peregrino. No entanto, o fato de você estar tentando fazer isso por minha causa é… bem, quase aceitável.",shape=box,color=blue];
		j3815252096 -> j3786763677;
	j618064199 [label="Boolean DrifterLyon is now true.",color=orange];
		j618064199 -> j3327532036;
	j1219921357 [label="Boolean DrifterRoathe is now true.",color=orange];
		j1219921357 -> j840683482;
	j3130416029 [label="Boolean DrifterMarie is now true.",color=orange];
		j3130416029 -> j129911060;
	j3063431734 [label="Então, sabendo que o que antes estava ao seu alcance agora era inatingível, você recorreu a usar este… dom que possui.",shape=box,color=blue];
		j3063431734 -> j1905266750;
	j1963585039 [label="Saber qual você vai receber é como jogar cara ou coroa, e eu nunca consigo decidir qual prefiro.",shape=box,color=blue];
		j1963585039 -> j2626340950;
	j2421340482 [label="Aquela mulher é incansável em sua devoção inabalável e obsessiva a Albrecht. Eu diria que o mordomo deveria se preocupar, mas, honestamente, acredito firmemente que se trata de uma devoção inocente. E isso vindo de mim.",shape=box,color=blue];
		j2421340482 -> j360724163;
	j2410617480 [label="Aqueles dois fanáticos não conseguem ficar dois minutos sem mencionar \"Sol\" isso ou \"Lua\" aquilo, ou sem tentar abençoar o penico.",shape=box,color=blue];
		j2410617480 -> j1961001099;
	j1497842914 [label="Boolean RoatheFamilyFail is now true.",color=orange];
		j1497842914 -> j2775677471;
	j808910262 [label="+5 Chemistry",color=orange];
		j808910262 -> j1851366613;
	j330507744 [label="Seu otimismo me mantém entretido. Heróis. É só isso que vocês são, juro. Sacos de carne e osso inflados e movidos puramente por otimismo e esperança. É de doer os dentes.",shape=box,color=blue];
		j330507744 -> j3541932656;
	j3423851311 [label="Não, você me entendeu mal. De certa forma, acho isso reconfortante. Significa que, mesmo quando nos reduzem aos nossos componentes mais básicos, permanecemos os mesmos. Não podemos mudar.",shape=box,color=blue];
		j3423851311 -> j2631304166;
	j2848189303 [label="Você é a única pessoa em quem desejei confiar… e, ao mesmo tempo, a razão pela qual já não me lembro por que ousei fazer isso.",shape=box,color=blue];
		j2848189303 -> j3108999742;
