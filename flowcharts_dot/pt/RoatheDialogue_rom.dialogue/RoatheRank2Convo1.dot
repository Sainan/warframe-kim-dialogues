		645 -> 670;
	646 [label="Você já não sabe disso? Hmm. Talvez você não tenha ido tão longe. Ou talvez você não tenha pensado em fazer a pergunta, nem na primeira vez, nem na milésima vez, durante essa pequena aventura.",shape=box,color=blue];
