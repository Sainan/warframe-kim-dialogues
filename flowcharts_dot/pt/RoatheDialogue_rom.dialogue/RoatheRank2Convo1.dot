		j2694130358 -> j2075111951 [label="false",color=purple];
	j2268577747 [label="Do meu ponto de vista, é um desafio bastante peculiar operar somente com parte das minhas memórias intactas, sabendo que você detém a outra metade das cartas na mão.",shape=box,color=blue];
		j2268577747 -> j1743218733;
	j3645283426 [label="Mas toda essa… discussão repetitiva? É uma completa perda de tempo. Então vamos lá. Basta dizer. E seu problema estará resolvido.",shape=box,color=blue];
		j3645283426 -> j2708346007;
		j3645283426 -> j1340750999;
	j3827885707 [label="Diga-me o que quer e vamos chegar a um acordo. Toda essa… discussão repetitiva é uma completa perda de tempo.",shape=box,color=blue];
		j3827885707 -> j2953660143;
	j2075111951 [label="Evaluate expressions",color=orange];
		j2075111951 -> j1704588826 [label="RoatheDeal",color=purple];
		j2075111951 -> j392810663 [label="RoatheNoDeal",color=purple];
		j2075111951 -> j392810663 [label="false",color=purple];
	j1743218733 [label="Então, vou continuar, já que não tenho nada melhor para fazer. \"A propósito, como estão as coisas com a nossa pequena bajuladora flutuante? Imagino que o padre ainda não esteja falando com você.\" Bah. Que farsa.",shape=box,color=blue];
		j1743218733 -> j1889707942;
		j1743218733 -> j1057043394;
		j1743218733 -> j645655263;
	j2708346007 [label="Não. Sinto muito. Não faço acordos com Orokin. Nem antes, nem agora, nem nunca.",shape=box,color=red];
		j2708346007 -> j1994859786;
	j1340750999 [label="Sinceramente, espero que não me faça me arrepender disso, Roathe. Tudo bem, concordo. Preciso da sua ajuda.",shape=box,color=red];
		j1340750999 -> j1876832257;
	j2953660143 [label="Check boolean LoidFamilyComplete",color=orange];
