		j4145027134 -> j3866645924;
	j673736628 [label="Que coisa mais encantadora! Não me surpreende nem um pouco! E o que me importa se é verdade ou não?! Além disso, está…",shape=box,color=blue];
		j673736628 -> j1472979686;
	j1472979686 [label="Errado! Absolutamente, extraordinariamente, sublimemente errado! Não fale comigo como se conhecesse as nuances de uma raiva que, claramente, você é incapaz de compreender.",shape=box,color=blue];
		j1472979686 -> j527639375;
	j4261616118 [label="Não ouse me dizer o que é e o que não é valioso na minha mente, Peregrino. Você não tem o direito de se apropriar do que me pertence.",shape=box,color=blue];
		j4261616118 -> j527639375;
	j45886739 [label="Os humanos são rápidos em ignorar aqueles que não desejam ver. Além disso, como um \"Protoframe\" e um membro da elite Orokin treinado para o combate, sou perfeitamente capaz de furtar alguns doces do mercado sem levantar suspeitas.",shape=box,color=blue];
		j45886739 -> j4202875018;
	j1362806940 [label="Sim, com a pele azul, a cauda, a carne infestada e tudo mais. É impressionante o que uma capa, um chapéu e uma máscara podem fazer.",shape=box,color=blue];
		j1362806940 -> j4202875018;
	j2684456103 [label="Eles gritam e berram comigo sobre pecado e a necessidade do arrependimento, sem acrescentarem \"que estou mentindo de novo sobre a minha versão da história\".",shape=box,color=blue];
		j2684456103 -> j2331545145;
		j2684456103 -> j1164269677;
		j2684456103 -> j843617480;
		j2684456103 -> j4261513941;
	j4202875018 [label="Boolean RoatheMariePastry1 is now true.",color=orange];
		j4202875018 -> j3735279544;
		j4202875018 -> j4111700410;
	j3735279544 [label="Mas você trazia o suficiente pra Marie e o Lyon também?",shape=box,color=red];
		j3735279544 -> j1344083891;
	j4111700410 [label="Então você simplesmente roubava os doces",shape=box,color=red];
		j4111700410 -> j3679540094;
	j1344083891 [label="Ah. Você esperava que eu, o quê, pegasse o suficiente só para mim e os deixasse sem nada? Ora, simplesmente porque não gosto da companhia deles e quero me livrar dos dois?",shape=box,color=blue];
		j1344083891 -> j1425004306;
	j3679540094 [label="Tudo naquele planeta em breve pertenceria ao Império Orokin. Portanto, já era meu por direito.",shape=box,color=blue];
		j3679540094 -> j2815812299;
	j1425004306 [label="Você acha que minha aversão pelos dois de alguma forma implica que eu também seja cruel com eles. Porque sou um diabo e, portanto, inclinado a tais atos, é esse o seu raciocínio.",shape=box,color=blue];
		j1425004306 -> j3753573545;
	j2815812299 [label="Além disso, eu não tinha dinheiro. O que você queria que eu fizesse?",shape=box,color=blue];
		j2815812299 -> j1150787601;
	j3753573545 [label="Que decepção! Atitudes tão superficiais assim são reservadas para pessoas extremamente entediantes e valentões de escola ",shape=box,color=blue];
		j3753573545 -> j1520077106;
	j1150787601 [label="E eu sei que você saqueia navios e pega tudo o que precisa ou deseja - não me olhe com esses seus olhos inocentes, Usurpador.",shape=box,color=blue];
		j1150787601 -> j4261401374;
		j1150787601 -> j793311165;
	j1520077106 [label="Eu os detesto. Ainda assim, tenho que conviver com eles. Não quero que sejam privados de um doce bobo. É só um doce. Por que piorar as coisas desnecessariamente?",shape=box,color=blue];
		j1520077106 -> j2806828177;
		j1520077106 -> j2475789976;
		j1520077106 -> j3659169881;
	j4261401374 [label="Deixa pra lá",shape=box,color=red];
		j4261401374 -> j896358057;
	j793311165 [label="Bom ponto",shape=box,color=red];
		j793311165 -> j3695608827;
	j2806828177 [label="Ou você pode tentar ser gentil com eles sem nenhum motivo específico",shape=box,color=red];
		j2806828177 -> j2480593328;
	j2475789976 [label="Só pra entender aqui: você tava sendo gentil porque odeia eles",shape=box,color=red];
		j2475789976 -> j3252096295;
	j3659169881 [label="É… nunca tinha pensado desse jeito",shape=box,color=red];
		j3659169881 -> j1171594634;
	j896358057 [label="Fantástico. Mais um que é incapaz de admitir que está errado. Como se os fanáticos já não fossem o suficiente, gritando comigo a toda hora, implorando para que eu me arrependa.",shape=box,color=blue];
		j896358057 -> j2331545145;
		j896358057 -> j1164269677;
		j896358057 -> j843617480;
		j896358057 -> j4261513941;
	j3695608827 [label="+5 Chemistry",color=orange];
		j3695608827 -> j3693211555;
	j2480593328 [label="Certo, experimente tê-los zumbindo em seus ouvidos o tempo todo, dia e noite, amaldiçoando seu nome e implorando para que você se arrependa.",shape=box,color=blue];
		j2480593328 -> j2331545145;
		j2480593328 -> j1164269677;
		j2480593328 -> j843617480;
		j2480593328 -> j4261513941;
	j3252096295 [label="Exatamente. O que é tão difícil de entender? E eu percebo que você está sendo sarcástico, Usurpador. Mas não se preocupe, isso me diverte.",shape=box,color=blue];
		j3252096295 -> j683441714;
	j1171594634 [label="+5 Chemistry",color=orange];
		j1171594634 -> j2605529357;
	j3693211555 [label="Agradeço por isso. Finalmente, alguém que sabe admitir quando está errado! Se aqueles dois fanáticos fizessem o mesmo, eu não teria que aturá-los gritando comigo a qualquer hora, implorando pelo meu arrependimento.",shape=box,color=blue];
		j3693211555 -> j2331545145;
		j3693211555 -> j1164269677;
		j3693211555 -> j843617480;
		j3693211555 -> j4261513941;
	j683441714 [label="Pelo menos é melhor do que a pregação repugnante e eterna dos fanáticos - constantemente me amaldiçoando e clamando para que eu me arrependa.",shape=box,color=blue];
		j683441714 -> j2331545145;
		j683441714 -> j1164269677;
		j683441714 -> j843617480;
		j683441714 -> j4261513941;
	j2605529357 [label="Que alívio encontrar alguém que consegue mudar de opinião. Se aqueles dois fanáticos fizessem o mesmo, eu não teria que aturá-los gritando comigo a qualquer hora, implorando pelo meu arrependimento.",shape=box,color=blue];
		j2605529357 -> j2331545145;
		j2605529357 -> j1164269677;
		j2605529357 -> j843617480;
		j2605529357 -> j4261513941;
}