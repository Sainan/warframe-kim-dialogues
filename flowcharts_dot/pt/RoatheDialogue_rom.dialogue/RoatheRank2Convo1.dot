		j2953660143 -> j1747162002 [label=false,color=brown];
		j2953660143 -> j2334241367 [label=false,color=brown];
	j1704588826 [label="Como estão as coisas com a nossa pequena bajuladora flutuante? Imagino que o padre ainda não esteja falando com você.",shape=box,color=blue];
		j1704588826 -> j2964372987;
		j1704588826 -> j1440980761;
		j1704588826 -> j399472321;
	j392810663 [label="Diga-me, você reconsiderou a minha proposta? Esta será sua última chance, Usurpador. Sou um diabo paciente, mas não gosto de ficar por aí segurando portas abertas como um tolo.",shape=box,color=blue];
		j392810663 -> j3378182939;
		j392810663 -> j2131583490;
	j1889707942 [label="Até agora, estou me dando bem com a Marie",shape=box,color=red];
		j1889707942 -> j2102662517;
	j1057043394 [label="Não, mas ele vai mudar de ideia",shape=box,color=red];
		j1057043394 -> j3136803020;
	j645655263 [label="Parece que você não gosta muito deles. Por quê?",shape=box,color=red];
		j645655263 -> j585312350;
	j1994859786 [label="Como desejar. Mas só um aviso, esta foi sua última oportunidade. Agora você está por sua conta.",shape=box,color=blue];
		j1994859786 -> j590115148;
	j1876832257 [label="Evaluate expressions",color=orange];
		j1876832257 -> j1105017384 [label="RoatheDatingDealNo",color=purple];
