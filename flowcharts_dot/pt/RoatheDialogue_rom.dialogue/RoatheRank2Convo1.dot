	j3463830391 [label="Acho terrivelmente fascinante que tenha conspirado comigo para… traçar meu próprio caminho. O diabo, afinal, negocia com a própria carne.",shape=box,color=blue];
		j3463830391 -> j2268577747;
	j1346106785 [label="Como estão os progressos do seu lado, meu Usurpador? Sigo ajustando o tabuleiro a seu favor, mesmo que você ainda não veja ou sinta o movimento das peças.",shape=box,color=blue];
		j1346106785 -> j2268577747;
	j967794911 [label="Diga-me que reconsiderou a minha proposta. Onde antes representava uma barreira às suas… aspirações românticas? Agora, serei tão dócil quanto um terrisk da neve. Hmm. A menos, é claro, que não seja isso o que deseja. Você decide.",shape=box,color=blue];
		j967794911 -> j3645283426;
	j411364835 [label="Diga-me que reconsiderou a minha proposta. Posso resolver esse problema com a Marie para você. Assegurar que você alcance suas aspirações românticas com ela sem dificuldades.",shape=box,color=blue];
		j411364835 -> j3645283426;
	j356342854 [label="Diga-me que reconsiderou a minha proposta. Posso resolver esse problema com o Lyon para você. Assegurar que você alcance suas aspirações românticas com ele sem dificuldades.",shape=box,color=blue];
		j356342854 -> j3645283426;
	j3278025692 [label="Diga-me que reconsiderou a minha proposta. Onde antes representava uma barreira aos seus questionamentos em relação à minha… ingestão do soro? Agora, serei tão dócil quanto um terrisk da neve.",shape=box,color=blue];
		j3278025692 -> j3645283426;
	j1790552710 [label="Diga-me que reconsiderou a minha proposta. Onde antes representava uma barreira à reunião do mordomo e sua família? Agora, serei tão dócil quanto um terrisk da neve.",shape=box,color=blue];
		j1790552710 -> j3645283426;
	j3824744376 [label="Diga-me que reconsiderou a minha proposta. Posso resolver esse problema com a Marie para você. Assegurar que você conduza suas conversas com ela sem dificuldades.",shape=box,color=blue];
		j3824744376 -> j3645283426;
	j3067530094 [label="Diga-me que reconsiderou a minha proposta. Posso resolver esse problema com o Lyon para você. Assegurar que você conduza suas conversas com ele sem dificuldades.",shape=box,color=blue];
		j3067530094 -> j3645283426;
	j3925483067 [label="Não posso deixar de pensar que você está prolongando nossas conversas por algum motivo, Usurpador. E que talvez haja algo em que possa lhe ajudar.",shape=box,color=blue];
		j3925483067 -> j3827885707;
	j2694130358 [label="Evaluate expressions on HellStory counter",color=orange];
