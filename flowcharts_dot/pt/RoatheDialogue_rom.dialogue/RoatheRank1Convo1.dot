digraph {
	"RoatheRank1Convo1 begins." [color=orange];
		"RoatheRank1Convo1 begins." -> j3998890108;
	j3998890108 [label="Evaluate expressions on HellStory counter",color=orange];
		j3998890108 -> j1112473619 [label="x >= 21",color=purple];
		j3998890108 -> j1534778170 [label="x >= 6",color=purple];
		j3998890108 -> j96499057 [label="x < 6",color=purple];
		j3998890108 -> j96499057 [label="false",color=purple];
	j1112473619 [label="Admiro muito a sua audácia! Sinceramente, você tem certeza de que não é um Orokin disfarçado? Talvez esteja escondendo sua pele azul-celeste para não alertar os outros?! ",shape=box,color=blue];
		j1112473619 -> j3342657208;
		j1112473619 -> j1647849448;
		j1112473619 -> j2730136800;
	j1534778170 [label="Boolean RoatheResetEdgeCase is now true.",color=orange];
		j1534778170 -> j96499057;
	j96499057 [label="A anomalia nascida do Void. \"O Peregrino.\" O Usurpador. Finalmente, podemos conversar. Venha, o Diabo tem uma proposta…",shape=box,color=blue];
		j96499057 -> j2212754471;
		j96499057 -> j3212599030;
		j96499057 -> j3568537545;
		j96499057 -> j4168933486;
	j3342657208 [label="Oi, Roathe",shape=box,color=red];
		j3342657208 -> j1247547890;
	j1647849448 [label="Do que exatamente você tá me acusando?",shape=box,color=red];
		j1647849448 -> j145823468;
	j2730136800 [label="Oi?",shape=box,color=red];
		j2730136800 -> j145823468;
	j2212754471 [label="Usurpador?",shape=box,color=red];
		j2212754471 -> j1001119225;
	j3212599030 [label="Que tipo de… proposta?",shape=box,color=red];
		j3212599030 -> j1776481711;
	j3568537545 [label="Que tipo de proposta o \"Diabo de Tau\" pode ter pra mim?",shape=box,color=red];
		j3568537545 -> j4240936255;
	j4168933486 [label="Oi, Roathe",shape=box,color=red];
		j4168933486 -> j2374441145;
	j1247547890 [label="Ah, ótimo! Então você sabe meu nome! Estava certo de que você tinha perdido essa informação de alguma forma, já que estava claramente muito ocupado me massacrando sem parar! ",shape=box,color=blue];
		j1247547890 -> j3501679650;
	j145823468 [label="Você realmente não tem mais o que fazer?! Ou será que jogar infinitas rodadas de \"Prenda o Chifre no Yaznak\" é mesmo a melhor maneira de usar seu tempo?! ",shape=box,color=blue];
		j145823468 -> j3501679650;
	j1001119225 [label="Boolean RoatheUsurper is now true.",color=orange];
		j1001119225 -> j1486295632;
	j1776481711 [label="Hmm, não precisa se preocupar… ou se entusiasmar. Ainda. Trata-se somente de um acordo comercial entre 2 pessoas que têm muito a ganhar com a outra.",shape=box,color=blue];
		j1776481711 -> j2374441145;
	j4240936255 [label="+5 Chemistry",color=orange];
		j4240936255 -> j4237524460;
	j2374441145 [label="Agora, preste atenção. Aqueles dois fanáticos têm sido terrivelmente e dolorosamente irritantes em suas constantes críticas a mim. Espero que você esteja acima desse tipo de comportamento. ",shape=box,color=blue];
		j2374441145 -> j2972175609;
		j2374441145 -> j3948587354;
	j3501679650 [label="Tenho muita dificuldade em acreditar que tudo isso… toda essa injustiça que sofri nas suas mãos, toda essa destruição da minha mente… não seja uma maldade cometida em seu nome!",shape=box,color=blue];
		j3501679650 -> j1936848751;
		j3501679650 -> j395447372;
		j3501679650 -> j945476195;
	j1486295632 [label="+5 Chemistry",color=orange];
		j1486295632 -> j165866218;
	j4237524460 [label="Vejo que minha reputação me precede. Ótimo. Isso poupará tempo. ",shape=box,color=blue];
		j4237524460 -> j2418384383;
	j2972175609 [label="Não recebo ordens de você",shape=box,color=red];
		j2972175609 -> j4026548805;
	j3948587354 [label="Vou ver o que dá pra fazer",shape=box,color=red];
		j3948587354 -> j3226538091;
	j1936848751 [label="É que não parecia ser… prioridade?",shape=box,color=red];
		j1936848751 -> j863830266;
	j395447372 [label="Eu… só não tive tempo pra fazer isso antes",shape=box,color=red];
		j395447372 -> j4011386742;
	j945476195 [label="Você não lembra… mas já falamos sobre isso",shape=box,color=red];
		j945476195 -> j953405478;
	j165866218 [label="Ah! É o que você é, não é? Os Tennos usurparam o Sistema de Origem dos Orokin. E você, como um pequeno impostor no ninho, invadiu este mundo vindo do seu próprio. ",shape=box,color=blue];
		j165866218 -> j1800120001;
	j2418384383 [label="E não precisa se preocupar ou se entusiasmar… ainda. Trata-se somente de um acordo comercial entre duas pessoas que têm muito a ganhar com a outra. ",shape=box,color=blue];
		j2418384383 -> j2374441145;
	j4026548805 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4026548805 -> j3479173973 [label="x >= 21",color=purple];
		j4026548805 -> j3572518514 [label="x >= 1",color=purple];
		j4026548805 -> j2049317904 [label="x <= 0",color=purple];
		j4026548805 -> j2049317904 [label="false",color=purple];
	j3226538091 [label="Faça o que falei.",shape=box,color=blue];
		j3226538091 -> j1769433652;
	j863830266 [label="Não parecia ser?!",shape=box,color=blue];
		j863830266 -> j2517491906;
	j4011386742 [label="Ah! Não queria incomodar, não me dei conta de que os horários na sua agenda já estavam todos reservados!",shape=box,color=blue];
		j4011386742 -> j2413663105;
	j953405478 [label="+5 Chemistry",color=orange];
		j953405478 -> j3716075584;
	j1800120001 [label="E isso faz de você, na minha visão, um usurpador por pelo menos dois motivos. (E talvez por um terceiro, se incluirmos o que o mordomo me contou sobre Duviri, mas isso é assunto para outra hora)",shape=box,color=blue];
		j1800120001 -> j2374441145;
	j3479173973 [label="Você já fez questão de deixar isso bem claro, obrigado.",shape=box,color=blue];
		j3479173973 -> j1769433652;
	j3572518514 [label="Você deixou isso bem claro.",shape=box,color=blue];
		j3572518514 -> j1769433652;
	j2049317904 [label="Veremos… ",shape=box,color=blue];
		j2049317904 -> j1769433652;
	j1769433652 [label="Então, a proposta é simples, meu encantador e excêntrico novo \"amigo\".",shape=box,color=blue];
		j1769433652 -> j1071362491;
	j2517491906 [label="Não parecia ser uma prioridade?!",shape=box,color=blue];
		j2517491906 -> j4113307385;
	j2413663105 [label="Sério. Estou em choque. Seus modos são absolutamente condenáveis, Peregrino.",shape=box,color=blue];
		j2413663105 -> j3917687621;
	j3716075584 [label="Como assim? E como exatamente eu poderia ter me esquecido de você vasculhando meus pensamentos como a Taça de Malium em uma festa de Naberus! ",shape=box,color=blue];
		j3716075584 -> j1588496717;
		j3716075584 -> j3583494568;
	j1071362491 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1071362491 -> j431126911 [label="x >= 21",color=purple];
		j1071362491 -> j2392761791 [label="x >= 1",color=purple];
		j1071362491 -> j1666860901 [label="x <= 0",color=purple];
		j1071362491 -> j1666860901 [label="false",color=purple];
	j4113307385 [label="Você costuma vasculhar as memórias alheias, destruindo suas representações, sem ao menos se preocupar em conhecê-las antes?! ",shape=box,color=blue];
		j4113307385 -> j373188480;
	j3917687621 [label="Mas creio que não há nada a ser feito agora. Você sabe a verdade. Estou completamente exposto diante de você, em toda a minha abominável covardia. ",shape=box,color=blue];
		j3917687621 -> j2150700160;
	j1588496717 [label="Pra resumir, tem… uma Infestação que parece se estender aos soros dos Protoframes…",shape=box,color=red];
		j1588496717 -> j1325785361;
	j3583494568 [label="Ah… hmmm… então… eu consigo… viajar no tempo",shape=box,color=red];
		j3583494568 -> j1325785361;
	j431126911 [label="Como você já vasculhou minha mente como um bêbado descontrolado em uma vidraçaria, preciso da sua ajuda para tentar decifrar o que tudo isso significa. ",shape=box,color=blue];
		j431126911 -> j413463718;
	j2392761791 [label="Você e aqueles dois fanáticos já vasculharam minha mente como bêbados descontrolados em uma vidraçaria. Eu preciso da sua ajuda para tentar decifrar o que tudo isso significa. ",shape=box,color=blue];
		j2392761791 -> j413463718;
	j1666860901 [label="Quando o Albrecht enfiou a seringa no meu pescoço e me transformou… nisso, ele fez algo a mais. Jogos entre os Orokin são uma coisa, mas isso? Isso é completamente diferente.",shape=box,color=blue];
		j1666860901 -> j2661010573;
	j373188480 [label="Seus modos são absolutamente condenáveis!",shape=box,color=blue];
		j373188480 -> j3917687621;
	j2150700160 [label="Imagino que você tenha vindo aqui somente para zombar de mim. Aproveite o quanto quiser agora, para podermos prosseguir sem interrupções após isso.",shape=box,color=blue];
		j2150700160 -> j3554367636;
	j1325785361 [label="E eu achei que funcionasse nos Protoframes em 1999 porque o próprio ano tava repetindo, mas não é o caso",shape=box,color=red];
		j1325785361 -> j2914407117;
	j413463718 [label="Não só preciso da sua ajuda para recuperar minhas memórias, como, além de tudo, parece que também sou incapaz de reconhecer a verdade por trás delas! ",shape=box,color=blue];
		j413463718 -> j3214524554;
		j413463718 -> j1448971332;
	j2661010573 [label="Ele roubou muitas das minhas memórias. Eu vejo essa pequena… versão de você, vagando por aí com todos os seus amigos Tennos traumatizados. Eu vejo o que a Lótus está ajudando aquela coisa a recuperar.",shape=box,color=blue];
		j2661010573 -> j1272314399;
		j2661010573 -> j859021251;
	j3554367636 [label="Prefiro não ter que lidar com isso me atrapalhando constantemente, como se fosse um Kubrow de estimação de alguma artista que não para de perturbar.",shape=box,color=blue];
		j3554367636 -> j351373991;
		j3554367636 -> j4145466671;
	j2914407117 [label="Acho que… tem mais a ver com a própria Infestação? Tem uma guitarra falante que meio que insinuou algo assim. E você viajou até aqui num Helminte, não foi? 
",shape=box,color=red];
		j2914407117 -> j2732860222;
	j3214524554 [label="Então tá querendo dizer que… só precisa de alguém pra conversar?",shape=box,color=red];
		j3214524554 -> j525845553;
	j1448971332 [label="Fico feliz em ajudar, mas não sei bem como",shape=box,color=red];
		j1448971332 -> j932648019;
	j1272314399 [label="Então… por que você não entra no Refratário Obscuro por conta própria?",shape=box,color=red];
		j1272314399 -> j453386630;
	j859021251 [label="A criança não é uma \"coisa\"",shape=box,color=red];
		j859021251 -> j1983602103;
	j351373991 [label="Você fugiu, mas muita gente foge. Tu tem que encarar o que aconteceu",shape=box,color=red];
		j351373991 -> j3921548128;
	j4145466671 [label="Não vou ficar zombando, você só escolheu lutar outro dia",shape=box,color=red];
		j4145466671 -> j1156993601;
	j2732860222 [label="Você parece bastante inseguro sobre toda essa conversa, Peregrino. Especialmente quando se trata do conteúdo do meu crânio.",shape=box,color=blue];
		j2732860222 -> j1573535804;
	j525845553 [label="Ah, não faça isso parecer que simplesmente preciso me deitar em um divã e divagar sobre meus \"sentimentos\". ",shape=box,color=blue];
		j525845553 -> j932648019;
	j932648019 [label="Preciso de alguém para operar a máquina de acordo com as minhas instruções, pois atualmente não consigo fazer isso sozinho.",shape=box,color=blue];
		j932648019 -> j3939895929;
	j453386630 [label="Eu mesmo faria isso, acredite, mas não consigo! O maldito soro do Protoframe com que o Albrecht me envenenou removeu qualquer capacidade que eu tivesse de operar aquela maldita máquina!",shape=box,color=blue];
		j453386630 -> j1688491648;
	j1983602103 [label="Garanto que é uma \"coisa\" sim.",shape=box,color=blue];
		j1983602103 -> j1888577682;
	j3921548128 [label="Add 1 to Thermostat counter",color=orange];
		j3921548128 -> j2939653167;
	j1156993601 [label="Add -1 to Thermostat counter",color=orange];
		j1156993601 -> j2664593170;
	j1573535804 [label="E sim. Eu cheguei aqui com a ajuda de um Helminte. Que eu mesmo criei e cuidei, obrigado. Agora, você quer dizer que… apagou minhas memórias?! De quê, das nossas conversas?! ",shape=box,color=blue];
		j1573535804 -> j1134118608;
	j3939895929 [label="Também preciso de ajuda para recuperar minhas memórias e organizá-las. Uma espécie de assistente temporário.",shape=box,color=blue];
		j3939895929 -> j954592061;
	j1688491648 [label="Além disso, não só preciso da sua ajuda para recuperar minhas memórias, como, para piorar a situação, também não consigo reconhecer a verdade por trás delas!",shape=box,color=blue];
		j1688491648 -> j3214524554;
		j1688491648 -> j1448971332;
	j1888577682 [label="E eu mesmo faria isso, acredite - mas não consigo! O maldito soro do Protoframe com que Albrecht me envenenou removeu qualquer capacidade que eu tivesse de operar aquela maldita máquina sozinho!",shape=box,color=blue];
		j1888577682 -> j1688491648;
	j2939653167 [label="Que maravilha. Mais uma mosca zumbindo no meu ouvido para me dizer que preciso de autorreflexão e arrependimento?",shape=box,color=blue];
		j2939653167 -> j4252861565;
	j2664593170 [label="+5 Chemistry",color=orange];
		j2664593170 -> j1288886137;
	j1134118608 [label="Porque, sem dúvida, tenho memórias perfeitamente preservadas de você me transformando em carne moída para seu próprio entretenimento sanguinário. Qual é o sentido disso?",shape=box,color=blue];
		j1134118608 -> j972704639;
		j1134118608 -> j1443286933;
	j954592061 [label="E em troca, você terá minha solene promessa de que permanecerei aqui… pacificamente. Não representarei nenhuma ameaça a ninguém, e lhe garanto… sou perfeitamente capaz disso. Não farei mal aos fanáticos. Nem ao mordomo. Nem aos animais do Albrecht corrompidos pelo Void.",shape=box,color=blue];
		j954592061 -> j1015590500;
	j4252861565 [label="Que sorte a minha.",shape=box,color=blue];
		j4252861565 -> j1497595352;
	j1288886137 [label="No momento, o que estou fazendo parece ser \"apodrecer em uma cripta com um par de fanáticos estúpidos e distribuir bugigangas para crianças traumatizadas pela guerra\".",shape=box,color=blue];
		j1288886137 -> j2973726764;
	j972704639 [label="Não sei, e não vim aqui pra continuar sendo insultado por você, Roathe. Não coloquei todo mundo nesse rolo só pra ficar ouvindo você reclamar",shape=box,color=red];
		j972704639 -> j3342681621;
	j1443286933 [label="Meu chute é que nossas conversas não são profundas. São memórias superficiais. O que descobrimos sobre o seu passado… fazia parte das suas memórias mais significativas, acho?",shape=box,color=red];
		j1443286933 -> j4103847787;
	j1015590500 [label="E o mais importante, não farei mal algum à família perturbada do Albrecht, que se encontra acima de nós como uma espécie de flora mutante – ignorando completamente a nossa presença.",shape=box,color=blue];
		j1015590500 -> j526826146;
		j1015590500 -> j2303458440;
		j1015590500 -> j1254858718;
	j1497595352 [label="Pretendo seguir com a minha vida, Peregrino, mas o fato é que você sabe demais sobre o meu passado e o que fiz. E vamos ter que simplesmente… conviver com isso.",shape=box,color=blue];
		j1497595352 -> j1743806100;
	j2973726764 [label="Mas deve ser assim que chamam hoje em dia.",shape=box,color=blue];
		j2973726764 -> j1497595352;
	j3342681621 [label="Sim. Posso arriscar um palpite sobre o motivo pelo qual você utilizou seus dons do Void para apagar nossas memórias de eventos recentes. Que previsível.",shape=box,color=blue];
		j3342681621 -> j1243611437;
	j4103847787 [label="Fantástico. Que coisa maravilhosa. Estou nas mãos de um lunático que tem a capacidade de apagar minhas memórias quando bem entende! Que adorável.",shape=box,color=blue];
		j4103847787 -> j1243611437;
	j526826146 [label="E tava achando que isso era uma proposta. Agora você tá me ameaçando?",shape=box,color=red];
		j526826146 -> j3020052946;
	j2303458440 [label="Roathe? Para e me escuta um minuto",shape=box,color=red];
		j2303458440 -> j3456050904;
	j1254858718 [label="O que você quer que eu faça?",shape=box,color=red];
		j1254858718 -> j874432270;
	j1743806100 [label="Tente não fazer disso um transtorno para mim e prometo que tentarei fazer o mesmo em troca.",shape=box,color=blue];
		j1743806100 -> j4068710887;
		j1743806100 -> j2040657260;
	j1243611437 [label="Bem, se o que você diz é verdade — e essa história me parece suficientemente absurda para ser real — tentarei não guardar rancor por você saber dessa minha profunda e terrível verdade.",shape=box,color=blue];
		j1243611437 -> j4167387681;
	j3020052946 [label="Você não prestou atenção em nada? Sério, a interpretação de texto hoje em dia… Eu não estava te ameaçando, Usurpador. Não estava ameaçando ninguém.",shape=box,color=blue];
		j3020052946 -> j1476826154;
	j3456050904 [label="Isto promete entretenimento. Por favor. Fique à vontade; o palco é todo seu.",shape=box,color=blue];
		j3456050904 -> j2186697919;
		j3456050904 -> j1402599517;
		j3456050904 -> j3176678169;
	j874432270 [label="Você não prestou atenção em nada? Sério, a interpretação de texto hoje em dia… Estou tentando fazer um acordo com você, Usurpador. Estou com dificuldade para acreditar que você não consiga acompanhar.",shape=box,color=blue];
		j874432270 -> j2742689877;
	j4068710887 [label="Não",shape=box,color=red];
		j4068710887 -> j100306748;
	j2040657260 [label="Justo",shape=box,color=red];
		j2040657260 -> j2189200180;
	j4167387681 [label="Embora, se me permite, peço que aproveite para me ridicularizar o quanto quiser agora, para que possamos prosseguir sem interrupções após isso.",shape=box,color=blue];
		j4167387681 -> j3554367636;
	j1476826154 [label="Eu simplesmente quis dizer que, caso cheguemos a um ponto em que eu não consiga atingir meus objetivos finais, talvez eu não tenha mais motivos para permanecer em silêncio.",shape=box,color=blue];
		j1476826154 -> j2742689877;
	j2186697919 [label="Eu sou o motivo da morte do Ballas. Não atrapalha a minha agenda",shape=box,color=red];
		j2186697919 -> j2387012692;
	j1402599517 [label="Se você tá querendo a minha ajuda, desse jeito é que não vai conseguir",shape=box,color=red];
		j1402599517 -> j1812024711;
	j3176678169 [label="Sei que a gente não se conhece muito bem, mas eu tô aqui pra te ajudar",shape=box,color=red];
		j3176678169 -> j800718487;
	j2742689877 [label="Se minha proposta não atender às suas necessidades, posso torná-la mais atraente para você?",shape=box,color=blue];
		j2742689877 -> j2284148939;
	j100306748 [label="+5 Chemistry",color=orange];
		j100306748 -> j3943446765;
	j2189200180 [label="+15 Chemistry",color=orange];
		j2189200180 -> j1999763324;
	j2387012692 [label="+5 Chemistry",color=orange];
		j2387012692 -> j1444268212;
	j1812024711 [label="E se você quiser a minha, então sugiro, como falei, que cheguemos a um acordo.",shape=box,color=blue];
		j1812024711 -> j2742689877;
	j800718487 [label="E? Ah, entendi. Você está incomodado com o meu \"tom\", é isso? Perdão, eu não sabia que você se irritava tão facilmente.",shape=box,color=blue];
		j800718487 -> j2742689877;
	j2284148939 [label="Chegou aos meus ouvidos que há muitas questões em torno de Deimos nas quais minha assistência poderia ser considerada não apenas útil, mas, ouso dizer, crucial.",shape=box,color=blue];
		j2284148939 -> j841808933;
	j3943446765 [label="Ah! No mínimo, tenho que admirar sua honestidade.",shape=box,color=blue];
		j3943446765 -> j1941902696;
	j1999763324 [label="Ótimo. É bom saber que você é pelo menos… maleável.",shape=box,color=blue];
		j1999763324 -> j1941902696;
	j1444268212 [label="Se você pudesse ter ouvido a minha gargalhada! Obrigada, Peregrino, por não ser nada tedioso!",shape=box,color=blue];
		j1444268212 -> j1411546630;
	j841808933 [label="Isso inclui, entre outras coisas, a reconciliação de um mordomo apaixonado e uma tal família afastada que mora no andar de cima.",shape=box,color=blue];
		j841808933 -> j2793746966;
	j1941902696 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j1941902696 -> j3371289814;
	j1411546630 [label="Add -1 to Thermostat counter",color=orange];
		j1411546630 -> j2790072530;
	j2793746966 [label="Uma família que, como mencionei, não faz a mínima ideia de que estamos aqui embaixo. E não tem conhecimento de que Albrecht ainda está vivo, certo?",shape=box,color=blue];
		j2793746966 -> j273795334;
		j2793746966 -> j2748283164;
		j2793746966 -> j3722039278;
	j3371289814 [label="Pelo menos isso vai ser interessante.",shape=box,color=blue];
		j3371289814 -> "Chat ends.";
