	"Chat ends." [color=orange];
	j1180871139 [label="ÁUDIO: ESTANDARTE",shape=box,color=blue];
		j1180871139 -> j509963547;
	j509963547 [label="Nada expressa tão sucintamente a pompa com que nós, criaturas, tratamos a carnificina da guerra quanto os porta-estandartes.",shape=box,color=blue];
		j509963547 -> j1026973090;
	j1026973090 [label="Aqueles que devem ser protegidos a todo custo - e seguidos incondicionalmente.",shape=box,color=blue];
		j1026973090 -> j3705713518;
	j3705713518 [label="E quem, aliás, poderia ser forçado a cumprir ordens que nenhum soldado sensato jamais seguiria, por medo de sofrer um destino ainda mais terrível? ",shape=box,color=blue];
		j3705713518 -> j4002223448;
	j4002223448 [label="Por mais bizarro que seja.",shape=box,color=blue];
		j4002223448 -> j3700432094;
	j3700432094 [label="Eram sempre as suas silhuetas que me atraíam, em meio aos demais, embora seus corpos mutilados não fossem diferentes de quaisquer outros. ",shape=box,color=blue];
		j3700432094 -> j1286321584;
	j1286321584 [label="Era sempre o estandarte que ainda carregavam, reluzindo em seu ouro Orokin e manchado de carmesim.",shape=box,color=blue];
		j1286321584 -> j3720238766;
	j3720238766 [label="Eu sempre me certificava de que ele permanecesse erguido com orgulho no campo de batalha.",shape=box,color=blue];
		j3720238766 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}