	2200 [label="ÁUDIO: ESTANDARTE",shape=box,color=blue];
		2200 -> 2198;
	2199 [label="Chat ends.",color=orange];
	2198 [label="Nada expressa tão sucintamente a pompa com que nós, criaturas, tratamos a carnificina da guerra quanto os porta-estandartes.",shape=box,color=blue];
		2198 -> 5694;
	5694 [label="Aqueles que devem ser protegidos a todo custo - e seguidos incondicionalmente.",shape=box,color=blue];
		5694 -> 5695;
	5695 [label="E quem, aliás, poderia ser forçado a cumprir ordens que nenhum soldado sensato jamais seguiria, por medo de sofrer um destino ainda mais terrível? ",shape=box,color=blue];
		5695 -> 2203;
	2203 [label="Por mais bizarro que seja.",shape=box,color=blue];
		2203 -> 5731;
	5731 [label="Eram sempre as suas silhuetas que me atraíam, em meio aos demais, embora seus corpos mutilados não fossem diferentes de quaisquer outros. ",shape=box,color=blue];
		5731 -> 2195;
	2195 [label="Era sempre o estandarte que ainda carregavam, reluzindo em seu ouro Orokin e manchado de carmesim.",shape=box,color=blue];
		2195 -> 2204;
	2204 [label="Eu sempre me certificava de que ele permanecesse erguido com orgulho no campo de batalha.",shape=box,color=blue];
		2204 -> 2202;
	2202 [label="Add 1 to HellStory",color=orange];
		2202 -> 2335;
