		j597069442 -> j621753199;
	j2264791203 [label="+5 Chemistry",color=orange];
		j2264791203 -> j615467055;
	j2318618397 [label="Mas, para fins de argumentação, vamos continuar",shape=box,color=red];
		j2318618397 -> j2264791203;
	j621753199 [label="É melhor parar aqui, não acho que isso vá acabar bem [Encerrar Conversa]",shape=box,color=red];
		j621753199 -> j3485748724;
	j615467055 [label="Muito bem. Se pudermos afirmar que o \"mal\" não é um estado de ser, mas uma construção social, então podemos concordar que todos os contos de grandes vilanias são, portanto, construções sociais. Fábulas.",shape=box,color=blue];
		j615467055 -> j3985821736;
	j3485748724 [label="Como desejar.",shape=box,color=blue];
		j3485748724 -> "Chat ends.";
	j3985821736 [label="Por que, então, em todas as grandes fábulas, aqueles que cometem os maiores males são deixados para apodrecer sozinhos?",shape=box,color=blue];
		j3985821736 -> j2642848499;
		j3985821736 -> j3602568645;
		j3985821736 -> j3005832280;
		j3985821736 -> j1273570617;
	j2642848499 [label="Porque são incapazes de amar?",shape=box,color=red];
		j2642848499 -> j1373009996;
	j3602568645 [label="Porque não há espaço em seus corações pro amor?",shape=box,color=red];
		j3602568645 -> j1848434444;
	j3005832280 [label="Porque eles não merecem ser amados?",shape=box,color=red];
		j3005832280 -> j4082208794;
	j1273570617 [label="Porque estamos tentando ensinar uma lição?",shape=box,color=red];
		j1273570617 -> j3025283074;
	j1373009996 [label="Às vezes, sim, eles são mostrados como seres desumanos e maus, incapazes de amar. Mas por quê? Eu diria que todas as grandes fábulas existem para ensinar uma lição, não é mesmo?",shape=box,color=blue];
		j1373009996 -> j1887583911;
	j1848434444 [label="Às vezes, sim, eles se mostram tão preocupados com seus grandes males que se esquecem de se depreciar com essas supostas \"coisas triviais\". Mas por quê? Todas as grandes fábulas existem para ensinar uma lição, não é mesmo?",shape=box,color=blue];
		j1848434444 -> j1887583911;
	j4082208794 [label="Hmm, agora você está simplesmente repetindo minhas palavras, Usurpador. Já decidimos que \"merecer\" é relativo. Pense. Todas as grandes fábulas existem para ensinar uma lição, não é mesmo?",shape=box,color=blue];
		j4082208794 -> j1887583911;
	j3025283074 [label="+5 Chemistry",color=orange];
		j3025283074 -> j3465493721;
	j1887583911 [label="E se mostrássemos um grande mal vivendo em paz, feliz, maravilhosamente apaixonado… bem… que tipo de lição isso nos ensinaria?",shape=box,color=blue];
		j1887583911 -> j3064233824;
		j1887583911 -> j2213344860;
		j1887583911 -> j3246625075;
	j3465493721 [label="Essa seria a minha teoria, sim! Todas as grandes fábulas existem para ensinar uma lição, não é mesmo?",shape=box,color=blue];
		j3465493721 -> j1887583911;
	j3064233824 [label="É difícil conciliar o fato de alguém ser \"mau\" e, ao mesmo tempo, capaz de amar.",shape=box,color=red];
		j3064233824 -> j362925635;
	j2213344860 [label="Talvez seus \"atos malignos\" ainda pudessem ser redimidos pelo amor?",shape=box,color=red];
		j2213344860 -> j2398902814;
	j3246625075 [label="Que aqueles que praticam \"coisas más\" ainda possam ter valor para alguém neste mundo e, portanto, não sejam \"pura maldade\"?",shape=box,color=red];
		j3246625075 -> j2144631306;
