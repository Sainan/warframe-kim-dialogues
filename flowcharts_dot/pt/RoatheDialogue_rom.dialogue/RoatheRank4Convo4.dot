	"Chat ends." [color=orange];
	j1762840129 [label="Você está me perguntando isso depois de me contar aquela história sobre Ballas e Margulis, e não é sobre ele?",shape=box,color=red];
		j1762840129 -> j3511846726;
	j1784104785 [label="Depois do que o Albrecht fez com você, e de toda essa história de \"se os Orokin podem ser perdoados\", e não se trata dele?",shape=box,color=red];
		j1784104785 -> j3511846726;
	j3174198564 [label="Tá, vou participar. Acredito que \"todos merecem ser amados\"? Claramente, esta é uma questão de moralidade e valores",shape=box,color=red];
		j3174198564 -> j2307837964;
	j1969963233 [label="O Orokin que me disse que nunca conheceu o amor por acaso me faz essa pergunta, e não é sobre ele?",shape=box,color=red];
		j1969963233 -> j3511846726;
	j2520351427 [label="O Orokin que serviu uma Executora como concubina, mas depois planejou traí-la, me pergunta isso, e não é sobre ele?",shape=box,color=red];
		j2520351427 -> j3511846726;
	j801226791 [label="Você realmente espera que eu acredite que isso seja só uma questão filosófica?",shape=box,color=red];
		j801226791 -> j3511846726;
	j3511846726 [label="Não quero me prender aos detalhes. Isso arrasta tudo para minúcias. \"Bem, veja bem, essa pessoa fez isso, e aquela pessoa fez aquilo, o que invalida isso\", e aí todos nós ficamos no banco das testemunhas, nesse nosso pequeno púlpito improvisado.",shape=box,color=blue];
		j3511846726 -> j2696425751;
		j3511846726 -> j3273963595;
	j2307837964 [label="+5 Chemistry",color=orange];
		j2307837964 -> j1062673021;
	j2696425751 [label="Ou fala direto, ou não fala nada. Se você não vai me dizer de quem se trata realmente, então não vou perder meu tempo conversando com você",shape=box,color=red];
		j2696425751 -> j3029957811;
	j3273963595 [label="Tá, vou participar do seu joguinho proverbial",shape=box,color=red];
		j3273963595 -> j320004906;
	j1062673021 [label="Obrigado! Remover os nomes deste pequeno texto torna tudo muito mais palatável. Caso contrário, você se perde nos detalhes e não chegaremos a lugar nenhum.",shape=box,color=blue];
		j1062673021 -> j1185916548;
	j3029957811 [label="E eu também não farei isso por você, simples assim.",shape=box,color=blue];
		j3029957811 -> j155006797;
	j320004906 [label="Ótimo. A questão é exatamente como eu a formulei: todos merecem ser amados?",shape=box,color=blue];
		j320004906 -> j230353566;
	j1185916548 [label="E sim, exatamente. Ninguém questiona se o herói justo merece amar e ser amado. Isso nunca é posto em debate em nossas grandes fábulas, não é?",shape=box,color=blue];
		j1185916548 -> j1348050283;
