		j3417447744 -> j1120182541;
	j2278711316 [label="+5 Chemistry",color=orange];
		j2278711316 -> j1658477668;
	j3406066131 [label="Você soa como os fanáticos. \"Redenção\". Mas você está batendo à porta da verdade. Porque você está insinuando que os dois não podem coexistir em nosso mundo, e isso é verdade, não é? Amor e mal não podem coexistir na sociedade.",shape=box,color=blue];
		j3406066131 -> j603738447;
	j3362980634 [label="Você está perto, mas ainda não chegou lá. Sim, mas dê um passo além. O que significaria se uma pessoa capaz de praticar o mal ainda fosse amada por outra? Que impacto isso teria na sociedade?",shape=box,color=blue];
		j3362980634 -> j603738447;
	j1120182541 [label="Exatamente! Essas duas coisas não querem coexistir em nossas mentes, não é? Quando contei a história de Ballas e Margulis, foi difícil aceitar que o amor entre eles um dia foi real, não foi?",shape=box,color=blue];
		j1120182541 -> j2099953546;
	j1658477668 [label="Exatamente! Essas duas coisas não querem conviver juntas em nossas mentes, não é? Se eu lhe dissesse que Ballas e Margulis já foram muito apaixonados antes de tudo dar errado, você acreditaria em mim?",shape=box,color=blue];
		j1658477668 -> j2099953546;
	j603738447 [label="Check boolean RoatheMargulis1",color=orange];
		j603738447 -> j596768817 [label=true,color=green];
		j603738447 -> j1957099019 [label=false,color=brown];
	j2099953546 [label="Sem entrar em detalhes específicos e me afastar muito da minha própria regra de manter as coisas puramente filosóficas, eles são um ponto de referência comum para nós dois.",shape=box,color=blue];
		j2099953546 -> j3464190325;
	j596768817 [label="Quando contei a história de Ballas e Margulis, foi difícil aceitar que o amor entre eles um dia foi real, não foi?",shape=box,color=blue];
		j596768817 -> j2099953546;
	j1957099019 [label="Se eu lhe dissesse que Ballas e Margulis já foram muito apaixonados antes de tudo dar errado, você acreditaria em mim?",shape=box,color=blue];
		j1957099019 -> j2099953546;
	j3464190325 [label="É inegável que Ballas era capaz de algumas das formas mais puras de crueldade que a humanidade já conheceu. E, no entanto, ele conhecia o amor. O amor mútuo. ",shape=box,color=blue];
		j3464190325 -> j4270748571;
	j4270748571 [label="Isso é um fato, embora você possa querer negar agora: Ballas e Margulis se amavam profundamente. Simplesmente deu tudo errado.",shape=box,color=blue];
		j4270748571 -> j2547557483;
	j2547557483 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j2547557483 -> j1910642922;
	j1910642922 [label="Mas precisamos expurgar essa história de todo o amor deles. Precisamos dizer que ele não existiu. Precisamos dizer que não foi real, que foi uma falácia. Por quê?",shape=box,color=blue];
		j1910642922 -> j530814494;
		j1910642922 -> j2652197980;
		j1910642922 -> j4058221354;
	j530814494 [label="Eu… não sei",shape=box,color=red];
		j530814494 -> j3253373009;
	j2652197980 [label="Porque o amor é a emoção humana suprema, e se nos permitirmos pensar que alguém pode ser amado, isso o humaniza",shape=box,color=red];
		j2652197980 -> j3277081197;
	j4058221354 [label="Porque o mal precisa se olhar no espelho e se esforçar para mudar. Ele precisa ser punido. E amar e ser amado é a recompensa suprema.",shape=box,color=red];
		j4058221354 -> j1018468507;
	j3253373009 [label="E todo esse trabalho foi em vão. Que vergonha.",shape=box,color=blue];
		j3253373009 -> "Chat ends.";
	j3277081197 [label="Add -2 to Thermostat counter",color=orange];
		j3277081197 -> j1349433333;
	j1018468507 [label="Add 2 to Thermostat counter",color=orange];
		j1018468507 -> j1452343507;
	j1349433333 [label="Muito bem, Usurpador. Muito bem. Exatamente isso. O grande mal deve sempre ser \"o outro\" e jamais devemos simpatizar com ele. Se permitirmos que ele sinta amor e seja amado? Acho que o mundo inteiro pode desmoronar ao nosso redor.",shape=box,color=blue];
		j1349433333 -> j1563166044;
	j1452343507 [label="Muito bem, Usurpador. Muito bem. Exatamente isso. Devemos responsabilizar o grande mal. Se permitirmos que ele sinta amor e seja amado? Acho que o mundo inteiro pode desmoronar ao nosso redor.",shape=box,color=blue];
