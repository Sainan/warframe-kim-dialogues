		j2439101453 -> j4062691488;
	j3453445887 [label="Add 1 to Thermostat counter",color=orange];
		j3453445887 -> j1370098750;
	j4062691488 [label="Joga o jogo, Usurpador.",shape=box,color=blue];
		j4062691488 -> j1817221348;
	j1370098750 [label="Proponho o seguinte: a única coisa que torna essas criaturas moralmente marginalizadas é o fato de existirem outros que possam marginalizá-las moralmente.",shape=box,color=blue];
		j1370098750 -> j344190450;
	j1817221348 [label="Add -1 to Thermostat counter",color=orange];
		j1817221348 -> j2944288786;
		j1817221348 -> j3282875758;
	j344190450 [label="Se um indivíduo cometesse \"atos malignos\" isoladamente, como uma única pessoa sem ninguém por perto para julgá-lo, não haveria ninguém para julgá-lo como mau, não é mesmo?",shape=box,color=blue];
		j344190450 -> j1755866314;
	j2944288786 [label="É…",shape=box,color=red];
		j2944288786 -> j2049861757;
	j3282875758 [label="Foi mal",shape=box,color=red];
		j3282875758 -> j2049861757;
	j1755866314 [label="Se um desgraçado incendeia uma floresta e ninguém está por perto para ouvi-lo, isso faz algum barulho? A única medida que temos para julgar as ações \"boas\" e \"más\" são as ações dos outros.",shape=box,color=blue];
		j1755866314 -> j3249923457;
		j1755866314 -> j1464184595;
		j1755866314 -> j1510802953;
	j2049861757 [label="Mas sim, já que você insistiu em mencionar, o Diabo! A personificação de todos os males!",shape=box,color=blue];
		j2049861757 -> j1370098750;
	j3249923457 [label="Devem existir atos que sejam maus por si só",shape=box,color=red];
		j3249923457 -> j1586844954;
	j1464184595 [label="Você tá dizendo que uma pessoa precisa de outra pra ser \"má\"?",shape=box,color=red];
		j1464184595 -> j896730276;
	j1510802953 [label="Não sei se concordo com isso",shape=box,color=red];
		j1510802953 -> j1586844954;
	j1586844954 [label="Todos os atos mais horríveis que uma pessoa pode cometer exigem, no mínimo, uma segunda pessoa para serem cometidos. Uma única pessoa, isoladamente, não pode fazer nada que seja condenável. Destruir um planeta desabitado? Ah, que horror.",shape=box,color=blue];
		j1586844954 -> j2171467288;
	j896730276 [label="Sim. Pense bem, todos os atos mais horríveis que uma pessoa pode cometer exigem, no mínimo, uma segunda pessoa para serem cometidos. Uma única pessoa, isoladamente, não pode fazer nada que seja condenável. Destruir um planeta desabitado? Ah, que horror.",shape=box,color=blue];
		j896730276 -> j2171467288;
	j2171467288 [label="E sem uma sociedade para apontar o dedo e dizer \"você não deveria ter cometido esse ato terrível\", como saberíamos que aquele ato foi tão horrível? Não saberíamos.",shape=box,color=blue];
		j2171467288 -> j2950369435;
	j2950369435 [label="É simplesmente um parâmetro usado pela sociedade para comparar suas ações com as dos outros, como eu disse.",shape=box,color=blue];
		j2950369435 -> j3974655358;
		j2950369435 -> j3363442245;
	j3974655358 [label="Digamos que você tenha razão. Digamos que você me convenceu, e que o bem e o mal são só… construções sociais. E aí?",shape=box,color=red];
		j3974655358 -> j2296401358;
	j3363442245 [label="Acredito que as ações podem ser boas ou más fora de seu contexto social. Caso contrário, por que tantas delas seriam semelhantes em sociedades tão diferentes?",shape=box,color=red];
		j3363442245 -> j597069442;
	j2296401358 [label="Add -1 to Thermostat counter",color=orange];
		j2296401358 -> j2264791203;
	j597069442 [label="Add 1 to Thermostat counter",color=orange];
