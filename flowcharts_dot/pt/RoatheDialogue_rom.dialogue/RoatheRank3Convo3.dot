		1819 -> 1825;
		1819 -> 1826;
	1820 [label="Pode ser, mas não era esse o ponto que eu estava tentando defender. E você está evitando admitir isso. Muito bem. Se, em teoria, você tivesse perdido suas memórias, tentaria recuperá-las se pudesse?",shape=box,color=blue];
