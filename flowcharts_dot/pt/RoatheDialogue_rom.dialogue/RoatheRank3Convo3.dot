		j4063333013 -> j1598326302;
	j3841265312 [label="Muito bem, Peregrino. Só saberei a dimensão do que me foi tirado quando tiver tudo de volta. Essas memórias compõem quem eu sou, quem eu fui. Elas são a própria essência do meu ser.",shape=box,color=blue];
