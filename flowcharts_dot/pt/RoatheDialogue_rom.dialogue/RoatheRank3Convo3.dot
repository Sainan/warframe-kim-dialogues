	j3687811267 [label="Se você não se importa, então eu também não. Tenho meus próprios assuntos para tratar.",shape=box,color=blue];
		j3687811267 -> j1933300832;
	j3424129363 [label="Mas me encontro sentado naquela cripta, levanto-me da cadeira e penso: \"Será que o Peregrino está por perto e deseja conversar?\"",shape=box,color=blue];
		j3424129363 -> j1590761947;
