	j3660382884 [label="Só saberei o que ele me tirou quando tiver tudo de volta. É claro que devemos continuar! Essas memórias são minhas, Peregrino. Elas compõem quem eu sou, quem eu fui. Elas são a própria essência do meu ser.",shape=box,color=blue];
		j3660382884 -> j3461091031;
		j3660382884 -> j1885913355;
	j2855866025 [label="Pode ser, mas não era esse o ponto que eu estava tentando defender. E você está evitando admitir isso. Muito bem. Se, em teoria, você tivesse perdido suas memórias, tentaria recuperá-las se pudesse?",shape=box,color=blue];
		j2855866025 -> j3461091031;
		j2855866025 -> j1885913355;
	j1996380271 [label="Se você tivesse a oportunidade de recuperar suas memórias perdidas, você o faria?",shape=box,color=blue];
