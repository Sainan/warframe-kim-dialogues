		j3236337577 -> j2087226534;
	j3481414185 [label="Eu disse que te perdoava. E estou tentando cumprir o que te prometi. É que, às vezes, as palavras não transformam algo em realidade. E dizer que se perdoa alguém é muito bonito na teoria, mas, às vezes, as emoções têm dificuldade em acompanhar os fatos.",shape=box,color=blue];
