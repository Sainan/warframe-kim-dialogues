		1806 -> 1813;
		1806 -> 1814;
	1804 [label="Só ouço histórias de você subjugando os Narmerianos. Derrotando hordas de soldados Grineer. Derrotando hordas do Murmúrio. E mesmo assim, fui eu quem consegui te afetar assim?",shape=box,color=blue];
