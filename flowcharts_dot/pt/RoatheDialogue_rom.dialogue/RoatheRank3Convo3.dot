	j775550278 [label="Não mesmo. E para mim não faz diferença o que você faz durante o dia. Estou apenas dizendo que, se você quer que aquele mordomo magricela suba aquelas escadas, você tem um trabalho a fazer.",shape=box,color=blue];
		j775550278 -> j3684478177;
	j2887413849 [label="Espero que sim. Para mim, não faz diferença o que você faz durante o dia. Estou apenas dizendo que, se você quer que aquele mordomo magricela suba aquelas escadas, você tem um trabalho a fazer.",shape=box,color=blue];
		j2887413849 -> j3687811267;
	j2402013262 [label="Mas estou começando a me ver desejando confiar em você novamente. Novamente! Sabendo muito bem o que você fez. Sabendo que você pode simplesmente me trair mais uma vez!",shape=box,color=blue];
		j2402013262 -> j3424129363;
