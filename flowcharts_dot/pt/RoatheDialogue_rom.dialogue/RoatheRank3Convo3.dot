		j486919893 -> j1084042550;
		j486919893 -> j1351933520;
	j916947060 [label="Só ouço histórias de você subjugando os Narmerianos. Derrotando hordas de soldados Grineer. Derrotando hordas do Murmúrio. E mesmo assim, fui eu quem consegui te afetar assim?",shape=box,color=blue];
