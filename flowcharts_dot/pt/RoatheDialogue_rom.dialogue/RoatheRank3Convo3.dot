		j1996380271 -> j1885913355;
	j2366795114 [label="Supondo que você não esteja mentindo para mim? Admito que isso é bastante lisonjeiro. Adorável. Extremamente triste. Mas lisonjeiro.",shape=box,color=blue];
		j2366795114 -> "Chat ends.";
	j1137123337 [label="Aguardo ansiosamente nossas conversas, quer você também aguarde ou não",shape=box,color=red];
