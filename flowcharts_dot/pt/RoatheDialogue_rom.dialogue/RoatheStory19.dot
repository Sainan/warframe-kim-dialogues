	5720 [label="Entre os Sete Executores, o Ballas se considerava o primeiro entre iguais. ",shape=box,color=blue];
		5720 -> 5721;
	5721 [label="Sempre o diplomata, sempre o persuasor de voz melodiosa, ele resolvia as mágoas e disputas dos outros.",shape=box,color=blue];
		5721 -> 2301;
	2301 [label="Descobri, para minha total alegria, que ele agora era a rosa presa entre dois emaranhados de espinhos. ",shape=box,color=blue];
		2301 -> 5734;
	5734 [label="A facção belicista, liderada por Nitokh, puxava para um lado. Os pacifistas, sob o comando de Scarne, puxavam para o outro.",shape=box,color=blue];
		5734 -> 2300;
	2300 [label="Ballas era obrigado a decidir e a atrair a inimizade implacável do grupo com o qual não se aliasse.",shape=box,color=blue];
		2300 -> 2305;
	2305 [label="Por razões que não consigo imaginar, ele escolheu a paz. Ficou 4 a 3, e assim, os vorazes Sentients tornaram-se, repentinamente, aliados e amigos.",shape=box,color=blue];
		2305 -> 2308;
	2308 [label="\"De um jeito ou de outro, ele vai mudar de ideia\", prometeu Nitokh, enquanto eu era enviado para procurar os descontentes entre os Dax.",shape=box,color=blue];
