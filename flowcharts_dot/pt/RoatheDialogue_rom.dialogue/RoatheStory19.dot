	"Chat ends." [color=orange];
	j526364713 [label="ÁUDIO: DIPLOMACIA",shape=box,color=blue];
		j526364713 -> j874432293;
	j874432293 [label="Entre os Sete Executores, o Ballas se considerava o primeiro entre iguais. ",shape=box,color=blue];
		j874432293 -> j335482157;
	j335482157 [label="Sempre o diplomata, sempre o persuasor de voz melodiosa, ele resolvia as mágoas e disputas dos outros.",shape=box,color=blue];
		j335482157 -> j2625428615;
	j2625428615 [label="Descobri, para minha total alegria, que ele agora era a rosa presa entre dois emaranhados de espinhos. ",shape=box,color=blue];
		j2625428615 -> j437813972;
	j437813972 [label="A facção belicista, liderada por Nitokh, puxava para um lado. Os pacifistas, sob o comando de Scarne, puxavam para o outro.",shape=box,color=blue];
		j437813972 -> j1842367075;
	j1842367075 [label="Ballas era obrigado a decidir e a atrair a inimizade implacável do grupo com o qual não se aliasse.",shape=box,color=blue];
		j1842367075 -> j3115677699;
	j3115677699 [label="Por razões que não consigo imaginar, ele escolheu a paz. Ficou 4 a 3, e assim, os vorazes Sentients tornaram-se, repentinamente, aliados e amigos.",shape=box,color=blue];
		j3115677699 -> j2429652172;
	j2429652172 [label="\"De um jeito ou de outro, ele vai mudar de ideia\", prometeu Nitokh, enquanto eu era enviado para procurar os descontentes entre os Dax.",shape=box,color=blue];
		j2429652172 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}