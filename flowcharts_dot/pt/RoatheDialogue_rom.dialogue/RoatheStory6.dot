	"Chat ends." [color=orange];
	j2152074261 [label="ÁUDIO: CONSCIÊNCIA",shape=box,color=blue];
		j2152074261 -> j4082000523;
	j4082000523 [label="Não pensávamos nos Sentients como \"alguém\", mas sim como \"algo\". ",shape=box,color=blue];
		j4082000523 -> j4240459612;
	j4240459612 [label="Enfrentávamos legiões lançadas contra nós sem qualquer consideração por suas vidas individuais, assim como não há consideração por corpúsculos celulares.",shape=box,color=blue];
		j4240459612 -> j1946586509;
	j1946586509 [label="Eram células no corpo de uma massa extensa e malévola.",shape=box,color=blue];
		j1946586509 -> j1544235239;
	j1544235239 [label="Creio estarmos condicionados demais por nossas experiências com a Infestação — uma mente coletiva de uma ordem completamente diferente.",shape=box,color=blue];
		j1544235239 -> j3731534847;
	j3731534847 [label="Os Sentients tinham a missão de evoluir, e nós éramos seu único modelo para a culminação dessa evolução.",shape=box,color=blue];
		j3731534847 -> j4277735747;
	j4277735747 [label="Eles retornaram ao Sistema de Origem não somente para obliterar os Orokin, mas para substituí-los e, em última instância… aperfeiçoá-los.",shape=box,color=blue];
		j4277735747 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}