		j1302525738 -> j4243140576;
	j1454832529 [label="Essa \"nova chance\" na minha vida. Muito bem. Concordo e aceito seu argumento. Embora possa ter sido tarde, foi… eficaz, mesmo assim.",shape=box,color=blue];
