		j2391084601 -> j2596583414;
	j374115659 [label="Outra oportunidade pra conversarmos sobre o uso do soro. Roathe, chega de fugir",shape=box,color=red];
		j374115659 -> j1979205857;
	j3667861487 [label="Roathe, tomar o soro não te torna um covarde. Te torna o único Orokin ainda de pé, aceite isso",shape=box,color=red];
		j3667861487 -> j1420398166;
	j2596583414 [label="Roathe, tomar o soro não te torna um covarde. Tenha outra chance de viver, de fazer uma diferença real",shape=box,color=red];
