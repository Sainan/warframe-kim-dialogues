digraph {
	5182 [label="RoatheRepair begins.",color=orange];
		5182 -> 5183;
	5183 [label="Evaluate expressions",color=orange];
		5183 -> 5185 [label="LyonRoatheFailFix, MarieRoatheFailFix",color=purple];
		5183 -> 5184 [label="false",color=purple];
	5185 [label="Chega! Chega! Eu me rendo! Mande seus fanáticos cessarem o ataque. Eles são piores que Kubrodons raivosos! Criaturas malditas me seguem para onde quer que eu vá. Eu nem consigo dormir!",shape=box,color=blue];
		5185 -> 5186;
	5184 [label="Chat ends.",color=orange];
	5186 [label="O quê?! O que você quer?!",shape=box,color=blue];
		5186 -> 5188;
		5186 -> 5187;
		5186 -> 5189;
	5188 [label="Outra oportunidade pra conversarmos sobre o uso do soro. Roathe, chega de fugir",shape=box,color=red];
		5188 -> 5191;
	5187 [label="Roathe, tomar o soro não te torna um covarde. Te torna o único Orokin ainda de pé, aceite isso",shape=box,color=red];
		5187 -> 5190;
	5189 [label="Roathe, tomar o soro não te torna um covarde. Tenha outra chance de viver, de fazer uma diferença real",shape=box,color=red];
		5189 -> 5192;
	5191 [label="Evaluate expressions on Thermostat",color=orange];
		5191 -> 5195 [label="x >= 5",color=purple];
		5191 -> 5194 [label="x <= 0",color=purple];
		5191 -> 5193 [label="x > 0 && x < 5",color=purple];
		5191 -> 5193 [label="false",color=purple];
	5190 [label="Add -5 to Thermostat",color=orange];
		5190 -> 5191;
	5192 [label="Add 5 to Thermostat",color=orange];
		5192 -> 5191;
	5195 [label="Você tá deixando essa raiva te consumir por dentro. Você poderia usar ela pra te ajudar a lutar contra as pessoas que ainda tão destruindo este mundo… hoje, aqui e agora",shape=box,color=red];
		5195 -> 5198;
	5194 [label="Você tá apontando o dedo pra si mesmo. Deveria estar apontando pro mundo que te culpa por ter feito o melhor que pôde pra salvar eles do Império Orokin",shape=box,color=red];
		5194 -> 5197;
	5193 [label="Foi por isso que você os convenceu a me perturbar dia e noite? Para isso? Uma última tentativa desesperada de me convencer a ouvir seu argumento patético?",shape=box,color=blue];
		5193 -> 5196;
	5198 [label="Você não é definido pelo seu passado, Roathe. Você é definido pelo seu futuro. E você ainda tem um futuro pela frente, ao contrário de todos os Orokin que morreram na Noite dos Tambores de Naga",shape=box,color=red];
		5198 -> 5201;
	5197 [label="Você não é definido pelas opiniões dos outros, nem pelo que pensam das suas ações. Você é definido só pelo que acredita sobre si mesmo e pelas suas escolhas",shape=box,color=red];
		5197 -> 5200;
	5196 [label="Não.",shape=box,color=blue];
		5196 -> 5199;
	5201 [label="Essa é a única coisa que te define agora. Você pode mudar, e você pode mudar o mundo ao seu redor. Minha única pergunta é: você vai pelo menos tentar?",shape=box,color=red];
		5201 -> 5204;
	5200 [label="E a verdade é que você é um dos raríssimos Orokin que conhecemos que sobreviveram à Noite dos Tambores de Naga. Do meu ponto de vista, foi uma retirada estratégica",shape=box,color=red];
		5200 -> 5203;
	5199 [label="Seu fracasso é patético. Não uma, mas duas vezes.",shape=box,color=blue];
		5199 -> 5202;
	5204 [label="Tente se perdoar e seguir em frente?",shape=box,color=red];
		5204 -> 5207;
	5203 [label="Nada mais. Nada menos.",shape=box,color=red];
		5203 -> 5206;
	5202 [label="Não recomendo candidatar-se a um cargo público.",shape=box,color=blue];
		5202 -> 5205;
	5207 [label="Update boolean RoatheRedeemed",color=orange];
		5207 -> 5209;
	5206 [label="Update boolean RoatheVillain",color=orange];
		5206 -> 5208;
	5205 [label="Chat ends.",color=orange];
	5209 [label="+20 Chemistry",color=orange];
		5209 -> 5211;
	5208 [label="+20 Chemistry",color=orange];
		5208 -> 5210;
	5211 [label="Me perdoar pelo que fiz? E seguir em frente para o futuro? Hmm…",shape=box,color=blue];
		5211 -> 5213;
	5210 [label="Uma retirada para vencer a guerra. Hmm…",shape=box,color=blue];
		5210 -> 5212;
	5213 [label="Embora eu tenha algumas dúvidas sobre a sua reformulação da situação, estou… tentado demais por esse novo futuro e pelo que ele pode significar para mim para resistir, querido Peregrino.",shape=box,color=blue];
		5213 -> 5215;
	5212 [label="Embora eu esteja… um pouco cético quanto à sua reformulação dos eventos como uma retirada tática, admito que, mesmo assim, sou a favor, querido Peregrino.",shape=box,color=blue];
		5212 -> 5214;
	5215 [label="Essa \"nova chance\" na minha vida. Muito bem. Concordo e aceito seu argumento. Embora possa ter sido tarde, foi… eficaz, mesmo assim.",shape=box,color=blue];
		5215 -> 5216;
	5214 [label="Muito bem. Concordo e aceito seu argumento. Embora possa ter sido tarde, foi… eficaz, mesmo assim.",shape=box,color=blue];
		5214 -> 5216;
	5216 [label="Agradeço muito. Mais do que você imagina.",shape=box,color=blue];
		5216 -> 5217;
	5217 [label="Update boolean RoatheFail",color=orange];
		5217 -> 5218;
	5218 [label="Update boolean RoatheFamilyFail",color=orange];
		5218 -> 5793;
	5793 [label="Update boolean RoatheFailStall",color=orange];
		5793 -> 5795;
	5795 [label="Check boolean LoidFamilyComplete",color=orange];
		5795 -> 5796 [label=true,color=green];
		5795 -> 5794 [label=false,color=brown];
	5796 [label="Chat ends.",color=orange];
	5794 [label="Agora, creio que podemos passar para nossa próxima batalha na guerra, certo? O mordomo.",shape=box,color=blue];
		5794 -> 5797;
	5797 [label="Eu, por exemplo, mal posso esperar.",shape=box,color=blue];
		5797 -> 5798;
	5798 [label="Update boolean RoatheFamilyDelay",color=orange];
		5798 -> 1702;
	1702 [label="Chat ends.",color=orange];
