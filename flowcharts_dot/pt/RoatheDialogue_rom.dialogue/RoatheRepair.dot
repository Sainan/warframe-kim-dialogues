		j2688688654 -> "Chat ends." [label="false",color=purple];
	j1410691613 [label="Chega! Chega! Eu me rendo! Mande seus fanáticos cessarem o ataque. Eles são piores que Kubrodons raivosos! Criaturas malditas me seguem para onde quer que eu vá. Eu nem consigo dormir!",shape=box,color=blue];
