		j2835771019 -> j1302525738;
	j3466570521 [label="Embora eu tenha algumas dúvidas sobre a sua reformulação da situação, estou… tentado demais por esse novo futuro e pelo que ele pode significar para mim para resistir, querido Peregrino.",shape=box,color=blue];
		j3466570521 -> j1454832529;
