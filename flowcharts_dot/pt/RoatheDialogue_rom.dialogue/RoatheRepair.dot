	j62611055 [label="Add 5 to Thermostat counter",color=orange];
		j62611055 -> j1979205857;
	j2120200623 [label="Você tá deixando essa raiva te consumir por dentro. Você poderia usar ela pra te ajudar a lutar contra as pessoas que ainda tão destruindo este mundo… hoje, aqui e agora",shape=box,color=red];
		j2120200623 -> j2363189056;
	j3301578972 [label="Você tá apontando o dedo pra si mesmo. Deveria estar apontando pro mundo que te culpa por ter feito o melhor que pôde pra salvar eles do Império Orokin",shape=box,color=red];
		j3301578972 -> j3729584558;
	j338319454 [label="Foi por isso que você os convenceu a me perturbar dia e noite? Para isso? Uma última tentativa desesperada de me convencer a ouvir seu argumento patético?",shape=box,color=blue];
		j338319454 -> j1576239856;
	j2363189056 [label="Você não é definido pelo seu passado, Roathe. Você é definido pelo seu futuro. E você ainda tem um futuro pela frente, ao contrário de todos os Orokin que morreram na Noite dos Tambores de Naga",shape=box,color=red];
		j2363189056 -> j2661028659;
	j3729584558 [label="Você não é definido pelas opiniões dos outros, nem pelo que pensam das suas ações. Você é definido só pelo que acredita sobre si mesmo e pelas suas escolhas",shape=box,color=red];
		j3729584558 -> j1999104540;
	j1576239856 [label="Não.",shape=box,color=blue];
		j1576239856 -> j4250735840;
	j2661028659 [label="Essa é a única coisa que te define agora. Você pode mudar, e você pode mudar o mundo ao seu redor. Minha única pergunta é: você vai pelo menos tentar?",shape=box,color=red];
		j2661028659 -> j1012170873;
	j1999104540 [label="E a verdade é que você é um dos raríssimos Orokin que conhecemos que sobreviveram à Noite dos Tambores de Naga. Do meu ponto de vista, foi uma retirada estratégica",shape=box,color=red];
		j1999104540 -> j3534382696;
	j4250735840 [label="Seu fracasso é patético. Não uma, mas duas vezes.",shape=box,color=blue];
		j4250735840 -> j665754338;
	j1012170873 [label="Tente se perdoar e seguir em frente?",shape=box,color=red];
		j1012170873 -> j4106656809;
	j3534382696 [label="Nada mais. Nada menos.",shape=box,color=red];
