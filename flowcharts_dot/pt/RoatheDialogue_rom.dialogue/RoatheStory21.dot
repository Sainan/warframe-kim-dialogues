	2321 [label="Covarde.",shape=box,color=blue];
		2321 -> 5725;
	5725 [label="Era assim que me chamavam, não é? Li os livros de história espalhados por este salão empoeirado. Só mentiras, eles não sabiam a verdade. Fui arrancado do meu tempo antes que pudesse concluir meu trabalho.",shape=box,color=blue];
		5725 -> 5726;
	5726 [label="Covarde.",shape=box,color=blue];
		5726 -> 5727;
	5727 [label="Agora me lembro. Ele se aproximou de mim, nos Salões Dourados. Tinha um rosto que eu não reconhecia, mas isso não é tão incomum para a nossa espécie. Eu conhecia sua voz, seu jeito de se mover.",shape=box,color=blue];
		5727 -> 5728;
	5728 [label="Covarde!",shape=box,color=blue];
		5728 -> 5729;
	5729 [label="Ele me fez uma única pergunta. Eu realmente acreditava que, algum dia, seria perdoado por reduzir tudo a cinzas?",shape=box,color=blue];
		5729 -> 5730;
	5730 [label="COVARDE!",shape=box,color=blue];
		5730 -> 2320;
	2320 [label="Naquela mão pálida e estendida… uma seringa. Brilhando, com a liberdade… com outra chance… com outra vida.",shape=box,color=blue];
		2320 -> 2324;
	2324 [label="Eu a tomei.",shape=box,color=blue];
		2324 -> 5735;
	5735 [label="COVARDE!",shape=box,color=blue];
		5735 -> 2319;
