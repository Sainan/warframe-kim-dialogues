	j2477807026 [label="ÁUDIO: ESQUECIMENTO",shape=box,color=blue];
		j2477807026 -> j1404682448;
	j1404682448 [label="Covarde.",shape=box,color=blue];
		j1404682448 -> j2512690174;
	j2512690174 [label="Era assim que me chamavam, não é? Li os livros de história espalhados por este salão empoeirado. Só mentiras, eles não sabiam a verdade. Fui arrancado do meu tempo antes que pudesse concluir meu trabalho.",shape=box,color=blue];
		j2512690174 -> j301465563;
	j301465563 [label="Covarde.",shape=box,color=blue];
		j301465563 -> j527844575;
	j527844575 [label="Agora me lembro. Ele se aproximou de mim, nos Salões Dourados. Tinha um rosto que eu não reconhecia, mas isso não é tão incomum para a nossa espécie. Eu conhecia sua voz, seu jeito de se mover.",shape=box,color=blue];
		j527844575 -> j2586930269;
	j2586930269 [label="Covarde!",shape=box,color=blue];
		j2586930269 -> j647386538;
	j647386538 [label="Ele me fez uma única pergunta. Eu realmente acreditava que, algum dia, seria perdoado por reduzir tudo a cinzas?",shape=box,color=blue];
		j647386538 -> j2090484321;
	j2090484321 [label="COVARDE!",shape=box,color=blue];
		j2090484321 -> j1334409817;
	j1334409817 [label="Naquela mão pálida e estendida… uma seringa. Brilhando, com a liberdade… com outra chance… com outra vida.",shape=box,color=blue];
		j1334409817 -> j477397980;
	j477397980 [label="Eu a tomei.",shape=box,color=blue];
		j477397980 -> j421724155;
	j421724155 [label="COVARDE!",shape=box,color=blue];
		j421724155 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
