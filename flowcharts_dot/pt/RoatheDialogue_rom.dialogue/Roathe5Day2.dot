	j1596674194 [label="Mas o que isso importa para você?",shape=box,color=blue];
		j1596674194 -> j4083106162;
	j2069587903 [label="Pode ser. É bem provável que você tenha razão. Mas não tenho outras opções, não é? Vale a pena tentar.",shape=box,color=blue];
		j2069587903 -> j1058876173;
	j3604103882 [label="E se for esse o caso, você pode simplesmente repetir o feito. É como se você tivesse um dom inesgotável, não é?",shape=box,color=blue];
		j3604103882 -> j1058876173;
	j2602667142 [label="Muito provavelmente. Vou juntar as peças e te culpar por algo que eu não te pedi. Tenho certeza de que você vai superar essa crise.",shape=box,color=blue];
