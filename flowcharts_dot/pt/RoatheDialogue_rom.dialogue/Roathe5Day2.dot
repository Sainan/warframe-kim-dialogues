		j2461658793 -> j1776100240;
	j3862106514 [label="Trágico, não é? Saber que os últimos membros da família Entrati jamais saberão que o mordomo definha aqui embaixo, lamentando-se em profunda tristeza? Completamente sozinho?",shape=box,color=blue];
		j3862106514 -> j1776100240;
