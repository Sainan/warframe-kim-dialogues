		j2304643196 -> j4195901503 [label="false",color=purple];
	j517835813 [label="E aqui estamos nós, de braços cruzados. Ou você realmente não tem nada melhor para fazer, Usurpador, ou já tem tudo o que quer de mim. Qual das duas opções é a correta?",shape=box,color=blue];
