	j4185728202 [label="Boolean IsDating is now false.",color=orange];
		j4185728202 -> j251016378;
	j2098660580 [label="Não fique tão ressentido só porque percebeu agora que foi enganado. Eu lhe ofereci os termos do contrato sem jamais explicar minha parte. Ou você não percebeu?",shape=box,color=blue];
		j2098660580 -> j4246088343;
	j3066983071 [label="Eu lhe ofereci os termos do contrato sem jamais explicar minha parte. Ou você não percebeu?",shape=box,color=blue];
		j3066983071 -> j4246088343;
	j1763542289 [label="\"Preciso de ajuda para recuperar minhas memórias e organizá-las. Uma espécie de assistente temporário.\"",shape=box,color=blue];
		j1763542289 -> j3088725627;
	j856202556 [label="Simplesmente direi que você está mentindo, e isso provavelmente prejudicará irremediavelmente a minha opinião sobre você.",shape=box,color=blue];
		j856202556 -> j681643056;
		j856202556 -> j970443383;
	j3371124528 [label="Cada vez que conversamos, não consigo deixar de me perguntar se as margens que trilhamos lhe são familiares ou desconhecidas. Se estou apenas me repetindo ou se guardo alguma nova surpresa.",shape=box,color=blue];
		j3371124528 -> j2331155282;
	j2633278525 [label="Você cumpriu sua parte do contrato. Chegamos agora ao penúltimo ponto, onde precisamos acertar os detalhes de como executaremos nossa estratégia de ataque.",shape=box,color=blue];
		j2633278525 -> j1333450281;
	j251016378 [label="Boolean RoatheDating is now false.",color=orange];
		j251016378 -> j211906847;
	j4246088343 [label="Eu simplesmente disse o que você ganharia com o acordo. Nunca disse o que você tinha que fazer, ou por quê, para conseguir isso. E você concordou cegamente.",shape=box,color=blue];
		j4246088343 -> j1608257356;
	j3088725627 [label="Embora você tenha cumprido o primeiro critério, \"recuperar minhas memórias\", você falhou espetacularmente no segundo, \"organizá-las\".",shape=box,color=blue];
		j3088725627 -> j2913715056;
	j681643056 [label="Não… não posso fazer isso… não vou fazer isso. Temos que enfrentar isso juntos. Não podemos só conversar sobre isso?",shape=box,color=red];
		j681643056 -> j3341016465;
	j970443383 [label="Eu… realmente não tem outro jeito?",shape=box,color=red];
		j970443383 -> j3341016465;
	j2331155282 [label="De qualquer forma, prefiro que você não me conte. Detesto ser previsível demais. Independentemente disso, você me ajudou a resolver uma questão muito importante para mim. ",shape=box,color=blue];
		j2331155282 -> j3899907330;
	j1333450281 [label="Esta batalha deve ser travada em 3 frentes. Todos devem trabalhar em conjunto para que esta guerra seja vencida.",shape=box,color=blue];
		j1333450281 -> j2789933290;
		j1333450281 -> j3920658219;
	j211906847 [label="Bem, seja lá o que for que você queira de mim, não terá agora. Pode muito bem acabar com isso e apagar da minha memória essa nossa farsa, \"querido Peregrino\".",shape=box,color=blue];
		j211906847 -> j1321934788;
	j1608257356 [label="Acredito que isso seja o que antigamente se chamava de \"cheque em branco\", não é? E você o assinou de livre e espontânea vontade.",shape=box,color=blue];
		j1608257356 -> j308026649;
		j1608257356 -> j2189569685;
	j2913715056 [label="Eu diria que eles dificilmente estão reconciliados, não é?",shape=box,color=blue];
		j2913715056 -> j1943636054;
	j3341016465 [label="Não. Se você quer que o mordomo suba, me faça esquecer tudo isso, como eu pedi. Se não se importa, faça como quiser. Para mim, tanto faz.",shape=box,color=blue];
		j3341016465 -> j3117722567;
	j3899907330 [label="Dormi melhor ontem à noite do que em muito tempo. Diria \"mais tempo do que consigo me lembrar\", mas isso seria uma piada de muito mau gosto.",shape=box,color=blue];
		j3899907330 -> j524892499;
	j2789933290 [label="Como é?",shape=box,color=red];
		j2789933290 -> j3908054492;
	j3920658219 [label="Tá falando do Loid?",shape=box,color=red];
		j3920658219 -> j122724914;
	j308026649 [label="Existe alguma maneira de eu te fazer mudar de ideia?",shape=box,color=red];
		j308026649 -> j1052180930;
	j2189569685 [label="Como faço pra sair dessa?",shape=box,color=red];
		j2189569685 -> j1421680082;
