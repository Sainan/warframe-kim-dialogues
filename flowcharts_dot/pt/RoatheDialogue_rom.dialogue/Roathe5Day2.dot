		j1943636054 -> j308026649;
		j1943636054 -> j3820439006;
	j3117722567 [label="Isso, e… bem, claro, nossa amizade pessoal é a única vantagem que tenho nessa situação. É simples assim.",shape=box,color=blue];
		j3117722567 -> j3325160621;
	j524892499 [label="Então, por sua vez, eu o ajudarei agora. O mordomo. Deseja ainda reuni-lo com a família de Albrecht lá em cima?",shape=box,color=blue];
		j524892499 -> j744968765;
	j3908054492 [label="O mordomo. Reuni-lo com a família de Albrecht. Você ainda deseja fazer isso, não é?",shape=box,color=blue];
