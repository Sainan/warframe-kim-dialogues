		j2079730311 -> "Chat ends.";
	j2326804996 [label="Mesmo que isso signifique que ficaremos presos para sempre neste impasse? Pobre e triste Usurpador… muito bem. O purgatório é uma melhoria em relação ao inferno para um diabo, não é?",shape=box,color=blue];
		j2326804996 -> j340930295;
	j619201404 [label="Ótimo. Mãos à obra. Estou cansado de viver com esse conhecimento na cabeça.",shape=box,color=blue];
