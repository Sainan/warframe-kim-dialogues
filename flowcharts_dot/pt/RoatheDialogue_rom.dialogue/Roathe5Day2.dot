		j617454213 -> "Chat ends." [label="x <= 21",color=purple];
		j617454213 -> "Chat ends." [label="false",color=purple];
	j1417856164 [label="Um novo dia amanhece e me vejo planejando o futuro pela primeira vez em… muito tempo. Pensando em como eu poderia transformar o mundo ao meu redor. Em como eu poderia usar o que sei. O que sou. Como eu poderia fazer melhor uso disso.",shape=box,color=blue];
		j1417856164 -> j3984658869;
	j190731246 [label="Um novo dia amanhece e me vejo planejando o futuro pela primeira vez em… muito tempo. Refletindo sobre o que isso significa para mim, sobre o que eu quero, sobre como desejo remodelar meu ambiente para que ele se adapte a mim.",shape=box,color=blue];
		j190731246 -> j2558396776;
	j3423757966 [label="Posso perguntar exatamente o que você está esperando? Estou aqui com a minha memória dos acontecimentos perfeitamente intacta. Você me deu a sua palavra de que os apagaria da minha mente.",shape=box,color=blue];
		j3423757966 -> j2769297441;
		j3423757966 -> j3714024627;
		j3423757966 -> j1001360863;
	j3075834724 [label="Você já se decidiu? Sou um diabo paciente, mas tenho meus limites. Vai apagar essas memórias da minha mente ou prefere me deixar aqui, presa a elas?",shape=box,color=blue];
		j3075834724 -> j2816337354;
		j3075834724 -> j4111975273;
	j4195901503 [label="Aqui estamos, e aqui permaneceremos. Neste purgatório. Espero que goste daqui, pois não creio que iremos além disso.",shape=box,color=blue];
		j4195901503 -> j2171950327;
	j448411312 [label="Como assim?",shape=box,color=red];
