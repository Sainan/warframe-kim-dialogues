		j4083106162 -> "Chat ends.";
	j1058876173 [label="Tenho certeza de que ficarei terrivelmente irritado com você quando perceber que você alterou minhas memórias, é claro. E sugiro que não me diga que foi a meu pedido, querido.",shape=box,color=blue];
