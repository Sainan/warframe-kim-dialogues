	2269 [label="Eu era perito em muitas de nossas armas, mas me destacava no uso de uma em particular: a mentira.",shape=box,color=blue];
		2269 -> 5711;
	5711 [label="Eu a brandia com mais frequência contra minhas próprias tropas. Eu as subjugava com mentiras sobre dever e disciplina.",shape=box,color=blue];
