	j2351906824 [label="ÁUDIO: MENTIRAS",shape=box,color=blue];
		j2351906824 -> j613819959;
	j613819959 [label="Eu era perito em muitas de nossas armas, mas me destacava no uso de uma em particular: a mentira.",shape=box,color=blue];
		j613819959 -> j366321940;
	j366321940 [label="Eu a brandia com mais frequência contra minhas próprias tropas. Eu as subjugava com mentiras sobre dever e disciplina.",shape=box,color=blue];
		j366321940 -> j491997663;
	j491997663 [label="Eu as sufocava com a mentira de que a guerra poderia ser vencida. Eu as feria com a mentira do meu favor, da minha mais estimada consideração por elas.",shape=box,color=blue];
		j491997663 -> j2436607266;
	j2436607266 [label="Sozinho, em particular, eu voltava essa arma contra mim mesmo. Ah, como eu sangrei.",shape=box,color=blue];
		j2436607266 -> j1648694156;
	j1648694156 [label="Add 1 to HellStory counter",color=orange];
		j1648694156 -> "Chat ends. Next chat will be RoatheStory16.";
