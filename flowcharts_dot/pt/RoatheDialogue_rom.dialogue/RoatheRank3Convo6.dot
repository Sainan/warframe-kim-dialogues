	2060 [label="Ele não sabe quem você é",shape=box,color=red];
		2060 -> 2065;
	2061 [label="O Pássaro 3 gosta de todo mundo",shape=box,color=red];
		2061 -> 2066;
	2062 [label="Você gosta de andar com gente que faz você se sentir inteligente",shape=box,color=red];
		2062 -> 2067;
	2063 [label="Ele tem um olhar muito atento às pessoas ao seu redor",shape=box,color=red];
		2063 -> 2068;
	2064 [label="Ele é fácil de manipular",shape=box,color=red];
		2064 -> 2069;
	2065 [label="Sim. De certa forma, é exatamente isso. Ele não sabe quem eu sou. Não sabe nada sobre o \"Diabo de Tau\". E, além disso, não se importa.",shape=box,color=blue];
		2065 -> 2070;
	2066 [label="Sim, de fato. Ele é encantador em sua inocência ingênua. Mas o que você está dizendo, de uma forma um pouco mais gentil e indireta, é que ninguém mais poderia me amar, é isso?",shape=box,color=blue];
		2066 -> 2071;
	2067 [label="Gostaria que você entendesse o quão equivocado você está. O quão longe do alvo sua flecha voa… mas você não está sozinho nessa opinião sobre mim.",shape=box,color=blue];
		2067 -> 2072;
	2068 [label="Sim, de fato. E suas observações são bastante úteis, mas nada que eu não pudesse pensar sozinho em poucos instantes.",shape=box,color=blue];
		2068 -> 2073;
	2069 [label="Gostaria que você entendesse o quão equivocado você está. O quão longe do alvo sua flecha voa… mas você não está sozinho nessa opinião sobre mim.",shape=box,color=blue];
		2069 -> 2074;
	2070 [label="+10 Chemistry",color=orange];
		2070 -> 2075;
	2071 [label="Então, eu preciso da companhia desse pássaro idiota? Mas você está perto o suficiente da verdade, então acho que vou te dar… uma nota suficiente para passar.",shape=box,color=blue];
		2071 -> 2075;
	2072 [label="Nem um pouco.",shape=box,color=blue];
		2072 -> 2076;
	2073 [label="O que você está dizendo, de uma forma um pouco mais gentil e indireta, é que acredita que estou usando o grande pássaro falante para meus próprios fins? É isso?",shape=box,color=blue];
		2073 -> 2077;
	2074 [label="Nem um pouco.",shape=box,color=blue];
		2074 -> 2078;
	2075 [label="Para ele, eu não sou Roathe. Não sou Orokin. Não sou um criminoso. Nem um traidor. Nem um covarde. Posso simplesmente ser… eu mesmo.",shape=box,color=blue];
		2075 -> 2079;
	2076 [label="Update boolean RoatheAlone1",color=orange];
