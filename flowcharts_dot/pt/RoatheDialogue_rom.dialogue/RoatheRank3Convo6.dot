	2088 [label="Add -1 to Thermostat",color=orange];
		2088 -> 2091;
	2089 [label="Se fosse tão simples, e tudo isso fosse uma grande fachada que eu pudesse trocar como quem troca de máscara! Não, Usurpador. Este sou eu, até o osso.",shape=box,color=blue];
		2089 -> 2092;
	2090 [label="Se fosse tão simples, Usurpador. Você faz tudo parecer tão tentador. Posso mesmo? Talvez… talvez não seja tarde demais, nem mesmo para um diabo triste e trágico como eu.",shape=box,color=blue];
		2090 -> 2093;
	2091 [label="+10 Chemistry",color=orange];
		2091 -> 2094;
	2092 [label="Mas isso não significa que eu não aprecie a oportunidade de desabafar por algumas horas e simplesmente desfrutar de uma conversa com alguém que não faça a menor ideia de todos os crimes terríveis que cometi ao longo da minha vida.",shape=box,color=blue];
		2092 -> 2095;
	2093 [label="+10 Chemistry",color=orange];
		2093 -> 2096;
	2094 [label="É exaustivo, Usurpador. E quem me dera poder abandonar essa imagem como se fosse uma máscara de baile de máscaras e nunca mais retomá-la. Mas é isso que eu sou, até o osso.",shape=box,color=blue];
		2094 -> 2092;
	2095 [label="Update boolean RoatheBirdThree",color=orange];
		2095 -> 2097;
		2095 -> 2098;
	2096 [label="Será tudo isso apenas uma grande máscara que uso? Ou será que está enraizado até os meus ossos podres? Ainda não sei. Tudo o que posso dizer é que ainda aprecio a oportunidade de me expor completamente por algumas horas, sempre que posso.",shape=box,color=blue];
		2096 -> 2099;
	2097 [label="Me desculpa se isso parecer rude, mas… parece que sua vida tem sido meio solitária",shape=box,color=red];
