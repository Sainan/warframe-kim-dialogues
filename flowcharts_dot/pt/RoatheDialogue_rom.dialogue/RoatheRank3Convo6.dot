	2102 [label="Talvez haja alguma esperança no que você diz. Ou talvez eu esteja me iludindo. E seja apenas um momento de alívio.",shape=box,color=blue];
		2102 -> 2109;
	2106 [label="Sim, foi. Ou pelo menos, é o que me lembro. Ou foi isso que você entendeu de mim, Usurpador? Que éramos amantes, que eu lhe confessei meu amor e você não sentia o mesmo?",shape=box,color=blue];
		2106 -> 2113;
	2105 [label="Admito que sim. Pelo menos do que me lembro. Ficaria chocado em saber que nunca estive apaixonado? Pelo menos não recíproco. Talvez não. Afinal, provavelmente já passamos por tudo isso antes.",shape=box,color=blue];
		2105 -> 2112;
	2104 [label="Foi uma longa e solitária jornada. Mas tudo isso é obra minha, Usurpador. Não estou aqui para obter sua simpatia ou sua pena.",shape=box,color=blue];
		2104 -> 2111;
	2103 [label="Admito que sim. Pelo menos do que me lembro. Ficaria chocado ao saber que nunca estive apaixonado? Mas a culpa é toda minha, Usurpador. Não estou aqui para obter sua simpatia ou sua pena.",shape=box,color=blue];
		2103 -> 2110;
	2108 [label="Quem sabe? Talvez eu tivesse amigos e simplesmente não me lembro deles porque éramos amigos antes de você acabar com isso, né?",shape=box,color=blue];
