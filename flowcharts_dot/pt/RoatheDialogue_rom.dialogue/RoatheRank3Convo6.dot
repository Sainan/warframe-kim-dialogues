		2051 -> 2054;
	2055 [label="Hmm… bem, eu os considero algumas das criações mais inequivocamente tristes e patéticas que já encontrei em todo o amaldiçoado Sistema de Origem. ",shape=box,color=blue];
		2055 -> 2057;
	2053 [label="Para evitar o mínimo possível de mal-entendidos nesta situação, vou evitar meu habitual vocabulário e dizer simplesmente o seguinte: ",shape=box,color=blue];
		2053 -> 2056;
	2054 [label="Chat ends.",color=orange];
	2057 [label="Animais de laboratório… animais de laboratório, Albrecht! Você jogou animais no maldito Void e depois, quando eles saíram balbuciando em seu idioma infantil e inventado, você mandou seu mordomo sacrificá-los?!",shape=box,color=blue];
		2057 -> 2059;
	2056 [label="Não.",shape=box,color=blue];
		2056 -> 2058;
	2059 [label="Sempre deixando que os outros façam o trabalho sujo. Mas estou divagando. Você está me perguntando por que eu sento e converso com elas. Principalmente com o pássaro. É simples. Mas acho que gostaria que você tentasse adivinhar. Quero ver se você consegue descobrir.",shape=box,color=blue];
		2059 -> 2060;
		2059 -> 2061;
		2059 -> 2062;
