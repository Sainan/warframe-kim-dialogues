digraph {
	2743 [label="RoatheRank4Convo6 begins.",color=orange];
		2743 -> 2744;
	2744 [label="Qual é a sua forma favorita de matar, Usurpador?",shape=box,color=blue];
		2744 -> 2746;
		2744 -> 2747;
		2744 -> 2745;
	2746 [label="Oi?",shape=box,color=red];
		2746 -> 2749;
	2747 [label="Tá querendo descobrir, é?",shape=box,color=red];
		2747 -> 2750;
	2745 [label="[Encerrar Conversa]",shape=box,color=red];
		2745 -> 2748;
	2749 [label="Ultimamente, tenho me pegado divagando filosoficamente e estou simplesmente curioso.",shape=box,color=blue];
		2749 -> 2751;
	2750 [label="Há! Dificilmente. Mas… trocar uns socos com você seria bem divertido. Não, ultimamente ando filosofando e estou simplesmente curioso.",shape=box,color=blue];
		2750 -> 2751;
	2748 [label="Chat ends.",color=orange];
	2751 [label="Em números, acho que você e eu estamos em pé de igualdade. Letalidade, hum… não gostaria de apostar, nem estou particularmente interessado em uma competição de quem tem a maior espada proverbial.",shape=box,color=blue];
		2751 -> 2752;
	2752 [label="De assassino para assassino… qual você prefere? Prefere um confronto corpo a corpo? Prefere furtividade ou o caos do campo de batalha?",shape=box,color=blue];
		2752 -> 2753;
		2752 -> 2754;
		2752 -> 2755;
		2752 -> 2756;
	2753 [label="Prefiro o caos. Explosões, tiros, barulhos altos. Quanto mais, melhor",shape=box,color=red];
		2753 -> 2757;
	2754 [label="Furtividade. Prefiro eliminar meu inimigo antes mesmo que ele me perceba. Se pudesse, faria isso onde ele dorme",shape=box,color=red];
		2754 -> 2758;
	2755 [label="Odeio brigar, gostaria de nunca ter que fazer isso",shape=box,color=red];
		2755 -> 2759;
	2756 [label="Essa conversa é doentia",shape=box,color=red];
		2756 -> 2760;
	2757 [label="Update boolean RoatheSoldier",color=orange];
		2757 -> 2761;
	2758 [label="Update boolean RoatheAssassin",color=orange];
		2758 -> 2762;
	2759 [label="Ah, meu pobre, pobre usurpador, se ao menos você pudesse ter me ouvido rir…",shape=box,color=blue];
		2759 -> 2763;
	2760 [label="Então, xô.",shape=box,color=blue];
		2760 -> 2764;
	2761 [label="Um soldado veterano como eu. Não me surpreende, dado o que sei do seu histórico. Tanto sangue o segue aonde quer que vá. Primeiro Duviri, depois \"Narmer\", esta Holvânia. Agora, este problema aqui.",shape=box,color=blue];
		2761 -> 2765;
	2762 [label="Ah, um assassino entre nós! Tão útil e tão pouco reconhecido. Sempre comparei assassinos a mordomos talentosos.",shape=box,color=blue];
		2762 -> 2766;
	2763 [label="Criatura miserável e destituída. Espero, pelo seu próprio bem, que esteja mentindo para mim.",shape=box,color=blue];
		2763 -> 2767;
	2764 [label="Chat ends.",color=orange];
	2765 [label="Quem sabe o que mais, ou no caso, o que você esqueceu nesse meio tempo. A morte é a sua arte e você pinta os mundos nela.",shape=box,color=blue];
		2765 -> 2768;
	2766 [label="Quando desempenham suas funções de forma excepcional, passam sempre despercebidos.",shape=box,color=blue];
		2766 -> 2769;
	2767 [label="+20 Chemistry",color=orange];
		2767 -> 2770;
	2768 [label="Então, qual é o seu pincel favorito? Vamos descobrir!",shape=box,color=blue];
		2768 -> 2771;
		2768 -> 2772;
		2768 -> 2773;
		2768 -> 2774;
	2769 [label="Então? Adaga? Veneno? Arco?",shape=box,color=blue];
		2769 -> 2775;
		2769 -> 2776;
		2769 -> 2777;
		2769 -> 2778;
		2769 -> 2779;
	2770 [label="Caso contrário, essa pode ser a coisa mais triste que já ouvi em todos os meus anos.",shape=box,color=blue];
		2770 -> 2780;
	2771 [label="Me viro com o que tiver, sinceramente. Gosto de improvisar",shape=box,color=red];
		2771 -> 2781;
	2772 [label="Um arco, gracioso e mortal",shape=box,color=red];
		2772 -> 2782;
	2773 [label="Uma lâmina, gosto de chegar perto",shape=box,color=red];
		2773 -> 2783;
	2774 [label="Rifles e armas. Barulhentos, mas cumprem sua função",shape=box,color=red];
		2774 -> 2784;
	2775 [label="Me viro com o que tiver, sinceramente. Gosto de improvisar",shape=box,color=red];
		2775 -> 2785;
	2776 [label="Um arco, gracioso e silencioso",shape=box,color=red];
		2776 -> 2786;
	2777 [label="Rifle de precisão. Um tiro, uma morte",shape=box,color=red];
		2777 -> 2787;
	2778 [label="Veneno. Eu sumo antes mesmo que eles percebam que já morreram",shape=box,color=red];
		2778 -> 2788;
	2779 [label="Adaga. Gosto da intimidade que ela proporciona",shape=box,color=red];
		2779 -> 2789;
	2780 [label="Update boolean RoatheWeaponNone",color=orange];
		2780 -> 2790;
	2781 [label="Estou aqui imaginando você devastando o campo de batalha com uma maca de médico. Atropelando soldados com um pneu amarrado a um cano torto.",shape=box,color=blue];
		2781 -> 2791;
	2782 [label="Empunhar um arco no calor da batalha exige uma determinação e uma clareza mental que poucos conseguem reunir. E, claro, mãos firmes.",shape=box,color=blue];
		2782 -> 2792;
	2783 [label="Hmm, cuidado. Não me excite demais, Usurpador. Como eu adoraria ver você dançando pelo campo de batalha, armas em punho, respingos de sangue como pétalas de uma flor desabrochando…",shape=box,color=blue];
		2783 -> 2793;
	2784 [label="Eles têm sido a força motriz de qualquer guerra desde o momento em que foram inventados, por um motivo, Usurpador. É difícil, no entanto, negar que, quando atingem seu alvo, cumprem seu objetivo.",shape=box,color=blue];
		2784 -> 2794;
	2785 [label="Estou aqui imaginando você assassinando alguém com um talher ou o pé de uma cadeira. Extinguindo a vida de alguém com o prendedor de uma cortina.",shape=box,color=blue];
		2785 -> 2795;
	2786 [label="O método do caçador. Simples, porém elegante em sua essência. Às vezes, os métodos mais fáceis e antigos são, em sua essência, os mais eficazes.",shape=box,color=blue];
		2786 -> 2796;
	2787 [label="Um pouco impessoal e clínico para o meu gosto, mas não posso julgar sua eficácia. A tranquilidade, sem dúvida, é um ponto positivo.",shape=box,color=blue];
		2787 -> 2797;
	2788 [label="O sinistro apotecário, é? Preparando confecções e despejando o conteúdo dos frascos nos copos dos desavisados? Ou envenenando facas e balas para que o menor golpe de raspão no campo de batalha se torne fatal?",shape=box,color=blue];
		2788 -> 2798;
	2789 [label="Hmm, cuidado. Não me deixe muito animado, Usurpador. Que intrigante, a imagem de acordar uma noite e te encontrar espreitando nas sombras, uma adaga em punho, pronto para atacar…",shape=box,color=blue];
		2789 -> 2799;
	2790 [label="Chat ends.",color=orange];
	2791 [label="+10 Chemistry",color=orange];
		2791 -> 2800;
	2792 [label="O silêncio de tudo isso deve ser apreciado. O ato de engatilhar uma flecha, tensioná-la, a expectativa do disparo… e então a doce, doce morte quando ela encontra seu alvo?",shape=box,color=blue];
		2792 -> 2801;
	2793 [label="Compreendo o desejo pelo toque pessoal. Observar os membros da sua vítima se desprenderem enquanto você põe fim à sua vida. Ver seus corpos sem vida se desfazerem diante de você. Saber que foi você quem fez isso, e ninguém mais.",shape=box,color=blue];
		2793 -> 2802;
	2794 [label="Desorganizado, barulhento, absurdamente caro. Mas tão, tão bom em matar.",shape=box,color=blue];
		2794 -> 2803;
	2795 [label="+10 Chemistry",color=orange];
		2795 -> 2804;
	2796 [label="O silêncio de tudo isso deve ser apreciado. O ato de engatilhar uma flecha, tensioná-la, a expectativa do disparo… e então a doce, doce morte quando ela encontra seu alvo?",shape=box,color=blue];
		2796 -> 2805;
	2797 [label="No aparente clamor implacável do campo de batalha, o atirador de elite precisa encontrar o fôlego, como a maré do oceano. Inspira, expira e tira uma vida.",shape=box,color=blue];
		2797 -> 2806;
	2798 [label="Já vi batalhões inteiros reduzidos a lama por causa de um único corte no braço de um único soldado. Uma toxina que se espalha do sangue para os pulmões e para os pulmões de outra pessoa pode destruir países.",shape=box,color=blue];
		2798 -> 2807;
	2799 [label="Aprecio o desejo pelo toque pessoal. Olhar nos olhos de outra pessoa e vê-los ficarem vidrados e opacos à medida que a luz se apaga e o calor se dissipa do seu corpo.",shape=box,color=blue];
		2799 -> 2808;
	2800 [label="Eu… não consigo decidir se isso te torna mais ou menos assustador, Usurpador. Acho que vou optar por mais. De qualquer forma, acho isso divertido e impressionante por si só.",shape=box,color=blue];
		2800 -> 2809;
	2801 [label="+10 Chemistry",color=orange];
		2801 -> 2810;
	2802 [label="+10 Chemistry",color=orange];
		2802 -> 2811;
	2803 [label="+10 Chemistry",color=orange];
