		2809 -> 2818;
		2809 -> 2819;
		2809 -> 2820;
	2810 [label="Lindo.",shape=box,color=blue];
		2810 -> 2821;
	2811 [label="Que momento lindo.",shape=box,color=blue];
		2811 -> 2822;
	2812 [label="Existe um certo tipo de beleza nisso.",shape=box,color=blue];
		2812 -> 2823;
	2813 [label="Update boolean RoatheWeaponImprov",color=orange];
		2813 -> 2818;
		2813 -> 2819;
		2813 -> 2820;
	2814 [label="Lindo.",shape=box,color=blue];
		2814 -> 2824;
	2815 [label="Há beleza nisso.",shape=box,color=blue];
		2815 -> 2825;
	2816 [label="Morte em tal escala? Há beleza nisso.",shape=box,color=blue];
		2816 -> 2826;
	2817 [label="Que momento lindo.",shape=box,color=blue];
		2817 -> 2827;
	2818 [label="Você tá fazendo isso soar como se fosse algum tipo de… forma de arte",shape=box,color=red];
		2818 -> 2828;
	2819 [label="Não gosto de ter que matar, Roathe",shape=box,color=red];
		2819 -> 2829;
	2820 [label="E qual é o seu favorito?",shape=box,color=red];
		2820 -> 2830;
	2821 [label="Update boolean RoatheWeaponBow",color=orange];
		2821 -> 2818;
		2821 -> 2819;
		2821 -> 2820;
	2822 [label="Update boolean RoatheWeaponDagger",color=orange];
		2822 -> 2818;
