		2824 -> 2818;
		2824 -> 2819;
		2824 -> 2820;
	2825 [label="Update boolean RoatheWeaponSniper",color=orange];
		2825 -> 2818;
		2825 -> 2819;
		2825 -> 2820;
	2826 [label="Update boolean RoatheWeaponPoison",color=orange];
		2826 -> 2818;
		2826 -> 2819;
		2826 -> 2820;
	2827 [label="Update boolean RoatheWeaponDagger",color=orange];
		2827 -> 2818;
		2827 -> 2819;
		2827 -> 2820;
	2828 [label="Porque é verdade. E você sabe disso. Aliás, metade da sua existência se baseia, literalmente, no conceito de matar como forma de arte!",shape=box,color=blue];
		2828 -> 2831;
	2829 [label="Ah, é mesmo? Vamos analisar isso com calma.",shape=box,color=blue];
		2829 -> 2832;
	2830 [label="Isso mudou recentemente. E isso me incomoda demais.",shape=box,color=blue];
		2830 -> 2833;
		2830 -> 2834;
	2831 [label="Vejo essas \"escolas\" que os Tennos usam, e que vocês tomam emprestadas indiretamente. Sem falar dos ensinamentos dos Dax. Como eles tagarelavam sem parar no rádio, não importava quantas vezes disséssemos que era um canal restrito.",shape=box,color=blue];
		2831 -> 2835;
	2832 [label="Diga-me algo, e por favor, responda-me honestamente. Porque mentir neste momento prejudica a nós dois, mas principalmente a você.",shape=box,color=blue];
		2832 -> 2836;
	2833 [label="Mudou, como?",shape=box,color=red];
		2833 -> 2837;
	2834 [label="Por causa do Uriel?",shape=box,color=red];
		2834 -> 2838;
	2835 [label="Se eu nunca mais ouvir um deles me dizer que \"sou uma lâmina\" e que \"existo para atacar\", morrerei feliz, Usurpador.",shape=box,color=blue];
		2835 -> 2839;
	2836 [label="Você já tentou se equipar com um Warframe ou uma arma personalizados ao seu gosto? Talvez com uma pintura exclusiva, ou um visual que combine mais com seu humor?",shape=box,color=blue];
		2836 -> 2840;
		2836 -> 2842;
		2836 -> 2841;
	2837 [label="Eu costumava preferir a espada como arma. Elegante. Rápida. Eu podia me mover pelo campo de batalha e cortar meus inimigos à queima-roupa. Carmesim sobre uma lâmina prateada, reluzindo no brilho de uma estrela azul.",shape=box,color=blue];
		2837 -> 2843;
	2838 [label="Presumo que sim. Ou talvez seja por causa das minhas memórias perdidas. Não sei que outras razões poderiam ser a causa.",shape=box,color=blue];
		2838 -> 2837;
	2839 [label="A humanidade sempre encarou o \"assassinato\" como um pecado, mas o \"matar\" como uma arte. Nunca lhe pareceu estranho? Empunhar uma lâmina e abater um inimigo em combate é ser visto como um ser quase transcendental.",shape=box,color=blue];
		2839 -> 2844;
	2840 [label="Sim… o que isso tem a ver com alguma coisa?",shape=box,color=red];
		2840 -> 2845;
	2842 [label="Não, nunca",shape=box,color=red];
		2842 -> 2847;
	2841 [label="Nem vem, tô fora dessa [Encerrar Conversa]",shape=box,color=red];
		2841 -> 2846;
	2843 [label="Mas agora? Agora eu quero sentir o gosto do sangue nos meus dentes. Sentir ele jorrar sob minhas garras. Quero afundar meus dedos na carne e nos ossos e despedaçá-los.",shape=box,color=blue];
		2843 -> 2848;
	2844 [label="Matar um homem com um pedaço de metal afiado em um beco é ser covarde e degenerado. ",shape=box,color=blue];
		2844 -> 2849;
	2845 [label="Agradeço sua honestidade. Agora, não vou argumentar que você provavelmente não sente prazer em cometer assassinatos a sangue frio, e que o massacre de uma vida inocente não é algo que lhe dê deleite (embora talvez sinta, e sua declaração anterior tenha sido uma mentira, e como seria delicioso revelar isso, mas não é disso que estamos aqui para discutir).",shape=box,color=blue];
		2845 -> 2850;
	2847 [label="Peço que reflita por um longo momento. Vi seus amigos Tennos causando estragos neste lugar, como verdadeiros pesadelos circenses multicoloridos. Como se um animal selvagem tivesse caído nos potes de tinta de um artista. ",shape=box,color=blue];
		2847 -> 2852;
	2846 [label="Muito bem.",shape=box,color=blue];
		2846 -> 2851;
	2848 [label="Quero beber profundamente o icor enquanto estalo os tendões e sinto o corpo se despedaçar sob mim, transformando-se em nada mais que estilhaços de sangue. Descascá-lo como uma fruta doce enquanto a medula escorre.",shape=box,color=blue];
		2848 -> 2853;
		2848 -> 2854;
	2849 [label="Qual é a diferença? \"Honra?\" Quem decide o que é honroso e o que não é? O perdedor? Ou o vencedor? Ou será simplesmente a existência de tradição suficiente para declarar o que é honroso e o que não é?",shape=box,color=blue];
		2849 -> 2857;
		2849 -> 2855;
		2849 -> 2856;
	2850 [label="Supondo, porém, que esse não seja o caso, e que você esteja matando simplesmente porque \"tem que fazer isso\", como você disse, então por que, afinal, você perderia tempo personalizando suas armas de matar?",shape=box,color=blue];
		2850 -> 2858;
	2852 [label="Você nunca se sentiu compelido a fazer o mesmo? Nem uma vez? Juro que não vou te julgar por admitir isso.",shape=box,color=blue];
		2852 -> 2859;
		2852 -> 2860;
	2851 [label="Chat ends.",color=orange];
	2853 [label="Roathe?",shape=box,color=red];
		2853 -> 2861;
	2854 [label="E isso… não é normal pra você?",shape=box,color=red];
		2854 -> 2862;
	2857 [label="Entendo seu ponto de vista, a linha divisória é tênue",shape=box,color=red];
		2857 -> 2865;
	2855 [label="Uma exige prática e dedicação. A outra é simplesmente… brutalidade.",shape=box,color=red];
		2855 -> 2863;
	2856 [label="Não vou ter essa conversa [Encerrar Conversa]",shape=box,color=red];
		2856 -> 2864;
	2858 [label="Por que se preocupar com a sua aparência no campo da morte? Certamente não para que outros identifiquem seu cadáver. Não há como confundi-lo em lugar nenhum. Não, porque se você precisa ser um assassino, meu caro Usurpador, aposto que deseja fazê-lo com estilo.",shape=box,color=blue];
		2858 -> 2866;
	2859 [label="Não",shape=box,color=red];
		2859 -> 2846;
	2860 [label="Tá, já senti. Por quê?",shape=box,color=red];
		2860 -> 2845;
	2861 [label="Sim, eu sei! Eu sei. E não vou fazer nenhuma dessas coisas, entenda bem. Nem vou incendiar tudo aqui, o que me dá uma vontade enorme de fazer.",shape=box,color=blue];
		2861 -> 2867;
	2862 [label="Não! Não, não é! E também não é normal eu ficar com água na boca só de pensar em reduzir este lugar inteiro a cinzas!",shape=box,color=blue];
		2862 -> 2867;
	2865 [label="Todas essas linhas divisórias são traçadas arbitrariamente. E quanto mais cedo todos entendermos isso, mais rápido poderemos chegar a um acordo sobre quais batalhas são importantes e quais não são.",shape=box,color=blue];
		2865 -> 2870;
	2863 [label="Muito bem, vamos seguir essa linha de raciocínio até o fim. Matar com prática suficiente torna o ato honroso? Então, você está dizendo que, se eu for como Dax e simplesmente envolver meu assassinato em pompa e circunstância suficientes, isso o transforma em arte?",shape=box,color=blue];
		2863 -> 2868;
	2864 [label="Muito bem.",shape=box,color=blue];
		2864 -> 2869;
	2866 [label="E o que é isso, senão o prazer do ato, eu pergunto?",shape=box,color=blue];
		2866 -> 2871;
	2867 [label="A culpa deve ser do Uriel. Embora eu admita que já tive tendências a pensamentos tão destrutivos e sanguinários antes, eles não eram nem de longe tão catastróficos.",shape=box,color=blue];
		2867 -> 2872;
	2870 [label="Decidir se um homicídio foi cometido de forma honrosa é como tentar decidir o que é pior, morrer queimado ou afogado. Ambas são mortes miseráveis.",shape=box,color=blue];
		2870 -> 2874;
	2868 [label="Agora estamos entrando na linha tênue entre o ritual e a religião.",shape=box,color=blue];
		2868 -> 2873;
	2869 [label="Chat ends.",color=orange];
	2871 [label="Não me interprete mal! Não estou julgando você. Você está tirando o melhor proveito da sua situação! A morte fez de você seu parceiro de dança nesta grande farsa da vida, e você não tem escolha a não ser atender ao seu chamado.",shape=box,color=blue];
		2871 -> 2875;
	2872 [label="E certamente não tão… apocalíptico.",shape=box,color=blue];
		2872 -> 2876;
	2874 [label="E todos os caminhos levam à sepultura, então qual o sentido de ficar procurando defeitos? Temos problemas muito mais importantes para resolver.",shape=box,color=blue];
		2874 -> 2878;
	2873 [label="Ao menos há honestidade na morte simples e fácil de uma facada pelas costas. Não há nada de piedoso nisso. Nada de ostentoso ou exagerado. Simplesmente acontece.",shape=box,color=blue];
		2873 -> 2877;
	2875 [label="Se você tivesse deposto suas armas, quantos mais estariam mortos ao seu lado, eu me pergunto? Não, por que não sentir um pouco de orgulho do seu trabalho? Um pouco de prazer na arte de tudo isso? Qual é a alternativa, eu pergunto? Loucura? Esquecimento?",shape=box,color=blue];
		2875 -> 2879;
	2876 [label="Chat ends.",color=orange];
	2878 [label="Chat ends.",color=orange];
	2877 [label="Não há arte nisso?",shape=box,color=blue];
		2877 -> 2880;
	2879 [label="Já vi muitos seguirem esse caminho e encontrarem a ponta de uma corda à sua espera. Não. Eu digo: faça o que quiser, usurpador. Pois a vida certamente fez o que quis com você.",shape=box,color=blue];
		2879 -> 2881;
	2880 [label="Chat ends.",color=orange];
	2881 [label="Chat ends.",color=orange];
}