	j2881854363 [label="ÁUDIO: DIVISÃO",shape=box,color=blue];
		j2881854363 -> j2387531246;
	j2387531246 [label="Após a primeira invasão Sentient do Sistema e a desastrosa resposta Orokin, um estranho silêncio reinou.",shape=box,color=blue];
		j2387531246 -> j105400847;
	j105400847 [label="Não tínhamos notícias de nosso pessoal isolado em Tau, e não havia como saber se seus sinais estavam sendo bloqueados ou se haviam sido completamente destruídos.",shape=box,color=blue];
		j105400847 -> j1875808283;
	j1875808283 [label="Fui constantemente solicitado a dar minha opinião. Como estrategista, esperava-se que eu compreendesse o inimigo.",shape=box,color=blue];
		j1875808283 -> j1980341134;
	j1980341134 [label="Os Sentients poderiam ter destruído o Trilho Solar acima de Tau a qualquer momento, mas ele ainda estava ativo.",shape=box,color=blue];
		j1980341134 -> j4291027681;
	j4291027681 [label="Por quê? O que eles ganharam deixando o portal aberto?",shape=box,color=blue];
		j4291027681 -> j2140904659;
	j2140904659 [label="Estavam unidos em sua agressão, ou alguns ainda esperavam por uma coexistência pacífica?",shape=box,color=blue];
