	"Chat ends." [color=orange];
	j525879283 [label="ÁUDIO: SACRIFÍCIO",shape=box,color=blue];
		j525879283 -> j1566017278;
	j1566017278 [label="Traivon, vi você arremessar sua Railjack nas garras da Praghasa. Distraída, devorando avidamente você e seus homens, ela nem percebeu minha nave se afastando em alta velocidade.",shape=box,color=blue];
		j1566017278 -> j2437777146;
	j2437777146 [label="Você deu a vida pelo seu superior. Senti seu altruísmo como um tapa na cara.",shape=box,color=blue];
		j2437777146 -> j3393278977;
	j3393278977 [label="Maryna, você me deu seu corpo. Juntos, naquela trincheira, bebemos Kuva. Minhas mãos tremiam e minha garganta cortada sangrava, mas consegui beber gotas o suficiente.",shape=box,color=blue];
		j3393278977 -> j1658678853;
	j1658678853 [label="Lembro-me da sua última saudação, o desvanecimento. Então, abri os olhos, que antes eram seus, e vi meu cadáver estripado, morto na lama.",shape=box,color=blue];
		j1658678853 -> j590948473;
	j590948473 [label="Rostig, algo errado no processo de clonagem, foi o que me disseram. O que mais poderia fazer um Grineer ficar em sua torreta enquanto queima vivo? Até um rato entende o que é autopreservação!",shape=box,color=blue];
		j590948473 -> j3664492486;
	j3664492486 [label="Não, seu \"defeito\" o colocava acima deles.",shape=box,color=blue];
		j3664492486 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}