	2275 [label="Traivon, vi você arremessar sua Railjack nas garras da Praghasa. Distraída, devorando avidamente você e seus homens, ela nem percebeu minha nave se afastando em alta velocidade.",shape=box,color=blue];
		2275 -> 5713;
	5713 [label="Você deu a vida pelo seu superior. Senti seu altruísmo como um tapa na cara.",shape=box,color=blue];
		5713 -> 5714;
	5714 [label="Maryna, você me deu seu corpo. Juntos, naquela trincheira, bebemos Kuva. Minhas mãos tremiam e minha garganta cortada sangrava, mas consegui beber gotas o suficiente.",shape=box,color=blue];
		5714 -> 2278;
	2278 [label="Lembro-me da sua última saudação, o desvanecimento. Então, abri os olhos, que antes eram seus, e vi meu cadáver estripado, morto na lama.",shape=box,color=blue];
		2278 -> 2272;
	2272 [label="Rostig, algo errado no processo de clonagem, foi o que me disseram. O que mais poderia fazer um Grineer ficar em sua torreta enquanto queima vivo? Até um rato entende o que é autopreservação!",shape=box,color=blue];
