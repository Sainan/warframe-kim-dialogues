	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j93056952 [label="Sinto como se a minha própria compreensão de mim mesmo, a própria base da minha fundação, tivesse sido rachada e dilacerada como a maldita Lua! Reescrita com tinta que escorre. Covarde!",shape=box,color=blue];
		j93056952 -> j2603922807;
