		j4260859386 -> j4266495753;
	j2466273613 [label="Tudo bem, fica com raiva. Mas usa essa raiva pra algo que valha a pena. Usa isso pra se livrar de todo esse ódio que você tem aí dentro, direciona ele pro lado certo",shape=box,color=red];
