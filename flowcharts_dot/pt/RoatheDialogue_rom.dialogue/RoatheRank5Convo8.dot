		j2318547072 -> j1090819130 [label="false",color=purple];
	j3556999108 [label="E eu não sei como saciar isso. Não sei se consigo. Eu tinha esperança de que essas conversas pudessem me mostrar um caminho; mas agora, vejo que é inútil.",shape=box,color=blue];
		j3556999108 -> j3999838094;
	j2348735234 [label="Você não é definido pelo seu passado, Roathe. Você é definido pelo seu futuro. E você ainda tem um futuro pela frente, ao contrário de todos os Orokin que morreram na Noite dos Tambores de Naga",shape=box,color=red];
		j2348735234 -> j1152639978;
	j3259223430 [label="Você não é definido pelas opiniões dos outros, nem pelo que pensam das suas ações. Você é definido só pelo que acredita sobre si mesmo e pelas suas escolhas",shape=box,color=red];
		j3259223430 -> j3199568538;
	j4266495753 [label="Você tá deixando essa raiva te consumir por dentro. Você poderia usar ela pra te ajudar a lutar contra as pessoas que ainda tão destruindo este mundo… hoje, aqui e agora",shape=box,color=red];
		j4266495753 -> j2896342988;
	j819652019 [label="Você tá apontando o dedo pra si mesmo. Deveria estar apontando pro mundo que te culpa por ter feito o melhor que pôde pra salvar eles do Império Orokin",shape=box,color=red];
		j819652019 -> j2599073431;
