	"Chat ends." [color=orange];
	j1539439554 [label="Seu tolo! O que você fez?! Por que, por que ir explorar cavernas onde você não é bem-vindo?!",shape=box,color=blue];
		j1539439554 -> j797934433;
	j797934433 [label="Exijo que você resolva isso. A culpa é sua. Eu consigo sentir, me dilacerando, me consumindo… como uma grande fera.",shape=box,color=blue];
		j797934433 -> j1578607918;
	j1578607918 [label="Livre-me disso. Livre-me dessa praga. Limpe minha mente dessas lembranças. Eu sei que você pode. Use esse dom que você tem e acabe com tudo isso. Agora.",shape=box,color=blue];
		j1578607918 -> j3831088818;
		j1578607918 -> j22899016;
		j1578607918 -> j2358599055;
	j3831088818 [label="Tem certeza? Mas… você é inteligente, tenho a impressão de que vai perceber que tem algo errado",shape=box,color=red];
		j3831088818 -> j1837081590;
	j22899016 [label="É um tipo diferente de memória, Roathe. Não vai funcionar com ela. Isso tá enterrado mais profundamente na sua mente",shape=box,color=red];
		j22899016 -> j465798434;
	j2358599055 [label="Fugir e se esconder da verdade não vai funcionar. Só vamos acabar voltando pro começo",shape=box,color=red];
		j2358599055 -> j3426924384;
	j1837081590 [label="Muito provavelmente. Vou juntar as peças e te culpar por algo que eu não te pedi. Tenho certeza de que você vai superar essa crise.",shape=box,color=blue];
		j1837081590 -> j1873815011;
	j465798434 [label="Pode ser. É bem provável que você tenha razão. Mas não tenho outras opções, não é? Vale a pena tentar.",shape=box,color=blue];
		j465798434 -> j1873815011;
	j3426924384 [label="E se for esse o caso, você pode simplesmente repetir o feito. É como se você tivesse um dom inesgotável, não é?",shape=box,color=blue];
		j3426924384 -> j1873815011;
	j1873815011 [label="Tenho certeza de que ficarei terrivelmente irritado com você quando perceber que você alterou minhas memórias, é claro. E sugiro que não me diga que foi a meu pedido, querido.",shape=box,color=blue];
		j1873815011 -> j2906175004;
	j2906175004 [label="Simplesmente direi que você está mentindo, e isso provavelmente prejudicará irremediavelmente a minha opinião sobre você.",shape=box,color=blue];
		j2906175004 -> j2757187270;
		j2906175004 -> j3654547367;
	j2757187270 [label="Não… não posso fazer isso… não vou fazer isso. Temos que enfrentar isso juntos. Não podemos só conversar sobre isso?",shape=box,color=red];
		j2757187270 -> j3106341333;
	j3654547367 [label="Eu… realmente não tem outro jeito?",shape=box,color=red];
		j3654547367 -> j3106341333;
	j3106341333 [label="Não. Se você quer que o mordomo suba, me faça esquecer tudo isso, como eu pedi. Se não se importa, faça como quiser. Para mim, tanto faz.",shape=box,color=blue];
		j3106341333 -> j2677382148;
	j2677382148 [label="Isso, e… bem, claro, nossa amizade pessoal é a única vantagem que tenho nessa situação. É simples assim.",shape=box,color=blue];
		j2677382148 -> j735540612;
	j735540612 [label="O que você acha?",shape=box,color=blue];
		j735540612 -> j530038803;
		j735540612 -> j3338733694;
	j530038803 [label="Certo… vou fazer isso. Vou apagar sua mente. Mesmo que isso leve a Marie e o Lyon junto",shape=box,color=red];
		j530038803 -> j4283026915;
	j3338733694 [label="Não, me recuso. Me desculpe. Precisamos enfrentar isso",shape=box,color=red];
		j3338733694 -> j152911742;
		j3338733694 -> j3467630719;
	j4283026915 [label="+10 Chemistry",color=orange];
		j4283026915 -> j3796673192;
	j152911742 [label="Vamos conversar sobre isso",shape=box,color=red];
		j152911742 -> j3375402266;
	j3467630719 [label="Pode me odiar se quiser, mas não farei nada até que a gente resolva isso primeiro",shape=box,color=red];
		j3467630719 -> j834687495;
	j3796673192 [label="Ótimo. Mãos à obra. ",shape=box,color=blue];
		j3796673192 -> j4072107213;
	j3375402266 [label="Não se atreva! Não se atreva a falar comigo em \"se acalmar\"! Você acha que eu não tenho todo o direito de me sentir como se estivesse sendo despedaçado?!",shape=box,color=blue];
