		5154 -> 5156 [label="x <= 21",color=purple];
		5154 -> 5156 [label="false",color=purple];
	5153 [label="Chat ends.",color=orange];
	5155 [label="Seu tolo! O que você fez?! Por que, por que ir explorar cavernas onde você não é bem-vindo?!",shape=box,color=blue];
		5155 -> 5157;
	5156 [label="Chat ends.",color=orange];
	5157 [label="Exijo que você resolva isso. A culpa é sua. Eu consigo sentir, me dilacerando, me consumindo… como uma grande fera.",shape=box,color=blue];
		5157 -> 5158;
	5158 [label="Livre-me disso. Livre-me dessa praga. Limpe minha mente dessas lembranças. Eu sei que você pode. Use esse dom que você tem e acabe com tudo isso. Agora.",shape=box,color=blue];
		5158 -> 5159;
		5158 -> 5160;
		5158 -> 5161;
	5159 [label="Tem certeza? Mas… você é inteligente, tenho a impressão de que vai perceber que tem algo errado",shape=box,color=red];
		5159 -> 5162;
	5160 [label="É um tipo diferente de memória, Roathe. Não vai funcionar com ela. Isso tá enterrado mais profundamente na sua mente",shape=box,color=red];
		5160 -> 5163;
	5161 [label="Fugir e se esconder da verdade não vai funcionar. Só vamos acabar voltando pro começo",shape=box,color=red];
		5161 -> 5164;
	5162 [label="Muito provavelmente. Vou juntar as peças e te culpar por algo que eu não te pedi. Tenho certeza de que você vai superar essa crise.",shape=box,color=blue];
		5162 -> 5165;
	5163 [label="Pode ser. É bem provável que você tenha razão. Mas não tenho outras opções, não é? Vale a pena tentar.",shape=box,color=blue];
		5163 -> 5165;
	5164 [label="E se for esse o caso, você pode simplesmente repetir o feito. É como se você tivesse um dom inesgotável, não é?",shape=box,color=blue];
		5164 -> 5165;
	5165 [label="Tenho certeza de que ficarei terrivelmente irritado com você quando perceber que você alterou minhas memórias, é claro. E sugiro que não me diga que foi a meu pedido, querido.",shape=box,color=blue];
		5165 -> 5166;
	5166 [label="Simplesmente direi que você está mentindo, e isso provavelmente prejudicará irremediavelmente a minha opinião sobre você.",shape=box,color=blue];
		5166 -> 5167;
		5166 -> 5168;
	5167 [label="Não… não posso fazer isso… não vou fazer isso. Temos que enfrentar isso juntos. Não podemos só conversar sobre isso?",shape=box,color=red];
		5167 -> 5169;
	5168 [label="Eu… realmente não tem outro jeito?",shape=box,color=red];
		5168 -> 5169;
	5169 [label="Não. Se você quer que o mordomo suba, me faça esquecer tudo isso, como eu pedi. Se não se importa, faça como quiser. Para mim, tanto faz.",shape=box,color=blue];
		5169 -> 5170;
	5170 [label="Isso, e… bem, claro, nossa amizade pessoal é a única vantagem que tenho nessa situação. É simples assim.",shape=box,color=blue];
		5170 -> 5171;
	5171 [label="O que você acha?",shape=box,color=blue];
		5171 -> 5172;
		5171 -> 5173;
	5172 [label="Certo… vou fazer isso. Vou apagar sua mente. Mesmo que isso leve a Marie e o Lyon junto",shape=box,color=red];
		5172 -> 5174;
	5173 [label="Não… eu me recuso. Vou achar outra forma de te convencer",shape=box,color=red];
		5173 -> 5175;
	5174 [label="+10 Chemistry",color=orange];
		5174 -> 5176;
	5175 [label="Desejo-te muita sorte.",shape=box,color=blue];
		5175 -> 5179;
	5176 [label="Ótimo. Mãos à obra. ",shape=box,color=blue];
		5176 -> 5178;
	5179 [label="Update boolean LyonRoatheRepair",color=orange];
		5179 -> 5177;
	5178 [label="Add 1 to Promise",color=orange];
		5178 -> 5180;
	5177 [label="Chat ends.",color=orange];
	5180 [label="Update boolean RoatheWillReset",color=orange];
		5180 -> 5181;
	5181 [label="Chat ends.",color=orange];
}