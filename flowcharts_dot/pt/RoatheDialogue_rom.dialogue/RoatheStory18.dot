	2292 [label="\"Paz?\"",shape=box,color=blue];
		2292 -> 5717;
	5717 [label="Sua voz era como vidro quebrado rangendo nos meus ouvidos.",shape=box,color=blue];
		5717 -> 5718;
	5718 [label="A Executora Nitokh estava descontente. Ela esperava um agravamento glorioso, batalha após batalha, culminando no êxtase climático da destruição dos Orokin.",shape=box,color=blue];
		5718 -> 5719;
	5719 [label="Onde, depois disso, ela emergiria do esconderijo e… bem, aí me resta especular. Talvez ela esperasse ter a confiança dos Sentients.",shape=box,color=blue];
		5719 -> 2291;
	2291 [label="Ou talvez pensasse que eles abandonariam os restos carbonizados e poluídos do Sistema de Origem e a deixariam erguer um novo reino por conta própria.",shape=box,color=blue];
		2291 -> 2297;
	2297 [label="De qualquer forma, a paz não seria tolerada. Então, começamos a trabalhar para miná-la.",shape=box,color=blue];
