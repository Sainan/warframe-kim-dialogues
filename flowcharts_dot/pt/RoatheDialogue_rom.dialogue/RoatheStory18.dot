	j858771902 [label="ÁUDIO: TRAIÇÃO",shape=box,color=blue];
		j858771902 -> j197975792;
	j197975792 [label="\"Paz?\"",shape=box,color=blue];
		j197975792 -> j1583374038;
	j1583374038 [label="Sua voz era como vidro quebrado rangendo nos meus ouvidos.",shape=box,color=blue];
		j1583374038 -> j3823824976;
	j3823824976 [label="A Executora Nitokh estava descontente. Ela esperava um agravamento glorioso, batalha após batalha, culminando no êxtase climático da destruição dos Orokin.",shape=box,color=blue];
		j3823824976 -> j4238754818;
	j4238754818 [label="Onde, depois disso, ela emergiria do esconderijo e… bem, aí me resta especular. Talvez ela esperasse ter a confiança dos Sentients.",shape=box,color=blue];
		j4238754818 -> j438454931;
	j438454931 [label="Ou talvez pensasse que eles abandonariam os restos carbonizados e poluídos do Sistema de Origem e a deixariam erguer um novo reino por conta própria.",shape=box,color=blue];
		j438454931 -> j2305451692;
	j2305451692 [label="De qualquer forma, a paz não seria tolerada. Então, começamos a trabalhar para miná-la.",shape=box,color=blue];
		j2305451692 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}