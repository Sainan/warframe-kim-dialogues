	j1767463089 [label="ÁUDIO: FOGO",shape=box,color=blue];
		j1767463089 -> j208249174;
	j208249174 [label="A monstruosidade e o excesso nos serviram admiravelmente no passado. Esperava-se que eu os aplicasse como táticas de guerra.",shape=box,color=blue];
		j208249174 -> j2515519776;
	j2515519776 [label="Como domesticamos a Infestação na época de nossos ancestrais? Rasgando o coração do átomo, como um botão de rosa, é claro!",shape=box,color=blue];
		j2515519776 -> j1444239659;
	j1444239659 [label="Em uníssono, os Sete me ordenaram que me tornasse um demônio, com um tridente de ogivas nucleares, um semeador com uma sacola de radiação desenfreada.",shape=box,color=blue];
		j1444239659 -> j2368555967;
	j2368555967 [label="Foi naquele dia que descobrimos que os Sentients não só podiam anular nossa tecnologia, como também se apropriar dela.",shape=box,color=blue];
		j2368555967 -> j561354433;
	j561354433 [label="O bando de pequenos drones colonizadores que enviamos retornou alegremente, carregados de bombas, gargalhando em sílabas desconhecidas, detonando no meio das próprias naves-mãe que os despacharam.",shape=box,color=blue];
		j561354433 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
