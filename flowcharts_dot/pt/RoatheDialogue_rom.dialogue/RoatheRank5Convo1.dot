		j3897559639 -> j375947161;
	j3010383887 [label="Quando os lacaios chegaram, três energias se entrelaçaram dentro de mim; a quarta não foi tão surpreendente então. Essa grande e horrível coisa que ansiava por me despedaçar, como a crosta dos planetas se espalha.",shape=box,color=blue];
		j3010383887 -> j383764946;
	j69098628 [label="Lembro-me da sua promessa. E de ter conquistado um lugar tão especial no seu coração que você me mantém nesse estado de purgatório? Obrigado, meu bem. Obrigado.",shape=box,color=blue];
		j69098628 -> j3981071808;
	j3957331622 [label="Que eu tenha conquistado um lugar tão especial no seu coração que você me mantém nesse estado de purgatório? Obrigado, meu bem. Obrigado.",shape=box,color=blue];
		j3957331622 -> j3981071808;
