	j1994750753 [label="E, portanto, nosso apego ao tempo. Eu te peço agora. Não, eu te imploro, que o uses agora em meu favor. Leve esses pensamentos embora de mim. Leve essas lembranças embora de mim.",shape=box,color=blue];
