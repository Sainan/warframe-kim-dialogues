		3334 -> 3356;
	3335 [label="Sinto como se a minha própria compreensão de mim mesmo, a própria base da minha fundação, tivesse sido rachada e dilacerada como a maldita Lua! Reescrita com tinta que escorre. Covarde!",shape=box,color=blue];
		3335 -> 3357;
