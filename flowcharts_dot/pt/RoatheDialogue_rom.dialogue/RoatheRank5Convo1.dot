	j2840357449 [label="Então, muito bem. Que assim seja. Não lhe pedirei isso agora. Mas e se você nunca o fez por diversão, curiosidade ou para tentar corrigir erros cometidos em suas relações com os outros…",shape=box,color=blue];
		j2840357449 -> j2185912702;
