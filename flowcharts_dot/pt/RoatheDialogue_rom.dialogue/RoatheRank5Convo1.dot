		3363 -> 3382;
	3364 [label="Você tem um dom. Um dom que pode desfazer o tempo. Desenrolá-lo em espiral, ou até mesmo em repetição. E isso tem… um efeito interessante nas mentes dos Protoframes, devido à sua ligação com a Infestação e com o tempo. ",shape=box,color=blue];
