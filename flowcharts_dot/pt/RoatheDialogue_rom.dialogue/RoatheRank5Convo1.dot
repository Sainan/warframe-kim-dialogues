	j3398931564 [label="Eu te disse para parar com essas suas incursões na minha mente antes que fosse tarde demais! Eu te disse para parar com o que estava fazendo, e ainda assim… e mesmo assim…",shape=box,color=blue];
		j3398931564 -> j4041967327;
	j2049158895 [label="Você escondeu isso de mim, só para revelar agora? Tudo isso foi um jogo doentio para você?! Alimentando aquela coisa que se escondia dentro de mim, sabendo o que me aconteceria?!",shape=box,color=blue];
		j2049158895 -> j2557171164;
