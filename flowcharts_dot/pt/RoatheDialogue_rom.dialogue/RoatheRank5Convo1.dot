	"Chat ends." [color=orange];
	j3185298445 [label="E agora eu me lembro, meu querido Peregrino. Lembro-me de como implorei desesperadamente para que você se libertasse. E de como você jurou que faria isso. E você fez.",shape=box,color=blue];
		j3185298445 -> j1459328372;
	j1427372158 [label="E agora me lembro, meu querido Peregrino. Agora me lembro do que pedi e do que você se recusou a fazer. Pedi que você apagasse esses pensamentos da minha mente, e você disse não. Mesmo assim, aqui estamos nós. Não é verdade?",shape=box,color=blue];
