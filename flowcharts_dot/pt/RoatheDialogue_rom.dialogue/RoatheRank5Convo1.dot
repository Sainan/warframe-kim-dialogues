	j1200631365 [label="Difamados, incompreendidos, anátema. Expulsos dos céus e deixados para apodrecer. Almas gêmeas, de fato!",shape=box,color=blue];
		j1200631365 -> j3010383887;
	j1528809464 [label="Sei que não é a primeira vez que passamos por isso. Lembro-me de já ter estado aqui antes. E sei que talvez não seja a última. Peço constantemente que pare aqui e recomece, significaria muito para mim.",shape=box,color=blue];
		j1528809464 -> j69098628;
	j3356806107 [label="Sei que não é a primeira vez que passamos por isso. Lembro-me de já ter estado aqui antes. E sei que talvez não seja a última. Peço constantemente que pare aqui e recomece, significaria muito para mim.",shape=box,color=blue];
		j3356806107 -> j3957331622;
	j75132481 [label="Sei que não é a primeira vez que passamos por isso. Lembro-me de já ter estado aqui antes. E sei que talvez não seja a última. Peço constantemente que pare aqui e recomece, significaria muito para mim.",shape=box,color=blue];
		j75132481 -> j3202359822;
	j3543971732 [label="Devo parabenizá-lo, Usurpador, por ter feito o que eu pedi e não ter ido mais longe no Refratário Obscuro, nem em minhas memórias na Descêndia. Independentemente de não termos feito nenhum acordo.",shape=box,color=blue];
		j3543971732 -> j1917326191;
	j302612466 [label="Querido, preciso te parabenizar por cumprir sua palavra e não ir mais longe na Descêndia e no Refratário Obscuro, nem recuperar minhas últimas memórias. Isso significa tudo para mim.",shape=box,color=blue];
		j302612466 -> j3981071808;
	j376247186 [label="Querido, preciso te parabenizar por ter feito o que eu pedi e não ter ido mais longe no Refratário Obscuro, nem nas minhas memórias na Descêndia. Isso significa tudo para mim.",shape=box,color=blue];
