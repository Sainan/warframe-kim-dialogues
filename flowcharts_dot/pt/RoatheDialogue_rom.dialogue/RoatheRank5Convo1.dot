	j3681567543 [label="Durante toda essa loucura, desde o momento em que minhas memórias desapareceram, tenho sentido isso… arranhando. Dilacerando meu peito, minha pele, como se alguma grande fera estivesse desesperada para se libertar de mim.",shape=box,color=blue];
