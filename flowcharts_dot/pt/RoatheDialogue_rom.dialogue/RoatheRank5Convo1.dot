		j395163427 -> j2822171052;
	j3668681101 [label="Você me disse palavras uma vez que eu não sabia se poderiam ser reais. Diga-me mais uma vez que elas eram verdadeiras. Diga-as para mim. Por favor. Eu preciso delas agora. Mais do que nunca.",shape=box,color=blue];
