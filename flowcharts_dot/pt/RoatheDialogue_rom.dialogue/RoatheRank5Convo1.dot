	j537032918 [label="Você me deu sua palavra. A sua palavra! Mas agora, descubro que você não passa de um mentiroso!",shape=box,color=blue];
		j537032918 -> j335328846;
		j537032918 -> j4155103263;
	j4259366273 [label="Eu deveria ter sabido. Deveria ter sabido que não devia confiar em você, anomalia nascida do Void! Você sabia o que me esperava lá?! Você sabia a verdade quando eu não sabia?!",shape=box,color=blue];
		j4259366273 -> j4195621256;
		j4259366273 -> j1509244119;
	j1459328372 [label="E aqui estamos nós, mais uma vez, de volta ao ponto de partida. Pisando novamente nos cadáveres do nosso passado. Em situação tão precária quanto antes.",shape=box,color=blue];
		j1459328372 -> j4213518899;
	j2565351247 [label="Por razões que, aparentemente, não têm nada a ver com meus próprios apelos! Mesmo assim, lembro-me da agonia que senti ao tomar aquele soro.",shape=box,color=blue];
		j2565351247 -> j4213518899;
	j3230072564 [label="E aqui estamos nós, mais uma vez, de volta ao ponto de partida. Pisando novamente nos cadáveres do nosso passado. Em situação tão precária quanto antes.",shape=box,color=blue];
