	j3386321737 [label="Então… peraí. Tô confuso. Como e quando o Entrati te transformou em um Protoframe?",shape=box,color=red];
		j3386321737 -> j3149567265;
	j4260057772 [label="Você… peraí. Você fez o quê?!",shape=box,color=red];
		j4260057772 -> j3276655669;
	j3920897853 [label="Ele… está lidando com tanta coisa. E eu simplesmente não sei como chegar até ele",shape=box,color=red];
		j3920897853 -> j3521093526;
	j3633589141 [label="Tenho sentimentos por ele…",shape=box,color=red];
		j3633589141 -> j774784957;
	j747244057 [label="Ela não enxerga o Entrati como ele realmente é. E eu simplesmente não consigo fazê-la enxergar a verdade, não importa o que eu tente",shape=box,color=red];
		j747244057 -> j626448828;
	j1212474315 [label="Tenho sentimentos por ela…",shape=box,color=red];
		j1212474315 -> j3426364319;
