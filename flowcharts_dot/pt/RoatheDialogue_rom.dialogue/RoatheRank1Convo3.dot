	268 [label="Exatamente isso! Com nada menos do que amostras do meu próprio sangue! Não comecei no mesmo ano em que partimos, isso eu garanto! Pelo Void, vou arrancar a carne dele com estas minhas novas garras no momento em que encontrar aquela figura estúpida e arrogante.",shape=box,color=blue];
