		j2831342368 -> j761315171;
	j2593401151 [label="+5 Chemistry",color=orange];
		j2593401151 -> j10540785;
	j315886484 [label="+5 Chemistry",color=orange];
		j315886484 -> j1387123836;
	j1895340899 [label="Em segundo lugar, sou tomado por uma fúria e raiva imediatas ao perceber que minha mente foi manipulada não uma, mas duas vezes recentemente. Mas outra emoção surge para desbancar essa raiva. Uma emoção que ainda não compreendo completamente.",shape=box,color=blue];
		j1895340899 -> j2487330717;
	j3149567265 [label="Eu não sei os detalhes, essas memórias desapareceram da minha mente, assim como muitas outras, devido à transformação que ele me impôs.",shape=box,color=blue];
		j3149567265 -> j1740870304;
	j3276655669 [label="Exatamente isso! Com nada menos do que amostras do meu próprio sangue! Não comecei no mesmo ano em que partimos, isso eu garanto! Pelo Void, vou arrancar a carne dele com estas minhas novas garras no momento em que encontrar aquela figura estúpida e arrogante.",shape=box,color=blue];
		j3276655669 -> j3164759555;
	j3521093526 [label="Eu recomendaria ter paciência, mas… longe de mim sugerir um cinzel quando uma picareta a laser está disponível bem ao seu lado.",shape=box,color=blue];
		j3521093526 -> j1563774443;
	j626448828 [label="+5 Chemistry",color=orange];
		j626448828 -> j4185229850;
	j1632489587 [label="Em segundo lugar, sou tomado por uma fúria e raiva imediatas ao perceber que minha mente foi manipulada não uma, mas duas vezes recentemente. Mas outra emoção surge para desbancar essa raiva. Uma emoção que ainda não compreendo completamente.",shape=box,color=blue];
		j1632489587 -> j4031500848;
	j761315171 [label="Primeiramente: estou impressionado! Você apagou todas as nossas memórias para tentar novamente conquistar o afeto dele?!",shape=box,color=blue];
		j761315171 -> j3857988795;
	j10540785 [label="Primeiramente: estou impressionado! Você apagou todas as nossas memórias para tentar novamente conquistar o afeto dela?!",shape=box,color=blue];
		j10540785 -> j3339953971;
	j1387123836 [label="Oh, isso é realmente mágico! Você apagou todas as nossas memórias para tentar novamente conquistar meu afeto?!",shape=box,color=blue];
		j1387123836 -> j4144776603;
	j2487330717 [label="Traição.",shape=box,color=blue];
		j2487330717 -> j1915823905;
	j1740870304 [label="Mas tenho alguns flashes. Fragmentos de um corredor dourado. Uma voz que reconheci, mas não um rosto. Era o Albrecht, mas não o que eu conhecia.",shape=box,color=blue];
		j1740870304 -> j2604418996;
	j3164759555 [label="Permita-me um momento para me recompor.",shape=box,color=blue];
		j3164759555 -> j2741124693;
	j1563774443 [label="Estou aqui sentado e duas coisas me chamam a atenção imediatamente, confirmando minha suspeita:",shape=box,color=blue];
		j1563774443 -> j3433289152;
	j4185229850 [label="Hm. Entendo. Uma empreitada nobre, sinceramente. Uma que tentei muitas e muitas vezes. E falhei da mesma forma.",shape=box,color=blue];
		j4185229850 -> j362653761;
	j4031500848 [label="Traição.",shape=box,color=blue];
		j4031500848 -> j3814405491;
	j3857988795 [label="Bem Orokin de sua parte",shape=box,color=blue];
		j3857988795 -> j107355714;
	j3339953971 [label="Bem Orokin de sua parte",shape=box,color=blue];
		j3339953971 -> j1100919747;
	j4144776603 [label="Bem Orokin de sua parte",shape=box,color=blue];
		j4144776603 -> j2906434773;
	j1915823905 [label="Por quê?",shape=box,color=blue];
		j1915823905 -> j3986642635;
	j2604418996 [label="Uma dor ardente e latejante. Como nunca tinha sentido antes. E olha que um corpo meu anterior já perdeu um braço e uma perna em uma explosão na guerra, Peregrino. Já sofri queimaduras tão graves que eu não teria me recuperado sem Kuva. Eu conheci a agonia.",shape=box,color=blue];
		j2604418996 -> j4151724796;
	j2741124693 [label="Obrigado. Podemos continuar.",shape=box,color=blue];
		j2741124693 -> j3650796253;
	j3433289152 [label="Fico pensando… Quantas batalhas eu teria vencido facilmente e repetido várias vezes, se tivesse este poder?",shape=box,color=blue];
		j3433289152 -> j3103623874;
	j362653761 [label="Estou aqui sentado e duas coisas me chamam a atenção imediatamente, confirmando minha suspeita:",shape=box,color=blue];
		j362653761 -> j2180545387;
	j3814405491 [label="Por quê?",shape=box,color=blue];
		j3814405491 -> j530570325;
	j107355714 [label="Segundo: quanta incompetência a sua, sinceramente?! Tenho quase certeza de que você conquistaria o amor e a adoração do Padre simplesmente se alimentasse e desse água uma vez por dia.",shape=box,color=blue];
		j107355714 -> j1231431510;
	j1100919747 [label="Segundo: você já tentou mancar na frente dela? Fingir alguma doença? Piscar o olho? Simplesmente dizer que ela estava bonita? Ela não parece ser muito difícil de conquistar.",shape=box,color=blue];
		j1100919747 -> j3575925433;
	j2906434773 [label="Estou aqui sentado e duas coisas me chamam a atenção imediatamente, confirmando minha suspeita:",shape=box,color=blue];
		j2906434773 -> j3836428958;
	j3986642635 [label="Mas essa é uma conversa para outro dia. Pois tenho uma proposta para você. Acredito que esta lhe interessará muito mais.",shape=box,color=blue];
		j3986642635 -> j3188852982;
	j4151724796 [label="Meu corpo estava sendo dilacerado e refeito. À força. Eu não escolhi isso. Não sei se foi a mesma coisa para os outros.",shape=box,color=blue];
		j4151724796 -> j110398968;
	j3650796253 [label="Usei amostras do meu próprio sangue para fazer engenharia reversa em um Helminte, por tentativa e erro. Não foi uma tarefa fácil, sem acesso a nenhum equipamento Orokin. Ou a qualquer equipamento, aliás, exceto o que eu conseguisse roubar dos…",shape=box,color=blue];
		j3650796253 -> j1602814564;
	j3103623874 [label="Quantas mentes eu teria corrompido se tivesse tido seus talentos à minha disposição?",shape=box,color=blue];
		j3103623874 -> j1912598785;
	j2180545387 [label="Fico pensando… Quantas batalhas eu teria vencido facilmente e repetido várias vezes, se tivesse este poder?",shape=box,color=blue];
		j2180545387 -> j3798160980;
	j530570325 [label="Mas essa é uma conversa para outro dia. Pois tenho uma proposta para você. Acredito que esta lhe interessará muito mais.",shape=box,color=blue];
		j530570325 -> j1799149245;
	j1231431510 [label="Não me entenda errado! Na verdade, estou bastante impressionado com a sua astúcia. ",shape=box,color=blue];
		j1231431510 -> j2297007750;
	j3575925433 [label="Terceiro: estou aqui sentado e, de repente, sou tomado por uma onda de percepções, confirmando a minha suspeita: ",shape=box,color=blue];
		j3575925433 -> j2574582662;
	j3836428958 [label="Fico pensando… Quantas batalhas eu teria vencido facilmente e repetido várias vezes, se tivesse este poder?",shape=box,color=blue];
		j3836428958 -> j3615372732;
	j3188852982 [label="Por você, fingirei não saber de nada na frente dos fanáticos…",shape=box,color=blue];
		j3188852982 -> j2982909830;
	j110398968 [label="Lembro-me dos degraus frios sob meus pés, quando fui abandonado nelas. Agora sei que eram as escadas da Catedral, pois Lyon e Marie me contaram a história com base em suas lembranças.",shape=box,color=blue];
		j110398968 -> j520741861;
	j1602814564 [label="Não vou lhes fazer a cortesia de chamá-los de hospitais \"rudimentares\". Albrecht usou um Helminte para nos transportar ao passado. Como ele cresceu no passado, eu não sei, já que devia estar lá quando chegamos. Ele definhou e morreu no processo, mas suspeitei que poderia usar outro para a viagem de volta.",shape=box,color=blue];
		j1602814564 -> j3929669948;
