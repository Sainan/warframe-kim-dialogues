	"RoatheRank1Convo3 begins." [color=orange];
		"RoatheRank1Convo3 begins." -> j3669541744;
		"RoatheRank1Convo3 begins." -> j17348121;
	j3669541744 [label="Posso te perguntar como você veio parar aqui de novo? De… quando exatamente?",shape=box,color=red];
		j3669541744 -> j1782054338;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j1782054338 [label="Evaluate expressions on HellStory counter",color=orange];
		j1782054338 -> j3562567052 [label="x >= 21",color=purple];
		j1782054338 -> j2320271935 [label="x < 21",color=purple];
		j1782054338 -> j2320271935 [label="false",color=purple];
	"Chat ends." [color=orange];
	j3562567052 [label="Suspeito que você já saiba muito bem a resposta para a sua pergunta, meu Usurpador. Que jogo você está jogando, perguntando sobre tais trivialidades, se já vasculhou os fragmentos da minha mente?",shape=box,color=blue];
		j3562567052 -> j4011668186;
	j2320271935 [label="Sim, pode perguntar! Isso me dá a oportunidade de elogiar minha própria genialidade e reclamar da profunda capacidade de Albrecht de ser incrivelmente estúpido e extremamente covarde!",shape=box,color=blue];
		j2320271935 -> j4070589250;
	j4011668186 [label="Check boolean RoatheKnowsReset",color=orange];
		j4011668186 -> j639559752 [label=true,color=green];
		j4011668186 -> j3377301861 [label=false,color=brown];
	j4070589250 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4070589250 -> j3039302926 [label="x >= 1",color=purple];
		j4070589250 -> j2919282300 [label="x <= 0",color=purple];
		j4070589250 -> j2919282300 [label="false",color=purple];
	j639559752 [label="Você é tão cruel quanto Albrecht, mexendo com a mente daqueles ao seu redor — pensando que são seus brinquedos! Então me diga. Por que perguntar se você já tem as respostas, hein?",shape=box,color=blue];
		j639559752 -> j4105529409;
		j639559752 -> j2844383470;
	j3377301861 [label="Diga para mim. Estou correto em pensar que você já tem as respostas que procura? Você já sabe como voltei para cá com os fanáticos — exatamente de onde viemos. E provavelmente muito mais do que isso, não é mesmo?",shape=box,color=blue];
		j3377301861 -> j3367762610;
		j3377301861 -> j2809484211;
	j3039302926 [label="Então quer dizer que você não foi colocado lá pelo Albrecht por decisão sua",shape=box,color=red];
		j3039302926 -> j2500132647;
	j2919282300 [label="Ahh… então você não foi jogado no passado por escolha própria",shape=box,color=red];
		j2919282300 -> j2500132647;
	j4105529409 [label="Eu tô tentando ajudar vocês a passar por esse processo, e da última vez eu vacilei legal. Tô tentando de novo. \"Do zero\", tipo isso",shape=box,color=red];
		j4105529409 -> j2275740731;
	j2844383470 [label="Eu de verdade não sei como explicar isso. Não pedi por essa habilidade de apagar suas memórias e tô tentando lidar com isso da melhor maneira que posso",shape=box,color=red];
		j2844383470 -> j1991210158;
	j3367762610 [label="Não sei não",shape=box,color=red];
		j3367762610 -> j2113500012;
	j2809484211 [label="É… admito que sim…",shape=box,color=red];
		j2809484211 -> j4099394488;
	j2500132647 [label="Não. Não, de jeito nenhum. Mas há algo que você precisa entender sobre os Orokin: nós jogamos — ou melhor, jogávamos — jogos uns com os outros com frequência. Jogos de todos os tipos. Políticos, psicológicos, sexuais. Não importava.",shape=box,color=blue];
		j2500132647 -> j2242983003;
	j2275740731 [label="+5 Chemistry",color=orange];
		j2275740731 -> j2494423593;
	j1991210158 [label="Você está fazendo um péssimo trabalho então, meu Eterno Viajante. Que objetivos você está tentando alcançar que já não tenha atingido antes?",shape=box,color=blue];
		j1991210158 -> j4269406562;
	j2113500012 [label="Hah. E agora eu sei que você é um mentiroso, além de um ladrão de memórias, Usurpador.",shape=box,color=blue];
		j2113500012 -> "Chat ends.";
	j4099394488 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j4099394488 -> j3421233440;
	j2242983003 [label="Por meio do uso de Kuva e do Teatro Yuvan, éramos fundamentalmente e funcionalmente imortais. Você consegue imaginar o quão exaustivo isso pode ser?",shape=box,color=blue];
		j2242983003 -> j2802836966;
		j2242983003 -> j2497405471;
	j2494423593 [label="Boolean RoatheResetScrewedUp is now true.",color=orange];
		j2494423593 -> j3537894081;
	j4269406562 [label="Check boolean LoidFamilyComplete",color=orange];
		j4269406562 -> j2525806427 [label=true,color=green];
		j4269406562 -> j1475373034 [label=true,color=green];
		j4269406562 -> j2123793822 [label=false,color=brown];
		j4269406562 -> j2525806427 [label=false,color=brown];
		j4269406562 -> j1475373034 [label=false,color=brown];
	j3421233440 [label="Então por que vem me fazer perguntas cujas respostas você já conhece?",shape=box,color=blue];
		j3421233440 -> j4105529409;
		j3421233440 -> j2844383470;
	j2802836966 [label="Acredite ou não, eu tenho experiência nisso",shape=box,color=red];
		j2802836966 -> j1805143846;
	j2497405471 [label="Eu consigo, na real… mas segue aí",shape=box,color=red];
		j2497405471 -> j3657228866;
	j3537894081 [label="Isso eu acho fascinante… você \"vacilou\" comigo ou com o Lyon ou a Marie?",shape=box,color=blue];
		j3537894081 -> j2526354173;
		j3537894081 -> j3616281399;
		j3537894081 -> j3321990268;
	j2525806427 [label="Bem, você tem toda essa… questão sobre o motivo de ter tomado o soro, e eu… estou sempre dizendo a coisa errada na hora errada",shape=box,color=red];
		j2525806427 -> j378680348;
	j1475373034 [label="Eu… tô tentando conquistar o coração de um de vocês, e… acabei… vacilando…",shape=box,color=red];
		j1475373034 -> j2937378514;
	j2123793822 [label="Estou tentando convencer você e os outros a me ajudarem a reunir o Loid com a família lá de cima e… ainda não consegui…",shape=box,color=red];
		j2123793822 -> j3401369172;
	j1805143846 [label="Se entendi corretamente, você experimentou a eternidade da morte. O que é muito mais interessante – e, ainda assim, você encontrou motivos para se cansar disso tudo.",shape=box,color=blue];
		j1805143846 -> j3657228866;
	j3657228866 [label="O que eu quis dizer foi o seguinte: estou acostumado, muito acostumado, com as maquinações e esquemas que nós, Orokin, usamos uns contra os outros por diversão. É simplesmente a nossa maneira de passar o tempo.",shape=box,color=blue];
		j3657228866 -> j1589264751;
	j2526354173 [label="O Lyon…",shape=box,color=red];
		j2526354173 -> j2019908210;
	j3616281399 [label="A Marie…",shape=box,color=red];
		j3616281399 -> j744459802;
	j3321990268 [label="Com você…",shape=box,color=red];
		j3321990268 -> j92290285;
	j378680348 [label="+5 Chemistry",color=orange];
		j378680348 -> j2222260271;
	j2937378514 [label="+5 Chemistry",color=orange];
		j2937378514 -> j3995624416;
	j3401369172 [label="Hmm. Entendi. Tínhamos um acordo, e você não conseguiu cumprir a sua parte, então viu sua recompensa desaparecer de vista.",shape=box,color=blue];
		j3401369172 -> j3950049970;
	j1589264751 [label="Mas existem limites que não ultrapassamos. Ações que não tomamos. Poderia entrar em detalhes, mas não farei isso. Vou resumir e simplesmente afirmar que o Albrecht ultrapassou todos eles.",shape=box,color=blue];
		j1589264751 -> j3421694674;
	j2019908210 [label="É mesmo? Você já tentou simplesmente alimentá-lo e colocar água uma vez por dia para ver se isso resolve o problema? Muito bem…",shape=box,color=blue];
		j2019908210 -> j769425024;
	j744459802 [label="E você não conseguiu convencer aquela Carola puritana a te acompanhar? Eu… espero… que você não siga carreira como negociador, meu Eterno Viajante.",shape=box,color=blue];
		j744459802 -> j3349803146;
	j92290285 [label="+5 Chemistry",color=orange];
		j92290285 -> j1905138314;
	j2222260271 [label="Hmm…",shape=box,color=blue];
		j2222260271 -> j2365078762;
	j3995624416 [label="HA! Isso é magnífico! Você realmente conseguiu minha atenção. Agora… qual de nós? Hein? Conta… não precisa ficar tímido. Talvez possamos fazer um… acordo.",shape=box,color=blue];
		j3995624416 -> j764993248;
		j3995624416 -> j66361173;
		j3995624416 -> j3079426171;
	j3950049970 [label="Estou aqui sentado e duas coisas me chamam a atenção imediatamente, confirmando minha suspeita:",shape=box,color=blue];
		j3950049970 -> j1883922238;
	j3421694674 [label="Ele me abandonou lá, em algum ano terrivelmente antigo, em algum buraco esquecido do Sistema de Origem! Você sabia que aquela \"Cathédrale\" esquecida pelo Void nem tinha eletricidade ainda?! Eletricidade!",shape=box,color=blue];
		j3421694674 -> j2523677939;
	j769425024 [label="O que tem causado problemas com ele? Talvez pudéssemos chegar a um acordo?",shape=box,color=blue];
		j769425024 -> j1302134513;
	j3349803146 [label="Mas me diga, o que tem causado problemas com ela? Talvez pudéssemos chegar a um… acordo?",shape=box,color=blue];
		j3349803146 -> j256724246;
	j1905138314 [label="HA! Isso é magnífico! Você realmente conseguiu minha atenção agora… como assim? Hein? Conta… não precisa ficar tímido. Talvez possamos fazer um… acordo.",shape=box,color=blue];
		j1905138314 -> j2004525054;
