	332 [label="Sei o que ele disse aos dois fanáticos, por mais insignificante que seja. \"Uriel, Herege de Xata, exilado, responda: os Orokin poderão ser perdoados?\"",shape=box,color=blue];
		332 -> 341;
	333 [label="Um Helminte. Como ele cresceu no passado, eu não sei, já que devia estar lá quando chegamos. Ele definhou e morreu no processo, mas suspeitei que poderia usar outro para a viagem de volta.",shape=box,color=blue];
		333 -> 342;
	334 [label="Eu não sei os detalhes, essas memórias desapareceram da minha mente, assim como muitas outras, devido à transformação que ele me impôs.",shape=box,color=blue];
		334 -> 343;
	335 [label="Por você, fingirei não saber de nada na frente dos fanáticos…",shape=box,color=blue];
		335 -> 344;
	336 [label="Mas essa é uma conversa para outro dia. Pois tenho uma proposta para você. Acredito que esta lhe interessará muito mais.",shape=box,color=blue];
		336 -> 345;
