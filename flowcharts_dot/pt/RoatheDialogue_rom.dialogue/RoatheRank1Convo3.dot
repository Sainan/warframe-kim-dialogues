		j342831176 -> j378680348;
	j1802307746 [label="[Confessar Sentimentos] Isso é bem desconfortável… mas eu…",shape=box,color=red];
		j1802307746 -> j3751019985;
	j851932198 [label="Quantas mentes eu teria corrompido se tivesse tido seus talentos à minha disposição?",shape=box,color=blue];
		j851932198 -> j1632489587;
