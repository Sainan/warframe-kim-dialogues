	220 [label="O que eu quis dizer foi o seguinte: estou acostumado, muito acostumado, com as maquinações e esquemas que nós, Orokin, usamos uns contra os outros por diversão. É simplesmente a nossa maneira de passar o tempo.",shape=box,color=blue];
