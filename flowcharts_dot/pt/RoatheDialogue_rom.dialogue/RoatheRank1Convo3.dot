	350 [label="É ele quem foge da família, da amante, da briga que começou com esse falso deus! Eu não sou o covarde maldito nessa história!",shape=box,color=blue];
		350 -> 360;
	351 [label="Update boolean RoatheHelminth1",color=orange];
		351 -> 361;
	352 [label="Uma dor ardente e latejante. Como nunca tinha sentido antes. E olha que um corpo meu anterior já perdeu um braço e uma perna em uma explosão na guerra, Peregrino. Já sofri queimaduras tão graves que eu não teria me recuperado sem Kuva. Eu conheci a agonia.",shape=box,color=blue];
