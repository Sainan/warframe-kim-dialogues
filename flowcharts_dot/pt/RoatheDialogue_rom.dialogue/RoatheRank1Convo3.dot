		198 -> 203;
	201 [label="Eu tô tentando ajudar vocês a passar por esse processo, e da última vez eu vacilei legal. Tô tentando de novo. \"Do zero\", tipo isso",shape=box,color=red];
		201 -> 206;
	202 [label="Eu de verdade não sei como explicar isso. Não pedi por essa habilidade de apagar suas memórias e tô tentando lidar com isso da melhor maneira que posso",shape=box,color=red];
		202 -> 207;
	199 [label="Não sei não",shape=box,color=red];
		199 -> 204;
	200 [label="É… admito que sim…",shape=box,color=red];
		200 -> 205;
	203 [label="Não. Não, de jeito nenhum. Mas há algo que você precisa entender sobre os Orokin: nós jogamos — ou melhor, jogávamos — jogos uns com os outros com frequência. Jogos de todos os tipos. Políticos, psicológicos, sexuais. Não importava.",shape=box,color=blue];
		203 -> 208;
