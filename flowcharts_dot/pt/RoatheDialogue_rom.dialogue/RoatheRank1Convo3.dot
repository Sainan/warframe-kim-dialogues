	196 [label="Você é tão cruel quanto Albrecht, mexendo com a mente daqueles ao seu redor — pensando que são seus brinquedos! Então me diga. Por que perguntar se você já tem as respostas, hein?",shape=box,color=blue];
		196 -> 201;
		196 -> 202;
	195 [label="Diga para mim. Estou correto em pensar que você já tem as respostas que procura? Você já sabe como voltei para cá com os fanáticos — exatamente de onde viemos. E provavelmente muito mais do que isso, não é mesmo?",shape=box,color=blue];
		195 -> 199;
		195 -> 200;
	197 [label="Então quer dizer que você não foi colocado lá pelo Albrecht por decisão sua",shape=box,color=red];
		197 -> 203;
