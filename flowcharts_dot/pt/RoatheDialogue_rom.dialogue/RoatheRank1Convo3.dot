		341 -> 350;
	342 [label="Eu estava certo. Embora o processo de criação tenha sido… trabalhoso e doloroso, pra dizer o mínimo! Usei amostras do meu próprio sangue para fazer engenharia reversa em um Helminte, por pura tentativa e erro!",shape=box,color=blue];
		342 -> 351;
	343 [label="Mas tenho alguns flashes. Fragmentos de um corredor dourado. Uma voz que reconheci, mas não um rosto. Era o Albrecht, mas não o que eu conhecia.",shape=box,color=blue];
		343 -> 352;
