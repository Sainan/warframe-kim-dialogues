	j2120278203 [label="Bem, se o que sabemos sobre o Void for verdade, então uma das duas coisas aconteceu: ou ela se deparou com alguma instância do Void em 1999 por conta própria (o que acho profundamente improvável, mas não impossível), ou…",shape=box,color=blue];
