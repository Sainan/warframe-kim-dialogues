digraph {
	"RoatheRank2Convo4 begins." [color=orange];
		"RoatheRank2Convo4 begins." -> j1115193858;
	j1115193858 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		j1115193858 -> j1437250236 [label=true,color=green];
		j1115193858 -> "Chat ends." [label=false,color=brown];
	j1437250236 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1437250236 -> j2052830946 [label=true,color=green];
		j1437250236 -> j1692949551 [label=false,color=brown];
	"Chat ends." [color=orange];
	j2052830946 [label="Hmm. Diga-me. Consegui convencê-lo da última vez que conversamos de que sua \"Indiferença\" é apenas uma coleção de brinquedos infantis improvisados, ou você ainda acredita que seja uma \"grande entidade misteriosa do Void\"?",shape=box,color=blue];
		j2052830946 -> j1730050204;
	j1692949551 [label="Check boolean RoatheMITW1",color=orange];
		j1692949551 -> j2589554327 [label=true,color=green];
		j1692949551 -> j3844498267 [label=false,color=brown];
	j1730050204 [label="Se há uma coisa que detesto neste mundo, é ficar correndo atrás do próprio rabo. E essa metáfora costumava ser muito mais proverbial do que é agora, acabei de perceber.",shape=box,color=blue];
		j1730050204 -> j3343135784;
		j1730050204 -> j195129850;
		j1730050204 -> j334290832;
	j2589554327 [label="Então, antes de prosseguirmos, quero ter certeza de que entendi corretamente. Você acredita que a Indiferença seja alguma entidade horrível e misteriosa do Void, que se infiltrou em nossa realidade devido aos erros do Albrecht?",shape=box,color=blue];
		j2589554327 -> j3613106803;
	j3844498267 [label="Todos com quem converso neste hospício estão absolutamente convencidos de que esse \"Homem na Parede\" é algum tipo de deus literal e ridículo. Um deus de verdade. Até aqueles dois fanáticos parecem comprar essa ideia!",shape=box,color=blue];
		j3844498267 -> j4228611762;
		j3844498267 -> j2936115715;
		j3844498267 -> j939179553;
	j3343135784 [label="Não conseguiu não… foi mal",shape=box,color=red];
		j3343135784 -> j1576056884;
	j195129850 [label="Na real, conseguiu sim",shape=box,color=red];
		j195129850 -> j3310631973;
	j334290832 [label="Nunca chegamos a bater o martelo sobre essa questão",shape=box,color=red];
		j334290832 -> j3983019793;
	j3613106803 [label="Permita-me reformular minha pergunta, antes que nos demos conta de que estamos dando voltas em círculos e correndo atrás do próprio rabo. O que… é uma metáfora que só agora percebo que costumava ser muito mais proverbial do que é agora, mas estou divagando.",shape=box,color=blue];
		j3613106803 -> j3195111569;
	j4228611762 [label="Você acha que ele não existe?",shape=box,color=red];
		j4228611762 -> j1168618152;
	j2936115715 [label="E se você não acha que ele é um deus, o que acha que ele é então?",shape=box,color=red];
		j2936115715 -> j3610382203;
	j939179553 [label="E você não?",shape=box,color=red];
		j939179553 -> j3888806497;
	j1576056884 [label="Boolean RoatheMITWSkip is now true.",color=orange];
		j1576056884 -> j3097817006;
	j3310631973 [label="Boolean RoatheMITWSkip is now true.",color=orange];
		j3310631973 -> j3506368123;
	j3983019793 [label="Ah! Bem, então parece que ainda tenho trabalho a fazer.",shape=box,color=blue];
		j3983019793 -> j4238058832;
	j3195111569 [label="Você acredita que a entidade que agora chama de Indiferença existia antes dos contatos do Albrecht com ela? Ou acredita que ele a criou quando interagiu pela primeira vez com o Void?",shape=box,color=blue];
		j3195111569 -> j2356797657;
		j3195111569 -> j886050318;
		j3195111569 -> j3361466587;
		j3195111569 -> j3480479926;
	j1168618152 [label="Por acaso eu disse essas palavras? Não coloque palavras na minha boca, ó Ursupador transitório. Eu não nego que a Indiferença seja \"real\". Eu nego que seja um Deus.",shape=box,color=blue];
		j1168618152 -> j911068283;
		j1168618152 -> j1459220709;
	j3610382203 [label="Consigo desmascarar essa falsa divindade em duas palavras simples que você deve conhecer e compreender muito bem:",shape=box,color=blue];
		j3610382203 -> j2870726344;
	j3888806497 [label="De jeito nenhum! Primeiro, não existe deus ou deuses. Essa ideia é absurda. Segundo, pensar que o Albrecht libertou um deus do Void? Mais absurdo ainda!",shape=box,color=blue];
		j3888806497 -> j796469960;
	j3097817006 [label="Boolean RoatheMITW5Real is now true.",color=orange];
		j3097817006 -> j218252176;
	j3506368123 [label="Boolean RoatheMITW5Fake is now true.",color=orange];
		j3506368123 -> j119470758;
	j4238058832 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j4238058832 -> j871842546;
	j2356797657 [label="Não sei. E acho que você também não tem como saber",shape=box,color=red];
		j2356797657 -> j1808269805;
	j886050318 [label="Acho que era uma entidade que existia antes do Entrati interagir com ela. Ele só deu forma e contornos com a Incorporação Conceitual.",shape=box,color=red];
		j886050318 -> j1049897539;
	j3361466587 [label="Sinceramente… não faço ideia",shape=box,color=red];
		j3361466587 -> j1210724366;
	j3480479926 [label="Você acha mesmo que o Entrati criou um deus maligno do Void do nada?",shape=box,color=red];
		j3480479926 -> j3284665103;
	j911068283 [label="Aquilo lá é mais poderoso do que qualquer coisa que eu já enfrentei",shape=box,color=red];
		j911068283 -> j1372842912;
	j1459220709 [label="Você acha que ele é o que então?",shape=box,color=red];
		j1459220709 -> j3610382203;
	j2870726344 [label="Incorporação Conceitual.",shape=box,color=blue];
		j2870726344 -> j2499408776;
		j2870726344 -> j3098559142;
		j2870726344 -> j3204867961;
	j796469960 [label="Não há nada no Void. É por isso que ele se chama Void! ",shape=box,color=blue];
		j796469960 -> j3972105799;
		j796469960 -> j3835316039;
	j218252176 [label="+10 Chemistry",color=orange];
		j218252176 -> j963881864;
	j119470758 [label="+20 Chemistry",color=orange];
		j119470758 -> j2255463333;
	j871842546 [label="Mas antes de prosseguirmos, quero ter certeza de que entendi corretamente. Você acredita que a Indiferença seja alguma entidade horrível e misteriosa do Void, que se infiltrou em nossa realidade devido aos erros do Albrecht?",shape=box,color=blue];
		j871842546 -> j3613106803;
	j1808269805 [label="Tenho sim! Isso é tão dolorosamente óbvio e tão ridículo, e vocês todos se convenceram de que uma fera está arranhando a janela, quando não passa de um galho de árvore ao vento.",shape=box,color=blue];
		j1808269805 -> j2329153764;
	j1049897539 [label="Ah não… até você? Eu tinha tanta esperança. Isso é tão dolorosamente óbvio e tão ridículo, e vocês todos se convenceram de que uma fera está arranhando a janela, quando não passa de um galho de árvore ao vento.",shape=box,color=blue];
		j1049897539 -> j2329153764;
	j1210724366 [label="Isso é tão dolorosamente óbvio e tão ridículo, e vocês todos se convenceram de que uma fera está arranhando a janela, quando não passa de um galho de árvore ao vento.",shape=box,color=blue];
		j1210724366 -> j2329153764;
	j3284665103 [label="Sim! Acho que sim! Isso é tão dolorosamente óbvio e tão ridículo, e vocês todos se convenceram de que uma fera está arranhando a janela, quando não passa de um galho de árvore ao vento.",shape=box,color=blue];
		j3284665103 -> j2329153764;
	j1372842912 [label="E quando foi que eu neguei isso? Aliás, parece que todos vocês se deixaram levar por um estado de histeria desnecessariamente exagerado.",shape=box,color=blue];
		j1372842912 -> j3737532612;
		j1372842912 -> j77818343;
	j2499408776 [label="O Void e o que dá pra criar com ele é perigoso e poderoso, vai por mim, sei do que tô falando. Mas ele tem limites. Acha mesmo que ele é capaz de manifestar algo assim? De criar idiomas inteiros, dedos que conseguem impulsionar naves que atravessam o Void?",shape=box,color=red];
		j2499408776 -> j3703836952;
	j3098559142 [label="É… bem tentador acreditar que isso é apenas um monstro debaixo da cama, Roathe. Mas eu vi essa coisa, cara a cara, e não sei como algo assim simplesmente surge da nossa mente",shape=box,color=red];
		j3098559142 -> j3078972517;
	j3204867961 [label="A Incorporação Conceitual não consegue fazer o que o Homem na Parede é capaz de fazer. Pode ser que o Entrati tenha manifestado essa coisa e seja responsável por trazer isso para cá, mas não acredito que ele seja a fonte original",shape=box,color=red];
		j3204867961 -> j167300599;
	j3972105799 [label="Eu… ",shape=box,color=red];
		j3972105799 -> j2044335684;
	j3835316039 [label="Não. Eu já vi coisas que surgiram do Void. Anjos cantando… fantasmas",shape=box,color=red];
		j3835316039 -> j2044335684;
	j963881864 [label="Embora eu esteja decepcionado por você ter se mantido firme, acho sua honestidade extremamente revigorante. E fico feliz em não perder mais meu tempo daqui pra frente. Tenho certeza de que encontraremos outras maneiras de nos divertir.",shape=box,color=blue];
		j963881864 -> j687310366;
	j2255463333 [label="Fantástico. Fico feliz que meu eu do passado tenha sido tão convincente. E espero que você esteja agindo com honestidade e não mentindo para mim numa tentativa de \"me calar\". Mas não tenho escolha a não ser acreditar em você.",shape=box,color=blue];
		j2255463333 -> j2149284547;
	j2329153764 [label="Só que agora, sob a influência do Void, vocês o alimentaram com tanto medo e poder que, num ciclo de retroalimentação, ele se transformou nesta… Coisa. Este Homem na Parede.",shape=box,color=blue];
		j2329153764 -> j1444005339;
	j3737532612 [label="Tá querendo dizer o que?",shape=box,color=red];
		j3737532612 -> j1588167356;
	j77818343 [label="Pera lá. Como é que a culpa é nossa? A culpa é do Albrecht, ele que largou essa bomba",shape=box,color=red];
		j77818343 -> j549675009;
	j3703836952 [label="A humanidade é certamente ilimitada em sua criatividade na escala e magnitude das novas formas de sofrimento que consegue infligir a si mesma, não é? Você mesmo testemunhou muitas crueldades que ninguém ousaria imaginar possíveis na época de nossos queridos fanáticos.",shape=box,color=blue];
		j3703836952 -> j3362946486;
	j3078972517 [label="Ah, você está tão perto da verdade e, no entanto, é tão rápido em rejeitá-la. Você acha \"tentador\" acreditar que talvez seja uma criação da sua própria mente, porque seria mais fácil rejeitá-la se fosse esse o caso? Não, eu acho muito mais perigoso confrontar uma criação nossa do que um deus.",shape=box,color=blue];
		j3078972517 -> j929854838;
	j167300599 [label="Embora eu aprecie sua humildade, questiono sua compreensão limitada do potencial criativo humano — especialmente no que diz respeito à forma como ela pode conceber novas formas de sofrimento. Não é você, na verdade, o único responsável por criar seu próprio universo do nada?",shape=box,color=blue];
		j167300599 -> j2141138622;
	j2044335684 [label="A única coisa que vem do Void é aquilo que colocamos nele – e aquilo que dele retorna. Ele transforma matéria e energia, mas não pode criá-las.",shape=box,color=blue];
		j2044335684 -> j1180426567;
	j687310366 [label="Da minha parte, agradeço por ser poupado de uma segunda rodada de debates erráticos e circulares sobre os detalhes da Incorporação Conceitual.",shape=box,color=blue];
		j687310366 -> j3351385541;
	j2149284547 [label="De qualquer forma, tenho certeza de que encontraremos outras maneiras de nos entreter, em vez de nos perdermos em debates erráticos e circulares sobre os detalhes da Incorporação Conceitual.",shape=box,color=blue];
		j2149284547 -> j1479363380;
	j1444005339 [label="Albrecht pode ter começado essa bobagem, mas todos vocês são responsáveis por atiçar o fogo até que ele se tornasse um incêndio. A Indiferença nunca existiu. Até que, de repente, passou a existir. ",shape=box,color=blue];
		j1444005339 -> j1493397398;
	j1588167356 [label="O que estou dizendo é: Albrecht pode ter sido o primeiro a vislumbrar sua própria arrogância refletida na face sorridente de um deus da destruição, de fato.",shape=box,color=blue];
		j1588167356 -> j3939876474;
	j549675009 [label="Albrecht pode ter sido o primeiro a vislumbrar sua própria arrogância refletida na face sorridente de um deus da destruição, de fato.",shape=box,color=blue];
		j549675009 -> j3939876474;
	j3362946486 [label="+5 Chemistry",color=orange];
		j3362946486 -> j3883873662;
	j929854838 [label="Um inimigo externo pode ser compreendido, manipulado, derrotado. Talvez seja até possível negociar com ele, se necessário. Ele possui fraquezas exploráveis. Mas um inimigo interno? Um inimigo que nós mesmos criamos? Esse é muito mais insidioso.",shape=box,color=blue];
		j929854838 -> j3045662616;
	j2141138622 [label="Você mesmo testemunhou muitas crueldades que ninguém ousaria imaginar possíveis na época de nossos queridos fanáticos. ",shape=box,color=blue];
		j2141138622 -> j3362946486;
	j1180426567 [label="Pensa direito, Peregrino. Esses \"Anjos do Void\" de que você fala. Esses fantasmas. Seriam eles feitos daqueles que já se perderam no Void?",shape=box,color=blue];
		j1180426567 -> j972926142;
	j3351385541 [label="Embora isso signifique mais tempo livre para ouvir os sermões dos fanáticos… bah. Escolhas, escolhas, escolhas…",shape=box,color=blue];
		j3351385541 -> "Chat ends.";
	j1479363380 [label="Eu, particularmente, agradeço por escapar de uma segunda rodada.",shape=box,color=blue];
		j1479363380 -> j3351385541;
	j1493397398 [label="E todos vocês são culpados por isso.",shape=box,color=blue];
		j1493397398 -> j3877651224;
		j1493397398 -> j1408283020;
		j1493397398 -> j1734339932;
	j3939876474 [label="Mas todos vocês são igualmente responsáveis por continuarem a empurrar esse besouro rola-bosta ladeira abaixo por tanto tempo, fazendo com que ele cresça a cada pedaço de fezes que coleta pelo caminho!",shape=box,color=blue];
		j3939876474 -> j89635426;
	j3883873662 [label="Como espécie, somos admiráveis em nossa capacidade de alimentar os nossos medos com novas formas de autodestruição.",shape=box,color=blue];
		j3883873662 -> j4102596479;
	j3045662616 [label="+5 Chemistry",color=orange];
		j3045662616 -> j1376804047;
	j972926142 [label="Eram meros ecos de energia sendo regurgitados como um kutak colorido para alimentar seus filhotes.",shape=box,color=blue];
		j972926142 -> j89635426;
	j3877651224 [label="A gente não consegue criar coisas assim, Roathe… já te falei. A Incorporação Conceitual tem seus limites",shape=box,color=red];
		j3877651224 -> j2677001548;
	j1408283020 [label="Não coloca isso na nossa conta. A gente não tem culpa pelos danos que essa coisa causou",shape=box,color=red];
		j1408283020 -> j802897337;
	j1734339932 [label="Me explica o seu raciocínio sobre como isso funcionaria. A maioria das coisas criadas por meio da Incorporação Conceitual a partir do Void não pode sair dele… pelo menos não por muito tempo",shape=box,color=red];
		j1734339932 -> j3444170769;
	j89635426 [label="Permita-me simplificar a questão para você. Eu consigo desmascarar essa falsa divindade em duas palavras simples que você deve conhecer e compreender muito bem:",shape=box,color=blue];
		j89635426 -> j2870726344;
	j4102596479 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j4102596479 -> j3613106803;
	j1376804047 [label="Porque aí temos que lutar contra os nossos próprios demônios. E a humanidade… nunca vence esse tipo de guerra, não é?",shape=box,color=blue];
		j1376804047 -> j4102596479;
	j2677001548 [label="Diz aquele que criou sozinho uma dimensão alternativa inteira? Por favor, Peregrino… use sua imaginação como costumava fazer.",shape=box,color=blue];
		j2677001548 -> j3444170769;
	j802897337 [label="Não estou te repreendendo! Isso já estava em curso muito antes de você entrar em cena. Albrecht cuidou disso.",shape=box,color=blue];
		j802897337 -> j3493902415;
	j3444170769 [label="A Incorporação Conceitual funciona assim: ao interagir com o Void, ou em proximidade com o Void, emoções e pensamentos poderosos podem se manifestar fisicamente. Nós dois sabemos disso.",shape=box,color=blue];
		j3444170769 -> j1090351300;
		j3444170769 -> j3217213967;
		j3444170769 -> j1780259943;
	j3493902415 [label="Ele viu seu próprio reflexo e sentiu o verdadeiro medo. Assim, acendeu-se a primeira faísca que ameaçou reduzir tudo a cinzas. Vocês simplesmente continuam jogando mais lenha na fogueira.",shape=box,color=blue];
		j3493902415 -> j3444170769;
	j1090351300 [label="Certo. Assim como Duviri, que compartilha uma conexão com esse mundo através da Zariman",shape=box,color=red];
		j1090351300 -> j3403304465;
	j3217213967 [label="Como a Zariman, os Indomáveis e os Anjos do Void. O Void está por toda parte naquela nave.",shape=box,color=red];
		j3217213967 -> j3403304465;
	j1780259943 [label="Sim, e daí?",shape=box,color=red];
		j1780259943 -> j2128380159;
	j3403304465 [label="Exatamente. Onde o Void vai, a Incorporação Conceitual pode seguir. E somente lá.",shape=box,color=blue];
		j3403304465 -> j2831121079;
		j3403304465 -> j1036695596;
	j2128380159 [label="Onde o Void vai, a Incorporação Conceitual pode seguir. E somente lá.",shape=box,color=blue];
		j2128380159 -> j2831121079;
		j2128380159 -> j1036695596;
	j2831121079 [label="Mas já foi até 1999. Seguiu o Albrecht por toda parte. E eu também",shape=box,color=red];
		j2831121079 -> j4127078884;
	j1036695596 [label="Peraí…",shape=box,color=red];
		j1036695596 -> j2987098998;
	j4127078884 [label="Aqueles dedos malditos. Nós pegamos aqueles dedos amaldiçoados em uma tentativa desesperada e insana de alcançar Tau, e nós, Orokin, encontramos uma maneira de replicá-los, não foi?",shape=box,color=blue];
		j4127078884 -> j3553405821;
	j2987098998 [label="Sim. Agora você entende. Aqueles dedos malditos. Nós pegamos aqueles dedos amaldiçoados em uma tentativa desesperada e insana de alcançar Tau, e nós, Orokin, encontramos uma maneira de replicá-los, não foi?",shape=box,color=blue];
		j2987098998 -> j3553405821;
	j3553405821 [label="Pequenos fragmentos do Void, por toda parte… Uma rede de trincheiras e túneis para aquela coisa surgir onde quisesse. E o pior?",shape=box,color=blue];
		j3553405821 -> j262651907;
	j262651907 [label="Os Tennos. E você. Todos vocês, tocados pelo Void. E todos vocês, assombrados por aquela coisa, pois aonde quer que vocês vão, ela pode segui-los.",shape=box,color=blue];
		j262651907 -> j3456286763;
	j3456286763 [label="E provavelmente qualquer pessoa que tenha interagido com aquilo por um período de tempo considerável. O próprio Entrati. Seu mordomo. As Cavias. Eu mesmo, os fanáticos, devido à nossa proximidade com este Sanctum. A lista continua…",shape=box,color=blue];
		j3456286763 -> j1290509877;
		j3456286763 -> j618130983;
	j1290509877 [label="Então tá querendo dizer que qualquer pessoa com exposição suficiente ao Void, ou qualquer pessoa que seja uma \"bateria\", vira mais uma janela pro Homem na Parede espiar?",shape=box,color=red];
		j1290509877 -> j4031063275;
	j618130983 [label="Mas queria saber como isso foi parar na Rusalka?",shape=box,color=red];
		j618130983 -> j1594585031;
	j4031063275 [label="Precisamente.",shape=box,color=blue];
		j4031063275 -> j3098563788;
	j1594585031 [label="Quem?",shape=box,color=blue];
		j1594585031 -> j3944518367;
		j1594585031 -> j173860794;
	j3098563788 [label="O que explicaria por que essa coisa não pode ter seu próprio rosto, não é? Ela só pode aparecer através das feições daqueles que atormenta, para aqueles que tenta atormentar.",shape=box,color=blue];
		j3098563788 -> j3634236602;
	j3944518367 [label="Major Neci Rusalka. Ela comandava a força militar conhecida como Scaldra em 1999, em Holvânia",shape=box,color=red];
		j3944518367 -> j1296917996;
	j173860794 [label="Pra resumir, eu nunca deixaria que vocês dois se conhecessem",shape=box,color=red];
		j173860794 -> j3406612002;
	j3634236602 [label="Na verdade, só parece assumir a aparência de arquitetura quando é incapaz de se apresentar como algo maior e diferente. Quando tenta desesperadamente transmitir uma sensação de grandeza e divindade.",shape=box,color=blue];
		j3634236602 -> j1878525052;
		j3634236602 -> j871791171;
	j1296917996 [label="Ela tava, ou tá ainda, possuída pela Indiferença. Tomou conta da mente dela, manipulando tipo uma marionete. Ou ela permitiu isso. A gente não sabe. E nem se ela realmente recuperou o controle",shape=box,color=red];
		j1296917996 -> j2775129681;
	j3406612002 [label="Você não é nada divertido, Usurpador. Mas como ela se relaciona com a nossa… Indiferença, exatamente?",shape=box,color=blue];
		j3406612002 -> j1296917996;
	j1878525052 [label="Então você acha que ele tá usando o rosto de todas as pessoas com quem entrou em contato… já que não tem um rosto próprio?",shape=box,color=red];
		j1878525052 -> j3072088091;
	j871791171 [label="Acho que o Homem na Parede escolheu usar nossos rostos porque não consegue compreender o que é ser humano. Do contrário, ele seria \"grande\" demais",shape=box,color=red];
		j871791171 -> j1735687879;
	j2775129681 [label="Ela parece ser uma pessoa deliciosamente formidável. E um completo charme. Mas isso não vem ao caso agora. Você afirma que a Indiferença tomou conta da mente dela? E isso começou durante sua pequena aventura ao passado?",shape=box,color=blue];
