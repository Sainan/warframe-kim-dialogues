	j701899089 [label="Principalmente quando sei que você poderia simplesmente usar seus poderes concedidos pelo Void para atravessar uma parede e me acertar alguns tiros na nuca quando quisesse.",shape=box,color=blue];
		j701899089 -> j4063048345;
	j3893949845 [label="O título é meramente uma expressão da minha leve admiração. Mesmo que seja um sarcasmo na medida certa para atender às minhas necessidades, sim, eu admito.",shape=box,color=blue];
