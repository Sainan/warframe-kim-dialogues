		j3275787545 -> j469998856;
	j334676048 [label="Só tô tentando entender por que você continua usando isso como título pra mim",shape=box,color=red];
		j334676048 -> j382090815;
	j1354758962 [label="Há! Dificilmente! Você é extremamente paciente se pensa que eu venho te insultando casualmente na sua cara há dias. ",shape=box,color=blue];
		j1354758962 -> j2389195802;
	j2798181762 [label="Bem, é o que você é, não é? Os Tennos usurparam o Sistema de Origem dos Orokin. E você, como um pequeno impostor no ninho, invadiu este mundo vindo do seu próprio. ",shape=box,color=blue];
		j2798181762 -> j4091108192;
