		j1583718725 -> j701899089 [label=false,color=brown];
	j3695584401 [label="Porque é exatamente isso: um título. Uma honraria. Você alcançou aquilo que eu aspirava ser. ",shape=box,color=blue];
		j3695584401 -> j3893949845;
	j3787726409 [label="Principalmente quando é tão dolorosamente claro que você tem tanto poder nesta situação que dificilmente pode ser considerada unilateral, não é?",shape=box,color=blue];
		j3787726409 -> j3997998184;
	j1385469825 [label="Principalmente quando sei que você poderia simplesmente usar seus poderes concedidos pelo Void para atravessar uma parede e me acertar alguns tiros na nuca quando quisesse.",shape=box,color=blue];
