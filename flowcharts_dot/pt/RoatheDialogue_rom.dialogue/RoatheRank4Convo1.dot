		j3893949845 -> j2730194310;
	j3997998184 [label="Não estou com vontade de fazer de você meu inimigo, Usurpador. Não, não é um insulto. É apenas por sua própria falta de diligência que você não percebeu a grande parte do meu passado que coincide com o seu.",shape=box,color=blue];
		j3997998184 -> j32349615;
	j4063048345 [label="Não estou com vontade de fazer de você meu inimigo, Usurpador. Não. Se for o caso, é uma homenagem. Você fez aquilo que eu aspirava ser. Nada mais.",shape=box,color=blue];
