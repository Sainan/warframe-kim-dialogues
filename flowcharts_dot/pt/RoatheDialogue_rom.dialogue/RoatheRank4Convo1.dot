		j2389195802 -> j1385469825 [label=false,color=brown];
	j4091108192 [label="E isso faz de você, na minha visão, um usurpador por pelo menos dois motivos. (E talvez por um terceiro, se incluirmos o que o mordomo me contou sobre Duviri, mas isso é assunto para outra hora)",shape=box,color=blue];
