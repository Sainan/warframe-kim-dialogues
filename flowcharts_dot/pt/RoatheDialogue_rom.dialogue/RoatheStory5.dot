	j1704535101 [label="ÁUDIO: INVENÇÃO",shape=box,color=blue];
		j1704535101 -> j3953767039;
	j3953767039 [label="Agora, lembro-me de que o desenvolvimento da Arquimídia marcial foi, a princípio, apresentado como entretenimento. ",shape=box,color=blue];
		j3953767039 -> j1957266477;
	j1957266477 [label="Como libertinos depravados assistindo à execução de criminosos em uma arena de circo.",shape=box,color=blue];
		j1957266477 -> j1839379153;
	j1839379153 [label="Imaginávamos estar inventando novas e empolgantes maneiras de eliminar um inimigo muito inferior.",shape=box,color=blue];
		j1839379153 -> j2775219733;
	j2775219733 [label="Como nos iludimos! Na realidade, buscávamos desesperadamente inovação, plenamente conscientes de nossa inferioridade numérica.",shape=box,color=blue];
		j2775219733 -> j2809714658;
	j2809714658 [label="Eles nos dilaceravam como crianças famintas devorando sua mãe inchada.",shape=box,color=blue];
		j2809714658 -> j512103747;
	j512103747 [label="Desidratados, esmagados entre as páginas do tempo, fomos simplesmente ultrapassados pela evolução.",shape=box,color=blue];
