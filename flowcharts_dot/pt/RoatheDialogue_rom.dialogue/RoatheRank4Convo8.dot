	3169 [label="Você tem outra chance de se redimir pelo que fez, eles não",shape=box,color=red];
		3169 -> 3172;
	3170 [label="Bom, pelo menos você tem o resto do seu futuro pra decidir como quer viver, eles não",shape=box,color=red];
		3170 -> 3173;
	3171 [label="+5 Chemistry",color=orange];
		3171 -> 3174;
	3172 [label="Add 1 to Thermostat",color=orange];
		3172 -> 3171;
