digraph {
	3120 [label="RoatheRank4Convo8 begins.",color=orange];
		3120 -> 3121;
		3120 -> 3122;
	3121 [label="Como foi a sua infância, Roathe?",shape=box,color=red];
		3121 -> 3123;
	3122 [label="[Encerrar Conversa]",shape=box,color=red];
		3122 -> 3124;
	3123 [label="Hmm… uma pergunta interessante. Como era? Sinceramente, não me lembro de muita coisa. E as estrelas e esculturas que guardavam essas memórias provavelmente já se transformaram em pó ou viraram Endo, imagino.",shape=box,color=blue];
		3123 -> 3125;
	3124 [label="Chat ends.",color=orange];
	3125 [label="Temo que só consigo recordar imagens muito fugazes, pois já faz tanto tempo. Em grande parte, me pergunto se não imaginei tudo como num sonho, ou como se estivesse atribuindo imagens aos eventos que li num livro de história.",shape=box,color=blue];
		3125 -> 3126;
	3126 [label="Logo, admito que o que consigo recordar provavelmente não é muito confiável. Por que você pergunta?",shape=box,color=blue];
		3126 -> 3127;
		3126 -> 3128;
		3126 -> 3129;
	3127 [label="Mesmo que as histórias sejam falsas, ainda são o que você conta a si mesmo sobre seu passado. Ainda assim, vale a pena falar sobre elas",shape=box,color=red];
		3127 -> 3130;
	3128 [label="Tenho curiosidade em saber como era crescer na nobreza Orokin",shape=box,color=red];
		3128 -> 3131;
	3129 [label="Tô me perguntando o que fez de você quem você é, como você ficou assim",shape=box,color=red];
		3129 -> 3132;
	3130 [label="+5 Chemistry",color=orange];
		3130 -> 3133;
	3131 [label="Fui enviado para o que os fanáticos chamariam de \"internato\" ainda jovem, como todos os jovens Orokin destinados à grandeza. Lá, fui testado e treinado para determinar minhas vocações e aptidões.",shape=box,color=blue];
		3131 -> 3134;
		3131 -> 3135;
	3132 [label="+5 Chemistry",color=orange];
		3132 -> 3136;
	3133 [label="Concordo, as mentiras que contamos a nós mesmos são muitas vezes mais importantes do que a verdade. Uma observação maravilhosa, Usurpador.",shape=box,color=blue];
		3133 -> 3137;
	3134 [label="Seus pais simplesmente te mandaram embora? Por quanto tempo?",shape=box,color=red];
		3134 -> 3138;
	3135 [label="Como era lá?",shape=box,color=red];
		3135 -> 3139;
	3136 [label="Você está tentando descobrir exatamente onde eu \"errei\", não é? Entendi! Que engraçado. Não sei, pois você encontrará muitas coisas na minha infância que lhe darão as respostas que procura.",shape=box,color=blue];
		3136 -> 3140;
	3137 [label="Add -1 to Thermostat",color=orange];
		3137 -> 3131;
	3138 [label="Toda a minha juventude. Acho que nunca mais vi os dois que me deram vida. Talvez na cerimônia em que fui anunciado como o melhor aluno da turma, talvez?",shape=box,color=blue];
		3138 -> 3141;
	3139 [label="Acho que a opinião variaria muito dependendo de com quem você estivesse falando. Quando cheguei, as surras que levava dos garotos mais velhos eram rápidas e as lições, brutalmente eficientes.",shape=box,color=blue];
		3139 -> 3142;
	3140 [label="Add 1 to Thermostat",color=orange];
		3140 -> 3131;
	3141 [label="Creio que essa foi a primeira vez que eles se dignaram a me reivindicar. Não dou muita importância a isso.",shape=box,color=blue];
		3141 -> 3143;
	3142 [label="Mas, em tudo, aprendo rápido. E aprendi que, se quisesse me destacar nessa área específica da Arquimídia, o melhor seria aplicar técnicas criativas para não ficar preso à mediocridade.",shape=box,color=blue];
		3142 -> 3144;
		3142 -> 3145;
	3143 [label="Não me lembro muito dos meus pais. Enquanto alguns Orokin estavam ansiosos para criar seus próprios filhos, os meus estavam ansiosos para se livrar de mim e seguir em frente com suas vidas.",shape=box,color=blue];
		3143 -> 3146;
		3143 -> 3147;
	3144 [label="Os Arquimedianos deixaram isso acontecer?",shape=box,color=red];
		3144 -> 3148;
	3145 [label="Isso é… horrível",shape=box,color=red];
		3145 -> 3149;
	3146 [label="Isso não parece ter te impedido de nada na vida",shape=box,color=red];
		3146 -> 3150;
	3147 [label="Sinto muito… parece uma vida triste",shape=box,color=red];
		3147 -> 3150;
	3148 [label="Meu pobre Usurpador, foi o próprio diretor quem trouxe uma garrafa de Kuva e um dos criados quando as coisas saíram do controle com um dos novos iniciados certa noite.",shape=box,color=blue];
		3148 -> 3151;
	3149 [label="A tradição é uma ferramenta poderosa, Usurpador. Uma ferramenta poderosa e perigosa que pode ser usada para manter muitos homens sãos presos a modos de pensar insanos.",shape=box,color=blue];
		3149 -> 3152;
	3150 [label="Muito pelo contrário. Devido à minha falta de laços familiares, eu tinha mais tempo para me dedicar às estratégias militaristas que pareciam arcaicas e antiquadas para os meus pares. ",shape=box,color=blue];
		3150 -> 3153;
	3151 [label="A tradição é uma ferramenta poderosa. Uma ferramenta poderosa e perigosa que pode ser usada para manter muitos homens sãos presos a modos de pensar insanos.",shape=box,color=blue];
		3151 -> 3154;
		3151 -> 3155;
	3152 [label="Foi o próprio diretor quem trouxe uma garrafa de Kuva e um dos criados quando as coisas saíram do controle com um dos novos iniciados certa noite.",shape=box,color=blue];
		3152 -> 3154;
		3152 -> 3155;
	3153 [label="Eles mal imaginavam o quanto isso me ajudaria no futuro.",shape=box,color=blue];
		3153 -> 3156;
		3153 -> 3157;
	3154 [label="E quanto aos seus pais?",shape=box,color=red];
		3154 -> 3143;
	3155 [label="Você tinha algum amigo lá?",shape=box,color=red];
		3155 -> 3158;
	3156 [label="Você acha que valeu a pena?",shape=box,color=red];
		3156 -> 3159;
	3157 [label="Parece que você viveu uma vida bem solitária",shape=box,color=red];
		3157 -> 3160;
	3158 [label="Não. Eu me mantive na minha. Aprendi que o medo é algo fácil de criar e manipular nos outros, mas é como um gelo delicado e rendado que derrete com qualquer exposição à luz.",shape=box,color=blue];
		3158 -> 3161;
	3159 [label="Meus colegas não faziam ideia de quanto esses estudos me ajudariam no futuro. Mas, se você está perguntando sobre o saldo final, foi um ganho ou uma perda?",shape=box,color=blue];
		3159 -> 3162;
	3160 [label="Sim. Já passei por isso. Mas assim são as coisas quando se vive a vida de um diabo, não é? Mesmo assim, eu era visto ou como o coadjuvante impotente e o concubino, ou como o sanguinário senhor de guerra e o monstro descontrolado.",shape=box,color=blue];
		3160 -> 3163;
	3161 [label="Os monstros devem ser mantidos na escuridão. E se eu quisesse manter uma aura de perigo ao meu redor, teria que ficar sozinho.",shape=box,color=blue];
		3161 -> 3146;
		3161 -> 3147;
	3162 [label="Hmm… não sei.",shape=box,color=blue];
		3162 -> 3164;
		3162 -> 3165;
	3163 [label="Eu nunca fui bem-vindo nem entre os de posição social superior, nem inferior à minha. E não tinha pares que pudessem ser considerados.",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="Você tem outra chance de se redimir pelo que fez, eles não",shape=box,color=red];
		3164 -> 3167;
	3165 [label="Bem, eles estão mortos e você não",shape=box,color=red];
		3165 -> 3168;
	3166 [label="Update boolean RoatheUnloved2",color=orange];
		3166 -> 3169;
		3166 -> 3170;
	3167 [label="Add 1 to Thermostat",color=orange];
