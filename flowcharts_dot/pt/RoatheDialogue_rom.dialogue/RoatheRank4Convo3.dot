digraph {
	2475 [label="RoatheRank4Convo3 begins.",color=orange];
		2475 -> 2476;
	2476 [label="Responda-me a esta charada, Usurpador: se chegasse a esse ponto, você acha que conseguiria derrotar sua contraparte Tenno em uma luta até a morte?",shape=box,color=blue];
		2476 -> 2478;
		2476 -> 2477;
		2476 -> 2479;
	2478 [label="Quê? Por quê?",shape=box,color=red];
		2478 -> 2481;
	2477 [label="Não vou ter essa conversa",shape=box,color=red];
		2477 -> 2480;
	2479 [label="[Encerrar Conversa]",shape=box,color=red];
		2479 -> 2482;
	2481 [label="Porque não sei se você percebeu, mas a \"Lótus\" não é somente um Sentient (responsável por colocar Lua no Void, diga-se de passagem), mas também perdeu o controle de seus circuitos de forma mensurável.",shape=box,color=blue];
		2481 -> 2483;
		2481 -> 2484;
		2481 -> 2485;
		2481 -> 2486;
		2481 -> 2487;
	2480 [label="Não estou tentando ser grosseiro. Estou falando muito sério, percebe? Esta é uma conversa puramente pragmática. ",shape=box,color=blue];
		2480 -> 2481;
	2482 [label="Chat ends.",color=orange];
	2483 [label="Ela tá bem, você não sabe do que tá falando",shape=box,color=red];
		2483 -> 2488;
	2484 [label="Perdeu o controle dos circuitos? O que você quer dizer com isso?",shape=box,color=red];
		2484 -> 2489;
	2485 [label="Não, não vou fazer isso. A Lótus salvou minha vida, salvou a vida dos Tennos inúmeras vezes. Devemos tudo a ela",shape=box,color=red];
		2485 -> 2490;
	2486 [label="Cala a boca Roathe, esse papo não é pra mim [Encerrar Conversa]",shape=box,color=red];
		2486 -> 2491;
	2487 [label="Eu sei, também tô preocupado. Mas ela já fez tanto pela gente, e eu não posso virar as costas pra ela. Preciso apoiá-la",shape=box,color=red];
		2487 -> 2492;
	2488 [label="Não? Presta atenção! Olha ao redor! Quantos meses ela passou parada na beira de um precipício, segurando um celular antigo, cantarolando para si mesma? Olhando fixamente para o Void?",shape=box,color=blue];
		2488 -> 2493;
	2489 [label="Quantos meses ela passou parada na beira de um precipício, segurando um celular antigo, cantarolando para si mesma? Olhando fixamente para o Void?",shape=box,color=blue];
		2489 -> 2493;
	2490 [label="Não sou insensível. Entendo o que você está passando. Você deve muito a ela. Não estou dizendo para você matá-la, estou dizendo para você parar de permitir que ela influencie as pessoas ao seu redor.",shape=box,color=blue];
		2490 -> 2489;
	2491 [label="Como quiser. Mas quando tudo isso desabar ao seu redor? Não venha rastejar até mim em busca de ajuda.",shape=box,color=blue];
		2491 -> 2494;
	2492 [label="+5 Chemistry",color=orange];
		2492 -> 2495;
	2493 [label="E agora ela está simplesmente… pairando? Na escuridão? Enviando seu clone infantil cada vez mais fundo nas memórias dele, para quê? Um caminho para casa, simplesmente porque Albrecht estalou os dedos e sussurrou a palavra mágica?",shape=box,color=blue];
		2493 -> 2496;
	2494 [label="Chat ends.",color=orange];
	2495 [label="Não sou insensível. Entendo o que você está passando. Você deve muito a ela. Não estou dizendo para você matá-la, estou dizendo para você parar de permitir que ela influencie as pessoas ao seu redor.",shape=box,color=blue];
		2495 -> 2497;
	2496 [label="Você não acha isso suspeito? Não acha isso perigoso? É uma armadilha. Ela está sendo manipulada. Seja pelo Albrecht ou por essa tal \"Indiferença\". Ela é um programa defeituoso. Seus preceitos estão falhando.",shape=box,color=blue];
		2496 -> 2498;
	2497 [label="Quando ela estava ali parada na beira do precipício, segurando um celular antigo, cantarolando baixinho? Olhando fixamente para o Void? Você não pensou que ela pudesse pular?",shape=box,color=blue];
		2497 -> 2493;
	2498 [label="Não acho que ela queira te fazer mal. Acho que ela está apenas sendo usada. Mas quando chegar a hora, você pode precisar se defender. Ou pode precisar lutar.",shape=box,color=blue];
		2498 -> 2499;
	2499 [label="E embora seja (esperançosamente) provável que você entenda a importância de evitar que uma segunda onda de problemas com a Lótus se agrave, seu exército de crianças selvagens não entenderá. Portanto, pergunto novamente:",shape=box,color=blue];
		2499 -> 2500;
	2500 [label="Quem você acha que venceria se chegasse o dia terrível e você tivesse que lutar com todos os seus recursos? Você, e tudo o que você tem, contra todos os Tennos e a Lótus?",shape=box,color=blue];
		2500 -> 2501;
		2500 -> 2502;
		2500 -> 2503;
	2501 [label="Esse papo é uma baita estupidez [Encerrar Conversa]",shape=box,color=red];
		2501 -> 2504;
	2502 [label="Tem tipo… sei lá, um monte deles. E só 1 de mim, Roathe",shape=box,color=red];
		2502 -> 2505;
	2503 [label="Nem sei por onde começar",shape=box,color=red];
		2503 -> 2506;
	2504 [label="Considere isso uma brincadeira boba, se quiser! Uma brincadeira teórica de criança. ",shape=box,color=blue];
		2504 -> 2507;
		2504 -> 2508;
	2505 [label="+5 Chemistry",color=orange];
		2505 -> 2509;
	2506 [label="Então é uma grande sorte que você esteja falando com o \"Diabo de Tau\". Há um motivo para eu ser conhecido como estrategista. Vamos começar pelo básico: números. Você está terrivelmente em desvantagem nesse quesito. ",shape=box,color=blue];
		2506 -> 2510;
	2507 [label="Isso não é um jogo",shape=box,color=red];
		2507 -> 2511;
	2508 [label="Pela última vez… não [Encerrar Conversa]",shape=box,color=red];
		2508 -> 2512;
	2509 [label="Perfeito. Estabelecemos a primeira regra para definir o campo de batalha: números. Obviamente, você está em grande desvantagem numérica.",shape=box,color=blue];
		2509 -> 2510;
	2510 [label="Check boolean IsDating",color=orange];
		2510 -> 2513 [label=true,color=green];
		2510 -> 2514 [label=false,color=brown];
	2511 [label="Você tem razão. Não é. E, um dia, pode ser uma questão de vida ou morte. Você, contra sua pequena… versão em miniatura. E sua matilha de companheiros selvagens.",shape=box,color=blue];
		2511 -> 2515;
	2512 [label="Chat ends.",color=orange];
	2513 [label="Contudo, se rumores sobre suas \"atividades pessoais\" e seu relacionamento amoroso entre Protoframes em outras linhas temporais pudessem ser… explorados, talvez esses recursos pudessem ser invocados de alguma forma. Helmintes precisarão ser especialmente pesquisados e criados para esse propósito…",shape=box,color=blue];
		2513 -> 2516;
	2514 [label="Ouvi falar de suas interações com outros Protoframes em outras linhas temporais. Talvez esses recursos possam ser invocados de alguma forma. Para isso, será necessário pesquisar e criar Helmintes especificamente…",shape=box,color=blue];
		2514 -> 2516;
	2515 [label="Companheiros selvagens que, aliás, já provaram ser violentos, indisciplinados e conhecidos por expulsar cruelmente os seus próprios semelhantes por divergir demasiado das suas opiniões sobre o que é normal.",shape=box,color=blue];
		2515 -> 2517;
		2515 -> 2518;
		2515 -> 2519;
	2516 [label="Nem sei se isso é possível, mas nos permitiu chegar até aqui, então não vejo por que não…",shape=box,color=blue];
		2516 -> 2520;
		2516 -> 2521;
		2516 -> 2522;
	2517 [label="Agora você tá insinuando que os Tennos são do mal?",shape=box,color=red];
		2517 -> 2523;
	2518 [label="Tá querendo dizer o que?",shape=box,color=red];
		2518 -> 2524;
	2519 [label="Não, tô fora disso [Encerrar Conversa]",shape=box,color=red];
		2519 -> 2525;
	2520 [label="Roathe… vai pro inferno",shape=box,color=red];
		2520 -> 2526;
	2521 [label="Não vou envolver eles nessa bagunça",shape=box,color=red];
		2521 -> 2527;
	2522 [label="Fico meio que com medo do quanto você já pensou nisso…",shape=box,color=red];
		2522 -> 2528;
	2523 [label="Não, não são maus. Eu não acredito em \"mal\", Usurpador. Nunca acreditei e nunca acreditarei. Acredito que os Tennos são maravilhosamente e belamente humanos, como todos os outros. Simplesmente humanos. E além disso? São crianças.",shape=box,color=blue];
		2523 -> 2529;
	2524 [label="Que chegue o momento, em algum dia terrível, em que você precise estar preparado para fazer o impensável.",shape=box,color=blue];
		2524 -> 2530;
	2525 [label="Se quiser, fuja da conversa, mas você sabe que cada palavra dita é a verdade. Simplesmente não quer aceitá-la.",shape=box,color=blue];
		2525 -> 2531;
	2526 [label="+5 Chemistry",color=orange];
		2526 -> 2532;
	2527 [label="Ah! Então você admite que há uma bagunça. Isso já é um progresso. Posso ao menos apresentar meus argumentos?",shape=box,color=blue];
		2527 -> 2533;
		2527 -> 2534;
	2528 [label="E eu estou meio que com medo do quanto você claramente não pensou. Posso ao menos apresentar meus argumentos?",shape=box,color=blue];
		2528 -> 2533;
		2528 -> 2534;
	2529 [label="Crianças que foram incumbidas de enfrentar horrores e cometer atrocidades, as mesmas que eu vi destruírem guerreiros Orokin veteranos, cuja história abrange centenas de anos.",shape=box,color=blue];
		2529 -> 2535;
	2530 [label="Os Tennos são maravilhosamente e belamente humanos, como todos os outros. Simplesmente humanos. E além disso? São crianças.",shape=box,color=blue];
		2530 -> 2529;
	2531 [label="Chat ends.",color=orange];
	2532 [label="Eu já estou lá, Usurpador… eu já estou lá.",shape=box,color=blue];
		2532 -> 2536;
	2533 [label="Certo… pode falar, vou ouvir",shape=box,color=red];
		2533 -> 2537;
	2534 [label="Não, tô fora disso",shape=box,color=red];
		2534 -> 2538;
	2535 [label="Eu vi um Dax, um Dax Dourado, um Dax de Elite largar suas espadas sagradas e douradas e fugir do campo de batalha em que os Tennos invadiram com seus Warframes.",shape=box,color=blue];
		2535 -> 2539;
	2536 [label="Update boolean RoatheNoDate",color=orange];
		2536 -> 2540;
	2537 [label="+5 Chemistry",color=orange];
		2537 -> 2541;
	2538 [label="E eis que eu também.",shape=box,color=blue];
		2538 -> 2540;
	2539 [label="O casulo de proteção infestada que eles acreditavam proteger seus corpos, mas não suas mentes. Eles não são culpados por serem como são.",shape=box,color=blue];
		2539 -> 2542;
	2540 [label="Chat ends.",color=orange];
	2541 [label="Obrigado. Que chegue o momento, em algum dia terrível, em que você precise estar preparado para fazer o impensável.",shape=box,color=blue];
		2541 -> 2530;
	2542 [label="Atormentados pelo Void… forçados a assassinar ou testemunhar a morte de seus próprios pais… sujeitos à guerra… tendo suas memórias roubadas… perdidos em criogenia por séculos…",shape=box,color=blue];
		2542 -> 2543;
	2543 [label="O fato de eles não serem completamente lunáticos é um milagre, Usurpador. Não estou dizendo que algo vai dar errado. Estou apenas dizendo que poderia dar. E que você precisa ter um plano para o caso de esse dia chegar.",shape=box,color=blue];
		2543 -> 2544;
	2544 [label="Não há mal nenhum em estar preparado para o pior. O pior que pode acontecer é não estar.",shape=box,color=blue];
		2544 -> 2545;
		2544 -> 2546;
		2544 -> 2547;
		2544 -> 2548;
	2545 [label="Vou… ficar de olho nas coisas. Mas não vou fazer nada pelas costas de ninguém",shape=box,color=red];
		2545 -> 2549;
	2546 [label="Eu… detesto concordar com você nesse ponto",shape=box,color=red];
		2546 -> 2550;
	2547 [label="Você sabe que eu sofri tanto quanto os Tennos, né?",shape=box,color=red];
		2547 -> 2551;
	2548 [label="Não vou trair a confiança deles",shape=box,color=red];
		2548 -> 2552;
	2549 [label="+5 Chemistry",color=orange];
		2549 -> 2553;
	2550 [label="+5 Chemistry",color=orange];
		2550 -> 2554;
	2551 [label="E quem pode afirmar que eu não estou tendo essas mesmas conversas com eles, hein?",shape=box,color=blue];
		2551 -> 2555;
	2552 [label="Nem estava sugerindo que você fizesse o contrário.",shape=box,color=blue];
		2552 -> 2556;
	2553 [label="Claro! Isso é tudo que um diabo poderia pedir, obrigado.",shape=box,color=blue];
		2553 -> 2557;
	2554 [label="Hmm… é apenas a sensação de sanidade retornando ao seu cérebro depois de todos esses anos. Você vai se acostumar.",shape=box,color=blue];
		2554 -> 2558;
