		j973732448 -> "Chat ends.";
	j604298562 [label="Perfeito. Estabelecemos a primeira regra para definir o campo de batalha: números. Obviamente, você está em grande desvantagem numérica.",shape=box,color=blue];
		j604298562 -> j4181059854;
	j4181059854 [label="Check boolean IsDating",color=orange];
		j4181059854 -> j686640596 [label=true,color=green];
		j4181059854 -> j662503564 [label=false,color=brown];
	j2641206802 [label="Você tem razão. Não é. E, um dia, pode ser uma questão de vida ou morte. Você, contra sua pequena… versão em miniatura. E sua matilha de companheiros selvagens.",shape=box,color=blue];
		j2641206802 -> j966669762;
	j686640596 [label="Contudo, se rumores sobre suas \"atividades pessoais\" e seu relacionamento amoroso entre Protoframes em outras linhas temporais pudessem ser… explorados, talvez esses recursos pudessem ser invocados de alguma forma. Helmintes precisarão ser especialmente pesquisados e criados para esse propósito…",shape=box,color=blue];
		j686640596 -> j2722439733;
	j662503564 [label="Ouvi falar de suas interações com outros Protoframes em outras linhas temporais. Talvez esses recursos possam ser invocados de alguma forma. Para isso, será necessário pesquisar e criar Helmintes especificamente…",shape=box,color=blue];
		j662503564 -> j2722439733;
	j966669762 [label="Companheiros selvagens que, aliás, já provaram ser violentos, indisciplinados e conhecidos por expulsar cruelmente os seus próprios semelhantes por divergir demasiado das suas opiniões sobre o que é normal.",shape=box,color=blue];
		j966669762 -> j3496875320;
