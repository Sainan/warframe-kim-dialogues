		j2247431515 -> j2627741274;
	j249948698 [label="Não, tô fora disso [Encerrar Conversa]",shape=box,color=red];
		j249948698 -> j4064170086;
	j3504824209 [label="Roathe… vai pro inferno",shape=box,color=red];
		j3504824209 -> j215256769;
	j3900994613 [label="Não vou envolver eles nessa bagunça",shape=box,color=red];
		j3900994613 -> j3182730021;
	j756848080 [label="Fico meio que com medo do quanto você já pensou nisso…",shape=box,color=red];
		j756848080 -> j407730816;
	j1863486342 [label="Não, não são maus. Eu não acredito em \"mal\", Usurpador. Nunca acreditei e nunca acreditarei. Acredito que os Tennos são maravilhosamente e belamente humanos, como todos os outros. Simplesmente humanos. E além disso? São crianças.",shape=box,color=blue];
		j1863486342 -> j1371822425;
	j2627741274 [label="Que chegue o momento, em algum dia terrível, em que você precise estar preparado para fazer o impensável.",shape=box,color=blue];
		j2627741274 -> j576797765;
	j4064170086 [label="Se quiser, fuja da conversa, mas você sabe que cada palavra dita é a verdade. Simplesmente não quer aceitá-la.",shape=box,color=blue];
		j4064170086 -> "Chat ends.";
	j215256769 [label="+5 Chemistry",color=orange];
		j215256769 -> j2959955087;
	j3182730021 [label="Ah! Então você admite que há uma bagunça. Isso já é um progresso. Posso ao menos apresentar meus argumentos?",shape=box,color=blue];
		j3182730021 -> j780828549;
		j3182730021 -> j15258425;
	j407730816 [label="E eu estou meio que com medo do quanto você claramente não pensou. Posso ao menos apresentar meus argumentos?",shape=box,color=blue];
		j407730816 -> j780828549;
		j407730816 -> j15258425;
	j1371822425 [label="Crianças que foram incumbidas de enfrentar horrores e cometer atrocidades, as mesmas que eu vi destruírem guerreiros Orokin veteranos, cuja história abrange centenas de anos.",shape=box,color=blue];
		j1371822425 -> j86156415;
	j576797765 [label="Os Tennos são maravilhosamente e belamente humanos, como todos os outros. Simplesmente humanos. E além disso? São crianças.",shape=box,color=blue];
		j576797765 -> j1371822425;
	j2959955087 [label="Eu já estou lá, Usurpador… eu já estou lá.",shape=box,color=blue];
		j2959955087 -> j155006797;
	j780828549 [label="Certo… pode falar, vou ouvir",shape=box,color=red];
		j780828549 -> j3881356472;
	j15258425 [label="Não, tô fora disso",shape=box,color=red];
		j15258425 -> j1400050825;
	j86156415 [label="Eu vi um Dax, um Dax Dourado, um Dax de Elite largar suas espadas sagradas e douradas e fugir do campo de batalha em que os Tennos invadiram com seus Warframes.",shape=box,color=blue];
		j86156415 -> j1529619926;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j3881356472 [label="+5 Chemistry",color=orange];
		j3881356472 -> j1090904878;
	j1400050825 [label="E eis que eu também.",shape=box,color=blue];
		j1400050825 -> "Chat ends.";
	j1529619926 [label="O casulo de proteção infestada que eles acreditavam proteger seus corpos, mas não suas mentes. Eles não são culpados por serem como são.",shape=box,color=blue];
		j1529619926 -> j919436488;
	j1090904878 [label="Obrigado. Que chegue o momento, em algum dia terrível, em que você precise estar preparado para fazer o impensável.",shape=box,color=blue];
		j1090904878 -> j576797765;
	j919436488 [label="Atormentados pelo Void… forçados a assassinar ou testemunhar a morte de seus próprios pais… sujeitos à guerra… tendo suas memórias roubadas… perdidos em criogenia por séculos…",shape=box,color=blue];
		j919436488 -> j3520952914;
	j3520952914 [label="O fato de eles não serem completamente lunáticos é um milagre, Usurpador. Não estou dizendo que algo vai dar errado. Estou apenas dizendo que poderia dar. E que você precisa ter um plano para o caso de esse dia chegar.",shape=box,color=blue];
		j3520952914 -> j4099919225;
	j4099919225 [label="Não há mal nenhum em estar preparado para o pior. O pior que pode acontecer é não estar.",shape=box,color=blue];
