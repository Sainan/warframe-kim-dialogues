	j1188921410 [label="+5 Chemistry",color=orange];
		j1188921410 -> j604298562;
	j3329285970 [label="Então é uma grande sorte que você esteja falando com o \"Diabo de Tau\". Há um motivo para eu ser conhecido como estrategista. Vamos começar pelo básico: números. Você está terrivelmente em desvantagem nesse quesito. ",shape=box,color=blue];
