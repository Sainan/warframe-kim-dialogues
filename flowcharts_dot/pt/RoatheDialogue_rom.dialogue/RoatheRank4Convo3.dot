		j17348121 -> "Chat ends.";
	j3123862872 [label="Porque não sei se você percebeu, mas a \"Lótus\" não é somente um Sentient (responsável por colocar Lua no Void, diga-se de passagem), mas também perdeu o controle de seus circuitos de forma mensurável.",shape=box,color=blue];
