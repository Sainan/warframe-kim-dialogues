		j3123862872 -> j2650897810;
	j766745904 [label="Não estou tentando ser grosseiro. Estou falando muito sério, percebe? Esta é uma conversa puramente pragmática. ",shape=box,color=blue];
		j766745904 -> j3123862872;
	"Chat ends." [color=orange];
	j2456378906 [label="Ela tá bem, você não sabe do que tá falando",shape=box,color=red];
		j2456378906 -> j3049010733;
	j556453001 [label="Perdeu o controle dos circuitos? O que você quer dizer com isso?",shape=box,color=red];
		j556453001 -> j937709368;
	j3934370938 [label="Não, não vou fazer isso. A Lótus salvou minha vida, salvou a vida dos Tennos inúmeras vezes. Devemos tudo a ela",shape=box,color=red];
		j3934370938 -> j2921612097;
	j1795201916 [label="Cala a boca Roathe, esse papo não é pra mim [Encerrar Conversa]",shape=box,color=red];
		j1795201916 -> j3876281447;
	j2650897810 [label="Eu sei, também tô preocupado. Mas ela já fez tanto pela gente, e eu não posso virar as costas pra ela. Preciso apoiá-la",shape=box,color=red];
		j2650897810 -> j2260278244;
	j3049010733 [label="Não? Presta atenção! Olha ao redor! Quantos meses ela passou parada na beira de um precipício, segurando um celular antigo, cantarolando para si mesma? Olhando fixamente para o Void?",shape=box,color=blue];
		j3049010733 -> j2731263670;
	j937709368 [label="Quantos meses ela passou parada na beira de um precipício, segurando um celular antigo, cantarolando para si mesma? Olhando fixamente para o Void?",shape=box,color=blue];
		j937709368 -> j2731263670;
	j2921612097 [label="Não sou insensível. Entendo o que você está passando. Você deve muito a ela. Não estou dizendo para você matá-la, estou dizendo para você parar de permitir que ela influencie as pessoas ao seu redor.",shape=box,color=blue];
		j2921612097 -> j937709368;
	j3876281447 [label="Como quiser. Mas quando tudo isso desabar ao seu redor? Não venha rastejar até mim em busca de ajuda.",shape=box,color=blue];
		j3876281447 -> "Chat ends.";
	j2260278244 [label="+5 Chemistry",color=orange];
		j2260278244 -> j3270051335;
	j2731263670 [label="E agora ela está simplesmente… pairando? Na escuridão? Enviando seu clone infantil cada vez mais fundo nas memórias dele, para quê? Um caminho para casa, simplesmente porque Albrecht estalou os dedos e sussurrou a palavra mágica?",shape=box,color=blue];
		j2731263670 -> j1667005159;
	j3270051335 [label="Não sou insensível. Entendo o que você está passando. Você deve muito a ela. Não estou dizendo para você matá-la, estou dizendo para você parar de permitir que ela influencie as pessoas ao seu redor.",shape=box,color=blue];
		j3270051335 -> j4111894230;
	j1667005159 [label="Você não acha isso suspeito? Não acha isso perigoso? É uma armadilha. Ela está sendo manipulada. Seja pelo Albrecht ou por essa tal \"Indiferença\". Ela é um programa defeituoso. Seus preceitos estão falhando.",shape=box,color=blue];
		j1667005159 -> j2146873949;
	j4111894230 [label="Quando ela estava ali parada na beira do precipício, segurando um celular antigo, cantarolando baixinho? Olhando fixamente para o Void? Você não pensou que ela pudesse pular?",shape=box,color=blue];
		j4111894230 -> j2731263670;
	j2146873949 [label="Não acho que ela queira te fazer mal. Acho que ela está apenas sendo usada. Mas quando chegar a hora, você pode precisar se defender. Ou pode precisar lutar.",shape=box,color=blue];
		j2146873949 -> j3827000387;
	j3827000387 [label="E embora seja (esperançosamente) provável que você entenda a importância de evitar que uma segunda onda de problemas com a Lótus se agrave, seu exército de crianças selvagens não entenderá. Portanto, pergunto novamente:",shape=box,color=blue];
		j3827000387 -> j3067513790;
	j3067513790 [label="Quem você acha que venceria se chegasse o dia terrível e você tivesse que lutar com todos os seus recursos? Você, e tudo o que você tem, contra todos os Tennos e a Lótus?",shape=box,color=blue];
		j3067513790 -> j2507599246;
		j3067513790 -> j4045650936;
		j3067513790 -> j157589750;
	j2507599246 [label="Esse papo é uma baita estupidez [Encerrar Conversa]",shape=box,color=red];
		j2507599246 -> j24296485;
	j4045650936 [label="Tem tipo… sei lá, um monte deles. E só 1 de mim, Roathe",shape=box,color=red];
