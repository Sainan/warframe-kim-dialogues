	edge [fontname="Roboto Condensed"];

	"RoatheRank2Convo5 begins." [color=orange];
		"RoatheRank2Convo5 begins." -> j2554321341;
	j2554321341 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		j2554321341 -> j364889355 [label=true,color=green];
		j2554321341 -> "Chat ends." [label=false,color=brown];
	j364889355 [label="Check boolean RoatheKnowsReset2",color=orange];
		j364889355 -> j2948729154 [label=true,color=green];
		j364889355 -> j1918363296 [label=false,color=brown];
	"Chat ends." [color=orange];
	j2948729154 [label="O que o Roathe do passado lhe revelou sobre seu relacionamento com a Executora Nitokh? Bah. Estou tentando entender: como meu eu do passado pôde ter lhe confidenciado informações tão pessoais… apenas para que você as apagasse completamente da minha memória?",shape=box,color=blue];
		j2948729154 -> j3228610875;
	j1918363296 [label="Evaluate expressions on HellStory counter",color=orange];
		j1918363296 -> j1412515154 [label="x >= 1",color=purple];
		j1918363296 -> "Chat ends." [label="x <= 1",color=purple];
		j1918363296 -> "Chat ends." [label="false",color=purple];
	j3228610875 [label="Isso me corrói por dentro. Saber que eu poderia ter te contado tudo, absolutamente tudo – ter me exposto completamente, até o fundo da minha alma, e você… ter apagado tudo de novo. Como se eu não fosse nada além de um brinquedinho para você.",shape=box,color=blue];
		j3228610875 -> j524893250;
	j1412515154 [label="Você já me ouviu mencionar a Executora Nitokh antes. E meu… relacionamento com ela. Você precisa entender que o Império Orokin não era inteiramente maligno.",shape=box,color=blue];
		j1412515154 -> j990621941;
	j524893250 [label="Suponho que seja justo. Não era assim que nós, Orokin, tratávamos a humanidade? O Teatro Yuvan? Desfilando carne bonita e escolhendo nossos novos corpos à vontade, torturando uns aos outros com jogos doentios, conforme nos convinha…",shape=box,color=blue];
		j524893250 -> j1462750909;
	j990621941 [label="Parte meu coração saber que sua devastação e depravação são as únicas lembranças que teremos dele. Sim, isso existiu, não nego isso. ",shape=box,color=blue];
		j990621941 -> j1859760661;
	j1462750909 [label="Eu odeio isso. Odeio muito, muito mesmo.",shape=box,color=blue];
		j1462750909 -> j2707538557;
		j1462750909 -> j3507225997;
		j1462750909 -> j17348121;
	j1859760661 [label="Mas também era capaz de tanta beleza. Tanta alegria. Tanto amor. Tantos avanços científicos e artísticos. Veja o que conseguimos realizar! ",shape=box,color=blue];
		j1859760661 -> j3163687863;
	j2707538557 [label="Mesmo eu não tendo a intenção de te magoar assim, e desculpa por isso, se te ensinou como é estar do outro lado do Império Orokin, então é uma lição valiosa",shape=box,color=red];
		j2707538557 -> j1007193962;
	j3507225997 [label="Eu nunca quis que isso te magoasse assim. Você não tem que pedir desculpa pela maneira como a sociedade Orokin funcionava, você não construiu ela. Você tava tentando salvar o que dava",shape=box,color=red];
		j3507225997 -> j2415523915;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j3163687863 [label="Então, quando Nitokh me convocou e comunicou sua intenção de exterminar todos os Orokin, eu concordei imediatamente. Eu queria cortar a cabeça da serpente venenosa. Eu queria substituir tudo por um sistema mais misericordioso. Um líder mais benigno.",shape=box,color=blue];
		j3163687863 -> j2233136016;
		j3163687863 -> j4146556371;
		j3163687863 -> j17348121;
	j1007193962 [label="Add 3 to Thermostat counter",color=orange];
		j1007193962 -> j1195154532;
	j2415523915 [label="Add -3 to Thermostat counter",color=orange];
		j2415523915 -> j3626954014;
	j2233136016 [label="Você queria substituir os Imperadores e Executores por você mesmo, é isso que tá querendo dizer?",shape=box,color=red];
		j2233136016 -> j1009255657;
	j4146556371 [label="E quem seria esse líder?",shape=box,color=red];
		j4146556371 -> j4269050096;
	j1195154532 [label="O Império Orokin não era inteiramente maligno. Parte meu coração saber que sua devastação e depravação são as únicas lembranças que teremos dele. Sim, isso existiu, não nego isso.",shape=box,color=blue];
		j1195154532 -> j998333193;
	j3626954014 [label="Se ao menos os outros tivessem conseguido enxergar as coisas dessa maneira. Se ao menos Nitokh tivesse essa visão.",shape=box,color=blue];
		j3626954014 -> j1195154532;
	j1009255657 [label="Mas é claro!",shape=box,color=blue];
		j1009255657 -> j428937804;
	j4269050096 [label="Eu mesmo, claro.",shape=box,color=blue];
		j4269050096 -> j428937804;
	j998333193 [label="Mas também era capaz de tanta beleza. Tanta alegria. Tanto amor. Tantos avanços científicos e artísticos. Veja o que conseguimos realizar! ",shape=box,color=blue];
		j998333193 -> j3203303966;
	j428937804 [label="Eu garantiria que todos os Executores e Imperadores fossem… destituídos, e assumiria como Executor Interino até que um novo sistema pudesse ser implementado.",shape=box,color=blue];
		j428937804 -> j2233969214;
	j3203303966 [label="Então, quando Nitokh me convocou e comunicou sua intenção de exterminar todos os Orokin, eu concordei imediatamente. Eu queria cortar a cabeça da serpente venenosa. Eu queria substituir tudo por um sistema mais misericordioso. Um líder mais benigno.",shape=box,color=blue];
		j3203303966 -> j835932085;
		j3203303966 -> j2888358443;
	j2233969214 [label="Não sei quanto tempo isso levaria, mas seria melhor do que o que ocorreu após a Grande Guerra, não é?",shape=box,color=blue];
		j2233969214 -> j1172298579;
		j2233969214 -> j1278339675;
		j2233969214 -> j1268509462;
	j835932085 [label="Você queria substituir os Imperadores e Executores por você mesmo, é isso que tá querendo dizer?",shape=box,color=red];
		j835932085 -> j2045027666;
	j2888358443 [label="E quem seria esse líder?",shape=box,color=red];
		j2888358443 -> j1802772043;
	j1172298579 [label="Grande Guerra?",shape=box,color=red];
		j1172298579 -> j3850435650;
	j1278339675 [label="Seja honesto com você mesmo, acha que algum dia abriria mão do poder?",shape=box,color=red];
		j1278339675 -> j1653216148;
	j1268509462 [label="Acho que você jamais teria aberto mão do poder, Roathe",shape=box,color=red];
		j1268509462 -> j761712589;
	j2045027666 [label="Mas é claro! E não finja que nunca ouviu isso antes, tenho certeza de que já ouviu. ",shape=box,color=blue];
		j2045027666 -> j1826268314;
	j1802772043 [label="Eu mesmo, é claro. E não finja que nunca ouviu isso antes, tenho certeza de que já ouviu.",shape=box,color=blue];
		j1802772043 -> j1826268314;
	j3850435650 [label="Vocês chamam de \"Guerra Ancestral\" agora. Para mim, está longe de ser \"Ancestral\", aconteceu há poucos anos, segundo a minha memória.",shape=box,color=blue];
		j3850435650 -> j1308853186;
	j1653216148 [label="Hum. Não sei. Isso já não importa mais, não é? Mas naquela época, eu estava totalmente convencido de que sim.",shape=box,color=blue];
		j1653216148 -> j1999180779;
	j761712589 [label="+5 Chemistry",color=orange];
		j761712589 -> j3617339383;
	j1826268314 [label="Eu garantiria que todos os Executores e Imperadores fossem… destituídos, e assumiria como Executor Interino até que um novo sistema pudesse ser implementado.",shape=box,color=blue];
		j1826268314 -> j287775240;
	j1308853186 [label="Viajar no tempo é realmente estranho.",shape=box,color=blue];
		j1308853186 -> j2526550702;
	j1999180779 [label="Eu me esforcei tanto para voltar para cá, apenas para perceber que… meu povo agora está morto. Eu teria sido executado junto com eles.",shape=box,color=blue];
		j1999180779 -> j1677389229;
	j3617339383 [label="Cale-se.",shape=box,color=blue];
		j3617339383 -> j1022512950;
	j287775240 [label="Não sei quanto tempo isso levaria, mas seria melhor do que o que ocorreu após a Grande Guerra, não é?",shape=box,color=blue];
		j287775240 -> j1278339675;
		j287775240 -> j1268509462;
		j287775240 -> j1172298579;
	j2526550702 [label="Em apenas alguns anos, segundo a minha percepção, milhares de pessoas morreram na \"realidade\" — onde o Império desmoronou e meu povo pereceu. ",shape=box,color=blue];
		j2526550702 -> j1174342406;
	j1677389229 [label="Os Tennos teriam me massacrado junto com todos os outros na noite dos Tambores de Naga. Eu provavelmente teria morrido tentando salvar a vida de Nitokh.",shape=box,color=blue];
		j1677389229 -> j1057321083;
	j1022512950 [label="Na época, eu estava totalmente convencido de que sim. Mas agora, isso não importa mais, não é?",shape=box,color=blue];
		j1022512950 -> j1999180779;
	j1174342406 [label="Cheguei à conclusão de que não faria diferença se eu renunciasse ao poder ou não, embora na época eu estivesse convencido de que faria.",shape=box,color=blue];
		j1174342406 -> j1677389229;
	j1057321083 [label="Fico imaginando o que aconteceu com ela? Os registros nem sequer mencionam seu nome… todos os horrores cometidos em seu nome, todas as mortes, todas as atrocidades… e talvez eu seja a única pessoa que saiba de tudo isso.",shape=box,color=blue];
		j1057321083 -> j43780247;
	j43780247 [label="Bem, sem mencionar tudo o que poderá ser desbloqueado no futuro a partir da cabeça do Tenno através daquele Refratário Obscuro. Mas isso não é problema meu.",shape=box,color=blue];
		j43780247 -> j946705291;
		j43780247 -> j1034619092;
		j43780247 -> j1635834508;
	j946705291 [label="Você parece um pouco intimidado pela criança",shape=box,color=red];
		j946705291 -> j2226597788;
	j1034619092 [label="O que rolou entre você e a Nitokh?",shape=box,color=red];
		j1034619092 -> j1250728036;
	j1635834508 [label="Então você tava planejando trair os Orokin?",shape=box,color=red];
		j1635834508 -> j1259390592;
	j2226597788 [label="Vi um grupo de crianças, devastadas pelo Void, pilotando máquinas de guerra Infestadas que antes eram soldados e agora estavam transformadas em obras de arte grotescas, belas e mortíferas, destruindo batalhões inteiros de soldados. ",shape=box,color=blue];
		j2226597788 -> j427119200;
	j1250728036 [label="Tudo ",shape=box,color=blue];
		j1250728036 -> j2510625679;
	j1259390592 [label="Sim. Nós dois estávamos. Embora eu acredite que Nitokh estivesse planejando me trair, e eu também estivesse planejando trair ela. Você sabe como as coisas funcionam entre nós, Orokin.",shape=box,color=blue];
		j1259390592 -> j3380220614;
	j427119200 [label="Fui descobrir que eles destruíram meu Império. Um Império que governava todo o Sistema de Origem. E que estava prestes a aniquilar a rebelião em Tau.",shape=box,color=blue];
		j427119200 -> j4277018710;
	j2510625679 [label="Tudo aconteceu entre nós dois.",shape=box,color=blue];
		j2510625679 -> j985818238;
	j3380220614 [label="Todo mundo estava sempre tramando contra todo mundo. Era só mais um dia da semana, na verdade.",shape=box,color=blue];
		j3380220614 -> j575867407;
	j4277018710 [label="E fizeram isso em apenas uma noite.",shape=box,color=blue];
		j4277018710 -> j2078484507;
	j985818238 [label="Tudo e mais um pouco.",shape=box,color=blue];
		j985818238 -> j805003753;
	j575867407 [label="Traições entre Orokin eram bastante comuns. Mas trair o Império inteiro? Este tipo de traição era digno não apenas de execução por Luz da Jade, mas também pelo Projeto Cephalon.",shape=box,color=blue];
		j575867407 -> j1500183088;
	j2078484507 [label="Você não ficaria intimidado?!",shape=box,color=blue];
		j2078484507 -> j3471799966;
	j805003753 [label="E isso é tudo o que desejo revelar sobre o assunto no momento.",shape=box,color=blue];
		j805003753 -> j2876331605;
	j1500183088 [label="Boolean RoatheTraitor1 is now true.",color=orange];
		j1500183088 -> j2619995360;
		j1500183088 -> j4199520069;
	j3471799966 [label="Não consigo expressar o que estávamos arriscando ao tentar eliminar os Executores - muito menos todos os Orokin, Usurpador.",shape=box,color=blue];
		j3471799966 -> j575867407;
	j2876331605 [label="Boolean RoatheExecutor1 is now true.",color=orange];
		j2876331605 -> j3471799966;
	j2619995360 [label="Qual você acha que era pior?",shape=box,color=red];
		j2619995360 -> j522854861;
	j4199520069 [label="Então esse tipo de esquema não era normal?",shape=box,color=red];
		j4199520069 -> j4251768236;
	j522854861 [label="O Projeto Cephalon do Nihil, sem dúvida. As criações do Vidraceiro são…",shape=box,color=blue];
		j522854861 -> j2206672406;
	j4251768236 [label="A existência do Império Orokin estava por um fio, na ponta de uma adaga, Usurpador. Ele estava à beira da destruição o tempo todo. Apenas uma coisa o mantinha funcionando:",shape=box,color=blue];
		j4251768236 -> j3060848632;
	j2206672406 [label="A Luz da Jade subjuga rapidamente aqueles que não possuem armadura ou escudo. É uma morte misericordiosa.",shape=box,color=blue];
		j2206672406 -> j1725380207;
	j3060848632 [label="As normas sociais.",shape=box,color=blue];
		j3060848632 -> j1720065264;
	j1725380207 [label="Os Cephalons, quando convertidos com consentimento, podem ser indolores e até mesmo realizados de forma não destrutiva. No entanto… e quando usados como punição?",shape=box,color=blue];
		j1725380207 -> j230037133;
	j1720065264 [label="Ninguém simplesmente se levantava e assassinava os Orokin! Isso é impensável, Peregrino! Absolutamente ridículo!",shape=box,color=blue];
		j1720065264 -> j3587988566;
	j230037133 [label="As memórias são sagradas para os Orokin, Peregrino. No fim, elas são tudo o que somos. Nossos corpos são temporários. Nossos rostos, nossas vozes, nosso sangue, tudo mutável. Tudo pode ser mudado como a tendência do momento.",shape=box,color=blue];
		j230037133 -> j4186474857;
	j3587988566 [label="O que, no fim das contas, ironicamente também facilitou tudo. Como tenho certeza de que seu Tenno duplicado aprendeu. ",shape=box,color=blue];
		j3587988566 -> j3490677155;
		j3587988566 -> j1227504573;
	j4186474857 [label="Check boolean RoatheKnowsReset2",color=orange];
		j4186474857 -> j3620559473 [label=true,color=green];
		j4186474857 -> j3490677155 [label=false,color=brown];
		j4186474857 -> j1227504573 [label=false,color=brown];
	j3490677155 [label="Mas claramente você nunca chegou perto o suficiente pra fazer sua tentativa",shape=box,color=red];
		j3490677155 -> j2745098065;
	j1227504573 [label="E aí o que aconteceu com seu plano?",shape=box,color=red];
		j1227504573 -> j652053828;
	j3620559473 [label="O que, aliás, provavelmente explica por que estou tão profundamente e absolutamente irritado por você estar brincando com elas. ",shape=box,color=blue];
		j3620559473 -> j3490677155;
		j3620559473 -> j1227504573;
	j2745098065 [label="Evaluate expressions on HellStory counter",color=orange];
		j2745098065 -> j812033629 [label="x >= 21",color=purple];
		j2745098065 -> j3644250740 [label="x < 21",color=purple];
		j2745098065 -> j3644250740 [label="false",color=purple];
	j652053828 [label="Evaluate expressions on HellStory counter",color=orange];
		j652053828 -> j2798939088 [label="x >= 21",color=purple];
		j652053828 -> j3702036943 [label="x < 21",color=purple];
		j652053828 -> j3702036943 [label="false",color=purple];
	j812033629 [label="Você tem razão, claro! O Albrecht me encontrou naquele corredor antes que Nitokh e eu tivéssemos tempo de armar nossa armadilha para os Executores.",shape=box,color=blue];
		j812033629 -> j3941763259;
	j3644250740 [label="Não, claramente não. Fui transformado à força nessa… coisa pelo Albrecht antes que Nitokh e eu tivéssemos tempo de armar nossa armadilha para os Executores.",shape=box,color=blue];
		j3644250740 -> j4034023363;
	j2798939088 [label="Você sabe muito bem o que aconteceu com o nosso plano, não?! Albrecht me encontrou naquele corredor antes que Nitokh e eu tivéssemos tempo de armar nossa armadilha para os Executores.",shape=box,color=blue];
		j2798939088 -> j3618210892;
	j3702036943 [label="Fui transformado à força nessa… coisa pelo Albrecht antes que Nitokh e eu tivéssemos tempo de armar nossa armadilha para os Executores.",shape=box,color=blue];
		j3702036943 -> j4034023363;
	j3941763259 [label="E ele me ofereceu o soro de Protoframe. E… bem… nós dois sabemos o que aconteceu em seguida.",shape=box,color=blue];
		j3941763259 -> j4157107569;
	j4034023363 [label="Num instante, lembro-me de estar num grande corredor dourado, no instante seguinte, de estar gritando de dor em algum buraco infernal e esquecido na \"Gaule\".",shape=box,color=blue];
		j4034023363 -> j2581781587;
	j3618210892 [label="Ele me ofereceu o soro de Protoframe, e nós dois sabemos o que aconteceu em seguida!",shape=box,color=blue];
		j3618210892 -> j4157107569;
	j4157107569 [label="Uma questão que ainda me deixa furioso. Por que eu te confessei isso?! Por que você sabe disso tudo?! ",shape=box,color=blue];
		j4157107569 -> j3516757317;
	j2581781587 [label="Nitokh deve ter abandonado o plano assim que eu desapareci. Provavelmente, me atribuiu toda a culpa pela traição, usando-me como um bode expiatório.",shape=box,color=blue];
		j2581781587 -> j414509518;
	j3516757317 [label="Bah! Não. Deixa pra lá. Tenho que ir agora, antes que eu quebre esse computador maldito num ataque de raiva.",shape=box,color=blue];
		j3516757317 -> j1933300832;
	j414509518 [label="Isso explica todos os registros que tenho encontrado me chamando de \"covarde\". Claro que me considerariam um covarde - acham que eu fugi! Pff.",shape=box,color=blue];
		j414509518 -> j1664516205;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j1664516205 [label="+10 Chemistry",color=orange];
		j1664516205 -> j2896529758;
	j2896529758 [label="Mas é bom saber que eu era tão crucial para o plano que ele teve que ser completamente descartado assim que desapareci.",shape=box,color=blue];
		j2896529758 -> j878107165;
		j2896529758 -> j2681924208;
	j878107165 [label="Não sei se essa é a lição que você deveria tirar disso tudo",shape=box,color=red];
		j878107165 -> j2678440834;
	j2681924208 [label="É bom se sentir necessário",shape=box,color=red];
		j2681924208 -> j1220947526;
	j2678440834 [label="Add 1 to Thermostat counter",color=orange];
		j2678440834 -> j2398240008;
	j1220947526 [label="+5 Chemistry",color=orange];
		j1220947526 -> j1459341866;
	j2398240008 [label="Encontre seu valor onde quiser, Peregrino, e deixe-me encontrar o meu.",shape=box,color=blue];
