		1309 -> 1312 [label="x >= 21",color=purple];
		1309 -> 5777 [label="x < 21",color=purple];
		1309 -> 5777 [label="false",color=purple];
	1310 [label="Você tem razão, claro! O Albrecht me encontrou naquele corredor antes que Nitokh e eu tivéssemos tempo de armar nossa armadilha para os Executores.",shape=box,color=blue];
		1310 -> 1313;
	1311 [label="Não, claramente não. Fui transformado à força nessa… coisa pelo Albrecht antes que Nitokh e eu tivéssemos tempo de armar nossa armadilha para os Executores.",shape=box,color=blue];
		1311 -> 1314;
	1312 [label="Você sabe muito bem o que aconteceu com o nosso plano, não?! Albrecht me encontrou naquele corredor antes que Nitokh e eu tivéssemos tempo de armar nossa armadilha para os Executores.",shape=box,color=blue];
		1312 -> 1315;
	5777 [label="Fui transformado à força nessa… coisa pelo Albrecht antes que Nitokh e eu tivéssemos tempo de armar nossa armadilha para os Executores.",shape=box,color=blue];
		5777 -> 1314;
	1313 [label="E ele me ofereceu o soro de Protoframe. E… bem… nós dois sabemos o que aconteceu em seguida.",shape=box,color=blue];
		1313 -> 1316;
	1314 [label="Num instante, lembro-me de estar num grande corredor dourado, no instante seguinte, de estar gritando de dor em algum buraco infernal e esquecido na \"Gaule\".",shape=box,color=blue];
		1314 -> 1317;
	1315 [label="Ele me ofereceu o soro de Protoframe, e nós dois sabemos o que aconteceu em seguida!",shape=box,color=blue];
		1315 -> 1316;
	1316 [label="Uma questão que ainda me deixa furioso. Por que eu te confessei isso?! Por que você sabe disso tudo?! ",shape=box,color=blue];
		1316 -> 1318;
	1317 [label="Nitokh deve ter abandonado o plano assim que eu desapareci. Provavelmente, me atribuiu toda a culpa pela traição, usando-me como um bode expiatório.",shape=box,color=blue];
		1317 -> 1319;
	1318 [label="Bah! Não. Deixa pra lá. Tenho que ir agora, antes que eu quebre esse computador maldito num ataque de raiva.",shape=box,color=blue];
		1318 -> 1320;
	1319 [label="Isso explica todos os registros que tenho encontrado me chamando de \"covarde\". Claro que me considerariam um covarde - acham que eu fugi! Pff.",shape=box,color=blue];
		1319 -> 1321;
	1320 [label="+10 Chemistry",color=orange];
		1320 -> 1322;
	1321 [label="+10 Chemistry",color=orange];
		1321 -> 1323;
	1322 [label="Chat ends.",color=orange];
	1323 [label="Mas é bom saber que eu era tão crucial para o plano que ele teve que ser completamente descartado assim que desapareci.",shape=box,color=blue];
		1323 -> 1324;
		1323 -> 1325;
	1324 [label="Não sei se essa é a lição que você deveria tirar disso tudo",shape=box,color=red];
		1324 -> 1326;
	1325 [label="É bom se sentir necessário",shape=box,color=red];
