digraph {
	1224 [label="RoatheRank2Convo5 begins.",color=orange];
		1224 -> 1225;
	1225 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1225 -> 1226 [label=true,color=green];
		1225 -> 1227 [label=false,color=brown];
	1226 [label="Check boolean RoatheKnowsReset2",color=orange];
		1226 -> 1229 [label=true,color=green];
		1226 -> 1228 [label=false,color=brown];
	1227 [label="Chat ends.",color=orange];
	1229 [label="O que o Roathe do passado lhe revelou sobre seu relacionamento com a Executora Nitokh? Bah. Estou tentando entender: como meu eu do passado pôde ter lhe confidenciado informações tão pessoais… apenas para que você as apagasse completamente da minha memória?",shape=box,color=blue];
		1229 -> 1232;
	1228 [label="Evaluate expressions on HellStory",color=orange];
		1228 -> 1231 [label="x >= 1",color=purple];
		1228 -> 1230 [label="x <= 1",color=purple];
		1228 -> 1230 [label="false",color=purple];
	1232 [label="Isso me corrói por dentro. Saber que eu poderia ter te contado tudo, absolutamente tudo – ter me exposto completamente, até o fundo da minha alma, e você… ter apagado tudo de novo. Como se eu não fosse nada além de um brinquedinho para você.",shape=box,color=blue];
		1232 -> 1234;
	1231 [label="Você já me ouviu mencionar a Executora Nitokh antes. E meu… relacionamento com ela. Você precisa entender que o Império Orokin não era inteiramente maligno.",shape=box,color=blue];
		1231 -> 1233;
	1230 [label="Chat ends.",color=orange];
	1234 [label="Suponho que seja justo. Não era assim que nós, Orokin, tratávamos a humanidade? O Teatro Yuvan? Desfilando carne bonita e escolhendo nossos novos corpos à vontade, torturando uns aos outros com jogos doentios, conforme nos convinha…",shape=box,color=blue];
		1234 -> 1236;
	1233 [label="Parte meu coração saber que sua devastação e depravação são as únicas lembranças que teremos dele. Sim, isso existiu, não nego isso. ",shape=box,color=blue];
		1233 -> 1235;
	1236 [label="Eu odeio isso. Odeio muito, muito mesmo.",shape=box,color=blue];
		1236 -> 1239;
		1236 -> 1240;
		1236 -> 1238;
	1235 [label="Mas também era capaz de tanta beleza. Tanta alegria. Tanto amor. Tantos avanços científicos e artísticos. Veja o que conseguimos realizar! ",shape=box,color=blue];
		1235 -> 1237;
	1239 [label="Mesmo eu não tendo a intenção de te magoar assim, e desculpa por isso, se te ensinou como é estar do outro lado do Império Orokin, então é uma lição valiosa",shape=box,color=red];
		1239 -> 1245;
	1240 [label="Eu nunca quis que isso te magoasse assim. Você não tem que pedir desculpa pela maneira como a sociedade Orokin funcionava, você não construiu ela. Você tava tentando salvar o que dava",shape=box,color=red];
		1240 -> 1246;
	1238 [label="[Encerrar Conversa]",shape=box,color=red];
		1238 -> 1244;
	1237 [label="Então, quando Nitokh me convocou e comunicou sua intenção de exterminar todos os Orokin, eu concordei imediatamente. Eu queria cortar a cabeça da serpente venenosa. Eu queria substituir tudo por um sistema mais misericordioso. Um líder mais benigno.",shape=box,color=blue];
		1237 -> 1241;
		1237 -> 1242;
		1237 -> 1243;
	1245 [label="Add 3 to Thermostat",color=orange];
		1245 -> 1250;
	1246 [label="Add -3 to Thermostat",color=orange];
		1246 -> 1251;
	1244 [label="Chat ends.",color=orange];
	1241 [label="Você queria substituir os Imperadores e Executores por você mesmo, é isso que tá querendo dizer?",shape=box,color=red];
		1241 -> 1247;
	1242 [label="E quem seria esse líder?",shape=box,color=red];
		1242 -> 1248;
	1243 [label="[Encerrar Conversa]",shape=box,color=red];
		1243 -> 1249;
	1250 [label="O Império Orokin não era inteiramente maligno. Parte meu coração saber que sua devastação e depravação são as únicas lembranças que teremos dele. Sim, isso existiu, não nego isso.",shape=box,color=blue];
		1250 -> 1253;
	1251 [label="Se ao menos os outros tivessem conseguido enxergar as coisas dessa maneira. Se ao menos Nitokh tivesse essa visão.",shape=box,color=blue];
		1251 -> 1254;
	1247 [label="Mas é claro!",shape=box,color=blue];
		1247 -> 1252;
	1248 [label="Eu mesmo, claro.",shape=box,color=blue];
		1248 -> 1252;
	1249 [label="Chat ends.",color=orange];
	1253 [label="Mas também era capaz de tanta beleza. Tanta alegria. Tanto amor. Tantos avanços científicos e artísticos. Veja o que conseguimos realizar! ",shape=box,color=blue];
		1253 -> 1256;
	1254 [label="O Império Orokin não era inteiramente maligno. Parte meu coração saber que sua devastação e depravação são as únicas lembranças que teremos dele. Sim, isso existiu, não nego isso.",shape=box,color=blue];
		1254 -> 1253;
	1252 [label="Eu garantiria que todos os Executores e Imperadores fossem… destituídos, e assumiria como Executor Interino até que um novo sistema pudesse ser implementado.",shape=box,color=blue];
		1252 -> 1255;
	1256 [label="Então, quando Nitokh me convocou e comunicou sua intenção de exterminar todos os Orokin, eu concordei imediatamente. Eu queria cortar a cabeça da serpente venenosa. Eu queria substituir tudo por um sistema mais misericordioso. Um líder mais benigno.",shape=box,color=blue];
		1256 -> 1260;
		1256 -> 1261;
	1255 [label="Não sei quanto tempo isso levaria, mas seria melhor do que o que ocorreu após a Grande Guerra, não é?",shape=box,color=blue];
		1255 -> 1257;
		1255 -> 1258;
		1255 -> 1259;
	1260 [label="Você queria substituir os Imperadores e Executores por você mesmo, é isso que tá querendo dizer?",shape=box,color=red];
		1260 -> 1265;
	1261 [label="E quem seria esse líder?",shape=box,color=red];
		1261 -> 1266;
	1257 [label="Grande Guerra?",shape=box,color=red];
		1257 -> 1262;
	1258 [label="Seja honesto com você mesmo, acha que algum dia abriria mão do poder?",shape=box,color=red];
		1258 -> 1263;
	1259 [label="Acho que você jamais teria aberto mão do poder, Roathe",shape=box,color=red];
		1259 -> 1264;
	1265 [label="Mas é claro! E não finja que nunca ouviu isso antes, tenho certeza de que já ouviu. ",shape=box,color=blue];
		1265 -> 1270;
	1266 [label="Eu mesmo, é claro. E não finja que nunca ouviu isso antes, tenho certeza de que já ouviu.",shape=box,color=blue];
		1266 -> 1270;
	1262 [label="Vocês chamam de \"Guerra Ancestral\" agora. Para mim, está longe de ser \"Ancestral\", aconteceu há poucos anos, segundo a minha memória.",shape=box,color=blue];
		1262 -> 1267;
	1263 [label="Hum. Não sei. Isso já não importa mais, não é? Mas naquela época, eu estava totalmente convencido de que sim.",shape=box,color=blue];
		1263 -> 1268;
	1264 [label="+5 Chemistry",color=orange];
		1264 -> 1269;
	1270 [label="Eu garantiria que todos os Executores e Imperadores fossem… destituídos, e assumiria como Executor Interino até que um novo sistema pudesse ser implementado.",shape=box,color=blue];
		1270 -> 1274;
	1267 [label="Viajar no tempo é realmente estranho.",shape=box,color=blue];
		1267 -> 1271;
	1268 [label="Eu me esforcei tanto para voltar para cá, apenas para perceber que… meu povo agora está morto. Eu teria sido executado junto com eles.",shape=box,color=blue];
		1268 -> 1272;
	1269 [label="Cale-se.",shape=box,color=blue];
		1269 -> 1273;
	1274 [label="Não sei quanto tempo isso levaria, mas seria melhor do que o que ocorreu após a Grande Guerra, não é?",shape=box,color=blue];
		1274 -> 1258;
		1274 -> 1259;
		1274 -> 1257;
	1271 [label="Em apenas alguns anos, segundo a minha percepção, milhares de pessoas morreram na \"realidade\" — onde o Império desmoronou e meu povo pereceu. ",shape=box,color=blue];
		1271 -> 5775;
	1272 [label="Os Tennos teriam me massacrado junto com todos os outros na noite dos Tambores de Naga. Eu provavelmente teria morrido tentando salvar a vida de Nitokh.",shape=box,color=blue];
		1272 -> 1275;
	1273 [label="Na época, eu estava totalmente convencido de que sim. Mas agora, isso não importa mais, não é?",shape=box,color=blue];
		1273 -> 1268;
	5775 [label="Cheguei à conclusão de que não faria diferença se eu renunciasse ao poder ou não, embora na época eu estivesse convencido de que faria.",shape=box,color=blue];
		5775 -> 1272;
	1275 [label="Fico imaginando o que aconteceu com ela? Os registros nem sequer mencionam seu nome… todos os horrores cometidos em seu nome, todas as mortes, todas as atrocidades… e talvez eu seja a única pessoa que saiba de tudo isso.",shape=box,color=blue];
		1275 -> 1276;
	1276 [label="Bem, sem mencionar tudo o que poderá ser desbloqueado no futuro a partir da cabeça do Tenno através daquele Refratário Obscuro. Mas isso não é problema meu.",shape=box,color=blue];
		1276 -> 1277;
		1276 -> 1278;
		1276 -> 1279;
	1277 [label="Você parece um pouco intimidado pela criança",shape=box,color=red];
		1277 -> 1280;
	1278 [label="O que rolou entre você e a Nitokh?",shape=box,color=red];
		1278 -> 1281;
	1279 [label="Então você tava planejando trair os Orokin?",shape=box,color=red];
		1279 -> 1282;
	1280 [label="Vi um grupo de crianças, devastadas pelo Void, pilotando máquinas de guerra Infestadas que antes eram soldados e agora estavam transformadas em obras de arte grotescas, belas e mortíferas, destruindo batalhões inteiros de soldados. ",shape=box,color=blue];
		1280 -> 1283;
	1281 [label="Tudo ",shape=box,color=blue];
		1281 -> 1284;
	1282 [label="Sim. Nós dois estávamos. Embora eu acredite que Nitokh estivesse planejando me trair, e eu também estivesse planejando trair ela. Você sabe como as coisas funcionam entre nós, Orokin.",shape=box,color=blue];
		1282 -> 1285;
	1283 [label="Fui descobrir que eles destruíram meu Império. Um Império que governava todo o Sistema de Origem. E que estava prestes a aniquilar a rebelião em Tau.",shape=box,color=blue];
		1283 -> 1286;
	1284 [label="Tudo aconteceu entre nós dois.",shape=box,color=blue];
		1284 -> 1287;
	1285 [label="Todo mundo estava sempre tramando contra todo mundo. Era só mais um dia da semana, na verdade.",shape=box,color=blue];
		1285 -> 1288;
	1286 [label="E fizeram isso em apenas uma noite.",shape=box,color=blue];
		1286 -> 1289;
	1287 [label="Tudo e mais um pouco.",shape=box,color=blue];
		1287 -> 1290;
	1288 [label="Traições entre Orokin eram bastante comuns. Mas trair o Império inteiro? Este tipo de traição era digno não apenas de execução por Luz da Jade, mas também pelo Projeto Cephalon.",shape=box,color=blue];
		1288 -> 1291;
	1289 [label="Você não ficaria intimidado?!",shape=box,color=blue];
		1289 -> 1292;
	1290 [label="E isso é tudo o que desejo revelar sobre o assunto no momento.",shape=box,color=blue];
		1290 -> 1293;
	1291 [label="Update boolean RoatheTraitor1",color=orange];
		1291 -> 1294;
		1291 -> 1295;
	1292 [label="Não consigo expressar o que estávamos arriscando ao tentar eliminar os Executores - muito menos todos os Orokin, Usurpador.",shape=box,color=blue];
		1292 -> 1288;
	1293 [label="Update boolean RoatheExecutor1",color=orange];
		1293 -> 1292;
	1294 [label="Qual você acha que era pior?",shape=box,color=red];
		1294 -> 1296;
	1295 [label="Então esse tipo de esquema não era normal?",shape=box,color=red];
		1295 -> 1297;
	1296 [label="O Projeto Cephalon do Nihil, sem dúvida. As criações do Vidraceiro são…",shape=box,color=blue];
		1296 -> 1298;
	1297 [label="A existência do Império Orokin estava por um fio, na ponta de uma adaga, Usurpador. Ele estava à beira da destruição o tempo todo. Apenas uma coisa o mantinha funcionando:",shape=box,color=blue];
		1297 -> 1299;
	1298 [label="A Luz da Jade subjuga rapidamente aqueles que não possuem armadura ou escudo. É uma morte misericordiosa.",shape=box,color=blue];
		1298 -> 1300;
	1299 [label="As normas sociais.",shape=box,color=blue];
		1299 -> 1301;
	1300 [label="Os Cephalons, quando convertidos com consentimento, podem ser indolores e até mesmo realizados de forma não destrutiva. No entanto… e quando usados como punição?",shape=box,color=blue];
		1300 -> 1302;
	1301 [label="Ninguém simplesmente se levantava e assassinava os Orokin! Isso é impensável, Peregrino! Absolutamente ridículo!",shape=box,color=blue];
		1301 -> 1303;
	1302 [label="As memórias são sagradas para os Orokin, Peregrino. No fim, elas são tudo o que somos. Nossos corpos são temporários. Nossos rostos, nossas vozes, nosso sangue, tudo mutável. Tudo pode ser mudado como a tendência do momento.",shape=box,color=blue];
		1302 -> 1304;
	1303 [label="O que, no fim das contas, ironicamente também facilitou tudo. Como tenho certeza de que seu Tenno duplicado aprendeu. ",shape=box,color=blue];
		1303 -> 1305;
		1303 -> 1306;
	1304 [label="Check boolean RoatheKnowsReset2",color=orange];
		1304 -> 1307 [label=true,color=green];
		1304 -> 1305 [label=false,color=brown];
		1304 -> 1306 [label=false,color=brown];
	1305 [label="Mas claramente você nunca chegou perto o suficiente pra fazer sua tentativa",shape=box,color=red];
		1305 -> 1308;
	1306 [label="E aí o que aconteceu com seu plano?",shape=box,color=red];
		1306 -> 1309;
	1307 [label="O que, aliás, provavelmente explica por que estou tão profundamente e absolutamente irritado por você estar brincando com elas. ",shape=box,color=blue];
		1307 -> 1305;
		1307 -> 1306;
	1308 [label="Evaluate expressions on HellStory",color=orange];
