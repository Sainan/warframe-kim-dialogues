digraph {
	472 [label="RoatheRank1Convo4 begins.",color=orange];
		472 -> 473;
	473 [label="Check boolean LoidFamilyComplete",color=orange];
		473 -> 474 [label=true,color=green];
		473 -> 475 [label=false,color=brown];
	474 [label="É quase trágico o que aconteceu com Euleria e Petros. Nunca fomos amigos, é verdade. Mas eles eram Orokin ainda assim. E agora restam apenas alguns de nós. Embora eu deva ter cuidado com o que digo — quem sabe em que posso me transformar, com o tempo.",shape=box,color=blue];
		474 -> 476;
	475 [label="Acho hilário que Euleria e Petros não façam a mínima ideia de que estamos aqui embaixo. Como ratos, correndo para lá e para cá. Como você e as crianças conseguiram manter tudo isso em segredo por tanto tempo?",shape=box,color=blue];
		475 -> 477;
	476 [label="A que menos me surpreende ter sobrevivido é a \"Avó\". (Imagine só, abrir mão de um nome perfeitamente adequado como Dagath.)",shape=box,color=blue];
		476 -> 478;
		476 -> 479;
	477 [label="Evaluate expressions on HellStory",color=orange];
		477 -> 481 [label="x >= 21",color=purple];
		477 -> 480 [label="x < 21",color=purple];
		477 -> 480 [label="false",color=purple];
	478 [label="Petros?",shape=box,color=red];
		478 -> 482;
	479 [label="O que acha das crianças?",shape=box,color=red];
		479 -> 483;
	481 [label="Embora eu esteja muito mais surpreso que a \"Avó\" não tenha percebido nada. (Imagine só, abrir mão de um nome perfeitamente adequado como Dagath.) Eu achava que ela era sensata.",shape=box,color=blue];
		481 -> 486;
	480 [label="Embora eu esteja muito mais surpreso que a \"Avó\" não tenha percebido nada. (Imagine só, abrir mão de um nome perfeitamente adequado como Dagath.) Eu achava que ela era esperta.",shape=box,color=blue];
		480 -> 484;
		480 -> 485;
	482 [label="Hum? Ah. O Necraloid me informou que você ou a criança andaram por aí ajudando-os a inventar nomes falsos, já que haviam esquecido os originais. Você o conhece como \"Vilcor\".",shape=box,color=blue];
		482 -> 487;
	483 [label="O garoto é petulante, irritante e egocêntrico. Um típico Orokin. \"Kaelli\", como ela diz preferir ser chamada agora, é notavelmente inteligente e sua presença é quase suportável.",shape=box,color=blue];
		483 -> 488;
	486 [label="Isso é um absurdo. Eu sei que já passamos por isso antes. E já conversamos sobre esse assunto. É um tema que ainda me incomoda profundamente.",shape=box,color=blue];
		486 -> 491;
	484 [label="Eles têm seus próprios… problemas para se preocupar",shape=box,color=red];
		484 -> 489;
	485 [label="Petros?",shape=box,color=red];
		485 -> 490;
	487 [label="Mas eu o conhecia como Petros Vorten. O orgulhoso inventor da Frota Necramech. É estranho pensar em quanto tempo se passou para ele e em quão pouco se passou — relativamente falando — para mim.",shape=box,color=blue];
		487 -> 488;
	488 [label="Mas como é que você ainda não sabe disso? Está me fazendo de bobo, Usurpador? Certamente estamos apenas… repetindo o que já foi dito, não?",shape=box,color=blue];
		488 -> 492;
	491 [label="Evaluate expressions",color=orange];
		491 -> 498 [label="RoatheDatingDeal",color=purple];
		491 -> 498 [label="RoatheMarieDatingDeal",color=purple];
		491 -> 498 [label="RoatheLyonDatingDeal",color=purple];
		491 -> 498 [label="RoatheSerumDeal",color=purple];
		491 -> 497 [label="RoatheFamilyDeal",color=purple];
		491 -> 498 [label="RoatheMarieEntratiDeal",color=purple];
		491 -> 498 [label="RoatheLyonConfessionDeal",color=purple];
		491 -> 499 [label="false",color=purple];
	489 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		489 -> 494 [label=true,color=green];
		489 -> 493 [label=false,color=brown];
	490 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		490 -> 496 [label=true,color=green];
		490 -> 495 [label=false,color=brown];
	492 [label="Update boolean RoatheKnowsReset",color=orange];
		492 -> 500;
		492 -> 501;
		492 -> 502;
	498 [label="Aqui estou eu, pronto para divagar sobre a sociedade Orokin, pensando que talvez seja algo vagamente interessante para você. E então me lembro: não é por isso que você está aqui, não é mesmo, Peregrino? Você quer jogar outro jogo…",shape=box,color=blue];
		498 -> 506;
	497 [label="Aqui estou eu, pronto para divagar sobre a sociedade Orokin, pensando que talvez seja algo vagamente interessante para você. E então me lembro: é bem provável que você já tenha ouvido tudo isso antes, não é?",shape=box,color=blue];
		497 -> 505;
	499 [label="Você prefere que eu simplesmente entre no jogo? Ou… tem algum objetivo específico em mente? Estou bastante perplexo com o que você espera ganhar jogando esse jogo cruel.",shape=box,color=blue];
		499 -> 507;
	494 [label="Sim, ouvi isso do Necraloid. Embora pareça que eles tenham menos desde que você ou a criança tentaram resolvê-los. Pelo menos eles não estão mais se autodestruindo, literalmente.",shape=box,color=blue];
		494 -> 504;
	493 [label="Sim, ouvi isso do Necraloid. Parece que eles ainda estão determinados a se destruírem.",shape=box,color=blue];
		493 -> 503;
	496 [label="Hum? Ah. O Necraloid me informou que você ou a criança andaram por aí ajudando-os a inventar nomes falsos, já que haviam esquecido os originais. Você o conhece como \"Vilcor\". Mas eu o conhecia como Petros Vorten. Orgulhoso inventor da Frota Necramech.",shape=box,color=blue];
		496 -> 504;
	495 [label="Hm? Ah. Eu o conhecia como Petros Vorten. Orgulhoso inventor da Frota Necramech. Mas o Necraloid me informou que eles esqueceram seus nomes. Você talvez ainda o conheça apenas como \"Pai\".",shape=box,color=blue];
		495 -> 503;
	500 [label="Não, nunca ouvi isso antes. Pode continuar, por favor",shape=box,color=red];
		500 -> 508;
	501 [label="Eu tô falando com você, Roathe… porque quero falar com você",shape=box,color=red];
		501 -> 509;
	502 [label="Já ouvi isso antes. Mas pode repetir, por favor",shape=box,color=red];
		502 -> 510;
	506 [label="Update boolean RoatheKnowsReset",color=orange];
		506 -> 500;
		506 -> 501;
		506 -> 502;
	505 [label="Update boolean RoatheKnowsReset",color=orange];
		505 -> 500;
		505 -> 501;
		505 -> 502;
	507 [label="Update boolean RoatheKnowsReset",color=orange];
		507 -> 515;
	504 [label="Evaluate expressions",color=orange];
		504 -> 514 [label="RoatheDeal",color=purple];
		504 -> 513 [label="RoatheNoDeal",color=purple];
		504 -> 513 [label="false",color=purple];
	503 [label="Evaluate expressions",color=orange];
		503 -> 512 [label="RoatheDeal",color=purple];
		503 -> 511 [label="RoatheNoDeal",color=purple];
		503 -> 511 [label="false",color=purple];
	508 [label="+5 Chemistry",color=orange];
		508 -> 516;
	509 [label="Check boolean DrifterRoathe",color=orange];
		509 -> 517 [label=true,color=green];
		509 -> 518 [label=false,color=brown];
	510 [label="Então você admite que está me fazendo perder tempo. Que maravilha! Eu não sou nenhum velho gagá recontando uma única saga de guerra porque não consegue se lembrar de nenhuma outra.",shape=box,color=blue];
		510 -> 519;
	515 [label="Aqui estou eu, pronto para divagar sobre a sociedade Orokin, pensando que talvez seja algo vagamente interessante para você. E então me lembro: é bem provável que você já tenha ouvido tudo isso antes, não é?",shape=box,color=blue];
		515 -> 500;
		515 -> 501;
		515 -> 502;
	514 [label="O que é bom, pois não teríamos avançado muito se você ou a criança não tivessem dado esse primeiro passo. Caso contrário, receio que o mordomo teria virado picadinho no momento em que o mandássemos subir aquelas escadas.",shape=box,color=blue];
		514 -> 522;
	513 [label="A propósito, você reconsiderou minha proposta? Que eu fique aqui em silêncio, em troca de ajudá-lo a reconciliar o mordomo e os Orokin abandonados e assombrados lá em cima?",shape=box,color=blue];
		513 -> 520;
		513 -> 521;
	512 [label="Talvez seja prudente resolver esse problema antes de tentarmos mandar o mordomo para o andar de cima. Para que ele não vire picadinho no processo.",shape=box,color=blue];
		512 -> 522;
	511 [label="A propósito, você reconsiderou minha proposta? Que eu fique aqui em silêncio, em troca de ajudá-lo a reconciliar o mordomo e os Orokin abandonados e assombrados lá em cima? Reconciliar a família seria o primeiro passo, mas…",shape=box,color=blue];
		511 -> 520;
		511 -> 521;
	516 [label="Você pediu a um Orokin para falar. Você não sabe o que fez. Vai ficar aqui por uma hora se não tomar cuidado.",shape=box,color=blue];
		516 -> 523;
	517 [label="+5 Chemistry",color=orange];
		517 -> 524;
	518 [label="Ah, é? E, por favor, diga-me por quê?",shape=box,color=blue];
		518 -> 528;
		518 -> 527;
		518 -> 525;
		518 -> 526;
	519 [label="O motivo de eu não me lembrar dessa conversa está refletido no seu maldito espelho!",shape=box,color=blue];
		519 -> 529;
	522 [label="Uma coisa que você precisa entender é que o mordomo e a família Entrati, por mais distantes que sejam, ainda são Orokin. Eles nasceram e foram criados por aquela sociedade, com todas as suas… falhas.",shape=box,color=blue];
		522 -> 532;
	520 [label="Não, não vou mudar de ideia, Roathe. Isso não é tão importante assim",shape=box,color=red];
		520 -> 530;
	521 [label="Aham, eu… concordo",shape=box,color=red];
		521 -> 531;
	523 [label="Embora eu imagine que você não tenha tido muitas oportunidades de interagir com os Orokin, não é, Peregrino? A criança viveu uma vida muito diferente.",shape=box,color=blue];
		523 -> 533;
	524 [label="Hmm. É verdade. E nós dois sabemos o motivo, não é? Mas você terá que ter paciência.",shape=box,color=blue];
		524 -> 534;
	528 [label="[Confessar Sentimentos] Acho que você sabe…",shape=box,color=red];
		528 -> 538;
	527 [label="Te acho muito interessante",shape=box,color=red];
		527 -> 537;
	525 [label="Nunca tive muitas oportunidades de interagir com um Orokin fora de combate. Você é fascinante",shape=box,color=red];
		525 -> 535;
	526 [label="Deixa quieto [Encerrar Conversa]",shape=box,color=red];
		526 -> 536;
	529 [label="Chat ends.",color=orange];
	532 [label="E, apesar de todos os seus graves pecados, a hierarquia e a ordem jamais foram questionadas. Nem entre os militares, nem na estrutura social. Os Arquimedianos obedeciam aos Orokin. Os Orokin obedeciam aos Executores. Os Executores obedeciam aos Imperadores… bem, pelo menos em teoria.",shape=box,color=blue];
		532 -> 541;
	530 [label="Como preferir, mas a porta não ficará aberta por muito tempo.",shape=box,color=blue];
		530 -> 539;
	531 [label="Update boolean RoatheNoDeal",color=orange];
		531 -> 540;
	533 [label="Pelo que ouvi dizer, você desviou de rumo na época da tragédia da Zariman 10-0.",shape=box,color=blue];
		533 -> 542;
		533 -> 543;
		533 -> 544;
	534 [label="Enquanto isso, se você desejar \"ouvir\", terei prazer em atendê-lo. Saiba apenas o seguinte: você pediu a um Orokin para falar.",shape=box,color=blue];
		534 -> 545;
	538 [label="+5 Chemistry",color=orange];
		538 -> 549;
	537 [label="+5 Chemistry",color=orange];
		537 -> 548;
	535 [label="É isso mesmo, conhecer o inimigo? Ou talvez apenas curiosidade de sentar-se à mesa, como diz o ditado, diante de uma impossibilidade? ",shape=box,color=blue];
		535 -> 546;
	536 [label="Pode se debater o quanto quiser, peixinho. Você nadou direto até mim.",shape=box,color=blue];
		536 -> 547;
	541 [label="E mesmo que você duvide que, depois de todo esse tempo, a tradição ainda possa persuadir o Loid a me ouvir, considere que eu posso ser… profundamente convincente. Afinal, eu era o braço direito do pior dos Executores.",shape=box,color=blue];
		541 -> 551;
		541 -> 552;
		541 -> 553;
	539 [label="Chat ends.",color=orange];
	540 [label="Update boolean RoatheDeal",color=orange];
		540 -> 550;
	542 [label="Não. Nunca interagi muito com os Orokin antes da Zariman - e depois, bom… você já deve ter ouvido a treta com certeza.",shape=box,color=red];
		542 -> 554;
	543 [label="Já tive experiências suficientes com os Orokin pra saber que não posso confiar neles nem um pouco",shape=box,color=red];
		543 -> 555;
	544 [label="Não tenho mais apreço por gente como vocês do que a criança tem, sinto te informar",shape=box,color=red];
		544 -> 555;
	545 [label="Você não sabe o que fez. Vai ficar aqui por uma hora se não tomar cuidado.",shape=box,color=blue];
		545 -> 523;
	549 [label="Hmm. De fato. Pensava que você me faria a gentileza de me deixar ver isso por escrito. Ah, bem…",shape=box,color=blue];
		549 -> 557;
	548 [label="Acha? Hm. Vamos ver por quanto tempo consigo manter este peixe no arpão, então.",shape=box,color=blue];
		548 -> 534;
	546 [label="+5 Chemistry",color=orange];
		546 -> 556;
	547 [label="Chat ends.",color=orange];
	551 [label="O pior dos Executores era o Ballas",shape=box,color=red];
		551 -> 559;
	552 [label="Qual você serviu?",shape=box,color=red];
		552 -> 560;
	553 [label="How so?",shape=box,color=red];
		553 -> 561;
	550 [label="+5 Chemistry",color=orange];
		550 -> 558;
	554 [label="Sim, ouvi. Ah, Ballas. Talvez você se surpreenda ao saber que ele não era o pior deles.",shape=box,color=blue];
		554 -> 562;
		554 -> 563;
	555 [label="Nem acho que te culpo. Pensei que poderíamos salvá-los. Derretê-los, por assim dizer, reformá-los, como ouro.",shape=box,color=blue];
		555 -> 564;
	557 [label="Em outra ocasião, talvez. Pois você, Usurpador, deve aprender a apreciar esses momentos.",shape=box,color=blue];
		557 -> 566;
	556 [label="Respeitável. Sábio, até. Se eu tivesse tido a oportunidade de entrevistar e, talvez até mesmo fazer amizade com um Sentient, eu teria feito o mesmo. ",shape=box,color=blue];
		556 -> 565;
	559 [label="Respeito sua opinião e não o julgo por isso. Ballas era um cretino e um campeão entre os depravados, não vou discutir isso com você.",shape=box,color=blue];
		559 -> 567;
	560 [label="Evaluate expressions on HellStory",color=orange];
		560 -> 569 [label="x >= 1",color=purple];
		560 -> 568 [label="x <= 1",color=purple];
		560 -> 568 [label="false",color=purple];
	561 [label="Entendo que você teve uma experiência pessoal com o Ballas e não o culpo por provavelmente acreditar que ele era o pior que os Sete Lordes Áureos tinham a oferecer. Ballas era um cretino e um campeão entre os depravados, não vou discutir isso com você.",shape=box,color=blue];
		561 -> 570;
	558 [label="Ótimo! Fico muito feliz que você finalmente tenha entendido. Agora podemos avançar.",shape=box,color=blue];
		558 -> 522;
	562 [label="Sério?",shape=box,color=red];
		562 -> 571;
	563 [label="Vai ser difícil me convencer disso aí",shape=box,color=red];
		563 -> 571;
	564 [label="Bem, exceto pelos Executores. Eles eram um caso perdido. Talvez você se surpreenda ao saber que Ballas não era o pior deles.",shape=box,color=blue];
		564 -> 563;
		564 -> 562;
	566 [label="Update boolean DrifterRoathe",color=orange];
		566 -> 534;
	565 [label="Isso proporciona uma vantagem psicológica caso você encontre um deles – ou mesmo um antigo aliado – no campo de batalha.",shape=box,color=blue];
		565 -> 572;
	567 [label="E, na realidade, eu não testemunhei o horror desse caso \"Narmer\" que ouvi do mordomo e que pude deduzir das gravações dessa máquina POM-2 aqui.",shape=box,color=blue];
		567 -> 573;
	569 [label="Você já me ouviu falar dela antes. E, mais importante, teve um vislumbre do que estávamos planejando. Mas essa é uma história para outro dia. Executora Nitokh. Grande Regente Executora Nitokh, para ser mais preciso. Comandante de todas as nossas forças militares e a mais cruel e mortal dos Sete Lordes Áureos.",shape=box,color=blue];
		569 -> 574;
	568 [label="Executora Nitokh. Temível Regente Executora Nitokh, para ser mais preciso. A comandante de todas as forças militares do Império Orokin. E a mais cruel e mortal dos Sete Lordes Áureos.",shape=box,color=blue];
		568 -> 574;
	570 [label="É até bem possível que ele tenha superado os Executores de outrora durante esse… caso \"Narmer\" que ouvi falar pelo mordomo e li nesta máquina POM-2 aqui.",shape=box,color=blue];
		570 -> 573;
	571 [label="Não estou dizendo que ele era um santo. Estou dizendo que o pior dos demônios era ligeiramente inferior aos seus pares. É uma distinção mínima, Usurpador.",shape=box,color=blue];
		571 -> 575;
	572 [label="Bem, se você desejar \"ouvir\", terei prazer em atendê-lo. Saiba apenas o seguinte: você pediu a um Orokin para falar.",shape=box,color=blue];
		572 -> 545;
	573 [label="No entanto, eu também sugeriria que essa impressão se deve à sua proximidade muito pessoal com Ballas e às suas interações muito limitadas com os outros seis Lordes Áureos.",shape=box,color=blue];
		573 -> 574;
	574 [label="Os Sete Áureos. Bah. Sabe qual é a melhor coisa sobre o ouro, Peregrino? Ele pode ser derretido infinitamente e transformado em algo melhor.",shape=box,color=blue];
		574 -> 576;
	575 [label="Mas será que Ballas foi o pior? Aos seus olhos, talvez. E talvez os crimes que ele cometeu nesta era tenham superado até mesmo os dos Executores do passado.",shape=box,color=blue];
		575 -> 577;
	576 [label="Eu acreditava — e, de certa forma, ainda acredito — que era possível salvar os Orokin. Que poderíamos ter revertido a situação do Império. Mas os Executores? Não. Eles precisavam ser detidos. Eles representavam o pior que a humanidade tinha a oferecer, em vários graus.",shape=box,color=blue];
		576 -> 578;
	577 [label="Mas se você tivesse contemplado os lagos vermelhos e os campos de cadáveres retorcidos e desmembrados, como tantos brinquedos abandonados –",shape=box,color=blue];
		577 -> 579;
	578 [label="E isso está vindo de mim, Usurpador. Então confie quando o próprio Diabo de Tau lhe assegura, com o conhecimento que possui, que Ballas não era o pior entre eles.",shape=box,color=blue];
		578 -> 580;
	579 [label="Se você tivesse visto a completa devastação que Nitokh era capaz de causar com um piscar de olhos… ",shape=box,color=blue];
		579 -> 581;
	580 [label="Check boolean RoatheUsurper",color=orange];
		580 -> 583 [label=true,color=green];
		580 -> 584 [label=true,color=green];
		580 -> 582 [label=false,color=brown];
		580 -> 583 [label=false,color=brown];
		580 -> 584 [label=false,color=brown];
	581 [label="Mas tais horrores são difíceis de compreender a menos que sejam presenciados. Uma tragédia como essa não se resume apenas a números. Eu poderia me estender sobre o que vi, mas para você, serão apenas isso: histórias.",shape=box,color=blue];
		581 -> 585;
	583 [label="Vai ser difícil me convencer disso aí",shape=box,color=red];
		583 -> 587;
	584 [label="Sério?",shape=box,color=red];
		584 -> 587;
	582 [label="Por que você vive me chamando de \"Usurpador\"?",shape=box,color=red];
		582 -> 586;
	585 [label="Para você, Ballas sempre será o vilão mais presente e aterrorizante. E isso já era de se esperar.",shape=box,color=blue];
		585 -> 588;
	587 [label="Se você tivesse contemplado os lagos vermelhos e os campos de cadáveres retorcidos e desmembrados, como tantos brinquedos abandonados –",shape=box,color=blue];
		587 -> 579;
	586 [label="Ah! É o que você é, não é? Os Tennos usurparam o Sistema de Origem dos Orokin. E você, como um pequeno impostor no ninho, invadiu este mundo vindo do seu próprio.",shape=box,color=blue];
		586 -> 589;
	588 [label="Mas há muito sobre ele que você não sabe. Muito já foi falado sobre aquele cretino, mas temo que ainda haja muito a ser dito.",shape=box,color=blue];
		588 -> 590;
		588 -> 591;
	589 [label="E isso faz de você, na minha visão, um usurpador por pelo menos dois motivos. (E talvez por um terceiro, se incluirmos o que o mordomo me contou sobre Duviri, mas isso é assunto para outra hora.)",shape=box,color=blue];
		589 -> 592;
	590 [label="Tipo?",shape=box,color=red];
		590 -> 593;
	591 [label="Não tenho interesse em ouvir nada sobre a vida do Ballas",shape=box,color=red];
		591 -> 594;
	592 [label="Não me distraia, Usurpador. Entendo que talvez seja difícil acreditar em mim, mas se tivesse contemplado os lagos vermelhos e os campos de cadáveres retorcidos e desmembrados, como tantos brinquedos abandonados –",shape=box,color=blue];
		592 -> 595;
	593 [label="Update boolean RoatheBallas1",color=orange];
		593 -> 596;
	594 [label="Hmm, entendi. Bem, acho que você terá que aturar as histórias da minha vida, então. Que divertido.",shape=box,color=blue];
		594 -> 597;
	595 [label="Update boolean RoatheUsurper",color=orange];
		595 -> 579;
	596 [label="É uma… longa história. Uma história que não tenho tempo para contar agora. O mordomo está à espreita. E eu detesto ser vigiado assim.",shape=box,color=blue];
		596 -> 598;
	597 [label="+5 Chemistry",color=orange];
		597 -> 599;
	598 [label="Extremamente inapropriado.",shape=box,color=blue];
		598 -> 600;
	599 [label="Falaremos novamente em breve.",shape=box,color=blue];
		599 -> 601;
	600 [label="+15 Chemistry",color=orange];
		600 -> 602;
	601 [label="Chat ends.",color=orange];
	602 [label="Falaremos novamente em breve.",shape=box,color=blue];
		602 -> 603;
	603 [label="Chat ends.",color=orange];
}