		j1639749749 -> j120557335;
	j152941943 [label="+5 Chemistry",color=orange];
		j152941943 -> j2195323092;
	j2705870519 [label="Isso não é totalmente preciso. Eu não a amo mais. Não me importo mais se ela sofrer uma morte brutal pelas minhas mãos. Mas me vejo extremamente curioso para saber como a história dela terminou.",shape=box,color=blue];
		j2705870519 -> j3770926204;
	j2396063987 [label="É difícil imaginar que alguém com tamanha sede de sangue e morte tenha permanecido tão quieta durante todos esses séculos.",shape=box,color=blue];
		j2396063987 -> j1681884815;
	"Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
	"Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j952978984 [label="É por causa do passado que me sinto curioso para saber o que aconteceu com ela. Simplesmente porque quero saber como sua história terminou. Se é que terminou.",shape=box,color=blue];
		j952978984 -> j3770926204;
	j120557335 [label="Me perdoe, já que foi você quem a mencionou. Você é realmente muito enigmático, querido Peregrino.",shape=box,color=blue];
		j120557335 -> "Chat ends.";
	j2195323092 [label="Então você pode entender por que estou curioso para saber o que aconteceu com ela. Simplesmente porque quero saber como a história dela terminou. Se é que terminou.",shape=box,color=blue];
		j2195323092 -> j3770926204;
	j3770926204 [label="É difícil se livrar daqueles que desempenharam um papel tão importante em sua própria história. Não importa o quão venenosos eles sejam.",shape=box,color=blue];
		j3770926204 -> j2396063987;
	j1681884815 [label="Se ela ainda está viva, não está à espreita por vontade própria.",shape=box,color=blue];
