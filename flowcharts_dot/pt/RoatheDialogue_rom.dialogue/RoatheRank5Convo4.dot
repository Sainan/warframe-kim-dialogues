	j1898694507 [label="Não tem problema deixar as coisas como estão, não preciso da sua ajuda",shape=box,color=red];
		j1898694507 -> j1850595327;
	j2665009080 [label="Mas agora que recuperei totalmente minhas memórias, me pego pensando nela com mais frequência.",shape=box,color=blue];
		j2665009080 -> j3768955238;
	j1751316032 [label="O que, exatamente? Você nunca disse o que queria com isso",shape=box,color=red];
		j1751316032 -> j1709004077;
	j2103846434 [label="Acho que você tá blefando. Nem sequer acho que você tenha um plano pro que quer",shape=box,color=red];
