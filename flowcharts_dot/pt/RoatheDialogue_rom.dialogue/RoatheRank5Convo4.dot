	j3031001415 [label="Boolean RoatheLyonConfessionDeal is now false.",color=orange];
		j3031001415 -> j1670880015;
	j1797582863 [label="Espero que isso não desperte sentimentos de ciúme em você. Essa não é minha intenção. Estou simplesmente tentando explicar o quanto ela me prejudicou.",shape=box,color=blue];
		j1797582863 -> j502778719;
	j1739516831 [label="Sem ela, eu não seria quem sou. Aprendi tudo o que sei com ela. Ela pegava argila bruta e a moldava.",shape=box,color=blue];
		j1739516831 -> j2642667758;
