		j1850595327 -> j2498687218;
		j1850595327 -> j1859882875;
	j3768955238 [label="Você precisa entender o quão profundamente complexo e… prejudicial era o meu relacionamento com aquela mulher. É difícil descrever com precisão o quanto eu a adorava. E o quanto eu a detestava. ",shape=box,color=blue];
