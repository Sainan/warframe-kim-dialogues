	j3533186760 [label="Que pergunta surpreendente. Eu mesmo já me fiz essa pergunta muitas vezes desde que me transformei nessa amálgama infestada.",shape=box,color=blue];
		j3533186760 -> j2665009080;
	j1167270940 [label="Vou cobrar o que me é devido, independentemente de você ter cumprido ou não a sua parte do contrato.",shape=box,color=blue];
