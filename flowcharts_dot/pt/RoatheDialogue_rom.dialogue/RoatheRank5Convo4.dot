		j1739516831 -> j1601393343;
	j2578585265 [label="+5 Chemistry",color=orange];
		j2578585265 -> j2105288284;
	j1670880015 [label="+5 Chemistry",color=orange];
		j1670880015 -> j1965905686;
	j502778719 [label="E, ao mesmo tempo, quanta coisa eu lhe devo. Sem ela, eu não seria quem sou. Aprendi tudo o que sei com ela. Ela pegava argila bruta e a moldava.",shape=box,color=blue];
		j502778719 -> j2642667758;
