		1013 -> 1015;
	1014 [label="Por causa dos Tennos? Ou pelo que eles fizeram com ela?",shape=box,color=red];
		1014 -> 1016;
	1015 [label="Não estou pedindo nada disso! Ballas merece apenas uma coisa: sua urina no local onde foi enterrado – se é que ele tem um túmulo.",shape=box,color=blue];
		1015 -> 1017;
	1016 [label="De certa forma, as duas coisas. E de certa forma, nem uma nem outra. Ele foi levado à loucura naquele dia, quando ordenou a execução dela. Aliás, não me surpreenderia se uma parte dele não se lembrasse completamente de ter cometido o ato.",shape=box,color=blue];
		1016 -> 1018;
	1017 [label="Estou apenas dizendo que, no dia em que ordenou a execução dela, ele estava fora de si. Não ficaria surpreso se, depois do ocorrido, alguma parte dele não se lembrasse completamente do ato.",shape=box,color=blue];
		1017 -> 1018;
	1018 [label="Ballas amava Margulis. Com todo o seu ser, ele era completamente devoto a ela. Ele teria sacrificado tudo por ela. Sua alma, seu corpo, o Império Orokin. Tudo o que se possa imaginar.",shape=box,color=blue];
		1018 -> 1019;
	1019 [label="Nenhum preço era alto demais. Nenhum princípio moral valia a pena ser preservado. Se você lhe entregasse um recém-nascido e lhe dissesse que Margulis desejava que seu cérebro fosse esmagado contra as rochas, ele morreria antes mesmo de você terminar a frase.",shape=box,color=blue];
		1019 -> 1020;
	1020 [label="Ele teria reduzido o Sistema de Origem a cinzas e o reconstruído à sua imagem, Usurpador… mas é aí que mora a tragédia.",shape=box,color=blue];
		1020 -> 1021;
	1021 [label="Margulis? Ah, Margulis. A adorável, doce, querida Margulis… ela ainda tinha uma consciência.",shape=box,color=blue];
		1021 -> 1022;
	1022 [label="E quando ela viu os pobres Tennos, as pobres crianças dilaceradas pelo Void… ",shape=box,color=blue];
		1022 -> 1023;
	1023 [label="Havia algo na vida dela que importava mais do que Ballas. Havia algo na vida dela pelo qual ela estava disposta a sacrificar tudo… e não era ele.",shape=box,color=blue];
		1023 -> 1024;
	1024 [label="Não era amor dela por ele.",shape=box,color=blue];
		1024 -> 1025;
	1025 [label="E ele sabia disso, meu querido Peregrino. Ele soube desde o momento em que ela os viu. E isso se confirmou quando suas \"feras enlouquecidas\" garantiram que eles fossem a última coisa que ela visse. Pelo menos, era o que corriam os rumores entre nós, Orokin.",shape=box,color=blue];
		1025 -> 1026;
	1026 [label="Consegue imaginar a alegria dos Orokin? Vendo a preciosa Arquimediana de Ballas despedaçada pelo Void, por aqueles pirralhos enfurecidos que lhe queimaram os olhos?",shape=box,color=blue];
		1026 -> 1027;
	1027 [label="Mas acredito que foi antes disso, no exato momento em que Margulis lutou para salvar os Tennos, que o coração de Ballas se despedaçou em mil pedaços e nunca se recuperou.",shape=box,color=blue];
		1027 -> 1028;
	1028 [label="Pois ele sabia que havia perdido o lugar no coração dela.",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="Talvez por isso eu tenha sentido pena dele. Mas o resto do que aconteceu depois? Uma história de amor para todas as épocas… que terminou em uma tragédia tão devastadora.",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="Eu gostaria que você tivesse visto como eles sorriam um para o outro…",shape=box,color=blue];
		1030 -> 1031;
		1030 -> 1032;
	1031 [label="Você pode romantizar a relação deles, mas isso não justifica quem ele era. Ballas não pode ser perdoado por tudo o que fez",shape=box,color=red];
		1031 -> 1033;
	1032 [label="Fico feliz que o amor deles era verdadeiro. Que ele era.. complicado naquela época. E que Margulis não tava só sendo usada o tempo todo",shape=box,color=red];
		1032 -> 1034;
	1033 [label="Add 1 to Thermostat",color=orange];
		1033 -> 1035;
	1034 [label="Add -1 to Thermostat",color=orange];
		1034 -> 1036;
	1035 [label="+10 Chemistry",color=orange];
		1035 -> 1037;
	1036 [label="+10 Chemistry",color=orange];
		1036 -> 1038;
	1037 [label="Nem estava tentando equiparar as duas coisas, Usurpador. Eu simplesmente disse que um homem pode ser amado, mas também é capaz de atos terríveis. Bem… não há mais esperança para nós, tolos corruptos…",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="De fato. Às vezes me conforta pensar que, se até mesmo esse senhor da depravação pode encontrar um amor, há esperança para o resto de nós, não é? Ha!",shape=box,color=blue];
		1038 -> 1039;
	1039 [label="Update boolean RoatheMargulis1",color=orange];
		1039 -> 1040;
	1040 [label="Mas já tomei seu tempo demais por hoje. Pode ir agora. ",shape=box,color=blue];
		1040 -> 1041;
	1041 [label="Chat ends.",color=orange];
}