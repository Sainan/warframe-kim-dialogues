	2134 [label="Chat ends.",color=orange];
	2132 [label="Sua loucura era sedutora porque era óbvia.",shape=box,color=blue];
		2132 -> 5636;
	5636 [label="Sempre se sabia onde se estava com ela: à beira do grande abismo.",shape=box,color=blue];
		5636 -> 5635;
	5635 [label="\"Salte\", diziam seus olhos, brilhando com a alegria de alguma piada cósmica colossal.",shape=box,color=blue];
		5635 -> 5637;
	5637 [label="Através de suas visões dementes, eu podia escapar da longa e sombria estagnação da existência Orokin.",shape=box,color=blue];
		5637 -> 2136;
	2136 [label="Todos os nossos sentidos haviam sido saciados até a insensibilidade séculos atrás. Mesmo assim, ela ainda era, à sua maneira, vibrante.",shape=box,color=blue];
		2136 -> 5638;
	5638 [label="Eterna. Insaciável em sua fome. Certa noite, ela me chamou enquanto se banhava. Atravessei as poças de água perfumada e sangue e fiquei obedientemente em posição de sentido.",shape=box,color=blue];
		5638 -> 5639;
	5639 [label="\"Estou entediada, Roathe. Vamos matar todos os outros Orokin e tomar o poder.\"",shape=box,color=blue];
