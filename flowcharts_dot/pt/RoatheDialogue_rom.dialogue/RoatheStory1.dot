	"Chat ends." [color=orange];
	j3253307759 [label="ÁUDIO: NITOKH",shape=box,color=blue];
		j3253307759 -> j3174011518;
	j3174011518 [label="Sua loucura era sedutora porque era óbvia.",shape=box,color=blue];
		j3174011518 -> j1380499936;
	j1380499936 [label="Sempre se sabia onde se estava com ela: à beira do grande abismo.",shape=box,color=blue];
		j1380499936 -> j117342343;
	j117342343 [label="\"Salte\", diziam seus olhos, brilhando com a alegria de alguma piada cósmica colossal.",shape=box,color=blue];
		j117342343 -> j190538477;
	j190538477 [label="Através de suas visões dementes, eu podia escapar da longa e sombria estagnação da existência Orokin.",shape=box,color=blue];
		j190538477 -> j3645003929;
	j3645003929 [label="Todos os nossos sentidos haviam sido saciados até a insensibilidade séculos atrás. Mesmo assim, ela ainda era, à sua maneira, vibrante.",shape=box,color=blue];
		j3645003929 -> j1117744293;
	j1117744293 [label="Eterna. Insaciável em sua fome. Certa noite, ela me chamou enquanto se banhava. Atravessei as poças de água perfumada e sangue e fiquei obedientemente em posição de sentido.",shape=box,color=blue];
		j1117744293 -> j159705117;
	j159705117 [label="\"Estou entediada, Roathe. Vamos matar todos os outros Orokin e tomar o poder.\"",shape=box,color=blue];
		j159705117 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}