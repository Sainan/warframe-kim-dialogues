		j3589465595 -> j3990094727;
		j3589465595 -> j877088177;
	j3990094727 [label="Resumo da ópera: o Albrecht entrou no Void, ficou em pânico e acabou roubando alguns dedos da Indiferença.",shape=box,color=red];
		j3990094727 -> j804872270;
	j877088177 [label="Tá. Então. O Albrecht foi a primeira pessoa a \"descobrir\" como entrar no Void…",shape=box,color=red];
		j877088177 -> j893228145;
	j804872270 [label="primeiro… como assim ópera?",shape=box,color=blue];
		j804872270 -> j2070659931;
	j893228145 [label="Era uma espécie de sino de mergulho. Feito de algo chamado Vitral Serigrafado. Ele rasgou a membrana entre os mundos.",shape=box,color=red];
		j893228145 -> j1184186672;
	j2070659931 [label="Ah, esquece. É difícil até de explicar. Tô andando muito com o Quincy",shape=box,color=red];
		j2070659931 -> j1568794063;
	j1184186672 [label="As coisas deram errado, pra dizer o mínimo… Ele entrou em pânico, tropeçou, a coisa caiu e bateu na borda afiada da membrana.",shape=box,color=red];
		j1184186672 -> j3460260356;
	j1568794063 [label="hããh…",shape=box,color=blue];
		j1568794063 -> j1757956711;
	j3460260356 [label="O sino de Vitral Serigrafado se despedaçou e ele caiu dentro do Void.",shape=box,color=red];
		j3460260356 -> j384402472;
	j1757956711 [label="e segundo…",shape=box,color=blue];
		j1757956711 -> j2679311682;
	j384402472 [label="E quando ele se recuperou, estava de volta ao seu laboratório, só que aquele não era mais o seu laboratório. E ele olhou pra si mesmo. Só que não era mais ele. E \"ele\" se chamou por um nome que só a sua mãe conhecia.",shape=box,color=red];
		j384402472 -> j1179203757;
	j2679311682 [label="****VC TEM OS DEDOS DELE?!?!?!****",shape=box,color=blue];
		j2679311682 -> j2408789947;
	j1179203757 [label="E aí, o Albrecht correu pra se salvar. Se cortou com o Vitral Serigrafado quebrado e escreveu uma mensagem com o próprio sangue, que era pra sua filha fechar a membrana.",shape=box,color=red];
		j1179203757 -> j3393393570;
	j2408789947 [label="E É ISSO QUE VC USA PRA ENERGIZAR A SUA RAILJACK?!?!",shape=box,color=blue];
