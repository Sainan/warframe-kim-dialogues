		3938 -> 3940;
	3939 [label="e segundo…",shape=box,color=blue];
		3939 -> 3941;
	3940 [label="E quando ele se recuperou, estava de volta ao seu laboratório, só que aquele não era mais o seu laboratório. E ele olhou pra si mesmo. Só que não era mais ele. E \"ele\" se chamou por um nome que só a sua mãe conhecia.",shape=box,color=red];
