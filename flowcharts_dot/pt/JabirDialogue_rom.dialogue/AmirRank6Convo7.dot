		4278 -> 4279;
	4279 [label="\"Você caminha pelo corredor seguindo a fonte dos gritos agonizantes, entra em uma grande sala de máquinas e lá vê um homem. Um homem nada feio, amarrado a uma máquina. Raios elétricos saem dançando de seus dedos, alimentando uma turbina gigante.\"",shape=box,color=blue];
