		j1180378733 -> j3314558831;
	j2404847676 [label="\"Você sobe de elevador. Através das grades, você vê as paredes de pedra da masmorra sendo substituídas por tecnologia cada vez mais avançada. Você se pergunta novamente: onde diabos eu estou?\"",shape=box,color=blue];
		j2404847676 -> j2832059248;
	j3314558831 [label="Kkkkkk certo, eu pego o elevador então",shape=box,color=red];
		j3314558831 -> j2404847676;
	j2832059248 [label="\"O elevador para em um corredor cheio de máquinas borbulhantes e tubos gigantes. Seria isso algum tipo de laboratório?\"",shape=box,color=blue];
		j2832059248 -> j3248751767;
	j3248751767 [label="\"De uma sala no final do corredor, você ouve um homem gritando de dor.\"",shape=box,color=blue];
