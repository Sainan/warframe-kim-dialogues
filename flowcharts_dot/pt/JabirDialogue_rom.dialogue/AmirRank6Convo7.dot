		j3248751767 -> j922535471;
	j2727417586 [label="Eu ignoro os gritos e procuro uma saída",shape=box,color=red];
		j2727417586 -> j2391939458;
	j922535471 [label="Eu vou até o homem gritando",shape=box,color=red];
		j922535471 -> j1801577619;
	j2391939458 [label="\"Você procura pelo salão por algo de valor, mas os gritos se tornam impossíveis de ignorar. Você sente que precisa ajudar este homem.\"",shape=box,color=blue];
		j2391939458 -> j1801577619;
	j1801577619 [label="\"Você caminha pelo corredor seguindo a fonte dos gritos agonizantes, entra em uma grande sala de máquinas e lá vê um homem. Um homem nada feio, amarrado a uma máquina. Raios elétricos saem dançando de seus dedos, alimentando uma turbina gigante.\"",shape=box,color=blue];
		j1801577619 -> j1290536313;
