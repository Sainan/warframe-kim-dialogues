		4395 -> 4397;
	4396 [label="qqr semelhança com pessoas reais ou imaginárias é mera coincidência",shape=box,color=blue];
		4396 -> 4397;
	4397 [label="\"Com a ajuda de Zabir, você anda pelos corredores do asteroide. Ele desvia habilmente de guardas e câmeras de segurança.\"",shape=box,color=blue];
		4397 -> 4398;
	4398 [label="\"Eventualmente, vocês chegam em uma porta grande. Zabir faz sinal para se abaixar. Vocês dois se agacham e entram sorrateiramente no hangar da nave.\"",shape=box,color=blue];
		4398 -> 4399;
	4399 [label="\"Você se agacha na sombra de um pilar e consegue ouvir guardas Grineer nas proximidades.\"",shape=box,color=blue];
		4399 -> 4400;
