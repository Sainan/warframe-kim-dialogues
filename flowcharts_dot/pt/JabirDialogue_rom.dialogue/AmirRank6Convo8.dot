		4402 -> 4404;
	4403 [label="\"Sem um pingo de noção ou inteligência, você corre ao campo aberto. Um grupo de guardas do outro lado começa a atirar. Você avança de cabeça em direção a uma saraivada de balas, que te matam instantaneamente. Zabir balança a cabeça diante do seu ato insensato de bravura imbecil.\"",shape=box,color=blue];
		4403 -> 4405;
