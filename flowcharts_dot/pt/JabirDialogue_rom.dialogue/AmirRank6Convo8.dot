		4405 -> 4407;
		4405 -> 4408;
	4406 [label="\"Uma Railjack está estacionada no centro do hangar. A rampa de acesso está bloqueada por um guarda. De um lado do hangar, uma dúzia de Grineer está ocupada jogando uma partida de dados barulhenta. A poucos metros à sua frente, há uma mesa com um painel de controle.\"",shape=box,color=blue];
