	4387 [label="Pra onde o Zabir tá me levando?",shape=box,color=red];
		4387 -> 4390;
	4388 [label="\"Zabir fica chocado e diz: os ratos te acharam? Incrível, funcionou, olha isso aqui. Então, Zabir ergue um apito dourado, com relevo intrincado: a Rata Rainha me deu, precisamos encontrá-la.\"",shape=box,color=blue];
		4388 -> 4391;
	4389 [label="\"Você pergunta ao Zabir como ele chegou aqui. Ele diz: não temos tempo pra isso, precisamos nos concentrar em sair daqui.\"",shape=box,color=blue];
		4389 -> 4385;
		4389 -> 4387;
	4390 [label="\"Zabir olha para trás: vou te levar ao hangar. Vamos roubar uma nave e fugir pro mais longe possível daqui. Vamos encontrar a Rata Rainha.'\"",shape=box,color=blue];
		4390 -> 4391;
	4391 [label="RATA RAINHA?!",shape=box,color=red];
		4391 -> 4392;
	4392 [label="\"Ela me deu este apito, os ratos escutam ele. Ela é minha amiga. Nem sempre é simpática, mas se importa.\"",shape=box,color=blue];
		4392 -> 4393;
		4392 -> 4394;
