	46 [label="Mas é isso, raça artificial. Eles foram enviados para terraformar Tau para os Orokin. Só que eles pensaram que os Orokin devastariam Tau assim como fizeram com o Sistema de Origem, então declararam guerra contra eles",shape=box,color=red];
		46 -> 50;
	47 [label="Um cara chamado Ballas, responsável e criador da maioria dos Warframes, junto com os Entrati, que também eram Orokin. Além disso, o Ballas e a Margulis eram um casal.",shape=box,color=red];
		47 -> 51;
