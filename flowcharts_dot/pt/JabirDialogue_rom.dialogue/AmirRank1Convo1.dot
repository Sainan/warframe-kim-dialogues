		40 -> 44;
	41 [label="Os Sentients são esses… bem… uma raça sintética maligna, com exceção da Lótus, que é do bem. Mas a aparência e parte da personalidade dela são da Margulis, que era uma Arquimediana",shape=box,color=red];
