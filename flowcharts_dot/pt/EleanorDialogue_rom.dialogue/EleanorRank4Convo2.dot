		1536 -> 1537;
	1537 [label="Como funcionam os relacionamentos no seu tempo? Quero dizer, é tudo o padrão de \"dois ou mais adultos se juntam com vários graus de solenização\"? Ou tem regras sobre quem pode ficar com quem?",shape=box,color=blue];
