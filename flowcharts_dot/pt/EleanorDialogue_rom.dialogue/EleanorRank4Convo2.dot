		1548 -> 1550;
	1544 [label="Aqueles dois em Deimos, o Pai e a Mãe. Eles são um casal. Eles podem ser gigantescos ex-Orokin infestados, mas são claramente e dolorosamente CASADOS, exatamente da mesma forma que minha mãe e meu pai são ",shape=box,color=blue];
