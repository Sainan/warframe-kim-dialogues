	2500 [label="Não é assim que os Warframes funcionam. A infestação neles é domada, é dormente. Exceto pelo Nidus, eu acho, mas ele é um caso a parte ",shape=box,color=red];
		2500 -> 2502;
	2501 [label="Então… o Tecnovírus acha que eu roubei você dele e… agora quer você de volta?",shape=box,color=red];
		2501 -> 2505;
	2503 [label="Bem, talvez se eu fosse uma Warframe por completo, o Tecnovírus não me veria dessa forma. Do jeito que está, minhas células continuam efervescendo e ele me vê como se fosse dele ",shape=box,color=blue];
		2503 -> 2506;
	2504 [label="Não é bizarro? O ex largado!",shape=box,color=blue];
		2504 -> 2506;
	2502 [label="Bem, talvez se eu fosse uma Warframe por completo, o Tecnovírus não me veria dessa forma. Do jeito que está, minhas células continuam efervescendo e ele me vê como se fosse dele ",shape=box,color=blue];
		2502 -> 2507;
	2505 [label="Sim. Ele me quer de volta em seu bando ",shape=box,color=blue];
		2505 -> 2507;
	2506 [label="De onde eu venho, você teria que ir brigar com ele no estacionamento do supermercado local. Não tenho certeza de como isso funciona em sua época ",shape=box,color=blue];
		2506 -> 2508;
	2507 [label="Essa é sua VERDADEIRA família, ele sussurra. Se torne parte de nós novamente, irmã perdida. Seja aceita ",shape=box,color=blue];
		2507 -> 2508;
	2508 [label="Peraí, calma lá… como você sabe que é isso que o Tecnovírus tá sentindo?",shape=box,color=red];
		2508 -> 2509;
	2509 [label="Ah, Deuses… essa é a parte constrangedora ",shape=box,color=blue];
		2509 -> 2510;
	2510 [label="Os sonhos que mencionei antes? Tenho certeza de que o Tecnovírus está enviando eles ",shape=box,color=blue];
		2510 -> 2511;
	2511 [label="Seja lá o que for que essa coisa tenha como mente, ele sempre foi capaz de se conectar com a minha. Os pensamentos que ele envia são sempre tão crus e fracos que posso facilmente afastá-los ",shape=box,color=blue];
		2511 -> 2512;
	2512 [label="Na maioria das vezes, parece apenas um arranhar frenético na parte de trás do meu crânio, tipo quando você está no banheiro e tem um gato tentando abrir a porta ",shape=box,color=blue];
		2512 -> 2513;
		2512 -> 2514;
	2513 [label="Mas quando você tá dormindo… a história é diferente, né?",shape=box,color=red];
		2513 -> 2515;
	2514 [label="Acho que tô começando a entender…",shape=box,color=red];
		2514 -> 2515;
	2515 [label="Sim. Minhas defesas ficam baixas no sono, e ele pode me alcançar ",shape=box,color=blue];
		2515 -> 2516;
	2516 [label="Isso tem me atingido no nível mais primordial, se é que você me entende. Ele me quer de volta. Ele promete que pode me fazer sentir um prazer que nunca conheci ",shape=box,color=blue];
		2516 -> 2517;
	2517 [label="Ele vai semear minha carne com os cistos gotejantes de nova vida. Porque ele acha que é isso que eu quero",shape=box,color=blue];
		2517 -> 2518;
