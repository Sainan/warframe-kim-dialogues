		2469 -> 2471 [label=false,color=brown];
	2470 [label="Mas já que estamos namorando, outra coisa tem acontecido. É um pouco estranho, na verdade. Eu queria falar com você sobre isso, mas ainda não tinha achado um bom momento ",shape=box,color=blue];
		2470 -> 2472;
