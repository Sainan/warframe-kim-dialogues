digraph {
	2607 [label="EleanorRank5Convo7 begins.",color=orange];
		2607 -> 2608;
	2608 [label="A \"Indiferença\" é o que aquela coisa QUER, ou é o que ela É?",shape=box,color=blue];
		2608 -> 2609;
		2608 -> 2610;
		2608 -> 2611;
	2609 [label="Você e a Lê fazem isso, sabia? Esquecem de dizer \"oi\" ",shape=box,color=red];
		2609 -> 2613;
	2610 [label="A maioria das pessoas começaria com um \"oi\" ",shape=box,color=red];
		2610 -> 2614;
	2611 [label="[Ignorar]",shape=box,color=red];
		2611 -> 2612;
	2613 [label="Você encontrou a única coisa que compartilhamos, parabéns. E desculpa, mas isso é mais importante ",shape=box,color=blue];
		2613 -> 2615;
	2614 [label="Desculpa, mas isso é mais importante ",shape=box,color=blue];
		2614 -> 2615;
	2612 [label="Chat ends.",color=orange];
	2615 [label="Acho que \"A Grande Indiferença\" vai tentar ficar entre nós, de alguma forma ",shape=box,color=blue];
		2615 -> 2616;
	2616 [label="Não ria. Posso sentir, nas profundezas do meu ser. A coisa que estava na Rusalka adoraria nos ver destruindo uns aos outros ",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="Não sei por quê. Simplesmente sei ",shape=box,color=blue];
		2617 -> 2618;
		2617 -> 2619;
	2618 [label="É… pior que acho que você tem razão ",shape=box,color=red];
		2618 -> 2620;
	2619 [label="Talvez tenha acontecido isso com a família do Entrati. Eles viveram por muitos anos em cima do laboratório dele, sem saber. Quando a criança os encontrou, eles estavam distantes e rancorosos",shape=box,color=red];
		2619 -> 2620;
	2620 [label="Eu já vi isso em sua mente. O Albrecht e o Loid. A Mãe e o Pai. Você e seus pais. A Rusalka e o Vitor, pelo que sabemos. E nós 6, é claro ",shape=box,color=blue];
		2620 -> 2621;
	2621 [label="O que essa coisa faz é frio. Perverso. Mas tem uma motivação por trás disso, em algum lugar ",shape=box,color=blue];
		2621 -> 2622;
		2621 -> 2623;
	2622 [label="Acho que você tá certa. Na Zariman, os pais foram os primeiros a perderem a cabeça. Talvez os Indomáveis tenham resistido tanto tempo porque nenhum deles tinha filhos ",shape=box,color=red];
		2622 -> 2627;
	2623 [label="Não gosto de presumir que entendo coisas que são basicamente deuses. Essa coisa tá tentando entender as emoções. Só tá fazendo um péssimo trabalho ao brincar com seus brinquedos ",shape=box,color=red];
		2623 -> 2624;
	2627 [label="Apenas deixe que isso tente ficar entre nós. Então, Sol me ajude, eu vou acabar com isso. Encontrarei uma maneira ",shape=box,color=blue];
		2627 -> 2628;
	2624 [label="Teoria admirável, mas não SABEMOS disso, não é mesmo?",shape=box,color=blue];
		2624 -> 2625;
	2628 [label="Existem poderes no universo que aquela coisa não pode enfrentar. Eu escolho acreditar nisso com cada átomo de mim mesma ",shape=box,color=blue];
		2628 -> 2629;
	2625 [label="Se você tiver razão, então, isso não tem culpa. É quase infantil. Isso não se encaixa no que sabemos. Isso é malevolente ",shape=box,color=blue];
		2625 -> 2626;
	2629 [label="Se isso me devorar inteira, eu me enfiarei na garganta dessa coisa e vou sufocá-la",shape=box,color=blue];
		2629 -> 2630;
		2629 -> 2631;
	2626 [label="Chat ends.",color=orange];
	2630 [label="Essa é uma ótima forma de morrer ",shape=box,color=red];
		2630 -> 2632;
	2631 [label="Ainda não sei como vamos fazer isso, mas tô contigo. Temos que vencer ",shape=box,color=red];
		2631 -> 2635;
	2632 [label="Nesse cenário, estou morta de qualquer maneira ",shape=box,color=blue];
		2632 -> 2633;
	2635 [label="Se isso fosse uma história, você inventaria algum truque inteligente. Você desenterraria o coração de pedra do gigante e o quebraria com uma pena de cisne, ou o enganaria para que ele se jogasse de um penhasco ",shape=box,color=blue];
		2635 -> 2636;
	2633 [label="Mas pelo menos posso cuspir no olho dessa coisa",shape=box,color=blue];
		2633 -> 2634;
	2636 [label="Você disse que era uma \"jornalista\". Esse não é o tipo de história que você costumava contar, né? Você contava a verdade, por mais feia que fosse ",shape=box,color=red];
		2636 -> 2637;
	2634 [label="Chat ends.",color=orange];
	2637 [label="Se essas histórias antigas não contassem a verdade, as pessoas não continuariam a contá-las ",shape=box,color=blue];
		2637 -> 2638;
	2638 [label="Não quero dizer que os gigantes são reais. Apenas quero dizer que as histórias antigas contam um tipo diferente de verdade ",shape=box,color=blue];
		2638 -> 2639;
		2638 -> 2640;
	2639 [label="Vamos precisar de mais do que contos de fadas pra superar isso, por mais inspiradores que sejam ",shape=box,color=red];
		2639 -> 2641;
	2640 [label="Eu vivi em um reino feito de histórias. Sei o quão poderosas elas podem ser ",shape=box,color=red];
		2640 -> 2643;
	2641 [label="Eu sei. Gostaria de ter mais do que instinto para continuar ",shape=box,color=blue];
		2641 -> 2642;
	2643 [label="Acho que a única coisa que todas essas histórias de matadores de gigantes têm em comum é isso: todas elas tratam de aprender as regras e descobrir como ser inteligente com elas ",shape=box,color=blue];
		2643 -> 2644;
	2642 [label="Estamos confrontando algo vasto, aterrorizante e fora de nossa compreensão. Normalmente, apenas as crianças podem fazer isso. É por isso que existem os contos de fadas ",shape=box,color=blue];
		2642 -> 2645;
		2642 -> 2646;
	2644 [label="Alguns monstros são estúpidos. Alguns são induzidos a ser literais. Alguns têm segredos. Mas você não pode vencer até conhecer as regras às quais o monstro está sujeito ",shape=box,color=blue];
		2644 -> 2645;
		2644 -> 2646;
	2645 [label="Essa coisa tá presa numa \"parede\". Eu nem sei o que a \"parede\" é ",shape=box,color=red];
		2645 -> 2647;
	2646 [label="Não acho que a Indiferença esteja sujeita a alguma regra ",shape=box,color=red];
		2646 -> 2649;
	2647 [label="Não importa. Se essa coisa estiver realmente presa, então podemos deduzir 2 coisas, não é mesmo?",shape=box,color=blue];
		2647 -> 2651;
	2649 [label="Tem que ter! Até mesmo os deuses têm regras! Não importa o quão poderosa a Indiferença pareça, isso não é um Deus ",shape=box,color=blue];
		2649 -> 2650;
	2651 [label="Primeiro, essa coisa pode ficar presa. Talvez até mesmo aprisionada",shape=box,color=blue];
		2651 -> 2653;
	2650 [label="Você derrotou o Thrax. Não importa quantas vezes você fracassou e acabou no chão. Você VENCEU. Por que você não poderia derrotar o Homem na Parede também?",shape=box,color=blue];
		2650 -> 2648;
	2653 [label="+15 Chemistry",color=orange];
		2653 -> 2652;
	2648 [label="Quando foi que você deixou de ter medo dessa coisa, Eleanor?",shape=box,color=red];
		2648 -> 2655;
	2652 [label="E segundo, essa coisa QUER algo. Quer se libertar. Se soubermos o que isso quer, já estaremos um passo à frente",shape=box,color=blue];
		2652 -> 2654;
	2655 [label="Nunca",shape=box,color=blue];
		2655 -> 2657;
	2654 [label="Chat ends.",color=orange];
	2657 [label="+20 Chemistry",color=orange];
		2657 -> 2656;
	2656 [label="Só estou com mais medo de perder você, ok?",shape=box,color=blue];
		2656 -> 2658;
	2658 [label="Chat ends.",color=orange];
}