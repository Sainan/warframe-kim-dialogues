		1759 -> 1762;
	1760 [label="KKKKKKKKKK não, eles não fazem meu tipo, desculpa. É heroísmo demais pra mim",shape=box,color=red];
		1760 -> 1801;
	1761 [label="Ah! Ah! Me conta mais…",shape=box,color=blue];
		1761 -> 1764;
