digraph {
	1700 [label="EleanorRank4Convo4 begins.",color=orange];
		1700 -> 1701;
		1700 -> 1702;
		1700 -> 1703;
	1701 [label="Você e a Lê já foram amigas?",shape=box,color=red];
		1701 -> 1704;
	1702 [label="Esse é um grupo bem unido. Algum de vocês já namorou com outra pessoa do Hexa?",shape=box,color=red];
		1702 -> 1705;
	1703 [label="Como você reagiria se o Arthur se envolvesse com alguém? Romanticamente falando",shape=box,color=red];
		1703 -> 1706;
	1704 [label="Ah, Deuses… sim. Nós éramos muito unidas por um tempo ",shape=box,color=blue];
		1704 -> 1707;
	1705 [label="Isso é um tanto pessoal, camarada, mas vou permitir. Você já está com a gente há algum tempo. Merece conhecer o terreno ",shape=box,color=blue];
		1705 -> 1708;
	1706 [label="Alguém que não esteja a um milhão de quilômetros de distância, você diz?",shape=box,color=blue];
		1706 -> 1709;
	1707 [label="Isso antes do Entrati, é claro ",shape=box,color=blue];
		1707 -> 1710;
	1708 [label="Além do namoro do Arthur e da Aoi? Não… não que eu saiba, pelo menos… e EU SABERIA ",shape=box,color=blue];
		1708 -> 1711;
	1709 [label="Não responde ",shape=box,color=blue];
		1709 -> 1712;
	1710 [label="Agora ela age como se eu fosse uma pessoa diferente. É conveniente para ela. Se eu não for realmente a Eleanor, então ela pode me magoar o quanto quiser, porque não está magoando a pessoa que ela conhecia. Acho que isso é covardia ",shape=box,color=blue];
		1710 -> 1715;
	1711 [label="E, caso esteja pensando em se aproximar de qualquer um de nós…",shape=box,color=blue];
		1711 -> 1713;
	1712 [label="Se eu achasse que essa pessoa saiba o que está fazendo e tem sentimentos genuínos pelo cara, eu ficaria feliz. Obviamente ",shape=box,color=blue];
		1712 -> 1714;
	1715 [label="Mas ela ainda quer que você se recupere disso, né?",shape=box,color=red];
		1715 -> 1723;
	1713 [label="Você poderia ganhar a confiança do Quincy. Ele é muito observador. Talvez você possa aprender coisas com ele",shape=box,color=blue];
		1713 -> 1716;
	1714 [label="Mas eu gostaria de me certificar de que essa pessoa soubesse como é fácil machucá-lo ",shape=box,color=blue];
		1714 -> 1719;
	1723 [label="Ah, qual é. Vou criar asas e uma cauda antes que isso aconteça ",shape=box,color=blue];
		1723 -> 1724;
	1716 [label="+5 Chemistry",color=orange];
		1716 -> 1717;
	1719 [label="O que são aqueles robôs que têm armadura e atitude por fora, mas por dentro são orgânicos, macios e moles?",shape=box,color=blue];
		1719 -> 1718;
		1719 -> 1720;
		1719 -> 1721;
	1724 [label="O Entrati foi embora. Se havia alguma esperança de ter a antiga Eleanor de volta, aquela que cantava no chuveiro e sorria para as crianças na rua, essa esperança foi embora com ele ",shape=box,color=blue];
		1724 -> 1728;
		1724 -> 1729;
	1717 [label="Chat ends.",color=orange];
	1718 [label="Os Solaris?",shape=box,color=red];
		1718 -> 1722;
	1720 [label="O Nox?",shape=box,color=red];
		1720 -> 1722;
	1721 [label="Os Sentients?",shape=box,color=red];
		1721 -> 1722;
	1728 [label="A Lê precisa se olhar no espelho e entender que ela também está a apenas alguns dias ruins de perder sua humanidade ",shape=box,color=red];
		1728 -> 1730;
	1729 [label="Se o Arthur acha que você ainda é irmã dele, isso deve ser suficiente pra Lê também ",shape=box,color=red];
		1729 -> 1731;
	1722 [label="Não importa. Meu ponto é que o Arthur é como um desses ",shape=box,color=blue];
		1722 -> 1725;
	1730 [label="Você está tentando me bajular?",shape=box,color=blue];
		1730 -> 1732;
	1731 [label="POIS É, NÉ?",shape=box,color=blue];
		1731 -> 1733;
	1725 [label="Se ele se abrir com você, pelo amor de Sol, seja gentil com ele ",shape=box,color=blue];
		1725 -> 1726;
	1732 [label="Quero dizer, sim. Ela quer ",shape=box,color=blue];
		1732 -> 1734;
	1733 [label="A Lê adora o Arthur. Ele é o irmão mais velho que ela nunca teve. Se Arthur não estivesse por perto, eu acordaria com um pano com clorofórmio na minha boca e acabaria no fundo do rio ",shape=box,color=blue];
		1733 -> 1735;
	1726 [label="+5 Chemistry",color=orange];
		1726 -> 1727;
	1734 [label="Ainda não a perdoei pelo que ela disse sobre deixar a cidade queimar ",shape=box,color=blue];
		1734 -> 1736;
	1735 [label="Ela acha que ele está delirando, se apegando ao passado. Mas ela ama o cara e é uma boa soldada, portanto, nunca irá contra ele ",shape=box,color=blue];
		1735 -> 1737;
		1735 -> 1738;
	1727 [label="Chat ends.",color=orange];
	1736 [label="Até mesmo a Aoi ficou chocada. Isso nos faz pensar em quem são os verdadeiros monstros, não é mesmo?",shape=box,color=blue];
		1736 -> 1737;
		1736 -> 1738;
	1737 [label="Aliás, por que ela te odeia tanto?",shape=box,color=red];
		1737 -> 1739;
	1738 [label="Será que é só a língua que assusta ela? Ou é o fato de ler mentes?",shape=box,color=red];
		1738 -> 1739;
	1739 [label="É complicado. Tem mais de um motivo ",shape=box,color=blue];
		1739 -> 1740;
	1740 [label="Ela me disse na cara dura que eu não deveria ficar cutucando a cabeça dela. Se eu não concordasse, ela deixaria o Hexa e se arriscaria fazer as coisas sozinha. Loucura ",shape=box,color=blue];
		1740 -> 1741;
	1741 [label="Então, em parte, ela tem medo de que eu leia o diário de adolescente dela, por assim dizer. Vou espiar segredos mais embaraçosos dela e rir muito, e ela ficará humilhada para sempre ",shape=box,color=blue];
		1741 -> 1742;
	1742 [label="A verdade é que não sou tão curiosa assim. Independentemente do segredinho doentio que ela esteja escondendo de mim, ele está seguro ",shape=box,color=blue];
		1742 -> 1743;
		1742 -> 1744;
	1743 [label="Vocês duas já tiveram uma história… mais romântica juntas?",shape=box,color=red];
		1743 -> 1745;
	1744 [label="Você acha que talvez ela GOSTE de você?",shape=box,color=red];
		1744 -> 1746;
	1745 [label="Você acha que vou beijar e contar?",shape=box,color=blue];
		1745 -> 1747;
	1746 [label="Passou pela minha cabeça ",shape=box,color=blue];
		1746 -> 1748;
	1747 [label="Não. Não tivemos ",shape=box,color=blue];
		1747 -> 1749;
	1748 [label="Eu estaria disposta a isso, eu acho. Não há nada de errado em dar uns amassos entre amigos, especialmente se o Arthur tivesse que nos dar um discurso constrangedor na reunião sobre como não devemos deixar nossos sentimentos atrapalharem nosso trabalho ",shape=box,color=blue];
		1748 -> 1750;
	1749 [label="O que é ótimo, porque… imagina como as coisas ficariam estranhas entre nós agora?",shape=box,color=blue];
		1749 -> 1751;
	1750 [label="Isso tira o estresse, é bom para a moral e é barato ",shape=box,color=blue];
		1750 -> 1752;
	1751 [label="Quero dizer… eu não teria recusado nada… mas isso nunca aconteceu ",shape=box,color=blue];
		1751 -> 1755;
	1752 [label="Mas o que quer que a Sra. Garcia esteja escondendo é algo que as pessoas podem usar para machucá-la. Portanto, sou uma ameaça, porque posso ver isso na cabeça dela ",shape=box,color=blue];
		1752 -> 1754;
	1755 [label="+10 Chemistry",color=orange];
		1755 -> 1753;
	1754 [label="Peraí… o Arthur e a Aoi não eram um casal?",shape=box,color=red];
		1754 -> 1757;
	1753 [label="Portanto, se você se sente algo por ela, vá em frente! Torcerei à distância! Lua sabe que a Lê precisa de um pouco de felicidade na vida sombria e sem amor dela ",shape=box,color=blue];
		1753 -> 1756;
	1757 [label="Por quê? Você tem planos para o meu irmão? Ou para a Aoi?",shape=box,color=blue];
		1757 -> 1758;
		1757 -> 1759;
