		1778 -> 1779;
	1786 [label="+20 Chemistry",color=orange];
		1786 -> 1782;
	1789 [label="Mas você não vai até as pessoas em luto e diz \"eu te avisei\". Você se une a elas. Fiz o possível para confortar o Arthur, e a Lê tentou consertar o coração partido da Aoi ",shape=box,color=blue];
		1789 -> 1790;
	1779 [label="A Aoi é minha amiga. E por mais idiota que o Arthur seja, ele ainda é meu irmão ",shape=box,color=blue];
		1779 -> 1780;
	1782 [label="Ok. Não sei o que ELES diriam para você, mas, do meu ponto de vista, eles estavam apenas indo para direções diferentes ",shape=box,color=blue];
		1782 -> 1783;
	1790 [label="Vai com cuidado. É só isso que estou dizendo ",shape=box,color=blue];
		1790 -> 1792;
	1780 [label="Nem sei se deveria confiar algo a você ",shape=box,color=blue];
		1780 -> 1781;
	1783 [label="Ambos são românticos, mas de tipos diferentes. O Arthur quer o chalé com as rosas na porta. Ele diz que não quer, mas quer ",shape=box,color=blue];
		1783 -> 1784;
	1792 [label="Chat ends.",color=orange];
	1781 [label="Chat ends.",color=orange];
	1784 [label="Deuses, ele até falava em assumir o controle de um bar algum dia. Consigo imaginar ele com sua pequena multidão de clientes, bebendo cerveja, fazendo assados no domingo, cheio de sabedoria duramente conquistada ",shape=box,color=blue];
		1784 -> 1785;
	1785 [label="Você consegue ver a Aoi encontrando um lugar em um sonho como esse? Eu não. Ela precisa abrir as asas ",shape=box,color=blue];
