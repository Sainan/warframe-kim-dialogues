	1795 [label="Veremos ",shape=box,color=blue];
		1795 -> 1796;
	1799 [label="Estou intrigada ",shape=box,color=blue];
		1799 -> 1800;
	1769 [label="Só para ficar claro: provocar o Arthur é MINHA prerrogativa. E se você for cruel com ele de propósito, eu te mato. Mais uma coisa…",shape=box,color=blue];
		1769 -> 1772;
	1771 [label="Conheça a Aoi REAL, não a imagem que você tem dela em sua cabeça, e você ficará bem. Além disso…",shape=box,color=blue];
		1771 -> 1772;
	1796 [label="+5 Chemistry",color=orange];
		1796 -> 1797;
