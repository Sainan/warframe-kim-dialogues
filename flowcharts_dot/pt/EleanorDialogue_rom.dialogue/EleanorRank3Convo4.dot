		1123 -> 1124;
	1124 [label="Então, me interrompe se eu errar alguma coisa:",shape=box,color=blue];
		1124 -> 1125;
	1125 [label="Você tem outra versão sua lá fora, andando por aí. Essa sua outra versão é você, mas não é você. É como uma versão infantil de você em outra versão da realidade ",shape=box,color=blue];
		1125 -> 1126;
