		1198 -> 1199;
	1199 [label="Então, tem uma criança. Uma criança profundamente traumatizada. E alguém achou que era uma boa ideia dar a essa criança armas, armaduras e uma seleção de trajes de batalha feitos de pessoas mortas, treiná-la para matar e… mandá-la para guerra?",shape=box,color=blue];
