digraph {
	"EleanorRank6Convo2 begins." [color=orange];
		"EleanorRank6Convo2 begins." -> j746447319;
	j746447319 [label="Ei, preciso trocar umas ideias com você",shape=box,color=blue];
		j746447319 -> j3839100192;
	j3839100192 [label="Tenho pensado no Fiendsnight. Faz anos que não me arrumo para isso, mas estava folheando um dos quadrinhos do Amir e de repente pensei: pera aí, eu poderia ser a Condessa! Tenho presas para isso e tudo!",shape=box,color=blue];
		j3839100192 -> j834121317;
	j834121317 [label="Mas não fica muito óbvio? E se eu for de Dandy Danoso?",shape=box,color=blue];
		j834121317 -> j3954157833;
		j834121317 -> j1948703162;
		j834121317 -> j3225371931;
	j3954157833 [label="Quem é Dandy Danoso?",shape=box,color=red];
		j3954157833 -> j680098513;
	j1948703162 [label="Você pode se vestir de Lótus, se quiser confundir as pessoas",shape=box,color=red];
		j1948703162 -> j275785807;
	j3225371931 [label="É… você vai ter que me explicar o que é um \"Fiendsnight\"",shape=box,color=red];
		j3225371931 -> j2453104906;
	j680098513 [label="Ah, meu camarada…",shape=box,color=blue];
		j680098513 -> j2700817300;
	j275785807 [label="Minha nossa, não. Eu já vi a imagem dela na sua cabeça, eu não chego aos pés dela",shape=box,color=blue];
		j275785807 -> j90298590;
	j2453104906 [label="Hmm… às vezes esqueço que você é inocente ",shape=box,color=blue];
		j2453104906 -> j1411050299;
	j2700817300 [label="Dandy Danoso caminhou para que Temple e os Rippers pudessem correr. Ele era o pesadelo de qualquer mãe e o sonho de qualquer adolescente rebelde",shape=box,color=blue];
		j2700817300 -> j398569242;
	j90298590 [label="E aquele capacete? É um capacete, né? Faz parte dela? Como ela consegue enxergar através daquilo?",shape=box,color=blue];
		j90298590 -> j2099488577;
	j1411050299 [label="Fiendsnight celebra o fim da influência do Sol no mundo",shape=box,color=blue];
		j1411050299 -> j3952450793;
	j398569242 [label="A constituição física de um bicho-pau, com a aparência de uma rainha do cinema mudo. Uma boca feita de doce. Risca de giz, couro e correntes. Maçãs do rosto como os quadris de um esqueleto",shape=box,color=blue];
		j398569242 -> j44837406;
		j398569242 -> j312181366;
	j2099488577 [label="De qualquer forma, são três dela num corpo só. Eu jamais conseguiria escolher apenas uma",shape=box,color=blue];
		j2099488577 -> j44837406;
		j2099488577 -> j312181366;
	j3952450793 [label="O que não faz muito sentido à primeira vista. Por que celebrar o avanço da escuridão? Por que se alegrar com a ilegalidade e a anarquia?",shape=box,color=blue];
		j3952450793 -> j1884646190;
	j44837406 [label="Fantasia? Festa? Numa zona de guerra? Você acha mesmo que isso vai acontecer?",shape=box,color=red];
		j44837406 -> j1127048489;
	j312181366 [label="Sabe, Fiendsnight lembra muito Naberus. As pessoas também gostam de se fantasiar pra isso",shape=box,color=red];
		j312181366 -> j1127048489;
	j1884646190 [label="Acho que é como uma vacina. Um pouquinho daquilo que temos medo para nos fortalecer. Ou talvez seja só uma desculpa para colocar a máscara do diabo e fazer bagunça",shape=box,color=blue];
		j1884646190 -> j44837406;
		j1884646190 -> j312181366;
	j1127048489 [label="Provavelmente só estou sendo infantil… coisa de criança, né?",shape=box,color=blue];
		j1127048489 -> j2242095201;
	j2242095201 [label="Ah, onde estou com a cabeça…",shape=box,color=blue];
		j2242095201 -> j196155416;
	j196155416 [label="Não preciso nem me arrumar, não é? Já sou um monstro, pra sempre",shape=box,color=blue];
		j196155416 -> j2436064064;
	j2436064064 [label="Check boolean EleanorDating",color=orange];
		j2436064064 -> j2279783787 [label=true,color=green];
		j2436064064 -> j139258491 [label=true,color=green];
		j2436064064 -> j3435614598 [label=true,color=green];
		j2436064064 -> j139258491 [label=false,color=brown];
		j2436064064 -> j3435614598 [label=false,color=brown];
	j2279783787 [label="Você é o monstro que eu amo, Eleanor. Não me arrependo de nada",shape=box,color=red];
		j2279783787 -> j2355305919;
	j139258491 [label="Tô começando a achar que você gosta de falar assim de si mesma",shape=box,color=red];
		j139258491 -> j126831040;
	j3435614598 [label="Não, monstros de verdade não se importam com os outros como você se importa",shape=box,color=red];
		j3435614598 -> j2074018866;
	j2355305919 [label="+5 Chemistry",color=orange];
		j2355305919 -> j626548297;
	j126831040 [label="Se é isso que você realmente acredita ser, então Fiendsnight é a oportunidade perfeita de celebrar isso",shape=box,color=red];
		j126831040 -> j2824507914;
		j126831040 -> j2074018866;
	j2074018866 [label="Eu sei que você tem medo do que pode se tornar, mas não é quem você é AGORA",shape=box,color=red];
		j2074018866 -> j645244934;
	j626548297 [label="Ah, verdade! Que boba, esqueci que o monstro teve um final feliz na nossa historinha",shape=box,color=blue];
		j626548297 -> j954354344;
	j2824507914 [label="SEJA o monstro. Honre isso. Nessa noite única do ano, use esse título com orgulho",shape=box,color=red];
		j2824507914 -> j3506598943;
	j645244934 [label="Então vai se arrumar. Vai se divertir. O Void sabe que o Hexa precisa se divertir um pouco ",shape=box,color=red];
		j645244934 -> j1947777544;
	j954354344 [label="Desculpa, ainda não consigo acreditar que é isso que você quer MESMO. Talvez eu só precise de um pouquinho mais de convencimento",shape=box,color=blue];
		j954354344 -> j972450026;
	j3506598943 [label="Ah, são TANTOS motivos que fazem disso uma PÉSSIMA IDEIA",shape=box,color=blue];
		j3506598943 -> j2935567997;
	j1947777544 [label="Vou seguir a sua dica. E obrigada, de novo <3",shape=box,color=blue];
		j1947777544 -> "Chat ends.";
	j972450026 [label="Vamos nos devorar mais tarde <3",shape=box,color=blue];
		j972450026 -> "Chat ends.";
	j2935567997 [label="TANTOS",shape=box,color=blue];
		j2935567997 -> j2818005362;
	"Chat ends." [color=orange];
	j2818005362 [label="(Não consigo pensar em nenhum agora, mas tenho certeza de que existem DEZENAS)",shape=box,color=blue];
		j2818005362 -> j3312879872;
	j3312879872 [label="Merda…",shape=box,color=blue];
		j3312879872 -> j3666326958;
	j3666326958 [label="Você me espetou direitinho no meu próprio kebab. Droga, bom trabalho <3",shape=box,color=blue];
		j3666326958 -> "Chat ends.";
}