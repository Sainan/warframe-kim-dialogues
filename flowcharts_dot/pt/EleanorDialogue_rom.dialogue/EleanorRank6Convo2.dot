digraph {
	2845 [label="EleanorRank6Convo2 begins.",color=orange];
		2845 -> 2846;
	2846 [label="Ei, preciso trocar umas ideias com você",shape=box,color=blue];
		2846 -> 2847;
	2847 [label="Tenho pensado no Fiendsnight. Faz anos que não me arrumo para isso, mas estava folheando um dos quadrinhos do Amir e de repente pensei: pera aí, eu poderia ser a Condessa! Tenho presas para isso e tudo!",shape=box,color=blue];
		2847 -> 2848;
	2848 [label="Mas não fica muito óbvio? E se eu for de Dandy Danoso?",shape=box,color=blue];
		2848 -> 2849;
		2848 -> 2850;
		2848 -> 2851;
	2849 [label="Quem é Dandy Danoso?",shape=box,color=red];
		2849 -> 2852;
	2850 [label="Você pode se vestir de Lótus, se quiser confundir as pessoas",shape=box,color=red];
		2850 -> 2853;
	2851 [label="É… você vai ter que me explicar o que é um \"Fiendsnight\"",shape=box,color=red];
		2851 -> 2854;
	2852 [label="Ah, meu camarada…",shape=box,color=blue];
		2852 -> 2855;
	2853 [label="Minha nossa, não. Eu já vi a imagem dela na sua cabeça, eu não chego aos pés dela",shape=box,color=blue];
		2853 -> 2856;
	2854 [label="Hmm… às vezes esqueço que você é inocente ",shape=box,color=blue];
		2854 -> 2857;
	2855 [label="Dandy Danoso caminhou para que Temple e os Rippers pudessem correr. Ele era o pesadelo de qualquer mãe e o sonho de qualquer adolescente rebelde",shape=box,color=blue];
		2855 -> 2858;
	2856 [label="E aquele capacete? É um capacete, né? Faz parte dela? Como ela consegue enxergar através daquilo?",shape=box,color=blue];
		2856 -> 2859;
	2857 [label="Fiendsnight celebra o fim da influência do Sol no mundo",shape=box,color=blue];
		2857 -> 2860;
	2858 [label="A constituição física de um bicho-pau, com a aparência de uma rainha do cinema mudo. Uma boca feita de doce. Risca de giz, couro e correntes. Maçãs do rosto como os quadris de um esqueleto",shape=box,color=blue];
		2858 -> 2861;
		2858 -> 2862;
	2859 [label="De qualquer forma, são três dela num corpo só. Eu jamais conseguiria escolher apenas uma",shape=box,color=blue];
		2859 -> 2861;
		2859 -> 2862;
	2860 [label="O que não faz muito sentido à primeira vista. Por que celebrar o avanço da escuridão? Por que se alegrar com a ilegalidade e a anarquia?",shape=box,color=blue];
		2860 -> 2863;
	2861 [label="Fantasia? Festa? Numa zona de guerra? Você acha mesmo que isso vai acontecer?",shape=box,color=red];
		2861 -> 2864;
	2862 [label="Sabe, Fiendsnight lembra muito Naberus. As pessoas também gostam de se fantasiar pra isso",shape=box,color=red];
		2862 -> 2864;
	2863 [label="Acho que é como uma vacina. Um pouquinho daquilo que temos medo para nos fortalecer. Ou talvez seja só uma desculpa para colocar a máscara do diabo e fazer bagunça",shape=box,color=blue];
		2863 -> 2861;
		2863 -> 2862;
	2864 [label="Provavelmente só estou sendo infantil… coisa de criança, né?",shape=box,color=blue];
		2864 -> 2865;
	2865 [label="Ah, onde estou com a cabeça…",shape=box,color=blue];
		2865 -> 2866;
	2866 [label="Não preciso nem me arrumar, não é? Já sou um monstro, pra sempre",shape=box,color=blue];
		2866 -> 2867;
	2867 [label="Check boolean EleanorDating",color=orange];
		2867 -> 2868 [label=true,color=green];
		2867 -> 2869 [label=true,color=green];
		2867 -> 2870 [label=true,color=green];
		2867 -> 2869 [label=false,color=brown];
		2867 -> 2870 [label=false,color=brown];
	2868 [label="Você é o monstro que eu amo, Eleanor. Não me arrependo de nada",shape=box,color=red];
		2868 -> 2871;
	2869 [label="Tô começando a achar que você gosta de falar assim de si mesma",shape=box,color=red];
		2869 -> 2872;
	2870 [label="Não, monstros de verdade não se importam com os outros como você se importa",shape=box,color=red];
		2870 -> 2873;
	2871 [label="+5 Chemistry",color=orange];
		2871 -> 2874;
	2872 [label="Se é isso que você realmente acredita ser, então Fiendsnight é a oportunidade perfeita de celebrar isso",shape=box,color=red];
		2872 -> 2875;
		2872 -> 2873;
	2873 [label="Eu sei que você tem medo do que pode se tornar, mas não é quem você é AGORA",shape=box,color=red];
		2873 -> 2876;
	2874 [label="Ah, verdade! Que boba, esqueci que o monstro teve um final feliz na nossa historinha",shape=box,color=blue];
		2874 -> 2877;
	2875 [label="SEJA o monstro. Honre isso. Nessa noite única do ano, use esse título com orgulho",shape=box,color=red];
		2875 -> 2878;
	2876 [label="Então vai se arrumar. Vai se divertir. O Void sabe que o Hexa precisa se divertir um pouco ",shape=box,color=red];
		2876 -> 2879;
	2877 [label="Desculpa, ainda não consigo acreditar que é isso que você quer MESMO. Talvez eu só precise de um pouquinho mais de convencimento",shape=box,color=blue];
		2877 -> 2880;
	2878 [label="Ah, são TANTOS motivos que fazem disso uma PÉSSIMA IDEIA",shape=box,color=blue];
		2878 -> 2881;
	2879 [label="Vou seguir a sua dica. E obrigada, de novo <3",shape=box,color=blue];
		2879 -> 2882;
	2880 [label="Vamos nos devorar mais tarde <3",shape=box,color=blue];
		2880 -> 2883;
	2881 [label="TANTOS",shape=box,color=blue];
		2881 -> 2884;
	2882 [label="Chat ends.",color=orange];
	2883 [label="Chat ends.",color=orange];
	2884 [label="(Não consigo pensar em nenhum agora, mas tenho certeza de que existem DEZENAS)",shape=box,color=blue];
		2884 -> 2885;
	2885 [label="Merda…",shape=box,color=blue];
		2885 -> 2886;
	2886 [label="Você me espetou direitinho no meu próprio kebab. Droga, bom trabalho <3",shape=box,color=blue];
		2886 -> 2887;
	2887 [label="Chat ends.",color=orange];
}