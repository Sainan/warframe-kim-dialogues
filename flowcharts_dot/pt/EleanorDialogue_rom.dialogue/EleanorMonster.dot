digraph {
	1458 [label="EleanorMonster begins.",color=orange];
		1458 -> 1459;
	1459 [label="O que você me disse ontem… sobre deixar o monstro viver. Você estava falando sério? Preciso saber ",shape=box,color=blue];
		1459 -> 1460;
		1459 -> 1461;
		1459 -> 1462;
	1460 [label="Claro que sim",shape=box,color=red];
		1460 -> 1464;
	1461 [label="Sinceramente… pensei um pouco melhor e… não. Eu teria que te impedir de se tornar um monstro ",shape=box,color=red];
		1461 -> 1465;
	1462 [label="[Ignorar]",shape=box,color=red];
		1462 -> 1463;
	1464 [label="Não que eu não esteja extremamente grata e, honestamente, um pouco chocada, mas… por quê? POR QUE você me deixaria viver? Quando todos os outros aqui estariam tão dispostos a dar um tiro na minha cabeça?",shape=box,color=blue];
		1464 -> 1466;
		1464 -> 1467;
	1465 [label="Obrigada. Você é um enigma para mim em muitos aspectos, mas agora sei que você estaria disposto a dar um tiro na minha cabeça, e esse tipo de coisa é importante no local de trabalho ",shape=box,color=blue];
		1465 -> 1468;
	1463 [label="Chat ends.",color=orange];
	1466 [label="A linha entre \"herói\" e \"monstro\" é mais tênue que a maioria das pessoas gosta de admitir. Já lutei contra Grineer e Corpus, e lutei ao lado deles ",shape=box,color=red];
		1466 -> 1473;
	1467 [label="Porque acho que você é uma das pessoas mais inteligentes e maravilhosamente sarcásticas que já conheci. Acho que nem mesmo o Tecnovírus poderia tirar isso de você ",shape=box,color=red];
		1467 -> 1472;
	1468 [label="Eeee eu senti o Tecnovírus em minhas células tremer de ansiedade ",shape=box,color=blue];
		1468 -> 1469;
	1473 [label="Não acredito nas palavras \"Bem\" e \"Mal\", só nas pessoas. Por que você tem menos direito de existir do que eu? Posso não ter um línguão, mas também sou uma aberração da natureza ",shape=box,color=red];
		1473 -> 1474;
	1472 [label="Que… bela ingenuidade. E maravilhosamente doce, de uma forma trágica ",shape=box,color=blue];
		1472 -> 1475;
	1469 [label="Acho que ele vai se comportar um pouco melhor de agora em diante. Nada como ameaçar a hospedeira para colocar o medo do Sol no parasita, não é?",shape=box,color=blue];
		1469 -> 1470;
	1474 [label="Mas aqui está você, lutando contra a Scaldra e o Tecnovírus, tentando encontrar uma maneira de deter a Indiferença. Você claramente acredita que há uma linha a ser traçada em algum lugar ",shape=box,color=blue];
		1474 -> 1476;
		1474 -> 1477;
	1475 [label="O fato de você acreditar que eu sairia do outro lado como uma espécie de rainha da colmeia com meu eu intacto, uma porta-voz bizarra da infestação com a qual você poderia fazer amizade ou talvez até mesmo adorar ",shape=box,color=blue];
		1475 -> 1479;
	1470 [label="Update boolean EleanorNoDate",color=orange];
		1470 -> 1471;
	1476 [label="A Indiferença foi desencadeada pelo Entrati, um mero homem. A culpa é da arrogância humana ",shape=box,color=red];
		1476 -> 1483;
	1477 [label="Proteger as pessoas da morte não é a mesma coisa que acreditar que algo não tenha o direito de existir ",shape=box,color=red];
		1477 -> 1478;
	1479 [label="Eu te repreenderia pelo fato de que o mundo não funciona como um livro de histórias, mas… aí eu me lembro exatamente de quem você é e de onde veio ",shape=box,color=blue];
		1479 -> 1480;
	1471 [label="Chat ends.",color=orange];
	1483 [label="Mas o Tecnovírus não é a Indiferença. E quanto a isso? E a ameaça biológica e terrestre que temos aqui?",shape=box,color=blue];
		1483 -> 1485;
		1483 -> 1486;
	1478 [label="Garantir que um rebanho de ovelhas não seja comido por lobos não é o mesmo que sair e matar todos os lobos por serem maus ",shape=box,color=red];
		1478 -> 1484;
	1480 [label="Então, acho que não deveria ficar surpresa ",shape=box,color=blue];
		1480 -> 1481;
	1485 [label="A gente não sabe de onde o Tecnovírus veio. Ele pode ter sido feito pela humanidade, ou pode ter vindo de um lugar completamente diferente ",shape=box,color=red];
		1485 -> 1488;
	1486 [label="O simples fato é que você não quer que eu te mate. Então, eu não faria. Eu te deixaria ir ",shape=box,color=red];
		1486 -> 1489;
	1484 [label="E se nada da Eleanor sobrasse? E se você não visse nada além de uma fera chiante, rosnando e cuspindo?",shape=box,color=blue];
		1484 -> 1487;
		1484 -> 1486;
	1481 [label="De qualquer forma, acho que estou grata que você não iria me matar. É isso",shape=box,color=blue];
		1481 -> 1482;
	1488 [label="E se o Tecnovírus se revelasse ser outra aberração liberada pela humanidade, como o seu Homem na Parede? O que aconteceria então? Você me caçaria e me mataria?",shape=box,color=blue];
		1488 -> 1491;
		1488 -> 1492;
	1489 [label="Embora eu seja grata por você acatar os desejos de uma dama monstruosa, acho que esperava algo um pouco mais… considerativo ",shape=box,color=blue];
		1489 -> 1498;
	1487 [label="Como vou saber que não sobrou nada da Eleanor? Você sempre me fala sobre como o Tecnovírus pensa, como ele fala com você. Ele claramente é inteligente ",shape=box,color=red];
		1487 -> 1490;
	1482 [label="Chat ends.",color=orange];
	1491 [label="Não… eu não conseguiria fazer isso",shape=box,color=red];
		1491 -> 1500;
	1492 [label="Sim. Se o Tecnovírus realmente não for natural? Então… ele tem que morrer ",shape=box,color=red];
		1492 -> 1501;
	1498 [label="+5 Chemistry",color=orange];
		1498 -> 1493;
	1490 [label="Parece ser uma mente coletiva. Talvez a Eleanor ainda estivesse lá, não em um lugar, mas em um bilhão deles. Quem sou eu pra falar que isso é \"errado\"?",shape=box,color=red];
		1490 -> 1494;
	1500 [label="Você está se contradizendo. Se você tem a coragem de impedir uma aberração criada pela humanidade, por que não duas?",shape=box,color=blue];
		1500 -> 1506;
		1500 -> 1507;
	1501 [label="Obrigada. Você é um enigma para mim em muitos aspectos, mas agora sei que você estaria disposto a dar um tiro na minha cabeça, e esse tipo de coisa é importante no local de trabalho ",shape=box,color=blue];
		1501 -> 1502;
	1493 [label="De qualquer forma, acho que estou grata que você não iria me matar. É isso",shape=box,color=blue];
		1493 -> 1499;
	1494 [label="Justamente quando eu pensava que não poderia te adorar mais, me vejo mais uma vez sentada aqui, chorando de alegria",shape=box,color=blue];
		1494 -> 1496;
	1506 [label="Porque… eu gosto muito de você… mais que como amiga [Confessar Sentimentos]",shape=box,color=red];
		1506 -> 1508;
	1507 [label="Porque você é muito importante pra mim como amiga ",shape=box,color=red];
		1507 -> 1509;
	1502 [label="Eeee eu senti o Tecnovírus em minhas células tremer de ansiedade ",shape=box,color=blue];
		1502 -> 1503;
	1499 [label="Chat ends.",color=orange];
	1496 [label="+20 Chemistry",color=orange];
		1496 -> 1495;
	1508 [label="Me perguntar se eu te mataria é CRUEL, Eleanor. Quando penso em você morta ou com dor, eu simplesmente…",shape=box,color=red];
		1508 -> 1510;
	1509 [label="Me perguntar se eu te mataria é CRUEL, Eleanor. Você é minha amiga. É praticamente família pra mim",shape=box,color=red];
		1509 -> 1511;
	1503 [label="Acho que ele vai se comportar um pouco melhor de agora em diante. Nada como ameaçar a hospedeira para colocar o medo do Sol no parasita, não é?",shape=box,color=blue];
		1503 -> 1504;
	1495 [label="Preciso ir mas… obrigada obrigada OBRIGADA",shape=box,color=blue];
		1495 -> 1497;
	1510 [label="A resposta? Eu não conseguiria te matar. Não conseguiria fazer isso sabendo que você poderia continuar existindo em algum lugar por aí, mesmo que de outra forma. Só isso já basta pra mim",shape=box,color=red];
		1510 -> 1512;
	1511 [label="A resposta? Eu não conseguiria te matar. Não conseguiria fazer isso sabendo que você poderia continuar existindo em algum lugar por aí, mesmo que de outra forma. Só isso já basta pra mim",shape=box,color=red];
