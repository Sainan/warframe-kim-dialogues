	2397 [label="O Arthur não vai te matar, Eleanor. Você é irmã dele. Ele sabe disso ",shape=box,color=red];
		2397 -> 2398;
	2396 [label="Chat ends.",color=orange];
	2398 [label="Mas é exatamente isso. \"Você não é mais minha irmã\" É o que ele diz no sonho. Depois, ele me apunhala no peito com sua espada de brinquedo ",shape=box,color=blue];
		2398 -> 2399;
	2399 [label="Somos apenas crianças no sonho, como se já não fosse terrível o suficiente ",shape=box,color=blue];
		2399 -> 2400;
		2399 -> 2401;
	2400 [label="Não é real. O Arthur jamais te machucaria, não importa o quão Infestada você fique ",shape=box,color=red];
		2400 -> 2402;
	2401 [label="Eita…",shape=box,color=red];
		2401 -> 2403;
	2402 [label="Nem mesmo para \"acabar com o meu sofrimento\"? Nem mesmo se eu estivesse com dor?",shape=box,color=blue];
		2402 -> 2408;
	2403 [label="É, essa é a pior parte ",shape=box,color=blue];
		2403 -> 2404;
