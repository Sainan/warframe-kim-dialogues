	2392 [label="Eu continuo tendo esse sonho horrível com o Arthur, onde ele tem que me matar. E enquanto ele enfia a lâmina entre minhas costelas, eu grito \"a Eleanor está BEM AQUI, seu imbecil!\", mas ele não pode mais me ouvir ",shape=box,color=blue];
