		2408 -> 2409;
		2408 -> 2410;
	2404 [label="É tudo tão vívido, tão real. Como se eu estivesse lembrando de algo que realmente aconteceu ",shape=box,color=blue];
		2404 -> 2405;
		2404 -> 2406;
	2409 [label="Por pior que você possa pensar que a sua família era, ela não é nada comparada a algumas que conheci ",shape=box,color=red];
		2409 -> 2411;
	2410 [label="Peraí… o que o seu pai tem a ver com isso?",shape=box,color=red];
		2410 -> 2412;
	2405 [label="Mas tenho certeza de que o Arthur não faria isso ",shape=box,color=red];
		2405 -> 2408;
	2406 [label="E se você conversar com o Arthur sobre isso?",shape=box,color=red];
		2406 -> 2407;
	2411 [label="Imagino. O futuro é bem criativo em sua crueldade ",shape=box,color=blue];
		2411 -> 2413;
	2412 [label="Tudo ",shape=box,color=blue];
		2412 -> 2414;
		2412 -> 2415;
	2407 [label="Não posso. Ele é igual ao pai dele. Só quer fazer a coisa certa, e não a fácil ",shape=box,color=blue];
		2407 -> 2409;
		2407 -> 2410;
	2413 [label="Mas minha preocupação aqui é com o passado ",shape=box,color=blue];
		2413 -> 2416;
	2414 [label="Você vai ter que me dar mais do que isso se quiser que eu acompanhe ",shape=box,color=red];
		2414 -> 2416;
	2415 [label="Eleanor, por favor, para de ser tão misteriosa de propósito ",shape=box,color=red];
		2415 -> 2417;
	2416 [label="É uma das muitas, muitas coisas das quais não falamos ",shape=box,color=blue];
		2416 -> 2420;
	2417 [label="Não é de propósito",shape=box,color=blue];
		2417 -> 2418;
	2420 [label="Não falamos sobre o que aconteceu em Cavona, não falamos sobre o Christopher e NUNCA falamos sobre a Vovó Callie ",shape=box,color=blue];
		2420 -> 2421;
		2420 -> 2422;
	2418 [label="Honestamente, estou fazendo o melhor que posso para explicar ",shape=box,color=blue];
		2418 -> 2419;
	2421 [label="É… então é melhor não falar sobre isso",shape=box,color=red];
		2421 -> 2423;
	2422 [label="É… acho que tá na hora de falar sobre isso",shape=box,color=red];
		2422 -> 2425;
	2419 [label="Meu pai deu o exemplo de como eu e o Arthur lidamos com os problemas entre nós. Ou melhor, de como nós \"não\" lidamos ",shape=box,color=blue];
		2419 -> 2420;
	2423 [label="De fato",shape=box,color=blue];
		2423 -> 2424;
	2425 [label="De fato",shape=box,color=blue];
		2425 -> 2426;
	2424 [label="Chat ends.",color=orange];
	2426 [label="Talvez seja o momento ",shape=box,color=blue];
		2426 -> 2427;
	2427 [label="Você quer saber a história toda? Ou prefere a versão resumida?",shape=box,color=blue];
		2427 -> 2428;
		2427 -> 2429;
	2428 [label="Não vou a lugar nenhum. Manda bala ",shape=box,color=red];
		2428 -> 2432;
	2429 [label="Pode ser a versão resumida?",shape=box,color=red];
		2429 -> 2430;
	2432 [label="Vovó Callie era a nossa avó paterna. Callista Penrose Nightingale ",shape=box,color=blue];
		2432 -> 2433;
	2430 [label="A Vovó Callie estava muito doente. Demente. Nosso pai a sufocou até a morte com um travesseiro em vez de deixá-la continuar sofrendo. Espero que isso seja curto o suficiente para você ",shape=box,color=blue];
		2430 -> 2431;
	2433 [label="Ela tinha Síndrome de Pelham. Vocês provavelmente já acharam uma cura para isso (ela disse com uma pontada no coração). Essa síndrome corrói a mente de uma pessoa. Em vez de ver alguém que você ama morrer repentinamente, ela desaparece lentamente, aos poucos, como uma fotografia antiga que perde a cor ao sol ou um vídeo copiado muitas vezes ",shape=box,color=blue];
		2433 -> 2434;
		2433 -> 2435;
	2431 [label="Chat ends.",color=orange];
	2434 [label="Tipo o que tava acontecendo com a Suda? O que fez ela decidir virar uma Cephalon? Entendi",shape=box,color=red];
		2434 -> 2436;
	2435 [label="Na verdade… não, ainda não encontramos uma cura…",shape=box,color=red];
		2435 -> 2436;
	2436 [label="Quando ela veio morar conosco, eu e o Arthur ficamos muito entusiasmados. Para nós, ela era a adorável senhorinha que cheirava a violetas e contava histórias em que fazia todos os tipos de vozes. Ela nos dava dinheiro de verdade em nossos aniversários. Achávamos que seria como um aniversário o tempo todo ",shape=box,color=blue];
		2436 -> 2437;
	2437 [label="Então, ela começou a piorar. No começo, ficava apenas esquecida. Então, ela começou a nos confundir com outras pessoas. Ela me chamou de Albertine e o Arthur de Charlie. Exigia saber para onde o Jimmy tinha fugido. Nós nunca descobrimos se o Jimmy era um cachorro, um gato ou um namorado ",shape=box,color=blue];
		2437 -> 2438;
	2438 [label="Então, ela começou a falar com pessoas que não estavam lá. Depois, começou a vagar pela casa de noite",shape=box,color=blue];
		2438 -> 2440;
		2438 -> 2441;
	2440 [label="Deve ter sido assustador pra vocês dois ",shape=box,color=red];
		2440 -> 2439;
	2441 [label="Poxa…",shape=box,color=red];
		2441 -> 2439;
	2439 [label="Eu lembro de ir fazer xixi no meio da noite e vê-la cambaleando em minha direção pelo corredor no escuro, gemendo, o rosto todo contorcido e o cabelo parecendo uma peruca de palhaço maluco. Eu não conseguia parar de gritar ",shape=box,color=blue];
		2439 -> 2442;
	2442 [label="Quando a coisa piorava muito, ela ficava deitada na cama e gritava. Saíamos para a escola de manhã e, quando eu virava na nossa rua, meu coração despedaçava porque eu podia ouvi-la de dez casas de distância, ainda gritando, 8 horas depois ",shape=box,color=blue];
		2442 -> 2443;
	2443 [label="Nosso pai costumava falar sobre colocar um travesseiro no rosto dela. Achávamos que era brincadeira, porque é claro que ele estava brincando, aquela era a mãe dele ",shape=box,color=blue];
		2443 -> 2444;
		2443 -> 2445;
	2444 [label="E agora… muita coisa faz sentido",shape=box,color=red];
		2444 -> 2446;
	2445 [label="Eita…",shape=box,color=red];
		2445 -> 2446;
	2446 [label="Uma noite, ela estava gritando e os gritos simplesmente pararam. Eu levantei e fui até o quarto do Arthur. Ele estava acordado, lógico. Ficamos sentados juntos ouvindo tudo, e então ouvimos a porta do quarto dela fechar ",shape=box,color=blue];
		2446 -> 2447;
	2447 [label="Morreu dormindo, disse meu pai no dia seguinte ",shape=box,color=blue];
		2447 -> 2448;
		2447 -> 2449;
	2448 [label="E o seu medo é que… o Arthur faça o mesmo com você?",shape=box,color=red];
		2448 -> 2450;
	2449 [label="O Arthur não é o seu pai. Ele não teria agido dessa forma ",shape=box,color=red];
		2449 -> 2451;
	2450 [label="Se ele realmente pensasse que era o melhor a ser feito…",shape=box,color=blue];
		2450 -> 2452;
	2451 [label="Você não tem como saber disso. Se o Arthur realmente pensasse que era o melhor a ser feito…",shape=box,color=blue];
		2451 -> 2452;
	2452 [label="Não sei. Talvez. Realmente, parece muito menos provável agora que contei para alguém ",shape=box,color=blue];
		2452 -> 2453;
	2453 [label="+20 Chemistry",color=orange];
		2453 -> 2454;
