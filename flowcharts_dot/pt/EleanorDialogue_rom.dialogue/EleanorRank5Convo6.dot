digraph {
	2541 [label="EleanorRank5Convo6 begins.",color=orange];
		2541 -> 2542;
	2542 [label="Você pode notar que o shopping está um pouco diferente nesta manhã ",shape=box,color=blue];
		2542 -> 2543;
	2543 [label="Nada muito grande e óbvio. Apenas mais alguns sorrisos em alguns rostos. Uma risada aqui e ali. Uma pitadinha de felicidade no ar ",shape=box,color=blue];
		2543 -> 2544;
		2543 -> 2545;
	2544 [label="Você é a responsável por isso, não é?",shape=box,color=red];
		2544 -> 2547;
	2545 [label="Peraí, já volto [Encerra Conversa]",shape=box,color=red];
		2545 -> 2546;
	2547 [label="É a minha maneira de retribuir. Uma telepata pode enviar e receber sinais. Não precisa ser um jato de mangueira em uma pessoa. Pode ser mais como uma névoa fina borrifada em uma área ",shape=box,color=blue];
		2547 -> 2548;
	2546 [label="Chat ends.",color=orange];
	2548 [label="De onde você vem, existem irrigadores de gramado?",shape=box,color=blue];
		2548 -> 2549;
		2548 -> 2550;
	2549 [label="Temos a VERD-IE e drones como ela. Eles cuidavam das plantas da Zariman. É esse o tipo de coisa que você quer dizer?",shape=box,color=red];
		2549 -> 2551;
	2550 [label="Irriga… dores?",shape=box,color=red];
		2550 -> 2552;
	2551 [label="Algo assim ",shape=box,color=blue];
		2551 -> 2553;
	2552 [label="Sim, meu amor, irrigadores. Borrifadores de água para manter seu gramado agradável e úmido ",shape=box,color=blue];
		2552 -> 2554;
	2553 [label="Eu adorava os irrigadores de gramado quando era pequena. Eles eram mágicos. Quando o sol estava mais forte, era possível ver arco-íris neles. Você corria por eles e sentia um frio delicioso por toda parte ",shape=box,color=blue];
		2553 -> 2555;
	2554 [label="Também são ideais para segurar o rosto de seu irmão contra até ele gritar ",shape=box,color=blue];
		2554 -> 2555;
	2555 [label="\"A felicidade é um irrigador de gramado\". Uma mensagem perfeita para um cartão de felicitações ",shape=box,color=blue];
		2555 -> 2556;
	2556 [label="Você parece que tá de bom humor hoje. Fico feliz com isso ",shape=box,color=red];
		2556 -> 2557;
	2557 [label="Estou. E não vejo por que deveria guardar isso para mim. Então, estou espalhando o sentimento por todo o shopping ",shape=box,color=blue];
		2557 -> 2558;
		2557 -> 2559;
		2557 -> 2560;
	2558 [label="Isso não é tipo… drogar as pessoas?",shape=box,color=red];
		2558 -> 2561;
	2559 [label="Transmitir um sentimento positivo… por que não? Não consigo ver como isso seria diferente de tocar uma música ",shape=box,color=red];
		2559 -> 2562;
	2560 [label="Então, hoje é o dia que vou ver o Arthur sorrindo?",shape=box,color=red];
		2560 -> 2563;
	2561 [label="Ah… que ótimo… aqui estou eu, tentando ser a fada secreta da felicidade, espalhando alegria, e acabo sendo taxada como o duende maligno das drogas. Meu humor acabou de despencar ",shape=box,color=blue];
		2561 -> 2564;
	2562 [label="Ah! Uma ótima analogia!",shape=box,color=blue];
		2562 -> 2566;
	2563 [label="Talvez. Espero que sim. Ele teve que suportar tanta coisa ",shape=box,color=blue];
		2563 -> 2567;
	2564 [label="Tudo bem. Vou parar ",shape=box,color=blue];
		2564 -> 2565;
	2566 [label="Se a Aoi pode influenciar o ânimo por meio da música, eu posso fazer isso por meio das emoções, certo?",shape=box,color=blue];
		2566 -> 2568;
	2567 [label="Muita coisa mudou desde que você chegou. Não me refiro apenas a você e a mim. Me refiro a tudo. Até mesmo o shopping ",shape=box,color=blue];
		2567 -> 2568;
	2565 [label="Chat ends.",color=orange];
	2568 [label="Estou feliz que a Aoi me convenceu a ficar. Que o Sol a abençoe ",shape=box,color=blue];
		2568 -> 2569;
		2568 -> 2570;
	2569 [label="Peraí… ela fez o quê?",shape=box,color=red];
		2569 -> 2571;
	2570 [label="Peraí… acho que perdi uma parte da história",shape=box,color=red];
		2570 -> 2571;
	2571 [label="Eu não te contei?",shape=box,color=blue];
		2571 -> 2572;
	2572 [label="Ah… isso foi pouco tempo antes de você chegar. Estivemos fora o dia todo tentando acabar com uma colmeia de Tecnovírus. Tinha um climão no ar. Normalmente, o combate acaba com a raiva e nos deixa exaustos demais para atacar uns aos outros, mas esse dia foi diferente ",shape=box,color=blue];
		2572 -> 2573;
	2573 [label="Me lembro do Arthur falar algo como \"faremos tudo isso de novo amanhã\" e isso nos atingiu como uma marreta. Ninguém disse uma palavra no caminho de volta ao shopping ",shape=box,color=blue];
		2573 -> 2574;
		2573 -> 2575;
		2573 -> 2576;
	2574 [label="Uau… bela maneira de elevar o moral da equipe, Arthur ",shape=box,color=red];
		2574 -> 2579;
	2575 [label="Ele é tão encantador…",shape=box,color=red];
		2575 -> 2579;
	2576 [label="Ele carrega muita responsabilidade nos ombros… é complicado",shape=box,color=red];
		2576 -> 2577;
	2579 [label="Acho que ele estava apenas tentando fazer com que nos concentrássemos no trabalho. Mas eu me sentia acabada. O Arthur e a Aoi não se falavam, o Amir estava irritando tanto o Quincy que eu estava começando a temer pela vida dele, e a Lê estava me observando com aquele olhar de desaprovação sempre que podia ",shape=box,color=blue];
		2579 -> 2580;
	2577 [label="Sim. Normalmente, ele consegue esconder isso, mesmo quando está quase sem energia. Mas acho que ele não tinha mais nada ",shape=box,color=blue];
		2577 -> 2578;
	2580 [label="Passei muito tempo olhando em espelhos naquele dia. Fiquei imaginando meu reflexo me estrangulando e falando \"VOCÊ é o problema. Se não fosse por você, nada disso estaria acontecendo\"",shape=box,color=blue];
		2580 -> 2581;
		2580 -> 2582;
	2578 [label="Ele se esgotou tentando manter a equipe unida",shape=box,color=blue];
		2578 -> 2579;
	2581 [label="Pra variar… parece que todo mundo mexeu com a SUA cabeça",shape=box,color=red];
		2581 -> 2583;
	2582 [label="Isso parece ser o tipo de besteira que a Lê falaria ",shape=box,color=red];
		2582 -> 2584;
	2583 [label="Ah, não eram eles. Era eu. Todo sentimento reprimido de insegurança e ódio por mim mesma que eu estava guardando veio à tona naquele dia ",shape=box,color=blue];
		2583 -> 2585;
	2584 [label="Obrigada. Sei que você está me apoiando e isso significa muito para mim ",shape=box,color=blue];
		2584 -> 2586;
	2585 [label="Pensei para mim mesma: o que esse grupo precisa é de um bode expiatório ",shape=box,color=blue];
		2585 -> 2587;
	2586 [label="Já tinha escutado essa frase da Lê tantas vezes que acabei pensando comigo mesma: talvez ela tenha razão. Estou colocando todos em perigo ao ficar aqui ",shape=box,color=blue];
		2586 -> 2588;
	2587 [label="Um monstro. Alguém para culpar ",shape=box,color=blue];
		2587 -> 2588;
	2588 [label="Elaborei todo um plano. Fugiria durante a noite, me esconderia na cidade em algum lugar onde o Arthur nunca iria me encontrar e - essa é a parte de que mais me orgulho - continuaria ajudando à distância ",shape=box,color=blue];
		2588 -> 2589;
		2588 -> 2590;
	2589 [label="Acho que ele teria te encontrado. Ele é bem determinado ",shape=box,color=red];
		2589 -> 2591;
	2590 [label="O cenário mais plausível é que ele teria morrido tentando te encontrar ",shape=box,color=red];
		2590 -> 2592;
	2591 [label="Como? O Amir não consegue rastrear telepatia ",shape=box,color=blue];
		2591 -> 2593;
	2592 [label="Tentando me fazer sentir culpada, é?",shape=box,color=blue];
		2592 -> 2594;
	2593 [label="Eu seria uma humilde exilada. Eu me agacharia nos telhados, com uma aparência esvoaçante e determinada. Eu poderia informar sobre o acúmulo da Tecnovírus, avisar aos Hexa onde a Scaldra estava montando bloqueios na estrada e até mesmo agir como uma transmissora de comunicações de emergência. Toda vez que eu salvasse a pele de Lê, eu realmente faria ela sentir isso. Mesquinha? Sem dúvida ",shape=box,color=blue];
		2593 -> 2595;
	2594 [label="Nem se dê o trabalho. Já estou me sentindo muito mal ",shape=box,color=blue];
		2594 -> 2598;
	2595 [label="Escolhi o momento. Esperei até que o Amir estivesse dormindo. Depois, vesti um casaco longo e fui para a garagem o mais silenciosamente possível ",shape=box,color=blue];
		2595 -> 2596;
	2598 [label="Chat ends.",color=orange];
	2596 [label="A grade de segurança ligou sozinha. Eu me virei e lá estava ela, a Aoi ",shape=box,color=blue];
		2596 -> 2597;
	2597 [label="Conversamos a noite toda e choramos nos braços uma da outra. Ela também estava sofrendo. Profundamente. Quando o sol nasceu, eu decidi ficar ",shape=box,color=blue];
		2597 -> 2599;
		2597 -> 2600;
		2597 -> 2601;
	2599 [label="Ainda dá tempo de mudar de ideia ",shape=box,color=red];
		2599 -> 2602;
	2600 [label="A Aoi é maravilhosa. Fico feliz que ela tenha te ajudado ",shape=box,color=red];
		2600 -> 2604;
	2601 [label="Que sorte ",shape=box,color=red];
		2601 -> 2604;
	2602 [label="Seja qual for o impulso grotesco que te levou a escrever isso, espero que se engasgue nele ",shape=box,color=blue];
		2602 -> 2603;
	2604 [label="+20 Chemistry",color=orange];
		2604 -> 2605;
	2603 [label="Chat ends.",color=orange];
	2605 [label="Sim. Todos nós 6 precisávamos estar aqui na véspera do ano novo, eu acho. E você, é claro. A pessoa estranha batendo na porta, trazendo boa sorte ",shape=box,color=blue];
		2605 -> 2606;
	2606 [label="Chat ends.",color=orange];
}