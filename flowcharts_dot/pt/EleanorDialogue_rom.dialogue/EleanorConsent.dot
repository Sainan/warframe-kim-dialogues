		j3528729371 -> "Chat ends." [label=false,color=brown];
	j1134343555 [label="Acho que a única coisa que me incomoda nisso tudo é ter percebido seus pensamentos primeiro…",shape=box,color=blue];
		j1134343555 -> j2320614599;
	j2320614599 [label="Não é como se eu não soubesse que você iria vir pedir permissão educadamente… Aliás, olá.",shape=box,color=blue];
		j2320614599 -> j355261146;
	j355261146 [label="A resposta é um \"sim, claro\" feito com beicinho e braços cruzados, enquanto eu fico aqui sentada, sem pensar em você se divertindo com aquela coisa linda que vislumbrei em suas fantasias…",shape=box,color=blue];
		j355261146 -> j3428124160;
	j3428124160 [label="Que, agora, fazem parte das MINHAS fantasias, já que estou presa nesta época e lugar… muito obrigada por isso!",shape=box,color=blue];
		j3428124160 -> j2114193595;
	j2114193595 [label="Foi mal… eu realmente vim pedir sua permissão. Sei que não falamos sobre alguma coisa desse tipo antes, e eu queria ter certeza de que você concordaria com tudo",shape=box,color=red];
		j2114193595 -> j604858639;
	j604858639 [label="Claro que sim! Consigo ver essa pessoa na sua mente. E se você confia nela, eu também confio",shape=box,color=blue];
		j604858639 -> j3954946044;
	j3954946044 [label="Só fico triste por não ter a oportunidade de dar umas voltar por aí também.",shape=box,color=blue];
		j3954946044 -> j3383391561;
	j3383391561 [label="+20 Chemistry",color=orange];
		j3383391561 -> j4105062442;
	j4105062442 [label="Mas talvez eu possa vivenciar isso indiretamente através de você… essa sim é uma bela ideia",shape=box,color=blue];
		j4105062442 -> j298331240;
	j298331240 [label="Boolean EleanorConsentComplete is now true.",color=orange];
