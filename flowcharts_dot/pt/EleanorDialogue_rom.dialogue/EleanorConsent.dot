	3320 [label="Não é como se eu não soubesse que você iria vir pedir permissão educadamente… Aliás, olá.",shape=box,color=blue];
		3320 -> 3321;
	3321 [label="A resposta é um \"sim, claro\" feito com beicinho e braços cruzados, enquanto eu fico aqui sentada, sem pensar em você se divertindo com aquela coisa linda que vislumbrei em suas fantasias…",shape=box,color=blue];
		3321 -> 3322;
	3322 [label="Que, agora, fazem parte das MINHAS fantasias, já que estou presa nesta época e lugar… muito obrigada por isso!",shape=box,color=blue];
		3322 -> 3323;
	3323 [label="Foi mal… eu realmente vim pedir sua permissão. Sei que não falamos sobre alguma coisa desse tipo antes, e eu queria ter certeza de que você concordaria com tudo",shape=box,color=red];
		3323 -> 3324;
	3324 [label="Claro que sim! Consigo ver essa pessoa na sua mente. E se você confia nela, eu também confio",shape=box,color=blue];
