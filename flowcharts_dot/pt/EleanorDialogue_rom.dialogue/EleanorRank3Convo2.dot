		935 -> 938;
	934 [label="Você entende o que aconteceu com a Major Rusalka?",shape=box,color=blue];
		934 -> 936;
		934 -> 937;
	938 [label="Pois é. Eu não estava pronta para falar sobre isso naquela hora. Estou pronta agora, se você quiser ",shape=box,color=blue];
		938 -> 945;
	936 [label="Ela tava sendo controlada. A Indiferença tava manipulando ela ",shape=box,color=red];
		936 -> 939;
	937 [label="Tenho certeza que ela foi esvaziada e controlada como um… é… Warframe?",shape=box,color=red];
		937 -> 940;
	945 [label="Se você estiver de boas com isso ",shape=box,color=red];
		945 -> 946;
	939 [label="A \"Indiferença\"… é assim que você chama aquilo?",shape=box,color=blue];
		939 -> 941;
	940 [label="Esvaziada, sim ",shape=box,color=blue];
		940 -> 942;
	946 [label="Sim",shape=box,color=blue];
		946 -> 947;
	941 [label="Obrigada ",shape=box,color=blue];
		941 -> 943;
	942 [label="Mas o que quer que seja aquilo controlando ela não era como você ",shape=box,color=blue];
		942 -> 944;
	947 [label="Essa criatura, essa presença… é o que estamos enfrentando no final das contas. Sei disso agora ",shape=box,color=blue];
		947 -> 951;
	943 [label="Dar um nome para aquela coisa… sinto que recuperei um pouco do controle ",shape=box,color=blue];
		943 -> 948;
	944 [label="Qualquer coisa humana a respeito daquilo era como uma zombaria ",shape=box,color=blue];
		944 -> 949;
	951 [label="Por favor, me diz a verdade: você acredita que há alguma esperança?",shape=box,color=blue];
		951 -> 956;
		951 -> 957;
		951 -> 958;
	948 [label="Eu toquei essa coisa com minha mente. Pensei que estaria sondando a mente da Rusalka, mas… as camadas externas simplesmente cederam como uma placa de gesso molhada e esponjosa, e depois eu estava imersa nela. Afundando ",shape=box,color=blue];
		948 -> 950;
	949 [label="Era tão humano quanto um manequim de loja. Despedaçado ",shape=box,color=blue];
		949 -> 952;
	956 [label="A essa altura do campeonato? Não…",shape=box,color=red];
		956 -> 960;
	957 [label="Sinceramente? Eu… não sei ",shape=box,color=red];
		957 -> 961;
	958 [label="Sim",shape=box,color=red];
		958 -> 962;
	950 [label="Update boolean EleanorIndifference",color=orange];
		950 -> 951;
	952 [label="Eu toquei aquilo, sabe. Com minha mente. Eu estava tentando sondá-la, mas ela não estava lá ",shape=box,color=blue];
		952 -> 953;
	960 [label="Pelo menos você teve honestidade",shape=box,color=blue];
		960 -> 963;
	961 [label="Entendo ",shape=box,color=blue];
		961 -> 964;
	962 [label="Não me diga o motivo ",shape=box,color=blue];
		962 -> 965;
	953 [label="Eu sei o que você quer dizer, a gente chama aquilo de Indiferença ",shape=box,color=red];
		953 -> 954;
	963 [label="Certo. Deixa a esperança morrer ",shape=box,color=blue];
		963 -> 966;
	964 [label="Tem tanta coisa que não sabemos ",shape=box,color=blue];
		964 -> 967;
	965 [label="Apenas mantenha essa fé. Me deixa sentir isso ",shape=box,color=blue];
		965 -> 968;
	954 [label="Obrigada ",shape=box,color=blue];
		954 -> 955;
	966 [label="Continuarei lutando por pura teimosia ",shape=box,color=blue];
		966 -> 969;
	967 [label="Depois do que já aconteceu nesse ano, como podemos fazer planos sensatos de novo?",shape=box,color=blue];
		967 -> 970;
	968 [label="Por favor ",shape=box,color=blue];
		968 -> 971;
	955 [label="Dar um nome para aquela coisa… sinto que recuperei um pouco do controle ",shape=box,color=blue];
		955 -> 959;
	969 [label="Ódio. Raiva. Qualquer coisa ",shape=box,color=blue];
		969 -> 973;
	970 [label="Talvez essa esperança seja uma ilusão. Eu não sei ",shape=box,color=blue];
		970 -> 974;
	971 [label="Estendi a mão para a Rusalka e foi como se meus dedos tocassem seu rosto e o atravessassem. A máscara simplesmente caiu ",shape=box,color=blue];
		971 -> 975;
	959 [label="Update boolean EleanorIndifference",color=orange];
		959 -> 972;
	973 [label="Melhor do que a apatia. Melhor do que rendição dócil ",shape=box,color=blue];
		973 -> 978;
	974 [label="Eu realmente gostaria de um pouco agora ",shape=box,color=blue];
		974 -> 977;
	975 [label="O que estava embaixo era como…",shape=box,color=blue];
		975 -> 976;
	972 [label="Eu toquei essa coisa com minha mente. Pensei que estaria sondando a mente da Rusalka, mas… as camadas externas simplesmente cederam como uma placa de gesso molhada e esponjosa, e depois eu estava imersa nela. Afundando ",shape=box,color=blue];
		972 -> 976;
	978 [label="Estou preparada",shape=box,color=blue];
		978 -> 979;
	977 [label="Ah, bem. Então é isso. Mesmo que estejamos tropeçando na escuridão, pelo menos temos companhia",shape=box,color=blue];
		977 -> 980;
	976 [label="Existe uma palavra: \"intermação\". A palavra já foi usada para se referir a uma doença de loucura que afetava marinheiros. Eles se convenciam de que o mar verde ao redor deles não era água, mas grama ",shape=box,color=blue];
		976 -> 981;
	979 [label="Chat ends.",color=orange];
	980 [label="Chat ends.",color=orange];
	981 [label="Eles eram coagidos a pular do navio para os belos campos verdes e sair correndo por eles. Se um companheiro a bordo os impedisse, eles lutariam ",shape=box,color=blue];
		981 -> 982;
	982 [label="Eu pulei, esperando grama. Logo em seguida, estava perdida na escuridão congelante ",shape=box,color=blue];
		982 -> 983;
	983 [label="Update boolean EleanorIndifference2",color=orange];
		983 -> 984;
		983 -> 986;
	984 [label="Não acho que seja seguro você falar sobre aquilo dessa forma ",shape=box,color=red];
		984 -> 985;
	986 [label="Relaxa, tô aqui pra você. Continua",shape=box,color=red];
		986 -> 987;
	985 [label="Ah, merda ",shape=box,color=blue];
		985 -> 988;
	987 [label="Há um sentimento para o qual não existe uma palavra. Você olha para o mundo e simplesmente SABE que toda a normalidade - prédios, carros, pessoas, empregos, trabalho, rotina - é apenas uma crosta fina sobre um horror sem fundo e, se as pessoas percebessem isso, começariam a gritar e nunca mais parariam ",shape=box,color=blue];
		987 -> 989;
	988 [label="Acabei de me preparar psicologicamente para isso, e agora, o quê? Se eu falar do diabo, ele aparecerá?",shape=box,color=blue];
		988 -> 990;
	989 [label="Eu caí através da crosta fina ",shape=box,color=blue];
		989 -> 992;
	990 [label="Se você ouvir gritos durante a noite, sou eu ",shape=box,color=blue];
		990 -> 991;
	992 [label="Não era um vazio. Eu teria suportado isso. Isso continuou e continuou para sempre, mas não era apenas um espaço frio. Havia algo lá dentro comigo ",shape=box,color=blue];
		992 -> 993;
		992 -> 994;
		992 -> 995;
	991 [label="Chat ends.",color=orange];
	993 [label="Um olho?",shape=box,color=red];
		993 -> 997;
	994 [label="Um homem preso numa parede?",shape=box,color=red];
		994 -> 997;
	995 [label="O que era?",shape=box,color=red];
		995 -> 996;
	997 [label="Eu não sei. Mas ele sabia que eu estava lá. Estava CIENTE de mim. Como um elefante estaria ciente de uma mosca rastejando em seu olho ",shape=box,color=blue];
		997 -> 998;
	996 [label="+5 Chemistry",color=orange];
		996 -> 997;
	998 [label="Lembro de ter pensado \"nada tão grande deveria saber que eu existo\" ",shape=box,color=blue];
		998 -> 999;
	999 [label="Senti uma desconsideração tão grande por mim, uma indiferença tão monumental… que quis parar de existir na hora ",shape=box,color=blue];
		999 -> 1000;
		999 -> 1001;
	1000 [label="Aquilo… tem esse efeito nas pessoas",shape=box,color=red];
		1000 -> 1002;
	1001 [label="O que você fez?",shape=box,color=red];
		1001 -> 1002;
	1002 [label="Acho que eu poderia lidar com isso se aquilo me odiasse. Assim, eu teria algum valor, alguma importância. Mas ele me via como algo sem sentido, e eu vi o mesmo que ele via. Eu era um grão. Um nada ",shape=box,color=blue];
		1002 -> 1003;
	1003 [label="Tudo o que eu já fui, cada momento de carinho, cada risada, cada pedacinho da Eleanor Nightingale… se esvaiu naquela tempestade ",shape=box,color=blue];
		1003 -> 1004;
	1004 [label="Ele sentiu minha luz se dissipar e, juro, teve um pequeno tremor de satisfação. Como se estivesse contente por ser esmagada. Uma pulga sob um dedo",shape=box,color=blue];
		1004 -> 1005;
	1005 [label="Mas você voltou, né? Você ainda tá aqui. Você provou que aquela coisa tava errada ",shape=box,color=red];
		1005 -> 1006;
	1006 [label="Será?",shape=box,color=blue];
		1006 -> 1007;
	1007 [label="Aquela coisa continua por aí, não é?",shape=box,color=blue];
		1007 -> 1008;
		1007 -> 1009;
	1008 [label="Sim, continua. Mas você ainda tá aqui também ",shape=box,color=red];
		1008 -> 1011;
	1009 [label="As estrelas não param de brilhar só porque o espaço é grande, frio e escuro ",shape=box,color=red];
		1009 -> 1010;
	1011 [label="A Indiferença vence no final, colega, não importa quantas banalidades joguemos no abismo ",shape=box,color=blue];
		1011 -> 1012;
	1010 [label="Mas, um dia, elas vão parar de brilhar. A morte térmica do universo",shape=box,color=blue];
		1010 -> 1011;
	1012 [label="Esse é o problema de não enlouquecer. Você recebe a maldição da clareza de pensamento ",shape=box,color=blue];
		1012 -> 1013;
	1013 [label="Você sabe do que estou falando. Você poderia ter se despedaçado como um ovo de pardal ou dopado seu cérebro com drogas até não sentir mais nada. E teria doído menos do que… saber de tudo",shape=box,color=blue];
		1013 -> 1014;
	1014 [label="Eu… não entendo por que você ainda não se afastou dessa conversa ",shape=box,color=blue];
		1014 -> 1015;
		1014 -> 1016;
	1015 [label="Eu entendo a entropia. Talvez a Grande Indiferença seja o mesmo que isso. Talvez ela vença no final. Eu não sei. O que eu sei… é que não vou deixá-la vencer AGORA",shape=box,color=red];
		1015 -> 1017;
	1016 [label="Tô só esperando você se decidir. Quer seguir o caminho mais fácil e enlouquecer? Ou quer tirar a bunda daquele sofá e lutar?",shape=box,color=red];
		1016 -> 1018;
	1017 [label="Nós sobreviveremos a isso, juntos… se é que vamos sobreviver…",shape=box,color=red];
		1017 -> 1020;
	1018 [label="LUTAR COMO?!",shape=box,color=blue];
		1018 -> 1019;
	1020 [label="Então… você está tolerando meus lamentos de desespero existencial como uma tática de batalha? Você parece o Arthur ",shape=box,color=blue];
		1020 -> 1021;
	1019 [label="ISSO É TUDO O QUE VOCÊ E O ARTHUR CONSEGUEM ENTENDER?! LUTAR?!",shape=box,color=blue];
		1019 -> 1022;
	1021 [label="Na verdade… acredite se quiser… eu me importo com você ",shape=box,color=red];
		1021 -> 1027;
	1022 [label="SUA RESPOSTA PARA A FALTA DE SENTIDO PROFUNDO DA EXISTÊNCIA É \"ENCONTRE UMA MANEIRA DE DAR UM SOCO NELE\"?!",shape=box,color=blue];
		1022 -> 1023;
	1027 [label="Eu também me importo com você, camarada. Fazemos parte da mesma equipe. Já passamos por muita coisa ",shape=box,color=blue];
		1027 -> 1028;
	1023 [label="Não acredito que pensei que tínhamos algo em comum ",shape=box,color=blue];
		1023 -> 1024;
	1028 [label="Acho que é justo te avisar de que o bom navio da Eleanor pode acabar naufragando… seja no maldito mar ou no pântano negro da noite… e você não vai querer estar a bordo quando isso acontecer ",shape=box,color=blue];
		1028 -> 1030;
	1024 [label="Mais tolice minha ",shape=box,color=blue];
		1024 -> 1025;
