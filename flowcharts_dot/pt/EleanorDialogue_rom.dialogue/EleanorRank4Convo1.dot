		1435 -> 1438;
	1436 [label="\"Ah não, a infeliz garota que amávamos se tornou uma vampira sexy. Vamos matá-la para que, na morte, ela volte a ser pura e inocente\"",shape=box,color=blue];
		1436 -> 1437;
	1442 [label="Eu não deveria estar surpresa. É o final que as histórias te preparam",shape=box,color=blue];
