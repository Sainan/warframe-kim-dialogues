digraph {
	1389 [label="EleanorRank4Convo1 begins.",color=orange];
		1389 -> 1390;
	1390 [label="Tenho que te perguntar uma coisa, e acho que você não vai gostar. Acho que, no fundo, você devia saber que essa conversa teria de acontecer um dia, dada a minha condição ",shape=box,color=blue];
		1390 -> 1391;
	1391 [label="Eu confio em você e gosto de você, portanto, vou direto ao ponto, ok?",shape=box,color=blue];
		1391 -> 1392;
	1392 [label="Não tenho o direito de perguntar, na verdade, mas preciso saber ",shape=box,color=blue];
		1392 -> 1393;
	1393 [label="Se eu me transformasse completamente… se o Tecnovírus me tomasse e eu não fosse mais a Eleanor que você conhece… você me mataria?",shape=box,color=blue];
		1393 -> 1394;
