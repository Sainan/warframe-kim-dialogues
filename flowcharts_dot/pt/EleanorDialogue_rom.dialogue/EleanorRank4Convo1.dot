	1397 [label="Não vou responder isso",shape=box,color=red];
		1397 -> 1401;
	1398 [label="Hmm… bom começo. Você fez com que a questão fosse o que eu quero, em vez de ver minha vida como uma oportunidade de flexibilizar sua moral pessoal. Você acabou de me dizer que não se trata sobre você",shape=box,color=blue];
		1398 -> 1402;
