		1414 -> 1424;
	1415 [label="Acho que ele vai se comportar um pouco melhor de agora em diante. Nada como ameaçar a hospedeira para colocar o medo do Sol no parasita, não é?",shape=box,color=blue];
		1415 -> 1418;
	1422 [label="+20 Chemistry",color=orange];
