	2664 [label="Chat ends.",color=orange];
	2667 [label="Então… o Christopher ",shape=box,color=blue];
		2667 -> 2675;
	2666 [label="Check boolean EleanorChristopher1",color=orange];
		2666 -> 2671 [label=true,color=green];
		2666 -> 2668 [label=false,color=brown];
	2675 [label="Estou apegada à memória dele há anos. O Arthur também. Todos os anos, fazemos uma cerimônia. Mas não esse ano. Não consegui suportar ",shape=box,color=blue];
		2675 -> 2676;
	2671 [label="Para… resumir uma história muito longa e trágica… o Christopher morreu com bomba na beira da estrada antes de nos casarmos ",shape=box,color=blue];
		2671 -> 2672;
	2668 [label="Está na hora de eu te contar sobre o Christopher ",shape=box,color=blue];
		2668 -> 2669;
	2676 [label="Não sei se os fantasmas existem, mas é bem possível que existam, pois deixei que ele se tornasse um ",shape=box,color=blue];
		2676 -> 2677;
	2672 [label="Talvez eu te conte a história toda outro dia. Talvez não ",shape=box,color=blue];
		2672 -> 2673;
	2669 [label="O melhor amigo do Arthur. Estávamos noivos. Eu achava que estava apaixonada por ele ",shape=box,color=blue];
		2669 -> 2670;
	2677 [label="Não seja tão dura consigo mesma, você amava ele",shape=box,color=red];
		2677 -> 2678;
	2673 [label="Estou te contando tudo isso agora porque…",shape=box,color=blue];
		2673 -> 2674;
	2670 [label="Update boolean EleanorChristopher1",color=orange];
		2670 -> 2671;
	2678 [label="Ah, cara… eu PENSEI que sim. Eu amava ele, mas não sabia se estava apaixonada POR ele ou não ",shape=box,color=blue];
		2678 -> 2679;
	2674 [label="Update boolean EleanorChristopher2",color=orange];
		2674 -> 2675;
	2679 [label="Isso soa horrível, não é? Mas é verdade. Na época, isso não parecia importante. Então, ele morreu, e nossa história passou a ser sobre isso ",shape=box,color=blue];
		2679 -> 2680;
	2680 [label="Tudo o que eu admirava nele foi simplesmente ofuscado pela forma como ele morreu. Não consigo pensar nele sem sentir um nó no estômago ",shape=box,color=blue];
		2680 -> 2681;
	2681 [label="Não é justo. COM ELE. Ele merece mais do que isso ",shape=box,color=blue];
		2681 -> 2682;
		2681 -> 2683;
	2682 [label="Eu te entendo, de verdade. Escolhi me lembrar dos meus pais da maneira que eles mereciam ",shape=box,color=red];
		2682 -> 2684;
	2683 [label="O que aconteceu foi terrível, não tem como falar o contrário. Mas você não pode deixar que isso seja a única lembrança dele",shape=box,color=red];
		2683 -> 2684;
	2684 [label="Então… por que me sinto tão culpada?",shape=box,color=blue];
		2684 -> 2685;
	2685 [label="Por que sinto que deixar ele ir é o mesmo que o descartar?",shape=box,color=blue];
		2685 -> 2686;
		2685 -> 2688;
	2686 [label="Por que você carregou esse fardo por tanto tempo que não sabe como parar ",shape=box,color=red];
		2686 -> 2687;
	2688 [label="Porque você teme que ninguém mais vá te amar",shape=box,color=red];
		2688 -> 2689;
	2687 [label="Deuses… você tem toda a razão",shape=box,color=blue];
		2687 -> 2692;
	2689 [label="Check boolean EleanorDating",color=orange];
		2689 -> 2690 [label=true,color=green];
		2689 -> 2691 [label=false,color=brown];
	2692 [label="Somos inúteis em lidar com isso, digo minha gente. Nós reprimimos tudo. Fazemos uma cara de bravo e assobiamos nas trincheiras. Isso nos ajuda a superar, assim como ajudou nossos pais. Mas não sabemos como parar ",shape=box,color=blue];
		2692 -> 2693;
	2690 [label="É isso mesmo? Sou tão superficial assim?",shape=box,color=blue];
		2690 -> 2694;
	2691 [label="Duvido que até mesmo o Christopher me amaria em minha condição atual ",shape=box,color=blue];
		2691 -> 2696;
	2693 [label="O que devo fazer? Como posso me libertar?",shape=box,color=blue];
		2693 -> 2698;
	2694 [label="Sinto que não mereço NENHUM de vocês nesse momento",shape=box,color=blue];
		2694 -> 2695;
	2696 [label="Não… isso não é justo. Não estou sendo nenhum pouco justa com ele, estou?",shape=box,color=blue];
		2696 -> 2697;
	2698 [label="Check boolean LettieDiasdeMuertos",color=orange];
		2698 -> 2699 [label=true,color=green];
		2698 -> 2700 [label=true,color=green];
		2698 -> 2701 [label=true,color=green];
		2698 -> 2700 [label=false,color=brown];
		2698 -> 2701 [label=false,color=brown];
	2695 [label="Eu acho… eu quero que você tenha TUDO de mim. Não posso reter parte de mim em um estado de luto sem fim ",shape=box,color=blue];
		2695 -> 2698;
	2697 [label="Ele não iria querer atrapalhar minha felicidade. Ele era gentil ",shape=box,color=blue];
		2697 -> 2698;
	2699 [label="Olha… acho que a Lê poderia te ajudar nesse caso",shape=box,color=red];
		2699 -> 2702;
	2700 [label="Você poderia escrever uma carta pra ele ",shape=box,color=red];
		2700 -> 2703;
	2701 [label="Fala com o Arthur. Ele tá passando por esse sofrimento com você desde o começo ",shape=box,color=red];
		2701 -> 2704;
	2702 [label="A Lê?",shape=box,color=blue];
		2702 -> 2705;
	2703 [label="Parte de mim acha que essa é uma ideia estúpida. Ele não vai ler. Ele está morto. Mas…",shape=box,color=blue];
		2703 -> 2706;
	2704 [label="Sim, ele está. Talvez isso seja parte do problema. Sei que ele está chateado por eu não ter feito nossa pequena cerimônia de lembrança esse ano ",shape=box,color=blue];
		2704 -> 2707;
	2705 [label="Por que ela?",shape=box,color=blue];
		2705 -> 2708;
	2706 [label="Quanto mais penso… menos estúpido me parece ",shape=box,color=blue];
		2706 -> 2710;
	2707 [label="Eu só… tenho que me despedir do Christopher do MEU jeito dessa vez. De uma vez por todas ",shape=box,color=blue];
		2707 -> 2711;
	2708 [label="Ela tem muita experiência com isso, ela sabe homenagear os mortos muito bem",shape=box,color=red];
		2708 -> 2709;
	2710 [label="Sim. Eu vou fazer isso. Tem coisas que preciso dizer a ele. Coisas que nunca disse quando ele estava vivo. Talvez assim ele possa descansar ",shape=box,color=blue];
		2710 -> 2712;
	2711 [label="Para o Arthur, ele sempre será um irmão perdido, um soldado abatido. Esse é o luto que ele conhece e entende. Mas não é o meu ",shape=box,color=blue];
		2711 -> 2713;
	2709 [label="Tenho certeza que, se você pedir conselhos pra ela… respeitosamente… ela não vai te falar não",shape=box,color=red];
		2709 -> 2720;
	2712 [label="Obrigada por me ouvir, e pelo conselho ",shape=box,color=blue];
		2712 -> 2714;
	2713 [label="Não consigo mais fazer isso do jeito do Arthur. Acho que… se eu disser isso, ele entenderá ",shape=box,color=blue];
		2713 -> 2718;
	2720 [label="…",shape=box,color=blue];
		2720 -> 2721;
	2714 [label="+20 Chemistry",color=orange];
		2714 -> 2715;
	2718 [label="+10 Chemistry",color=orange];
		2718 -> 2719;
	2721 [label="Sim ",shape=box,color=blue];
		2721 -> 2722;
	2715 [label="Nunca, jamais, esquecerei disso ",shape=box,color=blue];
		2715 -> 2716;
	2719 [label="Muito obrigada ",shape=box,color=blue];
		2719 -> 2717;
	2722 [label="A hora é agora ",shape=box,color=blue];
		2722 -> 2723;
	2716 [label="Chat ends.",color=orange];
	2717 [label="Chat ends.",color=orange];
	2723 [label="+20 Chemistry",color=orange];
		2723 -> 2724;
	2724 [label="Acho que preciso me desapegar de MUITAS coisas ",shape=box,color=blue];
		2724 -> 2725;
	2725 [label="Me deixa falar com ela. Se ela me mandar ir à merda, então que assim seja. Mas pelo menos eu tentei, não é?",shape=box,color=blue];
		2725 -> 2726;
	2726 [label="Vale a pena tentar. A Lê não é tão insensível quanto as pessoas pensam ",shape=box,color=red];
		2726 -> 2727;
	2727 [label="Aposto que sim. Vivendo assim, fazendo o que fazemos todos os dias, todos nós erguemos paredes. Só nos esquecemos de colocar portas nelas ",shape=box,color=blue];
		2727 -> 2728;
	2728 [label="Obrigada por bater sua adorável cabeça contra minha parede ",shape=box,color=blue];
