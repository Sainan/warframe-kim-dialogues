		1101 -> 1107;
	1102 [label="Apenas um? Você VIU o Amir?",shape=box,color=blue];
		1102 -> 1103;
	1086 [label="Isso é coisa de Vírus do Herói. Você acaba pensando ser o personagem principal na história de todo mundo ",shape=box,color=blue];
		1086 -> 1087;
	1087 [label="Não há uma grande história aqui, camarada. Nenhum autor no céu acrescentando pequenos detalhes de enredo na minha vida para dar um efeito dramático ",shape=box,color=blue];
		1087 -> 1088;
	1107 [label="Posso te contar uma história?",shape=box,color=blue];
		1107 -> 1108;
	1103 [label="Ele tem seus momentos sombrios, mas esse garoto é uma inspiração para todos nós ",shape=box,color=blue];
		1103 -> 1104;
	1088 [label="Consigo dar sentido às coisas estúpidas que acontecem comigo. Sou a artista, não o Sol ou a Lua, ou qualquer uma das estrelas deles ",shape=box,color=blue];
		1088 -> 1089;
	1108 [label="Manda bala",shape=box,color=red];
		1108 -> 1109;
	1104 [label="Comparado com andar por aí com cara emburrada, prefiro a atitude do Amir a qualquer momento ",shape=box,color=blue];
		1104 -> 1105;
