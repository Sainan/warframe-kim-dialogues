digraph {
	1032 [label="EleanorRank3Convo3 begins.",color=orange];
		1032 -> 1033;
	1033 [label="E aí, Eleanor? Como vão as coisas?",shape=box,color=red];
		1033 -> 1034;
	1034 [label="Muito bem. Acabei de raspar minha língua ",shape=box,color=blue];
		1034 -> 1035;
		1034 -> 1036;
	1035 [label="Uh… raspar?",shape=box,color=red];
		1035 -> 1037;
	1036 [label="Peraí… como assim?",shape=box,color=red];
		1036 -> 1038;
	1037 [label="Sim, raspar. Esses pedaços nodosos continuam brotando nela. Acho que eles costumavam ser papilas gustativas. Se eu não cortar, eles ficam muito compridos e se contorcem. Como uma anêmona-do-mar ",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="Não é muito diferentes de cortar as unhas ",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="Desculpa. Eu realmente deveria ter te avisado sobre isso ",shape=box,color=blue];
		1039 -> 1041;
	1040 [label="Talvez mais estranho. Mas, ainda assim, não é nada mais do que cortar de uma proeminência indesejada ",shape=box,color=blue];
		1040 -> 1041;
	1041 [label="Todos os outros sabem que devem estar a pelo menos 100 metros de distância quando a Eleanor entra no banheiro com uma faca de cozinha e uma garrafa de álcool cirúrgico ",shape=box,color=blue];
		1041 -> 1042;
	1042 [label="Espere um pouco e, eventualmente, eu voltarei com sangue no queixo e um saco plástico com coisas parecidas com carne de caranguejo dentro. Tentei usar as sobras para fazer hambúrgueres uma vez, mas ninguém quis",shape=box,color=blue];
		1042 -> 1043;
	1043 [label="Desculpa, você queria a experiência completa de meia hora de bate-papo erótico, ou só 5 minutos?",shape=box,color=blue];
		1043 -> 1044;
		1043 -> 1045;
	1044 [label="Para de tentar me espantar",shape=box,color=red];
		1044 -> 1046;
	1045 [label="Então, falando dessa sua língua aí…",shape=box,color=red];
		1045 -> 1048;
	1046 [label="Ei, sou eu que tenho metade de uma enguia enfiada na minha goela. Perdão por tentar ter um senso de humor sobre isso",shape=box,color=blue];
		1046 -> 1047;
	1048 [label="Prossiga",shape=box,color=blue];
		1048 -> 1049;
	1047 [label="Chat ends.",color=orange];
	1049 [label="Quanto de… controle… você tem sobre ela?",shape=box,color=red];
		1049 -> 1050;
	1050 [label="Certo. Espera um segundo ",shape=box,color=blue];
		1050 -> 1051;
	1051 [label="ese tanto",shape=box,color=blue];
		1051 -> 1052;
	1052 [label="cmo to me saindu",shape=box,color=blue];
		1052 -> 1053;
		1052 -> 1054;
	1053 [label="Ah, não… me diz que você não tá fazendo o que eu tô pensando que é…",shape=box,color=red];
