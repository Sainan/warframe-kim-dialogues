		1089 -> 1091 [label=false,color=brown];
		1089 -> 1092 [label=false,color=brown];
	1109 [label="Quando eu tinha 18 anos, vários de nós saímos para comemorar o fim das provas. Estávamos todos em um carro minúsculo. E eu, deitada no colo de três pessoas no banco de trás ",shape=box,color=blue];
		1109 -> 1110;
	1105 [label="+10 Chemistry",color=orange];
		1105 -> 1106;
	1090 [label="Você me fez lembrar disso. Nem sei se você se lembra. Eu estava sentindo pena de mim mesma e você me fez sair dessa ",shape=box,color=blue];
		1090 -> 1091;
		1090 -> 1092;
