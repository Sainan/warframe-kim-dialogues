		1069 -> 1071;
	1063 [label="eh booom dmais haha",shape=box,color=blue];
		1063 -> 1064;
	1070 [label="Essa maldita coisa parece ter vontade própria. Quando penso nela, consigo controlá-la. Mas quando não penso, ela parece reagir às minhas emoções ",shape=box,color=blue];
		1070 -> 1072;
	1071 [label="O tempo todo. Ela se regenera fácil ",shape=box,color=blue];
		1071 -> 1074;
	1064 [label="Update boolean EleanorFlirt",color=orange];
		1064 -> 1065;
		1064 -> 1069;
	1072 [label="A possibilidade mais terrível é que ela não seja movida por MIM, mas por minha conexão latente com o Tecnovírus. Prefiro não considerar essa opção ",shape=box,color=blue];
		1072 -> 1073;
	1074 [label="A única vez que a arranquei completamente com uma mordida, ela voltou a crescer. Estou presa com essa coisa ",shape=box,color=blue];
		1074 -> 1075;
	1065 [label="Kkkkkkkk certo. Acho que minha próxima pergunta seria… você já perdeu o controle dela?",shape=box,color=red];
		1065 -> 1070;
	1073 [label="No entanto, odeio quando ela atrapalha meus dentes. A única vez que a arranquei completamente com uma mordida, ela voltou a crescer. Estou presa com essa coisa ",shape=box,color=blue];
		1073 -> 1075;
	1075 [label="Pelo menos não está ficando mais longa. Só estou tirando pedaços salientes ",shape=box,color=blue];
		1075 -> 1076;
		1075 -> 1077;
	1076 [label="Você gostaria de voltar a ser o que era? Antes do Entrati te mudar?",shape=box,color=red];
		1076 -> 1078;
	1077 [label="Como você se sente em relação a isso? Tipo… de verdade",shape=box,color=red];
		1077 -> 1079;
	1078 [label="Uh, sim? Em um piscar de olhos. Mas não posso, então qual o sentido de ficar pensando nisso?",shape=box,color=blue];
		1078 -> 1080;
	1079 [label="Eu não teria escolhido isso. Mas não odeio ela. Parece que ela sempre esteve lá ",shape=box,color=blue];
		1079 -> 1081;
	1080 [label="Tudo o que acontece com a gente é por um motivo ",shape=box,color=red];
		1080 -> 1083;
	1081 [label="Sinto falta do som de minha própria voz. Odeio o fato de que não posso mais cantar ",shape=box,color=blue];
		1081 -> 1082;
	1083 [label="Sim. Só que, às vezes, o motivo é: um desgraçado maléfico fez algo ruim ",shape=box,color=blue];
		1083 -> 1084;
	1082 [label="Mas a língua? Talvez você ache difícil de acreditar, mas às vezes é reconfortante. Nunca mais ficarei desarmada ",shape=box,color=blue];
		1082 -> 1099;
		1082 -> 1100;
	1084 [label="Portanto, se está dizendo que tudo sempre funciona da melhor forma, como se houvesse um grande plano ou propósito para tudo, nem me coloque nesse meio. Eu não acredito nisso ",shape=box,color=blue];
		1084 -> 1085;
	1099 [label="Então… o que você mais gosta em ser como você é agora?",shape=box,color=red];
		1099 -> 1101;
	1100 [label="Fico feliz que pelo menos UM de vocês esteja tentando encontrar um lado positivo…",shape=box,color=red];
		1100 -> 1102;
