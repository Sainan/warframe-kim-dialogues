		1116 -> 1117;
	1117 [label="A mesma dor me inundou, mas não era mais incapacitante. Era como combustível, me dando energia, me irritando ",shape=box,color=blue];
		1117 -> 1118;
	1118 [label="Me levantei, realoquei meu ombro e parti o veículo blindado com minhas próprias mãos ",shape=box,color=blue];
