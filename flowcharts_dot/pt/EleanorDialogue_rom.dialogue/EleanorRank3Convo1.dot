digraph {
	808 [label="EleanorRank3Convo1 begins.",color=orange];
		808 -> 809;
		808 -> 810;
	809 [label="Eleanor, tudo bem se eu te perguntar sobre o lance da telepatia?",shape=box,color=red];
		809 -> 811;
	810 [label="Então, como é poder dar uma espiada na cabeça de todo mundo?",shape=box,color=red];
		810 -> 813;
	811 [label="Você sempre pode perguntar as coisas, desde que você pergunte com educação ",shape=box,color=blue];
		811 -> 812;
	813 [label="Como é que é?",shape=box,color=blue];
		813 -> 814;
	812 [label="Algumas pessoas acham isso muito difícil ",shape=box,color=blue];
		812 -> 817;
		812 -> 818;
	814 [label="É isso que você acha que eu faço? Que fico casualmente violando a privacidade de outras pessoas?",shape=box,color=blue];
		814 -> 815;
	817 [label="Você escuta os pensamentos das pessoas sem tentar? Ou sempre precisa fazer um esforço pra entrar na cabeça delas?",shape=box,color=red];
		817 -> 819;
	818 [label="É tipo um interruptor? Ou isso tá sempre no \"ligado\"?",shape=box,color=red];
		818 -> 819;
	815 [label="Se é isso que você pensa de mim, então eu duvido que tenhamos muito o que conversar ",shape=box,color=blue];
		815 -> 816;
	819 [label="Sim, para ambos. Se eu simplesmente sentar e \"ouvir\", posso perceber monólogos internos e sentimentos fortes ",shape=box,color=blue];
		819 -> 820;
	816 [label="Chat ends.",color=orange];
	820 [label="A parte mais difícil é filtrar as coisas BERRANTES que eu não quero saber ",shape=box,color=blue];
		820 -> 821;
	821 [label="Nem sempre consigo experimentar sentimentos como se fossem de outra pessoa. Quanto mais pré-verbal for o sentimento, mais difícil será discernir entre \"eles\" e \"eu\" ",shape=box,color=blue];
		821 -> 822;
	822 [label="Permissão para mergulhar nos domínios do \"excesso de informação\"?",shape=box,color=blue];
		822 -> 823;
		822 -> 824;
		822 -> 825;
	823 [label="Já que você atiçou minha curiosidade…",shape=box,color=red];
		823 -> 827;
	824 [label="Permissão concedida ",shape=box,color=red];
		824 -> 828;
	825 [label="É… talvez depois [Encerrar Conversa]",shape=box,color=red];
		825 -> 826;
	827 [label="Saúdo sua coragem ",shape=box,color=blue];
		827 -> 829;
	828 [label="Continue lendo por sua conta e risco ",shape=box,color=blue];
		828 -> 829;
	826 [label="Chat ends.",color=orange];
	829 [label="Pouco tempo após tomarmos as injeções do Entrati, eu achei que estava com algum tipo de infecção secundária na bexiga. Cara… eu estava subindo e descendo do sofá como um ioiô. Até pedi para a Lê me dar suco de amora e água mineral ",shape=box,color=blue];
		829 -> 830;
	830 [label="Acontece que eu estava apenas sentindo as necessidades biológicas naturais de seis pessoas. Meu sistema nervoso naturalmente presumiu que eles eram meus ",shape=box,color=blue];
		830 -> 831;
		830 -> 832;
	831 [label="O que foi pior? Saber que você não estava catastroficamente doente, ou…",shape=box,color=red];
		831 -> 833;
	832 [label="Deve ter sido um alívio descobrir a verdade ",shape=box,color=red];
		832 -> 834;
	833 [label="Bem, EU ESTOU catastroficamente doente. Não vamos medir palavras. Mas eu prefiro ser sobrecarregada com telepatia do que infecção urinária",shape=box,color=blue];
		833 -> 835;
	834 [label="Aprendi a construir muros em torno da minha mente depois desse incidente. A Lê às vezes encontra medicamentos que podem desligar todo o meu lado telepático, mas só por algumas horas. Tenho um estoque deles, mas não tomo a menos que eu realmente precise dormir ",shape=box,color=blue];
		834 -> 835;
	835 [label="Esse é um talento muito útil, esse é o problema. O Arthur insiste em ver isso como um recurso estratégico ",shape=box,color=blue];
		835 -> 836;
		835 -> 837;
	836 [label="E a privacidade das pessoas? Isso não é ruim pra moral?",shape=box,color=red];
		836 -> 838;
	837 [label="Mas… e se alguém não quiser ter a cabeça invadida?",shape=box,color=red];
		837 -> 839;
	838 [label="É horrível para a moral ",shape=box,color=blue];
		838 -> 840;
	839 [label="Mesmo que eu insista que posso controlar isso, você acha que eles acreditariam em mim?",shape=box,color=blue];
		839 -> 840;
	840 [label="Nenhum de nós é molenga. Estamos acostumados a viver em condições difíceis. Este lugar é um hotel 5 estrelas comparado a um quartel normal do exército britânico",shape=box,color=blue];
		840 -> 841;
	841 [label="Todos tomam banho juntos, todos comem juntos, etc. Todos se acostumam uns com os outros. Todos precisam se acostumar",shape=box,color=blue];
		841 -> 842;
	842 [label="Mas, como o Arthur diria, tem um maldito limite ",shape=box,color=blue];
		842 -> 843;
	843 [label="Então, como você lida com isso?",shape=box,color=red];
		843 -> 844;
	844 [label="Só não deixo que eles saibam o quanto de suas vidas interiores eu escuto, vejo e sinto. Não fico sondando sem ser convidada, independentemente do que a Lê pense que eu faço",shape=box,color=blue];
		844 -> 845;
	845 [label="Às vezes, um deles tem um pensamento e imediatamente pensa: \"será que ela me ouviu pensando isso\"? É mais gentil deixá-los se perguntando. O que eles não sabem não pode machucá-los ",shape=box,color=blue];
		845 -> 846;
		845 -> 847;
	846 [label="Você… já ouviu algum dos MEUS pensamentos?",shape=box,color=red];
		846 -> 848;
	847 [label="Então… o que você viu na minha cabeça?",shape=box,color=red];
		847 -> 848;
	848 [label="Como eu disse, não vou confirmar ou negar nada ",shape=box,color=blue];
		848 -> 849;
	849 [label="Devo dizer, neste momento, que tem outra razão importante pela qual eu guardo essa merda para mim mesma ",shape=box,color=blue];
		849 -> 851;
	851 [label="Prossiga…",shape=box,color=red];
		851 -> 850;
	850 [label="Então… o Arthur e eu estávamos nas ruas, invadindo um esconderijo de Scaldra, e ele estava tendo um dia terrível. Ele não estava atirando direito, dirigindo como um pato bêbado em carrinho bate-bate, sem conseguir nem rodar a espada",shape=box,color=blue];
		850 -> 852;
	852 [label="Naturalmente, eu falei para ele se recompor. Imediatamente, ele começou a me culpar. Me falou que estou sempre agindo de forma tão superior, que não entendo a pressão do comando, que se eu tivesse a menor ideia do que ele tem de enfrentar DIARIAMENTE, eu me curvaria… todas essas besteiras de vitimismo ",shape=box,color=blue];
		852 -> 853;
	853 [label="Check boolean EleanorHeroVirus",color=orange];
		853 -> 854 [label=true,color=green];
		853 -> 855 [label=false,color=brown];
	854 [label="Lembra do Vírus do Herói que eu te falei?",shape=box,color=blue];
		854 -> 856;
	855 [label="Tenho essa teoria que chamo de Vírus do Herói ",shape=box,color=blue];
		855 -> 858;
	856 [label="É… caso terminal para ele",shape=box,color=blue];
		856 -> 857;
	858 [label="Os moleques acham que as histórias que lhes foram contadas são como o mundo realmente funciona. Eles acham que são os heróis e tudo gira em torno deles ",shape=box,color=blue];
		858 -> 859;
	857 [label="Tudo era sobre o Arthur ",shape=box,color=blue];
		857 -> 861;
	859 [label="O Arthur tem um dos piores casos de Vírus do Herói que já vi ",shape=box,color=blue];
		859 -> 860;
	861 [label="Então, eu retruquei: \"você sabe que eu percebo quando você está pensando na Aoi, certo\"?",shape=box,color=blue];
		861 -> 862;
	860 [label="Update boolean EleanorHeroVirus",color=orange];
		860 -> 861;
	862 [label="Poxa…",shape=box,color=red];
		862 -> 863;
	863 [label="Pois é",shape=box,color=blue];
		863 -> 864;
	864 [label="Não me orgulho muito disso",shape=box,color=blue];
		864 -> 865;
	865 [label="Mesmo ele sendo meu irmão, isso foi uma coisa idiota de se fazer. Nunca mais faço isso ",shape=box,color=blue];
		865 -> 866;
	866 [label="Como ele reagiu?",shape=box,color=red];
		866 -> 867;
	867 [label="Não gosto do fato de você querer saber disso…",shape=box,color=blue];
		867 -> 868;
	868 [label="Agora estou me perguntando se você está gostando da ideia de ver o Arthur sendo humilhado ",shape=box,color=blue];
		868 -> 869;
	869 [label="Por favor, que não seja isso. Estou começando a gostar de você, e esse é o tipo de coisa que eu seria incapaz de perdoar",shape=box,color=blue];
		869 -> 870;
		869 -> 871;
		869 -> 872;
	870 [label="Tô perguntando porque gosto do cara ",shape=box,color=red];
		870 -> 873;
	871 [label="Cacetada… não era minha intenção. Eu só queria saber como alguém assim reage ao ser confrontado desse jeito",shape=box,color=red];
		871 -> 875;
	872 [label="Eu tô adorando isso. Parece que o Arthur mereceu essa ",shape=box,color=red];
		872 -> 877;
	873 [label="Ok, compreensível. Desculpa por me precipitar ",shape=box,color=blue];
		873 -> 874;
	875 [label="Eu não apenas o confrontei. Eu MACHUQUEI ele ",shape=box,color=blue];
		875 -> 876;
	877 [label="Ah, entendi ",shape=box,color=blue];
		877 -> 878;
	874 [label="Ele desabou. Eu me senti horrível ",shape=box,color=blue];
		874 -> 879;
	876 [label="O Arthur está acostumado a ser retrucado. Basta olhar para o Quincy!",shape=box,color=blue];
		876 -> 880;
	878 [label="O Arthur é um pé no saco ",shape=box,color=blue];
		878 -> 881;
	879 [label="Eu tinha quebrado algo importante entre nós. Espera um pouco… preciso te dizer algo para você entender isso",shape=box,color=blue];
		879 -> 885;
	880 [label="Mas todos nós sabemos que o Arthur tem barreiras. Ele age como se fosse impossível machucá-lo ",shape=box,color=blue];
		880 -> 884;
	881 [label="Mas quando estou tentando falar com você sobre algo pelo qual me sinto culpada…",shape=box,color=blue];
		881 -> 882;
	885 [label="Quando éramos pequenos, uns garotos mais velhos roubaram o brinquedo favorito do Arthur e jogaram ele na fogueira do solstício.",shape=box,color=blue];
		885 -> 886;
	884 [label="Pude sentir como ele estava chocado e confuso. Ele achava que estava seguro perto de mim. Não mais ",shape=box,color=blue];
		884 -> 893;
	882 [label="Ah, esquece",shape=box,color=blue];
		882 -> 883;
	886 [label="Ainda consigo vê-lo inclinado, assistindo ao plástico borbulhando e pingando em sua calça camuflada ",shape=box,color=blue];
		886 -> 887;
		886 -> 888;
	893 [label="Check boolean DrifterSiblingYes",color=orange];
		893 -> 895 [label=true,color=green];
		893 -> 894 [label=false,color=brown];
	883 [label="Chat ends.",color=orange];
	887 [label="É… não sinto saudade nenhuma de ser criança",shape=box,color=red];
		887 -> 889;
	888 [label="As maravilhas da infância…",shape=box,color=red];
		888 -> 889;
	895 [label="Sei bem como é isso. Eu… já tive uma irmã.",shape=box,color=red];
		895 -> 897;
	894 [label="Check boolean DrifterSiblingNo",color=orange];
		894 -> 895 [label=true,color=green];
		894 -> 896 [label=true,color=green];
		894 -> 895 [label=false,color=brown];
		894 -> 896 [label=false,color=brown];
	889 [label="Os meninos riram e disseram que o Arthur deveria ficar feliz. O brinquedo dele agora tinha ido para o Salão dos Heróis, como os guerreiros costumavam fazer. Eu queria matá-los. Pequenos cretinos ",shape=box,color=blue];
		889 -> 890;
	897 [label="Update boolean DrifterSiblingYes",color=orange];
		897 -> 898;
	896 [label="Parece que você magoou ele bastante ",shape=box,color=red];
		896 -> 900;
	890 [label="O Arthur não queria que os meninos o vissem chorar, e não queria chorar na frente do meu pai, então a única pessoa que restou fui eu. Sua irmã mais velha de merda ",shape=box,color=blue];
		890 -> 891;
	898 [label="É horrível, não é? Ficamos tão acostumados com o hábito, colocando uns aos outros para baixo, atiçando e zoando…",shape=box,color=blue];
		898 -> 899;
	900 [label="Sim, eu o magoei. Pedi desculpas, prometi que nunca mais faria algo assim, mas ainda me sinto péssima por causa disso ",shape=box,color=blue];
		900 -> 901;
	891 [label="Estou te contando isso porque foi nisso que o Arthur pensou naquele momento em que fiz a cagada. Ele se lembrava de sentir que era seguro chorar na minha frente se ele realmente precisasse… e agora?",shape=box,color=blue];
		891 -> 892;
	899 [label="É quase reconfortante. Então, um dia, você chega no limite e não pode voltar atrás ",shape=box,color=blue];
		899 -> 901;
	901 [label="É um golpe baixo",shape=box,color=red];
		901 -> 902;
	892 [label="Agora, não era mais seguro chorar para mim",shape=box,color=blue];
		892 -> 893;
	902 [label="SIM ",shape=box,color=blue];
		902 -> 903;
	903 [label="Você me ENTENDE. Eu amo isso! Um golpe baixo",shape=box,color=blue];
		903 -> 904;
	904 [label="Sabe aquela situação em que você está discutindo com alguém e, depois que tudo termina, você pensa na coisa exata que deveria ter dito?",shape=box,color=blue];
		904 -> 905;
	905 [label="Eu não tenho mais isso. Tenho um botão mágico escrito \"vitória\". Tudo o que eu teria de fazer é olhar para o cérebro deles, pegar o que eles mais se envergonham e esfregar na cara deles ",shape=box,color=blue];
		905 -> 906;
	906 [label="E NÃO POSSO FAZER ISSO, não importa o quanto eu queira. Porque eu tenho que ser uma \"boa pessoa\" ",shape=box,color=blue];
		906 -> 907;
		906 -> 908;
	907 [label="Não se trata de ser santa, Eleanor. Não se trata nem mesmo de ser heroína. Se trata de não ser pau no cu",shape=box,color=red];
		907 -> 909;
	908 [label="Todo mundo aqui tá tentando fazer a coisa certa. Isso é realmente difícil pra você?",shape=box,color=red];
		908 -> 910;
	909 [label="Toda pessoa tem um limite que ela não ultrapassa, e esse é o seu. Eu respeito isso ",shape=box,color=red];
		909 -> 912;
	910 [label="Ah, céus… isso é o que eu ganho por exibir minhas virtudes, não é?",shape=box,color=blue];
		910 -> 911;
	912 [label="Obrigada ",shape=box,color=blue];
		912 -> 913;
	911 [label="Desculpa, eu estava esperando simpatia. Mas vou aceitar o balde de água fria ",shape=box,color=blue];
		911 -> 914;
	913 [label="Não estou buscando simpatia aqui, de verdade",shape=box,color=blue];
		913 -> 915;
	914 [label="Não é como se eu fosse a única pessoa que tem que manter seus poderes sob controle, não é? Somos todos bombas-relógio esperando para explodir ",shape=box,color=blue];
		914 -> 920;
	915 [label="Eu só queria que outra pessoa entendesse. Sinceramente, estou um pouco surpresa com o QUANTO você entende ",shape=box,color=blue];
		915 -> 916;
	920 [label="+10 Chemistry",color=orange];
		920 -> 919;
	916 [label="Você não precisava me ouvir, mas fico feliz que tenha ouvido ",shape=box,color=blue];
		916 -> 917;
	919 [label="Agradeço pela conversa ",shape=box,color=blue];
		919 -> 921;
	917 [label="Minha cabeça é um show de aberrações. Acho que você pode entender por que não estendo o tapete de boas-vindas para qualquer pessoa",shape=box,color=blue];
		917 -> 922;
	921 [label="Chat ends.",color=orange];
	922 [label="+20 Chemistry",color=orange];
		922 -> 918;
	918 [label="Sempre espero que as pessoas saiam correndo e gritando. Mas você não… ainda não. Me pergunto, por quê? Mais uma vez, obrigada. Por tudo ",shape=box,color=blue];
		918 -> 923;
	923 [label="Chat ends.",color=orange];
}