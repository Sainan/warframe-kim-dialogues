	2911 [label="Diferentes babacas, a mesma piada, a vida toda. Agora é o Vitor fazendo isso",shape=box,color=blue];
		2911 -> 2914;
	2912 [label="Ele levou tudo tão a sério. Semanas e semanas ensaiando e então, naquela noite, desistiu de tudo. Se escondeu nas coxias e se recusou a sair",shape=box,color=blue];
		2912 -> 2915;
