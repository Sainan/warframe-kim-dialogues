digraph {
	"EleanorRank6Convo3 begins." [color=orange];
		"EleanorRank6Convo3 begins." -> j2323700587;
	j2323700587 [label="Não sei se você percebeu, mas algo absolutamente fantástico aconteceu",shape=box,color=blue];
		j2323700587 -> j441442962;
	j441442962 [label="O Arthur está cantando de novo. Graças aos Deuses",shape=box,color=blue];
		j441442962 -> j2121831586;
		j441442962 -> j1866227468;
		j441442962 -> j1664935050;
	j2121831586 [label="Por que ele parou?",shape=box,color=red];
		j2121831586 -> j4108296214;
	j1866227468 [label="Não sou muito fã, mas se faz bem pra ele...",shape=box,color=red];
		j1866227468 -> j4108371520;
	j1664935050 [label="Fico feliz. Ele é bom nisso",shape=box,color=red];
		j1664935050 -> j4107992406;
	j4108296214 [label="Ansiedade de palco, simples assim",shape=box,color=blue];
		j4108296214 -> j4153593361;
	j4108371520 [label="Te agradeço por falar isso de uma forma tão gentil",shape=box,color=blue];
		j4108371520 -> j1704080584;
	j4107992406 [label="Não é mesmo?",shape=box,color=blue];
		j4107992406 -> j3898763287;
	j4153593361 [label="Difícil acreditar que alguém tão corajoso quanto o Arthur pudesse ficar assustado assim",shape=box,color=red];
		j4153593361 -> j1679650972;
	j1704080584 [label="É importante pra mim saber que você se importa",shape=box,color=blue];
		j1704080584 -> j573644814;
	j3898763287 [label="Quando penso no esforço que foi necessário para ele ficar de pé diante de uma multidão e cantar...",shape=box,color=blue];
		j3898763287 -> j4226324232;
	j1679650972 [label="Qual é a rachadura da armadura dele?",shape=box,color=red];
		j1679650972 -> j1601846186;
	j573644814 [label="Principalmente pelos motivos que fizeram ele desistir de cantar. Motivos que você não poderia imaginar",shape=box,color=blue];
		j573644814 -> j3926095716;
		j573644814 -> j2733566056;
	j4226324232 [label="Digo… a primeira vez que ele realmente teve um ataque de nervos",shape=box,color=blue];
		j4226324232 -> j3146739345;
	j1601846186 [label="É o nome, esse é o maldito problema",shape=box,color=blue];
		j1601846186 -> j2690676338;
	j3926095716 [label="Falta de apoio moral?",shape=box,color=red];
		j3926095716 -> j3023100196;
	j2733566056 [label="Muitas plateias complicadas?",shape=box,color=red];
		j2733566056 -> j3023100196;
	j3146739345 [label="Concerto de Solstício de Natal nos anos 80. Pensa no nosso homenzinho de calças curtas cantando o solo de \"Brilhante Orvalho da Manhã\"",shape=box,color=blue];
		j3146739345 -> j1657575359;
		j3146739345 -> j229952820;
	j2690676338 [label="\"Ah, seu nome é Nightingale, não é? Hahaha, cante uma canção para nós então\"",shape=box,color=blue];
		j2690676338 -> j3262251266;
	j3023100196 [label="Era sempre a mesma piada... mais por causa disso",shape=box,color=blue];
		j3023100196 -> j1601846186;
	j1657575359 [label="Isso é um visual e tanto",shape=box,color=red];
		j1657575359 -> j2347059690;
	j229952820 [label="Não conheço essa",shape=box,color=red];
		j229952820 -> j2022382629;
	j3262251266 [label="Diferentes babacas, a mesma piada, a vida toda. Agora é o Vitor fazendo isso",shape=box,color=blue];
		j3262251266 -> j3050492141;
	j2347059690 [label="Ele levou tudo tão a sério. Semanas e semanas ensaiando e então, naquela noite, desistiu de tudo. Se escondeu nas coxias e se recusou a sair",shape=box,color=blue];
		j2347059690 -> j3715333804;
		j2347059690 -> j4153593361;
	j2022382629 [label="Bom... eu até cantaria para você, mas não tenho certeza de que tipo de barulho sairia se eu tentasse",shape=box,color=blue];
		j2022382629 -> j1869995178;
	j3050492141 [label="+5 Chemistry",color=orange];
		j3050492141 -> j262068550;
	j3715333804 [label="Como você convenceu ele?",shape=box,color=red];
		j3715333804 -> j4059718107;
	j1869995178 [label="Maldito Tecnovírus. Tentei cantar \"Parabéns Pra Você\" para a Aoi e soou como um sapo-boi preso num triturador de papel",shape=box,color=blue];
		j1869995178 -> j285751398;
	j262068550 [label="Pra ser sincera, tenho orgulho que o Arthur tenha coragem de cantar",shape=box,color=blue];
		j262068550 -> "Chat ends.";
	j4059718107 [label="Literalmente chutei a bunda dele. Não me orgulho disso, mas precisava ser feito",shape=box,color=blue];
		j4059718107 -> j1114750474;
	j285751398 [label="Sinto muito, deve ser difícil não poder mais cantar",shape=box,color=red];
		j285751398 -> j469467688;
	"Chat ends." [color=orange];
	j1114750474 [label="Acontece que ele não teve todo aquele trabalho pelo bem dos nossos pais ou para deixar a Sra. Henshaw feliz",shape=box,color=blue];
		j1114750474 -> j4040156413;
	j469467688 [label="Ah, não é uma perda tão grande assim, eu não cantava bem mesmo",shape=box,color=blue];
		j469467688 -> j379109927;
	j4040156413 [label="Ele queria cantar porque amava cantar. Mas quando os holofotes focaram nele, ele travou",shape=box,color=blue];
		j4040156413 -> j851200286;
		j4040156413 -> j1679650972;
	j379109927 [label="A minha melhor performance foi gritando a letra do Shag Cannons no meu quarto. Eu queria estar na banda da Mandy Jellicoe porque eu tinha uma queda por ela",shape=box,color=blue];
		j379109927 -> j1335059910;
	j851200286 [label="Talvez ele só precisasse se lembrar do quanto amava fazer aquilo",shape=box,color=red];
		j851200286 -> j3339298797;
	j1335059910 [label="Foi aí que meu pai bateu na porta e ameaçou lavar minha boca com ácido se ele ouvisse mais daquela porcaria",shape=box,color=blue];
		j1335059910 -> j209497158;
	j3339298797 [label="A versão mais feliz do Arthur é quando ele consegue esquecer do Arthur. Quando consegue deixar o fantasma de si mesmo para trás e simplesmente VIVER",shape=box,color=blue];
		j3339298797 -> j1402877706;
	j209497158 [label="(Não sei se você tem \"punk\" de onde veio, mas não saber cantar é mais um requisito do que um obstáculo)",shape=box,color=blue];
		j209497158 -> j3173299501;
		j209497158 -> j3874329421;
	j1402877706 [label="Cerveja ajuda",shape=box,color=blue];
		j1402877706 -> j393169979;
	j3173299501 [label="Não temos punk, mas temos Skeg",shape=box,color=red];
		j3173299501 -> j83614677;
	j3874329421 [label="O que aconteceu com a banda?",shape=box,color=red];
		j3874329421 -> j154455566;
	j393169979 [label="E certamente não faz mal que o Velimir se comporte como o pai que o Arthur teria escolhido, se pudesse encomendar um de um catálogo",shape=box,color=blue];
		j393169979 -> j3634101445;
		j393169979 -> j243537025;
	j83614677 [label="Não ouse colocar algo assim no chat sem dar mais detalhes",shape=box,color=blue];
		j83614677 -> j2734959600;
	j154455566 [label="Eles nem chegaram ao estágio \"show de graça no bar da praça\"",shape=box,color=blue];
		j154455566 -> j2251529523;
	j3634101445 [label="Não culpo ele",shape=box,color=red];
		j3634101445 -> j1824499289;
	j243537025 [label="Pensei que Velimir e Minerva poderiam ser parecidos demais com seus pais verdadeiros",shape=box,color=red];
		j243537025 -> j1288896493;
	j2734959600 [label="Exijo que você me conte o que é Skeg",shape=box,color=blue];
		j2734959600 -> j535506222;
	j2251529523 [label="Correu o boato de que a Mandy planejava cuspir na plateia e foi o fim de tudo… uma pena",shape=box,color=blue];
		j2251529523 -> j3761450558;
		j2251529523 -> j2490752744;
	j1824499289 [label="O Arthur tem carregado aquele ursinho de pelúcia há meses. Agora Velimir aparece. É como se o destino tivesse pressentido um buraco em forma de urso na vida do Arthur...",shape=box,color=blue];
		j1824499289 -> j3407803157;
	j1288896493 [label="É, pois é. Talvez as brigas façam ele se sentir em casa",shape=box,color=blue];
		j1288896493 -> j386227816;
	j535506222 [label="Porque parece algo vendido em saquinhos pequenos em uma das propriedades Ludston",shape=box,color=blue];
		j535506222 -> j2167716018;
		j535506222 -> j3637628683;
	j3761450558 [label="Quem tem medo de um pouquinho de cuspe?",shape=box,color=red];
		j3761450558 -> j26341419;
	j2490752744 [label="Cuspir? Parece a ideia de uma noite perfeita para o Tecnócito Coda",shape=box,color=red];
		j2490752744 -> j555286285;
	j3407803157 [label="+5 Chemistry",color=orange];
		j3407803157 -> j1036925758;
	j386227816 [label="+5 Chemistry",color=orange];
		j386227816 -> j1431273446;
	j2167716018 [label="É tipo música, só que feita batendo em canos. E em saídas de ar. E em capacetes Corpus. E em qualquer outra coisa que você encontre pra bater, na verdade",shape=box,color=red];
		j2167716018 -> j701450877;
	j3637628683 [label="É só barulho inútil. Só os Órfãos dos Dutos gostam disso ",shape=box,color=red];
		j3637628683 -> j43863327;
	j26341419 [label="+5 Chemistry",color=orange];
		j26341419 -> j1154206334;
	j555286285 [label="Era uma outra época. Quando o punk era punk de verdade",shape=box,color=blue];
		j555286285 -> j490496590;
	j1036925758 [label="Desculpa… não é da minha conta especular. Só estou feliz que ele esteja feliz",shape=box,color=blue];
		j1036925758 -> "Chat ends.";
	j1431273446 [label="É estranho ver o que te faz sentir saudades de casa, né?",shape=box,color=blue];
		j1431273446 -> "Chat ends.";
	j701450877 [label="É coisa dos Órfãos dos Dutos",shape=box,color=red];
		j701450877 -> j1896358740;
	j43863327 [label="Hm… \"barulho inútil\", já ouvi isso antes",shape=box,color=blue];
		j43863327 -> j2764516160;
	j1154206334 [label="Eu definitivamente não estava, isso eu posso te garantir",shape=box,color=blue];
		j1154206334 -> j490496590;
	j490496590 [label="Eu só… pensei que seria legal se ela pudesse me ver agora. Acho que ela iria gostar dessa minha versão",shape=box,color=blue];
		j490496590 -> j754413666;
	j1896358740 [label="+5 Chemistry",color=orange];
		j1896358740 -> j2834636459;
	j2764516160 [label="Não acho que nada seja tão inútil que não possa ser a trilha sonora da juventude de alguém",shape=box,color=blue];
		j2764516160 -> j1840093775;
	j754413666 [label="Deuses, olha isso, fiquei toda sentimental e nostálgica",shape=box,color=blue];
		j754413666 -> j2284335506;
	j2834636459 [label="Hmm… parece música de sobrevivência. Eu adoraria ouvir se você pudesse gravar um pouco para mim",shape=box,color=blue];
		j2834636459 -> j944849403;
