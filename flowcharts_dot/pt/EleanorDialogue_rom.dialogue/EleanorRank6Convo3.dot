		2905 -> 2908;
	2906 [label="Concerto do Solstício de Natal nos anos 80. Pensa no nosso homenzinho de calças curtas no solinho do \"Brilhante Orvalho da Manhã\"",shape=box,color=blue];
		2906 -> 2909;
		2906 -> 2910;
