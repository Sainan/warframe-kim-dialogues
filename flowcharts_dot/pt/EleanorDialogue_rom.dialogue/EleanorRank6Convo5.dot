digraph {
	3068 [label="EleanorRank6Convo5 begins.",color=orange];
		3068 -> 3069;
	3069 [label="Estava aqui refletindo, como de costume…",shape=box,color=blue];
		3069 -> 3070;
	3070 [label="Quando esse ciclo acabar de vez, independente de como isso aconteça, o que acontecerá com a Terra?",shape=box,color=blue];
		3070 -> 3071;
	3071 [label="Sei que o ano 2000 já ficou no passado pra você, mas sabe me dizer ALGUMA COISA sobre o que aguarda nosso pequeno planeta?",shape=box,color=blue];
		3071 -> 3072;
		3071 -> 3074;
	3072 [label="Infelizmente, coisa boa não é",shape=box,color=red];
		3072 -> 3073;
	3074 [label="Sinceramente, não acho que eu deveria te contar isso",shape=box,color=red];
		3074 -> 3076;
	3073 [label="Pelo pouco que sei, o Tecnovírus se tornou um problema global. O povo resolveu isso com armas nucleares… ou pelo menos tentaram",shape=box,color=red];
		3073 -> 3075;
	3076 [label="Se eu te avisar sobre o que vai acontecer, você pode tentar mudar isso, e pode ser que eu até deixe de existir",shape=box,color=red];
		3076 -> 3078;
	3075 [label="É assim que começa a primeira das \"Guerras Radioativas\"",shape=box,color=red];
		3075 -> 3077;
	3078 [label="Pode me chamar de egoísta, mas eu gosto de existir",shape=box,color=red];
		3078 -> 3080;
	3077 [label="E eventualmente… o planeta fica tão ferrado que os Orokin querem sair dele e ir viver em outro lugar, né?",shape=box,color=blue];
		3077 -> 3079;
	3080 [label="Ah claro, como se tudo o que você fez não tenha mudado NADINHA do futuro, né?",shape=box,color=blue];
		3080 -> 3082;
	3079 [label="O que nos leva a… toda a situação da Zariman, que é onde VOCÊ entra na história",shape=box,color=blue];
		3079 -> 3081;
	3082 [label="Você pode ter mudado os pequenos detalhes, mas os grandes permaneceram praticamente os mesmos",shape=box,color=blue];
		3082 -> 3085;
	3081 [label="É até estranho pensar que tudo começa aqui, nesta cidade",shape=box,color=blue];
		3081 -> 3083;
		3081 -> 3084;
	3085 [label="Acho que o Universo sabe o que faz",shape=box,color=blue];
		3085 -> 3088;
	3083 [label="Talvez seja por isso que este ano é tão importante",shape=box,color=red];
		3083 -> 3086;
	3084 [label="Sim, de Holvânia à Zariman 10-0… é um caminho e tanto",shape=box,color=red];
		3084 -> 3087;
	3088 [label="Tem mais coisas acontecendo do que somente partículas cegas vagando por aí",shape=box,color=blue];
		3088 -> 3091;
		3088 -> 3092;
	3086 [label="+5 Chemistry",color=orange];
		3086 -> 3089;
	3087 [label="Espera aí…",shape=box,color=blue];
		3087 -> 3090;
	3091 [label="Discordo, não acho que o Universo tem mente",shape=box,color=red];
		3091 -> 3095;
	3092 [label="Concordo, se algo tão humano quanto a emoção pode moldar o Void…",shape=box,color=red];
		3092 -> 3096;
	3089 [label="Faz sentido. Se a bomba nuclear do Albrecht tivesse explodido, isso significaria que não haveria Tecnovírus. Consequentemente, a Terra não seria destruída, não haveria necessidade de escapar, não haveria a 1º viagem ao Void e… não haveria a Indiferença?!",shape=box,color=blue];
		3089 -> 3093;
	3090 [label="Se a sua era a Zariman 10-0, o que aconteceu com as outras 9?",shape=box,color=blue];
		3090 -> 3094;
	3095 [label="De uma perspectiva muito grande ou muito pequena, ele pode até ter, mas nunca no nível em que você e eu existimos",shape=box,color=blue];
		3095 -> 3099;
	3096 [label="+5 Chemistry",color=orange];
		3096 -> 3100;
	3093 [label="Acho que vou ver se a Lê tem um pouco de café pra me dar…",shape=box,color=blue];
		3093 -> 3097;
	3094 [label="Naves não tripuladas, pelo que me lembro ",shape=box,color=red];
		3094 -> 3098;
	3099 [label="Se temos a capacidade de criar significados e somos parte do Universo, então, por definição, o Universo significa algo",shape=box,color=blue];
		3099 -> 3102;
	3100 [label="Exatamente, o sentido que damos às coisas não é somente uma ilusão confortável",shape=box,color=blue];
		3100 -> 3103;
	3097 [label="Chat ends.",color=orange];
	3098 [label="Ou cápsulas de terraformação pilotadas por Cephalons. Eles fizeram MUITOS experimentos",shape=box,color=red];
