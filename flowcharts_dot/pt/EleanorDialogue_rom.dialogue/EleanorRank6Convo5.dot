digraph {
	"EleanorRank6Convo5 begins." [color=orange];
		"EleanorRank6Convo5 begins." -> j3739095144;
	j3739095144 [label="Estava aqui refletindo, como de costume…",shape=box,color=blue];
		j3739095144 -> j1381524407;
	j1381524407 [label="Quando esse ciclo acabar de vez, independente de como isso aconteça, o que acontecerá com a Terra?",shape=box,color=blue];
		j1381524407 -> j1801940238;
	j1801940238 [label="Sei que o ano 2000 já ficou no passado pra você, mas sabe me dizer ALGUMA COISA sobre o que aguarda nosso pequeno planeta?",shape=box,color=blue];
		j1801940238 -> j3653531972;
		j1801940238 -> j2528946884;
	j3653531972 [label="Infelizmente, coisa boa não é",shape=box,color=red];
		j3653531972 -> j2453662933;
	j2528946884 [label="Sinceramente, não acho que eu deveria te contar isso",shape=box,color=red];
		j2528946884 -> j1970488803;
	j2453662933 [label="Pelo pouco que sei, o Tecnovírus se tornou um problema global. O povo resolveu isso com armas nucleares… ou pelo menos tentaram",shape=box,color=red];
		j2453662933 -> j2344627378;
	j1970488803 [label="Se eu te avisar sobre o que vai acontecer, você pode tentar mudar isso, e pode ser que eu até deixe de existir",shape=box,color=red];
		j1970488803 -> j2708052776;
	j2344627378 [label="É assim que começa a primeira das \"Guerras Radioativas\"",shape=box,color=red];
		j2344627378 -> j479172659;
	j2708052776 [label="Pode me chamar de egoísta, mas eu gosto de existir",shape=box,color=red];
		j2708052776 -> j482142959;
	j479172659 [label="E eventualmente… o planeta fica tão ferrado que os Orokin querem sair dele e ir viver em outro lugar, né?",shape=box,color=blue];
		j479172659 -> j140158665;
	j482142959 [label="Ah claro, como se tudo o que você fez não tenha mudado NADINHA do futuro, né?",shape=box,color=blue];
		j482142959 -> j3812261055;
	j140158665 [label="O que nos leva a… toda a situação da Zariman, que é onde VOCÊ entra na história",shape=box,color=blue];
		j140158665 -> j139481867;
	j3812261055 [label="Você pode ter mudado os pequenos detalhes, mas os grandes permaneceram praticamente os mesmos",shape=box,color=blue];
		j3812261055 -> j2277252349;
	j139481867 [label="É até estranho pensar que tudo começa aqui, nesta cidade",shape=box,color=blue];
		j139481867 -> j2449026061;
		j139481867 -> j2323384021;
	j2277252349 [label="Acho que o Universo sabe o que faz",shape=box,color=blue];
		j2277252349 -> j4155773503;
	j2449026061 [label="Talvez seja por isso que este ano é tão importante",shape=box,color=red];
		j2449026061 -> j1786800828;
	j2323384021 [label="Sim, de Holvânia à Zariman 10-0… é um caminho e tanto",shape=box,color=red];
		j2323384021 -> j410939269;
	j4155773503 [label="Tem mais coisas acontecendo do que somente partículas cegas vagando por aí",shape=box,color=blue];
		j4155773503 -> j1394952433;
		j4155773503 -> j1229185273;
	j1786800828 [label="+5 Chemistry",color=orange];
		j1786800828 -> j2399088765;
	j410939269 [label="Espera aí…",shape=box,color=blue];
		j410939269 -> j982546073;
	j1394952433 [label="Discordo, não acho que o Universo tem mente",shape=box,color=red];
		j1394952433 -> j4231671245;
	j1229185273 [label="Concordo, se algo tão humano quanto a emoção pode moldar o Void…",shape=box,color=red];
		j1229185273 -> j2594527001;
	j2399088765 [label="Faz sentido. Se a bomba nuclear do Albrecht tivesse explodido, isso significaria que não haveria Tecnovírus. Consequentemente, a Terra não seria destruída, não haveria necessidade de escapar, não haveria a 1º viagem ao Void e… não haveria a Indiferença?!",shape=box,color=blue];
		j2399088765 -> j3229166132;
	j982546073 [label="Se a sua era a Zariman 10-0, o que aconteceu com as outras 9?",shape=box,color=blue];
		j982546073 -> j2576554740;
	j4231671245 [label="De uma perspectiva muito grande ou muito pequena, ele pode até ter, mas nunca no nível em que você e eu existimos",shape=box,color=blue];
		j4231671245 -> j1894362769;
	j2594527001 [label="+5 Chemistry",color=orange];
		j2594527001 -> j3217073273;
	j3229166132 [label="Acho que vou ver se a Lê tem um pouco de café pra me dar…",shape=box,color=blue];
		j3229166132 -> "Chat ends.";
	j2576554740 [label="Naves não tripuladas, pelo que me lembro ",shape=box,color=red];
		j2576554740 -> j134798754;
	j1894362769 [label="Se temos a capacidade de criar significados e somos parte do Universo, então, por definição, o Universo significa algo",shape=box,color=blue];
		j1894362769 -> j2148145970;
	j3217073273 [label="Exatamente, o sentido que damos às coisas não é somente uma ilusão confortável",shape=box,color=blue];
		j3217073273 -> j505239811;
	"Chat ends." [color=orange];
	j134798754 [label="Ou cápsulas de terraformação pilotadas por Cephalons. Eles fizeram MUITOS experimentos",shape=box,color=red];
		j134798754 -> j1779215092;
	j2148145970 [label="+5 Chemistry",color=orange];
		j2148145970 -> j335781512;
	j505239811 [label="Mas sempre tem aquela voz sussurrando pra você, insistindo que tudo é insignificante",shape=box,color=blue];
		j505239811 -> j894636532;
	j1779215092 [label="Eles chamavam isso de \"O Projeto\"",shape=box,color=red];
		j1779215092 -> j672450573;
	j335781512 [label="Nossa existência é tão real quanto prótons e supernovas. Gostemos ou não, todos somos importantes",shape=box,color=blue];
		j335781512 -> "Chat ends.";
	j894636532 [label="Talvez a grande questão cósmica não seja entre o Bem e o Mal, mas… entre ter um significado e ser insignificante?",shape=box,color=blue];
		j894636532 -> "Chat ends.";
	j672450573 [label="+5 Chemistry",color=orange];
		j672450573 -> j4052003088;
	j4052003088 [label="É um nome melhor do que \"Operação Levar Nossos Traseiros Irresponsáveis Ao Novo Planeta, Onde Poderemos Fazer Mais Merda\"",shape=box,color=blue];
