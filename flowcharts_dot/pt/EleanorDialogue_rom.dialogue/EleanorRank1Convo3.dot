		157 -> 160;
	158 [label="Ninguém sabe ao certo o que é o Void. É uma dimensão, um campo energético, um atalho no espaço, um buraco onde os Orokin se esconderam…",shape=box,color=red];
		158 -> 161;
	159 [label="Desculpa, são velhos hábitos meus",shape=box,color=blue];
		159 -> 162;
	160 [label="Isso",shape=box,color=blue];
		160 -> 163;
	161 [label="Por mais fascinante que tudo isso seja, sua resposta foi técnica demais. Estava mais interessada no que isso significa para você, já que você parece viver e respirar isso, literalmente",shape=box,color=blue];
		161 -> 164;
		161 -> 165;
		161 -> 166;
	162 [label="Me perdoe, não sou mais uma jornalista, e você não é o objeto de uma reportagem. Só estou profundamente interessada nisso",shape=box,color=blue];
		162 -> 164;
