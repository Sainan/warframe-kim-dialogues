	191 [label="É, tenho certeza que tem alguma coisa lá no Void. A Indiferença, o olho que tudo vê, o \"Homem na Parede\". Quando digo que o Void fez algo, quero dizer que ESSA COISA fez isso",shape=box,color=red];
