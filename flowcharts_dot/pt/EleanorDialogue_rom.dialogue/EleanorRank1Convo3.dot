		163 -> 164;
		163 -> 165;
		163 -> 166;
	164 [label="O Void me dá a capacidade de fazer coisas impossíveis. Projetar raios de energia, me tornar imaterial e coisas boas assim. De onde venho, é o que faz os Warframes serem capazes de fazer o que fazem",shape=box,color=red];
		164 -> 201;
	165 [label="O Void enlouqueceu meus pais",shape=box,color=red];
		165 -> 167;
