	2989 [label="Foi assim: \"ei, e se deuses existirem mesmo?\"",shape=box,color=blue];
		2989 -> 2990;
	2990 [label="Fiquei toda mole por um instante. Precisei até de um pouco de água fria no rosto pra me recuperar",shape=box,color=blue];
		2990 -> 2991;
		2990 -> 2992;
		2990 -> 2993;
	2991 [label="O que tem de estranho nisso? Me parece uma pergunta bem básica",shape=box,color=red];
		2991 -> 2994;
	2992 [label="Mas… o povo acha que os deuses não existem? Tenho quase certeza que a Lê acha que existem sim",shape=box,color=red];
		2992 -> 2995;
	2993 [label="É, essa é uma dúvida terrível",shape=box,color=red];
		2993 -> 2996;
	2994 [label="Ah, é por isso que adoro falar com você sobre essas coisas",shape=box,color=blue];
		2994 -> 2997;
	2995 [label="Ah, qual é, ninguém acredita de verdade que deuses existem. Não do mesmo jeito que… sei lá, que as mesas e cadeiras existem",shape=box,color=blue];
		2995 -> 2998;
	2996 [label="Né? E se toda vez que você pensou que o universo estava te enviando uma mensagem… ele realmente estivesse?",shape=box,color=blue];
		2996 -> 2999;
	2997 [label="Sua vida é tão fantasticamente absurda que deuses serem reais é uma especulação tão natural pra você quanto recheios de pizza pra gente",shape=box,color=blue];
		2997 -> 3000;
	2998 [label="Deuses de verdade são como poços de aldeias e banheiros ao ar livre, é algo que as pessoas COSTUMAVAM ter ",shape=box,color=blue];
		2998 -> 3001;
	2999 [label="Imagina só… tudo nas mãos desses malditos imortais que estavam no comando somente porque as coisas eram assim, e não porque eles fizeram por merecer",shape=box,color=blue];
		2999 -> 3002;
	3000 [label="Você pode até já ter conhecido um deus, se é que a Indiferença conta como um",shape=box,color=blue];
		3000 -> 3003;
	3001 [label="Hoje em dia, isso não passa de símbolos, metáforas… ou coisa do tipo",shape=box,color=blue];
		3001 -> 3004;
		3001 -> 3005;
	3002 [label="E o mais bizarro é que era assim que as pessoas realmente viviam. Essa era a realidade delas, todos os dias de suas vidas",shape=box,color=blue];
		3002 -> 3006;
	3003 [label="Você me lembrou de uma coisa lá na Zariman… a primeira vez que conheci a Indiferença",shape=box,color=red];
		3003 -> 3007;
	3004 [label="Será que as pessoas só tão com menos medo disso agora?",shape=box,color=red];
