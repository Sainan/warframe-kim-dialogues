		2982 -> 2985;
	2983 [label="A Lótus enviou ela pro Void, perto do fim da Guerra Ancestral. A criança trouxe ela de volta recentemente",shape=box,color=red];
		2983 -> 2986;
	2984 [label="Transformei algumas delas em pinturas",shape=box,color=blue];
		2984 -> 2985;
	2985 [label="Ah, deixa pra lá, não vamos perder o fio da meada",shape=box,color=blue];
		2985 -> 2987;
	2986 [label="Não faço ideia de como ficou o mar",shape=box,color=red];
		2986 -> 2988;
	2987 [label="Voltando aos pensamentos aleatórios no banho, recebi um bem cabuloso hoje de manhã",shape=box,color=blue];
