	3005 [label="Achei que o Sol e a Lua fossem os seus deuses",shape=box,color=red];
		3005 -> 3009;
	3006 [label="Pra eles, os deuses eram tão reais quanto o clima, e se importavam tanto quanto a chuva se importa com o povo",shape=box,color=blue];
		3006 -> 3010;
	3007 [label="Eu não sabia o que era isso na época, claro, mas lembro o que ela me disse ",shape=box,color=red];
		3007 -> 3011;
	3008 [label="É… acho que pode ser isso",shape=box,color=blue];
		3008 -> 3012;
	3009 [label="Eles são, mas também são somente corpos celestiais ",shape=box,color=blue];
		3009 -> 3013;
	3010 [label="Sinceramente, não parece muito diferente da vida sob o domínio do Orokin",shape=box,color=red];
		3010 -> 3014;
	3011 [label="Tava escuro, então eu disse que ela podia usar minha lanterna, e ela sorriu pra mim e disse: \"obrigada, criança. Acho que vou pegar sim\"",shape=box,color=red];
		3011 -> 3015;
	3012 [label="Acho que sei o motivo também",shape=box,color=blue];
		3012 -> 3016;
	3013 [label="Assim como a Britânia é um país, com nome, identidade e tudo mais, ela não passa de um monte de terra e pedra. Ela pode ser as 2 coisas ao mesmo tempo",shape=box,color=blue];
		3013 -> 3017;
	3014 [label="Imortais, mesquinhos… no comando só \"porque sim\"…",shape=box,color=red];
