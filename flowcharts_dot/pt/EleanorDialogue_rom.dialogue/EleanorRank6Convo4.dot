		3019 -> 3023;
	3020 [label="Afinal, o que são o Sol e a Lua? Antes que alguém pensasse neles como Deuses? Eles eram LUZES",shape=box,color=blue];
		3020 -> 3024;
		3020 -> 3025;
	3021 [label="Hoje em dia, ninguém acha que o Sol ou a Lua literalmente engravidaram alguma mulher humana, ou foram a mãe do filho de algum humano e fizeram um Rei",shape=box,color=blue];
