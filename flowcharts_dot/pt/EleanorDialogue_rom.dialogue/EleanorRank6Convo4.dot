digraph {
	"EleanorRank6Convo4 begins." [color=orange];
		"EleanorRank6Convo4 begins." -> j4239413148;
	j4239413148 [label="Vem cá, já teve aquela sensação de estar tomando banho e, de repente, um sussurro estranho faz uma pergunta que você nunca pensou em se fazer antes?",shape=box,color=blue];
		j4239413148 -> j3278864050;
		j4239413148 -> j1684686848;
		j4239413148 -> j1688898053;
	j3278864050 [label="Nunca [Encerrar Conversa]",shape=box,color=red];
		j3278864050 -> "Chat ends.";
	j1684686848 [label="Tipo \"o que será que as pessoas na Terra pensaram quando a Lua reapareceu no céu do nada?\"",shape=box,color=red];
		j1684686848 -> j3438878366;
	j1688898053 [label="Tipo \"Operador! Já pensou em empalhar seu Kubrow?\" ",shape=box,color=red];
		j1688898053 -> j939728384;
	"Chat ends." [color=orange];
	j3438878366 [label="Isso, exatamente",shape=box,color=blue];
		j3438878366 -> j1517319934;
	j939728384 [label="Esse é o Ordis, vive fazendo isso",shape=box,color=red];
		j939728384 -> j121929640;
	j1517319934 [label="Espera aí…",shape=box,color=blue];
		j1517319934 -> j2756443499;
	j121929640 [label="Ele é uma gracinha… mas não nesse sentido, digo mais como se fosse uma voz dentro de você",shape=box,color=blue];
		j121929640 -> j3020791560;
	j2756443499 [label="A Lua sumiu?",shape=box,color=blue];
		j2756443499 -> j3502350611;
	j3020791560 [label="Meio que como se seu cérebro estivesse se mantendo ocupado enquanto você cuida da importante tarefa de higiene pessoal",shape=box,color=blue];
		j3020791560 -> j552959562;
	j3502350611 [label="Por quanto tempo? Pra onde ela foi? O que aconteceu com o mar?",shape=box,color=blue];
		j3502350611 -> j4152937345;
		j3502350611 -> j2297290688;
	j552959562 [label="Fico recebendo esse tipo de pergunta o tempo todo, todas estranhamente aleatórias. Tanto que, ultimamente, tenho me perguntado se elas realmente surgiram da minha cabeça ou… de outro lugar ",shape=box,color=blue];
		j552959562 -> j2408171417;
	j4152937345 [label="Respostas em ordem: não sei; pro Void; não faço ideia",shape=box,color=red];
		j4152937345 -> j3809630962;
	j2297290688 [label="A Lótus enviou ela pro Void, perto do fim da Guerra Ancestral. A criança trouxe ela de volta recentemente",shape=box,color=red];
		j2297290688 -> j2458014364;
	j2408171417 [label="Transformei algumas delas em pinturas",shape=box,color=blue];
		j2408171417 -> j3809630962;
	j3809630962 [label="Ah, deixa pra lá, não vamos perder o fio da meada",shape=box,color=blue];
		j3809630962 -> j2017459335;
	j2458014364 [label="Não faço ideia de como ficou o mar",shape=box,color=red];
		j2458014364 -> j3390362159;
	j2017459335 [label="Voltando aos pensamentos aleatórios no banho, recebi um bem cabuloso hoje de manhã",shape=box,color=blue];
		j2017459335 -> j1280660119;
	j3390362159 [label="Mas como que a Lótus moveu uma LUA inteira?",shape=box,color=blue];
		j3390362159 -> j3809630962;
	j1280660119 [label="Foi assim: \"ei, e se deuses existirem mesmo?\"",shape=box,color=blue];
		j1280660119 -> j636076806;
	j636076806 [label="Fiquei toda mole por um instante. Precisei até de um pouco de água fria no rosto pra me recuperar",shape=box,color=blue];
		j636076806 -> j2905704814;
		j636076806 -> j2688226762;
		j636076806 -> j117541861;
	j2905704814 [label="O que tem de estranho nisso? Me parece uma pergunta bem básica",shape=box,color=red];
		j2905704814 -> j591598275;
	j2688226762 [label="Mas… o povo acha que os deuses não existem? Tenho quase certeza que a Lê acha que existem sim",shape=box,color=red];
		j2688226762 -> j2793131375;
	j117541861 [label="É, essa é uma dúvida terrível",shape=box,color=red];
		j117541861 -> j2871420325;
	j591598275 [label="Ah, é por isso que adoro falar com você sobre essas coisas",shape=box,color=blue];
		j591598275 -> j3066794724;
	j2793131375 [label="Ah, qual é, ninguém acredita de verdade que deuses existem. Não do mesmo jeito que… sei lá, que as mesas e cadeiras existem",shape=box,color=blue];
		j2793131375 -> j2100446624;
	j2871420325 [label="Né? E se toda vez que você pensou que o universo estava te enviando uma mensagem… ele realmente estivesse?",shape=box,color=blue];
		j2871420325 -> j3580342658;
	j3066794724 [label="Sua vida é tão fantasticamente absurda que deuses serem reais é uma especulação tão natural pra você quanto recheios de pizza pra gente",shape=box,color=blue];
		j3066794724 -> j11933118;
	j2100446624 [label="Deuses de verdade são como poços de aldeias e banheiros ao ar livre, é algo que as pessoas COSTUMAVAM ter ",shape=box,color=blue];
		j2100446624 -> j1531686471;
	j3580342658 [label="Imagina só… tudo nas mãos desses malditos imortais que estavam no comando somente porque as coisas eram assim, e não porque eles fizeram por merecer",shape=box,color=blue];
		j3580342658 -> j1362985538;
	j11933118 [label="Você pode até já ter conhecido um deus, se é que a Indiferença conta como um",shape=box,color=blue];
		j11933118 -> j4201744369;
	j1531686471 [label="Hoje em dia, isso não passa de símbolos, metáforas… ou coisa do tipo",shape=box,color=blue];
		j1531686471 -> j3522926369;
		j1531686471 -> j325831488;
	j1362985538 [label="E o mais bizarro é que era assim que as pessoas realmente viviam. Essa era a realidade delas, todos os dias de suas vidas",shape=box,color=blue];
		j1362985538 -> j239177157;
	j4201744369 [label="Você me lembrou de uma coisa lá na Zariman… a primeira vez que conheci a Indiferença",shape=box,color=red];
		j4201744369 -> j3734111151;
	j3522926369 [label="Será que as pessoas só tão com menos medo disso agora?",shape=box,color=red];
		j3522926369 -> j3798514482;
	j325831488 [label="Achei que o Sol e a Lua fossem os seus deuses",shape=box,color=red];
		j325831488 -> j3743086408;
	j239177157 [label="Pra eles, os deuses eram tão reais quanto o clima, e se importavam tanto quanto a chuva se importa com o povo",shape=box,color=blue];
		j239177157 -> j389053306;
	j3734111151 [label="Eu não sabia o que era isso na época, claro, mas lembro o que ela me disse ",shape=box,color=red];
		j3734111151 -> j1918405823;
	j3798514482 [label="É… acho que pode ser isso",shape=box,color=blue];
		j3798514482 -> j956738295;
	j3743086408 [label="Eles são, mas também são somente corpos celestiais ",shape=box,color=blue];
		j3743086408 -> j2048591000;
	j389053306 [label="Sinceramente, não parece muito diferente da vida sob o domínio do Orokin",shape=box,color=red];
		j389053306 -> j1299499803;
	j1918405823 [label="Tava escuro, então eu disse que ela podia usar minha lanterna, e ela sorriu pra mim e disse: \"obrigada, criança. Acho que vou pegar sim\"",shape=box,color=red];
		j1918405823 -> j1104584242;
	j956738295 [label="Acho que sei o motivo também",shape=box,color=blue];
		j956738295 -> j875445101;
	j2048591000 [label="Assim como a Britânia é um país, com nome, identidade e tudo mais, ela não passa de um monte de terra e pedra. Ela pode ser as 2 coisas ao mesmo tempo",shape=box,color=blue];
		j2048591000 -> j2656640532;
	j1299499803 [label="Imortais, mesquinhos… no comando só \"porque sim\"…",shape=box,color=red];
		j1299499803 -> j72970829;
	j1104584242 [label="Droga, você está me dando arrepios",shape=box,color=blue];
		j1104584242 -> j1402092154;
	j875445101 [label="É tudo uma questão de luz",shape=box,color=blue];
		j875445101 -> j146274915;
	j2656640532 [label="Você pode sair em um lindo dia ensolarado e se sentir grato, olhar para o Sol e dizer \"saúde!\". É sério, isso é coisa humana",shape=box,color=blue];
		j2656640532 -> j2277807139;
	j72970829 [label="Verdade, você TINHA deuses vivos, mas matou todos eles",shape=box,color=blue];
		j72970829 -> j334111068;
	j1402092154 [label="Em todos os contos populares antigos, o diabo se apega bastante às leis e palavras",shape=box,color=blue];
		j1402092154 -> j3858824128;
	j146274915 [label="Afinal, o que são o Sol e a Lua? Antes que alguém pensasse neles como Deuses? Eles eram LUZES",shape=box,color=blue];
		j146274915 -> j513022442;
		j146274915 -> j2123668527;
	j2277807139 [label="Hoje em dia, ninguém acha que o Sol ou a Lua literalmente engravidaram alguma mulher humana, ou foram a mãe do filho de algum humano e fizeram um Rei",shape=box,color=blue];
		j2277807139 -> j3202652602;
	j334111068 [label="(Não me entenda mal, amo isso para você)",shape=box,color=blue];
		j334111068 -> j1431284742;
	j3858824128 [label="Você acha que essa coisa entendeu sua fala como uma promessa? Acha que pode interpretar sua lanterna como sua \"luz\"?",shape=box,color=blue];
		j3858824128 -> j1845675807;
		j3858824128 -> j2298929887;
	j513022442 [label="Tem razão, a luz simboliza o bem em qualquer lugar",shape=box,color=red];
		j513022442 -> j3398691874;
	j2123668527 [label="As únicas luzes que a humanidade teve, por muito, muito tempo",shape=box,color=red];
		j2123668527 -> j3398691874;
	j3202652602 [label="As pessoas costumavam acreditar nessas coisas. Agora, sabemos que essas histórias são somente lendas, já as superamos",shape=box,color=blue];
		j3202652602 -> j2062843303;
		j3202652602 -> j1862324010;
	j1431284742 [label="Você está me confundindo com a criança. Não cheguei a fazer parte da grande insurreição Tenno",shape=box,color=red];
		j1431284742 -> j2997605351;
	j1845675807 [label="Essa coisa diz que a gente fez um \"acordo\", então acho que isso pensa que eu… devo alguma coisa",shape=box,color=red];
		j1845675807 -> j620161688;
	j2298929887 [label="Na época, eu tava falando da lanterna no sentido literal mesmo, mas vai saber o que aquela coisa entendeu…",shape=box,color=red];
		j2298929887 -> j620161688;
	j3398691874 [label="ISSO",shape=box,color=blue];
		j3398691874 -> j3803857818;
	j2062843303 [label="Deuses e humanos… se uniram?",shape=box,color=red];
		j2062843303 -> j2147153417;
	j1862324010 [label="Reis com pais deuses? E eu achando que os Orokin eram cuzões…",shape=box,color=red];
		j1862324010 -> j2147153417;
	j2997605351 [label="Nunca fiz parte do programa da Margulis para \"Crianças Muito Especiais\", nunca ganhei um Warframe e nunca lutei na Guerra Ancestral",shape=box,color=red];
		j2997605351 -> j2926798614;
	j620161688 [label="Pelo menos uma coisa eu sei sobre aquela coisa: ela gosta de joguinhos",shape=box,color=red];
		j620161688 -> j2976205724;
	j3803857818 [label="Então, um pequeno nerd das cavernas, provavelmente provocado pelas grandes garotas das cavernas, apostou no truque de bater uma pedra na outra, e bingo",shape=box,color=blue];
		j3803857818 -> j1654372704;
	j2147153417 [label="Ah, essas coisas aconteceram MUITO, no mundo todo",shape=box,color=blue];
		j2147153417 -> j20440089;
	j2926798614 [label="Você… gostaria de ter feito tudo isso?",shape=box,color=blue];
		j2926798614 -> j806422464;
