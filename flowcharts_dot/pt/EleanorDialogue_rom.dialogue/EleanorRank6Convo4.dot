		j2926798614 -> j2589693702;
	j2976205724 [label="+20 Chemistry",color=orange];
		j2976205724 -> j2101742160;
	j1654372704 [label="Luz sob demanda! Independência das grandes luzes do céu!",shape=box,color=blue];
		j1654372704 -> j2471496287;
	j20440089 [label="Imagina que você é um padre arrogante viajando pelo mar pra espalhar o evangelho do Sol pros \"selvagens\" do novo mundo, só pra descobrir que eles não somente já sabem tudo sobre o Sol, como também têm o filho do Sol governando eles",shape=box,color=blue];
		j20440089 -> j4003284644;
	j806422464 [label="Realmente não sei",shape=box,color=red];
		j806422464 -> j310014093;
	j3963435750 [label="Sinceramente, não",shape=box,color=red];
		j3963435750 -> j3340940962;
	j2589693702 [label="É, acho que sim",shape=box,color=red];
		j2589693702 -> j1217480435;
	j2101742160 [label="Então, por favor: não importa o que você faça hoje, com quem estiver, seja eu, o Arthur ou qualquer um de nós… toma cuidado",shape=box,color=blue];
		j2101742160 -> j3435349021;
	j2471496287 [label="Olha só pra gente agora: tem luz por todo lugar, a preço de banana",shape=box,color=blue];
		j2471496287 -> j4201744369;
	j4003284644 [label="Ou você se converteria na hora, ou voltaria correndo pra casa com o rabo entre as pernas",shape=box,color=blue];
		j4003284644 -> j3757864365;
		j4003284644 -> j3779592700;
	j310014093 [label="Faz sentido, respeito isso",shape=box,color=blue];
		j310014093 -> j2991126293;
