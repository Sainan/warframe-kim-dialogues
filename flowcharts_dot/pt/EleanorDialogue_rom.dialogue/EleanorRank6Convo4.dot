		2980 -> 2982;
		2980 -> 2983;
	2981 [label="Fico recebendo esse tipo de pergunta o tempo todo, todas estranhamente aleatórias. Tanto que, ultimamente, tenho me perguntado se elas realmente surgiram da minha cabeça ou… de outro lugar ",shape=box,color=blue];
