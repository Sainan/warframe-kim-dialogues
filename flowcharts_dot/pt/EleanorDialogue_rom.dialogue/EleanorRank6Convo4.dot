		3016 -> 3020;
	3017 [label="Você pode sair em um lindo dia ensolarado e se sentir grato, olhar para o Sol e dizer \"saúde!\". É sério, isso é coisa humana",shape=box,color=blue];
		3017 -> 3021;
	3018 [label="Verdade, você TINHA deuses vivos, mas matou todos eles",shape=box,color=blue];
