digraph {
	"ArthurRank6Convo3 begins." [color=orange];
		"ArthurRank6Convo3 begins." -> j1898690382;
	j1898690382 [label="Outro dia, me peguei conversando com a guitarra.",shape=box,color=blue];
		j1898690382 -> j1529047268;
		j1898690382 -> j3082915041;
	j1529047268 [label="Pessoalmente, não sou muito fã dela.",shape=box,color=red];
		j1529047268 -> j321317705;
	j3082915041 [label="Com a Lizzie? E aí, como foi?",shape=box,color=red];
		j3082915041 -> j2797001578;
	j321317705 [label="Sinceramente, gosto bastante dela. É só ignorar a parte estranha…",shape=box,color=blue];
		j321317705 -> j4014562499;
	j2797001578 [label="Melhor do que eu imaginava, gosto dela.",shape=box,color=blue];
		j2797001578 -> j4014562499;
	j4014562499 [label="Além disso",shape=box,color=blue];
		j4014562499 -> j3141831418;
	j3141831418 [label="Já que ela e a Eleanor parecem estar sempre rindo de piadas que ninguém mais entende.",shape=box,color=blue];
		j3141831418 -> j306546143;
	j306546143 [label="Achei melhor me apresentar pra ela",shape=box,color=blue];
		j306546143 -> j2812328280;
	j2812328280 [label="Ela tem muita sabedoria, e o Flare é fascinante. Sinceramente, todo mundo naquele bar é gente boa. ",shape=box,color=blue];
		j2812328280 -> j1504858630;
	j1504858630 [label="Nada contra o nosso grupo, claro.",shape=box,color=blue];
		j1504858630 -> j3708607587;
		j1504858630 -> j2259318145;
		j1504858630 -> j709612923;
	j3708607587 [label="Cansou do Hexa, é?",shape=box,color=red];
		j3708607587 -> j2731746053;
	j2259318145 [label="Qual a sabedoria que ela te mostrou?",shape=box,color=red];
		j2259318145 -> j3420489452;
	j709612923 [label="Kkkkk fico feliz que você esteja fazendo amigos",shape=box,color=red];
		j709612923 -> j159614483;
	j2731746053 [label="Quê? Não! Claro que não!",shape=box,color=blue];
		j2731746053 -> j3357337888;
	j3420489452 [label="Muita coisa legal, considerando quantas vezes o ano já se repetiu.",shape=box,color=blue];
		j3420489452 -> j2571353235;
	j159614483 [label="É bom ter gente por perto pra conversar, gente com quem eu não passo muito tempo junto.",shape=box,color=blue];
		j159614483 -> j2870277070;
	j3357337888 [label="O Hexa é minha família, minha equipe. Você sabe bem disso.",shape=box,color=blue];
		j3357337888 -> j159614483;
	j2571353235 [label="Quantas vezes eu já esqueci dos anos que se repetiram? Como ela vive… fora do tempo, e a gente não?",shape=box,color=blue];
		j2571353235 -> j812237630;
	j2870277070 [label="Não sei se isso faz sentido… conheço eles, confio neles… eu só não passei pelo inferno e voltei com eles.",shape=box,color=blue];
		j2870277070 -> j3734169393;
	j812237630 [label="E antes que diga qualquer coisa, não, eu nem quero saber. Não é meu direito saber.",shape=box,color=blue];
		j812237630 -> j888594836;
	j3734169393 [label="Então, às vezes, é mais fácil só chegar, sentar e tomar um trago com eles.",shape=box,color=blue];
		j3734169393 -> j551802297;
		j3734169393 -> j2686252397;
		j3734169393 -> j3429012488;
	j888594836 [label="O que quero dizer é... se isso aconteceu ou não, tá tranquilo, não vou te culpar por isso.",shape=box,color=blue];
		j888594836 -> j1261452800;
	j551802297 [label="Nunca tive essa opção na vida",shape=box,color=red];
		j551802297 -> j2782259000;
	j2686252397 [label="É, eu te entendo",shape=box,color=red];
		j2686252397 -> j324876750;
	j3429012488 [label="O fato de alguns deles serem um pouco mais velhos e terem experiência militar também ajuda.",shape=box,color=red];
		j3429012488 -> j3617596373;
	j1261452800 [label="Nossa situação aqui não é normal. Nenhum humano foi feito pra passar por isso…",shape=box,color=blue];
		j1261452800 -> j2245309153;
	j2782259000 [label="Pois é…",shape=box,color=blue];
		j2782259000 -> j3173197545;
	j324876750 [label="Não tem tanto… climão no ar, tanto passado… o Amir ia falar que é besteira",shape=box,color=blue];
		j324876750 -> j3173197545;
	j3617596373 [label="Santo Sol, tem razão. Eu nem sabia como lidar com libertários antes, mas agora, fico feliz de ter eles aqui…",shape=box,color=blue];
		j3617596373 -> j3173197545;
	j2245309153 [label="Não tem um manual pra isso. Independente da tua escolha, confio que terá um bom motivo.",shape=box,color=blue];
		j2245309153 -> j2674809731;
	j3173197545 [label="Mas tudo isso me fez refletir.",shape=box,color=blue];
		j3173197545 -> j2212015538;
		j3173197545 -> j503611600;
	j2674809731 [label="Check boolean ArthurDating",color=orange];
		j2674809731 -> j1289412017 [label=true,color=green];
		j2674809731 -> j524506148 [label=false,color=brown];
	j2212015538 [label="Lá vem…",shape=box,color=red];
		j2212015538 -> j1187499927;
	j503611600 [label="Sobre o quê?",shape=box,color=red];
		j503611600 -> j722831445;
	j1289412017 [label="Eu te amo muito, e mesmo que eu esqueça disso… mesmo que você escolha outro caminho… tá tudo bem",shape=box,color=blue];
		j1289412017 -> j1292082190;
	j524506148 [label="Confio em você com minha vida, e nada vai mudar isso. Mesmo que eu me esqueça disso de vez em quando",shape=box,color=blue];
		j524506148 -> j1863846374;
	j1187499927 [label="Hahaha relaxa, me escuta. Isso é sobre você",shape=box,color=blue];
		j1187499927 -> j938818153;
	j722831445 [label="Você",shape=box,color=blue];
		j722831445 -> j938818153;
	j1292082190 [label="Antes de você chegar, acho que eu nunca ia aceitar isso. Eu teria medo de te perder… perder nosso relacionamento",shape=box,color=blue];
		j1292082190 -> j1508425620;
	j1863846374 [label="Antes de você chegar, acho que eu nunca ia aceitar isso. Eu teria medo de perder uma parte de mim",shape=box,color=blue];
		j1863846374 -> j1508425620;
	j938818153 [label="E toda essa linha do tempo se repetindo, isso me fez pensar sobre quantas vezes já vivi 1999 e esqueci…",shape=box,color=blue];
		j938818153 -> j476820628;
		j938818153 -> j1834039522;
		j938818153 -> j4245423850;
	j1508425620 [label="Eu teria me agarrado a isso como um desesperado se afogando no mar, tentando se salvar. Talvez eu já tenha passado por isso várias vezes, ou talvez seja só você mesmo… sei lá…",shape=box,color=blue];
		j1508425620 -> j1212754447;
	j476820628 [label="Tudo que a guitarra falou é calúnia, eu juro",shape=box,color=red];
		j476820628 -> j570485515;
	j1834039522 [label="Eu tô em perigo?",shape=box,color=red];
		j1834039522 -> j570485515;
	j4245423850 [label="Acho melhor a gente não falar disso, Arthur…",shape=box,color=red];
		j4245423850 -> j570485515;
	j1212754447 [label="Essa felicidade que você me deu, essa paz, vale mais do que saber que ela pode durar para sempre…",shape=box,color=blue];
		j1212754447 -> j3985357259;
	j570485515 [label="Calma aí, dá um tempinho. Eu digito mais devagar que você.",shape=box,color=blue];
		j570485515 -> j79046145;
	j3985357259 [label="Se tem uma coisa que se aprende como soldado, é que tudo é passageiro.",shape=box,color=blue];
		j3985357259 -> j2519757546;
	j79046145 [label="O que quero falar é…",shape=box,color=blue];
		j79046145 -> j583111219;
	j2519757546 [label="Num piscar de olhos, tudo pode sumir. Acho que acabei de aceitar isso… de uma vez por todas.",shape=box,color=blue];
		j2519757546 -> j359763859;
	j583111219 [label="Se você fez eu ou o resto do Hexa esquecer nossas interações passadas… relaxa, tá tudo bem.",shape=box,color=blue];
		j583111219 -> j2620434347;
	j359763859 [label="Então, se o nosso tempo acaba porque você dá um soco no chão e eu esqueço de tudo…",shape=box,color=blue];
		j359763859 -> j4111691056;
	j2620434347 [label="Não te culpo por isso.",shape=box,color=blue];
		j2620434347 -> j1261452800;
	j4111691056 [label="Se a Indiferença te pegar do nada um dia desses…",shape=box,color=blue];
		j4111691056 -> j3105224457;
	j3105224457 [label="Só quero aproveitar o momento, o aqui e o agora. Porque é isso que eu tenho.",shape=box,color=blue];
		j3105224457 -> j1283323074;
	j1283323074 [label="Essa é a única certeza que eu tenho.",shape=box,color=blue];
		j1283323074 -> j1247872378;
		j1283323074 -> j3330181063;
		j1283323074 -> j3111608148;
	j1247872378 [label="Não é nada pessoal, é mais porque ainda tô tentando ficar com a tua irmã :P",shape=box,color=red];
		j1247872378 -> j1815193749;
	j3330181063 [label="Valeu, Arthur… isso significa mais pra mim do que consigo expressar em palavras",shape=box,color=red];
		j3330181063 -> j2937983046;
	j3111608148 [label="Queria eu ter essa mentalidade <3",shape=box,color=red];
		j3111608148 -> j3489279709;
	j1815193749 [label="Que engraçado… que bom que você tem um botão para redefinir tudo então, né?",shape=box,color=blue];
		j1815193749 -> j71322617;
	j2937983046 [label="De vez em quando, me esforço para usar umas palavras bonitas.",shape=box,color=blue];
		j2937983046 -> j2636377519;
	j3489279709 [label="É mais porque sei que não tenho outra escolha a não ser manter a compostura, é o ''jeitinho'' britânico. ",shape=box,color=blue];
		j3489279709 -> j400242340;
	j71322617 [label="O resto aqui precisa aprender a se comunicar…",shape=box,color=blue];
		j71322617 -> j2865027690;
	j2636377519 [label="Bom, acho que tá na hora de tomar uma gelada, bora lá?",shape=box,color=blue];
		j2636377519 -> j4188223087;
		j2636377519 -> j2689804520;
	j400242340 [label="Já dizia o ditado… ''segura a peteca, que logo a maré vira''.",shape=box,color=blue];
		j400242340 -> j2636377519;
	j2865027690 [label="A questão é… será que ela fica menos exigente a cada redefinição?",shape=box,color=blue];
