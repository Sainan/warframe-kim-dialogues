digraph {
	"ArthurRank6Convo2 begins." [color=orange];
		"ArthurRank6Convo2 begins." -> j184851060;
	j184851060 [label="Tava pensando… quantos mais de \"nós\" você acha que tem por aí?",shape=box,color=blue];
		j184851060 -> j1522629848;
		j184851060 -> j1829583167;
	j1522629848 [label="Você quer dizer aqui em 1999 ou num sentido maior?",shape=box,color=red];
		j1522629848 -> j924896155;
	j1829583167 [label="Como assim… \"nós\"?",shape=box,color=red];
		j1829583167 -> j1330381456;
	j924896155 [label="Ambos, eu acho. Aqui, agora, no passado… no futuro…",shape=box,color=blue];
		j924896155 -> j685692669;
	j1330381456 [label="Nós, Protoframes. Aqui, ou em qualquer lugar… em qualquer momento…",shape=box,color=blue];
		j1330381456 -> j685692669;
	j685692669 [label="O Entrati criou a gente com um propósito… múltiplos propósitos na real. É claro que fez mais do que 6. ",shape=box,color=blue];
		j685692669 -> j3504894495;
		j685692669 -> j973460448;
	j3504894495 [label="No começo, achei que ele tava me dando Warframes de \"reserva\", caso o meu não chegasse aqui, mas agora… já não tenho tanta certeza disso",shape=box,color=red];
		j3504894495 -> j3039624597;
	j973460448 [label="Só queria saber o que ele anda fazendo ou qual a real motivação de ele criar mais Protoframes",shape=box,color=red];
		j973460448 -> j3189284815;
	j3039624597 [label="Isso até fazia sentido quando era só 6 de nós",shape=box,color=blue];
		j3039624597 -> j3189284815;
	j3189284815 [label="Acha mesmo que a real motivação dele é acabar com a Indiferença?",shape=box,color=blue];
		j3189284815 -> j3773875486;
	j3773875486 [label="Dá pra gente confiar nele mesmo?",shape=box,color=blue];
		j3773875486 -> j3839942039;
		j3773875486 -> j3605795441;
		j3773875486 -> j1164533261;
	j3839942039 [label="Olha, sinceramente, não sei. Não coloco minha mão no fogo por ele, e sem um Warframe, o meu braço pega fogo num tapa.",shape=box,color=red];
		j3839942039 -> j459992578;
	j3605795441 [label="Não, não dá pra confiar em nenhum dos motivos dele. É só olhar pros métodos que ele usa",shape=box,color=red];
		j3605795441 -> j2414875205;
		j3605795441 -> j2641842676;
	j1164533261 [label="É… nem sempre gosto dos métodos dele, mas acho que ele quer mesmo acabar com aquela coisa",shape=box,color=red];
		j1164533261 -> j2641842676;
		j1164533261 -> j2414875205;
	j459992578 [label="+5 Chemistry",color=orange];
		j459992578 -> j1839026078;
	j2414875205 [label="Agora, ele tá tentando tapar o sol com a peneira, se é que é possível. Complicado…",shape=box,color=red];
		j2414875205 -> j1469897371;
	j2641842676 [label="Mas a gente não tem escolha, né? Tudo o que a criança e eu podemos fazer é seguir ele e limpar a bagunça.",shape=box,color=red];
		j2641842676 -> j3582154134;
		j2641842676 -> j794024686;
	j1839026078 [label="Hehe",shape=box,color=blue];
		j1839026078 -> j2414875205;
		j1839026078 -> j2641842676;
	j1469897371 [label="E a gente virou os faxineiros de plantão, varrendo o chão que ele pisa… que beleza",shape=box,color=blue];
		j1469897371 -> j3582154134;
		j1469897371 -> j794024686;
	j3582154134 [label="Agora que a Kaya manja de viagem no tempo, vai ser mais fácil pra mim ir e voltar",shape=box,color=red];
		j3582154134 -> j2585005538;
	j794024686 [label="Mas pretendo ficar aqui, então o trampo agora é com a criança…",shape=box,color=red];
		j794024686 -> j161265069;
	j2585005538 [label="Aquela criança é um pé no saco, mas admito que admiro o trabalho dela.",shape=box,color=blue];
		j2585005538 -> j563576293;
