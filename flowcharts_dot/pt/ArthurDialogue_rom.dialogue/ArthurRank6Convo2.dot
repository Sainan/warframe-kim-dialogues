		j2587158159 -> j584270883;
	j1771541573 [label="Ah, você me conhece. Crocante por fora e suave por dentro. Igual aqueles doces medonhos que o Amir e o Velimir falam tanto.",shape=box,color=blue];
		j1771541573 -> j1294518470;
	j584270883 [label="Obrigado pela parte que me toca.",shape=box,color=red];
		j584270883 -> j2339584303;
	j1294518470 [label="Paçoquinha? Não lembro o nome…",shape=box,color=blue];
		j1294518470 -> j2339584303;
	j2339584303 [label="Enfim, voltando ao assunto. Às vezes, tenho a sensação desagradável de que o Entrati tem um propósito maior pra gente",shape=box,color=blue];
