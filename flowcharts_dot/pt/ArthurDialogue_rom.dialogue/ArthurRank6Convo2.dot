		j563576293 -> j2613732724;
	j3094613098 [label="É, veremos… Te conheço bem, bebê. Sei bem que não sabe a hora de baixar a cabeça.",shape=box,color=blue];
		j3094613098 -> j3573560473;
	j1335181632 [label="É, veremos… Te conheço bem, Peregrino. Sei bem que você não sabe quando baixar a cabeça.",shape=box,color=blue];
