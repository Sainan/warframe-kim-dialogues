digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo4 begins." [color=orange];
		"ArthurRank6Convo4 begins." -> j3236225339;
	j3236225339 [label="Pergunta estranha… eles têm brinquedos no espaço?",shape=box,color=blue];
		j3236225339 -> j130960006;
		j3236225339 -> j4294585009;
	j130960006 [label="Tipo… brinquedo de criança? Se sim, sim.",shape=box,color=red];
		j130960006 -> j3832067463;
	j4294585009 [label="Hm… que tipo de brinquedinho você tá falando?",shape=box,color=red];
		j4294585009 -> j3809667365;
	j3832067463 [label="Sério?",shape=box,color=blue];
		j3832067463 -> j1530225017;
	j3809667365 [label="AFF, SOL! Não foi isso que quis dizer, você sabe disso, mente suja!",shape=box,color=blue];
		j3809667365 -> j3130476057;
	j1530225017 [label="É difícil imaginar as coisas alguns milhares de anos no futuro",shape=box,color=blue];
		j1530225017 -> j2237111909;
	j3130476057 [label="Tô falando de brinquedo de criança mesmo, tipo bonecas, carrinhos, figurinhas, etc…",shape=box,color=blue];
		j3130476057 -> j1359528785;
		j3130476057 -> j763851065;
	j2237111909 [label="A criançada ainda brinca de boneco, de \"pega ladrão\", de \"esconde-esconde\"?",shape=box,color=blue];
		j2237111909 -> j1461727819;
		j2237111909 -> j1919757235;
		j2237111909 -> j2440538432;
	j1359528785 [label="Tava só te tirando :P",shape=box,color=red];
		j1359528785 -> j352230996;
	j763851065 [label="Mas não, não tem brinquedos. [Encerrar Conversa]",shape=box,color=red];
		j763851065 -> "Chat ends.";
	j1461727819 [label="Por que pensou nisso agora?",shape=box,color=red];
		j1461727819 -> j413516119;
	j1919757235 [label="Do que você brincava quando era criança?",shape=box,color=red];
		j1919757235 -> j2930570623;
	j2440538432 [label="Temos nomes diferentes pros jogos que jogamos, mas eu definitivamente tinha brinquedos",shape=box,color=red];
		j2440538432 -> j1160371070;
	j352230996 [label="Mas sim, claro que temos brinquedos lá. ",shape=box,color=red];
		j352230996 -> j3832067463;
	"Chat ends." [color=orange];
	j413516119 [label="Na real, eu tava vendo o Amir jogar um joguinho de fliperama… ",shape=box,color=blue];
		j413516119 -> j811561489;
	j2930570623 [label="É meio reconfortante pensar que, apesar de todas as diferenças entre as nossas culturas, a criançada ainda curte brincar com brinquedo…",shape=box,color=blue];
		j2930570623 -> j2697100283;
	j1160371070 [label="Tipo o quê?",shape=box,color=blue];
		j1160371070 -> j776516063;
		j1160371070 -> j3400236860;
	j811561489 [label="Aí fiquei pensando… o que eu não daria pra viver esse tipo de alegria de novo…",shape=box,color=blue];
		j811561489 -> j913121846;
	j2697100283 [label="Eu tinha um boneco de ação, o Angus de Ação. Ele era um soldado, nenhuma novidade aqui",shape=box,color=blue];
		j2697100283 -> j2205939479;
	j776516063 [label="Tipo bonecos, bichos de pelúcia e blocos de montar, coisas de criança ",shape=box,color=red];
		j776516063 -> j2930570623;
	j3400236860 [label="Eu tinha um… acho que dá pra chamar de estatueta… dessa criança Dax, que batizei em homenagem a um personagem de um livro: Dominus Thrax",shape=box,color=red];
		j3400236860 -> j219609551;
	j913121846 [label="Nunca desprezei a Aoi, o Amir nem mesmo a Kaya por acharem graça de coisas \"infantis\", isso nunca me incomodou",shape=box,color=blue];
		j913121846 -> j1105179068;
	j2205939479 [label="Numa celebração do solstício, umas crianças mais velhas roubaram ele de mim, e outros brinquedos meus também e, bem…",shape=box,color=blue];
		j2205939479 -> j2839692524;
	j219609551 [label="Ah, merda, eu devia ter percebido… foi mal ter tocado nesse assunto",shape=box,color=blue];
		j219609551 -> j3021767212;
		j219609551 -> j3518857763;
	j1105179068 [label="Às vezes, tenho medo de que a parte de mim capaz de sentir isso já tenha morrido",shape=box,color=blue];
		j1105179068 -> j1290469427;
	j2839692524 [label="É uma longa história… em resumo, eu era \"velho demais\" pra brincar com bonecos. Aquela foi a última vez que brinquei com alguma coisa",shape=box,color=blue];
		j2839692524 -> j3031623438;
	j3021767212 [label="Olha, não é o meu tópico favorito não…",shape=box,color=red];
		j3021767212 -> j3466537092;
	j3518857763 [label="Tá tudo bem, você não tem culpa",shape=box,color=red];
		j3518857763 -> j1018924511;
	j1290469427 [label="É meio triste, né? A gente fala pras crianças amarem algo e depois falamos pra elas largarem tudo quando \"amadurecerem\"",shape=box,color=blue];
		j1290469427 -> j219852492;
		j1290469427 -> j560442293;
	j3031623438 [label="Outro dia, eu tava vendo o Amir jogar um dos seus jogos. É nítido o quanto ele gosta disso, o quão feliz ele fica. Fiquei até com um pouco de inveja por não ter nada parecido na minha vida",shape=box,color=blue];
		j3031623438 -> j1290469427;
	j3466537092 [label="Agora me sinto um belo de um idiota",shape=box,color=blue];
		j3466537092 -> "Chat ends.";
	j1018924511 [label="A gente tinha brinquedo de todo o tipo. Blocos, bichos de pelúcia, bonecos",shape=box,color=red];
		j1018924511 -> j59619730;
	j219852492 [label="Sei não… todo mundo tem que crescer um dia. Não dá pra se esconder atrás de contos de fadas, aprendi isso da pior forma",shape=box,color=red];
		j219852492 -> j2445493850;
	j560442293 [label="Acho que a vida pode ser feia, dolorosa e curta. A gente tem que encher ela com o máximo de diversão, risadas e amor que der",shape=box,color=red];
		j560442293 -> j581756999;
	j59619730 [label="O meu só se tornou um problema maior por causa de… toda aquela coisa do Void",shape=box,color=red];
		j59619730 -> j2930570623;
	j2445493850 [label="Tem razão, também acho que quando as coisas se tornam uma substituição pra coisa original, aí é um problema",shape=box,color=blue];
		j2445493850 -> j704958452;
	j581756999 [label="Tem razão, espero que a gente se lembre disso enquanto seguimos juntos nessa… \"jornada\" que estamos passando",shape=box,color=blue];
		j581756999 -> j704958452;
	j704958452 [label="Sabe, eu vi a Eleanor, o Velimir, a Aoi e o Amir brincando de esconde-esconde com o Flare e a Lizzie (o Quincy disse que não deixaram ele brincar porque o desgraçado tava trapaceando e usando sua mira pra ver os outros atrás das paredes)",shape=box,color=blue];
		j704958452 -> j3874012480;
	j3874012480 [label="Eles tavam todos olhando pra mim, preocupados que eu ia ficar chateado de ver eles fazendo bagunça em vez de trabalho",shape=box,color=blue];
		j3874012480 -> j960276130;
	j960276130 [label="Fiquei mais chateado por não ter sido convidado… mas tive que fazer cara de líder rabugento e fingir que tava chateado porque os postos estavam vazios, e por aí vai",shape=box,color=blue];
		j960276130 -> j3856565664;
	j3856565664 [label="Mas o Amir tem seus joguinhos, a Aoi tem a On-lyne… até a Kaya tem suas figurinhas e seus Jinymon, mesmo com tudo que o mundo jogou nas costas dela considerando a idade dela",shape=box,color=blue];
		j3856565664 -> j1554679821;
		j3856565664 -> j3499285958;
	j1554679821 [label="Aonde você quer chegar?",shape=box,color=red];
		j1554679821 -> j3395291176;
	j3499285958 [label="Acho que você tinha que correr atrás disso, ou pelo menos tentar. Se divertir com brinquedos e joguinhos bestas, essa coisa do tipo",shape=box,color=red];
		j3499285958 -> j3877316141;
	j3395291176 [label="Honestamente, nem eu sei. Só sei que sinto falta de algo que não existe mais na minha vida há muito tempo",shape=box,color=blue];
		j3395291176 -> j1487363927;
	j3877316141 [label="Já consigo até ouvir as risadas do povo. Acho que é isso que tá me segurando, né? A vergonha",shape=box,color=blue];
		j3877316141 -> j3699265244;
	j1487363927 [label="Não sei se vou ter isso de volta algum dia ou se já é tarde demais, mas quem sabe… Com o tempo, talvez tudo é possível…",shape=box,color=blue];
		j1487363927 -> "Chat ends.";
	j3699265244 [label="Não sei se vou ter isso de volta algum dia, mesmo se eu superar essa vergonha, mas quem sabe… Com o tempo, talvez tudo é possível…",shape=box,color=blue];
		j3699265244 -> "Chat ends.";
}