digraph {
	3433 [label="ArthurRank6Convo4 begins.",color=orange];
		3433 -> 3434;
	3434 [label="Pergunta estranha… eles têm brinquedos no espaço?",shape=box,color=blue];
		3434 -> 3435;
		3434 -> 3436;
	3435 [label="Tipo… brinquedo de criança? Se sim, sim.",shape=box,color=red];
		3435 -> 3437;
	3436 [label="Hm… que tipo de brinquedinho você tá falando?",shape=box,color=red];
		3436 -> 3438;
	3437 [label="Sério?",shape=box,color=blue];
		3437 -> 3439;
	3438 [label="AFF, SOL! Não foi isso que quis dizer, você sabe disso, mente suja!",shape=box,color=blue];
		3438 -> 3440;
	3439 [label="É difícil imaginar as coisas alguns milhares de anos no futuro",shape=box,color=blue];
		3439 -> 3441;
	3440 [label="Tô falando de brinquedo de criança mesmo, tipo bonecas, carrinhos, figurinhas, etc…",shape=box,color=blue];
		3440 -> 3442;
		3440 -> 3448;
	3441 [label="A criançada ainda brinca de boneco, de \"pega ladrão\", de \"esconde-esconde\"?",shape=box,color=blue];
		3441 -> 3444;
		3441 -> 3445;
		3441 -> 3446;
	3442 [label="Tava só te tirando :P",shape=box,color=red];
		3442 -> 3447;
	3448 [label="Mas não, não tem brinquedos. [Encerrar Conversa]",shape=box,color=red];
		3448 -> 3452;
	3444 [label="Por que pensou nisso agora?",shape=box,color=red];
		3444 -> 3449;
	3445 [label="Do que você brincava quando era criança?",shape=box,color=red];
		3445 -> 3450;
	3446 [label="Temos nomes diferentes pros jogos que jogamos, mas eu definitivamente tinha brinquedos",shape=box,color=red];
		3446 -> 3451;
	3447 [label="Mas sim, claro que temos brinquedos lá. ",shape=box,color=red];
		3447 -> 3437;
	3452 [label="Chat ends.",color=orange];
	3449 [label="Na real, eu tava vendo o Amir jogar um joguinho de fliperama… ",shape=box,color=blue];
		3449 -> 3453;
	3450 [label="É meio reconfortante pensar que, apesar de todas as diferenças entre as nossas culturas, a criançada ainda curte brincar com brinquedo…",shape=box,color=blue];
		3450 -> 3454;
	3451 [label="Tipo o quê?",shape=box,color=blue];
		3451 -> 3455;
		3451 -> 3456;
	3453 [label="Aí fiquei pensando… o que eu não daria pra viver esse tipo de alegria de novo…",shape=box,color=blue];
		3453 -> 3457;
	3454 [label="Eu tinha um boneco de ação, o Angus de Ação. Ele era um soldado, nenhuma novidade aqui",shape=box,color=blue];
		3454 -> 3458;
	3455 [label="Tipo bonecos, bichos de pelúcia e blocos de montar, coisas de criança ",shape=box,color=red];
		3455 -> 3450;
	3456 [label="Eu tinha um… acho que dá pra chamar de estatueta… dessa criança Dax, que batizei em homenagem a um personagem de um livro: Dominus Thrax",shape=box,color=red];
		3456 -> 3459;
	3457 [label="Nunca desprezei a Aoi, o Amir nem mesmo a Kaya por acharem graça de coisas \"infantis\", isso nunca me incomodou",shape=box,color=blue];
		3457 -> 3460;
	3458 [label="Numa celebração do solstício, umas crianças mais velhas roubaram ele de mim, e outros brinquedos meus também e, bem…",shape=box,color=blue];
		3458 -> 3461;
	3459 [label="Ah, merda, eu devia ter percebido… foi mal ter tocado nesse assunto",shape=box,color=blue];
		3459 -> 3462;
		3459 -> 3463;
	3460 [label="Às vezes, tenho medo de que a parte de mim capaz de sentir isso já tenha morrido",shape=box,color=blue];
		3460 -> 3464;
	3461 [label="É uma longa história… em resumo, eu era \"velho demais\" pra brincar com bonecos. Aquela foi a última vez que brinquei com alguma coisa",shape=box,color=blue];
		3461 -> 3465;
	3462 [label="Olha, não é o meu tópico favorito não…",shape=box,color=red];
		3462 -> 3466;
	3463 [label="Tá tudo bem, você não tem culpa",shape=box,color=red];
		3463 -> 3467;
	3464 [label="É meio triste, né? A gente fala pras crianças amarem algo e depois falamos pra elas largarem tudo quando \"amadurecerem\"",shape=box,color=blue];
		3464 -> 3468;
		3464 -> 3469;
	3465 [label="Outro dia, eu tava vendo o Amir jogar um dos seus jogos. É nítido o quanto ele gosta disso, o quão feliz ele fica. Fiquei até com um pouco de inveja por não ter nada parecido na minha vida",shape=box,color=blue];
		3465 -> 3464;
	3466 [label="Agora me sinto um belo de um idiota",shape=box,color=blue];
		3466 -> 3470;
	3467 [label="A gente tinha brinquedo de todo o tipo. Blocos, bichos de pelúcia, bonecos",shape=box,color=red];
		3467 -> 3471;
	3468 [label="Sei não… todo mundo tem que crescer um dia. Não dá pra se esconder atrás de contos de fadas, aprendi isso da pior forma",shape=box,color=red];
		3468 -> 3472;
	3469 [label="Acho que a vida pode ser feia, dolorosa e curta. A gente tem que encher ela com o máximo de diversão, risadas e amor que der",shape=box,color=red];
		3469 -> 3473;
	3470 [label="Chat ends.",color=orange];
	3471 [label="O meu só se tornou um problema maior por causa de… toda aquela coisa do Void",shape=box,color=red];
		3471 -> 3450;
	3472 [label="Tem razão, também acho que quando as coisas se tornam uma substituição pra coisa original, aí é um problema",shape=box,color=blue];
		3472 -> 3474;
	3473 [label="Tem razão, espero que a gente se lembre disso enquanto seguimos juntos nessa… \"jornada\" que estamos passando",shape=box,color=blue];
		3473 -> 3474;
	3474 [label="Sabe, eu vi a Eleanor, o Velimir, a Aoi e o Amir brincando de esconde-esconde com o Flare e a Lizzie (o Quincy disse que não deixaram ele brincar porque o desgraçado tava trapaceando e usando sua mira pra ver os outros atrás das paredes)",shape=box,color=blue];
		3474 -> 3475;
	3475 [label="Eles tavam todos olhando pra mim, preocupados que eu ia ficar chateado de ver eles fazendo bagunça em vez de trabalho",shape=box,color=blue];
		3475 -> 3476;
	3476 [label="Fiquei mais chateado por não ter sido convidado… mas tive que fazer cara de líder rabugento e fingir que tava chateado porque os postos estavam vazios, e por aí vai",shape=box,color=blue];
		3476 -> 3477;
	3477 [label="Mas o Amir tem seus joguinhos, a Aoi tem a On-lyne… até a Kaya tem suas figurinhas e seus Jinymon, mesmo com tudo que o mundo jogou nas costas dela considerando a idade dela",shape=box,color=blue];
		3477 -> 3478;
		3477 -> 3479;
	3478 [label="Aonde você quer chegar?",shape=box,color=red];
		3478 -> 3480;
	3479 [label="Acho que você tinha que correr atrás disso, ou pelo menos tentar. Se divertir com brinquedos e joguinhos bestas, essa coisa do tipo",shape=box,color=red];
		3479 -> 3481;
	3480 [label="Honestamente, nem eu sei. Só sei que sinto falta de algo que não existe mais na minha vida há muito tempo",shape=box,color=blue];
		3480 -> 3482;
	3481 [label="Já consigo até ouvir as risadas do povo. Acho que é isso que tá me segurando, né? A vergonha",shape=box,color=blue];
		3481 -> 3483;
	3482 [label="Não sei se vou ter isso de volta algum dia ou se já é tarde demais, mas quem sabe… Com o tempo, talvez tudo é possível…",shape=box,color=blue];
		3482 -> 3484;
	3483 [label="Não sei se vou ter isso de volta algum dia, mesmo se eu superar essa vergonha, mas quem sabe… Com o tempo, talvez tudo é possível…",shape=box,color=blue];
		3483 -> 3485;
	3484 [label="Chat ends.",color=orange];
	3485 [label="Chat ends.",color=orange];
}