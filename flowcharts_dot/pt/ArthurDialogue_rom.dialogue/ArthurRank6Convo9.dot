	j858154267 [label="Por quê?",shape=box,color=red];
		j858154267 -> j89867555;
	j1291237932 [label="Pelo menos elas não falam",shape=box,color=red];
		j1291237932 -> j225735048;
	j89867555 [label="Além do fato de que acho que ela pode conversar com elas?",shape=box,color=blue];
		j89867555 -> j781112907;
	j225735048 [label="Pra gente não, mas não tenho certeza de que elas não falam com ela",shape=box,color=blue];
		j225735048 -> j781112907;
	j781112907 [label="Eu sei que elas falam com a guitarra, e eu realmente não quero pensar muito nisso",shape=box,color=blue];
		j781112907 -> j14591533;
	j14591533 [label="Só que a minha preocupação é com a propagação delas, parece que elas se multiplicam…",shape=box,color=blue];
		j14591533 -> j815171606;
	j815171606 [label="O que não faz sentido pra mim. Nem quero pensar na munição delas ou do que elas são feitas",shape=box,color=blue];
