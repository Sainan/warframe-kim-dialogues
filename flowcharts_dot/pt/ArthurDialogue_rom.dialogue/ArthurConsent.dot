		3617 -> 3618;
	3616 [label="Chat ends.",color=orange];
	3618 [label="Não quero te colocar numa situação que você se sinta desconfortável… sei que não falamos sobre algo parecido antes, então, se você falar que não, tudo bem",shape=box,color=red];
		3618 -> 3619;
