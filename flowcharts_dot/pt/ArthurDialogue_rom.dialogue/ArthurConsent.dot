	3621 [label="Sim… e sei que pode ser difícil de entender, mas isso não significa que eu te ame menos por causa disso",shape=box,color=red];
		3621 -> 3623;
	3622 [label="Sim… mas agora que penso nisso, acho que é melhor a gente terminar… [Terminar com o Arthur]",shape=box,color=red];
