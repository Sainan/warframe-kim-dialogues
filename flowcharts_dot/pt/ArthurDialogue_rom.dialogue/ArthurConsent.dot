	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j475110817 [label="Você para de questionar as linhas que já foram traçadas… eu entendo perfeitamente",shape=box,color=blue];
		j475110817 -> j4129063491;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j4129063491 [label="A verdade é que… você é importante pra mim. E se essa outra pessoa é importante pra você, então ela também é importante pra mim",shape=box,color=blue];
		j4129063491 -> j3469483158;
	j3469483158 [label="Só… não faz isso com alguém do Hexa, ok? Acho que eu não aguentaria se fosse alguém da \"família\", por assim dizer",shape=box,color=blue];
		j3469483158 -> j983473481;
	j983473481 [label="Só de pensar nisso já me dá pesadelos",shape=box,color=blue];
