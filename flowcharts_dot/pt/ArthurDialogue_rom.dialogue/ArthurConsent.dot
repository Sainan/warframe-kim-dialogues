		j3652224286 -> "Chat ends.";
	j2375197097 [label="Não exatamente… eu só queria conversar com você sobre uma coisa que… espero que não seja desconfortável pra você",shape=box,color=red];
		j2375197097 -> j3752502553;
	j3752502553 [label="Não quero te colocar numa situação que você se sinta desconfortável… sei que não falamos sobre algo parecido antes, então, se você falar que não, tudo bem",shape=box,color=red];
		j3752502553 -> j261444825;
	j261444825 [label="O que temos entre nós é importante pra mim, e muito… não quero que você duvide disso, jamais",shape=box,color=red];
		j261444825 -> j3630087672;
	j3630087672 [label="Ah… já sei onde isso vai dar. Você também tem sentimentos por outra pessoa, né?",shape=box,color=blue];
		j3630087672 -> j708294202;
		j3630087672 -> j2141941078;
	j708294202 [label="Sim… e sei que pode ser difícil de entender, mas isso não significa que eu te ame menos por causa disso",shape=box,color=red];
		j708294202 -> j3443018373;
	j2141941078 [label="Sim… mas agora que penso nisso, acho que é melhor a gente terminar… [Terminar com o Arthur]",shape=box,color=red];
		j2141941078 -> j875830558;
	j3443018373 [label="Meu amor… você realmente acha que passei tantos anos no exército e não vi praticamente todos os tipos de relacionamento que existem?",shape=box,color=blue];
		j3443018373 -> j1198129392;
	j875830558 [label="Se é isso que você realmente quer, então tá…",shape=box,color=blue];
		j875830558 -> j3701883258;
	j1198129392 [label="Quando você passa grande parte da sua vida à beira da morte, aprende a valorizar o que realmente importa e o que não importa",shape=box,color=blue];
