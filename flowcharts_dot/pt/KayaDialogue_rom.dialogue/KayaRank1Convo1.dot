	996 [label="{\"Id\":996,\"Incoming\":[28],\"Outgoing\":[31],\"GraphPos\":[4241,541],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		996 -> 31;
	32 [label="Jogos? Preciso de resposta, uma direção, qualquer coisa… Vou dar um jeito. Se você pensar em ALGO ÚTIL, me chama…",shape=box,color=blue];
		32 -> 34;
	33 [label="Não é muito meu estilo, mas tanto faz",shape=box,color=blue];
		33 -> 35;
