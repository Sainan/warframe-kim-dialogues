	j1128515027 [label="Oi… vem cá, todo mundo pode viajar no tempo, ou só você?",shape=box,color=blue];
		j1128515027 -> j1527103391;
		j1128515027 -> j1086131384;
	j1527103391 [label="Bom dia pra você também. Olha criança, não é tão simples assim",shape=box,color=red];
		j1527103391 -> j3618861711;
	j1086131384 [label="Oi? Kaya? Como vai seu dia?",shape=box,color=red];
		j1086131384 -> j2337545872;
	j3618861711 [label="Não sou criança, tenho 19 anos",shape=box,color=blue];
		j3618861711 -> j177486566;
		j3618861711 -> j3944814043;
	j2337545872 [label="Beleza ",shape=box,color=blue];
		j2337545872 -> j1727734472;
	j177486566 [label="Tá, mas continua sendo a mais nova desse novo grupo, criança",shape=box,color=red];
		j177486566 -> j1969903649;
	j3944814043 [label="Beleza, só não começa com a coisa de viagem no tempo… é complicado",shape=box,color=red];
		j3944814043 -> j481259643;
	j1727734472 [label="Então, é só você? Tem outros? Viagem no tempo é algo que ensinam nas escolas no futuro?",shape=box,color=blue];
		j1727734472 -> j3441833757;
	j1969903649 [label="Aff… a mais nova, sim, mas também a mais determinada em fazer algo pra encontrar respostas. Tenta me acompanhar. Então: viagem no tempo. Como e quem?",shape=box,color=blue];
		j1969903649 -> j919903497;
	j481259643 [label="Aff… o quão complicado? Fórmulas? Elementos químicos e atômicos? Eu chego lá, só me dá algo pra começar",shape=box,color=blue];
		j481259643 -> j835457324;
		j481259643 -> j827591599;
	j3441833757 [label="Vamos dizer que é só eu, simples assim",shape=box,color=red];
		j3441833757 -> j1580899965;
	j919903497 [label="E por que você? Tem algum plano?",shape=box,color=blue];
		j919903497 -> j1586177897;
	j835457324 [label="Eu realmente não sei o que te dizer… não é só ciência… e se for, é uma ciência que só o Entrati conhece",shape=box,color=red];
		j835457324 -> j578084960;
	j827591599 [label="Sugestão: para com isso [Encerrar conversa]",shape=box,color=red];
		j827591599 -> j2547432773;
	j1580899965 [label="Quanto a lições em escolas, se fosse eu não estudei. Mas será que tinha isso lá? ",shape=box,color=red];
		j1580899965 -> j3297018251;
	j1586177897 [label="Então, o que você pode recomendar pra eu obter fontes científicas sobre suas habilidades?",shape=box,color=blue];
		j1586177897 -> j3462254836;
	j578084960 [label="Droga, aquele maldito. Eu sabia que tinha que ter feito mais perguntas pra ele. Tá, pelo menos se for ciência, significa que consigo replicar, e já que você pode ir e vir, eu consigo descobrir. Adeus",shape=box,color=blue];
		j578084960 -> j2547432773;
