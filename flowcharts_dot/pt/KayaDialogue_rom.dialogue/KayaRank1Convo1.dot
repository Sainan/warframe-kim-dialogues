digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j1386741128;
	j1386741128 [label="Oi… vem cá, todo mundo pode viajar no tempo ou só você?",shape=box,color=blue];
		j1386741128 -> j1161506188;
		j1386741128 -> j1690157096;
	j1161506188 [label="Bom dia pra você também. Olha criança, não é tão simples assim",shape=box,color=red];
		j1161506188 -> j372842827;
	j1690157096 [label="Oi? Kaya? Como vai seu dia?",shape=box,color=red];
		j1690157096 -> j3557605139;
	j372842827 [label="Não sou criança, já tenho 19 anos",shape=box,color=blue];
		j372842827 -> j4044151125;
		j372842827 -> j2262672306;
	j3557605139 [label="Beleza ",shape=box,color=blue];
		j3557605139 -> j3494086239;
	j4044151125 [label="Tá, mas continua sendo a mais nova do grupo, portanto… criança",shape=box,color=red];
		j4044151125 -> j974125791;
	j2262672306 [label="Beleza, só não começa com o papo de viagem no tempo… é complicado demais",shape=box,color=red];
		j2262672306 -> j481259643;
	j3494086239 [label="Então, é só você ou têm outros? Viagem no tempo é uma coisa que ensinam no colégio?",shape=box,color=blue];
		j3494086239 -> j62485901;
	j974125791 [label="Aff… a mais jovem, sim… e também a mais determinada pra encontrar as respostas. Tenta me acompanhar. Então, a viagem no tempo… Como e quem?",shape=box,color=blue];
		j974125791 -> j1390634589;
	j481259643 [label="Aff… o quão complicado? Fórmulas? Elementos químicos e atômicos? Eu chego lá, só me dá algo pra começar",shape=box,color=blue];
		j481259643 -> j342176130;
		j481259643 -> j1293778553;
	j62485901 [label="Vamos dizer que é só eu, simples assim",shape=box,color=red];
		j62485901 -> j659587884;
	j1390634589 [label="E por que você? Tem algum plano? ",shape=box,color=blue];
		j1390634589 -> j2047236177;
	j342176130 [label="Eu realmente não sei o que te dizer… não é só ciência… e se for, é uma ciência que só o Entrati conhece",shape=box,color=red];
		j342176130 -> j1904032611;
	j1293778553 [label="Uma sugestão pra ti… Para com isso! [Encerrar conversa]",shape=box,color=red];
		j1293778553 -> j2938341431;
	j659587884 [label="E se é matéria de colégio ou não, olha… essa eu não estudei, mas…",shape=box,color=red];
		j659587884 -> j3297018251;
	j2047236177 [label="Então, o que você pode recomendar pra eu obter fontes científicas sobre suas habilidades?",shape=box,color=blue];
		j2047236177 -> j1131066553;
	j1904032611 [label="Droga, aquele maldito. Eu sabia que tinha que ter feito mais perguntas pra ele. Tá, pelo menos se for ciência, significa que consigo replicar, e já que você pode ir e vir, eu consigo descobrir. Adeus",shape=box,color=blue];
		j1904032611 -> j2938341431;
	j2938341431 [label="+20 Chemistry",color=orange];
		j2938341431 -> "Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue";
	j3297018251 [label="Por quê? Quer dever de casa? Viagem no tempo é provavelmente muito avançado…",shape=box,color=red];
		j3297018251 -> j2598548940;
	j1131066553 [label="Muitas perguntas, criança. Odeio te dizer isso, mas eu só não sei. Só o Entrati tem as respostas",shape=box,color=red];
		j1131066553 -> j1084386497;
	"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" [label="Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue",color=orange];
		"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j2598548940 [label="Droga, tá falando sério?",shape=box,color=blue];
		j2598548940 -> j1719792963;
	j1084386497 [label="Boolean KayaSetKid is now true.",color=orange];
		j1084386497 -> j4130894535;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j1719792963 [label="Alguém do Hexa descobriu? Algum deles tem alguma informação?",shape=box,color=blue];
		j1719792963 -> j1596171355;
		j1719792963 -> j1295384699;
	j4130894535 [label="Tá",shape=box,color=blue];
		j4130894535 -> j2938341431;
	j1596171355 [label="Talvez o Amir? Os jogos dele provavelmente deve ter umas tramas de viagem no tempo…",shape=box,color=red];
		j1596171355 -> j2873969176;
	j1295384699 [label="Sei não, criança. Se quer aprender algo útil, pede pra Lê te dar uma aula básica de primeiros socorros",shape=box,color=red];
		j1295384699 -> j512646045;
	j2873969176 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j2873969176 -> j567730445;
	j512646045 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j512646045 -> j712496370;
	j567730445 [label="Jogos? Preciso de resposta, uma direção, qualquer coisa… Vou dar um jeito. Se você pensar em ALGO ÚTIL, me chama…",shape=box,color=blue];
		j567730445 -> j2938341431;
	j712496370 [label="Não é muito meu estilo, mas tanto faz",shape=box,color=blue];
		j712496370 -> j2938341431;
