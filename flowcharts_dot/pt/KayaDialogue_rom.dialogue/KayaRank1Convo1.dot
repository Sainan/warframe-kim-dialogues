digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j1386741128;
	j1386741128 [label="Oi… vem cá, todo mundo pode viajar no tempo ou só você?",shape=box,color=blue];
		j1386741128 -> j1161506188;
		j1386741128 -> j1690157096;
	j1161506188 [label="Bom dia pra você também. Olha criança, não é tão simples assim",shape=box,color=red];
		j1161506188 -> j372842827;
	j1690157096 [label="Oi? Kaya? Como vai seu dia?",shape=box,color=red];
		j1690157096 -> j3557605139;
	j372842827 [label="Não sou criança, já tenho 19 anos",shape=box,color=blue];
		j372842827 -> j2933595634;
		j372842827 -> j2262672306;
	j3557605139 [label="Beleza ",shape=box,color=blue];
		j3557605139 -> j3494086239;
	j2933595634 [label="Tá, mas continua sendo a mais nova do grupo, portanto… criança",shape=box,color=red];
		j2933595634 -> j2066270221;
	j2262672306 [label="Beleza, só não começa com o papo de viagem no tempo… é complicado demais",shape=box,color=red];
		j2262672306 -> j481259643;
	j3494086239 [label="Então, é só você ou têm outros? Viagem no tempo é uma coisa que ensinam no colégio?",shape=box,color=blue];
		j3494086239 -> j62485901;
	j2066270221 [label="Aff… a mais jovem, sim… e também a mais determinada pra encontrar as respostas. Tenta me acompanhar. Então, a viagem no tempo… Como e quem?",shape=box,color=blue];
		j2066270221 -> j3756558170;
	j481259643 [label="Aff… o quão complicado? Fórmulas? Elementos químicos e atômicos? Eu chego lá, só me dá algo pra começar",shape=box,color=blue];
		j481259643 -> j835457324;
		j481259643 -> j3197017181;
	j62485901 [label="Vamos dizer que é só eu, simples assim",shape=box,color=red];
		j62485901 -> j659587884;
	j3756558170 [label="E por que você? Tem algum plano? ",shape=box,color=blue];
		j3756558170 -> j1586177897;
	j835457324 [label="Eu realmente não sei o que te dizer… não é só ciência… e se for, é uma ciência que só o Entrati conhece",shape=box,color=red];
		j835457324 -> j578084960;
	j3197017181 [label="Uma sugestão pra ti… Para com isso! [Encerrar conversa]",shape=box,color=red];
		j3197017181 -> j2547432773;
	j659587884 [label="E se é matéria de colégio ou não, olha… essa eu não estudei, mas…",shape=box,color=red];
		j659587884 -> j3297018251;
	j1586177897 [label="Então, o que você pode recomendar pra eu obter fontes científicas sobre suas habilidades?",shape=box,color=blue];
		j1586177897 -> j3462254836;
	j578084960 [label="Droga, aquele maldito. Eu sabia que tinha que ter feito mais perguntas pra ele. Tá, pelo menos se for ciência, significa que consigo replicar, e já que você pode ir e vir, eu consigo descobrir. Adeus",shape=box,color=blue];
		j578084960 -> j2547432773;
	j2547432773 [label="+20 Chemistry",color=orange];
