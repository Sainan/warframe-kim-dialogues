digraph {
	0 [label="KayaRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Oi… vem cá, todo mundo pode viajar no tempo ou só você?",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="Bom dia pra você também. Olha criança, não é tão simples assim",shape=box,color=red];
		2 -> 4;
	3 [label="Oi? Kaya? Como vai seu dia?",shape=box,color=red];
		3 -> 5;
	4 [label="Não sou criança, já tenho 19 anos",shape=box,color=blue];
		4 -> 6;
		4 -> 7;
	5 [label="Beleza ",shape=box,color=blue];
		5 -> 8;
	6 [label="Tá, mas continua sendo a mais nova do grupo, portanto… criança",shape=box,color=red];
		6 -> 9;
	7 [label="Beleza, só não começa com o papo de viagem no tempo… é complicado demais",shape=box,color=red];
		7 -> 10;
	8 [label="Então, é só você ou têm outros? Viagem no tempo é uma coisa que ensinam no colégio?",shape=box,color=blue];
		8 -> 11;
	9 [label="Aff… a mais jovem, sim… e também a mais determinada pra encontrar as respostas. Tenta me acompanhar. Então, a viagem no tempo… Como e quem?",shape=box,color=blue];
		9 -> 12;
	10 [label="Aff… o quão complicado? Fórmulas? Elementos químicos e atômicos? Eu chego lá, só me dá algo pra começar",shape=box,color=blue];
		10 -> 13;
		10 -> 14;
	11 [label="Vamos dizer que é só eu, simples assim",shape=box,color=red];
		11 -> 15;
	12 [label="E por que você? Tem algum plano? ",shape=box,color=blue];
		12 -> 16;
	13 [label="Eu realmente não sei o que te dizer… não é só ciência… e se for, é uma ciência que só o Entrati conhece",shape=box,color=red];
		13 -> 17;
	14 [label="Uma sugestão pra ti… Para com isso! [Encerrar conversa]",shape=box,color=red];
		14 -> 1022;
	15 [label="E se é matéria de colégio ou não, olha… essa eu não estudei, mas…",shape=box,color=red];
		15 -> 18;
	16 [label="Então, o que você pode recomendar pra eu obter fontes científicas sobre suas habilidades?",shape=box,color=blue];
		16 -> 19;
	17 [label="Droga, aquele maldito. Eu sabia que tinha que ter feito mais perguntas pra ele. Tá, pelo menos se for ciência, significa que consigo replicar, e já que você pode ir e vir, eu consigo descobrir. Adeus",shape=box,color=blue];
		17 -> 20;
	1022 [label="+20 Chemistry",color=orange];
		1022 -> 1018;
	18 [label="Por quê? Quer dever de casa? Viagem no tempo é provavelmente muito avançado…",shape=box,color=red];
		18 -> 21;
	19 [label="Muitas perguntas, criança. Odeio te dizer isso, mas eu só não sei. Só o Entrati tem as respostas",shape=box,color=red];
		19 -> 22;
	20 [label="+20 Chemistry",color=orange];
		20 -> 1015;
	1018 [label="{\"Id\":1018,\"Incoming\":[1022],\"Outgoing\":[1023],\"GraphPos\":[3236,718],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1018 -> 1023;
	21 [label="Droga, tá falando sério?",shape=box,color=blue];
		21 -> 24;
	22 [label="Update boolean KayaSetKid",color=orange];
		22 -> 25;
	1015 [label="{\"Id\":1015,\"Incoming\":[20],\"Outgoing\":[23],\"GraphPos\":[3252,817],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1015 -> 23;
	1023 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	24 [label="Alguém do Hexa descobriu? Algum deles tem alguma informação?",shape=box,color=blue];
		24 -> 26;
		24 -> 27;
	25 [label="Tá",shape=box,color=blue];
		25 -> 28;
	23 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	26 [label="Talvez o Amir? Os jogos dele provavelmente deve ter umas tramas de viagem no tempo…",shape=box,color=red];
		26 -> 29;
	27 [label="Sei não, criança. Se quer aprender algo útil, pede pra Lê te dar uma aula básica de primeiros socorros",shape=box,color=red];
		27 -> 30;
	28 [label="+20 Chemistry",color=orange];
		28 -> 996;
	29 [label="Update boolean KayaAmirTravel",color=orange];
		29 -> 32;
