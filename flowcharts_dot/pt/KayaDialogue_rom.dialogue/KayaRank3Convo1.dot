		j3930918567 -> j2330521490;
	j2330521490 [label="Eca, né? Mega nojento. Mas aí eu olhei e tinha tipo um recipiente de plástico que ele escondeu embaixo do bolo cheio de pacotes fechados com cartas de Jinymon. Minha coisa favorita no mundo ",shape=box,color=blue];
		j2330521490 -> j3932828475;
