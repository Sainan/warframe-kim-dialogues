		j548315776 -> j2892596335;
	j2489610152 [label="Na real, ele me convenceu que errei em algumas das minhas hipóteses originais, o que ajudou, mas me lembrou que talvez eu possa pagar pra ter uma resposta, ou pelo menos pagar pra falar com outra pessoa do futuro se você não me ajudar",shape=box,color=blue];
