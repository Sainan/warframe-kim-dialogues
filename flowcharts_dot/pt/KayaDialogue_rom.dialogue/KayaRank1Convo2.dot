		j3303140471 -> j4187246061;
	j4187246061 [label="Realmente não sei de nada com certeza. Só sei que houve uma sequência, o Entrati tinha um plano, e ele me envolveu nessa, aqui, agora. Eu precisava chegar aqui, para conhecer todos vocês",shape=box,color=red];
		j4187246061 -> j1781627740;
