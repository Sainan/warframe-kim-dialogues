	j2689114898 [label="Quê?",shape=box,color=blue];
		j2689114898 -> j2449574720;
	j2916495550 [label="Aff, sei. Tem gente que tem SORTE! Mas voltando ao assunto…",shape=box,color=blue];
		j2916495550 -> j1711306750;
	j1110451634 [label="AFF… não, para, te contei isso em SEGREDO! Mudando de assunto…",shape=box,color=blue];
		j1110451634 -> j1711306750;
	j4227366202 [label="Quê? Ficou biruta? Nada zoado. MUDANDO DE ASSUNTO…",shape=box,color=blue];
		j4227366202 -> j1711306750;
	j2294344730 [label="Não tem lado ruim. Ou eu descubro, ou não. Te vejo por aqui, ou te vejo por lá. Né? Te vejo mais tarde! ",shape=box,color=blue];
		j2294344730 -> j465934596;
	j2449574720 [label="Tudo isso, tudo que o Entrati fez. A busca dele pelo Void, a essência de… tudo",shape=box,color=red];
		j2449574720 -> j3453895452;
	j1711306750 [label="De um jeito, isso aqui é tipo o ensino médio, onde todo mundo gosta de você ",shape=box,color=blue];
		j1711306750 -> j3316765755;
	j3453895452 [label="Pode ser resumido em 1 dedo… literalmente",shape=box,color=red];
