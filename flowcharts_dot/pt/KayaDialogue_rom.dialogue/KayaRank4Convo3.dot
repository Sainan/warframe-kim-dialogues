	j4048242458 [label="Zoado ",shape=box,color=red];
		j4048242458 -> j4227366202;
	j1936384601 [label="Muito… é um desafio. O que rolar, rolou, né? Tipo, isso tá me mantendo ocupada, focada…",shape=box,color=blue];
		j1936384601 -> j2294344730;
	j63232618 [label="Exato! Queimem as naves! Sem olhar pra trás! ",shape=box,color=blue];
