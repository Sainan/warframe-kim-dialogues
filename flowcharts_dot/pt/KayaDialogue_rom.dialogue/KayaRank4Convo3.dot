		j1294733349 -> j3455947757;
	j3397508863 [label="Até o Arthur. Falando nisso, que cara gato, meu Deus!! ",shape=box,color=blue];
		j3397508863 -> j1211137507;
	j2905163766 [label="Aham! É claro que com algumas ressalvas. O caminho mais certo e seguro é ir EXATAMENTE pro lugar de onde você veio, pq existe tipo uma \"Impressão Digital do Void\" ali",shape=box,color=blue];
