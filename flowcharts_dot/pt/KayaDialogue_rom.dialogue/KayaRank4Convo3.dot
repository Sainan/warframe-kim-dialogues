		j2157510973 -> j1156249673;
	j2092441545 [label="(Mas lógico que é o Arthur, porque eu tava falando com ele e parece que você fez uma zona na cabeça dele valendo)",shape=box,color=blue];
		j2092441545 -> j3720573910;
	j1861880454 [label="É tipo, a coisa mais bizarra. A gente tá virando monstro, mas eu nunca me senti tão humana ",shape=box,color=blue];
		j1861880454 -> j2180756510;
	j1156249673 [label="Ok, então a matéria é retida, valeu! ",shape=box,color=blue];
