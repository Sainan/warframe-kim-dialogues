		j4123196853 -> "Chat ends. Next chat will be KayaRank5Convo2.";
	j960799029 [label="É mais sobre os estados da matéria e a teoria que o Void não é \"linear\", então posso usar ele como um trampolim pra de fato seguir VOCÊ de volta ",shape=box,color=blue];
		j960799029 -> j3305378342;
