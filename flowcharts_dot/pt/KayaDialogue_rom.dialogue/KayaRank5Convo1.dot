		j209655596 -> j3946974238;
	"Chat ends. Next chat will be KayaRank5Convo2." [color=orange];
	j3305378342 [label="Pera, pra me seguir?",shape=box,color=red];
		j3305378342 -> j646011612;
	j3946974238 [label="O Void não é \"linear\" pelo visto, então posso usar ele como um trampolim pra de fato seguir VOCÊ de volta ",shape=box,color=blue];
		j3946974238 -> j3305378342;
	j646011612 [label="É, não importa quantas vezes eu faça os testes ou equações, preciso de um \"farol\", ou algo do tipo. O salto do trampolim precisa pousar em algum lugar, e se você voltar pelo menos uma vez, já deve ser o suficiente pra calibrar a rota ",shape=box,color=blue];
		j646011612 -> j1099224666;
		j646011612 -> j1971637860;
	j1099224666 [label="Espero que consiga dar um mortal para trás! O farol tá chegando já já",shape=box,color=red];
		j1099224666 -> j652763011;
	j1971637860 [label="Eita, não sei se fico confortável com isso. E se você ficar presa ou se perder?!",shape=box,color=red];
