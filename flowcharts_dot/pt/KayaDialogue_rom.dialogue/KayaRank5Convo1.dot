		"KayaRank5Convo1 begins." -> j2227586613;
	j2227586613 [label="Eu não paro de achar essas coisas roxas, mas elas desaparecem tipo, no dia seguinte ",shape=box,color=blue];
		j2227586613 -> j3190991256;
	j3190991256 [label="E aí tô achando que tem alguma coisa interessante na decomposição delas ",shape=box,color=blue];
		j3190991256 -> j3972706078;
	j3972706078 [label="Porque a matéria não tá só se transformando num estado de desintegração de um novo isótopo",shape=box,color=blue];
