		j4286074926 -> j1005264360;
	j1161548638 [label="Tá falando de Células Orokin? ",shape=box,color=red];
		j1161548638 -> j2336861266;
	j3891813422 [label="Você consegue conservar eles no lugar de onde você veio? ",shape=box,color=blue];
		j3891813422 -> j1167739059;
		j3891813422 -> j362604481;
	j2336861266 [label="Hmm não, definitivamente não é isso aí também ",shape=box,color=blue];
		j2336861266 -> j2625949318;
		j2336861266 -> j4286074926;
	j1167739059 [label="Sempre desaparecem quando você tira eles do Void ",shape=box,color=red];
		j1167739059 -> j1479214264;
	j362604481 [label="Nunca, sempre presumi que eles simplesmente apodrecessem ",shape=box,color=red];
		j362604481 -> j1479214264;
	j2625949318 [label="Tá falando de Rubedo? ",shape=box,color=red];
		j2625949318 -> j162627022;
	j1479214264 [label="Então é isso: no Void, eles são inertes",shape=box,color=blue];
		j1479214264 -> j823505096;
	j162627022 [label="Acho que não. Se a gente não conseguir descobrir, acho que nunca vou resolver isso ",shape=box,color=blue];
		j162627022 -> j846106931;
		j162627022 -> j713411538;
	j823505096 [label="E quando deixam o Void, depois eles sempre retornam. Eles não se transformam em matéria nova",shape=box,color=blue];
		j823505096 -> j3011575533;
	j846106931 [label="Tá falando de Nano-Esporos? ",shape=box,color=red];
		j846106931 -> j4145505595;
