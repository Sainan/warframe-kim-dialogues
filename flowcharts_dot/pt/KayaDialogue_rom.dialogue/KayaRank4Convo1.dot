digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank4Convo1 begins." [color=orange];
		"KayaRank4Convo1 begins." -> j2017391323;
	j2017391323 [label="Quer saber como é? A internet aparece e promete um monte de coisas ",shape=box,color=blue];
		j2017391323 -> j838559090;
	j838559090 [label="E aí você sou eu. Faz 18 anos. Entra na internet. Começa a conversar com novos amigos NO MUNDO TODO! ",shape=box,color=blue];
		j838559090 -> j3911721755;
	j3911721755 [label="E pra uma garota que em teoria é \"esperta\" como eu, faz a coisa mais idiota possível na internet ",shape=box,color=blue];
		j3911721755 -> j3674516520;
	j3674516520 [label="Confia na pessoa do outro lado ",shape=box,color=blue];
		j3674516520 -> j2446184350;
	j2446184350 [label="E você olha pra toda essa nova tecnologia e esquece que as pessoas ainda são pessoas no fim do dia ",shape=box,color=blue];
		j2446184350 -> j540826553;
	j540826553 [label="Daí você envia um nude que faria até a Lua ficar vermelha de vergonha. Você acha que tem uma conexão com alguém que conheceu na internet… que pode confiar no seu namorado virtual",shape=box,color=blue];
		j540826553 -> j3569801221;
	j3569801221 [label="E no dia seguinte, aquela foto tá em todo lugar. Todo mundo no campus viu… compartilhou… enviou pros PROFESSORES… em toda a INTERNET. Países que eu nem sabia que existia…",shape=box,color=blue];
		j3569801221 -> j1614548124;
	j1614548124 [label="Eu poderia até ter me tornado a pessoa mais inteligente do planeta, mas só lembrariam de mim por causa daquela foto",shape=box,color=blue];
		j1614548124 -> j900560020;
	j900560020 [label="Então quando falo que vou vazar daqui, é real. Sei que essa foto não significa NADA, a vida seguiu em frente e as pessoas garantiram suas risadas ",shape=box,color=blue];
		j900560020 -> j109890846;
	j109890846 [label="Mas isso acabou com a minha vida. Quero viver num futuro sem internet. Quero provar que posso seguir em frente. Voltar pro passado prova que ELES tão certos, que não consigo superar isso ",shape=box,color=blue];
		j109890846 -> j430465958;
	j430465958 [label="Então, pode esperar. Você vai me ver lá no lugar de onde veio ",shape=box,color=blue];
		j430465958 -> j3099041956;
	j3099041956 [label="E aí vamos poder olhar pro mundo e rir que as minhas escolhas não acabaram comigo. Tudo isso só me tornou mais inteligente. Inteligente o suficiente pra escapar ",shape=box,color=blue];
		j3099041956 -> j3258508148;
	j3258508148 [label="+20 Chemistry",color=orange];
		j3258508148 -> "Chat ends. Next chat will be KayaRank4Convo2.";
	"Chat ends. Next chat will be KayaRank4Convo2." [color=orange];
}