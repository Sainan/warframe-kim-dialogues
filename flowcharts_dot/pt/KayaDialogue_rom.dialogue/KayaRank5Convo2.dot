	j596029154 [label="Não ter conseguido parar o Ballas antes ",shape=box,color=red];
		j596029154 -> j2806413450;
	j3108138373 [label="Desistir de mim ",shape=box,color=red];
		j3108138373 -> j3202886511;
	j3820241673 [label="Mas essa pergunta é tipo uma daquelas que os hackers fazem na internet, então não conta pra ninguém ",shape=box,color=blue];
		j3820241673 -> j92212601;
	j1942347439 [label="Sinto muito, é melhor parar por aqui [Encerrar Conversa]",shape=box,color=red];
		j1942347439 -> j3219460250;
	j1458363573 [label="Sinto muito… me conta sobre ele",shape=box,color=red];
		j1458363573 -> j656557444;
	j2225212729 [label="Eu também já perdi um animal de estimação. Qual era o nome do seu? ",shape=box,color=red];
		j2225212729 -> j656557444;
	j700249732 [label="É como se, mesmo depois disso tudo, eu tivesse deixado ele escapar ",shape=box,color=red];
		j700249732 -> j1672448941;
	j2806413450 [label="Não sei como eu poderia ter mudado as coisas ",shape=box,color=red];
		j2806413450 -> j917518359;
	j3202886511 [label="Não importa o que pareça pras outras pessoas. Houve um ponto em que ninguém me odiava mais do que eu mesmo ",shape=box,color=red];
		j3202886511 -> j3112278440;
	j92212601 [label="Mas o nome dele era Zylo. Você diria que ele era um Kubrow, acho ",shape=box,color=blue];
		j92212601 -> j3747754198;
	j3219460250 [label="+20 Chemistry",color=orange];
		j3219460250 -> "Chat ends. Next chat will be KayaRank5Convo3.";
	j656557444 [label="É meio injusto, na real. O Entrati consegue viajar no tempo por aí com sua felina esquisita? ",shape=box,color=blue];
		j656557444 -> j928851103;
	j1672448941 [label="Eu sei que ele acha que tá me ensinando alguma coisa, mas aquele babaca nem percebe o que me fez passar ",shape=box,color=red];
		j1672448941 -> j2637293465;
	j917518359 [label="Mas sei que se eu tivesse sido um pouco mais rápido, alguém teria sofrido menos ",shape=box,color=red];
		j917518359 -> j2994096872;
	j3112278440 [label="Eu não conseguia nem MORRER. E eu queria conseguir ",shape=box,color=red];
		j3112278440 -> j601648316;
	j3747754198 [label="GIGANTE, tipo o maior cachorro que dá pra imaginar. Ele morderia o Sr. Volkov ao meio, fácil",shape=box,color=blue];
		j3747754198 -> j4101188513;
		j3747754198 -> j2644728267;
	"Chat ends. Next chat will be KayaRank5Convo3." [color=orange];
	j928851103 [label="Se eu tivesse o Zylo comigo… essa viagem ia ser muito mais fácil",shape=box,color=blue];
		j928851103 -> j2076032470;
	j2637293465 [label="E não SÓ eu. Todos nós. E o Loid, Gomaitru… é repulsivo. Não sei se consigo me segurar se encontrar ele por aí",shape=box,color=red];
		j2637293465 -> j601648316;
	j2994096872 [label="Ballas é o meu pior pesadelo. Ele representa o pior da vida ",shape=box,color=red];
		j2994096872 -> j601648316;
	j601648316 [label="Quando você fala assim… sei lá, acho que a vida e as pessoas são uma merda às vezes, né?",shape=box,color=blue];
		j601648316 -> j2044756744;
	j4101188513 [label="De onde eu venho ainda rola esses Kubrows grandões",shape=box,color=red];
		j4101188513 -> j627162291;
	j2644728267 [label="Err, sei não, o Sr. Volkov é bem casca-grossa",shape=box,color=red];
		j2644728267 -> j2667348012;
	j2076032470 [label="Zylo foi o primeiro ser vivo que me viu chorar, sabia?",shape=box,color=blue];
		j2076032470 -> j738775893;
	j2044756744 [label="Mas às vezes também são tão incríveis ",shape=box,color=blue];
		j2044756744 -> j3526333003;
	j627162291 [label="Ah mentiraaa… então mais um motivo pra eu IR PRA LÁ. Uau!",shape=box,color=blue];
		j627162291 -> j1279374919;
	j2667348012 [label="Hmm é, pode ser… de qualquer forma, o grande e aterrorizante Zylo. Mas era ferozmente protetor comigo",shape=box,color=blue];
		j2667348012 -> j2076032470;
	j738775893 [label="Eu tinha uns 5 anos e desde que me lembro, sempre me recusei a chorar ",shape=box,color=blue];
		j738775893 -> j3734985319;
	j3526333003 [label="Acho que não dá pra deixar que o nosso maior erro defina quem a gente é. Sinto que você me ajudou a superar o meu ",shape=box,color=blue];
		j3526333003 -> j3823169649;
	j1279374919 [label="Meu Zylo era extremamente protetor comigo ",shape=box,color=blue];
		j1279374919 -> j2076032470;
	j3734985319 [label="Mas cheguei em casa depois do meu primeiro dia de aula na primeira série e o Zylo tava lá ",shape=box,color=blue];
		j3734985319 -> j1836221802;
	j3823169649 [label="Mas eu não mudaria o fato de que ele aconteceu ",shape=box,color=blue];
		j3823169649 -> j3407135735;
	j1836221802 [label="E ele me seguiu até o meu quarto e ficou guardando a porta enquanto eu chorava ",shape=box,color=blue];
		j1836221802 -> j2363259198;
		j1836221802 -> j4187760991;
	j3407135735 [label="Porque, depois de tudo, eu não odeio isso. Nova… é a coisa mais legal que já existiu",shape=box,color=blue];
		j3407135735 -> j2360207833;
	j2363259198 [label="O que te deixou tão chateada? ",shape=box,color=red];
		j2363259198 -> j3417210199;
	j4187760991 [label="Como você lembra disso? ",shape=box,color=red];
		j4187760991 -> j4103892068;
	j2360207833 [label="Não mudaria nada? ",shape=box,color=red];
		j2360207833 -> j1868188258;
	j3417210199 [label="Alguém me chamou de gorda ",shape=box,color=blue];
		j3417210199 -> j2459271059;
	j4103892068 [label="Como eu ia esquecer?! ",shape=box,color=blue];
		j4103892068 -> j3417210199;
	j1868188258 [label="Nada, e espero que você também não",shape=box,color=blue];
		j1868188258 -> j3219460250;
	j2459271059 [label="E isso era tipo, o que fazia as crianças impopulares quando eu era criança ",shape=box,color=blue];
		j2459271059 -> j2637592736;
		j2459271059 -> j2430080551;
	j2637592736 [label="Crianças podem ser tão cruéis ",shape=box,color=red];
		j2637592736 -> j3758120804;
	j2430080551 [label="E ser popular é tão importante assim? ",shape=box,color=red];
		j2430080551 -> j4020239941;
	j3758120804 [label="Todo mundo é cruel ",shape=box,color=blue];
		j3758120804 -> j409362718;
	j4020239941 [label="Pra mim era… até isso tudo acontecer. Sinto que sou uma pessoa melhor depois dessa merda toda, tipo, sou quem eu realmente deveria ter sido esse tempo todo",shape=box,color=blue];
		j4020239941 -> j2202502355;
	j409362718 [label="Todo mundo quer ser popular ",shape=box,color=blue];
		j409362718 -> j1956624136;
	j2202502355 [label="Não ligo mais pro que as pessoas pensam de mim. Só… finalmente vivendo a minha vida",shape=box,color=blue];
		j2202502355 -> j3219460250;
	j1956624136 [label="Mas agora eu percebi, é muito mais legal não se importar em ser legal. É por isso que você é tão legal",shape=box,color=blue];
