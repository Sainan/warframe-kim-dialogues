	j3451881203 [label="Hmmm, acho que pode ser… meu primeiro animal de estimação? ",shape=box,color=blue];
		j3451881203 -> j3820241673;
	j260991394 [label=" Ok ok, ela tá bem, mas eu sou mais fã de cachorros. Cresci com um. Queria poder estar com ele de novo ",shape=box,color=blue];
