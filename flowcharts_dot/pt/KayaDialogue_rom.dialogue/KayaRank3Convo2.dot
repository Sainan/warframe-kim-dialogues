		j1879201928 -> j2603413103;
		j1879201928 -> j1924070301;
	j2603413103 [label="Vamos ver se você é inteligente o suficiente pra descobrir isso. Graças ao Eternalismo, existe uma versão dessa conversa que não termina aqui [Encerrar Conversa]",shape=box,color=red];
		j2603413103 -> j3655577789;
	j1924070301 [label="Espero que não esteja ocupada, porque esse é o verdadeiro motivo de eu estar aqui",shape=box,color=red];
