		j865831550 -> j2937156875;
	"Chat ends. Next chat will be KayaRank3Convo3." [color=orange];
	j2937156875 [label="Quer dizer, acho que foi assim que começou ",shape=box,color=red];
		j2937156875 -> j2434124110;
	j2434124110 [label="Mas tudo isso agora? Vai muito além. É porque o Albrecht foi pra algum lugar, acordou alguma coisa, e isso seguiu ele de volta: o Void",shape=box,color=red];
		j2434124110 -> j2492867719;
		j2434124110 -> j2331381969;
	j2492867719 [label="O Void tá vivo, mas também não tá. Ele é, mas também não é. É um paradoxo, e é a causa e a razão de tudo o que aconteceu com cada um de nós ",shape=box,color=red];
		j2492867719 -> j3854322745;
	j2331381969 [label="Não existe uma \"tabela periódica\" ou fórmula pro que isso é ",shape=box,color=red];
		j2331381969 -> j3007143672;
	j3854322745 [label="Olá mundo",shape=box,color=blue];
		j3854322745 -> j2761812047;
		j3854322745 -> j3661082940;
	j3007143672 [label="A ciência pode explicar, ela governa tudo",shape=box,color=blue];
		j3007143672 -> j3668359530;
	j2761812047 [label="\"Tchau Albrecht\"",shape=box,color=red];
		j2761812047 -> j2293883752;
	j3661082940 [label="Quê?",shape=box,color=red];
		j3661082940 -> j2924306002;
