		j3668359530 -> j676117001 [label=false,color=brown];
	j2293883752 [label="+5 Chemistry",color=orange];
		j2293883752 -> j936569582;
	j2924306002 [label="Foi a primeira coisa postada na internet, a primeira mensagem. Postada pelo criador da internet pra mostrar que \"funcionava\"",shape=box,color=blue];
		j2924306002 -> j4253431634;
	j2560380606 [label="Te falei pra ter cuidado com o Void, é por isso",shape=box,color=red];
		j2560380606 -> j4194986357;
	j676117001 [label="E se não fosse possível? ",shape=box,color=red];
		j676117001 -> j4018716909;
	j936569582 [label="Ai ai, quem dera. Mas você conhece o \"olá mundo\"?",shape=box,color=blue];
		j936569582 -> j2924306002;
	j4253431634 [label="E a partir daí o inferno tomou conta. As pessoas caducando, ciência, bancos, tecnologia, entretenimento…",shape=box,color=blue];
		j4253431634 -> j143902593;
	j4194986357 [label="Algumas coisas não podem ser governadas ",shape=box,color=red];
		j4194986357 -> j1197034282;
	j4018716909 [label="E se tudo que você achava que era uma regra absoluta…",shape=box,color=red];
		j4018716909 -> j328375822;
	j143902593 [label="E dentre bilhões de escolhas, causas e efeitos, isso me levou a entrar na internet um dia e…",shape=box,color=blue];
		j143902593 -> j309517904;
	j1197034282 [label="Algumas coisas não podem ser explicadas ",shape=box,color=red];
		j1197034282 -> j2185252498;
	j328375822 [label="Só aconteceu porque algo maior quis assim",shape=box,color=red];
		j328375822 -> j2185252498;
	j309517904 [label="E foi o fim da Nova, ou melhor, da Kaya. Seu futuro, sua carreira, seus amigos, tudo. Por causa de um erro…",shape=box,color=blue];
		j309517904 -> j1355841841;
	j2185252498 [label="Então você tá dizendo que a parte que falta nos meus experimentos, testes, pesquisas e hipóteses… é \"magia\"",shape=box,color=blue];
		j2185252498 -> j2154804592;
		j2185252498 -> j2509599011;
	j1355841841 [label="Então sei lá, acho que confio mais no Void do que nos outros ",shape=box,color=blue];
		j1355841841 -> j580317660;
		j1355841841 -> j2003645374;
		j1355841841 -> j3696122329;
	j2154804592 [label="Magia não. Só… o Void. O Void, uma energia de outro lugar",shape=box,color=red];
		j2154804592 -> j2586223752;
	j2509599011 [label="Já viu o que eu consigo fazer?",shape=box,color=red];
		j2509599011 -> j57627722;
	j580317660 [label="Não faz isso [Encerrar Conversa]",shape=box,color=red];
		j580317660 -> j2156753723;
	j2003645374 [label="Angustiante, Nova",shape=box,color=red];
		j2003645374 -> j3908850312;
	j3696122329 [label="Eu também confiava ",shape=box,color=red];
		j3696122329 -> j3908850312;
	j2586223752 [label="Posso usar isso ao meu favor ",shape=box,color=blue];
		j2586223752 -> j4068085558;
		j2586223752 -> j3013841279;
	j57627722 [label="Vi, observei, anotei, estudei, reestudei… hmm… tudo pode ser explicado. Tem alguma origem, pode até ser \"magia\"",shape=box,color=blue];
		j57627722 -> j2586223752;
	j3908850312 [label="Acho que você ainda não sacou",shape=box,color=blue];
		j3908850312 -> j2923509588;
