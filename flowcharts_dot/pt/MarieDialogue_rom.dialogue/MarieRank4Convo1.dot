	j3150615669 [label="+20 Chemistry",color=orange];
		j3150615669 -> j3442865964;
	j3188726046 [label="Os pesadelos que inundam sua mente… a Lua o guia por um caminho árduo, oui?",shape=box,color=blue];
		j3188726046 -> j3631161257;
	j837310600 [label="Mas… farei o meu melhor. Imagino que você pergunte por se preocupar com ele, oui?",shape=box,color=blue];
