		j3794742338 -> j3188726046;
	j2202974640 [label="Ah… é um assunto desconfortável, oui? Desculpe, mas não sei bem como falar sobre isso sem me enrolar.",shape=box,color=blue];
		j2202974640 -> j837310600;
	j1726374748 [label="Acredito que o Lyon tiraria sua própria vida antes de me machucar. Tenho toda a fé nisso, em todos os deuses e demônios…",shape=box,color=blue];
