		j4252934670 -> j484947205;
		j4252934670 -> j4008172688;
	j954285192 [label="Eu temeria que uma borboleta me devorasse antes de temer meu irmão de alma.",shape=box,color=blue];
		j954285192 -> j3631161257;
	j2961921282 [label="Eu gostaria de impedi-lo, para protegê-lo desse desejo de fazer tanto mal a si próprio.",shape=box,color=blue];
		j2961921282 -> j1075785809;
	j1529906412 [label="Só me preocupo que, um dia, ele pode acabar… indo longe demais",shape=box,color=red];
		j1529906412 -> j3631161257;
	j484947205 [label="Precisamos dele inteiro e, especialmente, vivo",shape=box,color=red];
		j484947205 -> j319768433;
	j4008172688 [label="Não quero ter que lidar com o cadáver dele",shape=box,color=red];
		j4008172688 -> j698283448;
	j1075785809 [label="Se há uma coisa que tenho certeza sobre o Lyon, é que ele sempre estará lá quando precisarmos.",shape=box,color=blue];
		j1075785809 -> j1536624357;
	j319768433 [label="Você ecoa as palavras do diabo… a necessidade insensível de soldados descartáveis é tudo que lhe interessa?",shape=box,color=blue];
		j319768433 -> j154685124;
		j319768433 -> j2204610298;
	j698283448 [label="Dégoûtant.",shape=box,color=blue];
		j698283448 -> j1508231473;
	j1536624357 [label="Ele é o grande protetor, le bouclier sacré da Lua… a luz brilhante na escuridão da noite.",shape=box,color=blue];
		j1536624357 -> j7783985;
	j154685124 [label="Não, eu me importo muito com ele… só me preocupo que, quando precisarmos dele, ele pode… não estar lá",shape=box,color=red];
