	j1179065658 [label="Um deles era um menino grande e mais velho, chamado Hugo.",shape=box,color=blue];
		j1179065658 -> j966684134;
	j2868661088 [label="Mas quando eu nasci… deformada, com mes pieds tordus et inutilisables… ah, isso foi demais para ma mère.",shape=box,color=blue];
		j2868661088 -> j2670140890;
	j887512463 [label="Faz sim, valeu",shape=box,color=red];
		j887512463 -> j1722815821;
	j3153416879 [label="Faz sentido até demais, valeu",shape=box,color=red];
		j3153416879 -> j1350338191;
	j2724328058 [label="Entendi foi é nada, mas valeu a tentativa",shape=box,color=red];
		j2724328058 -> j2989419931;
	j966684134 [label="Ele era meio que o líder da matilha. Sempre cuidando para que ninguém me provocasse e que eu tivesse tudo o que precisava.",shape=box,color=blue];
		j966684134 -> j2866205189;
	j2670140890 [label="Existiam aparências a serem mantidas e padrões a serem mantidos.",shape=box,color=blue];
		j2670140890 -> j4259383865;
	j1722815821 [label="Bien! Achei que minhas metáforas iriam me atrapalhar novamente.",shape=box,color=blue];
		j1722815821 -> j1872539763;
	j1350338191 [label="Marie e suas metáforas… ah, bon.",shape=box,color=blue];
		j1350338191 -> j1872539763;
	j2989419931 [label="Mince alors… bem que eu temia que minhas metáforas iriam me atrapalhar novamente.",shape=box,color=blue];
		j2989419931 -> j1872539763;
	j2866205189 [label="Ele até me ajudou a construir as béquilles… você deve chamar isso de… muletas? Que eu podia usar para me arrastar, com pedaços de madeira que achamos.",shape=box,color=blue];
		j2866205189 -> j1128790346;
	j4259383865 [label="Então, o que fazer com a pobre Marie? Fui levada para a Cité de la Lumière, onde certamente eu iria perambular pelas ruas…",shape=box,color=blue];
		j4259383865 -> j1102657978;
	j1872539763 [label="Hmm… ocorre-me que descrever o Lyon como um cão de rua talvez não seja a comparação mais lisonjeira a se fazer…",shape=box,color=blue];
		j1872539763 -> j3991344851;
	j1128790346 [label="Uma manhã, fomos acordá-lo e o encontramos…",shape=box,color=blue];
		j1128790346 -> j3743198522;
	j1102657978 [label="Abandonada para morrer.",shape=box,color=blue];
		j1102657978 -> j4144584376;
		j1102657978 -> j1622408246;
	j3991344851 [label="É… não conte para ele que fiz isso, oui?",shape=box,color=blue];
		j3991344851 -> j1672678032;
	j3743198522 [label="Je… vou poupá-lo dos detalhes… tenho certeza de que você pode presumir o resto.",shape=box,color=blue];
		j3743198522 -> j3007794433;
	j4144584376 [label="Quantos anos você tinha?",shape=box,color=red];
		j4144584376 -> j1148630614;
	j1622408246 [label="Sua família te largou pra morrer?",shape=box,color=red];
		j1622408246 -> j4017436872;
	j1672678032 [label="Boolean LyonStrayDog is now true.",color=orange];
		j1672678032 -> j1879114489;
		j1672678032 -> j2369817978;
	j3007794433 [label="Mas ele nos deixou um bilhete, quase ilegível. Ele era o único das outras crianças que sabia das cartas dele, e fui eu quem teve que lê-la para os outros. ",shape=box,color=blue];
		j3007794433 -> j2317516565;
	j1148630614 [label="6, ou 7? Aos olhos deles, eles se esforçaram ao máximo para me curar por muitos anos. Tutores para me ensinar a andar, aparelhos ortodônticos, calçados…",shape=box,color=blue];
		j1148630614 -> j1774947686;
	j4017436872 [label="Aos olhos deles, eles se esforçaram ao máximo para me curar por muitos anos. Tutores para me ensinar a andar, aparelhos ortodônticos, calçados…",shape=box,color=blue];
		j4017436872 -> j1774947686;
	j1879114489 [label="Achei bem fofo… e ele também vai achar",shape=box,color=red];
		j1879114489 -> j3495253141;
	j2369817978 [label="Pode deixar, seu segredo tá seguro comigo",shape=box,color=red];
		j2369817978 -> j3027426678;
	j2317516565 [label="Ainda me lembro da minha voz travada… mas eu precisava me manter forte. Porque, mesmo assim, eu sabia que tinha um dever para com os outros. ",shape=box,color=blue];
		j2317516565 -> j1006208530;
	j1774947686 [label="Eles estavam cansados desse fardo. Então, mal conseguindo ler e escrever meus números e letras… me vi na lama.",shape=box,color=blue];
		j1774947686 -> j1119508737;
		j1774947686 -> j521196023;
	j3495253141 [label="Quelle horrible personne! J'espère que votre chaise va s'effondrer et vous donner plein d'échardes douloureuses!",shape=box,color=blue];
		j3495253141 -> "Chat ends.";
	j3027426678 [label="Merci! Que alívio…",shape=box,color=blue];
		j3027426678 -> "Chat ends.";
	j1006208530 [label="O Hugo sempre parecia tão feliz… si joyeux. Sempre encarando a vida com uma risada e um sorriso aberto.",shape=box,color=blue];
		j1006208530 -> j3236118240;
	j1119508737 [label="Nossa, que horrível…",shape=box,color=red];
		j1119508737 -> j714426695;
	j521196023 [label="Como você sobreviveu?",shape=box,color=red];
		j521196023 -> j714426695;
	j3236118240 [label="Mesmo quando éramos expulsos, ou quando ele era espancado com um pedaço de pau por roubo, nada parecia incomodá-lo.",shape=box,color=blue];
		j3236118240 -> j968258065;
	j714426695 [label="Check boolean MarieSecretPower",color=orange];
		j714426695 -> j1863125760 [label=true,color=green];
		j714426695 -> j2272619161 [label=false,color=brown];
	j968258065 [label="Mas nunca sabemos a profundidade da dor que os outros sentem em seus corações. E, naquela carta, vi que ele chorou com a Lua.",shape=box,color=blue];
		j968258065 -> j1377948479;
	j1863125760 [label="É como você disse, non? Todos os inconvenientes vêm com um poder secreto.",shape=box,color=blue];
		j1863125760 -> j2272619161;
	j2272619161 [label="O que me tornou une indesirable pour ma mère, tornou-me bastante popular entre as outras crianças de rua.",shape=box,color=blue];
		j2272619161 -> j1600975929;
	j1377948479 [label="Mas agora, ele estava em paz, ao lado dela. Por um tempo, fiquei ressentida por ele ter partido… os outros me procuravam em busca de orientação. Fiquei muito ressentida por ele ter me abandonado.",shape=box,color=blue];
		j1377948479 -> j1674954937;
	j1600975929 [label="O que é mais patético do que uma criança sem pés, oui? Eu ganhava mais em um dia do que eles roubavam em uma semana.",shape=box,color=blue];
		j1600975929 -> j1702917686;
	j1674954937 [label="Mas… com o tempo, passei a entender a verdade disso.",shape=box,color=blue];
		j1674954937 -> j673652814;
	j1702917686 [label="E sempre tive o hábito de compartilhar. Então, eu tinha muitos amigos que cuidavam de mim. Um deles era um garotão mais velho, chamado Hugo.",shape=box,color=blue];
		j1702917686 -> j966684134;
	j673652814 [label="Só podemos nos perdoar por sermos humanos… e perdoar a dor da partida deles.",shape=box,color=blue];
		j673652814 -> j2390082245;
	j2390082245 [label="Pois é a ausência deles que machuca… e o pensamento de que não conseguimos ajudá-los.",shape=box,color=blue];
		j2390082245 -> j179336724;
	j179336724 [label="Os fardos que os outros carregam nunca são nossos para sabermos seu real peso.",shape=box,color=blue];
		j179336724 -> j2865956539;
	j2865956539 [label="E essa é uma grande tragédia… mas é o que significa ser humano.",shape=box,color=blue];
		j2865956539 -> j3011051297;
	j3011051297 [label="Não sei se esta história lhe auxiliou… mas só posso rezar para que tenha ajudado. Preciso partir, o Monsieur Loid está chamando.",shape=box,color=blue];
		j3011051297 -> j4030427575;
		j3011051297 -> j2804173131;
	j4030427575 [label="Valeu, Marie",shape=box,color=red];
		j4030427575 -> j889035299;
	j2804173131 [label="[Ficar em silêncio]",shape=box,color=red];
		j2804173131 -> j3386425480;
	j889035299 [label="+20 Chemistry",color=orange];
		j889035299 -> j133622977;
	j3386425480 [label="+20 Chemistry",color=orange];
		j3386425480 -> j1123121321;
	j133622977 [label="De nada, à bientôt.",shape=box,color=blue];
		j133622977 -> "Chat ends.";
	j1123121321 [label="À la revoyure.",shape=box,color=blue];
		j1123121321 -> "Chat ends.";
}