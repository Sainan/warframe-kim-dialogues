	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j7783985 [label="A dor que ele inflige a si mesmo… ele a faz para ouvir seus próprios pensamentos, para sentir seu próprio corpo. ",shape=box,color=blue];
		j7783985 -> j998197065;
	j3686428384 [label="Me pergunto… quem vai lhe auxiliar quando você estiver no chão e precisar de ajuda.",shape=box,color=blue];
		j3686428384 -> j3172485959;
	j998197065 [label="O céu está cheio de estrelas, e cada uma delas sussurra para ele… sem isso, ele, como a própria Lua, estaria perdido entre elas.",shape=box,color=blue];
		j998197065 -> j238144450;
	j3172485959 [label="Ou você acredita que esse tempo já passou, e que você está acima de tal punição universal?",shape=box,color=blue];
		j3172485959 -> j698283448;
	j238144450 [label="E assim como a Lua, ele passa por fases. Ele é consumido pelo Void para brilhar fortemente, ser um farol… para podermos caminhar na escuridão sem medo.",shape=box,color=blue];
		j238144450 -> j829867535;
