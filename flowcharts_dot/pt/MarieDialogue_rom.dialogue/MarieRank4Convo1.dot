	j3442865964 [label="[Todas as conversas subsequentes que envolverem automutilação serão evitadas]",shape=box,color=blue];
		j3442865964 -> "Chat ends.";
	j3631161257 [label="Receio que seja algo difícil de falar sobre… sei que é algo que não deveria ser fácil para ninguém, oui?",shape=box,color=blue];
		j3631161257 -> j2961921282;
	j1391806268 [label="O Warframe de onde veio o soro dele é conhecido por… é, você sabe bem",shape=box,color=red];
