		j718565515 -> j2550371606;
	j2747006314 [label="+5 Chemistry",color=orange];
		j2747006314 -> j1831356939;
	j1333098651 [label="Por que você detesta tanto ele?",shape=box,color=red];
		j1333098651 -> j1713030442;
	j412904693 [label="Por que o Entrati deixou ele com você e o Lyon?",shape=box,color=red];
		j412904693 -> j3627502507;
	j3592086323 [label="Queria saber como vocês se conheceram?",shape=box,color=red];
		j3592086323 -> j2960681455;
	j2903129575 [label="Estamos de acordo",shape=box,color=red];
		j2903129575 -> j2352956880;
	j2550371606 [label="Ah, e agora me sinto realmente uma idiota. Sim, claro, você sabe como é matar em nome de um \"propósito\", como você disse… Claro que você tentaria entender alguém que fez a mesma coisa.",shape=box,color=blue];
		j2550371606 -> j3206369681;
	j1831356939 [label="Ah, e agora me sinto realmente uma idiota. Sim, claro, você sabe como é viver e morrer repetidamente… Claro que gostaria de conhecer alguém que já passou pela mesma coisa.",shape=box,color=blue];
		j1831356939 -> j3206369681;
	j1713030442 [label="Não é evidente? O comportamento dele é como o de um grande felino que insiste em marcar território e derrubar coisas das prateleiras.",shape=box,color=blue];
		j1713030442 -> j1124178286;
		j1713030442 -> j3820379427;
	j3627502507 [label="Quando o Cardeal Dimanche, o Entrati, partiu pela última vez, deixou o diabo à nossa porta. Despedaçado, sangrando e mal conseguindo se lembrar do próprio nome.",shape=box,color=blue];
		j3627502507 -> j4187637629;
	j2960681455 [label="Uma tempestade ocorria na noite em que o diabo veio até nós. Um estrondo terrível abalou as paredes da Cathédrale.",shape=box,color=blue];
		j2960681455 -> j4132570505;
	j2352956880 [label="Boolean MarieRoatheWarning is now false.",color=orange];
		j2352956880 -> j62946517;
	j3206369681 [label="Vamos fazer um acordo. Quando você acreditar que eu não consigo compreender ou não consigo ter simpatia pelas histórias dos outros, por favor, reconsidere, oui?",shape=box,color=blue];
		j3206369681 -> j2847954748;
	j1124178286 [label="Pessoalmente… gosto bastante de gatos",shape=box,color=red];
		j1124178286 -> j1438434065;
	j3820379427 [label="Você não gosta de gatos?",shape=box,color=red];
		j3820379427 -> j4207809766;
	j4187637629 [label="Agora eu sei que ele tinha acabado de receber o soro, e a transformação, se não for voluntária, é… dolorosa.",shape=box,color=blue];
		j4187637629 -> j513379085;
	j4132570505 [label="Check boolean MarieLyonVisions",color=orange];
		j4132570505 -> j3171021797 [label=true,color=green];
		j4132570505 -> j1907445738 [label=false,color=brown];
	j62946517 [label="Magnifique! Então, você queria me perguntar sobre o próprio diabo, não é? O que gostaria de saber?",shape=box,color=blue];
		j62946517 -> j1333098651;
		j62946517 -> j412904693;
		j62946517 -> j3592086323;
	j1438434065 [label="Gatos são maravilhosos, quando são gatos! Ele é um homem adulto, que coleciona muitos anos de vida já!",shape=box,color=blue];
		j1438434065 -> j237869269;
	j4207809766 [label=" Eu gosto, quando um gato é um gato! Ele é um homem, um homem adulto, que coleciona muitos anos de vida já!",shape=box,color=blue];
		j4207809766 -> j237869269;
	j513379085 [label="Le Cardeal olhou para o diabo e falou: \"Uriel, Herege de Xata, exilado, responda: os Orokin poderão ser perdoados?\"",shape=box,color=blue];
		j513379085 -> j3029692951;
	j3171021797 [label="Desta vez, se Lyon lhe contar sobre a tempestade que abalou nossa casa, ele estará falando da realidade, a que compartilhamos.",shape=box,color=blue];
		j3171021797 -> j1907445738;
	j1907445738 [label="Acho que foi um clichê maravilhoso, ver tamanho mal surgir em meio a uma tempestade dessas.",shape=box,color=blue];
		j1907445738 -> j3627502507;
	j237869269 [label="Muito mais anos do que qualquer ser humano, azul ou transfigurado além do reconhecimento, deveria ter.",shape=box,color=blue];
		j237869269 -> j3782391711;
		j237869269 -> j2639939369;
		j237869269 -> j3240572767;
	j3029692951 [label="E num estrondo de trovão, como se os próprios deuses o estivessem chamando, le Cardeal simplesmente desapareceu.",shape=box,color=blue];
		j3029692951 -> j3374664684;
	j3782391711 [label="Alterar geneticamente a própria forma era moda na época dos Orokin. Mas eles eram tão humanos quanto a gente é… ou era, eu acho",shape=box,color=red];
		j3782391711 -> j415531936;
	j2639939369 [label="Tirando a cauda, ele honestamente parece… mais humano do que muitos dos Orokin daquela época",shape=box,color=red];
		j2639939369 -> j2784098199;
	j3240572767 [label="Se preocupa não, te acho muito mais bonita do que ele",shape=box,color=red];
		j3240572767 -> j2617491924;
	j3374664684 [label="E nos deixou com… ele. O diabo.",shape=box,color=blue];
		j3374664684 -> j3387286501;
	j415531936 [label="Sim, acho que nem sei mais o que sou. Parte Marie, parte… \"Wisp\", parte… seja lá o que for das Coisas Infestadas que agora compartilham minhas veias.",shape=box,color=blue];
		j415531936 -> j305845240;
	j2784098199 [label="Sim, eu estava olhando para um antigo retrato do le Cardeal, quando ele parecia mais com o diabo. Ele me contou sobre os costumes Orokin, como eles costumavam se transformar.",shape=box,color=blue];
		j2784098199 -> j462921058;
	j2617491924 [label="Check boolean DrifterMarie",color=orange];
		j2617491924 -> j2588249650 [label=true,color=green];
		j2617491924 -> j3320191961 [label=false,color=brown];
	j3387286501 [label="O Cardeal o deixou para nós… cuidarmos da sua alma, talvez? Ou pelo menos cuidar das correntes que o prendem. Je préférerais le renvoyer en enfer.",shape=box,color=blue];
		j3387286501 -> j1610895747;
		j3387286501 -> j1233411086;
	j305845240 [label="Uma conversa para outra hora, quem sabe.",shape=box,color=blue];
		j305845240 -> j3746550014;
	j462921058 [label="Quão semelhante e, ao mesmo tempo, estranho era o modo como as mulheres da minha época usavam perucas ostentosas que alcançavam o céu, ou vestidos que poderiam abrigar um orfanato inteiro sem muito esforço!",shape=box,color=blue];
		j462921058 -> j2289297483;
	j2588249650 [label="Você precisa parar de me fazer corar! O Monsieur Loid vai se perguntar o que estou fazendo aqui para ficar assim!",shape=box,color=blue];
		j2588249650 -> j1635379615;
	j3320191961 [label="Boolean DrifterMarie is now true.",color=orange];
		j3320191961 -> j143469334;
	j1610895747 [label="Você acha que todo mundo pode ser perdoado?",shape=box,color=red];
		j1610895747 -> j1103293958;
	j1233411086 [label="Não tem nada que você goste nele? Nadinha?",shape=box,color=red];
		j1233411086 -> j1543716657;
	j3746550014 [label="Boolean MarieInfestation is now true.",color=orange];
		j3746550014 -> j2809096011;
	j2289297483 [label="Humanos são o que sempre serão: infelizes em suas próprias imagens dadas pelo Sol. Ansiosos para trabalhar a própria carne como se fosse argila. Eu não sou exceção, suponho.",shape=box,color=blue];
		j2289297483 -> j2120768044;
	j1635379615 [label="Além disso, não é tão difícil ser mais bonita que o diabo, non? Os traços dele são bonitos, mas o azul… ce n'est pas pour moi.",shape=box,color=blue];
		j1635379615 -> j2234807743;
	j143469334 [label="Ah! Você está me fazendo corar! O que o Monsieur Loid vai pensar se me vir sentada aqui, assim?",shape=box,color=blue];
		j143469334 -> j1635379615;
	j1103293958 [label="Eu? Sim, acredito que todas as almas são capazes de obter o perdão por suas transgressões.",shape=box,color=blue];
		j1103293958 -> j3265826213;
	j1543716657 [label="Nada, absolutamente nada.",shape=box,color=blue];
		j1543716657 -> j651682736;
		j1543716657 -> j3994771137;
	j2809096011 [label="Meu problema é que ele tem todo o ego assassino de um felino, mas nada da natureza encantadora de ser um ser pequeno e adorável.",shape=box,color=blue];
		j2809096011 -> j1552101973;
	j2120768044 [label="Toda feliz em tomar o soro que me tornou parte Marie, parte… \"Wisp\" e parte… seja lá o que for das coisas infestadas que agora compartilham minhas veias.",shape=box,color=blue];
		j2120768044 -> j305845240;
	j2234807743 [label="Aceito seu elogio, se foi sincero. Simplesmente me assustei. Podemos… voltar ao assunto em questão?",shape=box,color=blue];
		j2234807743 -> j3746550014;
	j3265826213 [label="A pergunta é… será que ele sequer acha que isso é necessário para ele?",shape=box,color=blue];
		j3265826213 -> j359589058;
	j651682736 [label="Bem… agradeço pela história. Então, o Entrati quer que ele seja… perdoado? Mas por quê? Por causa de Tau? Ou só por ser um Orokin?",shape=box,color=red];
		j651682736 -> j3604592944;
	j3994771137 [label="Tudo bem, eu acredito em você, não acho que você mentiria sobre isso",shape=box,color=red];
		j3994771137 -> j4211019338;
