		694 -> 670;
		694 -> 671;
		694 -> 672;
	689 [label="Gatos são maravilhosos, quando são gatos! Ele é um homem adulto, que coleciona muitos anos de vida já!",shape=box,color=blue];
		689 -> 695;
	690 [label=" Eu gosto, quando um gato é um gato! Ele é um homem, um homem adulto, que coleciona muitos anos de vida já!",shape=box,color=blue];
		690 -> 695;
	691 [label="Le Cardeal olhou para o diabo e falou: \"Uriel, Herege de Xata, exilado, responda: os Orokin poderão ser perdoados?\"",shape=box,color=blue];
		691 -> 696;
	693 [label="Desta vez, se Lyon lhe contar sobre a tempestade que abalou nossa casa, ele estará falando da realidade, a que compartilhamos.",shape=box,color=blue];
		693 -> 692;
	692 [label="Acho que foi um clichê maravilhoso, ver tamanho mal surgir em meio a uma tempestade dessas.",shape=box,color=blue];
		692 -> 678;
	695 [label="Muito mais anos do que qualquer ser humano, azul ou transfigurado além do reconhecimento, deveria ter.",shape=box,color=blue];
		695 -> 697;
		695 -> 698;
		695 -> 3906;
	696 [label="E num estrondo de trovão, como se os próprios deuses o estivessem chamando, le Cardeal simplesmente desapareceu.",shape=box,color=blue];
		696 -> 699;
	697 [label="Alterar geneticamente a própria forma era moda na época dos Orokin. Mas eles eram tão humanos quanto a gente é… ou era, eu acho",shape=box,color=red];
		697 -> 700;
	698 [label="Tirando a cauda, ele honestamente parece… mais humano do que muitos dos Orokin daquela época",shape=box,color=red];
		698 -> 701;
	3906 [label="Se preocupa não, te acho muito mais bonita do que ele",shape=box,color=red];
		3906 -> 3907;
	699 [label="E nos deixou com… ele. O diabo.",shape=box,color=blue];
		699 -> 702;
	700 [label="Sim, acho que nem sei mais o que sou. Parte Marie, parte… \"Wisp\", parte… seja lá o que for das Coisas Infestadas que agora compartilham minhas veias.",shape=box,color=blue];
		700 -> 703;
	701 [label="Sim, eu estava olhando para um antigo retrato do le Cardeal, quando ele parecia mais com o diabo. Ele me contou sobre os costumes Orokin, como eles costumavam se transformar.",shape=box,color=blue];
		701 -> 704;
	3907 [label="Check boolean DrifterMarie",color=orange];
		3907 -> 3908 [label=true,color=green];
		3907 -> 3909 [label=false,color=brown];
	702 [label="O Cardeal o deixou para nós… cuidarmos da sua alma, talvez? Ou pelo menos cuidar das correntes que o prendem. Je préférerais le renvoyer en enfer.",shape=box,color=blue];
		702 -> 705;
		702 -> 706;
	703 [label="Uma conversa para outra hora, quem sabe.",shape=box,color=blue];
		703 -> 707;
	704 [label="Quão semelhante e, ao mesmo tempo, estranho era o modo como as mulheres da minha época usavam perucas ostentosas que alcançavam o céu, ou vestidos que poderiam abrigar um orfanato inteiro sem muito esforço!",shape=box,color=blue];
		704 -> 708;
	3908 [label="Você precisa parar de me fazer corar! O Monsieur Loid vai se perguntar o que estou fazendo aqui para ficar assim!",shape=box,color=blue];
		3908 -> 3911;
	3909 [label="Update boolean DrifterMarie",color=orange];
		3909 -> 3910;
	705 [label="Você acha que todo mundo pode ser perdoado?",shape=box,color=red];
		705 -> 709;
	706 [label="Não tem nada que você goste nele? Nadinha?",shape=box,color=red];
		706 -> 710;
	707 [label="Update boolean MarieInfestation",color=orange];
		707 -> 711;
	708 [label="Humanos são o que sempre serão: infelizes em suas próprias imagens dadas pelo Sol. Ansiosos para trabalhar a própria carne como se fosse argila. Eu não sou exceção, suponho.",shape=box,color=blue];
		708 -> 712;
	3911 [label="Além disso, não é tão difícil ser mais bonita que o diabo, non? Os traços dele são bonitos, mas o azul… ce n'est pas pour moi.",shape=box,color=blue];
		3911 -> 3912;
	3910 [label="Ah! Você está me fazendo corar! O que o Monsieur Loid vai pensar se me vir sentada aqui, assim?",shape=box,color=blue];
		3910 -> 3911;
	709 [label="Eu? Sim, acredito que todas as almas são capazes de obter o perdão por suas transgressões.",shape=box,color=blue];
		709 -> 713;
	710 [label="Nada, absolutamente nada.",shape=box,color=blue];
		710 -> 714;
		710 -> 715;
	711 [label="Meu problema é que ele tem todo o ego assassino de um felino, mas nada da natureza encantadora de ser um ser pequeno e adorável.",shape=box,color=blue];
		711 -> 716;
	712 [label="Toda feliz em tomar o soro que me tornou parte Marie, parte… \"Wisp\" e parte… seja lá o que for das coisas infestadas que agora compartilham minhas veias.",shape=box,color=blue];
		712 -> 703;
	3912 [label="Aceito seu elogio, se foi sincero. Simplesmente me assustei. Podemos… voltar ao assunto em questão?",shape=box,color=blue];
		3912 -> 707;
	713 [label="A pergunta é… será que ele sequer acha que isso é necessário para ele?",shape=box,color=blue];
		713 -> 717;
	714 [label="Bem… agradeço pela história. Então, o Entrati quer que ele seja… perdoado? Mas por quê? Por causa de Tau? Ou só por ser um Orokin?",shape=box,color=red];
		714 -> 718;
	715 [label="Tudo bem, eu acredito em você, não acho que você mentiria sobre isso",shape=box,color=red];
		715 -> 719;
	716 [label="Ele se coloca em um pedestal. Mata sem nem hesitar. Brinca com seus inimigos como se não passassem de um rato encurralado.",shape=box,color=blue];
		716 -> 702;
	717 [label="O perdão não pode ser dado àqueles que não o buscam. Seria mais fácil ensinar um peixe a voar.",shape=box,color=blue];
		717 -> 720;
	718 [label="Não sei… e a outra questão permanece: será que ele sequer acha que precisa de perdão?",shape=box,color=blue];
		718 -> 717;
	719 [label="Fie! Tá, tudo bem… tem uma coisa que compartilhamos: uma tentação perversa por doces. O diabo costumava voltar à Catedral depois de roubar doces das lojas, sem pagar por eles.",shape=box,color=blue];
		719 -> 721;
	720 [label="Mas, se quiser compreender o desafio intransponível que você enfrenta para vencer essa guerra, fale pessoalmente com ele sobre isso.",shape=box,color=blue];
		720 -> 722;
	721 [label="Eu explicava que isso era roubo, e ele dava um longo discurso sobre como os Orokin logo governariam o sistema solar, então, tecnicamente, isso não seria roubo no panorama geral…",shape=box,color=blue];
		721 -> 723;
	722 [label="Só lhe desejo sorte nisso.",shape=box,color=blue];
		722 -> 724;
	723 [label="Eu gritava com ele, e o Lyon era forçado a intervir…",shape=box,color=blue];
		723 -> 725;
		723 -> 726;
	724 [label="+10 Chemistry",color=orange];
		724 -> 727;
	725 [label="E quanto aos doces?",shape=box,color=red];
		725 -> 728;
	726 [label="Já se perguntou se ele só tava trazendo tudo de volta justamente pra dividir com vocês?",shape=box,color=red];
		726 -> 729;
	727 [label="Chat ends.",color=orange];
	728 [label="Ah, não podíamos desperdiçar comida, certo? Seria pecado comê-los, mas seria um pecado ainda maior jogá-los no lixo. Então, nós os degustamos.",shape=box,color=blue];
		728 -> 730;
	729 [label="Se esse for o caso, ele fez um péssimo serviço em demonstrar isso. Mas… você pode ter razão. De qualquer forma, não podíamos desperdiçar comida, certo? Seria pecado comê-los, mas seria um pecado ainda maior jogá-los no lixo. Então, nós os degustamos.",shape=box,color=blue];
		729 -> 730;
	730 [label="+10 Chemistry",color=orange];
		730 -> 731;
	731 [label="Hmm… parando para refletir, talvez isso fosse um hábito dele… trazer mais do que conseguia consumir sozinho…",shape=box,color=blue];
		731 -> 732;
	732 [label="Update boolean MarieRoathePastry1",color=orange];
		732 -> 733;
