	617 [label="+5 Chemistry",color=orange];
		617 -> 620;
	624 [label="Me surpreende que você venha até mim novamente para saber minha opinião. Você foi bastante claro anteriormente. Não quer me ouvir falar mal dele e da sua laia.",shape=box,color=blue];
		624 -> 633;
		624 -> 634;
	623 [label="Para ser sincera, não sei se deveria continuar com esta conversa. Você parece atraído por ele comme un papillon vers une flamme.",shape=box,color=blue];
		623 -> 631;
		623 -> 632;
	622 [label="Ainda o deseja como aliado? Adicioná-lo à sua matilha é um jogo perigoso, lobo. Corre o risco dele rasgar sua garganta quando você menos esperar.",shape=box,color=blue];
		622 -> 629;
		622 -> 630;
	621 [label="Estou surpresa que você tenha vindo até mim. Claramente tenho uma péssima opinião sobre esse demônio.",shape=box,color=blue];
		621 -> 627;
		621 -> 628;
	619 [label="Não me surpreenderia se houvesse um! Parece que temos todos os outros tipos de animais selvagens aqui.",shape=box,color=blue];
		619 -> 625;
	620 [label="Oui, não é encantador? Muitas vezes digo algo ao Monsieur Loid e ele me olha completamente perdido.",shape=box,color=blue];
		620 -> 626;
	633 [label="Reagi mal e peço desculpas por isso. Não quero condená-lo por suas ações ainda, quero entendê-lo de todos os ângulos.",shape=box,color=red];
		633 -> 642;
	634 [label="Ele levou uma vida que é difícil de entender, mas tava curioso pra saber como vocês se conheceram",shape=box,color=red];
		634 -> 643;
	631 [label="Estou só tentando descobrir o motivo pra ele ser do jeito que é. Quero entendê-lo.",shape=box,color=red];
		631 -> 640;
	632 [label="Se eu souber mais sobre ele, talvez isso me ajude a descobrir como guiá-lo por um caminho um pouco… mais benigno.",shape=box,color=red];
		632 -> 641;
	629 [label="Eu sei, mas não consigo odiá-lo por ter feito o que precisava pra servir ao seu povo. Eu tive que fazer o mesmo",shape=box,color=red];
		629 -> 638;
	630 [label="Ele é um dos Orokin mais perigosos que o império já conheceu, seria burrice não querer esse tipo de ajuda",shape=box,color=red];
		630 -> 639;
	627 [label="Eu sei, mas você deve ter uma ideia melhor sobre quem ele é. Quero entendê-lo melhor",shape=box,color=red];
		627 -> 636;
