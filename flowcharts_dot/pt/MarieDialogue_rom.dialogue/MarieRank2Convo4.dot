		j1527273639 -> j1255468603;
	j647740365 [label="Add 1 to Thermostat counter",color=orange];
		j647740365 -> j2553629308;
	j1594322668 [label="Não consigo imaginar que, para a maioria das pessoas que não se cercam de cabeças voadoras e animais falantes, um elefante não seja assunto de conversa.",shape=box,color=blue];
		j1594322668 -> j4005640397;
	j2302187780 [label="+5 Chemistry",color=orange];
		j2302187780 -> j3260447425;
	j2116979277 [label="E você presume que eu não entenderia? Não sou tola, não fui reduzida à histeria, apesar de ter sido transportada e transfigurada.",shape=box,color=blue];
		j2116979277 -> j1613248428;
		j2116979277 -> j1304532302;
	j2368286438 [label="Entendê-lo até que ponto, essa é a minha preocupação. Mas você não precisa do meu sermão, eu não sou sua mãe e nem desejo estragar essa amizade em seus primórdios…",shape=box,color=blue];
		j2368286438 -> j1687343584;
	j1812599486 [label="+5 Chemistry",color=orange];
		j1812599486 -> j388797527;
	j1535032301 [label="+5 Chemistry",color=orange];
		j1535032301 -> j1149190002;
	j3891427772 [label="Eu simplesmente recomendo ter cautela. Ele poderia encantar Lua para lhe dar as estrelas do céu, eu acho.",shape=box,color=blue];
		j3891427772 -> j3566428287;
	j1255468603 [label="Entendê-lo até que ponto, essa é a minha preocupação. Mas você não precisa do meu sermão.",shape=box,color=blue];
		j1255468603 -> j1607295288;
	j2553629308 [label="+5 Chemistry",color=orange];
		j2553629308 -> j4075794819;
	j4005640397 [label="Acho que respondi minha própria pergunta, não é?",shape=box,color=blue];
		j4005640397 -> j3572649808;
	j3260447425 [label="Agradeço o pedido de desculpas e o aceito, mas considere que fui transportada e transfigurada e me encontro cercada pelo impossível. ",shape=box,color=blue];
		j3260447425 -> j2194595362;
	j1613248428 [label="Deixa pra lá, vou falar diretamente com o diabo",shape=box,color=red];
		j1613248428 -> j4014689105;
	j1304532302 [label="Desculpa, não queria discutir com você… não foi isso que eu quis dizer",shape=box,color=red];
		j1304532302 -> j510805016;
		j1304532302 -> j2033504452;
	j1687343584 [label="Simplesmente me preocupo com você. Ele é um monstro habilidoso e manipulador… ",shape=box,color=blue];
		j1687343584 -> j1877520147;
	j388797527 [label="E eu lhe declararia uma Santidade do Sol por tentar fazer tal coisa.",shape=box,color=blue];
		j388797527 -> j1877520147;
	j1149190002 [label="Oui, a maldição do soldado… queime a cidade para salvar o país. Mate o homem para salvar a família. Mas onde termina o horror ?",shape=box,color=blue];
		j1149190002 -> j3745181430;
	j3566428287 [label="Lembre-se de quem e o que ele é, no fim do dia… não um deus, nem mesmo um monstro, mas um homem. Um homem que se considera muito importante.",shape=box,color=blue];
		j3566428287 -> j1877520147;
	j1607295288 [label="Acho que ele poderia encantar a Lua para que lhe desse as estrelas do céu. Cuidado, é tudo o que posso dizer.",shape=box,color=blue];
		j1607295288 -> j1877520147;
	j4075794819 [label="Então você é sábio em não dar ouvidos às suas palavras melosas. Ele poderia encantar Lua para lhe dar as estrelas do céu, eu acho.",shape=box,color=blue];
		j4075794819 -> j1877520147;
	j3572649808 [label="É… significa \"podemos falar sobre o assunto que todos estamos evitando, como se não estivéssemos falando do elefante gigante na sala\"",shape=box,color=red];
		j3572649808 -> j2022242294;
	j2194595362 [label="Quando você acreditar que eu não consigo compreender ou não consigo ter simpatia pelas histórias dos outros, por favor, reconsidere, oui?",shape=box,color=blue];
		j2194595362 -> j2847954748;
	j4014689105 [label="Qu'il en soit ainsi.",shape=box,color=blue];
		j4014689105 -> "Chat ends.";
	j510805016 [label="Ele é um soldado, teve que fazer coisas terríveis em nome de um \"propósito maior\". Eu sei como é… às vezes, esse tipo de vida te transforma em algo… enfim, como ele",shape=box,color=red];
		j510805016 -> j718565515;
	j2033504452 [label="Ele viveu por centenas, talvez até milhares de anos. Quem sabe o que isso realmente faz com alguém? Quanta dor, quanto sofrimento? Eu sei como é",shape=box,color=red];
		j2033504452 -> j2747006314;
	j1877520147 [label="Mas você queria me perguntar sobre o próprio diabo, não é? O que gostaria de saber?",shape=box,color=blue];
		j1877520147 -> j1333098651;
		j1877520147 -> j412904693;
		j1877520147 -> j3592086323;
	j3745181430 [label="Devemos ver a guerra através dos olhos de um estatístico, porque se a víssemos através dos olhos daqueles perdidos em batalhas, nunca deixaríamos de chorar.",shape=box,color=blue];
		j3745181430 -> j1877520147;
	j2022242294 [label="E se eu pudesse dar um segundo palpite sobre a natureza deste éléphant… seria um de pele azul ?",shape=box,color=blue];
		j2022242294 -> j3218359144;
	j2847954748 [label="E, da minha parte, reconsiderarei dizer a você o que deve ou não fazer.",shape=box,color=blue];
		j2847954748 -> j1613248428;
		j2847954748 -> j2903129575;
