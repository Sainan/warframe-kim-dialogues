	j3544270910 [label="+5 Chemistry",color=orange];
		j3544270910 -> j1381721727;
	j792218440 [label="+5 Chemistry",color=orange];
		j792218440 -> j1948780399;
	j2985226122 [label="Me surpreende que você venha até mim novamente para saber minha opinião. Você foi bastante claro anteriormente. Não quer me ouvir falar mal dele e da sua laia.",shape=box,color=blue];
		j2985226122 -> j1926332524;
		j2985226122 -> j1448973555;
	j3364629638 [label="Para ser sincera, não sei se deveria continuar com esta conversa. Você parece atraído por ele comme un papillon vers une flamme.",shape=box,color=blue];
		j3364629638 -> j1833937561;
		j3364629638 -> j4088616771;
	j3147269463 [label="Ainda o deseja como aliado? Adicioná-lo à sua matilha é um jogo perigoso, lobo. Corre o risco dele rasgar sua garganta quando você menos esperar.",shape=box,color=blue];
		j3147269463 -> j3375107616;
		j3147269463 -> j4022660367;
	j470733038 [label="Estou surpresa que você tenha vindo até mim. Claramente tenho uma péssima opinião sobre esse demônio.",shape=box,color=blue];
		j470733038 -> j181752537;
		j470733038 -> j2928126665;
	j1381721727 [label="Não me surpreenderia se houvesse um! Parece que temos todos os outros tipos de animais selvagens aqui.",shape=box,color=blue];
		j1381721727 -> j1405734433;
	j1948780399 [label="Oui, não é encantador? Muitas vezes digo algo ao Monsieur Loid e ele me olha completamente perdido.",shape=box,color=blue];
		j1948780399 -> j2265041535;
	j1926332524 [label="Reagi mal e peço desculpas por isso. Não quero condená-lo por suas ações ainda, quero entendê-lo de todos os ângulos.",shape=box,color=red];
		j1926332524 -> j21904118;
	j1448973555 [label="Ele levou uma vida que é difícil de entender, mas tava curioso pra saber como vocês se conheceram",shape=box,color=red];
		j1448973555 -> j418634711;
	j1833937561 [label="Estou só tentando descobrir o motivo pra ele ser do jeito que é. Quero entendê-lo.",shape=box,color=red];
		j1833937561 -> j358907929;
	j4088616771 [label="Se eu souber mais sobre ele, talvez isso me ajude a descobrir como guiá-lo por um caminho um pouco… mais benigno.",shape=box,color=red];
		j4088616771 -> j557245053;
	j3375107616 [label="Eu sei, mas não consigo odiá-lo por ter feito o que precisava pra servir ao seu povo. Eu tive que fazer o mesmo",shape=box,color=red];
		j3375107616 -> j1779781307;
	j4022660367 [label="Ele é um dos Orokin mais perigosos que o império já conheceu, seria burrice não querer esse tipo de ajuda",shape=box,color=red];
		j4022660367 -> j2107815046;
	j181752537 [label="Eu sei, mas você deve ter uma ideia melhor sobre quem ele é. Quero entendê-lo melhor",shape=box,color=red];
		j181752537 -> j1527273639;
	j2928126665 [label="Exatamente por isso que estou perguntando sobre ele. Quero entender ele, e não confio muito na maneira como ele conta sua versão dos fatos",shape=box,color=red];
		j2928126665 -> j647740365;
	j1405734433 [label="O que significa essa expressão? Se há um elefante na sala, por que não falaríamos sobre isso?",shape=box,color=blue];
		j1405734433 -> j1594322668;
	j2265041535 [label="E para um homem que poderia ter sido servente da própria Rainha, fico orgulhosa disso.",shape=box,color=blue];
		j2265041535 -> j1405734433;
	j21904118 [label="Add 1 to Thermostat counter",color=orange];
