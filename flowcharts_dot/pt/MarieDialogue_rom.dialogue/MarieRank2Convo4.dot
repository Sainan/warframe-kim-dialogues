		608 -> 611;
	606 [label="Vejo apenas um peixe, um pássaro e… seja lá o que for o Monsieur Tagfer. Vejo muitas coisas estranhas neste Sanctum, mas nenhum éléphant — é uma piada?",shape=box,color=blue];
