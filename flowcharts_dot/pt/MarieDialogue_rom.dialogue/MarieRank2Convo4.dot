	j1937097135 [label="Posso perguntar sobre o Roathe? Ou isso seria desagradável?",shape=box,color=red];
		j1937097135 -> j803715332;
	j2802010438 [label="Posso te perguntar sobre o elefante na sala?",shape=box,color=red];
		j2802010438 -> j1284986931;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j803715332 [label="Ce diable est un imbécile qui se croit au-dessus de tout reproche! Je préfèrerais boire un pot de vernis à bois plutôt que de passer une minute de plus à l'écouter s'enorgueillir comme un chat qui se lèche le pelage!",shape=box,color=blue];
		j803715332 -> j2283634878;
		j803715332 -> j1101517320;
	j1284986931 [label="Quoi! Où ça? Un éléphant?!",shape=box,color=blue];
		j1284986931 -> j1309170936;
	"Chat ends." [color=orange];
	j2283634878 [label="Isso foi incrivelmente criativo",shape=box,color=red];
		j2283634878 -> j2470476821;
	j1101517320 [label="Bom… vou assumir que nada disso foi gentil",shape=box,color=red];
		j1101517320 -> j1170103858;
	j1309170936 [label="Vejo apenas um peixe, um pássaro e… seja lá o que for o Monsieur Tagfer. Vejo muitas coisas estranhas neste Sanctum, mas nenhum éléphant — é uma piada?",shape=box,color=blue];
		j1309170936 -> j4118873704;
	j2470476821 [label="+5 Chemistry",color=orange];
		j2470476821 -> j314501009;
	j1170103858 [label="+5 Chemistry",color=orange];
		j1170103858 -> j3029070333;
	j4118873704 [label="Ah! Foi mal, é uma expressão que os meus amigos de 1999 me ensinaram… ",shape=box,color=red];
		j4118873704 -> j1837559283;
		j4118873704 -> j245337963;
	j314501009 [label="Merci. Foi criativo, mas você me fez uma pergunta, e minha ira não deveria ter sido direcionada a você, perdão.",shape=box,color=blue];
		j314501009 -> j3218359144;
	j3029070333 [label="Não foi. Perdão, eu não deveria ter falado assim.",shape=box,color=blue];
		j3029070333 -> j3218359144;
	j1837559283 [label="Não quis dizer no sentido literal",shape=box,color=red];
		j1837559283 -> j3544270910;
	j245337963 [label="Agora entendo por que eles sempre acham muito fofo quando me confundo…",shape=box,color=red];
		j245337963 -> j792218440;
	j3218359144 [label="Evaluate expressions",color=orange];
		j3218359144 -> j2985226122 [label="MarieRoatheWarning",color=purple];
		j3218359144 -> j3364629638 [label="DrifterRoathe",color=purple];
		j3218359144 -> j3147269463 [label="MarieRoatheSoldier",color=purple];
