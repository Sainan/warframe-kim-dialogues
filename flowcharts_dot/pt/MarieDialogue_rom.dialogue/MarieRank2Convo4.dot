	635 [label="Não consigo imaginar que, para a maioria das pessoas que não se cercam de cabeças voadoras e animais falantes, um elefante não seja assunto de conversa.",shape=box,color=blue];
		635 -> 644;
	651 [label="+5 Chemistry",color=orange];
		651 -> 660;
	652 [label="E você presume que eu não entenderia? Não sou tola, não fui reduzida à histeria, apesar de ter sido transportada e transfigurada.",shape=box,color=blue];
		652 -> 661;
		652 -> 662;
	649 [label="Entendê-lo até que ponto, essa é a minha preocupação. Mas você não precisa do meu sermão, eu não sou sua mãe e nem desejo estragar essa amizade em seus primórdios…",shape=box,color=blue];
		649 -> 658;
	650 [label="+5 Chemistry",color=orange];
		650 -> 659;
	647 [label="+5 Chemistry",color=orange];
		647 -> 656;
	648 [label="Eu simplesmente recomendo ter cautela. Ele poderia encantar Lua para lhe dar as estrelas do céu, eu acho.",shape=box,color=blue];
		648 -> 657;
	645 [label="Entendê-lo até que ponto, essa é a minha preocupação. Mas você não precisa do meu sermão.",shape=box,color=blue];
		645 -> 654;
	646 [label="+5 Chemistry",color=orange];
		646 -> 655;
	644 [label="Acho que respondi minha própria pergunta, não é?",shape=box,color=blue];
		644 -> 653;
	660 [label="Agradeço o pedido de desculpas e o aceito, mas considere que fui transportada e transfigurada e me encontro cercada pelo impossível. ",shape=box,color=blue];
		660 -> 666;
	661 [label="Deixa pra lá, vou falar diretamente com o diabo",shape=box,color=red];
		661 -> 667;
	662 [label="Desculpa, não queria discutir com você… não foi isso que eu quis dizer",shape=box,color=red];
		662 -> 668;
		662 -> 669;
	658 [label="Simplesmente me preocupo com você. Ele é um monstro habilidoso e manipulador… ",shape=box,color=blue];
		658 -> 664;
	659 [label="E eu lhe declararia uma Santidade do Sol por tentar fazer tal coisa.",shape=box,color=blue];
		659 -> 664;
	656 [label="Oui, a maldição do soldado… queime a cidade para salvar o país. Mate o homem para salvar a família. Mas onde termina o horror ?",shape=box,color=blue];
		656 -> 665;
	657 [label="Lembre-se de quem e o que ele é, no fim do dia… não um deus, nem mesmo um monstro, mas um homem. Um homem que se considera muito importante.",shape=box,color=blue];
		657 -> 664;
	654 [label="Acho que ele poderia encantar a Lua para que lhe desse as estrelas do céu. Cuidado, é tudo o que posso dizer.",shape=box,color=blue];
		654 -> 664;
	655 [label="Então você é sábio em não dar ouvidos às suas palavras melosas. Ele poderia encantar Lua para lhe dar as estrelas do céu, eu acho.",shape=box,color=blue];
		655 -> 664;
	653 [label="É… significa \"podemos falar sobre o assunto que todos estamos evitando, como se não estivéssemos falando do elefante gigante na sala\"",shape=box,color=red];
		653 -> 663;
	666 [label="Quando você acreditar que eu não consigo compreender ou não consigo ter simpatia pelas histórias dos outros, por favor, reconsidere, oui?",shape=box,color=blue];
