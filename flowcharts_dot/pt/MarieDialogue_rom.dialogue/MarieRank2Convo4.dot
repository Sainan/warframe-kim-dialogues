	j1376669987 [label="Ah, não podíamos desperdiçar comida, certo? Seria pecado comê-los, mas seria um pecado ainda maior jogá-los no lixo. Então, nós os degustamos.",shape=box,color=blue];
		j1376669987 -> j5156928;
