	667 [label="Qu'il en soit ainsi.",shape=box,color=blue];
		667 -> 674;
	668 [label="Ele é um soldado, teve que fazer coisas terríveis em nome de um \"propósito maior\". Eu sei como é… às vezes, esse tipo de vida te transforma em algo… enfim, como ele",shape=box,color=red];
		668 -> 675;
	669 [label="Ele viveu por centenas, talvez até milhares de anos. Quem sabe o que isso realmente faz com alguém? Quanta dor, quanto sofrimento? Eu sei como é",shape=box,color=red];
		669 -> 676;
	664 [label="Mas você queria me perguntar sobre o próprio diabo, não é? O que gostaria de saber?",shape=box,color=blue];
		664 -> 670;
		664 -> 671;
		664 -> 672;
	665 [label="Devemos ver a guerra através dos olhos de um estatístico, porque se a víssemos através dos olhos daqueles perdidos em batalhas, nunca deixaríamos de chorar.",shape=box,color=blue];
		665 -> 664;
