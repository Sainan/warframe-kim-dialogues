	680 [label="Estamos de acordo",shape=box,color=red];
		680 -> 687;
	681 [label="Ah, e agora me sinto realmente uma idiota. Sim, claro, você sabe como é matar em nome de um \"propósito\", como você disse… Claro que você tentaria entender alguém que fez a mesma coisa.",shape=box,color=blue];
		681 -> 688;
	682 [label="Ah, e agora me sinto realmente uma idiota. Sim, claro, você sabe como é viver e morrer repetidamente… Claro que gostaria de conhecer alguém que já passou pela mesma coisa.",shape=box,color=blue];
		682 -> 688;
	677 [label="Não é evidente? O comportamento dele é como o de um grande felino que insiste em marcar território e derrubar coisas das prateleiras.",shape=box,color=blue];
		677 -> 683;
		677 -> 684;
	678 [label="Quando o Cardeal Dimanche, o Entrati, partiu pela última vez, deixou o diabo à nossa porta. Despedaçado, sangrando e mal conseguindo se lembrar do próprio nome.",shape=box,color=blue];
		678 -> 685;
	679 [label="Uma tempestade ocorria na noite em que o diabo veio até nós. Um estrondo terrível abalou as paredes da Cathédrale.",shape=box,color=blue];
		679 -> 686;
