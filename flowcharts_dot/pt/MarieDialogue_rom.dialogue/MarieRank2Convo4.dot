		j1552101973 -> j3387286501;
	j359589058 [label="O perdão não pode ser dado àqueles que não o buscam. Seria mais fácil ensinar um peixe a voar.",shape=box,color=blue];
		j359589058 -> j2419069175;
	j3604592944 [label="Não sei… e a outra questão permanece: será que ele sequer acha que precisa de perdão?",shape=box,color=blue];
		j3604592944 -> j359589058;
	j4211019338 [label="Fie! Tá, tudo bem… tem uma coisa que compartilhamos: uma tentação perversa por doces. O diabo costumava voltar à Catedral depois de roubar doces das lojas, sem pagar por eles.",shape=box,color=blue];
		j4211019338 -> j235596883;
