		j2419069175 -> j3699473247;
	j235596883 [label="Eu explicava que isso era roubo, e ele dava um longo discurso sobre como os Orokin logo governariam o sistema solar, então, tecnicamente, isso não seria roubo no panorama geral…",shape=box,color=blue];
