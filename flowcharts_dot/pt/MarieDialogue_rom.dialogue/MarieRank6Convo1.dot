	3309 [label="Você trouxe tanta paz ao meu irmão de alma. Você o convenceu de que temos um verdadeiro inimigo a combater… e lhe deu esperança.",shape=box,color=blue];
		3309 -> 3329;
	3310 [label="Você trouxe consolo e um pouco de paz ao meu irmão de alma, que antes não a tinha. Creio que sua companhia significou mais para ele do que ele consegue expressar.",shape=box,color=blue];
		3310 -> 3329;
	3311 [label="Embora talvez nunca saibamos a resposta para a verdadeira natureza da Indiferença, sabemos que isso não importa. Devemos encará-la como o desafio que ela representa… e que é real.",shape=box,color=blue];
		3311 -> 3329;
	3312 [label="Eu não achava que nosso diabo pudesse ser convencido a ajudar o Monsieur Loid e a família do Cardeal a se reconectarem. Sei que seus motivos são… duvidosos, talvez, e ainda não confio totalmente nele. ",shape=box,color=blue];
		3312 -> 3330;
	3313 [label="Não acreditava que nosso diabo pudesse ser confrontado com seus erros. Que ele pudesse sentir qualquer remorso pelas vidas inocentes que tirou… você provou que eu estava errada.",shape=box,color=blue];
		3313 -> 3331;
	3314 [label="Quaisquer que sejam as correntes que mantenham nosso diabo calmo, elas o mantêm sob controle. Ele parece mais… tranquilo do que antes. E você é o responsável por isso.",shape=box,color=blue];
		3314 -> 3331;
	3315 [label="As lembranças que o ajudamos a resgatar parecem tê-lo amenizado. Talvez a lembrança da dor por todos aqueles que ele perdeu o tenha feito recordar daqueles que ele ainda pode perder.",shape=box,color=blue];
		3315 -> 3331;
