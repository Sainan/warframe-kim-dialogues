	j3291984639 [label="O dom de fazer um ao outro rir… de chorar… de convencer um ao outro da verdade ou da mentira… de mudar a opinião um do outro… de animar um ao outro na dor… de magoar um ao outro na tolice…",shape=box,color=blue];
		j3291984639 -> j2494141613;
	j986403912 [label="E qual é a diferença, quando você está lá para guiar o Lyon através das horas mais sombrias e ampará-lo em seus momentos de dor e agonia?",shape=box,color=blue];
		j986403912 -> j806734103;
	j2373063945 [label="Os resultados são, sem dúvida, fruto do seu trabalho. O Roathe está aqui, protegendo a família do Cardeal, graças a você.",shape=box,color=blue];
		j2373063945 -> j185331531;
	j185331531 [label="E eu sei que o nosso diabo não é o nosso inimigo, oui? É a Indiferença. E o que a Indiferença nos ensina, senão a nos apegarmos a tudo o que ela rejeita, a tudo o que ela destrói?",shape=box,color=blue];
