	j611319407 [label="E eu penso comigo mesma: será que é isso que a Indiferença deseja destruir? Será que é isso que a Indiferença consome? Esse poder que os outros têm de influenciar os outros?",shape=box,color=blue];
		j611319407 -> j3291984639;
	j4202747057 [label="Você trouxe tanta paz ao meu irmão de alma. Você o convenceu de que temos um verdadeiro inimigo a combater… e lhe deu esperança.",shape=box,color=blue];
		j4202747057 -> j986403912;
	j668741671 [label="Você trouxe consolo e um pouco de paz ao meu irmão de alma, que antes não a tinha. Creio que sua companhia significou mais para ele do que ele consegue expressar.",shape=box,color=blue];
		j668741671 -> j986403912;
	j2457541650 [label="Embora talvez nunca saibamos a resposta para a verdadeira natureza da Indiferença, sabemos que isso não importa. Devemos encará-la como o desafio que ela representa… e que é real.",shape=box,color=blue];
		j2457541650 -> j986403912;
	j3525908820 [label="Eu não achava que nosso diabo pudesse ser convencido a ajudar o Monsieur Loid e a família do Cardeal a se reconectarem. Sei que seus motivos são… duvidosos, talvez, e ainda não confio totalmente nele. ",shape=box,color=blue];
		j3525908820 -> j2373063945;
	j3493753520 [label="Não acreditava que nosso diabo pudesse ser confrontado com seus erros. Que ele pudesse sentir qualquer remorso pelas vidas inocentes que tirou… você provou que eu estava errada.",shape=box,color=blue];
		j3493753520 -> j185331531;
	j1617573481 [label="Quaisquer que sejam as correntes que mantenham nosso diabo calmo, elas o mantêm sob controle. Ele parece mais… tranquilo do que antes. E você é o responsável por isso.",shape=box,color=blue];
		j1617573481 -> j185331531;
	j37661919 [label="As lembranças que o ajudamos a resgatar parecem tê-lo amenizado. Talvez a lembrança da dor por todos aqueles que ele perdeu o tenha feito recordar daqueles que ele ainda pode perder.",shape=box,color=blue];
		j37661919 -> j185331531;
	j4075583403 [label="Talvez seja o carinho que ele sente por você que o acalma… não sei. Seja qual for o motivo, sei que você é quem eu devo agradecer por isso.",shape=box,color=blue];
		j4075583403 -> j185331531;
	j1547201120 [label="Não guardo rancor de vocês, só tenho alegria por ambos, oui?",shape=box,color=blue];
		j1547201120 -> j3730182722;
		j1547201120 -> j2754350244;
	j3327141322 [label="As coisas mudaram e… tenho que manter minha lealdade, foi mal",shape=box,color=red];
		j3327141322 -> j2949115134;
