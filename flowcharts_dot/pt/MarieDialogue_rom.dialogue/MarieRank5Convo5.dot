	j1065726834 [label="O que aconteceu?",shape=box,color=red];
		j1065726834 -> j3249044748;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j3249044748 [label="Perguntei ao Monsieur Pássaro 3 qual era a data do seu aniversário, e ele não sabia! Que triste!",shape=box,color=blue];
		j3249044748 -> j1257780763;
	"Chat ends." [color=orange];
	j1257780763 [label="Nenhuma das Cavias sabe a data do seu aniversário, o que faz sentido, já que nasceram sem a capacidade de falar ou conhecer o calendário como nós.",shape=box,color=blue];
		j1257780763 -> j2805367757;
	j2805367757 [label="Então pensei: que tragédia! Precisamos corrigir isso imediatamente, non?",shape=box,color=blue];
		j2805367757 -> j3182556360;
		j2805367757 -> j3829441234;
		j2805367757 -> j2341197419;
	j3182556360 [label="Nunca tinha pensado nisso",shape=box,color=red];
		j3182556360 -> j1096854614;
	j3829441234 [label="Como você vai descobrir isso?",shape=box,color=red];
		j3829441234 -> j1518709610;
	j2341197419 [label="Você vai deixar eles escolherem as datas?",shape=box,color=red];
		j2341197419 -> j4238957593;
	j1096854614 [label="Oui! Nem o Monsieur Loid tinha. A expressão no rosto dele quando descobri isso foi de pura tristeza…",shape=box,color=blue];
		j1096854614 -> j684032621;
	j1518709610 [label="A princípio, pensei em verificar os registros do Cardeal… talvez ele tenha anotado quando eles nasceram, oui?",shape=box,color=blue];
		j1518709610 -> j2402114516;
	j4238957593 [label="\"Deixar?\" Você diz isso como se dependesse de mim! ",shape=box,color=blue];
		j4238957593 -> j1518709610;
	j684032621 [label="Me parte o coração que ele ache que a culpa é dele por não ter pensado nisso primeiro. Não é culpa dele, ele faz tanto por tantas pessoas…",shape=box,color=blue];
		j684032621 -> j3324364850;
	j2402114516 [label="Evaluate expressions",color=orange];
		j2402114516 -> j1994927670 [label="MarieEntratiComplete",color=purple];
		j2402114516 -> j1994927670 [label="MarieEntrati3a",color=purple];
		j2402114516 -> j1578787141 [label="false",color=purple];
	j3324364850 [label="Todos nós somos abençoados por conhecer a bondade do Monsieur Loid. A profundidade da fonte de onde ele tira água não tem fim.",shape=box,color=blue];
		j3324364850 -> j728079064;
		j3324364850 -> j337818630;
	j1994927670 [label="Mas aí me lembrei… das minhas conversas com o Monsieur Tagfer e os outros, e pensei… talvez isso não seja tão sábio.",shape=box,color=blue];
		j1994927670 -> j3236480291;
	j1578787141 [label="Mas eles pareciam desinteressados em encontrar registros de seu passado. Sei o quão doloroso pode ser pensar nas próprias origens.",shape=box,color=blue];
		j1578787141 -> j3236480291;
	j728079064 [label="A gente tem muita sorte de ter ele aqui",shape=box,color=red];
		j728079064 -> j873677588;
	j337818630 [label="Só queria que ele se animasse um pouco de vez em quando",shape=box,color=red];
		j337818630 -> j4136953453;
	j3236480291 [label="Parando pra pensar… nem eu sei o dia do meu aniversário",shape=box,color=blue];
		j3236480291 -> j2030434600;
		j3236480291 -> j1411600123;
		j3236480291 -> j3889240765;
	j873677588 [label="Oui, somos sim. Todos nós somos.",shape=box,color=blue];
		j873677588 -> j3542593548;
	j4136953453 [label="Ele é um homem sério, mas já o vi sorrir. Ele tem um senso de humor que surge quando menos se espera. Basta ter paciência.",shape=box,color=blue];
		j4136953453 -> j3542593548;
	j2030434600 [label="Se serve de consolo, eu também não sei o meu. Duvido que a criança saiba o dele também",shape=box,color=red];
		j2030434600 -> j3329457804;
	j1411600123 [label="Aniversários são… superestimados",shape=box,color=red];
		j1411600123 -> j3668350319;
	j3889240765 [label="De qualquer forma, é mais divertido escolher, é mais \"poignant\"",shape=box,color=red];
		j3889240765 -> j1328359516;
	j3542593548 [label="Check boolean MarieDating",color=orange];
		j3542593548 -> j366030824 [label=true,color=green];
		j3542593548 -> j4082060539 [label=false,color=brown];
	j3329457804 [label="Mais motivos para chorar por você e sua minúscula cópia. E ainda mais coisas que temos em comum!",shape=box,color=blue];
		j3329457804 -> j3542593548;
	j3668350319 [label="Não acredito que sejam superestimados! Devemos celebrar aqueles que ainda estão conosco, da mesma forma que celebramos aqueles que já se foram.",shape=box,color=blue];
		j3668350319 -> j3542593548;
	j1328359516 [label="Poignant? Eu não sabia que você falava gaulês! Aprendeu isso comigo?",shape=box,color=blue];
		j1328359516 -> j3564969170;
		j1328359516 -> j1514944904;
	j366030824 [label="+20 Chemistry",color=orange];
		j366030824 -> j1037709639;
	j4082060539 [label="+20 Chemistry",color=orange];
		j4082060539 -> j361243916;
	j3564969170 [label="Honestamente… não faço ideia. Só vi isso por aí um dia desses e achei legal…",shape=box,color=red];
		j3564969170 -> j1915658145;
	j1514944904 [label="É… deve ter sido com você mesmo",shape=box,color=red];
		j1514944904 -> j3153408266;
	j1037709639 [label="Vamos lá, mon cœur! Mesmo que nada resulte disso, a intenção é sempre o que conta! Au calendrier!",shape=box,color=blue];
		j1037709639 -> "Chat ends.";
	j361243916 [label="Vamos lá! Mesmo que nada resulte disso, a intenção é o que conta! Au calendrier!",shape=box,color=blue];
		j361243916 -> "Chat ends.";
	j1915658145 [label="Aff! Todo mundo sempre rouba as melhores palavras do gaulês e usa de qualquer jeito! Os tempos nunca mudam!",shape=box,color=blue];
		j1915658145 -> j3542593548;
	j3153408266 [label="Então você é inteligente! O gaulês é uma das línguas mais belas que já existiram, e fico feliz em trazê-la para este futuro.",shape=box,color=blue];
