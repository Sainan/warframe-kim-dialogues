	3109 [label="Todos nós somos abençoados por conhecer a bondade do Monsieur Loid. A profundidade da fonte de onde ele tira água não tem fim.",shape=box,color=blue];
		3109 -> 3112;
		3109 -> 3113;
	3110 [label="Mas aí me lembrei… das minhas conversas com o Monsieur Tagfer e os outros, e pensei… talvez isso não seja tão sábio.",shape=box,color=blue];
		3110 -> 3114;
	3111 [label="Mas eles pareciam desinteressados em encontrar registros de seu passado. Sei o quão doloroso pode ser pensar nas próprias origens.",shape=box,color=blue];
