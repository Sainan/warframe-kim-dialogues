		j1772954770 -> j3162247766;
	j2690025501 [label="Devemos manter nossa fé. Se perdermos a esperança de que o amor prevalecerá… a escuridão vencerá.",shape=box,color=blue];
		j2690025501 -> j3137622775;
	j1221746757 [label="Você ficaria surpreso em saber o quão pouco tenho a ver com essa parte. ",shape=box,color=blue];
		j1221746757 -> j4262362066;
	j4091295914 [label="Por não acreditar… nem na Indiferença, nem em absolutamente nada. Se eu tivesse criado um mundo do tecido do Void, talvez eu sentisse o mesmo.",shape=box,color=blue];
		j4091295914 -> j4262362066;
	j1659307933 [label="+5 Chemistry",color=orange];
		j1659307933 -> j619493686;
	j3034535620 [label="Estive ao lado de um diabo que viveu por incontáveis séculos. Não muito longe, está uma mulher-máquina com almas de uma deusa tripla, por direito próprio.",shape=box,color=blue];
		j3034535620 -> j3283682185;
	j2276884697 [label="Hahaha! Você, mais do que ninguém, deveria saber que a fé nunca é sábia. No entanto, almas como a nossa a carregam de qualquer maneira, mesmo que ela possa nos machucar. Suspeito que você saiba disso… se a nossa conversa anterior foi verdadeira.",shape=box,color=blue];
		j2276884697 -> j1735975523;
		j2276884697 -> j3127561137;
	j163281791 [label="A fé nunca é sábia. Mas aqueles de nós que a carregam como uma tocha, buscamos sempre carregá-la… mesmo que ela nos queime.",shape=box,color=blue];
		j163281791 -> j3812009034;
	j879010410 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j879010410 -> j1185699525;
	j3162247766 [label="E você já cogitou que o coração de alguém pode pertencer a mais de uma alma? Que alguém pode amar mais de uma pessoa?",shape=box,color=blue];
		j3162247766 -> j1360617357;
		j3162247766 -> j2233984524;
	j3137622775 [label="Quando tudo desaba, o amor é tudo o que nos resta, non?",shape=box,color=blue];
		j3137622775 -> j3060514247;
	j4262362066 [label="O perdão absoluto não deve ser buscado nos outros, nem mesmo nos Luminários.",shape=box,color=blue];
		j4262362066 -> j886576620;
		j4262362066 -> j1249508652;
