	j3850196857 [label="Como você conheceu o Entrati?",shape=box,color=red];
		j3850196857 -> j2828994024;
	j1836035993 [label="Agora que você tá aqui… posso perguntar o que você acha do Entrati?",shape=box,color=red];
		j1836035993 -> j761428109;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j2828994024 [label="Eu o conhecia como Cardeal Dimanche. Você se surpreenderia com a quantidade de anos que ele passou na igreja, pregando para o nosso pessoal.",shape=box,color=blue];
		j2828994024 -> j3001913433;
		j2828994024 -> j3664478525;
	j761428109 [label="+5 Chemistry",color=orange];
		j761428109 -> j1965637058;
	"Chat ends." [color=orange];
	j3001913433 [label="Você acha que era tudo mentira? Ou acha que ele acreditava nisso?",shape=box,color=red];
		j3001913433 -> j4243392176;
	j3664478525 [label="Sei não, mentir é tipo respirar pra aquele cara",shape=box,color=red];
		j3664478525 -> j4246216784;
	j1965637058 [label="Ah, uma pergunta muito educada que esconde uma resposta muito desafiadora… formulada de forma bem inteligente, devo admitir.",shape=box,color=blue];
		j1965637058 -> j2194203625;
	j4243392176 [label="Ele falou de perdão, de família e de empatia… com tanto fervor e dedicação, que não imagino isso como simplesmente teatro.",shape=box,color=blue];
		j4243392176 -> j2185885906;
	j4246216784 [label="Entendo que suas experiências com ele não sejam as mesmas que as minhas. Mas você também precisa entender que, para mim, ele foi exclusivamente gentil e atencioso.",shape=box,color=blue];
		j4246216784 -> j2624242849;
	j2194203625 [label="Sinto a mesma coisa que senti no primeiro dia em que o vi pregar um sermão no altar aos paroquianos. Que bênção foi estar na presença dele.",shape=box,color=blue];
		j2194203625 -> j3883844457;
		j2194203625 -> j2125747461;
		j2194203625 -> j2342909887;
	j2185885906 [label="Ele seguiu no caminho dos Luminários? Do Sol e da Lua? Considerando os acontecimentos recentes, isso eu não sei mais. Ah, peu importe.",shape=box,color=blue];
		j2185885906 -> j1981544205;
	j2624242849 [label="Por acaso suas verdades invalidam as minhas, ou em quem devo crer? Devo condenar cada ato de misericórdia e gentileza que ele demonstrou em seus anos na paróquia?",shape=box,color=blue];
		j2624242849 -> j53592696;
	j3883844457 [label="Fico feliz em ouvir isso, de verdade. Acho que todo mundo julga ele logo de cara",shape=box,color=red];
		j3883844457 -> j2746771017;
	j2125747461 [label="Você acha que ele tava enganando as pessoas? Ou acha que ele realmente acreditava na causa?",shape=box,color=red];
		j2125747461 -> j4243392176;
	j2342909887 [label="Sinto muito que você tenha caído na lábia dele…",shape=box,color=red];
		j2342909887 -> j4246216784;
	j1981544205 [label="De que importa o nome dos deuses aos quais você reza, se você guarda o amor verdadeiro a eles em seu coração? Eu afirmo: nada importa.",shape=box,color=blue];
		j1981544205 -> j2080711995;
		j1981544205 -> j2842146453;
	j53592696 [label="Non, acho que não.",shape=box,color=blue];
		j53592696 -> j2950691839;
	j2746771017 [label="+10 Chemistry",color=orange];
		j2746771017 -> j2814273202;
	j2080711995 [label="Poxa… gostei do seu ponto de vista",shape=box,color=red];
		j2080711995 -> j2675882714;
	j2842146453 [label="Discordo, ser gentil não me torna um seguidor do deus da gentileza",shape=box,color=red];
		j2842146453 -> j1624765620;
	j2950691839 [label="Perdoe-me, mas não farei dele um monstro só por causa de suas afirmações.",shape=box,color=blue];
		j2950691839 -> j2209081154;
	j2814273202 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j2814273202 -> j3359512245;
	j2675882714 [label="Acredito que, na alma dele, o Cardeal realmente mantém sua fé nos Luminários, mesmo que ele não acredite que eles o aguardem no além.",shape=box,color=blue];
		j2675882714 -> j2456795191;
	j1624765620 [label="+5 Chemistry",color=orange];
		j1624765620 -> j249249451;
	j2209081154 [label="Boolean MarieEntratiMonster1 is now true.",color=orange];
		j2209081154 -> "Chat ends.";
	j3359512245 [label="Ah! Como me alegra o coração ouvir isso. Achava que estava sozinha nessa. Estou cercada por aqueles que só pensam mal do Cardeal.",shape=box,color=blue];
		j3359512245 -> j4262064034;
		j3359512245 -> j1995141784;
		j3359512245 -> j2074159834;
	j2456795191 [label="E diga-me… que outro homem conhece o valor da empatia contra a escuridão da Indiferença?",shape=box,color=blue];
		j2456795191 -> j2413258194;
	j249249451 [label="Você tem razão. Eu não o chamaria de Seguidor do Sol simplesmente porque você segue o caminho dele cegamente. Mais pessoas boas no mundo o melhoram no geral, não importa o nome das crenças delas.",shape=box,color=blue];
		j249249451 -> j1712276907;
	j4262064034 [label="Só queria uma forma de fazer o povo perdoar, ele faz o melhor que pode para consertar as coisas",shape=box,color=red];
		j4262064034 -> j1209683872;
	j1995141784 [label="O povo tem bastante motivo pra isso, mas ele é nossa única chance de acabar com a Indiferença",shape=box,color=red];
		j1995141784 -> j783481925;
	j2074159834 [label="Nem mesmo o próprio Entrati gosta muito dele mesmo",shape=box,color=red];
		j2074159834 -> j3238919974;
	j2413258194 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j2413258194 -> j3386606800 [label=true,color=green];
		j2413258194 -> j3577771626 [label=false,color=brown];
	j1712276907 [label="Por isso, acredito que o Cardeal é abençoado, mesmo que a fé dele tenha outro nome diferente do que eu escolheria.",shape=box,color=blue];
		j1712276907 -> j2456795191;
	j1209683872 [label="Add 1 to Thermostat counter",color=orange];
		j1209683872 -> j515378144;
	j783481925 [label="Add -1 to Thermostat counter",color=orange];
		j783481925 -> j2232959585;
	j3238919974 [label="Oui, et comme c'est tragique… me faz chorar só de pensar nisso. E no Monsieur Loid, com o amor deles à deriva.",shape=box,color=blue];
		j3238919974 -> j1066460168;
	j3386606800 [label="Perdoe-me, esqueci… você não acredita que sua Indiferença seja real, somente uma alucinação. Mas você acredita na emoção dela, oui?",shape=box,color=blue];
		j3386606800 -> j2574992197;
		j3386606800 -> j2279561383;
	j3577771626 [label="É até perfeito que ele venha pregar a mensagem em contraponto àquilo que ele mesmo desencadeou, n'est-ce pas?",shape=box,color=blue];
		j3577771626 -> j618981556;
		j3577771626 -> j426637608;
		j3577771626 -> j252093105;
	j515378144 [label="Oui, e acho que essa é a jornada que todos nós trilhamos.",shape=box,color=blue];
		j515378144 -> j1066460168;
	j2232959585 [label="Oui, mas a batalha contra a Indiferença não se vence com espadas e pedras, mas sim com o coração. Compreende?",shape=box,color=blue];
		j2232959585 -> j1066460168;
	j1066460168 [label="Não é o diabo Orokin que ele quer que perdoemos, certo? É o Cardeal, isso é claro. E acho que é o amor do Monsieur Loid que o inspira.",shape=box,color=blue];
		j1066460168 -> j544971919;
	j2574992197 [label="Todas as emoções têm um propósito, até mesmo a Indiferença",shape=box,color=red];
		j2574992197 -> j2925628853;
	j2279561383 [label="Sim… fui vítima disso em Duviri, deixei a apatia me corroer… até que só sobrou ela",shape=box,color=red];
		j2279561383 -> j3389358593;
	j618981556 [label="Queria muito saber como ajudar ele a resolver isso",shape=box,color=red];
		j618981556 -> j675969639;
	j426637608 [label="Queria que ele tivesse um plano melhor do que \"pregar\" por aí",shape=box,color=red];
		j426637608 -> j3699161339;
	j252093105 [label="Bom, já que foi ele quem causou esse problemão aqui… isso é o mínimo que ele deve fazer pra consertar as coisas",shape=box,color=red];
		j252093105 -> j2608712839;
	j544971919 [label="Isso parte meu coração… tudo que desejo é vê-los reunidos!",shape=box,color=blue];
		j544971919 -> j537115900;
		j544971919 -> j3554128971;
	j2925628853 [label="Claro que sim, je ne le nie pas.",shape=box,color=blue];
		j2925628853 -> j1230451681;
	j3389358593 [label="+5 Chemistry",color=orange];
		j3389358593 -> j3003467061;
	j675969639 [label="+5 Chemistry",color=orange];
		j675969639 -> j3034610719;
	j3699161339 [label="E quem somos nós para julgar seus métodos? O Cardeal Dimanche é um gênio, abençoado pelos Luminários. Ele nos guiará.",shape=box,color=blue];
		j3699161339 -> j4251646635;
		j3699161339 -> j3215047977;
	j2608712839 [label="Cuidado com o que fala. O Cardeal Dimanche é um gênio, abençoado pelos Luminários. Ele nos guiará.",shape=box,color=blue];
		j2608712839 -> j3990422877;
		j2608712839 -> j4251646635;
		j2608712839 -> j3215047977;
	j537115900 [label="Eu acho que… tem a questão da mãe da mãe… a esposa do Entrati",shape=box,color=red];
		j537115900 -> j1429061857;
	j3554128971 [label="Acho que é só uma questão de \"quando\"",shape=box,color=red];
		j3554128971 -> j3303502182;
	j1230451681 [label="Mas eu não te culpo.",shape=box,color=blue];
		j1230451681 -> j2740698297;
		j1230451681 -> j4152382509;
	j3003467061 [label="Oui, oui, ouvi os outros falarem deste mundo que você criou. Quando você estava completamente sozinho… e não tinha mais ninguém a quem recorrer.",shape=box,color=blue];
		j3003467061 -> j1230451681;
