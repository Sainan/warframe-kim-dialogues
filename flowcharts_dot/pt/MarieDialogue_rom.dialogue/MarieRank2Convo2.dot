	j1360617357 [label="Sinceramente… não.",shape=box,color=red];
		j1360617357 -> j3555607812;
	j2233984524 [label="Sim, mas só se todas as partes concordarem",shape=box,color=red];
		j2233984524 -> j3990836676;
	j3060514247 [label="Ah! Mas você veio em busca de uma história! Já tomei tanto do seu tempo… então, serei breve.",shape=box,color=blue];
		j3060514247 -> j1678944526;
	j886576620 [label="Interessante… por que você diz isso?",shape=box,color=red];
		j886576620 -> j229434797;
	j1249508652 [label="Mesmo que você tenha prejudicado outra pessoa?",shape=box,color=red];
		j1249508652 -> j1703169889;
	j2476595424 [label="Tomei café ao lado de animais que me indagaram sobre a qualidade do meu descanso.",shape=box,color=blue];
		j2476595424 -> j3277269168;
	j2969012036 [label="Add 1 to Thermostat counter",color=orange];
		j2969012036 -> j2705255514;
	j1830147676 [label="Add -1 to Thermostat counter",color=orange];
		j1830147676 -> j2328844145;
	j2705255514 [label="Carregamos isso porque… precisamos. Porque não conhecemos outra maneira de ser. Não importa o que isso signifique. Entendo como você se sente.",shape=box,color=blue];
		j2705255514 -> j173270957;
	j2358132250 [label="A fé para almas como a nossa é como uma tocha: nós sempre a carregamos, mesmo que ela possa nos queimar.",shape=box,color=blue];
		j2358132250 -> j3127561137;
		j2358132250 -> j1735975523;
	j1269396165 [label="Mas estou surpresa… você expressou dúvidas sobre a fé antes.",shape=box,color=blue];
		j1269396165 -> j3564687580;
		j1269396165 -> j3658038375;
	j231107855 [label="Mas estou surpresa… você já se declarou sendo uma criatura de pouca fé antes.",shape=box,color=blue];
		j231107855 -> j3564687580;
		j231107855 -> j3658038375;
	j448405617 [label="A fé para almas como a minha é como uma tocha: nós sempre a carregamos, mesmo que ela possa nos queimar.",shape=box,color=blue];
		j448405617 -> j3812009034;
	j3555607812 [label="Boolean DrifterPNo is now true.",color=orange];
		j3555607812 -> j4042138423;
	j3990836676 [label="Boolean DrifterPYes is now true.",color=orange];
		j3990836676 -> j4042138423;
	j1678944526 [label="Era uma tarde linda e ensolarada. Lembro-me dele em pé, em frente ao altar, olhando para os vitrais com um sorriso no rosto… embora eu não soubesse o motivo.",shape=box,color=blue];
		j1678944526 -> j1358400972;
	j229434797 [label="Buscar reparar o dano causado é importante, não me interprete erradamente. Sempre que possível, ser perdoado por aqueles que foram afetados é uma bênção.",shape=box,color=blue];
		j229434797 -> j4171433652;
	j1703169889 [label="Ah, não quero dizer que não seja importante buscar o perdão daqueles a quem você prejudicou! É muito importante sim!",shape=box,color=blue];
		j1703169889 -> j4099931758;
	j3277269168 [label="Fale-me novamente sobre aqueles que são \"caras normais\" e farei o meu melhor para não rir, dou-lhe minha palavra.",shape=box,color=blue];
		j3277269168 -> j490735831;
	j2328844145 [label="A fé não é uma constante, é como a maré: ela vem e vai, e é assim que as coisas funcionam.",shape=box,color=blue];
		j2328844145 -> j173270957;
	j173270957 [label="Mas receio que nada disso tenha a ver com o que você veio saber. Você buscava uma história, non?",shape=box,color=blue];
		j173270957 -> j1678944526;
	j3564687580 [label="Mas eu posso acreditar em pessoas e deuses de formas diferentes",shape=box,color=red];
		j3564687580 -> j3162208733;
	j3658038375 [label="Tem uma grande diferença entre ter fé em deuses e fé em pessoas. E o Entrati é só um cara normal",shape=box,color=red];
		j3658038375 -> j3480789725;
	j4042138423 [label="Interessante… não conheço os costumes dos Orokin o suficiente para saber se isso era aceito, mas sei que, em muitas culturas antigas, isso não era mal visto.",shape=box,color=blue];
		j4042138423 -> j461614632;
	j1358400972 [label="Ele se agachou para me cumprimentar, de modo que sua cabeça ficou abaixo da minha, comigo na cadeira.",shape=box,color=blue];
		j1358400972 -> j855846236;
	j4171433652 [label="Mas, no final, quando nos depararmos com a Anciã, quando a Lua derramar suas lágrimas prateadas sobre nós, e a morte estiver próxima, será o peso do nosso próprio coração que deveremos carregar.",shape=box,color=blue];
		j4171433652 -> j3633593673;
		j4171433652 -> j3878917062;
	j4099931758 [label="Reparar qualquer dano que alguém possa ter causado… é uma bênção ainda mais poderosa para a alma. ",shape=box,color=blue];
		j4099931758 -> j4171433652;
	j490735831 [label="Até lá, sugiro que você reavalie o que significa ser \"abençoado\". Adeus.",shape=box,color=blue];
		j490735831 -> "Chat ends.";
	j3162208733 [label="Sim, uma opção é tangível, é presente. A outra exige que você feche os olhos e… tenha fé. ",shape=box,color=blue];
