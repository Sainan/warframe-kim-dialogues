		j1134465740 -> "Chat ends." [label=false,color=brown];
	j2268846324 [label="Mon cœur, podemos conversar? Só por um instante. ",shape=box,color=blue];
		j2268846324 -> j2156113351;
		j2268846324 -> j512145608;
	j2156113351 [label="Olá, claro. Qual a boa?",shape=box,color=red];
		j2156113351 -> j1280328866;
	j512145608 [label="[Encerrar Conversa]",shape=box,color=red];
		j512145608 -> j952339130;
	j1280328866 [label="Eu só queria dizer que… sei que seu coração também pertence a outra pessoa. E embora eu não a conheça, meu coração se alegra com isso.",shape=box,color=blue];
		j1280328866 -> j3464089142;
	j952339130 [label="Boolean MarieConsentComplete is now true.",color=orange];
		j952339130 -> "Chat ends.";
	j3464089142 [label="Confio em você, e se elas ocupam um lugar especial em sua alma, então terei o maior prazer em compartilhá-las com você.",shape=box,color=blue];
		j3464089142 -> j1017793136;
	j1017793136 [label="Espero sinceramente que, um dia, eu possa ter a oportunidade de conhecê-los, oui? O amante do meu amante deve, portanto, ser meu também…",shape=box,color=blue];
		j1017793136 -> j2048209710;
	j2048209710 [label="Isto é, se você acha que eles estariam dispostos a isso, claro.",shape=box,color=blue];
		j2048209710 -> j2189810452;
		j2048209710 -> j4008628425;
		j2048209710 -> j543391210;
	j2189810452 [label="Sinceramente… acho que você não faz o tipo dessa pessoa",shape=box,color=red];
		j2189810452 -> j2885249077;
	j4008628425 [label="Essa pessoa ia te amar, Marie, assim como eu amo",shape=box,color=red];
		j4008628425 -> j4269546537;
	j543391210 [label="Acho que essa pessoa não ia resistir mesmo",shape=box,color=red];
		j543391210 -> j4269546537;
	j2885249077 [label="Aff! Você é terrível, meu lobo. Deixe-me ter meus sonhos. Até lá, terei você quando tiver que ter você, eu acho!",shape=box,color=blue];
		j2885249077 -> j349558133;
	j4269546537 [label="Até lá, ficarei com você enquanto estiver com você. E ficarei feliz em compartilhá-lo com aqueles que vieram para cuidar de você como eu cuidei.",shape=box,color=blue];
		j4269546537 -> j349558133;
	j349558133 [label="Afinal, alguém precisa ficar de guarda contra o Murmúrio enquanto você estiver por aí se divertindo e aproveitando a vida!",shape=box,color=blue];
		j349558133 -> j1387167831;
	j1387167831 [label="E dito isso, o dever chama. À la revoyure!",shape=box,color=blue];
		j1387167831 -> j952339130;
}