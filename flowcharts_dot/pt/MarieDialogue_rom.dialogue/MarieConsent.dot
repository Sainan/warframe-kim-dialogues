		3581 -> 3583;
	3584 [label="Confio em você, e se elas ocupam um lugar especial em sua alma, então terei o maior prazer em compartilhá-las com você.",shape=box,color=blue];
		3584 -> 3585;
	3583 [label="Chat ends.",color=orange];
	3585 [label="Espero sinceramente que, um dia, eu possa ter a oportunidade de conhecê-los, oui? O amante do meu amante deve, portanto, ser meu também…",shape=box,color=blue];
		3585 -> 3586;
	3586 [label="Isto é, se você acha que eles estariam dispostos a isso, claro.",shape=box,color=blue];
