	1509 [label="Meu querido Lyon já estava há muito tempo estabelecido na Catedral quando a Mère Supérieure me acolheu, e entrei para a Igreja dos Luminários como Irmã.",shape=box,color=blue];
		1509 -> 1513;
		1509 -> 1514;
