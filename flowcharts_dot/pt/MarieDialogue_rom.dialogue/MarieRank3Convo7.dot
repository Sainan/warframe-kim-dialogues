	1528 [label="Um dia, acho que escreverão um livro de histórias sobre você. Que ideia encantadora, talvez eu mesma o escreva. Mas seria em gaulês! Imaginez cela!",shape=box,color=blue];
		1528 -> 1533;
	1529 [label="Então você realmente compreende. Sou mais do que a Irmã Marie, a pobre menina sem pés que recebeu o poder de voar. E o Lyon é mais do que só um padre trágico que carrega seus fardos em silêncio.",shape=box,color=blue];
		1529 -> 1534;
