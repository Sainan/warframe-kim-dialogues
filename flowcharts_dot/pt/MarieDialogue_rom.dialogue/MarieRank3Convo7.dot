	1505 [label="Tá tudo bem, só tô preocupado com ele",shape=box,color=red];
		1505 -> 1511;
	1506 [label="Eu… peço perdão pela minha brusquidão. Estou simplesmente acostumada com curiosos se aproximando, batendo nas grades da jaula dele como se ele fosse algum tipo de animal de circo.",shape=box,color=blue];
		1506 -> 1504;
