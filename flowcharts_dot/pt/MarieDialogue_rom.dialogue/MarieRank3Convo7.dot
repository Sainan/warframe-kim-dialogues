		1530 -> 1535;
	1536 [label="Já me acostumei em ser uma \"atração\" pro povo, entendo bem o que vocês passaram. Mas não, não é essa minha intenção",shape=box,color=red];
		1536 -> 1541;
	1537 [label="Não é não, eu só tava curioso. E, sinceramente… um pouco preocupado com ele, acho que ele esconde muito da dor que sente",shape=box,color=red];
		1537 -> 1542;
	1532 [label="Você pode imaginar que, na minha época, não havia muito trabalho ou lugares para alguém como eu… sem pernas para trabalhar… na Cité de la Lumière.",shape=box,color=blue];
		1532 -> 1538;
	1533 [label="Ou talvez… não imagine nada, pode ser que se torne realidade. Hahaha! E com essa maravilhosa observação, receio que devo me despedir. O Murmure nunca dorme!",shape=box,color=blue];
		1533 -> 1539;
	1534 [label="Lembre-se disso, e seremos bons amigos. E com essa maravilhosa mensagem, temo que devo me despedir. O Murmure nunca dorme!",shape=box,color=blue];
