	1494 [label="Meu querido Lyon já estava há muito tempo estabelecido na Catedral quando a Mère Supérieure me acolheu, e entrei para a Igreja dos Luminários como Irmã. (Fico muito feliz que você esteja aqui!)",shape=box,color=blue];
