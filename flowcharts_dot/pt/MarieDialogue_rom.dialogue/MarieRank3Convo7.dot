		j17348121 -> "Chat ends.";
	j4101818030 [label="Meu querido Lyon já estava há muito tempo estabelecido na Catedral quando a Mère Supérieure me acolheu, e entrei para a Igreja dos Luminários como Irmã. (Fico muito feliz que você esteja aqui!)",shape=box,color=blue];
		j4101818030 -> j3921870987;
		j4101818030 -> j3578483800;
	j4154248244 [label="Vou pedir que você defina isso melhor antes de prosseguirmos. E peço que faça isso com delicadeza, lembrando-me cuidadosamente de que ele é meu irmão de alma.",shape=box,color=blue];
		j4154248244 -> j1430366494;
