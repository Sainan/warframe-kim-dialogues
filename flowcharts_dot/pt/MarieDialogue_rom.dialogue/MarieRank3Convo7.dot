	"Chat ends." [color=orange];
	j3921870987 [label="Você tava… precisando de um lugar pra morar?",shape=box,color=red];
		j3921870987 -> j4080477417;
	j3578483800 [label="Posso fazer uma pergunta… indelicada?",shape=box,color=red];
		j3578483800 -> j3399947629;
	j1430366494 [label="Se isso te incomodar, podemos falar de outra coisa",shape=box,color=red];
		j1430366494 -> j3411196864;
	j3834515102 [label="Não quero te incomodar, só me preocupo com ele. Ele parece uma pedra, mas tenho a sensação de que, por dentro, ele tá sofrendo",shape=box,color=red];
		j3834515102 -> j3854064142;
	j4080477417 [label="Porque fui levada para lá pela minha família muitos anos antes, quando eu era pequena. Passei muitos anos como mendiga, vivendo como conseguia.",shape=box,color=blue];
		j4080477417 -> j1612311859;
	j3399947629 [label="+5 Chemistry",color=orange];
		j3399947629 -> j2783395265;
	j3411196864 [label="Não, não, está tudo bem. Estou simplesmente acostumada com curiosos se aproximando, batendo nas grades da jaula dele como se ele fosse algum tipo de animal de circo.",shape=box,color=blue];
		j3411196864 -> j1418823212;
		j3411196864 -> j4022594882;
		j3411196864 -> j3264554215;
	j3854064142 [label="+5 Chemistry",color=orange];
		j3854064142 -> j3732998039;
	j1612311859 [label="Boolean MarieBeggar1 is now true.",color=orange];
		j1612311859 -> j3778716899;
	j2783395265 [label="Pelo que tudo indica, você é considerado um lobo, e comigo, você tem modos tão bons! Adoro isso. Acho que sei o que você quer perguntar: por que eu morava na rua?",shape=box,color=blue];
		j2783395265 -> j4080477417;
	j1418823212 [label="Como foi que vocês se conheceram?",shape=box,color=red];
		j1418823212 -> j3088852929;
	j4022594882 [label="Já me acostumei em ser uma \"atração\" pro povo, entendo bem o seu receio",shape=box,color=red];
		j4022594882 -> j3618133108;
	j3264554215 [label="Tá tudo bem, só tô preocupado com ele",shape=box,color=red];
		j3264554215 -> j329499586;
	j3732998039 [label="Eu… peço perdão pela minha brusquidão. Estou simplesmente acostumada com curiosos se aproximando, batendo nas grades da jaula dele como se ele fosse algum tipo de animal de circo.",shape=box,color=blue];
		j3732998039 -> j4022594882;
		j3732998039 -> j3264554215;
	j3778716899 [label="Você pode imaginar que, na minha época, não havia muito trabalho ou lugares para alguém como eu… sem pernas para trabalhar… na Cité de la Lumière.",shape=box,color=blue];
		j3778716899 -> j1164575926;
	j3088852929 [label="Meu querido Lyon já estava há muito tempo estabelecido na Catedral quando a Mère Supérieure me acolheu, e entrei para a Igreja dos Luminários como Irmã.",shape=box,color=blue];
		j3088852929 -> j3423307772;
		j3088852929 -> j4244962813;
	j3618133108 [label="Sim, até imagino isso. Uma criatura viajante do tempo, que consegue voltar no tempo e invocar mundos do nada! Você é praticamente pura magia, non?",shape=box,color=blue];
		j3618133108 -> j2082710293;
		j3618133108 -> j3889046042;
	j329499586 [label="+5 Chemistry",color=orange];
		j329499586 -> j955611738;
	j1164575926 [label="É por isso que suponho que o Lyon e eu nos tornamos uma família tão rapidamente. Ele nunca olhou para mim com pena, e nem eu para ele.",shape=box,color=blue];
		j1164575926 -> j3661193383;
	j3423307772 [label="Você tava… precisando de um lugar pra morar?",shape=box,color=red];
		j3423307772 -> j2895517575;
	j4244962813 [label="Posso fazer uma pergunta… indelicada?",shape=box,color=red];
		j4244962813 -> j1726475516;
	j2082710293 [label="É, isso resume bem",shape=box,color=red];
		j2082710293 -> j956915582;
	j3889046042 [label="Sinceramente… queria que as pessoas me enxergassem além disso",shape=box,color=red];
		j3889046042 -> j3865980214;
	j955611738 [label="E eu adoro que você se preocupe. Ele é forte e pode suportar o que lhe foi imposto. Mas todos os fardos são mais fáceis de carregar em grupo.",shape=box,color=blue];
		j955611738 -> j136598889;
		j955611738 -> j975386316;
	j3661193383 [label="Já os outros, são tão rápidos em bater curiosamente nas barras de sua jaula, como se ele fosse algum tipo de animal de circo.",shape=box,color=blue];
		j3661193383 -> j374629859;
	j2895517575 [label="Porque fui levada para lá pela minha família muitos anos antes, quando eu era pequena. Passei muitos anos como mendiga, vivendo como conseguia.",shape=box,color=blue];
		j2895517575 -> j2005406635;
	j1726475516 [label="+5 Chemistry",color=orange];
		j1726475516 -> j824571792;
	j956915582 [label="+10 Chemistry",color=orange];
		j956915582 -> j2058623962;
	j3865980214 [label="+15 Chemistry",color=orange];
		j3865980214 -> j1543487039;
	j136598889 [label="Sinto que ele não quer falar comigo…",shape=box,color=red];
		j136598889 -> j4132683422;
	j975386316 [label="Eu quero ajudar ele, tem algum conselho?",shape=box,color=red];
		j975386316 -> j4132683422;
	j374629859 [label="Espero que não seja isso que você esteja fazendo aqui.",shape=box,color=blue];
		j374629859 -> j3104523760;
		j374629859 -> j923606182;
	j2005406635 [label="Boolean MarieBeggar1 is now true.",color=orange];
		j2005406635 -> j231693826;
	j824571792 [label="Pelo que tudo indica, você é considerado um lobo, e comigo, você tem modos tão bons! Adoro isso. Acho que sei o que você quer perguntar: por que eu morava na rua?",shape=box,color=blue];
		j824571792 -> j2895517575;
	j2058623962 [label="Um dia, acho que escreverão um livro de histórias sobre você. Que ideia encantadora, talvez eu mesma o escreva. Mas seria em gaulês! Imaginez cela!",shape=box,color=blue];
		j2058623962 -> j2224901439;
	j1543487039 [label="Então você realmente compreende. Sou mais do que a Irmã Marie, a pobre menina sem pés que recebeu o poder de voar. E o Lyon é mais do que só um padre trágico que carrega seus fardos em silêncio.",shape=box,color=blue];
		j1543487039 -> j2199245941;
	j4132683422 [label="+10 Chemistry",color=orange];
		j4132683422 -> j836323123;
	j3104523760 [label="Já me acostumei em ser uma \"atração\" pro povo, entendo bem o que vocês passaram. Mas não, não é essa minha intenção",shape=box,color=red];
		j3104523760 -> j2003619534;
	j923606182 [label="Não é não, eu só tava curioso. E, sinceramente… um pouco preocupado com ele, acho que ele esconde muito da dor que sente",shape=box,color=red];
		j923606182 -> j3263339182;
	j231693826 [label="Você pode imaginar que, na minha época, não havia muito trabalho ou lugares para alguém como eu… sem pernas para trabalhar… na Cité de la Lumière.",shape=box,color=blue];
		j231693826 -> j928747849;
	j2224901439 [label="Ou talvez… não imagine nada, pode ser que se torne realidade. Hahaha! E com essa maravilhosa observação, receio que devo me despedir. O Murmure nunca dorme!",shape=box,color=blue];
		j2224901439 -> "Chat ends.";
	j2199245941 [label="Lembre-se disso, e seremos bons amigos. E com essa maravilhosa mensagem, temo que devo me despedir. O Murmure nunca dorme!",shape=box,color=blue];
		j2199245941 -> "Chat ends.";
	j836323123 [label="Tenha paciência. Ele… não é muito comunicativo, a princípio. Mas ele virá até você, quando a hora chegar. Se você tiver boas intenções, ele saberá. Mas agora, receio que tenho que me despedir.",shape=box,color=blue];
		j836323123 -> "Chat ends.";
	j2003619534 [label="Sim, até imagino isso. Uma criatura viajante do tempo, que consegue voltar no tempo e invocar mundos do nada! Você é praticamente pura magia, non?",shape=box,color=blue];
		j2003619534 -> j2082710293;
		j2003619534 -> j3889046042;
	j3263339182 [label="+15 Chemistry",color=orange];
		j3263339182 -> j456904096;
	j928747849 [label="É por isso que suponho que o Lyon e eu nos tornamos uma família tão rapidamente. Ele nunca olhou para mim com pena, e nem eu para ele.",shape=box,color=blue];
		j928747849 -> j1444189089;
		j928747849 -> j3179415536;
	j456904096 [label="Você tem razão, ele faz isso. Mas ele sente que é necessário fazer isso para proteger aqueles ao seu redor. Quando ele sentir que você não precisa disso, ele dirá o que o aflige. Seja paciente, ele falará com você no devido tempo.",shape=box,color=blue];
		j456904096 -> j1957486972;
	j1444189089 [label="Espero que, em breve, ele se sinta confortável o suficiente pra falar comigo",shape=box,color=red];
		j1444189089 -> j4132683422;
	j3179415536 [label="Que bom que vocês se encontraram, nunca devemos julgar um livro pela capa",shape=box,color=red];
		j3179415536 -> j3865980214;
	j1957486972 [label="Bah, receio que devo me despedir. O Murmure nunca dorme!",shape=box,color=blue];
		j1957486972 -> "Chat ends.";
