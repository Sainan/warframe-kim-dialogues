		j3191890377 -> j383884146;
	j592642723 [label="Vamos manter esse assunto sobre o Cardeal longe desta conversa, oui? Estou preocupada com o meu irmão de alma.",shape=box,color=blue];
		j592642723 -> j2030909168;
	j2276885432 [label="Concordo, mas o que está feito, está feito, oui? Mas aprecio o seu sentimento. Cela dit…",shape=box,color=blue];
