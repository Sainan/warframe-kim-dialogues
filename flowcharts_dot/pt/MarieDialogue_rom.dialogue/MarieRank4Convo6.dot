		j3928501384 -> j831182116;
	j1508580759 [label="S'il te plaît, chega de falar do Cardeal. Não nego que suas palavras contribuem para a discórdia do Lyon, mas não pode ser a única causa.",shape=box,color=blue];
		j1508580759 -> j1157259772;
