	j957767329 [label="Não pense que eu não vi o que você fez, se infiltrando primeiro, lobo.",shape=box,color=blue];
		j957767329 -> j383884146;
	j3502043478 [label="E você não ajudará em nada se falar com ele dessa maneira. Mesmo que as palavras sejam verdadeiras, é preciso ter cuidado com a forma como são proferidas.",shape=box,color=blue];
		j3502043478 -> j1062474024;
	j411285759 [label="Oui, ele foi um abrigo na tempestade para muitos… e agora, ele próprio está desabrigado.",shape=box,color=blue];
		j411285759 -> j646715080;
