	j4165465940 [label="Sinceramente… não faço ideia",shape=box,color=red];
		j4165465940 -> j1863129316;
	j383884146 [label="Vamos manter esse assunto sobre o Cardeal longe desta conversa, oui? Estou preocupada com o meu irmão de alma. Mas… compreendo o que você diz… e está se tornando cada vez mais verdade.",shape=box,color=blue];
