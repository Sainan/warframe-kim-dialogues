		j1890094394 -> j629437109;
	j831182116 [label="Isso ajudou a aliviar sua incerteza… mas dar tanto valor às palavras de um diabo? Meu Lyon é mais sábio que isso. Acho que são muitas as coisas que o afligem.",shape=box,color=blue];
