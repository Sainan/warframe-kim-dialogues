	j2028884040 [label="Não faço ideia de como ajudar ele",shape=box,color=red];
		j2028884040 -> j400957088;
	j1883531402 [label="Quando você estava preso no mundo que você criou, preso em um ciclo interminável de morte… você teve ajuda para escapar?",shape=box,color=blue];
		j1883531402 -> j3169911556;
		j1883531402 -> j1772043867;
	j1754218090 [label="Oui, e é doloroso vê-lo sofrer… especialmente agora, sabendo como você abriu espaço em seu coração para ele.",shape=box,color=blue];
		j1754218090 -> j400957088;
	j400957088 [label="É difícil prever onde estarão os limites dele. Eles mudam do dia para a noite.",shape=box,color=blue];
		j400957088 -> j1373629549;
	j3169911556 [label="Nenhuma ajuda teria servido pra alguma coisa se eu não quisesse aceitar tal ajuda",shape=box,color=red];
		j3169911556 -> j1990801735;
		j3169911556 -> j4143304863;
	j1772043867 [label="Sim, de amigos",shape=box,color=red];
		j1772043867 -> j1990801735;
		j1772043867 -> j4143304863;
	j1373629549 [label="Eu o vi lutar contra as agonias que os deuses colocaram sobre seus ombros. Eu sabia quando ficar em silêncio ao lado dele, ou quando ser o muro proverbial contra o qual ele poderia socar.",shape=box,color=blue];
		j1373629549 -> j541123025;
	j1990801735 [label="Acho que o Lyon não quer minha ajuda",shape=box,color=red];
		j1990801735 -> j2632705610;
	j4143304863 [label="Tô tentando apoiar ele, mas ele só me ignora",shape=box,color=red];
		j4143304863 -> j3680991437;
	j541123025 [label="Mais ça? Isso aqui? Este lugar, as palavras do diabo, a incerteza que o Cardeal causou… isso trouxe-lhe uma dor da qual rezo para que ele possa se recuperar.",shape=box,color=blue];
		j541123025 -> j3028412524;
		j541123025 -> j4199447149;
	j2632705610 [label="Então, suponho que… não há mais nada a fazer a não ser dar tempo ao tempo, non?",shape=box,color=blue];
		j2632705610 -> j2137329626;
	j3680991437 [label="Comigo também é assim, e é por isso que vim discutir isso com você. Sempre consegui consolá-lo antes, mas…",shape=box,color=blue];
		j3680991437 -> j2030909168;
	j3028412524 [label="Então você admite que o Entrati machucou o Lyon? O que você acha disso?",shape=box,color=red];
		j3028412524 -> j3769692635;
	j4199447149 [label="Parece que ele tá na beira do abismo… como será que eu tiro ele de lá?",shape=box,color=red];
		j4199447149 -> j1995425821;
	j2137329626 [label="Merci, sinto muito por desperdiçar seu tempo.",shape=box,color=blue];
		j2137329626 -> "Chat ends.";
	j2030909168 [label="Fiquei surpresa com a raiva dele, o désespoir dele… ele evita minha companhia de uma forma que nunca fez antes.",shape=box,color=blue];
		j2030909168 -> j152211814;
	j3769692635 [label="Pas bien… mas como devo escolher entre o amor pelo meu irmão e minha adoração pelo Cardeal? Como devo escolher entre minha família?",shape=box,color=blue];
		j3769692635 -> j2539672883;
		j3769692635 -> j3535325423;
		j3769692635 -> j263172883;
		j3769692635 -> j1234439525;
	j1995425821 [label="Também não sei como, e é por isso que vim discutir isso com você. Sempre consegui consolá-lo antes, mas…",shape=box,color=blue];
		j1995425821 -> j2030909168;
	j152211814 [label="O que será que o perturbou tanto assim? Você sabe a causa?",shape=box,color=blue];
		j152211814 -> j2411453274;
	j2539672883 [label="Você não precisa escolher nada, Marie. As pessoas em nossa vida são complicadas mesmo, é assim que funciona",shape=box,color=red];
		j2539672883 -> j3191890377;
	j3535325423 [label="Eu escolheria a família que ainda tá ao seu lado, a que não te abandonou",shape=box,color=red];
		j3535325423 -> j592642723;
	j263172883 [label="Tenho certeza de que o Entrati não fez isso com o Lyon de propósito",shape=box,color=red];
		j263172883 -> j2276885432;
