digraph {
	77 [label="MarieRank1Convo3 begins.",color=orange];
		77 -> 78;
	78 [label="Il y a un crâne volant ! Keksekça ?! Há um crânio voador falante e todos continuam com suas vidas como se nada estivesse acontecendo, e eu preciso que alguém reconheça a estranheza da existência disso.",shape=box,color=blue];
		78 -> 79;
		78 -> 81;
		78 -> 80;
	79 [label="Ah, é só o Necraloid. Bem, um Necraloid… é complicado de explicar.",shape=box,color=red];
		79 -> 82;
	81 [label="É o Necraloid. Ele é um Cephalon, não vai te machucar.",shape=box,color=red];
		81 -> 84;
	80 [label="[Encerrar Conversa]",shape=box,color=red];
		80 -> 83;
	82 [label="Pardon, isso é um nome ou um objeto?",shape=box,color=blue];
		82 -> 85;
		82 -> 86;
	84 [label="Ah, não o vejo como uma ameaça! Ele não me assusta.",shape=box,color=blue];
		84 -> 87;
	83 [label="Chat ends.",color=orange];
	85 [label="Não sei te dizer…",shape=box,color=red];
		85 -> 88;
	86 [label="Sim.",shape=box,color=red];
		86 -> 89;
	87 [label="Na verdade, acho ele absolutamente fascinante, mesmo que um pouco inflexível para conversar. Não muito diferente da sua inspiração viva, mas, dada a natureza do meu companheiro de viagem preferido, dá para perceber que isso não me incomoda muito.",shape=box,color=blue];
		87 -> 90;
	88 [label="Primeiro, de quem são esses designs, \"Necraloids\"? São nomes de quê, talvez uma designação?",shape=box,color=blue];
		88 -> 91;
		88 -> 92;
	89 [label="Não entendi… E qual o papel do Loid nisso?",shape=box,color=blue];
		89 -> 88;
	90 [label="Não, o que talvez você considere grotesco em seu visual, eu lhe asseguro, não é o problema que tenho em mãos no momento.",shape=box,color=blue];
		90 -> 93;
		90 -> 94;
	91 [label="Criação do seu Cardeal Dimanche. Entrati.",shape=box,color=red];
		91 -> 95;
	92 [label="É criação do Entrati, mas o conceito do que eles são (Cephalons) foi inventado pelos Orokin.",shape=box,color=red];
		92 -> 95;
	93 [label="Tô surpreso que o crânio não te causa incômodo.",shape=box,color=red];
		93 -> 96;
	94 [label="Admito que, fora de contexto, ele deve ser estranho. Mas o que exatamente é perturbador?",shape=box,color=red];
		94 -> 97;
	95 [label="Excusez-moi, está sugerindo que le Cardeal criou a réplica de uma caveira voadora servente à imagem de seu próprio companheiro e a nomeou de acordo?",shape=box,color=blue];
		95 -> 98;
	96 [label="Você sabe pouco sobre mim, o que não é culpa sua. Passei grande parte da minha vida cuidando dos mortos e dos lugares onde repousam. ",shape=box,color=blue];
		96 -> 99;
	97 [label="Fico curiosa para saber o motivo de ter outro rosto em suas costas, parecidos com rabiscos de criança.",shape=box,color=blue];
		97 -> 100;
	98 [label="Por que não há mais desses necraloids, então?",shape=box,color=blue];
		98 -> 101;
		98 -> 102;
		98 -> 103;
	99 [label="Na verdade, passei grande parte da minha vida com eles como meus companheiros de rotina. Eles estão sempre dispostos a ouvir meus problemas cotidianos.",shape=box,color=blue];
		99 -> 104;
	100 [label="Perguntei ao Monsieur Necraloid e ao Monsieur Loid, e nenhum deles quis falar sobre o assunto, somente me disseram um nome: Otak. E o pronunciaram com grande tristeza.",shape=box,color=blue];
		100 -> 105;
	101 [label="Talvez tenha percebido o quão grotesco é fazer uma cópia digital de quem ama.",shape=box,color=red];
		101 -> 106;
	102 [label="Talvez a intenção era só fazer um mesmo. Vai saber…",shape=box,color=red];
		102 -> 107;
	103 [label="Sei lá. Talvez nunca tenha tido tempo de fazer outros?",shape=box,color=red];
		103 -> 108;
	104 [label="Update boolean MarieGraveyard1",color=orange];
		104 -> 109;
		104 -> 110;
	105 [label="E aqui estou eu, falando com você, na esperança de que possa me ajudar.",shape=box,color=blue];
		105 -> 111;
		105 -> 112;
	106 [label="Ou bien… uma homenagem de amor e apreço, por não acreditar que este estranho laboratório fosse continuar funcionando sem o Monsieur Loid.",shape=box,color=blue];
		106 -> 113;
		106 -> 114;
	107 [label="+5 Chemistry",color=orange];
		107 -> 115;
	108 [label="Imagine só… ter um enxame de crânios voadores com eficiência total e sem fazer força!",shape=box,color=blue];
		108 -> 114;
		108 -> 116;
	109 [label="Você gostava de cuidar de cemitérios?",shape=box,color=red];
		109 -> 117;
	110 [label="Eles já responderam alguma vez?",shape=box,color=red];
		110 -> 118;
	111 [label="Quer saber sobre o Otak? Ou o motivo de não conseguir falar com ele?",shape=box,color=red];
		111 -> 119;
	112 [label="Otak… não é fácil de explicar…",shape=box,color=red];
		112 -> 2918;
	113 [label="Eu diria que é um gesto romântico peculiar, mas não sou a melhor pessoa pra falar disso.",shape=box,color=red];
		113 -> 122;
	114 [label="Eu não me importaria se um necraloid ficasse zanzando na minha casa, sinceramente.",shape=box,color=red];
		114 -> 123;
	115 [label="Belo e trágico, à sua maneira, non ? Uma homenagem de amor e respeito, por não acreditar que este estranho laboratório pudesse continuar a funcionar sem o Monsieur Loid.",shape=box,color=blue];
		115 -> 124;
		115 -> 113;
	116 [label="Eu fico feliz que só exista um dele, sinceramente. Não acho que o mundo estaria preparado pra isso.",shape=box,color=red];
		116 -> 125;
	117 [label="E mausoléus e criptas, ah, sim. Mas admito que preferia os espaços externos, embora fossem desafiadores para a minha cadeira. Não mais do que escadas, devo dizer.",shape=box,color=blue];
		117 -> 126;
	118 [label="Hah ! Não, ainda bem que não. Não até o seu \"Necraloid\" de semblante mórbido me responder. Agora, se falar com os mortos é um dom dos Luminários, isso não é do meu conhecimento.",shape=box,color=blue];
		118 -> 127;
	119 [label="Acho que, com o tempo, gostaria de saber ambas as coisas, mas vou deixar você decidir por onde começar. Não sei qual é mais importante, après tout.",shape=box,color=blue];
		119 -> 2918;
