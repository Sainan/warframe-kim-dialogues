		182 -> 193;
	178 [label="Então, ele foi transferido ao Necraloid principal, o único que sobrou. E parece que ele tá… bem? É difícil dizer",shape=box,color=red];
		178 -> 187;
		178 -> 188;
		178 -> 189;
	176 [label="Acho isso desnecessariamente cruel, não acha? Eles podem até achar que ele morreu… ou pior! E nós, morando aqui, comme des rats d'égout?",shape=box,color=blue];
		176 -> 183;
		176 -> 184;
		176 -> 185;
	177 [label="Oui… entendo sua lógica. Se puder, seria melhor focar em resolver os problemas familiares primeiro, né? Me parece a única esperança que qualquer um de nós tem para sair daqui",shape=box,color=blue];
		177 -> 186;
	190 [label="Quando chego ao meu destino, deleito-me em sua elegância. Não corro de um lado para o outro como um besouro cheio de perninhas",shape=box,color=blue];
