	154 [label="Por alguma razão, que não faço ideia de qual é, ele foi transformado em um Cephalon e recebeu seu próprio \"corpo\" de Necraloid",shape=box,color=red];
		154 -> 159;
	152 [label="Ela já aceitou a ausência dele, e a família já fez as pazes entre eles, mas foi bem difícil chegar nesse ponto",shape=box,color=red];
