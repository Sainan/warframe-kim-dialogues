	167 [label="+5 Chemistry",color=orange];
		167 -> 173;
	168 [label="Nunca vi sentido em lamentar sobre isso. Mas admito que gosto de conseguir alcançar objetos em prateleiras altas sem precisar pedir ajuda",shape=box,color=blue];
		168 -> 174;
	169 [label="Oui, le Cardeal contou ao Lyon e a mim sobre tudo o que aconteceria ao tomarmos os soros. Sabíamos exatamente o que nos aguardava",shape=box,color=blue];
		169 -> 175;
	166 [label="+5 Chemistry",color=orange];
		166 -> 172;
	164 [label="Nem consigo imaginar o quão doloroso seria pra ela saber da verdade… pra todos eles, na real",shape=box,color=red];
		164 -> 170;
	165 [label="Espalhar essa verdade destruiria qualquer chance de reconciliação que aquela família possa ter",shape=box,color=red];
		165 -> 171;
	173 [label="Update boolean MarieSecretPower",color=orange];
		173 -> 179;
	174 [label="Ce qui est fait est fait. Eu não tinha como rezar ao Sol por um milagre com tantos ao meu redor sofrendo mais… necessitando de mais ajuda que eu. Os Luminários já haviam me dado mais do que eu merecia",shape=box,color=blue];
		174 -> 180;
	175 [label="Mas, como em todos os casos, eu aceitei meu destino com alegria, e o Lyon aceitou o dele com… ah, temo estar espalhando verdades sobre ele das quais eu não deveria",shape=box,color=blue];
		175 -> 181;
		175 -> 182;
	172 [label="Pauvre petit…",shape=box,color=blue];
		172 -> 178;
	170 [label="Embora eu possa ver a lógica por trás da decisão de protegê-los da dor que le Cardeal causou com sua partida necessária…",shape=box,color=blue];
		170 -> 176;
	171 [label="+10 Chemistry",color=orange];
		171 -> 177;
	179 [label="Oui, você me entende! Eu enxergava o mundo com outro ponto de vista. Meus braços ficaram mais fortes. Eu fiquei mais paciente. Eu sabia a importância de aproveitar os momentos",shape=box,color=blue];
		179 -> 190;
	180 [label="Preciso ir, mas obrigada por esta maravilhosa conversa ",shape=box,color=blue];
		180 -> 191;
	181 [label="Tá tudo bem, não precisa falar nada que te deixe desconfortável",shape=box,color=red];
