		184 -> 195;
	185 [label="Curiosamente, tenho uma amiga que adora ratos. Acho eles bem adoráveis",shape=box,color=red];
		185 -> 196;
	186 [label="Para não passarmos o resto de nossas vidas aqui, comme des rats d'égout",shape=box,color=blue];
		186 -> 197;
		186 -> 198;
	202 [label="Só queria que meu querido Lyon pudesse ver o mundo como você. Ver que todas as inconveniências escondem um poder secreto, como você disse",shape=box,color=blue];
		202 -> 213;
	203 [label="Agradeço sua gentileza, Peregrino. Vou dizer somente isso, para não desrespeitar os limites de ninguém aqui:",shape=box,color=blue];
		203 -> 214;
	204 [label="Não é só você que tem esse problema, Peregrino. O Lyon é como família para mim, e até hoje me pergunto: será que sei mais até das estátuas de santos da catedral do que da vida dele?",shape=box,color=blue];
		204 -> 215;
