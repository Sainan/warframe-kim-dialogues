	159 [label="Nem todo Cephalon foi feito com o objetivo de punir alguém. Mas as coisas meio que… desandaram aqui em Deimos, e ele acabou ficando bem danificado",shape=box,color=red];
		159 -> 166;
	157 [label="Sabendo que ele ainda tá solto por aí, e que ele nunca nem falou nada pra ela… nem mesmo uma carta…",shape=box,color=red];
