		2918 -> 120 [label=false,color=brown];
	122 [label="E agora estou intrigada, mas isso parece assunto para outra hora. Cela dit…",shape=box,color=blue];
		122 -> 97;
	123 [label="Então, tenho certeza de que você provavelmente está sendo assolado pela necessidade de companhia, organização, ou ambos. Mas isso é assunto para outra hora.",shape=box,color=blue];
		123 -> 97;
	124 [label="Acho que teve mais a ver com garantir que esse lugar não deixasse de existir",shape=box,color=red];
		124 -> 130;
	125 [label="De fato, eu também! O que me leva à minha próxima pergunta:",shape=box,color=blue];
		125 -> 97;
	126 [label="Update boolean MarieSerum1",color=orange];
		126 -> 131;
		126 -> 132;
	127 [label="Não, ouvir espíritos e vozes está muito mais ao alcance do meu querido Lyon. Embora eu me pergunte se o Monsieur Necraloid também não é assombrado, a julgar pelos rabiscos da criança na parte de trás da cabeça dele…",shape=box,color=blue];
		127 -> 133;
	121 [label="O Otak era um Arquimediano, um cientista e acadêmico Orokin. O que aconteceu com ele não é exatamente uma história muito feliz…",shape=box,color=red];
		121 -> 129;
	120 [label="Bem, de forma resumida, alguns dos familiares do Entrati tão lá em cima e não sabem que a gente tá aqui embaixo…",shape=box,color=red];
		120 -> 128;
	130 [label="E você pode até ter razão. O amálgama alado parece estar perdendo muito da razão de existir e da essência do verdadeiro Monsieur Loid. Cela dit…",shape=box,color=blue];
		130 -> 97;
	131 [label="Eu não sabia se seria grosseria da minha parte perguntar se seus pés foram alterados ou não pelo soro…",shape=box,color=red];
		131 -> 136;
	132 [label="Sua cadeira?",shape=box,color=red];
		132 -> 137;
	133 [label="Na realidade, é por isso que vim aqui falar com você, se não se importar.",shape=box,color=blue];
		133 -> 100;
