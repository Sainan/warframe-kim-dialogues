		128 -> 134;
	136 [label="+10 Chemistry",color=orange];
		136 -> 140;
	137 [label="Não sei como vocês chamam isso… un fauteuil roulant, ou, talvez, um termo que detesto profundamente… un fauteuil pour invalide.",shape=box,color=blue];
		137 -> 141;
	135 [label="Par les Luminários… prossiga, por favor.",shape=box,color=blue];
		135 -> 139;
	134 [label="Par les Luminários… quer dizer que estamos todos aqui em segredo?! É por isso que não temos permissão para sair?! Pourquoi?!",shape=box,color=blue];
		134 -> 138;
	140 [label="Ah, coitadinho de você! Imagino você, do outro lado da tela, achando que o Cardeal arrancou meus pés! Nada disso!",shape=box,color=blue];
		140 -> 144;
	141 [label="Parecida com a que estamos sentados nesse momento, utilizando-as para nos comunicar por estes pequenos dispositivos adoráveis. Mas com rodinhas nas laterais, para nos movimentarmos. É tipo… uma cadeira com rodas, por assim dizer",shape=box,color=blue];
		141 -> 145;
		141 -> 146;
	139 [label="Segundo relatos, ele era um gênio. A mente por trás do estudo e uso dos cristais de argônio e tudo mais",shape=box,color=red];
		139 -> 143;
	138 [label="Sua filha, Euleria (conhecida como Mãe) e sua família cuidaram de Deimos durante todo esse tempo",shape=box,color=red];
		138 -> 142;
	144 [label="Sol julgou ser correto colocar na minha vida o inconveniente de ter nascido com pés tradicionalmente desajeitados… eu não conseguia andar",shape=box,color=blue];
		144 -> 149;
	145 [label="Você era limitada assim antes de virar um Protoframe?",shape=box,color=red];
		145 -> 150;
	146 [label="Curiosamente, chamamos isso de \"cadeira de rodas\"",shape=box,color=red];
		146 -> 151;
	143 [label="Que são extraídos do Void e são a razão pela qual podemos criar muitos dos poderosos Warframes e armas que temos",shape=box,color=red];
		143 -> 148;
	142 [label="Cuidando deste lugar e do coração que bombeia energia do Void ao Sistema de Origem, mantendo todos aqui… como ferramentas utilizáveis, desde que o Entrati partiu",shape=box,color=red];
		142 -> 861;
	149 [label="Mas não passava disso, um simples inconveniente",shape=box,color=blue];
		149 -> 155;
	150 [label="Non… nunca fui uma \"limitada\" na vida",shape=box,color=blue];
		150 -> 156;
	151 [label="Hahaha! Ah, agora estou aqui, rindo de mim mesma pela minha ignorância. Sim, faz sentido chamar de cadeira de rodas, já que é, literalmente, uma cadeira com rodas",shape=box,color=blue];
		151 -> 155;
	148 [label="Ele se especializou em cristalografia, e seus trabalhos foram todos arquivados aqui, nos laboratórios",shape=box,color=red];
		148 -> 154;
