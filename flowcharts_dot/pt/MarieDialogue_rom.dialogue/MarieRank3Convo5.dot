		j2905223112 -> j4135974220;
	j1473378691 [label="Só não deixe o diabo se aproximar deles. Sinon, il va les voler! Ele costuma roubar doces quando não está satisfeito!",shape=box,color=blue];
		j1473378691 -> j420323306;
	j2798534184 [label="Ele ainda tá se recuperando, a jornada dele ainda não acabou",shape=box,color=red];
		j2798534184 -> j1727909989;
