		j1350018662 -> j873498473;
	j1097657522 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j1097657522 -> j1508231473;
	j3365075180 [label="Cuja fé sigo, quer você siga ou não, e te perdoo por isso. Se você fosse como o Lyon, eu lhe diria que 10 chicotadas seriam sua penitência.",shape=box,color=blue];
