		j2162287761 -> j17348121;
	j3037141146 [label="Oui! Sua cópia minúscula e sua triste história… me dá vontade de chorar só de pensar. Serem transformados em máquinas de guerra… por aqueles que pensavam ser família…",shape=box,color=blue];
		j3037141146 -> j465291234;
	j2507046069 [label="Oui! Ouvi dizer que você sofreu muito para aprender a lutar como luta hoje. A morte é uma tutora cruel, mal consigo imaginar…",shape=box,color=blue];
		j2507046069 -> j465291234;
	j1245107401 [label="Não sei se essas palavras farão diferença para você, ou se são somente alguns pontos brilhantes em uma máquina zumbindo.",shape=box,color=blue];
		j1245107401 -> j2891156045;
