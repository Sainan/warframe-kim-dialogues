		j465291234 -> j3748448328;
	j2891156045 [label="De fato, quando você considera a realidade da coisa, quando escrevo estas palavras, pode muito bem ter passado dias ou anos desde que as escrevi, dependendo de quando e onde você estiver.",shape=box,color=blue];
		j2891156045 -> j3439450868;
	j1160847036 [label="Quando ele ficava sobrecarregado e tudo parecia uma bagunça, eu perguntava se ele queria minha companhia. Des fois, oui, des fois, non.",shape=box,color=blue];
