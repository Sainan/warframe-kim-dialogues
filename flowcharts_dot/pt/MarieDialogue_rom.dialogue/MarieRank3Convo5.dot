		j1387955328 -> j4140862524;
	j3069649786 [label="Quando a gente cresce achando que esse é nosso único propósito, nossa única existência… é difícil sair desse molde. Ter um propósito conforta as pessoas",shape=box,color=red];
		j3069649786 -> j3446571630;
