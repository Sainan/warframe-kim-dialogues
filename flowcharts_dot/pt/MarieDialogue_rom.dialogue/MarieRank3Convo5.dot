		j3624971582 -> j2236450379;
	j4139996926 [label="Uma amiga minha chama isso de \"aranhas\", elas aparecem pra encher o saco de vez em quando",shape=box,color=red];
		j4139996926 -> j2742281454;
	j3557558750 [label="Tem vez que… tudo isso aqui… é demais pra mim. Mas relaxa, eu vou ficar bem",shape=box,color=red];
		j3557558750 -> j3220334347;
	j3606294267 [label="Achei que seria uma oportunidade de te conhecer melhor…",shape=box,color=red];
		j3606294267 -> j1054241534;
	j2283280536 [label="Ah, eu achei que seria engraçado",shape=box,color=red];
		j2283280536 -> j388165134;
	j2355909755 [label="Sinceramente… não sei. Fiz isso sem pensar direito",shape=box,color=red];
		j2355909755 -> j1080606863;
	j3076670622 [label="Tô falando sério… foi mal se te deixo desconfortável",shape=box,color=red];
		j3076670622 -> j1427806454;
	j4159693343 [label="Foi mal, tava só zoando",shape=box,color=red];
		j4159693343 -> j1427806454;
	j191835573 [label="Sou uma Sœur do Sol, não fui feita para… lutar, nem matar. O Murmure não está vivo… pelo menos é o que me dizem as Cavias… mas e os outros que eu enfrento?",shape=box,color=blue];
		j191835573 -> j2293625345;
	j2429175085 [label="+5 Chemistry",color=orange];
		j2429175085 -> j1711467467;
	j2853908898 [label="Então, não vou me intrometer. Sei que às vezes é difícil dizer isso em palavras.",shape=box,color=blue];
		j2853908898 -> j3863742836;
	j2236450379 [label="Havia uma freira na Catedral, em uma situação muito parecida. Ela nunca parava, por nada nesse mundo. Certa vez, eu a encontrei polindo prata às 3 da manhã.",shape=box,color=blue];
		j2236450379 -> j2026795946;
	j2742281454 [label="Ah, oui, acho que sei do que você está falando. É tipo uma… nuvem que se move sobre o sol.",shape=box,color=blue];
		j2742281454 -> j1691916214;
	j3220334347 [label="Como um copo que enche de água, uma gota de cada vez, non?",shape=box,color=blue];
		j3220334347 -> j2439937347;
	j1054241534 [label="Você não precisava me dizer tal coisa para me conhecer melhor.",shape=box,color=blue];
		j1054241534 -> j3073785779;
	j388165134 [label="Je ne comprends pas votre humor. Talvez no futuro, o conceito de \"engraçado\" seja diferente?",shape=box,color=blue];
		j388165134 -> j1751175571;
	j1080606863 [label="Não sei qual instinto te levou a me contar tal mensonge. ",shape=box,color=blue];
		j1080606863 -> j2244069588;
	j1427806454 [label="Bon, où en étais-je?",shape=box,color=blue];
		j1427806454 -> j4244769428;
	j2293625345 [label="Lutar em nome do Sol… é esse o meu caminho? Devo ser uma assassina em nome dele? Moi, petite Marie?",shape=box,color=blue];
		j2293625345 -> j2068882174;
		j2293625345 -> j3507985469;
	j1711467467 [label="Entendo que você está usando uma metáfora, mas estou morrendo de rir!",shape=box,color=blue];
		j1711467467 -> j2025046665;
	j3863742836 [label="Há tantas maneiras pelas quais nossos dias e nossas mentes podem ter problemas… ela pode criar buracos escuros nos quais podemos nos atolar, non?",shape=box,color=blue];
		j3863742836 -> j1336312049;
	j2026795946 [label="Perguntei por que ela estava fazendo aquilo, e ela disse que não conseguia dormir, pois estava muito preocupada.",shape=box,color=blue];
		j2026795946 -> j3518151094;
	j1691916214 [label="Temos uma palavra para isso: ennui. Um cansaço e um descontentamento que fazem tudo parecer… sem sentido.",shape=box,color=blue];
		j1691916214 -> j1886733224;
	j2439937347 [label="Ele vai encher e transbordar, até derramar seu conteúdo. E tudo parece uma catástrofe. ",shape=box,color=blue];
		j2439937347 -> j1598830303;
	j3073785779 [label="Uma alma é muito mais do que a fé que ela carrega. Sou uma Irmã do Sol, mas espero que você veja mais do que isso em mim, non?",shape=box,color=blue];
		j3073785779 -> j1350018662;
	j1751175571 [label="Para mim, isso não é nada engraçado.",shape=box,color=blue];
		j1751175571 -> j1097657522;
	j2244069588 [label="Só espero que tenha sido sem más intenções, e não uma piada cruel às minhas custas. Então, escolherei seguir o exemplo do Sol.",shape=box,color=blue];
		j2244069588 -> j3365075180;
	j4244769428 [label="Check boolean DrifterFaithSol",color=orange];
		j4244769428 -> j2880110663 [label=true,color=green];
		j4244769428 -> j2162287761 [label=false,color=brown];
	j2068882174 [label="Não fui treinado para ser um soldado, não como a criança… e nem você",shape=box,color=red];
		j2068882174 -> j3037141146;
	j3507985469 [label="Eu… nem sempre fui assim. Sempre fui guerreira, sempre tive que aprender do jeito difícil.",shape=box,color=red];
		j3507985469 -> j2507046069;
	j2025046665 [label="A imagem disso que está na minha cabeça me dá arrepios. Antes que eu não consiga respirar, me diga: ao que você está se referindo?",shape=box,color=blue];
		j2025046665 -> j2068882174;
		j2025046665 -> j3507985469;
	j1336312049 [label="Só podemos nos esforçar para ser gentis e pacientes quando isso acontece.",shape=box,color=blue];
		j1336312049 -> j1245107401;
	j3518151094 [label="Cada vez que a encontrava dessa forma, perguntava se ela queria companhia. Às vezes, ela dizia que sim… às vezes dizia que não.",shape=box,color=blue];
		j3518151094 -> j3863742836;
	j1886733224 [label="Ou talvez seja um desejo de se esconder, de chorar… como um desespero. Não sei dizer.",shape=box,color=blue];
		j1886733224 -> j2858638919;
	j1598830303 [label="Você limpa a bagunça, endireita a xícara e… começa tudo de novo, oui?",shape=box,color=blue];
		j1598830303 -> j2239042094;
	j1350018662 [label="Há tantos tópicos que poderíamos escolher, quase o mesmo tanto de estrelas no céu!",shape=box,color=blue];
