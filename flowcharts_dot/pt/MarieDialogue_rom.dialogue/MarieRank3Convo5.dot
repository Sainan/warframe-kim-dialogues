		j3388755829 -> j3593990060;
	j2506282171 [label="Acho que não tem um jeito \"bom\" de ir parar numa vida de guerra. Nascer, ser criado ou escolher isso… no fim das contas, tudo se resume a quem você é e o que faz com isso",shape=box,color=red];
		j2506282171 -> j1621790641;
