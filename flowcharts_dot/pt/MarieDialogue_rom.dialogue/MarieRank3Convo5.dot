	j2891208988 [label="Hahaha! Oui, é isso mesmo. Très bien, fico feliz em ouvir isso.",shape=box,color=blue];
		j2891208988 -> j3579868024;
	j4101373149 [label="Oui, mas aí você não seria o lobo libertino que conhecemos e amamos, não é mesmo? Acho que o Sol te colocou exatamente no caminho em que você precisava estar.",shape=box,color=blue];
		j4101373149 -> j959553546;
	j701885396 [label="Oui, concordo plenamente. Ninguém nasceu para a guerra. Bem, exceto esses \"Grin-ire\" de que me falaram, e mesmo assim…",shape=box,color=blue];
		j701885396 -> j3876504942;
	j848208416 [label="Des pâtisseries!",shape=box,color=blue];
		j848208416 -> j4132951681;
	j3579868024 [label="Ah! O almoço está servido, preciso ir. Até mais, lobo. É muito bom conversar com você.",shape=box,color=blue];
		j3579868024 -> "Chat ends.";
	j959553546 [label="Mas entendo o que você quer dizer. Você vê a estrutura e a orientação que sua contraparte recebeu, e não consegue deixar de desejar ter tido o mesmo. Especialmente quando você estava tão sozinho.",shape=box,color=blue];
		j959553546 -> j1387955328;
