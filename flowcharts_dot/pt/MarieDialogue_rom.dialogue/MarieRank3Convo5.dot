		j620061139 -> j2075179331;
	j3924504094 [label="(Então é assim que se escreve, merci!) Isso me deixa tão feliz em saber. Que até mesmo uma raça, que foi ensinada que esse é seu único propósito, pode encontrar outro.",shape=box,color=blue];
		j3924504094 -> j956796083;
