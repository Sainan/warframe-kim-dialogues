digraph {
	2615 [label="MarieEntratiDay2 begins.",color=orange];
		2615 -> 2616;
	2616 [label="Peregrino. Tirei um tempo para pensar e… me acalmar. Tenho uma regra rígida sobre não discutir quando estou nervosa.",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="Evaluate expressions",color=orange];
		2617 -> 2618 [label="MarieEntrati5a",color=purple];
		2617 -> 2619 [label="MarieEntrati5b",color=purple];
		2617 -> 2620 [label="MarieEntrati5c",color=purple];
		2617 -> 2621 [label="MarieEntrati5d",color=purple];
		2617 -> 2622 [label="MarieEntrati5e",color=purple];
		2617 -> 2623 [label="MarieEntrati5f",color=purple];
		2617 -> 2624 [label="MarieEntrati5g",color=purple];
		2617 -> 2625 [label="MarieEntrati5h",color=purple];
		2617 -> 2626 [label="MarieEntrati5i",color=purple];
		2617 -> 2627 [label="false",color=purple];
	2618 [label="Foi… uma facada entre as costelas que você me deu ontem. Admito que fugi pela raiva, oui, mas também por repulsa. Não de você, mas de mim mesma.",shape=box,color=blue];
		2618 -> 2628;
	2619 [label="Mas antes de prosseguirmos, preciso abordar uma questão: o seu tom de voz comigo. Sei que você deve me achar uma criança. Você tem séculos de idade, talvez até mais.",shape=box,color=blue];
		2619 -> 2629;
	2620 [label="Refleti bastante sobre o que você falou. Que esta não é uma guerra santa e que le Cardinal tem sido manipulador em suas ações.",shape=box,color=blue];
		2620 -> 2630;
	2621 [label="Você estava… claro, certo ao me questionar onde nas escrituras de Sol está escrito que inocentes são descartáveis. Não está.",shape=box,color=blue];
		2621 -> 2631;
	2622 [label="Antes de prosseguirmos, preciso abordar uma questão: sua tendência a instrumentalizar minha fé contra mim em uma discussão, sendo que você mesmo não pratica a fé.",shape=box,color=blue];
		2622 -> 2632;
	2623 [label="Eu… peço perdão por ter fugido da nossa conversa ontem. Foi simplesmente muita coisa. Mas preciso lhe perguntar, antes de continuarmos: você estava falando sério? Ou estava apenas tentando manipular meus sentimentos para evitar uma discussão desagradável?",shape=box,color=blue];
		2623 -> 2633;
		2623 -> 2634;
	2624 [label="Parece que chegamos a um impasse sobre le Cardinal, oui? Você o vê como um monstro, e eu, como um santo.",shape=box,color=blue];
		2624 -> 2635;
	2625 [label="Se estiver disposto, gostaria de conversar sobre a sua decisão de apoiar o Entrati apenas para ganhar minha afeição.",shape=box,color=blue];
		2625 -> 2636;
	2626 [label="Gostaria de falar com você sobre a sua mentira, agora, se você estiver disposto.",shape=box,color=blue];
		2626 -> 2636;
	2627 [label="Chat ends.",color=orange];
	2628 [label="Como eu poderia me surpreender com tamanha precisão mortal em sua mira? Comparar minhas palavras com as do diabo…",shape=box,color=blue];
		2628 -> 2637;
	2629 [label="Você viajou através de dimensões desconhecidas, no próprio Void. Lutou contra deuses e anjos. Quem sou eu para você, oui? Apenas a boba da Marie.",shape=box,color=blue];
		2629 -> 2638;
	2630 [label="E acho que… oui, você está certo. Esta não é uma guerra santa. Porque isso não existe. A guerra nunca é santa, justa ou correta. A dor nunca deve ser a luz que nos guia.",shape=box,color=blue];
		2630 -> 2639;
	2631 [label="A guerra nunca é santa, justa ou correta. A dor nunca deve ser a luz que nos guia.",shape=box,color=blue];
		2631 -> 2639;
	2632 [label="Isso foi desonesto, Peregrino. Cruel e ineficaz. Uma tentativa de \"vencer\" uma conversa, e não é assim que se deve agir.",shape=box,color=blue];
		2632 -> 2640;
	2633 [label="Eu falei sério. Desculpa se o meu timing foi… ruim. Eu gosto muito de você, Marie…",shape=box,color=red];
		2633 -> 2641;
	2634 [label="Não quis dizer aquilo, eu só… me deixei levar. Sinto muito mesmo. Foi a paixão do momento",shape=box,color=red];
		2634 -> 2642;
	2635 [label="No entanto… não quero deixar as coisas entre nós desse jeito. Você é uma boa pessoa e não quero que nossa relação azede.",shape=box,color=blue];
		2635 -> 2946;
	2636 [label="Tentar manipular a situação para controlar meus sentimentos é… desonesto e cruel. Confesso que quero te odiar por isso, Peregrino.",shape=box,color=blue];
		2636 -> 2644;
	2637 [label="Eu me considerava uma pessoa de mente e coração abertos para o mundo e todos que nele habitam. E você, de forma sucinta e com uma única flecha certeira, provou o contrário.",shape=box,color=blue];
		2637 -> 2645;
	2638 [label="Por um lado, eu entendo. Compreendo a situação. Os dois se exaltaram. Mas, por outro lado, peço que me trate com mais gentileza e tato do que demonstrou.",shape=box,color=blue];
		2638 -> 2646;
	2639 [label="Mesmo o que fazemos agora… destruir o Murmúrio e lutar contra os numerosos inimigos… não é o caminho dos Luminários.",shape=box,color=blue];
		2639 -> 2647;
	2640 [label="A fé não é, nem jamais deveria ser, uma arma para ser usada contra os outros. É um escudo. Uma luz na escuridão. Uma voz que guia o caminho.",shape=box,color=blue];
		2640 -> 2648;
	2641 [label="Antes de enfrentar o peso disso, devo me explicar em relação ao Cardinal, por favor.",shape=box,color=blue];
		2641 -> 2649;
	2642 [label="Update boolean DrifterMarie",color=orange];
		2642 -> 2650;
	2946 [label="Check boolean LoidFamilyComplete",color=orange];
		2946 -> 2651 [label=true,color=green];
		2946 -> 2643 [label=false,color=brown];
	2644 [label="No entanto… não quero deixar as coisas entre nós desse jeito. Temos um bom relacionamento e não quero que ele azede.",shape=box,color=blue];
		2644 -> 1395;
	2645 [label="Acho que estou aqui pour m'excuser, para dizer que sinto muito por ter me deixado levar por uma mentalidade tão tola. Espero que você entenda.",shape=box,color=blue];
		2645 -> 2653;
		2645 -> 2654;
	2646 [label="Pois eu vivi nas ruas. Vivi cada dia da minha vida em agonia física. Conheci o amor e o desamor, conheci o medo e a rejeição. Conheci a vida e o luto.",shape=box,color=blue];
		2646 -> 2655;
	2647 [label="Por mais necessário que seja erguer a espada para que o mundo não seja invadido por indivíduos como eles, não devemos venerar tal ato. E certamente é indesculpável quando pessoas inocentes sofrem as consequências disto.",shape=box,color=blue];
		2647 -> 2656;
	2648 [label="E você tentar usar isso contra mim simplesmente para \"vencer\"? Foi uma tática covarde. Mas ambos nos exaltamos, e eu… te perdoarei, se você me perdoar, pelas palavras ditas no calor do momento.",shape=box,color=blue];
		2648 -> 2657;
		2648 -> 2658;
	2649 [label="Acho que é difícil para mim abandonar minha lealdade ao Cardinal… e levei algum tempo para entender por que não conseguia me desprender dele.",shape=box,color=blue];
		2649 -> 2659;
	2650 [label="Non, eu entendo… Quantos assassinatos foram cometidos como \"crimes passionais\", oui? E certamente, muitas crianças também foram concebidas nesse mesmo contexto.",shape=box,color=blue];
		2650 -> 2660;
	2651 [label="E você se tornou importante para mim em tão pouco tempo… Nossas conversas têm sido muito joyeuses.",shape=box,color=blue];
		2651 -> 2661;
	2643 [label="De fato, ainda desejo ver o Monsieur Loid reunido com aqueles que partiram. Desejo que a família do Cardinal encontre conforto, e você é o caminho para isso acontecer! ",shape=box,color=blue];
		2643 -> 2651;
	1395 [label="Check boolean LoidFamilyComplete",color=orange];
		1395 -> 2662 [label=true,color=green];
		1395 -> 2652 [label=false,color=brown];
	2653 [label="Eu entendo. E desculpa se o jeito que eu falei te magoou. Eu só não sabia como falar de outra forma",shape=box,color=red];
		2653 -> 2663;
	2654 [label="Que bom que as minhas palavras te convenceram. Eu já tava começando a perder a esperança",shape=box,color=red];
		2654 -> 2664;
	2655 [label="E se você verdadeiramente se acha tão superior a todos nós, então não verá nada além das nuvens em que está perdido.",shape=box,color=blue];
		2655 -> 2657;
		2655 -> 2658;
	2656 [label="Então… admito que le Cardinal não tem justificativa para prejudicar os outros em nome de um \"bem maior\".",shape=box,color=blue];
		2656 -> 2665;
	2657 [label="Fiquei frustrado, mas não sei mais como te fazer entender isso. O Entrati não é seu amigo, nem seu pai",shape=box,color=red];
