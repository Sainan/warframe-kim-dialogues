		j3151953893 -> j2529015854;
	j3942594739 [label="Foi a clareza do Loid que me permitiu ver além da minha própria visão turva. Pois o Loid ama le Cardinal – seu querido Albrecht – e, ainda assim, enxerga todos os seus defeitos.",shape=box,color=blue];
		j3942594739 -> j513703584;
	j2367247839 [label="Sim, ele o ama. Ainda assim, consegue enxergar todos os seus defeitos. E foi essa clareza que me permitiu ver além da minha própria visão turva.",shape=box,color=blue];
		j2367247839 -> j513703584;
