		3855 -> 3858;
	3856 [label="Update boolean MarieEntratiCompleteC",color=orange];
		3856 -> 3859;
	3857 [label="Oui! E se você deseja estar comigo, eu também gostaria disso.",shape=box,color=blue];
		3857 -> 3860;
		3857 -> 3861;
	3858 [label="E isso é culpa sua, não minha! Mas se você deseja estar comigo, eu também gostaria disso.",shape=box,color=blue];
