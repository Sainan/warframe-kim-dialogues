	3825 [label="Quero sim",shape=box,color=red];
		3825 -> 3830;
	3826 [label="Ele disse?",shape=box,color=red];
		3826 -> 3828;
	3827 [label="Me desculpa, de verdade. Sei que te ofendi. E essa não era minha intenção. Era a última coisa que queria fazer, pode acreditar",shape=box,color=red];
		3827 -> 3831;
	3828 [label="Je vais le tuer! Je savais que ce démon était rempli de la pire merde qui soit! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses!",shape=box,color=blue];
		3828 -> 3832;
	3829 [label="Não vou me alongar nesse assunto, pois ele já me convenceu bastante na sua ausência. E, como é típico do diabo, apresentou argumentos bem convincentes.",shape=box,color=blue];
		3829 -> 3833;
	3830 [label="Não vou me alongar nesse assunto, pois ele já me convenceu bastante na sua ausência. E, como é típico do diabo, apresentou argumentos bem convincentes.",shape=box,color=blue];
		3830 -> 3834;
	3831 [label="E por que isso?",shape=box,color=blue];
		3831 -> 3835;
		3831 -> 3836;
	3832 [label="Chat ends.",color=orange];
	3833 [label="E admito que estou… ficando bastante cansada de estar presa aqui embaixo sans recours.",shape=box,color=blue];
		3833 -> 3837;
	3834 [label="Mas não foram as palavras dele, e sim a sua inteligência, que você deve agradecer. Ele me colocou para conversar com o Monsieur Loid.",shape=box,color=blue];
		3834 -> 3838;
		3834 -> 3839;
	3835 [label="[Confessar Sentimentos] Porque eu gosto muito de você, Marie… eu te amo",shape=box,color=red];
		3835 -> 3840;
	3836 [label="Deixa pra lá, isso foi claramente um erro",shape=box,color=red];
		3836 -> 3841;
	3837 [label="Então, muito bem. Eu te ajudarei.",shape=box,color=blue];
		3837 -> 3842;
	3838 [label="Sério?",shape=box,color=red];
		3838 -> 3843;
	3839 [label="Mas o Loid ama o Albrecht, não é?",shape=box,color=red];
		3839 -> 3844;
	3840 [label="Sabia que ia acabar falando besteira. E, olha só, fiz exatamente isso",shape=box,color=red];
		3840 -> 3845;
	3841 [label="Você é tão ruim quanto ele.",shape=box,color=blue];
		3841 -> 3846;
	3842 [label="Update boolean MarieFamilySuccess",color=orange];
		3842 -> 3847;
	3843 [label="Foi a clareza do Loid que me permitiu ver além da minha própria visão turva. Pois o Loid ama le Cardinal – seu querido Albrecht – e, ainda assim, enxerga todos os seus defeitos.",shape=box,color=blue];
		3843 -> 3848;
	3844 [label="Sim, ele o ama. Ainda assim, consegue enxergar todos os seus defeitos. E foi essa clareza que me permitiu ver além da minha própria visão turva.",shape=box,color=blue];
		3844 -> 3848;
	3845 [label="Sinto muito por recorrer ao Roathe para chamar sua atenção, mas não sabia a quem mais recorrer",shape=box,color=red];
		3845 -> 3849;
	3846 [label="Chat ends.",color=orange];
	3847 [label="Update boolean MarieFamilyFail",color=orange];
		3847 -> 3850;
	3848 [label="Pois o que é o amor senão aceitar a outra pessoa com todas as suas qualidades e defeitos, après tout?",shape=box,color=blue];
		3848 -> 3851;
	3849 [label="Oh, Peregrino… meu pobre Peregrino. Você não precisava ir tão longe para conseguir meu perdão. ",shape=box,color=blue];
