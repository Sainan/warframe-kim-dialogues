	j2724359855 [label="Quero sim",shape=box,color=red];
		j2724359855 -> j1266486759;
	j1038345094 [label="Me desculpa, de verdade. Sei que te ofendi. E essa não era minha intenção. Era a última coisa que queria fazer, pode acreditar",shape=box,color=red];
		j1038345094 -> j3697659010;
	j3823196548 [label="Je vais le tuer! Je savais que ce démon était rempli de la pire merde qui soit! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses!",shape=box,color=blue];
		j3823196548 -> "Chat ends.";
	j1852719521 [label="Não vou me alongar nesse assunto, pois ele já me convenceu bastante na sua ausência. E, como é típico do diabo, apresentou argumentos bem convincentes.",shape=box,color=blue];
		j1852719521 -> j860170892;
	j1266486759 [label="Não vou me alongar nesse assunto, pois ele já me convenceu bastante na sua ausência. E, como é típico do diabo, apresentou argumentos bem convincentes.",shape=box,color=blue];
		j1266486759 -> j2295789557;
	j3697659010 [label="E por que isso?",shape=box,color=blue];
		j3697659010 -> j3428457402;
		j3697659010 -> j3018514402;
	j860170892 [label="E admito que estou… ficando bastante cansada de estar presa aqui embaixo sans recours.",shape=box,color=blue];
		j860170892 -> j971556362;
	j2295789557 [label="Mas não foram as palavras dele, e sim a sua inteligência, que você deve agradecer. Ele me colocou para conversar com o Monsieur Loid.",shape=box,color=blue];
		j2295789557 -> j2900315119;
		j2295789557 -> j2399614816;
