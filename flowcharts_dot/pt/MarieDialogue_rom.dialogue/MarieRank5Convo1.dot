	2434 [label="Andei refletindo mais sobre a minha discussão com o Monsieur Tagfer e sobre o nosso desentendimento a respeito disso.",shape=box,color=blue];
		2434 -> 2436;
	2435 [label="Sinto que muita coisa não foi dita sobre le Cardinal. Os outros parecem pisar em ovos perto de mim, com medo de falar dele.",shape=box,color=blue];
		2435 -> 2436;
	2436 [label="Sei que os outros querem pintá-lo como um cão, um louco, um traidor. Mas ele não era nada disso para mim.",shape=box,color=blue];
