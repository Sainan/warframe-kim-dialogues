	2563 [label="Eu… não foi isso o que eu quis dizer. Isto não é uma guerra santa, é algo completamente diferente…",shape=box,color=blue];
		2563 -> 2572;
	2564 [label="Oui! Précisément. E tenho certeza de que todos acabarão vendo isso com o tempo. Fico muito feliz por ter um amigo ao meu lado nessa questão.",shape=box,color=blue];
		2564 -> 2573;
	2565 [label="Confia em mim, não é não. Várias pessoas perderam a vida por causa disso. E eu consigo listar um monte de pessoas que tiveram suas vidas arruinadas por causa dele. Mas ninguém se esqueceu da Indiferença",shape=box,color=red];
		2565 -> 2574;
	2566 [label="Tenho certeza de que se eu a encontrasse, saberia disso em pouco tempo! Todos aqui são rápidos em me contar sobre todo o sofrimento que passaram nas mãos dele! Não me admira que le Cardinal não volte. Eu não passaria um segundo aqui se fosse ele.",shape=box,color=blue];
		2566 -> 2575;
	2567 [label="Não acho que isso o assustaria! Acha que le Cardinal voltaria a esse ninho de vipères?! Non! Eu não passaria um segundo aqui se fosse ele. ",shape=box,color=blue];
