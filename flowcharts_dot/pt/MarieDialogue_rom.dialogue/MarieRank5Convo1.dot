		2437 -> 2439 [label=true,color=green];
		2437 -> 2438 [label=false,color=brown];
	2439 [label="Talvez seja porque sou tão acostumada a ser abandonada. ",shape=box,color=blue];
		2439 -> 2440;
	2438 [label="Fui abandonada pela minha família, deixada nas ruas quando criança, por ser… anormal. Quebrada. Inadequada para a alta sociedade.",shape=box,color=blue];
		2438 -> 2440;
	2440 [label="Talvez seja porque nunca tive um pai de quem falar, que estou tão disposta a perdoá-lo por sua ausência.",shape=box,color=blue];
		2440 -> 2441;
	2441 [label="Evaluate expressions",color=orange];
		2441 -> 2442 [label="MarieEntrati4a",color=purple];
