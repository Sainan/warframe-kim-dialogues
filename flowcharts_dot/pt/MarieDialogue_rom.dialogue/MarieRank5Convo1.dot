		2462 -> 2472 [label="false",color=purple];
	2463 [label="E essa é a sua sugestão? Excluir le Cardinal? Parece ser exatamente isso que ele fez consigo mesmo, non?",shape=box,color=blue];
		2463 -> 2474;
		2463 -> 2467;
	2464 [label="Creio que Lyon sofre de muitos males, muitos são decorrentes da dúvida que sente de si próprio e da sua capacidade. Le Cardinal parece ter… apenas acelerado as coisas.",shape=box,color=blue];
		2464 -> 2475;
		2464 -> 2467;
	2465 [label="O que você quer que eu faça? Queime uma efígie do Cardinal e o denuncie? Condene-o ao Void, deseje-lhe mal como o Monsieur Tagfer ?",shape=box,color=blue];
		2465 -> 2474;
		2465 -> 2467;
	2466 [label="Esse é o problema, Marie. O que você tá pedindo dos outros. Não o que eles pedem de você, nem do Entrati",shape=box,color=red];
		2466 -> 2476;
	2467 [label="Entrati deixa um rastro de dor por onde passa. Tudo o que tenho tentado fazer é ajudar essas pessoas a reconstruírem suas vidas. Não me importo muito com \"bem\" ou \"mal\" no caso dele",shape=box,color=red];
		2467 -> 2477;
	2469 [label="Oui, e você é tão consistente no seu ódio por ele! Nada do que eu disse conseguiu melhorar seus sentimentos pelo Cardinal?",shape=box,color=blue];
		2469 -> 2482;
	2468 [label="Você não estava me dizendo que apoiava o Entrati, assim como eu, há alguns instantes? O que te fez mudar de ideia?",shape=box,color=blue];
		2468 -> 2478;
		2468 -> 2479;
		2468 -> 2480;
		2468 -> 2481;
	2470 [label="Oui, e você parece achar que o Entrati é um monstro! Você é tão rápido em rejeitar o lado bom dele!",shape=box,color=blue];
		2470 -> 2482;
	2473 [label="Você não estava me falando da monstruosidade do Entrati há alguns instantes? O que te fez mudar de ideia?",shape=box,color=blue];
		2473 -> 2478;
		2473 -> 2479;
		2473 -> 2480;
		2473 -> 2481;
	2471 [label="Merci, e você tem sido meu companheiro fiel nesta cruzada! Creio que sejamos os únicos a pensar assim, até mesmo o Monsieur Loid nutre tal ressentimento…",shape=box,color=blue];
		2471 -> 2483;
	2472 [label="Merci, e fico feliz em ouvir isso! Creio que sejamos os únicos com essa opinião, até o Monsieur Loid nutre esse ressentimento…",shape=box,color=blue];
		2472 -> 2483;
	2474 [label="Acho que a questão é mais o que você tá pedindo dos outros, e não o que eles tão pedindo de você, nem do Entrati",shape=box,color=red];
		2474 -> 2476;
	2475 [label="E isso não te incomoda?",shape=box,color=red];
		2475 -> 2484;
	2476 [label="E o que é que estou pedindo aos outros que é tão absurdo? Que aceitem o perdão em seus corações?",shape=box,color=blue];
		2476 -> 2485;
		2476 -> 2486;
	2477 [label="Nobre, embora cansativo, viajar pelo tempo e espaço para ajudar seus insatisfeitos, non? Você certamente deve guardar ressentimento dele por isso…",shape=box,color=blue];
		2477 -> 2487;
		2477 -> 2488;
	2482 [label="Esta conversa foi um erro…",shape=box,color=blue];
		2482 -> 2493;
		2482 -> 2494;
	2478 [label="Pra falar a verdade, tenho tido muita dificuldade em falar desse assunto com você. É complicado. Pessoalmente, acho que ele não é… nem bom nem mau. Mas uma mistura dos dois",shape=box,color=red];
		2478 -> 2489;
	2479 [label="Mudei de ideia. Tô do lado dele e do seu. Você me convenceu",shape=box,color=red];
		2479 -> 2490;
	2480 [label="[Confessar Sentimentos] Eu realmente tentei ao máximo… causar uma boa impressão, admito. Eu gosto de você… mais do que deixei transparecer",shape=box,color=red];
		2480 -> 2491;
	2481 [label="Mudei de ideia e decidi que ele é um monstro mesmo, de uma vez por todas",shape=box,color=red];
		2481 -> 2492;
	2483 [label="Juntos, talvez possamos nos opor àqueles que querem macular suas boas ações, oui? Mas eu me pergunto, por que você está do meu lado?",shape=box,color=blue];
		2483 -> 2495;
	2484 [label="Check boolean LyonDating",color=orange];
