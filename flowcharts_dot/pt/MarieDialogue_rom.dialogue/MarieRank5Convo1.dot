	2528 [label="Oui ! Exatamente! Finalmente, alguém que pensa com bom senso. Parte meu coração saber que inocentes precisam ser feridos nesta guerra, mas tudo está em jogo. ",shape=box,color=blue];
		2528 -> 2541;
	2529 [label="Update boolean MarieWillDate",color=orange];
		2529 -> 2542;
	2530 [label="Marie, ele não é um deus. Ele é só um homem. Tão arrogante e perigoso quanto o Roathe. Ele vem da mesma sociedade e sofre dos mesmos problemas",shape=box,color=red];
		2530 -> 2543;
	2531 [label="Eu sei que ele foi bom pra você… que ele talvez tenha sido diferente com você do que com muitas outras pessoas. De repente até te tratou como uma filha… mas, por favor, tente enxergar o quadro geral aqui",shape=box,color=red];
		2531 -> 2544;
