		2441 -> 2446 [label="MarieEntrati3",color=purple];
		2441 -> 2447 [label="false",color=purple];
	2442 [label="Mas o fato é que eu o perdoo. Pois vejo mais valor em suas boas ações do que dano em suas más ações.",shape=box,color=blue];
		2442 -> 2448;
		2442 -> 2449;
		2442 -> 2450;
		2442 -> 2451;
		2442 -> 2452;
	2443 [label="Rezo para que o Lyon seja forte e sobreviva à crise de fé que enfrenta, mas não creio que a culpa disso seja totalmente do Cardinal.",shape=box,color=blue];
		2443 -> 2448;
		2443 -> 2449;
		2443 -> 2450;
		2443 -> 2453;
		2443 -> 2454;
	2444 [label="Embora eu aprecie seus argumentos convincentes a respeito do Monsieur Tagfer e daqueles que foram prejudicados por ele… ainda vejo mais valor em suas boas ações do que dano em suas más ações.",shape=box,color=blue];
		2444 -> 2448;
		2444 -> 2449;
		2444 -> 2450;
		2444 -> 2455;
		2444 -> 2456;
	2445 [label="Embora eu compreenda a indignação do Monsieur Tagfer e possa simpatizar com seus argumentos, ele precisa encontrar espaço em seu próprio coração para perdoar le Cardinal. Pois vejo mais valor em suas boas ações do que dano em suas más ações.",shape=box,color=blue];
		2445 -> 2448;
		2445 -> 2449;
		2445 -> 2450;
		2445 -> 2457;
		2445 -> 2458;
	2446 [label="Embora eu compreenda o histórico de todos com le Cardinal, especialmente o do Monsieur Tagfer, sigo vendo mais valor em suas boas ações do que dano em suas más ações.",shape=box,color=blue];
		2446 -> 2448;
		2446 -> 2449;
		2446 -> 2450;
		2446 -> 2459;
	2447 [label="Embora eu compreenda o histórico de todos com le Cardinal, sigo vendo mais valor em suas boas ações do que dano em suas más ações.",shape=box,color=blue];
		2447 -> 2448;
		2447 -> 2449;
		2447 -> 2450;
	2448 [label="Não te culpo por valorizar o bem que ele fez na sua vida, do mesmo jeito que não culpo os outros por se ressentirem pelo mal que ele causa na vida deles",shape=box,color=red];
		2448 -> 2460;
	2449 [label="Sei não… acho que as ações dele causaram muito mais mal do que bem. Queria que você enxergasse isso",shape=box,color=red];
		2449 -> 2461;
	2450 [label="Eu tô do seu lado, Marie. Não posso criticar o Entrati por nada do que ele fez. Ele luta contra a Indiferença",shape=box,color=red];
		2450 -> 2462;
	2451 [label="Você tem razão em perdoar o Entrati. Gostaria que mais pessoas seguissem seu exemplo",shape=box,color=red];
		2451 -> 2462;
	2452 [label="Nunca vou julgar alguém por perdoar. Mas você pode perdoar alguém, entendendo que precisa se proteger e proteger os outros dessa pessoa",shape=box,color=red];
		2452 -> 2463;
	2453 [label="Você acha que o sofrimento do Lyon é culpa dele?",shape=box,color=red];
		2453 -> 2464;
	2454 [label="Lyon tá sofrendo muito mais do que uma crise de fé, Marie. E muito disso tem a ver com o Entrati",shape=box,color=red];
		2454 -> 2461;
	2455 [label="Nada do que eu falei conseguiu equilibrar os lados, nem um pouco?",shape=box,color=red];
		2455 -> 2465;
	2456 [label="Como você consegue olhar tudo que o Entrati fez e ainda assim ver mais coisas boas do que ruins?",shape=box,color=red];
		2456 -> 2461;
	2457 [label="Acho que você tá minimizando a gravidade do que as Cavias e o Tagfer sofreram",shape=box,color=red];
		2457 -> 2461;
	2458 [label="O perdão é importante. Mas reconhecer que o Entrati pode ser mais complicado do que você está disposto a reconhecer também é",shape=box,color=red];
		2458 -> 2465;
	2459 [label="Continuo achando que você não entendeu o que o Tagfer e as Cavias sofreram. É pior do que o que você passou",shape=box,color=red];
		2459 -> 2461;
	2460 [label="Mas você percebe como os dois não têm o mesmo peso? Ressentimento e veneração? Eu gostaria que os outros renunciassem aos seus rancores maliciosos.",shape=box,color=blue];
		2460 -> 2466;
