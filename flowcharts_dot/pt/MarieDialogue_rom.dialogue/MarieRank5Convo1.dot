		2499 -> 2515;
	2500 [label="Talvez ele esteja apenas injetando veneno para que o corpo possa se curar. Talvez seja tudo uma crueldade necessária.",shape=box,color=blue];
		2500 -> 2516;
		2500 -> 2517;
	2505 [label="[Confessar Sentimentos] Eu me importo com você. Mais do que demonstrei. E… desculpa por ter sido grosso, mas não posso deixar ele te fazer mal. Não como ele já fez pra tantos outros",shape=box,color=red];
		2505 -> 2523;
	2506 [label="Eu vi o Entrati destruir todos que significavam algo pra ele. Todos que ele supostamente amava. Não quero ver ele fazer o mesmo com você…",shape=box,color=red];
		2506 -> 2524;
	2507 [label="Não sou muito bom em me expressar e me desculpa por isso. Mas ele… tenho medo dele estar te usando e se aproveitando da sua bondade pra te manipular. É só isso",shape=box,color=red];
		2507 -> 2525;
	2508 [label="Você pode ver o Entrati como um salvador, mas eu vejo como um velho assustado procurando respostas. Talvez a verdade esteja em algum lugar entre esses dois extremos",shape=box,color=red];
		2508 -> 2498;
