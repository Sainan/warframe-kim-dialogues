	2510 [label="[Confessar Sentimentos] Eu gosto de você… mais do que deixei transparecer",shape=box,color=red];
		2510 -> 2527;
	2511 [label="Acho que temos que usar tudo ao nosso favor nessa guerra. A ideia não é salvar o universo da Indiferença?",shape=box,color=red];
		2511 -> 2528;
	2512 [label="Eu acredito no Entrati. De verdade. Acho que ele tem um plano para resolver isso e que tudo foi para um bem maior",shape=box,color=red];
		2512 -> 2529;
	2513 [label="Mas a sua perda de fé não é obra do Cardinal. A rachadura nos alicerces já estava lá. Simplesmente adicionaram mais pressão, oui?",shape=box,color=blue];
		2513 -> 2500;
	2514 [label="Update boolean MarieWarning",color=orange];
		2514 -> 2499;
	2515 [label="Tenho plena consciência de que le Cardinal é a Lua e o Sol, luz e trevas, bem e mal. Ele não é nenhum dos dois e é ambos, capaz de bondade e crueldade.",shape=box,color=blue];
		2515 -> 2530;
		2515 -> 2531;
	2516 [label="É por isso que os outros ficam chateados quando você fala dele. Você passa pano pra tudo que ele fez e finge que nada aconteceu",shape=box,color=red];
		2516 -> 2498;
	2517 [label="Para com isso, Marie. Você precisa aceitar que ele não tá fazendo tudo isso só porque é um homem bom. Ele não é, isso tudo é bem mais complexo",shape=box,color=red];
