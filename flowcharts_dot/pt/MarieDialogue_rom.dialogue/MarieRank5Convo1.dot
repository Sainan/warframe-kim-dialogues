		2484 -> 2497 [label=false,color=brown];
	2485 [label="Você colocou o Entrati num pedestal, Marie. E tá pedindo pros outros fazerem o mesmo, como idiotas",shape=box,color=red];
		2485 -> 2498;
	2486 [label="Acho que o que você tá pedindo pra eles é mais do que só perdoar o Entrati. Acho que você tá pedindo pra ignorarem tudo que ele já fez de errado",shape=box,color=red];
		2486 -> 2499;
	2487 [label="Claro, mas também foi por causa dele que construí algumas das minhas relações e amizades mais importantes",shape=box,color=red];
		2487 -> 2500;
	2488 [label="Na real, não. Ele precisa de mim pra fazer isso, então eu faço. Só depois que tudo acabar que eu vou julgar ele",shape=box,color=red];
