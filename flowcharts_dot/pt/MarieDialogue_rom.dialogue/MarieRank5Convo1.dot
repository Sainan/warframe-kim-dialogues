	2495 [label="Não que eu esteja reclamando, veja bem!",shape=box,color=blue];
		2495 -> 2510;
		2495 -> 2511;
		2495 -> 2512;
	2496 [label="Sei que ele conquistou um lugar no seu coração e sou profundamente grata por isso. Talvez eu finalmente consiga parar de me preocupar com ele e toda essa briga logo se torne irrelevante.",shape=box,color=blue];
		2496 -> 2497;
	2497 [label="Mas é claro que isso me incomoda. Ele é meu irmão de alma! Meu Lyon é a coisa mais preciosa do mundo para mim, e vê-lo sofrer parte meu coração, como se a agonie dele fosse minha.",shape=box,color=blue];
		2497 -> 2513;
	2498 [label="Cuidado com o que diz, Peregrino.",shape=box,color=blue];
