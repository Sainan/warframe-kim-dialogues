		j971302504 -> j2483618 [label=false,color=brown];
		j971302504 -> j3274967416 [label=false,color=brown];
		j971302504 -> j17348121 [label=false,color=brown];
	j1062288591 [label="Poderia me contar mais sobre como era viver na Catedral? Antes da chegada do Entrati?",shape=box,color=red];
		j1062288591 -> j3728162639;
	j3274967416 [label="Onde você cresceu, Marie?",shape=box,color=red];
		j3274967416 -> j3853875636;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j2483618 [label="Como era sua vida na Catedral, antes da chegada do Entrati?",shape=box,color=red];
		j2483618 -> j3422793681;
	j3728162639 [label="Lá era bem solitário. Eu tinha o Lyon, mas você sabe como ele pode ser às vezes. Aliás, fico tão feliz que você e ele estejam conversando!",shape=box,color=blue];
		j3728162639 -> j695351218;
	j3853875636 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j3853875636 -> j3439649720;
	"Chat ends." [color=orange];
	j3422793681 [label="Ah, não sei o motivo disso lhe interessar, mas contarei mesmo assim, se estiver curioso. ",shape=box,color=blue];
		j3422793681 -> j2342927842;
	j695351218 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j695351218 -> j273543266;
	j3439649720 [label="Achei que meu idioma tivesse deixado isso meio óbvio, então me lembrei de que você não é da mesma época que eu!",shape=box,color=blue];
		j3439649720 -> j2454284151;
	j2342927842 [label="Passei esse tempo cumprindo minhas obrigações, como Irmã do Sol. Polindo os utensílios da comunhão, colocando os votivos para os paroquianos. ",shape=box,color=blue];
		j2342927842 -> j4255523644;
	j273543266 [label="Mas não é por causa disso que passo tanto tempo falando com os mortos.",shape=box,color=blue];
		j273543266 -> j2549972863;
	j2454284151 [label="Sou da Cité de la Lumière, a capital de um país chamado Gaule. No panorama do mundo, não fica muito longe de Holvânia no mapa.",shape=box,color=blue];
		j2454284151 -> j3211708511;
	j4255523644 [label="Cuidar da cripta e do cemitério, essa era minha tarefa favorita.",shape=box,color=blue];
		j4255523644 -> j127042831;
		j4255523644 -> j3540190060;
	j2549972863 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j2549972863 -> j2261537539;
	j3211708511 [label="Será que minha Catedral ainda existe em 1999? Que pensamento interessante!",shape=box,color=blue];
		j3211708511 -> j2524579933;
		j3211708511 -> j185999865;
	j127042831 [label="Por que você gostava disso?",shape=box,color=red];
		j127042831 -> j2403559496;
	j3540190060 [label="É… como assim?",shape=box,color=red];
		j3540190060 -> j349472446;
	j2261537539 [label="Tem uma beleza oculta nesses lugares, uma tranquilidade. Eles são tão… silenciosos e pacíficos.",shape=box,color=blue];
		j2261537539 -> j1943450087;
	j2524579933 [label="Você gosta de mudar de assunto, hein?",shape=box,color=red];
		j2524579933 -> j880728057;
	j185999865 [label="Posso até perguntar pra dois dos meus amigos, eles já foram pra um monte de lugar. Acho que até já falaram que passaram por lá",shape=box,color=red];
		j185999865 -> j3875767580;
	j2403559496 [label="Gostava muito de conversar com aqueles que repousavam. Eles ouviam minhas preocupações, sem me julgar.",shape=box,color=blue];
		j2403559496 -> j797961093;
	j349472446 [label="Era meu dever cuidar dos falecidos da Catedral. Eu varria a poeira do chão da cripta e capinava a grama do pátio.",shape=box,color=blue];
		j349472446 -> j2403559496;
	j1943450087 [label="Acho que gosto de contar a eles sobre meus problemas et les activités des autres, até porque eles não têm mais compromissos pendentes, oui?",shape=box,color=blue];
		j1943450087 -> j4280749560;
	j880728057 [label="+5 Chemistry",color=orange];
		j880728057 -> j393082072;
	j3875767580 [label="+5 Chemistry",color=orange];
		j3875767580 -> j810925407;
	j797961093 [label="Ah, eles nunca me responderam, mais cela me convenait tout à fait! Ainda bem que ninguém me respondeu.",shape=box,color=blue];
		j797961093 -> j714922970;
	j4280749560 [label="Tudo deve parecer pequeno para eles agora, e isso é… reconfortante para mim.",shape=box,color=blue];
		j4280749560 -> j2581208078;
		j4280749560 -> j1465140115;
		j4280749560 -> j1150994257;
	j393082072 [label="Você reparou nisso? O Lyon me provoca o tempo todo, dizendo que sou um grão de poeira sob o raio de sol, flutuando para onde a brisa me leva. Ah, fico tão feliz que você e ele estejam conversando!",shape=box,color=blue];
		j393082072 -> j2682949295;
	j810925407 [label="Ah, não é necessário incomodá-los, é só uma ideia boba. Não sei o quão triste eu ficaria se pensasse que ela se foi.",shape=box,color=blue];
		j810925407 -> j2682949295;
	j714922970 [label="+5 Chemistry",color=orange];
		j714922970 -> j1920477513;
	j2581208078 [label="Não sei, eu tenho… medo de morrer de verdade… nunca gostei de estar perto da morte",shape=box,color=red];
		j2581208078 -> j4284888873;
	j1465140115 [label="Olha… nunca tinha pensado desse jeito",shape=box,color=red];
		j1465140115 -> j3969523794;
	j1150994257 [label="Já encontrei o mesmo tipo de paz em cemitérios, te entendo perfeitamente",shape=box,color=red];
		j1150994257 -> j1681808000;
	j2682949295 [label="Estou simplesmente curiosa. Quero saber tout ce qui existe. Acho que é por isso que o Cardeal e eu estávamos destinados a nos encontrar.",shape=box,color=blue];
		j2682949295 -> j1565956807;
	j1920477513 [label="Imagina só? Crânios falantes, muito parecidos com o seu Necraloid! Hahaha!",shape=box,color=blue];
		j1920477513 -> j3883082565;
		j1920477513 -> j1936948506;
	j4284888873 [label="Eu sei, eu sei, lá vai a pequena e mórbida Marie! Mas cada um tem seu gosto, non?",shape=box,color=blue];
		j4284888873 -> j2923962445;
	j3969523794 [label="Você não está sozinho nessa. Não gostamos de passar muito tempo pensando no além. Pelo menos, não até estarmos perto dele.",shape=box,color=blue];
		j3969523794 -> j194186671;
	j1681808000 [label="Fico tão feliz que você me compreende!",shape=box,color=blue];
		j1681808000 -> j194186671;
	j1565956807 [label="Où en étais-je? Ah! Oui, minha história.",shape=box,color=blue];
		j1565956807 -> j738596805;
	j3883082565 [label="Isso não deve ter sido a tarefa mais agradável, ainda mais considerando sua cadeira de rodas",shape=box,color=red];
		j3883082565 -> j3000039977;
	j1936948506 [label="Você não tinha outros amigos pra conversar?",shape=box,color=red];
		j1936948506 -> j3602676479;
	j2923962445 [label="Alguém precisa cuidar deles, e ficarei mais do que feliz em fazer isso.",shape=box,color=blue];
		j2923962445 -> j194186671;
	j194186671 [label="O Lyon brinca que, como estou mais perto do chão, é por isso que penso tanto em covas.",shape=box,color=blue];
		j194186671 -> j1154230087;
	j738596805 [label="Isso pode até lhe surpreender, mas nasci em uma família rica. A classe burguesa, mais próxima dos Orokin do que dos outros.",shape=box,color=blue];
		j738596805 -> j4124652785;
	j3000039977 [label="Não, não era mesmo. Mas o Lyon me ajudava a subir e descer as escadas para a cripta quando eu precisava, e o resto eu aprendi a fazer sozinha.",shape=box,color=blue];
		j3000039977 -> j1648846262;
	j3602676479 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j3602676479 -> j2496489095;
	j1154230087 [label="Sempre pergunto se a cabeça dele é vazia, deve ser por isso que está tão cheia de fantasmas.",shape=box,color=blue];
		j1154230087 -> j1204153397;
	j4124652785 [label="Mas quando eu nasci… deformada, com mes pieds tordus et inutilisables… ah, isso foi demais para ma mère.",shape=box,color=blue];
		j4124652785 -> j2668502738;
	j1648846262 [label="É impressionante o que se pode fazer com teimosia e determinação, oui?",shape=box,color=blue];
		j1648846262 -> j1903225414;
	j2496489095 [label="Eu tinha o Lyon, claro, mas dá para ver como isso pode ser complicado em certos dias.",shape=box,color=blue];
		j2496489095 -> j2549972863;
	j1204153397 [label="Então, ele ameaçava me empurrar morro abaixo, e eu ameaçava encher a roupa dele de urtiga.",shape=box,color=blue];
		j1204153397 -> j1118776134;
	j2668502738 [label="Existiam aparências a serem mantidas e padrões a serem mantidos.",shape=box,color=blue];
		j2668502738 -> j3577365747;
	j1903225414 [label="Teimosia, determinação e muita força nos braços, hahaha!",shape=box,color=blue];
		j1903225414 -> j542080810;
	j1118776134 [label="La famille.",shape=box,color=blue];
		j1118776134 -> j3589053552;
		j1118776134 -> j2743963689;
		j1118776134 -> j2458109331;
		j1118776134 -> j3168214203;
	j3577365747 [label="Então, o que fazer com a pobre Marie? Fui levada para a Cité de la Lumière, onde certamente eu iria perambular pelas ruas…",shape=box,color=blue];
		j3577365747 -> j2291081619;
	j542080810 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j542080810 -> j2549972863;
	j3589053552 [label="Sinto muito pelo que o Entrati fez com você",shape=box,color=red];
		j3589053552 -> j746961267;
	j2743963689 [label="Fico feliz que vocês dois tinham um ao outro nessa",shape=box,color=red];
		j2743963689 -> j1353367852;
	j2458109331 [label="Vocês dois me fazem sorrir",shape=box,color=red];
		j2458109331 -> j875167396;
	j3168214203 [label="Então você e ele… nunca tiveram um relacionamento romântico?",shape=box,color=red];
		j3168214203 -> j413370823;
	j2291081619 [label="Abandonada para morrer.",shape=box,color=blue];
		j2291081619 -> j66685165;
		j2291081619 -> j792393313;
	j746961267 [label="+10 Chemistry",color=orange];
		j746961267 -> j1621882795;
	j1353367852 [label="+20 Chemistry",color=orange];
		j1353367852 -> j921553978;
	j875167396 [label="+20 Chemistry",color=orange];
		j875167396 -> j3583892609;
	j413370823 [label="Ah, Sol! Non! Ele é como um irmão para mim em todos os sentidos, exceto pelo sangue. Só de pensar nisso, já me sinto complètement dégoûtée!",shape=box,color=blue];
		j413370823 -> j646517794;
		j413370823 -> j2196838735;
	j66685165 [label="Sua família te largou pra morrer?",shape=box,color=red];
		j66685165 -> j1227660969;
	j792393313 [label="Quantos anos você tinha?",shape=box,color=red];
		j792393313 -> j3009524432;
	j1621882795 [label="O Entrati não fez nada, eu e o Lyon estamos tão fortes quanto sempre fomos. A situação só… mudou, non?",shape=box,color=blue];
		j1621882795 -> j1458114137;
	j921553978 [label="Eu não seria nada sem ele. Exceto, talvez, restos no pé de uma colina. Hahaha!",shape=box,color=blue];
		j921553978 -> j1488113279;
	j3583892609 [label="Ele me faz rir das formas mais estranhas, e você também, lobo. Fico cada vez mais feliz de estar aqui.",shape=box,color=blue];
		j3583892609 -> j116458499;
	j646517794 [label="Só tava curioso",shape=box,color=red];
		j646517794 -> j3385888755;
	j2196838735 [label="Admito que tô bem aliviado",shape=box,color=red];
		j2196838735 -> j1335227973;
	j1227660969 [label="Aos olhos deles, eles se esforçaram ao máximo para me curar por muitos anos. Tutores para me ensinar a andar, aparelhos ortodônticos, calçados…",shape=box,color=blue];
		j1227660969 -> j2288929086;
	j3009524432 [label="6, ou 7? Aos olhos deles, eles se esforçaram ao máximo para me curar por muitos anos. Tutores para me ensinar a andar, aparelhos ortodônticos, calçados…",shape=box,color=blue];
		j3009524432 -> j2288929086;
	j1458114137 [label="A Lua é sempre mutável. Até mesmo o Sol, por mais constante que seja, é influenciado pela sua órbita.",shape=box,color=blue];
		j1458114137 -> j2637586576;
	j1488113279 [label="Ele é realmente meu irmão de alma. Me sinto cada vez mais feliz por estar aqui.",shape=box,color=blue];
		j1488113279 -> j116458499;
	j116458499 [label="Só espero que ele descubra o mesmo em breve… mas o diabo o assombra com seus sussurros e mentiras.",shape=box,color=blue];
		j116458499 -> j3828997328;
	j3385888755 [label="+10 Chemistry",color=orange];
		j3385888755 -> j1930259134;
	j1335227973 [label="Check boolean DrifterMarie",color=orange];
		j1335227973 -> j3910671411 [label=true,color=green];
		j1335227973 -> j2999147912 [label=false,color=brown];
	j2288929086 [label="Eles estavam cansados desse fardo. Então, mal conseguindo ler e escrever meus números e letras… me vi na lama.",shape=box,color=blue];
		j2288929086 -> j3583963133;
		j2288929086 -> j2788022230;
	j2637586576 [label="Não devemos ser rígidos em nossos costumes, senão, eles nos consumirão, lobo. Além disso, sinto-me cada vez mais feliz por estar aqui.",shape=box,color=blue];
		j2637586576 -> j116458499;
	j3828997328 [label="Bah! É só falar que ele aparece. Preciso ir.",shape=box,color=blue];
		j3828997328 -> "Chat ends.";
	j1930259134 [label="Check boolean DrifterMarie",color=orange];
		j1930259134 -> j361022212 [label=true,color=green];
		j1930259134 -> j990970418 [label=false,color=brown];
	j3910671411 [label="Oui, você já deixou claras suas intenções. Devo avisá-lo de que não abandonarei ele. Conheço o Lyon há muito mais tempo que você.",shape=box,color=blue];
		j3910671411 -> j990970418;
	j2999147912 [label="Oui? E qual de nós você… caça?",shape=box,color=blue];
		j2999147912 -> j738525608;
		j2999147912 -> j3887532326;
	j3583963133 [label="Como você sobreviveu?",shape=box,color=red];
		j3583963133 -> j251854413;
	j2788022230 [label="Nossa, que horrível…",shape=box,color=red];
		j2788022230 -> j251854413;
	j361022212 [label="Sim… só \"curiosidade\". Você não me engana. Devo avisá-lo de que não abandonarei ele. Conheço o Lyon há muito mais tempo do que você.",shape=box,color=blue];
		j361022212 -> j990970418;
	j990970418 [label="+20 Chemistry",color=orange];
		j990970418 -> j2800426397;
	j738525608 [label="Você",shape=box,color=red];
		j738525608 -> j701427437;
	j3887532326 [label="O Lyon",shape=box,color=red];
		j3887532326 -> j711500391;
	j251854413 [label="Check boolean MarieSecretPower",color=orange];
		j251854413 -> j940337272 [label=true,color=green];
		j251854413 -> j413800482 [label=false,color=brown];
	j2800426397 [label="Eu não seria nada sem ele. Exceto, talvez, restos no pé de uma colina. Hahaha!",shape=box,color=blue];
		j2800426397 -> j2696691963;
	j701427437 [label="Boolean DrifterMarie is now true.",color=orange];
		j701427437 -> j1104079315;
	j711500391 [label="Vraiment?!",shape=box,color=blue];
		j711500391 -> j566170448;
	j940337272 [label="É como você disse, non? Todos os inconvenientes vêm com um poder secreto.",shape=box,color=blue];
		j940337272 -> j413800482;
	j413800482 [label="O que me tornou une indesirable pour ma mère, tornou-me bastante popular entre as outras crianças de rua.",shape=box,color=blue];
		j413800482 -> j1912223235;
	j2696691963 [label="Ainda assim, você me intriga, lobo. Estou me sentindo cada vez mais feliz por estar aqui.",shape=box,color=blue];
		j2696691963 -> j116458499;
	j1104079315 [label="+10 Chemistry",color=orange];
		j1104079315 -> j74653748;
	j566170448 [label="+10 Chemistry",color=orange];
		j566170448 -> j1586158961;
	j1912223235 [label="O que é mais patético do que uma criança sem pés, oui? Eu ganhava mais em um dia do que eles roubavam em uma semana.",shape=box,color=blue];
		j1912223235 -> j703276809;
	j74653748 [label="Ah! Par Sol. Devo admitir que você me pegou de surpresa. E agora estou aqui… sentada, corando, me escondendo do Monsieur Loid…",shape=box,color=blue];
		j74653748 -> j3748070286;
	j1586158961 [label="Você não imagina o quanto isso me deixa feliz, mas, por favor, pense bem no que vai dizer.",shape=box,color=blue];
		j1586158961 -> j1900970950;
	j703276809 [label="Foi isso que me levou a ser encontrada na rua por uma das Irmãs do Sol. Elas se ofereceram para me acolher.",shape=box,color=blue];
		j703276809 -> j830143933;
		j703276809 -> j2934221385;
	j3748070286 [label="Devo avisá-lo de que não abandonarei ele. Conheço o Lyon há muito mais tempo que você.",shape=box,color=blue];
		j3748070286 -> j2033918361;
	j1900970950 [label="Boolean DrifterLyon is now true.",color=orange];
		j1900970950 -> j245332888;
	j830143933 [label="E as outras crianças?",shape=box,color=red];
		j830143933 -> j3999926249;
	j2934221385 [label="E obviamente, você aceitou",shape=box,color=red];
		j2934221385 -> j1588192391;
	j2033918361 [label="+10 Chemistry",color=orange];
		j2033918361 -> j116458499;
	j245332888 [label="O Lyon é meu irmão. Eu o amo mais do que você pode imaginar, mas ele é um homem problemático. Pense bem antes de ir atrás dele, n'est-ce pas?",shape=box,color=blue];
		j245332888 -> j2509776635;
	j3999926249 [label="+5 Chemistry",color=orange];
		j3999926249 -> j3335976137;
	j1588192391 [label="Sim, o que mais eu poderia fazer? Era só uma questão de tempo até eu adoecer. Mesmo quando criança, eu sabia disso.",shape=box,color=blue];
		j1588192391 -> j1052941545;
		j1588192391 -> j487271361;
	j2509776635 [label="Acho que voltaremos a falar sobre isso em breve. Não me interprete mal, estou te incentivando! Só quero que você reflita bem sobre o assunto.",shape=box,color=blue];
		j2509776635 -> j2033918361;
	j3335976137 [label="Você tem um coração tão bondoso. É claro que elas não conseguiram levar todos… mas não me esqueci dos meus amigos.",shape=box,color=blue];
		j3335976137 -> j4054837625;
	j1052941545 [label="Como eram as Irmãs?",shape=box,color=red];
		j1052941545 -> j1471186817;
	j487271361 [label="Como você se adaptou à vida na Catedral?",shape=box,color=red];
		j487271361 -> j2380665371;
	j4054837625 [label="Eu voltava toda semana com meu salário e quaisquer restos que conseguia arrecadar da cozinha ou dos outros.",shape=box,color=blue];
		j4054837625 -> j1190537150;
	j1471186817 [label="Les Sœurs foram tão gentis comigo! Embora eu saiba por que você deve estar se perguntando o contrário, non?",shape=box,color=blue];
		j1471186817 -> j4231535400;
	j2380665371 [label="Ah, eu adorei! Embora eu saiba por que você deve estar se perguntando o contrário, non?",shape=box,color=blue];
		j2380665371 -> j4231535400;
	j1190537150 [label="Cuidei delas o melhor que pude, até o fim de suas vidas. Muitas faleceram de varíola ou tuberculose…",shape=box,color=blue];
		j1190537150 -> j2646973755;
	j4231535400 [label="Três refeições, uma cama quentinha e um teto sobre a cabeça. Eu não precisava me preocupar em ser espancada, roubada… ou pior.",shape=box,color=blue];
		j4231535400 -> j1236946597;
	j2646973755 [label="Muitas se mudaram, e algumas faleceram em brigas. A maioria encontrou trabalho honesto, cresceu e teve sua própria família.",shape=box,color=blue];
		j2646973755 -> j733795287;
	j1236946597 [label="Fui devidamente educada. Ensinaram-me os evangelhos do Sol e da Lua. Disseram-me para encontrar meu caminho na fé. Eu poderia ter ido embora, se quisesse.",shape=box,color=blue];
		j1236946597 -> j2009909184;
	j733795287 [label="Alguns até passavam na Catedral para me ver, isso aquecia meu coração.",shape=box,color=blue];
		j733795287 -> j2009909184;
	j2009909184 [label="Por muito tempo, senti culpa por ser resgatada das ruas quando outros não foram. Às vezes, ainda sinto.",shape=box,color=blue];
		j2009909184 -> j2220706357;
		j2009909184 -> j2813446121;
	j2220706357 [label="Quando me lembro de todos aqueles que morreram ao meu redor, e praticamente só eu sobrevivi… sinto o mesmo. Mas não podemos fazer isso, temos que continuar lutando pra melhorar as coisas, sempre que possível",shape=box,color=red];
		j2220706357 -> j2198481728;
