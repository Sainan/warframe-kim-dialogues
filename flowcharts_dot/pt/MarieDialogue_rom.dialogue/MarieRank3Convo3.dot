	1200 [label="E obviamente, você aceitou",shape=box,color=red];
		1200 -> 1202;
	3940 [label="+10 Chemistry",color=orange];
		3940 -> 1188;
	3945 [label="O Lyon é meu irmão. Eu o amo mais do que você pode imaginar, mas ele é um homem problemático. Pense bem antes de ir atrás dele, n'est-ce pas?",shape=box,color=blue];
		3945 -> 3946;
	1201 [label="+5 Chemistry",color=orange];
		1201 -> 1203;
	1202 [label="Sim, o que mais eu poderia fazer? Era só uma questão de tempo até eu adoecer. Mesmo quando criança, eu sabia disso.",shape=box,color=blue];
		1202 -> 1204;
		1202 -> 1205;
	3946 [label="Acho que voltaremos a falar sobre isso em breve. Não me interprete mal, estou te incentivando! Só quero que você reflita bem sobre o assunto.",shape=box,color=blue];
		3946 -> 3940;
	1203 [label="Você tem um coração tão bondoso. É claro que elas não conseguiram levar todos… mas não me esqueci dos meus amigos.",shape=box,color=blue];
		1203 -> 1206;
	1204 [label="Como eram as Irmãs?",shape=box,color=red];
		1204 -> 1207;
	1205 [label="Como você se adaptou à vida na Catedral?",shape=box,color=red];
		1205 -> 1208;
	1206 [label="Eu voltava toda semana com meu salário e quaisquer restos que conseguia arrecadar da cozinha ou dos outros.",shape=box,color=blue];
		1206 -> 1209;
	1207 [label="Les Sœurs foram tão gentis comigo! Embora eu saiba por que você deve estar se perguntando o contrário, non?",shape=box,color=blue];
		1207 -> 1210;
	1208 [label="Ah, eu adorei! Embora eu saiba por que você deve estar se perguntando o contrário, non?",shape=box,color=blue];
		1208 -> 1210;
	1209 [label="Cuidei delas o melhor que pude, até o fim de suas vidas. Muitas faleceram de varíola ou tuberculose…",shape=box,color=blue];
		1209 -> 1211;
	1210 [label="Três refeições, uma cama quentinha e um teto sobre a cabeça. Eu não precisava me preocupar em ser espancada, roubada… ou pior.",shape=box,color=blue];
		1210 -> 1212;
	1211 [label="Muitas se mudaram, e algumas faleceram em brigas. A maioria encontrou trabalho honesto, cresceu e teve sua própria família.",shape=box,color=blue];
		1211 -> 1213;
	1212 [label="Fui devidamente educada. Ensinaram-me os evangelhos do Sol e da Lua. Disseram-me para encontrar meu caminho na fé. Eu poderia ter ido embora, se quisesse.",shape=box,color=blue];
		1212 -> 1214;
	1213 [label="Alguns até passavam na Catedral para me ver, isso aquecia meu coração.",shape=box,color=blue];
		1213 -> 1214;
	1214 [label="Por muito tempo, senti culpa por ser resgatada das ruas quando outros não foram. Às vezes, ainda sinto.",shape=box,color=blue];
		1214 -> 1215;
		1214 -> 1216;
	1215 [label="Quando me lembro de todos aqueles que morreram ao meu redor, e praticamente só eu sobrevivi… sinto o mesmo. Mas não podemos fazer isso, temos que continuar lutando pra melhorar as coisas, sempre que possível",shape=box,color=red];
		1215 -> 1217;
	1216 [label="Você fez tudo que pôde pra ajudar quem precisava. Outros te ajudaram, e agora que pode, você tá tentando retribuir o favor",shape=box,color=red];
		1216 -> 1218;
	1217 [label="Será que isso sempre será assim? Uma luta eterna? Uma guerra contra a maré que busca nos afogar?",shape=box,color=blue];
		1217 -> 1219;
	1218 [label="Add 1 to Thermostat",color=orange];
		1218 -> 1220;
	1219 [label="Add -1 to Thermostat",color=orange];
		1219 -> 1221;
	1220 [label="+10 Chemistry",color=orange];
		1220 -> 1222;
	1221 [label="+10 Chemistry",color=orange];
		1221 -> 1223;
	1222 [label="Sim, é exatamente isso. Fui içada para a balsa, e agora, preciso fazer o mesmo pelos outros. ",shape=box,color=blue];
		1222 -> 1224;
	1223 [label="Mas sei o que você quer dizer. No fundo, você diz para eu não desistir. Que recebi esses dons para poder servir de escudo para os outros.",shape=box,color=blue];
		1223 -> 1224;
	1224 [label="Obrigada, mas preciso partir agora.",shape=box,color=blue];
		1224 -> 1225;
