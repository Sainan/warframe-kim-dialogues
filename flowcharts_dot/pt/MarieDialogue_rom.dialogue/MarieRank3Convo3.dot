	1196 [label="É como você disse, non? Todos os inconvenientes vêm com um poder secreto.",shape=box,color=blue];
		1196 -> 1195;
	1195 [label="O que me tornou une indesirable pour ma mère, tornou-me bastante popular entre as outras crianças de rua.",shape=box,color=blue];
