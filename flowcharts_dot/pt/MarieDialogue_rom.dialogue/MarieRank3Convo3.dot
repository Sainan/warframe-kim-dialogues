	1120 [label="Ah, não sei o motivo disso lhe interessar, mas contarei mesmo assim, se estiver curioso. ",shape=box,color=blue];
		1120 -> 1124;
	1123 [label="Update boolean MarieGraveyard2",color=orange];
		1123 -> 1126;
	1121 [label="Achei que meu idioma tivesse deixado isso meio óbvio, então me lembrei de que você não é da mesma época que eu!",shape=box,color=blue];
		1121 -> 1125;
	1124 [label="Passei esse tempo cumprindo minhas obrigações, como Irmã do Sol. Polindo os utensílios da comunhão, colocando os votivos para os paroquianos. ",shape=box,color=blue];
		1124 -> 1127;
	1126 [label="Mas não é por causa disso que passo tanto tempo falando com os mortos.",shape=box,color=blue];
		1126 -> 1129;
	1125 [label="Sou da Cité de la Lumière, a capital de um país chamado Gaule. No panorama do mundo, não fica muito longe de Holvânia no mapa.",shape=box,color=blue];
		1125 -> 1128;
	1127 [label="Cuidar da cripta e do cemitério, essa era minha tarefa favorita.",shape=box,color=blue];
		1127 -> 1130;
		1127 -> 1131;
	1129 [label="Update boolean MarieGraveyard2",color=orange];
		1129 -> 1134;
	1128 [label="Será que minha Catedral ainda existe em 1999? Que pensamento interessante!",shape=box,color=blue];
		1128 -> 1132;
		1128 -> 1133;
	1130 [label="Por que você gostava disso?",shape=box,color=red];
		1130 -> 1135;
	1131 [label="É… como assim?",shape=box,color=red];
		1131 -> 1136;
	1134 [label="Tem uma beleza oculta nesses lugares, uma tranquilidade. Eles são tão… silenciosos e pacíficos.",shape=box,color=blue];
		1134 -> 1139;
	1132 [label="Você gosta de mudar de assunto, hein?",shape=box,color=red];
		1132 -> 1137;
	1133 [label="Posso até perguntar pra dois dos meus amigos, eles já foram pra um monte de lugar. Acho que até já falaram que passaram por lá",shape=box,color=red];
		1133 -> 1138;
	1135 [label="Gostava muito de conversar com aqueles que repousavam. Eles ouviam minhas preocupações, sem me julgar.",shape=box,color=blue];
		1135 -> 1140;
	1136 [label="Era meu dever cuidar dos falecidos da Catedral. Eu varria a poeira do chão da cripta e capinava a grama do pátio.",shape=box,color=blue];
		1136 -> 1135;
	1139 [label="Acho que gosto de contar a eles sobre meus problemas et les activités des autres, até porque eles não têm mais compromissos pendentes, oui?",shape=box,color=blue];
		1139 -> 1143;
	1137 [label="+5 Chemistry",color=orange];
		1137 -> 1141;
	1138 [label="+5 Chemistry",color=orange];
		1138 -> 1142;
	1140 [label="Ah, eles nunca me responderam, mais cela me convenait tout à fait! Ainda bem que ninguém me respondeu.",shape=box,color=blue];
		1140 -> 1144;
	1143 [label="Tudo deve parecer pequeno para eles agora, e isso é… reconfortante para mim.",shape=box,color=blue];
		1143 -> 1146;
		1143 -> 1147;
		1143 -> 1148;
	1141 [label="Você reparou nisso? O Lyon me provoca o tempo todo, dizendo que sou um grão de poeira sob o raio de sol, flutuando para onde a brisa me leva. Ah, fico tão feliz que você e ele estejam conversando!",shape=box,color=blue];
		1141 -> 1145;
	1142 [label="Ah, não é necessário incomodá-los, é só uma ideia boba. Não sei o quão triste eu ficaria se pensasse que ela se foi.",shape=box,color=blue];
		1142 -> 1145;
	1144 [label="+5 Chemistry",color=orange];
		1144 -> 1149;
	1146 [label="Não sei, eu tenho… medo de morrer de verdade… nunca gostei de estar perto da morte",shape=box,color=red];
		1146 -> 1151;
	1147 [label="Olha… nunca tinha pensado desse jeito",shape=box,color=red];
		1147 -> 1152;
	1148 [label="Já encontrei o mesmo tipo de paz em cemitérios, te entendo perfeitamente",shape=box,color=red];
		1148 -> 1153;
	1145 [label="Estou simplesmente curiosa. Quero saber tout ce qui existe. Acho que é por isso que o Cardeal e eu estávamos destinados a nos encontrar.",shape=box,color=blue];
		1145 -> 1150;
	1149 [label="Imagina só? Crânios falantes, muito parecidos com o seu Necraloid! Hahaha!",shape=box,color=blue];
		1149 -> 1154;
		1149 -> 1155;
	1151 [label="Eu sei, eu sei, lá vai a pequena e mórbida Marie! Mas cada um tem seu gosto, non?",shape=box,color=blue];
		1151 -> 1157;
	1152 [label="Você não está sozinho nessa. Não gostamos de passar muito tempo pensando no além. Pelo menos, não até estarmos perto dele.",shape=box,color=blue];
		1152 -> 1158;
	1153 [label="Fico tão feliz que você me compreende!",shape=box,color=blue];
		1153 -> 1158;
	1150 [label="Où en étais-je? Ah! Oui, minha história.",shape=box,color=blue];
		1150 -> 1156;
	1154 [label="Isso não deve ter sido a tarefa mais agradável, ainda mais considerando sua cadeira de rodas",shape=box,color=red];
		1154 -> 1159;
	1155 [label="Você não tinha outros amigos pra conversar?",shape=box,color=red];
		1155 -> 1160;
	1157 [label="Alguém precisa cuidar deles, e ficarei mais do que feliz em fazer isso.",shape=box,color=blue];
		1157 -> 1158;
	1158 [label="O Lyon brinca que, como estou mais perto do chão, é por isso que penso tanto em covas.",shape=box,color=blue];
		1158 -> 1162;
	1156 [label="Isso pode até lhe surpreender, mas nasci em uma família rica. A classe burguesa, mais próxima dos Orokin do que dos outros.",shape=box,color=blue];
		1156 -> 1161;
	1159 [label="Não, não era mesmo. Mas o Lyon me ajudava a subir e descer as escadas para a cripta quando eu precisava, e o resto eu aprendi a fazer sozinha.",shape=box,color=blue];
		1159 -> 1163;
	1160 [label="Update boolean MarieGraveyard1",color=orange];
		1160 -> 1164;
	1162 [label="Sempre pergunto se a cabeça dele é vazia, deve ser por isso que está tão cheia de fantasmas.",shape=box,color=blue];
		1162 -> 1166;
	1161 [label="Mas quando eu nasci… deformada, com mes pieds tordus et inutilisables… ah, isso foi demais para ma mère.",shape=box,color=blue];
		1161 -> 1165;
	1163 [label="É impressionante o que se pode fazer com teimosia e determinação, oui?",shape=box,color=blue];
		1163 -> 1167;
	1164 [label="Eu tinha o Lyon, claro, mas dá para ver como isso pode ser complicado em certos dias.",shape=box,color=blue];
		1164 -> 1129;
	1166 [label="Então, ele ameaçava me empurrar morro abaixo, e eu ameaçava encher a roupa dele de urtiga.",shape=box,color=blue];
