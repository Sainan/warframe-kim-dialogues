	1116 [label="Como era sua vida na Catedral, antes da chegada do Entrati?",shape=box,color=red];
		1116 -> 1120;
	1119 [label="Lá era bem solitário. Eu tinha o Lyon, mas você sabe como ele pode ser às vezes. Aliás, fico tão feliz que você e ele estejam conversando!",shape=box,color=blue];
