		3937 -> 3938;
	3942 [label="+10 Chemistry",color=orange];
		3942 -> 3943;
	1197 [label="O que é mais patético do que uma criança sem pés, oui? Eu ganhava mais em um dia do que eles roubavam em uma semana.",shape=box,color=blue];
		1197 -> 1198;
	3938 [label="Ah! Par Sol. Devo admitir que você me pegou de surpresa. E agora estou aqui… sentada, corando, me escondendo do Monsieur Loid…",shape=box,color=blue];
		3938 -> 3939;
	3943 [label="Você não imagina o quanto isso me deixa feliz, mas, por favor, pense bem no que vai dizer.",shape=box,color=blue];
		3943 -> 3944;
	1198 [label="Foi isso que me levou a ser encontrada na rua por uma das Irmãs do Sol. Elas se ofereceram para me acolher.",shape=box,color=blue];
