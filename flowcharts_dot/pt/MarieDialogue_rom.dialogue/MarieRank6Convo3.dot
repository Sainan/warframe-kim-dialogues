	j1196347457 [label="Bonjour! Ah? E do que você tem medo que eu não goste?",shape=box,color=blue];
		j1196347457 -> j1708489218;
	j794015359 [label="Bonjour, mon cœur! Refleti bastante sobre isso, oui… e realmente reluto em admitir. Não tenho prazer nenhum em dizer isso.",shape=box,color=blue];
		j794015359 -> j1894199719;
	j2428231276 [label="Bonjour, bonjour, mon cœur! Refleti bastante sobre isso, oui… e realmente reluto em admitir. Não tenho prazer nenhum em dizer isso.",shape=box,color=blue];
		j2428231276 -> j1918220612;
	j605129423 [label="Bonjour! Refleti bastante sobre isso, oui… e realmente reluto em admitir. Não tenho prazer nenhum em dizer isso.",shape=box,color=blue];
		j605129423 -> j1918220612;
	j3211239543 [label="Mas sinto que precisamos de… algum tipo de bastião, non? Você tem alguma ideia?",shape=box,color=blue];
		j3211239543 -> j3770832934;
		j3211239543 -> j1708489218;
	j1708489218 [label="Acho que a gente precisa da ajuda do Roathe pra convencer o Loid a falar com a família Entrati. Sem isso, acho que não tem jogo. Ele tem que ter certeza que ele e a família estarão em segurança",shape=box,color=red];
		j1708489218 -> j2522195926;
	j1894199719 [label="Mas eu acho… eu acho… ah, Sol, me perdoe… que a ajuda do diabo talvez seja necessária. Não creio que o Monsieur Loid nos entenda de outra forma.",shape=box,color=blue];
		j1894199719 -> j527141169;
	j1918220612 [label="Acho que você pode ter razão. O diabo pode ser a peça que faltava. Ah, dói-me até digitar essas palavras! ",shape=box,color=blue];
		j1918220612 -> j636489540;
	j3770832934 [label="Realmente não tenho nenhuma boa ideia que não envolva recorrer a fontes terríveis… fontes que podem nos meter em grandes encrencas mais tarde: o Roathe",shape=box,color=red];
		j3770832934 -> j3125698213;
	j2522195926 [label="Eu… detesto admitir, mas acho que você pode ter razão… Sol, me perdoe.",shape=box,color=blue];
		j2522195926 -> j636489540;
	j527141169 [label="O diabo é poderoso e oferece certas promessas de força caso as coisas deem errado, não é?",shape=box,color=blue];
