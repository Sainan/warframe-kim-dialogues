	j3660114706 [label="Merci, merci, merci, mon cœur!",shape=box,color=blue];
		j3660114706 -> j867921717;
	j4046703089 [label="Merci, merci, merci!",shape=box,color=blue];
		j4046703089 -> j867921717;
	j3484641877 [label="Bem! Quando chegar a hora, estarei pronta e à espera! Até lá, merci, mon cœur.",shape=box,color=blue];
		j3484641877 -> j3569999725;
	j2242899521 [label="Bem! Quando chegar a hora, estarei pronta e à espera! Até lá, merci.",shape=box,color=blue];
		j2242899521 -> j3569999725;
	j971463725 [label="Fico feliz que você esteja feliz. E se o diabo tem onde gastar seus… esforços… melhor ainda, non?",shape=box,color=blue];
		j971463725 -> j3186042666;
	j2712884982 [label="Eu jamais insinuaria que, pelo fato de o diabo parecer lhe favorecer, talvez ele lhe dê ouvidos onde ignora todos os outros.",shape=box,color=blue];
		j2712884982 -> j2245020167;
	j794346497 [label="Todos ao redor dele tentaram transformar ele num monstro, acho que sou a primeira pessoa que não fez isso",shape=box,color=red];
		j794346497 -> j3333446204;
	j2014997446 [label="Tem muita coisa nele que ele simplesmente não sabe como demonstrar. Não é uma armadura literal, mas… ele só não confia nas pessoas",shape=box,color=red];
		j2014997446 -> j1659310779;
	j4260772673 [label="Ele… passou por algumas decepções amorosas reais ao longo de sua vida. Só cicatrizes, nada mais",shape=box,color=red];
		j4260772673 -> j1671773449;
	j1651493335 [label="Acho que consigo compreender o tanto que ele já viveu… já vi a mesma quantidade de mortes que ele viu",shape=box,color=red];
		j1651493335 -> j711151572;
	j3908042500 [label="Ele sempre tentou fazer o que era certo… talvez da maneira errada, claro, mas ele tava tentando salvar o Sistema de Origem dos Orokin",shape=box,color=red];
		j3908042500 -> j3620404130;
	j1532821001 [label="Gosto do humor irônico dele. Ele é inteligente… se você conseguir ignorar o ego dele",shape=box,color=red];
		j1532821001 -> j1238926630;
	j867921717 [label="Bem! Quando chegar a hora, estarei pronta e à espera! Até lá!",shape=box,color=blue];
		j867921717 -> j3569999725;
	j3186042666 [label="Ainda mais para todos nós, se você servir como uma espécie de anjo em seu ombro para acalmá-lo.",shape=box,color=blue];
		j3186042666 -> j3922866150;
		j3186042666 -> j1568837159;
	j2245020167 [label="E nunca em momentos privados. Non, jamais.",shape=box,color=blue];
		j2245020167 -> j1925372578;
		j2245020167 -> j537053427;
	j3333446204 [label="E suponho que estou no topo dessa lista de pessoas que não gostam disso, non? Suponho que eu deva… considerar os motivos dele para ser como é. Condenar não salva ninguém.",shape=box,color=blue];
		j3333446204 -> j2864436422;
	j1659310779 [label="Há sempre uma dor que escondemos daqueles que nos rodeiam. Algo que procuramos proteger, por medo de que outros a usem contra nós. Suponho que eu deva me esforçar para ser mais gentil com ele, se o que você diz for verdade.",shape=box,color=blue];
		j1659310779 -> j2864436422;
	j1671773449 [label="Não consigo imaginar a quantidade de amor e perda que alguém deve sofrer em todos esses anos. Parece tão surreal, mesmo considerando tudo o que vi.",shape=box,color=blue];
		j1671773449 -> j3056114301;
	j711151572 [label="Às vezes, quando falo com ele, esqueço quantos séculos ele viveu. Parece tão surreal, mesmo considerando tudo o que eu já vi.",shape=box,color=blue];
		j711151572 -> j1011520251;
	j3620404130 [label="Sempre há… nuances, oui? Sempre há razões para agir de uma forma ou de outra. Acho que devo me esforçar para ser mais gentil com ele, se o que você diz é verdade.",shape=box,color=blue];
		j3620404130 -> j2864436422;
	j1238926630 [label="Ninguém jamais negou ao diabo sua sagacidade.",shape=box,color=blue];
		j1238926630 -> j2539065609;
	j3922866150 [label="Quem disse que eu tô tentando acalmar ele?",shape=box,color=red];
		j3922866150 -> j3051492035;
	j1568837159 [label="Não posso prometer nada",shape=box,color=red];
		j1568837159 -> j1890757022;
	j1925372578 [label="Nunca soube que você tinha esse lado",shape=box,color=red];
		j1925372578 -> j1969080556;
	j537053427 [label="Você me surpreende… tô impressionado",shape=box,color=red];
		j537053427 -> j1969080556;
	j2864436422 [label="+10 Chemistry",color=orange];
		j2864436422 -> j3348181175;
	j3056114301 [label="Oui, que dano isso poderia causar a uma alma? Entendo por que você desejaria encontrar outro que compreendesse… e ele, você.",shape=box,color=blue];
		j3056114301 -> j2864436422;
	j1011520251 [label="Ter vivido tanto tempo, ter visto tanta morte… ter pago tanto por ela…",shape=box,color=blue];
		j1011520251 -> j3056114301;
	j2539065609 [label="+5 Chemistry",color=orange];
		j2539065609 -> j3348181175;
	j3051492035 [label="Add -1 to Thermostat counter",color=orange];
		j3051492035 -> j1521649677;
	j1890757022 [label="Add 1 to Thermostat counter",color=orange];
		j1890757022 -> j1083667007;
	j3348181175 [label="Fico feliz que o diabo tenha alguém com quem conversar, alguém que talvez tente moderá-lo. Um anjo em seu ombro.",shape=box,color=blue];
		j3348181175 -> j3922866150;
		j3348181175 -> j1568837159;
	j1521649677 [label="+10 Chemistry",color=orange];
		j1521649677 -> j3004841413;
	j1083667007 [label="+10 Chemistry",color=orange];
		j1083667007 -> j4196495550;
	j3004841413 [label="Talvez você tenha razão… o que é um anjo sem seu diabo? Ele nos lembra a todos daquilo que devemos nos esforçar para evitar.",shape=box,color=blue];
		j3004841413 -> j1835348069;
	j4196495550 [label="Sim, receio que haja nele uma maldade que não pode ser verdadeiramente curada. Ele gosta demais disso.",shape=box,color=blue];
		j4196495550 -> j1835348069;
	j1835348069 [label="Bem! Se, e quando, você convencer o diabo a nos ajudar em nossa missão, estarei pronta e à espera! Até lá!",shape=box,color=blue];
		j1835348069 -> j3569999725;
}