	j3125698213 [label="Tem tanta certeza? Se eu consigo deixar de lado minhas diferenças com o diabo, certamente você também consegue, não é?",shape=box,color=blue];
		j3125698213 -> j3405713408;
		j3125698213 -> j3803553475;
	j4117529618 [label="Não, tem que ter outro jeito. Me recuso a pedir ajuda pra ele",shape=box,color=red];
		j4117529618 -> j3125698213;
	j1296802231 [label="Você tem razão, não achei que você concordaria. Tava com medo de perguntar",shape=box,color=red];
		j1296802231 -> j636489540;
	j1255451905 [label="Ele nos ajudará nesse sentido?",shape=box,color=blue];
