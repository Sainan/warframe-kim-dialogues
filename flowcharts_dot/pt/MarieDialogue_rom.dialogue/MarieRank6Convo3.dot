		3709 -> 3718;
		3709 -> 3719;
	3703 [label="E suponho que estou no topo dessa lista de pessoas que não gostam disso, non? Suponho que eu deva… considerar os motivos dele para ser como é. Condenar não salva ninguém.",shape=box,color=blue];
		3703 -> 3713;
	3704 [label="Há sempre uma dor que escondemos daqueles que nos rodeiam. Algo que procuramos proteger, por medo de que outros a usem contra nós. Suponho que eu deva me esforçar para ser mais gentil com ele, se o que você diz for verdade.",shape=box,color=blue];
		3704 -> 3713;
	3706 [label="Não consigo imaginar a quantidade de amor e perda que alguém deve sofrer em todos esses anos. Parece tão surreal, mesmo considerando tudo o que vi.",shape=box,color=blue];
		3706 -> 3714;
	3707 [label="Às vezes, quando falo com ele, esqueço quantos séculos ele viveu. Parece tão surreal, mesmo considerando tudo o que eu já vi.",shape=box,color=blue];
		3707 -> 3715;
	3705 [label="Sempre há… nuances, oui? Sempre há razões para agir de uma forma ou de outra. Acho que devo me esforçar para ser mais gentil com ele, se o que você diz é verdade.",shape=box,color=blue];
