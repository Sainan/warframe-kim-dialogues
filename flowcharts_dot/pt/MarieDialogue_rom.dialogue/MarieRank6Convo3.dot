		j509552382 -> j921177047;
	j890356730 [label="Ele vai, eu convenci ele a ajudar a reuni-los. E você nem vai acreditar: acho que ele vai pra poder ajudar a proteger a família Entrati. Afinal, eles são tudo o que realmente sobrou dos Orokin",shape=box,color=red];
		j890356730 -> j2889619245;
	j3079995879 [label="Ele vai, eu convenci ele a ajudar a reuni-los. E você nem vai ficar surpresa: acho que ele vai ajudar só pra mostrar que é melhor que o Entrati",shape=box,color=red];
