	j96538632 [label="Ele vai, eu convenci ele a ajudar a reuni-los. E você nem vai acreditar: acho que ele vai pra poder ajudar a proteger a família Entrati. Afinal, eles são tudo o que realmente sobrou dos Orokin",shape=box,color=red];
