	j4046703089 [label="Merci, merci, merci!",shape=box,color=blue];
		j4046703089 -> j867921717;
	j3484641877 [label="Bem! Quando chegar a hora, estarei pronta e à espera! Até lá, merci, mon cœur.",shape=box,color=blue];
		j3484641877 -> j3569999725;
	j2242899521 [label="Bem! Quando chegar a hora, estarei pronta e à espera! Até lá, merci.",shape=box,color=blue];
		j2242899521 -> j3569999725;
	j4288766852 [label="Eu jamais insinuaria que, pelo fato de o diabo parecer lhe favorecer, talvez ele lhe dê ouvidos onde ignora todos os outros.",shape=box,color=blue];
		j4288766852 -> j1413324438;
	j2734035956 [label="Fico feliz que você esteja feliz. E se o diabo tem onde gastar seus… esforços… melhor ainda, non?",shape=box,color=blue];
		j2734035956 -> j2953479962;
	j202657376 [label="Todos ao redor dele tentaram transformar ele num monstro, acho que sou a primeira pessoa que não fez isso",shape=box,color=red];
		j202657376 -> j4130231961;
	j65560874 [label="Tem muita coisa nele que ele simplesmente não sabe como demonstrar. Não é uma armadura literal, mas… ele só não confia nas pessoas",shape=box,color=red];
		j65560874 -> j937754283;
	j285106818 [label="Ele… passou por algumas decepções amorosas reais ao longo de sua vida. Só cicatrizes, nada mais",shape=box,color=red];
		j285106818 -> j288362427;
	j918137379 [label="Acho que consigo compreender o tanto que ele já viveu… já vi a mesma quantidade de mortes que ele viu",shape=box,color=red];
		j918137379 -> j1517271412;
	j2420171109 [label="Ele sempre tentou fazer o que era certo… talvez da maneira errada, claro, mas ele tava tentando salvar o Sistema de Origem dos Orokin",shape=box,color=red];
		j2420171109 -> j1226702127;
	j2411973683 [label="Gosto do humor irônico dele. Ele é inteligente… se você conseguir ignorar o ego dele",shape=box,color=red];
		j2411973683 -> j2870139353;
	j867921717 [label="Bem! Quando chegar a hora, estarei pronta e à espera! Até lá!",shape=box,color=blue];
		j867921717 -> j3569999725;
	j1413324438 [label="E nunca em momentos privados. Non, jamais.",shape=box,color=blue];
		j1413324438 -> j1502145970;
		j1413324438 -> j3889131028;
	j2953479962 [label="Ainda mais para todos nós, se você servir como uma espécie de anjo em seu ombro para acalmá-lo.",shape=box,color=blue];
		j2953479962 -> j1568837159;
		j2953479962 -> j3922866150;
	j4130231961 [label="E suponho que estou no topo dessa lista de pessoas que não gostam disso, non? Suponho que eu deva… considerar os motivos dele para ser como é. Condenar não salva ninguém.",shape=box,color=blue];
		j4130231961 -> j848976164;
	j937754283 [label="Há sempre uma dor que escondemos daqueles que nos rodeiam. Algo que procuramos proteger, por medo de que outros a usem contra nós. Suponho que eu deva me esforçar para ser mais gentil com ele, se o que você diz for verdade.",shape=box,color=blue];
		j937754283 -> j848976164;
	j288362427 [label="Não consigo imaginar a quantidade de amor e perda que alguém deve sofrer em todos esses anos. Parece tão surreal, mesmo considerando tudo o que vi.",shape=box,color=blue];
		j288362427 -> j2492320493;
	j1517271412 [label="Às vezes, quando falo com ele, esqueço quantos séculos ele viveu. Parece tão surreal, mesmo considerando tudo o que eu já vi.",shape=box,color=blue];
		j1517271412 -> j673694788;
	j1226702127 [label="Sempre há… nuances, oui? Sempre há razões para agir de uma forma ou de outra. Acho que devo me esforçar para ser mais gentil com ele, se o que você diz é verdade.",shape=box,color=blue];
		j1226702127 -> j848976164;
	j2870139353 [label="Ninguém jamais negou ao diabo sua sagacidade.",shape=box,color=blue];
		j2870139353 -> j2615034854;
	j1502145970 [label="Você me surpreende… tô impressionado",shape=box,color=red];
		j1502145970 -> j3812010709;
	j3889131028 [label="Nunca soube que você tinha esse lado",shape=box,color=red];
		j3889131028 -> j3812010709;
	j1568837159 [label="Não posso prometer nada",shape=box,color=red];
		j1568837159 -> j1890757022;
	j3922866150 [label="Quem disse que eu tô tentando acalmar ele?",shape=box,color=red];
		j3922866150 -> j3051492035;
	j848976164 [label="+10 Chemistry",color=orange];
		j848976164 -> j3285545862;
	j2492320493 [label="Oui, que dano isso poderia causar a uma alma? Entendo por que você desejaria encontrar outro que compreendesse… e ele, você.",shape=box,color=blue];
		j2492320493 -> j848976164;
	j673694788 [label="Ter vivido tanto tempo, ter visto tanta morte… ter pago tanto por ela…",shape=box,color=blue];
