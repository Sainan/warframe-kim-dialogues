		3058 -> 3067;
	3057 [label="Há sempre uma dor que escondemos daqueles que nos rodeiam. Algo que procuramos proteger, por medo de que outros a usem contra nós. Suponho que eu deva me esforçar para ser mais gentil com ele, se o que você diz for verdade.",shape=box,color=blue];
		3057 -> 3067;
