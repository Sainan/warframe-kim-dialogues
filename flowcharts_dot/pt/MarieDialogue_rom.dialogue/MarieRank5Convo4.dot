		3060 -> 3069;
	3061 [label="Às vezes, quando falo com ele, esqueço quantos séculos ele viveu. Parece tão surreal, mesmo considerando tudo o que eu já vi.",shape=box,color=blue];
		3061 -> 3070;
	3056 [label="Sempre há… nuances, oui? Sempre há razões para agir de uma forma ou de outra. Acho que devo me esforçar para ser mais gentil com ele, se o que você diz é verdade.",shape=box,color=blue];
