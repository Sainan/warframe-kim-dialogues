		j3703567825 -> j4186581368;
	j3708293305 [label="Acho que a gente precisa da ajuda do Roathe pra convencer o Loid a falar com a família Entrati. Sem isso, acho que não tem jogo. Ele tem que ter certeza que ele e a família estarão em segurança",shape=box,color=red];
