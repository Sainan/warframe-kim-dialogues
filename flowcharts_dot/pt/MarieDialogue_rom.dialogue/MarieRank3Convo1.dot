		j3822658833 -> j3351975224;
		j3822658833 -> j546767882;
	j581517062 [label="Oui, bien sûr! Ninguém gosta de ouvir sermão, ainda mais de uma Irmã. Eu te entendo, merci. Não quero fazer papel de boba.",shape=box,color=blue];
		j581517062 -> j1180092563;
		j581517062 -> j1696252842;
		j581517062 -> j17348121;
	j1704224676 [label="Sim, isso é verdade. Sou uma arma agora, assim como o Murmure! Mas procuro seguir o caminho que o Cardeal me colocou, por mais abençoado que seja.",shape=box,color=blue];
		j1704224676 -> j3658548897;
		j1704224676 -> j1246505876;
	j2541061844 [label="Assim como o Cardeal. Ele era um Orokin, certo? E certamente eu não o condenaria. Sem ele, eu não seria quem sou hoje: abençoada.",shape=box,color=blue];
		j2541061844 -> j473873977;
		j2541061844 -> j3348847721;
	j1707968102 [label="Os Warframes… não foram feitos de uma forma muito agradável. Só espero que ela não esteja presa na Infestação",shape=box,color=red];
		j1707968102 -> j2877668790;
	j668169843 [label="Acho que, seja lá quem for a Wisp, ela adoraria te conhecer",shape=box,color=red];
		j668169843 -> j180989421;
	j3351975224 [label="Espero que a alma dela tenha conseguido seguir em frente e descansar, mas acho que parte das memórias dela ainda existem",shape=box,color=red];
		j3351975224 -> j1437798488;
	j546767882 [label="Imagina, relaxa. Acredito que parte das pessoas que viraram Warframes, de alguma forma, continuam presentes dentro dos componentes",shape=box,color=red];
		j546767882 -> j3939182190;
	j3658548897 [label="Tem muita coisa que eu poderia reclamar dele, mas admito que ele parece ter um bom instinto sobre a quem dar o soro de Protoframe. Mesmo sem eu saber o motivo por ele ter feito isso",shape=box,color=red];
		j3658548897 -> j1915133592;
	j1246505876 [label="Queria que você não confiasse tanto assim no Entrati. A gente não sabe o motivo por trás das escolhas dele e nem os seus objetivos com isso",shape=box,color=red];
		j1246505876 -> j1722407835;
	j473873977 [label="Temos que confiar no Entrati. Por enquanto, só dá pra seguir o rastro dele, é nossa única chance de impedir a Indiferença",shape=box,color=red];
		j473873977 -> j737842484;
	j3348847721 [label="Ele é um mentiroso, Marie. Ele abandona e machuca todo mundo que encontra. Ele já te abandonou faz tempo, não caiu a ficha ainda? ",shape=box,color=red];
