		j65882488 -> j2765197936;
	"Chat ends." [color=orange];
	j346279044 [label="Armas podem ser usadas tanto pra proteger quanto pra ferir. Não gosto de ter que precisar delas, mas… é um mal necessário",shape=box,color=red];
		j346279044 -> j3500908016;
	j164803111 [label="Ah, nem todos. Mas aquele em específico? Aí sim. Mas tem uns por aí que eu não condenaria de cara",shape=box,color=red];
		j164803111 -> j3925363774;
	j1506948899 [label="Une horrível toile d'os peinte avec du sang… viu só? Os Orokin são demônios.",shape=box,color=blue];
		j1506948899 -> j346279044;
		j1506948899 -> j164803111;
	j3931838450 [label="Como uma velha amiga, talvez. Sei do que ela gostava, sei como ela andava. Lembro-me do som do seu riso ao vento…",shape=box,color=blue];
		j3931838450 -> j3822658833;
