		j1339662754 -> j2320722363;
	j4080241546 [label="Acho que isso só se perdeu no tempo",shape=box,color=red];
		j4080241546 -> j2320722363;
	j2951330037 [label="Acho que um pouco dos dois. Pra seus criadores, essas pessoas eram… parte arma, parte arte",shape=box,color=red];
		j2951330037 -> j886242139;
	j60238748 [label="Vraiment? Poxa, sinto como se eu a conhecesse como se fosse minha irmã. E de sangue, não da Catedral.",shape=box,color=blue];
		j60238748 -> j1626444814;
	j3964463430 [label="Tudo bem, vamos falar sobre almas",shape=box,color=red];
