	j3862384984 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j3862384984 -> j4115676017;
	j3759805645 [label="Para aqueles de nós que seguem o caminho do Sol, devemos sempre ser a luz guia para aqueles que buscam trilhar tal caminho, certo? ",shape=box,color=blue];
		j3759805645 -> j2973168223;
	j2637517048 [label="Você é um seguidor da Lua, deveria saber que alguns devem andar sozinhos nas sombras, certo?",shape=box,color=blue];
		j2637517048 -> j2973168223;
	j4167083060 [label="Você é um seguidor dos Luminários, deveria saber que alguns caminham sozinhos pelas estradas desconhecidas, certo?",shape=box,color=blue];
		j4167083060 -> j2973168223;
	j4005176445 [label="Na minha fé, conhecemos aqueles que percorrem os caminhos da vida e se encontram na encruzilhada onde a Lua e o Sol se encontram. ",shape=box,color=blue];
		j4005176445 -> j2973168223;
	j810937281 [label="Dela, só sinto o calor do sorriso do Sol em mim. O Cardeal foi sábio, creio eu, em sua escolha. Sinto-me honrada em carregá-la em minhas veias.",shape=box,color=blue];
		j810937281 -> j3348847721;
		j810937281 -> j473873977;
		j810937281 -> j3658548897;
		j810937281 -> j1246505876;
	j1101244594 [label="Eu o perdoo por nos abandonar. Acho que ninguém mais é capaz disso…",shape=box,color=blue];
		j1101244594 -> j3758870937;
		j1101244594 -> j3059166419;
		j1101244594 -> j3884628799;
		j1101244594 -> j3156841206;
	j3884628799 [label="Ele… veio pra Duviri, há muito tempo atrás…",shape=box,color=red];
		j3884628799 -> j3802410429;
	j3646795659 [label="Bem, pra começar legal, ele atirou no meu peito e me largou pra morrer",shape=box,color=red];
		j3646795659 -> j3893919230;
	j3156841206 [label="Ele não deixa nada além de dor, morte e abandono por onde passa",shape=box,color=red];
		j3156841206 -> j1591510439;
	j3470783942 [label="Nunca confiei nele… só não queria te espantar",shape=box,color=red];
		j3470783942 -> j536548774;
	j2132545007 [label="Eu não queria ter mentido, só não sabia como falar sobre isso. Você claramente adora ele…",shape=box,color=red];
		j2132545007 -> j1052485006;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j4115676017 [label="Sim, devemos permanecer fortes! Braves contre les ténèbres, pour toujours et à jamais!",shape=box,color=blue];
		j4115676017 -> j3595615465;
	j2973168223 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j2973168223 -> j1247237403;
	j3758870937 [label="Sim, ele machucou e abandonou muita gente, você tem razão. E acho que ele sente que foi obrigado a fazer isso.",shape=box,color=red];
		j3758870937 -> j2793404947;
	j3059166419 [label="É difícil quando alguém que significa tanto para você… alguém que você ama e confia… vai embora. Principalmente se você não sabe o motivo, ou se eles não voltam.",shape=box,color=red];
		j3059166419 -> j865360510;
	j3802410429 [label="Santo Sol! O mundo que você criou, invocado do livro que a filha dele escreveu, certo? O Monsieur Loid falou sobre isso… o Cardeal estava lá? Por quê? ",shape=box,color=blue];
		j3802410429 -> j2069686749;
		j3802410429 -> j1772147202;
		j3802410429 -> j317028251;
	j3893919230 [label="Et pourtant, vous êtes toujours en vie! Você vive, não? E vive bem, certo? E de forma próspera, se acreditarmos nos contos do Monsieur Loid sobre suas aventuras no passado e no futuro.",shape=box,color=blue];
		j3893919230 -> j4231093281;
	j536548774 [label="Ah, je vois! Je suis une idiote, c'est ça?! Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même?! Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer!",shape=box,color=blue];
		j536548774 -> j2523403966;
	j1052485006 [label="Ah, oui… eu não facilitei as coisas para você falar com sinceridade comigo, n'est-ce pas?",shape=box,color=blue];
		j1052485006 -> j25750181;
	j3595615465 [label="Eu o perdoei por nos abandonar. Acho que ninguém mais é capaz disso…",shape=box,color=blue];
		j3595615465 -> j3758870937;
		j3595615465 -> j3059166419;
	j1247237403 [label="O Cardeal precisa achar o caminho de volta. Só podemos fazer o que estiver ao nosso alcance para ajudá-lo quando ele chamar, e fazer o que nos for ordenado por aqueles abençoados que nem ele.",shape=box,color=blue];
		j1247237403 -> j989297039;
	j2793404947 [label="+5 Chemistry",color=orange];
		j2793404947 -> j1938020766;
	j865360510 [label="+5 Chemistry",color=orange];
		j865360510 -> j513733810;
	j2069686749 [label="Acho que, no começo, uma parte dele tava lá, procurando um pouco da filha que ele abandonou. Mas, em vez disso, ele achou uma forma de combater a Indiferença: com as emoções das quais ele queria distância",shape=box,color=red];
		j2069686749 -> j1558635001;
	j1772147202 [label="As notas dele contam uma história bem egoísta sobre como ele foi estudar a personificação conceitual e, em vez disso, aprendeu a combater a Indiferença",shape=box,color=red];
		j1772147202 -> j4049992408;
	j317028251 [label="Se as notas dele forem verdade, ele tava lá pra ensinar Duviri (e eu, indiretamente) a se defender da Indiferença. O que não adiantou de nada",shape=box,color=red];
		j317028251 -> j1698971959;
