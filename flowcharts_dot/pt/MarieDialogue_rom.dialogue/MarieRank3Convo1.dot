	j3501028677 [label="Me falaram pouco da Infestação, sei pouco sobre ela… mas acredito em você. E se o que sinto for verdade (e rezo para ser), não creio que a Infestação esteja prendendo-a.",shape=box,color=blue];
		j3501028677 -> j810937281;
	j663838204 [label="É muito gentil da sua parte dizer isso. Se o que sinto é verdade (e rezo para ser), então, sim, acho que você tem razão. Não acho que ela esteja presa na Infestação.",shape=box,color=blue];
		j663838204 -> j810937281;
	j1871457398 [label="Se o que sinto é verdade (e rezo para ser), então, non. Não acho que ela esteja presa na Infestação.",shape=box,color=blue];
		j1871457398 -> j810937281;
	j1346653059 [label="Se o que sinto é verdade (e rezo para ser), então, sim, você tem razão. E essas pessoas querem nos ajudar. Não acho que ela esteja presa na Infestação.",shape=box,color=blue];
		j1346653059 -> j810937281;
	j1161421747 [label="Sim, fui abençoada pelo Cardeal… mas sei que sou praticamente a única que o ama, pois meu amor não é manchado pela tristeza, ódio ou ressentimento.",shape=box,color=blue];
		j1161421747 -> j1101244594;
	j3487882582 [label="Sei que você acha que ele é algum tipo de monstro, mas preciso perguntar: o que fez você desconfiar tanto dele assim?",shape=box,color=blue];
		j3487882582 -> j3884628799;
		j3487882582 -> j3646795659;
		j3487882582 -> j3156841206;
	j1742868508 [label="Achei que você acreditasse nele… por que essa mudança repentina de ideia? Você é tão inconstante assim? ",shape=box,color=blue];
		j1742868508 -> j3470783942;
		j1742868508 -> j2132545007;
	j3822210092 [label="Por que você desconfia tanto dele?",shape=box,color=blue];
		j3822210092 -> j3884628799;
		j3822210092 -> j3156841206;
		j3822210092 -> j3646795659;
	j3244838339 [label="Oui, e desde quando você muda de ideia tão rápido assim? Você mente. Por qual motivo, eu não sei. Et je ne veux pas le savoir.",shape=box,color=blue];
		j3244838339 -> j1508231473;
	j365547911 [label="+5 Chemistry",color=orange];
