	j1698971959 [label="Como assim?",shape=box,color=blue];
		j1698971959 -> j2790076666;
		j1698971959 -> j2808262795;
	j4061458680 [label="Na verdade, se os rumores das Cavias forem verdadeiros, vous avez vraiment trouvé beaucoup de joie, non?",shape=box,color=blue];
		j4061458680 -> j3897487953;
	j3897487953 [label="Non… o Cardeal fez muito pior com muitos outros, você só não gostou de ser \"incomodado\" por ele.",shape=box,color=blue];
		j3897487953 -> j1591510439;
	j1937279932 [label="Eu só queria que… todos ao redor do Entrati parassem de se culpar e culpar uns aos outros pelo que aconteceu",shape=box,color=red];
		j1937279932 -> j1354165151;
	j4069400340 [label="Não sei se eu diria que ele é \"abençoado\"",shape=box,color=red];
		j4069400340 -> j3038833195;
	j2446999277 [label="Seria muito mais fácil perdoar o Entrati pelos erros dele se eu pelo menos entendesse alguma coisa disso",shape=box,color=red];
		j2446999277 -> j661779899;
	j2394383886 [label="Farei o que precisar pra resolver esse problema. Só depois de tudo isso que eu vou julgar ele e o que ele fez",shape=box,color=red];
		j2394383886 -> j925463600;
	j865510071 [label="Il inflige la douleur dans le cœur des autres, car la douleur vaut mieux que rien du tout. Sofrimento é melhor que o vazio de emoções, non?",shape=box,color=blue];
		j865510071 -> j3912176644;
	j1930052639 [label="Quando ele não explica nada, tudo o que podemos fazer é inventar teorias",shape=box,color=red];
