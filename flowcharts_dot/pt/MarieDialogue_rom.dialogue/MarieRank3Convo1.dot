	j886242139 [label="+5 Chemistry",color=orange];
		j886242139 -> j1506948899;
	j1626444814 [label="Eu não a escuto, não da forma como o Lyon ouve os deuses e seus espíritos patronos. Eu não a vejo. Eu simplesmente sinto a presença dela ao meu lado.",shape=box,color=blue];
		j1626444814 -> j3931838450;
