		j2016918802 -> j60238748;
	j3280189332 [label="Isso se discutir sobre almas não lhe incomode. Caso contrário, podemos mudar para outras questões, não quero incomodar.",shape=box,color=blue];
		j3280189332 -> j3964463430;
