	j1938020766 [label="Oui, você tem razão. Acho que a culpa o assombra por tudo o que ele fez. Acho que ele se distancia dos outros de propósito.",shape=box,color=blue];
		j1938020766 -> j865510071;
	j513733810 [label="Oui, é uma tristeza terrível, uma tremenda dor. Saber que alguém… ainda vive e, aparentemente, escolheu não estar ao seu lado…",shape=box,color=blue];
		j513733810 -> j865510071;
	j1558635001 [label="Mon cœur se brise dans la tragédie… acho que não consigo suportar a tristeza disso… e mesmo assim, ela não vai perdoá-lo?",shape=box,color=blue];
		j1558635001 -> j1930052639;
		j1558635001 -> j562909199;
