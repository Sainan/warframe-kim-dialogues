digraph {
	3964 [label="MarieRank1Convo5 begins.",color=orange];
		3964 -> 3965;
	3965 [label="Bonjour, bonjour! Você deve ser o Peregrino, não é? O Monsieur Loid me falou muito sobre você. Estou muito feliz em \"encontrá-lo\" neste…",shape=box,color=blue];
		3965 -> 3966;
	3966 [label="Appareil cliquetant, por mais inteligente que seja!",shape=box,color=blue];
		3966 -> 3967;
	3967 [label="Sou a Irmã Marie Leroux, mas pode me chamar de Marie. Cheguei recentemente aqui com meu irmão de alma, o Padre Lyon Allard, e… bem, acho que o Monsieur Loid pode ter lhe alertado sobre o diabo, n'est-ce pas?",shape=box,color=blue];
		3967 -> 3968;
		3967 -> 3969;
		3967 -> 3970;
	3968 [label="É um prazer. E não me leve a mal, vocês são bem-vindos, mas… o que vocês tão fazendo aqui?",shape=box,color=red];
		3968 -> 3972;
	3969 [label="O diabo? Você quer dizer o Orokin?",shape=box,color=red];
		3969 -> 3974;
	3970 [label="[Encerrar Conversa]",shape=box,color=red];
		3970 -> 3971;
	3972 [label="+5 Chemistry",color=orange];
		3972 -> 3973;
	3974 [label="Sim, esse monstro irritante de pele azul que nos foi confiado pelo Cardeal. Creio que o conhece como… Albrecht Entrati? Ele é o motivo de estarmos aqui. Mas essa é uma longa história, j'en ai bien peur.",shape=box,color=blue];
		3974 -> 3975;
		3974 -> 3976;
	3971 [label="Chat ends.",color=orange];
	3973 [label="Merci ! The what and the how of our being here is a very long story, j'en ai bien peur. We were sent here by le Cardinal. I believe you know him as Albrecht Entrati ? He entrusted us with that blue-skinned monstre irritant.",shape=box,color=blue];
		3973 -> 3975;
		3973 -> 3976;
	3975 [label="Farei o que puder pra ajudar",shape=box,color=red];
		3975 -> 3980;
	3976 [label="\"Confiado\"?",shape=box,color=red];
		3976 -> 3977;
	3980 [label="+5 Chemistry",color=orange];
		3980 -> 3981;
	3977 [label="Devemos fazer o que pudermos para guiar sua alma, se possível. E se não for o caso? Então devemos garantir, no mínimo, que ele não cause mais nenhum mal.",shape=box,color=blue];
		3977 -> 3978;
		3977 -> 3979;
	3981 [label="Você é exatamente como o Monsieur Loid e as Cavias descreveram! Acho que temos tudo para sermos bons amigos.",shape=box,color=blue];
		3981 -> 3983;
	3978 [label="Tô disposto a te ajudar a tentar",shape=box,color=red];
		3978 -> 3980;
	3979 [label="Ele é um Orokin, a única forma de você conseguir derrotar ele é acertando uma bala entre os olhos dele",shape=box,color=red];
		3979 -> 3982;
	3983 [label="Ah! Preciso ir, me perdoe. Espero que possamos conversar em breve! À la revoyure!",shape=box,color=blue];
		3983 -> 3984;
	3982 [label="Você parece o Lyon. Não vou perder a esperança… ainda não.",shape=box,color=blue];
		3982 -> 3983;
	3984 [label="Chat ends.",color=orange];
}