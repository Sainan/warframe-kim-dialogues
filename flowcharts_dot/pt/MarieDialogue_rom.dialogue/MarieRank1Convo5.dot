digraph {
	"MarieRank1Convo5 begins." [color=orange];
		"MarieRank1Convo5 begins." -> j788683794;
	j788683794 [label="Bonjour, bonjour! Você deve ser o Peregrino, não é? O Monsieur Loid me falou muito sobre você. Estou muito feliz em \"encontrá-lo\" neste…",shape=box,color=blue];
		j788683794 -> j2549671245;
	j2549671245 [label="Appareil cliquetant, por mais inteligente que seja!",shape=box,color=blue];
		j2549671245 -> j3907124548;
	j3907124548 [label="Sou a Irmã Marie Leroux, mas pode me chamar de Marie. Cheguei recentemente aqui com meu irmão de alma, o Padre Lyon Allard, e… bem, acho que o Monsieur Loid pode ter lhe alertado sobre o diabo, n'est-ce pas?",shape=box,color=blue];
		j3907124548 -> j3600571677;
		j3907124548 -> j1931749830;
		j3907124548 -> j17348121;
	j3600571677 [label="É um prazer. E não me leve a mal, vocês são bem-vindos, mas… o que vocês tão fazendo aqui?",shape=box,color=red];
		j3600571677 -> j2106552108;
	j1931749830 [label="O diabo? Você quer dizer o Orokin?",shape=box,color=red];
		j1931749830 -> j1546538860;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j2106552108 [label="+5 Chemistry",color=orange];
		j2106552108 -> j2515653162;
	j1546538860 [label="Sim, esse monstro irritante de pele azul que nos foi confiado pelo Cardeal. Creio que o conhece como… Albrecht Entrati? Ele é o motivo de estarmos aqui. Mas essa é uma longa história, j'en ai bien peur.",shape=box,color=blue];
		j1546538860 -> j1386963006;
		j1546538860 -> j191988398;
	"Chat ends." [color=orange];
	j2515653162 [label="Merci ! The what and the how of our being here is a very long story, j'en ai bien peur. We were sent here by le Cardinal. I believe you know him as Albrecht Entrati ? He entrusted us with that blue-skinned monstre irritant.",shape=box,color=blue];
		j2515653162 -> j1386963006;
		j2515653162 -> j191988398;
	j1386963006 [label="Farei o que puder pra ajudar",shape=box,color=red];
		j1386963006 -> j3152636770;
	j191988398 [label="\"Confiado\"?",shape=box,color=red];
		j191988398 -> j4146520511;
	j3152636770 [label="+5 Chemistry",color=orange];
		j3152636770 -> j598844478;
	j4146520511 [label="Devemos fazer o que pudermos para guiar sua alma, se possível. E se não for o caso? Então devemos garantir, no mínimo, que ele não cause mais nenhum mal.",shape=box,color=blue];
		j4146520511 -> j1591720175;
		j4146520511 -> j3330829179;
	j598844478 [label="Você é exatamente como o Monsieur Loid e as Cavias descreveram! Acho que temos tudo para sermos bons amigos.",shape=box,color=blue];
		j598844478 -> j4213651863;
	j1591720175 [label="Tô disposto a te ajudar a tentar",shape=box,color=red];
		j1591720175 -> j3152636770;
	j3330829179 [label="Ele é um Orokin, a única forma de você conseguir derrotar ele é acertando uma bala entre os olhos dele",shape=box,color=red];
		j3330829179 -> j1738315844;
	j4213651863 [label="Ah! Preciso ir, me perdoe. Espero que possamos conversar em breve! À la revoyure!",shape=box,color=blue];
		j4213651863 -> "Chat ends.";
	j1738315844 [label="Você parece o Lyon. Não vou perder a esperança… ainda não.",shape=box,color=blue];
		j1738315844 -> j4213651863;
}