	j1631090094 [label="Evaluate expressions",color=orange];
		j1631090094 -> j691060581 [label="MarieOtak1",color=purple];
		j1631090094 -> j1395760854 [label="MarieFamily1",color=purple];
		j1631090094 -> j500368173 [label="false",color=purple];
	j691060581 [label="Estive refletindo no que você me disse sobre o Monsieur Otak.",shape=box,color=blue];
		j691060581 -> j2138115009;
	j1395760854 [label="Estive refletindo no que você me disse sobre a família do Cardeal.",shape=box,color=blue];
		j1395760854 -> j345420510;
	j500368173 [label="Posso trazer outra questão sobre o Monsieur \"Necraloid\" novamente, se me permitir?",shape=box,color=blue];
		j500368173 -> j861526532;
		j500368173 -> j17348121;
	j2138115009 [label="Estive refletindo… talvez isso seja parecido com uma história minha. Se tiver tempo livre, posso contá-la a você?",shape=box,color=blue];
		j2138115009 -> j2050828383;
		j2138115009 -> j17348121;
	j345420510 [label="Estive refletindo: você poderia me contar a história do Otak, o rosto infantil na parte de trás do crânio do Necraloid?",shape=box,color=blue];
		j345420510 -> j1676465519;
		j345420510 -> j149770966;
	j861526532 [label="Sem problemas, o que quer saber?",shape=box,color=red];
		j861526532 -> j3094159358;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j2050828383 [label="Claro, manda bala",shape=box,color=red];
		j2050828383 -> j3256854151;
	j1676465519 [label="Claro, sem problemas",shape=box,color=red];
		j1676465519 -> j954847428;
	j149770966 [label="Sem tempo, irmã [Encerrar Conversa]",shape=box,color=red];
		j149770966 -> "Chat ends.";
	j3094159358 [label="Fico curiosa para saber o motivo de ter outro rosto em suas costas, parecidos com rabiscos de criança.",shape=box,color=blue];
		j3094159358 -> j2448645292;
	"Chat ends." [color=orange];
	j3256854151 [label="Havia uma Irmã na Catedral que, certa vez, se perdeu nos corredores do seu passado: a Irmã Cecília.",shape=box,color=blue];
		j3256854151 -> j3442919067;
	j954847428 [label="Segundo relatos, ele era um gênio. A mente por trás do estudo e uso dos cristais de argônio e tudo mais",shape=box,color=red];
		j954847428 -> j3051050872;
	j2448645292 [label="Perguntei ao Monsieur Necraloid e ao Monsieur Loid, e nenhum deles quis falar sobre o assunto, somente me disseram um nome: Otak. E o pronunciaram com grande tristeza.",shape=box,color=blue];
		j2448645292 -> j3053348666;
	j3442919067 [label="Ela costumava ficar diante do grande relógio no corredor, proclamando serem 2 da tarde, mas não sabia que horas eram realmente.",shape=box,color=blue];
		j3442919067 -> j362172112;
	j3051050872 [label="Que são extraídos do Void e são a razão pela qual podemos criar muitos dos poderosos Warframes e armas que temos",shape=box,color=red];
		j3051050872 -> j2134685866;
	j3053348666 [label="E aqui estou eu, falando com você, na esperança de que possa me ajudar.",shape=box,color=blue];
		j3053348666 -> j1997459212;
		j3053348666 -> j3183634938;
	j362172112 [label="Encontrávamos todas as pinturas nos corredores viradas para o lado errado, e ela dizia que elas estavam sussurrando sobre tramas terríveis.",shape=box,color=blue];
		j362172112 -> j953217124;
	j2134685866 [label="Ele se especializou em cristalografia, e seus trabalhos foram todos arquivados aqui, nos laboratórios",shape=box,color=red];
		j2134685866 -> j1302943634;
	j1997459212 [label="Quer saber sobre o Otak? Ou o motivo de não conseguir falar com ele?",shape=box,color=red];
		j1997459212 -> j2843694934;
	j3183634938 [label="Otak… não é fácil de explicar…",shape=box,color=red];
		j3183634938 -> j2100059297;
	j953217124 [label="Descobrimos que ela estava simplesmente ouvindo conversas em outros cômodos… pensando serem as pinturas que estavam falando…",shape=box,color=blue];
		j953217124 -> j1780818177;
	j1302943634 [label="Por alguma razão, que não faço ideia de qual é, ele foi transformado em um Cephalon e recebeu seu próprio \"corpo\" de Necraloid",shape=box,color=red];
		j1302943634 -> j462662921;
	j2843694934 [label="Acho que, com o tempo, gostaria de saber ambas as coisas, mas vou deixar você decidir por onde começar. Não sei qual é mais importante, après tout.",shape=box,color=blue];
		j2843694934 -> j2100059297;
	j2100059297 [label="Check boolean LoidFamilyComplete",color=orange];
		j2100059297 -> j2723693572 [label=true,color=green];
		j2100059297 -> j2723693572 [label=false,color=brown];
		j2100059297 -> j3235831970 [label=false,color=brown];
	j1780818177 [label="Certa vez, ela confundiu todas as almofadas de uma sala de estar com crianças… as convidou para tomar chá…",shape=box,color=blue];
		j1780818177 -> j41892430;
	j462662921 [label="Nem todo Cephalon foi feito com o objetivo de punir alguém. Mas as coisas meio que… desandaram aqui em Deimos, e ele acabou ficando bem danificado",shape=box,color=red];
		j462662921 -> j2834547155;
	j2723693572 [label="O Otak era um Arquimediano, um cientista e acadêmico Orokin. O que aconteceu com ele não é exatamente uma história muito feliz…",shape=box,color=red];
		j2723693572 -> j1757190956;
	j3235831970 [label="Bem, de forma resumida, alguns dos familiares do Entrati tão lá em cima e não sabem que a gente tá aqui embaixo…",shape=box,color=red];
		j3235831970 -> j2029982486;
	j41892430 [label="Quando entrei na sala, ela olhou para mim e disse: \"Ah, Irmã Odette, aí está você! As crianças do orfanato estão aqui, quer se juntar a mim?\"",shape=box,color=blue];
		j41892430 -> j2864492494;
		j41892430 -> j772074384;
	j2834547155 [label="+5 Chemistry",color=orange];
		j2834547155 -> j2518321748;
	j1757190956 [label="Boolean MarieOtak1 is now true.",color=orange];
		j1757190956 -> j3552289260;
	j2029982486 [label="Boolean MarieFamily1 is now true.",color=orange];
		j2029982486 -> j1896027671;
	j2864492494 [label="O que você fez?",shape=box,color=red];
		j2864492494 -> j1022385717;
	j772074384 [label="Quem era a Irmã Odette?",shape=box,color=red];
		j772074384 -> j1200506462;
	j2518321748 [label="Pauvre petit…",shape=box,color=blue];
		j2518321748 -> j3759102526;
	j3552289260 [label="Par les Luminários… prossiga, por favor.",shape=box,color=blue];
		j3552289260 -> j954847428;
	j1896027671 [label="Par les Luminários… quer dizer que estamos todos aqui em segredo?! É por isso que não temos permissão para sair?! Pourquoi?!",shape=box,color=blue];
		j1896027671 -> j1967212862;
	j1022385717 [label="Coloquei minha cadeira em um lugar vazio na mesa e tomei chá com ela e as almofadas… o que mais eu poderia fazer?",shape=box,color=blue];
		j1022385717 -> j2181353839;
	j1200506462 [label="Lamento dizer que a Irmã Odette já faleceu há trinta anos.",shape=box,color=blue];
		j1200506462 -> j1777726348;
	j3759102526 [label="Então, ele foi transferido ao Necraloid principal, o único que sobrou. E parece que ele tá… bem? É difícil dizer",shape=box,color=red];
		j3759102526 -> j2656063323;
		j3759102526 -> j627458686;
		j3759102526 -> j2700154796;
	j1967212862 [label="Sua filha, Euleria (conhecida como Mãe) e sua família cuidaram de Deimos durante todo esse tempo",shape=box,color=red];
		j1967212862 -> j4030588793;
	j2181353839 [label="Ah, como rimos juntos… enquanto ela me contava histórias do seu passado. Histórias que a Irmã Cecília, até onde sei, nunca contou a ninguém antes.",shape=box,color=blue];
		j2181353839 -> j862665386;
	j1777726348 [label="Coloquei minha cadeira em um lugar vazio na mesa e tomei chá com ela e as almofadas.",shape=box,color=blue];
		j1777726348 -> j2181353839;
	j2656063323 [label="Sinceramente, só queria que a gente tivesse como \"consertar\" ele, trazer de volta o Otak original",shape=box,color=red];
		j2656063323 -> j3256854151;
	j627458686 [label="Ele me faz sorrir, é um ser engraçado… mas esconde algo trágico e triste",shape=box,color=red];
		j627458686 -> j3256854151;
	j2700154796 [label="Infelizmente, ele não tem conserto. E ele me irrita bastante",shape=box,color=red];
		j2700154796 -> j3256854151;
	j4030588793 [label="Cuidando deste lugar e do coração que bombeia energia do Void ao Sistema de Origem, mantendo todos aqui… como ferramentas utilizáveis, desde que o Entrati partiu",shape=box,color=red];
		j4030588793 -> j251199736;
	j862665386 [label="Seus olhos reluziam em alguns momentos, mas perdiam o brilho em outros, como os de uma boneca…",shape=box,color=blue];
		j862665386 -> j130002792;
		j862665386 -> j308669228;
		j862665386 -> j1466806528;
		j862665386 -> j1456470607;
	j251199736 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j251199736 -> j3521554013 [label=true,color=green];
		j251199736 -> j1048219147 [label=false,color=brown];
	j130002792 [label="Por que você se sentou com ela?",shape=box,color=red];
		j130002792 -> j3797947424;
	j308669228 [label="O que aconteceu com a Irmã Cecília?",shape=box,color=red];
		j308669228 -> j3509053660;
	j1466806528 [label="Espero que sua presença tenha significado algo pra ela",shape=box,color=red];
		j1466806528 -> j1793519378;
	j1456470607 [label="Muito gentil da sua parte se sentar com ela",shape=box,color=red];
		j1456470607 -> j338292381;
	j3521554013 [label="Ela já aceitou a ausência dele, e a família já fez as pazes entre eles, mas foi bem difícil chegar nesse ponto",shape=box,color=red];
		j3521554013 -> j2486507631;
	j1048219147 [label="Ela ainda não aceitou a ausência dele, e a família toda continua brigando entre si",shape=box,color=red];
		j1048219147 -> j2115566504;
	j3797947424 [label="+15 Chemistry",color=orange];
		j3797947424 -> j2679779795;
	j3509053660 [label="O que acontece com todos na condição dela… continuou a desaparecer, como uma pintura ao sol, até que… nada restou. ",shape=box,color=blue];
		j3509053660 -> j4197481343;
	j1793519378 [label="+10 Chemistry",color=orange];
		j1793519378 -> j2528774980;
	j338292381 [label="+5 Chemistry",color=orange];
		j338292381 -> j837694059;
	j2486507631 [label="Sabendo que ele ainda tá solto por aí, e que ele nunca nem falou nada pra ela… nem mesmo uma carta…",shape=box,color=red];
		j2486507631 -> j1717442039;
	j2115566504 [label="Sabendo que ele ainda tá solto por aí, e que ele nunca nem falou nada pra ela… nem mesmo uma carta…",shape=box,color=red];
		j2115566504 -> j3008577905;
	j2679779795 [label="Uma sábia pergunta. Acho que muitos motivos me inspiraram… gostaria de acreditar que foi a gentileza que me levou à mesa dela.",shape=box,color=blue];
		j2679779795 -> j324366233;
	j4197481343 [label="Então, ela nos deixou, e fizemos uma vigília à luz de velas em sua homenagem. Espero que, no final, ela consiga se lembrar daqueles que foram realmente gentis com ela. ",shape=box,color=blue];
		j4197481343 -> j2234420648;
	j2528774980 [label="Gostaria de acreditar nisso, que, lá no fundo, ela soube disso.",shape=box,color=blue];
		j2528774980 -> j2234420648;
	j837694059 [label="Será que foi gentileza? Ou foi a culpa que me inspirou a fazer isso? Ah, você também está sendo gentil ao me dizer isso. ",shape=box,color=blue];
		j837694059 -> j2234420648;
	j1717442039 [label="Nem consigo imaginar o quão doloroso seria pra ela saber da verdade… pra todos eles, na real",shape=box,color=red];
		j1717442039 -> j3393297573;
	j3008577905 [label="Espalhar essa verdade destruiria qualquer chance de reconciliação que aquela família possa ter",shape=box,color=red];
		j3008577905 -> j120008111;
	j324366233 [label="Mas acho que, no fundo, era só culpa. Se eu não fizesse aquilo, estaria negligenciando-a. Como se negligencia uma criança.",shape=box,color=blue];
		j324366233 -> j2234420648;
	j2234420648 [label="Adoraria acreditar que seu Otak sabe quem é gentil e paciente com ele. Mas, pensando bem, ele não está realmente lá, está?",shape=box,color=blue];
		j2234420648 -> j1183399769;
	j3393297573 [label="Embora eu possa ver a lógica por trás da decisão de protegê-los da dor que le Cardeal causou com sua partida necessária…",shape=box,color=blue];
		j3393297573 -> j1855181881;
	j120008111 [label="+10 Chemistry",color=orange];
		j120008111 -> j2436963042;
	j1183399769 [label="Ele é só uma peça de tecnologia muito sofisticada, feita para se assemelhar a um homem, não é? Um fonógrafo, só que bem mais complexo. Assim como o Necraloid, ele não tem alma.",shape=box,color=blue];
		j1183399769 -> j877487890;
		j1183399769 -> j3141349807;
		j1183399769 -> j1527212322;
		j1183399769 -> j1950973570;
		j1183399769 -> j522719978;
	j1855181881 [label="Acho isso desnecessariamente cruel, não acha? Eles podem até achar que ele morreu… ou pior! E nós, morando aqui, comme des rats d'égout?",shape=box,color=blue];
		j1855181881 -> j1721343941;
		j1855181881 -> j886307880;
	j2436963042 [label="Oui… entendo sua lógica. Se puder, seria melhor focar em resolver os problemas familiares primeiro, né? Me parece a única esperança que qualquer um de nós tem para sair daqui",shape=box,color=blue];
		j2436963042 -> j2118296356;
	j877487890 [label="O Necraloid pode até não ter alma, mas é único. Outros Cephalons, como o Otak, já tiveram alma… mas elas foram destruídas durante sua criação",shape=box,color=red];
		j877487890 -> j488306307;
	j3141349807 [label="Você tem razão, mas… o que quer que eu faça?",shape=box,color=red];
		j3141349807 -> j861014815;
	j1527212322 [label="Você tem razão, eles não têm alma… mas isso não é motivo para tratar eles como objetos",shape=box,color=red];
		j1527212322 -> j2619550544;
	j1950973570 [label="Não sei se você tá certa ou não… mas eles ainda conseguem pensar e sentir, e não podemos simplesmente tratar eles como objetos",shape=box,color=red];
		j1950973570 -> j1023572925;
	j522719978 [label="O Necraloid tem alma, todos os Cephalons têm",shape=box,color=red];
		j522719978 -> j630219187;
	j1721343941 [label="Não é uma decisão que eu possa tomar",shape=box,color=red];
		j1721343941 -> j771827570;
	j886307880 [label="Curiosamente, tenho uma amiga que adora ratos. Acho eles bem adoráveis",shape=box,color=red];
		j886307880 -> j347477983;
	j2118296356 [label="Para não passarmos o resto de nossas vidas aqui, comme des rats d'égout",shape=box,color=blue];
		j2118296356 -> j3616600410;
		j2118296356 -> j3658771159;
	j488306307 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j488306307 -> j3737087293;
	j861014815 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j861014815 -> j1721079825;
	j2619550544 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j2619550544 -> j1547283574;
	j1023572925 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
		j1023572925 -> j3046740774;
	j630219187 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j630219187 -> j4066447925;
	j771827570 [label="Entendo… a escolha só cabe ao Monsieur Loid e ao resto de saberem a verdade.",shape=box,color=blue];
		j771827570 -> j4220700723;
	j347477983 [label="+15 Chemistry",color=orange];
		j347477983 -> j3546288869;
	j3616600410 [label="Você tem razão, fui negligente nesse ponto. Vou trabalhar nisso",shape=box,color=red];
		j3616600410 -> j749037084;
	j3658771159 [label="Curiosamente, tenho uma amiga que adora ratos. Acho eles bem adoráveis",shape=box,color=red];
		j3658771159 -> j2965282591;
	j3737087293 [label="+5 Chemistry",color=orange];
		j3737087293 -> j4243126849;
	j1721079825 [label="Ah, não pense que quero que você seja cruel! Não! Valorize-os, pois são preciosos! E não por sentir culpa pelo que eles são!",shape=box,color=blue];
		j1721079825 -> j2818836815;
	j1547283574 [label="+5 Chemistry",color=orange];
		j1547283574 -> j1721079825;
	j3046740774 [label="+5 Chemistry",color=orange];
		j3046740774 -> j3210888043;
	j4066447925 [label="+5 Chemistry",color=orange];
		j4066447925 -> j845457790;
	j4220700723 [label="Eu diria que é um sentimento de culpa, e não de nobreza, que nos mantém aqui embaixo.",shape=box,color=blue];
		j4220700723 -> j3455210869;
	j3546288869 [label="Adoraria conhecê-los algum dia, mas não é bem isso que estou querendo dizer, bobinho.",shape=box,color=blue];
		j3546288869 -> j4220700723;
	j749037084 [label="+5 Chemistry",color=orange];
		j749037084 -> j2706220737;
	j2965282591 [label="+5 Chemistry",color=orange];
		j2965282591 -> j3546288869;
	j4243126849 [label="Mais uma prova de que o diabo e seus semelhantes mereceram ser condenados. Mas talvez você tenha razão sobre o Otak e seus semelhantes… ou talvez acreditar nisso lhe traga paz.",shape=box,color=blue];
		j4243126849 -> j2877284388;
	j2818836815 [label="Meu coração se parte pelos corpos destroçados que os demônios Orokin deixaram para trás. Eles não eram deuses… eram devoradores de tudo em seu caminho. Se quiser provas, basta olhar para nosso companheiro de viagem.",shape=box,color=blue];
		j2818836815 -> j3849335947;
	j3210888043 [label="Talvez você tenha razão, mas não creio que os demônios Orokin compreendessem mais sobre o funcionamento das almas do que nós… eles não eram deuses.",shape=box,color=blue];
		j3210888043 -> j721469502;
	j845457790 [label="Talvez você tenha razão… ou talvez acreditar nisso lhe traga paz.",shape=box,color=blue];
		j845457790 -> j3849335947;
	j3455210869 [label="É o fato de que escondemos um grande e terrível pecado.",shape=box,color=blue];
		j3455210869 -> j1657788441;
	j2706220737 [label="Obrigada. Não sei se você conseguirá, mas, às vezes, só podemos tentar…",shape=box,color=blue];
		j2706220737 -> j4220700723;
	j2877284388 [label="De qualquer forma, escolho acreditar que o Otak que faleceu há muito tempo sorriria para você agora, caso você seja gentil com o que quer que viva na memória dele.",shape=box,color=blue];
		j2877284388 -> j1531393501;
	j3849335947 [label="É difícil para mim dizer que o Necraloid tem uma alma quando… o Loid está bem ao lado dele, oui?",shape=box,color=blue];
		j3849335947 -> j2877284388;
	j721469502 [label="Tecnologia, talvez… ciência, sim… mas e a alma? Eles nem conseguiram compreender seus próprios corações! Se quiser provas, basta observar o diabo que viaja conosco.",shape=box,color=blue];
		j721469502 -> j3849335947;
	j1657788441 [label="E é exatamente esse pecado que deve ser perdoado.",shape=box,color=blue];
		j1657788441 -> j2394518494;
	j1531393501 [label="Check boolean LoidFamilyComplete",color=orange];
		j1531393501 -> j4170961970 [label=true,color=green];
		j1531393501 -> j171230396 [label=false,color=brown];
	j2394518494 [label="Obrigada, você me deu muito sobre o que refletir… à la revoyure.",shape=box,color=blue];
		j2394518494 -> "Chat ends.";
	j4170961970 [label="Preciso ir. Mas, merci. Tenho muito para refletir.",shape=box,color=blue];
		j4170961970 -> "Chat ends.";
	j171230396 [label="Só espero que, um dia desses, eu possa conhecer a cópia estranha que vive no Monsieur Necraloid quando ele sobe lá para cima.",shape=box,color=blue];
		j171230396 -> j802058499;
		j171230396 -> j616440569;
	j802058499 [label="Não sei se é uma boa ideia se intrometer na vida dos outros desse jeito",shape=box,color=red];
		j802058499 -> j3351551251;
	j616440569 [label="Espero que, um dia, a gente possa contar a verdade pra família Entrati… e o mais cedo possível",shape=box,color=red];
		j616440569 -> j3351551251;
	j3351551251 [label="Check boolean MarieFamily1",color=orange];
		j3351551251 -> j2346587589 [label=true,color=green];
		j3351551251 -> j2874988859 [label=false,color=brown];
	j2346587589 [label="Veremos. Quero saber mais detalhes com você sobre o porquê de termos que permanecer aqui.",shape=box,color=blue];
		j2346587589 -> j3239781902;
	j2874988859 [label="Tem uma história que acho que você não me contou. Mas acho que já tivemos história suficiente por hoje, oui?",shape=box,color=blue];
		j2874988859 -> j3239781902;
	j3239781902 [label="Falaremos mais sobre a família Entrati em breve.",shape=box,color=blue];
