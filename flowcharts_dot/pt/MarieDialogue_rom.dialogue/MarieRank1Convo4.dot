		j2183556486 -> j2655950602;
		j2183556486 -> j1041233206;
	j1041233206 [label="Ele não fez nada que justifique eu ignorar o pedido de ajuda dele… pelo menos por enquanto",shape=box,color=red];
		j1041233206 -> j3362352669;
	j2655950602 [label="Atualmente, não acho que tenho a liberdade de abrir mão de possíveis aliados",shape=box,color=red];
		j2655950602 -> j639632973;
	j3105975737 [label="É que tem algo nele que me atrai… [Confessar interesse no Roathe]",shape=box,color=red];
		j3105975737 -> j2025090675;
	j2011909216 [label="Parece que ele tá fazendo o que precisa pra sobreviver, não posso culpar ele por isso",shape=box,color=red];
		j2011909216 -> j2028837304;
	j3362352669 [label="Add 1 to Thermostat counter",color=orange];
		j3362352669 -> j234761000;
