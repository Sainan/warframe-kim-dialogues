	"MarieRank1Convo4 begins." [color=orange];
		"MarieRank1Convo4 begins." -> j1972449534;
	j1972449534 [label="Posso fazer uma pergunta, que espero que não seja indelicada? Nossa amizade está ficando forte tão rápido, que não sei se dá para perguntar isso, especialmente para você (que pelo que sei) já viveu tanto…",shape=box,color=blue];
		j1972449534 -> j3619135002;
		j1972449534 -> j3363809571;
		j1972449534 -> j17348121;
	j3619135002 [label="Sinceramente, não tenho memória de boa parte dos anos que já vivi",shape=box,color=red];
		j3619135002 -> j1272843914;
	j3363809571 [label="Sem problemas, manda bala",shape=box,color=red];
		j3363809571 -> j2947588656;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j1272843914 [label="Santo Sol! Você parte meu coração com suas palavras. Tanto você quanto o diabo tiveram suas mentes desprovidas de conhecimento, como um livro com páginas arrancadas, certo?",shape=box,color=blue];
		j1272843914 -> j106538304;
		j1272843914 -> j1490302179;
	j2947588656 [label="+5 Chemistry",color=orange];
		j2947588656 -> j523704316;
	"Chat ends." [color=orange];
	j106538304 [label="Não sinto falta das partes do meu passado que foram apagadas",shape=box,color=red];
		j106538304 -> j4123148754;
	j1490302179 [label="É… são por razões bem diferentes, mas sim",shape=box,color=red];
		j1490302179 -> j1595660165;
	j523704316 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j523704316 -> j1257674660 [label="x > 0",color=purple];
		j523704316 -> j1855399341 [label="x <= 0",color=purple];
		j523704316 -> j1855399341 [label="false",color=purple];
	j4123148754 [label="Sério? Parece que você é a única pessoa que não sente falta disso. Entre a criança e o diabo, parece que todos querem encontrar as partes dos seus passados perdidos.",shape=box,color=blue];
		j4123148754 -> j4070433328;
		j4123148754 -> j2465108071;
	j1595660165 [label="Seria demais da minha parte perguntar por que você se sente tão desolado? As razões da criança e do diabo são conhecidas para mim, mas as suas não…",shape=box,color=blue];
		j1595660165 -> j4070433328;
		j1595660165 -> j2465108071;
	j1257674660 [label="Por que você concordou em auxiliar o diabo com seus planos? Ouvi dizer que você foi responsável pelo massacre dos semelhantes a ele.",shape=box,color=blue];
		j1257674660 -> j716219058;
		j1257674660 -> j495136000;
		j1257674660 -> j2676499346;
	j1855399341 [label="Você pretende auxiliar o diabo com seus planos? Ouvi dizer que você foi responsável pelo massacre dos semelhantes a ele.",shape=box,color=blue];
		j1855399341 -> j716219058;
		j1855399341 -> j495136000;
		j1855399341 -> j2676499346;
	j4070433328 [label="Passei um número indeterminado de anos morrendo nas mãos de… mim mesmo. Não me importo de não lembrar de todas as vezes que bati as botas",shape=box,color=red];
		j4070433328 -> j1890676546;
	j2465108071 [label="Resumindo, passei vários anos sofrendo… Então, esquecer isso, acho que é um tipo de mecanismo de autodefesa…",shape=box,color=red];
		j2465108071 -> j2152836758;
	j716219058 [label="Isso aí foi obra da minha outra metade. Acredito em colocar a culpa nos indivíduos, não nas sociedades",shape=box,color=red];
		j716219058 -> j2374477877;
	j495136000 [label="Não fui eu, foi a criança. Mas eu odeio os Orokin no mesmo nível",shape=box,color=red];
		j495136000 -> j1233876231;
	j2676499346 [label="Eu não tava lá, na Noite dos Tambores de Naga, quando os Tennos se rebelaram contra os Orokin. Quem fez isso foi a criança…",shape=box,color=red];
		j2676499346 -> j349120402;
	j1890676546 [label="Não te culpo… se eu fosse vítima desse tipo de abuso, adoraria esquecer de tudo. No mínimo, não sairia procurando lembrar.",shape=box,color=blue];
		j1890676546 -> j1419086109;
	j2152836758 [label="Sem dúvidas! Se eu fosse submetida a esse tipo de abuso, imagino que minha alma faria algo semelhante. Esconderia tudo o que não tem conserto e só faz mal.",shape=box,color=blue];
		j2152836758 -> j1419086109;
	j2374477877 [label="Add 1 to Thermostat counter",color=orange];
		j2374477877 -> j1033719895;
	j1233876231 [label="Add -1 to Thermostat counter",color=orange];
		j1233876231 -> j3734505492;
	j349120402 [label="A Noite dos Tambores de Naga… ah, consigo ver na minha mente. Quelles couleurs magnifiques!",shape=box,color=blue];
		j349120402 -> j2241217761;
	j1419086109 [label="+5 Chemistry",color=orange];
		j1419086109 -> j1903763391;
	j1033719895 [label="Oui, je comprends. Somos tão rápidos em incendiar o prédio quando a culpa é muitas vezes dos ratos nas paredes.",shape=box,color=blue];
		j1033719895 -> j2502440499;
	j3734505492 [label="Je meurs d'envie de savoir pourquoi! Mas isso é conversa para outro dia, senão ficaremos aqui para sempre… e o Monsieur Loid ficará bravo comigo.",shape=box,color=blue];
		j3734505492 -> j4192617946;
	j2241217761 [label="Preciso falar com o Monsieur Loid para mais detalhes, mas…",shape=box,color=blue];
		j2241217761 -> j4192617946;
	j1903763391 [label="Se bem que… isso pode me dar uma noção sobre o que eu gostaria de falar com você.",shape=box,color=blue];
		j1903763391 -> j523704316;
	j2502440499 [label="Mas isso é conversa para outro dia, senão ficaremos aqui para sempre… e o Monsieur Loid ficará bravo comigo.",shape=box,color=blue];
		j2502440499 -> j4192617946;
	j4192617946 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
