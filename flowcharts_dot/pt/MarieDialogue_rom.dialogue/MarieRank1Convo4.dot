		j2028837304 -> j1007212527;
	j234761000 [label="+5 Chemistry",color=orange];
		j234761000 -> j27811792;
	j3466943256 [label="Ah, compreendo… você está somente procurando por soldados. Mas é mais provável que aquele demônio lhe apunhale pelas costas antes de atacar seus inimigos.",shape=box,color=blue];
		j3466943256 -> j2452918808;
	j3304002947 [label="Le diable séduit les cœurs les plus forts. Ele joga o jogo da astúcia, mas cuidado: certifique-se de que ele olhe somente nos seus olhos.",shape=box,color=blue];
		j3304002947 -> j979139322;
	j1007212527 [label="Parece-me que ele sobreviveu por mais tempo do que qualquer um deveria. Talvez o inferno devesse voltar para reivindicar o que fugiu de lá.",shape=box,color=blue];
		j1007212527 -> j979139322;
	j27811792 [label="Louvo a sua compaixão, ela enche meu coração de alegria. Os Luminários nos ensinam que todos podem receber ajuda e que todos podem ser perdoados, mas… somente se isso partir deles.",shape=box,color=blue];
		j27811792 -> j1524207299;
	j2452918808 [label="Ele não é seu aliado, e jamais será. Aquele diabo só se alia àqueles que servem para os propósitos dele.",shape=box,color=blue];
		j2452918808 -> j120713766;
		j2452918808 -> j1137961034;
		j2452918808 -> j871308870;
	j979139322 [label="+5 Chemistry",color=orange];
		j979139322 -> j905410851;
	j1524207299 [label="Esforço eterno voltado àqueles que nunca cogitaram sua própria redenção é uma vida de escravidão.",shape=box,color=blue];
		j1524207299 -> j120713766;
		j1524207299 -> j1137961034;
		j1524207299 -> j871308870;
	j120713766 [label="Eu manjo mais dos Orokin e da situação dele do que você, não preciso da sua ajuda",shape=box,color=red];
		j120713766 -> j1478853706;
	j1137961034 [label="Valeu pelo aviso, vou ter isso em mente quando falar com ele",shape=box,color=red];
		j1137961034 -> j444873214;
	j871308870 [label="Valeu, mas eu sei tomar conta de mim. Além disso… já tive que lidar com coisa bem pior que ele",shape=box,color=red];
		j871308870 -> j2586366890;
	j905410851 [label="Mas estou sendo indelicada… você não o conhece. Você não o enxerga verdadeiramente. Eu só… não quero que você se machuque.",shape=box,color=blue];
		j905410851 -> j120713766;
		j905410851 -> j1137961034;
		j905410851 -> j871308870;
