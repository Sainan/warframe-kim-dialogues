		j1478853706 -> j2770555391;
	j444873214 [label="+10 Chemistry",color=orange];
		j444873214 -> j1634730076;
	j2586366890 [label="+5 Chemistry",color=orange];
		j2586366890 -> j516712689;
	j2770555391 [label="Perdão… mal conheço você ou sua capacidade de resistir à manipulação. Só me preocupo com sua segurança, pois despejamos nossos problemas sobre você.",shape=box,color=blue];
		j2770555391 -> j580775679;
	j1634730076 [label="É o mínimo que lhe peço. Merci, merci, merci. Agora, receio que devo partir.",shape=box,color=blue];
		j1634730076 -> "Chat ends.";
	j516712689 [label="Oui, vous avez raison… mal conheço você ou sua capacidade de resistir à manipulação. Só me preocupo com sua segurança, pois despejamos nossos problemas sobre você.",shape=box,color=blue];
		j516712689 -> j1417153148;
