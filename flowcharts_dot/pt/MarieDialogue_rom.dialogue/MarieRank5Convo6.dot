	j2568647159 [label="Ó, Luminários… que tipo de inferno vocês criaram para ele, para manter sua alma presa nessa gaiola de ciência e luzes cintilantes?",shape=box,color=blue];
		j2568647159 -> j4244895210;
	j429201344 [label="Só me resta rezar para os Luminários para que você tenha razão e que nada reste dentro daquela casca além de… ciência e luzes cintilantes.",shape=box,color=blue];
		j429201344 -> j1341263082;
	j3209491728 [label="Sei que você não tem certeza se os Cephalons contêm almas, mas só posso rezar aos Luminários para que… o pobre Otak não esteja sofrendo.",shape=box,color=blue];
		j3209491728 -> j4213017122;
	j2200640677 [label="Só posso rezar aos Luminários para que tudo o que reste dentro daquela casca seja nada além de… ciência e luzes cintilantes.",shape=box,color=blue];
		j2200640677 -> j925924501;
	j4244895210 [label="Por que deixá-lo lá, destruído e esperando até que lhe seja permitido morrer para encontrar a paz? Só me resta rezar… para que, se houver algum tipo de presença ali…",shape=box,color=blue];
		j4244895210 -> j638083363;
	j1341263082 [label="E que nenhuma alma fique presa dentro dessa coisa quebrada, esperando até que lhe seja permitida finalmente morrer para encontrar a paz.",shape=box,color=blue];
		j1341263082 -> j2676774956;
	j4213017122 [label="Que nenhuma alma fique presa dentro dessa coisa quebrada, esperando até que lhe seja permitida finalmente morrer para encontrar a paz.",shape=box,color=blue];
		j4213017122 -> j1792500073;
	j925924501 [label="E que nenhuma alma fique presa dentro dessa coisa quebrada, esperando até que lhe seja permitida finalmente morrer para encontrar a paz.",shape=box,color=blue];
		j925924501 -> j1792500073;
	j638083363 [label="É porque ele permanece por escolha própria numa espécie de vigília solitária…",shape=box,color=blue];
		j638083363 -> j3609133063;
	j2676774956 [label="Porque, se você estiver errado, e uma alma permanecer presa nessa gaiola contra a sua vontade…",shape=box,color=blue];
		j2676774956 -> j2610703970;
	j1792500073 [label="Ou, se existe algum tipo de presença ali, é porque ele permanece por escolha própria, numa espécie de vigília solitária.",shape=box,color=blue];
		j1792500073 -> j3609133063;
	j3609133063 [label="Pensar o contrário já basta para questionar a bondade dos deuses, non?",shape=box,color=blue];
