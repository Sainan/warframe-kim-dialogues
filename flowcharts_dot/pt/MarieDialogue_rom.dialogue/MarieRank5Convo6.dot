	3145 [label="Você conheceu o Otak? Vish… como foi?",shape=box,color=red];
		3145 -> 3150;
	3146 [label="Que bom que vocês finalmente se conheceram. O Otak é… complicado de explicar",shape=box,color=red];
		3146 -> 3151;
	3147 [label="Coitado do Otak… como foi?",shape=box,color=red];
		3147 -> 3152;
	3148 [label="Ele… se apresentou para mim 3 vezes na mesma conversa, como se nunca tivéssemos sido apresentados.",shape=box,color=blue];
		3148 -> 3153;
	3149 [label="Sim… embora talvez eu quisesse chorar por isso. Pois ele se apresentou para mim 3 vezes na mesma conversa, como se nunca tivéssemos sido apresentados.",shape=box,color=blue];
		3149 -> 3153;
	3150 [label="Por que você parece tão insatisfeito por eu tê-lo conhecido?",shape=box,color=blue];
		3150 -> 3154;
		3150 -> 3155;
		3150 -> 3156;
	3151 [label="É, acho que sim. Um rabisco de criança escrito nas costas de um autômato… achei-o simplesmente adorável e encantador!",shape=box,color=blue];
		3151 -> 3157;
	3152 [label="Achei-o simplesmente adorável e encantador! Mas, por trás de uma camada de humor, eu sentia uma grande tristeza.",shape=box,color=blue];
		3152 -> 3158;
	3153 [label="Ele me cumprimentou da mesma maneira alegre e inabalável das vezes anteriores. Mas ele sabia que eu era uma Sœur de Sol! ",shape=box,color=blue];
		3153 -> 3159;
	3154 [label="Sinto muito… ele irrita as pessoas de vez em quando, não é culpa dele",shape=box,color=red];
		3154 -> 3160;
	3155 [label="Não foi minha intenção, é que ele pode ser meio… desagradável pra algumas pessoas",shape=box,color=red];
		3155 -> 3160;
	3156 [label="Tem vez que ele me irrita, só isso",shape=box,color=red];
		3156 -> 3161;
	3157 [label="Mas por trás do humor, esconde-se uma grande tristeza.",shape=box,color=blue];
		3157 -> 3158;
	3158 [label="Poderia me contar a história do pobre Monsieur Otak?",shape=box,color=blue];
		3158 -> 3162;
	3159 [label="De fato, ele conhecia muito bem os Luminários! Conversamos longamente sobre as \"Religiões Ancestrais\", como ele as chamava, nos \"dias de antes do Império Orokin\".",shape=box,color=blue];
		3159 -> 3163;
	3160 [label="E eu espero que tais pessoas lhe mostrem bondade e paciência. Mais par la grâce de Sol.",shape=box,color=blue];
		3160 -> 3164;
	3161 [label="Espero que você procure ser mais gentil com alguém que está claramente debilitado. Em nome da graça do Sol.",shape=box,color=blue];
		3161 -> 3164;
	3162 [label="O Otak era um Arquimediano, um cientista e acadêmico Orokin. O que aconteceu com ele não é exatamente uma história muito feliz…",shape=box,color=red];
		3162 -> 3165;
	3163 [label="Embora ele tenha dito que muito desse conhecimento estava perdido agora, guardado em arquivos profundos e estritamente proibido. Ele me fez jurar segredo.",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="Tal destino poderia aguardar qualquer um de nós… até mesmo você.",shape=box,color=blue];
		3164 -> 3167;
		3164 -> 3168;
	3165 [label="Segundo relatos, ele era um gênio. A mente por trás do estudo e uso dos cristais de argônio e tudo mais",shape=box,color=red];
		3165 -> 3169;
	3166 [label="Ele me disse que estava profundamente preocupado com a possibilidade de o Executor Ballas… seja lá quem ele for… descobrir minha seita de hereges e mandar me executar.",shape=box,color=blue];
		3166 -> 3170;
		3166 -> 3171;
	3167 [label="Foi mal, não tenho tempo pra ele",shape=box,color=red];
		3167 -> 3172;
	3168 [label="Você tem razão, foi mal. Falei sem pensar",shape=box,color=red];
		3168 -> 3158;
	3169 [label="Que são extraídos do Void e são a razão pela qual podemos criar muitos dos poderosos Warframes e armas que temos",shape=box,color=red];
		3169 -> 3173;
	3170 [label="Isso… não vai acontecer. Pode continuar",shape=box,color=red];
		3170 -> 3174;
	3171 [label="O Ballas tá morto… pode continuar",shape=box,color=red];
		3171 -> 3174;
	3172 [label="Então, peço desculpas por ter desperdiçado mais do seu tempo.",shape=box,color=blue];
		3172 -> 3175;
	3173 [label="Ele se especializou em cristalografia, e seus trabalhos foram todos arquivados aqui, nos laboratórios",shape=box,color=red];
		3173 -> 3176;
	3174 [label="+5 Chemistry",color=orange];
