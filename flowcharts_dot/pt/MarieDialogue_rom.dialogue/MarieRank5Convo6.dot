		3175 -> 3178;
	3176 [label="Por alguma razão, que não faço ideia de qual é, ele foi transformado em um Cephalon e recebeu seu próprio \"corpo\" de Necraloid",shape=box,color=red];
		3176 -> 3179;
	3177 [label="Eu suspeitei… bem, ele me perguntou de onde eu era, e quando eu disse, ele riu e disse: \"Não, isso é impossível! E eu sei do que estou falando, eu sou…\"",shape=box,color=blue];
		3177 -> 3180;
	3178 [label="Chat ends.",color=orange];
	3179 [label="Nem todo Cephalon foi feito com o objetivo de punir alguém. Mas as coisas meio que… desandaram aqui em Deimos, e ele acabou ficando bem danificado",shape=box,color=red];
		3179 -> 3181;
