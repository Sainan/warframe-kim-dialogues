		j567621390 -> j414075399;
	j2395824921 [label="Hahaha! Merci, isso com certeza vai acabar com essas minhas lágrimas bobas. Você sabe como animar a bobinha da Marie, non?",shape=box,color=blue];
		j2395824921 -> j4026909134;
		j2395824921 -> j2280775024;
	j2116915811 [label="Oui, você tem toda a razão. O mundo está cheio de histórias como a do Monsieur Otak, e muitas piores que a dele. Eu não deveria chorar por uma só. ",shape=box,color=blue];
		j2116915811 -> j221074962;
