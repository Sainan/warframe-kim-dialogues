	j3394920032 [label="Como foi sua conversa com ele?",shape=box,color=red];
		j3394920032 -> j3442002773;
	j48481792 [label="Você gostou de conversar com ele?",shape=box,color=red];
		j48481792 -> j378380824;
	j532401988 [label="Você conheceu o Otak? Vish… como foi?",shape=box,color=red];
		j532401988 -> j115741607;
	j2294632612 [label="Que bom que vocês finalmente se conheceram. O Otak é… complicado de explicar",shape=box,color=red];
		j2294632612 -> j3873663411;
	j1278786163 [label="Coitado do Otak… como foi?",shape=box,color=red];
		j1278786163 -> j1784934846;
	j3442002773 [label="Ele… se apresentou para mim 3 vezes na mesma conversa, como se nunca tivéssemos sido apresentados.",shape=box,color=blue];
		j3442002773 -> j3004676381;
	j378380824 [label="Sim… embora talvez eu quisesse chorar por isso. Pois ele se apresentou para mim 3 vezes na mesma conversa, como se nunca tivéssemos sido apresentados.",shape=box,color=blue];
		j378380824 -> j3004676381;
	j115741607 [label="Por que você parece tão insatisfeito por eu tê-lo conhecido?",shape=box,color=blue];
		j115741607 -> j3248390487;
		j115741607 -> j1098213499;
		j115741607 -> j3088999047;
	j3873663411 [label="É, acho que sim. Um rabisco de criança escrito nas costas de um autômato… achei-o simplesmente adorável e encantador!",shape=box,color=blue];
		j3873663411 -> j3342319263;
	j1784934846 [label="Achei-o simplesmente adorável e encantador! Mas, por trás de uma camada de humor, eu sentia uma grande tristeza.",shape=box,color=blue];
		j1784934846 -> j181568402;
	j3004676381 [label="Ele me cumprimentou da mesma maneira alegre e inabalável das vezes anteriores. Mas ele sabia que eu era uma Sœur de Sol! ",shape=box,color=blue];
		j3004676381 -> j2026236666;
	j3248390487 [label="Sinto muito… ele irrita as pessoas de vez em quando, não é culpa dele",shape=box,color=red];
		j3248390487 -> j1601586383;
	j1098213499 [label="Não foi minha intenção, é que ele pode ser meio… desagradável pra algumas pessoas",shape=box,color=red];
		j1098213499 -> j1601586383;
	j3088999047 [label="Tem vez que ele me irrita, só isso",shape=box,color=red];
		j3088999047 -> j1170012860;
	j3342319263 [label="Mas por trás do humor, esconde-se uma grande tristeza.",shape=box,color=blue];
		j3342319263 -> j181568402;
	j181568402 [label="Poderia me contar a história do pobre Monsieur Otak?",shape=box,color=blue];
		j181568402 -> j1503649129;
	j2026236666 [label="De fato, ele conhecia muito bem os Luminários! Conversamos longamente sobre as \"Religiões Ancestrais\", como ele as chamava, nos \"dias de antes do Império Orokin\".",shape=box,color=blue];
		j2026236666 -> j4274011663;
	j1601586383 [label="E eu espero que tais pessoas lhe mostrem bondade e paciência. Mais par la grâce de Sol.",shape=box,color=blue];
		j1601586383 -> j3436468873;
	j1170012860 [label="Espero que você procure ser mais gentil com alguém que está claramente debilitado. Em nome da graça do Sol.",shape=box,color=blue];
		j1170012860 -> j3436468873;
	j1503649129 [label="O Otak era um Arquimediano, um cientista e acadêmico Orokin. O que aconteceu com ele não é exatamente uma história muito feliz…",shape=box,color=red];
		j1503649129 -> j4006539836;
	j4274011663 [label="Embora ele tenha dito que muito desse conhecimento estava perdido agora, guardado em arquivos profundos e estritamente proibido. Ele me fez jurar segredo.",shape=box,color=blue];
		j4274011663 -> j4150363125;
	j3436468873 [label="Tal destino poderia aguardar qualquer um de nós… até mesmo você.",shape=box,color=blue];
		j3436468873 -> j1885723243;
		j3436468873 -> j2563001773;
	j4006539836 [label="Segundo relatos, ele era um gênio. A mente por trás do estudo e uso dos cristais de argônio e tudo mais",shape=box,color=red];
		j4006539836 -> j2331535636;
	j4150363125 [label="Ele me disse que estava profundamente preocupado com a possibilidade de o Executor Ballas… seja lá quem ele for… descobrir minha seita de hereges e mandar me executar.",shape=box,color=blue];
		j4150363125 -> j2863729339;
		j4150363125 -> j3656608572;
	j1885723243 [label="Foi mal, não tenho tempo pra ele",shape=box,color=red];
		j1885723243 -> j279911747;
	j2563001773 [label="Você tem razão, foi mal. Falei sem pensar",shape=box,color=red];
		j2563001773 -> j181568402;
	j2331535636 [label="Que são extraídos do Void e são a razão pela qual podemos criar muitos dos poderosos Warframes e armas que temos",shape=box,color=red];
		j2331535636 -> j2307902238;
	j2863729339 [label="Isso… não vai acontecer. Pode continuar",shape=box,color=red];
		j2863729339 -> j448778881;
	j3656608572 [label="O Ballas tá morto… pode continuar",shape=box,color=red];
		j3656608572 -> j448778881;
	j279911747 [label="Então, peço desculpas por ter desperdiçado mais do seu tempo.",shape=box,color=blue];
		j279911747 -> j3007723528;
	j2307902238 [label="Ele se especializou em cristalografia, e seus trabalhos foram todos arquivados aqui, nos laboratórios",shape=box,color=red];
		j2307902238 -> j3940446431;
	j448778881 [label="+5 Chemistry",color=orange];
		j448778881 -> j2018759051;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j3940446431 [label="Por alguma razão, que não faço ideia de qual é, ele foi transformado em um Cephalon e recebeu seu próprio \"corpo\" de Necraloid",shape=box,color=red];
		j3940446431 -> j1255774176;
	j2018759051 [label="Eu suspeitei… bem, ele me perguntou de onde eu era, e quando eu disse, ele riu e disse: \"Não, isso é impossível! E eu sei do que estou falando, eu sou…\"",shape=box,color=blue];
		j2018759051 -> j1241615217;
	j1255774176 [label="Nem todo Cephalon foi feito com o objetivo de punir alguém. Mas as coisas meio que… desandaram aqui em Deimos, e ele acabou ficando bem danificado",shape=box,color=red];
		j1255774176 -> j3263344937;
	j1241615217 [label="E então ele… apresentou-se a mim novamente. E perguntou-me se eu vinha das planícies, com amostras de minerais…",shape=box,color=blue];
		j1241615217 -> j2920849135;
		j1241615217 -> j1134875852;
	j3263344937 [label="Pauvre petit…",shape=box,color=blue];
		j3263344937 -> j1698645168;
	j2920849135 [label="Ah, Marie… sinto muito…",shape=box,color=red];
		j2920849135 -> j3203556234;
	j1134875852 [label="É… esse é o Otak",shape=box,color=red];
		j1134875852 -> j3203556234;
	j1698645168 [label="Boolean MarieOtak1 is now true.",color=orange];
		j1698645168 -> j3394920032;
		j1698645168 -> j48481792;
	j3203556234 [label="Fico arrasada só de pensar que não há nada que se possa fazer por ele.",shape=box,color=blue];
		j3203556234 -> j1970966774;
	j1970966774 [label="Evaluate expressions",color=orange];
