	j3006289518 [label="+10 Chemistry",color=orange];
		j3006289518 -> j706698511;
	j2324906770 [label="Fiquei um pouco em choque que agora você sabe mais sobre ele do que eu",shape=box,color=red];
		j2324906770 -> j3006289518;
	j2883963949 [label="Não sei nada sobre o passado do Loid, e já o conheço há algum tempo",shape=box,color=red];
		j2883963949 -> j3006289518;
	j3892759103 [label="Isso acontece muito, não é só você",shape=box,color=red];
