	j3133010229 [label="Ah! Claro.",shape=box,color=blue];
		j3133010229 -> j2043982582;
	j152294404 [label="Ah, nem me dê atenção, estou só me divertindo um pouco. Tolinha, a Marie, la révolutionnaire.",shape=box,color=blue];
		j152294404 -> j2069525598;
	j161604726 [label="+10 Chemistry",color=orange];
		j161604726 -> j152294404;
	j2043982582 [label="Receio ter esquecido completamente o que vim aqui lhe perguntar! Hahaha! Ah, bem, vou me lembrar em breve.",shape=box,color=blue];
