	j706698511 [label="Ah! Não leve para o lado pessoal, s'il vous plaît!",shape=box,color=blue];
		j706698511 -> j4165847614;
	j3412231356 [label="Os Orokin propositalmente tornaram sua sociedade confusa e obtusa?",shape=box,color=blue];
		j3412231356 -> j4082468595;
		j3412231356 -> j1509235641;
		j3412231356 -> j4145568457;
	j4165847614 [label="Monsieur Loid é… como posso dizer… \"distante\"?",shape=box,color=blue];
		j4165847614 -> j3641864212;
		j4165847614 -> j404399479;
	j4082468595 [label="Depois de milhares de anos no comando, as pessoas ficam… entediadas. Pessoas entediadas criam sistemas complexos",shape=box,color=red];
		j4082468595 -> j1103501023;
	j1509235641 [label="Eles tinham uma afinidade pelo ornamentado e intrincado, o que se estendia à burocracia",shape=box,color=red];
		j1509235641 -> j1103501023;
	j4145568457 [label="Sinceramente? Tô começando a achar que sim",shape=box,color=red];
		j4145568457 -> j1103501023;
	j3641864212 [label="Na verdade, não sei nada sobre ele",shape=box,color=red];
		j3641864212 -> j2712996714;
	j404399479 [label="É, ele é um pouco \"distante\"",shape=box,color=red];
		j404399479 -> j2712996714;
	j1103501023 [label="+10 Chemistry",color=orange];
		j1103501023 -> j3075090132;
	j2712996714 [label="Olha só com quem convivo, oui? Não é tão difícil reconhecer os semelhantes.",shape=box,color=blue];
		j2712996714 -> j499826504;
	j3075090132 [label="Penso que fizeram isso só para irritar a todos!",shape=box,color=blue];
		j3075090132 -> j458268678;
	j499826504 [label="+10 Chemistry",color=orange];
		j499826504 -> j149462632;
	j458268678 [label="Et ils se demandent pourquoi des rébellions éclatent. Vous aviez peut-être vos warframes, mais nous avions nos guillotines!",shape=box,color=blue];
		j458268678 -> j2923775295;
	j149462632 [label="Embora eu admita que o Monsieur Loid é um pouco mais… piquant que o querido Lyon.",shape=box,color=blue];
		j149462632 -> j351094980;
		j149462632 -> j473729236;
