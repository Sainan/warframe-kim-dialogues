	1713 [label="+5 Chemistry",color=orange];
		1713 -> 1717;
	1714 [label="Non, não o diabo. Qualquer um, menos o diabo. Mas você está no caminho certo. A escolha natural é o Monsieur Loid, non?",shape=box,color=blue];
		1714 -> 1718;
	1715 [label="Acho isso desnecessariamente cruel, não acha? Eles podem até achar que ele morreu… ou pior! E nós, morando aqui, comme des rats d'égout?",shape=box,color=blue];
		1715 -> 1719;
		1715 -> 1720;
		1715 -> 1721;
	1716 [label="Para não passarmos o resto de nossas vidas aqui, comme des rats d'égout.",shape=box,color=blue];
		1716 -> 1722;
		1716 -> 1723;
	1717 [label="Oui, oui! C'est ça! Mas como vamos convencê-lo? Ele tem se mantido firme em sua posição, non?",shape=box,color=blue];
		1717 -> 1724;
		1717 -> 1725;
	1718 [label="Oui, oui! C'est ça! Mas como vamos convencê-lo? Ele tem se mantido firme em sua posição, non?",shape=box,color=blue];
		1718 -> 1725;
		1718 -> 1724;
	1719 [label="Curiosamente, tenho uma amiga que adora ratos. Acho eles bem adoráveis",shape=box,color=red];
		1719 -> 1726;
	1720 [label="Não é uma decisão que eu possa tomar",shape=box,color=red];
		1720 -> 1727;
	1721 [label="O que você sugere que eu faça?",shape=box,color=red];
		1721 -> 1728;
	1722 [label="Curiosamente, tenho uma amiga que adora ratos. Acho eles bem adoráveis",shape=box,color=red];
		1722 -> 1729;
	1723 [label="Você tem razão, fui negligente nesse ponto. Vou trabalhar nisso",shape=box,color=red];
		1723 -> 1730;
	1724 [label="Acha que você ou o Lyon conseguem convencer ele?",shape=box,color=red];
		1724 -> 1731;
	1725 [label="Marie, tu não vai gostar da minha resposta…",shape=box,color=red];
		1725 -> 1732;
	1726 [label="Adoraria conhecê-los algum dia, mas não é bem isso que estou querendo dizer, bobinho.",shape=box,color=blue];
		1726 -> 1728;
	1727 [label="Entendo… a escolha só cabe ao Monsieur Loid e ao resto de saberem a verdade.",shape=box,color=blue];
		1727 -> 1728;
	1728 [label="Eu diria que é um sentimento de culpa, e não de nobreza, que nos mantém aqui embaixo.",shape=box,color=blue];
		1728 -> 1733;
	1729 [label="Adoraria conhecê-los algum dia, mas não é bem isso que estou querendo dizer, bobinho.",shape=box,color=blue];
		1729 -> 1728;
	1730 [label="Obrigada. Não sei se você conseguirá, mas, às vezes, só podemos tentar…",shape=box,color=blue];
		1730 -> 1728;
	1731 [label="Ele gosta bastante de nós, é sempre gentil. Mas somos estranhos para ele, recém-chegados aqui.",shape=box,color=blue];
		1731 -> 1734;
	1732 [label="Ah bon?",shape=box,color=blue];
		1732 -> 1735;
	1733 [label="É o fato de que escondemos um grande e terrível pecado.",shape=box,color=blue];
		1733 -> 1736;
	1734 [label="Vou pensar nisso. Sugiro que você faça o mesmo! Uma solução será encontrada, Sol já nos guiou até aqui!",shape=box,color=blue];
		1734 -> 1737;
	1735 [label="Então… é bem mais provável que o Loid dê ouvidos ao Roathe. O fato de ele ser Orokin e ter uma história em comum pode ser útil pra isso",shape=box,color=red];
		1735 -> 1738;
	1736 [label="E é exatamente esse pecado que deve ser perdoado, ou provado como falso, talvez?",shape=box,color=blue];
		1736 -> 1739;
