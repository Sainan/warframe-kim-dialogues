		1656 -> 1679;
	2937 [label="O que nos impede de simplesmente mudar todos os móveis de lugar, deixar que eles os substituam e depois… fazer tudo de novo? Poderíamos vender tudo! Lucrar com essas mobilier étrange!",shape=box,color=blue];
