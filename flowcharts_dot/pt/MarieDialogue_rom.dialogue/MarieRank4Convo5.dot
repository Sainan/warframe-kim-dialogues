	j1460364214 [label="Vou pensar nisso. Sugiro que você faça o mesmo! Uma solução será encontrada, Sol já nos guiou até aqui!",shape=box,color=blue];
		j1460364214 -> j3513176084;
	j582382388 [label="Então… é bem mais provável que o Loid dê ouvidos ao Roathe. O fato de ele ser Orokin e ter uma história em comum pode ser útil pra isso",shape=box,color=red];
