	j1204768946 [label="Sinceramente… me distraí",shape=box,color=red];
		j1204768946 -> j2434777941;
	j374761143 [label="Poderia estar melhor",shape=box,color=red];
		j374761143 -> j2373551516;
	j975254917 [label="Tá caminhando",shape=box,color=red];
		j975254917 -> j519300291;
	j3390218054 [label="Sua filha, Euleria (conhecida como Mãe) e sua família cuidaram de Deimos durante todo esse tempo",shape=box,color=red];
		j3390218054 -> j1273768922;
	j941286646 [label="O que nos impede de simplesmente mudar todos os móveis de lugar, deixar que eles os substituam e depois… fazer tudo de novo? Poderíamos vender tudo! Lucrar com essas mobilier étrange!",shape=box,color=blue];
		j941286646 -> j2637372491;
		j941286646 -> j4021177943;
		j941286646 -> j1592459757;
	j3681321960 [label="Estou bem ciente de nossas divergências não resolvidas em relação ao Cardinal. Estou tentando manter esta conversa civilisée.",shape=box,color=blue];
		j3681321960 -> j3913975194;
	j1202141442 [label="Entendo que você não queira discutir a resolução de conflitos sem aproveitar a oportunidade para apontar o dedo para aqueles que considera responsáveis.",shape=box,color=blue];
		j1202141442 -> j3913975194;
	j106680843 [label="Sim! Como você gosta de me lembrar com frequência, você o considera um monstro! Com nada além de rancor e vazio no coração!",shape=box,color=blue];
		j106680843 -> j3913975194;
	j2183208407 [label="Pensei que você estivesse do meu lado nesta guerra pela alma do Cardinal?",shape=box,color=blue];
		j2183208407 -> j617791194;
	j2559067076 [label="Achei que você ainda não tinha se decidido sobre le Cardinal. Ou isso mudou?",shape=box,color=blue];
		j2559067076 -> j1651796970;
		j2559067076 -> j2554375780;
	j1975438998 [label="Oui. Isso eu estou aprendendo com o Monsieur Tagfer…",shape=box,color=blue];
		j1975438998 -> j680328632;
	j683663998 [label="Não fale comigo sobre feridas, lobo. Ainda estou curando as minhas da nossa última discussão sobre le Cardinal.",shape=box,color=blue];
		j683663998 -> j3913975194;
	j1914206929 [label="Oui, mas você disse isso antes: precisamos parar de culpar uns aos outros por tais feridas que nos afligem.",shape=box,color=blue];
		j1914206929 -> j3476834931;
	j309651184 [label="Eu sei que você acredita que le Cardinal é algum tipo de monstro terrível por causar essas feridas.",shape=box,color=blue];
		j309651184 -> j3913975194;
	j3390992115 [label="Sei que você está do meu lado nesta guerra pela alma do Cardinal e serei eternamente grata por isso.",shape=box,color=blue];
		j3390992115 -> j3864773231;
	j194254867 [label="Sei que você está evitando julgá-lo e sou extremamente grata por isso.",shape=box,color=blue];
		j194254867 -> j3864773231;
	j3864773231 [label="E mesmo sabendo que os outros são rápidos em culpá-lo, eu não quero nos ver divididos e sangrando quando poderíamos estar inteiros.",shape=box,color=blue];
		j3864773231 -> j984701858;
	j2819836828 [label="Oui, mas estou aprendendo, assim como aconteceu com o Monsieur Tagfer, que talvez nem todos no mesmo grau.",shape=box,color=blue];
		j2819836828 -> j680328632;
	j3746834055 [label="E estou aprendendo que nem todos no mesmo grau, como você foi tão \"gentil\" em apontar, non?",shape=box,color=blue];
		j3746834055 -> j3913975194;
	j97497180 [label="Oui, sim! Embora eu não culpe le Cardinal por ter ido embora, pois seu trabalho é sagrado…",shape=box,color=blue];
		j97497180 -> j3864773231;
	j3421699923 [label="E sei que você acredita que le Cardinal é algum tipo de monstro terrível por causar essas feridas.",shape=box,color=blue];
		j3421699923 -> j3913975194;
	j2855914417 [label="E enquanto os outros são rápidos em culpá-lo por suas dores, eu simplesmente não quero nos ver divididos e sofrendo.",shape=box,color=blue];
		j2855914417 -> j984701858;
	j2434777941 [label="E o que poderia estar te distraindo? O que poderia ser mais importante do que sentar e analisar as reclamações dos insatisfeitos?",shape=box,color=blue];
		j2434777941 -> j2738703179;
	j2373551516 [label="O que poderia ser a dificuldade em sentar e analisar as reclamações dos insatisfeitos?",shape=box,color=blue];
		j2373551516 -> j4098781578;
	j519300291 [label="Oh, magnifique!",shape=box,color=blue];
		j519300291 -> j3353287299;
	j1273768922 [label="Cuidando deste lugar e do coração que bombeia energia do Void ao Sistema de Origem, mantendo todos aqui… como ferramentas utilizáveis, desde que o Entrati partiu",shape=box,color=red];
		j1273768922 -> j3916832970;
	j2637372491 [label="Não sei se tem muito mercado pra \"Cadeiras do Entrati\" não…",shape=box,color=red];
		j2637372491 -> j2189250938;
	j4021177943 [label="Acho que isso ia quebrar o mercado, não? A gente ia ter que vender bem barato…",shape=box,color=red];
		j4021177943 -> j2189250938;
	j1592459757 [label="Ótima ideia… não vejo nenhum problema nisso…",shape=box,color=red];
		j1592459757 -> j523572895;
	j3913975194 [label="Embora eu entenda que ambos os tópicos estão inexoravelmente conectados, peço que você mantenha sua produtividade neste dia, oui?",shape=box,color=blue];
		j3913975194 -> j747625733;
	j617791194 [label="Mas que mentira é essa, lobo? A pequena Marie é só mais um jogo para você?",shape=box,color=blue];
		j617791194 -> j4234845944;
		j617791194 -> j2554375780;
	j1651796970 [label="Ainda não me decidi sobre a real necessidade de ele ter feito o que fez, mas a natureza insensível dele não tem nem como ser questionada",shape=box,color=red];
		j1651796970 -> j3913975194;
	j2554375780 [label="Foi mal, cansei de ficar fingindo",shape=box,color=red];
		j2554375780 -> j3848352635;
	j680328632 [label="Precisamos parar de culpar uns aos outros por tais feridas que nos afligem.",shape=box,color=blue];
		j680328632 -> j3476834931;
	j3476834931 [label="Também não concordo em culpar o Cardeal, mas não quero nos ver divididos e mortos, quero nos ver juntos e unidos.",shape=box,color=blue];
		j3476834931 -> j2904987119;
		j3476834931 -> j3093826139;
	j984701858 [label="Precisamos parar de culpar uns aos outros por tais feridas que nos afligem, independentemente de quem tenha as causado.",shape=box,color=blue];
		j984701858 -> j2904987119;
		j984701858 -> j3093826139;
	j2738703179 [label="Estou te provocando, é brincadeira! Não consigo imaginar o quão ocupado você é, nem todos os lugares e momentos em que você é necessário.",shape=box,color=blue];
		j2738703179 -> j3353287299;
	j4098781578 [label="Estou te provocando, é brincadeira! Não consigo imaginar o que eles aguentaram. E o quão desafiador é pra você resolver isso tudo.",shape=box,color=blue];
		j4098781578 -> j3353287299;
	j3353287299 [label="Simplesmente temo que, sem uma solução para esses problemas, nunca poderemos esperar ser bem-vindos à mesa deles. O problema mais sério continua sem solução:",shape=box,color=blue];
		j3353287299 -> j3280834472;
	j3916832970 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3916832970 -> j3973352071 [label=true,color=green];
		j3916832970 -> j3337182392 [label=false,color=brown];
	j2189250938 [label="Aff! Ainda acho que este é um experimento válido. Talvez possamos cercar o diabo com um mar de estantes de livros!",shape=box,color=blue];
		j2189250938 -> j2682271968;
	j523572895 [label="Vou ignorar seu sarcasmo, pois acho que este é um experimento válido. Talvez possamos aprisionar o diabo em um mar de estantes de livros!",shape=box,color=blue];
		j523572895 -> j2682271968;
	j747625733 [label="Procuro ajudar todos nessa… estranha coexistência em que nos encontramos.",shape=box,color=blue];
		j747625733 -> j680328632;
	j4234845944 [label="Não, nada aqui é um jogo, mas não dá pra confiar no Entrati, e não sei como tentar te mostrar isso sem ter que fingir estar do seu lado",shape=box,color=red];
		j4234845944 -> j688579943;
	j3848352635 [label="Oui? Bem, fico feliz em lhe dizer que você não precisa mais fazer isso.",shape=box,color=blue];
		j3848352635 -> j1509439757;
	j2904987119 [label="Juntos, como uma coisa só, somos… uma família peculiar. Mas uma família, ainda assim",shape=box,color=red];
		j2904987119 -> j1625808289;
	j3093826139 [label="Seríamos mais fortes juntos do que separados",shape=box,color=red];
		j3093826139 -> j1749118614;
		j3093826139 -> j2609309644;
	j3973352071 [label="Ela já aceitou a ausência dele, e a família já fez as pazes entre eles, mas foi bem difícil chegar nesse ponto",shape=box,color=red];
		j3973352071 -> j2251004658;
	j3337182392 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j3337182392 -> j3973352071 [label=true,color=green];
		j3337182392 -> j1774232750 [label=false,color=brown];
	j2682271968 [label="+20 Chemistry",color=orange];
		j2682271968 -> j1915507486;
	j688579943 [label="Oui? Bem, tenho o prazer de lhe dizer que você falhou miseravelmente.",shape=box,color=blue];
		j688579943 -> j1509439757;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j1625808289 [label="Add +1 to Family counter",color=orange];
		j1625808289 -> j1749118614;
		j1625808289 -> j2609309644;
	j1749118614 [label="E em momentos de sofrimento, às vezes, tudo o que realmente temos é um ao outro. Sejam aqueles que nos acharam, ou aqueles que achamos",shape=box,color=red];
		j1749118614 -> j3827884630;
	j2609309644 [label="Não sei se isso vai ajudar ou piorar as coisas a longo prazo. Mas esse… purgatório também não é justo",shape=box,color=red];
		j2609309644 -> j3130366610;
	j2251004658 [label="Sabendo que ele ainda tá solto por aí, e que ele nunca nem falou nada pra ela… nem mesmo uma carta…",shape=box,color=red];
		j2251004658 -> j1444815490;
	j1774232750 [label="Ela ainda não aceitou a ausência dele, e a família toda continua brigando entre si",shape=box,color=red];
		j1774232750 -> j2565112351;
	j1915507486 [label="Há muito a ser feito! À la revoyure!",shape=box,color=blue];
		j1915507486 -> "Chat ends.";
	j2631316640 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j2631316640 -> j1508231473;
	j3827884630 [label="Add +1 to Family counter",color=orange];
		j3827884630 -> j3130366610;
	j3130366610 [label="Oui, concordo. Mas não posso ser a pessoa que vai fazer a ponte. Não sei como fazer isso! Sou uma estranha para eles lá em cima…",shape=box,color=blue];
		j3130366610 -> j3155992592;
		j3130366610 -> j3962225947;
	j1444815490 [label="Nem consigo imaginar o quão doloroso seria pra ela saber da verdade… pra todos eles, na real",shape=box,color=red];
		j1444815490 -> j3899183133;
	j2565112351 [label="Sabendo que ele ainda tá solto por aí, e que ele nunca nem falou nada pra ela… nem mesmo uma carta…",shape=box,color=red];
		j2565112351 -> j739224678;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j3155992592 [label="O Loid conhecia a família Entrati, tem que ser ele. Mas conseguir isso… aí é outra história…",shape=box,color=red];
		j3155992592 -> j741026283;
	j3962225947 [label="Talvez o Roathe? Ele é Orokin, conhecia todos eles",shape=box,color=red];
		j3962225947 -> j2840810122;
	j3899183133 [label="Embora eu possa ver a lógica por trás da decisão de protegê-los da dor que le Cardeal causou com sua partida necessária…",shape=box,color=blue];
		j3899183133 -> j3404840172;
	j739224678 [label="Espalhar essa verdade destruiria qualquer chance de reconciliação que aquela família possa ter",shape=box,color=red];
		j739224678 -> j2080357286;
	j741026283 [label="+5 Chemistry",color=orange];
		j741026283 -> j1493489310;
	j2840810122 [label="Non, não o diabo. Qualquer um, menos o diabo. Mas você está no caminho certo. A escolha natural é o Monsieur Loid, non?",shape=box,color=blue];
		j2840810122 -> j768280327;
	j3404840172 [label="Acho isso desnecessariamente cruel, não acha? Eles podem até achar que ele morreu… ou pior! E nós, morando aqui, comme des rats d'égout?",shape=box,color=blue];
		j3404840172 -> j3705007127;
		j3404840172 -> j2316064058;
		j3404840172 -> j2927957945;
	j2080357286 [label="Oui… entendo sua lógica. Se puder, seria melhor focar em resolver os problemas familiares primeiro, né? Me parece a única esperança que qualquer um de nós tem para sair daqui",shape=box,color=blue];
		j2080357286 -> j892852135;
	j1493489310 [label="Oui, oui! C'est ça! Mas como vamos convencê-lo? Ele tem se mantido firme em sua posição, non?",shape=box,color=blue];
		j1493489310 -> j535287231;
		j1493489310 -> j2195969597;
	j768280327 [label="Oui, oui! C'est ça! Mas como vamos convencê-lo? Ele tem se mantido firme em sua posição, non?",shape=box,color=blue];
		j768280327 -> j2195969597;
		j768280327 -> j535287231;
	j3705007127 [label="Curiosamente, tenho uma amiga que adora ratos. Acho eles bem adoráveis",shape=box,color=red];
		j3705007127 -> j1155421775;
	j2316064058 [label="Não é uma decisão que eu possa tomar",shape=box,color=red];
		j2316064058 -> j1372550443;
	j2927957945 [label="O que você sugere que eu faça?",shape=box,color=red];
		j2927957945 -> j3977419715;
	j892852135 [label="Para não passarmos o resto de nossas vidas aqui, comme des rats d'égout.",shape=box,color=blue];
		j892852135 -> j2814149093;
		j892852135 -> j1357570884;
	j535287231 [label="Acha que você ou o Lyon conseguem convencer ele?",shape=box,color=red];
		j535287231 -> j2687453478;
	j2195969597 [label="Marie, tu não vai gostar da minha resposta…",shape=box,color=red];
		j2195969597 -> j1065210935;
	j1155421775 [label="Adoraria conhecê-los algum dia, mas não é bem isso que estou querendo dizer, bobinho.",shape=box,color=blue];
		j1155421775 -> j3977419715;
	j1372550443 [label="Entendo… a escolha só cabe ao Monsieur Loid e ao resto de saberem a verdade.",shape=box,color=blue];
		j1372550443 -> j3977419715;
	j3977419715 [label="Eu diria que é um sentimento de culpa, e não de nobreza, que nos mantém aqui embaixo.",shape=box,color=blue];
		j3977419715 -> j590966172;
	j2814149093 [label="Curiosamente, tenho uma amiga que adora ratos. Acho eles bem adoráveis",shape=box,color=red];
		j2814149093 -> j1155421775;
	j1357570884 [label="Você tem razão, fui negligente nesse ponto. Vou trabalhar nisso",shape=box,color=red];
		j1357570884 -> j2645623111;
	j2687453478 [label="Ele gosta bastante de nós, é sempre gentil. Mas somos estranhos para ele, recém-chegados aqui.",shape=box,color=blue];
		j2687453478 -> j1460364214;
	j1065210935 [label="Ah bon?",shape=box,color=blue];
		j1065210935 -> j582382388;
	j590966172 [label="É o fato de que escondemos um grande e terrível pecado.",shape=box,color=blue];
