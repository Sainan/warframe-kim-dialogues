	1707 [label="Update boolean MarieNoDate",color=orange];
		1707 -> 1712;
	1708 [label="O Loid conhecia a família Entrati, tem que ser ele. Mas conseguir isso… aí é outra história…",shape=box,color=red];
		1708 -> 1713;
	1709 [label="Talvez o Roathe? Ele é Orokin, conhecia todos eles",shape=box,color=red];
