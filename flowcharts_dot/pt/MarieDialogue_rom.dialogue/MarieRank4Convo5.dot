	1668 [label="Oui. Isso eu estou aprendendo com o Monsieur Tagfer…",shape=box,color=blue];
		1668 -> 1686;
	1662 [label="Não fale comigo sobre feridas, lobo. Ainda estou curando as minhas da nossa última discussão sobre le Cardinal.",shape=box,color=blue];
		1662 -> 1680;
	1663 [label="Oui, mas você disse isso antes: precisamos parar de culpar uns aos outros por tais feridas que nos afligem.",shape=box,color=blue];
