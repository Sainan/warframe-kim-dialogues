		j73961307 -> j3929162594;
	j2011935578 [label="Necramitas?",shape=box,color=red];
		j2011935578 -> j1299400733;
	j3375317414 [label="Você tem razão, não dá pra competir por algo que a pessoa não tem pra dar",shape=box,color=red];
		j3375317414 -> j380005824;
	j68604835 [label="Abrir feridas cicatrizadas é perigoso. Você pode se livrar de uma infecção… ou sangrar sem parar",shape=box,color=red];
		j68604835 -> j2952898253;
	j3348987408 [label="Vocês… nós todos temos uma coisa em comum. Em algum momento, fomos deixados pra trás pelo Entrati",shape=box,color=red];
		j3348987408 -> j2515192195;
	j3355849354 [label="Como vai seu progresso na resolução de conflitos internos?",shape=box,color=blue];
		j3355849354 -> j1204768946;
		j3355849354 -> j374761143;
		j3355849354 -> j975254917;
		j3355849354 -> j17348121;
	j3929162594 [label="Par les Luminários… quer dizer que estamos todos aqui em segredo?! É por isso que não temos permissão para sair?! Pourquoi?!",shape=box,color=blue];
		j3929162594 -> j3390218054;
	j1299400733 [label="Oui! Hahaha! Eles são tão persistentes em trocar os móveis de lugar, non? Mas eu percebi que, se você muda as coisas de lugar… eles fazem a mesma coisa.",shape=box,color=blue];
		j1299400733 -> j941286646;
