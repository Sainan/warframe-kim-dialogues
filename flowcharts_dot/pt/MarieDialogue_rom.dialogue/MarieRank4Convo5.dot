	1658 [label="Estou bem ciente de nossas divergências não resolvidas em relação ao Cardinal. Estou tentando manter esta conversa civilisée.",shape=box,color=blue];
		1658 -> 1680;
	1661 [label="Entendo que você não queira discutir a resolução de conflitos sem aproveitar a oportunidade para apontar o dedo para aqueles que considera responsáveis.",shape=box,color=blue];
		1661 -> 1680;
	1657 [label="Sim! Como você gosta de me lembrar com frequência, você o considera um monstro! Com nada além de rancor e vazio no coração!",shape=box,color=blue];
