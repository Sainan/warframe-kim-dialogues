	1710 [label="Embora eu possa ver a lógica por trás da decisão de protegê-los da dor que le Cardeal causou com sua partida necessária…",shape=box,color=blue];
		1710 -> 1715;
	1711 [label="Oui… entendo sua lógica. Se puder, seria melhor focar em resolver os problemas familiares primeiro, né? Me parece a única esperança que qualquer um de nós tem para sair daqui",shape=box,color=blue];
		1711 -> 1716;
