	j935024479 [label="Bem, de forma resumida, alguns dos familiares do Entrati tão lá em cima e não sabem que a gente tá aqui embaixo…",shape=box,color=red];
		j935024479 -> j73961307;
	j304097996 [label="Oui! Os pequenos robôs voadores. Os necra… necra… como se chamam?",shape=box,color=blue];
