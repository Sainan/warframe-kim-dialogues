	1737 [label="+15 Chemistry",color=orange];
		1737 -> 1741;
	1738 [label="Non! Ele é um mentiroso, um manipulador, ele só faria isso em troca de alguma coisa!",shape=box,color=blue];
		1738 -> 1742;
	1739 [label="A situação lá em cima é… bem frágil. Não quero causar mais problemas",shape=box,color=red];
		1739 -> 1743;
