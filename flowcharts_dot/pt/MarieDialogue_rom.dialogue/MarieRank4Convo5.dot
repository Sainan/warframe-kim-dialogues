		1667 -> 1666;
	1666 [label="E mesmo sabendo que os outros são rápidos em culpá-lo, eu não quero nos ver divididos e sangrando quando poderíamos estar inteiros.",shape=box,color=blue];
		1666 -> 1685;
	1675 [label="Oui, mas estou aprendendo, assim como aconteceu com o Monsieur Tagfer, que talvez nem todos no mesmo grau.",shape=box,color=blue];
		1675 -> 1686;
	1669 [label="E estou aprendendo que nem todos no mesmo grau, como você foi tão \"gentil\" em apontar, non?",shape=box,color=blue];
		1669 -> 1680;
	1670 [label="Oui, sim! Embora eu não culpe le Cardinal por ter ido embora, pois seu trabalho é sagrado…",shape=box,color=blue];
		1670 -> 1666;
	1671 [label="E sei que você acredita que le Cardinal é algum tipo de monstro terrível por causar essas feridas.",shape=box,color=blue];
		1671 -> 1680;
	1672 [label="Sei que você está do meu lado nesta guerra pela alma do Cardinal e serei eternamente grata por isso.",shape=box,color=blue];
