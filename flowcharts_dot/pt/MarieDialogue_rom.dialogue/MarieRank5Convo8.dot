		j520518461 -> j1007976309 [label="RoatheVillain",color=purple];
		j520518461 -> j2853921294 [label="false",color=purple];
	j3528325295 [label="Oui, qu'est-ce qu'il y a?",shape=box,color=blue];
		j3528325295 -> j3050899225;
	"Chat ends." [color=orange];
	j982817922 [label="Receio que agora devo chamá-lo de \"nosso\" diabo, non? Porque ele não vai embora tão cedo. Ha!",shape=box,color=blue];
		j982817922 -> j1510154760;
	j193211819 [label="Sinto que deveria ser eu a fazer essa pergunta, non? É você quem anda sempre com ele agora!",shape=box,color=blue];
		j193211819 -> j3690885645;
	j634551030 [label="Não sei como você conseguiu. Mas ele nos contou a verdade sobre ter tomado o soro.",shape=box,color=blue];
		j634551030 -> j555197883;
	j1007976309 [label="Não sei como você conseguiu. Mas ele nos contou a verdade sobre ter tomado o soro.",shape=box,color=blue];
	j2853921294 [label="Me preocupo com ele. Acho que ele está sofrendo mais do que demonstra, n'est-ce pas?",shape=box,color=blue];
		j2853921294 -> j2051496565;
	j3050899225 [label="Desculpa se parece que estou dizendo isso do nada, mas não sabia como te contar antes",shape=box,color=red];
		j3050899225 -> j3863749763;
	j1510154760 [label="Você foi muito bem ao conseguir a ajuda dele com o Monsieur Loid. Não achava que isso fosse possível.",shape=box,color=blue];
		j1510154760 -> j893386604;
	j3690885645 [label="Estou resistindo à tentação de lhe perguntar toutes sortes de commérages.",shape=box,color=blue];
		j3690885645 -> j893386604;
	j555197883 [label="Oh, Sol, fiquei com o coração partido. Sua voz não vacilou quando ele falou. Mais je l'ai vu dans ses yeux.",shape=box,color=blue];
		j555197883 -> j893386604;
	j2051496565 [label="Me parte o coração. Espero que o dele não se despedace em seu peito algum dia. Não sei se ele sobreviverá. Não sei se algum de nós sobreviverá.",shape=box,color=blue];
		j2051496565 -> "Chat ends.";
	j3863749763 [label="Eu te adoro… simplesmente te adoro",shape=box,color=red];
		j3863749763 -> j1841389755;
	j893386604 [label="Notei uma mudança nele. Bem sútil, mas está lá. ",shape=box,color=blue];
		j893386604 -> j3360409276;
	j1841389755 [label="Bom, eu andei pensando e… queria saber se você aceita… namorar comigo?",shape=box,color=red];
		j1841389755 -> j2298753926;
	j3360409276 [label="+5 Chemistry",color=orange];
		j3360409276 -> j2302951782;
	j2298753926 [label="Evaluate expressions",color=orange];
		j2298753926 -> j4227997604 [label="MarieNoDate",color=purple];
		j2298753926 -> j3643402020 [label="MarieWillDate",color=purple];
		j2298753926 -> j4227997604 [label="false",color=purple];
	j2302951782 [label="Sei que devemos agradecer a você por isso.",shape=box,color=blue];
		j2302951782 -> j4226270108;
	j4227997604 [label="Oh! Oh, Peregrino. Não sei como dizer isso, então vou simplesmente ser bem direta. ",shape=box,color=blue];
		j4227997604 -> j617350017;
	j3643402020 [label="Ah, eu sinto o mesmo! Mais je ne sais pas comment te l'écrire, je n'ose pas taper les mots! Me considerava uma tola só de pensar nisso!",shape=box,color=blue];
		j3643402020 -> j3274562033;
	j4226270108 [label="Não sei se ele aceitará, mas sempre terá minha amizade.",shape=box,color=blue];
		j4226270108 -> j3032231495;
	j617350017 [label="Non.",shape=box,color=blue];
		j617350017 -> "Chat ends.";
	j3274562033 [label="Ah! Você me deixou tão feliz!",shape=box,color=blue];
		j3274562033 -> j3528645404;
	j3032231495 [label="Embora eu ache que nunca me cansarei de gritar com ele!",shape=box,color=blue];
		j3032231495 -> j781264251;
		j3032231495 -> j3799130893;
	j3528645404 [label="Se você está perguntando se aceito um relacionamento mais… formal, então oui! Oui! Eu adoraria.",shape=box,color=blue];
		j3528645404 -> j411965644;
		j3528645404 -> j3470782915;
	j781264251 [label="Acho que ele gosta muito de te provocar, de qualquer forma",shape=box,color=red];
		j781264251 -> j1787974520;
	j3799130893 [label="Fico feliz que vocês tenham encontrado uma certa conexão",shape=box,color=red];
		j3799130893 -> j1960714805;
	j411965644 [label="Definitivamente não é um pedido de casamento… ainda não ",shape=box,color=red];
		j411965644 -> j606333196;
	j3470782915 [label="As coisas definitivamente evoluíram um pouco. Não diria que são mais \"formais\", mas com certeza posso te mostrar",shape=box,color=red];
		j3470782915 -> j3029174833;
	j1787974520 [label="Comme un gros chat de gouttière. Já me acostumei com ele.",shape=box,color=blue];
		j1787974520 -> j3070872031;
	j1960714805 [label="Oui! Eu também. Ele fica um pouco menos insuportável a cada dia.",shape=box,color=blue];
		j1960714805 -> j1787974520;
	j606333196 [label="Não se preocupe, estou só brincando. Mas, de qualquer forma, je suis ravie! E mal posso esperar para descobrir esses novos… costumes românticos.",shape=box,color=blue];
		j606333196 -> j475982625;
	j3029174833 [label="Hah! Eu sei quando você está aprontando. Bom, estou ansiosa por isso.",shape=box,color=blue];
		j3029174833 -> j475982625;
	j3070872031 [label="Acho que ficaria triste se ele se fosse.",shape=box,color=blue];
		j3070872031 -> "Chat ends.";
	j475982625 [label="+10 Chemistry",color=orange];
		j475982625 -> j38371234;
	j38371234 [label="Até lá? À la revoyure, mon cœur.",shape=box,color=blue];
		j38371234 -> j1559150062;
	j1559150062 [label="Boolean MarieDating is now true.",color=orange];
