digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo1 begins." [color=orange];
		"MarieRank1Convo1 begins." -> j2107406056;
	j2107406056 [label="Bonjour, bonjour, Peregrino! Como tá nesse belo dia? Ou noite? Realmente não sei que horas são nesse lugar…",shape=box,color=blue];
		j2107406056 -> j2133906698;
	j2133906698 [label="Tenho certeza de que um desses bibelôs que o Monsieur Loid guarda é um relógio, mas só não consigo dizer qual.",shape=box,color=blue];
		j2133906698 -> j2001562317;
	j2001562317 [label="Tenho medo de encostar em qualquer dispositivo desse Sanctum estranho. Francamente, acho que tem a mesma chance de me lançar para um tempo distante quanto de esquentar uma xícara de chá.",shape=box,color=blue];
		j2001562317 -> j4057497707;
		j2001562317 -> j692186425;
		j2001562317 -> j17348121;
	j4057497707 [label="De fato, melhor não apertar nenhum botão desconhecido por aí",shape=box,color=red];
		j4057497707 -> j3960549258;
	j692186425 [label="Ah relaxa, você vai sobreviver",shape=box,color=red];
		j692186425 -> j3328144108;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j3960549258 [label="Um conselho ótimo, de fato. Ouvi do Monsieur Loid que você já teve sua própria aventure temporelle. Eu só imagino…",shape=box,color=blue];
		j3960549258 -> j2789011650;
	j3328144108 [label="C'est très gentil… só que não foi você quem foi jogado em outro… ah, sim, claro!",shape=box,color=blue];
		j3328144108 -> j61741650;
	"Chat ends." [color=orange];
	j2789011650 [label="Ela foi tão perigosa quanto essa?",shape=box,color=blue];
		j2789011650 -> j1011395496;
		j2789011650 -> j619052245;
	j61741650 [label="Você sabe como é, né? Me perdoe. Sua aventura pessoal foi tão perigosa quanto esta aqui?",shape=box,color=blue];
		j61741650 -> j1011395496;
		j61741650 -> j619052245;
	j1011395496 [label="A época em si? Ou a minha estadia por lá?",shape=box,color=red];
		j1011395496 -> j3069078422;
	j619052245 [label="Foi diferente, mas prometo que você está segura aqui",shape=box,color=red];
		j619052245 -> j2154771597;
	j3069078422 [label="+10 Chemistry",color=orange];
		j3069078422 -> j3996464228;
	j2154771597 [label="Agradeço muito seu voto de confiança, mas não compartilho tal sentimento. Principalmente quando tenho tanta dificuldade em simplesmente discernir as horas",shape=box,color=blue];
		j2154771597 -> j1383510391;
	j3996464228 [label="É bom fazer tal distinção, duvido muito que sua experiência com o passado tenha sido \"normal\" pelos padrões. Pelo que sei, duvido demasiadamente",shape=box,color=blue];
		j3996464228 -> j3536997626;
	j1383510391 [label="Seria de se esperar que houvesse um relógio no canto desta… \"tela\" aqui, mas não tem! Mauvaise qualité, na minha opinião!",shape=box,color=blue];
		j1383510391 -> j4086217697;
	j3536997626 [label="Me referia à \"época\" mesmo. Permita-me reformular:",shape=box,color=blue];
		j3536997626 -> j4244964073;
	j4086217697 [label="Mas enfim, já fugimos demais da minha questão inicial!",shape=box,color=blue];
		j4086217697 -> j4244964073;
	j4244964073 [label="Essa época \"passada\" para a qual você viajou, que de fato está muito mais próxima do \"passado do passado\" (do qual eu venho), era tão perniciosa quanto esta em que nos encontramos atualmente?",shape=box,color=blue];
		j4244964073 -> j2684584812;
	j2684584812 [label="(Nossa, adoro! É tão mais interessante do que ficar limpando utensílios da comunhão)",shape=box,color=blue];
		j2684584812 -> j865914097;
		j2684584812 -> j3857904891;
		j2684584812 -> j2977808816;
		j2684584812 -> j2733257687;
	j865914097 [label="Acho que a gente tá meio que na mesma. As armas e os inimigos são diferentes, mas guerra é guerra… e morte é morte",shape=box,color=red];
		j865914097 -> j591438125;
	j3857904891 [label="Acho que as coisas tão mais tranquilas. A gente tem mais capacidade de lidar com os desafios aqui. Lá, eles só tão engatinhando ainda",shape=box,color=red];
		j3857904891 -> j814009747;
	j2977808816 [label="Acho que os dias de hoje tão piores. Mesmo com a Infestação em comum, o pessoal de lá tava lidando com armas bem mais rudimentares",shape=box,color=red];
		j2977808816 -> j814009747;
	j2733257687 [label="Sinceramente, fico bem feliz que você tá se divertindo. É muita coisa pra se adaptar de uma vez",shape=box,color=red];
		j2733257687 -> j3526572090;
	j591438125 [label="+5 Chemistry",color=orange];
		j591438125 -> j4109305938;
	j814009747 [label="Você pode ter razão… vou pensar no assunto, obrigada",shape=box,color=blue];
		j814009747 -> "Chat ends.";
	j3526572090 [label="+5 Chemistry",color=orange];
		j3526572090 -> j1131135885;
	j4109305938 [label="Como todas as coisas, suponho que é relativo, né? O predador que nos mata agora é tão mortal quanto aquele que nos caçava no passado. A única diferença é que o de hoje tem os dentes mais afiados",shape=box,color=blue];
		j4109305938 -> j2249986837;
		j4109305938 -> j3796377072;
	j1131135885 [label="Fui preparada para isso pelo Cardeal Dimanche, o seu Albrecht Entrati. Ao contrário do meu querido Lyon, acreditei cegamente nas palavras deles. E, ao contrário do Lyon, vejo isso como nossa grande aventura, e não como um fardo.",shape=box,color=blue];
		j1131135885 -> j1916882445;
	j2249986837 [label="A menos que você seja um Orokin que encontrou uma maneira de evitar a morte, na teoria e na prática…",shape=box,color=red];
		j2249986837 -> j480103911;
	j3796377072 [label="Também fico feliz que você tá se adaptando bem ao futuro",shape=box,color=red];
		j3796377072 -> j933551523;
	j1916882445 [label="Servir aos Luminários nem sempre precisa ser um ato de sofrimento. Nisso, sempre fomos diferentes.",shape=box,color=blue];
		j1916882445 -> j3935378316;
	j480103911 [label="E acredito que o diabo é um exemplo perfeito do motivo pelo qual a morte é o maior presente que Lua já nos deu.",shape=box,color=blue];
		j480103911 -> j1864060724;
	j933551523 [label="+5 Chemistry",color=orange];
		j933551523 -> j2030880217;
	j3935378316 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j3935378316 -> j3080866345;
	j1864060724 [label="Boolean MarieRoathe1 is now true.",color=orange];
		j1864060724 -> j3670942739;
	j2030880217 [label="Fui preparada para isso pelo Cardeal Dimanche, o seu Albrecht Entrati. Ao contrário do meu querido Lyon, acreditei cegamente nas palavras deles. E, ao contrário do Lyon, vejo isso como nossa grande aventura, e não como um fardo.",shape=box,color=blue];
		j2030880217 -> j3056471999;
	j3080866345 [label="E não fuja da minha pergunta! Qual época você acha que é mais perigosa?",shape=box,color=blue];
		j3080866345 -> j841034088;
		j3080866345 -> j99242119;
		j3080866345 -> j482981352;
	j3670942739 [label="Ah! Esse sim é o som de um relógio que reconheço, embora ainda não consiga identificar aonde a maldita coisa está. De qualquer forma, receio que preciso partir. Isso foi maravilhoso. Até nosso próximo \"encontro\"! Aux Dieux!",shape=box,color=blue];
		j3670942739 -> "Chat ends.";
	j3056471999 [label="Servir aos Luminários nem sempre precisa ser um ato de sofrimento. Nisso, sempre fomos diferentes.",shape=box,color=blue];
		j3056471999 -> j1931077347;
	j841034088 [label="Acredito que os dias de hoje são piores. Já viu o tanto de gente cabulosa que tem tentando matar a gente por aqui?",shape=box,color=red];
		j841034088 -> j621308515;
	j99242119 [label="Acredito que os dias de hoje tão mais de boa. No passado, eles ainda tão descobrindo novas formas de se matar. Nossos métodos são só um pouco mais interessantes visualmente",shape=box,color=red];
		j99242119 -> j621308515;
	j482981352 [label="Acho que, no fim das contas, é tudo a mesma coisa. Morte é morte, né?",shape=box,color=red];
		j482981352 -> j3961993343;
	j1931077347 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j1931077347 -> j3670942739;
	j621308515 [label="Você pode ter razão… vou pensar no assunto, obrigada.",shape=box,color=blue];
		j621308515 -> "Chat ends.";
	j3961993343 [label="+5 Chemistry",color=orange];
		j3961993343 -> j3858689493;
	j3858689493 [label="Como todas as coisas, suponho que é relativo, né? O predador que nos mata agora é tão mortal quanto aquele que nos caçava no passado. A única diferença é que o de hoje tem os dentes mais afiados",shape=box,color=blue];
		j3858689493 -> j1735698122;
		j3858689493 -> j2249986837;
	j1735698122 [label="Sendo alguém que tenta se defender do lobo, já até cansei de lidar com isso",shape=box,color=red];
		j1735698122 -> j362619665;
	j362619665 [label="Acho que você, meu caro Peregrino, é mais propenso a fugir para se juntar à matilha do que ficar contra ela. E digo isso como um elogio.",shape=box,color=blue];
		j362619665 -> j3670942739;
}