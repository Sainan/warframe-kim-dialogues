digraph {
	0 [label="MarieRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Bonjour, bonjour, Peregrino! Como tá nesse belo dia? Ou noite? Realmente não sei que horas são nesse lugar…",shape=box,color=blue];
		1 -> 2;
	2 [label="Tenho certeza de que um desses bibelôs que o Monsieur Loid guarda é um relógio, mas só não consigo dizer qual.",shape=box,color=blue];
		2 -> 3;
	3 [label="Tenho medo de encostar em qualquer dispositivo desse Sanctum estranho. Francamente, acho que tem a mesma chance de me lançar para um tempo distante quanto de esquentar uma xícara de chá.",shape=box,color=blue];
		3 -> 5;
		3 -> 6;
		3 -> 4;
	5 [label="De fato, melhor não apertar nenhum botão desconhecido por aí",shape=box,color=red];
		5 -> 8;
	6 [label="Ah relaxa, você vai sobreviver",shape=box,color=red];
		6 -> 9;
	4 [label="[Encerrar Conversa]",shape=box,color=red];
		4 -> 7;
	8 [label="Um conselho ótimo, de fato. Ouvi do Monsieur Loid que você já teve sua própria aventure temporelle. Eu só imagino…",shape=box,color=blue];
		8 -> 10;
	9 [label="C'est très gentil… só que não foi você quem foi jogado em outro… ah, sim, claro!",shape=box,color=blue];
		9 -> 11;
	7 [label="Chat ends.",color=orange];
	10 [label="Ela foi tão perigosa quanto essa?",shape=box,color=blue];
		10 -> 12;
		10 -> 13;
	11 [label="Você sabe como é, né? Me perdoe. Sua aventura pessoal foi tão perigosa quanto esta aqui?",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="A época em si? Ou a minha estadia por lá?",shape=box,color=red];
		12 -> 14;
	13 [label="Foi diferente, mas prometo que você está segura aqui",shape=box,color=red];
		13 -> 15;
	14 [label="+10 Chemistry",color=orange];
		14 -> 16;
	15 [label="Agradeço muito seu voto de confiança, mas não compartilho tal sentimento. Principalmente quando tenho tanta dificuldade em simplesmente discernir as horas",shape=box,color=blue];
		15 -> 17;
	16 [label="É bom fazer tal distinção, duvido muito que sua experiência com o passado tenha sido \"normal\" pelos padrões. Pelo que sei, duvido demasiadamente",shape=box,color=blue];
		16 -> 18;
	17 [label="Seria de se esperar que houvesse um relógio no canto desta… \"tela\" aqui, mas não tem! Mauvaise qualité, na minha opinião!",shape=box,color=blue];
		17 -> 19;
	18 [label="Me referia à \"época\" mesmo. Permita-me reformular:",shape=box,color=blue];
		18 -> 20;
	19 [label="Mas enfim, já fugimos demais da minha questão inicial!",shape=box,color=blue];
		19 -> 20;
	20 [label="Essa época \"passada\" para a qual você viajou, que de fato está muito mais próxima do \"passado do passado\" (do qual eu venho), era tão perniciosa quanto esta em que nos encontramos atualmente?",shape=box,color=blue];
		20 -> 21;
	21 [label="(Nossa, adoro! É tão mais interessante do que ficar limpando utensílios da comunhão)",shape=box,color=blue];
		21 -> 22;
		21 -> 23;
		21 -> 24;
		21 -> 25;
	22 [label="Acho que a gente tá meio que na mesma. As armas e os inimigos são diferentes, mas guerra é guerra… e morte é morte",shape=box,color=red];
		22 -> 26;
	23 [label="Acho que as coisas tão mais tranquilas. A gente tem mais capacidade de lidar com os desafios aqui. Lá, eles só tão engatinhando ainda",shape=box,color=red];
		23 -> 27;
	24 [label="Acho que os dias de hoje tão piores. Mesmo com a Infestação em comum, o pessoal de lá tava lidando com armas bem mais rudimentares",shape=box,color=red];
		24 -> 27;
	25 [label="Sinceramente, fico bem feliz que você tá se divertindo. É muita coisa pra se adaptar de uma vez",shape=box,color=red];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="Você pode ter razão… vou pensar no assunto, obrigada",shape=box,color=blue];
		27 -> 30;
	28 [label="+5 Chemistry",color=orange];
		28 -> 31;
	29 [label="Como todas as coisas, suponho que é relativo, né? O predador que nos mata agora é tão mortal quanto aquele que nos caçava no passado. A única diferença é que o de hoje tem os dentes mais afiados",shape=box,color=blue];
		29 -> 32;
		29 -> 33;
	30 [label="Chat ends.",color=orange];
	31 [label="Fui preparada para isso pelo Cardeal Dimanche, o seu Albrecht Entrati. Ao contrário do meu querido Lyon, acreditei cegamente nas palavras deles. E, ao contrário do Lyon, vejo isso como nossa grande aventura, e não como um fardo.",shape=box,color=blue];
		31 -> 34;
	32 [label="A menos que você seja um Orokin que encontrou uma maneira de evitar a morte, na teoria e na prática…",shape=box,color=red];
		32 -> 35;
	33 [label="Também fico feliz que você tá se adaptando bem ao futuro",shape=box,color=red];
		33 -> 36;
	34 [label="Servir aos Luminários nem sempre precisa ser um ato de sofrimento. Nisso, sempre fomos diferentes.",shape=box,color=blue];
		34 -> 37;
	35 [label="E acredito que o diabo é um exemplo perfeito do motivo pelo qual a morte é o maior presente que Lua já nos deu.",shape=box,color=blue];
		35 -> 38;
	36 [label="+5 Chemistry",color=orange];
		36 -> 39;
	37 [label="Update boolean MarieLyonSuffering1",color=orange];
		37 -> 40;
	38 [label="Update boolean MarieRoathe1",color=orange];
		38 -> 41;
	39 [label="Fui preparada para isso pelo Cardeal Dimanche, o seu Albrecht Entrati. Ao contrário do meu querido Lyon, acreditei cegamente nas palavras deles. E, ao contrário do Lyon, vejo isso como nossa grande aventura, e não como um fardo.",shape=box,color=blue];
		39 -> 42;
	40 [label="E não fuja da minha pergunta! Qual época você acha que é mais perigosa?",shape=box,color=blue];
		40 -> 43;
		40 -> 44;
		40 -> 45;
	41 [label="Ah! Esse sim é o som de um relógio que reconheço, embora ainda não consiga identificar aonde a maldita coisa está. De qualquer forma, receio que preciso partir. Isso foi maravilhoso. Até nosso próximo \"encontro\"! Aux Dieux!",shape=box,color=blue];
		41 -> 46;
	42 [label="Servir aos Luminários nem sempre precisa ser um ato de sofrimento. Nisso, sempre fomos diferentes.",shape=box,color=blue];
		42 -> 47;
	43 [label="Acredito que os dias de hoje são piores. Já viu o tanto de gente cabulosa que tem tentando matar a gente por aqui?",shape=box,color=red];
		43 -> 48;
	44 [label="Acredito que os dias de hoje tão mais de boa. No passado, eles ainda tão descobrindo novas formas de se matar. Nossos métodos são só um pouco mais interessantes visualmente",shape=box,color=red];
		44 -> 48;
	45 [label="Acho que, no fim das contas, é tudo a mesma coisa. Morte é morte, né?",shape=box,color=red];
		45 -> 49;
	46 [label="Chat ends.",color=orange];
	47 [label="Update boolean MarieLyonSuffering1",color=orange];
		47 -> 41;
	48 [label="Você pode ter razão… vou pensar no assunto, obrigada.",shape=box,color=blue];
		48 -> 50;
	49 [label="+5 Chemistry",color=orange];
		49 -> 51;
	50 [label="Chat ends.",color=orange];
	51 [label="Como todas as coisas, suponho que é relativo, né? O predador que nos mata agora é tão mortal quanto aquele que nos caçava no passado. A única diferença é que o de hoje tem os dentes mais afiados",shape=box,color=blue];
		51 -> 52;
		51 -> 53;
	52 [label="Sendo alguém que tenta se defender do lobo, já até cansei de lidar com isso",shape=box,color=red];
		52 -> 54;
	53 [label="A menos que você seja um Orokin que encontrou uma maneira de evitar a morte, na teoria e na prática…",shape=box,color=red];
		53 -> 55;
	54 [label="Acho que você, meu caro Peregrino, é mais propenso a fugir para se juntar à matilha do que ficar contra ela. E digo isso como um elogio.",shape=box,color=blue];
		54 -> 41;
	55 [label="E acredito que o diabo é um exemplo perfeito do motivo pelo qual a morte é o maior presente que Lua já nos deu.",shape=box,color=blue];
		55 -> 56;
	56 [label="Update boolean MarieRoathe1",color=orange];
		56 -> 41;
}