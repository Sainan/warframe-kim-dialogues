		j3255816954 -> "Chat ends." [label="false",color=purple];
	j4004997204 [label="Peregrino, excusez-moi… você realmente acredita ser sensato auxiliar o diabo?",shape=box,color=blue];
		j4004997204 -> j125358642;
	"Chat ends." [color=orange];
	j125358642 [label="Não desejo afastar aqueles que buscam absolvição ou ajuda, mas… não creio que seja isso que o diabo busca.",shape=box,color=blue];
		j125358642 -> j1969589267;
		j125358642 -> j918032974;
		j125358642 -> j2128138535;
		j125358642 -> j17348121;
	j1969589267 [label="E qual você acha que é o objetivo real dele?",shape=box,color=red];
		j1969589267 -> j3003306518;
	j918032974 [label="Sei que vocês dois não se dão bem, sinto muito por isso, mas… não tenho como expulsar ele daqui",shape=box,color=red];
		j918032974 -> j1330835469;
	j2128138535 [label="Só o que o Roathe já esqueceu sobre os Orokin é muito mais do que tudo que a gente sabe até hoje, a gente precisa dele",shape=box,color=red];
		j2128138535 -> j2220913301;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j3003306518 [label="Ele é um animal selvagem. Ele pode se aproximar quando você oferece comida e um lugar quentinho para ficar, mas tudo isso desaparecerá no momento em que você não for mais útil para ele.",shape=box,color=blue];
		j3003306518 -> j2448657404;
	j1330835469 [label="Add 1 to Thermostat counter",color=orange];
		j1330835469 -> j4056413664;
	j2220913301 [label="Add -1 to Thermostat counter",color=orange];
		j2220913301 -> j3003306518;
	j2448657404 [label="Ele precisa de algo de você… de todos nós. ",shape=box,color=blue];
		j2448657404 -> j863296879;
	j4056413664 [label="Eu sei, não estou sugerindo que você faça isso. Só afirmo que… ele não é confiável. Nem agora, nem nunca.",shape=box,color=blue];
		j4056413664 -> j3003306518;
	j863296879 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j863296879 -> j4093421340 [label="x > 5",color=purple];
		j863296879 -> j3161239207 [label="x <= 5",color=purple];
		j863296879 -> j3161239207 [label="false",color=purple];
	j4093421340 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4093421340 -> j2355751056 [label="x >= 21",color=purple];
		j4093421340 -> j807299567 [label="x < 21",color=purple];
		j4093421340 -> j807299567 [label="false",color=purple];
	j3161239207 [label="Essas memórias perdidas dele, esses horrores passados de Tau… me preocupo com o que isso esconde.",shape=box,color=blue];
		j3161239207 -> j3228183915;
		j3161239207 -> j370752674;
	j2355751056 [label="Sei que você acha que já descobrimos tudo o que havia para saber dentro da mente destruída dele.",shape=box,color=blue];
		j2355751056 -> j3807191739;
		j2355751056 -> j370752674;
	j807299567 [label="Quanto mais aprendemos, quanto mais nos aprofundamos em sua mente despedaçada… mais preocupada fico. O perigo está se tornando cada vez mais evidente.",shape=box,color=blue];
		j807299567 -> j370752674;
		j807299567 -> j3228183915;
	j3228183915 [label="Duvido que ele vai simplesmente desaparecer no momento em que recuperar as memórias, tem caroço naquele angu ali",shape=box,color=red];
		j3228183915 -> j3624028374;
	j370752674 [label="Acho que tem mais coisa que ele quer recuperar… não só nas memórias dele, mas com a gente",shape=box,color=red];
		j370752674 -> j81373141;
	j3807191739 [label="Eu acredito nele quando ele diz que não tem mais nada pra achar lá. Se esse for o caso mesmo, por que ele ainda tá aqui?",shape=box,color=red];
		j3807191739 -> j3624028374;
	j3624028374 [label="Admito que me preocupo mais com o que ele pretende fazer com esse conhecimento, e não com o conhecimento em si.",shape=box,color=blue];
		j3624028374 -> j1432527344;
	j81373141 [label="Oui! Essa é exatamente a minha preocupação, mas o que poderia ser? Qual o propósito que lhe servimos agora?",shape=box,color=blue];
		j81373141 -> j1432527344;
	j1432527344 [label="Seja lá qual for a intenção dele de conduzir esta nova existência, temo que pretenda nos envolver. E simplesmente desejo que não entremos nisso cegos pela esperança de que ele seja, de alguma forma, um ser benigno.",shape=box,color=blue];
		j1432527344 -> j112764440;
		j1432527344 -> j148884082;
		j1432527344 -> j2568531164;
	j112764440 [label="Concordo contigo, não confio nada nele",shape=box,color=red];
		j112764440 -> j417975205;
	j148884082 [label="Ele é poderoso e sábio, é o tipo de gente que prefiro ver como amigo em vez de inimigo",shape=box,color=red];
		j148884082 -> j3186133199;
	j2568531164 [label="Não adianta ficar pensando se ele vai nos trair. Até agora, ele não traiu a gente, e eu não acuso o povo de pecados que ainda não cometeram",shape=box,color=red];
		j2568531164 -> j3363082577;
	j417975205 [label="+20 Chemistry",color=orange];
		j417975205 -> j888176146;
	j3186133199 [label="Add -1 to Thermostat counter",color=orange];
		j3186133199 -> j3376226554;
	j3363082577 [label="Add 1 to Thermostat counter",color=orange];
		j3363082577 -> j2672994971;
	j888176146 [label="Bien! Pelo menos ficarei em paz sabendo que terei outros olhos observando aquele diabo, talvez me ajude a dormir melhor. Merci.",shape=box,color=blue];
		j888176146 -> j3984234322;
	j3376226554 [label="Sim, mas me pergunto qual será o verdadeiro custo dessa aliança. Você pode não gostar do preço no final.",shape=box,color=blue];
		j3376226554 -> j3346950561;
	j2672994971 [label="Oui… acho que você tem razão. Não podemos ficar nos iludindo, devemos ficar lado a lado com qualquer um que queira combater a Indiferença.",shape=box,color=blue];
		j2672994971 -> j808986917;
	j3984234322 [label="Boolean MarieRoatheNoTrust is now true.",color=orange];
		j3984234322 -> "Chat ends.";
	j3346950561 [label="Só quero aconselhá-lo a ter cuidado… ele é um monstro, vestindo a pele de um cavalheiro. Tenha cuidado com ele, s'il te plaît?",shape=box,color=blue];
		j3346950561 -> j2653810993;
		j3346950561 -> j1130586510;
	j808986917 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j808986917 -> j3390779753 [label=true,color=green];
		j808986917 -> j1994841772 [label=false,color=brown];
	j2653810993 [label="Acho que você tá sendo meio injusta com ele",shape=box,color=red];
		j2653810993 -> j2055971081;
	j1130586510 [label="Pode deixar, vou ficar de olho aberto",shape=box,color=red];
		j1130586510 -> j3886486692;
	j3390779753 [label="Mesmo que você acredite que a força por trás disso não vem de um deus, mas de nossas próprias mentes… ainda assim é uma ameaça grave.",shape=box,color=blue];
		j3390779753 -> j3346950561;
	j1994841772 [label="Mesmo que ele acredite que a força por trás disso não vem de um deus, mas de nossas próprias mentes… ainda assim é uma ameaça grave.",shape=box,color=blue];
		j1994841772 -> j3346950561;
	j2055971081 [label="Add -1 to Thermostat counter",color=orange];
		j2055971081 -> j2373760417;
	j3886486692 [label="+20 Chemistry",color=orange];
		j3886486692 -> j4099559577;
	j2373760417 [label="Oui? Pode se explicar? Não estou brava, só genuinamente curiosa.",shape=box,color=blue];
		j2373760417 -> j3693428267;
		j2373760417 -> j1942540758;
		j2373760417 -> j3564980897;
		j2373760417 -> j2173978675;
	j4099559577 [label="Merci, era tudo o que eu queria.",shape=box,color=blue];
		j4099559577 -> "Chat ends.";
	j3693428267 [label="Ele foi criado em uma sociedade diferente, em uma época diferente e com visões diferentes. A gente pode não gostar dele, mas esse é quem ele é de verdade",shape=box,color=red];
		j3693428267 -> j857148265;
	j1942540758 [label="Você e o Lyon aceitaram o soro de Protoframe do Entrati numa boa. Ele não aceitou nada, foi forçado. Consegue imaginar como é estar nessa situação?",shape=box,color=red];
		j1942540758 -> j4212749613;
		j1942540758 -> j2554205588;
		j1942540758 -> j857148265;
	j3564980897 [label="Ele passou séculos inteiros fazendo o que acreditava ser preciso, só discordamos na parte sobre o que realmente era necessário",shape=box,color=red];
		j3564980897 -> j4212749613;
		j3564980897 -> j3500855574;
	j2173978675 [label="Acho que muito do… comportamento dele… é o que te irrita, e não as ações dele",shape=box,color=red];
		j2173978675 -> j3500855574;
		j2173978675 -> j4212749613;
	j857148265 [label="Ele é um soldado de alta patente e membro da burguesia. E ambas as posições exigem a tomada de decisões \"questionáveis\"",shape=box,color=red];
		j857148265 -> j681163897;
	j4212749613 [label="Acredito fortemente que as pessoas podem acabar fazendo o que consideram \"errado\", mas com boas intenções",shape=box,color=red];
		j4212749613 -> j2652682418;
	j2554205588 [label="Ele fez tudo o que fez em nome da salvação do Império Orokin… e sua recompensa foi ser jogado nessa confusão toda aqui, contra a vontade dele",shape=box,color=red];
		j2554205588 -> j681163897;
	j3500855574 [label="Acho que ele te irrita porque ele tem orgulho do que fez",shape=box,color=red];
		j3500855574 -> j2190684554;
	j681163897 [label="Check boolean MarieGrineer",color=orange];
		j681163897 -> j790885541 [label=true,color=green];
		j681163897 -> j3757926824 [label=false,color=brown];
	j2652682418 [label="Você pode ver ele como um diabo, mas na mente dele, isso é exatamente o oposto da verdade que ele conhece",shape=box,color=red];
		j2652682418 -> j681163897;
	j2190684554 [label="Oui, não gosto daqueles que se deleitam com a morte alheia. E acho a ânsia dele em derramar sangue… alarmante. E o fato de você não achar isso perturbador… é igualmente alarmante.",shape=box,color=blue];
		j2190684554 -> j1793505742;
	j790885541 [label="E acho que aqueles que comandam qualquer um desses \"Corpus\" ou \"Grineer\" que você combate diriam o mesmo, eles não se enxergam como os errados da história.",shape=box,color=blue];
		j790885541 -> j3718175233;
	j3757926824 [label="E acho que aqueles que comandam qualquer um desses \"Corpus\" ou \"Grin-ire\" que você combate diriam o mesmo, eles não se enxergam como os errados da história.",shape=box,color=blue];
		j3757926824 -> j3718175233;
	j1793505742 [label="É muito fácil adaptar o caminho da abnegação ao pecado da violência, rejeitar o horror disso, dizer que isso não tem sentido… tudo em nome do \"que importa\".",shape=box,color=blue];
		j1793505742 -> j79311694;
	j3718175233 [label="Eles acreditam que suas ações são justas, boas e necessárias. Como você tolera alguns diabos e condena outros?",shape=box,color=blue];
		j3718175233 -> j3211402121;
		j3718175233 -> j2010892761;
		j3718175233 -> j3331040730;
		j3718175233 -> j490377297;
	j79311694 [label="Orgulhar-se do ato em si… é demais para mim. Não me deleito quando preciso tirar uma vida, mas ele sim. Então, nesse sentido, somos bem diferentes.",shape=box,color=blue];
		j79311694 -> j2295749205;
	j3211402121 [label="Sempre condeno eles quando fazem coisas erradas… mas luto ao lado deles pela causa certa e quanto é necessário",shape=box,color=red];
		j3211402121 -> j4163583746;
	j2010892761 [label="Não acredito que esses grupos sejam \"do bem\" ou \"do mal\", o que muda isso são as atitudes deles",shape=box,color=red];
		j2010892761 -> j285179459;
	j3331040730 [label="Não cabe a mim dizer o que é \"do bem\" e \"do mal\", eu só faço o que é preciso pra proteger quem precisa de proteção",shape=box,color=red];
		j3331040730 -> j4163583746;
	j490377297 [label="Você tá me pedindo pra julgar um grupo inteiro de pessoas da mesma forma que um indivíduo singular",shape=box,color=red];
		j490377297 -> j285179459;
	j2295749205 [label="Só posso rezar para que não seja tarde demais se o diabo decidir enfiar essa faca nas suas costelas. Não desejo que seus últimos pensamentos sejam: \"bem que a Marie me avisou\".",shape=box,color=blue];
		j2295749205 -> j1957931291;
		j2295749205 -> j3144190363;
	j4163583746 [label="E você acredita que o diabo não é uma ameaça? Que ele não é perigoso para aqueles ao seu redor? Ele pode causar muito estrago.",shape=box,color=blue];
		j4163583746 -> j1379559713;
		j4163583746 -> j4122944484;
	j285179459 [label="E quanto aos atos horríveis que ele cometeu? Toda a morte, toda a matança… essas ações eram justificadas, na sua opinião?",shape=box,color=blue];
		j285179459 -> j4122944484;
	j1957931291 [label="Ele não vai. Se ele tentar, vou impedir isso",shape=box,color=red];
		j1957931291 -> j362324261;
	j3144190363 [label="Prometo que esses não serão meus últimos pensamentos",shape=box,color=red];
		j3144190363 -> j814756208;
	j1379559713 [label="Se ele ficar contra a gente, vou agir contra. Até lá, ele se comportou como aliado… um aliado bem melodramático",shape=box,color=red];
		j1379559713 -> j3109551152;
	j4122944484 [label="Não enxergo o perigo dele como um problema. Ele é uma arma, e armas podem ser usadas tanto pra matar quanto pra proteger",shape=box,color=red];
		j4122944484 -> j3769772863;
	j362324261 [label="Eu te adoro pela sua fé em você mesmo, ainda que lamente que você tenha fé nele. Então, eu também terei fé em você.",shape=box,color=blue];
		j362324261 -> j3664256811;
	j814756208 [label="Acredito que você não quis dizer exatamente o que escreveu, mas não vou dar muita importância para elas agora.",shape=box,color=blue];
		j814756208 -> j3664256811;
	j3109551152 [label="Add 1 to Thermostat counter",color=orange];
		j3109551152 -> j2295749205;
	j3769772863 [label="Add -1 to Thermostat counter",color=orange];
		j3769772863 -> j2295749205;
	j3664256811 [label="Preciso partir. Mas, mais uma vez, peço-lhe: tenha cuidado. Se não por você… por mim, d'accord?",shape=box,color=blue];
		j3664256811 -> j367054140;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
