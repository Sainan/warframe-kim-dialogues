	1863 [label="Sei que você acha que já descobrimos tudo o que havia para saber dentro da mente destruída dele.",shape=box,color=blue];
		1863 -> 1866;
		1863 -> 1861;
	1862 [label="Quanto mais aprendemos, quanto mais nos aprofundamos em sua mente despedaçada… mais preocupada fico. O perigo está se tornando cada vez mais evidente.",shape=box,color=blue];
		1862 -> 1861;
		1862 -> 1860;
	1860 [label="Duvido que ele vai simplesmente desaparecer no momento em que recuperar as memórias, tem caroço naquele angu ali",shape=box,color=red];
		1860 -> 1864;
	1861 [label="Acho que tem mais coisa que ele quer recuperar… não só nas memórias dele, mas com a gente",shape=box,color=red];
		1861 -> 1865;
	1866 [label="Eu acredito nele quando ele diz que não tem mais nada pra achar lá. Se esse for o caso mesmo, por que ele ainda tá aqui?",shape=box,color=red];
		1866 -> 1864;
	1864 [label="Admito que me preocupo mais com o que ele pretende fazer com esse conhecimento, e não com o conhecimento em si.",shape=box,color=blue];
		1864 -> 1867;
	1865 [label="Oui! Essa é exatamente a minha preocupação, mas o que poderia ser? Qual o propósito que lhe servimos agora?",shape=box,color=blue];
		1865 -> 1867;
	1867 [label="Seja lá qual for a intenção dele de conduzir esta nova existência, temo que pretenda nos envolver. E simplesmente desejo que não entremos nisso cegos pela esperança de que ele seja, de alguma forma, um ser benigno.",shape=box,color=blue];
