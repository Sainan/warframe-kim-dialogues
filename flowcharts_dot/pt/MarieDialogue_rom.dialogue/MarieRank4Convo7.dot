		1882 -> 1886;
	1883 [label="Mesmo que você acredite que a força por trás disso não vem de um deus, mas de nossas próprias mentes… ainda assim é uma ameaça grave.",shape=box,color=blue];
		1883 -> 1878;
	1884 [label="Mesmo que ele acredite que a força por trás disso não vem de um deus, mas de nossas próprias mentes… ainda assim é uma ameaça grave.",shape=box,color=blue];
