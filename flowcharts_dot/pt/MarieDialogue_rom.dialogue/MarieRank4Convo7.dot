		1898 -> 1901 [label=false,color=brown];
	1899 [label="Você pode ver ele como um diabo, mas na mente dele, isso é exatamente o oposto da verdade que ele conhece",shape=box,color=red];
		1899 -> 1898;
	1900 [label="Oui, não gosto daqueles que se deleitam com a morte alheia. E acho a ânsia dele em derramar sangue… alarmante. E o fato de você não achar isso perturbador… é igualmente alarmante.",shape=box,color=blue];
		1900 -> 1903;
	1902 [label="E acho que aqueles que comandam qualquer um desses \"Corpus\" ou \"Grineer\" que você combate diriam o mesmo, eles não se enxergam como os errados da história.",shape=box,color=blue];
		1902 -> 1904;
	1901 [label="E acho que aqueles que comandam qualquer um desses \"Corpus\" ou \"Grin-ire\" que você combate diriam o mesmo, eles não se enxergam como os errados da história.",shape=box,color=blue];
		1901 -> 1904;
	1903 [label="É muito fácil adaptar o caminho da abnegação ao pecado da violência, rejeitar o horror disso, dizer que isso não tem sentido… tudo em nome do \"que importa\".",shape=box,color=blue];
		1903 -> 1905;
	1904 [label="Eles acreditam que suas ações são justas, boas e necessárias. Como você tolera alguns diabos e condena outros?",shape=box,color=blue];
		1904 -> 1906;
		1904 -> 1907;
		1904 -> 1908;
		1904 -> 1909;
	1905 [label="Orgulhar-se do ato em si… é demais para mim. Não me deleito quando preciso tirar uma vida, mas ele sim. Então, nesse sentido, somos bem diferentes.",shape=box,color=blue];
		1905 -> 1910;
	1906 [label="Sempre condeno eles quando fazem coisas erradas… mas luto ao lado deles pela causa certa e quanto é necessário",shape=box,color=red];
		1906 -> 1911;
	1907 [label="Não acredito que esses grupos sejam \"do bem\" ou \"do mal\", o que muda isso são as atitudes deles",shape=box,color=red];
		1907 -> 1912;
	1908 [label="Não cabe a mim dizer o que é \"do bem\" e \"do mal\", eu só faço o que é preciso pra proteger quem precisa de proteção",shape=box,color=red];
		1908 -> 1911;
	1909 [label="Você tá me pedindo pra julgar um grupo inteiro de pessoas da mesma forma que um indivíduo singular",shape=box,color=red];
		1909 -> 1912;
	1910 [label="Só posso rezar para que não seja tarde demais se o diabo decidir enfiar essa faca nas suas costelas. Não desejo que seus últimos pensamentos sejam: \"bem que a Marie me avisou\".",shape=box,color=blue];
		1910 -> 1913;
		1910 -> 1914;
	1911 [label="E você acredita que o diabo não é uma ameaça? Que ele não é perigoso para aqueles ao seu redor? Ele pode causar muito estrago.",shape=box,color=blue];
		1911 -> 1915;
		1911 -> 1916;
	1912 [label="E quanto aos atos horríveis que ele cometeu? Toda a morte, toda a matança… essas ações eram justificadas, na sua opinião?",shape=box,color=blue];
		1912 -> 1916;
	1913 [label="Ele não vai. Se ele tentar, vou impedir isso",shape=box,color=red];
		1913 -> 1917;
	1914 [label="Prometo que esses não serão meus últimos pensamentos",shape=box,color=red];
		1914 -> 1918;
	1915 [label="Se ele ficar contra a gente, vou agir contra. Até lá, ele se comportou como aliado… um aliado bem melodramático",shape=box,color=red];
		1915 -> 1919;
	1916 [label="Não enxergo o perigo dele como um problema. Ele é uma arma, e armas podem ser usadas tanto pra matar quanto pra proteger",shape=box,color=red];
		1916 -> 1920;
	1917 [label="Eu te adoro pela sua fé em você mesmo, ainda que lamente que você tenha fé nele. Então, eu também terei fé em você.",shape=box,color=blue];
		1917 -> 1921;
	1918 [label="Acredito que você não quis dizer exatamente o que escreveu, mas não vou dar muita importância para elas agora.",shape=box,color=blue];
