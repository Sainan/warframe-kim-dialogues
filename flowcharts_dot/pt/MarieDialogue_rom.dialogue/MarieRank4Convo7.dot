	1877 [label="Update boolean MarieRoatheNoTrust",color=orange];
		1877 -> 1880;
	1878 [label="Só quero aconselhá-lo a ter cuidado… ele é um monstro, vestindo a pele de um cavalheiro. Tenha cuidado com ele, s'il te plaît?",shape=box,color=blue];
