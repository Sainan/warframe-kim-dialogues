	1873 [label="Add 1 to Thermostat",color=orange];
		1873 -> 1876;
	1874 [label="Bien! Pelo menos ficarei em paz sabendo que terei outros olhos observando aquele diabo, talvez me ajude a dormir melhor. Merci.",shape=box,color=blue];
		1874 -> 1877;
	1875 [label="Sim, mas me pergunto qual será o verdadeiro custo dessa aliança. Você pode não gostar do preço no final.",shape=box,color=blue];
		1875 -> 1878;
	1876 [label="Oui… acho que você tem razão. Não podemos ficar nos iludindo, devemos ficar lado a lado com qualquer um que queira combater a Indiferença.",shape=box,color=blue];
