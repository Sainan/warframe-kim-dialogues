	1893 [label="Chat ends.",color=orange];
	1894 [label="Ele é um soldado de alta patente e membro da burguesia. E ambas as posições exigem a tomada de decisões \"questionáveis\"",shape=box,color=red];
		1894 -> 1898;
	1895 [label="Acredito fortemente que as pessoas podem acabar fazendo o que consideram \"errado\", mas com boas intenções",shape=box,color=red];
		1895 -> 1899;
