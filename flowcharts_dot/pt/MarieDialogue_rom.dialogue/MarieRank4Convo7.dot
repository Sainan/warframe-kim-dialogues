	1889 [label="Ele foi criado em uma sociedade diferente, em uma época diferente e com visões diferentes. A gente pode não gostar dele, mas esse é quem ele é de verdade",shape=box,color=red];
		1889 -> 1894;
	1890 [label="Você e o Lyon aceitaram o soro de Protoframe do Entrati numa boa. Ele não aceitou nada, foi forçado. Consegue imaginar como é estar nessa situação?",shape=box,color=red];
		1890 -> 1895;
		1890 -> 1896;
