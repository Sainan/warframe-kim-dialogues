		j457335464 -> j25363848 [label="false",color=purple];
	j2530377265 [label="Ó, Luminários… que tipo de inferno vocês criaram para ele, para manter sua alma presa nessa gaiola de ciência e luzes cintilantes?",shape=box,color=blue];
		j2530377265 -> j1831275778;
	j2272452019 [label="Só me resta rezar para os Luminários para que você tenha razão e que nada reste dentro daquela casca além de… ciência e luzes cintilantes.",shape=box,color=blue];
		j2272452019 -> j1020036464;
	j2247874714 [label="Sei que você não tem certeza se os Cephalons contêm almas, mas só posso rezar aos Luminários para que… o pobre Otak não esteja sofrendo.",shape=box,color=blue];
		j2247874714 -> j758397577;
	j25363848 [label="Só posso rezar aos Luminários para que tudo o que reste dentro daquela casca seja nada além de… ciência e luzes cintilantes.",shape=box,color=blue];
		j25363848 -> j362981100;
	j1831275778 [label="Por que deixá-lo lá, destruído e esperando até que lhe seja permitido morrer para encontrar a paz? Só me resta rezar… para que, se houver algum tipo de presença ali…",shape=box,color=blue];
		j1831275778 -> j1537640866;
	j1020036464 [label="E que nenhuma alma fique presa dentro dessa coisa quebrada, esperando até que lhe seja permitida finalmente morrer para encontrar a paz.",shape=box,color=blue];
		j1020036464 -> j3781057007;
	j758397577 [label="Que nenhuma alma fique presa dentro dessa coisa quebrada, esperando até que lhe seja permitida finalmente morrer para encontrar a paz.",shape=box,color=blue];
		j758397577 -> j1901074845;
	j362981100 [label="E que nenhuma alma fique presa dentro dessa coisa quebrada, esperando até que lhe seja permitida finalmente morrer para encontrar a paz.",shape=box,color=blue];
		j362981100 -> j1901074845;
	j1537640866 [label="É porque ele permanece por escolha própria numa espécie de vigília solitária…",shape=box,color=blue];
		j1537640866 -> j264606341;
	j3781057007 [label="Porque, se você estiver errado, e uma alma permanecer presa nessa gaiola contra a sua vontade…",shape=box,color=blue];
		j3781057007 -> j2961169475;
	j1901074845 [label="Ou, se existe algum tipo de presença ali, é porque ele permanece por escolha própria, numa espécie de vigília solitária.",shape=box,color=blue];
		j1901074845 -> j264606341;
	j264606341 [label="Pensar o contrário já basta para questionar a bondade dos deuses, non?",shape=box,color=blue];
