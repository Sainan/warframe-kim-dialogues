		j1831844337 -> j1350233930;
	j3468600757 [label="E aqui estou eu, fazendo exatamente isso. Obrigada por me lembrar da minha tolice. Que coisa! Bobinha da Marie. Bem… acho que o aquário do Monsieur Fibonacci precisa de uma boa limpeza.",shape=box,color=blue];
