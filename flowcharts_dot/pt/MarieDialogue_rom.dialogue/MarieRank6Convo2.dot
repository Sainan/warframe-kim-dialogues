		j3668649342 -> j1629806450;
	j1345810576 [label="Merci. Bem, não quero mais ser assim. Vou fazer algo mais alegre! Acho que o aquário do Monsieur Fibonacci precisa de uma limpeza.",shape=box,color=blue];
		j1345810576 -> j2486340526;
	j2418624002 [label="Hahaha! Merci, isso com certeza vai acabar com essas minhas lágrimas bobas. Você sabe como animar a bobinha da Marie, non?",shape=box,color=blue];
		j2418624002 -> j2197832414;
		j2418624002 -> j1831844337;
	j1629806450 [label="Oui, você tem toda a razão. O mundo está cheio de histórias como a do Monsieur Otak, e muitas piores que a dele. Eu não deveria chorar por uma só. ",shape=box,color=blue];
