	j3655033167 [label="Você gostou de conversar com ele?",shape=box,color=red];
		j3655033167 -> j2147252074;
	j4063768550 [label="Como foi sua conversa com ele?",shape=box,color=red];
		j4063768550 -> j3144366656;
	j2774372427 [label="Coitado do Otak… como foi?",shape=box,color=red];
		j2774372427 -> j982193646;
	j2640737838 [label="Que bom que vocês finalmente se conheceram. O Otak é… complicado de explicar",shape=box,color=red];
		j2640737838 -> j934997541;
	j3021841983 [label="Você conheceu o Otak? Vish… como foi?",shape=box,color=red];
		j3021841983 -> j1158048844;
	j2147252074 [label="Sim… embora talvez eu quisesse chorar por isso. Pois ele se apresentou para mim 3 vezes na mesma conversa, como se nunca tivéssemos sido apresentados.",shape=box,color=blue];
		j2147252074 -> j4225230197;
	j3144366656 [label="Ele… se apresentou para mim 3 vezes na mesma conversa, como se nunca tivéssemos sido apresentados.",shape=box,color=blue];
		j3144366656 -> j4225230197;
	j982193646 [label="Achei-o simplesmente adorável e encantador! Mas, por trás de uma camada de humor, eu sentia uma grande tristeza.",shape=box,color=blue];
		j982193646 -> j3081994153;
	j934997541 [label="É, acho que sim. Um rabisco de criança escrito nas costas de um autômato… achei-o simplesmente adorável e encantador!",shape=box,color=blue];
		j934997541 -> j917745949;
	j1158048844 [label="Por que você parece tão insatisfeito por eu tê-lo conhecido?",shape=box,color=blue];
		j1158048844 -> j4127236790;
		j1158048844 -> j3015978982;
		j1158048844 -> j1405914971;
	j4225230197 [label="Ele me cumprimentou da mesma maneira alegre e inabalável das vezes anteriores. Mas ele sabia que eu era uma Sœur de Sol! ",shape=box,color=blue];
		j4225230197 -> j3057038318;
	j3081994153 [label="Poderia me contar a história do pobre Monsieur Otak?",shape=box,color=blue];
		j3081994153 -> j4050724025;
	j917745949 [label="Mas por trás do humor, esconde-se uma grande tristeza.",shape=box,color=blue];
		j917745949 -> j3081994153;
	j4127236790 [label="Tem vez que ele me irrita, só isso",shape=box,color=red];
		j4127236790 -> j748672903;
	j3015978982 [label="Não foi minha intenção, é que ele pode ser meio… desagradável pra algumas pessoas",shape=box,color=red];
		j3015978982 -> j183770693;
	j1405914971 [label="Sinto muito… ele irrita as pessoas de vez em quando, não é culpa dele",shape=box,color=red];
		j1405914971 -> j183770693;
	j3057038318 [label="De fato, ele conhecia muito bem os Luminários! Conversamos longamente sobre as \"Religiões Ancestrais\", como ele as chamava, nos \"dias de antes do Império Orokin\".",shape=box,color=blue];
		j3057038318 -> j2242502143;
	j4050724025 [label="O Otak era um Arquimediano, um cientista e acadêmico Orokin. O que aconteceu com ele não é exatamente uma história muito feliz…",shape=box,color=red];
		j4050724025 -> j3588445909;
	j748672903 [label="Espero que você procure ser mais gentil com alguém que está claramente debilitado. Mais par la grâce de Sol.",shape=box,color=blue];
		j748672903 -> j2228660657;
	j183770693 [label="E eu espero que tais pessoas lhe mostrem bondade e paciência. Mais par la grâce de Sol.",shape=box,color=blue];
		j183770693 -> j2228660657;
	j2242502143 [label="Embora ele tenha dito que muito desse conhecimento estava perdido agora, guardado em arquivos profundos e estritamente proibido. Ele me fez jurar segredo.",shape=box,color=blue];
		j2242502143 -> j2268815902;
	j3588445909 [label="Segundo relatos, ele era um gênio. A mente por trás do estudo e uso dos cristais de argônio e tudo mais",shape=box,color=red];
		j3588445909 -> j3093088100;
	j2228660657 [label="Tal destino poderia aguardar qualquer um de nós… até mesmo você.",shape=box,color=blue];
		j2228660657 -> j1724615845;
		j2228660657 -> j1885723243;
	j2268815902 [label="Ele me disse que estava profundamente preocupado com a possibilidade de o Executor Ballas… seja lá quem ele for… descobrir minha seita de hereges e mandar me executar.",shape=box,color=blue];
		j2268815902 -> j1016444544;
		j2268815902 -> j4057053789;
	j3093088100 [label="Que são extraídos do Void e são a razão pela qual podemos criar muitos dos poderosos Warframes e armas que temos",shape=box,color=red];
		j3093088100 -> j2452395787;
	j1724615845 [label="Você tem razão, foi mal. Falei sem pensar",shape=box,color=red];
		j1724615845 -> j3081994153;
	j1885723243 [label="Foi mal, não tenho tempo pra ele",shape=box,color=red];
		j1885723243 -> j279911747;
	j1016444544 [label="O Ballas tá morto… pode continuar",shape=box,color=red];
		j1016444544 -> j1338434850;
	j4057053789 [label="Isso… não vai acontecer. Pode continuar",shape=box,color=red];
		j4057053789 -> j1338434850;
	j2452395787 [label="Ele se especializou em cristalografia, e seus trabalhos foram todos arquivados aqui, nos laboratórios",shape=box,color=red];
		j2452395787 -> j2465601719;
	j279911747 [label="Então, peço desculpas por ter desperdiçado mais do seu tempo.",shape=box,color=blue];
		j279911747 -> j3007723528;
	j1338434850 [label="+5 Chemistry",color=orange];
		j1338434850 -> j4027365874;
	j2465601719 [label="Por alguma razão, que não faço ideia de qual é, ele foi transformado em um Cephalon e recebeu seu próprio \"corpo\" de Necraloid",shape=box,color=red];
		j2465601719 -> j437659786;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j4027365874 [label="Eu suspeitei… bem, ele me perguntou de onde eu era, e quando eu disse, ele riu e disse: \"Não, isso é impossível! E eu sei do que estou falando, eu sou…\"",shape=box,color=blue];
		j4027365874 -> j56813938;
	j437659786 [label="Nem todo Cephalon foi feito com o objetivo de punir alguém. Mas as coisas meio que… desandaram aqui em Deimos, e ele acabou ficando bem danificado",shape=box,color=red];
		j437659786 -> j728945233;
	j56813938 [label="E então ele… apresentou-se a mim novamente. E perguntou-me se eu vinha das planícies, com amostras de minerais…",shape=box,color=blue];
		j56813938 -> j2928864791;
		j56813938 -> j1174715651;
	j728945233 [label="Pauvre petit…",shape=box,color=blue];
		j728945233 -> j253530729;
	j2928864791 [label="É… esse é o Otak",shape=box,color=red];
		j2928864791 -> j2678298113;
	j1174715651 [label="Ah, Marie… sinto muito…",shape=box,color=red];
		j1174715651 -> j2678298113;
	j253530729 [label="Boolean MarieOtak1 is now true.",color=orange];
		j253530729 -> j3655033167;
		j253530729 -> j4063768550;
	j2678298113 [label="Fico arrasada só de pensar que não há nada que se possa fazer por ele.",shape=box,color=blue];
		j2678298113 -> j457335464;
	j457335464 [label="Evaluate expressions",color=orange];
