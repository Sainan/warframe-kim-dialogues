	3503 [label="De fato, ele conhecia muito bem os Luminários! Conversamos longamente sobre as \"Religiões Ancestrais\", como ele as chamava, nos \"dias de antes do Império Orokin\".",shape=box,color=blue];
		3503 -> 3507;
	3504 [label="O Otak era um Arquimediano, um cientista e acadêmico Orokin. O que aconteceu com ele não é exatamente uma história muito feliz…",shape=box,color=red];
		3504 -> 3508;
	3505 [label="Espero que você procure ser mais gentil com alguém que está claramente debilitado. Mais par la grâce de Sol.",shape=box,color=blue];
		3505 -> 3509;
	3506 [label="E eu espero que tais pessoas lhe mostrem bondade e paciência. Mais par la grâce de Sol.",shape=box,color=blue];
		3506 -> 3509;
	3507 [label="Embora ele tenha dito que muito desse conhecimento estava perdido agora, guardado em arquivos profundos e estritamente proibido. Ele me fez jurar segredo.",shape=box,color=blue];
		3507 -> 3510;
	3508 [label="Segundo relatos, ele era um gênio. A mente por trás do estudo e uso dos cristais de argônio e tudo mais",shape=box,color=red];
		3508 -> 3511;
	3509 [label="Tal destino poderia aguardar qualquer um de nós… até mesmo você.",shape=box,color=blue];
		3509 -> 3512;
		3509 -> 3513;
	3510 [label="Ele me disse que estava profundamente preocupado com a possibilidade de o Executor Ballas… seja lá quem ele for… descobrir minha seita de hereges e mandar me executar.",shape=box,color=blue];
		3510 -> 3514;
