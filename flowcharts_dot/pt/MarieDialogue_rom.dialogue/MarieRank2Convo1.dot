		3905 -> 304;
	326 [label="Ah, oui. Um andarilho, como seu apelido já indica. Você viu muitas culturas, muitas crenças, muitos mundos. Cela est très spirituel, non? Coletou diferentes aspectos delas em suas jornadas.",shape=box,color=blue];
		326 -> 336;
		326 -> 337;
