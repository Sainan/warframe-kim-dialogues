digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo3 begins." [color=orange];
		"MarieRank4Convo3 begins." -> j1608671930;
	j1608671930 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j1608671930 -> j3933171351;
		j1608671930 -> j17348121;
	j3933171351 [label="Fala Marie, tudo certo?",shape=box,color=red];
		j3933171351 -> j1656167726;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j1656167726 [label="Não estou tão bem assim. Talvez você queira voltar para conversar comigo amanhã, não serei a melhor companhia hoje.",shape=box,color=blue];
		j1656167726 -> j1393280410;
		j1656167726 -> j3797948872;
		j1656167726 -> j3021655989;
	"Chat ends." [color=orange];
	j1393280410 [label="Posso até ir embora, mas se quiser conversar, posso te ouvir sem problemas",shape=box,color=red];
		j1393280410 -> j629196687;
	j3797948872 [label="Tudo bem, eu entendo",shape=box,color=red];
		j3797948872 -> "Chat ends.";
	j3021655989 [label="Se me permite… qual o problema?",shape=box,color=red];
		j3021655989 -> j629196687;
	j629196687 [label="C'est vraiment gentil, mas é um problema antigo… nada que valha a pena se preocupar. Ficarei bem.",shape=box,color=blue];
		j629196687 -> j3096270068;
	j3096270068 [label="Boolean MarieChronicPain is now true.",color=orange];
		j3096270068 -> j454985681;
		j3096270068 -> j3795987928;
		j3096270068 -> j1514360112;
	j454985681 [label="Tem certeza? Se quiser desabafar, tô aqui pra isso",shape=box,color=red];
		j454985681 -> j480947258;
	j3795987928 [label="Eu… sei como é. Antes de começar a voltar no tempo, me machuquei bastante em Duviri. Já passou, mas a ferida ainda dói de vez em quando. Sempre tento esconder isso dos outros quando acontece",shape=box,color=red];
		j3795987928 -> j3029037411;
	j1514360112 [label="Problemas antigos são tão problemáticos quanto os novos. Só porque eles vêm e vão não, significa que não vale a pena falar sobre eles",shape=box,color=red];
		j1514360112 -> j352297131;
	j480947258 [label="Você é tão gentil… certo, tudo bem. Você está sendo teimosinha de novo, Marie.",shape=box,color=blue];
		j480947258 -> j2607210103;
	j3029037411 [label="Boolean DrifterChronicPain is now true.",color=orange];
		j3029037411 -> j1254703194;
	j352297131 [label="Oui, tu as raison. Você está sendo teimosinha de novo, Marie.",shape=box,color=blue];
		j352297131 -> j2607210103;
	j2607210103 [label="É difícil explicar, mas vou tentar. Mes pieds, oui? Meus pés… o soro me transformou, me deu asas…",shape=box,color=blue];
		j2607210103 -> j1534428825;
	j1254703194 [label="Par les Luminários, sinto muito mesmo. Então, você entende como é, oui?",shape=box,color=blue];
		j1254703194 -> j1368410199;
	j1534428825 [label="Mas eu ainda as sinto… aquelas coisas distorcidas que ameaçavam me consumir… ameaçavam destruir toda esperança e alegria da minha alma.",shape=box,color=blue];
		j1534428825 -> j3286257300;
	j1368410199 [label="Ter um corpo que te trai, que desacelera seu espírito… Até mesmo agora, é muito estranho. O soro me mudou, me deu asas…",shape=box,color=blue];
		j1368410199 -> j1534428825;
	j3286257300 [label="Eles sempre doem… sempre. Até mesmo agora, sentada aqui. Se penso neles, sinto a dor. Mas nem sempre é o suficiente para que eu perceba.",shape=box,color=blue];
		j3286257300 -> j177390649;
	j177390649 [label="Até hoje, eles ainda me acordam de noite, de dor. E eu me pergunto: Sol, por quê? Por que ainda sinto essa… agonia incessante?",shape=box,color=blue];
		j177390649 -> j430051660;
	j430051660 [label="Para qual propósito? Ah, mas aí chega a manhã, e eu rio e digo a mim mesma: \"Quieta, Marie, você é abençoada. Olhe para tudo o que você tem, tudo o que você pode fazer.\"",shape=box,color=blue];
		j430051660 -> j2301962603;
	j2301962603 [label="Na Catedral, era: \"Você pode ler, pode escrever, pode comer, pode dormir. Você pode se movimentar muito bem. Você tem olhos para enxergar e língua para falar. Mãos para escrever. E gente que se importa com você.\" E agora, eu posso voar! Posso proteger o futuro do próprio Void, da própria Indiferença!",shape=box,color=blue];
		j2301962603 -> j4213332322;
	j4213332322 [label="\"Chore agora, menina boba, essa dor constante vai te fortalecer contra o que virá\", digo a mim mesma. E o dia passa para outro, e não é tão ruim quando acontece novamente.",shape=box,color=blue];
		j4213332322 -> j830269311;
	j830269311 [label="Check boolean DrifterChronicPain",color=orange];
		j830269311 -> j1005689482 [label=true,color=green];
		j830269311 -> j4070533111 [label=true,color=green];
		j830269311 -> j1809361999 [label=false,color=brown];
		j830269311 -> j1156137851 [label=false,color=brown];
	j1005689482 [label="Se tem uma coisa que isso nos deu, foi tolerância à dor",shape=box,color=red];
		j1005689482 -> j859746343;
	j4070533111 [label="Às vezes… acordo e sinto que parece que vai ser hoje que vou desabar",shape=box,color=red];
		j4070533111 -> j859746343;
	j1809361999 [label="Isso… não para de doer nunca? Poxa Marie, sinto muito…",shape=box,color=red];
		j1809361999 -> j1156532567;
	j1156137851 [label="Não tem remédio pra isso? Algum tratamento?",shape=box,color=red];
		j1156137851 -> j2395179214;
	j859746343 [label="Um paroquiano certa vez me perguntou: \"Você sente dor? Sempre?\" Ao que respondi: \"Oui, monsieur. Je le suis.\" Seu olhar de espanto se misturava ao horror.",shape=box,color=blue];
		j859746343 -> j748119894;
	j1156532567 [label="Às vezes, eu costumava sentar e pensar em tudo o que eu poderia fazer se não estivesse em tanta agonia. Se eu não estivesse tão… presa numa gaiola de carne, tão determinada a me atrapalhar em cada passo.",shape=box,color=blue];
		j1156532567 -> j361936426;
	j2395179214 [label="Gostaria que houvesse… Mas não, não há. Não na minha época, e temo que, provavelmente, nem nessa.",shape=box,color=blue];
		j2395179214 -> j4106772441;
	j748119894 [label="\"Como você segue adiante?\" foi a próxima pergunta. E lembro que sorri para ele e respondi: \"Que escolha eu tenho, Monsieur?\"",shape=box,color=blue];
		j748119894 -> j1236876355;
		j748119894 -> j3874590872;
	j361936426 [label="Como isso me deixaria furiosa! Como eu ficaria ciumenta daqueles cujos corpos não nasceram como um fardo. Mas de que nos serve isso no final, à part rendre nos vies plus amères? Ficar mais amargurada?",shape=box,color=blue];
		j361936426 -> j3340640711;
	j4106772441 [label="Algumas doenças… estão além da cura do homem, da ciência e da fé.",shape=box,color=blue];
		j4106772441 -> j1156532567;
	j1236876355 [label="Já tive essa mesma conversa tantas vezes…",shape=box,color=red];
		j1236876355 -> j1156532567;
	j3874590872 [label="Exatamente… sinto muito",shape=box,color=red];
		j3874590872 -> j760630915;
	j3340640711 [label="Aucun… sou como sou, e perseverarei mesmo assim.",shape=box,color=blue];
		j3340640711 -> j2980398560;
	j760630915 [label="Non… lamento muito que você tenha compartilhado uma agonia tão parecida. ",shape=box,color=blue];
		j760630915 -> j1156532567;
	j2980398560 [label="Check boolean DrifterChronicPain",color=orange];
		j2980398560 -> j2274219190 [label=true,color=green];
		j2980398560 -> j3809648593 [label=false,color=brown];
	j2274219190 [label="E você também… você também. Nisso, eu tenho fé.",shape=box,color=blue];
		j2274219190 -> j3809648593;
	j3809648593 [label="+20 Chemistry",color=orange];
		j3809648593 -> j2653681567;
	j2653681567 [label="Não consigo expressar em palavras o quanto esta conversa significou para mim. Então… direi simplesmente \"merci\", Peregrino.",shape=box,color=blue];
		j2653681567 -> j3563974437;
	j3563974437 [label="Et encore merci.",shape=box,color=blue];
		j3563974437 -> "Chat ends.";
}