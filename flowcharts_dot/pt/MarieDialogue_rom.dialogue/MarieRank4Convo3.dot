digraph {
	2239 [label="MarieRank4Convo3 begins.",color=orange];
		2239 -> 2240;
		2239 -> 2241;
	2240 [label="Fala Marie, tudo certo?",shape=box,color=red];
		2240 -> 2242;
	2241 [label="[Encerrar Conversa]",shape=box,color=red];
		2241 -> 2243;
	2242 [label="Não estou tão bem assim. Talvez você queira voltar para conversar comigo amanhã, não serei a melhor companhia hoje.",shape=box,color=blue];
		2242 -> 2244;
		2242 -> 2245;
		2242 -> 2246;
	2243 [label="Chat ends.",color=orange];
	2244 [label="Posso até ir embora, mas se quiser conversar, posso te ouvir sem problemas",shape=box,color=red];
		2244 -> 2247;
	2245 [label="Tudo bem, eu entendo",shape=box,color=red];
		2245 -> 2248;
	2246 [label="Se me permite… qual o problema?",shape=box,color=red];
		2246 -> 2247;
	2247 [label="C'est vraiment gentil, mas é um problema antigo… nada que valha a pena se preocupar. Ficarei bem.",shape=box,color=blue];
		2247 -> 2249;
	2248 [label="Chat ends.",color=orange];
	2249 [label="Update boolean MarieChronicPain",color=orange];
		2249 -> 2250;
		2249 -> 2251;
		2249 -> 2252;
	2250 [label="Tem certeza? Se quiser desabafar, tô aqui pra isso",shape=box,color=red];
		2250 -> 2253;
	2251 [label="Eu… sei como é. Antes de começar a voltar no tempo, me machuquei bastante em Duviri. Já passou, mas a ferida ainda dói de vez em quando. Sempre tento esconder isso dos outros quando acontece",shape=box,color=red];
		2251 -> 2254;
	2252 [label="Problemas antigos são tão problemáticos quanto os novos. Só porque eles vêm e vão não, significa que não vale a pena falar sobre eles",shape=box,color=red];
		2252 -> 2255;
	2253 [label="Você é tão gentil… certo, tudo bem. Você está sendo teimosinha de novo, Marie.",shape=box,color=blue];
		2253 -> 2256;
	2254 [label="Update boolean DrifterChronicPain",color=orange];
		2254 -> 2257;
	2255 [label="Oui, tu as raison. Você está sendo teimosinha de novo, Marie.",shape=box,color=blue];
		2255 -> 2256;
	2256 [label="É difícil explicar, mas vou tentar. Mes pieds, oui? Meus pés… o soro me transformou, me deu asas…",shape=box,color=blue];
		2256 -> 2258;
	2257 [label="Par les Luminários, sinto muito mesmo. Então, você entende como é, oui?",shape=box,color=blue];
		2257 -> 2259;
	2258 [label="Mas eu ainda as sinto… aquelas coisas distorcidas que ameaçavam me consumir… ameaçavam destruir toda esperança e alegria da minha alma.",shape=box,color=blue];
		2258 -> 2260;
	2259 [label="Ter um corpo que te trai, que desacelera seu espírito… Até mesmo agora, é muito estranho. O soro me mudou, me deu asas…",shape=box,color=blue];
		2259 -> 2258;
	2260 [label="Eles sempre doem… sempre. Até mesmo agora, sentada aqui. Se penso neles, sinto a dor. Mas nem sempre é o suficiente para que eu perceba.",shape=box,color=blue];
		2260 -> 2261;
	2261 [label="Até hoje, eles ainda me acordam de noite, de dor. E eu me pergunto: Sol, por quê? Por que ainda sinto essa… agonia incessante?",shape=box,color=blue];
		2261 -> 2262;
	2262 [label="Para qual propósito? Ah, mas aí chega a manhã, e eu rio e digo a mim mesma: \"Quieta, Marie, você é abençoada. Olhe para tudo o que você tem, tudo o que você pode fazer.\"",shape=box,color=blue];
		2262 -> 2263;
	2263 [label="Na Catedral, era: \"Você pode ler, pode escrever, pode comer, pode dormir. Você pode se movimentar muito bem. Você tem olhos para enxergar e língua para falar. Mãos para escrever. E gente que se importa com você.\" E agora, eu posso voar! Posso proteger o futuro do próprio Void, da própria Indiferença!",shape=box,color=blue];
		2263 -> 2264;
	2264 [label="\"Chore agora, menina boba, essa dor constante vai te fortalecer contra o que virá\", digo a mim mesma. E o dia passa para outro, e não é tão ruim quando acontece novamente.",shape=box,color=blue];
		2264 -> 2265;
	2265 [label="Check boolean DrifterChronicPain",color=orange];
		2265 -> 2266 [label=true,color=green];
		2265 -> 2269 [label=true,color=green];
		2265 -> 2267 [label=false,color=brown];
		2265 -> 2268 [label=false,color=brown];
	2266 [label="Se tem uma coisa que isso nos deu, foi tolerância à dor",shape=box,color=red];
		2266 -> 2270;
	2269 [label="Às vezes… acordo e sinto que parece que vai ser hoje que vou desabar",shape=box,color=red];
		2269 -> 2270;
	2267 [label="Isso… não para de doer nunca? Poxa Marie, sinto muito…",shape=box,color=red];
		2267 -> 2271;
	2268 [label="Não tem remédio pra isso? Algum tratamento?",shape=box,color=red];
		2268 -> 2272;
	2270 [label="Um paroquiano certa vez me perguntou: \"Você sente dor? Sempre?\" Ao que respondi: \"Oui, monsieur. Je le suis.\" Seu olhar de espanto se misturava ao horror.",shape=box,color=blue];
		2270 -> 2273;
	2271 [label="Às vezes, eu costumava sentar e pensar em tudo o que eu poderia fazer se não estivesse em tanta agonia. Se eu não estivesse tão… presa numa gaiola de carne, tão determinada a me atrapalhar em cada passo.",shape=box,color=blue];
		2271 -> 2274;
	2272 [label="Gostaria que houvesse… Mas não, não há. Não na minha época, e temo que, provavelmente, nem nessa.",shape=box,color=blue];
		2272 -> 2275;
	2273 [label="\"Como você segue adiante?\" foi a próxima pergunta. E lembro que sorri para ele e respondi: \"Que escolha eu tenho, Monsieur?\"",shape=box,color=blue];
		2273 -> 2276;
		2273 -> 2277;
	2274 [label="Como isso me deixaria furiosa! Como eu ficaria ciumenta daqueles cujos corpos não nasceram como um fardo. Mas de que nos serve isso no final, à part rendre nos vies plus amères? Ficar mais amargurada?",shape=box,color=blue];
		2274 -> 2278;
	2275 [label="Algumas doenças… estão além da cura do homem, da ciência e da fé.",shape=box,color=blue];
		2275 -> 2271;
	2276 [label="Já tive essa mesma conversa tantas vezes…",shape=box,color=red];
		2276 -> 2271;
	2277 [label="Exatamente… sinto muito",shape=box,color=red];
		2277 -> 2279;
	2278 [label="Aucun… sou como sou, e perseverarei mesmo assim.",shape=box,color=blue];
		2278 -> 2280;
	2279 [label="Non… lamento muito que você tenha compartilhado uma agonia tão parecida. ",shape=box,color=blue];
		2279 -> 2271;
	2280 [label="Check boolean DrifterChronicPain",color=orange];
		2280 -> 2281 [label=true,color=green];
		2280 -> 2282 [label=false,color=brown];
	2281 [label="E você também… você também. Nisso, eu tenho fé.",shape=box,color=blue];
		2281 -> 2282;
	2282 [label="+20 Chemistry",color=orange];
		2282 -> 2283;
	2283 [label="Não consigo expressar em palavras o quanto esta conversa significou para mim. Então… direi simplesmente \"merci\", Peregrino.",shape=box,color=blue];
		2283 -> 2284;
	2284 [label="Et encore merci.",shape=box,color=blue];
		2284 -> 2285;
	2285 [label="Chat ends.",color=orange];
}