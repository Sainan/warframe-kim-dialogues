digraph {
	1418 [label="MarieRank3Convo6 begins.",color=orange];
		1418 -> 3740;
	3740 [label="Update boolean MarieLyonAvailable",color=orange];
		3740 -> 1419;
	1419 [label="Preciso lhe fazer uma pergunta, e imploro que não me julgue por isso, Peregrino.",shape=box,color=blue];
		1419 -> 1420;
		1419 -> 1421;
		1419 -> 1422;
	1420 [label="Te colocaram numa situação cabulosa, eu jamais te julgaria por isso",shape=box,color=red];
		1420 -> 1423;
	1421 [label="Farei o meu melhor",shape=box,color=red];
		1421 -> 1424;
	1422 [label="[Encerrar Conversa]",shape=box,color=red];
		1422 -> 1425;
	1423 [label="Vraiment gentil em fazer isso sem me conhecer ou saber o que eu estava prestes a escrever.",shape=box,color=blue];
		1423 -> 1426;
	1424 [label="+10 Chemistry",color=orange];
		1424 -> 1427;
	1425 [label="Chat ends.",color=orange];
	1426 [label="Então… o peixe falante de cabeça grande também lhe dá dor de cabeça? O Fibonacci?",shape=box,color=blue];
		1426 -> 1428;
		1426 -> 1429;
		1426 -> 1430;
	1427 [label="Muito obrigada.",shape=box,color=blue];
		1427 -> 1426;
	1428 [label="Sim, pra caramba! Finalmente, alguém que me entende",shape=box,color=red];
		1428 -> 1431;
	1429 [label="O fato de você ficar irritada com o Fibonacci é… incrivelmente cativante",shape=box,color=red];
		1429 -> 1432;
	1430 [label="Pra falar a real… não, eu adoro ele",shape=box,color=red];
		1430 -> 1433;
	1431 [label="Então, fico feliz por não estar sozinha. Mas, para deixar claro, não quero ofendê-lo. Se me sinto mal devido à minha situação atual, imagino que ele esteja fazendo o que pode para suportar a dele.",shape=box,color=blue];
		1431 -> 1434;
	1432 [label="Sério? Como assim? Acho que fico feliz por isso, mas estou simplesmente confusa sobre o porquê. Minha dor de cabeça certamente não deve ser tão cativante assim.",shape=box,color=blue];
		1432 -> 1435;
		1432 -> 1436;
	1433 [label="Então, peço perdão pelo comentário, não quero ofendê-lo. Se me sinto mal devido à minha situação atual, imagino que ele esteja fazendo o que pode para suportar a dele.",shape=box,color=blue];
		1433 -> 1437;
	1434 [label="Seus meios de fazer isso simplesmente não me agradam, ainda mais quando sou submetida à presença deles por longos períodos de tempo.",shape=box,color=blue];
		1434 -> 1438;
	1435 [label="Passo a maior parte do meu tempo lutando pela minha vida. Pequenas lembranças da humanidade como essa são… a razão de eu viver",shape=box,color=red];
		1435 -> 1439;
	1436 [label="Acho que, de vez em quando, preciso dar um passo pra trás e refletir sobre como tudo aqui é absurdo. Um Norg e uma sacerdotisa do Sol, batendo papo…",shape=box,color=red];
		1436 -> 1440;
	1437 [label="Seus meios de fazer isso simplesmente não me agradam, ainda mais quando sou submetida à presença deles por longos períodos de tempo.",shape=box,color=blue];
		1437 -> 1441;
	1438 [label="Bah, eu não deveria estar reclamando. Preciso levar o jantar para o Lyon hoje à noite, ele está de cama novamente por causa de uma megrim terrível.",shape=box,color=blue];
		1438 -> 1442;
		1438 -> 1443;
	1439 [label="+5 Chemistry",color=orange];
		1439 -> 1444;
	1440 [label="+5 Chemistry",color=orange];
		1440 -> 1445;
	1441 [label="Bah, eu não deveria estar reclamando. Preciso levar o jantar para o Lyon hoje à noite, ele está de cama novamente por causa de uma megrim terrível.",shape=box,color=blue];
		1441 -> 1442;
		1441 -> 1443;
	1442 [label="Ele fica assim com frequência?",shape=box,color=red];
		1442 -> 1446;
	1443 [label="Boiei… isso aí é de comer, é?",shape=box,color=red];
		1443 -> 1447;
	1444 [label="Nunca perca essa parte de você, Peregrino. Nunca abandone a parte de você que busca essas centelhas de vida.",shape=box,color=blue];
		1444 -> 1448;
	1445 [label="Minha nossa, quando você coloca dessa forma, não é nada surpresa… parece até uma daquelas piadas infantis, n'est-ce pas?",shape=box,color=blue];
		1445 -> 1449;
	1446 [label="Oui, oui. Uma vez por semana? Uma vez a cada 2 meses? O maior período que o vi ficar sem uma foi de 6 meses, eu acho.",shape=box,color=blue];
		1446 -> 1450;
	1447 [label="Ah! Céus… hmm, pense em uma dor de cabeça, mas bem mais intensa. Já ouvi alguns chamá-la de dor de cefaleia biliosa, é mais comum em mulheres.",shape=box,color=blue];
		1447 -> 1451;
		1447 -> 1452;
	1448 [label="O mundo está caminhando depressa para se tornar um lugar sombrio e escuro, com sofrimento a todo momento.",shape=box,color=blue];
		1448 -> 1453;
	1449 [label="Uma Irmã, um Padre e um demônio do futuro são enviados ao passado… e depois ao futuro… e encontram um peixe, um cervo, um pássaro gigante e um mordomo…",shape=box,color=blue];
		1449 -> 1454;
	1450 [label="Check boolean Megrim",color=orange];
		1450 -> 1455 [label=true,color=green];
		1450 -> 1456 [label=true,color=green];
		1450 -> 1458 [label=true,color=green];
		1450 -> 1455 [label=false,color=brown];
		1450 -> 1456 [label=false,color=brown];
		1450 -> 1457 [label=false,color=brown];
	1451 [label="Acho que a gente chama isso de \"enxaqueca\" hoje em dia",shape=box,color=red];
		1451 -> 1459;
	1452 [label="Megrims… anotado, valeu",shape=box,color=red];
		1452 -> 1460;
	1453 [label="Devemos buscar qualquer brilho, qualquer leviandade que pudermos… até mesmo na forma de infantilidade, se necessário.",shape=box,color=blue];
		1453 -> 1461;
	1454 [label="É bem cativante, tenho que concordar!",shape=box,color=blue];
		1454 -> 1462;
	1455 [label="O que será que faz isso acontecer?",shape=box,color=red];
		1455 -> 1463;
	1456 [label="Isso parece horrível…",shape=box,color=red];
		1456 -> 1464;
	1458 [label="Eu também tenho megrims, é terrível",shape=box,color=red];
		1458 -> 1465;
	1457 [label="Eu também tenho esse tipo de dor de cabeça, é terrível",shape=box,color=red];
		1457 -> 1465;
	1459 [label="Mal posso imaginar que outras particularidades históricas fascinantes descobriremos! Adoro aprender coisas novas. \"Enxaqueca.\"",shape=box,color=blue];
		1459 -> 1466;
	1460 [label="Update boolean Megrim",color=orange];
		1460 -> 1467;
	1461 [label="Adoraria que o Lyon visse as coisas da mesma forma.",shape=box,color=blue];
		1461 -> 1468;
	1462 [label="Adoraria que o meu querido Lyon visse o brilho nisso da mesma forma.",shape=box,color=blue];
		1462 -> 1468;
	1463 [label="Ele tem suas teorias. ",shape=box,color=blue];
		1463 -> 1469;
	1464 [label="Se você expressar suas condolências, tenho certeza de que elas serão bem-vindas. E, apesar do que possa parecer, ele apreciará a companhia.",shape=box,color=blue];
		1464 -> 1470;
	1465 [label="Sério? Você deveria contar ao Lyon. Ele precisa saber que outros são capazes de sofrer como ele.",shape=box,color=blue];
		1465 -> 1471;
	1466 [label="Update boolean Migraine",color=orange];
		1466 -> 1467;
	1467 [label="Não importa o nome. O Lyon está com uma, e assim permanecerá, até de manhã. O pobre homem não consegue enxergar nada além de um borrão, nem sentir as mãos ou os pés. E ele me diz que a dor é insuportável.",shape=box,color=blue];
		1467 -> 1450;
	1468 [label="Update boolean MarieLyonSuffering1",color=orange];
		1468 -> 1472;
	1469 [label="Embora seja mais correto dizer que ele \"tinha\" suas teorias, até recentemente.",shape=box,color=blue];
		1469 -> 1473;
	1470 [label="Embora seu comportamento possa tentar dissuadi-lo, imploro que se mantenha firme, Peregrino. Há um homem, com grande necessidade de ajuda, enterrado sob o que parece uma aparência estoica e rígida.",shape=box,color=blue];
		1470 -> 1474;
		1470 -> 1475;
		1470 -> 1476;
	1471 [label="+5 Chemistry",color=orange];
		1471 -> 1477;
	1472 [label="Ah, falando nisso, me sinto péssima por reclamar de dores de cabeça. Preciso levar o jantar para o Lyon hoje à noite, ele está de cama novamente por causa de uma megrim terrível.",shape=box,color=blue];
		1472 -> 1443;
		1472 -> 1442;
	1473 [label="Update boolean MarieLyonFaith1",color=orange];
		1473 -> 1470;
	1474 [label="Relaxa, teimosia e persistência são meus sobrenomes",shape=box,color=red];
		1474 -> 1478;
	1475 [label="Eu já tenho um Homem na Parede na minha vida… que mal faz ter mais um?",shape=box,color=red];
		1475 -> 1479;
	1476 [label="Ele é um homem adulto. Se ele quiser falar, ele vai.",shape=box,color=red];
		1476 -> 1480;
	1477 [label="Os Luminários sabem que, mesmo assim, ele sofreria sozinho de bom grado…",shape=box,color=blue];
		1477 -> 1481;
	1478 [label="+5 Chemistry",color=orange];
		1478 -> 1482;
	1479 [label="Brinque comigo desse jeito, mas não faça esse tipo de comentário com ele. O assunto da sua Indiferença é bem delicado para ele.",shape=box,color=blue];
		1479 -> 1483;
	1480 [label="Ele é adulto, sim. Ele é um homem, sim. E acredito que ele quer falar. Mas desafio você a questionar se ele \"consegue\" falar.",shape=box,color=blue];
		1480 -> 1484;
	1481 [label="Update boolean MarieLyonSuffering2",color=orange];
		1481 -> 1470;
	1482 [label="Receio que você vá precisar disso com ele. Obrigada, Peregrino. Ele é meu amigo mais querido, e como um irmão para mim. E parte meu coração vê-lo sofrendo tanto.",shape=box,color=blue];
		1482 -> 1485;
	1483 [label="Seja resiliente, paciente e gentil. Ele é como um irmão para mim, é meu amigo mais querido, Peregrino. Me parte o coração vê-lo sofrendo tanto.",shape=box,color=blue];
		1483 -> 1485;
	1484 [label="Nem todos somos igualmente talentosos ou sentimos que temos direito a tais coisas. Ele está sofrendo… acredita que o sofrimento é seu destino.",shape=box,color=blue];
		1484 -> 1486;
	1485 [label="Falaremos novamente em breve. Par la grâce de Sol.",shape=box,color=blue];
		1485 -> 3734;
	1486 [label="Ele também é como um irmão para mim, é meu amigo mais querido. Meu coração se parte por ele. Então, eu só posso pedir que você… seja paciente e gentil, se você for capaz.",shape=box,color=blue];
		1486 -> 1485;
	3734 [label="{\"Id\":3734,\"Incoming\":[1485],\"Outgoing\":[1487],\"GraphPos\":[12826,24521],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue\",\"Tag\":\"LyonHeadaches\",\"Value\":0}]}",color=orange];
