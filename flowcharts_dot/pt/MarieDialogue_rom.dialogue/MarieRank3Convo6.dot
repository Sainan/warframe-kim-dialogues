digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank3Convo6 begins." [color=orange];
		"MarieRank3Convo6 begins." -> j2696371957;
	j2696371957 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j2696371957 -> j2268287415;
	j2268287415 [label="Preciso lhe fazer uma pergunta, e imploro que não me julgue por isso, Peregrino.",shape=box,color=blue];
		j2268287415 -> j3237009300;
		j2268287415 -> j3695394280;
		j2268287415 -> j17348121;
	j3237009300 [label="Te colocaram numa situação cabulosa, eu jamais te julgaria por isso",shape=box,color=red];
		j3237009300 -> j3963830846;
	j3695394280 [label="Farei o meu melhor",shape=box,color=red];
		j3695394280 -> j1152292030;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j3963830846 [label="Vraiment gentil em fazer isso sem me conhecer ou saber o que eu estava prestes a escrever.",shape=box,color=blue];
		j3963830846 -> j2838178494;
	j1152292030 [label="+10 Chemistry",color=orange];
		j1152292030 -> j4117927565;
	"Chat ends." [color=orange];
	j2838178494 [label="Então… o peixe falante de cabeça grande também lhe dá dor de cabeça? O Fibonacci?",shape=box,color=blue];
		j2838178494 -> j3521552564;
		j2838178494 -> j2995958812;
		j2838178494 -> j3857807024;
	j4117927565 [label="Muito obrigada.",shape=box,color=blue];
		j4117927565 -> j2838178494;
	j3521552564 [label="Sim, pra caramba! Finalmente, alguém que me entende",shape=box,color=red];
		j3521552564 -> j1592851210;
	j2995958812 [label="O fato de você ficar irritada com o Fibonacci é… incrivelmente cativante",shape=box,color=red];
		j2995958812 -> j2346871716;
	j3857807024 [label="Pra falar a real… não, eu adoro ele",shape=box,color=red];
		j3857807024 -> j3812821385;
	j1592851210 [label="Então, fico feliz por não estar sozinha. Mas, para deixar claro, não quero ofendê-lo. Se me sinto mal devido à minha situação atual, imagino que ele esteja fazendo o que pode para suportar a dele.",shape=box,color=blue];
		j1592851210 -> j2258746968;
	j2346871716 [label="Sério? Como assim? Acho que fico feliz por isso, mas estou simplesmente confusa sobre o porquê. Minha dor de cabeça certamente não deve ser tão cativante assim.",shape=box,color=blue];
		j2346871716 -> j956576291;
		j2346871716 -> j1046798625;
	j3812821385 [label="Então, peço perdão pelo comentário, não quero ofendê-lo. Se me sinto mal devido à minha situação atual, imagino que ele esteja fazendo o que pode para suportar a dele.",shape=box,color=blue];
		j3812821385 -> j2744056206;
	j2258746968 [label="Seus meios de fazer isso simplesmente não me agradam, ainda mais quando sou submetida à presença deles por longos períodos de tempo.",shape=box,color=blue];
		j2258746968 -> j3703896154;
	j956576291 [label="Passo a maior parte do meu tempo lutando pela minha vida. Pequenas lembranças da humanidade como essa são… a razão de eu viver",shape=box,color=red];
		j956576291 -> j462600574;
	j1046798625 [label="Acho que, de vez em quando, preciso dar um passo pra trás e refletir sobre como tudo aqui é absurdo. Um Norg e uma sacerdotisa do Sol, batendo papo…",shape=box,color=red];
		j1046798625 -> j654865872;
	j2744056206 [label="Seus meios de fazer isso simplesmente não me agradam, ainda mais quando sou submetida à presença deles por longos períodos de tempo.",shape=box,color=blue];
		j2744056206 -> j3703896154;
	j3703896154 [label="Bah, eu não deveria estar reclamando. Preciso levar o jantar para o Lyon hoje à noite, ele está de cama novamente por causa de uma megrim terrível.",shape=box,color=blue];
		j3703896154 -> j2610942050;
		j3703896154 -> j2879242040;
	j462600574 [label="+5 Chemistry",color=orange];
		j462600574 -> j236966592;
	j654865872 [label="+5 Chemistry",color=orange];
		j654865872 -> j1257788436;
	j2610942050 [label="Ele fica assim com frequência?",shape=box,color=red];
		j2610942050 -> j1422639869;
	j2879242040 [label="Boiei… isso aí é de comer, é?",shape=box,color=red];
		j2879242040 -> j562693245;
	j236966592 [label="Nunca perca essa parte de você, Peregrino. Nunca abandone a parte de você que busca essas centelhas de vida.",shape=box,color=blue];
		j236966592 -> j2021416394;
	j1257788436 [label="Minha nossa, quando você coloca dessa forma, não é nada surpresa… parece até uma daquelas piadas infantis, n'est-ce pas?",shape=box,color=blue];
		j1257788436 -> j2826822309;
	j1422639869 [label="Oui, oui. Uma vez por semana? Uma vez a cada 2 meses? O maior período que o vi ficar sem uma foi de 6 meses, eu acho.",shape=box,color=blue];
		j1422639869 -> j547018639;
	j562693245 [label="Ah! Céus… hmm, pense em uma dor de cabeça, mas bem mais intensa. Já ouvi alguns chamá-la de dor de cefaleia biliosa, é mais comum em mulheres.",shape=box,color=blue];
		j562693245 -> j2493557378;
		j562693245 -> j3213647961;
	j2021416394 [label="O mundo está caminhando depressa para se tornar um lugar sombrio e escuro, com sofrimento a todo momento.",shape=box,color=blue];
		j2021416394 -> j1649186002;
	j2826822309 [label="Uma Irmã, um Padre e um demônio do futuro são enviados ao passado… e depois ao futuro… e encontram um peixe, um cervo, um pássaro gigante e um mordomo…",shape=box,color=blue];
		j2826822309 -> j3113452941;
	j547018639 [label="Check boolean Megrim",color=orange];
		j547018639 -> j1561275956 [label=true,color=green];
		j547018639 -> j3433373583 [label=true,color=green];
		j547018639 -> j2998783778 [label=true,color=green];
		j547018639 -> j1561275956 [label=false,color=brown];
		j547018639 -> j3433373583 [label=false,color=brown];
		j547018639 -> j2133186082 [label=false,color=brown];
	j2493557378 [label="Acho que a gente chama isso de \"enxaqueca\" hoje em dia",shape=box,color=red];
		j2493557378 -> j2335367001;
	j3213647961 [label="Megrims… anotado, valeu",shape=box,color=red];
		j3213647961 -> j2331544314;
	j1649186002 [label="Devemos buscar qualquer brilho, qualquer leviandade que pudermos… até mesmo na forma de infantilidade, se necessário.",shape=box,color=blue];
		j1649186002 -> j3921021729;
	j3113452941 [label="É bem cativante, tenho que concordar!",shape=box,color=blue];
		j3113452941 -> j3135395779;
	j1561275956 [label="O que será que faz isso acontecer?",shape=box,color=red];
		j1561275956 -> j1231059174;
	j3433373583 [label="Isso parece horrível…",shape=box,color=red];
		j3433373583 -> j941629092;
	j2998783778 [label="Eu também tenho megrims, é terrível",shape=box,color=red];
		j2998783778 -> j2369609549;
	j2133186082 [label="Eu também tenho esse tipo de dor de cabeça, é terrível",shape=box,color=red];
		j2133186082 -> j2369609549;
	j2335367001 [label="Mal posso imaginar que outras particularidades históricas fascinantes descobriremos! Adoro aprender coisas novas. \"Enxaqueca.\"",shape=box,color=blue];
		j2335367001 -> j1934616079;
	j2331544314 [label="Boolean Megrim is now true.",color=orange];
		j2331544314 -> j2473691952;
	j3921021729 [label="Adoraria que o Lyon visse as coisas da mesma forma.",shape=box,color=blue];
		j3921021729 -> j1099179352;
	j3135395779 [label="Adoraria que o meu querido Lyon visse o brilho nisso da mesma forma.",shape=box,color=blue];
		j3135395779 -> j1099179352;
	j1231059174 [label="Ele tem suas teorias. ",shape=box,color=blue];
		j1231059174 -> j3807229174;
	j941629092 [label="Se você expressar suas condolências, tenho certeza de que elas serão bem-vindas. E, apesar do que possa parecer, ele apreciará a companhia.",shape=box,color=blue];
		j941629092 -> j1713355942;
	j2369609549 [label="Sério? Você deveria contar ao Lyon. Ele precisa saber que outros são capazes de sofrer como ele.",shape=box,color=blue];
		j2369609549 -> j1897106249;
	j1934616079 [label="Boolean Migraine is now true.",color=orange];
		j1934616079 -> j2473691952;
	j2473691952 [label="Não importa o nome. O Lyon está com uma, e assim permanecerá, até de manhã. O pobre homem não consegue enxergar nada além de um borrão, nem sentir as mãos ou os pés. E ele me diz que a dor é insuportável.",shape=box,color=blue];
		j2473691952 -> j547018639;
	j1099179352 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j1099179352 -> j1649984412;
	j3807229174 [label="Embora seja mais correto dizer que ele \"tinha\" suas teorias, até recentemente.",shape=box,color=blue];
		j3807229174 -> j981005246;
	j1713355942 [label="Embora seu comportamento possa tentar dissuadi-lo, imploro que se mantenha firme, Peregrino. Há um homem, com grande necessidade de ajuda, enterrado sob o que parece uma aparência estoica e rígida.",shape=box,color=blue];
		j1713355942 -> j3585710457;
		j1713355942 -> j2860648421;
		j1713355942 -> j1049850485;
	j1897106249 [label="+5 Chemistry",color=orange];
		j1897106249 -> j1817452211;
	j1649984412 [label="Ah, falando nisso, me sinto péssima por reclamar de dores de cabeça. Preciso levar o jantar para o Lyon hoje à noite, ele está de cama novamente por causa de uma megrim terrível.",shape=box,color=blue];
		j1649984412 -> j2879242040;
		j1649984412 -> j2610942050;
	j981005246 [label="Boolean MarieLyonFaith1 is now true.",color=orange];
		j981005246 -> j1713355942;
	j3585710457 [label="Relaxa, teimosia e persistência são meus sobrenomes",shape=box,color=red];
		j3585710457 -> j1853656879;
	j2860648421 [label="Eu já tenho um Homem na Parede na minha vida… que mal faz ter mais um?",shape=box,color=red];
		j2860648421 -> j1701685647;
	j1049850485 [label="Ele é um homem adulto. Se ele quiser falar, ele vai.",shape=box,color=red];
		j1049850485 -> j924931257;
	j1817452211 [label="Os Luminários sabem que, mesmo assim, ele sofreria sozinho de bom grado…",shape=box,color=blue];
		j1817452211 -> j627617448;
	j1853656879 [label="+5 Chemistry",color=orange];
		j1853656879 -> j2692876413;
	j1701685647 [label="Brinque comigo desse jeito, mas não faça esse tipo de comentário com ele. O assunto da sua Indiferença é bem delicado para ele.",shape=box,color=blue];
		j1701685647 -> j1210856935;
	j924931257 [label="Ele é adulto, sim. Ele é um homem, sim. E acredito que ele quer falar. Mas desafio você a questionar se ele \"consegue\" falar.",shape=box,color=blue];
		j924931257 -> j649301214;
	j627617448 [label="Boolean MarieLyonSuffering2 is now true.",color=orange];
		j627617448 -> j1713355942;
	j2692876413 [label="Receio que você vá precisar disso com ele. Obrigada, Peregrino. Ele é meu amigo mais querido, e como um irmão para mim. E parte meu coração vê-lo sofrendo tanto.",shape=box,color=blue];
		j2692876413 -> j2565983899;
	j1210856935 [label="Seja resiliente, paciente e gentil. Ele é como um irmão para mim, é meu amigo mais querido, Peregrino. Me parte o coração vê-lo sofrendo tanto.",shape=box,color=blue];
		j1210856935 -> j2565983899;
	j649301214 [label="Nem todos somos igualmente talentosos ou sentimos que temos direito a tais coisas. Ele está sofrendo… acredita que o sofrimento é seu destino.",shape=box,color=blue];
		j649301214 -> j55024538;
	j2565983899 [label="Falaremos novamente em breve. Par la grâce de Sol.",shape=box,color=blue];
		j2565983899 -> "Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j55024538 [label="Ele também é como um irmão para mim, é meu amigo mais querido. Meu coração se parte por ele. Então, eu só posso pedir que você… seja paciente e gentil, se você for capaz.",shape=box,color=blue];
		j55024538 -> j2565983899;
	"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
