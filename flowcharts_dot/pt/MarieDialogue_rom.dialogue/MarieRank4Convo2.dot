		j3080931226 -> j3528620003 [label=false,color=brown];
	j910108880 [label="Non, sempre senti simplesmente como se houvesse uma presença em minha vida, que estava lá para me guiar. Um benfeitor que sorri e aponta quando chego à encruzilhada… nada mais.",shape=box,color=blue];
		j910108880 -> j1335703097;
