	j2299498444 [label="Temo que minha resposta possa decepcioná-lo, lobo. Não houve nenhum grande milagre, nenhum raio do céu brilhou sobre mim.",shape=box,color=blue];
		j2299498444 -> j910108880;
	j3684928500 [label="\"Por que essa jovem sensata acredita em coisas que eu não acho que sejam reais e que acho idiotas?\"",shape=box,color=blue];
