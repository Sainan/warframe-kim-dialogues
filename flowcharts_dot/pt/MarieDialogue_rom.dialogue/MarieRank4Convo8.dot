		j2443597249 -> j4072104183;
	j4217122461 [label="+5 Chemistry",color=orange];
		j4217122461 -> j241999555;
	j2219276497 [label="Mas afinal, de onde saiu essa curiosidade?",shape=box,color=red];
		j2219276497 -> j3470409356;
	j3669127791 [label="Espero que você conheça ele um dia",shape=box,color=red];
		j3669127791 -> j2910304695;
	j365059909 [label="Merci! À la revoyure!",shape=box,color=blue];
		j365059909 -> "Chat ends.";
	j4072104183 [label="Ah! É um dos Ritos da Lua. No aniversário da passagem de uma alma, trança-se uma coroa ou guirlanda de flores e coloca-se sobre o crânio ou túmulo dela. ",shape=box,color=blue];
		j4072104183 -> j1989223622;
	j241999555 [label="Merci, pode deixar! À la revoyure!",shape=box,color=blue];
		j241999555 -> "Chat ends.";
	j2910304695 [label="Oui, mas não é o silêncio dele que me incomoda. Perguntei ao Monsieur Necraloid se o crânio que o adornava pertenceu a uma alma viva em algum momento ou não.",shape=box,color=blue];
		j2910304695 -> j3165405053;
	j1989223622 [label="As criptas tradicionais para os mortos tinham frequentemente os corpos expostos, oui? Então, nós fazíamos isso. Acho que parte disso ocorre até os dias de hoje.",shape=box,color=blue];
		j1989223622 -> j2144997560;
	j2144997560 [label="Vejo isso refletido em algumas obras de arte dos Orokin, especialmente considerando o amor deles por caveiras. ",shape=box,color=blue];
		j2144997560 -> j1686157878;
		j2144997560 -> j2640362164;
		j2144997560 -> j108072372;
	j1686157878 [label="É… isso explica muita coisa",shape=box,color=red];
		j1686157878 -> j562334241;
	j2640362164 [label="Quanto mais o tempo passa, menos as coisas mudam, né?",shape=box,color=red];
		j2640362164 -> j562334241;
	j108072372 [label="Acho que a filha já tentou fazer isso antes, você vai deixar ela com ciúmes",shape=box,color=red];
		j108072372 -> j3780479939;
	j562334241 [label="Oui! Tanto tempo se passou, e ainda assim, tal costume permanece vivo. Fico feliz em saber que pequenos fragmentos sobreviveram.",shape=box,color=blue];
		j562334241 -> j684780836;
	j3780479939 [label="Oui? Então, estou ansiosa pelo dia em que poderei conhecê-la! Vou dizer a ela que não dei chance a ele.",shape=box,color=blue];
		j3780479939 -> j684780836;
	j684780836 [label="Caveira falsa ou não, o Monsieur Necraloid deveria ter uma coroa. E ele fica tão tímido quando eu o elogio! Ele ficaria até corado, se pudesse. Isso me faz sorrir.",shape=box,color=blue];
		j684780836 -> j3429743066;
	j3429743066 [label="À la revoyure!",shape=box,color=blue];
		j3429743066 -> "Chat ends.";
