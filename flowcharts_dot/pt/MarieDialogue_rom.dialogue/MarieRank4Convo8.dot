		j1425435756 -> j1879634420;
	j1369748457 [label="Mais uma prova de que o diabo e seus semelhantes mereceram ser condenados. Mas talvez você tenha razão sobre o Otak e seus semelhantes… ou talvez acreditar nisso lhe traga paz.",shape=box,color=blue];
		j1369748457 -> j4245505673;
	j4245505673 [label="E posso estar enganada, no fim das contas. Não há mal algum em agir com gentileza e respeito.",shape=box,color=blue];
		j4245505673 -> j2405445692;
	j464533682 [label="Talvez você tenha razão, mas não creio que os demônios Orokin compreendessem mais sobre o funcionamento das almas do que nós… eles não eram deuses.",shape=box,color=blue];
		j464533682 -> j4245505673;
