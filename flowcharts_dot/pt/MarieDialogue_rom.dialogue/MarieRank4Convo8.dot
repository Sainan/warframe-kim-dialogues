		j1164817000 -> j1888275162;
	j1879634420 [label="+5 Chemistry",color=orange];
		j1879634420 -> j1761764956;
	j2405445692 [label="Vou voltar a trançar uma coroa de flores para o Monsieur Necraloid. Ele não gostou, mas não terá como recusar tal presente meu!",shape=box,color=blue];
		j2405445692 -> j1825095378;
		j2405445692 -> j2283539658;
		j2405445692 -> j2861468227;
	j3134774711 [label="Boolean MarieOtak1 is now true.",color=orange];
		j3134774711 -> j3951815689;
	j1107161344 [label="Oui, isso é muito sábio. Estou somente pensando em voz alta e me perguntando o que ele é. Você tem toda a razão, não há mal algum em demonstrar gentileza e respeito.",shape=box,color=blue];
		j1107161344 -> j1968181492;
	j1888275162 [label="Talvez você tenha razão, e espero que tenha! Seja lá qual for o caso, precisamos ser gentis, pois ele é uma criatura pensante. E o que pode pensar, pode sentir.",shape=box,color=blue];
		j1888275162 -> j1968181492;
	j1761764956 [label="Seja lá qual for o caso, precisamos ser gentis, pois ele é uma criatura pensante. E o que pode pensar, pode sentir.",shape=box,color=blue];
		j1761764956 -> j4245505673;
	j1825095378 [label="Isso é adorável",shape=box,color=red];
