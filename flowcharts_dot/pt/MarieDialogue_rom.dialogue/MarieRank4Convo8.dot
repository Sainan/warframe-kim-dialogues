		j1717149828 -> j1425435756;
	j1298479458 [label="+5 Chemistry",color=orange];
		j1298479458 -> j1369748457;
	j2477346479 [label="Ah, não pense que quero que você seja cruel! Não! Valorize-os, pois são preciosos! E não por sentir culpa pelo que eles são!",shape=box,color=blue];
		j2477346479 -> j4245505673;
