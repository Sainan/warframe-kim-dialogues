	1934 [label="Perguntei ao Monsieur Necraloid se o crânio que o adornava pertenceu a uma alma viva em algum momento ou não.",shape=box,color=blue];
		1934 -> 1936;
	1932 [label="Fico curiosa para saber o motivo de ter outro rosto em suas costas, parecidos com rabiscos de criança.",shape=box,color=blue];
		1932 -> 1935;
	1933 [label="Chat ends.",color=orange];
	1936 [label="E o Monsieur Necraloid me disse que era o crânio \"dele\", embora ele admitisse que o Monsieur Loid era o \"original\". O Monsieur Loid interrompeu para me dizer que era uma \"réplica\" do seu próprio crânio.",shape=box,color=blue];
		1936 -> 1938;
	1935 [label="Perguntei ao Monsieur Necraloid e ao Monsieur Loid, e nenhum deles quis falar sobre o assunto, apenas me disseram um nome. Otak. E foi com grande tristeza que o pronunciaram.",shape=box,color=blue];
		1935 -> 1937;
	1938 [label="Como pode isso? E o que significa ser uma \"réplica\"? É um crânio de verdade, ou é falso? Por que o Monsieur Necraloid e o Monsieur Loid teriam respostas diferentes?",shape=box,color=blue];
		1938 -> 1940;
		1938 -> 1941;
		1938 -> 1942;
	1937 [label="E aqui estou eu, falando com você, na esperança de que possa me ajudar.",shape=box,color=blue];
		1937 -> 1939;
	1940 [label="Acho que, do ponto de vista do Necraloid, o crânio é original dele mesmo. Já do ponto de vista do Loid, é só uma réplica",shape=box,color=red];
		1940 -> 1944;
	1941 [label="Sinceramente, não sei do que aquilo é feito. Pode ser osso, ou algum tipo de polímero…",shape=box,color=red];
		1941 -> 1945;
	1942 [label="Acho que o que você quer realmente saber é se \"o Necraloid é real\", e não se \"o crânio é real\", certo?",shape=box,color=red];
		1942 -> 1946;
	1939 [label="Poderia me contar a história do pobre Monsieur Otak?",shape=box,color=blue];
		1939 -> 1943;
	1944 [label="Acho que é isso que me incomoda, a forma como ambos os cavalheiros enxergam suas origens. Um acredita ser o sacrosancte, o outro, uma cópia.",shape=box,color=blue];
		1944 -> 1948;
	1945 [label="Não sei se é o material do crânio que me preocupa, mas sim sua origem. Ou talvez a forma como ambos os cavalheiros enxergam suas origens. Um acredita ser sacrossanto, o outro, uma cópia.",shape=box,color=blue];
		1945 -> 1948;
