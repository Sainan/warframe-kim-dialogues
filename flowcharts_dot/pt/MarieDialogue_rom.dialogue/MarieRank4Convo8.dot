		1614 -> 1617;
	1615 [label="Ah! É um dos Direitos da Lua. No aniversário da passagem de uma alma, trança-se uma coroa ou guirlanda de flores e coloca-se sobre o crânio ou túmulo dela. ",shape=box,color=blue];
