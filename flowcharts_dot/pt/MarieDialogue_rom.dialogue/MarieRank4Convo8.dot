	"MarieRank4Convo8 begins." [color=orange];
		"MarieRank4Convo8 begins." -> j2786051379;
	j2786051379 [label="Check boolean MarieOtak1",color=orange];
		j2786051379 -> j4083261446 [label=true,color=green];
		j2786051379 -> j777214856 [label=false,color=brown];
	j4083261446 [label="Peregrino, quanto mais me aprofundo no conhecimento do Monsieur Necraloid e do Monsieur Otak, mais isso me incomoda…",shape=box,color=blue];
		j4083261446 -> j2800862703;
		j4083261446 -> j3387104404;
	j777214856 [label="Peregrino, posso falar com você?",shape=box,color=blue];
		j777214856 -> j89928817;
		j777214856 -> j17348121;
	j2800862703 [label="Como assim?",shape=box,color=red];
		j2800862703 -> j3470409356;
	j3387104404 [label="Qual é o problema em específico?",shape=box,color=red];
		j3387104404 -> j3470409356;
	j89928817 [label="Sem problemas, qual a boa?",shape=box,color=red];
		j89928817 -> j3893229002;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j3470409356 [label="Perguntei ao Monsieur Necraloid se o crânio que o adornava pertenceu a uma alma viva em algum momento ou não.",shape=box,color=blue];
		j3470409356 -> j3165405053;
	j3893229002 [label="Fico curiosa para saber o motivo de ter outro rosto em suas costas, parecidos com rabiscos de criança.",shape=box,color=blue];
		j3893229002 -> j3435842483;
	"Chat ends." [color=orange];
	j3165405053 [label="E o Monsieur Necraloid me disse que era o crânio \"dele\", embora ele admitisse que o Monsieur Loid era o \"original\". O Monsieur Loid interrompeu para me dizer que era uma \"réplica\" do seu próprio crânio.",shape=box,color=blue];
		j3165405053 -> j1961926654;
	j3435842483 [label="Perguntei ao Monsieur Necraloid e ao Monsieur Loid, e nenhum deles quis falar sobre o assunto, apenas me disseram um nome. Otak. E foi com grande tristeza que o pronunciaram.",shape=box,color=blue];
		j3435842483 -> j2618967342;
	j1961926654 [label="Como pode isso? E o que significa ser uma \"réplica\"? É um crânio de verdade, ou é falso? Por que o Monsieur Necraloid e o Monsieur Loid teriam respostas diferentes?",shape=box,color=blue];
		j1961926654 -> j4227814543;
		j1961926654 -> j308348586;
		j1961926654 -> j3489669579;
	j2618967342 [label="E aqui estou eu, falando com você, na esperança de que possa me ajudar.",shape=box,color=blue];
		j2618967342 -> j3251149075;
	j4227814543 [label="Acho que, do ponto de vista do Necraloid, o crânio é original dele mesmo. Já do ponto de vista do Loid, é só uma réplica",shape=box,color=red];
		j4227814543 -> j3969699929;
	j308348586 [label="Sinceramente, não sei do que aquilo é feito. Pode ser osso, ou algum tipo de polímero…",shape=box,color=red];
		j308348586 -> j933097549;
	j3489669579 [label="Acho que o que você quer realmente saber é se \"o Necraloid é real\", e não se \"o crânio é real\", certo?",shape=box,color=red];
		j3489669579 -> j3592450176;
	j3251149075 [label="Poderia me contar a história do pobre Monsieur Otak?",shape=box,color=blue];
		j3251149075 -> j3313707415;
	j3969699929 [label="Acho que é isso que me incomoda, a forma como ambos os cavalheiros enxergam suas origens. Um acredita ser o sacrosancte, o outro, uma cópia.",shape=box,color=blue];
		j3969699929 -> j3408858168;
	j933097549 [label="Não sei se é o material do crânio que me preocupa, mas sim sua origem. Ou talvez a forma como ambos os cavalheiros enxergam suas origens. Um acredita ser sacrossanto, o outro, uma cópia.",shape=box,color=blue];
		j933097549 -> j3408858168;
	j3592450176 [label="+5 Chemistry",color=orange];
		j3592450176 -> j555713645;
	j3313707415 [label="O Otak era um Arquimediano, um cientista e acadêmico Orokin. O que aconteceu com ele não é exatamente uma história muito feliz…",shape=box,color=red];
		j3313707415 -> j4069948846;
	j3408858168 [label="Evaluate expressions",color=orange];
		j3408858168 -> j1753789613 [label="MarieCephalonSoul",color=purple];
		j3408858168 -> j3859207670 [label="MarieCephalonNoSoul",color=purple];
		j3408858168 -> j1219848035 [label="MarieCephalonUnsure",color=purple];
		j3408858168 -> j2307458219 [label="false",color=purple];
	j555713645 [label="Oui! É exatamente isso que me incomoda. Um acredita ser sacrossanto, o outro, uma cópia.",shape=box,color=blue];
		j555713645 -> j3408858168;
	j4069948846 [label="Segundo relatos, ele era um gênio. A mente por trás do estudo e uso dos cristais de argônio e tudo mais",shape=box,color=red];
		j4069948846 -> j684392099;
	j1753789613 [label="Como pode o Monsieur Necraloid possuir uma alma, se ele não possui sequer seus próprios ossos?",shape=box,color=blue];
		j1753789613 -> j1416809515;
		j1753789613 -> j2282274297;
		j1753789613 -> j2927977238;
	j3859207670 [label="Seria isso outra prova de que o Monsieur Necraloid não tem alma?",shape=box,color=blue];
		j3859207670 -> j1416809515;
		j3859207670 -> j2282274297;
		j3859207670 -> j2927977238;
	j1219848035 [label="Sei que você não tem certeza se o Monsieur Necraloid pode ter alma, mas não sei como ele poderia ter, se não possui sequer os próprios ossos.",shape=box,color=blue];
		j1219848035 -> j1416809515;
		j1219848035 -> j2282274297;
		j1219848035 -> j2927977238;
	j2307458219 [label="Ele é só uma peça de tecnologia muito sofisticada, feita para se assemelhar a um homem, não é? Um fonógrafo, só que bem mais complexo.",shape=box,color=blue];
		j2307458219 -> j2278139875;
		j2307458219 -> j2612160978;
		j2307458219 -> j1174418540;
		j2307458219 -> j3840480732;
		j2307458219 -> j743210527;
	j684392099 [label="Que são extraídos do Void e são a razão pela qual podemos criar muitos dos poderosos Warframes e armas que temos",shape=box,color=red];
		j684392099 -> j3612023364;
	j1416809515 [label="Talvez você tenha razão, talvez ele seja só uma cópia. Mas não tenho certeza disso, e temos que tratar ele como se fosse uma pessoa, e não um objeto",shape=box,color=red];
		j1416809515 -> j301708673;
	j2282274297 [label="Acho que o Necraloid é a exceção, e não a regra. Ele foi criado como uma réplica de uma pessoa, não a partir de uma pessoa",shape=box,color=red];
		j2282274297 -> j3975507035;
	j2927977238 [label="Você tem razão. Provavelmente seria melhor (e mais humano) se não fossem almas presas dentro de um aparato científico complexo…",shape=box,color=red];
		j2927977238 -> j1933116214;
	j2278139875 [label="O Necraloid pode até não ter alma, mas é único. Outros Cephalons, como o Otak, já tiveram alma… mas elas foram destruídas durante sua criação",shape=box,color=red];
		j2278139875 -> j1102150939;
	j2612160978 [label="Você tem razão, mas… o que quer que eu faça?",shape=box,color=red];
		j2612160978 -> j3987529408;
	j1174418540 [label="Você tem razão, eles não têm alma… mas isso não é motivo para tratar eles como objetos",shape=box,color=red];
		j1174418540 -> j2721756405;
	j3840480732 [label="Não sei se você tá certa ou não… mas eles ainda conseguem pensar e sentir, e não podemos simplesmente tratar eles como objetos",shape=box,color=red];
		j3840480732 -> j277727280;
	j743210527 [label="O Necraloid tem alma, todos os Cephalons têm",shape=box,color=red];
		j743210527 -> j4228156749;
	j3612023364 [label="Ele se especializou em cristalografia, e seus trabalhos foram todos arquivados aqui, nos laboratórios",shape=box,color=red];
		j3612023364 -> j559709798;
