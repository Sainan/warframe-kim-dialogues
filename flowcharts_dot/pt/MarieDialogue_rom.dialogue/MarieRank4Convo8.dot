	1556 [label="Que são extraídos do Void e são a razão pela qual podemos criar muitos dos poderosos Warframes e armas que temos",shape=box,color=red];
		1556 -> 1561;
	1562 [label="Talvez você tenha razão, talvez ele seja só uma cópia. Mas não tenho certeza disso, e temos que tratar ele como se fosse uma pessoa, e não um objeto",shape=box,color=red];
		1562 -> 1571;
	1563 [label="Acho que o Necraloid é a exceção, e não a regra. Ele foi criado como uma réplica de uma pessoa, não a partir de uma pessoa",shape=box,color=red];
		1563 -> 1572;
	1564 [label="Você tem razão. Provavelmente seria melhor (e mais humano) se não fossem almas presas dentro de um aparato científico complexo…",shape=box,color=red];
		1564 -> 1573;
	1565 [label="O Necraloid pode até não ter alma, mas é único. Outros Cephalons, como o Otak, já tiveram alma… mas elas foram destruídas durante sua criação",shape=box,color=red];
