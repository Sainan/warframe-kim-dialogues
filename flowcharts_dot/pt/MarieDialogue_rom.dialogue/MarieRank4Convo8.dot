	j100076849 [label="+5 Chemistry",color=orange];
		j100076849 -> j2834674037;
	j3179668064 [label="Nem todo Cephalon foi feito com o objetivo de punir alguém. Mas as coisas meio que… desandaram aqui em Deimos, e ele acabou ficando bem danificado",shape=box,color=red];
		j3179668064 -> j1183291755;
