		1616 -> 1617;
	1609 [label="Oui, mas não é o silêncio dele que me incomoda. Perguntei ao Monsieur Necraloid se o crânio que o adornava pertenceu a uma alma viva em algum momento ou não.",shape=box,color=blue];
		1609 -> 1936;
	1617 [label="Chat ends.",color=orange];
	1618 [label="As criptas tradicionais para os mortos tinham frequentemente os corpos expostos, oui? Então, nós fazíamos isso. Acho que parte disso ocorre até os dias de hoje.",shape=box,color=blue];
		1618 -> 1619;
	1619 [label="Vejo isso refletido em algumas obras de arte dos Orokin, especialmente considerando o amor deles por caveiras. ",shape=box,color=blue];
		1619 -> 1620;
		1619 -> 1621;
		1619 -> 1622;
	1620 [label="É… isso explica muita coisa",shape=box,color=red];
		1620 -> 1623;
	1621 [label="Quanto mais o tempo passa, menos as coisas mudam, né?",shape=box,color=red];
		1621 -> 1623;
	1622 [label="Acho que a filha já tentou fazer isso antes, você vai deixar ela com ciúmes",shape=box,color=red];
		1622 -> 1624;
	1623 [label="Oui! Tanto tempo se passou, e ainda assim, tal costume permanece vivo. Fico feliz em saber que pequenos fragmentos sobreviveram.",shape=box,color=blue];
		1623 -> 1625;
	1624 [label="Oui? Então, estou ansiosa pelo dia em que poderei conhecê-la! Vou dizer a ela que não dei chance a ele.",shape=box,color=blue];
		1624 -> 1625;
	1625 [label="Caveira falsa ou não, o Monsieur Necraloid deveria ter uma coroa. E ele fica tão tímido quando eu o elogio! Ele ficaria até corado, se pudesse. Isso me faz sorrir.",shape=box,color=blue];
		1625 -> 1626;
	1626 [label="À la revoyure!",shape=box,color=blue];
