		1559 -> 1562;
		1559 -> 1563;
		1559 -> 1564;
	1560 [label="Ele é só uma peça de tecnologia muito sofisticada, feita para se assemelhar a um homem, não é? Um fonógrafo, só que bem mais complexo.",shape=box,color=blue];
