	2928 [label="Chat ends.",color=orange];
	1025 [label="Especialmente porque faço isso avec une certaine joie, coisa que ninguém parece fazer.",shape=box,color=blue];
		1025 -> 1026;
		1025 -> 1027;
	1026 [label="Então, sobre o que você quer saber?",shape=box,color=red];
		1026 -> 1028;
	1027 [label="Bem… lá em cima tem a Mãe, o Pai, o Filho, a Filha e a Avó",shape=box,color=red];
		1027 -> 1028;
	1028 [label="Me conta uma coisa primeiro? O diabo ri de mim toda vez que pergunto, como se fosse uma piada interna. Grand-mère, a Avó:",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="Essa é a esposa do Cardeal?",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="Não, essa é a mãe do Pai, a sogra da Mãe",shape=box,color=red];
		1030 -> 1031;
	1031 [label="Je… vois. E… por que eles não usam seus nomes? Ne serait-ce pas plus simple?",shape=box,color=blue];
		1031 -> 1032;
		1031 -> 1033;
	1032 [label="Quer a versão longa da história?",shape=box,color=red];
		1032 -> 1034;
