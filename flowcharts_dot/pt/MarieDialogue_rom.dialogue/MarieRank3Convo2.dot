		1034 -> 1036;
	1035 [label="A família lá de cima ficou presa aqui quando o Império Orokin entrou em colapso. O Filho, neto do Entrati, deixou a Infestação entrar",shape=box,color=red];
		1035 -> 1037;
	1036 [label="Bem… estamos em uma lua, chamada Deimos. E uma bomba biológica foi detonada aqui, há muito tempo, numa tentativa desesperada de derrotar os Sentients",shape=box,color=red];
		1036 -> 1038;
	1037 [label="Santo Sol! Foi de propósito?",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="Aqueles com quem os Orokin estavam em guerra? Aqueles que vemos no Refratário Obscuro com o diabo?",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
