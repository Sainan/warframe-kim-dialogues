digraph {
	"MarieRank3Convo2 begins." [color=orange];
		"MarieRank3Convo2 begins." -> j3102612293;
	j3102612293 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3102612293 -> j369807617;
	j369807617 [label="Check boolean LoidFamilyComplete",color=orange];
		j369807617 -> j4064138808 [label=true,color=green];
		j369807617 -> j1668831657 [label=false,color=brown];
	j4064138808 [label="Espero que não me considere frágil, mas… às vezes, tenho uma sensação muito estranha, como se já tivesse feito isso antes.",shape=box,color=blue];
		j4064138808 -> j3973580378;
	j1668831657 [label="Check boolean MarieFamily1",color=orange];
		j1668831657 -> j4205063720 [label=true,color=green];
		j1668831657 -> j4067908765 [label=false,color=brown];
	j3973580378 [label="Tive essas conversas… conheci essas pessoas… embora seja impossível, non?",shape=box,color=blue];
		j3973580378 -> j1924848903;
	j4205063720 [label="Você poderia me contar mais sobre a família do Cardeal? Fico fascinada em saber sobre o passado dele.",shape=box,color=blue];
		j4205063720 -> j1617327399;
		j4205063720 -> j1264386918;
		j4205063720 -> j17348121;
	j4067908765 [label="Você poderia me contar sobre a família do Cardeal? Fico fascinada em saber sobre o passado dele.",shape=box,color=blue];
		j4067908765 -> j1617327399;
		j4067908765 -> j1264386918;
		j4067908765 -> j17348121;
	j1924848903 [label="+20 Chemistry",color=orange];
		j1924848903 -> j424339927;
	j1617327399 [label="Posso te contar tudo o que sei, mas acho que não é tanto quanto você imagina",shape=box,color=red];
		j1617327399 -> j105339996;
	j1264386918 [label="Claro, tudo bem, mas… o Loid não seria uma pessoa melhor pra falar sobre isso?",shape=box,color=red];
		j1264386918 -> j102884059;
	j17348121 [label="[Encerrar Conversa]",shape=box,color=red];
		j17348121 -> "Chat ends.";
	j424339927 [label="Chamamos isso de déjà vu. Deve ser por causa do soro e da viagem no tempo. C'est la vie!",shape=box,color=blue];
		j424339927 -> "Chat ends.";
	j105339996 [label="Tudo o que você puder compartilhar, ouvirei com carinho. Prometo!",shape=box,color=blue];
		j105339996 -> j1883596589;
	j102884059 [label="Falando do Cardeal… parece que falar sobre isso magoa profundamente o Monsieur Loid. Não gosto de abusar disso.",shape=box,color=blue];
		j102884059 -> j1883596589;
	"Chat ends." [color=orange];
	j1883596589 [label="Especialmente porque faço isso avec une certaine joie, coisa que ninguém parece fazer.",shape=box,color=blue];
		j1883596589 -> j2937273263;
		j1883596589 -> j1810939195;
	j2937273263 [label="Então, sobre o que você quer saber?",shape=box,color=red];
		j2937273263 -> j866453879;
	j1810939195 [label="Bem… lá em cima tem a Mãe, o Pai, o Filho, a Filha e a Avó",shape=box,color=red];
		j1810939195 -> j866453879;
	j866453879 [label="Me conta uma coisa primeiro? O diabo ri de mim toda vez que pergunto, como se fosse uma piada interna. Grand-mère, a Avó:",shape=box,color=blue];
		j866453879 -> j654776604;
	j654776604 [label="Essa é a esposa do Cardeal?",shape=box,color=blue];
		j654776604 -> j4244969669;
	j4244969669 [label="Não, essa é a mãe do Pai, a sogra da Mãe",shape=box,color=red];
		j4244969669 -> j2440787678;
	j2440787678 [label="Je… vois. E… por que eles não usam seus nomes? Ne serait-ce pas plus simple?",shape=box,color=blue];
		j2440787678 -> j2212723836;
		j2440787678 -> j2359382483;
	j2212723836 [label="Quer a versão longa da história?",shape=box,color=red];
		j2212723836 -> j190265145;
	j2359382483 [label="Vou te contar o resumo da ópera",shape=box,color=red];
		j2359382483 -> j859301601;
	j190265145 [label="Claro! Não tenho lugar nenhum para ir por enquanto.",shape=box,color=blue];
		j190265145 -> j4267466268;
	j859301601 [label="A família lá de cima ficou presa aqui quando o Império Orokin entrou em colapso. O Filho, neto do Entrati, deixou a Infestação entrar",shape=box,color=red];
		j859301601 -> j3448957863;
	j4267466268 [label="Bem… estamos em uma lua, chamada Deimos. E uma bomba biológica foi detonada aqui, há muito tempo, numa tentativa desesperada de derrotar os Sentients",shape=box,color=red];
		j4267466268 -> j2402481606;
	j3448957863 [label="Santo Sol! Foi de propósito?",shape=box,color=blue];
		j3448957863 -> j385755729;
	j2402481606 [label="Aqueles com quem os Orokin estavam em guerra? Aqueles que vemos no Refratário Obscuro com o diabo?",shape=box,color=blue];
		j2402481606 -> j4195880852;
	j385755729 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j385755729 -> j1836099096 [label=true,color=green];
		j385755729 -> j893225063 [label=true,color=green];
		j385755729 -> j893225063 [label=false,color=brown];
		j385755729 -> j3269724267 [label=false,color=brown];
	j4195880852 [label="Isso aí. Eles tentaram usar a Infestação pra combater os Sentients, mas Deimos foi invadida. Eles se trancaram no Necralisk (bem aqui em cima da gente) pra se esconder",shape=box,color=red];
		j4195880852 -> j3095225884;
	j1836099096 [label="Não, acho que foi um acidente, ele é gente boa",shape=box,color=red];
		j1836099096 -> j2419474599;
	j893225063 [label="Como ainda não sei toda a verdade, não vou julgar sem saber",shape=box,color=red];
		j893225063 -> j2419474599;
	j3269724267 [label="Ainda não sei toda a verdade, mas ele é bem arrogante, isso eu garanto",shape=box,color=red];
		j3269724267 -> j1430085562;
	j3095225884 [label="O Filho, neto do Entrati, queria muito tentar preservar e estudar os animais infestados",shape=box,color=red];
		j3095225884 -> j275452452;
	j2419474599 [label="+10 Chemistry",color=orange];
		j2419474599 -> j238382110;
	j1430085562 [label="Que pena… espero que não seja verdade, pelo bem dele e nosso. Prossiga, por favor.",shape=box,color=blue];
		j1430085562 -> j1248362924;
	j275452452 [label="Ah, Sol… ele tinha boas intenções com isso ?",shape=box,color=blue];
		j275452452 -> j240603373;
	j238382110 [label="Muito gentil da sua parte. Continuez, s'il vous plaît.",shape=box,color=blue];
		j238382110 -> j1248362924;
	j1248362924 [label="Bem… presos no Necralisk, consumidos pela dor, sem o Império Orokin, e com a Infestação se propagando…",shape=box,color=red];
		j1248362924 -> j4275543362;
	j240603373 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j240603373 -> j3304080330 [label=true,color=green];
		j240603373 -> j2512370768 [label=true,color=green];
		j240603373 -> j1815680744 [label=true,color=green];
		j240603373 -> j3304080330 [label=false,color=brown];
		j240603373 -> j2512370768 [label=false,color=brown];
		j240603373 -> j456046559 [label=false,color=brown];
	j4275543362 [label="Eles se voltaram uns contra os outros. Se despedaçaram de dentro pra fora. E a Infestação fez o resto, devorando até mesmo os nomes deles",shape=box,color=red];
		j4275543362 -> j454169729;
	j3304080330 [label="Acredito fortemente que sim, acho que ele realmente se importa com essas criaturas",shape=box,color=red];
		j3304080330 -> j4182227365;
	j2512370768 [label="Infelizmente, isso não importava, o estrago já tava feito",shape=box,color=red];
		j2512370768 -> j3340249700;
	j1815680744 [label="Não, foi a arrogância que inspirou isso, mesmo ele falando que foi um acidente",shape=box,color=red];
		j1815680744 -> j1430085562;
	j456046559 [label="Ainda não sei toda a verdade, mas ele é bem arrogante, isso eu garanto",shape=box,color=red];
		j456046559 -> j1430085562;
	j454169729 [label="É a forma máxima de crueldade, perder até seu próprio nome…",shape=box,color=blue];
		j454169729 -> j482800561;
	j4182227365 [label="+10 Chemistry",color=orange];
		j4182227365 -> j1724067882;
	j3340249700 [label="+5 Chemistry",color=orange];
		j3340249700 -> j1342545009;
	j482800561 [label="Boolean MarieFamily2 is now true.",color=orange];
		j482800561 -> j1436255400;
		j482800561 -> j3063243286;
		j482800561 -> j2820789780;
	j1724067882 [label="Me pergunto o que ele acharia das Cavias… uma pena ele não poder conhecê-las…",shape=box,color=blue];
		j1724067882 -> j2062576796;
		j1724067882 -> j3193338453;
	j1342545009 [label="Se a pureza das intenções de cada um fosse tudo o que importasse, o mundo seria um lugar lindo, non? C'est la vie.",shape=box,color=blue];
		j1342545009 -> j1647213382;
	j1436255400 [label="A menos que você abdique dele por conta própria, como a Avó",shape=box,color=red];
		j1436255400 -> j301231580;
	j3063243286 [label="Não é tão ruim assim, você se acostuma",shape=box,color=red];
		j3063243286 -> j2264031930;
	j2820789780 [label="Os animais não têm nomes e parecem bem felizes. Damos nomes a eles só por causa da gente mesmo",shape=box,color=red];
		j2820789780 -> j3078106380;
	j2062576796 [label="Até acho a ideia interessante, mas não seria prudente",shape=box,color=red];
		j2062576796 -> j3968414143;
	j3193338453 [label="Espero que isso aconteça algum dia, de verdade",shape=box,color=red];
		j3193338453 -> j1526667533;
	j1647213382 [label="Et ensuite?",shape=box,color=blue];
		j1647213382 -> j1248362924;
	j301231580 [label="+5 Chemistry",color=orange];
		j301231580 -> j2096252120;
	j2264031930 [label="Aaah! Quelle horreur! Não foi isso que quis dizer! Ah, que vergonha! Sinto muito, me perdoe, eu não quis dizer isso… ah, eu sou uma idiota!",shape=box,color=blue];
		j2264031930 -> j3397591971;
		j2264031930 -> j3368745996;
	j3078106380 [label="+5 Chemistry",color=orange];
		j3078106380 -> j2183744150;
	j3968414143 [label="Por quê?",shape=box,color=blue];
		j3968414143 -> j1748200257;
		j3968414143 -> j1279365636;
	j1526667533 [label="Add 1 to Family counter",color=orange];
		j1526667533 -> j788680427;
	j2096252120 [label="Ela parece uma moça que eu adoraria conhecer…",shape=box,color=blue];
		j2096252120 -> j3980674483;
	j3397591971 [label="Como você vai me compensar por isso?",shape=box,color=red];
		j3397591971 -> j1537101035;
	j3368745996 [label="Relaxa, só tô de sacanagem, isso não me incomoda",shape=box,color=red];
		j3368745996 -> j679649614;
	j2183744150 [label="É verdade! Nunca pensei nisso dessa forma. E você escolheu o seu. Um tanto libertador, de certa forma.",shape=box,color=blue];
		j2183744150 -> j3980674483;
	j1748200257 [label="Acho que uma metade da família vai ver o resto como \"a outra família\" dele",shape=box,color=red];
		j1748200257 -> j459352973;
	j1279365636 [label="A situação lá em cima é… bem frágil. Não quero causar mais problemas",shape=box,color=red];
		j1279365636 -> j545117544;
	j788680427 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j788680427 -> j1412031022 [label=true,color=green];
		j788680427 -> j1096575270 [label=false,color=brown];
	j3980674483 [label="Essa foi uma conversa maravilhosa, mas receio que seja a minha vez de servir o almoço. O Monsieur Loid está me ensinando a servir chá corretamente!",shape=box,color=blue];
		j3980674483 -> "Chat ends.";
	j1537101035 [label="Maintenant, vous parlez aussi mal que le diable. Não vou cair nos seus truques.",shape=box,color=blue];
		j1537101035 -> "Chat ends.";
	j679649614 [label="+5 Chemistry",color=orange];
		j679649614 -> j2377832471;
	j459352973 [label="Add 1 to Family counter",color=orange];
		j459352973 -> j2914827329;
	j545117544 [label="Você ficaria surpreso com a resiliência da alma das pessoas. E aqueles que me cercam agora são tão velhos, tão amadurecidos pelo tempo…",shape=box,color=blue];
		j545117544 -> j1619955981;
	j1412031022 [label="É possível, até mais fácil do que você imagina. Precisamos somente pensar no \"como\". ",shape=box,color=blue];
		j1412031022 -> j1337984008;
		j1412031022 -> j1279365636;
	j1096575270 [label="Oui? E como vai o seu trabalho (ou o da sua cópia minúscula) com a família lá em cima?",shape=box,color=blue];
		j1096575270 -> j529050946;
		j1096575270 -> j1279365636;
	j2377832471 [label="Ah, loué soit Sol! Mas isso levanta uma questão… você sabe de onde veio seu apelido? \"Le Peregrino?\"",shape=box,color=blue];
		j2377832471 -> j2756453097;
		j2377832471 -> j2300005301;
	j2914827329 [label="+5 Chemistry",color=orange];
		j2914827329 -> j2714505489;
	j1619955981 [label="+5 Chemistry",color=orange];
		j1619955981 -> j1035499195;
	j1337984008 [label="Só precisamos ter cuidado. Acho que uma metade da família vai ver o resto como \"a outra família\" dele",shape=box,color=red];
		j1337984008 -> j459352973;
	j529050946 [label="O processo é lento e delicado. Acho que uma metade da família vai ver o resto como \"a outra família\" dele",shape=box,color=red];
		j529050946 -> j459352973;
	j2756453097 [label="Espero ter escolhido eu mesmo",shape=box,color=red];
		j2756453097 -> j1228814728;
	j2300005301 [label="Sinceramente… não lembro",shape=box,color=red];
		j2300005301 -> j911296185;
	j2714505489 [label="Ah… par Sol, acho que você achou a solução!",shape=box,color=blue];
		j2714505489 -> j91829456;
	j1035499195 [label="Você já os surpreendeu muitas vezes. Deixe que eles o surpreendam desta vez.",shape=box,color=blue];
		j1035499195 -> j2231786119;
	j1228814728 [label="Escolher o próprio nome, isso seria libertador! Na Catedral, eu não podia nem escolher minhas próprias roupas!",shape=box,color=blue];
		j1228814728 -> j3980674483;
	j911296185 [label="Tantos mystères você traz consigo! ",shape=box,color=blue];
		j911296185 -> j3980674483;
	j91829456 [label="Boolean MarieFamilyOther is now true.",color=orange];
		j91829456 -> j1283117255;
	j2231786119 [label="Mas, por favor, por favor, s'il vous plaît, continue sua história. Sua lobinha Marie precisa conhecer sua presa antes de caçar de verdade, non?",shape=box,color=blue];
		j2231786119 -> j3155343285;
		j2231786119 -> j2128613868;
		j2231786119 -> j335035706;
	j1283117255 [label="Estou besta de tanta emoção! Je suis assise ici, remuant sur ma chaise!",shape=box,color=blue];
		j1283117255 -> j2231786119;
	j3155343285 [label="É… onde foi que eu parei?",shape=box,color=red];
		j3155343285 -> j3394754379;
	j2128613868 [label="Vindo de você, isso foi meio perverso, não acha?",shape=box,color=red];
		j2128613868 -> j2811720870;
	j335035706 [label="Talvez eu queira que você venha me caçar…",shape=box,color=red];
		j335035706 -> j2738235523;
	j3394754379 [label="O Filho trouxe os Animaux Infestés para perto demais.",shape=box,color=blue];
		j3394754379 -> j1248362924;
	j2811720870 [label="Peut-être! Um pouco de perversidade em nome do bem não faz mal a ninguém, não acha?",shape=box,color=blue];
		j2811720870 -> j140493786;
		j2811720870 -> j3162646326;
	j2738235523 [label="Boolean DrifterMarie is now true.",color=orange];
		j2738235523 -> j422851326;
	j140493786 [label="Certo… enfim, de volta à história",shape=box,color=red];
		j140493786 -> j1248362924;
	j3162646326 [label="Não me leve a mal, eu até gostei disso",shape=box,color=red];
		j3162646326 -> j2756166499;
	j422851326 [label="Você vai me arruinar! Eu soltei um gritinho audível e o Monsieur Loid perguntou se eu estava bem. Tive que mentir e dizer que vi um rato, só para ele me dizer que não temos ratos nesta época!",shape=box,color=blue];
		j422851326 -> j2146039982;
	j2756166499 [label="Hahaha! Imaginei que gostaria. Agora, chega de bobagens e vamos voltar à sua história. O Filho trouxe os Animaux Infestés para perto demais, oui?",shape=box,color=blue];
		j2756166499 -> j1248362924;
	j2146039982 [label="+5 Chemistry",color=orange];
		j2146039982 -> j1438896451;
	j1438896451 [label="Quelle méchanceté, tu es terrible! Je te déteste et tu me fais rougir maintenant!",shape=box,color=blue];
		j1438896451 -> j779981852;
		j1438896451 -> j140493786;
	j779981852 [label="Você tá brava comigo?",shape=box,color=red];
		j779981852 -> j3988239069;
	j3988239069 [label="Non! Continua sua história!",shape=box,color=blue];
		j3988239069 -> j1248362924;
}