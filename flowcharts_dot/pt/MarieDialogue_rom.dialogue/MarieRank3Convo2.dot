		1039 -> 1042 [label=true,color=green];
		1039 -> 1042 [label=false,color=brown];
		1039 -> 1043 [label=false,color=brown];
	1040 [label="Isso aí. Eles tentaram usar a Infestação pra combater os Sentients, mas Deimos foi invadida. Eles se trancaram no Necralisk (bem aqui em cima da gente) pra se esconder",shape=box,color=red];
		1040 -> 1044;
	1041 [label="Não, acho que foi um acidente, ele é gente boa",shape=box,color=red];
		1041 -> 1045;
