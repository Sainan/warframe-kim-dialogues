	j3268010036 [label="O Monsieur Tagfer revirou os olhos e bufou. Pedi que ele explicasse seu escárnio.",shape=box,color=blue];
		j3268010036 -> j332180210;
	j3956586880 [label="\"Você é uma cria, Marie! Inocente, dependente dos outros a vida toda, encolhida no seu pequeno ninho de fé cega!\"",shape=box,color=blue];
