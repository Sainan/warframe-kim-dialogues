	j1124763472 [label="Boolean HexFoodCourtMemory is now true.",color=orange];
		j1124763472 -> j3050781313;
	j3050781313 [label="H16h V0l7463: blz, mas fica meu aviso: se vc ver o arthur lá, fica longe dele! quando o homem quer ficar sozinho, cuidado q ele morde…",shape=box,color=blue];
		j3050781313 -> j546235799;
