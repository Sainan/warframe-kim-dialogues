		"HexRankUpTo1 begins." -> j3801384978;
	j3801384978 [label="Broadsword: A gente tá preso aqui, entenderam? Então, podem começar a limpar a bagunça de vocês. A praça de alimentação tá mais suja que as ruas. Vocês tão achando que isso aqui é um zoológico?",shape=box,color=blue];
		j3801384978 -> j3037746843;
	j3037746843 [label="Salem: Se depender da Lê e dos ratos dela…",shape=box,color=blue];
