	189 [label="Update boolean HexJoinLunch",color=orange];
		189 -> 90;
	190 [label="Update boolean HexAllLunch",color=orange];
		190 -> 90;
	90 [label="Soldja1Shot1kil: deixa eu terminar, porra. digamos que eu esteja com fome… mas aquela droga de aparelho fica vomitando propaganda de porcaria cheia de açúcar na minha orelha toda vez q apareço na praça de alimentação. alguém tem alguma coisa contra eu encher aquela droga de chumbo?",shape=box,color=blue];
		90 -> 91;
	91 [label="xX GLIMMER Xx: ah! ah! deixa eu esmagar ele! eu vou ter cuidado pra não quebrar o Zéca! <RETRO_EMOJI_PUMPEDUP>",shape=box,color=blue];
		91 -> 92;
	92 [label="Belladonna ~{@: Ay, não! 
Já falei antes, a gente precisa daquele lugar limpo pra emergências médicas 
Nada de estilhaços, tem que ser estéril 
Não tem como operar pacientes num lugar sujo",shape=box,color=blue];
		92 -> 93;
	93 [label="Salem: Falando nisso, minha querida Lê… vocês perceberam isso?",shape=box,color=blue];
		93 -> 94;
	94 [label="Broadsword: O quê?",shape=box,color=blue];
		94 -> 95;
	95 [label="Salem: O shopping não está cercado de pacientes, mas sim de cidadãos curiosos que parecem se sentir… seguros aqui perto",shape=box,color=blue];
		95 -> 96;
	96 [label="H16h V0l7463: peraí peraí peraí, tá querendo me dizer q… a gente realmente tá fazendo alguma diferença aqui?",shape=box,color=blue];
		96 -> 97;
		96 -> 98;
		96 -> 99;
	97 [label="Mas é claro que sim",shape=box,color=red];
		97 -> 191;
	98 [label="Sim",shape=box,color=red];
		98 -> 192;
