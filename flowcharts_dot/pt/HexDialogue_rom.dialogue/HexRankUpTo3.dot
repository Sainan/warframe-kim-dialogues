		85 -> 86;
	86 [label="H16h V0l7463: ahá! barrigão tá roncando aí, quincy?! eu tinha um jogo de tabuleiro q tinha um boneco igualzinho a vc, e ele…",shape=box,color=blue];
		86 -> 87;
