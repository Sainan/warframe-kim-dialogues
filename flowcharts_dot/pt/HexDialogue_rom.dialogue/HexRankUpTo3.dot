		195 -> 109;
	196 [label="Update boolean HexGiveHope",color=orange];
		196 -> 109;
	109 [label="H16h V0l7463: hmm… sem querer ser chato, mas acho q a gente só ia tá decepcionando mais gente ainda",shape=box,color=blue];
		109 -> 110;
	110 [label="Salem: Mas será que não devemos pelo menos tentar? Mesmo que seja pouca coisa, qualquer esforço já ajuda a mudar as coisas",shape=box,color=blue];
		110 -> 111;
	111 [label="Belladonna ~{@: Ah claro, aí eu vou ter que cuidar de mais narizes escorrendo e amputações? 
Minha tia sempre falava \"não tome nenhuma decisão importante de estômago vazio\" 
Vamos se encontrar na praça de alimentação e falar sobre isso",shape=box,color=blue];
		111 -> 112;
