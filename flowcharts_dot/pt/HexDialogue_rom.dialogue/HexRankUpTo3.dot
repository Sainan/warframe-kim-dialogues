		193 -> 100;
	100 [label="Broadsword: É… a gente até que dá uma boa",shape=box,color=blue];
		100 -> 101;
	101 [label="H16h V0l7463: ELE VAI FALAR A PALAVRA, ELE VAI FALAR",shape=box,color=blue];
		101 -> 102;
	102 [label="Broadsword: Equipe…",shape=box,color=blue];
		102 -> 103;
	103 [label="Soldja1Shot1kil: só vejo mais boca pra alimentar… mesmo q nosso herói emburrado aí ache q tá tudo legal, acho q n é uma boa ideia",shape=box,color=blue];
		103 -> 104;
	104 [label="Salem: Se quiser, posso mandar todos eles embora. Só preciso de um simples pensamento…",shape=box,color=blue];
		104 -> 105;
	105 [label="xX GLIMMER Xx: não consigo parar de pensar nisso… mesmo que a gente tente salvar o povo, vale a pena dar essa falsa esperança pra eles de que a gente pode salvar todo mundo? me parece q isso não iria acabar bem pra ninguém",shape=box,color=blue];
		105 -> 106;
		105 -> 107;
		105 -> 108;
	106 [label="E se essa esperança não for falsa?",shape=box,color=red];
		106 -> 194;
	107 [label="Acho que esse é o ponto: saber que a gente dá conta de salvar todo mundo",shape=box,color=red];
		107 -> 195;
	108 [label="Quanto mais gente vier pra cá, quanto mais gente com esperança a gente tiver, melhor",shape=box,color=red];
		108 -> 196;
