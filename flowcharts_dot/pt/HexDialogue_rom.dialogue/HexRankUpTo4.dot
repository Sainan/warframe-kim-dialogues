	146 [label="Broadsword: Seja lá quem estiver no jogo, acho que esse ano… esse lugar… essa época… fizemos tudo isso valer a pena. Jamais vamos abrir mão disso. Temos que proteger as pessoas e a nossa equipe toda",shape=box,color=blue];
