		478 -> 482;
	479 [label="MomToxicated: Acredito que, pra Neci, na época em que ela se juntou à Scaldra, os meios justificavam os fins. Ela só acreditava nas pessoas ao seu redor, mas não necessariamente com uma fé cega… bem diferente do Vodyanoi",shape=box,color=blue];
