		482 -> 486;
	483 [label="MomToxicated: Ela sempre foi uma mulher de ambição. Tal ambição que encorajei, fomentei e alimentei. Ao contrário de um certo alguém que queria congelar ela, achando que ela ia ser uma garotinha pra sempre",shape=box,color=blue];
		483 -> 487;
