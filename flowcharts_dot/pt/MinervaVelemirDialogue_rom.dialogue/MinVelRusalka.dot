		j4165654121 -> j3600139764;
	j240112648 [label="+5 Chemistry",color=orange];
		j240112648 -> j3320840510;
	j3526051916 [label="PapaPolar: bem, não é um sorriso feliz-feliz… tá mais pra um sorriso melancólico-feliz…",shape=box,color=blue];
		j3526051916 -> j1459961504;
	j3600139764 [label="MomToxicated: Hahaha, é uma resposta válida, concordo. O que vocês dois acham de tomar umas?",shape=box,color=blue];
		j3600139764 -> j1985034095;
