		j1023493074 -> j2842696372;
	j1130956405 [label="MomToxicated: Tudo na vida é assim, mas agradeço pelo aviso",shape=box,color=blue];
		j1130956405 -> j694976270;
	j2842696372 [label="Então… a Indiferença foi pra Duviri, e… levou a Neci pra lá",shape=box,color=red];
		j2842696372 -> j3500699221;
	j694976270 [label="+5 Chemistry",color=orange];
		j694976270 -> j2066613658;
	j3500699221 [label="PapaPolar: peraí peraí peraí, é aquela coisa da dimensão do livro de contos?",shape=box,color=blue];
		j3500699221 -> j63969041;
	j2066613658 [label="PapaPolar: já tô me preparando pra notícia, mas parece que ela… ainda tá viva, pelo menos?",shape=box,color=blue];
		j2066613658 -> j451802345;
	j63969041 [label="MomToxicated: Aquela com o ditador infantil que ficava te matando repetidamente?",shape=box,color=blue];
		j63969041 -> j852047907;
		j63969041 -> j3521085875;
	j451802345 [label="Eu… não sei. Acho que ela ainda tá viva. Mas deixa eu contar o que sei, e vocês me dizem o que acham",shape=box,color=red];
		j451802345 -> j2842696372;
	j852047907 [label="Que na real, foi um momento de crescimento para ele… ah sim, esse não é o ponto dessa conversa…",shape=box,color=red];
		j852047907 -> j4289892801;
	j3521085875 [label="Isso aí",shape=box,color=red];
		j3521085875 -> j4289892801;
	j4289892801 [label="A Neci… assumiu o trono. O Murmúrio… o \"exército\" da Indiferença, por falta de uma palavra melhor, invadiu, e ela assumiu o poder",shape=box,color=red];
		j4289892801 -> j3137962649;
	j3137962649 [label="MomToxicated: Haha, essa é a minha garotinha",shape=box,color=blue];
		j3137962649 -> j3905454374;
	j3905454374 [label="PapaPolar: mas será que era realmente ela? ou só aquela coisa com o rosto dela?",shape=box,color=blue];
		j3905454374 -> j1835577037;
		j3905454374 -> j1440935166;
	j1835577037 [label="Eu… não sei",shape=box,color=red];
		j1835577037 -> j1897759583;
	j1440935166 [label="Era exatamente sobre isso que queria falar",shape=box,color=red];
		j1440935166 -> j1897759583;
	j1897759583 [label="Encontrei estes registros. No começo, parecia só tralha. Mas quando juntei eles da forma certa, recebi essa mensagem",shape=box,color=red];
		j1897759583 -> j3717706565;
	j3717706565 [label="Fiquei na curiosidade pra saber se isso faz algum sentido pra vocês",shape=box,color=red];
		j3717706565 -> j4060503048;
	j4060503048 [label="MomToxicated: Enigmas e mensagens estranhas? Você tá falando a nossa língua agora",shape=box,color=blue];
		j4060503048 -> j2616372533;
	j2616372533 [label="PapaPolar: aqui é a 0800 dos espiões, veio ao lugar certo",shape=box,color=blue];
		j2616372533 -> j4100866314;
	j4100866314 [label="\"Quando o Sol e Lua se alinharem, os perdidos encontrarão o caminho de casa\"",shape=box,color=red];
		j4100866314 -> j208288885;
	j208288885 [label="PapaPolar: merda… M, que MERDA",shape=box,color=blue];
		j208288885 -> j1400375456;
	j1400375456 [label="MomToxicated: Não cai nessa, se essa coisa tá dentro da cabeça dela, isso sabe tudo que ela sabe",shape=box,color=blue];
		j1400375456 -> j366794505;
		j1400375456 -> j4244850070;
	j366794505 [label="Quê? O que isso significa?",shape=box,color=red];
		j366794505 -> j3809284598;
	j4244850070 [label="É a outra metade, né?",shape=box,color=red];
		j4244850070 -> j819126569;
	j3809284598 [label="PapaPolar: \"Pelas estradas vazias, procure pelo eclipse.\"",shape=box,color=blue];
		j3809284598 -> j1612311920;
	j819126569 [label="+5 Chemistry",color=orange];
		j819126569 -> j3502365236;
	j1612311920 [label="PapaPolar: aquilo que eu disse pra você falar pra nossa garotinha se você achasse ela",shape=box,color=blue];
		j1612311920 -> j4229809040;
	j3502365236 [label="PapaPolar: exatamente…",shape=box,color=blue];
		j3502365236 -> j3112907256;
	j4229809040 [label="PapaPolar: era a nossa metade de uma frase-código. era como a gente iniciava nossas chamadas pra saber se era uma linha segura e que tudo tava bem",shape=box,color=blue];
		j4229809040 -> j3840527668;
	j3112907256 [label="PapaPolar: a gente tinha uma frase-código. era como a gente iniciava nossas chamadas pra saber se era uma linha segura e que tudo tava bem",shape=box,color=blue];
		j3112907256 -> j3840527668;
	j3840527668 [label="MomToxicated: Para saber se éramos… nós mesmos",shape=box,color=blue];
		j3840527668 -> j4014743370;
	j4014743370 [label="PapaPolar: \"Pelas estradas vazias, procure pelo eclipse\" era a nossa metade",shape=box,color=blue];
		j4014743370 -> j3591929338;
	j3591929338 [label="MomToxicated: \"Quando o Sol e Lua se alinharem, os perdidos encontrarão o caminho de casa\" era a resposta",shape=box,color=blue];
		j3591929338 -> j2663064346;
	j2663064346 [label="MomToxicated: A resposta dela",shape=box,color=blue];
		j2663064346 -> j3523946226;
		j2663064346 -> j2492896809;
	j3523946226 [label="Mas como a Minerva disse, não podemos ter certeza de que era ela, a Indiferença sabe tudo que ela sabe",shape=box,color=red];
		j3523946226 -> j1992348828;
	j2492896809 [label="Não sei por que a Indiferença falaria isso…",shape=box,color=red];
		j2492896809 -> j452509300;
	j1992348828 [label="MomToxicated: Mas por que ela estaria tentando nos dar uma sensação de esperança? A menos que estivesse simplesmente tentando nos machucar",shape=box,color=blue];
		j1992348828 -> j2689707952;
	j452509300 [label="MomToxicated: Por falsas esperanças, talvez? Pra nos causar dor?",shape=box,color=blue];
		j452509300 -> j3387326694;
	j2689707952 [label="PapaPolar: isso é doloroso?",shape=box,color=blue];
		j2689707952 -> j4028555217;
	j3387326694 [label="PapaPolar: isso é falso? isso é doloroso?",shape=box,color=blue];
		j3387326694 -> j4028555217;
	j4028555217 [label="PapaPolar: ou é algum tipo de paz, saber que nossa garotinha ainda tá viva em algum lugar?",shape=box,color=blue];
		j4028555217 -> j2153188549;
	j2153188549 [label="PapaPolar: que apesar de todas as probabilidades, ela continua arrasando?",shape=box,color=blue];
		j2153188549 -> j2416985375;
	j2416985375 [label="PapaPolar: mesmo que não seja conosco?",shape=box,color=blue];
		j2416985375 -> j2772207041;
	j2772207041 [label="PapaPolar: não sei você, mas isso aquece meu grande e idiota coração",shape=box,color=blue];
		j2772207041 -> j1227286117;
	j1227286117 [label="PapaPolar: e algo me diz que não é isso que a tal da indiferença gosta de fazer com o povo",shape=box,color=blue];
		j1227286117 -> j3454675312;
	j3454675312 [label="MomToxicated: Você tem toda razão. Ouvir essa frase e pensar que ela talvez ainda esteja por aí não é nada doloroso",shape=box,color=blue];
		j3454675312 -> j3023879440;
	j3023879440 [label="MomToxicated: Estou orgulhosa dela",shape=box,color=blue];
		j3023879440 -> j4002176160;
		j3023879440 -> j1926206425;
		j3023879440 -> j3814146848;
	j4002176160 [label="Mesmo que ela ainda esteja sendo mantida refém pela Indiferença?",shape=box,color=red];
		j4002176160 -> j323031357;
	j1926206425 [label="Mesmo que seja um truque da Indiferença?",shape=box,color=red];
		j1926206425 -> j4044954483;
	j3814146848 [label="Ela pode estar trabalhando de vontade própria pra Indiferença",shape=box,color=red];
		j3814146848 -> j2740296641;
	j323031357 [label="PapaPolar: ela é tão durona quanto um saco de pregos estruturais em um grande bloco de titânio fundido",shape=box,color=blue];
		j323031357 -> j4276739007;
	j4044954483 [label="MomToxicated: Por quê? Pra quê? O que isso tem a ganhar com nós dois?",shape=box,color=blue];
		j4044954483 -> j578315550;
	j2740296641 [label="MomToxicated: Então ela tem um dos aliados mais poderosos do universo. Ela escolheu um lado, e nós também",shape=box,color=blue];
		j2740296641 -> j105830898;
	j4276739007 [label="PapaPolar: e aposto que seu \"homem na parede\" sabia disso, e foi por isso que ele tomou ela primeiro",shape=box,color=blue];
		j4276739007 -> j898372143;
	j578315550 [label="PapaPolar: somos muito pequenos em relação a isso, e digo isso da melhor maneira possível",shape=box,color=blue];
		j578315550 -> j3936715696;
	j105830898 [label="MomToxicated: Tomara que nunca precisemos apontar armas uns para os outros. E se precisarmos… vamos lidar com isso quando a hora chegar",shape=box,color=blue];
		j105830898 -> j3985484419;
	j898372143 [label="PapaPolar: que nada, ela vai ficar bem. ou ela já se foi há muito tempo, ou eles têm um acordo mútuo, ou é ela que tá mantendo ele como refém aushaushasausausha",shape=box,color=blue];
		j898372143 -> j3936715696;
	j3936715696 [label="MomToxicated: Não, acho que a mensagem era real. E acho que era da nossa garotinha. Nos dizendo… que ela ainda tá por aí",shape=box,color=blue];
		j3936715696 -> j3008560603;
	j3985484419 [label="PapaPolar: ela sabe cuidar de si mesma, a gente ensinou bem",shape=box,color=blue];
		j3985484419 -> j3936715696;
	j3008560603 [label="MomToxicated: Falando da forma dela que \"tá tudo bem\"",shape=box,color=blue];
		j3008560603 -> j798657848;
	j798657848 [label="MomToxicated: E que podemos parar de nos preocupar com ela",shape=box,color=blue];
		j798657848 -> j1353530416;
	j1353530416 [label="PapaPolar: quem vê pensa a gente vai parar",shape=box,color=blue];
		j1353530416 -> j1467466149;
	j1467466149 [label="MomToxicated: A maldição e a bênção dos pais",shape=box,color=blue];
		j1467466149 -> j853503834;
	j853503834 [label="PapaPolar: você já quis ter filhos, peregrino? é… não responde não, provavelmente tu vai falar alguma besteira do void que eu não quero saber",shape=box,color=blue];
		j853503834 -> j4134814311;
