		j2327532583 -> j2311122404;
	j3983094643 [label="PapaPolar: mas é claro que é, e nosso colega provavelmente já tem alguma ideia do motivo… não é como se a gente fosse a dupla mais sutil do mundo",shape=box,color=blue];
		j3983094643 -> j1672962473;
	j3738933434 [label="Porque, senão… eu seria tão ruim quanto a Indiferença… a Scaldra… o Entrati. Eu não saio por aí matando gente a troco de nada",shape=box,color=red];
		j3738933434 -> j3793683955;
	j1094975057 [label="Porque não foi realmente ela quem fez as escolhas dela até aquele ponto. Só porque eu não matei ela naquele momento, não significa que eu me importo o suficiente pra ir salvar ela",shape=box,color=red];
		j1094975057 -> j1844035677;
