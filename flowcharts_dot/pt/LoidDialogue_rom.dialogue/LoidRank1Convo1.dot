digraph {
	0 [label="LoidRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Peregrino, peço desculpas pela inconveniência desta imposição. Não desejava contatá-lo por meio deste dispositivo, mas a situação está se tornando quase uma emergência… e não tenho mais ninguém a quem recorrer.",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="POM2_LAB1?",shape=box,color=red];
		2 -> 4;
	3 [label="Quem tá aí…",shape=box,color=red];
		3 -> 4;
	4 [label="Ah, sim… isso ainda está com as configurações padrão. Aqui é o Loid. Eu deveria ter… começado por essa parte, mas as coisas aqui no Sanctum Anatômica têm estado… profundamente caóticas ultimamente.",shape=box,color=blue];
		4 -> 5;
	5 [label="Por isso estou entrando em contato com você. Preciso da sua ajuda. 3 Protoframes chegaram aqui, no Sanctum, na minha época. E não são os Protoframes que conhecemos.",shape=box,color=blue];
		5 -> 6;
	6 [label="Um deles é um…",shape=box,color=blue];
		6 -> 7;
	7 [label="Lamento por isso.",shape=box,color=blue];
		7 -> 8;
	8 [label="Um deles é um Orokin, Peregrino.",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
		8 -> 11;
	9 [label="Cadê a Lótus?",shape=box,color=red];
		9 -> 12;
	10 [label="Ah, não…",shape=box,color=red];
		10 -> 13;
	11 [label="Quê?!",shape=box,color=red];
		11 -> 13;
	12 [label="A Lótus e o Operador têm outros assuntos para tratar, acredite em mim. Já estão bem sobrecarregados. Eu não lhe pediria ajuda com essas questões se tivesse outra pessoa para recorrer.",shape=box,color=blue];
		12 -> 14;
	13 [label="Eu não lhe pediria ajuda com essas questões se tivesse outra pessoa a quem recorrer. Você é… aparentemente, o novo especialista nesse tipo de assunto.",shape=box,color=blue];
		13 -> 15;
	14 [label="Você é… aparentemente, o novo especialista em assuntos desse tipo.",shape=box,color=blue];
		14 -> 15;
	15 [label="Não sei qual a melhor forma de descrevê-los. Mas, se você vier ao Sanctum, acredito que será difícil não perceber quem são. Dois deles concordaram em falar com você aqui, pelo POM-2. Um deles talvez precise de um pouco mais de… convencimento.",shape=box,color=blue];
		15 -> 16;
	16 [label="Tenho fé que… você terá sucesso.",shape=box,color=blue];
		16 -> 29;
	29 [label="Update boolean LoidTriadAvailable",color=orange];
		29 -> 17;
	17 [label="Chat ends. Next chat will be LoidFamily.",color=orange];
}