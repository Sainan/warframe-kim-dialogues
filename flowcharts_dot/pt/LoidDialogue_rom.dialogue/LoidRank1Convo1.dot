digraph {
	"LoidRank1Convo1 begins." [color=orange];
		"LoidRank1Convo1 begins." -> j1962899338;
	j1962899338 [label="Peregrino, peço desculpas pela inconveniência desta imposição. Não desejava contatá-lo por meio deste dispositivo, mas a situação está se tornando quase uma emergência… e não tenho mais ninguém a quem recorrer.",shape=box,color=blue];
		j1962899338 -> j3007199201;
		j1962899338 -> j3083307942;
	j3007199201 [label="POM2_LAB1?",shape=box,color=red];
		j3007199201 -> j2307993141;
	j3083307942 [label="Quem tá aí…",shape=box,color=red];
		j3083307942 -> j2307993141;
	j2307993141 [label="Ah, sim… isso ainda está com as configurações padrão. Aqui é o Loid. Eu deveria ter… começado por essa parte, mas as coisas aqui no Sanctum Anatômica têm estado… profundamente caóticas ultimamente.",shape=box,color=blue];
		j2307993141 -> j4174922542;
	j4174922542 [label="Por isso estou entrando em contato com você. Preciso da sua ajuda. 3 Protoframes chegaram aqui, no Sanctum, na minha época. E não são os Protoframes que conhecemos.",shape=box,color=blue];
		j4174922542 -> j2029274058;
	j2029274058 [label="Um deles é um…",shape=box,color=blue];
		j2029274058 -> j3251737080;
	j3251737080 [label="Lamento por isso.",shape=box,color=blue];
		j3251737080 -> j1139781651;
	j1139781651 [label="Um deles é um Orokin, Peregrino.",shape=box,color=blue];
		j1139781651 -> j1647386974;
		j1139781651 -> j3648296565;
		j1139781651 -> j1999483861;
	j1647386974 [label="Cadê a Lótus?",shape=box,color=red];
		j1647386974 -> j117301354;
	j3648296565 [label="Ah, não…",shape=box,color=red];
		j3648296565 -> j1384819699;
	j1999483861 [label="Quê?!",shape=box,color=red];
		j1999483861 -> j1384819699;
	j117301354 [label="A Lótus e o Operador têm outros assuntos para tratar, acredite em mim. Já estão bem sobrecarregados. Eu não lhe pediria ajuda com essas questões se tivesse outra pessoa para recorrer.",shape=box,color=blue];
		j117301354 -> j2421552860;
	j1384819699 [label="Eu não lhe pediria ajuda com essas questões se tivesse outra pessoa a quem recorrer. Você é… aparentemente, o novo especialista nesse tipo de assunto.",shape=box,color=blue];
		j1384819699 -> j2565627543;
	j2421552860 [label="Você é… aparentemente, o novo especialista em assuntos desse tipo.",shape=box,color=blue];
		j2421552860 -> j2565627543;
	j2565627543 [label="Não sei qual a melhor forma de descrevê-los. Mas, se você vier ao Sanctum, acredito que será difícil não perceber quem são. Dois deles concordaram em falar com você aqui, pelo POM-2. Um deles talvez precise de um pouco mais de… convencimento.",shape=box,color=blue];
		j2565627543 -> j283764448;
	j283764448 [label="Tenho fé que… você terá sucesso.",shape=box,color=blue];
		j283764448 -> j3173882;
	j3173882 [label="Boolean LoidTriadAvailable is now true.",color=orange];
		j3173882 -> "Chat ends. Next chat will be LoidFamily.";
	"Chat ends. Next chat will be LoidFamily." [color=orange];
}