		25 -> 26;
	26 [label="Sim… por favor, venha e certifique-se de que minhas entranhas não estão sendo usadas como decoração festiva no Necralisk, sim? Receio que precisarei de um pouco de tranquilidade, quando tudo estiver dito e feito.",shape=box,color=blue];
