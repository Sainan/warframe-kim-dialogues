		j2502471650 -> "Chat ends." [label="false",color=purple];
	j3337290893 [label="Peregrino, devo ceder. O Roathe, a Marie e o Lyon me convenceram de que… finalmente, a hora chegou.",shape=box,color=blue];
		j3337290893 -> j1218528266;
	j1218528266 [label="Temo que terei de fazer o que me faz tremer até os ossos. Aliás, talvez seja isso que me seja tirado quando eu for despedaçado… quando a Gomaitru e sua família descobrirem o que esteve acontecendo debaixo de seus pés durante todo esse tempo.",shape=box,color=blue];
		j1218528266 -> j3101304779;
	j3101304779 [label="É tão estranho chamá-la por esse nome agora… mas tanta coisa mudou entre nós. E tanta coisa mudará ainda mais em breve…",shape=box,color=blue];
		j3101304779 -> j3242196326;
		j3101304779 -> j1394370994;
	j3242196326 [label="Isso já deveria ter acontecido há muito tempo, você vai ficar bem",shape=box,color=red];
		j3242196326 -> j139516915;
	j1394370994 [label="Você dá conta disso",shape=box,color=red];
		j1394370994 -> j139516915;
	j139516915 [label="Sim… por favor, venha e certifique-se de que minhas entranhas não estão sendo usadas como decoração festiva no Necralisk, sim? Receio que precisarei de um pouco de tranquilidade, quando tudo estiver dito e feito.",shape=box,color=blue];
		j139516915 -> j937202740;
	j937202740 [label="Boolean LoidFamilyComplete is now true.",color=orange];
		j937202740 -> "Chat ends.";
