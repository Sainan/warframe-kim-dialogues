digraph {
	0 [label="MarieRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Bonjour, bonjour Włóczęgo ! Jak się masz tego pięknego dnia ? Albo wieczora. Zaprawdę nie wiem, jaka jest pora w tym miejscu.",shape=box,color=blue];
		1 -> 2;
	2 [label="Jestem pewna, że jeden z bibelotów należących do Monsieur Loida, jest zegarem, ale za nic nie potrafię ustalić, który to.",shape=box,color=blue];
		2 -> 3;
	3 [label="Lękam się dotknąć któregokolwiek z urządzeń w tym przedziwnym sanktuarium. Jestem przekonana, że równie łatwo mogę trafić w daleką przyszłość, jak zaparzyć filiżankę herbaty.",shape=box,color=blue];
		3 -> 5;
		3 -> 6;
		3 -> 4;
	5 [label="Najlepiej będzie nie dotykać niczego, czego funkcji nie jesteś pewna. ",shape=box,color=red];
		5 -> 8;
	6 [label="Poradzisz sobie.",shape=box,color=red];
		6 -> 9;
	4 [label="[Koniec]",shape=box,color=red];
		4 -> 7;
	8 [label="Doskonała porada, w rzeczy samej. Zasłyszałam od Monsieur Loida, że sam przeżyłeś swoją aventure temporelle. Zastanawiam się -",shape=box,color=blue];
		8 -> 10;
	9 [label="C'est très gentil de votre part, ale... ale to nie Ty zostałeś rzucony w inny... ach. Tak. Masz rację !",shape=box,color=blue];
		9 -> 11;
	7 [label="Chat ends.",color=orange];
	10 [label="Czy była tak groźna, jak ta ?",shape=box,color=blue];
		10 -> 12;
		10 -> 13;
	11 [label="Wiesz jak to jest, prawda ? Wybacz mi. Czy Twoja własna przygoda była tak niebezpieczna, jak ta ?",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="Masz na myśli tamte czasy? Czy konkretnie mój pobyt tam?",shape=box,color=red];
		12 -> 14;
	13 [label="Było inaczej, ale tutaj jesteś bezpieczna.",shape=box,color=red];
		13 -> 15;
	14 [label="+10 Chemistry",color=orange];
		14 -> 16;
	15 [label="Naprawdę doceniam Twoje entuzjastyczne słowa zaufania, ale nie mogę przyznać, że je podzielam. Szczególnie wtedy, gdy mam problem z tak trywialnym zadaniem, jak określenie, która jest godzina.",shape=box,color=blue];
		15 -> 17;
	16 [label="Ach tak, dobrze jest to rozróżnić. Wątpię, że Twoje doświadczenia z przeszłością były \"normalne\" w typowym tego słowa znaczeniu. Z tego co zauważyłam, wręcz przeciwnie.",shape=box,color=blue];
		16 -> 18;
	17 [label="Można by się spodziewać, że znajdziesz go w rogu tego... \"ekranu\", ale go nie ma ! Moim zdaniem to mauvaise qualité.",shape=box,color=blue];
		17 -> 19;
	18 [label="Chodziło mi o sam \"okres czasu\". Pozwól mi, że zapytam inaczej -",shape=box,color=blue];
		18 -> 20;
	19 [label="W każdym bądź razie, odbiegliśmy od pytania !",shape=box,color=blue];
		19 -> 20;
	20 [label="Czy ta \"przeszłość\", do której się udałeś, która jest w rzeczy samej bliższa tej \"dalszej przeszłości\", z której pochodzę ja, jest mniej czy bardziej niebezpieczna od czasów, w których obecnie się znajdujemy ?",shape=box,color=blue];
		20 -> 21;
	21 [label="(Na miłość ! Muszę przyznać, że to uwielbiam. To wiele ciekawsze, niż odkurzanie kielichów i paten.)",shape=box,color=blue];
		21 -> 22;
		21 -> 23;
		21 -> 24;
		21 -> 25;
	22 [label="Myślę, że wypadają mniej więcej tak samo. Broń jest inna i mogą nie wiedzieć, z czym się mierzą, ale wojna to wojna, a śmierć to śmierć.",shape=box,color=red];
		22 -> 26;
	23 [label="Myślę, że te czas są mniej niebezpieczne. Mamy większe możliwości, by stawić czoła wyzwaniom przed nami. Oni dopiero zaczynają.",shape=box,color=red];
		23 -> 27;
	24 [label="Myślę, że w tych czasach jest groźniej. Podczas gdy nasz wspólny wróg, Plaga, nadal pałęta się po świecie, oni korzystają ze znacznie bardziej prymitywnej broni.",shape=box,color=red];
		24 -> 27;
	25 [label="Szczerze mówiąc, cieszę się po prostu, że dobrze się bawisz. Przywyknięcie do tego wszystkiego to duże wyzwanie.",shape=box,color=red];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="Możesz mieć rację. Zastanowię się nad tym. Dziękuję.",shape=box,color=blue];
		27 -> 30;
	28 [label="+5 Chemistry",color=orange];
		28 -> 31;
	29 [label="Myślę, że podobnie jak wszystko, to chyba kwestia względna, non ? Drapieżnik, który zabije nas dzisiaj jest tak samo groźny jak ten, który polował na nas wtedy. Teraz tylko jego kły są ostrzejsze.",shape=box,color=blue];
		29 -> 32;
		29 -> 33;
	30 [label="Chat ends.",color=orange];
	31 [label="Zostałam do tego przygotowana przez le Cardinal Dimanche - znanego Tobie jako Albrecht Entrati. W odróżnieniu od drogiego Leona, uwierzyłam we wszystkie jego słowa. I w odróżnieniu od niego, uważam to za wielką przygodę, nie brzemię.",shape=box,color=blue];
		31 -> 34;
	32 [label="Chyba, że jesteś Orokin. Oni znaleźli sposób, by uniknąć śmierci... w teorii, jeśli nie w praktyce.",shape=box,color=red];
		32 -> 35;
	33 [label="Cieszy mnie też, jak dobrze sobie radzisz w przyszłości.",shape=box,color=red];
		33 -> 36;
	34 [label="Służba Świetlistym nie zawsze musi być cierpieniem. W tym zawsze się różniliśmy.",shape=box,color=blue];
		34 -> 37;
	35 [label="I wierzę, że diabeł jest doskonałym przykładem tego, dlaczego śmierć jest największym darem, podarowanym nam przez Lua.",shape=box,color=blue];
		35 -> 38;
	36 [label="+5 Chemistry",color=orange];
		36 -> 39;
	37 [label="Update boolean MarieLyonSuffering1",color=orange];
		37 -> 40;
	38 [label="Update boolean MarieRoathe1",color=orange];
		38 -> 41;
	39 [label="Zostałam do tego przygotowana przez le Cardinal Dimanche - znanego Tobie jako Albrecht Entrati. W odróżnieniu od drogiego Leona, uwierzyłam we wszystkie jego słowa. I w odróżnieniu od niego, uważam to za wielką przygodę, nie brzemię.",shape=box,color=blue];
		39 -> 42;
	40 [label="I nie migaj się od pytania, głuptasku ! Które uważasz za bardziej niebezpieczne ?",shape=box,color=blue];
		40 -> 43;
		40 -> 44;
		40 -> 45;
	41 [label="Och ! Rozpoznaję ten dźwięk zegara, ale nadal nie mogę ustalić, gdzie to przeklęte urządzenie się skrywa. W każdym razie, obawiam się, że już pora na mnie. Bardzo dziękuję za tę rozmowę i mam nadzieję, że wkrótce znowu się \"spotkamy\" ! Aux Dieux !",shape=box,color=blue];
		41 -> 46;
	42 [label="Służba Świetlistym nie zawsze musi być cierpieniem. W tym zawsze się różniliśmy.",shape=box,color=blue];
		42 -> 47;
	43 [label="Myślę, że te czasy są groźniejsze. Ilu różnych wrogów próbuje nas zabić?",shape=box,color=red];
		43 -> 48;
	44 [label="Wierzę, że nasze czasy są mniej niebezpieczne. Oni jeszcze odkrywają nowe sposoby na zabijanie się nawzajem. My po prostu robimy to nieco bardziej widowiskowo.",shape=box,color=red];
		44 -> 48;
	45 [label="Myślę, że koniec końców są równie niebezpieczne. Śmierć to w końcu śmierć, prawda?",shape=box,color=red];
		45 -> 49;
	46 [label="Chat ends.",color=orange];
	47 [label="Update boolean MarieLyonSuffering1",color=orange];
		47 -> 41;
	48 [label="Możesz mieć rację. Zastanowię się nad tym. Dziękuję.",shape=box,color=blue];
		48 -> 50;
	49 [label="+5 Chemistry",color=orange];
		49 -> 51;
	50 [label="Chat ends.",color=orange];
	51 [label="Myślę, że podobnie jak wszystko, to chyba kwestia względna, non ? Drapieżnik, który zabije nas dzisiaj jest tak samo groźny jak ten, który polował na nas wtedy. Teraz tylko jego kły są ostrzejsze.",shape=box,color=blue];
		51 -> 52;
		51 -> 53;
	52 [label="Jako ktoś, kto wciąż próbuje bronić się przed wilkiem, często jestem tym zmęczony.",shape=box,color=red];
		52 -> 54;
	53 [label="Chyba, że jesteś Orokin. Oni znaleźli sposób, by uniknąć śmierci... w teorii, jeśli nie w praktyce.",shape=box,color=red];
		53 -> 55;
	54 [label="Myślę, że ty, mój drogi Włóczęgo, prędzej sam dołączysz do watahy, niż będziesz się przed nią krył. I mówię to jako komplement.",shape=box,color=blue];
		54 -> 41;
	55 [label="I wierzę, że diabeł jest doskonałym przykładem tego, dlaczego śmierć jest największym darem, podarowanym nam przez Lua.",shape=box,color=blue];
		55 -> 56;
	56 [label="Update boolean MarieRoathe1",color=orange];
		56 -> 41;
}