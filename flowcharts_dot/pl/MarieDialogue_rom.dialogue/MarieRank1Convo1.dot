digraph {
	"MarieRank1Convo1 begins." [color=orange];
		"MarieRank1Convo1 begins." -> j3502711302;
	j3502711302 [label="Bonjour, bonjour Włóczęgo ! Jak się masz tego pięknego dnia ? Albo wieczora. Zaprawdę nie wiem, jaka jest pora w tym miejscu.",shape=box,color=blue];
		j3502711302 -> j3420258759;
	j3420258759 [label="Jestem pewna, że jeden z bibelotów należących do Monsieur Loida, jest zegarem, ale za nic nie potrafię ustalić, który to.",shape=box,color=blue];
		j3420258759 -> j1322588338;
	j1322588338 [label="Lękam się dotknąć któregokolwiek z urządzeń w tym przedziwnym sanktuarium. Jestem przekonana, że równie łatwo mogę trafić w daleką przyszłość, jak zaparzyć filiżankę herbaty.",shape=box,color=blue];
		j1322588338 -> j4282591971;
		j1322588338 -> j2759743008;
		j1322588338 -> j386906797;
	j4282591971 [label="Najlepiej będzie nie dotykać niczego, czego funkcji nie jesteś pewna. ",shape=box,color=red];
		j4282591971 -> j3251227552;
	j2759743008 [label="Poradzisz sobie.",shape=box,color=red];
		j2759743008 -> j4019173009;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j3251227552 [label="Doskonała porada, w rzeczy samej. Zasłyszałam od Monsieur Loida, że sam przeżyłeś swoją aventure temporelle. Zastanawiam się -",shape=box,color=blue];
		j3251227552 -> j3586975039;
	j4019173009 [label="C'est très gentil de votre part, ale... ale to nie Ty zostałeś rzucony w inny... ach. Tak. Masz rację !",shape=box,color=blue];
		j4019173009 -> j3675192063;
	"Chat ends." [color=orange];
	j3586975039 [label="Czy była tak groźna, jak ta ?",shape=box,color=blue];
		j3586975039 -> j3789838496;
		j3586975039 -> j2525733300;
	j3675192063 [label="Wiesz jak to jest, prawda ? Wybacz mi. Czy Twoja własna przygoda była tak niebezpieczna, jak ta ?",shape=box,color=blue];
		j3675192063 -> j3789838496;
		j3675192063 -> j2525733300;
	j3789838496 [label="Masz na myśli tamte czasy? Czy konkretnie mój pobyt tam?",shape=box,color=red];
		j3789838496 -> j2878931601;
	j2525733300 [label="Było inaczej, ale tutaj jesteś bezpieczna.",shape=box,color=red];
		j2525733300 -> j806762972;
	j2878931601 [label="+10 Chemistry",color=orange];
		j2878931601 -> j4210897229;
	j806762972 [label="Naprawdę doceniam Twoje entuzjastyczne słowa zaufania, ale nie mogę przyznać, że je podzielam. Szczególnie wtedy, gdy mam problem z tak trywialnym zadaniem, jak określenie, która jest godzina.",shape=box,color=blue];
		j806762972 -> j2551277634;
	j4210897229 [label="Ach tak, dobrze jest to rozróżnić. Wątpię, że Twoje doświadczenia z przeszłością były \"normalne\" w typowym tego słowa znaczeniu. Z tego co zauważyłam, wręcz przeciwnie.",shape=box,color=blue];
		j4210897229 -> j1343257059;
	j2551277634 [label="Można by się spodziewać, że znajdziesz go w rogu tego... \"ekranu\", ale go nie ma ! Moim zdaniem to mauvaise qualité.",shape=box,color=blue];
		j2551277634 -> j593310389;
	j1343257059 [label="Chodziło mi o sam \"okres czasu\". Pozwól mi, że zapytam inaczej -",shape=box,color=blue];
		j1343257059 -> j3880857908;
	j593310389 [label="W każdym bądź razie, odbiegliśmy od pytania !",shape=box,color=blue];
		j593310389 -> j3880857908;
	j3880857908 [label="Czy ta \"przeszłość\", do której się udałeś, która jest w rzeczy samej bliższa tej \"dalszej przeszłości\", z której pochodzę ja, jest mniej czy bardziej niebezpieczna od czasów, w których obecnie się znajdujemy ?",shape=box,color=blue];
		j3880857908 -> j4283628887;
	j4283628887 [label="(Na miłość ! Muszę przyznać, że to uwielbiam. To wiele ciekawsze, niż odkurzanie kielichów i paten.)",shape=box,color=blue];
		j4283628887 -> j3482368655;
		j4283628887 -> j788101268;
		j4283628887 -> j2674872205;
		j4283628887 -> j2551682520;
	j3482368655 [label="Myślę, że wypadają mniej więcej tak samo. Broń jest inna i mogą nie wiedzieć, z czym się mierzą, ale wojna to wojna, a śmierć to śmierć.",shape=box,color=red];
		j3482368655 -> j414349594;
	j788101268 [label="Myślę, że te czas są mniej niebezpieczne. Mamy większe możliwości, by stawić czoła wyzwaniom przed nami. Oni dopiero zaczynają.",shape=box,color=red];
		j788101268 -> j3549484516;
	j2674872205 [label="Myślę, że w tych czasach jest groźniej. Podczas gdy nasz wspólny wróg, Plaga, nadal pałęta się po świecie, oni korzystają ze znacznie bardziej prymitywnej broni.",shape=box,color=red];
		j2674872205 -> j3549484516;
	j2551682520 [label="Szczerze mówiąc, cieszę się po prostu, że dobrze się bawisz. Przywyknięcie do tego wszystkiego to duże wyzwanie.",shape=box,color=red];
		j2551682520 -> j115286222;
	j414349594 [label="+5 Chemistry",color=orange];
		j414349594 -> j685985077;
	j3549484516 [label="Możesz mieć rację. Zastanowię się nad tym. Dziękuję.",shape=box,color=blue];
		j3549484516 -> "Chat ends.";
	j115286222 [label="+5 Chemistry",color=orange];
		j115286222 -> j3730214109;
	j685985077 [label="Myślę, że podobnie jak wszystko, to chyba kwestia względna, non ? Drapieżnik, który zabije nas dzisiaj jest tak samo groźny jak ten, który polował na nas wtedy. Teraz tylko jego kły są ostrzejsze.",shape=box,color=blue];
		j685985077 -> j1352371138;
		j685985077 -> j3965391846;
	j3730214109 [label="Zostałam do tego przygotowana przez le Cardinal Dimanche - znanego Tobie jako Albrecht Entrati. W odróżnieniu od drogiego Leona, uwierzyłam we wszystkie jego słowa. I w odróżnieniu od niego, uważam to za wielką przygodę, nie brzemię.",shape=box,color=blue];
		j3730214109 -> j4061230122;
	j1352371138 [label="Chyba, że jesteś Orokin. Oni znaleźli sposób, by uniknąć śmierci... w teorii, jeśli nie w praktyce.",shape=box,color=red];
		j1352371138 -> j1461160741;
	j3965391846 [label="Cieszy mnie też, jak dobrze sobie radzisz w przyszłości.",shape=box,color=red];
		j3965391846 -> j544297763;
	j4061230122 [label="Służba Świetlistym nie zawsze musi być cierpieniem. W tym zawsze się różniliśmy.",shape=box,color=blue];
		j4061230122 -> j32604168;
	j1461160741 [label="I wierzę, że diabeł jest doskonałym przykładem tego, dlaczego śmierć jest największym darem, podarowanym nam przez Lua.",shape=box,color=blue];
		j1461160741 -> j640191184;
	j544297763 [label="+5 Chemistry",color=orange];
		j544297763 -> j2533134908;
	j32604168 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j32604168 -> j4116960193;
	j640191184 [label="Boolean MarieRoathe1 is now true.",color=orange];
		j640191184 -> j1726296046;
	j2533134908 [label="Zostałam do tego przygotowana przez le Cardinal Dimanche - znanego Tobie jako Albrecht Entrati. W odróżnieniu od drogiego Leona, uwierzyłam we wszystkie jego słowa. I w odróżnieniu od niego, uważam to za wielką przygodę, nie brzemię.",shape=box,color=blue];
		j2533134908 -> j4119092399;
	j4116960193 [label="I nie migaj się od pytania, głuptasku ! Które uważasz za bardziej niebezpieczne ?",shape=box,color=blue];
		j4116960193 -> j1320846824;
		j4116960193 -> j4005666237;
		j4116960193 -> j3675204400;
	j1726296046 [label="Och ! Rozpoznaję ten dźwięk zegara, ale nadal nie mogę ustalić, gdzie to przeklęte urządzenie się skrywa. W każdym razie, obawiam się, że już pora na mnie. Bardzo dziękuję za tę rozmowę i mam nadzieję, że wkrótce znowu się \"spotkamy\" ! Aux Dieux !",shape=box,color=blue];
		j1726296046 -> "Chat ends.";
	j4119092399 [label="Służba Świetlistym nie zawsze musi być cierpieniem. W tym zawsze się różniliśmy.",shape=box,color=blue];
		j4119092399 -> j1890180934;
	j1320846824 [label="Myślę, że te czasy są groźniejsze. Ilu różnych wrogów próbuje nas zabić?",shape=box,color=red];
		j1320846824 -> j3549484516;
	j4005666237 [label="Wierzę, że nasze czasy są mniej niebezpieczne. Oni jeszcze odkrywają nowe sposoby na zabijanie się nawzajem. My po prostu robimy to nieco bardziej widowiskowo.",shape=box,color=red];
		j4005666237 -> j3549484516;
	j3675204400 [label="Myślę, że koniec końców są równie niebezpieczne. Śmierć to w końcu śmierć, prawda?",shape=box,color=red];
		j3675204400 -> j4275120532;
	j1890180934 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j1890180934 -> j1726296046;
	j4275120532 [label="+5 Chemistry",color=orange];
		j4275120532 -> j2645282353;
	j2645282353 [label="Myślę, że podobnie jak wszystko, to chyba kwestia względna, non ? Drapieżnik, który zabije nas dzisiaj jest tak samo groźny jak ten, który polował na nas wtedy. Teraz tylko jego kły są ostrzejsze.",shape=box,color=blue];
		j2645282353 -> j1034019901;
		j2645282353 -> j1352371138;
	j1034019901 [label="Jako ktoś, kto wciąż próbuje bronić się przed wilkiem, często jestem tym zmęczony.",shape=box,color=red];
		j1034019901 -> j2777691482;
	j2777691482 [label="Myślę, że ty, mój drogi Włóczęgo, prędzej sam dołączysz do watahy, niż będziesz się przed nią krył. I mówię to jako komplement.",shape=box,color=blue];
		j2777691482 -> j1726296046;
}