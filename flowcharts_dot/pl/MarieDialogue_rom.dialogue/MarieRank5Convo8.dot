		j2209043138 -> j3400011719;
	"Chat ends." [color=orange];
	j4092896250 [label="I fear I must call him \"our\" devil now, non ? For he is not leaving any time soon. Ha !",shape=box,color=blue];
		j4092896250 -> j4149877566;
	j1181495316 [label="I feel as though I should be asking you that question, non ? You are the one who is now cavorting with him !",shape=box,color=blue];
		j1181495316 -> j2286761238;
	j525608105 [label="I do not know how you achieved what you did. But he has told us the truth of taking the serum.",shape=box,color=blue];
		j525608105 -> j326011510;
	j4138166858 [label="I do not know how you achieved what you did. But he has told us the truth of taking the sérum.",shape=box,color=blue];
	j3033431373 [label="I worry for him. I think he hurts himself more than he lets on, n'est-ce pas?",shape=box,color=blue];
		j3033431373 -> j2113306141;
	j3400011719 [label="I'm sorry if this feels like it's coming out of nowhere, but I haven't known how to tell you earlier.",shape=box,color=red];
		j3400011719 -> j2285781170;
	j4149877566 [label="You have done well in getting his help with Monsieur Loid. I did not think it could be done.",shape=box,color=blue];
		j4149877566 -> j3724766806;
	j2286761238 [label="I am resisting the tentation to ask you toutes sortes de commérages.",shape=box,color=blue];
		j2286761238 -> j3724766806;
	j326011510 [label="Sol, to złamało mi serce. Jego głos nie załamał się, kiedy przemówił. Mais je l'ai vu dans ses yeux.",shape=box,color=blue];
		j326011510 -> j3724766806;
	j2113306141 [label="It breaks my heart. I hope his does not shatter in his chest some day. I do not know if he will survive it. I do not know if any of us will.",shape=box,color=blue];
		j2113306141 -> "Chat ends.";
	j2285781170 [label="I adore you. I simply adore you.",shape=box,color=red];
		j2285781170 -> j2766050406;
	j3724766806 [label="There has been a change in him. Subtle, but it is there. ",shape=box,color=blue];
		j3724766806 -> j4073729797;
	j2766050406 [label="Well, I was wondering... if you'd like to, well... become a couple?",shape=box,color=red];
		j2766050406 -> j2298753926;
	j4073729797 [label="+5 Chemistry",color=orange];
		j4073729797 -> j125207308;
	j2298753926 [label="Evaluate expressions",color=orange];
