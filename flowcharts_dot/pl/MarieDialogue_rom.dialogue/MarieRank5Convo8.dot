		j2298753926 -> j2646697458 [label="false",color=purple];
	j2314027600 [label="I za to jesteśmy ci wdzięczni.",shape=box,color=blue];
		j2314027600 -> j1879887318;
	j2646697458 [label="Och ! Och, Włóczęgo. Nie wiem, jak to powiedzieć, więc powiem wprost. ",shape=box,color=blue];
		j2646697458 -> j617350017;
	j3101647053 [label="Och, czuję się tak samo ! Mais je ne sais pas comment te l'écrire, je n'ose pas taper les mots ! Uważałam się za głupca, że w ogóle o tym myślę !",shape=box,color=blue];
		j3101647053 -> j2700560895;
	j1879887318 [label="Nie wiem, czy zawsze będzie tego chciał, ale zawsze może liczyć na swoich przyjaciół.",shape=box,color=blue];
		j1879887318 -> j1045503964;
	j617350017 [label="Non.",shape=box,color=blue];
		j617350017 -> "Chat ends.";
	j2700560895 [label="Ach ! Jak bardzo mnie uradowałeś !",shape=box,color=blue];
		j2700560895 -> j1342173633;
	j1045503964 [label="Chociaż myślę, że krzyczenie na niego nigdy mi się nie znudzi !",shape=box,color=blue];
		j1045503964 -> j1924010435;
		j1045503964 -> j3990797541;
	j1342173633 [label="Jeśli pytasz mnie o bardziej... formalny związek, oui ! Oui ! Jak najbardziej !",shape=box,color=blue];
		j1342173633 -> j3697739866;
		j1342173633 -> j1791810479;
	j1924010435 [label="Mam wrażenie, że aż za bardzo polubił się z drażnieniem ciebie.",shape=box,color=red];
		j1924010435 -> j1660678090;
	j3990797541 [label="Cieszę się, że znaleźliście jakieś porozumienie.",shape=box,color=red];
		j3990797541 -> j4078866560;
	j3697739866 [label="Zdecydowanie nie proponuję małżeństwa, jeszcze nie ",shape=box,color=red];
		j3697739866 -> j1158081266;
	j1791810479 [label="Czasy z pewnością się zmieniły. Nie nazwałbym ich bardziej \"formalnymi\", ale z chęcią... wszystko ci pokażę.",shape=box,color=red];
		j1791810479 -> j166045451;
	j1660678090 [label="Comme un gros chat de gouttière. Przywykłam do niego.",shape=box,color=blue];
		j1660678090 -> j1306484550;
	j4078866560 [label="Oui ! Ja także. Każdego dnia staje się mniej nieznośny.",shape=box,color=blue];
		j4078866560 -> j1660678090;
	j1158081266 [label="Teraz to ja się droczę, nie martw się ! W każdym razie, je suis ravie ! Nie mogę się doczekać, aż poznam te wszystkie nowe... romantyczne zwyczaje.",shape=box,color=blue];
		j1158081266 -> j2034999849;
	j166045451 [label="Ha ! Wiem, kiedy robisz się niegrzeczny. Niech będzie. Czekam z niecierpliwością.",shape=box,color=blue];
		j166045451 -> j2034999849;
	j1306484550 [label="To byłoby smutne, gdyby odszedł.",shape=box,color=blue];
