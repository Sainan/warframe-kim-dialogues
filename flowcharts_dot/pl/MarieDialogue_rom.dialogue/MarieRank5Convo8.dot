	j78050017 [label="Oui, qu'est-ce qu'il y a ?",shape=box,color=blue];
		j78050017 -> j2724767316;
	j1336966154 [label="Obawiam się, że powinnam nazywać go teraz \"naszym\" diabłem, non ? Prędko się stąd nie wyniesie, ha !",shape=box,color=blue];
		j1336966154 -> j2711131909;
	j1049888207 [label="Myślę, że to ja powinnam zadać to pytanie, non ? To ty wszedłeś z nim w konszachty !",shape=box,color=blue];
		j1049888207 -> j792027249;
	j2399203633 [label="Nie wiem, jak udało ci się tego dokonać, ale wyznał nam prawdę o tym, w jakich okolicznościach przyjął serum.",shape=box,color=blue];
		j2399203633 -> j3788212181;
	j891813470 [label="Nie wiem, jak udało ci się tego dokonać, ale wyznał nam prawdę o tym, w jakich okolicznościach przyjął serum.",shape=box,color=blue];
	j3181288394 [label="Martwię się o niego. Myślę, że jest zraniony bardziej, niż daje po sobie poznać, n'est-ce pas?",shape=box,color=blue];
		j3181288394 -> j2405486982;
	j2724767316 [label="Przepraszam, jeśli to zdaje się wychodzić znikąd, ale nie wiedziałem, jak ci to powiedzieć.",shape=box,color=red];
		j2724767316 -> j1297157199;
	j2711131909 [label="Dobrze zrobiłeś, że zwróciłeś się do niego po pomoc w sprawie Monsieur Loida. Nie sądziłam, że to możliwe.",shape=box,color=blue];
		j2711131909 -> j2729467400;
	j792027249 [label="Powstrzymuje się od wypytywania cię o toutes sortes de commérages.",shape=box,color=blue];
		j792027249 -> j2729467400;
	j3788212181 [label="Sol, to złamało mi serce. Jego głos nie załamał się, kiedy przemówił. Mais je l'ai vu dans ses yeux.",shape=box,color=blue];
		j3788212181 -> j2729467400;
	j2405486982 [label="Moje serce pęka. Mam nadzieję, że jego nie pęknie, nie wiem, czy byłby zdolny żyć dalej. Nie wiem, czy którekolwiek z nas byłoby do tego zdolne.",shape=box,color=blue];
		j2405486982 -> "Chat ends.";
	j1297157199 [label="Uwielbiam cię. Po prostu cię uwielbiam.",shape=box,color=red];
		j1297157199 -> j85437848;
	j2729467400 [label="Zmienił się. Tylko odrobinę, ale zmienił.",shape=box,color=blue];
		j2729467400 -> j305435766;
	j85437848 [label="I zastanawiałem się... czy ty i ja... zechciałabyś być ze mną?",shape=box,color=red];
		j85437848 -> j2298753926;
	j305435766 [label="+5 Chemistry",color=orange];
		j305435766 -> j2314027600;
	j2298753926 [label="Evaluate expressions",color=orange];
