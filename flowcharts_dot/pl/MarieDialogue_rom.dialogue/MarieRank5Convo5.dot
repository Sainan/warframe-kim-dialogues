	j1528765558 [label="Bonjour, bonjour, mon cœur ! Muszę ci powiedzieć o strasznej durnocie.",shape=box,color=blue];
		j1528765558 -> j2951783184;
		j1528765558 -> j386906797;
	j4107026568 [label="Bonjour ! Muszę ci powiedzieć o strasznej durnocie.",shape=box,color=blue];
		j4107026568 -> j2951783184;
		j4107026568 -> j386906797;
	j2951783184 [label="Och? Co się stało?",shape=box,color=red];
		j2951783184 -> j668327112;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j668327112 [label="Zapytałam M'sieur Ptak Trois, kiedy obchodzi urodziny, a on nie miał pojęcia ! Jakież to tragiczne !",shape=box,color=blue];
		j668327112 -> j4078237284;
	"Chat ends." [color=orange];
	j4078237284 [label="Nikt z Cavii nie zna dnia swoich urodzin, co chyba ma sens. Urodzili się nie znając języka, ani tym bardziej znajomości calendrier jak my.",shape=box,color=blue];
		j4078237284 -> j328900759;
	j328900759 [label="Pomyślałam, jakie to smutne ! Musimy to jak najszybciej naprawić, non ?",shape=box,color=blue];
		j328900759 -> j1922063939;
		j328900759 -> j3081102364;
		j328900759 -> j1384643875;
	j1922063939 [label="Nigdy się nad tym nie zastanawiałem.",shape=box,color=red];
		j1922063939 -> j4151042360;
	j3081102364 [label="Jak zamierzasz odkryć, kiedy się urodził?",shape=box,color=red];
		j3081102364 -> j174929917;
	j1384643875 [label="Pozwolisz mu wybrać dzień swoich urodzin?",shape=box,color=red];
		j1384643875 -> j3807339136;
	j4151042360 [label="Oui ! Monsieur Loid też nie. Kiedy to odkryłam, na jego twarzy zawitał najgłębszy smutek...",shape=box,color=blue];
		j4151042360 -> j3300751795;
	j174929917 [label="Najpierw pomyślałam, by zwrócić się do zapisków le Cardinal, może gdzieś zapisał, kiedy się narodzili, oui ?",shape=box,color=blue];
		j174929917 -> j2402114516;
	j3807339136 [label="\"Pozwolisz\" ? Mówisz, jakbym miała tu cokolwiek do powiedzenia !",shape=box,color=blue];
		j3807339136 -> j174929917;
	j3300751795 [label="Serce mi pęka na myśl, że myśli, że to jego wina, bo sam na to nie wpadł. To nie jego wina, zrobił tak wiele dla tak wielu...",shape=box,color=blue];
		j3300751795 -> j806009095;
	j2402114516 [label="Evaluate expressions",color=orange];
		j2402114516 -> j2706122961 [label="MarieEntratiComplete",color=purple];
		j2402114516 -> j2706122961 [label="MarieEntrati3a",color=purple];
		j2402114516 -> j1676748023 [label="false",color=purple];
	j806009095 [label="Mamy ogromne szczęście mogąc poznać bezgraniczną dobroć Monsieur Loida.",shape=box,color=blue];
		j806009095 -> j1649952772;
		j806009095 -> j75993065;
	j2706122961 [label="Ale wtedy przypomniałam sobie... moje rozmowy z M'sieur Tagferem i innymi, i pomyślałam... że to może nie być najmądrzejsza decyzja.",shape=box,color=blue];
		j2706122961 -> j1651377493;
	j1676748023 [label="Wydawali się niezainteresowani poszukiwaniem zapisów swojej przeszłości. Wiem, jak bolesna może być świadomość swojego pochodzenia.",shape=box,color=blue];
		j1676748023 -> j1651377493;
	j1649952772 [label="Mamy szczęście, że jest tu z nami.",shape=box,color=red];
		j1649952772 -> j1545525830;
	j75993065 [label="Chciałbym, tylko żeby czasami się rozchmurzył.",shape=box,color=red];
		j75993065 -> j2011812006;
	j1651377493 [label="Sama przecież nie znam dnia swoich narodzin. ",shape=box,color=blue];
		j1651377493 -> j1318881974;
		j1651377493 -> j2773387344;
		j1651377493 -> j3415741027;
	j1545525830 [label="Tak, wszyscy mamy ogromne szczęście.",shape=box,color=blue];
		j1545525830 -> j3542593548;
	j2011812006 [label="To poważny człowiek, ale widziałam, jak się uśmiecha. Jest w nim poczucie humoru, choć niespodziewane. Wymaga tylko cierpliwości.",shape=box,color=blue];
		j2011812006 -> j3542593548;
	j1318881974 [label="Jeśli to jakaś pociecha, ja też nie. I wątpię, żeby dzieciak ją znał.",shape=box,color=red];
		j1318881974 -> j1814778978;
	j2773387344 [label="Urodziny są przereklamowane.",shape=box,color=red];
		j2773387344 -> j2067221080;
	j3415741027 [label="À propos, myślę, że lepiej móc wybrać samemu. Bardziej znaczące.",shape=box,color=red];
		j3415741027 -> j1995228318;
	j3542593548 [label="Check boolean MarieDating",color=orange];
		j3542593548 -> j439952092 [label=true,color=green];
		j3542593548 -> j959802645 [label=false,color=brown];
	j1814778978 [label="Kolejny powód do płaczu nad tobą i twoją minuscule copie. Jeszcze jedna rzecz, która nas łączy !",shape=box,color=blue];
		j1814778978 -> j3542593548;
	j2067221080 [label="Nie uważam, żeby były przereklamowane ! Powinniśmy upamiętniać tych, którzy są z nami, zupełnie jak tych, którzy nasz opuścili.",shape=box,color=blue];
		j2067221080 -> j3542593548;
	j1995228318 [label="\"À propos\" ? Nie wiedziałam, że znasz galijski ! Podłapałeś to ode mnie ?",shape=box,color=blue];
		j1995228318 -> j4021121492;
		j1995228318 -> j3012559410;
	j439952092 [label="+20 Chemistry",color=orange];
		j439952092 -> j729633667;
	j959802645 [label="+20 Chemistry",color=orange];
		j959802645 -> j1171649020;
	j4021121492 [label="To... musi być jakieś zapożyczenie.",shape=box,color=red];
		j4021121492 -> j3506283030;
	j3012559410 [label="Musiałem to złapać od ciebie.",shape=box,color=red];
		j3012559410 -> j3018695693;
	j729633667 [label="No już ! Chodź, mon cœur ! Nawet jeśli nic z tego nie wyjdzie, liczy się intencja ! Au calendrier !",shape=box,color=blue];
		j729633667 -> "Chat ends.";
	j1171649020 [label="No już ! Chodź ! Nawet jeśli nic z tego nie wyjdzie, liczy się intencja ! Au calendrier !",shape=box,color=blue];
		j1171649020 -> "Chat ends.";
	j3506283030 [label="Pff ! Wszystkie języki wciąż kradną najlepsze kąski z galicyjskiego ! Czasy zupełnie się nie zmieniły !",shape=box,color=blue];
		j3506283030 -> j3542593548;
	j3018695693 [label="Spryciarz z ciebie ! Galijski to najpiękniejszy język, jaki kiedykolwiek powstanie i cieszę się, że może zawitać do futur.",shape=box,color=blue];
		j3018695693 -> j3542593548;
