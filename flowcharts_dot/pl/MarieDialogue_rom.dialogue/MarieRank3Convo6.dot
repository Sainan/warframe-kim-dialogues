digraph {
	1418 [label="MarieRank3Convo6 begins.",color=orange];
		1418 -> 3740;
	3740 [label="Update boolean MarieLyonAvailable",color=orange];
		3740 -> 1419;
	1419 [label="Muszę zadać ci pytanie i błagam, żebyś mnie przez to nie osądzał, Włóczęgo.",shape=box,color=blue];
		1419 -> 1420;
		1419 -> 1421;
		1419 -> 1422;
	1420 [label="Znalazłaś się w niepojętej sytuacji. Oczywiście, że nie będę cię osądzał.",shape=box,color=red];
		1420 -> 1423;
	1421 [label="Postaram się.",shape=box,color=red];
		1421 -> 1424;
	1422 [label="[Koniec]",shape=box,color=red];
		1422 -> 1425;
	1423 [label="Vraiment gentil okazujesz mi taką łaskę, nie wiedząc, czego się spodziewać.",shape=box,color=blue];
		1423 -> 1426;
	1424 [label="+10 Chemistry",color=orange];
		1424 -> 1427;
	1425 [label="Chat ends.",color=orange];
	1426 [label="Czy... ta gadatliwa ryba także przyprawia cię o migrenę ? Fibonacci ?",shape=box,color=blue];
		1426 -> 1428;
		1426 -> 1429;
		1426 -> 1430;
	1427 [label="Naprawdę to doceniam, dziękuję.",shape=box,color=blue];
		1427 -> 1426;
	1428 [label="Tak. W zupełności.",shape=box,color=red];
		1428 -> 1431;
	1429 [label="Myśl o tym, że Fibonacci działa ci na nerwy, jest niesamowicie urocza.",shape=box,color=red];
		1429 -> 1432;
	1430 [label="Nie, uwielbiam go.",shape=box,color=red];
		1430 -> 1433;
	1431 [label="Cieszę się, że nie tylko ja. Ale, żeby było jasne, nie myślę o nim źle. W tej sytuacji czuję się jak ryba wyrzucona z wody, myślę, że on radzi sobie najlepiej, jak potrafi.",shape=box,color=blue];
		1431 -> 1434;
	1432 [label="Och ? Dlaczego tak myślisz ? Chyba mnie to cieszy, ale nie wiem dlaczego. Moja migrena w żaden sposób nie jest urocza.",shape=box,color=blue];
		1432 -> 1435;
		1432 -> 1436;
	1433 [label="Mogę więc tylko błagać o twoje przebaczenie. Ale, żeby było jasne, nie myślę o nim źle. W tej sytuacji czuję się jak ryba wyrzucona z wody, myślę, że on radzi sobie najlepiej, jak potrafi.",shape=box,color=blue];
		1433 -> 1437;
	1434 [label="Po prostu nie jestem w stanie znieść jego sposobu bycia przez dłuższy czas.",shape=box,color=blue];
		1434 -> 1438;
	1435 [label="Większość swojego czasu spędzam na walce o swoje życie. Takie chwile człowieczeństwa przypominają mi... po co walczę.",shape=box,color=red];
		1435 -> 1439;
	1436 [label="Chyba czasami muszę się zatrzymać i zastanowić nad absurdem tego wszystkiego. Norg, kapłanka Sol...",shape=box,color=red];
		1436 -> 1440;
	1437 [label="Po prostu nie jestem w stanie znieść jego sposobu bycia przez dłuższy czas.",shape=box,color=blue];
		1437 -> 1441;
	1438 [label="Ech. Nie powinnam narzekać. Muszę zanieść dzisiaj obiad Leonowi, po raz kolejny położyło go okrutne schorzenie.",shape=box,color=blue];
		1438 -> 1442;
		1438 -> 1443;
	1439 [label="+5 Chemistry",color=orange];
		1439 -> 1444;
	1440 [label="+5 Chemistry",color=orange];
		1440 -> 1445;
	1441 [label="Ech. Nie powinnam narzekać. Muszę zanieść dzisiaj obiad Leonowi, po raz kolejny położyło go okrutne schorzenie.",shape=box,color=blue];
		1441 -> 1442;
		1441 -> 1443;
	1442 [label="Często ma takie napady?",shape=box,color=red];
		1442 -> 1446;
	1443 [label="Przepraszam... co go położyło?",shape=box,color=red];
		1443 -> 1447;
	1444 [label="Nie pozwól sobie zatracić tej części siebie, Włóczęgo. Nigdy nie odpuść części siebie, która szuka radości w życiu.",shape=box,color=blue];
		1444 -> 1448;
	1445 [label="O rany, skoro tak to widzisz. To zaczyna brzmieć jak dziecinny żart, n'est-ce pas ?",shape=box,color=blue];
		1445 -> 1449;
	1446 [label="Oui, oui. Raz na kilka tygodni ? Raz na dwa miesiące ? Najdłuższy okres bez epizodu, jaki pamiętam, trwał około pół roku.",shape=box,color=blue];
		1446 -> 1450;
	1447 [label="Och ! Mój drogi. Hmm. To coś jak ból głowy, ale znacznie silniejszy. Słyszałam, że niektórzy nazywają je żółciowymi bólami głowy. Są powszechniejsze wśród kobiet.",shape=box,color=blue];
		1447 -> 1451;
		1447 -> 1452;
	1448 [label="Świat jest aż za bardzo skłonny stać się mrocznym i poważnym miejscem. Nazbyt chętnie zaskakuje nas cierpieniem na każdym kroku.",shape=box,color=blue];
		1448 -> 1453;
	1449 [label="Siostra, Ksiądz i diabeł zostają zesłani do przeszłości... a potem do przyszłości... i spotykają się z rybą, jeleniowatym, wielkim ptakiem i lokajem...",shape=box,color=blue];
		1449 -> 1454;
	1450 [label="Check boolean Megrim",color=orange];
		1450 -> 1455 [label=true,color=green];
		1450 -> 1456 [label=true,color=green];
		1450 -> 1458 [label=true,color=green];
		1450 -> 1455 [label=false,color=brown];
		1450 -> 1456 [label=false,color=brown];
		1450 -> 1457 [label=false,color=brown];
	1451 [label="W tych czasach nazywamy to \"migreną\".",shape=box,color=red];
		1451 -> 1459;
	1452 [label="Aha, migreny. Dziękuję za wyjaśnienie.",shape=box,color=red];
		1452 -> 1460;
	1453 [label="Musimy cieszyć się każdym szczęściem, na jakie trafimy, nawet jeśli dziecinnym.",shape=box,color=blue];
		1453 -> 1461;
	1454 [label="Masz rację, to całkiem zabawna sytuacja !",shape=box,color=blue];
		1454 -> 1462;
	1455 [label="Zastanawiam się, skąd się biorą.",shape=box,color=red];
		1455 -> 1463;
	1456 [label="Brzmi koszmarnie...",shape=box,color=red];
		1456 -> 1464;
	1458 [label="Też czasem miewam migreny. Są okropne.",shape=box,color=red];
		1458 -> 1465;
	1457 [label="Też czasem miewam takie bóle głowy. Są okropne.",shape=box,color=red];
		1457 -> 1465;
	1459 [label="Ciekawe, jakie napotkamy jeszcze fascynujące historyczne particularités ! Jakie to ekscytujące. Uwielbiam poznawać nowe rzeczy. \"Migrena\". Ta podróż z pewnością nie zabrała mnie daleko.",shape=box,color=blue];
		1459 -> 1466;
	1460 [label="Update boolean Megrim",color=orange];
		1460 -> 1467;
	1461 [label="Chciałabym, żeby i Leon był w stanie tak na to spojrzeć.",shape=box,color=blue];
		1461 -> 1468;
	1462 [label="Gdyby tylko mój drogi Leon był w stanie dostrzec to piękno.",shape=box,color=blue];
		1462 -> 1468;
	1463 [label="Leon ma swoje teorie. ",shape=box,color=blue];
		1463 -> 1469;
	1464 [label="Gdybyś wyraził swoje współczucie, na pewno byłoby to mile widziane. I wbrew pozorom, on doceniłby towarzystwo.",shape=box,color=blue];
		1464 -> 1470;
	1465 [label="Naprawdę ? Powinieneś powiedzieć Leonowi. Musi wiedzieć, że inni też cierpią tak jak on.",shape=box,color=blue];
		1465 -> 1471;
	1466 [label="Update boolean Migraine",color=orange];
		1466 -> 1467;
	1467 [label="Jak tego nie nazwać, Leon obecnie się z tym zmaga i będzie się zmagać do rana. Biedny chłopak nie jest w stanie widzieć, ani poczuć swoich rąk i nóg. Mówi mi, że ból jest nie do zniesienia.",shape=box,color=blue];
		1467 -> 1450;
	1468 [label="Update boolean MarieLyonSuffering1",color=orange];
		1468 -> 1472;
	1469 [label="Choć może lepiej powiedzieć, że miał swoje teorie do niedawna.",shape=box,color=blue];
		1469 -> 1473;
	1470 [label="Choć jego zachowanie może cię odstraszać, błagam cię, bądź silny, Włóczęgo. Za jego stoickim spokojem kryje się człowiek o wielkiej potrzebie.",shape=box,color=blue];
		1470 -> 1474;
		1470 -> 1475;
		1470 -> 1476;
	1471 [label="+5 Chemistry",color=orange];
		1471 -> 1477;
	1472 [label="Ach, a skoro o tym mowa. Nienawidzę narzekać na bóle głowy. Muszę zanieść dzisiaj obiad Leonowi, po raz kolejny ogarnął go okropny megrim.",shape=box,color=blue];
		1472 -> 1443;
		1472 -> 1442;
	1473 [label="Update boolean MarieLyonFaith1",color=orange];
		1473 -> 1470;
	1474 [label="Potrafię być bardzo uparty, nie martw się.",shape=box,color=red];
		1474 -> 1478;
	1475 [label="Mam już jednego Pana ze Ściany... dlaczego nie dwóch?",shape=box,color=red];
		1475 -> 1479;
	1476 [label="Jest dorosłym mężczyzną. Porozmawia, jeśli będzie miał na to ochotę.",shape=box,color=red];
		1476 -> 1480;
	1477 [label="Świetliści wiedzą, że gdyby to była jego decyzja, cierpiałby sam...",shape=box,color=blue];
		1477 -> 1481;
	1478 [label="+5 Chemistry",color=orange];
		1478 -> 1482;
	1479 [label="Ze mną możesz tak żartować, ale oszczędź sobie takich komentarzy przy nim. Twoja Indifférence sprawiła mu wiele bólu.",shape=box,color=blue];
		1479 -> 1483;
	1480 [label="Jest dorosły, tak. Jest też mężczyzną. I wierzę też, że chce rozmawiać. Ale zachęcam cię, żebyś zapytał, czy jest w stanie.",shape=box,color=blue];
		1480 -> 1484;
	1481 [label="Update boolean MarieLyonSuffering2",color=orange];
		1481 -> 1470;
	1482 [label="Obawiam się, że będzie Ci potrzebny. Dziękuję, Włóczęgo, Leon jest moim najdroższym przyjacielem, jest mi jak brat. Moje serce się kraje, widząc go w takim cierpieniu.",shape=box,color=blue];
		1482 -> 1485;
	1483 [label="Bądź wytrwały. I cierpliwy. I dobry. Jest mi jak brat i jest moim najbliższym przyjacielem. Włóczęgo, moje serce się kraje, widząc, jak cierpi.",shape=box,color=blue];
		1483 -> 1485;
	1484 [label="Nie wszyscy z nas zostali tak sam obdarowani i nie wszyscy uważamy, że nam się to należy. On cierpi i wierzy, że jest to jego przeznaczenie.",shape=box,color=blue];
		1484 -> 1486;
	1485 [label="Wkrótce porozmawiamy. Par la grâce de Sol.",shape=box,color=blue];
		1485 -> 3734;
	1486 [label="Jest mi jak brat i jest moim najbliższym przyjacielem. Serce pęka mi na tę myśl. Proszę cię tylko... bądź cierpliwy. I delikatny. Jeśli jesteś do tego zdolny.",shape=box,color=blue];
		1486 -> 1485;
	3734 [label="{\"Id\":3734,\"Incoming\":[1485],\"Outgoing\":[1487],\"GraphPos\":[12826,24521],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue\",\"Tag\":\"LyonHeadaches\",\"Value\":0}]}",color=orange];
		3734 -> 1487;
	1487 [label="Chat ends.",color=orange];
}