	j1309061496 [label="Vraiment gentil okazujesz mi taką łaskę, nie wiedząc, czego się spodziewać.",shape=box,color=blue];
		j1309061496 -> j4220309771;
	j2050106910 [label="+10 Chemistry",color=orange];
		j2050106910 -> j390260529;
	"Chat ends." [color=orange];
	j4220309771 [label="Czy... ta gadatliwa ryba także przyprawia cię o migrenę ? Fibonacci ?",shape=box,color=blue];
		j4220309771 -> j4051515087;
		j4220309771 -> j2811066181;
		j4220309771 -> j2989321682;
	j390260529 [label="Naprawdę to doceniam, dziękuję.",shape=box,color=blue];
		j390260529 -> j4220309771;
	j4051515087 [label="Tak. W zupełności.",shape=box,color=red];
		j4051515087 -> j2796234668;
	j2811066181 [label="Myśl o tym, że Fibonacci działa ci na nerwy, jest niesamowicie urocza.",shape=box,color=red];
		j2811066181 -> j323055595;
	j2989321682 [label="Nie, uwielbiam go.",shape=box,color=red];
		j2989321682 -> j2060425605;
	j2796234668 [label="Cieszę się, że nie tylko ja. Ale, żeby było jasne, nie myślę o nim źle. W tej sytuacji czuję się jak ryba wyrzucona z wody, myślę, że on radzi sobie najlepiej, jak potrafi.",shape=box,color=blue];
		j2796234668 -> j432026612;
	j323055595 [label="Och ? Dlaczego tak myślisz ? Chyba mnie to cieszy, ale nie wiem dlaczego. Moja migrena w żaden sposób nie jest urocza.",shape=box,color=blue];
		j323055595 -> j3644943824;
		j323055595 -> j3406436506;
	j2060425605 [label="Mogę więc tylko błagać o twoje przebaczenie. Ale, żeby było jasne, nie myślę o nim źle. W tej sytuacji czuję się jak ryba wyrzucona z wody, myślę, że on radzi sobie najlepiej, jak potrafi.",shape=box,color=blue];
		j2060425605 -> j1026423175;
	j432026612 [label="Po prostu nie jestem w stanie znieść jego sposobu bycia przez dłuższy czas.",shape=box,color=blue];
		j432026612 -> j1148374677;
	j3644943824 [label="Większość swojego czasu spędzam na walce o swoje życie. Takie chwile człowieczeństwa przypominają mi... po co walczę.",shape=box,color=red];
		j3644943824 -> j3903904343;
	j3406436506 [label="Chyba czasami muszę się zatrzymać i zastanowić nad absurdem tego wszystkiego. Norg, kapłanka Sol...",shape=box,color=red];
		j3406436506 -> j1531639060;
	j1026423175 [label="Po prostu nie jestem w stanie znieść jego sposobu bycia przez dłuższy czas.",shape=box,color=blue];
		j1026423175 -> j1148374677;
	j1148374677 [label="Ech. Nie powinnam narzekać. Muszę zanieść dzisiaj obiad Leonowi, po raz kolejny położyło go okrutne schorzenie.",shape=box,color=blue];
		j1148374677 -> j2407836562;
		j1148374677 -> j2123091047;
	j3903904343 [label="+5 Chemistry",color=orange];
		j3903904343 -> j4279697071;
	j1531639060 [label="+5 Chemistry",color=orange];
		j1531639060 -> j2874496269;
	j2407836562 [label="Często ma takie napady?",shape=box,color=red];
		j2407836562 -> j2020041124;
	j2123091047 [label="Przepraszam... co go położyło?",shape=box,color=red];
		j2123091047 -> j2824491788;
	j4279697071 [label="Nie pozwól sobie zatracić tej części siebie, Włóczęgo. Nigdy nie odpuść części siebie, która szuka radości w życiu.",shape=box,color=blue];
		j4279697071 -> j1012432487;
	j2874496269 [label="O rany, skoro tak to widzisz. To zaczyna brzmieć jak dziecinny żart, n'est-ce pas ?",shape=box,color=blue];
		j2874496269 -> j1026891912;
	j2020041124 [label="Oui, oui. Raz na kilka tygodni ? Raz na dwa miesiące ? Najdłuższy okres bez epizodu, jaki pamiętam, trwał około pół roku.",shape=box,color=blue];
		j2020041124 -> j547018639;
	j2824491788 [label="Och ! Mój drogi. Hmm. To coś jak ból głowy, ale znacznie silniejszy. Słyszałam, że niektórzy nazywają je żółciowymi bólami głowy. Są powszechniejsze wśród kobiet.",shape=box,color=blue];
		j2824491788 -> j3238686928;
		j2824491788 -> j3571469825;
	j1012432487 [label="Świat jest aż za bardzo skłonny stać się mrocznym i poważnym miejscem. Nazbyt chętnie zaskakuje nas cierpieniem na każdym kroku.",shape=box,color=blue];
		j1012432487 -> j2709481505;
	j1026891912 [label="Siostra, Ksiądz i diabeł zostają zesłani do przeszłości... a potem do przyszłości... i spotykają się z rybą, jeleniowatym, wielkim ptakiem i lokajem...",shape=box,color=blue];
		j1026891912 -> j505605484;
	j547018639 [label="Check boolean Megrim",color=orange];
		j547018639 -> j1842104859 [label=true,color=green];
		j547018639 -> j1427961476 [label=true,color=green];
		j547018639 -> j2477120419 [label=true,color=green];
		j547018639 -> j1842104859 [label=false,color=brown];
		j547018639 -> j1427961476 [label=false,color=brown];
		j547018639 -> j3213496297 [label=false,color=brown];
	j3238686928 [label="W tych czasach nazywamy to \"migreną\".",shape=box,color=red];
		j3238686928 -> j3201333733;
	j3571469825 [label="Aha, migreny. Dziękuję za wyjaśnienie.",shape=box,color=red];
		j3571469825 -> j3262125370;
	j2709481505 [label="Musimy cieszyć się każdym szczęściem, na jakie trafimy, nawet jeśli dziecinnym.",shape=box,color=blue];
		j2709481505 -> j2134156870;
	j505605484 [label="Masz rację, to całkiem zabawna sytuacja !",shape=box,color=blue];
		j505605484 -> j2695828151;
	j1842104859 [label="Zastanawiam się, skąd się biorą.",shape=box,color=red];
		j1842104859 -> j267550082;
	j1427961476 [label="Brzmi koszmarnie...",shape=box,color=red];
		j1427961476 -> j3290365099;
	j2477120419 [label="Też czasem miewam migreny. Są okropne.",shape=box,color=red];
		j2477120419 -> j4178265819;
	j3213496297 [label="Też czasem miewam takie bóle głowy. Są okropne.",shape=box,color=red];
		j3213496297 -> j4178265819;
	j3201333733 [label="Ciekawe, jakie napotkamy jeszcze fascynujące historyczne particularités ! Jakie to ekscytujące. Uwielbiam poznawać nowe rzeczy. \"Migrena\". Ta podróż z pewnością nie zabrała mnie daleko.",shape=box,color=blue];
		j3201333733 -> j3908910570;
	j3262125370 [label="Boolean Megrim is now true.",color=orange];
		j3262125370 -> j2661830;
	j2134156870 [label="Chciałabym, żeby i Leon był w stanie tak na to spojrzeć.",shape=box,color=blue];
		j2134156870 -> j2635095474;
	j2695828151 [label="Gdyby tylko mój drogi Leon był w stanie dostrzec to piękno.",shape=box,color=blue];
		j2695828151 -> j2635095474;
	j267550082 [label="Leon ma swoje teorie. ",shape=box,color=blue];
		j267550082 -> j3828432041;
	j3290365099 [label="Gdybyś wyraził swoje współczucie, na pewno byłoby to mile widziane. I wbrew pozorom, on doceniłby towarzystwo.",shape=box,color=blue];
		j3290365099 -> j73675867;
	j4178265819 [label="Naprawdę ? Powinieneś powiedzieć Leonowi. Musi wiedzieć, że inni też cierpią tak jak on.",shape=box,color=blue];
		j4178265819 -> j2413787134;
	j3908910570 [label="Boolean Migraine is now true.",color=orange];
		j3908910570 -> j2661830;
	j2661830 [label="Jak tego nie nazwać, Leon obecnie się z tym zmaga i będzie się zmagać do rana. Biedny chłopak nie jest w stanie widzieć, ani poczuć swoich rąk i nóg. Mówi mi, że ból jest nie do zniesienia.",shape=box,color=blue];
		j2661830 -> j547018639;
	j2635095474 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j2635095474 -> j3167079631;
	j3828432041 [label="Choć może lepiej powiedzieć, że miał swoje teorie do niedawna.",shape=box,color=blue];
		j3828432041 -> j3190868056;
	j73675867 [label="Choć jego zachowanie może cię odstraszać, błagam cię, bądź silny, Włóczęgo. Za jego stoickim spokojem kryje się człowiek o wielkiej potrzebie.",shape=box,color=blue];
		j73675867 -> j108811975;
		j73675867 -> j1717535702;
		j73675867 -> j307375554;
	j2413787134 [label="+5 Chemistry",color=orange];
		j2413787134 -> j634887078;
	j3167079631 [label="Ach, a skoro o tym mowa. Nienawidzę narzekać na bóle głowy. Muszę zanieść dzisiaj obiad Leonowi, po raz kolejny ogarnął go okropny megrim.",shape=box,color=blue];
		j3167079631 -> j2123091047;
		j3167079631 -> j2407836562;
	j3190868056 [label="Boolean MarieLyonFaith1 is now true.",color=orange];
		j3190868056 -> j73675867;
	j108811975 [label="Potrafię być bardzo uparty, nie martw się.",shape=box,color=red];
		j108811975 -> j997375980;
	j1717535702 [label="Mam już jednego Pana ze Ściany... dlaczego nie dwóch?",shape=box,color=red];
		j1717535702 -> j2645888248;
	j307375554 [label="Jest dorosłym mężczyzną. Porozmawia, jeśli będzie miał na to ochotę.",shape=box,color=red];
		j307375554 -> j241660164;
	j634887078 [label="Świetliści wiedzą, że gdyby to była jego decyzja, cierpiałby sam...",shape=box,color=blue];
		j634887078 -> j3981520731;
	j997375980 [label="+5 Chemistry",color=orange];
		j997375980 -> j2767611177;
	j2645888248 [label="Ze mną możesz tak żartować, ale oszczędź sobie takich komentarzy przy nim. Twoja Indifférence sprawiła mu wiele bólu.",shape=box,color=blue];
		j2645888248 -> j1118795437;
	j241660164 [label="Jest dorosły, tak. Jest też mężczyzną. I wierzę też, że chce rozmawiać. Ale zachęcam cię, żebyś zapytał, czy jest w stanie.",shape=box,color=blue];
		j241660164 -> j4165970144;
	j3981520731 [label="Boolean MarieLyonSuffering2 is now true.",color=orange];
		j3981520731 -> j73675867;
	j2767611177 [label="Obawiam się, że będzie Ci potrzebny. Dziękuję, Włóczęgo, Leon jest moim najdroższym przyjacielem, jest mi jak brat. Moje serce się kraje, widząc go w takim cierpieniu.",shape=box,color=blue];
		j2767611177 -> j3215853896;
	j1118795437 [label="Bądź wytrwały. I cierpliwy. I dobry. Jest mi jak brat i jest moim najbliższym przyjacielem. Włóczęgo, moje serce się kraje, widząc, jak cierpi.",shape=box,color=blue];
		j1118795437 -> j3215853896;
	j4165970144 [label="Nie wszyscy z nas zostali tak sam obdarowani i nie wszyscy uważamy, że nam się to należy. On cierpi i wierzy, że jest to jego przeznaczenie.",shape=box,color=blue];
		j4165970144 -> j2486710271;
	j3215853896 [label="Wkrótce porozmawiamy. Par la grâce de Sol.",shape=box,color=blue];
		j3215853896 -> "Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j2486710271 [label="Jest mi jak brat i jest moim najbliższym przyjacielem. Serce pęka mi na tę myśl. Proszę cię tylko... bądź cierpliwy. I delikatny. Jeśli jesteś do tego zdolny.",shape=box,color=blue];
		j2486710271 -> j3215853896;
	"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
