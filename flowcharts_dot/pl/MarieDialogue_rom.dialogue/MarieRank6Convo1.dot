	"Chat ends." [color=orange];
	j4019498706 [label="Byłeś takim dobrym przyjacielem. Sojusznikiem, o jakim nie mogłabym marzyć. ",shape=box,color=blue];
		j4019498706 -> j1550207412;
	j3727875287 [label="Oui, a myślę, że takiego go wolisz, non ? Ha ! Nie chcę myśleć o diable w ten sposób ! Nie o tym chciałam porozmawiać.",shape=box,color=blue];
