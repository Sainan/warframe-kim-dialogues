		j3470333215 -> j298611710 [label="false",color=purple];
	j2677385871 [label="Wiem, że wyznałeś mi swoje uczucia. Ale wiem też, że w twoim sercu zagościła już inna osoba. Chcę tylko powiedzieć, że cieszę się waszym szczęściem !",shape=box,color=blue];
		j2677385871 -> j3505747573;
	j2323399870 [label="Już raz wspomniałeś mi, że... nie wiem jak ubrać to w słowa. Że żywisz do mnie uczucie. Ale wiem też, że w twoim sercu zagościł już ktoś inny.",shape=box,color=blue];
		j2323399870 -> j3419017151;
		j2323399870 -> j4149214299;
	j1474994060 [label="Już raz wspomniałeś mi, że... nie wiem jak ubrać to w słowa. Że żywisz do mnie uczucie.",shape=box,color=blue];
