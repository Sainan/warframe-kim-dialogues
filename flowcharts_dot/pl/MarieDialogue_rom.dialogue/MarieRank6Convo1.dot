		3369 -> 3379;
	3893 [label="I simply pray that you do not lead Lyon astray or hurt him needlessly. He is a delicate thing, beneath that exterior of stone.",shape=box,color=blue];
		3893 -> 3895;
	3894 [label="Nie chcę, by Roathe cierpiał, nawet jeśli wciąż go nękam i pouczam. Nie chcę, by żył w bólu, jeśli zdołasz na to zaradzić.",shape=box,color=blue];
