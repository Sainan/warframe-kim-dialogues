		3318 -> 3333;
	3336 [label="To bring each other pleasure when you are in love. To bring each other agonie when you are lost to hatred. This is the gift of humanité - this is what the Indifference is not.",shape=box,color=blue];
		3336 -> 3349;
	3343 [label="Czego uczy nas Obojętność, skądkolwiek by nie pochodziła, jeśli nie tego, by zachować wszystko, co odrzuciła, co zniszczyła ?",shape=box,color=blue];
