		3293 -> 3301 [label="MarieWillDate",color=purple];
		3293 -> 3302 [label="false",color=purple];
	3304 [label="I zastanawiałam się, czy właśnie to chce zniszczyć Obojętność ? Czy tym żywi się Obojętność ? Mocą wpłynięcia na innych ?",shape=box,color=blue];
		3304 -> 3321;
	3309 [label="Pomogłeś bratu mojej duszy zaznać spokoju. Przekonałeś go, że mamy prawdziwego wroga - i dałeś mu nadzieję.",shape=box,color=blue];
		3309 -> 3329;
	3310 [label="Pomogłeś bratu mojej duszy zaznać ukojenia i spokoju, jakiego nie doświadczył wcześniej. Myślę, że twoje towarzystwo znaczyło dla niego więcej, niż jest zdolny wyrazić.",shape=box,color=blue];
		3310 -> 3329;
	3311 [label="Choć możemy nigdy nie dowiedzieć się, czym naprawdę jest Obojętność, wiemy, że nie ma to znaczenia. Musimy zmierzyć się z zagrożeniem, jakie stanowi.",shape=box,color=blue];
		3311 -> 3329;
	3312 [label="Nie sądziłam, że nasz diabeł da się przekonać do pomocy w pojednaniu Monsieur Loida i rodziny le Cardinal. Wiem, że jego motywacje mogą być... wątpliwe, i nadal nie do końca mu ufam. ",shape=box,color=blue];
		3312 -> 3330;
	3313 [label="Nie sądziłam, że diabeł będzie zdolny zrozumieć swoje błędy. Że mógłby poczuć żal za wszystkie niewinne istnienia, jakie poświęcił. Udowodniłeś mi, że się myliłam.",shape=box,color=blue];
		3313 -> 3331;
	3314 [label="Jakiekolwiek okowy zarzuciłeś na diabła, trzymają go one pod kontrolą. Wydaje się bardziej... udomowiony, niż wcześniej. I to twoja zasługa.",shape=box,color=blue];
		3314 -> 3331;
	3315 [label="Wspomnienia, które pomogliśmy mu odzyskać, pozwoliły mu złagodnieć. Może pamięć żalu za wszystkimi, których stracił, przypomniała mu o tych, których nadal może stracić.",shape=box,color=blue];
		3315 -> 3331;
	3316 [label="Perhaps it is his fondness for you that tempers him, I do not know. Whatever the reason, I know you are to thank for it.",shape=box,color=blue];
		3316 -> 3331;
	3308 [label="W żaden sposób nie życzę wam źle, cieszę się waszym szczęściem, oui ?",shape=box,color=blue];
		3308 -> 3327;
		3308 -> 3328;
	3306 [label="Sprawy się zmieniły, a ja... zostanę z nimi. Przykro mi.",shape=box,color=red];
		3306 -> 3325;
	3307 [label="Wiem, że może być trudno w to uwierzyć, a może nawet zaakceptować. Ale ja... kocham cię. I kocham też ich. Równie mocno.",shape=box,color=red];
		3307 -> 3326;
