	j4092290428 [label="I zastanawiałam się, czy właśnie to chce zniszczyć Obojętność ? Czy tym żywi się Obojętność ? Mocą wpłynięcia na innych ?",shape=box,color=blue];
		j4092290428 -> j2886324865;
	j2651412974 [label="Obawiam się, że chcesz wypowiedzieć słowa, których nie zdołasz cofnąć. Że to zmieni wszystko między nami, na zawsze.",shape=box,color=blue];
		j2651412974 -> j1171907509;
	j2314777629 [label="Mon cœur t'appartient depuis notre première rencontre...",shape=box,color=blue];
		j2314777629 -> j1492744126;
		j2314777629 -> j426265698;
	j507897666 [label="Dar, by doprowadzać się nawzajem do śmiechu. Do łez. Przekonać nawzajem o prawdach i kłamstwach. By zmieniać swoje poglądy. Wspierać się, kiedy cierpimy. Ranić siebie w głupocie.",shape=box,color=blue];
		j507897666 -> j3969814375;
	j2323457906 [label="I jakie ma to znaczenie, kiedy ty możesz pokierować Leona przez najgorszy sztorm, zostać u jego boku w chwilach bólu i agonii ?",shape=box,color=blue];
		j2323457906 -> j3982221750;
	j3723587119 [label="Ta zmiana jest bez wątpienia twoją zasługą. Roathe został z nami i broni rodziny le Cardinal dzięki tobie.",shape=box,color=blue];
		j3723587119 -> j3297971406;
	j3297971406 [label="I zdaję sobie sprawę, że diabeł nie jest naszym wrogiem, oui ? To Obojętność. A czego uczy nas Obojętność, jeśli nie tego, by zachować wszystko, co odrzuciła, co zniszczyła ?",shape=box,color=blue];
		j3297971406 -> j3567432963;
	j201724825 [label="Ale... gdyby",shape=box,color=red];
		j201724825 -> j718162148;
	j725141921 [label="Nadal cię kocham, Mario.",shape=box,color=red];
		j725141921 -> j572387199;
	j2796664641 [label="Oui, rozumiem. Oczywiście, że rozumiem ! Jak mogłabym cię winić za podążanie za głosem serca ?",shape=box,color=blue];
		j2796664641 -> j2017910355;
	j3734127592 [label="Evaluate expressions",color=orange];
		j3734127592 -> j1833172455 [label="MarieNoDate",color=purple];
		j3734127592 -> j2176360720 [label="MarieWillDate",color=purple];
		j3734127592 -> j1833172455 [label="false",color=purple];
	j1833172455 [label="Nie wiem, jak powiedzieć to w sposób, który nie zabrzmi okrutnie... więc powiem tylko tyle.",shape=box,color=blue];
		j1833172455 -> j3568860926;
	j3540623507 [label="Tak. I zgaduję... że nie czujesz tego samego?",shape=box,color=red];
		j3540623507 -> j1058275851;
	j2050452138 [label="To się zmieniło i... przepraszam.",shape=box,color=red];
		j2050452138 -> j1539120137;
	j2886324865 [label="Dar, by doprowadzać się nawzajem do śmiechu. Do łez. Przekonać nawzajem o prawdach i kłamstwach. By zmieniać swoje poglądy. Wspierać się, kiedy cierpimy. Ranić siebie w głupocie.",shape=box,color=blue];
		j2886324865 -> j2426255810;
	j1171907509 [label="I wielkie cierpienie sprawia mi przerywanie ci, zanim je wypowiesz.",shape=box,color=blue];
		j1171907509 -> j3640751489;
	j1492744126 [label="Nie mam pojęcia, co próbujesz powiedzieć.",shape=box,color=red];
		j1492744126 -> j2385306668;
	j426265698 [label="Mon cœur t'appartient également, Marie !",shape=box,color=red];
		j426265698 -> j2764819016;
	j3969814375 [label="Sprawiać sobie rozkosz w miłości. Sprawiać agonię w nienawiści. To jest dar humanité, to jest coś, do czego Obojętność nie jest zdolna.",shape=box,color=blue];
		j3969814375 -> j238637106;
	j3982221750 [label="Czego uczy nas Obojętność, skądkolwiek by nie pochodziła, jeśli nie tego, by zachować wszystko, co odrzuciła, co zniszczyła ?",shape=box,color=blue];
		j3982221750 -> j3026057249;
	j3567432963 [label="Myślałam o tym, ile czasu spędziliśmy razem. I o tym, jak nieznaczący jest to okres w kontekście całego twojego życia.",shape=box,color=blue];
		j3567432963 -> j427970053;
	j718162148 [label="W takim razie obawiam się... że pierw musisz zapanować najpierw nad swoim własnym sercem, Włóczęgo. Nie zdołam zrobić tego za ciebie.",shape=box,color=blue];
		j718162148 -> j3699890413;
	j572387199 [label="Tak może być. Nie jestem zazdrosną istotą, ale to jedna sprawa wiedzieć, że ktoś zaskarbił twoje serce, kiedy ich nie znam -",shape=box,color=blue];
		j572387199 -> j2663226100;
