		j1471879296 -> j2314777629 [label="MarieWillDate",color=purple];
		j1471879296 -> j2651412974 [label="false",color=purple];
	j518451570 [label="I zastanawiałam się, czy właśnie to chce zniszczyć Obojętność ? Czy tym żywi się Obojętność ? Mocą wpłynięcia na innych ?",shape=box,color=blue];
		j518451570 -> j507897666;
	j1553742228 [label="Pomogłeś bratu mojej duszy zaznać spokoju. Przekonałeś go, że mamy prawdziwego wroga - i dałeś mu nadzieję.",shape=box,color=blue];
		j1553742228 -> j2323457906;
	j2108910938 [label="Pomogłeś bratu mojej duszy zaznać ukojenia i spokoju, jakiego nie doświadczył wcześniej. Myślę, że twoje towarzystwo znaczyło dla niego więcej, niż jest zdolny wyrazić.",shape=box,color=blue];
		j2108910938 -> j2323457906;
	j4256125281 [label="Choć możemy nigdy nie dowiedzieć się, czym naprawdę jest Obojętność, wiemy, że nie ma to znaczenia. Musimy zmierzyć się z zagrożeniem, jakie stanowi.",shape=box,color=blue];
		j4256125281 -> j2323457906;
	j2252103499 [label="Nie sądziłam, że nasz diabeł da się przekonać do pomocy w pojednaniu Monsieur Loida i rodziny le Cardinal. Wiem, że jego motywacje mogą być... wątpliwe, i nadal nie do końca mu ufam. ",shape=box,color=blue];
		j2252103499 -> j3723587119;
	j1840461001 [label="Nie sądziłam, że diabeł będzie zdolny zrozumieć swoje błędy. Że mógłby poczuć żal za wszystkie niewinne istnienia, jakie poświęcił. Udowodniłeś mi, że się myliłam.",shape=box,color=blue];
		j1840461001 -> j3297971406;
	j3616858864 [label="Jakiekolwiek okowy zarzuciłeś na diabła, trzymają go one pod kontrolą. Wydaje się bardziej... udomowiony, niż wcześniej. I to twoja zasługa.",shape=box,color=blue];
		j3616858864 -> j3297971406;
	j3178779458 [label="Wspomnienia, które pomogliśmy mu odzyskać, pozwoliły mu złagodnieć. Może pamięć żalu za wszystkimi, których stracił, przypomniała mu o tych, których nadal może stracić.",shape=box,color=blue];
		j3178779458 -> j3297971406;
	j298611710 [label="Może to jego sympatia do ciebie go ukoiła, nie wiem. W każdym razie wiem, że tobie należą się podziękowania.",shape=box,color=blue];
		j298611710 -> j3297971406;
	j3505747573 [label="W żaden sposób nie życzę wam źle, cieszę się waszym szczęściem, oui ?",shape=box,color=blue];
		j3505747573 -> j201724825;
		j3505747573 -> j725141921;
	j3419017151 [label="Sprawy się zmieniły, a ja... zostanę z nimi. Przykro mi.",shape=box,color=red];
		j3419017151 -> j2796664641;
	j4149214299 [label="Wiem, że może być trudno w to uwierzyć, a może nawet zaakceptować. Ale ja... kocham cię. I kocham też ich. Równie mocno.",shape=box,color=red];
		j4149214299 -> j3734127592;
	j1928846357 [label="Evaluate expressions",color=orange];
		j1928846357 -> j1833172455 [label="MarieNoDate",color=purple];
