	j3101271913 [label="I zastanawiałam się, czy właśnie to chce zniszczyć Obojętność ? Czy tym żywi się Obojętność ? Mocą wpłynięcia na innych ?",shape=box,color=blue];
		j3101271913 -> j306286366;
	j2651412974 [label="Obawiam się, że chcesz wypowiedzieć słowa, których nie zdołasz cofnąć. Że to zmieni wszystko między nami, na zawsze.",shape=box,color=blue];
		j2651412974 -> j1171907509;
	j2314777629 [label="Mon cœur t'appartient depuis notre première rencontre...",shape=box,color=blue];
		j2314777629 -> j3180355728;
		j2314777629 -> j290683496;
	j1298689764 [label="Dar, by doprowadzać się nawzajem do śmiechu. Do łez. Przekonać nawzajem o prawdach i kłamstwach. By zmieniać swoje poglądy. Wspierać się, kiedy cierpimy. Ranić siebie w głupocie.",shape=box,color=blue];
		j1298689764 -> j1623301315;
	j1757481119 [label="I jakie ma to znaczenie, kiedy ty możesz pokierować Leona przez najgorszy sztorm, zostać u jego boku w chwilach bólu i agonii ?",shape=box,color=blue];
		j1757481119 -> j788659737;
	j1827727555 [label="Ta zmiana jest bez wątpienia twoją zasługą. Roathe został z nami i broni rodziny le Cardinal dzięki tobie.",shape=box,color=blue];
		j1827727555 -> j1808782742;
	j1808782742 [label="I zdaję sobie sprawę, że diabeł nie jest naszym wrogiem, oui ? To Obojętność. A czego uczy nas Obojętność, jeśli nie tego, by zachować wszystko, co odrzuciła, co zniszczyła ?",shape=box,color=blue];
		j1808782742 -> j3225612669;
	j11439812 [label="But... what if ",shape=box,color=red];
		j11439812 -> j650068158;
	j2021057156 [label="Nadal cię kocham, Mario.",shape=box,color=red];
		j2021057156 -> j253666527;
	j2457839260 [label="Oui, I understand. Of course, I understand ! How could I fault you for following your soul ?",shape=box,color=blue];
		j2457839260 -> j2017910355;
	j3734127592 [label="Evaluate expressions",color=orange];
		j3734127592 -> j1833172455 [label="MarieNoDate",color=purple];
		j3734127592 -> j1954118222 [label="MarieWillDate",color=purple];
		j3734127592 -> j1833172455 [label="false",color=purple];
	j1833172455 [label="Nie wiem, jak powiedzieć to w sposób, który nie zabrzmi okrutnie... więc powiem tylko tyle.",shape=box,color=blue];
		j1833172455 -> j3568860926;
	j2365847376 [label="Tak. I zgaduję... że nie czujesz tego samego?",shape=box,color=red];
		j2365847376 -> j3647575710;
	j2050452138 [label="To się zmieniło i... przepraszam.",shape=box,color=red];
		j2050452138 -> j1539120137;
	j306286366 [label="Dar, by doprowadzać się nawzajem do śmiechu. Do łez. Przekonać nawzajem o prawdach i kłamstwach. By zmieniać swoje poglądy. Wspierać się, kiedy cierpimy. Ranić siebie w głupocie.",shape=box,color=blue];
		j306286366 -> j2971201075;
	j1171907509 [label="I wielkie cierpienie sprawia mi przerywanie ci, zanim je wypowiesz.",shape=box,color=blue];
		j1171907509 -> j3640751489;
	j3180355728 [label="Nie mam pojęcia, co próbujesz powiedzieć.",shape=box,color=red];
		j3180355728 -> j2292968888;
	j290683496 [label="Mon cœur t'appartient également, Marie !",shape=box,color=red];
		j290683496 -> j2643007316;
	j1623301315 [label="To bring each other pleasure when you are in love. To bring each other agonie when you are lost to hatred. This is the gift of humanité - this is what the Indifference is not.",shape=box,color=blue];
		j1623301315 -> j238637106;
	j788659737 [label="Czego uczy nas Obojętność, skądkolwiek by nie pochodziła, jeśli nie tego, by zachować wszystko, co odrzuciła, co zniszczyła ?",shape=box,color=blue];
		j788659737 -> j4125292440;
	j3225612669 [label="Myślałam o tym, ile czasu spędziliśmy razem. I o tym, jak nieznaczący jest to okres w kontekście całego twojego życia.",shape=box,color=blue];
		j3225612669 -> j336908962;
	j650068158 [label="Instead ? Then... I fear you must untangle the threads of your own heart first, Drifter. I cannot do this for you.",shape=box,color=blue];
		j650068158 -> j3699890413;
	j253666527 [label="Tak może być. Nie jestem zazdrosną istotą, ale to jedna sprawa wiedzieć, że ktoś zaskarbił twoje serce, kiedy ich nie znam -",shape=box,color=blue];
		j253666527 -> j2198880415;
	j2017910355 [label="+10 Chemistry",color=orange];
		j2017910355 -> j1384450544;
	j1954118222 [label="Och ! Och, mon cœur !",shape=box,color=blue];
		j1954118222 -> j1871870708;
	j3568860926 [label="Obawiam się, że powinieneś skupić się na drugim wybranku swojego serca. Cokolwiek do mnie czujesz, nie znajdziesz we mnie odwzajemnienia. Wybacz mi.",shape=box,color=blue];
		j3568860926 -> j302571494;
	j3647575710 [label="Och ! Och, mon cœur !",shape=box,color=blue];
		j3647575710 -> j3535281603;
	j1539120137 [label="Oui, rozumiem. Oczywiście, że rozumiem ! Jak mogłabym cię winić za podążanie za głosem serca ?",shape=box,color=blue];
		j1539120137 -> j3846869328;
	j2971201075 [label="To bring each other pleasure when you are in love. To bring each other agonie when you are lost to hatred. This is the gift of humanité - this is what the Indifference is not.",shape=box,color=blue];
