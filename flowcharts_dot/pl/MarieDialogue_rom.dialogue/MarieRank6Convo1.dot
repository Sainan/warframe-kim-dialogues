		j2320372162 -> j1956226242;
	j2618972578 [label="Nie chcę, by Roathe cierpiał, nawet jeśli wciąż go nękam i pouczam. Nie chcę, by żył w bólu, jeśli zdołasz na to zaradzić.",shape=box,color=blue];
