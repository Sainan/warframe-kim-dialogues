		3300 -> 3316 [label="false",color=purple];
	3298 [label="Wiem, że wyznałeś mi swoje uczucia. Ale wiem też, że w twoim sercu zagościła już inna osoba. Chcę tylko powiedzieć, że cieszę się waszym szczęściem !",shape=box,color=blue];
		3298 -> 3308;
	3297 [label="Już raz wspomniałeś mi, że... nie wiem jak ubrać to w słowa. Że żywisz do mnie uczucie. Ale wiem też, że w twoim sercu zagościł już ktoś inny.",shape=box,color=blue];
		3297 -> 3306;
