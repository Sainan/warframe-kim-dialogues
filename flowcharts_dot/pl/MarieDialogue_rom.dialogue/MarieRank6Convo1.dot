		j1471879296 -> j2651412974 [label="false",color=purple];
	j2214156575 [label="I zastanawiałam się, czy właśnie to chce zniszczyć Obojętność ? Czy tym żywi się Obojętność ? Mocą wpłynięcia na innych ?",shape=box,color=blue];
		j2214156575 -> j1298689764;
	j4112644839 [label="Pomogłeś bratu mojej duszy zaznać spokoju. Przekonałeś go, że mamy prawdziwego wroga - i dałeś mu nadzieję.",shape=box,color=blue];
		j4112644839 -> j1757481119;
	j2489271022 [label="Pomogłeś bratu mojej duszy zaznać ukojenia i spokoju, jakiego nie doświadczył wcześniej. Myślę, że twoje towarzystwo znaczyło dla niego więcej, niż jest zdolny wyrazić.",shape=box,color=blue];
		j2489271022 -> j1757481119;
	j2921124322 [label="Choć możemy nigdy nie dowiedzieć się, czym naprawdę jest Obojętność, wiemy, że nie ma to znaczenia. Musimy zmierzyć się z zagrożeniem, jakie stanowi.",shape=box,color=blue];
		j2921124322 -> j1757481119;
	j35674713 [label="Nie sądziłam, że nasz diabeł da się przekonać do pomocy w pojednaniu Monsieur Loida i rodziny le Cardinal. Wiem, że jego motywacje mogą być... wątpliwe, i nadal nie do końca mu ufam. ",shape=box,color=blue];
		j35674713 -> j1827727555;
	j1180879328 [label="Nie sądziłam, że diabeł będzie zdolny zrozumieć swoje błędy. Że mógłby poczuć żal za wszystkie niewinne istnienia, jakie poświęcił. Udowodniłeś mi, że się myliłam.",shape=box,color=blue];
		j1180879328 -> j1808782742;
	j1898084451 [label="Jakiekolwiek okowy zarzuciłeś na diabła, trzymają go one pod kontrolą. Wydaje się bardziej... udomowiony, niż wcześniej. I to twoja zasługa.",shape=box,color=blue];
		j1898084451 -> j1808782742;
	j83115341 [label="Wspomnienia, które pomogliśmy mu odzyskać, pozwoliły mu złagodnieć. Może pamięć żalu za wszystkimi, których stracił, przypomniała mu o tych, których nadal może stracić.",shape=box,color=blue];
		j83115341 -> j1808782742;
	j1816130428 [label="Perhaps it is his fondness for you that tempers him, I do not know. Whatever the reason, I know you are to thank for it.",shape=box,color=blue];
		j1816130428 -> j1808782742;
	j3505747573 [label="W żaden sposób nie życzę wam źle, cieszę się waszym szczęściem, oui ?",shape=box,color=blue];
		j3505747573 -> j11439812;
		j3505747573 -> j2021057156;
	j3135440823 [label="Sprawy się zmieniły, a ja... zostanę z nimi. Przykro mi.",shape=box,color=red];
		j3135440823 -> j2457839260;
	j4149214299 [label="Wiem, że może być trudno w to uwierzyć, a może nawet zaakceptować. Ale ja... kocham cię. I kocham też ich. Równie mocno.",shape=box,color=red];
		j4149214299 -> j3734127592;
