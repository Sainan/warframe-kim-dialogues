		3303 -> 3320;
	3302 [label="Obawiam się, że chcesz wypowiedzieć słowa, których nie zdołasz cofnąć. Że to zmieni wszystko między nami, na zawsze.",shape=box,color=blue];
		3302 -> 3319;
	3301 [label="Mon cœur t'appartient depuis notre première rencontre...",shape=box,color=blue];
		3301 -> 3317;
		3301 -> 3318;
	3321 [label="Dar, by doprowadzać się nawzajem do śmiechu. Do łez. Przekonać nawzajem o prawdach i kłamstwach. By zmieniać swoje poglądy. Wspierać się, kiedy cierpimy. Ranić siebie w głupocie.",shape=box,color=blue];
		3321 -> 3336;
	3329 [label="I jakie ma to znaczenie, kiedy ty możesz pokierować Leona przez najgorszy sztorm, zostać u jego boku w chwilach bólu i agonii ?",shape=box,color=blue];
		3329 -> 3343;
	3330 [label="Ta zmiana jest bez wątpienia twoją zasługą. Roathe został z nami i broni rodziny le Cardinal dzięki tobie.",shape=box,color=blue];
		3330 -> 3331;
	3331 [label="I zdaję sobie sprawę, że diabeł nie jest naszym wrogiem, oui ? To Obojętność. A czego uczy nas Obojętność, jeśli nie tego, by zachować wszystko, co odrzuciła, co zniszczyła ?",shape=box,color=blue];
		3331 -> 3344;
