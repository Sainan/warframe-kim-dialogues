digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo3 begins." [color=orange];
		"MarieRank1Convo3 begins." -> j800807593;
	j800807593 [label="Il y a un crâne volant ! Keksekça ?! W powietrzu lata czaszka i nikt nie zwraca na nią uwagi, jakby to była najnormalniejsza rzecz na świecie. Potrzebuję kogoś, kto przyzna, jak dziwne jest jej istnienie.",shape=box,color=blue];
		j800807593 -> j565028584;
		j800807593 -> j2053454182;
		j800807593 -> j386906797;
	j565028584 [label="To po prostu Nekraloid. No, jeden z nekraloidów. To skomplikowana sprawa.",shape=box,color=red];
		j565028584 -> j4102437731;
	j2053454182 [label="To Nekraloid. Jest Cefalonem, nie zrobi Ci krzywdy.",shape=box,color=red];
		j2053454182 -> j951574082;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j4102437731 [label="Pardon, to imię czy nazwa ?",shape=box,color=blue];
		j4102437731 -> j621599985;
		j4102437731 -> j842575521;
	j951574082 [label="Nie boję się go ! Nie jest straszny.",shape=box,color=blue];
		j951574082 -> j3502554686;
	"Chat ends." [color=orange];
	j621599985 [label="Szczerze... nie jestem pewien.",shape=box,color=red];
		j621599985 -> j2922823853;
	j842575521 [label="Tak.",shape=box,color=red];
		j842575521 -> j307327688;
	j3502554686 [label="W samej rzeczy uważam go za niezwykle czarującego, choć nieco nieustępliwego w rozmowie. Zupełnie jak jego żywa inspiracja. Ale biorąc pod uwagę charakter mojego ulubionego towarzysza podróży, musisz wiedzieć, że nazbyt mi to nie przeszkadza.",shape=box,color=blue];
		j3502554686 -> j3508617081;
	j2922823853 [label="Zatem, kto stworzył te \"Nekraloidy\" ? Kto nadał im tę nazwę, i chyba jednocześnie funkcję ?",shape=box,color=blue];
		j2922823853 -> j3999991491;
		j2922823853 -> j1498293528;
	j307327688 [label="Nie rozumiem... I jaką rolę odgrywa tu Loid ?",shape=box,color=blue];
		j307327688 -> j2922823853;
	j3508617081 [label="Nie, zapewniam Cię, że groteskowość jego oblicza nie jest problemem, o którym teraz mowa.",shape=box,color=blue];
		j3508617081 -> j2709971531;
		j3508617081 -> j1084661013;
	j3999991491 [label="Twój Cardinal Dimanche. Entrati.",shape=box,color=red];
		j3999991491 -> j2919952205;
	j1498293528 [label="Nekraloid jest dziełem Entratiego, ale ogólny pomysł - Cefalony - jest wynalazkiem Orokin.",shape=box,color=red];
		j1498293528 -> j2919952205;
	j2709971531 [label="Dziwi mnie, że czaszka Cię nie odpycha.",shape=box,color=red];
		j2709971531 -> j986236556;
	j1084661013 [label="Przyznaję, wyrwany z kontekstu, musi być dziwny. Ale co konkretnie jest dla Ciebie problemem?",shape=box,color=red];
		j1084661013 -> j1396965592;
	j2919952205 [label="Excusez-moi, czy chcesz zasugerować, że le Cardinal stworzył replikę latającej czaszki-sługi, na podobieństwo swojego towarzysza i nazwał go po nim ?",shape=box,color=blue];
		j2919952205 -> j1089551217;
	j986236556 [label="Mało o mnie wiesz, ale to nie Twoja wina. W swoim życiu wiele czasu spędziłam w towarzystwie umarłych i w miejscach, w których spoczywali. ",shape=box,color=blue];
		j986236556 -> j1312940656;
	j1396965592 [label="Zastanawiam się, dlaczego na jego plecach znajduje się druga twarz, narysowana jak przez dziecko.",shape=box,color=blue];
		j1396965592 -> j1526263149;
	j1089551217 [label="Dlaczego więc nie ma tutaj więcej tych nekraloidów ?",shape=box,color=blue];
		j1089551217 -> j2000039193;
		j1089551217 -> j2742305260;
		j1089551217 -> j1368817260;
	j1312940656 [label="W prawdzie rzeczy spędziłam z większość życia w ich towarzystwie. Są \ndoskonałymi słuchaczami, gdy muszę podzielić się ciężarami dnia.",shape=box,color=blue];
		j1312940656 -> j4063127048;
	j1526263149 [label="Zapytałam Monsieur Nekraloida i Monsieur Loida, ale żaden z nich nie chciał o tym rozmawiać. Podzielili się tylko imieniem. Otak. Wypowiedzieli je z wielkim smutkiem.",shape=box,color=blue];
		j1526263149 -> j141007090;
	j2000039193 [label="Może zdał sobie sprawę, jak straszne jest stworzenie cyfrowej kopii swojego ukochanego.",shape=box,color=red];
		j2000039193 -> j1950455174;
	j2742305260 [label="Może planował stworzyć tylko jednego.",shape=box,color=red];
		j2742305260 -> j595758778;
	j1368817260 [label="Nie wiem. Może nie miał okazji stworzyć kolejnych?",shape=box,color=red];
		j1368817260 -> j2130541224;
	j4063127048 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j4063127048 -> j1008170743;
		j4063127048 -> j2362725169;
	j141007090 [label="I tak oto trafiłam na Ciebie, z nadzieją, że zdołasz mi pomóc.",shape=box,color=blue];
		j141007090 -> j3588865733;
		j141007090 -> j3150434812;
	j1950455174 [label="Ou bien, hołd jego miłości i szacunku. Może uznał, że to przedziwne laboratorium nie mogłoby dalej funkcjonować bez Monsieur Loida.",shape=box,color=blue];
		j1950455174 -> j4264412856;
		j1950455174 -> j530423949;
	j595758778 [label="+5 Chemistry",color=orange];
		j595758778 -> j3360234697;
	j2130541224 [label="Wyobraź sobie, klucz latających bez wysiłku czaszek !",shape=box,color=blue];
		j2130541224 -> j530423949;
		j2130541224 -> j1215360583;
	j1008170743 [label="Lubiłaś spędzać czas na cmentarzach?",shape=box,color=red];
		j1008170743 -> j1963915670;
	j2362725169 [label="Czy kiedykolwiek odpowiedzieli?",shape=box,color=red];
		j2362725169 -> j550519873;
	j3588865733 [label="Chcesz poznać prawdę o Otaku? Albo dlaczego nie możesz z nim rozmawiać?",shape=box,color=red];
		j3588865733 -> j362040749;
	j3150434812 [label="Otak jest skomplikowany...",shape=box,color=red];
		j3150434812 -> j3287217001;
	j4264412856 [label="Powiedziałbym, że to na swój sposób romantyczny gest, ale nie jestem najlepszym wyznacznikiem w tej kwestii.",shape=box,color=red];
		j4264412856 -> j2666066650;
	j530423949 [label="Nie miałbym nic przeciwko temu, żeby nekraloid latał mi po domu.",shape=box,color=red];
		j530423949 -> j246917598;
	j3360234697 [label="To na swój swój sposób piękne i tragiczne, non ? Może uznał, że to przedziwne laboratorium nie mogłoby dalej funkcjonować bez Monsieur Loida.",shape=box,color=blue];
		j3360234697 -> j2331625685;
		j3360234697 -> j4264412856;
	j1215360583 [label="Cieszę się, że jest tylko jeden. Nie wiem, czy świat jest gotów na więcej.",shape=box,color=red];
		j1215360583 -> j3411429923;
	j1963915670 [label="I w mauzoleach i w kryptach, ach tak. Ale przyznaję, że wolałam spędzać czas na zewnątrz, choć stanowiły wyzwanie dla mojego wózka. Podobnie jak schody.",shape=box,color=blue];
		j1963915670 -> j2427967412;
	j550519873 [label="Haha ! Nie, na szczęście nie. Aż do momentu, kiedy makabryczny grymas \"Nekraloida\" mi odpowiedział. Jeśli zdolność rozmowy z umarłymi jest jednym z darów od Świetlistych, nie jest mi to wiadome.",shape=box,color=blue];
		j550519873 -> j4266991277;
	j362040749 [label="Myślę, że chciałabym poznać obie prawdy, ale pozwolę Ci zadecydować, od której zaczniesz. Nie wiem, która z nich jest ważniejsza, après tout.",shape=box,color=blue];
		j362040749 -> j3287217001;
	j3287217001 [label="Check boolean LoidFamilyComplete",color=orange];
		j3287217001 -> j4243049733 [label=true,color=green];
		j3287217001 -> j4243049733 [label=false,color=brown];
		j3287217001 -> j3678040250 [label=false,color=brown];
	j2666066650 [label="Teraz jestem zafascynowana, ale brzmi to jak opowieść na inny dzień. Cela dit...",shape=box,color=blue];
		j2666066650 -> j1396965592;
	j246917598 [label="W takim razie jestem pewna, że odczuwasz potrzebę towarzystwa, organizacji lub obu. Ale to rozmowa na inna okazję.",shape=box,color=blue];
		j246917598 -> j1396965592;
	j2331625685 [label="Mam wrażenie, że przede wszystkim chodziło o to, żeby to miejsce nie obróciło się w ruinę.",shape=box,color=red];
		j2331625685 -> j2614225181;
	j3411429923 [label="W rzeczy samej ! Ja też. Co prowadzi mnie do następnego pytania.",shape=box,color=blue];
		j3411429923 -> j1396965592;
	j2427967412 [label="Boolean MarieSerum1 is now true.",color=orange];
		j2427967412 -> j1004884488;
		j2427967412 -> j3983770168;
	j4266991277 [label="Nie, rozmowa z zaświatami leży raczej w kompetencjach mojego drogiego Leona. Zastanawiam się natomiast, czy Monsieur Nekraloid sam nie jest nawiedzony, sądząc po bazgrołach z tyłu jego głowy.",shape=box,color=blue];
		j4266991277 -> j2355606650;
	j4243049733 [label="Otak był kiedyś Archimedianem, uczonym Orokin. Nie spotkał go najszczęśliwszy los.",shape=box,color=red];
		j4243049733 -> j2254066882;
	j3678040250 [label="No cóż... krótko mówiąc, część rodziny Entrati jest piętro wyżej i... nie zdają sobie sprawy, że my jesteśmy tu na dole.",shape=box,color=red];
		j3678040250 -> j1732997897;
	j2614225181 [label="I całkiem możliwe, że masz rację. Ta latająca kreatura zdaje się pozbawiona ogromu raison d'être i niuansu Monsieur Loida. Cela dit...",shape=box,color=blue];
		j2614225181 -> j1396965592;
	j1004884488 [label="Nie wiedziałem, czy powinienem pytać, czy Twoje nogi zostały zmienione przez serum...",shape=box,color=red];
		j1004884488 -> j1532151531;
	j3983770168 [label="Twojego wózka?",shape=box,color=red];
		j3983770168 -> j4219123403;
	j2355606650 [label="Dlatego też chciałam o tym z Tobą porozmawiać, jeśli nie masz nic przeciw.",shape=box,color=blue];
		j2355606650 -> j1526263149;
	j2254066882 [label="Boolean MarieOtak1 is now true.",color=orange];
		j2254066882 -> j4162259961;
	j1732997897 [label="Boolean MarieFamily1 is now true.",color=orange];
		j1732997897 -> j2536658207;
	j1532151531 [label="+10 Chemistry",color=orange];
		j1532151531 -> j4044320175;
	j4219123403 [label="Nie wiem jak to inaczej nazwać ? Un fauteuil roulant, albo... określenie, którym się brzydzę, un fauteuil pour invalide.",shape=box,color=blue];
		j4219123403 -> j3509218132;
	j4162259961 [label="Par les Luminaires... powiedz mi więcej.",shape=box,color=blue];
		j4162259961 -> j2124965627;
	j2536658207 [label="Par les Luminaires... Mówisz, że wszyscy jesteśmy tu w tajemnicy ?! To dlatego nie możemy opuścić tego miejsca ?! Mais pourquoi ?!",shape=box,color=blue];
		j2536658207 -> j1666866273;
	j4044320175 [label="Och ! Och, biedactwo. Wyobraźmy sobie Ciebie, zastanawiającego się, czy mes pieds zostały mi odebrane przez le Cardinal ! Non, non, non - nic z tych rzeczy.",shape=box,color=blue];
		j4044320175 -> j1103267144;
	j3509218132 [label="Jak te, na których właśnie siedzimy, korzystając z tych uroczych urządzonek do komunikacji. Ale z kołami po bokach, by mogły się przemieszczać. Krzesło na kółkach, jeśli wolisz.",shape=box,color=blue];
		j3509218132 -> j3330527691;
		j3509218132 -> j154069843;
	j2124965627 [label="Wszyscy uważali go za geniusza, za umysł, który zdołał wykorzystać kryształy argonowe.",shape=box,color=red];
		j2124965627 -> j361110055;
	j1666866273 [label="Jego córka, Euleria - znana jako Matka, i jej rodzina, przez cały ten czas zajmowali się Deimosem.",shape=box,color=red];
		j1666866273 -> j3945834703;
	j1103267144 [label="Sol uznała za stosowne, by w moim życiu towarzyszyła mi niedogodność w postaci bezużytecznych nóg. Nie mogłam chodzić. ",shape=box,color=blue];
		j1103267144 -> j1283882474;
	j3330527691 [label="Byłaś niepełnosprawna jeszcze przed zostaniem protoframe?",shape=box,color=red];
		j3330527691 -> j3407614121;
	j154069843 [label="Rozumiem, w moich czasach też mamy coś takiego.",shape=box,color=red];
		j154069843 -> j3730948492;
	j361110055 [label="Które pozyskiwał z Pustki - to dzięki nim byliśmy w stanie stworzyć wiele potężnych warframe’ów i broni.",shape=box,color=red];
		j361110055 -> j3906898429;
	j3945834703 [label="Strzegą tego miejsca i serca, które pompuje energię Pustki w Systemie Origin, pozwalając nam... działać, od kiedy Entrati odszedł.",shape=box,color=red];
		j3945834703 -> j3032412102;
	j1283882474 [label="Ale to było po prostu to — niedogodność.",shape=box,color=blue];
		j1283882474 -> j951772614;
	j3407614121 [label="Non. Nie w żadnym stopniu.",shape=box,color=blue];
		j3407614121 -> j3350176257;
	j3730948492 [label="Haha ! Teraz siedzę tu i chichoczę pod nosem ze swojej głupoty. Oczywiście, w Twoich czasach także musiały istnieć takie wózki. Dlaczego miałabym zakładać inaczej.",shape=box,color=blue];
		j3730948492 -> j951772614;
	j3906898429 [label="Jego specjalizacją była krystalografia. A jego prace odbywały się tutaj, w tych laboratoriach.",shape=box,color=red];
		j3906898429 -> j2517409946;
	j3032412102 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3032412102 -> j811362605 [label=true,color=green];
		j3032412102 -> j2362593335 [label=false,color=brown];
	j951772614 [label="Nie brakuje mi jednak tego wysiłku z poruszaniem się na wózku. Ani Leonowi. Teraz mogę latać wolna niczym ptak !",shape=box,color=blue];
		j951772614 -> j343796132;
		j951772614 -> j1221411000;
		j951772614 -> j1643391834;
	j3350176257 [label="Boolean MarieInvalid is now true.",color=orange];
		j3350176257 -> "Chat ends.";
	j2517409946 [label="Z nieznanego mi powodu został przemieniony w Cefalona i otrzymał nekraloidową powłokę.",shape=box,color=red];
		j2517409946 -> j1446405734;
	j811362605 [label="Pogodziła się z jego nieobecnością i nawzajem sobie przebaczyli, ale nie przyszło im to łatwo.",shape=box,color=red];
		j811362605 -> j987725433;
	j2362593335 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j2362593335 -> j811362605 [label=true,color=green];
		j2362593335 -> j3146222639 [label=false,color=brown];
	j343796132 [label="Myślę o niepełnosprawnościach jako o rzeczach, które nas zmieniają. Tak, w pewien sposób stanowią ograniczenie, ale potrafią dać nam też siłę, której nie mają inni.",shape=box,color=red];
		j343796132 -> j3011518700;
	j1221411000 [label="Nigdy nie uważałaś tego za problem?",shape=box,color=red];
		j1221411000 -> j728728763;
	j1643391834 [label="Wiedziałaś, że serum protoframe tak na Ciebie wpłynie?",shape=box,color=red];
		j1643391834 -> j1707231914;
	j1446405734 [label="Nie wszystkie Cefalony powstały za karę. Ale sprawy na Deimosie... nie szły dobrze, a on został poważnie uszkodzony.",shape=box,color=red];
		j1446405734 -> j3039019428;
	j987725433 [label="Wiedząc, że on wciąż gdzieś tam jest, robiąc bałagan, i nie odezwał się do nim ani słowem, ani nawet listem...?",shape=box,color=red];
		j987725433 -> j920714364;
	j3146222639 [label="Nie pogodziła się z jego odejściem i nadal rzucają się sobie do gardeł.",shape=box,color=red];
		j3146222639 -> j2171987862;
	j3011518700 [label="+5 Chemistry",color=orange];
		j3011518700 -> j1552353436;
	j728728763 [label="Nigdy nie widziałam sensu w narzekaniu. Muszę za to przyznać, że często marzyłam o możliwości sięgania po rzeczy na górnych półkach.",shape=box,color=blue];
		j728728763 -> j194309257;
	j1707231914 [label="Oui, le Cardinal powiedział Leonowi i mnie, że przyjęcie sérum nas odmieni. Wiedzieliśmy, co się stanie.",shape=box,color=blue];
		j1707231914 -> j3826312957;
	j3039019428 [label="+5 Chemistry",color=orange];
		j3039019428 -> j760776817;
	j920714364 [label="Nie mogę sobie wyobrazić, jak bolesne musiało to być dla niej. Dla nich wszystkich.",shape=box,color=red];
		j920714364 -> j3785768899;
	j2171987862 [label="Wiedząc, że on wciąż gdzieś tam jest, robiąc bałagan, i nie odezwał się do nim ani słowem, ani nawet listem...?",shape=box,color=red];
		j2171987862 -> j2866331620;
	j1552353436 [label="Boolean MarieSecretPower is now true.",color=orange];
		j1552353436 -> j364330584;
	j194309257 [label="Ce qui est fait est fait. Nie mogłam modlić się do Sol o cud, kiedy inni potrzebowali go znacznie bardziej. Świetliści i tak sowicie mnie obdarzyli.",shape=box,color=blue];
		j194309257 -> j2148741080;
	j3826312957 [label="Ale jak to bywa, ja przyjęłam swoje z radością, a Leon... och, obawiam się, że nie powinnam tego opowiadać.",shape=box,color=blue];
		j3826312957 -> j2883403663;
		j3826312957 -> j458324411;
	j760776817 [label="Pauvre petit...",shape=box,color=blue];
		j760776817 -> j2714911055;
	j3785768899 [label="Rozumiem logikę za decyzjami le Cardinal i chęć ochrony ich przed bólem, który sprawił swoim nieuniknionym odejściem...",shape=box,color=blue];
		j3785768899 -> j3038341678;
	j2866331620 [label="Zrujnowałoby to i tak nikłe szanse na pogodzenie się.",shape=box,color=red];
		j2866331620 -> j3612615138;
	j364330584 [label="Oui ! Rozumiesz. Poznałam świat z innego punktu widzenia. Moje ramiona były silniejsze. Stałam się cierpliwsza. Wiem, co to znaczy cieszyć się chwilą.",shape=box,color=blue];
		j364330584 -> j3190625235;
	j2148741080 [label="Muszę już iść. Dziękuję za to wspaniałe oderwanie od rzeczywistości. ",shape=box,color=blue];
		j2148741080 -> "Chat ends.";
	j2883403663 [label="Nie ma problemu. Nie musisz mi o niczym mówić, jeśli nie masz na to ochoty.",shape=box,color=red];
		j2883403663 -> j1492319309;
	j458324411 [label="Proszę, nie przerywaj. Ciężko jest mi się z nim dogadać.",shape=box,color=red];
		j458324411 -> j3765376789;
	j2714911055 [label="Więc, stał się głównym nekraloidem - jedynym Nekraloidem, który pozostał - i... ma się dobrze? Ciężko to wyjaśnić.",shape=box,color=red];
		j2714911055 -> j2817628433;
		j2714911055 -> j3688906635;
		j2714911055 -> j804607564;
	j3038341678 [label="Uważam jednak to za zbędne okrucieństwo, a ty ? Mogą myśleć, że umarł, albo coś gorszego ! A my, żyjemy tutaj, comme des rats d'égout ?",shape=box,color=blue];
		j3038341678 -> j3091343126;
		j3038341678 -> j333659797;
		j3038341678 -> j1228824723;
	j3612615138 [label="+10 Chemistry",color=orange];
		j3612615138 -> j1869873423;
	j3190625235 [label="Kiedy dotrę do celu, rozkoszuję się chwilą. Nie uciekam zaraz niczym stonoga odsłonięta spod kamienia.",shape=box,color=blue];
		j3190625235 -> j3969032868;
	j1492319309 [label="+5 Chemistry",color=orange];
		j1492319309 -> j2069065504;
	j3765376789 [label="+5 Chemistry",color=orange];
		j3765376789 -> j224095442;
	j2817628433 [label="Właściwie chciałbym, żebyśmy byli w stanie go naprawić. Przywrócić prawdziwego Otaka.",shape=box,color=red];
