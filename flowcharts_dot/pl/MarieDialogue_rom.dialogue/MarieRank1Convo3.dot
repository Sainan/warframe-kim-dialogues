digraph {
	77 [label="MarieRank1Convo3 begins.",color=orange];
		77 -> 78;
	78 [label="Il y a un crâne volant ! Keksekça ?! W powietrzu lata czaszka i nikt nie zwraca na nią uwagi, jakby to była najnormalniejsza rzecz na świecie. Potrzebuję kogoś, kto przyzna, jak dziwne jest jej istnienie.",shape=box,color=blue];
		78 -> 79;
		78 -> 81;
		78 -> 80;
	79 [label="To po prostu Nekraloid. No, jeden z nekraloidów. To skomplikowana sprawa.",shape=box,color=red];
		79 -> 82;
	81 [label="To Nekraloid. Jest Cefalonem, nie zrobi Ci krzywdy.",shape=box,color=red];
		81 -> 84;
	80 [label="[Koniec]",shape=box,color=red];
		80 -> 83;
	82 [label="Pardon, to imię czy nazwa ?",shape=box,color=blue];
		82 -> 85;
		82 -> 86;
	84 [label="Nie boję się go ! Nie jest straszny.",shape=box,color=blue];
		84 -> 87;
	83 [label="Chat ends.",color=orange];
	85 [label="Szczerze... nie jestem pewien.",shape=box,color=red];
		85 -> 88;
	86 [label="Tak.",shape=box,color=red];
		86 -> 89;
	87 [label="W samej rzeczy uważam go za niezwykle czarującego, choć nieco nieustępliwego w rozmowie. Zupełnie jak jego żywa inspiracja. Ale biorąc pod uwagę charakter mojego ulubionego towarzysza podróży, musisz wiedzieć, że nazbyt mi to nie przeszkadza.",shape=box,color=blue];
		87 -> 90;
	88 [label="Zatem, kto stworzył te \"Nekraloidy\" ? Kto nadał im tę nazwę, i chyba jednocześnie funkcję ?",shape=box,color=blue];
		88 -> 91;
		88 -> 92;
	89 [label="Nie rozumiem... I jaką rolę odgrywa tu Loid ?",shape=box,color=blue];
		89 -> 88;
	90 [label="Nie, zapewniam Cię, że groteskowość jego oblicza nie jest problemem, o którym teraz mowa.",shape=box,color=blue];
		90 -> 93;
		90 -> 94;
	91 [label="Twój Cardinal Dimanche. Entrati.",shape=box,color=red];
		91 -> 95;
	92 [label="Nekraloid jest dziełem Entratiego, ale ogólny pomysł - Cefalony - jest wynalazkiem Orokin.",shape=box,color=red];
		92 -> 95;
	93 [label="Dziwi mnie, że czaszka Cię nie odpycha.",shape=box,color=red];
		93 -> 96;
	94 [label="Przyznaję, wyrwany z kontekstu, musi być dziwny. Ale co konkretnie jest dla Ciebie problemem?",shape=box,color=red];
		94 -> 97;
	95 [label="Excusez-moi, czy chcesz zasugerować, że le Cardinal stworzył replikę latającej czaszki-sługi, na podobieństwo swojego towarzysza i nazwał go po nim ?",shape=box,color=blue];
		95 -> 98;
	96 [label="Mało o mnie wiesz, ale to nie Twoja wina. W swoim życiu wiele czasu spędziłam w towarzystwie umarłych i w miejscach, w których spoczywali. ",shape=box,color=blue];
		96 -> 99;
	97 [label="Zastanawiam się, dlaczego na jego plecach znajduje się druga twarz, narysowana jak przez dziecko.",shape=box,color=blue];
		97 -> 100;
	98 [label="Dlaczego więc nie ma tutaj więcej tych nekraloidów ?",shape=box,color=blue];
		98 -> 101;
		98 -> 102;
		98 -> 103;
	99 [label="W prawdzie rzeczy spędziłam z większość życia w ich towarzystwie. Są 
doskonałymi słuchaczami, gdy muszę podzielić się ciężarami dnia.",shape=box,color=blue];
		99 -> 104;
	100 [label="Zapytałam Monsieur Nekraloida i Monsieur Loida, ale żaden z nich nie chciał o tym rozmawiać. Podzielili się tylko imieniem. Otak. Wypowiedzieli je z wielkim smutkiem.",shape=box,color=blue];
		100 -> 105;
	101 [label="Może zdał sobie sprawę, jak straszne jest stworzenie cyfrowej kopii swojego ukochanego.",shape=box,color=red];
		101 -> 106;
	102 [label="Może planował stworzyć tylko jednego.",shape=box,color=red];
		102 -> 107;
	103 [label="Nie wiem. Może nie miał okazji stworzyć kolejnych?",shape=box,color=red];
		103 -> 108;
	104 [label="Update boolean MarieGraveyard1",color=orange];
		104 -> 109;
		104 -> 110;
	105 [label="I tak oto trafiłam na Ciebie, z nadzieją, że zdołasz mi pomóc.",shape=box,color=blue];
		105 -> 111;
		105 -> 112;
	106 [label="Ou bien, hołd jego miłości i szacunku. Może uznał, że to przedziwne laboratorium nie mogłoby dalej funkcjonować bez Monsieur Loida.",shape=box,color=blue];
		106 -> 113;
		106 -> 114;
	107 [label="+5 Chemistry",color=orange];
		107 -> 115;
	108 [label="Wyobraź sobie, klucz latających bez wysiłku czaszek !",shape=box,color=blue];
		108 -> 114;
		108 -> 116;
	109 [label="Lubiłaś spędzać czas na cmentarzach?",shape=box,color=red];
		109 -> 117;
	110 [label="Czy kiedykolwiek odpowiedzieli?",shape=box,color=red];
		110 -> 118;
	111 [label="Chcesz poznać prawdę o Otaku? Albo dlaczego nie możesz z nim rozmawiać?",shape=box,color=red];
		111 -> 119;
	112 [label="Otak jest skomplikowany...",shape=box,color=red];
		112 -> 2918;
	113 [label="Powiedziałbym, że to na swój sposób romantyczny gest, ale nie jestem najlepszym wyznacznikiem w tej kwestii.",shape=box,color=red];
		113 -> 122;
	114 [label="Nie miałbym nic przeciwko temu, żeby nekraloid latał mi po domu.",shape=box,color=red];
		114 -> 123;
	115 [label="To na swój swój sposób piękne i tragiczne, non ? Może uznał, że to przedziwne laboratorium nie mogłoby dalej funkcjonować bez Monsieur Loida.",shape=box,color=blue];
		115 -> 124;
		115 -> 113;
	116 [label="Cieszę się, że jest tylko jeden. Nie wiem, czy świat jest gotów na więcej.",shape=box,color=red];
		116 -> 125;
	117 [label="I w mauzoleach i w kryptach, ach tak. Ale przyznaję, że wolałam spędzać czas na zewnątrz, choć stanowiły wyzwanie dla mojego wózka. Podobnie jak schody.",shape=box,color=blue];
		117 -> 126;
	118 [label="Haha ! Nie, na szczęście nie. Aż do momentu, kiedy makabryczny grymas \"Nekraloida\" mi odpowiedział. Jeśli zdolność rozmowy z umarłymi jest jednym z darów od Świetlistych, nie jest mi to wiadome.",shape=box,color=blue];
		118 -> 127;
	119 [label="Myślę, że chciałabym poznać obie prawdy, ale pozwolę Ci zadecydować, od której zaczniesz. Nie wiem, która z nich jest ważniejsza, après tout.",shape=box,color=blue];
		119 -> 2918;
	2918 [label="Check boolean LoidFamilyComplete",color=orange];
		2918 -> 121 [label=true,color=green];
		2918 -> 121 [label=false,color=brown];
		2918 -> 120 [label=false,color=brown];
	122 [label="Teraz jestem zafascynowana, ale brzmi to jak opowieść na inny dzień. Cela dit...",shape=box,color=blue];
		122 -> 97;
	123 [label="W takim razie jestem pewna, że odczuwasz potrzebę towarzystwa, organizacji lub obu. Ale to rozmowa na inna okazję.",shape=box,color=blue];
		123 -> 97;
	124 [label="Mam wrażenie, że przede wszystkim chodziło o to, żeby to miejsce nie obróciło się w ruinę.",shape=box,color=red];
		124 -> 130;
	125 [label="W rzeczy samej ! Ja też. Co prowadzi mnie do następnego pytania.",shape=box,color=blue];
		125 -> 97;
	126 [label="Update boolean MarieSerum1",color=orange];
		126 -> 131;
		126 -> 132;
	127 [label="Nie, rozmowa z zaświatami leży raczej w kompetencjach mojego drogiego Leona. Zastanawiam się natomiast, czy Monsieur Nekraloid sam nie jest nawiedzony, sądząc po bazgrołach z tyłu jego głowy.",shape=box,color=blue];
		127 -> 133;
	121 [label="Otak był kiedyś Archimedianem, uczonym Orokin. Nie spotkał go najszczęśliwszy los.",shape=box,color=red];
		121 -> 129;
	120 [label="No cóż... krótko mówiąc, część rodziny Entrati jest piętro wyżej i... nie zdają sobie sprawy, że my jesteśmy tu na dole.",shape=box,color=red];
		120 -> 128;
	130 [label="I całkiem możliwe, że masz rację. Ta latająca kreatura zdaje się pozbawiona ogromu raison d'être i niuansu Monsieur Loida. Cela dit...",shape=box,color=blue];
		130 -> 97;
	131 [label="Nie wiedziałem, czy powinienem pytać, czy Twoje nogi zostały zmienione przez serum...",shape=box,color=red];
		131 -> 136;
	132 [label="Twojego wózka?",shape=box,color=red];
		132 -> 137;
	133 [label="Dlatego też chciałam o tym z Tobą porozmawiać, jeśli nie masz nic przeciw.",shape=box,color=blue];
		133 -> 100;
	129 [label="Update boolean MarieOtak1",color=orange];
		129 -> 135;
	128 [label="Update boolean MarieFamily1",color=orange];
		128 -> 134;
	136 [label="+10 Chemistry",color=orange];
		136 -> 140;
	137 [label="Nie wiem jak to inaczej nazwać ? Un fauteuil roulant, albo... określenie, którym się brzydzę, un fauteuil pour invalide.",shape=box,color=blue];
		137 -> 141;
	135 [label="Par les Luminaires... powiedz mi więcej.",shape=box,color=blue];
		135 -> 139;
	134 [label="Par les Luminaires... Mówisz, że wszyscy jesteśmy tu w tajemnicy ?! To dlatego nie możemy opuścić tego miejsca ?! Mais pourquoi ?!",shape=box,color=blue];
		134 -> 138;
	140 [label="Och ! Och, biedactwo. Wyobraźmy sobie Ciebie, zastanawiającego się, czy mes pieds zostały mi odebrane przez le Cardinal ! Non, non, non - nic z tych rzeczy.",shape=box,color=blue];
		140 -> 144;
	141 [label="Jak te, na których właśnie siedzimy, korzystając z tych uroczych urządzonek do komunikacji. Ale z kołami po bokach, by mogły się przemieszczać. Krzesło na kółkach, jeśli wolisz.",shape=box,color=blue];
		141 -> 145;
		141 -> 146;
	139 [label="Wszyscy uważali go za geniusza, za umysł, który zdołał wykorzystać kryształy argonowe.",shape=box,color=red];
		139 -> 143;
	138 [label="Jego córka, Euleria - znana jako Matka, i jej rodzina, przez cały ten czas zajmowali się Deimosem.",shape=box,color=red];
		138 -> 142;
	144 [label="Sol uznała za stosowne, by w moim życiu towarzyszyła mi niedogodność w postaci bezużytecznych nóg. Nie mogłam chodzić. ",shape=box,color=blue];
		144 -> 149;
	145 [label="Byłaś niepełnosprawna jeszcze przed zostaniem protoframe?",shape=box,color=red];
		145 -> 150;
	146 [label="Rozumiem, w moich czasach też mamy coś takiego.",shape=box,color=red];
		146 -> 151;
	143 [label="Które pozyskiwał z Pustki - to dzięki nim byliśmy w stanie stworzyć wiele potężnych warframe’ów i broni.",shape=box,color=red];
		143 -> 148;
	142 [label="Strzegą tego miejsca i serca, które pompuje energię Pustki w Systemie Origin, pozwalając nam... działać, od kiedy Entrati odszedł.",shape=box,color=red];
		142 -> 861;
	149 [label="Ale to było po prostu to — niedogodność.",shape=box,color=blue];
		149 -> 155;
	150 [label="Non. Nie w żadnym stopniu.",shape=box,color=blue];
		150 -> 156;
	151 [label="Haha ! Teraz siedzę tu i chichoczę pod nosem ze swojej głupoty. Oczywiście, w Twoich czasach także musiały istnieć takie wózki. Dlaczego miałabym zakładać inaczej.",shape=box,color=blue];
		151 -> 155;
	148 [label="Jego specjalizacją była krystalografia. A jego prace odbywały się tutaj, w tych laboratoriach.",shape=box,color=red];
		148 -> 154;
	861 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		861 -> 152 [label=true,color=green];
		861 -> 153 [label=false,color=brown];
	155 [label="Nie brakuje mi jednak tego wysiłku z poruszaniem się na wózku. Ani Leonowi. Teraz mogę latać wolna niczym ptak !",shape=box,color=blue];
		155 -> 160;
		155 -> 161;
		155 -> 162;
	156 [label="Update boolean MarieInvalid",color=orange];
		156 -> 163;
	154 [label="Z nieznanego mi powodu został przemieniony w Cefalona i otrzymał nekraloidową powłokę.",shape=box,color=red];
		154 -> 159;
	152 [label="Pogodziła się z jego nieobecnością i nawzajem sobie przebaczyli, ale nie przyszło im to łatwo.",shape=box,color=red];
		152 -> 157;
	153 [label="Nie pogodziła się z jego odejściem i nadal rzucają się sobie do gardeł.",shape=box,color=red];
		153 -> 158;
	160 [label="Myślę o niepełnosprawnościach jako o rzeczach, które nas zmieniają. Tak, w pewien sposób stanowią ograniczenie, ale potrafią dać nam też siłę, której nie mają inni.",shape=box,color=red];
		160 -> 167;
	161 [label="Nigdy nie uważałaś tego za problem?",shape=box,color=red];
		161 -> 168;
	162 [label="Wiedziałaś, że serum protoframe tak na Ciebie wpłynie?",shape=box,color=red];
		162 -> 169;
	163 [label="Chat ends.",color=orange];
	159 [label="Nie wszystkie Cefalony powstały za karę. Ale sprawy na Deimosie... nie szły dobrze, a on został poważnie uszkodzony.",shape=box,color=red];
		159 -> 166;
	157 [label="Wiedząc, że on wciąż gdzieś tam jest, robiąc bałagan, i nie odezwał się do nim ani słowem, ani nawet listem...?",shape=box,color=red];
		157 -> 164;
	158 [label="Wiedząc, że on wciąż gdzieś tam jest, robiąc bałagan, i nie odezwał się do nim ani słowem, ani nawet listem...?",shape=box,color=red];
		158 -> 165;
	167 [label="+5 Chemistry",color=orange];
		167 -> 173;
	168 [label="Nigdy nie widziałam sensu w narzekaniu. Muszę za to przyznać, że często marzyłam o możliwości sięgania po rzeczy na górnych półkach.",shape=box,color=blue];
		168 -> 174;
	169 [label="Oui, le Cardinal powiedział Leonowi i mnie, że przyjęcie sérum nas odmieni. Wiedzieliśmy, co się stanie.",shape=box,color=blue];
		169 -> 175;
	166 [label="+5 Chemistry",color=orange];
		166 -> 172;
	164 [label="Nie mogę sobie wyobrazić, jak bolesne musiało to być dla niej. Dla nich wszystkich.",shape=box,color=red];
		164 -> 170;
	165 [label="Zrujnowałoby to i tak nikłe szanse na pogodzenie się.",shape=box,color=red];
		165 -> 171;
	173 [label="Update boolean MarieSecretPower",color=orange];
		173 -> 179;
	174 [label="Ce qui est fait est fait. Nie mogłam modlić się do Sol o cud, kiedy inni potrzebowali go znacznie bardziej. Świetliści i tak sowicie mnie obdarzyli.",shape=box,color=blue];
		174 -> 180;
	175 [label="Ale jak to bywa, ja przyjęłam swoje z radością, a Leon... och, obawiam się, że nie powinnam tego opowiadać.",shape=box,color=blue];
		175 -> 181;
		175 -> 182;
	172 [label="Pauvre petit...",shape=box,color=blue];
		172 -> 178;
	170 [label="Rozumiem logikę za decyzjami le Cardinal i chęć ochrony ich przed bólem, który sprawił swoim nieuniknionym odejściem...",shape=box,color=blue];
		170 -> 176;
	171 [label="+10 Chemistry",color=orange];
		171 -> 177;
	179 [label="Oui ! Rozumiesz. Poznałam świat z innego punktu widzenia. Moje ramiona były silniejsze. Stałam się cierpliwsza. Wiem, co to znaczy cieszyć się chwilą.",shape=box,color=blue];
		179 -> 190;
	180 [label="Muszę już iść. Dziękuję za to wspaniałe oderwanie od rzeczywistości. ",shape=box,color=blue];
		180 -> 191;
	181 [label="Nie ma problemu. Nie musisz mi o niczym mówić, jeśli nie masz na to ochoty.",shape=box,color=red];
		181 -> 192;
	182 [label="Proszę, nie przerywaj. Ciężko jest mi się z nim dogadać.",shape=box,color=red];
		182 -> 193;
	178 [label="Więc, stał się głównym nekraloidem - jedynym Nekraloidem, który pozostał - i... ma się dobrze? Ciężko to wyjaśnić.",shape=box,color=red];
		178 -> 187;
		178 -> 188;
		178 -> 189;
	176 [label="Uważam jednak to za zbędne okrucieństwo, a ty ? Mogą myśleć, że umarł, albo coś gorszego ! A my, żyjemy tutaj, comme des rats d'égout ?",shape=box,color=blue];
		176 -> 183;
		176 -> 184;
		176 -> 185;
	177 [label="Oui... Rozumiem to. Postarałabym się pogodzić ich rodzinę, jeśli jesteś w stanie, non ? To chyba nasza jedyna nadzieją, by kiedykolwiek się stąd uwolnić. ",shape=box,color=blue];
		177 -> 186;
	190 [label="Kiedy dotrę do celu, rozkoszuję się chwilą. Nie uciekam zaraz niczym stonoga odsłonięta spod kamienia.",shape=box,color=blue];
		190 -> 202;
	191 [label="Chat ends.",color=orange];
	192 [label="+5 Chemistry",color=orange];
		192 -> 203;
	193 [label="+5 Chemistry",color=orange];
		193 -> 204;
	187 [label="Właściwie chciałbym, żebyśmy byli w stanie go naprawić. Przywrócić prawdziwego Otaka.",shape=box,color=red];
		187 -> 199;
	188 [label="Potrafi rozbawić mnie do łez, ale kryje za tym coś tragicznego.",shape=box,color=red];
		188 -> 200;
	189 [label="Niestety, nie można go naprawić i myślę, że wielu działa to na nerwy. ",shape=box,color=red];
		189 -> 201;
	183 [label="Masz rację. Chciałbym, żebyśmy mogli zrobić coś więcej.",shape=box,color=red];
		183 -> 194;
	184 [label="To nie jest moja decyzja.",shape=box,color=red];
		184 -> 195;
	185 [label="Mam przyjaciółkę, która uwielbia szczury. Myślę, że są urocze.",shape=box,color=red];
		185 -> 196;
	186 [label="Żebyśmy nie spędzili tutaj reszty naszego żywota, uwięzieni comme des rats d'égout. ",shape=box,color=blue];
		186 -> 197;
		186 -> 198;
	202 [label="Chciałabym tylko, by mój drogi Leon mógł patrzeć na świat w ten sam sposób, jak Ty. Wszystkie niedogodności to droga do nieoczekiwanej mocy, jak mówiłeś.",shape=box,color=blue];
		202 -> 213;
	203 [label="Doceniam Twoją uprzejmość, Włóczęgo. Pozwolę więc sobie zakończyć ten temat - ",shape=box,color=blue];
		203 -> 214;
	204 [label="Nie jesteś w tym sam, Włóczęgo. Leon jest dla mnie jak rodzina, a mimo to czasem zastanawiam się, czy naprawdę znam go lepiej niż posągi świętych w katedrze.",shape=box,color=blue];
		204 -> 215;
	199 [label="+15 Chemistry",color=orange];
		199 -> 210;
	200 [label="+15 Chemistry",color=orange];
		200 -> 211;
	201 [label="+15 Chemistry",color=orange];
		201 -> 212;
	194 [label="Add 1 to Family",color=orange];
		194 -> 205;
	195 [label="Wiem. To decyzja Monsieur Loida i wszystkich innych, by zdecydowali się ujawnić.",shape=box,color=blue];
		195 -> 206;
	196 [label="+10 Chemistry",color=orange];
		196 -> 207;
	197 [label="Zapomniałem się. Masz rację, muszę wracać do pracy.",shape=box,color=red];
		197 -> 208;
	198 [label="Mam przyjaciółkę, która uwielbia szczury. Myślę, że są urocze. ",shape=box,color=red];
		198 -> 209;
	213 [label="Och, obawiam się, że nie powinnam tego opowiadać.",shape=box,color=blue];
		213 -> 181;
		213 -> 182;
	214 [label="- Leon maluje świat czerwienią, nawet nie daje tego po sobie poznać. Przykro mi, że nadal z Tobą nie rozmawiać. Prosiłam go o to...",shape=box,color=blue];
		214 -> 221;
	215 [label="Check boolean MarieLyonSuffering1",color=orange];
		215 -> 223 [label=true,color=green];
		215 -> 222 [label=false,color=brown];
	210 [label="Wiem, jakie uczucie Cię kieruje. Dziękuję, dałeś mi wiele do przemyślenia.",shape=box,color=blue];
		210 -> 220;
	211 [label="Wiem, jak się czujesz. Dziękuję, dałeś mi wiele do przemyślenia.",shape=box,color=blue];
		211 -> 220;
	212 [label="Tak, znam podobną sytuację. Dziękuję, dałeś mi wiele do przemyślenia.",shape=box,color=blue];
		212 -> 220;
	205 [label="+15 Chemistry",color=orange];
		205 -> 216;
	206 [label="Pragnę zasugerować, że tu na dole zatrzymuje nas nie szlachetność, a poczucie winy.",shape=box,color=blue];
		206 -> 217;
	207 [label="I chciałabym kiedyś ich poznać, ale nie o tym mówię, głupi wilczku.",shape=box,color=blue];
		207 -> 206;
	208 [label="Add 1 to Family",color=orange];
		208 -> 218;
	209 [label="+5 Chemistry",color=orange];
		209 -> 219;
	221 [label="Update boolean MarieLyonSuffering1",color=orange];
		221 -> 227;
	223 [label="Zdołałeś już wyczuć, że Leon chowa w sercu głęboki ból. Ból, który uważa, że musi znosić sam.",shape=box,color=blue];
		223 -> 229;
