	j1276462009 [label="Nie zamierzam mówić o wierze, więc powiem tylko... że choć nasze ciała mogą wydawać się wadliwe z naszego punktu widzenia... musimy pogodzić się z tym, kim jesteśmy, non ? To wszystko, co mamy.",shape=box,color=blue];
