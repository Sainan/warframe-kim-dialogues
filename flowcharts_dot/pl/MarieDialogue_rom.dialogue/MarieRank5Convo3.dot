	j256323775 [label="Po prostu... cieszę się, że mogę to z siebie wyrzucić. Nie potrafię tego ubrać w słowa. Tak rzadko miewam okazje porozmawiać o takich niewidzialnych, cichych schorzeniach, które mnie nękają.",shape=box,color=blue];
