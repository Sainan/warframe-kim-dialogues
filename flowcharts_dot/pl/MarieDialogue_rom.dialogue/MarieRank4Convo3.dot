digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo3 begins." [color=orange];
		"MarieRank4Convo3 begins." -> j4065338166;
		"MarieRank4Convo3 begins." -> j386906797;
	j4065338166 [label="Jak się dzisiaj czujesz, Mario?",shape=box,color=red];
		j4065338166 -> j3689674940;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j3689674940 [label="Dzisiaj nie jest tak wspaniale. Może chciałbyś wrócić do tej rozmowy jutro ? Dzisiaj będzie ze mnie marne towarzystwo.",shape=box,color=blue];
		j3689674940 -> j225942209;
		j3689674940 -> j687003911;
		j3689674940 -> j1088354710;
	"Chat ends." [color=orange];
	j225942209 [label="Mogę wrócić później, jeśli tego chcesz, ale jeśli chcesz porozmawiać, chętnie posłucham.",shape=box,color=red];
		j225942209 -> j3051580822;
	j687003911 [label="Ok, rozumiem.",shape=box,color=red];
		j687003911 -> "Chat ends.";
	j1088354710 [label="Coś się stało?",shape=box,color=red];
		j1088354710 -> j3051580822;
	j3051580822 [label="C'est vraiment gentil, ale to stary problem... nie masz się czym przejmować. Poradzę sobie.",shape=box,color=blue];
		j3051580822 -> j3096270068;
	j3096270068 [label="Boolean MarieChronicPain is now true.",color=orange];
		j3096270068 -> j3120170424;
		j3096270068 -> j796694848;
		j3096270068 -> j909686235;
	j3120170424 [label="Jeśli tego chcesz, ale będę w okolicy, jeśli zechcesz porozmawiać.",shape=box,color=red];
		j3120170424 -> j142224827;
	j796694848 [label="Wiem jak to jest... Zanim wpadłem w \"pętlę\", mocno zraniłem się w Duviri. Rany się zagoiły, ale czasami nadal bolą. Staram się nie dać po sobie poznać.",shape=box,color=red];
		j796694848 -> j1841046853;
	j909686235 [label="Stare problemy bywają równie uciążliwe, co nowe. Mogą przychodzić i odchodzić, ale nadal wymagają uwagi.",shape=box,color=red];
		j909686235 -> j3200956503;
	j142224827 [label="To miłe z twojej strony... niech będzie. Znowu ze mnie mała uparta Maria.",shape=box,color=blue];
		j142224827 -> j1898434210;
	j1841046853 [label="Boolean DrifterChronicPain is now true.",color=orange];
		j1841046853 -> j751603326;
	j3200956503 [label="Oui, tu as raison. Znowu przemówiła mała uparta Maria.",shape=box,color=blue];
		j3200956503 -> j1898434210;
	j1898434210 [label="Trudno to wytłumaczyć, ale się postaram. Mes pieds, oui ? Moje nogi. Sérum mnie odmieniło, pozwoliło mi latać...",shape=box,color=blue];
		j1898434210 -> j1975784579;
	j751603326 [label="Par les Luminaires, przykro mi to słyszeć. Rozumiesz, przez co przechodzę, oui ?",shape=box,color=blue];
		j751603326 -> j4177803932;
	j1975784579 [label="A jednak nadal je czuję, moje nogi, które zdefiniowały moje życie, które prawie wypaczyły całą nadzieję i radość z mojej duszy.",shape=box,color=blue];
		j1975784579 -> j2788402742;
	j4177803932 [label="Zostać zdradzonym przez własne ciało, które zabija własnego ducha. To takie dziwne, nawet teraz. Sérum mnie odmieniło, pozwoliło mi latać...",shape=box,color=blue];
		j4177803932 -> j1975784579;
	j2788402742 [label="Wciąż mnie bolą. Przez cały czas. Przypominają o sobie nawet teraz, w trakcie tej rozmowy. Ból zazwyczaj bywa do zniesienia, ale czasem...",shape=box,color=blue];
		j2788402742 -> j539106772;
	j539106772 [label="Czasem ten ból budzi mnie w środku nocy. Zastanawiam się, Sol, pourquoi ? Dlaczego wciąż muszę przeżywać tę... agonie interminable ?",shape=box,color=blue];
		j539106772 -> j1660615978;
	j1660615978 [label="Jaki jest ku temu cel ? Ale z nadejściem poranka, mogę się tylko uśmiechnąć do siebie, \"cicho, Mario, to błogosławieństwo. Spójrz na wszystko, co masz. Wszystko, co możesz zrobić\".",shape=box,color=blue];
		j1660615978 -> j1205534438;
	j1205534438 [label="W Cathédrale wciąż słyszałam \"Umiesz czytać, umiesz pisać, masz co jeść, masz gdzie spać. Możesz się poruszać samodzielnie. Masz parę oczu do widzenia i język do mówienia. Ręce do pisania i tych, którym na tobie zależy\". A teraz mogę nawet latać ! Mogę ochronić przyszłość przed samą Pustką. Przed l'Indifférence !",shape=box,color=blue];
		j1205534438 -> j2294403840;
	j2294403840 [label="\"Płacz, głupia dziewczyno, ten ból doda ci sił w przyszłości\", powtarzałam do siebie. A kiedy dzień przechodzi w następny, nie jest już tak źle.",shape=box,color=blue];
		j2294403840 -> j830269311;
	j830269311 [label="Check boolean DrifterChronicPain",color=orange];
		j830269311 -> j4221722131 [label=true,color=green];
		j830269311 -> j2469881380 [label=true,color=green];
		j830269311 -> j829615225 [label=false,color=brown];
		j830269311 -> j1384981455 [label=false,color=brown];
	j4221722131 [label="Przynajmniej z czasem zyskujemy odporność na ten ból.",shape=box,color=red];
		j4221722131 -> j3824756866;
	j2469881380 [label="Czasami... budzę się z poczuciem, że nastał dzień, w którym się poddam.",shape=box,color=red];
		j2469881380 -> j3824756866;
	j829615225 [label="Nigdy... nigdy nie przestaje boleć? Tak mi przykro to słyszeć...",shape=box,color=red];
		j829615225 -> j2610156678;
	j1384981455 [label="Nie ma na to leku? Niczego?",shape=box,color=red];
		j1384981455 -> j1476889932;
	j3824756866 [label="Parafianin zapytał mnie kiedyś: \"Cierpisz ? Przez cały czas ?\", na co odpowiedziałam \"Oui, monsieur. Je le suis\". Na jego twarzy malowało się zdumienie z przerażeniem.",shape=box,color=blue];
		j3824756866 -> j2552296403;
	j2610156678 [label="Czasami zastanawiałam się, ile mogłabym osiągnąć, gdybym wciąż nie przeżywała tej agonii, oui ? Gdybym nie była... uwięziona w ciele, które na każdym kroku staje mi na drodze.",shape=box,color=blue];
		j2610156678 -> j744182635;
	j1476889932 [label="Chciałabym, żeby tak było. Mais non, niczego takiego nie ma. Ani w moich czasach, ani obawiam się, że także i w tych.",shape=box,color=blue];
		j1476889932 -> j2906039678;
	j2552296403 [label="\"Jak dajesz radę z tym żyć ?\" było jego następnym pytaniem. Uśmiechnęłam się do niego i zapytałam \"Co innego mogę zrobić, Monsieur... ?\"",shape=box,color=blue];
		j2552296403 -> j2753196877;
		j2552296403 -> j4031851343;
	j744182635 [label="Jaka bym była wściekła ! Jakże zazdrościłabym wszystkim, których ciała nie były im brzemieniem. Ale jaki byłby z tego pożytek à part rendre nos vies plus amères ? Więcej żalu ?",shape=box,color=blue];
		j744182635 -> j1592734065;
	j2906039678 [label="Niektóre schorzenia nie mogą zostać wyleczone ani przez ludzi, ani naukę, ani nawet wiarę.",shape=box,color=blue];
		j2906039678 -> j2610156678;
	j2753196877 [label="Wielokrotnie przeprowadzałem tę samą rozmowę...",shape=box,color=red];
		j2753196877 -> j2610156678;
	j4031851343 [label="Bardzo mi przykro to słyszeć.",shape=box,color=red];
		j4031851343 -> j426427238;
	j1592734065 [label="Aucun. Jestem, jaka jestem i wytrwam.",shape=box,color=blue];
		j1592734065 -> j2980398560;
	j426427238 [label="Non, po prostu przykro mi, że też przeżywasz podobne cierpienia.",shape=box,color=blue];
		j426427238 -> j2610156678;
	j2980398560 [label="Check boolean DrifterChronicPain",color=orange];
		j2980398560 -> j2571612339 [label=true,color=green];
		j2980398560 -> j2535501850 [label=false,color=brown];
	j2571612339 [label="I ty też. Wierzę, że ty też.",shape=box,color=blue];
		j2571612339 -> j2535501850;
	j2535501850 [label="+20 Chemistry",color=orange];
		j2535501850 -> j3952085628;
	j3952085628 [label="Nie potrafię ubrać w słowa, jak wiele znaczy dla mnie ta rozmowa. Dlatego powiem tylko merci, Włóczęgo.",shape=box,color=blue];
		j3952085628 -> j3563974437;
	j3563974437 [label="Et encore merci.",shape=box,color=blue];
		j3563974437 -> "Chat ends.";
}