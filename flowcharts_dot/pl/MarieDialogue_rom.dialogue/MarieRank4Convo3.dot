digraph {
	2239 [label="MarieRank4Convo3 begins.",color=orange];
		2239 -> 2240;
		2239 -> 2241;
	2240 [label="Jak się dzisiaj czujesz, Mario?",shape=box,color=red];
		2240 -> 2242;
	2241 [label="[Koniec]",shape=box,color=red];
		2241 -> 2243;
	2242 [label="Dzisiaj nie jest tak wspaniale. Może chciałbyś wrócić do tej rozmowy jutro ? Dzisiaj będzie ze mnie marne towarzystwo.",shape=box,color=blue];
		2242 -> 2244;
		2242 -> 2245;
		2242 -> 2246;
	2243 [label="Chat ends.",color=orange];
	2244 [label="Mogę wrócić później, jeśli tego chcesz, ale jeśli chcesz porozmawiać, chętnie posłucham.",shape=box,color=red];
		2244 -> 2247;
	2245 [label="Ok, rozumiem.",shape=box,color=red];
		2245 -> 2248;
	2246 [label="Coś się stało?",shape=box,color=red];
		2246 -> 2247;
	2247 [label="C'est vraiment gentil, ale to stary problem... nie masz się czym przejmować. Poradzę sobie.",shape=box,color=blue];
		2247 -> 2249;
	2248 [label="Chat ends.",color=orange];
	2249 [label="Update boolean MarieChronicPain",color=orange];
		2249 -> 2250;
		2249 -> 2251;
		2249 -> 2252;
	2250 [label="Jeśli tego chcesz, ale będę w okolicy, jeśli zechcesz porozmawiać.",shape=box,color=red];
		2250 -> 2253;
	2251 [label="Wiem jak to jest... Zanim wpadłem w \"pętlę\", mocno zraniłem się w Duviri. Rany się zagoiły, ale czasami nadal bolą. Staram się nie dać po sobie poznać.",shape=box,color=red];
		2251 -> 2254;
	2252 [label="Stare problemy bywają równie uciążliwe, co nowe. Mogą przychodzić i odchodzić, ale nadal wymagają uwagi.",shape=box,color=red];
		2252 -> 2255;
	2253 [label="To miłe z twojej strony... niech będzie. Znowu ze mnie mała uparta Maria.",shape=box,color=blue];
		2253 -> 2256;
	2254 [label="Update boolean DrifterChronicPain",color=orange];
		2254 -> 2257;
	2255 [label="Oui, tu as raison. Znowu przemówiła mała uparta Maria.",shape=box,color=blue];
		2255 -> 2256;
	2256 [label="Trudno to wytłumaczyć, ale się postaram. Mes pieds, oui ? Moje nogi. Sérum mnie odmieniło, pozwoliło mi latać...",shape=box,color=blue];
		2256 -> 2258;
	2257 [label="Par les Luminaires, przykro mi to słyszeć. Rozumiesz, przez co przechodzę, oui ?",shape=box,color=blue];
		2257 -> 2259;
	2258 [label="A jednak nadal je czuję, moje nogi, które zdefiniowały moje życie, które prawie wypaczyły całą nadzieję i radość z mojej duszy.",shape=box,color=blue];
		2258 -> 2260;
	2259 [label="Zostać zdradzonym przez własne ciało, które zabija własnego ducha. To takie dziwne, nawet teraz. Sérum mnie odmieniło, pozwoliło mi latać...",shape=box,color=blue];
		2259 -> 2258;
	2260 [label="Wciąż mnie bolą. Przez cały czas. Przypominają o sobie nawet teraz, w trakcie tej rozmowy. Ból zazwyczaj bywa do zniesienia, ale czasem...",shape=box,color=blue];
		2260 -> 2261;
	2261 [label="Czasem ten ból budzi mnie w środku nocy. Zastanawiam się, Sol, pourquoi ? Dlaczego wciąż muszę przeżywać tę... agonie interminable ?",shape=box,color=blue];
		2261 -> 2262;
	2262 [label="Jaki jest ku temu cel ? Ale z nadejściem poranka, mogę się tylko uśmiechnąć do siebie, \"cicho, Mario, to błogosławieństwo. Spójrz na wszystko, co masz. Wszystko, co możesz zrobić\".",shape=box,color=blue];
		2262 -> 2263;
	2263 [label="W Cathédrale wciąż słyszałam \"Umiesz czytać, umiesz pisać, masz co jeść, masz gdzie spać. Możesz się poruszać samodzielnie. Masz parę oczu do widzenia i język do mówienia. Ręce do pisania i tych, którym na tobie zależy\". A teraz mogę nawet latać ! Mogę ochronić przyszłość przed samą Pustką. Przed l'Indifférence !",shape=box,color=blue];
		2263 -> 2264;
	2264 [label="\"Płacz, głupia dziewczyno, ten ból doda ci sił w przyszłości\", powtarzałam do siebie. A kiedy dzień przechodzi w następny, nie jest już tak źle.",shape=box,color=blue];
		2264 -> 2265;
	2265 [label="Check boolean DrifterChronicPain",color=orange];
		2265 -> 2266 [label=true,color=green];
		2265 -> 2269 [label=true,color=green];
		2265 -> 2267 [label=false,color=brown];
		2265 -> 2268 [label=false,color=brown];
	2266 [label="Przynajmniej z czasem zyskujemy odporność na ten ból.",shape=box,color=red];
		2266 -> 2270;
	2269 [label="Czasami... budzę się z poczuciem, że nastał dzień, w którym się poddam.",shape=box,color=red];
		2269 -> 2270;
	2267 [label="Nigdy... nigdy nie przestaje boleć? Tak mi przykro to słyszeć...",shape=box,color=red];
		2267 -> 2271;
	2268 [label="Nie ma na to leku? Niczego?",shape=box,color=red];
		2268 -> 2272;
	2270 [label="Parafianin zapytał mnie kiedyś: \"Cierpisz ? Przez cały czas ?\", na co odpowiedziałam \"Oui, monsieur. Je le suis\". Na jego twarzy malowało się zdumienie z przerażeniem.",shape=box,color=blue];
		2270 -> 2273;
	2271 [label="Czasami zastanawiałam się, ile mogłabym osiągnąć, gdybym wciąż nie przeżywała tej agonii, oui ? Gdybym nie była... uwięziona w ciele, które na każdym kroku staje mi na drodze.",shape=box,color=blue];
		2271 -> 2274;
	2272 [label="Chciałabym, żeby tak było. Mais non, niczego takiego nie ma. Ani w moich czasach, ani obawiam się, że także i w tych.",shape=box,color=blue];
		2272 -> 2275;
	2273 [label="\"Jak dajesz radę z tym żyć ?\" było jego następnym pytaniem. Uśmiechnęłam się do niego i zapytałam \"Co innego mogę zrobić, Monsieur... ?\"",shape=box,color=blue];
		2273 -> 2276;
		2273 -> 2277;
	2274 [label="Jaka bym była wściekła ! Jakże zazdrościłabym wszystkim, których ciała nie były im brzemieniem. Ale jaki byłby z tego pożytek à part rendre nos vies plus amères ? Więcej żalu ?",shape=box,color=blue];
		2274 -> 2278;
	2275 [label="Niektóre schorzenia nie mogą zostać wyleczone ani przez ludzi, ani naukę, ani nawet wiarę.",shape=box,color=blue];
		2275 -> 2271;
	2276 [label="Wielokrotnie przeprowadzałem tę samą rozmowę...",shape=box,color=red];
		2276 -> 2271;
	2277 [label="Bardzo mi przykro to słyszeć.",shape=box,color=red];
		2277 -> 2279;
	2278 [label="Aucun. Jestem, jaka jestem i wytrwam.",shape=box,color=blue];
		2278 -> 2280;
	2279 [label="Non, po prostu przykro mi, że też przeżywasz podobne cierpienia.",shape=box,color=blue];
		2279 -> 2271;
	2280 [label="Check boolean DrifterChronicPain",color=orange];
		2280 -> 2281 [label=true,color=green];
		2280 -> 2282 [label=false,color=brown];
	2281 [label="I ty też. Wierzę, że ty też.",shape=box,color=blue];
		2281 -> 2282;
	2282 [label="+20 Chemistry",color=orange];
		2282 -> 2283;
	2283 [label="Nie potrafię ubrać w słowa, jak wiele znaczy dla mnie ta rozmowa. Dlatego powiem tylko merci, Włóczęgo.",shape=box,color=blue];
		2283 -> 2284;
	2284 [label="Et encore merci.",shape=box,color=blue];
		2284 -> 2285;
	2285 [label="Chat ends.",color=orange];
}