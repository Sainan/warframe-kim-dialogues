	1408 [label="+5 Chemistry",color=orange];
		1408 -> 1411;
	1409 [label="Myślę, że kiedy odnajdziesz odpowiedź na to pytanie, odnajdziesz też swój spokój.",shape=box,color=blue];
		1409 -> 1412;
	1407 [label="Oui ! Wyobraź sobie Leona i mnie, kiedy pojawił się diabeł, okryty maską i płaszczem, z kieszeniami pełnymi skradzionych słodyczy !",shape=box,color=blue];
		1407 -> 1410;
	1411 [label="Żeby podziwiać widoki, rzecz jasna.",shape=box,color=blue];
		1411 -> 1412;
	1412 [label="Ach ! Podano obiad. Pora już na mnie.",shape=box,color=blue];
		1412 -> 1415;
	1410 [label="Mówił nam, że skoro Orokin wkrótce zapanują nad światem, to nie jest to kradzieć ! Et puis on se crie dessus et Leon błagał o ciszę.",shape=box,color=blue];
		1410 -> 1413;
		1410 -> 1414;
	1415 [label="Chat ends.",color=orange];
	1413 [label="Czy Roathe przyniósł dość dla wszystkich?",shape=box,color=red];
