		j3170709942 -> j394900071;
	j3199084833 [label="Non. Wolę być, kim jestem teraz. Zdecydowałam się zaufać le Cardinal i jego sérum.",shape=box,color=blue];
		j3199084833 -> j86114615;
	j674212763 [label="Jeśli zastanowić się nad stanem rzeczy, kiedy piszę te słowa, mogą minąć dni albo lata, od kiedy je napisałam.",shape=box,color=blue];
		j674212763 -> j1539576890;
	j3237423798 [label="Kiedy czuł się przytłoczony i wszystko zdawało się popadać w ruinę, pytałam go, czy potrzebuje companie. Des fois, oui, des fois, non.",shape=box,color=blue];
		j3237423798 -> j1600389434;
