	1414 [label="A ciastka?",shape=box,color=red];
		1414 -> 1417;
	1416 [label="Oui, tak zrobił. Ale nie wiem, czy było to celowe, czy zainspirowane groźbą przemocy ze strony Leona.",shape=box,color=blue];
		1416 -> 1394;
	1417 [label="Nie możemy pozwolić, żeby się zmarnowały, n'est-ce pas ?",shape=box,color=blue];
