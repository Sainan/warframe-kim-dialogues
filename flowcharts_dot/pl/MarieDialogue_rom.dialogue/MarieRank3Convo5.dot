		j1814591598 -> j3168986666;
		j1814591598 -> j386906797;
		j1814591598 -> j2640372279;
	j1013541751 [label="W porządku, a ty?",shape=box,color=red];
		j1013541751 -> j1796647752;
	j2640372279 [label="Bywało lepiej, ale dziękuję za troskę. A co u ciebie?",shape=box,color=red];
		j2640372279 -> j539766687;
	j2456645295 [label="Powinienem... muszę wyznać, że kłamałem. Tak naprawdę nie jestem wyznawcą Sol.",shape=box,color=red];
		j2456645295 -> j2418668535;
	j3168986666 [label="Teraz jest mi lepiej, kiedy z tobą rozmawiam. Ale dzięki tobie wszystkie moje dni są jaśniejsze.",shape=box,color=red];
		j3168986666 -> j1997621004;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j1796647752 [label="Chyba całkiem nieźle. Choć jak o tym myślę, czuję, że nie powinienem.",shape=box,color=blue];
		j1796647752 -> j2207233919;
		j1796647752 -> j768631703;
	j539766687 [label="Mam się dobrze, ale teraz mnie zaciekawiłeś. Qu'y a-t-il ?",shape=box,color=blue];
		j539766687 -> j1313000009;
		j539766687 -> j1864849537;
		j539766687 -> j3355672511;
		j539766687 -> j3165835986;
	j2418668535 [label="Och ! Rozumiem... Pourquoi ?",shape=box,color=blue];
		j2418668535 -> j3169869697;
		j2418668535 -> j4105520310;
		j2418668535 -> j2520483393;
	j1997621004 [label="Wilku ! Kiedyś przez ciebie spadnę z krzesła !",shape=box,color=blue];
		j1997621004 -> j3873745343;
		j1997621004 -> j3236858496;
	"Chat ends." [color=orange];
	j2207233919 [label="Co masz na myśli?",shape=box,color=red];
		j2207233919 -> j933069078;
	j768631703 [label="Więc jechaliśmy kiedyś na jednym wózku.",shape=box,color=red];
		j768631703 -> j3350967594;
	j1313000009 [label="Ciężko to wytłumaczyć...",shape=box,color=red];
		j1313000009 -> j1609439205;
	j1864849537 [label="Za dużo zmartwień. Za mało czasu.",shape=box,color=red];
		j1864849537 -> j3336410611;
	j3355672511 [label="Moja przyjaciółka określiła je \"pająkami\", które co jakiś czas przychodzą i odchodzą.",shape=box,color=red];
		j3355672511 -> j1363423910;
	j3165835986 [label="Czasami... wszystko jest po prostu dobijające. Ale daję sobie radę.",shape=box,color=red];
		j3165835986 -> j402066486;
	j3169869697 [label="Myślałem, że pozwoli mi to poznać cię lepiej...",shape=box,color=red];
		j3169869697 -> j443632447;
	j4105520310 [label="Myślałem, że to będzie śmieszne?",shape=box,color=red];
		j4105520310 -> j966801747;
	j2520483393 [label="Szczerze nie wiem. Działałem pod wpływem impulsu.",shape=box,color=red];
		j2520483393 -> j2215130168;
	j3873745343 [label="Mówię poważnie. Przykro mi, jeśli wprawia cię to w zakłopotanie.",shape=box,color=red];
		j3873745343 -> j1180282791;
	j3236858496 [label="Przepraszam, tylko się droczę.",shape=box,color=red];
		j3236858496 -> j1180282791;
	j933069078 [label="Jestem Sœur de Sol. Nie powinnam... walczyć. Zabijać. Le Murmure nie jest żywe, a przynajmniej tak twierdzi Cavia — ale co poczynić z innymi, których spotkam ?",shape=box,color=blue];
		j933069078 -> j2704499715;
	j3350967594 [label="+5 Chemistry",color=orange];
		j3350967594 -> j120815831;
	j1609439205 [label="Więc nie będę naciskać. Wiem, jak trudne potrafi być ubranie myśli w słowa.",shape=box,color=blue];
		j1609439205 -> j1600389434;
	j3336410611 [label="W Cathédrale żyła z nami taka Siostra. Wciąż się krzątała, krzątała i krzątała. Pewnego razu przyłapałam jej na polerowaniu srebra o trzeciej nad ranem.",shape=box,color=blue];
		j3336410611 -> j3081465038;
	j1363423910 [label="Ach, oui. Rozumiem, o czym mówisz. Niczym chmura, która zasłania słońce.",shape=box,color=blue];
		j1363423910 -> j1106086015;
	j402066486 [label="Niczym kubek zapełniający się wodą kropla po kropli, non ?",shape=box,color=blue];
		j402066486 -> j2399877680;
	j443632447 [label="Nie musiałeś mi opowiadać takich mensonges, żeby mnie poznać.",shape=box,color=blue];
		j443632447 -> j419779334;
	j966801747 [label="Je ne comprends pas votre humour. Może w przyszłości \"humor\" jest inny ?",shape=box,color=blue];
		j966801747 -> j1679487370;
	j2215130168 [label="Nie wiem, co cię pokusiło, żeby opowiadać mi takie mensonges.",shape=box,color=blue];
		j2215130168 -> j295234317;
	j1180282791 [label="Bon, où en étais-je ?",shape=box,color=blue];
		j1180282791 -> j4244769428;
	j2704499715 [label="Walczyć w imię Sol... czy to moje przeznaczenie ? Czy mam zabijać w jego imieniu ? Moi, petite Maria ?",shape=box,color=blue];
		j2704499715 -> j253264865;
		j2704499715 -> j1578131230;
	j120815831 [label="Wiem, że to une métaphore, ale płaczę ze śmiechu ! Nie wiem, czy byśmy się pomieścili na moim wózku !",shape=box,color=blue];
		j120815831 -> j1845012214;
	j1600389434 [label="Nasze dni i umysły mogą popaść w ruinę na wiele sposobów. Potrafią znaleźć sobie ciemne dziury, w których się pogrążają, non ?",shape=box,color=blue];
		j1600389434 -> j3987028626;
	j3081465038 [label="Zapytałam ją, co robi, a ona odpowiedziała, że nie może spać, bo za bardzo się denerwuje.",shape=box,color=blue];
		j3081465038 -> j798348688;
	j1106086015 [label="Mamy na to określenie, ennui. Znużenie i niezadowolenie, przez które wszystko wydaje się... bezcelowe.",shape=box,color=blue];
		j1106086015 -> j3850365366;
	j2399877680 [label="Kiedy się napełnia i przelewa, wydaje się une grande catastrophe. ",shape=box,color=blue];
		j2399877680 -> j855879766;
	j419779334 [label="Dusza to więcej, niż wiara, którą obrała. Jestem une Sœur de Sol, ale mam nadzieję, że widzisz we mnie więcej niż tylko to, non ?",shape=box,color=blue];
		j419779334 -> j1591033894;
	j1679487370 [label="Mnie to nie bawi.",shape=box,color=blue];
		j1679487370 -> j1097657522;
	j295234317 [label="Mogę mieć tylko nadzieję, że nie miałeś złych intencji, że to nie był okrutny żart moim kosztem. Pójdę więc za przykładem Sol -",shape=box,color=blue];
		j295234317 -> j4066702196;
	j4244769428 [label="Check boolean DrifterFaithSol",color=orange];
		j4244769428 -> j1193131426 [label=true,color=green];
		j4244769428 -> j3272079395 [label=false,color=brown];
	j253264865 [label="Nie byłem szkolony na żołnierza. Nie tak jak dzieciak. Ty też nie.",shape=box,color=red];
		j253264865 -> j2579072375;
	j1578131230 [label="Nie zawsze byłem taki. Takim wojownikiem. Musiałem się tego nauczyć na własnej skórze.",shape=box,color=red];
		j1578131230 -> j4004270516;
	j1845012214 [label="Nie opuszcza mnie myśl o tej sytuacji. Zaraz się uduszę, więc powiedz mi — do czego się odnosisz ?",shape=box,color=blue];
		j1845012214 -> j253264865;
		j1845012214 -> j1578131230;
	j3987028626 [label="Możemy tylko być dla siebie cierpliwi i wyrozumiali, kiedy do tego dojdzie.",shape=box,color=blue];
		j3987028626 -> j250061595;
	j798348688 [label="Za każdym razem, kiedy napotykałam ją w takim stanie, pytałam, czy chce companie. Czasami się zgadzała, czasami nie.",shape=box,color=blue];
		j798348688 -> j1600389434;
	j3850365366 [label="A może pragniesz się schować i płakać. Ciężko mi powiedzieć, czy nie bliżej temu do rozpaczy.",shape=box,color=blue];
		j3850365366 -> j2836009465;
	j855879766 [label="Możesz posprzątać, postawić kubek... i wszystko zaczyna się na nowo, oui ?",shape=box,color=blue];
		j855879766 -> j4005912623;
	j1591033894 [label="Tematów, o których możemy porozmawiać, jest tyle ile gwiazd na niebie !",shape=box,color=blue];
		j1591033894 -> j2143520730;
		j1591033894 -> j2335782785;
