	j2579072375 [label="Oui ! Twoja minuscule copie i jej triste historia... aż chcę mi się płakać na tę myśl. Zostać zmienionym w narzędzie wojny przez tych, których miało się za rodzinę ?",shape=box,color=blue];
		j2579072375 -> j3199084833;
	j4004270516 [label="Oui ! Słyszałam, że kosztowało cię wiele cierpienia, by nauczyć się tak walczyć. Wyobrażam sobie, że śmierć to okrutny nauczyciel...",shape=box,color=blue];
		j4004270516 -> j3199084833;
	j250061595 [label="Nie wiem, czy te słowa mają dla ciebie znaczenie, czy będą zaledwie świecącymi punktami buczącej machinerie.",shape=box,color=blue];
		j250061595 -> j674212763;
	j2836009465 [label="Nie znam twojej przyjaciółki, ale myślę, że ma ogromne szczęście móc na tobie polegać.",shape=box,color=blue];
		j2836009465 -> j1600389434;
	j4005912623 [label="W kaplicy był ksiądz o temperamencie zbliżonym do twojego. Był zdolny znieść każdą niedogodność — aż pewnego dnia już nie mógł.",shape=box,color=blue];
		j4005912623 -> j3237423798;
	j2143520730 [label="Przepraszam, głupio postąpiłem.",shape=box,color=red];
		j2143520730 -> j3589721737;
	j2335782785 [label="Wybaczysz mi?",shape=box,color=red];
