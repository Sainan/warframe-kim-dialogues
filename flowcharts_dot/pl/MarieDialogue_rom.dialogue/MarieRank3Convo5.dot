		j2649693227 -> j1444202203;
	j2551874407 [label="A jeśli nie ? Mam rozwiązanie, które zawsze pomaga !",shape=box,color=blue];
		j2551874407 -> j2741842295;
	j2263999215 [label="Haha ! Oui, tak jest. Très bien, cieszę się, że mogłam cię wysłuchać.",shape=box,color=blue];
		j2263999215 -> j2586083866;
	j1106836285 [label="Oui, ale wtedy nie zostałbyś rozpustnym wilkiem, którego znamy i kochamy, prawda ? Myślę, że Sol wskazała ci właściwą drogę.",shape=box,color=blue];
		j1106836285 -> j1769203355;
	j1444202203 [label="Oui, całkowicie się zgadzam. Nikt nie urodził się, żeby walczyć. Może oprócz tych \"Grin-ire\", o których słyszałam, ale nawet wtedy...",shape=box,color=blue];
		j1444202203 -> j56423108;
	j2741842295 [label="Des pâtisseries !",shape=box,color=blue];
		j2741842295 -> j4132951681;
	j2586083866 [label="Ach ! Podano obiad. Pora już na mnie. Do później, wilku. Cieszę się, że znów mieliśmy okazję pomówić.",shape=box,color=blue];
		j2586083866 -> "Chat ends.";
	j1769203355 [label="Ale rozumiem, o co ci chodzi. Dostrzegasz struktury i wskazówki, które mogłeś otrzymać i tęsknisz za szansami, których nie otrzymałeś. Zwłaszcza kiedy tak wiele czasu spędziłeś zdany na siebie.",shape=box,color=blue];
		j1769203355 -> j2945218545;
	j56423108 [label="Zastanawiam się, czy zdecydowaliby się podążać inną drogą, gdyby mieli szansę wybrać ?",shape=box,color=blue];
		j56423108 -> j3607814668;
		j56423108 -> j3322617952;
