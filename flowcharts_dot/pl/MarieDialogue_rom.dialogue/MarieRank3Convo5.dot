		j3128719928 -> j3190826102;
		j3128719928 -> j703564653;
		j3128719928 -> j3995830837;
	j517702501 [label="Czasami myślę o tym, ile musiałem zrozumieć sam i zazdroszczę dzieciakowi całego treningu.",shape=box,color=red];
		j517702501 -> j725890888;
	j1722341627 [label="Nie ma dobrej drogi, która prowadzi na wojnę. Urodzić się, zostać wychowanym, czy samemu zdecydować. Ostatecznie liczy się to, kim jesteś i co z tym zrobisz.",shape=box,color=red];
		j1722341627 -> j3905750457;
	j1192774602 [label="Jakby twoi bliscy wydawali się odlegli, albo wirtualni, albo tylko cierpliwie siedzieli, czekając, aż się przywitasz.",shape=box,color=blue];
		j1192774602 -> j378366160;
	j988291926 [label="Oui, i gdybyś był jak Leon, powiedziałabym, że pokutą jest dziesięć batów ! Ale nie jesteś. Więc spotka Cię tylko przebaczenie.",shape=box,color=blue];
		j988291926 -> j394900071;
