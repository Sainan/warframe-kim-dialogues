		1368 -> 1373 [label=false,color=brown];
		1368 -> 1375 [label=false,color=brown];
	1371 [label="Chat ends.",color=orange];
	1376 [label="Ale teraz dostrzegam, że minuscule copie cierpi w samotności... a wilk doczekał się własnej watahy.",shape=box,color=blue];
		1376 -> 1383;
	1377 [label="Trudno jest wyrwać się ze schematu, kiedy całe życie jesteś przekonywany, że to twój jedyny cel.",shape=box,color=red];
		1377 -> 1384;
	1378 [label="Myślę, że tak. Spotkałem kilku, którzy udowodnili mi, że Grineer to coś więcej niż tylko wojna i śmierć.",shape=box,color=red];
		1378 -> 1385;
	1372 [label="Muszę się tylko upewnić, że wystarczy ich dla wszystkich.",shape=box,color=red];
		1372 -> 1379;
	1373 [label="Dziękuję. Mario.",shape=box,color=red];
		1373 -> 1380;
	1374 [label="Nie mogę tylko dopuścić do nich Roathe'a.",shape=box,color=red];
		1374 -> 1381;
	1375 [label="Ciastka to zawsze dobry wybór.",shape=box,color=red];
		1375 -> 1382;
	1383 [label="Może role się odwróciły, non ?",shape=box,color=blue];
		1383 -> 1390;
		1383 -> 1391;
	1384 [label="Add -1 to Thermostat",color=orange];
		1384 -> 1392;
	1385 [label="Add 1 to Thermostat",color=orange];
		1385 -> 1393;
	1379 [label="+20 Chemistry",color=orange];
		1379 -> 1386;
	1380 [label="+20 Chemistry",color=orange];
		1380 -> 1387;
	1381 [label="+20 Chemistry",color=orange];
		1381 -> 1388;
	1382 [label="Tylko nie dopuszczaj do nich diabła. Sinon, il va les voler ! Ma zwyczaj kraść słodycze, kiedy nie jest syty !",shape=box,color=blue];
		1382 -> 1389;
	1390 [label="Nadal dochodzi do siebie. Cała droga przed nim.",shape=box,color=red];
		1390 -> 1398;
	1391 [label="Chciałbym móc mu bardziej pomóc. ",shape=box,color=red];
		1391 -> 1398;
	1392 [label="Oui, masz rację. Tak wielu szuka wiary w nadziei, że odnajdą właśnie to — cel w życiu.",shape=box,color=blue];
		1392 -> 1399;
	1393 [label="(Więc tak to się zapisuje, merci !) Bardzo cieszy mnie, że nawet rasa uczona, że to ich jedyny cel, jest w stanie znaleźć inny.",shape=box,color=blue];
		1393 -> 1400;
	1386 [label="O to chodzi ! Nawet sam diabeł zasługuje na odrobinę słodyczy od czasu do czasu.",shape=box,color=blue];
		1386 -> 1394;
	1387 [label="Je vous en prie. Mam nadzieję, że choć odrobinę Ci pomogłam, tak jak ty pomogłeś mnie.",shape=box,color=blue];
		1387 -> 1402;
	1388 [label="Ach, narzekam, ale nawet sam diabeł zasługuje na odrobinę słodyczy od czasu do czasu, oui ?",shape=box,color=blue];
		1388 -> 1394;
	1389 [label="Update boolean MarieRoathePastry1",color=orange];
		1389 -> 1396;
		1389 -> 1397;
	1398 [label="Myślę, że robisz wszystko, co możesz. Zwróci się do ciebie, kiedy będziesz potrzebny.",shape=box,color=blue];
		1398 -> 1399;
	1399 [label="Wielu wkracza na ścieżkę, w nadziei, że poprowadzi ich do prawdy.",shape=box,color=blue];
		1399 -> 1405;
		1399 -> 1406;
	1400 [label="Update boolean MarieGrineer",color=orange];
		1400 -> 1399;
	1394 [label="Na mnie już pora, podano do stołu a ja zgłodniałam. Mam nadzieję, że choć odrobinę poprawiłam ci humor, tak jak ty wsparłeś mnie.",shape=box,color=blue];
		1394 -> 1401;
	1402 [label="Chat ends.",color=orange];
	1396 [label="Przyniosę dosyć dla wszystkich.",shape=box,color=red];
		1396 -> 1403;
	1397 [label="To prześmieszna myśl.",shape=box,color=red];
		1397 -> 1404;
	1405 [label="A dlaczego ty podążasz swoją ścieżką?",shape=box,color=red];
		1405 -> 1408;
