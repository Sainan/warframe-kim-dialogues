		j394900071 -> j3128719928;
	j86114615 [label="Ale znasz smutek, który mnie dręczy. Ta niepewność. Nie narodzić się, albo nie dorosnąć do życia w wojnie.",shape=box,color=blue];
		j86114615 -> j517702501;
		j86114615 -> j1722341627;
	j1539576890 [label="Chcę przez to powiedzieć, że rozumiem, że możesz nie brać moich słów na poważnie, kiedy mówię Ci, że nie jesteś sam.",shape=box,color=blue];
		j1539576890 -> j1192774602;
