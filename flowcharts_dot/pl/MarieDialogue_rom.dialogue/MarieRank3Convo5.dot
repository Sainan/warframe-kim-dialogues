		1277 -> 1278 [label=false,color=brown];
	1279 [label="Ma famille à Sol ! Mój bracie w Sol, jak się dzisiaj masz ?",shape=box,color=blue];
		1279 -> 1281;
		1279 -> 1280;
		1279 -> 1283;
		1279 -> 3947;
		1279 -> 1282;
	1278 [label="Bonjour ! Jak się dzisiaj masz ?",shape=box,color=blue];
		1278 -> 1281;
		1278 -> 1280;
		1278 -> 1283;
		1278 -> 3947;
		1278 -> 1282;
	1281 [label="W porządku, a ty?",shape=box,color=red];
		1281 -> 1285;
	1280 [label="Bywało lepiej, ale dziękuję za troskę. A co u ciebie?",shape=box,color=red];
		1280 -> 1284;
	1283 [label="Powinienem... muszę wyznać, że kłamałem. Tak naprawdę nie jestem wyznawcą Sol.",shape=box,color=red];
		1283 -> 1287;
	3947 [label="Teraz jest mi lepiej, kiedy z tobą rozmawiam. Ale dzięki tobie wszystkie moje dni są jaśniejsze.",shape=box,color=red];
		3947 -> 3948;
	1282 [label="[Koniec]",shape=box,color=red];
		1282 -> 1286;
	1285 [label="Chyba całkiem nieźle. Choć jak o tym myślę, czuję, że nie powinienem.",shape=box,color=blue];
		1285 -> 1292;
		1285 -> 1293;
	1284 [label="Mam się dobrze, ale teraz mnie zaciekawiłeś. Qu'y a-t-il ?",shape=box,color=blue];
		1284 -> 1288;
		1284 -> 1289;
		1284 -> 1290;
		1284 -> 1291;
	1287 [label="Och ! Rozumiem... Pourquoi ?",shape=box,color=blue];
		1287 -> 1294;
		1287 -> 1295;
		1287 -> 1296;
	3948 [label="Wilku ! Kiedyś przez ciebie spadnę z krzesła !",shape=box,color=blue];
		3948 -> 3949;
		3948 -> 3950;
	1286 [label="Chat ends.",color=orange];
	1292 [label="Co masz na myśli?",shape=box,color=red];
		1292 -> 1301;
	1293 [label="Więc jechaliśmy kiedyś na jednym wózku.",shape=box,color=red];
		1293 -> 1302;
	1288 [label="Ciężko to wytłumaczyć...",shape=box,color=red];
		1288 -> 1297;
	1289 [label="Za dużo zmartwień. Za mało czasu.",shape=box,color=red];
		1289 -> 1298;
	1290 [label="Moja przyjaciółka określiła je \"pająkami\", które co jakiś czas przychodzą i odchodzą.",shape=box,color=red];
		1290 -> 1299;
	1291 [label="Czasami... wszystko jest po prostu dobijające. Ale daję sobie radę.",shape=box,color=red];
		1291 -> 1300;
	1294 [label="Myślałem, że pozwoli mi to poznać cię lepiej...",shape=box,color=red];
		1294 -> 1303;
	1295 [label="Myślałem, że to będzie śmieszne?",shape=box,color=red];
		1295 -> 1304;
	1296 [label="Szczerze nie wiem. Działałem pod wpływem impulsu.",shape=box,color=red];
		1296 -> 1305;
	3949 [label="Mówię poważnie. Przykro mi, jeśli wprawia cię to w zakłopotanie.",shape=box,color=red];
		3949 -> 3951;
	3950 [label="Przepraszam, tylko się droczę.",shape=box,color=red];
		3950 -> 3951;
	1301 [label="Jestem Sœur de Sol. Nie powinnam... walczyć. Zabijać. Le Murmure nie jest żywe, a przynajmniej tak twierdzi Cavia — ale co poczynić z innymi, których spotkam ?",shape=box,color=blue];
		1301 -> 1310;
	1302 [label="+5 Chemistry",color=orange];
		1302 -> 1311;
	1297 [label="Więc nie będę naciskać. Wiem, jak trudne potrafi być ubranie myśli w słowa.",shape=box,color=blue];
		1297 -> 1306;
	1298 [label="W Cathédrale żyła z nami taka Siostra. Wciąż się krzątała, krzątała i krzątała. Pewnego razu przyłapałam jej na polerowaniu srebra o trzeciej nad ranem.",shape=box,color=blue];
		1298 -> 1307;
	1299 [label="Ach, oui. Rozumiem, o czym mówisz. Niczym chmura, która zasłania słońce.",shape=box,color=blue];
		1299 -> 1308;
	1300 [label="Niczym kubek zapełniający się wodą kropla po kropli, non ?",shape=box,color=blue];
		1300 -> 1309;
	1303 [label="Nie musiałeś mi opowiadać takich mensonges, żeby mnie poznać.",shape=box,color=blue];
		1303 -> 1312;
	1304 [label="Je ne comprends pas votre humour. Może w przyszłości \"humor\" jest inny ?",shape=box,color=blue];
		1304 -> 1313;
	1305 [label="Nie wiem, co cię pokusiło, żeby opowiadać mi takie mensonges.",shape=box,color=blue];
		1305 -> 1314;
	3951 [label="Bon, où en étais-je ?",shape=box,color=blue];
		3951 -> 1278;
	1310 [label="Walczyć w imię Sol... czy to moje przeznaczenie ? Czy mam zabijać w jego imieniu ? Moi, petite Maria ?",shape=box,color=blue];
		1310 -> 1319;
		1310 -> 1320;
	1311 [label="Wiem, że to une métaphore, ale płaczę ze śmiechu ! Nie wiem, czy byśmy się pomieścili na moim wózku !",shape=box,color=blue];
		1311 -> 1321;
	1306 [label="Nasze dni i umysły mogą popaść w ruinę na wiele sposobów. Potrafią znaleźć sobie ciemne dziury, w których się pogrążają, non ?",shape=box,color=blue];
		1306 -> 1315;
	1307 [label="Zapytałam ją, co robi, a ona odpowiedziała, że nie może spać, bo za bardzo się denerwuje.",shape=box,color=blue];
		1307 -> 1316;
	1308 [label="Mamy na to określenie, ennui. Znużenie i niezadowolenie, przez które wszystko wydaje się... bezcelowe.",shape=box,color=blue];
		1308 -> 1317;
	1309 [label="Kiedy się napełnia i przelewa, wydaje się une grande catastrophe. ",shape=box,color=blue];
		1309 -> 1318;
	1312 [label="Dusza to więcej, niż wiara, którą obrała. Jestem une Sœur de Sol, ale mam nadzieję, że widzisz we mnie więcej niż tylko to, non ?",shape=box,color=blue];
		1312 -> 1322;
	1313 [label="Mnie to nie bawi.",shape=box,color=blue];
		1313 -> 1323;
	1314 [label="Mogę mieć tylko nadzieję, że nie miałeś złych intencji, że to nie był okrutny żart moim kosztem. Pójdę więc za przykładem Sol -",shape=box,color=blue];
		1314 -> 1324;
	1319 [label="Nie byłem szkolony na żołnierza. Nie tak jak dzieciak. Ty też nie.",shape=box,color=red];
		1319 -> 1328;
	1320 [label="Nie zawsze byłem taki. Takim wojownikiem. Musiałem się tego nauczyć na własnej skórze.",shape=box,color=red];
		1320 -> 1329;
	1321 [label="Nie opuszcza mnie myśl o tej sytuacji. Zaraz się uduszę, więc powiedz mi — do czego się odnosisz ?",shape=box,color=blue];
		1321 -> 1319;
		1321 -> 1320;
	1315 [label="Możemy tylko być dla siebie cierpliwi i wyrozumiali, kiedy do tego dojdzie.",shape=box,color=blue];
		1315 -> 1325;
	1316 [label="Za każdym razem, kiedy napotykałam ją w takim stanie, pytałam, czy chce companie. Czasami się zgadzała, czasami nie.",shape=box,color=blue];
		1316 -> 1306;
	1317 [label="A może pragniesz się schować i płakać. Ciężko mi powiedzieć, czy nie bliżej temu do rozpaczy.",shape=box,color=blue];
		1317 -> 1335;
	1318 [label="Możesz posprzątać, postawić kubek... i wszystko zaczyna się na nowo, oui ?",shape=box,color=blue];
		1318 -> 1327;
	1322 [label="Tematów, o których możemy porozmawiać, jest tyle ile gwiazd na niebie !",shape=box,color=blue];
		1322 -> 1330;
		1322 -> 1331;
	1323 [label="Update boolean DrifterFaithSol",color=orange];
		1323 -> 1332;
	1324 [label="- którego wiarę wyznaję, niezależnie od tego, czy ty też, i wybaczam Ci. Gdybyś był jak Leon, powiedziałabym, że pokutą jest dziesięć batów.",shape=box,color=blue];
		1324 -> 1333;
	1328 [label="Oui ! Twoja minuscule copie i jej triste historia... aż chcę mi się płakać na tę myśl. Zostać zmienionym w narzędzie wojny przez tych, których miało się za rodzinę ?",shape=box,color=blue];
		1328 -> 1337;
	1329 [label="Oui ! Słyszałam, że kosztowało cię wiele cierpienia, by nauczyć się tak walczyć. Wyobrażam sobie, że śmierć to okrutny nauczyciel...",shape=box,color=blue];
		1329 -> 1337;
	1325 [label="Nie wiem, czy te słowa mają dla ciebie znaczenie, czy będą zaledwie świecącymi punktami buczącej machinerie.",shape=box,color=blue];
		1325 -> 1334;
	1335 [label="Nie znam twojej przyjaciółki, ale myślę, że ma ogromne szczęście móc na tobie polegać.",shape=box,color=blue];
		1335 -> 1306;
	1327 [label="W kaplicy był ksiądz o temperamencie zbliżonym do twojego. Był zdolny znieść każdą niedogodność — aż pewnego dnia już nie mógł.",shape=box,color=blue];
		1327 -> 1336;
	1330 [label="Przepraszam, głupio postąpiłem.",shape=box,color=red];
		1330 -> 1338;
	1331 [label="Wybaczysz mi?",shape=box,color=red];
		1331 -> 1339;
	1332 [label="Update boolean MarieNoDate",color=orange];
		1332 -> 1340;
	1333 [label="Update boolean DrifterFaithSol",color=orange];
		1333 -> 1341;
	1337 [label="Non. Wolę być, kim jestem teraz. Zdecydowałam się zaufać le Cardinal i jego sérum.",shape=box,color=blue];
		1337 -> 1343;
	1334 [label="Jeśli zastanowić się nad stanem rzeczy, kiedy piszę te słowa, mogą minąć dni albo lata, od kiedy je napisałam.",shape=box,color=blue];
		1334 -> 1342;
	1336 [label="Kiedy czuł się przytłoczony i wszystko zdawało się popadać w ruinę, pytałam go, czy potrzebuje companie. Des fois, oui, des fois, non.",shape=box,color=blue];
		1336 -> 1306;
	1338 [label="Update boolean DrifterFaithSol",color=orange];
		1338 -> 1344;
	1339 [label="Update boolean DrifterFaithSol",color=orange];
		1339 -> 1345;
	1340 [label="Chat ends.",color=orange];
	1341 [label="Wszyscy po omacku staramy się znaleźć swoją ścieżkę w tym świecie.",shape=box,color=blue];
		1341 -> 1346;
	1343 [label="Ale znasz smutek, który mnie dręczy. Ta niepewność. Nie narodzić się, albo nie dorosnąć do życia w wojnie.",shape=box,color=blue];
		1343 -> 1348;
		1343 -> 1349;
	1342 [label="Chcę przez to powiedzieć, że rozumiem, że możesz nie brać moich słów na poważnie, kiedy mówię Ci, że nie jesteś sam.",shape=box,color=blue];
		1342 -> 1347;
	1344 [label="+10 Chemistry",color=orange];
		1344 -> 1350;
	1345 [label="+5 Chemistry",color=orange];
		1345 -> 1351;
	1346 [label="Ale zapytałam, jak się czujesz. To pytanie nadal oczekuje na odpowiedź, petit mensonge ou non.",shape=box,color=blue];
		1346 -> 1352;
		1346 -> 1353;
		1346 -> 1354;
	1348 [label="Czasami myślę o tym, ile musiałem zrozumieć sam i zazdroszczę dzieciakowi całego treningu.",shape=box,color=red];
		1348 -> 1356;
	1349 [label="Nie ma dobrej drogi, która prowadzi na wojnę. Urodzić się, zostać wychowanym, czy samemu zdecydować. Ostatecznie liczy się to, kim jesteś i co z tym zrobisz.",shape=box,color=red];
		1349 -> 1357;
	1347 [label="Jakby twoi bliscy wydawali się odlegli, albo wirtualni, albo tylko cierpliwie siedzieli, czekając, aż się przywitasz.",shape=box,color=blue];
		1347 -> 1355;
	1350 [label="Oui, i gdybyś był jak Leon, powiedziałabym, że pokutą jest dziesięć batów ! Ale nie jesteś. Więc spotka Cię tylko przebaczenie.",shape=box,color=blue];
		1350 -> 1341;
	1351 [label="Oui, wybaczam Ci. Gdybyś był jak Leon, powiedziałabym, że pokutą jest dziesięć batów.",shape=box,color=blue];
		1351 -> 1341;
	1352 [label="Szczerze... bywało lepiej.",shape=box,color=red];
		1352 -> 1358;
	1353 [label="Jest dobrze, naprawdę. A co u ciebie?",shape=box,color=red];
		1353 -> 1285;
	1354 [label="Teraz czuję się lepiej. Dziękuję. Słyszałem, że spowiedź pomaga, prawda?",shape=box,color=red];
		1354 -> 1359;
	1356 [label="Add -1 to Thermostat",color=orange];
		1356 -> 1361;
	1357 [label="Add 1 to Thermostat",color=orange];
		1357 -> 1362;
	1355 [label="I mam nadzieję, że to uczucie szybko przeminie.",shape=box,color=blue];
		1355 -> 1360;
	1358 [label="Qu'y a-t-il ? Co się stało ?",shape=box,color=blue];
		1358 -> 1288;
		1358 -> 1289;
		1358 -> 1290;
		1358 -> 1291;
	1359 [label="+5 Chemistry",color=orange];
		1359 -> 1363;
	1361 [label="+10 Chemistry",color=orange];
		1361 -> 1365;
	1362 [label="+10 Chemistry",color=orange];
		1362 -> 1366;
	1360 [label="A jeśli nie ? Mam rozwiązanie, które zawsze pomaga !",shape=box,color=blue];
		1360 -> 1364;
	1363 [label="Haha ! Oui, tak jest. Très bien, cieszę się, że mogłam cię wysłuchać.",shape=box,color=blue];
		1363 -> 1367;
	1365 [label="Oui, ale wtedy nie zostałbyś rozpustnym wilkiem, którego znamy i kochamy, prawda ? Myślę, że Sol wskazała ci właściwą drogę.",shape=box,color=blue];
		1365 -> 1369;
	1366 [label="Oui, całkowicie się zgadzam. Nikt nie urodził się, żeby walczyć. Może oprócz tych \"Grin-ire\", o których słyszałam, ale nawet wtedy...",shape=box,color=blue];
		1366 -> 1370;
	1364 [label="Des pâtisseries !",shape=box,color=blue];
		1364 -> 1368;
	1367 [label="Ach ! Podano obiad. Pora już na mnie. Do później, wilku. Cieszę się, że znów mieliśmy okazję pomówić.",shape=box,color=blue];
		1367 -> 1371;
	1369 [label="Ale rozumiem, o co ci chodzi. Dostrzegasz struktury i wskazówki, które mogłeś otrzymać i tęsknisz za szansami, których nie otrzymałeś. Zwłaszcza kiedy tak wiele czasu spędziłeś zdany na siebie.",shape=box,color=blue];
		1369 -> 1376;
	1370 [label="Zastanawiam się, czy zdecydowaliby się podążać inną drogą, gdyby mieli szansę wybrać ?",shape=box,color=blue];
		1370 -> 1377;
		1370 -> 1378;
