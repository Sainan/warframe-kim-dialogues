	419 [label="[Koniec]",shape=box,color=red];
		419 -> 422;
	424 [label="Znałam go jako le Cardinal Dimanche. Może Cię zaskoczyć, ile lat spędził w kościele, głosząc kazania naszym owieczkom.",shape=box,color=blue];
		424 -> 426;
		424 -> 427;
	423 [label="+5 Chemistry",color=orange];
		423 -> 425;
	422 [label="Chat ends.",color=orange];
	426 [label="Myślisz, że to wszystko było kłamstwem? Czy wierzył w swoje kazania?",shape=box,color=red];
		426 -> 429;
	427 [label="Nie jestem zaskoczony. To świetny kłamca.",shape=box,color=red];
		427 -> 430;
	425 [label="Ach, bardzo grzeczne pytanie, które prosi o bardzo trudną odpowiedź - muszę przyznać, że bardzo zgrabnie zadane.",shape=box,color=blue];
		425 -> 428;
	429 [label="Mówił o przebaczeniu, rodzinie i empatii z takim zapałem i oddaniem. Nie wyobrażam sobie, że mógł być nieszczery.",shape=box,color=blue];
		429 -> 434;
	430 [label="Rozumiem Twoje doświadczenia, ale ich nie podzielam. Musisz zrozumieć, że dla mnie był człowiekiem pełnym troski i miłości.",shape=box,color=blue];
		430 -> 435;
	428 [label="Czuję to samo, co czułam pierwszego dnia, kiedy wygłaszał kazanie z ambony. Błogosławieństwem było stać w jego obecności.",shape=box,color=blue];
		428 -> 431;
		428 -> 432;
		428 -> 433;
	434 [label="Czy wierzy w Świetlistych? W Sol i Lua ? Tego nie mogę być pewna, wiedząc skąd i z kiedy pochodzi. Peu importe.",shape=box,color=blue];
		434 -> 437;
	435 [label="Twoje prawdy nie czynią moich kłamstwem. W czyje prawdy powinnam wierzyć ? Czy mam odrzucić każdy akt miłosierdzia, każdy akt miłości, który okazał w latach spędzonych w parafii ?",shape=box,color=blue];
		435 -> 438;
	431 [label="Szczerze, cieszy mnie ta wieść. Myślę, że wszyscy zbyt pochopnie go potępiają.",shape=box,color=red];
		431 -> 436;
	432 [label="Myślisz, że tylko oszukiwał ludzi? Czy wierzył w swoje kazania?",shape=box,color=red];
		432 -> 429;
	433 [label="Przykro mi, że Ciebie też omamił.",shape=box,color=red];
		433 -> 430;
	437 [label="Jakie znaczenie mają imiona bogów, którym składasz modły, jeśli nosisz ich miłość głęboko w sercu ? Uważam, że żadne.",shape=box,color=blue];
		437 -> 440;
		437 -> 441;
	438 [label="Non. Nie wydaje mi się.",shape=box,color=blue];
		438 -> 442;
	436 [label="+10 Chemistry",color=orange];
		436 -> 439;
	440 [label="To urocza perspektywa. ",shape=box,color=red];
		440 -> 444;
	441 [label="Nie zgadzam się. Miłościwi wierni nie sprawiają, że sam bóg jest miłościwy.",shape=box,color=red];
		441 -> 445;
	442 [label="Wybacz mi, ale nie zrobię z niego potwora tylko dlatego, że Ty tak powiedziałeś.",shape=box,color=blue];
		442 -> 446;
	439 [label="Update boolean MarieEntratiFan1",color=orange];
		439 -> 443;
	444 [label="Wierzę, że le Cardinal szczerze wierzy w Świetlistych, nawet jeśli nie uważa, że czekają na niego w życiu po życiu.",shape=box,color=blue];
		444 -> 450;
	445 [label="+5 Chemistry",color=orange];
