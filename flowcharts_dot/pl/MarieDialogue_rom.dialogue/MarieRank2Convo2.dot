	j1559909777 [label="Mogę zapytać, co sądzisz o Entratim, skoro już tu jesteś?",shape=box,color=red];
		j1559909777 -> j291860922;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j4238114708 [label="Znałam go jako le Cardinal Dimanche. Może Cię zaskoczyć, ile lat spędził w kościele, głosząc kazania naszym owieczkom.",shape=box,color=blue];
		j4238114708 -> j606934141;
		j4238114708 -> j2478556565;
	j291860922 [label="+5 Chemistry",color=orange];
		j291860922 -> j542659830;
	"Chat ends." [color=orange];
	j606934141 [label="Myślisz, że to wszystko było kłamstwem? Czy wierzył w swoje kazania?",shape=box,color=red];
		j606934141 -> j71074093;
	j2478556565 [label="Nie jestem zaskoczony. To świetny kłamca.",shape=box,color=red];
		j2478556565 -> j4088148364;
	j542659830 [label="Ach, bardzo grzeczne pytanie, które prosi o bardzo trudną odpowiedź - muszę przyznać, że bardzo zgrabnie zadane.",shape=box,color=blue];
		j542659830 -> j1083360425;
	j71074093 [label="Mówił o przebaczeniu, rodzinie i empatii z takim zapałem i oddaniem. Nie wyobrażam sobie, że mógł być nieszczery.",shape=box,color=blue];
		j71074093 -> j2939534862;
	j4088148364 [label="Rozumiem Twoje doświadczenia, ale ich nie podzielam. Musisz zrozumieć, że dla mnie był człowiekiem pełnym troski i miłości.",shape=box,color=blue];
		j4088148364 -> j318608200;
	j1083360425 [label="Czuję to samo, co czułam pierwszego dnia, kiedy wygłaszał kazanie z ambony. Błogosławieństwem było stać w jego obecności.",shape=box,color=blue];
		j1083360425 -> j2303531796;
		j1083360425 -> j2379595657;
		j1083360425 -> j2104928190;
	j2939534862 [label="Czy wierzy w Świetlistych? W Sol i Lua ? Tego nie mogę być pewna, wiedząc skąd i z kiedy pochodzi. Peu importe.",shape=box,color=blue];
		j2939534862 -> j2999722403;
	j318608200 [label="Twoje prawdy nie czynią moich kłamstwem. W czyje prawdy powinnam wierzyć ? Czy mam odrzucić każdy akt miłosierdzia, każdy akt miłości, który okazał w latach spędzonych w parafii ?",shape=box,color=blue];
		j318608200 -> j1199364949;
	j2303531796 [label="Szczerze, cieszy mnie ta wieść. Myślę, że wszyscy zbyt pochopnie go potępiają.",shape=box,color=red];
		j2303531796 -> j4169165920;
	j2379595657 [label="Myślisz, że tylko oszukiwał ludzi? Czy wierzył w swoje kazania?",shape=box,color=red];
		j2379595657 -> j71074093;
	j2104928190 [label="Przykro mi, że Ciebie też omamił.",shape=box,color=red];
		j2104928190 -> j4088148364;
	j2999722403 [label="Jakie znaczenie mają imiona bogów, którym składasz modły, jeśli nosisz ich miłość głęboko w sercu ? Uważam, że żadne.",shape=box,color=blue];
		j2999722403 -> j3080648715;
		j2999722403 -> j1173968338;
	j1199364949 [label="Non. Nie wydaje mi się.",shape=box,color=blue];
		j1199364949 -> j828933043;
	j4169165920 [label="+10 Chemistry",color=orange];
		j4169165920 -> j943614148;
	j3080648715 [label="To urocza perspektywa. ",shape=box,color=red];
		j3080648715 -> j492585412;
	j1173968338 [label="Nie zgadzam się. Miłościwi wierni nie sprawiają, że sam bóg jest miłościwy.",shape=box,color=red];
		j1173968338 -> j2417600506;
	j828933043 [label="Wybacz mi, ale nie zrobię z niego potwora tylko dlatego, że Ty tak powiedziałeś.",shape=box,color=blue];
		j828933043 -> j2209081154;
	j943614148 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j943614148 -> j477689611;
	j492585412 [label="Wierzę, że le Cardinal szczerze wierzy w Świetlistych, nawet jeśli nie uważa, że czekają na niego w życiu po życiu.",shape=box,color=blue];
		j492585412 -> j932929181;
	j2417600506 [label="+5 Chemistry",color=orange];
		j2417600506 -> j2210691477;
	j2209081154 [label="Boolean MarieEntratiMonster1 is now true.",color=orange];
		j2209081154 -> "Chat ends.";
	j477689611 [label="Och ! Ta wieść raduje moje serce. Obawiałam się, że tylko ja podzielam to zdanie. Otaczają mnie ludzie, którzy mają tylko złe zdanie o le Cardinal.",shape=box,color=blue];
		j477689611 -> j3614186238;
		j477689611 -> j448163868;
		j477689611 -> j585102093;
	j932929181 [label="Jaki inny człowiek zna wartość empatii wobec mroku Indifférence, non?",shape=box,color=blue];
		j932929181 -> j2413258194;
	j2210691477 [label="Masz rację. Nie nazwałabym Cię Wyznawcą Sol tylko dlatego, że bezmyślnie podążasz jej Ścieżką. Więcej dobra uczyni świat lepszym, niezależnie od tego, pod jakim imieniem się kryje.",shape=box,color=blue];
		j2210691477 -> j1542291561;
	j3614186238 [label="Chciałbym, żeby wszyscy zdołali mu wybaczyć - robi co w jego mocy, żeby wszystko naprawić.",shape=box,color=red];
		j3614186238 -> j3629833974;
	j448163868 [label="Mają swoje powody. Ale jest on naszą jedyną nadzieją na powstrzymanie Obojętności.",shape=box,color=red];
		j448163868 -> j3556114311;
	j585102093 [label="Entrati także nie ma o sobie najlepszego zdania. ",shape=box,color=red];
		j585102093 -> j3410166677;
