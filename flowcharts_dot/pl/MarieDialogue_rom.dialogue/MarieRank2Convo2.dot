		j2413258194 -> j2438710085 [label=true,color=green];
		j2413258194 -> j3650356305 [label=false,color=brown];
	j1542291561 [label="Dlatego też cenię le Cardinal, nawet jeśli nie nazywa swojej wiary tak samo, jak ja.",shape=box,color=blue];
		j1542291561 -> j932929181;
	j3629833974 [label="Add 1 to Thermostat counter",color=orange];
		j3629833974 -> j3034989334;
	j3556114311 [label="Add -1 to Thermostat counter",color=orange];
		j3556114311 -> j4217912757;
	j3410166677 [label="Oui, et comme c'est tragique... Płakać mi się chce na samą myśl. I o samotności Monsieur Loida, ich zagubionej miłości.",shape=box,color=blue];
		j3410166677 -> j2058992522;
	j2438710085 [label="Wybacz mi, zapomniałam... nie uważasz, że l'Indifférence istnieje. To tylko halucynacja. Ale wierzysz w uczucia, jakie budzi, oui ?",shape=box,color=blue];
		j2438710085 -> j1292608075;
		j2438710085 -> j754164123;
	j3650356305 [label="Doskonale, że przychodzi głosić przesłanie jako przeciwwagę dla tego, co sam uwolnił, n'est-ce pas ?",shape=box,color=blue];
		j3650356305 -> j2581108691;
		j3650356305 -> j1136768977;
		j3650356305 -> j633374521;
	j3034989334 [label="Oui, i myślę też, że to właśnie zadanie, które przed nami stoi.",shape=box,color=blue];
		j3034989334 -> j2058992522;
	j4217912757 [label="Oui, ale walka z l'Indifférence nie zostanie wygrana ogniem i mieczem. Zostanie wygrana sercem, nie rozumiesz tego ?",shape=box,color=blue];
		j4217912757 -> j2058992522;
	j2058992522 [label="To nie diabeł Orokin, któremu powinniśmy przebaczyć, non ? To le Cardinal, tyle jest jasne. Myślę, że to miłość Monsieur Loida jest źródłem tej inspiracji.",shape=box,color=blue];
		j2058992522 -> j2189572510;
	j1292608075 [label="Wszystkie emocje mają swój cel, nawet obojętność.",shape=box,color=red];
		j1292608075 -> j1028286356;
	j754164123 [label="Wierzę. Byłem ich ofiarą w Duviri. Pozwoliłem pochłaniać się apatii, aż została tylko ona.",shape=box,color=red];
		j754164123 -> j62952607;
	j2581108691 [label="Chciałbym wiedzieć, jak mogę pomóc mu rozwiązać ten problem.",shape=box,color=red];
		j2581108691 -> j1146911627;
	j1136768977 [label="Chciałbym, żeby miał lepszy plan niż \"głosić kazania\".",shape=box,color=red];
		j1136768977 -> j3698093977;
	j633374521 [label="Patrząc na to, że wypuszczenie tego potwora to jego sprawka... tak. Przynajmniej tyle mógł zrobić.",shape=box,color=red];
		j633374521 -> j1307409512;
	j2189572510 [label="Moje serce się kraje. Nie pragnę niczego więcej, jak ich ponownego zjednoczenia !",shape=box,color=blue];
		j2189572510 -> j3203834354;
		j2189572510 -> j4069937335;
	j1028286356 [label="Oczywiście, że ma swój cel. Je ne le nie pas.",shape=box,color=blue];
		j1028286356 -> j1248390837;
