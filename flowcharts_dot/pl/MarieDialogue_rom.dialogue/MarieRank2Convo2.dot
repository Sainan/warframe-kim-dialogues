		j3037220180 -> j1274754347;
	j3929378314 [label="Haha ! Ty, ze wszystkich, powinieneś wiedzieć najlepiej, że wiara nigdy nie jest mądra. A jednak nosimy ją ze sobą, choć czasem nas spali. Podejrzewam, że już znasz to uczucie, jeśli nasza wcześniejsza rozmowa była szczera.",shape=box,color=blue];
		j3929378314 -> j1453594685;
		j3929378314 -> j1590143036;
	j3547165889 [label="Wiara nigdy nie jest mądra. Ale ci z nas, którzy noszą ją niczym pochodnie, pragną zachować ją na zawsze blisko siebie - nawet jeśli nas spali.",shape=box,color=blue];
		j3547165889 -> j1938191101;
	j879010410 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j879010410 -> j1185699525;
	j3502840078 [label="Czy dopuszczasz do siebie myśl, że serce może należeć do więcej niż jednej duszy ? Że można kochać więcej niż jedną osobę ?",shape=box,color=blue];
		j3502840078 -> j3371246056;
		j3502840078 -> j671341469;
	j1765377861 [label="Miłość, to wszystko co nam zostało na świecie, kiedy przepadło wszystko inne, non ?",shape=box,color=blue];
		j1765377861 -> j3799586966;
