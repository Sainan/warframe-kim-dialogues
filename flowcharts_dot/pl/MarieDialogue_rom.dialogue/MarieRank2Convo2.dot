		500 -> 510;
	501 [label="Za brak wiary. W l'Indifférence. W cokolwiek. Gdybym to ja stworzyła świat du tissu du Néant - z materiału Pustki- może poczułabym się tak samo.",shape=box,color=blue];
		501 -> 510;
	495 [label="+5 Chemistry",color=orange];
