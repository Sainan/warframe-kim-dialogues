		512 -> 524;
	513 [label="To było piękne, słoneczne popołudnie. Pamiętam go, jak stał przed ołtarzem, wpatrując się w witraż z uśmiechem na twarzy, choć nie widziałam dlaczego.",shape=box,color=blue];
		513 -> 525;
	532 [label="Chęć do naprawienia wyrządzonych szkód jest ważna, nie zrozum mnie źle. Jeśli to w ogóle możliwe, przebaczenie tych, którzy zostali skrzywdzeni, jest wspaniałym ukojeniem.",shape=box,color=blue];
		532 -> 538;
	533 [label="Och, nie chciałam sugerować, że nie warto poszukiwać przebaczenia tych, których skrzywdziliśmy ! W żadnym razie !",shape=box,color=blue];
		533 -> 539;
	526 [label="Powiedz mi jeszcze raz o tych, którzy są \"tylko ludźmi\", a ja postaram się nie zbyć Cię śmiechem, obiecuję.",shape=box,color=blue];
		526 -> 536;
	528 [label="Niesiemy ją, bo musimy. Bo nie znamy innego sposobu istnienia. Nieważne, co ona ostatecznie znaczy. Wiem, co czujesz.",shape=box,color=blue];
		528 -> 527;
	529 [label="Wiara nie jest stała. Ma swoje przypływy i odpływy, i taka jest jej natura.",shape=box,color=blue];
		529 -> 527;
	527 [label="Ale obawiam się, że nie dlatego chciałeś ze mną porozmawiać. Przyszedłeś w poszukiwaniu historii, non ?",shape=box,color=blue];
		527 -> 513;
	530 [label="Mogę wierzyć w ludzi i w bogów na różne sposoby.",shape=box,color=red];
		530 -> 537;
	531 [label="Istnieje różnica między wiarą w bogów i wiarą w ludzi, a Entrati jest tylko człowiekiem.",shape=box,color=red];
		531 -> 488;
	524 [label="Interesujące. Za mało wiem o życiu Orokin, żeby zdecydować, czy było to sprzeczne z ich zwyczajami. Wiem natomiast, że w wielu starożytnych kulturach nie było to źle widziane.",shape=box,color=blue];
		524 -> 534;
	525 [label="Przykucnął, by mnie powitać. Jego twarz opadła poniżej mojej.",shape=box,color=blue];
		525 -> 535;
	538 [label="Ale koniec końców, kiedy przyjdzie po nas Jędza, kiedy Lua uroni za nas swe srebrne łzy, a śmierć będzie blisko, to ciężar naszego własnego serca będziemy zmuszeni dźwigać.",shape=box,color=blue];
		538 -> 545;
		538 -> 546;
	539 [label="Naprawienie wyrządzonych przez siebie szkód jest najpotężniejszym ukojeniem dla duszy. ",shape=box,color=blue];
		539 -> 538;
	536 [label="Do tego czasu, zachęcam Cię, abyś zastanowił się, co znaczy być błogosławionym. Żegnaj.",shape=box,color=blue];
		536 -> 544;
	537 [label="Oui, jeden jest namacalny. Obecny. Drugi wymaga, byśmy zamknęli oczy i uwierzyli. ",shape=box,color=blue];
		537 -> 527;
	534 [label="Ale to nie nam przychodzi decydować... nie tym razem. Nie mam zamiaru oceniać przejawów miłości le Cardinal wobec Monsieur Loida, ani słów M. Loida w odpowiedzi na miłość.",shape=box,color=blue];
