		551 -> 556;
		551 -> 557;
	553 [label="Proszę... Błagam Cię, nie miej złego zdania o moim drogim Leonie. Nie jest infirme, obiecuję. Nęka go une maladie de l'esprit.",shape=box,color=blue];
