		j1826003273 -> j658685961;
	j4134192895 [label="Za brak wiary. W l'Indifférence. W cokolwiek. Gdybym to ja stworzyła świat du tissu du Néant - z materiału Pustki- może poczułabym się tak samo.",shape=box,color=blue];
