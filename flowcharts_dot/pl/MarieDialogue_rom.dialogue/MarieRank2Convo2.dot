		j1248390837 -> j3818089456;
	j2893157449 [label="Oui, oui - słyszałam opowieści o świecie, który stworzyłeś. W którym zostałeś całkiem sam i nie miałeś do kogo się zwrócić.",shape=box,color=blue];
