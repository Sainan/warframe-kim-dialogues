	450 [label="Jaki inny człowiek zna wartość empatii wobec mroku Indifférence, non?",shape=box,color=blue];
		450 -> 456;
	451 [label="Masz rację. Nie nazwałabym Cię Wyznawcą Sol tylko dlatego, że bezmyślnie podążasz jej Ścieżką. Więcej dobra uczyni świat lepszym, niezależnie od tego, pod jakim imieniem się kryje.",shape=box,color=blue];
		451 -> 457;
	452 [label="Chat ends.",color=orange];
