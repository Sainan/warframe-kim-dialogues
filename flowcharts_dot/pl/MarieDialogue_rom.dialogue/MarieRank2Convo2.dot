	446 [label="Update boolean MarieEntratiMonster1",color=orange];
		446 -> 452;
	443 [label="Och ! Ta wieść raduje moje serce. Obawiałam się, że tylko ja podzielam to zdanie. Otaczają mnie ludzie, którzy mają tylko złe zdanie o le Cardinal.",shape=box,color=blue];
		443 -> 447;
		443 -> 448;
