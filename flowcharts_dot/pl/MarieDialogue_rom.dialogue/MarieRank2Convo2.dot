		496 -> 505;
	498 [label="Haha ! Ty, ze wszystkich, powinieneś wiedzieć najlepiej, że wiara nigdy nie jest mądra. A jednak nosimy ją ze sobą, choć czasem nas spali. Podejrzewam, że już znasz to uczucie, jeśli nasza wcześniejsza rozmowa była szczera.",shape=box,color=blue];
		498 -> 507;
		498 -> 508;
	497 [label="Wiara nigdy nie jest mądra. Ale ci z nas, którzy noszą ją niczym pochodnie, pragną zachować ją na zawsze blisko siebie - nawet jeśli nas spali.",shape=box,color=blue];
		497 -> 506;
	499 [label="Update boolean MarieEntratiFan1",color=orange];
		499 -> 509;
	493 [label="Czy dopuszczasz do siebie myśl, że serce może należeć do więcej niż jednej duszy ? Że można kochać więcej niż jedną osobę ?",shape=box,color=blue];
		493 -> 502;
