		j62952607 -> j2893157449;
	j1146911627 [label="+5 Chemistry",color=orange];
		j1146911627 -> j186635428;
	j3698093977 [label="A kimże jesteśmy, by oceniać jego metody? Cardinal Dimanche jest geniuszem, pobłogosławionym przez Świetlistych. To on nas poprowadzi.",shape=box,color=blue];
		j3698093977 -> j516112901;
		j3698093977 -> j548089333;
