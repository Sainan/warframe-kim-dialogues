		454 -> 459;
	455 [label="Oui, et comme c'est tragique... Płakać mi się chce na samą myśl. I o samotności Monsieur Loida, ich zagubionej miłości.",shape=box,color=blue];
		455 -> 460;
	462 [label="Wybacz mi, zapomniałam... nie uważasz, że l'Indifférence istnieje. To tylko halucynacja. Ale wierzysz w uczucia, jakie budzi, oui ?",shape=box,color=blue];
		462 -> 467;
		462 -> 468;
	461 [label="Doskonale, że przychodzi głosić przesłanie jako przeciwwagę dla tego, co sam uwolnił, n'est-ce pas ?",shape=box,color=blue];
		461 -> 464;
		461 -> 465;
		461 -> 466;
	458 [label="Oui, i myślę też, że to właśnie zadanie, które przed nami stoi.",shape=box,color=blue];
		458 -> 460;
	459 [label="Oui, ale walka z l'Indifférence nie zostanie wygrana ogniem i mieczem. Zostanie wygrana sercem, nie rozumiesz tego ?",shape=box,color=blue];
		459 -> 460;
	460 [label="To nie diabeł Orokin, któremu powinniśmy przebaczyć, non ? To le Cardinal, tyle jest jasne. Myślę, że to miłość Monsieur Loida jest źródłem tej inspiracji.",shape=box,color=blue];
		460 -> 463;
	467 [label="Wszystkie emocje mają swój cel, nawet obojętność.",shape=box,color=red];
		467 -> 474;
	468 [label="Wierzę. Byłem ich ofiarą w Duviri. Pozwoliłem pochłaniać się apatii, aż została tylko ona.",shape=box,color=red];
		468 -> 475;
	464 [label="Chciałbym wiedzieć, jak mogę pomóc mu rozwiązać ten problem.",shape=box,color=red];
		464 -> 471;
	465 [label="Chciałbym, żeby miał lepszy plan niż \"głosić kazania\".",shape=box,color=red];
		465 -> 472;
