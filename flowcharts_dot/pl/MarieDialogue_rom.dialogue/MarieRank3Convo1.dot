		917 -> 931 [label="DrifterFaithBalance",color=purple];
		917 -> 929 [label="false",color=purple];
	918 [label="Słyszałam tylko o Pladze i nie wiem o niej wiele... ale wierzę Ci. Modlę się, żeby to co mówisz było prawdą i mam nadzieję, że nie jest uwięziona.",shape=box,color=blue];
		918 -> 933;
	919 [label="To miłe, że tak mówisz. Jeśli to co czuję jest prawdziwe, i modlę się, żeby było, wtedy miałbyś rację. Nie uważam, żeby była uwięziona.",shape=box,color=blue];
		919 -> 933;
	920 [label="Modlę się, żeby to co czuję, było prawdziwe. Non, nie sądzę, żeby była uwięziona.",shape=box,color=blue];
		920 -> 933;
	921 [label="Modlę się, żeby to co czuję, było prawdziwe. Oui, wtedy miałbyś rację. Zostają z nami, by nam pomóc. Nie sądzę, żeby była uwięziona.",shape=box,color=blue];
		921 -> 933;
	922 [label="Oui, zostałam błogosławiona przez le Cardinal... ale wiem, że moja miłość do niego jest wyjątkowa, nieskażona smutkiem, nienawiścią czy urazą.",shape=box,color=blue];
		922 -> 934;
	925 [label="Wiem, że widzisz w nim strasznego potwora. Ale muszę zapytać, co sprawiło, że tak mu nie ufasz ?",shape=box,color=blue];
		925 -> 937;
		925 -> 939;
		925 -> 938;
	923 [label="Myślałam, że w niego wierzysz ? Skąd ta zmiana ? Dlaczego jesteś taki kapryśny ? ",shape=box,color=blue];
		923 -> 935;
		923 -> 936;
	924 [label="Skąd w Tobie ten brak wiary ?",shape=box,color=blue];
		924 -> 937;
		924 -> 938;
		924 -> 939;
	928 [label="Oui, i znów tak prędko zmieniasz zdanie ? Kłamiesz. W jakim celu, nie wiem. Et je ne veux pas le savoir.",shape=box,color=blue];
		928 -> 941;
	926 [label="+5 Chemistry",color=orange];
		926 -> 940;
	927 [label="Update boolean MarieEntratiFan1",color=orange];
		927 -> 940;
	930 [label="Ci z nas, którzy obrali ścieżkę Sol, muszą zawsze być światłem latarni dla tych, którzy znaleźli się na rozdrożach, non ? ",shape=box,color=blue];
		930 -> 942;
	932 [label="Jesteś wyznawcą Lua. Pamiętasz nauki, które mówią, że niektórzy muszą samotnie kroczyć wśród cieni, oui ?",shape=box,color=blue];
		932 -> 942;
	931 [label="Jesteś wyznawcą Świetlistych. Pamiętasz, jak brzmią nauki o tych, którzy samotnie kroczą nieznanymi drogami, oui ?",shape=box,color=blue];
		931 -> 942;
	929 [label="W mojej wierze znamy ludzi, którzy wędrują drogami życia i znajdują się na rozdrożu, gdzie spotykają się Lua i Sol. ",shape=box,color=blue];
		929 -> 942;
	933 [label="Czuję jedynie jej ciepły uśmiech Sol na sobie. Uważam, że le Cardinal podjął mądrą decyzję. Jestem zaszczycona mogąc ugościć ją w swoim ciele.",shape=box,color=blue];
		933 -> 908;
		933 -> 907;
		933 -> 905;
		933 -> 906;
	934 [label="Wybaczam mu to, że nas opuścił. Ale chyba jestem w tym sama...",shape=box,color=blue];
		934 -> 943;
		934 -> 944;
		934 -> 937;
		934 -> 938;
	937 [label="On... pojawił się w Duviri. Dawno, dawno temu...",shape=box,color=red];
		937 -> 947;
	939 [label="Zacznijmy od tego, że postrzelił mnie i zostawił na śmierć.",shape=box,color=red];
		939 -> 948;
	938 [label="Zostawia po sobie jedynie ból, śmierć i porzucenie.",shape=box,color=red];
		938 -> 917;
	935 [label="Nigdy mu nie ufałem, po prostu nie chciałem Cię odstraszyć.",shape=box,color=red];
		935 -> 945;
	936 [label="Nie chciałem kłamać, ale nie wiedziałem, jak podejść do tematu. Widać, że go uwielbiasz...",shape=box,color=red];
		936 -> 946;
	941 [label="Update boolean MarieNoDate",color=orange];
		941 -> 950;
	940 [label="Tak, musimy pozostać silni ! Braves contre les ténèbres, pour toujours et à jamais !",shape=box,color=blue];
		940 -> 949;
	942 [label="Update boolean DrifterCrossroads",color=orange];
		942 -> 951;
	943 [label="Masz rację, zranił i porzucił wielu ludzi. I myślę, że uważał to za konieczne.",shape=box,color=red];
		943 -> 952;
	944 [label="To trudne, gdy ktoś, kto tak wiele dla Ciebie znaczy - ktoś, kogo kochasz i na kim polegasz - odchodzi. Szczególnie, kiedy nie wiesz dlaczego. Albo czy w ogóle powróci.",shape=box,color=red];
		944 -> 953;
	947 [label="Na Sol ! Świat, który stworzyłeś, wywołałeś z książki napisanej przez córkę, oui ? Monsieur Loid opowiedział mi o nim... Był w nim le Cardinal ? Dlaczego ? ",shape=box,color=blue];
		947 -> 956;
		947 -> 957;
		947 -> 958;
	948 [label="Et pourtant, vous êtes toujours en vie ! Ale żyjesz, czyż nie ? I masz się dobrze ? Rozwijasz się, jeśli wierzyć opowieściom Monsieur Loida o Twoich podróżach w nadchodzącą przeszłość.",shape=box,color=blue];
		948 -> 959;
	945 [label="Ah, je vois ! Je suis une idiote, c'est ça ?! Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même ?! Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer !",shape=box,color=blue];
		945 -> 954;
	946 [label="Ach, oui... Nie ułatwiałam Ci wypowiedzieć się szczerze, n'est-ce pas ?",shape=box,color=blue];
		946 -> 955;
	950 [label="Chat ends.",color=orange];
	949 [label="Wybaczyłam mu to, że nas opuścił. Ale chyba jestem w tym sama...",shape=box,color=blue];
		949 -> 943;
		949 -> 944;
	951 [label="Le Cardinal musi odnaleźć swoją drogę powrotną do nas. Możemy mu pomóc tylko wtedy, kiedy nas wezwie i postępować tak, jak każą nam inni, błogosławieni tak jak on.",shape=box,color=blue];
		951 -> 960;
	952 [label="+5 Chemistry",color=orange];
		952 -> 961;
	953 [label="+5 Chemistry",color=orange];
		953 -> 962;
	956 [label="Myślę, że na początku jakaś część niego szukała tam fragmentu córki, którą pozostawił. Zamiast tego wdał się w bójkę z Obojętnością - z uczuciami, przed którymi chciał uciec.",shape=box,color=red];
		956 -> 964;
	957 [label="Jego zapiski opowiadają niezwykle irytującą, samochwalną historię tego, jak wyruszył, by badać urzeczywistnienie idei, a zamiast tego dowiedział się, jak ważna jest walka z Obojętnością.",shape=box,color=red];
		957 -> 965;
	958 [label="Jeśli wierzyć jego notatkom, chciał nauczyć Duviri - a co za tym idzie, mnie - jak bronić się przed Obojętnością. I co z tego ostatecznie wyszło?",shape=box,color=red];
		958 -> 966;
	959 [label="Check boolean IsDating",color=orange];
		959 -> 968 [label=true,color=green];
		959 -> 967 [label=false,color=brown];
	954 [label="Va t'asseoir sur une ruche.",shape=box,color=blue];
		954 -> 963;
	955 [label="Powiedz mi więc prawdę, wilku. Dlaczego uważasz, że nie można mu ufać ? A ja postaram się zachować spokój.",shape=box,color=blue];
		955 -> 944;
		955 -> 937;
		955 -> 938;
		955 -> 939;
	960 [label="Evaluate expressions",color=orange];
		960 -> 969 [label="MarieEntratiMonster1",color=purple];
		960 -> 971 [label="MarieEntratiMonster1",color=purple];
		960 -> 969 [label="MarieEntratiFan1",color=purple];
		960 -> 972 [label="MarieEntratiFan1",color=purple];
		960 -> 969 [label="false",color=purple];
		960 -> 971 [label="false",color=purple];
		960 -> 972 [label="false",color=purple];
		960 -> 970 [label="false",color=purple];
	961 [label="Oui, masz rację. Myślę, że dręczy go poczucie winy za wszystko, co zrobił. Myślę, że umyślnie odsuwa się od innych.",shape=box,color=blue];
		961 -> 973;
	962 [label="Oui, to wielka szkoda i ogromny ból. Wiedzieć, że ktoś... nadal żyje, ale nie chce żyć z tobą ?",shape=box,color=blue];
		962 -> 973;
	964 [label="Mon cœur se brise dans la tragédie - Nie wiem, czy zdołam sobie poradzić z tym smutkiem... a ona mu nie wybaczyła ?",shape=box,color=blue];
		964 -> 975;
		964 -> 976;
	965 [label="Wiesz dlaczego odszedł ?",shape=box,color=blue];
		965 -> 975;
		965 -> 977;
	966 [label="Co masz na myśli ?",shape=box,color=blue];
		966 -> 978;
		966 -> 979;
	968 [label="Rzeczywiście, jeśli pogłoski wśród Cavii są prawdziwe, vous y avez vraiment trouvé beaucoup de joie, non ?",shape=box,color=blue];
		968 -> 967;
	967 [label="Non, le Cardinal postąpił znacznie gorzej wobec wielu innych. Jesteś po prostu zdenerwowany tym, że sprawy nie poszły po Twojej myśli.",shape=box,color=blue];
		967 -> 917;
	963 [label="Update boolean MarieNoDate",color=orange];
		963 -> 974;
	969 [label="Chciałbym tylko... żeby wszyscy wokół Entratiego przestali obwiniać siebie samych i siebie nawzajem za to, co się stało.",shape=box,color=red];
		969 -> 980;
	971 [label="Nie wiem, czy nazwałbym go błogosławionym.",shape=box,color=red];
		971 -> 982;
	972 [label="Znacznie łatwiej byłoby mi wybaczyć Entratiemu, gdybym rozumiał jego występki.",shape=box,color=red];
		972 -> 983;
	970 [label="Zrobię to, co będzie konieczne, żeby rozwiązać problem. A kiedy to wszystko dobiegnie końca, dopiero wtedy będę go oceniać.",shape=box,color=red];
		970 -> 981;
	973 [label="Il inflige la douleur dans le cœur des autres, car la douleur vaut mieux que rien du tout. Bo cierpienie jest lepsze niż pustka, prawda ?",shape=box,color=blue];
		973 -> 984;
	975 [label="Obawiam się, że kiedy nie daje on żadnego uzasadnienia, zostają nam tylko domysły.",shape=box,color=red];
		975 -> 985;
	976 [label="Nie o to chodzi. Zostawił mnie tam. Zobaczył kogoś porzuconego w Pustce i... zostawił mnie tam.",shape=box,color=red];
		976 -> 986;
	977 [label="Nie. Wiem tylko, że mnie tam zostawił. Zobaczył kogoś porzuconego w Pustce i... zostawił mnie tam.",shape=box,color=red];
		977 -> 985;
	978 [label="Zostawił mnie tam. Przybył w nieznanym mi czasie, zobaczył kogoś porzuconego w Pustce i... zostawił mnie tam.",shape=box,color=red];
		978 -> 986;
	979 [label="Obojętność i tak trafiła do Duviri. (Choć miała niespodziewaną pomoc, ale to nie ma tu znaczenia.)",shape=box,color=red];
		979 -> 987;
	974 [label="Chat ends.",color=orange];
	980 [label="Update boolean MarieEntratiFamily",color=orange];
		980 -> 988;
	982 [label="Możemy się więc zgodzić, że pozostaniemy w niezgodzie.",shape=box,color=blue];
		982 -> 990;
	983 [label="Modlę się, żeby tak się stało. Modlę się, żebyśmy wszyscy zdołali to zobaczyć. Ale na razie widzę wokół siebie rodzinę i modlę się, by zdołali mu przebaczyć, żeby sami mogli zaznać szczęścia.",shape=box,color=blue];
		983 -> 991;
	981 [label="+10 Chemistry",color=orange];
		981 -> 989;
	984 [label="To lekcja, którą mój drogi Leon zna lepiej, niż ktokolwiek inny... Cieszę się, że zaczął z Tobą rozmawiać. Ale dzisiaj rozmawiamy o le Cardinal.",shape=box,color=blue];
		984 -> 992;
	985 [label="Mogę tylko założyć, że miało to miejsce przed... morderstwem ad infinitum.",shape=box,color=red];
		985 -> 993;
	986 [label="I nie wiesz, dlaczego Cię tam zostawił ?",shape=box,color=blue];
		986 -> 994;
