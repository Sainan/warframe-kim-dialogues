	j3045448544 [label="Czy przeszkadza Ci dyskusja o duszy ? Zrozumiem, jeśli sprawia Ci to dyskomfort i postaram się trzymać bardziej namacalnych spraw.",shape=box,color=blue];
		j3045448544 -> j2361326592;
