		j1293908090 -> j2928510904;
	j1590094417 [label="Boolean MarieNeci is now true.",color=orange];
		j1590094417 -> j3448177894;
	j1387548525 [label="Ach, co za myśl. Myślę, że warto wesprzeć tę sprawę !",shape=box,color=blue];
		j1387548525 -> j130896092;
	j2999217680 [label="Być może nie wiedział, czy zdoła Cię z niego wyciągnąć. Obawiał się, że jego delikatna konstrukcja zapadnie się. Może obawiał się, że pod Twoją nieobecność przejmie je l'Indifférence. Peut-être, peut-être, peut-être.",shape=box,color=blue];
		j2999217680 -> j1591510439;
