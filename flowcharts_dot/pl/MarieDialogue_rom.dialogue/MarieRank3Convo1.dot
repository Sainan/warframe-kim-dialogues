		j3838393648 -> j1351488541;
	j2342661247 [label="Myślę, że przepadły z czasem.",shape=box,color=red];
		j2342661247 -> j1351488541;
	j691085563 [label="Trochę tego i trochę tego. Byli... po części bronią, po części dziełem sztuki w wykonaniu ich twórcy.",shape=box,color=red];
		j691085563 -> j3923195056;
	j1800876379 [label="Vraiment ? Czuję się tak, jakbym znała ją jak własną siostrę - i chodzi mi o pokrewieństwo krwi, nie towarzyszy wiary.",shape=box,color=blue];
		j1800876379 -> j2454521952;
	j2361326592 [label="Spokojnie, możemy porozmawiać o duszach.",shape=box,color=red];
