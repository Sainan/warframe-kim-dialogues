	868 [label="Niestety, nie wiemy wiele o ludziach, którzy stali się oryginalnymi warframe'ami.",shape=box,color=red];
		868 -> 871;
	867 [label="Niestety, nie wiemy wiele o oryginalnej Wisp.",shape=box,color=red];
		867 -> 871;
	870 [label="Opowiedz mi, wilku, o tej osobie zwanej \"Wisp\", której plugawa krew płynie w moich żyłach i która dała mi dar lotu, i której obecność czuję w ciemnych zakamarkach każdej nocy.",shape=box,color=blue];
		870 -> 874;
		870 -> 873;
	869 [label="Opowiedz mi, wilku, o tej osobie zwanej \"Wisp\", której plugawa krew płynie w moich żyłach i która dała mi dar lotu, i której obecność czuję w ciemnych zakamarkach każdej nocy.",shape=box,color=blue];
		869 -> 872;
	871 [label="Vraiment ? Czy te zapisy przepadły z czasem, czy podejrzewasz, że nikt nie uznał je za wystarczająco ważne, by je zapisać ?",shape=box,color=blue];
		871 -> 875;
		871 -> 876;
		871 -> 877;
	874 [label="Niestety, nie wiemy wiele o ludziach, którzy stali się oryginalnymi warframe'ami.",shape=box,color=red];
		874 -> 881;
	873 [label="Niestety, nie wiemy wiele o oryginalnej Wisp.",shape=box,color=red];
		873 -> 881;
	872 [label="Czy przeszkadza Ci dyskusja o duszy ? Zrozumiem, jeśli sprawia Ci to dyskomfort i postaram się trzymać bardziej namacalnych spraw.",shape=box,color=blue];
		872 -> 880;
		872 -> 879;
		872 -> 878;
	875 [label="Myślę, że nikt nie uznał ich za wystarczająco ważnych, żeby o nich pamiętać.",shape=box,color=red];
		875 -> 882;
	876 [label="Myślę, że przepadły z czasem.",shape=box,color=red];
		876 -> 882;
	877 [label="Trochę tego i trochę tego. Byli... po części bronią, po części dziełem sztuki w wykonaniu ich twórcy.",shape=box,color=red];
		877 -> 883;
	881 [label="Vraiment ? Czuję się tak, jakbym znała ją jak własną siostrę - i chodzi mi o pokrewieństwo krwi, nie towarzyszy wiary.",shape=box,color=blue];
		881 -> 887;
	880 [label="Spokojnie, możemy porozmawiać o duszach.",shape=box,color=red];
		880 -> 874;
		880 -> 873;
		880 -> 886;
	879 [label="Nie wierzę w duszę, czy możemy trzymać się konkretów?",shape=box,color=red];
		879 -> 885;
	878 [label="[Koniec]",shape=box,color=red];
		878 -> 884;
	882 [label=" Widzisz ? Ces Orokin, to prawdziwe diabły.",shape=box,color=blue];
		882 -> 888;
		882 -> 889;
	883 [label="+5 Chemistry",color=orange];
		883 -> 890;
	887 [label="Nie słyszę jej, nie tak, jak Leon słyszy bogów i swoich patronów. Nie widzę jej oczami. Po prostu... czuję jej obecność.",shape=box,color=blue];
		887 -> 893;
	886 [label="[Koniec]",shape=box,color=red];
		886 -> 892;
	885 [label="Update boolean DrifterFaithStop",color=orange];
		885 -> 891;
	884 [label="Chat ends.",color=orange];
	888 [label="Broń może służyć do obrony, jak i do ataku. Nie podoba mi się, że są one konieczne... ale są.",shape=box,color=red];
		888 -> 894;
	889 [label="Nie wszyscy, ale ten? Tak. Wciąż są tacy, których nie potępiłbym od razu.",shape=box,color=red];
		889 -> 895;
	890 [label="Une horrible toile d'os peinte avec du sang... widzisz ? Ces Orokin, to prawdziwe diabły.",shape=box,color=blue];
		890 -> 888;
		890 -> 889;
	893 [label="Jak stara przyjaciółka. Wiem, co lubiła. Wiem, jak się poruszała. Pamiętam dźwięk jej śmiechu na wietrze...",shape=box,color=blue];
		893 -> 897;
	892 [label="Chat ends.",color=orange];
	891 [label="+5 Chemistry",color=orange];
		891 -> 896;
	894 [label="Add -1 to Thermostat",color=orange];
		894 -> 898;
	895 [label="Add 1 to Thermostat",color=orange];
		895 -> 899;
	897 [label="Wybacz ! Muszę brzmieć jak szaleniec.",shape=box,color=blue];
		897 -> 901;
		897 -> 902;
		897 -> 903;
		897 -> 904;
	896 [label="Oui, bien sûr ! Nikt nie chce słuchać kazań, a tym bardziej od Siostry. Rozumiem. Merci, że zaoszczędziłeś mi robienia z siebie idiotki.",shape=box,color=blue];
		896 -> 868;
		896 -> 867;
		896 -> 900;
	898 [label="Tak, to prawda. Teraz jestem bronią, o czym Murmure dobrze się przekonało ! Ale pragnę podążać ścieżką wskazaną mi przez le Cardinal.",shape=box,color=blue];
		898 -> 905;
		898 -> 906;
	899 [label="Jak le Cardinal. Był Orokin, non ? I z pewnością nie takim, którego bym potępiała. Bez nie go, nie doświadczyłabym tego błogosławieństwa.",shape=box,color=blue];
		899 -> 907;
		899 -> 908;
	901 [label="Warframe'y... nie powstawały w najprzyjemniejszy sposób. Mam nadzieję, że nie jest uwięziona w Pladze.",shape=box,color=red];
		901 -> 910;
	902 [label="Zastanawiam się, kim była Wisp. Na pewno z chęcią by Cię poznała.",shape=box,color=red];
		902 -> 911;
	903 [label="Mam nadzieję, że ich dusze mogły udać się na wieczny spoczynek, ale część ich wspomnień pozostała z nami.",shape=box,color=red];
		903 -> 912;
	904 [label="Wcale nie. Wierzę, że jakaś część ludzi, którzy zostali przemienieni w warframe'y, pozostaje w ich schematach.",shape=box,color=red];
		904 -> 913;
	900 [label="[Koniec]",shape=box,color=red];
		900 -> 909;
	905 [label="Mógłbym się z nim kłócić o wiele rzeczy, ale muszę przyznać, że wydaje się mieć dobry instynkt, jeśli chodzi o to, komu podać serum z protoframami. Nawet jeśli nie wiem, dlaczego to robi.",shape=box,color=red];
		905 -> 914;
	906 [label="Wolałbym, żebyś nie pokładała takiego zaufania w Entratim. Nie wiemy, czym się kieruje i jakie ma cele.",shape=box,color=red];
		906 -> 915;
	907 [label="Musimy trzymać się Entratiego. Myślę, że musimy po prostu podążać za nim. On jest naszą jedyną szansą na powstrzymanie Obojętności.",shape=box,color=red];
		907 -> 916;
	908 [label="To kłamca, Mario. Porzuca i rani wszystkich w swoim życiu. Nie widzisz, że już Cię porzucił? ",shape=box,color=red];
		908 -> 917;
