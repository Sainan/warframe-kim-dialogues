	j3534499833 [label="Add 1 to Thermostat counter",color=orange];
		j3534499833 -> j1587677423;
	j1655283451 [label="Wybacz ! Muszę brzmieć jak szaleniec.",shape=box,color=blue];
		j1655283451 -> j2762159653;
		j1655283451 -> j997330523;
		j1655283451 -> j1470465057;
		j1655283451 -> j1104258133;
	j418533079 [label="Oui, bien sûr ! Nikt nie chce słuchać kazań, a tym bardziej od Siostry. Rozumiem. Merci, że zaoszczędziłeś mi robienia z siebie idiotki.",shape=box,color=blue];
		j418533079 -> j4135100589;
		j418533079 -> j2363482591;
		j418533079 -> j386906797;
	j33927752 [label="Tak, to prawda. Teraz jestem bronią, o czym Murmure dobrze się przekonało ! Ale pragnę podążać ścieżką wskazaną mi przez le Cardinal.",shape=box,color=blue];
		j33927752 -> j3582417954;
		j33927752 -> j906340060;
	j1587677423 [label="Jak le Cardinal. Był Orokin, non ? I z pewnością nie takim, którego bym potępiała. Bez nie go, nie doświadczyłabym tego błogosławieństwa.",shape=box,color=blue];
		j1587677423 -> j372574149;
		j1587677423 -> j345086353;
	j2762159653 [label="Warframe'y... nie powstawały w najprzyjemniejszy sposób. Mam nadzieję, że nie jest uwięziona w Pladze.",shape=box,color=red];
		j2762159653 -> j66787167;
	j997330523 [label="Zastanawiam się, kim była Wisp. Na pewno z chęcią by Cię poznała.",shape=box,color=red];
		j997330523 -> j1854454739;
	j1470465057 [label="Mam nadzieję, że ich dusze mogły udać się na wieczny spoczynek, ale część ich wspomnień pozostała z nami.",shape=box,color=red];
		j1470465057 -> j1883065118;
	j1104258133 [label="Wcale nie. Wierzę, że jakaś część ludzi, którzy zostali przemienieni w warframe'y, pozostaje w ich schematach.",shape=box,color=red];
		j1104258133 -> j651481443;
	j3582417954 [label="Mógłbym się z nim kłócić o wiele rzeczy, ale muszę przyznać, że wydaje się mieć dobry instynkt, jeśli chodzi o to, komu podać serum z protoframami. Nawet jeśli nie wiem, dlaczego to robi.",shape=box,color=red];
		j3582417954 -> j2880177500;
	j906340060 [label="Wolałbym, żebyś nie pokładała takiego zaufania w Entratim. Nie wiemy, czym się kieruje i jakie ma cele.",shape=box,color=red];
		j906340060 -> j1722407835;
	j372574149 [label="Musimy trzymać się Entratiego. Myślę, że musimy po prostu podążać za nim. On jest naszą jedyną szansą na powstrzymanie Obojętności.",shape=box,color=red];
		j372574149 -> j737842484;
	j345086353 [label="To kłamca, Mario. Porzuca i rani wszystkich w swoim życiu. Nie widzisz, że już Cię porzucił? ",shape=box,color=red];
		j345086353 -> j1591510439;
