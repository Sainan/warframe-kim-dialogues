		j989297039 -> j3363972064 [label="false",color=purple];
	j1547773411 [label="Oui, masz rację. Myślę, że dręczy go poczucie winy za wszystko, co zrobił. Myślę, że umyślnie odsuwa się od innych.",shape=box,color=blue];
		j1547773411 -> j1925347296;
	j3148315036 [label="Oui, to wielka szkoda i ogromny ból. Wiedzieć, że ktoś... nadal żyje, ale nie chce żyć z tobą ?",shape=box,color=blue];
		j3148315036 -> j1925347296;
	j2055325885 [label="Mon cœur se brise dans la tragédie - Nie wiem, czy zdołam sobie poradzić z tym smutkiem... a ona mu nie wybaczyła ?",shape=box,color=blue];
		j2055325885 -> j511636636;
		j2055325885 -> j2800179025;
	j558884585 [label="Wiesz dlaczego odszedł ?",shape=box,color=blue];
		j558884585 -> j511636636;
		j558884585 -> j1131708122;
	j4026689475 [label="Co masz na myśli ?",shape=box,color=blue];
		j4026689475 -> j915930263;
		j4026689475 -> j3921538004;
	j1334610508 [label="Rzeczywiście, jeśli pogłoski wśród Cavii są prawdziwe, vous y avez vraiment trouvé beaucoup de joie, non ?",shape=box,color=blue];
		j1334610508 -> j3965222958;
	j3965222958 [label="Non, le Cardinal postąpił znacznie gorzej wobec wielu innych. Jesteś po prostu zdenerwowany tym, że sprawy nie poszły po Twojej myśli.",shape=box,color=blue];
		j3965222958 -> j1591510439;
	j3502303041 [label="Chciałbym tylko... żeby wszyscy wokół Entratiego przestali obwiniać siebie samych i siebie nawzajem za to, co się stało.",shape=box,color=red];
		j3502303041 -> j2459786529;
	j3265980055 [label="Nie wiem, czy nazwałbym go błogosławionym.",shape=box,color=red];
		j3265980055 -> j1258499589;
	j1768163365 [label="Znacznie łatwiej byłoby mi wybaczyć Entratiemu, gdybym rozumiał jego występki.",shape=box,color=red];
		j1768163365 -> j3551523741;
	j3363972064 [label="Zrobię to, co będzie konieczne, żeby rozwiązać problem. A kiedy to wszystko dobiegnie końca, dopiero wtedy będę go oceniać.",shape=box,color=red];
		j3363972064 -> j2693541248;
	j1925347296 [label="Il inflige la douleur dans le cœur des autres, car la douleur vaut mieux que rien du tout. Bo cierpienie jest lepsze niż pustka, prawda ?",shape=box,color=blue];
		j1925347296 -> j4084291000;
	j511636636 [label="Obawiam się, że kiedy nie daje on żadnego uzasadnienia, zostają nam tylko domysły.",shape=box,color=red];
		j511636636 -> j1511853737;
	j2800179025 [label="Nie o to chodzi. Zostawił mnie tam. Zobaczył kogoś porzuconego w Pustce i... zostawił mnie tam.",shape=box,color=red];
		j2800179025 -> j685392093;
	j1131708122 [label="Nie. Wiem tylko, że mnie tam zostawił. Zobaczył kogoś porzuconego w Pustce i... zostawił mnie tam.",shape=box,color=red];
		j1131708122 -> j1511853737;
	j915930263 [label="Zostawił mnie tam. Przybył w nieznanym mi czasie, zobaczył kogoś porzuconego w Pustce i... zostawił mnie tam.",shape=box,color=red];
		j915930263 -> j685392093;
	j3921538004 [label="Obojętność i tak trafiła do Duviri. (Choć miała niespodziewaną pomoc, ale to nie ma tu znaczenia.)",shape=box,color=red];
		j3921538004 -> j2857584536;
	j2459786529 [label="Boolean MarieEntratiFamily is now true.",color=orange];
		j2459786529 -> j37704559;
	j1258499589 [label="Możemy się więc zgodzić, że pozostaniemy w niezgodzie.",shape=box,color=blue];
		j1258499589 -> j606261055;
	j3551523741 [label="Modlę się, żeby tak się stało. Modlę się, żebyśmy wszyscy zdołali to zobaczyć. Ale na razie widzę wokół siebie rodzinę i modlę się, by zdołali mu przebaczyć, żeby sami mogli zaznać szczęścia.",shape=box,color=blue];
		j3551523741 -> j1969482491;
	j2693541248 [label="+10 Chemistry",color=orange];
		j2693541248 -> j729649421;
	j4084291000 [label="To lekcja, którą mój drogi Leon zna lepiej, niż ktokolwiek inny... Cieszę się, że zaczął z Tobą rozmawiać. Ale dzisiaj rozmawiamy o le Cardinal.",shape=box,color=blue];
		j4084291000 -> j221931327;
	j1511853737 [label="Mogę tylko założyć, że miało to miejsce przed... morderstwem ad infinitum.",shape=box,color=red];
		j1511853737 -> j2145978925;
	j685392093 [label="I nie wiesz, dlaczego Cię tam zostawił ?",shape=box,color=blue];
		j685392093 -> j1960216809;
		j685392093 -> j1511853737;
		j685392093 -> j2584635661;
	j2857584536 [label="Non. Chwila. L'Indifférence ma... sojusznika ?",shape=box,color=blue];
