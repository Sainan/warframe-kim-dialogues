		j221931327 -> j1591510439;
	j2145978925 [label="Dlatego muszę poprosić Cię, żebyś nie zakładał najgorszego. Od tego zgorzknieje Twoje serce. ",shape=box,color=blue];
		j2145978925 -> j2928510904;
	j1960216809 [label="Mogę tylko mieć nadzieję, że miał ku temu dobry powód.",shape=box,color=red];
		j1960216809 -> j570796126;
	j2584635661 [label="Nie, to nie ma znaczenia. Mógł mnie uratować, a tego nie zrobił.",shape=box,color=red];
		j2584635661 -> j1293908090;
	j1278128291 [label="Nosi tylko twarz innej osoby.",shape=box,color=red];
		j1278128291 -> j1590094417;
	j1199744362 [label="Może? Albo zakładnika. Albo po prostu nosi jej twarz. Nie wiemy na pewno.",shape=box,color=red];
