	"Chat ends." [color=orange];
	j966741108 [label="Broń może służyć do obrony, jak i do ataku. Nie podoba mi się, że są one konieczne... ale są.",shape=box,color=red];
		j966741108 -> j2835814170;
	j3811166137 [label="Nie wszyscy, ale ten? Tak. Wciąż są tacy, których nie potępiłbym od razu.",shape=box,color=red];
		j3811166137 -> j3534499833;
	j3830340225 [label="Une horrible toile d'os peinte avec du sang... widzisz ? Ces Orokin, to prawdziwe diabły.",shape=box,color=blue];
		j3830340225 -> j966741108;
		j3830340225 -> j3811166137;
	j3174113682 [label="Jak stara przyjaciółka. Wiem, co lubiła. Wiem, jak się poruszała. Pamiętam dźwięk jej śmiechu na wietrze...",shape=box,color=blue];
		j3174113682 -> j1655283451;
