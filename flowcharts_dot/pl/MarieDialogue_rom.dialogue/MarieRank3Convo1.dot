	1006 [label="Chat ends.",color=orange];
	1007 [label="Być może nie wiedział, czy zdoła Cię z niego wyciągnąć. Obawiał się, że jego delikatna konstrukcja zapadnie się. Może obawiał się, że pod Twoją nieobecność przejmie je l'Indifférence. Peut-être, peut-être, peut-être.",shape=box,color=blue];
