	j1969482491 [label="Boolean MarieEntratiFan2 is now true.",color=orange];
		j1969482491 -> j2817628452;
	j729649421 [label="Oui, c'est raisonnable i całkiem sprawiedliwe, biorąc pod uwagę wszystko, co widziałeś i wiesz. Nie mogłabym prosić Cię o więcej.",shape=box,color=blue];
		j729649421 -> j2317830341;
