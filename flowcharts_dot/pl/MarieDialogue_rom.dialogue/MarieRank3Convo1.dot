	j1152002378 [label="Słyszałam tylko o Pladze i nie wiem o niej wiele... ale wierzę Ci. Modlę się, żeby to co mówisz było prawdą i mam nadzieję, że nie jest uwięziona.",shape=box,color=blue];
		j1152002378 -> j4255157744;
	j895577610 [label="To miłe, że tak mówisz. Jeśli to co czuję jest prawdziwe, i modlę się, żeby było, wtedy miałbyś rację. Nie uważam, żeby była uwięziona.",shape=box,color=blue];
		j895577610 -> j4255157744;
	j1755590359 [label="Modlę się, żeby to co czuję, było prawdziwe. Non, nie sądzę, żeby była uwięziona.",shape=box,color=blue];
		j1755590359 -> j4255157744;
	j2471089691 [label="Modlę się, żeby to co czuję, było prawdziwe. Oui, wtedy miałbyś rację. Zostają z nami, by nam pomóc. Nie sądzę, żeby była uwięziona.",shape=box,color=blue];
		j2471089691 -> j4255157744;
	j2396154087 [label="Oui, zostałam błogosławiona przez le Cardinal... ale wiem, że moja miłość do niego jest wyjątkowa, nieskażona smutkiem, nienawiścią czy urazą.",shape=box,color=blue];
		j2396154087 -> j1031358356;
	j3030197931 [label="Wiem, że widzisz w nim strasznego potwora. Ale muszę zapytać, co sprawiło, że tak mu nie ufasz ?",shape=box,color=blue];
		j3030197931 -> j2531240598;
		j3030197931 -> j3625749966;
		j3030197931 -> j3620685202;
	j1755534103 [label="Myślałam, że w niego wierzysz ? Skąd ta zmiana ? Dlaczego jesteś taki kapryśny ? ",shape=box,color=blue];
		j1755534103 -> j255526850;
		j1755534103 -> j1149995656;
	j2669114596 [label="Skąd w Tobie ten brak wiary ?",shape=box,color=blue];
		j2669114596 -> j2531240598;
		j2669114596 -> j3620685202;
		j2669114596 -> j3625749966;
	j3177999586 [label="Oui, i znów tak prędko zmieniasz zdanie ? Kłamiesz. W jakim celu, nie wiem. Et je ne veux pas le savoir.",shape=box,color=blue];
		j3177999586 -> j1508231473;
	j2932272479 [label="+5 Chemistry",color=orange];
		j2932272479 -> j1031309967;
	j149021885 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j149021885 -> j1031309967;
	j2646201334 [label="Ci z nas, którzy obrali ścieżkę Sol, muszą zawsze być światłem latarni dla tych, którzy znaleźli się na rozdrożach, non ? ",shape=box,color=blue];
		j2646201334 -> j655091104;
	j2147439953 [label="Jesteś wyznawcą Lua. Pamiętasz nauki, które mówią, że niektórzy muszą samotnie kroczyć wśród cieni, oui ?",shape=box,color=blue];
		j2147439953 -> j655091104;
	j925539277 [label="Jesteś wyznawcą Świetlistych. Pamiętasz, jak brzmią nauki o tych, którzy samotnie kroczą nieznanymi drogami, oui ?",shape=box,color=blue];
		j925539277 -> j655091104;
	j3921648813 [label="W mojej wierze znamy ludzi, którzy wędrują drogami życia i znajdują się na rozdrożu, gdzie spotykają się Lua i Sol. ",shape=box,color=blue];
		j3921648813 -> j655091104;
	j4255157744 [label="Czuję jedynie jej ciepły uśmiech Sol na sobie. Uważam, że le Cardinal podjął mądrą decyzję. Jestem zaszczycona mogąc ugościć ją w swoim ciele.",shape=box,color=blue];
		j4255157744 -> j345086353;
		j4255157744 -> j372574149;
		j4255157744 -> j3582417954;
		j4255157744 -> j906340060;
	j1031358356 [label="Wybaczam mu to, że nas opuścił. Ale chyba jestem w tym sama...",shape=box,color=blue];
		j1031358356 -> j3715314897;
		j1031358356 -> j3236105287;
		j1031358356 -> j2531240598;
		j1031358356 -> j3620685202;
	j2531240598 [label="On... pojawił się w Duviri. Dawno, dawno temu...",shape=box,color=red];
		j2531240598 -> j1908020713;
	j3625749966 [label="Zacznijmy od tego, że postrzelił mnie i zostawił na śmierć.",shape=box,color=red];
		j3625749966 -> j3606324833;
	j3620685202 [label="Zostawia po sobie jedynie ból, śmierć i porzucenie.",shape=box,color=red];
		j3620685202 -> j1591510439;
	j255526850 [label="Nigdy mu nie ufałem, po prostu nie chciałem Cię odstraszyć.",shape=box,color=red];
		j255526850 -> j3992737367;
	j1149995656 [label="Nie chciałem kłamać, ale nie wiedziałem, jak podejść do tematu. Widać, że go uwielbiasz...",shape=box,color=red];
		j1149995656 -> j4112083659;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j1031309967 [label="Tak, musimy pozostać silni ! Braves contre les ténèbres, pour toujours et à jamais !",shape=box,color=blue];
		j1031309967 -> j3809941687;
	j655091104 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j655091104 -> j4110961960;
	j3715314897 [label="Masz rację, zranił i porzucił wielu ludzi. I myślę, że uważał to za konieczne.",shape=box,color=red];
		j3715314897 -> j1994035469;
	j3236105287 [label="To trudne, gdy ktoś, kto tak wiele dla Ciebie znaczy - ktoś, kogo kochasz i na kim polegasz - odchodzi. Szczególnie, kiedy nie wiesz dlaczego. Albo czy w ogóle powróci.",shape=box,color=red];
		j3236105287 -> j3131390647;
	j1908020713 [label="Na Sol ! Świat, który stworzyłeś, wywołałeś z książki napisanej przez córkę, oui ? Monsieur Loid opowiedział mi o nim... Był w nim le Cardinal ? Dlaczego ? ",shape=box,color=blue];
		j1908020713 -> j79718505;
		j1908020713 -> j3832196047;
		j1908020713 -> j1618176959;
	j3606324833 [label="Et pourtant, vous êtes toujours en vie ! Ale żyjesz, czyż nie ? I masz się dobrze ? Rozwijasz się, jeśli wierzyć opowieściom Monsieur Loida o Twoich podróżach w nadchodzącą przeszłość.",shape=box,color=blue];
		j3606324833 -> j4231093281;
	j3992737367 [label="Ah, je vois ! Je suis une idiote, c'est ça ?! Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même ?! Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer !",shape=box,color=blue];
		j3992737367 -> j2523403966;
	j4112083659 [label="Ach, oui... Nie ułatwiałam Ci wypowiedzieć się szczerze, n'est-ce pas ?",shape=box,color=blue];
		j4112083659 -> j1329066785;
	j3809941687 [label="Wybaczyłam mu to, że nas opuścił. Ale chyba jestem w tym sama...",shape=box,color=blue];
		j3809941687 -> j3715314897;
		j3809941687 -> j3236105287;
	j4110961960 [label="Le Cardinal musi odnaleźć swoją drogę powrotną do nas. Możemy mu pomóc tylko wtedy, kiedy nas wezwie i postępować tak, jak każą nam inni, błogosławieni tak jak on.",shape=box,color=blue];
		j4110961960 -> j989297039;
	j1994035469 [label="+5 Chemistry",color=orange];
		j1994035469 -> j1547773411;
	j3131390647 [label="+5 Chemistry",color=orange];
		j3131390647 -> j3148315036;
	j79718505 [label="Myślę, że na początku jakaś część niego szukała tam fragmentu córki, którą pozostawił. Zamiast tego wdał się w bójkę z Obojętnością - z uczuciami, przed którymi chciał uciec.",shape=box,color=red];
		j79718505 -> j2055325885;
	j3832196047 [label="Jego zapiski opowiadają niezwykle irytującą, samochwalną historię tego, jak wyruszył, by badać urzeczywistnienie idei, a zamiast tego dowiedział się, jak ważna jest walka z Obojętnością.",shape=box,color=red];
		j3832196047 -> j558884585;
	j1618176959 [label="Jeśli wierzyć jego notatkom, chciał nauczyć Duviri - a co za tym idzie, mnie - jak bronić się przed Obojętnością. I co z tego ostatecznie wyszło?",shape=box,color=red];
		j1618176959 -> j4026689475;
	j4231093281 [label="Check boolean IsDating",color=orange];
		j4231093281 -> j1334610508 [label=true,color=green];
		j4231093281 -> j3965222958 [label=false,color=brown];
	j2523403966 [label="Va t'asseoir sur une ruche.",shape=box,color=blue];
		j2523403966 -> j1508231473;
	j1329066785 [label="Powiedz mi więc prawdę, wilku. Dlaczego uważasz, że nie można mu ufać ? A ja postaram się zachować spokój.",shape=box,color=blue];
		j1329066785 -> j3236105287;
		j1329066785 -> j2531240598;
