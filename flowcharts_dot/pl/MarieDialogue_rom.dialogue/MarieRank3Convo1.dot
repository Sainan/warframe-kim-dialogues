		j2090881962 -> j3045448544;
	j210846889 [label="Vraiment ? Czy te zapisy przepadły z czasem, czy podejrzewasz, że nikt nie uznał je za wystarczająco ważne, by je zapisać ?",shape=box,color=blue];
