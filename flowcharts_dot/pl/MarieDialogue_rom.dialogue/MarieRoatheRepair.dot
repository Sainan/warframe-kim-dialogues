	j796645181 [label="To właśnie jasność umysłu Loida pozwoliła mi dostrzec to, czego ja nie widziałam przez chmury wewnątrz swojego. Loid kocha le Cardinal, swojego Albrechta, a mimo to wciąż dostrzega jego wady.",shape=box,color=blue];
		j796645181 -> j3324009705;
	j2035158763 [label="Tak. On go kocha. Ale wciąż dostrzega jego wady. I to właśnie jasność jego umysłu pozwoliła mi dostrzec to, czego ja nie widziałam przez chmury wewnątrz swojego.",shape=box,color=blue];
