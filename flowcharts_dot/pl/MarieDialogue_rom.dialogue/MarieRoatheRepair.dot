		j1733718244 -> j4052604918;
	j2459408689 [label="I muszę przyznać... że zaczyna męczyć mnie bycie uwięzioną tu na dole sans recours.",shape=box,color=blue];
		j2459408689 -> j557563087;
	j2573574000 [label="Ale to nie jego słowom, ale jego sprytowi powinniśmy być wdzięczni. Posadził mnie razem z Monsieur Loidem.",shape=box,color=blue];
