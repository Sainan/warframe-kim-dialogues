digraph {
	2427 [label="MarieRank5Convo1 begins.",color=orange];
		2427 -> 2428;
	2428 [label="Możemy porozmawiać ?",shape=box,color=blue];
		2428 -> 2429;
	2429 [label="Evaluate expressions",color=orange];
		2429 -> 2430 [label="MarieEntrati4a",color=purple];
		2429 -> 2431 [label="MarieEntrati4b",color=purple];
		2429 -> 2432 [label="MarieEntrati3a",color=purple];
		2429 -> 2433 [label="MarieEntrati3b",color=purple];
		2429 -> 2434 [label="MarieEntrati3",color=purple];
		2429 -> 2435 [label="false",color=purple];
	2430 [label="Zastanawiałam się nad tym, co powiedziałeś o le Cardinal. Że jego działania to... \"mieszanka\" dobra i zła.",shape=box,color=blue];
		2430 -> 2436;
	2431 [label="Rozmyślałam nad twoimi słowami o le Cardinal. Że jego działania przyniosły Leonowi ból.",shape=box,color=blue];
		2431 -> 2436;
	2432 [label="Długo rozmyślałam nad naszą rozmową dotyczącą M'sieur Tagfera i nad twoim przekonującym wyjaśnieniem, dlaczego tak nienawidzi le Cardinal.",shape=box,color=blue];
		2432 -> 2436;
	2433 [label="Długo rozmyślałam nad moją kłótnią z M'sieur Tagferem i nad powodami, dla których tak gardzi le Cardinal.",shape=box,color=blue];
		2433 -> 2436;
	2434 [label="Długo rozmyślałam nad moją kłótnią z M'sieur Tagferem. I nad naszą kłótnią na ten temat.",shape=box,color=blue];
		2434 -> 2436;
	2435 [label="Czuję, że wiele zostało niedopowiedziane na temat le Cardinal. Pozostali zdają się chodzić wokół mnie jak na paluszkach, bojąc się o nim wspomnieć.",shape=box,color=blue];
		2435 -> 2436;
	2436 [label="Wiem, że inni chcieliby go przedstawić jako szaleńca i zdrajcę. Ale dla mnie był kimś innym.",shape=box,color=blue];
		2436 -> 2437;
	2437 [label="Check boolean MarieBackstory1",color=orange];
		2437 -> 2439 [label=true,color=green];
		2437 -> 2438 [label=false,color=brown];
	2439 [label="Może to dlatego, że jestem przyzwyczajona do bycia porzucaną. ",shape=box,color=blue];
		2439 -> 2440;
	2438 [label="Zostałam porzucona przez rodzinę, wyrzucona na ulicę, gdy byłam dzieckiem, ponieważ byłam... niezwykła. Niepełna. Niepasujący do wyższych sfer.",shape=box,color=blue];
		2438 -> 2440;
	2440 [label="Może to dlatego, że nigdy nie miałam ojca i dlatego jestem tak skłonna wybaczyć mu jego nieobecność.",shape=box,color=blue];
		2440 -> 2441;
	2441 [label="Evaluate expressions",color=orange];
		2441 -> 2442 [label="MarieEntrati4a",color=purple];
		2441 -> 2443 [label="MarieEntrati4b",color=purple];
		2441 -> 2444 [label="MarieEntrati3a",color=purple];
		2441 -> 2445 [label="MarieEntrati3b",color=purple];
		2441 -> 2446 [label="MarieEntrati3",color=purple];
		2441 -> 2447 [label="false",color=purple];
	2442 [label="Ale fakt pozostaje taki, że mu wybaczam. Bo widzę więcej wartości w jego dobrych uczynkach niż w złych.",shape=box,color=blue];
		2442 -> 2448;
		2442 -> 2449;
		2442 -> 2450;
		2442 -> 2451;
		2442 -> 2452;
	2443 [label="Modlę się, aby Leon okazał się silny i przetrwał kryzys wiary, którego doświadcza, ale nie sądzę, aby była to wyłącznie wina le Cardinal.",shape=box,color=blue];
		2443 -> 2448;
		2443 -> 2449;
		2443 -> 2450;
		2443 -> 2453;
		2443 -> 2454;
	2444 [label="Choć doceniam twoje argumenty dotyczące M'sieur Tagfera i tych, którzy zostali przez niego skrzywdzeni, nadal dostrzegam większą wartość w jego dobrych uczynkach niż w złych.",shape=box,color=blue];
		2444 -> 2448;
		2444 -> 2449;
		2444 -> 2450;
		2444 -> 2455;
		2444 -> 2456;
	2445 [label="Choć więc rozumiem gniew M'sieur Tagfera i rozumiem jego argumenty, musi on znaleźć w sobie siłę, by wybaczyć le Cardinal. Widzę bowiem więcej wartości w jego dobrych uczynkach niż w tych złych.",shape=box,color=blue];
		2445 -> 2448;
		2445 -> 2449;
		2445 -> 2450;
		2445 -> 2457;
		2445 -> 2458;
	2446 [label="Choć cenię historię każdego z nas związaną z le Cardinal, zwłaszcza M'sieur Tagfera, wciąż bardziej cenię jego dobre uczynki, niż skupiam się na tych złych.",shape=box,color=blue];
		2446 -> 2448;
		2446 -> 2449;
		2446 -> 2450;
		2446 -> 2459;
	2447 [label="Choć cenię historię każdego z nas związaną z le Cardinal, wciąż bardziej cenię jego dobre uczynki, niż skupiam się na tych złych.",shape=box,color=blue];
		2447 -> 2448;
		2447 -> 2449;
		2447 -> 2450;
	2448 [label="Nie winię cię za to, że doceniasz dobro, które zrobił w twoim życiu, tak samo jak nie winię innych ludzi za to, że czują się urażeni krzywdą, jaką wyrządza w ich życiu.",shape=box,color=red];
		2448 -> 2460;
	2449 [label="Nie wiem. Myślę, że jego działania przyniosły o wiele więcej szkody niż pożytku. Chciałabym, żebyś to zobaczył.",shape=box,color=red];
		2449 -> 2461;
	2450 [label="Zgadzam się z tobą. Nie mogę winić Entratiego za jego czyny. Walczy z Obojętnością.",shape=box,color=red];
		2450 -> 2462;
	2451 [label="Masz rację, że nie żywisz urazy do Entratiego. Chciałbym, żeby inni poszli w twoje ślady.",shape=box,color=red];
		2451 -> 2462;
	2452 [label="Nigdy nie będę winić nikogo za wybaczenie. Ale można komuś wybaczyć, rozumiejąc, że trzeba chronić przed tą osobą siebie i innych.",shape=box,color=red];
		2452 -> 2463;
	2453 [label="Uważasz, że cierpienie Leona jest jego własną winą?",shape=box,color=red];
		2453 -> 2464;
	2454 [label="Leon przeżywa więcej kryzys wiary, Marii. I wiele z tego ma związek z Entratim.",shape=box,color=red];
		2454 -> 2461;
	2455 [label="Czy nic z tego, co powiedziałem, nie zmieniło twojego punktu widzenia?",shape=box,color=red];
		2455 -> 2465;
	2456 [label="Jak możesz patrzeć na wszystko, co zrobił Entrati i nadal widzieć więcej dobra niż zła?",shape=box,color=red];
		2456 -> 2461;
	2457 [label="Myślę, że bagatelizujesz powagę cierpień Cavii i Tagfera.",shape=box,color=red];
		2457 -> 2461;
	2458 [label="Wybaczenie jest ważne. Ale równie ważne jest zrozumienie, że Entrati może być bardziej skomplikowany, niż jesteś zdolna przyznać.",shape=box,color=red];
		2458 -> 2465;
	2459 [label="Nadal nie sądzę, żebyś rozumiała, co przeżyli Tagfer i Cavia. To gorsze niż to, co ty przeżyłaś.",shape=box,color=red];
		2459 -> 2461;
	2460 [label="Ale czy widzisz, że te dwie rzeczy nie mają równej wartości ? Uraza i głębokie uznanie ? Życzę sobie, żeby inni porzuciły swoje złośliwe urazy.",shape=box,color=blue];
		2460 -> 2466;
		2460 -> 2467;
	2461 [label="Evaluate expressions",color=orange];
		2461 -> 2469 [label="MarieEntratiMonster1",color=purple];
		2461 -> 2469 [label="MarieEntratiMonster2",color=purple];
		2461 -> 2468 [label="MarieEntratiFan1",color=purple];
		2461 -> 2468 [label="MarieEntratiFan2",color=purple];
		2461 -> 2470 [label="false",color=purple];
	2462 [label="Evaluate expressions",color=orange];
		2462 -> 2473 [label="MarieEntratiMonster1",color=purple];
		2462 -> 2473 [label="MarieEntratiMonster2",color=purple];
		2462 -> 2471 [label="MarieEntratiFan1",color=purple];
		2462 -> 2471 [label="MarieEntratiFan2",color=purple];
		2462 -> 2472 [label="false",color=purple];
	2463 [label="I to właśnie sugerujesz, żebyśmy zrobili ? Wygnać le Cardinal ? Ale chyba już sam to zrobił, non ?",shape=box,color=blue];
		2463 -> 2474;
		2463 -> 2467;
	2464 [label="Myślę, że Leon cierpi na wiele dolegliwości, z których wiele wynika z wątpliwości co do samego siebie i własnego umysłu. Wydaje się, że le Cardinal... tylko pogorszył sytuację.",shape=box,color=blue];
		2464 -> 2475;
		2464 -> 2467;
	2465 [label="Co mam zrobić ? Spalić kukłę le Cardinal i go odrzucić ? Skazać go na Pustkę, życzyć mu źle, jak M'sieur Tagfer ?",shape=box,color=blue];
		2465 -> 2474;
		2465 -> 2467;
	2466 [label="W tym tkwi problem, Mario. O to, czego oczekujesz od innych. Nie o to, czego oczekują od ciebie. Albo od Entratiego.",shape=box,color=red];
		2466 -> 2476;
	2467 [label="Gdziekolwiek Entrati nie pójdzie, zostawia za sobą złamane serca. Ja tylko próbuję pomóc tym ludziom poskładać wszystko do kupy. W jego przypadku nie obchodzi mnie zbytnio, czy to dla \"dobra\", czy \"zła\".",shape=box,color=red];
		2467 -> 2477;
	2469 [label="Oui, i jesteś tak niezmienny w swojej nienawiści do niego ! Czy nic z tego, co powiedziałam, nie zmieniło twojego zdania o le Cardinal ?",shape=box,color=blue];
		2469 -> 2482;
	2468 [label="Czyż nie mówiłeś mi o tym, jak wielbiłeś Entratiego, tak jak ja, zaledwie przed chwilą ? Co zmieniło twoje zdanie ?",shape=box,color=blue];
		2468 -> 2478;
		2468 -> 2479;
		2468 -> 2480;
		2468 -> 2481;
	2470 [label="Oui, a ty najwyraźniej uważasz Entratiego za takiego potwora ! Tak szybko odrzucasz jego dobroć!",shape=box,color=blue];
		2470 -> 2482;
	2473 [label="Czyż nie mówiłeś mi o monstruosité Entratiego zaledwie chwilę temu ? Co zmieniło twoje zdanie ?",shape=box,color=blue];
		2473 -> 2478;
		2473 -> 2479;
		2473 -> 2480;
		2473 -> 2481;
	2471 [label="Merci, byłeś moim wiernym towarzyszem w tej krucjacie ! Obawiam się, że jesteśmy w tym osamotnieni – nawet Monsieur Loid także żywi urazę...",shape=box,color=blue];
		2471 -> 2483;
	2472 [label="Merci, i cieszę się, że to słyszę ! Obawiam się, że jesteśmy w tym osamotnieni – nawet Monsieur Loid także żywi urazę...",shape=box,color=blue];
		2472 -> 2483;
	2474 [label="Myślę, że problemem jest raczej to, czego wymagasz od innych, a nie to, czego oni wymagają od ciebie. Albo Entratiego.",shape=box,color=red];
		2474 -> 2476;
	2475 [label="I nie przeszkadza ci to?",shape=box,color=red];
		2475 -> 2484;
	2476 [label="A czegoż to tak groteskowego oczekuję od innych ? Aby pozwolili sobie przebaczyć ?",shape=box,color=blue];
		2476 -> 2485;
		2476 -> 2486;
	2477 [label="Szlachetne, choć męczące, podróżowanie w czasie i przestrzeni, wspomagając swoje mécontents, non ? Z pewnością musisz mieć do niego o to żal...",shape=box,color=blue];
		2477 -> 2487;
		2477 -> 2488;
	2482 [label="Ta rozmowa była błędem...",shape=box,color=blue];
		2482 -> 2493;
		2482 -> 2494;
	2478 [label="Szczerze mówiąc, miałem problem z poruszaniem tego tematu z tobą. Osobiście uważam, że on... ani dobry, ani zły. Raczej trochę tego i tamtego.",shape=box,color=red];
		2478 -> 2489;
	2479 [label="Zmieniłem zdanie. Jestem po jego stronie. I po twojej. Przekonałeś mnie.",shape=box,color=red];
		2479 -> 2490;
	2480 [label="[Wyznaj uczucia] Po prostu starałem się zrobić wszystko, co w mojej mocy, żeby... spełnić twoje oczekiwania. Zakochałem się w tobie, ale nie dawałem tego po sobie poznać.",shape=box,color=red];
		2480 -> 2491;
	2481 [label="Zmieniłem zdanie i uznałem, że jest potworem. Raz na zawsze.",shape=box,color=red];
		2481 -> 2492;
	2483 [label="Być może razem zdołamy stawić czoła tym, którzy chcieliby splamić jego dobre uczynki, oui ? Ale zastanawiam się, we wszystkim, co cię otacza... dlaczego stajesz po mojej stronie ?",shape=box,color=blue];
		2483 -> 2495;
	2484 [label="Check boolean LyonDating",color=orange];
		2484 -> 2496 [label=true,color=green];
		2484 -> 2497 [label=false,color=brown];
	2485 [label="Postawiłaś Entratiego na piedestale. I prosisz innych, żeby zrobili to samo, jak idioci.",shape=box,color=red];
		2485 -> 2498;
	2486 [label="Myślę, że prosisz ich o coś więcej niż tylko o wybaczenie Entratiemu. Myślę, że prosisz ich, żeby udawali, że nie zrobił niczego złego.",shape=box,color=red];
		2486 -> 2499;
	2487 [label="Tak. Ale to też jemu zawdzięczam jedne z najważniejszych relacji i przyjaźni, jakie kiedykolwiek nawiązałam.",shape=box,color=red];
		2487 -> 2500;
	2488 [label="Nie, nie do końca. On tego ode mnie oczekuje, więc to robię. Osądzę go, kiedy będzie już po wszystkim.",shape=box,color=red];
		2488 -> 2500;
	2493 [label="Zaczekaj chwilę, Mario, pozwól mi to wyjaśnić.",shape=box,color=red];
		2493 -> 2505;
		2493 -> 2506;
		2493 -> 2507;
		2493 -> 2508;
	2494 [label="Jasno wyraziłem, co myślę o Entratim. Przepraszam. W niektórych kwestiach nie możemy się zgodzić.",shape=box,color=red];
		2494 -> 2509;
	2489 [label="Update boolean MarieEntratiMonster1",color=orange];
		2489 -> 2501;
	2490 [label="Update boolean MarieEntratiMonster1",color=orange];
		2490 -> 2502;
	2491 [label="Update boolean DrifterMarieWhoops",color=orange];
		2491 -> 2503;
	2492 [label="Update boolean MarieEntratiFan1",color=orange];
		2492 -> 2504;
	2495 [label="Nie, żebym narzekała !",shape=box,color=blue];
		2495 -> 2510;
		2495 -> 2511;
		2495 -> 2512;
	2496 [label="Wiem, że znalazł miejsce w twoim sercu i jestem za to naprawdę wdzięczna – może w końcu przestanę się o niego martwić, a wszystkie te kłótnie wkrótce okażą się nie mieć znaczenia...",shape=box,color=blue];
		2496 -> 2497;
	2497 [label="Ale oczywiście, że mnie to dręczy. On jest bratem mojej duszy ! Mój Leon jest dla mnie najdroższy na świecie, a widok jego cierpienia rani moje serce, jakby jego cierpienie było moim własnym.",shape=box,color=blue];
		2497 -> 2513;
	2498 [label="Rozważnie dobieraj słowa, Włóczęgo.",shape=box,color=blue];
		2498 -> 2514;
	2499 [label="Je ne suis pas naïve, więc nie traktuj mnie w taki sposób !",shape=box,color=blue];
		2499 -> 2515;
	2500 [label="Być może krzywdzi się trucizną tylko po to, by jego ciało mogło się zagoić, a to wszystko jest po prostu koniecznym okrucieństwem.",shape=box,color=blue];
		2500 -> 2516;
		2500 -> 2517;
	2505 [label="[Wyznaj uczucia] Zależy mi na tobie. Bardziej, niż dałem po sobie poznać. I... przepraszam, że byłem tak ostry, ale nie mogę pozwolić mu cię skrzywdzić. Nie tak, jak skrzywdził tylu innych.",shape=box,color=red];
		2505 -> 2523;
	2506 [label="Widziałem, jak Entrati nie robił nic innego, tylko ranił wszystkich, na których mu zależało. Wszystkich, których rzekomo kochał. Nie chcę, żeby skrzywdził cię tak samo...",shape=box,color=red];
		2506 -> 2524;
	2507 [label="Czasami ciężko jest mi się właściwie wysłowić, za co przepraszam, ale on... obawiam się, że on cię wykorzystuje. Nadużywa twojej dobroci, żeby tobą manipulować. To wszystko.",shape=box,color=red];
		2507 -> 2525;
	2508 [label="Możesz postrzegać Entratiego jako zbawiciela, ale ja widzę go jako starego, przestraszonego człowieka, który szuka odpowiedzi. Może odpowiedź leży gdzieś pośrodku.",shape=box,color=red];
		2508 -> 2498;
	2509 [label="Oui, na to wygląda.",shape=box,color=blue];
		2509 -> 2526;
	2501 [label="Update boolean MarieEntratiMonster2",color=orange];
		2501 -> 2518;
	2502 [label="Update boolean MarieEntratiMonster2",color=orange];
		2502 -> 2519;
	2503 [label="I postanowiłeś mnie oszukać, żeby wpaść w moje łaski... je vois.",shape=box,color=blue];
		2503 -> 2520;
		2503 -> 2521;
	2504 [label="Update boolean MarieEntratiFan2",color=orange];
		2504 -> 2522;
	2510 [label="[Wyznaj uczucia] Zależy mi na tobie. Bardziej, niż dałem po sobie poznać.",shape=box,color=red];
		2510 -> 2527;
	2511 [label="Wierzę, że w tej wojnie wszystko jest dopuszczalne. Przecież próbujemy ratować wszechświat przed Obojętnością, prawda?",shape=box,color=red];
		2511 -> 2528;
	2512 [label="Wierzę w Entratiego. Naprawdę. Myślę, że ma plan, jak to rozwiązać, i że wszystko to służy większemu celowi.",shape=box,color=red];
		2512 -> 2529;
	2513 [label="Ale jego upadek wiary nie jest dziełem le Cardinal. Jego fundamenty już były popękane. Po prostu załamały się pod naciskiem, oui ?",shape=box,color=blue];
		2513 -> 2500;
	2514 [label="Update boolean MarieWarning",color=orange];
		2514 -> 2499;
	2515 [label="Dobrze wiem, że le Cardinal kroczy jednocześnie drogami Lua i Sol – światłem i ciemnością – dobrem i złem. Nie jest ani jednym, ani drugim, a jednocześnie jest zdolny zarówno do dobroci, jak i okrucieństwa.",shape=box,color=blue];
		2515 -> 2530;
		2515 -> 2531;
	2516 [label="Dlatego inni się denerwują, kiedy o nim mówisz. Ignorujesz wszystko, co zrobił, co ich zraniło, i udajesz, że nic się nie stało.",shape=box,color=red];
		2516 -> 2498;
	2517 [label="Mario, przestań. Musisz zrozumieć, że on nie robi tego z dobroci własnego serca. Entrati jest bardziej skomplikowany.",shape=box,color=red];
		2517 -> 2499;
	2523 [label="Update boolean DrifterMarie",color=orange];
		2523 -> 2536;
	2524 [label="Rozważnie dobieraj słowa, Włóczęgo.",shape=box,color=blue];
		2524 -> 2537;
	2525 [label="Nie musisz się o mnie tak troszczyć ! Je ne suis pas une enfant naïve !",shape=box,color=blue];
		2525 -> 2538;
	2526 [label="Update boolean MarieEntrati5g",color=orange];
		2526 -> 2539;
	2518 [label="Update boolean MarieEntratiFan1",color=orange];
		2518 -> 2532;
	2519 [label="Update boolean MarieEntratiFan2",color=orange];
		2519 -> 2533;
	2520 [label="Kiedy tak to przedstawiasz...",shape=box,color=red];
		2520 -> 2534;
	2521 [label="Tylko częściowo.",shape=box,color=red];
		2521 -> 2534;
	2522 [label="Update boolean MarieEntratiMonster2",color=orange];
		2522 -> 2535;
	2527 [label="Update boolean DrifterMarieWhoops",color=orange];
		2527 -> 2540;
	2528 [label="Oui ! Dokładnie ! Nareszcie ktoś rozsądny. Serce mi pęka na myśl, że w tej wojnie cierpią niewinni, ale na szali leży cały świat. ",shape=box,color=blue];
		2528 -> 2541;
	2529 [label="Update boolean MarieWillDate",color=orange];
		2529 -> 2542;
	2530 [label="Mario, żaden z niego bóg. Jest tylko człowiekiem. Jest arogantem i równie niebezpieczny, co Roathe. Pochodzi z tego samego społeczeństwa i zmaga się z tymi samymi problemami.",shape=box,color=red];
		2530 -> 2543;
	2531 [label="Wiem, że okazał ci dobroć. Wiem, że potraktował cię inaczej, niż wielu innych ludzi. Może nawet potraktował cię jak córkę... ale spójrz na to z szerszej perspektywy, proszę.",shape=box,color=red];
		2531 -> 2544;
	2536 [label="Nie wiem, jak mam zareagować na tę wiadomość, biorąc pod uwagę... biorąc pod uwagę naszą obecną rozmowę. Jestem... tym bardzo zaskoczona. ",shape=box,color=blue];
		2536 -> 2549;
	2537 [label="Update boolean MarieWarning",color=orange];
		2537 -> 2525;
	2538 [label="Dobrze wiem, że le Cardinal kroczy jednocześnie drogami Lua i Sol – światłem i ciemnością – dobrem i złem. Nie jest ani jednym, ani drugim, a jednocześnie jest zdolny zarówno do dobroci, jak i okrucieństwa.",shape=box,color=blue];
		2538 -> 2531;
		2538 -> 2530;
	2539 [label="Chat ends. Next chat will be MarieEntratiDay2.",color=orange];
	2532 [label="Update boolean MarieEntratiFan2",color=orange];
		2532 -> 2545;
	2533 [label="Oui ? Jestem... pełna nadziei, ale pozostaję nieprzekonana. Uważniej dobieraj swoje słowa, Włóczęgo...",shape=box,color=blue];
		2533 -> 2546;
	2534 [label="Update boolean MarieNoDate",color=orange];
		2534 -> 2547;
	2535 [label="Oui ? Uważasz mnie za dziecko, czy za głupca ? Uważniej dobieraj swoje słowa, Włóczęgo...",shape=box,color=blue];
		2535 -> 2548;
	2540 [label="A ty stanąłeś po stronie le Cardinal, żeby wkupić się w moje łaski... je vois.",shape=box,color=blue];
		2540 -> 2550;
		2540 -> 2551;
	2541 [label="A podczas wojny cierpią niewinni. To smutne, ale prawdziwe, non ?",shape=box,color=blue];
		2541 -> 2552;
		2541 -> 2553;
	2542 [label="Update boolean MarieFamilyFail",color=orange];
		2542 -> 2554;
	2543 [label="To człowiek, który przywołał – a może nawet stworzył – boga! A teraz jest jedynym, który stoi między tym a zniszczeniem naszego wszechświata!",shape=box,color=blue];
		2543 -> 2555;
	2544 [label="Myślisz, że nie wiem, że nie byłam jedyną \"córką\", którą porzucił ?! Jestem po prostu jedyną, która wybacza !",shape=box,color=blue];
		2544 -> 2556;
		2544 -> 2557;
	2549 [label="Naprawdę ?! Mówisz poważnie ?! W ten sposób ?! Teraz ?! Vraiment ?!",shape=box,color=blue];
		2549 -> 2560;
	2545 [label="Oui ? Wybaczę ci to kłamstwo, ale uznaj to za ostrzeżenie. Uważniej dobieraj słowa, Włóczęgo...",shape=box,color=blue];
		2545 -> 2558;
