	2550 [label="Kiedy tak to przedstawiasz...",shape=box,color=red];
		2550 -> 2561;
	2551 [label="Tylko częściowo. Szczerze wierzę w Entratiego.",shape=box,color=red];
		2551 -> 2561;
	2552 [label="Dokładnie. Roathe byłby z ciebie dumny.",shape=box,color=red];
		2552 -> 2562;
	2553 [label="Ile świętych krucjat zostało przeprowadzonych w imię Sol? Czymże jest jeszcze jedna, prawda?",shape=box,color=red];
		2553 -> 2563;
	2554 [label="Add -10 to Family",color=orange];
		2554 -> 2564;
	2555 [label="Chyba tylko ja pamiętam, o co tu walczymy !",shape=box,color=blue];
		2555 -> 2565;
		2555 -> 2557;
	2556 [label="To niebezpieczne założenie, którego nie możesz być pewna. Nigdy jej nie poznałaś, nie masz pojęcia, przez co przeszła. Nie masz pojęcia, jak wygląda jej życie.",shape=box,color=red];
		2556 -> 2566;
	2557 [label="I myślisz, że dzięki temu pokocha cię bardziej? Myślisz, że wróci do ciebie, jeśli pozostaniesz mu wierna?",shape=box,color=red];
		2557 -> 2567;
	2560 [label="Nie... nie mogę kontynuować tej rozmowy. Przepraszam. Porozmawiamy jutro, muszę pozbierać swoje myśli.",shape=box,color=blue];
		2560 -> 2569;
