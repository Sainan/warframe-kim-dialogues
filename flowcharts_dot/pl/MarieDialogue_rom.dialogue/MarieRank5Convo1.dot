		2574 -> 2582;
	2575 [label="Nawet Monsieur Loid, który twierdzi, że go kocha, nie może powstrzymać się od ubolewania nad jego okrucieństwem przy każdej okazji !",shape=box,color=blue];
		2575 -> 2583;
