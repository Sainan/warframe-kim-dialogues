		2562 -> 2571;
	2563 [label="Nie... nie to miałam na myśli. To nie krucjata, to coś zupełnie innego...",shape=box,color=blue];
		2563 -> 2572;
	2564 [label="Oui ! Précisément. Jestem pewna, że wszyscy zrozumieją z czasem. Cieszę się, że mam kogoś po swojej stronie.",shape=box,color=blue];
		2564 -> 2573;
	2565 [label="Uwierz mi, nie jesteś. Niezliczeni ludzie stracili swoje życia. Mogę wyrecytować listę osób, których życie zostało przez niego zniszczone. Nikt nie zapomniał o Obojętności.",shape=box,color=red];
		2565 -> 2574;
	2566 [label="Jestem pewna, że gdybym ją spotkała, szybko bym się dowiedziała ! Wszyscy tutaj śpieszą się dzielić ze mną cierpieniami, jakie przeżywają z jego powodu ! Nic dziwnego, że le Cardinal nie powraca. Gdybym nim była, też bym nie chciała spędzić tu ani chwili dłużej...",shape=box,color=blue];
		2566 -> 2575;
	2567 [label="Nie uważam, że to by go odstraszyło ! Naprawdę wierzysz, że le Cardinal powróciłby do tego gniazda szerszeni ?! Non ! Na jego miejscu też bym nie chciała spędzić tu ani chwili...",shape=box,color=blue];
		2567 -> 2575;
