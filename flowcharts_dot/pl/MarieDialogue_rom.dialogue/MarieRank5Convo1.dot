	j1763447886 [label="Zastanawiałam się nad tym, co powiedziałeś o le Cardinal. Że jego działania to... \"mieszanka\" dobra i zła.",shape=box,color=blue];
		j1763447886 -> j928288495;
	j2914472513 [label="Rozmyślałam nad twoimi słowami o le Cardinal. Że jego działania przyniosły Leonowi ból.",shape=box,color=blue];
		j2914472513 -> j928288495;
	j1314573458 [label="Długo rozmyślałam nad naszą rozmową dotyczącą M'sieur Tagfera i nad twoim przekonującym wyjaśnieniem, dlaczego tak nienawidzi le Cardinal.",shape=box,color=blue];
		j1314573458 -> j928288495;
	j1705522715 [label="Długo rozmyślałam nad moją kłótnią z M'sieur Tagferem i nad powodami, dla których tak gardzi le Cardinal.",shape=box,color=blue];
		j1705522715 -> j928288495;
	j180831844 [label="Długo rozmyślałam nad moją kłótnią z M'sieur Tagferem. I nad naszą kłótnią na ten temat.",shape=box,color=blue];
		j180831844 -> j928288495;
	j3109188696 [label="Czuję, że wiele zostało niedopowiedziane na temat le Cardinal. Pozostali zdają się chodzić wokół mnie jak na paluszkach, bojąc się o nim wspomnieć.",shape=box,color=blue];
		j3109188696 -> j928288495;
	j928288495 [label="Wiem, że inni chcieliby go przedstawić jako szaleńca i zdrajcę. Ale dla mnie był kimś innym.",shape=box,color=blue];
		j928288495 -> j2718976672;
	j2718976672 [label="Check boolean MarieBackstory1",color=orange];
		j2718976672 -> j2788792935 [label=true,color=green];
		j2718976672 -> j3408090675 [label=false,color=brown];
	j2788792935 [label="Może to dlatego, że jestem przyzwyczajona do bycia porzucaną. ",shape=box,color=blue];
		j2788792935 -> j3239175224;
	j3408090675 [label="Zostałam porzucona przez rodzinę, wyrzucona na ulicę, gdy byłam dzieckiem, ponieważ byłam... niezwykła. Niepełna. Niepasujący do wyższych sfer.",shape=box,color=blue];
		j3408090675 -> j3239175224;
	j3239175224 [label="Może to dlatego, że nigdy nie miałam ojca i dlatego jestem tak skłonna wybaczyć mu jego nieobecność.",shape=box,color=blue];
		j3239175224 -> j4106479212;
	j4106479212 [label="Evaluate expressions",color=orange];
		j4106479212 -> j3811336081 [label="MarieEntrati4a",color=purple];
		j4106479212 -> j3792237862 [label="MarieEntrati4b",color=purple];
		j4106479212 -> j2284941188 [label="MarieEntrati3a",color=purple];
		j4106479212 -> j2445808301 [label="MarieEntrati3b",color=purple];
		j4106479212 -> j2350506192 [label="MarieEntrati3",color=purple];
		j4106479212 -> j3924358611 [label="false",color=purple];
	j3811336081 [label="Ale fakt pozostaje taki, że mu wybaczam. Bo widzę więcej wartości w jego dobrych uczynkach niż w złych.",shape=box,color=blue];
		j3811336081 -> j429806412;
		j3811336081 -> j2278360491;
		j3811336081 -> j3098324220;
		j3811336081 -> j2045509247;
		j3811336081 -> j2100983108;
	j3792237862 [label="Modlę się, aby Leon okazał się silny i przetrwał kryzys wiary, którego doświadcza, ale nie sądzę, aby była to wyłącznie wina le Cardinal.",shape=box,color=blue];
		j3792237862 -> j429806412;
		j3792237862 -> j2278360491;
		j3792237862 -> j3098324220;
		j3792237862 -> j1840220402;
		j3792237862 -> j4060335628;
	j2284941188 [label="Choć doceniam twoje argumenty dotyczące M'sieur Tagfera i tych, którzy zostali przez niego skrzywdzeni, nadal dostrzegam większą wartość w jego dobrych uczynkach niż w złych.",shape=box,color=blue];
		j2284941188 -> j429806412;
		j2284941188 -> j2278360491;
		j2284941188 -> j3098324220;
		j2284941188 -> j2210975535;
		j2284941188 -> j1057226583;
	j2445808301 [label="Choć więc rozumiem gniew M'sieur Tagfera i rozumiem jego argumenty, musi on znaleźć w sobie siłę, by wybaczyć le Cardinal. Widzę bowiem więcej wartości w jego dobrych uczynkach niż w tych złych.",shape=box,color=blue];
		j2445808301 -> j429806412;
		j2445808301 -> j2278360491;
		j2445808301 -> j3098324220;
		j2445808301 -> j1761510133;
		j2445808301 -> j673451544;
	j2350506192 [label="Choć cenię historię każdego z nas związaną z le Cardinal, zwłaszcza M'sieur Tagfera, wciąż bardziej cenię jego dobre uczynki, niż skupiam się na tych złych.",shape=box,color=blue];
		j2350506192 -> j429806412;
		j2350506192 -> j2278360491;
		j2350506192 -> j3098324220;
		j2350506192 -> j4103880067;
	j3924358611 [label="Choć cenię historię każdego z nas związaną z le Cardinal, wciąż bardziej cenię jego dobre uczynki, niż skupiam się na tych złych.",shape=box,color=blue];
		j3924358611 -> j429806412;
		j3924358611 -> j2278360491;
		j3924358611 -> j3098324220;
	j429806412 [label="Nie winię cię za to, że doceniasz dobro, które zrobił w twoim życiu, tak samo jak nie winię innych ludzi za to, że czują się urażeni krzywdą, jaką wyrządza w ich życiu.",shape=box,color=red];
		j429806412 -> j2170017746;
	j2278360491 [label="Nie wiem. Myślę, że jego działania przyniosły o wiele więcej szkody niż pożytku. Chciałabym, żebyś to zobaczył.",shape=box,color=red];
		j2278360491 -> j4288371264;
	j3098324220 [label="Zgadzam się z tobą. Nie mogę winić Entratiego za jego czyny. Walczy z Obojętnością.",shape=box,color=red];
		j3098324220 -> j3142094137;
	j2045509247 [label="Masz rację, że nie żywisz urazy do Entratiego. Chciałbym, żeby inni poszli w twoje ślady.",shape=box,color=red];
		j2045509247 -> j3142094137;
	j2100983108 [label="Nigdy nie będę winić nikogo za wybaczenie. Ale można komuś wybaczyć, rozumiejąc, że trzeba chronić przed tą osobą siebie i innych.",shape=box,color=red];
		j2100983108 -> j3655302698;
	j1840220402 [label="Uważasz, że cierpienie Leona jest jego własną winą?",shape=box,color=red];
		j1840220402 -> j1692364819;
	j4060335628 [label="Leon przeżywa więcej kryzys wiary, Marii. I wiele z tego ma związek z Entratim.",shape=box,color=red];
		j4060335628 -> j4288371264;
	j2210975535 [label="Czy nic z tego, co powiedziałem, nie zmieniło twojego punktu widzenia?",shape=box,color=red];
		j2210975535 -> j3230920155;
	j1057226583 [label="Jak możesz patrzeć na wszystko, co zrobił Entrati i nadal widzieć więcej dobra niż zła?",shape=box,color=red];
		j1057226583 -> j4288371264;
	j1761510133 [label="Myślę, że bagatelizujesz powagę cierpień Cavii i Tagfera.",shape=box,color=red];
		j1761510133 -> j4288371264;
	j673451544 [label="Wybaczenie jest ważne. Ale równie ważne jest zrozumienie, że Entrati może być bardziej skomplikowany, niż jesteś zdolna przyznać.",shape=box,color=red];
		j673451544 -> j3230920155;
	j4103880067 [label="Nadal nie sądzę, żebyś rozumiała, co przeżyli Tagfer i Cavia. To gorsze niż to, co ty przeżyłaś.",shape=box,color=red];
		j4103880067 -> j4288371264;
	j2170017746 [label="Ale czy widzisz, że te dwie rzeczy nie mają równej wartości ? Uraza i głębokie uznanie ? Życzę sobie, żeby inni porzuciły swoje złośliwe urazy.",shape=box,color=blue];
		j2170017746 -> j1860630665;
		j2170017746 -> j2316465025;
	j4288371264 [label="Evaluate expressions",color=orange];
		j4288371264 -> j2396095930 [label="MarieEntratiMonster1",color=purple];
		j4288371264 -> j2396095930 [label="MarieEntratiMonster2",color=purple];
		j4288371264 -> j3406403505 [label="MarieEntratiFan1",color=purple];
		j4288371264 -> j3406403505 [label="MarieEntratiFan2",color=purple];
		j4288371264 -> j1520530541 [label="false",color=purple];
	j3142094137 [label="Evaluate expressions",color=orange];
		j3142094137 -> j932560225 [label="MarieEntratiMonster1",color=purple];
		j3142094137 -> j932560225 [label="MarieEntratiMonster2",color=purple];
		j3142094137 -> j1905645844 [label="MarieEntratiFan1",color=purple];
		j3142094137 -> j1905645844 [label="MarieEntratiFan2",color=purple];
		j3142094137 -> j698112993 [label="false",color=purple];
	j3655302698 [label="I to właśnie sugerujesz, żebyśmy zrobili ? Wygnać le Cardinal ? Ale chyba już sam to zrobił, non ?",shape=box,color=blue];
		j3655302698 -> j1841368634;
		j3655302698 -> j2316465025;
	j1692364819 [label="Myślę, że Leon cierpi na wiele dolegliwości, z których wiele wynika z wątpliwości co do samego siebie i własnego umysłu. Wydaje się, że le Cardinal... tylko pogorszył sytuację.",shape=box,color=blue];
		j1692364819 -> j2030674348;
		j1692364819 -> j2316465025;
	j3230920155 [label="Co mam zrobić ? Spalić kukłę le Cardinal i go odrzucić ? Skazać go na Pustkę, życzyć mu źle, jak M'sieur Tagfer ?",shape=box,color=blue];
		j3230920155 -> j1841368634;
		j3230920155 -> j2316465025;
	j1860630665 [label="W tym tkwi problem, Mario. O to, czego oczekujesz od innych. Nie o to, czego oczekują od ciebie. Albo od Entratiego.",shape=box,color=red];
		j1860630665 -> j1765084922;
	j2316465025 [label="Gdziekolwiek Entrati nie pójdzie, zostawia za sobą złamane serca. Ja tylko próbuję pomóc tym ludziom poskładać wszystko do kupy. W jego przypadku nie obchodzi mnie zbytnio, czy to dla \"dobra\", czy \"zła\".",shape=box,color=red];
		j2316465025 -> j758650313;
	j2396095930 [label="Oui, i jesteś tak niezmienny w swojej nienawiści do niego ! Czy nic z tego, co powiedziałam, nie zmieniło twojego zdania o le Cardinal ?",shape=box,color=blue];
		j2396095930 -> j1283800886;
	j3406403505 [label="Czyż nie mówiłeś mi o tym, jak wielbiłeś Entratiego, tak jak ja, zaledwie przed chwilą ? Co zmieniło twoje zdanie ?",shape=box,color=blue];
		j3406403505 -> j2136823885;
		j3406403505 -> j1303813676;
		j3406403505 -> j1370873702;
		j3406403505 -> j1240030241;
	j1520530541 [label="Oui, a ty najwyraźniej uważasz Entratiego za takiego potwora ! Tak szybko odrzucasz jego dobroć!",shape=box,color=blue];
		j1520530541 -> j1283800886;
	j932560225 [label="Czyż nie mówiłeś mi o monstruosité Entratiego zaledwie chwilę temu ? Co zmieniło twoje zdanie ?",shape=box,color=blue];
		j932560225 -> j2136823885;
		j932560225 -> j1303813676;
		j932560225 -> j1370873702;
		j932560225 -> j1240030241;
	j1905645844 [label="Merci, byłeś moim wiernym towarzyszem w tej krucjacie ! Obawiam się, że jesteśmy w tym osamotnieni – nawet Monsieur Loid także żywi urazę...",shape=box,color=blue];
		j1905645844 -> j1029305587;
	j698112993 [label="Merci, i cieszę się, że to słyszę ! Obawiam się, że jesteśmy w tym osamotnieni – nawet Monsieur Loid także żywi urazę...",shape=box,color=blue];
		j698112993 -> j1029305587;
	j1841368634 [label="Myślę, że problemem jest raczej to, czego wymagasz od innych, a nie to, czego oni wymagają od ciebie. Albo Entratiego.",shape=box,color=red];
		j1841368634 -> j1765084922;
	j2030674348 [label="I nie przeszkadza ci to?",shape=box,color=red];
		j2030674348 -> j2159116448;
	j1765084922 [label="A czegoż to tak groteskowego oczekuję od innych ? Aby pozwolili sobie przebaczyć ?",shape=box,color=blue];
		j1765084922 -> j2845715927;
		j1765084922 -> j2018024662;
	j758650313 [label="Szlachetne, choć męczące, podróżowanie w czasie i przestrzeni, wspomagając swoje mécontents, non ? Z pewnością musisz mieć do niego o to żal...",shape=box,color=blue];
		j758650313 -> j419066868;
		j758650313 -> j2669799790;
	j1283800886 [label="Ta rozmowa była błędem...",shape=box,color=blue];
		j1283800886 -> j3489568186;
		j1283800886 -> j1937859778;
	j2136823885 [label="Szczerze mówiąc, miałem problem z poruszaniem tego tematu z tobą. Osobiście uważam, że on... ani dobry, ani zły. Raczej trochę tego i tamtego.",shape=box,color=red];
		j2136823885 -> j318266180;
	j1303813676 [label="Zmieniłem zdanie. Jestem po jego stronie. I po twojej. Przekonałeś mnie.",shape=box,color=red];
		j1303813676 -> j4044257408;
	j1370873702 [label="[Wyznaj uczucia] Po prostu starałem się zrobić wszystko, co w mojej mocy, żeby... spełnić twoje oczekiwania. Zakochałem się w tobie, ale nie dawałem tego po sobie poznać.",shape=box,color=red];
		j1370873702 -> j1199558891;
	j1240030241 [label="Zmieniłem zdanie i uznałem, że jest potworem. Raz na zawsze.",shape=box,color=red];
		j1240030241 -> j779249480;
	j1029305587 [label="Być może razem zdołamy stawić czoła tym, którzy chcieliby splamić jego dobre uczynki, oui ? Ale zastanawiam się, we wszystkim, co cię otacza... dlaczego stajesz po mojej stronie ?",shape=box,color=blue];
		j1029305587 -> j1895113151;
	j2159116448 [label="Check boolean LyonDating",color=orange];
		j2159116448 -> j515287046 [label=true,color=green];
		j2159116448 -> j4096417802 [label=false,color=brown];
	j2845715927 [label="Postawiłaś Entratiego na piedestale. I prosisz innych, żeby zrobili to samo, jak idioci.",shape=box,color=red];
		j2845715927 -> j2431109223;
	j2018024662 [label="Myślę, że prosisz ich o coś więcej niż tylko o wybaczenie Entratiemu. Myślę, że prosisz ich, żeby udawali, że nie zrobił niczego złego.",shape=box,color=red];
		j2018024662 -> j1394519880;
	j419066868 [label="Tak. Ale to też jemu zawdzięczam jedne z najważniejszych relacji i przyjaźni, jakie kiedykolwiek nawiązałam.",shape=box,color=red];
		j419066868 -> j3897738458;
	j2669799790 [label="Nie, nie do końca. On tego ode mnie oczekuje, więc to robię. Osądzę go, kiedy będzie już po wszystkim.",shape=box,color=red];
		j2669799790 -> j3897738458;
	j3489568186 [label="Zaczekaj chwilę, Mario, pozwól mi to wyjaśnić.",shape=box,color=red];
		j3489568186 -> j268888988;
		j3489568186 -> j3163032158;
		j3489568186 -> j1439785382;
		j3489568186 -> j4114168292;
	j1937859778 [label="Jasno wyraziłem, co myślę o Entratim. Przepraszam. W niektórych kwestiach nie możemy się zgodzić.",shape=box,color=red];
		j1937859778 -> j1309386668;
	j318266180 [label="Boolean MarieEntratiMonster1 is now false.",color=orange];
		j318266180 -> j3116835600;
	j4044257408 [label="Boolean MarieEntratiMonster1 is now false.",color=orange];
		j4044257408 -> j403916339;
	j1199558891 [label="Boolean DrifterMarieWhoops is now true.",color=orange];
		j1199558891 -> j1404826550;
	j779249480 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j779249480 -> j1929641039;
	j1895113151 [label="Nie, żebym narzekała !",shape=box,color=blue];
		j1895113151 -> j2321401381;
		j1895113151 -> j3423437847;
		j1895113151 -> j2431722506;
	j515287046 [label="Wiem, że znalazł miejsce w twoim sercu i jestem za to naprawdę wdzięczna – może w końcu przestanę się o niego martwić, a wszystkie te kłótnie wkrótce okażą się nie mieć znaczenia...",shape=box,color=blue];
		j515287046 -> j4096417802;
	j4096417802 [label="Ale oczywiście, że mnie to dręczy. On jest bratem mojej duszy ! Mój Leon jest dla mnie najdroższy na świecie, a widok jego cierpienia rani moje serce, jakby jego cierpienie było moim własnym.",shape=box,color=blue];
		j4096417802 -> j3554964480;
	j2431109223 [label="Rozważnie dobieraj słowa, Włóczęgo.",shape=box,color=blue];
		j2431109223 -> j3173846356;
	j1394519880 [label="Je ne suis pas naïve, więc nie traktuj mnie w taki sposób !",shape=box,color=blue];
		j1394519880 -> j2473168092;
	j3897738458 [label="Być może krzywdzi się trucizną tylko po to, by jego ciało mogło się zagoić, a to wszystko jest po prostu koniecznym okrucieństwem.",shape=box,color=blue];
		j3897738458 -> j1063824049;
		j3897738458 -> j2327520980;
	j268888988 [label="[Wyznaj uczucia] Zależy mi na tobie. Bardziej, niż dałem po sobie poznać. I... przepraszam, że byłem tak ostry, ale nie mogę pozwolić mu cię skrzywdzić. Nie tak, jak skrzywdził tylu innych.",shape=box,color=red];
		j268888988 -> j3158591610;
	j3163032158 [label="Widziałem, jak Entrati nie robił nic innego, tylko ranił wszystkich, na których mu zależało. Wszystkich, których rzekomo kochał. Nie chcę, żeby skrzywdził cię tak samo...",shape=box,color=red];
		j3163032158 -> j4089777373;
	j1439785382 [label="Czasami ciężko jest mi się właściwie wysłowić, za co przepraszam, ale on... obawiam się, że on cię wykorzystuje. Nadużywa twojej dobroci, żeby tobą manipulować. To wszystko.",shape=box,color=red];
		j1439785382 -> j508653233;
	j4114168292 [label="Możesz postrzegać Entratiego jako zbawiciela, ale ja widzę go jako starego, przestraszonego człowieka, który szuka odpowiedzi. Może odpowiedź leży gdzieś pośrodku.",shape=box,color=red];
		j4114168292 -> j2431109223;
	j1309386668 [label="Oui, na to wygląda.",shape=box,color=blue];
		j1309386668 -> j3051126039;
	j3116835600 [label="Boolean MarieEntratiMonster2 is now false.",color=orange];
		j3116835600 -> j430717531;
	j403916339 [label="Boolean MarieEntratiMonster2 is now false.",color=orange];
		j403916339 -> j3781244447;
	j1404826550 [label="I postanowiłeś mnie oszukać, żeby wpaść w moje łaski... je vois.",shape=box,color=blue];
		j1404826550 -> j3704355657;
		j1404826550 -> j4240284582;
	j1929641039 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j1929641039 -> j833142220;
	j2321401381 [label="[Wyznaj uczucia] Zależy mi na tobie. Bardziej, niż dałem po sobie poznać.",shape=box,color=red];
		j2321401381 -> j3244875125;
	j3423437847 [label="Wierzę, że w tej wojnie wszystko jest dopuszczalne. Przecież próbujemy ratować wszechświat przed Obojętnością, prawda?",shape=box,color=red];
		j3423437847 -> j1309945732;
	j2431722506 [label="Wierzę w Entratiego. Naprawdę. Myślę, że ma plan, jak to rozwiązać, i że wszystko to służy większemu celowi.",shape=box,color=red];
		j2431722506 -> j3599053318;
	j3554964480 [label="Ale jego upadek wiary nie jest dziełem le Cardinal. Jego fundamenty już były popękane. Po prostu załamały się pod naciskiem, oui ?",shape=box,color=blue];
		j3554964480 -> j3897738458;
