digraph {
	"MarieRank4Convo7 begins." [color=orange];
		"MarieRank4Convo7 begins." -> j3255816954;
	j3255816954 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j3255816954 -> j706642002 [label="x >= 0",color=purple];
		j3255816954 -> "Chat ends." [label="x <= 0",color=purple];
		j3255816954 -> "Chat ends." [label="false",color=purple];
	j706642002 [label="Włóczęgo, excusez-moi... Naprawdę uważasz, że rozważnie jest wesprzeć diabła ?",shape=box,color=blue];
		j706642002 -> j2825522410;
	"Chat ends." [color=orange];
	j2825522410 [label="Nie chcę odtrącać tych, którzy szukają rozgrzeszenia lub pomocy, ale... nie sądzę, żeby taki był cel diabła.",shape=box,color=blue];
		j2825522410 -> j1637038821;
		j2825522410 -> j2763591743;
		j2825522410 -> j2531239082;
		j2825522410 -> j386906797;
	j1637038821 [label="A jak myślisz, o co mu tak naprawdę chodzi?",shape=box,color=red];
		j1637038821 -> j4137342624;
	j2763591743 [label="Wiem, że się nie dogadujecie i przykro mi z tego powodu. Ale nie mogę go przecież wyrzucić.",shape=box,color=red];
		j2763591743 -> j2367067974;
	j2531239082 [label="Roathe zapomniał o Orokin więcej – dosłownie – niż my kiedykolwiek będziemy wiedzieć. Potrzebujemy go.",shape=box,color=red];
		j2531239082 -> j3413350555;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j4137342624 [label="Jest jak dzikie zwierze. Może podejść, gdy zaoferujesz mu jedzenie i ciepłe miejsce do spania, ale zniknie, gdy tylko przestaniesz mu być potrzebny.",shape=box,color=blue];
		j4137342624 -> j2264937077;
	j2367067974 [label="Add 1 to Thermostat counter",color=orange];
		j2367067974 -> j3091905242;
	j3413350555 [label="Add -1 to Thermostat counter",color=orange];
		j3413350555 -> j4137342624;
	j2264937077 [label="On czegoś od ciebie potrzebuje. Od nas. ",shape=box,color=blue];
		j2264937077 -> j863296879;
	j3091905242 [label="Non, i niczego takiego nie sugeruję. Chodzi tylko o to... że nie można mu ufać. Ani teraz, ani nigdy.",shape=box,color=blue];
		j3091905242 -> j4137342624;
	j863296879 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j863296879 -> j4093421340 [label="x > 5",color=purple];
		j863296879 -> j3288653920 [label="x <= 5",color=purple];
		j863296879 -> j3288653920 [label="false",color=purple];
	j4093421340 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4093421340 -> j9884446 [label="x >= 21",color=purple];
		j4093421340 -> j2939089788 [label="x < 21",color=purple];
		j4093421340 -> j2939089788 [label="false",color=purple];
	j3288653920 [label="Te utracone wspomnienia, te przeszłe koszmary z Tau... Martwię się tym, co one zwiastują.",shape=box,color=blue];
		j3288653920 -> j3247130211;
		j3288653920 -> j625425285;
	j9884446 [label="Wiem, że myślisz, że odkryliśmy już wszystkie tajemnice jego strzaskanego umysłu.",shape=box,color=blue];
		j9884446 -> j795656030;
		j9884446 -> j625425285;
	j2939089788 [label="Im więcej poznajemy, im głębiej zapuszczamy się w jego zdruzgotany umysł, tym bardziej mnie to niepokoi. Z każdą chwilą niebezpieczeństwo staje się bardziej realne.",shape=box,color=blue];
		j2939089788 -> j625425285;
		j2939089788 -> j3247130211;
	j3247130211 [label="Wątpię, że on po prostu zniknie, kiedy odzyska pamięć. Chodzi o coś więcej.",shape=box,color=red];
		j3247130211 -> j358080693;
	j625425285 [label="Musi chodzić o coś więcej. Nie tylko o jego wspomnienia, ale też o nas.",shape=box,color=red];
		j625425285 -> j4119752394;
	j795656030 [label="Wierzę mu, kiedy mówi, że to wszystko, czego się z tego dowiemy. A jeśli tak, to dlaczego wciąż tu jest?",shape=box,color=red];
		j795656030 -> j358080693;
	j358080693 [label="Przyznaję, że bardziej martwię się tym, co zamierza zrobić z tą wiedzą, niż samą wiedzą.",shape=box,color=blue];
		j358080693 -> j508444198;
	j4119752394 [label="Oui ! To mnie właśnie martwi. Ale o co może chodzić ? Do jakich celów nadal mu służymy ?",shape=box,color=blue];
		j4119752394 -> j508444198;
	j508444198 [label="Jakkolwiek zamierza wykorzystać swoją nową istotę, obawiam się, że chce w to wciągnąć nas. I po prostu chcę, żebyśmy pozostali zaślepieni wiarą w to, że nie chce zrobić niczego złego.",shape=box,color=blue];
		j508444198 -> j3800546855;
		j508444198 -> j3928356901;
		j508444198 -> j277062924;
	j3800546855 [label="Zgadzam się z tobą, nie ufam mu.",shape=box,color=red];
		j3800546855 -> j698465165;
	j3928356901 [label="Jest potężny i wie tak dużo. Wolałbym, żeby pozostał po mojej stronie.",shape=box,color=red];
		j3928356901 -> j2480809035;
	j277062924 [label="Nie ma sensu zastanawiać się, czy nas zdradzi – nie zdradził. I nie osądzam ludzi za grzechy, których jeszcze nie popełnili.",shape=box,color=red];
		j277062924 -> j2128599951;
	j698465165 [label="+20 Chemistry",color=orange];
		j698465165 -> j3928290415;
	j2480809035 [label="Add -1 to Thermostat counter",color=orange];
		j2480809035 -> j3346122282;
	j2128599951 [label="Add 1 to Thermostat counter",color=orange];
		j2128599951 -> j3857325110;
	j3928290415 [label="Bien ! Przynajmniej będę miała spokój, wiedząc, że ktoś jeszcze pilnuje tego diabła. Będę spać spokojniej. Merci.",shape=box,color=blue];
		j3928290415 -> j3984234322;
	j3346122282 [label="Oui, ale zastanawiam się, ile naprawdę będzie nas kosztować to przymierze. Możesz nie być zadowolony z ceny, jaką zapłacisz.",shape=box,color=blue];
		j3346122282 -> j1890321951;
	j3857325110 [label="Oui... chyba masz rację. Nie możemy bać się wszystkiego. Musimy stanąć ramię w ramię z każdym, kto jest gotów zmierzyć się z Obojętnością.",shape=box,color=blue];
		j3857325110 -> j808986917;
	j3984234322 [label="Boolean MarieRoatheNoTrust is now true.",color=orange];
		j3984234322 -> "Chat ends.";
	j1890321951 [label="Upraszam cię, byś zachował ostrożność... to potwór w skórze dżentelmena. Uważaj na niego, s'il te plaît ?",shape=box,color=blue];
		j1890321951 -> j636674015;
		j1890321951 -> j3046171469;
	j808986917 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j808986917 -> j389271210 [label=true,color=green];
		j808986917 -> j4270662425 [label=false,color=brown];
	j636674015 [label="Myślę, że traktujesz go niesprawiedliwie.",shape=box,color=red];
		j636674015 -> j240316212;
	j3046171469 [label="Będę ostrożny. Obiecuję.",shape=box,color=red];
		j3046171469 -> j1746336426;
	j389271210 [label="Nawet jeśli wierzysz, że siła stojąca za tym nie pochodzi od boga, lecz z naszego umysłu, to i tak stanowi zagrożenie.",shape=box,color=blue];
		j389271210 -> j1890321951;
	j4270662425 [label="Nawet jeśli wierzy, że siła stojąca za tym nie pochodzi od boga, lecz z naszego umysłu, to i tak stanowi zagrożenie.",shape=box,color=blue];
		j4270662425 -> j1890321951;
	j240316212 [label="Add -1 to Thermostat counter",color=orange];
		j240316212 -> j2448152298;
	j1746336426 [label="+20 Chemistry",color=orange];
		j1746336426 -> j2552751361;
	j2448152298 [label="Oui ? Jak to ? Nie chcę być okrutna, naprawdę mnie to ciekawi.",shape=box,color=blue];
		j2448152298 -> j4190241786;
		j2448152298 -> j1870928297;
		j2448152298 -> j810504014;
		j2448152298 -> j584053416;
	j2552751361 [label="Merci. O więcej nie mogę prosić.",shape=box,color=blue];
		j2552751361 -> "Chat ends.";
	j4190241786 [label="Wychował się w innym społeczeństwie, w innych czasach – z innymi oczekiwaniami. Może nam się to nie podobać, ale jest, kim jest.",shape=box,color=red];
		j4190241786 -> j3193391976;
	j1870928297 [label="Ty i Leon z własnej woli przyjęliście serum protoframe od Entrati. On nie. Wyobrażasz sobie, jak to jest?",shape=box,color=red];
		j1870928297 -> j1527047173;
		j1870928297 -> j3928949402;
		j1870928297 -> j3193391976;
	j810504014 [label="Przeżył całe stulecia, robiąc to, co uważał za konieczne. Po prostu nie zgadzamy się co do definicji.",shape=box,color=red];
		j810504014 -> j1527047173;
		j810504014 -> j1569061802;
	j584053416 [label="Myślę, że to jego... zachowanie może cię zirytować. Nie jego czyny.",shape=box,color=red];
		j584053416 -> j1569061802;
		j584053416 -> j1527047173;
	j3193391976 [label="Jest wysokim stopniem żołnierzem i celebrytą. A obie te rzeczy wymagają czasami podejmowania szemranych decyzji.",shape=box,color=red];
		j3193391976 -> j681163897;
	j1527047173 [label="Myślę, że można podejmować \"złe\" działania mając dobre intencje.",shape=box,color=red];
		j1527047173 -> j2436638325;
	j3928949402 [label="Wszystko, co zrobił, zrobił w imię ratowania Imperium Orokin — a za te starania został wrzucony w ten bałagan wbrew swojej woli.",shape=box,color=red];
		j3928949402 -> j681163897;
	j1569061802 [label="Myślę, że on działa ci na nerwy, bo jest dumny z tego, co zrobił.",shape=box,color=red];
		j1569061802 -> j725100704;
	j681163897 [label="Check boolean MarieGrineer",color=orange];
		j681163897 -> j2093033116 [label=true,color=green];
		j681163897 -> j3900067129 [label=false,color=brown];
	j2436638325 [label="Można go uważać za diabła, ale w jego mniemaniu nie ma nic bardziej odległego od prawdy.",shape=box,color=red];
		j2436638325 -> j681163897;
	j725100704 [label="Oui, nie podobają mi się ci, którzy rozkoszują się śmiercią. I jego chęć do rozlewu krwi wydaje mi się niepokojąca. I fakt, że ty tego nie uważasz za niepokojące, jest równie niepokojące.",shape=box,color=blue];
		j725100704 -> j839511920;
	j2093033116 [label="I myślę, że ci, którzy dowodzą \"Corpus” czy \"Grineer\", z którymi walczysz, powiedzieliby to samo. Oni nie uważają się za złych.",shape=box,color=blue];
		j2093033116 -> j729237778;
	j3900067129 [label="I myślę, że ci, którzy dowodzą \"Corpus” czy \"Grin-ire\", z którymi walczysz, powiedzieliby to samo. Oni nie uważają się za złych.",shape=box,color=blue];
		j3900067129 -> j729237778;
	j839511920 [label="Zbyt łatwo jest obrać drogę przemocy, zapomnieć o związanych z nią okropnościach i powtarzać, że to wszystko w imię \"większego dobra\".",shape=box,color=blue];
		j839511920 -> j840149249;
	j729237778 [label="Wierzą, że ich czyny są sprawiedliwe, dobre i konieczne. Jak można tolerować jednego diabła, a nie innego?",shape=box,color=blue];
		j729237778 -> j1844437772;
		j729237778 -> j2266824022;
		j729237778 -> j2390507704;
		j729237778 -> j1576433385;
	j840149249 [label="Duma z samego czynu... to dla mnie za dużo. Nie cieszy mnie, kiedy muszę odebrać komuś życie. Więc w tym sensie? Jesteśmy zupełnie inni.",shape=box,color=blue];
		j840149249 -> j3853065792;
	j1844437772 [label="Postaram się ich powstrzymać, kiedy robią coś, z czym się nie zgadzam. Ale... będę walczył u ich boku, kiedy będzie trzeba.",shape=box,color=red];
		j1844437772 -> j1214872143;
	j2266824022 [label="Nie wierzę, żeby te grupy były same w sobie \"złe\" albo \"dobre\". Wierzę w działania, które podejmują.",shape=box,color=red];
		j2266824022 -> j1031483631;
	j2390507704 [label="Nie do mnie należy decyzja, które czyny są \"dobre\", a które \"złe\". Robię to, co robię, aby pomóc ludziom, którzy potrzebują pomocy.",shape=box,color=red];
		j2390507704 -> j1214872143;
	j1576433385 [label="Prosisz mnie, abym oceniał całą grupę ludzi na podstawie tych samych kryteriów, na podstawie których oceniałbym jednostkę.",shape=box,color=red];
		j1576433385 -> j1031483631;
	j3853065792 [label="Mogę się tylko modlić, żeby nie było za późno, kiedy diabeł postanowi wbić ci ten nóż w plecy. Nie chcę, żeby twoją ostatnią myślą było: \"Maria mnie ostrzegała\".",shape=box,color=blue];
		j3853065792 -> j3349357601;
		j3853065792 -> j1492388320;
	j1214872143 [label="I wierzysz, że diabeł nie stanowi zagrożenia? Że nie jest niebezpieczny dla otoczenia? Może wyrządzić wiele szkód.",shape=box,color=blue];
		j1214872143 -> j1623849641;
		j1214872143 -> j2239109979;
	j1031483631 [label="A co z okropnymi czynami, których się dopuścił? Całą krwią na jego rękach? Czy w twoim mniemaniu były to usprawiedliwione czyny?",shape=box,color=blue];
		j1031483631 -> j2239109979;
	j3349357601 [label="Nie zrobi tego. A jeśli spróbuje, powstrzymam go.",shape=box,color=red];
		j3349357601 -> j3918518469;
	j1492388320 [label="Obiecuję, że to nie będą moje ostatnie myśli.",shape=box,color=red];
		j1492388320 -> j1354463806;
	j1623849641 [label="Jeśli nadejdzie czas, kiedy on zwróci się przeciwko nam, zacznę działać. Póki co udowodnił, że jest naszym sojusznikiem, nawet jeśli bywa... melodramatyczny.",shape=box,color=red];
		j1623849641 -> j278922417;
	j2239109979 [label="Nie widzę, żeby bycie niebezpiecznym było problemem. Jest bronią. A broń może zostać użyta zarówno do ataku, jak i do obrony.",shape=box,color=red];
		j2239109979 -> j1017836069;
	j3918518469 [label="Uwielbiam cię za twoją wiarę w siebie, nawet jeśli ubolewam nad tym, że wierzysz też w diabła. Jednak chyba zdecyduje się nadal wierzyć w ciebie.",shape=box,color=blue];
		j3918518469 -> j1220895405;
	j1354463806 [label="Sądzę, że te słowa przekazują inną myśl, niż ja bym chciała, ale nie będę się w nie za bardzo wczytywać.",shape=box,color=blue];
		j1354463806 -> j1220895405;
	j278922417 [label="Add 1 to Thermostat counter",color=orange];
		j278922417 -> j3853065792;
	j1017836069 [label="Add -1 to Thermostat counter",color=orange];
		j1017836069 -> j3853065792;
	j1220895405 [label="Muszę już iść. Ale błagam cię — bądź ostrożny. Jeśli nie dla swojego dobra, to ze względu na mnie, d'accord ?",shape=box,color=blue];
		j1220895405 -> j367054140;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
}