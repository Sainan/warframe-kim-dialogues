digraph {
	1842 [label="MarieRank4Convo7 begins.",color=orange];
		1842 -> 1843;
	1843 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		1843 -> 1844 [label="x >= 0",color=purple];
		1843 -> 1845 [label="x <= 0",color=purple];
		1843 -> 1845 [label="false",color=purple];
	1844 [label="Włóczęgo, excusez-moi... Naprawdę uważasz, że rozważnie jest wesprzeć diabła ?",shape=box,color=blue];
		1844 -> 1846;
	1845 [label="Chat ends.",color=orange];
	1846 [label="Nie chcę odtrącać tych, którzy szukają rozgrzeszenia lub pomocy, ale... nie sądzę, żeby taki był cel diabła.",shape=box,color=blue];
		1846 -> 1847;
		1846 -> 1848;
		1846 -> 1849;
		1846 -> 1850;
	1847 [label="A jak myślisz, o co mu tak naprawdę chodzi?",shape=box,color=red];
		1847 -> 1851;
	1848 [label="Wiem, że się nie dogadujecie i przykro mi z tego powodu. Ale nie mogę go przecież wyrzucić.",shape=box,color=red];
		1848 -> 1852;
	1849 [label="Roathe zapomniał o Orokin więcej – dosłownie – niż my kiedykolwiek będziemy wiedzieć. Potrzebujemy go.",shape=box,color=red];
		1849 -> 1853;
	1850 [label="[Koniec]",shape=box,color=red];
		1850 -> 1854;
	1851 [label="Jest jak dzikie zwierze. Może podejść, gdy zaoferujesz mu jedzenie i ciepłe miejsce do spania, ale zniknie, gdy tylko przestaniesz mu być potrzebny.",shape=box,color=blue];
		1851 -> 1855;
	1852 [label="Add 1 to Thermostat",color=orange];
		1852 -> 1856;
	1853 [label="Add -1 to Thermostat",color=orange];
		1853 -> 1851;
	1854 [label="Chat ends.",color=orange];
	1855 [label="On czegoś od ciebie potrzebuje. Od nas. ",shape=box,color=blue];
		1855 -> 1857;
	1856 [label="Non, i niczego takiego nie sugeruję. Chodzi tylko o to... że nie można mu ufać. Ani teraz, ani nigdy.",shape=box,color=blue];
		1856 -> 1851;
	1857 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		1857 -> 1859 [label="x > 5",color=purple];
		1857 -> 1858 [label="x <= 5",color=purple];
		1857 -> 1858 [label="false",color=purple];
	1859 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		1859 -> 1863 [label="x >= 21",color=purple];
		1859 -> 1862 [label="x < 21",color=purple];
		1859 -> 1862 [label="false",color=purple];
	1858 [label="Te utracone wspomnienia, te przeszłe koszmary z Tau... Martwię się tym, co one zwiastują.",shape=box,color=blue];
		1858 -> 1860;
		1858 -> 1861;
	1863 [label="Wiem, że myślisz, że odkryliśmy już wszystkie tajemnice jego strzaskanego umysłu.",shape=box,color=blue];
		1863 -> 1866;
		1863 -> 1861;
	1862 [label="Im więcej poznajemy, im głębiej zapuszczamy się w jego zdruzgotany umysł, tym bardziej mnie to niepokoi. Z każdą chwilą niebezpieczeństwo staje się bardziej realne.",shape=box,color=blue];
		1862 -> 1861;
		1862 -> 1860;
	1860 [label="Wątpię, że on po prostu zniknie, kiedy odzyska pamięć. Chodzi o coś więcej.",shape=box,color=red];
		1860 -> 1864;
	1861 [label="Musi chodzić o coś więcej. Nie tylko o jego wspomnienia, ale też o nas.",shape=box,color=red];
		1861 -> 1865;
	1866 [label="Wierzę mu, kiedy mówi, że to wszystko, czego się z tego dowiemy. A jeśli tak, to dlaczego wciąż tu jest?",shape=box,color=red];
		1866 -> 1864;
	1864 [label="Przyznaję, że bardziej martwię się tym, co zamierza zrobić z tą wiedzą, niż samą wiedzą.",shape=box,color=blue];
		1864 -> 1867;
	1865 [label="Oui ! To mnie właśnie martwi. Ale o co może chodzić ? Do jakich celów nadal mu służymy ?",shape=box,color=blue];
		1865 -> 1867;
	1867 [label="Jakkolwiek zamierza wykorzystać swoją nową istotę, obawiam się, że chce w to wciągnąć nas. I po prostu chcę, żebyśmy pozostali zaślepieni wiarą w to, że nie chce zrobić niczego złego.",shape=box,color=blue];
		1867 -> 1868;
		1867 -> 1869;
		1867 -> 1870;
	1868 [label="Zgadzam się z tobą, nie ufam mu.",shape=box,color=red];
		1868 -> 1871;
	1869 [label="Jest potężny i wie tak dużo. Wolałbym, żeby pozostał po mojej stronie.",shape=box,color=red];
		1869 -> 1872;
	1870 [label="Nie ma sensu zastanawiać się, czy nas zdradzi – nie zdradził. I nie osądzam ludzi za grzechy, których jeszcze nie popełnili.",shape=box,color=red];
		1870 -> 1873;
	1871 [label="+20 Chemistry",color=orange];
		1871 -> 1874;
	1872 [label="Add -1 to Thermostat",color=orange];
		1872 -> 1875;
	1873 [label="Add 1 to Thermostat",color=orange];
		1873 -> 1876;
	1874 [label="Bien ! Przynajmniej będę miała spokój, wiedząc, że ktoś jeszcze pilnuje tego diabła. Będę spać spokojniej. Merci.",shape=box,color=blue];
		1874 -> 1877;
	1875 [label="Oui, ale zastanawiam się, ile naprawdę będzie nas kosztować to przymierze. Możesz nie być zadowolony z ceny, jaką zapłacisz.",shape=box,color=blue];
		1875 -> 1878;
	1876 [label="Oui... chyba masz rację. Nie możemy bać się wszystkiego. Musimy stanąć ramię w ramię z każdym, kto jest gotów zmierzyć się z Obojętnością.",shape=box,color=blue];
		1876 -> 1879;
	1877 [label="Update boolean MarieRoatheNoTrust",color=orange];
		1877 -> 1880;
	1878 [label="Upraszam cię, byś zachował ostrożność... to potwór w skórze dżentelmena. Uważaj na niego, s'il te plaît ?",shape=box,color=blue];
		1878 -> 1881;
		1878 -> 1882;
	1879 [label="Check boolean DrifterFaithNoMITW",color=orange];
		1879 -> 1883 [label=true,color=green];
		1879 -> 1884 [label=false,color=brown];
	1880 [label="Chat ends.",color=orange];
	1881 [label="Myślę, że traktujesz go niesprawiedliwie.",shape=box,color=red];
		1881 -> 1885;
	1882 [label="Będę ostrożny. Obiecuję.",shape=box,color=red];
		1882 -> 1886;
	1883 [label="Nawet jeśli wierzysz, że siła stojąca za tym nie pochodzi od boga, lecz z naszego umysłu, to i tak stanowi zagrożenie.",shape=box,color=blue];
		1883 -> 1878;
	1884 [label="Nawet jeśli wierzy, że siła stojąca za tym nie pochodzi od boga, lecz z naszego umysłu, to i tak stanowi zagrożenie.",shape=box,color=blue];
		1884 -> 1878;
	1885 [label="Add -1 to Thermostat",color=orange];
		1885 -> 1887;
	1886 [label="+20 Chemistry",color=orange];
		1886 -> 1888;
	1887 [label="Oui ? Jak to ? Nie chcę być okrutna, naprawdę mnie to ciekawi.",shape=box,color=blue];
		1887 -> 1889;
		1887 -> 1890;
		1887 -> 1891;
		1887 -> 1892;
	1888 [label="Merci. O więcej nie mogę prosić.",shape=box,color=blue];
		1888 -> 1893;
	1889 [label="Wychował się w innym społeczeństwie, w innych czasach – z innymi oczekiwaniami. Może nam się to nie podobać, ale jest, kim jest.",shape=box,color=red];
		1889 -> 1894;
	1890 [label="Ty i Leon z własnej woli przyjęliście serum protoframe od Entrati. On nie. Wyobrażasz sobie, jak to jest?",shape=box,color=red];
		1890 -> 1895;
		1890 -> 1896;
		1890 -> 1894;
	1891 [label="Przeżył całe stulecia, robiąc to, co uważał za konieczne. Po prostu nie zgadzamy się co do definicji.",shape=box,color=red];
		1891 -> 1895;
		1891 -> 1897;
	1892 [label="Myślę, że to jego... zachowanie może cię zirytować. Nie jego czyny.",shape=box,color=red];
		1892 -> 1897;
		1892 -> 1895;
	1893 [label="Chat ends.",color=orange];
	1894 [label="Jest wysokim stopniem żołnierzem i celebrytą. A obie te rzeczy wymagają czasami podejmowania szemranych decyzji.",shape=box,color=red];
		1894 -> 1898;
	1895 [label="Myślę, że można podejmować \"złe\" działania mając dobre intencje.",shape=box,color=red];
		1895 -> 1899;
	1896 [label="Wszystko, co zrobił, zrobił w imię ratowania Imperium Orokin — a za te starania został wrzucony w ten bałagan wbrew swojej woli.",shape=box,color=red];
		1896 -> 1898;
	1897 [label="Myślę, że on działa ci na nerwy, bo jest dumny z tego, co zrobił.",shape=box,color=red];
		1897 -> 1900;
	1898 [label="Check boolean MarieGrineer",color=orange];
		1898 -> 1902 [label=true,color=green];
		1898 -> 1901 [label=false,color=brown];
	1899 [label="Można go uważać za diabła, ale w jego mniemaniu nie ma nic bardziej odległego od prawdy.",shape=box,color=red];
		1899 -> 1898;
	1900 [label="Oui, nie podobają mi się ci, którzy rozkoszują się śmiercią. I jego chęć do rozlewu krwi wydaje mi się niepokojąca. I fakt, że ty tego nie uważasz za niepokojące, jest równie niepokojące.",shape=box,color=blue];
		1900 -> 1903;
	1902 [label="I myślę, że ci, którzy dowodzą \"Corpus” czy \"Grineer\", z którymi walczysz, powiedzieliby to samo. Oni nie uważają się za złych.",shape=box,color=blue];
		1902 -> 1904;
	1901 [label="I myślę, że ci, którzy dowodzą \"Corpus” czy \"Grin-ire\", z którymi walczysz, powiedzieliby to samo. Oni nie uważają się za złych.",shape=box,color=blue];
		1901 -> 1904;
	1903 [label="Zbyt łatwo jest obrać drogę przemocy, zapomnieć o związanych z nią okropnościach i powtarzać, że to wszystko w imię \"większego dobra\".",shape=box,color=blue];
		1903 -> 1905;
	1904 [label="Wierzą, że ich czyny są sprawiedliwe, dobre i konieczne. Jak można tolerować jednego diabła, a nie innego?",shape=box,color=blue];
		1904 -> 1906;
		1904 -> 1907;
		1904 -> 1908;
		1904 -> 1909;
	1905 [label="Duma z samego czynu... to dla mnie za dużo. Nie cieszy mnie, kiedy muszę odebrać komuś życie. Więc w tym sensie? Jesteśmy zupełnie inni.",shape=box,color=blue];
		1905 -> 1910;
	1906 [label="Postaram się ich powstrzymać, kiedy robią coś, z czym się nie zgadzam. Ale... będę walczył u ich boku, kiedy będzie trzeba.",shape=box,color=red];
		1906 -> 1911;
	1907 [label="Nie wierzę, żeby te grupy były same w sobie \"złe\" albo \"dobre\". Wierzę w działania, które podejmują.",shape=box,color=red];
		1907 -> 1912;
	1908 [label="Nie do mnie należy decyzja, które czyny są \"dobre\", a które \"złe\". Robię to, co robię, aby pomóc ludziom, którzy potrzebują pomocy.",shape=box,color=red];
		1908 -> 1911;
	1909 [label="Prosisz mnie, abym oceniał całą grupę ludzi na podstawie tych samych kryteriów, na podstawie których oceniałbym jednostkę.",shape=box,color=red];
		1909 -> 1912;
	1910 [label="Mogę się tylko modlić, żeby nie było za późno, kiedy diabeł postanowi wbić ci ten nóż w plecy. Nie chcę, żeby twoją ostatnią myślą było: \"Maria mnie ostrzegała\".",shape=box,color=blue];
		1910 -> 1913;
		1910 -> 1914;
	1911 [label="I wierzysz, że diabeł nie stanowi zagrożenia? Że nie jest niebezpieczny dla otoczenia? Może wyrządzić wiele szkód.",shape=box,color=blue];
		1911 -> 1915;
		1911 -> 1916;
	1912 [label="A co z okropnymi czynami, których się dopuścił? Całą krwią na jego rękach? Czy w twoim mniemaniu były to usprawiedliwione czyny?",shape=box,color=blue];
		1912 -> 1916;
	1913 [label="Nie zrobi tego. A jeśli spróbuje, powstrzymam go.",shape=box,color=red];
		1913 -> 1917;
	1914 [label="Obiecuję, że to nie będą moje ostatnie myśli.",shape=box,color=red];
		1914 -> 1918;
	1915 [label="Jeśli nadejdzie czas, kiedy on zwróci się przeciwko nam, zacznę działać. Póki co udowodnił, że jest naszym sojusznikiem, nawet jeśli bywa... melodramatyczny.",shape=box,color=red];
		1915 -> 1919;
	1916 [label="Nie widzę, żeby bycie niebezpiecznym było problemem. Jest bronią. A broń może zostać użyta zarówno do ataku, jak i do obrony.",shape=box,color=red];
		1916 -> 1920;
	1917 [label="Uwielbiam cię za twoją wiarę w siebie, nawet jeśli ubolewam nad tym, że wierzysz też w diabła. Jednak chyba zdecyduje się nadal wierzyć w ciebie.",shape=box,color=blue];
		1917 -> 1921;
	1918 [label="Sądzę, że te słowa przekazują inną myśl, niż ja bym chciała, ale nie będę się w nie za bardzo wczytywać.",shape=box,color=blue];
		1918 -> 1921;
	1919 [label="Add 1 to Thermostat",color=orange];
		1919 -> 1910;
	1920 [label="Add -1 to Thermostat",color=orange];
		1920 -> 1910;
	1921 [label="Muszę już iść. Ale błagam cię — bądź ostrożny. Jeśli nie dla swojego dobra, to ze względu na mnie, d'accord ?",shape=box,color=blue];
		1921 -> 1922;
	1922 [label="+20 Chemistry",color=orange];
		1922 -> 1923;
	1923 [label="Chat ends.",color=orange];
}