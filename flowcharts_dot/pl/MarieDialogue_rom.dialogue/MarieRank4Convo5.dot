		j514987810 -> j309871790;
	j658888622 [label="Nekramity?",shape=box,color=red];
		j658888622 -> j2389211973;
	j1022334795 [label="Masz rację, nie można starać się o coś, czego druga osoba nie może dać.",shape=box,color=red];
		j1022334795 -> j380005824;
	j2491932876 [label="Rozdrapywanie starych ran jest niebezpieczne. Możesz nabawić się infekcji... albo nawet się wykrwawić.",shape=box,color=red];
		j2491932876 -> j2952898253;
	j754979145 [label="Ty - my - wszyscy mamy jedną wspólną cechę. Entrati porzucił każdego z nas.",shape=box,color=red];
		j754979145 -> j2515192195;
	j709037835 [label="Jak sobie radzisz, starając się ich pogodzić ?",shape=box,color=blue];
		j709037835 -> j1351541272;
		j709037835 -> j3087475529;
		j709037835 -> j2124508614;
		j709037835 -> j386906797;
	j309871790 [label="Par les Luminaires... Mówisz, że wszyscy jesteśmy tu w tajemnicy ?! To dlatego nie możemy opuścić tego miejsca ?! Mais pourquoi ?!",shape=box,color=blue];
		j309871790 -> j2529857812;
	j2389211973 [label="Oui ! Tak ! Tak uparcie naprawiają wszystkie meble, non ? Zauważyłam, że jeśli coś przeniesiesz... nadal to robią.",shape=box,color=blue];
		j2389211973 -> j320487747;
