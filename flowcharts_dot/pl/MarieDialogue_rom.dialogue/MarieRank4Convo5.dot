	j1351541272 [label="Szczerze? Miałem inne sprawy na głowie.",shape=box,color=red];
		j1351541272 -> j506087923;
	j3087475529 [label="Mogłoby być lepiej.",shape=box,color=red];
		j3087475529 -> j2509625202;
	j2124508614 [label="Robimy postępy.",shape=box,color=red];
		j2124508614 -> j872379556;
	j2529857812 [label="Jego córka, Euleria - znana jako Matka, i jej rodzina, przez cały ten czas zajmowali się Deimosem.",shape=box,color=red];
		j2529857812 -> j3710675727;
	j320487747 [label="Co nas powstrzymuje przed przeniesieniem wszystkich mebli, odtworzeniem ich przez nich... i powtórzeniem tego ? Moglibyśmy to wszystko sprzedać i zyskać profit de ce mobilier étrange !",shape=box,color=blue];
		j320487747 -> j476722174;
		j320487747 -> j933443199;
		j320487747 -> j4261624531;
	j1114979350 [label="Zdaję sobie sprawę z nierozwiązanych sporów z le Cardinal, ale postarajmy się, aby ta rozmowa pozostała... civilisée.",shape=box,color=blue];
		j1114979350 -> j3276793787;
	j2936465781 [label="Rozumiem, dlaczego możesz nie chcieć rozmawiać o godzeniu innych, nie szukając okazji, by wytykać winnych palcem.",shape=box,color=blue];
		j2936465781 -> j3276793787;
	j1665267526 [label="Oui ! Bardzo chętnie przypominasz mi, że widzisz w nim un monstre ! Potwora kierowanego złością i pustym sercem !",shape=box,color=blue];
		j1665267526 -> j3276793787;
	j3882184075 [label="Myślałam, że byłeś po mojej stronie w tej wojnie o duszę le Cardinal ?",shape=box,color=blue];
		j3882184075 -> j4280849124;
	j3139805862 [label="Myślałam, że jeszcze nie zdecydowałeś, po której stronie jesteś ? Czy to się zmieniło ?",shape=box,color=blue];
		j3139805862 -> j1972138826;
		j3139805862 -> j4002966325;
	j1818433975 [label="Oui. Uczę się tego od M'sieur Miecia...",shape=box,color=blue];
		j1818433975 -> j3945312572;
	j3035763345 [label="Nie mów mi o starych ranach, wilku. Nadal liżę swoje rany po naszej ostatniej dyskusji o le Cardinal.",shape=box,color=blue];
		j3035763345 -> j3276793787;
	j3427174960 [label="Oui, ale jak mówiłeś wcześniej — musimy przestać rzucać się sobie do gardła, winiąc za te rany.",shape=box,color=blue];
		j3427174960 -> j3728356229;
	j1319084113 [label="Wiem, że uważasz le Cardinal za okropnego potwora, przez szkody, jakie wyrządził.",shape=box,color=blue];
		j1319084113 -> j3276793787;
	j1674551709 [label="Wiem, że jesteś po mojej stronie w tej wojnie o duszę le Cardinal, za co jestem dozgonnie wdzięczna.",shape=box,color=blue];
		j1674551709 -> j2236424564;
	j3634537333 [label="Wiem, że jeszcze nie podjąłeś ostatecznej decyzji na jego temat, za co jestem dozgonnie wdzięczna.",shape=box,color=blue];
		j3634537333 -> j2236424564;
	j2236424564 [label="Wiem też, że inni szybko zarzucają mu winę. Dlatego nie chcę patrzyć, jak różnimy się i cierpimy, kiedy moglibyśmy być razem.",shape=box,color=blue];
		j2236424564 -> j60583179;
	j2761189689 [label="Oui, choć nadal się dowiaduję, że jak w przypadku M'sieur Miecia, nie wszystkie sytuacje były takie same.",shape=box,color=blue];
		j2761189689 -> j3945312572;
	j229099540 [label="I dowiaduję się też, że nie wszystkie sytuacje są takie same, jak już \"grzecznie\" mi o tym przypomniałeś, non ?",shape=box,color=blue];
		j229099540 -> j3276793787;
	j731500018 [label="Oui, tak ! Choć nie obwiniam le Cardinal za odejście, bo jego praca jest sacro-saint -",shape=box,color=blue];
		j731500018 -> j2236424564;
	j914191810 [label="I wiem, że uważasz le Cardinal za okropnego potwora, przez szkody, jakie wyrządził.",shape=box,color=blue];
		j914191810 -> j3276793787;
	j3314575722 [label="Wiem też, że inni szybko obwinili go za swój ból. Po prostu nie chcę patrzyć, jak różnimy się i cierpimy.",shape=box,color=blue];
		j3314575722 -> j60583179;
	j506087923 [label="I cóż takiego mogło odwrócić twoją uwagę ? Co mogłoby być ważniejsze od rozpatrywania skarg od mécontents ?",shape=box,color=blue];
		j506087923 -> j566816000;
	j2509625202 [label="Co może być takiego trudnego w rozpatrywaniu skarg od mécontents ?",shape=box,color=blue];
		j2509625202 -> j2676986089;
	j872379556 [label="Och, magnifique !",shape=box,color=blue];
		j872379556 -> j103227749;
	j3710675727 [label="Strzegą tego miejsca i serca, które pompuje energię Pustki w Systemie Origin, pozwalając nam... działać, od kiedy Entrati odszedł.",shape=box,color=red];
		j3710675727 -> j3916832970;
	j476722174 [label="Nie wiem, czy znajdziesz rynek na krzesła Entratiego...",shape=box,color=red];
		j476722174 -> j986913360;
	j933443199 [label="Nie przesyciłabyś rynku? Musielibyśmy sprzedawać je po taniości...",shape=box,color=red];
		j933443199 -> j986913360;
	j4261624531 [label="Doskonały pomysł. To nie może się nie udać.",shape=box,color=red];
		j4261624531 -> j1072418098;
	j3276793787 [label="Chociaż rozumiem, że te dwa tematy są nierozerwalnie ze sobą powiązane, chciałabym cię prosić, abyś nie zmarnował tego dnia na sprzeczki, oui ?",shape=box,color=blue];
		j3276793787 -> j3566222750;
	j4280849124 [label="Na czym polega twoja gra, wilku ? Bawisz się tylko małą Marią ?",shape=box,color=blue];
		j4280849124 -> j2540059241;
		j4280849124 -> j4002966325;
	j1972138826 [label="Nie zdecydowałem jeszcze, czy jego czyny były konieczne, ale nie możemy zaprzeczyć jego bezdusznej naturze.",shape=box,color=red];
		j1972138826 -> j3276793787;
	j4002966325 [label="Jestem już zmęczony udawaniem, przepraszam.",shape=box,color=red];
		j4002966325 -> j3992525392;
	j3945312572 [label="Musimy przestać obwiniać siebie nawzajem za nasze krzywdy.",shape=box,color=blue];
		j3945312572 -> j3728356229;
	j3728356229 [label="Miej na uwadze, że nie popieram też obwiniania le Cardinal. Nie chcę patrzyć, jak różnimy się i cierpimy, kiedy moglibyśmy być razem.",shape=box,color=blue];
		j3728356229 -> j578811880;
		j3728356229 -> j439371389;
	j60583179 [label="Musimy przestać obwiniać siebie nawzajem za nasze krzywdy, niezależnie od tego, kto za nie odpowiada.",shape=box,color=blue];
		j60583179 -> j578811880;
		j60583179 -> j439371389;
	j566816000 [label="Żartuję, żartuję ! Nie mogę pojąć, jak bardzo zajęty musisz być przez te wszystkie miejsca i czas, które cię potrzebują.",shape=box,color=blue];
		j566816000 -> j103227749;
	j2676986089 [label="Żartuję, żartuję ! Nie mogę pojąć, co oni przeżyli i jak wymagające musi być rozwikłanie tego.",shape=box,color=blue];
		j2676986089 -> j103227749;
	j103227749 [label="Obawiam się tylko, że bez rozwiązania ich problemów nigdy nie będziemy przez nich mile widziani. Większy problem pozostaje nierozwiązany -",shape=box,color=blue];
		j103227749 -> j1245017771;
	j3916832970 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3916832970 -> j3756110351 [label=true,color=green];
		j3916832970 -> j3337182392 [label=false,color=brown];
	j986913360 [label="Pff ! I still think this is a worthy experiment. Perhaps we can wall off the devil in a sea of bookcases !",shape=box,color=blue];
		j986913360 -> j1239135434;
	j1072418098 [label="I am going to dutifully ignore your sarcasm, because I think this is a worthy experiment. Perhaps we can wall off the devil in a sea of bookcases !",shape=box,color=blue];
		j1072418098 -> j1239135434;
	j3566222750 [label="Chcę nam wszystkim pomóc w tej... dziwnej egzystencji, w której się znaleźliśmy, a nie kłócić się.",shape=box,color=blue];
		j3566222750 -> j3945312572;
	j2540059241 [label="Nie, to żadna gra... Ale Entratiemu nie można ufać i nie wiem jak cię przekonać, że on tylko udaje, że jest po twojej stronie.",shape=box,color=red];
		j2540059241 -> j1839803953;
	j3992525392 [label="Oui ? Więc z przyjemnością mogę powiedzieć, że już nie musisz.",shape=box,color=blue];
		j3992525392 -> j1509439757;
	j578811880 [label="Wszyscy razem jako jedna... dziwna rodzina. Ale mimo wszystko rodzina.",shape=box,color=red];
		j578811880 -> j1625808289;
	j439371389 [label="Jesteśmy silniejsi razem, niż osobno.",shape=box,color=red];
		j439371389 -> j1235880135;
		j439371389 -> j80833902;
	j3756110351 [label="Pogodziła się z jego nieobecnością i nawzajem sobie przebaczyli, ale nie przyszło im to łatwo.",shape=box,color=red];
		j3756110351 -> j3045433620;
	j3337182392 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j3337182392 -> j3756110351 [label=true,color=green];
		j3337182392 -> j3344539768 [label=false,color=brown];
	j1239135434 [label="+20 Chemistry",color=orange];
		j1239135434 -> j2115257260;
	j1839803953 [label="Oui ? Więc z przyjemnością mogę powiedzieć, że nie udało ci się.",shape=box,color=blue];
		j1839803953 -> j1509439757;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j1625808289 [label="Add +1 to Family counter",color=orange];
		j1625808289 -> j1235880135;
		j1625808289 -> j80833902;
	j1235880135 [label="I w czasach, kiedy wszyscy cierpimy, czasami jedyne co mamy, to siebie nawzajem. Tych, których nam dano, albo tych, których odnaleźliśmy.",shape=box,color=red];
		j1235880135 -> j1971821168;
	j80833902 [label="Nie wiem, ile w tym pomocy, ale nie powinno zaszkodzić. Ale ten.. czyściec, też nie jest w porządku.",shape=box,color=red];
		j80833902 -> j1301122361;
	j3045433620 [label="Wiedząc, że on wciąż gdzieś tam jest, robiąc bałagan, i nie odezwał się do nim ani słowem, ani nawet listem...?",shape=box,color=red];
		j3045433620 -> j3165948376;
	j3344539768 [label="Nie pogodziła się z jego odejściem i nadal rzucają się sobie do gardeł.",shape=box,color=red];
		j3344539768 -> j3607610978;
	j2115257260 [label="Czeka mnie wiele pracy ! À la revoyure !",shape=box,color=blue];
		j2115257260 -> "Chat ends.";
	j2631316640 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j2631316640 -> j1508231473;
	j1971821168 [label="Add +1 to Family counter",color=orange];
		j1971821168 -> j1301122361;
	j1301122361 [label="Oui, zgadzam się. Ale to nie ja zdołam ich pogodzić — nie mam pojęcia jak ! Jestem dla rodziny zaledwie obcym...",shape=box,color=blue];
		j1301122361 -> j1262546562;
		j1301122361 -> j525679977;
	j3165948376 [label="Nie mogę sobie wyobrazić, jak bolesne musiało to być dla niej. Dla nich wszystkich.",shape=box,color=red];
		j3165948376 -> j1880791311;
	j3607610978 [label="Wiedząc, że on wciąż gdzieś tam jest, robiąc bałagan, i nie odezwał się do nim ani słowem, ani nawet listem...?",shape=box,color=red];
		j3607610978 -> j463962038;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j1262546562 [label="Loid znał rodzinę Entrati. To powinien być on, ale przekonanie go... to już inna sprawa.",shape=box,color=red];
		j1262546562 -> j3726346726;
	j525679977 [label="Może Roathe? Jest Orokin, znał ich wszystkich.",shape=box,color=red];
		j525679977 -> j1182781405;
	j1880791311 [label="Rozumiem logikę za decyzjami le Cardinal i chęć ochrony ich przed bólem, który sprawił swoim nieuniknionym odejściem...",shape=box,color=blue];
		j1880791311 -> j3274617658;
	j463962038 [label="Zrujnowałoby to i tak nikłe szanse na pogodzenie się.",shape=box,color=red];
		j463962038 -> j2165710013;
	j3726346726 [label="+5 Chemistry",color=orange];
		j3726346726 -> j1450715924;
	j1182781405 [label="Non, nie diabeł — ktokolwiek, tylko nie diabeł. Ale to dobry trop. Naturalnym kandydatem jest Monsieur Loid, non ?",shape=box,color=blue];
		j1182781405 -> j171091864;
	j3274617658 [label="Uważam jednak to za zbędne okrucieństwo, a ty ? Mogą myśleć, że umarł, albo coś gorszego ! A my, żyjemy tutaj, comme des rats d'égout ?",shape=box,color=blue];
		j3274617658 -> j3691971786;
		j3274617658 -> j3144777219;
		j3274617658 -> j865243303;
	j2165710013 [label="Oui... Rozumiem to. Postarałabym się pogodzić ich rodzinę, jeśli jesteś w stanie, non ? To chyba nasza jedyna nadzieją, by kiedykolwiek się stąd uwolnić. ",shape=box,color=blue];
		j2165710013 -> j954176816;
	j1450715924 [label="Oui, oui ! C'est ça ! Ale jak możemy go przekonać ? Był niezłomny w swoim postanowieniu, non ?",shape=box,color=blue];
		j1450715924 -> j815226923;
		j1450715924 -> j3532792450;
	j171091864 [label="Ale jak możemy go przekonać ? Był niezłomny w swoim postanowieniu, non ?",shape=box,color=blue];
		j171091864 -> j3532792450;
		j171091864 -> j815226923;
	j3691971786 [label="Mam przyjaciółkę, która uwielbia szczury. Myślę, że są urocze.",shape=box,color=red];
		j3691971786 -> j3639256428;
	j3144777219 [label="To nie jest moja decyzja.",shape=box,color=red];
		j3144777219 -> j243387594;
	j865243303 [label="Co byś mi doradził ?",shape=box,color=red];
		j865243303 -> j1689274132;
	j954176816 [label="Żebyśmy nie spędzili tutaj reszty naszego żywota, uwięzieni comme des rats d'égout. ",shape=box,color=blue];
		j954176816 -> j3010634139;
		j954176816 -> j3950236981;
	j815226923 [label="Myślisz, że Leon może być w stanie go przekonać?",shape=box,color=red];
		j815226923 -> j331787827;
	j3532792450 [label="Moja odpowiedź może ci się nie spodobać...",shape=box,color=red];
		j3532792450 -> j3785288543;
	j3639256428 [label="I chciałabym kiedyś ich poznać, ale nie o tym mówię, głupi wilczku.",shape=box,color=blue];
		j3639256428 -> j1689274132;
	j243387594 [label="Wiem. To decyzja Monsieur Loida i wszystkich innych, by zdecydowali się ujawnić.",shape=box,color=blue];
		j243387594 -> j1689274132;
	j1689274132 [label="Pragnę zasugerować, że tu na dole zatrzymuje nas nie szlachetność, a poczucie winy.",shape=box,color=blue];
		j1689274132 -> j2565515773;
	j3010634139 [label="Mam przyjaciółkę, która uwielbia szczury. Myślę, że są urocze. ",shape=box,color=red];
		j3010634139 -> j3639256428;
	j3950236981 [label="Zapomniałem się. Masz rację, muszę wracać do pracy.",shape=box,color=red];
		j3950236981 -> j3509619735;
	j331787827 [label="Raczej nas polubił, jest miły i łagodny. Ale nadal jesteśmy dla niego étrangers, przybyszami.",shape=box,color=blue];
		j331787827 -> j4062574098;
	j3785288543 [label="Ach bon ?",shape=box,color=blue];
		j3785288543 -> j1199824064;
	j2565515773 [label="Że chowamy jakiś głęboki grzech.",shape=box,color=blue];
		j2565515773 -> j3432044017;
	j3509619735 [label="Dziękuję Ci. Nie wiem, czy Ci się uda, ale czasami jedyne co nam zostaje, to próbować.",shape=box,color=blue];
		j3509619735 -> j1689274132;
	j4062574098 [label="Zastanowię się nad tym, a ty zrób tak samo ! Odnajdziemy rozwiązanie, Sol zaprowadził nas już tak daleko !",shape=box,color=blue];
		j4062574098 -> j2399975875;
	j1199824064 [label="Loid może posłuchać się Roathe'a. Jest Orokin - ich wspólna historia może się tu przydać.",shape=box,color=red];
		j1199824064 -> j3244166709;
	j3432044017 [label="I to ten grzech musi zostać przebaczony, albo udowodniony jako fałszywy ?",shape=box,color=blue];
		j3432044017 -> j1713754707;
		j3432044017 -> j1307715404;
	j2399975875 [label="+15 Chemistry",color=orange];
		j2399975875 -> j2672004944;
	j3244166709 [label="Non ! To kłamca i manipulator, zgodziłby się na to tylko za wysoką cenę !",shape=box,color=blue];
		j3244166709 -> j2425277829;
	j1713754707 [label="Sytuacja na górze jest... delikatna. Nie chcę ich denerwować.",shape=box,color=red];
		j1713754707 -> j3170995129;
	j1307715404 [label="Musimy być ostrożni. Obawiam się, że połowa z nich uzna drugą za \"drugą rodzinę\".",shape=box,color=red];
		j1307715404 -> j2591116846;
	j2672004944 [label="Znajdziemy sposób, żeby przekonać Monsieur Loida, żeby wszedł po tych schodach... jestem tego pewna.",shape=box,color=blue];
		j2672004944 -> j1027743501;
	j2425277829 [label="Znajdziemy inny sposób, żeby przekonać Monsieur Loida, żeby wszedł po tych schodach... jestem tego pewna.",shape=box,color=blue];
		j2425277829 -> j899435635;
	j3170995129 [label="Zdziwiłbyś się, jak wytrwała potrafi być dusza. Ci, którzy mnie otaczają, są już bardzo starzy i zahartowani przez życie.",shape=box,color=blue];
		j3170995129 -> j2485085506;
	j2591116846 [label="Add +1 to Family counter",color=orange];
		j2591116846 -> j964561133;
	j1027743501 [label="Muszę już iść. Dałeś mi wiele do myślenia. À la revoyure.",shape=box,color=blue];
		j1027743501 -> j3419468122;
	j899435635 [label="Muszę już iść. Dałeś mi wiele do myślenia. À la revoyure.",shape=box,color=blue];
		j899435635 -> j3493145735;
	j2485085506 [label="Zaskoczyłeś ich wiele razy. Pozwól, by oni zaskoczyli cię ten jeden raz.",shape=box,color=blue];
		j2485085506 -> j1706833697;
	j964561133 [label="Och na Sol ! To może być rozwiązanie !",shape=box,color=blue];
