		j1887913838 -> j386906797;
	j3482540807 [label="Włóczęgo ! Knułam, myśląc o tym, co powiedziałeś mi o rodzinie ponad nami. O tym, że mogą widzieć w nas intruzów.",shape=box,color=blue];
		j3482540807 -> j3934267168;
	j636944347 [label="Włóczęgo! Myślałam o tym, co powiedziałeś mi o rodzinie ponad nami. Moje serce pęka, kiedy o nich myślę...",shape=box,color=blue];
		j636944347 -> j1000557311;
	j1414312781 [label="Dlaczego nie możemy udać się na górę ? Dlaczego nie możemy porozmawiać z tymi, których le Cardinal nazywał rodziną ?",shape=box,color=blue];
		j1414312781 -> j1837098408;
		j1414312781 -> j386906797;
	j458526009 [label="Powinienem się martwić?",shape=box,color=red];
		j458526009 -> j3841411528;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j3934267168 [label="Jako \"tę drugą rodzinę\", oui ? Bardzo mnie to martwi.",shape=box,color=blue];
		j3934267168 -> j1000557311;
