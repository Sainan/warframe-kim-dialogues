		j1000557311 -> j3642914 [label=false,color=brown];
	j1837098408 [label="No cóż... krótko mówiąc, część rodziny Entrati jest piętro wyżej i... nie zdają sobie sprawy, że my jesteśmy tu na dole.",shape=box,color=red];
		j1837098408 -> j514987810;
	j3841411528 [label="Oui ! Te małe latające roboty. Te nekra... nekra... jak one się zwą ?",shape=box,color=blue];
		j3841411528 -> j658888622;
	"Chat ends." [color=orange];
	j1245017771 [label="Nie staramy się o miłość le Cardinal, jak możemy pomóc im to dostrzec ?",shape=box,color=blue];
		j1245017771 -> j1022334795;
