		1634 -> 1638 [label=false,color=brown];
	1635 [label="No cóż... krótko mówiąc, część rodziny Entrati jest piętro wyżej i... nie zdają sobie sprawy, że my jesteśmy tu na dole.",shape=box,color=red];
		1635 -> 1639;
	1636 [label="[Koniec]",shape=box,color=red];
		1636 -> 1640;
	2934 [label="Oui ! Te małe latające roboty. Te nekra... nekra... jak one się zwą ?",shape=box,color=blue];
		2934 -> 2935;
	2933 [label="Chat ends.",color=orange];
	1637 [label="Nie staramy się o miłość le Cardinal, jak możemy pomóc im to dostrzec ?",shape=box,color=blue];
		1637 -> 1641;
		1637 -> 1642;
		1637 -> 1643;
	1638 [label="Jak sobie radzisz, starając się ich pogodzić ?",shape=box,color=blue];
