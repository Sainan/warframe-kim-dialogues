	1652 [label="I cóż takiego mogło odwrócić twoją uwagę ? Co mogłoby być ważniejsze od rozpatrywania skarg od mécontents ?",shape=box,color=blue];
		1652 -> 1676;
	1653 [label="Co może być takiego trudnego w rozpatrywaniu skarg od mécontents ?",shape=box,color=blue];
		1653 -> 1677;
	1654 [label="Och, magnifique !",shape=box,color=blue];
		1654 -> 1678;
	1655 [label="Chat ends.",color=orange];
	1656 [label="Jego córka, Euleria - znana jako Matka, i jej rodzina, przez cały ten czas zajmowali się Deimosem.",shape=box,color=red];
		1656 -> 1679;
	2937 [label="Co nas powstrzymuje przed przeniesieniem wszystkich mebli, odtworzeniem ich przez nich... i powtórzeniem tego ? Moglibyśmy to wszystko sprzedać i zyskać profit de ce mobilier étrange !",shape=box,color=blue];
		2937 -> 2938;
		2937 -> 2939;
		2937 -> 2940;
	1658 [label="Zdaję sobie sprawę z nierozwiązanych sporów z le Cardinal, ale postarajmy się, aby ta rozmowa pozostała... civilisée.",shape=box,color=blue];
		1658 -> 1680;
	1661 [label="Rozumiem, dlaczego możesz nie chcieć rozmawiać o godzeniu innych, nie szukając okazji, by wytykać winnych palcem.",shape=box,color=blue];
		1661 -> 1680;
	1657 [label="Oui ! Bardzo chętnie przypominasz mi, że widzisz w nim un monstre ! Potwora kierowanego złością i pustym sercem !",shape=box,color=blue];
		1657 -> 1680;
	1659 [label="Myślałam, że byłeś po mojej stronie w tej wojnie o duszę le Cardinal ?",shape=box,color=blue];
		1659 -> 1681;
	1660 [label="Myślałam, że jeszcze nie zdecydowałeś, po której stronie jesteś ? Czy to się zmieniło ?",shape=box,color=blue];
		1660 -> 1682;
		1660 -> 1683;
	1668 [label="Oui. Uczę się tego od M'sieur Miecia...",shape=box,color=blue];
		1668 -> 1686;
	1662 [label="Nie mów mi o starych ranach, wilku. Nadal liżę swoje rany po naszej ostatniej dyskusji o le Cardinal.",shape=box,color=blue];
		1662 -> 1680;
	1663 [label="Oui, ale jak mówiłeś wcześniej — musimy przestać rzucać się sobie do gardła, winiąc za te rany.",shape=box,color=blue];
		1663 -> 1684;
	1664 [label="Wiem, że uważasz le Cardinal za okropnego potwora, przez szkody, jakie wyrządził.",shape=box,color=blue];
		1664 -> 1680;
	1665 [label="Wiem, że jesteś po mojej stronie w tej wojnie o duszę le Cardinal, za co jestem dozgonnie wdzięczna.",shape=box,color=blue];
		1665 -> 1666;
	1667 [label="Wiem, że jeszcze nie podjąłeś ostatecznej decyzji na jego temat, za co jestem dozgonnie wdzięczna.",shape=box,color=blue];
		1667 -> 1666;
	1666 [label="Wiem też, że inni szybko zarzucają mu winę. Dlatego nie chcę patrzyć, jak różnimy się i cierpimy, kiedy moglibyśmy być razem.",shape=box,color=blue];
		1666 -> 1685;
	1675 [label="Oui, choć nadal się dowiaduję, że jak w przypadku M'sieur Miecia, nie wszystkie sytuacje były takie same.",shape=box,color=blue];
		1675 -> 1686;
	1669 [label="I dowiaduję się też, że nie wszystkie sytuacje są takie same, jak już \"grzecznie\" mi o tym przypomniałeś, non ?",shape=box,color=blue];
		1669 -> 1680;
	1670 [label="Oui, tak ! Choć nie obwiniam le Cardinal za odejście, bo jego praca jest sacro-saint -",shape=box,color=blue];
		1670 -> 1666;
	1671 [label="I wiem, że uważasz le Cardinal za okropnego potwora, przez szkody, jakie wyrządził.",shape=box,color=blue];
		1671 -> 1680;
	1672 [label="Wiem, że jesteś po mojej stronie w tej wojnie o duszę le Cardinal, za co jestem dozgonnie wdzięczna.",shape=box,color=blue];
		1672 -> 1666;
	1673 [label="Wiem, że jeszcze nie podjąłeś ostatecznej decyzji na jego temat, za co jestem dozgonnie wdzięczna.",shape=box,color=blue];
		1673 -> 1666;
	1674 [label="Wiem też, że inni szybko obwinili go za swój ból. Po prostu nie chcę patrzyć, jak różnimy się i cierpimy.",shape=box,color=blue];
		1674 -> 1685;
	1676 [label="Żartuję, żartuję ! Nie mogę pojąć, jak bardzo zajęty musisz być przez te wszystkie miejsca i czas, które cię potrzebują.",shape=box,color=blue];
		1676 -> 1678;
	1677 [label="Żartuję, żartuję ! Nie mogę pojąć, co oni przeżyli i jak wymagające musi być rozwikłanie tego.",shape=box,color=blue];
		1677 -> 1678;
	1678 [label="Obawiam się tylko, że bez rozwiązania ich problemów nigdy nie będziemy przez nich mile widziani. Większy problem pozostaje nierozwiązany -",shape=box,color=blue];
		1678 -> 1637;
	1679 [label="Strzegą tego miejsca i serca, które pompuje energię Pustki w Systemie Origin, pozwalając nam... działać, od kiedy Entrati odszedł.",shape=box,color=red];
		1679 -> 1687;
	2938 [label="Nie wiem, czy znajdziesz rynek na krzesła Entratiego...",shape=box,color=red];
		2938 -> 2942;
	2939 [label="Nie przesyciłabyś rynku? Musielibyśmy sprzedawać je po taniości...",shape=box,color=red];
		2939 -> 2942;
	2940 [label="Doskonały pomysł. To nie może się nie udać.",shape=box,color=red];
		2940 -> 2941;
	1680 [label="Chociaż rozumiem, że te dwa tematy są nierozerwalnie ze sobą powiązane, chciałabym cię prosić, abyś nie zmarnował tego dnia na sprzeczki, oui ?",shape=box,color=blue];
		1680 -> 1688;
	1681 [label="Na czym polega twoja gra, wilku ? Bawisz się tylko małą Marią ?",shape=box,color=blue];
		1681 -> 1689;
		1681 -> 1683;
	1682 [label="Nie zdecydowałem jeszcze, czy jego czyny były konieczne, ale nie możemy zaprzeczyć jego bezdusznej naturze.",shape=box,color=red];
		1682 -> 1680;
	1683 [label="Jestem już zmęczony udawaniem, przepraszam.",shape=box,color=red];
		1683 -> 1690;
	1686 [label="Musimy przestać obwiniać siebie nawzajem za nasze krzywdy.",shape=box,color=blue];
		1686 -> 1684;
	1684 [label="Miej na uwadze, że nie popieram też obwiniania le Cardinal. Nie chcę patrzyć, jak różnimy się i cierpimy, kiedy moglibyśmy być razem.",shape=box,color=blue];
		1684 -> 1691;
		1684 -> 1692;
	1685 [label="Musimy przestać obwiniać siebie nawzajem za nasze krzywdy, niezależnie od tego, kto za nie odpowiada.",shape=box,color=blue];
		1685 -> 1691;
		1685 -> 1692;
	1687 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1687 -> 1693 [label=true,color=green];
		1687 -> 1694 [label=false,color=brown];
	2942 [label="Pff ! I still think this is a worthy experiment. Perhaps we can wall off the devil in a sea of bookcases !",shape=box,color=blue];
		2942 -> 2943;
	2941 [label="I am going to dutifully ignore your sarcasm, because I think this is a worthy experiment. Perhaps we can wall off the devil in a sea of bookcases !",shape=box,color=blue];
		2941 -> 2943;
	1688 [label="Chcę nam wszystkim pomóc w tej... dziwnej egzystencji, w której się znaleźliśmy, a nie kłócić się.",shape=box,color=blue];
		1688 -> 1686;
	1689 [label="Nie, to żadna gra... Ale Entratiemu nie można ufać i nie wiem jak cię przekonać, że on tylko udaje, że jest po twojej stronie.",shape=box,color=red];
		1689 -> 1695;
	1690 [label="Oui ? Więc z przyjemnością mogę powiedzieć, że już nie musisz.",shape=box,color=blue];
		1690 -> 1696;
	1691 [label="Wszyscy razem jako jedna... dziwna rodzina. Ale mimo wszystko rodzina.",shape=box,color=red];
		1691 -> 1697;
	1692 [label="Jesteśmy silniejsi razem, niż osobno.",shape=box,color=red];
		1692 -> 1698;
		1692 -> 1699;
	1693 [label="Pogodziła się z jego nieobecnością i nawzajem sobie przebaczyli, ale nie przyszło im to łatwo.",shape=box,color=red];
		1693 -> 1700;
	1694 [label="Nie pogodziła się z jego odejściem i nadal rzucają się sobie do gardeł.",shape=box,color=red];
		1694 -> 1701;
	2943 [label="+20 Chemistry",color=orange];
		2943 -> 2944;
	1695 [label="Oui ? Więc z przyjemnością mogę powiedzieć, że nie udało ci się.",shape=box,color=blue];
		1695 -> 1696;
	1696 [label="Update boolean MarieEntratiFan1",color=orange];
		1696 -> 1702;
	1697 [label="Add +1 to Family",color=orange];
		1697 -> 1698;
		1697 -> 1699;
	1698 [label="I w czasach, kiedy wszyscy cierpimy, czasami jedyne co mamy, to siebie nawzajem. Tych, których nam dano, albo tych, których odnaleźliśmy.",shape=box,color=red];
		1698 -> 1703;
	1699 [label="Nie wiem, ile w tym pomocy, ale nie powinno zaszkodzić. Ale ten.. czyściec, też nie jest w porządku.",shape=box,color=red];
		1699 -> 1704;
	1700 [label="Wiedząc, że on wciąż gdzieś tam jest, robiąc bałagan, i nie odezwał się do nim ani słowem, ani nawet listem...?",shape=box,color=red];
		1700 -> 1705;
	1701 [label="Wiedząc, że on wciąż gdzieś tam jest, robiąc bałagan, i nie odezwał się do nim ani słowem, ani nawet listem...?",shape=box,color=red];
		1701 -> 1706;
	2944 [label="Czeka mnie wiele pracy ! À la revoyure !",shape=box,color=blue];
		2944 -> 2929;
	1702 [label="Update boolean MarieEntratiFan2",color=orange];
		1702 -> 1707;
	1703 [label="Add +1 to Family",color=orange];
		1703 -> 1704;
	1704 [label="Oui, zgadzam się. Ale to nie ja zdołam ich pogodzić — nie mam pojęcia jak ! Jestem dla rodziny zaledwie obcym...",shape=box,color=blue];
		1704 -> 1708;
		1704 -> 1709;
	1705 [label="Nie mogę sobie wyobrazić, jak bolesne musiało to być dla niej. Dla nich wszystkich.",shape=box,color=red];
		1705 -> 1710;
	1706 [label="Zrujnowałoby to i tak nikłe szanse na pogodzenie się.",shape=box,color=red];
		1706 -> 1711;
	2929 [label="Chat ends.",color=orange];
	1707 [label="Update boolean MarieNoDate",color=orange];
		1707 -> 1712;
	1708 [label="Loid znał rodzinę Entrati. To powinien być on, ale przekonanie go... to już inna sprawa.",shape=box,color=red];
		1708 -> 1713;
	1709 [label="Może Roathe? Jest Orokin, znał ich wszystkich.",shape=box,color=red];
		1709 -> 1714;
	1710 [label="Rozumiem logikę za decyzjami le Cardinal i chęć ochrony ich przed bólem, który sprawił swoim nieuniknionym odejściem...",shape=box,color=blue];
		1710 -> 1715;
	1711 [label="Oui... Rozumiem to. Postarałabym się pogodzić ich rodzinę, jeśli jesteś w stanie, non ? To chyba nasza jedyna nadzieją, by kiedykolwiek się stąd uwolnić. ",shape=box,color=blue];
		1711 -> 1716;
	1712 [label="Chat ends.",color=orange];
	1713 [label="+5 Chemistry",color=orange];
		1713 -> 1717;
	1714 [label="Non, nie diabeł — ktokolwiek, tylko nie diabeł. Ale to dobry trop. Naturalnym kandydatem jest Monsieur Loid, non ?",shape=box,color=blue];
		1714 -> 1718;
	1715 [label="Uważam jednak to za zbędne okrucieństwo, a ty ? Mogą myśleć, że umarł, albo coś gorszego ! A my, żyjemy tutaj, comme des rats d'égout ?",shape=box,color=blue];
		1715 -> 1719;
		1715 -> 1720;
		1715 -> 1721;
	1716 [label="Żebyśmy nie spędzili tutaj reszty naszego żywota, uwięzieni comme des rats d'égout. ",shape=box,color=blue];
		1716 -> 1722;
		1716 -> 1723;
	1717 [label="Oui, oui ! C'est ça ! Ale jak możemy go przekonać ? Był niezłomny w swoim postanowieniu, non ?",shape=box,color=blue];
		1717 -> 1724;
		1717 -> 1725;
	1718 [label="Ale jak możemy go przekonać ? Był niezłomny w swoim postanowieniu, non ?",shape=box,color=blue];
		1718 -> 1725;
		1718 -> 1724;
	1719 [label="Mam przyjaciółkę, która uwielbia szczury. Myślę, że są urocze.",shape=box,color=red];
		1719 -> 1726;
	1720 [label="To nie jest moja decyzja.",shape=box,color=red];
		1720 -> 1727;
	1721 [label="Co byś mi doradził ?",shape=box,color=red];
		1721 -> 1728;
	1722 [label="Mam przyjaciółkę, która uwielbia szczury. Myślę, że są urocze. ",shape=box,color=red];
		1722 -> 1729;
	1723 [label="Zapomniałem się. Masz rację, muszę wracać do pracy.",shape=box,color=red];
		1723 -> 1730;
	1724 [label="Myślisz, że Leon może być w stanie go przekonać?",shape=box,color=red];
		1724 -> 1731;
	1725 [label="Moja odpowiedź może ci się nie spodobać...",shape=box,color=red];
		1725 -> 1732;
	1726 [label="I chciałabym kiedyś ich poznać, ale nie o tym mówię, głupi wilczku.",shape=box,color=blue];
		1726 -> 1728;
	1727 [label="Wiem. To decyzja Monsieur Loida i wszystkich innych, by zdecydowali się ujawnić.",shape=box,color=blue];
		1727 -> 1728;
	1728 [label="Pragnę zasugerować, że tu na dole zatrzymuje nas nie szlachetność, a poczucie winy.",shape=box,color=blue];
		1728 -> 1733;
	1729 [label="I chciałabym kiedyś ich poznać, ale nie o tym mówię, głupi wilczku.",shape=box,color=blue];
		1729 -> 1728;
	1730 [label="Dziękuję Ci. Nie wiem, czy Ci się uda, ale czasami jedyne co nam zostaje, to próbować.",shape=box,color=blue];
		1730 -> 1728;
	1731 [label="Raczej nas polubił, jest miły i łagodny. Ale nadal jesteśmy dla niego étrangers, przybyszami.",shape=box,color=blue];
		1731 -> 1734;
	1732 [label="Ach bon ?",shape=box,color=blue];
		1732 -> 1735;
	1733 [label="Że chowamy jakiś głęboki grzech.",shape=box,color=blue];
		1733 -> 1736;
	1734 [label="Zastanowię się nad tym, a ty zrób tak samo ! Odnajdziemy rozwiązanie, Sol zaprowadził nas już tak daleko !",shape=box,color=blue];
		1734 -> 1737;
	1735 [label="Loid może posłuchać się Roathe'a. Jest Orokin - ich wspólna historia może się tu przydać.",shape=box,color=red];
		1735 -> 1738;
	1736 [label="I to ten grzech musi zostać przebaczony, albo udowodniony jako fałszywy ?",shape=box,color=blue];
		1736 -> 1739;
		1736 -> 1740;
	1737 [label="+15 Chemistry",color=orange];
		1737 -> 1741;
	1738 [label="Non ! To kłamca i manipulator, zgodziłby się na to tylko za wysoką cenę !",shape=box,color=blue];
		1738 -> 1742;
	1739 [label="Sytuacja na górze jest... delikatna. Nie chcę ich denerwować.",shape=box,color=red];
		1739 -> 1743;
