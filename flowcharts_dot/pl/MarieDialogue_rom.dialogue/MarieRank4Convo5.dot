	2932 [label="[Koniec]",shape=box,color=red];
		2932 -> 2933;
	1633 [label="Jako \"tę drugą rodzinę\", oui ? Bardzo mnie to martwi.",shape=box,color=blue];
		1633 -> 1634;
	1634 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
