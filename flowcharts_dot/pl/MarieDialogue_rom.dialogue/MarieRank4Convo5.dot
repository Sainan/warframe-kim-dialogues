		1639 -> 1648;
	1640 [label="Chat ends.",color=orange];
	2935 [label="Nekramity?",shape=box,color=red];
		2935 -> 2936;
	1641 [label="Masz rację, nie można starać się o coś, czego druga osoba nie może dać.",shape=box,color=red];
		1641 -> 1649;
	1642 [label="Rozdrapywanie starych ran jest niebezpieczne. Możesz nabawić się infekcji... albo nawet się wykrwawić.",shape=box,color=red];
		1642 -> 1650;
	1643 [label="Ty - my - wszyscy mamy jedną wspólną cechę. Entrati porzucił każdego z nas.",shape=box,color=red];
		1643 -> 1651;
	1644 [label="Szczerze? Miałem inne sprawy na głowie.",shape=box,color=red];
		1644 -> 1652;
	1645 [label="Mogłoby być lepiej.",shape=box,color=red];
		1645 -> 1653;
	1646 [label="Robimy postępy.",shape=box,color=red];
		1646 -> 1654;
	1647 [label="[Koniec]",shape=box,color=red];
		1647 -> 1655;
	1648 [label="Par les Luminaires... Mówisz, że wszyscy jesteśmy tu w tajemnicy ?! To dlatego nie możemy opuścić tego miejsca ?! Mais pourquoi ?!",shape=box,color=blue];
		1648 -> 1656;
	2936 [label="Oui ! Tak ! Tak uparcie naprawiają wszystkie meble, non ? Zauważyłam, że jeśli coś przeniesiesz... nadal to robią.",shape=box,color=blue];
		2936 -> 2937;
