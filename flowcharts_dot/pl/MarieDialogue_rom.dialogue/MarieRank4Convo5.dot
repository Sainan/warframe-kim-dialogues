	2930 [label="Włóczęgo ! Uknułam plan.",shape=box,color=blue];
		2930 -> 2931;
		2930 -> 2932;
	1630 [label="Włóczęgo ! Knułam, myśląc o tym, co powiedziałeś mi o rodzinie ponad nami. O tym, że mogą widzieć w nas intruzów.",shape=box,color=blue];
		1630 -> 1633;
	1631 [label="Włóczęgo! Myślałam o tym, co powiedziałeś mi o rodzinie ponad nami. Moje serce pęka, kiedy o nich myślę...",shape=box,color=blue];
		1631 -> 1634;
	1632 [label="Dlaczego nie możemy udać się na górę ? Dlaczego nie możemy porozmawiać z tymi, których le Cardinal nazywał rodziną ?",shape=box,color=blue];
		1632 -> 1635;
		1632 -> 1636;
