		j1320247306 -> j2351139111 [label="false",color=purple];
	j470416691 [label="S'il te plaît, niech to się skończy, wkrótce zacznę się śmiać z jego żartów. Wtedy będę pewna, że nie ma dla mnie nadziei !",shape=box,color=blue];
		j470416691 -> j758933647;
	j3372953401 [label="Myślałaś już o tym, jak przekonać Loida, żeby porozmawiał z rodziną Entrati na górze?",shape=box,color=red];
		j3372953401 -> j3487613436;
	j2279521322 [label="Myślałem, jak przekonać Loida, żeby udał się na górę i porozmawiał z rodziną... i chyba mam pomysł, ale może ci się nie spodobać.",shape=box,color=red];
		j2279521322 -> j668862974;
	j3972471308 [label="Czy nadal chcesz... spróbować przekonać Loida, żeby porozmawiał z naszymi \"sąsiadami z piętra wyżej\"? Nasza ostatnia rozmowa na ten temat zakończyła się... dziwnie.",shape=box,color=red];
		j3972471308 -> j374072022;
	j2236820970 [label="Wracając do tematu zjednoczenia Loida z rodziną Entrati, zastanawiałem się... czy myślałaś o zaangażowaniu w tę kwestię Roathe'a?",shape=box,color=red];
		j2236820970 -> j374072022;
	j2351139111 [label="Zastanawiałam się, dlaczego Monsieur Loid jest tak przerażony wizją rozmowy z rodziną le Cardinal.",shape=box,color=blue];
		j2351139111 -> j3969502438;
	j758933647 [label="Check boolean MarieNoDate",color=orange];
		j758933647 -> "Chat ends." [label=true,color=green];
		j758933647 -> j2768654365 [label=false,color=brown];
