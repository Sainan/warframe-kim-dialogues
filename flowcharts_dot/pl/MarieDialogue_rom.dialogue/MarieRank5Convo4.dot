	j122188303 [label="+10 Chemistry",color=orange];
		j122188303 -> j4097017338;
	j3322623215 [label="+10 Chemistry",color=orange];
		j3322623215 -> j2383193328;
	j4097017338 [label="Oui, obawiam się, że jest w nim zło, którego nie da się w pełni wyplewić. Za bardzo się w nim lubuje.",shape=box,color=blue];
		j4097017338 -> j1674631788;
	j2383193328 [label="Może i masz racje... czymże jest un ange bez son diable ? Służy nam za przypomnienie, czego powinniśmy się wystrzegać.",shape=box,color=blue];
		j2383193328 -> j1674631788;
	j1674631788 [label="W każdym razie ! Jeśli i kiedy uda ci się przekonać diabła do pomocy, będę czekać !",shape=box,color=blue];
