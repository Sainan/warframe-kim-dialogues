	j374072022 [label="Check boolean MarieDating",color=orange];
		j374072022 -> j4090888070 [label=true,color=green];
		j374072022 -> j304986397 [label=false,color=brown];
	j3969502438 [label="I o tym, że musimy wyłamać się z tego impasu. To purgatoire, w którym jesteśmy uwięzieni, nie powinno istnieć. Rodzi zbędne cierpienie.",shape=box,color=blue];
		j3969502438 -> j3054982347;
	j2768654365 [label="Boolean MarieWillDate is now true.",color=orange];
		j2768654365 -> "Chat ends.";
	j2706343147 [label="Bonjour, mon cœur ! Dałam sobie chwilę na przemyślenia... i szczerze mówiąc, niechętnie się do tego przyznaję. Naprawdę ciężko wycisnąć z siebie te słowa.",shape=box,color=blue];
		j2706343147 -> j2330679955;
	j2669408935 [label="Bonjour... Dałam sobie chwilę na przemyślenia... i szczerze mówiąc, niechętnie się do tego przyznaję. Mówienie tego nie sprawia mi żadnej przyjemności.",shape=box,color=blue];
		j2669408935 -> j2330679955;
	j1400889152 [label="Bonjour, mon cœur ! Co miałoby mi się nie spodobać ?",shape=box,color=blue];
		j1400889152 -> j2745333343;
	j2127719357 [label="Bonjour ! Och ? Co miałoby mi się nie spodobać ?",shape=box,color=blue];
		j2127719357 -> j2745333343;
	j4090888070 [label="Bonjour, bonjour, mon cœur ! Dałam sobie chwilę na przemyślenia... i szczerze mówiąc, niechętnie się do tego przyznaję. Tak... mówienie tego nie sprawia mi żadnej przyjemności.",shape=box,color=blue];
		j4090888070 -> j2599758082;
	j304986397 [label="Bonjour... Dałam sobie chwilę na przemyślenia... i szczerze mówiąc, niechętnie się do tego przyznaję. Mówienie tego nie sprawia mi żadnej przyjemności.",shape=box,color=blue];
		j304986397 -> j2599758082;
	j3054982347 [label="Ale czuję, że będziemy potrzebować... swego rodzaju bastionu, non ? Czy masz jakiś pomysł ?",shape=box,color=blue];
		j3054982347 -> j3203407426;
		j3054982347 -> j2745333343;
	j2330679955 [label="Ale myślę... myślę, że — ach Sol, przebacz mi — że możemy potrzebować pomocy diabła. Nie sądzę, żeby Monsieur Loid wysłuchał nas w innym wypadku.",shape=box,color=blue];
		j2330679955 -> j4236957231;
	j2745333343 [label="Myślę, że będziemy potrzebować pomocy Roathe'a, żeby przekonać Loida do rozmowy z rodziną Entrati. Wątpię, że obejdziemy się bez tego. Musimy upewnić się, że on i jego rodzina będą pod ochroną.",shape=box,color=red];
		j2745333343 -> j467698573;
	j2599758082 [label="Myślę, że możesz mieć rację. Diabeł może być brakującym elementem układanki. Nie masz pojęcia, jak wiele kosztuje mnie przyznanie tego ! ",shape=box,color=blue];
		j2599758082 -> j409794056;
	j3203407426 [label="Nie mam żadnych pomysłów, które nie wiążą się z pomocą od okropnych ludzi. Ludzi, którzy mogą nas wpakować w większy problem później. Mam na myśli Roathe'a.",shape=box,color=red];
		j3203407426 -> j3061602446;
	j4236957231 [label="Diabeł jest potężny i obiecuje siłę, gdyby coś poszło nie tak, non ?",shape=box,color=blue];
		j4236957231 -> j257106164;
		j4236957231 -> j1145486740;
	j467698573 [label="Nie chcę tego przyznawać, ale możesz mieć rację... Sol, przebacz mi.",shape=box,color=blue];
		j467698573 -> j409794056;
	j409794056 [label="Evaluate expressions",color=orange];
		j409794056 -> j638779135 [label="RoatheFamilyFail",color=purple];
		j409794056 -> j734974270 [label="RoatheRedeemed & RoatheFamilyDelay
",color=purple];
		j409794056 -> j2094038069 [label="RoatheVillain & RoatheFamilyDelay",color=purple];
		j409794056 -> j1979773674 [label="false",color=purple];
	j3061602446 [label="Jesteś tego pewien ? Jeśli zdołam odłożyć na bok moją niechęć do diabła, ty także zdołasz, non ?",shape=box,color=blue];
		j3061602446 -> j4268396057;
		j3061602446 -> j3840952293;
	j257106164 [label="Masz rację. Nie sądziłem, że się zgodzisz. Bałem się zapytać.",shape=box,color=red];
		j257106164 -> j409794056;
	j1145486740 [label="Nie, musi być inny sposób. Nie zamierzam prosić go o pomoc.",shape=box,color=red];
		j1145486740 -> j3061602446;
	j638779135 [label="Czy pomoże nam w tej sprawie ?",shape=box,color=blue];
		j638779135 -> j2900155332;
	j734974270 [label="Czy pomoże nam w tej sprawie ?",shape=box,color=blue];
		j734974270 -> j2345699799;
	j2094038069 [label="Czy pomoże nam w tej sprawie ?",shape=box,color=blue];
		j2094038069 -> j3446870305;
	j1979773674 [label="Wierzysz, że uda się nam go przekonać ?",shape=box,color=blue];
		j1979773674 -> j3218719308;
		j1979773674 -> j2809742666;
	j4268396057 [label="W porządku, jeśli tobie to nie przeszkadza, ja też się zgodzę.",shape=box,color=red];
		j4268396057 -> j2844876612;
	j3840952293 [label="Nie, przykro mi. ",shape=box,color=red];
		j3840952293 -> j1559202369;
	j2900155332 [label="Nie, niestety... Myślę, że to ślepy zaułek. Myślisz, że istnieje inne wyjście?",shape=box,color=red];
		j2900155332 -> j2002586617;
	j2345699799 [label="Tak. Przekonałem go, żeby ich pogodził — i nie uwierzysz — myślę, że on może też chronić rodzinę Entrati. Są przecież wszystkim, co zostało z Orokin.",shape=box,color=red];
		j2345699799 -> j3063227754;
	j3446870305 [label="Tak. Przekonałem go, żeby ich pogodził — i raczej cię to nie zaskoczy — robi to, żeby zemścić się na Albrechcie podczas jego nieobecności.",shape=box,color=red];
		j3446870305 -> j1709340182;
	j3218719308 [label="Jeszcze nad tym pracuję, ale myślę, że tak.",shape=box,color=red];
		j3218719308 -> j961489522;
	j2809742666 [label="Niczego jeszcze nie ustaliliśmy. Wiesz, jaki potrafi być.",shape=box,color=red];
		j2809742666 -> j3827853471;
	j2844876612 [label="Oui, nie sprawia mi to radości, ale to médicament, który musimy zażyć.",shape=box,color=blue];
		j2844876612 -> j409794056;
	j1559202369 [label="+20 Chemistry",color=orange];
		j1559202369 -> j1453975680;
	j2002586617 [label="Och ! To... niefortunne. Chyba nie ? Nic nie przychodzi mi do głowy... Może jest inny sposób na diabła ? Sposób, żeby spróbować jeszcze raz ?",shape=box,color=blue];
		j2002586617 -> j2084525027;
	j3063227754 [label="Pomoże ochronić rodzinę człowieka, który wbrew jego woli zrobił z niego protoframe'a, porzucił go w przeszłości, okradł go z jego wspomnień...",shape=box,color=blue];
		j3063227754 -> j1910232285;
	j1709340182 [label="Masz rację... nie jestem zaskoczona.",shape=box,color=blue];
		j1709340182 -> j731907672;
		j1709340182 -> j3078459830;
	j961489522 [label="Check boolean RoatheDating",color=orange];
		j961489522 -> j1309547970 [label=true,color=green];
		j961489522 -> j3556801030 [label=false,color=brown];
	j3827853471 [label="Check boolean RoatheDating",color=orange];
		j3827853471 -> j413114818 [label=true,color=green];
		j3827853471 -> j1872586125 [label=false,color=brown];
	j1453975680 [label="W takim razie zgodzę się z twoją decyzją.",shape=box,color=blue];
		j1453975680 -> j1179567760;
	j2084525027 [label="W międzyczasie pomówię z Leonem, ale nie robię sobie nadziei.",shape=box,color=blue];
		j2084525027 -> j860725021;
	j1910232285 [label="+20 Chemistry",color=orange];
		j1910232285 -> j3872472342;
	j731907672 [label="Myślę, że to tylko wymówka.",shape=box,color=red];
		j731907672 -> j2922209834;
	j3078459830 [label="Ale przynajmniej pomoże. Dopilnuję, żeby nie spełnił swoich gróźb.",shape=box,color=red];
		j3078459830 -> j856110405;
	j1309547970 [label="Myślę, że masz swój sposób, żeby go przekonać, kiedy innym się nie udało, non ?",shape=box,color=blue];
		j1309547970 -> j1855841140;
		j1309547970 -> j2674833453;
	j3556801030 [label="Życzę ci szczęścia. Diabeł potrafi być uparty nawet w dobrych chwilach. Czasami myślę, że po prostu lubi być przekorny !",shape=box,color=blue];
		j3556801030 -> j3638692539;
		j3556801030 -> j1417557856;
	j413114818 [label="Oui, wiem. Ale myślę, że masz swój sposób, żeby go przekonać, kiedy innym się nie udało, non ?",shape=box,color=blue];
		j413114818 -> j1855841140;
		j413114818 -> j2674833453;
	j1872586125 [label="Oui, przekonałam się o tym. Ten diabeł potrafi być uparty nawet w dobrych chwilach. Czasami myślę, że po prostu lubi być przekorny !",shape=box,color=blue];
		j1872586125 -> j3638692539;
		j1872586125 -> j1417557856;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j860725021 [label="+20 Chemistry",color=orange];
		j860725021 -> j2316683364;
	j3872472342 [label="Bardzo pomyliłam się w ocenie naszego diabła...",shape=box,color=blue];
		j3872472342 -> j115715659;
	j2922209834 [label="Oui, mam nadzieję, że masz rację.",shape=box,color=blue];
		j2922209834 -> j70687620;
	j856110405 [label="Oui. Przynajmniej, kiedy jesteś w pobliżu, możemy dopilnować, że nie pokieruje się... bardziej pierwotnymi instynktami.",shape=box,color=blue];
		j856110405 -> j70687620;
	j1855841140 [label="Co sugerujesz, Mario?",shape=box,color=red];
		j1855841140 -> j2287219632;
	j2674833453 [label="Nie chcę wykorzystywać naszej relacji jako narzędzia w negocjacjach.",shape=box,color=red];
		j2674833453 -> j1900930020;
	j3638692539 [label="Czasami taki bywa, ale myślę, że wiele z tego jest tylko na pokaz.",shape=box,color=red];
		j3638692539 -> j390942292;
	j1417557856 [label="Szczerze to nawet mi się to podoba, choć brzmi to dziwnie. Dogadujemy się.",shape=box,color=red];
		j1417557856 -> j4241671862;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j2316683364 [label="Diabeł bywa kapryśny ! Jak to mawiają, c'est la vie !",shape=box,color=blue];
		j2316683364 -> j3569999725;
	j115715659 [label="I nie jestem na tyle głupcem, by nie dostrzec, jak ważną rolę odegrałeś w tym ty !",shape=box,color=blue];
		j115715659 -> j1263896752;
	j70687620 [label="Check boolean MarieDating",color=orange];
		j70687620 -> j1821915200 [label=true,color=green];
		j70687620 -> j2814755233 [label=false,color=brown];
	j2287219632 [label="+5 Chemistry",color=orange];
		j2287219632 -> j4252119015;
	j1900930020 [label="Och ! Nie to miałam na myśli, pardonne-moi ! Zauważyłam tylko, że darzy cię sympatią, więc możesz być zdolny szepnąć do jego ucha, kiedy innych by po prostu zignorował.",shape=box,color=blue];
		j1900930020 -> j354654294;
	j390942292 [label="Oui ? Co masz na myśli ?",shape=box,color=blue];
		j390942292 -> j1155893159;
	j4241671862 [label="Oui, wygląda na to, że darzy cię sympatią. Może przez to, że pochodzicie z tego samego czasu i miejsca, a my nie ? Czy może istnieć inny powód ?",shape=box,color=blue];
		j4241671862 -> j1155893159;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j1263896752 [label="Check boolean MarieDating",color=orange];
		j1263896752 -> j91321375 [label=true,color=green];
		j1263896752 -> j1294019211 [label=false,color=brown];
	j1821915200 [label="+10 Chemistry",color=orange];
		j1821915200 -> j2901937546;
	j2814755233 [label="+10 Chemistry",color=orange];
		j2814755233 -> j3272930354;
	j4252119015 [label="Nie mam pojęcia, o czym mówisz ! Niczego nie sugeruję. Jestem tylko niewinną Sœur de Sol.",shape=box,color=blue];
		j4252119015 -> j2509230643;
	j354654294 [label="+5 Chemistry",color=orange];
		j354654294 -> j162717790;
	j1155893159 [label="Evaluate expressions",color=orange];
		j1155893159 -> j3062248256 [label="RoatheVillain",color=purple];
		j1155893159 -> j182484812 [label="RoatheRedeemed",color=purple];
		j1155893159 -> j3237504252 [label="RoatheUnloved3",color=purple];
		j1155893159 -> j2870699963 [label="RoatheTraitor2",color=purple];
		j1155893159 -> j4008023897 [label="RoatheExecutor2",color=purple];
		j1155893159 -> j470921926 [label="false",color=purple];
	j91321375 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		j91321375 -> j3770030583;
	j1294019211 [label="Merci, merci, merci !",shape=box,color=blue];
		j1294019211 -> j3770030583;
	j2901937546 [label="Cóż ! Kiedy nadejdzie czas, będę gotowa ! Do tego czasu, merci, mon cœur.",shape=box,color=blue];
		j2901937546 -> j3569999725;
	j3272930354 [label="Cóż ! Kiedy nadejdzie czas, będę gotowa ! Do tego czasu, merci.",shape=box,color=blue];
		j3272930354 -> j3569999725;
	j2509230643 [label="Nigdy wcześniej bym nie zasugerowała, że skoro diabeł obdarzył cię sympatią, to może się ciebie posłuchać, nawet jeśli ignoruje innych.",shape=box,color=blue];
		j2509230643 -> j520724576;
	j162717790 [label="Po prostu cieszę się, że jesteś szczęśliwy. A jeśli diabeł ma... pole do popisu... to chyba lepiej dla wszystkich, non ?",shape=box,color=blue];
		j162717790 -> j492708526;
	j3062248256 [label="Każdy w jego życiu próbował zrobić z niego potwora. Chyba jestem pierwszą osobą, która tego nie zrobiła.",shape=box,color=red];
		j3062248256 -> j398466067;
	j182484812 [label="Jest w nim wiele cech, których po prostu nie potrafi okazać. To nie jest zbroja sama w sobie, on po prostu nie ma zaufania, że ludzie go nie zranią.",shape=box,color=red];
		j182484812 -> j2675282161;
	j3237504252 [label="Jego serce... zostało wielokrotnie złamane w ciągu jego życia. Przez to jest okryte bliznami i kolcami, to tyle.",shape=box,color=red];
		j3237504252 -> j2290904796;
	j2870699963 [label="Chyba rozumiem, jak długo żył. Doświadczyłem tyle samo śmierci, co on.",shape=box,color=red];
		j2870699963 -> j3637946848;
	j4008023897 [label="Zawsze starał się robić to, co słuszne. Może w niewłaściwy sposób, to na pewno – ale próbował ocalić System Origin przed Orokin.",shape=box,color=red];
		j4008023897 -> j3763929072;
	j470921926 [label="Podoba mi się jego ironiczne poczucie humoru. Jest mądry, kiedy już przebijesz się przez jego ego.",shape=box,color=red];
		j470921926 -> j3472862208;
	j3770030583 [label="Cóż ! Kiedy nadejdzie czas, będę gotowa !",shape=box,color=blue];
		j3770030583 -> j3569999725;
	j520724576 [label="Ale nigdy w chwilach prywatności. Non. Jamais.",shape=box,color=blue];
		j520724576 -> j137100751;
		j520724576 -> j92828821;
	j492708526 [label="Tym lepiej dla nas, że jesteś niczym un ange na jego ramieniu i go utemperujesz.",shape=box,color=blue];
		j492708526 -> j2065293314;
		j492708526 -> j1222517400;
	j398466067 [label="I zgaduję, że trafiłam na szczyt tej listy, non ? Może powinnam... wziąć pod uwagę jego motywację, dlaczego postępuje tak, a nie inaczej. Potępienie nie zbawiło żadnej duszy.",shape=box,color=blue];
		j398466067 -> j2930825305;
	j2675282161 [label="Zawsze skrywamy w sobie jakiś ból. Coś, co staramy się ukryć z obawy, że inni to wykorzystają. Chyba powinnam być dla niego milsza, jeśli to, co mówisz, jest prawdą.",shape=box,color=blue];
		j2675282161 -> j2930825305;
	j2290904796 [label="Nie potrafię sobie wyobrazić, ile miłości i żalu musiał doświadczyć przez te lata. To wydaje się nierealne, nawet biorąc pod uwagę wszystko, co widziałam.",shape=box,color=blue];
		j2290904796 -> j1532294269;
	j3637946848 [label="Czasami, kiedy z nim rozmawiam, zapomina, ile stuleci przeżył. To wydaje się nierealne, nawet biorąc pod uwagę wszystko, co widziałam.",shape=box,color=blue];
		j3637946848 -> j579131108;
	j3763929072 [label="We wszystkim jest... niuans, oui ? Powód, by postąpić tak, a nie inaczej. Chyba powinnam być dla niego milsza, jeśli to, co mówisz, jest prawdą.",shape=box,color=blue];
		j3763929072 -> j2930825305;
	j3472862208 [label="Nikt nigdy nie zaprzeczył, że diabeł jest zdolny.",shape=box,color=blue];
		j3472862208 -> j3560299279;
	j137100751 [label="Zaskoczyłaś mnie. Jestem pod wrażeniem.",shape=box,color=red];
		j137100751 -> j354654294;
	j92828821 [label="Nie znałem tej części ciebie.",shape=box,color=red];
		j92828821 -> j354654294;
	j2065293314 [label="Niczego nie obiecuję.",shape=box,color=red];
		j2065293314 -> j2696337660;
	j1222517400 [label="Kto mówi, że próbuję go utemperować?",shape=box,color=red];
		j1222517400 -> j3004929663;
	j2930825305 [label="+10 Chemistry",color=orange];
		j2930825305 -> j266444215;
	j1532294269 [label="Oui, jaką szkodę może to wyrządzić duszy ? Widzę, dlaczego pragnąłeś znaleźć kogoś, kto by cię zrozumiał. On tak samo.",shape=box,color=blue];
		j1532294269 -> j2930825305;
	j579131108 [label="Żyć tak długo, ujrzeć tyle śmierci... za tak wiele z niej być samemu odpowiedzialnym ?",shape=box,color=blue];
		j579131108 -> j1532294269;
	j3560299279 [label="+5 Chemistry",color=orange];
		j3560299279 -> j266444215;
	j2696337660 [label="Add 1 to Thermostat counter",color=orange];
		j2696337660 -> j122188303;
	j3004929663 [label="Add -1 to Thermostat counter",color=orange];
		j3004929663 -> j3322623215;
	j266444215 [label="Po prostu cieszę się, że diabeł może porozmawiać z kimś, kto może go utemperować. Un ange na jego ramieniu.",shape=box,color=blue];
		j266444215 -> j1222517400;
