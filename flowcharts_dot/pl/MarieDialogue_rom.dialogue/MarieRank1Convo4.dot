digraph {
	237 [label="MarieRank1Convo4 begins.",color=orange];
		237 -> 238;
	238 [label="Mogę zadać pytanie, które mam nadzieję nie będzie zbyt niegrzeczne ? To wciąż dopiero początek naszej przyjaźni, szczególnie dla Ciebie, który przeżyłeś tak wiele lat.",shape=box,color=blue];
		238 -> 241;
		238 -> 240;
		238 -> 239;
	241 [label="Szczerze mówiąc, większość z tych lat zapomniałem. ",shape=box,color=red];
		241 -> 244;
	240 [label="Oczywiście, nie mam nic przeciwko.",shape=box,color=red];
		240 -> 243;
	239 [label="[Koniec]",shape=box,color=red];
		239 -> 242;
	244 [label="Na Sol ! Twoje słowa łamią mi serce. Umysły Twoje i diabła są jak książki, z których wyrwano całe rozdziały, non ?",shape=box,color=blue];
		244 -> 246;
		244 -> 247;
	243 [label="+5 Chemistry",color=orange];
		243 -> 245;
	242 [label="Chat ends.",color=orange];
	246 [label="Nie tęsknię za przeszłością, której nie pamiętam.",shape=box,color=red];
		246 -> 250;
	247 [label="Z zupełnie różnych powodów, ale tak.",shape=box,color=red];
		247 -> 251;
	245 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		245 -> 249 [label="x > 0",color=purple];
		245 -> 248 [label="x <= 0",color=purple];
		245 -> 248 [label="false",color=purple];
	250 [label="Mówisz prawdę ? Więc wydaje się, że jesteś jedynym, który tak myśli. Między dzieckiem i diabłem, oboje zdają się szukać części siebie, które zagubili.",shape=box,color=blue];
		250 -> 255;
		250 -> 256;
	251 [label="Czy mogę zapytać, dlaczego czujesz się taki osamotniony? Powody dziecka i diabła są mi znane, ale Twoje nie.",shape=box,color=blue];
		251 -> 255;
		251 -> 256;
	249 [label="Dlaczego zdecydowałeś się wspomóc diabła w jego planach ? Usłyszałam, że odpowiadasz za rzeź jego braci i sióstr.",shape=box,color=blue];
		249 -> 252;
		249 -> 253;
		249 -> 254;
	248 [label="Czy masz zamiar wspomóc diabła w jego planach ? Usłyszałam, że odpowiadasz za rzeź jego braci i sióstr.",shape=box,color=blue];
		248 -> 252;
		248 -> 253;
		248 -> 254;
	255 [label="Spędziłem niezliczone lata ginąc z rąk... siebie samego? Nie przeszkadza mi, że nie pamiętam każdej ze śmierci.",shape=box,color=red];
		255 -> 260;
	256 [label="Krótko mówiąc, spędziłem wiele lat... cierpiąc. Myślę, że niepamięć to jakiś mechanizm obronny.",shape=box,color=red];
		256 -> 261;
	252 [label="To było moje drugie ja. Wierzę w winę jednostek, nie społeczeństw.",shape=box,color=red];
		252 -> 257;
	253 [label="To nie byłem ja, tylko dzieciak. Ale nienawidzę Orokin równie mocno, co dzieciak.",shape=box,color=red];
		253 -> 258;
	254 [label="Nie było mnie tam, w Noc Bębnów Nag, kiedy Tenno zwrócili się przeciwko Orokin. To była robota dzieciaka.",shape=box,color=red];
		254 -> 259;
	260 [label="Nie winię Cię za to. Gdyby mnie spotkał tak okrutny los, sama chciałabym odrzucić go w niepamięć. A przynajmniej starałabym się do niego nie wracać.",shape=box,color=blue];
		260 -> 265;
	261 [label="Nie mam żadnych wątpliwości! Gdybym sama była ofiarą takiej przemocy, moja dusza postąpiłaby tak samo. Wszystko, czego nie da się naprawić, schowałaby w kąt.",shape=box,color=blue];
		261 -> 265;
	257 [label="Add 1 to Thermostat",color=orange];
		257 -> 262;
	258 [label="Add -1 to Thermostat",color=orange];
		258 -> 263;
	259 [label="Noc Bębnów Nag. Och, już to widzę oczami wyobraźni. Quelles couleurs magnifiques !",shape=box,color=blue];
		259 -> 264;
	265 [label="+5 Chemistry",color=orange];
		265 -> 268;
	262 [label="Oui, je comprends. Tak śpieszno nam spalić budynek do cna, gdy to smród ściągnął szczury do ścian.",shape=box,color=blue];
		262 -> 266;
	263 [label="Je meurs d'envie de savoir pourquoi ! To jednak rozmowa na inny temat, albo pozostaniemy tu na zawsze, a Monsieur Loid zmęczy się moją obecnością.",shape=box,color=blue];
		263 -> 267;
	264 [label="Zapytam Monsieur Loida o szczegóły, ale !",shape=box,color=blue];
		264 -> 267;
	268 [label="Chociaż może to dać mi pewien wgląd w to, o czym chciałam z Tobą porozmawiać.",shape=box,color=blue];
		268 -> 245;
	266 [label="To jednak rozmowa na inny temat, albo pozostaniemy tu na zawsze, a Monsieur Loid zmęczy się moją obecnością.",shape=box,color=blue];
		266 -> 267;
	267 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		267 -> 270 [label="x > 0",color=purple];
		267 -> 269 [label="x <= 0",color=purple];
		267 -> 269 [label="false",color=purple];
	270 [label="Pardonnez-moi ! Nie daję Ci szansy odpowiedzieć. Dlaczego więc chcesz pomóc diabłu ?",shape=box,color=blue];
		270 -> 274;
		270 -> 273;
		270 -> 272;
		270 -> 271;
	269 [label="Pardonnez-moi ! Nie daję Ci szansy odpowiedzieć. Czy pomożesz więc diabłu ?",shape=box,color=blue];
		269 -> 271;
		269 -> 272;
		269 -> 273;
		269 -> 274;
	274 [label="Nie pokazał, że nie jest wart pomocy... póki co.",shape=box,color=red];
		274 -> 278;
	273 [label="Nie uważam, że mogę sobie pozwolić na odtrącanie sojuszników.",shape=box,color=red];
		273 -> 277;
	272 [label="[Wyznaj, że interesujesz się Roathem.] Jest w nim coś fascynującego...",shape=box,color=red];
		272 -> 276;
	271 [label="Wydaje mi się, że tylko próbuje przeżyć. Nie mogę go za to winić.",shape=box,color=red];
		271 -> 275;
	278 [label="Add 1 to Thermostat",color=orange];
		278 -> 282;
	277 [label="Update boolean MarieRoatheSoldier",color=orange];
		277 -> 281;
	276 [label="Update boolean DrifterRoathe",color=orange];
		276 -> 280;
	275 [label="Add -1 to Thermostat",color=orange];
		275 -> 279;
	282 [label="+5 Chemistry",color=orange];
		282 -> 285;
	281 [label="Ach, rozumiem. Zależy Ci tylko na zbieraniu żołnierzy. Ten diabeł prędzej sam wbije nóż w Twoje plecy, niż stanie w Twojej obronie.",shape=box,color=blue];
		281 -> 284;
	280 [label="Le diable séduit les cœurs les plus forts. Gra podstępnie, więc uważaj na siebie. Bądź pewien, że wiesz co robisz. ",shape=box,color=blue];
		280 -> 283;
	279 [label="Wydaje mi się, że przetrwał dłużej, niż ktokolwiek powinien. Może piekło powinno spróbować odzyskać swoje zagubione dziecko.",shape=box,color=blue];
		279 -> 283;
	285 [label="Pochwalam Twoje współczucie, napełnia moje serce radością. Świetliści uczą nas, że każdy zasługuje na pomoc. Każdy zasługuje na przebaczenie, ale... tylko jeśli sami tego pragną.",shape=box,color=blue];
		285 -> 290;
	284 [label="Nie jest po Twojej stronie i nigdy nie będzie. Ten diabeł pracuje tylko z tymi, których jest w stanie wykorzystać.",shape=box,color=blue];
		284 -> 287;
		284 -> 288;
		284 -> 289;
	283 [label="+5 Chemistry",color=orange];
		283 -> 286;
	290 [label="Pomagać tym, którzy nie uronili ani kropli potu na polu własnego odkupienia — to życie niekończącej się pracy niewolnika.",shape=box,color=blue];
		290 -> 287;
		290 -> 288;
		290 -> 289;
	287 [label="Znam Orokin i jego sytuację lepiej niż Ty. Nie potrzebuję Twojej pomocy.",shape=box,color=red];
		287 -> 291;
	288 [label="Doceniam Twoje ostrzeżenia, będę miał je na uwadze.",shape=box,color=red];
		288 -> 292;
	289 [label="Dzięki. Umiem o siebie zadbać. A co ważniejsze, radziłem sobie z gorszymi od niego.",shape=box,color=red];
		289 -> 293;
	286 [label="Ale staję się niemiła... nie znasz go. Nie widzisz go, jakim jest. A ja tylko nie chcę, żebyś został zraniony.",shape=box,color=blue];
		286 -> 287;
		286 -> 288;
		286 -> 289;
	291 [label="Update boolean MarieRoatheWarning",color=orange];
		291 -> 294;
	292 [label="+10 Chemistry",color=orange];
		292 -> 295;
	293 [label="+5 Chemistry",color=orange];
		293 -> 296;
	294 [label="Pardon. Nie poznałam jeszcze Twojej zdolności oparcia się manipulacji. Po prostu się martwię, złożyliśmy na Twoich barkach wiele z naszych trosk.",shape=box,color=blue];
		294 -> 297;
	295 [label="Nie mogę prosić o nic więcej. Merci, merci, merci. Teraz obawiam się, że przyszła na mnie pora.",shape=box,color=blue];
		295 -> 298;
	296 [label="Oui, vous avez raison. Nie poznałam jeszcze Twojej zdolności oparcia się manipulacji. Po prostu się martwię, złożyliśmy na Twoich barkach wiele z naszych trosk.",shape=box,color=blue];
		296 -> 299;
	297 [label="Już się nie zapomnę.",shape=box,color=blue];
		297 -> 300;
	298 [label="Chat ends.",color=orange];
	299 [label="Obawiam się, że to już pora na mnie.",shape=box,color=blue];
		299 -> 301;
	300 [label="Chat ends.",color=orange];
	301 [label="Chat ends.",color=orange];
}