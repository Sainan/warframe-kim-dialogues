	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo4 begins." [color=orange];
		"MarieRank1Convo4 begins." -> j2106186823;
	j2106186823 [label="Mogę zadać pytanie, które mam nadzieję nie będzie zbyt niegrzeczne ? To wciąż dopiero początek naszej przyjaźni, szczególnie dla Ciebie, który przeżyłeś tak wiele lat.",shape=box,color=blue];
		j2106186823 -> j1534480125;
		j2106186823 -> j1640945031;
		j2106186823 -> j386906797;
	j1534480125 [label="Szczerze mówiąc, większość z tych lat zapomniałem. ",shape=box,color=red];
		j1534480125 -> j2115867646;
	j1640945031 [label="Oczywiście, nie mam nic przeciwko.",shape=box,color=red];
		j1640945031 -> j2947588656;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j2115867646 [label="Na Sol ! Twoje słowa łamią mi serce. Umysły Twoje i diabła są jak książki, z których wyrwano całe rozdziały, non ?",shape=box,color=blue];
		j2115867646 -> j883439835;
		j2115867646 -> j3671651772;
	j2947588656 [label="+5 Chemistry",color=orange];
		j2947588656 -> j523704316;
	"Chat ends." [color=orange];
	j883439835 [label="Nie tęsknię za przeszłością, której nie pamiętam.",shape=box,color=red];
		j883439835 -> j2577171189;
	j3671651772 [label="Z zupełnie różnych powodów, ale tak.",shape=box,color=red];
		j3671651772 -> j3008273509;
	j523704316 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j523704316 -> j3578505122 [label="x > 0",color=purple];
		j523704316 -> j3500557069 [label="x <= 0",color=purple];
		j523704316 -> j3500557069 [label="false",color=purple];
	j2577171189 [label="Mówisz prawdę ? Więc wydaje się, że jesteś jedynym, który tak myśli. Między dzieckiem i diabłem, oboje zdają się szukać części siebie, które zagubili.",shape=box,color=blue];
		j2577171189 -> j4014501487;
		j2577171189 -> j1433923776;
	j3008273509 [label="Czy mogę zapytać, dlaczego czujesz się taki osamotniony? Powody dziecka i diabła są mi znane, ale Twoje nie.",shape=box,color=blue];
		j3008273509 -> j4014501487;
		j3008273509 -> j1433923776;
	j3578505122 [label="Dlaczego zdecydowałeś się wspomóc diabła w jego planach ? Usłyszałam, że odpowiadasz za rzeź jego braci i sióstr.",shape=box,color=blue];
		j3578505122 -> j3886465502;
		j3578505122 -> j3307218793;
		j3578505122 -> j1952878541;
	j3500557069 [label="Czy masz zamiar wspomóc diabła w jego planach ? Usłyszałam, że odpowiadasz za rzeź jego braci i sióstr.",shape=box,color=blue];
		j3500557069 -> j3886465502;
		j3500557069 -> j3307218793;
		j3500557069 -> j1952878541;
	j4014501487 [label="Spędziłem niezliczone lata ginąc z rąk... siebie samego? Nie przeszkadza mi, że nie pamiętam każdej ze śmierci.",shape=box,color=red];
		j4014501487 -> j3145666792;
	j1433923776 [label="Krótko mówiąc, spędziłem wiele lat... cierpiąc. Myślę, że niepamięć to jakiś mechanizm obronny.",shape=box,color=red];
		j1433923776 -> j1545007992;
	j3886465502 [label="To było moje drugie ja. Wierzę w winę jednostek, nie społeczeństw.",shape=box,color=red];
		j3886465502 -> j1491948650;
	j3307218793 [label="To nie byłem ja, tylko dzieciak. Ale nienawidzę Orokin równie mocno, co dzieciak.",shape=box,color=red];
		j3307218793 -> j2168199427;
	j1952878541 [label="Nie było mnie tam, w Noc Bębnów Nag, kiedy Tenno zwrócili się przeciwko Orokin. To była robota dzieciaka.",shape=box,color=red];
		j1952878541 -> j1170679603;
	j3145666792 [label="Nie winię Cię za to. Gdyby mnie spotkał tak okrutny los, sama chciałabym odrzucić go w niepamięć. A przynajmniej starałabym się do niego nie wracać.",shape=box,color=blue];
		j3145666792 -> j2612955630;
	j1545007992 [label="Nie mam żadnych wątpliwości! Gdybym sama była ofiarą takiej przemocy, moja dusza postąpiłaby tak samo. Wszystko, czego nie da się naprawić, schowałaby w kąt.",shape=box,color=blue];
		j1545007992 -> j2612955630;
	j1491948650 [label="Add 1 to Thermostat counter",color=orange];
		j1491948650 -> j2174433473;
	j2168199427 [label="Add -1 to Thermostat counter",color=orange];
		j2168199427 -> j3057576536;
	j1170679603 [label="Noc Bębnów Nag. Och, już to widzę oczami wyobraźni. Quelles couleurs magnifiques !",shape=box,color=blue];
		j1170679603 -> j1051281610;
	j2612955630 [label="+5 Chemistry",color=orange];
		j2612955630 -> j3325227807;
	j2174433473 [label="Oui, je comprends. Tak śpieszno nam spalić budynek do cna, gdy to smród ściągnął szczury do ścian.",shape=box,color=blue];
		j2174433473 -> j3922350973;
	j3057576536 [label="Je meurs d'envie de savoir pourquoi ! To jednak rozmowa na inny temat, albo pozostaniemy tu na zawsze, a Monsieur Loid zmęczy się moją obecnością.",shape=box,color=blue];
		j3057576536 -> j4192617946;
	j1051281610 [label="Zapytam Monsieur Loida o szczegóły, ale !",shape=box,color=blue];
		j1051281610 -> j4192617946;
	j3325227807 [label="Chociaż może to dać mi pewien wgląd w to, o czym chciałam z Tobą porozmawiać.",shape=box,color=blue];
		j3325227807 -> j523704316;
	j3922350973 [label="To jednak rozmowa na inny temat, albo pozostaniemy tu na zawsze, a Monsieur Loid zmęczy się moją obecnością.",shape=box,color=blue];
		j3922350973 -> j4192617946;
	j4192617946 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4192617946 -> j2817589294 [label="x > 0",color=purple];
		j4192617946 -> j933250833 [label="x <= 0",color=purple];
		j4192617946 -> j933250833 [label="false",color=purple];
	j2817589294 [label="Pardonnez-moi ! Nie daję Ci szansy odpowiedzieć. Dlaczego więc chcesz pomóc diabłu ?",shape=box,color=blue];
		j2817589294 -> j188198313;
		j2817589294 -> j1183270132;
		j2817589294 -> j1085211175;
		j2817589294 -> j2093587386;
	j933250833 [label="Pardonnez-moi ! Nie daję Ci szansy odpowiedzieć. Czy pomożesz więc diabłu ?",shape=box,color=blue];
		j933250833 -> j2093587386;
		j933250833 -> j1085211175;
		j933250833 -> j1183270132;
		j933250833 -> j188198313;
	j188198313 [label="Nie pokazał, że nie jest wart pomocy... póki co.",shape=box,color=red];
		j188198313 -> j518450749;
	j1183270132 [label="Nie uważam, że mogę sobie pozwolić na odtrącanie sojuszników.",shape=box,color=red];
		j1183270132 -> j321753256;
	j1085211175 [label="[Wyznaj, że interesujesz się Roathem.] Jest w nim coś fascynującego...",shape=box,color=red];
		j1085211175 -> j2472224234;
	j2093587386 [label="Wydaje mi się, że tylko próbuje przeżyć. Nie mogę go za to winić.",shape=box,color=red];
		j2093587386 -> j4124706673;
	j518450749 [label="Add 1 to Thermostat counter",color=orange];
		j518450749 -> j1744337351;
	j321753256 [label="Boolean MarieRoatheSoldier is now true.",color=orange];
		j321753256 -> j1424823769;
	j2472224234 [label="Boolean DrifterRoathe is now true.",color=orange];
		j2472224234 -> j1937206708;
	j4124706673 [label="Add -1 to Thermostat counter",color=orange];
		j4124706673 -> j3632479382;
	j1744337351 [label="+5 Chemistry",color=orange];
		j1744337351 -> j2248755047;
	j1424823769 [label="Ach, rozumiem. Zależy Ci tylko na zbieraniu żołnierzy. Ten diabeł prędzej sam wbije nóż w Twoje plecy, niż stanie w Twojej obronie.",shape=box,color=blue];
		j1424823769 -> j1212254921;
	j1937206708 [label="Le diable séduit les cœurs les plus forts. Gra podstępnie, więc uważaj na siebie. Bądź pewien, że wiesz co robisz. ",shape=box,color=blue];
		j1937206708 -> j1830883901;
	j3632479382 [label="Wydaje mi się, że przetrwał dłużej, niż ktokolwiek powinien. Może piekło powinno spróbować odzyskać swoje zagubione dziecko.",shape=box,color=blue];
		j3632479382 -> j1830883901;
	j2248755047 [label="Pochwalam Twoje współczucie, napełnia moje serce radością. Świetliści uczą nas, że każdy zasługuje na pomoc. Każdy zasługuje na przebaczenie, ale... tylko jeśli sami tego pragną.",shape=box,color=blue];
		j2248755047 -> j47110459;
	j1212254921 [label="Nie jest po Twojej stronie i nigdy nie będzie. Ten diabeł pracuje tylko z tymi, których jest w stanie wykorzystać.",shape=box,color=blue];
		j1212254921 -> j3729356369;
		j1212254921 -> j2514417499;
		j1212254921 -> j3923578002;
	j1830883901 [label="+5 Chemistry",color=orange];
		j1830883901 -> j4178890016;
	j47110459 [label="Pomagać tym, którzy nie uronili ani kropli potu na polu własnego odkupienia — to życie niekończącej się pracy niewolnika.",shape=box,color=blue];
		j47110459 -> j3729356369;
		j47110459 -> j2514417499;
		j47110459 -> j3923578002;
	j3729356369 [label="Znam Orokin i jego sytuację lepiej niż Ty. Nie potrzebuję Twojej pomocy.",shape=box,color=red];
		j3729356369 -> j3111336389;
	j2514417499 [label="Doceniam Twoje ostrzeżenia, będę miał je na uwadze.",shape=box,color=red];
		j2514417499 -> j1053830506;
	j3923578002 [label="Dzięki. Umiem o siebie zadbać. A co ważniejsze, radziłem sobie z gorszymi od niego.",shape=box,color=red];
		j3923578002 -> j1635957494;
	j4178890016 [label="Ale staję się niemiła... nie znasz go. Nie widzisz go, jakim jest. A ja tylko nie chcę, żebyś został zraniony.",shape=box,color=blue];
		j4178890016 -> j3729356369;
		j4178890016 -> j2514417499;
		j4178890016 -> j3923578002;
	j3111336389 [label="Boolean MarieRoatheWarning is now true.",color=orange];
		j3111336389 -> j707635531;
	j1053830506 [label="+10 Chemistry",color=orange];
		j1053830506 -> j549258451;
	j1635957494 [label="+5 Chemistry",color=orange];
		j1635957494 -> j198986146;
	j707635531 [label="Pardon. Nie poznałam jeszcze Twojej zdolności oparcia się manipulacji. Po prostu się martwię, złożyliśmy na Twoich barkach wiele z naszych trosk.",shape=box,color=blue];
		j707635531 -> j331327477;
	j549258451 [label="Nie mogę prosić o nic więcej. Merci, merci, merci. Teraz obawiam się, że przyszła na mnie pora.",shape=box,color=blue];
		j549258451 -> "Chat ends.";
	j198986146 [label="Oui, vous avez raison. Nie poznałam jeszcze Twojej zdolności oparcia się manipulacji. Po prostu się martwię, złożyliśmy na Twoich barkach wiele z naszych trosk.",shape=box,color=blue];
		j198986146 -> j4024593471;
	j331327477 [label="Już się nie zapomnę.",shape=box,color=blue];
		j331327477 -> "Chat ends.";
	j4024593471 [label="Obawiam się, że to już pora na mnie.",shape=box,color=blue];
		j4024593471 -> "Chat ends.";
}