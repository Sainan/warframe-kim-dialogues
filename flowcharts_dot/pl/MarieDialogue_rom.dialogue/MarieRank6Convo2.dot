	j1016867334 [label="Wilku ! Mój wilku ! Poznałam Otaka ! W końcu go poznałam !",shape=box,color=blue];
		j1016867334 -> j553058121;
		j1016867334 -> j3826313690;
	j3121830087 [label="Poznałam Otaka ! W końcu go poznałam !",shape=box,color=blue];
		j3121830087 -> j553058121;
		j3121830087 -> j3826313690;
	j3742937951 [label="Wilku ! Mój wilku ! Twarz u tyłu głowy Monsieur Nekraloida ! W końcu ją poznałam !",shape=box,color=blue];
		j3742937951 -> j4231722046;
		j3742937951 -> j1399623555;
		j3742937951 -> j2985884464;
	j4280807574 [label="Twarz u tyłu głowy Monsieur Nekraloida ! W końcu ją poznałam !",shape=box,color=blue];
		j4280807574 -> j4231722046;
		j4280807574 -> j1399623555;
		j4280807574 -> j2985884464;
	j553058121 [label="Jesteś zadowolona z tej rozmowy?",shape=box,color=red];
		j553058121 -> j1726944583;
	j3826313690 [label="I jak udała się wasza rozmowa?",shape=box,color=red];
		j3826313690 -> j101180990;
	j4231722046 [label="Biedny Otak... jak wam poszło?",shape=box,color=red];
		j4231722046 -> j384424933;
	j1399623555 [label="Cieszę się, że w końcu się poznaliście. Otaka... dosyć trudno przedstawić.",shape=box,color=red];
		j1399623555 -> j378321439;
	j2985884464 [label="Poznałaś Otaka? A niech mnie... jak poszło?",shape=box,color=red];
		j2985884464 -> j603064698;
	j1726944583 [label="Tak ! Choć chciałam płakać z jego powodu. Przedstawił się trzykrotnie w tej samej rozmowie, jakbyśmy nigdy wcześniej się nie poznali.",shape=box,color=blue];
		j1726944583 -> j1973816004;
	j101180990 [label="Przedstawił się trzykrotnie w tej samej rozmowie, jakbyśmy nigdy wcześniej się nie poznali.",shape=box,color=blue];
		j101180990 -> j1973816004;
	j384424933 [label="Okazał się uroczy i czarujący ! Ale za grubą warstwą humoru skrywa ogromny ból.",shape=box,color=blue];
		j384424933 -> j3621283745;
	j378321439 [label="Tak, tak myślałam. Dziecięcy bazgroł na tyle maszyny. Ale okazał się uroczy i czarujący !",shape=box,color=blue];
		j378321439 -> j2646626376;
	j603064698 [label="Dlaczego wydajesz się niezadowolony tym, że go poznałam ?",shape=box,color=blue];
		j603064698 -> j2790638700;
		j603064698 -> j1047499096;
		j603064698 -> j2516916252;
	j1973816004 [label="Powitał mnie w ten sam nieustępliwie radosny sposób, jak za każdym razem wcześniej. Ale wiedział, że jestem Sœur de Sol ! ",shape=box,color=blue];
		j1973816004 -> j31103091;
	j3621283745 [label="Czy opowiesz mi historię biednego Monsieur Otaka ?",shape=box,color=blue];
		j3621283745 -> j1302183140;
	j2646626376 [label="Ale za grubą warstwą humoru skrywa ogromny ból.",shape=box,color=blue];
		j2646626376 -> j3621283745;
	j2790638700 [label="Czasami działa mi na nerwy, to tyle.",shape=box,color=red];
		j2790638700 -> j2318533312;
	j1047499096 [label="Nie chciałem, żeby to tak zabrzmiało. Otak potrafi być... trochę odpychający.",shape=box,color=red];
		j1047499096 -> j1945555519;
	j2516916252 [label="Przepraszam. Potrafi działać ludziom na nerwy, ale to nie jego wina.",shape=box,color=red];
		j2516916252 -> j1945555519;
	j31103091 [label="Wiedział naprawdę dużo o Świetlistych ! Długo rozmawialiśmy o, jak to określił, \"starożytnych religiach\", w czasach \"poprzedzających Imperium Orokin\".",shape=box,color=blue];
		j31103091 -> j2572998116;
	j1302183140 [label="Otak był kiedyś Archimedianem, uczonym Orokin. Nie spotkał go najszczęśliwszy los.",shape=box,color=red];
		j1302183140 -> j3332072562;
	j2318533312 [label="Miałabym nadzieję, że postarasz się być milszym dla kogoś, kto jest widocznie infirme. Mais par la grâce de Sol, podążamy wszyscy.",shape=box,color=blue];
		j2318533312 -> j1823763526;
	j1945555519 [label="Mam nadzieję, że okażą mu życzliwość i cierpliwość. Mais par la grâce de Sol, wszyscy podążamy.",shape=box,color=blue];
		j1945555519 -> j1823763526;
	j2572998116 [label="Choć powiedział, że wiele z tej wiedzy przepadło, zaginęło w głębinach archiwów i jest całkowicie zakazane, poprosił mnie o dochowanie tajemnicy.",shape=box,color=blue];
		j2572998116 -> j431847382;
	j3332072562 [label="Wszyscy uważali go za geniusza, za umysł, który zdołał wykorzystać kryształy argonowe.",shape=box,color=red];
		j3332072562 -> j2500363035;
	j1823763526 [label="Taki los mógłby spotkać każdego z nas, nawet ciebie.",shape=box,color=blue];
		j1823763526 -> j3491745769;
		j1823763526 -> j194377980;
	j431847382 [label="Powiedział mi, że obawia się, że Egzekutor Ballas, kimkolwiek on jest, może odkryć naszą sektę heretyków i skazać mnie na śmierć.",shape=box,color=blue];
		j431847382 -> j3194029669;
		j431847382 -> j1355975808;
	j2500363035 [label="Które pozyskiwał z Pustki, to dzięki nim byliśmy w stanie stworzyć wiele potężnych warframe’ów i broni.",shape=box,color=red];
		j2500363035 -> j2702746673;
	j3491745769 [label="Masz rację, przepraszam. Źle się wyraziłem.",shape=box,color=red];
		j3491745769 -> j3621283745;
	j194377980 [label="Przepraszam, po prostu nie mam czasu, żeby się nim zajmować.",shape=box,color=red];
		j194377980 -> j2884409040;
	j3194029669 [label="Ballas już nie żyje... kontynuuj.",shape=box,color=red];
		j3194029669 -> j3732886919;
	j1355975808 [label="Nie dojdzie do tego. Kontynuuj.",shape=box,color=red];
		j1355975808 -> j3732886919;
	j2702746673 [label="Jego specjalizacją była krystalografia. A jego prace odbywały się tutaj, w tych laboratoriach.",shape=box,color=red];
		j2702746673 -> j4286137983;
	j2884409040 [label="A więc przepraszam, że marnuję twój cenny czas.",shape=box,color=blue];
		j2884409040 -> j3007723528;
	j3732886919 [label="+5 Chemistry",color=orange];
		j3732886919 -> j1972740057;
	j4286137983 [label="Z nieznanego mi powodu został przemieniony w Cefalona i otrzymał nekraloidową powłokę.",shape=box,color=red];
		j4286137983 -> j1925018344;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j1972740057 [label="Podejrzewałam... Zapytał mnie, skąd jestem, a kiedy odpowiedziałam, zaśmiał się i powiedział \"nie, to niemożliwe! Jestem tego pewien, jestem przecież -\"",shape=box,color=blue];
		j1972740057 -> j1551594573;
	j1925018344 [label="Nie wszystkie Cefalony powstały za karę. Ale sprawy na Deimosie... nie szły dobrze, a on został poważnie uszkodzony.",shape=box,color=red];
		j1925018344 -> j2105349457;
	j1551594573 [label="I wtedy... znów mi się przedstawił. Zapytał mnie, czy wracam z równin z próbkami materiałów...",shape=box,color=blue];
		j1551594573 -> j3217004207;
		j1551594573 -> j721889388;
	j2105349457 [label="Pauvre petit...",shape=box,color=blue];
		j2105349457 -> j253530729;
	j3217004207 [label="Tak... to brzmi jak Otak.",shape=box,color=red];
		j3217004207 -> j139036099;
	j721889388 [label="Och, tak mi przykro...",shape=box,color=red];
		j721889388 -> j139036099;
	j253530729 [label="Boolean MarieOtak1 is now true.",color=orange];
		j253530729 -> j553058121;
		j253530729 -> j3826313690;
	j139036099 [label="Moje serce płacze na myśl o tym, że nie jesteśmy w stanie mu pomóc.",shape=box,color=blue];
		j139036099 -> j457335464;
	j457335464 [label="Evaluate expressions",color=orange];
		j457335464 -> j1361524141 [label="MarieCephalonSoul",color=purple];
		j457335464 -> j2653745726 [label="MarieCephalonNoSoul",color=purple];
		j457335464 -> j3067603057 [label="MarieCephalonUnsure",color=purple];
		j457335464 -> j1424661028 [label="false",color=purple];
	j1361524141 [label="Och, Świetliści – na jakie piekło go skazaliście ? Dlaczego jego dusza została uwięziona w klatce nauki i migających świateł ?",shape=box,color=blue];
		j1361524141 -> j1283774720;
	j2653745726 [label="Mogę tylko modlić się do Świetlistych, żebyś miał rację i wszystko co pozostało wewnątrz tej powłoki, było tylko... nauką i świecącymi lampkami.",shape=box,color=blue];
		j2653745726 -> j864648347;
	j3067603057 [label="Wiem, że nie jesteś pewien, czy Cefalony mają duszę, ale mogę tylko modlić się do Świetlistych... żeby biedny Otak nie musiał cierpieć.",shape=box,color=blue];
		j3067603057 -> j61407167;
	j1424661028 [label="Mogę tylko modlić się do Świetlistych, żeby wszystko co pozostało wewnątrz tej powłoki, było tylko... nauką i świecącymi lampkami.",shape=box,color=blue];
		j1424661028 -> j3817000172;
	j1283774720 [label="Dlaczego został porzucony, zniszczony i czekający, aż będzie dane mu umrzeć i zaznać spokoju ? Mogę tylko się modlić... że jeśli została w nim jakaś resztka bytu...",shape=box,color=blue];
		j1283774720 -> j3268530766;
	j864648347 [label="Żeby żadna dusza nie była uwięziona w tej zepsutej maszynie, czekając, aż ktoś pozwoli mu umrzeć i zaznać spokoju.",shape=box,color=blue];
		j864648347 -> j2228217727;
	j61407167 [label="I żeby żadna dusza nie była uwięziona w tej zepsutej maszynie, czekając, aż ktoś pozwoli mu umrzeć i zaznać spokoju.",shape=box,color=blue];
		j61407167 -> j1164739443;
	j3817000172 [label="Żeby żadna dusza nie była uwięziona w tej zepsutej maszynie, czekając, aż ktoś pozwoli mu umrzeć i zaznać spokoju.",shape=box,color=blue];
		j3817000172 -> j1164739443;
	j3268530766 [label="Pozostaje ona tam z jego wyboru, ku jego pamięci...",shape=box,color=blue];
		j3268530766 -> j3862827749;
	j2228217727 [label="Bo jeśli się mylisz ? I dusza pozostaje uwięziona w tej klatce wbrew jej woli ?",shape=box,color=blue];
		j2228217727 -> j2962516332;
	j1164739443 [label="A jeśli pozostaje w nim jakaś resztka człowieczeństwa, istnieje ona z jego wyboru, ku jego pamięci.",shape=box,color=blue];
		j1164739443 -> j3862827749;
	j3862827749 [label="Dopuścić inną możliwość wymagałoby zastanowienia się nad łaskawością samych bogów, non ?",shape=box,color=blue];
		j3862827749 -> j2886832807;
	j2962516332 [label="To wymagałoby zastanowienia się nad łaskawością samych bogów, non ?",shape=box,color=blue];
		j2962516332 -> j2886832807;
	j2886832807 [label="I co ja bym dalej poczęła ?",shape=box,color=blue];
		j2886832807 -> j3030258935;
	j3030258935 [label="Przepraszam... ogarnia mnie dzisiaj melancholia. ",shape=box,color=blue];
		j3030258935 -> j3251038745;
