		3482 -> 3486 [label=false,color=brown];
	3483 [label="Wilku ! Mój wilku ! Poznałam Otaka ! W końcu go poznałam !",shape=box,color=blue];
		3483 -> 3487;
		3483 -> 3488;
	3484 [label="Poznałam Otaka ! W końcu go poznałam !",shape=box,color=blue];
		3484 -> 3487;
		3484 -> 3488;
	3485 [label="Wilku ! Mój wilku ! Twarz u tyłu głowy Monsieur Nekraloida ! W końcu ją poznałam !",shape=box,color=blue];
		3485 -> 3489;
		3485 -> 3490;
		3485 -> 3491;
	3486 [label="Twarz u tyłu głowy Monsieur Nekraloida ! W końcu ją poznałam !",shape=box,color=blue];
		3486 -> 3489;
		3486 -> 3490;
		3486 -> 3491;
	3487 [label="Jesteś zadowolona z tej rozmowy?",shape=box,color=red];
		3487 -> 3492;
	3488 [label="I jak udała się wasza rozmowa?",shape=box,color=red];
		3488 -> 3493;
	3489 [label="Poor Otak... How did that go?",shape=box,color=red];
		3489 -> 3494;
	3490 [label="Cieszę się, że w końcu się poznaliście. Otaka... dosyć trudno przedstawić.",shape=box,color=red];
		3490 -> 3495;
	3491 [label="Poznałaś Otaka? A niech mnie... jak poszło?",shape=box,color=red];
		3491 -> 3496;
	3492 [label="Tak ! Choć chciałam płakać z jego powodu. Przedstawił się trzykrotnie w tej samej rozmowie, jakbyśmy nigdy wcześniej się nie poznali.",shape=box,color=blue];
		3492 -> 3497;
	3493 [label="Przedstawił się trzykrotnie w tej samej rozmowie, jakbyśmy nigdy wcześniej się nie poznali.",shape=box,color=blue];
		3493 -> 3497;
	3494 [label="Okazał się uroczy i czarujący ! Ale za grubą warstwą humoru skrywa ogromny ból.",shape=box,color=blue];
		3494 -> 3498;
	3495 [label="Yes, I would think so. A child's scrawl written on the back of an automaton. I found him nothing but sweet and charming !",shape=box,color=blue];
		3495 -> 3499;
	3496 [label="Dlaczego wydajesz się niezadowolony tym, że go poznałam ?",shape=box,color=blue];
		3496 -> 3500;
		3496 -> 3501;
		3496 -> 3502;
	3497 [label="Powitał mnie w ten sam nieustępliwie radosny sposób, jak za każdym razem wcześniej. Ale wiedział, że jestem Sœur de Sol ! ",shape=box,color=blue];
		3497 -> 3503;
	3498 [label="Czy opowiesz mi historię biednego Monsieur Otaka ?",shape=box,color=blue];
		3498 -> 3504;
	3499 [label="Ale za grubą warstwą humoru skrywa ogromny ból.",shape=box,color=blue];
		3499 -> 3498;
	3500 [label="He can get on my nerves sometimes, is all. ",shape=box,color=red];
		3500 -> 3505;
	3501 [label="Nie chciałem, żeby to tak zabrzmiało. Otak potrafi być... trochę odpychający.",shape=box,color=red];
		3501 -> 3506;
	3502 [label="Przepraszam. Potrafi działać ludziom na nerwy, ale to nie jego wina.",shape=box,color=red];
		3502 -> 3506;
	3503 [label="Wiedział naprawdę dużo o Świetlistych ! Długo rozmawialiśmy o, jak to określił, \"starożytnych religiach\", w czasach \"poprzedzających Imperium Orokin\".",shape=box,color=blue];
		3503 -> 3507;
	3504 [label="Otak był kiedyś Archimedianem, uczonym Orokin. Nie spotkał go najszczęśliwszy los.",shape=box,color=red];
		3504 -> 3508;
	3505 [label="Miałabym nadzieję, że postarasz się być milszym dla kogoś, kto jest widocznie infirme. Mais par la grâce de Sol, podążamy wszyscy.",shape=box,color=blue];
		3505 -> 3509;
	3506 [label="Mam nadzieję, że okażą mu życzliwość i cierpliwość. Mais par la grâce de Sol, wszyscy podążamy.",shape=box,color=blue];
		3506 -> 3509;
	3507 [label="Choć powiedział, że wiele z tej wiedzy przepadło, zaginęło w głębinach archiwów i jest całkowicie zakazane, poprosił mnie o dochowanie tajemnicy.",shape=box,color=blue];
		3507 -> 3510;
	3508 [label="Wszyscy uważali go za geniusza, za umysł, który zdołał wykorzystać kryształy argonowe.",shape=box,color=red];
		3508 -> 3511;
	3509 [label="Taki los mógłby spotkać każdego z nas, nawet ciebie.",shape=box,color=blue];
		3509 -> 3512;
		3509 -> 3513;
	3510 [label="He told me that he was deeply concerned that Executor Ballas - whoever he may be - might discover my sect of heretics and have me executed.",shape=box,color=blue];
		3510 -> 3514;
		3510 -> 3515;
	3511 [label="Which are harnessed from the Void - they're the reason we can create a lot of the powerful warframes and weapons we make.",shape=box,color=red];
		3511 -> 3516;
	3512 [label="Masz rację, przepraszam. Źle się wyraziłem.",shape=box,color=red];
		3512 -> 3498;
	3513 [label="Przepraszam, po prostu nie mam czasu, żeby się nim zajmować.",shape=box,color=red];
		3513 -> 3517;
	3514 [label="Ballas is dead... keep going.",shape=box,color=red];
		3514 -> 3518;
	3515 [label="That... won't happen. Keep talking.",shape=box,color=red];
		3515 -> 3518;
	3516 [label="Jego specjalizacją była krystalografia. A jego prace odbywały się tutaj, w tych laboratoriach.",shape=box,color=red];
		3516 -> 3519;
	3517 [label="A więc przepraszam, że marnuję twój cenny czas.",shape=box,color=blue];
		3517 -> 3520;
	3518 [label="+5 Chemistry",color=orange];
		3518 -> 3521;
	3519 [label="For some reason, I don't know why, he was turned into a Cephalon, and given his own necraloid shell.",shape=box,color=red];
		3519 -> 3522;
	3520 [label="Update boolean MarieOtakComplete",color=orange];
		3520 -> 3523;
	3521 [label="Podejrzewałam... Zapytał mnie, skąd jestem, a kiedy odpowiedziałam, zaśmiał się i powiedział \"nie, to niemożliwe! Jestem tego pewien, jestem przecież -\"",shape=box,color=blue];
		3521 -> 3524;
	3522 [label="Not all Cephalons were made as a punishment. But things went... poorly here on Deimos, and he was badly damaged.",shape=box,color=red];
		3522 -> 3525;
	3523 [label="Chat ends.",color=orange];
	3524 [label="And then he... introduced himself to me again. And asked me if I was coming from the plains with mineral samples...",shape=box,color=blue];
		3524 -> 3526;
		3524 -> 3527;
	3525 [label="Pauvre petit...",shape=box,color=blue];
		3525 -> 3528;
	3526 [label="Tak... to brzmi jak Otak.",shape=box,color=red];
		3526 -> 3529;
	3527 [label="Och, tak mi przykro...",shape=box,color=red];
		3527 -> 3529;
	3528 [label="Update boolean MarieOtak1",color=orange];
		3528 -> 3487;
		3528 -> 3488;
	3529 [label="Moje serce płacze na myśl o tym, że nie jesteśmy w stanie mu pomóc.",shape=box,color=blue];
		3529 -> 3530;
	3530 [label="Evaluate expressions",color=orange];
		3530 -> 3531 [label="MarieCephalonSoul",color=purple];
		3530 -> 3532 [label="MarieCephalonNoSoul",color=purple];
		3530 -> 3533 [label="MarieCephalonUnsure",color=purple];
		3530 -> 3534 [label="false",color=purple];
	3531 [label="Oh, Luminaries - what manner of hell have you made for him, to keep his soul trapped within that cage of science and flickering lights?",shape=box,color=blue];
		3531 -> 3535;
	3532 [label="I can only pray to the Luminaries that you are right and nothing remains inside that shell but... but science and flickering lights.",shape=box,color=blue];
		3532 -> 3536;
	3533 [label="I know you are not sure if the Cephalons contain souls - but I can only pray to the Luminaries that... that poor Otak does not suffer.",shape=box,color=blue];
		3533 -> 3537;
	3534 [label="I can only pray to the Luminaries that all that remains inside that shell is nothing but... but science and flickering lights.",shape=box,color=blue];
		3534 -> 3538;
	3535 [label="Why leave him there, broken and waiting until he is allowed to die to be given peace? I can only pray... that if there is some kind of presence there -",shape=box,color=blue];
		3535 -> 3539;
	3536 [label="And no soul is trapped within that broken thing, waiting until it is allowed to finally die to be given peace.",shape=box,color=blue];
		3536 -> 3540;
	3537 [label="I żeby żadna dusza nie była uwięziona w tej zepsutej maszynie, czekając, aż ktoś pozwoli mu umrzeć i zaznać spokoju.",shape=box,color=blue];
		3537 -> 3541;
	3538 [label="Żeby żadna dusza nie była uwięziona w tej zepsutej maszynie, czekając, aż ktoś pozwoli mu umrzeć i zaznać spokoju.",shape=box,color=blue];
		3538 -> 3541;
	3539 [label="Pozostaje ona tam z jego wyboru, ku jego pamięci...",shape=box,color=blue];
		3539 -> 3542;
	3540 [label="Bo jeśli się mylisz ? I dusza pozostaje uwięziona w tej klatce wbrew jej woli ?",shape=box,color=blue];
		3540 -> 3543;
	3541 [label="A jeśli pozostaje w nim jakaś resztka człowieczeństwa, istnieje ona z jego wyboru, ku jego pamięci.",shape=box,color=blue];
		3541 -> 3544;
	3542 [label="Dopuścić inną możliwość wymagałoby zastanowienia się nad łaskawością samych bogów, non ?",shape=box,color=blue];
		3542 -> 3545;
	3543 [label="To wymagałoby zastanowienia się nad łaskawością samych bogów, non ?",shape=box,color=blue];
		3543 -> 3545;
	3544 [label="Dopuścić inną możliwość wymagałoby zastanowienia się nad łaskawością samych bogów, non ?",shape=box,color=blue];
		3544 -> 3545;
	3545 [label="I co ja bym dalej poczęła ?",shape=box,color=blue];
		3545 -> 3546;
	3546 [label="Przepraszam... ogarnia mnie dzisiaj melancholia. ",shape=box,color=blue];
		3546 -> 3547;
