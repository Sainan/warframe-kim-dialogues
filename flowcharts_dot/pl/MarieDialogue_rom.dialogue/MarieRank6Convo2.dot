		3547 -> 3551 [label="false",color=purple];
	3548 [label="To zrozumiałe, masz do tego prawo.",shape=box,color=red];
		3548 -> 3552;
	3549 [label="Mogę cię jakoś rozweselić? Możemy ponękać Roathe'a.",shape=box,color=red];
		3549 -> 3553;
	3550 [label="Mogę cię jakoś rozweselić? Może ukradniemy jakieś ciastka?",shape=box,color=red];
		3550 -> 3554;
	3551 [label="Czasami bogowie potrafią być okrutni, c'est la vie.",shape=box,color=red];
		3551 -> 3555;
	3552 [label="+20 Chemistry",color=orange];
		3552 -> 3556;
	3553 [label="+15 Chemistry",color=orange];
		3553 -> 3557;
	3554 [label="+20 Chemistry",color=orange];
		3554 -> 3557;
	3555 [label="+5 Chemistry",color=orange];
		3555 -> 3558;
	3556 [label="Merci, ale nie chcę tego. Znajdę sobie jakieś wesołe zajęcie ! Myślę, że zbiornik M'sieur Fibonacciego wymaga odkurzenia.",shape=box,color=blue];
		3556 -> 3559;
	3557 [label="Ha ! Merci. To na pewno powstrzyma moje łzy. Doskonale wiesz, jak rozweselić małą głupią Marię, non ?",shape=box,color=blue];
		3557 -> 3560;
		3557 -> 3561;
	3558 [label="Oui. You are quite right. They are. The world is full of no end of stories like that of Monsieur Otak, and many far worse than his. I should not weep over one. ",shape=box,color=blue];
		3558 -> 3562;
	3559 [label="Check boolean MarieDating",color=orange];
		3559 -> 3563 [label=true,color=green];
