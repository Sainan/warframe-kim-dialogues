	3560 [label="Przynajmniej tak mogę pomóc.",shape=box,color=red];
		3560 -> 3565;
	3561 [label="To żadna głupota, czuję się tak samo.",shape=box,color=red];
		3561 -> 3565;
	3562 [label="Yet here I sit, doing just that. Thank you for reminding me of my foolishness. Fie! Silly little Marie. Well... I think M'sieur Fibonacci's tank is due for a dusting.",shape=box,color=blue];
