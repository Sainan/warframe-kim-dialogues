		j3251038745 -> j2011872007 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j3095390054 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j2222518912 [label="false",color=purple];
		j3251038745 -> j3423258817 [label="false",color=purple];
		j3251038745 -> j3095390054 [label="false",color=purple];
	j2222518912 [label="To zrozumiałe, masz do tego prawo.",shape=box,color=red];
		j2222518912 -> j3078869188;
	j3423258817 [label="Mogę cię jakoś rozweselić? Możemy ponękać Roathe'a.",shape=box,color=red];
		j3423258817 -> j392282900;
	j2011872007 [label="Mogę cię jakoś rozweselić? Może ukradniemy jakieś ciastka?",shape=box,color=red];
		j2011872007 -> j3326441463;
	j3095390054 [label="Czasami bogowie potrafią być okrutni, c'est la vie.",shape=box,color=red];
		j3095390054 -> j882690503;
	j3078869188 [label="+20 Chemistry",color=orange];
		j3078869188 -> j4089083930;
	j392282900 [label="+15 Chemistry",color=orange];
		j392282900 -> j580261876;
	j3326441463 [label="+20 Chemistry",color=orange];
		j3326441463 -> j580261876;
	j882690503 [label="+5 Chemistry",color=orange];
		j882690503 -> j1817394999;
	j4089083930 [label="Merci, ale nie chcę tego. Znajdę sobie jakieś wesołe zajęcie ! Myślę, że zbiornik M'sieur Fibonacciego wymaga odkurzenia.",shape=box,color=blue];
		j4089083930 -> j2486340526;
	j580261876 [label="Ha ! Merci. To na pewno powstrzyma moje łzy. Doskonale wiesz, jak rozweselić małą głupią Marię, non ?",shape=box,color=blue];
		j580261876 -> j2314631160;
		j580261876 -> j3690359770;
	j1817394999 [label="Oui. You are quite right. They are. The world is full of no end of stories like that of Monsieur Otak, and many far worse than his. I should not weep over one. ",shape=box,color=blue];
		j1817394999 -> j1796043549;
	j2486340526 [label="Check boolean MarieDating",color=orange];
		j2486340526 -> j4168335523 [label=true,color=green];
		j2486340526 -> j1783435543 [label=false,color=brown];
	j2314631160 [label="Przynajmniej tak mogę pomóc.",shape=box,color=red];
		j2314631160 -> j1350233930;
	j3690359770 [label="To żadna głupota, czuję się tak samo.",shape=box,color=red];
		j3690359770 -> j1350233930;
	j1796043549 [label="Yet here I sit, doing just that. Thank you for reminding me of my foolishness. Fie! Silly little Marie. Well... I think M'sieur Fibonacci's tank is due for a dusting.",shape=box,color=blue];
		j1796043549 -> j2486340526;
	j4168335523 [label="À la revoyure, my wolf.",shape=box,color=blue];
		j4168335523 -> j3007723528;
	j1783435543 [label="À la revoyure !",shape=box,color=blue];
		j1783435543 -> j3007723528;
