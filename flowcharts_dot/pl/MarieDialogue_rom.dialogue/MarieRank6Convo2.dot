		j3979133402 -> j4280807574 [label=false,color=brown];
	j1016867334 [label="Wilku ! Mój wilku ! Poznałam Otaka ! W końcu go poznałam !",shape=box,color=blue];
		j1016867334 -> j3016131687;
		j1016867334 -> j1082361161;
	j3121830087 [label="Poznałam Otaka ! W końcu go poznałam !",shape=box,color=blue];
		j3121830087 -> j3016131687;
		j3121830087 -> j1082361161;
	j3742937951 [label="Wilku ! Mój wilku ! Twarz u tyłu głowy Monsieur Nekraloida ! W końcu ją poznałam !",shape=box,color=blue];
		j3742937951 -> j3963202667;
		j3742937951 -> j3804791986;
		j3742937951 -> j2985884464;
	j4280807574 [label="Twarz u tyłu głowy Monsieur Nekraloida ! W końcu ją poznałam !",shape=box,color=blue];
		j4280807574 -> j3963202667;
		j4280807574 -> j3804791986;
		j4280807574 -> j2985884464;
	j3016131687 [label="Jesteś zadowolona z tej rozmowy?",shape=box,color=red];
		j3016131687 -> j640784374;
	j1082361161 [label="I jak udała się wasza rozmowa?",shape=box,color=red];
		j1082361161 -> j1050049876;
	j3963202667 [label="Poor Otak... How did that go?",shape=box,color=red];
		j3963202667 -> j1118283467;
	j3804791986 [label="Cieszę się, że w końcu się poznaliście. Otaka... dosyć trudno przedstawić.",shape=box,color=red];
		j3804791986 -> j2933588093;
	j2985884464 [label="Poznałaś Otaka? A niech mnie... jak poszło?",shape=box,color=red];
		j2985884464 -> j603064698;
	j640784374 [label="Tak ! Choć chciałam płakać z jego powodu. Przedstawił się trzykrotnie w tej samej rozmowie, jakbyśmy nigdy wcześniej się nie poznali.",shape=box,color=blue];
		j640784374 -> j3037202295;
	j1050049876 [label="Przedstawił się trzykrotnie w tej samej rozmowie, jakbyśmy nigdy wcześniej się nie poznali.",shape=box,color=blue];
		j1050049876 -> j3037202295;
	j1118283467 [label="Okazał się uroczy i czarujący ! Ale za grubą warstwą humoru skrywa ogromny ból.",shape=box,color=blue];
		j1118283467 -> j1260864930;
	j2933588093 [label="Yes, I would think so. A child's scrawl written on the back of an automaton. I found him nothing but sweet and charming !",shape=box,color=blue];
		j2933588093 -> j944560864;
	j603064698 [label="Dlaczego wydajesz się niezadowolony tym, że go poznałam ?",shape=box,color=blue];
		j603064698 -> j956139228;
		j603064698 -> j1047499096;
		j603064698 -> j2516916252;
	j3037202295 [label="Powitał mnie w ten sam nieustępliwie radosny sposób, jak za każdym razem wcześniej. Ale wiedział, że jestem Sœur de Sol ! ",shape=box,color=blue];
		j3037202295 -> j2896775264;
	j1260864930 [label="Czy opowiesz mi historię biednego Monsieur Otaka ?",shape=box,color=blue];
		j1260864930 -> j2815041598;
	j944560864 [label="Ale za grubą warstwą humoru skrywa ogromny ból.",shape=box,color=blue];
		j944560864 -> j1260864930;
	j956139228 [label="He can get on my nerves sometimes, is all. ",shape=box,color=red];
		j956139228 -> j2318533312;
	j1047499096 [label="Nie chciałem, żeby to tak zabrzmiało. Otak potrafi być... trochę odpychający.",shape=box,color=red];
		j1047499096 -> j1945555519;
	j2516916252 [label="Przepraszam. Potrafi działać ludziom na nerwy, ale to nie jego wina.",shape=box,color=red];
		j2516916252 -> j1945555519;
	j2896775264 [label="Wiedział naprawdę dużo o Świetlistych ! Długo rozmawialiśmy o, jak to określił, \"starożytnych religiach\", w czasach \"poprzedzających Imperium Orokin\".",shape=box,color=blue];
		j2896775264 -> j84126728;
	j2815041598 [label="Otak był kiedyś Archimedianem, uczonym Orokin. Nie spotkał go najszczęśliwszy los.",shape=box,color=red];
		j2815041598 -> j3439565637;
	j2318533312 [label="Miałabym nadzieję, że postarasz się być milszym dla kogoś, kto jest widocznie infirme. Mais par la grâce de Sol, podążamy wszyscy.",shape=box,color=blue];
		j2318533312 -> j1823763526;
	j1945555519 [label="Mam nadzieję, że okażą mu życzliwość i cierpliwość. Mais par la grâce de Sol, wszyscy podążamy.",shape=box,color=blue];
		j1945555519 -> j1823763526;
	j84126728 [label="Choć powiedział, że wiele z tej wiedzy przepadło, zaginęło w głębinach archiwów i jest całkowicie zakazane, poprosił mnie o dochowanie tajemnicy.",shape=box,color=blue];
		j84126728 -> j2746595683;
	j3439565637 [label="Wszyscy uważali go za geniusza, za umysł, który zdołał wykorzystać kryształy argonowe.",shape=box,color=red];
		j3439565637 -> j2363964885;
	j1823763526 [label="Taki los mógłby spotkać każdego z nas, nawet ciebie.",shape=box,color=blue];
		j1823763526 -> j2667499734;
		j1823763526 -> j194377980;
	j2746595683 [label="He told me that he was deeply concerned that Executor Ballas - whoever he may be - might discover my sect of heretics and have me executed.",shape=box,color=blue];
		j2746595683 -> j1609324328;
		j2746595683 -> j1017596532;
	j2363964885 [label="Which are harnessed from the Void - they're the reason we can create a lot of the powerful warframes and weapons we make.",shape=box,color=red];
		j2363964885 -> j1717446728;
	j2667499734 [label="Masz rację, przepraszam. Źle się wyraziłem.",shape=box,color=red];
		j2667499734 -> j1260864930;
	j194377980 [label="Przepraszam, po prostu nie mam czasu, żeby się nim zajmować.",shape=box,color=red];
		j194377980 -> j2884409040;
	j1609324328 [label="Ballas is dead... keep going.",shape=box,color=red];
		j1609324328 -> j3359044370;
	j1017596532 [label="That... won't happen. Keep talking.",shape=box,color=red];
		j1017596532 -> j3359044370;
	j1717446728 [label="Jego specjalizacją była krystalografia. A jego prace odbywały się tutaj, w tych laboratoriach.",shape=box,color=red];
		j1717446728 -> j3686466455;
	j2884409040 [label="A więc przepraszam, że marnuję twój cenny czas.",shape=box,color=blue];
		j2884409040 -> j3007723528;
	j3359044370 [label="+5 Chemistry",color=orange];
		j3359044370 -> j2568842428;
	j3686466455 [label="For some reason, I don't know why, he was turned into a Cephalon, and given his own necraloid shell.",shape=box,color=red];
		j3686466455 -> j3887599870;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j2568842428 [label="Podejrzewałam... Zapytał mnie, skąd jestem, a kiedy odpowiedziałam, zaśmiał się i powiedział \"nie, to niemożliwe! Jestem tego pewien, jestem przecież -\"",shape=box,color=blue];
		j2568842428 -> j3432167038;
	j3887599870 [label="Not all Cephalons were made as a punishment. But things went... poorly here on Deimos, and he was badly damaged.",shape=box,color=red];
		j3887599870 -> j2105349457;
	j3432167038 [label="And then he... introduced himself to me again. And asked me if I was coming from the plains with mineral samples...",shape=box,color=blue];
		j3432167038 -> j3217004207;
		j3432167038 -> j721889388;
	j2105349457 [label="Pauvre petit...",shape=box,color=blue];
		j2105349457 -> j253530729;
	j3217004207 [label="Tak... to brzmi jak Otak.",shape=box,color=red];
		j3217004207 -> j139036099;
	j721889388 [label="Och, tak mi przykro...",shape=box,color=red];
		j721889388 -> j139036099;
	j253530729 [label="Boolean MarieOtak1 is now true.",color=orange];
		j253530729 -> j3016131687;
		j253530729 -> j1082361161;
	j139036099 [label="Moje serce płacze na myśl o tym, że nie jesteśmy w stanie mu pomóc.",shape=box,color=blue];
		j139036099 -> j457335464;
	j457335464 [label="Evaluate expressions",color=orange];
		j457335464 -> j244745983 [label="MarieCephalonSoul",color=purple];
		j457335464 -> j1951050084 [label="MarieCephalonNoSoul",color=purple];
		j457335464 -> j2541158038 [label="MarieCephalonUnsure",color=purple];
		j457335464 -> j2256574145 [label="false",color=purple];
	j244745983 [label="Oh, Luminaries - what manner of hell have you made for him, to keep his soul trapped within that cage of science and flickering lights?",shape=box,color=blue];
		j244745983 -> j1886985233;
	j1951050084 [label="I can only pray to the Luminaries that you are right and nothing remains inside that shell but... but science and flickering lights.",shape=box,color=blue];
		j1951050084 -> j957856736;
	j2541158038 [label="I know you are not sure if the Cephalons contain souls - but I can only pray to the Luminaries that... that poor Otak does not suffer.",shape=box,color=blue];
		j2541158038 -> j61407167;
	j2256574145 [label="I can only pray to the Luminaries that all that remains inside that shell is nothing but... but science and flickering lights.",shape=box,color=blue];
		j2256574145 -> j3817000172;
	j1886985233 [label="Why leave him there, broken and waiting until he is allowed to die to be given peace? I can only pray... that if there is some kind of presence there -",shape=box,color=blue];
		j1886985233 -> j3268530766;
	j957856736 [label="And no soul is trapped within that broken thing, waiting until it is allowed to finally die to be given peace.",shape=box,color=blue];
		j957856736 -> j2228217727;
	j61407167 [label="I żeby żadna dusza nie była uwięziona w tej zepsutej maszynie, czekając, aż ktoś pozwoli mu umrzeć i zaznać spokoju.",shape=box,color=blue];
		j61407167 -> j1164739443;
	j3817000172 [label="Żeby żadna dusza nie była uwięziona w tej zepsutej maszynie, czekając, aż ktoś pozwoli mu umrzeć i zaznać spokoju.",shape=box,color=blue];
		j3817000172 -> j1164739443;
	j3268530766 [label="Pozostaje ona tam z jego wyboru, ku jego pamięci...",shape=box,color=blue];
		j3268530766 -> j3862827749;
	j2228217727 [label="Bo jeśli się mylisz ? I dusza pozostaje uwięziona w tej klatce wbrew jej woli ?",shape=box,color=blue];
		j2228217727 -> j2962516332;
	j1164739443 [label="A jeśli pozostaje w nim jakaś resztka człowieczeństwa, istnieje ona z jego wyboru, ku jego pamięci.",shape=box,color=blue];
		j1164739443 -> j3862827749;
	j3862827749 [label="Dopuścić inną możliwość wymagałoby zastanowienia się nad łaskawością samych bogów, non ?",shape=box,color=blue];
		j3862827749 -> j2886832807;
	j2962516332 [label="To wymagałoby zastanowienia się nad łaskawością samych bogów, non ?",shape=box,color=blue];
		j2962516332 -> j2886832807;
	j2886832807 [label="I co ja bym dalej poczęła ?",shape=box,color=blue];
		j2886832807 -> j3030258935;
	j3030258935 [label="Przepraszam... ogarnia mnie dzisiaj melancholia. ",shape=box,color=blue];
		j3030258935 -> j3251038745;
	j3251038745 [label="Evaluate expressions",color=orange];
		j3251038745 -> j2222518912 [label="MarieRoathePastry1",color=purple];
