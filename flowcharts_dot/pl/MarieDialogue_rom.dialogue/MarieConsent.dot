		j1134465740 -> "Chat ends." [label=false,color=brown];
	j65788836 [label="Mon cœur, możemy porozmawiać ? To nie zajmie długo.",shape=box,color=blue];
		j65788836 -> j662249742;
		j65788836 -> j568275641;
	j662249742 [label="Oczywiście, o co chodzi?",shape=box,color=red];
		j662249742 -> j528142033;
	j568275641 [label="[Koniec]",shape=box,color=red];
		j568275641 -> j952339130;
	j528142033 [label="Chcę tylko powiedzieć, że... wiem, że w twoim sercu zagościła druga osoba. Chociaż ich nie znam, moje serce się raduje.",shape=box,color=blue];
		j528142033 -> j1670523047;
	j952339130 [label="Boolean MarieConsentComplete is now true.",color=orange];
		j952339130 -> "Chat ends.";
	j1670523047 [label="Ufam ci i wierzę, że jeśli znaczą dla ciebie wiele, tak z chęcią znajdę z nimi miejsce w twoim sercu.",shape=box,color=blue];
		j1670523047 -> j2931420005;
	j2931420005 [label="Mam tylko nadzieję, że pewnego dnia będzie dane mi poznać tę osobę, oui ? Kochanek mojego kochanka... musi być moim kochankiem.",shape=box,color=blue];
		j2931420005 -> j1955572663;
	j1955572663 [label="Jeśli tego zechcemy, rzecz jasna.",shape=box,color=blue];
		j1955572663 -> j2443849453;
		j1955572663 -> j2321955419;
		j1955572663 -> j2448700910;
	j2443849453 [label="Możesz nie być w ich typie.",shape=box,color=red];
		j2443849453 -> j1828398700;
	j2321955419 [label="Zakochaliby się w tobie, zupełnie jak ja.",shape=box,color=red];
		j2321955419 -> j594034352;
	j2448700910 [label="Jestem pewien, że nie zdołaliby ci się oprzeć.",shape=box,color=red];
		j2448700910 -> j594034352;
	j1828398700 [label="Pff ! Jesteś okrutny, mój wilku. Pozwól mi mieć marzenia. A do tego czasu, będę korzystać z okazji, kiedy jesteś pod ręką !",shape=box,color=blue];
		j1828398700 -> j3790749081;
	j594034352 [label="Do tego czasu, będę korzystać z okazji, kiedy jesteś pod ręką i będę dzielić się tobą z tymi, którzy są dla ciebie równie ważni, jak ja.",shape=box,color=blue];
		j594034352 -> j3790749081;
	j3790749081 [label="Ktoś musi stać na straży przed Szeptem, kiedy ty się bawisz !",shape=box,color=blue];
		j3790749081 -> j2241099681;
	j2241099681 [label="A skoro o tym mowa, obowiązki mnie wzywają. À la revoyure !",shape=box,color=blue];
		j2241099681 -> j952339130;
}