		3985 -> 3575 [label=true,color=green];
		3985 -> 3576 [label=false,color=brown];
	3577 [label="Chat ends.",color=orange];
	3578 [label="Mon cœur, may we speak ? Only for a moment. ",shape=box,color=blue];
		3578 -> 3580;
		3578 -> 3579;
	3576 [label="Chat ends.",color=orange];
	3580 [label="Hi, of course. What's up?",shape=box,color=red];
		3580 -> 3582;
	3579 [label="[Koniec]",shape=box,color=red];
		3579 -> 3581;
	3582 [label="Chcę tylko powiedzieć, że... wiem, że w twoim sercu zagościła druga osoba. Chociaż ich nie znam, moje serce się raduje.",shape=box,color=blue];
		3582 -> 3584;
	3581 [label="Update boolean MarieConsentComplete",color=orange];
		3581 -> 3583;
	3584 [label="Ufam ci i wierzę, że jeśli znaczą dla ciebie wiele, tak z chęcią znajdę z nimi miejsce w twoim sercu.",shape=box,color=blue];
		3584 -> 3585;
	3583 [label="Chat ends.",color=orange];
	3585 [label="I simply hope that someday I can have a chance to meet them, oui ? The lover of my lover must, therefore, be mine, too...",shape=box,color=blue];
		3585 -> 3586;
	3586 [label="Jeśli tego zechcemy, rzecz jasna.",shape=box,color=blue];
		3586 -> 3587;
		3586 -> 3588;
		3586 -> 3589;
	3587 [label="Możesz nie być w ich typie.",shape=box,color=red];
		3587 -> 3590;
	3588 [label="Zakochaliby się w tobie, zupełnie jak ja.",shape=box,color=red];
		3588 -> 3591;
	3589 [label="Jestem pewien, że nie zdołaliby ci się oprzeć.",shape=box,color=red];
		3589 -> 3591;
	3590 [label="Pff ! Jesteś okrutny, mój wilku. Pozwól mi mieć marzenia. A do tego czasu, będę korzystać z okazji, kiedy jesteś pod ręką !",shape=box,color=blue];
		3590 -> 3592;
	3591 [label="Do tego czasu, będę korzystać z okazji, kiedy jesteś pod ręką i będę dzielić się tobą z tymi, którzy są dla ciebie równie ważni, jak ja.",shape=box,color=blue];
		3591 -> 3592;
	3592 [label="Someone must stand guard against the Murmure while you are off galivanting and having all the fun, after all !",shape=box,color=blue];
		3592 -> 3593;
	3593 [label="And on that note, duty calls. À la revoyure !",shape=box,color=blue];
		3593 -> 3594;
	3594 [label="Update boolean MarieConsentComplete",color=orange];
		3594 -> 3595;
	3595 [label="Chat ends.",color=orange];
}