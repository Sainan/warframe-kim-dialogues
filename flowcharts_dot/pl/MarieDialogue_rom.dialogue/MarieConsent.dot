		j1985950621 -> j612843399 [label=false,color=brown];
	j1134465740 [label="Check boolean MariePolyamorySuccess",color=orange];
		j1134465740 -> j1985950621 [label=true,color=green];
		j1134465740 -> "Chat ends." [label=false,color=brown];
	j612843399 [label="Mon cœur, may we speak ? Only for a moment. ",shape=box,color=blue];
		j612843399 -> j4111332638;
		j612843399 -> j568275641;
	j4111332638 [label="Hi, of course. What's up?",shape=box,color=red];
		j4111332638 -> j2669761761;
	j568275641 [label="[Koniec]",shape=box,color=red];
		j568275641 -> j952339130;
	j2669761761 [label="Chcę tylko powiedzieć, że... wiem, że w twoim sercu zagościła druga osoba. Chociaż ich nie znam, moje serce się raduje.",shape=box,color=blue];
		j2669761761 -> j3583063773;
	j952339130 [label="Boolean MarieConsentComplete is now true.",color=orange];
		j952339130 -> "Chat ends.";
	j3583063773 [label="Ufam ci i wierzę, że jeśli znaczą dla ciebie wiele, tak z chęcią znajdę z nimi miejsce w twoim sercu.",shape=box,color=blue];
		j3583063773 -> j1118376888;
	j1118376888 [label="I simply hope that someday I can have a chance to meet them, oui ? The lover of my lover must, therefore, be mine, too...",shape=box,color=blue];
		j1118376888 -> j1955572663;
	j1955572663 [label="Jeśli tego zechcemy, rzecz jasna.",shape=box,color=blue];
		j1955572663 -> j2936883090;
		j1955572663 -> j201564576;
		j1955572663 -> j3811339602;
	j2936883090 [label="Możesz nie być w ich typie.",shape=box,color=red];
		j2936883090 -> j2190739290;
	j201564576 [label="Zakochaliby się w tobie, zupełnie jak ja.",shape=box,color=red];
		j201564576 -> j3727456993;
	j3811339602 [label="Jestem pewien, że nie zdołaliby ci się oprzeć.",shape=box,color=red];
		j3811339602 -> j3727456993;
	j2190739290 [label="Pff ! Jesteś okrutny, mój wilku. Pozwól mi mieć marzenia. A do tego czasu, będę korzystać z okazji, kiedy jesteś pod ręką !",shape=box,color=blue];
		j2190739290 -> j4072137541;
	j3727456993 [label="Do tego czasu, będę korzystać z okazji, kiedy jesteś pod ręką i będę dzielić się tobą z tymi, którzy są dla ciebie równie ważni, jak ja.",shape=box,color=blue];
		j3727456993 -> j4072137541;
	j4072137541 [label="Someone must stand guard against the Murmure while you are off galivanting and having all the fun, after all !",shape=box,color=blue];
		j4072137541 -> j2224470326;
	j2224470326 [label="And on that note, duty calls. À la revoyure !",shape=box,color=blue];
		j2224470326 -> j952339130;
}