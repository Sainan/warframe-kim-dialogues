		j4196999391 -> j2604508522;
	j2604508522 [label="To, co uczyniło mnie niepożądaną pour ma mère, sprawiło, że byłam całkiem popularna wśród innych dzieci na ulicy.",shape=box,color=blue];
		j2604508522 -> j3175598299;
