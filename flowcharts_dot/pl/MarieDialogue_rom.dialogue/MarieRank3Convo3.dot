		j1743836075 -> j437203488;
	j2204201340 [label="Pochodzę z la Cité de la Lumière, stolicy Galii. W skali świata nie leżała ona daleko od Höllvanii.",shape=box,color=blue];
		j2204201340 -> j1724238727;
	j3264711517 [label="Opieka nad kryptą i cmentarzem. To było moje ulubione zajęcie.",shape=box,color=blue];
		j3264711517 -> j869048938;
		j3264711517 -> j959794425;
	j437203488 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j437203488 -> j231733168;
	j1724238727 [label="Ciekawe, czy moja Cathédrale nadal stoi w 1999 ? Cóż za intrygująca myśl !",shape=box,color=blue];
		j1724238727 -> j3871555667;
		j1724238727 -> j1898580448;
	j869048938 [label="Dlaczego to było twoim ulubionym zajęciem?",shape=box,color=red];
		j869048938 -> j3026326234;
	j959794425 [label="Przepraszam, chyba nie zrozumiałem ostatniego zdania?",shape=box,color=red];
		j959794425 -> j3782154902;
	j231733168 [label="Te miejsca mają swój urok, spokój. Są takie ciche.",shape=box,color=blue];
		j231733168 -> j4169475837;
	j3871555667 [label="Lubisz odbiegać od tematu, prawda?",shape=box,color=red];
		j3871555667 -> j4115730344;
	j1898580448 [label="Mógłbym zapytać moich przyjaciół, całkiem sporo podróżowali. Chyba nawet wspominali wycieczkę do tego miasta.",shape=box,color=red];
		j1898580448 -> j132289921;
	j3026326234 [label="Bardzo polubiłam rozmowy z tymi, którzy spoczęli na zawsze. Wysłuchiwali moich obaw bez słowa krytyki.",shape=box,color=blue];
		j3026326234 -> j2341413842;
	j3782154902 [label="Moim obowiązkiem było opiekować się zmarłymi w Cathédrale. Zamiatałam podłogi krypty, pieliłam trawę na dziedzińcu.",shape=box,color=blue];
		j3782154902 -> j3026326234;
	j4169475837 [label="Myślę, że lubiłam opowiadać im o moich et les activités des autres, ponieważ ich zmartwienia już przeminęły, oui ?",shape=box,color=blue];
		j4169475837 -> j3150183446;
	j4115730344 [label="+5 Chemistry",color=orange];
		j4115730344 -> j628563858;
	j132289921 [label="+5 Chemistry",color=orange];
		j132289921 -> j3097016513;
	j2341413842 [label="Cóż, nie odpowiadali ani słowem, mais cela me convenait tout à fait ! Wolałabym, żeby milczeli.",shape=box,color=blue];
		j2341413842 -> j1797582617;
	j3150183446 [label="Dla nich wszystko musi wydawać się takie małe i odnajduję w tym pocieszenie.",shape=box,color=blue];
		j3150183446 -> j947655675;
		j3150183446 -> j1474364351;
		j3150183446 -> j3499564765;
	j628563858 [label="Zauważyłeś, oui ? Leon ciągle się ze mnie naśmiewa, że jestem niczym drobina kurzu tańcząca w promieniach słońca, niesiona gdziekolwiek zabierze mnie wiatr. (Raduję się, że ze sobą rozmawiacie !)",shape=box,color=blue];
		j628563858 -> j3956566035;
	j3097016513 [label="Och, nie zawracaj im głowy, to tylko głupia myśl. Nie wiem, ile smutku przyniosłaby mi wieść, że już jej nie ma.",shape=box,color=blue];
		j3097016513 -> j3956566035;
	j1797582617 [label="+5 Chemistry",color=orange];
		j1797582617 -> j2201932890;
	j947655675 [label="Nie wiem. Ja... boję się umrzeć na dobre. Nie lubię towarzystwa śmierci.",shape=box,color=red];
		j947655675 -> j2614172941;
	j1474364351 [label="Nigdy o tym tak nie myślałem.",shape=box,color=red];
		j1474364351 -> j1107369162;
	j3499564765 [label="Też odczuwałem taki spokój, będąc na cmentarzach. Całkowicie Cię rozumiem.",shape=box,color=red];
		j3499564765 -> j244082288;
	j3956566035 [label="Jestem po prostu ciekawska, oui ? Chcę wiedzieć tout ce qui existe - wiedzieć wszystko, co można wiedzieć. Uważam, że dlatego ja i le Cardinal na siebie trafiliśmy.",shape=box,color=blue];
		j3956566035 -> j648330790;
	j2201932890 [label="Możesz to sobie wyobrazić ? Przemawiające czaszki, zupełnie jak nekraloid ? Ha !",shape=box,color=blue];
		j2201932890 -> j2912407722;
		j2201932890 -> j4201318614;
	j2614172941 [label="Wiem, mała morbide Maria ! To niespodziewane. Ale każdy radzi sobie po swojemu, non ?",shape=box,color=blue];
		j2614172941 -> j3403375613;
	j1107369162 [label="Nie jesteś w tym sam. Nie lubimy rozmyślać nad tym, co nastąpi po życiu. A przynajmniej dopóki jest to odległa myśl.",shape=box,color=blue];
		j1107369162 -> j2322625302;
	j244082288 [label="Jak mnie cieszy, że rozumiesz !",shape=box,color=blue];
		j244082288 -> j2322625302;
	j648330790 [label="Où en étais-je ? Ah ! Oui. Moja historia.",shape=box,color=blue];
		j648330790 -> j1373004985;
	j2912407722 [label="To nie mogło być łatwe zadanie, biorąc pod uwagę Twój wózek.",shape=box,color=red];
		j2912407722 -> j1960110781;
	j4201318614 [label="Nie miałaś przyjaciół, z którymi mogłaś porozmawiać?",shape=box,color=red];
		j4201318614 -> j3966571741;
	j3403375613 [label="Ktoś musi się nimi zająć i z przyjemnością podjęłam się tego obowiązku.",shape=box,color=blue];
		j3403375613 -> j2322625302;
	j2322625302 [label="Leon żartuje, że przez to jestem bliżej ziemi, że dlatego tyle myślę o grobach.",shape=box,color=blue];
		j2322625302 -> j3172936422;
	j1373004985 [label="Urodziłam się w bogatej rodzinie, co może Cię zaskoczyć. Burżuazja, której bliżej niż dalej było do Orokin.",shape=box,color=blue];
		j1373004985 -> j2278281751;
	j1960110781 [label="Non, nie było. Ale Leon pomagał mi poruszać się po schodach krypty, kiedy nadchodził czas, a resztę opanowałam z czasem.",shape=box,color=blue];
		j1960110781 -> j2882266870;
	j3966571741 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j3966571741 -> j2288867718;
	j3172936422 [label=" Ja pytam, czy jego głowa jest pusta i stąd tyle miejsca na mary.",shape=box,color=blue];
		j3172936422 -> j641973599;
	j2278281751 [label="W dniu narodzin moje ciało było... zdeformowane, mes pieds tordus et inutilisables ? Och, ma mère się to nie podobało.",shape=box,color=blue];
		j2278281751 -> j195578006;
	j2882266870 [label="To niesamowite, ile zdziałać potrafi odrobina uporu, oui ?",shape=box,color=blue];
		j2882266870 -> j2390863201;
	j2288867718 [label="Miałam Leona, ale sam widzisz, jak to czasem wychodzi.",shape=box,color=blue];
		j2288867718 -> j437203488;
