	j1294998196 [label="Jak wiodło ci się życie w Katedrze?",shape=box,color=red];
		j1294998196 -> j4283013921;
	j1361788250 [label="Każdego tygodnia powracałam z moją salaire i resztkami, które zdołałam zebrać w kuchni i od innych.",shape=box,color=blue];
		j1361788250 -> j1204973229;
	j618601000 [label="Les Sœurs były dla mnie takie miłe ! Chociaż wiem, że ty pewnie masz inne zdanie, non ?",shape=box,color=blue];
		j618601000 -> j792772431;
	j4283013921 [label="Uwielbiałam ją ! Chociaż wiem, że ty pewnie masz inne zdanie, non ?",shape=box,color=blue];
		j4283013921 -> j792772431;
	j1204973229 [label="Opiekowałam się nimi najlepiej, jak mogłam, póki moi przyjaciele żyli. Wielu z nich przepadło przez variole ou tuberculose...",shape=box,color=blue];
		j1204973229 -> j1973485208;
	j792772431 [label="Trzy posiłki dziennie, ciepłe łóżko, dach nad głową. Nie musiałam martwić się o zostanie pobitą, okradzioną, czy coś gorszego ?",shape=box,color=blue];
		j792772431 -> j1484724682;
	j1973485208 [label="Wiele z nich nas opuściło, niektóre zginęły w walce lub przez przemoc. Większość odnalazła uczciwą pracę i dorosła. Założyły własne rodziny.",shape=box,color=blue];
		j1973485208 -> j59571607;
	j1484724682 [label="Otrzymałam wykształcenie. Zostałam nauczona ewangelii Sol i Lua. Powiedziano mi, bym odnalazła własną drogę w wierze. Mogłam odejść, gdybym tego chciała.",shape=box,color=blue];
		j1484724682 -> j824704157;
	j59571607 [label="Niektóre nawet powracały do Cathédrale, by znowu mnie zobaczyć. Radowało to moje serce.",shape=box,color=blue];
		j59571607 -> j824704157;
	j824704157 [label="Przez długo czas przybijało mnie poczucie winy. Ja zostałam zabrana z ulicy, a inni nie. Czasem to uczucie nadal mi doskwiera.",shape=box,color=blue];
		j824704157 -> j831297991;
		j824704157 -> j3050167115;
	j831297991 [label="Kiedy przypominam sobie wszystkich, którzy umarli przy mnie, a ja jestem jedynym, który przeżył? Czuję się tak samo. Nie możemy robić sobie tej krzywdy. Musimy walczyć, by uczynić świat lepszym miejscem.",shape=box,color=red];
		j831297991 -> j519178375;
	j3050167115 [label="Zrobiłaś, co mogłaś, by pomóc innym. Otrzymałaś pomoc i teraz oferujesz pomoc innym, kiedy masz sposobność.",shape=box,color=red];
		j3050167115 -> j2790270720;
	j519178375 [label="Czy to zawsze będzie tak wyglądać ? Jak walka ? Wojna z rwącą rzeką, która chce nas utopić ?",shape=box,color=blue];
		j519178375 -> j4084326517;
	j2790270720 [label="Add 1 to Thermostat counter",color=orange];
		j2790270720 -> j1058909449;
	j4084326517 [label="Add -1 to Thermostat counter",color=orange];
		j4084326517 -> j2018434738;
	j1058909449 [label="+10 Chemistry",color=orange];
		j1058909449 -> j3535614379;
	j2018434738 [label="+10 Chemistry",color=orange];
		j2018434738 -> j1854286654;
	j3535614379 [label="Oui, dokładnie o to chodzi. Zostałam wciągnięta na tratwę, dlatego teraz muszę zrobić to samo dla innych.",shape=box,color=blue];
		j3535614379 -> j702241561;
	j1854286654 [label="Ale rozumiem, co masz na myśli. W gruncie rzeczy masz na myśli, że nie warto się poddawać. Że otrzymałam te dary, bym mogła stanąć w obronie innych.",shape=box,color=blue];
		j1854286654 -> j702241561;
	j702241561 [label="Merci, a teraz muszę już iść.",shape=box,color=blue];
		j702241561 -> "Chat ends.";
}