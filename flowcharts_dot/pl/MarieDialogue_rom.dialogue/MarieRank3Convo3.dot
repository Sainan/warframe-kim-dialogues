		j271286361 -> j323732196;
	j673472453 [label="Leon jest mi jak brat. Kocham go bardziej, niż możesz sobie wyobrazić, ale nękają go problemy. Rozważ swoje słowa, zanim zwrócisz się ku niemu na poważnie, n'est-ce pas ?",shape=box,color=blue];
		j673472453 -> j3608948178;
	j478133365 [label="+5 Chemistry",color=orange];
		j478133365 -> j1633648197;
	j2012040133 [label="Oui, co innego mogłam zrobić ? To była kwestia czasu, zanim popadłabym w chorobę. Wiedziałam o tym nawet jako dziecko.",shape=box,color=blue];
		j2012040133 -> j3403875144;
		j2012040133 -> j1294998196;
	j3608948178 [label="Myślę, że wkrótce znów o tym porozmawiamy. Nie zrozum mnie źle, zachęcam cię ! Ale chcę, żebyś to przemyślał.",shape=box,color=blue];
		j3608948178 -> j271286361;
	j1633648197 [label="Masz takie dobre serce. Oczywiście, nie mogły zabrać ich wszystkich... ale nie zapomniałam swoich przyjaciół.",shape=box,color=blue];
		j1633648197 -> j1361788250;
	j3403875144 [label="Jak traktowały cię siostry?",shape=box,color=red];
