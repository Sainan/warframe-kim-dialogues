		j842659103 -> j2340935302;
	j2222380206 [label="Rozbawia mnie w najdziwniejszy sposób. Ale dostrzegam, że ty też, wilku. Z każdą chwilą coraz bardziej cieszę się, że tu jestem.",shape=box,color=blue];
