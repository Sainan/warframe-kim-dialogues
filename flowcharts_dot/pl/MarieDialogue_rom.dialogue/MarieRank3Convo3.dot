		j2115916636 -> j1502834935;
	j3930399779 [label="Sześć ? Siedem ? W ich oczach, przez wiele lat próbowali mnie naprawić. Prywatne lekcje nauki chodzenia. Aparaty ortopedyczne. Obuwie.",shape=box,color=blue];
		j3930399779 -> j1502834935;
	j1007015017 [label="Lua jest kapryśna. Nawet niezmienny Sol potrafi ulec swoim orbitom.",shape=box,color=blue];
		j1007015017 -> j2048513584;
	j2340935302 [label="Naprawdę jest mi bratnią duszą. Z każdą chwilą coraz bardziej cieszę się, że tu jestem.",shape=box,color=blue];
		j2340935302 -> j323732196;
	j323732196 [label="Mam nadzieję, że też się tak poczuje... ale diabeł go prześladuje i szepcze mu kłamstwa.",shape=box,color=blue];
