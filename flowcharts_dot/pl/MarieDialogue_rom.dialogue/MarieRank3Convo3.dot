		j3992253313 -> j2917294264;
	j3570339692 [label="+10 Chemistry",color=orange];
		j3570339692 -> j915007453;
	j3175598299 [label="Co jest bardziej pathétique niż dziecko pozbawione pieds, oui ? W moją wyciągniętą dłoń w jeden dzień wpadało więcej, niż oni byli w stanie nakraść w tydzień.",shape=box,color=blue];
		j3175598299 -> j1433881453;
	j2917294264 [label="Och ! Par Sol. Znów mnie zaskoczyłeś, przyznaję. Teraz się rumienię, skrywając twarz przed Monsieur Loidem...",shape=box,color=blue];
		j2917294264 -> j2868626181;
