digraph {
	1113 [label="MarieRank3Convo3 begins.",color=orange];
		1113 -> 3737;
	3737 [label="Update boolean MarieLyonAvailable",color=orange];
		3737 -> 1114;
	1114 [label="Check boolean MarieGraveyard1",color=orange];
		1114 -> 1115 [label=true,color=green];
		1114 -> 1117 [label=true,color=green];
		1114 -> 1118 [label=true,color=green];
		1114 -> 1116 [label=false,color=brown];
		1114 -> 1117 [label=false,color=brown];
		1114 -> 1118 [label=false,color=brown];
	1115 [label="Opowiesz mi więcej o swoim życiu w Katedrze? Zanim pojawił się Entrati?",shape=box,color=red];
		1115 -> 1119;
	1117 [label="Gdzie dorastałaś?",shape=box,color=red];
		1117 -> 2425;
	1118 [label="[Koniec]",shape=box,color=red];
		1118 -> 1122;
	1116 [label="Jak wyglądało Twoje życie w Katedrze, zanim pojawił się Entrati?",shape=box,color=red];
		1116 -> 1120;
	1119 [label="Prawda jest taka, że byłam samotna. Miałam Leona, ale wiesz, jaki potrafi czasem być (Och ! I tak bardzo mnie cieszy, że już ze sobą rozmawiacie !)",shape=box,color=blue];
		1119 -> 1123;
	2425 [label="Update boolean MarieBackstory1",color=orange];
		2425 -> 1121;
	1122 [label="Chat ends.",color=orange];
	1120 [label="Och, nie wiem, czy Cię to zainteresuje, ale odpowiem, skoro to cię ciekawi.",shape=box,color=blue];
		1120 -> 1124;
	1123 [label="Update boolean MarieGraveyard2",color=orange];
		1123 -> 1126;
	1121 [label="Pomyślałabym, że zdradzi mnie mój język, ale muszę pamiętać, że nie pochodzisz ze znanego mi świata, haha !",shape=box,color=blue];
		1121 -> 1125;
	1124 [label="Poświęcałam swoje dni, wypełniając obowiązki Siostry Sol. Czyszcząc patery i przygotowując wota dla parafian.",shape=box,color=blue];
		1124 -> 1127;
	1126 [label="Ale to nie dlatego spędziłam tak wiele czasu na rozmowach ze zmarłymi.",shape=box,color=blue];
		1126 -> 1129;
	1125 [label="Pochodzę z la Cité de la Lumière, stolicy Galii. W skali świata, nie leżała ona daleko od Höllvanii.",shape=box,color=blue];
		1125 -> 1128;
	1127 [label="Opieka nad kryptą i cmentarzem. To było moje ulubione zajęcie.",shape=box,color=blue];
		1127 -> 1130;
		1127 -> 1131;
	1129 [label="Update boolean MarieGraveyard2",color=orange];
		1129 -> 1134;
	1128 [label="Ciekawe, czy moja Cathédrale nadal stoi w 1999 ? Cóż za intrygująca myśl !",shape=box,color=blue];
		1128 -> 1132;
		1128 -> 1133;
	1130 [label="Dlaczego to było twoim ulubionym zajęciem?",shape=box,color=red];
		1130 -> 1135;
	1131 [label="Przepraszam, chyba nie zrozumiałem ostatniego zdania?",shape=box,color=red];
		1131 -> 1136;
	1134 [label="Te miejsca mają swój urok, spokój. Są takie ciche.",shape=box,color=blue];
		1134 -> 1139;
	1132 [label="Lubisz odbiegać od tematu, prawda?",shape=box,color=red];
		1132 -> 1137;
	1133 [label="Mógłbym zapytać moich przyjaciół, całkiem sporo podróżowali. Chyba nawet wspominali wycieczkę do tego miasta.",shape=box,color=red];
		1133 -> 1138;
	1135 [label="Bardzo polubiłam rozmowy z tymi, którzy spoczęli na zawsze. Wysłuchiwali moich obaw bez słowa krytyki.",shape=box,color=blue];
		1135 -> 1140;
	1136 [label="Moim obowiązkiem było opiekować się zmarłymi w Cathédrale. Zamiatałam podłogi krypty, pieliłam trawę na dziedzińcu.",shape=box,color=blue];
		1136 -> 1135;
	1139 [label="Myślę, że lubiłam opowiadać im o moich et les activités des autres, ponieważ ich zmartwienia już przeminęły, oui ?",shape=box,color=blue];
		1139 -> 1143;
	1137 [label="+5 Chemistry",color=orange];
		1137 -> 1141;
	1138 [label="+5 Chemistry",color=orange];
		1138 -> 1142;
	1140 [label="Cóż, nie odpowiadali ani słowem, mais cela me convenait tout à fait ! Wolałabym, żeby milczeli.",shape=box,color=blue];
		1140 -> 1144;
	1143 [label="Dla nich wszystko musi wydawać się takie małe i odnajduję w tym pocieszenie.",shape=box,color=blue];
		1143 -> 1146;
		1143 -> 1147;
		1143 -> 1148;
	1141 [label="Zauważyłeś, oui ? Leon ciągle się ze mnie naśmiewa, że jestem niczym drobina kurzu tańcząca w promieniach słońca, niesiona gdziekolwiek zabierze mnie wiatr. (Raduję się, że ze sobą rozmawiacie !)",shape=box,color=blue];
		1141 -> 1145;
	1142 [label="Och, nie zawracaj im głowy, to tylko głupia myśl. Nie wiem, ile smutku przyniosłaby mi wieść, że już jej nie ma.",shape=box,color=blue];
		1142 -> 1145;
	1144 [label="+5 Chemistry",color=orange];
		1144 -> 1149;
	1146 [label="Nie wiem. Ja... boję się umrzeć na dobre. Nie lubię towarzystwa śmierci.",shape=box,color=red];
		1146 -> 1151;
	1147 [label="Nigdy o tym tak nie myślałem.",shape=box,color=red];
		1147 -> 1152;
	1148 [label="Też odczuwałem taki spokój, będąc na cmentarzach. Całkowicie Cię rozumiem.",shape=box,color=red];
		1148 -> 1153;
	1145 [label="Jestem po prostu ciekawska, oui ? Chcę wiedzieć tout ce qui existe - wiedzieć wszystko, co można wiedzieć. Uważam, że dlatego ja i le Cardinal na siebie trafiliśmy.",shape=box,color=blue];
		1145 -> 1150;
	1149 [label="Możesz to sobie wyobrazić ? Przemawiające czaszki, zupełnie jak nekraloid ? Ha !",shape=box,color=blue];
		1149 -> 1154;
		1149 -> 1155;
	1151 [label="Wiem, mała morbide Maria ! To niespodziewane. Ale każdy radzi sobie po swojemu, non ?",shape=box,color=blue];
		1151 -> 1157;
	1152 [label="Nie jesteś w tym sam. Nie lubimy rozmyślać nad tym, co nastąpi po życiu. A przynajmniej dopóki jest to odległa myśl.",shape=box,color=blue];
		1152 -> 1158;
	1153 [label="Jak mnie cieszy, że rozumiesz !",shape=box,color=blue];
		1153 -> 1158;
	1150 [label="Où en étais-je ? Ah ! Oui. Moja historia.",shape=box,color=blue];
		1150 -> 1156;
	1154 [label="To nie mogło być łatwe zadanie, biorąc pod uwagę Twój wózek.",shape=box,color=red];
		1154 -> 1159;
	1155 [label="Nie miałaś przyjaciół, z którymi mogłaś porozmawiać?",shape=box,color=red];
		1155 -> 1160;
	1157 [label="Ktoś musi się nimi zająć i z przyjemnością podjęłam się tego obowiązku.",shape=box,color=blue];
		1157 -> 1158;
	1158 [label="Leon żartuje, że przez to jestem bliżej ziemi, że dlatego tyle myślę o grobach.",shape=box,color=blue];
		1158 -> 1162;
	1156 [label="Urodziłam się w bogatej rodzinie, co może Cię zaskoczyć. Burżuazja, której bliżej niż dalej było do Orokin.",shape=box,color=blue];
		1156 -> 1161;
	1159 [label="Non, nie było. Ale Leon pomagał mi poruszać się po schodach krypty, kiedy nadchodził czas, a resztę opanowałam z czasem.",shape=box,color=blue];
		1159 -> 1163;
	1160 [label="Update boolean MarieGraveyard1",color=orange];
		1160 -> 1164;
	1162 [label=" Ja pytam, czy jego głowa jest pusta i stąd tyle miejsca na mary.",shape=box,color=blue];
		1162 -> 1166;
	1161 [label="W dniu narodzin moje ciało było... zdeformowane, mes pieds tordus et inutilisables ? Och, ma mère się to nie podobało.",shape=box,color=blue];
		1161 -> 1165;
	1163 [label="To niesamowite, ile zdziałać potrafi odrobina uporu, oui ?",shape=box,color=blue];
		1163 -> 1167;
	1164 [label="Miałam Leona, ale sam widzisz, jak to czasem wychodzi.",shape=box,color=blue];
		1164 -> 1129;
	1166 [label="Groził, że zepchnie mnie ze wzgórza - a ja odgrażałam się, że wypełnię jego sutannę pokrzywą.",shape=box,color=blue];
		1166 -> 1169;
	1165 [label="Musieli zachować pozory, oui ? Spełniać oczekiwania.",shape=box,color=blue];
		1165 -> 1168;
	1167 [label="Uporu i silnych ramion, rzecz jasna, ha !",shape=box,color=blue];
		1167 -> 1170;
	1169 [label="La famille.",shape=box,color=blue];
		1169 -> 1172;
		1169 -> 1173;
		1169 -> 1174;
		1169 -> 3921;
	1168 [label="Więc co zrobili z małą, biedną, pokrzywdzoną Marią ? Zabrano mnie do la Cité de la Lumière, gdzie z pewnością umarłabym na ulicy...",shape=box,color=blue];
		1168 -> 1171;
	1170 [label="Update boolean MarieGraveyard1",color=orange];
		1170 -> 1129;
	1172 [label="Przykro mi, że Entrati to zniszczył.",shape=box,color=red];
		1172 -> 1177;
	1173 [label="Cieszę się, że mogliście na sobie polegać.",shape=box,color=red];
		1173 -> 1178;
	1174 [label="Wasza dwójka daje mi powód do uśmiechu.",shape=box,color=red];
		1174 -> 1179;
	3921 [label="A więc, ty i on... nigdy nie było między wami czegoś więcej?",shape=box,color=red];
		3921 -> 3922;
	1171 [label="I zostawili mnie na śmierć.",shape=box,color=blue];
		1171 -> 1175;
		1171 -> 1176;
	1177 [label="+10 Chemistry",color=orange];
		1177 -> 1182;
	1178 [label="+20 Chemistry",color=orange];
		1178 -> 1183;
	1179 [label="+20 Chemistry",color=orange];
		1179 -> 1184;
	3922 [label="Och, na Sol ! Non ! Jest mi jak brat w każdy sposób, oprócz więzów krwi. Sama myśl mnie obrzydza !",shape=box,color=blue];
		3922 -> 3923;
		3922 -> 3924;
	1175 [label="Twoja rodzina zostawiła cię na śmierć?",shape=box,color=red];
		1175 -> 1180;
	1176 [label="Ile miałaś lat?",shape=box,color=red];
		1176 -> 1181;
	1182 [label="Entrati niczego nie zniszczył. Mnie i Leona nadal łączy silna więź. Po prostu zmieniła się sytuacja, oui ?",shape=box,color=blue];
		1182 -> 1186;
	1183 [label="Nigdzie bym bez niego nie dotarła. No, może z wyjątkiem stoczenia się ze wzgórza. Haha !",shape=box,color=blue];
		1183 -> 1187;
	1184 [label="Rozbawia mnie w najdziwniejszy sposób. Ale dostrzegam, że ty też, wilku. Z każdą chwilą coraz bardziej cieszę się, że tu jestem.",shape=box,color=blue];
		1184 -> 1188;
	3923 [label="Tylko pytam.",shape=box,color=red];
		3923 -> 3925;
	3924 [label="Muszę przyznać, że to ulga.",shape=box,color=red];
		3924 -> 3931;
	1180 [label="W ich oczach, przez wiele lat próbowali mnie naprawić. Prywatne lekcje nauki chodzenia. Aparaty ortopedyczne. Obuwie.",shape=box,color=blue];
		1180 -> 1185;
	1181 [label="Sześć ? Siedem ? W ich oczach, przez wiele lat próbowali mnie naprawić. Prywatne lekcje nauki chodzenia. Aparaty ortopedyczne. Obuwie.",shape=box,color=blue];
		1181 -> 1185;
	1186 [label="Lua jest kapryśna. Nawet niezmienny Sol potrafi ulec swoim orbitom.",shape=box,color=blue];
		1186 -> 1191;
	1187 [label="Naprawdę jest mi bratnią duszą. Z każdą chwilą coraz bardziej cieszę się, że tu jestem.",shape=box,color=blue];
		1187 -> 1188;
	1188 [label="Mam nadzieję, że też się tak poczuje... ale diabeł go prześladuje i szepcze mu kłamstwa.",shape=box,color=blue];
		1188 -> 1192;
	3925 [label="+10 Chemistry",color=orange];
		3925 -> 3926;
	3931 [label="Check boolean DrifterMarie",color=orange];
		3931 -> 3932 [label=true,color=green];
		3931 -> 3933 [label=false,color=brown];
	1185 [label="Byli zmęczeni tym ciężarem. Więc kiedy ledwo umiałam czytać i pisać, wpadłam w bagno.",shape=box,color=blue];
		1185 -> 1189;
		1185 -> 1190;
	1191 [label="Nie możemy być niezmienni w swoich postanowieniach, bo mogą stać się naszą zgubą, wilku. W każdym razie, z każdą chwilą coraz bardziej cieszę się, że tu jestem.",shape=box,color=blue];
		1191 -> 1188;
	1192 [label="Ba ! Wystarczy o nim wspomnieć i już mnie wzywa. Muszę iść.",shape=box,color=blue];
		1192 -> 1194;
	3926 [label="Check boolean DrifterMarie",color=orange];
		3926 -> 3927 [label=true,color=green];
		3926 -> 3928 [label=false,color=brown];
	3932 [label="Oui, nie ukrywasz swoich intencji. Muszę cię ostrzec, że nie porzucę go. Znam Leona znacznie dłużej, niż ciebie.",shape=box,color=blue];
		3932 -> 3928;
	3933 [label="Oui ? I na które z nas... polujesz ?",shape=box,color=blue];
		3933 -> 3934;
		3933 -> 3935;
	1189 [label="Jak udało ci się przeżyć?",shape=box,color=red];
		1189 -> 1193;
	1190 [label="To okropne.",shape=box,color=red];
		1190 -> 1193;
	1194 [label="Chat ends.",color=orange];
	3927 [label="Oui. Zwykła \"ciekawość\". Nie oszukasz mnie. Ostrzegam, że nie porzucę go. Znam Leona znacznie dłużej, niż ciebie.",shape=box,color=blue];
		3927 -> 3928;
	3928 [label="+20 Chemistry",color=orange];
		3928 -> 3929;
	3934 [label="Na ciebie.",shape=box,color=red];
		3934 -> 3936;
	3935 [label="Na Leona.",shape=box,color=red];
		3935 -> 3941;
	1193 [label="Check boolean MarieSecretPower",color=orange];
		1193 -> 1196 [label=true,color=green];
		1193 -> 1195 [label=false,color=brown];
	3929 [label="Nigdzie bym bez niego nie dotarła. No, może z wyjątkiem stoczenia się ze wzgórza. Haha !",shape=box,color=blue];
		3929 -> 3930;
	3936 [label="Update boolean DrifterMarie",color=orange];
		3936 -> 3937;
	3941 [label="Vraiment ?!",shape=box,color=blue];
		3941 -> 3942;
	1196 [label="Było tak, jak mówiłeś, non ? Wszystkie niedogodności niosą ze sobą ukrytą moc.",shape=box,color=blue];
		1196 -> 1195;
	1195 [label="To, co uczyniło mnie niepożądaną pour ma mère, sprawiło, że byłam całkiem popularna wśród innych dzieci na ulicy.",shape=box,color=blue];
		1195 -> 1197;
	3930 [label="Mimo to intrygujesz mnie, wilku. Z każdą chwilą coraz bardziej cieszę się, że tu jestem.",shape=box,color=blue];
		3930 -> 1188;
	3937 [label="+10 Chemistry",color=orange];
		3937 -> 3938;
	3942 [label="+10 Chemistry",color=orange];
		3942 -> 3943;
	1197 [label="Co jest bardziej pathétique niż dziecko pozbawione pieds, oui ? W moją wyciągniętą dłoń w jeden dzień wpadało więcej, niż oni byli w stanie nakraść w tydzień.",shape=box,color=blue];
		1197 -> 1198;
	3938 [label="Och ! Par Sol. Znów mnie zaskoczyłeś, przyznaję. Teraz się rumienię, skrywając twarz przed Monsieur Loidem...",shape=box,color=blue];
		3938 -> 3939;
	3943 [label="Nie masz pojęcia, jak cieszy mnie ta wiadomość, ale proszę, przemyśl, co mówisz.",shape=box,color=blue];
		3943 -> 3944;
	1198 [label="To dzięki temu odnalazła mnie na ulicach jedna z les Sœurs de Sol. Pozwoliły mi dołączyć do nich.",shape=box,color=blue];
		1198 -> 1199;
		1198 -> 1200;
	3939 [label="Muszę cię ostrzec, że nie porzucę go. Znam Leona znacznie dłużej, niż ciebie.",shape=box,color=blue];
		3939 -> 3940;
	3944 [label="Update boolean DrifterLyon",color=orange];
		3944 -> 3945;
	1199 [label="Co z resztą dzieci?",shape=box,color=red];
		1199 -> 1201;
	1200 [label="I oczywiście się zgodziłaś.",shape=box,color=red];
		1200 -> 1202;
	3940 [label="+10 Chemistry",color=orange];
		3940 -> 1188;
	3945 [label="Leon jest mi jak brat. Kocham go bardziej, niż możesz sobie wyobrazić, ale nękają go problemy. Rozważ swoje słowa, zanim zwrócisz się ku niemu na poważnie, n'est-ce pas ?",shape=box,color=blue];
		3945 -> 3946;
	1201 [label="+5 Chemistry",color=orange];
		1201 -> 1203;
	1202 [label="Oui, co innego mogłam zrobić ? To była kwestia czasu, zanim popadłabym w chorobę. Wiedziałam o tym nawet jako dziecko.",shape=box,color=blue];
		1202 -> 1204;
		1202 -> 1205;
	3946 [label="Myślę, że wkrótce znów o tym porozmawiamy. Nie zrozum mnie źle, zachęcam cię ! Ale chcę, żebyś to przemyślał.",shape=box,color=blue];
		3946 -> 3940;
	1203 [label="Masz takie dobre serce. Oczywiście, nie mogły zabrać ich wszystkich... ale nie zapomniałam swoich przyjaciół.",shape=box,color=blue];
		1203 -> 1206;
	1204 [label="Jak traktowały cię siostry?",shape=box,color=red];
		1204 -> 1207;
	1205 [label="Jak wiodło ci się życie w Katedrze?",shape=box,color=red];
		1205 -> 1208;
	1206 [label="Każdego tygodnia powracałam z moją salaire i resztkami, które zdołałam zebrać w kuchni i od innych.",shape=box,color=blue];
		1206 -> 1209;
	1207 [label="Les Sœurs były dla mnie takie miłe ! Chociaż wiem, że ty pewnie masz inne zdanie, non ?",shape=box,color=blue];
		1207 -> 1210;
	1208 [label="Uwielbiałam ją ! Chociaż wiem, że ty pewnie masz inne zdanie, non ?",shape=box,color=blue];
		1208 -> 1210;
	1209 [label="Opiekowałam się nimi najlepiej, jak mogłam, póki moi przyjaciele żyli. Wielu z nich przepadło przez variole ou tuberculose...",shape=box,color=blue];
		1209 -> 1211;
	1210 [label="Trzy posiłki dziennie, ciepłe łóżko, dach nad głową. Nie musiałam martwić się o zostanie pobitą, okradzioną, czy coś gorszego ?",shape=box,color=blue];
		1210 -> 1212;
	1211 [label="Wiele z nich nas opuściło, niektóre zginęły w walce lub przez przemoc. Większość odnalazła uczciwą pracę i dorosła. Założyły własne rodziny.",shape=box,color=blue];
		1211 -> 1213;
	1212 [label="Otrzymałam wykształcenie. Zostałam nauczona ewangelii Sol i Lua. Powiedziano mi, bym odnalazła własną drogę w wierze. Mogłam odejść, gdybym tego chciała.",shape=box,color=blue];
		1212 -> 1214;
	1213 [label="Niektóre nawet powracały do Cathédrale, by znowu mnie zobaczyć. Radowało to moje serce.",shape=box,color=blue];
		1213 -> 1214;
	1214 [label="Przez długo czas przybijało mnie poczucie winy. Ja zostałam zabrana z ulicy, a inni nie. Czasem to uczucie nadal mi doskwiera.",shape=box,color=blue];
		1214 -> 1215;
		1214 -> 1216;
	1215 [label="Kiedy przypominam sobie wszystkich, którzy umarli przy mnie, a ja jestem jedynym, który przeżył? Czuję się tak samo. Nie możemy robić sobie tej krzywdy. Musimy walczyć, by uczynić świat lepszym miejscem.",shape=box,color=red];
		1215 -> 1217;
	1216 [label="Zrobiłaś, co mogłaś, by pomóc innym. Otrzymałaś pomoc i teraz oferujesz pomoc innym, kiedy masz sposobność.",shape=box,color=red];
		1216 -> 1218;
	1217 [label="Czy to zawsze będzie tak wyglądać ? Jak walka ? Wojna z rwącą rzeką, która chce nas utopić ?",shape=box,color=blue];
		1217 -> 1219;
	1218 [label="Add 1 to Thermostat",color=orange];
		1218 -> 1220;
	1219 [label="Add -1 to Thermostat",color=orange];
		1219 -> 1221;
	1220 [label="+10 Chemistry",color=orange];
		1220 -> 1222;
	1221 [label="+10 Chemistry",color=orange];
		1221 -> 1223;
	1222 [label="Oui, dokładnie o to chodzi. Zostałam wciągnięta na tratwę, dlatego teraz muszę zrobić to samo dla innych.",shape=box,color=blue];
		1222 -> 1224;
	1223 [label="Ale rozumiem, co masz na myśli. W gruncie rzeczy masz na myśli, że nie warto się poddawać. Że otrzymałam te dary, bym mogła stanąć w obronie innych.",shape=box,color=blue];
		1223 -> 1224;
	1224 [label="Merci, a teraz muszę już iść.",shape=box,color=blue];
		1224 -> 1225;
	1225 [label="Chat ends.",color=orange];
}