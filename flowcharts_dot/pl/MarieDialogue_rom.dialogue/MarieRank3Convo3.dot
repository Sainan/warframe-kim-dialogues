	j1988920735 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j1988920735 -> j1743836075;
	j946704432 [label="Pomyślałabym, że zdradzi mnie mój język, ale muszę pamiętać, że nie pochodzisz ze znanego mi świata, haha !",shape=box,color=blue];
		j946704432 -> j2204201340;
	j2821659646 [label="Poświęcałam swoje dni, wypełniając obowiązki Siostry Sol. Czyszcząc patery i przygotowując wota dla parafian.",shape=box,color=blue];
		j2821659646 -> j3264711517;
