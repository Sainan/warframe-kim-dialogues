		j1335227973 -> j592584605 [label=false,color=brown];
	j1502834935 [label="Byli zmęczeni tym ciężarem. Więc kiedy ledwo umiałam czytać i pisać, wpadłam w bagno.",shape=box,color=blue];
		j1502834935 -> j2219433620;
		j1502834935 -> j3719879523;
	j2048513584 [label="Nie możemy być niezmienni w swoich postanowieniach, bo mogą stać się naszą zgubą, wilku. W każdym razie, z każdą chwilą coraz bardziej cieszę się, że tu jestem.",shape=box,color=blue];
		j2048513584 -> j323732196;
	j46403217 [label="Ba ! Wystarczy o nim wspomnieć i już mnie wzywa. Muszę iść.",shape=box,color=blue];
