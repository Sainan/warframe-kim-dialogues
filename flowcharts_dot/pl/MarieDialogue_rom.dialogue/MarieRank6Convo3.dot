	3690 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3690 -> 3701;
	3689 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		3689 -> 3700;
	3688 [label="Merci, merci, merci !",shape=box,color=blue];
		3688 -> 3700;
	3687 [label="Well ! When the time comes, I will be ready and waiting ! Until then, merci, mon cœur.",shape=box,color=blue];
		3687 -> 3699;
	3686 [label="Well ! When the time comes, I will be ready and waiting ! Until then, merci.",shape=box,color=blue];
		3686 -> 3699;
	3697 [label="Po prostu cieszę się, że jesteś szczęśliwy A jeśli diabeł ma gdzie... wykazać swoje zdolności... to chyba lepiej dla wszystkich, non ?",shape=box,color=blue];
		3697 -> 3708;
	3698 [label="Nigdy bym nie zasugerowała, że diabeł cię polubił, że może posłucha cię wtedy, kiedy inni zostaliby zignorowani.",shape=box,color=blue];
		3698 -> 3709;
	3692 [label="Każdy w jego życiu próbował zrobić z niego potwora. Chyba jestem pierwszą osobą, która tego nie zrobiła.",shape=box,color=red];
		3692 -> 3703;
	3693 [label="Jest w nim wiele cech, których po prostu nie potrafi okazać. To nie jest zbroja sama w sobie – po prostu nie ufa, że ludzie go nie zranią.",shape=box,color=red];
		3693 -> 3704;
	3695 [label="Jego serce... zostało wielokrotnie złamane w ciągu jego życia. Przez to jest okryty bliznami i kolcami, to tyle.",shape=box,color=red];
		3695 -> 3706;
	3696 [label="Chyba rozumiem, jak długo żył. Doświadczyłem tyle samo śmierci, co on.",shape=box,color=red];
		3696 -> 3707;
	3694 [label="Zawsze starał się robić to, co słuszne. Może w niewłaściwy sposób, jasne – ale próbował ocalić System Origin przed Orokin.",shape=box,color=red];
		3694 -> 3705;
	3691 [label="I enjoy his wry sense of humor. He's clever, when you get past his ego.",shape=box,color=red];
		3691 -> 3702;
	3701 [label="Chat ends.",color=orange];
	3700 [label="Cóż ! Kiedy nadejdzie czas, będę gotowa !",shape=box,color=blue];
		3700 -> 3711;
	3699 [label="Update boolean MarieFamilySuccess",color=orange];
		3699 -> 3710;
	3708 [label="Even more so for us all if you serve as a bit of un ange upon his shoulder to temper him.",shape=box,color=blue];
		3708 -> 3716;
		3708 -> 3717;
	3709 [label="And never during private moments. Non. Jamais.",shape=box,color=blue];
		3709 -> 3718;
		3709 -> 3719;
	3703 [label="And I suppose I am atop that list of late, non ? I suppose I should... consider his reasons, for why he is the way he is. Condemnation saves no souls.",shape=box,color=blue];
		3703 -> 3713;
	3704 [label="There is always a pain we hide from those around us. Something we seek to shelter, for fear others will wield it. I suppose I should strive to be kinder to him, if what you say is true.",shape=box,color=blue];
		3704 -> 3713;
	3706 [label="Nie potrafię sobie wyobrazić, ile miłości i żalu musiał doświadczyć przez te lata. To wydaje się nierealne, nawet biorąc pod uwagę wszystko, co widziałam.",shape=box,color=blue];
		3706 -> 3714;
	3707 [label="Czasami, kiedy z nim rozmawiam, zapomina, ile stuleci przeżył. To wydaje się nierealne, nawet biorąc pod uwagę wszystko, co widziałam.",shape=box,color=blue];
		3707 -> 3715;
	3705 [label="There are always... nuances, oui ? Always reasons for acting one way or another. I suppose I should strive to be kinder to him, if what you say is true.",shape=box,color=blue];
		3705 -> 3713;
	3702 [label="Nikt nigdy nie zaprzeczył, że diabeł jest zdolny.",shape=box,color=blue];
		3702 -> 3712;
	3711 [label="Update boolean MarieFamilySuccess",color=orange];
		3711 -> 3721;
	3710 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3710 -> 3720;
	3716 [label="Kto mówi, że próbuję sprowadzić go na właściwą drogę?",shape=box,color=red];
		3716 -> 3723;
	3717 [label="Niczego nie obiecuję.",shape=box,color=red];
		3717 -> 3724;
	3718 [label="Nie znałem tej części ciebie.",shape=box,color=red];
		3718 -> 3684;
	3719 [label="You surprise me. I'm impressed. ",shape=box,color=red];
		3719 -> 3684;
	3713 [label="+10 Chemistry",color=orange];
		3713 -> 3722;
	3714 [label="Oui, what damage could that cause a soul ? I see why you would wish to find another who understood. And he, you.",shape=box,color=blue];
		3714 -> 3713;
	3715 [label="To have lived so long, to have seen so much death - to have paid so much of it yourself ?",shape=box,color=blue];
		3715 -> 3714;
	3712 [label="+5 Chemistry",color=orange];
		3712 -> 3722;
	3721 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3721 -> 3725;
	3720 [label="Chat ends.",color=orange];
	3723 [label="Add -1 to Thermostat",color=orange];
		3723 -> 3726;
	3724 [label="Add 1 to Thermostat",color=orange];
		3724 -> 3727;
	3722 [label="I am simply glad the devil has someone to speak with who might seek to temper him. Un ange upon his shoulder.",shape=box,color=blue];
		3722 -> 3716;
		3722 -> 3717;
	3725 [label="Chat ends.",color=orange];
	3726 [label="+10 Chemistry",color=orange];
		3726 -> 3728;
	3727 [label="+10 Chemistry",color=orange];
		3727 -> 3729;
	3728 [label="Perhaps you are right... what is un ange without son diable ? He reminds us all of what we should strive to avoid.",shape=box,color=blue];
		3728 -> 3730;
	3729 [label="Oui, I fear there is a wickedness in him that cannot truly be cured. He enjoys it too much.",shape=box,color=blue];
		3729 -> 3730;
	3730 [label="Well ! If and when you convince the devil to aid us in our mission, I will be ready and waiting ! Until then !",shape=box,color=blue];
		3730 -> 3731;
	3731 [label="Update boolean MarieFamilySuccess",color=orange];
		3731 -> 3732;
	3732 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3732 -> 3733;
	3733 [label="Chat ends.",color=orange];
}