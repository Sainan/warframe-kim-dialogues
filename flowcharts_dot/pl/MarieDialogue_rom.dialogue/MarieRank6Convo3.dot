	3609 [label="Myślałem, jak przekonać Loida, żeby udał się na górę i porozmawiał z rodziną... i chyba mam pomysł, ale może ci się nie spodobać.",shape=box,color=red];
		3609 -> 3614;
	3610 [label="Myślałaś już o tym, jak przekonać Loida, żeby porozmawiał z rodziną Entrati na górze?",shape=box,color=red];
		3610 -> 3615;
	3611 [label="Wracając do tematu zjednoczenia Loida z rodziną Entrati, zastanawiałem się... czy myślałaś o zaangażowaniu w tę kwestię Roathe'a?",shape=box,color=red];
		3611 -> 3616;
	3612 [label="Marie, are you still on board to... maybe try to convince Loid to talk to the \"upstairs neighbors?\" I know we left that off on a weird note.",shape=box,color=red];
		3612 -> 3616;
	3608 [label="I have been thinking of how Monsieur Loid is so frightened of speaking to le Cardinal's family.",shape=box,color=blue];
		3608 -> 3613;
	3614 [label="Check boolean MarieDating",color=orange];
		3614 -> 3619 [label=true,color=green];
		3614 -> 3618 [label=false,color=brown];
	3615 [label="Check boolean MarieDating",color=orange];
		3615 -> 3621 [label=true,color=green];
		3615 -> 3620 [label=false,color=brown];
	3616 [label="Check boolean MarieDating",color=orange];
		3616 -> 3623 [label=true,color=green];
		3616 -> 3622 [label=false,color=brown];
	3613 [label="And how we must break this impasse. This purgatoire in which we are trapped should not stand. It seems so needlessly painful.",shape=box,color=blue];
		3613 -> 3617;
	3619 [label="Bonjour, mon cœur ! And what are you afraid I will not like ?",shape=box,color=blue];
		3619 -> 3625;
	3618 [label="Bonjour ! Och ? Co miałoby mi się nie spodobać ?",shape=box,color=blue];
		3618 -> 3625;
	3621 [label="Bonjour mon cœur ! I have given it some thought, oui... and I am truly loath to admit it. It gives me no pleasure to say this.",shape=box,color=blue];
		3621 -> 3626;
	3620 [label="Bonjour mon cœur ! I have given it some thought, oui... and I am truly loath to admit it. It gives me no pleasure to say this.",shape=box,color=blue];
		3620 -> 3626;
	3623 [label="Bonjour, bonjour, mon cœur ! I have given it some thought, oui... and I am truly loath to admit it. It gives me no pleasure to say this.",shape=box,color=blue];
		3623 -> 3627;
	3622 [label="Bonjour - I have given it some thought, oui... and I am truly loath to admit it. It gives me no pleasure to say this.",shape=box,color=blue];
		3622 -> 3627;
	3617 [label="Ale czuję, że będziemy potrzebować... swego rodzaju bastionu, non ? Czy masz jakiś pomysł ?",shape=box,color=blue];
		3617 -> 3624;
		3617 -> 3625;
	3625 [label="Myślę, ze będziemy potrzebować pomocy Roathe'a, żeby przekonać Loida do rozmowy z rodziną Entrati. Wątpię, że obejdziemy się bez tego. Musimy upewnić się, że on i jego rodzina będą pod ochroną.",shape=box,color=red];
		3625 -> 3629;
	3626 [label="But I think... I think - ah, Sol forgive me - that the devil's assistance may be required. I do not think Monsieur Loid will listen to us otherwise.",shape=box,color=blue];
		3626 -> 3630;
	3627 [label="I believe you may be right. The devil may be the missing piece we need. Ah, it pains me even to type the words ! ",shape=box,color=blue];
		3627 -> 3631;
	3624 [label="Nie mam żadnych pomysłów, które nie wiążą się z pomocą od okropnych ludzi. Ludzi, którzy mogą nas wpakować w większy problem później - Roathe.",shape=box,color=red];
		3624 -> 3628;
	3629 [label="Nie chcę tego przyznawać, ale możesz mieć rację... Sol, przebacz mi.",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="Diabeł jest potężny i obiecuje siłę, gdyby coś poszło nie tak, non ?",shape=box,color=blue];
		3630 -> 3634;
		3630 -> 3635;
	3631 [label="Evaluate expressions",color=orange];
		3631 -> 3638 [label="RoatheFamilyFail",color=purple];
		3631 -> 3637 [label="RoatheRedeemed, RoatheFamilyDelay
",color=purple];
		3631 -> 3637 [label="RoatheRedeemed, RoatheFamilySuccess
",color=purple];
		3631 -> 3636 [label="RoatheVillain, RoatheFamilyDelay
",color=purple];
		3631 -> 3636 [label="RoatheVillain, RoatheFamilySuccess",color=purple];
		3631 -> 3639 [label="false",color=purple];
	3628 [label="Jesteś tego pewien ? Jeśli zdołam odłożyć na bok moją niechęć do diabła, ty także zdołasz, non ?",shape=box,color=blue];
		3628 -> 3632;
		3628 -> 3633;
	3634 [label="Nie, musi być inny sposób. Nie zamierzam prosić go o pomoc.",shape=box,color=red];
		3634 -> 3628;
	3635 [label="Masz rację. Nie sądziłem, że się zgodzisz. Bałem się zapytać.",shape=box,color=red];
		3635 -> 3631;
	3638 [label="/Lotus/Language/1999Texting/MarieRomance/Marie_MarieRank6Convo3_3118 begins.",shape=box,color=blue];
		3638 -> 3644;
	3637 [label="Czy pomoże nam w tej sprawie ?",shape=box,color=blue];
		3637 -> 3643;
	3636 [label="Czy pomoże nam w tej sprawie ?",shape=box,color=blue];
		3636 -> 3642;
	3639 [label="Do you think you can convince him to help us, though ?",shape=box,color=blue];
		3639 -> 3645;
		3639 -> 3646;
	3632 [label="No, I'm sorry. ",shape=box,color=red];
		3632 -> 3640;
	3633 [label="W porządku, jeśli tobie to nie przeszkadza, ja też się zgodzę.",shape=box,color=red];
		3633 -> 3641;
	3644 [label="No, unfortunately... I think that was a dead end with him. Do you think there's another way?",shape=box,color=red];
		3644 -> 3650;
	3643 [label="He will. I've convinced him to help reunite them - and you won't believe this - I think it's so that he can help protect Entrati's family. They're all that really remains of the Orokin, after all.",shape=box,color=red];
		3643 -> 3649;
	3642 [label="He will. I've convinced him to help reunite them - and you won't be surprised by this - I think it's mostly to spite Albrecht in his absence.",shape=box,color=red];
		3642 -> 3648;
	3645 [label="Nothing is settled yet. He's... well, you know how he can be.",shape=box,color=red];
		3645 -> 3651;
	3646 [label="Jeszcze nad tym pracuję, ale myślę, że tak.",shape=box,color=red];
		3646 -> 3652;
	3640 [label="+20 Chemistry",color=orange];
		3640 -> 3647;
	3641 [label="Oui, I do not have to enjoy it, but it is un médicament we must swallow, I suppose.",shape=box,color=blue];
		3641 -> 3631;
	3650 [label="Oh ! That is... unfortunate. I do not know ? I do not think so... Can you think of another approach with the devil ? Or a way to try again ?",shape=box,color=blue];
		3650 -> 3657;
	3649 [label="He is helping to protect the family of the man who turned him into protoframe against his will, and cast him into the past, robbing him of his memories...",shape=box,color=blue];
		3649 -> 3656;
	3648 [label="Masz rację, nie jestem zaskoczona.",shape=box,color=blue];
		3648 -> 3654;
		3648 -> 3655;
	3651 [label="Check boolean RoatheDating",color=orange];
		3651 -> 3659 [label=true,color=green];
		3651 -> 3658 [label=false,color=brown];
	3652 [label="Check boolean RoatheDating",color=orange];
