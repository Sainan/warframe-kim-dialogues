		j148501058 -> j134177363 [label="false",color=purple];
	j3543031629 [label="Myślałem, jak przekonać Loida, żeby udał się na górę i porozmawiał z rodziną... i chyba mam pomysł, ale może ci się nie spodobać.",shape=box,color=red];
		j3543031629 -> j3431982611;
	j3376511565 [label="Myślałaś już o tym, jak przekonać Loida, żeby porozmawiał z rodziną Entrati na górze?",shape=box,color=red];
		j3376511565 -> j2607534784;
	j598239706 [label="Wracając do tematu zjednoczenia Loida z rodziną Entrati, zastanawiałem się... czy myślałaś o zaangażowaniu w tę kwestię Roathe'a?",shape=box,color=red];
		j598239706 -> j1903226774;
	j371628064 [label="Czy nadal chcesz... spróbować przekonać Loida, żeby porozmawiał z naszymi \"sąsiadami z piętra wyżej\"? Nasza ostatnia rozmowa na ten temat zakończyła się... dziwnie.",shape=box,color=red];
		j371628064 -> j1903226774;
	j134177363 [label="Zastanawiałam się, dlaczego Monsieur Loid jest tak przerażony wizją rozmowy z rodziną le Cardinal.",shape=box,color=blue];
		j134177363 -> j1977504865;
	j3431982611 [label="Check boolean MarieDating",color=orange];
		j3431982611 -> j3939740515 [label=true,color=green];
		j3431982611 -> j67898368 [label=false,color=brown];
	j2607534784 [label="Check boolean MarieDating",color=orange];
		j2607534784 -> j2890555052 [label=true,color=green];
		j2607534784 -> j2890555052 [label=false,color=brown];
	j1903226774 [label="Check boolean MarieDating",color=orange];
		j1903226774 -> j2209623525 [label=true,color=green];
		j1903226774 -> j372097079 [label=false,color=brown];
	j1977504865 [label="I o tym, że musimy wyłamać się z tego impasu. To purgatoire, w którym jesteśmy uwięzieni, nie powinno istnieć. Rodzi zbędne cierpienie.",shape=box,color=blue];
		j1977504865 -> j4061877596;
	j3939740515 [label="Bonjour, mon cœur ! Co miałoby mi się nie spodobać ?",shape=box,color=blue];
		j3939740515 -> j733255307;
	j67898368 [label="Bonjour ! Och ? Co miałoby mi się nie spodobać ?",shape=box,color=blue];
		j67898368 -> j733255307;
	j2890555052 [label="Bonjour, mon cœur ! Dałam sobie chwilę na przemyślenia oui... i szczerze mówiąc, niechętnie się do tego przyznaję. Tak... mówienie tego nie sprawia mi żadnej przyjemności.",shape=box,color=blue];
		j2890555052 -> j2133195536;
	j2209623525 [label="Bonjour, bonjour, mon cœur ! Dałam sobie chwilę na przemyślenia, oui... i szczerze mówiąc, niechętnie się do tego przyznaję. Tak... mówienie tego nie sprawia mi żadnej przyjemności.",shape=box,color=blue];
		j2209623525 -> j3511977617;
	j372097079 [label="Bonjour... Dałam sobie chwilę na przemyślenia, oui... i szczerze mówiąc, niechętnie się do tego przyznaję. Mówienie tego nie sprawia mi żadnej przyjemności.",shape=box,color=blue];
		j372097079 -> j3511977617;
	j4061877596 [label="Ale czuję, że będziemy potrzebować... swego rodzaju bastionu, non ? Czy masz jakiś pomysł ?",shape=box,color=blue];
		j4061877596 -> j2041920023;
		j4061877596 -> j733255307;
	j733255307 [label="Myślę, ze będziemy potrzebować pomocy Roathe'a, żeby przekonać Loida do rozmowy z rodziną Entrati. Wątpię, że obejdziemy się bez tego. Musimy upewnić się, że on i jego rodzina będą pod ochroną.",shape=box,color=red];
		j733255307 -> j3546666480;
	j2133195536 [label="Ale myślę... myślę, że — ach Sol, przebacz mi — że możemy potrzebować pomocy diabła. Nie sądzę, żeby Monsieur Loid wysłuchał nas w innym wypadku.",shape=box,color=blue];
		j2133195536 -> j436572263;
	j3511977617 [label="Myślę, że możesz mieć rację. Diabeł może być brakującym elementem układanki. Nie masz pojęcia, jak wiele kosztuje mnie przyznanie tego ! ",shape=box,color=blue];
		j3511977617 -> j636489540;
	j2041920023 [label="Nie mam żadnych pomysłów, które nie wiążą się z pomocą od okropnych ludzi. Ludzi, którzy mogą nas wpakować w większy problem później - Roathe.",shape=box,color=red];
		j2041920023 -> j2959829733;
	j3546666480 [label="Nie chcę tego przyznawać, ale możesz mieć rację... Sol, przebacz mi.",shape=box,color=blue];
		j3546666480 -> j636489540;
	j436572263 [label="Diabeł jest potężny i obiecuje siłę, gdyby coś poszło nie tak, non ?",shape=box,color=blue];
		j436572263 -> j1828948725;
		j436572263 -> j2966618220;
	j636489540 [label="Evaluate expressions",color=orange];
		j636489540 -> j638779135 [label="RoatheFamilyFail",color=purple];
		j636489540 -> j1989849601 [label="RoatheRedeemed, RoatheFamilyDelay
",color=purple];
		j636489540 -> j1989849601 [label="RoatheRedeemed, RoatheFamilySuccess
",color=purple];
		j636489540 -> j1183189551 [label="RoatheVillain, RoatheFamilyDelay
",color=purple];
		j636489540 -> j1183189551 [label="RoatheVillain, RoatheFamilySuccess",color=purple];
		j636489540 -> j1781053804 [label="false",color=purple];
	j2959829733 [label="Jesteś tego pewien ? Jeśli zdołam odłożyć na bok moją niechęć do diabła, ty także zdołasz, non ?",shape=box,color=blue];
		j2959829733 -> j3840952293;
		j2959829733 -> j2075037677;
	j1828948725 [label="Nie, musi być inny sposób. Nie zamierzam prosić go o pomoc.",shape=box,color=red];
		j1828948725 -> j2959829733;
	j2966618220 [label="Masz rację. Nie sądziłem, że się zgodzisz. Bałem się zapytać.",shape=box,color=red];
		j2966618220 -> j636489540;
	j638779135 [label="Czy pomoże nam w tej sprawie ?",shape=box,color=blue];
		j638779135 -> j2900155332;
	j1989849601 [label="Czy pomoże nam w tej sprawie ?",shape=box,color=blue];
		j1989849601 -> j2894945219;
	j1183189551 [label="Czy pomoże nam w tej sprawie ?",shape=box,color=blue];
		j1183189551 -> j3298830426;
	j1781053804 [label="Wierzysz, że uda się nam go przekonać ?",shape=box,color=blue];
		j1781053804 -> j2409273344;
		j1781053804 -> j2916249019;
	j3840952293 [label="Nie, przykro mi. ",shape=box,color=red];
		j3840952293 -> j1559202369;
	j2075037677 [label="W porządku, jeśli tobie to nie przeszkadza, ja też się zgodzę.",shape=box,color=red];
		j2075037677 -> j2126828532;
	j2900155332 [label="Nie, niestety... Myślę, że to ślepy zaułek. Myślisz, że istnieje inne wyjście?",shape=box,color=red];
		j2900155332 -> j2002586617;
	j2894945219 [label="Tak. Przekonałem go, żeby ich pogodził — i nie uwierzysz — myślę, że on może też chronić rodzinę Entrati. Są przecież wszystkim, co zostało z Orokin.",shape=box,color=red];
		j2894945219 -> j3207856923;
	j3298830426 [label="Tak. Przekonałem go, żeby ich pogodził — i raczej cię to nie zaskoczy — robi to, żeby zemścić się na Albrechcie podczas jego nieobecności.",shape=box,color=red];
		j3298830426 -> j3897834681;
	j2409273344 [label="Niczego jeszcze nie ustaliliśmy. Wiesz, jaki potrafi być.",shape=box,color=red];
		j2409273344 -> j2913252443;
	j2916249019 [label="Jeszcze nad tym pracuję, ale myślę, że tak.",shape=box,color=red];
		j2916249019 -> j1104176810;
	j1559202369 [label="+20 Chemistry",color=orange];
		j1559202369 -> j1453975680;
	j2126828532 [label="Oui, nie sprawia mi to radości, ale to médicament, który musimy zażyć.",shape=box,color=blue];
		j2126828532 -> j636489540;
	j2002586617 [label="Och ! To... niefortunne. Chyba nie ? Nic nie przychodzi mi do głowy... Może jest inny sposób na diabła ? Sposób, żeby spróbować jeszcze raz ?",shape=box,color=blue];
		j2002586617 -> j2084525027;
	j3207856923 [label="Pomoże ochronić rodzinę człowieka, który wbrew jego woli zrobił z niego protoframe'a, porzucił go w przeszłości, okradł go z jego wspomnień...",shape=box,color=blue];
		j3207856923 -> j1368276259;
	j3897834681 [label="Masz rację, nie jestem zaskoczona.",shape=box,color=blue];
		j3897834681 -> j490883399;
		j3897834681 -> j4023423376;
	j2913252443 [label="Check boolean RoatheDating",color=orange];
		j2913252443 -> j1146576378 [label=true,color=green];
		j2913252443 -> j621746001 [label=false,color=brown];
	j1104176810 [label="Check boolean RoatheDating",color=orange];
		j1104176810 -> j2049866354 [label=true,color=green];
		j1104176810 -> j2674063867 [label=false,color=brown];
	j1453975680 [label="W takim razie zgodzę się z twoją decyzją.",shape=box,color=blue];
		j1453975680 -> j1179567760;
	j2084525027 [label="W międzyczasie pomówię z Leonem, ale nie robię sobie nadziei.",shape=box,color=blue];
		j2084525027 -> j860725021;
	j1368276259 [label="+20 Chemistry",color=orange];
		j1368276259 -> j2344930806;
	j490883399 [label="Ale przynajmniej pomoże. Dopilnuję, żeby nie spełnił swoich gróźb.",shape=box,color=red];
		j490883399 -> j1224814571;
	j4023423376 [label="Myślę, że to tylko wymówka.",shape=box,color=red];
		j4023423376 -> j1697825180;
	j1146576378 [label="Oui, wiem. Ale myślę, że masz swój sposób, żeby go przekonać, kiedy innym się nie udało, non ?",shape=box,color=blue];
		j1146576378 -> j887525371;
		j1146576378 -> j2507486169;
	j621746001 [label="Oui, przekonałam się o tym. Ten diabeł potrafi być uparty nawet w dobrych chwilach. Czasami myślę, że po prostu lubi być przekorny !",shape=box,color=blue];
		j621746001 -> j87494990;
		j621746001 -> j2241136066;
	j2049866354 [label="Myślę, że masz swój sposób, żeby go przekonać, kiedy innym się nie udało, non ?",shape=box,color=blue];
		j2049866354 -> j887525371;
		j2049866354 -> j2507486169;
	j2674063867 [label="Życzę ci szczęścia. Diabeł potrafi być uparty nawet w dobrych chwilach. Czasami myślę, że po prostu lubi być przekorny !",shape=box,color=blue];
		j2674063867 -> j87494990;
		j2674063867 -> j2241136066;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j860725021 [label="+20 Chemistry",color=orange];
		j860725021 -> j2316683364;
	j2344930806 [label="Bardzo pomyliłam się w ocenie naszego diabła...",shape=box,color=blue];
		j2344930806 -> j1281258510;
	j1224814571 [label="Oui. Przynajmniej, kiedy jesteś w pobliżu, możemy dopilnować, że nie pokieruje się... bardziej pierwotnymi instynktami.",shape=box,color=blue];
		j1224814571 -> j2198758823;
	j1697825180 [label="Oui, mam nadzieję, że masz rację.",shape=box,color=blue];
		j1697825180 -> j2198758823;
	j887525371 [label="Nie chcę wykorzystywać naszej relacji jako narzędzia w negocjacji.",shape=box,color=red];
		j887525371 -> j3482818401;
	j2507486169 [label="Co sugerujesz?",shape=box,color=red];
		j2507486169 -> j1751721375;
	j87494990 [label="Szczerze to nawet mi się to podoba, choć brzmi to dziwnie. Dogadujemy się.",shape=box,color=red];
		j87494990 -> j676575677;
	j2241136066 [label="Czasami taki bywa, ale myślę, że wiele z tego jest tylko na pokaz.",shape=box,color=red];
		j2241136066 -> j2750401286;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j2316683364 [label="Diabeł bywa kapryśny ! Jak to mawiają, c'est la vie !",shape=box,color=blue];
		j2316683364 -> j3569999725;
	j1281258510 [label="I nie jestem na tyle głupcem, by nie dostrzec, jak ważną rolę odegrałeś w tym ty !",shape=box,color=blue];
		j1281258510 -> j3242583483;
	j2198758823 [label="Check boolean MarieDating",color=orange];
		j2198758823 -> j1821915200 [label=true,color=green];
		j2198758823 -> j2814755233 [label=false,color=brown];
	j3482818401 [label="Och ! Nie to miałam na myśli, pardonne-moi ! Zauważyłam tylko, że darzy cię sympatią, więc możesz być zdolny szepnąć do jego ucha, kiedy innych by po prostu zignorował.",shape=box,color=blue];
		j3482818401 -> j3536717840;
	j1751721375 [label="+5 Chemistry",color=orange];
		j1751721375 -> j1917010005;
	j676575677 [label="Oui, wygląda na to, że darzy cię sympatią. Może przez to, że pochodzicie z tego samego czasu i miejsca, a my nie ? Czy może istnieć inny powód ?",shape=box,color=blue];
		j676575677 -> j3822691405;
	j2750401286 [label="Oui ? Co masz na myśli ?",shape=box,color=blue];
		j2750401286 -> j3822691405;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j3242583483 [label="Check boolean MarieDating",color=orange];
		j3242583483 -> j91321375 [label=true,color=green];
		j3242583483 -> j1294019211 [label=false,color=brown];
	j1821915200 [label="+10 Chemistry",color=orange];
		j1821915200 -> j2901937546;
	j2814755233 [label="+10 Chemistry",color=orange];
		j2814755233 -> j3272930354;
	j3536717840 [label="+5 Chemistry",color=orange];
		j3536717840 -> j4211113286;
	j1917010005 [label="Nie mam pojęcia, o czym mówisz ! Niczego nie sugeruję. Jestem tylko niewinną Sœur de Sol.",shape=box,color=blue];
		j1917010005 -> j760215189;
	j3822691405 [label="Evaluate expressions",color=orange];
		j3822691405 -> j2445688992 [label="RoatheVillain",color=purple];
		j3822691405 -> j3839478210 [label="RoatheRedeemed",color=purple];
		j3822691405 -> j3749551582 [label="RoatheUnloved3",color=purple];
		j3822691405 -> j3507334395 [label="RoatheTraitor2",color=purple];
		j3822691405 -> j346979668 [label="RoatheExecutor2",color=purple];
		j3822691405 -> j2141310516 [label="false",color=purple];
	j91321375 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		j91321375 -> j3770030583;
	j1294019211 [label="Merci, merci, merci !",shape=box,color=blue];
		j1294019211 -> j3770030583;
	j2901937546 [label="Cóż ! Kiedy nadejdzie czas, będę gotowa ! Do tego czasu, merci, mon cœur.",shape=box,color=blue];
		j2901937546 -> j3569999725;
	j3272930354 [label="Cóż ! Kiedy nadejdzie czas, będę gotowa ! Do tego czasu, merci.",shape=box,color=blue];
		j3272930354 -> j3569999725;
	j4211113286 [label="Po prostu cieszę się, że jesteś szczęśliwy A jeśli diabeł ma gdzie... wykazać swoje zdolności... to chyba lepiej dla wszystkich, non ?",shape=box,color=blue];
		j4211113286 -> j2413600139;
	j760215189 [label="Nigdy wcześniej bym nie zasugerowała, że skoro diabeł obdarzył cię sympatią, to może się ciebie posłuchać, nawet jeśli ignoruje innych.",shape=box,color=blue];
		j760215189 -> j2273114936;
	j2445688992 [label="Każdy w jego życiu próbował zrobić z niego potwora. Chyba jestem pierwszą osobą, która tego nie zrobiła.",shape=box,color=red];
		j2445688992 -> j3055587216;
	j3839478210 [label="Jest w nim wiele cech, których po prostu nie potrafi okazać. To nie jest zbroja sama w sobie – po prostu nie ufa, że ludzie go nie zranią.",shape=box,color=red];
		j3839478210 -> j1667863319;
	j3749551582 [label="Jego serce... zostało wielokrotnie złamane w ciągu jego życia. Przez to jest okryty bliznami i kolcami, to tyle.",shape=box,color=red];
		j3749551582 -> j3652698838;
	j3507334395 [label="Chyba rozumiem, jak długo żył. Doświadczyłem tyle samo śmierci, co on.",shape=box,color=red];
		j3507334395 -> j3617409425;
	j346979668 [label="Zawsze starał się robić to, co słuszne. Może w niewłaściwy sposób, jasne – ale próbował ocalić System Origin przed Orokin.",shape=box,color=red];
		j346979668 -> j3309911199;
	j2141310516 [label="Podoba mi się jego ironiczne poczucie humoru. Jest mądry, kiedy już przebijesz się przez jego ego.",shape=box,color=red];
		j2141310516 -> j1526143159;
	j3770030583 [label="Cóż ! Kiedy nadejdzie czas, będę gotowa !",shape=box,color=blue];
		j3770030583 -> j3569999725;
	j2413600139 [label="Tym lepiej dla nas, że jesteś niczym un ange na jego ramieniu i go utemperujesz.",shape=box,color=blue];
		j2413600139 -> j2142861867;
		j2413600139 -> j2065293314;
	j2273114936 [label="Ale nigdy w chwilach prywatności. Non. Jamais.",shape=box,color=blue];
		j2273114936 -> j2007238705;
		j2273114936 -> j385555511;
	j3055587216 [label="I zgaduję, że trafiłam na szczyt tej listy, non ? Może powinnam... wziąć pod uwagę jego motywację, dlaczego postępuje tak, a nie inaczej. Potępienie nie zbawiło żadnej duszy.",shape=box,color=blue];
		j3055587216 -> j2283544839;
	j1667863319 [label="Zawsze skrywamy w sobie jakiś ból. Coś, co staramy się ukryć z obawy, że inni to wykorzystają. Chyba powinnam być dla niego milsza, jeśli to, co mówisz, jest prawdą.",shape=box,color=blue];
		j1667863319 -> j2283544839;
	j3652698838 [label="Nie potrafię sobie wyobrazić, ile miłości i żalu musiał doświadczyć przez te lata. To wydaje się nierealne, nawet biorąc pod uwagę wszystko, co widziałam.",shape=box,color=blue];
		j3652698838 -> j996783913;
	j3617409425 [label="Czasami, kiedy z nim rozmawiam, zapomina, ile stuleci przeżył. To wydaje się nierealne, nawet biorąc pod uwagę wszystko, co widziałam.",shape=box,color=blue];
		j3617409425 -> j2237925242;
	j3309911199 [label="We wszystkim jest... niuans, oui ? Powód, by postąpić tak, a nie inaczej. Chyba powinnam być dla niego milsza, jeśli to, co mówisz, jest prawdą.",shape=box,color=blue];
		j3309911199 -> j2283544839;
	j1526143159 [label="Nikt nigdy nie zaprzeczył, że diabeł jest zdolny.",shape=box,color=blue];
		j1526143159 -> j2268156085;
