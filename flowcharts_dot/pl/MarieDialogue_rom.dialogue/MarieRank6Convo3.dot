	j3543031629 [label="Myślałem, jak przekonać Loida, żeby udał się na górę i porozmawiał z rodziną... i chyba mam pomysł, ale może ci się nie spodobać.",shape=box,color=red];
		j3543031629 -> j3431982611;
	j3376511565 [label="Myślałaś już o tym, jak przekonać Loida, żeby porozmawiał z rodziną Entrati na górze?",shape=box,color=red];
		j3376511565 -> j2607534784;
	j598239706 [label="Wracając do tematu zjednoczenia Loida z rodziną Entrati, zastanawiałem się... czy myślałaś o zaangażowaniu w tę kwestię Roathe'a?",shape=box,color=red];
		j598239706 -> j1903226774;
	j2293866203 [label="Marie, are you still on board to... maybe try to convince Loid to talk to the \"upstairs neighbors?\" I know we left that off on a weird note.",shape=box,color=red];
		j2293866203 -> j1903226774;
	j2844206227 [label="I have been thinking of how Monsieur Loid is so frightened of speaking to le Cardinal's family.",shape=box,color=blue];
		j2844206227 -> j2169574017;
	j3431982611 [label="Check boolean MarieDating",color=orange];
		j3431982611 -> j3145117288 [label=true,color=green];
		j3431982611 -> j67898368 [label=false,color=brown];
	j2607534784 [label="Check boolean MarieDating",color=orange];
		j2607534784 -> j1497303263 [label=true,color=green];
		j2607534784 -> j1497303263 [label=false,color=brown];
	j1903226774 [label="Check boolean MarieDating",color=orange];
		j1903226774 -> j2371820559 [label=true,color=green];
		j1903226774 -> j2133849035 [label=false,color=brown];
	j2169574017 [label="And how we must break this impasse. This purgatoire in which we are trapped should not stand. It seems so needlessly painful.",shape=box,color=blue];
		j2169574017 -> j4061877596;
	j3145117288 [label="Bonjour, mon cœur ! And what are you afraid I will not like ?",shape=box,color=blue];
		j3145117288 -> j733255307;
	j67898368 [label="Bonjour ! Och ? Co miałoby mi się nie spodobać ?",shape=box,color=blue];
		j67898368 -> j733255307;
	j1497303263 [label="Bonjour mon cœur ! I have given it some thought, oui... and I am truly loath to admit it. It gives me no pleasure to say this.",shape=box,color=blue];
		j1497303263 -> j3632041271;
	j2371820559 [label="Bonjour, bonjour, mon cœur ! I have given it some thought, oui... and I am truly loath to admit it. It gives me no pleasure to say this.",shape=box,color=blue];
		j2371820559 -> j228742710;
	j2133849035 [label="Bonjour - I have given it some thought, oui... and I am truly loath to admit it. It gives me no pleasure to say this.",shape=box,color=blue];
		j2133849035 -> j228742710;
	j4061877596 [label="Ale czuję, że będziemy potrzebować... swego rodzaju bastionu, non ? Czy masz jakiś pomysł ?",shape=box,color=blue];
		j4061877596 -> j2041920023;
		j4061877596 -> j733255307;
	j733255307 [label="Myślę, ze będziemy potrzebować pomocy Roathe'a, żeby przekonać Loida do rozmowy z rodziną Entrati. Wątpię, że obejdziemy się bez tego. Musimy upewnić się, że on i jego rodzina będą pod ochroną.",shape=box,color=red];
		j733255307 -> j3546666480;
	j3632041271 [label="But I think... I think - ah, Sol forgive me - that the devil's assistance may be required. I do not think Monsieur Loid will listen to us otherwise.",shape=box,color=blue];
		j3632041271 -> j436572263;
	j228742710 [label="I believe you may be right. The devil may be the missing piece we need. Ah, it pains me even to type the words ! ",shape=box,color=blue];
		j228742710 -> j636489540;
	j2041920023 [label="Nie mam żadnych pomysłów, które nie wiążą się z pomocą od okropnych ludzi. Ludzi, którzy mogą nas wpakować w większy problem później - Roathe.",shape=box,color=red];
		j2041920023 -> j2959829733;
	j3546666480 [label="Nie chcę tego przyznawać, ale możesz mieć rację... Sol, przebacz mi.",shape=box,color=blue];
		j3546666480 -> j636489540;
	j436572263 [label="Diabeł jest potężny i obiecuje siłę, gdyby coś poszło nie tak, non ?",shape=box,color=blue];
		j436572263 -> j1828948725;
		j436572263 -> j2966618220;
	j636489540 [label="Evaluate expressions",color=orange];
		j636489540 -> j358362731 [label="RoatheFamilyFail",color=purple];
		j636489540 -> j3392014496 [label="RoatheRedeemed, RoatheFamilyDelay
",color=purple];
		j636489540 -> j3392014496 [label="RoatheRedeemed, RoatheFamilySuccess
",color=purple];
		j636489540 -> j3265613566 [label="RoatheVillain, RoatheFamilyDelay
",color=purple];
		j636489540 -> j3265613566 [label="RoatheVillain, RoatheFamilySuccess",color=purple];
		j636489540 -> j1360103513 [label="false",color=purple];
	j2959829733 [label="Jesteś tego pewien ? Jeśli zdołam odłożyć na bok moją niechęć do diabła, ty także zdołasz, non ?",shape=box,color=blue];
		j2959829733 -> j2577608766;
		j2959829733 -> j2633161988;
	j1828948725 [label="Nie, musi być inny sposób. Nie zamierzam prosić go o pomoc.",shape=box,color=red];
		j1828948725 -> j2959829733;
	j2966618220 [label="Masz rację. Nie sądziłem, że się zgodzisz. Bałem się zapytać.",shape=box,color=red];
		j2966618220 -> j636489540;
	j358362731 [label="Czy pomoże nam w tej sprawie ?",shape=box,color=blue];
		j358362731 -> j20664690;
	j3392014496 [label="Czy pomoże nam w tej sprawie ?",shape=box,color=blue];
		j3392014496 -> j2350264973;
	j3265613566 [label="Czy pomoże nam w tej sprawie ?",shape=box,color=blue];
		j3265613566 -> j1309264565;
	j1360103513 [label="Do you think you can convince him to help us, though ?",shape=box,color=blue];
		j1360103513 -> j2983543606;
		j1360103513 -> j2916249019;
	j2577608766 [label="No, I'm sorry. ",shape=box,color=red];
		j2577608766 -> j1559202369;
	j2633161988 [label="W porządku, jeśli tobie to nie przeszkadza, ja też się zgodzę.",shape=box,color=red];
		j2633161988 -> j1320836340;
	j20664690 [label="No, unfortunately... I think that was a dead end with him. Do you think there's another way?",shape=box,color=red];
		j20664690 -> j299788686;
	j2350264973 [label="He will. I've convinced him to help reunite them - and you won't believe this - I think it's so that he can help protect Entrati's family. They're all that really remains of the Orokin, after all.",shape=box,color=red];
		j2350264973 -> j4101791948;
	j1309264565 [label="He will. I've convinced him to help reunite them - and you won't be surprised by this - I think it's mostly to spite Albrecht in his absence.",shape=box,color=red];
		j1309264565 -> j3897834681;
	j2983543606 [label="Nothing is settled yet. He's... well, you know how he can be.",shape=box,color=red];
		j2983543606 -> j2913252443;
	j2916249019 [label="Jeszcze nad tym pracuję, ale myślę, że tak.",shape=box,color=red];
		j2916249019 -> j1104176810;
	j1559202369 [label="+20 Chemistry",color=orange];
		j1559202369 -> j1453975680;
	j1320836340 [label="Oui, I do not have to enjoy it, but it is un médicament we must swallow, I suppose.",shape=box,color=blue];
		j1320836340 -> j636489540;
	j299788686 [label="Oh ! That is... unfortunate. I do not know ? I do not think so... Can you think of another approach with the devil ? Or a way to try again ?",shape=box,color=blue];
		j299788686 -> j2084525027;
	j4101791948 [label="He is helping to protect the family of the man who turned him into protoframe against his will, and cast him into the past, robbing him of his memories...",shape=box,color=blue];
		j4101791948 -> j1368276259;
	j3897834681 [label="Masz rację, nie jestem zaskoczona.",shape=box,color=blue];
		j3897834681 -> j1119956236;
		j3897834681 -> j1027940999;
	j2913252443 [label="Check boolean RoatheDating",color=orange];
		j2913252443 -> j2605065851 [label=true,color=green];
		j2913252443 -> j249759519 [label=false,color=brown];
	j1104176810 [label="Check boolean RoatheDating",color=orange];
		j1104176810 -> j2049866354 [label=true,color=green];
		j1104176810 -> j2674063867 [label=false,color=brown];
	j1453975680 [label="W takim razie zgodzę się z twoją decyzją.",shape=box,color=blue];
		j1453975680 -> j1179567760;
	j2084525027 [label="W międzyczasie pomówię z Leonem, ale nie robię sobie nadziei.",shape=box,color=blue];
		j2084525027 -> j860725021;
	j1368276259 [label="+20 Chemistry",color=orange];
		j1368276259 -> j2344930806;
	j1119956236 [label="Ale przynajmniej pomoże. Dopilnuję, żeby nie spełnił swoich gróźb.",shape=box,color=red];
		j1119956236 -> j3352304792;
	j1027940999 [label="Myślę, że to tylko wymówka.",shape=box,color=red];
		j1027940999 -> j3874679625;
	j2605065851 [label="Oui, I do. But I think you have a special way of convincing him, where all others have failed, non ?",shape=box,color=blue];
		j2605065851 -> j3261528415;
		j2605065851 -> j2794326461;
	j249759519 [label="Oui, certainly I do. That devil can be obstinate at the best of times. Sometimes, I think he just enjoys being contrary !",shape=box,color=blue];
		j249759519 -> j1894359500;
		j249759519 -> j1488766059;
	j2049866354 [label="Myślę, że masz swój sposób, żeby go przekonać, kiedy innym się nie udało, non ?",shape=box,color=blue];
		j2049866354 -> j3261528415;
		j2049866354 -> j2794326461;
	j2674063867 [label="Życzę ci szczęścia. Diabeł potrafi być uparty nawet w dobrych chwilach. Czasami myślę, że po prostu lubi być przekorny !",shape=box,color=blue];
		j2674063867 -> j1894359500;
		j2674063867 -> j1488766059;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j860725021 [label="+20 Chemistry",color=orange];
		j860725021 -> j2316683364;
	j2344930806 [label="Bardzo pomyliłam się w ocenie naszego diabła...",shape=box,color=blue];
		j2344930806 -> j1281258510;
	j3352304792 [label="Oui. At least you are around to ensure we keep him from following through on his... baser instincts.",shape=box,color=blue];
		j3352304792 -> j2198758823;
	j3874679625 [label="Oui, I hope you are correct.",shape=box,color=blue];
		j3874679625 -> j2198758823;
	j3261528415 [label="Nie chcę wykorzystywać naszej relacji jako narzędzia w negocjacji.",shape=box,color=red];
		j3261528415 -> j3129009359;
	j2794326461 [label="Co sugerujesz?",shape=box,color=red];
		j2794326461 -> j2099895899;
	j1894359500 [label="Szczerze to nawet mi się to podoba, choć brzmi to dziwnie. Dogadujemy się.",shape=box,color=red];
		j1894359500 -> j3139285886;
	j1488766059 [label="Czasami taki bywa, ale myślę, że wiele z tego jest tylko na pokaz.",shape=box,color=red];
		j1488766059 -> j3424505322;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j2316683364 [label="Diabeł bywa kapryśny ! Jak to mawiają, c'est la vie !",shape=box,color=blue];
		j2316683364 -> j3569999725;
	j1281258510 [label="I nie jestem na tyle głupcem, by nie dostrzec, jak ważną rolę odegrałeś w tym ty !",shape=box,color=blue];
		j1281258510 -> j3242583483;
	j2198758823 [label="Check boolean MarieDating",color=orange];
		j2198758823 -> j2884175498 [label=true,color=green];
		j2198758823 -> j2074343049 [label=false,color=brown];
	j3129009359 [label="Oh ! That is not what I was implying, pardonne-moi ! Simply that he seems to favor you, so you may have his ear where all others he may ignore.",shape=box,color=blue];
		j3129009359 -> j1830374284;
	j2099895899 [label="+5 Chemistry",color=orange];
		j2099895899 -> j406818974;
	j3139285886 [label="Oui, he certainly does seem to favor you. Perhaps it is because you share a time and a place, where we do not ? Why else would he ?",shape=box,color=blue];
		j3139285886 -> j3822691405;
	j3424505322 [label="Oui ? What do you mean ?",shape=box,color=blue];
		j3424505322 -> j3822691405;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j3242583483 [label="Check boolean MarieDating",color=orange];
		j3242583483 -> j91321375 [label=true,color=green];
		j3242583483 -> j1294019211 [label=false,color=brown];
	j2884175498 [label="+10 Chemistry",color=orange];
		j2884175498 -> j3208239704;
	j2074343049 [label="+10 Chemistry",color=orange];
		j2074343049 -> j549463413;
	j1830374284 [label="+5 Chemistry",color=orange];
		j1830374284 -> j964572087;
	j406818974 [label="I certainly have no idea what you mean ! I am not insinuating anything at all. I am a purely une innocente Sœur de Sol.",shape=box,color=blue];
		j406818974 -> j1263254129;
	j3822691405 [label="Evaluate expressions",color=orange];
		j3822691405 -> j912477341 [label="RoatheVillain",color=purple];
		j3822691405 -> j1564131278 [label="RoatheRedeemed",color=purple];
		j3822691405 -> j1050330288 [label="RoatheUnloved3",color=purple];
		j3822691405 -> j204886456 [label="RoatheTraitor2",color=purple];
		j3822691405 -> j3327228172 [label="RoatheExecutor2",color=purple];
		j3822691405 -> j730334124 [label="false",color=purple];
	j91321375 [label="Merci, merci, merci, mon cœur !",shape=box,color=blue];
		j91321375 -> j3770030583;
	j1294019211 [label="Merci, merci, merci !",shape=box,color=blue];
		j1294019211 -> j3770030583;
	j3208239704 [label="Well ! When the time comes, I will be ready and waiting ! Until then, merci, mon cœur.",shape=box,color=blue];
		j3208239704 -> j3569999725;
	j549463413 [label="Well ! When the time comes, I will be ready and waiting ! Until then, merci.",shape=box,color=blue];
		j549463413 -> j3569999725;
	j964572087 [label="Po prostu cieszę się, że jesteś szczęśliwy A jeśli diabeł ma gdzie... wykazać swoje zdolności... to chyba lepiej dla wszystkich, non ?",shape=box,color=blue];
		j964572087 -> j2404116705;
	j1263254129 [label="Nigdy bym nie zasugerowała, że diabeł cię polubił, że może posłucha cię wtedy, kiedy inni zostaliby zignorowani.",shape=box,color=blue];
		j1263254129 -> j596531857;
	j912477341 [label="Każdy w jego życiu próbował zrobić z niego potwora. Chyba jestem pierwszą osobą, która tego nie zrobiła.",shape=box,color=red];
		j912477341 -> j2725359830;
	j1564131278 [label="Jest w nim wiele cech, których po prostu nie potrafi okazać. To nie jest zbroja sama w sobie – po prostu nie ufa, że ludzie go nie zranią.",shape=box,color=red];
		j1564131278 -> j1511043375;
	j1050330288 [label="Jego serce... zostało wielokrotnie złamane w ciągu jego życia. Przez to jest okryty bliznami i kolcami, to tyle.",shape=box,color=red];
		j1050330288 -> j4019606204;
	j204886456 [label="Chyba rozumiem, jak długo żył. Doświadczyłem tyle samo śmierci, co on.",shape=box,color=red];
		j204886456 -> j4030238878;
	j3327228172 [label="Zawsze starał się robić to, co słuszne. Może w niewłaściwy sposób, jasne – ale próbował ocalić System Origin przed Orokin.",shape=box,color=red];
		j3327228172 -> j2387677789;
	j730334124 [label="I enjoy his wry sense of humor. He's clever, when you get past his ego.",shape=box,color=red];
		j730334124 -> j1658361894;
	j3770030583 [label="Cóż ! Kiedy nadejdzie czas, będę gotowa !",shape=box,color=blue];
		j3770030583 -> j3569999725;
	j2404116705 [label="Even more so for us all if you serve as a bit of un ange upon his shoulder to temper him.",shape=box,color=blue];
		j2404116705 -> j115373746;
		j2404116705 -> j3047332479;
	j596531857 [label="And never during private moments. Non. Jamais.",shape=box,color=blue];
		j596531857 -> j4112996194;
		j596531857 -> j1973333943;
	j2725359830 [label="And I suppose I am atop that list of late, non ? I suppose I should... consider his reasons, for why he is the way he is. Condemnation saves no souls.",shape=box,color=blue];
		j2725359830 -> j1097453354;
	j1511043375 [label="There is always a pain we hide from those around us. Something we seek to shelter, for fear others will wield it. I suppose I should strive to be kinder to him, if what you say is true.",shape=box,color=blue];
		j1511043375 -> j1097453354;
	j4019606204 [label="Nie potrafię sobie wyobrazić, ile miłości i żalu musiał doświadczyć przez te lata. To wydaje się nierealne, nawet biorąc pod uwagę wszystko, co widziałam.",shape=box,color=blue];
		j4019606204 -> j4126079853;
	j4030238878 [label="Czasami, kiedy z nim rozmawiam, zapomina, ile stuleci przeżył. To wydaje się nierealne, nawet biorąc pod uwagę wszystko, co widziałam.",shape=box,color=blue];
		j4030238878 -> j2436376889;
	j2387677789 [label="There are always... nuances, oui ? Always reasons for acting one way or another. I suppose I should strive to be kinder to him, if what you say is true.",shape=box,color=blue];
		j2387677789 -> j1097453354;
	j1658361894 [label="Nikt nigdy nie zaprzeczył, że diabeł jest zdolny.",shape=box,color=blue];
		j1658361894 -> j3954330825;
	j115373746 [label="Kto mówi, że próbuję sprowadzić go na właściwą drogę?",shape=box,color=red];
		j115373746 -> j1632492114;
	j3047332479 [label="Niczego nie obiecuję.",shape=box,color=red];
		j3047332479 -> j1001129056;
	j4112996194 [label="Nie znałem tej części ciebie.",shape=box,color=red];
		j4112996194 -> j1830374284;
	j1973333943 [label="You surprise me. I'm impressed. ",shape=box,color=red];
		j1973333943 -> j1830374284;
	j1097453354 [label="+10 Chemistry",color=orange];
		j1097453354 -> j1880743110;
	j4126079853 [label="Oui, what damage could that cause a soul ? I see why you would wish to find another who understood. And he, you.",shape=box,color=blue];
		j4126079853 -> j1097453354;
	j2436376889 [label="To have lived so long, to have seen so much death - to have paid so much of it yourself ?",shape=box,color=blue];
		j2436376889 -> j4126079853;
	j3954330825 [label="+5 Chemistry",color=orange];
		j3954330825 -> j1880743110;
	j1632492114 [label="Add -1 to Thermostat counter",color=orange];
		j1632492114 -> j499605529;
	j1001129056 [label="Add 1 to Thermostat counter",color=orange];
		j1001129056 -> j2945128303;
	j1880743110 [label="I am simply glad the devil has someone to speak with who might seek to temper him. Un ange upon his shoulder.",shape=box,color=blue];
		j1880743110 -> j115373746;
		j1880743110 -> j3047332479;
	j499605529 [label="+10 Chemistry",color=orange];
		j499605529 -> j1524002402;
	j2945128303 [label="+10 Chemistry",color=orange];
		j2945128303 -> j2617418891;
	j1524002402 [label="Perhaps you are right... what is un ange without son diable ? He reminds us all of what we should strive to avoid.",shape=box,color=blue];
		j1524002402 -> j104956296;
	j2617418891 [label="Oui, I fear there is a wickedness in him that cannot truly be cured. He enjoys it too much.",shape=box,color=blue];
		j2617418891 -> j104956296;
	j104956296 [label="Well ! If and when you convince the devil to aid us in our mission, I will be ready and waiting ! Until then !",shape=box,color=blue];
		j104956296 -> j3569999725;
}