		3652 -> 3661 [label=false,color=brown];
	3647 [label="W takim razie zgodzę się z twoją decyzją.",shape=box,color=blue];
		3647 -> 3653;
	3657 [label="W międzyczasie pomówię z Leonem, ale nie robię sobie nadziei.",shape=box,color=blue];
		3657 -> 3666;
	3656 [label="+20 Chemistry",color=orange];
		3656 -> 3665;
	3654 [label="Ale przynajmniej pomoże. Dopilnuję, żeby nie spełnił swoich gróźb.",shape=box,color=red];
		3654 -> 3663;
	3655 [label="Myślę, że to tylko wymówka.",shape=box,color=red];
		3655 -> 3664;
	3659 [label="Oui, I do. But I think you have a special way of convincing him, where all others have failed, non ?",shape=box,color=blue];
		3659 -> 3669;
		3659 -> 3670;
	3658 [label="Oui, certainly I do. That devil can be obstinate at the best of times. Sometimes, I think he just enjoys being contrary !",shape=box,color=blue];
		3658 -> 3667;
		3658 -> 3668;
	3660 [label="Myślę, że masz swój sposób, żeby go przekonać, kiedy innym się nie udało, non ?",shape=box,color=blue];
		3660 -> 3669;
		3660 -> 3670;
	3661 [label="Życzę ci szczęścia. Diabeł potrafi być uparty nawet w dobrych chwilach. Czasami myślę, że po prostu lubi być przekorny !",shape=box,color=blue];
		3661 -> 3667;
		3661 -> 3668;
	3653 [label="Update boolean MarieFamilyFail",color=orange];
		3653 -> 3662;
	3666 [label="+20 Chemistry",color=orange];
		3666 -> 3674;
	3665 [label="Bardzo pomyliłam się w ocenie naszego diabła...",shape=box,color=blue];
		3665 -> 3673;
	3663 [label="Oui. At least you are around to ensure we keep him from following through on his... baser instincts.",shape=box,color=blue];
		3663 -> 3672;
	3664 [label="Oui, I hope you are correct.",shape=box,color=blue];
		3664 -> 3672;
	3669 [label="Nie chcę wykorzystywać naszej relacji jako narzędzia w negocjacji.",shape=box,color=red];
		3669 -> 3677;
	3670 [label="Co sugerujesz?",shape=box,color=red];
		3670 -> 3678;
	3667 [label="Szczerze to nawet mi się to podoba, choć brzmi to dziwnie. Dogadujemy się.",shape=box,color=red];
		3667 -> 3675;
	3668 [label="Czasami taki bywa, ale myślę, że wiele z tego jest tylko na pokaz.",shape=box,color=red];
		3668 -> 3676;
	3662 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3662 -> 3671;
	3674 [label="Diabeł bywa kapryśny ! Jak to mawiają, c'est la vie !",shape=box,color=blue];
		3674 -> 3682;
	3673 [label="I nie jestem na tyle głupcem, by nie dostrzec, jak ważną rolę odegrałeś w tym ty !",shape=box,color=blue];
		3673 -> 3681;
	3672 [label="Check boolean MarieDating",color=orange];
		3672 -> 3680 [label=true,color=green];
		3672 -> 3679 [label=false,color=brown];
	3677 [label="Oh ! That is not what I was implying, pardonne-moi ! Simply that he seems to favor you, so you may have his ear where all others he may ignore.",shape=box,color=blue];
		3677 -> 3684;
	3678 [label="+5 Chemistry",color=orange];
		3678 -> 3685;
	3675 [label="Oui, he certainly does seem to favor you. Perhaps it is because you share a time and a place, where we do not ? Why else would he ?",shape=box,color=blue];
		3675 -> 3683;
	3676 [label="Oui ? What do you mean ?",shape=box,color=blue];
		3676 -> 3683;
	3671 [label="Chat ends.",color=orange];
	3682 [label="Update boolean MarieFamilySuccess",color=orange];
		3682 -> 3690;
	3681 [label="Check boolean MarieDating",color=orange];
		3681 -> 3689 [label=true,color=green];
		3681 -> 3688 [label=false,color=brown];
	3680 [label="+10 Chemistry",color=orange];
		3680 -> 3687;
	3679 [label="+10 Chemistry",color=orange];
		3679 -> 3686;
	3684 [label="+5 Chemistry",color=orange];
		3684 -> 3697;
	3685 [label="I certainly have no idea what you mean ! I am not insinuating anything at all. I am a purely une innocente Sœur de Sol.",shape=box,color=blue];
		3685 -> 3698;
	3683 [label="Evaluate expressions",color=orange];
		3683 -> 3692 [label="RoatheVillain",color=purple];
		3683 -> 3693 [label="RoatheRedeemed",color=purple];
