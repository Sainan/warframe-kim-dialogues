		j2617491924 -> j3012414020 [label=true,color=green];
		j2617491924 -> j2994459556 [label=false,color=brown];
	j3415717254 [label="Le Cardinal pozostawił to nam... może zatroszczyć się o jego duszę ? Albo przynajmniej zadbać o łańcuchy, które go trzymają. Je préférerais le renvoyer en enfer.",shape=box,color=blue];
		j3415717254 -> j2942048866;
