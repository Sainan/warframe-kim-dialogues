		j2548023018 -> j1516934107;
	j236770631 [label="Jestem zaskoczona, że znów zwracasz się do mnie po moje przemyślenia. Jasno już przedstawiłeś, że nie chcesz, żebym mówiła źle o nim i jemu podobnych.",shape=box,color=blue];
		j236770631 -> j2197591416;
		j236770631 -> j893690561;
	j3381225033 [label="Przyznam, że szczerze nie wiem jak podejść do tego tematu. Przyciąga Cię niczym un papillon vers une flamme.",shape=box,color=blue];
		j3381225033 -> j710227047;
		j3381225033 -> j3560643747;
	j1065417075 [label="Nadal widzisz w nim sojusznika ? Zaproszenie go do swojej watahy to niebezpieczna gra, mój wilczku. Rzuci Ci się do gardła, kiedy będziesz się tego najmniej spodziewać.",shape=box,color=blue];
		j1065417075 -> j836475013;
		j1065417075 -> j3293083721;
	j468104716 [label="Jestem zaskoczona, że pytasz mnie o zdanie. Nie jest tajemnicą, że nie darzę diabła szacunkiem.",shape=box,color=blue];
		j468104716 -> j36194915;
		j468104716 -> j440286974;
	j1914896412 [label="Nie zdziwiłoby mnie, gdyby był ! W tym miejscu można spotkać ménagerie wszelkiego rodzaju.",shape=box,color=blue];
		j1914896412 -> j3065501052;
	j1516934107 [label="Oui, to całkiem urocze, prawda ? Często powiem coś do Monsieur Loida, a on patrzy na mnie, jak zagubione dziecko.",shape=box,color=blue];
		j1516934107 -> j4269300034;
	j2197591416 [label="Przepraszam, że odpowiedziałem tak ostro. Nie jestem jeszcze gotów potępiać jego czynów - próbuję je zrozumieć z obu stron.",shape=box,color=red];
		j2197591416 -> j2447257768;
	j893690561 [label="Prowadził życie, które trudno zrozumieć. Ale byłem ciekaw, czy opowiedziałabyś mi, jak się poznaliście.",shape=box,color=red];
		j893690561 -> j253833089;
	j710227047 [label="Próbuję tylko zrozumieć, dlaczego jest jaki jest.",shape=box,color=red];
		j710227047 -> j81811841;
	j3560643747 [label="Jeśli go zrozumiem, mogę być w stanie nakierować go na... trochę mniej szkodliwą drogę.",shape=box,color=red];
		j3560643747 -> j2010816973;
	j836475013 [label="Rozumiem, ale nie mogę go nienawidzić za to, co musiał zrobić w służbie swojego ludu. Też byłem w takiej sytuacji.",shape=box,color=red];
		j836475013 -> j4116536475;
	j3293083721 [label="Jest jednym z najgroźniejszych Orokin, jakich kiedykolwiek znało imperium. Odrzucić taką pomoc to głupota.",shape=box,color=red];
		j3293083721 -> j911847343;
	j36194915 [label="Wiem, dlatego myślę, że musisz go znać. Chciałbym go lepiej zrozumieć.",shape=box,color=red];
		j36194915 -> j3983632520;
	j440286974 [label="Dlatego zwracam się do Ciebie. Chciałbym go lepiej zrozumieć, a nie do końca ufam jego wersji historii.",shape=box,color=red];
		j440286974 -> j3872795540;
	j3065501052 [label="Ale co znaczy ten zwrot ? Jeśli w salonie stoi słoń, dlaczego o nim nie rozmawiamy ?",shape=box,color=blue];
		j3065501052 -> j2734679216;
	j4269300034 [label="A jako człowiek, który mógłby być służącym samej Królowej, jest to dla mnie ogromny powód do dumy.",shape=box,color=blue];
		j4269300034 -> j3065501052;
