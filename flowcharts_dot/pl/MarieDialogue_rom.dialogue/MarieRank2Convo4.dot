	j3884627170 [label="Ale to rozmowa na inny dzień.",shape=box,color=blue];
		j3884627170 -> j1515939449;
	j3996694718 [label="To takie znajome, a jednak tak obce ! Kobiety w moich czasach nosiły ostentacyjne peruki zdolne sięgnąć nieba, albo suknie, pod którymi bez wysiłku można by schować cały sierociniec !",shape=box,color=blue];
		j3996694718 -> j63731719;
