	j3513751632 [label="Magnifique ! A więc chciałeś zapytać mnie o diabła, czyż nie ? Czego pragniesz się dowiedzieć ?",shape=box,color=blue];
		j3513751632 -> j3315255115;
		j3513751632 -> j3356446663;
		j3513751632 -> j2909791248;
	j147099618 [label="Koty są wspaniałe, kiedy kot jest kotem ! To dorosły mężczyzna, który przeżył wiele lat !",shape=box,color=blue];
		j147099618 -> j3607997281;
	j1564307151 [label="Lubię je, ale kiedy kot jest kotem ! To dorosły mężczyzna, który przeżył wiele lat !",shape=box,color=blue];
		j1564307151 -> j3607997281;
	j922125783 [label="Le Cardinal spojrzał na diabła i rzekł \"Urielu, Heretyku Xaty, za karę, odpowiedz - czy Orokin kiedykolwiek uzyskają przebaczenie ?\"",shape=box,color=blue];
		j922125783 -> j357556719;
	j1314937512 [label="Tym razem, jeśli Leon opowie Ci o burzy, która wstrząsnęła naszym domem, opowie o rzeczywistości, w której się znaleźliśmy.",shape=box,color=blue];
		j1314937512 -> j413454133;
	j413454133 [label="Przybycie tego zła w taką pogodę było naprawdę cliché.",shape=box,color=blue];
		j413454133 -> j2619490015;
	j3607997281 [label="Znacznie więcej lat, niż jakikolwiek inny człowiek, niebieski czy w inny sposób odmieniony nie do poznania, powinien był przeżyć.",shape=box,color=blue];
		j3607997281 -> j3222201027;
		j3607997281 -> j1132643690;
		j3607997281 -> j2883419331;
	j357556719 [label="I wraz z ogromnym hukiem, le Cardinal zniknął, jakby sami bogowie go wezwali.",shape=box,color=blue];
		j357556719 -> j1016136340;
	j3222201027 [label="Genetyczna modyfikacja swojego ciała była dla Orokin jak zmiana ubrań. Ale mimo to nadal są ludźmi. Albo byli.",shape=box,color=red];
		j3222201027 -> j4078291916;
	j1132643690 [label="Po za ogonem, wygląda... bardziej jak człowiek, niż wielu innych Orokin swego czasu.",shape=box,color=red];
		j1132643690 -> j4257142804;
	j2883419331 [label="Nie martw się. Uważam, że jesteś znacznie ładniejsza od niego.",shape=box,color=red];
		j2883419331 -> j2617491924;
	j1016136340 [label="A my zostaliśmy... z nim. Diabłem.",shape=box,color=blue];
		j1016136340 -> j3415717254;
	j4078291916 [label="Tak, chyba już nie wiem, czym jestem. W części Marią, w części... \"Wisp\", i po części... jakkolwiek nazwać tę Plagę krążącą w moich żyłach.",shape=box,color=blue];
		j4078291916 -> j3884627170;
	j4257142804 [label="Tak, patrzyłam na stary portret le Cardinal, na którym bardziej przypominał diabła. Opowiedział mi o zwyczajach Orokin, o tym, jak siebie zmieniali.",shape=box,color=blue];
		j4257142804 -> j3996694718;
