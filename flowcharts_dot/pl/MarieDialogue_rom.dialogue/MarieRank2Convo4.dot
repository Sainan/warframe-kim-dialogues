		636 -> 645;
	637 [label="Add 1 to Thermostat",color=orange];
		637 -> 646;
	635 [label="Nie mogę sobie wyobrazić, żeby ludzie otaczający się latającymi głowami i mówiącymi zwierzętami nie uznali słonia za powód do rozmowy.",shape=box,color=blue];
		635 -> 644;
	651 [label="+5 Chemistry",color=orange];
		651 -> 660;
	652 [label="I zakładasz, że tego nie rozumiem ? Nie jestem głupcem - nie popadłam w histerię przez podróż, którą przebyłam, przez zmiany, które przeżyłam.",shape=box,color=blue];
		652 -> 661;
		652 -> 662;
	649 [label="Martwi mnie cel tego zrozumienia. Ale nie potrzebujesz moich kazań. Nie jestem Twoją matką i nie chcę psuć tej przyjaźni tak wcześnie...",shape=box,color=blue];
		649 -> 658;
	650 [label="+5 Chemistry",color=orange];
		650 -> 659;
	647 [label="+5 Chemistry",color=orange];
		647 -> 656;
	648 [label="Proszę Cię tylko o ostrożność. Zdołałby uwieść Lua, by dała mu wszystkie gwiazdy z nieba.",shape=box,color=blue];
		648 -> 657;
	645 [label="Martwi mnie cel tego zrozumienia. Ale nie potrzebujesz moich kazań.",shape=box,color=blue];
		645 -> 654;
	646 [label="+5 Chemistry",color=orange];
		646 -> 655;
	644 [label="... podejrzewam, że właśnie odpowiedziałam na swoje pytanie, prawda ?",shape=box,color=blue];
		644 -> 653;
	660 [label="Doceniam i przyjmuję Twoje przeprosiny, ale miej na uwadze, jakie zmiany przeżyłam. Znajduje się w otoczeniu l'impossible. ",shape=box,color=blue];
		660 -> 666;
	661 [label="Nieważne. Sam porozmawiam z diabłem.",shape=box,color=red];
		661 -> 667;
	662 [label="Przepraszam, nie chciałem się z Tobą wykłócać. Nie o to mi chodziło. ",shape=box,color=red];
		662 -> 668;
		662 -> 669;
	658 [label="Martwię się o Ciebie. To zwinna i podstępna bestia... ",shape=box,color=blue];
		658 -> 664;
	659 [label="Ogłosiłabym Cię Świętym Sol za samo podjęcie się tej próby.",shape=box,color=blue];
		659 -> 664;
	656 [label="Oui, klątwa żołnierza... Spalić miasto, by ratować państwo. Zabić człowieka, by ratować rodzinę. Ale gdzie kończy się ten koszmar ?",shape=box,color=blue];
		656 -> 665;
	657 [label="Pamiętaj kim i czym jest... nie bogiem, ani nawet bestią. Jest tylko człowiekiem. Człowiekiem, który ma o sobie zbyt wysokie zdanie.",shape=box,color=blue];
		657 -> 664;
	654 [label="Zdołałby oczarować Lua, by dała mu gwiazdy z nieba. Bądź ostrożny, to wszystko, co chcę powiedzieć.",shape=box,color=blue];
		654 -> 664;
	655 [label="Mądrze postępujesz nie słuchając jego słów. Zdołałby uwieść Lua, by dała mu wszystkie gwiazdy z nieba.",shape=box,color=blue];
		655 -> 664;
	653 [label="W rzeczy samej. Znaczy to \"porozmawiać na temat, którego chcemy uniknąć\".",shape=box,color=red];
		653 -> 663;
	666 [label="Jeśli uważasz, że nie jestem w stanie zrozumieć i żywić sympatii wobec przeżyć innych, proszę, przemyśl to jeszcze raz, oui ?",shape=box,color=blue];
		666 -> 673;
	667 [label="Qu'il en soit ainsi.",shape=box,color=blue];
		667 -> 674;
	668 [label="Jest żołnierzem. Musiał robić straszne rzeczy w imię \"wyższego celu\". Wiem, jakie to uczucie. Czasami takie życie zamienia cię... w coś takiego, jak on.",shape=box,color=red];
		668 -> 675;
	669 [label="Żył przez setki, jeśli nie tysiące lat. Masz pojęcie, jaki ma to wpływ na człowieka? Ile zniósł bólu i cierpienia? Ja wiem.",shape=box,color=red];
		669 -> 676;
	664 [label="Ale chciałeś zapytać mnie o diabła, czyż nie ? Czego pragniesz się dowiedzieć ?",shape=box,color=blue];
		664 -> 670;
		664 -> 671;
		664 -> 672;
	665 [label="Musimy patrzeć na wojnę oczami statystyka, bo gdybyśmy spojrzeli na nią oczami poległych, nigdy nie przestalibyśmy już płakać.",shape=box,color=blue];
		665 -> 664;
	663 [label="I jeśli mogę pozwolić sobie zgadywać po raz kolejny, un éléphant... ma też niebieską skórę ?",shape=box,color=blue];
		663 -> 618;
	673 [label="A ja wtedy rozważę odpowiedzieć na Twoje pytania.",shape=box,color=blue];
		673 -> 661;
		673 -> 680;
	674 [label="Chat ends.",color=orange];
	675 [label="+5 Chemistry",color=orange];
		675 -> 681;
	676 [label="+5 Chemistry",color=orange];
		676 -> 682;
	670 [label="Dlaczego tak go nienawidzisz?",shape=box,color=red];
		670 -> 677;
	671 [label="Dlaczego Entrati zostawił go z Tobą i Leonem?",shape=box,color=red];
		671 -> 678;
	672 [label="Ciekawiło mnie, jak się poznaliście?",shape=box,color=red];
		672 -> 679;
	680 [label="Zgoda.",shape=box,color=red];
		680 -> 687;
	681 [label="Ach, i teraz ja czuję się jak głupiec. Ależ oczywiście, wiesz jak to jest zabijać w imię \"wyższego celu\", jak to ująłeś... Oczywiście, że pragnąłbyś zrozumieć kogoś, kto czynił tak samo.",shape=box,color=blue];
		681 -> 688;
	682 [label="Ach, i teraz ja czuję się jak głupiec. Ależ oczywiście, wiesz jak to jest żyć i umierać w koło... Oczywiście, że pragnąłbyś zrozumieć kogoś, kto przeżył to samo.",shape=box,color=blue];
		682 -> 688;
	677 [label="Czyż to nie oczywiste ? Zachowuje się niczym wielkie zuchwałe kocię, uparcie znaczące swoje terytorium i zrzucające rzeczy w półek.",shape=box,color=blue];
		677 -> 683;
		677 -> 684;
	678 [label="Kiedy le Cardinal Dimanche - Entrati - opuścił nas po raz ostatni, zostawił za sobą diabła. Okrytego ranami i ledwie pamiętającego własne imię.",shape=box,color=blue];
		678 -> 685;
	679 [label="Diabeł przyszedł do nas w burzliwą noc, która wstrząsnęła murami naszej Cathédrale.",shape=box,color=blue];
		679 -> 686;
	687 [label="Update boolean MarieRoatheWarning",color=orange];
		687 -> 694;
	688 [label="Dojdźmy więc do porozumienia. Jeśli uważasz, że nie jestem w stanie zrozumieć i żywić sympatii wobec przeżyć innych, proszę, przemyśl to jeszcze raz, oui ?",shape=box,color=blue];
		688 -> 673;
	683 [label="Osobiście uwielbiam koty. ",shape=box,color=red];
		683 -> 689;
	684 [label="Nie przepadasz za kotami?",shape=box,color=red];
		684 -> 690;
	685 [label="Teraz już wiem, że on dopiero co otrzymał sérum, a transformacja, której się nie poddasz, jest... bolesna.",shape=box,color=blue];
		685 -> 691;
	686 [label="Check boolean MarieLyonVisions",color=orange];
		686 -> 693 [label=true,color=green];
		686 -> 692 [label=false,color=brown];
	694 [label="Magnifique ! A więc chciałeś zapytać mnie o diabła, czyż nie ? Czego pragniesz się dowiedzieć ?",shape=box,color=blue];
		694 -> 670;
		694 -> 671;
		694 -> 672;
	689 [label="Koty są wspaniałe, kiedy kot jest kotem ! To dorosły mężczyzna, który przeżył wiele lat !",shape=box,color=blue];
		689 -> 695;
	690 [label="Lubię je, ale kiedy kot jest kotem ! To dorosły mężczyzna, który przeżył wiele lat !",shape=box,color=blue];
		690 -> 695;
	691 [label="Le Cardinal spojrzał na diabła i rzekł \"Urielu, Heretyku Xaty, za karę, odpowiedz - czy Orokin kiedykolwiek uzyskają przebaczenie ?\"",shape=box,color=blue];
		691 -> 696;
	693 [label="Tym razem, jeśli Leon opowie Ci o burzy, która wstrząsnęła naszym domem, opowie o rzeczywistości, w której się znaleźliśmy.",shape=box,color=blue];
		693 -> 692;
	692 [label="Przybycie tego zła w taką pogodę było naprawdę cliché.",shape=box,color=blue];
		692 -> 678;
	695 [label="Znacznie więcej lat, niż jakikolwiek inny człowiek, niebieski czy w inny sposób odmieniony nie do poznania, powinien był przeżyć.",shape=box,color=blue];
		695 -> 697;
		695 -> 698;
		695 -> 3906;
	696 [label="I wraz z ogromnym hukiem, le Cardinal zniknął, jakby sami bogowie go wezwali.",shape=box,color=blue];
		696 -> 699;
	697 [label="Genetyczna modyfikacja swojego ciała była dla Orokin jak zmiana ubrań. Ale mimo to nadal są ludźmi. Albo byli.",shape=box,color=red];
		697 -> 700;
	698 [label="Po za ogonem, wygląda... bardziej jak człowiek, niż wielu innych Orokin swego czasu.",shape=box,color=red];
		698 -> 701;
	3906 [label="Nie martw się. Uważam, że jesteś znacznie ładniejsza od niego.",shape=box,color=red];
		3906 -> 3907;
	699 [label="A my zostaliśmy... z nim. Diabłem.",shape=box,color=blue];
		699 -> 702;
	700 [label="Tak, chyba już nie wiem, czym jestem. W części Marią, w części... \"Wisp\", i po części... jakkolwiek nazwać tę Plagę krążącą w moich żyłach.",shape=box,color=blue];
		700 -> 703;
	701 [label="Tak, patrzyłam na stary portret le Cardinal, na którym bardziej przypominał diabła. Opowiedział mi o zwyczajach Orokin, o tym, jak siebie zmieniali.",shape=box,color=blue];
		701 -> 704;
	3907 [label="Check boolean DrifterMarie",color=orange];
		3907 -> 3908 [label=true,color=green];
		3907 -> 3909 [label=false,color=brown];
	702 [label="Le Cardinal pozostawił to nam... może zatroszczyć się o jego duszę ? Albo przynajmniej zadbać o łańcuchy, które go trzymają. Je préférerais le renvoyer en enfer.",shape=box,color=blue];
		702 -> 705;
		702 -> 706;
	703 [label="Ale to rozmowa na inny dzień.",shape=box,color=blue];
		703 -> 707;
	704 [label="To takie znajome, a jednak tak obce ! Kobiety w moich czasach nosiły ostentacyjne peruki zdolne sięgnąć nieba, albo suknie, pod którymi bez wysiłku można by schować cały sierociniec !",shape=box,color=blue];
		704 -> 708;
	3908 [label="Wciąż przez ciebie się rumienię ! Monsieur Loid zacznie się zastanawiać, co ja tu robię !",shape=box,color=blue];
		3908 -> 3911;
	3909 [label="Update boolean DrifterMarie",color=orange];
		3909 -> 3910;
	705 [label="Myślisz, że każdemu można w końcu wybaczyć?",shape=box,color=red];
		705 -> 709;
	706 [label="Czy jest w nim coś, co polubiłaś?",shape=box,color=red];
		706 -> 710;
	707 [label="Update boolean MarieInfestation",color=orange];
		707 -> 711;
	708 [label="Ludzie zawsze będą ludźmi - a ludzie będą niezadowoleni z form nadanych im przez Sol. Chętni kształtować swoje ciało jak z gliny. Sama nie jestem wyjątkiem.",shape=box,color=blue];
		708 -> 712;
	3911 [label="Ale to też żadne wyzwanie być piękniejszym od diabła, non ? Ma przystojne rysy twarzy, ale ten błękit...",shape=box,color=blue];
		3911 -> 3912;
	3910 [label="Ach ! Przez ciebie się rumienię ! Monsieur Loid zacznie się zastanawiać, co ja tutaj wyprawiam ?",shape=box,color=blue];
		3910 -> 3911;
	709 [label="Czy w to wierzę ? Oui. Tak. Wierzę, że wszystkie dusze mogą zapracować na wybaczenie.",shape=box,color=blue];
		709 -> 713;
	710 [label="Nic. Absolutnie nic.",shape=box,color=blue];
		710 -> 714;
		710 -> 715;
	711 [label="Moim problemem jest to, że ma całe mordercze ego kota i zero uroku małego, puchatego towarzysza.",shape=box,color=blue];
		711 -> 716;
	712 [label="Z wielką chęcią przyjęłam sérum, które uczyniło mnie po części Marią, po części \"Wisp\", i po części... jakkolwiek nazwać tę Plagę krążącą w moich żyłach.",shape=box,color=blue];
		712 -> 703;
	3912 [label="Mimo wszystko dziękuję za komplement, jeśli był szczery. Zaskoczyło mnie to. Czy możemy... wrócić do tematu ?",shape=box,color=blue];
		3912 -> 707;
	713 [label="Pozostaje natomiast pytanie... czy w ogóle odczuwa on taką potrzebę ?",shape=box,color=blue];
		713 -> 717;
	714 [label="Cóż, dziękuję za opowieść. Więc Entrati chciał... żeby zyskał przebaczenie? Za co? Tau? Za bycie Orokin?",shape=box,color=red];
		714 -> 718;
	715 [label="Dobrze, wierzę Ci. Nie myślę, że byś mnie okłamywała.",shape=box,color=red];
		715 -> 719;
	716 [label="Ma o sobie zbyt wysokie mniemanie. Bez wahania odbiera życia. Bawi się swoimi wrogami, jakby byli zaledwie myszką zagonioną w kąt.",shape=box,color=blue];
		716 -> 702;
	717 [label="Nie można przebaczyć tym, którzy nie sądzą, że tego potrzebują. Łatwiej przyjdzie nauczyć rybę latać.",shape=box,color=blue];
		717 -> 720;
	718 [label="Nie mam pojęcia. Pozostaje też pytanie, czy w ogóle odczuwa on potrzebę przebaczenia ?",shape=box,color=blue];
		718 -> 717;
	719 [label="Fie ! Niech będzie. Ale jedno nas łączy... diabelna słabość do słodyczy. Diabeł często wracał do le Cathédrale podkradając ciastka ze sklepów, bez należytej zapłaty.",shape=box,color=blue];
		719 -> 721;
	720 [label="Lecz porozmawiaj z nim osobiście, jeśli chcesz na własnej skórze przekonać się, jak ogromnym wyzwaniem byłoby wygranie tej wojny.",shape=box,color=blue];
		720 -> 722;
	721 [label="Tłumaczyłam mu, że jest to kradzież, a on wszczynał długie tyrady o tym, jak to Orokin wkrótce zyskaliby władzę nad światem i ta kradzież nie miała większego znaczenia...",shape=box,color=blue];
		721 -> 723;
	722 [label="Mogę życzyć Ci tylko szczęścia.",shape=box,color=blue];
		722 -> 724;
	723 [label="Chciałam go skrzyczeć, ale Leon byłby zmuszony interweniować...",shape=box,color=blue];
		723 -> 725;
		723 -> 726;
	724 [label="+10 Chemistry",color=orange];
		724 -> 727;
	725 [label="A ciastka...?",shape=box,color=red];
		725 -> 728;
	726 [label="Przeszło Ci przez myśl, że przynosił je, byście wszyscy mogli ich spróbować?",shape=box,color=red];
		726 -> 729;
	727 [label="Chat ends.",color=orange];
	728 [label="Nie mogliśmy pozwolić, żeby się zmarnowały, prawda? Zjedzenie ich było grzechem, ale gorszym grzechem byłoby pozwolić im zgnić. Więc cieszyliśmy się nimi.",shape=box,color=blue];
		728 -> 730;
