	j2830907886 [label="To bardzo kwiecisty język.",shape=box,color=red];
		j2830907886 -> j2046558378;
	j2412766050 [label="Uznam, że to nie są komplementy.",shape=box,color=red];
		j2412766050 -> j3503205597;
	j873438799 [label="Widzę rybę, ptaka i... czymkolwiek jest M'sieur Tagfer. Widzę w Sanctum wiele dziwów, ale nie un éléphant - to jakiś żart ?",shape=box,color=blue];
