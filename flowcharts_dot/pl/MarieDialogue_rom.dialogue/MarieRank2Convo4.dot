digraph {
	599 [label="MarieRank2Convo4 begins.",color=orange];
		599 -> 602;
		599 -> 601;
		599 -> 600;
	602 [label="Mogę zapytać Cię o Roathe'a? Czy ściągnę tym na siebie Twój gniew?",shape=box,color=red];
		602 -> 605;
	601 [label="Możemy porozmawiać o słoniu w salonie?",shape=box,color=red];
		601 -> 604;
	600 [label="[Koniec]",shape=box,color=red];
		600 -> 603;
	605 [label="Ce diable est un imbécile qui se croit au-dessus de tout reproche ! Je préfèrerais boire un pot de vernis à bois plutôt que de passer une minute de plus à l'écouter s'enorgueillir comme un chat qui se lèche le pelage !",shape=box,color=blue];
		605 -> 607;
		605 -> 608;
	604 [label="Quoi! Où ça? Un éléphant ?!",shape=box,color=blue];
		604 -> 606;
	603 [label="Chat ends.",color=orange];
	607 [label="To bardzo kwiecisty język.",shape=box,color=red];
		607 -> 610;
	608 [label="Uznam, że to nie są komplementy.",shape=box,color=red];
		608 -> 611;
	606 [label="Widzę rybę, ptaka i... czymkolwiek jest M'sieur Tagfer. Widzę w Sanctum wiele dziwów, ale nie un éléphant - to jakiś żart ?",shape=box,color=blue];
		606 -> 609;
	610 [label="+5 Chemistry",color=orange];
		610 -> 614;
	611 [label="+5 Chemistry",color=orange];
		611 -> 615;
	609 [label="Och! Przepraszam, to powiedzenie, którego nauczyli mnie moi przyjaciele z 1999 roku... ",shape=box,color=red];
		609 -> 612;
		609 -> 613;
	614 [label="Merci. Był bardzo kwiecisty, ale nie powinnam była wyładowywać swojej złości na Tobie, wybacz mi.",shape=box,color=blue];
		614 -> 618;
	615 [label="Nie, nie były. Wybacz mi, nie powinnam była Cię tym obarczać. ",shape=box,color=blue];
		615 -> 618;
	612 [label="Nie chodzi o prawdziwego słonia.",shape=box,color=red];
		612 -> 616;
	613 [label="Teraz już rozumiem, dlaczego wszyscy mówią, że jestem uroczy, kiedy jestem zagubiony...",shape=box,color=red];
		613 -> 617;
	618 [label="Evaluate expressions",color=orange];
		618 -> 624 [label="MarieRoatheWarning",color=purple];
		618 -> 623 [label="DrifterRoathe",color=purple];
		618 -> 622 [label="MarieRoatheSoldier",color=purple];
		618 -> 621 [label="false",color=purple];
	616 [label="+5 Chemistry",color=orange];
		616 -> 619;
	617 [label="+5 Chemistry",color=orange];
		617 -> 620;
	624 [label="Jestem zaskoczona, że znów zwracasz się do mnie po moje przemyślenia. Jasno już przedstawiłeś, że nie chcesz, żebym mówiła źle o nim i jemu podobnych.",shape=box,color=blue];
		624 -> 633;
		624 -> 634;
	623 [label="Przyznam, że szczerze nie wiem jak podejść do tego tematu. Przyciąga Cię niczym un papillon vers une flamme.",shape=box,color=blue];
		623 -> 631;
		623 -> 632;
	622 [label="Nadal widzisz w nim sojusznika ? Zaproszenie go do swojej watahy to niebezpieczna gra, mój wilczku. Rzuci Ci się do gardła, kiedy będziesz się tego najmniej spodziewać.",shape=box,color=blue];
		622 -> 629;
		622 -> 630;
	621 [label="Jestem zaskoczona, że pytasz mnie o zdanie. Nie jest tajemnicą, że nie darzę diabła szacunkiem.",shape=box,color=blue];
		621 -> 627;
		621 -> 628;
	619 [label="Nie zdziwiłoby mnie, gdyby był ! W tym miejscu można spotkać ménagerie wszelkiego rodzaju.",shape=box,color=blue];
		619 -> 625;
	620 [label="Oui, to całkiem urocze, prawda ? Często powiem coś do Monsieur Loida, a on patrzy na mnie, jak zagubione dziecko.",shape=box,color=blue];
		620 -> 626;
	633 [label="Przepraszam, że odpowiedziałem tak ostro. Nie jestem jeszcze gotów potępiać jego czynów - próbuję je zrozumieć z obu stron.",shape=box,color=red];
		633 -> 642;
	634 [label="Prowadził życie, które trudno zrozumieć. Ale byłem ciekaw, czy opowiedziałabyś mi, jak się poznaliście.",shape=box,color=red];
		634 -> 643;
	631 [label="Próbuję tylko zrozumieć, dlaczego jest jaki jest.",shape=box,color=red];
		631 -> 640;
	632 [label="Jeśli go zrozumiem, mogę być w stanie nakierować go na... trochę mniej szkodliwą drogę.",shape=box,color=red];
		632 -> 641;
	629 [label="Rozumiem, ale nie mogę go nienawidzić za to, co musiał zrobić w służbie swojego ludu. Też byłem w takiej sytuacji.",shape=box,color=red];
		629 -> 638;
	630 [label="Jest jednym z najgroźniejszych Orokin, jakich kiedykolwiek znało imperium. Odrzucić taką pomoc to głupota.",shape=box,color=red];
		630 -> 639;
	627 [label="Wiem, dlatego myślę, że musisz go znać. Chciałbym go lepiej zrozumieć.",shape=box,color=red];
		627 -> 636;
	628 [label="Dlatego zwracam się do Ciebie. Chciałbym go lepiej zrozumieć, a nie do końca ufam jego wersji historii.",shape=box,color=red];
		628 -> 637;
	625 [label="Ale co znaczy ten zwrot ? Jeśli w salonie stoi słoń, dlaczego o nim nie rozmawiamy ?",shape=box,color=blue];
		625 -> 635;
	626 [label="A jako człowiek, który mógłby być służącym samej Królowej, jest to dla mnie ogromny powód do dumy.",shape=box,color=blue];
		626 -> 625;
	642 [label="Add 1 to Thermostat",color=orange];
		642 -> 651;
	643 [label="Add 1 to Thermostat",color=orange];
		643 -> 652;
