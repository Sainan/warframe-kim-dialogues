		j3883824792 -> j1295101715;
	j2016315728 [label="I zakładasz, że tego nie rozumiem ? Nie jestem głupcem - nie popadłam w histerię przez podróż, którą przebyłam, przez zmiany, które przeżyłam.",shape=box,color=blue];
		j2016315728 -> j4095338971;
		j2016315728 -> j2219132163;
	j1759625177 [label="Martwi mnie cel tego zrozumienia. Ale nie potrzebujesz moich kazań. Nie jestem Twoją matką i nie chcę psuć tej przyjaźni tak wcześnie...",shape=box,color=blue];
