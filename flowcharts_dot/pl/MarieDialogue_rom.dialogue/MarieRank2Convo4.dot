		j2909791248 -> j1847983092;
	j1475677925 [label="Zgoda.",shape=box,color=red];
		j1475677925 -> j876003970;
	j2707928042 [label="Ach, i teraz ja czuję się jak głupiec. Ależ oczywiście, wiesz jak to jest zabijać w imię \"wyższego celu\", jak to ująłeś... Oczywiście, że pragnąłbyś zrozumieć kogoś, kto czynił tak samo.",shape=box,color=blue];
		j2707928042 -> j3731699429;
	j2135283383 [label="Ach, i teraz ja czuję się jak głupiec. Ależ oczywiście, wiesz jak to jest żyć i umierać w koło... Oczywiście, że pragnąłbyś zrozumieć kogoś, kto przeżył to samo.",shape=box,color=blue];
		j2135283383 -> j3731699429;
	j669321850 [label="Czyż to nie oczywiste ? Zachowuje się niczym wielkie zuchwałe kocię, uparcie znaczące swoje terytorium i zrzucające rzeczy w półek.",shape=box,color=blue];
		j669321850 -> j3356103706;
		j669321850 -> j3337102634;
	j2619490015 [label="Kiedy le Cardinal Dimanche - Entrati - opuścił nas po raz ostatni, zostawił za sobą diabła. Okrytego ranami i ledwie pamiętającego własne imię.",shape=box,color=blue];
		j2619490015 -> j411601210;
	j1847983092 [label="Diabeł przyszedł do nas w burzliwą noc, która wstrząsnęła murami naszej Cathédrale.",shape=box,color=blue];
