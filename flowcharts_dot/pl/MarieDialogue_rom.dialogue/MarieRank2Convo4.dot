		j876003970 -> j3513751632;
	j3731699429 [label="Dojdźmy więc do porozumienia. Jeśli uważasz, że nie jestem w stanie zrozumieć i żywić sympatii wobec przeżyć innych, proszę, przemyśl to jeszcze raz, oui ?",shape=box,color=blue];
		j3731699429 -> j3212900187;
