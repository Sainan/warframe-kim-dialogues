		j3348383191 -> j1989167881;
	j3033208633 [label="... podejrzewam, że właśnie odpowiedziałam na swoje pytanie, prawda ?",shape=box,color=blue];
		j3033208633 -> j221662829;
	j1295101715 [label="Doceniam i przyjmuję Twoje przeprosiny, ale miej na uwadze, jakie zmiany przeżyłam. Znajduje się w otoczeniu l'impossible. ",shape=box,color=blue];
		j1295101715 -> j3501339915;
	j4095338971 [label="Nieważne. Sam porozmawiam z diabłem.",shape=box,color=red];
		j4095338971 -> j4014689105;
	j2219132163 [label="Przepraszam, nie chciałem się z Tobą wykłócać. Nie o to mi chodziło. ",shape=box,color=red];
		j2219132163 -> j3481233462;
		j2219132163 -> j3613098656;
	j3104262061 [label="Martwię się o Ciebie. To zwinna i podstępna bestia... ",shape=box,color=blue];
		j3104262061 -> j4182125961;
	j4186869648 [label="Ogłosiłabym Cię Świętym Sol za samo podjęcie się tej próby.",shape=box,color=blue];
		j4186869648 -> j4182125961;
	j1166415626 [label="Oui, klątwa żołnierza... Spalić miasto, by ratować państwo. Zabić człowieka, by ratować rodzinę. Ale gdzie kończy się ten koszmar ?",shape=box,color=blue];
		j1166415626 -> j3486169221;
	j1127287801 [label="Pamiętaj kim i czym jest... nie bogiem, ani nawet bestią. Jest tylko człowiekiem. Człowiekiem, który ma o sobie zbyt wysokie zdanie.",shape=box,color=blue];
		j1127287801 -> j4182125961;
	j166262314 [label="Zdołałby oczarować Lua, by dała mu gwiazdy z nieba. Bądź ostrożny, to wszystko, co chcę powiedzieć.",shape=box,color=blue];
		j166262314 -> j4182125961;
	j1989167881 [label="Mądrze postępujesz nie słuchając jego słów. Zdołałby uwieść Lua, by dała mu wszystkie gwiazdy z nieba.",shape=box,color=blue];
		j1989167881 -> j4182125961;
	j221662829 [label="W rzeczy samej. Znaczy to \"porozmawiać na temat, którego chcemy uniknąć\".",shape=box,color=red];
		j221662829 -> j64959350;
	j3501339915 [label="Jeśli uważasz, że nie jestem w stanie zrozumieć i żywić sympatii wobec przeżyć innych, proszę, przemyśl to jeszcze raz, oui ?",shape=box,color=blue];
		j3501339915 -> j3212900187;
	j4014689105 [label="Qu'il en soit ainsi.",shape=box,color=blue];
		j4014689105 -> "Chat ends.";
	j3481233462 [label="Jest żołnierzem. Musiał robić straszne rzeczy w imię \"wyższego celu\". Wiem, jakie to uczucie. Czasami takie życie zamienia cię... w coś takiego, jak on.",shape=box,color=red];
		j3481233462 -> j2662448777;
	j3613098656 [label="Żył przez setki, jeśli nie tysiące lat. Masz pojęcie, jaki ma to wpływ na człowieka? Ile zniósł bólu i cierpienia? Ja wiem.",shape=box,color=red];
		j3613098656 -> j2327728792;
	j4182125961 [label="Ale chciałeś zapytać mnie o diabła, czyż nie ? Czego pragniesz się dowiedzieć ?",shape=box,color=blue];
		j4182125961 -> j3315255115;
		j4182125961 -> j3356446663;
		j4182125961 -> j2909791248;
	j3486169221 [label="Musimy patrzeć na wojnę oczami statystyka, bo gdybyśmy spojrzeli na nią oczami poległych, nigdy nie przestalibyśmy już płakać.",shape=box,color=blue];
		j3486169221 -> j4182125961;
