		j1515939449 -> j1684539503;
	j63731719 [label="Ludzie zawsze będą ludźmi - a ludzie będą niezadowoleni z form nadanych im przez Sol. Chętni kształtować swoje ciało jak z gliny. Sama nie jestem wyjątkiem.",shape=box,color=blue];
