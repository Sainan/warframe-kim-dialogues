		j380536992 -> j1874016344;
		j380536992 -> j619515099;
	j2782582094 [label="Merci. Był bardzo kwiecisty, ale nie powinnam była wyładowywać swojej złości na Tobie, wybacz mi.",shape=box,color=blue];
		j2782582094 -> j3218359144;
	j3901846834 [label="Nie, nie były. Wybacz mi, nie powinnam była Cię tym obarczać. ",shape=box,color=blue];
		j3901846834 -> j3218359144;
	j1874016344 [label="Nie chodzi o prawdziwego słonia.",shape=box,color=red];
		j1874016344 -> j2438914778;
	j619515099 [label="Teraz już rozumiem, dlaczego wszyscy mówią, że jestem uroczy, kiedy jestem zagubiony...",shape=box,color=red];
		j619515099 -> j2548023018;
