	1490 [label="Z Leonem wszystko w porządku?",shape=box,color=red];
		1490 -> 1493;
	1489 [label="[Koniec]",shape=box,color=red];
		1489 -> 1492;
	1494 [label="Mój drogi Leon był już od dawna zadomowiony w le Cathédrale , gdy Mère Supérieure mnie przyjęła, a ja dołączyłam do Kościoła Świetlistych jako siostra. (Jestem podekscytowana, że ze sobą rozmawiacie !)",shape=box,color=blue];
		1494 -> 1497;
		1494 -> 1498;
	1493 [label="Muszę cię poprosić, żebyś lepiej określił, o czym mówisz. I proszę, abyś zrobił to taktownie, mając na uwadze, że to moja bratnia dusza.",shape=box,color=blue];
		1493 -> 1495;
		1493 -> 1496;
	1492 [label="Chat ends.",color=orange];
	1497 [label="Czy... potrzebowałaś miejsca, żeby przenocować?",shape=box,color=red];
		1497 -> 1501;
	1498 [label="Mogę zadać nietaktowne pytanie?",shape=box,color=red];
		1498 -> 1502;
	1495 [label="Możemy porozmawiać o czymś innym, jeśli ten temat ci nie odpowiada.",shape=box,color=red];
		1495 -> 1499;
	1496 [label="Nie chcę ci działać na nerwy. Po prostu się o niego martwię. Widzę stoicki spokój, ale czuję, że cierpi.",shape=box,color=red];
		1496 -> 1500;
	1501 [label="Zostałam tam porzucona przez rodzinę, kiedy byłam jeszcze małą dziewczynką. Spędziłam wiele lat jako żebraczka, żyjąc, jak mogłam.",shape=box,color=blue];
		1501 -> 1507;
	1502 [label="+5 Chemistry",color=orange];
		1502 -> 1508;
	1499 [label="Nie, nie, nic z tych rzeczy. Jestem po prostu przyzwyczajona do tego, że ciekawscy gapie kręcą się wokół niego i walą o kraty, jakby był jakimś monstre de cirque.",shape=box,color=blue];
		1499 -> 1503;
		1499 -> 1504;
		1499 -> 1505;
	1500 [label="+5 Chemistry",color=orange];
		1500 -> 1506;
	1507 [label="Update boolean MarieBeggar1",color=orange];
		1507 -> 1512;
	1508 [label="Nie przeszkadzaj sobie, nie bez powodu nazywają cię wilkiem ! To całkiem uroczę. Chyba nawet wiem, jakie pytanie cię nurtuje. Dlaczego skończyłam na ulicy ?",shape=box,color=blue];
		1508 -> 1501;
	1503 [label="Jak się poznaliście?",shape=box,color=red];
		1503 -> 1509;
	1504 [label="Przyzwyczaiłem się do bycia \"lokalną atrakcją\", rozumiem, przez co przechodzisz.",shape=box,color=red];
		1504 -> 1510;
	1505 [label="Nie ma sprawy, po prostu się o niego martwię.",shape=box,color=red];
		1505 -> 1511;
	1506 [label="Przepraszam za szorstki ton. Jestem po prostu przyzwyczajona do tego, że ciekawscy gapie kręcą się wokół niego i walą o kraty, jakby był jakimś monstre de cirque.",shape=box,color=blue];
		1506 -> 1504;
		1506 -> 1505;
	1512 [label="Możesz sobie wyobrazić, że ktoś taki jak ja, niezdolna ustać na własnych nogach, nie miała gdzie się podziać dans la Cité de la Lumière w moich czasach.",shape=box,color=blue];
		1512 -> 1518;
	1509 [label="Mój drogi Leon był już od dawna zadomowiony w le Cathédrale, gdy Mère Supérieure mnie przyjęła, a ja dołączyłam do Kościoła Świetlistych jako siostra.",shape=box,color=blue];
		1509 -> 1513;
		1509 -> 1514;
	1510 [label="Oui, mogę to sobie wyobrazić, podróżująca w czasie kreatura, zdolna zapętlić czas i przywoływać całe światy z nicości ! Prawdziwy z ciebie magik, non ?",shape=box,color=blue];
		1510 -> 1515;
		1510 -> 1516;
	1511 [label="+5 Chemistry",color=orange];
		1511 -> 1517;
	1518 [label="I chyba dlatego Leon tak szybko stał się dla mnie niczym rodzina. Nigdy nie patrzył na mnie z góry. Ja na niego też.",shape=box,color=blue];
		1518 -> 1525;
	1513 [label="Czy... potrzebowałaś miejsca, żeby przenocować?",shape=box,color=red];
		1513 -> 1519;
	1514 [label="Mogę zadać nietaktowne pytanie?",shape=box,color=red];
		1514 -> 1520;
	1515 [label="Całkiem trafny opis.",shape=box,color=red];
		1515 -> 1521;
	1516 [label="Mam nadzieję, że widzisz we mnie więcej, niż tylko to.",shape=box,color=red];
		1516 -> 1522;
	1517 [label="I uwielbiam Cię za to. Leon jest silny i zdolny znieść wiele przeciwieństw losu, ale niektóre ciężary łatwiej nieść razem.",shape=box,color=blue];
		1517 -> 1523;
		1517 -> 1524;
	1525 [label="Inni zachowywali się jak ciekawscy gapie, kręcąc się wokół niego i waląc o kraty, jakby był jakimś monstre de cirque.",shape=box,color=blue];
		1525 -> 1531;
	1519 [label="Zostałam tam porzucona przez rodzinę, kiedy byłam jeszcze małą dziewczynką. Spędziłam wiele lat jako żebraczka, żyjąc, jak mogłam.",shape=box,color=blue];
		1519 -> 1526;
	1520 [label="+5 Chemistry",color=orange];
		1520 -> 1527;
	1521 [label="+10 Chemistry",color=orange];
		1521 -> 1528;
	1522 [label="+15 Chemistry",color=orange];
		1522 -> 1529;
	1523 [label="Mam wrażenie, że nie chce ze mną rozmawiać.",shape=box,color=red];
		1523 -> 1530;
	1524 [label="Chcę mu pomóc, jeśli mogę. Od czego powinienem zacząć?",shape=box,color=red];
		1524 -> 1530;
	1531 [label="Mam nadzieję, że nie o to ci chodzi.",shape=box,color=blue];
		1531 -> 1536;
		1531 -> 1537;
	1526 [label="Update boolean MarieBeggar1",color=orange];
		1526 -> 1532;
	1527 [label="Nie przeszkadzaj sobie, nie bez powodu nazywają cię wilkiem ! To całkiem uroczę. Chyba nawet wiem, jakie pytanie cię nurtuje. Dlaczego skończyłam na ulicy ?",shape=box,color=blue];
		1527 -> 1519;
	1528 [label="Pewnego dnia napiszą o Tobie baśń ! Jaka to przyjemna myśl, może to ja ją napiszę. Ale powstałaby w języku galijskim ! Imaginez cela !",shape=box,color=blue];
		1528 -> 1533;
	1529 [label="Więc naprawdę rozumiem. Też jestem więcej niż Siostrą Marią, biedną dziewczynką bez stóp, którą nauczono latać. A Leon to więcej niż tragiczny ksiądz, dźwigający swoje brzemię w milczeniu.",shape=box,color=blue];
		1529 -> 1534;
	1530 [label="+10 Chemistry",color=orange];
		1530 -> 1535;
	1536 [label="Przyzwyczaiłem się do bycia \"lokalną atrakcją\" i wiem, jak się czujecie. Nie o to mi chodzi.",shape=box,color=red];
		1536 -> 1541;
	1537 [label="Nie, po prostu byłem ciekawy i trochę martwiłem się o niego. Myślę, że skrywa ogromny ból.",shape=box,color=red];
		1537 -> 1542;
	1532 [label="Możesz sobie wyobrazić, że ktoś taki jak ja, niezdolna ustać na własnych nogach, nie miała gdzie się podziać dans la Cité de la Lumière w moich czasach.",shape=box,color=blue];
		1532 -> 1538;
	1533 [label="A może lepiej o tym nie myśleć, bo jeszcze się stanie. Haha ! I z tym uroczym akcentem, obawiam się, że muszę się z tobą pożegnać. Szept nigdy nie ustaje !",shape=box,color=blue];
		1533 -> 1539;
	1534 [label="Pamiętaj o tym, a pozostaniemy dobrymi przyjaciółmi. I z tym uroczym akcentem, obawiam się, że muszę się z tobą pożegnać. Szept nigdy nie ustaje !",shape=box,color=blue];
		1534 -> 1540;
	1535 [label="Bądź cierpliwy. Leon... z początku nie jest zbyt otwarty, ale to nadejdzie we właściwym czasie. Pozna, jeśli masz dobre intencję. Ale teraz, muszę się z tobą pożegnać.",shape=box,color=blue];
		1535 -> 2424;
	1541 [label="Oui, mogę to sobie wyobrazić, podróżująca w czasie kreatura, zdolna zapętlić czas i przywoływać całe światy z nicości ! Prawdziwy z ciebie magik, non ?",shape=box,color=blue];
		1541 -> 1545;
		1541 -> 1546;
	1542 [label="+15 Chemistry",color=orange];
		1542 -> 1547;
	1538 [label="I chyba dlatego Leon tak szybko stał się dla mnie niczym rodzina. Nigdy nie patrzył na mnie z góry. Ja na niego też.",shape=box,color=blue];
		1538 -> 1543;
