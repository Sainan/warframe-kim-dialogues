	1546 [label="Mam nadzieję, że widzisz we mnie więcej, niż tylko to.",shape=box,color=red];
		1546 -> 1522;
	1547 [label="Masz tutaj rację, ale Leon uważa to też za konieczne, by chronić ludzi w swoim otoczeniu. Kiedy uzna, że nie jest to już konieczne, otworzy się przed tobą. Bądź cierpliwy, odezwie się do ciebie w odpowiednim czasie.",shape=box,color=blue];
		1547 -> 1550;
	1543 [label="Mam nadzieję, że niedługo będzie gotowy ze mną porozmawiać.",shape=box,color=red];
		1543 -> 1548;
	1544 [label="Cieszę się, że się odnaleźliście. Każdy z nas skrywa więcej, niż widać na pierwszy rzut oka.",shape=box,color=red];
		1544 -> 1549;
	1550 [label="Obawiam się, że muszę się z tobą pożegnać. Szept nigdy nie ustaje !",shape=box,color=blue];
