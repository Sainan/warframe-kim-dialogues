	j3748059301 [label="+5 Chemistry",color=orange];
		j3748059301 -> j2298170425;
	j1748212739 [label="Och, nie myśl, że chcę, żebyś był okrutny ! Nie ! Szanuj ich, bo są cenni i nie mieli udziału w tym, że stali się tacy, jacy są!",shape=box,color=blue];
