		1591 -> 1599;
	1592 [label="Kolejny dowód na to, że diabeł i jemu podobni słusznie zostali potępieni. Ale możesz mieć rację co do Otaka i jemu podobnych, a może ta wiara pozwala Ci zaznać spokoju.",shape=box,color=blue];
		1592 -> 1593;
	1593 [label="A ja mogę się mylić. Nie ma żadnej szkody w okazaniu bliźniemu szacunku i współczucia.",shape=box,color=blue];
		1593 -> 1600;
	1594 [label="Możliwe, że masz rację, ale nie sądzę, żeby diabły Orokin wiedziały więcej o działaniu duszy niż my. Nie byli bogami.",shape=box,color=blue];
