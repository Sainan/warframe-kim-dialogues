		1930 -> 1934;
	1931 [label="Co dokładnie sprawia ci problem?",shape=box,color=red];
		1931 -> 1934;
	1928 [label="Oczywiście, o co chodzi?",shape=box,color=red];
		1928 -> 1932;
	1929 [label="[Koniec]",shape=box,color=red];
		1929 -> 1933;
	1934 [label="Zapytałam Monsieur Nekraloida, czy zdobiąca go czaszka należała wcześniej do kogoś żywego.",shape=box,color=blue];
		1934 -> 1936;
	1932 [label="Zastanawiam się, dlaczego na jego plecach znajduje się druga twarz, narysowana jak przez dziecko.",shape=box,color=blue];
		1932 -> 1935;
	1933 [label="Chat ends.",color=orange];
	1936 [label="Monsieur Nekraloid odpowiedział mi, że to \"jego\" czaszka, choć powiedział też, że Monsieur Loid jest \"oryginałem\". Monsieur Loid wtrącił także i wyjaśnił, że jest to \"replika\" jego czaszki.",shape=box,color=blue];
		1936 -> 1938;
	1935 [label="Zapytałam Monsieur Nekraloida i Monsieur Loida, ale żaden z nich nie chciał o tym rozmawiać. Podzielili się tylko imieniem. Otak. Wypowiedzieli je z wielkim smutkiem.",shape=box,color=blue];
		1935 -> 1937;
	1938 [label="Jak to możliwe ? Co oznacza \"replika\" ? To prawdziwa czaszka ou bien c'est un faux ? Dlaczego odpowiedzi Monsieur Nekraloida i Monsieur Loida różnią się od siebie ?",shape=box,color=blue];
		1938 -> 1940;
		1938 -> 1941;
		1938 -> 1942;
	1937 [label="I tak oto trafiłam na Ciebie, z nadzieją, że zdołasz mi pomóc.",shape=box,color=blue];
		1937 -> 1939;
	1940 [label="Myślę, że z perspektywy Nekraloida, to jest jego czaszka. To prawda. Ale ze strony Loida, jest to tylko replika.",shape=box,color=red];
		1940 -> 1944;
	1941 [label="Szczerze, nie jestem pewien, z czego jest zrobiona. To może być kość, albo jakiś polimer...",shape=box,color=red];
		1941 -> 1945;
	1942 [label="Myślę, że sednem twojego pytania nie jest \"czy czaszka jest prawdziwa\" a \"czy Nekraloid jest prawdziwy\".",shape=box,color=red];
		1942 -> 1946;
	1939 [label="Czy opowiesz mi historię biednego Monsieur Otaka ?",shape=box,color=blue];
		1939 -> 1943;
	1944 [label="Myślę, że właśnie to mnie męczy. To, co obaj panowie postrzegają jako jej pochodzenie. Jeden z nich widzi w niej sacro-saint, a drugi zaledwie copie.",shape=box,color=blue];
		1944 -> 1948;
	1945 [label="Nie sądzę, żeby trapiła mnie kwestia tego, z czego czaszka jest zrobiona. Chodzi o jej pochodzenie. Albo to, co ci dwaj panowie sądzą na temat jej pochodzenia. Jeden widzi w niej sacro-saint, a drugi zaledwie copie.",shape=box,color=blue];
		1945 -> 1948;
	1946 [label="+5 Chemistry",color=orange];
		1946 -> 1949;
	1943 [label="Otak był kiedyś Archimedianem, uczonym Orokin. Nie spotkał go najszczęśliwszy los.",shape=box,color=red];
		1943 -> 1947;
	1948 [label="Evaluate expressions",color=orange];
