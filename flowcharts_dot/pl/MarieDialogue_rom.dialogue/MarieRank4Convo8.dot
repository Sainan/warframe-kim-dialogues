		j2246635101 -> j172402475;
	j366938164 [label="+5 Chemistry",color=orange];
		j366938164 -> j2511082154;
	j479231415 [label="+10 Chemistry",color=orange];
		j479231415 -> j1272808639;
	j1911143016 [label="Jak do tego doszło?",shape=box,color=red];
		j1911143016 -> j2612451744;
	j1756714009 [label="Mam nadzieję, że pewnego dnia będziesz mogła go poznać.",shape=box,color=red];
		j1756714009 -> j844528584;
	j2511082154 [label="Merci ! À la revoyure !",shape=box,color=blue];
		j2511082154 -> "Chat ends.";
	j1272808639 [label="Och ! To jedno z Praw Lua. W rocznicę śmierci zaplata się wianek z kwiatów i pozostawia go na czaszce, albo na grobie.",shape=box,color=blue];
		j1272808639 -> j3824220793;
	j844528584 [label="Oui. Ale to nie jego milczenie mnie niepokoi. Zapytałam Monsieur Nekraloida, czy zdobiąca go czaszka należała wcześniej do kogoś żywego.",shape=box,color=blue];
		j844528584 -> j2416449284;
	j3824220793 [label="W tradycyjnych kryptach ciała często pozostawały odsłonięte, oui ? Można było tak zrobić. Myślę, że nawet w tych czasach takie się ostały.",shape=box,color=blue];
		j3824220793 -> j1848832855;
	j1848832855 [label="Widzę to po malowidłach Orokin i ich zamiłowaniu do czaszek.",shape=box,color=blue];
		j1848832855 -> j1840859385;
		j1848832855 -> j4004501988;
		j1848832855 -> j2034469551;
	j1840859385 [label="To by wiele wyjaśniało.",shape=box,color=red];
		j1840859385 -> j2349155808;
	j4004501988 [label="Im bardziej świat się zmienia, co nie?",shape=box,color=red];
		j4004501988 -> j2349155808;
	j2034469551 [label="Myślę, że Córka kiedyś próbowała tak zrobić. Sprawisz, że będzie zazdrosna.",shape=box,color=red];
		j2034469551 -> j3565725098;
	j2349155808 [label="Oui ! Tyle czasu upłynęło, a wpływ pozostał. Cieszę się, że takie szczegóły pozostały niezmienione.",shape=box,color=blue];
		j2349155808 -> j1005232102;
	j3565725098 [label="Oui ? W takim razie czekam z niecierpliwością na dzień, w którym ją poznam ! Powiem jej, że nie dałam mu chwili spokoju.",shape=box,color=blue];
		j3565725098 -> j1005232102;
	j1005232102 [label="Sztuczna czaszka czy nie, Monsieur Nekraloid powinien otrzymać wianek. I robi się taki nieśmiały, kiedy go rozpieszczam ! Chyba by się zarumienił, gdyby mógł. Aż uśmiech ciśnie się na usta.",shape=box,color=blue];
		j1005232102 -> j4101990552;
	j4101990552 [label="À la revoyure !",shape=box,color=blue];
		j4101990552 -> "Chat ends.";
