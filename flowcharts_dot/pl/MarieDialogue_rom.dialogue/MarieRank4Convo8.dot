		1925 -> 1926 [label=false,color=brown];
	1927 [label="Włóczęgo, im dłużej tu siedzę z wiedzą Monsieur Nekraloida i Monsieur Otaka, tym bardziej mnie to nęka...",shape=box,color=blue];
		1927 -> 1930;
		1927 -> 1931;
	1926 [label="Włóczęgo, możemy porozmawiać ?",shape=box,color=blue];
		1926 -> 1928;
		1926 -> 1929;
