		j2480584847 -> j1966103733;
	j2449849645 [label="Nie wszystkie Cefalony powstały za karę. Ale sprawy na Deimosie... nie szły dobrze, a on został poważnie uszkodzony.",shape=box,color=red];
		j2449849645 -> j3998308863;
