		j3472122191 -> j3944010940;
	j2298170425 [label="Kolejny dowód na to, że diabeł i jemu podobni słusznie zostali potępieni. Ale możesz mieć rację co do Otaka i jemu podobnych, a może ta wiara pozwala Ci zaznać spokoju.",shape=box,color=blue];
		j2298170425 -> j1456216638;
	j1456216638 [label="A ja mogę się mylić. Nie ma żadnej szkody w okazaniu bliźniemu szacunku i współczucia.",shape=box,color=blue];
		j1456216638 -> j172402475;
	j1741558843 [label="Możliwe, że masz rację, ale nie sądzę, żeby diabły Orokin wiedziały więcej o działaniu duszy niż my. Nie byli bogami.",shape=box,color=blue];
		j1741558843 -> j1456216638;
	j1966103733 [label="Możesz mieć rację, a może ta wiara daje Ci spokój.",shape=box,color=blue];
		j1966103733 -> j1456216638;
	j3998308863 [label="Pauvre petit...",shape=box,color=blue];
