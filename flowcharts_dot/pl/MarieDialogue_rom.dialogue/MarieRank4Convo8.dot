	1601 [label="Jak do tego doszło?",shape=box,color=red];
		1601 -> 1934;
	1602 [label="Mam nadzieję, że pewnego dnia będziesz mogła go poznać.",shape=box,color=red];
		1602 -> 1609;
	1614 [label="Merci ! À la revoyure !",shape=box,color=blue];
		1614 -> 1617;
	1615 [label="Och ! To jedno z Praw Lua. W rocznicę śmierci zaplata się wianek z kwiatów i pozostawia go na czaszce, albo na grobie.",shape=box,color=blue];
		1615 -> 1618;
	1616 [label="Merci ! À la revoyure !",shape=box,color=blue];
		1616 -> 1617;
	1609 [label="Oui. Ale to nie jego milczenie mnie niepokoi. Zapytałam Monsieur Nekraloida, czy zdobiąca go czaszka należała wcześniej do kogoś żywego.",shape=box,color=blue];
		1609 -> 1936;
	1617 [label="Chat ends.",color=orange];
	1618 [label="W tradycyjnych kryptach ciała często pozostawały odsłonięte, oui ? Można było tak zrobić. Myślę, że nawet w tych czasach takie się ostały.",shape=box,color=blue];
		1618 -> 1619;
	1619 [label="Widzę to po malowidłach Orokin i ich zamiłowaniu do czaszek.",shape=box,color=blue];
		1619 -> 1620;
		1619 -> 1621;
		1619 -> 1622;
	1620 [label="To by wiele wyjaśniało.",shape=box,color=red];
		1620 -> 1623;
	1621 [label="Im bardziej świat się zmienia, co nie?",shape=box,color=red];
		1621 -> 1623;
	1622 [label="Myślę, że Córka kiedyś próbowała tak zrobić. Sprawisz, że będzie zazdrosna.",shape=box,color=red];
		1622 -> 1624;
	1623 [label="Oui ! Tyle czasu upłynęło, a wpływ pozostał. Cieszę się, że takie szczegóły pozostały niezmienione.",shape=box,color=blue];
		1623 -> 1625;
	1624 [label="Oui ? W takim razie czekam z niecierpliwością na dzień, w którym ją poznam ! Powiem jej, że nie dałam mu chwili spokoju.",shape=box,color=blue];
		1624 -> 1625;
	1625 [label="Sztuczna czaszka czy nie, Monsieur Nekraloid powinien otrzymać wianek. I robi się taki nieśmiały, kiedy go rozpieszczam ! Chyba by się zarumienił, gdyby mógł. Aż uśmiech ciśnie się na usta.",shape=box,color=blue];
		1625 -> 1626;
	1626 [label="À la revoyure !",shape=box,color=blue];
