	1596 [label="Update boolean MarieOtak1",color=orange];
		1596 -> 2945;
	1603 [label="Oui, to bardzo rozsądne. Myślę tylko na głos i zastanawiam się, kim są. Ale masz rację, nie zaszkodzi okazać odrobiny szacunku i współczucia.",shape=box,color=blue];
		1603 -> 1610;
	1604 [label="Możesz mieć rację. I mam taką nadzieję ! Niezależnie od prawdy, powinniśmy być mili — to świadoma istota, a to, co myśli, może też czuć.",shape=box,color=blue];
