		1948 -> 1560 [label="false",color=purple];
	1949 [label="Oui ! Masz rację, dokładnie o to chodzi. Jeden widzi w niej sacro-saint, a drugi zaledwie copie.",shape=box,color=blue];
		1949 -> 1948;
	1947 [label="Wszyscy uważali go za geniusza, za umysł, który zdołał wykorzystać kryształy argonowe.",shape=box,color=red];
		1947 -> 1556;
	1558 [label="W jaki sposób Monsieur Nekraloid może mieć własną duszę, kiedy nie ma nawet własnych kości ?",shape=box,color=blue];
		1558 -> 1562;
		1558 -> 1563;
		1558 -> 1564;
	1557 [label="Czy to świadczy o tym, że Monsieur Nekraloid nie ma duszy ?",shape=box,color=blue];
		1557 -> 1562;
		1557 -> 1563;
		1557 -> 1564;
	1559 [label="Wiem, że nie masz pewności, czy Monsieur Nekraloid może mieć duszę. Nie wyobrażam sobie, jak mógłby mieć duszę, kiedy nie ma nawet własnych kości.",shape=box,color=blue];
		1559 -> 1562;
		1559 -> 1563;
		1559 -> 1564;
	1560 [label="Rozmawiam z niezwykle skomplikowaną technologią, która udaje człowieka, czyż nie ? Niczym le phonographe, ale wielokroć bardziej skomplikowany.",shape=box,color=blue];
		1560 -> 1565;
		1560 -> 1566;
		1560 -> 1567;
		1560 -> 1568;
		1560 -> 1569;
	1556 [label="Które pozyskiwał z Pustki - to dzięki nim byliśmy w stanie stworzyć wiele potężnych warframe’ów i broni.",shape=box,color=red];
		1556 -> 1561;
	1562 [label="Możesz mieć rację. Może to naprawdę tylko kopie ludzi. Ale nie mam pewności, więc mimo wszystko powinniśmy traktować ich jak ludzi.",shape=box,color=red];
		1562 -> 1571;
	1563 [label="Myślę, że Nekraloid jest wyjątkiem, a nie regułą. Został stworzony jako replika osoby, a nie z osoby.",shape=box,color=red];
		1563 -> 1572;
	1564 [label="Masz rację. To chyba jest lepsze i bardziej humanitarne, niż dusze uwięzione w skomplikowanej maszynerii...",shape=box,color=red];
		1564 -> 1573;
	1565 [label="Nekraloid może nie mieć duszy, ale jest wyjątkowy. Inne Cefalony, jak Otak, mają. Ich stworzenie wymagało zniszczenia ich.",shape=box,color=red];
		1565 -> 1574;
	1566 [label="Masz rację. Więc co powinienem z tym zrobić?",shape=box,color=red];
		1566 -> 1575;
	1567 [label="Masz rację. Nie mają, ale to nie daje nam przyzwolenia, by traktować ich gorzej.",shape=box,color=red];
		1567 -> 1576;
	1568 [label="Nie wiem, czy masz rację, ale oni nadal myślą i czują. Nie możemy traktować ich jak rzeczy.",shape=box,color=red];
		1568 -> 1577;
	1569 [label="Nekraloid ma duszę, tak jak wszystkie Cefalony.",shape=box,color=red];
		1569 -> 1578;
	1561 [label="Jego specjalizacją była krystalografia. A jego prace odbywały się tutaj, w tych laboratoriach.",shape=box,color=red];
