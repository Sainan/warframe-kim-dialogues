digraph {
	"MarieRank4Convo8 begins." [color=orange];
		"MarieRank4Convo8 begins." -> j2786051379;
	j2786051379 [label="Check boolean MarieOtak1",color=orange];
		j2786051379 -> j4158541072 [label=true,color=green];
		j2786051379 -> j4208692212 [label=false,color=brown];
	j4158541072 [label="Włóczęgo, im dłużej tu siedzę z wiedzą Monsieur Nekraloida i Monsieur Otaka, tym bardziej mnie to nęka...",shape=box,color=blue];
		j4158541072 -> j991327635;
		j4158541072 -> j1992802788;
	j4208692212 [label="Włóczęgo, możemy porozmawiać ?",shape=box,color=blue];
		j4208692212 -> j941183954;
		j4208692212 -> j386906797;
	j991327635 [label="W jaki sposób?",shape=box,color=red];
		j991327635 -> j2612451744;
	j1992802788 [label="Co dokładnie sprawia ci problem?",shape=box,color=red];
		j1992802788 -> j2612451744;
	j941183954 [label="Oczywiście, o co chodzi?",shape=box,color=red];
		j941183954 -> j3010985812;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j2612451744 [label="Zapytałam Monsieur Nekraloida, czy zdobiąca go czaszka należała wcześniej do kogoś żywego.",shape=box,color=blue];
		j2612451744 -> j2416449284;
	j3010985812 [label="Zastanawiam się, dlaczego na jego plecach znajduje się druga twarz, narysowana jak przez dziecko.",shape=box,color=blue];
		j3010985812 -> j277368929;
	"Chat ends." [color=orange];
	j2416449284 [label="Monsieur Nekraloid odpowiedział mi, że to \"jego\" czaszka, choć powiedział też, że Monsieur Loid jest \"oryginałem\". Monsieur Loid wtrącił także i wyjaśnił, że jest to \"replika\" jego czaszki.",shape=box,color=blue];
		j2416449284 -> j3507439712;
	j277368929 [label="Zapytałam Monsieur Nekraloida i Monsieur Loida, ale żaden z nich nie chciał o tym rozmawiać. Podzielili się tylko imieniem. Otak. Wypowiedzieli je z wielkim smutkiem.",shape=box,color=blue];
		j277368929 -> j757374348;
	j3507439712 [label="Jak to możliwe ? Co oznacza \"replika\" ? To prawdziwa czaszka ou bien c'est un faux ? Dlaczego odpowiedzi Monsieur Nekraloida i Monsieur Loida różnią się od siebie ?",shape=box,color=blue];
		j3507439712 -> j1820130291;
		j3507439712 -> j3974179243;
		j3507439712 -> j1881351490;
	j757374348 [label="I tak oto trafiłam na Ciebie, z nadzieją, że zdołasz mi pomóc.",shape=box,color=blue];
		j757374348 -> j4114813884;
	j1820130291 [label="Myślę, że z perspektywy Nekraloida, to jest jego czaszka. To prawda. Ale ze strony Loida, jest to tylko replika.",shape=box,color=red];
		j1820130291 -> j3477287286;
	j3974179243 [label="Szczerze, nie jestem pewien, z czego jest zrobiona. To może być kość, albo jakiś polimer...",shape=box,color=red];
		j3974179243 -> j1442982838;
	j1881351490 [label="Myślę, że sednem twojego pytania nie jest \"czy czaszka jest prawdziwa\" a \"czy Nekraloid jest prawdziwy\".",shape=box,color=red];
		j1881351490 -> j1387518608;
	j4114813884 [label="Czy opowiesz mi historię biednego Monsieur Otaka ?",shape=box,color=blue];
		j4114813884 -> j2257668919;
	j3477287286 [label="Myślę, że właśnie to mnie męczy. To, co obaj panowie postrzegają jako jej pochodzenie. Jeden z nich widzi w niej sacro-saint, a drugi zaledwie copie.",shape=box,color=blue];
		j3477287286 -> j3408858168;
	j1442982838 [label="Nie sądzę, żeby trapiła mnie kwestia tego, z czego czaszka jest zrobiona. Chodzi o jej pochodzenie. Albo to, co ci dwaj panowie sądzą na temat jej pochodzenia. Jeden widzi w niej sacro-saint, a drugi zaledwie copie.",shape=box,color=blue];
		j1442982838 -> j3408858168;
	j1387518608 [label="+5 Chemistry",color=orange];
		j1387518608 -> j2329549829;
	j2257668919 [label="Otak był kiedyś Archimedianem, uczonym Orokin. Nie spotkał go najszczęśliwszy los.",shape=box,color=red];
		j2257668919 -> j2055956736;
	j3408858168 [label="Evaluate expressions",color=orange];
		j3408858168 -> j648058363 [label="MarieCephalonSoul",color=purple];
		j3408858168 -> j49779526 [label="MarieCephalonNoSoul",color=purple];
		j3408858168 -> j4901296 [label="MarieCephalonUnsure",color=purple];
		j3408858168 -> j259221823 [label="false",color=purple];
	j2329549829 [label="Oui ! Masz rację, dokładnie o to chodzi. Jeden widzi w niej sacro-saint, a drugi zaledwie copie.",shape=box,color=blue];
		j2329549829 -> j3408858168;
	j2055956736 [label="Wszyscy uważali go za geniusza, za umysł, który zdołał wykorzystać kryształy argonowe.",shape=box,color=red];
		j2055956736 -> j219287048;
	j648058363 [label="W jaki sposób Monsieur Nekraloid może mieć własną duszę, kiedy nie ma nawet własnych kości ?",shape=box,color=blue];
		j648058363 -> j690823854;
		j648058363 -> j3470872375;
		j648058363 -> j611521653;
	j49779526 [label="Czy to świadczy o tym, że Monsieur Nekraloid nie ma duszy ?",shape=box,color=blue];
		j49779526 -> j690823854;
		j49779526 -> j3470872375;
		j49779526 -> j611521653;
	j4901296 [label="Wiem, że nie masz pewności, czy Monsieur Nekraloid może mieć duszę. Nie wyobrażam sobie, jak mógłby mieć duszę, kiedy nie ma nawet własnych kości.",shape=box,color=blue];
		j4901296 -> j690823854;
		j4901296 -> j3470872375;
		j4901296 -> j611521653;
	j259221823 [label="Rozmawiam z niezwykle skomplikowaną technologią, która udaje człowieka, czyż nie ? Niczym le phonographe, ale wielokroć bardziej skomplikowany.",shape=box,color=blue];
		j259221823 -> j3934723694;
		j259221823 -> j1854068214;
		j259221823 -> j333952635;
		j259221823 -> j3796263823;
		j259221823 -> j4215503429;
	j219287048 [label="Które pozyskiwał z Pustki - to dzięki nim byliśmy w stanie stworzyć wiele potężnych warframe’ów i broni.",shape=box,color=red];
		j219287048 -> j1129378676;
	j690823854 [label="Możesz mieć rację. Może to naprawdę tylko kopie ludzi. Ale nie mam pewności, więc mimo wszystko powinniśmy traktować ich jak ludzi.",shape=box,color=red];
		j690823854 -> j427257983;
	j3470872375 [label="Myślę, że Nekraloid jest wyjątkiem, a nie regułą. Został stworzony jako replika osoby, a nie z osoby.",shape=box,color=red];
		j3470872375 -> j2726973436;
	j611521653 [label="Masz rację. To chyba jest lepsze i bardziej humanitarne, niż dusze uwięzione w skomplikowanej maszynerii...",shape=box,color=red];
		j611521653 -> j795643017;
	j3934723694 [label="Nekraloid może nie mieć duszy, ale jest wyjątkowy. Inne Cefalony, jak Otak, mają. Ich stworzenie wymagało zniszczenia ich.",shape=box,color=red];
		j3934723694 -> j3147719106;
	j1854068214 [label="Masz rację. Więc co powinienem z tym zrobić?",shape=box,color=red];
		j1854068214 -> j2866464171;
	j333952635 [label="Masz rację. Nie mają, ale to nie daje nam przyzwolenia, by traktować ich gorzej.",shape=box,color=red];
		j333952635 -> j1574510031;
	j3796263823 [label="Nie wiem, czy masz rację, ale oni nadal myślą i czują. Nie możemy traktować ich jak rzeczy.",shape=box,color=red];
		j3796263823 -> j3395506308;
	j4215503429 [label="Nekraloid ma duszę, tak jak wszystkie Cefalony.",shape=box,color=red];
		j4215503429 -> j1812016789;
	j1129378676 [label="Jego specjalizacją była krystalografia. A jego prace odbywały się tutaj, w tych laboratoriach.",shape=box,color=red];
		j1129378676 -> j2611755666;
