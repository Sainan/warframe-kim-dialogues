	j3944010940 [label="+5 Chemistry",color=orange];
		j3944010940 -> j3429532114;
	j172402475 [label="W każdym razie wrócę do plecenia wianka z kwiatów dla Monsieur Nekraloida. Trochę narzeka, ale nie dam się zniechęcić !",shape=box,color=blue];
		j172402475 -> j835357885;
		j172402475 -> j2790177970;
		j172402475 -> j549457622;
	j3134774711 [label="Boolean MarieOtak1 is now true.",color=orange];
		j3134774711 -> j3951815689;
	j1295916672 [label="Oui, to bardzo rozsądne. Myślę tylko na głos i zastanawiam się, kim są. Ale masz rację, nie zaszkodzi okazać odrobiny szacunku i współczucia.",shape=box,color=blue];
		j1295916672 -> j2246635101;
	j1566478287 [label="Możesz mieć rację. I mam taką nadzieję ! Niezależnie od prawdy, powinniśmy być mili — to świadoma istota, a to, co myśli, może też czuć.",shape=box,color=blue];
		j1566478287 -> j2246635101;
	j3429532114 [label="Niezależnie od prawdy, powinniśmy być mili — to świadoma istota, a to, co myśli, może też czuć.",shape=box,color=blue];
		j3429532114 -> j1456216638;
