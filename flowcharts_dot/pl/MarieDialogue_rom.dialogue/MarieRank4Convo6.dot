		j3595738305 -> j646924102;
	j692912219 [label="Też nie sądzę, żeby taki był jego cel, ale fakt pozostaje niezmieniony, oui ? Doceniam twoje chęci. Cela dit...",shape=box,color=blue];
		j692912219 -> j3595738305;
