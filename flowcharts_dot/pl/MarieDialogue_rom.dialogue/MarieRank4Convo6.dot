	j2694954737 [label="Nie wiem jak mu pomóc.",shape=box,color=red];
		j2694954737 -> j2741745893;
	j3896814164 [label="Kiedy byłeś uwięziony w świecie, który sam stworzyłeś, złapany w nieskończony cykl śmierci, czy ktoś ci pomógł ?",shape=box,color=blue];
		j3896814164 -> j3284084634;
		j3896814164 -> j653735640;
	j2562635620 [label="Oui, trudno patrzeć, jak cierpi... Zwłaszcza teraz, kiedy wiem, ile dla ciebie znaczy.",shape=box,color=blue];
		j2562635620 -> j2741745893;
	j2741745893 [label="To wielkie wyzwanie, odgadnąć, gdzie leżą jego granice. Często przesuwają się z dnia na dzień.",shape=box,color=blue];
		j2741745893 -> j1057841701;
	j3284084634 [label="Ich po moc na nic by się nie zdała, gdybym ją odrzucił.",shape=box,color=red];
		j3284084634 -> j1313116636;
		j3284084634 -> j55524440;
	j653735640 [label="Tak, od przyjaciół.",shape=box,color=red];
		j653735640 -> j1313116636;
		j653735640 -> j55524440;
	j1057841701 [label="Widziałam, jak zmaga się z ciężarem, który bogowie pozostawili na jego barkach. Wiedziałam, kiedy cicho czuwać u jego boku, albo kiedy powinnam stać jak ściana, w którą mógłby walić pięściami.",shape=box,color=blue];
		j1057841701 -> j2573133305;
	j1313116636 [label="Myślę, że Leon nie chce mojej pomocy.",shape=box,color=red];
		j1313116636 -> j3227208392;
	j55524440 [label="Próbuję być dla niego wsparciem, ale on nie słucha.",shape=box,color=red];
		j55524440 -> j1775771139;
	j2573133305 [label="Mais ça ? To ? To miejsce, słowa diabła, niepewność spowodowana przez le Cardinal... sprawiło mu to wiele bólu i modlę się, aby sobie z tym poradził.",shape=box,color=blue];
		j2573133305 -> j3813626862;
		j2573133305 -> j2398067606;
	j3227208392 [label="Więc... pozostało nam chyba tylko czekać, non ?",shape=box,color=blue];
		j3227208392 -> j1481512571;
	j1775771139 [label="Mnie też nie słucha, dlatego przyszłam pomówić z tobą. Zawsze udawało mi się go uspokoić -",shape=box,color=blue];
		j1775771139 -> j646924102;
	j3813626862 [label="Więc przyznajesz, że Entrati skrzywdził Leona? Jak się z tym czujesz?",shape=box,color=red];
		j3813626862 -> j1177127775;
	j2398067606 [label="Czuję, jakby balansował na krawędzi. Jak mogę mu pomóc?",shape=box,color=red];
		j2398067606 -> j1588359763;
	j1481512571 [label="Merci. Przepraszam, że zmarnowałam twój czas.",shape=box,color=blue];
		j1481512571 -> "Chat ends.";
	j646924102 [label="Jestem zaskoczona jego wściekłością, jego désespoir... unika mojego towarzystwa jak nigdy wcześniej.",shape=box,color=blue];
		j646924102 -> j3172597345;
	j1177127775 [label="Pas bien... Jak mam wybierać między miłością do mojego brata i uwielbieniem le Cardinal ? Jak mam wybierać między moją familie ?",shape=box,color=blue];
		j1177127775 -> j2904126493;
		j1177127775 -> j3431597169;
		j1177127775 -> j3207916966;
		j1177127775 -> j765451273;
