		1761 -> 1762 [label=false,color=brown];
		1761 -> 1765 [label=false,color=brown];
		1761 -> 1764 [label=false,color=brown];
	1762 [label="Jest dorosły. Sam zdecyduje, kiedy ma ochotę na rozmowę.",shape=box,color=red];
		1762 -> 1766;
	1763 [label="Serce mi pęka na widok tego, jak przeżywa swój ból. Nie wiem, jak mu pomóc.",shape=box,color=red];
		1763 -> 1767;
	1764 [label="[Koniec]",shape=box,color=red];
		1764 -> 1768;
	1765 [label="Nie wiem jak mu pomóc.",shape=box,color=red];
		1765 -> 1769;
	1766 [label="Kiedy byłeś uwięziony w świecie, który sam stworzyłeś, złapany w nieskończony cykl śmierci, czy ktoś ci pomógł ?",shape=box,color=blue];
		1766 -> 1770;
		1766 -> 1771;
	1767 [label="Oui, trudno patrzeć, jak cierpi... Zwłaszcza teraz, kiedy wiem, ile dla ciebie znaczy.",shape=box,color=blue];
		1767 -> 1769;
	1768 [label="Chat ends.",color=orange];
	1769 [label="To wielkie wyzwanie, odgadnąć, gdzie leżą jego granice. Często przesuwają się z dnia na dzień.",shape=box,color=blue];
		1769 -> 1772;
	1770 [label="Ich po moc na nic by się nie zdała, gdybym ją odrzucił.",shape=box,color=red];
		1770 -> 1773;
		1770 -> 1774;
	1771 [label="Tak, od przyjaciół.",shape=box,color=red];
		1771 -> 1773;
		1771 -> 1774;
	1772 [label="Widziałam, jak zmaga się z ciężarem, który bogowie pozostawili na jego barkach. Wiedziałam, kiedy cicho czuwać u jego boku, albo kiedy powinnam stać jak ściana, w którą mógłby walić pięściami.",shape=box,color=blue];
		1772 -> 1775;
	1773 [label="Myślę, że Leon nie chce mojej pomocy.",shape=box,color=red];
		1773 -> 1776;
	1774 [label="Próbuję być dla niego wsparciem, ale on nie słucha.",shape=box,color=red];
		1774 -> 1777;
	1775 [label="Mais ça ? To ? To miejsce, słowa diabła, niepewność spowodowana przez le Cardinal... sprawiło mu to wiele bólu i modlę się, aby sobie z tym poradził.",shape=box,color=blue];
		1775 -> 1778;
		1775 -> 1779;
	1776 [label="Więc... pozostało nam chyba tylko czekać, non ?",shape=box,color=blue];
		1776 -> 1780;
	1777 [label="Mnie też nie słucha, dlatego przyszłam pomówić z tobą. Zawsze udawało mi się go uspokoić -",shape=box,color=blue];
		1777 -> 1781;
	1778 [label="Więc przyznajesz, że Entrati skrzywdził Leona? Jak się z tym czujesz?",shape=box,color=red];
		1778 -> 1782;
	1779 [label="Czuję, jakby balansował na krawędzi. Jak mogę mu pomóc?",shape=box,color=red];
		1779 -> 1783;
	1780 [label="Merci. Przepraszam, że zmarnowałam twój czas.",shape=box,color=blue];
		1780 -> 1784;
	1781 [label="Jestem zaskoczona jego wściekłością, jego désespoir... unika mojego towarzystwa jak nigdy wcześniej.",shape=box,color=blue];
		1781 -> 1785;
	1782 [label="Pas bien... Jak mam wybierać między miłością do mojego brata i uwielbieniem le Cardinal ? Jak mam wybierać między moją familie ?",shape=box,color=blue];
		1782 -> 1786;
		1782 -> 1787;
		1782 -> 1788;
		1782 -> 3961;
	1783 [label="Nie wiem, dlatego przyszłam pomówić z tobą. Zawsze udawało mi się go uspokoić - ",shape=box,color=blue];
		1783 -> 1781;
	1784 [label="Chat ends.",color=orange];
	1785 [label="Co go tak trapi ? Czy znasz może przyczynę ?",shape=box,color=blue];
		1785 -> 1789;
	1786 [label="Nie musisz wybierać. To, w jaki sposób inni są częścią naszego życia, potrafi być skomplikowane.",shape=box,color=red];
		1786 -> 1790;
	1787 [label="Wybrałbym rodzinę, która nadal przy tobie jest. Nie tę, która cię porzuciła.",shape=box,color=red];
		1787 -> 1791;
	1788 [label="Jestem pewien, że Entrati nie chciał sprawić Leonowi takiego bólu.",shape=box,color=red];
		1788 -> 1792;
	3961 [label="Możesz wybrać nową rodzinę. Jak mnie. I wszyscy wokół, którym na tobie zależy, bez Entratiego.",shape=box,color=red];
		3961 -> 3962;
	1789 [label="Evaluate expressions",color=orange];
		1789 -> 1793 [label="DrifterFaithNoMITW",color=purple];
