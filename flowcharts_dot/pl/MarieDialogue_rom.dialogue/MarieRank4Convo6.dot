		j24793232 -> j2936586758;
	j2118415752 [label="Nie sądzę, żeby przyczyna była tylko jedna. Myślę, że Leon jest nękany przez wiele demonów.",shape=box,color=red];
		j2118415752 -> j1631001131;
	j1575510078 [label="Leon słyszał głosy jednego z Tenno, dzieciaka o imieniu Rell. On... umarł. Leon nie znosi tego dobrze.",shape=box,color=red];
		j1575510078 -> j807341451;
	j1056634959 [label="Roathe wmawia mu kłamstwa o Panu ze Ściany.",shape=box,color=red];
		j1056634959 -> j2296098192;
	j511631715 [label="Nie uważam, żeby wmówienie mu przez Entratiego, że te głosy pochodzą z Pustki, było pomocne.",shape=box,color=red];
		j511631715 -> j3351106715;
	j2071680617 [label="Nie mam pojęcia.",shape=box,color=red];
		j2071680617 -> j3540019398;
	j753361948 [label="Nie mieszajmy już le Cardinal do tej rozmowy, dobrze ? Martwię się o brata mojej duszy. Ale... wiem, co próbujesz powiedzieć... i z każdą chwilą ta prawda staje się bardziej wyrazista.",shape=box,color=blue];
		j753361948 -> j725807604;
	j1438110784 [label="Nie myśl, że nie zauważyłam, jak w pierwszej kolei wymieniasz siebie, wilku.",shape=box,color=blue];
		j1438110784 -> j753361948;
	j2936586758 [label="A ty ani trochę mu w tym nie pomagasz, mówiąc do niego w taki sposób. Nawet jeśli słowa niosą prawdę, musisz uważać, jak je wypowiadasz.",shape=box,color=blue];
		j2936586758 -> j864142782;
	j1631001131 [label="Oui, przez tak długi czas chronił nas przed burzą... A teraz on sam potrzebuje schronienia.",shape=box,color=blue];
		j1631001131 -> j1095128125;
	j807341451 [label="Słyszałem, jak wymawiał to imię, Rell, i serce mi pęka na wieść o losie tego chłopca.",shape=box,color=blue];
		j807341451 -> j4186622482;
	j2296098192 [label="Diabeł sprawił wiele kłopotu tak wielu na swojej drodze ! Ale on nie może być jedynym źródłem problemu, non ?",shape=box,color=blue];
		j2296098192 -> j2889353970;
	j3351106715 [label="S'il te plaît, nie mów mi więcej o le Cardinal. Nie zaprzeczę, że jego słowa pogorszyły stan Leona, ale to nie może być jedyny powód.",shape=box,color=blue];
		j3351106715 -> j1157573555;
	j3540019398 [label="Chyba jedyne, co możemy zrobić... to być cierpliwym i mieć nadzieję, że odkryjemy źródło jego problemu.",shape=box,color=blue];
		j3540019398 -> j2073815122;
	j725807604 [label="Boolean MarieEntrati4a is now true.",color=orange];
		j725807604 -> j646924102;
	j864142782 [label="Chirurg nie włada toporem. To nie jest brytyjska marynarka.",shape=box,color=blue];
		j864142782 -> j4052801285;
	j1095128125 [label="Rozdzierany na wszystkie strony, nie wiedzący, w którą stronę iść...",shape=box,color=blue];
		j1095128125 -> j481516111;
		j1095128125 -> j510689538;
	j4186622482 [label="Ale nie sądzę, że to jedyna przyczyna jego cierpienia ? Leon kroczy drogą Lua. La mort est une compagne qui marche à ses côtés.",shape=box,color=blue];
		j4186622482 -> j4052801285;
	j2889353970 [label="To pomogło załagodzić jego niepewności... Ale żeby przywiązywać aż taką wagę do słów diabła? Mój Leon wie lepiej. Myślę, że wiele rzeczy go teraz przytłacza.",shape=box,color=blue];
