		j1531216646 -> j386906797 [label=false,color=brown];
	j319793408 [label="Jest dorosły. Sam zdecyduje, kiedy ma ochotę na rozmowę.",shape=box,color=red];
		j319793408 -> j3896814164;
	j4163107739 [label="Serce mi pęka na widok tego, jak przeżywa swój ból. Nie wiem, jak mu pomóc.",shape=box,color=red];
