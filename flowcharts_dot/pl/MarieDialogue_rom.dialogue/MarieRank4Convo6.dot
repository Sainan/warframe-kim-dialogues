		j831682760 -> j3610863223;
	j301121866 [label="+5 Chemistry",color=orange];
		j301121866 -> j191981440;
	j191981440 [label="Oui, chyba masz rację. Musimy być tymi, do których będzie mógł się zwrócić, gdy wszystko inne zawiedzie.",shape=box,color=blue];
		j191981440 -> j702505808;
