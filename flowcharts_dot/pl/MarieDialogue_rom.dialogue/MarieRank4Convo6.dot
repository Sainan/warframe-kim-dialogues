		1789 -> 1795 [label="LyonRell1",color=purple];
		1789 -> 1796 [label="false",color=purple];
	1790 [label="To jest problem z ludźmi takimi jak Entrati. Nie są siłami samego \"dobra\" albo \"zła\". Są mieszanką.",shape=box,color=red];
		1790 -> 1799;
	1791 [label="Nie mieszajmy już le Cardinal do tej rozmowy, dobrze ? Martwię się o brata mojej duszy.",shape=box,color=blue];
		1791 -> 1781;
	1792 [label="Też nie sądzę, żeby taki był jego cel, ale fakt pozostaje niezmieniony, oui ? Doceniam twoje chęci. Cela dit...",shape=box,color=blue];
		1792 -> 1791;
	3962 [label="Update boolean DrifterMarie",color=orange];
		3962 -> 3963;
	1793 [label="Leon próbuje pogodzić się z faktem, że Obojętność nie jest prawdziwym bogiem.",shape=box,color=red];
		1793 -> 1800;
	1795 [label="Nie sądzę, żeby przyczyna była tylko jedna. Myślę, że Leon jest nękany przez wiele demonów.",shape=box,color=red];
		1795 -> 1802;
	1797 [label="Leon słyszał głosy jednego z Tenno, dzieciaka o imieniu Rell. On... umarł. Leon nie znosi tego dobrze.",shape=box,color=red];
		1797 -> 1804;
	1798 [label="Roathe wmawia mu kłamstwa o Panu ze Ściany.",shape=box,color=red];
		1798 -> 1805;
	1794 [label="Nie uważam, żeby wmówienie mu przez Entratiego, że te głosy pochodzą z Pustki, było pomocne.",shape=box,color=red];
		1794 -> 1801;
	1796 [label="Nie mam pojęcia.",shape=box,color=red];
		1796 -> 1803;
	1799 [label="Nie mieszajmy już le Cardinal do tej rozmowy, dobrze ? Martwię się o brata mojej duszy. Ale... wiem, co próbujesz powiedzieć... i z każdą chwilą ta prawda staje się bardziej wyrazista.",shape=box,color=blue];
		1799 -> 1806;
	3963 [label="Nie myśl, że nie zauważyłam, jak w pierwszej kolei wymieniasz siebie, wilku.",shape=box,color=blue];
		3963 -> 1799;
	1800 [label="A ty ani trochę mu w tym nie pomagasz, mówiąc do niego w taki sposób. Nawet jeśli słowa niosą prawdę, musisz uważać, jak je wypowiadasz.",shape=box,color=blue];
		1800 -> 1807;
	1802 [label="Oui, przez tak długi czas chronił nas przed burzą... A teraz on sam potrzebuje schronienia.",shape=box,color=blue];
		1802 -> 1809;
	1804 [label="Słyszałem, jak wymawiał to imię, Rell, i serce mi pęka na wieść o losie tego chłopca.",shape=box,color=blue];
		1804 -> 1811;
	1805 [label="Diabeł sprawił wiele kłopotu tak wielu na swojej drodze ! Ale on nie może być jedynym źródłem problemu, non ?",shape=box,color=blue];
		1805 -> 1812;
	1801 [label="S'il te plaît, nie mów mi więcej o le Cardinal. Nie zaprzeczę, że jego słowa pogorszyły stan Leona, ale to nie może być jedyny powód.",shape=box,color=blue];
		1801 -> 1808;
	1803 [label="Chyba jedyne, co możemy zrobić... to być cierpliwym i mieć nadzieję, że odkryjemy źródło jego problemu.",shape=box,color=blue];
		1803 -> 1810;
	1806 [label="Update boolean MarieEntrati4a",color=orange];
		1806 -> 1781;
	1807 [label="Chirurg nie włada toporem. To nie jest brytyjska marynarka.",shape=box,color=blue];
		1807 -> 1813;
	1809 [label="Rozdzierany na wszystkie strony, nie wiedzący, w którą stronę iść...",shape=box,color=blue];
		1809 -> 1815;
		1809 -> 1816;
	1811 [label="Ale nie sądzę, że to jedyna przyczyna jego cierpienia ? Leon kroczy drogą Lua. La mort est une compagne qui marche à ses côtés.",shape=box,color=blue];
		1811 -> 1813;
	1812 [label="To pomogło załagodzić jego niepewności... Ale żeby przywiązywać aż taką wagę do słów diabła? Mój Leon wie lepiej. Myślę, że wiele rzeczy go teraz przytłacza.",shape=box,color=blue];
		1812 -> 1818;
		1812 -> 1819;
	1808 [label="Update boolean MarieEntrati4b",color=orange];
		1808 -> 1814;
	1810 [label="+15 Chemistry",color=orange];
		1810 -> 1817;
	1813 [label="Non, myślę, że wiele rzeczy go teraz przytłacza.",shape=box,color=blue];
		1813 -> 1818;
		1813 -> 1819;
	1815 [label="Więc musimy być dla niego ostoją. Miejscem, w którym nic go nie zrani.",shape=box,color=red];
		1815 -> 1820;
	1816 [label="Musimy mu więc pokazać drogę do bezpieczeństwa. Być światłem pośród mroku.",shape=box,color=red];
		1816 -> 1821;
	1818 [label="Więc... chyba musimy mu więc pokazać drogę do bezpieczeństwa. Być światłem pośród mroku.",shape=box,color=red];
		1818 -> 1821;
	1819 [label="Więc... chyba musimy być dla niego ostoją. Miejscem, w którym nic go nie zrani.",shape=box,color=red];
		1819 -> 1823;
	1814 [label="Nie przywiązał tak wielkiej wagi do słów le Cardinal, by zaprowadziły go w taki mrok. Myślę, że wiele rzeczy go teraz przytłacza.",shape=box,color=blue];
		1814 -> 1819;
		1814 -> 1818;
	1817 [label="Merci. Wiem, że starasz się, jak możesz. I za to jestem wdzięczna.",shape=box,color=blue];
		1817 -> 1822;
	1820 [label="+10 Chemistry",color=orange];
		1820 -> 1824;
	1821 [label="Jak pomóc komuś, kto nie słyszy twojego wołania, nie widzi twojego światła? Non, Lua spowiła go tą ciemnością.",shape=box,color=blue];
		1821 -> 1825;
	1823 [label="+5 Chemistry",color=orange];
		1823 -> 1824;
	1822 [label="Chat ends.",color=orange];
	1824 [label="Oui, chyba masz rację. Musimy być tymi, do których będzie mógł się zwrócić, gdy wszystko inne zawiedzie.",shape=box,color=blue];
		1824 -> 1826;
	1825 [label="Nie sądzę, żeby nawet światło Sol mogło do niego dotrzeć.",shape=box,color=blue];
		1825 -> 1826;
	1826 [label="Jeśli jego wiara jest słaba, musimy być silni za niego. ",shape=box,color=blue];
		1826 -> 1827;
	1827 [label="Jeśli wszystkie te niewidziane głosy zwróciły się z miłych fantômes w démons cieni, które go nękają -",shape=box,color=blue];
		1827 -> 1828;
	1828 [label="My musimy być jeszcze bardziej rzeczywiści, non ?",shape=box,color=blue];
		1828 -> 1829;
		1828 -> 1830;
	1829 [label="Nie przestanę próbować.",shape=box,color=red];
		1829 -> 1831;
	1830 [label="Mam nadzieję, że go to bardziej nie rozbije.",shape=box,color=red];
		1830 -> 1832;
	1831 [label="+10 Chemistry",color=orange];
		1831 -> 1833;
	1832 [label="+5 Chemistry",color=orange];
		1832 -> 1834;
	1833 [label="To wszystko, co możemy zrobić.",shape=box,color=blue];
		1833 -> 1835;
	1834 [label="Oui... ja także. Ale jedyne co możemy zrobić, to pozostać u jego boku i się modlić, non ?",shape=box,color=blue];
		1834 -> 1836;
	1835 [label="Próbuj. I módl się.",shape=box,color=blue];
		1835 -> 1837;
	1836 [label="I mam nadzieję, że nie jest za późno.",shape=box,color=blue];
		1836 -> 1837;
	1837 [label="Merci... muszę już iść. Przepraszam, jeśli ta rozmowa nie była zbyt pomocna. Obawiam się, że więcej nie zdziałam.",shape=box,color=blue];
		1837 -> 1838;
		1837 -> 1839;
	1838 [label="Czuję się tak samo, ale czasem działanie to zły wybór.",shape=box,color=red];
		1838 -> 1840;
	1839 [label="Wyjdzie z tego, jestem pewien.",shape=box,color=red];
		1839 -> 1840;
	1840 [label="Modlę się, żebyś miał rację. Nie wiem, jak sobie bez niego poradzimy.",shape=box,color=blue];
		1840 -> 1841;
	1841 [label="Chat ends.",color=orange];
