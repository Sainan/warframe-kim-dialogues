		j1588359763 -> j646924102;
	j3172597345 [label="Co go tak trapi ? Czy znasz może przyczynę ?",shape=box,color=blue];
		j3172597345 -> j2411453274;
	j2904126493 [label="Nie musisz wybierać. To, w jaki sposób inni są częścią naszego życia, potrafi być skomplikowane.",shape=box,color=red];
		j2904126493 -> j1587307022;
	j3431597169 [label="Wybrałbym rodzinę, która nadal przy tobie jest. Nie tę, która cię porzuciła.",shape=box,color=red];
		j3431597169 -> j3595738305;
	j3207916966 [label="Jestem pewien, że Entrati nie chciał sprawić Leonowi takiego bólu.",shape=box,color=red];
		j3207916966 -> j692912219;
	j765451273 [label="Możesz wybrać nową rodzinę. Jak mnie. I wszyscy wokół, którym na tobie zależy, bez Entratiego.",shape=box,color=red];
