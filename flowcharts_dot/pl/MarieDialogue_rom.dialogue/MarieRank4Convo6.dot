		j3855764988 -> j301121866;
	j1115896848 [label="Nie przywiązał tak wielkiej wagi do słów le Cardinal, by zaprowadziły go w taki mrok. Myślę, że wiele rzeczy go teraz przytłacza.",shape=box,color=blue];
		j1115896848 -> j3855764988;
		j1115896848 -> j1529832077;
	j1439981983 [label="Merci. Wiem, że starasz się, jak możesz. I za to jestem wdzięczna.",shape=box,color=blue];
