	"MarieRank2Convo5 begins." [color=orange];
		"MarieRank2Convo5 begins." -> j1631090094;
	j1631090094 [label="Evaluate expressions",color=orange];
		j1631090094 -> j1095751419 [label="MarieOtak1",color=purple];
		j1631090094 -> j2197320644 [label="MarieFamily1",color=purple];
		j1631090094 -> j1421201713 [label="false",color=purple];
	j1095751419 [label="Myślałam o tym, co powiedziałeś o Monsieur Otaku.",shape=box,color=blue];
		j1095751419 -> j2470825441;
	j2197320644 [label="Zastanawiałam się nad tym, co powiedziałeś o rodzinie le Cardinal.",shape=box,color=blue];
		j2197320644 -> j2779506105;
	j1421201713 [label="Znów chciałabym zapytać o Monsieur \"Nekraloida\", jeśli mogę ?",shape=box,color=blue];
		j1421201713 -> j3996924533;
		j1421201713 -> j386906797;
	j2470825441 [label="Zastanawiałam się, czy ich historia nie jest podobna do mojej. Czy mogłabym Ci ją opowiedzieć, jeśli masz czas ?",shape=box,color=blue];
		j2470825441 -> j3505262511;
		j2470825441 -> j386906797;
	j2779506105 [label="Zastanawiałam się, czy zechcesz mi opowiedzieć historię Otaka, tej namalowanej twarzy u tyłu głowy Nekraloida ?",shape=box,color=blue];
		j2779506105 -> j1329657981;
		j2779506105 -> j1759191650;
	j3996924533 [label="Jasne, o co chodzi?",shape=box,color=red];
		j3996924533 -> j1850959847;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j3505262511 [label="Proszę bardzo.",shape=box,color=red];
		j3505262511 -> j4127674470;
	j1329657981 [label="Pewnie.",shape=box,color=red];
		j1329657981 -> j538312269;
	j1759191650 [label="Może innym razem. [Koniec]",shape=box,color=red];
		j1759191650 -> "Chat ends.";
	j1850959847 [label="Zastanawiam się, dlaczego na jego plecach znajduje się druga twarz, narysowana jak przez dziecko.",shape=box,color=blue];
		j1850959847 -> j3279594103;
	"Chat ends." [color=orange];
	j4127674470 [label="W le Cathédrale żyła Siostra, która kiedyś zatraciła się w korytarzach swojej przeszłości. Siostra Cécilia.",shape=box,color=blue];
		j4127674470 -> j376420100;
	j538312269 [label="Wszyscy uważali go za geniusza, za umysł, który zdołał wykorzystać kryształy argonowe.",shape=box,color=red];
		j538312269 -> j141753894;
	j3279594103 [label="Zapytałam Monsieur Nekraloida i Monsieur Loida, ale żaden z nich nie chciał o tym rozmawiać. Podzielili się tylko imieniem. Otak. Wypowiedzieli je z wielkim smutkiem.",shape=box,color=blue];
		j3279594103 -> j2046314806;
	j376420100 [label="Stawała przed wielkim zegarem w głównym holu i ogłaszała, że wybiła godzina czternasta, ale nie miała pojęcia, jaka rzeczywiście była pora.",shape=box,color=blue];
		j376420100 -> j1888595915;
	j141753894 [label="Które pozyskiwał z Pustki, to dzięki nim byliśmy w stanie stworzyć wiele potężnych Warframe’ów i broni.",shape=box,color=red];
		j141753894 -> j3897617075;
	j2046314806 [label="I tak oto trafiłam na Ciebie, z nadzieją, że zdołasz mi pomóc.",shape=box,color=blue];
		j2046314806 -> j2807557164;
		j2046314806 -> j3450959311;
	j1888595915 [label="Wszystkie obrazy w korytarzach byłyby zwrócone w złą stronę, a ona mówiła, że szepczą jej o strasznych intrygach.",shape=box,color=blue];
		j1888595915 -> j3641341550;
	j3897617075 [label="Jego specjalizacją była krystalografia. A jego prace odbywały się tutaj, w tych laboratoriach.",shape=box,color=red];
		j3897617075 -> j271710836;
	j2807557164 [label="Chcesz poznać prawdę o Otaku? Albo dlaczego nie możesz z nim rozmawiać?",shape=box,color=red];
		j2807557164 -> j1058971865;
	j3450959311 [label="Otak jest skomplikowany...",shape=box,color=red];
		j3450959311 -> j2100059297;
	j3641341550 [label="Zrozumieliśmy, że słyszała rozmowy za ścianami, ale była przekonana, że przemawiają do niej obrazy...",shape=box,color=blue];
		j3641341550 -> j563879979;
	j271710836 [label="Z nieznanego mi powodu został przemieniony w Cefalona i otrzymał nekraloidową powłokę.",shape=box,color=red];
		j271710836 -> j716749284;
	j1058971865 [label="Myślę, że chciałabym poznać obie prawdy, ale pozwolę Ci zadecydować, od której zaczniesz. Nie wiem, która z nich jest ważniejsza, après tout.",shape=box,color=blue];
		j1058971865 -> j2100059297;
	j2100059297 [label="Check boolean LoidFamilyComplete",color=orange];
		j2100059297 -> j1313454022 [label=true,color=green];
		j2100059297 -> j1313454022 [label=false,color=brown];
		j2100059297 -> j2979415869 [label=false,color=brown];
	j563879979 [label="Pewnego razu uznała wszystkie poduszki w salonie za dzieci i zaprosiła je na herbatę...",shape=box,color=blue];
		j563879979 -> j2710313118;
	j716749284 [label="Nie wszystkie Cefalony powstały za karę. Ale sprawy na Deimosie... nie szły dobrze, a on został poważnie uszkodzony.",shape=box,color=red];
		j716749284 -> j2113735717;
	j1313454022 [label="Otak był kiedyś Archimedianem, uczonym Orokin. Nie spotkał go najszczęśliwszy los.",shape=box,color=red];
		j1313454022 -> j2288182299;
	j2979415869 [label="No cóż... krótko mówiąc, część rodziny Entrati jest piętro wyżej i... nie zdają sobie sprawy, że my jesteśmy tu na dole.",shape=box,color=red];
		j2979415869 -> j3551217165;
	j2710313118 [label="Kiedy weszłam do pokoju, spojrzała na mnie i powiedziała \"Och, Siostro Odette, w końcu przybyłaś ! Dzieci z sierocińca czekały na ciebie, dołączysz do nas ?\"",shape=box,color=blue];
		j2710313118 -> j2523934129;
		j2710313118 -> j3671791214;
	j2113735717 [label="+5 Chemistry",color=orange];
		j2113735717 -> j1175146433;
	j2288182299 [label="Boolean MarieOtak1 is now true.",color=orange];
		j2288182299 -> j4234047860;
	j3551217165 [label="Boolean MarieFamily1 is now true.",color=orange];
		j3551217165 -> j192220257;
	j2523934129 [label="I co zrobiłaś?",shape=box,color=red];
		j2523934129 -> j4161199447;
	j3671791214 [label="Kim była Siostra Odette?",shape=box,color=red];
		j3671791214 -> j1384359948;
	j1175146433 [label="Pauvre petit...",shape=box,color=blue];
		j1175146433 -> j3638852112;
	j4234047860 [label="Par les Luminaires... powiedz mi więcej.",shape=box,color=blue];
		j4234047860 -> j538312269;
	j192220257 [label="Par les Luminaires... Mówisz, że wszyscy jesteśmy tu w tajemnicy ?! To dlatego nie możemy opuścić tego miejsca ?! Mais pourquoi ?!",shape=box,color=blue];
		j192220257 -> j394264794;
	j4161199447 [label="Zajęłam wolne miejsce przy stole i sączyłam herbatę w towarzystwie jej i poduszek, co więcej mogłam zrobić ?",shape=box,color=blue];
		j4161199447 -> j3531213316;
	j1384359948 [label="Przykro mi to mówić, ale Siostra Odette opuściła nas trzydzieści lat temu.",shape=box,color=blue];
		j1384359948 -> j3877428501;
	j3638852112 [label="Więc, stał się głównym nekraloidem - jedynym Nekraloidem, który pozostał - i... ma się dobrze? Ciężko to wyjaśnić.",shape=box,color=red];
		j3638852112 -> j3388275151;
		j3638852112 -> j3197750484;
		j3638852112 -> j4022950416;
	j394264794 [label="Jego córka, Euleria - znana jako Matka, i jej rodzina, przez cały ten czas zajmowali się Deimosem.",shape=box,color=red];
		j394264794 -> j4018320214;
	j3531213316 [label="Śmiałyśmy się, kiedy opowiadała o swoich przeżyciach z przeszłości. Opowieści, których Siostra Cécilia z nikim innym nie podzieliła.",shape=box,color=blue];
		j3531213316 -> j189959800;
	j3877428501 [label="Zajęłam wolne miejsce przy stole i sączyłam herbatę w towarzystwie jej i poduszek.",shape=box,color=blue];
		j3877428501 -> j3531213316;
	j3388275151 [label="Właściwie chciałbym, żebyśmy byli w stanie go naprawić. Przywrócić prawdziwego Otaka.",shape=box,color=red];
		j3388275151 -> j4127674470;
	j3197750484 [label="Potrafi rozbawić mnie do łez, ale kryje za tym coś tragicznego.",shape=box,color=red];
		j3197750484 -> j4127674470;
	j4022950416 [label="Niestety, nie można go naprawić i myślę, że wielu działa to na nerwy. ",shape=box,color=red];
		j4022950416 -> j4127674470;
	j4018320214 [label="Strzegą tego miejsca i serca, które pompuje energię Pustki w Systemie Origin, pozwalając nam... działać, od kiedy Entrati odszedł.",shape=box,color=red];
		j4018320214 -> j3382079857;
	j189959800 [label="W jednych chwilach jej oczy mieniły się żarem, a w innych były puste niczym oczy lalki...",shape=box,color=blue];
		j189959800 -> j34694980;
		j189959800 -> j2226121989;
		j189959800 -> j4253559691;
		j189959800 -> j497997952;
	j3382079857 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3382079857 -> j1092067792 [label=true,color=green];
		j3382079857 -> j1980571544 [label=false,color=brown];
	j34694980 [label="Dlaczego do niej dołączyłaś?",shape=box,color=red];
		j34694980 -> j2638875494;
	j2226121989 [label="Co stało się z Siostrą Cécilią?",shape=box,color=red];
		j2226121989 -> j2739346263;
	j4253559691 [label="Mam nadzieję, że doceniła Twoją obecność.",shape=box,color=red];
		j4253559691 -> j1230948188;
	j497997952 [label="To miłe, że do niej dołączyłaś.",shape=box,color=red];
		j497997952 -> j3416516688;
	j1092067792 [label="Pogodziła się z jego nieobecnością i nawzajem sobie przebaczyli, ale nie przyszło im to łatwo.",shape=box,color=red];
		j1092067792 -> j3795572006;
	j1980571544 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j1980571544 -> j1092067792 [label=true,color=green];
		j1980571544 -> j2500993303 [label=false,color=brown];
	j2638875494 [label="+15 Chemistry",color=orange];
		j2638875494 -> j2466498222;
	j2739346263 [label="Spotkał ją ten sam los, co wszystkich w jej stanie. Zanikała, niczym obraz wystawiony na słońce, aż pozostało jedynie wyblakłe płótno. ",shape=box,color=blue];
		j2739346263 -> j2842287519;
	j1230948188 [label="+10 Chemistry",color=orange];
		j1230948188 -> j3677351143;
	j3416516688 [label="+5 Chemistry",color=orange];
		j3416516688 -> j2617617721;
	j3795572006 [label="Wiedząc, że on wciąż gdzieś tam jest, robiąc bałagan, i nie odezwał się do nim ani słowem, ani nawet listem...?",shape=box,color=red];
		j3795572006 -> j615034289;
	j2500993303 [label="Nie pogodziła się z jego odejściem i nadal rzucają się sobie do gardeł.",shape=box,color=red];
		j2500993303 -> j2695703765;
	j2466498222 [label="Dobre pytanie. Bardzo dobre pytanie. Miałam ku temu wiele powodów. Chciałabym myśleć, że to życzliwość mnie pokierowała.",shape=box,color=blue];
		j2466498222 -> j3167792103;
	j2842287519 [label="Potem odeszła, a my zorganizowaliśmy une veillée mortuaire w jej imieniu. Mam nadzieję, że w swoich ostatnich chwilach zapamiętała tych, którzy byli wobec niej tak dobrzy. ",shape=box,color=blue];
		j2842287519 -> j681961322;
	j3677351143 [label="Chciałabym wierzyć, że gdzieś w głębi to zrozumiała.",shape=box,color=blue];
		j3677351143 -> j681961322;
	j2617617721 [label="Czy na pewno była to życzliwość ? Czy mogło być to może poczucie winy ? Ach, sam zadajesz to pytanie tylko z grzeczności. ",shape=box,color=blue];
		j2617617721 -> j681961322;
	j615034289 [label="Nie mogę sobie wyobrazić, jak bolesne musiało to być dla niej. Dla nich wszystkich.",shape=box,color=red];
		j615034289 -> j1082529789;
	j2695703765 [label="Wiedząc, że on wciąż gdzieś tam jest, robiąc bałagan, i nie odezwał się do nim ani słowem, ani nawet listem...?",shape=box,color=red];
		j2695703765 -> j4006255688;
	j3167792103 [label="Myślę, mogło być to poczucie winy. Że jeśli bym tego nie zrobiła, zaniedbałabym ją, tak jak można zaniedbać dziecko.",shape=box,color=blue];
		j3167792103 -> j681961322;
	j681961322 [label="Chciałabym wierzyć, że Otak wie, kto jest wobec niego życzliwy i cierpliwy. Ale z drugiej strony, tak naprawdę go tam nie ma, prawda ?",shape=box,color=blue];
		j681961322 -> j363564416;
	j1082529789 [label="Rozumiem logikę za decyzjami le Cardinal i chęć ochrony ich przed bólem, który sprawił swoim nieuniknionym odejściem...",shape=box,color=blue];
		j1082529789 -> j475147220;
	j4006255688 [label="Zrujnowałoby to i tak nikłe szanse na pogodzenie się.",shape=box,color=red];
		j4006255688 -> j351308513;
	j363564416 [label="Rozmawiam z niezwykle skomplikowaną technologią, która udaje człowieka, czyż nie ? Niczym le phonographe, ale wielokroć bardziej skomplikowany. Tak jak Nekraloid, nie ma on duszy.",shape=box,color=blue];
		j363564416 -> j3454573989;
		j363564416 -> j498897113;
		j363564416 -> j2680556662;
		j363564416 -> j1267639221;
		j363564416 -> j81710538;
	j475147220 [label="Uważam to za zbędne okrucieństwo, a ty ? Mogą myśleć, że umarł, albo coś gorszego ! A my, żyjemy tutaj, comme des rats d'égout ?",shape=box,color=blue];
		j475147220 -> j3612212817;
		j475147220 -> j2295534238;
	j351308513 [label="+10 Chemistry",color=orange];
		j351308513 -> j2196043490;
	j3454573989 [label="Nekraloid może nie mieć duszy, ale jest wyjątkowy. Inne Cefalony, jak Otak, mają. Ich stworzenie wymagało zniszczenia ich.",shape=box,color=red];
		j3454573989 -> j4219887526;
	j498897113 [label="Masz rację. Więc co powinienem z tym zrobić?",shape=box,color=red];
		j498897113 -> j3580296289;
	j2680556662 [label="Masz rację. Nie mają, ale to nie daje nam przyzwolenia, by traktować ich gorzej.",shape=box,color=red];
		j2680556662 -> j1791119024;
	j1267639221 [label="Nie wiem, czy masz rację, ale oni nadal myślą i czują. Nie możemy traktować ich jak rzeczy.",shape=box,color=red];
		j1267639221 -> j685485220;
	j81710538 [label="Nekraloid ma duszę, tak jak wszystkie Cefalony.",shape=box,color=red];
		j81710538 -> j4127233285;
	j3612212817 [label="To nie jest moja decyzja.",shape=box,color=red];
		j3612212817 -> j3164756417;
	j2295534238 [label="Mam przyjaciółkę, która uwielbia szczury. Myślę, że są urocze.",shape=box,color=red];
		j2295534238 -> j1042119094;
	j2196043490 [label="Oui... Rozumiem to. Postarałabym się pogodzić ich rodzinę, jeśli jesteś w stanie, non ? To chyba nasza jedyna nadzieją, by kiedykolwiek się stąd uwolnić. ",shape=box,color=blue];
		j2196043490 -> j452058509;
	j4219887526 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j4219887526 -> j2525258095;
	j3580296289 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j3580296289 -> j3055305814;
	j1791119024 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j1791119024 -> j609032736;
	j685485220 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
		j685485220 -> j1757265114;
	j4127233285 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j4127233285 -> j3927379927;
	j3164756417 [label="Wiem. To decyzja Monsieur Loida i wszystkich innych, by zdecydowali się ujawnić.",shape=box,color=blue];
		j3164756417 -> j3452380112;
	j1042119094 [label="+15 Chemistry",color=orange];
		j1042119094 -> j386775031;
	j452058509 [label="Żebyśmy nie spędzili tutaj reszty naszego żywota, uwięzieni comme des rats d'égout. ",shape=box,color=blue];
		j452058509 -> j1758007552;
		j452058509 -> j3210919528;
	j2525258095 [label="+5 Chemistry",color=orange];
		j2525258095 -> j4136402232;
	j3055305814 [label="Och, nie myśl, że chcę, żebyś był okrutny ! Nie ! Szanuj ich, bo są cenni i nie mieli udziału w tym, że stali się tacy, jacy są!",shape=box,color=blue];
		j3055305814 -> j1359962916;
	j609032736 [label="+5 Chemistry",color=orange];
		j609032736 -> j3055305814;
	j1757265114 [label="+5 Chemistry",color=orange];
		j1757265114 -> j1642296811;
	j3927379927 [label="+5 Chemistry",color=orange];
		j3927379927 -> j3644789839;
	j3452380112 [label="Pragnę zasugerować, że tu na dole zatrzymuje nas nie szlachetność, a poczucie winy.",shape=box,color=blue];
		j3452380112 -> j1446637793;
	j386775031 [label="I chciałabym kiedyś ich poznać, ale nie o tym mówię, głupi wilczku.",shape=box,color=blue];
		j386775031 -> j3452380112;
	j1758007552 [label="Zapomniałem się. Masz rację, muszę wracać do pracy.",shape=box,color=red];
		j1758007552 -> j773548714;
	j3210919528 [label="Mam przyjaciółkę, która uwielbia szczury. Myślę, że są urocze. ",shape=box,color=red];
		j3210919528 -> j2977125557;
	j4136402232 [label="Kolejny dowód na to, że diabeł i jemu podobni słusznie zostali potępieni. Ale możesz mieć rację co do Otaka i jemu podobnych, a może ta wiara pozwala Ci zaznać spokoju.",shape=box,color=blue];
		j4136402232 -> j3244780168;
	j1359962916 [label="Moje serce pęka na myśl o zniszczonych ciałach, które Orokin pozostawili po sobie. Nie byli bogami, ale głodnymi potworami. Wystarczy spojrzeć tylko na mojego towarzysza podróży.",shape=box,color=blue];
		j1359962916 -> j2160997638;
	j1642296811 [label="Możliwe, że masz rację, ale nie sądzę, żeby diabły Orokin wiedziały więcej o działaniu duszy niż my. Nie byli bogami.",shape=box,color=blue];
		j1642296811 -> j2165640872;
	j3644789839 [label="Możesz mieć rację, a może ta wiara daje Ci spokój.",shape=box,color=blue];
		j3644789839 -> j2160997638;
	j1446637793 [label="Że chowamy jakiś głęboki grzech.",shape=box,color=blue];
		j1446637793 -> j787682687;
	j773548714 [label="+5 Chemistry",color=orange];
		j773548714 -> j1271560208;
	j2977125557 [label="+5 Chemistry",color=orange];
		j2977125557 -> j386775031;
	j3244780168 [label="W każdym razie, wolę wierzyć, że Otak, który odszedł dawno temu, uśmiechnąłby się na myśl, że jesteś tak życzliwy wobec tego, co z niego zostało.",shape=box,color=blue];
		j3244780168 -> j1531393501;
	j2160997638 [label="Ciężko jest mi stwierdzić, że Nekraloid ma duszę, kiedy Loid stoi obok niego, oui ?",shape=box,color=blue];
		j2160997638 -> j3244780168;
	j2165640872 [label="Technologia, a może nawet nauka - owszem, ale dusza ? Ledwie byli w stanie zapanować nad swoimi sercami ! Wystarczy tylko spojrzeć na diabła, z którym podróżuję.",shape=box,color=blue];
		j2165640872 -> j2160997638;
	j787682687 [label="I to ten grzech musi zostać przebaczony.",shape=box,color=blue];
		j787682687 -> j2990919557;
