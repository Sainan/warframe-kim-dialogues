digraph {
	735 [label="MarieRank2Convo5 begins.",color=orange];
		735 -> 736;
	736 [label="Evaluate expressions",color=orange];
		736 -> 739 [label="MarieOtak1",color=purple];
		736 -> 738 [label="MarieFamily1",color=purple];
		736 -> 737 [label="false",color=purple];
	739 [label="Myślałam o tym, co powiedziałeś o Monsieur Otaku.",shape=box,color=blue];
		739 -> 743;
	738 [label="Zastanawiałam się nad tym, co powiedziałeś o rodzinie le Cardinal.",shape=box,color=blue];
		738 -> 742;
	737 [label="Znów chciałabym zapytać o Monsieur \"Nekraloida\", jeśli mogę ?",shape=box,color=blue];
		737 -> 741;
		737 -> 740;
	743 [label="Zastanawiałam się, czy ich historia nie jest podobna do mojej. Czy mogłabym Ci ją opowiedzieć, jeśli masz czas ?",shape=box,color=blue];
		743 -> 749;
		743 -> 748;
	742 [label="Zastanawiałam się, czy zechcesz mi opowiedzieć historię Otaka, tej namalowanej twarzy u tyłu głowy Nekraloida ?",shape=box,color=blue];
		742 -> 747;
		742 -> 746;
	741 [label="Jasne, o co chodzi?",shape=box,color=red];
		741 -> 745;
	740 [label="[Koniec]",shape=box,color=red];
		740 -> 744;
	749 [label="Proszę bardzo.",shape=box,color=red];
		749 -> 754;
	748 [label="[Koniec]",shape=box,color=red];
		748 -> 753;
	747 [label="Pewnie.",shape=box,color=red];
		747 -> 752;
	746 [label="Może innym razem. [Koniec]",shape=box,color=red];
		746 -> 751;
	745 [label="Zastanawiam się, dlaczego na jego plecach znajduje się druga twarz, narysowana jak przez dziecko.",shape=box,color=blue];
		745 -> 750;
	744 [label="Chat ends.",color=orange];
	754 [label="W le Cathédrale żyła Siostra, która kiedyś zatraciła się w korytarzach swojej przeszłości. Siostra Cécilia.",shape=box,color=blue];
		754 -> 757;
	753 [label="Chat ends.",color=orange];
	752 [label="Wszyscy uważali go za geniusza, za umysł, który zdołał wykorzystać kryształy argonowe.",shape=box,color=red];
		752 -> 756;
	751 [label="Chat ends.",color=orange];
	750 [label="Zapytałam Monsieur Nekraloida i Monsieur Loida, ale żaden z nich nie chciał o tym rozmawiać. Podzielili się tylko imieniem. Otak. Wypowiedzieli je z wielkim smutkiem.",shape=box,color=blue];
		750 -> 755;
	757 [label="Stawała przed wielkim zegarem w głównym holu i ogłaszała, że wybiła godzina czternasta, ale nie miała pojęcia, jaka rzeczywiście była pora.",shape=box,color=blue];
		757 -> 761;
	756 [label="Które pozyskiwał z Pustki - to dzięki nim byliśmy w stanie stworzyć wiele potężnych warframe’ów i broni.",shape=box,color=red];
		756 -> 760;
	755 [label="I tak oto trafiłam na Ciebie, z nadzieją, że zdołasz mi pomóc.",shape=box,color=blue];
		755 -> 758;
		755 -> 759;
	761 [label="Wszystkie obrazy w korytarzach byłyby zwrócone w złą stronę, a ona mówiła, że szepczą jej o strasznych intrygach.",shape=box,color=blue];
		761 -> 766;
	760 [label="Jego specjalizacją była krystalografia. A jego prace odbywały się tutaj, w tych laboratoriach.",shape=box,color=red];
		760 -> 765;
	758 [label="Chcesz poznać prawdę o Otaku? Albo dlaczego nie możesz z nim rozmawiać?",shape=box,color=red];
		758 -> 762;
	759 [label="Otak jest skomplikowany...",shape=box,color=red];
		759 -> 2919;
	766 [label="Zrozumieliśmy, że słyszała rozmowy za ścianami, ale była przekonana, że przemawiają do niej obrazy...",shape=box,color=blue];
		766 -> 770;
	765 [label="Z nieznanego mi powodu został przemieniony w Cefalona i otrzymał nekraloidową powłokę.",shape=box,color=red];
		765 -> 769;
	762 [label="Myślę, że chciałabym poznać obie prawdy, ale pozwolę Ci zadecydować, od której zaczniesz. Nie wiem, która z nich jest ważniejsza, après tout.",shape=box,color=blue];
		762 -> 2919;
	2919 [label="Check boolean LoidFamilyComplete",color=orange];
		2919 -> 764 [label=true,color=green];
		2919 -> 764 [label=false,color=brown];
		2919 -> 763 [label=false,color=brown];
	770 [label="Pewnego razu uznała wszystkie poduszki w salonie za dzieci i zaprosiła je na herbatę...",shape=box,color=blue];
		770 -> 774;
	769 [label="Nie wszystkie Cefalony powstały za karę. Ale sprawy na Deimosie... nie szły dobrze, a on został poważnie uszkodzony.",shape=box,color=red];
		769 -> 773;
	764 [label="Otak był kiedyś Archimedianem, uczonym Orokin. Nie spotkał go najszczęśliwszy los.",shape=box,color=red];
		764 -> 768;
	763 [label="No cóż... krótko mówiąc, część rodziny Entrati jest piętro wyżej i... nie zdają sobie sprawy, że my jesteśmy tu na dole.",shape=box,color=red];
		763 -> 767;
	774 [label="Kiedy weszłam do pokoju, spojrzała na mnie i powiedziała \"Och, Siostro Odette, w końcu przybyłaś ! Dzieci z sierocińca czekały na ciebie, dołączysz do nas ?\"",shape=box,color=blue];
		774 -> 777;
		774 -> 778;
	773 [label="+5 Chemistry",color=orange];
		773 -> 776;
	768 [label="Update boolean MarieOtak1",color=orange];
		768 -> 772;
	767 [label="Update boolean MarieFamily1",color=orange];
		767 -> 771;
	777 [label="I co zrobiłaś?",shape=box,color=red];
		777 -> 781;
	778 [label="Kim była Siostra Odette?",shape=box,color=red];
		778 -> 782;
	776 [label="Pauvre petit...",shape=box,color=blue];
		776 -> 780;
	772 [label="Par les Luminaires... powiedz mi więcej.",shape=box,color=blue];
		772 -> 752;
	771 [label="Par les Luminaires... Mówisz, że wszyscy jesteśmy tu w tajemnicy ?! To dlatego nie możemy opuścić tego miejsca ?! Mais pourquoi ?!",shape=box,color=blue];
		771 -> 775;
	781 [label="Zajęłam wolne miejsce przy stole i sączyłam herbatę w towarzystwie jej i poduszek, co więcej mogłam zrobić ?",shape=box,color=blue];
		781 -> 787;
	782 [label="Przykro mi to mówić, ale Siostra Odette opuściła nas trzydzieści lat temu.",shape=box,color=blue];
		782 -> 788;
	780 [label="Więc, stał się głównym nekraloidem - jedynym Nekraloidem, który pozostał - i... ma się dobrze? Ciężko to wyjaśnić.",shape=box,color=red];
		780 -> 784;
		780 -> 785;
		780 -> 786;
	775 [label="Jego córka, Euleria - znana jako Matka, i jej rodzina, przez cały ten czas zajmowali się Deimosem.",shape=box,color=red];
		775 -> 779;
	787 [label="Śmiałyśmy się, kiedy opowiadała o swoich przeżyciach z przeszłości. Opowieści, których Siostra Cécilia z nikim innym nie podzieliła.",shape=box,color=blue];
		787 -> 791;
	788 [label="Zajęłam wolne miejsce przy stole i sączyłam herbatę w towarzystwie jej i poduszek.",shape=box,color=blue];
		788 -> 787;
	784 [label="Właściwie chciałbym, żebyśmy byli w stanie go naprawić. Przywrócić prawdziwego Otaka.",shape=box,color=red];
		784 -> 754;
	785 [label="Potrafi rozbawić mnie do łez, ale kryje za tym coś tragicznego.",shape=box,color=red];
		785 -> 754;
	786 [label="Niestety, nie można go naprawić i myślę, że wielu działa to na nerwy. ",shape=box,color=red];
		786 -> 754;
	779 [label="Strzegą tego miejsca i serca, które pompuje energię Pustki w Systemie Origin, pozwalając nam... działać, od kiedy Entrati odszedł.",shape=box,color=red];
		779 -> 783;
	791 [label="W jednych chwilach jej oczy mieniły się żarem, a w innych były puste niczym oczy lalki...",shape=box,color=blue];
		791 -> 794;
		791 -> 795;
		791 -> 796;
		791 -> 797;
	783 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		783 -> 789 [label=true,color=green];
		783 -> 790 [label=false,color=brown];
	794 [label="Dlaczego do niej dołączyłaś?",shape=box,color=red];
		794 -> 800;
	795 [label="Co stało się z Siostrą Cécilią?",shape=box,color=red];
		795 -> 801;
	796 [label="Mam nadzieję, że doceniła Twoją obecność.",shape=box,color=red];
		796 -> 802;
	797 [label="To miłe, że do niej dołączyłaś.",shape=box,color=red];
		797 -> 803;
	789 [label="Pogodziła się z jego nieobecnością i nawzajem sobie przebaczyli, ale nie przyszło im to łatwo.",shape=box,color=red];
		789 -> 792;
	790 [label="Nie pogodziła się z jego odejściem i nadal rzucają się sobie do gardeł.",shape=box,color=red];
		790 -> 793;
	800 [label="+15 Chemistry",color=orange];
		800 -> 806;
	801 [label="Spotkał ją ten sam los, co wszystkich w jej stanie. Zanikała, niczym obraz wystawiony na słońce, aż pozostało jedynie wyblakłe płótno. ",shape=box,color=blue];
		801 -> 807;
	802 [label="+10 Chemistry",color=orange];
		802 -> 808;
	803 [label="+5 Chemistry",color=orange];
		803 -> 809;
	792 [label="Wiedząc, że on wciąż gdzieś tam jest, robiąc bałagan, i nie odezwał się do nim ani słowem, ani nawet listem...?",shape=box,color=red];
		792 -> 798;
	793 [label="Wiedząc, że on wciąż gdzieś tam jest, robiąc bałagan, i nie odezwał się do nim ani słowem, ani nawet listem...?",shape=box,color=red];
		793 -> 799;
	806 [label="Dobre pytanie. Bardzo dobre pytanie. Miałam ku temu wiele powodów. Chciałabym myśleć, że to życzliwość mnie pokierowała.",shape=box,color=blue];
		806 -> 812;
	807 [label="Potem odeszła, a my zorganizowaliśmy une veillée mortuaire w jej imieniu. Mam nadzieję, że w swoich ostatnich chwilach zapamiętała tych, którzy byli wobec niej tak dobrzy. ",shape=box,color=blue];
		807 -> 813;
	808 [label="Chciałabym wierzyć, że gdzieś w głębi to zrozumiała.",shape=box,color=blue];
		808 -> 813;
	809 [label="Czy na pewno była to życzliwość ? Czy mogło być to może poczucie winy ? Ach, sam zadajesz to pytanie tylko z grzeczności. ",shape=box,color=blue];
		809 -> 813;
	798 [label="Nie mogę sobie wyobrazić, jak bolesne musiało to być dla niej. Dla nich wszystkich.",shape=box,color=red];
		798 -> 804;
	799 [label="Zrujnowałoby to i tak nikłe szanse na pogodzenie się.",shape=box,color=red];
		799 -> 805;
	812 [label="Myślę, mogło być to poczucie winy. Że jeśli bym tego nie zrobiła, zaniedbałabym ją, tak jak można zaniedbać dziecko.",shape=box,color=blue];
		812 -> 813;
	813 [label="Chciałabym wierzyć, że Otak wie, kto jest wobec niego życzliwy i cierpliwy. Ale z drugiej strony, tak naprawdę go tam nie ma, prawda ?",shape=box,color=blue];
		813 -> 817;
	804 [label="Rozumiem logikę za decyzjami le Cardinal i chęć ochrony ich przed bólem, który sprawił swoim nieuniknionym odejściem...",shape=box,color=blue];
		804 -> 810;
	805 [label="+10 Chemistry",color=orange];
		805 -> 811;
	817 [label="Rozmawiam z niezwykle skomplikowaną technologią, która udaje człowieka, czyż nie ? Niczym le phonographe, ale wielokroć bardziej skomplikowany. Tak jak Nekraloid, nie ma on duszy.",shape=box,color=blue];
		817 -> 822;
		817 -> 823;
		817 -> 824;
		817 -> 825;
		817 -> 826;
	810 [label="Uważam to za zbędne okrucieństwo, a ty ? Mogą myśleć, że umarł, albo coś gorszego ! A my, żyjemy tutaj, comme des rats d'égout ?",shape=box,color=blue];
		810 -> 814;
		810 -> 815;
	811 [label="Oui... Rozumiem to. Postarałabym się pogodzić ich rodzinę, jeśli jesteś w stanie, non ? To chyba nasza jedyna nadzieją, by kiedykolwiek się stąd uwolnić. ",shape=box,color=blue];
		811 -> 816;
	822 [label="Nekraloid może nie mieć duszy, ale jest wyjątkowy. Inne Cefalony, jak Otak, mają. Ich stworzenie wymagało zniszczenia ich.",shape=box,color=red];
		822 -> 831;
	823 [label="Masz rację. Więc co powinienem z tym zrobić?",shape=box,color=red];
		823 -> 832;
	824 [label="Masz rację. Nie mają, ale to nie daje nam przyzwolenia, by traktować ich gorzej.",shape=box,color=red];
		824 -> 833;
	825 [label="Nie wiem, czy masz rację, ale oni nadal myślą i czują. Nie możemy traktować ich jak rzeczy.",shape=box,color=red];
		825 -> 834;
	826 [label="Nekraloid ma duszę, tak jak wszystkie Cefalony.",shape=box,color=red];
		826 -> 835;
	814 [label="To nie jest moja decyzja.",shape=box,color=red];
		814 -> 818;
	815 [label="Mam przyjaciółkę, która uwielbia szczury. Myślę, że są urocze.",shape=box,color=red];
		815 -> 819;
	816 [label="Żebyśmy nie spędzili tutaj reszty naszego żywota, uwięzieni comme des rats d'égout. ",shape=box,color=blue];
		816 -> 820;
		816 -> 821;
	831 [label="Update boolean MarieCephalonSoul",color=orange];
		831 -> 839;
	832 [label="Update boolean MarieCephalonNoSoul",color=orange];
		832 -> 840;
	833 [label="Update boolean MarieCephalonNoSoul",color=orange];
		833 -> 841;
	834 [label="Update boolean MarieCephalonUnsure",color=orange];
		834 -> 842;
	835 [label="Update boolean MarieCephalonSoul",color=orange];
		835 -> 843;
	818 [label="Wiem. To decyzja Monsieur Loida i wszystkich innych, by zdecydowali się ujawnić.",shape=box,color=blue];
		818 -> 827;
	819 [label="+15 Chemistry",color=orange];
		819 -> 828;
	820 [label="Zapomniałem się. Masz rację, muszę wracać do pracy.",shape=box,color=red];
		820 -> 829;
	821 [label="Mam przyjaciółkę, która uwielbia szczury. Myślę, że są urocze. ",shape=box,color=red];
		821 -> 830;
	839 [label="+5 Chemistry",color=orange];
		839 -> 845;
	840 [label="Och, nie myśl, że chcę, żebyś był okrutny ! Nie ! Szanuj ich, bo są cenni i nie mieli udziału w tym, że stali się tacy, jacy są!",shape=box,color=blue];
		840 -> 846;
	841 [label="+5 Chemistry",color=orange];
		841 -> 840;
	842 [label="+5 Chemistry",color=orange];
		842 -> 847;
	843 [label="+5 Chemistry",color=orange];
		843 -> 848;
	827 [label="Pragnę zasugerować, że tu na dole zatrzymuje nas nie szlachetność, a poczucie winy.",shape=box,color=blue];
		827 -> 836;
	828 [label="I chciałabym kiedyś ich poznać, ale nie o tym mówię, głupi wilczku.",shape=box,color=blue];
		828 -> 827;
	829 [label="+5 Chemistry",color=orange];
		829 -> 837;
	830 [label="+5 Chemistry",color=orange];
		830 -> 838;
	845 [label="Kolejny dowód na to, że diabeł i jemu podobni słusznie zostali potępieni. Ale możesz mieć rację co do Otaka i jemu podobnych, a może ta wiara pozwala Ci zaznać spokoju.",shape=box,color=blue];
		845 -> 850;
	846 [label="Moje serce pęka na myśl o zniszczonych ciałach, które Orokin pozostawili po sobie. Nie byli bogami, ale głodnymi potworami. Wystarczy spojrzeć tylko na mojego towarzysza podróży.",shape=box,color=blue];
		846 -> 851;
	847 [label="Możliwe, że masz rację, ale nie sądzę, żeby diabły Orokin wiedziały więcej o działaniu duszy niż my. Nie byli bogami.",shape=box,color=blue];
		847 -> 852;
	848 [label="Możesz mieć rację, a może ta wiara daje Ci spokój.",shape=box,color=blue];
		848 -> 851;
	836 [label="Że chowamy jakiś głęboki grzech.",shape=box,color=blue];
		836 -> 844;
	837 [label="Dziękuję Ci. Nie wiem, czy Ci się uda, ale czasami jedyne co nam zostaje, to próbować.",shape=box,color=blue];
		837 -> 827;
	838 [label="I chciałabym kiedyś ich poznać, ale nie o tym mówię, głupi wilczku.",shape=box,color=blue];
		838 -> 827;
	850 [label="W każdym razie, wolę wierzyć, że Otak, który odszedł dawno temu, uśmiechnąłby się na myśl, że jesteś tak życzliwy wobec tego, co z niego zostało.",shape=box,color=blue];
		850 -> 2920;
	851 [label="Ciężko jest mi stwierdzić, że Nekraloid ma duszę, kiedy Loid stoi obok niego, oui ?",shape=box,color=blue];
		851 -> 850;
	852 [label="Technologia, a może nawet nauka - owszem, ale dusza ? Ledwie byli w stanie zapanować nad swoimi sercami ! Wystarczy tylko spojrzeć na diabła, z którym podróżuję.",shape=box,color=blue];
		852 -> 851;
	844 [label="I to ten grzech musi zostać przebaczony.",shape=box,color=blue];
		844 -> 849;
	2920 [label="Check boolean LoidFamilyComplete",color=orange];
		2920 -> 2921 [label=true,color=green];
		2920 -> 854 [label=false,color=brown];
	849 [label="Dziękuję, że dałeś mi tyle do myślenia. À la revoyure.",shape=box,color=blue];
		849 -> 853;
	2921 [label="Muszę iść. Ale merci. Mam wiele do przemyślenia.",shape=box,color=blue];
		2921 -> 2922;
	854 [label="Mam tylko nadzieję, że pewnego dnia uda mi się poznać z tym dziwnym fac-similé, które pozostaje, kiedy Monsieur Nekraloid znów zawędruje piętro wyżej.",shape=box,color=blue];
		854 -> 855;
		854 -> 856;
	853 [label="Chat ends.",color=orange];
	2922 [label="Chat ends.",color=orange];
	855 [label="Nie wiem, czy mądrze jest wtrącać się w sprawy innych ludzi.",shape=box,color=red];
		855 -> 857;
	856 [label="Mam nadzieję, że pewnego dnia będziemy mogli powiedzieć prawdę rodzinie Entrati. I wolałbym, żeby stało się to wcześniej niż później. ",shape=box,color=red];
		856 -> 857;
	857 [label="Check boolean MarieFamily1",color=orange];
		857 -> 858 [label=true,color=green];
		857 -> 859 [label=false,color=brown];
	858 [label="Zobaczymy. Chciałabym dowiedzieć się więcej na temat tego, dlaczego musimy tu pozostać.",shape=box,color=blue];
		858 -> 860;
	859 [label="Jest tu historia, której mi nie mówisz. Ale myślę, że wystarczy już opowieści na jeden dzień, oui ?",shape=box,color=blue];
		859 -> 860;
	860 [label="Wkrótce znów porozmawiamy o rodzinie Entrati.",shape=box,color=blue];
		860 -> 147;
	147 [label="Chat ends.",color=orange];
}