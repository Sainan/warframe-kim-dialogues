		j2646710179 -> j3402910875;
	j3402910875 [label="Zależy ci, chcesz mu pomóc — jestem pewna, że jest tego świadom. Ach ! Właśnie tak. Jest jak bezpański pies ze złamaną nogą. Zrosła się, ale zrosła się źle. Wciąż go boli i swędzi.",shape=box,color=blue];
