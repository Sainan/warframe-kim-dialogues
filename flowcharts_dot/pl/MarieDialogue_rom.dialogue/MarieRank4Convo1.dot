		2055 -> 2056;
	2056 [label="Zależy ci, chcesz mu pomóc — jestem pewna, że jest tego świadom. Ach ! Właśnie tak. Jest jak bezpański pies ze złamaną nogą. Zrosła się, ale zrosła się źle. Wciąż go boli i swędzi.",shape=box,color=blue];
		2056 -> 2065;
	2057 [label="Moment, nie chodziło mi o to, żebyś się w to mieszała!",shape=box,color=red];
