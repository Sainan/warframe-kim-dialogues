	2116 [label="Nie zdajemy sobie sprawy z bólu, jaki inni mogą skrywać w swoich sercach. A z tego listu wiedziałam, że płakał razem z Luą.",shape=box,color=blue];
		2116 -> 2119;
	2117 [label="Było tak, jak mówiłeś, non ? Wszystkie niedogodności niosą ze sobą ukrytą moc.",shape=box,color=blue];
		2117 -> 2118;
	2118 [label="To, co uczyniło mnie niepożądaną pour ma mère, sprawiło, że byłam całkiem popularna wśród innych dzieci na ulicy.",shape=box,color=blue];
		2118 -> 2120;
	2119 [label="Ale teraz zaznał spokoju u jej boku. Przez pewien czas miałam do niego żal, że odszedł. Bo teraz inni zwrócili się do mnie, oczekując wskazówek. I miałam do niego żal za opuszczenie mnie.",shape=box,color=blue];
		2119 -> 2121;
	2120 [label="Co jest bardziej pathétique niż dziecko pozbawione pieds, oui ? W moją wyciągniętą dłoń w jeden dzień wpadało więcej, niż oni byli w stanie nakraść w tydzień.",shape=box,color=blue];
