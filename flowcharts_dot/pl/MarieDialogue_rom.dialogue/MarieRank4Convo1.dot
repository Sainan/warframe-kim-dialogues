		j2850329729 -> j3275675234;
	j3088350685 [label="Ach, jakbyś rozmawiał ze statue de marbre, non ? Wiem, jak się czujesz. Często przyłapywałam się na tym, że mówię już dwadzieścia minut, tylko po to, by stwierdzić, że on nie słucha.",shape=box,color=blue];
		j3088350685 -> j3852144690;
	j1935384492 [label="Tak, rozumiem. Ale czasami niewiele możemy zdziałać. Czasami jedyne co możemy zrobić, to pozostać u ich boku, kiedy tego potrzebują.",shape=box,color=blue];
		j1935384492 -> j2955452689;
	j1724470898 [label="Bądź wobec niego cierpliwy i wyrozumiały, et je vous en supplie, nie zrób mu krzywdy, oui ?",shape=box,color=blue];
		j1724470898 -> j2229328782;
	j3001897331 [label="Musisz nauczyć się czytać między wierszami, non ? On mówi historiami. Przypowieściami. Jeśli milczy, wsłuchaj się w jego czyny.",shape=box,color=blue];
		j3001897331 -> j1724470898;
	j726303216 [label="Nadal nie uważam, że to odpowiednia metoda.",shape=box,color=red];
		j726303216 -> j2109466630;
	j3202183369 [label="Zrobię co w mojej mocy.",shape=box,color=red];
		j3202183369 -> j3242150050;
	j3275675234 [label="Jeśli tego chcesz... Mogę opowiedzieć ci historie o kimś, kto postąpił tak samo ? Czy wolisz zakończyć tę rozmowę tutaj ?",shape=box,color=blue];
		j3275675234 -> j463453901;
		j3275675234 -> j4228556475;
