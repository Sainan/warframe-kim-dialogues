		2104 -> 2108;
	2105 [label="Pamiętam, jak słowa stanęły mi w gardle. Ale musiałam być silna. Nawet wtedy miałam obowiązek wobec innych. ",shape=box,color=blue];
		2105 -> 2109;
	2106 [label="Byli zmęczeni tym ciężarem. Więc kiedy ledwo umiałam czytać i pisać, wpadłam w bagno.",shape=box,color=blue];
		2106 -> 2110;
		2106 -> 2111;
	2107 [label="Quelle horrible personne ! J'espère que votre chaise va s'effondrer et vous donner plein d'échardes douloureuses !",shape=box,color=blue];
