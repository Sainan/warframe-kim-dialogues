	j3125888256 [label="[Wyłącz wszystkie rozmowy o samookaleczeniu. Nie stracisz punktów chemii z żadną postacią.]",shape=box,color=red];
		j3125888256 -> j2805464201;
	j1056722684 [label="Szczerze nie wiem, czy lepiej by było, gdyby jego wizje były prawdziwe, czy zmyślone.",shape=box,color=red];
		j1056722684 -> j3828497785;
	j513915246 [label="Chodzi o te straszne wizje, które go nawiedzają. Ich opisy...",shape=box,color=red];
		j513915246 -> j3828497785;
	j1979261799 [label="Martwię się, że pewnego dnia poważnie się zrani.",shape=box,color=red];
		j1979261799 -> j510787714;
	j3093779491 [label="Nie czujesz się czasem niepewnie w jego otoczeniu? Jakby mógł cię zranić, nawet nie zdając sobie z tego sprawy?",shape=box,color=red];
		j3093779491 -> j1560115990;
	j2805464201 [label="Boolean LyonPainOff is now true.",color=orange];
		j2805464201 -> j3579446953;
	j3828497785 [label="+5 Chemistry",color=orange];
		j3828497785 -> j2164787368;
	j510787714 [label="Ach... to niezręczny temat, oui ? Pardon, ale nie wiem jak o tym rozmawiać.",shape=box,color=blue];
		j510787714 -> j1069280166;
	j1560115990 [label="Wierzę, że Leon prędzej zabije siebie, zanim zrani mnie. Mam na ten temat niezachwianą wiarę, jak w bogów i diabłów -",shape=box,color=blue];
		j1560115990 -> j3511723860;
	j3579446953 [label="+20 Chemistry",color=orange];
		j3579446953 -> j3062249535;
	j2164787368 [label="Koszmary w jego głowie — Lua prowadzi go trudną drogą, oui ?",shape=box,color=blue];
		j2164787368 -> j1129851752;
	j1069280166 [label="Postaram się, jak mogę. Zakładam, że pytasz z troski o niego ?",shape=box,color=blue];
		j1069280166 -> j760717571;
		j1069280166 -> j3755177330;
	j3511723860 [label="- nawet Indifférence nie byłaby zdolna zmusić go, by podniósł na mnie rękę.",shape=box,color=blue];
		j3511723860 -> j1225138556;
	j3062249535 [label="[Ta decyzja ominie wszystkie rozmowy związane z samookaleczeniem.]",shape=box,color=blue];
		j3062249535 -> "Chat ends.";
	j1129851752 [label="Obawiam się, że to nie jest łatwy temat. Wiem, że nie powinno to mieć miejsca, oui ?",shape=box,color=blue];
		j1129851752 -> j1719343157;
	j760717571 [label="Warframe, którego serum otrzymał, był znany z... no właśnie...",shape=box,color=red];
		j760717571 -> j1861296555;
		j760717571 -> j3462059067;
		j760717571 -> j3381190005;
	j3755177330 [label="Wystarczy na niego spojrzeć... przepraszam. Nie trudno było się domyślić.",shape=box,color=red];
		j3755177330 -> j1861296555;
		j3755177330 -> j3462059067;
		j3755177330 -> j3381190005;
	j1225138556 [label="Prędzej obawiałabym się , że motyl połknie mnie w całości , niż mojej bratniej duszy.",shape=box,color=blue];
		j1225138556 -> j1129851752;
	j1719343157 [label="Chciałabym go powstrzymać. Ochronić go przed pragnieniem wyrządzenia sobie takiej krzywdy.",shape=box,color=blue];
		j1719343157 -> j2794855777;
	j1861296555 [label="Po prostu obawiam się, że pewnego dnia posunie się za daleko.",shape=box,color=red];
		j1861296555 -> j1129851752;
	j3462059067 [label="Potrzebujemy go w jednym kawałku.",shape=box,color=red];
		j3462059067 -> j1485745745;
	j3381190005 [label="Nie chcę się martwić sprzątaniem jego zwłok.",shape=box,color=red];
		j3381190005 -> j698283448;
	j2794855777 [label="Jeśli jest coś, czego jestem pewna o Leonie, to to, że nigdy nie zawiedzie w czasie potrzeby.",shape=box,color=blue];
		j2794855777 -> j539219340;
	j1485745745 [label="Powtarzasz słowa diabła. Czy kieruje tobą tylko bezduszna potrzeba rąk do pracy ?",shape=box,color=blue];
		j1485745745 -> j3923982739;
		j1485745745 -> j651078247;
	j698283448 [label="Dégoûtant.",shape=box,color=blue];
		j698283448 -> j1508231473;
	j539219340 [label="Jest wielkim obrońcą, le bouclier sacré de Lua... Latarnią lśniącą pośród mroku.",shape=box,color=blue];
		j539219340 -> j2124238464;
	j3923982739 [label="Nie, bardzo mi na nim zależy. Tylko obawiam się, że nie będzie go z nami w chwili, kiedy będziemy go potrzebować.",shape=box,color=red];
		j3923982739 -> j2794855777;
	j651078247 [label="Chcę mieć pewność, czy mogę na nim polegać, czy nie ma już dla niego nadziei.",shape=box,color=red];
		j651078247 -> j2028448219;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j2124238464 [label="Krzywda, jaką sobie wyrządza... robi to, by usłyszeć własne myśli. By poczuć swoje ciało.",shape=box,color=blue];
		j2124238464 -> j659773362;
	j2028448219 [label="Zastanawiam się, kto pomoże tobie, kiedy to ty będziesz potrzebować pomocnej dłoni.",shape=box,color=blue];
		j2028448219 -> j3867139525;
	j659773362 [label="Niebo jest usiane gwiazdami, a każda z nich szepcze do niego, a on — jak sama Lua — zagubiłby się pośród nich.",shape=box,color=blue];
		j659773362 -> j3547834665;
	j3867139525 [label="Czy może wierzysz , że taki czas już nadszedł i jesteś już ponad taką potrzebą ?",shape=box,color=blue];
		j3867139525 -> j698283448;
	j3547834665 [label="I tak jak Lua, ma on swoje fazy. Daje się pochłonąć Pustce tylko po to, by lśnić tak jasno, abyśmy my mogli bezpiecznie kroczyć pośród mroku.",shape=box,color=blue];
		j3547834665 -> j1280968827;
	j1280968827 [label="Ale jak każde błogosławieństwo, niesie ze sobą przekleństwo. Czy ma to sens ? Obawiam się, że to może być bełkot.",shape=box,color=blue];
		j1280968827 -> j3252116034;
		j1280968827 -> j212851381;
		j1280968827 -> j1904435084;
		j1280968827 -> j3354702064;
		j1280968827 -> j4079964674;
	j3252116034 [label="Doskonale cię rozumiem. Muszę... się do czegoś przyznać. [Wyznaj uczucia wobec Leona]",shape=box,color=red];
		j3252116034 -> j2819039833;
	j212851381 [label="Rozumiem, co masz na myśli, ale nie mogę pozwolić, żeby robił sobie krzywdę. Musi przestać.",shape=box,color=red];
		j212851381 -> j119117135;
	j1904435084 [label="[Ostrzeżenie: Rozmowa poruszy temat samobójstwa] Przez taką krzywdę straciłem kogoś bliskiego. Nie mogę... nie mogę pozwolić, żeby to się powtórzyło.",shape=box,color=red];
		j1904435084 -> j1840600163;
	j3354702064 [label="Musi być inny sposób.",shape=box,color=red];
		j3354702064 -> j2506379237;
	j4079964674 [label="Masz całkowitą rację. Po prostu... chciałbym mu jakoś pomóc.",shape=box,color=red];
		j4079964674 -> j2506379237;
	j2819039833 [label="Boolean DrifterLyon is now true.",color=orange];
		j2819039833 -> j3090831287;
	j119117135 [label="Boolean DrifterHarmStop is now true.",color=orange];
		j119117135 -> j2281108167;
	j1840600163 [label="Boolean DrifterHarmLoss is now true.",color=orange];
		j1840600163 -> j268082549;
	j2506379237 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j2506379237 -> j3189507253;
	j3090831287 [label="Obawiam się... że zajął specjalne miejsce w moim sercu i nie mogę znieść tego, jak cierpi.",shape=box,color=red];
		j3090831287 -> j3634592057;
	j2281108167 [label="Ból, który odczuwa, sięga głębiej niż rany jego ciała. Krzywda, jaką sobie wyrządza, nie pokona go.",shape=box,color=blue];
		j2281108167 -> j3874901286;
	j268082549 [label="Och ! Nie miałam pojęcia, tak mi przykro... Wszelkie banały i modlitwy, które mogłabym zaoferować, wydawałyby się puste, jestem certaine -",shape=box,color=blue];
		j268082549 -> j2140460841;
	j3189507253 [label="+20 Chemistry",color=orange];
		j3189507253 -> j769844180;
	j3634592057 [label="+20 Chemistry",color=orange];
		j3634592057 -> j4285605826;
	j3874901286 [label="Oczyszcza to jego umysł, uspokaja jego duszę. A teraz, jako Protoframe — po części ten... Harrow, tak jak ja po części jestem Wisp, to go nie zabije, oui ? ",shape=box,color=blue];
		j3874901286 -> j1548711862;
		j3874901286 -> j2457116878;
	j2140460841 [label="- jakie condoléances mogłabym zaoferować komuś, kogo ledwo znam, które przyniosłyby ulgę w tragédie jak ta ?",shape=box,color=blue];
		j2140460841 -> j3019145164;
	j769844180 [label="I przez to tak bardzo cię cenię, ale pomoc może objawiać się na wiele sposobów, non ?",shape=box,color=blue];
		j769844180 -> j1569068615;
	j4285605826 [label="Och !! Przez ciebie krzyknęłam, jakbym ujrzała mysz i wystraszyłam Monsieur Loida ! Pardon !!",shape=box,color=blue];
		j4285605826 -> j780876699;
	j1548711862 [label="Nie, to go nie zabije. Ale to nadal nie jest w porządku.",shape=box,color=red];
		j1548711862 -> j2173297031;
	j2457116878 [label="Chyba cię rozumiem.",shape=box,color=red];
		j2457116878 -> j2153863817;
	j3019145164 [label="Dusza, o której mówisz... czy byliście blisko ?",shape=box,color=blue];
		j3019145164 -> j3467977768;
		j3019145164 -> j3765612421;
	j1569068615 [label="Pomoc pisklęciu może oznaczać zabicie go. Pomoc płomieniowi świecy może oznaczać zdmuchnięcie go w swojej exubérance.",shape=box,color=blue];
		j1569068615 -> j3165359541;
	j780876699 [label="To wspaniałe wieści !",shape=box,color=blue];
		j780876699 -> j2990364382;
		j780876699 -> j2693434362;
	j2173297031 [label="Zrozumiałam, że pozostanie u jego boku, kiedy mnie potrzebuje... wysłuchanie go, przytulenie go, kiedy płacze ?",shape=box,color=blue];
		j2173297031 -> j4132868332;
	j2153863817 [label="+10 Chemistry",color=orange];
		j2153863817 -> j3165359541;
	j3467977768 [label="Tak.",shape=box,color=red];
		j3467977768 -> j4033961603;
	j3765612421 [label="Niezbyt.",shape=box,color=red];
		j3765612421 -> j953657400;
	j3165359541 [label="Zrozumiałam, że pozostanie u jego boku, kiedy mnie potrzebuje... wysłuchanie go, samo dotrzymanie mu towarzystwa, kiedy płacze ?",shape=box,color=blue];
		j3165359541 -> j234914943;
	j2990364382 [label="Naprawdę? Nie miałem pojęcia, jak zareagujesz.",shape=box,color=red];
		j2990364382 -> j3543114927;
	j2693434362 [label="Chciałbym tylko wiedzieć, czy jest w stanie tolerować moją obecność...",shape=box,color=red];
		j2693434362 -> j284457045;
	j4132868332 [label="Pomaga mu to bardziej niż mówienie o tym, co powinien robić, a czego nie.",shape=box,color=blue];
		j4132868332 -> j3812942450;
	j4033961603 [label="Czy to dlatego pragniesz, aby Leona nie spotkał podobny los ? Czy problem masz z samym tematem ?",shape=box,color=blue];
		j4033961603 -> j2895380128;
		j4033961603 -> j168267922;
	j953657400 [label="Mimo to znać kogoś, kto czuje się tak zaszczuty, że istniała już tylko jedna droga ucieczki...",shape=box,color=blue];
		j953657400 -> j4033961603;
	j234914943 [label="Pomaga mu to bardziej niż mówienie, co powinien robić, a czego nie.",shape=box,color=blue];
		j234914943 -> j2106115773;
		j234914943 -> j2988871406;
		j234914943 -> j244181884;
	j3543114927 [label="Och, jestem przeszczęśliwa. Tellement ravie ! Leon tak bardzo potrzebuje miłości – nawet nie zdajesz sobie sprawy !",shape=box,color=blue];
		j3543114927 -> j1947920941;
	j284457045 [label="Ach, jakbyś rozmawiał ze statue de marbre, non ? Wiem, jak się czujesz. Często przyłapywałam się na tym, że mówię już dwadzieścia minut, tylko po to, by stwierdzić, że on nie słucha.",shape=box,color=blue];
		j284457045 -> j2368750188;
	j3812942450 [label="Musisz nauczyć się czytać między wierszami, non ? On mówi historiami. Przypowieściami. Jeśli milczy, wsłuchaj się w jego czyny.",shape=box,color=blue];
		j3812942450 -> j527885910;
	j2895380128 [label="Po prostu... nie chcę wracać do tego tematu. Nie dam rady. ",shape=box,color=red];
		j2895380128 -> j3926675856;
	j168267922 [label="Po prostu nie chcę, żeby Leon cierpiał...",shape=box,color=red];
		j168267922 -> j2850329729;
	j2106115773 [label="Postaram się wziąć twoje rady do serca. Nie wiem tylko, jak do niego dotrzeć.",shape=box,color=red];
		j2106115773 -> j3088350685;
	j2988871406 [label="Zrobię, co mogę, ale... chciałbym po prostu móc zrobić więcej.",shape=box,color=red];
		j2988871406 -> j1935384492;
	j244181884 [label="Po prostu... bywa taki frustrujący.",shape=box,color=red];
		j244181884 -> j3088350685;
	j1947920941 [label="Ach, a może jednak tak. Jak mogłeś zauważyć, Leon cierpi, mimo tego, że stara się to ukryć...",shape=box,color=blue];
		j1947920941 -> j1724470898;
	j2368750188 [label="Zagubiony w labiryncie własnego umysłu, albo wpatrzony w inny esprit w pokoju.",shape=box,color=blue];
		j2368750188 -> j3001897331;
	j527885910 [label="Bądź wobec niego cierpliwy i wyrozumiały, et je vous en supplie, nie zrób mu krzywdy, oui ?",shape=box,color=blue];
		j527885910 -> j726303216;
		j527885910 -> j3202183369;
	j3926675856 [label="Boolean LyonPainOff is now true.",color=orange];
		j3926675856 -> j3275675234;
