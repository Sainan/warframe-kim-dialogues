	2060 [label="Jest jak bezpański pies ze złamaną nogą. Zrosła się, ale zrosła się źle. Wciąż go boli i swędzi.",shape=box,color=blue];
		2060 -> 2065;
	2061 [label="Merci. O więcej nie mogę prosić. À bientôt.",shape=box,color=blue];
