		2121 -> 2123;
	2122 [label="Zawsze byłam chętna do dzielenia się. Miałam wielu przyjaciół, którzy o mnie dbali. Jednym z nich był starszy chłopiec o imieniu Hugo.",shape=box,color=blue];
		2122 -> 2085;
	2123 [label="Możemy tylko wybaczyć sobie bycie ludźmi. I wybaczyć sobie ból związany z ich odejściem.",shape=box,color=blue];
		2123 -> 2124;
