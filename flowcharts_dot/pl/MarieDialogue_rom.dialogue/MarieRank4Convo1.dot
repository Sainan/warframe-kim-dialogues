	2065 [label="Wciąż się po niej gryzie, otwiera nowe rany, odczuwa nowy ból... ale to mu przynosi ulgę.",shape=box,color=blue];
		2065 -> 2073;
	2066 [label="Haha ! Na to już za późno. Maria, au travail ! Il y a de l'amour dans l'air !",shape=box,color=blue];
		2066 -> 2074;
	2067 [label="Oui ! I nawet gdybyś chciał mnie powstrzymać, nie zdołasz ! Maria śpieszy do pomocy !",shape=box,color=blue];
		2067 -> 2075;
	2068 [label="Chat ends.",color=orange];
	2069 [label="Oui, jak sobie życzysz. À bientôt.",shape=box,color=blue];
		2069 -> 2076;
	2070 [label="Oui, oczywiście.",shape=box,color=blue];
		2070 -> 2060;
	2071 [label="Wiesz, jak rozpoczęła się moja historia życia, ale nie powiedziałam ci wszystkiego.",shape=box,color=blue];
		2071 -> 2077;
	2072 [label="Update boolean MarieBackstory1",color=orange];
		2072 -> 2078;
	2073 [label="Rani się, ale to jest częścią niego. A jeśli podejdziesz do niego avec colère, jeśli nie będziesz delikatny, ucieknie przed twoim dotykiem.",shape=box,color=blue];
		2073 -> 2079;
	2074 [label="Chat ends.",color=orange];
	2075 [label="Chat ends.",color=orange];
	2076 [label="Chat ends.",color=orange];
	2077 [label="Powiedziałam ci, że byłam żebraczką na ulicy, kiedy byłam jeszcze jeune fille. Powiedziałam, że radziłam sobie i miałam wielu przyjaciół.",shape=box,color=blue];
		2077 -> 2080;
	2078 [label="Urodziłam się w bogatej rodzinie, co może Cię zaskoczyć. Burżuazja, której bliżej niż dalej było do Orokin.",shape=box,color=blue];
		2078 -> 2081;
	2079 [label="Musisz zdobyć zaufanie dzikiego zwierzęcia. Pozwolić mu podejść do ciebie, non ? Czy ma to sens ?",shape=box,color=blue];
		2079 -> 2082;
		2079 -> 2083;
		2079 -> 2084;
	2080 [label="Jednym z nich był starszy chłopiec o imieniu Hugo.",shape=box,color=blue];
		2080 -> 2085;
	2081 [label="W dniu narodzin moje ciało było... zdeformowane, mes pieds tordus et inutilisables ? Och, ma mère nie mogła tego znieść.",shape=box,color=blue];
		2081 -> 2086;
	2082 [label="Tak, w zupełności. Dziękuję.",shape=box,color=red];
		2082 -> 2087;
	2083 [label="Ma to więcej sensu, niż powinno. Dziękuję.",shape=box,color=red];
		2083 -> 2088;
	2084 [label="Nie, ale dzięki za chęci.",shape=box,color=red];
		2084 -> 2089;
	2085 [label="Na swój sposób był przywódcą stada. Dbał o to, by nikt się nade mną nie znęcał, by niczego mi nie brakowało.",shape=box,color=blue];
		2085 -> 2090;
	2086 [label="Musieli zachować pozory, oui ? Spełniać oczekiwania.",shape=box,color=blue];
		2086 -> 2091;
	2087 [label="Bien ! Obawiałam się, że moje metafory znów były zbyt zagmatwane.",shape=box,color=blue];
		2087 -> 2092;
	2088 [label="Maria i jej metafory. Ach, bon.",shape=box,color=blue];
		2088 -> 2092;
	2089 [label="Mince alors. Czułam, że znów poniosło mnie z moimi métaphores.",shape=box,color=blue];
		2089 -> 2092;
	2090 [label="Pomógł mi nawet zbudować des béquilles — nazwałbyś je... chyba... kulami ? Kawałki drewna, które pomagały mi się poruszać.",shape=box,color=blue];
		2090 -> 2093;
	2091 [label="Więc co zrobili z małą, biedną, pokrzywdzoną Marią ? Zabrano mnie do la Cité de la Lumière, gdzie z pewnością żebrałabym na ulicach...",shape=box,color=blue];
		2091 -> 2094;
	2092 [label="Hmm. Zdałam sobie sprawę, że określenie Leona bezpańskim psem może nie być najbardziej pochlebne...",shape=box,color=blue];
		2092 -> 2095;
	2093 [label="Pewnego ranka poszliśmy go obudzić, a on...",shape=box,color=blue];
		2093 -> 2096;
	2094 [label="I zostawili mnie na śmierć.",shape=box,color=blue];
