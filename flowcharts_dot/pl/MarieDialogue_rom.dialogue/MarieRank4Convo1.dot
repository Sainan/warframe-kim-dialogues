	2100 [label="Ale zostawił dla nas wiadomość. Była ledwie czytelna. Tylko ja i on potrafiliśmy czytać, więc musiałam przeczytać jego list reszcie dzieci. ",shape=box,color=blue];
		2100 -> 2105;
	2101 [label="Sześć ? Siedem ? W ich oczach, przez wiele lat próbowali mnie naprawić. Prywatne lekcje nauki chodzenia. Aparaty ortopedyczne. Obuwie.",shape=box,color=blue];
		2101 -> 2106;
	2102 [label="W ich oczach, przez wiele lat próbowali mnie naprawić. Prywatne lekcje nauki chodzenia. Aparaty ortopedyczne. Obuwie.",shape=box,color=blue];
