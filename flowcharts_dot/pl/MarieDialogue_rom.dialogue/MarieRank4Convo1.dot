		j2955452689 -> j3402910875;
	j2229328782 [label="O więcej nie proszę. Och, ale jestem tak bardzo szczęśliwa ! Muszę zadbać o to, żeby się wam powiodło !",shape=box,color=blue];
		j2229328782 -> j559760404;
		j2229328782 -> j3328501409;
		j2229328782 -> j2197514911;
