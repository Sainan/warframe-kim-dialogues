		j1609016124 -> j3151745867;
	j1074673310 [label="Po tysiącach lat sprawowania władzy ludzie zaczynają się... nudzić. A znudzeni ludzie tworzą zagmatwane systemy.",shape=box,color=red];
		j1074673310 -> j4198728169;
