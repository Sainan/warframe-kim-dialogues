	j1724976302 [label="Wilku ! Mój wilku ! Poznałam Otaka ! W końcu go poznałam !",shape=box,color=blue];
		j1724976302 -> j2347918980;
		j1724976302 -> j2517463178;
	j3175504904 [label="Poznałam Otaka ! W końcu go poznałam !",shape=box,color=blue];
		j3175504904 -> j2347918980;
		j3175504904 -> j2517463178;
	j1876842840 [label="Wilku ! Mój wilku ! Twarz z tyłu głowy Monsieur Nekraloida ! W końcu ją poznałam !",shape=box,color=blue];
		j1876842840 -> j2874701634;
		j1876842840 -> j1305765985;
		j1876842840 -> j2832708596;
	j400758426 [label="Twarz z tyłu głowy Monsieur Nekraloida ! W końcu ją poznałam !",shape=box,color=blue];
		j400758426 -> j2874701634;
		j400758426 -> j1305765985;
		j400758426 -> j2832708596;
	j2347918980 [label="I jak udała się wasza rozmowa?",shape=box,color=red];
		j2347918980 -> j1380437746;
	j2517463178 [label="Jesteś zadowolona z tej rozmowy?",shape=box,color=red];
		j2517463178 -> j2703956613;
	j2874701634 [label="Poznałaś Otaka? A niech mnie... jak poszło?",shape=box,color=red];
		j2874701634 -> j3542434500;
	j1305765985 [label="Cieszę się, że w końcu się poznaliście. Otaka... dosyć trudno przedstawić.",shape=box,color=red];
		j1305765985 -> j3085180728;
	j2832708596 [label="Biedny Otak... jak wam poszło?",shape=box,color=red];
		j2832708596 -> j2624444968;
	j1380437746 [label="Przedstawił się trzykrotnie w tej samej rozmowie, jakbyśmy nigdy wcześniej się nie poznali.",shape=box,color=blue];
		j1380437746 -> j3679802483;
	j2703956613 [label="Tak ! Choć chciałam płakać z jego powodu. Przedstawił się trzykrotnie w tej samej rozmowie, jakbyśmy nigdy wcześniej się nie poznali.",shape=box,color=blue];
		j2703956613 -> j3679802483;
	j3542434500 [label="Dlaczego wydajesz się niezadowolony tym, że go poznałam ?",shape=box,color=blue];
		j3542434500 -> j4126734191;
		j3542434500 -> j1639897603;
		j3542434500 -> j1319585033;
	j3085180728 [label="Tak, tak myślałam. Dziecięcy bazgroł na tyle maszyny. Ale okazał się uroczy i czarujący !",shape=box,color=blue];
		j3085180728 -> j3974315444;
	j2624444968 [label="Okazał się uroczy i czarujący ! Ale za grubą warstwą humoru skrywa ogromny ból.",shape=box,color=blue];
		j2624444968 -> j2357871057;
	j3679802483 [label="Powitał mnie w ten sam nieustępliwie radosny sposób, jak za każdym razem wcześniej. Ale wiedział, że jestem Sœur de Sol !",shape=box,color=blue];
		j3679802483 -> j3610434742;
	j4126734191 [label="Przepraszam. Potrafi działać ludziom na nerwy, ale to nie jego wina.",shape=box,color=red];
		j4126734191 -> j1755746393;
	j1639897603 [label="Nie chciałem, żeby to tak zabrzmiało. Otak potrafi być... trochę odpychający dla niektórych ludzi.",shape=box,color=red];
		j1639897603 -> j1755746393;
	j1319585033 [label="Czasami działa mi na nerwy, to tyle. ",shape=box,color=red];
		j1319585033 -> j230969459;
	j3974315444 [label="Ale za grubą warstwą humoru skrywa ogromny ból.",shape=box,color=blue];
		j3974315444 -> j2357871057;
	j2357871057 [label="Czy opowiesz mi historię biednego Monsieur Otaka ?",shape=box,color=blue];
		j2357871057 -> j3923278905;
	j3610434742 [label="Wiedział naprawdę dużo o Świetlistych ! Długo rozmawialiśmy o, jak to określił, \"starożytnych religiach\", w czasach \"poprzedzających Imperium Orokin\".",shape=box,color=blue];
		j3610434742 -> j2895330069;
	j1755746393 [label="Mam nadzieję, że okażą mu życzliwość i cierpliwość. Mais par la grâce de Sol, wszyscy powinniśmy.",shape=box,color=blue];
		j1755746393 -> j3900548468;
	j230969459 [label="Miałabym nadzieję, że postarasz się być milszym dla kogoś, kto jest widocznie infirme. Podążamy za łaską Sol.",shape=box,color=blue];
		j230969459 -> j3900548468;
	j3923278905 [label="Otak był kiedyś Archimedianem, uczonym Orokin. Nie spotkał go najszczęśliwszy los.",shape=box,color=red];
		j3923278905 -> j171620693;
	j2895330069 [label="Choć powiedział, że wiele z tej wiedzy przepadło, zaginęło w głębinach archiwów i jest całkowicie zakazane, poprosił mnie o dochowanie tajemnicy.",shape=box,color=blue];
		j2895330069 -> j2243554515;
	j3900548468 [label="Taki los mógłby spotkać każdego z nas, nawet ciebie.",shape=box,color=blue];
		j3900548468 -> j194377980;
		j3900548468 -> j4192308520;
	j171620693 [label="Wszyscy uważali go za geniusza, za umysł, który zdołał wykorzystać potencjał kryształów argonowych.",shape=box,color=red];
		j171620693 -> j406857413;
	j2243554515 [label="Powiedział mi, że obawia się, że Egzekutor Ballas, kimkolwiek on jest, może odkryć naszą sektę heretyków i skazać mnie na śmierć.",shape=box,color=blue];
		j2243554515 -> j1803576489;
		j2243554515 -> j3490288741;
	j194377980 [label="Przepraszam, po prostu nie mam czasu, żeby się nim zajmować.",shape=box,color=red];
		j194377980 -> j2884409040;
	j4192308520 [label="Masz rację, przepraszam. Źle się wyraziłem.",shape=box,color=red];
		j4192308520 -> j2357871057;
	j406857413 [label="Które pozyskiwał z Pustki, to dzięki nim byliśmy w stanie stworzyć wiele potężnych warframe’ów i broni.",shape=box,color=red];
		j406857413 -> j1656298884;
	j1803576489 [label="Nie dojdzie do tego. Kontynuuj.",shape=box,color=red];
		j1803576489 -> j1579415688;
	j3490288741 [label="Ballas już nie żyje... kontynuuj.",shape=box,color=red];
		j3490288741 -> j1579415688;
	j2884409040 [label="A więc przepraszam, że marnuję twój cenny czas.",shape=box,color=blue];
		j2884409040 -> j3007723528;
	j1656298884 [label="Jego specjalizacją była krystalografia. A jego prace odbywały się tutaj, w tych laboratoriach.",shape=box,color=red];
		j1656298884 -> j1861348290;
	j1579415688 [label="+5 Chemistry",color=orange];
		j1579415688 -> j2382159636;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j1861348290 [label="Z nieznanego mi powodu został przemieniony w Cefalona i otrzymał nekraloidową powłokę.",shape=box,color=red];
		j1861348290 -> j141930795;
	j2382159636 [label="Podejrzewałam... Zapytał mnie, skąd jestem, a kiedy odpowiedziałam, zaśmiał się i powiedział \"nie, to niemożliwe! Jestem tego pewien, jestem przecież...\"",shape=box,color=blue];
		j2382159636 -> j3395849415;
	j141930795 [label="Nie wszystkie Cefalony powstały za karę. Ale sprawy na Deimosie... nie szły dobrze, a on został poważnie uszkodzony.",shape=box,color=red];
		j141930795 -> j646397063;
	j3395849415 [label="I wtedy... znów mi się przedstawił. Zapytał mnie, czy wracam z równin z próbkami materiałów...",shape=box,color=blue];
		j3395849415 -> j2633697971;
		j3395849415 -> j1287594715;
	j646397063 [label="Pauvre petit...",shape=box,color=blue];
		j646397063 -> j1698645168;
	j2633697971 [label="Och, tak mi przykro...",shape=box,color=red];
		j2633697971 -> j2811262331;
	j1287594715 [label="Tak... to brzmi jak Otak.",shape=box,color=red];
		j1287594715 -> j2811262331;
	j1698645168 [label="Boolean MarieOtak1 is now true.",color=orange];
		j1698645168 -> j2347918980;
		j1698645168 -> j2517463178;
	j2811262331 [label="Moje serce płacze na myśl o tym, że nie jesteśmy w stanie mu pomóc.",shape=box,color=blue];
		j2811262331 -> j1970966774;
	j1970966774 [label="Evaluate expressions",color=orange];
		j1970966774 -> j1284237591 [label="MarieCephalonSoul",color=purple];
		j1970966774 -> j858001641 [label="MarieCephalonNoSoul",color=purple];
		j1970966774 -> j2952497393 [label="MarieCephalonUnsure",color=purple];
		j1970966774 -> j2975901101 [label="false",color=purple];
	j1284237591 [label="Och, Świetliści – na jakie piekło go skazaliście ? Dlaczego jego dusza została uwięziona w klatce nauki i migających świateł ?",shape=box,color=blue];
		j1284237591 -> j955472843;
	j858001641 [label="Mogę tylko modlić się do Świetlistych, żebyś miał rację i wszystko co pozostało wewnątrz tej powłoki, było tylko... nauką i świecącymi lampkami.",shape=box,color=blue];
		j858001641 -> j1315415121;
	j2952497393 [label="Wiem, że nie jesteś pewien, czy Cefalony mają duszę, ale mogę tylko modlić się do Świetlistych... żeby biedny Otak nie musiał cierpieć.",shape=box,color=blue];
		j2952497393 -> j1742606350;
	j2975901101 [label="Mogę tylko modlić się do Świetlistych, żeby wszystko co pozostało wewnątrz tej powłoki, było tylko... nauką i świecącymi lampkami.",shape=box,color=blue];
		j2975901101 -> j312618700;
	j955472843 [label="Dlaczego został porzucony, zniszczony i czekający, aż będzie dane mu umrzeć i zaznać spokoju ? Mogę tylko się modlić... że jeśli została w nim jakaś resztka bytu...",shape=box,color=blue];
		j955472843 -> j2225535130;
	j1315415121 [label="Żeby żadna dusza nie była uwięziona w tej zepsutej maszynie, czekając, aż ktoś pozwoli mu umrzeć i zaznać spokoju.",shape=box,color=blue];
		j1315415121 -> j1120778896;
	j1742606350 [label="I żeby żadna dusza nie była uwięziona w tej zepsutej maszynie, czekając, aż ktoś pozwoli mu umrzeć i zaznać spokoju.",shape=box,color=blue];
		j1742606350 -> j1641659020;
	j312618700 [label="Żeby żadna dusza nie była uwięziona w tej zepsutej maszynie, czekając, aż ktoś pozwoli mu umrzeć i zaznać spokoju.",shape=box,color=blue];
		j312618700 -> j1641659020;
	j2225535130 [label="Pozostaje ona tam z jego wyboru, ku jego pamięci...",shape=box,color=blue];
		j2225535130 -> j2116320893;
	j1120778896 [label="Bo jeśli się mylisz ? I dusza pozostaje uwięziona w tej klatce wbrew jej woli ?",shape=box,color=blue];
		j1120778896 -> j793952331;
	j1641659020 [label="A jeśli pozostaje w nim jakaś resztka bytu, istnieje ona z jego wyboru, ku jego pamięci.",shape=box,color=blue];
		j1641659020 -> j2116320893;
	j2116320893 [label="Dopuścić inną możliwość wymagałoby zastanowienia się nad łaskawością samych bogów, non ?",shape=box,color=blue];
		j2116320893 -> j1037201069;
	j793952331 [label="To wymagałoby zastanowienia się nad łaskawością samych bogów, non ?",shape=box,color=blue];
		j793952331 -> j1037201069;
	j1037201069 [label="I co ja bym dalej poczęła ?",shape=box,color=blue];
		j1037201069 -> j1531838509;
