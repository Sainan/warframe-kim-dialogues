		j2912289738 -> j1271645520;
	j1812614696 [label="+20 Chemistry",color=orange];
		j1812614696 -> j371126032;
	j4119082942 [label="Ha ! Merci. To na pewno powstrzyma moje łzy. Doskonale wiesz, jak rozweselić małą głupią Marię, non ?",shape=box,color=blue];
		j4119082942 -> j1142743416;
		j4119082942 -> j3964714657;
	j1271645520 [label="Oui. Masz całkowitą rację. Potrafią. Świat jest pełen historii takich, jak Monsieur Otaka, i wielu nawet gorszych. Nie powinnam ubolewać nad tylko jedną z nich. ",shape=box,color=blue];
		j1271645520 -> j1428265262;
	j371126032 [label="Merci, ale nie chcę tego. Znajdę sobie jakieś wesołe zajęcie ! Myślę, że zbiornik M'sieur Fibonacciego wymaga odkurzenia.",shape=box,color=blue];
		j371126032 -> j2425134241;
	j1142743416 [label="To żadna głupota, czuję się tak samo.",shape=box,color=red];
		j1142743416 -> j2235898819;
	j3964714657 [label="Przynajmniej tak mogę pomóc.",shape=box,color=red];
		j3964714657 -> j2235898819;
	j1428265262 [label="A jednak siedzę tu i właśnie to robię. Dziękuję, za przypomnienie mi o mojej głupocie. Fie ! Mała, głupia Maria. Myślę... że zbiornik M'sieur Fibonacciego wymaga odkurzenia.",shape=box,color=blue];
		j1428265262 -> j2425134241;
