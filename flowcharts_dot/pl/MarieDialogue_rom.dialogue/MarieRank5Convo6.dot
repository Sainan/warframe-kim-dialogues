	j3118353209 [label="Mogę cię jakoś rozweselić? Możemy ponękać Roathe'a.",shape=box,color=red];
		j3118353209 -> j1663360731;
	j2660696626 [label="Mogę cię jakoś rozweselić? Może ukradniemy jakieś ciastka?",shape=box,color=red];
		j2660696626 -> j906334354;
	j1610091135 [label="Czasami bogowie potrafią być okrutni, takie jest życie.",shape=box,color=red];
		j1610091135 -> j2912289738;
	j2379174627 [label="To zrozumiałe, masz do tego prawo.",shape=box,color=red];
		j2379174627 -> j1812614696;
	j1663360731 [label="+15 Chemistry",color=orange];
		j1663360731 -> j4119082942;
