		j3102612293 -> j369807617;
	j369807617 [label="Check boolean LoidFamilyComplete",color=orange];
		j369807617 -> j4159978133 [label=true,color=green];
		j369807617 -> j1668831657 [label=false,color=brown];
	j4159978133 [label="Mam nadzieję, że nie zrozumiesz tego źle... ale mam dziwne przeczucie, że robiliśmy to już wcześniej ?",shape=box,color=blue];
		j4159978133 -> j3814834297;
	j1668831657 [label="Check boolean MarieFamily1",color=orange];
		j1668831657 -> j2207566281 [label=true,color=green];
		j1668831657 -> j2197889927 [label=false,color=brown];
	j3814834297 [label="Odbyliśmy te rozmowy... poznaliśmy tych ludzi... ale to niemożliwe, non ?",shape=box,color=blue];
		j3814834297 -> j3966626432;
	j2207566281 [label="Opowiesz mi więcej o la familie du Cardinal ? Jestem zafascynowana jego przeszłością.",shape=box,color=blue];
		j2207566281 -> j4108118209;
		j2207566281 -> j1448859768;
		j2207566281 -> j386906797;
	j2197889927 [label="Opowiesz mi o la familie du Cardinal ? Jestem zafascynowana jego przeszłością.",shape=box,color=blue];
		j2197889927 -> j4108118209;
		j2197889927 -> j1448859768;
		j2197889927 -> j386906797;
	j3966626432 [label="+20 Chemistry",color=orange];
		j3966626432 -> j306381825;
	j4108118209 [label="Powiem, co wiem, ale obawiam się, że to może być mniej, niż się spodziewasz.",shape=box,color=red];
		j4108118209 -> j2782221832;
	j1448859768 [label="Oczywiście, ale... czy nie lepiej byłoby, gdybyś porozmawiała o tym z Loidem?",shape=box,color=red];
		j1448859768 -> j3599452117;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j306381825 [label="Nazywamy to déjà vu. To pewnie przez sérum i podróże w czasie. C'est la vie !",shape=box,color=blue];
		j306381825 -> "Chat ends.";
	j2782221832 [label="Czymkolwiek się ze mną podzielisz, będzie na wagę złota. Promis !",shape=box,color=blue];
		j2782221832 -> j627914053;
	j3599452117 [label="A skoro mowa o le Cardinal... wzmianka o nim zdaje się sprawiać Monsieur Loidowi wiele bólu. Nie lubię tego robić.",shape=box,color=blue];
		j3599452117 -> j627914053;
	"Chat ends." [color=orange];
	j627914053 [label="Zwłaszcza, że robię to avec une certaine joie, w czym wydaję się być odosobniona.",shape=box,color=blue];
		j627914053 -> j3354905079;
		j627914053 -> j479752784;
	j3354905079 [label="Czego chciałabyś się dowiedzieć?",shape=box,color=red];
		j3354905079 -> j2226937606;
	j479752784 [label="Cóż, Matka, Ojciec, Son, Córka i Babcia czekają na górze.",shape=box,color=red];
		j479752784 -> j2226937606;
	j2226937606 [label="Ustalmy najpierw jedną rzecz, dobrze ? Diabeł śmieje się ze mnie za każdym razem, jakby był to jakiś obcy mi żart. Grand-mère. Babcia.",shape=box,color=blue];
		j2226937606 -> j2931315580;
	j2931315580 [label="Nie jest żoną le Cardinal, vrai ?",shape=box,color=blue];
		j2931315580 -> j304160643;
	j304160643 [label="Nie, to matka Ojca. Teściowa matki.",shape=box,color=red];
		j304160643 -> j803303442;
	j803303442 [label="Je... vois. Więc... dlaczego nie używają swoich imion ? Ne serait-ce pas plus simple ?",shape=box,color=blue];
		j803303442 -> j367030842;
		j803303442 -> j1886930272;
	j367030842 [label="Chcesz poznać historię ze wszystkimi szczegółami?",shape=box,color=red];
		j367030842 -> j72575331;
	j1886930272 [label="Nie będę wnikać w zbędne szczegóły.",shape=box,color=red];
		j1886930272 -> j969565751;
	j72575331 [label="Oui ! Przez dłuższy czas nigdzie nie wychodzę.",shape=box,color=blue];
		j72575331 -> j3575954831;
	j969565751 [label="Rodzina na górze została tu uwięziona po upadku imperium Orokin. Wnuk Entratiego uwolnił Plagę.",shape=box,color=red];
		j969565751 -> j2000992446;
	j3575954831 [label="Znajdujemy się obecnie na księżycu, Deimosie. Dawno temu zdetonowano tu biologiczną bombę w desperackiej próbie odparcia ataku Świadomych.",shape=box,color=red];
		j3575954831 -> j658195779;
	j2000992446 [label="Par Sol ! Umyślnie ?",shape=box,color=blue];
		j2000992446 -> j2060196651;
	j658195779 [label="Świadomi ? Z którymi Orokin toczyli wojnę dawno temu ? Ci, których widzieliśmy w Ciemnym Refraktorium wraz z diabłem, non ?",shape=box,color=blue];
		j658195779 -> j171254082;
	j2060196651 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j2060196651 -> j831430717 [label=true,color=green];
		j2060196651 -> j520673426 [label=true,color=green];
		j2060196651 -> j4255342777 [label=false,color=brown];
	j171254082 [label="Tak, próbowali wykorzystać Plagę do walki ze Świadomymi, ale przejęła ona Deimosa. Zamknęli się w Nekralisku - który znajduje się nad nami - żeby się przed nimi uchronić.",shape=box,color=red];
		j171254082 -> j2161922118;
	j831430717 [label="Nie, myślę, że to był wypadek. Uważam, że miał dobre intencje.",shape=box,color=red];
		j831430717 -> j894332841;
	j520673426 [label="Ciężko powiedzieć. Zaczekam z osądem, aż poznam całą prawdę.",shape=box,color=red];
		j520673426 -> j894332841;
	j4255342777 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j4255342777 -> j831430717 [label=true,color=green];
		j4255342777 -> j520673426 [label=true,color=green];
		j4255342777 -> j520673426 [label=false,color=brown];
		j4255342777 -> j2183595707 [label=false,color=brown];
	j2161922118 [label="Syn, wnuk Entratiego, obrał sobie za cel ocalenie i zbadanie zakażonych zwierząt.",shape=box,color=red];
		j2161922118 -> j1509378739;
	j894332841 [label="+10 Chemistry",color=orange];
		j894332841 -> j1631938957;
	j2183595707 [label="Nie znam jeszcze całej prawdy, ale mogę z pewnością powiedzieć, że jest bardzo arogancki.",shape=box,color=red];
		j2183595707 -> j414336314;
	j1509378739 [label="Och, na Sol... czy miał dobre intencje ?",shape=box,color=blue];
		j1509378739 -> j616297335;
	j1631938957 [label="To bardzo miłe z Twojej strony. Continuez, s'il vous plaît.",shape=box,color=blue];
		j1631938957 -> j1965929143;
	j414336314 [label="Wstyd. Mam nadzieję, że to nie prawda, dla dobra jego i naszego. Proszę, kontynuuj.",shape=box,color=blue];
		j414336314 -> j1965929143;
	j616297335 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j616297335 -> j3779573781 [label=true,color=green];
		j616297335 -> j2126839723 [label=true,color=green];
		j616297335 -> j2352187592 [label=true,color=green];
		j616297335 -> j3220361227 [label=false,color=brown];
	j1965929143 [label="Tak więc, będąc uwięzionymi w Nekralisku, pogrążenie w smutku, bez imperium Orokin, które mogło by ich uratować i z Plagą dobijającą się do drzwi...",shape=box,color=red];
		j1965929143 -> j644808621;
	j3779573781 [label="Tak, myślę, że tak. Myślę, że szczerze zależy mu na tych zwierzętach.",shape=box,color=red];
		j3779573781 -> j2552801520;
	j2126839723 [label="Niestety, to nie miało znaczenia. Nawet niechcący wyrządził wiele szkód.",shape=box,color=red];
		j2126839723 -> j410531805;
	j2352187592 [label="Nie, kierowała nim arogancja, nawet jeśli zarzeka się, że to był wypadek.",shape=box,color=red];
		j2352187592 -> j414336314;
	j3220361227 [label="Check boolean nil",color=orange];
		j3220361227 -> j3779573781 [label=true,color=green];
		j3220361227 -> j2126839723 [label=true,color=green];
		j3220361227 -> j2352187592 [label=true,color=green];
		j3220361227 -> j3779573781 [label=false,color=brown];
		j3220361227 -> j2126839723 [label=false,color=brown];
		j3220361227 -> j106998136 [label=false,color=brown];
	j644808621 [label="Rzucili się sobie do gardeł. Zniszczyli siebie od środka, a resztą zajęła się Plaga, zabierając im nawet ich własne imiona. ",shape=box,color=red];
		j644808621 -> j4029798767;
	j2552801520 [label="+10 Chemistry",color=orange];
		j2552801520 -> j3727798521;
	j410531805 [label="+5 Chemistry",color=orange];
		j410531805 -> j2460557515;
	j106998136 [label="Nie znam jeszcze całej prawdy, ale mogę z pewnością powiedzieć, że jest bardzo arogancki.",shape=box,color=red];
		j106998136 -> j414336314;
	j4029798767 [label="To ostateczne okrucieństwo, pozbawić kogoś imienia...",shape=box,color=blue];
		j4029798767 -> j482800561;
	j3727798521 [label="Zastanawiam się, co powiedziałby o Cavii... jaka szkoda, ze nie może ich poznać...",shape=box,color=blue];
		j3727798521 -> j659198083;
		j3727798521 -> j2640147516;
	j2460557515 [label="Gdyby znaczenie miała tylko czystość intencji, świat byłby pięknym miejscem, non ? C'est la vie.",shape=box,color=blue];
		j2460557515 -> j2414832168;
	j482800561 [label="Boolean MarieFamily2 is now true.",color=orange];
		j482800561 -> j3707438369;
		j482800561 -> j2218580087;
		j482800561 -> j3188154873;
	j659198083 [label="Bawi mnie ta myśl, ale to nie jest dobry pomysł.",shape=box,color=red];
		j659198083 -> j4278585798;
	j2640147516 [label="Mam nadzieję, że kiedyś do tego dojdzie.",shape=box,color=red];
		j2640147516 -> j3948333923;
	j2414832168 [label="Et ensuite ?",shape=box,color=blue];
		j2414832168 -> j1965929143;
	j3707438369 [label="Chyba, że oddasz je dobrowolnie, jak Babcia.",shape=box,color=red];
		j3707438369 -> j599301182;
	j2218580087 [label="To nie jest takie złe, można się przyzwyczaić.",shape=box,color=red];
		j2218580087 -> j2573061122;
	j3188154873 [label="Zwierzęta nie mają imion i im to nie przeszkadza. To my nadajemy im imiona z własnych pobudek.",shape=box,color=red];
		j3188154873 -> j3080680272;
	j4278585798 [label="Dlaczego ?",shape=box,color=blue];
		j4278585798 -> j2416525361;
		j4278585798 -> j1077921148;
	j3948333923 [label="Add 1 to Family counter",color=orange];
		j3948333923 -> j2139319721;
	j599301182 [label="+5 Chemistry",color=orange];
		j599301182 -> j4187988237;
	j2573061122 [label="Aach ! Quelle horreur ! Nie o to mi chodziło ! Jak mi głupio ! Przepraszam, wybacz mi, nie to miałam na myśli - och, jestem durna !",shape=box,color=blue];
		j2573061122 -> j3019077881;
		j2573061122 -> j3467218176;
	j3080680272 [label="+5 Chemistry",color=orange];
		j3080680272 -> j4117855825;
	j2416525361 [label="Obawiam się, że połowa z nich uzna drugą za \"drugą rodzinę\".",shape=box,color=red];
		j2416525361 -> j2305623091;
	j1077921148 [label="Sytuacja na górze jest... delikatna. Nie chcę ich denerwować.",shape=box,color=red];
		j1077921148 -> j2021966454;
	j2139319721 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j2139319721 -> j2898611211 [label=true,color=green];
		j2139319721 -> j1740816331 [label=false,color=brown];
	j4187988237 [label="Brzmi jak kobieta, którą pragnęłabym poznać... ",shape=box,color=blue];
		j4187988237 -> j3989609608;
	j3019077881 [label="I jak mi to wynagrodzisz?",shape=box,color=red];
		j3019077881 -> j2242545429;
	j3467218176 [label="Nie przejmuj się, tylko się wygłupiam. Nie przeszkadza mi to.",shape=box,color=red];
		j3467218176 -> j3605837899;
	j4117855825 [label="To prawda ! Nigdy tak nie pomyślałam. A Ty możesz wybrać sobie każde, jakie chcesz. Na swój sposób, to nieskrępowana wolność.",shape=box,color=blue];
		j4117855825 -> j3989609608;
	j2305623091 [label="Add 1 to Family counter",color=orange];
		j2305623091 -> j1162749912;
	j2021966454 [label="Zdziwiłbyś się, jak wytrwała potrafi być dusza. Ci, którzy mnie otaczają, są już bardzo starzy i zahartowani przez życie.",shape=box,color=blue];
		j2021966454 -> j420131882;
	j2898611211 [label="To jest osiągalne. Może nawet łatwiej, niż się spodziewać. Musimy się tylko zastanowić. ",shape=box,color=blue];
		j2898611211 -> j2098658775;
		j2898611211 -> j1077921148;
	j1740816331 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j1740816331 -> j2898611211 [label=true,color=green];
		j1740816331 -> j593913495 [label=false,color=brown];
	j3989609608 [label="To była wspaniała rozmowa, ale obawiam się, że nadeszła moja kolej na podanie obiadu. Monsieur Loid przyucza mnie, jak prawidłowo podać herbatę w jego stylu !",shape=box,color=blue];
		j3989609608 -> "Chat ends.";
	j2242545429 [label="Maintenant, vous parlez aussi mal que le diable. Nie, nie wpadnę w Twoje sidła.",shape=box,color=blue];
		j2242545429 -> "Chat ends.";
	j3605837899 [label="+5 Chemistry",color=orange];
		j3605837899 -> j3109477225;
	j1162749912 [label="+5 Chemistry",color=orange];
		j1162749912 -> j2104411907;
	j420131882 [label="+5 Chemistry",color=orange];
		j420131882 -> j2347773467;
	j2098658775 [label="Musimy być ostrożni. Obawiam się, że połowa z nich uzna drugą za \"drugą rodzinę\".",shape=box,color=red];
		j2098658775 -> j2305623091;
	j593913495 [label="Oui ? A jak radzisz sobie z nimi Ty, albo votre copie minuscule ?",shape=box,color=blue];
		j593913495 -> j633546813;
		j593913495 -> j1077921148;
	j3109477225 [label="Och, loué soit Sol ! Ale nasuwa to pytanie... Czy wiesz, skąd wzięła się Twoja nazwa ? \"Le Włóczęga\" ?",shape=box,color=blue];
		j3109477225 -> j1183346797;
		j3109477225 -> j4042565341;
	j2104411907 [label="Och... Par Sol ! To może być rozwiązanie !",shape=box,color=blue];
		j2104411907 -> j704290080;
	j2347773467 [label="Zaskoczyłeś ich wiele razy. Pozwól, by oni zaskoczyli Cię ten jeden raz.",shape=box,color=blue];
		j2347773467 -> j3645150988;
	j633546813 [label="Powoli. Ostrożnie. Musimy być ostrożni. Obawiam się, że połowa z nich uzna drugą za \"drugą rodzinę\".",shape=box,color=red];
		j633546813 -> j2305623091;
	j1183346797 [label="Mam nadzieję, sam je wybrałem.",shape=box,color=red];
		j1183346797 -> j3084175049;
	j4042565341 [label="Szczerze, nie pamiętam.",shape=box,color=red];
		j4042565341 -> j2641328368;
	j704290080 [label="Boolean MarieFamilyOther is now true.",color=orange];
		j704290080 -> j3423932479;
	j3645150988 [label="Ale proszę, nie przerywaj tej opowieści, s'il vous plaît. Twój młody wilk, Maria, musi poznać swoją zwierzynę, zanim wyruszy na łowy, oui ?",shape=box,color=blue];
		j3645150988 -> j214696579;
		j3645150988 -> j3971353496;
		j3645150988 -> j2463619219;
	j3084175049 [label="Jakież to by było wyzwalające ! Wybrać swoje własne imię. W le Cathédrale nie mogłam nawet wybrać własnych ubrań. Haha !",shape=box,color=blue];
		j3084175049 -> j3989609608;
	j2641328368 [label="Nosisz ze sobą tak wiele zagadek ! ",shape=box,color=blue];
		j2641328368 -> j3989609608;
	j3423932479 [label="Jestem tak podekscytowana — je suis assise ici, remuant sur ma chaise !",shape=box,color=blue];
		j3423932479 -> j3645150988;
	j214696579 [label="O czym mówiłem?",shape=box,color=red];
		j214696579 -> j979851693;
	j3971353496 [label="To trochę nie w Twoim stylu, nie sądzisz?",shape=box,color=red];
		j3971353496 -> j1337991762;
	j2463619219 [label="A może chciałbym, żebyś na mnie zapolowała...",shape=box,color=red];
		j2463619219 -> j781712870;
	j979851693 [label="Syn za bardzo zbliżył się do Animaux Infestés.",shape=box,color=blue];
		j979851693 -> j1965929143;
	j1337991762 [label="Peut-être ! Ale odrobina psot w imię większego dobra jeszcze nikomu nie zaszkodziła, hmm ?",shape=box,color=blue];
		j1337991762 -> j2145659092;
		j1337991762 -> j3735117449;
	j781712870 [label="Boolean DrifterMarie is now true.",color=orange];
		j781712870 -> j2844898476;
	j2145659092 [label="Ach, tak... Wracając do opowieści.",shape=box,color=red];
		j2145659092 -> j1965929143;
	j3735117449 [label="Nie zrozum mnie źle, podobało mi się to.",shape=box,color=red];
		j3735117449 -> j4242891107;
	j2844898476 [label="Będziesz moją zgubą ! Pisnęłam głośno i zaniepokoiłam Monsieur Loida. Musiałam kłamać, że ujrzałam mysz, tylko po to, żeby dowiedzieć się, że w tych czasach nie ma myszy !",shape=box,color=blue];
		j2844898476 -> j2616478708;
	j4242891107 [label="Haha ! Spodziewałam się tego. Teraz dość tych psot i wracamy do Twojej opowieści. Syn za bardzo zbliżył się do Animaux Infestés, oui ?",shape=box,color=blue];
		j4242891107 -> j1965929143;
	j2616478708 [label="+5 Chemistry",color=orange];
		j2616478708 -> j2189726668;
	j2189726668 [label="Quelle méchanceté, tu es terrible ! Je te déteste et tu me fais rougir maintenant !",shape=box,color=blue];
		j2189726668 -> j3906435281;
		j2189726668 -> j3834977281;
	j3906435281 [label="Zdenerwowałaś się na mnie?",shape=box,color=red];
		j3906435281 -> j2782304511;
	j3834977281 [label="No tak... wracając do tematu...",shape=box,color=red];
		j3834977281 -> j1965929143;
	j2782304511 [label="Non ! Wróć do tematu !",shape=box,color=blue];
		j2782304511 -> j1965929143;
}