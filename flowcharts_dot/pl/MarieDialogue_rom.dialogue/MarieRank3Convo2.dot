digraph {
	1015 [label="MarieRank3Convo2 begins.",color=orange];
		1015 -> 3736;
	3736 [label="Update boolean MarieLyonAvailable",color=orange];
		3736 -> 2923;
	2923 [label="Check boolean LoidFamilyComplete",color=orange];
		2923 -> 2924 [label=true,color=green];
		2923 -> 1016 [label=false,color=brown];
	2924 [label="Mam nadzieję, że nie zrozumiesz tego źle... ale mam dziwne przeczucie, że robiliśmy to już wcześniej ?",shape=box,color=blue];
		2924 -> 2925;
	1016 [label="Check boolean MarieFamily1",color=orange];
		1016 -> 1017 [label=true,color=green];
		1016 -> 1018 [label=false,color=brown];
	2925 [label="Odbyliśmy te rozmowy... poznaliśmy tych ludzi... ale to niemożliwe, non ?",shape=box,color=blue];
		2925 -> 2926;
	1017 [label="Opowiesz mi więcej o la familie du Cardinal ? Jestem zafascynowana jego przeszłością.",shape=box,color=blue];
		1017 -> 1020;
		1017 -> 1021;
		1017 -> 1019;
	1018 [label="Opowiesz mi o la familie du Cardinal ? Jestem zafascynowana jego przeszłością.",shape=box,color=blue];
		1018 -> 1020;
		1018 -> 1021;
		1018 -> 1019;
	2926 [label="+20 Chemistry",color=orange];
		2926 -> 2927;
	1020 [label="Powiem, co wiem, ale obawiam się, że to może być mniej, niż się spodziewasz.",shape=box,color=red];
		1020 -> 1023;
	1021 [label="Oczywiście, ale... czy nie lepiej byłoby, gdybyś porozmawiała o tym z Loidem?",shape=box,color=red];
		1021 -> 1024;
	1019 [label="[Koniec]",shape=box,color=red];
		1019 -> 1022;
	2927 [label="Nazywamy to déjà vu. To pewnie przez sérum i podróże w czasie. C'est la vie !",shape=box,color=blue];
		2927 -> 2928;
	1023 [label="Czymkolwiek się ze mną podzielisz, będzie na wagę złota. Promis !",shape=box,color=blue];
		1023 -> 1025;
	1024 [label="A skoro mowa o le Cardinal... wzmianka o nim zdaje się sprawiać Monsieur Loidowi wiele bólu. Nie lubię tego robić.",shape=box,color=blue];
		1024 -> 1025;
	1022 [label="Chat ends.",color=orange];
	2928 [label="Chat ends.",color=orange];
	1025 [label="Zwłaszcza, że robię to avec une certaine joie, w czym wydaję się być odosobniona.",shape=box,color=blue];
		1025 -> 1026;
		1025 -> 1027;
	1026 [label="Czego chciałabyś się dowiedzieć?",shape=box,color=red];
		1026 -> 1028;
	1027 [label="Cóż, Matka, Ojciec, Son, Córka i Babcia czekają na górze.",shape=box,color=red];
		1027 -> 1028;
	1028 [label="Ustalmy najpierw jedną rzecz, dobrze ? Diabeł śmieje się ze mnie za każdym razem, jakby był to jakiś obcy mi żart. Grand-mère. Babcia.",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="Nie jest żoną le Cardinal, vrai ?",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="Nie, to matka Ojca. Teściowa matki.",shape=box,color=red];
		1030 -> 1031;
	1031 [label="Je... vois. Więc... dlaczego nie używają swoich imion ? Ne serait-ce pas plus simple ?",shape=box,color=blue];
		1031 -> 1032;
		1031 -> 1033;
	1032 [label="Chcesz poznać historię ze wszystkimi szczegółami?",shape=box,color=red];
		1032 -> 1034;
	1033 [label="Nie będę wnikać w zbędne szczegóły.",shape=box,color=red];
		1033 -> 1035;
	1034 [label="Oui ! Przez dłuższy czas nigdzie nie wychodzę.",shape=box,color=blue];
		1034 -> 1036;
	1035 [label="Rodzina na górze została tu uwięziona po upadku imperium Orokin. Wnuk Entratiego uwolnił Plagę.",shape=box,color=red];
		1035 -> 1037;
	1036 [label="Znajdujemy się obecnie na księżycu, Deimosie. Dawno temu zdetonowano tu biologiczną bombę w desperackiej próbie odparcia ataku Świadomych.",shape=box,color=red];
		1036 -> 1038;
	1037 [label="Par Sol ! Umyślnie ?",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="Świadomi ? Z którymi Orokin toczyli wojnę dawno temu ? Ci, których widzieliśmy w Ciemnym Refraktorium wraz z diabłem, non ?",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1039 -> 1041 [label=true,color=green];
		1039 -> 1042 [label=true,color=green];
		1039 -> 1042 [label=false,color=brown];
		1039 -> 1043 [label=false,color=brown];
	1040 [label="Tak, próbowali wykorzystać Plagę do walki ze Świadomymi, ale przejęła ona Deimosa. Zamknęli się w Nekralisku - który znajduje się nad nami - żeby się przed nimi uchronić.",shape=box,color=red];
		1040 -> 1044;
	1041 [label="Nie, myślę, że to był wypadek. Uważam, że miał dobre intencje.",shape=box,color=red];
		1041 -> 1045;
	1042 [label="Ciężko powiedzieć. Zaczekam z osądem, aż poznam całą prawdę.",shape=box,color=red];
		1042 -> 1045;
	1043 [label="Nie znam jeszcze całej prawdy, ale mogę z pewnością powiedzieć, że jest bardzo arogancki.",shape=box,color=red];
		1043 -> 1046;
	1044 [label="Syn, wnuk Entratiego, obrał sobie za cel ocalenie i zbadanie zakażonych zwierząt.",shape=box,color=red];
		1044 -> 1047;
	1045 [label="+10 Chemistry",color=orange];
		1045 -> 1048;
	1046 [label="Wstyd. Mam nadzieję, że to nie prawda, dla dobra jego i naszego. Proszę, kontynuuj.",shape=box,color=blue];
		1046 -> 1049;
	1047 [label="Och, na Sol... czy miał dobre intencje ?",shape=box,color=blue];
		1047 -> 1076;
	1048 [label="To bardzo miłe z Twojej strony. Continuez, s'il vous plaît.",shape=box,color=blue];
		1048 -> 1049;
	1049 [label="Tak więc, będąc uwięzionymi w Nekralisku, pogrążenie w smutku, bez imperium Orokin, które mogło by ich uratować i z Plagą dobijającą się do drzwi...",shape=box,color=red];
		1049 -> 1053;
	1076 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1076 -> 1051 [label=true,color=green];
		1076 -> 1052 [label=true,color=green];
		1076 -> 1055 [label=true,color=green];
		1076 -> 1051 [label=false,color=brown];
		1076 -> 1052 [label=false,color=brown];
		1076 -> 1054 [label=false,color=brown];
	1053 [label="Rzucili się sobie do gardeł. Zniszczyli siebie od środka, a resztą zajęła się Plaga, zabierając im nawet ich własne imiona. ",shape=box,color=red];
		1053 -> 1058;
	1051 [label="Tak, myślę, że tak. Myślę, że szczerze zależy mu na tych zwierzętach.",shape=box,color=red];
		1051 -> 1056;
	1052 [label="Niestety, to nie miało znaczenia. Nawet niechcący wyrządził wiele szkód.",shape=box,color=red];
		1052 -> 1057;
	1055 [label="Nie, kierowała nim arogancja, nawet jeśli zarzeka się, że to był wypadek.",shape=box,color=red];
		1055 -> 1059;
	1054 [label="Nie znam jeszcze całej prawdy, ale mogę z pewnością powiedzieć, że jest bardzo arogancki.",shape=box,color=red];
		1054 -> 1059;
	1058 [label="To ostateczne okrucieństwo, pozbawić kogoś imienia...",shape=box,color=blue];
		1058 -> 1062;
	1056 [label="+10 Chemistry",color=orange];
		1056 -> 1060;
	1057 [label="+5 Chemistry",color=orange];
		1057 -> 1061;
	1059 [label="Wstyd. Mam nadzieję, że to nie prawda, dla dobra jego i naszego. Proszę, kontynuuj.",shape=box,color=blue];
		1059 -> 1049;
	1062 [label="Update boolean MarieFamily2",color=orange];
		1062 -> 1066;
		1062 -> 1067;
		1062 -> 1068;
	1060 [label="Zastanawiam się, co powiedziałby o Cavii... jaka szkoda, ze nie może ich poznać...",shape=box,color=blue];
		1060 -> 1063;
		1060 -> 1064;
	1061 [label="Gdyby znaczenie miała tylko czystość intencji, świat byłby pięknym miejscem, non ? C'est la vie.",shape=box,color=blue];
		1061 -> 1065;
	1066 [label="Chyba, że oddasz je dobrowolnie, jak Babcia.",shape=box,color=red];
		1066 -> 1071;
	1067 [label="To nie jest takie złe, można się przyzwyczaić.",shape=box,color=red];
		1067 -> 1072;
	1068 [label="Zwierzęta nie mają imion i im to nie przeszkadza. To my nadajemy im imiona z własnych pobudek.",shape=box,color=red];
		1068 -> 1073;
	1063 [label="Bawi mnie ta myśl, ale to nie jest dobry pomysł.",shape=box,color=red];
		1063 -> 1069;
	1064 [label="Mam nadzieję, że kiedyś do tego dojdzie.",shape=box,color=red];
		1064 -> 1070;
	1065 [label="Et ensuite ?",shape=box,color=blue];
		1065 -> 1049;
	1071 [label="+5 Chemistry",color=orange];
		1071 -> 1077;
	1072 [label="Aach ! Quelle horreur ! Nie o to mi chodziło ! Jak mi głupio ! Przepraszam, wybacz mi, nie to miałam na myśli - och, jestem durna !",shape=box,color=blue];
		1072 -> 1078;
		1072 -> 1079;
	1073 [label="+5 Chemistry",color=orange];
		1073 -> 1080;
	1069 [label="Dlaczego ?",shape=box,color=blue];
		1069 -> 1074;
		1069 -> 1075;
	1070 [label="Add 1 to Family",color=orange];
		1070 -> 1050;
	1077 [label="Brzmi jak kobieta, którą pragnęłabym poznać... ",shape=box,color=blue];
		1077 -> 1085;
	1078 [label="I jak mi to wynagrodzisz?",shape=box,color=red];
		1078 -> 1086;
	1079 [label="Nie przejmuj się, tylko się wygłupiam. Nie przeszkadza mi to.",shape=box,color=red];
		1079 -> 1087;
	1080 [label="To prawda ! Nigdy tak nie pomyślałam. A Ty możesz wybrać sobie każde, jakie chcesz. Na swój sposób, to nieskrępowana wolność.",shape=box,color=blue];
		1080 -> 1085;
	1074 [label="Obawiam się, że połowa z nich uzna drugą za \"drugą rodzinę\".",shape=box,color=red];
		1074 -> 1081;
	1075 [label="Sytuacja na górze jest... delikatna. Nie chcę ich denerwować.",shape=box,color=red];
		1075 -> 1082;
	1050 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1050 -> 1083 [label=true,color=green];
		1050 -> 1084 [label=false,color=brown];
	1085 [label="To była wspaniała rozmowa, ale obawiam się, że nadeszła moja kolej na podanie obiadu. Monsieur Loid przyucza mnie, jak prawidłowo podać herbatę w jego stylu !",shape=box,color=blue];
		1085 -> 1094;
	1086 [label="Maintenant, vous parlez aussi mal que le diable. Nie, nie wpadnę w Twoje sidła.",shape=box,color=blue];
		1086 -> 1095;
	1087 [label="+5 Chemistry",color=orange];
		1087 -> 1096;
	1081 [label="Add 1 to Family",color=orange];
		1081 -> 1088;
	1082 [label="Zdziwiłbyś się, jak wytrwała potrafi być dusza. Ci, którzy mnie otaczają, są już bardzo starzy i zahartowani przez życie.",shape=box,color=blue];
		1082 -> 1089;
	1083 [label="To jest osiągalne. Może nawet łatwiej, niż się spodziewać. Musimy się tylko zastanowić. ",shape=box,color=blue];
		1083 -> 1090;
		1083 -> 1091;
	1084 [label="Oui ? A jak radzisz sobie z nimi Ty, albo votre copie minuscule ?",shape=box,color=blue];
		1084 -> 1092;
		1084 -> 1093;
	1094 [label="Chat ends.",color=orange];
	1095 [label="Chat ends.",color=orange];
	1096 [label="Och, loué soit Sol ! Ale nasuwa to pytanie... Czy wiesz, skąd wzięła się Twoja nazwa ? \"Le Włóczęga\" ?",shape=box,color=blue];
		1096 -> 1099;
		1096 -> 1100;
	1088 [label="+5 Chemistry",color=orange];
		1088 -> 1097;
	1089 [label="+5 Chemistry",color=orange];
		1089 -> 1098;
	1090 [label="Musimy być ostrożni. Obawiam się, że połowa z nich uzna drugą za \"drugą rodzinę\".",shape=box,color=red];
		1090 -> 1081;
	1091 [label="Sytuacja na górze jest... delikatna. Nie chcę ich denerwować.",shape=box,color=red];
		1091 -> 1082;
	1092 [label="Powoli. Ostrożnie. Musimy być ostrożni. Obawiam się, że połowa z nich uzna drugą za \"drugą rodzinę\".",shape=box,color=red];
		1092 -> 1081;
	1093 [label="Sytuacja na górze jest... delikatna. Nie chcę ich denerwować.",shape=box,color=red];
		1093 -> 1082;
	1099 [label="Mam nadzieję, sam je wybrałem.",shape=box,color=red];
		1099 -> 1103;
	1100 [label="Szczerze, nie pamiętam.",shape=box,color=red];
		1100 -> 1104;
	1097 [label="Och... Par Sol ! To może być rozwiązanie !",shape=box,color=blue];
		1097 -> 1101;
	1098 [label="Zaskoczyłeś ich wiele razy. Pozwól, by oni zaskoczyli Cię ten jeden raz.",shape=box,color=blue];
		1098 -> 1102;
	1103 [label="Jakież to by było wyzwalające ! Wybrać swoje własne imię. W le Cathédrale nie mogłam nawet wybrać własnych ubrań. Haha !",shape=box,color=blue];
		1103 -> 1085;
	1104 [label="Nosisz ze sobą tak wiele zagadek ! ",shape=box,color=blue];
		1104 -> 1085;
	1101 [label="Update boolean MarieFamilyOther",color=orange];
		1101 -> 1105;
	1102 [label="Ale proszę, nie przerywaj tej opowieści, s'il vous plaît. Twój młody wilk, Maria, musi poznać swoją zwierzynę, zanim wyruszy na łowy, oui ?",shape=box,color=blue];
		1102 -> 1106;
		1102 -> 1107;
		1102 -> 3914;
	1105 [label="Jestem tak podekscytowana — je suis assise ici, remuant sur ma chaise !",shape=box,color=blue];
		1105 -> 1102;
	1106 [label="O czym mówiłem?",shape=box,color=red];
		1106 -> 1108;
	1107 [label="To trochę nie w Twoim stylu, nie sądzisz?",shape=box,color=red];
		1107 -> 1109;
	3914 [label="A może chciałbym, żebyś na mnie zapolowała...",shape=box,color=red];
		3914 -> 3915;
	1108 [label="Syn za bardzo zbliżył się do Animaux Infestés.",shape=box,color=blue];
		1108 -> 1049;
	1109 [label="Peut-être ! Ale odrobina psot w imię większego dobra jeszcze nikomu nie zaszkodziła, hmm ?",shape=box,color=blue];
		1109 -> 1110;
		1109 -> 1111;
	3915 [label="Update boolean DrifterMarie",color=orange];
		3915 -> 3913;
	1110 [label="Ach, tak... Wracając do opowieści.",shape=box,color=red];
		1110 -> 1049;
	1111 [label="Nie zrozum mnie źle, podobało mi się to.",shape=box,color=red];
		1111 -> 1112;
	3913 [label="Będziesz moją zgubą ! Pisnęłam głośno i zaniepokoiłam Monsieur Loida. Musiałam kłamać, że ujrzałam mysz, tylko po to, żeby dowiedzieć się, że w tych czasach nie ma myszy !",shape=box,color=blue];
		3913 -> 3916;
	1112 [label="Haha ! Spodziewałam się tego. Teraz dość tych psot i wracamy do Twojej opowieści. Syn za bardzo zbliżył się do Animaux Infestés, oui ?",shape=box,color=blue];
		1112 -> 1049;
	3916 [label="+5 Chemistry",color=orange];
		3916 -> 3917;
	3917 [label="Quelle méchanceté, tu es terrible ! Je te déteste et tu me fais rougir maintenant !",shape=box,color=blue];
		3917 -> 3918;
		3917 -> 3919;
	3918 [label="Zdenerwowałaś się na mnie?",shape=box,color=red];
		3918 -> 3920;
	3919 [label="No tak... wracając do tematu...",shape=box,color=red];
		3919 -> 1049;
	3920 [label="Non ! Wróć do tematu !",shape=box,color=blue];
		3920 -> 1049;
}