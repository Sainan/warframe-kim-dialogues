	2144 [label="+5 Chemistry",color=orange];
		2144 -> 2149;
	2152 [label="Powiedziałeś mi, że twoja wiara jest podobna do mojej, non ? Dlaczego ty wierzysz ?",shape=box,color=blue];
		2152 -> 2162;
		2152 -> 2163;
		2152 -> 2164;
		2152 -> 2165;
		2152 -> 2166;
	2153 [label="Powiedziałeś mi, że masz swoją wiarę, ale różni się od mojej, ale to nadal wiara. Dlaczego ty wierzysz ?",shape=box,color=blue];
		2153 -> 2162;
		2153 -> 2163;
		2153 -> 2164;
		2153 -> 2165;
		2153 -> 2166;
	2154 [label="Powiedziałeś mi, że wiara jest dla ciebie osobistą kwestią, tak jak une histoire twojego stworzenia, ale to nadal wiara. Dlaczego wierzysz ?",shape=box,color=blue];
		2154 -> 2162;
		2154 -> 2163;
