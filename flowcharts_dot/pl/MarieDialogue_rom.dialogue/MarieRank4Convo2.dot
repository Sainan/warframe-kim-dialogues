		j2560177332 -> j3161630341;
	j1928048887 [label="Zazdroszczę ! Większość z nas nie ma takiego szczęścia, by wskazać konkretne zdarzenie, oui ?",shape=box,color=blue];
		j1928048887 -> j2485297159;
	j2488208587 [label="Ach, więc nasze odpowiedzi są takie same. Nigdy nie doświadczyłam cudu, może oprócz przybycia le Cardinal do Cathédrale.",shape=box,color=blue];
