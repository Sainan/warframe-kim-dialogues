	j219424336 [label="Nie nazwałabyś serum Entratiego cudem?",shape=box,color=red];
		j219424336 -> j1312665363;
	j134856553 [label="A głosy w głowie Leona? Czy Obojętność?",shape=box,color=red];
		j134856553 -> j2666940274;
	j3405829930 [label="Och, uznanie mnie za głupią za wiarę w Świetlistych to najmilsze co można pomyśleć o osobie innej wiary.",shape=box,color=blue];
		j3405829930 -> j4269808117;
	j2770306190 [label="Diabeł powinien się obawiać ! Strzeż się, niegodziwcze ! Światło porazi cię z niebios !",shape=box,color=blue];
		j2770306190 -> j2718912295;
	j2999278110 [label="Non, non, non... Nie o to chciałeś zapytać, prawda? Ach !! Je vais lui faire bouffer un de ces livres !",shape=box,color=blue];
		j2999278110 -> j4284021791;
	j2286819776 [label="Marne ze mnie schronienie przed burzą Pustki, w której się znalazłeś.",shape=box,color=blue];
		j2286819776 -> j1525678156;
	j2556566610 [label="Nie wiem, co cię pokusiło, żeby opowiadać mi takie rzeczy. Ale cieszę się, że zdecydowałeś się powiedzieć mi prawdę.",shape=box,color=blue];
		j2556566610 -> j1624726522;
	j3275455590 [label="Och... nie musiałeś mówić mi takich rzeczy, żeby mnie poznać.",shape=box,color=blue];
		j3275455590 -> j1624726522;
	j1710072448 [label="To nadal dzieło człowieka. Ale wierzę, że to Sol doprowadził do skrzyżowania naszych dróg.",shape=box,color=blue];
		j1710072448 -> j3385111602;
