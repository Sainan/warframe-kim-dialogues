		j3940344509 -> j2960858520;
	j1903604028 [label="Oui, wiem, że mam szczęście. I to jest pokój, który łatwo narzucać innym — czy tego chcą, czy nie.",shape=box,color=blue];
		j1903604028 -> j3156178749;
	j2127562177 [label="Oui, wiele razy. I w takich chwilach zastanawiam się dlaczego. Może dlatego, że powinnam odnaleźć własną drogę, non ? Ou peut-être que je suis une folle après tout, haha ! Nie zawsze jest nam dane wiedzieć.",shape=box,color=blue];
		j2127562177 -> j3156178749;
	j3906331290 [label="Oui, modlę się, żebyś też znalazł swoją drogę. To nie jest coś, co można przekazać lub nauczyć, trzeba to odkryć.",shape=box,color=blue];
