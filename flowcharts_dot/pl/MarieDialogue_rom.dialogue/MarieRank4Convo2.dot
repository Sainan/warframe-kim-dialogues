		j210491709 -> j631276051;
		j210491709 -> j4034839128;
	j2524991792 [label="Oui ! Nie przepadam za ściętymi kwiatami. Jeśli chcesz mi coś podarować, modlę się, żeby nie były to róże w wazonie.",shape=box,color=blue];
		j2524991792 -> j4020042094;
