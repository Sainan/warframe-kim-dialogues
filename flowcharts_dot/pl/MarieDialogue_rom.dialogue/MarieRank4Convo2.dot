		2172 -> 2183 [label=false,color=brown];
	2173 [label="Oui ? Jestem ciekawa, dlaczego skłamałeś ?",shape=box,color=blue];
		2173 -> 2184;
		2173 -> 2185;
	2174 [label="Zazdroszczę ! Większość z nas nie ma takiego szczęścia, by wskazać konkretne zdarzenie, oui ?",shape=box,color=blue];
		2174 -> 2186;
	2175 [label="Ach, więc nasze odpowiedzi są takie same. Nigdy nie doświadczyłam cudu, może oprócz przybycia le Cardinal do Cathédrale.",shape=box,color=blue];
		2175 -> 2187;
	2176 [label="Check boolean DrifterFaithNoPeace",color=orange];
		2176 -> 2188 [label=true,color=green];
		2176 -> 2189 [label=false,color=brown];
	2179 [label="Non, od zawsze czułam, że w moim życiu była pewna... présence, która miała mnie kierować. Dobroczyńca, który uśmiecha się do mnie i wskazuje mi drogę. Nic więcej.",shape=box,color=blue];
		2179 -> 2191;
		2179 -> 2192;
	2177 [label="Szczerze? Tak. Ale nie chciałem mówić tego w taki sposób.",shape=box,color=red];
		2177 -> 2190;
	2178 [label="Zastanawiałem się raczej, czy była ku temu konkretna przyczyna.",shape=box,color=red];
		2178 -> 2168;
	2180 [label="Ja też nie ! Ale możliwości są nieograniczone !",shape=box,color=blue];
		2180 -> 2193;
	2181 [label="Peut-être ! Możliwości są teraz nieograniczone !",shape=box,color=blue];
		2181 -> 2193;
	3957 [label="Diabeł mi powiedział, że tak zrobisz.",shape=box,color=blue];
		3957 -> 3959;
