		j4006575493 -> j1327043602;
	j2901563448 [label="Podążać ścieżką w lesie, tylko dlatego, że wierzysz, że prowadzi cię do celu ?",shape=box,color=blue];
		j2901563448 -> j294922792;
	j2666940274 [label="Może tak być, nie wiem. Może diabeł ma racje i to wszystko jest dziełem nauki, której jeszcze nie rozumiemy. Te możliwości się nie wykluczają, non ?",shape=box,color=blue];
		j2666940274 -> j3385111602;
