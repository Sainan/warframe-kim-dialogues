		2150 -> 2164;
		2150 -> 2165;
		2150 -> 2166;
	2151 [label="Mogłabym zapytać cię o to samo z Lua, non ? Dlaczego w nią wierzysz ?",shape=box,color=blue];
		2151 -> 2162;
		2151 -> 2164;
		2151 -> 2165;
		2151 -> 2166;
		2151 -> 2163;
	2155 [label="Dlaczego właśnie Sol ? Zamiast Lua, albo równowaga, jakiej chcesz się trzymać ? To doskonałe pytanie. Dlaczego ty wierzysz ?",shape=box,color=blue];
		2155 -> 2162;
		2155 -> 2163;
		2155 -> 2164;
		2155 -> 2165;
		2155 -> 2166;
	2157 [label="Pytasz, co daje mi taką pewność ? Kiedy sam mówisz, że nie możemy być pewni wszechświata ?",shape=box,color=blue];
		2157 -> 2168;
	2156 [label="Rozumiem, że z perspektywy kogoś pozbawionego wiary, to może być dziwne, oui.",shape=box,color=blue];
		2156 -> 2167;
	2158 [label="Pytasz, co daje mi taką pewność ?",shape=box,color=blue];
		2158 -> 2168;
	2159 [label="Czy wiesz, co to oznacza ?!",shape=box,color=blue];
		2159 -> 2169;
		2159 -> 2170;
	3954 [label="Oui ! Nie przepadam za ściętymi kwiatami. Jeśli chcesz mi coś podarować, modlę się, żeby nie były to róże w wazonie.",shape=box,color=blue];
		3954 -> 3955;
		3954 -> 3956;
	2149 [label="Pour toi ? Bien sûr.",shape=box,color=blue];
		2149 -> 2160;
		2149 -> 2161;
	2162 [label="Myślę... że chyba z obowiązku.",shape=box,color=red];
		2162 -> 2172;
	2163 [label="Nie byłem całkowicie szczery, kiedy ci to powiedziałem.",shape=box,color=red];
		2163 -> 2173;
	2164 [label="Pewne doświadczenie odmieniło moje życie.",shape=box,color=red];
		2164 -> 2174;
	2165 [label="Nie stało się nic szczególnego, po prostu miałem poczucie, które kierowało moim życiem.",shape=box,color=red];
		2165 -> 2175;
	2166 [label="Chcę wierzyć, więc wierzę.",shape=box,color=red];
		2166 -> 2176;
	2168 [label="Obawiam się, że moja odpowiedź może cię rozczarować, wilku. Nie zdarzył się żaden wielki cud. Nie olśnił mnie żaden promień z nieba.",shape=box,color=blue];
		2168 -> 2179;
	2167 [label="\"Dlaczego ta rozsądna młoda kobieta wierzy w rzeczy, które moim zdaniem nie są prawdziwe, to wydaje się głupie\", non ?",shape=box,color=blue];
		2167 -> 2177;
		2167 -> 2178;
	2169 [label="Nie?",shape=box,color=red];
		2169 -> 2180;
	2170 [label="Powinienem się martwić?",shape=box,color=red];
		2170 -> 2181;
	3955 [label="Jak udało ci się zgadnąć, że o to mi chodziło? Niesamowite.",shape=box,color=red];
		3955 -> 3957;
	3956 [label="Nie to miałem na myśli, ale będę miał to na uwadze!",shape=box,color=red];
		3956 -> 3958;
	2160 [label="Dlaczego wierzysz w Sol ?",shape=box,color=red];
