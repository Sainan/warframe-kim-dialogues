		j4284021791 -> j1339822979;
		j4284021791 -> j386906797;
	j1525678156 [label="Ale zastanawiam się, czy nie znajdujesz się na rozdrożu i czy nie chciałbyś się zastanowić, w którą stronę pójść, non ?",shape=box,color=blue];
		j1525678156 -> j3044564126;
	j1624726522 [label="Dusza to więcej, niż wiara, którą obrała. Jestem une Sœur de Sol, ale mam nadzieję, że widzisz we mnie więcej niż tylko to, non ?",shape=box,color=blue];
		j1624726522 -> j1487953877;
	j3385111602 [label="I dlatego wierzę. Czuję obecność Sol obok mnie, kiedy docieram do miejsc, gdzie jestem najbardziej niepewna. Zamykam me oczy et il est là, prowadzi mnie.",shape=box,color=blue];
