	j2265777576 [label="Non, od zawsze czułam, że w moim życiu była pewna... présence, która miała mnie kierować. Dobroczyńca, który uśmiecha się do mnie i wskazuje mi drogę. Nic więcej.",shape=box,color=blue];
		j2265777576 -> j219424336;
		j2265777576 -> j134856553;
	j370456234 [label="Szczerze? Tak. Ale nie chciałem mówić tego w taki sposób.",shape=box,color=red];
		j370456234 -> j3405829930;
	j3191738419 [label="Zastanawiałem się raczej, czy była ku temu konkretna przyczyna.",shape=box,color=red];
		j3191738419 -> j1889961441;
	j3624649817 [label="Ja też nie ! Ale możliwości są nieograniczone !",shape=box,color=blue];
		j3624649817 -> j2770306190;
	j3657747205 [label="Peut-être ! Możliwości są teraz nieograniczone !",shape=box,color=blue];
		j3657747205 -> j2770306190;
	j2225103831 [label="Diabeł mi powiedział, że tak zrobisz.",shape=box,color=blue];
		j2225103831 -> j2999278110;
	j2137892143 [label="Och ! Przepraszam ! Wybacz mi ! O co chciałeś zapytać ? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		j2137892143 -> j1339822979;
		j2137892143 -> j386906797;
	j364808788 [label="I mówisz, że nie odnajdujesz w tym otuchy... to łamie mi serce.",shape=box,color=blue];
		j364808788 -> j148280334;
	j148280334 [label="Nie będę ci mówić, co masz robić. Nie wyznaczę dla ciebie drogi.",shape=box,color=blue];
		j148280334 -> j2286819776;
	j2119057287 [label="Szczerze, nie wiem. Działałem pod wpływem impulsu.",shape=box,color=red];
		j2119057287 -> j2556566610;
	j3161630341 [label="Myślałem, że dzięki temu lepiej cię zrozumiem...",shape=box,color=red];
		j3161630341 -> j3275455590;
	j2485297159 [label="Ale pytałeś mnie, dlaczego ja wierzę, a ja niegrzecznie przekierowałam tę rozmowę na ciebie, je m'excuse.",shape=box,color=blue];
		j2485297159 -> j1889961441;
	j1312665363 [label="Ale nawet to było dziełem człowieka i nauki, nie Świetlistych, non ? To sérum, które dało mi dar latania -",shape=box,color=blue];
		j1312665363 -> j1710072448;
	j1567966601 [label="Ale mówisz, że nie odnajdujesz w tym otuchy ? To łamie mi serce...",shape=box,color=blue];
		j1567966601 -> j4006575493;
