		3958 -> 2160;
		3958 -> 2161;
	2171 [label="Chat ends.",color=orange];
	2182 [label="I mówisz, że nie odnajdujesz w tym otuchy... to łamie mi serce.",shape=box,color=blue];
		2182 -> 2183;
	2183 [label="Nie będę ci mówić, co masz robić. Nie wyznaczę dla ciebie drogi.",shape=box,color=blue];
		2183 -> 2194;
	2184 [label="Szczerze, nie wiem. Działałem pod wpływem impulsu.",shape=box,color=red];
		2184 -> 2195;
	2185 [label="Myślałem, że dzięki temu lepiej cię zrozumiem...",shape=box,color=red];
		2185 -> 2196;
	2186 [label="Ale pytałeś mnie, dlaczego ja wierzę, a ja niegrzecznie przekierowałam tę rozmowę na ciebie, je m'excuse.",shape=box,color=blue];
		2186 -> 2168;
	2187 [label="Ale nawet to było dziełem człowieka i nauki, nie Świetlistych, non ? To sérum, które dało mi dar latania -",shape=box,color=blue];
		2187 -> 2197;
	2188 [label="Ale mówisz, że nie odnajdujesz w tym otuchy ? To łamie mi serce...",shape=box,color=blue];
		2188 -> 2198;
	2189 [label="Myślę, że twoja wiara jest najsilniejsza ze wszystkich, non ?",shape=box,color=blue];
		2189 -> 2199;
	2191 [label="Nie nazwałabyś serum Entratiego cudem?",shape=box,color=red];
		2191 -> 2187;
	2192 [label="Nawet głosy w głowie Leona? Ani Obojętność?",shape=box,color=red];
		2192 -> 2201;
	2190 [label="Och, uznanie mnie za głupią za wiarę w Świetlistych to najmilsze co można pomyśleć o osobie innej wiary.",shape=box,color=blue];
		2190 -> 2200;
	2193 [label="Diabeł powinien się obawiać ! Strzeż się, niegodziwcze ! Światło porazi cię z niebios !",shape=box,color=blue];
		2193 -> 2202;
	3959 [label="Non, non, non... Nie o to chciałeś zapytać, prawda? Ach !! Je vais lui faire bouffer un de ces livres !",shape=box,color=blue];
		3959 -> 3960;
	2194 [label="Marne ze mnie schronienie przed burzą Pustki, w której się znalazłeś.",shape=box,color=blue];
		2194 -> 2203;
	2195 [label="Nie wiem, co cię pokusiło, żeby opowiadać mi takie rzeczy. Ale cieszę się, że zdecydowałeś się powiedzieć mi prawdę.",shape=box,color=blue];
		2195 -> 2204;
	2196 [label="Och... nie musiałeś mówić mi takich rzeczy, żeby mnie poznać.",shape=box,color=blue];
		2196 -> 2204;
	2197 [label="To nadal dzieło człowieka. Ale wierzę, że to Sol doprowadził do skrzyżowania naszych dróg.",shape=box,color=blue];
		2197 -> 2205;
	2198 [label="Wydaje mi się, jakbyś błądził po lesie, szukając ścieżki, którą chciałbyś pójść.",shape=box,color=blue];
		2198 -> 2206;
	2199 [label="Podążać ścieżką w lesie, tylko dlatego, że wierzysz, że prowadzi cię do celu ?",shape=box,color=blue];
		2199 -> 2207;
	2201 [label="Może tak być, nie wiem. Może diabeł ma racje i to wszystko jest dziełem nauki, której jeszcze nie rozumiemy. Te możliwości się nie wykluczają, non ?",shape=box,color=blue];
		2201 -> 2205;
	2200 [label="Nie czuję się urażona i zawsze cieszy mnie twoja szczerość.",shape=box,color=blue];
		2200 -> 2168;
	2202 [label="+20 Chemistry",color=orange];
		2202 -> 2208;
	3960 [label="O co chciałeś zapytać ? Et maintenant, je suis mortifiée...",shape=box,color=blue];
		3960 -> 2160;
		3960 -> 2161;
	2203 [label="Ale zastanawiam się, czy nie znajdujesz się na rozdrożu i czy nie chciałbyś się zastanowić, w którą stronę pójść, non ?",shape=box,color=blue];
		2203 -> 2209;
	2204 [label="Dusza to więcej, niż wiara, którą obrała. Jestem une Sœur de Sol, ale mam nadzieję, że widzisz we mnie więcej niż tylko to, non ?",shape=box,color=blue];
		2204 -> 2210;
	2205 [label="I dlatego wierzę. Czuję obecność Sol obok mnie, kiedy docieram do miejsc, gdzie jestem najbardziej niepewna. Zamykam me oczy et il est là, prowadzi mnie.",shape=box,color=blue];
		2205 -> 2211;
		2205 -> 2212;
		2205 -> 2213;
	2206 [label="Nie wiem, czy kiedykolwiek ją odnajdziesz, ale pomodlę się o to. To, co odkryjesz na jej końcu może być un miracle.",shape=box,color=blue];
		2206 -> 2186;
	2207 [label="To piękne...",shape=box,color=blue];
		2207 -> 2186;
	2208 [label="Sainte Mère Sol, vous avez béni votre fille aujourd'hui ! HA-HA !!",shape=box,color=blue];
		2208 -> 2214;
	2209 [label="Obowiązek nie jest powodem do wiary. W najlepszym razie rodzi tylko wątpliwości, w najgorszym pogardę.",shape=box,color=blue];
		2209 -> 2215;
	2210 [label="Tematów, o których możemy porozmawiać, jest tyle ile gwiazd na niebie !",shape=box,color=blue];
		2210 -> 2216;
		2210 -> 2217;
	2211 [label="To piękne.",shape=box,color=red];
		2211 -> 2218;
	2212 [label="Czy kiedykolwiek poprowadził cię błędną ścieżką?",shape=box,color=red];
		2212 -> 2219;
	2213 [label="Chciałbym mieć w swoim życiu coś takiego...",shape=box,color=red];
		2213 -> 2220;
	2214 [label="Chat ends.",color=orange];
	2215 [label="Wiara powinna przynosić ukojenie dla duszy. Nie być kulą u nogi czy wymówką.",shape=box,color=blue];
		2215 -> 2221;
	2216 [label="Wybaczysz mi?",shape=box,color=red];
		2216 -> 2222;
	2217 [label="Przepraszam, głupio postąpiłem.",shape=box,color=red];
		2217 -> 2223;
	2218 [label="Oui, wiem, że mam szczęście. I to jest pokój, który łatwo narzucać innym — czy tego chcą, czy nie.",shape=box,color=blue];
		2218 -> 2224;
	2219 [label="Oui, wiele razy. I w takich chwilach zastanawiam się dlaczego. Może dlatego, że powinnam odnaleźć własną drogę, non ? Ou peut-être que je suis une folle après tout, haha ! Nie zawsze jest nam dane wiedzieć.",shape=box,color=blue];
		2219 -> 2224;
	2220 [label="Oui, modlę się, żebyś też znalazł swoją drogę. To nie jest coś, co można przekazać lub nauczyć, trzeba to odkryć.",shape=box,color=blue];
		2220 -> 2225;
	2221 [label="Update boolean DrifterCrossroads",color=orange];
		2221 -> 2186;
	2222 [label="Oui, wybaczam ci. Gdybyś był jak Leon, powiedziałabym, że pokutą jest dziesięć batów.",shape=box,color=blue];
		2222 -> 2226;
	2223 [label="Oui, i gdybyś był jak Leon, powiedziałabym, że pokutą jest dziesięć batów ! Ale nie jesteś. Więc spotka cię tylko przebaczenie.",shape=box,color=blue];
		2223 -> 2226;
	2224 [label="Ale dopóki moja wiara nie krzywdzi innych, nie ma w niej nic złego, oui ?",shape=box,color=blue];
		2224 -> 2227;
	2225 [label="W sobie, czy poza sobą, ścieżka każdego z nas jest inna.",shape=box,color=blue];
		2225 -> 2227;
