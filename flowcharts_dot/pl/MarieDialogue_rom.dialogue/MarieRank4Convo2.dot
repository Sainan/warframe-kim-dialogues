	j3648719684 [label="Pour toi ? Bien sûr.",shape=box,color=blue];
		j3648719684 -> j1339822979;
		j3648719684 -> j386906797;
	j2932480453 [label="Myślę... że chyba z obowiązku.",shape=box,color=red];
		j2932480453 -> j3222404579;
	j1798662691 [label="Nie byłem całkowicie szczery, kiedy ci to powiedziałem.",shape=box,color=red];
		j1798662691 -> j2560177332;
	j2430805113 [label="Pewne doświadczenie odmieniło moje życie.",shape=box,color=red];
		j2430805113 -> j1928048887;
	j3913128435 [label="Nie stało się nic szczególnego, po prostu miałem poczucie, które kierowało moim życiem.",shape=box,color=red];
		j3913128435 -> j2488208587;
	j2190358541 [label="Chcę wierzyć, więc wierzę.",shape=box,color=red];
		j2190358541 -> j3080931226;
	j1889961441 [label="Obawiam się, że moja odpowiedź może cię rozczarować, wilku. Nie zdarzył się żaden wielki cud. Nie olśnił mnie żaden promień z nieba.",shape=box,color=blue];
		j1889961441 -> j2265777576;
	j3391457112 [label="\"Dlaczego ta rozsądna młoda kobieta wierzy w rzeczy, które moim zdaniem nie są prawdziwe, to wydaje się głupie\", non ?",shape=box,color=blue];
		j3391457112 -> j370456234;
