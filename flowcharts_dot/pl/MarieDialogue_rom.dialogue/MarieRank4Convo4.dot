		2403 -> 2406;
	2404 [label="Dlatego jest taki wściekły. Dlatego nienawidzi Entratiego. Dlatego to nigdy się nie zmieni.",shape=box,color=red];
		2404 -> 2407;
	2405 [label="Wiem, że wierzysz, że robi to, co uważa za słuszne. I wiem, że wierzysz w przebaczenie. Ja też. Ale musisz zrozumieć, dlaczego niektórzy nie podzielają twojego stania. Przynajmniej na razie.",shape=box,color=red];
		2405 -> 2408;
	2406 [label="Są chwile, kiedy ludzie nie są w stanie wybaczyć tym, którzy ich skrzywdzili. Na pewno nie teraz, a może nigdy. ",shape=box,color=red];
		2406 -> 2409;
