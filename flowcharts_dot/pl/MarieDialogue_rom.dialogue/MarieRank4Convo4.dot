	2288 [label="Mario? Możemy porozmawiać?",shape=box,color=red];
		2288 -> 2292;
	2290 [label="Roathe opowiedział mi o... kłótni z Tagferem. Możemy o tym porozmawiać?",shape=box,color=red];
		2290 -> 2293;
	2291 [label="[Koniec]",shape=box,color=red];
		2291 -> 2294;
	2289 [label="Chat ends.",color=orange];
	2292 [label="Oui, chociaż mam podejrzenia, o czym chcesz porozmawiać... o moim niewłaściwym zachowaniu. Kto ci powiedział ?",shape=box,color=blue];
		2292 -> 2295;
		2292 -> 2296;
		2292 -> 2297;
	2293 [label="Bien sûr, ce salaud de diable ouvre sa bouche et vous raconte tout ! Il ne cherche qu'à m'embarrasser !",shape=box,color=blue];
		2293 -> 2298;
	2294 [label="Chat ends.",color=orange];
	2295 [label="To nie ma znaczenia.",shape=box,color=red];
		2295 -> 2299;
	2296 [label="Loid. ",shape=box,color=red];
		2296 -> 2300;
	2297 [label="Roathe.",shape=box,color=red];
		2297 -> 2293;
	2298 [label="Si je le pouvais, je prendrais ce couteau qu'il aime tant utiliser pour agacer les autres et je le fourrerais là où seule Lua peut le voir !",shape=box,color=blue];
		2298 -> 2301;
	2299 [label="Myślę, że ma, ale myślę też, że chcesz mi oszczędzić wstydu, więc... nie będę naciskać.",shape=box,color=blue];
		2299 -> 2302;
	2300 [label="Myślę, że kłamiesz, chcąc oszczędzić mi wstydu, ale... nie będę naciskać.",shape=box,color=blue];
		2300 -> 2302;
	2301 [label="Wybacz mi. To było... niestosowne. Jestem Sœur de Sol, nie mogę się tak zachowywać.",shape=box,color=blue];
		2301 -> 2303;
	2302 [label="+5 Chemistry",color=orange];
		2302 -> 2304;
	2303 [label="+5 Chemistry",color=orange];
		2303 -> 2305;
	2304 [label="Chcę zachować resztki swojej godności.",shape=box,color=blue];
		2304 -> 2306;
	2305 [label="Nie ty mnie zdenerwowałeś. Zawsze cieszy mnie twoja szczerość.",shape=box,color=blue];
		2305 -> 2307;
	2306 [label="Jeśli chcesz porozmawiać ze mną o kłótni, która miała miejsce z M'sieur Tagferem, nie zaprzeczę, że miała miejsce.",shape=box,color=blue];
		2306 -> 2307;
	2307 [label="Zakładam, że diabeł powiedział ci, czego dotyczyła ta sprzeczka?",shape=box,color=blue];
		2307 -> 2308;
	2308 [label="Evaluate expressions",color=orange];
		2308 -> 2310 [label="MarieTagferFight2a",color=purple];
		2308 -> 2311 [label="MarieTagferFight2a",color=purple];
		2308 -> 2309 [label="MarieTagferFight2b",color=purple];
		2308 -> 2310 [label="MarieTagferFight2b",color=purple];
		2308 -> 2310 [label="false",color=purple];
		2308 -> 2312 [label="false",color=purple];
	2310 [label="Nie musiał mi niczego mówić, mogłem się tego domyślić. Chodzi o Entratiego.",shape=box,color=red];
		2310 -> 2314;
	2311 [label="Powiedział mi. Ale wyglądał na bardziej zmartwionego tobą.",shape=box,color=red];
		2311 -> 2315;
	2309 [label="Tak. Martwi się tą sytuacją, bo zżył się z Cavią.",shape=box,color=red];
		2309 -> 2313;
	2312 [label="Nie, naprawdę. Powiedział mi, żebym sprawdził, co u ciebie.",shape=box,color=red];
		2312 -> 2316;
	2314 [label="Oui. Pokłóciłam się z M'sieur Tagferem o le Cardinal.",shape=box,color=blue];
		2314 -> 2318;
		2314 -> 2319;
	2315 [label="Nie wiem, dlaczego diabeł miałby kazać ci wierzyć w coś takiego. Ani czemu miałoby mu to służyć.",shape=box,color=blue];
		2315 -> 2320;
	2313 [label="Diabeł poznał trzy skrzywdzone zwierzęta i wie, że może z łatwością wykorzystać swoją charyzmę, by przekonać je do siebie.",shape=box,color=blue];
		2313 -> 2317;
	2316 [label="Nie wiem, dlaczego diabeł miałby kazać ci zrobić coś takiego. Ani czemu miałoby mu to służyć.",shape=box,color=blue];
		2316 -> 2321;
	2318 [label="Tagfer nie jest największym fanem Entratiego.",shape=box,color=red];
		2318 -> 2323;
	2319 [label="Zgaduję, że ta kłótnia była głośna.",shape=box,color=red];
		2319 -> 2324;
	2320 [label="Wszelkie czyny rzekomej dobroci ze strony diabła służą jego celowi, chce mnie zwrócić przeciwko le Cardinal. Jestem tego pewna.",shape=box,color=blue];
		2320 -> 2322;
	2317 [label="Robi to, by u uprzykrzyć mi życie. Chce zwrócić mnie przeciwko le Cardinal. Zobaczyć, jak odwracam się do niego plecami. Jestem tego pewna.",shape=box,color=blue];
		2317 -> 2322;
	2321 [label="Ale... nie o tym chciałeś porozmawiać. Kłótnia dotyczyła le Cardinal.",shape=box,color=blue];
		2321 -> 2318;
		2321 -> 2319;
	2323 [label="I właśnie tego nie rozumiem ! Zobacz, co zostało im dane !",shape=box,color=blue];
		2323 -> 2325;
		2323 -> 2326;
	2324 [label="Oui ! Nazwał mnie stupide. Powiedział, że jestem tylko dzieckiem.",shape=box,color=blue];
		2324 -> 2327;
		2324 -> 2325;
	2322 [label="To o le Cardinal pokłóciłam się z M'sieur Tagferem.",shape=box,color=blue];
		2322 -> 2318;
		2322 -> 2319;
	2325 [label="Proszę, od początku. Od czego się zaczęło?",shape=box,color=red];
		2325 -> 2328;
	2326 [label="Zaczynam dostrzegać, dlaczego doszło do tego sporu.",shape=box,color=red];
		2326 -> 2328;
	2327 [label="Naprawdę nazwał cię głupim dzieckiem?",shape=box,color=red];
		2327 -> 2329;
	2328 [label="Oui. Wspomniałam o le Cardinal, nawet nie pamiętam, co dokładnie.",shape=box,color=blue];
		2328 -> 2330;
	2329 [label="Nawet gorzej.",shape=box,color=blue];
		2329 -> 2331;
	2330 [label="M'sieur Tagfer przewrócił oczami i parsknął śmiechem. Poprosiłam go, żeby wytłumaczył swoją reakcję.",shape=box,color=blue];
		2330 -> 2332;
	2331 [label="\"Jesteś zaledwie pisklęciem, Mario ! Niewinna. Całkowicie uzależniona od innych. Chowasz się w swoim gniazdku ślepej wiary !\"",shape=box,color=blue];
		2331 -> 2333;
	2332 [label="\"Albrecht to paskudny, śmierdzący kłamca !\"",shape=box,color=blue];
		2332 -> 2334;
	2333 [label="\"Żyjesz tylko dzięki temu, co starsi przeżuli i wypluli z powrotem w twoją rozdziawioną paszczę !\"",shape=box,color=blue];
		2333 -> 2335;
	2334 [label="Et j'ai répondu, \"Spójrz na dary, jakie otrzymałeś, dar rozumu, języka, siebie !\"",shape=box,color=blue];
		2334 -> 2336;
	2335 [label="Update boolean MarieEntrati3",color=orange];
		2335 -> 2337;
		2335 -> 2338;
		2335 -> 2339;
	2336 [label="\"Powinieneś dziękować le Cardinal za wszystko, co dla ciebie zrobił.\"",shape=box,color=blue];
		2336 -> 2340;
		2336 -> 2341;
	2337 [label="Tagfer zna tylko jedną stronę historii. Prawdziwe motywacje i poglądy Entratiego... nie były jasne.",shape=box,color=red];
		2337 -> 2342;
	2338 [label="Wiem, jak się czujesz w kwestii \"uzależnienia\" od innych i przykro mi, że powiedział takie rzeczy.",shape=box,color=red];
		2338 -> 2343;
	2339 [label="Tagfer ma swoje powody, żeby tak myśleć.",shape=box,color=red];
		2339 -> 2344;
	2340 [label="I jak zareagował?",shape=box,color=red];
		2340 -> 2331;
