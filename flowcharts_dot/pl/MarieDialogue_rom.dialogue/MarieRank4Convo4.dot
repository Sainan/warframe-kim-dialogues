		j1639327012 -> j954720855 [label="false",color=purple];
	j69189686 [label="Jeśli starasz się przekonać mnie, żebym zamiast zrozumienia ich zwróciła swą złość przeciwko tobie, jest to bardzo kusząca oferta.",shape=box,color=blue];
		j69189686 -> j3750747828;
	j3750747828 [label="Może najlepiej będzie, abyśmy zakończyli tę rozmowę tutaj. Zanim emocje nas poniosą.",shape=box,color=blue];
		j3750747828 -> "Chat ends.";
	j1839803953 [label="Oui ? Więc z przyjemnością mogę powiedzieć, że nie udało ci się.",shape=box,color=blue];
		j1839803953 -> j1509439757;
	j954720855 [label="Cavia powstała w wyniku wypadku. Zwierzęta laboratoryjne nie miały nigdy istnieć, a Pustka uczyniła je inteligentnymi.",shape=box,color=red];
		j954720855 -> j1239985977;
	j304233586 [label="Sama powiedziałaś, że \"to ostateczne okrucieństwo, pozbawić kogoś imienia\". Entrati nigdy nie nadał im imion, tak niewiele dla niego znaczyły.",shape=box,color=red];
		j304233586 -> j4147264977;
	j2303182249 [label="Sama mówiłaś mi o tym, jak dorastałaś na ulicy. Jak twoja własna rodzina porzuciła cię, bo nie spełniłaś ich oczekiwań.",shape=box,color=red];
		j2303182249 -> j1316233513;
	j4113173774 [label="Pomyśl, jak byś się poczuła, gdyby Entrati pojawił się pewnego dnia, zrobił z ciebie protoframe'a wbrew twojej woli i porzucił cię?",shape=box,color=red];
		j4113173774 -> j997040360;
	j1477808128 [label="Pomyśl, jak byś się poczuła, gdyby Entrati pojawił się pewnego dnia, zrobił z Leona protoframe'a i porzucił go?",shape=box,color=red];
		j1477808128 -> j2364134333;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j1239985977 [label="A kiedy Entrati zrozumiał, co zrobił? Kiedy pojął, co stworzył? Te biedne zwierzęta, mówiące językiem Pustki, schorowane swoją podróżą?",shape=box,color=red];
		j1239985977 -> j63254888;
	j4147264977 [label="Były dla niego jak rzeczy. Rzeczy, które można wykorzystać i wyrzucić. \"Miecio\"? Wzięło się od \"Śmieć/Odpad\".",shape=box,color=red];
		j4147264977 -> j2770029966;
	j1316233513 [label="Twoja własna rodzina uznała cię za bezwartościową.",shape=box,color=red];
		j1316233513 -> j7142519;
	j997040360 [label="Wyobraź sobie, jak ty byś się poczuła, z Plagą krążącą w twoich żyłach, w cierpieniu, które nikogo nie obchodzi?",shape=box,color=red];
		j997040360 -> j2195743027;
	j2364134333 [label="Wykorzystał go jak szczura laboratoryjnego, a potem odrzucił w niepamięć? Wy mogliście na sobie polegać i to się nie zmieniło. Cavia nie miała takiego szczęścia.",shape=box,color=red];
		j2364134333 -> j553974177;
	j2631316640 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
