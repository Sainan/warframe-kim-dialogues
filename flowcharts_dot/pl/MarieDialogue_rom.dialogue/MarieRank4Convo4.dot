		j2770029966 -> j2186938194;
	j7142519 [label="Tym była Cavia dla Entratiego. Podmiotami testów. \"Miecio\"? Wzięło się od oznaczenia \"Śmieć/Odpad\".",shape=box,color=red];
		j7142519 -> j2770029966;
	j2195743027 [label="To, że kogoś obchodziło twoje cierpienie? Cavia była — jest — bezwartościowa dla Entratiego. Była dla niego tylko przedmiotem testów. \"Miecio\"? Wzięło się od \"Śmieć/Odpad\".",shape=box,color=red];
		j2195743027 -> j2770029966;
	j553974177 [label="Dla Entratiego Cavia była tylko przedmiotem testów. Była bezwartościowa. \"Miecio\"? Wzięło się od \"Śmieć/Odpad\".",shape=box,color=red];
		j553974177 -> j2770029966;
