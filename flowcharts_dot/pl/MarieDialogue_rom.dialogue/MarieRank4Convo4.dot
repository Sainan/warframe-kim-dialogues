		2344 -> 2351 [label="MarieEntratiNeutral",color=purple];
		2344 -> 2350 [label="false",color=purple];
	2345 [label="To nie daje mu prawa ! Nie wiem, czy zdaje sobie sprawę, jak bolesne były jego słowa. En outre...",shape=box,color=blue];
		2345 -> 2344;
	2346 [label="Dziękuję. Nie wiem, czy zdawał sobie sprawę, jak bolesne były jego słowa.",shape=box,color=blue];
		2346 -> 2352;
		2346 -> 2353;
		2346 -> 2354;
	2347 [label="Jeśli to jest powitanie, którego le Cardinal powinien spodziewać się po powrocie, to nic dziwnego, że nie wraca !",shape=box,color=blue];
		2347 -> 2355;
		2347 -> 2356;
	2348 [label="Spodziewam się, że trzymasz tutaj stronę M'sieur Tagfera, non ? Wierzysz, że le Cardinal był potworem, zupełnie jak to zwierzę.",shape=box,color=blue];
		2348 -> 2357;
		2348 -> 2358;
	2349 [label="Jestem zaskoczona, je pensais que tu étais de mon côté ! Czy ledwie chwilę temu nie chwaliłeś motywacji le Cardinal ?",shape=box,color=blue];
		2349 -> 2359;
	2351 [label="Jak sam powiedziałeś, jakie to ma znaczenie ? Musimy odegrać swoją rolę w jego planie i osądzimy go po wszystkim. Ta sprzeczka jest bezcelowa, non ?",shape=box,color=blue];
		2351 -> 2361;
		2351 -> 2362;
	2350 [label="Wiem, że to z rąk le Cardinal zostali odmienieni przez Pustkę. Wszyscy otrzymali dary od le Cardinal, które złamane serce widzi jako przekleństwa !",shape=box,color=blue];
		2350 -> 2360;
	2352 [label="Pomyślałaś, jak raniące mogły być twoje słowa? Czy poznałaś całą jego historię?",shape=box,color=red];
		2352 -> 2350;
	2353 [label="Twoje słowa były dla niego równie bolesne.",shape=box,color=red];
		2353 -> 2363;
	2354 [label="Jestem po twojej stronie, ale... nie powinniśmy powodować kłótni.",shape=box,color=red];
		2354 -> 2364;
		2354 -> 2365;
	2355 [label="Proszę, nie chcę zaczynać kolejnej kłótni. Próbuję ci tylko wyjaśnić, przez co przeszedł Tagfer.",shape=box,color=red];
		2355 -> 2366;
	2356 [label="Gdyby Entrati został, choć na chwilę, by posprzątać swój bałagan, mógłby mieć więcej przyjaciół na tym świecie.",shape=box,color=red];
		2356 -> 2367;
	2357 [label="Proszę, nie chcę zaczynać kolejnej kłótni. Próbuję ci tylko wyjaśnić, przez co przeszedł Tagfer.",shape=box,color=red];
		2357 -> 2366;
	2358 [label="Tak, trzymam jego stronę, bo nie można przemówić ci od rozsądku. Musisz zrozumieć, że \"le Cardinal\" nie jest tym, za kogo się podaje.",shape=box,color=red];
		2358 -> 2366;
	2359 [label="Czy to jedna z twoich gierek ? Oszukiwałeś małą Marię ?",shape=box,color=blue];
		2359 -> 2368;
		2359 -> 2369;
	2361 [label="Ważne, żeby nikogo przy nas nie było, kiedy to my będziemy po drugiej stronie tej sprawy. Cavia ma za sobą ciężkie przeżycia.",shape=box,color=red];
		2361 -> 2366;
	2362 [label="Jestem pewien, że o tym zapomni. Ty też.",shape=box,color=red];
		2362 -> 2371;
	2360 [label="Wszyscy zostaliśmy przez niego porzuceni ! Powiedz mi, w jaki sposób oni zostali tak zranieni, żebym ja musiała tolerować taką nienawiść ?!",shape=box,color=blue];
		2360 -> 2370;
	2363 [label="Oui ?! Dlaczego ?",shape=box,color=blue];
		2363 -> 2350;
	2364 [label="Cavia... ma za sobą ciężkie przeżycia.",shape=box,color=red];
		2364 -> 2350;
	2365 [label="To zwierzęta, nawet jeśli obdarzone inteligencją. Musimy być świadomi tego, ile naprawdę mogą zrobić.",shape=box,color=red];
		2365 -> 2372;
	2366 [label="Oui ? Więc odegraj rolę La Lumière Sacrée de Sol i przegnaj mrok ! Oświeć małą, głupią Marię !",shape=box,color=blue];
		2366 -> 2350;
	2367 [label="Oui ! Nie wystarczy, że stara się uratować znany wszechświat przed bogiem Pustki, non ?!",shape=box,color=blue];
		2367 -> 2373;
	2368 [label="Nie, nie okłamuję cię. Zgadzam się z tobą, ale musisz zrozumieć, że Cavia... ma za sobą ciężkie przeżycia.",shape=box,color=red];
		2368 -> 2366;
	2369 [label="Nie, to żadna gra... Entratiemu nie można ufać i nie wiem jak cię przekonać, że on tylko udaje, że jest po twojej stronie.",shape=box,color=red];
		2369 -> 2374;
	2371 [label="Non ! To ty zacząłeś tę rozmowę i doprowadzisz ją do końca. Explique !",shape=box,color=blue];
		2371 -> 2350;
	2370 [label="Evaluate expressions",color=orange];
