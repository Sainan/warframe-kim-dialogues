	2410 [label="Wiem, że wierzysz, że robi to, co uważa za słuszne. I wiem, że wierzysz w przebaczenie. Ja też. Ale musisz zrozumieć, dlaczego niektórzy nie podzielają twojego stania. Przynajmniej na razie.",shape=box,color=red];
		2410 -> 2414;
	2411 [label="Są chwile, kiedy ludzie nie są w stanie wybaczyć tym, którzy ich skrzywdzili. Na pewno nie teraz, a może nigdy. ",shape=box,color=red];
		2411 -> 2415;
