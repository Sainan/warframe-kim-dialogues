	"Chat ends." [color=orange];
	j1349183574 [label="Oui, chociaż mam podejrzenia, o czym chcesz porozmawiać... o moim niewłaściwym zachowaniu. Kto ci powiedział ?",shape=box,color=blue];
		j1349183574 -> j3240274664;
		j1349183574 -> j2004538371;
		j1349183574 -> j1299636304;
	j573765952 [label="Bien sûr, ce salaud de diable ouvre sa bouche et vous raconte tout ! Il ne cherche qu'à m'embarrasser !",shape=box,color=blue];
		j573765952 -> j2445032026;
	j3240274664 [label="To nie ma znaczenia.",shape=box,color=red];
		j3240274664 -> j247054731;
	j2004538371 [label="Loid. ",shape=box,color=red];
		j2004538371 -> j1871217722;
	j1299636304 [label="Roathe.",shape=box,color=red];
		j1299636304 -> j573765952;
	j2445032026 [label="Si je le pouvais, je prendrais ce couteau qu'il aime tant utiliser pour agacer les autres et je le fourrerais là où seule Lua peut le voir !",shape=box,color=blue];
		j2445032026 -> j603439109;
	j247054731 [label="Myślę, że ma, ale myślę też, że chcesz mi oszczędzić wstydu, więc... nie będę naciskać.",shape=box,color=blue];
		j247054731 -> j1951361532;
	j1871217722 [label="Myślę, że kłamiesz, chcąc oszczędzić mi wstydu, ale... nie będę naciskać.",shape=box,color=blue];
		j1871217722 -> j1951361532;
	j603439109 [label="Wybacz mi. To było... niestosowne. Jestem Sœur de Sol, nie mogę się tak zachowywać.",shape=box,color=blue];
		j603439109 -> j4225518568;
	j1951361532 [label="+5 Chemistry",color=orange];
		j1951361532 -> j4155267783;
	j4225518568 [label="+5 Chemistry",color=orange];
		j4225518568 -> j2302790581;
	j4155267783 [label="Chcę zachować resztki swojej godności.",shape=box,color=blue];
		j4155267783 -> j3557771111;
	j2302790581 [label="Nie ty mnie zdenerwowałeś. Zawsze cieszy mnie twoja szczerość.",shape=box,color=blue];
		j2302790581 -> j3648027028;
	j3557771111 [label="Jeśli chcesz porozmawiać ze mną o kłótni, która miała miejsce z M'sieur Tagferem, nie zaprzeczę, że miała miejsce.",shape=box,color=blue];
		j3557771111 -> j3648027028;
	j3648027028 [label="Zakładam, że diabeł powiedział ci, czego dotyczyła ta sprzeczka?",shape=box,color=blue];
		j3648027028 -> j370765590;
	j370765590 [label="Evaluate expressions",color=orange];
		j370765590 -> j41221407 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j4149260928 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j3059915313 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j41221407 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j41221407 [label="false",color=purple];
		j370765590 -> j1348883754 [label="false",color=purple];
	j41221407 [label="Nie musiał mi niczego mówić, mogłem się tego domyślić. Chodzi o Entratiego.",shape=box,color=red];
		j41221407 -> j3258327143;
	j4149260928 [label="Powiedział mi. Ale wyglądał na bardziej zmartwionego tobą.",shape=box,color=red];
		j4149260928 -> j442407730;
	j3059915313 [label="Tak. Martwi się tą sytuacją, bo zżył się z Cavią.",shape=box,color=red];
		j3059915313 -> j2257015542;
	j1348883754 [label="Nie, naprawdę. Powiedział mi, żebym sprawdził, co u ciebie.",shape=box,color=red];
		j1348883754 -> j3934688433;
	j3258327143 [label="Oui. Pokłóciłam się z M'sieur Tagferem o le Cardinal.",shape=box,color=blue];
		j3258327143 -> j1791082184;
		j3258327143 -> j2626730323;
	j442407730 [label="Nie wiem, dlaczego diabeł miałby kazać ci wierzyć w coś takiego. Ani czemu miałoby mu to służyć.",shape=box,color=blue];
		j442407730 -> j1020149536;
	j2257015542 [label="Diabeł poznał trzy skrzywdzone zwierzęta i wie, że może z łatwością wykorzystać swoją charyzmę, by przekonać je do siebie.",shape=box,color=blue];
		j2257015542 -> j1266743667;
	j3934688433 [label="Nie wiem, dlaczego diabeł miałby kazać ci zrobić coś takiego. Ani czemu miałoby mu to służyć.",shape=box,color=blue];
		j3934688433 -> j3977868631;
	j1791082184 [label="Tagfer nie jest największym fanem Entratiego.",shape=box,color=red];
		j1791082184 -> j2372856566;
	j2626730323 [label="Zgaduję, że ta kłótnia była głośna.",shape=box,color=red];
		j2626730323 -> j4250086636;
	j1020149536 [label="Wszelkie czyny rzekomej dobroci ze strony diabła służą jego celowi, chce mnie zwrócić przeciwko le Cardinal. Jestem tego pewna.",shape=box,color=blue];
		j1020149536 -> j3866813092;
	j1266743667 [label="Robi to, by u uprzykrzyć mi życie. Chce zwrócić mnie przeciwko le Cardinal. Zobaczyć, jak odwracam się do niego plecami. Jestem tego pewna.",shape=box,color=blue];
		j1266743667 -> j3866813092;
	j3977868631 [label="Ale... nie o tym chciałeś porozmawiać. Kłótnia dotyczyła le Cardinal.",shape=box,color=blue];
		j3977868631 -> j1791082184;
		j3977868631 -> j2626730323;
	j2372856566 [label="I właśnie tego nie rozumiem ! Zobacz, co zostało im dane !",shape=box,color=blue];
		j2372856566 -> j68103762;
		j2372856566 -> j971052687;
	j4250086636 [label="Oui ! Nazwał mnie stupide. Powiedział, że jestem tylko dzieckiem.",shape=box,color=blue];
		j4250086636 -> j606531964;
		j4250086636 -> j68103762;
	j3866813092 [label="To o le Cardinal pokłóciłam się z M'sieur Tagferem.",shape=box,color=blue];
		j3866813092 -> j1791082184;
		j3866813092 -> j2626730323;
	j68103762 [label="Proszę, od początku. Od czego się zaczęło?",shape=box,color=red];
		j68103762 -> j1626559020;
	j971052687 [label="Zaczynam dostrzegać, dlaczego doszło do tego sporu.",shape=box,color=red];
		j971052687 -> j1626559020;
	j606531964 [label="Naprawdę nazwał cię głupim dzieckiem?",shape=box,color=red];
		j606531964 -> j1676901388;
	j1626559020 [label="Oui. Wspomniałam o le Cardinal, nawet nie pamiętam, co dokładnie.",shape=box,color=blue];
		j1626559020 -> j1868347646;
	j1676901388 [label="Nawet gorzej.",shape=box,color=blue];
		j1676901388 -> j2317008443;
	j1868347646 [label="M'sieur Tagfer przewrócił oczami i parsknął śmiechem. Poprosiłam go, żeby wytłumaczył swoją reakcję.",shape=box,color=blue];
		j1868347646 -> j2928448201;
	j2317008443 [label="\"Jesteś zaledwie pisklęciem, Mario ! Niewinna. Całkowicie uzależniona od innych. Chowasz się w swoim gniazdku ślepej wiary !\"",shape=box,color=blue];
		j2317008443 -> j258538819;
	j2928448201 [label="\"Albrecht to paskudny, śmierdzący kłamca !\"",shape=box,color=blue];
		j2928448201 -> j2909829384;
	j258538819 [label="\"Żyjesz tylko dzięki temu, co starsi przeżuli i wypluli z powrotem w twoją rozdziawioną paszczę !\"",shape=box,color=blue];
		j258538819 -> j471012429;
	j2909829384 [label="Et j'ai répondu, \"Spójrz na dary, jakie otrzymałeś, dar rozumu, języka, siebie !\"",shape=box,color=blue];
		j2909829384 -> j3749040865;
	j471012429 [label="Boolean MarieEntrati3 is now true.",color=orange];
		j471012429 -> j449736021;
		j471012429 -> j3510792213;
		j471012429 -> j198308404;
	j3749040865 [label="\"Powinieneś dziękować le Cardinal za wszystko, co dla ciebie zrobił.\"",shape=box,color=blue];
		j3749040865 -> j1600225777;
		j3749040865 -> j1338499497;
	j449736021 [label="Tagfer zna tylko jedną stronę historii. Prawdziwe motywacje i poglądy Entratiego... nie były jasne.",shape=box,color=red];
		j449736021 -> j201420923;
	j3510792213 [label="Wiem, jak się czujesz w kwestii \"uzależnienia\" od innych i przykro mi, że powiedział takie rzeczy.",shape=box,color=red];
		j3510792213 -> j239201711;
	j198308404 [label="Tagfer ma swoje powody, żeby tak myśleć.",shape=box,color=red];
		j198308404 -> j946548047;
	j1600225777 [label="I jak zareagował?",shape=box,color=red];
		j1600225777 -> j2317008443;
	j1338499497 [label="Och nie...",shape=box,color=red];
		j1338499497 -> j2317008443;
