		j946548047 -> j1692770153 [label="false",color=purple];
	j609502079 [label="To nie daje mu prawa ! Nie wiem, czy zdaje sobie sprawę, jak bolesne były jego słowa. En outre...",shape=box,color=blue];
		j609502079 -> j946548047;
	j2347715832 [label="Dziękuję. Nie wiem, czy zdawał sobie sprawę, jak bolesne były jego słowa.",shape=box,color=blue];
		j2347715832 -> j802964137;
		j2347715832 -> j283545860;
		j2347715832 -> j160035171;
	j175242681 [label="Jeśli to jest powitanie, którego le Cardinal powinien spodziewać się po powrocie, to nic dziwnego, że nie wraca !",shape=box,color=blue];
		j175242681 -> j451464374;
		j175242681 -> j3915772421;
	j1717662776 [label="Spodziewam się, że trzymasz tutaj stronę M'sieur Tagfera, non ? Wierzysz, że le Cardinal był potworem, zupełnie jak to zwierzę.",shape=box,color=blue];
		j1717662776 -> j451464374;
		j1717662776 -> j3014504246;
	j4179590314 [label="Jestem zaskoczona, je pensais que tu étais de mon côté ! Czy ledwie chwilę temu nie chwaliłeś motywacji le Cardinal ?",shape=box,color=blue];
		j4179590314 -> j2897883286;
	j3598066546 [label="Jak sam powiedziałeś, jakie to ma znaczenie ? Musimy odegrać swoją rolę w jego planie i osądzimy go po wszystkim. Ta sprzeczka jest bezcelowa, non ?",shape=box,color=blue];
		j3598066546 -> j1386651730;
		j3598066546 -> j2844626667;
	j1692770153 [label="Wiem, że to z rąk le Cardinal zostali odmienieni przez Pustkę. Wszyscy otrzymali dary od le Cardinal, które złamane serce widzi jako przekleństwa !",shape=box,color=blue];
		j1692770153 -> j2989574868;
	j802964137 [label="Pomyślałaś, jak raniące mogły być twoje słowa? Czy poznałaś całą jego historię?",shape=box,color=red];
		j802964137 -> j1692770153;
	j283545860 [label="Twoje słowa były dla niego równie bolesne.",shape=box,color=red];
		j283545860 -> j78070665;
	j160035171 [label="Jestem po twojej stronie, ale... nie powinniśmy powodować kłótni.",shape=box,color=red];
		j160035171 -> j3466609471;
		j160035171 -> j4098147184;
	j451464374 [label="Proszę, nie chcę zaczynać kolejnej kłótni. Próbuję ci tylko wyjaśnić, przez co przeszedł Tagfer.",shape=box,color=red];
		j451464374 -> j1483805396;
	j3915772421 [label="Gdyby Entrati został, choć na chwilę, by posprzątać swój bałagan, mógłby mieć więcej przyjaciół na tym świecie.",shape=box,color=red];
		j3915772421 -> j2788750307;
	j3014504246 [label="Tak, trzymam jego stronę, bo nie można przemówić ci od rozsądku. Musisz zrozumieć, że \"le Cardinal\" nie jest tym, za kogo się podaje.",shape=box,color=red];
		j3014504246 -> j1483805396;
	j2897883286 [label="Czy to jedna z twoich gierek ? Oszukiwałeś małą Marię ?",shape=box,color=blue];
		j2897883286 -> j3219169046;
		j2897883286 -> j3560204850;
	j1386651730 [label="Ważne, żeby nikogo przy nas nie było, kiedy to my będziemy po drugiej stronie tej sprawy. Cavia ma za sobą ciężkie przeżycia.",shape=box,color=red];
		j1386651730 -> j1483805396;
	j2844626667 [label="Jestem pewien, że o tym zapomni. Ty też.",shape=box,color=red];
		j2844626667 -> j304780922;
	j2989574868 [label="Wszyscy zostaliśmy przez niego porzuceni ! Powiedz mi, w jaki sposób oni zostali tak zranieni, żebym ja musiała tolerować taką nienawiść ?!",shape=box,color=blue];
		j2989574868 -> j1639327012;
	j78070665 [label="Oui ?! Dlaczego ?",shape=box,color=blue];
		j78070665 -> j1692770153;
	j3466609471 [label="Cavia... ma za sobą ciężkie przeżycia.",shape=box,color=red];
		j3466609471 -> j1692770153;
	j4098147184 [label="To zwierzęta, nawet jeśli obdarzone inteligencją. Musimy być świadomi tego, ile naprawdę mogą zrobić.",shape=box,color=red];
		j4098147184 -> j69189686;
	j1483805396 [label="Oui ? Więc odegraj rolę La Lumière Sacrée de Sol i przegnaj mrok ! Oświeć małą, głupią Marię !",shape=box,color=blue];
		j1483805396 -> j1692770153;
	j2788750307 [label="Oui ! Nie wystarczy, że stara się uratować znany wszechświat przed bogiem Pustki, non ?!",shape=box,color=blue];
		j2788750307 -> j3750747828;
	j3219169046 [label="Nie, nie okłamuję cię. Zgadzam się z tobą, ale musisz zrozumieć, że Cavia... ma za sobą ciężkie przeżycia.",shape=box,color=red];
		j3219169046 -> j1483805396;
	j3560204850 [label="Nie, to żadna gra... Entratiemu nie można ufać i nie wiem jak cię przekonać, że on tylko udaje, że jest po twojej stronie.",shape=box,color=red];
		j3560204850 -> j1839803953;
	j304780922 [label="Non ! To ty zacząłeś tę rozmowę i doprowadzisz ją do końca. Explique !",shape=box,color=blue];
		j304780922 -> j1692770153;
	j1639327012 [label="Evaluate expressions",color=orange];
