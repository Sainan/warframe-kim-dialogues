		2370 -> 2375 [label="MarrieLyonSuffering3",color=purple];
		2370 -> 2375 [label="false",color=purple];
	2372 [label="Jeśli starasz się przekonać mnie, żebym zamiast zrozumienia ich zwróciła swą złość przeciwko tobie, jest to bardzo kusząca oferta.",shape=box,color=blue];
		2372 -> 2380;
	2373 [label="Może najlepiej będzie, abyśmy zakończyli tę rozmowę tutaj. Zanim emocje nas poniosą.",shape=box,color=blue];
		2373 -> 2381;
	2374 [label="Oui ? Więc z przyjemnością mogę powiedzieć, że nie udało ci się.",shape=box,color=blue];
		2374 -> 2382;
	2375 [label="Cavia powstała w wyniku wypadku. Zwierzęta laboratoryjne nie miały nigdy istnieć, a Pustka uczyniła je inteligentnymi.",shape=box,color=red];
		2375 -> 2383;
	2377 [label="Sama powiedziałaś, że \"to ostateczne okrucieństwo, pozbawić kogoś imienia\". Entrati nigdy nie nadał im imion, tak niewiele dla niego znaczyły.",shape=box,color=red];
		2377 -> 2385;
	2378 [label="Sama mówiłaś mi o tym, jak dorastałaś na ulicy. Jak twoja własna rodzina porzuciła cię, bo nie spełniłaś ich oczekiwań.",shape=box,color=red];
		2378 -> 2386;
	2379 [label="Pomyśl, jak byś się poczuła, gdyby Entrati pojawił się pewnego dnia, zrobił z ciebie protoframe'a wbrew twojej woli i porzucił cię?",shape=box,color=red];
		2379 -> 2387;
	2376 [label="Pomyśl, jak byś się poczuła, gdyby Entrati pojawił się pewnego dnia, zrobił z Leona protoframe'a i porzucił go?",shape=box,color=red];
		2376 -> 2384;
	2380 [label="Może najlepiej będzie, abyśmy zakończyli tę rozmowę tutaj. Zanim emocje nas poniosą.",shape=box,color=blue];
		2380 -> 2388;
	2381 [label="Chat ends.",color=orange];
	2382 [label="Update boolean MarieEntratiFan1",color=orange];
		2382 -> 2389;
	2383 [label="A kiedy Entrati zrozumiał, co zrobił? Kiedy pojął, co stworzył? Te biedne zwierzęta, mówiące językiem Pustki, schorowane swoją podróżą?",shape=box,color=red];
		2383 -> 2390;
	2385 [label="Były dla niego jak rzeczy. Rzeczy, które można wykorzystać i wyrzucić. \"Miecio\"? Wzięło się od \"Śmieć/Odpad\".",shape=box,color=red];
		2385 -> 2392;
	2386 [label="Twoja własna rodzina uznała cię za bezwartościową.",shape=box,color=red];
		2386 -> 2393;
	2387 [label="Wyobraź sobie, jak ty byś się poczuła, z Plagą krążącą w twoich żyłach, w cierpieniu, które nikogo nie obchodzi?",shape=box,color=red];
		2387 -> 2394;
	2384 [label="Wykorzystał go jak szczura laboratoryjnego, a potem odrzucił w niepamięć? Wy mogliście na sobie polegać i to się nie zmieniło. Cavia nie miała takiego szczęścia.",shape=box,color=red];
		2384 -> 2391;
	2388 [label="Chat ends.",color=orange];
	2389 [label="Update boolean MarieEntratiFan2",color=orange];
		2389 -> 2395;
	2390 [label="Nie obchodziło go to. ",shape=box,color=red];
		2390 -> 2396;
	2392 [label="Ptak-3? To ptak, który otrzymał numer za imię. Fibonacci tak go nazwał.",shape=box,color=red];
		2392 -> 2397;
	2393 [label="Tym była Cavia dla Entratiego. Podmiotami testów. \"Miecio\"? Wzięło się od oznaczenia \"Śmieć/Odpad\".",shape=box,color=red];
		2393 -> 2392;
	2394 [label="To, że kogoś obchodziło twoje cierpienie? Cavia była — jest — bezwartościowa dla Entratiego. Była dla niego tylko przedmiotem testów. \"Miecio\"? Wzięło się od \"Śmieć/Odpad\".",shape=box,color=red];
		2394 -> 2392;
	2391 [label="Dla Entratiego Cavia była tylko przedmiotem testów. Była bezwartościowa. \"Miecio\"? Wzięło się od \"Śmieć/Odpad\".",shape=box,color=red];
		2391 -> 2392;
	2395 [label="Update boolean MarieNoDate",color=orange];
		2395 -> 2398;
	2396 [label="Tym była Cavia dla Entratiego. Zbywalna. \"Miecio\"? Wzięło się od oznaczenia \"Śmieć/Odpad\".",shape=box,color=red];
		2396 -> 2399;
	2397 [label="Wykorzystani w eksperymencie. Jedyni ocaleni spośród wielu martwych zwierząt. Nigdy nie mieli istnieć.",shape=box,color=red];
		2397 -> 2400;
	2398 [label="Chat ends.",color=orange];
	2399 [label="Ostatni swojego rodzaju. Śmieć i Odpad. Jego partnerka? Minn? Jedyna, która także pozostała? Zginęła w trakcie eksperymentu.",shape=box,color=red];
		2399 -> 2401;
	2400 [label="Tylko dzięki Loidowi nadal żyją. Zadbał o nich, bo nie mógł zmusić się do zabicia ich \"zgodnie z instrukcjami Entratiego\".",shape=box,color=red];
		2400 -> 2402;
	2401 [label="Dlatego jest taki wściekły. Dlatego nienawidzi Entratiego. Dlatego to nigdy się nie zmieni.",shape=box,color=red];
		2401 -> 2403;
	2402 [label="Och, i Miecio? Jest ostatnim ze swojego rodzaju. Jego partnerka? Minn? Jedyna, która także pozostała? Zginęła w trakcie eksperymentu.",shape=box,color=red];
		2402 -> 2404;
