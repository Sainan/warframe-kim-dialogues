digraph {
	"MarieRank2Convo1 begins." [color=orange];
		"MarieRank2Convo1 begins." -> j4000600464;
	j4000600464 [label="Mam nadzieję, że nie masz nic przeciwko, ale strasznie mnie to ciekawi. Czy jesteś wierzący ? W Świetlistych, czy kogokolwiek innego.",shape=box,color=blue];
		j4000600464 -> j3094582893;
		j4000600464 -> j2492058976;
		j4000600464 -> j386906797;
	j3094582893 [label="A co, gdybym powiedział, że jestem bardziej zainteresowany tobą? Czy to byłoby bluźnierstwo?",shape=box,color=red];
		j3094582893 -> j73941488;
	j2492058976 [label="Nie, to wcale nie byłoby niegrzeczne.",shape=box,color=red];
		j2492058976 -> j3696202613;
		j2492058976 -> j2340722771;
		j2492058976 -> j1855512778;
		j2492058976 -> j3190248630;
		j2492058976 -> j788142566;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j73941488 [label="Boolean DrifterMarie is now true.",color=orange];
		j73941488 -> j3723986432;
	j3696202613 [label="To... skomplikowane. Wierzę, że coś tam istnieje, ale nie wiem, czy jest to konkretna wiara.",shape=box,color=red];
		j3696202613 -> j4286557438;
	j2340722771 [label="Tak, jestem, choć nie jest to wiara, którą możesz znać.",shape=box,color=red];
		j2340722771 -> j1490764283;
	j1855512778 [label="Wierzę w Świetlistych, tak jak Ty.",shape=box,color=red];
		j1855512778 -> j554539027;
	j3190248630 [label="Nie, nie wierzę w bogów. To tylko nauka, której jeszcze nie zrozumieliśmy.",shape=box,color=red];
		j3190248630 -> j3992372458;
	j788142566 [label="Ciężko powiedzieć. Myślę, że świat jest zbyt skomplikowany, żebym mógł odpowiedzieć na to pytanie.",shape=box,color=red];
		j788142566 -> j94371779;
	"Chat ends." [color=orange];
	j3723986432 [label="Ah, oui ? What is this ? Quelle audace, muszę przyznać, że jestem zaskoczona ! Nie spodziewałam się...",shape=box,color=blue];
		j3723986432 -> j652135538;
	j4286557438 [label="Boolean DrifterFaithPersonal is now true.",color=orange];
		j4286557438 -> j511414987;
	j1490764283 [label="+5 Chemistry",color=orange];
		j1490764283 -> j919504037;
	j554539027 [label="+5 Chemistry",color=orange];
		j554539027 -> j2832591650;
	j3992372458 [label="+5 Chemistry",color=orange];
		j3992372458 -> j4120519505;
	j94371779 [label="Boolean DrifterFaithAgnostic is now true.",color=orange];
		j94371779 -> j2485870287;
	j652135538 [label="Ale odciągasz mnie od obowiązków ! Nie mam nic przeciwko, ale jest chyba odrobinę za wcześnie, n'est-ce pas ?",shape=box,color=blue];
		j652135538 -> j1519390477;
	j511414987 [label="+5 Chemistry",color=orange];
		j511414987 -> j1387251886;
	j919504037 [label="Odnajduję piękno w każdej wierze, niezależnie od jej nazwy. Opowiedz mi o niej, czy to nowa wiara ? Dawna ? Czy w ogóle zdołam ją rozpoznać ?",shape=box,color=blue];
		j919504037 -> j1082762021;
		j919504037 -> j2456426058;
	j2832591650 [label="Naprawdę ! Oh, comme c'est fascinant ! Uwierzyć, że nasza wiara istnieje w tak dalekiej przyszłości, cela remplit mon cœur de joie. Moje serce przepełnia radość. Ale ma to do czynienia z Twoim pobytem w przeszłości, prawda ? Ach, to bez znaczenia.",shape=box,color=blue];
		j2832591650 -> j4071935370;
	j4120519505 [label="Szanuję Twoją odpowiedź, ale muszę zapytać. Skąd ta pewność ? Czy to samo w sobie nie jest wiarą ? A czym jest Twoja... Indifférence, jeśli nie bogiem ?",shape=box,color=blue];
		j4120519505 -> j913159463;
		j4120519505 -> j1741299926;
		j4120519505 -> j304166894;
	j2485870287 [label="+10 Chemistry",color=orange];
		j2485870287 -> j2124889378;
	j1519390477 [label="Ale... nadal chciałabym uzyskać odpowiedź na moje pytanie, s'il vous plait, jeśli to nie problem. Ale teraz się rumienię !",shape=box,color=blue];
		j1519390477 -> j3696202613;
		j1519390477 -> j2340722771;
		j1519390477 -> j1855512778;
		j1519390477 -> j3190248630;
		j1519390477 -> j788142566;
	j1387251886 [label="Ach, oui. Włóczęga to trafne określenie. Poznałeś wiele kultur, wiele wiar, wiele światów. Cela est très spirituel, non ? Zabrałeś ze sobą skrawki każdego.",shape=box,color=blue];
		j1387251886 -> j3558096951;
		j1387251886 -> j743060405;
	j1082762021 [label="Wątpię, że byłabyś w stanie ją rozpoznać.",shape=box,color=red];
		j1082762021 -> j2737036734;
	j2456426058 [label="Możesz kojarzyć pewne aspekty, ale inne byłyby dla Ciebie całkiem obce.",shape=box,color=red];
		j2456426058 -> j577255891;
	j4071935370 [label="Zastanawiam się, któremu jesteś oddany ? Czy może kroczysz drogą równowagi ?",shape=box,color=blue];
		j4071935370 -> j2875052073;
		j4071935370 -> j621820615;
		j4071935370 -> j4130540243;
	j913159463 [label="Nie mogę być pewnym, nikt nie może. Ale nadal nie uważam tego za wiarę w bogów.",shape=box,color=red];
		j913159463 -> j3416149268;
	j1741299926 [label="Myślę, że religia istnieje, by pomóc ludziom radzić sobie ze strachem przed śmiercią i nieznanym.",shape=box,color=red];
		j1741299926 -> j3117706873;
	j304166894 [label="Nie wiem, czym jest Obojętność, ale na pewno nie bogiem. Po prostu musimy ją zrozumieć. ",shape=box,color=red];
		j304166894 -> j1670132747;
	j2124889378 [label="Aach, czyż to nie jest najmądrzejsza ze wszystkich odpowiedzi ! Czy byle śmiertelnicy - jeśli nadal możemy siebie tak nazwać - mogliby pojąć Boskie plany ?",shape=box,color=blue];
		j2124889378 -> j778955989;
	j3558096951 [label="Myślę, że istnieje coś starszego, głębszego, bardziej prawdziwego, co przemawia do nas wszystkich. Fundament, który to spaja.",shape=box,color=red];
		j3558096951 -> j879016622;
	j743060405 [label="Dokładnie tak. W każdej z nich dostrzegłem piękno, ale nie wiem, ile było w nich prawdy.",shape=box,color=red];
		j743060405 -> j879016622;
	j2737036734 [label="Boolean DrifterFaithYesForeign is now true.",color=orange];
		j2737036734 -> j2972178147;
	j577255891 [label="Boolean DrifterFaithYesSimilar is now true.",color=orange];
		j577255891 -> j3707880363;
	j2875052073 [label="Jestem bardziej zbliżony Sol. ",shape=box,color=red];
		j2875052073 -> j874583196;
	j621820615 [label="Jestem bardziej zbliżony Lua.",shape=box,color=red];
		j621820615 -> j2760133282;
	j4130540243 [label="Staram się odnaleźć równowagę. Myślę, że to naturalna kolej rzeczy.",shape=box,color=red];
		j4130540243 -> j458189653;
	j3416149268 [label="Boolean DrifterFaithNoMaybe is now true.",color=orange];
		j3416149268 -> j149212897;
	j3117706873 [label="Boolean DrifterFaithNoFear is now true.",color=orange];
		j3117706873 -> j2588484630;
	j1670132747 [label="Boolean DrifterFaithNoMITW is now true.",color=orange];
		j1670132747 -> j2026764335;
	j778955989 [label="Często spoczywałam w sanktuarium ma Cathédrale i z radością rozmawiałam z obcymi, którzy przybyli w poszukiwaniu nauki i niczego więcej.",shape=box,color=blue];
		j778955989 -> j899138692;
	j879016622 [label="+5 Chemistry",color=orange];
		j879016622 -> j3738509414;
	j2972178147 [label="+5 Chemistry",color=orange];
		j2972178147 -> j1494649880;
	j3707880363 [label="+5 Chemistry",color=orange];
		j3707880363 -> j342425856;
	j874583196 [label="Boolean DrifterFaithSol is now true.",color=orange];
		j874583196 -> j2366299283;
	j2760133282 [label="Boolean DrifterFaithLua is now true.",color=orange];
		j2760133282 -> j1230461798;
	j458189653 [label="Boolean DrifterFaithBalance is now true.",color=orange];
		j458189653 -> j2936775729;
	j149212897 [label="Oui, je vois... Może musisz odnaleźć własny \"dowód\"? Czy w Twoim życiu nie miało miejsce nic, co przepełniło Cię takim poczuciem, jakim jest dla nas wiara ?",shape=box,color=blue];
		j149212897 -> j3118764233;
		j149212897 -> j518676335;
	j2588484630 [label="Oui, c'est vrai - to prawda. Wiara to odpowiedź na wiele pytań zadawanych przez wiele dusz. Czy Ty nie lękasz się tego, co następuje po śmierci ?",shape=box,color=blue];
		j2588484630 -> j3512152864;
		j2588484630 -> j1557521682;
	j2026764335 [label="Comme c'est fascinant... i oto pojawił się kolejny, który wypowiedział te same słowa... tak samo szeptał diabeł.",shape=box,color=blue];
		j2026764335 -> j1322754994;
	j899138692 [label="Tak ciekawi naszej wiary, ale niechętni powiedzieć \"tak, dokładnie taka jest prawda\". Mam nadzieję, że dałam im część naszej radości.",shape=box,color=blue];
		j899138692 -> j1815414575;
		j899138692 -> j3946579376;
	j3738509414 [label="Je comprends, et cela est magnifique. Często zastanawiałam się, czy Świetliści nie skrywali się za innymi nazwami.",shape=box,color=blue];
		j3738509414 -> j3880792049;
	j1494649880 [label="Oh, comme c'est fascinant ! Chciałabym pewnego dnia dowiedzieć się więcej o Twojej wierze. Poznać Twoje rytuały.",shape=box,color=blue];
		j1494649880 -> j149146285;
		j1494649880 -> j1622881206;
	j342425856 [label="Oh, comme c'est fascinant ! Chciałabym pewnego dnia dowiedzieć się o ich podobieństwach i różnicach.",shape=box,color=blue];
		j342425856 -> j149146285;
		j342425856 -> j1622881206;
	j2366299283 [label="+10 Chemistry",color=orange];
		j2366299283 -> j1584314811;
	j1230461798 [label="+5 Chemistry",color=orange];
		j1230461798 -> j3059092070;
	j2936775729 [label="+5 Chemistry",color=orange];
		j2936775729 -> j2604375193;
	j3118764233 [label="Nie, po prostu nie jestem wierzący.",shape=box,color=red];
		j3118764233 -> j3879896454;
	j518676335 [label="Dokładnie tak było. Nigdy nie... \"poczułem\" wiary. Ani jej nie potrzebowałem.",shape=box,color=red];
		j518676335 -> j1742780689;
	j3512152864 [label="Wszyscy kiedyś umrą. Lęk przed śmiercią to głupota, ona przyjdzie po nas wszystkich. A przynajmniej powinna.",shape=box,color=red];
		j3512152864 -> j462079831;
	j1557521682 [label="Umarłem już tyle razy, że nie boję się śmierci. Przyjmuję ją z otwartymi ramionami.",shape=box,color=red];
		j1557521682 -> j2849160123;
	j1322754994 [label="+5 Chemistry",color=orange];
		j1322754994 -> j720234441;
	j1815414575 [label="Zaskakuje mnie Twoja otwartość na ludzi, którzy nie podzielają Twojej wiary.",shape=box,color=red];
		j1815414575 -> j31641571;
	j3946579376 [label="Dokładnie o to chodzi. Nie chcę mówić, że któraś z decyzji jest \"dobra\" albo \"zła\".",shape=box,color=red];
		j3946579376 -> j609358198;
	j3880792049 [label="Są znani z tego, że dostosowują swoje formy, by zadowolić wyznawców innych sekt. Ale to moja wiara, nie Twoja.",shape=box,color=blue];
		j3880792049 -> j491242510;
	j149146285 [label="Też z chęcią o tym porozmawiam.",shape=box,color=red];
		j149146285 -> j4155466030;
	j1622881206 [label="Zaskakuje mnie Twoja otwartość na inne wiary. ",shape=box,color=red];
		j1622881206 -> j174105229;
	j1584314811 [label="Moja bratnia dusza ! Ta wieść przynosi mi wiele radości. Mam nadzieję, że nie kłamiesz, by mi się przypodobać.",shape=box,color=blue];
		j1584314811 -> j736154292;
	j3059092070 [label="Ach, wędrowiec podąża tą samą ścieżką nocy, jak mój drogi Leon. Porozmawiaj z nim o naszej Pani Nocy, kiedy będzie gotowy, sprawi mu to wiele radości.",shape=box,color=blue];
		j3059092070 -> j736154292;
	j2604375193 [label="Równowaga bez chwili zawahania. Iść przez życie wiedząc, że po każdym wschodzie słońca musi wzejść też księżyc, ale nigdy nie dać się pokonać niepewności ?",shape=box,color=blue];
		j2604375193 -> j1890479744;
	j3879896454 [label="+5 Chemistry",color=orange];
		j3879896454 -> j1127320184;
	j1742780689 [label="+5 Chemistry",color=orange];
		j1742780689 -> j2209445346;
	j462079831 [label="+5 Chemistry",color=orange];
		j462079831 -> j1821853196;
	j2849160123 [label="+5 Chemistry",color=orange];
		j2849160123 -> j2479714381;
	j720234441 [label="Moje serce się kraje na myśl o złożeniu w nim jakiejkolwiek wiary, ale to ? Może powinieneś z nim porozmawiać. Ale miej się na uwadze. Taniec z diabłem to niebezpieczna gra.",shape=box,color=blue];
		j720234441 -> j2371960591;
		j720234441 -> j336368865;
	j31641571 [label="To może być dla Ciebie zaskoczenie, że ktoś, kto nosi ten habit, nie żywi surowych oczekiwań wobec innych. Łatwo zniechęcić do sobie ludzi, próbując nawrócić tych, którzy nie szukają zbawienia.",shape=box,color=blue];
		j31641571 -> j1110131458;
	j609358198 [label="+5 Chemistry",color=orange];
		j609358198 -> j2149881851;
	j491242510 [label="Mam tylko nadzieję, że wiara pozwala Ci odnaleźć spokój.",shape=box,color=blue];
		j491242510 -> j4077766925;
		j491242510 -> j809940362;
		j491242510 -> j2981058444;
	j4155466030 [label="Ô joie ! Uwielbiam poznawać inne wiary. Często zastanawiałam się, czy Świetliści nie skrywali się za innymi nazwami.",shape=box,color=blue];
		j4155466030 -> j3730134610;
	j174105229 [label="To może być dla Ciebie zaskoczenie, że ktoś, kto nosi ten habit, nie żywi surowych oczekiwań wobec innych. Łatwo zniechęcić do sobie ludzi, próbując nawrócić tych, którzy nie szukają zbawienia.",shape=box,color=blue];
		j174105229 -> j2115546229;
	j736154292 [label="Zastanawiam się tylko, czy nasza wiara pozwala Ci zaznać spokoju ?",shape=box,color=blue];
		j736154292 -> j4077766925;
		j736154292 -> j809940362;
		j736154292 -> j2981058444;
	j1890479744 [label="To rzadki dar... i mam nadzieję, że dobrze go wykorzystasz. Stać na rozstaju dróg to prosta droga, by zostać pochłoniętym przez konflikt.",shape=box,color=blue];
		j1890479744 -> j3361640067;
	j1127320184 [label="To musi być prostsze życie. Nie żyć według zasad bogów i kościołów. Muszę przyznać, że trochę Ci tego zazdroszczę.",shape=box,color=blue];
		j1127320184 -> j3849858526;
	j2209445346 [label="Zazdroszczę Ci tego, wędrowcze ! Przeżyć tak wiele lat, nie odczuwając potrzeby poznania bogów.",shape=box,color=blue];
		j2209445346 -> j3849858526;
	j1821853196 [label="Mówisz jak wyznawca Lua i nie mówię tego jako obelga. Oui, Jędza przyjdzie po nas wszystkich i uroni swoje srebrne łzy. Ale to nie Twoje słowa powodują zadumę...",shape=box,color=blue];
		j1821853196 -> j1210868976;
	j2479714381 [label="Oui, to mnie zastanawia. Patrzę na Ciebie, na dziecko, na diabła, nawet Monsieur Loida czy le Cardinal... za wami ciągnie się tak wiele lat.",shape=box,color=blue];
		j2479714381 -> j711818743;
	j2371960591 [label="O jakiej grze mówisz?",shape=box,color=red];
		j2371960591 -> j1086283966;
	j336368865 [label="Nie wierzy chyba, że Pan ze Ściany istnieje?",shape=box,color=red];
		j336368865 -> j4224228665;
	j1110131458 [label="+5 Chemistry",color=orange];
		j1110131458 -> j1953959033;
	j2149881851 [label="Cieszy mnie Twoja mądrość i zrozumienie wobec przekonań innych.",shape=box,color=blue];
		j2149881851 -> j2574492354;
	j4077766925 [label="Nie, nie pozwala.",shape=box,color=red];
		j4077766925 -> j2222447555;
	j809940362 [label="Szczerze, nie zastanawiam się nad tym.",shape=box,color=red];
		j809940362 -> j3854571455;
	j2981058444 [label="Tak, pozwala.",shape=box,color=red];
		j2981058444 -> j2355443999;
	j3730134610 [label="Są znani z tego, że dostosowują swoje formy, by zadowolić wyznawców innych sekt. Ale to moja wiara, nie Twoja. Nie będę nawracać tych, którzy nie szukają nawrócenia. Tak nie zjednam sobie ludzi.",shape=box,color=blue];
		j3730134610 -> j2115546229;
	j2115546229 [label="Nie, moja wiara to moja sprawa, a Twoja to Twoja. Mam tylko nadzieję, że pozwala Ci zaznać spokoju.",shape=box,color=blue];
		j2115546229 -> j4077766925;
		j2115546229 -> j809940362;
		j2115546229 -> j2981058444;
	j3361640067 [label="Koniec końców, to od nas zależy, jaką drogą będziemy kroczyć. To rozstaj dróg jest pierwszym wyborem, a równowaga stanowi podstawę wszystkiego.",shape=box,color=blue];
		j3361640067 -> j2667031120;
	j3849858526 [label="Ale zastanawiam się... czy ten brak wiary pozwala Ci zaznać spokoju ?",shape=box,color=blue];
		j3849858526 -> j4077766925;
		j3849858526 -> j809940362;
		j3849858526 -> j2981058444;
	j1210868976 [label="O kim myślisz, kiedy mówisz, że \"powinna\" przyjść po nas wszystkich ? Patrzę na Ciebie, na dziecko, na diabła, nawet Monsieur Loida czy le Cardinal... za wami ciągnie się tak wiele lat.",shape=box,color=blue];
		j1210868976 -> j711818743;
	j711818743 [label="Zastanawiam się, ile stuleci rozciąga się przed nami, zanim Lua przyjdzie po nas. I jak chętna będę wpaść w jej objęcia, kiedy czas nadejdzie. Ale to moja wiara, nie Twoja.",shape=box,color=blue];
		j711818743 -> j3849858526;
	j1086283966 [label="Jeszcze nie wiem. Skrzętnie skrywa swoje plany, jak na diabła przystało. Nie wierzy w żadnych bogów, może za wyjątkiem siebie samego.",shape=box,color=blue];
		j1086283966 -> j3849858526;
	j4224228665 [label="Nie, nie wierzy. Jest podobny do Ciebie. Nie wierzy w żadnych bogów, może za wyjątkiem siebie samego.",shape=box,color=blue];
		j4224228665 -> j3849858526;
	j1953959033 [label="Non, każdy, kto przychodzi z otwartym umysłem, zostanie przyjęty z otwartymi ramionami.",shape=box,color=blue];
		j1953959033 -> j2574492354;
	j2574492354 [label="Zastanawiam się tylko, czy pozwala Ci to zaznać spokoju ?",shape=box,color=blue];
		j2574492354 -> j4077766925;
		j2574492354 -> j809940362;
		j2574492354 -> j2981058444;
	j2222447555 [label="Boolean DrifterFaithNoPeace is now true.",color=orange];
		j2222447555 -> j1335646145;
	j3854571455 [label="+10 Chemistry",color=orange];
		j3854571455 -> j2070031419;
	j2355443999 [label="+10 Chemistry",color=orange];
		j2355443999 -> j251618293;
	j2667031120 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j2667031120 -> j2788035462;
	j1335646145 [label="+10 Chemistry",color=orange];
		j1335646145 -> j313688630;
	j2070031419 [label="Zazdrość mnie zżera ! Pochłonęłaby mnie w całkowicie. Chciałabym... jeszcze o tym porozmawiać, jeśli pozwolisz ? Nie chcę prawić Ci kazań ani naciskać.",shape=box,color=blue];
		j2070031419 -> j2905221747;
	j251618293 [label="Więc wiem, że moja Sol uśmiecha się nad Tobą, niezależnie od tego, czy się do niej modlisz czy nie, ponieważ odnalazłeś swoją drogę.",shape=box,color=blue];
		j251618293 -> j1372864585;
	j2788035462 [label="Ach, pardonne-moi ! Mała Marie zaczęła prawić kazania, jakie to żenujące ! Nie miałam na celu Cię pouczać.",shape=box,color=blue];
