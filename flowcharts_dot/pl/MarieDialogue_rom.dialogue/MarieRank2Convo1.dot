digraph {
	302 [label="MarieRank2Convo1 begins.",color=orange];
		302 -> 303;
	303 [label="Mam nadzieję, że nie masz nic przeciwko, ale strasznie mnie to ciekawi. Czy jesteś wierzący ? W Świetlistych, czy kogokolwiek innego.",shape=box,color=blue];
		303 -> 3898;
		303 -> 3899;
		303 -> 3900;
	3898 [label="A co, gdybym powiedział, że jestem bardziej zainteresowany tobą? Czy to byłoby bluźnierstwo?",shape=box,color=red];
		3898 -> 3902;
	3899 [label="Nie, to wcale nie byłoby niegrzeczne.",shape=box,color=red];
		3899 -> 308;
		3899 -> 307;
		3899 -> 306;
		3899 -> 305;
		3899 -> 304;
	3900 [label="[Koniec]",shape=box,color=red];
		3900 -> 3901;
	3902 [label="Update boolean DrifterMarie",color=orange];
		3902 -> 3903;
	308 [label="To... skomplikowane. Wierzę, że coś tam istnieje, ale nie wiem, czy jest to konkretna wiara.",shape=box,color=red];
		308 -> 313;
	307 [label="Tak, jestem, choć nie jest to wiara, którą możesz znać.",shape=box,color=red];
		307 -> 312;
	306 [label="Wierzę w Świetlistych, tak jak Ty.",shape=box,color=red];
		306 -> 311;
	305 [label="Nie, nie wierzę w bogów. To tylko nauka, której jeszcze nie zrozumieliśmy.",shape=box,color=red];
		305 -> 310;
	304 [label="Ciężko powiedzieć. Myślę, że świat jest zbyt skomplikowany, żebym mógł odpowiedzieć na to pytanie.",shape=box,color=red];
		304 -> 309;
	3901 [label="Chat ends.",color=orange];
	3903 [label="Ah, oui ? What is this ? Quelle audace, muszę przyznać, że jestem zaskoczona ! Nie spodziewałam się...",shape=box,color=blue];
		3903 -> 3904;
	313 [label="Update boolean DrifterFaithPersonal",color=orange];
		313 -> 318;
	312 [label="+5 Chemistry",color=orange];
		312 -> 317;
	311 [label="+5 Chemistry",color=orange];
		311 -> 316;
	310 [label="+5 Chemistry",color=orange];
		310 -> 315;
	309 [label="Update boolean DrifterFaithAgnostic",color=orange];
		309 -> 314;
	3904 [label="Ale odciągasz mnie od obowiązków ! Nie mam nic przeciwko, ale jest chyba odrobinę za wcześnie, n'est pas ?",shape=box,color=blue];
		3904 -> 3905;
	318 [label="+5 Chemistry",color=orange];
		318 -> 326;
	317 [label="Odnajduję piękno w każdej wierze, niezależnie od jej nazwy. Opowiedz mi o niej, czy to nowa wiara ? Dawna ? Czy w ogóle zdołam ją rozpoznać ?",shape=box,color=blue];
		317 -> 324;
		317 -> 325;
	316 [label="Naprawdę ! Oh, comme c'est fascinant ! Uwierzyć, że nasza wiara istnieje w tak dalekiej przyszłości, cela remplit mon cœur de joie. Moje serce przepełnia radość. Ale ma to do czynienia z Twoim pobytem w przeszłości, prawda ? Ach, to bez znaczenia.",shape=box,color=blue];
		316 -> 323;
	315 [label="Szanuję Twoją odpowiedź, ale muszę zapytać. Skąd ta pewność ? Czy to samo w sobie nie jest wiarą ? A czym jest Twoja... Indifférence, jeśli nie bogiem ?",shape=box,color=blue];
		315 -> 320;
		315 -> 321;
		315 -> 322;
	314 [label="+10 Chemistry",color=orange];
		314 -> 319;
	3905 [label="Ale... nadal chciałabym uzyskać odpowiedź na moje pytanie, s'il vous plait, jeśli to nie problem. Ale teraz się rumienię !",shape=box,color=blue];
		3905 -> 308;
		3905 -> 307;
		3905 -> 306;
		3905 -> 305;
		3905 -> 304;
	326 [label="Ach, oui. Włóczęga to trafne określenie. Poznałeś wiele kultur, wiele wiar, wiele światów. Cela est très spirituel, non ? Zabrałeś ze sobą skrawki każdego.",shape=box,color=blue];
		326 -> 336;
		326 -> 337;
	324 [label="Wątpię, że byłabyś w stanie ją rozpoznać.",shape=box,color=red];
		324 -> 334;
	325 [label="Możesz kojarzyć pewne aspekty, ale inne byłyby dla Ciebie całkiem obce.",shape=box,color=red];
		325 -> 335;
	323 [label="Zastanawiam się, któremu jesteś oddany ? Czy może kroczysz drogą równowagi ?",shape=box,color=blue];
		323 -> 331;
		323 -> 332;
		323 -> 333;
	320 [label="Nie mogę być pewnym, nikt nie może. Ale nadal nie uważam tego za wiarę w bogów.",shape=box,color=red];
		320 -> 328;
	321 [label="Myślę, że religia istnieje, by pomóc ludziom radzić sobie ze strachem przed śmiercią i nieznanym.",shape=box,color=red];
		321 -> 329;
	322 [label="Nie wiem, czym jest Obojętność, ale na pewno nie bogiem. Po prostu musimy ją zrozumieć. ",shape=box,color=red];
		322 -> 330;
	319 [label="Aach, czyż to nie jest najmądrzejsza ze wszystkich odpowiedzi ! Czy byle śmiertelnicy - jeśli nadal możemy siebie tak nazwać - mogliby pojąć Boskie plany ?",shape=box,color=blue];
		319 -> 327;
	336 [label="Myślę, że istnieje coś starszego, głębszego, bardziej prawdziwego, co przemawia do nas wszystkich. Fundament, który to spaja.",shape=box,color=red];
		336 -> 347;
	337 [label="Dokładnie tak. W każdej z nich dostrzegłem piękno, ale nie wiem, ile było w nich prawdy.",shape=box,color=red];
		337 -> 347;
	334 [label="Update boolean DrifterFaithYesForeign",color=orange];
		334 -> 345;
	335 [label="Update boolean DrifterFaithYesSimilar",color=orange];
		335 -> 346;
	331 [label="Jestem bardziej zbliżony Sol. ",shape=box,color=red];
		331 -> 342;
	332 [label="Jestem bardziej zbliżony Lua.",shape=box,color=red];
		332 -> 343;
	333 [label="Staram się odnaleźć równowagę. Myślę, że to naturalna kolej rzeczy.",shape=box,color=red];
		333 -> 344;
	328 [label="Update boolean DrifterFaithNoMaybe",color=orange];
		328 -> 339;
	329 [label="Update boolean DrifterFaithNoFear",color=orange];
		329 -> 340;
	330 [label="Update boolean DrifterFaithNoMITW",color=orange];
		330 -> 341;
	327 [label="Często spoczywałam w sanktuarium ma Cathédrale i z radością rozmawiałam z obcymi, którzy przybyli w poszukiwaniu nauki i niczego więcej.",shape=box,color=blue];
		327 -> 338;
	347 [label="+5 Chemistry",color=orange];
		347 -> 360;
	345 [label="+5 Chemistry",color=orange];
		345 -> 358;
	346 [label="+5 Chemistry",color=orange];
		346 -> 359;
	342 [label="Update boolean DrifterFaithSol",color=orange];
		342 -> 355;
	343 [label="Update boolean DrifterFaithLua",color=orange];
		343 -> 356;
	344 [label="Update boolean DrifterFaithBalance",color=orange];
		344 -> 357;
	339 [label="Oui, je vois... Może musisz odnaleźć własny \"dowód\"? Czy w Twoim życiu nie miało miejsce nic, co przepełniło Cię takim poczuciem, jakim jest dla nas wiara ?",shape=box,color=blue];
		339 -> 350;
		339 -> 351;
	340 [label="Oui, c'est vrai - to prawda. Wiara to odpowiedź na wiele pytań zadawanych przez wiele dusz. Czy Ty nie lękasz się tego, co następuje po śmierci ?",shape=box,color=blue];
		340 -> 352;
		340 -> 353;
	341 [label="Comme c'est fascinant... i oto pojawił się kolejny, który wypowiedział te same słowa... tak samo szeptał diabeł.",shape=box,color=blue];
		341 -> 354;
	338 [label="Tak ciekawi naszej wiary, ale niechętni powiedzieć \"tak, dokładnie taka jest prawda\". Mam nadzieję, że dałam im część naszej radości.",shape=box,color=blue];
		338 -> 348;
		338 -> 349;
	360 [label="Je comprends, et cela est magnifique. Często zastanawiałam się, czy Świetliści nie skrywali się za innymi nazwami.",shape=box,color=blue];
		360 -> 373;
	358 [label="Oh, comme c'est fascinant ! Chciałabym pewnego dnia dowiedzieć się więcej o Twojej wierze. Poznać Twoje rytuały.",shape=box,color=blue];
		358 -> 371;
		358 -> 372;
	359 [label="Oh, comme c'est fascinant ! Chciałabym pewnego dnia dowiedzieć się o ich podobieństwach i różnicach.",shape=box,color=blue];
		359 -> 371;
		359 -> 372;
	355 [label="+10 Chemistry",color=orange];
		355 -> 368;
	356 [label="+5 Chemistry",color=orange];
		356 -> 369;
	357 [label="+5 Chemistry",color=orange];
		357 -> 370;
	350 [label="Nie, po prostu nie jestem wierzący.",shape=box,color=red];
		350 -> 363;
	351 [label="Dokładnie tak było. Nigdy nie... \"poczułem\" wiary. Ani jej nie potrzebowałem.",shape=box,color=red];
		351 -> 364;
	352 [label="Wszyscy kiedyś umrą. Lęk przed śmiercią to głupota, ona przyjdzie po nas wszystkich. A przynajmniej powinna.",shape=box,color=red];
		352 -> 365;
	353 [label="Umarłem już tyle razy, że nie boję się śmierci. Przyjmuję ją z otwartymi ramionami.",shape=box,color=red];
		353 -> 366;
	354 [label="+5 Chemistry",color=orange];
		354 -> 367;
	348 [label="Zaskakuje mnie Twoja otwartość na ludzi, którzy nie podzielają Twojej wiary.",shape=box,color=red];
		348 -> 361;
	349 [label="Dokładnie o to chodzi. Nie chcę mówić, że któraś z decyzji jest \"dobra\" albo \"zła\".",shape=box,color=red];
		349 -> 362;
	373 [label="Są znani z tego, że dostosowują swoje formy, by zadowolić wyznawców innych sekt. Ale to moja wiara, nie Twoja.",shape=box,color=blue];
		373 -> 386;
	371 [label="Też z chęcią o tym porozmawiam.",shape=box,color=red];
		371 -> 384;
	372 [label="Zaskakuje mnie Twoja otwartość na inne wiary. ",shape=box,color=red];
		372 -> 385;
	368 [label="Moja bratnia dusza ! Ta wieść przynosi mi wiele radości. Mam nadzieję, że nie kłamiesz, by mi się przypodobać.",shape=box,color=blue];
		368 -> 382;
	369 [label="Ach, wędrowiec podąża tą samą ścieżką nocy, jak mój drogi Leon. Porozmawiaj z nim o naszej Pani Nocy, kiedy będzie gotowy, sprawi mu to wiele radości.",shape=box,color=blue];
		369 -> 382;
	370 [label="Równowaga bez chwili zawahania. Iść przez życie wiedząc, że po każdym wschodzie słońca musi wzejść też księżyc, ale nigdy nie dać się pokonać niepewności ?",shape=box,color=blue];
		370 -> 383;
	363 [label="+5 Chemistry",color=orange];
		363 -> 376;
	364 [label="+5 Chemistry",color=orange];
		364 -> 377;
	365 [label="+5 Chemistry",color=orange];
		365 -> 378;
	366 [label="+5 Chemistry",color=orange];
		366 -> 379;
	367 [label="Moje serce się kraje na myśl o złożeniu w nim jakiejkolwiek wiary, ale to ? Może powinieneś z nim porozmawiać. Ale miej się na uwadze. Taniec z diabłem to niebezpieczna gra.",shape=box,color=blue];
		367 -> 380;
		367 -> 381;
	361 [label="To może być dla Ciebie zaskoczenie, że ktoś, kto nosi ten habit, nie żywi surowych oczekiwań wobec innych. Łatwo zniechęcić do sobie ludzi, próbując nawrócić tych, którzy nie szukają zbawienia.",shape=box,color=blue];
		361 -> 374;
	362 [label="+5 Chemistry",color=orange];
		362 -> 375;
	386 [label="Mam tylko nadzieję, że wiara pozwala Ci odnaleźć spokój.",shape=box,color=blue];
		386 -> 394;
		386 -> 395;
		386 -> 396;
	384 [label="Ô joie ! Uwielbiam poznawać inne wiary. Często zastanawiałam się, czy Świetliści nie skrywali się za innymi nazwami.",shape=box,color=blue];
		384 -> 398;
	385 [label="To może być dla Ciebie zaskoczenie, że ktoś, kto nosi ten habit, nie żywi surowych oczekiwań wobec innych. Łatwo zniechęcić do sobie ludzi, próbując nawrócić tych, którzy nie szukają zbawienia.",shape=box,color=blue];
		385 -> 399;
	382 [label="Zastanawiam się tylko, czy nasza wiara pozwala Ci zaznać spokoju ?",shape=box,color=blue];
		382 -> 394;
		382 -> 395;
		382 -> 396;
	383 [label="To rzadki dar... i mam nadzieję, że dobrze go wykorzystasz. Stać na rozstaju dróg to prosta droga, by zostać pochłoniętym przez konflikt.",shape=box,color=blue];
		383 -> 397;
	376 [label="To musi być prostsze życie. Nie żyć według zasad bogów i kościołów. Muszę przyznać, że trochę Ci tego zazdroszczę.",shape=box,color=blue];
		376 -> 389;
	377 [label="Zazdroszczę Ci tego, wędrowcze ! Przeżyć tak wiele lat, nie odczuwając potrzeby poznania bogów.",shape=box,color=blue];
		377 -> 389;
	378 [label="Mówisz jak wyznawca Lua i nie mówię tego jako obelga. Oui, Jędza przyjdzie po nas wszystkich i uroni swoje srebrne łzy. Ale to nie Twoje słowa powodują zadumę...",shape=box,color=blue];
		378 -> 390;
	379 [label="Oui, to mnie zastanawia. Patrzę na Ciebie, na dziecko, na diabła, nawet Monsieur Loida czy le Cardinal... za wami ciągnie się tak wiele lat.",shape=box,color=blue];
		379 -> 391;
	380 [label="O jakiej grze mówisz?",shape=box,color=red];
		380 -> 392;
	381 [label="Nie wierzy chyba, że Pan ze Ściany istnieje?",shape=box,color=red];
		381 -> 393;
	374 [label="+5 Chemistry",color=orange];
		374 -> 387;
	375 [label="Cieszy mnie Twoja mądrość i zrozumienie wobec przekonań innych.",shape=box,color=blue];
		375 -> 388;
	394 [label="Nie, nie pozwala.",shape=box,color=red];
		394 -> 400;
	395 [label="Szczerze, nie zastanawiam się nad tym.",shape=box,color=red];
		395 -> 401;
	396 [label="Tak, pozwala.",shape=box,color=red];
		396 -> 402;
	398 [label="Są znani z tego, że dostosowują swoje formy, by zadowolić wyznawców innych sekt. Ale to moja wiara, nie Twoja. Nie będę nawracać tych, którzy nie szukają nawrócenia. Tak nie zjednam sobie ludzi.",shape=box,color=blue];
		398 -> 399;
	399 [label="Nie, moja wiara to moja sprawa, a Twoja to Twoja. Mam tylko nadzieję, że pozwala Ci zaznać spokoju.",shape=box,color=blue];
		399 -> 394;
		399 -> 395;
		399 -> 396;
	397 [label="Koniec końców, to od nas zależy, jaką drogą będziemy kroczyć. To rozstaj dróg jest pierwszym wyborem, a równowaga stanowi podstawę wszystkiego.",shape=box,color=blue];
		397 -> 403;
	389 [label="Ale zastanawiam się... czy ten brak wiary pozwala Ci zaznać spokoju ?",shape=box,color=blue];
		389 -> 394;
		389 -> 395;
		389 -> 396;
	390 [label="O kim myślisz, kiedy mówisz, że \"powinna\" przyjść po nas wszystkich ? Patrzę na Ciebie, na dziecko, na diabła, nawet Monsieur Loida czy le Cardinal... za wami ciągnie się tak wiele lat.",shape=box,color=blue];
		390 -> 391;
	391 [label="Zastanawiam się, ile stuleci rozciąga się przed nami, zanim Lua przyjdzie po nas. I jak chętna będę wpaść w jej objęcia, kiedy czas nadejdzie. Ale to moja wiara, nie Twoja.",shape=box,color=blue];
		391 -> 389;
	392 [label="Jeszcze nie wiem. Skrzętnie skrywa swoje plany, jak na diabła przystało. Nie wierzy w żadnych bogów, może za wyjątkiem siebie samego.",shape=box,color=blue];
		392 -> 389;
	393 [label="Nie, nie wierzy. Jest podobny do Ciebie. Nie wierzy w żadnych bogów, może za wyjątkiem siebie samego.",shape=box,color=blue];
		393 -> 389;
	387 [label="Non, każdy, kto przychodzi z otwartym umysłem, zostanie przyjęty z otwartymi ramionami.",shape=box,color=blue];
		387 -> 388;
	388 [label="Zastanawiam się tylko, czy pozwala Ci to zaznać spokoju ?",shape=box,color=blue];
		388 -> 394;
		388 -> 395;
		388 -> 396;
	400 [label="Update boolean DrifterFaithNoPeace",color=orange];
		400 -> 404;
	401 [label="+10 Chemistry",color=orange];
		401 -> 405;
	402 [label="+10 Chemistry",color=orange];
		402 -> 406;
	403 [label="Update boolean DrifterCrossroads",color=orange];
		403 -> 407;
	404 [label="+10 Chemistry",color=orange];
		404 -> 408;
	405 [label="Zazdrość mnie zżera ! Pochłonęłaby mnie w całkowicie. Chciałabym... jeszcze o tym porozmawiać, jeśli pozwolisz ? Nie chcę prawić Ci kazań ani naciskać.",shape=box,color=blue];
		405 -> 409;
	406 [label="Więc wiem, że moja Sol uśmiecha się nad Tobą, niezależnie od tego, czy się do niej modlisz czy nie, ponieważ odnalazłeś swoją drogę.",shape=box,color=blue];
		406 -> 410;
	407 [label="Ach, pardonne-moi ! Mała Marie zaczęła prawić kazania, jakie to żenujące ! Nie miałam na celu Cię pouczać.",shape=box,color=blue];
		407 -> 382;
	408 [label="Porusza mnie Twoja szczerość, wędrowcze. Chciałabym... jeszcze o tym porozmawiać, jeśli pozwolisz ? Nie chcę prawić Ci kazań ani naciskać.",shape=box,color=blue];
		408 -> 409;
	409 [label="Jestem po prostu ciekawa i chcę Ci pomóc, jeśli zdołam. Proszę, jeśli powiesz \"nie\", już nigdy do tego nie wrócimy.",shape=box,color=blue];
		409 -> 411;
		409 -> 412;
	410 [label="Czy możemy jeszcze powrócić do tego tematu ? Tak bardzo pragnę dowiedzieć się więcej.",shape=box,color=blue];
		410 -> 411;
		410 -> 412;
	411 [label="Nie, dziękuję.",shape=box,color=red];
		411 -> 413;
	412 [label="Oczywiście.",shape=box,color=red];
		412 -> 414;
	413 [label="Update boolean DrifterFaithStop",color=orange];
		413 -> 415;
	414 [label="Merci, merci ! Nie mogę zawieść zaufania, które we mnie złożyłeś. Do następnego razu.",shape=box,color=blue];
		414 -> 416;
	415 [label="Rozumiem i nie żywię urazy. Dziękuję, że mnie wysłuchałeś i doceniam wszystko, czym się ze mną podzieliłeś. Porozmawiamy jeszcze o wielu sprawach, Sol wie, że mi ich nie brakuje !",shape=box,color=blue];
		415 -> 417;
	416 [label="Chat ends.",color=orange];
	417 [label="Chat ends.",color=orange];
}