digraph {
	3964 [label="MarieRank1Convo5 begins.",color=orange];
		3964 -> 3965;
	3965 [label="Bonjour, bonjour ! Musisz być Włóczęgą, oui ? Monsieur Loid tyle mi o tobie opowiadał. Bardzo się cieszę, że mogę cię \"poznać\" na tym...",shape=box,color=blue];
		3965 -> 3966;
	3966 [label="Appareil cliquetant, które jest nadzwyczaj fascynujące !",shape=box,color=blue];
		3966 -> 3967;
	3967 [label="Jestem Sœur Marie Leroux, ale możesz mówić mi Maria. Niedawno pojawiłam się tutaj wraz z bratem mojej duszy, Ojcem Leonem Allardem i... myślę, że Monsieur Loid już ostrzegł cię przed diabłem, n'est-ce pas ?",shape=box,color=blue];
		3967 -> 3968;
		3967 -> 3969;
		3967 -> 3970;
	3968 [label="Bardzo miło mi cię poznać. Nie zrozum mnie źle, cieszę się, że tu jesteś, ale... dlaczego tu jesteś?",shape=box,color=red];
		3968 -> 3972;
	3969 [label="Diabeł? Chodzi o tego Orokina?",shape=box,color=red];
		3969 -> 3974;
	3970 [label="[Koniec]",shape=box,color=red];
		3970 -> 3971;
	3972 [label="+5 Chemistry",color=orange];
		3972 -> 3973;
	3974 [label="Oui, ce monstre irritant à la peau bleue, który został nam powierzony w opiekę przez le Cardinal, który był ci znany jako Albrecht Entrati ? To dlatego tutaj jesteśmy. Ale to bardzo długa historia, j'en ai bien peur.",shape=box,color=blue];
		3974 -> 3975;
		3974 -> 3976;
	3971 [label="Chat ends.",color=orange];
	3973 [label="Merci ! The what and the how of our being here is a very long story, j'en ai bien peur. We were sent here by le Cardinal. I believe you know him as Albrecht Entrati ? He entrusted us with that blue-skinned monstre irritant.",shape=box,color=blue];
		3973 -> 3975;
		3973 -> 3976;
	3975 [label="Zrobię wszystko co w mojej mocy, żeby pomóc.",shape=box,color=red];
		3975 -> 3980;
	3976 [label="\"Powierzył\"?",shape=box,color=red];
		3976 -> 3977;
	3980 [label="+5 Chemistry",color=orange];
		3980 -> 3981;
	3977 [label="Mamy za zadanie nawrócić jego duszę, si c'est possible. Et si ce n'est pas le cas ? Potem musimy upewnić się, że przynajmniej nie wyrządzi więcej szkód.",shape=box,color=blue];
		3977 -> 3978;
		3977 -> 3979;
	3981 [label="Jesteś dokładnie taki, jak mówili Monsieur Loid i Cavia ! Jestem pewna, że zostaniemy dobrymi przyjaciółmi.",shape=box,color=blue];
		3981 -> 3983;
	3978 [label="Spróbuję wam pomóc.",shape=box,color=red];
		3978 -> 3980;
	3979 [label="To Orokin. Jedyny sposób, żeby to zrobić, to wpakować mu kulkę między oczy.",shape=box,color=red];
		3979 -> 3982;
	3983 [label="Ach ! Muszę już iść, wybacz mi. Mam nadzieję, że wkrótce znów pomówimy ! À la revoyure !",shape=box,color=blue];
		3983 -> 3984;
	3982 [label="Brzmisz zupełnie jak Leon. Nie poddam się. Nie teraz.",shape=box,color=blue];
		3982 -> 3983;
	3984 [label="Chat ends.",color=orange];
}