digraph {
	"MarieRank1Convo5 begins." [color=orange];
		"MarieRank1Convo5 begins." -> j2731998738;
	j2731998738 [label="Bonjour, bonjour ! Musisz być Włóczęgą, oui ? Monsieur Loid tyle mi o tobie opowiadał. Bardzo się cieszę, że mogę cię \"poznać\" na tym...",shape=box,color=blue];
		j2731998738 -> j344825975;
	j344825975 [label="Appareil cliquetant, które jest nadzwyczaj fascynujące !",shape=box,color=blue];
		j344825975 -> j2305243657;
	j2305243657 [label="Jestem Sœur Marie Leroux, ale możesz mówić mi Maria. Niedawno pojawiłam się tutaj wraz z bratem mojej duszy, Ojcem Leonem Allardem i... myślę, że Monsieur Loid już ostrzegł cię przed diabłem, n'est-ce pas ?",shape=box,color=blue];
		j2305243657 -> j3864012612;
		j2305243657 -> j3819369537;
		j2305243657 -> j386906797;
	j3864012612 [label="Bardzo miło mi cię poznać. Nie zrozum mnie źle, cieszę się, że tu jesteś, ale... dlaczego tu jesteś?",shape=box,color=red];
		j3864012612 -> j3772422937;
	j3819369537 [label="Diabeł? Chodzi o tego Orokina?",shape=box,color=red];
		j3819369537 -> j2939896297;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j3772422937 [label="+5 Chemistry",color=orange];
		j3772422937 -> j2216901044;
	j2939896297 [label="Oui, ce monstre irritant à la peau bleue, który został nam powierzony w opiekę przez le Cardinal, który był ci znany jako Albrecht Entrati ? To dlatego tutaj jesteśmy. Ale to bardzo długa historia, j'en ai bien peur.",shape=box,color=blue];
		j2939896297 -> j573640544;
		j2939896297 -> j871821825;
	"Chat ends." [color=orange];
	j2216901044 [label="Merci ! To, dlaczego i jak się tu znaleźliśmy, to bardzo długa historia, j'en ai bien peur. Zostaliśmy tu zesłani przez le Cardinal, który jest ci znany jako Albrecht Entrati ? Powierzył w naszą opiekę tego monstre o niebieskiej skórze.",shape=box,color=blue];
		j2216901044 -> j573640544;
		j2216901044 -> j871821825;
	j573640544 [label="Zrobię wszystko co w mojej mocy, żeby pomóc.",shape=box,color=red];
		j573640544 -> j737612936;
	j871821825 [label="\"Powierzył\"?",shape=box,color=red];
		j871821825 -> j4130894975;
	j737612936 [label="+5 Chemistry",color=orange];
		j737612936 -> j1418301396;
	j4130894975 [label="Mamy za zadanie nawrócić jego duszę, si c'est possible. Et si ce n'est pas le cas ? Potem musimy upewnić się, że przynajmniej nie wyrządzi więcej szkód.",shape=box,color=blue];
		j4130894975 -> j693737317;
		j4130894975 -> j4173334244;
	j1418301396 [label="Jesteś dokładnie taki, jak mówili Monsieur Loid i Cavia ! Jestem pewna, że zostaniemy dobrymi przyjaciółmi.",shape=box,color=blue];
		j1418301396 -> j4277651437;
	j693737317 [label="Spróbuję wam pomóc.",shape=box,color=red];
		j693737317 -> j737612936;
	j4173334244 [label="To Orokin. Jedyny sposób, żeby to zrobić, to wpakować mu kulkę między oczy.",shape=box,color=red];
		j4173334244 -> j250646001;
	j4277651437 [label="Ach ! Muszę już iść, wybacz mi. Mam nadzieję, że wkrótce znów pomówimy ! À la revoyure !",shape=box,color=blue];
		j4277651437 -> "Chat ends.";
	j250646001 [label="Brzmisz zupełnie jak Leon. Nie poddam się. Nie teraz.",shape=box,color=blue];
		j250646001 -> j4277651437;
}