		2710 -> 2720;
	2711 [label="Update boolean MarieNoDate",color=orange];
		2711 -> 2721;
	2712 [label="Nie jesteś głupia, naprawdę. To wręcz dowodzi, jak wspaniała naprawdę jesteś.",shape=box,color=red];
		2712 -> 2722;
	2713 [label="Stałaś się dla mnie bardzo ważna... i bardzo mi przykro, że ta rozmowa potoczyła się w taki sposób.",shape=box,color=red];
		2713 -> 2722;
	2714 [label="To byłoby dla ciebie oczywiste, non ? Dla kogoś, kto też stracił rodzinę.",shape=box,color=blue];
		2714 -> 2723;
	2715 [label="Przekonamy się. Myślę, że ujrzałam w nim ojca, który mnie porzucił, jakkolwiek smutne i nieznaczące to teraz jest.",shape=box,color=blue];
		2715 -> 2723;
	2716 [label="Je ne pense pas.",shape=box,color=blue];
		2716 -> 2724;
	2717 [label="À la revoyure.",shape=box,color=blue];
		2717 -> 2725;
	2718 [label="Muszę więc przyznać, że nigdy nie będę mogła zaufać ci całym sercem. Powiedziałabym, że przykro mi to mówić, ale...",shape=box,color=blue];
		2718 -> 2726;
	2719 [label="To byłoby dla ciebie oczywiste, non ? Ktoś, kto też stracił rodzinę.",shape=box,color=blue];
		2719 -> 2727;
	2720 [label="Przekonamy się. Myślę, że ujrzałam w nim ojca, który mnie porzucił, jakkolwiek smutne i nieznaczące to teraz jest.",shape=box,color=blue];
		2720 -> 2727;
	2721 [label="Chat ends.",color=orange];
	2722 [label="Chcę, żebyś zrozumiała, że Entrati może być złożonym człowiekiem. Że jest też zdolny do wyrządzenia wielu szkód. Nie chcę, żeby później zranił cię jeszcze bardziej.",shape=box,color=red];
		2722 -> 2728;
	2723 [label="Pomyśleć... że po tylu latach dałam się nabrać komuś, kto okazał mi taką życzliwość ?",shape=box,color=blue];
		2723 -> 2729;
	2724 [label="Update boolean MarieEntratiCompleteB",color=orange];
		2724 -> 2730;
	2725 [label="Update boolean MarieEntratiCompleteC",color=orange];
		2725 -> 2731;
	2726 [label="Ale obawiam się, że prawda jest inna i mam nadzieję, że nie jest to dla ciebie zaskoczeniem.",shape=box,color=blue];
		2726 -> 2732;
	2727 [label="Pomyśleć... że po tylu latach dałam się nabrać komuś, kto okazał mi taką życzliwość ?",shape=box,color=blue];
		2727 -> 2733;
	2728 [label="Co głupie, w tym wszystkim starałem się o twoje dobro. ",shape=box,color=red];
		2728 -> 2734;
	2729 [label="Foolish little Marie... of course, he was not all that he seemed.",shape=box,color=blue];
		2729 -> 2735;
	2730 [label="Update boolean MarieWillDate",color=orange];
		2730 -> 2736;
	2731 [label="Update boolean MarieWillDate",color=orange];
		2731 -> 2737;
	2732 [label="As for the matter of le Cardinal ? I suppose we shall remain parted on the topic. As we shall remain parted in our affections.",shape=box,color=blue];
		2732 -> 2738;
	2733 [label="Foolish little Marie... of course, he was not all that he seemed.",shape=box,color=blue];
		2733 -> 2739;
		2733 -> 2735;
	2734 [label="Evaluate expressions",color=orange];
		2734 -> 2740 [label="LyonDating",color=purple];
		2734 -> 2741 [label="RoatheDating",color=purple];
		2734 -> 2742 [label="false",color=purple];
	2735 [label="No, he was kind to you. That wasn't a lie. But that doesn't mean that's all he is, and all he's capable of.",shape=box,color=red];
		2735 -> 2743;
	2736 [label="Chat ends.",color=orange];
	2737 [label="Chat ends.",color=orange];
	2738 [label="Au revoir.",shape=box,color=blue];
		2738 -> 2744;
	2739 [label="[Wyznaj uczucia] Nie jesteś głupia, naprawdę. To wręcz dowodzi, jak wspaniała naprawdę jesteś.",shape=box,color=red];
		2739 -> 2745;
	2740 [label="I mówisz mi o tym, jednocześnie wyznając miłość bratu mojej duszy ?! Naprawdę myślisz, że zrobisz z nas oboje idiotów ?!",shape=box,color=blue];
		2740 -> 2746;
	2741 [label="I mówisz mi o tym, jednocześnie zabawiając się z diabłem ?! Naprawdę myślisz, że zrobisz z nas oboje idiotów ?!",shape=box,color=blue];
		2741 -> 2746;
	2742 [label="I... Oh, mon cœur. Mon cœur ! Oh, how I feel the same ! But I did not dare speak the words, I did not dare write them to you - for I thought myself a fool for them.",shape=box,color=blue];
		2742 -> 2747;
	2743 [label="Oui, as you said, and so I now see plainly. I... am simply left to thank you for your patience once more.",shape=box,color=blue];
		2743 -> 2748;
	2744 [label="Update boolean MarieNoDate",color=orange];
		2744 -> 2749;
	2745 [label="You've become so important to me, Marie... and I'm so sorry that this conversation has gone the way that it has.",shape=box,color=red];
		2745 -> 2750;
	2746 [label="Update boolean DrifterMarieWhoops",color=orange];
		2746 -> 2751;
	2747 [label="Ah ! You have made me so happy ! I wonder... what you intend to do with this statement... ?",shape=box,color=blue];
		2747 -> 2752;
		2747 -> 2753;
	2748 [label="In my desperation to hold on to a father now gone, I nearly drove away a family still here.",shape=box,color=blue];
		2748 -> 2754;
	2749 [label="Update boolean MarieEntratiCompleteB",color=orange];
		2749 -> 3890;
	2750 [label="Chcę, żebyś zrozumiała, że Entrati może być złożonym człowiekiem. Że jest też zdolny do wyrządzenia wielu szkód. Nie chcę, żeby później zranił cię jeszcze bardziej.",shape=box,color=red];
		2750 -> 2756;
	2751 [label="Update boolean MarieNoDate",color=orange];
		2751 -> 2757;
	2752 [label="[Ask to date.] Well, I was wondering... if you'd like to, well... become a couple?",shape=box,color=red];
		2752 -> 2758;
	2753 [label="I figured we would take our time with it. We're still learning about each other.",shape=box,color=red];
		2753 -> 2759;
	2754 [label="And I think I am not the only one, non ? I... think I am now properly armed to help with the battle we face with those upstairs, oui ?",shape=box,color=blue];
