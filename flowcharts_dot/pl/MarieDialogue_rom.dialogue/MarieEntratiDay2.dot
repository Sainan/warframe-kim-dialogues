	2699 [label="Po prostu nie chcę, żebyś miał o mnie gorsze zdanie, gdybym wyznała ci prawdę. To wszystko jest takie pathétique.",shape=box,color=blue];
		2699 -> 2709;
		2699 -> 2710;
	2700 [label="Update boolean MarieEntratiCompleteB",color=orange];
		2700 -> 2711;
	2701 [label="Pozwól mi... wyjaśnić, dlaczego trudno mi odwrócić się od le Cardinal, i dlaczego potrzebowałam chwili, by zrozumieć, dlaczego nie byłam do tego zdolna.",shape=box,color=blue];
		2701 -> 2699;
	2702 [label="Głupia mała Maria... oczywiście, że nie wszystko było takie, na jakie wyglądało.",shape=box,color=blue];
		2702 -> 2712;
		2702 -> 2713;
	2703 [label="Chyba już wiem, o co ci chodzi.",shape=box,color=red];
		2703 -> 2714;
	2704 [label="Nie będę miał o tobie gorszego zdania, obiecuję.",shape=box,color=red];
		2704 -> 2715;
	2705 [label="Add -10 to Family",color=orange];
		2705 -> 2716;
	2706 [label="Bien. Doszliśmy do porozumienia.",shape=box,color=blue];
		2706 -> 2717;
	2707 [label="By zawitać do mojego łoża ? To podłe.",shape=box,color=blue];
		2707 -> 2718;
	2708 [label="Żeby mnie wykorzystać ? To podłe.",shape=box,color=blue];
		2708 -> 2718;
