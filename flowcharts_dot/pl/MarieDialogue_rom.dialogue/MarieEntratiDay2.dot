digraph {
	2615 [label="MarieEntratiDay2 begins.",color=orange];
		2615 -> 2616;
	2616 [label="Drifter. I have taken some time to think and to... calm myself. I have a strict rule regarding engaging in conversations while I am furieuse.",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="Evaluate expressions",color=orange];
		2617 -> 2618 [label="MarieEntrati5a",color=purple];
		2617 -> 2619 [label="MarieEntrati5b",color=purple];
		2617 -> 2620 [label="MarieEntrati5c",color=purple];
		2617 -> 2621 [label="MarieEntrati5d",color=purple];
		2617 -> 2622 [label="MarieEntrati5e",color=purple];
		2617 -> 2623 [label="MarieEntrati5f",color=purple];
		2617 -> 2624 [label="MarieEntrati5g",color=purple];
		2617 -> 2625 [label="MarieEntrati5h",color=purple];
		2617 -> 2626 [label="MarieEntrati5i",color=purple];
		2617 -> 2627 [label="false",color=purple];
	2618 [label="It was... a dagger between the ribs you paid me, yesterday. I admit I fled in anger, oui, but also répulsion. Not at you, but at myself.",shape=box,color=blue];
		2618 -> 2628;
	2619 [label="But before we continue, I must address one matter first - your own tone when speaking to me. I know you must think me a child. You are centuries old, if not more.",shape=box,color=blue];
		2619 -> 2629;
	2620 [label="I spent much time thinking over your words. That this is not a holy war and that le Cardinal has been manipulative in his ways.",shape=box,color=blue];
		2620 -> 2630;
	2621 [label="You were... of course, correct in your question to ask me where in the scriptures of Sol it states that innocents are expendable. It does not.",shape=box,color=blue];
		2621 -> 2631;
	2622 [label="Before we continue, I must address one matter first - your willingness to wield my faith against me in an argument, where you do not engage with faith yourself.",shape=box,color=blue];
		2622 -> 2632;
	2623 [label="I... am sorry for fleeing our conversation yesterday. It was simply too much. I must ask you, though, before we continue - did you mean your words ? Or were you merely trying to manipulate my feelings to spare yourself an uncomfortable argument ?",shape=box,color=blue];
		2623 -> 2633;
		2623 -> 2634;
	2624 [label="It appears we have come to an impasse, in regards to le Cardinal, oui ? You view him as a monstre, and I, a saint.",shape=box,color=blue];
		2624 -> 2635;
	2625 [label="I wish to speak to you about your decision to side with Entrati only to get into my good graces, if you are willing.",shape=box,color=blue];
		2625 -> 2636;
	2626 [label="I wish to speak to you about your lie, now, if you are willing.",shape=box,color=blue];
		2626 -> 2636;
	2627 [label="Chat ends.",color=orange];
	2628 [label="How could I be surprised that you were so deadly precise with your aim ? To compare my words with that of the devil...",shape=box,color=blue];
		2628 -> 2637;
	2629 [label="You have traveled through unknown dimensions, through the Void itself. Battled gods and angels. Who am I, to you, oui ? Just silly little Marie.",shape=box,color=blue];
		2629 -> 2638;
	2630 [label="And I believe... oui, you are correct. This is not a holy war. For there is no such thing. War is never holy, just, or righteous. Pain should never be the guiding light.",shape=box,color=blue];
		2630 -> 2639;
	2631 [label="War is never holy, just, or righteous. Pain should never be the guiding light.",shape=box,color=blue];
		2631 -> 2639;
	2632 [label="This was disingenuous, Drifter. Cruel, and ineffectual. It was an attempt to \"win\" a conversation, and it was not how one should comport oneself.",shape=box,color=blue];
		2632 -> 2640;
	2633 [label="I meant my words. I'm sorry if my timing was... off. I care about you deeply, Marie...",shape=box,color=red];
		2633 -> 2641;
	2634 [label="I didn't mean them, I was just... caught up. I'm very, very sorry. The passion of the moment.",shape=box,color=red];
		2634 -> 2642;
	2635 [label="However... I do not wish to leave things in such a way between us. You are a kind soul, and there is much between us that I do not want to leave soured.",shape=box,color=blue];
		2635 -> 2946;
	2636 [label="Attempting to manipulate the situation in order to control my feelings is... disingenuous and cruel. I admit I am eager to hate you for it, Drifter.",shape=box,color=blue];
		2636 -> 2644;
	2637 [label="I would think myself someone whose mind and heart is open to the world and all those within it. And you succinctly, and with a single barbed arrow, proved me wrong.",shape=box,color=blue];
		2637 -> 2645;
	2638 [label="On one hand, I understand this. I sympathize. Both our tempers were raised. But on the other, I ask for you to regard me instead with more grace and tact than you have.",shape=box,color=blue];
		2638 -> 2646;
	2639 [label="Even what we do now - destroying the Murmure and fighting against all your many enemies - is not the path of the Luminaries.",shape=box,color=blue];
		2639 -> 2647;
	2640 [label="Faith is not, nor should it ever be, a weapon to be used against another. It is a shield. A light in the darkness. A voice to guide the way.",shape=box,color=blue];
		2640 -> 2648;
	2641 [label="Before I face the - the enormity of that, I must explain myself regarding le Cardinal, s'il vous plaît.",shape=box,color=blue];
		2641 -> 2649;
	2642 [label="Update boolean DrifterMarie",color=orange];
		2642 -> 2650;
	2946 [label="Check boolean LoidFamilyComplete",color=orange];
		2946 -> 2651 [label=true,color=green];
		2946 -> 2643 [label=false,color=brown];
	2644 [label="However... I do not wish to leave things in such a way between us. There is much between us that I do not want to leave soured.",shape=box,color=blue];
		2644 -> 1395;
	2645 [label="I suppose I am here pour m'excuser - to say I am deeply sorry for being so foolishly entrenched. I hope you understand.",shape=box,color=blue];
		2645 -> 2653;
		2645 -> 2654;
	2646 [label="For I have lived on the streets. I have lived every day of my life in physical agonie. I have known heartbreak, I have known love, I have known fear and rejection. I have known life and loss.",shape=box,color=blue];
		2646 -> 2655;
	2647 [label="Necessary as it may be to lift the sword, lest the world be overrun by their ilk, it is not to be venerated. And it is certainly not excusable when innocents are harmed in its wake.",shape=box,color=blue];
		2647 -> 2656;
	2648 [label="And for you to attempt to use it against me to simply \"defeat\" me? It was a cowardly tactic. But both our tempers were raised, and I will... forgive you, if you will forgive me, for words said in anger.",shape=box,color=blue];
		2648 -> 2657;
		2648 -> 2658;
	2649 [label="It is hard for me, I think, to abandon my defense of le Cardinal... and it took me some time to understand why I could not let him go.",shape=box,color=blue];
		2649 -> 2659;
	2650 [label="Non, I understand... How many murders have been committed as \"crimes of passion,\" oui ? Certainly as many children have been created in moments of them as well.",shape=box,color=blue];
		2650 -> 2660;
	2651 [label="And you have become important to me, in such a short time... I have found our conversations so joyeuses.",shape=box,color=blue];
		2651 -> 2661;
	2643 [label="Indeed, I still wish to see Monsieur Loid united with those above. I wish to see solace brought to le Cardinal's remaining family, and you are the road to this ! ",shape=box,color=blue];
		2643 -> 2651;
	1395 [label="Check boolean LoidFamilyComplete",color=orange];
		1395 -> 2662 [label=true,color=green];
		1395 -> 2652 [label=false,color=brown];
	2653 [label="I do. And I'm sorry if my words hurt you. I just didn't know how else to say them.",shape=box,color=red];
		2653 -> 2663;
	2654 [label="I'm glad my words go through to you. I was starting to lose hope.",shape=box,color=red];
		2654 -> 2664;
	2655 [label="And if you truly believe yourself to so high above us all, than you will see nothing but the clouds in which you are lost.",shape=box,color=blue];
		2655 -> 2657;
		2655 -> 2658;
	2656 [label="So... I will concede that le Cardinal is not justified in harming others in the name of a \"greater good.\"",shape=box,color=blue];
		2656 -> 2665;
	2657 [label="I got frustrated, but I don't know how else to make you see sense. Entrati isn't your friend. Or your father.",shape=box,color=red];
		2657 -> 2666;
	2658 [label="I'm sorry. I let my temper get the better of me, and I said things I didn't mean to.",shape=box,color=red];
		2658 -> 2667;
	2659 [label="Po prostu nie chcę, żebyś miał o mnie gorsze zdanie, gdybym wyznała ci prawdę. To wszystko jest takie pathétique.",shape=box,color=blue];
		2659 -> 2668;
		2659 -> 2669;
	2660 [label="Jestem... zawiedziona. Zraniona. Ale... wybaczam ci.",shape=box,color=blue];
		2660 -> 2670;
	2661 [label="Evaluate expressions",color=orange];
		2661 -> 2671 [label="DrifterMarie",color=purple];
		2661 -> 2672 [label="DrifterLyon",color=purple];
		2661 -> 2673 [label="DrifterRoathe",color=purple];
		2661 -> 2674 [label="false",color=purple];
	2662 [label="I nadal możesz zdziałać tak wiele dobra wobec Leona czy nawet samego diabła...",shape=box,color=blue];
		2662 -> 2675;
		2662 -> 2676;
	2652 [label="Indeed, I still wish to see Monsieur Loid united with those above. I wish to see solace brought to le Cardinal's remaining family, and you are the road to this ! ",shape=box,color=blue];
		2652 -> 2662;
	2663 [label="+10 Chemistry",color=orange];
		2663 -> 2677;
	2664 [label="Mawia się czasem o zachowaniu odpowiedniego taktu po \"zwycięstwie\".",shape=box,color=blue];
		2664 -> 2678;
		2664 -> 2679;
	2665 [label="Jakie \"większe dobro\" pozostanie, kiedy na jego drodze zostaną tylko rozbite rodziny i złamane serca ?",shape=box,color=blue];
		2665 -> 2645;
	2666 [label="Non. Nie jest moim ojcem. Mój ojciec porzucił mnie na ulicy, kiedy byłam mała. Le Cardinal nie zrobił nic tak okrutnego.",shape=box,color=blue];
		2666 -> 2680;
	2667 [label="Wiele okrucieństw nastało w ferworze pasji. Takie jest życie. ",shape=box,color=blue];
		2667 -> 2681;
	2668 [label="Chyba już wiem, o co ci chodzi. ",shape=box,color=red];
		2668 -> 2682;
	2669 [label="Nie będę miał o tobie gorszego zdania, obiecuję.",shape=box,color=red];
		2669 -> 2683;
	2670 [label="Chciałabym... dokończyć rozmowę o le Cardinal, jeśli możemy — odłożyć moje zbolałe serce na bok, s'il te plaît ?",shape=box,color=blue];
		2670 -> 2684;
	2671 [label="Naprawdę, jak mogę cię odrzucać, kiedy dopiero wyznałeś mi swoje prawdziwe uczucia ?",shape=box,color=blue];
		2671 -> 2685;
	2672 [label="Naprawdę, jak mogę cię odrzucać, kiedy dopiero wyznałeś mi swoje prawdziwe uczucia wobec naszego najdroższego Leona ? Dzięki tobie mógłby zaznać spokoju...",shape=box,color=blue];
		2672 -> 2685;
	2673 [label="Naprawdę, jak mogę cię odrzucać, kiedy dopiero wyznałeś swoje uczucia wobec diabła ? Nie pojmuję twojego gustu... ale chyba zostaniesz po naszej stronie, oui ?",shape=box,color=blue];
		2673 -> 2685;
	2674 [label="Nie chcę stracić w tobie towarzysza. Możemy odłożyć to na bok, pogodzić się, że nigdy się w tej kwestii nie zgodzimy, ale nadal działać razem ?",shape=box,color=blue];
		2674 -> 2686;
		2674 -> 2687;
	2675 [label="Mario, zaczekaj chwilę, pozwól mi przeprosić.",shape=box,color=red];
		2675 -> 2688;
	2676 [label="Szczerze nie myślałem, że te słowa będą miały znaczenie — nie sądziłem, że tak się tym przejmiesz.",shape=box,color=red];
		2676 -> 2688;
	2677 [label="To znaczy dla mnie więcej, niż możesz sobie wyobrazić. Dziękuję.",shape=box,color=blue];
		2677 -> 2689;
	2678 [label="Tylko cię drażnię.",shape=box,color=red];
		2678 -> 2690;
	2679 [label="Przepraszam, nieczęsto mam okazję \"wygrać\".",shape=box,color=red];
		2679 -> 2691;
	2680 [label="Update boolean MarieFamilyFail",color=orange];
		2680 -> 2692;
	2681 [label="+5 Chemistry",color=orange];
		2681 -> 2693;
	2682 [label="To byłoby dla ciebie oczywiste, non ? Dla kogoś, kto też stracił rodzinę.",shape=box,color=blue];
		2682 -> 2694;
	2683 [label="Przekonamy się. Myślę, że ujrzałam w nim ojca, który mnie porzucił, jakkolwiek smutne i nieznaczące to teraz jest.",shape=box,color=blue];
		2683 -> 2694;
	2684 [label="Myślę, że trudno mi odwrócić się od le Cardinal... i potrzebowałam chwili, by zrozumieć, dlaczego nie byłam do tego zdolna.",shape=box,color=blue];
		2684 -> 2695;
	2685 [label="Możemy odłożyć to na bok, przyznać, że nigdy się tu nie zgodzimy, ale nadal działać razem ?",shape=box,color=blue];
		2685 -> 2686;
		2685 -> 2687;
	2686 [label="Nie, to jeszcze nie koniec. Musimy dokończyć tę dyskusję.",shape=box,color=red];
		2686 -> 2696;
	2687 [label="Myślę, że to odpowiedni kompromis.",shape=box,color=red];
		2687 -> 2697;
	2688 [label="Wybaczę ci kłamstwa, Włóczęgo. Możemy pozostać przyjaciółmi i sojusznikami, ale okłamywać mnie w ten sposób... w jakim celu ?",shape=box,color=blue];
		2688 -> 2698;
	2689 [label="Myślę, że trudno mi odwrócić się od le Cardinal... i potrzebowałam chwili, by zrozumieć, dlaczego nie byłam do tego zdolna.",shape=box,color=blue];
		2689 -> 2699;
	2690 [label="Oui, tak, niech będzie.",shape=box,color=blue];
		2690 -> 2689;
	2691 [label="+5 Chemistry",color=orange];
		2691 -> 2690;
	2692 [label="Add -10 to Family",color=orange];
		2692 -> 2700;
	2693 [label="Przyjmuję twoje przeprosiny... i przyznaję, że dałam się ponieść emocjom.",shape=box,color=blue];
		2693 -> 2701;
	2694 [label="Pomyśleć... że po tylu latach dałam się nabrać komuś, kto okazał mi taką życzliwość ?",shape=box,color=blue];
		2694 -> 2702;
	2695 [label="Po prostu nie chcę, żebyś miał o mnie gorsze zdanie, gdybym wyznała ci prawdę. To wszystko jest takie pathétique.",shape=box,color=blue];
		2695 -> 2703;
