	j1837506957 [label="Bien. Doszliśmy do porozumienia.",shape=box,color=blue];
		j1837506957 -> j361545222;
	j1431612721 [label="By zawitać do mojego łoża ? To podłe.",shape=box,color=blue];
		j1431612721 -> j1307021349;
	j1353280018 [label="Żeby mnie wykorzystać ? To podłe.",shape=box,color=blue];
		j1353280018 -> j1307021349;
	j2962700224 [label="Chyba już wiem, o co ci chodzi.",shape=box,color=red];
		j2962700224 -> j3398752199;
