digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieEntratiDay2 begins." [color=orange];
		"MarieEntratiDay2 begins." -> j1327855716;
	j1327855716 [label="Włóczęgo. Pozwoliłam sobie na chwilę zastanowienia i... na opanowanie emocji. Kieruję się jedną zasadą w rozmowach, kiedy jestem furieuse.",shape=box,color=blue];
		j1327855716 -> j69936295;
	j69936295 [label="Evaluate expressions",color=orange];
		j69936295 -> j2153787771 [label="MarieEntrati5a",color=purple];
		j69936295 -> j2457696958 [label="MarieEntrati5b",color=purple];
		j69936295 -> j2098988493 [label="MarieEntrati5c",color=purple];
		j69936295 -> j1946464088 [label="MarieEntrati5d",color=purple];
		j69936295 -> j3247738195 [label="MarieEntrati5e",color=purple];
		j69936295 -> j3530953873 [label="MarieEntrati5f",color=purple];
		j69936295 -> j1183272431 [label="MarieEntrati5g",color=purple];
		j69936295 -> j3177280010 [label="MarieEntrati5h",color=purple];
		j69936295 -> j3066855741 [label="MarieEntrati5i",color=purple];
		j69936295 -> "Chat ends." [label="false",color=purple];
	j2153787771 [label="Wczoraj poczułam się... jakbyś wbił mi nóż w serce. Przyznaję, że odeszłam w gniewie, oui, ale też répulsion. Nie wobec ciebie, ale wobec siebie.",shape=box,color=blue];
		j2153787771 -> j3803954707;
	j2457696958 [label="Zanim przejdziemy dalej, muszę poruszyć jedną kwestię - twój ton, kiedy do mnie mówisz. Wiem, że uważasz mnie za dziecko. Przeżyłeś całe stulecia, jeśli nie więcej.",shape=box,color=blue];
		j2457696958 -> j2838352895;
	j2098988493 [label="Poświęciłam wiele czasu przemyśleniom nad twoimi słowami. Że to nie jest krucjata oraz że le Cardinal nami manipulował.",shape=box,color=blue];
		j2098988493 -> j2618600078;
	j1946464088 [label="Miałeś... miałeś rację, pytając mnie, czy w pismach Sol napisane jest, życia niewinnych mogą zostać poświęcone. Nic takiego nie zostało powiedziane.",shape=box,color=blue];
		j1946464088 -> j4141112124;
	j3247738195 [label="Zanim przejdziemy dalej, muszę poruszyć jedną kwestię - twoją gotowość do wykorzystania mojej wiary przeciwko mnie, kiedy ty sam nie jesteś osobą wierzącą.",shape=box,color=blue];
		j3247738195 -> j2416770788;
	j3530953873 [label="Chcę... przeprosić za swoją ucieczkę przed rozmową. To było dla mnie za wiele. Zanim przejdziemy dalej, muszę cię zapytać - czy naprawdę miałeś na myśli, co powiedziałeś ? Czy była to tylko próba manipulacji, by uniknąć nieprzyjemnej rozmowy ?",shape=box,color=blue];
		j3530953873 -> j2196597408;
		j3530953873 -> j3073493200;
	j1183272431 [label="Zdaje się, że nasza dyskusja o le Cardinal utknęła w martwym punkcie, oui ? Ty widzisz w nim potwora, a ja świętego.",shape=box,color=blue];
		j1183272431 -> j3706070520;
	j3177280010 [label="Chciałabym z tobą porozmawiać o twojej decyzji opowiedzenia się po stronie Entratiego tylko po to, by wkupić się w moje łaski.",shape=box,color=blue];
		j3177280010 -> j852126404;
	j3066855741 [label="Chcę porozmawiać o twoim kłamstwie, jeśli jesteś gotów.",shape=box,color=blue];
		j3066855741 -> j852126404;
	"Chat ends." [color=orange];
	j3803954707 [label="Dlaczego jestem zaskoczona celnością twojej uwagi ? Porównać moje słowa do słów samego diabła...",shape=box,color=blue];
		j3803954707 -> j2403788025;
	j2838352895 [label="Podróżowałeś przez nieznane światy, przez samą Pustkę. Walczyłeś z bogami i aniołami. Kimże jestem ja, oui ? Małą, głupią Marią.",shape=box,color=blue];
		j2838352895 -> j3314861328;
	j2618600078 [label="I wierzę... oui, że masz rację. To nie krucjata. Nic takiego nie ma miejsca. Żadna wojna nie jest święta, prawa, ani właściwa. Nie powinno nas prowadzić cierpienie.",shape=box,color=blue];
		j2618600078 -> j3515634614;
	j4141112124 [label="Żadna wojna nie jest święta, prawa, ani właściwa. Nie powinno nas prowadzić cierpienie.",shape=box,color=blue];
		j4141112124 -> j3515634614;
	j2416770788 [label="To było nieszczere, Włóczęgo. Okrutne i nieskuteczne. To była marna próba \"wygrania\" tej dyskusji i nie powinieneś się tak zachowywać.",shape=box,color=blue];
		j2416770788 -> j2114474389;
	j2196597408 [label="Mówiłem to z serca, choć moje wyczucie czasu... pozostawia wiele do życzenia. Bardzo mi na tobie zależy...",shape=box,color=red];
		j2196597408 -> j2269416854;
	j3073493200 [label="Nie mówiłem szczerze, po prostu... poniosło mnie. Bardzo mi przykro.",shape=box,color=red];
		j3073493200 -> j152741485;
	j3706070520 [label="A jednak... nie chcę, żeby pozostała pomiędzy nami niezgoda. Jesteś dobrą duszą i łączy nas wiele, czego nie chcę zaprzepaścić.",shape=box,color=blue];
		j3706070520 -> j483300420;
	j852126404 [label="Próba manipulowania sytuacją, by zawładnąć moimi uczuciami jest... nieszczera i okrutna. Muszę przyznać, że chciałabym cię za to znienawidzić, Włóczęgo.",shape=box,color=blue];
		j852126404 -> j3133703246;
	j2403788025 [label="Uważam się za osobę, której umysł i serce pozostają otwarte na świat i jego mieszkańców. A ty, tą jedną uwagą, udowodniłeś, jak bardzo byłam w błędzie.",shape=box,color=blue];
		j2403788025 -> j3151580731;
	j3314861328 [label="Z jednej strony, staram się to zrozumieć. Poniosły nas emocje. Z drugiej natomiast, chciałbym, żebyś traktował mnie z większym szacunkiem, niż dotychczas.",shape=box,color=blue];
		j3314861328 -> j575490318;
	j3515634614 [label="Nawet to, co teraz robimy – walka z Szeptem i z resztą twoich licznych wrogów – nie jest ścieżką Świetlistych.",shape=box,color=blue];
		j3515634614 -> j932719290;
	j2114474389 [label="Wiara nie jest i nigdy nie powinna zostać wykorzystana jako broń przeciwko drugiej osobie. Wiara jest tarczą. Światłem pośród mroku. Głosem dobrej rady.",shape=box,color=blue];
		j2114474389 -> j2754471049;
	j2269416854 [label="Zanim zmierzę się z... ogromem tego zwierzenia, muszę pierw wyjaśnić swoją pozycję wobec le Cardinal, s'il vous plaît.",shape=box,color=blue];
		j2269416854 -> j1903923729;
	j152741485 [label="Boolean DrifterMarie is now false.",color=orange];
		j152741485 -> j3719115999;
	j483300420 [label="Check boolean LoidFamilyComplete",color=orange];
		j483300420 -> j379182118 [label=true,color=green];
		j483300420 -> j180720524 [label=false,color=brown];
	j3133703246 [label="A jednak... nie chcę, żeby pozostała pomiędzy nami niezgoda. Łączy nas wiele, czego nie chcę zaprzepaścić.",shape=box,color=blue];
		j3133703246 -> j3805730835;
	j3151580731 [label="Chyba chciałabym przeprosić - przyznać jak bardzo mi przykro, że tak głupio i uparcie obstawałam przy swoim stanowisku. Mam nadzieję, że rozumiesz.",shape=box,color=blue];
		j3151580731 -> j3889065741;
		j3151580731 -> j3314774676;
	j575490318 [label="Żyłam na ulicy. Każdego dnia towarzyszyła mi fizyczna agonia. Przeżyłam złamane serca, zaznałam miłości, nie jest mi obcy strach i odrzucenie. Wiem, co w życiu można zyskać i stracić.",shape=box,color=blue];
		j575490318 -> j154414923;
	j932719290 [label="Konieczne może być wzniesienie miecza, by świat nie został zalany przez takich jak on, tak nie należy chwalić tego czynu. A z pewnością nie ma żadnego usprawiedliwienia dla niewinnych, których także dotknęła krzywda.",shape=box,color=blue];
		j932719290 -> j2225082638;
	j2754471049 [label="A to, że próbowałeś użyć jej przeciwko mnie, żeby mnie \"pokonać\"? To była taktyka tchórza. Ale poniosły nas emocję i... wybaczę ci, jeśli ty także mi wybaczysz za słowa, które padły w gniewie.",shape=box,color=blue];
		j2754471049 -> j280067205;
		j2754471049 -> j4132883157;
	j1903923729 [label="Myślę, że trudno mi odwrócić się od le Cardinal... i potrzebowałam chwili, by zrozumieć, dlaczego nie byłam do tego zdolna.",shape=box,color=blue];
		j1903923729 -> j917471710;
	j3719115999 [label="Non, rozumiem... Ile morderstw było popełnione \"w afekcie\", oui ? Pod wpływem podobnych pasji powstało również wiele dzieci.",shape=box,color=blue];
		j3719115999 -> j2472915792;
	j379182118 [label="I w tak krótkim czasie stałeś się dla mnie bardzo ważny... Nasze rozmowy dały mi wiele radości.",shape=box,color=blue];
		j379182118 -> j1186072069;
	j180720524 [label="Naprawdę, wciąż pragnę, by Monsieur Loid zjednoczył się z rodziną ponad nami. Pragnę ukojenia dla rodziny le Cardinal, i to ty możesz do tego doprowadzić !",shape=box,color=blue];
		j180720524 -> j379182118;
	j3805730835 [label="Check boolean LoidFamilyComplete",color=orange];
		j3805730835 -> j163792084 [label=true,color=green];
		j3805730835 -> j3265425127 [label=false,color=brown];
	j3889065741 [label="Rozumiem i przepraszam, jeśli moje słowa cię zraniły. Nie wiedziałem, jak inaczej to powiedzieć.",shape=box,color=red];
		j3889065741 -> j1542262578;
	j3314774676 [label="Cieszę się, że przemówiłem ci do rozsądku. Zaczynałem już tracić nadzieję.",shape=box,color=red];
		j3314774676 -> j621219765;
	j154414923 [label="I jeśli naprawdę uważasz, że jesteś tak wysoko ponad nami, nie dostrzeżesz niczego prócz chmur, w których się zagubiłeś.",shape=box,color=blue];
		j154414923 -> j280067205;
		j154414923 -> j4132883157;
	j2225082638 [label="Więc... muszę przyznać, że le Cardinal nie jest usprawiedliwiony raniąc innych w imię \"większego dobra\".",shape=box,color=blue];
		j2225082638 -> j3864525648;
	j280067205 [label="Zdenerwowałem się, ale nie wiem, jak inaczej przemówić ci do rozsądku. Entrati nie jest twoim przyjacielem. Ani ojcem.",shape=box,color=red];
		j280067205 -> j2256458852;
	j4132883157 [label="Przepraszam. Dałem się ponieść emocjom i powiedziałem coś, czego nie chciałem.",shape=box,color=red];
		j4132883157 -> j537004970;
	j917471710 [label="Po prostu nie chcę, żebyś miał o mnie gorsze zdanie, gdybym wyznała ci prawdę. To wszystko jest takie pathétique.",shape=box,color=blue];
		j917471710 -> j3164375565;
		j917471710 -> j2797579258;
	j2472915792 [label="Jestem... zawiedziona. Zraniona. Ale... wybaczam ci.",shape=box,color=blue];
		j2472915792 -> j213024215;
	j1186072069 [label="Evaluate expressions",color=orange];
		j1186072069 -> j56426402 [label="DrifterMarie",color=purple];
		j1186072069 -> j1114537417 [label="DrifterLyon",color=purple];
		j1186072069 -> j4232836803 [label="DrifterRoathe",color=purple];
		j1186072069 -> j3161990964 [label="false",color=purple];
	j163792084 [label="I nadal możesz zdziałać tak wiele dobra wobec Leona czy nawet samego diabła...",shape=box,color=blue];
		j163792084 -> j2517590809;
		j163792084 -> j3046280249;
	j3265425127 [label="Naprawdę, wciąż pragnę, by Monsieur Loid zjednoczył się z rodziną ponad nami. Pragnę ukojenia dla rodziny le Cardinal, i to ty możesz do tego doprowadzić !",shape=box,color=blue];
		j3265425127 -> j163792084;
	j1542262578 [label="+10 Chemistry",color=orange];
		j1542262578 -> j3119573841;
	j621219765 [label="Mawia się czasem o zachowaniu odpowiedniego taktu po \"zwycięstwie\".",shape=box,color=blue];
		j621219765 -> j1651150405;
		j621219765 -> j345998435;
	j3864525648 [label="Jakie \"większe dobro\" pozostanie, kiedy na jego drodze zostaną tylko rozbite rodziny i złamane serca ?",shape=box,color=blue];
		j3864525648 -> j3151580731;
	j2256458852 [label="Non. Nie jest moim ojcem. Mój ojciec porzucił mnie na ulicy, kiedy byłam mała. Le Cardinal nie zrobił nic tak okrutnego.",shape=box,color=blue];
		j2256458852 -> j786197016;
	j537004970 [label="Wiele okrucieństw nastało w ferworze pasji. Takie jest życie. ",shape=box,color=blue];
		j537004970 -> j84297675;
	j3164375565 [label="Chyba już wiem, o co ci chodzi. ",shape=box,color=red];
		j3164375565 -> j1697469607;
	j2797579258 [label="Nie będę miał o tobie gorszego zdania, obiecuję.",shape=box,color=red];
		j2797579258 -> j2796907735;
	j213024215 [label="Chciałabym... dokończyć rozmowę o le Cardinal, jeśli możemy — odłożyć moje zbolałe serce na bok, s'il te plaît ?",shape=box,color=blue];
		j213024215 -> j3549745546;
	j56426402 [label="Naprawdę, jak mogę cię odrzucać, kiedy dopiero wyznałeś mi swoje prawdziwe uczucia ?",shape=box,color=blue];
		j56426402 -> j3851034662;
	j1114537417 [label="Naprawdę, jak mogę cię odrzucać, kiedy dopiero wyznałeś mi swoje prawdziwe uczucia wobec naszego najdroższego Leona ? Dzięki tobie mógłby zaznać spokoju...",shape=box,color=blue];
		j1114537417 -> j3851034662;
	j4232836803 [label="Naprawdę, jak mogę cię odrzucać, kiedy dopiero wyznałeś swoje uczucia wobec diabła ? Nie pojmuję twojego gustu... ale chyba zostaniesz po naszej stronie, oui ?",shape=box,color=blue];
		j4232836803 -> j3851034662;
	j3161990964 [label="Nie chcę stracić w tobie towarzysza. Możemy odłożyć to na bok, pogodzić się, że nigdy się w tej kwestii nie zgodzimy, ale nadal działać razem ?",shape=box,color=blue];
		j3161990964 -> j3016448529;
		j3161990964 -> j1902180232;
	j2517590809 [label="Mario, zaczekaj chwilę, pozwól mi przeprosić.",shape=box,color=red];
		j2517590809 -> j2281650064;
	j3046280249 [label="Szczerze nie myślałem, że te słowa będą miały znaczenie — nie sądziłem, że tak się tym przejmiesz.",shape=box,color=red];
		j3046280249 -> j2281650064;
	j3119573841 [label="To znaczy dla mnie więcej, niż możesz sobie wyobrazić. Dziękuję.",shape=box,color=blue];
		j3119573841 -> j1015849856;
	j1651150405 [label="Tylko cię drażnię.",shape=box,color=red];
		j1651150405 -> j1235369005;
	j345998435 [label="Przepraszam, nieczęsto mam okazję \"wygrać\".",shape=box,color=red];
		j345998435 -> j3943291823;
	j786197016 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j786197016 -> j542165713;
	j84297675 [label="+5 Chemistry",color=orange];
		j84297675 -> j3233445369;
	j1697469607 [label="To byłoby dla ciebie oczywiste, non ? Dla kogoś, kto też stracił rodzinę.",shape=box,color=blue];
		j1697469607 -> j2654108808;
	j2796907735 [label="Przekonamy się. Myślę, że ujrzałam w nim ojca, który mnie porzucił, jakkolwiek smutne i nieznaczące to teraz jest.",shape=box,color=blue];
		j2796907735 -> j2654108808;
	j3549745546 [label="Myślę, że trudno mi odwrócić się od le Cardinal... i potrzebowałam chwili, by zrozumieć, dlaczego nie byłam do tego zdolna.",shape=box,color=blue];
		j3549745546 -> j3581619011;
	j3851034662 [label="Możemy odłożyć to na bok, przyznać, że nigdy się tu nie zgodzimy, ale nadal działać razem ?",shape=box,color=blue];
		j3851034662 -> j3016448529;
		j3851034662 -> j1902180232;
	j3016448529 [label="Nie, to jeszcze nie koniec. Musimy dokończyć tę dyskusję.",shape=box,color=red];
		j3016448529 -> j2551683190;
	j1902180232 [label="Myślę, że to odpowiedni kompromis.",shape=box,color=red];
		j1902180232 -> j2145449538;
	j2281650064 [label="Wybaczę ci kłamstwa, Włóczęgo. Możemy pozostać przyjaciółmi i sojusznikami, ale okłamywać mnie w ten sposób... w jakim celu ?",shape=box,color=blue];
		j2281650064 -> j1574691804;
	j1015849856 [label="Myślę, że trudno mi odwrócić się od le Cardinal... i potrzebowałam chwili, by zrozumieć, dlaczego nie byłam do tego zdolna.",shape=box,color=blue];
		j1015849856 -> j2016532061;
	j1235369005 [label="Oui, tak, niech będzie.",shape=box,color=blue];
		j1235369005 -> j1015849856;
	j3943291823 [label="+5 Chemistry",color=orange];
		j3943291823 -> j1235369005;
	j542165713 [label="Add -10 to Family counter",color=orange];
		j542165713 -> j816189513;
	j3233445369 [label="Przyjmuję twoje przeprosiny... i przyznaję, że dałam się ponieść emocjom.",shape=box,color=blue];
		j3233445369 -> j3213716405;
	j2654108808 [label="Pomyśleć... że po tylu latach dałam się nabrać komuś, kto okazał mi taką życzliwość ?",shape=box,color=blue];
		j2654108808 -> j3639679270;
	j3581619011 [label="Po prostu nie chcę, żebyś miał o mnie gorsze zdanie, gdybym wyznała ci prawdę. To wszystko jest takie pathétique.",shape=box,color=blue];
		j3581619011 -> j1394468528;
		j3581619011 -> j3802482378;
