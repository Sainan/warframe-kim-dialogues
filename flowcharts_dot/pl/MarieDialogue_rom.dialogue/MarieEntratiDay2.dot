		j3213716405 -> j2016532061;
	j3639679270 [label="Głupia mała Maria... oczywiście, że nie wszystko było takie, na jakie wyglądało.",shape=box,color=blue];
		j3639679270 -> j1832725254;
		j3639679270 -> j3647419351;
