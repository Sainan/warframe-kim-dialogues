		2468 -> 2466;
	2466 [label="Nie śnił mi się koszmar o Arturze, od kiedy opowiedziałam ci o babci Callie. Chyba udało ci się przepędzić tego demona.",shape=box,color=blue];
		2466 -> 2469;
	2469 [label="Check boolean EleanorDating",color=orange];
		2469 -> 2470 [label=true,color=green];
		2469 -> 2471 [label=false,color=brown];
	2470 [label="Ale coś zaczęło się zmieniać, od kiedy jesteśmy razem. To dosyć niezręczne. Chciałam o tym porozmawiać, ale nie było odpowiedniej chwili.",shape=box,color=blue];
		2470 -> 2472;
		2470 -> 2473;
		2470 -> 2474;
	2471 [label="Ale to nie znaczy, że nie było INNYCH koszmarów.",shape=box,color=blue];
		2471 -> 2480;
		2471 -> 2481;
		2471 -> 2482;
	2472 [label="Przyśniłem ci się?",shape=box,color=red];
		2472 -> 2475;
	2473 [label="Śniłaś o nas?",shape=box,color=red];
		2473 -> 2476;
	2474 [label="Niezręczne? To nie brzmi dobrze.",shape=box,color=red];
		2474 -> 2477;
	2480 [label="Nie jest łatwo cię przestraszyć.",shape=box,color=red];
		2480 -> 2483;
	2481 [label="Spadałaś z niekończących się schodów?",shape=box,color=red];
		2481 -> 2484;
	2482 [label="To może być coś ważnego. Z twoimi umiejętnościami to mógł nie być tylko sen.",shape=box,color=red];
		2482 -> 2485;
	2475 [label="To nie byłoby niezręczne. A ta sprawa jest.",shape=box,color=blue];
		2475 -> 2478;
	2476 [label="Na Bogów, chciałabym. Niestety, to nie było nic tak przyjemnego.",shape=box,color=blue];
		2476 -> 2478;
	2477 [label="Nie martw się, nie jest aż tak źle. Nie jestem przerażona. Po prostu...",shape=box,color=blue];
		2477 -> 2478;
	2483 [label="No właśnie, dlatego to takie niepokojące.",shape=box,color=blue];
		2483 -> 2486;
	2484 [label="Nie, nic takiego. Ale to zabawne, że każdemu się przydarza.",shape=box,color=blue];
		2484 -> 2486;
	2485 [label="Właśnie tego się obawiam.",shape=box,color=blue];
		2485 -> 2486;
	2478 [label="(W porządku Eleanor, głęboki wdech, dasz radę)",shape=box,color=blue];
