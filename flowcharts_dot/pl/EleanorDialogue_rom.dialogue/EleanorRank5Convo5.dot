		2495 -> 2496;
	2492 [label="Chciałabym.",shape=box,color=blue];
		2492 -> 2497;
	2493 [label="Zazdrosny o naszą przyjaźń, tak.",shape=box,color=blue];
		2493 -> 2497;
	2496 [label="W pewien głęboko popieprzony sposób uważa mnie za swoją własność. Miałam pozwolić mu w stworzeniu roju. Legacyty uważają mnie za rywalizującą królową.",shape=box,color=blue];
		2496 -> 2498;
		2496 -> 2499;
	2497 [label="W pewien głęboko popieprzony sposób uważa mnie za swoją własność. Miałam pozwolić mu w stworzeniu roju. Legacyty uważają mnie za rywalizującą królową.",shape=box,color=blue];
		2497 -> 2500;
		2497 -> 2501;
	2498 [label="Warframe'y tak nie działają. Ten szczep Plagi jest opanowany, uśpiony. Z wyjątkiem Nidusa, ale to specjalny przypadek.",shape=box,color=red];
		2498 -> 2503;
	2499 [label="Więc Techrot myśli, że cię zabrałem i chce cię z powrotem?",shape=box,color=red];
		2499 -> 2504;
	2500 [label="Warframe'y tak nie działają. Ten szczep Plagi jest opanowany, uśpiony. Z wyjątkiem Nidusa, ale to specjalny przypadek.",shape=box,color=red];
		2500 -> 2502;
	2501 [label="Więc Techrot myśli, że nie pozwalam ci do niego wrócić?",shape=box,color=red];
		2501 -> 2505;
	2503 [label="Cóż, może gdybym była w pełni Warframe, to Techrot by mnie tak nie postrzegał. Ale w tej chwili, moje komórki wciąż szaleją, widzi mnie jako część siebie.",shape=box,color=blue];
		2503 -> 2506;
	2504 [label="Czyż to nie szalone? Zupełnie jak z byłym!",shape=box,color=blue];
		2504 -> 2506;
	2502 [label="Cóż, może gdybym była w pełni Warframe, to Techrot by mnie tak nie postrzegał. Ale w tej chwili, moje komórki wciąż szaleją, widzi mnie jako część siebie.",shape=box,color=blue];
		2502 -> 2507;
	2505 [label="Tak. Chce mnie znów w swoim zespole.",shape=box,color=blue];
		2505 -> 2507;
	2506 [label="Tam, skąd pochodzę, musiałbyś najpierw stoczyć z nim walkę na tyłach supermarketu. Nie wiem, jak to działa w twoich czasach.",shape=box,color=blue];
		2506 -> 2508;
	2507 [label="To twoja PRAWDZIWA rodzina, szepcze. Wróć do nas, zagubiona siostro. Dołącz do nas.",shape=box,color=blue];
		2507 -> 2508;
	2508 [label="Chwila, wróć się. Skąd wiesz, co czuje Techrot?",shape=box,color=red];
		2508 -> 2509;
	2509 [label="Och na Bogów, to będzie niezręczne.",shape=box,color=blue];
		2509 -> 2510;
	2510 [label="Te sny, o których wspomniałam? Jestem pewna, że to Techrot za nie odpowiada.",shape=box,color=blue];
		2510 -> 2511;
	2511 [label="Cokolwiek w tym czymś odpowiada za umysł, zawsze było zdolne do połączenia się z moim. Ale myśli, które przesyła w moją stronę są prymitywne i słabe, więc łatwo mogę je odeprzeć.",shape=box,color=blue];
		2511 -> 2512;
	2512 [label="Większość czasu jest jest jak wrażenie gorączkowego drapania z tyłu głowy, jak kot drapiący o drzwi zamkniętej toalety.",shape=box,color=blue];
		2512 -> 2513;
		2512 -> 2514;
	2513 [label="Ale kiedy śpisz, sprawa wygląda trochę inaczej, tak?",shape=box,color=red];
		2513 -> 2515;
	2514 [label="Chyba widzę, dokąd to zmierza.",shape=box,color=red];
		2514 -> 2515;
	2515 [label="Tak. Moja obrona jest osłabiona i może się dostać.",shape=box,color=blue];
		2515 -> 2516;
	2516 [label="Docierał do mnie na najbardziej pierwotnym poziomie, jeśli rozumiesz, o co chodzi. Chce mnie odzyskać. Obiecuje mi rozkosze, o jakich nigdy nie śniłam.",shape=box,color=blue];
		2516 -> 2517;
	2517 [label="Moje ciało aż będzie ociekać cystami nowego życia. Jest przekonany, że tego pragnę.",shape=box,color=blue];
		2517 -> 2518;
	2518 [label="Check boolean EleanorDating",color=orange];
		2518 -> 2519 [label=true,color=green];
		2518 -> 2520 [label=true,color=green];
		2518 -> 2521 [label=false,color=brown];
		2518 -> 2522 [label=false,color=brown];
	2519 [label="Okej, to chyba koniec z nami. Jak mógłbym konkurować z czymś takim?",shape=box,color=red];
		2519 -> 2523;
	2520 [label="Spalę to wszystko, zanim pozwolę, żeby cię zabrało.",shape=box,color=red];
		2520 -> 2524;
	2521 [label="Nie pozwolę, żeby cię to zabrało, Eleanor. Jesteś moją przyjaciółką.",shape=box,color=red];
		2521 -> 2525;
	2522 [label="Jesteś dla mnie jak rodzina. Nie pozwolę, żeby to cię zabrało.",shape=box,color=red];
		2522 -> 2526;
	2523 [label="+20 Chemistry",color=orange];
		2523 -> 2530;
	2524 [label="I takie zachowanie sprawia, że Włóczęga skończy obsypany całusami.",shape=box,color=blue];
		2524 -> 2527;
	2525 [label="Ja to wiem. Techrot też wie i dlatego jest tak wściekły. Nie może się z tobą mierzyć.",shape=box,color=blue];
		2525 -> 2528;
	2526 [label="Lepiej mi się śpi, wiedząc, że mnie wspierasz.",shape=box,color=blue];
		2526 -> 2529;
	2530 [label="Wszystko w porządku, mój kochany. Nie porzucę cię na rzecz wijącej się masy macek z powbijanymi w nią resztkami porzuconej technologii.",shape=box,color=blue];
		2530 -> 2531;
	2527 [label="+20 Chemistry",color=orange];
		2527 -> 2532;
	2528 [label="+20 Chemistry",color=orange];
		2528 -> 2533;
	2529 [label="+20 Chemistry",color=orange];
		2529 -> 2534;
	2531 [label="Tylko… jeśli któregoś ranka zobaczysz, że moje oczy są wyjątkowo czarne, a ja blada, przygotuj dla mnie wybitnie mocną kawę i nie zadawaj zbędnych pytań?",shape=box,color=blue];
		2531 -> 2535;
		2531 -> 2536;
	2532 [label="Chcesz pokazać Techrot coś, o co może być NAPRAWDĘ zazdrosny?",shape=box,color=blue];
		2532 -> 2538;
	2533 [label="Poradzimy sobie z tym razem. Jak zawsze.",shape=box,color=blue];
		2533 -> 2539;
	2534 [label="Jesteśmy rodziną. Łączy nas krew i cel. Tej więzi nie można przełamać.",shape=box,color=blue];
		2534 -> 2540;
	2535 [label="Da się zrobić.",shape=box,color=red];
		2535 -> 2537;
	2536 [label="...będę miał to na uwadze.",shape=box,color=red];
