digraph {
	1262 [label="EleanorRank3Convo5 begins.",color=orange];
		1262 -> 1263;
	1263 [label="Witaj, Włóczęgo. Jestem wściekła.",shape=box,color=blue];
		1263 -> 1266;
		1263 -> 1264;
		1263 -> 1265;
	1266 [label="Co cię zdenerwowało?",shape=box,color=red];
		1266 -> 1268;
	1264 [label="Witaj, wściekła. Jestem Włóczęgą.",shape=box,color=red];
		1264 -> 1269;
	1265 [label="Przepraszam, nie mam teraz czasu. [Koniec]",shape=box,color=red];
		1265 -> 1267;
	1268 [label="Dwie sprawy.",shape=box,color=blue];
		1268 -> 1273;
	1269 [label="MACIE TAKIE SUCHARY W PRZYSZŁOŚCI",shape=box,color=blue];
		1269 -> 1271;
	1267 [label="Chat ends.",color=orange];
	1273 [label="Tęsknię za winem. Nie piłam prawdziwego wina od tak cholernie długiego czasu. A całe wino w Höllvanii zostało zarekwirowane przez dowództwo Scaldry w pierwszych dniach epidemii.",shape=box,color=blue];
		1273 -> 1274;
	1271 [label="+10 Chemistry",color=orange];
		1271 -> 1270;
	1274 [label="Quincy i Artur próbowali pędzić bimber na owocowych racjach żywnościowych, ale ci z nas którzy mieli resztki godności odmówili. To była rzadka chwila solidarności z Lettie.",shape=box,color=blue];
		1274 -> 1275;
	1270 [label="Poprawiłeś mi humor. Dziękuję.",shape=box,color=blue];
		1270 -> 1272;
	1275 [label="Druga, znacznie większa i poważniejsza sprawa, to przyszłość.",shape=box,color=blue];
		1275 -> 1276;
	1272 [label="Chat ends.",color=orange];
	1276 [label="To nie twoja wina, ale… teraz, kiedy zobaczyłam przyszłość twoimi oczami, czuję się okropnie i zwykłe sposoby nie pomagają.",shape=box,color=blue];
		1276 -> 1277;
		1276 -> 1278;
	1277 [label="Jak mogę cię rozweselić?",shape=box,color=red];
		1277 -> 1279;
	1278 [label="Zwykłe metody?",shape=box,color=red];
		1278 -> 1280;
	1279 [label="Nie wiem. Może taniec egzotyczny?",shape=box,color=blue];
		1279 -> 1281;
	1280 [label="Spędzenie wieczoru z Amirem i słuchanie jego entuzjastycznego wywodu o grze albo komiksie, którym się w tej chwili interesuje.",shape=box,color=blue];
		1280 -> 1282;
	1281 [label="Opisz mi śmierć Ballasa nie stroniąc od szczegółów?",shape=box,color=blue];
		1281 -> 1283;
	1282 [label="Otaczam się kryształami i powtarzam zaklęcia w głowie, dopóki Lettie nie wezwie do mnie egzorcysty.",shape=box,color=blue];
		1282 -> 1284;
	1283 [label="Doceniam ofertę, ale tę melancholię będę musiała po prostu znieść.",shape=box,color=blue];
		1283 -> 1286;
	1284 [label="To inny rodzaj smutku. Przytłacza mnie jak mokry koc.",shape=box,color=blue];
		1284 -> 1288;
		1284 -> 1289;
	1286 [label="Może coś namaluję.",shape=box,color=blue];
		1286 -> 1285;
	1288 [label="Höllvania w 1999 jest ciężka! Scaldra, Techrot, Pustka wie co jeszcze. Czy przyszłość naprawdę wygląda dużo gorzej?",shape=box,color=red];
		1288 -> 1290;
	1289 [label="Och, no weź... jesteś twarda. Poradzisz sobie. Wkoło jest tyle fascynujących rzeczy.",shape=box,color=red];
		1289 -> 1291;
	1285 [label="+5 Chemistry",color=orange];
		1285 -> 1287;
	1290 [label="Słuchaj, nigdy nie byłam fanką science fiction. Artur przeszedł taką fazę, ale zawsze kręciły go ponure realia wojska. Bohaterscy męscy mężczyźni, pozytywne historyjki dla chłopców, ogromy podtekstów, jestem pewna, że wiesz, o co chodzi.",shape=box,color=blue];
		1290 -> 1292;
	1291 [label="Pewnie. Weź mnie za rękę i poprowadź mnie przez ulice Höllvanii.",shape=box,color=blue];
		1291 -> 1293;
	1287 [label="Chat ends.",color=orange];
	1292 [label="Ale z sci-fi dowiedziałam się tyle, że daleko daleko w przyszłości powinniśmy byli rozwiązać swoje problemy. Powinna być sterylna i lśniąca. Roboty wykonują całą ciężką robotę, nikt nie choruje, nikt nie żyje w biedzie. Srebrne wieże, niebieskie niebo i seksowne jaszczury.",shape=box,color=blue];
		1292 -> 1295;
		1292 -> 1296;
	1293 [label="Znam miejsce, w którym możemy znaleźć placki z rzepy i moglibyśmy oglądać słońce zachodzące nad ruinami szkoły.",shape=box,color=blue];
		1293 -> 1294;
	1295 [label="Mamy roboty. Wykonują za nas wiele ciężkiej pracy.",shape=box,color=red];
		1295 -> 1298;
	1296 [label="Ale to co mówisz to tylko fikcja, prawda? Dlaczego rzeczywistość miałaby jej dorównać?",shape=box,color=red];
		1296 -> 1299;
	1294 [label="Potem możemy pić koktajle w blasku płonącego czołgu.",shape=box,color=blue];
		1294 -> 1297;
	1298 [label="No dobra. Przyznaję tu wygraną.",shape=box,color=blue];
		1298 -> 1300;
	1299 [label="Ugh. Ja nie… to skomplikowane. Śpieszę z wyjaśnieniem.",shape=box,color=blue];
		1299 -> 1301;
	1297 [label="Chat ends.",color=orange];
	1300 [label="Ale czy te roboty uczyniły życie łatwiejszym dla zwykłych ludzi?",shape=box,color=blue];
		1300 -> 1303;
	1301 [label="Nie mówię, że oczekiwałam przyszłości jak opisanej w komiksie dla dzieci. Po prostu wiązał się z nią optymizm.",shape=box,color=blue];
		1301 -> 1302;
	1303 [label="Czy też stały się czymś, co ludzie traktowali jako coś oczywistego?",shape=box,color=blue];
		1303 -> 1306;
		1303 -> 1307;
	1302 [label="Myślę, że wszyscy po prostu uznaliśmy, że nawet jeśli teraz jest źle to w przyszłości z tego wyjdziemy. Nasza cywilizacja miała się rozwijać. Zaczęliśmy od okładania się pałkami a tysiące lat później znaleźliśmy sposoby na porozumienie bez tego.",shape=box,color=blue];
		1302 -> 1304;
		1302 -> 1305;
	1306 [label="Pragniesz dostrzegać tylko najgorsze we wszystkim, prawda?",shape=box,color=red];
		1306 -> 1310;
	1307 [label="Dobra. Roboty nie rozwiązały nadużyć innych ludzi.",shape=box,color=red];
		1307 -> 1311;
	1304 [label="Ludzie to wciąż ludzie, technologia tego nie zmieni.",shape=box,color=red];
		1304 -> 1308;
	1305 [label="Przepraszam, że zawiedliśmy twoje oczekiwania?",shape=box,color=red];
		1305 -> 1309;
	1310 [label="Oczywiście.",shape=box,color=blue];
		1310 -> 1315;
	1311 [label="Tak. I to jest takie rozczarowujące.",shape=box,color=blue];
		1311 -> 1316;
	1308 [label="Bingo. Trafiłeś dokładnie w to, co mnie tak przygnębiało.",shape=box,color=blue];
		1308 -> 1313;
	1309 [label="Dokładnie.",shape=box,color=blue];
		1309 -> 1313;
	1315 [label="W ten sposób możesz zauważyć, co wymaga zmian.",shape=box,color=blue];
		1315 -> 1317;
	1316 [label="Jesteście zaawansowani, ale powinniście też być OŚWIECENI",shape=box,color=blue];
		1316 -> 1318;
	1313 [label="Mieliście dostęp do tej niesamowitej, magicznej technologii i wykorzystaliście ją tylko do wykorzystywania siebie nawzajem. Nauka tylko powiększyła różnice między nami, zamiast je zmniejszyć.",shape=box,color=blue];
		1313 -> 1312;
		1313 -> 1314;
	1317 [label="Chat ends.",color=orange];
	1318 [label="Dzięki za cierpliwość. Wiem, że to dużo.",shape=box,color=blue];
		1318 -> 1320;
	1312 [label="Yym, chciałbym przypomnieć, że ja NIC z tego nie zrobiłem?",shape=box,color=red];
		1312 -> 1322;
	1314 [label="Przekażę twoją skargę do Orokin.",shape=box,color=red];
		1314 -> 1322;
	1320 [label="+15 Chemistry",color=orange];
		1320 -> 2837;
	1322 [label="Och na Bogów, nie chodzi mi o ciebie w twojej osobie. Chodzi o twoje czasy.",shape=box,color=blue];
		1322 -> 1323;
	2837 [label="Chat ends.",color=orange];
	1323 [label="Zamiast przeć naprzód zaczęliście się cofać. Ucieleśnienie Bogów-królów! Ze wszystkiego, co mogło zostać stworzone na nowo, wybraliście ICH.",shape=box,color=blue];
		1323 -> 1324;
	1324 [label="Tenno zabili Orokin. Nie zapomniałaś o tym?",shape=box,color=red];
		1324 -> 1325;
	1325 [label="Nie. Nie zapomniałam o tym, że emocjonalnie zmaltretowane sieroty zamordowały nieśmiertelną elitę. To moja ulubiona część. Jak zamknę oczy, mogę wyobrazić sobie ich krzyki.",shape=box,color=blue];
		1325 -> 1326;
		1325 -> 1327;
	1326 [label="No dobra. Przyszłość to burdel. Możesz skupić się na tym, co ci się podoba.",shape=box,color=red];
		1326 -> 1328;
	1327 [label="To... nie jest coś... do czego bym przyznawał się przed ludźmi.",shape=box,color=red];
		1327 -> 1329;
	1328 [label="Lepiej radzę sobie z ludźmi, którzy starają się poprawić świat.",shape=box,color=red];
		1328 -> 1330;
	1329 [label="... ironii też nie mają w twoich czasach?",shape=box,color=blue];
		1329 -> 1331;
	1330 [label="+20 Chemistry",color=orange];
		1330 -> 1332;
	1331 [label="Chat ends.",color=orange];
	1332 [label="Chat ends.",color=orange];
}