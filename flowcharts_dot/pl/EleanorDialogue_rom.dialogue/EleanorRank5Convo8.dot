digraph {
	2659 [label="EleanorRank5Convo8 begins.",color=orange];
		2659 -> 2660;
	2660 [label="Tak się zastanawiałam. Jest coś, co muszę zrobić.",shape=box,color=blue];
		2660 -> 2661;
	2661 [label="I będę potrzebować pomocy.",shape=box,color=blue];
		2661 -> 2662;
		2661 -> 2663;
	2662 [label="Zawsze do usług. O co chodzi?",shape=box,color=red];
		2662 -> 2665;
	2663 [label="Niestety, nie mogę teraz gadać. [Koniec]",shape=box,color=red];
		2663 -> 2664;
	2665 [label="Check boolean EleanorChristopher2",color=orange];
		2665 -> 2667 [label=true,color=green];
		2665 -> 2666 [label=false,color=brown];
	2664 [label="Chat ends.",color=orange];
	2667 [label="A więc Krzysztof...",shape=box,color=blue];
		2667 -> 2675;
	2666 [label="Check boolean EleanorChristopher1",color=orange];
		2666 -> 2671 [label=true,color=green];
		2666 -> 2668 [label=false,color=brown];
	2675 [label="Kurczowo trzymam się go od lat. Artur też. Każdego roku odprawiamy rytuał ku jego pamięci. Ale nie tym razem, nie byłam w stanie sobie z tym poradzić.",shape=box,color=blue];
		2675 -> 2676;
	2671 [label="To długa i tragiczna historia, więc w dużym skrócie... został zabity przez bombę-pułapkę, zanim się pobraliśmy.",shape=box,color=blue];
		2671 -> 2672;
	2668 [label="To już pora, żebym opowiedziała ci o Krzysztofie.",shape=box,color=blue];
		2668 -> 2669;
	2676 [label="Nie wiem, czy duchy istnieją, ale pewnie mogłyby, bo pozwoliłam mu zostać jednym z nich.",shape=box,color=blue];
		2676 -> 2677;
	2672 [label="Może kiedyś opowiem ci całą historię. A może nie.",shape=box,color=blue];
		2672 -> 2673;
	2669 [label="Najlepszy przyjaciel Artura. Byliśmy zaręczeni. Chyba byłam w nim zakochana.",shape=box,color=blue];
		2669 -> 2670;
	2677 [label="Nie bądź dla siebie taka surowa. Byłaś zakochana w tym człowieku.",shape=box,color=red];
		2677 -> 2678;
	2673 [label="Mówię to teraz, bo...",shape=box,color=blue];
		2673 -> 2674;
	2670 [label="Update boolean EleanorChristopher1",color=orange];
		2670 -> 2671;
	2678 [label="Och, kolego. Tak MYŚLAŁAM. Kochałam go, ale wiem, czy byłam w nim zakochana.",shape=box,color=blue];
		2678 -> 2679;
	2674 [label="Update boolean EleanorChristopher2",color=orange];
		2674 -> 2675;
	2679 [label="Brzmi okropnie, prawda? Taka jest prawda. W tamtej chwili nie miało to znaczenia. A potem odszedł, i to stało się całym sensem tej historii.",shape=box,color=blue];
		2679 -> 2680;
	2680 [label="Wszystko, co w nim pokochałam, zostało przyćmione przez jego śmierć. Na samą myśl o nim robi mi się niedobrze.",shape=box,color=blue];
		2680 -> 2681;
	2681 [label="To nie jest sprawiedliwe wobec niego. Zasługuje na lepszy los.",shape=box,color=blue];
		2681 -> 2682;
		2681 -> 2683;
	2682 [label="Całkowicie rozumiem. Też zdecydowałem się zapamiętać swoich rodziców tak, jak na to zasłużyli.",shape=box,color=red];
		2682 -> 2684;
	2683 [label="To, co się stało, było okropne, bez dwóch zdań. Ale to nie może być jedyna kwestia, jaką pamiętamy.",shape=box,color=red];
		2683 -> 2684;
	2684 [label="Więc dlaczego czuję się taka winna?",shape=box,color=blue];
		2684 -> 2685;
	2685 [label="Dlaczego czuję, że pogodzenie się z tym jest równoznaczne z zapomnieniem o nim?",shape=box,color=blue];
		2685 -> 2686;
		2685 -> 2688;
	2686 [label="Był z tobą tak długo, że nie wiesz, jak to jest żyć bez niego.",shape=box,color=red];
		2686 -> 2687;
	2688 [label="Bo obawiasz się, że nikt inny nie będzie w stanie cię pokochać.",shape=box,color=red];
		2688 -> 2689;
	2687 [label="Na Bogów. Masz rację.",shape=box,color=blue];
		2687 -> 2692;
	2689 [label="Check boolean EleanorDating",color=orange];
		2689 -> 2690 [label=true,color=green];
		2689 -> 2691 [label=false,color=brown];
	2692 [label="Zupełnie nie jesteśmy w stanie sobie z tym poradzić. Dusimy wszystko w sobie, udajemy, że wszystko jest w porządku i radośnie pogwizdujemy w okopach. Pomaga nam to przeżyć, zupełnie jak naszym rodzicom. Ale nie wiemy jak przestać.",shape=box,color=blue];
		2692 -> 2693;
	2690 [label="Czy o to chodzi? Czy jestem aż tak płytka?",shape=box,color=blue];
		2690 -> 2694;
	2691 [label="Nie wiem, czy nawet on by mnie pokochał w takim stanie.",shape=box,color=blue];
		2691 -> 2696;
	2693 [label="Co powinnam zrobić? Jak się z tym pogodzić?",shape=box,color=blue];
		2693 -> 2698;
	2694 [label="W tej chwili nie zasługuję na żadnego z was",shape=box,color=blue];
		2694 -> 2695;
	2696 [label="... nie. To niesprawiedliwe. Nie jestem wobec niego fair, prawda?",shape=box,color=blue];
		2696 -> 2697;
	2698 [label="Check boolean LettieDiasdeMuertos",color=orange];
		2698 -> 2699 [label=true,color=green];
		2698 -> 2700 [label=true,color=green];
		2698 -> 2701 [label=true,color=green];
		2698 -> 2700 [label=false,color=brown];
		2698 -> 2701 [label=false,color=brown];
	2695 [label="Myślę... chyba chcę, żebyś mógł mieć mnie całą. Nie mogę poświęcić części siebie niekończącej się żałobie.",shape=box,color=blue];
		2695 -> 2698;
	2697 [label="On nie chciałby stawać na drodze mojego szczęścia.",shape=box,color=blue];
		2697 -> 2698;
	2699 [label="Myślę, że Lettie byłaby zdolna pomóc.",shape=box,color=red];
		2699 -> 2702;
	2700 [label="Możesz napisać do niego list.",shape=box,color=red];
		2700 -> 2703;
	2701 [label="Może porozmawiaj z Arturem? On też przez to przechodzi.",shape=box,color=red];
		2701 -> 2704;
	2702 [label="Lettie?",shape=box,color=blue];
		2702 -> 2705;
	2703 [label="Część mnie myśli, że to głupi pomysł. Nie przeczyta tego. On nie żyje. Ale...",shape=box,color=blue];
		2703 -> 2706;
	2704 [label="Tak. I może to jest częścią problemu. Wiem, że jest zły, bo nie uszanowałam naszej małej tradycji w tym roku.",shape=box,color=blue];
		2704 -> 2707;
	2705 [label="Dlaczego akurat ona?",shape=box,color=blue];
		2705 -> 2708;
	2706 [label="... im więcej o tym myślę, tym mniej głupie się to wydaje.",shape=box,color=blue];
		2706 -> 2710;
	2707 [label="Po prostu... muszę się z nim pożegnać na SWÓJ sposób. Raz na zawsze.",shape=box,color=blue];
		2707 -> 2711;
	2708 [label="Ma duże doświadczenie. Wie wszystko o upamiętnianiu zmarłych.",shape=box,color=red];
		2708 -> 2709;
	2710 [label="Tak. Zrobię to. Są rzeczy, które muszę mu powiedzieć. Rzeczy, których nie powiedziałam, kiedy żył. Może wtedy będzie mógł spocząć.",shape=box,color=blue];
		2710 -> 2712;
	2711 [label="Dla Artura zawsze będzie jak utracony brat, jak poległy żołnierz. On rozumie taką żałobę, ale to nie moja żałoba.",shape=box,color=blue];
		2711 -> 2713;
	2709 [label="Jestem pewien, że gdybyś poprosiła ją o radę, nie odesłałaby cię z kwitkiem.",shape=box,color=red];
		2709 -> 2720;
	2712 [label="Dziękuję, że mnie wysłuchałeś. I za poradę.",shape=box,color=blue];
		2712 -> 2714;
	2713 [label="Nie mogę to robić na jego sposób. Myślę... że zrozumie, jeśli po prostu mu powiem.",shape=box,color=blue];
		2713 -> 2718;
	2720 [label="…",shape=box,color=blue];
		2720 -> 2721;
	2714 [label="+20 Chemistry",color=orange];
		2714 -> 2715;
	2718 [label="+10 Chemistry",color=orange];
		2718 -> 2719;
	2721 [label="Tak.",shape=box,color=blue];
		2721 -> 2722;
	2715 [label="Nigdy, przenigdy tego nie zapomnę.",shape=box,color=blue];
		2715 -> 2716;
	2719 [label="Dziękuję.",shape=box,color=blue];
		2719 -> 2717;
	2722 [label="Już czas.",shape=box,color=blue];
		2722 -> 2723;
	2716 [label="Chat ends.",color=orange];
	2717 [label="Chat ends.",color=orange];
	2723 [label="+20 Chemistry",color=orange];
		2723 -> 2724;
	2724 [label="Myślę, że muszę się pogodzić z WIELOMA sprawami.",shape=box,color=blue];
		2724 -> 2725;
	2725 [label="Porozmawiam z nią. A jeśli każe mi spieprzać, przynajmniej spróbowałam, nie?",shape=box,color=blue];
		2725 -> 2726;
	2726 [label="Warto spróbować. Lettie tylko wydaje się nie mieć serca.",shape=box,color=red];
		2726 -> 2727;
	2727 [label="Na pewno. Żyjąc w ten sposób, robiąc to, co robimy, odgradzamy się murem. Zapominamy tylko wstawić w nie bramę.",shape=box,color=blue];
		2727 -> 2728;
	2728 [label="Dziękuję za przebijanie się przez mój mur, kochany.",shape=box,color=blue];
		2728 -> 2729;
	2729 [label="Chat ends.",color=orange];
}