digraph {
	286 [label="EleanorRank2Convo1 begins.",color=orange];
		286 -> 287;
		286 -> 288;
		286 -> 289;
	287 [label="Czy jesteś tak chora, jak uważa Lettie?",shape=box,color=red];
		287 -> 290;
	288 [label="Jak się miewa twoja Plaga?",shape=box,color=red];
		288 -> 292;
	289 [label="O co poszło między tobą i Lettie?",shape=box,color=red];
		289 -> 294;
	290 [label="Wyjaśnijmy to sobie. Lettie nie uważa, że jestem chora. Lettie uważa mnie za demona.",shape=box,color=blue];
		290 -> 291;
	292 [label="Nie jest to nieprzyjemne, czego nie można powiedzieć o większości infekcji pasożytem.",shape=box,color=blue];
		292 -> 293;
	294 [label="Słyszałeś, jak mnie nazywa?",shape=box,color=blue];
		294 -> 295;
		294 -> 296;
	291 [label="Zastanawiam się, jak to jest mieć tak romantyczny pogląd na świat. Można by pomyśleć, że medyk przejmowałby się tylko faktami. Dziesięć mililitrów to, zbadaj mikroby tamto.",shape=box,color=blue];
		291 -> 303;
		291 -> 304;
	293 [label="Czuję, jak Technocyty płyną w mojej krwi. Kiedy zamknę oczy, widzę iskierki jak magiczny pył.",shape=box,color=blue];
		293 -> 299;
	295 [label="Nie miałem okazji.",shape=box,color=red];
		295 -> 298;
	296 [label="\"La Bruja Metiche\". Wścibska wiedźma.",shape=box,color=red];
		296 -> 297;
	303 [label="To bardzo naukowe podejście. Spodziewałbym się po tobie, że jesteś bardziej duchowa?",shape=box,color=red];
		303 -> 308;
	304 [label="Brzmisz jakbyś uważała, że \"utrata człowieczeństwa\" jest przesadzona.",shape=box,color=red];
		304 -> 309;
	299 [label="Nie chce zrobić mi krzywdy. Rozumiesz to?",shape=box,color=blue];
		299 -> 302;
	298 [label="\"La Bruja Metiche\". Wścibska wiedźma. Mogło być znacznie, znacznie gorzej, jeśli wziąć pod uwagę jej radosną twórczość w przeklinaniu.",shape=box,color=blue];
		298 -> 300;
	297 [label="Tak. Siedzi tam i szczerzy się zza fiolek i mikstur, buteleczek krwi i kawałków skóry, jej armia służących szczurów kręci się po okolicy, a ona ma czelność nazywać MNIE wiedźmą.",shape=box,color=blue];
		297 -> 305;
		297 -> 306;
		297 -> 307;
	308 [label="Cóż, tak. Żyjąc, jak żyjemy, kto nie zacząłby wierzyć w świat duchowy?",shape=box,color=blue];
		308 -> 313;
	309 [label="Nadal jestem Eleanor Nightingale. To jest dla mnie ważniejsze niż \"człowieczeństwo\".",shape=box,color=blue];
		309 -> 314;
	302 [label="Wszystko, co robi wynika ze szczerej chęci poprawienia mnie i mojego stanu. Jeśli będę zwinna, zabójcza i trudna do zabicia, będę lepszym nosicielem. Więc spełnia swoją część tej symbiotycznej umowy, dając mi skórę rekina, kły wilka i język jak bicz.",shape=box,color=blue];
		302 -> 303;
		302 -> 304;
	300 [label="Słyszałam, jak kazała Quincy'emu zrobić kilka naprawdę pomysłowych rzeczy z zabawkami na placu zabaw i elementami jego anatomii, co muszę przyznać, doprowadziło mnie do śmiechu.",shape=box,color=blue];
		300 -> 301;
	305 [label="Rozumiem, nie lubicie się.",shape=box,color=red];
		305 -> 310;
	306 [label="Zawsze się tak nie lubiłyście?",shape=box,color=red];
		306 -> 311;
	307 [label="Obawia się, że stracisz kontrolę.",shape=box,color=red];
		307 -> 312;
	313 [label="Check boolean EleanorVoidLove",color=orange];
		313 -> 327 [label=true,color=green];
		313 -> 328 [label=false,color=brown];
	314 [label="Widziałam, do czego zdolni są ludzie. Nie jesteśmy wyjątkowi. W rzeczywistości widząc to, co dzieje się w twojej głowie, będzie z nami tylko gorzej.",shape=box,color=blue];
		314 -> 320;
	301 [label="A ona siedzi tam i szczerzy się zza fiolek i mikstur, buteleczek krwi i kawałków skóry, jej armia służących szczurów kręci się po okolicy, a ona ma czelność nazywać MNIE wiedźmą.",shape=box,color=blue];
		301 -> 305;
		301 -> 306;
		301 -> 307;
	310 [label="Nie zrozum mnie źle, gdyby się paliła, UGASIŁABYM ją własnymi szczynami.",shape=box,color=blue];
		310 -> 315;
	311 [label="Sam możesz domyślić się odpowiedzi.",shape=box,color=blue];
		311 -> 318;
	312 [label="Wiem, czasami sama się obawiam. Miewam nawracający koszmar, w którym odrywam jej głowę, kiedy ona przebija moje serce.",shape=box,color=blue];
		312 -> 317;
	327 [label="Pustka jest dowodem tego, że świat duchowy jest równie prawdziwy, co materialny. Wszystko, co zrobili twoi ludzie - prócz nadania jej nowego imienia - to opracowanie metod na wejście i wyjście z niej.",shape=box,color=blue];
		327 -> 328;
	328 [label="Słuchaj. To, że wierzę w istnienie demonów nie oznacza, że cieszy mnie bycie określaną takim mianem.",shape=box,color=blue];
		328 -> 335;
	320 [label="Check boolean EleanorEntrati",color=orange];
		320 -> 324 [label=true,color=green];
		320 -> 325 [label=true,color=green];
		320 -> 326 [label=true,color=green];
		320 -> 325 [label=false,color=brown];
		320 -> 326 [label=false,color=brown];
	315 [label="Ale nie śpieszyłabym się.",shape=box,color=blue];
		315 -> 316;
	318 [label="Chat ends.",color=orange];
	317 [label="Ale strach przed czymś nie czyni tego prawdziwym. Póki co nie dokonałam żadnej rzezi. ANI JEDNEJ.",shape=box,color=blue];
		317 -> 319;
	335 [label="To, co dzieje się wewnątrz mnie, jest nudną konsekwencją atomów i molekuł tańczących w nieprzewidziany i niesamowity sposób. Wszelkie duchowe znaczenie jest zależne ode mnie, nie od Lettie.",shape=box,color=blue];
		335 -> 336;
		335 -> 337;
		335 -> 338;
	324 [label="Chcesz się po prostu poddać? Brzmisz jak Syn.",shape=box,color=red];
		324 -> 329;
	325 [label="Wiedziałabyś, gdybyś tak naprawdę postępowała według planów Plagi?",shape=box,color=red];
		325 -> 330;
	326 [label="Przynajmniej ludzkie geny są naturalne.",shape=box,color=red];
		326 -> 331;
	316 [label="Chat ends.",color=orange];
	319 [label="Amir wyrządził więcej szkód niż ja.",shape=box,color=blue];
		319 -> 321;
	336 [label="Rozumiem, nie lubicie się.",shape=box,color=red];
		336 -> 339;
	337 [label="Zawsze się tak nie lubiłyście?",shape=box,color=red];
		337 -> 341;
	338 [label="Obawia się, że stracisz kontrolę.",shape=box,color=red];
		338 -> 349;
	329 [label="Tego nie powiedziałam.",shape=box,color=blue];
		329 -> 332;
	330 [label="Zamiast spełniania oczekiwań tych śmiesznych, splecionych nukleotydów? Wiesz, tych rzeczy, które ludzie mają od kiedy nauczyli się chodzić na stojąco?",shape=box,color=blue];
		330 -> 333;
	331 [label="Tacy jak Wiktor Vodyanoi - a odpowiedni mu przydomek możesz wybrać samodzielnie - uzasadniają swoje zacofane poglądy twierdząc, że są \"naturalne\". Biologiczny fundamentalizm. Człowiek jest obrazem Boga i takie tam.",shape=box,color=blue];
		331 -> 334;
	321 [label="Ale Amir jest uroczy i lekko nieporadny, prawda? Amir nie ma zębów, którymi można otwierać puszki z żywnością. Nikt nie patrzy na Amira, jak na tykającą bombę.",shape=box,color=blue];
		321 -> 322;
	339 [label="Nie zrozum mnie źle, gdyby się paliła, UGASIŁABYM ją własnymi szczynami.",shape=box,color=blue];
		339 -> 343;
	341 [label="Sam możesz domyślić się odpowiedzi.",shape=box,color=blue];
		341 -> 340;
	349 [label="+10 Chemistry",color=orange];
		349 -> 342;
	332 [label="Niektórzy wierzą, że ludzkość jest święta. Ludzie jak Wiktor. W ich oczach jestem definicją bluźnierstwa. Zakażona, bezwstydna kobieta.",shape=box,color=blue];
		332 -> 351;
		332 -> 354;
	333 [label="\"Ja nie słuchać mały tyran! Ja człowiek. Ja specjalny! Znaleźć partner. Rozmnażać. Bronić terytorium. Uga buga.\"",shape=box,color=blue];
		333 -> 351;
		333 -> 354;
	334 [label="Ale odrzuciliśmy naturę w chwili, kiedy zaczęliśmy walić kamieniami o siebie. Język to wirus kolego. Człowiek to czysta karta, na której można bazgrać, a nie pierwotny Eden, z którego nas wygnano.",shape=box,color=blue];
		334 -> 351;
		334 -> 354;
	322 [label="No, z wyjątkiem Quincy'ego.",shape=box,color=blue];
		322 -> 323;
	343 [label="Ale nie śpieszyłabym się.",shape=box,color=blue];
		343 -> 344;
	340 [label="Chat ends.",color=orange];
	342 [label="Wiem, czasami sama się obawiam. Miewam nawracający koszmar, w którym odrywam jej głowę, kiedy ona przebija moje serce.",shape=box,color=blue];
		342 -> 345;
	351 [label="Techrot mógłby przejąć nad tobą władzę i nawet byś nie zauważyła.",shape=box,color=red];
		351 -> 352;
	354 [label="Eleanor, widziałem, jak pochłania całe KSIĘŻYCE!",shape=box,color=red];
		354 -> 355;
	323 [label="Chat ends.",color=orange];
	344 [label="Chat ends.",color=orange];
	345 [label="Ale strach przed czymś nie czyni tego prawdziwym. Póki co nie dokonałam żadnej rzezi. ANI JEDNEJ.",shape=box,color=blue];
		345 -> 346;
	352 [label="Tak… Masz rację. Niektóre pasożyty tak robią.",shape=box,color=blue];
		352 -> 353;
	355 [label="A co jest takiego pięknego w księżycu wolnym od plagi? Dlaczego pochłonięty księżyc nie jest lepszy?",shape=box,color=blue];
		355 -> 356;
	346 [label="Amir wyrządził więcej szkód niż ja.",shape=box,color=blue];
		346 -> 347;
	353 [label="Ale co jeśli to nie pasożyt, tylko symbiont?",shape=box,color=blue];
		353 -> 359;
		353 -> 360;
	356 [label="O nie! Kawałek skały w kosmosie, który mógł dryfować bez celu przez kolejne kilka tysięcy lat nagle ożył i stał się fascynujący! Cóż za katastrofa!",shape=box,color=blue];
		356 -> 357;
	347 [label="Ale Amir jest uroczy i lekko nieporadny, prawda? Amir nie ma zębów, którymi można otwierać puszki z żywnością. Nikt nie patrzy na Amira, jak na tykającą bombę.",shape=box,color=blue];
		347 -> 348;
	359 [label="Nie masz pojęcia, o czy mówisz. Kiedy ktoś zostanie pochłonięty przez plagę, są całkowicie STRACENI. Zmieniają się nie do poznania.",shape=box,color=red];
		359 -> 361;
	360 [label="Rozumiem, że musisz zaakceptować to, czym się stałaś. Stoi przed tobą niemożliwe wyzwanie.",shape=box,color=red];
		360 -> 362;
	357 [label="To takie samo pierdolenie, jakie usłyszysz od ekipy Wiktora. Kurczowo trzymacie się tego, jakie rzeczy były w przeszłości.",shape=box,color=blue];
		357 -> 358;
	348 [label="No, z wyjątkiem Quincy'ego.",shape=box,color=blue];
		348 -> 350;
	361 [label="Nie wiem, czy próbujesz mnie sprowokować, ale walczyłem z tymi potworami. Czasami możesz rozpoznać resztki człowieka, ręce i nogi wystające z masy mięsa.",shape=box,color=red];
		361 -> 363;
	362 [label="Znienawidź to, czym się stałaś, albo pokochaj to. A coś mówi mi, że jesteś osobą, która już dawno temu oduczyła się nienawidzić samej siebie.",shape=box,color=red];
		362 -> 364;
	358 [label="Jakby pierwotność była równa doskonałości.",shape=box,color=blue];
		358 -> 359;
		358 -> 360;
	350 [label="Chat ends.",color=orange];
	363 [label="To nie symbiont. Nie obchodzi go, czego pragniesz ty. Nie próbuje pomóc. To bardzo agresywny rak, który próbuje pochłonąć wszystko wokół.",shape=box,color=red];
		363 -> 365;
	364 [label="Ale te demony w twojej krwi NIE są przyjaciółmi. Najlepsze co możesz zrobić, to trzymać ich na krótkiej smyczy. Zaufaj mi.",shape=box,color=red];
		364 -> 366;
	365 [label="Przypomnij mi, z czego zrobione są Warframe'y?",shape=box,color=blue];
		365 -> 369;
	366 [label="Myślisz, że tak nie robię?",shape=box,color=blue];
		366 -> 367;
	369 [label="Ludzi zakażonych plagą.",shape=box,color=red];
		369 -> 370;
	367 [label="Masz pojęcie, ile wysiłku wymaga utrzymanie tej furii pod kontrolą? Ile kosztuje mnie utrzymanie tej fasady pogody ducha?",shape=box,color=blue];
		367 -> 368;
	370 [label="Ale ta plaga została ukształtowana i opanowana, prawda?",shape=box,color=blue];
		370 -> 371;
	368 [label="Moje medytacje to nie są próby zjednoczenia się z wielką kosmiczną kapustą. Próbuję schłodzić ten pieprzony reaktor.",shape=box,color=blue];
		368 -> 372;
	371 [label="Tak, jak plaga we mnie.",shape=box,color=blue];
		371 -> 373;
	372 [label="Jestem zdolna zrobić BARDZO wiele, ale tego NIE robię. Mogłabym to wykorzystać na sposoby, o których ci się nie śniło.",shape=box,color=blue];
		372 -> 374;
	373 [label="Znaczy to, że ktoś, gdzieś, miał jaja, żeby przestać myśleś o pladze jako o bezmyślnym potworze i zastanowić się nad jej potencjałem.",shape=box,color=blue];
		373 -> 376;
		373 -> 377;
	374 [label="Mogłabym wejść do ich SNÓW i nawet by nie zauważyli.",shape=box,color=blue];
		374 -> 380;
	376 [label="Och, nie ma szans, że właśnie zasugerowałaś, że Ballas \"miał jaja\".",shape=box,color=red];
		376 -> 385;
	377 [label="Więc… myślisz, że stajesz się bardziej sobą, niż mniej?",shape=box,color=red];
		377 -> 382;
	380 [label="+20 Chemistry",color=orange];
		380 -> 375;
	385 [label="+10 Chemistry",color=orange];
		385 -> 378;
	382 [label="+20 Chemistry",color=orange];
		382 -> 379;
	375 [label="W każdym razie to była ciekawa, choć nieokrzesana wymiana poglądów. Świetnie się bawiłam, powtórzmy to kiedyś.",shape=box,color=blue];
		375 -> 381;
	378 [label="Wiesz, zaczynają nad tobą panować emocję. Dokończymy tę rozmowę innym razem.",shape=box,color=blue];
		378 -> 384;
	379 [label="Ostatnim razem, kiedy oberwałam biochemicznym młotem, przez który spędziłam pół dnia rozwalona na kanapie, a ludzie szeptali za moimi plecami, że \"zamieniam się w potwora\", nazywało się to \"dojrzewaniem\".",shape=box,color=blue];
		379 -> 383;
	381 [label="Chat ends.",color=orange];
	384 [label="Chat ends.",color=orange];
	383 [label="Chat ends.",color=orange];
