digraph {
	2607 [label="EleanorRank5Convo7 begins.",color=orange];
		2607 -> 2608;
	2608 [label="Czy \"Obojętność\" to nazwa CZEGOŚ, czy nazwa CELU?",shape=box,color=blue];
		2608 -> 2609;
		2608 -> 2610;
		2608 -> 2611;
	2609 [label="Ty i Lettie macie taki dziwny nawyk. Zapominacie się przywitać.",shape=box,color=red];
		2609 -> 2613;
	2610 [label="Większość ludzi zaczęłaby od \"hej\".",shape=box,color=red];
		2610 -> 2614;
	2611 [label="[Zignoruj]",shape=box,color=red];
		2611 -> 2612;
	2613 [label="Znalazłeś tę jedną rzecz, która nas łączy, gratulacje. I przepraszam, ale to jest ważniejsze.",shape=box,color=blue];
		2613 -> 2615;
	2614 [label="Przepraszam, ale to jest ważniejsze.",shape=box,color=blue];
		2614 -> 2615;
	2612 [label="Chat ends.",color=orange];
	2615 [label="Podejrzewam, że \"Wielka Obojętność\" będzie próbować nas jakoś rozdzielić.",shape=box,color=blue];
		2615 -> 2616;
	2616 [label="Nie śmiej się, ale czuję to w kościach. Coś, co zaszyło się w Rusałce, chciałoby zobaczyć, jak rozrywamy się na strzępy.",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="Nie wiem dlaczego. Po prostu mam takie przeczucie.",shape=box,color=blue];
		2617 -> 2618;
		2617 -> 2619;
	2618 [label="Tak, myślę, że masz rację.",shape=box,color=red];
		2618 -> 2620;
	2619 [label="Może to dotknęło rodzinę Entratiego. Wiele lat żyli nad laboratorium, o którym nie mieli pojęcia. A kiedy dzieciak ich znalazł, byli wyobcowani, pogrążeni w kłótniach.",shape=box,color=red];
		2619 -> 2620;
	2620 [label="Widziałam to w twojej głowie. Albrecht i Loid. Matka i Ojciec. Ty i twoi rodzice. Z tego, co wiemy, może nawet Rusałka i Wiktor. No i nasza szóstka, oczywiście.",shape=box,color=blue];
		2620 -> 2621;
	2621 [label="To coś jest bezduszne. Zboczone. Ale kryje się za tym jakaś motywacja.",shape=box,color=blue];
		2621 -> 2622;
		2621 -> 2623;
	2622 [label="Myślę, że masz rację. Na Zarimanie, to rodzice pierwsi oszaleli. Może Zatrzymani wytrzymali tak długo, bo nie mieli dzieci.",shape=box,color=red];
		2622 -> 2627;
	2623 [label="Nie lubię zakładać, że jestem w stanie zrozumieć *bogów*. To coś próbuje zrozumieć nasze emocje. Po prostu źle bawi się swoimi zabawkami.",shape=box,color=red];
		2623 -> 2624;
	2627 [label="Niech tylko spróbuje wtargnąć między nas. Na Sol, rozprawię się z tym. Znajdę sposób.",shape=box,color=blue];
		2627 -> 2628;
	2624 [label="Podziwiam tą teorię, ale wiesz, że nie możemy być tego pewni, prawda?",shape=box,color=blue];
		2624 -> 2625;
	2628 [label="We wszechświecie są siły, z którymi to coś nie może się mierzyć. Wierzę w to każdą cząstką siebie.",shape=box,color=blue];
		2628 -> 2629;
	2625 [label="Jeśli tak, wtedy nie możemy tego winić. Jest niewinne jak dziecko. To nie pasuje do tego, co wiemy. Te szkody są umyślne.",shape=box,color=blue];
		2625 -> 2626;
	2629 [label="Jeśli spróbuje mnie połknąć, stanę jak ość w gardle i to uduszę.",shape=box,color=blue];
		2629 -> 2630;
		2629 -> 2631;
	2626 [label="Chat ends.",color=orange];
	2630 [label="Piękna śmierć.",shape=box,color=red];
		2630 -> 2632;
	2631 [label="Jeszcze nie wiemy, jak to zrobimy, ale jestem z tobą. Musimy wygrać.",shape=box,color=red];
		2631 -> 2635;
	2632 [label="W takiej sytuacji i tak bym umarła.",shape=box,color=blue];
		2632 -> 2633;
	2635 [label="Gdyby to była bajka, wpadlibyśmy na jakieś pomysłowe rozwiązanie. Wykopałbyś skamieniałe serce giganta i rozłupał je piórem łabędzia, albo oszukałbyś go, żeby rzucił się z klifu.",shape=box,color=blue];
		2635 -> 2636;
	2633 [label="Ale przynajmniej będę miała okazję splunąć temu w twarz.",shape=box,color=blue];
		2633 -> 2634;
	2636 [label="Mówiłaś, że w przeszłości byłaś \"dziennikarką\". Nie takie historie opowiadałaś, prawda? Mówiłaś prawdę, jakkolwiek okropna by nie była.",shape=box,color=red];
		2636 -> 2637;
	2634 [label="Chat ends.",color=orange];
	2637 [label="Gdyby w starych historyjkach nie było ziarna prawdy, ludzie by ich nie powtarzali.",shape=box,color=blue];
		2637 -> 2638;
	2638 [label="Nie mówię, że giganci istnieli. Po prostu stare historyjki przekazują inną prawdę.",shape=box,color=blue];
		2638 -> 2639;
		2638 -> 2640;
	2639 [label="To będzie wymagać więcej niż bajek, jakkolwiek inspirujące by nie były.",shape=box,color=red];
		2639 -> 2641;
	2640 [label="Żyłem w baśniowym królestwie, wiem, jak potężne mogą być.",shape=box,color=red];
		2640 -> 2643;
	2641 [label="Wiem. Chciałabym móc polegać na czymś więcej niż przeczuciu.",shape=box,color=blue];
		2641 -> 2642;
	2643 [label="Myślę, że wszystkie bajki o pokonaniu gigantów łączy jedno: sprowadzają się do poznania zasad i wykorzystania ich w sprytny sposób.",shape=box,color=blue];
		2643 -> 2644;
	2642 [label="Mierzymy się z czymś ogromnym, przerażającym, przekraczającym pojęcie. Zazwyczaj tylko dzieci mogą to robić. Dlatego istnieją bajki.",shape=box,color=blue];
		2642 -> 2645;
		2642 -> 2646;
	2644 [label="Niektóre potwory są głupie. Inne są bardzo dosłowne. A jeszcze inne mają swoje tajemnice. Ale nie wygrasz, dopóki nie poznasz zasad, którymi się kierują.",shape=box,color=blue];
		2644 -> 2645;
		2644 -> 2646;
	2645 [label="Utknął w Ścianie, a nawet nie wiem, czym jest ta Ściana.",shape=box,color=red];
		2645 -> 2647;
	2646 [label="Nie wiem, czy Obojętność podlega jakimkolwiek zasadom.",shape=box,color=red];
		2646 -> 2649;
	2647 [label="To nie ma znaczenia. Jeśli rzeczywiście utknął, możemy domyślić się dwóch rzeczy, czyż nie?",shape=box,color=blue];
		2647 -> 2651;
	2649 [label="Musi być! Nawet Bogowie mają swoje zasady! Nie ma znaczenia, jak potężna wydaje się Obojętność, nie jest Bogiem.",shape=box,color=blue];
		2649 -> 2650;
	2651 [label="Po pierwsze, może zostać uwięziona.",shape=box,color=blue];
		2651 -> 2653;
	2650 [label="Pokonałeś Thraxa. Nie ma znaczenia, ile razy odniosłeś porażkę i zostałeś pokonany. Ostatecznie WYGRAŁEŚ. Dlaczego miałbyś nie pokonać też Pana ze Ściany?",shape=box,color=blue];
		2650 -> 2648;
	2653 [label="+15 Chemistry",color=orange];
		2653 -> 2652;
	2648 [label="Kiedy przestałaś się bać, Eleanor?",shape=box,color=red];
		2648 -> 2655;
	2652 [label="A po drugie, PRAGNIE czegoś. Pragnie wolności. Wiemy, czego chce, więc mamy już przewagę.",shape=box,color=blue];
		2652 -> 2654;
	2655 [label="Nie przestałam.",shape=box,color=blue];
		2655 -> 2657;
	2654 [label="Chat ends.",color=orange];
	2657 [label="+20 Chemistry",color=orange];
		2657 -> 2656;
	2656 [label="Po prostu bardziej boję się, że cię stracę, okej?",shape=box,color=blue];
		2656 -> 2658;
	2658 [label="Chat ends.",color=orange];
}