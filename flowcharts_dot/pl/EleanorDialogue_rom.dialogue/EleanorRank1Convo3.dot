	203 [label="I jestem już z nią związana?",shape=box,color=blue];
		203 -> 205;
	171 [label="Nigdy nie mieli takiej szansy.",shape=box,color=red];
		171 -> 176;
	172 [label="Przez kształt nasz na myśli… Duviri? Wieże, wyspy i latające wierzchowce?",shape=box,color=blue];
		172 -> 178;
	174 [label="Jaki przyjęła kształt?",shape=box,color=blue];
