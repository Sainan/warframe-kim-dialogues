		182 -> 189;
	180 [label="Pustka tchnęła w nią życie i żyłem wewnątrz niej. Później stała się więzieniem, ale to historia na inny dzień.",shape=box,color=red];
		180 -> 181;
	206 [label="I mam teraz nowe moce. Kontrola umysłów. Roztapianie twarzy.",shape=box,color=blue];
		206 -> 207;
	175 [label="W porządku.",shape=box,color=red];
		175 -> 186;
