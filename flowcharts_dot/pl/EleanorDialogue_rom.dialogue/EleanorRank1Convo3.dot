		205 -> 204;
	176 [label="Och na Sol. To okropne.",shape=box,color=blue];
		176 -> 177;
	178 [label="Tak. Bajka dla dzieci stała się rzeczywistością.",shape=box,color=red];
		178 -> 182;
	179 [label="Była książka, którą uwielbiałem. \"Opowieści z Duviri\". Historyjki o magicznym królestwie, ale w gruncie rzeczy chodziło o emocje i to, czego mogą nas nauczyć.",shape=box,color=red];
		179 -> 180;
	204 [label="Chodzi o to, że jestem Warframem, albo Protoframem. Jestem jak oni.",shape=box,color=blue];
