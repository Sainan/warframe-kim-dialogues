digraph {
	1389 [label="EleanorRank4Convo1 begins.",color=orange];
		1389 -> 1390;
	1390 [label="Muszę zapytać cię o coś, co może ci się nie spodobać. Myślę, że głęboko w środku wiedziałeś, że w związku z moim stanem nadejdzie czas takiej rozmowy.",shape=box,color=blue];
		1390 -> 1391;
	1391 [label="Ufam ci i cię lubię, więc po prostu to powiem, okej?",shape=box,color=blue];
		1391 -> 1392;
	1392 [label="Nie mogę prosić, ale muszę wiedzieć.",shape=box,color=blue];
		1392 -> 1393;
	1393 [label="Gdybym całkowicie się przemieniła - gdyby Techrot mnie pochłonął, a Eleanor, jaką znasz by przepadła - czy zabiłbyś mnie?",shape=box,color=blue];
		1393 -> 1394;
		1393 -> 1395;
		1393 -> 1396;
		1393 -> 1397;
	1394 [label="A chciałabyś tego?",shape=box,color=red];
		1394 -> 1398;
	1395 [label="Tak.",shape=box,color=red];
		1395 -> 1399;
	1396 [label="Nigdy.",shape=box,color=red];
		1396 -> 1400;
	1397 [label="Nie odpowiem na to.",shape=box,color=red];
		1397 -> 1401;
	1398 [label="Hmm. To dobry początek. Zamieniłeś to w kwestię tego, czego ja chcę, zamiast okazję do szczycenia się swoją moralnością. Po prostu dałeś mi znać, że nie chodzi o ciebie.",shape=box,color=blue];
		1398 -> 1402;
	1399 [label="Łał. Okej.",shape=box,color=blue];
		1399 -> 1403;
	1400 [label="Okej, yyy.",shape=box,color=blue];
		1400 -> 1404;
	1401 [label="Jak sobie życzysz.",shape=box,color=blue];
		1401 -> 1405;
	1402 [label="To rzadkie.",shape=box,color=blue];
		1402 -> 1406;
	1403 [label="Zero wątpliwości, żadnej walki, proste \"tak\".",shape=box,color=blue];
		1403 -> 1407;
	1404 [label="Przepraszam, ale jestem trochę przytłoczona. Nie spodziewałam się, że będziesz tak szczery.",shape=box,color=blue];
		1404 -> 1408;
	1405 [label="Nie będę o to więcej pytać.",shape=box,color=blue];
		1405 -> 1409;
	1406 [label="Niestety nie pomaga nam to rozwiązać tego dylematu, bo to znaczy, że nigdy nie będę mogła zmienić zdania.",shape=box,color=blue];
		1406 -> 1410;
	1407 [label="Dziękuję. Pod wieloma względami jesteś dla mnie zagadką, ale teraz wiem, że byłbyś gotów zapakować mi kulkę w łeb i taka wiedza jest ważna w tych warunkach.",shape=box,color=blue];
		1407 -> 1411;
	1408 [label="Pozwoliłbyś potworowi żyć?",shape=box,color=blue];
		1408 -> 1412;
	1409 [label="Chyba będziemy musieli poczekać, aż to się stanie i zobaczyć, jak zareagujesz, prawda?",shape=box,color=blue];
		1409 -> 1413;
	1410 [label="Uznajmy na chwilę, że powiem tak i że chciałabym, żeby to było szybkie i bezbolesne, zamiast żyć jako wygłodniała bestia. Uznajmy, że to OBECNE życzenie Eleanor.",shape=box,color=blue];
		1410 -> 1414;
	1411 [label="Aż poczułam lekki dreszcz niepokoju wśród komórek Techrotu.",shape=box,color=blue];
		1411 -> 1415;
	1412 [label="Przepraszam, przepraszam, po prostu każdego dnia żyję z Lettie powtarzającą mi wciąż, że nie zasługuję, by tutaj być, a Artur patrzy na mnie jak na przegraną sprawę i odlicza dni, aż będzie zmuszony to zrobić. Po prostu nie spodziewałam się, że tak powiesz ok",shape=box,color=blue];
		1412 -> 1422;
	1413 [label="Jesteś małą, zabójczą zagadką.",shape=box,color=blue];
		1413 -> 1417;
	1414 [label="Ale co jeśli tą wygłodniałą bestią jestem ja, tylko bardziej? Co jeśli moje człowieczeństwo zupełnie zaginie wśród Techrotu, a ja NIE BĘDĘ CHCIAŁA umrzeć?",shape=box,color=blue];
		1414 -> 1424;
	1415 [label="Myślę, że teraz będzie odrobinę grzeczniejsza. Nic tak nie sieje strachu przed Sol w pasożycie, jak groźba zabicia jego żywiciela, co nie?",shape=box,color=blue];
		1415 -> 1418;
	1422 [label="+20 Chemistry",color=orange];
		1422 -> 1416;
	1417 [label="Zupełnie jak ja.",shape=box,color=blue];
		1417 -> 1420;
	1424 [label="Bo dzięki niej czuję się żywa, Włóczęgo. Potężnie żywa.",shape=box,color=blue];
		1424 -> 1425;
		1424 -> 1426;
		1424 -> 1427;
		1424 -> 1428;
	1418 [label="Update boolean EleanorNoDate",color=orange];
		1418 -> 1419;
	1416 [label="Rozpłakałam się. To łzy radości. Jeszcze porozmawiamy. Proszę",shape=box,color=blue];
		1416 -> 1423;
	1420 [label="Update boolean EleanorNoDate",color=orange];
		1420 -> 1421;
	1425 [label="Nadal bym to zrobił.",shape=box,color=red];
		1425 -> 1429;
	1426 [label="Masz rację. Nie zrobiłbym tego.",shape=box,color=red];
		1426 -> 1430;
	1427 [label="To zależy, jakie zagrożenie byś sprawiała.",shape=box,color=red];
		1427 -> 1431;
	1428 [label="Nie odpowiedziałaś na pytanie. Czy chciałabyś, żebym to zrobił?",shape=box,color=red];
		1428 -> 1432;
	1419 [label="Chat ends.",color=orange];
	1423 [label="Chat ends. Next chat will be EleanorMonster.",color=orange];
	1421 [label="Chat ends.",color=orange];
	1429 [label="W porządku. Więc poświęcimy szczęśliwą, potężną Eleanor na ołtarzu Eleanor, którą kiedyś była?",shape=box,color=blue];
		1429 -> 1433;
	1430 [label="Och, więc wystarczy tylko, że zamrugam moimi pięknymi oczami, a twoja wola legnie w gruzach?",shape=box,color=blue];
		1430 -> 1434;
	1431 [label="Ach, dobrze. W tym przypadku jestem potworem, który bezmyślnie morduje ludzi. Możesz wrzucić mnie do kategorii \"drapieżników\" wraz z dzikimi psami, głodnymi niedźwiedziami i takimi tam. Znaczy to, że nie ma żadnego dylematu moralnego.",shape=box,color=blue];
		1431 -> 1435;
	1432 [label="… Nie wiem. W niektóre dni bym tego chciała. Czuję się jak typowy bohater melodramatu.",shape=box,color=blue];
		1432 -> 1436;
	1433 [label="Mogę zmienić swoje zdanie i zdecydować się żyć, ale ty nie zmienisz swojego?",shape=box,color=blue];
		1433 -> 1442;
	1434 [label="Jaki byłby z ciebie nieustraszony łowca wampirów?",shape=box,color=blue];
		1434 -> 1443;
	1435 [label="Więc powiedz mi.",shape=box,color=blue];
		1435 -> 1438;
	1436 [label="\"Och nie, nieszczęsna dziewczyna, którą kiedyś kochaliśmy, stała się seksownym wampirem. Zabijmy ją, aby po śmierci znów była czysta i niewinna.\"",shape=box,color=blue];
		1436 -> 1437;
	1442 [label="Nie powinnam być zaskoczona. To koniec, na jaki przygotowują cię historyjki.",shape=box,color=blue];
		1442 -> 1444;
	1443 [label="Powiem ci coś. Jesteś typem gościa, który umiera w połowie filmu, bo nie masz jaj zrobić Tego Co Było Konieczne.",shape=box,color=blue];
		1443 -> 1445;
	1438 [label="Będziesz zwlekać z wpakowaniem mi kulki między oczy, aż kogoś w końcu zabiję?",shape=box,color=blue];
		1438 -> 1439;
	1437 [label="Update boolean EleanorArthurNightmare",color=orange];
		1437 -> 1441;
	1444 [label="\"Och nie, nieszczęsna dziewczyna, którą kiedyś kochaliśmy, stała się seksownym wampirem. Zabijmy ją, aby po śmierci znów była czysta i niewinna.\"",shape=box,color=blue];
		1444 -> 1448;
	1445 [label="Będziesz ostrzeżeniem dla innych!",shape=box,color=blue];
		1445 -> 1446;
	1439 [label="Bo jeśli nie, to jak możesz wiedzieć, czy jestem zagrożeniem?",shape=box,color=blue];
		1439 -> 1440;
	1441 [label="Wiele się nad tym zastanawiałam. Miewałam koszmary, w których budziłam się na kanapie, a nade mną stał Artur ze łzami w oczach i mieczem w ręku. Wyplułby jakiś komentarz o tym, jak Eleanor była siostrą ale ta Eleanor już przepadła i musiał to zrobić, nawet jeśli też przez to cierpiał. Buu huu.",shape=box,color=blue];
		1441 -> 1450;
	1448 [label="Update boolean EleanorArthurNightmare",color=orange];
		1448 -> 1449;
	1446 [label="Przepraszam. Nie jestem wobec ciebie całkiem uczciwa. Jeszcze porozmawiamy.",shape=box,color=blue];
		1446 -> 1447;
	1440 [label="Chat ends.",color=orange];
	1450 [label="A potem wbijał ostrze między żebra, kiedy ja krzyczałam \"Eleanor NADAL TU JEST ty tępy draniu!\" ale on mnie już nie słyszał.",shape=box,color=blue];
		1450 -> 1451;
	1449 [label="Wiele się nad tym zastanawiałam. Miewałam koszmary, w których budziłam się na kanapie, a nade mną stał Artur ze łzami w oczach i mieczem w ręku. Wyplułby jakiś komentarz o tym, jak Eleanor była siostra ale ta Eleanor już przepadła i musiał to zrobić, nawet jeśli też przez to cierpiał. Boo hoo.",shape=box,color=blue];
		1449 -> 1455;
	1447 [label="Chat ends.",color=orange];
	1451 [label="Więc słyszę, że nie chcesz podjąć tej decyzji już teraz.",shape=box,color=red];
		1451 -> 1452;
	1455 [label="A potem wbijał ostrze między żebra, kiedy ja krzyczałam \"Eleanor NADAL TU JEST ty tępy draniu!\" ale on mnie już nie słyszał.",shape=box,color=blue];
		1455 -> 1456;
	1452 [label="W tym przypadku też nie mogę jej podjąć.",shape=box,color=red];
		1452 -> 1453;
	1456 [label="Może następnym razem przyśnisz mi się ty.",shape=box,color=blue];
		1456 -> 1457;
	1453 [label="+20 Chemistry",color=orange];
		1453 -> 1454;
	1457 [label="Chat ends.",color=orange];
	1454 [label="Chat ends.",color=orange];
}