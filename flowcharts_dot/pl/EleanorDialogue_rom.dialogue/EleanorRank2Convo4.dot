digraph {
	553 [label="EleanorRank2Convo4 begins.",color=orange];
		553 -> 554;
	554 [label="Jak myślisz, co się dzieje po śmierci?",shape=box,color=blue];
		554 -> 555;
		554 -> 556;
		554 -> 557;
		554 -> 558;
	555 [label="A dobrze, Eleanor, dziękuję, że pytasz! A u ciebie?",shape=box,color=red];
		555 -> 560;
	556 [label="…wszystko w porządku?",shape=box,color=red];
		556 -> 561;
	557 [label="Widziałem dość, żeby wiedzieć, że osobowość może przetrwać śmierć.",shape=box,color=red];
		557 -> 562;
	558 [label="Koniec głupich rozmów. [Koniec]",shape=box,color=red];
		558 -> 559;
	560 [label="Heh.",shape=box,color=blue];
		560 -> 563;
	561 [label="Nie.",shape=box,color=blue];
		561 -> 564;
	562 [label="Kontynuuj?",shape=box,color=blue];
		562 -> 565;
	559 [label="Chat ends.",color=orange];
	563 [label="Słuchaj, jeśli chcesz, możemy porozmawiać o pogodzie.",shape=box,color=blue];
		563 -> 566;
	564 [label="Ale nie chodzi mi o śmierć w makabryczny sposób, jeśli cię to martwi. Na razie cieszy mnie wizja długiego życia.",shape=box,color=blue];
		564 -> 567;
	565 [label="(Możesz wyobrazić sobie, że leżę na kanapie, opierając głowę na rękach i z niecierpliwością wpatruję się w Pom-2, oczekując twojej odpowiedzi)",shape=box,color=blue];
		565 -> 572;
		565 -> 573;
		565 -> 574;
		565 -> 575;
	566 [label="Albo skoro już jesteśmy w centrum handlowym, możemy skoczyć na kawę i pogadać o tym, jaką suką jest Lettie, bo zachowuje te wszystkie różowo-żółte rzeczy dla siebie, zamiast nas wspomóc, nie?",shape=box,color=blue];
		566 -> 568;
	567 [label="Po prostu mam bardzo dużo czasu na rozmyślanie o tym, kiedy moje biedne komórki wiją się i biją niczym w magicznym kotle, którym stał się mój układ krwionośny.",shape=box,color=blue];
		567 -> 572;
		567 -> 573;
		567 -> 574;
		567 -> 575;
	572 [label="W moich czasach mamy \"Cefalony\". Szklane sześciany, które były kiedyś ludźmi i nadal przejawiają swoją osobowość. W większości.",shape=box,color=red];
		572 -> 576;
	573 [label="Orokin brali udział w rytuale, który pozwalał im przenieść swoją świadomość do nowego ciała, aby żyć wiecznie.",shape=box,color=red];
		573 -> 577;
	574 [label="Wszyscy Tenno polegają na \"Transferencji\", aby kontrolować Warframe'y. Nie jesteśmy uwiązani do fizycznej postaci, więc nie ma sensu wyobrażać sobie końca naszego bytu, kiedy nasze ciała umierają.",shape=box,color=red];
		574 -> 578;
	575 [label="Naprawdę nie czuję się komfortowo podsycając twoją obsesję, Eleanor.",shape=box,color=red];
		575 -> 579;
	568 [label="(Czuję się podle, że to napisałam. Przepraszam)",shape=box,color=blue];
		568 -> 569;
	576 [label="Check boolean EleanorOrigin",color=orange];
		576 -> 580 [label=true,color=green];
		576 -> 581 [label=false,color=brown];
	577 [label="Check boolean EleanorEntrati",color=orange];
		577 -> 582 [label=true,color=green];
		577 -> 583 [label=false,color=brown];
	578 [label="Check boolean EleanorVoidLove",color=orange];
		578 -> 584 [label=true,color=green];
		578 -> 585 [label=false,color=brown];
	579 [label="Obsesję?",shape=box,color=blue];
		579 -> 586;
	569 [label="Wiem, że pomijam znaczny kawałek luźnej pogawędki, ale szczerze, to twoja wina, że jesteś tak ciekawym tematem.",shape=box,color=blue];
		569 -> 570;
	580 [label="Widziałam to. Nie uważam, żeby życie w formie uznawanej za KARĘ przez Orokin jest godne takiego określenia.",shape=box,color=blue];
		580 -> 581;
	581 [label="Ble. Chyba wolałabym umrzeć na dobre.",shape=box,color=blue];
		581 -> 588;
	582 [label="Ze wszystkich okropieństw, jakie czekają tę planetę, myślę, że Orokin są najgorsi.",shape=box,color=blue];
		582 -> 583;
	583 [label="Zastanawiam się, czy jest już za późno, żeby ich powstrzymać. Może wystarczy zabić właściwego motyla.",shape=box,color=blue];
		583 -> 589;
	584 [label="Więcej magii Pustki. Im więcej wiem o Pustce, tym bardziej chcę ją odwiedzić. Może to ona jest moi domem? Daleko za granicą mapy, gdzie może stać się wszystko. Wy, Tenno, macie Pustkę we krwi. Szczęściarze.",shape=box,color=blue];
		584 -> 585;
	585 [label="Wszystko się świetnie dla was składa, ale co z resztą z nas? Nie wszyscy możemy zostać Tenno, prawda?",shape=box,color=blue];
		585 -> 590;
	586 [label="Że niby co? Jesteś małym, nieszczęsnym kosmitą, który zgubił się daleko od domu, a ja jestem wielkim złym naukowcem, który chce cię pokroić i zajrzeć do środka?",shape=box,color=blue];
		586 -> 587;
	570 [label="Podróżujący w czasie półbóg pojawia się w moim i tak już szalonym życiu, a ja mam dbać o zachowanie grzeczności?",shape=box,color=blue];
		570 -> 571;
	588 [label="Nie bądź wredna, Eleanor. Cefalony to ludzie.",shape=box,color=red];
		588 -> 595;
	589 [label="Wyobraź sobie, cała rzesza zadufanych w sobie dupków ot tak przestałą istnieć. Jedynie szkoda byłoby mi tego, że nie usłyszałabym ich wrzasku.",shape=box,color=blue];
		589 -> 597;
	590 [label="Mówię tylko, że można przeżyć śmierć.",shape=box,color=red];
		590 -> 599;
	587 [label="Przepraszam, odniosłam wrażenie, że uważaliśmy SIEBIE NAWZAJEM za intrygujących. Byłam przekonana, że nasze małe sprzeczki były próbami poznania się.",shape=box,color=blue];
		587 -> 591;
	571 [label="Możesz powiedzieć mi rzeczy, których nie usłyszę od nikogo innego. Więc proszę cię, zanim rozniosę meble w drzazgi, rozmawiaj ze mną.",shape=box,color=blue];
		571 -> 572;
		571 -> 573;
		571 -> 574;
		571 -> 575;
	595 [label="Przerwij mi, jeśli się mylę, ale… to co opisujesz nie brzmi jakby to była ta sama osoba. Raczej jak komputer, który MYŚLI, że nadal jest tą samą osobą. Mylę się?",shape=box,color=blue];
		595 -> 596;
	597 [label="Chociaż…",shape=box,color=blue];
		597 -> 598;
	599 [label="Tak, tak, wiem, o co ci chodzi. Wróćmy do tematu.",shape=box,color=blue];
		599 -> 600;
	591 [label="Ale nie. Najwyraźniej niczym nie różnie się od fanki Zeke'a, która spędza cały swój czas skupiona na swojej \"obsesji\".",shape=box,color=blue];
		591 -> 592;
	596 [label="Chyba? Nekraloid do Cefalon stworzony z Loida, który nadal żyje. Ale nawet jeśli Cefalon nie jest oryginałem, to nadal ludzie.",shape=box,color=red];
		596 -> 601;
	598 [label="Cholera.",shape=box,color=blue];
		598 -> 602;
	600 [label="Pustka może być miejscem, w którym istnieją dusze. O to nam chodzi? Ktoś włamał się do świata duchowego, a teraz możecie wykorzystać go do zasilania połowy swoich urządzeń?",shape=box,color=blue];
		600 -> 605;
	592 [label="Wasza wysokość nie jest już w Duviri. Nikogo to tutaj nie obchodzi.",shape=box,color=blue];
		592 -> 593;
	601 [label="Mhm. Przepraszam, ale to nie to samo. Nie mówimy tutaj o osobowości. Rozmawiamy o ciągłości istnienia.",shape=box,color=blue];
		601 -> 806;
	602 [label="Gdybym pozbyła się ich, pozbyłabym się też CIEBIE, prawda? Bo twoje istnienie jest zależne od ICH istnienia.",shape=box,color=blue];
		602 -> 603;
		602 -> 604;
	605 [label="Nie byle kogo. Entratiego. To on postawił pierwsze kroki w Pustce.",shape=box,color=red];
		605 -> 606;
	593 [label="Ogarnij się.",shape=box,color=blue];
		593 -> 594;
	806 [label="Amir mógłby zaprogramować w gadającej lalce kilka powiedzeń Eleanor i straszyć nią Lettie, kiedy już umrę, ale to nie byłbym JA.",shape=box,color=blue];
		806 -> 807;
	603 [label="Och tak, tego właśnie potrzebujemy. Kolejnej osoby mieszającej w czasie.",shape=box,color=red];
		603 -> 610;
	604 [label="Albo stworzysz nową gałąź historii.",shape=box,color=red];
		604 -> 611;
	606 [label="Powinnam była wiedzieć, że ten dwulicowy drań macał palce w tej sprawie.",shape=box,color=blue];
		606 -> 608;
	594 [label="Chat ends.",color=orange];
	807 [label="Chyba że mogłabym jakoś zawładnąć tą lalką. Muszę nad tym pomyśleć.",shape=box,color=blue];
		807 -> 622;
		807 -> 623;
	610 [label="Wow.",shape=box,color=blue];
		610 -> 612;
	611 [label="Nawet mnie nie prowokuj, bo utkniemy tu na tydzień.",shape=box,color=blue];
		611 -> 613;
	608 [label="Czy ktokolwiek spotkał umarłą osobę w Pustce? Albo czy Pustka przyjęła kiedykolwiek formę zmarłego? Przepraszam, że pytam, ale muszę wiedzieć.",shape=box,color=blue];
		608 -> 609;
	622 [label="Jeśli wygląda jak rozpłatnica i skrzecze jak rozpłatnica, to musi być rozpłatnica. Na jedno wychodzi, prawda?",shape=box,color=red];
		622 -> 624;
	623 [label="Wiele to dla ciebie znaczy, prawda?",shape=box,color=red];
		623 -> 625;
	612 [label="Myślałam, że to tylko ciekawa rozmowa.",shape=box,color=blue];
		612 -> 614;
	613 [label="Nadal jesteśmy na etapie \"czy dusza może przetrwać śmierć ciała\", nie możemy teraz przejść do tematu \"czy wolna wola istnieje\".",shape=box,color=blue];
		613 -> 615;
	609 [label="Znam kilku takich zmarłych ludzi. Zatrzymanych.",shape=box,color=red];
		609 -> 617;
	624 [label="Hmm. Nie, nie sądzę.",shape=box,color=blue];
		624 -> 640;
	625 [label="Och, zauważyłeś?",shape=box,color=blue];
		625 -> 645;
	614 [label="Żeby było jasne, nie mam ŻADNYCH planów, żeby mieszać przyszłością. Po prostu",shape=box,color=blue];
		614 -> 616;
	615 [label="(zapracowałaś sobie na to, powiedziała Eleanor do siebie. To tutaj doprowadziło cię zadawanie Poważnych Pytań)",shape=box,color=blue];
		615 -> 622;
		615 -> 623;
	617 [label="Update boolean EleanorHoldfasts1",color=orange];
		617 -> 626;
	640 [label="Gdyby Pustka stworzyła moją kopię, nie przesypiałabym wielu nocy, zastanawiając się, która z nas jest prawdziwa.",shape=box,color=blue];
		640 -> 641;
	645 [label="Tak, to wiele dla mnie znaczy.",shape=box,color=blue];
		645 -> 646;
	616 [label="Wiesz co? Nie ważne.",shape=box,color=blue];
		616 -> 618;
	626 [label="Że co?",shape=box,color=blue];
		626 -> 627;
	641 [label="Jeśli jest do tego zdolna, kiedy umrzesz, musi być do tego zdolna też, kiedy żyjesz.",shape=box,color=blue];
		641 -> 642;
	646 [label="Obawiam się, że więcej, niż można się spodziewać.",shape=box,color=blue];
		646 -> 647;
	618 [label="PRÓBOWAŁAM przekazać jak bardzo nie chcę, żebyś zniknął. Do tego stopnia, że byłabym skłonna pozwolić ludziom w mojej przyszłości cierpieć pod jarzmem tyranów, niż to zmienić.",shape=box,color=blue];
		618 -> 619;
	627 [label="Znasz zmarłych ludzi? Znaczy, masz z nimi kontakt?",shape=box,color=blue];
		627 -> 628;
	642 [label="...nie podoba mi się, dokąd zmierza ta dyskusja. Przepraszam. Innym razem. Może.",shape=box,color=blue];
		642 -> 643;
	647 [label="Powiedzmy, że mam swoje powody wierzyć, że coś z nas przetrwa śmierć ciała. Wiem, że nie jestem jedyna.",shape=box,color=blue];
		647 -> 648;
	619 [label="Niesmaczny żart. Przepraszam. To się więcej nie powtórzy.",shape=box,color=blue];
		619 -> 620;
	628 [label="Pamiętają swoją śmierć? Wiedzą, że nie żyją?",shape=box,color=blue];
		628 -> 629;
		628 -> 630;
	643 [label="+10 Chemistry",color=orange];
		643 -> 644;
	648 [label="Update boolean EleanorBereaved",color=orange];
		648 -> 649;
	620 [label="+5 Chemistry",color=orange];
		620 -> 621;
	629 [label="Tak. W przeszłości byli oficerami na pokładzie Zarimana. Statku kolonizacyjnym, który zagubił się w Pustce. Teraz chyba są duchami?",shape=box,color=red];
		629 -> 631;
	630 [label="To... trochę skomplikowane. Można trafić do Pustki, ale to, co z niej wróci, nie zawsze jest takie samo.",shape=box,color=red];
		630 -> 632;
	644 [label="Chat ends.",color=orange];
	649 [label="Zwracasz się z tym pytaniem do niewłaściwej osoby. Nie jestem pewien, czy w ogóle mogę umrzeć.",shape=box,color=red];
		649 -> 650;
	621 [label="Chat ends.",color=orange];
	631 [label="Jasna cholera, to niesamowite.",shape=box,color=blue];
		631 -> 633;
	632 [label="Ach, ciężko ci dobrać właściwe słowa? Czy po prostu nie chcesz powiedzieć mi wszystkiego? Robię się nerwowa, kiedy ludzie ukrywają przede mną prawdę.",shape=box,color=blue];
		632 -> 634;
	650 [label="Check boolean EleanorDuviri",color=orange];
		650 -> 651 [label=true,color=green];
		650 -> 652 [label=false,color=brown];
	633 [label="Chociaż…",shape=box,color=blue];
		633 -> 635;
	634 [label="Chwila, nie opowiadaj. Coś mignęło mi przed oczami. Nie wiem, czy to jedna z twoich zagubionych myśli, czy nie, ale na Sol, co za koszmar.",shape=box,color=blue];
		634 -> 636;
	651 [label="Ach tak. Próbowali wielokrotnie, prawda? Thrax zrobił z ciebie widowisko. Nie wiem jak przeżyłeś ten koszmar i nie zwariowałeś.",shape=box,color=blue];
		651 -> 652;
	652 [label="Między nami, nie wiem, czy ja też mogę umrzeć.",shape=box,color=blue];
		652 -> 653;
	635 [label="Skąd wiemy, że to nadal ta sama osoba?",shape=box,color=blue];
		635 -> 637;
	636 [label="Anioły.",shape=box,color=blue];
		636 -> 638;
	653 [label="Żyje we mnie komitet malutkich Technocytów, którzy byliby niezwykle zdenerwowani, gdyby ich dom został zniszczony.",shape=box,color=blue];
		653 -> 654;
	637 [label="A co jeśli to po prostu... Klon Pustki albo coś? Czy to możliwe? Pustka nadaje formę IDEI człowieka, a ona MYŚLI, że jest osobą, która już nie żyje.",shape=box,color=blue];
		637 -> 622;
		637 -> 623;
	638 [label="Na Lua, słyszę je. Brzmią jak... szum klimatyzatora, o którym dawno zapomniałeś, że działa",shape=box,color=blue];
		638 -> 639;
	654 [label="Dlatego też włożyły tyle wysiłku, żeby uczynić ze mnie dużą i silną dziewczynkę.",shape=box,color=blue];
		654 -> 655;
	639 [label="Dlaczego do cholery cię o to zapytałam",shape=box,color=blue];
		639 -> 668;
	655 [label="Zastanawiam się, co by się stało, gdybym została zabita na miejscu Techrot jest zdolny do utrzymania zwłok na chodzie, wykorzystać je inaczej. Widziałam to. Jak kolonia termitów próbująca pilotować robota.",shape=box,color=blue];
		655 -> 656;
	668 [label="Dobrze, dobrze. W porządku. Muszę się skupić. Zaczekaj chwilę, buduję mur w myślach, który odgrodzi mnie od aniołów.",shape=box,color=blue];
		668 -> 669;
	656 [label="A więc… stałabym się zombie? Gdyby Techrot mnie ożywił, czy nadal byłabym sobą? Czy byłabym tylko manifestacją Techrotu, który uzyskał dostęp do moich wspomnień i MYŚLAŁ, że jest mną?",shape=box,color=blue];
		656 -> 657;
	669 [label="Mur mur mur mój kochany mur",shape=box,color=blue];
		669 -> 670;
	657 [label="Nie uważam, żeby zastanawianie się nad tym było zdrowe.",shape=box,color=red];
		657 -> 658;
	670 [label="I jest. Otoczona murem. Teraz mam spokój. Też powinnam dać ci spokój, prawda?",shape=box,color=blue];
		670 -> 671;
	658 [label="Nie uważam, żeby była zdrowa.",shape=box,color=blue];
		658 -> 659;
	671 [label="+10 Chemistry",color=orange];
		671 -> 672;
	659 [label="Ale…",shape=box,color=blue];
		659 -> 660;
	672 [label="Chat ends.",color=orange];
	660 [label="Cieszę się, że zależy ci na tyle, żeby to powiedzieć.",shape=box,color=blue];
		660 -> 661;
	661 [label="Lettie sprawdzi czasem, jak trzyma się moje ciało, bo Artur potrzebuje mnie w pełnej gotowości. Nie mam jej za złe, to jej praca.",shape=box,color=blue];
		661 -> 662;
	662 [label="Ale nikogo nie obchodzi jak ja się CZUJĘ.",shape=box,color=blue];
		662 -> 663;
	663 [label="A przynajmniej do teraz.",shape=box,color=blue];
		663 -> 664;
	664 [label="Na Bogów, jesteś po prostu miły, a minęło tak długo czasu, od kiedy ludzie byli dla siebie po prostu MILI, że jest to dla mnie wielkie zaskoczenie godne pochwały.",shape=box,color=blue];
		664 -> 666;
	666 [label="+20 Chemistry",color=orange];
		666 -> 665;
	665 [label="Ehem. Dziękuję ci. To tyle.",shape=box,color=blue];
		665 -> 667;
	667 [label="Chat ends.",color=orange];
}