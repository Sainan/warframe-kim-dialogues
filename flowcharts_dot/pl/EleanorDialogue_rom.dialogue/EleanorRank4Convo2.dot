digraph {
	1521 [label="EleanorRank4Convo2 begins.",color=orange];
		1521 -> 1522;
	1522 [label="Och Włóczęgo! Och wędrowcze przez czas i przestrzeń! Jaką radość sprawia mi twoja obecność na moim ekranie!",shape=box,color=blue];
		1522 -> 1523;
		1522 -> 1524;
	1523 [label="Hej, Eleanor.",shape=box,color=red];
		1523 -> 1526;
	1524 [label="Zw, Kalimosa znowu bawi się kablami i może mi zerwać - [Koniec]",shape=box,color=red];
		1524 -> 1525;
	1526 [label="Hej koleżko.",shape=box,color=blue];
		1526 -> 1527;
	1525 [label="Chat ends.",color=orange];
	1527 [label="Zgadnij co.",shape=box,color=blue];
		1527 -> 1528;
		1527 -> 1529;
	1528 [label="Masz pytanie związane z życiem w przyszłości?",shape=box,color=red];
		1528 -> 1530;
	1529 [label="Wyrósł ci ogon.",shape=box,color=red];
		1529 -> 1531;
	1530 [label="Ugh. Stałam się cholernie przewidywalna.",shape=box,color=blue];
		1530 -> 1533;
	1531 [label="... chciałbyś tego, prawda?",shape=box,color=blue];
		1531 -> 1532;
	1533 [label="Tak, mam. Kolejne. Ale tym razem to naprawdę długie pytanie, więc wytrzymaj ze mną chwilę, okej?",shape=box,color=blue];
		1533 -> 1534;
	1532 [label="Więc nie. Nie wyrósł mi ogon. Mój tyłek nie może zostać poprawiony, bo już jest doskonały.",shape=box,color=blue];
		1532 -> 1535;
	1534 [label="Postaram się.",shape=box,color=red];
		1534 -> 1536;
	1535 [label="Ale nadal mam dla ciebie pytanie.",shape=box,color=blue];
		1535 -> 1537;
	1536 [label="Dobrze, doskonale. Więc.",shape=box,color=blue];
		1536 -> 1537;
	1537 [label="Jak działają związki w twoich czasach? Znaczy, czy to typowe \"dwóch lub więcej dorosłych decyduje, ze są razem z różnym stopniem wzajemnej adoracji\"? Czy macie jakieś zasady, kto może z kim być?",shape=box,color=blue];
		1537 -> 1538;
		1537 -> 1539;
		1537 -> 1540;
	1538 [label="To nie jest temat, z którym się zapoznałem.",shape=box,color=red];
		1538 -> 1541;
	1539 [label="Zależy od kultury.",shape=box,color=red];
		1539 -> 1542;
	1540 [label="… dlaczego pytasz?",shape=box,color=red];
		1540 -> 1543;
	1541 [label="Kurde.",shape=box,color=blue];
		1541 -> 1547;
	1542 [label="Ach tak, oczywiście.",shape=box,color=blue];
		1542 -> 1548;
	1543 [label="Check boolean EleanorEntrati",color=orange];
		1543 -> 1544 [label=true,color=green];
		1543 -> 1545 [label=false,color=brown];
	1547 [label="Wiedziałam, że byłeś sam na Duviri, ale nie pomyślałam, ze byłeś AŻ TAK sam.",shape=box,color=blue];
		1547 -> 1552;
	1548 [label="Spróbujmy inaczej.",shape=box,color=blue];
		1548 -> 1550;
	1544 [label="Ta dwójka na Deimosie, Matka i Ojciec, są małżeństwem. Może są gigantycznymi, zakażonymi, już-nie-Orokin, ale niepodważalnie są MAŁŻEŃSTWEM tak jak moja mama i tata.",shape=box,color=blue];
		1544 -> 1546;
	1545 [label="Z tego co zobaczyłam w twojej głowie, widzę typowe pary ludzi. Ludzi, którzy niepodważalnie są MAŁŻEŃSTWEM tak jak moja mama i tata.",shape=box,color=blue];
		1545 -> 1546;
	1552 [label="+15 Chemistry",color=orange];
		1552 -> 1549;
	1550 [label="Zobaczmy...",shape=box,color=blue];
		1550 -> 1554;
	1546 [label="Więc jak wyglądało to w przypadku Orokin?",shape=box,color=blue];
		1546 -> 1551;
	1549 [label="Przepraszam, jeśli sprawiłam ci przykrość tym pytaniem.",shape=box,color=blue];
		1549 -> 1553;
	1554 [label="Okej, więc tam skąd jesteś, czy to normalne być w związku z np. Cefalonem?",shape=box,color=blue];
		1554 -> 1555;
		1554 -> 1556;
	1551 [label="Orokin kochali swoje zasady i tabu. Uwielbiali hierarchię. Związki nie mogły przekraczać granic społecznych. Na przykład Daks nie mógł być w związku ze szlachcicem Orokin.",shape=box,color=red];
		1551 -> 1554;
	1553 [label="Chat ends.",color=orange];
	1555 [label="Mogę spróbować przyprowadzić Ordisa do tych czasów, jeśli chciałabyś spróbować...",shape=box,color=red];
		1555 -> 1557;
	1556 [label="… nigdy czegoś takiego nie słyszałem. Nie wiem, jak mogłoby to działać.",shape=box,color=red];
		1556 -> 1560;
	1557 [label="To HIPOTETYCZNA sytuacja!",shape=box,color=blue];
		1557 -> 1558;
	1560 [label="Cholera, spróbujmy jeszcze raz.",shape=box,color=blue];
		1560 -> 1561;
	1558 [label="Nie śpieszy mi się ocierać o twojego szklanego kolegę, niezależnie od jego uroku osobistego",shape=box,color=blue];
		1558 -> 1559;
	1561 [label="Wyobraź sobie kogoś ze swojego czasu, niebezpieczną kobietę. Silną, jak Major Rusałka, ale nieopętana przez demona.",shape=box,color=blue];
		1561 -> 1562;
		1561 -> 1563;
	1559 [label="Nieudolnie próbuję zapytać cię o RÓŻNICE W STATUSIE",shape=box,color=blue];
		1559 -> 1561;
	1562 [label="Snajper Grineer?",shape=box,color=red];
		1562 -> 1564;
	1563 [label="Daks?",shape=box,color=red];
		1563 -> 1565;
	1564 [label="Okej. Załóżmy, że snajperka Grineer zakochała się w człowieku z wzajemnością. Nieszczęśliwi kochankowie, tragiczna sytuacja. Mogliby być razem?",shape=box,color=blue];
		1564 -> 1566;
		1564 -> 1567;
		1564 -> 1568;
		1564 -> 1569;
	1565 [label="Okej. Załóżmy, że żołnierka Daks zakochała się w człowieku z wzajemnością. Nieszczęśliwi kochankowie, tragiczna sytuacja. Mogliby być razem?",shape=box,color=blue];
		1565 -> 1566;
		1565 -> 1567;
		1565 -> 1568;
		1565 -> 1569;
	1566 [label="Jeśli oboje tego chcą, czemu nie.",shape=box,color=red];
		1566 -> 1570;
	1567 [label="Dlaczego nie?",shape=box,color=red];
		1567 -> 1570;
	1568 [label="Chciałbym zobaczyć, jak ktoś próbuje ich powstrzymać.",shape=box,color=red];
		1568 -> 1570;
	1569 [label="Tak, ale to by było skomplikowane.",shape=box,color=red];
		1569 -> 1576;
	1570 [label="Jak ci to wytłumaczyć.",shape=box,color=blue];
		1570 -> 1572;
	1576 [label="+5 Chemistry",color=orange];
		1576 -> 1571;
	1572 [label="Czy w twoich czasach to normalne, że w pary łączą się ludzie na zupełnie różnych szczeblach społecznych? Coś jak opowieść \"Gumbly i Smocze Skarpety\", w którym książę elfów wychodzi za olbrzyma?",shape=box,color=blue];
		1572 -> 1574;
	1571 [label="Dziękuję.",shape=box,color=blue];
		1571 -> 1573;
	1574 [label="… nie masz pojęcia o czym mówię, prawda?",shape=box,color=blue];
		1574 -> 1578;
		1574 -> 1579;
	1573 [label="Pytanie: czy dwójka ludzi o zupełnie różnych budowach ciał i poziomach zagrożenia mogą być razem w związku?
Odpowiedź: tak.",shape=box,color=blue];
		1573 -> 1575;
	1578 [label="Chyba wiem, o co chodzi.",shape=box,color=red];
		1578 -> 1582;
	1579 [label="Nie, raczej nie.",shape=box,color=red];
		1579 -> 1580;
	1575 [label="To wszystko, co chciałam wiedzieć.",shape=box,color=blue];
		1575 -> 1577;
	1582 [label="Nie chcę psuć ci dnia. Przepraszam.",shape=box,color=blue];
		1582 -> 1583;
	1580 [label="Lepiej przestanę, zanim zupełnie zrobię z siebie idiotkę.",shape=box,color=blue];
		1580 -> 1581;
	1577 [label="Chat ends.",color=orange];
	1583 [label="Mogę ponarzekać na siebie?",shape=box,color=blue];
		1583 -> 1584;
		1583 -> 1585;
	1581 [label="Chat ends.",color=orange];
	1584 [label="Narzekaj.",shape=box,color=red];
		1584 -> 1587;
	1585 [label="Nie mam na to czasu, przepraszam. [Koniec]",shape=box,color=red];
		1585 -> 1586;
	1587 [label="NIE MÓWIĘ, że moje życie jest bezsensowne, bo nie mam z kim go dzielić",shape=box,color=blue];
		1587 -> 1588;
	1586 [label="Chat ends.",color=orange];
	1588 [label="NIE OKREŚLA MNIE to, kogo pokocham",shape=box,color=blue];
		1588 -> 1589;
	1589 [label="Sama sobie wystarczam",shape=box,color=blue];
		1589 -> 1590;
	1590 [label="ALE JAK DO CHOLERY MAM MYŚLEĆ O ZWIĄZKU, KIEDY W CHWILI UNIESIENIA MOGŁABYM KOGOŚ PRZYPADKIEM ZABIĆ",shape=box,color=blue];
		1590 -> 1591;
	1591 [label="Oto Eleanor i jej problemy napalonej modliszki",shape=box,color=blue];
		1591 -> 1592;
	1592 [label="Jeśli kiedykolwiek znajdę Entratiego, zrobię sobie kolczyki z jego jaj, jeśli w ogóle je ma.",shape=box,color=blue];
		1592 -> 1593;
		1592 -> 1594;
	1593 [label="Zawsze możesz umówić się z kimś z Hex.",shape=box,color=red];
		1593 -> 1595;
	1594 [label="Chwila. Jesteś sama, bo boisz się, że kogoś zranisz?",shape=box,color=red];
		1594 -> 1596;
	1595 [label="NA SOL",shape=box,color=blue];
		1595 -> 1597;
	1596 [label="Tak.",shape=box,color=blue];
		1596 -> 1601;
	1597 [label="GRYZĘ JĘZYK PRÓBUJĄC SIĘ NIE ROZEŚMIAĆ",shape=box,color=blue];
		1597 -> 1598;
	1601 [label="Lepiej wiesz, czym jestem. Jestem Protoframem. Częściowo ukształtowaną maszyną wojenną, a \"częściowo\" zanika z każdym dniem.",shape=box,color=blue];
		1601 -> 1602;
	1598 [label="Jedyną osobą z całej czwórki, którą w ogóle wzięłabym pod UWAGĘ, jest Aoi, ale to skomplikowane przez sprawy z Arturem",shape=box,color=blue];
		1598 -> 1599;
	1602 [label="Ktokolwiek zaprojektował biedną \"Nyx\" tworzył zabójcę. To teraz ja. Skuteczna. Zabójcza. Przytulaśna jak mina przeciwpiechotna.",shape=box,color=blue];
		1602 -> 1603;
	1599 [label="Doceniam sugestię, ale nie ma szans",shape=box,color=blue];
		1599 -> 1600;
	1603 [label="Wszystko jest świetnie, dopóki chodzi o pracę, ale kto na święta pocałuje chodzącą pułapkę pod jemiołą?",shape=box,color=blue];
		1603 -> 1604;
		1603 -> 1606;
	1600 [label="Chat ends.",color=orange];
	1604 [label="To niechciana krzywda, o której wspomniałaś. Czy to kiedykolwiek miało miejsce? Czy zraniłaś kiedyś swojego partnera?",shape=box,color=red];
		1604 -> 1605;
	1606 [label="Z drugiej strony, dobre wieści są takie, że nikt w Höllvanii nie zostaje martwy na długo i powraca po resecie...",shape=box,color=red];
		1606 -> 1607;
	1605 [label="Nie, nie skrzywdziłam nikogo, bo do tego nie dopuściłam. OK?",shape=box,color=blue];
		1605 -> 1608;
	1607 [label="...",shape=box,color=blue];
		1607 -> 1609;
	1608 [label="Żadnych partnerów, żadnych szkód. Gra nie warta świeczki.",shape=box,color=blue];
		1608 -> 1610;
	1609 [label="Nie wzięłam tego pod uwagę.",shape=box,color=blue];
		1609 -> 1611;
	1610 [label="Wolę być sama niż tonąć w poczuciu winy, dzięki.",shape=box,color=blue];
		1610 -> 1612;
	1611 [label="Ale nasze wspomnienia pozostają.",shape=box,color=blue];
		1611 -> 1613;
	1612 [label="Więc jesteś sama od czasu zastrzyków Entratiego?",shape=box,color=red];
		1612 -> 1618;
	1613 [label="Nie wiem, czy ktokolwiek chciałby być w związku z kimś, kto odgryzł mu głowę, nawet jeśli po tym wydobrzał.",shape=box,color=blue];
		1613 -> 1614;
	1618 [label="+20 Chemistry",color=orange];
		1618 -> 1615;
	1614 [label="Lua zapłakała. Muszę się teraz napić.",shape=box,color=blue];
		1614 -> 1620;
	1615 [label="Dokładnie tok. Kompromis, na który jestem gotowa.",shape=box,color=blue];
		1615 -> 1616;
	1620 [label="Chat ends.",color=orange];
	1616 [label="Przepraszam, nie wiem, czy rozmawianie o tym to był taki dobry pomysł.",shape=box,color=blue];
		1616 -> 1617;
	1617 [label="Chyba muszę pobyć trochę sama.",shape=box,color=blue];
		1617 -> 1619;
	1619 [label="Chat ends.",color=orange];
}