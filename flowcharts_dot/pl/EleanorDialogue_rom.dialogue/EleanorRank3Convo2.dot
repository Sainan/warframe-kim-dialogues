digraph {
	924 [label="EleanorRank3Convo2 begins.",color=orange];
		924 -> 926;
	926 [label="Check boolean EleanorIndifference",color=orange];
		926 -> 925 [label=true,color=green];
		926 -> 927 [label=false,color=brown];
	925 [label="Masz chwilę? Muszę pogadać.",shape=box,color=blue];
		925 -> 928;
		925 -> 929;
	927 [label="Jesteś tam? Muszę porozmawiać o czymś poważnym.",shape=box,color=blue];
		927 -> 931;
		927 -> 929;
	928 [label="Jasne.",shape=box,color=red];
		928 -> 932;
	929 [label="Bardzo przepraszam, teraz nie dam rady. [Koniec]",shape=box,color=red];
		929 -> 930;
	931 [label="Jestem, proszę bardzo.",shape=box,color=red];
		931 -> 933;
	932 [label="Pamiętasz jak opowiedziałam ci o tym, jak próbowałam zajrzeć do głowy Rusałki i zamiast tego nawiązałam więź z Obojętnością?",shape=box,color=blue];
		932 -> 935;
	930 [label="Chat ends.",color=orange];
	933 [label="Dziękuję.",shape=box,color=blue];
		933 -> 934;
	935 [label="Oczywiście, że tak.",shape=box,color=red];
		935 -> 938;
	934 [label="Rozumiesz, co stało się z Major Rusałką?",shape=box,color=blue];
		934 -> 936;
		934 -> 937;
	938 [label="Wtedy nie byłam gotowa rozmawiać na ten temat, ale teraz chciałabym do niego wrócić.",shape=box,color=blue];
		938 -> 945;
	936 [label="Obojętność wykorzystywała ją jak marionetkę.",shape=box,color=red];
		936 -> 939;
	937 [label="Wydaje mi się, że była już pusta w środku i kierowano nią jak... Warframem...?",shape=box,color=red];
		937 -> 940;
	945 [label="Jeśli masz na to ochotę.",shape=box,color=red];
		945 -> 946;
	939 [label="\"Obojętność\". Tak to nazywasz?",shape=box,color=blue];
		939 -> 941;
	940 [label="Pusta w środku, tak.",shape=box,color=blue];
		940 -> 942;
	946 [label="Jestem pewna.",shape=box,color=blue];
		946 -> 947;
	941 [label="Dziękuję.",shape=box,color=blue];
		941 -> 943;
	942 [label="Ale cokolwiek nią kierowało, nie było takie jak ty.",shape=box,color=blue];
		942 -> 944;
	947 [label="To stworzenie, ta obecność, to z tym ostatecznie walczymy. Tyle teraz wiem.",shape=box,color=blue];
		947 -> 951;
	943 [label="Czuję, jakbym odzyskiwała odrobinę kontroli przez nadanie temu nazwy.",shape=box,color=blue];
		943 -> 948;
	944 [label="Człowieczeństwo tego czegoś było tylko parodią.",shape=box,color=blue];
		944 -> 949;
	951 [label="Powiedz mi prawdę. Wierzysz, że jest nadzieja?",shape=box,color=blue];
		951 -> 956;
		951 -> 957;
		951 -> 958;
	948 [label="Dotknęłam tego moim umysłem. Myślałam, że zajrzę do głowy Rusałki, ale… zewnętrzne warstwy zapadły się, jak zgniłe drewno, a potem zaczęłam się w tym topić.",shape=box,color=blue];
		948 -> 950;
	949 [label="Było w tym tyle człowieka, co w sklepowym manekinie. W kawałkach.",shape=box,color=blue];
		949 -> 952;
	956 [label="W tej chwili? ...nie.",shape=box,color=red];
		956 -> 960;
	957 [label="Szczerze? Nie wiem.",shape=box,color=red];
		957 -> 961;
	958 [label="Tak.",shape=box,color=red];
		958 -> 962;
	950 [label="Update boolean EleanorIndifference",color=orange];
		950 -> 951;
	952 [label="Dotknęłam jej umysłu. Próbowałam ją zrozumieć, ale jej tam nie było.",shape=box,color=blue];
		952 -> 953;
	960 [label="Przynajmniej jesteś szczery.",shape=box,color=blue];
		960 -> 963;
	961 [label="Rozumiem.",shape=box,color=blue];
		961 -> 964;
	962 [label="Nie chcę wiedzieć dlaczego.",shape=box,color=blue];
		962 -> 965;
	953 [label="Wiem, o czym mówisz. Nazywamy to Obojętnością.",shape=box,color=red];
		953 -> 954;
	963 [label="Dobrze. Pozwólmy nadziei umrzeć.",shape=box,color=blue];
		963 -> 966;
	964 [label="Tak wiele nie wiemy.",shape=box,color=blue];
		964 -> 967;
	965 [label="Trzymaj się tej wiary, pozwól mi ją poczuć.",shape=box,color=blue];
		965 -> 968;
	954 [label="Dziękuję.",shape=box,color=blue];
		954 -> 955;
	966 [label="Będę walczyć z prostego, durnego uporu.",shape=box,color=blue];
		966 -> 969;
	967 [label="Po tym, co stało się w tym roku, jak możemy mieć jakiekolwiek rozsądne plany?",shape=box,color=blue];
		967 -> 970;
	968 [label="Proszę.",shape=box,color=blue];
		968 -> 971;
	955 [label="Czuję, jakbym odzyskiwała odrobinę kontroli przez nadanie temu nazwy.",shape=box,color=blue];
		955 -> 959;
	969 [label="Z nienawiści, wściekłości, czegokolwiek.",shape=box,color=blue];
		969 -> 973;
	970 [label="Może nadzieja to ułuda. Nie wiem.",shape=box,color=blue];
		970 -> 974;
	971 [label="Sięgnęłam Rusałki i poczułam, jakby moje palce dotknęły jej twarzy i zanurzyły się dalej. Jakby maska się zapadła.",shape=box,color=blue];
		971 -> 975;
	959 [label="Update boolean EleanorIndifference",color=orange];
		959 -> 972;
	973 [label="Lepsze to, niż apatia. Niż potulne poddanie się.",shape=box,color=blue];
		973 -> 978;
	974 [label="W tej chwili by mi się przydała. Choćby odrobina.",shape=box,color=blue];
		974 -> 977;
	975 [label="A to, co kryło się pod spodem…",shape=box,color=blue];
		975 -> 976;
	972 [label="Dotknęłam tego moim umysłem. Myślałam, że zajrzę do głowy Rusałki, ale… zewnętrzne warstwy zapadły się, jak zgniłe drewno, a potem zaczęłam się w tym topić.",shape=box,color=blue];
		972 -> 976;
	978 [label="Jestem gotowa.",shape=box,color=blue];
		978 -> 979;
	977 [label="No cóż, tak więc jest. Nawet jeśli błąkamy się przez mrok, przynajmniej mamy swoje towarzystwo.",shape=box,color=blue];
		977 -> 980;
	976 [label="Mamy takie określenie. \"Gorączka tropikalna\". Szaleństwo, które dotykało żeglarzy. Byli przez nią przekonani, że otaczająca ich morska woda była zieloną trawą.",shape=box,color=blue];
		976 -> 981;
	979 [label="Chat ends.",color=orange];
	980 [label="Chat ends.",color=orange];
	981 [label="Kusiło ich to do zeskoczenia ze statku na piękne zielone łąki, bieganie po nich. Jeśli któryś z towarzyszy próbował ich powstrzymać, walczyli.",shape=box,color=blue];
		981 -> 982;
	982 [label="Wskoczyłam, spodziewając się trawy, a następne co mnie spotkało, to niewyobrażalny chłód i mrok.",shape=box,color=blue];
		982 -> 983;
	983 [label="Update boolean EleanorIndifference2",color=orange];
		983 -> 984;
		983 -> 986;
	984 [label="Nie wiem, czy powinnaś tak o tym mówić.",shape=box,color=red];
		984 -> 985;
	986 [label="Jestem przy tobie. Mów.",shape=box,color=red];
		986 -> 987;
	985 [label="Cholera.",shape=box,color=blue];
		985 -> 988;
	987 [label="To uczucie, które nie ma nazwy. Patrzysz na świat i po prostu WIESZ, że wszystko, co zwyczajne - budynki, samochody, ludzie, praca, rutyna - to tylko cienka fasada, za którą kryje się bezdenny koszmar, a gdyby ludzie to kiedykolwiek zrozumieli, nigdy nie przestaliby krzyczeć.",shape=box,color=blue];
		987 -> 989;
	988 [label="Prawie się do tego psychicznie przygotowałam a teraz co? Unikamy wzmianek o diable, żeby go przypadkiem nie przywołać?",shape=box,color=blue];
		988 -> 990;
	989 [label="Przeleciałam przez tą fasadę.",shape=box,color=blue];
		989 -> 992;
	990 [label="Jeśli w nocy usłyszysz wrzaski, to będę ja.",shape=box,color=blue];
		990 -> 991;
	992 [label="To nie była pustka. Z tym bym sobie poradziła. Trwało i trwało to w nieskończoność, ale to nie była zimna pustka. Tam było coś jeszcze.",shape=box,color=blue];
		992 -> 993;
		992 -> 994;
		992 -> 995;
	991 [label="Chat ends.",color=orange];
	993 [label="Oko?",shape=box,color=red];
		993 -> 997;
	994 [label="Mężczyzna uwięziony w ścianie?",shape=box,color=red];
		994 -> 997;
	995 [label="Co to było?",shape=box,color=red];
		995 -> 996;
	997 [label="Nie wiem. Wiem, że coś tam było. Wiem, że to WIEDZIAŁO o mnie. Jak słoń świadomy muchy pełzającej po jego oku.",shape=box,color=blue];
		997 -> 998;
	996 [label="+5 Chemistry",color=orange];
		996 -> 997;
	998 [label="Pamiętam swoją myśl, \"nic tak wielkiego nie powinno wiedzieć o moim istnieniu\".",shape=box,color=blue];
		998 -> 999;
	999 [label="Poczułam tak niezmierną pogardę siebie, monumentalną obojętność, natychmiast chciałam przestać istnieć.",shape=box,color=blue];
		999 -> 1000;
		999 -> 1001;
	1000 [label="Tak... taki ma wpływ na ludzi.",shape=box,color=red];
		1000 -> 1002;
	1001 [label="Co zrobiłaś?",shape=box,color=red];
		1001 -> 1002;
	1002 [label="Myślę, że poradziłabym sobie z nienawiścią. Wtedy miałabym dla tego jakąś wartość, znaczenie. Ale to coś zupełnie nie widziało we mnie żadnej wartości. Zobaczyłam, co to coś zobaczyło - cząstkę kurzu. Nic.",shape=box,color=blue];
		1002 -> 1003;
	1003 [label="Wszystko, co przeżyłam, każda chwila czułości, każdy uśmiech, każda cząstka Eleanor Nightingale zaginęła w tej burzy.",shape=box,color=blue];
		1003 -> 1004;
	1004 [label="Poczułam, jak moje światło dogasa, przysięgam, że poczułam wtedy dreszczyk satysfakcji. Jakby cieszyło mnie, że zostanę przez to zmiażdżona. Niczym pchła pod paznokciem.",shape=box,color=blue];
		1004 -> 1005;
	1005 [label="Ale wróciłaś, prawda? Nadal jesteś z nami. Udowodniłaś, że było inaczej.",shape=box,color=red];
		1005 -> 1006;
	1006 [label="Czy na pewno?",shape=box,color=blue];
		1006 -> 1007;
	1007 [label="To nadal tam jest, czyż nie?",shape=box,color=blue];
		1007 -> 1008;
		1007 -> 1009;
	1008 [label="Tak, ale ty też jesteś tutaj.",shape=box,color=red];
		1008 -> 1011;
	1009 [label="Gwiazdy nie przestają lśnić tylko dlatego, że kosmos jest wielki, zimny i ciemny.",shape=box,color=red];
		1009 -> 1010;
	1011 [label="Ostatecznie wygra Obojętność, bez względu na to, ile wysiłków rzucimy w otchłań.",shape=box,color=blue];
		1011 -> 1012;
	1010 [label="Ale kiedyś przestaną. Pewnego dnia. Śmierć cieplna wszechświata.",shape=box,color=blue];
		1010 -> 1011;
	1012 [label="To jest cena niezwariowania. Nadal możesz jasno myśleć.",shape=box,color=blue];
		1012 -> 1013;
	1013 [label="Wiesz, o czym mówię. Mogłeś rozlecieć się na milion kawałków, albo spalić swój mózg narkotykami, aż nic więcej byś nie czuł. To wszystko bolałoby więcej niż ta… wiedza.",shape=box,color=blue];
		1013 -> 1014;
	1014 [label="Nie wiem, dlaczego jeszcze nie porzuciłeś tej rozmowy.",shape=box,color=blue];
		1014 -> 1015;
		1014 -> 1016;
	1015 [label="Rozumiem entropię. Może Wielka Obojętność jest tym samym. Może wygrywa na koniec. Nie wiem. Ale wiem, że nie pozwolę jej wygrać TERAZ.",shape=box,color=red];
		1015 -> 1017;
	1016 [label="Czekam, aż się w końcu do cholery zdecydujesz. Chcesz pójść na łatwiznę, czy zwariować? A może poderwij dupsko z kanapy i zacznij walczyć?",shape=box,color=red];
		1016 -> 1018;
	1017 [label="Przeżyjemy to razem, jeśli w ogóle nam się to uda.",shape=box,color=red];
		1017 -> 1020;
	1018 [label="WALCZYĆ",shape=box,color=blue];
		1018 -> 1019;
	1020 [label="Więc twoją taktyką jest odgrodzenie się murem od egzystencjalnej rozpaczy? Bardzo w stylu Artura.",shape=box,color=blue];
		1020 -> 1021;
	1019 [label="CZY TYLKO TYLE JESTEŚCIE W STANIE POJĄĆ RAZEM Z ARTUREM? WALKĘ?",shape=box,color=blue];
		1019 -> 1022;
	1021 [label="Wierz lub nie, ale zależy mi na tobie.",shape=box,color=red];
		1021 -> 1027;
	1022 [label="TWOJĄ ODPOWIEDZIĄ NA FUNDAMENTALNĄ BEZSENSOWNOŚĆ ISTNIENIA JEST \"SZUKANIE SPOSOBU, JAK TEMU PRZYWALIĆ?\"",shape=box,color=blue];
		1022 -> 1023;
	1027 [label="Też mi na tobie zależy. Jedziemy towarzyszami broni. Wiele razem przeszliśmy.",shape=box,color=blue];
		1027 -> 1028;
	1023 [label="Nie wierzę, że mieliśmy cokolwiek wspólnego.",shape=box,color=blue];
		1023 -> 1024;
	1028 [label="Ale uczciwie jest cię ostrzec, że stary łajba Eleanor może zatonąć, albo w morzu krwi, albo w czarnym jak atrament bagnie i nie chcę, żebyś był wtedy na pokładzie.",shape=box,color=blue];
		1028 -> 1030;
	1024 [label="Jak mogłam być tak głupia.",shape=box,color=blue];
		1024 -> 1025;
	1030 [label="+20 Chemistry",color=orange];
		1030 -> 1029;
	1025 [label="Update boolean EleanorNoDate",color=orange];
		1025 -> 1026;
	1029 [label="Dzięki. Powinieneś już iść. Poradzę sobie, naprawdę.",shape=box,color=blue];
		1029 -> 1031;
	1026 [label="Chat ends.",color=orange];
	1031 [label="Chat ends.",color=orange];
}