digraph {
	673 [label="EleanorRank2Convo5 begins.",color=orange];
		673 -> 674;
	674 [label="Hej Eleanor...",shape=box,color=red];
		674 -> 675;
	675 [label="Hej, co chodzi ci po głowie?",shape=box,color=blue];
		675 -> 683;
		675 -> 676;
	683 [label="W przeszłości byłaś \"dziennikarzem\", prawda? Co to znaczy?",shape=box,color=red];
		683 -> 684;
	676 [label="W sumie nic. [Koniec]",shape=box,color=red];
		676 -> 677;
	684 [label="To osoba, która zamienia traumę innych ludzi w pieniądze.",shape=box,color=blue];
		684 -> 685;
	677 [label="Ja.",shape=box,color=blue];
		677 -> 678;
	685 [label="Ach, rozumiem. My nazywamy ich \"Corpus\".",shape=box,color=red];
		685 -> 686;
	678 [label="...",shape=box,color=blue];
		678 -> 679;
	686 [label="Check boolean EleanorOrigin",color=orange];
		686 -> 687 [label=true,color=green];
		686 -> 688 [label=false,color=brown];
	679 [label="Ty -",shape=box,color=blue];
		679 -> 680;
	687 [label="Och, na Bogów. Przepraszam, tylko żartuję.",shape=box,color=blue];
		687 -> 688;
	688 [label="Spróbujmy jeszcze raz.",shape=box,color=blue];
		688 -> 689;
	680 [label="To ty zacząłeś...",shape=box,color=blue];
		680 -> 681;
	689 [label="Dziennikarz to osoba, która poszukuje ciekawych tematów w świecie i dzieli się nimi z innym ludźmi, na papierze lub w formie audycji. Często obu.",shape=box,color=blue];
		689 -> 690;
	681 [label="Zagadkowe stworzenie...",shape=box,color=blue];
		681 -> 682;
	690 [label="Swego rodzaju bajkopisarz, ale nie wszystko jest zmyślone.",shape=box,color=blue];
		690 -> 691;
		690 -> 692;
	682 [label="Chat ends.",color=orange];
	691 [label="A co czyni historię \"interesującą\"?",shape=box,color=red];
		691 -> 693;
	692 [label="Więc mówisz tylko prawdę? Jak wybierasz prawdy, które chcesz opowiedzieć?",shape=box,color=red];
		692 -> 693;
	693 [label="Większość czasu ludzie są zainteresowani czytaniem o tragediach w świecie. Ciągnie ich do krwi, jak to mawiają.",shape=box,color=blue];
		693 -> 694;
	694 [label="Nie wyobrażam sobie, że w twoich czasach jest inaczej.",shape=box,color=blue];
		694 -> 695;
	695 [label="Swoją pracą próbowałam zmienić świat. Płacili mi za to, to prawda, ale chciałam też czynić dobro na świecie.",shape=box,color=blue];
		695 -> 696;
	696 [label="Check boolean EleanorHatesHeroes",color=orange];
		696 -> 697 [label=true,color=green];
		696 -> 698 [label=false,color=brown];
	697 [label="Byłam wtedy młodsza, rzecz jasna. Nic nie leczy chęci \"czynienia dobra na świecie\" tak dobrze, jak spędzenie w nim odrobiny czasu.",shape=box,color=blue];
		697 -> 699;
	698 [label="Właśnie tutaj to do mnie dotarło. Przybyłam do Höllvanii tylko ze względu na pracę.",shape=box,color=blue];
		698 -> 700;
	699 [label="Przepraszam, zgubiłam wątek. Muszę się wyżalić. Chcesz posłuchać o małej sprawie, która bardzo mnie wkurza?",shape=box,color=blue];
		699 -> 701;
		699 -> 702;
	700 [label="Myślałem, że jesteś tu z powodu Artura.",shape=box,color=red];
		700 -> 705;
	701 [label="Jasne, czemu nie.",shape=box,color=red];
		701 -> 704;
	702 [label="Szczerze mówiąc, nie. [Koniec]",shape=box,color=red];
		702 -> 703;
	705 [label="Och, on był tu pierwszy, ale popełnił błąd mówiąc mi, co się tu dzieje, a ja nie mogłam siedzieć bezczynnie. Zadzwoniłam do starego znajomego, Danny'ego MacIlvoya i zapłaciłam ekstra za podrobiony paszport i wizę, których potrzebowałam na szybko.",shape=box,color=blue];
		705 -> 706;
	704 [label="Ok, ale nie mów później, że cię nie ostrzegałam. Mam swoją teorię o czymś, co nazywam \"Wirusem Bohaterów\".",shape=box,color=blue];
		704 -> 707;
	703 [label="Chat ends.",color=orange];
	706 [label="Musisz zrozumieć jedno: odcinali Höllvanię od reszty świata, ale nie mogli zrobić tego w jednej chwili. To miasto-państwo może być oddzielone murem od czasów Promiennej Khan, ale mury, które postawili przeciwko niej są stare, a nowa władza nie była zdolna zamknąć wszystkich dróg na czas.",shape=box,color=blue];
		706 -> 708;
	707 [label="Wyobraź sobie wirusa, który przenoszony jest przez opowieści. Zupełnie jak inne wirusy, zależy mu na przejęciu kontroli nad gospodarzem i szerzeniu się dalej.",shape=box,color=blue];
		707 -> 709;
	708 [label="Ludzie potykali się o siebie próbując uciec, więc nikt nie zwracał szczególnej uwagi na głupią Brytyjkę, która próbowała wejść do środka.",shape=box,color=blue];
		708 -> 710;
	709 [label="Wirus Bohatera sprawia, że widzisz świat jak opowieść. Przekonuje cię, że Dobro to WSPANIAŁE CZYNY wykonywane przez POJEDYNCZYCH LUDZI",shape=box,color=blue];
		709 -> 711;
	710 [label="A wiesz, co było najgorsze?",shape=box,color=blue];
		710 -> 712;
		710 -> 713;
	711 [label="Więc naturalnie chcesz być taką osobą",shape=box,color=blue];
		711 -> 720;
	712 [label="Dajesz.",shape=box,color=red];
		712 -> 717;
	713 [label="Czy to będzie obrzydliwe?",shape=box,color=red];
		713 -> 714;
	720 [label="Nieważne jak trudne to może być",shape=box,color=blue];
		720 -> 721;
	717 [label="Ok, najgorsze było to.",shape=box,color=blue];
		717 -> 718;
	714 [label="Och, nagle masz słaby żołądek?",shape=box,color=blue];
		714 -> 715;
	721 [label="Ponieważ Bohater musi podejmować trudne decyzje. Bohater musi spokojnie znosić ból.",shape=box,color=blue];
		721 -> 722;
	718 [label="Badałam sprawę wybuchu choroby, którą nazwano Syndromem Testudo. Testudo znaczy żółw, a jednym z wczesnych objawów było pojawienie się obszarów zrogowaciałej skóry. Tej samej, która dla niektórych z nas zamieniła się później w pancerz.",shape=box,color=blue];
		718 -> 719;
	715 [label="Wybacz mi, że nie dostosowałam się do twojego wyrafinowanego gustu. Nieważne.",shape=box,color=blue];
		715 -> 716;
	722 [label="Cyniczne pierdolenie. Wirus Bohatera istnieje po to, aby sprzedawać zabawki, filmy, i wychować nowe pokolenie mięsa armatniego",shape=box,color=blue];
		722 -> 723;
	719 [label="Syndrom Testudo opierał się leczeniu i zdawał się występować wyłącznie w Höllvanii, był powiązany z komputerami w niezrozumiały sposób i dotknął całego miasta jednocześnie. A ludzie, którzy zadawali za dużo pytań, mieli tendencje do wąchania kwiatków od spodu w Höllvanii.",shape=box,color=blue];
		719 -> 724;
	716 [label="Chat ends.",color=orange];
	723 [label="Nie kręci się filmów o Wybranym, którego przeznaczeniem jest wycieranie tyłków w domu starców",shape=box,color=blue];
		723 -> 725;
	724 [label="W ciągu kilku godzin od przybycia do Höllvanii, sama przedzierałam się przez ścieki i próbowałam uspokoić Artura wkurzonego bardziej, niż kiedykolwiek wcześniej.",shape=box,color=blue];
		724 -> 726;
	725 [label="To już prawie koniec, wytrzymaj jeszcze moment.",shape=box,color=blue];
		725 -> 727;
	726 [label="Ten chłop. Pomyślałbyś, że poszłam za nim tylko po to, żeby zrobić mu na złość.",shape=box,color=blue];
		726 -> 728;
		726 -> 729;
		726 -> 730;
	727 [label="Wirus Bohatera wmawia ci, że najwięcej dobrego zdziałasz w blasku reflektorów. Wyznacza niemożliwy do osiągnięcia cel",shape=box,color=blue];
		727 -> 733;
	728 [label="Brzmi, jakbyś nie potraktowała tej sytuacji poważnie.",shape=box,color=red];
		728 -> 735;
	729 [label="Przyznaj się, tak było.",shape=box,color=red];
		729 -> 736;
	730 [label="Nie, ale to *był* miły bonus, prawda?",shape=box,color=red];
		730 -> 737;
	733 [label="+15 Chemistry",color=orange];
		733 -> 731;
	735 [label="Ja brałam to na poważnie.",shape=box,color=blue];
		735 -> 738;
	736 [label="Oczywiście, że tak. Ale miałam też przed sobą szczytny cel.",shape=box,color=blue];
		736 -> 739;
	737 [label="Dokładnie. Ale miałam też przed sobą szczytny cel.",shape=box,color=blue];
		737 -> 739;
	731 [label="Artur myśli, że straci mnie przez Techrot, ale prawda jest taka, że to ja straciłam go dawno temu przez Wirus Bohatera.",shape=box,color=blue];
		731 -> 732;
	738 [label="Ludzie próbowali mnie zabić. Wybacz mi, że pomagam sobie humorem.",shape=box,color=blue];
		738 -> 740;
	739 [label="\"Szczytny\". Na jajca Sol... Zapracowałam sobie na to, co mnie spotkało, prawda?",shape=box,color=blue];
		739 -> 741;
		739 -> 742;
	732 [label="Update boolean EleanorHeroVirus",color=orange];
		732 -> 734;
	740 [label="Może spędziłeś za dużo czasu sam ze sobą, ale w zespole jak nasz, robienie z siebie jaj pomaga nam nie zwariować.",shape=box,color=blue];
		740 -> 745;
	741 [label="Miałaś opowiedzieć o najgorszym.",shape=box,color=red];
		741 -> 743;
	742 [label="Brzmi jakbyście po prostu wykonywali swoją robotę. Co się stało później?",shape=box,color=red];
		742 -> 744;
	734 [label="Chat ends.",color=orange];
	745 [label="Przyznaję, że czasami przesadzamy żartami, szczególnie kiedy Lettie przechodzi przez swój epizod depresyjny i musi się na kimś wyżyć",shape=box,color=blue];
		745 -> 746;
	743 [label="Tak tak.",shape=box,color=blue];
		743 -> 744;
	744 [label="Więc przedzieram się przez kanały, a nagle przebiegło coś z kupą monitorów zamiast głowy. Ledwo skończyłam srać pod siebie, kiedy znalazłam gniazdo.",shape=box,color=blue];
		744 -> 749;
	746 [label="Ale błagam cię, dla dobra nas wszystkich, wyluzuj trochę.",shape=box,color=blue];
		746 -> 747;
	749 [label="Narośla. Częściowo organiczne, częściowo mechaniczne, delirium tremens jakiegoś biednego drania. Światła, jakie ludzie widzą tylko po przedawkowaniu oparów rozpuszczalnika. Było obrzydliwe i nie mogłam oderwać od tego oczu.",shape=box,color=blue];
		749 -> 750;
	747 [label="Nawet Artur czasem wyciąga się na fotelu i cieszy zimnym piwem.",shape=box,color=blue];
		747 -> 748;
	750 [label="Trafiłam, tak myślę.",shape=box,color=blue];
		750 -> 751;
		750 -> 752;
	748 [label="Chat ends.",color=orange];
	751 [label="O nie...",shape=box,color=red];
		751 -> 754;
	752 [label="Powiedz mi, że tam nie weszłaś.",shape=box,color=red];
		752 -> 753;
	754 [label="Zrobiłam kilkanaście ziarnistych zdjęć moim starym Kinematiciem 2300A i wysłałam je do Artura.",shape=box,color=blue];
		754 -> 755;
	753 [label="Oczywiście, że to zrobiłam.",shape=box,color=blue];
		753 -> 754;
	755 [label="I dodałam \"chyba znalazłam źródło Techrotu\".",shape=box,color=blue];
		755 -> 756;
	756 [label="Następnego dnia przygotowałam artykuł. \"Techrot pod ulicami Höllvanii\".",shape=box,color=blue];
		756 -> 757;
		756 -> 758;
	757 [label="To ty to nazwałaś.",shape=box,color=red];
		757 -> 759;
	758 [label="Więc stąd ta nazwa.",shape=box,color=red];
		758 -> 759;
	759 [label="Ta-da! To moja zasługa.",shape=box,color=blue];
		759 -> 760;
	760 [label="To właśnie najgorsza część.",shape=box,color=blue];
		760 -> 761;
	761 [label="Nikt już tego nie nazywa \"Syndromem Testudo\". Nikt nie nazywa tego Technocytem. Dla każdego jest to po prostu Techrot.",shape=box,color=blue];
		761 -> 762;
	762 [label="Nadałam imię czemuś, co pożarło to miasto i pożera mnie od środka.",shape=box,color=blue];
		762 -> 763;
	763 [label="Update boolean EleanorHollTold",color=orange];
		763 -> 764;
		763 -> 765;
	764 [label="Głupie gierki i głupie nagrody, co nie?",shape=box,color=red];
		764 -> 766;
	765 [label="Co jest nie tak z tą nazwą? Pasuje.",shape=box,color=red];
		765 -> 778;
	766 [label="Przepraszam, przez chwilę myślałam, że zrozumiesz. Może nawet okażesz współczucie.",shape=box,color=blue];
		766 -> 767;
	778 [label="+20 Chemistry",color=orange];
		778 -> 773;
	767 [label="Tak, masz rację. To wszystko JEST głupią gierką, prawda",shape=box,color=blue];
		767 -> 768;
	773 [label="Nikt nie wspomni nawet mojej pracy nad ministrem Jeremym Conistonem i jego przekrętem z paczkami dla głodujących albo skandalem Nawozów Lazlo, ani nic podobnego. Nie zrobiło to żadnej różnicy.",shape=box,color=blue];
		773 -> 774;
	768 [label="Jesteśmy po prostu bandą klaunów uwięzionych na karuzeli, która się nie zatrzymuje",shape=box,color=blue];
		768 -> 769;
	774 [label="A teraz wymyśliłam określenie, z którego korzystają wszyscy i nikt nie wie, że to moje dzieło.",shape=box,color=blue];
		774 -> 775;
	769 [label="Zbliżcie się zbliżcie się, spójrzcie na niepowtarzalną gorgonę. Proszę pani, niech pilnuje pani dziecka, nie była ona dzisiaj karmiona",shape=box,color=blue];
		769 -> 771;
	775 [label="\"Techrot\"",shape=box,color=blue];
		775 -> 776;
	771 [label="+10 Chemistry",color=orange];
		771 -> 770;
	776 [label="Mogą mi to wyryć na nagrobku.",shape=box,color=blue];
		776 -> 777;
	770 [label="Pogadamy innym razem. Muszę się napić.",shape=box,color=blue];
		770 -> 772;
	777 [label="Jeśli kiedyś się go doczekam.",shape=box,color=blue];
		777 -> 779;
	772 [label="Chat ends.",color=orange];
	779 [label="Chat ends.",color=orange];
}