digraph {
	2386 [label="EleanorRank5Convo4 begins.",color=orange];
		2386 -> 2387;
	2387 [label="Check boolean EleanorDating",color=orange];
		2387 -> 2388 [label=true,color=green];
		2387 -> 2389 [label=false,color=brown];
	2388 [label="Kochany? Jeśli tam jesteś, potrzebuję twojej uwagi.",shape=box,color=blue];
		2388 -> 2390;
	2389 [label="Jeśli tam jesteś, przydałoby mi się wsparcie.",shape=box,color=blue];
		2389 -> 2390;
	2390 [label="Check boolean EleanorArthurNightmare",color=orange];
		2390 -> 2391 [label=true,color=green];
		2390 -> 2392 [label=false,color=brown];
	2391 [label="Znowu śnił mi się ten koszmar z Arturem. Ten, w którym mnie zabija.",shape=box,color=blue];
		2391 -> 2394;
		2391 -> 2395;
	2392 [label="Miewam koszmar, w którym Artur musi mnie zabić. A potem wbija ostrze między żebra, kiedy ja krzyczałam \"Eleanor NADAL TU JEST ty tępy draniu!\" ale on mnie już nie słyszy.",shape=box,color=blue];
		2392 -> 2393;
	2394 [label="Już jestem. Nie martw się.",shape=box,color=red];
		2394 -> 2397;
	2395 [label="[Zignoruj]",shape=box,color=red];
		2395 -> 2396;
	2393 [label="Update boolean EleanorArthurNightmare",color=orange];
		2393 -> 2394;
		2393 -> 2395;
	2397 [label="Artur cię nie zabije, Eleanor. Jesteś jego siostrą, nie zapomni tego.",shape=box,color=red];
		2397 -> 2398;
	2396 [label="Chat ends.",color=orange];
	2398 [label="Właśnie o to chodzi. \"Nie jesteś już moją siostrą\". To mówi do mnie we śnie. A potem dźga mnie serce swoim zabawkowym mieczem.",shape=box,color=blue];
		2398 -> 2399;
	2399 [label="W tym śnie jesteśmy małymi dziećmi, jakby nie był wystarczająco pokręcony.",shape=box,color=blue];
		2399 -> 2400;
		2399 -> 2401;
	2400 [label="To nie jest prawdziwe. Nie wierzę, że Artur mógłby cię zranić, nieważne jak daleko zaszedłby Techrot.",shape=box,color=red];
		2400 -> 2402;
	2401 [label="... chora sprawa.",shape=box,color=red];
		2401 -> 2403;
	2402 [label="Nawet jeśli miałby to być coup de grâce? Nawet gdybym cierpiała?",shape=box,color=blue];
		2402 -> 2408;
	2403 [label="Tak, to najgorsza część.",shape=box,color=blue];
		2403 -> 2404;
	2408 [label="Jest zupełnie jak ojciec. Jest oddany robieniu tego, co konieczne, nie temu, co łatwe.",shape=box,color=blue];
		2408 -> 2409;
		2408 -> 2410;
	2404 [label="To wydaje się tak rzeczywiste. Pamiętam to, jakby rzeczywiście się stało.",shape=box,color=blue];
		2404 -> 2405;
		2404 -> 2406;
	2409 [label="Cokolwiek byś myślała o swojej rodzinie, nie jest gorsza od niektórych, które poznałem ja.",shape=box,color=red];
		2409 -> 2411;
	2410 [label="Poczekaj. Co ma z tym wspólnego twój ojciec?",shape=box,color=red];
		2410 -> 2412;
	2405 [label="Jestem pewien, że Artur by tego nie zrobił.",shape=box,color=red];
		2405 -> 2408;
	2406 [label="Może powinnaś porozmawiać o tym z Arturem?",shape=box,color=red];
		2406 -> 2407;
	2411 [label="Jestem tego pewna. Przyszłość jest dosyć pomysłowa w swoim okrucieństwie.",shape=box,color=blue];
		2411 -> 2413;
	2412 [label="Wszystko.",shape=box,color=blue];
		2412 -> 2414;
		2412 -> 2415;
	2407 [label="Nie mogę. Jest zupełnie jak ojciec. Jest oddany robieniu tego, co konieczne, nie temu, co łatwe.",shape=box,color=blue];
		2407 -> 2409;
		2407 -> 2410;
	2413 [label="Ale przejmuje się przeszłością.",shape=box,color=blue];
		2413 -> 2416;
	2414 [label="Musisz to trochę wyjaśnić, jeśli mam to zrozumieć.",shape=box,color=red];
		2414 -> 2416;
	2415 [label="Eleanor, nie unikaj odpowiedzi.",shape=box,color=red];
		2415 -> 2417;
	2416 [label="To jeden z wielu tematów, o których nie rozmawiamy.",shape=box,color=blue];
		2416 -> 2420;
	2417 [label="Nie unikam.",shape=box,color=blue];
		2417 -> 2418;
	2420 [label="Nie rozmawiamy o tym, co stało się w Cavonie, nie rozmawiamy o Krzysztofie, NIGDY nie rozmawiamy o babci Callie.",shape=box,color=blue];
		2420 -> 2421;
		2420 -> 2422;
	2418 [label="Naprawdę staram się to wytłumaczyć najlepiej jak mogę.",shape=box,color=blue];
		2418 -> 2419;
	2421 [label="Więc może nie powinnaś.",shape=box,color=red];
		2421 -> 2423;
	2422 [label="Więc może powinnaś.",shape=box,color=red];
		2422 -> 2425;
	2419 [label="Mój ojciec świecił przykładem, jak powinniśmy rozwiązywać spory między sobą. Albo raczej jak nie powinniśmy tego robić.",shape=box,color=blue];
		2419 -> 2420;
	2423 [label="A może nie powinnam.",shape=box,color=blue];
		2423 -> 2424;
	2425 [label="Może powinnam.",shape=box,color=blue];
		2425 -> 2426;
	2424 [label="Chat ends.",color=orange];
	2426 [label="Może to wreszcie czas.",shape=box,color=blue];
		2426 -> 2427;
	2427 [label="Chcesz usłyszeć całą historię, czy tylko najważniejsze wątki?",shape=box,color=blue];
		2427 -> 2428;
		2427 -> 2429;
	2428 [label="Nigdzie się nie wybieram, dajesz całość.",shape=box,color=red];
		2428 -> 2432;
	2429 [label="Mogę prosić o streszczenie?",shape=box,color=red];
		2429 -> 2430;
	2432 [label="Babcia Callie była naszą babcią ze strony ojca. Callista Penrose Nightingale.",shape=box,color=blue];
		2432 -> 2433;
	2430 [label="Babcia Callie była śmiertelnie chora. Obłąkana. Nasz ojciec wolał udusić ją poduszką, niż dać jej cierpieć. Mam nadzieję, że wystarczająco zwięźle.",shape=box,color=blue];
		2430 -> 2431;
	2433 [label="Miała zespól Pelhama. W twoich czasach pewnie mieliście już na to lekarstwo (powiedziała, cierpiąc w środku). Powoli niszczy umysł. Zamiast szybkiej śmierci, możesz patrzeć jak kochana osoba zanika, kawałek po kawałku, zanikając jak fotografia na słońcu albo skopiowana zbyt wiele razy kaseta wideo.",shape=box,color=blue];
		2433 -> 2434;
		2433 -> 2435;
	2431 [label="Chat ends.",color=orange];
	2434 [label="Jak coś, co dotknęło Sudę, zanim zdecydowała się zostać Cefalonem. Rozumiem.",shape=box,color=red];
		2434 -> 2436;
	2435 [label="Nie... nie znaleźliśmy na to lekarstwa...",shape=box,color=red];
		2435 -> 2436;
	2436 [label="Kiedy z nami zamieszkała, byliśmy podekscytowani z Arturem. Dla nas była to przemiła starsza kobieta, która pachniała fiołkami i opowiadała nam historię różnymi głosami. Na urodziny dawała nam prawdziwe pieniądze. Myśleliśmy, że każdy dzień będzie jak urodziny.",shape=box,color=blue];
		2436 -> 2437;
	2437 [label="Potem podupadła na zdrowiu. Zaczęło się od zapominalstwa. Potem zaczęła mylić nas z innymi ludźmi. Mnie nazywała Albertyną, a Artura Karolem. Domagała się, żebyśmy powiedzieli, gdzie uciekł Kubuś. Nigdy nie dowiedzieliśmy się, czy Kubuś był psem, kotem, czy jej chłopakiem.",shape=box,color=blue];
		2437 -> 2438;
	2438 [label="Potem zaczęła rozmawiać z ludźmi, których nie było, włóczyć się po mieszkaniu po zmroku.",shape=box,color=blue];
		2438 -> 2440;
		2438 -> 2441;
	2440 [label="To musiało być dla was przerażające.",shape=box,color=red];
		2440 -> 2439;
	2441 [label="Och, na Pustkę.",shape=box,color=red];
		2441 -> 2439;
	2439 [label="Pamiętam, że poszłam w środku nocy do toalety, a ona zataczała się w moją stronę przez ciemny korytarz, jęcząc, jej twarz wykrzywiona w grymasie i z włosami jak peruka szalonego klauna. Nie mogłam przestać krzyczeć.",shape=box,color=blue];
		2439 -> 2442;
	2442 [label="Kiedy było z nią bardzo źle, leżałaby w łóżku i krzyczała. Wychodziliśmy do szkoły o poranku, a kiedy skręcaliśmy w naszą alejkę, moje serce stawało, bo nadal mogłam ją usłyszeć dziesięć domów dalej, osiem godzin później.",shape=box,color=blue];
		2442 -> 2443;
	2443 [label="Tata mówił o uduszeniu ją poduszką. Myśleliśmy, że żartuje, bo to przecież oczywiste, to jego matka.",shape=box,color=blue];
		2443 -> 2444;
		2443 -> 2445;
	2444 [label="Teraz wiele rzeczy nabrało sensu.",shape=box,color=red];
		2444 -> 2446;
	2445 [label="....Och.",shape=box,color=red];
		2445 -> 2446;
	2446 [label="Pewnej nocy krzyczała i krzyczała, aż krzyki nagle ustały. Wstałam i poszłam do pokoju Artura. Nie spał, oczywiście. Siedzieliśmy razem i nasłuchiwaliśmy, a potem usłyszeliśmy, jak zamykają się drzwi do jej pokoju.",shape=box,color=blue];
		2446 -> 2447;
	2447 [label="\"Umarła we śnie\", powiedział tata o poranku.",shape=box,color=blue];
		2447 -> 2448;
		2447 -> 2449;
	2448 [label="Obawiasz się, że Artur postąpi tak samo?",shape=box,color=red];
		2448 -> 2450;
	2449 [label="Artur to nie jest twój ojciec. Nie zrobiłby tego.",shape=box,color=red];
		2449 -> 2451;
	2450 [label="Gdyby naprawdę był przekonany, że tak będzie najlepiej?",shape=box,color=blue];
		2450 -> 2452;
	2451 [label="Nie możesz tego wiedzieć. A gdyby Artur był przekonany, że to najlepsze wyjście?",shape=box,color=blue];
		2451 -> 2452;
	2452 [label="Nie wiem. Może. Teraz kiedy ci to powiedziałam, wydaje się to mniej możliwe.",shape=box,color=blue];
		2452 -> 2453;
	2453 [label="+20 Chemistry",color=orange];
		2453 -> 2454;
	2454 [label="Jesteś wspaniały. Dziękuję za wysłuchanie mnie, musiałam to z siebie wyrzucić.",shape=box,color=blue];
		2454 -> 2455;
	2455 [label="Update boolean EleanorDreams",color=orange];
		2455 -> 2456;
	2456 [label="Chat ends.",color=orange];
}