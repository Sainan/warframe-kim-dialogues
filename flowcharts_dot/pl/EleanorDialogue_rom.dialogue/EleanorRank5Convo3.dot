	2329 [label="Nie. Nie jesteśmy w tym sami, prawda? I już nigdy nie musimy być.",shape=box,color=blue];
		2329 -> 2331;
	2331 [label="Mogłabym wymyślić tuzin powodów, przez które nie powinniśmy być razem, a ty miałbyś odpowiedź na każde z nich. A co, jeśli cię zakażę? Jesteś odporny. Co, jeśli spróbuję cię zjeść? Jesteś praktycznie nieśmiertelny. Co, jeśli zajrzę do twojej głowy? Pewnie znowu mnie wykopiesz.",shape=box,color=blue];
		2331 -> 2332;
	2332 [label="Ty wspaniała, niemożliwa istoto. Po prostu zdobyłeś moje serce.",shape=box,color=blue];
		2332 -> 2333;
	2333 [label="Och, jeszcze jedno. Nie wiem, czy zauważyłeś, ale mam ten wstydliwy osobisty problem, który musimy poruszyć.",shape=box,color=blue];
		2333 -> 2334;
