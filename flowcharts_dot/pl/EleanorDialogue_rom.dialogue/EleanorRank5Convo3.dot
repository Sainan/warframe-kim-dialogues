	2314 [label="Chat ends.",color=orange];
	2315 [label="Pójdę z tobą na układ. Odwiedź Lettie, zapytaj ją o szybką ocenę psychologiczną, dowiedz się, co tu rzeczywiście się dzieje, a potem możemy zapomnieć, że ta rozmowa miała miejsce.",shape=box,color=blue];
