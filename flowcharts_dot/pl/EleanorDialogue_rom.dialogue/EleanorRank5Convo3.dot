		2307 -> 2313;
	2303 [label="I teraz zastanawiam się, co zrobiłam, żeby cię oszukać. Albo cię zmanipulować. Może wrzuciłam ten pomysł do twojej głowy.",shape=box,color=blue];
		2303 -> 2308;
