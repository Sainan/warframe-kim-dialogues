	2311 [label="Myślałem, że było to wystarczająco jasne.",shape=box,color=red];
		2311 -> 2315;
	2316 [label="Nie lubię badań psychicznych. Nie ma nic złego w tym, że cię lubię. Jeśli czujesz się inaczej, proszę, powiedz mi.",shape=box,color=red];
		2316 -> 2321;
	2317 [label="Jeśli nie podzielasz tego uczucia, po prostu mi to powiedz.",shape=box,color=red];
