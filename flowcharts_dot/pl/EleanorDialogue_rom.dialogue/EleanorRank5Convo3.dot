	2375 [label="Hmm. Szczerze myślę o tym, żeby rzucić się na ciebie w biurze Artura i \"przypadkiem\" włączyć nagłośnienie, żeby Lettie mogła usłyszeć każde westchnięcie.",shape=box,color=blue];
