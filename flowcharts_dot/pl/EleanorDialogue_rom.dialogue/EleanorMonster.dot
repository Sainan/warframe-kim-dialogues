digraph {
	1458 [label="EleanorMonster begins.",color=orange];
		1458 -> 1459;
	1459 [label="Włóczęgo. To co wczoraj powiedziałeś, że dałbyś potworowi żyć. Czy mówiłeś to poważnie? Muszę wiedzieć.",shape=box,color=blue];
		1459 -> 1460;
		1459 -> 1461;
		1459 -> 1462;
	1460 [label="Oczywiście, że tak.",shape=box,color=red];
		1460 -> 1464;
	1461 [label="Szczerze? Też o tym myślałem. Zdecydowałem, że nie. Musiałbym cię powstrzymać, gdybyś stała się potworem.",shape=box,color=red];
		1461 -> 1465;
	1462 [label="[Ignoruj]",shape=box,color=red];
		1462 -> 1463;
	1464 [label="Nie, żebym nie była niezmiernie wdzięczna i szczerze mówiąc lekko zszokowana, ale... dlaczego? DLACZEGO dałbyś mi żyć? Wszyscy inni byliby gotowi mnie odstrzelić?",shape=box,color=blue];
		1464 -> 1466;
		1464 -> 1467;
	1465 [label="Dziękuję. Pod wieloma względami jesteś dla mnie zagadką, ale teraz wiem, że byłbyś gotów zapakować mi kulkę w łeb i taka wiedza jest ważna w tych warunkach.",shape=box,color=blue];
		1465 -> 1468;
	1463 [label="Chat ends.",color=orange];
	1466 [label="Granica między \"bohaterem\" i \"potworem\" jest cieńsza, niż większość ludzi jest gotowa przyznać. Walczyłem przeciwko Grineer i Corpus, walczyłem też u ich boku.",shape=box,color=red];
		1466 -> 1473;
	1467 [label="Bo jesteś jedną z najbardziej inteligentnych, cudownie sarkastycznych osób, jakie kiedykolwiek poznałem i nie wierzę, że Techrot mógłby odebrać ci te cechy.",shape=box,color=red];
		1467 -> 1472;
	1468 [label="Aaaaż poczułam lekki dreszcz niepokoju wśród komórek Techrotu.",shape=box,color=blue];
		1468 -> 1469;
	1473 [label="Nie wierzę w \"dobro\" i \"zło\", tylko ludzi. Dlaczego miałabyś mieć mniejsze prawo do istnienia niż ja? Może nie mam Techrotowego języka, ale też jestem wybrykiem natury.",shape=box,color=red];
		1473 -> 1474;
	1472 [label="Jakież to... pięknie naiwne. I niesamowicie słodke, w tragiczny sposób.",shape=box,color=blue];
		1472 -> 1475;
	1469 [label="Myślę, że teraz będzie odrobinę grzeczniejsza. Nic tak nie sieje strachu przed Sol w pasożycie, jak groźba zabicia jego żywiciela, co nie?",shape=box,color=blue];
		1469 -> 1470;
	1474 [label="Ale jesteś tutaj, walczysz ze Scaldrą i Techrotem, szukasz sposobu na powstrzymanie Obojętności. Z pewnością gdzieś wyznaczyłeś granicę.",shape=box,color=blue];
		1474 -> 1476;
		1474 -> 1477;
	1475 [label="To, że wierzysz, że wyszłabym po drugiej stronie jako królowa roju, zachowując swoją osobowość, jakiś dziwny głos pośród plagi, z którym mógłbyś się zaprzyjaźnić i nawet pokochać.",shape=box,color=blue];
		1475 -> 1479;
	1470 [label="Update boolean EleanorNoDate",color=orange];
		1470 -> 1471;
	1476 [label="Obojętność została wyzwolona przez Entratiego. Człowieka. Możemy winić tylko ludzką pychę.",shape=box,color=red];
		1476 -> 1483;
	1477 [label="Chronienie ludzi przed śmiercią to nie to samo, co wiara, że coś powinno zostać wybite albo nie ma prawa bytu.",shape=box,color=red];
		1477 -> 1478;
	1479 [label="Chciałam ci przypomnieć, że świat nie działa jak w baśniach, ale... Przypomniałam sobie, że właśnie z takiego świata pochodzisz.",shape=box,color=blue];
		1479 -> 1480;
	1471 [label="Chat ends.",color=orange];
	1483 [label="Ale Techrot to nie Obojętność. Co z tym faktem? Co z bardziej biologicznym, przyziemnym zagrożeniem?",shape=box,color=blue];
		1483 -> 1485;
		1483 -> 1486;
	1478 [label="Strzeżenie stada owiec przed wilkami to nie to samo, co wymordowanie wszystkich wilków za bycie złymi.",shape=box,color=red];
		1478 -> 1484;
	1480 [label="Więc nie powinno mnie to dziwić.",shape=box,color=blue];
		1480 -> 1481;
	1485 [label="Nie wiemy skąd wziął się Techrot. Mógł zostać stworzony przez ludzi, mógł powstać z zupełnie inny sposób.",shape=box,color=red];
		1485 -> 1488;
	1486 [label="Prosta prawda jest taka, że nie chcesz, żebym cię zabił. Więc bym tego nie zrobił, puściłbym cię wolno.",shape=box,color=red];
		1486 -> 1489;
	1484 [label="A co, jeśli nic nie zostałoby z Eleanor? Co jeśli ujrzałbyś tylko sycząca, warczącą, plującą bestię?",shape=box,color=blue];
		1484 -> 1487;
		1484 -> 1486;
	1481 [label="W każdym razie jestem wdzięczna, że byś mnie nie zabił.",shape=box,color=blue];
		1481 -> 1482;
	1488 [label="A jeśli Techrot okaże się kolejnym uwolnionym przez człowieka wybrykiem, jak Pan ze Ściany? Co wtedy? Upolowałbyś mnie i zabił?",shape=box,color=blue];
		1488 -> 1491;
		1488 -> 1492;
	1489 [label="Choć jestem wdzięczna, że jesteś gotów spełnić życzenia potwora, chyba miałam nadzieję usłyszeć coś bardziej... rozsądnego.",shape=box,color=blue];
		1489 -> 1498;
	1487 [label="Skąd mógłbym wiedzieć, że z Eleanor nic nie zostało? Mówisz o tym, jak myśli Techrot. Jak mówi do ciebie. Przejawia inteligencję.",shape=box,color=red];
		1487 -> 1490;
	1482 [label="Chat ends.",color=orange];
	1491 [label="Nie mógłbym tego zrobić.",shape=box,color=red];
		1491 -> 1500;
	1492 [label="Tak. Jeśli Techrot naprawdę jest nienaturalny? Wtedy... musi zniknąć.",shape=box,color=red];
		1492 -> 1501;
	1498 [label="+5 Chemistry",color=orange];
		1498 -> 1493;
	1490 [label="Zdają się przejawiać umysł zbiorowy. Może Eleanor nadal by tam była, nie w jednym miejscu a w miliardzie? Kim jestem, żeby stwierdzić, że to \"złe\"?",shape=box,color=red];
		1490 -> 1494;
	1500 [label="Przeczysz sam sobie. Jesteś gotów powstrzymać jednego potwora stworzonego przez człowieka, więc dlaczego nie dwa?",shape=box,color=blue];
		1500 -> 1506;
		1500 -> 1507;
	1501 [label="Dziękuję. Pod wieloma względami jesteś dla mnie zagadką, ale teraz wiem, że byłbyś gotów zapakować mi kulkę w łeb i taka wiedza jest ważna w tych warunkach.",shape=box,color=blue];
		1501 -> 1502;
	1493 [label="W każdym razie, jestem wdzięczna, że byś mnie nie zabił.",shape=box,color=blue];
		1493 -> 1499;
	1494 [label="I kiedy już myślałam, że nie mogę cię bardziej kochać, znowu tu siedzę i płaczę ze szczęścia",shape=box,color=blue];
		1494 -> 1496;
	1506 [label="Bo się w tobie zakochałem. [Wyznaj uczucia]",shape=box,color=red];
		1506 -> 1508;
	1507 [label="Bo za wiele dla mnie znaczysz jako przyjaciel.",shape=box,color=red];
		1507 -> 1509;
	1502 [label="Aaaaż poczułam lekki dreszcz niepokoju wśród komórek Techrotu.",shape=box,color=blue];
		1502 -> 1503;
	1499 [label="Chat ends.",color=orange];
	1496 [label="+20 Chemistry",color=orange];
		1496 -> 1495;
	1508 [label="Pytanie mnie, czy byłbym gotów cię zabić jest *okrutne*, Eleanor. Kiedy myśl o tym, że umarłaś, albo cierpisz, po prostu --",shape=box,color=red];
		1508 -> 1510;
	1509 [label="Pytanie mnie, czy byłbym gotów cię zabić jest *okrutne*, Eleanor. Jesteś moją przyjaciółką. Jesteś dla mnie jak rodzina.",shape=box,color=red];
		1509 -> 1511;
	1503 [label="Myślę, że teraz będzie odrobinę grzeczniejsza. Nic tak nie sieje strachu przed Sol w pasożycie, jak groźba zabicia jego żywiciela, co nie?",shape=box,color=blue];
		1503 -> 1504;
	1495 [label="Muszę już iść, ale dziękuje, dziękuję, DZIĘKUJĘ",shape=box,color=blue];
		1495 -> 1497;
	1510 [label="Ale prawda jest taka, że nie byłbym w stanie. Może to przez wiarę, że nadal byś gdzieś tam istniała? W jakiś sposób? Tyle by mi wystarczyło.",shape=box,color=red];
		1510 -> 1512;
	1511 [label="Ale prawda jest taka, że nie byłbym w stanie. Może to przez wiarę, że nadal byś gdzieś tam istniała? W jakiś sposób? Tyle by mi wystarczyło.",shape=box,color=red];
		1511 -> 1513;
	1504 [label="Update boolean EleanorNoDate",color=orange];
		1504 -> 1505;
	1497 [label="Chat ends.",color=orange];
	1512 [label="Przepraszam, nie dam rady. Muszę iść.",shape=box,color=red];
		1512 -> 1514;
	1513 [label="Przepraszam, nie dam rady. Muszę iść.",shape=box,color=red];
		1513 -> 1518;
	1505 [label="Chat ends.",color=orange];
	1514 [label="Update boolean EleanorConfession",color=orange];
		1514 -> 1516;
	1518 [label="+20 Chemistry",color=orange];
		1518 -> 1520;
	1516 [label="+20 Chemistry",color=orange];
		1516 -> 1515;
	1520 [label="Och Eleanor, teraz przesadziłaś...",shape=box,color=blue];
		1520 -> 1519;
	1515 [label="Och... och, co ja narobiłam...",shape=box,color=blue];
		1515 -> 1517;
	1519 [label="Chat ends.",color=orange];
	1517 [label="Chat ends.",color=orange];
}