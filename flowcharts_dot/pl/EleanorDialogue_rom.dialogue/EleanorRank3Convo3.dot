digraph {
	1032 [label="EleanorRank3Convo3 begins.",color=orange];
		1032 -> 1033;
	1033 [label="Hej Eleanor. Jak się masz?",shape=box,color=red];
		1033 -> 1034;
	1034 [label="Świetnie. Właśnie przycinałam język.",shape=box,color=blue];
		1034 -> 1035;
		1034 -> 1036;
	1035 [label="Przycinałaś?",shape=box,color=red];
		1035 -> 1037;
	1036 [label="Chwila. *Co?*",shape=box,color=red];
		1036 -> 1038;
	1037 [label="Przycinałam. Wciąż odrastają na nim te małe obrzydliwe wyrostki. To chyba były kiedyś kubki smakowe. Jeśli ich nie wytnę, robią się bardzo długie i zaczynają się wić. Jak ukwiały.",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="Zupełnie jak paznokcie.",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="Przepraszam. Powinnam była cię ostrzec.",shape=box,color=blue];
		1039 -> 1041;
	1040 [label="Trochę więcej z tym bałaganu. Ale to nadal nic więcej jak odcinanie niechcianej narośli.",shape=box,color=blue];
		1040 -> 1041;
	1041 [label="Wszyscy wiedzą, żeby trzymać się na dystans stu metrów, kiedy Eleanor wchodzi do toalety z nożem i butelką spirytusu.",shape=box,color=blue];
		1041 -> 1042;
	1042 [label="Wystarczy poczekać i w końcu wyjdę z zakrwawioną brodą i torbą pełną mięsa w ręku. Próbowałam zrobić z niego hamburgery, ale nie było chętnych do spróbowania.",shape=box,color=blue];
		1042 -> 1043;
	1043 [label="Przepraszam, miałeś ochotę na półgodzinny erotyczny czat, czy tylko pięciominutowy?",shape=box,color=blue];
		1043 -> 1044;
		1043 -> 1045;
	1044 [label="Przestań próbować mnie obrzydzać.",shape=box,color=red];
		1044 -> 1046;
	1045 [label="A skoro już mowa o języku...",shape=box,color=red];
		1045 -> 1048;
	1046 [label="Ej, to ja muszę użerać się z węgorzem po tchawicę. Wybacz mi, że próbuję z tego żartować.",shape=box,color=blue];
		1046 -> 1047;
	1048 [label="Mów dalej...",shape=box,color=blue];
		1048 -> 1049;
	1047 [label="Chat ends.",color=orange];
	1049 [label="... jak dużą kontrolę nad tym masz?",shape=box,color=red];
		1049 -> 1050;
	1050 [label="No tak. Zaczekaj chwilę.",shape=box,color=blue];
		1050 -> 1051;
	1051 [label="akoś yle",shape=box,color=blue];
		1051 -> 1052;
	1052 [label="ak m idzie",shape=box,color=blue];
		1052 -> 1053;
		1052 -> 1054;
	1053 [label="Proszę, powiedz mi, że nie.",shape=box,color=red];
		1053 -> 1056;
	1054 [label="O co to to nie. Odpadam. [Koniec]",shape=box,color=red];
		1054 -> 1055;
	1056 [label="och ależ tak heheheh",shape=box,color=blue];
		1056 -> 1058;
		1056 -> 1057;
	1055 [label="Chat ends.",color=orange];
	1058 [label="Piszesz językiem?!",shape=box,color=red];
		1058 -> 1060;
	1057 [label="Przepraszam, jeśli to zbyt osobiste pytanie... ale co *jeszcze* możesz nim zrobić...?",shape=box,color=red];
		1057 -> 1059;
	1060 [label="mhm",shape=box,color=blue];
		1060 -> 1066;
	1059 [label="noo",shape=box,color=blue];
		1059 -> 1061;
	1066 [label="Ale nie na długo, bo zaślinię całą klawiaturę.",shape=box,color=blue];
		1066 -> 1067;
	1061 [label="omyśl o yś sam zrobił",shape=box,color=blue];
		1061 -> 1062;
	1067 [label="W każdym razie, teraz wiesz.",shape=box,color=blue];
		1067 -> 1068;
		1067 -> 1069;
	1062 [label="ja też",shape=box,color=blue];
		1062 -> 1063;
	1068 [label="Straciłaś kiedyś nad nim kontrolę?",shape=box,color=red];
		1068 -> 1070;
	1069 [label="Czy przygryzłaś kiedyś przypadkiem język?",shape=box,color=red];
		1069 -> 1071;
	1063 [label="to baaardzo przyjemne hehe",shape=box,color=blue];
		1063 -> 1064;
	1070 [label="Cholerstwo zdaje się mieć własne zachcianki. Kiedy się na tym skupię, jest pod moją kontrolą. Ale w innym wypadku, reaguje na moje emocje.",shape=box,color=blue];
		1070 -> 1072;
	1071 [label="Cały czas, ale szybko się goi.",shape=box,color=blue];
		1071 -> 1074;
	1064 [label="Update boolean EleanorFlirt",color=orange];
		1064 -> 1065;
		1064 -> 1069;
	1072 [label="Najgorszą z możliwych opcji jest to, że to nie przeze MNIE, a jakąś pozostającą więź z Techrotem. Wolałabym o tym nie myśleć.",shape=box,color=blue];
		1072 -> 1073;
	1074 [label="Ale ten jeden raz, kiedy go odgryzłam... to po prostu odrósł. Nie pozbędę się tego.",shape=box,color=blue];
		1074 -> 1075;
	1065 [label="Ja... heh. No cóż. Więc następne pytanie... czy kiedykolwiek tracisz nad nim kontrolę?",shape=box,color=red];
		1065 -> 1070;
	1073 [label="Nienawidzę, kiedy włazi mi między zęby. Ale ten jeden raz, kiedy go odgryzłam... to po prostu odrósł. Nie pozbędę się tego.",shape=box,color=blue];
		1073 -> 1075;
	1075 [label="Przynajmniej już nie rośnie. Teraz tylko wyrastają mu witki.",shape=box,color=blue];
		1075 -> 1076;
		1075 -> 1077;
	1076 [label="Chciałabyś wrócić do stanu sprzed Entratiego?",shape=box,color=red];
		1076 -> 1078;
	1077 [label="A jak się z tym czujesz? Tak naprawdę z tym czujesz?",shape=box,color=red];
		1077 -> 1079;
	1078 [label="Tak? Bez wahania. Ale nie mogę, więc po co się nad tym zastanawiać?",shape=box,color=blue];
		1078 -> 1080;
	1079 [label="Ne wybrałabym tego, gdybym mogła, ale nie nienawidzę tego. Czuję, jakby był tam od zawsze.",shape=box,color=blue];
		1079 -> 1081;
	1080 [label="Wszystko dzieje się z jakiegoś powodu.",shape=box,color=red];
		1080 -> 1083;
	1081 [label="Tęsknie za dźwiękiem swojego głosu. Nienawidzę tego, że nie mogę już śpiewać.",shape=box,color=blue];
		1081 -> 1082;
	1083 [label="Tak. Po prostu czasem powodem jest stary drań robiący coś złego.",shape=box,color=blue];
		1083 -> 1084;
	1082 [label="Ale język? Możesz w to nie uwierzyć, ale to trochę pocieszające. Już nigdy nie będę bezbronna.",shape=box,color=blue];
		1082 -> 1099;
		1082 -> 1100;
	1084 [label="Więc jeśli próbujesz mi powiedzieć, że koniec końców wyjdzie na dobre, że to wszystko część większego planu, to myślisz tak tylko ty. Nie jestem przekonana.",shape=box,color=blue];
		1084 -> 1085;
	1099 [label="A więc… jaka zmiana spodobała ci się najbardziej?",shape=box,color=red];
		1099 -> 1101;
	1100 [label="Cieszę się, że przynajmniej JEDNO z was próbuje zachować optymizm...",shape=box,color=red];
		1100 -> 1102;
	1085 [label="Check boolean EleanorHeroVirus",color=orange];
		1085 -> 1086 [label=true,color=green];
		1085 -> 1087 [label=false,color=brown];
	1101 [label="Poczucie niezniszczalności.",shape=box,color=blue];
		1101 -> 1107;
	1102 [label="Tylko jedno? Spotkałeś w ogóle Amira?",shape=box,color=blue];
		1102 -> 1103;
	1086 [label="To wirus bohatera. Uważasz się za główną postać w historii każdego innego.",shape=box,color=blue];
		1086 -> 1087;
	1087 [label="Tutaj nie ma wielkiej opowieści, kolego. Wielki pisarz ponad nami nie dodaje dramatycznych zwrotów akcji do mojego życia.",shape=box,color=blue];
		1087 -> 1088;
	1107 [label="Mogę podzielić się historyjką?",shape=box,color=blue];
		1107 -> 1108;
	1103 [label="Ma swoje gorsze chwile, ale jest dla nas wszystkich inspiracją.",shape=box,color=blue];
		1103 -> 1104;
	1088 [label="Sama mogę zdecydować o znaczeniu głupot, jakie mi się przytrafiają. To ja jestem artystką, nie Sol, nie Lua, ani żadne gwiazdy pomiędzy.",shape=box,color=blue];
		1088 -> 1089;
	1108 [label="Proszę bardzo.",shape=box,color=red];
		1108 -> 1109;
	1104 [label="Wolę podejście Amira niż smucenie się z gębą jak obita dupa.",shape=box,color=blue];
		1104 -> 1105;
	1089 [label="Check boolean EleanorGalvanized",color=orange];
		1089 -> 1090 [label=true,color=green];
		1089 -> 1091 [label=false,color=brown];
		1089 -> 1092 [label=false,color=brown];
	1109 [label="Kiedy miałam osiemnaście lat, moja grupa świętowała zakończenie egzaminów. Wszyscy upchnęliśmy się do tego tyciego samochodu. Ja leżałam na kolanach trzech osób z tyłu.",shape=box,color=blue];
		1109 -> 1110;
	1105 [label="+10 Chemistry",color=orange];
		1105 -> 1106;
	1090 [label="Przypomniałeś mi o tym. Nie wiem, czy w ogóle pamiętasz. Użalałam się nad sobą, a ty mnie z tego wyciągnąłeś.",shape=box,color=blue];
		1090 -> 1091;
		1090 -> 1092;
	1091 [label="Cieszę się, że mogłem pomóc.",shape=box,color=red];
		1091 -> 1093;
	1092 [label="Nie próbujesz powiedzieć, że życie nie ma sensu?",shape=box,color=red];
		1092 -> 1095;
	1110 [label="Seb Cromley marudził w bagażniku. Krzysztof i Marek siedzieli z przodu. Wszyscy byliśmy schlani w trzy dupy.",shape=box,color=blue];
		1110 -> 1111;
	1106 [label="Chat ends.",color=orange];
	1093 [label="+10 Chemistry",color=orange];
		1093 -> 1094;
	1095 [label="Na bogów, nie. Po prostu mówię, że znaczenie tkwi w skale, a to rzeźbiarz musi do niego dotrzeć.",shape=box,color=blue];
		1095 -> 1096;
	1111 [label="Marek przejechał na czerwonym, a nadjeżdżający samochód wjechał nam w bok, stoczyliśmy się z ulicy i wylądowaliśmy w rowie. Wiem, co się stało tylko dlatego, bo policjant mi to opowiedział.",shape=box,color=blue];
		1111 -> 1112;
	1094 [label="Chat ends.",color=orange];
	1096 [label="Niektóre dni są ponure, okropne i puste, że nie chcę schodzić z kanapy. Ale kiedy wracam do siebie, wiem, że to poczucie nie było prawdziwe.",shape=box,color=blue];
		1096 -> 1097;
	1112 [label="Musieli mnie wycinać z samochodu. Nie mogłam przestać krzyczeć. To był ból, przed którym nie było drogi ucieczki. Kara za istnienie.",shape=box,color=blue];
		1112 -> 1113;
	1097 [label="Nikt nie trzyma kluczy do znaczenia, wiesz? To improwizacja między tobą i wszechświatem. On rzuca ci wyzwanie, a ty musisz się dostosować.",shape=box,color=blue];
		1097 -> 1098;
	1113 [label="Byłam bezbronna jak nowo narodzony królik. Zupełnie się rozleciałam. Leżałam tam i krzyczałam cały czas. Do tego czasu uważałam się za twardziela.",shape=box,color=blue];
		1113 -> 1114;
	1098 [label="Pomaga mi skupienie się na zmianach, z którymi się polubiłam.",shape=box,color=blue];
		1098 -> 1099;
		1098 -> 1100;
	1114 [label="Update boolean EleanorCrash",color=orange];
		1114 -> 1115;
	1115 [label="Wiem, o jakim bólu mówisz.",shape=box,color=red];
		1115 -> 1116;
	1116 [label="Dwa dni temu zostałam rozjechana przez transporter Scaldry.",shape=box,color=blue];
		1116 -> 1117;
	1117 [label="Przeszył mnie ten sam ból, ale tym razem mnie nie sparaliżował. Zamiast tego był jak paliwo, rozkręcał mnie, doprowadzał do szału.",shape=box,color=blue];
		1117 -> 1118;
	1118 [label="Wstałam, nastawiłam bark i gołymi rękami rozerwałam ten wóz na strzępy.",shape=box,color=blue];
		1118 -> 1119;
	1119 [label="To było bolesne, tak. Ale też odurzające.",shape=box,color=blue];
		1119 -> 1121;
	1121 [label="+20 Chemistry",color=orange];
		1121 -> 1120;
	1120 [label="Więc za tyle mogę podziękować Entratiemu, gdziekolwiek by nie był.",shape=box,color=blue];
