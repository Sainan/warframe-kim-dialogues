digraph {
	2175 [label="EleanorRank5Convo2 begins.",color=orange];
		2175 -> 2176;
	2176 [label="To tak. Bardziej spokojna i przygotowana już nie będę.",shape=box,color=blue];
		2176 -> 2177;
	2177 [label="Chcesz porozmawiać o Krzysztofie?",shape=box,color=blue];
		2177 -> 2178;
	2178 [label="Check boolean EleanorChristopher1",color=orange];
		2178 -> 2184 [label=true,color=green];
		2178 -> 2180 [label=true,color=green];
		2178 -> 2185 [label=true,color=green];
		2178 -> 2179 [label=false,color=brown];
		2178 -> 2185 [label=false,color=brown];
	2184 [label="Zamieniam się w sluch.",shape=box,color=red];
		2184 -> 2186;
	2180 [label="Dlaczego? To ktoś, kogo powinienem znać?",shape=box,color=red];
		2180 -> 2187;
	2185 [label="[Zignoruj]",shape=box,color=red];
		2185 -> 2181;
	2179 [label="Kim jest Krzysztof?",shape=box,color=red];
		2179 -> 2182;
	2186 [label="Dziękuję.",shape=box,color=blue];
		2186 -> 2188;
	2187 [label="Ponieważ to ktoś, kogo straciłam. Był mi bardzo drogi.",shape=box,color=blue];
		2187 -> 2188;
	2181 [label="Chat ends.",color=orange];
	2182 [label="Najlepszy przyjaciel Artura. Byliśmy zaręczeni. Chyba byłam w nim zakochana.",shape=box,color=blue];
		2182 -> 2183;
	2188 [label="Check boolean EleanorDating",color=orange];
		2188 -> 2189 [label=true,color=green];
		2188 -> 2190 [label=false,color=brown];
	2183 [label="Update boolean EleanorChristopher1",color=orange];
		2183 -> 2184;
		2183 -> 2180;
	2189 [label="Ponieważ zbliżyliśmy się do siebie (na wiele wspaniałych sposobów), chciałabym, żebyś naprawdę wiedział, w co się angażujesz.",shape=box,color=blue];
		2189 -> 2191;
	2190 [label="Popraw mnie, jeśli się mylę, ale miewam ostatnio wrażenie, że jesteśmy więcej niż członkami tej samej drużyny.",shape=box,color=blue];
		2190 -> 2193;
	2191 [label="Ja widziałam, co się dzieje w twojej głowie - ty nie.",shape=box,color=blue];
		2191 -> 2192;
	2193 [label="Check boolean EleanorConfession",color=orange];
		2193 -> 2194 [label=true,color=green];
		2193 -> 2195 [label=false,color=brown];
	2192 [label="Więc przygotuj się i wytrzymaj ze mną chwilę.",shape=box,color=blue];
		2192 -> 2197;
	2194 [label="Wyraźnie dałeś mi do zrozumienia, co czujesz i doceniam to.",shape=box,color=blue];
		2194 -> 2196;
	2195 [label="Na pewno jesteśmy przyjaciółmi. Może nawet czymś więcej. Ale nadal niepewnie krążymy wokół siebie, czekając, aż drugie wykona pierwszy ruch.",shape=box,color=blue];
		2195 -> 2196;
	2197 [label="Chcę ci powiedzieć o Krzysztofie, bo myślę, że zasługujesz wiedzieć.",shape=box,color=blue];
		2197 -> 2198;
		2197 -> 2199;
	2196 [label="Lubię cię, nawet bardzo. Ufam ci. Miałeś wiele okazji, żeby potraktować mnie jak wybryk natury, jak robi to Lettie, ale tego nie zrobiłeś. Nie myśl, że nie zauważyłam.",shape=box,color=blue];
		2196 -> 2197;
	2198 [label="Droga wolna.",shape=box,color=red];
		2198 -> 2202;
	2199 [label="Przepraszam, nie mam na to czasu. [Koniec]",shape=box,color=red];
		2199 -> 2200;
	2202 [label="Był od nas starszy o kilka lat. Nie pamiętam czasów, kiedy nie było go z nami. Nasi rodzice się przyjaźnili, więc co chwila się u nas pojawiał.",shape=box,color=blue];
		2202 -> 2203;
	2200 [label="Jest czas, żeby wycofać się z rozmowy z przyjacielem. Ale to nie był ten moment.",shape=box,color=blue];
		2200 -> 2201;
	2203 [label="Często bawił się z Arturem w żołnierzy w zaroślach za posiadłością. Krzysztof zawsze odgrywał rolę dowódcy, a Artur był oddanym porucznikiem. Kiedy tylko pozwalali mi się ze sobą bawić, musiałam być pielęgniarką. Oczywiście.",shape=box,color=blue];
		2203 -> 2204;
	2201 [label="Chat ends.",color=orange];
	2204 [label="Żałuję, że widok Artura rzucającego się na kolejny granat z szyszki, ginącego bohatersko, by uratować swojego dowódcę, nie sprawił, że tata pomyślał \"Hmm, ten chłopak trochę za bardzo się wczuł w armię, może powinienem mu powiedzieć, że zostanie rozstrzelanym to nie taka fajna zabawa\".",shape=box,color=blue];
		2204 -> 2205;
		2204 -> 2206;
		2204 -> 2207;
	2205 [label="Myślisz, że by posłuchał?",shape=box,color=red];
		2205 -> 2210;
	2206 [label="Myślę, że sprawy całkiem dobrze się potoczyły.",shape=box,color=red];
		2206 -> 2209;
	2207 [label="Ale gdyby Artur posłuchał, nigdy byśmy na siebie nie wpadli :)",shape=box,color=red];
		2207 -> 2208;
	2210 [label="Raczej nie. Uznałby to za test ze strony ojca.",shape=box,color=blue];
		2210 -> 2216;
	2209 [label="W pewien sposób tak.",shape=box,color=blue];
		2209 -> 2211;
	2208 [label="Tak, zejście się naszych ścieżek było rzadkim błogosławieństwem w moim życiu.",shape=box,color=blue];
		2208 -> 2212;
	2216 [label="W każdym razie. Mijały kolejne lata. Staliśmy się nastolatkami. Wszystko było bardzo niezręczne, śmierdzące i hormonalne. Były imprezy i egzaminy. Krzysztof poszedł na studia. Nasz pies umarł, przygarnęliśmy nowego. Klasyka kina. ",shape=box,color=blue];
		2216 -> 2217;
	2211 [label="Ale próbowałam opowiedzieć ci o żałobie.",shape=box,color=blue];
		2211 -> 2215;
	2212 [label="Ale pozwól mi życzyć, żeby nie wiązało się to z takim kosztem.",shape=box,color=blue];
		2212 -> 2213;
	2217 [label="Pewnego poranka weszłam do kuchni, a moim oczom ukazał się piękny mężczyzna w mundurze, a ja pomyślałam \"pfłał\" po raz drugi w swoim życiu.",shape=box,color=blue];
		2217 -> 2218;
		2217 -> 2219;
	2215 [label="To nie jest pora na doszukiwanie się pozytywów.",shape=box,color=blue];
		2215 -> 2216;
	2213 [label="Szczególnie, kiedy jeszcze nie powiedziałam, jak głębokie są to rany.",shape=box,color=blue];
		2213 -> 2214;
	2218 [label="Przepraszam, jaki był to dźwięk? Chyba niedosłyszałem :P",shape=box,color=red];
		2218 -> 2220;
	2219 [label="A pierwszy raz? ",shape=box,color=red];
		2219 -> 2222;
	2214 [label="Chat ends.",color=orange];
	2220 [label="\"Pfłał\"?",shape=box,color=blue];
		2220 -> 2221;
	2222 [label="Mandy Jellicoe. Zakochałam się w niej. Wyleciała ze szkoły, zafarbowała włosy, zrobiła sobie piercingi i kręciła się po mieście, nosząc skórzaną kurtkę, paląc papierosy i zabijając wzrokiem każdego, kto się zbliżył. Patrzyłam na nią i moje nogi uginały się pode mną.",shape=box,color=blue];
		2222 -> 2223;
	2221 [label="To tradycyjny brytyjski wyraz podziwu. Powinien zostać wymówiony z delikatnym warkotem i wydętymi policzkami.",shape=box,color=blue];
		2221 -> 2223;
	2223 [label="W każdym razie, NIEWAŻNE.",shape=box,color=blue];
		2223 -> 2224;
	2224 [label="A więc ty i Krzysztof…",shape=box,color=red];
		2224 -> 2225;
	2225 [label="Tak. Był miły. Piękny. Silny. Łatwo było go zmotywować, co było dużym pluszem. Ale uwziął się na dołączenie do armii. ",shape=box,color=blue];
		2225 -> 2226;
	2226 [label="W tym się nie zgadzaliśmy. To było jego powołanie. Miał pomagać potrzebującym, zmieniać świat. Uwierzył w opowieści o bohaterach, zupełnie jak Artur. ",shape=box,color=blue];
		2226 -> 2227;
	2227 [label="Check boolean EleanorHeroVirus",color=orange];
		2227 -> 2228 [label=true,color=green];
		2227 -> 2229 [label=true,color=green];
		2227 -> 2230 [label=true,color=green];
		2227 -> 2229 [label=false,color=brown];
		2227 -> 2230 [label=false,color=brown];
	2228 [label="Wiem, że nienawidzisz idei bohaterów. Czy to dlatego?",shape=box,color=red];
		2228 -> 2231;
	2229 [label="Miał rację. Tylko ludzie gotowi walczyć o lepszy świat mogą go zmienić.",shape=box,color=red];
		2229 -> 2233;
	2230 [label="To kuszący pomysł. Ludzie są chętni do pomocy. Łatwo to wykorzystać.",shape=box,color=red];
		2230 -> 2236;
	2231 [label="Tak. Nienawidzę, do czego skłoniło to Krzysztofa i co nadal robi z Arturem, jak z wieloma innymi.",shape=box,color=blue];
		2231 -> 2232;
	2233 [label="Możesz walczyć o lepszy świat, nie dając się zwieść tym bzdurom o bohaterach!",shape=box,color=blue];
		2233 -> 2234;
	2236 [label="\"Dlaczego chcesz zabijać w imię księcia, który ma cię w dupie?\" pytałam. Zabolałoby go to, bo nie miało chodzić o służbę Jego Królewskiej Mości. Jemu chodziło o walkę z watażkami, którzy kradli żywność i zmuszali więźniów politycznych do karkołomnej pracy w kopalniach Rubidu, dopóki nie padli z wycieńczenia.",shape=box,color=blue];
		2236 -> 2237;
	2232 [label="Nie mam nic przeciwko ideałom. Na Bogów, sama mam ich kilka. Ale cała historyjka o bohaterstwie prowadzi do zguby.",shape=box,color=blue];
		2232 -> 2237;
	2234 [label="Cały sens Wirusa Bohaterów polega na tym, że ZUPEŁNIE NIE OBCHODZI GO NOSICIEL. Przekonuje cię, że śmierć w imię dobrej sprawy jest szlachetna, zamiast bezsensowną stratą.",shape=box,color=blue];
		2234 -> 2235;
	2237 [label="Byłam pewna, że uda mi się zmienić zdanie Krzysztofa o służbie. Jeśli nie dyskusją, to uwodzeniem.",shape=box,color=blue];
		2237 -> 2238;
		2237 -> 2239;
		2237 -> 2240;
		2237 -> 2241;
	2235 [label="Chat ends.",color=orange];
	2238 [label="To dosyć aroganckie z twojej strony.",shape=box,color=red];
		2238 -> 2242;
	2239 [label="Szykuję się na \"ale\".",shape=box,color=red];
		2239 -> 2244;
	2240 [label="Brzmi jakby już podjął swoją decyzję.",shape=box,color=red];
		2240 -> 2247;
	2241 [label="...na przyszłość: Pokłócić się z Eleanor...",shape=box,color=red];
		2241 -> 2248;
	2242 [label="Tak, i?",shape=box,color=blue];
		2242 -> 2243;
	2244 [label="Czy muszę to mówić?",shape=box,color=blue];
		2244 -> 2245;
	2247 [label="+10 Chemistry",color=orange];
		2247 -> 2246;
	2248 [label="... to nie pora na żarty.",shape=box,color=blue];
		2248 -> 2249;
	2243 [label="Próbowałam ocalić jego życie. Byłam gotowa na ciosy poniżej pasa.",shape=box,color=blue];
		2243 -> 2251;
	2245 [label="Sama zaplątałam się w sieci, którą próbowałam utkać.",shape=box,color=blue];
		2245 -> 2251;
	2246 [label="Tak. Było już za późno. Myślałam, że uda mi się go uwieść, ale prawda była taka, że to on uwiódł mnie.",shape=box,color=blue];
		2246 -> 2250;
	2249 [label="To nie jest dla mnie lekki temat, więc wybierz sobie lepsze momenty.",shape=box,color=blue];
		2249 -> 2251;
	2251 [label="Powiedziałam mu, że byłam w ciąży. Zaproponował mi ślub. Kochany idiota.",shape=box,color=blue];
		2251 -> 2252;
	2250 [label="Przepraszam, ale nie będę w stanie przez to przejść bez płaczu, więc jeśli odpowiedzi zajmą mi dłużej, to dlatego.",shape=box,color=blue];
		2250 -> 2251;
	2252 [label="A byłaś?",shape=box,color=red];
		2252 -> 2253;
	2253 [label="Nie. Ale myślałam, że byłam. Nie oszukałam go, jeśli o to pytasz.",shape=box,color=blue];
		2253 -> 2254;
	2254 [label="Artur był w siódmym niebie. Człowiek, który był dla niego jak brat, miał zostać jego szwagrem.",shape=box,color=blue];
		2254 -> 2255;
	2255 [label="A potem wszystko nabiera tempa. Coś o pierwszym ataku. Zamknięcie granic, ryzyko eskalacji, mandaty moralne. Krzysztof udał się na misję. Artur już się zwerbował, wszystkie chłopaki dołączyły do Karmazynowej Straży, a moja mama wciąż próbowała wszystkich usadzić przy ślubnym stole.",shape=box,color=blue];
		2255 -> 2256;
		2255 -> 2257;
	2256 [label="I co się stało?",shape=box,color=red];
		2256 -> 2258;
	2257 [label="Na pewno chcesz o tym mówić?",shape=box,color=red];
		2257 -> 2258;
	2258 [label="Zabili go. Ludzie, którym mieli pomagać. Wysadzili go w powietrze bombą z nawozu i gwoździ.",shape=box,color=blue];
		2258 -> 2259;
	2259 [label="Powtarzam sobie \"przynajmniej odszedł szybko\". \"Przynajmniej nie cierpiał\". Ale z tego, co wiem, mógł umrzeć krzycząc z gwoździami w oczach",shape=box,color=blue];
		2259 -> 2260;
	2260 [label="Cholera",shape=box,color=blue];
		2260 -> 2261;
	2261 [label="Cholera jasna",shape=box,color=blue];
		2261 -> 2262;
		2261 -> 2263;
	2262 [label="Przynajmniej odszedł w słusznej sprawie...",shape=box,color=red];
		2262 -> 2264;
	2263 [label="Tak mi przykro...",shape=box,color=red];
		2263 -> 2266;
	2264 [label="Mam wrażenie, że nie przeczytałeś ANI JEDNEJ WIADOMOŚCI, jaką wysłałam.",shape=box,color=blue];
		2264 -> 2265;
	2266 [label="Oczywiście, że płakałam, ale myślałam też \"czego się spodziewałaś IDIOTKO, WIEDZIAŁAŚ, w co się wpakował, WIEDZIAŁAŚ, że to się stanie\"",shape=box,color=blue];
		2266 -> 2267;
	2265 [label="Nie interesuje mnie \"przynajmniej...\" Umarł w GŁUPI sposób z GŁUPIEGO powodu.",shape=box,color=blue];
		2265 -> 2269;
	2267 [label="Opowiadanie o tym brzmi jak tandetna piosenka ludowa",shape=box,color=blue];
		2267 -> 2268;
	2269 [label="Check boolean EleanorDating",color=orange];
		2269 -> 2270 [label=true,color=green];
		2269 -> 2271 [label=false,color=brown];
	2268 [label="Moja miłość poszła na wojnę, przygrywka, och nie, umarł, będę wędrować w samotnych dolinach i nie wyjdę za innego",shape=box,color=blue];
		2268 -> 2279;
	2270 [label="A jeśli nie zwracasz uwagi na to, co teraz mówię, to, co innego do ciebie nie dociera? Może to, co było między nami, było urocze... Nie, to był błąd.",shape=box,color=blue];
		2270 -> 2272;
	2271 [label="A jeśli nie zwracasz uwagi na to, co teraz mówię, to co innego do ciebie nie dociera?",shape=box,color=blue];
		2271 -> 2273;
	2279 [label="Przepraszam. Weź się w garść, Eleanor.",shape=box,color=blue];
		2279 -> 2280;
	2272 [label="To wszystko to był błąd. Koniec z nami.",shape=box,color=blue];
		2272 -> 2275;
	2273 [label="Update boolean EleanorNoDate",color=orange];
		2273 -> 2274;
	2280 [label="Myślę, że polubiłby cię.",shape=box,color=blue];
