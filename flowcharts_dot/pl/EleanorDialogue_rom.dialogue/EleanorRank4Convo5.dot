digraph {
	1803 [label="EleanorRank4Convo5 begins.",color=orange];
		1803 -> 1804;
	1804 [label="Królestwo, którym rządziłeś. Duviri. Nie stworzyłeś go, prawda?",shape=box,color=blue];
		1804 -> 1805;
		1804 -> 1806;
	1805 [label="Trochę tak i trochę nie. Miejsce i postaci pochodziły z książki dla dzieci, którą uwielbiałem. \"Opowieści z Duviri\". A Pustka zamieniła ją w rzeczywistość",shape=box,color=red];
		1805 -> 1807;
	1806 [label="Jestem zmęczony rozmowami o Duviri...",shape=box,color=red];
		1806 -> 1813;
	1807 [label="Jak ci się to udało?",shape=box,color=blue];
		1807 -> 1809;
		1807 -> 1810;
	1813 [label="+5 Chemistry",color=orange];
		1813 -> 1808;
	1809 [label="Byłem całkiem sam. Myślę, że inne dzieci były albo martwe, albo zostały uratowane. Ciężko ze szczegółami.",shape=box,color=red];
		1809 -> 1811;
	1810 [label="To nie było tak naprawdę zamierzone. Pamiętam tylko…",shape=box,color=red];
		1810 -> 1811;
	1808 [label="Ups. Mój błąd.",shape=box,color=blue];
		1808 -> 1814;
	1811 [label="Anioły nadchodziły, przebijając się przez ściany, a ja nie miałem dokąd uciec. Miałem książkę, i pamiętam tylko, że pomyślałem wtedy: \"Tutaj mogę być bezpieczny\".",shape=box,color=red];
		1811 -> 1812;
	1814 [label="To było nierozważne z mojej strony, prawda? To nie był dla ciebie letni obóz.",shape=box,color=blue];
		1814 -> 1815;
	1812 [label="Anioły? W tych czasach anioły są postrzegane jako dobroczynne istoty. Trochę przerażające, ale raczej dobre. Chyba, że chodzi ci o upadłe anioły.",shape=box,color=blue];
		1812 -> 1817;
	1815 [label="Najmocniej przepraszam. Postaram się trzymać swoją ciekawość pod kontrolą.",shape=box,color=blue];
		1815 -> 1816;
	1817 [label="To się nie zmieniło w moich czasach. Anioły powinny być skrzydlatymi, lśniącymi stworzeniami ze starych opowieści, które pomagają dobrym ludziom. Mówię o Aniołach Pustki. To zupełnie inne bestie.",shape=box,color=red];
		1817 -> 1818;
	1816 [label="Chat ends.",color=orange];
	1818 [label="Rozumiem. Nie wyobrażam sobie, żeby coś takiego jak \"Anioł Pustki\" zstąpiło z niebios i błogosławiło nowo narodzone dziecię.",shape=box,color=blue];
		1818 -> 1819;
	1819 [label="Z tego co wiem, to byli kiedyś ludzie. Kiedy dosięgnie ich pieśń Aniołów, zaczynają się zmieniać, a kiedy nie są w stanie już z tym walczyć, sami stają się Aniołami.",shape=box,color=red];
		1819 -> 1820;
	1820 [label="Przyszłość, którą opisujesz, brzmi jak koszmar.",shape=box,color=blue];
		1820 -> 1821;
	1821 [label="Nie mogę cię winić za chęć ucieczki przed Aniołami Pustki. Szczególnie jeśli to byli twoi…",shape=box,color=blue];
		1821 -> 1822;
	1822 [label="Och. Mam przeczucie, że to nie byli twoi rodzice, prawda?",shape=box,color=blue];
		1822 -> 1823;
		1822 -> 1824;
		1822 -> 1825;
	1823 [label="Jestem prawie pewien, że moi rodzice nie żyją.",shape=box,color=red];
		1823 -> 1826;
	1824 [label="Mogli być. Inne dzieci słyszały nawoływania swoich rodziców.",shape=box,color=red];
		1824 -> 1826;
	1825 [label="Tak mogło być. Quinn ostrzegał mnie, żebym nie podążał za znajomymi głosami. Pewnie o to mu chodziło.",shape=box,color=red];
		1825 -> 1826;
	1826 [label="Tak bardzo mi przykro. Cieszę się, że znalazłeś bezpieczne miejsce, nawet jeśli tylko na chwilę.",shape=box,color=blue];
		1826 -> 1827;
	1827 [label="Było bezpieczne dłużej niż chwilę. Na tyle długo, abym mógł zapomnieć. Chyba taki był mój cel.",shape=box,color=red];
		1827 -> 1828;
	1828 [label="Ale jak do cholery to zrobiłeś? Byłeś tylko dzieckiem. Co dało ci moc wyczarowania całego królestwa z niczego?",shape=box,color=blue];
		1828 -> 1829;
		1828 -> 1830;
		1828 -> 1831;
	1829 [label="Dzieci są fascynujące, bo jeszcze nie wiedzą, czego nie mogą zrobić. Ja nie wiedziałem, że to niemożliwe, więc to zrobiłem.",shape=box,color=red];
		1829 -> 1833;
	1830 [label="Przeżyłem tak wiele emocji jednocześnie, że... chyba... coś z nimi zrobiłem. Ciężko to wyjaśnić.",shape=box,color=red];
		1830 -> 1832;
	1831 [label="Pustka to nie jest \"nic\". Brzmi, jakby tak powinno być, ale nie jest. Albrecht to udowodnił.",shape=box,color=red];
		1831 -> 1832;
	1833 [label="Kiedy miałam pięć lat, chciałam być wiedźmą. Krzyknęłam abra-kadabra i skoczyłam ze szczytu schodów. Jeszcze nie wiedziałam, że nie umiem latać, ale szybko się nauczyłam.",shape=box,color=blue];
		1833 -> 1834;
	1832 [label="Nawet teraz nie wiemy o niej wiele. Ale Orokin odkryli jedno: Pustka reaguje na ludzkie emocje.",shape=box,color=red];
		1832 -> 1836;
	1834 [label="Moc stworzenia Duviri musiała wziąć się skądś indziej, niż z ciebie. Wykorzystałeś ją do stworzenia czegoś niesamowitego, ale nie byłeś jej źródłem.",shape=box,color=blue];
		1834 -> 1835;
	1836 [label="JUŻ ROZUMIEM. Więc jeśli zajrzysz w Pustkę… hmm, na przykład \"wygłodniały\"…, to możesz stworzyć wygłodniałego wilka. Albo królewską ucztę. A może nawet bochen chleba nadżarty przez zęby wilka. ",shape=box,color=blue];
		1836 -> 1837;
	1835 [label="Przynajmniej nie na początku. Ale teraz ta dzika energia jest twoja. Krąży w czasie. Na Bogów, jesteś cudem.",shape=box,color=blue];
		1835 -> 1838;
	1837 [label="Cóż za przerażająca, a zarazem ekscytująca myśl.",shape=box,color=blue];
		1837 -> 1838;
	1838 [label="Dlaczego Orokin uznali, że posłanie statku pełnego dzieci w Pustkę to dobry pomysł? Czy to nie była tykająca, emocjonalna bomba? ",shape=box,color=blue];
		1838 -> 1839;
	1839 [label="Po to mieliśmy tę książkę. Na pierwszy rzut oka dotyczyła tych przerysowanych postaci na dworze szalonego Króla, którego nastrój zmieniał się każdego dnia. ",shape=box,color=red];
		1839 -> 1840;
	1840 [label="Ale prawdziwym przesłaniem była kontrola nad swoimi emocjami. Mieliśmy nauczyć się z niej, aby nasza podróż przebiegła bezpiecznie.",shape=box,color=red];
		1840 -> 1841;
	1841 [label="Uch. Przepraszam, ale wszystko zrujnowałeś. ",shape=box,color=blue];
		1841 -> 1842;
	1842 [label="Dlaczego bajki nie mogą pozostać bajkami? Byłam WŚCIEKŁA, kiedy dowiedziałam się, że Rudolf, Król Lampart, który bohatersko poległ w bitwie pod Zodiakiem Węża miał reprezentować Sol i plamy, cierpiących na drzewie gwiazd. ",shape=box,color=blue];
		1842 -> 1843;
	1843 [label="Przemycanie religii do bajek dla dzieci jest jak chowanie leków w słodyczach. PO PROSTU IM TO POWIEDZ.",shape=box,color=blue];
		1843 -> 1844;
		1843 -> 1845;
	1844 [label="Nigdy nie słyszałem o Rudolfie, Królu Lamparcie.",shape=box,color=red];
		1844 -> 1846;
	1845 [label="Chciałbym usłyszeć kiedyś historię Rudolfa, Króla Lamparta.",shape=box,color=red];
		1845 -> 1847;
	1846 [label="Mogę umrzeć szczęśliwa wiedząc, że te książki zostaną zapomniane. Niech żyje przyszłość!",shape=box,color=blue];
		1846 -> 1848;
	1847 [label="Ugh. Błagam cię, nie. To nie jest prawdziwa legenda, do okropna seria bajek dla dzieci.",shape=box,color=blue];
		1847 -> 1849;
	1848 [label="Ale macie w przyszłości takie bajki, prawda?",shape=box,color=blue];
		1848 -> 1850;
	1849 [label="Jeśli chcesz, mogę ci opowiedzieć kilka prawdziwych legend.",shape=box,color=blue];
		1849 -> 1851;
		1849 -> 1852;
	1850 [label="Ogrom. Mamy nawet opowieści o Tenno i Warframe'ach. ",shape=box,color=red];
		1850 -> 1854;
	1851 [label="Podoba mi się to.",shape=box,color=red];
		1851 -> 1861;
	1852 [label="Nie teraz. [Koniec]",shape=box,color=red];
		1852 -> 1853;
	1854 [label="Jest taki człowiek, Drusus Leverian. Jest czymś w rodzaju kustosza muzeum. Pilnuje zapisów legend o Warframe'ach.",shape=box,color=red];
		1854 -> 1855;
	1861 [label="Zobaczmy. Jest Artur, oczywiście. Stary dobry Artur. Oryginalny. Idol Brytanii.",shape=box,color=blue];
		1861 -> 1863;
	1853 [label="Chat ends.",color=orange];
	1855 [label="Teraz mnie zaskoczyłeś. Pochodzisz z przyszłości, ale też tyle czasu tkwiłeś w Duviri, że rzeczy, które miały miejsce za twojego życia, mogły zostać mitami?",shape=box,color=blue];
		1855 -> 1856;
	1863 [label="Była też Młoda Loxley. Uwielbiałam ją. Chciałam nią zostać. Była wzorem dla niektórych młodych kobiet.",shape=box,color=blue];
		1863 -> 1866;
	1856 [label="Aż zakręciło mi się w głowie. ",shape=box,color=blue];
		1856 -> 1857;
		1856 -> 1858;
	1866 [label="Jaka jest jej historia?",shape=box,color=red];
		1866 -> 1867;
	1857 [label="Wiem, co czujesz.",shape=box,color=red];
		1857 -> 1859;
	1858 [label="Opowiedz mi o swoich mitach.",shape=box,color=red];
		1858 -> 1860;
	1867 [label="Okej, w dużym skrócie: była córką szlachcica w dawnych czasach, a państwo cierpiało pod rządami okrutnego króla.",shape=box,color=blue];
		1867 -> 1868;
	1859 [label="Sam jesteś postacią z bajki, prawda?",shape=box,color=blue];
		1859 -> 1862;
	1860 [label="O kurka. Zejdzie nam cały rok, jak zacznę. ",shape=box,color=blue];
		1860 -> 1861;
	1868 [label="Jej brat zginął walcząc za granicą, ale ta wieść nie dotarła jeszcze do domu, więc kiedy ludzie potrzebowali bohatera, ona wykorzystała okazję.",shape=box,color=blue];
		1868 -> 1881;
	1862 [label="Uwięziony w magicznym królestwie, gdzie czas płynie inaczej. Przyzwany w miejsce, w którym jesteś najbardziej potrzebny...",shape=box,color=blue];
		1862 -> 1864;
	1881 [label="Check boolean EleanorHeroVirus",color=orange];
		1881 -> 1882 [label=true,color=green];
		1881 -> 1883 [label=false,color=brown];
	1864 [label="W twojej historii brakuje tylko obiektu westchnień, albo śliniącego się, nieludzkiego potwora.",shape=box,color=blue];
		1864 -> 1865;
	1882 [label="Wydawało mi się, że nienawidzisz bohaterów.",shape=box,color=red];
		1882 -> 1885;
	1883 [label="Jak już wspomniałam, nie znoszę postaci bohaterów. Są toksyczne, zaraźliwe, i z tego powodu tez niebezpieczne.",shape=box,color=blue];
		1883 -> 1884;
	1865 [label="(Albo śliniącego się, nieludzkiego obiektu westchnień. Nie oceniam.)",shape=box,color=blue];
		1865 -> 1869;
		1865 -> 1870;
	1885 [label="Ona jest wyjątkiem, cicho tam.",shape=box,color=blue];
		1885 -> 1886;
	1884 [label="Młoda Loxley jest wyjątkowa.",shape=box,color=blue];
		1884 -> 1887;
	1869 [label="Zawsze uważałam potwory za bardziej interesujące. Bohaterzy są nudni. Przewidywalni. ...Szablonowi.",shape=box,color=red];
		1869 -> 1872;
	1870 [label="Nie wiem, czy potwory są w moim typie.",shape=box,color=red];
		1870 -> 1871;
	1886 [label="Jak już mówiłam. Była bardzo podobna do swojego brata, więc przywdziała jego stare ubrania i udawała go, aby poprowadzić rewolucję. Gdyby ktokolwiek się odpowiednio zbliżył, mógłby zauważyć, że to dziewczyna, więc zaczęła nosić kaptur, który stał się jej znakiem rozpoznawczym.",shape=box,color=blue];
		1886 -> 1888;
	1887 [label="Update boolean EleanorHeroVirus",color=orange];
		1887 -> 1888;
	1872 [label="Update boolean EleanorFlirt",color=orange];
		1872 -> 1873;
	1871 [label="I to jest w porządku.",shape=box,color=blue];
		1871 -> 1878;
	1888 [label="Miała niesamowitą wprawę w posługiwaniu się łukiem. Ona i jej banda stali się ulubioną grupką przestępców, okradających królewskich wysłanników i rozdając te pieniądze potrzebującym.",shape=box,color=blue];
		1888 -> 1889;
	1873 [label="+15 Chemistry",color=orange];
		1873 -> 1874;
	1878 [label="Potwory są przyzwyczajone do samotności.",shape=box,color=blue];
		1878 -> 1879;
	1889 [label="Brzmi, jakby sama w sobie wzbudzała szacunek. Po co miałaby udawać swojego brata?",shape=box,color=red];
		1889 -> 1890;
	1874 [label="Nie to straszne, co straszne, ale co się komu podoba, przyjacielu.",shape=box,color=blue];
		1874 -> 1875;
	1879 [label="Przetrwamy.",shape=box,color=blue];
		1879 -> 1880;
	1890 [label="To już historia. W tamtych czasach rzekomo tylko mężczyźni walczyli, więc tylko i oni rządzili. To oni wydawali rozkazy. Musiała wykorzystać reputację brata, aby osiągnąć cel, albo odniosłaby klęskę.",shape=box,color=blue];
		1890 -> 1892;
		1890 -> 1891;
		1890 -> 1893;
	1875 [label="Jeśli naprawdę pociągają cię \"potworne\" cechy innego człowieka, lepiej, żeby podzielali twoje zdanie o takich określeniach i rozkoszowali się nim. W innym wypadku dopuszczasz się najohydniejszej fetyszyzacji.",shape=box,color=blue];
		1875 -> 1876;
	1880 [label="Chat ends.",color=orange];
	1892 [label="I co się z nią stało?",shape=box,color=red];
		1892 -> 1895;
	1891 [label="Cieszę się, że to nie jest już problem w przyszłości.",shape=box,color=red];
		1891 -> 1894;
	1893 [label="Nie jestem pewien, czy *całkiem* to naprawiliśmy w przyszłości...",shape=box,color=red];
		1893 -> 1896;
	1876 [label="Czy nazwałabym siebie potworem? Tak. Oczywiście. Przyjmuję tytuł, którym inni starali mnie potępiać i raduję się nim, jeśli cię to zastanawiało.",shape=box,color=blue];
		1876 -> 1877;
	1895 [label="+20 Chemistry",color=orange];
		1895 -> 1898;
	1894 [label="+20 Chemistry",color=orange];
		1894 -> 1897;
	1896 [label="+20 Chemistry",color=orange];
		1896 -> 1899;
	1877 [label="Chat ends.",color=orange];
	1898 [label="Zależy, jaką wersję tej opowieści przeczytasz. Albo trafiła prosto do Sali Bohaterów, albo wyszła za zagubioną córkę króla, albo została uwięziona w dębie, gdzie spoczywa do dziś i czeka, aż Brytania będzie znowu jej potrzebować.",shape=box,color=blue];
		1898 -> 1901;
	1897 [label="Ja też.",shape=box,color=blue];
		1897 -> 1900;
	1899 [label="Patrząc na postać Ballasa, raczej nie.",shape=box,color=blue];
		1899 -> 1902;
	1901 [label="I stąd powiedzenie. Jeśli nie dzieje się dobrze, jak podczas wojny, tradycją jest wzruszyć ramionami i rzec \"Nie może być aż TAK ŹLE! Młoda Loxley nadal się nie pojawiła\".",shape=box,color=blue];
		1901 -> 1904;
	1900 [label="Na Bogów, chciałabym zobaczyć twoje czasy moimi własnymi oczami. Może byłbyś w stanie sprowadzić jedną z tych lodówko-trumien o dać mi się zdrzemnąć na kilka tysiącleci?",shape=box,color=blue];
		1900 -> 1903;
	1902 [label="Ile jeszcze czasu potrzebujemy do cholery?",shape=box,color=blue];
		1902 -> 1905;
	1904 [label="Chat ends.",color=orange];
	1903 [label="Chat ends.",color=orange];
	1905 [label="Chat ends.",color=orange];
}