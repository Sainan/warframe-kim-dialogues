		j3528729371 -> "Chat ends." [label=false,color=brown];
	j2280937831 [label="Chyba jedyne co mi przeszkadza jest to, że sama natrafiłam na twoje myśli o tej osobie.",shape=box,color=blue];
		j2280937831 -> j2510165873;
	j2510165873 [label="Nie, żebym nie wiedziała, że chciałeś przyjść i grzecznie prosić o pozwolenie. Dzień dobry.",shape=box,color=blue];
		j2510165873 -> j524515953;
	j524515953 [label="Odpowiedź to bardzo nadąsane i z założonymi rękami \"ależ oczywiście\", kiedy ja siedzę tutaj próbując nie myśleć o tym, jak odchodzisz w objęcia tej pięknej istoty, którą dostrzegłam w twoich fantazjach.",shape=box,color=blue];
		j524515953 -> j166119022;
	j166119022 [label="To teraz MOJE fantazje, ponieważ utknęłam w tym miejscu i czasie. Dziękuję bardzo!",shape=box,color=blue];
		j166119022 -> j1521336164;
	j1521336164 [label="Przepraszam. Naprawdę przychodzę zapytać cię o zgodę. Wiem, że to nie jest temat, który poruszaliśmy wcześniej, dlatego chciałem mieć pewność, że ci to nie przeszkadza.",shape=box,color=red];
		j1521336164 -> j2733911020;
	j2733911020 [label="Oczywiście, że nie! Widzę tą osobę w twoich myślach. Jeśli ty ufasz, to ja też ufam.",shape=box,color=blue];
		j2733911020 -> j632513018;
	j632513018 [label="Po prostu jest mi przykro, że to ja nie mogę pobawić się na dworze.",shape=box,color=blue];
		j632513018 -> j4141172972;
	j4141172972 [label="+20 Chemistry",color=orange];
		j4141172972 -> j1212157329;
	j1212157329 [label="Ale może zdołam zrobić to pośrednio przez ciebie. To jest myśl.",shape=box,color=blue];
		j1212157329 -> j298331240;
	j298331240 [label="Boolean EleanorConsentComplete is now true.",color=orange];
		j298331240 -> "Chat ends.";
