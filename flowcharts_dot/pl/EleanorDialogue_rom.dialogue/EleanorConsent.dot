	3318 [label="Chat ends.",color=orange];
	3319 [label="Chyba jedyne co mi przeszkadza jest to, że sama natrafiłam na twoje myśli o tej osobie.",shape=box,color=blue];
		3319 -> 3320;
	3317 [label="Chat ends.",color=orange];
	3320 [label="Nie, żebym nie wiedziała, że chciałeś przyjść i grzecznie prosić o pozwolenie. Dzień dobry.",shape=box,color=blue];
		3320 -> 3321;
	3321 [label="Odpowiedź to bardzo nadąsane i z założonymi rękami \"ależ oczywiście\", kiedy ja siedzę tutaj próbując nie myśleć o tym, jak odchodzisz w objęcia tej pięknej istoty, którą dostrzegłam w twoich fantazjach.",shape=box,color=blue];
		3321 -> 3322;
	3322 [label="To teraz MOJE fantazje, ponieważ utknęłam w tym miejscu i czasie. Dziękuję bardzo!",shape=box,color=blue];
		3322 -> 3323;
	3323 [label="Przepraszam. Naprawdę przychodzę zapytać cię o zgodę. Wiem, że to nie jest temat, który poruszaliśmy wcześniej, dlatego chciałem mieć pewność, że ci to nie przeszkadza.",shape=box,color=red];
		3323 -> 3324;
	3324 [label="Oczywiście, że nie! Widzę tą osobę w twoich myślach. Jeśli ty ufasz, to ja też ufam.",shape=box,color=blue];
		3324 -> 3325;
	3325 [label="Po prostu jest mi przykro, że to ja nie mogę pobawić się na dworze.",shape=box,color=blue];
		3325 -> 3326;
	3326 [label="+20 Chemistry",color=orange];
		3326 -> 3327;
	3327 [label="Ale może zdołam zrobić to pośrednio przez ciebie. To jest myśl.",shape=box,color=blue];
		3327 -> 3328;
	3328 [label="Update boolean EleanorConsentComplete",color=orange];
		3328 -> 3329;
	3329 [label="Chat ends.",color=orange];
