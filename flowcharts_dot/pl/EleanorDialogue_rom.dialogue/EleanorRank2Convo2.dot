	411 [label="A nie wiem, myślę, że jest całkiem sexy... jak na skacowaną emo pandę.",shape=box,color=red];
		411 -> 416;
	412 [label="Mogłabyś poćwiczyć makijaż na mnie, jeśli chcesz ;)",shape=box,color=red];
		412 -> 418;
	410 [label="Ciężko mi brać CIEBIE na poważnie.",shape=box,color=red];
		410 -> 407;
	435 [label="U ojca w toalecie wisiał stary plakat z bombardowania w 37 roku. Lojalny żołnierz o kwadratowej szczenie okładał słabeusza, aż poleciały mu okulary. A napis brzmiał: \"Ucisz rodaka, który głosi słowo wroga!\"",shape=box,color=blue];
		435 -> 437;
	416 [label="To twoja decyzja i nie mam zamiaru jej oceniać",shape=box,color=blue];
		416 -> 417;
	418 [label="JAK ŚMIESZ",shape=box,color=blue];
		418 -> 419;
	407 [label="I o to chodzi.",shape=box,color=blue];
		407 -> 415;
	437 [label="Artur pokochał ten plakat, bo był \"niegrzeczny\", ale naukę wziął do serca. \"Nie gadaj na tematy, które mogą zranić twoich bliskich.\"",shape=box,color=blue];
		437 -> 438;
		437 -> 439;
	417 [label="Jeśli tego chcesz, mogę nawet życzyć ci powodzenia",shape=box,color=blue];
		417 -> 420;
	419 [label="Nie lekceważ świętego rytuału, jakim jest robienie sobie nawzajem makijażu",shape=box,color=blue];
		419 -> 421;
	415 [label="Chat ends.",color=orange];
	438 [label="Odpuść mu. To rozsądne podejście dla walczącej drużyny. Nigdzie nie popłyniesz dziurawym statkiem.",shape=box,color=red];
		438 -> 442;
	439 [label="To nieprawda. Jeśli nie omówisz bolesnych spraw, po prostu... dusisz je w sobie.",shape=box,color=red];
