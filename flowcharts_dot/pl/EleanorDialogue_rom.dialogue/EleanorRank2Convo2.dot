	387 [label="Jak trafiłaś do Höllvanii?",shape=box,color=red];
		387 -> 389;
	388 [label="Jak wyglądało twoje dzieciństwo z Arturem?",shape=box,color=red];
		388 -> 390;
	389 [label="To długa historia.",shape=box,color=blue];
		389 -> 391;
		389 -> 392;
	390 [label="Jak w raju. Nie pokłóciliśmy się nawet raz, dochowywaliśmy swoich tajemnic, pozwolił mi nawet zaplatać sobie włosy.",shape=box,color=blue];
		390 -> 393;
	391 [label="Powinienem w ogóle pytać? Czy to może temat na inny dzień?",shape=box,color=red];
		391 -> 397;
	392 [label="Podzielisz się ze mną prawdziwą wersją?",shape=box,color=red];
		392 -> 398;
	393 [label="Nic dziwnego, że wszyscy mi zazdroszczą i pragną, żeby Artur był im bratem.",shape=box,color=blue];
		393 -> 395;
		393 -> 394;
	397 [label="Może później, zakładając, że nie uciekniesz z miasta, a ja nie zmutowałam we wściekłą masę mięśni i ust.",shape=box,color=blue];
		397 -> 399;
	398 [label="Może, kiedy będę już pewna, że nie będziesz biegać między mną i Arturem, żeby porównywać notatki.",shape=box,color=blue];
		398 -> 400;
	395 [label="Pewnie dawał ci się też malować.",shape=box,color=red];
