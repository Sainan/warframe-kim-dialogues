		447 -> 449;
	430 [label="Kurka. Teraz czuję, jakbyś zasługiwał na przeprosimy, a z nimi sobie po prostu nie radzę.",shape=box,color=blue];
		430 -> 432;
	448 [label="Typowe sprawy. Korupcja na najwyższych szczeblach władzy. Skandale ojcostwa w rodzinie królewskiej Höllvanii. Zanieczyszczone mleko w proszku rozdawane karmiącym matkom w \"niepożądanych\" osiedlach Nowego Grajdołka.",shape=box,color=blue];
		448 -> 450;
	449 [label="Ach, tak. Turysta w naszych czasach. Typowe sprawy. Korupcja na najwyższych szczeblach władzy. Skandale ojcostwa w rodzinie królewskiej Höllvanii. Zanieczyszczone mleko w proszku rozdawane karmiącym matkom w \"niepożądanych\" osiedlach Nowego Grajdołka.",shape=box,color=blue];
		449 -> 450;
