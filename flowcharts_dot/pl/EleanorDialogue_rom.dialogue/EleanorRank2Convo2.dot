	442 [label="Wszystko jest w porządku, dopóki nie wykorzystuje się tego, żeby cię uciszyć.",shape=box,color=blue];
		442 -> 443;
	440 [label="A jeśli odpowiednio je zdusisz, mogą wymknąć się spod kontroli... coś o tym wiem...",shape=box,color=red];
		440 -> 441;
	422 [label="Jeśli CHOĆ PRZEZ CHWILĘ najdzie mnie podejrzenie, że wykorzystujesz nasze rozmowy, żeby dobrać mu się do jego pancernych gaci...",shape=box,color=blue];
		422 -> 423;
	426 [label="Przepraszam, pozwól mi złapać oddech.",shape=box,color=blue];
		426 -> 427;
	443 [label="Przez całe życie otaczały mnie rzeczy o których MUSIELIŚMY porozmawiać. Rozmowy, które POWINNY się odbyć. Babcia Callie. Krzysztof. Dwór Cavona. To wszystko gniło wśród nas.",shape=box,color=blue];
		443 -> 444;
	441 [label="Dokładnie. Wszystko jest w porządku, dopóki nie jest wykorzystywane po to, żeby cię uciszyć.",shape=box,color=blue];
		441 -> 443;
	423 [label="...będę jeszcze gorszym potworem, niż inni mnie uważają i aż zamarzycie o egzekucji.",shape=box,color=blue];
		423 -> 424;
	427 [label="...nie wykluczam takiej możliwości, okej? I dopiero do mnie dotarło, że to może być twój pierwszy raz.",shape=box,color=blue];
		427 -> 428;
	444 [label="Ale nie, to były tematy, o których się nie rozmawiało. Stawka była zbyt wysoka.",shape=box,color=blue];
		444 -> 445;
	424 [label="Update boolean EleanorArthurHunt",color=orange];
		424 -> 425;
	428 [label="Więc tym razem ci odpuszczę. Ale mówiąc poważnie, o takich rzeczach się nie żartuje.",shape=box,color=blue];
		428 -> 429;
	445 [label="Alternatywą było nigdy więcej nie czuć się dobrze we własnej skórze, więc za cel obrałam sobie poznać sprawy, o których ludzie nie chcieli rozmawiać. Pisałam na tematy, przez które niektórzy zechcieliby zepchnąć mój samochód w przełęcz Hyberyjską.",shape=box,color=blue];
		445 -> 446;
		445 -> 447;
	425 [label="Chat ends.",color=orange];
	429 [label="Dla Artura wiele znaczyło móc mi tak zaufać. Jeszcze ważniejsze było to, że dzięki temu mógł poczuć się dobrze ze sobą.",shape=box,color=blue];
		429 -> 430;
	446 [label="Pamiętaj, nie jestem stąd. O co chodziło?",shape=box,color=red];
