	394 [label="Jak miło. [Koniec]",shape=box,color=red];
		394 -> 396;
	399 [label="Bo możesz poznać fakty o niektórych ludziach, z którymi będzie ci ciężko się pogodzić.",shape=box,color=blue];
		399 -> 402;
	400 [label="Nie sądzę, żeby bardzo się przed tobą otworzył.",shape=box,color=blue];
		400 -> 401;
	404 [label="W sumie tak było. Do całkiem niedawna.",shape=box,color=blue];
		404 -> 405;
	396 [label="Chat ends.",color=orange];
	402 [label="Czyż nie jestem zagadkowa? Niczym Sfinks. Rarr.",shape=box,color=blue];
		402 -> 403;
	401 [label="Tak, jest dość skrytym człowiekiem.",shape=box,color=red];
		401 -> 406;
	405 [label="Chciałbym, żeby częściej używał eyelinera. Twierdzi, że to za dużo zachodu. Woli pastę do butów.",shape=box,color=blue];
		405 -> 413;
	403 [label="Chat ends.",color=orange];
	406 [label="Artur uważa, że o niektórych rzeczach nie powinno się rozmawiać, jest staroświecki. \"To złe dla morale\", mówi, \"pogawędki w obozie\", \"uważaj, możesz szerzyć wrogą propagandę\".",shape=box,color=blue];
		406 -> 408;
	413 [label="Świetnie wygląda z czarnymi smugami pod oczami, ale nie zna umiaru z cieniem do powiek. Próbuje być smutnym bogiem zarostu, zakładającym ręce na przystanku autobusowym o 2 nad ranem, ale zamiast tego wygląda jak skacowana emo panda. A potem dziwi się, dlaczego nikt nie traktuje go poważnie.",shape=box,color=blue];
		413 -> 414;
	408 [label="Żołnierzyk. Czy kiedykolwiek NIE jest na służbie?",shape=box,color=red];
		408 -> 409;
	414 [label="Update boolean EleanorArthurPanda",color=orange];
		414 -> 411;
		414 -> 412;
		414 -> 410;
	409 [label="Och, to u nas rodzinne.",shape=box,color=blue];
