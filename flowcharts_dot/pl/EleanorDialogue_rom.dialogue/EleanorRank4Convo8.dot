	1977 [label="Chat ends.",color=orange];
	2041 [label="Check boolean AmirRPG",color=orange];
		2041 -> 2043 [label=true,color=green];
		2041 -> 2042 [label=false,color=brown];
	2043 [label="Check boolean AmirRPGEleanorAsked",color=orange];
		2043 -> 2045 [label=true,color=green];
		2043 -> 2046 [label=false,color=brown];
		2043 -> 2047 [label=false,color=brown];
	2042 [label="Chat ends.",color=orange];
	2045 [label="Hej Eleanor? Pamiętasz tę grę planszową, którą szykuje Amir? \"Kikimory i Kazamaty\"?",shape=box,color=red];
		2045 -> 2044;
	2046 [label="Hej, Eleanor? Kolegujesz się z Amirem, prawda?",shape=box,color=red];
		2046 -> 2048;
	2047 [label="Słyszałem, że lubisz gry planszowe?",shape=box,color=red];
		2047 -> 2049;
	2044 [label="Tak. Ta, którą określiłeś jako strata czasu i że chciałeś w nią zagrać tylko z litości. O tę grę chodzi?",shape=box,color=blue];
		2044 -> 2050;
		2044 -> 2052;
		2044 -> 2053;
	2048 [label="To czarujący mały diabełek. Dlaczego pytasz?",shape=box,color=blue];
		2048 -> 2055;
		2048 -> 2056;
	2049 [label="Tak jak wszyscy inni. Dlaczego pytasz?",shape=box,color=blue];
		2049 -> 2055;
		2049 -> 2056;
	2050 [label="Auć. Okej. Nadal jesteś zła.",shape=box,color=red];
		2050 -> 2051;
	2052 [label="Uznałem, że jesteś \"zbyt cool\" na takie gry i udawałem, że też jestem. Teraz wiem lepiej.",shape=box,color=red];
		2052 -> 2054;
	2053 [label="Tak... chciałem za to przeprosić. Nie miałem tego na myśli i bałem się, że powiesz nie.",shape=box,color=red];
		2053 -> 2062;
	2055 [label="Amir próbuje zebrać drużynę do sesji w Kikimory i Kazamaty i obiecałem, że pomogę.",shape=box,color=red];
		2055 -> 2057;
	2056 [label="Amir chciałby zagrać z nami wszystkimi w Kikimory i Kazamaty. Piszesz się?",shape=box,color=red];
		2056 -> 2057;
	2051 [label="Chat ends.",color=orange];
	2054 [label="Które z nas nie jest już \"zbyt cool\" na tę grę? Ty czy ja?",shape=box,color=blue];
		2054 -> 2058;
		2054 -> 2059;
		2054 -> 2060;
	2062 [label="Każde z nas w pewnym okresie swojego życia próbowało nosić maskę, żeby komuś zaimponować i padaliśmy jak dłudzy, bo nie widzieliśmy, gdzie idziemy. Ledwo się znaliśmy, kiedy pytałeś. W porządku. Przebaczam ci.",shape=box,color=blue];
		2062 -> 2067;
	2057 [label="Rozumiem. Zostałeś posłańcem Króla Grzmota, którego zadaniem jest zwerbowanie pięknej Eleanor. Z pewnością czeka mnie niezwykła przygoda. Fol de rol i takie tam.",shape=box,color=blue];
		2057 -> 2063;
		2057 -> 2064;
	2058 [label="Ty. Nadal uwielbiam to za głupią grę.",shape=box,color=red];
		2058 -> 2061;
	2059 [label="Ja. Zdecydowanie ja. Ty nadal jesteś zbyt fajna na tę grę, ale ja jestem strasznym cieniasem, przynajmniej tak powiedział Quincy.",shape=box,color=red];
		2059 -> 2062;
	2060 [label="...ja i ty?",shape=box,color=red];
		2060 -> 2062;
	2067 [label="Szczerze mówiąc, głupi głos i udawanie kogoś innego przez kilka godzin brzmi jak świetna zabawa. Możesz na mnie liczyć.",shape=box,color=blue];
		2067 -> 2068;
	2063 [label="Wygląda na dobrą zabawę i to wiele dla niego znaczy.",shape=box,color=red];
		2063 -> 2067;
	2064 [label="Tak, myślę, że to strata czasu, ale staram się być miły.",shape=box,color=red];
		2064 -> 2065;
	2061 [label="Chat ends.",color=orange];
	2068 [label="Och! Chciałbym być czarodziejem. Albo bardem. Może jednym i drugim? Mogę BYĆ jednym i drugim na raz?",shape=box,color=blue];
		2068 -> 2069;
	2065 [label="Zrobię ci przysługę i NIE przekażę mu, co powiedziałeś. Uwaga na przyszłość: traktuj go z odrobiną szacunku w mojej obecności.",shape=box,color=blue];
		2065 -> 2066;
	2069 [label="Albo bagienną wiedźmą! Ale tylko jeśli mogę nosić ciasny gorset. Mateczka Mszepiersi pożre twoje kości, dzieciaczku.",shape=box,color=blue];
		2069 -> 2077;
	2066 [label="Chat ends.",color=orange];
	2077 [label="+20 Chemistry",color=orange];
		2077 -> 2070;
	2070 [label="Update boolean AmirRPGEleanor",color=orange];
		2070 -> 2071;
