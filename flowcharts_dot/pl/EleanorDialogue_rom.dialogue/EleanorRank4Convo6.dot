digraph {
	1906 [label="EleanorRank4Convo6 begins.",color=orange];
		1906 -> 1907;
		1906 -> 1908;
	1907 [label="A więc… dlaczego kryształy?",shape=box,color=red];
		1907 -> 1909;
	1908 [label="No więc... Ty i Quincy. Czy wy kiedykolwiek... no wiesz?",shape=box,color=red];
		1908 -> 1910;
	1909 [label="Och, zawsze je kochałam. Kiedy byłam mała, tata zabrał mnie do Muzeum Innowacji w Ludston, i z Arturem dostaliśmy te zestawy do hodowli kryształów. Arturowi wyszło coś na kształt małej kupy gówna i poleciała prosto do śmieci. Mi udało się stworzyć piękny, niebieski diament. Od tego dnia czułam, że kryształy są po mojej stronie.",shape=box,color=blue];
		1909 -> 1912;
	1910 [label="Okej, dzisiaj jestem w dobrym nastroju, więc tym razem nic cię to nie będzie kosztowało.",shape=box,color=blue];
		1910 -> 1911;
	1912 [label="Więc to tylko dekoracje?",shape=box,color=red];
		1912 -> 1916;
	1911 [label="Nie. Nawet odrobinę.",shape=box,color=blue];
		1911 -> 1913;
	1916 [label="Ach, nie.",shape=box,color=blue];
		1916 -> 1917;
	1913 [label="Nie mogę wyjść z przekonania, że preferowana pozycja Quincy'ego to \"partner trzyma nad nim lustro, żeby mógł wyobrazić sobie seks z samym sobą\".",shape=box,color=blue];
		1913 -> 1914;
	1917 [label="Wiem, że o kryształach napisano wiele bzdur, ale to nie moja bajka. Nie wierzę, że pomogą oczyścić moją aurę, czy rozjaśnią moje czakry.",shape=box,color=blue];
		1917 -> 1918;
	1914 [label="Podziękuję. Zadowala mnie podziwianie go z daleka.",shape=box,color=blue];
		1914 -> 1915;
	1918 [label="Ale mają pewną wartość. ",shape=box,color=blue];
		1918 -> 1919;
	1915 [label="Chat ends.",color=orange];
	1919 [label="Przepraszam, wiem, że brzmię jak wariatka. ",shape=box,color=blue];
		1919 -> 1920;
		1919 -> 1921;
		1919 -> 1922;
	1920 [label="Cieszę się, że to ty to powiedziałaś. To tylko kolorowe kamienie.",shape=box,color=red];
		1920 -> 1923;
	1921 [label="Przyjaźnie się z Cefalonami. To ludzie zaklęci w szkło. Dlaczego miałbym nabijać się z twojej więzi z kryształami?",shape=box,color=red];
		1921 -> 1924;
	1922 [label="Spędziłem za wiele czasu wydobywając kryształy z ziemi, żeby nie nadać im jakiegoś głębszego znaczenia. Zdziwiłabyś się, ile Warframe'ów wykorzystuje kryształy w swojej budowie.",shape=box,color=red];
		1922 -> 1925;
	1923 [label="Doprowadzasz mnie czasem do SZAŁU.",shape=box,color=blue];
		1923 -> 1926;
	1924 [label="I teraz ja czuję się głupio, że czuję się głupio.",shape=box,color=blue];
		1924 -> 1929;
	1925 [label="Jestem zaskoczona i zaintrygowana!",shape=box,color=blue];
		1925 -> 1930;
	1926 [label="Spodziewałabym się, że akurat ty mógłbyś przyjąć perspektywę wykraczającą ponad sprawy czysto materialne.",shape=box,color=blue];
		1926 -> 1927;
	1929 [label="Podejrzewam, że masz kryształy, o których ja mogę tylko pomarzyć.",shape=box,color=blue];
		1929 -> 1931;
		1929 -> 1932;
		1929 -> 1933;
	1930 [label="Powiedz mi, mądry wędrowcze, o kryształach z twoich czasów.",shape=box,color=blue];
		1930 -> 1932;
	1927 [label="Sio. Zostaw mnie z moimi kolorowymi kamieniami.",shape=box,color=blue];
		1927 -> 1928;
	1931 [label="Argon. Występuje tylko w Pustce i zanika, kiedy ją opuści.",shape=box,color=red];
		1931 -> 1934;
	1932 [label="Cała Warframe stworzona z kryształu. Citrine.",shape=box,color=red];
		1932 -> 1944;
	1933 [label="Para skazanych na zagładę kochanków, którzy zostali uwięzieni w kryształach.",shape=box,color=red];
		1933 -> 1941;
	1928 [label="Chat ends.",color=orange];
	1934 [label="Powiedziałeś \"występują tylko w Pustce\", jakby ludzie wchodzili i wychodzili z niej cały czas. Myślałam, że to szalony wymiar, nie sklep na rogu.",shape=box,color=blue];
		1934 -> 1937;
	1944 [label="+10 Chemistry",color=orange];
		1944 -> 1935;
	1941 [label="+10 Chemistry",color=orange];
		1941 -> 1936;
	1937 [label="Chyba nie powiedziałem ci jeszcze o Wieżach Orokin. Są jak twierdze w Pustce, przygotowane na wypadek ataku ze strony Świadomych.",shape=box,color=red];
		1937 -> 1951;
	1935 [label="Tak się nazywa? Chyba zobaczyłam ją w twojej głowie!",shape=box,color=blue];
		1935 -> 1938;
	1936 [label="Jakie to piękne i zarazem smutne. Jakie to uczucie stać się pomnikiem własnej miłości?",shape=box,color=blue];
		1936 -> 1939;
	1951 [label="+20 Chemistry",color=orange];
		1951 -> 1946;
	1938 [label="Piękna pani geoda. Podejrzewam, że jesteśmy spokrewnione. To pocieszająca myśl.",shape=box,color=blue];
		1938 -> 1943;
	1939 [label="Mam nadzieję, że nikt nie odłupie ich kawałków na pamiątkę. W moich czasach byłby to pewniak.",shape=box,color=blue];
		1939 -> 1940;
	1946 [label="To brzmi znajomo. Jak te bunkry pod Ludston i Mancunia. Zamysł był taki, że jeśli kiedykolwiek wybuchnie Promienna Wojna, grube ryby i inne szychy będą mogły zaszyć się w swoich luksusowych schronach i popijać Mimosy, kiedy reszta z nas spłonie na powierzchni.",shape=box,color=blue];
		1946 -> 1947;
	1943 [label="Witamy w rodzinie?",shape=box,color=red];
		1943 -> 1945;
	1940 [label="Niektórzy próbują, ale strzeżemy ich. Przynajmniej tyle możemy zrobić.",shape=box,color=red];
		1940 -> 1942;
	1947 [label="Zawsze ta sama historia - powiedziała wzdychając.",shape=box,color=blue];
		1947 -> 1948;
	1945 [label="Chat ends.",color=orange];
	1942 [label="Chat ends.",color=orange];
	1948 [label="To nawet zabawne. Wszyscy wychowali się w strachu przed Promienną Wojną. Pamiętam ogłoszenia, ponure porady, jak gromadzić zapasy, jak przygotować schron, jak pochować zmarłych krewnych, nawet jeśli bardzo tego nie chcesz.",shape=box,color=blue];
		1948 -> 1949;
	1949 [label="Kiedy w twojej głowie zobaczyłam wybuch reaktora, wróciłam do tych koszmarów. Wiedziałam, że to musiało zostać powstrzymane za wszelką cenę. Sprawiłabym, że inni ci uwierzą.",shape=box,color=blue];
		1949 -> 1950;
	1950 [label="Ale to nie Promienna Wojna czeka tę planetę, prawda? To Techrot. W taki czy inny sposób historia znajdzie drogę, a kiedy tak będzie, cały świat utonie w pladze.",shape=box,color=blue];
		1950 -> 1952;
	1952 [label="Chat ends.",color=orange];
}