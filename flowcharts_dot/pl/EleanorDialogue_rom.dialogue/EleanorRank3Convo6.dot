	1341 [label="Chat ends.",color=orange];
	1347 [label="Nie wiem, czy macie u siebie coś takiego. Są jak świątynie, tak mógłbyś je nazwać, zazwyczaj z zestawem pomieszczeń w stylu Sol i w stylu Lua. Możesz zanurzyć się w publicznych lub prywatnych basenach. Wszystko pachnie ziołami i parą i to jest ŚWIETNY SPOSÓB, żeby uporządkować myśli.",shape=box,color=blue];
		1347 -> 1348;
	1348 [label="Höllvania słynęła z tradycji rytualnej czystości. Podejrzewam, że sięga ona gorących źródeł, na których zbudowano to miasto.",shape=box,color=blue];
		1348 -> 1349;
	1349 [label="Ta cała \"czystość\", o której biadoli Wiktor? To stara śpiewka. Wszyscy obywatele wiedzą, skąd się to wzięło.",shape=box,color=blue];
		1349 -> 1350;
	1350 [label="Zawsze z chęcią płaciłam ekstra, żeby jakiś umięśniony profesjonalista wycisnął stres z moich mięśni. Spodobałoby ci się, jestem tego pewna.",shape=box,color=blue];
