		1358 -> 1360;
	1360 [label="Z tego co widziałam, niektóre z nich są teraz źródłami zarazy. Moje serce się kraje, że taka jest prawda. Pamiętam widok tysiącletniej mozaiki z marmuru, które zostało okryte rosnącą naroślą.",shape=box,color=blue];
