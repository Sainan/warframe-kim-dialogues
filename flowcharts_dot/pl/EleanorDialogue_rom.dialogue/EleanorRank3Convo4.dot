		1196 -> 1197;
	1197 [label="Musisz zrozumieć, że z początku istniała tylko jedna wersja mnie. Byliśmy tą samą osobą do chwili, w której podaliśmy rękę tej istocie. Wtedy nasze drogi się rozeszły.",shape=box,color=red];
		1197 -> 1198;
	1198 [label="Ok. Boli mnie od tego głowa, ale ok.",shape=box,color=blue];
		1198 -> 1199;
	1199 [label="Więc jest sobie dziecko. Głęboko straumatyzowane dziecko. I ktoś wpadł na genialny pomysł dać mu broń, pancerz i stroje bojowe zrobione z martwych ludzi, wytrenować ich w sztuce zabijania i posłać na wojnę?",shape=box,color=blue];
