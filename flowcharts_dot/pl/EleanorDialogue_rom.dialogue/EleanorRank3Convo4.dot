digraph {
	1123 [label="EleanorRank3Convo4 begins.",color=orange];
		1123 -> 1124;
	1124 [label="Przerwij mi, jeśli się mylę:",shape=box,color=blue];
		1124 -> 1125;
	1125 [label="Gdzieś tam istnieje druga wersja ciebie. Wersja ciebie, która jednocześnie jest i nie jest tobą. Ty w formie dziecka, ale z innej rzeczywistości.",shape=box,color=blue];
		1125 -> 1126;
		1125 -> 1127;
	1126 [label="Nie do końca. To jest jest ich rzeczywistość. To ja jestem tu przybyszem.",shape=box,color=red];
		1126 -> 1128;
	1127 [label="Bardziej jakby nasze drogi się kiedyś rozeszły, ja skręciłem w lewo - oni w prawo.",shape=box,color=red];
		1127 -> 1129;
	1128 [label="Łał, zwolnij. Muszę się nad tym zastanowić.",shape=box,color=blue];
		1128 -> 1130;
	1129 [label="I zakładam, że jesteśmy w ICH rzeczywistości, nie twojej. Muszę... to przemyśleć.",shape=box,color=blue];
		1129 -> 1130;
	1130 [label="A więc... jesteś jakby gościem z odcinka wątku pobocznego, który dostał się do głównego serialu?",shape=box,color=blue];
		1130 -> 1131;
	1131 [label="Mniej więcej.",shape=box,color=red];
		1131 -> 1132;
	1132 [label="Aż zakręciło mi się w głowie. A co się stało z twoją wersją świata?",shape=box,color=blue];
		1132 -> 1133;
		1132 -> 1134;
		1132 -> 1135;
	1133 [label="Myślę, że jedyne co z niej zostało to statek-widmo, Zariman zatykający dziurę między wymiarami...?",shape=box,color=red];
		1133 -> 1136;
	1134 [label="Myślę, że cokolwiek z niej zostało, trafiło ze mną do Duviri.",shape=box,color=red];
		1134 -> 1137;
	1135 [label="Nie zastanawiam się nad tym. Chyba przepadła.",shape=box,color=red];
		1135 -> 1138;
	1136 [label="Check boolean EleanorHoldfasts1",color=orange];
		1136 -> 1139 [label=true,color=green];
		1136 -> 1140 [label=false,color=brown];
	1137 [label="Więc w pewnym stopniu nadal istnieje.",shape=box,color=blue];
		1137 -> 1145;
	1138 [label="Cały kosmos nie może po prostu PRZEPAŚĆ. To niedorzeczne. Musi gdzieś istnieć.",shape=box,color=blue];
		1138 -> 1146;
	1139 [label="Ach! Kryjówka twoich zaprzyjaźnionych duchów. Zatrzymanych.",shape=box,color=blue];
		1139 -> 1141;
	1140 [label="Przepraszam, to brzmi naprawdę fascynująco, ale nie mam pojęcia, o czym mówisz.",shape=box,color=blue];
		1140 -> 1142;
	1145 [label="Nie wiem, czy jakkolwiek to pomaga.",shape=box,color=blue];
		1145 -> 1147;
	1146 [label="Jest możliwe, ale jak mówiłem, nie zastanawiam się nad tym.",shape=box,color=red];
		1146 -> 1148;
	1141 [label="Nie wyobrażam sobie, żeby było to miejsce, do którego wracasz na nostalgiczny spacer.",shape=box,color=blue];
		1141 -> 1143;
	1142 [label="Statek widmo?",shape=box,color=blue];
		1142 -> 1144;
	1147 [label="Nauczyłem się, że dom i rodzina to bardziej kwestia tego, gdzie i z kim się dobrze czujesz.",shape=box,color=red];
		1147 -> 1149;
	1148 [label="Ale to twój DOM. Nie chcesz tam wrócić?",shape=box,color=blue];
		1148 -> 1150;
	1143 [label="Nie jestem w stanie pojąć, co straciłeś.",shape=box,color=blue];
		1143 -> 1151;
	1144 [label="Dziura między wymiarami?",shape=box,color=blue];
		1144 -> 1152;
	1149 [label="A nie tego, gdzie i w jakiej rodzinie się urodziłeś.",shape=box,color=red];
		1149 -> 1157;
	1150 [label="To naprawdę nie jest już mój dom.",shape=box,color=red];
		1150 -> 1158;
	1151 [label="Nie myślę o tym w ten sposób.",shape=box,color=red];
		1151 -> 1153;
	1152 [label="Zariman był statkiem kolonizacyjnym. Miał dotrzeć do Tau, ale nigdy nie osiągnął celu.",shape=box,color=red];
		1152 -> 1154;
	1157 [label="Staram się nie myśleć o tym, co straciliśmy. Zamiast tego skupiam się na tym, co mam. Jak to miejsce. Jak was wszystkich. Bo...",shape=box,color=red];
		1157 -> 1159;
	1158 [label="Nazywają mnie \"Włóczęgą\" nie bez powodu.",shape=box,color=red];
		1158 -> 1159;
	1153 [label="Wydostałem się. Przeżyłem. To szalone szczęście.",shape=box,color=red];
		1153 -> 1155;
	1154 [label="Statek skończył w Pustce, a coś, co tam istniało zdecydowało się zamienić ten statek w piekło.",shape=box,color=red];
		1154 -> 1156;
	1159 [label="Ze wszystkich miejsc, jakie odwiedziłem, czuję, że właśnie tutaj jest mój dom.",shape=box,color=red];
		1159 -> 1171;
	1155 [label="Szczerze, szanse istnienia każdego z nas są prawie zerowe. To kolejny cud.",shape=box,color=red];
		1155 -> 1160;
	1156 [label="Dryfował tam i z powrotem między Pustką i rzeczywistością, a teraz utknął pomiędzy.",shape=box,color=red];
		1156 -> 1161;
	1171 [label="Huh. Aż jestem z tego dumna.",shape=box,color=blue];
		1171 -> 1172;
	1160 [label="Nie skupiaj się na tym, co przeminęło. Ciesz się tym, co mamy.",shape=box,color=red];
		1160 -> 1170;
	1161 [label="To w sumie nie jest też jeden statek. Zariman to... wiele statków jednocześnie.",shape=box,color=red];
		1161 -> 1162;
	1172 [label="Może po prostu potrzebowałeś towarzystwa super-zabójczych komandosów w miejskim stylu.",shape=box,color=blue];
		1172 -> 1173;
	1170 [label="Na przykład? Jestem teraz tutaj, z wami wszystkimi. To pierwsze miejsce, w którym pierwszy raz czuję się jak w domu.",shape=box,color=red];
		1170 -> 1171;
	1162 [label="Update boolean EleanorHoldfasts1",color=orange];
		1162 -> 1163;
