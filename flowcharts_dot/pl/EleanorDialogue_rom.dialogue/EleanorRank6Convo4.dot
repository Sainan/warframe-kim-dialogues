	3038 [label="+20 Chemistry",color=orange];
		3038 -> 3044;
	3039 [label="Światło na życzenie! Wolność od wielkich świateł na niebie!",shape=box,color=blue];
		3039 -> 3045;
	3040 [label="Wyobraź sobie, że jesteś aroganckim księdzem, wyruszającym na misję szerzyć słowo Sol \"dzikusom\" z nowego świata i odkrywasz, że nie tylko znają już Sol, ale włada nimi także syn Sol.",shape=box,color=blue];
		3040 -> 3046;
	3041 [label="Nie mam pojęcia.",shape=box,color=red];
		3041 -> 3047;
	3042 [label="Szczerze, nie.",shape=box,color=red];
		3042 -> 3048;
	3043 [label="Tak, chciałbym.",shape=box,color=red];
		3043 -> 3049;
	3044 [label="okej. Cokolwiek zrobisz dzisiaj, czy jesteś ze mną czy Arturem czy kimkolwiek innym... dbaj o siebie.",shape=box,color=blue];
		3044 -> 3050;
	3045 [label="Spójrz na nas. Światła są wszędzie. Straciły wartość.",shape=box,color=blue];
		3045 -> 3003;
	3046 [label="Pobiegłbyś z powrotem do domu z podkulonym ogonem albo nawrócił się na miejscu.",shape=box,color=blue];
		3046 -> 3051;
		3046 -> 3052;
	3047 [label="Rozumiem i szanuję to.",shape=box,color=blue];
		3047 -> 3057;
	3048 [label="Cieszy mnie to. Jeśli myślisz, że twoje życie mogłoby być gorsze niż jest, chyba mamy co świętować?",shape=box,color=blue];
		3048 -> 3057;
	3049 [label="Chyba to rozumiem. Przegapiłeś wspaniałą okazję, prawda?",shape=box,color=blue];
		3049 -> 3057;
