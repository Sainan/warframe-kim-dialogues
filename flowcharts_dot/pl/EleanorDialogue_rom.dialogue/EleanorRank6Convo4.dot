	3060 [label="W miejscu tej pewności istnieje teraz dziura w kształcie Włóczęgi.",shape=box,color=blue];
		3060 -> 3063;
	3061 [label="Wszystkich nas zdobią blizny, kochany. ",shape=box,color=blue];
