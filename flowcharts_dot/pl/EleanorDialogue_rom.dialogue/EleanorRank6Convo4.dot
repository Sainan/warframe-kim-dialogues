digraph {
	2968 [label="EleanorRank6Convo4 begins.",color=orange];
		2968 -> 2969;
	2969 [label="Czy zdarzyło ci się kiedyś brać prysznic i usłyszeć głosik zadający ci pytanie, którego nigdy wcześniej sobie nie zadałeś?",shape=box,color=blue];
		2969 -> 2970;
		2969 -> 2971;
		2969 -> 2972;
	2970 [label="Nie, raczej nie. [Koniec]",shape=box,color=red];
		2970 -> 2973;
	2971 [label="Jak ’Co myśleli ludzie na Ziemi, kiedy Lua nagle znów pojawiła się na niebie?’",shape=box,color=red];
		2971 -> 2974;
	2972 [label="Masz na myśli coś jak ’Operatorze! Mógłbyś rozważyć wypchanie swojego Kubrowa?’ ",shape=box,color=red];
		2972 -> 2975;
	2973 [label="Chat ends.",color=orange];
	2974 [label="Tak, dokładnie tak.",shape=box,color=blue];
		2974 -> 2976;
	2975 [label="To Ordis. On tak ma.",shape=box,color=red];
		2975 -> 2977;
	2976 [label="chwila",shape=box,color=blue];
		2976 -> 2978;
	2977 [label="Święć Sol nad jego duszą. Ale chodzi mi o wewnętrzny głos.",shape=box,color=blue];
		2977 -> 2979;
	2978 [label="Lua zniknęła?",shape=box,color=blue];
		2978 -> 2980;
	2979 [label="Jakby część mózgu próbowała znaleźć sobie zajęcie, kiedy jesteś oddany higienie osobistej.",shape=box,color=blue];
		2979 -> 2981;
	2980 [label="Na jak długo? Gdzie się podziała? Co się stało z przypływami?",shape=box,color=blue];
		2980 -> 2982;
		2980 -> 2983;
	2981 [label="Wciąż mnie nachodzą. Zaskakująco losowe. Tak bardzo, że zaczęłam się zastanawiać, czy na pewno są moje. ",shape=box,color=blue];
		2981 -> 2984;
	2982 [label="W kolejności: nie wiem, Pustka, nie wiem.",shape=box,color=red];
		2982 -> 2985;
	2983 [label="Lotus ukryła ją w Pustce pod koniec Starej Wojny. Dzieciak sprowadził ją z powrotem całkiem niedawno.",shape=box,color=red];
		2983 -> 2986;
	2984 [label="Niektóre z nich zachowałam na płótnie.",shape=box,color=blue];
		2984 -> 2985;
	2985 [label="nieważne, wrócimy do tego później.",shape=box,color=blue];
		2985 -> 2987;
	2986 [label="Nie mam pojęcia, co się stało z przypływami.",shape=box,color=red];
		2986 -> 2988;
	2987 [label="Więc, losowe przemyślenia pod prysznicem. Dzisiaj rano natrafiłam na absolutnego hita.",shape=box,color=blue];
		2987 -> 2989;
	2988 [label="Jak Lotus zdołała schować cały KSIĘŻYC?",shape=box,color=blue];
		2988 -> 2985;
	2989 [label="Brzmiał ’hej, co jeśli Bogowie istnieją?’",shape=box,color=blue];
		2989 -> 2990;
	2990 [label="Zasłabłam na chwilę. Musiałam ochlapać się zimną wodą, żeby się otrząsnąć.",shape=box,color=blue];
		2990 -> 2991;
		2990 -> 2992;
		2990 -> 2993;
	2991 [label="Co w tym dziwnego? Brzmi jak normalne pytanie.",shape=box,color=red];
		2991 -> 2994;
	2992 [label="… ludzie nie uważają Bogów za prawdziwych? Jestem prawie pewien, że Lettie jest tego pewna.",shape=box,color=red];
		2992 -> 2995;
	2993 [label="Tak, co za okropna myśl.",shape=box,color=red];
		2993 -> 2996;
	2994 [label="Ach, dlatego właśnie uwielbiam rozmawiać z tobą o takich rzeczach",shape=box,color=blue];
		2994 -> 2997;
	2995 [label="No weź. Nikt tak naprawdę nie myśli, że Bogowie są prawdziwi. Na pewno nie w taki sam sposób jak, nie wiem, krzesła i stoły.",shape=box,color=blue];
		2995 -> 2998;
	2996 [label="Nieprawdaż? Co, jeśli za każdym razem, kiedy myślałeś, że wszechświat przesyła ci wiadomość, rzeczywiście tak było?",shape=box,color=blue];
		2996 -> 2999;
	2997 [label="Twoje życie jest tak fantastycznie absurdalne, że nawet możliwość istnienia Bogów wzrusza cię tak bardzo jak porównywanie dodatków do pizzy",shape=box,color=blue];
		2997 -> 3000;
	2998 [label="Prawdziwi Bogowie, jak studnie i sławojki. Są czymś, co ISTNIAŁO w życiach ludzi. ",shape=box,color=blue];
		2998 -> 3001;
	2999 [label="Wyobraź sobie, że wszystko leży w rękach tych wrednych, nieśmiertelnych drani, którzy rządzą tylko dlatego, bo taka jest natura rzeczy, nie dlatego, że zasłużyli",shape=box,color=blue];
		2999 -> 3002;
	3000 [label="Mogłeś nawet spotkać Boga. Jeśli tym jest Obojętność.",shape=box,color=blue];
		3000 -> 3003;
	3001 [label="Dzisiaj są tylko symbolami, metaforami, takimi bzdurami.",shape=box,color=blue];
		3001 -> 3004;
		3001 -> 3005;
	3002 [label="I szalone jest to, że ludzie tak po prostu byli. Tak wyglądał ich świat, każdy dzień ich życia.",shape=box,color=blue];
		3002 -> 3006;
	3003 [label="Przypomniałaś mi o czymś, co stało się na Zarimanie. O moim pierwszym spotkaniu z Obojętnością.",shape=box,color=red];
		3003 -> 3007;
	3004 [label="Może ludzie po prostu boją się mniej?",shape=box,color=red];
		3004 -> 3008;
	3005 [label="Myślałem, że Sol i Lua są twoimi Bogami.",shape=box,color=red];
		3005 -> 3009;
	3006 [label="Dla nich Bogowie byli równie realni co pogoda i byli nimi równie przejęci.",shape=box,color=blue];
		3006 -> 3010;
	3007 [label="Wtedy oczywiście nie wiedziałem, czym jest, ale pamiętam, co powiedziała. ",shape=box,color=red];
		3007 -> 3011;
	3008 [label="Może o to chodzić, tak. ",shape=box,color=blue];
		3008 -> 3012;
	3009 [label="Tak, są. Ale są także ciałami niebieskimi. ",shape=box,color=blue];
		3009 -> 3013;
	3010 [label="Szczerze, to nie różni się od życia pod władzą Orokin.",shape=box,color=red];
		3010 -> 3014;
	3011 [label="Powiedziałem, że może wziąć moje światło. Uśmiechnęła się i powiedziała \"Dzięki, dzieciaku. Tak zrobię.\"",shape=box,color=red];
		3011 -> 3015;
	3012 [label="I myślę, że wiem też dlaczego.",shape=box,color=blue];
		3012 -> 3016;
	3013 [label="Tak jak Brytania to kraj, z nazwą, tożsamością, takimi tam, ale to też po prostu kupa kamieni i ziemi. To i to jest prawdą.",shape=box,color=blue];
		3013 -> 3017;
	3014 [label="Nieśmiertelni, aroganccy, rządzą, bo już rządzili...",shape=box,color=red];
		3014 -> 3018;
	3015 [label="Aż mnie ciarki przeszły",shape=box,color=blue];
		3015 -> 3019;
	3016 [label="Chodzi o światło.",shape=box,color=blue];
		3016 -> 3020;
	3017 [label="Możesz wyjść w piękny słoneczny dzień, pełen wdzięczności spojrzeć na Sol i powiedzieć \"dziękuję!\" z pełną powagą. To ludzka rzecz.",shape=box,color=blue];
		3017 -> 3021;
	3018 [label="Tak. Wy MIELIŚCIE żywych Bogów. I zabiliście ich wszystkich.",shape=box,color=blue];
		3018 -> 3022;
	3019 [label="Diabeł kocha się w szczegółach, uwielbia bawić się literą i duchem prawa, niczym w starych baśniach",shape=box,color=blue];
		3019 -> 3023;
	3020 [label="Czym są Sol i Lua? Zanim ludzie zaczęli pojmować ich jako Bogów? Byli ŚWIATŁEM.",shape=box,color=blue];
		3020 -> 3024;
		3020 -> 3025;
	3021 [label="Ale dzisiaj nikt nie myśli, że Sol i Lua dosłownie sprawili, że kobieta zaszła w ciążę albo wychowali dzieciaka, który stał się królem.",shape=box,color=blue];
		3021 -> 3026;
	3022 [label="(Nie zrozum mnie źle, bardzo mi się to w tobie podoba.)",shape=box,color=blue];
		3022 -> 3027;
	3023 [label="Myślisz, że uważa, że coś jej obiecałeś? Swoje 'światło'?",shape=box,color=blue];
		3023 -> 3028;
		3023 -> 3029;
	3024 [label="Tak. Światło symbolizuje dobro, gdziekolwiek nie pójdziesz.",shape=box,color=red];
		3024 -> 3030;
	3025 [label="Jedyne światła, jakie miała ludzkość, przez bardzo, bardzo długi czas.",shape=box,color=red];
		3025 -> 3030;
	3026 [label="Ludzie kiedyś w to wierzyli. Teraz opowiadamy to jako legendy. Wyrośliśmy z nich.",shape=box,color=blue];
		3026 -> 3031;
		3026 -> 3032;
	3027 [label="Mylisz mnie z dzieciakiem. Nigdy nie wziąłem udziału w wielkim powstaniu Tenno.",shape=box,color=red];
		3027 -> 3033;
	3028 [label="Powiedziała, że \"umowa stoi\". Myśli więc chyba, że jestem coś winien.",shape=box,color=red];
		3028 -> 3034;
	3029 [label="Chodziło mi o iluminator, który trzymałem, ale kto wie co to miało na myśli.",shape=box,color=red];
		3029 -> 3034;
	3030 [label="TAK.",shape=box,color=blue];
		3030 -> 3035;
	3031 [label="Bogowie i ludzie... razem?",shape=box,color=red];
		3031 -> 3036;
	3032 [label="Królowie zrodzeni przez Bogów? A to Orokin uważałem za dupków.",shape=box,color=red];
		3032 -> 3036;
	3033 [label="Nigdy nie dołączyłem do programu Specjalnych Dzieci Margulis, nigdy nie otrzymałem Warframe'a, nie walczyłem za Starej Wojny.",shape=box,color=red];
		3033 -> 3037;
	3034 [label="Ale jednego jestem pewien. Lubi pogrywać w gierki.",shape=box,color=red];
		3034 -> 3038;
	3035 [label="Ale potem jakiś jaskiniowy kujon, nad którym prawdopodobnie znęcały się wszystkie starsze jaskiniowe dziewczynki, uderzył kamieniem o kamień i ta-da.",shape=box,color=blue];
		3035 -> 3039;
	3036 [label="Takich opowieści są krocie, z całego świata.",shape=box,color=blue];
		3036 -> 3040;
	3037 [label="... a chciałbyś?",shape=box,color=blue];
		3037 -> 3041;
		3037 -> 3042;
