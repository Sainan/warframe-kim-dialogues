digraph {
	"EleanorRank6Convo4 begins." [color=orange];
		"EleanorRank6Convo4 begins." -> j1765930245;
	j1765930245 [label="Czy zdarzyło ci się kiedyś brać prysznic i usłyszeć głosik zadający ci pytanie, którego nigdy wcześniej sobie nie zadałeś?",shape=box,color=blue];
		j1765930245 -> j2514921692;
