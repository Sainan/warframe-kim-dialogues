	j1453726218 [label="Kocham cię. Jeśli jakikolwiek Bóg spróbuje stanąć mi na drodze, lepiej żeby miał swoich Bogów, do których mógłby się modlić.",shape=box,color=blue];
		j1453726218 -> "Chat ends.";
	j2859022100 [label="Jesteś moim przyjacielem. Jeśli jakikolwiek Bóg spróbuje ciebie odebrać, jego rzeczywistość zostanie boleśnie wystawiona na próbę.",shape=box,color=blue];
		j2859022100 -> "Chat ends.";
