		j1765930245 -> j4107070878;
	j2514921692 [label="Nie, raczej nie. [Koniec]",shape=box,color=red];
		j2514921692 -> "Chat ends.";
	j136979315 [label="Jak ’Co myśleli ludzie na Ziemi, kiedy Lua nagle znów pojawiła się na niebie?’",shape=box,color=red];
		j136979315 -> j1672446502;
	j4107070878 [label="Masz na myśli coś jak ’Operatorze! Mógłbyś rozważyć wypchanie swojego Kubrowa?’ ",shape=box,color=red];
		j4107070878 -> j2245689962;
	"Chat ends." [color=orange];
	j1672446502 [label="Tak, dokładnie tak.",shape=box,color=blue];
		j1672446502 -> j1727009937;
	j2245689962 [label="To Ordis. On tak ma.",shape=box,color=red];
		j2245689962 -> j3025655589;
	j1727009937 [label="chwila",shape=box,color=blue];
		j1727009937 -> j2136478218;
	j3025655589 [label="Święć Sol nad jego duszą. Ale chodzi mi o wewnętrzny głos.",shape=box,color=blue];
		j3025655589 -> j2295074731;
	j2136478218 [label="Lua zniknęła?",shape=box,color=blue];
		j2136478218 -> j3703250910;
	j2295074731 [label="Jakby część mózgu próbowała znaleźć sobie zajęcie, kiedy jesteś oddany higienie osobistej.",shape=box,color=blue];
		j2295074731 -> j4173554497;
	j3703250910 [label="Na jak długo? Gdzie się podziała? Co się stało z przypływami?",shape=box,color=blue];
		j3703250910 -> j132778739;
		j3703250910 -> j1440982797;
	j4173554497 [label="Wciąż mnie nachodzą. Zaskakująco losowe. Tak bardzo, że zaczęłam się zastanawiać, czy na pewno są moje. ",shape=box,color=blue];
		j4173554497 -> j548817854;
	j132778739 [label="W kolejności: nie wiem, Pustka, nie wiem.",shape=box,color=red];
		j132778739 -> j3555588718;
	j1440982797 [label="Lotus ukryła ją w Pustce pod koniec Starej Wojny. Dzieciak sprowadził ją z powrotem całkiem niedawno.",shape=box,color=red];
		j1440982797 -> j1062314694;
	j548817854 [label="Niektóre z nich zachowałam na płótnie.",shape=box,color=blue];
		j548817854 -> j3555588718;
	j3555588718 [label="nieważne, wrócimy do tego później.",shape=box,color=blue];
		j3555588718 -> j1177820224;
	j1062314694 [label="Nie mam pojęcia, co się stało z przypływami.",shape=box,color=red];
		j1062314694 -> j38184466;
	j1177820224 [label="Więc, losowe przemyślenia pod prysznicem. Dzisiaj rano natrafiłam na absolutnego hita.",shape=box,color=blue];
		j1177820224 -> j707897499;
	j38184466 [label="Jak Lotus zdołała schować cały KSIĘŻYC?",shape=box,color=blue];
		j38184466 -> j3555588718;
	j707897499 [label="Brzmiał ’hej, co jeśli Bogowie istnieją?’",shape=box,color=blue];
		j707897499 -> j1730561409;
	j1730561409 [label="Zasłabłam na chwilę. Musiałam ochlapać się zimną wodą, żeby się otrząsnąć.",shape=box,color=blue];
		j1730561409 -> j3750688780;
		j1730561409 -> j4280159658;
		j1730561409 -> j3435188257;
	j3750688780 [label="Co w tym dziwnego? Brzmi jak normalne pytanie.",shape=box,color=red];
		j3750688780 -> j2846564689;
	j4280159658 [label="… ludzie nie uważają Bogów za prawdziwych? Jestem prawie pewien, że Lettie jest tego pewna.",shape=box,color=red];
		j4280159658 -> j2172007411;
	j3435188257 [label="Tak, co za okropna myśl.",shape=box,color=red];
		j3435188257 -> j1864712098;
	j2846564689 [label="Ach, dlatego właśnie uwielbiam rozmawiać z tobą o takich rzeczach",shape=box,color=blue];
		j2846564689 -> j3668275209;
	j2172007411 [label="No weź. Nikt tak naprawdę nie myśli, że Bogowie są prawdziwi. Na pewno nie w taki sam sposób jak, nie wiem, krzesła i stoły.",shape=box,color=blue];
		j2172007411 -> j1235866945;
	j1864712098 [label="Nieprawdaż? Co, jeśli za każdym razem, kiedy myślałeś, że wszechświat przesyła ci wiadomość, rzeczywiście tak było?",shape=box,color=blue];
		j1864712098 -> j149137309;
	j3668275209 [label="Twoje życie jest tak fantastycznie absurdalne, że nawet możliwość istnienia Bogów wzrusza cię tak bardzo jak porównywanie dodatków do pizzy",shape=box,color=blue];
		j3668275209 -> j1976907759;
	j1235866945 [label="Prawdziwi Bogowie, jak studnie i sławojki. Są czymś, co ISTNIAŁO w życiach ludzi. ",shape=box,color=blue];
		j1235866945 -> j1484956498;
	j149137309 [label="Wyobraź sobie, że wszystko leży w rękach tych wrednych, nieśmiertelnych drani, którzy rządzą tylko dlatego, bo taka jest natura rzeczy, nie dlatego, że zasłużyli",shape=box,color=blue];
		j149137309 -> j1272947328;
	j1976907759 [label="Mogłeś nawet spotkać Boga. Jeśli tym jest Obojętność.",shape=box,color=blue];
		j1976907759 -> j399175247;
	j1484956498 [label="Dzisiaj są tylko symbolami, metaforami, takimi bzdurami.",shape=box,color=blue];
		j1484956498 -> j2892071657;
		j1484956498 -> j1368299524;
	j1272947328 [label="I szalone jest to, że ludzie tak po prostu byli. Tak wyglądał ich świat, każdy dzień ich życia.",shape=box,color=blue];
		j1272947328 -> j2607500922;
	j399175247 [label="Przypomniałaś mi o czymś, co stało się na Zarimanie. O moim pierwszym spotkaniu z Obojętnością.",shape=box,color=red];
		j399175247 -> j2905576111;
	j2892071657 [label="Może ludzie po prostu boją się mniej?",shape=box,color=red];
		j2892071657 -> j3599790301;
	j1368299524 [label="Myślałem, że Sol i Lua są twoimi Bogami.",shape=box,color=red];
		j1368299524 -> j1264920814;
	j2607500922 [label="Dla nich Bogowie byli równie realni co pogoda i byli nimi równie przejęci.",shape=box,color=blue];
		j2607500922 -> j1927957090;
	j2905576111 [label="Wtedy oczywiście nie wiedziałem, czym jest, ale pamiętam, co powiedziała. ",shape=box,color=red];
		j2905576111 -> j758090732;
	j3599790301 [label="Może o to chodzić, tak. ",shape=box,color=blue];
		j3599790301 -> j172139333;
	j1264920814 [label="Tak, są. Ale są także ciałami niebieskimi. ",shape=box,color=blue];
		j1264920814 -> j2461833787;
	j1927957090 [label="Szczerze, to nie różni się od życia pod władzą Orokin.",shape=box,color=red];
		j1927957090 -> j610317354;
	j758090732 [label="Powiedziałem, że może wziąć moje światło. Uśmiechnęła się i powiedziała \"Dzięki, dzieciaku. Tak zrobię.\"",shape=box,color=red];
		j758090732 -> j1647071807;
	j172139333 [label="I myślę, że wiem też dlaczego.",shape=box,color=blue];
		j172139333 -> j1303309593;
	j2461833787 [label="Tak jak Brytania to kraj, z nazwą, tożsamością, takimi tam, ale to też po prostu kupa kamieni i ziemi. To i to jest prawdą.",shape=box,color=blue];
		j2461833787 -> j837699136;
	j610317354 [label="Nieśmiertelni, aroganccy, rządzą, bo już rządzili...",shape=box,color=red];
		j610317354 -> j3848323437;
	j1647071807 [label="Aż mnie ciarki przeszły",shape=box,color=blue];
		j1647071807 -> j1196709256;
	j1303309593 [label="Chodzi o światło.",shape=box,color=blue];
		j1303309593 -> j3321558493;
	j837699136 [label="Możesz wyjść w piękny słoneczny dzień, pełen wdzięczności spojrzeć na Sol i powiedzieć \"dziękuję!\" z pełną powagą. To ludzka rzecz.",shape=box,color=blue];
		j837699136 -> j1029612694;
	j3848323437 [label="Tak. Wy MIELIŚCIE żywych Bogów. I zabiliście ich wszystkich.",shape=box,color=blue];
		j3848323437 -> j2198773522;
	j1196709256 [label="Diabeł kocha się w szczegółach, uwielbia bawić się literą i duchem prawa, niczym w starych baśniach",shape=box,color=blue];
		j1196709256 -> j3882436242;
	j3321558493 [label="Czym są Sol i Lua? Zanim ludzie zaczęli pojmować ich jako Bogów? Byli ŚWIATŁEM.",shape=box,color=blue];
		j3321558493 -> j1713221151;
		j3321558493 -> j3472328979;
	j1029612694 [label="Ale dzisiaj nikt nie myśli, że Sol i Lua dosłownie sprawili, że kobieta zaszła w ciążę albo wychowali dzieciaka, który stał się królem.",shape=box,color=blue];
		j1029612694 -> j3485013052;
	j2198773522 [label="(Nie zrozum mnie źle, bardzo mi się to w tobie podoba.)",shape=box,color=blue];
		j2198773522 -> j856690861;
	j3882436242 [label="Myślisz, że uważa, że coś jej obiecałeś? Swoje 'światło'?",shape=box,color=blue];
		j3882436242 -> j1593753449;
		j3882436242 -> j2269257853;
	j1713221151 [label="Tak. Światło symbolizuje dobro, gdziekolwiek nie pójdziesz.",shape=box,color=red];
		j1713221151 -> j56187703;
	j3472328979 [label="Jedyne światła, jakie miała ludzkość, przez bardzo, bardzo długi czas.",shape=box,color=red];
		j3472328979 -> j56187703;
	j3485013052 [label="Ludzie kiedyś w to wierzyli. Teraz opowiadamy to jako legendy. Wyrośliśmy z nich.",shape=box,color=blue];
		j3485013052 -> j1587994036;
		j3485013052 -> j2335752147;
	j856690861 [label="Mylisz mnie z dzieciakiem. Nigdy nie wziąłem udziału w wielkim powstaniu Tenno.",shape=box,color=red];
		j856690861 -> j852427888;
	j1593753449 [label="Powiedziała, że \"umowa stoi\". Myśli więc chyba, że jestem coś winien.",shape=box,color=red];
		j1593753449 -> j3868689279;
	j2269257853 [label="Chodziło mi o iluminator, który trzymałem, ale kto wie co to miało na myśli.",shape=box,color=red];
		j2269257853 -> j3868689279;
	j56187703 [label="TAK.",shape=box,color=blue];
		j56187703 -> j748071202;
	j1587994036 [label="Bogowie i ludzie... razem?",shape=box,color=red];
		j1587994036 -> j4089984758;
	j2335752147 [label="Królowie zrodzeni przez Bogów? A to Orokin uważałem za dupków.",shape=box,color=red];
		j2335752147 -> j4089984758;
	j852427888 [label="Nigdy nie dołączyłem do programu Specjalnych Dzieci Margulis, nigdy nie otrzymałem Warframe'a, nie walczyłem za Starej Wojny.",shape=box,color=red];
		j852427888 -> j628611142;
	j3868689279 [label="Ale jednego jestem pewien. Lubi pogrywać w gierki.",shape=box,color=red];
		j3868689279 -> j3401663000;
	j748071202 [label="Ale potem jakiś jaskiniowy kujon, nad którym prawdopodobnie znęcały się wszystkie starsze jaskiniowe dziewczynki, uderzył kamieniem o kamień i ta-da.",shape=box,color=blue];
		j748071202 -> j4009450450;
	j4089984758 [label="Takich opowieści są krocie, z całego świata.",shape=box,color=blue];
		j4089984758 -> j1809818435;
	j628611142 [label="... a chciałbyś?",shape=box,color=blue];
		j628611142 -> j2613091623;
