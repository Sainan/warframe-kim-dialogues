		j628611142 -> j147363275;
	j3401663000 [label="+20 Chemistry",color=orange];
		j3401663000 -> j1058527015;
	j4009450450 [label="Światło na życzenie! Wolność od wielkich świateł na niebie!",shape=box,color=blue];
		j4009450450 -> j3180801573;
	j1809818435 [label="Wyobraź sobie, że jesteś aroganckim księdzem, wyruszającym na misję szerzyć słowo Sol \"dzikusom\" z nowego świata i odkrywasz, że nie tylko znają już Sol, ale włada nimi także syn Sol.",shape=box,color=blue];
		j1809818435 -> j2277180251;
	j2613091623 [label="Nie mam pojęcia.",shape=box,color=red];
		j2613091623 -> j795780127;
	j2511857770 [label="Szczerze, nie.",shape=box,color=red];
		j2511857770 -> j3671420758;
	j147363275 [label="Tak, chciałbym.",shape=box,color=red];
		j147363275 -> j843364795;
	j1058527015 [label="okej. Cokolwiek zrobisz dzisiaj, czy jesteś ze mną czy Arturem czy kimkolwiek innym... dbaj o siebie.",shape=box,color=blue];
		j1058527015 -> j3435349021;
	j3180801573 [label="Spójrz na nas. Światła są wszędzie. Straciły wartość.",shape=box,color=blue];
		j3180801573 -> j399175247;
	j2277180251 [label="Pobiegłbyś z powrotem do domu z podkulonym ogonem albo nawrócił się na miejscu.",shape=box,color=blue];
		j2277180251 -> j778913677;
		j2277180251 -> j2688388768;
