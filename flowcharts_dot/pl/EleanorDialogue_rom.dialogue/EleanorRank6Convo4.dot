		3054 -> 3058;
	3055 [label="Jesteś moim przyjacielem. Jeśli jakikolwiek Bóg spróbuje ciebie odebrać, jego rzeczywistość zostanie boleśnie wystawiona na próbę.",shape=box,color=blue];
		3055 -> 3059;
	3056 [label="Uznajmy, że byłam w przeszłości bardziej pewna tej nudnej, materialnej rzeczywistości.",shape=box,color=blue];
