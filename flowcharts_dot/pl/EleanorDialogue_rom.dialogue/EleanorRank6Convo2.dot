digraph {
	2845 [label="EleanorRank6Convo2 begins.",color=orange];
		2845 -> 2846;
	2846 [label="Hej, potrzebuję głośno pomyśleć.",shape=box,color=blue];
		2846 -> 2847;
	2847 [label="Myślałam o Nocy Mar. Nie przebierałam się od lat, ale kiedy przeglądałam komiksy Amira naszła mnie myśl - mogłabym być Contessą! Mam kły i całą resztę!",shape=box,color=blue];
		2847 -> 2848;
	2848 [label="Czy to zbyt oczywiste? Może powinnam przebrać się za Dandy'ego Damage?",shape=box,color=blue];
		2848 -> 2849;
		2848 -> 2850;
		2848 -> 2851;
	2849 [label="Kim jest Dandy Damage?",shape=box,color=red];
		2849 -> 2852;
	2850 [label="Zawsze możesz przebrać się za Lotus, jeśli chcesz namieszać ludziom w głowach.",shape=box,color=red];
		2850 -> 2853;
	2851 [label="… musisz mi wyjaśnić, czym jest Noc Mar.",shape=box,color=red];
		2851 -> 2854;
	2852 [label="O chłopie. ",shape=box,color=blue];
		2852 -> 2855;
	2853 [label="Na Bogów, nie. Widziałam, jak wygląda. Nie byłabym zdolna jej przedstawić.",shape=box,color=blue];
		2853 -> 2856;
	2854 [label="Czasami zapominam, że jesteś niewinnym przybyszem. ",shape=box,color=blue];
		2854 -> 2857;
	2855 [label="Dandy Damage zbudował fundamenty, na których stanął Temple i jego Ripperzy. Był koszmarem każdej matki i marzeniem każdej nastolatki.",shape=box,color=blue];
		2855 -> 2858;
	2856 [label="I ten hełm. Czy to hełm? Czy to część jej ciała? Jak ona w nim cokolwiek widzi?",shape=box,color=blue];
		2856 -> 2859;
	2857 [label="Noc Mar to święto zaniku wpływu Sol na świat.",shape=box,color=blue];
		2857 -> 2860;
	2858 [label="Zbudowany jak patyczak, w makijażu jak królowa niemego filmu. Usta jak cukierki. Prążki, skóra i psia obroża. Miał policzki jak biodra szkieletu.",shape=box,color=blue];
		2858 -> 2861;
		2858 -> 2862;
	2859 [label="W każdym razie, trzy z nich istnieją w jednym ciele. Nigdy nie byłabym zdolna wybrać tylko jednej z nich.",shape=box,color=blue];
		2859 -> 2861;
		2859 -> 2862;
	2860 [label="Co w sumie nie ma za wiele sensu. Dlaczego świętujemy nadejście ciemności? Dlaczego cieszy nas bezprawie i anarchia?",shape=box,color=blue];
		2860 -> 2863;
	2861 [label="Przebieranie się? Impreza? W środku wojny? Naprawdę wierzysz, że to może się stać?",shape=box,color=red];
		2861 -> 2864;
	2862 [label="Wiesz, Noc Mar przypomina mi Naberusa. Ludzie też się przebierają z tej okazji.",shape=box,color=red];
		2862 -> 2864;
	2863 [label="Myślę, że to jak budowanie odporności. Odrobina strachu, abyśmy bali się mniej. A może to tylko wymówka, żeby założyć maskę diabła i zrobić bałagan.",shape=box,color=blue];
		2863 -> 2861;
		2863 -> 2862;
	2864 [label="... to chyba po prostu głupie pomysły. Dziecinada. Prawda?",shape=box,color=blue];
		2864 -> 2865;
	2865 [label="Ach, o czym ja mówię.",shape=box,color=blue];
		2865 -> 2866;
	2866 [label="Nie muszę się przebierać, prawda? Już teraz jestem potworem. I zawsze nim będę.",shape=box,color=blue];
		2866 -> 2867;
	2867 [label="Check boolean EleanorDating",color=orange];
		2867 -> 2868 [label=true,color=green];
		2867 -> 2869 [label=true,color=green];
		2867 -> 2870 [label=true,color=green];
		2867 -> 2869 [label=false,color=brown];
		2867 -> 2870 [label=false,color=brown];
	2868 [label="Eleanor, jesteś potworem, którego pokochałem. Nie żałuję niczego.",shape=box,color=red];
		2868 -> 2871;
	2869 [label="Zaczynam mieć wrażenie, że lubisz się tak nazywać.",shape=box,color=red];
		2869 -> 2872;
	2870 [label="Nie. Prawdziwe potwory nie dbają o ludzi tak jak ty.",shape=box,color=red];
		2870 -> 2873;
	2871 [label="+5 Chemistry",color=orange];
		2871 -> 2874;
	2872 [label="Jeśli naprawdę siebie tak postrzegasz, to Noc Mar jest idealną okazją, żeby to uczcić.",shape=box,color=red];
		2872 -> 2875;
		2872 -> 2873;
	2873 [label="Wiem, że boisz się tego, czym możesz się stać, ale to nie jesteś ty TERAZ.",shape=box,color=red];
		2873 -> 2876;
	2874 [label="Och tak! Głupiutka ja. Zapomniałam, że w naszej bajce potwór dostał szczęśliwe zakończenie.",shape=box,color=blue];
		2874 -> 2877;
	2875 [label="BĄDŹ potworem. Nie bój się tego. Przez tą jedną noc niech będzie to Twoim powodem do dumy.",shape=box,color=red];
		2875 -> 2878;
	2876 [label="Przebierz się i baw się dobrze. Na Pustkę, Hex potrzebuje trochę dobrej zabawy.",shape=box,color=red];
		2876 -> 2879;
	2877 [label="Wybacz mi, ale nadal nie mogę uwierzyć, że naprawdę tego CHCESZ. Może musisz mnie przekonać trochę bardziej.",shape=box,color=blue];
		2877 -> 2880;
	2878 [label="Och to OKROPNY POMYSŁ z BARDZO WIELU powodów",shape=box,color=blue];
		2878 -> 2881;
	2879 [label="Skorzystam z oferty. I dziękuję, jeszcze raz. x",shape=box,color=blue];
		2879 -> 2882;
	2880 [label="Pożryjmy się nawzajem później. xxx",shape=box,color=blue];
		2880 -> 2883;
	2881 [label="BARDZO. WIELU.",shape=box,color=blue];
		2881 -> 2884;
	2882 [label="Chat ends.",color=orange];
	2883 [label="Chat ends.",color=orange];
	2884 [label="(Żadne nie przychodzą mi teraz do głowy ale muszą być ich TUZINY)",shape=box,color=blue];
		2884 -> 2885;
	2885 [label="... cholera.",shape=box,color=blue];
		2885 -> 2886;
	2886 [label="zawodowo wykorzystałeś moje słowa przeciwko mnie. a niech cię. dobra robota. x",shape=box,color=blue];
		2886 -> 2887;
	2887 [label="Chat ends.",color=orange];
}