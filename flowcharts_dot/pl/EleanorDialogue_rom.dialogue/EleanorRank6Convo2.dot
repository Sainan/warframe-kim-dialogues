digraph {
	"EleanorRank6Convo2 begins." [color=orange];
		"EleanorRank6Convo2 begins." -> j2375155180;
	j2375155180 [label="Hej, potrzebuję głośno pomyśleć.",shape=box,color=blue];
		j2375155180 -> j2567192384;
	j2567192384 [label="Myślałam o Nocy Mar. Nie przebierałam się od lat, ale kiedy przeglądałam komiksy Amira naszła mnie myśl - mogłabym być Contessą! Mam kły i całą resztę!",shape=box,color=blue];
		j2567192384 -> j2301630916;
	j2301630916 [label="Czy to zbyt oczywiste? Może powinnam przebrać się za Dandy'ego Damage?",shape=box,color=blue];
		j2301630916 -> j1541675942;
		j2301630916 -> j235092113;
		j2301630916 -> j369999270;
	j1541675942 [label="Kim jest Dandy Damage?",shape=box,color=red];
		j1541675942 -> j3218447468;
	j235092113 [label="Zawsze możesz przebrać się za Lotus, jeśli chcesz namieszać ludziom w głowach.",shape=box,color=red];
		j235092113 -> j1661852917;
	j369999270 [label="… musisz mi wyjaśnić, czym jest Noc Mar.",shape=box,color=red];
		j369999270 -> j390522978;
	j3218447468 [label="O chłopie. ",shape=box,color=blue];
		j3218447468 -> j592439295;
	j1661852917 [label="Na Bogów, nie. Widziałam, jak wygląda. Nie byłabym zdolna jej przedstawić.",shape=box,color=blue];
		j1661852917 -> j2187486311;
	j390522978 [label="Czasami zapominam, że jesteś niewinnym przybyszem. ",shape=box,color=blue];
		j390522978 -> j2522748774;
	j592439295 [label="Dandy Damage zbudował fundamenty, na których stanął Temple i jego Ripperzy. Był koszmarem każdej matki i marzeniem każdej nastolatki.",shape=box,color=blue];
		j592439295 -> j1643000818;
	j2187486311 [label="I ten hełm. Czy to hełm? Czy to część jej ciała? Jak ona w nim cokolwiek widzi?",shape=box,color=blue];
		j2187486311 -> j327258883;
	j2522748774 [label="Noc Mar to święto zaniku wpływu Sol na świat.",shape=box,color=blue];
		j2522748774 -> j1821113894;
	j1643000818 [label="Zbudowany jak patyczak, w makijażu jak królowa niemego filmu. Usta jak cukierki. Prążki, skóra i psia obroża. Miał policzki jak biodra szkieletu.",shape=box,color=blue];
		j1643000818 -> j1494532504;
		j1643000818 -> j3920790995;
	j327258883 [label="W każdym razie, trzy z nich istnieją w jednym ciele. Nigdy nie byłabym zdolna wybrać tylko jednej z nich.",shape=box,color=blue];
		j327258883 -> j1494532504;
		j327258883 -> j3920790995;
	j1821113894 [label="Co w sumie nie ma za wiele sensu. Dlaczego świętujemy nadejście ciemności? Dlaczego cieszy nas bezprawie i anarchia?",shape=box,color=blue];
		j1821113894 -> j313282988;
	j1494532504 [label="Przebieranie się? Impreza? W środku wojny? Naprawdę wierzysz, że to może się stać?",shape=box,color=red];
		j1494532504 -> j850847943;
	j3920790995 [label="Wiesz, Noc Mar przypomina mi Naberusa. Ludzie też się przebierają z tej okazji.",shape=box,color=red];
		j3920790995 -> j850847943;
	j313282988 [label="Myślę, że to jak budowanie odporności. Odrobina strachu, abyśmy bali się mniej. A może to tylko wymówka, żeby założyć maskę diabła i zrobić bałagan.",shape=box,color=blue];
		j313282988 -> j1494532504;
		j313282988 -> j3920790995;
	j850847943 [label="... to chyba po prostu głupie pomysły. Dziecinada. Prawda?",shape=box,color=blue];
		j850847943 -> j4179793182;
	j4179793182 [label="Ach, o czym ja mówię.",shape=box,color=blue];
		j4179793182 -> j2096740510;
	j2096740510 [label="Nie muszę się przebierać, prawda? Już teraz jestem potworem. I zawsze nim będę.",shape=box,color=blue];
		j2096740510 -> j2436064064;
	j2436064064 [label="Check boolean EleanorDating",color=orange];
		j2436064064 -> j243813889 [label=true,color=green];
		j2436064064 -> j3620945305 [label=true,color=green];
		j2436064064 -> j3854065993 [label=true,color=green];
		j2436064064 -> j3620945305 [label=false,color=brown];
		j2436064064 -> j3854065993 [label=false,color=brown];
	j243813889 [label="Eleanor, jesteś potworem, którego pokochałem. Nie żałuję niczego.",shape=box,color=red];
		j243813889 -> j2717926180;
	j3620945305 [label="Zaczynam mieć wrażenie, że lubisz się tak nazywać.",shape=box,color=red];
		j3620945305 -> j2378646256;
	j3854065993 [label="Nie. Prawdziwe potwory nie dbają o ludzi tak jak ty.",shape=box,color=red];
		j3854065993 -> j2462705073;
	j2717926180 [label="+5 Chemistry",color=orange];
		j2717926180 -> j3329178611;
	j2378646256 [label="Jeśli naprawdę siebie tak postrzegasz, to Noc Mar jest idealną okazją, żeby to uczcić.",shape=box,color=red];
		j2378646256 -> j1663716878;
		j2378646256 -> j2462705073;
	j2462705073 [label="Wiem, że boisz się tego, czym możesz się stać, ale to nie jesteś ty TERAZ.",shape=box,color=red];
		j2462705073 -> j817067468;
	j3329178611 [label="Och tak! Głupiutka ja. Zapomniałam, że w naszej bajce potwór dostał szczęśliwe zakończenie.",shape=box,color=blue];
		j3329178611 -> j2574743429;
	j1663716878 [label="BĄDŹ potworem. Nie bój się tego. Przez tą jedną noc niech będzie to Twoim powodem do dumy.",shape=box,color=red];
		j1663716878 -> j360267524;
	j817067468 [label="Przebierz się i baw się dobrze. Na Pustkę, Hex potrzebuje trochę dobrej zabawy.",shape=box,color=red];
		j817067468 -> j1357247886;
	j2574743429 [label="Wybacz mi, ale nadal nie mogę uwierzyć, że naprawdę tego CHCESZ. Może musisz mnie przekonać trochę bardziej.",shape=box,color=blue];
		j2574743429 -> j2240711146;
	j360267524 [label="Och to OKROPNY POMYSŁ z BARDZO WIELU powodów",shape=box,color=blue];
		j360267524 -> j1708186006;
	j1357247886 [label="Skorzystam z oferty. I dziękuję, jeszcze raz. x",shape=box,color=blue];
		j1357247886 -> "Chat ends.";
	j2240711146 [label="Pożryjmy się nawzajem później. xxx",shape=box,color=blue];
		j2240711146 -> "Chat ends.";
	j1708186006 [label="BARDZO. WIELU.",shape=box,color=blue];
		j1708186006 -> j1039997642;
	"Chat ends." [color=orange];
	j1039997642 [label="(Żadne nie przychodzą mi teraz do głowy ale muszą być ich TUZINY)",shape=box,color=blue];
