		2962 -> 2965;
	2963 [label="Ale lepiej trzymaj ją z dala od głośników w budynku.",shape=box,color=blue];
		2963 -> 2966;
	2964 [label="Chat ends.",color=orange];
	2965 [label="Muszę się zbierać. Dziękuję, że mnie wysłuchałeś.",shape=box,color=blue];
