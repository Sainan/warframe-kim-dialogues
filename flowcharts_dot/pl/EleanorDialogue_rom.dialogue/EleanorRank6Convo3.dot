		j3200519558 -> j27584279;
	"Chat ends." [color=orange];
	j3393223088 [label="Rzecz w tym, że nie ćwiczył tylko dla naszych rodziców, albo żeby zadowolić panią Henshaw. ",shape=box,color=blue];
		j3393223088 -> j3705688548;
	j27584279 [label="Och, to nie jest wielka strata. I tak nie potrafiłam śpiewać.",shape=box,color=blue];
		j27584279 -> j1590337184;
	j3705688548 [label="Śpiewał, bo to kochał. A kiedy padło na niego światło reflektorów, zamilknął.",shape=box,color=blue];
		j3705688548 -> j2090281424;
		j3705688548 -> j3274217640;
	j1590337184 [label="Najbliżej śpiewu byłam, kiedy wykrzykiwałam teksty piosenek Shag Cannons w mojej sypialni, bo chciałam przypodobać się Mandy Jellicoe, bo mi się podobała. ",shape=box,color=blue];
		j1590337184 -> j3704505485;
	j2090281424 [label="Może musiał sobie przypomnieć, jak bardzo to kochał.",shape=box,color=red];
		j2090281424 -> j957734185;
	j3704505485 [label="I wtedy mój ojciec zaczął walić w drzwi i odgrażać się, że przemyje mi język karbolem, jeśli nie skończę tego jazgotu.",shape=box,color=blue];
		j3704505485 -> j1118674337;
	j957734185 [label="Artur jest najszczęśliwszy, kiedy może zapomnieć o Arturze. Kiedy może położyć ducha samego siebie do snu i po prostu BYĆ.",shape=box,color=blue];
		j957734185 -> j3972033491;
	j1118674337 [label="(Nie wiem, czy w twoich czasach macie 'punk', ale brak umiejętności śpiewania jest raczej wymogiem niż przeszkodą)",shape=box,color=blue];
		j1118674337 -> j2295132218;
