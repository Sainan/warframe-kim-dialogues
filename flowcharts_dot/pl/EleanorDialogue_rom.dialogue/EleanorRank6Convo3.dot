	j1421455273 [label="Żądam, żebyś mi wyjaśnił, czym jest Skeg.",shape=box,color=blue];
		j1421455273 -> j2573670286;
	j852718553 [label="Rozeszła się wieść, że Mandy miała zamiar pluć na publiczność i tutaj zakończył się ich los. Szkoda.",shape=box,color=blue];
		j852718553 -> j3953709452;
		j852718553 -> j3924160204;
	j3826698151 [label="Artur nosił się z tym miśkiem przez miesiące. Teraz pojawił się Velimir, zupełnie jakby los wyczuł, że w życiu Artura powstała wielka dziura w kształcie misia...",shape=box,color=blue];
		j3826698151 -> j201388340;
