		j3889046895 -> j3932334328;
	j3359931360 [label="Dlaczego przestał?",shape=box,color=red];
		j3359931360 -> j1683589870;
	j1442355145 [label="Nie jestem fanem, ale jeśli mu to pomaga...",shape=box,color=red];
		j1442355145 -> j3818626888;
	j3932334328 [label="Też mnie to cieszy, dobrze mu idzie.",shape=box,color=red];
		j3932334328 -> j3290466656;
	j1683589870 [label="Bał się wystąpić. Po prostu.",shape=box,color=blue];
		j1683589870 -> j1629516615;
	j3818626888 [label="Cieszy mnie, jak delikatnie to opisałeś.",shape=box,color=blue];
