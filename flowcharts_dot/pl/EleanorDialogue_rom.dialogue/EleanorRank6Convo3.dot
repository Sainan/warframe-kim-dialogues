	"EleanorRank6Convo3 begins." [color=orange];
		"EleanorRank6Convo3 begins." -> j214587916;
	j214587916 [label="Nie wiem, czy zauważyłeś, ale stało się coś niesamowitego.",shape=box,color=blue];
		j214587916 -> j3889046895;
	j3889046895 [label="Artur znowu śpiewa. Dzięki Bogom.",shape=box,color=blue];
