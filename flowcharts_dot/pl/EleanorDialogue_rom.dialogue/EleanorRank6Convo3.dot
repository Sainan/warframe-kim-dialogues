	2956 [label="Chat ends.",color=orange];
	2957 [label="+5 Chemistry",color=orange];
		2957 -> 2960;
	2958 [label="Nie uważam, by istniała rzecz tak bezsensowna, by nie mogła stać się muzyką czyjegoś dzieciństwa.",shape=box,color=blue];
		2958 -> 2961;
	2959 [label="Bogowie, spójrzcie na mnie. Stałam się taka sentymentalna.",shape=box,color=blue];
		2959 -> 2962;
	2960 [label="Hmm. Brzmi jak muzyka wojowników. Z chęcią bym jej posłuchała, gdybyś zdołał ją dla mnie nagrać.",shape=box,color=blue];
		2960 -> 2963;
	2961 [label="Muszę się pozbierać, robię się sentymentalna.",shape=box,color=blue];
		2961 -> 2964;
