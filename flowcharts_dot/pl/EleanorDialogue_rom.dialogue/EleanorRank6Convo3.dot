		j979957401 -> j3304695802;
	j410835829 [label="I na pewno przeszkadza to, że Velimir zachowuje się jak ojciec, którego wybrałby Artur, gdyby miał taką możliwość.",shape=box,color=blue];
		j410835829 -> j3808635627;
		j410835829 -> j3294739150;
