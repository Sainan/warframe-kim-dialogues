	j11620765 [label="Za mało wsparcia?",shape=box,color=red];
		j11620765 -> j11702656;
	j74346923 [label="Zbyt wiele razy trafił na ciężką publikę?",shape=box,color=red];
		j74346923 -> j11702656;
	j1115627745 [label="Koncert kolęd Przesilenia w latach osiemdziesiątych. Wyobraź sobie małego Artura w krótkich spodenkach, jak śpiewa Rosa tego jasnego poranka.",shape=box,color=blue];
		j1115627745 -> j3656247390;
		j1115627745 -> j3589252447;
	j1205836114 [label="’taki z ciebie słowik, zaśpiewaj dla nas’",shape=box,color=blue];
		j1205836114 -> j3058286036;
	j11702656 [label="Usłyszał ten sam żart zbyt wiele razy.",shape=box,color=blue];
		j11702656 -> j2126549978;
	j3656247390 [label="Mogę to sobie wyobrazić.",shape=box,color=red];
		j3656247390 -> j1607391810;
	j3589252447 [label="Nie znam tego utworu.",shape=box,color=red];
		j3589252447 -> j1800013728;
	j3058286036 [label="Inne gnoje, ten sam żart, przez całe nasze życie. Wiktor też nie przegapił okazji. ",shape=box,color=blue];
		j3058286036 -> j3446301031;
	j1607391810 [label="Wziął to do siebie. Całe tygodnie ćwiczeń, a potem, tej nocy zdusił to w sobie. Schował się za kulisami i nie chciał wyjść.",shape=box,color=blue];
		j1607391810 -> j3101579185;
		j1607391810 -> j1629516615;
	j1800013728 [label="Zaśpiewałabym dla ciebie, ale nie wiem jaki dźwięk powstanie, gdybym spróbowała.",shape=box,color=blue];
		j1800013728 -> j2100331972;
	j3446301031 [label="+5 Chemistry",color=orange];
		j3446301031 -> j4119650414;
	j3101579185 [label="Jak go przekonałaś?",shape=box,color=red];
		j3101579185 -> j1628010418;
	j2100331972 [label="Przeklęty Techrot. Próbowałam zaśpiewać \"sto lat\" Aoi, a zabrzmiałam jak żaba w niszczarce do papieru.",shape=box,color=blue];
		j2100331972 -> j3200519558;
	j4119650414 [label="Szczerze, jestem dumna z tego, że Artur w ogóle ma odwagę śpiewać.",shape=box,color=blue];
		j4119650414 -> "Chat ends.";
	j1628010418 [label="Skopałam mu tyłek. Nie jestem z tego dumna, było to konieczne.",shape=box,color=blue];
		j1628010418 -> j3393223088;
