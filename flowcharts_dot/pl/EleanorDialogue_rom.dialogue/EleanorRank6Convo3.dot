	j3290466656 [label="Prawda?",shape=box,color=blue];
		j3290466656 -> j173117685;
	j1629516615 [label="Trudno uwierzyć, że ktoś tak odważny jak Artur mógłby się bać czegoś takiego.",shape=box,color=red];
		j1629516615 -> j3274217640;
	j406653121 [label="Wiele dla mnie znaczy, że tak do tego podchodzisz.",shape=box,color=blue];
		j406653121 -> j1785806679;
	j173117685 [label="Kiedy pomyślę, ile wysiłku kosztowało go to, żeby stanąć przed tłumem ludzi i zaśpiewać...",shape=box,color=blue];
		j173117685 -> j569564235;
	j3274217640 [label="Co było jego słabym punktem?",shape=box,color=red];
		j3274217640 -> j2126549978;
	j1785806679 [label="Zwłaszcza, że istnieją powody, przez które przestał śpiewać, a o których nie mogłeś wiedzieć.",shape=box,color=blue];
		j1785806679 -> j11620765;
		j1785806679 -> j74346923;
	j569564235 [label="... pierwszy raz, kiedy naprawdę puściły mu nerwy.",shape=box,color=blue];
		j569564235 -> j1115627745;
	j2126549978 [label="Chodzi o nazwisko. To ono jest problemem.",shape=box,color=blue];
