digraph {
	2888 [label="EleanorRank6Convo3 begins.",color=orange];
		2888 -> 2889;
	2889 [label="Nie wiem, czy zauważyłeś, ale stało się coś niesamowitego.",shape=box,color=blue];
		2889 -> 2890;
	2890 [label="Artur znowu śpiewa. Dzięki Bogom.",shape=box,color=blue];
		2890 -> 2891;
		2890 -> 2892;
		2890 -> 2893;
	2891 [label="Dlaczego przestał?",shape=box,color=red];
		2891 -> 2894;
	2892 [label="Nie jestem fanem, ale jeśli mu to pomaga...",shape=box,color=red];
		2892 -> 2895;
	2893 [label="Też mnie to cieszy, dobrze mu idzie.",shape=box,color=red];
		2893 -> 2896;
	2894 [label="Bał się wystąpić. Po prostu.",shape=box,color=blue];
		2894 -> 2897;
	2895 [label="Cieszy mnie, jak delikatnie to opisałeś.",shape=box,color=blue];
		2895 -> 2898;
	2896 [label="Prawda?",shape=box,color=blue];
		2896 -> 2899;
	2897 [label="Trudno uwierzyć, że ktoś tak odważny jak Artur mógłby się bać czegoś takiego.",shape=box,color=red];
		2897 -> 2900;
	2898 [label="Wiele dla mnie znaczy, że tak do tego podchodzisz.",shape=box,color=blue];
		2898 -> 2901;
	2899 [label="Kiedy pomyślę, ile wysiłku kosztowało go to, żeby stanąć przed tłumem ludzi i zaśpiewać...",shape=box,color=blue];
		2899 -> 2902;
	2900 [label="Co było jego słabym punktem?",shape=box,color=red];
		2900 -> 2903;
	2901 [label="Zwłaszcza, że istnieją powody, przez które przestał śpiewać, a o których nie mogłeś wiedzieć.",shape=box,color=blue];
		2901 -> 2904;
		2901 -> 2905;
	2902 [label="... pierwszy raz, kiedy naprawdę puściły mu nerwy.",shape=box,color=blue];
		2902 -> 2906;
	2903 [label="Chodzi o nazwisko. To ono jest problemem.",shape=box,color=blue];
		2903 -> 2907;
	2904 [label="Za mało wsparcia?",shape=box,color=red];
		2904 -> 2908;
	2905 [label="Zbyt wiele razy trafił na ciężką publikę?",shape=box,color=red];
		2905 -> 2908;
	2906 [label="Koncert kolęd Przesilenia w latach osiemdziesiątych. Wyobraź sobie małego Artura w krótkich spodenkach, jak śpiewa Rosa tego jasnego poranka.",shape=box,color=blue];
		2906 -> 2909;
		2906 -> 2910;
	2907 [label="’taki z ciebie słowik, zaśpiewaj dla nas’",shape=box,color=blue];
		2907 -> 2911;
	2908 [label="Usłyszał ten sam żart zbyt wiele razy.",shape=box,color=blue];
		2908 -> 2903;
	2909 [label="Mogę to sobie wyobrazić.",shape=box,color=red];
		2909 -> 2912;
	2910 [label="Nie znam tego utworu.",shape=box,color=red];
		2910 -> 2913;
	2911 [label="Inne gnoje, ten sam żart, przez całe nasze życie. Wiktor też nie przegapił okazji. ",shape=box,color=blue];
		2911 -> 2914;
	2912 [label="Wziął to do siebie. Całe tygodnie ćwiczeń, a potem, tej nocy zdusił to w sobie. Schował się za kulisami i nie chciał wyjść.",shape=box,color=blue];
		2912 -> 2915;
		2912 -> 2897;
	2913 [label="Zaśpiewałabym dla ciebie, ale nie wiem jaki dźwięk powstanie, gdybym spróbowała.",shape=box,color=blue];
		2913 -> 2916;
	2914 [label="+5 Chemistry",color=orange];
		2914 -> 2917;
	2915 [label="Jak go przekonałaś?",shape=box,color=red];
		2915 -> 2918;
	2916 [label="Przeklęty Techrot. Próbowałam zaśpiewać \"sto lat\" Aoi, a zabrzmiałam jak żaba w niszczarce do papieru.",shape=box,color=blue];
		2916 -> 2919;
	2917 [label="Szczerze, jestem dumna z tego, że Artur w ogóle ma odwagę śpiewać.",shape=box,color=blue];
		2917 -> 2920;
	2918 [label="Skopałam mu tyłek. Nie jestem z tego dumna, było to konieczne.",shape=box,color=blue];
		2918 -> 2921;
	2919 [label="Przykro mi to słyszeć. Musi być ci ciężko nie móc już śpiewać.",shape=box,color=red];
		2919 -> 2922;
	2920 [label="Chat ends.",color=orange];
	2921 [label="Rzecz w tym, że nie ćwiczył tylko dla naszych rodziców, albo żeby zadowolić panią Henshaw. ",shape=box,color=blue];
		2921 -> 2923;
	2922 [label="Och, to nie jest wielka strata. I tak nie potrafiłam śpiewać.",shape=box,color=blue];
		2922 -> 2924;
	2923 [label="Śpiewał, bo to kochał. A kiedy padło na niego światło reflektorów, zamilknął.",shape=box,color=blue];
		2923 -> 2925;
		2923 -> 2900;
	2924 [label="Najbliżej śpiewu byłam, kiedy wykrzykiwałam teksty piosenek Shag Cannons w mojej sypialni, bo chciałam przypodobać się Mandy Jellicoe, bo mi się podobała. ",shape=box,color=blue];
		2924 -> 2926;
	2925 [label="Może musiał sobie przypomnieć, jak bardzo to kochał.",shape=box,color=red];
		2925 -> 2927;
	2926 [label="I wtedy mój ojciec zaczął walić w drzwi i odgrażać się, że przemyje mi język karbolem, jeśli nie skończę tego jazgotu.",shape=box,color=blue];
		2926 -> 2928;
	2927 [label="Artur jest najszczęśliwszy, kiedy może zapomnieć o Arturze. Kiedy może położyć ducha samego siebie do snu i po prostu BYĆ.",shape=box,color=blue];
		2927 -> 2929;
	2928 [label="(Nie wiem, czy w twoich czasach macie 'punk', ale brak umiejętności śpiewania jest raczej wymogiem niż przeszkodą)",shape=box,color=blue];
		2928 -> 2930;
		2928 -> 2931;
	2929 [label="Piwo pomaga.",shape=box,color=blue];
		2929 -> 2932;
	2930 [label="Nie mamy punku, ale istnieje Skeg.",shape=box,color=red];
		2930 -> 2933;
	2931 [label="Co się stało z zespołem?",shape=box,color=red];
		2931 -> 2934;
	2932 [label="I na pewno przeszkadza to, że Velimir zachowuje się jak ojciec, którego wybrałby Artur, gdyby miał taką możliwość.",shape=box,color=blue];
		2932 -> 2935;
		2932 -> 2936;
	2933 [label="Nie waż się nawet o czymś takim wspomnieć i nie rozwinąć tematu. ",shape=box,color=blue];
		2933 -> 2937;
	2934 [label="Nawet nie dotarły do etapu \"jeden występ z litości\".",shape=box,color=blue];
		2934 -> 2938;
	2935 [label="Nie dziwie mu się.",shape=box,color=red];
		2935 -> 2939;
	2936 [label="Obawiałem się, że Velimir i Minerwa byli zbyt podobni do waszych rodziców.",shape=box,color=red];
		2936 -> 2940;
	2937 [label="Żądam, żebyś mi wyjaśnił, czym jest Skeg.",shape=box,color=blue];
		2937 -> 2941;
	2938 [label="Rozeszła się wieść, że Mandy miała zamiar pluć na publiczność i tutaj zakończył się ich los. Szkoda.",shape=box,color=blue];
		2938 -> 2942;
		2938 -> 2943;
	2939 [label="Artur nosił się z tym miśkiem przez miesiące. Teraz pojawił się Velimir, zupełnie jakby los wyczuł, że w życiu Artura powstała wielka dziura w kształcie misia...",shape=box,color=blue];
		2939 -> 2944;
	2940 [label="tak. Może te kłótnie pomagają mu poczuć się jak w domu. ",shape=box,color=blue];
		2940 -> 2945;
	2941 [label="Brzmi to jak coś sprzedawanego w małych woreczkach na osiedlach w Ludston.",shape=box,color=blue];
		2941 -> 2946;
		2941 -> 2947;
	2942 [label="Kto się boi odrobiny śliny?",shape=box,color=red];
		2942 -> 2948;
	2943 [label="Plucie? Brzmi jak zabawa w wyobrażeniu Cody Technocytu.",shape=box,color=red];
		2943 -> 2949;
	2944 [label="+5 Chemistry",color=orange];
		2944 -> 2950;
	2945 [label="+5 Chemistry",color=orange];
		2945 -> 2951;
	2946 [label="To muzyka, ale gra się ją na rurach. Szybach wentylacyjnych. Hełmach Corpus. Cokolwiek wpadnie w ręce, tak po prawdzie. ",shape=box,color=red];
		2946 -> 2952;
	2947 [label="To bezsensowny hałas, ale Nawiewniaki go uwielbiają.",shape=box,color=red];
		2947 -> 2953;
	2948 [label="+5 Chemistry",color=orange];
		2948 -> 2954;
	2949 [label="To były inne czasy. Kiedy punk był prawdziwym punkiem. ",shape=box,color=blue];
		2949 -> 2955;
	2950 [label="... przepraszam. To nie moja sprawa. Po prostu cieszy mnie, że jest szczęśliwy.",shape=box,color=blue];
		2950 -> 3311;
	2951 [label="To ciekawe, co potrafi wywołać tęsknotę za domem, prawda?",shape=box,color=blue];
		2951 -> 2956;
	2952 [label="Taka kultura Nawiewniaków.",shape=box,color=red];
		2952 -> 2957;
	2953 [label="Hmm, \"bezsensowny hałas\". Gdzieś to już słyszałam.",shape=box,color=blue];
		2953 -> 2958;
	2954 [label="Ja nie byłam, tyle mogę powiedzieć.",shape=box,color=blue];
		2954 -> 2955;
	2955 [label="... naszła mnie myśl, że chciałabym, żeby mnie teraz zobaczyła. Myślę, że polubiłaby tę wersję mnie.",shape=box,color=blue];
		2955 -> 2959;
