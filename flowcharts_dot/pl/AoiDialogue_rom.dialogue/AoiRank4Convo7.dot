	2968 [label="+10 Chemistry",color=orange];
		2968 -> 2971;
	2969 [label="cóż, może to twoja opinia. dzięki, że mnie wysłuchałeś.",shape=box,color=blue];
		2969 -> 2970;
	2980 [label="A jedna piosenka, tylko jedna piosenka, staje się kluczem do odnalezienia samego siebie.",shape=box,color=red];
		2980 -> 2983;
