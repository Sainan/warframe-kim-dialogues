	2974 [label="Muzyka może definiować wspomnienia. \"Uśmiechy z Juran\" to piosenka, którą usłyszałem w głowie, wspomnienia kogoś, kto stracił wszystko.",shape=box,color=red];
		2974 -> 2977;
