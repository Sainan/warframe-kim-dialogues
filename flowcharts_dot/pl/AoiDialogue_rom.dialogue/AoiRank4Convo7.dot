		2966 -> 2969;
	2947 [label="Chat ends.",color=orange];
	2977 [label="Wyobraź to sobie. Wszystko ci zabrano - rodzinę, życie, twoje poczucie siebie.",shape=box,color=red];
		2977 -> 2980;
	2978 [label="Znalezienie radości poprzez pieśń, nadanie sensu i dzielenie się doświadczeniami.",shape=box,color=red];
		2978 -> 2981;
