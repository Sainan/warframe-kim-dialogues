	2925 [label="wykombinowałam sposób na grę na pianinie, czy jakiejkolwiek muzyki, bez myślenia o \"Języku Pustki\"",shape=box,color=blue];
		2925 -> 2926;
	2929 [label="Nie ma łatwej odpowiedzi. Dźwięki, słowa, ekspresje z Pustki. Raczej jak klątwy. Komunikacja czegoś do wszystkich uszu, które mogą to usłyszeć.",shape=box,color=red];
		2929 -> 2948;
	2930 [label="Coś, czego nie chcę już nigdy słyszeć.",shape=box,color=red];
		2930 -> 2949;
	2931 [label="To język tego, co to wszystko powoduje, tak mi się wydaje. Sposób, w jaki to mówi.",shape=box,color=red];
		2931 -> 2953;
	2928 [label="łatwiej jest tak zacząć lekcję gry na pianinie, ponieważ... hmm, nie mogę znaleźć pianina. trzymajmy się więc teorii.",shape=box,color=blue];
		2928 -> 2934;
		2928 -> 2932;
		2928 -> 2933;
	2948 [label="co <RETRO_EMOJI_OHNO>",shape=box,color=blue];
		2948 -> 2954;
	2949 [label="jak koszmarna piosenka?",shape=box,color=blue];
		2949 -> 2950;
		2949 -> 2951;
	2953 [label="czy to jest taki melodyjny język czy coś?",shape=box,color=blue];
		2953 -> 2955;
		2953 -> 2956;
	2934 [label="Ok, trzymajmy się teorii.",shape=box,color=red];
		2934 -> 2935;
	2932 [label="Jak długo szukałaś?",shape=box,color=red];
		2932 -> 2938;
	2933 [label="Gdzie możemy znaleźć pianino?",shape=box,color=red];
		2933 -> 2939;
	2954 [label="cóż, teraz naprawdę muszę ci znaleźć jakąś muzykę. tylko pomyśl. zagłuszyć ten \"Język Pustki\" jakąś własną piosenką, prawda?",shape=box,color=blue];
		2954 -> 2955;
		2954 -> 2956;
	2950 [label="Zostawmy to tak. [Koniec]",shape=box,color=red];
		2950 -> 2952;
	2951 [label="W pewien sposób, tak.",shape=box,color=red];
		2951 -> 2953;
	2955 [label="Ja nie wiem jak to opisać, ale jest potężne.",shape=box,color=red];
		2955 -> 2957;
	2956 [label="Nic, co chcesz usłyszeć. Część powodu, dla którego to wszystko się dzieje.",shape=box,color=red];
		2956 -> 2960;
	2935 [label="jupi! więc, żeby naprawdę dać ci fundamenty muszę podkreślić, że muzyka jest tutaj naprawdę ważna od zawsze. chłopaki i dziewczyny siadają przy pianinie, a nie przed telewizorem i po prostu tworzą.",shape=box,color=blue];
		2935 -> 2936;
	2938 [label="cóż, nie jest łatwo? nie byłam pewna, czy w ogóle wchodzić do pustych mieszkań...",shape=box,color=blue];
		2938 -> 2940;
	2939 [label="hmm, są duże i trudne do ukrycia... a wątpię, żeby Wiktor i Scaldra grali.",shape=box,color=blue];
		2939 -> 2940;
	2952 [label="Chat ends.",color=orange];
	2957 [label="To coś wystarczająco potężnego, by zmienić życie. Znam pewne zwierzęta. Powiedziałbym, że to moi przyjaciele. Cavia. Dotknęli Pustki i nauczyli się *mówić* jak za dotknięciem czarodziejskiej różdżki, magia.",shape=box,color=red];
		2957 -> 2959;
	2960 [label="To powód wielkiego bólu.",shape=box,color=red];
		2960 -> 2961;
		2960 -> 2962;
	2936 [label="grają... komponują... bo piosenka to jest komunikacja z pomocą muzyki. nie potrzebujesz nawet tekstu!",shape=box,color=blue];
		2936 -> 2937;
	2940 [label="grrr. Scaldra. pewnie je zniszczyli. dlaczego pozwoliliby, żeby coś dającego nadzieję tak jak instrument przetrwało w tym miejscu?",shape=box,color=blue];
		2940 -> 2941;
	2959 [label="A kiedy teraz mówią, to zaczęło się tak beznadziejnie. Tak źle. Język Pustki pozwolił tym stworzeniom na początku poczuć dokładnie jedno: beznadziejność.",shape=box,color=red];
		2959 -> 2958;
	2961 [label="Nie mogę się zmusić do słuchania tego.",shape=box,color=red];
		2961 -> 2963;
	2962 [label="Ale mimo wszystko czuję, że potrafię mówić tym językiem.",shape=box,color=red];
		2962 -> 2963;
	2937 [label="ale wyobraź sobie to - stworzenie czegoś dla tego naszego świata, co sprawi, że ludzie będą płakać? tańczyć? śpiewać? dla mnie to magia.",shape=box,color=blue];
		2937 -> 2942;
		2937 -> 2943;
	2941 [label="ale czekaj, pozwól, że zapytam cię, jeśli w przyszłości nadal jest muzyka, może jest nadzieja. więc...",shape=box,color=blue];
		2941 -> 2945;
	2958 [label="nie nabijaj się ze mnie, ale czy próbowałeś puścić im muzykę? tym przyjaciołom? może pomogłoby to im, choć na sekundę?",shape=box,color=blue];
		2958 -> 2965;
	2963 [label="I to mnie przeraża. To jak piosenka, której nie chcę słyszeć. Jak magiczna klątwa, która powinna BYĆ ZDJĘTA.",shape=box,color=red];
		2963 -> 2964;
	2942 [label="Magia? Raczej nie. Ale lubię dobre piosenki.",shape=box,color=red];
		2942 -> 2946;
	2943 [label="Muzyka była częścią tego, przez co przeszedłem. Wspomnienia poprzez piosenki, wiem, o co chodzi.",shape=box,color=red];
		2943 -> 2944;
	2945 [label="Proszę, opowiedz mi o jakiejś piosence.",shape=box,color=blue];
		2945 -> 2974;
		2945 -> 2975;
		2945 -> 2976;
	2965 [label="nie sądzisz, że muzyka mogłaby pomóc w przełomie i stać się nadzieją? no po prostu dla każdego? dla wszystkiego? jeśli Język Pustki jest \"magią\", to muzyka też nią jest.",shape=box,color=blue];
		2965 -> 2967;
		2965 -> 2966;
