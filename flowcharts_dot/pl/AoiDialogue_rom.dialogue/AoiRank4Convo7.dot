		2975 -> 2978;
	2976 [label="Muzyka może nosić zło, Aoi. Ci ludzie, których próbowałem uratować, zostali przeklęci przez pieśń. Skandowali: \"Za Narmer, za Narmer\".",shape=box,color=red];
		2976 -> 2979;
