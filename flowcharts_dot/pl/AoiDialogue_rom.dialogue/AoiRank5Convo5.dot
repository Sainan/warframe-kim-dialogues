digraph {
	3513 [label="AoiRank5Convo5 begins.",color=orange];
		3513 -> 3514;
		3513 -> 3515;
	3514 [label="Jedną rzeczą, którą naprawdę podziwiam w Tobie, jest Twoje niezachwiane zaangażowanie w budowanie lepszego świata. Skąd się to bierze?",shape=box,color=red];
		3514 -> 3516;
	3515 [label="Twoja motywacja jest imponująca. Co rozpala ten ogień w tobie?",shape=box,color=red];
		3515 -> 3516;
	3516 [label="och wow, dziękuję za to, co powiedziałeś. yyy... hmm. nie było żadnego wielkiego, decydującego momentu, który zadecydowałaby o mojej ścieżce życiowej czy czegoś takiego.",shape=box,color=blue];
		3516 -> 3517;
	3517 [label="o ile wiem, odziedziczyłam to po rodzicach. To byli ludzie praktyczni, ale też marzyciele",shape=box,color=blue];
		3517 -> 3518;
	3518 [label="mam na myśli, nie budujesz rakiet, żeby eksplorować kosmos, jeśli nie jesteś marzycielem.",shape=box,color=blue];
		3518 -> 3519;
		3518 -> 3520;
		3518 -> 3521;
	3519 [label="Moment. Twoi rodzice budowali rakiety?",shape=box,color=red];
		3519 -> 3522;
	3520 [label="No to niezły rodzinny biznes. Brzmi, jakby ustawili wysoko poprzeczkę.",shape=box,color=red];
		3520 -> 3523;
	3521 [label="To nie jest taka typowa rodzinny scheda. Czy kiedykolwiek mówili o tym, co ich zainspirowało?",shape=box,color=red];
		3521 -> 3524;
	3522 [label="cóż, tata tak. a mama wiedziała jak.",shape=box,color=blue];
		3522 -> 3525;
	3523 [label="tak... a kiedy zostałam żołnierzem, dali mi jasno do zrozumienia, że nie jest to dokładnie takie życie, jakie mieli nadzieję dla mnie zbudować.",shape=box,color=blue];
		3523 -> 3525;
	3524 [label="niewiele. nie byli chętni do dzielenia się swoimi marzeniami na głos. myślę, że wierzyli, że ich wkład w świat będzie mówić sam za siebie.",shape=box,color=blue];
		3524 -> 3525;
	3525 [label="tata był inżynierem lotnictwa i kosmonautyki. mama uczyła projektowania systemów kosmicznych na uniwersytecie, gdzie poznali się jako studenci.",shape=box,color=blue];
		3525 -> 3527;
		3525 -> 3526;
		3525 -> 3528;
	3527 [label="Jeju, twój dom był w pewnym sensie ośrodkiem badawczym i po części platformą startową.",shape=box,color=red];
		3527 -> 3530;
	3526 [label="Rozmowy z nimi musiały być fascynujące.",shape=box,color=red];
		3526 -> 3529;
	3528 [label="Brzmią, jakby byli genialni. Musiało być niesamowicie dorastać w takim otoczeniu.",shape=box,color=red];
		3528 -> 3529;
	3530 [label="haha nie, raczej nie. było po prostu cicho.",shape=box,color=blue];
		3530 -> 3531;
	3529 [label="tak, pewnie masz rację",shape=box,color=blue];
		3529 -> 3532;
	3531 [label="wiele naszych rozmów polegało na mówieniu \"hej, kochanie\" i \"cześć\" mimochodem. potem jedli kolację w drodze do biura, żeby popracować dłużej czy cokolwiek",shape=box,color=blue];
		3531 -> 3533;
	3532 [label="ale większość naszych rozmów sprowadzała się do \"hej, kochanie\" i \"cześć\", gdy mijaliśmy się w kuchni. szybko coś zjedli i wracali do swoich biur, żeby dłużej popracować",shape=box,color=blue];
		3532 -> 3533;
	3533 [label="byli zajęci",shape=box,color=blue];
		3533 -> 3534;
	3534 [label="dopóki nie pakowałam się w kłopoty, nie przejmowali się mną zbytnio. i pomimo całego ognia, który we mnie kipiał, naprawdę dobrze mi szło unikanie kłopotów.",shape=box,color=blue];
		3534 -> 3535;
		3534 -> 3536;
		3534 -> 3537;
	3535 [label="Rozumiem. Moi rodzice też byli zawsze zajęci. Zarządzanie Zarimanem było dla każdego pracą na pełen etat. Mimo to zawsze znajdowaliśmy czas, żeby usiąść razem do posiłku.",shape=box,color=red];
		3535 -> 3538;
	3536 [label="Ma to sens. Kiedy praca tak mocno cię wciąga, nie zostaje wiele czasu, ale wierzę, że myśleli o tobie nieustannie.",shape=box,color=red];
		3536 -> 3539;
	3537 [label="Nie mogę powiedzieć, że ich obwiniam. Wiem z pierwszej ręki, że podróże kosmiczne nie pozostawiają wiele miejsca na wolny czas. To trochę brzmi, jakbyś ułatwiała im życie, nie wychylając się.",shape=box,color=red];
		3537 -> 3540;
	3538 [label="+5 Chemistry",color=orange];
		3538 -> 3541;
	3539 [label="+5 Chemistry",color=orange];
		3539 -> 3542;
	3540 [label="tak, myślę, że tak.",shape=box,color=blue];
		3540 -> 3545;
	3541 [label="to miłe. cieszę się, że tak robili.",shape=box,color=blue];
		3541 -> 3543;
	3542 [label="może",shape=box,color=blue];
		3542 -> 3544;
	3545 [label="mam nadzieję, że tak było.",shape=box,color=blue];
		3545 -> 3546;
	3543 [label="teraz zdaję sobie sprawę, jak ważne są te chwile, ale gdy dorastałam, nie wydawało mi się dziwne, że nie miałam ich zbyt wielu.",shape=box,color=blue];
		3543 -> 3546;
	3544 [label="faktycznie, myślę, że to prawda :)",shape=box,color=blue];
		3544 -> 3546;
	3546 [label="rozumiem, dlaczego moi rodzice byli tak skupieni na swojej pracy. na swój sposób okazywali w ten sposób miłość. chcieli zapewnić mi byt i stworzyć technologię, która mogłaby pomóc ludzkości mieć lepszą przyszłość.",shape=box,color=blue];
		3546 -> 3547;
	3547 [label="patrząc wstecz, jest to piękne",shape=box,color=blue];
		3547 -> 3548;
		3547 -> 3549;
		3547 -> 3550;
	3548 [label="Może tak, ale nadal nie mieści mi się w głowie, że ich córka nie spędzała z nimi więcej czasu. Mamy ograniczony czas w tym życiu, rozumiesz? Powinniśmy spędzać jak najwięcej czasu z ludźmi, których kochamy.",shape=box,color=red];
		3548 -> 3551;
	3549 [label="Piękne, oczywiście, ale też praktyczne. Robili coś, co miało znaczenie, a nie ma nic ważniejszego niż to.",shape=box,color=red];
		3549 -> 3554;
	3550 [label="To potężna forma miłości, nawet jeśli nie jest to miłość, która przesiaduje przy stole w jadalni.",shape=box,color=red];
		3550 -> 3552;
	3551 [label="+5 Chemistry",color=orange];
		3551 -> 3553;
	3554 [label="niemniej nie mogę przestać myśleć o tym, że nie spędzaliśmy ze sobą zbyt wiele czasu.",shape=box,color=blue];
		3554 -> 3556;
	3552 [label="+5 Chemistry",color=orange];
		3552 -> 3555;
	3553 [label="to właśnie \"tyle, ile możemy\" jest tak trudne, prawda? trudno to zmierzyć",shape=box,color=blue];
		3553 -> 3556;
	3556 [label="jeśli kiedykolwiek ich jeszcze zobaczę, na pewno nadrobię stracony czas. wiem, że oni też się postarają.",shape=box,color=blue];
		3556 -> 3563;
		3556 -> 3558;
		3556 -> 3561;
	3555 [label="prawda! nie taka, jaką widzisz w filmach, ale bardzo prawdziwa.",shape=box,color=blue];
		3555 -> 3556;
	3563 [label="Masz rację. Tylko nie marnuj czasu na wyrzucanie tego sobie. Oni dokonali swoich wyborów, a ty dokonałaś swoich. Wygląda na to, że dobrze wykorzystałaś to, co ci dali.",shape=box,color=red];
		3563 -> 3564;
	3558 [label="Wiesz, ta twoja chęć uczynienia świata lepszym... jest głębsza, niż sam sobie przyznajesz. Powinnaś być z niej bardziej dumna.",shape=box,color=red];
		3558 -> 3557;
	3561 [label="Mam nadzieję, że dostaniesz taką szansę. Masz serce pełne nadziei i siły. Myślę, że byliby dumni z tego, kim się stałaś.",shape=box,color=red];
		3561 -> 3560;
	3564 [label="masz rację",shape=box,color=blue];
		3564 -> 3567;
		3564 -> 3566;
		3564 -> 3565;
	3557 [label="+5 Chemistry",color=orange];
		3557 -> 3559;
	3560 [label="+5 Chemistry",color=orange];
		3560 -> 3562;
	3567 [label="Masz ich mózgi i napęd, ale uczyniłaś je własnymi. To się liczy.",shape=box,color=red];
		3567 -> 3570;
	3566 [label="Brzmi to tak, jakbyś wyrosła na kochającą, uważną osobę, której sama potrzebowałaś, gdy byłaś młodsza. To coś, z czego warto być dumnym.",shape=box,color=red];
		3566 -> 3568;
	3565 [label="Wzięłaś wszystko, co ci dali i na tym się oparłaś budując dalej — nie tylko marzeniami i zapałem, ale także współczuciem. To nie jest łatwe.",shape=box,color=red];
		3565 -> 3569;
	3559 [label="och? jak to?",shape=box,color=blue];
		3559 -> 3567;
		3559 -> 3566;
		3559 -> 3565;
	3562 [label="to dla mnie wiele znaczy. też mam taką nadzieję.",shape=box,color=blue];
		3562 -> 3567;
		3562 -> 3566;
		3562 -> 3565;
	3570 [label="to... tak naprawdę bardzo fajny sposób myślenia o tym.",shape=box,color=blue];
		3570 -> 3573;
		3570 -> 3572;
		3570 -> 3574;
	3568 [label="+5 Chemistry",color=orange];
		3568 -> 3571;
	3569 [label="+5 Chemistry",color=orange];
		3569 -> 3571;
	3573 [label="Po prostu mówię jak to widzę.",shape=box,color=red];
		3573 -> 3575;
	3572 [label="Do usług.",shape=box,color=red];
		3572 -> 3575;
	3574 [label="Zasługujesz, żeby to usłyszeć.",shape=box,color=red];
		3574 -> 3575;
	3571 [label="nigdy wcześniej o tym w ten sposób nie myślałam. To... naprawdę miłe spojrzenie na sprawę. Dziękuję.",shape=box,color=blue];
		3571 -> 3573;
		3571 -> 3572;
		3571 -> 3574;
	3575 [label="<3",shape=box,color=blue];
