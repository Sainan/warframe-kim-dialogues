	4206 [label="\"Znajdujesz się w dużym, pustym pomieszczeniu. Jakiejś piwnicy? Jedyne, co przyciąga twoją uwagę, to potężne, metalowe drzwi.\"",shape=box,color=blue];
		4206 -> 4207;
		4206 -> 4208;
