	j3552528257 [label="jak chcesz",shape=box,color=blue];
		j3552528257 -> j3674621392;
	j2205989359 [label="\"Przeszukujesz zwłoki strażnika ale nie znajdujesz nic cennego. Zastanawiasz się nad zjedzeniem zgniłego ciastka, ale jego zapach szybko wybija ci tę myśl z głowy.\"",shape=box,color=blue];
		j2205989359 -> j3451620922;
	j1390731460 [label="\"Przeszukujesz ciało strażnika. Nie odnajdujesz nic poza krzemieniem i spleśniałym biszkoptem. Zabierasz ze sobą krzemień.\"",shape=box,color=blue];
