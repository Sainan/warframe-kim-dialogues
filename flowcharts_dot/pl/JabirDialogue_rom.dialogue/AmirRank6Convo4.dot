		4213 -> 4214;
	4214 [label="znaczy...",shape=box,color=blue];
		4214 -> 4215;
	4215 [label="\"Pisk staje się głośniejszy i głośniejszy. Po chwili dołącza do niego stukot pazurów o kamień. Pochodnia rzuca cień na ścianę. Dostrzegasz szczura wielkości kota... nie... psa, który biegnie na ciebie.\"",shape=box,color=blue];
		4215 -> 4216;
	4216 [label="\"Nie jest sam, wyłażą zewsząd.\"",shape=box,color=blue];
		4216 -> 4217;
		4216 -> 4218;
		4216 -> 4219;
	4217 [label="Próbuję skopać tego szczura.",shape=box,color=red];
		4217 -> 4220;
	4218 [label="Odganiam je pochodnią.",shape=box,color=red];
		4218 -> 4220;
	4219 [label="Omówiłeś tę część z Lettie?",shape=box,color=red];
		4219 -> 4221;
	4220 [label="\"Szczury cię otaczają. Stajesz gotowy do walki, ale nie atakują. Zamiast tego, największy ze szczurów kłania się przed tobą. Zauważasz naszyjnik na jego karku. Srebrny łańcuch zsuwa się z niego i spada na ziemię. Szczur patrzy na ciebie, jakby próbował przekazać 'to należy do ciebie.'\"",shape=box,color=blue];
		4220 -> 4222;
		4220 -> 4223;
	4221 [label="nie i nie mam zamiaru",shape=box,color=blue];
		4221 -> 4224;
	4222 [label="Podnoszę naszyjnik.",shape=box,color=red];
		4222 -> 4225;
	4223 [label="Pytam szczura, kto dał mu ten naszyjnik?",shape=box,color=red];
		4223 -> 4226;
	4224 [label="szczury biegną na ciebie, co robisz?",shape=box,color=blue];
		4224 -> 4217;
		4224 -> 4218;
	4225 [label="\"Podnosisz naszyjnik. Na łańcuszku jest klucz.\"",shape=box,color=blue];
		4225 -> 4227;
	4226 [label="\"Szczur nie odpowiada, bo jest szczurem.\"",shape=box,color=blue];
		4226 -> 4227;
	4227 [label="\"Szczury rozbiegają się. Ktokolwiek przekazał im ten klucz, wiedział, że tu trafisz. Na świecie jest tylko jedna osoba, która włada taką mocą... Lotus.\" ",shape=box,color=blue];
		4227 -> 4228;
	4228 [label="Klucz? Czy otwiera on te wielkie wrota?",shape=box,color=red];
		4228 -> 4229;
	4229 [label="\"Wsadzasz klucz do zamka i zdołasz otworzyć drzwi. Jasne światło oślepia cię. Po chwili zdołasz spojrzeć i nie możesz uwierzyć własnym oczom...\"",shape=box,color=blue];
		4229 -> 4230;
