		4153 -> 4159;
	4154 [label="Update boolean FlintLoop3",color=orange];
		4154 -> 4118;
	4156 [label="\"Ostrożnie stąpasz przez korytarz, a światło pochodni odkrywa tajemnice ciemności przed tobą. Stajesz u krawędzi zbiornika. Spoglądasz w dół, ale nie jesteś w stanie dostrzec dnia. Gdyby nie światło pochodni, taki upadek z pewnością byłby twoją zgubą.\"",shape=box,color=blue];
