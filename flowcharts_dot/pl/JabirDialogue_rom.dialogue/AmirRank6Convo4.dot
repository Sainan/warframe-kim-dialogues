		4128 -> 4133 [label=true,color=green];
		4128 -> 4132 [label=false,color=brown];
	4129 [label="\"Zamykasz drzwi i czekasz na pomoc, która nigdy nie nadchodzi. Zamiast tego odwiedzają cię strażnicy, którzy są bardzo rozwścieczeni stratą przyjaciela. W ramach zemsty poddają cię serii okrutnych tortur, aż umierasz straszną, bezsensowną śmiercią.\"",shape=box,color=blue];
