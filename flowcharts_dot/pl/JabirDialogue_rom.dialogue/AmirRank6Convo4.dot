		4168 -> 4174;
	4171 [label="\"Próbujesz rzucić światło przez szczeliny. Podmuch wiatru sprawia, że płomień pochodni migocze. Słyszysz odgłosy kapiącej wody.\"",shape=box,color=blue];
		4171 -> 4166;
	4172 [label="\"Używając całej swojej siły, zrywasz deski, by odsłonić to, co zostało zardzewiałej kraty. Jest miejsce, by się przecisnąć. Dalej, niski, wąski tunel.\"",shape=box,color=blue];
