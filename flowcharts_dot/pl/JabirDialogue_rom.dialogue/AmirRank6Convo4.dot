		j221085784 -> j1390731460 [label=false,color=brown];
	j4194879559 [label="\"Ostrożnie wychodzisz z celi. Po prawej widzisz wrota, wyjście. Wrota są lekko uchylone, a zza nich słyszysz stłumione głosy strażników Grineer. Po lewej, korytarz lochów ciągnie się w dal i ginie w ciemnościach.\"",shape=box,color=blue];
