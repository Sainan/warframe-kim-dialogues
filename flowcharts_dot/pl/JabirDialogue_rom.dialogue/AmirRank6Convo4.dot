	4123 [label="Check boolean FlintTaken",color=orange];
		4123 -> 4126 [label=true,color=green];
		4123 -> 4127 [label=false,color=brown];
	4124 [label="\"Ostrożnie wychodzisz z celi. Po prawej widzisz wrota, wyjście. Wrota są lekko uchylone, a zza nich słyszysz stłumione głosy strażników Grineer. Po lewej, korytarz lochów ciągnie się w dal i ginie w ciemnościach.\"",shape=box,color=blue];
		4124 -> 4128;
	4125 [label="jak chcesz",shape=box,color=blue];
		4125 -> 4129;
	4126 [label="\"Przeszukujesz zwłoki strażnika ale nie znajdujesz nic cennego. Zastanawiasz się nad zjedzeniem zgniłego ciastka, ale jego zapach szybko wybija ci tę myśl z głowy.\"",shape=box,color=blue];
		4126 -> 4130;
	4127 [label="\"Przeszukujesz ciało strażnika. Nie odnajdujesz nic poza krzemieniem i spleśniałym biszkoptem. Zabierasz ze sobą krzemień.\"",shape=box,color=blue];
