		j2351629743 -> j1868152740;
	j1868152740 [label="\"Szczury rozbiegają się. Ktokolwiek przekazał im ten klucz, wiedział, że tu trafisz. Na świecie jest tylko jedna osoba, która włada taką mocą... Lotus.\" ",shape=box,color=blue];
