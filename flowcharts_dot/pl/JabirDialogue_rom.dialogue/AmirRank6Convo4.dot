	j1282166246 [label="\"Szczury cię otaczają. Stajesz gotowy do walki, ale nie atakują. Zamiast tego, największy ze szczurów kłania się przed tobą. Zauważasz naszyjnik na jego karku. Srebrny łańcuch zsuwa się z niego i spada na ziemię. Szczur patrzy na ciebie, jakby próbował przekazać 'to należy do ciebie.'\"",shape=box,color=blue];
		j1282166246 -> j3290919516;
