		4146 -> 4153 [label=false,color=brown];
	4147 [label="\"Cichy głosik w twojej głowie mówi 'hej, dupku, to twoja ostatnia szansa. Strażnik nie ma przy sobie nic ciekawego. Koniec z wygłupami.\"",shape=box,color=blue];
		4147 -> 4154;
	4149 [label="\"Zabierasz ze sobą pochodnię, błagając by jej płomień nie zgasł. Udajesz się wgłąb lochów. Mijasz wiele pustych, bliźniaczo podobnych cel.\"",shape=box,color=blue];
		4149 -> 4156;
	4148 [label="\"Błądzisz w ciemnościach szukając... czegoś... z każdym krokiem jesteś coraz bardziej zagubiony. Nagle potykasz się o krawędź.\"",shape=box,color=blue];
		4148 -> 4155;
