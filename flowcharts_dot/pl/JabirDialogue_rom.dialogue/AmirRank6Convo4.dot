	j1002289023 [label="\"Wsadzasz klucz do zamka i zdołasz otworzyć drzwi. Jasne światło oślepia cię. Po chwili zdołasz spojrzeć i nie możesz uwierzyć własnym oczom...\"",shape=box,color=blue];
