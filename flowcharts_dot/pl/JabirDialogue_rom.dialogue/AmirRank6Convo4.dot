	4115 [label="\"Stoisz w celu nad ciałem Grineera, którego właśnie zabiłeś. Nie możesz przestać myśleć o jego ostatnich słowach, 'Nigdy nie odnajdziesz Lotus.'\"",shape=box,color=blue];
