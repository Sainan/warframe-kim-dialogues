		4197 -> 4202;
	4195 [label="Chat ends.",color=orange];
	4198 [label="\"Przykucasz i wchodzisz do tunelu. Powoli przeciskasz przez niekończący się tunel. Jest zimno, mokro i bardzo, bardzo brudno.\"",shape=box,color=blue];
