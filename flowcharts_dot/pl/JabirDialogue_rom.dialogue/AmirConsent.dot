		j4017399462 -> j2899418582;
	j2899418582 [label="Rozumiem, że to nie jest dla ciebie przyjemna sytuacja. Dlatego chcę, żebyś zrozumiał, jak wiele dla mnie znaczysz.",shape=box,color=red];
		j2899418582 -> j2456823935;
