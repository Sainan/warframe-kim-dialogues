		j1908688370 -> j1705083737;
	j1705083737 [label="Rozumiem, że to nie jest dla ciebie przyjemna sytuacja. Dlatego chcę, żebyś zrozumiał, jak wiele dla mnie znaczysz.",shape=box,color=red];
		j1705083737 -> j2783313382;
	j2783313382 [label="To nikt stąd i nie wiem, czy i w ogóle jak mógłbym was sobie przedstawić, ale... ta osoba też jest dla mnie ważna. Tak jak ty jesteś ważny.",shape=box,color=red];
		j2783313382 -> j2000256967;
	j2000256967 [label="Wiem, że może być to ciężkie do przyjęcia i rozumiem, jeśli się na to nie zgodzisz. Po prostu nie chcę, żebyś myślał, że cię okłamuję albo coś przed tobą ukrywam.",shape=box,color=red];
