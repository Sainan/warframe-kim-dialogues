		j3608186060 -> j3312615809;
	j3312615809 [label="masz... gdzieś innego partnera? albo... kiedyś? ale... to nie jest nikt z hex... prawda? ....... aaaaahchch to by było takie dziiiwne",shape=box,color=blue];
