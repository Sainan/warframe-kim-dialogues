		j1229602200 -> j4046751980;
	j4046751980 [label="Wiem, że nie jest to coś, o czym rozmawialiśmy wcześniej. Zależy mi na tym, żebyś nie czuł się, jakbym cię okłamywał.",shape=box,color=red];
