	4380 [label="tak... jest gotowa",shape=box,color=blue];
		4380 -> 4382;
	4381 [label="nie dziwię ci się, przystojniak z niego",shape=box,color=blue];
		4381 -> 4382;
	4382 [label="to zaczynamy",shape=box,color=blue];
		4382 -> 4383;
	4383 [label="\"Stoisz pośród laboratorium, u twojego boku stoi wyzwolony Zabir. Spogląda na ciebie i mówi 'Nie mamy czasu, chodź za mną.'\"",shape=box,color=blue];
		4383 -> 4384;
	4384 [label="\"Prowadzi cię przez labirynt korytarzy. Zna tę asteroidę jak własną kieszeń. Każdy zaułek, kroki każdego strażnika.\"",shape=box,color=blue];
		4384 -> 4385;
		4384 -> 4386;
		4384 -> 4387;
	4385 [label="Pytam Zabira o szczury.",shape=box,color=red];
		4385 -> 4388;
	4386 [label="On też jest więźniem?",shape=box,color=red];
		4386 -> 4389;
	4387 [label="Dokąd mnie prowadzi?",shape=box,color=red];
		4387 -> 4390;
	4388 [label="\"Zabir jest zaskoczony. 'Szczury cię znalazły? To niesamowite, że to się udało. Patrz na to.' powiedział Zabir pokazując ci złoty gwizdek. 'Dała mi go Królowa Szczurów. Musimy ją odnaleźć.'\"",shape=box,color=blue];
		4388 -> 4391;
	4389 [label="\"Pytasz Zabira, jak się tu znalazł. 'Nie mamy na to czasu' odpowiada, 'musimy się stąd wydostać.'\"",shape=box,color=blue];
		4389 -> 4385;
		4389 -> 4387;
	4390 [label="\"Zabir ogląda się za siebie, 'Idziemy do hangaru. Przejmiemy statek i uciekniemy najdalej, jak to możliwe. Musimy znaleźć Królową Szczurów.'\"",shape=box,color=blue];
		4390 -> 4391;
	4391 [label="KRÓLOWĄ SZCZURÓW?",shape=box,color=red];
		4391 -> 4392;
	4392 [label="\"'To ona dała mi ten gwizdek. Szczury go słuchają. Jest moją przyjaciółką. Nie zawsze jest miła, ale można na niej polegać.'\"",shape=box,color=blue];
		4392 -> 4393;
		4392 -> 4394;
	4393 [label="Czy przypadkiem pokazywałaś to Lettie?",shape=box,color=red];
		4393 -> 4395;
	4394 [label="Brzmi dziwnie znajomo.",shape=box,color=red];
		4394 -> 4396;
	4395 [label="za bardzo cenię sobie życie, żeby tak ryzykować",shape=box,color=blue];
		4395 -> 4397;
	4396 [label="wszelkie podobieństwa do osób prawdziwych lub nie są tylko zbiegiem okoliczności",shape=box,color=blue];
		4396 -> 4397;
	4397 [label="\"Z pomocą Zabira przemykacie przez korytarze asteroidy. Zwinne unika strażników i kamer.\"",shape=box,color=blue];
		4397 -> 4398;
	4398 [label="\"W końcu docieracie do ogromnych drzwi. Zabir daje sygnał, żebyś się schował. Wkradacie się do hangaru.\"",shape=box,color=blue];
		4398 -> 4399;
	4399 [label="\"Chowasz się w cieniu kolumny. Niedaleko słychać strażników Grineer.\"",shape=box,color=blue];
		4399 -> 4400;
	4400 [label="\"Co robisz?\"",shape=box,color=blue];
		4400 -> 4401;
		4400 -> 4402;
	4401 [label="Atakuję strażników.",shape=box,color=red];
		4401 -> 4403;
	4402 [label="Rozglądam się.",shape=box,color=red];
		4402 -> 4404;
	4403 [label="\"Bez krzty instynktu samozachowawczego wybiegasz w otwartą przestrzeń. Grupa strażników zaczyna do ciebie strzelać. Wbiegasz w ścianę pocisków, która natychmiastowo kończy twój żywot. Zabir tylko kiwa głową na widok twojego bezsensownego aktu odwagi.\"",shape=box,color=blue];
		4403 -> 4405;
	4404 [label="\"Wyglądasz zza rogu i badasz przestrzeń.\"",shape=box,color=blue];
		4404 -> 4406;
	4405 [label="chcesz spróbować jeszcze raz i może nie dać się zabić?",shape=box,color=blue];
		4405 -> 4407;
		4405 -> 4408;
	4406 [label="\"Na środku hangaru stoi Railjack. Wejście na pokład jest zagrodzone przez strażnika. Bliżej ściany hangaru, tuzin Grineer jest głośno zajętych grą w kości. Niedaleko przed tobą znajduje się konsola z panelem sterowania.\"",shape=box,color=blue];
		4406 -> 4409;
	4407 [label="Tak zróbmy.",shape=box,color=red];
		4407 -> 4410;
	4408 [label="Mam dosyć na dzisiaj. [Koniec]",shape=box,color=red];
		4408 -> 4411;
	4409 [label="\"'Musimy otworzyć drzwi hangaru, żeby się stąd wydostać,' szepcze Zabir.\"",shape=box,color=blue];
		4409 -> 4412;
	4410 [label="\"Co zrobisz tym razem?\"",shape=box,color=blue];
		4410 -> 4413;
		4410 -> 4402;
	4411 [label="Chat ends.",color=orange];
	4412 [label="\"Zabir patrzy na ciebie i pyta 'Masz jakieś genialne pomysły?'\"",shape=box,color=blue];
