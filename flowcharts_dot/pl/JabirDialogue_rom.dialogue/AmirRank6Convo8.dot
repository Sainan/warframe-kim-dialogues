	j3705126252 [label="to zaczynamy",shape=box,color=blue];
		j3705126252 -> j1087609009;
	j1087609009 [label="\"Stoisz pośród laboratorium, u twojego boku stoi wyzwolony Zabir. Spogląda na ciebie i mówi 'Nie mamy czasu, chodź za mną.'\"",shape=box,color=blue];
		j1087609009 -> j2958003954;
	j2958003954 [label="\"Prowadzi cię przez labirynt korytarzy. Zna tę asteroidę jak własną kieszeń. Każdy zaułek, kroki każdego strażnika.\"",shape=box,color=blue];
		j2958003954 -> j3281039320;
		j2958003954 -> j1285049423;
		j2958003954 -> j2539130919;
	j3281039320 [label="Pytam Zabira o szczury.",shape=box,color=red];
		j3281039320 -> j2591517893;
	j1285049423 [label="On też jest więźniem?",shape=box,color=red];
		j1285049423 -> j428275980;
	j2539130919 [label="Dokąd mnie prowadzi?",shape=box,color=red];
		j2539130919 -> j2207932207;
	j2591517893 [label="\"Zabir jest zaskoczony. 'Szczury cię znalazły? To niesamowite, że to się udało. Patrz na to.' powiedział Zabir pokazując ci złoty gwizdek. 'Dała mi go Królowa Szczurów. Musimy ją odnaleźć.'\"",shape=box,color=blue];
		j2591517893 -> j2288398369;
	j428275980 [label="\"Pytasz Zabira, jak się tu znalazł. 'Nie mamy na to czasu' odpowiada, 'musimy się stąd wydostać.'\"",shape=box,color=blue];
		j428275980 -> j3281039320;
		j428275980 -> j2539130919;
	j2207932207 [label="\"Zabir ogląda się za siebie, 'Idziemy do hangaru. Przejmiemy statek i uciekniemy najdalej, jak to możliwe. Musimy znaleźć Królową Szczurów.'\"",shape=box,color=blue];
		j2207932207 -> j2288398369;
	j2288398369 [label="KRÓLOWĄ SZCZURÓW?",shape=box,color=red];
		j2288398369 -> j1679571619;
	j1679571619 [label="\"'To ona dała mi ten gwizdek. Szczury go słuchają. Jest moją przyjaciółką. Nie zawsze jest miła, ale można na niej polegać.'\"",shape=box,color=blue];
		j1679571619 -> j1153858709;
		j1679571619 -> j2518992647;
	j1153858709 [label="Czy przypadkiem pokazywałaś to Lettie?",shape=box,color=red];
		j1153858709 -> j2217227801;
	j2518992647 [label="Brzmi dziwnie znajomo.",shape=box,color=red];
		j2518992647 -> j931099425;
	j2217227801 [label="za bardzo cenię sobie życie, żeby tak ryzykować",shape=box,color=blue];
		j2217227801 -> j2107793693;
	j931099425 [label="wszelkie podobieństwa do osób prawdziwych lub nie są tylko zbiegiem okoliczności",shape=box,color=blue];
		j931099425 -> j2107793693;
	j2107793693 [label="\"Z pomocą Zabira przemykacie przez korytarze asteroidy. Zwinne unika strażników i kamer.\"",shape=box,color=blue];
		j2107793693 -> j3847369246;
	j3847369246 [label="\"W końcu docieracie do ogromnych drzwi. Zabir daje sygnał, żebyś się schował. Wkradacie się do hangaru.\"",shape=box,color=blue];
		j3847369246 -> j3431849199;
	j3431849199 [label="\"Chowasz się w cieniu kolumny. Niedaleko słychać strażników Grineer.\"",shape=box,color=blue];
		j3431849199 -> j157517659;
	j157517659 [label="\"Co robisz?\"",shape=box,color=blue];
		j157517659 -> j175453172;
		j157517659 -> j1423461062;
	j175453172 [label="Atakuję strażników.",shape=box,color=red];
		j175453172 -> j710078407;
	j1423461062 [label="Rozglądam się.",shape=box,color=red];
		j1423461062 -> j4224556573;
	j710078407 [label="\"Bez krzty instynktu samozachowawczego wybiegasz w otwartą przestrzeń. Grupa strażników zaczyna do ciebie strzelać. Wbiegasz w ścianę pocisków, która natychmiastowo kończy twój żywot. Zabir tylko kiwa głową na widok twojego bezsensownego aktu odwagi.\"",shape=box,color=blue];
		j710078407 -> j974629188;
	j4224556573 [label="\"Wyglądasz zza rogu i badasz przestrzeń.\"",shape=box,color=blue];
		j4224556573 -> j541456716;
	j974629188 [label="chcesz spróbować jeszcze raz i może nie dać się zabić?",shape=box,color=blue];
		j974629188 -> j3838557743;
		j974629188 -> j569847713;
	j541456716 [label="\"Na środku hangaru stoi Railjack. Wejście na pokład jest zagrodzone przez strażnika. Bliżej ściany hangaru, tuzin Grineer jest głośno zajętych grą w kości. Niedaleko przed tobą znajduje się konsola z panelem sterowania.\"",shape=box,color=blue];
		j541456716 -> j503972798;
	j3838557743 [label="Tak zróbmy.",shape=box,color=red];
		j3838557743 -> j231680577;
	j569847713 [label="Mam dosyć na dzisiaj. [Koniec]",shape=box,color=red];
		j569847713 -> "Chat ends.";
	j503972798 [label="\"'Musimy otworzyć drzwi hangaru, żeby się stąd wydostać,' szepcze Zabir.\"",shape=box,color=blue];
