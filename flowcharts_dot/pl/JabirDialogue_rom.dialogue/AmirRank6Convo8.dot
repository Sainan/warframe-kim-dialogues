		j360514697 -> j3060137650;
	j2578958636 [label="\"Zabir podbiega do strażnika i razi go prądem. Pada jak worek ziemniaków.\"",shape=box,color=blue];
		j2578958636 -> j3028613594;
	j2934981206 [label="\"Przekradasz się do panelu sterowania i starasz się skorzystać z konsoli nie dając się zauważyć. Udaje ci się otworzyć drzwi hangaru.\"",shape=box,color=blue];
		j2934981206 -> j1362238544;
	j3060137650 [label="\"Wbrew zdrowemu rozsądkowi Zabir rzuca się do akcji. Nawet on nie jest wystarczająco szybki, aby przemknąć niezauważenie. Strażnicy zaczynają strzelać, a Zabir tragicznie ginie.\"",shape=box,color=blue];
