	4422 [label="Każę Zabirowi zaatakować strażnika na rampie.",shape=box,color=red];
		4422 -> 4426;
	4427 [label="\"Zabir przykłada gwizdek do ust i dmucha w niego. Siedzisz i czekasz, ale nic się nie dzieje. Żadnych szczurów, nic. Zabir wzrusza ramionami.\"",shape=box,color=blue];
		4427 -> 4432;
	4425 [label="\"Stajesz przy panelu sterowania, ale zauważa cię strażnik. Unosisz ręce nad głowę, próbując się poddać, ale zostajesz rozstrzelany na miejscu, bo Grineer to takie gnoje.\"",shape=box,color=blue];
		4425 -> 4429;
		4425 -> 4430;
	4428 [label="\"Rzucasz się w kierunku statku, ale zauważa cię strażnik i zaczyna strzelać. Twoje życie boleśnie się kończy.\"",shape=box,color=blue];
		4428 -> 4429;
		4428 -> 4433;
	4426 [label="och pewnie poślij amira na śmierć",shape=box,color=blue];
		4426 -> 4431;
	4432 [label="\"Wtedy słyszysz dźwięk chrupania. Jak żucie. Szczury nagle wlewają się do hangaru przez szyby wentylacyjne. Strażnicy Grineer wrzeszczą jak małe dzieci i zaczynają strzelać bez opamiętania. Kule latają wszędzie.\"",shape=box,color=blue];
		4432 -> 4437;
	4429 [label="Musze odpocząć. [Koniec]",shape=box,color=red];
		4429 -> 4434;
	4430 [label="Jeszcze jedno podejście.",shape=box,color=red];
		4430 -> 4435;
	4433 [label="Znowu!",shape=box,color=red];
		4433 -> 4438;
	4431 [label="znaczy zabir",shape=box,color=blue];
		4431 -> 4436;
	4437 [label="\"Szczury odciągają uwagę strażników. Co dalej?\"",shape=box,color=blue];
		4437 -> 4441;
