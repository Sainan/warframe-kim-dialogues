		4442 -> 4445;
	4439 [label="Chat ends.",color=orange];
	4440 [label="\"Krzyczysz do Zabira 'Załatw go!' wskazując na strażnika na rampie.\"",shape=box,color=blue];
		4440 -> 4443;
	4444 [label="\"Zabir podbiega do strażnika i razi go prądem. Pada jak worek ziemniaków.\"",shape=box,color=blue];
		4444 -> 4447;
	4445 [label="\"Przekradasz się do panelu sterowania i starasz się skorzystać z konsoli nie dając się zauważyć. Udaje ci się otworzyć drzwi hangaru.\"",shape=box,color=blue];
		4445 -> 4448;
	4443 [label="\"Wbrew zdrowemu rozsądkowi Zabir rzuca się do akcji. Nawet on nie jest wystarczająco szybki, aby przemknąć niezauważenie. Strażnicy zaczynają strzelać, a Zabir tragicznie ginie.\"",shape=box,color=blue];
