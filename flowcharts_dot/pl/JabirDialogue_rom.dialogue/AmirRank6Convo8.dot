	j388493005 [label="Każę Zabirowi zaatakować strażnika na rampie.",shape=box,color=red];
		j388493005 -> j1702441063;
	j1201379265 [label="\"Zabir przykłada gwizdek do ust i dmucha w niego. Siedzisz i czekasz, ale nic się nie dzieje. Żadnych szczurów, nic. Zabir wzrusza ramionami.\"",shape=box,color=blue];
		j1201379265 -> j854924214;
	j2617703445 [label="\"Stajesz przy panelu sterowania, ale zauważa cię strażnik. Unosisz ręce nad głowę, próbując się poddać, ale zostajesz rozstrzelany na miejscu, bo Grineer to takie gnoje.\"",shape=box,color=blue];
		j2617703445 -> j377757069;
		j2617703445 -> j2221633460;
	j1463337486 [label="\"Rzucasz się w kierunku statku, ale zauważa cię strażnik i zaczyna strzelać. Twoje życie boleśnie się kończy.\"",shape=box,color=blue];
		j1463337486 -> j377757069;
		j1463337486 -> j1061800135;
	j1702441063 [label="och pewnie poślij amira na śmierć",shape=box,color=blue];
		j1702441063 -> j4049174252;
	j854924214 [label="\"Wtedy słyszysz dźwięk chrupania. Jak żucie. Szczury nagle wlewają się do hangaru przez szyby wentylacyjne. Strażnicy Grineer wrzeszczą jak małe dzieci i zaczynają strzelać bez opamiętania. Kule latają wszędzie.\"",shape=box,color=blue];
		j854924214 -> j4173588366;
