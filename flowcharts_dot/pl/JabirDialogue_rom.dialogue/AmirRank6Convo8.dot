		4468 -> 4469;
	4469 [label="\"Szczury rozbiegają się po mostku, a ty spoglądasz w bezkres kosmosu i mówisz 'HIPERNAPĘD, AKTYWACJA'. Railjack znika w dystansie.\"",shape=box,color=blue];
