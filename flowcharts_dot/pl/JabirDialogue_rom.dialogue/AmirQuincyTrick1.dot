		j2068682612 -> j1563245622;
	j1055214872 [label="nagle zdaję sobie sprawę, że mam nową misję w życiu. muszę mieć robota-psa. muszę nazwać go fido. albo złomek. albo czip. CZIP!! CZIP TO NAJLEPSZE IMIĘ DLA ROBOTYCZNEGO PSA",shape=box,color=blue];
