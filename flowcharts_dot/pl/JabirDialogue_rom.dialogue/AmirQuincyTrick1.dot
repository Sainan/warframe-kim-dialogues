		j4154129395 -> j1055214872;
	j1943433315 [label="nooo cóóóż nie dam po sobie poznać, że zdradziłeś mi, co zrobił, po prostu tu posiedzę i będę udawał, że jestem super zajęty kodowaniem mojej gry lol",shape=box,color=blue];
		j1943433315 -> j2668516012;
