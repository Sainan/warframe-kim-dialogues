	3497 [label="Roboty.",shape=box,color=red];
		3497 -> 3499;
	3498 [label="Więc... Quincy robi ci psikusa, a ja jestem zmyłką.",shape=box,color=red];
		3498 -> 3500;
	3499 [label="ROBOTYROBOTYROBOTYROBOTYROBOTYROBOTYROBOTYROBOTYROBOTYROBOTYROBOTYROBOTYROBOTY",shape=box,color=blue];
		3499 -> 3501;
	3500 [label="co?!?!? psikus? co za... psikus...?",shape=box,color=blue];
		3500 -> 3502;
		3500 -> 3503;
	3501 [label="::kaszle:: to znaczy... takkkkkk??? a co z tymi robotami, o których mówiiiisz?",shape=box,color=blue];
		3501 -> 3504;
		3501 -> 3505;
	3502 [label="Wypełnia twój pokój wypełniaczami do paczek.",shape=box,color=red];
		3502 -> 3506;
	3503 [label="Szczerze? Myślę, że to sposób, w jaki pokazuje, że mu zależy.",shape=box,color=red];
		3503 -> 3507;
	3504 [label="Czy opowiadałem ci o gigantycznych robotach-pająkach na Wenus?",shape=box,color=red];
		3504 -> 3508;
	3505 [label="Czy opowiadałem już o psach-robotach?",shape=box,color=red];
		3505 -> 3509;
	3506 [label="ooooooo!! nikomu jeszcze nie zależało tak bardzo, żeby wypełnić mój pokój wypełniaczami do paczek!!!",shape=box,color=blue];
		3506 -> 3510;
	3507 [label="... ooooooo... to takie słodkie!!! Nikt nigdy nie lubił mnie na tyle, żeby zrobić mi psikusa!!!",shape=box,color=blue];
		3507 -> 3510;
	3508 [label="WYDAJE MI SIĘ, ŻE RAZ WIDZIAŁEM TAKI FILM",shape=box,color=blue];
		3508 -> 3511;
	3509 [label="masz. PSY. ROBOTY?!",shape=box,color=blue];
		3509 -> 3512;
	3510 [label="nooo cóóóż nie dam po sobie poznać, że zdradziłeś mi, co zrobił, po prostu tu posiedzę i będę udawał, że jestem super zajęty kodowaniem mojej gry lol",shape=box,color=blue];
		3510 -> 3524;
	3511 [label="ale to nie był film science fiction, tylko western. no dobra, ogólnie był kiepski, ale szczerze mówiąc, nawet mi się podobał?",shape=box,color=blue];
		3511 -> 3513;
	3512 [label="nagle zdaję sobie sprawę, że mam nową misję w życiu. muszę mieć robota-psa. muszę nazwać go fido. albo złomek. albo czip. CZIP!! CZIP TO NAJLEPSZE IMIĘ DLA ROBOTYCZNEGO PSA",shape=box,color=blue];
		3512 -> 3514;
	3524 [label="+20 Chemistry",color=orange];
		3524 -> 3526;
	3513 [label="mam na myśli, że wiedział, czym próbował *być*. nie traktował siebie zbyt poważnie, rozumiesz? nic nie kręci mnie bardziej niż film próbujący podszyć się pod prawdziwą sztukę a jest o kowbojach i występuje tam gigantyczny steampunkowy pająk lolol",shape=box,color=blue];
		3513 -> 3515;
	3514 [label="I BĘDĘ SIĘ Z TOBĄ KŁÓCIĆ, JEŚLI BĘDZIESZ GADAĆ INACZEJ",shape=box,color=blue];
		3514 -> 3516;
	3526 [label="heheeeeeee ale mam nadzieję, że on zdaje sobie sprawę, oczywiście... że. TO! oznacza... WOOOJNĘ!!!",shape=box,color=blue];
		3526 -> 3592;
	3515 [label="nie żeby ten film miał z tym coś wspólnego, bo nei miał. ale za to miał gigantycznego robota-pająka. chociaż jestem pewien, że te, o których mówisz, są o wieeeeeele bardziej zaawansowane technologicznie",shape=box,color=blue];
		3515 -> 3517;
	3516 [label="rozumiesz \"czip\" lol pies-robot, a komputery mają w sobie czipy, jak... czip komputerowy, rozumiesz? ... czy komputery w twojej erze w ogóle mają jeszcze czipy?",shape=box,color=blue];
		3516 -> 3518;
	3592 [label="{\"Id\":3592,\"Incoming\":[3526],\"Outgoing\":[3525],\"GraphPos\":[-11528,45678],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/QuincyDialogue_rom.dialogue\",\"Tag\":\"QuincyAmirTrick2\",\"Value\":0}]}",color=orange];
		3592 -> 3525;
	3517 [label="przepraszam. co mówiłeś?",shape=box,color=blue];
		3517 -> 3519;
	3518 [label="czy też wszystkie są oparte na dziwnym, organicznym i proto-mięsnym-Pustko-Płustgo-",shape=box,color=blue];
