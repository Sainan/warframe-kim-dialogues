		j3647017767 -> j3114553368;
	j1465028031 [label="\"Odwracasz się i patrzysz na lochy, dociera do ciebie, że powrót tam to głupi pomysł.\"",shape=box,color=blue];
		j1465028031 -> j3965893061;
	j3114553368 [label="\"Winda zawozi cię na górę. Przez kratę widzisz jak kamienne ściany lochu zamieniają się w coraz to bardziej zaawansowaną technologię. Zastanawiasz się, 'gdzie ja do cholery jestem?'\"",shape=box,color=blue];
		j3114553368 -> j908059343;
	j3965893061 [label="Haha... Dobra, wchodzę do windy.",shape=box,color=red];
		j3965893061 -> j3114553368;
	j908059343 [label="\"Winda zatrzymuje się przez salą bulgoczących maszyn i wielkich rur. Wygląda na swego rodzaju laboratorium.\"",shape=box,color=blue];
		j908059343 -> j4056835495;
	j4056835495 [label="Z pomieszczenia w głębi sali słyszysz mężczyznę krzyczącego z bólu.",shape=box,color=blue];
		j4056835495 -> j981691220;
		j4056835495 -> j1046935502;
	j981691220 [label="Ignoruję krzyki i szukam drogi wyjścia.",shape=box,color=red];
		j981691220 -> j1608947955;
	j1046935502 [label="Podążam za krzykami.",shape=box,color=red];
		j1046935502 -> j2885273341;
	j1608947955 [label="\"Przeszukujesz całą salę, a krzyki stają się coraz trudniejsze do zignorowania. Czujesz narastającą potrzebę pomocy temu człowiekowi.\"",shape=box,color=blue];
		j1608947955 -> j2885273341;
	j2885273341 [label="\"Udajesz się wgłąb sali do źródła wrzasków. Wchodzisz do pomieszczenia pełnego maszyn, w którym znajduje się nawet przystojny, uwiązany do maszyny mężczyzna. Pioruny tańczą na jego palcach i zdają się zasilać gigantyczną turbinę.\"",shape=box,color=blue];
		j2885273341 -> j1998133293;
		j2885273341 -> j2786494119;
	j1998133293 [label="Pytam \"co u ciebie?\"",shape=box,color=red];
		j1998133293 -> j612452170;
	j2786494119 [label="Przyglądam się temu mężczyźnie.",shape=box,color=red];
		j2786494119 -> j612452170;
	j612452170 [label="\"Mężczyzna jest uwiązany do wzniesionej platformy, jego ręce są rozłożone na bok. W jego palce wbite są sondy, które grubymi kablami łączą się z gigantyczną turbiną. Na jego palcach tańczą pioruny.\"",shape=box,color=blue];
		j612452170 -> j3570648187;
	j3570648187 [label="Pomiędzy krzykami i porażeniami prądem, mężczyzna daje radę wykrzyczeć \"ZATRZYMAJ... TURBINY!!\"",shape=box,color=blue];
