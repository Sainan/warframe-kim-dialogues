	4267 [label="Chat ends.",color=orange];
	4268 [label="\"Znajdujesz się przed dużą windą towarową. To coś więcej niż zwykłe lochy?\"",shape=box,color=blue];
		4268 -> 4269;
		4268 -> 4270;
