	4270 [label="Wchodzę do windy.",shape=box,color=red];
		4270 -> 4272;
	4271 [label="\"Odwracasz się i patrzysz na lochy, dociera do ciebie, że powrót tam to głupi pomysł.\"",shape=box,color=blue];
		4271 -> 4273;
	4272 [label="\"Winda zawozi cię na górę. Przez kratę widzisz jak kamienne ściany lochu zamieniają się w coraz to bardziej zaawansowaną technologię. Zastanawiasz się, 'gdzie ja do cholery jestem?'\"",shape=box,color=blue];
		4272 -> 4274;
	4273 [label="Haha... Dobra, wchodzę do windy.",shape=box,color=red];
		4273 -> 4272;
	4274 [label="\"Winda zatrzymuje się przez salą bulgoczących maszyn i wielkich rur. Wygląda na swego rodzaju laboratorium.\"",shape=box,color=blue];
		4274 -> 4275;
	4275 [label="Z pomieszczenia w głębi sali słyszysz mężczyznę krzyczącego z bólu.",shape=box,color=blue];
		4275 -> 4276;
		4275 -> 4277;
	4276 [label="Ignoruję krzyki i szukam drogi wyjścia.",shape=box,color=red];
		4276 -> 4278;
	4277 [label="Podążam za krzykami.",shape=box,color=red];
		4277 -> 4279;
	4278 [label="\"Przeszukujesz całą salę, a krzyki stają się coraz trudniejsze do zignorowania. Czujesz narastającą potrzebę pomocy temu człowiekowi.\"",shape=box,color=blue];
		4278 -> 4279;
	4279 [label="\"Udajesz się wgłąb sali do źródła wrzasków. Wchodzisz do pomieszczenia pełnego maszyn, w którym znajduje się nawet przystojny, uwiązany do maszyny mężczyzna. Pioruny tańczą na jego palcach i zdają się zasilać gigantyczną turbinę.\"",shape=box,color=blue];
		4279 -> 4280;
		4279 -> 4281;
	4280 [label="Pytam \"co u ciebie?\"",shape=box,color=red];
		4280 -> 4282;
	4281 [label="Przyglądam się temu mężczyźnie.",shape=box,color=red];
		4281 -> 4282;
	4282 [label="\"Mężczyzna jest uwiązany do wzniesionej platformy, jego ręce są rozłożone na bok. W jego palce wbite są sondy, które grubymi kablami łączą się z gigantyczną turbiną. Na jego palcach tańczą pioruny.\"",shape=box,color=blue];
		4282 -> 4283;
	4283 [label="Pomiędzy krzykami i porażeniami prądem, mężczyzna daje radę wykrzyczeć \"ZATRZYMAJ... TURBINY!!\"",shape=box,color=blue];
		4283 -> 4284;
