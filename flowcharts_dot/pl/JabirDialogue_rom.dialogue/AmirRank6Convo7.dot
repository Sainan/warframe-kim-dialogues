	j3931549990 [label="\"Kiedy przekręcasz klucz dany ci przez zaskakująco uprzejmą bandę ogromnych szczurów, modlisz się, aby to, co znajduje się za drzwiami, było lepsze od lochu, który znajduje się za tobą.\"",shape=box,color=blue];
		j3931549990 -> j1106270487;
	"Chat ends. Next chat will be AmirRank6Convo3." [color=orange];
	"Chat ends. Next chat will be AmirRank6Convo2." [color=orange];
	j1106270487 [label="\"Znajdujesz się przed dużą windą towarową. To coś więcej niż zwykłe lochy?\"",shape=box,color=blue];
		j1106270487 -> j849194769;
		j1106270487 -> j3647017767;
	j849194769 [label="Wracam do lochów.",shape=box,color=red];
