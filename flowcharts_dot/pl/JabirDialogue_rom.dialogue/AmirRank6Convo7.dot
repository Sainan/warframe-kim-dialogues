		4265 -> 4267;
	4266 [label="\"Kiedy przekręcasz klucz dany ci przez zaskakująco uprzejmą bandę ogromnych szczurów, modlisz się, aby to, co znajduje się za drzwiami, było lepsze od lochu, który znajduje się za tobą.\"",shape=box,color=blue];
