		j916075050 -> j2226799829;
	j1198272726 [label="PapaPolar: to nie jest uśmiech radości. to melancholijny uśmiech? ale",shape=box,color=blue];
		j1198272726 -> j3397831812;
	j133975801 [label="MomToxicated: To dobra odpowiedź, zgadzam się. Heh, co powiesz na kilka drinków?",shape=box,color=blue];
		j133975801 -> j2789546034;
	j2226799829 [label="MomToxicated: Teraz to naprawdę mówisz naszym językiem.",shape=box,color=blue];
		j2226799829 -> j3397831812;
	j3397831812 [label="PapaPolar: chciałbym do tego wrócić w przyszłości i podzielić się historyjkami o naszej córeczce",shape=box,color=blue];
		j3397831812 -> j866081372;
	j2789546034 [label="PapaPolar: teraz mówisz moim językiem",shape=box,color=blue];
		j2789546034 -> j3397831812;
	j866081372 [label="MomToxicated: A co do ciebie... Włóczęgo? Dziękujemy. Jeszcze raz. Za wszystko, co robisz.",shape=box,color=blue];
		j866081372 -> j3178296761;
	j3178296761 [label="PapaPolar: tak, serio, koleżko. nie wiem, czy kiedykolwiek zdołamy się odpłacić. ale jeśli nadarzy się okazja? będziemy tam.",shape=box,color=blue];
