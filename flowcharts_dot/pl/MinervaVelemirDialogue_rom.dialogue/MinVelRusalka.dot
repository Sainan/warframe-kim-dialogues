	"Chat ends." [color=orange];
	j1742144142 [label="Hej... ekipa?",shape=box,color=red];
		j1742144142 -> j451800378;
	j451800378 [label="MomToxicated: Tak?",shape=box,color=blue];
		j451800378 -> j4046918581;
	j4046918581 [label="PapaPolar: co się dzieje, koleżko?",shape=box,color=blue];
		j4046918581 -> j3779075987;
		j4046918581 -> j3054126885;
		j4046918581 -> j3464101635;
	j3779075987 [label="Chodzi o Neci. Mam dobre i złe wieści.",shape=box,color=red];
		j3779075987 -> j489056368;
	j3054126885 [label="Nie chcę dawać wam nadziei, ale mam wieści o Neci. Są... mieszane i niejednoznaczne.",shape=box,color=red];
		j3054126885 -> j615178610;
	j3464101635 [label="Ku... W sumie, nieważne. [Koniec]",shape=box,color=red];
		j3464101635 -> "Chat ends.";
	j489056368 [label="PapaPolar: zrób to jak dorosły. najpierw złe wieści.",shape=box,color=blue];
		j489056368 -> j545406381;
	j615178610 [label="+5 Chemistry",color=orange];
		j615178610 -> j756641842;
	j545406381 [label="MomToxicated: Zgadzam się, złe wieści mają pierwszeństwo.",shape=box,color=blue];
		j545406381 -> j2771185226;
	j756641842 [label="MomToxicated: Jak to zwykle w życiu bywa, ale dziękujemy za ostrzeżenie.",shape=box,color=blue];
		j756641842 -> j3568185260;
	j2771185226 [label="A więc, Obojętność udała się do Duviri i... zabrała Neci ze sobą.",shape=box,color=red];
		j2771185226 -> j182478814;
	j3568185260 [label="+5 Chemistry",color=orange];
		j3568185260 -> j1637402168;
	j182478814 [label="PapaPolar: chwila chwila chwila. ten bajkowy świat?",shape=box,color=blue];
		j182478814 -> j1755824423;
	j1637402168 [label="PapaPolar: szykuję się na złe wieści ale brzmi... jakby przynajmniej jeszcze żyła?",shape=box,color=blue];
		j1637402168 -> j1154233653;
	j1755824423 [label="MomToxicated: Świat, w którym młody dyktator wciąż cię zabijał?",shape=box,color=blue];
		j1755824423 -> j1590989841;
		j1755824423 -> j3049979963;
	j1154233653 [label="Nie wiem... Nie jestem pewien. Najpierw powiem, co wiem, a potem możecie to oceniać.",shape=box,color=red];
		j1154233653 -> j2771185226;
	j1590989841 [label="Okazuje się, że pomogło mu to dorosnąć? Ale nie o to chodzi.",shape=box,color=red];
		j1590989841 -> j3364508514;
	j3049979963 [label="Dokładnie ten.",shape=box,color=red];
		j3049979963 -> j3364508514;
	j3364508514 [label="Neci... objęła tron. Szept - coś jak \"armia\" Obojętności - dokonał najazdu, a ona przejęła władzę.",shape=box,color=red];
		j3364508514 -> j3735792964;
	j3735792964 [label="MomToxicated: Heh. Moja córeczka.",shape=box,color=blue];
		j3735792964 -> j3801981809;
	j3801981809 [label="PapaPolar: ale czy to naprawdę była *ona*? czy to coś jedynie nosiło jej twarz?",shape=box,color=blue];
		j3801981809 -> j338125870;
		j3801981809 -> j416563673;
	j338125870 [label="Nie wiem.",shape=box,color=red];
		j338125870 -> j1148142460;
	j416563673 [label="O tym chcę z wami porozmawiać.",shape=box,color=red];
		j416563673 -> j1148142460;
	j1148142460 [label="Odnalazłem te zapisy. Na początku zdawały się nie mieć sensu, ale kiedy poskładałem je do kupy... odczytałem taką wiadomość.",shape=box,color=red];
		j1148142460 -> j3609460363;
	j3609460363 [label="Zastanawiałem się, czy ma to dla was więcej sensu.",shape=box,color=red];
		j3609460363 -> j2159917313;
	j2159917313 [label="MomToxicated: Zagadki i dziwne wiadomości? Mówisz naszym językiem.",shape=box,color=blue];
		j2159917313 -> j960479887;
	j960479887 [label="PapaPolar: 0202122-szpiegowskie gówno, trafiłeś pod właściwy adres",shape=box,color=blue];
		j960479887 -> j3058143481;
	j3058143481 [label="\"Kiedy Sol i Lua zejdą się, zagubieni odnajdą drogę do domu.\"",shape=box,color=red];
		j3058143481 -> j2098962766;
	j2098962766 [label="PapaPolar: ...cholera. M. CHOLERA.",shape=box,color=blue];
		j2098962766 -> j2725546199;
	j2725546199 [label="MomToxicated: Nie daj się nabrać. Jeśli to coś weszło jej do głowy, to wie to co ona.",shape=box,color=blue];
		j2725546199 -> j130312999;
		j2725546199 -> j3758719904;
	j130312999 [label="Co? Co to znaczy?",shape=box,color=red];
		j130312999 -> j670448289;
	j3758719904 [label="To ta druga połowa, prawda?",shape=box,color=red];
		j3758719904 -> j1771286435;
	j670448289 [label="PapaPolar: \"Na rozstaju dróg, podążaj za zaćmieniem.\"",shape=box,color=blue];
		j670448289 -> j3396071594;
	j1771286435 [label="+5 Chemistry",color=orange];
		j1771286435 -> j2280527851;
	j3396071594 [label="PapaPolar: hasło, które kazałem ci przekazać, gdybyś znowu trafił na naszą córeczkę.",shape=box,color=blue];
		j3396071594 -> j1872185528;
	j2280527851 [label="PapaPolar: dokładnie tak...",shape=box,color=blue];
		j2280527851 -> j4011396334;
	j1872185528 [label="PapaPolar: to była połowa naszego hasła. od tego zaczynaliśmy rozmowy, aby mieć pewność, że linia jest bezpieczna i wszystko jest w porządku",shape=box,color=blue];
		j1872185528 -> j1988289958;
	j4011396334 [label="PapaPolar: mieliśmy swoje hasło. od tego zaczynaliśmy rozmowy, aby mieć pewność, że linia jest bezpieczna i wszystko jest w porządku",shape=box,color=blue];
		j4011396334 -> j1988289958;
	j1988289958 [label="MomToxicated: Że byliśmy... sobą.",shape=box,color=blue];
		j1988289958 -> j3044668102;
	j3044668102 [label="PapaPolar: \"Na rozstaju dróg, podążaj za zaćmieniem\" było naszą połową.",shape=box,color=blue];
		j3044668102 -> j586498286;
	j586498286 [label="MomToxicated: \"Kiedy Sol i Lua zejdą się, zagubieni odnajdą drogę do domu\" było drugą połową.",shape=box,color=blue];
		j586498286 -> j155910208;
	j155910208 [label="MomToxicated: *Jej* połową.",shape=box,color=blue];
		j155910208 -> j3355947626;
		j155910208 -> j1309867907;
	j3355947626 [label="Ale nie możemy mieć pewności, że to była ona, Minerwo. Obojętność wie wszystko, co ona.",shape=box,color=red];
		j3355947626 -> j2017129296;
	j1309867907 [label="Nie wiem, dlaczego Obojętność miałaby ci to powiedzieć...",shape=box,color=red];
		j1309867907 -> j385660338;
	j2017129296 [label="MomToxicated: Dlaczego miałaby dawać nam poczucie nadziei? Tylko po to, żeby nas zranić?",shape=box,color=blue];
		j2017129296 -> j2118851007;
	j385660338 [label="MomToxicated: Dla fałszywej nadziei? Żeby nas zranić?",shape=box,color=blue];
		j385660338 -> j2166870172;
	j2118851007 [label="PapaPolar: czy to bolesne?",shape=box,color=blue];
		j2118851007 -> j3606794791;
	j2166870172 [label="PapaPolar: ale czy to kłamstwo? czy to bolesne?",shape=box,color=blue];
		j2166870172 -> j3606794791;
	j3606794791 [label="PapaPolar: a może to jakiś rodzaj spokoju, świadomość, że nasza mała dziewczynka wciąż gdzieś tam żyje?",shape=box,color=blue];
		j3606794791 -> j2480963645;
	j2480963645 [label="PapaPolar: że pomimo przeciwności losu, ona nadal świetnie sobie radzi?",shape=box,color=blue];
		j2480963645 -> j3647247855;
	j3647247855 [label="PapaPolar: nawet jeśli nie jest z nami?",shape=box,color=blue];
		j3647247855 -> j992976546;
	j992976546 [label="PapaPolar: to raduje moje głupie serce, nie wiem jak ty.",shape=box,color=blue];
		j992976546 -> j1965918225;
	j1965918225 [label="PapaPolar: i coś mówi mi, że ta obojętność nie jest takim zachowaniem zainteresowana",shape=box,color=blue];
		j1965918225 -> j316600888;
	j316600888 [label="MomToxicated: Masz rację. Usłyszeć to, myśleć, że ona nadal *może* tam być. To nie sprawia mi cierpienia.",shape=box,color=blue];
		j316600888 -> j3883470932;
	j3883470932 [label="MomToxicated: Jestem z niej dumna.",shape=box,color=blue];
		j3883470932 -> j1878139113;
		j3883470932 -> j21447077;
		j3883470932 -> j1993661760;
	j1878139113 [label="Nawet jeśli jest zakładnikiem Obojętności?",shape=box,color=red];
		j1878139113 -> j3740853310;
	j21447077 [label="Nawet jeśli to podstęp ze strony Obojętności?",shape=box,color=red];
		j21447077 -> j93079910;
	j1993661760 [label="Istnieje szansa, że dobrowolnie współpracuje z Obojętnością.",shape=box,color=red];
		j1993661760 -> j1615395225;
	j3740853310 [label="PapaPolar: nie doceniasz naszej córki, jest twarda jak skała",shape=box,color=blue];
		j3740853310 -> j2696485921;
	j93079910 [label="MomToxicated: Co? Po co? Co mogłaby tym zyskać?",shape=box,color=blue];
		j93079910 -> j4200666205;
	j1615395225 [label="MomToxicated: I wtedy miałaby u boku jednego z najpotężniejszych sojuszników na świecie. We wszechświecie. Jeśli wybrała stronę, my też.",shape=box,color=blue];
		j1615395225 -> j824086364;
	j2696485921 [label="PapaPolar: i założę się, że \"pan ze ściany\" to wiedział i dlatego ją zabrał",shape=box,color=blue];
		j2696485921 -> j1735244950;
	j4200666205 [label="PapaPolar: to coś pewnie nawet nas nie zauważa, co jest dla nas bardzo korzystne",shape=box,color=blue];
		j4200666205 -> j591682759;
	j824086364 [label="MomToxicated: Mamy nadzieję, że nigdy nie będziemy zmuszeni mierzyć do siebie z broni. Ale jeśli do tego dojdzie? Jakoś sobie poradzimy.",shape=box,color=blue];
		j824086364 -> j3564833659;
	j1735244950 [label="PapaPolar: nic jej nie będzie. albo dawno jej nie ma, albo osiągnęli jakieś porozumienie. albo to on jest jej zakładnikiem lol",shape=box,color=blue];
		j1735244950 -> j591682759;
	j591682759 [label="MomToxicated: Nie, myślę, że ta wiadomość była prawdziwa. Myślę, że pochodzi od naszej córeczki. Daje nam znać... że nadal tam jest.",shape=box,color=blue];
		j591682759 -> j4074220083;
	j3564833659 [label="PapaPolar: potrafi o siebie zadbać. tak ją wychowaliśmy",shape=box,color=blue];
		j3564833659 -> j591682759;
	j4074220083 [label="MomToxicated: Na swój sposób mówi, że wszystko z nią w porządku.",shape=box,color=blue];
		j4074220083 -> j658392023;
	j658392023 [label="MomToxicated: Że nie musimy się o nią martwić.",shape=box,color=blue];
		j658392023 -> j1168686265;
	j1168686265 [label="PapaPolar: heh, jakbyśmy kiedykolwiek mogli się o nią martwić",shape=box,color=blue];
		j1168686265 -> j390413415;
	j390413415 [label="MomToxicated: Przekleństwo i błogosławieństwo bycia rodzicem.",shape=box,color=blue];
		j390413415 -> j3717534076;
	j3717534076 [label="PapaPolar: marzyły ci się kiedyś dzieci, włóczęgo? eeeh, w sumie nie odpowiadaj. to pewnie jeszcze więcej tego szaleństwa pustki.",shape=box,color=blue];
