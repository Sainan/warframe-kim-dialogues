		j3706059679 -> j418929271;
	j418929271 [label="Wiedziałam, że był z przyszłości. On wiedział, że ja wiedziałam. Pozwolił mi na wybór czy coś. I tak znalazłam ciebie. ",shape=box,color=blue];
