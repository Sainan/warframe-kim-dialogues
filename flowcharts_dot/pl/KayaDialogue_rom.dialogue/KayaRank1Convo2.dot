		j2446368968 -> j1847082542;
	j920677160 [label="Ugh. Internet? Mam swoje podejrzenia, jak mogłoby to działać z właściwościami sieci...",shape=box,color=blue];
		j920677160 -> j1847082542;
	j1847082542 [label="Niczego nie mogę być pewien. Wiem, że była sekwencja, że Entrati miał plan i uwzględniał on mnie, tu o teraz. Musiałem się tu dostać i poznać was.",shape=box,color=red];
		j1847082542 -> j916192046;
	j916192046 [label="W porządku, ale dlaczego istnieje tu połączenie internetowe, które w jego notkach jest opisane jako konieczne?",shape=box,color=blue];
