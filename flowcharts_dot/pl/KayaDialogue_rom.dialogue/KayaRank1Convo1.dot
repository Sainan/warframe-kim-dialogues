		j3136722261 -> j3994321362;
	j1915320944 [label="W porządku. ",shape=box,color=blue];
		j1915320944 -> j2076080089;
	j96938664 [label="W porządku. Ale nadal jesteś najmłodsza w ekipie, dzieciaku.",shape=box,color=red];
		j96938664 -> j2502693250;
	j3994321362 [label="Tak tak, nie pchaj się w podróż w czasie. To... skomplikowana sprawa.",shape=box,color=red];
		j3994321362 -> j1070214852;
	j2076080089 [label="A więc. Tylko ty? Są inni? Uczą was w szkołach podróży w czasie?",shape=box,color=blue];
		j2076080089 -> j3050599373;
	j2502693250 [label="Ugh. Najmłodsza, spoko, ale też najwyraźniej najbardziej chętna do znalezienia odpowiedzi. Spróbuj nadążać. A więc: Podróż w czasie. Kto i jak?",shape=box,color=blue];
		j2502693250 -> j310856009;
	j1070214852 [label="Ugh. Jak bardzo? Wzory matematyczne? Chemiczne? Po prostu skieruj mnie na problem, to go rozgryzę.",shape=box,color=blue];
		j1070214852 -> j405107491;
		j1070214852 -> j203915199;
	j3050599373 [label="Powiedzmy, że tylko ja. Tak będzie prościej.",shape=box,color=red];
		j3050599373 -> j424745704;
	j310856009 [label="I dlaczego ty? Masz jakiś plan? ",shape=box,color=blue];
		j310856009 -> j3514641845;
	j405107491 [label="Nie wiem co ci powiedzieć. To nie tylko dziedzina nauki, a jeśli jednak, to nauka, którą zna tylko Entrati.",shape=box,color=red];
		j405107491 -> j2663706293;
	j203915199 [label="Już pokazuję ci problem: Twoje podejście. [Koniec]",shape=box,color=red];
		j203915199 -> j2547432773;
	j424745704 [label="A co do nauki w szkołach, jeśli tak, to się tego nie uczyłem. Ale mogła się pojawić? ",shape=box,color=red];
		j424745704 -> j2680885410;
	j3514641845 [label="A jeśli nie, co polecasz, aby mogła naukowo podejść do twoich zdolności?",shape=box,color=blue];
		j3514641845 -> j1126828970;
	j2663706293 [label="Ugh, ta szuja. Wiedziałam, że powinnam była męczyć go o więcej odpowiedzi. Okej. Jeśli to nauka, to da się to odtworzyć, a ponieważ możesz odejść i powrócić, jakoś to rozwikłam. Papatki.",shape=box,color=blue];
		j2663706293 -> j2547432773;
	j2547432773 [label="+20 Chemistry",color=orange];
