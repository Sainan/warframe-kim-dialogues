digraph {
	0 [label="KayaRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Cześć. Wszyscy potrafią podróżować w czasie, czy tylko ty?",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="Też miło cię poznać. Posłuchaj, dziecko, to nie jest takie proste.",shape=box,color=red];
		2 -> 4;
	3 [label="Cześć? Kaya, tak? Też miło cię poznać.",shape=box,color=red];
		3 -> 5;
	4 [label="Nie jestem dzieckiem. Mam 19 lat.",shape=box,color=blue];
		4 -> 6;
		4 -> 7;
	5 [label="W porządku. ",shape=box,color=blue];
		5 -> 8;
	6 [label="W porządku. Ale nadal jesteś najmłodsza w ekipie, dzieciaku.",shape=box,color=red];
		6 -> 9;
	7 [label="Tak tak, nie pchaj się w podróż w czasie. To... skomplikowana sprawa.",shape=box,color=red];
		7 -> 10;
	8 [label="A więc. Tylko ty? Są inni? Uczą was w szkołach podróży w czasie?",shape=box,color=blue];
		8 -> 11;
	9 [label="Ugh. Najmłodsza, spoko, ale też najwyraźniej najbardziej chętna do znalezienia odpowiedzi. Spróbuj nadążać. A więc: Podróż w czasie. Kto i jak?",shape=box,color=blue];
		9 -> 12;
	10 [label="Ugh. Jak bardzo? Wzory matematyczne? Chemiczne? Po prostu skieruj mnie na problem, to go rozgryzę.",shape=box,color=blue];
		10 -> 13;
		10 -> 14;
	11 [label="Powiedzmy, że tylko ja. Tak będzie prościej.",shape=box,color=red];
		11 -> 15;
	12 [label="I dlaczego ty? Masz jakiś plan? ",shape=box,color=blue];
		12 -> 16;
	13 [label="Nie wiem co ci powiedzieć. To nie tylko dziedzina nauki, a jeśli jednak, to nauka, którą zna tylko Entrati.",shape=box,color=red];
		13 -> 17;
	14 [label="Już pokazuję ci problem: Twoje podejście. [Koniec]",shape=box,color=red];
		14 -> 1022;
	15 [label="A co do nauki w szkołach, jeśli tak, to się tego nie uczyłem. Ale mogła się pojawić? ",shape=box,color=red];
		15 -> 18;
	16 [label="A jeśli nie, co polecasz, aby mogła naukowo podejść do twoich zdolności?",shape=box,color=blue];
		16 -> 19;
	17 [label="Ugh, ta szuja. Wiedziałam, że powinnam była męczyć go o więcej odpowiedzi. Okej. Jeśli to nauka, to da się to odtworzyć, a ponieważ możesz odejść i powrócić, jakoś to rozwikłam. Papatki.",shape=box,color=blue];
		17 -> 20;
	1022 [label="+20 Chemistry",color=orange];
		1022 -> 1018;
	18 [label="A co, zamarzyła ci się praca domowa? Podróż w czasie to trochę zbyt skomplikowany temat na teraz...",shape=box,color=red];
		18 -> 21;
	19 [label="Tak wiele pytań. Dzieciaku, przykro mi to mówić ale... nie wiem. Tylko Entrati wie.",shape=box,color=red];
		19 -> 22;
	20 [label="+20 Chemistry",color=orange];
		20 -> 1015;
	1018 [label="{\"Id\":1018,\"Incoming\":[1022],\"Outgoing\":[1023],\"GraphPos\":[3236,718],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1018 -> 1023;
	21 [label="Ugh, ty tak na poważnie?",shape=box,color=blue];
		21 -> 24;
	22 [label="Update boolean KayaSetKid",color=orange];
		22 -> 25;
	1015 [label="{\"Id\":1015,\"Incoming\":[20],\"Outgoing\":[23],\"GraphPos\":[3252,817],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		1015 -> 23;
	1023 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	24 [label="Ktokolwiek z Hexów to rozgryzł? Wiedzą coś więcej? ",shape=box,color=blue];
		24 -> 26;
		24 -> 27;
	25 [label="K.",shape=box,color=blue];
		25 -> 28;
	23 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	26 [label="Może Amir? Ale bardziej siedzi w grach niż w podróży przez czas...",shape=box,color=red];
		26 -> 29;
	27 [label="Nie wydaje mi się. Ale jeśli chcesz dowiedzieć się czegoś użytecznego, zapytaj Lettie o krótki kurs pierwszej pomocy.",shape=box,color=red];
		27 -> 30;
	28 [label="+20 Chemistry",color=orange];
		28 -> 996;
	29 [label="Update boolean KayaAmirTravel",color=orange];
		29 -> 32;
	30 [label="Update boolean KayaLettieHeal",color=orange];
		30 -> 33;
	996 [label="{\"Id\":996,\"Incoming\":[28],\"Outgoing\":[31],\"GraphPos\":[4241,541],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		996 -> 31;
	32 [label="Gry? Potrzebuję odpowiedzi, celu, czegokolwiek. Rozgryzę to. Jeśli wpadniesz na cokolwiek UŻYTECZNEGO, wiesz gdzie mnie szukać.",shape=box,color=blue];
		32 -> 34;
	33 [label="Nie mój styl. Nieważne.",shape=box,color=blue];
		33 -> 35;
	31 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
	34 [label="+20 Chemistry",color=orange];
		34 -> 998;
	35 [label="+20 Chemistry",color=orange];
		35 -> 997;
	998 [label="{\"Id\":998,\"Incoming\":[34],\"Outgoing\":[36],\"GraphPos\":[5087,255],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		998 -> 36;
	997 [label="{\"Id\":997,\"Incoming\":[35],\"Outgoing\":[37],\"GraphPos\":[4970,380],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue\",\"Tag\":\"HexKayaConvo1\",\"Value\":0}]}",color=orange];
		997 -> 37;
	36 [label="Chat ends. Next chat will be KayaRank1Convo2.",color=orange];
