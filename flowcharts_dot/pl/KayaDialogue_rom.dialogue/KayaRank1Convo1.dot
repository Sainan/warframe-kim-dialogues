	edge [fontname="Roboto Condensed"];

	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j1768192422;
	j1768192422 [label="Cześć. Wszyscy potrafią podróżować w czasie, czy tylko ty?",shape=box,color=blue];
		j1768192422 -> j2037373843;
		j1768192422 -> j3550570166;
	j2037373843 [label="Też miło cię poznać. Posłuchaj, dziecko, to nie jest takie proste.",shape=box,color=red];
		j2037373843 -> j3136722261;
	j3550570166 [label="Cześć? Kaya, tak? Też miło cię poznać.",shape=box,color=red];
		j3550570166 -> j1915320944;
	j3136722261 [label="Nie jestem dzieckiem. Mam 19 lat.",shape=box,color=blue];
		j3136722261 -> j2860013125;
		j3136722261 -> j3994321362;
	j1915320944 [label="W porządku. ",shape=box,color=blue];
		j1915320944 -> j2076080089;
	j2860013125 [label="W porządku. Ale nadal jesteś najmłodsza w ekipie, dzieciaku.",shape=box,color=red];
		j2860013125 -> j4013250578;
	j3994321362 [label="Tak tak, nie pchaj się w podróż w czasie. To... skomplikowana sprawa.",shape=box,color=red];
		j3994321362 -> j1070214852;
	j2076080089 [label="A więc. Tylko ty? Są inni? Uczą was w szkołach podróży w czasie?",shape=box,color=blue];
		j2076080089 -> j3050599373;
	j4013250578 [label="Ugh. Najmłodsza, spoko, ale też najwyraźniej najbardziej chętna do znalezienia odpowiedzi. Spróbuj nadążać. A więc: Podróż w czasie. Kto i jak?",shape=box,color=blue];
		j4013250578 -> j1474609839;
	j1070214852 [label="Ugh. Jak bardzo? Wzory matematyczne? Chemiczne? Po prostu skieruj mnie na problem, to go rozgryzę.",shape=box,color=blue];
		j1070214852 -> j1109876066;
		j1070214852 -> j3662801817;
	j3050599373 [label="Powiedzmy, że tylko ja. Tak będzie prościej.",shape=box,color=red];
		j3050599373 -> j424745704;
	j1474609839 [label="I dlaczego ty? Masz jakiś plan? ",shape=box,color=blue];
		j1474609839 -> j468931627;
	j1109876066 [label="Nie wiem co ci powiedzieć. To nie tylko dziedzina nauki, a jeśli jednak, to nauka, którą zna tylko Entrati.",shape=box,color=red];
		j1109876066 -> j3158218023;
	j3662801817 [label="Już pokazuję ci problem: Twoje podejście. [Koniec]",shape=box,color=red];
		j3662801817 -> j2938341431;
	j424745704 [label="A co do nauki w szkołach, jeśli tak, to się tego nie uczyłem. Ale mogła się pojawić? ",shape=box,color=red];
		j424745704 -> j2680885410;
	j468931627 [label="A jeśli nie, co polecasz, aby mogła naukowo podejść do twoich zdolności?",shape=box,color=blue];
		j468931627 -> j3468386974;
	j3158218023 [label="Ugh, ta szuja. Wiedziałam, że powinnam była męczyć go o więcej odpowiedzi. Okej. Jeśli to nauka, to da się to odtworzyć, a ponieważ możesz odejść i powrócić, jakoś to rozwikłam. Papatki.",shape=box,color=blue];
		j3158218023 -> j2938341431;
	j2938341431 [label="+20 Chemistry",color=orange];
		j2938341431 -> "Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue";
	j2680885410 [label="A co, zamarzyła ci się praca domowa? Podróż w czasie to trochę zbyt skomplikowany temat na teraz...",shape=box,color=red];
		j2680885410 -> j4220394217;
	j3468386974 [label="Tak wiele pytań. Dzieciaku, przykro mi to mówić ale... nie wiem. Tylko Entrati wie.",shape=box,color=red];
		j3468386974 -> j285977890;
	"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" [label="Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue",color=orange];
		"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j4220394217 [label="Ugh, ty tak na poważnie?",shape=box,color=blue];
		j4220394217 -> j796383435;
	j285977890 [label="Boolean KayaSetKid is now true.",color=orange];
		j285977890 -> j1219546166;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j796383435 [label="Ktokolwiek z Hexów to rozgryzł? Wiedzą coś więcej? ",shape=box,color=blue];
		j796383435 -> j3265498403;
		j796383435 -> j3009048230;
	j1219546166 [label="K.",shape=box,color=blue];
		j1219546166 -> j2938341431;
	j3265498403 [label="Może Amir? Ale bardziej siedzi w grach niż w podróży przez czas...",shape=box,color=red];
		j3265498403 -> j2457784795;
	j3009048230 [label="Nie wydaje mi się. Ale jeśli chcesz dowiedzieć się czegoś użytecznego, zapytaj Lettie o krótki kurs pierwszej pomocy.",shape=box,color=red];
		j3009048230 -> j804045217;
	j2457784795 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j2457784795 -> j917612992;
	j804045217 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j804045217 -> j1094890518;
	j917612992 [label="Gry? Potrzebuję odpowiedzi, celu, czegokolwiek. Rozgryzę to. Jeśli wpadniesz na cokolwiek UŻYTECZNEGO, wiesz gdzie mnie szukać.",shape=box,color=blue];
		j917612992 -> j2938341431;
	j1094890518 [label="Nie mój styl. Nieważne.",shape=box,color=blue];
		j1094890518 -> j2938341431;
}