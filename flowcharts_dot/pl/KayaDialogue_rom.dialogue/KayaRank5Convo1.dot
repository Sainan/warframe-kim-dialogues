	784 [label="+20 Chemistry",color=orange];
		784 -> 787;
	785 [label="Tyczy się to bardziej stanów materii i hipotezy, że Pustka nie jest \"liniowa\" w naszym rozumowaniu. Powinno mi to umożliwić odbicie się od niej jak od trampoliny, aby wrócić Z TOBĄ.",shape=box,color=blue];
		785 -> 788;
	786 [label="Wielkie, ogromne, gigantyczne! Oznacza to więź materii między PUSTKĄ i TERAŹNIEJSZOŚCIĄ. Atomy, Materia, są SPÓJNE w obu tych sferach. ",shape=box,color=blue];
