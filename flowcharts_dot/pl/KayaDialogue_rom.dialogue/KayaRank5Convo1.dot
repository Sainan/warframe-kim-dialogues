		j1099641937 -> j2875840054;
	j1352072532 [label="Właśnie. Bez względu na to, ile razy powtórzę testy czy sprawdzę obliczenia, wciąż brakuje w nich \"punktu odniesienia\". Wyskok z trampoliny musi gdzieś wylądować, a kiedy już na dobre wrócisz do siebie, to powinno wystarczyć mi do kalibracji. ",shape=box,color=blue];
		j1352072532 -> j1933957196;
		j1352072532 -> j3462516752;
	j1933957196 [label="Mam nadzieję, że zrobisz salto! Już szykuję punkt odniesienia. ",shape=box,color=red];
		j1933957196 -> j1650806204;
	j3462516752 [label="Zwolnij, nie wiem, czy to dobry pomysł. A co jeśli się zgubisz, albo utkniesz?! ",shape=box,color=red];
		j3462516752 -> j3551989603;
	j1650806204 [label="Oczywiście nie jestem jeszcze gotowa. Jak to mówią, mierz dwa razy, tnij raz. W tym przypadku... mierz tysiąc razy. ",shape=box,color=blue];
