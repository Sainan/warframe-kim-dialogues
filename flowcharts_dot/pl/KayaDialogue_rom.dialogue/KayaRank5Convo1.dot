		j1214799678 -> j4123196853;
	j1163897995 [label="Och, oczywiście. Jesteś świetną nauczycielką. Ale póki co chyba jedyne, czego kogoś nauczyłaś, to Minerwy i nowych metod picia.",shape=box,color=red];
		j1163897995 -> j1534992844;
