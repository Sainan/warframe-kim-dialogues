		789 -> 788;
	790 [label="Właśnie. Bez względu na to, ile razy powtórzę testy czy sprawdzę obliczenia, wciąż brakuje w nich \"punktu odniesienia\". Wyskok z trampoliny musi gdzieś wylądować, a kiedy już na dobre wrócisz do siebie, to powinno wystarczyć mi do kalibracji. ",shape=box,color=blue];
		790 -> 791;
