		j1110292999 -> j4123277255;
		j1110292999 -> j2240434234;
	j134785547 [label="Widziałam. Obserwowałam. Robiłam notatki. Badałam i zbadałam ponownie. Mhmm. To wszystko można wyjaśnić. Wszystko bierze się skądś. Może nawet z \"magii\".",shape=box,color=blue];
