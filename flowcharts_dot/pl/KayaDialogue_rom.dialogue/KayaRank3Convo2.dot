	j637264745 [label="+5 Chemistry",color=orange];
		j637264745 -> j3875786889;
	j121611619 [label="To była PIERWSZA rzecz, jaką opublikowano w internecie. Pierwsza wiadomość przesłana przez samego twórcę, aby potwierdzić, że wszystko \"działa\".",shape=box,color=blue];
		j121611619 -> j3641846874;
	j2976870437 [label="Ostrzegałem cię, żebyś była ostrożna z Pustką. Właśnie przez to.",shape=box,color=red];
		j2976870437 -> j2441457840;
	j1804866144 [label="A co, jeśli tego nie wytłumaczy?",shape=box,color=red];
		j1804866144 -> j723858082;
	j3875786889 [label="Ha! Chciałabym, omg. Ale znasz \"Witaj Świecie\"?",shape=box,color=blue];
		j3875786889 -> j121611619;
	j3641846874 [label="A potem było już tylko gorzej. Ludzie POWARIOWALI. Nauka. Bankowość. Technologia. Rozrywka.",shape=box,color=blue];
		j3641846874 -> j1367296129;
	j2441457840 [label="Niektórych rzeczy nie da się kontrolować.",shape=box,color=red];
		j2441457840 -> j2387511638;
	j723858082 [label="Co, jeśli świat kieruje się znanymi przez ciebie zasadami...",shape=box,color=red];
		j723858082 -> j2388590920;
	j1367296129 [label="Miliardy trzepoczących skrzydeł motyli doprowadziły do tego, że zasiadłam wtedy do komputera i... ",shape=box,color=blue];
		j1367296129 -> j1182996393;
	j2387511638 [label="Niektórych rzeczy nie da się wyjaśnić.",shape=box,color=red];
		j2387511638 -> j2462700749;
	j2388590920 [label="Tylko dlatego, że coś chciało, aby tak było.",shape=box,color=red];
		j2388590920 -> j2462700749;
	j1182996393 [label="I to był koniec Novy, albo raczej Kayi. Jej przyszłości, kariery, przyjaciół, wszystkiego. Wszystko przez jeden błąd. ",shape=box,color=blue];
		j1182996393 -> j1021350657;
	j2462700749 [label="Więc mówisz, że brakującą częścią moich eksperymentów, testów, badań i hipotez jest \"magia\".",shape=box,color=blue];
		j2462700749 -> j4173728614;
		j2462700749 -> j2070356851;
	j1021350657 [label="Więc chyba bardziej wolę zaufać Pustce niż innym ludziom.",shape=box,color=blue];
