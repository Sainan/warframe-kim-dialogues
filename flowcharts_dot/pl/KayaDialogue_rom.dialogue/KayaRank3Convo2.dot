		500 -> 504;
		500 -> 505;
	501 [label="Widziałam. Obserwowałam. Robiłam notatki. Badałam i zbadałam ponownie. Mhmm. To wszystko można wyjaśnić. Wszystko bierze się skądś. Może nawet z \"magii\".",shape=box,color=blue];
