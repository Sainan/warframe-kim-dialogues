		j4273662861 -> j1906539369;
	"Chat ends. Next chat will be KayaRank3Convo3." [color=orange];
	j1906539369 [label="No, może jednak tak to się zaczęło.",shape=box,color=red];
		j1906539369 -> j898849465;
	j898849465 [label="Ale to wszystko? To coś więcej. Wszystko to jest spowodowane tym, że Albrecht poszedł gdzieś, obudził coś i sprowadził to ze sobą z powrotem. Pustkę.",shape=box,color=red];
		j898849465 -> j1510230360;
		j898849465 -> j2982268363;
	j1510230360 [label="Pustka jest żywa, ale też nie. Istnieje, ale i nie. To paradoks, który jest powodem wszystkiego, co nas wszystkich dotknęło.",shape=box,color=red];
		j1510230360 -> j2448642801;
	j2982268363 [label="Nie ma na nią miejsca na tablicy pierwiastków.",shape=box,color=red];
		j2982268363 -> j3357864208;
	j2448642801 [label="Witaj Świecie.",shape=box,color=blue];
		j2448642801 -> j3323707229;
		j2448642801 -> j2845123971;
	j3357864208 [label="Nauka może to wyjaśnić. Nauka rządzi wszystkim.",shape=box,color=blue];
		j3357864208 -> j3668359530;
	j3323707229 [label="\"Żegnaj Albrechcie\"",shape=box,color=red];
		j3323707229 -> j637264745;
