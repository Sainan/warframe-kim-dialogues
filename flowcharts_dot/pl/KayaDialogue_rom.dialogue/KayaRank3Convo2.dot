	480 [label="Check boolean KayaVoidTest",color=orange];
		480 -> 484 [label=true,color=green];
		480 -> 483 [label=false,color=brown];
	481 [label="+5 Chemistry",color=orange];
		481 -> 485;
	482 [label="To była PIERWSZA rzecz, jaką opublikowano w internecie. Pierwsza wiadomość przesłana przez samego twórcę, aby potwierdzić, że wszystko \"działa\".",shape=box,color=blue];
		482 -> 486;
	484 [label="Ostrzegałem cię, żebyś była ostrożna z Pustką. Właśnie przez to.",shape=box,color=red];
		484 -> 488;
	483 [label="A co, jeśli tego nie wytłumaczy?",shape=box,color=red];
		483 -> 487;
	485 [label="Ha! Chciałabym, omg. Ale znasz \"Witaj Świecie\"?",shape=box,color=blue];
		485 -> 482;
	486 [label="A potem było już tylko gorzej. Ludzie POWARIOWALI. Nauka. Bankowość. Technologia. Rozrywka.",shape=box,color=blue];
		486 -> 489;
	488 [label="Niektórych rzeczy nie da się kontrolować.",shape=box,color=red];
		488 -> 491;
	487 [label="Co, jeśli świat kieruje się znanymi przez ciebie zasadami...",shape=box,color=red];
		487 -> 490;
	489 [label="Miliardy trzepoczących skrzydeł motyli doprowadziły do tego, że zasiadłam wtedy do komputera i... ",shape=box,color=blue];
		489 -> 492;
	491 [label="Niektórych rzeczy nie da się wyjaśnić.",shape=box,color=red];
		491 -> 493;
	490 [label="Tylko dlatego, że coś chciało, aby tak było.",shape=box,color=red];
		490 -> 493;
	492 [label="I to był koniec Novy, albo raczej Kayi. Jej przyszłości, kariery, przyjaciół, wszystkiego. Wszystko przez jeden błąd. ",shape=box,color=blue];
		492 -> 494;
	493 [label="Więc mówisz, że brakującą częścią moich eksperymentów, testów, badań i hipotez jest \"magia\".",shape=box,color=blue];
		493 -> 495;
		493 -> 496;
	494 [label="Więc chyba bardziej wolę zaufać Pustce niż innym ludziom.",shape=box,color=blue];
		494 -> 497;
		494 -> 498;
		494 -> 499;
	495 [label="Nie magia. Po prostu... Pustka. Energia z innego źródła.",shape=box,color=red];
