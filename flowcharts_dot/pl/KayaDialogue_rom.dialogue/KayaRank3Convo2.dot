		463 -> 464;
	464 [label="Ete... co?",shape=box,color=blue];
		464 -> 465;
		464 -> 466;
	465 [label="Zobaczmy, czy jesteś na tyle mądra, żeby sama to rozpracować. Zasady eternalizmu mówią, że istnieje wersja naszej rozmowy, która nie kończy się w ten sposób. [Koniec]",shape=box,color=red];
		465 -> 467;
	466 [label="Mam nadzieję, że masz chwilę wolnego. Właśnie z tego powodu się odezwałem.",shape=box,color=red];
		466 -> 468;
	467 [label="Update boolean KayaEternalismTest",color=orange];
		467 -> 469;
	468 [label="Mam czas, wyjaśnij więc. To może mieć ogromne znaczenie do ostatnich poprawek teorii temporalnej manipulacji.",shape=box,color=blue];
		468 -> 470;
	469 [label="+20 Chemistry",color=orange];
		469 -> 471;
	470 [label="To wszystko nie wydarzyło się przez to, że jakiś jajogłowy zapisał wzór.",shape=box,color=red];
		470 -> 472;
	471 [label="Chat ends. Next chat will be KayaRank3Convo3.",color=orange];
	472 [label="No, może jednak tak to się zaczęło.",shape=box,color=red];
		472 -> 473;
	473 [label="Ale to wszystko? To coś więcej. Wszystko to jest spowodowane tym, że Albrecht poszedł gdzieś, obudził coś i sprowadził to ze sobą z powrotem. Pustkę.",shape=box,color=red];
		473 -> 474;
		473 -> 475;
	474 [label="Pustka jest żywa, ale też nie. Istnieje, ale i nie. To paradoks, który jest powodem wszystkiego, co nas wszystkich dotknęło.",shape=box,color=red];
		474 -> 476;
	475 [label="Nie ma na nią miejsca na tablicy pierwiastków.",shape=box,color=red];
		475 -> 477;
	476 [label="Witaj Świecie.",shape=box,color=blue];
		476 -> 478;
		476 -> 479;
	477 [label="Nauka może to wyjaśnić. Nauka rządzi wszystkim.",shape=box,color=blue];
