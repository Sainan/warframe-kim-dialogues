digraph {
	"KayaRank3Convo2 begins." [color=orange];
		"KayaRank3Convo2 begins." -> j2602413438;
	j2602413438 [label="Wydajesz się naprawdę zafascynowana podróżą w czasie. Obsesyjnie wręcz.",shape=box,color=red];
		j2602413438 -> j3438156565;
	j3438156565 [label="Pracuję nad tym. Już prawie skończyłam.",shape=box,color=blue];
		j3438156565 -> j2228994539;
	j2228994539 [label="Kiedy rozwiążesz kwestię podróży w czasie, większym problemem jest Eternalizm. ",shape=box,color=red];
		j2228994539 -> j641799135;
	j641799135 [label="Ete... co?",shape=box,color=blue];
		j641799135 -> j1904266131;
		j641799135 -> j3075346077;
	j1904266131 [label="Zobaczmy, czy jesteś na tyle mądra, żeby sama to rozpracować. Zasady eternalizmu mówią, że istnieje wersja naszej rozmowy, która nie kończy się w ten sposób. [Koniec]",shape=box,color=red];
		j1904266131 -> j3655577789;
	j3075346077 [label="Mam nadzieję, że masz chwilę wolnego. Właśnie z tego powodu się odezwałem.",shape=box,color=red];
		j3075346077 -> j4058364288;
	j3655577789 [label="Boolean KayaEternalismTest is now true.",color=orange];
		j3655577789 -> j2156753723;
	j4058364288 [label="Mam czas, wyjaśnij więc. To może mieć ogromne znaczenie do ostatnich poprawek teorii temporalnej manipulacji.",shape=box,color=blue];
		j4058364288 -> j4273662861;
	j2156753723 [label="+20 Chemistry",color=orange];
