	"KayaRank4Convo1 begins." [color=orange];
		"KayaRank4Convo1 begins." -> j2158794271;
	j2158794271 [label="Chcesz wiedzieć jak to jest? Internet pojawił się o naobiecywał nam cuda.",shape=box,color=blue];
		j2158794271 -> j3199354593;
	j3199354593 [label="Jesteś mną. Kończysz 18 lat. Wchodzisz do sieci. Tworzysz nowe znajomości na CAŁYM ŚWIECIE!",shape=box,color=blue];
		j3199354593 -> j3856584020;
	j3856584020 [label="I jak na \"mądrą dziewczynkę\" przystało, popełniasz najdurniejszy błąd w internecie. ",shape=box,color=blue];
		j3856584020 -> j3187587283;
	j3187587283 [label="Ufasz osobie po drugiej stronie. ",shape=box,color=blue];
		j3187587283 -> j2137546419;
	j2137546419 [label="W całej tej technologii zapominasz, że ludzie to wciąż tylko ludzie. ",shape=box,color=blue];
		j2137546419 -> j1959519983;
	j1959519983 [label="Więc posyłasz nagie zdjęcie, od którego sama Lua by się zarumieniła. Myślisz, że udało ci się nawiązać więź przez internet, że możesz zaufać swojemu chłopakowi. ",shape=box,color=blue];
		j1959519983 -> j3440060977;
	j3440060977 [label="A następnego dnia widzisz to zdjęcie WSZĘDZIE. Widzieli je WSZYSCY na kampusie. Dzielili się nim. Podsyłali je PROFESOROM. Obleciało CAŁY INTERNET. Zawitało do państw, o których nigdy wcześniej nie słyszałam.",shape=box,color=blue];
		j3440060977 -> j3252901243;
	j3252901243 [label="Mogłam być najmądrzejszą osobą na tej kupie gruzu, a ludzie zapamiętaliby tylko to zdjęcie.",shape=box,color=blue];
		j3252901243 -> j3849220239;
	j3849220239 [label="Więc kiedy mówię, że ucieknę stąd, to mówię poważnie. Wiem, że w przyszłości to zdjęcie NIE MA ZNACZENIA, ludzie się pośmiali i zapomnieli.",shape=box,color=blue];
		j3849220239 -> j2498333899;
	j2498333899 [label="Ale zrujnowało moje życie i chcę żyć w przyszłości bez internetu. Chcę udowodnić, że jestem w stanie się z tym pogodzić. Powrót do przeszłości potwierdziłaby tylko, że nie jestem w stanie się z tym pogodzić.",shape=box,color=blue];
		j2498333899 -> j783510756;
	j783510756 [label="Więc poczekaj. Jeszcze zobaczysz mnie w przyszłości, z której pochodzisz. ",shape=box,color=blue];
		j783510756 -> j820380340;
	j820380340 [label="I będziemy mogli spojrzeć na świat i śmiać się z decyzji, które mnie nie zniszczyły. Decyzji, dzięki którym stałam się mądrzejsza. A nawet na tyle mądra, aby uciec.",shape=box,color=blue];
		j820380340 -> j3258508148;
	j3258508148 [label="+20 Chemistry",color=orange];
		j3258508148 -> "Chat ends. Next chat will be KayaRank4Convo2.";
	"Chat ends. Next chat will be KayaRank4Convo2." [color=orange];
}