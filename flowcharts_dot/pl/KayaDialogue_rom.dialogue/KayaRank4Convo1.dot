digraph {
	541 [label="KayaRank4Convo1 begins.",color=orange];
		541 -> 542;
	542 [label="Chcesz wiedzieć jak to jest? Internet pojawił się o naobiecywał nam cuda.",shape=box,color=blue];
		542 -> 543;
	543 [label="Jesteś mną. Kończysz 18 lat. Wchodzisz do sieci. Tworzysz nowe znajomości na CAŁYM ŚWIECIE!",shape=box,color=blue];
		543 -> 544;
	544 [label="I jak na \"mądrą dziewczynkę\" przystało, popełniasz najdurniejszy błąd w internecie. ",shape=box,color=blue];
		544 -> 545;
	545 [label="Ufasz osobie po drugiej stronie. ",shape=box,color=blue];
		545 -> 546;
	546 [label="W całej tej technologii zapominasz, że ludzie to wciąż tylko ludzie. ",shape=box,color=blue];
		546 -> 547;
	547 [label="Więc posyłasz nagie zdjęcie, od którego sama Lua by się zarumieniła. Myślisz, że udało ci się nawiązać więź przez internet, że możesz zaufać swojemu chłopakowi. ",shape=box,color=blue];
		547 -> 548;
	548 [label="A następnego dnia widzisz to zdjęcie WSZĘDZIE. Widzieli je WSZYSCY na kampusie. Dzielili się nim. Podsyłali je PROFESOROM. Obleciało CAŁY INTERNET. Zawitało do państw, o których nigdy wcześniej nie słyszałam.",shape=box,color=blue];
		548 -> 549;
	549 [label="Mogłam być najmądrzejszą osobą na tej kupie gruzu, a ludzie zapamiętaliby tylko to zdjęcie.",shape=box,color=blue];
		549 -> 550;
	550 [label="Więc kiedy mówię, że ucieknę stąd, to mówię poważnie. Wiem, że w przyszłości to zdjęcie NIE MA ZNACZENIA, ludzie się pośmiali i zapomnieli.",shape=box,color=blue];
		550 -> 551;
	551 [label="Ale zrujnowało moje życie i chcę żyć w przyszłości bez internetu. Chcę udowodnić, że jestem w stanie się z tym pogodzić. Powrót do przeszłości potwierdziłaby tylko, że nie jestem w stanie się z tym pogodzić.",shape=box,color=blue];
		551 -> 552;
	552 [label="Więc poczekaj. Jeszcze zobaczysz mnie w przyszłości, z której pochodzisz. ",shape=box,color=blue];
		552 -> 553;
	553 [label="I będziemy mogli spojrzeć na świat i śmiać się z decyzji, które mnie nie zniszczyły. Decyzji, dzięki którym stałam się mądrzejsza. A nawet na tyle mądra, aby uciec.",shape=box,color=blue];
		553 -> 554;
	554 [label="+20 Chemistry",color=orange];
		554 -> 555;
	555 [label="Chat ends. Next chat will be KayaRank4Convo2.",color=orange];
}