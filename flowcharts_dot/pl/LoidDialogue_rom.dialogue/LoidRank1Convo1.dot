digraph {
	0 [label="LoidRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Włóczęgo. Wybacz mi niestosowność tego wtargnięcia, nie chciałem komunikować się z Tobą za pomocą tego urządzenia. Sprawa jest jednak priorytetowa i nie wiedziałem, do kogo innego mogę się zwrócić.",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="POM2_LAB1?",shape=box,color=red];
		2 -> 4;
	3 [label="Z kim rozmawiam...?",shape=box,color=red];
		3 -> 4;
	4 [label="Ach, tak. To nadal domyślne ustawienia. Z tej strony Loid. Powinienem był od tego zacząć... ale tu, w Sanctum Anatomica ostatnio panuje chaos.",shape=box,color=blue];
		4 -> 5;
	5 [label="Dlatego zwracam się do Ciebie po pomoc. Do Sanctum przybyły trzy protoframe'y. Nie były one nam wcześniej znane.",shape=box,color=blue];
		5 -> 6;
	6 [label="Jednym z nich jest",shape=box,color=blue];
		6 -> 7;
	7 [label="Najmocniej przepraszam, za to co powiem",shape=box,color=blue];
		7 -> 8;
	8 [label="Jednym z nich jest Orokin, Włóczęgo.",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
		8 -> 11;
	9 [label="Gdzie jest Lotus?",shape=box,color=red];
		9 -> 12;
	10 [label="O nie... ",shape=box,color=red];
		10 -> 13;
	11 [label="Że co?!",shape=box,color=red];
		11 -> 13;
	12 [label="Lotus i Operator są obecnie zajęci innymi sprawami. Ponadto są zmęczeni i na granicy swoich sił. Nie prosiłbym Cię o pomoc, gdybym mógł zwrócić się do kogoś innego.",shape=box,color=blue];
		12 -> 14;
	13 [label="Nie prosiłbym Cię o pomoc, gdybym mógł zwrócić się do kogokolwiek innego. Ale... zdaje się, że jesteś ekspertem w tej dziedzinie.",shape=box,color=blue];
		13 -> 15;
	14 [label="Ale... zdaje się, że jesteś ekspertem w tej dziedzinie.",shape=box,color=blue];
		14 -> 15;
	15 [label="Nie wiem, jak ich opisać. Kiedy przybędziesz do Sanctum, ciężko będzie ich przegapić. Dwoje z nich zgodziło się skontaktować z Tobą przez POM-2, natomiast trzeciego trzeba jeszcze przekonać.",shape=box,color=blue];
		15 -> 16;
	16 [label="Wierzę... że ci się uda.",shape=box,color=blue];
		16 -> 29;
	29 [label="Update boolean LoidTriadAvailable",color=orange];
		29 -> 17;
	17 [label="Chat ends. Next chat will be LoidFamily.",color=orange];
}