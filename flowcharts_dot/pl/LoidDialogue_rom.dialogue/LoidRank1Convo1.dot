		"LoidRank1Convo1 begins." -> j1730135119;
	j1730135119 [label="Włóczęgo. Wybacz mi niestosowność tego wtargnięcia, nie chciałem komunikować się z Tobą za pomocą tego urządzenia. Sprawa jest jednak priorytetowa i nie wiedziałem, do kogo innego mogę się zwrócić.",shape=box,color=blue];
