		j1933267130 -> j3630750197;
	j1361582451 [label="Że co?!",shape=box,color=red];
		j1361582451 -> j3630750197;
	j2691171713 [label="Lotus i Operator są obecnie zajęci innymi sprawami. Ponadto są zmęczeni i na granicy swoich sił. Nie prosiłbym Cię o pomoc, gdybym mógł zwrócić się do kogoś innego.",shape=box,color=blue];
		j2691171713 -> j2790935163;
	j3630750197 [label="Nie prosiłbym Cię o pomoc, gdybym mógł zwrócić się do kogokolwiek innego. Ale... zdaje się, że jesteś ekspertem w tej dziedzinie.",shape=box,color=blue];
		j3630750197 -> j312246380;
	j2790935163 [label="Ale... zdaje się, że jesteś ekspertem w tej dziedzinie.",shape=box,color=blue];
		j2790935163 -> j312246380;
	j312246380 [label="Nie wiem, jak ich opisać. Kiedy przybędziesz do Sanctum, ciężko będzie ich przegapić. Dwoje z nich zgodziło się skontaktować z Tobą przez POM-2, natomiast trzeciego trzeba jeszcze przekonać.",shape=box,color=blue];
