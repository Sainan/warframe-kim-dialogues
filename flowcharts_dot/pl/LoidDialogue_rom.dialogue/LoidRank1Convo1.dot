	j985248288 [label="Z kim rozmawiam...?",shape=box,color=red];
		j985248288 -> j1151127765;
	j1151127765 [label="Ach, tak. To nadal domyślne ustawienia. Z tej strony Loid. Powinienem był od tego zacząć... ale tu, w Sanctum Anatomica ostatnio panuje chaos.",shape=box,color=blue];
		j1151127765 -> j3201998401;
	j3201998401 [label="Dlatego zwracam się do Ciebie po pomoc. Do Sanctum przybyły trzy protoframe'y. Nie były one nam wcześniej znane.",shape=box,color=blue];
		j3201998401 -> j1483121709;
	j1483121709 [label="Jednym z nich jest",shape=box,color=blue];
		j1483121709 -> j3878705866;
	j3878705866 [label="Najmocniej przepraszam, za to co powiem",shape=box,color=blue];
		j3878705866 -> j3616169842;
	j3616169842 [label="Jednym z nich jest Orokin, Włóczęgo.",shape=box,color=blue];
		j3616169842 -> j628027057;
