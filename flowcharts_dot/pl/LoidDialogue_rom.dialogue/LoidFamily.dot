	22 [label="Aż do szpiku kości, boję się tego, co będę musiał zrobić. Być może właśnie tego zostanę pozbawiony, gdy w napadzie wściekłości rozerwą mnie na strzępy, kiedy Gomaitru i jej rodzina dowiedzą się, co przez cały ten czas działo się pod ich nosami.",shape=box,color=blue];
		22 -> 23;
	23 [label="To dziwne uczucie nazywać ją po imieniu, lecz tak wiele się między nami zmieniło. A wkrótce zmieni się jeszcze więcej.",shape=box,color=blue];
		23 -> 24;
