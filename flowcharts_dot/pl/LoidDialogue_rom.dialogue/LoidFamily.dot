		25 -> 26;
	26 [label="Tak, masz rację. Proszę tylko, żebyś dopilnował, aby moje wnętrzności nie posłużyły do stworzenia świątecznej dekoracji w Nekralisku, dobrze? Obawiam się, że będę potrzebować otuchy i wsparcia, kiedy będzie po wszystkim.",shape=box,color=blue];
