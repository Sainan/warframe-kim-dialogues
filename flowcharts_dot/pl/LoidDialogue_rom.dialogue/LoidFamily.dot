		j2502471650 -> "Chat ends." [label="false",color=purple];
	j3425568613 [label="Włóczęgo. Poddaje się. Roathe, Maria i Leon przekonali mnie, że w końcu nadszedł ten czas.",shape=box,color=blue];
		j3425568613 -> j703418037;
	j703418037 [label="Aż do szpiku kości, boję się tego, co będę musiał zrobić. Być może właśnie tego zostanę pozbawiony, gdy w napadzie wściekłości rozerwą mnie na strzępy, kiedy Gomaitru i jej rodzina dowiedzą się, co przez cały ten czas działo się pod ich nosami.",shape=box,color=blue];
		j703418037 -> j1378514146;
	j1378514146 [label="To dziwne uczucie nazywać ją po imieniu, lecz tak wiele się między nami zmieniło. A wkrótce zmieni się jeszcze więcej.",shape=box,color=blue];
		j1378514146 -> j3682414110;
		j1378514146 -> j991298108;
	j3682414110 [label="To powinno się stać już dawno. Wszystko będzie dobrze.",shape=box,color=red];
		j3682414110 -> j3252006959;
	j991298108 [label="Dasz radę.",shape=box,color=red];
		j991298108 -> j3252006959;
	j3252006959 [label="Tak, masz rację. Proszę tylko, żebyś dopilnował, aby moje wnętrzności nie posłużyły do stworzenia świątecznej dekoracji w Nekralisku, dobrze? Obawiam się, że będę potrzebować otuchy i wsparcia, kiedy będzie po wszystkim.",shape=box,color=blue];
		j3252006959 -> j937202740;
	j937202740 [label="Boolean LoidFamilyComplete is now true.",color=orange];
