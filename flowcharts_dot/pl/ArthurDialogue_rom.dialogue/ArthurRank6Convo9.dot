digraph {
	3555 [label="ArthurRank6Convo9 begins.",color=orange];
		3555 -> 3556;
	3556 [label="Mam wątpliwości co do tej.. Zainfekowanej broni, którą zbiera Eleanor.",shape=box,color=blue];
		3556 -> 3557;
		3556 -> 3558;
	3557 [label="Dlaczego?",shape=box,color=red];
		3557 -> 3559;
	3558 [label="Przynajmniej nie rozmawia.",shape=box,color=red];
		3558 -> 3560;
	3559 [label="Oprócz tego, że z nią rozmawia?",shape=box,color=blue];
		3559 -> 3561;
	3560 [label="Z *nami*. Nie jestem pewien, czy nie rozmawia *z nią*.",shape=box,color=blue];
		3560 -> 3561;
	3561 [label="Wiem, że rozmawia z gitarą. Nie chcę o tym myśleć ani chwili dłużej, niż jest to konieczne.",shape=box,color=blue];
		3561 -> 3562;
	3562 [label="Ale czy nie powinniśmy się martwić... że się rozprzestrzeni? Zdaje się jej przybywać.",shape=box,color=blue];
		3562 -> 3563;
	3563 [label="Czego nie rozumiem. I nie chcę się zastanawiać, skąd bierze amunicję. Albo czym była wcześniej.",shape=box,color=blue];
		3563 -> 3564;
		3563 -> 3565;
	3564 [label="Przynajmniej jest po naszej stronie?",shape=box,color=red];
		3564 -> 3566;
	3565 [label="Możesz zechcieć zostać przy konwencjonalnej broni.",shape=box,color=red];
		3565 -> 3567;
	3566 [label="Pewnie. *Póki co*.",shape=box,color=blue];
		3566 -> 3568;
	3567 [label="I tak zrobię.",shape=box,color=blue];
		3567 -> 3568;
	3568 [label="Przynajmniej kiedy strzelę sobie w stopę, będę mieć pewność, że to ja byłem idiotą.",shape=box,color=blue];
		3568 -> 3569;
	3569 [label="A nie przez to, że moja broń zmieniła stronę albo zgłodniała.",shape=box,color=blue];
		3569 -> 3570;
	3570 [label="Chat ends.",color=orange];
}