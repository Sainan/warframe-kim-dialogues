	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo9 begins." [color=orange];
		"ArthurRank6Convo9 begins." -> j17564830;
	j17564830 [label="Mam wątpliwości co do tej.. Zainfekowanej broni, którą zbiera Eleanor.",shape=box,color=blue];
		j17564830 -> j4255775254;
		j17564830 -> j856863691;
	j4255775254 [label="Dlaczego?",shape=box,color=red];
		j4255775254 -> j357504706;
	j856863691 [label="Przynajmniej nie rozmawia.",shape=box,color=red];
		j856863691 -> j23190806;
	j357504706 [label="Oprócz tego, że z nią rozmawia?",shape=box,color=blue];
		j357504706 -> j2154695974;
	j23190806 [label="Z *nami*. Nie jestem pewien, czy nie rozmawia *z nią*.",shape=box,color=blue];
		j23190806 -> j2154695974;
	j2154695974 [label="Wiem, że rozmawia z gitarą. Nie chcę o tym myśleć ani chwili dłużej, niż jest to konieczne.",shape=box,color=blue];
		j2154695974 -> j3513929088;
	j3513929088 [label="Ale czy nie powinniśmy się martwić... że się rozprzestrzeni? Zdaje się jej przybywać.",shape=box,color=blue];
		j3513929088 -> j732922564;
	j732922564 [label="Czego nie rozumiem. I nie chcę się zastanawiać, skąd bierze amunicję. Albo czym była wcześniej.",shape=box,color=blue];
		j732922564 -> j98784894;
		j732922564 -> j246807113;
	j98784894 [label="Przynajmniej jest po naszej stronie?",shape=box,color=red];
		j98784894 -> j2640708040;
	j246807113 [label="Możesz zechcieć zostać przy konwencjonalnej broni.",shape=box,color=red];
		j246807113 -> j3650461701;
	j2640708040 [label="Pewnie. *Póki co*.",shape=box,color=blue];
		j2640708040 -> j2325298560;
	j3650461701 [label="I tak zrobię.",shape=box,color=blue];
		j3650461701 -> j2325298560;
	j2325298560 [label="Przynajmniej kiedy strzelę sobie w stopę, będę mieć pewność, że to ja byłem idiotą.",shape=box,color=blue];
		j2325298560 -> j2451490726;
	j2451490726 [label="A nie przez to, że moja broń zmieniła stronę albo zgłodniała.",shape=box,color=blue];
		j2451490726 -> "Chat ends.";
	"Chat ends." [color=orange];
}