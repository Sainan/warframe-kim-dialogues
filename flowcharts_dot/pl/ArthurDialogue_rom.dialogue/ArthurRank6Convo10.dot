		3578 -> 3580;
	3579 [label="Ale oboje wiemy, że jesteśmy gotowi oddać za siebie życie.",shape=box,color=blue];
		3579 -> 3581;
	3580 [label="Proszę, niech Lettie mnie uśpi, jeśli znowu zbliżę się do tej przeklętej gry.",shape=box,color=blue];
