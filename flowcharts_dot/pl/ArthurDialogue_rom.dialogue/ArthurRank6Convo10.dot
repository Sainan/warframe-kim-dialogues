		j1142185154 -> j1507646692;
	j893674357 [label="Idziemy z Quincym na zwiady. To był jego pomysł.",shape=box,color=blue];
		j893674357 -> j1128836608;
	j1507646692 [label="I teraz denerwuje mnie, że wciąż pobija moje rekordy.",shape=box,color=blue];
		j1507646692 -> j387329211;
	j1128836608 [label="Nasza relacja jest dziwna. Nie gadamy za wiele.",shape=box,color=blue];
		j1128836608 -> j4070566088;
	j387329211 [label="...w ciągu ostatnich dwóch dni spędziłem 26 godzin w tej grze.",shape=box,color=blue];
		j387329211 -> j3693758876;
	j4070566088 [label="Ale oboje wiemy, że jesteśmy gotowi oddać za siebie życie.",shape=box,color=blue];
		j4070566088 -> j769581874;
