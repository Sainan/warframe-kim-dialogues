		3573 -> 3575;
	3574 [label="Popełniłem głupi błąd, zgadzając się zagrać z Amirem w Ollie's Crash Course.",shape=box,color=blue];
		3574 -> 3576;
	3575 [label="Idziemy z Quincym na zwiady. To był jego pomysł.",shape=box,color=blue];
		3575 -> 3577;
	3576 [label="I teraz denerwuje mnie, że wciąż pobija moje rekordy.",shape=box,color=blue];
		3576 -> 3578;
	3577 [label="Nasza relacja jest dziwna. Nie gadamy za wiele.",shape=box,color=blue];
		3577 -> 3579;
