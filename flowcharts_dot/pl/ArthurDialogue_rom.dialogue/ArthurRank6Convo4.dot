	"ArthurRank6Convo4 begins." [color=orange];
		"ArthurRank6Convo4 begins." -> j1614580764;
	j1614580764 [label="Mam dziwne pytanie. Macie zabawki w przyszłości?",shape=box,color=blue];
		j1614580764 -> j1083272072;
		j1614580764 -> j3205646429;
	j1083272072 [label="Dla dzieci? Pewnie, że tak.",shape=box,color=red];
		j1083272072 -> j2268544536;
	j3205646429 [label="Jakie... jakie zabawki masz na myśli?",shape=box,color=red];
		j3205646429 -> j3219437908;
	j2268544536 [label="Och, naprawdę?",shape=box,color=blue];
		j2268544536 -> j1960478271;
	j3219437908 [label="OCH NA SOL. Nie o to mi chodziło, dobrze o tym wiesz!",shape=box,color=blue];
		j3219437908 -> j1003178133;
	j1960478271 [label="Ciężko wyobrazić sobie, jak wyglądać będzie świat kilka tysiącleci w przyszłości,",shape=box,color=blue];
		j1960478271 -> j1532349547;
	j1003178133 [label="Chodzi mi o zabawki dla dzieci. Lalki, figurki, tego typu.",shape=box,color=blue];
		j1003178133 -> j3593784920;
		j1003178133 -> j531597375;
	j1532349547 [label="Dzieci nadal siedzą i odgrywają historyjki, bawiąc się figurkami w rolach \"bandytów\" albo \"księżniczek\".",shape=box,color=blue];
		j1532349547 -> j758862246;
		j1532349547 -> j1654433216;
		j1532349547 -> j2157804921;
	j3593784920 [label="Tylko utrudniam ci życie :P",shape=box,color=red];
		j3593784920 -> j1079769820;
	j531597375 [label="Nie, nie mamy. [Koniec]",shape=box,color=red];
		j531597375 -> "Chat ends.";
	j758862246 [label="Dlaczego pytasz?",shape=box,color=red];
		j758862246 -> j3564446561;
	j1654433216 [label="A ty czym się bawiłeś za dzieciaka?",shape=box,color=red];
		j1654433216 -> j816445574;
	j2157804921 [label="Mamy różne nazwy dla zabawek, ale na pewno je mieliśmy.",shape=box,color=red];
		j2157804921 -> j861580773;
	j1079769820 [label="Pewnie, że mamy. ",shape=box,color=red];
		j1079769820 -> j2268544536;
	"Chat ends." [color=orange];
	j3564446561 [label="Obserwowałem jak Amir grał na automatach. ",shape=box,color=blue];
		j3564446561 -> j1299330339;
	j816445574 [label="Dobrze wiedzieć, że mimo różnic między kulturami, dzieci to nadal dzieci. Że bawią się zabawkami.",shape=box,color=blue];
		j816445574 -> j4203229352;
	j861580773 [label="Na przykład?",shape=box,color=blue];
		j861580773 -> j2260913021;
		j861580773 -> j67310001;
	j1299330339 [label="I zastanawiałem się, ile bym nie dał, żeby znowu poczuć taką radość w życiu.",shape=box,color=blue];
		j1299330339 -> j1734352942;
	j4203229352 [label="Miałem kiedyś taką figurkę, Bohaterski Barnabas. Był żołnierzem, ku zaskoczeniu nikogo.",shape=box,color=blue];
		j4203229352 -> j2287437650;
	j2260913021 [label="Wszelkiego rodzaju figurki, zwierzęta, klocki. Typowe zabawki. ",shape=box,color=red];
		j2260913021 -> j816445574;
	j67310001 [label="Miałem kiedyś taką - mógłbyś to nazwać figurką - pewnego Daksa, nosił nazwę postaci z książki. Dominus Thrax.",shape=box,color=red];
		j67310001 -> j3718553492;
	j1734352942 [label="Nigdy nie oceniałem Aoi, Amira, ani nawet Kayi, kiedy zajmowali się \"dziecięcymi\" zabawami. Nie przeszkadzało mi to.",shape=box,color=blue];
		j1734352942 -> j446660943;
	j2287437650 [label="Pewnego przesilenia grupka starszych chłopców mi go zabrała, wraz z innymi zabawkami i...",shape=box,color=blue];
		j2287437650 -> j3440413699;
	j3718553492 [label="Cholera. Powinienem był wiedzieć. Przepraszam, że w ogóle to poruszyłem.",shape=box,color=blue];
		j3718553492 -> j545840507;
		j3718553492 -> j1856804681;
	j446660943 [label="Ale czasami obawiam się, że część mnie, która byłaby zdolna się tak cieszyć, dawno temu umarła.",shape=box,color=blue];
		j446660943 -> j2833705825;
	j3440413699 [label="To długa historia. Ale w skrócie? Byłem \"za stary\", żeby bawić się figurkami. Wtedy po raz ostatni bawiłem się zabawkami.",shape=box,color=blue];
		j3440413699 -> j3857440528;
	j545840507 [label="To nie jest najlepszy temat do rozmowy.",shape=box,color=red];
		j545840507 -> j3082576827;
	j1856804681 [label="Nie ma problemu, nie wiedziałeś.",shape=box,color=red];
		j1856804681 -> j3186080766;
	j2833705825 [label="Trochę smutne, prawda? Mówimy dzieciom, żeby coś pokochały, a potem każemy im o tym zapomnieć, kiedy \"dorosły\".",shape=box,color=blue];
		j2833705825 -> j997170558;
		j2833705825 -> j902274301;
	j3857440528 [label="Innym razem obserwowałem Amira podczas gry. Dobrze widać, jak wiele dla niego znaczą. Ile radości mu sprawiają. Byłem trochę zazdrosny, że nie mam niczego takiego w życiu.",shape=box,color=blue];
		j3857440528 -> j2833705825;
	j3082576827 [label="Teraz czuję się jak skończony idiota.",shape=box,color=blue];
		j3082576827 -> "Chat ends.";
	j3186080766 [label="Mieliśmy normalne zabawki, jakich mógłbyś się spodziewać. Klocki, pluszowe zwierzątka, figurki, lalki.",shape=box,color=red];
		j3186080766 -> j2331039569;
	j997170558 [label="Nie wiem. Wszyscy musimy kiedyś dorosnąć. Nie możemy wciąż chować się w świecie fantazji. Boleśnie się o tym przekonałem.",shape=box,color=red];
		j997170558 -> j810199555;
	j902274301 [label="Życie potrafi być brutalne, bolesne i krótkie. Powinniśmy spędzić je najlepiej, jak potrafimy. Bawiąc się, śmiejąc i kochając bliskich.",shape=box,color=red];
		j902274301 -> j4076567163;
	j2331039569 [label="Mój stał się trochę większym problemem przez to całe... zamieszanie z Pustką.",shape=box,color=red];
		j2331039569 -> j816445574;
	j810199555 [label="Masz rację. Myślę, że staje się to problemem, kiedy zastępuje to prawdziwe życie. Ale nie o to chodzi.",shape=box,color=blue];
		j810199555 -> j3789349126;
	j4076567163 [label="Masz rację. Mam nadzieję, że będziemy o tym pamiętać w przyszłości... gdziekolwiek byśmy nie trafili.",shape=box,color=blue];
		j4076567163 -> j3789349126;
	j3789349126 [label="Wiesz, trafiłem kiedyś na Eleanor, Velimira, Aoi i Amira, kiedy bawili się w chowanego z Flarem i Lizzie. (Quincy powiedział, że nie może się bawić, bo \"ten drań oszukuje i podgląda nas przez ściany\".)",shape=box,color=blue];
		j3789349126 -> j3116786930;
	j3116786930 [label="Patrzyli na mnie z obawą, że się zezłoszczę, bo przyłapałem ich na obijaniu się, zamiast czymś pożytecznym.",shape=box,color=blue];
		j3116786930 -> j1344368146;
	j1344368146 [label="Bardziej przeszkadzało mi to, że mnie nie zaprosili. Ale musiałem założyć maskę ponurego lidera i udawać, że przeszkadzają mi opuszczone posterunki i tak dalej.",shape=box,color=blue];
		j1344368146 -> j3497837357;
	j3497837357 [label="Amir ma swoje gierki. Aoi ma On-lyne. Nawet Kaya ma swoje naklejki i Jinymony. To ją świat pchnął w dorosłość najwcześniej ze wszystkich.",shape=box,color=blue];
		j3497837357 -> j3729357192;
		j3497837357 -> j3337868305;
	j3729357192 [label="Co próbujesz mi przekazać?",shape=box,color=red];
		j3729357192 -> j321691931;
	j3337868305 [label="Myślę, że udałoby ci się do tego wrócić, gdybyś spróbował. Odnaleźć radość w zabawkach i grach.",shape=box,color=red];
		j3337868305 -> j764108343;
	j321691931 [label="Szczerze? Sam nie wiem. Czuję, jakbym dawno temu stracił w życiu coś ważnego.",shape=box,color=blue];
		j321691931 -> j3661842913;
	j764108343 [label="Teraz słyszę tylko śmiech. Ale chyba właśnie to mnie ogranicza, prawda? Wstyd.",shape=box,color=blue];
		j764108343 -> j3286797322;
	j3661842913 [label="Nie wiem, czy kiedykolwiek uda mi się wrócić. Może jest już za późno. Kto wie, z czasem wszystko jest możliwe.",shape=box,color=blue];
		j3661842913 -> "Chat ends.";
	j3286797322 [label="Nie wiem, czy powrót jest możliwy, nawet gdybym pogodził się ze wstydem. Ale kto wie, z czasem wszystko jest możliwe.",shape=box,color=blue];
		j3286797322 -> "Chat ends.";
}