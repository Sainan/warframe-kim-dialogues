digraph {
	3433 [label="ArthurRank6Convo4 begins.",color=orange];
		3433 -> 3434;
	3434 [label="Mam dziwne pytanie. Macie zabawki w przyszłości?",shape=box,color=blue];
		3434 -> 3435;
		3434 -> 3436;
	3435 [label="Dla dzieci? Pewnie, że tak.",shape=box,color=red];
		3435 -> 3437;
	3436 [label="Jakie... jakie zabawki masz na myśli?",shape=box,color=red];
		3436 -> 3438;
	3437 [label="Och, naprawdę?",shape=box,color=blue];
		3437 -> 3439;
	3438 [label="OCH NA SOL. Nie o to mi chodziło, dobrze o tym wiesz!",shape=box,color=blue];
		3438 -> 3440;
	3439 [label="Ciężko wyobrazić sobie, jak wyglądać będzie świat kilka tysiącleci w przyszłości,",shape=box,color=blue];
		3439 -> 3441;
	3440 [label="Chodzi mi o zabawki dla dzieci. Lalki, figurki, tego typu.",shape=box,color=blue];
		3440 -> 3442;
		3440 -> 3448;
	3441 [label="Dzieci nadal siedzą i odgrywają historyjki, bawiąc się figurkami w rolach \"bandytów\" albo \"księżniczek\".",shape=box,color=blue];
		3441 -> 3444;
		3441 -> 3445;
		3441 -> 3446;
	3442 [label="Tylko utrudniam ci życie :P",shape=box,color=red];
		3442 -> 3447;
	3448 [label="Nie, nie mamy. [Koniec]",shape=box,color=red];
		3448 -> 3452;
	3444 [label="Dlaczego pytasz?",shape=box,color=red];
		3444 -> 3449;
	3445 [label="A ty czym się bawiłeś za dzieciaka?",shape=box,color=red];
		3445 -> 3450;
	3446 [label="Mamy różne nazwy dla zabawek, ale na pewno je mieliśmy.",shape=box,color=red];
		3446 -> 3451;
	3447 [label="Pewnie, że mamy. ",shape=box,color=red];
		3447 -> 3437;
	3452 [label="Chat ends.",color=orange];
	3449 [label="Obserwowałem jak Amir grał na automatach. ",shape=box,color=blue];
		3449 -> 3453;
	3450 [label="Dobrze wiedzieć, że mimo różnic między kulturami, dzieci to nadal dzieci. Że bawią się zabawkami.",shape=box,color=blue];
		3450 -> 3454;
	3451 [label="Na przykład?",shape=box,color=blue];
		3451 -> 3455;
		3451 -> 3456;
	3453 [label="I zastanawiałem się, ile bym nie dał, żeby znowu poczuć taką radość w życiu.",shape=box,color=blue];
		3453 -> 3457;
	3454 [label="Miałem kiedyś taką figurkę, Bohaterski Barnabas. Był żołnierzem, ku zaskoczeniu nikogo.",shape=box,color=blue];
		3454 -> 3458;
	3455 [label="Wszelkiego rodzaju figurki, zwierzęta, klocki. Typowe zabawki. ",shape=box,color=red];
		3455 -> 3450;
	3456 [label="Miałem kiedyś taką - mógłbyś to nazwać figurką - pewnego Daksa, nosił nazwę postaci z książki. Dominus Thrax.",shape=box,color=red];
		3456 -> 3459;
	3457 [label="Nigdy nie oceniałem Aoi, Amira, ani nawet Kayi, kiedy zajmowali się \"dziecięcymi\" zabawami. Nie przeszkadzało mi to.",shape=box,color=blue];
		3457 -> 3460;
	3458 [label="Pewnego przesilenia grupka starszych cłopców mi go zabrała, wraz z innymi zabawkami i...",shape=box,color=blue];
		3458 -> 3461;
	3459 [label="Cholera. Powinienem był wiedzieć. Przepraszam, że w ogóle to poruszyłem.",shape=box,color=blue];
		3459 -> 3462;
		3459 -> 3463;
	3460 [label="Ale czasami obawiam się, że część mnie, która byłaby zdolna się tak cieszyć, dawno temu umarła.",shape=box,color=blue];
		3460 -> 3464;
	3461 [label="To długa historia. Ale w skrócie? Byłem \"za stary\", żeby bawić się figurkami. Wtedy po raz ostatni bawiłem się zabawkami.",shape=box,color=blue];
		3461 -> 3465;
	3462 [label="To nie jest najlepszy temat do rozmowy.",shape=box,color=red];
		3462 -> 3466;
	3463 [label="Nie ma problemu, nie wiedziałeś.",shape=box,color=red];
		3463 -> 3467;
	3464 [label="Trochę smutne, prawda? Mówimy dzieciom, żeby coś pokochały, a potem każemy im o tym zapomnieć, kiedy \"dorosły\".",shape=box,color=blue];
		3464 -> 3468;
		3464 -> 3469;
	3465 [label="Innym razem obserwowałem Amira podczas gry. Dobrze widać, jak wiele dla niego znaczą. Ile radości mu sprawiają. Byłem trochę zazdrosny, że nie mam niczego takiego w życiu.",shape=box,color=blue];
		3465 -> 3464;
	3466 [label="Teraz czuję się jak skończony idiota.",shape=box,color=blue];
		3466 -> 3470;
	3467 [label="Mieliśmy normalne zabawki, jakich mógłbyś się spodziewać. Klocki, pluszowe zwierzątka, figurki, lalki.",shape=box,color=red];
		3467 -> 3471;
	3468 [label="Nie wiem. Wszyscy musimy kiedyś dorosnąć. Nie możemy wciąż chować się w świecie fantazji. Boleśnie się o tym przekonałem.",shape=box,color=red];
		3468 -> 3472;
	3469 [label="Życie potrafi być brutalne, bolesne i krótkie. Powinniśmy spędzić je najlepiej, jak potrafimy. Bawiąc się, śmiejąc i kochając bliskich.",shape=box,color=red];
		3469 -> 3473;
	3470 [label="Chat ends.",color=orange];
	3471 [label="Mój stał się trochę większym problemem przez to całe... zamieszanie z Pustką.",shape=box,color=red];
		3471 -> 3450;
	3472 [label="Masz rację. Myślę, że staje się to problemem, kiedy zastępuje to prawdziwe życie. Ale nie o to chodzi.",shape=box,color=blue];
		3472 -> 3474;
	3473 [label="Masz rację. Mam nadzieję, że będziemy o tym pamiętać w przyszłości... gdziekolwiek byśmy nie trafili.",shape=box,color=blue];
		3473 -> 3474;
	3474 [label="Wiesz, trafiłem kiedyś na Eleanor, Velimira, Aoi i Amira, kiedy bawili się w chowanego z Flarem i Lizzie. (Quincy powiedział, że nie może się bawić, bo \"ten drań oszukuje i podgląda nas przez ściany\".)",shape=box,color=blue];
		3474 -> 3475;
	3475 [label="Patrzyli na mnie z obawą, że się zezłoszczę, bo przyłapałem ich na obijaniu się, zamiast czymś pożytecznym.",shape=box,color=blue];
		3475 -> 3476;
	3476 [label="Bardziej przeszkadzało mi to, że mnie nie zaprosili. Ale musiałem założyć maskę ponurego lidera i udawać, że przeszkadzają mi opuszczone posterunki i tak dalej.",shape=box,color=blue];
		3476 -> 3477;
	3477 [label="Amir ma swoje gierki. Aoi ma On-lyne. Nawet Kaya ma swoje naklejki i Jinymony. To ją świat pchnął w dorosłość najwcześniej ze wszystkich.",shape=box,color=blue];
		3477 -> 3478;
		3477 -> 3479;
	3478 [label="Co próbujesz mi przekazać?",shape=box,color=red];
		3478 -> 3480;
	3479 [label="Myślę, że udałoby ci się do tego wrócić, gdybyś spróbował. Odnaleźć radość w zabawkach i grach.",shape=box,color=red];
		3479 -> 3481;
	3480 [label="Szczerze? Sam nie wiem. Czuję, jakbym dawno temu stracił w życiu coś ważnego.",shape=box,color=blue];
		3480 -> 3482;
	3481 [label="Teraz słyszę tylko śmiech. Ale chyba właśnie to mnie ogranicza, prawda? Wstyd.",shape=box,color=blue];
		3481 -> 3483;
	3482 [label="Nie wiem, czy kiedykolwiek uda mi się wrócić. Może jest już za późno. Kto wie, z czasem wszystko jest możliwe.",shape=box,color=blue];
		3482 -> 3484;
	3483 [label="Nie wiem, czy powrót jest możliwy, nawet gdybym pogodził się ze wstydem. Ale kto wie, z czasem wszystko jest możliwe.",shape=box,color=blue];
		3483 -> 3485;
	3484 [label="Chat ends.",color=orange];
	3485 [label="Chat ends.",color=orange];
}