		3278 -> 3284;
	3279 [label="No tak...",shape=box,color=blue];
		3279 -> 3285;
	3280 [label="Że powód, dla którego tu przyszedł. Dla którego tak cię zmienił, nadal istnieje. Nadal ma znaczenie. Że wszystko nie poszło na marne.",shape=box,color=red];
		3280 -> 3286;
