		3282 -> 3289;
	3283 [label="Nie wiem. Minerwa i Velimir opowiadali mi o... \"Zimnej Wojnie\"? Brzmi, jakby ludzkość zbudowała wiele szalonej broni, z której nie skorzystała.",shape=box,color=red];
		3283 -> 3290;
	3284 [label="Nie mogę przestać myśleć, że jesteśmy kulami w pistolecie. Narzędziami do użycia. Wykorzystanymi i zapomnianymi.",shape=box,color=blue];
		3284 -> 3291;
