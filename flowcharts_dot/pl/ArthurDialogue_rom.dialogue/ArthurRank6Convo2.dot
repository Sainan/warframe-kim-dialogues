	j2930812475 [label="\"Nas\", czyli?",shape=box,color=red];
		j2930812475 -> j3680502710;
	j1426347823 [label="Przypuszczam, że jedno i drugie. Tutaj, teraz, w przeszłości – w przyszłości.",shape=box,color=blue];
		j1426347823 -> j4022505741;
	j3680502710 [label="Protoframe'y. Tutaj lub gdziekolwiek. Albo nawet *kiedy*kolwiek.",shape=box,color=blue];
		j3680502710 -> j4022505741;
	j4022505741 [label="Entrati stworzył nas w określonym celu. Z wieloma celami. To jasne, że wykraczał on poza naszą szóstkę. ",shape=box,color=blue];
		j4022505741 -> j2138122056;
		j4022505741 -> j3053485015;
	j2138122056 [label="Na początku myślałem, że robi mi \"zapasowe\" Warframe’y na wypadek, gdyby moje nie przeszły przez Helmintha. Teraz nie jestem już tego taki pewien.",shape=box,color=red];
		j2138122056 -> j3328631911;
	j3053485015 [label="Chciałbym tylko wiedzieć, co zamierzał. Albo dlaczego tak naprawdę tworzył kolejne protoframe'y.",shape=box,color=red];
		j3053485015 -> j1602444820;
	j3328631911 [label="Miało to sens, gdy było nas tylko sześcioro.",shape=box,color=blue];
		j3328631911 -> j1602444820;
	j1602444820 [label="Czy naprawdę wierzysz, że jego prawdziwym celem jest powstrzymanie Obojętności?",shape=box,color=blue];
		j1602444820 -> j4000497954;
	j4000497954 [label="Czy *naprawdę* możemy mu ufać?",shape=box,color=blue];
