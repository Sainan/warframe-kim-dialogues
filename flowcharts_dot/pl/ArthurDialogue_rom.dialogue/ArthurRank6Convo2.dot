		j4000497954 -> j4191840028;
		j4000497954 -> j802986483;
	j45577864 [label="Nie wiem, szczerze mówiąc. Nadal za grosz mu nie ufam.",shape=box,color=red];
		j45577864 -> j1434502464;
	j4191840028 [label="Nie. Nie możemy ufać ani jego celom, ani jego metodom.",shape=box,color=red];
