digraph {
	3229 [label="ArthurRank6Convo2 begins.",color=orange];
		3229 -> 3230;
	3230 [label="Zastanawiałem się. Ilu z nas jeszcze istnieje?",shape=box,color=blue];
		3230 -> 3231;
		3230 -> 3232;
	3231 [label="Masz na myśli tu w 1999, czy coś innego?",shape=box,color=red];
		3231 -> 3233;
	3232 [label="\"Nas\", czyli?",shape=box,color=red];
		3232 -> 3234;
	3233 [label="Przypuszczam, że jedno i drugie. Tutaj, teraz, w przeszłości – w przyszłości.",shape=box,color=blue];
		3233 -> 3235;
	3234 [label="Protoframe'y. Tutaj lub gdziekolwiek. Albo nawet *kiedy*kolwiek.",shape=box,color=blue];
		3234 -> 3235;
	3235 [label="Entrati stworzył nas w określonym celu. Z wieloma celami. To jasne, że wykraczał on poza naszą szóstkę. ",shape=box,color=blue];
		3235 -> 3236;
		3235 -> 3237;
	3236 [label="Na początku myślałem, że robi mi \"zapasowe\" Warframe’y na wypadek, gdyby moje nie przeszły przez Helmintha. Teraz nie jestem już tego taki pewien.",shape=box,color=red];
		3236 -> 3238;
	3237 [label="Chciałbym tylko wiedzieć, co zamierzał. Albo dlaczego tak naprawdę tworzył kolejne protoframe'y.",shape=box,color=red];
		3237 -> 3239;
	3238 [label="Miało to sens, gdy było nas tylko sześcioro.",shape=box,color=blue];
		3238 -> 3239;
	3239 [label="Czy naprawdę wierzysz, że jego prawdziwym celem jest powstrzymanie Obojętności?",shape=box,color=blue];
		3239 -> 3240;
	3240 [label="Czy *naprawdę* możemy mu ufać?",shape=box,color=blue];
		3240 -> 3241;
		3240 -> 3242;
		3240 -> 3243;
	3241 [label="Nie wiem, szczerze mówiąc. Nadal za grosz mu nie ufam.",shape=box,color=red];
		3241 -> 3244;
	3242 [label="Nie. Nie możemy ufać ani jego celom, ani jego metodom.",shape=box,color=red];
		3242 -> 3245;
		3242 -> 3246;
	3243 [label="Tak, nie zawsze zgadzam się z jego metodami. Ale tak – Entrati chce ją powstrzymać.",shape=box,color=red];
		3243 -> 3246;
		3243 -> 3245;
	3244 [label="+5 Chemistry",color=orange];
		3244 -> 3247;
	3245 [label="Próbuje znów uwięzić dżina w lampie. Nawet jeśli jest to możliwe, nie będzie łatwo.",shape=box,color=red];
		3245 -> 3248;
	3246 [label="Ale nie mamy żadnego wyboru, prawda? Wszystko co mogę zrobić ja i dzieciak, to podążać i sprzątać za nim.",shape=box,color=red];
		3246 -> 3249;
		3246 -> 3250;
	3247 [label="Heh.",shape=box,color=blue];
		3247 -> 3245;
		3247 -> 3246;
	3248 [label="A my jesteśmy woźnymi, szorującymi po nim podłogi. Cudownie.",shape=box,color=blue];
		3248 -> 3249;
		3248 -> 3250;
	3249 [label="Teraz, kiedy Kaya znalazła własne rozwiązane podróży w czasie, może będzie mi łatwiej wracać tam i z powrotem.",shape=box,color=red];
		3249 -> 3251;
	3250 [label="Ale zdecydowałem się tu zostać, więc teraz wszystko jest w rękach dzieciaka.",shape=box,color=red];
		3250 -> 3254;
	3251 [label="Dzieciak potrafi być wrzodem na dupie, ale doceniam to.",shape=box,color=blue];
