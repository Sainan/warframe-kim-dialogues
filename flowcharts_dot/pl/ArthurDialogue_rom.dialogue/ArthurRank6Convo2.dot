		3254 -> 3252 [label=false,color=brown];
	3253 [label="Fajnie wiedzieć, że jak wyskoczysz do sklepu… to może faktycznie wrócisz… :/",shape=box,color=blue];
		3253 -> 3255;
	3603 [label="Ech. Zobaczymy. Znam cię wystarczająco dobrze, kochanie. I wiem, że nie wiesz, kiedy się nie wychylać.",shape=box,color=blue];
		3603 -> 3257;
	3252 [label="Ech. Zobaczymy. Znam cię wystarczająco dobrze, Włóczęgo. I wiem, że nie wiesz, kiedy się nie wychylać.",shape=box,color=blue];
		3252 -> 3256;
