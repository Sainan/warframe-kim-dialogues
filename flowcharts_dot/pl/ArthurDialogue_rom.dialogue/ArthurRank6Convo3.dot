	j3639398240 [label="Dobrze to rozumiem.",shape=box,color=red];
		j3639398240 -> j863726371;
	j223998312 [label="Pomaga też to, że niektórzy z nich są trochę starsi i mają doświadczenie wojskowe.",shape=box,color=red];
		j223998312 -> j1132198354;
	j1331196719 [label="Sytuacja, w której się znaleźliśmy? To szaleństwo. Ludzie nie powinni przez coś takiego przechodzić.",shape=box,color=blue];
		j1331196719 -> j2908361255;
	j1276795329 [label="Raczej nie.",shape=box,color=blue];
		j1276795329 -> j2121087291;
	j863726371 [label="Nie ma takiego... ciężaru. Takiej przeszłości. Amir nazwałby to bagażem.",shape=box,color=blue];
		j863726371 -> j2121087291;
	j1132198354 [label="Na Sol. Dokładnie tak. Nie byłem pewien, co sądzić o gościach z Libertacji, ale teraz? Cieszę się, że z nami są.",shape=box,color=blue];
		j1132198354 -> j2121087291;
	j2908361255 [label="Nie ma żadnych poradników. Czegokolwiek byś nie zrobił, wierzę, że będziesz miał dobry powód.",shape=box,color=blue];
		j2908361255 -> j2674809731;
	j2121087291 [label="To wszystko dało mi do myślenia.",shape=box,color=blue];
