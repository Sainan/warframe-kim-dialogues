		j380259249 -> j3958466702;
	j3113500309 [label="Trzymałbym się tego desperacko jak tratwy na morzu. Ale może przeżyłem ten cykl już wystarczająco wiele razy... albo to przez ciebie. Nie wiem.",shape=box,color=blue];
		j3113500309 -> j1468868402;
