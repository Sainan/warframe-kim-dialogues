	j1512825341 [label="O czym?",shape=box,color=red];
		j1512825341 -> j4076915592;
	j1033787789 [label="Kocham cię. A nawet jeśli o tym zapomnę? Jeśli zdecydujesz się zmienić zdanie? Wszystko w porządku.",shape=box,color=blue];
		j1033787789 -> j4045396275;
	j1471261976 [label="Powierzyłbym ci własne życie i nic tego nie zmieni. Nawet jeśli bym o tym zapomniał na jakiś czas.",shape=box,color=blue];
		j1471261976 -> j2737896751;
	j456740319 [label="Hehe. Najpierw mnie posłuchaj. Chodzi o ciebię.",shape=box,color=blue];
		j456740319 -> j380259249;
	j4076915592 [label="O tobie. ",shape=box,color=blue];
		j4076915592 -> j380259249;
	j4045396275 [label="Nie wiem, czy pogodziłbym się z tym przed Twoim przybyciem. Tak bardzo bałbym się stracić ciebie. To co mamy.",shape=box,color=blue];
		j4045396275 -> j3113500309;
	j2737896751 [label="Nie wiem, czy pogodziłbym się z tym przed Twoim przybyciem. Tak bardzo bałbym się utracić część siebie.",shape=box,color=blue];
		j2737896751 -> j3113500309;
	j380259249 [label="Cała ta sytuacja z... pętlą czasu. Zastanawiałem się ile lat przeżyłem i których nie pamiętam.",shape=box,color=blue];
		j380259249 -> j2198737409;
