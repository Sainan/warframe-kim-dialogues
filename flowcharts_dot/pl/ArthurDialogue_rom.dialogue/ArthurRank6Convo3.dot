	j824874622 [label="Co? Nie! W żadnym razie.",shape=box,color=blue];
		j824874622 -> j3781667368;
	j1978646443 [label="Fascynujące, biorąc pod uwagę ilość pętli.",shape=box,color=blue];
		j1978646443 -> j476601789;
	j4174570154 [label="Chyba po prostu miło jest wpaść na kogoś, z kim tyle nie przeszedłem.",shape=box,color=blue];
		j4174570154 -> j750908008;
	j3781667368 [label="Hex są dla mnie jak rodzina. To moja ekipa. Dobrze to wiesz.",shape=box,color=blue];
		j3781667368 -> j4174570154;
	j476601789 [label="Jak wiele razy zapomniałem minionych lat. Jak ona żyje... poza czasem? A my nie.",shape=box,color=blue];
		j476601789 -> j3448602384;
	j750908008 [label="Nie jestem pewien, czy to ma sens. Znam ich, ufam im, ale *nie przeszliśmy razem przez piekło*.",shape=box,color=blue];
		j750908008 -> j2413735828;
	j3448602384 [label="I zanim cokolwiek powiesz, nie. Nie chcę wiedzieć. Nie powinienem.",shape=box,color=blue];
		j3448602384 -> j2165217144;
	j2413735828 [label="Dlatego łatwiej jest z nimi przysiąść i się napić.",shape=box,color=blue];
