	j2539277183 [label="Zdecydowałem się przedstawić jak przystało.",shape=box,color=blue];
		j2539277183 -> j2813703998;
	j2813703998 [label="Ma wiele mądrości do przekazania. A Flare jest cudowny. Szczerze, cała ekipa przy barze to powiew świeżego powietrza. ",shape=box,color=blue];
