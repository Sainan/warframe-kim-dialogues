		j1976784142 -> j3017268370;
	j3220043564 [label="Jest z tobą w jednej chwili i znika w następnej. Pogodziłem się z tym.",shape=box,color=blue];
		j3220043564 -> j43744651;
	j3017268370 [label="Niezależnie od tego, czy mnie stworzyłeś czy nie, czy resztę Hex, czy zapomniałeś o naszej przeszłości? Jest w porządku.",shape=box,color=blue];
		j3017268370 -> j1198097525;
	j43744651 [label="Więc kiedy nadejdzie czas, kiedy zdecydujesz się zacząć od nowa i o wszystkim zapomnę?",shape=box,color=blue];
