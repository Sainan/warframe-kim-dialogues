		j3958466702 -> j2442777562;
	j1468868402 [label="Ta radość, którą mi dałeś - ten pokój - jest wart więcej niż wiedza, że to może trwać wiecznie.",shape=box,color=blue];
		j1468868402 -> j1466354126;
	j2442777562 [label="Po prostu daj mi chwilę, dobra? Wiesz, że piszę wolniej niż ty.",shape=box,color=blue];
