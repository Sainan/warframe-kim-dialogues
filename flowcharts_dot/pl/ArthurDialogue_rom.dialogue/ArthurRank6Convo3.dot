		j2413735828 -> j3639398240;
		j2413735828 -> j223998312;
	j2165217144 [label="Próbuję chyba powiedzieć, że czy to zrobiłeś czy nie - akceptuję to. Nie mam ci tego za złe.",shape=box,color=blue];
		j2165217144 -> j1331196719;
	j1640167935 [label="Nigdy nie miałem takiej możliwości.",shape=box,color=red];
