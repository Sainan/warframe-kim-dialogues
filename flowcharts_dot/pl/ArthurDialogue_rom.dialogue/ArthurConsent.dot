	3612 [label="Chat ends.",color=orange];
	3613 [label="Arturze, możemy porozmawiać? [Zapytaj o zgodę na wielu partnerów]",shape=box,color=red];
		3613 -> 3615;
	3611 [label="[Koniec]",shape=box,color=red];
		3611 -> 3614;
	3610 [label="Chat ends.",color=orange];
	3615 [label="Zawsze. Coś się stało?",shape=box,color=blue];
		3615 -> 3617;
	3614 [label="Update boolean ArthurConsentComplete",color=orange];
		3614 -> 3616;
	3617 [label="Nie, nic takiego. Chciałem tylko porozmawiać o czymś i mam nadzieję, że nie będzie to dla ciebie zbyt niezręczne.",shape=box,color=red];
		3617 -> 3618;
	3616 [label="Chat ends.",color=orange];
	3618 [label="Nie chcę stawiać cię w sytuacji, w której czujesz się źle. To nie jest coś, o czym rozmawialiśmy wcześniej. Zrozumiem, jeśli się nie zgodzisz.",shape=box,color=red];
		3618 -> 3619;
	3619 [label="To co stworzyliśmy jest dla mnie bardzo ważne, nie chcę, żebyś w to zwątpił.",shape=box,color=red];
		3619 -> 3620;
	3620 [label="Ach, widzę już, dokąd to zmierza. Ktoś inny skradł ci serce?",shape=box,color=blue];
		3620 -> 3621;
		3620 -> 3622;
	3621 [label="Tak. Wiem, że to może być ciężkie do zrozumienia, ale to nie oznacza, że znaczysz dla mnie mniej.",shape=box,color=red];
		3621 -> 3623;
	3622 [label="Tak. Ale teraz, gdy o tym myślę, uważam, że powinniśmy się rozejść. [Rozstanie]",shape=box,color=red];
		3622 -> 3624;
	3623 [label="Kochanie, myślisz, że po tylu latach w wojsku nie widziałem przeróżnych rodzajów związków?",shape=box,color=blue];
		3623 -> 3625;
	3624 [label="Jeśli naprawdę tego chcesz...",shape=box,color=blue];
		3624 -> 3626;
	3625 [label="Kiedy spędzasz tak dużą część swojego życia na granicy śmierci, zaczynasz rozumieć, co ma znaczenie, a co nie.",shape=box,color=blue];
		3625 -> 3627;
	3626 [label="Update boolean IsDating",color=orange];
		3626 -> 3628;
	3627 [label="Przestajesz myśleć o granicach. Rozumiem to całkowicie.",shape=box,color=blue];
		3627 -> 3629;
	3628 [label="Update boolean ArthurDating",color=orange];
		3628 -> 3630;
	3629 [label="Prawda jest taka, że wiele dla mnie znaczysz. Jeśli ktoś inny jest dla ciebie ważny, jest ważny też dla mnie.",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="Chat ends.",color=orange];
	3631 [label="Tylko. Nie. Ktoś z Hex. Rozumiemy się? Nie wiem, czy poradziłbym sobie, gdyby to była \"rodzina\".",shape=box,color=blue];
		3631 -> 3632;
	3632 [label="Na samą myśl mam koszmary.",shape=box,color=blue];
		3632 -> 3634;
		3632 -> 3633;
	3634 [label="Lol. Obiecuję.",shape=box,color=red];
		3634 -> 3636;
	3633 [label="Szczerze myślę, że byście się polubili.",shape=box,color=red];
		3633 -> 3635;
	3636 [label="Dzięki. I mam nadzieję, że kiedyś poznam tą osobę. Z... osobistych powodów, rzecz jasna.",shape=box,color=blue];
		3636 -> 3637;
	3635 [label="I mam nadzieję, że kiedyś poznam tą osobę. Z... osobistych powodów, rzecz jasna.",shape=box,color=blue];
		3635 -> 3637;
	3637 [label="+20 Chemistry",color=orange];
		3637 -> 3638;
	3638 [label="Dbaj o siebie, kochanie.",shape=box,color=blue];
		3638 -> 3639;
	3639 [label="Update boolean ArthurConsentComplete",color=orange];
		3639 -> 3640;
	3640 [label="Chat ends.",color=orange];
}