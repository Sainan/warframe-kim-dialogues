	j1513462729 [label="Arturze, możemy porozmawiać? [Zapytaj o zgodę na wielu partnerów]",shape=box,color=red];
		j1513462729 -> j2453176457;
	j3111902064 [label="[Koniec]",shape=box,color=red];
		j3111902064 -> j3652224286;
	j2453176457 [label="Zawsze. Coś się stało?",shape=box,color=blue];
		j2453176457 -> j1262846730;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j1262846730 [label="Nie, nic takiego. Chciałem tylko porozmawiać o czymś i mam nadzieję, że nie będzie to dla ciebie zbyt niezręczne.",shape=box,color=red];
		j1262846730 -> j1736395681;
	j1736395681 [label="Nie chcę stawiać cię w sytuacji, w której czujesz się źle. To nie jest coś, o czym rozmawialiśmy wcześniej. Zrozumiem, jeśli się nie zgodzisz.",shape=box,color=red];
		j1736395681 -> j2458905045;
	j2458905045 [label="To co stworzyliśmy jest dla mnie bardzo ważne, nie chcę, żebyś w to zwątpił.",shape=box,color=red];
		j2458905045 -> j2400286094;
	j2400286094 [label="Ach, widzę już, dokąd to zmierza. Ktoś inny skradł ci serce?",shape=box,color=blue];
		j2400286094 -> j1816878976;
		j2400286094 -> j3053685939;
	j1816878976 [label="Tak. Wiem, że to może być ciężkie do zrozumienia, ale to nie oznacza, że znaczysz dla mnie mniej.",shape=box,color=red];
		j1816878976 -> j3632642222;
	j3053685939 [label="Tak. Ale teraz, gdy o tym myślę, uważam, że powinniśmy się rozejść. [Rozstanie]",shape=box,color=red];
		j3053685939 -> j195004334;
	j3632642222 [label="Kochanie, myślisz, że po tylu latach w wojsku nie widziałem przeróżnych rodzajów związków?",shape=box,color=blue];
		j3632642222 -> j1730052593;
	j195004334 [label="Jeśli naprawdę tego chcesz...",shape=box,color=blue];
		j195004334 -> j3701883258;
	j1730052593 [label="Kiedy spędzasz tak dużą część swojego życia na granicy śmierci, zaczynasz rozumieć, co ma znaczenie, a co nie.",shape=box,color=blue];
		j1730052593 -> j75863743;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j75863743 [label="Przestajesz myśleć o granicach. Rozumiem to całkowicie.",shape=box,color=blue];
		j75863743 -> j1310772535;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j1310772535 [label="Prawda jest taka, że wiele dla mnie znaczysz. Jeśli ktoś inny jest dla ciebie ważny, jest ważny też dla mnie.",shape=box,color=blue];
		j1310772535 -> j3524277597;
	j3524277597 [label="Tylko. Nie. Ktoś z Hex. Rozumiemy się? Nie wiem, czy poradziłbym sobie, gdyby to była \"rodzina\".",shape=box,color=blue];
		j3524277597 -> j3097070854;
	j3097070854 [label="Na samą myśl mam koszmary.",shape=box,color=blue];
		j3097070854 -> j782803931;
		j3097070854 -> j2793168793;
	j782803931 [label="Lol. Obiecuję.",shape=box,color=red];
		j782803931 -> j2348710854;
	j2793168793 [label="Szczerze myślę, że byście się polubili.",shape=box,color=red];
		j2793168793 -> j1368642058;
	j2348710854 [label="Dzięki. I mam nadzieję, że kiedyś poznam tą osobę. Z... osobistych powodów, rzecz jasna.",shape=box,color=blue];
		j2348710854 -> j1898574991;
	j1368642058 [label="I mam nadzieję, że kiedyś poznam tą osobę. Z... osobistych powodów, rzecz jasna.",shape=box,color=blue];
		j1368642058 -> j1898574991;
	j1898574991 [label="+20 Chemistry",color=orange];
		j1898574991 -> j3148486078;
	j3148486078 [label="Dbaj o siebie, kochanie.",shape=box,color=blue];
