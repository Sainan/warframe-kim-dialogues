	j195180895 [label="Arturze, możemy porozmawiać? [Zapytaj o zgodę na wielu partnerów]",shape=box,color=red];
		j195180895 -> j2803556557;
	j3111902064 [label="[Koniec]",shape=box,color=red];
		j3111902064 -> j3652224286;
	j2803556557 [label="Zawsze. Coś się stało?",shape=box,color=blue];
		j2803556557 -> j3667232110;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j3667232110 [label="Nie, nic takiego. Chciałem tylko porozmawiać o czymś i mam nadzieję, że nie będzie to dla ciebie zbyt niezręczne.",shape=box,color=red];
		j3667232110 -> j3747424983;
	j3747424983 [label="Nie chcę stawiać cię w sytuacji, w której czujesz się źle. To nie jest coś, o czym rozmawialiśmy wcześniej. Zrozumiem, jeśli się nie zgodzisz.",shape=box,color=red];
		j3747424983 -> j3179253636;
	j3179253636 [label="To co stworzyliśmy jest dla mnie bardzo ważne, nie chcę, żebyś w to zwątpił.",shape=box,color=red];
		j3179253636 -> j235313777;
	j235313777 [label="Ach, widzę już, dokąd to zmierza. Ktoś inny skradł ci serce, dobrze rozumiem?",shape=box,color=blue];
		j235313777 -> j32657067;
		j235313777 -> j3053685939;
	j32657067 [label="Tak. Wiem, że to może być ciężkie do zrozumienia, ale to nie oznacza, że znaczysz dla mnie mniej.",shape=box,color=red];
		j32657067 -> j3173092242;
	j3053685939 [label="Tak. Ale teraz, gdy o tym myślę, uważam, że powinniśmy się rozejść. [Rozstanie]",shape=box,color=red];
		j3053685939 -> j195004334;
	j3173092242 [label="Kochanie, myślisz, że po tylu latach w wojsku nie widziałem przeróżnych rodzajów związków?",shape=box,color=blue];
		j3173092242 -> j4289951600;
	j195004334 [label="Jeśli naprawdę tego chcesz...",shape=box,color=blue];
		j195004334 -> j3701883258;
	j4289951600 [label="Kiedy spędzasz tak dużą część swojego życia na granicy śmierci, zaczynasz rozumieć, co ma znaczenie, a co nie.",shape=box,color=blue];
		j4289951600 -> j2927489526;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j2927489526 [label="Nie wiem, jak to się skończy. Ale jesteś dla mnie na tyle ważny, że jestem gotów spróbować.",shape=box,color=blue];
		j2927489526 -> j2813852168;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j2813852168 [label="Zależy mi na tobie. A jeśli tobie zależy na nich, to i mnie na nich zależy.",shape=box,color=blue];
		j2813852168 -> j4266582567;
	j4266582567 [label="Ale żadnych. Żadnych akcji w na obiekcie. Dobra?",shape=box,color=blue];
		j4266582567 -> j3467159521;
	j3467159521 [label="Sytuacja jest już wystarczająco zagmatwana.",shape=box,color=blue];
		j3467159521 -> j782803931;
		j3467159521 -> j2793168793;
	j782803931 [label="Lol. Obiecuję.",shape=box,color=red];
		j782803931 -> j2348710854;
	j2793168793 [label="Szczerze myślę, że byście się polubili.",shape=box,color=red];
		j2793168793 -> j1368642058;
	j2348710854 [label="Dzięki. I mam nadzieję, że kiedyś poznam tą osobę. Z... osobistych powodów, rzecz jasna.",shape=box,color=blue];
		j2348710854 -> j1898574991;
	j1368642058 [label="I mam nadzieję, że kiedyś poznam tą osobę. Z... osobistych powodów, rzecz jasna.",shape=box,color=blue];
		j1368642058 -> j1898574991;
	j1898574991 [label="+20 Chemistry",color=orange];
