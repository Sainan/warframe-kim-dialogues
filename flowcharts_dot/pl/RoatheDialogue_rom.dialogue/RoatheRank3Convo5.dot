digraph {
	1995 [label="RoatheRank3Convo5 begins.",color=orange];
		1995 -> 1996;
	1996 [label="Albrecht był problemem od samego początku. On i jego zabawy z Pustką. Myślę, że Gerivaine została mu dana w nadziei, że założenie rodziny po prostu go uspokoi.",shape=box,color=blue];
		1996 -> 1997;
	1997 [label="Myślę, że to po prostu pogorszyło sytuację. Kiedy miał dzieci, traktował je jak dodatkową parę rąk. Wspólników w swoich szalonych eksperymentach.",shape=box,color=blue];
		1997 -> 1998;
	1998 [label="Zasób do wykorzystania. Jak wszystko w jego życiu.",shape=box,color=blue];
		1998 -> 2001;
		1998 -> 2000;
		1998 -> 1999;
	2001 [label="Gerivaine?",shape=box,color=red];
		2001 -> 2004;
	2000 [label="On postrzega ludzi jako coś więcej niż tylko zasoby.",shape=box,color=red];
		2000 -> 2003;
	1999 [label="[Koniec]",shape=box,color=red];
		1999 -> 2002;
	2004 [label="Imię, które mogło zaginąć w mrokach dziejów... Żona Albrechta Entratiego, Uzurpatorze. Matka jego dzieci.",shape=box,color=blue];
		2004 -> 2006;
	2003 [label="No cóż, przyznaję, że jest on gotów zamordować każdego w swoim życiu, z obojętnością Egzekutora. Ale nie zrobi tego bez celu.",shape=box,color=blue];
		2003 -> 2005;
	2002 [label="Chat ends.",color=orange];
	2006 [label="Check boolean LoidFamilyComplete",color=orange];
		2006 -> 2009 [label=true,color=green];
		2006 -> 2010 [label=false,color=brown];
	2005 [label="Wiesz, teraz, kiedy o tym myślę, to właśnie jego beznamiętna natura czyniła go tak niebezpiecznym w naszych czasach. Był zdolny poświęcić wszystko, byle tylko osiągnąć swoje cele. Wszystko.",shape=box,color=blue];
		2005 -> 2007;
		2005 -> 2008;
	2009 [label="Pewnie znów zgrywasz przede mną głupka. Szanse na to, że już to wiedziałeś, są wysokie, kiedy sługa wrócił do rodziny.",shape=box,color=blue];
		2009 -> 2013;
	2010 [label="Ci, którzy siedzą nad nami, nieświadomi naszego istnienia w tym gnijącym Sanktuarium. Co wciąż uważam za absolutnie bezcenne.",shape=box,color=blue];
		2010 -> 2005;
	2007 [label="Myślałem, że Orokin nie będą mieli problemu z poświęceniem tego, na czym im zależy. Wszyscy wydawaliście się wobec siebie niezwykle bezwzględni.",shape=box,color=red];
		2007 -> 2011;
	2008 [label="Jak doszedłeś do tego wniosku?",shape=box,color=red];
		2008 -> 2012;
	2013 [label="Ale nie wciągniesz mnie w kolejną dyskusję na ten temat. Nie mam na to nastroju.",shape=box,color=blue];
		2013 -> 2005;
	2011 [label="Bardzo chętnie zakładasz wiele rzeczy, o których nic nie wiesz, Włóczęgo.",shape=box,color=blue];
		2011 -> 2014;
	2012 [label="+10 Chemistry",color=orange];
		2012 -> 2015;
	2014 [label="A może twoja skóra ma delikatny odcień błękitu, który przeoczyłem? Może byłeś Orokin? Jeśli tak, jak najmocniej przepraszam!",shape=box,color=blue];
		2014 -> 2016;
		2014 -> 2017;
	2015 [label="Być może panuje błędne przekonanie, że my, Orokin, tylko wbijaliśmy sobie noże w plecy i mordowaliśmy się nawzajem. To nie było rzadkie, nie zrozum mnie źle, ale byliśmy niemal nieśmiertelni. Musieliśmy jakoś zabić nudę.",shape=box,color=blue];
		2015 -> 2018;
	2016 [label="Przepraszam. Nie chciałem cię urazić. Szczerze mówiąc, sam niewiele pamiętam ze społeczeństwa Orokin, mogłem na nie patrzeć tylko z zewnątrz.",shape=box,color=red];
		2016 -> 2019;
	2017 [label="Przykro mi, ale to, co pamiętam o społeczeństwie Orokin, nie było wspaniałe. Głównie nagrane wypowiedzi, wykrzykujące rozkazy do mnie z głośników. To było, zanim zostałem uwięziony w Pustce...",shape=box,color=red];
		2017 -> 2020;
	2018 [label="Ale byliśmy też narodem głęboko zaangażowanym. Nikt nie tworzył sztuki w taki sposób jak Orokin. Nikt nie komponował muzyki, teatru ani poezji, tak jak my.",shape=box,color=blue];
		2018 -> 2021;
	2019 [label="Przeprosiny przyjęte. Tym razem. Już dość mam do czynienia z takim brakiem szacunku ze strony innych. Choć jesteś fascynujący, nie jestem chłopcem do bicia. Mam ciekawsze zajęcia.",shape=box,color=blue];
		2019 -> 2022;
	2020 [label="Update boolean RoatheInsulted",color=orange];
		2020 -> 2023;
	2021 [label="I nikt nie kochał tak głęboko jak my, gdy nasze serca zakochały się w drugiej osobie.",shape=box,color=blue];
		2021 -> 2024;
	2022 [label="O czym to ja mówiłem? Ach, tak. Nasz niewzruszony Entrati.",shape=box,color=blue];
		2022 -> 2015;
	2023 [label="Ostrzegam. Już dość mam do czynienia z takim brakiem szacunku ze strony innych. Choć jesteś fascynujący, nie jestem chłopcem do bicia. Mam ciekawsze zajęcia.",shape=box,color=blue];
		2023 -> 2022;
	2024 [label="Wszyscy oprócz Albrechta. Wszystko, co robił, każdy, z kim się kontaktował, wyglądało tak, jakby patrzył na to przez fragment swojego ukochanego seriszkła.",shape=box,color=blue];
		2024 -> 2025;
	2025 [label="Odsunięty. Nieobecny. Niezainteresowany. Niezrażony. Nawet gdy Gerivaine zmarła i został sam, by wychować swoją małą córeczkę.",shape=box,color=blue];
		2025 -> 2026;
	2026 [label="Check boolean LoidFamilyComplete",color=orange];
		2026 -> 2028 [label=true,color=green];
		2026 -> 2027 [label=false,color=brown];
	2028 [label="Której najpewniej przeznaczone było osiągnąć więcej, niż on kiedykolwiek. Gdyby tylko nie została zakażona i uwięziona. Jaka szkoda.",shape=box,color=blue];
		2028 -> 2031;
		2028 -> 2032;
	2027 [label="Której najpewniej przeznaczone było osiągnąć więcej, niż on kiedykolwiek. Nie mogę doczekać się, aż zobaczę, co wyrosło z niej i reszty rodziny Entrati, w całej ich... zainfekowanej chwale.",shape=box,color=blue];
		2027 -> 2029;
		2027 -> 2030;
	2031 [label="Cieszę się, że udało nam się przekonać Loida, żeby poszedł na górę.",shape=box,color=red];
		2031 -> 2035;
	2032 [label="Wiem, że nie pamiętasz, dlaczego to zrobiliśmy, ale dobrze się stało, że udało nam się wprowadzić Loida na górę.",shape=box,color=red];
		2032 -> 2036;
	2029 [label="Nadal zastanawiam się, czy to dobry pomysł...",shape=box,color=red];
		2029 -> 2033;
	2030 [label="Jeśli uda nam się przekonać Loida, żeby poszedł na górę, co planujesz wtedy zrobić?",shape=box,color=red];
		2030 -> 2034;
	2035 [label="Tak mówisz. A ja stoję tam jak idiota, pilnując ich, słuchając, jak rozmawiają o zjeździe, jakbym sam to pamiętał. Wiesz, jakie to jest niezręczne?!",shape=box,color=blue];
		2035 -> 2039;
	2036 [label="Wiesz, jakie to jest niezręczne, stać tam i udawać, że pamiętam to spotkanie?! Kiedy za nic w świecie nie mogę sobie tego przypomnieć?!",shape=box,color=blue];
		2036 -> 2039;
	2033 [label="Hm, raczej nie. Ciekawi mnie, czy masz przypadkiem adres korespondencyjny Albrechta?",shape=box,color=blue];
		2033 -> 2037;
	2034 [label="Jeszcze nie zdecydowałem. Może zacznę odcinać im kończyny i konserwować je w płynie. Nie masz przypadkiem adresu korespondencyjnego Albrechta?",shape=box,color=blue];
		2034 -> 2038;
	2039 [label="To tak, jakbyś stał na gali, kiedy ktoś podchodzi do ciebie i wyraźnie wie, kim jesteś, a ty nie masz o nim żadnych wspomnień, ale jesteś zmuszony kontynuować rozmowę, jakbyś ich znał!",shape=box,color=blue];
		2039 -> 2042;
	2037 [label="Nie dlaczego?",shape=box,color=red];
		2037 -> 2040;
	2038 [label="Co takiego?!",shape=box,color=red];
		2038 -> 2041;
	2042 [label="Czy masz choć cień pojęcia o piekle, w jakie mnie wpakowałeś?! Masz w ogóle pojęcie?! To okropne tak tam stać i to wszystko twoja wina! ",shape=box,color=blue];
		2042 -> 2044;
	2040 [label="Myślałem, że jak już będę na górze, zacznę odcinać kończyny członków jego rodziny i wysyłać mu je w słoikach, po jednym na raz.",shape=box,color=blue];
		2040 -> 5776;
	2041 [label="+10 Chemistry",color=orange];
		2041 -> 2043;
	2044 [label="Ba, dosyć tego. Muszę się napić.",shape=box,color=blue];
		2044 -> 2046;
	5776 [label="Co?!",shape=box,color=red];
		5776 -> 2041;
	2043 [label="Uspokój się! Czy nikt tu nie potrafi żartować?",shape=box,color=blue];
		2043 -> 2045;
	2046 [label="+10 Chemistry",color=orange];
		2046 -> 2048;
	2045 [label="Kto w ogóle przyjąłby taką przesyłkę?",shape=box,color=blue];
		2045 -> 2047;
	2048 [label="Chat ends.",color=orange];
	2047 [label="Chat ends.",color=orange];
}