digraph {
	"RoatheRank3Convo5 begins." [color=orange];
		"RoatheRank3Convo5 begins." -> j2137373290;
	j2137373290 [label="Albrecht był problemem od samego początku. On i jego zabawy z Pustką. Myślę, że Gerivaine została mu dana w nadziei, że założenie rodziny po prostu go uspokoi.",shape=box,color=blue];
		j2137373290 -> j4111621193;
	j4111621193 [label="Myślę, że to po prostu pogorszyło sytuację. Kiedy miał dzieci, traktował je jak dodatkową parę rąk. Wspólników w swoich szalonych eksperymentach.",shape=box,color=blue];
		j4111621193 -> j3804697878;
	j3804697878 [label="Zasób do wykorzystania. Jak wszystko w jego życiu.",shape=box,color=blue];
		j3804697878 -> j1313785406;
		j3804697878 -> j2386032960;
		j3804697878 -> j386906797;
	j1313785406 [label="Gerivaine?",shape=box,color=red];
		j1313785406 -> j1043489052;
	j2386032960 [label="On postrzega ludzi jako coś więcej niż tylko zasoby.",shape=box,color=red];
		j2386032960 -> j1918782138;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j1043489052 [label="Imię, które mogło zaginąć w mrokach dziejów... Żona Albrechta Entratiego, Uzurpatorze. Matka jego dzieci.",shape=box,color=blue];
		j1043489052 -> j4103666644;
	j1918782138 [label="No cóż, przyznaję, że jest on gotów zamordować każdego w swoim życiu, z obojętnością Egzekutora. Ale nie zrobi tego bez celu.",shape=box,color=blue];
		j1918782138 -> j1819445225;
	"Chat ends." [color=orange];
	j4103666644 [label="Check boolean LoidFamilyComplete",color=orange];
		j4103666644 -> j1175577302 [label=true,color=green];
		j4103666644 -> j3567343649 [label=false,color=brown];
	j1819445225 [label="Wiesz, teraz, kiedy o tym myślę, to właśnie jego beznamiętna natura czyniła go tak niebezpiecznym w naszych czasach. Był zdolny poświęcić wszystko, byle tylko osiągnąć swoje cele. Wszystko.",shape=box,color=blue];
		j1819445225 -> j660409610;
		j1819445225 -> j3878782241;
	j1175577302 [label="Pewnie znów zgrywasz przede mną głupka. Szanse na to, że już to wiedziałeś, są wysokie, kiedy sługa wrócił do rodziny.",shape=box,color=blue];
		j1175577302 -> j4164081959;
	j3567343649 [label="Ci, którzy siedzą nad nami, nieświadomi naszego istnienia w tym gnijącym Sanktuarium. Co wciąż uważam za absolutnie bezcenne.",shape=box,color=blue];
		j3567343649 -> j1819445225;
	j660409610 [label="Myślałem, że Orokin nie będą mieli problemu z poświęceniem tego, na czym im zależy. Wszyscy wydawaliście się wobec siebie niezwykle bezwzględni.",shape=box,color=red];
		j660409610 -> j2967288034;
	j3878782241 [label="Jak doszedłeś do tego wniosku?",shape=box,color=red];
		j3878782241 -> j2132039385;
	j4164081959 [label="Ale nie wciągniesz mnie w kolejną dyskusję na ten temat. Nie mam na to nastroju.",shape=box,color=blue];
		j4164081959 -> j1819445225;
	j2967288034 [label="Bardzo chętnie zakładasz wiele rzeczy, o których nic nie wiesz, Włóczęgo.",shape=box,color=blue];
		j2967288034 -> j1342518086;
	j2132039385 [label="+10 Chemistry",color=orange];
		j2132039385 -> j2513286431;
	j1342518086 [label="A może twoja skóra ma delikatny odcień błękitu, który przeoczyłem? Może byłeś Orokin? Jeśli tak, jak najmocniej przepraszam!",shape=box,color=blue];
		j1342518086 -> j1519761441;
		j1342518086 -> j3098160132;
	j2513286431 [label="Być może panuje błędne przekonanie, że my, Orokin, tylko wbijaliśmy sobie noże w plecy i mordowaliśmy się nawzajem. To nie było rzadkie, nie zrozum mnie źle, ale byliśmy niemal nieśmiertelni. Musieliśmy jakoś zabić nudę.",shape=box,color=blue];
		j2513286431 -> j3043381543;
	j1519761441 [label="Przepraszam. Nie chciałem cię urazić. Szczerze mówiąc, sam niewiele pamiętam ze społeczeństwa Orokin, mogłem na nie patrzeć tylko z zewnątrz.",shape=box,color=red];
		j1519761441 -> j611546615;
	j3098160132 [label="Przykro mi, ale to, co pamiętam o społeczeństwie Orokin, nie było wspaniałe. Głównie nagrane wypowiedzi, wykrzykujące rozkazy do mnie z głośników. To było, zanim zostałem uwięziony w Pustce...",shape=box,color=red];
		j3098160132 -> j3359786722;
	j3043381543 [label="Ale byliśmy też narodem głęboko zaangażowanym. Nikt nie tworzył sztuki w taki sposób jak Orokin. Nikt nie komponował muzyki, teatru ani poezji, tak jak my.",shape=box,color=blue];
		j3043381543 -> j1448211618;
	j611546615 [label="Przeprosiny przyjęte. Tym razem. Już dość mam do czynienia z takim brakiem szacunku ze strony innych. Choć jesteś fascynujący, nie jestem chłopcem do bicia. Mam ciekawsze zajęcia.",shape=box,color=blue];
		j611546615 -> j3222524809;
	j3359786722 [label="Boolean RoatheInsulted is now true.",color=orange];
		j3359786722 -> j1741695249;
	j1448211618 [label="I nikt nie kochał tak głęboko jak my, gdy nasze serca zakochały się w drugiej osobie.",shape=box,color=blue];
		j1448211618 -> j3978610942;
	j3222524809 [label="O czym to ja mówiłem? Ach, tak. Nasz niewzruszony Entrati.",shape=box,color=blue];
		j3222524809 -> j2513286431;
	j1741695249 [label="Ostrzegam. Już dość mam do czynienia z takim brakiem szacunku ze strony innych. Choć jesteś fascynujący, nie jestem chłopcem do bicia. Mam ciekawsze zajęcia.",shape=box,color=blue];
		j1741695249 -> j3222524809;
	j3978610942 [label="Wszyscy oprócz Albrechta. Wszystko, co robił, każdy, z kim się kontaktował, wyglądało tak, jakby patrzył na to przez fragment swojego ukochanego seriszkła.",shape=box,color=blue];
		j3978610942 -> j3183198686;
	j3183198686 [label="Odsunięty. Nieobecny. Niezainteresowany. Niezrażony. Nawet gdy Gerivaine zmarła i został sam, by wychować swoją małą córeczkę.",shape=box,color=blue];
		j3183198686 -> j1969269467;
	j1969269467 [label="Check boolean LoidFamilyComplete",color=orange];
		j1969269467 -> j3631739838 [label=true,color=green];
		j1969269467 -> j2428990471 [label=false,color=brown];
	j3631739838 [label="Której najpewniej przeznaczone było osiągnąć więcej, niż on kiedykolwiek. Gdyby tylko nie została zakażona i uwięziona. Jaka szkoda.",shape=box,color=blue];
		j3631739838 -> j819730474;
		j3631739838 -> j2828311223;
	j2428990471 [label="Której najpewniej przeznaczone było osiągnąć więcej, niż on kiedykolwiek. Nie mogę doczekać się, aż zobaczę, co wyrosło z niej i reszty rodziny Entrati, w całej ich... zainfekowanej chwale.",shape=box,color=blue];
		j2428990471 -> j4076239983;
		j2428990471 -> j3211816042;
	j819730474 [label="Cieszę się, że udało nam się przekonać Loida, żeby poszedł na górę.",shape=box,color=red];
		j819730474 -> j4053333828;
	j2828311223 [label="Wiem, że nie pamiętasz, dlaczego to zrobiliśmy, ale dobrze się stało, że udało nam się wprowadzić Loida na górę.",shape=box,color=red];
		j2828311223 -> j3102707029;
	j4076239983 [label="Nadal zastanawiam się, czy to dobry pomysł...",shape=box,color=red];
		j4076239983 -> j3551925606;
	j3211816042 [label="Jeśli uda nam się przekonać Loida, żeby poszedł na górę, co planujesz wtedy zrobić?",shape=box,color=red];
		j3211816042 -> j1977401468;
	j4053333828 [label="Tak mówisz. A ja stoję tam jak idiota, pilnując ich, słuchając, jak rozmawiają o zjeździe, jakbym sam to pamiętał. Wiesz, jakie to jest niezręczne?!",shape=box,color=blue];
		j4053333828 -> j3941054820;
	j3102707029 [label="Wiesz, jakie to jest niezręczne, stać tam i udawać, że pamiętam to spotkanie?! Kiedy za nic w świecie nie mogę sobie tego przypomnieć?!",shape=box,color=blue];
		j3102707029 -> j3941054820;
	j3551925606 [label="Hm, raczej nie. Ciekawi mnie, czy masz przypadkiem adres korespondencyjny Albrechta?",shape=box,color=blue];
		j3551925606 -> j3949707680;
	j1977401468 [label="Jeszcze nie zdecydowałem. Może zacznę odcinać im kończyny i konserwować je w płynie. Nie masz przypadkiem adresu korespondencyjnego Albrechta?",shape=box,color=blue];
		j1977401468 -> j4064299627;
	j3941054820 [label="To tak, jakbyś stał na gali, kiedy ktoś podchodzi do ciebie i wyraźnie wie, kim jesteś, a ty nie masz o nim żadnych wspomnień, ale jesteś zmuszony kontynuować rozmowę, jakbyś ich znał!",shape=box,color=blue];
		j3941054820 -> j2973632019;
	j3949707680 [label="Nie dlaczego?",shape=box,color=red];
		j3949707680 -> j1938367010;
	j4064299627 [label="Co takiego?!",shape=box,color=red];
		j4064299627 -> j3572817924;
	j2973632019 [label="Czy masz choć cień pojęcia o piekle, w jakie mnie wpakowałeś?! Masz w ogóle pojęcie?! To okropne tak tam stać i to wszystko twoja wina! ",shape=box,color=blue];
		j2973632019 -> j1966632366;
	j1938367010 [label="Myślałem, że jak już będę na górze, zacznę odcinać kończyny członków jego rodziny i wysyłać mu je w słoikach, po jednym na raz.",shape=box,color=blue];
		j1938367010 -> j3324176037;
	j3572817924 [label="+10 Chemistry",color=orange];
		j3572817924 -> j1551061442;
	j1966632366 [label="Ba, dosyć tego. Muszę się napić.",shape=box,color=blue];
		j1966632366 -> j1933300832;
	j3324176037 [label="Co?!",shape=box,color=red];
		j3324176037 -> j3572817924;
	j1551061442 [label="Uspokój się! Czy nikt tu nie potrafi żartować?",shape=box,color=blue];
		j1551061442 -> j469204154;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j469204154 [label="Kto w ogóle przyjąłby taką przesyłkę?",shape=box,color=blue];
		j469204154 -> "Chat ends.";
}