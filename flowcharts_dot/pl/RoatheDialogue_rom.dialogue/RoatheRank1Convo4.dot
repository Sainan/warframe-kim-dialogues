digraph {
	472 [label="RoatheRank1Convo4 begins.",color=orange];
		472 -> 473;
	473 [label="Check boolean LoidFamilyComplete",color=orange];
		473 -> 474 [label=true,color=green];
		473 -> 475 [label=false,color=brown];
	474 [label="To niemal tragiczne, co stało się z Eulerią i Petrosem. Przypomnę, że nigdy nie byliśmy przyjaciółmi. Ale oni wciąż byli Orokin. A teraz zostało nas już bardzo niewielu. Powinienem uważać, co mówię – kto wie, kim mógłbym się stać z czasem.",shape=box,color=blue];
		474 -> 476;
	475 [label="Uważam za dość histeryczne, że Euleria i Petros naprawdę nie mają pojęcia, że tu jesteśmy. Jak szczury, biegające im pod nogami. Jak tobie i dzieciom udało się tak długo utrzymać to wszystko w tajemnicy?",shape=box,color=blue];
		475 -> 477;
	476 [label="Najbardziej zaskakuje mnie, że \"Babcia\" przeżyła. (Wyobraź sobie oddać tak dobre imię jak Dagath.)",shape=box,color=blue];
		476 -> 478;
		476 -> 479;
	477 [label="Evaluate expressions on HellStory",color=orange];
		477 -> 481 [label="x >= 21",color=purple];
		477 -> 480 [label="x < 21",color=purple];
		477 -> 480 [label="false",color=purple];
	478 [label="Petros?",shape=box,color=red];
		478 -> 482;
	479 [label="Co myślisz o dzieciach?",shape=box,color=red];
		479 -> 483;
	481 [label="Choć muszę przyznać, że zaskakuje mnie, jak \"Babcia\" nie była w stanie sobie z tym poradzić. (wyobraź sobie oddać tak piękne imię jak Dagath). Myślałem, że ma w sobie więcej rozumu.",shape=box,color=blue];
		481 -> 486;
	480 [label="Choć muszę przyznać, że zaskakuje mnie, jak \"Babcia\" nie była w stanie sobie z tym poradzić. (Wyobraź sobie oddać tak piękne imię jak Dagath). Myślałem, że ma w sobie więcej rozumu.",shape=box,color=blue];
		480 -> 484;
		480 -> 485;
	482 [label="Hm? Ach. Nekraloid poinformował mnie, że ty albo to dziecko zrobiliście wielką aferę, pomagając im wymyślać fałszywe imiona, bo zapomnieli swoich prawdziwych. Znasz go jako \"Vilcor\".",shape=box,color=blue];
		482 -> 487;
	483 [label="Chłopak jest kapryśny, irytujący i egocentryczny. Idealny Orokin. \"Kaelli\", jak woli być teraz nazywana, uważam za niezwykle inteligentną i niemal wartą znoszenia jej obecności.",shape=box,color=blue];
		483 -> 488;
	486 [label="I — choć to absurdalne — wiem, że już przez to wszystko przechodziliśmy. I już o tym rozmawialiśmy. Co wciąż uważam za głęboko niepokojące.",shape=box,color=blue];
		486 -> 491;
	484 [label="Są zajęci własnymi problemami.",shape=box,color=red];
		484 -> 489;
	485 [label="Petros?",shape=box,color=red];
		485 -> 490;
	487 [label="Ja znałem go jako Petrosa Vortena. Dumnego wynalazcę Floty Nekramechów. Dziwnie jest pomyśleć, ile czasu minęło dla niego, a jak mało – relatywnie rzecz biorąc – dla mnie.",shape=box,color=blue];
		487 -> 488;
	488 [label="Ale jak to możliwe, że jeszcze tego nie wiesz? Robisz ze mnie głupca, Uzurpatorze? Przecież po prostu... odgrzewamy stary temat, że tak się wyrażę?",shape=box,color=blue];
		488 -> 492;
	491 [label="Evaluate expressions",color=orange];
		491 -> 498 [label="RoatheDatingDeal",color=purple];
		491 -> 498 [label="RoatheMarieDatingDeal",color=purple];
		491 -> 498 [label="RoatheLyonDatingDeal",color=purple];
		491 -> 498 [label="RoatheSerumDeal",color=purple];
		491 -> 497 [label="RoatheFamilyDeal",color=purple];
		491 -> 498 [label="RoatheMarieEntratiDeal",color=purple];
		491 -> 498 [label="RoatheLyonConfessionDeal",color=purple];
		491 -> 499 [label="false",color=purple];
	489 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		489 -> 494 [label=true,color=green];
		489 -> 493 [label=false,color=brown];
	490 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		490 -> 496 [label=true,color=green];
		490 -> 495 [label=false,color=brown];
	492 [label="Update boolean RoatheKnowsReset",color=orange];
		492 -> 500;
		492 -> 501;
		492 -> 502;
	498 [label="I oto jestem, gotowy wygłosić mroczny i rozwiązły wykład na temat społeczności Orokin, łudząc się, że będzie to dla ciebie jakkolwiek interesujące. A potem przypominam sobie, nie dla tego tu jesteś, czyż nie, Włóczęgo? Twoją głowę zaprząta inna rozgrywka...",shape=box,color=blue];
		498 -> 506;
	497 [label="I oto jestem, gotowy wygłosić mroczny i rozwiązły wykład na temat społeczności Orokin, łudząc się, że będzie to dla ciebie jakkolwiek interesujące. A potem przypominam sobie, że już to słyszałeś, czyż nie?",shape=box,color=blue];
		497 -> 505;
	499 [label="Wolałbyś, żebym po prostu tańczył, jak mi zagrasz? Czy... masz może inny cel, który starasz się osiągnąć? Nadal zdumiewa mnie, co możesz chcieć osiągnąć przez tę okrutną grę.",shape=box,color=blue];
		499 -> 507;
	494 [label="Ach, tak, zasłyszałem już od nekraloida. Wygląda na to, że mają ich mniej, od kiedy z dzieciakiem je rozwiązaliście. Przynajmniej nie skaczą już sobie do gardeł.",shape=box,color=blue];
		494 -> 504;
	493 [label="Ach, tak, zasłyszałem już od nekraloida. Wygląda na to, że nadal chcą się nawzajem zagryźć.",shape=box,color=blue];
		493 -> 503;
	496 [label="Hm? Ach. Nekraloid poinformował mnie, że ty albo to dziecko zrobiliście wielką aferę, pomagając im wymyślać fałszywe imiona, bo zapomnieli swoich prawdziwych. Znasz go jako \"Vilcor\". Ja znałem go jako Petrosa Vortena. Dumnego wynalazcę Floty Nekramechów.",shape=box,color=blue];
		496 -> 504;
	495 [label="Hm? Ach. Znałem go jako Petrosa Vortena. Dumnego wynalazcę Floty Nekramechów. Ale nekraloid poinformował mnie, że zapomnieli swoich imion. Możesz go znać jako \"Ojca\".",shape=box,color=blue];
		495 -> 503;
	500 [label="Nie, tego jeszcze nie słyszałem. Nie przeszkadzaj sobie.",shape=box,color=red];
		500 -> 508;
	501 [label="Rozmawiam z tobą, Roathe... bo chcę z tobą rozmawiać.",shape=box,color=red];
		501 -> 509;
	502 [label="Tak, już to słyszałem. Ale z chęcią posłucham jeszcze raz.",shape=box,color=red];
		502 -> 510;
	506 [label="Update boolean RoatheKnowsReset",color=orange];
		506 -> 500;
		506 -> 501;
		506 -> 502;
	505 [label="Update boolean RoatheKnowsReset",color=orange];
		505 -> 500;
		505 -> 501;
		505 -> 502;
	507 [label="Update boolean RoatheKnowsReset",color=orange];
		507 -> 515;
	504 [label="Evaluate expressions",color=orange];
		504 -> 514 [label="RoatheDeal",color=purple];
		504 -> 513 [label="RoatheNoDeal",color=purple];
		504 -> 513 [label="false",color=purple];
	503 [label="Evaluate expressions",color=orange];
		503 -> 512 [label="RoatheDeal",color=purple];
		503 -> 511 [label="RoatheNoDeal",color=purple];
		503 -> 511 [label="false",color=purple];
	508 [label="+5 Chemistry",color=orange];
		508 -> 516;
	509 [label="Check boolean DrifterRoathe",color=orange];
		509 -> 517 [label=true,color=green];
		509 -> 518 [label=false,color=brown];
	510 [label="Więc przyznajesz, że marnujesz mój czas. Jak wspaniale! Nie jestem jakimś zgryźliwym, schorowanym starcem, opowiadającym tę samą historię z wojny, bo innych nie mogę sobie przypomnieć.",shape=box,color=blue];
		510 -> 519;
	515 [label="I oto jestem, gotowy wygłosić mroczny i rozwiązły wykład na temat społeczności Orokin, łudząc się, że będzie to dla ciebie jakkolwiek interesujące. A potem przypominam sobie, że już to słyszałeś, czyż nie?",shape=box,color=blue];
		515 -> 500;
		515 -> 501;
		515 -> 502;
	514 [label="To dobrze, bo bez ciebie ani dzieciaka nie osiągnęlibyśmy tego kluczowego celu. Obawiam się natomiast, że sługa zostałby od razu przerobiony na mielone, gdyby zawędrował na górę.",shape=box,color=blue];
		514 -> 522;
	513 [label="A tak przy okazji, czy rozważyłeś moją propozycję? Mój spokój tutaj w zamian za pomoc w pogodzeniu sługi i porzuconych wyrzutków z Orokin na górze?",shape=box,color=blue];
		513 -> 520;
		513 -> 521;
	512 [label="Dlatego powinieneś chcieć rozwiązać ten problem jako pierwszy, zanim zdecydujesz się wysłać sługę na górę. Żeby nie zrobili z niego mielonki.",shape=box,color=blue];
		512 -> 522;
	511 [label="A tak przy okazji, czy rozważyłeś moją propozycję? Mój spokój tutaj w zamian za pomoc w pogodzeniu sługi i porzuconych wyrzutków z Orokin na górze? Pojednanie rodziny byłoby pierwszym krokiem, ale...",shape=box,color=blue];
		511 -> 520;
		511 -> 521;
	516 [label="Poprosiłeś Orokin o rozmowę. Nie wiesz, na co się piszesz. Będziesz tu siedzieć przez godzinę, jeśli nie będziesz ostrożny.",shape=box,color=blue];
		516 -> 523;
	517 [label="+5 Chemistry",color=orange];
		517 -> 524;
	518 [label="Och? Zechciałbyś się podzielić dlaczego?",shape=box,color=blue];
		518 -> 528;
		518 -> 527;
		518 -> 525;
		518 -> 526;
	519 [label="Powód, dla którego nie pamiętam tej rozmowy, możesz zobaczyć w lustrze!",shape=box,color=blue];
		519 -> 529;
	522 [label="Jedno musisz zrozumieć: sługa i rodzina Entrati nadal należą do kasty Orokin. Urodzili się i wychowali w tym społeczeństwie, pomimo jego... licznych wad.",shape=box,color=blue];
		522 -> 532;
	520 [label="Nie, nie zmienię zdania, Roathe. To nie jest aż tak ważne.",shape=box,color=red];
		520 -> 530;
	521 [label="Tak... zgadzam się.",shape=box,color=red];
		521 -> 531;
	523 [label="Choć przypuszczam, że nie miałeś zbyt wielu okazji do interakcji z Orokin, prawda, Włóczęgo? Dzieciak żył zupełnie innym życiem.",shape=box,color=blue];
		523 -> 533;
	524 [label="Mm. Zgadza się. I oboje wiemy dlaczego, prawda? Ale musisz być cierpliwy.",shape=box,color=blue];
		524 -> 534;
	528 [label="[Wyznaj uczucia] Chyba już wiesz.",shape=box,color=red];
		528 -> 538;
	527 [label="Intrygujesz mnie.",shape=box,color=red];
		527 -> 537;
	525 [label="Nie miałem zbyt wielu okazji do interakcji z Orokin. Oprócz... walki z nimi. Jesteś fascynujący.",shape=box,color=red];
		525 -> 535;
	526 [label="Nieważne. [Koniec]",shape=box,color=red];
		526 -> 536;
	529 [label="Chat ends.",color=orange];
	532 [label="I pomimo wszystkich grzechów, ranga i porządek nigdy nie były kwestionowane. Ani w wojsku – ani w społeczeństwie. Archimedianie słuchali Orokin. Orokin słuchali Egzekutorów. Egzekutorzy słuchali Imperatorów… cóż, przynajmniej z nazwy.",shape=box,color=blue];
		532 -> 541;
	530 [label="Jak chcesz, drzwi nie będą otwarte zbyt długo.",shape=box,color=blue];
		530 -> 539;
	531 [label="Update boolean RoatheNoDeal",color=orange];
		531 -> 540;
	533 [label="Z tego, co słyszałem, zmierzałeś w kierunku tragedii Zarimana Ten Zero.",shape=box,color=blue];
		533 -> 542;
		533 -> 543;
		533 -> 544;
	534 [label="Tymczasemm jeśli chcesz \"posłuchać\", chętnie pomogę. Po prostu uczciwie ostrzegam. Poprosiłeś Orokin, żeby przemówił.",shape=box,color=blue];
		534 -> 545;
	538 [label="+5 Chemistry",color=orange];
		538 -> 549;
	537 [label="+5 Chemistry",color=orange];
		537 -> 548;
	535 [label="Więc znaj swojego wroga? A może to po prostu ciekawość, by usiąść po drugiej stronie stołu od niemożliwości? ",shape=box,color=blue];
		535 -> 546;
	536 [label="Walcz, ile chcesz, rybko. Sam wpłynąłeś w moje sidła.",shape=box,color=blue];
		536 -> 547;
	541 [label="A nawet jeśli nie wierzysz, że jakoś, nawet po tym wszystkim, tradycje mogłyby zachęcić Loida do wysłuchania mnie? Weź pod uwagę fakt, że potrafię być... głęboko przekonujący. W końcu byłem prawą ręką najgorszej z Egzekutorów.",shape=box,color=blue];
		541 -> 551;
		541 -> 552;
		541 -> 553;
	539 [label="Chat ends.",color=orange];
	540 [label="Update boolean RoatheDeal",color=orange];
		540 -> 550;
	542 [label="Nie. Przed Zarimanem nie miałem zbyt wiele do czynienia z Orokin, a po nim, cóż... jestem pewien, że słyszałeś już, co się stało.",shape=box,color=red];
		542 -> 554;
	543 [label="Miałem wystarczająco dużo do czynienia z Orokin, żeby wiedzieć, że nie można mieć do nich za grosz zaufania.",shape=box,color=red];
		543 -> 555;
	544 [label="Niestety, ale nie mam do takich jak ty więcej sympatii niż dzieciak.",shape=box,color=red];
		544 -> 555;
	545 [label="Nie wiesz, na co się piszesz. Będziesz tu siedzieć przez godzinę, jeśli nie będziesz ostrożny.",shape=box,color=blue];
		545 -> 523;
	549 [label="Mhm. Wiem. A myślałem, że zaszczycisz mnie tą wiadomością na piśmie. No cóż...",shape=box,color=blue];
		549 -> 557;
	548 [label="Naprawdę? Zobaczmy więc, jak długo dam radę utrzymać tę rybę na haczyku.",shape=box,color=blue];
		548 -> 534;
	546 [label="+5 Chemistry",color=orange];
		546 -> 556;
	547 [label="Chat ends.",color=orange];
	551 [label="Najgorszym z Egzekutorów był Ballas.",shape=box,color=red];
		551 -> 559;
	552 [label="Komu służyłeś?",shape=box,color=red];
		552 -> 560;
	553 [label="How so?",shape=box,color=red];
		553 -> 561;
	550 [label="+5 Chemistry",color=orange];
		550 -> 558;
	554 [label="Tak. Ach, Ballas. Może cię to zaskoczyć, ale nie był najgorszym z nich.",shape=box,color=blue];
		554 -> 562;
		554 -> 563;
	555 [label="Nie dziwię ci się. Myślałem, że można ich uratować. W pewnym sensie przetopić, nadać nową formę, niczym złoto.",shape=box,color=blue];
		555 -> 564;
	557 [label="Może innym razem. Bo ty, Uzurpatorze, musisz nauczyć się delektować takimi chwilami.",shape=box,color=blue];
		557 -> 566;
	556 [label="To godne poszanowania. Nawet roztropne. Gdybym miał okazję porozmawiać, może nawet zaprzyjaźnić się ze Świadomym? Zrobiłbym tak samo.",shape=box,color=blue];
		556 -> 565;
	559 [label="Szanuję twoje zdanie i nie dziwię ci się. Ballas był kretynem, a jednocześnie mistrzem wśród zwyrodnialców, nie będę się o to kłócił.",shape=box,color=blue];
		559 -> 567;
	560 [label="Evaluate expressions on HellStory",color=orange];
		560 -> 569 [label="x >= 1",color=purple];
		560 -> 568 [label="x <= 1",color=purple];
		560 -> 568 [label="false",color=purple];
	561 [label="Rozumiem, że miałeś styczność Ballasem i nie dziwię ci się, że uważasz go za najgorszego spośród Siedmiu Złotych Lordów. Był mistrzem wśród zwyrodnialców, nie będę się z o to kłócił.",shape=box,color=blue];
		561 -> 570;
	558 [label="Wspaniale! Cieszę się, że w końcu przejrzałeś na oczy. Teraz w końcu możemy przejść do działania.",shape=box,color=blue];
		558 -> 522;
	562 [label="Naprawdę?",shape=box,color=red];
		562 -> 571;
	563 [label="Raczej byś mi nie uwierzył.",shape=box,color=red];
		563 -> 571;
	564 [label="No, oprócz Egzekutorów. Dla nich nie było nadziei. Może cię zaskoczyć, że Ballas nie był najgorszym z nich.",shape=box,color=blue];
		564 -> 563;
		564 -> 562;
	566 [label="Update boolean DrifterRoathe",color=orange];
		566 -> 534;
	565 [label="Wiążą się z tym korzyści, gdyby było ci dane spotkać takiego — może nawet byłego sojusznika — na polu bitwy.",shape=box,color=blue];
		565 -> 572;
	567 [label="I faktycznie, nie byłem świadkiem horroru \"Narmer\", o którym dowiedziałem się od sługi i mogłem przeczytać zapiski na tych tutaj maszynach POM-2.",shape=box,color=blue];
		567 -> 573;
	569 [label="Wspominałem już o niej. I, co ważniejsze, zapowiedź tego, co planowaliśmy. Ale to historia na inną okazję. Egzekutorka Nitokh. A dokładniej, Wielka Regentka Egzekutorka Nitokh. Dowódczyni wszystkich naszych sił zbrojnych i najokrutniejsza oraz najgroźniejsza z Siedmiu Złotych Lordów.",shape=box,color=blue];
		569 -> 574;
	568 [label="Egzekutorka Nitokh. A dokładniej, Wielka Regentka Egzekutorka Nitokh. Dowódczyni wszystkich sił zbrojnych. Najokrutniejsza i najgroźniejsza z Siedmiu Złotych Lordów.",shape=box,color=blue];
		568 -> 574;
	570 [label="Jest nawet całkiem prawdopodobne, że prześcignął dawnych Egzekutorów w tej... sprawie \"Narmer\", o której słyszałem od sługi i czytałem na tym oto POM-2.",shape=box,color=blue];
		570 -> 573;
	571 [label="Nie twierdzę, że był święty. Mówię ci, że najgorszy z diabłów został tylko nieznacznie zdeklasowany przez swoich rówieśników. To tylko najdrobniejszy szczegół, który cisnę na usta, Uzurpatorze.",shape=box,color=blue];
		571 -> 575;
	572 [label="Jeśli chcesz \"posłuchać\", chętnie pomogę. Po prostu uczciwie ostrzegam. Poprosiłeś przedstawiciela Orokin, żeby przemówił.",shape=box,color=blue];
		572 -> 545;
	573 [label="Chciałbym jednak zasugerować, że takie wrażenie zawdzięczasz bardzo bliskiej relacji z Ballasem i bardzo ograniczonej interakcji z pozostałymi sześcioma Złotymi Lordami.",shape=box,color=blue];
		573 -> 574;
	574 [label="Złota Siódemka. Tfu. Wiesz, co jest najlepsze w złocie, Włóczęgo? Można je bez końca przetapiać i przerabiać na coś lepszego.",shape=box,color=blue];
		574 -> 576;
	575 [label="Ale czy Ballas był najgorszy? Dla ciebie, być może. I być może jego zbrodnie w tej epoce przewyższyły zbrodnie dawnych Egzekutorów.",shape=box,color=blue];
		575 -> 577;
	576 [label="Wierzyłem – i w pewnym sensie nadal wierzę – że Orokin da się uratować. Że moglibyśmy odwrócić losy Imperium. Ale Egzekutorzy? Nie. Trzeba ich było powstrzymać. Byli najgorszymi potworami, jakie spłodziła ludzkość.",shape=box,color=blue];
		576 -> 578;
	577 [label="Ale gdybyś spojrzał na jeziora czerwieni i pola poszarpanych ciał, porzucone niczym dziecięce zabawki –",shape=box,color=blue];
		577 -> 579;
	578 [label="A mówię to ja, Uzurpatorze. Pozwól więc, że ja, sam Diabeł z Tau, zapewnię cię – jako ekspert w tej dziedzinie – że Ballas nie był najgorszy z nich.",shape=box,color=blue];
		578 -> 580;
	579 [label="Gdybyś ujrzał zniszczenie, jakie Nitokh potrafiła wyrządzić w zaledwie chwilę... ",shape=box,color=blue];
		579 -> 581;
	580 [label="Check boolean RoatheUsurper",color=orange];
		580 -> 583 [label=true,color=green];
		580 -> 584 [label=true,color=green];
		580 -> 582 [label=false,color=brown];
		580 -> 583 [label=false,color=brown];
		580 -> 584 [label=false,color=brown];
	581 [label="Ale takie horrory trudno odczuć, jeśli się ich nie jest świadkiem. Takiej tragedii nie da się zrozumieć w liczbach. Mógłbym długo opowiadać o tym, co widziałem, ale dla ciebie będą to po prostu historie.",shape=box,color=blue];
		581 -> 585;
	583 [label="Raczej byś mi nie uwierzył.",shape=box,color=red];
		583 -> 587;
	584 [label="Naprawdę?",shape=box,color=red];
		584 -> 587;
	582 [label="Więc dlaczego wciąż nazywasz mnie \"Uzurpatorem\"?",shape=box,color=red];
		582 -> 586;
	585 [label="Dla ciebie Ballas zawsze będzie bardziej dominującym i przerażającym złoczyńcą. To zrozumiałe.",shape=box,color=blue];
		585 -> 588;
	587 [label="Gdybyś spojrzał na jeziora czerwieni i pola poszarpanych ciał, porzucone niczym dziecięce zabawki –",shape=box,color=blue];
