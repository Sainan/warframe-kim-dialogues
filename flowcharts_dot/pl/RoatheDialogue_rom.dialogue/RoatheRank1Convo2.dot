digraph {
	"RoatheRank1Convo2 begins." [color=orange];
		"RoatheRank1Convo2 begins." -> j145542368;
	j145542368 [label="Zdajesz sobie sprawę, że tak zwana \"Obojętność\" nie jest prawdziwym \"bogiem\", prawda?",shape=box,color=blue];
		j145542368 -> j3444640331;
		j145542368 -> j1482008489;
		j145542368 -> j386906797;
	j3444640331 [label="Dużo jej nie brakuje.",shape=box,color=red];
		j3444640331 -> j1585834933;
	j1482008489 [label="Skąd ta pewność?",shape=box,color=red];
		j1482008489 -> j2802790527;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j1585834933 [label="Wszyscy w tym wariatkowie zdają się być przekonani, że \"Pan ze Ściany\" jest manifestacją boga. Prawdziwego boga. Nawet ta dwójka fanatyków tak uważa!",shape=box,color=blue];
		j1585834933 -> j144527226;
		j1585834933 -> j316338722;
		j1585834933 -> j2480514569;
	j2802790527 [label="Cóż, zaczynając od brutalnej rzeczywistości, w której każda wiara w boga lub bogów pochodzi od idiotów, którzy kurczowo trzymają się pluszowej zabawki, kiedy muszą zmierzyć się z realiami własnej śmiertelności.",shape=box,color=blue];
		j2802790527 -> j3763396557;
	"Chat ends." [color=orange];
	j144527226 [label="Uważasz, że on nie istnieje?",shape=box,color=red];
		j144527226 -> j2652541590;
	j316338722 [label="Jeśli nie jest bogiem, to czym?",shape=box,color=red];
		j316338722 -> j797126835;
	j2480514569 [label="A ty masz inne zdanie?",shape=box,color=red];
		j2480514569 -> j2448531858;
	j3763396557 [label="oraz lęku związanego z brakiem \"siły wyższej\", która decydowałaby o naszych życiach, czyniąc nas całkowicie odpowiedzialnymi za nasze decyzje,",shape=box,color=blue];
		j3763396557 -> j785028954;
	j2652541590 [label="Wstrzymaj się, czy ja to powiedziałem? Nie wkładaj mi słów w usta, o Ulotny Uzurpatorze. Nie przeczę, że Obojętność jest \"prawdziwa\". Przeczę stwierdzeniu, jakoby była bogiem.",shape=box,color=blue];
		j2652541590 -> j1397432518;
		j2652541590 -> j1633345025;
	j797126835 [label="Mogę obnażyć to fałszywe bóstwo dwoma słowami, które są ci doskonale znane:",shape=box,color=blue];
		j797126835 -> j1593290997;
	j2448531858 [label="W żadnym razie! Po pierwsze, bogowie nie istnieją, sama idea jest absurdalna. Po drugie - pomyśleć, że Albrecht uwolnił boga Pustki? Śmiechu warte!",shape=box,color=blue];
		j2448531858 -> j3271082985;
	j785028954 [label="i co za tym idzie, złość i przerażenie, kiedy zdajemy sobie sprawę, że nie czeka nas \"piekło\" dla tych złych i \"raj\" dla tych dobrych.",shape=box,color=blue];
		j785028954 -> j189389670;
	j1397432518 [label="To coś jest potężniejsze niż cokolwiek, z czym się kiedykolwiek mierzyłem.",shape=box,color=red];
		j1397432518 -> j1454251691;
	j1633345025 [label="Więc czym jest według ciebie?",shape=box,color=red];
		j1633345025 -> j797126835;
	j1593290997 [label="Urzeczywistnienie Idei.",shape=box,color=blue];
		j1593290997 -> j340443601;
		j1593290997 -> j2481407354;
		j1593290997 -> j3435383405;
	j3271082985 [label="W Pustce niczego nie ma, dlatego nazywa się Pustką! ",shape=box,color=blue];
		j3271082985 -> j1098828094;
		j3271082985 -> j583043451;
	j189389670 [label="Zakładam, że nie jesteś półmózgim fanatykiem, kurczowo trzymającym się gniewu lub strachu. Bazując na tym założeniu, przejdę do drugiego argumentu, dlaczego nie uważam \"Obojętności\" za boga:",shape=box,color=blue];
		j189389670 -> j1593290997;
	j1454251691 [label="Kiedy temu zaprzeczyłem? Rzeczywiście, wygląda na to, że wszyscy zdołaliście wpędzić się w histeryczny i niepotrzebnie rażący konflikt.",shape=box,color=blue];
		j1454251691 -> j1859179221;
		j1454251691 -> j3428287255;
	j340443601 [label="Pustka i to, co można z niej wycisnąć, jest niebezpieczna i potężna - zaufaj mi. Ale ma też swoje ograniczenia. Naprawdę uważasz, że jest zdolna stworzyć coś takiego? Całe języki, palce zdolne zasilić statki skaczące przez Pustkę?",shape=box,color=red];
		j340443601 -> j3194183431;
	j2481407354 [label="To... bardzo kuszące uwierzyć, że to po prostu potwór spod łóżka, Roathe. Ale widziałem to, stanąłem twarzą w \"twarz\" z tym czymś i nie wiem, czy może pochodzić z naszych głów.",shape=box,color=red];
		j2481407354 -> j912602646;
	j3435383405 [label="Urzeczywistnienie Idei nie jest zdolne zrobić tego, co robi Pan ze Ściany. Entrati mógł go urzeczywistnić - i odpowiada za sprowadzenie go do naszego świata - ale nie wierzę, że jest jego źródłem.",shape=box,color=red];
		j3435383405 -> j478828594;
	j1098828094 [label="Nie, widziałem twory, które pochodziły z Pustki. Anioły. Śpiewy. Duchy.",shape=box,color=red];
		j1098828094 -> j204619205;
	j583043451 [label="... ",shape=box,color=red];
		j583043451 -> j204619205;
	j1859179221 [label="Co próbujesz powiedzieć?",shape=box,color=red];
		j1859179221 -> j3450748904;
	j3428287255 [label="Chwila. Gdzie w tym nasza wina? To Albrecht to wypuścił.",shape=box,color=red];
		j3428287255 -> j2689458011;
	j3194183431 [label="Ludzkość z pewnością jest twórcza w swej rozpiętości i ogromie nowych form cierpienia, jakie potrafi sobie wykreować, prawda? Sam byłeś świadkiem wielu form okrucieństwa, jakich – jestem pewien – nikt nie mógłby sobie wyobrazić w czasach naszych drogich fanatyków.",shape=box,color=blue];
		j3194183431 -> j3011732803;
	j912602646 [label="Ach, jesteś tak blisko prawdy, a jednak tak szybko ją odrzucasz. Myślisz, że \"kuszące\" jest przekonanie, że to wytwór twojego umysłu, bo łatwiej byłoby to odrzucić, gdyby tak było? Nie, myślę, że o wiele bardziej niebezpieczne jest stawienie czoła wytworowi naszego własnego umysłu niż bogu.",shape=box,color=blue];
		j912602646 -> j776521899;
	j478828594 [label="Choć doceniam twoją pokorę, kwestionuję twoje ograniczone rozumienie potencjału ludzkiej kreatywności – zwłaszcza w odniesieniu do tego, jak może ona tworzyć nowe formy cierpienia. Czyż nie jesteś w stanie sam stworzyć własnego wszechświata z niczego?",shape=box,color=blue];
		j478828594 -> j3245061675;
	j204619205 [label="Jedyne, co pochodzi z Pustki, to to, co do niej posłaliśmy - i to, co z niej powróciło. Może przemienić materię i energię, ale nie stworzyć je z niczego.",shape=box,color=blue];
		j204619205 -> j1463029840;
	j3450748904 [label="Próbuję powiedzieć, że to Albrecht mógł być pierwszą osobą, która ujrzała lico swojej własnej pychy, uśmiechające się jako bóg zniszczenia, tak.",shape=box,color=blue];
		j3450748904 -> j2042120322;
	j2689458011 [label="Albrecht mógł być pierwszą osobą, która ujrzała lico swojej własnej pychy, uśmiechające się jako bóg zniszczenia, tak.",shape=box,color=blue];
		j2689458011 -> j2042120322;
	j3011732803 [label="+15 Chemistry",color=orange];
		j3011732803 -> j1049159523;
	j776521899 [label="Wroga zewnętrznego można zrozumieć. Zmanipulować. Pokonać. A może nawet negocjować, jeśli zajdzie taka potrzeba. Ma słabości, które można wykorzystać. Ale wróg wewnętrzny? Stworzony przez nas samych? To o wiele bardziej podstępne.",shape=box,color=blue];
		j776521899 -> j1936980330;
	j3245061675 [label="Sam byłeś świadkiem wielu form okrucieństwa, jakich – jestem pewien – nikt nie mógłby sobie wyobrazić w czasach naszych drogich fanatyków. ",shape=box,color=blue];
		j3245061675 -> j3032159427;
	j1463029840 [label="Zastanów się, Włóczęgo. Te \"Anioły Pustki\" o których mówisz. Te duchy. Czy powstały one z ludzi, którzy już zatracili się w Pustce?",shape=box,color=blue];
		j1463029840 -> j1256989255;
	j2042120322 [label="Ale wy wszyscy jesteście równie odpowiedzialni za popychanie tej sprawy, niczym staczająca z góry kupa odchodów żuka juba, która rośnie z każdym bobkiem zebranym po drodze!",shape=box,color=blue];
		j2042120322 -> j3763573767;
	j1049159523 [label="Nasz gatunek posiada zadziwiającą zdolność karmienia naszych lęków i wymyślania nowych sposobów na samozniszczenie.",shape=box,color=blue];
		j1049159523 -> j3619074688;
	j1936980330 [label="+20 Chemistry",color=orange];
		j1936980330 -> j214618840;
	j3032159427 [label="+10 Chemistry",color=orange];
		j3032159427 -> j1049159523;
	j1256989255 [label="To były jedynie echa energii, zwracane tak, jak kolorowy kutak karmi swoje pisklęta.",shape=box,color=blue];
		j1256989255 -> j3763573767;
	j3763573767 [label="Pozwól, że to dla ciebie uproszczę. Mogę obnażyć to fałszywe bóstwo dwoma słowami, które są ci doskonale znane:",shape=box,color=blue];
		j3763573767 -> j1593290997;
	j3619074688 [label="Mhm. Obawiam się, że muszę już iść. Pozwolę ci w ciszy zastanowić się nad znaczeniem moich słów.",shape=box,color=blue];
		j3619074688 -> j1951923564;
		j3619074688 -> j1234694273;
	j214618840 [label="Wtedy musimy zmierzyć się z własnymi demonami. A ludzkość... nigdy nie wygrywa takich wojen, czyż nie?",shape=box,color=blue];
		j214618840 -> j3619074688;
	j1951923564 [label="Tak zrobię, dzięki.",shape=box,color=red];
		j1951923564 -> j3819439049;
	j1234694273 [label="Zastanów się nad moimi, może zechcesz w nie uwierzyć, kiedy zmierzysz się z anty-bogiem.",shape=box,color=red];
		j1234694273 -> j3819439049;
	j3819439049 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j3819439049 -> "Chat ends.";
}