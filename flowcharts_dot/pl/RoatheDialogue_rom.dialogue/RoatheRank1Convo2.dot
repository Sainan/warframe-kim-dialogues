digraph {
	135 [label="RoatheRank1Convo2 begins.",color=orange];
		135 -> 136;
	136 [label="Zdajesz sobie sprawę, że tak zwana \"Obojętność\" nie jest prawdziwym \"bogiem\", prawda?",shape=box,color=blue];
		136 -> 139;
		136 -> 138;
		136 -> 137;
	139 [label="Dużo jej nie brakuje.",shape=box,color=red];
		139 -> 142;
	138 [label="Skąd ta pewność?",shape=box,color=red];
		138 -> 141;
	137 [label="[Koniec]",shape=box,color=red];
		137 -> 140;
	142 [label="Wszyscy w tym wariatkowie zdają się być przekonani, że \"Pan ze Ściany\" jest manifestacją boga. Prawdziwego boga. Nawet ta dwójka fanatyków tak uważa!",shape=box,color=blue];
		142 -> 144;
		142 -> 145;
		142 -> 146;
	141 [label="Cóż, zaczynając od brutalnej rzeczywistości, w której każda wiara w boga lub bogów pochodzi od idiotów, którzy kurczowo trzymają się pluszowej zabawki, kiedy muszą zmierzyć się z realiami własnej śmiertelności.",shape=box,color=blue];
		141 -> 143;
	140 [label="Chat ends.",color=orange];
	144 [label="Uważasz, że on nie istnieje?",shape=box,color=red];
		144 -> 148;
	145 [label="Jeśli nie jest bogiem, to czym?",shape=box,color=red];
		145 -> 149;
	146 [label="A ty masz inne zdanie?",shape=box,color=red];
		146 -> 150;
	143 [label="oraz lęku związanego z brakiem \"siły wyższej\", która decydowałaby o naszych życiach, czyniąc nas całkowicie odpowiedzialnymi za nasze decyzje,",shape=box,color=blue];
		143 -> 147;
	148 [label="Wstrzymaj się, czy ja to powiedziałem? Nie wkładaj mi słów w usta, o Ulotny Uzurpatorze. Nie przeczę, że Obojętność jest \"prawdziwa\". Przeczę stwierdzeniu, jakoby była bogiem.",shape=box,color=blue];
		148 -> 152;
		148 -> 153;
	149 [label="Mogę obnażyć to fałszywe bóstwo dwoma słowami, które są ci doskonale znane:",shape=box,color=blue];
		149 -> 154;
	150 [label="W żadnym razie! Po pierwsze, bogowie nie istnieją, sama idea jest absurdalna. Po drugie - pomyśleć, że Albrecht uwolnił boga Pustki? Śmiechu warte!",shape=box,color=blue];
		150 -> 155;
	147 [label="i co za tym idzie, złość i przerażenie, kiedy zdajemy sobie sprawę, że nie czeka nas \"piekło\" dla tych złych i \"raj\" dla tych dobrych.",shape=box,color=blue];
		147 -> 151;
	152 [label="To coś jest potężniejsze niż cokolwiek, z czym się kiedykolwiek mierzyłem.",shape=box,color=red];
		152 -> 156;
	153 [label="Więc czym jest według ciebie?",shape=box,color=red];
		153 -> 149;
	154 [label="Urzeczywistnienie Idei.",shape=box,color=blue];
		154 -> 157;
		154 -> 158;
		154 -> 159;
	155 [label="W Pustce niczego nie ma, dlatego nazywa się Pustką! ",shape=box,color=blue];
		155 -> 160;
		155 -> 161;
	151 [label="Zakładam, że nie jesteś półmózgim fanatykiem, kurczowo trzymającym się gniewu lub strachu. Bazując na tym założeniu, przejdę do drugiego argumentu, dlaczego nie uważam \"Obojętności\" za boga:",shape=box,color=blue];
		151 -> 154;
	156 [label="Kiedy temu zaprzeczyłem? Rzeczywiście, wygląda na to, że wszyscy zdołaliście wpędzić się w histeryczny i niepotrzebnie rażący konflikt.",shape=box,color=blue];
		156 -> 162;
		156 -> 163;
	157 [label="Pustka i to, co można z niej wycisnąć, jest niebezpieczna i potężna - zaufaj mi. Ale ma też swoje ograniczenia. Naprawdę uważasz, że jest zdolna stworzyć coś takiego? Całe języki, palce zdolne zasilić statki skaczące przez Pustkę?",shape=box,color=red];
		157 -> 164;
	158 [label="To... bardzo kuszące uwierzyć, że to po prostu potwór spod łóżka, Roathe. Ale widziałem to, stanąłem twarzą w \"twarz\" z tym czymś i nie wiem, czy może pochodzić z naszych głów.",shape=box,color=red];
		158 -> 165;
	159 [label="Urzeczywistnienie Idei nie jest zdolne zrobić tego, co robi Pan ze Ściany. Entrati mógł go urzeczywistnić - i odpowiada za sprowadzenie go do naszego świata - ale nie wierzę, że jest jego źródłem.",shape=box,color=red];
		159 -> 166;
	160 [label="Nie, widziałem twory, które pochodziły z Pustki. Anioły. Śpiewy. Duchy.",shape=box,color=red];
		160 -> 167;
	161 [label="... ",shape=box,color=red];
		161 -> 167;
	162 [label="Co próbujesz powiedzieć?",shape=box,color=red];
		162 -> 168;
	163 [label="Chwila. Gdzie w tym nasza wina? To Albrecht to wypuścił.",shape=box,color=red];
		163 -> 169;
	164 [label="Ludzkość z pewnością jest twórcza w swej rozpiętości i ogromie nowych form cierpienia, jakie potrafi sobie wykreować, prawda? Sam byłeś świadkiem wielu form okrucieństwa, jakich – jestem pewien – nikt nie mógłby sobie wyobrazić w czasach naszych drogich fanatyków.",shape=box,color=blue];
		164 -> 170;
	165 [label="Ach, jesteś tak blisko prawdy, a jednak tak szybko ją odrzucasz. Myślisz, że \"kuszące\" jest przekonanie, że to wytwór twojego umysłu, bo łatwiej byłoby to odrzucić, gdyby tak było? Nie, myślę, że o wiele bardziej niebezpieczne jest stawienie czoła wytworowi naszego własnego umysłu niż bogu.",shape=box,color=blue];
		165 -> 171;
	166 [label="Choć doceniam twoją pokorę, kwestionuję twoje ograniczone rozumienie potencjału ludzkiej kreatywności – zwłaszcza w odniesieniu do tego, jak może ona tworzyć nowe formy cierpienia. Czyż nie jesteś w stanie sam stworzyć własnego wszechświata z niczego?",shape=box,color=blue];
		166 -> 172;
	167 [label="Jedyne, co pochodzi z Pustki, to to, co do niej posłaliśmy - i to, co z niej powróciło. Może przemienić materię i energię, ale nie stworzyć je z niczego.",shape=box,color=blue];
		167 -> 173;
	168 [label="Próbuję powiedzieć, że to Albrecht mógł być pierwszą osobą, która ujrzała lico swojej własnej pychy, uśmiechające się jako bóg zniszczenia, tak.",shape=box,color=blue];
		168 -> 174;
	169 [label="Albrecht mógł być pierwszą osobą, która ujrzała lico swojej własnej pychy, uśmiechające się jako bóg zniszczenia, tak.",shape=box,color=blue];
		169 -> 174;
	170 [label="+15 Chemistry",color=orange];
		170 -> 175;
	171 [label="Wroga zewnętrznego można zrozumieć. Zmanipulować. Pokonać. A może nawet negocjować, jeśli zajdzie taka potrzeba. Ma słabości, które można wykorzystać. Ale wróg wewnętrzny? Stworzony przez nas samych? To o wiele bardziej podstępne.",shape=box,color=blue];
		171 -> 176;
	172 [label="Sam byłeś świadkiem wielu form okrucieństwa, jakich – jestem pewien – nikt nie mógłby sobie wyobrazić w czasach naszych drogich fanatyków. ",shape=box,color=blue];
		172 -> 177;
	173 [label="Zastanów się, Włóczęgo. Te \"Anioły Pustki\" o których mówisz. Te duchy. Czy powstały one z ludzi, którzy już zatracili się w Pustce?",shape=box,color=blue];
		173 -> 178;
	174 [label="Ale wy wszyscy jesteście równie odpowiedzialni za popychanie tej sprawy, niczym staczająca z góry kupa odchodów żuka juba, która rośnie z każdym bobkiem zebranym po drodze!",shape=box,color=blue];
		174 -> 179;
	175 [label="Nasz gatunek posiada zadziwiającą zdolność karmienia naszych lęków i wymyślania nowych sposobów na samozniszczenie.",shape=box,color=blue];
		175 -> 180;
	176 [label="+20 Chemistry",color=orange];
		176 -> 181;
	177 [label="+10 Chemistry",color=orange];
		177 -> 175;
	178 [label="To były jedynie echa energii, zwracane tak, jak kolorowy kutak karmi swoje pisklęta.",shape=box,color=blue];
		178 -> 179;
	179 [label="Pozwól, że to dla ciebie uproszczę. Mogę obnażyć to fałszywe bóstwo dwoma słowami, które są ci doskonale znane:",shape=box,color=blue];
		179 -> 154;
	180 [label="Mhm. Obawiam się, że muszę już iść. Pozwolę ci w ciszy zastanowić się nad znaczeniem moich słów.",shape=box,color=blue];
		180 -> 182;
		180 -> 183;
	181 [label="Wtedy musimy zmierzyć się z własnymi demonami. A ludzkość... nigdy nie wygrywa takich wojen, czyż nie?",shape=box,color=blue];
		181 -> 180;
	182 [label="Tak zrobię, dzięki.",shape=box,color=red];
		182 -> 184;
	183 [label="Zastanów się nad moimi, może zechcesz w nie uwierzyć, kiedy zmierzysz się z anty-bogiem.",shape=box,color=red];
		183 -> 184;
	184 [label="Update boolean RoatheMITW1",color=orange];
		184 -> 185;
	185 [label="Chat ends.",color=orange];
}