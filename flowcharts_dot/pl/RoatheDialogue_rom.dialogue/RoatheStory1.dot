	j1589438268 [label="VM: NITOKH",shape=box,color=blue];
		j1589438268 -> j1592449463;
	j1592449463 [label="Transkrypcja: Jej szaleństwo było uwodzicielskie, bo było oczywiste.",shape=box,color=blue];
		j1592449463 -> j1632767123;
	j1632767123 [label="To zawsze było jasne, na czym stoisz przy niej — na skraju wielkiej otchłani.",shape=box,color=blue];
		j1632767123 -> j1738982314;
	j1738982314 [label="Wskakuj, mówiły jej oczy, błyszczące radością z powodu jakiegoś kolosalnego, kosmicznego żartu.",shape=box,color=blue];
		j1738982314 -> j1517424732;
	j1517424732 [label="Dzięki jej szalonym wizjom mogłem uciec od długiej, ponurej stagnacji istnienia Orokin.",shape=box,color=blue];
		j1517424732 -> j1102953425;
	j1102953425 [label="Wszystkie nasze zmysły odrętwiały wieki temu. A ona wciąż, na swój sposób, była świeża.",shape=box,color=blue];
		j1102953425 -> j3508273829;
	j3508273829 [label="Wieczna. Nieograniczona w swoim głodzie. Pewnego wieczoru wezwała mnie do swojej kąpieli. Przeszedłem przez mieszające się kałuże wody perfumowanej i krwi, i stanąłem posłusznie na baczność.",shape=box,color=blue];
		j3508273829 -> j2034249668;
	j2034249668 [label="\"Nudzę się, Roathe. Zabijmy wszystkich pozostałych Orokin i przejmijmy władzę.\"",shape=box,color=blue];
		j2034249668 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}