	5408 [label="Chat ends.",color=orange];
	5407 [label="Hej Roathe, masz chwilę? [Zapytaj o zgodę na wielu partnerów]",shape=box,color=red];
		5407 -> 5410;
	5406 [label="[Koniec]",shape=box,color=red];
		5406 -> 5409;
	5405 [label="Chat ends.",color=orange];
	5410 [label="Hm? O co chodzi, kochanie?",shape=box,color=blue];
		5410 -> 5412;
	5409 [label="Update boolean RoatheConsentComplete",color=orange];
		5409 -> 5411;
	5412 [label="Muszę cię o coś zapytać, chcę mieć pewność, że się na to zgadasz.",shape=box,color=red];
		5412 -> 5413;
	5411 [label="Chat ends.",color=orange];
	5413 [label="Zależy mi na tym, żebyś nie czuł się, jakbym cię okłamywał.",shape=box,color=red];
		5413 -> 5414;
	5414 [label="Mów dalej. Zaczyna to brzmieć smakowicie.",shape=box,color=blue];
		5414 -> 5415;
	5415 [label="Nie chcę stawiać cię w sytuacji, w której czujesz się źle. Zrozumiem, jeśli się nie zgodzisz.",shape=box,color=red];
		5415 -> 5416;
	5416 [label="To, co stworzyliśmy, jest dla mnie bardzo ważne, nie chcę, żebyś w to zwątpił.",shape=box,color=red];
		5416 -> 5417;
	5417 [label="Chwila, na Pustkę, czy próbujesz mi powiedzieć, że masz kogoś na boku?",shape=box,color=blue];
		5417 -> 5418;
	5418 [label="Za jakiego durnia mnie masz? Już o tym wiem, mój drogi Włóczęgo!",shape=box,color=blue];
		5418 -> 5419;
		5418 -> 5420;
	5419 [label="Zgaduję, że nie masz nic przeciwko?",shape=box,color=red];
		5419 -> 5421;
	5420 [label="Już... wiesz?",shape=box,color=red];
		5420 -> 5422;
	5421 [label="Gdybyś tylko mógł usłyszeć, jak wyję ze śmiechu. Włóczęgo, mój najukochańszy Włóczęgo. Jestem Orokin. Oczywiście, że mi to nie przeszkadza.",shape=box,color=blue];
		5421 -> 5423;
	5422 [label="Gdybyś tylko mógł usłyszeć, jak wyję ze śmiechu. Włóczęgo, mój najukochańszy Włóczęgo. Jestem Orokin.",shape=box,color=blue];
		5422 -> 5424;
	5423 [label="Myśl, co chcesz o naszym społeczeństwie i skłonności do cieszenia się innymi w sposób, który dla ciebie uchodzi za lekceważący i umniejszający, ale my również wiedzieliśmy, co znaczy kochać.",shape=box,color=blue];
		5423 -> 5425;
	5424 [label="Wiedziałem od razu, kiedy tak się stało. Mam swoje metody. I nie, nie przeszkadza mi to. Przecież jestem Orokin.",shape=box,color=blue];
		5424 -> 5423;
	5425 [label="Nikt nie znał miłości tak, jak Orokin. Wiedzieliśmy, że w sercu znajdzie się miejsce dla więcej niż jednej osoby. ",shape=box,color=blue];
		5425 -> 5426;
	5426 [label="Jestem tylko zawiedziony, że ci fanatycy są zbyt uparci w swoich przekonaniach, by dołączyć do zabawy.",shape=box,color=blue];
		5426 -> 5427;
	5427 [label="Tfu. Może tak jest lepiej. Możesz sobie wyobrazić bałagan, który by z tego wyniknął?",shape=box,color=blue];
		5427 -> 5428;
	5428 [label="Update boolean RoatheConsentComplete",color=orange];
		5428 -> 5429;
	5429 [label="W każdym razie, jeśli ta osoba sprawa ci radość, ciesz się nią. Ale pamiętaj, że kiedy jesteśmy na osobności...",shape=box,color=blue];
		5429 -> 5430;
	5430 [label="+5 Chemistry",color=orange];
		5430 -> 5431;
	5431 [label="Należysz tylko do mnie.",shape=box,color=blue];
		5431 -> 5432;
	5432 [label="Chat ends.",color=orange];
}