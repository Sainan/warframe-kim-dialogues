	j2193924711 [label="Hej Roathe, masz chwilę? [Zapytaj o zgodę na wielu partnerów]",shape=box,color=red];
		j2193924711 -> j1516716934;
	j4181196108 [label="[Koniec]",shape=box,color=red];
		j4181196108 -> j604242687;
	j1516716934 [label="Hm? O co chodzi, kochanie?",shape=box,color=blue];
		j1516716934 -> j1885009871;
	j604242687 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j604242687 -> "Chat ends.";
	j1885009871 [label="Muszę cię o coś zapytać, chcę mieć pewność, że się na to zgadasz.",shape=box,color=red];
		j1885009871 -> j138555786;
	j138555786 [label="Zależy mi na tym, żebyś nie czuł się, jakbym cię okłamywał.",shape=box,color=red];
		j138555786 -> j1425406498;
	j1425406498 [label="Mów dalej. Zaczyna to brzmieć smakowicie.",shape=box,color=blue];
		j1425406498 -> j1419950661;
	j1419950661 [label="Nie chcę stawiać cię w sytuacji, w której czujesz się źle. Zrozumiem, jeśli się nie zgodzisz.",shape=box,color=red];
		j1419950661 -> j3561828764;
	j3561828764 [label="To, co stworzyliśmy, jest dla mnie bardzo ważne, nie chcę, żebyś w to zwątpił.",shape=box,color=red];
		j3561828764 -> j4120891801;
	j4120891801 [label="Chwila, na Pustkę, czy próbujesz mi powiedzieć, że masz kogoś na boku?",shape=box,color=blue];
		j4120891801 -> j3827421307;
	j3827421307 [label="Za jakiego durnia mnie masz? Już o tym wiem, mój drogi Włóczęgo!",shape=box,color=blue];
		j3827421307 -> j1107533920;
		j3827421307 -> j1035731234;
	j1107533920 [label="Zgaduję, że nie masz nic przeciwko?",shape=box,color=red];
		j1107533920 -> j2938226058;
	j1035731234 [label="Już... wiesz?",shape=box,color=red];
		j1035731234 -> j692048904;
	j2938226058 [label="Gdybyś tylko mógł usłyszeć, jak wyję ze śmiechu. Włóczęgo, mój najukochańszy Włóczęgo. Jestem Orokin. Oczywiście, że mi to nie przeszkadza.",shape=box,color=blue];
		j2938226058 -> j1915893411;
	j692048904 [label="Gdybyś tylko mógł usłyszeć, jak wyję ze śmiechu. Włóczęgo, mój najukochańszy Włóczęgo. Jestem Orokin.",shape=box,color=blue];
		j692048904 -> j1483560609;
	j1915893411 [label="Myśl, co chcesz o naszym społeczeństwie i skłonności do cieszenia się innymi w sposób, który dla ciebie uchodzi za lekceważący i umniejszający, ale my również wiedzieliśmy, co znaczy kochać.",shape=box,color=blue];
		j1915893411 -> j2645683270;
	j1483560609 [label="Wiedziałem od razu, kiedy tak się stało. Mam swoje metody. I nie, nie przeszkadza mi to. Przecież jestem Orokin.",shape=box,color=blue];
		j1483560609 -> j1915893411;
	j2645683270 [label="Nikt nie znał miłości tak, jak Orokin. Wiedzieliśmy, że w sercu znajdzie się miejsce dla więcej niż jednej osoby. ",shape=box,color=blue];
		j2645683270 -> j484437104;
	j484437104 [label="Jestem tylko zawiedziony, że ci fanatycy są zbyt uparci w swoich przekonaniach, by dołączyć do zabawy.",shape=box,color=blue];
		j484437104 -> j3711340877;
	j3711340877 [label="Tfu. Może tak jest lepiej. Możesz sobie wyobrazić bałagan, który by z tego wyniknął?",shape=box,color=blue];
		j3711340877 -> j1761214989;
	j1761214989 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j1761214989 -> j875236789;
	j875236789 [label="W każdym razie, jeśli ta osoba sprawa ci radość, ciesz się nią. Ale pamiętaj, że kiedy jesteśmy na osobności...",shape=box,color=blue];
		j875236789 -> j2691277393;
	j2691277393 [label="+5 Chemistry",color=orange];
		j2691277393 -> j642582877;
	j642582877 [label="Należysz tylko do mnie.",shape=box,color=blue];
		j642582877 -> "Chat ends.";
}