digraph {
	"RoatheRank1Convo1 begins." [color=orange];
		"RoatheRank1Convo1 begins." -> j3998890108;
	j3998890108 [label="Evaluate expressions on HellStory counter",color=orange];
		j3998890108 -> j705276421 [label="x >= 21",color=purple];
		j3998890108 -> j3394097688 [label="x >= 6",color=purple];
		j3998890108 -> j2230118264 [label="x < 6",color=purple];
		j3998890108 -> j2230118264 [label="false",color=purple];
	j705276421 [label="Naprawdę muszę pochwalić cię za twoją śmiałość! Naprawdę, jesteś pewien, że nie jesteś Orokin w przebraniu? Może ukrywasz swoją błękitną skórę, żeby nie zwracać na siebie uwagi?!",shape=box,color=blue];
		j705276421 -> j522571538;
		j705276421 -> j956344611;
		j705276421 -> j3154702919;
	j3394097688 [label="Boolean RoatheResetEdgeCase is now true.",color=orange];
		j3394097688 -> j2230118264;
	j2230118264 [label="Anomalia zrodzona z Pustki. \"Włóczęga\". Uzurpator. W końcu rozmawiamy. Chodź. Diabeł ma dla ciebie propozycję...",shape=box,color=blue];
		j2230118264 -> j120729463;
		j2230118264 -> j1952115198;
		j2230118264 -> j3902654789;
		j2230118264 -> j4253840828;
	j522571538 [label="Witaj, Roathe.",shape=box,color=red];
		j522571538 -> j2182953424;
	j956344611 [label="O co mnie oskarżasz?",shape=box,color=red];
		j956344611 -> j1168774852;
	j3154702919 [label="Że co?",shape=box,color=red];
		j3154702919 -> j1168774852;
	j120729463 [label="Uzurpator?",shape=box,color=red];
		j120729463 -> j1104078592;
	j1952115198 [label="O jakiej propozycji mówisz?",shape=box,color=red];
		j1952115198 -> j908773349;
	j3902654789 [label="Jaką propozycję może mieć dla mnie \"Diabeł z Tau\"?",shape=box,color=red];
		j3902654789 -> j3972002758;
	j4253840828 [label="Witaj, Roathe.",shape=box,color=red];
		j4253840828 -> j2462872659;
	j2182953424 [label="Ach, wspaniale! Więc znasz moje imię! Byłem pewien, że przegapiłeś je, kiedy byłeś tak zajęty mordowaniem mnie!",shape=box,color=blue];
		j2182953424 -> j1044661881;
	j1168774852 [label="Naprawdę myślisz że nie mam nic lepszego do roboty?! Że zabawa w \"przypnij róg Yaznakowi\" to najlepszy sposób na wykorzystanie twojego czasu?!",shape=box,color=blue];
		j1168774852 -> j1044661881;
	j1104078592 [label="Boolean RoatheUsurper is now true.",color=orange];
		j1104078592 -> j2258340261;
	j908773349 [label="Hmmm, nie masz powodów do obaw... ani ekscytacji. Jeszcze. To tylko propozycja biznesowa, która może przynieść obu stronom ogromne korzyści.",shape=box,color=blue];
		j908773349 -> j2462872659;
	j3972002758 [label="+5 Chemistry",color=orange];
		j3972002758 -> j652128029;
	j2462872659 [label="Teraz słuchaj uważnie. Ta dwójka fanatyków jest tak okropnie nijaka i mozolna w swoim nękaniu mnie. Mam nadzieję, że wzniesiesz się ponad takie zachowanie.",shape=box,color=blue];
		j2462872659 -> j1325023795;
		j2462872659 -> j1137147866;
	j1044661881 [label="Bardzo trudno mi uwierzyć, że cała ta niesprawiedliwość, której doznałem z twoich rąk, całe to wdzieranie się wewnątrz mojej głowy nie było spowodowane czystą złośliwością!",shape=box,color=blue];
		j1044661881 -> j1260694135;
		j1044661881 -> j1006322857;
		j1044661881 -> j2943687873;
	j2258340261 [label="+5 Chemistry",color=orange];
		j2258340261 -> j3926784099;
	j652128029 [label="Widzę, że moja reputacja mnie wyprzedza. Dobrze. To zaoszczędzi nam trochę czasu.",shape=box,color=blue];
		j652128029 -> j1586806284;
	j1325023795 [label="Nie rozkazuj mi.",shape=box,color=red];
		j1325023795 -> j4026548805;
	j1137147866 [label="Zobaczę, co da się zrobić.",shape=box,color=red];
		j1137147866 -> j3865800978;
	j1260694135 [label="To nie wydawało się ważne?",shape=box,color=red];
		j1260694135 -> j27339539;
	j1006322857 [label="Po prostu... nie miałem okazji zrobić tego wcześniej.",shape=box,color=red];
		j1006322857 -> j4049721433;
	j2943687873 [label="Nie pamiętasz, ale już to przerabialiśmy.",shape=box,color=red];
		j2943687873 -> j1718245674;
	j3926784099 [label="Ach! Tym właśnie jesteś, prawda? Tenno przejęli od Orokin władzę nad Systemem Origin. A ty, niczym kukułka, wkradłeś się do tego świata ze swojego.",shape=box,color=blue];
		j3926784099 -> j245368007;
	j1586806284 [label="Nie masz powodów do obaw... ani ekscytacji. Jeszcze. To tylko propozycja biznesowa, która może przynieść obu stronom ogromne korzyści.",shape=box,color=blue];
		j1586806284 -> j2462872659;
	j4026548805 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4026548805 -> j1104479053 [label="x >= 21",color=purple];
		j4026548805 -> j636399928 [label="x >= 1",color=purple];
		j4026548805 -> j3530010275 [label="x <= 0",color=purple];
		j4026548805 -> j3530010275 [label="false",color=purple];
	j3865800978 [label="Postaraj się.",shape=box,color=blue];
		j3865800978 -> j1797322308;
	j27339539 [label="Nie wydawało się -",shape=box,color=blue];
		j27339539 -> j3961988461;
	j4049721433 [label="Och, tak mi przykro, że sprawiłem ci taki kłopot. Nie zdawałem sobie sprawy, że tak zajęty!",shape=box,color=blue];
		j4049721433 -> j2935960771;
	j1718245674 [label="+5 Chemistry",color=orange];
		j1718245674 -> j3768595902;
	j245368007 [label="A to czyni cię Uzurpatorem, z co najmniej dwóch powodów. (A może i z trzech, jeśli weźmiemy pod uwagę to, co sługa powiedział mi o Duviri, ale to temat na inny dzień.)",shape=box,color=blue];
		j245368007 -> j2462872659;
	j1104479053 [label="Wyraziłeś to jasno i dobitnie, nie musisz tego powtarzać.",shape=box,color=blue];
		j1104479053 -> j1797322308;
	j636399928 [label="Wyraziłeś to całkiem jasno.",shape=box,color=blue];
		j636399928 -> j1797322308;
	j3530010275 [label="Zobaczymy.",shape=box,color=blue];
		j3530010275 -> j1797322308;
	j1797322308 [label="Sprawa jest prosta, mój uroczo lubieżny i zmysłowy nowy \"przyjacielu\".",shape=box,color=blue];
		j1797322308 -> j1071362491;
	j3961988461 [label="Nie wydawało się ważne?!",shape=box,color=blue];
		j3961988461 -> j2654839574;
	j2935960771 [label="Jestem naprawdę zdumiony. Twoje maniery są okropne, Włóczęgo.",shape=box,color=blue];
		j2935960771 -> j2795494647;
	j3768595902 [label="Że co? I jak to się stało, że zapomniałem jak grzebałeś mi w głowie, niczym w misce przekąsek podczas przyjęcia Naberusa!",shape=box,color=blue];
		j3768595902 -> j764199768;
		j3768595902 -> j1516665669;
	j1071362491 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1071362491 -> j1080996213 [label="x >= 21",color=purple];
		j1071362491 -> j668839745 [label="x >= 1",color=purple];
		j1071362491 -> j3946249897 [label="x <= 0",color=purple];
		j1071362491 -> j3946249897 [label="false",color=purple];
	j2654839574 [label="Często wpełzasz między wspomnienia innych ludzi i obracasz je w ruinę nie poznając ich wcześniej?!",shape=box,color=blue];
		j2654839574 -> j1093379325;
	j2795494647 [label="Ale na to chyba już nic nie poradzimy. Poznałeś prawdę. Nie ukrywam przed tobą tajemnicy mojego odrażającego tchórzostwa.",shape=box,color=blue];
		j2795494647 -> j106922520;
	j764199768 [label="W dużym skrócie... istnieje Plaga, która jest związana z serum Protoframe'ów...",shape=box,color=red];
		j764199768 -> j592095617;
	j1516665669 [label="Ach, więc tak... Potrafię podróżować w czasie.",shape=box,color=red];
		j1516665669 -> j592095617;
	j1080996213 [label="Skoro jesteś już przyzwyczajony do walania się po mojej głowie niczym pijany razaliorn w warsztacie szklarskim, wymagam twojej pomocy w rozszyfrowaniu, co to wszystko znaczy.",shape=box,color=blue];
		j1080996213 -> j1500718865;
	j668839745 [label="Ty i ta dwójka fanatyków już zaczęliście walać mi się po głowie niczym pijany razaliorn w warsztacie szklarskim. Potrzebuję twojej pomocy w rozszyfrowaniu, co to wszystko znaczy.",shape=box,color=blue];
		j668839745 -> j1500718865;
	j3946249897 [label="Kiedy Albrecht wbił mi strzykawkę w szyję i uczynił mnie tym czymś, poczynił coś jeszcze. Gierki między Orokin to jedna sprawa. Ale to? To coś zupełnie innego.",shape=box,color=blue];
		j3946249897 -> j2831616729;
	j1093379325 [label="Twoje maniery są naganne!",shape=box,color=blue];
		j1093379325 -> j2795494647;
	j106922520 [label="Zakładam, że przyszedłeś tu tylko po to, żeby ze mnie drwić. Proszę, żebyś się tym teraz nacieszył, żebyśmy mogli przejść do dalszej części dyskusji.",shape=box,color=blue];
		j106922520 -> j3783003301;
	j592095617 [label="Myślałem, że działa to na Protoframe'y w 1999 roku, bo ten sam rok się zapętlał, ale to nie to. ",shape=box,color=red];
		j592095617 -> j3014321397;
	j1500718865 [label="Nie dość, że potrzebuję twojej pomocy w odzyskaniu wspomnień, ale co gorsza, wydaje mi się, że sam nie potrafię znaleźć sposobu, aby odkryć ich prawdę!",shape=box,color=blue];
		j1500718865 -> j4051436110;
		j1500718865 -> j3308967504;
	j2831616729 [label="Okradł mnie z wielu wspomnień. Widzę tę małą... wersję ciebie, biegającą z resztą straumatyzowanych Tenno. Widzę, co Lotus pomaga temu czemuś odzyskać.",shape=box,color=blue];
		j2831616729 -> j3557648178;
		j2831616729 -> j3975246167;
	j3783003301 [label="Wolałbym, żeby ta kwestia nie kręciła się wokół nas niczym ujadający, ozdobny kubrow jakiejś divy.",shape=box,color=blue];
		j3783003301 -> j342657590;
		j3783003301 -> j1384155519;
	j3014321397 [label="Myślę, że chodzi o samą Plagę? Gadająca gitara to zasugerowała. A ty dostałeś się tu przez Helmintha, prawda?",shape=box,color=red];
		j3014321397 -> j4014770434;
	j4051436110 [label="Mówisz... że po prostu musisz z kimś pogadać?",shape=box,color=red];
		j4051436110 -> j1357956173;
	j3308967504 [label="Z chęcią bym ci pomógł, ale po prostu nie wiem jak.",shape=box,color=red];
		j3308967504 -> j1285231071;
	j3557648178 [label="Dlaczego więc sam nie udasz się do ciemnego refraktorium?",shape=box,color=red];
		j3557648178 -> j2447026168;
	j3975246167 [label="Dzieciak to nie jest \"rzecz\".",shape=box,color=red];
		j3975246167 -> j4213078502;
	j342657590 [label="Uciekłeś, ale postąpiło tak wielu ludzi. Najważniejsze to stawić czoła temu, co się stało.",shape=box,color=red];
		j342657590 -> j1857564982;
	j1384155519 [label="Nie będę się z ciebie nabijać. Zdecydowałeś, że zawalczysz innego dnia.",shape=box,color=red];
		j1384155519 -> j1809691576;
	j4014770434 [label="Wydajesz się być niepokojąco niepewny całej tej rozmowy, Włóczęgo. Zwłaszcza jeśli chodzi o zawartość mojej czaszki.",shape=box,color=blue];
		j4014770434 -> j1364200344;
	j1357956173 [label="Och, nie przedstawiaj tego tak, jakbym potrzebował położyć się na sofie i omówić moje \"uczucia\".",shape=box,color=blue];
		j1357956173 -> j1285231071;
	j1285231071 [label="Potrzebuję kogoś, kto będzie obsługiwał maszynę na moje polecenie, ponieważ obecnie nie jestem w stanie robić tego sam. ",shape=box,color=blue];
		j1285231071 -> j3851756050;
	j2447026168 [label="Sam bym to zrobił, uwierz mi - ale nie mogę! Przeklęte serum protoframe'a, którym Albrecht mnie zatruł, pozbawiło mnie wszelkiej zdolności do samodzielnego operowania tym przeklętym ustrojstwem!",shape=box,color=blue];
		j2447026168 -> j1500718865;
	j4213078502 [label="Zapewniam cię, że jest.",shape=box,color=blue];
		j4213078502 -> j2447026168;
	j1857564982 [label="Add 1 to Thermostat counter",color=orange];
		j1857564982 -> j1455889565;
	j1809691576 [label="Add -1 to Thermostat counter",color=orange];
		j1809691576 -> j1087372926;
	j1364200344 [label="I tak. Przybyłem tu za pośrednictwem Helmintha. Którego stworzyłem ja sam. A teraz - chcesz mi powiedzieć, że... wymazałeś mi pamięć?! O czym? O naszych wspólnych rozmowach?! ",shape=box,color=blue];
		j1364200344 -> j2430754002;
	j3851756050 [label="Potrzebuję też kogoś, kto pomoże mi zapisywać wspomnienia, gdy tylko powrócą, i pomoże je pogodzić. Swego rodzaju asystenta.",shape=box,color=blue];
		j3851756050 -> j1157248623;
	j1455889565 [label="Fantastycznie. Kolejna mucha bzyczy my koło ucha i powtarza, że potrzebna mi refleksja nad sobą i pokuta?",shape=box,color=blue];
		j1455889565 -> j3134464239;
	j1087372926 [label="+5 Chemistry",color=orange];
		j1087372926 -> j1740838538;
	j2430754002 [label="Ja mam bardzo \"miłe\" wspomnienia tego, jak przerobiłeś mnie na mielonkę dla własnej rozrywki. W jakim świecie ma to sens?",shape=box,color=blue];
		j2430754002 -> j26145741;
		j2430754002 -> j34036834;
	j1157248623 [label="A w zamian – uroczyście przyrzeknę, że będę tu siedział… spokojnie. Nie będę nikomu wadził, a zapewniam cię… że jestem do tego zdolny. Nie zrobię krzywdy fanatykom. Ani słudze. Ani zwierzętom Albrechta.",shape=box,color=blue];
		j1157248623 -> j1316814639;
	j3134464239 [label="Szczęściarz ze mnie.",shape=box,color=blue];
		j3134464239 -> j1001693719;
	j1740838538 [label="Moja obecna sytuacja wygląda bardziej na \"gnicie w krypcie, w towarzystwie dwójki tępych fanatyków i rozdawanie świecidełek straumatyzowanym dzieciom\".",shape=box,color=blue];
		j1740838538 -> j2342334516;
	j26145741 [label="Nie wiem, nie jestem tu po to, żeby być twoim workiem treningowym, Roathe. Nie podróżuję w czasie tylko po to, żeby zbierać za to baty.",shape=box,color=red];
		j26145741 -> j1524042035;
	j34036834 [label="Z tego co się orientuję... nasze rozmowy nie są głęboko zakorzenione. To powierzchowne wspomnienia. To, co odkryliśmy o twojej przeszłości... to były głębsze wspomnienia? Coś takiego?",shape=box,color=red];
		j34036834 -> j2929685020;
	j1316814639 [label="A co ważniejsze, nie zrobię nic złego wypaczonej rodzinie Albrechta, która niczym zmutowana flora wegetuje ponad nami - nieświadoma naszego istnienia.",shape=box,color=blue];
		j1316814639 -> j4262511768;
		j1316814639 -> j3594494590;
		j1316814639 -> j4162594571;
	j1001693719 [label="Mam zamiar zająć się swoimi sprawami, Włóczęgo, ale fakt pozostaje niezmieniony - wiesz za wiele o mojej przeszłości i o tym, co zrobiłem. Będziemy musieli... po prostu się z tym pogodzić.",shape=box,color=blue];
		j1001693719 -> j1308973311;
	j2342334516 [label="Ale chyba tak to nazywają w tych czasach.",shape=box,color=blue];
		j2342334516 -> j1001693719;
	j1524042035 [label="Tak. Mogę zaryzykować przypuszczenie, dlaczego przywołałeś swoje dary Pustki, aby wymazać z naszych umysłów ostatnie wydarzenia. Jakże to przewidywalne.",shape=box,color=blue];
		j1524042035 -> j3203673932;
	j2929685020 [label="Fantastyczne. Absolutnie cudowne. Jestem teraz w rękach szaleńca, który potrafi w każdej chwili odebrać mi wspomnienia! Jakie to urocze.",shape=box,color=blue];
		j2929685020 -> j3203673932;
	j4262511768 [label="Myślałem, że mieliśmy umowę. Teraz mi się odgrażasz?",shape=box,color=red];
		j4262511768 -> j2951638964;
	j3594494590 [label="Roathe? Czy możesz mnie przez chwilę posłuchać?",shape=box,color=red];
		j3594494590 -> j2866036064;
	j4162594571 [label="Czego ode mnie chcesz?",shape=box,color=red];
		j4162594571 -> j2753383837;
	j1308973311 [label="Spróbuj nie uczynić tej sytuacji zbyt nieprzyjemnej dla mnie, a obiecuję, że odwdzięczę się tym samym.",shape=box,color=blue];
		j1308973311 -> j1321239305;
		j1308973311 -> j579553892;
	j3203673932 [label="Cóż. Jeśli to, co mówisz, jest prawdą – a przypuszczam, że ta opowieść jest na tyle szalona, że może być prawdziwa – postaram się nie mieć ci za złe, że znasz tę głęboką i straszną prawdę o mnie.",shape=box,color=blue];
		j3203673932 -> j390083163;
	j2951638964 [label="Przespałeś naszą rozmowę? Na litość, czytanie ze zrozumieniem w tych czasach... Nie odgrażam się, Uzurpatorze. Ani tobie, ani nikomu innemu.",shape=box,color=blue];
		j2951638964 -> j2958090895;
	j2866036064 [label="To będzie dobre. Proszę, nie przeszkadzaj sobie. Odstaw swoją szopkę.",shape=box,color=blue];
		j2866036064 -> j1149534363;
		j2866036064 -> j3107733640;
		j2866036064 -> j3188032268;
	j2753383837 [label="Przespałeś naszą rozmowę? Na litość, czytanie ze zrozumieniem w tych czasach... Próbuję się z tobą dogadać, Uzurpatorze. Mam wrażenie, że nie nadążasz.",shape=box,color=blue];
		j2753383837 -> j2112903859;
	j1321239305 [label="Nie.",shape=box,color=red];
		j1321239305 -> j3491074536;
	j579553892 [label="Brzmi sprawiedliwie.",shape=box,color=red];
		j579553892 -> j2311703463;
	j390083163 [label="Chociaż chciałbym prosić - jeśli łaska - byś nasycił się do woli wszelkim szyderstwem, jakie masz zamiar kierować w moją stronę, tak abyśmy mogli przejść do konkretów bez dalszych przeszkód.",shape=box,color=blue];
		j390083163 -> j3783003301;
	j2958090895 [label="Chciałem tylko powiedzieć, że jeśli dojdziemy do punktu, w którym nie będę w stanie osiągnąć swoich celów, nie będę już miał powodu, aby siedzieć cicho.",shape=box,color=blue];
		j2958090895 -> j2112903859;
	j1149534363 [label="To przeze mnie Ballas nie żyje. Nie dawaj mi dodatkowych zajęć.",shape=box,color=red];
		j1149534363 -> j4231420794;
	j3107733640 [label="Jeśli chcesz mojej pomocy, to nie jest zbyt dobry sposób, by ją otrzymać",shape=box,color=red];
		j3107733640 -> j1831857381;
	j3188032268 [label="Wiem, że nie mamy ze sobą bogatej przeszłości, ale chcę ci pomóc.",shape=box,color=red];
		j3188032268 -> j220589062;
	j2112903859 [label="Jeśli moja propozycja nie spełnia twoich oczekiwań, mogę ją dla ciebie osłodzić.",shape=box,color=blue];
		j2112903859 -> j542571409;
	j3491074536 [label="+5 Chemistry",color=orange];
		j3491074536 -> j2334337804;
	j2311703463 [label="+15 Chemistry",color=orange];
		j2311703463 -> j3567182684;
	j4231420794 [label="+5 Chemistry",color=orange];
		j4231420794 -> j2590352711;
	j1831857381 [label="A jeśli ty oczekujesz mojej - jak już mówiłem - powinniśmy dojść do porozumienia.",shape=box,color=blue];
		j1831857381 -> j2112903859;
	j220589062 [label="I? Ach, rozumiem. Nie podoba ci się mój \"ton\", prawda? Tak mi przykro. Nie wiedziałem, że masz tak cienką skórę.",shape=box,color=blue];
		j220589062 -> j2112903859;
