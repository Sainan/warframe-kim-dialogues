digraph {
	0 [label="RoatheRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Evaluate expressions on HellStory",color=orange];
		1 -> 3 [label="x >= 21",color=purple];
		1 -> 2349 [label="x >= 6",color=purple];
		1 -> 2 [label="x < 6",color=purple];
		1 -> 2 [label="false",color=purple];
	3 [label="Naprawdę muszę pochwalić cię za twoją śmiałość! Naprawdę, jesteś pewien, że nie jesteś Orokin w przebraniu? Może ukrywasz swoją błękitną skórę, żeby nie zwracać na siebie uwagi?!",shape=box,color=blue];
		3 -> 8;
		3 -> 9;
		3 -> 10;
	2349 [label="Update boolean RoatheResetEdgeCase",color=orange];
		2349 -> 2;
	2 [label="Anomalia zrodzona z Pustki. \"Włóczęga\". Uzurpator. W końcu rozmawiamy. Chodź. Diabeł ma dla ciebie propozycję...",shape=box,color=blue];
		2 -> 4;
		2 -> 5;
		2 -> 6;
		2 -> 7;
	8 [label="Witaj, Roathe.",shape=box,color=red];
		8 -> 15;
	9 [label="O co mnie oskarżasz?",shape=box,color=red];
		9 -> 16;
	10 [label="Że co?",shape=box,color=red];
		10 -> 16;
	4 [label="Uzurpator?",shape=box,color=red];
		4 -> 11;
	5 [label="O jakiej propozycji mówisz?",shape=box,color=red];
		5 -> 12;
	6 [label="Jaką propozycję może mieć dla mnie \"Diabeł z Tau\"?",shape=box,color=red];
		6 -> 13;
	7 [label="Witaj, Roathe.",shape=box,color=red];
		7 -> 14;
	15 [label="Ach, wspaniale! Więc znasz moje imię! Byłem pewien, że przegapiłeś je, kiedy byłeś tak zajęty mordowaniem mnie!",shape=box,color=blue];
		15 -> 21;
	16 [label="Naprawdę myślisz że nie mam nic lepszego do roboty?! Że zabawa w \"przypnij róg Yaznakowi\" to najlepszy sposób na wykorzystanie twojego czasu?!",shape=box,color=blue];
		16 -> 21;
	11 [label="Update boolean RoatheUsurper",color=orange];
		11 -> 17;
	12 [label="Hmmm, nie masz powodów do obaw... ani ekscytacji. Jeszcze. To tylko propozycja biznesowa, która może przynieść obu stronom ogromne korzyści.",shape=box,color=blue];
		12 -> 14;
	13 [label="+5 Chemistry",color=orange];
		13 -> 18;
	14 [label="Teraz słuchaj uważnie. Ta dwójka fanatyków jest tak okropnie nijaka i mozolna w swoim nękaniu mnie. Mam nadzieję, że wzniesiesz się ponad takie zachowanie.",shape=box,color=blue];
		14 -> 19;
		14 -> 20;
	21 [label="Bardzo trudno mi uwierzyć, że cała ta niesprawiedliwość, której doznałem z twoich rąk, całe to wdzieranie się wewnątrz mojej głowy nie było spowodowane czystą złośliwością!",shape=box,color=blue];
		21 -> 26;
		21 -> 27;
		21 -> 28;
	17 [label="+5 Chemistry",color=orange];
		17 -> 22;
	18 [label="Widzę, że moja reputacja mnie wyprzedza. Dobrze. To zaoszczędzi nam trochę czasu.",shape=box,color=blue];
		18 -> 23;
	19 [label="Nie rozkazuj mi.",shape=box,color=red];
		19 -> 24;
	20 [label="Zobaczę, co da się zrobić.",shape=box,color=red];
		20 -> 25;
	26 [label="To nie wydawało się ważne?",shape=box,color=red];
		26 -> 34;
	27 [label="Po prostu... nie miałem okazji zrobić tego wcześniej.",shape=box,color=red];
		27 -> 35;
	28 [label="Nie pamiętasz, ale już to przerabialiśmy.",shape=box,color=red];
		28 -> 36;
	22 [label="Ach! Tym właśnie jesteś, prawda? Tenno przejęli od Orokin władzę nad Systemem Origin. A ty, niczym kukułka, wkradłeś się do tego świata ze swojego.",shape=box,color=blue];
		22 -> 29;
	23 [label="Nie masz powodów do obaw... ani ekscytacji. Jeszcze. To tylko propozycja biznesowa, która może przynieść obu stronom ogromne korzyści.",shape=box,color=blue];
		23 -> 14;
	24 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		24 -> 30 [label="x >= 21",color=purple];
		24 -> 31 [label="x >= 1",color=purple];
		24 -> 32 [label="x <= 0",color=purple];
		24 -> 32 [label="false",color=purple];
	25 [label="Postaraj się.",shape=box,color=blue];
		25 -> 33;
	34 [label="Nie wydawało się -",shape=box,color=blue];
		34 -> 38;
	35 [label="Och, tak mi przykro, że sprawiłem ci taki kłopot. Nie zdawałem sobie sprawy, że tak zajęty!",shape=box,color=blue];
		35 -> 39;
	36 [label="+5 Chemistry",color=orange];
		36 -> 40;
	29 [label="A to czyni cię Uzurpatorem, z co najmniej dwóch powodów. (A może i z trzech, jeśli weźmiemy pod uwagę to, co sługa powiedział mi o Duviri, ale to temat na inny dzień.)",shape=box,color=blue];
		29 -> 14;
	30 [label="Wyraziłeś to jasno i dobitnie, nie musisz tego powtarzać.",shape=box,color=blue];
		30 -> 33;
	31 [label="Wyraziłeś to całkiem jasno.",shape=box,color=blue];
		31 -> 33;
	32 [label="Zobaczymy.",shape=box,color=blue];
		32 -> 33;
	33 [label="Sprawa jest prosta, mój uroczo lubieżny i zmysłowy nowy \"przyjacielu\".",shape=box,color=blue];
		33 -> 37;
	38 [label="Nie wydawało się ważne?!",shape=box,color=blue];
		38 -> 44;
	39 [label="Jestem naprawdę zdumiony. Twoje maniery są okropne, Włóczęgo.",shape=box,color=blue];
		39 -> 45;
	40 [label="Że co? I jak to się stało, że zapomniałem jak grzebałeś mi w głowie, niczym w misce przekąsek podczas przyjęcia Naberusa!",shape=box,color=blue];
		40 -> 46;
		40 -> 47;
	37 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		37 -> 41 [label="x >= 21",color=purple];
		37 -> 42 [label="x >= 1",color=purple];
		37 -> 43 [label="x <= 0",color=purple];
		37 -> 43 [label="false",color=purple];
	44 [label="Często wpełzasz między wspomnienia innych ludzi i obracasz je w ruinę nie poznając ich wcześniej?!",shape=box,color=blue];
		44 -> 50;
	45 [label="Ale na to chyba już nic nie poradzimy. Poznałeś prawdę. Nie ukrywam przed tobą tajemnicy mojego odrażającego tchórzostwa.",shape=box,color=blue];
		45 -> 51;
	46 [label="W dużym skrócie... istnieje Plaga, która jest związana z serum Protoframe'ów...",shape=box,color=red];
		46 -> 52;
	47 [label="Ach, więc tak... Potrafię podróżować w czasie.",shape=box,color=red];
		47 -> 52;
	41 [label="Skoro jesteś już przyzwyczajony do walania się po mojej głowie niczym pijany razaliorn w warsztacie szklarskim, wymagam twojej pomocy w rozszyfrowaniu, co to wszystko znaczy.",shape=box,color=blue];
		41 -> 48;
	42 [label="Ty i ta dwójka fanatyków już zaczęliście walać mi się po głowie niczym pijany razaliorn w warsztacie szklarskim. Potrzebuję twojej pomocy w rozszyfrowaniu, co to wszystko znaczy.",shape=box,color=blue];
		42 -> 48;
	43 [label="Kiedy Albrecht wbił mi strzykawkę w szyję i uczynił mnie tym czymś, poczynił coś jeszcze. Gierki między Orokin to jedna sprawa. Ale to? To coś zupełnie innego.",shape=box,color=blue];
		43 -> 49;
	50 [label="Twoje maniery są naganne!",shape=box,color=blue];
		50 -> 45;
	51 [label="Zakładam, że przyszedłeś tu tylko po to, żeby ze mnie drwić. Proszę, żebyś się tym teraz nacieszył, żebyśmy mogli przejść do dalszej części dyskusji.",shape=box,color=blue];
		51 -> 57;
	52 [label="Myślałem, że działa to na Protoframe'y w 1999 roku, bo ten sam rok się zapętlał, ale to nie to. ",shape=box,color=red];
		52 -> 58;
	48 [label="Nie dość, że potrzebuję twojej pomocy w odzyskaniu wspomnień, ale co gorsza, wydaje mi się, że sam nie potrafię znaleźć sposobu, aby odkryć ich prawdę!",shape=box,color=blue];
		48 -> 53;
		48 -> 54;
	49 [label="Okradł mnie z wielu wspomnień. Widzę tę małą... wersję ciebie, biegającą z resztą straumatyzowanych Tenno. Widzę, co Lotus pomaga temu czemuś odzyskać.",shape=box,color=blue];
		49 -> 55;
		49 -> 56;
	57 [label="Wolałbym, żeby ta kwestia nie kręciła się wokół nas niczym ujadający, ozdobny kubrow jakiejś divy.",shape=box,color=blue];
		57 -> 63;
		57 -> 64;
	58 [label="Myślę, że chodzi o samą Plagę? Gadająca gitara to zasugerowała. A ty dostałeś się tu przez Helmintha, prawda?",shape=box,color=red];
		58 -> 65;
	53 [label="Mówisz... że po prostu musisz z kimś pogadać?",shape=box,color=red];
		53 -> 59;
	54 [label="Z chęcią bym ci pomógł, ale po prostu nie wiem jak.",shape=box,color=red];
		54 -> 60;
	55 [label="Dlaczego więc sam nie udasz się do ciemnego refraktorium?",shape=box,color=red];
		55 -> 61;
	56 [label="Dzieciak to nie jest \"rzecz\".",shape=box,color=red];
		56 -> 62;
	63 [label="Uciekłeś, ale postąpiło tak wielu ludzi. Najważniejsze to stawić czoła temu, co się stało.",shape=box,color=red];
		63 -> 69;
	64 [label="Nie będę się z ciebie nabijać. Zdecydowałeś, że zawalczysz innego dnia.",shape=box,color=red];
		64 -> 70;
	65 [label="Wydajesz się być niepokojąco niepewny całej tej rozmowy, Włóczęgo. Zwłaszcza jeśli chodzi o zawartość mojej czaszki.",shape=box,color=blue];
		65 -> 71;
	59 [label="Och, nie przedstawiaj tego tak, jakbym potrzebował położyć się na sofie i omówić moje \"uczucia\".",shape=box,color=blue];
		59 -> 60;
	60 [label="Potrzebuję kogoś, kto będzie obsługiwał maszynę na moje polecenie, ponieważ obecnie nie jestem w stanie robić tego sam. ",shape=box,color=blue];
		60 -> 66;
	61 [label="Sam bym to zrobił, uwierz mi - ale nie mogę! Przeklęte serum protoframe'a, którym Albrecht mnie zatruł, pozbawiło mnie wszelkiej zdolności do samodzielnego operowania tym przeklętym ustrojstwem!",shape=box,color=blue];
		61 -> 67;
	62 [label="Zapewniam cię, że jest.",shape=box,color=blue];
		62 -> 68;
	69 [label="Add 1 to Thermostat",color=orange];
		69 -> 73;
	70 [label="Add -1 to Thermostat",color=orange];
		70 -> 74;
	71 [label="I tak. Przybyłem tu za pośrednictwem Helmintha. Którego stworzyłem ja sam. A teraz - chcesz mi powiedzieć, że... wymazałeś mi pamięć?! O czym? O naszych wspólnych rozmowach?! ",shape=box,color=blue];
		71 -> 75;
	66 [label="Potrzebuję też kogoś, kto pomoże mi zapisywać wspomnienia, gdy tylko powrócą, i pomoże je pogodzić. Swego rodzaju asystenta.",shape=box,color=blue];
		66 -> 72;
	67 [label="Nie dość, że potrzebuję twojej pomocy w odzyskaniu wspomnień, ale co gorsza, wydaje mi się, że sam nie potrafię znaleźć sposobu, aby odkryć ich prawdę!",shape=box,color=blue];
		67 -> 53;
		67 -> 54;
	68 [label="Sam bym to zrobił, uwierz mi - ale nie mogę! Przeklęte serum protoframe'a, którym Albrecht mnie zatruł, pozbawiło mnie wszelkiej zdolności do samodzielnego operowania tym przeklętym ustrojstwem!",shape=box,color=blue];
		68 -> 67;
	73 [label="Fantastycznie. Kolejna mucha bzyczy my koło ucha i powtarza, że potrzebna mi refleksja nad sobą i pokuta?",shape=box,color=blue];
		73 -> 77;
	74 [label="+5 Chemistry",color=orange];
		74 -> 78;
	75 [label="Ja mam bardzo \"miłe\" wspomnienia tego, jak przerobiłeś mnie na mielonkę dla własnej rozrywki. W jakim świecie ma to sens?",shape=box,color=blue];
		75 -> 79;
		75 -> 80;
	72 [label="A w zamian – uroczyście przyrzeknę, że będę tu siedział… spokojnie. Nie będę nikomu wadził, a zapewniam cię… że jestem do tego zdolny. Nie zrobię krzywdy fanatykom. Ani słudze. Ani zwierzętom Albrechta.",shape=box,color=blue];
		72 -> 76;
	77 [label="Szczęściarz ze mnie.",shape=box,color=blue];
		77 -> 84;
	78 [label="Moja obecna sytuacja wygląda bardziej na \"gnicie w krypcie, w towarzystwie dwójki tępych fanatyków i rozdawanie świecidełek straumatyzowanym dzieciom\".",shape=box,color=blue];
		78 -> 85;
	79 [label="Nie wiem, nie jestem tu po to, żeby być twoim workiem treningowym, Roathe. Nie podróżuję w czasie tylko po to, żeby zbierać za to baty.",shape=box,color=red];
		79 -> 5634;
	80 [label="Z tego co się orientuję... nasze rozmowy nie są głęboko zakorzenione. To powierzchowne wspomnienia. To, co odkryliśmy o twojej przeszłości... to były głębsze wspomnienia? Coś takiego?",shape=box,color=red];
		80 -> 86;
	76 [label="A co ważniejsze, nie zrobię nic złego wypaczonej rodzinie Albrechta, która niczym zmutowana flora wegetuje ponad nami - nieświadoma naszego istnienia.",shape=box,color=blue];
		76 -> 81;
		76 -> 82;
		76 -> 83;
	84 [label="Mam zamiar zająć się swoimi sprawami, Włóczęgo, ale fakt pozostaje niezmieniony - wiesz za wiele o mojej przeszłości i o tym, co zrobiłem. Będziemy musieli... po prostu się z tym pogodzić.",shape=box,color=blue];
		84 -> 90;
	85 [label="Ale chyba tak to nazywają w tych czasach.",shape=box,color=blue];
		85 -> 84;
	5634 [label="Tak. Mogę zaryzykować przypuszczenie, dlaczego przywołałeś swoje dary Pustki, aby wymazać z naszych umysłów ostatnie wydarzenia. Jakże to przewidywalne.",shape=box,color=blue];
		5634 -> 91;
	86 [label="Fantastyczne. Absolutnie cudowne. Jestem teraz w rękach szaleńca, który potrafi w każdej chwili odebrać mi wspomnienia! Jakie to urocze.",shape=box,color=blue];
		86 -> 91;
	81 [label="Myślałem, że mieliśmy umowę. Teraz mi się odgrażasz?",shape=box,color=red];
		81 -> 87;
	82 [label="Roathe? Czy możesz mnie przez chwilę posłuchać?",shape=box,color=red];
		82 -> 88;
	83 [label="Czego ode mnie chcesz?",shape=box,color=red];
		83 -> 89;
	90 [label="Spróbuj nie uczynić tej sytuacji zbyt nieprzyjemnej dla mnie, a obiecuję, że odwdzięczę się tym samym.",shape=box,color=blue];
		90 -> 97;
		90 -> 98;
	91 [label="Cóż. Jeśli to, co mówisz, jest prawdą – a przypuszczam, że ta opowieść jest na tyle szalona, że może być prawdziwa – postaram się nie mieć ci za złe, że znasz tę głęboką i straszną prawdę o mnie.",shape=box,color=blue];
		91 -> 99;
	87 [label="Przespałeś naszą rozmowę? Na litość, czytanie ze zrozumieniem w tych czasach... Nie odgrażam się, Uzurpatorze. Ani tobie, ani nikomu innemu.",shape=box,color=blue];
		87 -> 92;
	88 [label="To będzie dobre. Proszę, nie przeszkadzaj sobie. Odstaw swoją szopkę.",shape=box,color=blue];
		88 -> 93;
		88 -> 94;
		88 -> 95;
	89 [label="Przespałeś naszą rozmowę? Na litość, czytanie ze zrozumieniem w tych czasach... Próbuję się z tobą dogadać, Uzurpatorze. Mam wrażenie, że nie nadążasz.",shape=box,color=blue];
		89 -> 96;
	97 [label="Nie.",shape=box,color=red];
		97 -> 104;
	98 [label="Brzmi sprawiedliwie.",shape=box,color=red];
		98 -> 105;
	99 [label="Chociaż chciałbym prosić - jeśli łaska - byś nasycił się do woli wszelkim szyderstwem, jakie masz zamiar kierować w moją stronę, tak abyśmy mogli przejść do konkretów bez dalszych przeszkód.",shape=box,color=blue];
		99 -> 57;
	92 [label="Chciałem tylko powiedzieć, że jeśli dojdziemy do punktu, w którym nie będę w stanie osiągnąć swoich celów, nie będę już miał powodu, aby siedzieć cicho.",shape=box,color=blue];
		92 -> 96;
	93 [label="To przeze mnie Ballas nie żyje. Nie dawaj mi dodatkowych zajęć.",shape=box,color=red];
		93 -> 100;
	94 [label="Jeśli chcesz mojej pomocy, to nie jest zbyt dobry sposób, by ją otrzymać",shape=box,color=red];
		94 -> 101;
	95 [label="Wiem, że nie mamy ze sobą bogatej przeszłości, ale chcę ci pomóc.",shape=box,color=red];
		95 -> 102;
	96 [label="Jeśli moja propozycja nie spełnia twoich oczekiwań, mogę ją dla ciebie osłodzić.",shape=box,color=blue];
		96 -> 103;
	104 [label="+5 Chemistry",color=orange];
		104 -> 108;
	105 [label="+15 Chemistry",color=orange];
		105 -> 109;
	100 [label="+5 Chemistry",color=orange];
		100 -> 106;
	101 [label="A jeśli ty oczekujesz mojej - jak już mówiłem - powinniśmy dojść do porozumienia.",shape=box,color=blue];
		101 -> 96;
	102 [label="I? Ach, rozumiem. Nie podoba ci się mój \"ton\", prawda? Tak mi przykro. Nie wiedziałem, że masz tak cienką skórę.",shape=box,color=blue];
		102 -> 96;
	103 [label="Doszły mnie słuchy, że jest wiele spraw związanych z Deimosem, w których moja pomoc mogłaby okazać się nie tylko konieczna, ale śmiem stwierdzić, że wręcz kluczowa.",shape=box,color=blue];
		103 -> 107;
	108 [label="Ha! Muszę docenić twoją szczerość, jeśli tylko tyle.",shape=box,color=blue];
		108 -> 112;
	109 [label="Doskonale. Dobrze wiedzieć, że przynajmniej... można się z tobą dogadać.",shape=box,color=blue];
		109 -> 112;
	106 [label="Żebyś mógł tylko usłyszeć mój śmiech! Dziękuję ci, Włóczęgo, za to, że nie jesteś nudny!",shape=box,color=blue];
		106 -> 110;
	107 [label="W tym też pojednanie nieszczęśliwie zakochanego sługi z ową skłóconą rodziną mieszkającą na górze.",shape=box,color=blue];
		107 -> 111;
	112 [label="Update boolean RoatheKnowsReset",color=orange];
		112 -> 117;
	110 [label="Add -1 to Thermostat",color=orange];
		110 -> 113;
	111 [label="Rodzina, która, jak wspomniałem, nie ma pojęcia, że tu jesteśmy. I nie ma pojęcia o tym, że Albrecht nadal żyje, prawda?",shape=box,color=blue];
		111 -> 114;
		111 -> 115;
		111 -> 116;
	117 [label="Przynajmniej będzie ciekawie.",shape=box,color=blue];
		117 -> 122;
	113 [label="Cóż to była za rozkosz! Myślę, że Ty i ja rzeczywiście zostaniemy przyjaciółmi. To było naprawdę cudowne.",shape=box,color=blue];
		113 -> 118;
	114 [label="Oferujesz pomoc w przekonaniu Loida, żeby... porozmawiał z rodziną Entrati?",shape=box,color=red];
		114 -> 119;
	115 [label="Nie mogę przekonać Loida. Mówi, że to będzie dla nich zbyt bolesne.",shape=box,color=red];
		115 -> 120;
	116 [label="Nie wiedzą, że Albrecht Entrati wciąż żyje.",shape=box,color=red];
		116 -> 121;
	122 [label="Chat ends.",color=orange];
	118 [label="Myślę, że muszę cię za to nagrodzić. Uczynić swoją część umowy jeszcze słodszą dla ciebie. Taka śmiałość jest rzadkością.",shape=box,color=blue];
		118 -> 103;
	119 [label="Nie za darmo, mój otumaniony Pustką Uzurpatorze.",shape=box,color=blue];
		119 -> 123;
	120 [label="Ty nie zdołasz, ale obiecuję... że ja tak.",shape=box,color=blue];
		120 -> 123;
	121 [label="A tam, gdzie nie udało ci się przekonać tego zrozpaczonego lokaja? Obiecuję ci... że ja zdołam.",shape=box,color=blue];
		121 -> 123;
	123 [label="I tak oto doszliśmy do mojej propozycji: pomóż mi uporządkować moje wspomnienia, dostać się do sedna tego wszystkiego.",shape=box,color=blue];
		123 -> 124;
	124 [label="A ja zapewnię, że zrozpaczony sługa wejdzie po tych schodach. A do tego czasu, spocznę spokojnie i nie będę nikomu wadził. Co o tym sądzisz? Umowa stoi?",shape=box,color=blue];
		124 -> 125;
		124 -> 126;
	125 [label="Nie ma mowy.",shape=box,color=red];
		125 -> 127;
	126 [label="Umowa stoi.",shape=box,color=red];
		126 -> 128;
	127 [label="Jak wolisz, ale ostrzegam:",shape=box,color=blue];
		127 -> 129;
	128 [label="+5 Chemistry",color=orange];
		128 -> 130;
