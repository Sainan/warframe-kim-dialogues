		j4164524351 -> j3961231984;
	j3961231984 [label="Transkrypcja: Potworność i nadmiar służyły nam w przeszłości znakomicie. Oczekiwano ode mnie, że zastosuję je jako taktykę wojenną.",shape=box,color=blue];
		j3961231984 -> j2764955215;
	j2764955215 [label="Jak oswoiliśmy Plagę w czasach naszych przodków? Rozerwaliśmy serce atomu jak pączek róży, oczywiście!",shape=box,color=blue];
		j2764955215 -> j1967762139;
	j1967762139 [label="Siedmiu nakazało mi, stać się Diabłem z trójzębem głowic, siewcą z torbą szalejącego promieniowania.",shape=box,color=blue];
		j1967762139 -> j3618086181;
	j3618086181 [label="Tego dnia dowiedzieliśmy się, że Świadomi są w stanie nie tylko unieszkodliwić naszą technologię, ale także ją przejąć.",shape=box,color=blue];
		j3618086181 -> j1808285546;
	j1808285546 [label="Stado nikczemnych małych dronów-niwelatorów, które wysłaliśmy, radośnie do nas powróciło, wciąż obciążone bombami, rechocząc nieznanymi językami i detonując pośród samych statków-matek, które je wysłały.",shape=box,color=blue];
		j1808285546 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
