	2239 [label="Jak oswoiliśmy Plagę w czasach naszych przodków? Rozerwaliśmy serce atomu jak pączek róży, oczywiście!",shape=box,color=blue];
		2239 -> 2236;
	2236 [label="Siedmiu nakazało mi, stać się Diabłem z trójzębem głowic, siewcą z torbą szalejącego promieniowania.",shape=box,color=blue];
		2236 -> 5704;
	5704 [label="That was the day we learned the Sentients were not only capable of nullifying our technology, but also of commandeering it.",shape=box,color=blue];
