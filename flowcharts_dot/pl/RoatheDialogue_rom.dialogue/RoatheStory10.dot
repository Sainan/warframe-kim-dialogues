		j1745352893 -> j1585879105;
	j1585879105 [label="Transkrypcja: To Scarne, drażliwy, intelektualny i zgryźliwy, jako pierwszy przedstawił Plan jeszcze przed wojną. \"Musimy opuścić gniazdo, bo gniazdo płonie\".",shape=box,color=blue];
		j1585879105 -> j2065920111;
	j2065920111 [label="Poprzez wyzysk i nieodpowiedzialne eksperymenty, zniszczyliśmy System do tego stopnia, że nie było już nadziei na jego odratowanie.",shape=box,color=blue];
		j2065920111 -> j2418730357;
	j2418730357 [label="Ekspansja poza nowe horyzonty była teraz naszą jedyną opcją. ",shape=box,color=blue];
		j2418730357 -> j3401940577;
	j3401940577 [label="He, too, inaugurated the cowardly Towers in the Void.",shape=box,color=blue];
		j3401940577 -> j131260154;
	j131260154 [label="Lęk przed powrotem Świadomych był w nim tak silny, że mógł sobie wyobrazić jedynie odwrót na wyspy w morzu, jakim była Pustka.",shape=box,color=blue];
		j131260154 -> j1078327309;
	j1078327309 [label="How little credit we gave the Sentients for courage.",shape=box,color=blue];
		j1078327309 -> j1060071859;
	j1060071859 [label="They willingly endured the Void’s scalding fire purely for the chance to punish us.",shape=box,color=blue];
		j1060071859 -> j921430358;
