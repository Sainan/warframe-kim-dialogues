	j2982523298 [label="VM: KARA",shape=box,color=blue];
		j2982523298 -> j354785573;
	j354785573 [label="Transkrypcja: To Scarne, drażliwy, intelektualny i zgryźliwy, jako pierwszy przedstawił Plan jeszcze przed wojną. \"Musimy opuścić gniazdo, bo gniazdo płonie\".",shape=box,color=blue];
		j354785573 -> j735868306;
	j735868306 [label="Poprzez wyzysk i nieodpowiedzialne eksperymenty, zniszczyliśmy System do tego stopnia, że nie było już nadziei na jego odratowanie.",shape=box,color=blue];
		j735868306 -> j943372480;
	j943372480 [label="Ekspansja poza nowe horyzonty była teraz naszą jedyną opcją. ",shape=box,color=blue];
		j943372480 -> j1698381652;
	j1698381652 [label="On również zainaugurował tchórzliwe Wieże w Pustce.",shape=box,color=blue];
		j1698381652 -> j3646237674;
	j3646237674 [label="Lęk przed powrotem Świadomych był w nim tak silny, że mógł sobie wyobrazić jedynie odwrót na wyspy w morzu, jakim była Pustka.",shape=box,color=blue];
		j3646237674 -> j1694173607;
	j1694173607 [label="Jak mało docenialiśmy odwagę Świadomych.",shape=box,color=blue];
		j1694173607 -> j2927540128;
	j2927540128 [label="Dobrowolnie znosili palący ogień Pustki tylko po to, by nas ukarać.",shape=box,color=blue];
		j2927540128 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
