		j3609398078 -> j218520216;
		j3609398078 -> j3366902895;
		j3609398078 -> j2341933140;
	j2430275641 [label="Bo tak jest i dobrze o tym wiesz. W prawdzie rzeczy, połowa twojego istnienia jest oparta na morderstwie jako formie sztuki!",shape=box,color=blue];
		j2430275641 -> j1655572878;
	j2395358293 [label="Och, naprawdę? Zastanówmy się nad tym przez chwilę.",shape=box,color=blue];
		j2395358293 -> j3734057333;
	j3973381371 [label="Niedawno uległa zmianie i niezmiernie mi to przeszkadza.",shape=box,color=blue];
		j3973381371 -> j617296034;
		j3973381371 -> j1495241862;
	j1655572878 [label="Widzę te \"szkoły\" którymi wysługują się Tenno i które ty \"pożyczasz\". Pomijając naukę Daksów. Jakże oni uwielbiali gadać i gadać przez radio, nieważne ile razy kazaliśmy im opuścić ten kanał.",shape=box,color=blue];
		j1655572878 -> j3219568283;
	j3734057333 [label="Powiedz mi coś i proszę, powiedz mi to szczerze. Kłamiąc w tej chwili, zaszkodzisz nam obojgu, a szczególnie sobie samemu:",shape=box,color=blue];
		j3734057333 -> j1473262652;
	j617296034 [label="W jaki sposób?",shape=box,color=red];
		j617296034 -> j2579122420;
	j1495241862 [label="Przez Uriela?",shape=box,color=red];
		j1495241862 -> j3349764261;
	j3219568283 [label="Umrę z uśmiechem na ustach, jeśli już do końca życia nie usłyszę: \"Ciało me jest ostrzem\" czy \"Istnieję, by atakować\", Uzurpatorze.",shape=box,color=blue];
		j3219568283 -> j2662769295;
	j1473262652 [label="Czy pragnąłeś kiedykolwiek posiadać broń czy Warframe'a przystosowanego do twoich własnych potrzeb? Może pomalowanego w niepowtarzalny sposób, albo pasujący do twojego nastroju?",shape=box,color=blue];
		j1473262652 -> j1676128529;
		j1473262652 -> j1448848240;
		j1473262652 -> j38518266;
	j2579122420 [label="Kiedyś lubowałem się w mieczach. Eleganckie. Szybkie. Mogłem sunąć przez pole bitwy i obalać wrogów w zasięgu ręki. Karmazyn na srebrzystym ostrzu, lśniący w blasku błękitnej gwiazdy.",shape=box,color=blue];
		j2579122420 -> j625586778;
	j3349764261 [label="Zakładam, że tak. A może to przez brak wspomnień. Nie wiem, co innego mogłyby być tego przyczyną.",shape=box,color=blue];
		j3349764261 -> j2579122420;
	j2662769295 [label="Ludzkość od zarania dziejów postrzegała \"morderstwo\" jako grzech, ale \"zabójstwo\" jako sztukę. Nie uważasz tego za dziwne? Władać mieczem i pokonać wroga w walce, aby być postrzeganym za nadzwyczaj honorowe.",shape=box,color=blue];
		j2662769295 -> j2226268546;
	j1676128529 [label="Tak... ale co to ma do rzeczy?",shape=box,color=red];
		j1676128529 -> j3869142189;
	j1448848240 [label="Nie. Nigdy.",shape=box,color=red];
		j1448848240 -> j1838286432;
	j38518266 [label="Nie mam czasu na głupie gierki. [Koniec]",shape=box,color=red];
		j38518266 -> j2705992386;
	j625586778 [label="Ale teraz? Teraz pragnę zatapiać własne kły. Poczuć ciało w moich pazurach. Zatopić me palce i rwać mięso od kości.",shape=box,color=blue];
		j625586778 -> j2122947489;
	j2226268546 [label="Ale pozbawić kogoś życia kawałkiem metalu w ciemnej uliczce jest przejawem tchórzostwa i degeneracji. ",shape=box,color=blue];
		j2226268546 -> j3828090469;
	j3869142189 [label="Doceniam twoją szczerość. Nie będę twierdzić, że raczej nie przepadasz za mordowaniem z zimną krwią, a rzeź niewinnych nie sprawia ci wielkiej przyjemności (ale może tak jest i twoje wcześniejsze słowa były kłamstwem, jakiż to by był smakowity zwrot akcji, ale nie o tym teraz rozmawiamy).",shape=box,color=blue];
		j3869142189 -> j3042803527;
	j1838286432 [label="Poproszę cię, abyś naprawdę zastanowił się nad tym pytaniem. Widziałem twoich przyjaciół Tenno, szalejących tutaj niczym parada dziwaków. Niczym dzikie bestie, które wpadły do wiader z farbą.",shape=box,color=blue];
		j1838286432 -> j4022471488;
	j2705992386 [label="Jak wolisz.",shape=box,color=blue];
		j2705992386 -> "Chat ends.";
	j2122947489 [label="Pragnę spijać ten ichor, kiedy ścięgna pękają, a ciało ugina się przede mną, rozpada się w krwawoczerwone skrawki. Otworzyć je jak owoc i wyssać szpik.",shape=box,color=blue];
		j2122947489 -> j3622744948;
		j2122947489 -> j364250042;
	j3828090469 [label="Gdzie leży różnica? W \"honorze\"? Kto decyduje o tym, co jest honorowe, a co nie? Przegrany? Zwycięzca? Czy honor wywodzi się wyłącznie z tradycji?",shape=box,color=blue];
		j3828090469 -> j2352346991;
		j3828090469 -> j895895431;
		j3828090469 -> j2983866856;
	j3042803527 [label="Zakładając więc, że nie jest to prawdą i zabijasz wyłącznie \"kiedy to konieczne\", jak sam wspomniałeś, powiedz mi więc, dlaczego poświęcałbyś czas na zdobienie swoich narzędzi mordu?",shape=box,color=blue];
		j3042803527 -> j2835734233;
	j4022471488 [label="Nigdy nie odczułeś podobnej potrzeby? Ani razu? Przysięgam, że nie będę się z ciebie nabijać, jeśli się do tego przyznasz.",shape=box,color=blue];
		j4022471488 -> j3987340005;
		j4022471488 -> j1239312675;
	j3622744948 [label="Roathe?",shape=box,color=red];
		j3622744948 -> j4078157151;
	j364250042 [label="I... to nie jest dla ciebie normalne?",shape=box,color=red];
		j364250042 -> j3375534448;
	j2352346991 [label="Rozumiem, o co ci chodzi. Granica jest niewyraźna. ",shape=box,color=red];
		j2352346991 -> j3190358004;
	j895895431 [label="Jedno wymaga praktyki i oddania. Drugie... to po prostu brutalność.",shape=box,color=red];
		j895895431 -> j2015795580;
	j2983866856 [label="Nie zamierzam prowadzić tej rozmowy. [Koniec]",shape=box,color=red];
		j2983866856 -> j2546758716;
	j2835734233 [label="Dlaczego przejmujesz się tym, jak wyglądasz, niosąc śmierć? Raczej nie po to, by ktoś mógł rozpoznać twoje zwłoki. Nie można cię z nikim pomylić. Nie, mój drogi Uzurpatorze. Jeśli musisz być mordercą, zakładam, że chcesz to robić z klasą.",shape=box,color=blue];
		j2835734233 -> j2406013540;
	j3987340005 [label="Nie.",shape=box,color=red];
		j3987340005 -> j2705992386;
	j1239312675 [label="Dobrze. Tak było. Dlaczego pytasz?",shape=box,color=red];
		j1239312675 -> j3869142189;
	j4078157151 [label="Tak, wiem! Wiem! Niczego takiego nie zrobię. Ani nie spalę tego miejsca do cna, nawet jeśli bardzo tego pragnę.",shape=box,color=blue];
		j4078157151 -> j336702853;
	j3375534448 [label="Nie! Nie jest! Ani nie jest dla mnie normalne śnić o spaleniu wszystkiego wokół mnie do gołej ziemi!",shape=box,color=blue];
		j3375534448 -> j336702853;
	j3190358004 [label="Wszystkie takie granice są niewyraźne. Im szybciej się z tym pogodzisz, tym szybciej dojdziemy do porozumienia, które bitwy mają znaczenie, a które nie.",shape=box,color=blue];
		j3190358004 -> j2902261557;
	j2015795580 [label="Dobrze, więc doprowadźmy ten tok rozumowania do logicznej konkluzji. Czy to trening czyni morderstwo honorowym? Mówisz, że jeśli stałbym się jak Daks i otoczył swoje morderstwo odpowiednią ilością ceremonii i okoliczności, stałoby się ono Sztuką?",shape=box,color=blue];
		j2015795580 -> j3624496748;
	j2546758716 [label="Bardzo dobrze.",shape=box,color=blue];
		j2546758716 -> "Chat ends.";
	j2406013540 [label="I z czego to wynika, jeśli nie z zamiłowania do czynu?",shape=box,color=blue];
		j2406013540 -> j1761048144;
	j336702853 [label="To musi być sprawka Uriela. Przyznam, że miewałem podobne myśli w przeszłości, ale nie były one nawet w połowie tak katastroficzne.",shape=box,color=blue];
		j336702853 -> j1405098768;
	j2902261557 [label="Decyzja o tym, czy zabójstwo było honorowe, to jak decydować między spłonięciem i utonięciem. Oba rodzaje śmierci są okropne.",shape=box,color=blue];
		j2902261557 -> j1863938343;
	j3624496748 [label="Teraz wkraczamy w sferę rytuałów i religii.",shape=box,color=blue];
		j3624496748 -> j2356802771;
	j1761048144 [label="Nie zrozum mnie źle! Nie osądzam cię, starasz się, jak możesz! Śmierć wybrała cię za partnera do tańca w tej wielkiej szaradzie życia, a ty nie mogłeś jej odmówić.",shape=box,color=blue];
		j1761048144 -> j1424735060;
	j1405098768 [label="A z pewnością nie aż tak... apokaliptyczne.",shape=box,color=blue];
		j1405098768 -> "Chat ends.";
	j1863938343 [label="Wszystkie drogi prowadzą do grobu, więc po co się rozdrabniać? Stoją przed nami ważniejsze problemy.",shape=box,color=blue];
		j1863938343 -> "Chat ends.";
	j2356802771 [label="Przynajmniej istnieje jakaś szczerość we wbiciu komuś noża w plecy. Nie ma w tym nic pobożnego. Niczego dumnego, ani obciążonego znaczeniem. To po prostu czyn.",shape=box,color=blue];
		j2356802771 -> j1949247455;
	j1424735060 [label="Gdybyś odłożył swoją broń, ilu ludzi umarłoby u twojego boku? Nie, dlaczego nie być dumnym ze swojego dzieła? Nacieszyć się sztuką? Jaka jest alternatywa? Szaleństwo? Zapomnienie?",shape=box,color=blue];
		j1424735060 -> j1593956134;
	j1949247455 [label="Czy samo to nie jest w sobie sztuką?",shape=box,color=blue];
		j1949247455 -> "Chat ends.";
	j1593956134 [label="Widziałem wielu, którzy obrali taką drogę, a na jej końcu czekał na nich tylko stryczek. Nie. Mówię: rób, co chcesz, Uzurpatorze. Tak, jak życie robiło z tobą to, co chciało.",shape=box,color=blue];
		j1593956134 -> "Chat ends.";
}