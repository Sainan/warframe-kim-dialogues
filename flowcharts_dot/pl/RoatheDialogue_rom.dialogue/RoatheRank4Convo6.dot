		j3022802062 -> j3101127362;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j2341376588 [label="Ostatnio mam skłonność do filozoficznych rozważań i jestem po prostu ciekawy.",shape=box,color=blue];
		j2341376588 -> j3077472683;
	j3101127362 [label="Ha, nie. W żadnym razie. Ale... kilka rund z tobą mogłoby być całkiem interesującą rozrywką. Nie, ostatnio mam skłonność do filozoficznych rozważań i po prostu jestem ciekawy.",shape=box,color=blue];
		j3101127362 -> j3077472683;
	"Chat ends." [color=orange];
	j3077472683 [label="Statystycznie... jesteśmy raczej wyrównani. A co do siły, hmm... nie stawiałbym zakładów, ani nie jestem szczególnie zainteresowany przysłowiowym mierzeniem mieczy.",shape=box,color=blue];
		j3077472683 -> j1312450184;
	j1312450184 [label="Zabójca z zabójcą. Co wolisz? Bliską, osobistą konfrontację? Atak z ukrycia czy chaos pola bitwy?",shape=box,color=blue];
		j1312450184 -> j3982628226;
		j1312450184 -> j2572085428;
		j1312450184 -> j2292299924;
		j1312450184 -> j1553688312;
	j3982628226 [label="Chaos. Wybuchy. Eksplozje. Im głośniej, tym lepiej.",shape=box,color=red];
		j3982628226 -> j44769334;
	j2572085428 [label="Atak z ukrycia. Pokonać przeciwnika, zanim zorientuje się, że tam w ogóle jestem. Najlepiej, jeśli zdołam dopaść cel tam, gdzie śpi.",shape=box,color=red];
		j2572085428 -> j4019739200;
	j2292299924 [label="Nienawidzę walczyć i wolałbym tego uniknąć.",shape=box,color=red];
		j2292299924 -> j4032839528;
	j1553688312 [label="To jest chora rozmowa.",shape=box,color=red];
		j1553688312 -> j3744122606;
	j44769334 [label="Boolean RoatheSoldier is now true.",color=orange];
		j44769334 -> j479541347;
	j4019739200 [label="Boolean RoatheAssassin is now true.",color=orange];
		j4019739200 -> j1571529051;
	j4032839528 [label="Och, mój biedny, biedny Uzurpatorze, gdybyś tylko mógł usłyszeć mój śmiech...",shape=box,color=blue];
		j4032839528 -> j4029089569;
	j3744122606 [label="Więc sio.",shape=box,color=blue];
		j3744122606 -> "Chat ends.";
	j479541347 [label="Żołnierz zaprawiony w boju, zupełnie jak ja. Nie dziwi mnie to, biorąc pod uwagę twoją przeszłość. Gdziekolwiek nie pójdziesz, zostawiasz za sobą rzekę krwi. Pierw Duviri, potem \"Narmer\", Höllvania, a teraz to.",shape=box,color=blue];
		j479541347 -> j4128766329;
	j1571529051 [label="Ach, skrytobójca wśród nas! Tak bardzo użyteczny, a tak niedoceniany. Zawsze porównywałem takich zabójców do utalentowanych lokajów.",shape=box,color=blue];
		j1571529051 -> j723644456;
	j4029089569 [label="Ty nędzna, żałosna istoto. Mam nadzieję, że dla własnego dobra mnie okłamujesz.",shape=box,color=blue];
		j4029089569 -> j2683443643;
	j4128766329 [label="Kto wie, co wydarzyło się od tamtej pory albo co zapomniałeś w międzyczasie? Śmierć jest sztuką, którą dzielisz z całym światem.",shape=box,color=blue];
		j4128766329 -> j229977744;
	j723644456 [label="Kiedy wykonują swoją pracę wyjątkowo dobrze, zawsze pozostają niezauważeni.",shape=box,color=blue];
		j723644456 -> j1524870867;
	j2683443643 [label="+20 Chemistry",color=orange];
		j2683443643 -> j1453787352;
	j229977744 [label="A więc jakim pędzlem najbardziej lubisz malować? Zastanówmy się nad tym.",shape=box,color=blue];
		j229977744 -> j657118308;
		j229977744 -> j205811652;
		j229977744 -> j311228129;
		j229977744 -> j4191530859;
	j1524870867 [label="A więc co? Sztylet? Trucizna? Łuk?",shape=box,color=blue];
		j1524870867 -> j2387840048;
		j1524870867 -> j4161845862;
		j1524870867 -> j2426484224;
		j1524870867 -> j198966343;
		j1524870867 -> j683575830;
	j1453787352 [label="W przeciwnym razie może to być najsmutniejsza rzecz, jaką kiedykolwiek słyszałem przez te wszystkie lata.",shape=box,color=blue];
		j1453787352 -> j2927459171;
	j657118308 [label="Pracuję z tym, co wpadnie mi w ręce. Lubię improwizować.",shape=box,color=red];
		j657118308 -> j3509755791;
	j205811652 [label="Łuk. Pełen gracji i zabójczy.",shape=box,color=red];
		j205811652 -> j4051908586;
	j311228129 [label="Ostrze. Lubię być blisko.",shape=box,color=red];
		j311228129 -> j1841891618;
	j4191530859 [label="Broń palna. Głośna, ale skuteczna.",shape=box,color=red];
		j4191530859 -> j468516089;
	j2387840048 [label="Pracuję z tym, co wpadnie mi w ręce. Lubię improwizować.",shape=box,color=red];
		j2387840048 -> j1034782805;
	j4161845862 [label="Łuk. Cichy i pełen gracji.",shape=box,color=red];
		j4161845862 -> j375512129;
	j2426484224 [label="Karabin wyborowy. Jeden strzał, jeden trup.",shape=box,color=red];
		j2426484224 -> j66068386;
	j198966343 [label="Trucizna. Znikam, zanim zorientują się, że nie żyją.",shape=box,color=red];
		j198966343 -> j3679759652;
	j683575830 [label="Sztylet. Jest taki... osobisty.",shape=box,color=red];
		j683575830 -> j3513385810;
	j2927459171 [label="Boolean RoatheWeaponNone is now true.",color=orange];
		j2927459171 -> "Chat ends.";
	j3509755791 [label="Wyobrażam sobie, jak szalejesz po polu bitwy, wymachując noszami. Jak przedzierasz się przez żołnierzy, wymachując oponą uczepioną pogiętej rury.",shape=box,color=blue];
		j3509755791 -> j779289044;
	j4051908586 [label="Aby posługiwać się łukiem w ogniu walki, potrzeba determinacji i jasności umysłu, na jaką niewielu stać. I oczywiście pewnych rąk.",shape=box,color=blue];
		j4051908586 -> j2935583265;
	j1841891618 [label="Mhm, ostrożnie. Nie podniecaj mnie za bardzo, Uzurpatorze. Jakże chciałbym zobaczyć, jak tańczysz na polu bitwy z bronią w ręku, wśród rozprysków krwi niczym płatki kwitnącego kwiatu...",shape=box,color=blue];
		j1841891618 -> j380289763;
	j468516089 [label="Z jakiegoś powodu pozostały wołem roboczym każdego pola bitwy od czasu ich wynalezienia, Uzurpatorze. Trudno jednak odmówić im skuteczności.",shape=box,color=blue];
		j468516089 -> j3116043013;
	j1034782805 [label="Wyobrażam sobie, jak niezauważenie zabijasz kogoś sztućcem albo nogą krzesła. Pozbawiasz kogoś życia podwiązką firanki.",shape=box,color=blue];
		j1034782805 -> j2567819822;
	j375512129 [label="Droga myśliwego. Prymitywna, ale elegancka w swej prostocie. Czasami najłatwiejsze i najprostsze metody są najskuteczniejsze.",shape=box,color=blue];
		j375512129 -> j3655780331;
	j66068386 [label="Uważam to za trochę pozbawione charakteru, ale nie mogę odmówić skuteczności. Ten spokój wiele mówi.",shape=box,color=blue];
		j66068386 -> j271576060;
	j3679759652 [label="Podstępny alchemik, hmm? Warzący nalewki, przelewający fiolki do szklanego niczego niepodejrzewających? A może nasycasz noże i kule jadem, którego skuteczność gwarantuje zaledwie draśnięcie?",shape=box,color=blue];
		j3679759652 -> j2046851785;
	j3513385810 [label="Mhm, ostrożnie. Nie podniecaj mnie za bardzo, Uzurpatorze. Jakież to intrygujące, obraz ciebie skrytego wśród cieni, z nożem gotowym do ataku...",shape=box,color=blue];
		j3513385810 -> j711935072;
	j779289044 [label="+10 Chemistry",color=orange];
		j779289044 -> j237912297;
	j2935583265 [label="Należy docenić ciszę tego wszystkiego. Przygotowanie strzały, napięcie cięciwy, wyczekiwanie chwili... to wszystko zwieńczone piękną śmiercią, kiedy strzała sięga celu?",shape=box,color=blue];
		j2935583265 -> j1105342478;
	j380289763 [label="Doceniam to pragnienie bliskości. Móc ujrzeć, jak światło życia zanika w oczach twojej ofiary. Poczuć, jak jej ciało bezwładnie pada przed tobą. Wiedzieć, że to twoje dzieło i nikogo innego.",shape=box,color=blue];
		j380289763 -> j2802275337;
	j3116043013 [label="Robią bałagan, są głośne i horrendalnie drogie, ale tak świetnie osiągają swój cel.",shape=box,color=blue];
		j3116043013 -> j3623938861;
	j2567819822 [label="+10 Chemistry",color=orange];
		j2567819822 -> j706837266;
	j3655780331 [label="Należy docenić ciszę tego wszystkiego. Przygotowanie strzały, napięcie cięciwy, wyczekiwanie chwili... to wszystko zwieńczone piękną śmiercią, kiedy strzała sięga celu?",shape=box,color=blue];
		j3655780331 -> j645953867;
	j271576060 [label="Wśród niekończącego się zgiełku pola bitwy, strzelec musi zapanować nad swoim oddechem. Wdech. Wydech. Pociągnięcie za spust.",shape=box,color=blue];
		j271576060 -> j763827537;
	j2046851785 [label="Widziałem, jak całe bataliony obracają się w ruinę przez jedno draśnięcie pojedynczego żołnierza. Toksyna sięga krwi, krew sięga płuc, a potem do płuc innego. Takie dzieło może obalić całe państwa.",shape=box,color=blue];
		j2046851785 -> j387670327;
	j711935072 [label="Doceniam to pragnienie bliskości. Móc ujrzeć, jak światło życia zanika w oczach twojej ofiary. Poczuć, jak jej ciało bezwładnie pada przed tobą.",shape=box,color=blue];
		j711935072 -> j2651013589;
	j237912297 [label="Nie mogę zadecydować, czy czyni cię to mniej, czy bardziej przerażającym, Uzurpatorze. Pozostanę chyba przy \"bardziej\". W każdym razie ta wizja mnie rozbawiła.",shape=box,color=blue];
