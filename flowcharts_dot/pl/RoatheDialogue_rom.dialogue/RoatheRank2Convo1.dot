	676 [label="Update boolean RoatheLyonConfessionDealNo",color=orange];
		676 -> 698;
	679 [label="Chyba zaczynam też rozumieć, dlaczego odebrałeś nam wszystkim wspomnienia. Widząc wszystkie twoje nieudane próby i przedsięwzięcia... dlaczego nie wyrzucić wszystkiego i zacząć od nowa?",shape=box,color=blue];
		679 -> 701;
	680 [label="Widząc z frustracją, że nie możesz już dłużej przekonywać jej o prostej prawdzie rzeczy, uciekłeś się do tego, co było — wykorzystując ten... swój dar.",shape=box,color=blue];
		680 -> 702;
	681 [label="Nie podoba mi się, że mieszasz mi w głowie, żeby naprawić swoje błędy, Włóczęgo. Jednak to, że próbujesz to zrobić dla mnie, jest... chyba, w jakiś sposób, do przyjęcia.",shape=box,color=blue];
		681 -> 703;
	682 [label="Update boolean DrifterLyon",color=orange];
		682 -> 704;
	683 [label="Update boolean DrifterRoathe",color=orange];
		683 -> 705;
	684 [label="Update boolean DrifterMarie",color=orange];
		684 -> 706;
	685 [label="Więc wiedząc, że nie możesz już osiągnąć tego, co było wcześniej w twoim zasięgu, uciekłeś się do tego, co było — wykorzystaniem tego... twojego daru.",shape=box,color=blue];
		685 -> 707;
	688 [label="To jakby szczęście rzucało monetą i nawet ja nie wiem, jaki preferuję wynik.",shape=box,color=blue];
		688 -> 710;
	689 [label="Jej zachwyt i oddanie Albrechtowi są niezachwiane. Zastanawiałem się, czy sługa powinien czuć się zagrożony, ale to tylko inny, niewinny rodzaj miłości. I mówię to ja.",shape=box,color=blue];
		689 -> 711;
	690 [label="Ta dwójka fanatyków nie wytrzyma dwóch minut bez wspominania o \"Sol\" albo \"Lua\", albo próbowania pobłogosławienia tej dziury.",shape=box,color=blue];
		690 -> 712;
	686 [label="Update boolean RoatheFamilyFail",color=orange];
		686 -> 708;
	687 [label="+5 Chemistry",color=orange];
		687 -> 709;
	691 [label="Bawi mnie twój optymizm. Bohaterowie. Tylko tym jesteście. Worami mięsa i kości, nadmuchanymi i napędzanymi optymizmem i nadzieją. Aż zęby od tego gniją.",shape=box,color=blue];
		691 -> 713;
	692 [label="Nie, źle mnie zrozumiałeś. W pewnym sensie to dla mnie pocieszające. To znaczy, że nawet jeśli rozbierzesz nas na części pierwsze, nadal jesteśmy tacy sami. Nie możemy się zmienić.",shape=box,color=blue];
		692 -> 714;
	693 [label="Jesteś zarazem pierwszą duszą, której kiedykolwiek chciałem zaufać... i powodem, dla którego teraz nie mogę sobie przypomnieć, dlaczego się na to odważyłem.",shape=box,color=blue];
		693 -> 715;
