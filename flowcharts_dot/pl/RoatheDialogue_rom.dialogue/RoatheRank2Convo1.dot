		766 -> 782;
	767 [label="Chat ends.",color=orange];
	768 [label="Jesteś zarazem pierwszą duszą, której kiedykolwiek chciałem zaufać... i powodem, dla którego teraz nie mogę sobie przypomnieć, dlaczego się na to odważyłem.",shape=box,color=blue];
		768 -> 784;
