		j2075111951 -> j1483193190 [label="false",color=purple];
	j1470456420 [label="Więc z braku lepszych alternatyw, będę po prostu brnąć dalej. \"Jak się ma nasza mała lotna sykofantka? Ksiądz chyba z tobą nie rozmawia.\" Tfu. Co za farsa.",shape=box,color=blue];
		j1470456420 -> j301363615;
		j1470456420 -> j890863087;
		j1470456420 -> j3758566912;
	j3396649298 [label="Nie. Przykro mi, ale nie robię układów z Orokin. Ani wtedy, ani teraz.",shape=box,color=red];
		j3396649298 -> j1266367698;
	j311977699 [label="Mam nadzieję, że tego nie pożałuję. Roathe, zgadzam się. Przyjmę twoją pomoc.",shape=box,color=red];
		j311977699 -> j1876832257;
