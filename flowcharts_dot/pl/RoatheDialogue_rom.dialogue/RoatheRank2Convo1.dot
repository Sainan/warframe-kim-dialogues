		j2694130358 -> j2075111951 [label="false",color=purple];
	j2891309795 [label="Z mojej strony to nietypowe wyzwanie, działać mając dostęp tylko do części moich wspomnień, wiedząc, że resztę trzymasz niczym talię kart.",shape=box,color=blue];
		j2891309795 -> j1470456420;
	j1548183183 [label="Ale... całe te gierki, w które pogrywasz? Strata czasu. Wystarczy słowo, a twój problem zostanie rozwiązany.",shape=box,color=blue];
		j1548183183 -> j3396649298;
		j1548183183 -> j311977699;
	j150329555 [label="Powiedz mi, czego pragniesz, a dojdziemy do porozumienia. Te... gierki, to tylko strata czasu.",shape=box,color=blue];
		j150329555 -> j2953660143;
	j2075111951 [label="Evaluate expressions",color=orange];
