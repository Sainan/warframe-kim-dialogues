		740 -> 757;
	741 [label="Jako przykład ojcowskiej figury. Albo świętego. Nie jestem pewien, czy któryś z tych prymitywnych Kaithe'ów z ich czasów kopnął ją w głowę w dzieciństwie, czy też bardzo brakowało jej mentorów, tego nie wiem.",shape=box,color=blue];
		741 -> 757;
	742 [label="Mam na myśli, że chętnie mi bardzo szczegółowo tłumaczą, jak okropny jestem i że powinienem pokutować i przeprosić za wszystko, co zrobiłem.",shape=box,color=blue];
