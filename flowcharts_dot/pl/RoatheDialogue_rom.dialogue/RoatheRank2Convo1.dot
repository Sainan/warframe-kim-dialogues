	j2385754392 [label="Boolean RoatheLyonConfessionDealNo is now false.",color=orange];
		j2385754392 -> j3110399350;
	j4136617300 [label="Chyba zaczynam też rozumieć, dlaczego odebrałeś nam wszystkim wspomnienia. Widząc wszystkie twoje nieudane próby i przedsięwzięcia... dlaczego nie wyrzucić wszystkiego i zacząć od nowa?",shape=box,color=blue];
		j4136617300 -> j919441520;
	j3720641277 [label="Widząc z frustracją, że nie możesz już dłużej przekonywać jej o prostej prawdzie rzeczy, uciekłeś się do tego, co było — wykorzystując ten... swój dar.",shape=box,color=blue];
		j3720641277 -> j3562842627;
	j2379225314 [label="Nie podoba mi się, że mieszasz mi w głowie, żeby naprawić swoje błędy, Włóczęgo. Jednak to, że próbujesz to zrobić dla mnie, jest... chyba, w jakiś sposób, do przyjęcia.",shape=box,color=blue];
		j2379225314 -> j2575125557;
	j1971187222 [label="Boolean DrifterLyon is now true.",color=orange];
		j1971187222 -> j3108793998;
	j2878655816 [label="Boolean DrifterRoathe is now true.",color=orange];
		j2878655816 -> j3825204234;
	j3344387463 [label="Boolean DrifterMarie is now true.",color=orange];
		j3344387463 -> j1746786499;
	j3595028549 [label="Więc wiedząc, że nie możesz już osiągnąć tego, co było wcześniej w twoim zasięgu, uciekłeś się do tego, co było — wykorzystaniem tego... twojego daru.",shape=box,color=blue];
		j3595028549 -> j905547075;
	j2594161211 [label="To jakby szczęście rzucało monetą i nawet ja nie wiem, jaki preferuję wynik.",shape=box,color=blue];
		j2594161211 -> j382369115;
	j987914847 [label="Jej zachwyt i oddanie Albrechtowi są niezachwiane. Zastanawiałem się, czy sługa powinien czuć się zagrożony, ale to tylko inny, niewinny rodzaj miłości. I mówię to ja.",shape=box,color=blue];
		j987914847 -> j2064640792;
	j2469692816 [label="Ta dwójka fanatyków nie wytrzyma dwóch minut bez wspominania o \"Sol\" albo \"Lua\", albo próbowania pobłogosławienia tej dziury.",shape=box,color=blue];
		j2469692816 -> j2305846803;
	j4192810264 [label="Boolean RoatheFamilyFail is now true.",color=orange];
		j4192810264 -> j1272473291;
	j3872806205 [label="+5 Chemistry",color=orange];
		j3872806205 -> j4216596231;
	j2209039873 [label="Bawi mnie twój optymizm. Bohaterowie. Tylko tym jesteście. Worami mięsa i kości, nadmuchanymi i napędzanymi optymizmem i nadzieją. Aż zęby od tego gniją.",shape=box,color=blue];
		j2209039873 -> j3541932656;
	j3457612095 [label="Nie, źle mnie zrozumiałeś. W pewnym sensie to dla mnie pocieszające. To znaczy, że nawet jeśli rozbierzesz nas na części pierwsze, nadal jesteśmy tacy sami. Nie możemy się zmienić.",shape=box,color=blue];
		j3457612095 -> j2631304166;
	j2677531241 [label="Jesteś zarazem pierwszą duszą, której kiedykolwiek chciałem zaufać... i powodem, dla którego teraz nie mogę sobie przypomnieć, dlaczego się na to odważyłem.",shape=box,color=blue];
		j2677531241 -> j3713312394;
