	780 [label="+15 Chemistry",color=orange];
		780 -> 793;
	773 [label="A skoro mamy to już z głowy, jak idą sprawy z naszą małą lotną sykofantką? Zgaduję, że ksiądz nadal się do ciebie nie odzywa.",shape=box,color=blue];
		773 -> 643;
