	j3410374601 [label="No cóż, skoro nie zamierzasz być nudziarzem, Włóczęgo, to po co miałbym tracić na ciebie czas? Mam już na głowie fanatyków, z którymi najwyraźniej mam obowiązek spędzać czas.",shape=box,color=blue];
		j3410374601 -> j3866645924;
	j3969248166 [label="Ha, a więc powiedziała ci. Oczywiście, że się wygadała. Czy możesz mnie obwiniać? Te przeklęte słodycze były jedynym dobrem w tej zapyziałej dziurze.",shape=box,color=blue];
		j3969248166 -> j776473847;
		j3969248166 -> j3730510401;
	j2682816446 [label="+5 Chemistry",color=orange];
		j2682816446 -> j2271974662;
	j1824169708 [label="Muszę wiedzieć, co zostało mi odebrane, Włóczęgo. Muszę wiedzieć, z czego mnie okradł Albrecht, wciskając mi to serum.",shape=box,color=blue];
		j1824169708 -> j811580873;
		j1824169708 -> j3040844479;
	j3507445400 [label="Muszę wiedzieć, z czego okradł mnie Albrecht, wciskając mi to serum. Muszę wiedzieć, co skrywa się w mojej głowie, Włóczęgo. Jeśli nie jest to dla ciebie zbyt duży problem...",shape=box,color=blue];
		j3507445400 -> j1806345655;
		j3507445400 -> j3142178281;
	j1494925300 [label="A dlaczego miałbym się złościć, Włóczęgo?",shape=box,color=blue];
		j1494925300 -> j4049230823;
		j1494925300 -> j4232360974;
		j1494925300 -> j3875730632;
	j2236838084 [label="\"Manipulowałeś moją pamięcią\". Jakbym był jakąś rzeźbą Ayatan, którą bawiłeś się dla zabawy. Zrobiłeś znacznie więcej, niż \"manipulowałeś\". Ty wszystkiego się pozbyłeś.",shape=box,color=blue];
		j2236838084 -> j3014850847;
		j2236838084 -> j1969927837;
	j776473847 [label="A więc to prawda. Wykradałeś się do Galicji, by kraść czekoladki? Wyglądając tak...?",shape=box,color=red];
		j776473847 -> j2615055755;
	j3730510401 [label="Jak dokładnie je zdobyłeś?",shape=box,color=red];
		j3730510401 -> j1067446816;
	j2271974662 [label="Ha! Spryciarz. Przeklęte czekoladki były jedynym dobrem w tej zapyziałej dziurze.",shape=box,color=blue];
		j2271974662 -> j3567300140;
	j811580873 [label="Obiecuję.",shape=box,color=red];
		j811580873 -> j1272906167;
	j3040844479 [label="Dojdziemy do tego, ale to zajmie trochę czasu.",shape=box,color=red];
		j3040844479 -> j2390122378;
	j1806345655 [label="Przejdziemy do tego.",shape=box,color=red];
		j1806345655 -> j707505960;
	j3142178281 [label="Próbuję, ale nie ułatwiasz mi tego.",shape=box,color=red];
		j3142178281 -> j486583897;
	j4049230823 [label="Mówiłeś, że nie gniewasz się na mnie, za wymazanie twoich wspomnień, ale wiem, że kłamiesz... to nie pierwszy raz, kiedy odbywamy tę rozmowę.",shape=box,color=red];
		j4049230823 -> j883072268;
	j4232360974 [label="Nienawidzisz samego siebie za dobrowolne przyjęcie tego serum. Nienawidzisz siebie i to doprowadza cię do furii, bo jesteś wszystkim, co ci zostało.",shape=box,color=red];
		j4232360974 -> j309443485;
	j3875730632 [label="Mówiłeś, że nie gniewasz się na mnie, za wymazanie twoich wspomnień, ale nie potrafię sobie wyobrazić, żeby tak było.",shape=box,color=red];
		j3875730632 -> j309443485;
	j3014850847 [label="Nie zapomniałeś niczego ważnego, tylko nasze rozmowy.",shape=box,color=red];
		j3014850847 -> j941452931;
	j1969927837 [label="Nie zapomniałeś wszystkiego, tylko nasze rozmowy w tym miejscu. Nadal pamiętasz całą resztę, w tym wszystko, co odzyskaliśmy w Descendii.",shape=box,color=red];
		j1969927837 -> j941452931;
	j2615055755 [label="Tak, z niebieską skórą, ogonem, okrywającą mnie plagą i całą resztą. To niesamowite, ile potrafią zdziałać płaszcz, kapelusz i maska.",shape=box,color=blue];
		j2615055755 -> j3190940419;
	j1067446816 [label="To było całkiem proste. Poza tym, jako \"protoframe\" i elita wyszkolonych w boju Orokin, myślę, że jestem w stanie ukraść ciastka z targu, nie dając się przyłapać.",shape=box,color=blue];
		j1067446816 -> j2690582835;
	j3567300140 [label="Zanim zapytasz, Maria zna tę opowieść najlepiej. Nie chciałbym narażać się na kolejne wrzaski i tyrady fanatyków.",shape=box,color=blue];
		j3567300140 -> j1841079483;
	j1272906167 [label="Układy z diabłem... to niebezpieczna gra.",shape=box,color=blue];
		j1272906167 -> j3866645924;
	j2390122378 [label="A ja jestem cierpliwym diabłem.",shape=box,color=blue];
		j2390122378 -> j3866645924;
	j707505960 [label="Zadbaj o to.",shape=box,color=blue];
		j707505960 -> j3866645924;
	j486583897 [label="Oczywiście, że nie! Gdzie w tym zabawa?",shape=box,color=blue];
		j486583897 -> j3866645924;
	j883072268 [label="Jakież to słodkie! Zupełnie nie jestem zaskoczony! Jaką robi mi różnicę, czy to kłamstwo czy nie?! Poza tym-",shape=box,color=blue];
		j883072268 -> j309443485;
	j309443485 [label="Mylisz się! Jesteś w błędzie tak mocno zapierającym dech! Nie wychodź z naiwnego przeświadczenia, że jesteś w stanie pojąć zawiłości mojej wściekłości, której tak bardzo nie rozumiesz.",shape=box,color=blue];
		j309443485 -> j2111165448;
	j941452931 [label="Jak śmiesz wmawiać mi, co w moim umyśle jest wartościowe a co nie, Włóczęgo? To nie jest twoja własność.",shape=box,color=blue];
		j941452931 -> j2111165448;
	j3190940419 [label="Ludziom tak łatwo przeoczyć tych, których nie chcą dostrzec. Poza tym, jako \"protoframe\" i elita wyszkolonych w boju Orokin, myślę, że jestem w stanie ukraść ciastka z targu, nie dając się przyłapać.",shape=box,color=blue];
		j3190940419 -> j4202875018;
	j2690582835 [label="Tak, z niebieską skórą, ogonem, okrywającą mnie plagą i całą resztą. To niesamowite, ile potrafią zdziałać płaszcz, kapelusz i maska.",shape=box,color=blue];
		j2690582835 -> j4202875018;
	j1841079483 [label="Wydzierają się na mnie, prawiąc mi o grzechach i że powinienem pokutować, nie dodając do tego sterty zarzutów, że \"po raz kolejny skłamałabym na temat swojej wersji wydarzeń\".",shape=box,color=blue];
		j1841079483 -> j1563309707;
		j1841079483 -> j4255493291;
		j1841079483 -> j1014098041;
		j1841079483 -> j1387831022;
	j4202875018 [label="Boolean RoatheMariePastry1 is now true.",color=orange];
		j4202875018 -> j1110137699;
		j4202875018 -> j534283330;
	j1110137699 [label="Ale czy przyniosłeś wystarczająco dla Marii i Leona?",shape=box,color=red];
		j1110137699 -> j1536925539;
	j534283330 [label="Więc po prostu ukradłeś ciastka.",shape=box,color=red];
		j534283330 -> j544125942;
	j1536925539 [label="Ach. Czego się po mnie spodziewałeś? Zabrać dość dla siebie i ani więcej? Dlaczego? To, że nie lubię ich towarzystwa, nie znaczy, że chcę się ich pozbyć?",shape=box,color=blue];
		j1536925539 -> j552978399;
	j544125942 [label="Wszystko na tej planecie i tak wkrótce stałoby się własnością Imperium Orokin. Miałem takie prawo.",shape=box,color=blue];
		j544125942 -> j2733069763;
	j552978399 [label="Oczekujesz, że moja niechęć do nich musi prowadzić do okrucieństwa. Jestem diabłem i ma to leżeć w mojej naturze, tak wygląda ten tok rozumowania.",shape=box,color=blue];
		j552978399 -> j1557281150;
	j2733069763 [label="Poza tym nie miałem pieniędzy. Co innego mogłem zrobić?",shape=box,color=blue];
		j2733069763 -> j1563323418;
	j1557281150 [label="Jakież to okropne rozczarowujące. Takie płytkie zachowania są zarezerwowane dla wyjątkowo nudnych i szkolnych łobuzów. ",shape=box,color=blue];
		j1557281150 -> j47195542;
	j1563323418 [label="Wiem, że przedzierasz się przez statki i zabierasz, cokolwiek potrzebujesz lub chcesz, nie zgrywaj przede mną niewiniątka, Uzurpatorze.",shape=box,color=blue];
		j1563323418 -> j3866211912;
		j1563323418 -> j2202871334;
	j47195542 [label="Nienawidzę ich. A jednak muszę z nimi współistnieć. Nie chcę odbierać jej tej prostej przyjemności. To tylko ciastko. Po co tak niepotrzebnie pogarszać sytuację?",shape=box,color=blue];
		j47195542 -> j1897521752;
		j47195542 -> j907582391;
		j47195542 -> j4126708190;
	j3866211912 [label="Nieważne. ",shape=box,color=red];
		j3866211912 -> j2295521393;
	j2202871334 [label="Chyba masz rację.",shape=box,color=red];
		j2202871334 -> j880898292;
	j1897521752 [label="Albo mógłbyś być dla nich po prostu miły.",shape=box,color=red];
		j1897521752 -> j1653756948;
	j907582391 [label="Żeby była jasność, nienawidzisz ich, więc jesteś dla nich miły.",shape=box,color=red];
		j907582391 -> j1953223048;
	j4126708190 [label="Nigdy o tym tak nie myślałem.",shape=box,color=red];
		j4126708190 -> j2784136245;
	j2295521393 [label="Fantastycznie. Kolejny, który nie potrafi przyznać się do winy. Jakby nie wystarczyło już tych fanatyków, którzy wrzeszczą na mnie o każdej porze, nalegając, bym odpokutował.",shape=box,color=blue];
		j2295521393 -> j1563309707;
		j2295521393 -> j4255493291;
		j2295521393 -> j1014098041;
		j2295521393 -> j1387831022;
	j880898292 [label="+5 Chemistry",color=orange];
		j880898292 -> j2394902837;
	j1653756948 [label="Tak, powinieneś przekonać się jak to jest, kiedy wiszą ci nad uchem każdego dnia i nocy, przeklinając twoje imię i lamentując, byś odpokutował.",shape=box,color=blue];
		j1653756948 -> j1563309707;
		j1653756948 -> j4255493291;
		j1653756948 -> j1014098041;
		j1653756948 -> j1387831022;
	j1953223048 [label="Dokładnie. Co jest takiego trudnego do zrozumienia? Widzę, że jesteś sarkastyczny, Uzurpatorze. Ale nie martw się, to mnie bawi.",shape=box,color=blue];
		j1953223048 -> j3290161098;
	j2784136245 [label="+5 Chemistry",color=orange];
		j2784136245 -> j131478359;
	j2394902837 [label="Dziękuję. Nareszcie ktoś, kto potrafi pogodzić się z prawdą! Gdyby tylko ci dwaj fanatycy potrafili zrobić to samo, nie darliby się na mnie o każdej porze dnia i nocy, nalegając na moją pokutę.",shape=box,color=blue];
		j2394902837 -> j1563309707;
		j2394902837 -> j4255493291;
		j2394902837 -> j1014098041;
		j2394902837 -> j1387831022;
	j3290161098 [label="To jest co najmniej lepsze od zjełczałego, niekończącego się kazania fanatyków, którzy ciągle przeklinają i krzyczą, żebym odpokutował.",shape=box,color=blue];
		j3290161098 -> j1563309707;
