		j1876832257 -> j2115194585 [label="false",color=purple];
	j3170374245 [label="Leon... boryka się z tyloma problemami. Nie wiem, jak do niego dotrzeć.",shape=box,color=red];
		j3170374245 -> j3889797300;
	j2327637829 [label="Maria nie dostrzega, kim naprawdę był Entrati. Nie ważne, co robię, nie mogę sprawić, by ujrzała prawdę.",shape=box,color=red];
		j2327637829 -> j1159416484;
	j1097619116 [label="Widzisz, jest ta cała sprawa... o tym, dlaczego przyjąłeś serum, a ja... powiedziałem złe rzeczy w niewłaściwych chwilach.",shape=box,color=red];
		j1097619116 -> j1265454223;
	j270877365 [label="Wstydzę się to przyznać, ale... zakochałem się w kimś z waszej trójki.",shape=box,color=red];
		j270877365 -> j3514592447;
		j270877365 -> j3302289106;
		j270877365 -> j1320466121;
	j41742011 [label="Próbuję przekonać ciebie i resztę, żebyście pomogli mi zjednoczyć Loida z rodziną na górze, a ja... nie mogłem...",shape=box,color=red];
		j41742011 -> j2688970177;
	j2967240575 [label="Nie, Leon... nie jest zbyt rozmowny.",shape=box,color=red];
		j2967240575 -> j807449945;
	j1405549385 [label="Dogaduję się z Marią. Dlaczego nazywasz ją sykofantką?",shape=box,color=red];
		j1405549385 -> j496450557;
	j1759946622 [label="Chyba się z nimi nie polubiłeś. Dlaczego?",shape=box,color=red];
		j1759946622 -> j2214301362;
	j736037539 [label="Nie. Przykro mi, ale nie robię układów z Orokin. Ani wtedy, ani teraz.",shape=box,color=red];
		j736037539 -> j3753625537;
	j431338903 [label="Mam nadzieję, że tego nie pożałuję. Roathe, zgadzam się. Przyjmę twoją pomoc.",shape=box,color=red];
		j431338903 -> j4059875686;
	j249655318 [label="\"Póki co\". Interesujące. Czy naprawdę gonimy za własnymi ogonami, niczym dworzanie uwięzieni w tańcu? Znów i znów powtarzamy te same ruchy, póki muzyka gra?",shape=box,color=blue];
		j249655318 -> j2014538080;
		j249655318 -> j1505909917;
	j995317280 [label="Ty wiesz najlepiej, prawda? Niesamowite, jakie to przewidywalne. Dobrze wiedzieć, że można polegać nawet na kimś tak zdruzgotanym jak on.",shape=box,color=blue];
		j995317280 -> j387725644;
	j3369863461 [label="Jeszcze nie wiesz? Hmm. Może jeszcze tak daleko nie zaszliśmy. Albo nie przeszło ci przez myśl, żeby o to zapytać przez ostatnie tysiąc prób.",shape=box,color=blue];
		j3369863461 -> j387725644;
	j650476071 [label="Och, i jeszcze jedno, zanim zapomnę?",shape=box,color=blue];
		j650476071 -> j3584753829;
	j3063500696 [label="Naprawdę zaprzedałeś swoją duszę diabłu już drugi raz... żeby mieć pewność, że zaciągnę cię do swojego łoża? Chodzi ci o moje serce, Uzurpatorze? Hmm. Zobaczymy, w swoim czasie.",shape=box,color=blue];
		j3063500696 -> j3293285998;
	j1482320842 [label="Kiedy nadejdzie właściwy czas, zapewnię ci prostą drogę do serca naszej małej lotnej sykofantki, Uzurpatorze. Uznaj to za załatwione.",shape=box,color=blue];
		j1482320842 -> j3293285998;
	j2179369235 [label="Kiedy nadejdzie właściwy czas, zapewnię ci prostą drogę do serca naszego zbolałego księdza, Uzurpatorze. Uznaj to za załatwione.",shape=box,color=blue];
		j2179369235 -> j3928862854;
	j466959937 [label="Będę o tym pamiętać, kiedy nadejdzie czas. Jeśli znów poróżnimy się w sprawie moich wspomnień, nie powtórzymy twoich wcześniejszych błędów.",shape=box,color=blue];
		j466959937 -> j1723927564;
	j4086113507 [label="Kiedy nadejdzie właściwy czas, zapewnię, że ten mały sługa wejdzie po schodach. Uznaj to za załatwione.",shape=box,color=blue];
		j4086113507 -> j3293285998;
	j3388637702 [label="Możesz uznać sprawę Marii jej chorej adoracji Entratiego za rozwiązaną, Uzurpatorze. Kiedy nadejdzie pora, zajmę się tym.",shape=box,color=blue];
		j3388637702 -> j2836917187;
	j4154255487 [label="Możesz uznać sprawę Leona i jego koszmarów za rozwiązaną, Uzurpatorze. Kiedy nadejdzie pora, zajmę się tym.",shape=box,color=blue];
		j4154255487 -> j2385754392;
	j2115194585 [label="Wydaje się... że znowu zapomniałem, jaki był twój cel. Obwiniam twoje mieszanie w moich wspomnieniach. O co ci chodziło?",shape=box,color=blue];
		j2115194585 -> j2953660143;
	j3889797300 [label="Zaleciłbym uzbroić się w cierpliwość, ale... nie byłoby w moim stylu sugerować dłuto, kiedy zaraz obok leży kilof laserowy.",shape=box,color=blue];
		j3889797300 -> j4136617300;
	j1159416484 [label="Hmm, rozumiem. Szlachetne przedsięwzięcie, szczerze mówiąc. Przedsięwzięcie, którego sam wielokrotnie się podejmowałem. I równie wiele razy poniosłem porażkę.",shape=box,color=blue];
		j1159416484 -> j3720641277;
	j1265454223 [label="Hm.",shape=box,color=blue];
		j1265454223 -> j2379225314;
	j3514592447 [label="W Leonie.",shape=box,color=red];
		j3514592447 -> j1971187222;
	j3302289106 [label="...w tobie.",shape=box,color=red];
		j3302289106 -> j2878655816;
	j1320466121 [label="W Marii.",shape=box,color=red];
		j1320466121 -> j3344387463;
	j2688970177 [label="Hmm, rozumiem. Zaoferowałem ci umowę, a ty nie wywiązałeś się ze swojej części, a twoja nagroda zniknęła z horyzontu.",shape=box,color=blue];
		j2688970177 -> j3595028549;
	j807449945 [label="Kiedy już przemówi, zazwyczaj rezultatem jest jedno z dwóch, coś przerażająco bezsensownego lub przerażająco szalonego.",shape=box,color=blue];
		j807449945 -> j2594161211;
	j496450557 [label="Hm? Udało ci się tego uniknąć? Tak bardzo ci tego zazdroszczę. Jednak niedługo znajdziesz się w zasięgu rażenia, więc lepiej, żebyś otrzymał odpowiednią przestrogę.",shape=box,color=blue];
		j496450557 -> j987914847;
	j2214301362 [label="Mój biedny Włóczęgo. Czy zapomniałeś, jak surowo my, Orokin, odrzucaliśmy wszelkie inne bóstwa? Czciliśmy tylko siebie.",shape=box,color=blue];
		j2214301362 -> j2469692816;
	j3753625537 [label="Jak sobie życzysz. Ostrzegam cię, że tej decyzji nie da się cofnąć bez konsekwencji.",shape=box,color=blue];
		j3753625537 -> j4192810264;
	j4059875686 [label="Będziesz grzeczny i pomożesz mi zaprowadzić Loida na górę? Pogodzić rodzinę? Wtedy pomogę z twoimi wspomnieniami.",shape=box,color=red];
		j4059875686 -> j3872806205;
	j2014538080 [label="To nie znaczy, że nie masz wpływu. Po prostu niektóre sprawy wymagają więcej wysiłku.",shape=box,color=red];
		j2014538080 -> j2209039873;
	j1505909917 [label="Mam nadzieję, że cię to nie denerwuje.",shape=box,color=red];
		j1505909917 -> j3457612095;
	j387725644 [label="Czy naprawdę gonimy za własnymi ogonami, niczym dworzanie uwięzieni w tańcu?",shape=box,color=blue];
		j387725644 -> j2014538080;
		j387725644 -> j1505909917;
	j3584753829 [label="Nie tak dawno temu powierzyłem ci straszną prawdę. Teraz nie pamiętam dlaczego.",shape=box,color=blue];
		j3584753829 -> j2677531241;
	j3293285998 [label="Boolean RoatheFamilyDealNo is now false.",color=orange];
		j3293285998 -> j325229360;
