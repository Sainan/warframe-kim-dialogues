	793 [label="Ha! Przygotuję dla ciebie listę! Pokaźną, a jednak pozbawioną szczegółów, zawsze oscylującą między nieopisanymi aktami niegodziwości, a niepojętą demoralizacją!",shape=box,color=blue];
		793 -> 792;
	794 [label="Update boolean RoatheKnowsReset2",color=orange];
		794 -> 806;
	795 [label="Jesteś zbyt wściekły. W tej chwili jesteś przekonany, że wybrałeś wyjście tchórza, ale nie pamiętasz niczego z tego, co doprowadziło do tego momentu.",shape=box,color=red];
		795 -> 807;
	796 [label="Już raz mi zaufałeś i opowiedziałeś swoje historie – ale teraz mi nie ufasz. Więc rozmowy, które powinniśmy przeprowadzić? Nie odbędą się.",shape=box,color=red];
		796 -> 808;
