		800 -> 812;
	799 [label="To może być trudne. Czy Leon prosił o cokolwiek innego, co miałbym załatwić dla... niego?",shape=box,color=red];
		799 -> 811;
	801 [label="Nie wiesz, jak to jest, kiedy ci fanatycy wiszą ci nad uchem o każdej porze, krzyczą i prawią ci wykłady na temat tego, że musisz odpokutować.",shape=box,color=blue];
		801 -> 758;
		801 -> 759;
		801 -> 760;
		801 -> 761;
	802 [label="Wiem, że jesteśmy u kresu sił, czuję, jak mój umysł walczy ze mną. Robisz wszystko, co w twojej mocy, żeby pomóc mi odzyskać pamięć. I za to jestem ci wdzięczny.",shape=box,color=blue];
		802 -> 813;
	803 [label="Dopiero zaczęliśmy odsłaniać najdrobniejsze szczątki tego, co było przede mną ukryte. Nie wiem, co Albrecht powiedział im o moich zbrodniach, Włóczęgo.",shape=box,color=blue];
		803 -> 814;
	804 [label="Dopiero zaczęliśmy przedzierać do tego, co zostało przede mną ukryte. Nie wiem, co Albrecht powiedział im o moich zbrodniach, Włóczęgo.",shape=box,color=blue];
		804 -> 814;
	805 [label="Nie wiem, co Albrecht powiedział im o moich zbrodniach, bo są one ukryte nawet przede mną. Prawda jest ukryta w moich wspomnieniach, Włóczęgo.",shape=box,color=blue];
		805 -> 814;
	806 [label="Nie tak dawno temu powierzyłem ci straszną prawdę. Teraz nie pamiętam dlaczego.",shape=box,color=blue];
		806 -> 815;
	807 [label="Wiem, że pod powierzchnią jesteś, cóż, szalejącym piekłem. I wiem, że musimy osiągnąć pewien poziom, zanim będziemy mogli o tym porozmawiać.",shape=box,color=red];
		807 -> 816;
	808 [label="A dlaczego mi ufasz? Wiesz o mnie tylko tyle, że... manipulowałem twoją pamięcią.",shape=box,color=red];
		808 -> 817;
	809 [label="Update boolean RoatheKnowsReset2",color=orange];
		809 -> 818;
	810 [label="No cóż, skoro nie zamierzasz być nudziarzem, Włóczęgo, to po co miałbym tracić na ciebie czas? Mam już na głowie fanatyków, z którymi najwyraźniej mam obowiązek spędzać czas.",shape=box,color=blue];
		810 -> 819;
	812 [label="Ha, a więc powiedziała ci. Oczywiście, że się wygadała. Czy możesz mnie obwiniać? Te przeklęte słodycze były jedynym dobrem w tej zapyziałej dziurze.",shape=box,color=blue];
		812 -> 821;
		812 -> 822;
	811 [label="+5 Chemistry",color=orange];
		811 -> 820;
	813 [label="Muszę wiedzieć, co zostało mi odebrane, Włóczęgo. Muszę wiedzieć, z czego mnie okradł Albrecht, wciskając mi to serum.",shape=box,color=blue];
		813 -> 823;
		813 -> 824;
	814 [label="Muszę wiedzieć, z czego okradł mnie Albrecht, wciskając mi to serum. Muszę wiedzieć, co skrywa się w mojej głowie, Włóczęgo. Jeśli nie jest to dla ciebie zbyt duży problem...",shape=box,color=blue];
		814 -> 825;
		814 -> 826;
	815 [label="Jesteś zarazem pierwszą duszą, której kiedykolwiek chciałem zaufać... i powodem, dla którego teraz nie mogę sobie przypomnieć, dlaczego się na to odważyłem.",shape=box,color=blue];
		815 -> 827;
	816 [label="A dlaczego miałbym się złościć, Włóczęgo?",shape=box,color=blue];
		816 -> 828;
		816 -> 829;
		816 -> 830;
	817 [label="\"Manipulowałeś moją pamięcią\". Jakbym był jakąś rzeźbą Ayatan, którą bawiłeś się dla zabawy. Zrobiłeś znacznie więcej, niż \"manipulowałeś\". Ty wszystkiego się pozbyłeś.",shape=box,color=blue];
		817 -> 831;
