		769 -> 785;
	770 [label="I co ważniejsze - dopilnuję, abyś tym razem zdołał związać się ze swoim ukochanym Ojcem Leonem Allardem, bez względu na wszystko.",shape=box,color=blue];
		770 -> 786;
	771 [label="I co ważniejsze - dopilnuję, że osiągniesz swój cel zjednoczenia nas, gdy nadejdzie właściwy moment... i nie mogę się tego doczekać.",shape=box,color=blue];
		771 -> 787;
	772 [label="I co ważniejsze - dopilnuję, abyś tym razem zdołał związać się ze swoją ukochaną \"małą Marią\", bez względu na wszystko.",shape=box,color=blue];
		772 -> 788;
	774 [label="Nie, dlaczego miałbym? Słyszałem, że Leon uwielbia te dziwne czekoladki z jego czasu. Pomagają uspokoić jego wizje.",shape=box,color=blue];
		774 -> 789;
	775 [label="Czekolada. Przekupisz go czekoladą, Uzurpatorze. Słyszałem, że pomagają uspokoić jego wizje.",shape=box,color=blue];
		775 -> 789;
	776 [label="Słyszałem, że w jego czasach panował zwyczaj obdarowywania wielebnych czekoladą. Słyszałem też, że pomagają uspokoić jego wizje.",shape=box,color=blue];
		776 -> 789;
	777 [label="Zastanów się, jeśli chcesz – czy potrafi spojrzeć prawdzie prosto w oczy i odrzucić ją dla Albrechta? Jest zdolna zrobić to samo z o wiele groźniejszymi rzeczami.",shape=box,color=blue];
		777 -> 790;
