	842 [label="Update boolean RoatheKnowsReset2",color=orange];
		842 -> 851;
	843 [label="Jakież to słodkie! Zupełnie nie jestem zaskoczony! Jaką robi mi różnicę, czy to kłamstwo czy nie?! Poza tym-",shape=box,color=blue];
		843 -> 844;
	844 [label="Mylisz się! Jesteś w błędzie tak mocno zapierającym dech! Nie wychodź z naiwnego przeświadczenia, że jesteś w stanie pojąć zawiłości mojej wściekłości, której tak bardzo nie rozumiesz.",shape=box,color=blue];
		844 -> 746;
	845 [label="Jak śmiesz wmawiać mi, co w moim umyśle jest wartościowe a co nie, Włóczęgo? To nie jest twoja własność.",shape=box,color=blue];
		845 -> 746;
	847 [label="Ludziom tak łatwo przeoczyć tych, których nie chcą dostrzec. Poza tym, jako \"protoframe\" i elita wyszkolonych w boju Orokin, myślę, że jestem w stanie ukraść ciastka z targu, nie dając się przyłapać.",shape=box,color=blue];
		847 -> 852;
	848 [label="Tak, z niebieską skórą, ogonem, okrywającą mnie plagą i całą resztą. To niesamowite, ile potrafią zdziałać płaszcz, kapelusz i maska.",shape=box,color=blue];
		848 -> 852;
