		718 -> 733;
	719 [label="Po pierwsze: jestem pod wrażeniem! Odebrałeś nam wszystkim pamięć, tylko po to, żeby mieć kolejną szansę zawalczyć o jego względy?!",shape=box,color=blue];
		719 -> 734;
	720 [label="Po pierwsze: to takie wspaniałe! Odebrałeś nam wszystkim pamięć, tylko po to, żeby mieć kolejną szansę zawalczyć o moje względy?!",shape=box,color=blue];
		720 -> 735;
	721 [label="Po pierwsze: jestem pod wrażeniem! Odebrałeś nam wszystkim pamięć, tylko po to, żeby mieć kolejną szansę zawalczyć o jej względy?!",shape=box,color=blue];
