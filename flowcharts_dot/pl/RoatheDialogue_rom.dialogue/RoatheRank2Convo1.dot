	j3565588625 [label="Jak idą sprawy z naszą małą lotną sykofantką? Zgaduję, że ksiądz nadal się do ciebie nie odzywa.",shape=box,color=blue];
		j3565588625 -> j2967240575;
		j3565588625 -> j1405549385;
		j3565588625 -> j1759946622;
	j1483193190 [label="Powiedz mi, czy zmieniłeś zdanie? To twoja ostatnia szansa, Uzurpatorze. Jestem cierpliwym diabłem, ale nie lubię, gdy ktoś każe mi trzymać drzwi otwarte zbyt długo.",shape=box,color=blue];
		j1483193190 -> j736037539;
		j1483193190 -> j431338903;
	j301363615 [label="Póki co dogaduję się z Marią całkiem dobrze.",shape=box,color=red];
		j301363615 -> j249655318;
	j890863087 [label="Nie, ale zmieni zdanie.",shape=box,color=red];
		j890863087 -> j995317280;
	j3758566912 [label="Chyba się z nimi nie polubiłeś. Dlaczego?",shape=box,color=red];
		j3758566912 -> j3369863461;
	j1266367698 [label="Jak wolisz. Ale ostrzegam, że to była twoja ostatnia szansa. Jesteś zdany na siebie.",shape=box,color=blue];
		j1266367698 -> j650476071;
	j1876832257 [label="Evaluate expressions",color=orange];
