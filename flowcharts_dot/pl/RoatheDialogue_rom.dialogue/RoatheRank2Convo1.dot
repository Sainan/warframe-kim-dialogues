	856 [label="Ale czy przyniosłeś wystarczająco dla Marii i Leona?",shape=box,color=red];
		856 -> 858;
	857 [label="Więc po prostu ukradłeś ciastka.",shape=box,color=red];
		857 -> 859;
	858 [label="Ach. Czego się po mnie spodziewałeś? Zabrać dość dla siebie i ani więcej? Dlaczego? To, że nie lubię ich towarzystwa, nie znaczy, że chcę się ich pozbyć?",shape=box,color=blue];
		858 -> 860;
	859 [label="Wszystko na tej planecie i tak wkrótce stałoby się własnością Imperium Orokin. Miałem takie prawo.",shape=box,color=blue];
		859 -> 861;
	860 [label="Oczekujesz, że moja niechęć do nich musi prowadzić do okrucieństwa. Jestem diabłem i ma to leżeć w mojej naturze, tak wygląda ten tok rozumowania.",shape=box,color=blue];
		860 -> 862;
	861 [label="Poza tym nie miałem pieniędzy. Co innego mogłem zrobić?",shape=box,color=blue];
		861 -> 863;
	862 [label="Jakież to okropne rozczarowujące. Takie płytkie zachowania są zarezerwowane dla wyjątkowo nudnych i szkolnych łobuzów. ",shape=box,color=blue];
		862 -> 864;
	863 [label="Wiem, że przedzierasz się przez statki i zabierasz, cokolwiek potrzebujesz lub chcesz, nie zgrywaj przede mną niewiniątka, Uzurpatorze.",shape=box,color=blue];
		863 -> 865;
		863 -> 866;
	864 [label="Nienawidzę ich. A jednak muszę z nimi współistnieć. Nie chcę odbierać jej tej prostej przyjemności. To tylko ciastko. Po co tak niepotrzebnie pogarszać sytuację?",shape=box,color=blue];
		864 -> 867;
		864 -> 868;
		864 -> 869;
	865 [label="Nieważne. ",shape=box,color=red];
		865 -> 870;
	866 [label="Chyba masz rację.",shape=box,color=red];
		866 -> 871;
	867 [label="Albo mógłbyś być dla nich po prostu miły.",shape=box,color=red];
		867 -> 872;
	868 [label="Żeby była jasność, nienawidzisz ich, więc jesteś dla nich miły.",shape=box,color=red];
		868 -> 873;
	869 [label="Nigdy o tym tak nie myślałem.",shape=box,color=red];
		869 -> 874;
	870 [label="Fantastycznie. Kolejny, który nie potrafi przyznać się do winy. Jakby nie wystarczyło już tych fanatyków, którzy wrzeszczą na mnie o każdej porze, nalegając, bym odpokutował.",shape=box,color=blue];
		870 -> 758;
		870 -> 759;
		870 -> 760;
		870 -> 761;
	871 [label="+5 Chemistry",color=orange];
		871 -> 875;
	872 [label="Tak, powinieneś przekonać się jak to jest, kiedy wiszą ci nad uchem każdego dnia i nocy, przeklinając twoje imię i lamentując, byś odpokutował.",shape=box,color=blue];
		872 -> 758;
		872 -> 759;
		872 -> 760;
		872 -> 761;
	873 [label="Dokładnie. Co jest takiego trudnego do zrozumienia? Widzę, że jesteś sarkastyczny, Uzurpatorze. Ale nie martw się, to mnie bawi.",shape=box,color=blue];
		873 -> 876;
	874 [label="+5 Chemistry",color=orange];
		874 -> 877;
	875 [label="Dziękuję. Nareszcie ktoś, kto potrafi pogodzić się z prawdą! Gdyby tylko ci dwaj fanatycy potrafili zrobić to samo, nie darliby się na mnie o każdej porze dnia i nocy, nalegając na moją pokutę.",shape=box,color=blue];
		875 -> 758;
		875 -> 759;
		875 -> 760;
		875 -> 761;
	876 [label="To jest co najmniej lepsze od zjełczałego, niekończącego się kazania fanatyków, którzy ciągle przeklinają i krzyczą, żebym odpokutował.",shape=box,color=blue];
		876 -> 758;
		876 -> 759;
		876 -> 760;
		876 -> 761;
	877 [label="Proszę bardzo. Co za ulga mieć kogoś, kto potrafi pogodzić się z prawdą. Gdyby tylko ci dwaj fanatycy potrafili zrobić to samo, nie darliby się na mnie o każdej porze dnia i nocy, nalegając na moją pokutę.",shape=box,color=blue];
		877 -> 758;
		877 -> 759;
		877 -> 760;
		877 -> 761;
}