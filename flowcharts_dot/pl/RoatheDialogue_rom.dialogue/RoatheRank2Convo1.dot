		633 -> 653 [label="RoatheLyonConfessionDealNo",color=purple];
		633 -> 648 [label="false",color=purple];
	634 [label="Leon... boryka się z tyloma problemami. Nie wiem, jak do niego dotrzeć.",shape=box,color=red];
		634 -> 656;
	635 [label="Maria nie dostrzega, kim naprawdę był Entrati. Nie ważne, co robię, nie mogę sprawić, by ujrzała prawdę.",shape=box,color=red];
		635 -> 657;
	636 [label="Widzisz, jest ta cała sprawa... o tym, dlaczego przyjąłeś serum, a ja... powiedziałem złe rzeczy w niewłaściwych chwilach.",shape=box,color=red];
		636 -> 658;
	637 [label="Wstydzę się to przyznać, ale... zakochałem się w kimś z waszej trójki.",shape=box,color=red];
		637 -> 659;
		637 -> 660;
		637 -> 661;
	638 [label="Próbuję przekonać ciebie i resztę, żebyście pomogli mi zjednoczyć Loida z rodziną na górze, a ja... nie mogłem...",shape=box,color=red];
		638 -> 662;
	641 [label="Nie, Leon... nie jest zbyt rozmowny.",shape=box,color=red];
		641 -> 665;
	642 [label="Dogaduję się z Marią. Dlaczego nazywasz ją sykofantką?",shape=box,color=red];
		642 -> 666;
	643 [label="Chyba się z nimi nie polubiłeś. Dlaczego?",shape=box,color=red];
		643 -> 667;
	639 [label="Nie. Przykro mi, ale nie robię układów z Orokin. Ani wtedy, ani teraz.",shape=box,color=red];
		639 -> 663;
	640 [label="Mam nadzieję, że tego nie pożałuję. Roathe, zgadzam się. Przyjmę twoją pomoc.",shape=box,color=red];
		640 -> 664;
	644 [label="\"Póki co\". Interesujące. Czy naprawdę gonimy za własnymi ogonami, niczym dworzanie uwięzieni w tańcu? Znów i znów powtarzamy te same ruchy, póki muzyka gra?",shape=box,color=blue];
		644 -> 668;
		644 -> 669;
	645 [label="Ty wiesz najlepiej, prawda? Niesamowite, jakie to przewidywalne. Dobrze wiedzieć, że można polegać nawet na kimś tak zdruzgotanym jak on.",shape=box,color=blue];
		645 -> 670;
	646 [label="Jeszcze nie wiesz? Hmm. Może jeszcze tak daleko nie zaszliśmy. Albo nie przeszło ci przez myśl, żeby o to zapytać przez ostatnie tysiąc prób.",shape=box,color=blue];
		646 -> 670;
	647 [label="Och, i jeszcze jedno, zanim zapomnę?",shape=box,color=blue];
		647 -> 671;
	649 [label="Naprawdę zaprzedałeś swoją duszę diabłu już drugi raz... żeby mieć pewność, że zaciągnę cię do swojego łoża? Chodzi ci o moje serce, Uzurpatorze? Hmm. Zobaczymy, w swoim czasie.",shape=box,color=blue];
		649 -> 672;
	650 [label="Kiedy nadejdzie właściwy czas, zapewnię ci prostą drogę do serca naszej małej lotnej sykofantki, Uzurpatorze. Uznaj to za załatwione.",shape=box,color=blue];
		650 -> 673;
	651 [label="Kiedy nadejdzie właściwy czas, zapewnię ci prostą drogę do serca naszego zbolałego księdza, Uzurpatorze. Uznaj to za załatwione.",shape=box,color=blue];
		651 -> 674;
	652 [label="Będę o tym pamiętać, kiedy nadejdzie czas. Jeśli znów poróżnimy się w sprawie moich wspomnień, nie powtórzymy twoich wcześniejszych błędów.",shape=box,color=blue];
		652 -> 675;
	655 [label="Kiedy nadejdzie właściwy czas, zapewnię, że ten mały sługa wejdzie po schodach. Uznaj to za załatwione.",shape=box,color=blue];
		655 -> 678;
	654 [label="Możesz uznać sprawę Marii jej chorej adoracji Entratiego za rozwiązaną, Uzurpatorze. Kiedy nadejdzie pora, zajmę się tym.",shape=box,color=blue];
		654 -> 677;
	653 [label="Możesz uznać sprawę Leona i jego koszmarów za rozwiązaną, Uzurpatorze. Kiedy nadejdzie pora, zajmę się tym.",shape=box,color=blue];
		653 -> 676;
	648 [label="Wydaje się... że znowu zapomniałem, jaki był twój cel. Obwiniam twoje mieszanie w moich wspomnieniach. O co ci chodziło?",shape=box,color=blue];
		648 -> 626;
	656 [label="Zaleciłbym uzbroić się w cierpliwość, ale... nie byłoby w moim stylu sugerować dłuto, kiedy zaraz obok leży kilof laserowy.",shape=box,color=blue];
		656 -> 679;
	657 [label="Hmm, rozumiem. Szlachetne przedsięwzięcie, szczerze mówiąc. Przedsięwzięcie, którego sam wielokrotnie się podejmowałem. I równie wiele razy poniosłem porażkę.",shape=box,color=blue];
		657 -> 680;
	658 [label="Hm.",shape=box,color=blue];
		658 -> 681;
	659 [label="W Leonie.",shape=box,color=red];
		659 -> 682;
	660 [label="...w tobie.",shape=box,color=red];
		660 -> 683;
	661 [label="W Marii.",shape=box,color=red];
		661 -> 684;
	662 [label="Hmm, rozumiem. Zaoferowałem ci umowę, a ty nie wywiązałeś się ze swojej części, a twoja nagroda zniknęła z horyzontu.",shape=box,color=blue];
		662 -> 685;
	665 [label="Kiedy już przemówi, zazwyczaj rezultatem jest jedno z dwóch, coś przerażająco bezsensownego lub przerażająco szalonego.",shape=box,color=blue];
		665 -> 688;
	666 [label="Hm? Udało ci się tego uniknąć? Tak bardzo ci tego zazdroszczę. Jednak niedługo znajdziesz się w zasięgu rażenia, więc lepiej, żebyś otrzymał odpowiednią przestrogę.",shape=box,color=blue];
		666 -> 689;
	667 [label="Mój biedny Włóczęgo. Czy zapomniałeś, jak surowo my, Orokin, odrzucaliśmy wszelkie inne bóstwa? Czciliśmy tylko siebie.",shape=box,color=blue];
		667 -> 690;
	663 [label="Jak sobie życzysz. Ostrzegam cię, że tej decyzji nie da się cofnąć bez konsekwencji.",shape=box,color=blue];
		663 -> 686;
	664 [label="Będziesz grzeczny i pomożesz mi zaprowadzić Loida na górę? Pogodzić rodzinę? Wtedy pomogę z twoimi wspomnieniami.",shape=box,color=red];
		664 -> 687;
	668 [label="To nie znaczy, że nie masz wpływu. Po prostu niektóre sprawy wymagają więcej wysiłku.",shape=box,color=red];
		668 -> 691;
	669 [label="Mam nadzieję, że cię to nie denerwuje.",shape=box,color=red];
		669 -> 692;
	670 [label="Czy naprawdę gonimy za własnymi ogonami, niczym dworzanie uwięzieni w tańcu?",shape=box,color=blue];
		670 -> 668;
		670 -> 669;
	671 [label="Nie tak dawno temu powierzyłem ci straszną prawdę. Teraz nie pamiętam dlaczego.",shape=box,color=blue];
		671 -> 693;
	672 [label="Update boolean RoatheFamilyDealNo",color=orange];
		672 -> 694;
