		607 -> 618 [label="false",color=purple];
	609 [label="Uważam to za niezwykle fascynujące, że uknułeś ze mną... plan, który pozwoli mi obrać własną drogę. Diabeł postawił własne ciało na szali, że tak powiem.",shape=box,color=blue];
		609 -> 619;
	608 [label="Jak wyglądają twoje postępy, mój Uzurpatorze? Usilnie pracuję za kulisami na twoją korzyść, choć moje wpływy mogą pozostawać niewidoczne i nieodczuwalne.",shape=box,color=blue];
		608 -> 619;
	610 [label="Powiedz mi, czy zmieniłeś zdanie? Wcześniej mogłem stanowić przeszkodę w twoich... miłosnych rozterkach. Teraz będę spokojny niczym śnieżny terrisk. Chyba że oczekujesz czegoś innego. Decyzja należy do ciebie.",shape=box,color=blue];
		610 -> 620;
	611 [label="Powiedz mi, czy zmieniłeś zdanie? Mogę rozwiązać za ciebie problem z Marią. Zapewnić, że z łatwością osiągniesz swoje romantyczne cele.",shape=box,color=blue];
		611 -> 620;
	612 [label="Powiedz mi, czy zmieniłeś zdanie? Mogę rozwiązać za ciebie problem z Leonem. Zapewnić, że z łatwością osiągniesz swoje romantyczne cele.",shape=box,color=blue];
		612 -> 620;
	613 [label="Powiedz mi, czy zmieniłeś zdanie? Wcześniej mogłem stanowić przeszkodę w sprawie... przyjęcia przeze mnie serum. Teraz będę spokojny niczym śnieżny terrisk.",shape=box,color=blue];
		613 -> 620;
	614 [label="Powiedz mi, czy zmieniłeś zdanie? Wcześniej mogłem stanowić przeszkodę w sprawie... zjednoczenia sługi i rodziny. Teraz będę spokojny niczym śnieżny terrisk.",shape=box,color=blue];
		614 -> 620;
	615 [label="Powiedz mi, czy zmieniłeś zdanie? Mogę rozwiązać za ciebie problem z Marią. Zapewnić, że z łatwością osiągniesz z nią porozumienie.",shape=box,color=blue];
		615 -> 620;
	616 [label="Powiedz mi, czy zmieniłeś zdanie? Mogę rozwiązać za ciebie problem z Leonem. Zapewnić, że z łatwością osiągniesz z nim porozumienie.",shape=box,color=blue];
		616 -> 620;
	617 [label="Nie mogę się oprzeć wrażeniu, że nie bez powodu przeciągasz nasze rozmowy, Uzurpatorze. I że być może mogę ci w czymś pomóc.",shape=box,color=blue];
		617 -> 621;
	618 [label="Evaluate expressions on HellStory",color=orange];
		618 -> 606 [label="x >= 21",color=purple];
		618 -> 622 [label="x < 21",color=purple];
		618 -> 622 [label="false",color=purple];
	619 [label="Z mojej strony to nietypowe wyzwanie, działać mając dostęp tylko do części moich wspomnień, wiedząc, że resztę trzymasz niczym talię kart.",shape=box,color=blue];
		619 -> 623;
	620 [label="Ale... całe te gierki, w które pogrywasz? Strata czasu. Wystarczy słowo, a twój problem zostanie rozwiązany.",shape=box,color=blue];
		620 -> 624;
		620 -> 625;
	621 [label="Powiedz mi, czego pragniesz, a dojdziemy do porozumienia. Te... gierki, to tylko strata czasu.",shape=box,color=blue];
		621 -> 626;
	622 [label="Evaluate expressions",color=orange];
		622 -> 628 [label="RoatheDeal",color=purple];
		622 -> 627 [label="RoatheNoDeal",color=purple];
		622 -> 627 [label="false",color=purple];
	623 [label="Więc z braku lepszych alternatyw, będę po prostu brnąć dalej. \"Jak się ma nasza mała lotna sykofantka? Ksiądz chyba z tobą nie rozmawia.\" Tfu. Co za farsa.",shape=box,color=blue];
		623 -> 629;
		623 -> 630;
		623 -> 631;
	624 [label="Nie. Przykro mi, ale nie robię układów z Orokin. Ani wtedy, ani teraz.",shape=box,color=red];
		624 -> 632;
	625 [label="Mam nadzieję, że tego nie pożałuję. Roathe, zgadzam się. Przyjmę twoją pomoc.",shape=box,color=red];
		625 -> 633;
	626 [label="Check boolean LoidFamilyComplete",color=orange];
		626 -> 634 [label=true,color=green];
		626 -> 635 [label=true,color=green];
		626 -> 636 [label=true,color=green];
		626 -> 637 [label=true,color=green];
		626 -> 634 [label=false,color=brown];
		626 -> 635 [label=false,color=brown];
		626 -> 636 [label=false,color=brown];
		626 -> 637 [label=false,color=brown];
		626 -> 638 [label=false,color=brown];
	628 [label="Jak idą sprawy z naszą małą lotną sykofantką? Zgaduję, że ksiądz nadal się do ciebie nie odzywa.",shape=box,color=blue];
		628 -> 641;
		628 -> 642;
		628 -> 643;
	627 [label="Powiedz mi, czy zmieniłeś zdanie? To twoja ostatnia szansa, Uzurpatorze. Jestem cierpliwym diabłem, ale nie lubię, gdy ktoś każe mi trzymać drzwi otwarte zbyt długo.",shape=box,color=blue];
		627 -> 639;
		627 -> 640;
	629 [label="Póki co dogaduję się z Marią całkiem dobrze.",shape=box,color=red];
		629 -> 644;
	630 [label="Nie, ale zmieni zdanie.",shape=box,color=red];
		630 -> 645;
	631 [label="Chyba się z nimi nie polubiłeś. Dlaczego?",shape=box,color=red];
		631 -> 646;
	632 [label="Jak wolisz. Ale ostrzegam, że to była twoja ostatnia szansa. Jesteś zdany na siebie.",shape=box,color=blue];
		632 -> 647;
	633 [label="Evaluate expressions",color=orange];
		633 -> 649 [label="RoatheDatingDealNo",color=purple];
		633 -> 650 [label="RoatheMarieDatingDealNo",color=purple];
		633 -> 651 [label="RoatheLyonDatingDealNo",color=purple];
		633 -> 652 [label="RoatheSerumDealNo",color=purple];
		633 -> 655 [label="RoatheFamilyDealNo",color=purple];
