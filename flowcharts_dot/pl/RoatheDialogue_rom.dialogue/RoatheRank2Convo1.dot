		827 -> 842;
	828 [label="Mówiłeś, że nie gniewasz się na mnie, za wymazanie twoich wspomnień, ale wiem, że kłamiesz... to nie pierwszy raz, kiedy odbywamy tę rozmowę.",shape=box,color=red];
		828 -> 843;
	829 [label="Nienawidzisz samego siebie za dobrowolne przyjęcie tego serum. Nienawidzisz siebie i to doprowadza cię do furii, bo jesteś wszystkim, co ci zostało.",shape=box,color=red];
		829 -> 844;
	830 [label="Mówiłeś, że nie gniewasz się na mnie, za wymazanie twoich wspomnień, ale nie potrafię sobie wyobrazić, żeby tak było.",shape=box,color=red];
		830 -> 844;
