		706 -> 721;
	707 [label="To bardzo w stylu Orokin.",shape=box,color=blue];
		707 -> 722;
	710 [label="Żeby było zabawniej? Nadal wolę go od siostry. Do niego przynajmniej dociera głos rozsądku.",shape=box,color=blue];
		710 -> 724;
		710 -> 725;
	711 [label="Ona po prostu jest tak porażająco-mózg świętoszkowata.",shape=box,color=blue];
		711 -> 726;
		711 -> 727;
	712 [label="A muszę ci powiedzieć, że nadal ich używają w tej cholernej katedrze!",shape=box,color=blue];
		712 -> 728;
	708 [label="Ale cytując tę małą lotną sykofantkę? C'est la vie. A swoją drogą, jak ci z nią idzie? Zakładam, że ksiądz nadal się do ciebie nie odzywa.",shape=box,color=blue];
		708 -> 643;
		708 -> 642;
		708 -> 641;
	709 [label="Cieszę się, że się przekonałeś i w końcu możemy iść naprzód! Myślałem, że będziemy tkwić w błędnym kole przez wieki.",shape=box,color=blue];
		709 -> 723;
