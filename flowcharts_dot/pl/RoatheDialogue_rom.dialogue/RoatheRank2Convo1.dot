		831 -> 845;
	832 [label="Nie zapomniałeś wszystkiego, tylko nasze rozmowy w tym miejscu. Nadal pamiętasz całą resztę, w tym wszystko, co odzyskaliśmy w Descendii.",shape=box,color=red];
		832 -> 845;
	833 [label="Chat ends.",color=orange];
	834 [label="Chat ends.",color=orange];
	836 [label="Tak, z niebieską skórą, ogonem, okrywającą mnie plagą i całą resztą. To niesamowite, ile potrafią zdziałać płaszcz, kapelusz i maska.",shape=box,color=blue];
		836 -> 847;
	837 [label="To było całkiem proste. Poza tym, jako \"protoframe\" i elita wyszkolonych w boju Orokin, myślę, że jestem w stanie ukraść ciastka z targu, nie dając się przyłapać.",shape=box,color=blue];
		837 -> 848;
	835 [label="Zanim zapytasz, Maria zna tę opowieść najlepiej. Nie chciałbym narażać się na kolejne wrzaski i tyrady fanatyków.",shape=box,color=blue];
		835 -> 846;
	838 [label="Układy z diabłem... to niebezpieczna gra.",shape=box,color=blue];
