	j1428278778 [label="Uważam to za niezwykle fascynujące, że uknułeś ze mną... plan, który pozwoli mi obrać własną drogę. Diabeł postawił własne ciało na szali, że tak powiem.",shape=box,color=blue];
		j1428278778 -> j2891309795;
	j1808650963 [label="Jak wyglądają twoje postępy, mój Uzurpatorze? Usilnie pracuję za kulisami na twoją korzyść, choć moje wpływy mogą pozostawać niewidoczne i nieodczuwalne.",shape=box,color=blue];
		j1808650963 -> j2891309795;
	j1273069456 [label="Powiedz mi, czy zmieniłeś zdanie? Wcześniej mogłem stanowić przeszkodę w twoich... miłosnych rozterkach. Teraz będę spokojny niczym śnieżny terrisk. Chyba że oczekujesz czegoś innego. Decyzja należy do ciebie.",shape=box,color=blue];
		j1273069456 -> j1548183183;
	j3111562656 [label="Powiedz mi, czy zmieniłeś zdanie? Mogę rozwiązać za ciebie problem z Marią. Zapewnić, że z łatwością osiągniesz swoje romantyczne cele.",shape=box,color=blue];
		j3111562656 -> j1548183183;
	j3728180706 [label="Powiedz mi, czy zmieniłeś zdanie? Mogę rozwiązać za ciebie problem z Leonem. Zapewnić, że z łatwością osiągniesz swoje romantyczne cele.",shape=box,color=blue];
		j3728180706 -> j1548183183;
	j2035733423 [label="Powiedz mi, czy zmieniłeś zdanie? Wcześniej mogłem stanowić przeszkodę w sprawie... przyjęcia przeze mnie serum. Teraz będę spokojny niczym śnieżny terrisk.",shape=box,color=blue];
		j2035733423 -> j1548183183;
	j4052924497 [label="Powiedz mi, czy zmieniłeś zdanie? Wcześniej mogłem stanowić przeszkodę w sprawie... zjednoczenia sługi i rodziny. Teraz będę spokojny niczym śnieżny terrisk.",shape=box,color=blue];
		j4052924497 -> j1548183183;
	j1520450906 [label="Powiedz mi, czy zmieniłeś zdanie? Mogę rozwiązać za ciebie problem z Marią. Zapewnić, że z łatwością osiągniesz z nią porozumienie.",shape=box,color=blue];
		j1520450906 -> j1548183183;
	j1876992558 [label="Powiedz mi, czy zmieniłeś zdanie? Mogę rozwiązać za ciebie problem z Leonem. Zapewnić, że z łatwością osiągniesz z nim porozumienie.",shape=box,color=blue];
		j1876992558 -> j1548183183;
	j1721977114 [label="Nie mogę się oprzeć wrażeniu, że nie bez powodu przeciągasz nasze rozmowy, Uzurpatorze. I że być może mogę ci w czymś pomóc.",shape=box,color=blue];
		j1721977114 -> j150329555;
