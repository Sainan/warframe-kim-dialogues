		819 -> 834;
	821 [label="A więc to prawda. Wykradałeś się do Galicji, by kraść czekoladki? Wyglądając tak...?",shape=box,color=red];
		821 -> 836;
	822 [label="Jak dokładnie je zdobyłeś?",shape=box,color=red];
