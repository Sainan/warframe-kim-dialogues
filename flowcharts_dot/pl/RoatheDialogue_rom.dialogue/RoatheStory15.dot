	j1347395672 [label="VM: LIES",shape=box,color=blue];
		j1347395672 -> j2403219668;
	j2403219668 [label="Transkrypcja: Bez trudu władałem wieloma naszymi broniami, ale byłem mistrzem jednej: kłamstwa.",shape=box,color=blue];
		j2403219668 -> j1563925430;
	j1563925430 [label="I brandished it most often against my own troops. I whipped them to the bone with lies of duty and discipline.",shape=box,color=blue];
		j1563925430 -> j2376761423;
	j2376761423 [label="I smothered them with the lie that the war could be won. I pierced them with the lie of my favour, my most esteemed regard for them.",shape=box,color=blue];
		j2376761423 -> j3419007390;
	j3419007390 [label="Sam, w zaciszu, skierowałem tę broń przeciwko sobie. Och, jak krwawiłem.",shape=box,color=blue];
