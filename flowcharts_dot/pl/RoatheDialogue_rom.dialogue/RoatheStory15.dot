	j3846676650 [label="Transkrypcja: Bez trudu władałem wieloma naszymi broniami, ale byłem mistrzem jednej: kłamstwa.",shape=box,color=blue];
		j3846676650 -> j1121869394;
	j1121869394 [label="Najczęściej używałem go przeciwko własnym żołnierzom. Obalałem ich na kolana kłamstwami o obowiązku i dyscyplinie.",shape=box,color=blue];
		j1121869394 -> j2521191467;
	j2521191467 [label="Zduszałem ich kłamstwem, że wojnę można wygrać. Przebijałem ich kłamstwem o mojej przychylności, o moim najgłębszym szacunku dla nich.",shape=box,color=blue];
		j2521191467 -> j3419007390;
	j3419007390 [label="Sam, w zaciszu, skierowałem tę broń przeciwko sobie. Och, jak krwawiłem.",shape=box,color=blue];
