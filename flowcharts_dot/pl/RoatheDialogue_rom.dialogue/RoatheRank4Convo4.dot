		j2270866180 -> j3392871066;
	j78994774 [label="+5 Chemistry",color=orange];
		j78994774 -> j3707120791;
	j4181196810 [label="Brzmisz jak fanatycy. \"Odkupienie.\" Ale pukasz do drzwi prawdy. Bo sugerujesz, że te dwie rzeczy nie mogą istnieć jednocześnie w naszym świecie, i to prawda, prawda? Miłość i zło nie mogą współistnieć w społeczeństwie.",shape=box,color=blue];
		j4181196810 -> j603738447;
	j3488633389 [label="Jesteś blisko, ale nie do końca. Tak, ale pójdźmy o krok dalej. Co by to oznaczało, gdyby osoba zdolna do złych czynów wciąż była kochana przez inną? Co by to zrobiło ze społeczeństwem?",shape=box,color=blue];
		j3488633389 -> j603738447;
	j3392871066 [label="Dokładnie! Te dwie rzeczy nie chcą współistnieć w naszych umysłach, prawda? Kiedy opowiedziałem ci historię o Ballasie i Margulis, trudno było zaakceptować, że ich miłość do siebie kiedyś była prawdziwa, prawda?",shape=box,color=blue];
		j3392871066 -> j478496493;
	j3707120791 [label="Dokładnie! Te dwie rzeczy nie chcą współistnieć w naszych umysłach, prawda? Gdybym ci powiedział, że Ballas i Margulis byli kiedyś naprawdę zakochani, zanim wszystko poszło źle, uwierzyłbyś mi?",shape=box,color=blue];
		j3707120791 -> j478496493;
	j603738447 [label="Check boolean RoatheMargulis1",color=orange];
		j603738447 -> j2679980401 [label=true,color=green];
		j603738447 -> j1650038104 [label=false,color=brown];
	j478496493 [label="Bez wchodzenia w szczegóły i zbaczania z mojej zasady trzymania się czysto filozoficznych rozważań, mogę powiedzieć, że są wspólnym punktem odniesienia dla nas obu.",shape=box,color=blue];
		j478496493 -> j2724404731;
	j2679980401 [label="Kiedy opowiedziałem ci historię o Ballasie i Margulis, trudno było zaakceptować, że ich miłość do siebie kiedyś była prawdziwa, prawda?",shape=box,color=blue];
		j2679980401 -> j478496493;
	j1650038104 [label="Gdybym ci powiedział, że Ballas i Margulis byli kiedyś naprawdę zakochani, zanim wszystko poszło źle, uwierzyłbyś mi?",shape=box,color=blue];
		j1650038104 -> j478496493;
	j2724404731 [label="It goes without question that Ballas was capable of some of the most purest forms of cruelty that humanity has ever known. And yet, he knew love. Mutual love. ",shape=box,color=blue];
		j2724404731 -> j3213114441;
	j3213114441 [label="This is a fact, though you may wish to deny it now, Ballas and Margulis loved each other deeply. It simply went terribly wrong.",shape=box,color=blue];
		j3213114441 -> j3798587304;
	j3798587304 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j3798587304 -> j3240092553;
	j3240092553 [label="But we must scrub that story clean of their love. We must say it did not exist. We must say it was not real, that it was a fallacy. Why?",shape=box,color=blue];
		j3240092553 -> j399489803;
		j3240092553 -> j1159822422;
		j3240092553 -> j507728730;
	j399489803 [label="Nie wiem.",shape=box,color=red];
		j399489803 -> j2003590172;
	j1159822422 [label="Because love is the ultimate human emotion, and if we allow ourselves to think someone can be loved, it humanizes them.",shape=box,color=red];
		j1159822422 -> j2622051048;
	j507728730 [label="Because evil has to look into the mirror and work to change itself. It has to be punished. And to love and be loved is the ultimate reward.",shape=box,color=red];
		j507728730 -> j1974121557;
	j2003590172 [label="And I have done all this work for nothing. Shame.",shape=box,color=blue];
		j2003590172 -> "Chat ends.";
	j2622051048 [label="Add -2 to Thermostat counter",color=orange];
		j2622051048 -> j3922696401;
	j1974121557 [label="Add 2 to Thermostat counter",color=orange];
		j1974121557 -> j311210682;
	j3922696401 [label="Very good, Usurper. Very good. Exactly that. Great Evil must always be \"other\" and we must never, ever sympathize with it. If we allow it to feel love, and be loved? I think all the world might crumble around us.",shape=box,color=blue];
		j3922696401 -> j1310308097;
	j311210682 [label="Very good, Usurper. Very good. Exactly that. We must hold Great Evil to task. If we allow it to feel love, and be loved? I think all the world might crumble around us.",shape=box,color=blue];
		j311210682 -> j1310308097;
	j1310308097 [label="Boolean RoatheUnloved3 is now true.",color=orange];
		j1310308097 -> j224570002;
	j224570002 [label="And wherever would we be, then?",shape=box,color=blue];
		j224570002 -> "Chat ends.";
