digraph {
	2564 [label="RoatheRank4Convo4 begins.",color=orange];
		2564 -> 2565;
	2565 [label=" I have a philosophical question for you, Usurper. And before you leap to any conclusions about who I am referencing, be it myself, or Ballas, or Void forbid Albrecht, it is purely a thought experiment. Shall we play?",shape=box,color=blue];
		2565 -> 2566;
		2565 -> 2567;
		2565 -> 2568;
	2566 [label="Now I'm intrigued.",shape=box,color=red];
		2566 -> 2569;
	2567 [label="Sure. Ask away.",shape=box,color=red];
		2567 -> 2570;
	2568 [label="Nie jestem w nastroju. [Koniec]",shape=box,color=red];
		2568 -> 2571;
	2569 [label="+5 Chemistry",color=orange];
		2569 -> 2572;
	2570 [label="The question is simple, but vast: Do you believe that everyone deserves to be loved?",shape=box,color=blue];
		2570 -> 2573;
	2571 [label="Szkoda.",shape=box,color=blue];
		2571 -> 2574;
	2572 [label="Good! The question is simple, but vast: Do you believe that everyone deserves to be loved?",shape=box,color=blue];
		2572 -> 2573;
	2573 [label="Evaluate expressions",color=orange];
		2573 -> 2575 [label="RoatheMargulis1",color=purple];
		2573 -> 2578 [label="RoatheMargulis1",color=purple];
		2573 -> 2579 [label="RoatheMargulis1",color=purple];
		2573 -> 2576 [label="RoatheUnloved1",color=purple];
		2573 -> 2578 [label="RoatheUnloved1",color=purple];
		2573 -> 2579 [label="RoatheUnloved1",color=purple];
		2573 -> 2577 [label="RoatheExecutor1",color=purple];
		2573 -> 2577 [label="RoatheTraitor1",color=purple];
		2573 -> 2578 [label="RoatheTraitor1",color=purple];
		2573 -> 2579 [label="RoatheTraitor1",color=purple];
		2573 -> 2578 [label="false",color=purple];
		2573 -> 2579 [label="false",color=purple];
		2573 -> 2580 [label="false",color=purple];
	2574 [label="Chat ends.",color=orange];
	2575 [label="You're asking me this after telling me that story about Ballas and Margulis, and it's not about him?",shape=box,color=red];
		2575 -> 2581;
	2578 [label="After what Albrecht did to you, and all this \"can an Orokin be redeemed\" business, and it's not about him?",shape=box,color=red];
		2578 -> 2581;
	2579 [label="Okay, I'll play along. Do I believe that \"everyone deserves to be loved?\" Clearly this is a question about morality and value.",shape=box,color=red];
		2579 -> 2582;
	2576 [label="The Orokin who told me he has never known love just happens to ask me that question, and it's not about him?",shape=box,color=red];
		2576 -> 2581;
	2577 [label="The Orokin who served an Executor as her concubine but then schemed to betray her asks me this and it's not about him?",shape=box,color=red];
		2577 -> 2581;
	2580 [label="You really expect me to believe this is just a philosophical question?",shape=box,color=red];
		2580 -> 2581;
	2581 [label="I do not want to be caught up in the specifics. It drags the whole thing down into minutia. \"Well, you see, this person did this, and that person did that, which negates this,\" and then we are all on the stand in this little tentamen of ours.",shape=box,color=blue];
		2581 -> 2583;
		2581 -> 2584;
	2582 [label="+5 Chemistry",color=orange];
		2582 -> 2585;
	2583 [label="Either speak plainly, or don't speak at all. If you're not going to tell me who this is really about, then I'm not going to waste my time talking to you.",shape=box,color=red];
		2583 -> 2586;
	2584 [label="Fine. We'll play your little proverbial game.",shape=box,color=red];
		2584 -> 2587;
	2585 [label="Thank you! Removing the names from this little tentamen makes it all the more palatable. Otherwise you get caught up in the specifics and we will get nowhere.",shape=box,color=blue];
		2585 -> 2588;
	2586 [label="And neither shall I you, simple as that.",shape=box,color=blue];
		2586 -> 2589;
	2587 [label="Good. The question is as I stated it. Does everyone deserve to be loved?",shape=box,color=blue];
		2587 -> 2590;
	2588 [label="And yes, precisely. No one questions if the righteous hero deserves to love and be loved. That is never thrown up for debate in our great fables, is it?",shape=box,color=blue];
		2588 -> 2591;
	2589 [label="Update boolean RoatheNoDate",color=orange];
		2589 -> 2592;
	2590 [label="No one questions if the righteous hero deserves to love and be loved. That is never thrown up for debate in our great fables, is it?",shape=box,color=blue];
		2590 -> 2591;
	2591 [label="Only the Cur. The Villain. The Monster. The Morally Destitute Destroyer of Worlds.",shape=box,color=blue];
		2591 -> 2593;
		2591 -> 2594;
	2592 [label="Chat ends.",color=orange];
	2593 [label="[Let him continue.]",shape=box,color=red];
		2593 -> 2595;
	2594 [label="The Devil?",shape=box,color=red];
		2594 -> 2596;
	2595 [label="Add 1 to Thermostat",color=orange];
		2595 -> 2597;
	2596 [label="Play along, Usurper.",shape=box,color=blue];
		2596 -> 2598;
	2597 [label="I propose the following statement; that the only thing that makes these creatures morally outcast, is that they have others by which to morally outcast them.",shape=box,color=blue];
		2597 -> 2599;
	2598 [label="Add -1 to Thermostat",color=orange];
		2598 -> 2600;
		2598 -> 2601;
	2599 [label="If an individual were to commit \"evil deeds\" in a vacuum, as a single person without any others around to judge them, there would be no one to judge them evil, now would there?",shape=box,color=blue];
		2599 -> 2602;
	2600 [label="To znaczy...",shape=box,color=red];
		2600 -> 2603;
	2601 [label="Przepraszam.",shape=box,color=red];
		2601 -> 2603;
	2602 [label="If a bastard burns down a forest and no one is around to hear him, does it make a sound? The only measure we have to judge \"Good\" and \"Evil\" deeds are the deeds of others.",shape=box,color=blue];
		2602 -> 2604;
		2602 -> 2605;
		2602 -> 2606;
	2603 [label="But yes, since you insisted on bringing it up, The Devil! The ultimate of all evils!",shape=box,color=blue];
		2603 -> 2597;
	2604 [label="There have to be deeds that are evil purely on their own.",shape=box,color=red];
		2604 -> 2607;
	2605 [label="You're saying one person needs a second person to be \"evil?\"",shape=box,color=red];
		2605 -> 2608;
	2606 [label="I don't know if I agree with that.",shape=box,color=red];
		2606 -> 2607;
	2607 [label="All the most horrifying a person can commit require at least a second person to commit them. A single person, in a vacuum, can do nothing that is condemnable. Destroy an uninhabited planet? Oh, woe.",shape=box,color=blue];
		2607 -> 2609;
	2608 [label="Yes. Think about it. All the most horrifying a person can commit require at least a second person to commit them. A single person, in a vacuum, can do nothing that is condemnable. Destroy an uninhabited planet? Oh, woe.",shape=box,color=blue];
		2608 -> 2609;
	2609 [label="And without a society around to waggle their finger at them and say \"you should not have done that terrible deed,\" however would we know that act was so horrifying to begin with? We would not.",shape=box,color=blue];
		2609 -> 2610;
	2610 [label="It is merely a measuring stick used by society to judge your actions against those of others, as I said.",shape=box,color=blue];
		2610 -> 2611;
		2610 -> 2612;
	2611 [label="Say you're right. Say you've convinced me, and good and evil are just... social constructs. What then?",shape=box,color=red];
		2611 -> 2613;
	2612 [label="I do think actions can be good or evil outside of their social context. Otherwise, why would so many of them be similar across vastly different societies?",shape=box,color=red];
		2612 -> 2614;
	2613 [label="Add -1 to Thermostat",color=orange];
		2613 -> 2615;
	2614 [label="Add 1 to Thermostat",color=orange];
		2614 -> 2616;
		2614 -> 2617;
	2615 [label="+5 Chemistry",color=orange];
		2615 -> 2618;
	2616 [label="But for the sake of argument, keep going. ",shape=box,color=red];
		2616 -> 2615;
	2617 [label="It's probably best we stop here. I don't see this going well. [End.]",shape=box,color=red];
		2617 -> 2619;
	2618 [label="Very good. If we can say that \"evil\" is not a state of being but a social construct, then we can agree that all the tales of Great Villainy are therefore, in turn, social constructs. Fables.",shape=box,color=blue];
		2618 -> 2620;
	2619 [label="Jak sobie życzysz.",shape=box,color=blue];
		2619 -> 2621;
	2620 [label="Why is it then, that in all great fables, those who commit Greatest Evils are left to rot alone?",shape=box,color=blue];
		2620 -> 2622;
		2620 -> 2623;
		2620 -> 2624;
		2620 -> 2625;
	2621 [label="Chat ends.",color=orange];
	2622 [label="Because they are incapable of love?",shape=box,color=red];
		2622 -> 2626;
	2623 [label="Because they have no room in their heart for love?",shape=box,color=red];
		2623 -> 2627;
	2624 [label="Because they don't deserve to be loved?",shape=box,color=red];
		2624 -> 2628;
	2625 [label="Because we are trying to teach a lesson?",shape=box,color=red];
		2625 -> 2629;
	2626 [label="Sometimes, yes, they are shown to be some 
inhuman evil, incapable of love. But why? I would propose that all great fables exist to teach a lesson, do they not?",shape=box,color=blue];
		2626 -> 2630;
	2627 [label="Sometimes, yes, they are shown to be too preoccupied with their Great Evils to belittle themselves with such so-called \"Trivial Things.\" But why? All great fables exist to teach a lesson, do they not?",shape=box,color=blue];
		2627 -> 2630;
	2628 [label="Mm, now you are simply parroting my words back to me, Usurper. We have already decided that \"deserve\" is relative. Think. All great fables exist to teach a lesson, do they not?",shape=box,color=blue];
		2628 -> 2630;
	2629 [label="+5 Chemistry",color=orange];
		2629 -> 2631;
	2630 [label="And if we were to show a Great Evil living peacefully, happily, wonderfully in love... well... what kind of lesson would that teach?",shape=box,color=blue];
		2630 -> 2632;
		2630 -> 2633;
		2630 -> 2634;
	2631 [label="Such would be my theory, yes! All great fables exist to teach a lesson, do they not?",shape=box,color=blue];
		2631 -> 2630;
	2632 [label="It's hard to reconcile the fact that someone is \"evil\" and also capable of love.",shape=box,color=red];
		2632 -> 2635;
	2633 [label="That perhaps their \"evil deeds\" could still be redeemable through love?",shape=box,color=red];
		2633 -> 2636;
	2634 [label="That those who do \"evil things\" could still have value to someone else in this world, and therefore are not \"pure evil?\"",shape=box,color=red];
		2634 -> 2637;
	2635 [label="Check boolean RoatheMargulis1",color=orange];
		2635 -> 2638 [label=true,color=green];
		2635 -> 2639 [label=false,color=brown];
	2636 [label="Add 1 to Thermostat",color=orange];
		2636 -> 2640;
	2637 [label="Add -1 to Thermostat",color=orange];
		2637 -> 2641;
	2638 [label="+5 Chemistry",color=orange];
		2638 -> 2642;
	2639 [label="+5 Chemistry",color=orange];
		2639 -> 2643;
	2640 [label="You sound like the zealots. \"Redemption.\"  But you are knocking at the door of the truth. Because you are implying that the two cannot exist at the same time in our world, and that is true, isn't it? Love and evil cannot be allowed to co-exist in society.",shape=box,color=blue];
		2640 -> 2644;
	2641 [label="You are close but not quite there. Yes, but take it a step farther. What would it mean if a person who is capable of evil deeds were still to be loved by another? What would that do to society?",shape=box,color=blue];
		2641 -> 2644;
	2642 [label="Precisely! These two things do not want to live together in our minds, do they? When I told you the story of Ballas and Margulis, it was hard to accept that their love for each other was once real, wasn't it?",shape=box,color=blue];
		2642 -> 2645;
	2643 [label="Precisely! These two things do not want to live together in our minds, do they? If I were to tell you that Ballas and Margulis were once very much in love before it all went wrong, would you believe me?",shape=box,color=blue];
		2643 -> 2645;
	2644 [label="Check boolean RoatheMargulis1",color=orange];
		2644 -> 2646 [label=true,color=green];
		2644 -> 2647 [label=false,color=brown];
	2645 [label="Without delving into the specifics and veering too far from my own rule of keeping things purely philosophical - they are a common point of reference for us both.",shape=box,color=blue];
		2645 -> 2648;
	2646 [label="When I told you the story of Ballas and Margulis, it was hard to accept that their love for each other was once real, wasn't it?",shape=box,color=blue];
		2646 -> 2645;
	2647 [label="If I were to tell you that Ballas and Margulis were once very much in love before it all went wrong, would you believe me?",shape=box,color=blue];
		2647 -> 2645;
	2648 [label="It goes without question that Ballas was capable of some of the most purest forms of cruelty that humanity has ever known. And yet, he knew love. Mutual love. ",shape=box,color=blue];
		2648 -> 2649;
	2649 [label="This is a fact, though you may wish to deny it now, Ballas and Margulis loved each other deeply. It simply went terribly wrong.",shape=box,color=blue];
		2649 -> 2650;
	2650 [label="Update boolean RoatheMargulis1",color=orange];
		2650 -> 2651;
	2651 [label="But we must scrub that story clean of their love. We must say it did not exist. We must say it was not real, that it was a fallacy. Why?",shape=box,color=blue];
		2651 -> 2652;
		2651 -> 2653;
		2651 -> 2654;
	2652 [label="Nie wiem.",shape=box,color=red];
		2652 -> 2655;
	2653 [label="Because love is the ultimate human emotion, and if we allow ourselves to think someone can be loved, it humanizes them.",shape=box,color=red];
		2653 -> 2656;
	2654 [label="Because evil has to look into the mirror and work to change itself. It has to be punished. And to love and be loved is the ultimate reward.",shape=box,color=red];
		2654 -> 2657;
	2655 [label="And I have done all this work for nothing. Shame.",shape=box,color=blue];
		2655 -> 2658;
	2656 [label="Add -2 to Thermostat",color=orange];
		2656 -> 2659;
	2657 [label="Add 2 to Thermostat",color=orange];
		2657 -> 2660;
	2658 [label="Chat ends.",color=orange];
	2659 [label="Very good, Usurper. Very good. Exactly that. Great Evil must always be \"other\" and we must never, ever sympathize with it. If we allow it to feel love, and be loved? I think all the world might crumble around us.",shape=box,color=blue];
		2659 -> 2661;
	2660 [label="Very good, Usurper. Very good. Exactly that. We must hold Great Evil to task. If we allow it to feel love, and be loved? I think all the world might crumble around us.",shape=box,color=blue];
		2660 -> 2661;
	2661 [label="Update boolean RoatheUnloved3",color=orange];
		2661 -> 2662;
	2662 [label="And wherever would we be, then?",shape=box,color=blue];
		2662 -> 2663;
	2663 [label="Chat ends.",color=orange];
