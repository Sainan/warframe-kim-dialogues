	j3202128687 [label="Nie chcę się zagłębiać w szczegóły. To tylko komplikuje sprawę. \"Widzisz, ta osoba zrobiła to, a ta druga tamto, co przeczy temu\", i oto wszyscy tkwimy w martwym punkcie, nie mogąc iść naprzód.",shape=box,color=blue];
