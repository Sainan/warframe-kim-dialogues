	j2365245985 [label=" I have a philosophical question for you, Usurper. And before you leap to any conclusions about who I am referencing, be it myself, or Ballas, or Void forbid Albrecht, it is purely a thought experiment. Shall we play?",shape=box,color=blue];
		j2365245985 -> j2715069651;
		j2365245985 -> j2579497232;
		j2365245985 -> j2168497839;
	j2715069651 [label="Now I'm intrigued.",shape=box,color=red];
		j2715069651 -> j300334002;
	j2579497232 [label="Sure. Ask away.",shape=box,color=red];
		j2579497232 -> j3476542510;
