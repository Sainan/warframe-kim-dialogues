	j4181196810 [label="Brzmisz jak fanatycy. \"Odkupienie.\" Ale pukasz do drzwi prawdy. Bo sugerujesz, że te dwie rzeczy nie mogą istnieć jednocześnie w naszym świecie, i to prawda, prawda? Miłość i zło nie mogą współistnieć w społeczeństwie.",shape=box,color=blue];
