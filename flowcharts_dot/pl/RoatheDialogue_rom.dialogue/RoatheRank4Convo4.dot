	j4142325940 [label="Bardzo dobrze. Jeśli potraktujemy \"zło\" nie jako stan, ale jako konstrukt społeczny, to możemy przyznać, że wszystkie opowieści o wielkiej niegodziwości są z kolei konstruktami społecznymi. Bajkami.",shape=box,color=blue];
