		j2123756210 -> j125006431;
	j125006431 [label="Wszystkie najbardziej przerażające czyny, jakie człowiek może popełnić, wymagają przynajmniej zaangażowania innej osoby. Samotna jednostka, odizolowany od świata, nie jest w stanie zrobić nic, co mogłoby być potępione. Zniszczyć niezamieszkaną planetę? Cóż za tragedia.",shape=box,color=blue];
		j125006431 -> j4223824860;
	j651185120 [label="Tak. Pomyśl o tym. Wszystkie najbardziej przerażające czyny, jakie człowiek może popełnić, wymagają przynajmniej zaangażowania innej osoby. Samotna jednostka, odizolowany od świata, nie jest w stanie zrobić nic, co mogłoby być potępione. Zniszczyć niezamieszkaną planetę? Cóż za tragedia.",shape=box,color=blue];
		j651185120 -> j4223824860;
	j4223824860 [label="A bez społeczeństwa, które machałoby palcem i mówiło \"nie powinieneś był popełniać tego strasznego czynu\", jak mielibyśmy wiedzieć, że ten akt był w ogóle tak przerażający? Nie wiedzielibyśmy.",shape=box,color=blue];
		j4223824860 -> j1939375852;
	j1939375852 [label="To tylko miara, której społeczeństwo używa, by ocenić twoje czyny w porównaniu do działań innych, jak mówiłem.",shape=box,color=blue];
