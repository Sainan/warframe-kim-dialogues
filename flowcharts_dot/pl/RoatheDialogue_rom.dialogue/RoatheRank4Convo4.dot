	"Chat ends." [color=orange];
	j1583689000 [label="You're asking me this after telling me that story about Ballas and Margulis, and it's not about him?",shape=box,color=red];
		j1583689000 -> j2523619758;
	j1369821950 [label="After what Albrecht did to you, and all this \"can an Orokin be redeemed\" business, and it's not about him?",shape=box,color=red];
		j1369821950 -> j2523619758;
	j1805893063 [label="Okay, I'll play along. Do I believe that \"everyone deserves to be loved?\" Clearly this is a question about morality and value.",shape=box,color=red];
		j1805893063 -> j2369859712;
	j8292060 [label="The Orokin who told me he has never known love just happens to ask me that question, and it's not about him?",shape=box,color=red];
		j8292060 -> j2523619758;
	j2115468781 [label="The Orokin who served an Executor as her concubine but then schemed to betray her asks me this and it's not about him?",shape=box,color=red];
		j2115468781 -> j2523619758;
	j2828682522 [label="You really expect me to believe this is just a philosophical question?",shape=box,color=red];
		j2828682522 -> j2523619758;
	j2523619758 [label="I do not want to be caught up in the specifics. It drags the whole thing down into minutia. \"Well, you see, this person did this, and that person did that, which negates this,\" and then we are all on the stand in this little tentamen of ours.",shape=box,color=blue];
		j2523619758 -> j2527438834;
		j2523619758 -> j3645057538;
	j2369859712 [label="+5 Chemistry",color=orange];
		j2369859712 -> j3667360342;
	j2527438834 [label="Either speak plainly, or don't speak at all. If you're not going to tell me who this is really about, then I'm not going to waste my time talking to you.",shape=box,color=red];
		j2527438834 -> j1967190931;
	j3645057538 [label="Fine. We'll play your little proverbial game.",shape=box,color=red];
		j3645057538 -> j1488328930;
	j3667360342 [label="Thank you! Removing the names from this little tentamen makes it all the more palatable. Otherwise you get caught up in the specifics and we will get nowhere.",shape=box,color=blue];
		j3667360342 -> j247069895;
	j1967190931 [label="And neither shall I you, simple as that.",shape=box,color=blue];
		j1967190931 -> j155006797;
	j1488328930 [label="Good. The question is as I stated it. Does everyone deserve to be loved?",shape=box,color=blue];
		j1488328930 -> j1839528658;
	j247069895 [label="And yes, precisely. No one questions if the righteous hero deserves to love and be loved. That is never thrown up for debate in our great fables, is it?",shape=box,color=blue];
		j247069895 -> j2313376461;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j1839528658 [label="No one questions if the righteous hero deserves to love and be loved. That is never thrown up for debate in our great fables, is it?",shape=box,color=blue];
		j1839528658 -> j2313376461;
	j2313376461 [label="Only the Cur. The Villain. The Monster. The Morally Destitute Destroyer of Worlds.",shape=box,color=blue];
		j2313376461 -> j3743668683;
		j2313376461 -> j758977568;
	j3743668683 [label="[Let him continue.]",shape=box,color=red];
		j3743668683 -> j516754724;
	j758977568 [label="The Devil?",shape=box,color=red];
		j758977568 -> j3309621039;
	j516754724 [label="Add 1 to Thermostat counter",color=orange];
		j516754724 -> j3082776061;
	j3309621039 [label="Play along, Usurper.",shape=box,color=blue];
		j3309621039 -> j1817221348;
	j3082776061 [label="I propose the following statement; that the only thing that makes these creatures morally outcast, is that they have others by which to morally outcast them.",shape=box,color=blue];
		j3082776061 -> j592196894;
	j1817221348 [label="Add -1 to Thermostat counter",color=orange];
		j1817221348 -> j859562072;
		j1817221348 -> j3910983766;
	j592196894 [label="If an individual were to commit \"evil deeds\" in a vacuum, as a single person without any others around to judge them, there would be no one to judge them evil, now would there?",shape=box,color=blue];
		j592196894 -> j1294603190;
	j859562072 [label="To znaczy...",shape=box,color=red];
		j859562072 -> j167352710;
	j3910983766 [label="Przepraszam.",shape=box,color=red];
		j3910983766 -> j167352710;
	j1294603190 [label="If a bastard burns down a forest and no one is around to hear him, does it make a sound? The only measure we have to judge \"Good\" and \"Evil\" deeds are the deeds of others.",shape=box,color=blue];
		j1294603190 -> j1631037039;
		j1294603190 -> j1841815287;
		j1294603190 -> j2976620353;
	j167352710 [label="But yes, since you insisted on bringing it up, The Devil! The ultimate of all evils!",shape=box,color=blue];
		j167352710 -> j3082776061;
	j1631037039 [label="There have to be deeds that are evil purely on their own.",shape=box,color=red];
		j1631037039 -> j3440128326;
	j1841815287 [label="You're saying one person needs a second person to be \"evil?\"",shape=box,color=red];
		j1841815287 -> j3391009059;
	j2976620353 [label="I don't know if I agree with that.",shape=box,color=red];
		j2976620353 -> j3440128326;
	j3440128326 [label="All the most horrifying a person can commit require at least a second person to commit them. A single person, in a vacuum, can do nothing that is condemnable. Destroy an uninhabited planet? Oh, woe.",shape=box,color=blue];
		j3440128326 -> j1118156289;
	j3391009059 [label="Yes. Think about it. All the most horrifying a person can commit require at least a second person to commit them. A single person, in a vacuum, can do nothing that is condemnable. Destroy an uninhabited planet? Oh, woe.",shape=box,color=blue];
		j3391009059 -> j1118156289;
	j1118156289 [label="And without a society around to waggle their finger at them and say \"you should not have done that terrible deed,\" however would we know that act was so horrifying to begin with? We would not.",shape=box,color=blue];
		j1118156289 -> j2480603510;
	j2480603510 [label="It is merely a measuring stick used by society to judge your actions against those of others, as I said.",shape=box,color=blue];
		j2480603510 -> j4203774511;
		j2480603510 -> j4199976374;
	j4203774511 [label="Say you're right. Say you've convinced me, and good and evil are just... social constructs. What then?",shape=box,color=red];
		j4203774511 -> j3682894400;
	j4199976374 [label="I do think actions can be good or evil outside of their social context. Otherwise, why would so many of them be similar across vastly different societies?",shape=box,color=red];
		j4199976374 -> j597069442;
	j3682894400 [label="Add -1 to Thermostat counter",color=orange];
		j3682894400 -> j1213157952;
	j597069442 [label="Add 1 to Thermostat counter",color=orange];
		j597069442 -> j3077111751;
		j597069442 -> j4080701496;
	j1213157952 [label="+5 Chemistry",color=orange];
		j1213157952 -> j771362732;
	j3077111751 [label="But for the sake of argument, keep going. ",shape=box,color=red];
		j3077111751 -> j1213157952;
	j4080701496 [label="It's probably best we stop here. I don't see this going well. [End.]",shape=box,color=red];
		j4080701496 -> j2112247548;
	j771362732 [label="Very good. If we can say that \"evil\" is not a state of being but a social construct, then we can agree that all the tales of Great Villainy are therefore, in turn, social constructs. Fables.",shape=box,color=blue];
		j771362732 -> j2684071586;
	j2112247548 [label="Jak sobie życzysz.",shape=box,color=blue];
		j2112247548 -> "Chat ends.";
	j2684071586 [label="Why is it then, that in all great fables, those who commit Greatest Evils are left to rot alone?",shape=box,color=blue];
		j2684071586 -> j1601557996;
		j2684071586 -> j1724824073;
		j2684071586 -> j1234459910;
		j2684071586 -> j2308424793;
	j1601557996 [label="Because they are incapable of love?",shape=box,color=red];
		j1601557996 -> j1697722338;
	j1724824073 [label="Because they have no room in their heart for love?",shape=box,color=red];
		j1724824073 -> j1956752332;
	j1234459910 [label="Because they don't deserve to be loved?",shape=box,color=red];
		j1234459910 -> j3173461668;
	j2308424793 [label="Because we are trying to teach a lesson?",shape=box,color=red];
		j2308424793 -> j2162811625;
	j1697722338 [label="Sometimes, yes, they are shown to be some 
inhuman evil, incapable of love. But why? I would propose that all great fables exist to teach a lesson, do they not?",shape=box,color=blue];
		j1697722338 -> j629417355;
	j1956752332 [label="Sometimes, yes, they are shown to be too preoccupied with their Great Evils to belittle themselves with such so-called \"Trivial Things.\" But why? All great fables exist to teach a lesson, do they not?",shape=box,color=blue];
		j1956752332 -> j629417355;
	j3173461668 [label="Mm, now you are simply parroting my words back to me, Usurper. We have already decided that \"deserve\" is relative. Think. All great fables exist to teach a lesson, do they not?",shape=box,color=blue];
		j3173461668 -> j629417355;
	j2162811625 [label="+5 Chemistry",color=orange];
		j2162811625 -> j3721859518;
	j629417355 [label="And if we were to show a Great Evil living peacefully, happily, wonderfully in love... well... what kind of lesson would that teach?",shape=box,color=blue];
		j629417355 -> j878743744;
		j629417355 -> j2374948848;
		j629417355 -> j408194630;
	j3721859518 [label="Such would be my theory, yes! All great fables exist to teach a lesson, do they not?",shape=box,color=blue];
		j3721859518 -> j629417355;
	j878743744 [label="It's hard to reconcile the fact that someone is \"evil\" and also capable of love.",shape=box,color=red];
		j878743744 -> j362925635;
	j2374948848 [label="That perhaps their \"evil deeds\" could still be redeemable through love?",shape=box,color=red];
		j2374948848 -> j3359804088;
	j408194630 [label="That those who do \"evil things\" could still have value to someone else in this world, and therefore are not \"pure evil?\"",shape=box,color=red];
		j408194630 -> j1592775577;
