		j4276847061 -> j528224209;
	j2484007665 [label="Nie ma wątpliwości, że Ballas był zdolny do niektórych z najczystszych form okrucieństwa, jakie ludzkość kiedykolwiek poznała. A jednak znał miłość. Miłość odwzajemnioną. ",shape=box,color=blue];
