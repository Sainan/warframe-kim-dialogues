		j1540312558 -> j4096511772;
	j2154861666 [label="Jeśli łajdak spali las i nikt go nie usłyszy, czy wyda dźwięk? Jedynym miernikiem, jakim mamy, by ocenić \"dobre\" i \"złe\" czyny, są czyny innych.",shape=box,color=blue];
