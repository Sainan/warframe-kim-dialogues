	j1154660628 [label="Widzisz? Nigdy nie ufaj naukowcom. Są gotowi zrobić wszystko w imię kombinowania. Ale z drugiej strony, wróżę tylko z fusów, najlepiej jak potrafię, Uzurpatorze. To tylko przypuszczenia.",shape=box,color=blue];
