	j1437250236 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1437250236 -> j587021283 [label=true,color=green];
		j1437250236 -> j1692949551 [label=false,color=brown];
	"Chat ends." [color=orange];
	j587021283 [label="Hmm. Powiedz mi, czy ostatnim razem udało mi się przekonać cię, że ta \"Obojętność\" to tylko zbiór dziecięcych zabawek, czy nadal wierzysz, że jest to \"wielka, niepojęta istota z Pustki\".",shape=box,color=blue];
		j587021283 -> j49449;
	j1692949551 [label="Check boolean RoatheMITW1",color=orange];
		j1692949551 -> j4021166244 [label=true,color=green];
		j1692949551 -> j3141096328 [label=false,color=brown];
	j49449 [label="Najbardziej nienawidzę biegania za własnym ogonem. I właśnie zdałem sobie sprawę, że to przysłowie było znacznie mniej dosłowne, niż jest dla mnie obecnie.",shape=box,color=blue];
		j49449 -> j4294767387;
		j49449 -> j2281663759;
		j49449 -> j1769528272;
	j4021166244 [label="Zanim przejdziemy dalej, chcę mieć pewność, że dobrze się rozumiemy. Jesteś przekonany, że Obojętność jest jakąś straszliwą, niewyobrażalną istotą z Pustki, która wdarła się do naszego świata przez pomyłkę Albrechta?",shape=box,color=blue];
		j4021166244 -> j3766838323;
	j3141096328 [label="Wszyscy w tym wariatkowie zdają się być przekonani, że \"Pan ze Ściany\" jest manifestacją boga. Prawdziwego boga. Nawet ta dwójka fanatyków tak uważa!",shape=box,color=blue];
		j3141096328 -> j1170011791;
		j3141096328 -> j3320428750;
		j3141096328 -> j3462910325;
	j4294767387 [label="Nie, nie przekonałeś mnie. ",shape=box,color=red];
		j4294767387 -> j733649949;
	j2281663759 [label="Udało ci się mnie przekonać.",shape=box,color=red];
		j2281663759 -> j1022436596;
	j1769528272 [label="Nie doszliśmy do żadnego porozumienia.",shape=box,color=red];
		j1769528272 -> j2695169918;
	j3766838323 [label="Pozwól więc, że zadam następujące pytanie, zanim znów zaczniemy biegać za swoimi ogonami. Co w obecnej sytuacji... jest znacznie bardziej dosłowne, ale mniejsza o tym.",shape=box,color=blue];
		j3766838323 -> j3811774345;
	j1170011791 [label="Uważasz, że on nie istnieje?",shape=box,color=red];
		j1170011791 -> j3961820821;
	j3320428750 [label="Jeśli nie jest bogiem, to czym?",shape=box,color=red];
		j3320428750 -> j1373748504;
	j3462910325 [label="A ty masz inne zdanie?",shape=box,color=red];
		j3462910325 -> j396567053;
	j733649949 [label="Boolean RoatheMITWSkip is now true.",color=orange];
		j733649949 -> j365679351;
	j1022436596 [label="Boolean RoatheMITWSkip is now true.",color=orange];
		j1022436596 -> j2326323760;
	j2695169918 [label="Ach! Wygląda na to, że czeka mnie wiele pracy.",shape=box,color=blue];
		j2695169918 -> j1219029998;
	j3811774345 [label="Czy naprawdę wierzysz, że byt nazywany przez ciebie Obojętnością, istniał przed ingerencją Albrechta? Czy uważasz, że powstał on w wyniku jego interakcji z Pustką?",shape=box,color=blue];
		j3811774345 -> j186155352;
		j3811774345 -> j1105100558;
		j3811774345 -> j3390239634;
		j3811774345 -> j3890219146;
	j3961820821 [label="Wstrzymaj się, czy ja to powiedziałem? Nie wkładaj mi słów w usta, o Ulotny Uzurpatorze. Nie przeczę, że Obojętność jest \"prawdziwa\". Przeczę stwierdzeniu, jakoby była bogiem.",shape=box,color=blue];
		j3961820821 -> j515611198;
		j3961820821 -> j368705202;
	j1373748504 [label="Mogę obnażyć to fałszywe bóstwo dwoma słowami, które są ci doskonale znane:",shape=box,color=blue];
		j1373748504 -> j374544194;
	j396567053 [label="W żadnym razie! Po pierwsze, bogowie nie istnieją, sama idea jest absurdalna. Po drugie - pomyśleć, że Albrecht uwolnił boga Pustki? Śmiechu warte!",shape=box,color=blue];
		j396567053 -> j4061685701;
	j365679351 [label="Boolean RoatheMITW5Real is now true.",color=orange];
		j365679351 -> j2406090927;
	j2326323760 [label="Boolean RoatheMITW5Fake is now true.",color=orange];
		j2326323760 -> j155808669;
	j1219029998 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j1219029998 -> j4021166244;
	j186155352 [label="Nie wiem. I szczerze wątpię, żebyś ty wiedział.",shape=box,color=red];
		j186155352 -> j965362324;
	j1105100558 [label="Myślę, że to byt, który istniał jeszcze zanim Entrati się z nim zetknął. On jedynie nadał mu kształt i formę przez Urzeczywistnienie Idei.",shape=box,color=red];
		j1105100558 -> j2791739338;
	j3390239634 [label="Szczerze... nie mam pojęcia.",shape=box,color=red];
		j3390239634 -> j1614216343;
	j3890219146 [label="Naprawdę uważasz, że Entrati z niczego stworzył wrogiego boga Pustki?",shape=box,color=red];
		j3890219146 -> j765832814;
	j515611198 [label="To coś jest potężniejsze niż cokolwiek, z czym się kiedykolwiek mierzyłem.",shape=box,color=red];
		j515611198 -> j625820074;
	j368705202 [label="Więc czym jest według ciebie?",shape=box,color=red];
		j368705202 -> j1373748504;
	j374544194 [label="Urzeczywistnienie Idei.",shape=box,color=blue];
		j374544194 -> j2571397672;
		j374544194 -> j1347100424;
		j374544194 -> j3265215982;
	j4061685701 [label="W Pustce niczego nie ma, dlatego nazywa się Pustką! ",shape=box,color=blue];
		j4061685701 -> j3391764476;
		j4061685701 -> j1659036040;
	j2406090927 [label="+10 Chemistry",color=orange];
		j2406090927 -> j2169691440;
	j155808669 [label="+20 Chemistry",color=orange];
		j155808669 -> j777690714;
	j965362324 [label="Tak! To tak boleśnie oczywiste i jednocześnie śmiechu warte, że wszyscy wmówiliście sobie istnienie wielkiej bestii, która skrobie pazurami o szybę, kiedy w rzeczywistości to tylko gałąź poruszana wiatrem.",shape=box,color=blue];
		j965362324 -> j145267160;
	j2791739338 [label="Ty też? A już narobiłem sobie nadziei. To tak boleśnie oczywiste i jednocześnie śmiechu warte, że wszyscy wmówiliście sobie istnienie wielkiej bestii, która skrobie pazurami o szybę, kiedy w rzeczywistości to tylko gałąź poruszana wiatrem.",shape=box,color=blue];
		j2791739338 -> j145267160;
	j1614216343 [label="To tak boleśnie oczywiste i jednocześnie śmiechu warte, że wszyscy wmówiliście sobie istnienie wielkiej bestii, która skrobie pazurami o szybę, kiedy w rzeczywistości to tylko gałąź poruszana wiatrem.",shape=box,color=blue];
		j1614216343 -> j145267160;
	j765832814 [label="Tak! Wierzę! To tak boleśnie oczywiste i jednocześnie śmiechu warte, że wszyscy wmówiliście sobie istnienie wielkiej bestii, która skrobie pazurami o szybę, kiedy w rzeczywistości to tylko gałąź poruszana wiatrem.",shape=box,color=blue];
		j765832814 -> j145267160;
	j625820074 [label="Kiedy temu zaprzeczyłem? Rzeczywiście, wygląda na to, że wszyscy zdołaliście wpędzić się w histeryczny i niepotrzebnie rażący konflikt.",shape=box,color=blue];
		j625820074 -> j766474578;
		j625820074 -> j1388277295;
	j2571397672 [label="Pustka i to, co można z niej wycisnąć, jest niebezpieczna i potężna - zaufaj mi. Ale ma też swoje ograniczenia. Naprawdę uważasz, że jest zdolna stworzyć coś takiego? Całe języki, palce zdolne zasilić statki skaczące przez Pustkę?",shape=box,color=red];
		j2571397672 -> j3377226489;
	j1347100424 [label="To... bardzo kuszące uwierzyć, że to po prostu potwór spod łóżka, Roathe. Ale widziałem to, stanąłem twarzą w \"twarz\" z tym czymś i nie wiem, czy może pochodzić z naszych głów.",shape=box,color=red];
		j1347100424 -> j2327291351;
	j3265215982 [label="Urzeczywistnienie Idei nie jest zdolne zrobić tego, co robi Pan ze Ściany. Entrati mógł go urzeczywistnić - i odpowiada za sprowadzenie go do naszego świata - ale nie wierzę, że jest jego źródłem.",shape=box,color=red];
		j3265215982 -> j917402194;
	j3391764476 [label="... ",shape=box,color=red];
		j3391764476 -> j1356041284;
	j1659036040 [label="Nie, widziałem twory, które pochodziły z Pustki. Anioły. Śpiewy. Duchy.",shape=box,color=red];
		j1659036040 -> j1356041284;
	j2169691440 [label="Choć jestem rozczarowany, że trzymasz się tego przekonania, uważam twoją szczerość za niezwykle orzeźwiającą. Cieszy mnie, że nie będę musiał marnować swojego czasu. Z pewnością znajdziemy inne rozrywki.",shape=box,color=blue];
		j2169691440 -> j2186599629;
	j777690714 [label="Fantastycznie. Cieszę się, że dawny ja był tak cudownie przekonujący. Mam nadzieję, że jesteś szczery i nie okłamujesz mnie, próbując mnie \"uciszyć\". Ale nie mam wyboru i muszę ci uwierzyć.",shape=box,color=blue];
		j777690714 -> j174619203;
	j145267160 [label="Dopiero teraz, dzięki wpływowi Pustki, nakarmiliście to ogromem strachu i potęgi, tworząc błędne koło, które zamieniło się w... to. Tego Pana ze Ściany.",shape=box,color=blue];
		j145267160 -> j3451973142;
	j766474578 [label="Co próbujesz powiedzieć?",shape=box,color=red];
		j766474578 -> j702985559;
	j1388277295 [label="Chwila. Gdzie w tym nasza wina? To Albrecht to wypuścił.",shape=box,color=red];
		j1388277295 -> j2905540981;
	j3377226489 [label="Ludzkość z pewnością jest twórcza w swej rozpiętości i ogromie nowych form cierpienia, jakie potrafi sobie wykreować, prawda? Sam byłeś świadkiem wielu form okrucieństwa, jakich – jestem pewien – nikt nie mógłby sobie wyobrazić w czasach naszych drogich fanatyków.",shape=box,color=blue];
		j3377226489 -> j1690363728;
	j2327291351 [label="Ach, jesteś tak blisko prawdy, a jednak tak szybko ją odrzucasz. Myślisz, że \"kuszące\" jest przekonanie, że to wytwór twojego umysłu, bo łatwiej byłoby to odrzucić, gdyby tak było? Nie, myślę, że o wiele bardziej niebezpieczne jest stawienie czoła wytworowi naszego własnego umysłu niż bogu.",shape=box,color=blue];
		j2327291351 -> j3256459237;
	j917402194 [label="Choć doceniam twoją pokorę, kwestionuję twoje ograniczone rozumienie potencjału ludzkiej kreatywności – zwłaszcza w odniesieniu do tego, jak może ona tworzyć nowe formy cierpienia. Czyż nie jesteś w stanie sam stworzyć własnego wszechświata z niczego?",shape=box,color=blue];
		j917402194 -> j4276554401;
	j1356041284 [label="Jedyne, co pochodzi z Pustki, to to, co do niej posłaliśmy - i to, co z niej powróciło. Może przemienić materię i energię, ale nie stworzyć je z niczego.",shape=box,color=blue];
		j1356041284 -> j3024607861;
	j2186599629 [label="Cieszy mnie, że nie muszę powtarzać tej bezcelowej dyskusji na temat szczegółów Urzeczywistnienia Idei.",shape=box,color=blue];
		j2186599629 -> j1420986191;
	j174619203 [label="Niemniej jestem pewien, że znajdziemy inne sposoby na rozrywkę, zamiast gubić się w pokrętnych dyskusjach na temat subtelnych szczegółów Urzeczywistnienia Idei.",shape=box,color=blue];
		j174619203 -> j3057718891;
	j3451973142 [label="Albrecht mógł rozpocząć to szaleństwo, ale wy wszyscy jesteście winni podsycania tego ognia. Obojętność nigdy nie istniała... aż pewnego dnia ją stworzyliście. ",shape=box,color=blue];
		j3451973142 -> j10435400;
	j702985559 [label="Próbuję powiedzieć, że to Albrecht mógł być pierwszą osobą, która ujrzała lico swojej własnej pychy, uśmiechające się jako bóg zniszczenia, tak.",shape=box,color=blue];
		j702985559 -> j1145165740;
	j2905540981 [label="Albrecht mógł być pierwszą osobą, która ujrzała lico swojej własnej pychy, uśmiechające się jako bóg zniszczenia, tak.",shape=box,color=blue];
		j2905540981 -> j1145165740;
	j1690363728 [label="+5 Chemistry",color=orange];
		j1690363728 -> j472640561;
	j3256459237 [label="Wroga zewnętrznego można zrozumieć. Zmanipulować. Pokonać. A może nawet negocjować, jeśli zajdzie taka potrzeba. Ma słabości, które można wykorzystać. Ale wróg wewnętrzny? Stworzony przez nas samych? To o wiele bardziej podstępne.",shape=box,color=blue];
		j3256459237 -> j2612253072;
	j4276554401 [label="Sam byłeś świadkiem wielu form okrucieństwa, jakich – jestem pewien – nikt nie mógłby sobie wyobrazić w czasach naszych drogich fanatyków. ",shape=box,color=blue];
		j4276554401 -> j1690363728;
	j3024607861 [label="Zastanów się, Włóczęgo. Te \"Anioły Pustki\" o których mówisz. Te duchy. Czy powstały one z ludzi, którzy już zatracili się w Pustce?",shape=box,color=blue];
		j3024607861 -> j2332493324;
	j1420986191 [label="Choć znaczy to, że mam teraz więcej czasu na wysłuchiwanie kazań fanatyków... tfu. Wybory, wybory, wybory...",shape=box,color=blue];
		j1420986191 -> "Chat ends.";
	j3057718891 [label="Jestem wdzięczny, że oszczędzono mi drugiej rundy.",shape=box,color=blue];
		j3057718891 -> j1420986191;
	j10435400 [label="To wszystko wasza wina.",shape=box,color=blue];
		j10435400 -> j4292548200;
		j10435400 -> j462928760;
		j10435400 -> j1052361484;
	j1145165740 [label="Ale wy wszyscy jesteście równie odpowiedzialni za popychanie tej sprawy, niczym staczająca z góry kupa odchodów żuka juba, która rośnie z każdym bobkiem zebranym po drodze!",shape=box,color=blue];
		j1145165740 -> j262720474;
	j472640561 [label="Nasz gatunek posiada zadziwiającą zdolność karmienia naszych lęków i wymyślania nowych sposobów na samozniszczenie.",shape=box,color=blue];
		j472640561 -> j1249007933;
	j2612253072 [label="+5 Chemistry",color=orange];
		j2612253072 -> j3438173951;
	j2332493324 [label="To były jedynie echa energii, zwracane tak, jak kolorowy kutak karmi swoje pisklęta.",shape=box,color=blue];
		j2332493324 -> j262720474;
	j4292548200 [label="Mówiłem ci, nie jesteśmy w stanie tworzyć takich bytów, Roathe. Urzeczywistnienie Idei ma swoje granice.",shape=box,color=red];
		j4292548200 -> j3129539284;
	j462928760 [label="Nie obwiniaj nas za to. To nie my odpowiadamy za szkody, jakie wyrządziła.",shape=box,color=red];
		j462928760 -> j4229704810;
	j1052361484 [label="Wyjaśnij mi, jak to ma działać. Większość rzeczy stworzonych w Pustce przez Urzeczywistnienie Idei nie może jej opuścić, a przynajmniej nie na długo.",shape=box,color=red];
		j1052361484 -> j647897369;
	j262720474 [label="Pozwól, że to dla ciebie uproszczę. Mogę obnażyć to fałszywe bóstwo dwoma słowami, które są ci doskonale znane:",shape=box,color=blue];
		j262720474 -> j374544194;
	j1249007933 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j1249007933 -> j3766838323;
	j3438173951 [label="Wtedy musimy zmierzyć się z własnymi demonami. A ludzkość... nigdy nie wygrywa takich wojen, czyż nie?",shape=box,color=blue];
		j3438173951 -> j1249007933;
	j3129539284 [label="I mówi to osoba, która samodzielnie stworzyła cały świat? Proszę cię, Włóczęgo... użyj wyobraźni, jak już raz to zrobiłeś.",shape=box,color=blue];
		j3129539284 -> j647897369;
	j4229704810 [label="Nie obwiniam was! To coś powstawało na długo, zanim w ogóle się pojawiliście. Albrecht o to zadbał.",shape=box,color=blue];
		j4229704810 -> j2901116836;
	j647897369 [label="Urzeczywistnienie Idei działa następująco – podczas interakcji z Pustką lub w pobliżu Pustki, odpowiednio silne emocje mogą przybrać fizyczną formę. Oboje o tym wiemy.",shape=box,color=blue];
		j647897369 -> j4049926115;
		j647897369 -> j3607503726;
		j647897369 -> j1743605452;
	j2901116836 [label="Zobaczył swoje odbicie i poznał prawdziwy strach. To była iskra, która wszczęła pożar, zagrażający wszystkiemu. Wy po prostu dolewacie oliwy do ognia.",shape=box,color=blue];
		j2901116836 -> j647897369;
	j4049926115 [label="Zgadza się. Podobnie jak Duviri, łączy się z tym światem przez Zarimana. ",shape=box,color=red];
		j4049926115 -> j3207597939;
	j3607503726 [label="Tak jak Zariman, i Zatrzymani, i Anioły Pustki. Pustka jest wszędzie na tym statku.",shape=box,color=red];
		j3607503726 -> j3207597939;
	j1743605452 [label="Tak. I?",shape=box,color=red];
		j1743605452 -> j4145048256;
	j3207597939 [label="Dokładnie tak. Gdzie sięgnie Pustka, tam dotrze Urzeczywistnienie Idei. I ani kroku dalej.",shape=box,color=blue];
		j3207597939 -> j2275195964;
		j3207597939 -> j1948510955;
	j4145048256 [label="Gdzie sięgnie Pustka, tam dotrze Urzeczywistnienie Idei. I ani kroku dalej.",shape=box,color=blue];
		j4145048256 -> j2275195964;
		j4145048256 -> j1948510955;
	j2275195964 [label="Ale dotarła do 1999. Podążała za Albrechtem. I za mną też.",shape=box,color=red];
		j2275195964 -> j3523502081;
	j1948510955 [label="Chwila...",shape=box,color=red];
		j1948510955 -> j3678393158;
	j3523502081 [label="Te cholerne palce. Zabraliśmy te przeklęte paluchy ze sobą, w desperackiej próbie dotarcia do Tau, a my, Orokin, wynaleźliśmy też sposób na odtworzenie ich, prawda?",shape=box,color=blue];
		j3523502081 -> j1687863164;
	j3678393158 [label="Tak, zrozumiałeś to. Te cholerne palce. Zabraliśmy te przeklęte paluchy ze sobą, w desperackiej próbie dotarcia do Tau, a my, Orokin, wynaleźliśmy też sposób na odtworzenie ich, prawda?",shape=box,color=blue];
		j3678393158 -> j1687863164;
	j1687863164 [label="Drobiny Pustki, gdziekolwiek nie pójdziesz... Sieć okopów i tuneli, z których może wyskoczyć gdzie i kiedy tylko zapragnie. A co najgorsze?",shape=box,color=blue];
		j1687863164 -> j744728075;
	j744728075 [label="Tenno. I ty. Wszyscy z was, naznaczeni przez Pustkę. Wszyscy z was jesteście przez nią prześladowani, gdzie jesteście wy, tam dotrze i ona.",shape=box,color=blue];
		j744728075 -> j3914852231;
	j3914852231 [label="I prawdopodobnie każdy, kto miał z tym styczność przez dłuższy czas. Sam Entrati. Jego sługa. Cavia. Ja, fanatycy, z uwagi na bliskość tego Sanktuarium. Lista jest długa.",shape=box,color=blue];
		j3914852231 -> j3247042694;
		j3914852231 -> j163133436;
	j3247042694 [label="Czyli zakładasz, że każda osoba wystawiona na działanie Pustki, staje się kolejnym oknem, przez które Pan ze Ściany może zajrzeć do naszego świata?",shape=box,color=red];
		j3247042694 -> j622103994;
	j163133436 [label="Ale jak dosięgnęła Rusałki?",shape=box,color=red];
		j163133436 -> j1000664699;
	j622103994 [label="Dokładnie.",shape=box,color=blue];
		j622103994 -> j3136174558;
	j1000664699 [label="Kogo?",shape=box,color=blue];
		j1000664699 -> j3412522861;
		j1000664699 -> j979903038;
	j3136174558 [label="To by wyjaśniało, dlaczego nie może nosić własnej twarzy, prawda? Może wyglądać tylko jak odbicie tych, których nęka.",shape=box,color=blue];
		j3136174558 -> j771231834;
	j3412522861 [label="Major Neci Rusałka. Dowodziła siłami zbrojnymi znanymi jako Scaldra w 1999 roku w Höllvanii.",shape=box,color=red];
		j3412522861 -> j2578087959;
	j979903038 [label="Krótko mówiąc, nie mogę pozwolić, żebyście kiedykolwiek się spotkali.",shape=box,color=red];
		j979903038 -> j1637081977;
	j771231834 [label="W prawdzie zdaje się przybierać obraz architektury, kiedy pragnie ujawnić się jako coś większego albo innego. Jakby desperacko stara się przywołać poczucia wielkości i boskości.",shape=box,color=blue];
		j771231834 -> j2034306819;
		j771231834 -> j153300813;
	j2578087959 [label="Była – albo nadal jest – opętana przez Obojętność. Wtargnęła do jej umysłu, wykorzystywała jak kukiełkę. Albo ona sama ją wpuściła, trudno powiedzieć. Nie wiemy też, czy udało się jej odzyskać nad sobą kontrolę.",shape=box,color=red];
		j2578087959 -> j3096310143;
	j1637081977 [label="Nie potrafisz się bawić, Uzurpatorze. Ale jaki ma ona związek z naszą... Obojętnością?",shape=box,color=blue];
		j1637081977 -> j2578087959;
	j2034306819 [label="Czyli uważasz, że nosi twarze wszystkich tych ludzi, z którymi się styka... bo nie ma własnej?",shape=box,color=red];
		j2034306819 -> j3860440646;
	j153300813 [label="Wierzę, że Pan ze Ściany nosi nasze twarze, bo nie potrafi pojąć, jak to jest być człowiekiem. W innym przypadku byłby zbyt \"duży\".",shape=box,color=red];
		j153300813 -> j1480794340;
	j3096310143 [label="Brzmi jak przepysznie groźna osoba. I absolutna rozkosz. Ale to nie ma teraz znaczenia. Mówisz, że Obojętność zawładnęła jej umysłem? I to zaczęło się podczas twojego małego urlopu w przeszłości?",shape=box,color=blue];
		j3096310143 -> j4052866167;
	j3860440646 [label="Nie, głuptasie. Bo on tylko naśladuje to, co go stworzyło. To nie jest samodzielny byt – to tylko zabawka poskładana z niepasujących do siebie części strachu, obaw i cierpienia, którymi była karmiona. ",shape=box,color=blue];
		j3860440646 -> j1401386612;
	j1480794340 [label="Nie, głuptasie. To tylko naśladuje to, co go stworzyło. To nie jest samodzielny byt – to tylko zabawka poskładana z niepasujących do siebie części strachu, obaw i cierpienia, którymi była karmiona.",shape=box,color=blue];
		j1480794340 -> j1401386612;
	j4052866167 [label="Jeśli to, co wiemy o Pustce, jest prawdą, to miała miejsce jedna z dwóch rzeczy: albo natknęła się na jakąś manifestację Pustki w 1999, którą sama stworzyła (w co nie wierzę, ale nie jest to niemożliwe), albo...",shape=box,color=blue];
		j4052866167 -> j2990900144;
	j1401386612 [label="Widzę, że dziś nie zrobię żadnego postępu. W porządku, głęboko uwierzyłeś w propagandę, którą cię karmią. Obawiam się, że Albrecht jest przekonującym przywódcą sekty.",shape=box,color=blue];
