digraph {
	1095 [label="RoatheRank2Convo4 begins.",color=orange];
		1095 -> 1096;
	1096 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1096 -> 1097 [label=true,color=green];
		1096 -> 1098 [label=false,color=brown];
	1097 [label="Check boolean RoatheKnowsReset2",color=orange];
		1097 -> 1099 [label=true,color=green];
		1097 -> 1100 [label=false,color=brown];
	1098 [label="Chat ends.",color=orange];
	1099 [label="Hmm. Powiedz mi, czy ostatnim razem udało mi się przekonać cię, że ta \"Obojętność\" to tylko zbiór dziecięcych zabawek, czy nadal wierzysz, że jest to \"wielka, niepojęta istota z Pustki\".",shape=box,color=blue];
		1099 -> 1101;
	1100 [label="Check boolean RoatheMITW1",color=orange];
		1100 -> 1102 [label=true,color=green];
		1100 -> 1103 [label=false,color=brown];
	1101 [label="Najbardziej nienawidzę biegania za własnym ogonem. I właśnie zdałem sobie sprawę, że to przysłowie było znacznie mniej dosłowne, niż jest dla mnie obecnie.",shape=box,color=blue];
		1101 -> 1104;
		1101 -> 1105;
		1101 -> 1106;
	1102 [label="Zanim przejdziemy dalej, chcę mieć pewność, że dobrze się rozumiemy. Jesteś przekonany, że Obojętność jest jakąś straszliwą, niewyobrażalną istotą z Pustki, która wdarła się do naszego świata przez pomyłkę Albrechta?",shape=box,color=blue];
		1102 -> 1107;
	1103 [label="Wszyscy w tym wariatkowie zdają się być przekonani, że \"Pan ze Ściany\" jest manifestacją boga. Prawdziwego boga. Nawet ta dwójka fanatyków tak uważa!",shape=box,color=blue];
		1103 -> 1108;
		1103 -> 1109;
		1103 -> 1110;
	1104 [label="Nie, nie przekonałeś mnie. ",shape=box,color=red];
		1104 -> 1111;
	1105 [label="Udało ci się mnie przekonać.",shape=box,color=red];
		1105 -> 1112;
	1106 [label="Nie doszliśmy do żadnego porozumienia.",shape=box,color=red];
		1106 -> 1113;
	1107 [label="Pozwól więc, że zadam następujące pytanie, zanim znów zaczniemy biegać za swoimi ogonami. Co w obecnej sytuacji... jest znacznie bardziej dosłowne, ale mniejsza o tym.",shape=box,color=blue];
		1107 -> 1114;
	1108 [label="Uważasz, że on nie istnieje?",shape=box,color=red];
		1108 -> 1115;
	1109 [label="Jeśli nie jest bogiem, to czym?",shape=box,color=red];
		1109 -> 1116;
	1110 [label="A ty masz inne zdanie?",shape=box,color=red];
		1110 -> 1117;
	1111 [label="Update boolean RoatheMITWSkip",color=orange];
		1111 -> 1118;
	1112 [label="Update boolean RoatheMITWSkip",color=orange];
		1112 -> 1119;
	1113 [label="Ach! Wygląda na to, że czeka mnie wiele pracy.",shape=box,color=blue];
		1113 -> 1120;
	1114 [label="Czy naprawdę wierzysz, że byt nazywany przez ciebie Obojętnością, istniał przed ingerencją Albrechta? Czy uważasz, że powstał on w wyniku jego interakcji z Pustką?",shape=box,color=blue];
		1114 -> 1121;
		1114 -> 1122;
		1114 -> 1123;
		1114 -> 1124;
	1115 [label="Wstrzymaj się, czy ja to powiedziałem? Nie wkładaj mi słów w usta, o Ulotny Uzurpatorze. Nie przeczę, że Obojętność jest \"prawdziwa\". Przeczę stwierdzeniu, jakoby była bogiem.",shape=box,color=blue];
		1115 -> 1125;
		1115 -> 1126;
	1116 [label="Mogę obnażyć to fałszywe bóstwo dwoma słowami, które są ci doskonale znane:",shape=box,color=blue];
		1116 -> 1127;
	1117 [label="W żadnym razie! Po pierwsze, bogowie nie istnieją, sama idea jest absurdalna. Po drugie - pomyśleć, że Albrecht uwolnił boga Pustki? Śmiechu warte!",shape=box,color=blue];
		1117 -> 1128;
	1118 [label="Update boolean RoatheMITW5Real",color=orange];
		1118 -> 1129;
	1119 [label="Update boolean RoatheMITW5Fake",color=orange];
		1119 -> 1130;
	1120 [label="Update boolean RoatheMITW1",color=orange];
		1120 -> 1131;
	1121 [label="Nie wiem. I szczerze wątpię, żebyś ty wiedział.",shape=box,color=red];
		1121 -> 1132;
	1122 [label="Myślę, że to byt, który istniał jeszcze zanim Entrati się z nim zetknął. On jedynie nadał mu kształt i formę przez Urzeczywistnienie Idei.",shape=box,color=red];
		1122 -> 1133;
	1123 [label="Szczerze... nie mam pojęcia.",shape=box,color=red];
		1123 -> 1134;
	1124 [label="Naprawdę uważasz, że Entrati z niczego stworzył wrogiego boga Pustki?",shape=box,color=red];
		1124 -> 1135;
	1125 [label="To coś jest potężniejsze niż cokolwiek, z czym się kiedykolwiek mierzyłem.",shape=box,color=red];
		1125 -> 1136;
	1126 [label="Więc czym jest według ciebie?",shape=box,color=red];
		1126 -> 1116;
	1127 [label="Urzeczywistnienie Idei.",shape=box,color=blue];
		1127 -> 1137;
		1127 -> 1138;
		1127 -> 1139;
	1128 [label="W Pustce niczego nie ma, dlatego nazywa się Pustką! ",shape=box,color=blue];
		1128 -> 1140;
		1128 -> 1141;
	1129 [label="+10 Chemistry",color=orange];
		1129 -> 1142;
	1130 [label="+20 Chemistry",color=orange];
		1130 -> 5772;
	1131 [label="Zanim przejdziemy dalej, chcę mieć pewność, że dobrze się rozumiemy. Jesteś przekonany, że Obojętność jest jakąś straszliwą, niewyobrażalną istotą z Pustki, która wdarła się do naszego świata przez pomyłkę Albrechta?",shape=box,color=blue];
		1131 -> 1107;
	1132 [label="Tak! To tak boleśnie oczywiste i jednocześnie śmiechu warte, że wszyscy wmówiliście sobie istnienie wielkiej bestii, która skrobie pazurami o szybę, kiedy w rzeczywistości to tylko gałąź poruszana wiatrem.",shape=box,color=blue];
		1132 -> 1143;
	1133 [label="Ty też? A już narobiłem sobie nadziei. To tak boleśnie oczywiste i jednocześnie śmiechu warte, że wszyscy wmówiliście sobie istnienie wielkiej bestii, która skrobie pazurami o szybę, kiedy w rzeczywistości to tylko gałąź poruszana wiatrem.",shape=box,color=blue];
		1133 -> 1143;
	1134 [label="To tak boleśnie oczywiste i jednocześnie śmiechu warte, że wszyscy wmówiliście sobie istnienie wielkiej bestii, która skrobie pazurami o szybę, kiedy w rzeczywistości to tylko gałąź poruszana wiatrem.",shape=box,color=blue];
		1134 -> 1143;
	1135 [label="Tak! Wierzę! To tak boleśnie oczywiste i jednocześnie śmiechu warte, że wszyscy wmówiliście sobie istnienie wielkiej bestii, która skrobie pazurami o szybę, kiedy w rzeczywistości to tylko gałąź poruszana wiatrem.",shape=box,color=blue];
		1135 -> 1143;
	1136 [label="Kiedy temu zaprzeczyłem? Rzeczywiście, wygląda na to, że wszyscy zdołaliście wpędzić się w histeryczny i niepotrzebnie rażący konflikt.",shape=box,color=blue];
		1136 -> 1144;
		1136 -> 1145;
	1137 [label="Pustka i to, co można z niej wycisnąć, jest niebezpieczna i potężna - zaufaj mi. Ale ma też swoje ograniczenia. Naprawdę uważasz, że jest zdolna stworzyć coś takiego? Całe języki, palce zdolne zasilić statki skaczące przez Pustkę?",shape=box,color=red];
		1137 -> 1146;
	1138 [label="To... bardzo kuszące uwierzyć, że to po prostu potwór spod łóżka, Roathe. Ale widziałem to, stanąłem twarzą w \"twarz\" z tym czymś i nie wiem, czy może pochodzić z naszych głów.",shape=box,color=red];
		1138 -> 1147;
	1139 [label="Urzeczywistnienie Idei nie jest zdolne zrobić tego, co robi Pan ze Ściany. Entrati mógł go urzeczywistnić - i odpowiada za sprowadzenie go do naszego świata - ale nie wierzę, że jest jego źródłem.",shape=box,color=red];
		1139 -> 1148;
	1140 [label="... ",shape=box,color=red];
		1140 -> 1149;
	1141 [label="Nie, widziałem twory, które pochodziły z Pustki. Anioły. Śpiewy. Duchy.",shape=box,color=red];
		1141 -> 1149;
	1142 [label="Choć jestem rozczarowany, że trzymasz się tego przekonania, uważam twoją szczerość za niezwykle orzeźwiającą. Cieszy mnie, że nie będę musiał marnować swojego czasu. Z pewnością znajdziemy inne rozrywki.",shape=box,color=blue];
		1142 -> 1150;
	5772 [label="Fantastycznie. Cieszę się, że dawny ja był tak cudownie przekonujący. Mam nadzieję, że jesteś szczery i nie okłamujesz mnie, próbując mnie \"uciszyć\". Ale nie mam wyboru i muszę ci uwierzyć.",shape=box,color=blue];
		5772 -> 5773;
	1143 [label="Dopiero teraz, dzięki wpływowi Pustki, nakarmiliście to ogromem strachu i potęgi, tworząc błędne koło, które zamieniło się w... to. Tego Pana ze Ściany.",shape=box,color=blue];
		1143 -> 1151;
	1144 [label="Co próbujesz powiedzieć?",shape=box,color=red];
		1144 -> 1152;
	1145 [label="Chwila. Gdzie w tym nasza wina? To Albrecht to wypuścił.",shape=box,color=red];
		1145 -> 1153;
	1146 [label="Ludzkość z pewnością jest twórcza w swej rozpiętości i ogromie nowych form cierpienia, jakie potrafi sobie wykreować, prawda? Sam byłeś świadkiem wielu form okrucieństwa, jakich – jestem pewien – nikt nie mógłby sobie wyobrazić w czasach naszych drogich fanatyków.",shape=box,color=blue];
		1146 -> 1154;
	1147 [label="Ach, jesteś tak blisko prawdy, a jednak tak szybko ją odrzucasz. Myślisz, że \"kuszące\" jest przekonanie, że to wytwór twojego umysłu, bo łatwiej byłoby to odrzucić, gdyby tak było? Nie, myślę, że o wiele bardziej niebezpieczne jest stawienie czoła wytworowi naszego własnego umysłu niż bogu.",shape=box,color=blue];
		1147 -> 1155;
	1148 [label="Choć doceniam twoją pokorę, kwestionuję twoje ograniczone rozumienie potencjału ludzkiej kreatywności – zwłaszcza w odniesieniu do tego, jak może ona tworzyć nowe formy cierpienia. Czyż nie jesteś w stanie sam stworzyć własnego wszechświata z niczego?",shape=box,color=blue];
		1148 -> 1156;
	1149 [label="Jedyne, co pochodzi z Pustki, to to, co do niej posłaliśmy - i to, co z niej powróciło. Może przemienić materię i energię, ale nie stworzyć je z niczego.",shape=box,color=blue];
		1149 -> 1157;
	1150 [label="Cieszy mnie, że nie muszę powtarzać tej bezcelowej dyskusji na temat szczegółów Urzeczywistnienia Idei.",shape=box,color=blue];
		1150 -> 1158;
	5773 [label="Niemniej jestem pewien, że znajdziemy inne sposoby na rozrywkę, zamiast gubić się w pokrętnych dyskusjach na temat subtelnych szczegółów Urzeczywistnienia Idei.",shape=box,color=blue];
		5773 -> 5774;
	1151 [label="Albrecht mógł rozpocząć to szaleństwo, ale wy wszyscy jesteście winni podsycania tego ognia. Obojętność nigdy nie istniała... aż pewnego dnia ją stworzyliście. ",shape=box,color=blue];
		1151 -> 1159;
	1152 [label="Próbuję powiedzieć, że to Albrecht mógł być pierwszą osobą, która ujrzała lico swojej własnej pychy, uśmiechające się jako bóg zniszczenia, tak.",shape=box,color=blue];
		1152 -> 1160;
	1153 [label="Albrecht mógł być pierwszą osobą, która ujrzała lico swojej własnej pychy, uśmiechające się jako bóg zniszczenia, tak.",shape=box,color=blue];
		1153 -> 1160;
	1154 [label="+5 Chemistry",color=orange];
		1154 -> 1161;
	1155 [label="Wroga zewnętrznego można zrozumieć. Zmanipulować. Pokonać. A może nawet negocjować, jeśli zajdzie taka potrzeba. Ma słabości, które można wykorzystać. Ale wróg wewnętrzny? Stworzony przez nas samych? To o wiele bardziej podstępne.",shape=box,color=blue];
		1155 -> 1162;
	1156 [label="Sam byłeś świadkiem wielu form okrucieństwa, jakich – jestem pewien – nikt nie mógłby sobie wyobrazić w czasach naszych drogich fanatyków. ",shape=box,color=blue];
		1156 -> 1163;
	1157 [label="Zastanów się, Włóczęgo. Te \"Anioły Pustki\" o których mówisz. Te duchy. Czy powstały one z ludzi, którzy już zatracili się w Pustce?",shape=box,color=blue];
		1157 -> 1164;
	1158 [label="Choć znaczy to, że mam teraz więcej czasu na wysłuchiwanie kazań fanatyków... tfu. Wybory, wybory, wybory...",shape=box,color=blue];
		1158 -> 1165;
	5774 [label="Jestem wdzięczny, że oszczędzono mi drugiej rundy.",shape=box,color=blue];
		5774 -> 1158;
	1159 [label="To wszystko wasza wina.",shape=box,color=blue];
		1159 -> 1166;
		1159 -> 1167;
		1159 -> 1168;
	1160 [label="Ale wy wszyscy jesteście równie odpowiedzialni za popychanie tej sprawy, niczym staczająca z góry kupa odchodów żuka juba, która rośnie z każdym bobkiem zebranym po drodze!",shape=box,color=blue];
		1160 -> 1169;
	1161 [label="Nasz gatunek posiada zadziwiającą zdolność karmienia naszych lęków i wymyślania nowych sposobów na samozniszczenie.",shape=box,color=blue];
		1161 -> 1170;
	1162 [label="+5 Chemistry",color=orange];
		1162 -> 1171;
	1163 [label="+5 Chemistry",color=orange];
		1163 -> 1161;
	1164 [label="To były jedynie echa energii, zwracane tak, jak kolorowy kutak karmi swoje pisklęta.",shape=box,color=blue];
		1164 -> 1169;
	1165 [label="Chat ends.",color=orange];
	1166 [label="Mówiłem ci, nie jesteśmy w stanie tworzyć takich bytów, Roathe. Urzeczywistnienie Idei ma swoje granice.",shape=box,color=red];
		1166 -> 1172;
	1167 [label="Nie obwiniaj nas za to. To nie my odpowiadamy za szkody, jakie wyrządziła.",shape=box,color=red];
		1167 -> 1173;
	1168 [label="Wyjaśnij mi, jak to ma działać. Większość rzeczy stworzonych w Pustce przez Urzeczywistnienie Idei nie może jej opuścić, a przynajmniej nie na długo.",shape=box,color=red];
		1168 -> 1174;
	1169 [label="Pozwól, że to dla ciebie uproszczę. Mogę obnażyć to fałszywe bóstwo dwoma słowami, które są ci doskonale znane:",shape=box,color=blue];
		1169 -> 1127;
	1170 [label="Update boolean RoatheMITW1",color=orange];
		1170 -> 1107;
	1171 [label="Wtedy musimy zmierzyć się z własnymi demonami. A ludzkość... nigdy nie wygrywa takich wojen, czyż nie?",shape=box,color=blue];
		1171 -> 1170;
	1172 [label="I mówi to osoba, która samodzielnie stworzyła cały świat? Proszę cię, Włóczęgo... użyj wyobraźni, jak już raz to zrobiłeś.",shape=box,color=blue];
		1172 -> 1174;
	1173 [label="Nie obwiniam was! To coś powstawało na długo, zanim w ogóle się pojawiliście. Albrecht o to zadbał.",shape=box,color=blue];
		1173 -> 1175;
	1174 [label="Urzeczywistnienie Idei działa następująco – podczas interakcji z Pustką lub w pobliżu Pustki, odpowiednio silne emocje mogą przybrać fizyczną formę. Oboje o tym wiemy.",shape=box,color=blue];
		1174 -> 1176;
		1174 -> 1177;
		1174 -> 1178;
	1175 [label="Zobaczył swoje odbicie i poznał prawdziwy strach. To była iskra, która wszczęła pożar, zagrażający wszystkiemu. Wy po prostu dolewacie oliwy do ognia.",shape=box,color=blue];
		1175 -> 1174;
	1176 [label="Zgadza się. Podobnie jak Duviri, łączy się z tym światem przez Zarimana. ",shape=box,color=red];
		1176 -> 1179;
	1177 [label="Tak jak Zariman, i Zatrzymani, i Anioły Pustki. Pustka jest wszędzie na tym statku.",shape=box,color=red];
		1177 -> 1179;
	1178 [label="Tak. I?",shape=box,color=red];
		1178 -> 1180;
	1179 [label="Dokładnie tak. Gdzie sięgnie Pustka, tam dotrze Urzeczywistnienie Idei. I ani kroku dalej.",shape=box,color=blue];
		1179 -> 1181;
		1179 -> 1182;
	1180 [label="Gdzie sięgnie Pustka, tam dotrze Urzeczywistnienie Idei. I ani kroku dalej.",shape=box,color=blue];
		1180 -> 1181;
		1180 -> 1182;
	1181 [label="Ale dotarła do 1999. Podążała za Albrechtem. I za mną też.",shape=box,color=red];
		1181 -> 1183;
	1182 [label="Chwila...",shape=box,color=red];
		1182 -> 1184;
	1183 [label="Te cholerne palce. Zabraliśmy te przeklęte paluchy ze sobą, w desperackiej próbie dotarcia do Tau, a my, Orokin, wynaleźliśmy też sposób na odtworzenie ich, prawda?",shape=box,color=blue];
		1183 -> 1185;
	1184 [label="Tak, zrozumiałeś to. Te cholerne palce. Zabraliśmy te przeklęte paluchy ze sobą, w desperackiej próbie dotarcia do Tau, a my, Orokin, wynaleźliśmy też sposób na odtworzenie ich, prawda?",shape=box,color=blue];
		1184 -> 1185;
	1185 [label="Drobiny Pustki, gdziekolwiek nie pójdziesz... Sieć okopów i tuneli, z których może wyskoczyć gdzie i kiedy tylko zapragnie. A co najgorsze?",shape=box,color=blue];
		1185 -> 1186;
	1186 [label="Tenno. I ty. Wszyscy z was, naznaczeni przez Pustkę. Wszyscy z was jesteście przez nią prześladowani, gdzie jesteście wy, tam dotrze i ona.",shape=box,color=blue];
		1186 -> 1187;
	1187 [label="I prawdopodobnie każdy, kto miał z tym styczność przez dłuższy czas. Sam Entrati. Jego sługa. Cavia. Ja, fanatycy, z uwagi na bliskość tego Sanktuarium. Lista jest długa.",shape=box,color=blue];
		1187 -> 1188;
		1187 -> 1189;
	1188 [label="Czyli zakładasz, że każda osoba wystawiona na działanie Pustki, staje się kolejnym oknem, przez które Pan ze Ściany może zajrzeć do naszego świata?",shape=box,color=red];
		1188 -> 1190;
	1189 [label="Ale jak dosięgnęła Rusałki?",shape=box,color=red];
		1189 -> 1191;
	1190 [label="Dokładnie.",shape=box,color=blue];
		1190 -> 1192;
	1191 [label="Kogo?",shape=box,color=blue];
		1191 -> 1193;
		1191 -> 1194;
	1192 [label="To by wyjaśniało, dlaczego nie może nosić własnej twarzy, prawda? Może wyglądać tylko jak odbicie tych, których nęka.",shape=box,color=blue];
		1192 -> 1195;
	1193 [label="Major Neci Rusałka. Dowodziła siłami zbrojnymi znanymi jako Scaldra w 1999 roku w Höllvanii.",shape=box,color=red];
		1193 -> 1196;
	1194 [label="Krótko mówiąc, nie mogę pozwolić, żebyście kiedykolwiek się spotkali.",shape=box,color=red];
		1194 -> 1197;
	1195 [label="W prawdzie zdaje się przybierać obraz architektury, kiedy pragnie ujawnić się jako coś większego albo innego. Jakby desperacko stara się przywołać poczucia wielkości i boskości.",shape=box,color=blue];
		1195 -> 1198;
		1195 -> 1199;
	1196 [label="Była – albo nadal jest – opętana przez Obojętność. Wtargnęła do jej umysłu, wykorzystywała jak kukiełkę. Albo ona sama ją wpuściła, trudno powiedzieć. Nie wiemy też, czy udało się jej odzyskać nad sobą kontrolę.",shape=box,color=red];
		1196 -> 1200;
	1197 [label="Nie potrafisz się bawić, Uzurpatorze. Ale jaki ma ona związek z naszą... Obojętnością?",shape=box,color=blue];
		1197 -> 1196;
	1198 [label="Czyli uważasz, że nosi twarze wszystkich tych ludzi, z którymi się styka... bo nie ma własnej?",shape=box,color=red];
		1198 -> 1201;
	1199 [label="Wierzę, że Pan ze Ściany nosi nasze twarze, bo nie potrafi pojąć, jak to jest być człowiekiem. W innym przypadku byłby zbyt \"duży\".",shape=box,color=red];
		1199 -> 1202;
	1200 [label="Brzmi jak przepysznie groźna osoba. I absolutna rozkosz. Ale to nie ma teraz znaczenia. Mówisz, że Obojętność zawładnęła jej umysłem? I to zaczęło się podczas twojego małego urlopu w przeszłości?",shape=box,color=blue];
		1200 -> 1203;
	1201 [label="Nie, głuptasie. Bo on tylko naśladuje to, co go stworzyło. To nie jest samodzielny byt – to tylko zabawka poskładana z niepasujących do siebie części strachu, obaw i cierpienia, którymi była karmiona. ",shape=box,color=blue];
		1201 -> 1204;
	1202 [label="Nie, głuptasie. To tylko naśladuje to, co go stworzyło. To nie jest samodzielny byt – to tylko zabawka poskładana z niepasujących do siebie części strachu, obaw i cierpienia, którymi była karmiona.",shape=box,color=blue];
		1202 -> 1204;
	1203 [label="Jeśli to, co wiemy o Pustce, jest prawdą, to miała miejsce jedna z dwóch rzeczy: albo natknęła się na jakąś manifestację Pustki w 1999, którą sama stworzyła (w co nie wierzę, ale nie jest to niemożliwe), albo...",shape=box,color=blue];
		1203 -> 1205;
	1204 [label="Widzę, że dziś nie zrobię żadnego postępu. W porządku, głęboko uwierzyłeś w propagandę, którą cię karmią. Obawiam się, że Albrecht jest przekonującym przywódcą sekty.",shape=box,color=blue];
		1204 -> 1206;
	1205 [label="to znowu sprawka naszego Albrechta.",shape=box,color=blue];
		1205 -> 1207;
		1205 -> 1208;
		1205 -> 1209;
	1206 [label="+10 Chemistry",color=orange];
		1206 -> 1210;
	1207 [label="Sugerujesz, że Albrecht umyślnie uczynił Neci marionetką Obojętności?",shape=box,color=red];
		1207 -> 1211;
	1208 [label="Nie wiemy, czy cokolwiek z tego jest prawdą. To wszystko spekulacje. To mogą być same kłamstwa.",shape=box,color=red];
		1208 -> 1212;
	1209 [label="Jeśli zrobił wyrwę w Pustce i celowo wpuścił ją do 1999... to by wyjaśniało, dlaczego Warframe'y tu w ogóle zadziałały... tak samo w twoich czasach – bez serca Deimosa.",shape=box,color=red];
		1209 -> 1213;
	1210 [label="Update boolean RoatheMITW2",color=orange];
		1210 -> 1214;
	1211 [label="Wróżę tylko z fusów, najlepiej jak potrafię, Uzurpatorze. Daleki jestem od insynuowania, że Albrecht celowo spowodował wyrwę w Pustce w Höllvanii i wpuścił Obojętność, aby nadać jej formę...",shape=box,color=blue];
		1211 -> 1215;
	1212 [label="Oczywiście! Wróżę tylko z fusów, najlepiej jak potrafię, Uzurpatorze. Daleki jestem od insynuowania, że Albrecht celowo spowodował wyrwę w Pustce w Höllvanii i wpuścił Obojętność, aby nadać jej formę...",shape=box,color=blue];
		1212 -> 1215;
	1213 [label="Widzisz? Nigdy nie ufaj naukowcom. Są gotowi zrobić wszystko w imię kombinowania. Ale z drugiej strony, wróżę tylko z fusów, najlepiej jak potrafię, Uzurpatorze. To tylko przypuszczenia.",shape=box,color=blue];
		1213 -> 1216;
	1214 [label="Mam nadzieję, że przynajmniej dałem ci coś do myślenia. Teraz muszę już iść.",shape=box,color=blue];
		1214 -> 1217;
	1215 [label="Po prostu wygląda to dla mnie, jako taktykowi i osobie przyzwyczajonej do planowania strategii wojennych...",shape=box,color=blue];
		1215 -> 1218;
	1216 [label="Daleki jestem od insynuowania, że Albrecht celowo spowodował wyrwę w Pustce w Höllvanii i wpuścił Obojętność, aby nadać jej formę! Po prostu wygląda to dla mnie, jako taktykowi i osobie przyzwyczajonej do planowania strategii wojennych...",shape=box,color=blue];
		1216 -> 1218;
	1217 [label="Chat ends.",color=orange];
	1218 [label="że pierwszym krokiem do pokonania wroga pozbawionego twarzy, który może pojawić się wszędzie i o każdej porze, powinno być ograniczenie liczby jego opcji...",shape=box,color=blue];
		1218 -> 1219;
	1219 [label="+20 Chemistry",color=orange];
