		j4015231769 -> j3037987419;
	j3057535779 [label="Nie wiemy, czy cokolwiek z tego jest prawdą. To wszystko spekulacje. To mogą być same kłamstwa.",shape=box,color=red];
		j3057535779 -> j1421374997;
	j89341984 [label="Jeśli zrobił wyrwę w Pustce i celowo wpuścił ją do 1999... to by wyjaśniało, dlaczego Warframe'y tu w ogóle zadziałały... tak samo w twoich czasach – bez serca Deimosa.",shape=box,color=red];
