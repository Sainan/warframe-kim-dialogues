		j1654361623 -> j1933300832 [label=true,color=green];
		j1654361623 -> j751949188 [label=false,color=brown];
	j3883590959 [label="Jeśli chcesz wytępić wszystkich Orokin, wejdź po schodach. Zostało jeszcze kilku ocalałych, którzy nie uciekną przed twoim gniewem. Zacznij od \"Babci\".",shape=box,color=blue];
		j3883590959 -> j3501070108;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j751949188 [label="Istnieje jeszcze inny powód, dla którego nie urządziłem tutaj szaleńczej, krwiożerczej masakry, Uzurpatorze.",shape=box,color=blue];
		j751949188 -> j3637896185;
	j3501070108 [label="W końcu to ona widziała najwięcej spośród naszego rodzaju.",shape=box,color=blue];
		j3501070108 -> j155006797;
	j3637896185 [label="Nie widziałem jeszcze finału małego dramatu między naszym ukochanym sługą a skłóconą rodziną Albrechta na górze.",shape=box,color=blue];
		j3637896185 -> j65085115;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j65085115 [label="Nie zapominaj, że mam w tym wszystkim osobisty interes, niezależnie od tego, czy mamy jakąś umowę, czy nie. Zamierzam dopilnować, by kiedy Albrecht ponownie postawi stopę w Sanctum, pierwszą twarzą, na jaką natrafi...",shape=box,color=blue];
		j65085115 -> j701872182;
	j701872182 [label="była moja.",shape=box,color=blue];
		j701872182 -> j4243734726;
	j4243734726 [label="Jeszcze nie podjąłem decyzji, czy kiedy wróci, będę stał pośród trupów jego ukochanych, czy nie.",shape=box,color=blue];
		j4243734726 -> j2299362862;
	j2299362862 [label="Ach, te decyzje… decyzje…",shape=box,color=blue];
