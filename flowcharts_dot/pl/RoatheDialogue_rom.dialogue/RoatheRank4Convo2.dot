		2444 -> 2448 [label="RoatheBirdThree",color=purple];
		2444 -> 2447 [label="false",color=purple];
	2445 [label="Evaluate expressions",color=orange];
		2445 -> 2449 [label="RoatheUnloved2",color=purple];
		2445 -> 2449 [label="RoatheUnloved1",color=purple];
		2445 -> 2449 [label="RoatheAlone1",color=purple];
		2445 -> 2449 [label="RoatheBirdThree",color=purple];
		2445 -> 2450 [label="false",color=purple];
	2446 [label="Jego imię jest wyjątkowe i niepowtarzalne.",shape=box,color=blue];
		2446 -> 2451;
	2448 [label="Nie kuś losu, Uzurpatorze. \"Lubić\" to zbyt wiele powiedziane. Raczej zaczynasz mi przypadać do gustu. Jak pleśń.",shape=box,color=blue];
		2448 -> 2453;
	2447 [label="\"Radość\"? Czy to właśnie to? Nie zdawałem sobie sprawy, że jestem aż takim masochistą. Hm. A może to jedynie odczucie mojego gnijącego ciała… i wasze urocze wtapianie się w moje życie?",shape=box,color=blue];
		2447 -> 2452;
	2449 [label="Muszę przyznać, że rozmowa z kimś bywa całkiem znośna. Nawet jeśli wy wszyscy potraficie być, jak to ująłeś, irytujący od czasu do czasu.",shape=box,color=blue];
		2449 -> 2454;
	2450 [label="Samotność? Proszę cię. Jedyne, co trzymacie na dystans, to odrobina normalności próbująca się do mnie przypałętać. A jeśli chcesz insynuować, że zaczynacie mi \"przypadać do gustu\"… wiesz, do czego to się również odnosi?",shape=box,color=blue];
		2450 -> 2455;
	2451 [label="Ale nie dla gwiazd.",shape=box,color=blue];
		2451 -> 2456;
	2453 [label="+5 Chemistry",color=orange];
		2453 -> 2457;
	2452 [label="Jak pleśń.",shape=box,color=blue];
		2452 -> 2457;
	2454 [label="+5 Chemistry",color=orange];
		2454 -> 2458;
	2455 [label="Pleśń.",shape=box,color=blue];
		2455 -> 2457;
	2456 [label="Maluj mój lud krwią, ile tylko chcesz. Top złoto Orokin i nazywaj nas potworami. Zasługujemy na każdą kroplę jadu, jaką możesz nam poświęcić.",shape=box,color=blue];
		2456 -> 2459;
	2457 [label="Update boolean RoatheAlone2",color=orange];
		2457 -> 2460;
	2458 [label="Przyznam, że… zaczynacie mi trochę \"przypadać do gustu\". Jak pleśń.",shape=box,color=blue];
		2458 -> 2457;
	2459 [label="Ale nie waż się wierzyć choćby przez moment, że to wszystko, na co nas było stać.",shape=box,color=blue];
		2459 -> 2461;
	2460 [label="Check boolean LoidFamilyComplete",color=orange];
		2460 -> 2462 [label=true,color=green];
		2460 -> 2463 [label=false,color=brown];
	2461 [label="Jeśli chcesz wytępić wszystkich Orokin, wejdź po schodach. Zostało jeszcze kilku ocalałych, którzy nie uciekną przed twoim gniewem. Zacznij od \"Babci\".",shape=box,color=blue];
		2461 -> 2464;
	2462 [label="+10 Chemistry",color=orange];
		2462 -> 2465;
	2463 [label="Istnieje jeszcze inny powód, dla którego nie urządziłem tutaj szaleńczej, krwiożerczej masakry, Uzurpatorze.",shape=box,color=blue];
		2463 -> 2466;
	2464 [label="W końcu to ona widziała najwięcej spośród naszego rodzaju.",shape=box,color=blue];
		2464 -> 2467;
	2465 [label="Chat ends.",color=orange];
	2466 [label="Nie widziałem jeszcze finału małego dramatu między naszym ukochanym sługą a skłóconą rodziną Albrechta na górze.",shape=box,color=blue];
		2466 -> 2468;
	2467 [label="Update boolean RoatheNoDate",color=orange];
		2467 -> 2469;
	2468 [label="Nie zapominaj, że mam w tym wszystkim osobisty interes, niezależnie od tego, czy mamy jakąś umowę, czy nie. Zamierzam dopilnować, by kiedy Albrecht ponownie postawi stopę w Sanctum, pierwszą twarzą, na jaką natrafi...",shape=box,color=blue];
		2468 -> 2470;
	2469 [label="Chat ends.",color=orange];
	2470 [label="była moja.",shape=box,color=blue];
		2470 -> 2471;
	2471 [label="Jeszcze nie podjąłem decyzji, czy kiedy wróci, będę stał pośród trupów jego ukochanych, czy nie.",shape=box,color=blue];
		2471 -> 2472;
	2472 [label="Ach, te decyzje… decyzje…",shape=box,color=blue];
		2472 -> 2473;
	2473 [label="+10 Chemistry",color=orange];
		2473 -> 2474;
	2474 [label="Chat ends.",color=orange];
