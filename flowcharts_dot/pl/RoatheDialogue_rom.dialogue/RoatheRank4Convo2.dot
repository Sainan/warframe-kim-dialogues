	2409 [label="Masz możliwości. Masz siłę. I dość wyraźnie dawałeś do zrozumienia, jak bardzo ta sytuacja ci nie odpowiada.",shape=box,color=red];
		2409 -> 2413;
	2410 [label="Po prostu nie rozumiem, czemu Diabeł z Tau wegetuje w krypcie, nawet mimo naszej umowy.",shape=box,color=red];
		2410 -> 2414;
	2411 [label="Jesteś Orokin. Wyraźnie nienawidzisz wszystkich wokół siebie. Co cię powstrzymuje?",shape=box,color=red];
		2411 -> 2415;
	2408 [label="Po prostu nie rozumiem, czemu Diabeł z Tau wegetuje w krypcie. Zwłaszcza że nie mamy żadnej umowy.",shape=box,color=red];
		2408 -> 2412;
	2413 [label="+5 Chemistry",color=orange];
		2413 -> 2418;
	2414 [label="Check boolean RoatheKnowsReset2",color=orange];
		2414 -> 2420 [label=true,color=green];
		2414 -> 2419 [label=false,color=brown];
	2415 [label="Wybacz, potrzebuję chwili, żeby zebrać myśli, zanim zacznę tę rozmowę napędzaną czystą wściekłością i jadem.",shape=box,color=blue];
		2415 -> 2421;
	2412 [label="Check boolean RoatheKnowsReset2",color=orange];
		2412 -> 2417 [label=true,color=green];
		2412 -> 2416 [label=false,color=brown];
	2418 [label="I cieszy mnie, że w końcu pojmujesz, jak łatwo mógłbym zamienić to miejsce w rzeźnię i to bez najmniejszego wysiłku.",shape=box,color=blue];
		2418 -> 2424;
	2420 [label="Bo nadal nie potrafię pojąć, dlaczego w ogóle zaufałem ci na tyle, by odsłonić przed tobą tak wiele… tylko po to, byś wbił mi to zaufanie w plecy, Uzurpatorze.",shape=box,color=blue];
		2420 -> 2423;
	2419 [label="Wciąż jest robota do wykonania, Uzurpatorze. Trudno byłoby mi korzystać z twojej pomocy przy składaniu wszystkich wspomnień, gdybym po drodze wyżynał wszystko, co się rusza… czyż nie?",shape=box,color=blue];
		2419 -> 2422;
	2421 [label="A staram się bardzo, żeby od razu nie udowodnić, że masz rację.",shape=box,color=blue];
		2421 -> 2425;
	2417 [label="Bo nadal nie potrafię pojąć, dlaczego w ogóle zaufałem ci na tyle, by odsłonić przed tobą tak wiele… tylko po to, byś wbił mi to zaufanie w plecy, Uzurpatorze.",shape=box,color=blue];
		2417 -> 2423;
	2416 [label="Być może liczę na to, że zmądrzejesz i zmienisz zdanie. A szanse na to spadają dramatycznie, jeśli kręcę się tu i wyrzynam wszystkich w okolicy… prawda?",shape=box,color=blue];
		2416 -> 2422;
	2424 [label="Poza tym cóż by to właściwie zmieniło, hmm? Jeśli wojna uczy czegokolwiek, to tego, że mordowanie ostatecznie nie przynosi żadnych efektów.",shape=box,color=blue];
		2424 -> 2427;
	2423 [label="Być może liczę na to, że zmądrzejesz i zmienisz zdanie. A szanse na to spadają dramatycznie, jeśli kręcę się tu i wyrzynam wszystkich w okolicy… prawda? Jeśli wojna uczy czegokolwiek, to tego, że mordowanie ostatecznie nie przynosi żadnych efektów.",shape=box,color=blue];
		2423 -> 2426;
	2422 [label="Poza tym cóż by to właściwie zmieniło, hmm? Jeśli wojna uczy czegokolwiek, to tego, że mordowanie ostatecznie nie przynosi żadnych efektów.",shape=box,color=blue];
		2422 -> 2426;
	2425 [label="Rozumiem twoją nienawiść do Orokin. Wierz mi, większość Orokin gardziła sobą. Doskonale zdaję sobie sprawę z naszych zbrodni. Z potwornych ohydztw, których się dopuściliśmy. ",shape=box,color=blue];
		2425 -> 2428;
	2427 [label="Choć, przyznaję, bywa niezwykle kuszące od czasu do czasu oddać się takiej rozrywce.",shape=box,color=blue];
		2427 -> 2431;
		2427 -> 2430;
		2427 -> 2429;
	2426 [label="Choć, przyznaję, bywa niezwykle kuszące od czasu do czasu oddać się takiej rozrywce.",shape=box,color=blue];
		2426 -> 2429;
		2426 -> 2430;
		2426 -> 2431;
	2428 [label="Sam Teatr Yuvan byłby dostatecznym powodem, by zrównać nasze społeczeństwo z ziemią. A jednak ty potępiasz cały naród, którego, pozwól zauważyć, sam jesteś wytworem, mój Uzurpatorze!",shape=box,color=blue];
		2428 -> 2432;
	2431 [label="Więc jedyny powód, dla którego żyją, to że zabicie ich byłoby bezcelowe?",shape=box,color=red];
		2431 -> 2435;
	2430 [label="To jedyny powód, dla którego wciąż wszyscy oddychają?",shape=box,color=red];
		2430 -> 2434;
	2429 [label="Nawet Maria i Leon?",shape=box,color=red];
		2429 -> 2433;
	2432 [label="Nie masz pojęcia o łagodnych, szlachetnych ludziach, którzy pracowali i ginęli za tamtymi złotymi ścianami. O sagach spisanych z żywotów, które przepadły w mrokach historii.",shape=box,color=blue];
		2432 -> 2436;
	2435 [label="Zabijanie ich byłoby kompletną stratą czasu. Prawda? Próbujesz mnie przekonać do czegoś przeciwnego? Uzurpatorze, jestem pod wrażeniem. Nigdy bym nie pomyślał, że jesteś aż tak przebiegłym potworem!",shape=box,color=blue];
		2435 -> 2438;
		2435 -> 2439;
	2434 [label="Jeśli zamierzasz snuć jakieś kokieteryjne insynuacje, Uzurpatorze, to po prostu powiedz to wprost.",shape=box,color=blue];
		2434 -> 2438;
		2434 -> 2439;
	2433 [label="Jestem całkiem pewien, że gdybyś zszedł do krypty i znalazł tam dwie krwawe plamy w miejscu, gdzie stali ci fanatycy, to usłyszałbym od ciebie niezłe kazanie, prawda?",shape=box,color=blue];
		2433 -> 2437;
	2436 [label="Rzeki łez wylane z powodu tragedii, które na zawsze pozostaną zapomniane, po prostu dlatego, że o nich nie wiesz.",shape=box,color=blue];
		2436 -> 2440;
	2438 [label="Możesz spokojnie przyznać, że lubisz towarzystwo. Ludzie służą nie tylko praktycznym celom.",shape=box,color=red];
		2438 -> 2441;
	2439 [label="Możesz spokojnie przyznać, że odpędzamy samotność, nawet jeśli cię irytujemy.",shape=box,color=red];
		2439 -> 2442;
	2437 [label="Od ciebie, albo od sługi, albo od Tenno, albo od przerażającej \"Matki\" Tenno. Ech. Ta. Ta to mnie niepokoi. Temat na inną okazję.",shape=box,color=blue];
		2437 -> 2439;
		2437 -> 2438;
	2440 [label="Słyszę, jak twój dziecięcy duplikat szlocha imię Adis. ",shape=box,color=blue];
		2440 -> 2443;
	2441 [label="Add 1 to Thermostat",color=orange];
		2441 -> 2444;
	2442 [label="Add -1 to Thermostat",color=orange];
		2442 -> 2445;
	2443 [label="Adis był zaledwie jednym spośród milionów.",shape=box,color=blue];
		2443 -> 2446;
	2444 [label="Evaluate expressions",color=orange];
		2444 -> 2448 [label="RoatheUnloved2",color=purple];
		2444 -> 2448 [label="RoatheUnloved1",color=purple];
