	j476582577 [label="Masz możliwości. Masz siłę. I dość wyraźnie dawałeś do zrozumienia, jak bardzo ta sytuacja ci nie odpowiada.",shape=box,color=red];
		j476582577 -> j3304553792;
	j4187071298 [label="Po prostu nie rozumiem, czemu Diabeł z Tau wegetuje w krypcie, nawet mimo naszej umowy.",shape=box,color=red];
		j4187071298 -> j2206556128;
