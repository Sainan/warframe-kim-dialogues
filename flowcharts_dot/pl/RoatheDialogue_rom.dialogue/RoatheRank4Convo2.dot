	j3397031173 [label="+5 Chemistry",color=orange];
		j3397031173 -> j1236375695;
	j2122540212 [label="Pleśń.",shape=box,color=blue];
		j2122540212 -> j689414758;
	j3235443668 [label="Maluj mój lud krwią, ile tylko chcesz. Top złoto Orokin i nazywaj nas potworami. Zasługujemy na każdą kroplę jadu, jaką możesz nam poświęcić.",shape=box,color=blue];
		j3235443668 -> j3188370385;
	j689414758 [label="Boolean RoatheAlone2 is now true.",color=orange];
		j689414758 -> j1654361623;
	j1236375695 [label="Przyznam, że… zaczynacie mi trochę \"przypadać do gustu\". Jak pleśń.",shape=box,color=blue];
		j1236375695 -> j689414758;
	j3188370385 [label="Ale nie waż się wierzyć choćby przez moment, że to wszystko, na co nas było stać.",shape=box,color=blue];
