		j36104292 -> j2679976282 [label="false",color=purple];
	j2295271128 [label="Jego imię jest wyjątkowe i niepowtarzalne.",shape=box,color=blue];
		j2295271128 -> j1797008231;
	j1824078830 [label="Nie kuś losu, Uzurpatorze. \"Lubić\" to zbyt wiele powiedziane. Raczej zaczynasz mi przypadać do gustu. Jak pleśń.",shape=box,color=blue];
		j1824078830 -> j1328807703;
	j4264993685 [label="\"Radość\"? Czy to właśnie to? Nie zdawałem sobie sprawy, że jestem aż takim masochistą. Hm. A może to jedynie odczucie mojego gnijącego ciała… i wasze urocze wtapianie się w moje życie?",shape=box,color=blue];
		j4264993685 -> j3614162150;
	j392673220 [label="Muszę przyznać, że rozmowa z kimś bywa całkiem znośna. Nawet jeśli wy wszyscy potraficie być, jak to ująłeś, irytujący od czasu do czasu.",shape=box,color=blue];
		j392673220 -> j3397031173;
	j2679976282 [label="Samotność? Proszę cię. Jedyne, co trzymacie na dystans, to odrobina normalności próbująca się do mnie przypałętać. A jeśli chcesz insynuować, że zaczynacie mi \"przypadać do gustu\"… wiesz, do czego to się również odnosi?",shape=box,color=blue];
		j2679976282 -> j2122540212;
	j1797008231 [label="Ale nie dla gwiazd.",shape=box,color=blue];
		j1797008231 -> j3235443668;
	j1328807703 [label="+5 Chemistry",color=orange];
		j1328807703 -> j689414758;
