	j2206556128 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2206556128 -> j4195721305 [label=true,color=green];
		j2206556128 -> j3807129055 [label=false,color=brown];
	j1311138620 [label="Wybacz, potrzebuję chwili, żeby zebrać myśli, zanim zacznę tę rozmowę napędzaną czystą wściekłością i jadem.",shape=box,color=blue];
		j1311138620 -> j2395997638;
	j3657429577 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3657429577 -> j4195721305 [label=true,color=green];
		j3657429577 -> j1927515411 [label=false,color=brown];
	j2174723911 [label="I cieszy mnie, że w końcu pojmujesz, jak łatwo mógłbym zamienić to miejsce w rzeźnię i to bez najmniejszego wysiłku.",shape=box,color=blue];
		j2174723911 -> j1810272739;
	j4195721305 [label="Bo nadal nie potrafię pojąć, dlaczego w ogóle zaufałem ci na tyle, by odsłonić przed tobą tak wiele… tylko po to, byś wbił mi to zaufanie w plecy, Uzurpatorze.",shape=box,color=blue];
		j4195721305 -> j1884073210;
	j3807129055 [label="Wciąż jest robota do wykonania, Uzurpatorze. Trudno byłoby mi korzystać z twojej pomocy przy składaniu wszystkich wspomnień, gdybym po drodze wyżynał wszystko, co się rusza… czyż nie?",shape=box,color=blue];
		j3807129055 -> j3017449930;
	j2395997638 [label="A staram się bardzo, żeby od razu nie udowodnić, że masz rację.",shape=box,color=blue];
		j2395997638 -> j2231090983;
	j1927515411 [label="Być może liczę na to, że zmądrzejesz i zmienisz zdanie. A szanse na to spadają dramatycznie, jeśli kręcę się tu i wyrzynam wszystkich w okolicy… prawda?",shape=box,color=blue];
		j1927515411 -> j3017449930;
	j1810272739 [label="Poza tym cóż by to właściwie zmieniło, hmm? Jeśli wojna uczy czegokolwiek, to tego, że mordowanie ostatecznie nie przynosi żadnych efektów.",shape=box,color=blue];
		j1810272739 -> j3731188501;
	j1884073210 [label="Być może liczę na to, że zmądrzejesz i zmienisz zdanie. A szanse na to spadają dramatycznie, jeśli kręcę się tu i wyrzynam wszystkich w okolicy… prawda? Jeśli wojna uczy czegokolwiek, to tego, że mordowanie ostatecznie nie przynosi żadnych efektów.",shape=box,color=blue];
		j1884073210 -> j1991195277;
	j3017449930 [label="Poza tym cóż by to właściwie zmieniło, hmm? Jeśli wojna uczy czegokolwiek, to tego, że mordowanie ostatecznie nie przynosi żadnych efektów.",shape=box,color=blue];
		j3017449930 -> j1991195277;
	j2231090983 [label="Rozumiem twoją nienawiść do Orokin. Wierz mi, większość Orokin gardziła sobą. Doskonale zdaję sobie sprawę z naszych zbrodni. Z potwornych ohydztw, których się dopuściliśmy. ",shape=box,color=blue];
		j2231090983 -> j1936131579;
	j3731188501 [label="Choć, przyznaję, bywa niezwykle kuszące od czasu do czasu oddać się takiej rozrywce.",shape=box,color=blue];
		j3731188501 -> j3988683182;
		j3731188501 -> j2749296397;
		j3731188501 -> j1857601439;
	j1991195277 [label="Choć, przyznaję, bywa niezwykle kuszące od czasu do czasu oddać się takiej rozrywce.",shape=box,color=blue];
		j1991195277 -> j1857601439;
		j1991195277 -> j2749296397;
		j1991195277 -> j3988683182;
	j1936131579 [label="Sam Teatr Yuvan byłby dostatecznym powodem, by zrównać nasze społeczeństwo z ziemią. A jednak ty potępiasz cały naród, którego, pozwól zauważyć, sam jesteś wytworem, mój Uzurpatorze!",shape=box,color=blue];
		j1936131579 -> j2848445996;
	j3988683182 [label="Więc jedyny powód, dla którego żyją, to że zabicie ich byłoby bezcelowe?",shape=box,color=red];
		j3988683182 -> j606300636;
	j2749296397 [label="To jedyny powód, dla którego wciąż wszyscy oddychają?",shape=box,color=red];
		j2749296397 -> j1451533628;
	j1857601439 [label="Nawet Maria i Leon?",shape=box,color=red];
		j1857601439 -> j1120954071;
	j2848445996 [label="Nie masz pojęcia o łagodnych, szlachetnych ludziach, którzy pracowali i ginęli za tamtymi złotymi ścianami. O sagach spisanych z żywotów, które przepadły w mrokach historii.",shape=box,color=blue];
		j2848445996 -> j1511029110;
	j606300636 [label="Zabijanie ich byłoby kompletną stratą czasu. Prawda? Próbujesz mnie przekonać do czegoś przeciwnego? Uzurpatorze, jestem pod wrażeniem. Nigdy bym nie pomyślał, że jesteś aż tak przebiegłym potworem!",shape=box,color=blue];
		j606300636 -> j826136483;
		j606300636 -> j540355500;
	j1451533628 [label="Jeśli zamierzasz snuć jakieś kokieteryjne insynuacje, Uzurpatorze, to po prostu powiedz to wprost.",shape=box,color=blue];
		j1451533628 -> j826136483;
		j1451533628 -> j540355500;
	j1120954071 [label="Jestem całkiem pewien, że gdybyś zszedł do krypty i znalazł tam dwie krwawe plamy w miejscu, gdzie stali ci fanatycy, to usłyszałbym od ciebie niezłe kazanie, prawda?",shape=box,color=blue];
		j1120954071 -> j2774929186;
	j1511029110 [label="Rzeki łez wylane z powodu tragedii, które na zawsze pozostaną zapomniane, po prostu dlatego, że o nich nie wiesz.",shape=box,color=blue];
		j1511029110 -> j942005852;
	j826136483 [label="Możesz spokojnie przyznać, że lubisz towarzystwo. Ludzie służą nie tylko praktycznym celom.",shape=box,color=red];
		j826136483 -> j796436421;
	j540355500 [label="Możesz spokojnie przyznać, że odpędzamy samotność, nawet jeśli cię irytujemy.",shape=box,color=red];
		j540355500 -> j134072315;
	j2774929186 [label="Od ciebie, albo od sługi, albo od Tenno, albo od przerażającej \"Matki\" Tenno. Ech. Ta. Ta to mnie niepokoi. Temat na inną okazję.",shape=box,color=blue];
		j2774929186 -> j540355500;
		j2774929186 -> j826136483;
	j942005852 [label="Słyszę, jak twój dziecięcy duplikat szlocha imię Adis. ",shape=box,color=blue];
