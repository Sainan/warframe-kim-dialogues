	j1827717139 [label="VM: DIPLOMACY",shape=box,color=blue];
		j1827717139 -> j290696754;
	j290696754 [label="Transcript: Among the Seven Executors, Ballas had styled himself first among equals. ",shape=box,color=blue];
		j290696754 -> j2429277026;
	j2429277026 [label="Ever the diplomat, ever the honey-voiced persuader, he resolved the grudges and disputes of the others.",shape=box,color=blue];
		j2429277026 -> j2036232857;
	j2036232857 [label="Ku mojej wielkiej radości odkryłem, że jest on teraz różą uwięzioną między dwoma gąszczami cierni. ",shape=box,color=blue];
		j2036232857 -> j4025181208;
	j4025181208 [label="The warmonger faction, headed by Nitokh, pulled one way. The pacifists, under Scarne, pulled another.",shape=box,color=blue];
		j4025181208 -> j927124240;
	j927124240 [label="Ballas musiał podjąć decyzję i narazić się na miażdżącą wrogość każdej osoby, po której stronie się nie opowiedział.",shape=box,color=blue];
		j927124240 -> j1129141211;
	j1129141211 [label="Z nieznanych mi powodów wybrał pokój. Było cztery do trzech, więc żarłoczni Świadomi nagle stali się sojusznikami i przyjaciółmi.",shape=box,color=blue];
		j1129141211 -> j3829831552;
	j3829831552 [label="\"Tak czy inaczej, zmieni zdanie\", obiecała Nitokh, gdy ja zostałem wysłany, aby odnaleźć dysydentów wśród stacjonujących w garnizonie Daks.",shape=box,color=blue];
		j3829831552 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}