	j3355325166 [label="VM: DYPLOMACJA",shape=box,color=blue];
		j3355325166 -> j1629901524;
	j1629901524 [label="Transkrypcja: Spośród Siedmiu Egzekutorów, Ballas uważał się za pierwszego wśród równych sobie. ",shape=box,color=blue];
		j1629901524 -> j255399659;
	j255399659 [label="Zawsze dyplomata, zawsze perswazyjny, rozwiązywał urazy i spory pozostałych.",shape=box,color=blue];
		j255399659 -> j4198374418;
	j4198374418 [label="Ku mojej wielkiej radości odkryłem, że jest on teraz różą uwięzioną między dwoma gąszczami cierni. ",shape=box,color=blue];
		j4198374418 -> j3240003656;
	j3240003656 [label="Frakcja podżegaczy wojennych, na czele z Nitokh, ciągnęła w jedną stronę.",shape=box,color=blue];
		j3240003656 -> j927124240;
	j927124240 [label="Ballas musiał podjąć decyzję i narazić się na miażdżącą wrogość każdej osoby, po której stronie się nie opowiedział.",shape=box,color=blue];
		j927124240 -> j1129141211;
	j1129141211 [label="Z nieznanych mi powodów wybrał pokój. Było cztery do trzech, więc żarłoczni Świadomi nagle stali się sojusznikami i przyjaciółmi.",shape=box,color=blue];
		j1129141211 -> j3829831552;
	j3829831552 [label="\"Tak czy inaczej, zmieni zdanie\", obiecała Nitokh, gdy ja zostałem wysłany, aby odnaleźć dysydentów wśród stacjonujących w garnizonie Daks.",shape=box,color=blue];
		j3829831552 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}