	5720 [label="Transcript: Among the Seven Executors, Ballas had styled himself first among equals. ",shape=box,color=blue];
		5720 -> 5721;
	5721 [label="Ever the diplomat, ever the honey-voiced persuader, he resolved the grudges and disputes of the others.",shape=box,color=blue];
		5721 -> 2301;
	2301 [label="Ku mojej wielkiej radości odkryłem, że jest on teraz różą uwięzioną między dwoma gąszczami cierni. ",shape=box,color=blue];
		2301 -> 5734;
	5734 [label="The warmonger faction, headed by Nitokh, pulled one way. The pacifists, under Scarne, pulled another.",shape=box,color=blue];
		5734 -> 2300;
	2300 [label="Ballas musiał podjąć decyzję i narazić się na miażdżącą wrogość każdej osoby, po której stronie się nie opowiedział.",shape=box,color=blue];
		2300 -> 2305;
	2305 [label="Z nieznanych mi powodów wybrał pokój. Było cztery do trzech, więc żarłoczni Świadomi nagle stali się sojusznikami i przyjaciółmi.",shape=box,color=blue];
		2305 -> 2308;
	2308 [label="\"Tak czy inaczej, zmieni zdanie\", obiecała Nitokh, gdy ja zostałem wysłany, aby odnaleźć dysydentów wśród stacjonujących w garnizonie Daks.",shape=box,color=blue];
