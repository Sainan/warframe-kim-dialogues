	j1691779905 [label="VM: ADAPTACJA",shape=box,color=blue];
		j1691779905 -> j3199732425;
	j3199732425 [label="Transkrypcja: Wielu Świadomych ewoluowało między spotkaniami, więc nigdy nie mogliśmy być pewni, że spotkamy tego samego wroga dwa razy. Ale inni pozostali w niezmiennej formie, jakby dawno temu osiągnęli jakiś poziom.",shape=box,color=blue];
		j3199732425 -> j3423323800;
	j3423323800 [label="Doskonali zabójcy, niosąc ze sobą ten sam zimny horror, co rekin.",shape=box,color=blue];
		j3423323800 -> j3143304455;
	j3143304455 [label="To było szaleństwo. Jak mogłem opracować strategię uwzględniającą zachowanie Świadomych statków-krabów, skoro ledwo dopracowałem taktykę, a statki-kraby zostały zastąpione robaczymi statkami?",shape=box,color=blue];
		j3143304455 -> j1875484218;
	j1875484218 [label="A ile czasu upłynie, zanim te robacze statki zostaną zastąpione przez jakąś nową potworność?",shape=box,color=blue];
		j1875484218 -> j3373434453;
	j3373434453 [label="Pozostało na tylko się wycofać. Postęp okazał się zgubny. Stare tradycje, uświęcone czasem ścieżki honoru i dyscypliny, doczekały się sowitej rekompensaty.",shape=box,color=blue];
		j3373434453 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
