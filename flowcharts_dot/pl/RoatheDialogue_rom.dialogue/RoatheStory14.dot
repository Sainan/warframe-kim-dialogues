	2259 [label="Transkrypcja: Wielu Świadomych ewoluowało między spotkaniami, więc nigdy nie mogliśmy być pewni, że spotkamy tego samego wroga dwa razy. Ale inni pozostali w niezmiennej formie, jakby dawno temu osiągnęli jakiś poziom.",shape=box,color=blue];
		2259 -> 5709;
	5709 [label="Perfected killers, they brought the same cold horror that a shark does.",shape=box,color=blue];
		5709 -> 2256;
	2256 [label="To było szaleństwo. Jak mogłem opracować strategię uwzględniającą zachowanie Świadomych statków-krabów, skoro ledwo dopracowałem taktykę, a statki-kraby zostały zastąpione robaczymi statkami?",shape=box,color=blue];
		2256 -> 2253;
	2253 [label="A ile czasu upłynie, zanim te robacze statki zostaną zastąpione przez jakąś nową potworność?",shape=box,color=blue];
		2253 -> 5710;
	5710 [label="All we could do was go backward. Progress had been fatal. Old traditions, time-hallowed paths of honor and discipline, were owed their due.",shape=box,color=blue];
