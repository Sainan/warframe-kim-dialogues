	j1296229704 [label="VM: ADAPTATION",shape=box,color=blue];
		j1296229704 -> j1356742528;
	j1356742528 [label="Transkrypcja: Wielu Świadomych ewoluowało między spotkaniami, więc nigdy nie mogliśmy być pewni, że spotkamy tego samego wroga dwa razy. Ale inni pozostali w niezmiennej formie, jakby dawno temu osiągnęli jakiś poziom.",shape=box,color=blue];
		j1356742528 -> j515433622;
	j515433622 [label="Perfected killers, they brought the same cold horror that a shark does.",shape=box,color=blue];
		j515433622 -> j1915788364;
	j1915788364 [label="To było szaleństwo. Jak mogłem opracować strategię uwzględniającą zachowanie Świadomych statków-krabów, skoro ledwo dopracowałem taktykę, a statki-kraby zostały zastąpione robaczymi statkami?",shape=box,color=blue];
		j1915788364 -> j2422121636;
	j2422121636 [label="A ile czasu upłynie, zanim te robacze statki zostaną zastąpione przez jakąś nową potworność?",shape=box,color=blue];
		j2422121636 -> j198894524;
	j198894524 [label="All we could do was go backward. Progress had been fatal. Old traditions, time-hallowed paths of honor and discipline, were owed their due.",shape=box,color=blue];
		j198894524 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}