		j783633330 -> j2664851682;
	j2664851682 [label="Jakże sobie schlebialiśmy. W rzeczywistości desperacko poszukiwaliśmy innowacji, wiedząc, że nasi wrogowie nas przewyższają.",shape=box,color=blue];
		j2664851682 -> j2025402717;
