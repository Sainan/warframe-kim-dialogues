	j2453596182 [label="VM: WYNALAZEK",shape=box,color=blue];
		j2453596182 -> j1252734908;
	j1252734908 [label="Transkrypcja: Pamiętam, że rozwój wydarzeń związanych z Archimediami był początkowo prezentowany jako rozrywka. ",shape=box,color=blue];
		j1252734908 -> j975363540;
	j975363540 [label="Like debauched roués watching criminals put to death in an arena-circus.",shape=box,color=blue];
		j975363540 -> j783633330;
	j783633330 [label="Wydawało nam się, że wymyśliliśmy nowe i ekscytujące sposoby na pokonanie o wiele słabszego wroga.",shape=box,color=blue];
		j783633330 -> j2664851682;
	j2664851682 [label="Jakże sobie schlebialiśmy. W rzeczywistości desperacko poszukiwaliśmy innowacji, wiedząc, że nasi wrogowie nas przewyższają.",shape=box,color=blue];
		j2664851682 -> j2025402717;
	j2025402717 [label="Przedzierali się przez nas jak rojące się dzieci pożerające swoją rozdętą matkę.",shape=box,color=blue];
		j2025402717 -> j1711458800;
	j1711458800 [label="Wyschnięci, zmiażdżeni między stronami czasu, zostaliśmy po prostu przewyższeni ewolucyjnie.",shape=box,color=blue];
		j1711458800 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
