		j1278035451 -> j1170460992;
	j1170460992 [label="Czarownica Złotego Szkła wyłoniła się z mgły Ceres na śmiercionośnych skrzydłach – galeon załadowany dronami i opancerzonymi w srebrne zbroje myrmidonami.",shape=box,color=blue];
		j1170460992 -> j254805372;
	j254805372 [label="Obwody, cienkie jak mgła, tworzyły delikatną koronkę pod ich półprzezroczystym pancerzem. ",shape=box,color=blue];
		j254805372 -> j2050995514;
	j2050995514 [label="Była tak ogromna, że ledwo mieściła się w granicach Kolei Solarnej.",shape=box,color=blue];
		j2050995514 -> j3178643470;
	j3178643470 [label="Świadomi zadbali o to, byśmy poznali konsekwencje swoich działań. Śpiewali, a nasza technologia zawiodła. Nasi wojownicy walczyli i dusili się w swoich lśniących kombinezonach.",shape=box,color=blue];
		j3178643470 -> j3523379936;
	j3523379936 [label="Załoga Czarownicy Złotego Szkła spłonęła żywcem, gdy jak kamień spadła z nieba Tau, to był bardzo drogi pokaz fajerwerków.",shape=box,color=blue];
		j3523379936 -> j921430358;
