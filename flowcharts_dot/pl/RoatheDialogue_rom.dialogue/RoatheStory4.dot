	j4146061663 [label="VM: PYCHA",shape=box,color=blue];
		j4146061663 -> j346811316;
	j346811316 [label="Transkrypcja: Nie spodziewaliśmy się przegranej. ",shape=box,color=blue];
		j346811316 -> j3451446401;
	j3451446401 [label="After the Sentients' first expeditionary strike, we had prepared a punitive counterblast.",shape=box,color=blue];
		j3451446401 -> j2773796358;
	j2773796358 [label="Czarownica Złotego Szkła wyłoniła się z mgły Ceres na śmiercionośnych skrzydłach – galeon załadowany dronami i opancerzonymi w srebrne zbroje myrmidonami.",shape=box,color=blue];
		j2773796358 -> j3271754294;
	j3271754294 [label="Obwody, cienkie jak mgła, tworzyły delikatną koronkę pod ich półprzezroczystym pancerzem. ",shape=box,color=blue];
		j3271754294 -> j2269968867;
	j2269968867 [label="So vast she was that she barely cleared the edges of the Solar Rail.",shape=box,color=blue];
		j2269968867 -> j3178643470;
	j3178643470 [label="Świadomi zadbali o to, byśmy poznali konsekwencje swoich działań. Śpiewali, a nasza technologia zawiodła. Nasi wojownicy walczyli i dusili się w swoich lśniących kombinezonach.",shape=box,color=blue];
		j3178643470 -> j3523379936;
	j3523379936 [label="Załoga Czarownicy Złotego Szkła spłonęła żywcem, gdy jak kamień spadła z nieba Tau, to był bardzo drogi pokaz fajerwerków.",shape=box,color=blue];
		j3523379936 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}