	j2738099137 [label="VM: ZAPOMNIENIE",shape=box,color=blue];
		j2738099137 -> j113107517;
	j113107517 [label="Transkrypcja: Tchórz.",shape=box,color=blue];
		j113107517 -> j4088269774;
	j4088269774 [label="Właśnie mnie tak nazywali, prawda? Czytałem książki rozrzucone po tej zakurzonej sali. Kłamstwo. Nie znali prawdy. Zostałem wyrwany z mojego czasu, zanim udało mi się dokończyć swoje dzieło.",shape=box,color=blue];
		j4088269774 -> j175181767;
	j175181767 [label="Tchórz.",shape=box,color=blue];
		j175181767 -> j2748910897;
	j2748910897 [label="Teraz sobie przypominam. Podszedł do mnie w Złotych Salach. Miał twarz, której nie znałem. Ale to nie jest takie niezwykłe dla naszego rodzaju. Znałem jego głos. Znałem sposób, w jaki się poruszał.",shape=box,color=blue];
		j2748910897 -> j1604536310;
	j1604536310 [label="Tchórz!",shape=box,color=blue];
		j1604536310 -> j3871799574;
	j3871799574 [label="Zadał mi jedno pytanie. Czy naprawdę wierzyłem, że kiedykolwiek zostanie mi wybaczone spalenie tego wszystkiego na popiół?",shape=box,color=blue];
		j3871799574 -> j1524889904;
	j1524889904 [label="TCHÓRZ!",shape=box,color=blue];
		j1524889904 -> j1481042957;
	j1481042957 [label="W tej bladej, wyciągniętej dłoni… strzykawka. Lśniąca wolnością… kolejną szansą… na kolejne życie.",shape=box,color=blue];
		j1481042957 -> j1189308009;
	j1189308009 [label="Przyjąłem ją.",shape=box,color=blue];
		j1189308009 -> j3885232091;
	j3885232091 [label="TCHÓRZ!",shape=box,color=blue];
		j3885232091 -> j921430358;
