	2321 [label="Transkrypcja: Tchórz.",shape=box,color=blue];
		2321 -> 5725;
	5725 [label="That is what they called me, isn’t it? I’ve read the history books scattered about this dusty hall. A lie. They did not know the truth. That I was ripped away from my time before I could complete my work.",shape=box,color=blue];
		5725 -> 5726;
	5726 [label="Tchórz.",shape=box,color=blue];
		5726 -> 5727;
	5727 [label="I remember now. He approached me, in the Golden Halls. He wore a face I did not know. But that is not so very unusual for our kind. I knew his voice. I knew the way he moved.",shape=box,color=blue];
		5727 -> 5728;
	5728 [label="Tchórz!",shape=box,color=blue];
		5728 -> 5729;
	5729 [label="He asked me a single question. Did I truly believe that I could ever be forgiven for burning it all to ash?",shape=box,color=blue];
		5729 -> 5730;
	5730 [label="TCHÓRZ!",shape=box,color=blue];
		5730 -> 2320;
	2320 [label="W tej bladej, wyciągniętej dłoni… strzykawka. Lśniąca wolnością… kolejną szansą… na kolejne życie.",shape=box,color=blue];
		2320 -> 2324;
	2324 [label="Przyjąłem ją.",shape=box,color=blue];
		2324 -> 5735;
	5735 [label="TCHÓRZ!",shape=box,color=blue];
		5735 -> 2319;
