	j2717300490 [label="VM: OBLIVION",shape=box,color=blue];
		j2717300490 -> j4126341169;
	j4126341169 [label="Transkrypcja: Tchórz.",shape=box,color=blue];
		j4126341169 -> j2164427857;
	j2164427857 [label="That is what they called me, isn’t it? I’ve read the history books scattered about this dusty hall. A lie. They did not know the truth. That I was ripped away from my time before I could complete my work.",shape=box,color=blue];
		j2164427857 -> j131427902;
	j131427902 [label="Tchórz.",shape=box,color=blue];
		j131427902 -> j499087709;
	j499087709 [label="I remember now. He approached me, in the Golden Halls. He wore a face I did not know. But that is not so very unusual for our kind. I knew his voice. I knew the way he moved.",shape=box,color=blue];
		j499087709 -> j3807696587;
	j3807696587 [label="Tchórz!",shape=box,color=blue];
		j3807696587 -> j528869652;
	j528869652 [label="He asked me a single question. Did I truly believe that I could ever be forgiven for burning it all to ash?",shape=box,color=blue];
		j528869652 -> j1524889904;
	j1524889904 [label="TCHÓRZ!",shape=box,color=blue];
		j1524889904 -> j1481042957;
	j1481042957 [label="W tej bladej, wyciągniętej dłoni… strzykawka. Lśniąca wolnością… kolejną szansą… na kolejne życie.",shape=box,color=blue];
		j1481042957 -> j1189308009;
	j1189308009 [label="Przyjąłem ją.",shape=box,color=blue];
		j1189308009 -> j3885232091;
	j3885232091 [label="TCHÓRZ!",shape=box,color=blue];
		j3885232091 -> j921430358;
