		"RoatheRank3Convo6 begins." -> j386906797;
	j2828758005 [label="Dlaczego spędzasz tyle czasu z Cavią, Roathe?",shape=box,color=red];
		j2828758005 -> j1983204396;
	j815383982 [label="Trzymaj się z daleka od Cavii, Roathe. Twoje zachowanie mnie niepokoi.",shape=box,color=red];
		j815383982 -> j2403818825;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j1983204396 [label="Hm? Cóż, uważam je z bezdyskusyjnie najsmutniejsze i najbardziej żałosne stworzenia, jakie kiedykolwiek spotkałem w całym przeklętym przez Pustkę Systemie Origin. ",shape=box,color=blue];
		j1983204396 -> j1182190550;
	j2403818825 [label="Aby uniknąć jak najmniej nieporozumień w tej sytuacji, powstrzymam się od zwykłej dla mnie rozwlekłości i powiem po prostu: ",shape=box,color=blue];
		j2403818825 -> j1764148572;
	"Chat ends." [color=orange];
	j1182190550 [label="Zwierzęta laboratoryjne. Zwierzęta laboratoryjne, Albrecht! Wrzuciłeś zwierzęta do cholernej Pustki, a potem, kiedy wyszły, bełkocząc w twoim wymyślonym dziecięcym języku, kazałeś swojemu słudze je uśpić?!",shape=box,color=blue];
		j1182190550 -> j734301829;
	j1764148572 [label="Nie.",shape=box,color=blue];
		j1764148572 -> "Chat ends.";
	j734301829 [label="Zawsze zostawiając wszystkich innych, żeby zrobili za niego brudną robotę. Ale odbiegam od tematu. Pytasz mnie, dlaczego z nimi rozmawiam. Zwłaszcza z ptakiem. To proste. Ale myślę, że chciałbym, żebyś zgadł. Chcę zobaczyć, czy potrafisz to rozgryźć.",shape=box,color=blue];
		j734301829 -> j1150353889;
		j734301829 -> j1638638180;
		j734301829 -> j4109743991;
		j734301829 -> j3024139538;
		j734301829 -> j1796960013;
	j1150353889 [label="On nie wie, kim jesteś.",shape=box,color=red];
		j1150353889 -> j2594911759;
	j1638638180 [label="Ptak-3 kocha wszystkich.",shape=box,color=red];
		j1638638180 -> j2136291002;
	j4109743991 [label="Lubisz otaczać się ludźmi, którzy sprawiają, że czujesz się mądry.",shape=box,color=red];
		j4109743991 -> j7296569;
	j3024139538 [label="Potrafi dostrzec w innych to, co przeoczyli inni.",shape=box,color=red];
		j3024139538 -> j2899327317;
	j1796960013 [label="Łatwo nim manipulować.",shape=box,color=red];
		j1796960013 -> j7296569;
	j2594911759 [label="Tak. W pewnym sensie właśnie o to chodzi. Nie wie, kim jestem. Nic nie wie o \"Diable z Tau\". I on… po prostu wcale go to nie obchodzi.",shape=box,color=blue];
		j2594911759 -> j4104162855;
	j2136291002 [label="Owszem. Jest całkiem czarujący w swojej bezmyślnej niewinności. Ale to, co mówisz, w nieco łagodniejszy i bardziej ogólnikowy sposób, to to, że nikt inny nie mógłby mnie pokochać. O to chodzi?",shape=box,color=blue];
		j2136291002 -> j3019457053;
	j7296569 [label="Chciałbym, żebyś zrozumiał, jak bardzo jesteś w błędzie. Jak bardzo daleko od celu trafił ten pocisk... ale nie jesteś jedynym, który podziela takie zdanie o mnie.",shape=box,color=blue];
		j7296569 -> j2557434501;
	j2899327317 [label="Tak. A jego spostrzeżenia są całkiem przydatne, ale to nic, czego nie mógłbym sam osiągnąć w ciągu kilku chwil.",shape=box,color=blue];
		j2899327317 -> j1722966828;
	j4104162855 [label="+10 Chemistry",color=orange];
		j4104162855 -> j3504826288;
	j3019457053 [label="Więc muszę liczyć na towarzystwo tego durnego ptaka? Ale jesteś wystarczająco blisko prawdy, więc chyba dam ci... ocenę pozytywną.",shape=box,color=blue];
		j3019457053 -> j3504826288;
	j2557434501 [label="W zupełności nie jesteś w tym zdaniu osamotniony.",shape=box,color=blue];
		j2557434501 -> j3705997063;
	j1722966828 [label="Mówisz w nieco łagodniejszy i bardziej okrężny sposób, że uważasz, że wykorzystuję tego dużego, gadającego ptaka do własnych celów? O to chodzi?",shape=box,color=blue];
		j1722966828 -> j356855099;
	j3504826288 [label="Dla niego nie jestem Roathe. Nie jestem Orokin. Nie jestem przestępcą. Ani zdrajcą. Ani tchórzem. Mogę po prostu być... sobą.",shape=box,color=blue];
		j3504826288 -> j3803072492;
	j3705997063 [label="Boolean RoatheAlone1 is now true.",color=orange];
		j3705997063 -> j4081414586;
	j356855099 [label="Nie. Ale to nie tylko twoja opinia. Zdecydowanie nie jesteś w tym zdaniu osamotniony.",shape=box,color=blue];
		j356855099 -> j3705997063;
	j3803072492 [label="Nie sądzę, abym potrafił opisać, jak prostą i rzadką jest to ulgą...",shape=box,color=blue];
		j3803072492 -> j2401331152;
		j3803072492 -> j3532625916;
		j3803072492 -> j648805677;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j2401331152 [label="Nie musisz się kontrolować. Możesz się zmienić. Nawet tu i teraz.",shape=box,color=red];
		j2401331152 -> j1572177489;
	j3532625916 [label="To musi być okropny ciężar. Radzenie sobie z oczekiwaniami wobec swojej reputacji, gdziekolwiek się udasz, nawet tutaj.",shape=box,color=red];
		j3532625916 -> j1186275975;
	j648805677 [label="Czy sugerujesz, że wszystko inne, co robisz, jest na pokaz?",shape=box,color=red];
		j648805677 -> j2762062606;
	j1572177489 [label="Add 2 to Thermostat counter",color=orange];
		j1572177489 -> j3207811065;
	j1186275975 [label="Add -1 to Thermostat counter",color=orange];
		j1186275975 -> j3922297405;
	j2762062606 [label="Gdyby to było takie proste i gdyby to wszystko było jakąś wielką maską, którą mogę zmienić od zechcenia! Nie, Uzurpatorze. Taki właśnie jestem, aż do zgniłego szpiku moich kości.",shape=box,color=blue];
		j2762062606 -> j355287718;
	j3207811065 [label="Gdyby to było takie proste, Uzurpatorze. Sprawiasz, że to wszystko brzmi tak kusząco. Czy mogę? Może... Może nie jest za późno, nawet dla tak smutnego, tragicznego diabła jak ja.",shape=box,color=blue];
		j3207811065 -> j1105006739;
	j3922297405 [label="+10 Chemistry",color=orange];
		j3922297405 -> j4215268872;
	j355287718 [label="Nie oznacza to jednak, że nie cieszę się z możliwości odłożenia wszystkiego na godzinę i po prostu porozmawiania z kimś, kto nie zdaje sobie sprawy ze wszystkich strasznych zbrodni, jakie popełniłem w swoim życiu.",shape=box,color=blue];
		j355287718 -> j172570375;
	j1105006739 [label="+10 Chemistry",color=orange];
		j1105006739 -> j1480412891;
	j4215268872 [label="To wyczerpujące, Uzurpatorze. I chciałbym móc odrzucić tę personę i nigdy więcej do niej nie wracać. Ale taki właśnie jestem, zgniły aż do szpiku kości.",shape=box,color=blue];
		j4215268872 -> j355287718;
	j172570375 [label="Boolean RoatheBirdThree is now true.",color=orange];
		j172570375 -> j2604762402;
		j172570375 -> j25620613;
	j1480412891 [label="Czy to tylko wspaniała fasada, którą noszę? A może jest głęboko zakorzeniona we mnie, aż do szpiku moich kości? Jeszcze nie wiem. Mogę tylko powiedzieć, że wciąż cieszę się możliwością zapomnienia o tym, choć na jakiś czas.",shape=box,color=blue];
		j1480412891 -> j3492368810;
	j2604762402 [label="Przepraszam, jeśli to się wydaje niegrzeczne, ale... wygląda na to, że twoje życie jest tutaj dość samotne.",shape=box,color=red];
		j2604762402 -> j2902082429;
	j25620613 [label="Nie jesteś przyzwyczajony do posiadania przyjaciół, prawda?",shape=box,color=red];
		j25620613 -> j2539663690;
	j3492368810 [label="Odkładam ten ciężar na bok, siadam z kimś, kto nie jest świadomy moich okropnych zbrodni, rozmawiam z tym olbrzymim, uroczo nieudolnym ptakiem i odnajduję... spokój. Po raz pierwszy od dawna.",shape=box,color=blue];
		j3492368810 -> j502729256;
	j2902082429 [label="Evaluate expressions",color=orange];
		j2902082429 -> j4024729286 [label="RoatheUnloved1 & RoatheKnowsReset2",color=purple];
		j2902082429 -> j974702093 [label="RoatheKnowsReset2",color=purple];
		j2902082429 -> j1405164810 [label="RoatheUnloved1",color=purple];
