	j2539663690 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2539663690 -> j1146235862 [label=true,color=green];
		j2539663690 -> j1373164286 [label=false,color=brown];
	j502729256 [label="Być może jest nadzieja w tym, co mówisz. A może sam siebie oszukuję. I to tylko chwila wytchnienia.",shape=box,color=blue];
		j502729256 -> j172570375;
	j4024729286 [label="Tak, byłem. A przynajmniej to, co pamiętam. Czy to właśnie mi odebrałeś, Uzurpatorze? To, że byliśmy kochankami, że wyznałem ci miłość, a ty nie czułeś tego samego?",shape=box,color=blue];
		j4024729286 -> j1360153160;
	j974702093 [label="Przyznaję, że tak było. Przynajmniej tyle, ile pamiętam. Czy zdziwi cię fakt, że nigdy nie byłem zakochany? Nigdy z wzajemnością. Może wtedy by nie było. Myślę, że już o tym rozmawialiśmy.",shape=box,color=blue];
		j974702093 -> j2321811803;
	j1405164810 [label="Moje życie było samotne. Długie i samotne. Ale to wszystko moja zasługa, Uzurpatorze. Nie jestem tu po to, by szukać twojej litości czy współczucia.",shape=box,color=blue];
		j1405164810 -> j3181392545;
	j2855856922 [label="Przyznaję, że tak było. Przynajmniej tyle, ile pamiętam. Czy zdziwi cię fakt, że nigdy nie byłem zakochany? Ale to wszystko moja zasługa, Uzurpatorze. Nie jestem tu po to, by szukać twojej litości czy współczucia.",shape=box,color=blue];
		j2855856922 -> j891118309;
	j1146235862 [label="Kto wie? Może miałem przyjaciół, ale po prostu nie mogę ich sobie przypomnieć, bo byliśmy przyjaciółmi, zanim położyłeś temu kres, hm?",shape=box,color=blue];
		j1146235862 -> j2256681736;
	j1373164286 [label="Kto wie? Może miałem przyjaciół, ale po prostu nie mogę ich sobie przypomnieć, bo Entrati namieszał mi w głowie i odebrał wspomnienia o nich.",shape=box,color=blue];
		j1373164286 -> j2256681736;
	j1360153160 [label="A może było na odwrót? Zakochałeś się szaleńczo w samym Diable, ale jego serce pozostało dla ciebie zimne. Zrozpaczony, zrobiłeś jedyne, co mogłeś – rozszarpałaś jego umysł na strzępy!",shape=box,color=blue];
		j1360153160 -> j3361283050;
