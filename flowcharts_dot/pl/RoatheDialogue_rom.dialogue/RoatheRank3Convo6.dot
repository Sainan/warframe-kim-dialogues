	j3162476532 [label="Zastanawiam się, czy to mi odebrałeś, Uzurpatorze? To, że byliśmy kochankami, że wyznałem ci miłość, a ty nie czułeś tego samego?",shape=box,color=blue];
		j3162476532 -> j1360153160;
	j614347181 [label="Zasługuję na wszystkie okropne opinie, jakie o mnie masz. Zdecydowanie nie jesteś w tym zdaniu osamotniony.",shape=box,color=blue];
		j614347181 -> "Chat ends.";
	j1054968439 [label="Jakie to tragiczne, w rzeczy samej... Niemal pragnę poznać szczegóły, ale mam wrażenie, że to skok na sam koniec opowieści, na który nie jesteśmy gotowi.",shape=box,color=blue];
		j1054968439 -> j2879683584;
	j3508830558 [label="Ale kogo ja oszukuję?! Wiemy, dlaczego to zrobiłeś, czyż nie? Nie z miłości dla mnie. Ale z miłości dla kogoś innego. Tylko ględzę bez celu.",shape=box,color=blue];
		j3508830558 -> j2879683584;
	j2807443394 [label="Ale kogo ja oszukuję?! Wiemy, dlaczego to zrobiłeś, czyż nie? Nie z miłości dla mnie. W ogóle nie chodziło o miłość. Tylko ględzę bez celu.",shape=box,color=blue];
		j2807443394 -> j2879683584;
	j976032835 [label="Ba. Ale jaki jest cel takiego ględzenia?",shape=box,color=blue];
		j976032835 -> j2879683584;
	j2879683584 [label="Ale nie jestem tu po to, by szukać twojej litości czy współczucia. To wszystko moja własna sprawka. Zasługuję na wszystkie okropne opinie, jakie o mnie masz. I z pewnością nie podzielasz ich tylko ty.",shape=box,color=blue];
