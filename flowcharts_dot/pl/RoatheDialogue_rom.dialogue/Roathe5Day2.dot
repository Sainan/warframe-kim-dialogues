	j2480306986 [label="Boolean IsDating is now false.",color=orange];
		j2480306986 -> j3087157976;
	j1387056714 [label="Nie bądź taki zgorzkniały, tylko dlatego, że teraz zdajesz sobie sprawę, że zostałeś przechytrzony. Zaproponowałem ci warunki umowy, nie precyzując moich własnych. Czyżbyś tego nie zauważył?",shape=box,color=blue];
		j1387056714 -> j3106815463;
	j3371081569 [label="\"Potrzebuję kogoś, kto pomoże mi zapisywać wspomnienia, gdy tylko powrócą, i pomoże je pogodzić. Swego rodzaju asystenta.\"",shape=box,color=blue];
		j3371081569 -> j948832929;
	j3763144201 [label="Po prostu stwierdzę, że kłamiesz, a to prawdopodobnie nieodwracalnie zniszczy moją opinię o tobie.",shape=box,color=blue];
		j3763144201 -> j3411866970;
		j3763144201 -> j4252056853;
	j2833696803 [label="Za każdym razem, gdy rozmawiamy, nie mogę przestać się zastanawiać, czy brzegi, po których stąpamy, są ci znajome, czy obce. Czy się powtarzam, czy może mam dla ciebie jakąś nową niespodziankę.",shape=box,color=blue];
		j2833696803 -> j390887943;
	j69881130 [label="Dotrzymałeś swojej części umowy. Teraz doszliśmy do przedostatniego punktu, w którym musimy ustalić szczegóły dotyczące sposobu, w jaki przeprowadzimy naszą metodę ataku.",shape=box,color=blue];
		j69881130 -> j1727040889;
	j3087157976 [label="Boolean RoatheDating is now false.",color=orange];
		j3087157976 -> j937150954;
	j3106815463 [label="Po prostu powiedziałem, co będziesz miał z tej umowy. Nigdy nie mówiłem, co musisz zrobić ani dlaczego, by je zdobyć. A ty ślepo się zgodziłeś.",shape=box,color=blue];
		j3106815463 -> j822616767;
	j948832929 [label="Choć spełniłeś pierwszy warunek, \"zapisując moje wspomnienia\", kompletnie zawiodłeś w drugim, \"pomagając mi je uporządkować\".",shape=box,color=blue];
		j948832929 -> j1258817945;
	j3411866970 [label="Nie. Nie mogę tego zrobić. Nie zrobię tego. Musimy wspólnie stawić czoła tej sytuacji. Czy nie możemy po prostu o tym porozmawiać?",shape=box,color=red];
		j3411866970 -> j1222155322;
	j4252056853 [label="Ja... naprawdę nie ma już innego wyjścia?",shape=box,color=red];
		j4252056853 -> j1222155322;
	j390887943 [label="Tak czy inaczej, wolałbym, żebyś mi tego nie mówił. Nienawidzę, gdy jestem zbyt przewidywalny. Tak czy inaczej, pomogłeś mi rozwiązać sprawę, która była dla mnie naprawdę istotna. ",shape=box,color=blue];
		j390887943 -> j2395459902;
	j1727040889 [label="Ta bitwa musi się toczyć na trzech frontach. Wszyscy muszą współpracować, aby wygrać tę wojnę.",shape=box,color=blue];
		j1727040889 -> j3583501873;
