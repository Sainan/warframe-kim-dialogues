		j2681171191 -> j2954812823;
	j2969108767 [label="W takim wypadku możesz po prostu powtórzyć to samo. To tak, jakbyś miał niewyczerpany dar, prawda?",shape=box,color=blue];
		j2969108767 -> j2954812823;
	j2903192111 [label="Bardzo prawdopodobne. Połączę dwa do dwóch i obwinię cię za zrobienie czegoś, o co cię nie prosiłem. Jestem pewien, że przetrwasz burzę.",shape=box,color=blue];
		j2903192111 -> j2954812823;
