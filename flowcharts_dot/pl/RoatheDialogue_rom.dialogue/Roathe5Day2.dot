	j937150954 [label="Cóż, czegokolwiek ode mnie oczekujesz, teraz tego nie dostaniesz. Mogę równie dobrze to zakończyć i wymazać całą tę farsę z pamięci, \"drogi Włóczęgo\".",shape=box,color=blue];
		j937150954 -> j3322192265;
	j822616767 [label="W dawnych językach nazwaliby to \"carte blanche\"? A ty nadzwyczaj ochoczo złożyłeś swój podpis.",shape=box,color=blue];
		j822616767 -> j3378683130;
		j822616767 -> j812324868;
	j1258817945 [label="Raczej nie powiedziałbym, że są uporządkowane, a ty?",shape=box,color=blue];
		j1258817945 -> j1967777848;
	j1222155322 [label="Nie. Jeśli chcesz, żeby sługa poszedł na górę? Wymaż mi z pamięci te wszystkie bzdury, tak jak proszę. A jeśli ci to nie zależy? Rób, co chcesz. Nie obchodzi mnie to.",shape=box,color=blue];
		j1222155322 -> j1697547748;
	j2395459902 [label="Od dawna nie spałem tak dobrze, jak zeszłej nocy. Powiedziałbym nawet: „Nie pamiętam, żebym kiedykolwiek tak dobrze spał”, ale to byłby bardzo kiepski żart.",shape=box,color=blue];
		j2395459902 -> j839106740;
	j3583501873 [label="Słucham?",shape=box,color=red];
		j3583501873 -> j3920125564;
	j329424089 [label="Czy mówimy o Loidzie?",shape=box,color=red];
		j329424089 -> j3652887764;
	j3378683130 [label="Czy jest jakiś sposób, żeby zmienić twoje zdanie?",shape=box,color=red];
		j3378683130 -> j2591163714;
	j812324868 [label="Jak mogę się z tego uwolnić?",shape=box,color=red];
		j812324868 -> j1607035077;
	j1967777848 [label="Nie spełniłeś swojej części umowy, więc ja nie spełnię swojej.",shape=box,color=blue];
		j1967777848 -> j3378683130;
		j1967777848 -> j2371778605;
	j1697547748 [label="To, no i oczywiście nasza osobista przyjaźń to jedyna przewaga, jaką posiadam w tej sytuacji. To proste.",shape=box,color=blue];
		j1697547748 -> j747875875;
	j839106740 [label="Więc w zamian, teraz ja ci pomogę. Sługa. Czy nadal chcesz, żeby spotkał się z rodziną Albrechta na górze?",shape=box,color=blue];
		j839106740 -> j744968765;
	j3920125564 [label="Sługa. Ponowne połączenie go z rodziną Albrechta. Wciąż chcesz to zrobić, prawda?",shape=box,color=blue];
		j3920125564 -> j1949841813;
	j3652887764 [label="Tak. Postaraj się nadążyć. Zakładam, że nadal chcesz połączyć go z rodziną Albrechta na górze, prawda?",shape=box,color=blue];
		j3652887764 -> j1949841813;
	j2591163714 [label="Nie. I już nie mam ochoty ci w tym pomagać.",shape=box,color=blue];
