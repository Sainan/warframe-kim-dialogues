		j3900977504 -> j92161912;
	j182707137 [label="Bardzo dobrze. I nie sądź, że zapomniałem o naszej umowie. Obiecałem ci, że posprzątam ten bałagan, i zrobię to. Jak przewidywałeś, potrzebowałeś tego.",shape=box,color=blue];
		j182707137 -> j1395910669;
