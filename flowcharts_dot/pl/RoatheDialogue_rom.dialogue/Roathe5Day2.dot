		j2173407095 -> "Chat ends.";
	j4257725069 [label="Rozumiem. Tak po prostu?",shape=box,color=blue];
		j4257725069 -> j431793363;
	j2527963593 [label="Mmm. Upewnij się, że to zrobisz. Jestem niesamowicie cierpliwy, ale uwierz mi, to źródło może w końcu wyschnąć.",shape=box,color=blue];
		j2527963593 -> "Chat ends.";
	j2790452869 [label="Nawet jeśli to oznacza, że pozostaniemy uwięzieni w tym impasie na zawsze? Biedny, smutny Uzurpatorze… niech tak będzie. Czyściec to mniejsze zło dla diabła niż Piekło, prawda?",shape=box,color=blue];
		j2790452869 -> j3444170682;
	j1168873950 [label="Dobrze. Do dzieła. Mam już dość życia z tą wiedzą w głowie.",shape=box,color=blue];
		j1168873950 -> j378811769;
	j1001250964 [label="Chociaż, co to dla ciebie za różnica? Masz już wszystko, co chcesz, by wyciąć z mego pustego ciała. Moje żebra są nagie i wybielone.",shape=box,color=blue];
		j1001250964 -> j1776100240;
	j2430091346 [label="Tragiczne, prawda? Wiedzieć, że odpadki rodziny Entrati nigdy się nie dowiedzą, że sługa gnije tutaj, wyciskając dłonie w żalu? Całkiem sam?",shape=box,color=blue];
		j2430091346 -> j1776100240;
	j3322192265 [label="To będzie jedyny sposób, abyś poszedł do przodu, jeśli to właśnie chcesz. Jeśli ci to obojętne, to mnie również. Rób, co chcesz.",shape=box,color=blue];
		j3322192265 -> j2646526537;
	j587093412 [label="Uwolnij mnie od tego. Wyzwól mnie od tej plagi. Oczyść mój umysł z tych wspomnień. Wiem, że jesteś do tego zdolny. Skorzystaj ze swojego daru i zakończ to, natychmiast.",shape=box,color=blue];
		j587093412 -> j3551356799;
		j587093412 -> j72787189;
		j587093412 -> j4263106130;
