	j1558828640 [label="Wstaje nowy dzień i po raz pierwszy od dawna myślę o przyszłości. Zastanawiam się, jak mogę zmienić otaczający mnie świat, jak mogę wykorzystać swoją wiedzę, kim jestem i jak lepiej ją wykorzystać.",shape=box,color=blue];
		j1558828640 -> j3984658869;
	j204408234 [label="Nowy dzień wstaje, a ja po raz pierwszy od... długiego czasu zaczynam planować przyszłość. Myślę o tym, co to oznacza dla mnie, o tym, czego pragnę, o tym, jak chcę kształtować swoje otoczenie według własnych upodobań.",shape=box,color=blue];
		j204408234 -> j2558396776;
	j185332075 [label="Mogę zapytać, na co dokładnie czekasz? Siedzę tutaj z moimi wspomnieniami, które wciąż są nienaruszone. Dałeś mi słowo, że wymażesz je z mojej pamięci.",shape=box,color=blue];
		j185332075 -> j3812316201;
		j185332075 -> j1737778641;
		j185332075 -> j4060317438;
	j2862680577 [label="Czy podjąłeś już decyzję? Jestem cierpliwym diabłem, ale mam swoje granice. Wymażesz moje wspomnienia, czy chcesz, żebym wciąż trwał w tym stanie?",shape=box,color=blue];
		j2862680577 -> j1498200500;
		j2862680577 -> j1245011023;
	j1946223382 [label="Oto jesteśmy, i tutaj pozostaniemy. W tym Czyśćcu. Mam nadzieję, że ci się tu spodoba, bo nie wierzę, że kiedykolwiek pójdziemy dalej.",shape=box,color=blue];
		j1946223382 -> j2171950327;
	j3011918147 [label="Co masz na myśli?",shape=box,color=red];
		j3011918147 -> j77247163;
	j1860038414 [label="Trochę jednego i drugiego?",shape=box,color=red];
		j1860038414 -> j1501397817;
	j66230473 [label="To nie dotyczy ciebie, Roathe. Nigdy nie dotyczyło.",shape=box,color=red];
		j66230473 -> j4066324802;
	j1871599266 [label="Głupcze! Coś ty narobił?! Po co, pytam, po co zapuszczasz się w otchłanie, gdzie nie jesteś mile widziany?!",shape=box,color=blue];
		j1871599266 -> j4197065764;
