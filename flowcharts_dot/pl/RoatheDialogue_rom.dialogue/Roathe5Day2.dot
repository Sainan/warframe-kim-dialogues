		j3798583166 -> "Chat ends.";
	j2954812823 [label="Jestem pewny, że będę na ciebie strasznie zły, kiedy zdam sobie sprawę, że zmieniłeś moje wspomnienia. I radzę ci, kochanie, nie mów mi, że to było na moją własną prośbę.",shape=box,color=blue];
