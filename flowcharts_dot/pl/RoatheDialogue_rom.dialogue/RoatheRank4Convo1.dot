		j1727300631 -> j183819132;
	j538985223 [label="Ten tytuł to tylko wyraz mojej lekkiej admiracji. Choć zawiera nutę sarkazmu, którą uważam za całkiem atrakcyjną, przyznaję.",shape=box,color=blue];
		j538985223 -> j3406442462;
		j538985223 -> j2787749006;
		j538985223 -> j1722169130;
		j538985223 -> j53411353;
	j3290643681 [label="Nie mam ochoty robić z ciebie wroga, Uzurpatorze. Nie. To nie jest zniewaga. To wyłącznie przez twoje własne niedopatrzenie nie zauważyłeś, jak wiele z mojej przeszłości splata się z twoją.",shape=box,color=blue];
		j3290643681 -> j351501487;
	j183819132 [label="Nie mam ochoty robić z ciebie wroga, Uzurpatorze. Nie. Jeśli już, to jest to przydomek honorowy. Osiągnąłeś to, do czego ja dążyłem. Nic więcej.",shape=box,color=blue];
		j183819132 -> j538985223;
	j3406442462 [label="Czy wszyscy Orokin byli tacy jak ty?",shape=box,color=red];
		j3406442462 -> j1418734373;
	j2787749006 [label="Gdybym poprosił cię grzecznie, byś nazywał mnie inaczej, zrobiłbyś to?",shape=box,color=red];
		j2787749006 -> j345462942;
	j1722169130 [label="Zniosę to.",shape=box,color=red];
