	j4225317353 [label="Powiem tylko, że to trochę niedorzeczne, jeśli masz na myśli obelgę, skoro masz to samo na sumieniu.",shape=box,color=red];
		j4225317353 -> j2946414719;
	j1801891482 [label="Próbuję zrozumieć, dlaczego ciągle mnie tak tytułujesz.",shape=box,color=red];
		j1801891482 -> j4189102519;
	j2392273244 [label="Ha! Mało tego! Musisz mieć anielską cierpliwość, skoro myślisz, że przez tyle dni obrzucałem cię wyzwiskami prosto w twarz, tak od niechcenia. ",shape=box,color=blue];
		j2392273244 -> j2389195802;
	j733702184 [label="Cóż, tym właśnie jesteś, prawda? Tenno przejęli od Orokin władzę nad Systemem Origin. A ty, niczym kukułka, wkradłeś się do tego świata ze swojego.",shape=box,color=blue];
		j733702184 -> j83410202;
	j2946414719 [label="Ha! Obelga? Musisz mieć anielską cierpliwość, skoro myślisz, że przez tyle dni obrzucałem cię wyzwiskami prosto w twarz, tak od niechcenia.",shape=box,color=blue];
