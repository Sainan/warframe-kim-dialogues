		j945773226 -> j538985223;
	j145537141 [label="Ha! Prawie słyszę westchnienie z Sanktuarium. Czy wszyscy byli tacy jak ja? Nie. Byli znacznie gorsi. I o wiele bardziej irytujący, niestety.",shape=box,color=blue];
		j145537141 -> j1038748661;
	j1381970504 [label="Hm… nie. Ale doceniam pokaz odpowiednich manier. Musisz zasłużyć na swoje tytuły u mnie, Uzurpatorze Wiesz o tym.",shape=box,color=blue];
		j1381970504 -> j1038748661;
