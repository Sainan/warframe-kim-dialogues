		j2389195802 -> j3777118036 [label=false,color=brown];
	j83410202 [label="A to czyni cię Uzurpatorem, z co najmniej dwóch powodów. (A może i z trzech, jeśli weźmiemy pod uwagę to, co sługa powiedział mi o Duviri, ale to temat na inny dzień.)",shape=box,color=blue];
		j83410202 -> j1032514279;
