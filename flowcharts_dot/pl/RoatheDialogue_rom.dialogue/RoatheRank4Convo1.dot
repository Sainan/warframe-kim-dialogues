	2358 [label="Ciągle nazywasz mnie \"Uzurpatorem\". Czy to ma być obelga?",shape=box,color=red];
		2358 -> 2364;
	2359 [label="[Koniec]",shape=box,color=red];
		2359 -> 2365;
	2361 [label="Update boolean RoatheUsurper",color=orange];
		2361 -> 2367;
	2362 [label="Powiem tylko, że to trochę niedorzeczne, jeśli masz na myśli obelgę, skoro masz to samo na sumieniu.",shape=box,color=red];
		2362 -> 2368;
	2363 [label="Próbuję zrozumieć, dlaczego ciągle mnie tak tytułujesz.",shape=box,color=red];
		2363 -> 2369;
	2366 [label="[Koniec]",shape=box,color=red];
		2366 -> 2371;
	2364 [label="Ha! Mało tego! Musisz mieć anielską cierpliwość, skoro myślisz, że przez tyle dni obrzucałem cię wyzwiskami prosto w twarz, tak od niechcenia. ",shape=box,color=blue];
		2364 -> 2370;
	2365 [label="Chat ends.",color=orange];
	2367 [label="Cóż, tym właśnie jesteś, prawda? Tenno przejęli od Orokin władzę nad Systemem Origin. A ty, niczym kukułka, wkradłeś się do tego świata ze swojego.",shape=box,color=blue];
		2367 -> 2372;
	2368 [label="Ha! Obelga? Musisz mieć anielską cierpliwość, skoro myślisz, że przez tyle dni obrzucałem cię wyzwiskami prosto w twarz, tak od niechcenia.",shape=box,color=blue];
		2368 -> 2373;
	2369 [label="+5 Chemistry",color=orange];
		2369 -> 2374;
	2371 [label="Chat ends.",color=orange];
	2370 [label="Check boolean RoatheKnowsReset2",color=orange];
		2370 -> 2375 [label=true,color=green];
		2370 -> 2376 [label=false,color=brown];
	2372 [label="A to czyni cię Uzurpatorem, z co najmniej dwóch powodów. (A może i z trzech, jeśli weźmiemy pod uwagę to, co sługa powiedział mi o Duviri, ale to temat na inny dzień.)",shape=box,color=blue];
		2372 -> 2377;
		2372 -> 2378;
	2373 [label="Check boolean RoatheKnowsReset2",color=orange];
		2373 -> 2380 [label=true,color=green];
		2373 -> 2379 [label=false,color=brown];
	2374 [label="Bo to dokładnie to – tytuł. Honorowy przydomek. Osiągnąłeś to, do czego ja dążyłem. ",shape=box,color=blue];
		2374 -> 2381;
	2375 [label="Zwłaszcza gdy aż boli świadomość, jak wiele mocy tu posiadasz, a układ między nami jest daleki od jednostronności, mm?",shape=box,color=blue];
		2375 -> 2382;
	2376 [label="Szczególnie że doskonale wiem, iż mógłbyś użyć swoich mocy Pustki, przeniknąć przez ścianę i w każdej chwili posłać mi parę kul w tył czaszki.",shape=box,color=blue];
		2376 -> 2382;
	2377 [label="Więc... obrażasz mnie.",shape=box,color=red];
		2377 -> 2368;
	2378 [label="No dobrze. Więc czemu nadal używasz tego jako tytułu?",shape=box,color=red];
		2378 -> 2383;
	2380 [label="Zwłaszcza gdy aż boli świadomość, jak wiele mocy tu posiadasz, a układ między nami jest daleki od jednostronności, mm?",shape=box,color=blue];
		2380 -> 2384;
	2379 [label="Szczególnie że doskonale wiem, iż mógłbyś użyć swoich mocy Pustki, przeniknąć przez ścianę i w każdej chwili posłać mi parę kul w tył czaszki.",shape=box,color=blue];
		2379 -> 2384;
	2381 [label="Ten tytuł to tylko wyraz mojej lekkiej admiracji. Choć zawiera nutę sarkazmu, którą uważam za całkiem atrakcyjną, przyznaję.",shape=box,color=blue];
		2381 -> 2385;
		2381 -> 2386;
		2381 -> 2387;
		2381 -> 2388;
	2382 [label="Nie mam ochoty robić z ciebie wroga, Uzurpatorze. Nie. To nie jest zniewaga. To wyłącznie przez twoje własne niedopatrzenie nie zauważyłeś, jak wiele z mojej przeszłości splata się z twoją.",shape=box,color=blue];
		2382 -> 2389;
	2383 [label="+5 Chemistry",color=orange];
		2383 -> 2374;
	2384 [label="Nie mam ochoty robić z ciebie wroga, Uzurpatorze. Nie. Jeśli już, to jest to przydomek honorowy. Osiągnąłeś to, do czego ja dążyłem. Nic więcej.",shape=box,color=blue];
		2384 -> 2381;
	2385 [label="Czy wszyscy Orokin byli tacy jak ty?",shape=box,color=red];
		2385 -> 2390;
	2386 [label="Gdybym poprosił cię grzecznie, byś nazywał mnie inaczej, zrobiłbyś to?",shape=box,color=red];
		2386 -> 2391;
	2387 [label="Zniosę to.",shape=box,color=red];
		2387 -> 2392;
	2388 [label="Przestań nazywać mnie Uzurpatorem.",shape=box,color=red];
		2388 -> 2393;
	2389 [label="Byłem zdeterminowany obalić Orokin – tak samo jak twój dzieciak, ten duplikat Tenno, i cała ich reszta. Po prostu zostałem wyrwany z osi czasu, zanim dostałem swoją szansę.",shape=box,color=blue];
		2389 -> 2394;
	2390 [label="+10 Chemistry",color=orange];
		2390 -> 2395;
	2391 [label="+5 Chemistry",color=orange];
		2391 -> 2396;
	2392 [label="+5 Chemistry",color=orange];
		2392 -> 2397;
	2393 [label="Hm...",shape=box,color=blue];
		2393 -> 2398;
	2394 [label="Update boolean RoatheTraitor1",color=orange];
		2394 -> 2381;
	2395 [label="Ha! Prawie słyszę westchnienie z Sanktuarium. Czy wszyscy byli tacy jak ja? Nie. Byli znacznie gorsi. I o wiele bardziej irytujący, niestety.",shape=box,color=blue];
		2395 -> 2399;
	2396 [label="Hm… nie. Ale doceniam pokaz odpowiednich manier. Musisz zasłużyć na swoje tytuły u mnie, Uzurpatorze Wiesz o tym.",shape=box,color=blue];
		2396 -> 2399;
	2397 [label="Dobrze. I tak nie miałeś w tej sprawie żadnego wyboru. ",shape=box,color=blue];
		2397 -> 2399;
	2398 [label="Nie.",shape=box,color=blue];
		2398 -> 2399;
	2399 [label="+5 Chemistry",color=orange];
		2399 -> 2400;
	2400 [label="Naprawdę, aż za bardzo mnie tym bawisz.",shape=box,color=blue];
		2400 -> 2401;
	2401 [label="Chat ends.",color=orange];
