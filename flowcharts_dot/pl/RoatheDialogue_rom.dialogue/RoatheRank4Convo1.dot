		j53411353 -> j321107106;
	j351501487 [label="Byłem zdeterminowany obalić Orokin – tak samo jak twój dzieciak, ten duplikat Tenno, i cała ich reszta. Po prostu zostałem wyrwany z osi czasu, zanim dostałem swoją szansę.",shape=box,color=blue];
		j351501487 -> j945773226;
