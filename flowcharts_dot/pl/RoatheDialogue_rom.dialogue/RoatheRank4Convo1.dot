	j124390250 [label="Bo to dokładnie to – tytuł. Honorowy przydomek. Osiągnąłeś to, do czego ja dążyłem. ",shape=box,color=blue];
		j124390250 -> j538985223;
	j4264429599 [label="Zwłaszcza gdy aż boli świadomość, jak wiele mocy tu posiadasz, a układ między nami jest daleki od jednostronności, mm?",shape=box,color=blue];
		j4264429599 -> j3290643681;
	j3777118036 [label="Szczególnie że doskonale wiem, iż mógłbyś użyć swoich mocy Pustki, przeniknąć przez ścianę i w każdej chwili posłać mi parę kul w tył czaszki.",shape=box,color=blue];
		j3777118036 -> j3290643681;
	j1032514279 [label="Więc... obrażasz mnie.",shape=box,color=red];
		j1032514279 -> j2946414719;
	j455535219 [label="No dobrze. Więc czemu nadal używasz tego jako tytułu?",shape=box,color=red];
		j455535219 -> j4189102519;
