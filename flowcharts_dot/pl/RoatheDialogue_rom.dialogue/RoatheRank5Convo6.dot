	j660096271 [label="Co sądzę o Marii? Poza tym, że spróbowałbym cię przekonać, żeby dołączyła do nas na noc czy dwie, mój drogi Włóczęgo? (żartuję)",shape=box,color=blue];
		j660096271 -> j3168038333;
	j3836403691 [label="Co sądzę o Marii? Poza tym, żeby spróbowałbym cię przekonać, żebym dołączył do was na noc czy dwie? (żartuję)",shape=box,color=blue];
		j3836403691 -> j1117880407;
	j1829198335 [label="Jak udało ci się przekonać ją do zmiany zdania na temat czystości Albrechta? Prawdziwy z ciebie \"cudotwórca\". Może powinni czcić nie Sol i Lua, ale ciebie.",shape=box,color=blue];
		j1829198335 -> j1693781742;
	j2051339407 [label="Nie miałem pojęcia, że każdego dnia zmaga się z bólem. Doskonale go ukrywa. Nie wspomniała o tym, zanim poznała cię. Pozwoliłeś nam nawiązać jakieś porozumienie.",shape=box,color=blue];
		j2051339407 -> j629152183;
	j690871730 [label="Do niedawna nie byłem świadom jej historii. Nie wspomniała o tym, zanim poznała cię. Pozwoliłeś nam nawiązać jakieś porozumienie.",shape=box,color=blue];
		j690871730 -> j706008133;
	j1008036143 [label="Takie samo, jak zawsze. Spędzam każdą chwilę, próbując nie urwać swojej własnej głowy, byle jej nie słuchać.",shape=box,color=blue];
		j1008036143 -> "Chat ends.";
	j2867072109 [label="Jest między nami lepiej, teraz kiedy mogę na kimś wyładowywać swoje frustracje. Ale mówiąc poważnie, jesteśmy w stanie osiągnąć porozumienie.",shape=box,color=blue];
		j2867072109 -> j3485010794;
	j78265439 [label="Ale to nie ja się z nim \"zmagam\", czyż nie? Ha! Wybacz ten okropny żart, nie mogłem się powstrzymać. Aż sam się prosiłeś.",shape=box,color=blue];
		j78265439 -> j238574093;
	j1708186138 [label="Sprawy zdają się toczyć lepiej, niż między tobą i nim. Jak udało ci się to zawalić? Potrzebował, tylko żeby ktoś go wysłuchał.",shape=box,color=blue];
		j1708186138 -> j3823132856;
	j976453287 [label="Napięcia między nami uległy znacznej poprawie, szczególnie kiedy dzięki tobie zyskał pewność siebie, by ujawnić swoje cierpienia.",shape=box,color=blue];
		j976453287 -> j2875927435;
	j932835948 [label="Napięcia między nami uległy znacznej poprawie, szczególnie kiedy dzięki tobie zyskał pewność siebie, by ujawnić swoje cierpienia.",shape=box,color=blue];
		j932835948 -> j3504446155;
	j2732023447 [label="Takie samo, jak zawsze. Spędzam każdą chwilę, próbując nie urwać swojej własnej głowy, byle go nie słuchać.",shape=box,color=blue];
		j2732023447 -> "Chat ends.";
	j1679088467 [label="Przyznaję, że z czasem, powoli zaczynam ich coraz bardziej tolerować. Myślę, że przez to, że powoli zaczynają odpuszczać i porzucać nadzieję, na nawrócenie mnie.",shape=box,color=blue];
		j1679088467 -> j3854181615;
	j1097388455 [label="Przyznaję, że z czasem, powoli zaczynam ich coraz bardziej tolerować. Myślę, że miały na to wpływ rzeczy, które niedawno zrozumiałem.",shape=box,color=blue];
		j1097388455 -> j195864646;
	j3793580292 [label="Coraz częściej zastanawiam się, dlaczego ja sam nie mogę wykorzystać Ciemnego Refraktorium, by odzyskać swoje wspomnienia, kiedy sam jestem protoframem...",shape=box,color=blue];
		j3793580292 -> j1597146737;
	j3168038333 [label="Zastanawiam się, czy zdaje sobie sprawę, że moje drażnienie z nią przeszło z irytacji w zabawę?",shape=box,color=blue];
		j3168038333 -> j3630971623;
	j1117880407 [label="Muszę przyznać, że wcale ci się nie dziwię. I nie chodzi tylko o to, że jest piękna. Też mam oczy. W tej kobiecie tkwią niespodziewane pokłady współczucia, których przetrwania bym się nie spodziewał w jej wieku.",shape=box,color=blue];
		j1117880407 -> j3168038333;
	j1693781742 [label="Ba. To właśnie taki język doprowadził do powstania Imperium Orokin. To jest błąd, którego świat nie powinien powtórzyć dwukrotnie.",shape=box,color=blue];
		j1693781742 -> j3168038333;
	j629152183 [label="Przyznaję, że jestem jednym z tych głupców, którzy nie potrafią wyobrazić sobie życia w taki sposób.",shape=box,color=blue];
		j629152183 -> j98582717;
	j706008133 [label="Pomyśleć, że własna rodzina wyrzuciła ją na ulicę. Własna rodzina. Tę Marię. Osobę, która skrywa niemożliwe pokłady współczucia?!",shape=box,color=blue];
		j706008133 -> j3951496100;
	j3485010794 [label="Znają moją... tajemnicę. Wiedzą, że przyjąłem serum dobrowolnie.",shape=box,color=blue];
		j3485010794 -> j96012310;
		j3485010794 -> j4105273446;
	j238574093 [label="Podziwiam cię za odwagę wobec tego szaleńca. Potrzebne jest mu towarzystwo. I współczucie.",shape=box,color=blue];
		j238574093 -> j787859919;
	j3823132856 [label="A ty go odrzuciłeś. Wstydziłbyś się.",shape=box,color=blue];
		j3823132856 -> "Chat ends.";
	j2875927435 [label="Powiedział mi o młodym Tenno, którego głos słyszał. I o tym, że nie słyszy już jego głosu.",shape=box,color=blue];
		j2875927435 -> j4176531578;
	j3504446155 [label="Wiedziałem szokująco mało o ty, co go spotkało. Powiedział mi o tym dopiero po tym, jak opowiedział to tobie. ",shape=box,color=blue];
		j3504446155 -> j2724208836;
	j3854181615 [label="Tylko się drażnię. Nawet zaczynam ich lubić, pomimo mojego odnowionego postanowienia, by ignorować wszelką ich krytykę na temat mojego życia.",shape=box,color=blue];
		j3854181615 -> j2356575623;
		j3854181615 -> j2880555720;
	j195864646 [label="Spodziewałem się, że moja skrucha spotka się z szyderstwami pokroju \"nareszcie ujrzał światło\" czy \"ostrzegaliśmy się\". Ale nie. Prawie o tym nie wspomnieli.",shape=box,color=blue];
		j195864646 -> j2478243610;
	j1597146737 [label="...jeśli to mnie nie powstrzyma przed utopieniem się w nim.",shape=box,color=blue];
		j1597146737 -> "Chat ends.";
	j3630971623 [label="Mam taką nadzieję. Drażnienie jej to świetna zabawa. Doprowadzanie jej do szału i słuchanie krzyków w jej ojczystym języku, to mój nowy ulubiony sport.",shape=box,color=blue];
		j3630971623 -> j3111977389;
	j98582717 [label="Co pozwala jej zachować taki spokój? Nie mówiąc już o współczuciu? Ja w takiej sytuacji bym oszalał, zupełnie jak towarzyszący jej ksiądz.",shape=box,color=blue];
		j98582717 -> j3168038333;
	j3951496100 [label="Nie potrafię ubrać w słowa swojego pragnienia, jak bardzo chcę wykorzystać Helmintha do podróży w przeszłość, by zamordować jej rodzinę. Delektować się każdą chwilą. Ale mam wrażenie, że ona może nie popierać tego pomysłu. ",shape=box,color=blue];
		j3951496100 -> j3289347132;
	j96012310 [label="Nic im nie powiedziałem.",shape=box,color=red];
		j96012310 -> j328515382;
	j4105273446 [label="Jak się dowiedzieli?",shape=box,color=red];
		j4105273446 -> j2912993115;
	j787859919 [label="Ale mówiąc poważnie, jesteśmy w stanie osiągnąć porozumienie.",shape=box,color=blue];
		j787859919 -> j3485010794;
	j4176531578 [label="Spodziewam się, że ten głos nie przestanie go prześladować w koszmarach na jawie. Ten biedak zawsze pozostanie niepewny granicy między rzeczywistością i fikcją.",shape=box,color=blue];
		j4176531578 -> j2224915711;
	j2724208836 [label="Nie potrafię ubrać w słowa swojego pragnienia, jak bardzo chcę wykorzystać Helmintha do podróży w przeszłość, by zamordować jego rodzinę. Delektować się każdą chwilą. Ale mam wrażenie, że on może nie popierać tego pomysłu.",shape=box,color=blue];
		j2724208836 -> j830416532;
	j2356575623 [label="Wasza trójka jest na siebie skazana, Entrati o to zadbał. Nie zaszkodzi, żebyście się polubili.",shape=box,color=red];
		j2356575623 -> j3255583227;
	j2880555720 [label="Bardzo mnie to cieszy. Myślę, że naprawdę im na tobie zależy.",shape=box,color=red];
		j2880555720 -> j2233549067;
	j2478243610 [label="Cieszę się, że tego nie zrobili. Nie chcę być karcony jak szczeniak, który narobił na dywan. Już dość użeram się z wewnętrznymi demonami.",shape=box,color=blue];
		j2478243610 -> j2356575623;
		j2478243610 -> j2880555720;
	j3111977389 [label="I jeszcze jeden powód, dlaczego sprawy między nami się poprawiły? Znają moją tajemnicę. Wiedzą, że przyjąłem serum dobrowolnie.",shape=box,color=blue];
		j3111977389 -> j1142400293;
		j3111977389 -> j1227099551;
