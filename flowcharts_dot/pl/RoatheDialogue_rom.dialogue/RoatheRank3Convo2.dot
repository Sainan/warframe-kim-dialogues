		1561 -> 1569;
	1560 [label="Ale zastanawiam się, czy się nie mylę. Zastanawiam się, czy \"partner\" to nie za mocne słowo na określenie tego, kim naprawdę byliśmy. ",shape=box,color=blue];
		1560 -> 1564;
