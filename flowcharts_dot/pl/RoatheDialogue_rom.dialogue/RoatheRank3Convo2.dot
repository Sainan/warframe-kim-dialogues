		1611 -> 1625;
	1612 [label="Wezmę to sobie do serca.",shape=box,color=red];
		1612 -> 1626;
	1613 [label="Nie planowałem tego, ale zapamiętam tę radę.",shape=box,color=red];
		1613 -> 1627;
	1614 [label="Fakt, że nigdy czegoś takiego nie doświadczyłeś, czyni cię nadzwyczaj szczęśliwym, Uzurpatorze. Nie polecam wplątywania się w taki układ, zazwyczaj kończy się to morderstwem jednego lub obu z was.",shape=box,color=blue];
		1614 -> 1628;
		1614 -> 1629;
		1614 -> 1630;
	1615 [label="Wyobrażanie sobie tego w myślach było jedyną rzeczą, która pozwalała mi znieść wiele długich spotkań. Przepraszam.",shape=box,color=blue];
		1615 -> 1628;
		1615 -> 1631;
