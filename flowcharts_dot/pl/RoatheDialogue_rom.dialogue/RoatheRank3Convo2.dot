		1635 -> 1649 [label=false,color=brown];
	1636 [label="Mhm. Mądra decyzja. Choć nasuwa to pytanie, czy to nie ja wpadłem ci w oko, Włóczęgo? Jeśli obawiasz się, czy przeszkadza mi to, że już kogoś masz, zupełnie mnie to nie obchodzi.",shape=box,color=blue];
