	1466 [label="Chat ends.",color=orange];
	1468 [label="Po co mnie o to pytasz? Czego próbujesz się dowiedzieć, Włóczęgo? Z pewnością nie chodzi ci o skrytkę z amunicją.",shape=box,color=blue];
		1468 -> 1470;
	1469 [label="Dlaczego pytasz? Chcesz wrócić w przeszłość i pobić swój rekord młodości? Szukasz porad, jak obalić totalitarny rząd? Szukasz składu amunicji, wystarczającego do zniszczenia całych planet?",shape=box,color=blue];
		1469 -> 1471;
	1470 [label="Dlaczego miałbym ci zaufać? Dlaczego ci zaufałem?!",shape=box,color=blue];
		1470 -> 1472;
