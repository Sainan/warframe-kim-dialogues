		1536 -> 1542;
	1537 [label="Zamordowanie Nitokh, rzecz jasna. Nie jest to zaskakujący zwrot akcji. Dobrze wiedziała, że było to prawdopodobne i regularnie się o to ze mną droczyła.",shape=box,color=blue];
