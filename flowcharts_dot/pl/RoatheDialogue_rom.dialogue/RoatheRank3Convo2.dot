		1591 -> 1606;
		1591 -> 1607;
	1592 [label="Jaki sens ma przeżywanie dawnych czynów, porażek i żalów? Nie zmienimy ich, nawet z darem podróży w czasie, próby powtórzenia tego, co już się stało, to prosta droga do szaleństwa.",shape=box,color=blue];
		1592 -> 1608;
	1593 [label="Ale nie możemy też zapomnieć o występkach naszego dawnego \"ja\", grozi nam to szaleństwem, staniem się despotami, dzikimi zwierzętami, które nie widzą żadnych wad w sobie, jedynie w innych.",shape=box,color=blue];
		1593 -> 1609;
	1594 [label="Myślisz czasem o innych swoich kochankach, czy tylko o niej?",shape=box,color=red];
		1594 -> 1610;
	1595 [label="Nie musisz przepraszać. Nadal jestem w szoku, jak bardzo nienawidziłeś swoich własnych ludzi.",shape=box,color=red];
		1595 -> 1611;
	1596 [label="Zalecam, żebyś nie przekształcał takich związków w stały romans. To staje się bardzo niezdrowe dla obu stron. Zazwyczaj kończy się morderstwem jednego z was lub obojga.",shape=box,color=blue];
		1596 -> 1594;
		1596 -> 1612;
		1596 -> 1613;
