	1507 [label="Gdybym odniósł tak wielką porażkę, po prostu wsadziłbym sobie lufę Lexa do ust.",shape=box,color=blue];
		1507 -> 1511;
	1508 [label="Każdy z tych planów miał oczekiwany rezultat. Każdy z nich miał swój określony cel. Wiele z nich wyglądało podobnie na pierwszy rzut oka, ale różniło się szczegółami.",shape=box,color=blue];
		1508 -> 1512;
	1510 [label="Co już ci o tym powiedziałem? Bo czuję, że jeszcze nie ufam ci na tyle, by opowiedzieć o wszystkim.",shape=box,color=blue];
		1510 -> 1515;
		1510 -> 1516;
