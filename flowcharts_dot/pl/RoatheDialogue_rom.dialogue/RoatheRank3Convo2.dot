		1550 -> 1558;
	1551 [label="Myślę, że lubiła wyzwania, Uzurpatorze. Poczucie zagrożenia. Emocje związane ze świadomością, że sypia z kimś, kto pragnie jej śmierci. ",shape=box,color=blue];
		1551 -> 1559;
	1552 [label="Chciałbym udawać, że byliśmy pierwszymi Orokin, którzy znaleźli się w takiej sytuacji, ale wcale nie było to aż tak niezwykłe.",shape=box,color=blue];
		1552 -> 1559;
	1554 [label="Dokładnie! Prawie jakbyś już to kiedyś usłyszał. Ale to nie jest zaskakujący zwrot akcji. Ona dość regularnie mnie tym drażniła.",shape=box,color=blue];
		1554 -> 1543;
		1554 -> 1544;
	1553 [label="Dokładnie! Ale to nie jest zaskakujący zwrot akcji. Ona była tego świadoma i dość regularnie mnie tym drażniła.",shape=box,color=blue];
		1553 -> 1543;
		1553 -> 1544;
	1557 [label="Oczywiście nie uważałem, że jesteśmy sobie równi. Była egzekutorką. Wielką Nitokh. Ale uważałem się za Najlepszego z Jej Podległych.",shape=box,color=blue];
		1557 -> 1561;
	1555 [label="Jesteś uroczy. Tak, w pewien sposób byliśmy partnerami biznesowymi. Byliśmy też partnerami w wielu innych, znaczących obszarach.",shape=box,color=blue];
		1555 -> 1556;
	1556 [label="W polityce, w intrydze, w łóżku.",shape=box,color=blue];
		1556 -> 1560;
	1558 [label="Wiedziała jednak, że za jej plecami ostrzyłem noże i z niecierpliwością czekałem na moment, w którym oddzielę jej głowę od ramion.",shape=box,color=blue];
		1558 -> 1562;
	1559 [label="Im dłużej żyję, tym bardziej uświadamiam sobie, że być może nie jesteśmy gatunkiem stworzonym do nieśmiertelności.",shape=box,color=blue];
		1559 -> 1563;
