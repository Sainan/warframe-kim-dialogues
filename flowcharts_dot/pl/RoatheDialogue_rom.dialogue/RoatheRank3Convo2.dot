		1584 -> 1591;
	1585 [label="Możesz mieć rację. Życie przeszłością jest niebezpieczne, obciążamy się żalem i wstydem, i niczym więcej. ",shape=box,color=blue];
		1585 -> 1592;
	1586 [label="Możesz mieć rację. Życie przeszłością jest niebezpieczne, obciążamy się żalem i wstydem, i niczym więcej. ",shape=box,color=blue];
		1586 -> 1593;
	1587 [label="Wyobrażanie sobie tego w myślach było jedyną rzeczą, która pozwalała mi znieść wiele moich... obowiązkowych wieczorów w jej łóżku. Przepraszam.",shape=box,color=blue];
		1587 -> 1594;
		1587 -> 1595;
	1588 [label="To, że wierzysz, że te dwie rzeczy się wykluczają, jest przeurocze. Mam nadzieję, że kiedyś będziesz miał okazję spędzić wieczór z taką \"znajomą\", to naprawdę magiczne.",shape=box,color=blue];
		1588 -> 1596;
	1589 [label="Musisz zrozumieć, że było to również przesiąknięte najgłębszą i najbardziej przytłaczającą nienawiścią. Gardziłem nią jednocześnie i niczego nie pragnąłbym bardziej niż powolnego, ostrożnego, delikatnego zdzierania jej niebieskiej skóry z ciała gołymi rękami.",shape=box,color=blue];
