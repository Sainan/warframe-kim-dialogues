		j129294877 -> j3303524056;
	j3716424869 [label="O co próbowałeś zapytać? Ach! Tak. \"Jak chciałeś obalić Egzekutorów?\"",shape=box,color=blue];
		j3716424869 -> j767980691;
	j2437577276 [label="Powtarzając te same bezcelowe dyskusje o tym, dlaczego chciałem zamordować ludzi, którzy od dawna nie żyją? Przynajmniej to pragmatyczne podejście.",shape=box,color=blue];
		j2437577276 -> j3716424869;
	j789039262 [label="Te plany były więcej niż złożone. Plany w planach. Zabójcy, gotowi zabić zabójców innych zabójców, wysłanych zabić ich, gdyby zabójca odniósł porażkę.",shape=box,color=blue];
