		1640 -> 1658;
	1641 [label="Mimo wszystkich naszych osiągnięć, mimo całej pracy, jaką włożyliśmy w ratowanie ludzkości, nigdy nie rozwiązaliśmy największego problemu, który dręczył nasze serca. Największej wady, która toczyła nasze dusze niczym rak.",shape=box,color=blue];
		1641 -> 1659;
	1642 [label="Zadbaj o to. Wygląda na to, że robisz wszystko, co w twojej mocy, by wieść godne życie, Włóczęgo. By być \"dobrym\" człowiekiem. Nie chciałbym, żebyś skończył jak Orokin. Definiowały nas nasze żądze.",shape=box,color=blue];
		1642 -> 1660;
	1643 [label="Proszę bardzo. Wygląda na to, że robisz wszystko, co w twojej mocy, by wieść godne życie, Włóczęgo. By być \"dobrym\" człowiekiem. Nie chciałbym, żebyś skończył jak Orokin. Definiowały nas nasze żądze.",shape=box,color=blue];
		1643 -> 1660;
	1644 [label="Tak naprawdę, Włóczęgo, miałem partnerów tylko w sensie fizycznym. Nigdy emocjonalnym. A przynajmniej uczucia nigdy nie były odwzajemnione.",shape=box,color=blue];
		1644 -> 1661;
		1644 -> 1662;
