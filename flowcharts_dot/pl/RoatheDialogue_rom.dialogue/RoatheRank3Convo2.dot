		1575 -> 1580;
		1575 -> 1581;
	1576 [label="Co za bezczelne pytanie! Chyba cię uwielbiam za to, że je zadałeś. Wiesz, chyba ją kochałem, tylko trochę. Szczerze mówiąc, nawet nie zastanawiałem się nad tym aż do tej chwili.",shape=box,color=blue];
