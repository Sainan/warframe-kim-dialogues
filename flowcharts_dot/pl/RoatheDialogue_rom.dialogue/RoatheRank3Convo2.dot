		1512 -> 1519;
	1515 [label="Wszystko mi już wyśpiewałeś.",shape=box,color=red];
		1515 -> 1522;
	1516 [label="Więc nie będę cię zmuszać, żebyś powiedział mi więcej, niż jesteś gotów.",shape=box,color=red];
