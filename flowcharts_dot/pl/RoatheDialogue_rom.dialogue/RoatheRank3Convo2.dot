	j3441851017 [label="Po co mnie o to pytasz? Czego próbujesz się dowiedzieć, Włóczęgo? Z pewnością nie chodzi ci o skrytkę z amunicją.",shape=box,color=blue];
		j3441851017 -> j4139668094;
	j2160185953 [label="Dlaczego pytasz? Chcesz wrócić w przeszłość i pobić swój rekord młodości? Szukasz porad, jak obalić totalitarny rząd? Szukasz składu amunicji, wystarczającego do zniszczenia całych planet?",shape=box,color=blue];
