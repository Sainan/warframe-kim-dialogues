		1567 -> 1572;
	1568 [label="Nie żałuj tego, co zrobiłeś. Takie decyzje podjąłeś. Nie cofniesz tego.",shape=box,color=red];
		1568 -> 1573;
	1569 [label="Jedyne co możemy zrobić, by odpłacić się za przeszłość, to iść przed siebie z podniesioną głową.",shape=box,color=red];
		1569 -> 1574;
	1564 [label="Przecież była Wielką Nitokh. Egzekutorką.",shape=box,color=blue];
		1564 -> 1561;
	1570 [label="Na Pustkę, nie! Gdyby pewnego popołudnia wyszła pijana przez śluzę powietrzną, rozwiązałoby to wiele moich cholernych problemów.",shape=box,color=blue];
		1570 -> 1575;
	1571 [label="+5 Chemistry",color=orange];
		1571 -> 1576;
	1572 [label="Na Pustkę, nie! Nigdy nie ufaj Orokin, Włóczęgo. W tym mnie. Zwłaszcza mnie! Kochaj nas, nienawidź, adoruj, gardź nami, ale nigdy, przenigdy nam nie ufaj.",shape=box,color=blue];
