		1480 -> 1486;
	1483 [label="Wiem. I nadal jest mi bardzo przykro.",shape=box,color=red];
		1483 -> 1489;
	1481 [label="Próbuję doprowadzić cię do stanu, w którym zrozumiesz.",shape=box,color=red];
		1481 -> 1487;
	1482 [label="Nadal mi przykro, że nadużyłem twojego zaufania, Roathe. Nie chciałem tego.",shape=box,color=red];
		1482 -> 1488;
	1484 [label="Żałuję tylko tego, że ten plan nigdy nie doszedł do skutku. Żałuję zmarnowanego czasu.",shape=box,color=blue];
		1484 -> 1490;
	1485 [label="I to było arcydzieło, mój Uzurpatorze.",shape=box,color=blue];
		1485 -> 1490;
	1486 [label="Praktyczny jesteś. Ale wiele miejsc, w których \"ukryłem\" swoje zasoby, mogło... zawędrować daleko przez te wiele, wiele lat, które minęło od tego czasu.",shape=box,color=blue];
		1486 -> 1491;
	1489 [label="Tak, tak. Chyba powinniśmy kontynuować tę durną rozmowę, po raz kolejny powtarzając rozmowy, które już odbyliśmy.",shape=box,color=blue];
		1489 -> 1493;
	1487 [label="+5 Chemistry",color=orange];
		1487 -> 1492;
	1488 [label="Tak, mogłeś wierzyć, że twoje czyny nie mają konsekwencji. Bez względu na to, powinniśmy wrócić do tej durnej rozmowy, w której omawiamy to, co omówiliśmy już w przeszłości.",shape=box,color=blue];
		1488 -> 1493;
	1490 [label="+5 Chemistry",color=orange];
		1490 -> 1494;
	1491 [label="A wiele z tych lokacji pozostaje nieznane nawet mnie. Ten plan był więcej niż złożony.",shape=box,color=blue];
		1491 -> 1495;
	1493 [label="O co próbowałeś zapytać? Ach! Tak. \"Jak chciałeś obalić Egzekutorów?\"",shape=box,color=blue];
		1493 -> 1496;
	1492 [label="Powtarzając te same bezcelowe dyskusje o tym, dlaczego chciałem zamordować ludzi, którzy od dawna nie żyją? Przynajmniej to pragmatyczne podejście.",shape=box,color=blue];
		1492 -> 1493;
	1494 [label="Te plany były więcej niż złożone. Plany w planach. Zabójcy, gotowi zabić zabójców innych zabójców, wysłanych zabić ich, gdyby zabójca odniósł porażkę.",shape=box,color=blue];
		1494 -> 1497;
	1495 [label="Zabójcy, gotowi zabić zabójców innych zabójców, wysłanych zabić ich, gdyby zabójca odniósł porażkę.",shape=box,color=blue];
		1495 -> 1497;
	1496 [label="Dlaczego?",shape=box,color=blue];
		1496 -> 1473;
		1496 -> 1474;
		1496 -> 1475;
	1497 [label="Wiele budynków zostało zaminowanych, całe statki i księżyce przygotowane do detonacji kradzionymi materiałami wybuchowymi. Kolej Solarna gotowa do wypadnięcia z orbity.",shape=box,color=blue];
		1497 -> 1498;
	1498 [label="A wszystko to miało sprawiać pozory \"Wielkiej Katastrofy Świadomych\". Nitokh i ja mieliśmy ogłosić stan wyjątkowy w Imperium, kiedy tylko... rozwiązalibyśmy kwestię Egzekutorów i Imperatorów.",shape=box,color=blue];
		1498 -> 1499;
