	1606 [label="Nie. Przykro mi, nie jesteś w moim typie.",shape=box,color=red];
		1606 -> 1620;
	1607 [label="Jesteś. Po prostu ci nie ufam.",shape=box,color=red];
		1607 -> 1621;
	1608 [label="Nie. Jestem, czym jestem. Jestem, kim jestem. Podążam ścieżką, którą wybrałem i minęła już pora, żebym chciał przepraszać za siebie. Nie zmienię siebie, żeby przypodobać się innym.",shape=box,color=blue];
		1608 -> 1622;
	1609 [label="To była cecha, którą dostrzegałem u wielu najbiedniejszych Egzekutorów i Imperatorów – ślepa wiara jedynie w swoją nieskazitelną i niewinną naturę. Gardziłem nimi za to i przysiągłem sobie, że nigdy nie podzielę takiej egoistycznej pychy.",shape=box,color=blue];
		1609 -> 1622;
	1610 [label="Tak naprawdę, Włóczęgo, miałem partnerów tylko w sensie fizycznym. Nigdy emocjonalnym. A przynajmniej uczucia nigdy nie były odwzajemnione.",shape=box,color=blue];
		1610 -> 1623;
		1610 -> 1624;
