		j2957309504 -> j4171842828;
	j1808711218 [label="To może być wartościowa wiedza, jeśli ukryłeś tę broń gdzieś, dokąd nadal można uzyskać dostęp.",shape=box,color=red];
		j1808711218 -> j3995488249;
	j4233711239 [label="Wybaczyłem ci ten czyn. Ale chciałbym tylko pamiętać, dlaczego... dlaczego! Dlaczego akurat ty?!",shape=box,color=blue];
