	1618 [label="+5 Chemistry",color=orange];
		1618 -> 1634;
	1617 [label="Jest z niej ślicznotka, nie dziwię ci się. Ale nie wiem, czy byłbym zdolny znieść jej pobożne ględzenie.",shape=box,color=blue];
		1617 -> 1633;
	1616 [label="Jest całkiem przystojny. Ale wygląda, jakby byle zwiędnięty kwiat wystarczył, by ogłosił koniec świata i rzucił się z najbliższej wieży.",shape=box,color=blue];
		1616 -> 1633;
	1619 [label="Ale zastanawiam się, które z nich wpadło ci w oko, jeśli w ogóle.",shape=box,color=blue];
		1619 -> 1635;
