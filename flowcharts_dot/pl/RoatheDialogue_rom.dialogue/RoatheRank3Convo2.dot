		1634 -> 1648;
	1633 [label="Rób, jak uważasz i daj mi znać, jeśli będziesz potrzebować pomocy. Niezwykle bawi mnie wizja oglądania, jak wpadasz w sieć emocjonalnych zawiłości z kimś, kto jest religijnym fanatykiem.",shape=box,color=blue];
