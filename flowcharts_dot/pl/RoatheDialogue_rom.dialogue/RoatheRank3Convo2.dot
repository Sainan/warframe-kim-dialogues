		1597 -> 1614;
	1598 [label="To było... wyraziste.",shape=box,color=red];
		1598 -> 1615;
	1601 [label="Uznałem, że powinienem cię ostrzec, ze względu na nasz mały... układ.",shape=box,color=blue];
		1601 -> 1618;
	1600 [label="Mhm, ale to nie będzie dla ciebie problem, prawda? Zapatrzyłeś się już na nasz mały \"układ\" z Marią.",shape=box,color=blue];
		1600 -> 1617;
	1599 [label="Mhm, ale to nie będzie dla ciebie problem, prawda? Zapatrzyłeś się już na szalonego księdza, czyż nie?",shape=box,color=blue];
		1599 -> 1616;
	1602 [label="Uznałem, że powinienem cię ostrzec, ponieważ... znamy już swoje cele.",shape=box,color=blue];
