		j308351428 -> j2940721971;
	j3334887960 [label="I to było arcydzieło, mój Uzurpatorze.",shape=box,color=blue];
		j3334887960 -> j2940721971;
	j236764503 [label="Praktyczny jesteś. Ale wiele miejsc, w których \"ukryłem\" swoje zasoby, mogło... zawędrować daleko przez te wiele, wiele lat, które minęło od tego czasu.",shape=box,color=blue];
		j236764503 -> j129294877;
	j2630874106 [label="Tak, tak. Chyba powinniśmy kontynuować tę durną rozmowę, po raz kolejny powtarzając rozmowy, które już odbyliśmy.",shape=box,color=blue];
		j2630874106 -> j3716424869;
	j388473287 [label="+5 Chemistry",color=orange];
		j388473287 -> j2437577276;
	j3316195789 [label="Tak, mogłeś wierzyć, że twoje czyny nie mają konsekwencji. Bez względu na to, powinniśmy wrócić do tej durnej rozmowy, w której omawiamy to, co omówiliśmy już w przeszłości.",shape=box,color=blue];
