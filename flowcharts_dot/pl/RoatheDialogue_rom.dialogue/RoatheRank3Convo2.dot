		1472 -> 1476 [label=false,color=brown];
	1473 [label="Szczerze zastanawiam się, czy żałujesz swoich czynów. Czy zmieniłbyś swoje plany, gdybyś mógł spróbować ponownie.",shape=box,color=red];
		1473 -> 1478;
	1474 [label="Jestem zafascynowany procesem, który doprowadził do takiego planu. To musiało być arcydzieło.",shape=box,color=red];
		1474 -> 1479;
	1475 [label="To może być wartościowa wiedza, jeśli ukryłeś tę broń gdzieś, dokąd nadal można uzyskać dostęp.",shape=box,color=red];
		1475 -> 1480;
	1477 [label="Wybaczyłem ci ten czyn. Ale chciałbym tylko pamiętać, dlaczego... dlaczego! Dlaczego akurat ty?!",shape=box,color=blue];
		1477 -> 1483;
		1477 -> 1481;
