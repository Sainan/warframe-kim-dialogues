		1517 -> 1524;
	1518 [label="Tak po prostu zgodziłbyś się na śmierć?",shape=box,color=red];
		1518 -> 1525;
	1519 [label="Gdyby to był umiarkowany sukces, co było najbardziej prawdopodobne, konieczne byłoby przeprowadzenie porządków, aby upewnić się, że pozostałe kwestie zostały \"uprzątnięte\". Oczywiście, ja również byłem jednym z tych problemów. I podjąłem kroki, aby upewnić się, że w perspektywie krótkoterminowej nadal byłbym zbyt cenny, aby zostać ścięty razem z resztą.",shape=box,color=blue];
		1519 -> 1526;
	1522 [label="Więc nie ma większego sensu, bym się znowu powtarzał, prawda? W rzeczy samej dalsza rozmowa nie ma większego sensu. Miłego dnia.",shape=box,color=blue];
