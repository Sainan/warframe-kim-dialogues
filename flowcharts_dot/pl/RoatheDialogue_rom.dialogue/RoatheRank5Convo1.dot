		3308 -> 3324;
	3309 [label="Włóczęgo, kochany, błagam cię teraz. Jeśli kiedykolwiek ci na mnie zależało, jeśli w tamtych słowach była odrobina prawdy, to proszę cię o jeszcze jedną, ostatnią przysługę. A to, o co teraz proszę, leży w twoim własnym interesie.",shape=box,color=blue];
		3309 -> 3325;
