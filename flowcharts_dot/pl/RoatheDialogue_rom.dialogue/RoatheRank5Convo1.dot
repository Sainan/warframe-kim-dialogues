	3314 [label="Zapomniałem. Przepraszam!",shape=box,color=red];
		3314 -> 3331;
	3315 [label="Nie miałem zamiaru kłamać, po prostu nie zdawałem sobie sprawy z wagi tego problemu.",shape=box,color=red];
		3315 -> 3332;
	3316 [label="Wiem, że złamałem daną ci obietnicę. Przepraszam za to. Ale damy sobie z tym radę, razem.",shape=box,color=red];
		3316 -> 3333;
	3311 [label="Co?! Uspokój się. Zastanówmy się nad tym.",shape=box,color=red];
		3311 -> 3328;
	3312 [label="Przysięgam, że nie wiedziałem! A nawet gdybym wiedział, to i tak nie zmienia moich uczuć do ciebie, Roathe.",shape=box,color=red];
		3312 -> 3329;
	3313 [label="Możesz mnie nienawidzić, jeśli chcesz. Ale nie zrobię nic, dopóki najpierw tego nie rozwiążemy.",shape=box,color=red];
		3313 -> 3330;
	3320 [label="Ty...",shape=box,color=blue];
		3320 -> 3338;
	3321 [label="Nie zdawałeś sobie sprawy...",shape=box,color=blue];
		3321 -> 3339;
	3322 [label="O tak, \"staw temu czoła\". Tak jak ja to zrobiłam, kiedy zażyłem serum od Entratiego i uciekłam przed swoim losem jak tchórz?!",shape=box,color=blue];
		3322 -> 3340;
		3322 -> 3341;
	3317 [label="Wybacz mi, jeśli trudno mi w to uwierzyć. Określają nas chwile naszego życia. Jesteśmy jedynie ciągiem wspomnień, które prowadzą nas ku kolejnym. Dlatego wspomnienia są — były — tak święte dla Orokin.",shape=box,color=blue];
		3317 -> 3334;
	3318 [label="Nawet się nie waż... nie waż się mówić mi o \"uspokojeniu\"! Czy nie sądzisz, że mam pełne prawo czuć, jakby rozrywano mnie na dwoje?!",shape=box,color=blue];
		3318 -> 3335;
	3319 [label="Fascynujące. Fascynujące i nieoczekiwane. Wyjaśnij.",shape=box,color=blue];
		3319 -> 3336;
		3319 -> 3337;
	3323 [label="Już nie wiem kim jestem...",shape=box,color=blue];
		3323 -> 3342;
	3324 [label="Już nie wiem kim jestem...",shape=box,color=blue];
		3324 -> 3343;
	3325 [label="Jeśli kiedykolwiek pragniesz, by sługa wrócił na górę i pojednał się z rodziną Entratich, musisz zrobić to, co mówię. Musisz.",shape=box,color=blue];
		3325 -> 3344;
		3325 -> 3345;
	3326 [label="Czy stanę się tym, kim chcę się stać z własnej woli? Bardzo dobrze. Wybieram to;",shape=box,color=blue];
		3326 -> 3346;
	3327 [label="Czy stanę się tym, kim chcę się stać z własnej woli? Bardzo dobrze. Wybieram to;",shape=box,color=blue];
