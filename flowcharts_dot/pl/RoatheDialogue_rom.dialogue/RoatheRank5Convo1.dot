	3341 [label="Uspokój się. Zastanówmy się nad tym.",shape=box,color=red];
		3341 -> 3318;
	3334 [label="Niedawno całkowicie definicja mnie samego została zapisana na nowo. Wyryłem ją w swojej psychice niczym rozlany atrament.",shape=box,color=blue];
		3334 -> 3356;
	3335 [label="Czuję się, jakbym miał samoświadomość, samą podstawę mojego fundamentu, spękaną i rozdartą jak sama przeklęta Lua! Zapisaną ponownie rozmazanym atramentem. Tchórz!",shape=box,color=blue];
		3335 -> 3357;
	3336 [label="Możesz mnie nienawidzić, ile chcesz, Roathe. Ale zrobiłem to, co zrobiłem, bo tak było trzeba. Nie mogłeś się już przed tym ukrywać.",shape=box,color=red];
		3336 -> 3358;
	3337 [label="Myśl o mnie, co chcesz. Ale ja potrafię rozpoznać spiralę, gdy ją widzę.",shape=box,color=red];
		3337 -> 3359;
	3342 [label="Pod tymi wszystkimi warstwami.",shape=box,color=blue];
		3342 -> 3362;
	3343 [label="Pod tymi wszystkimi warstwami.",shape=box,color=blue];
		3343 -> 3363;
	3344 [label="Czyli co...?",shape=box,color=red];
		3344 -> 3364;
	3345 [label="Nie. Wiem, o co chcesz zapytać, ale odpowiedź brzmi: nie.",shape=box,color=red];
		3345 -> 3365;
	3346 [label="Zrzucam te łańcuchy wstydu i dawnego tchórzostwa. Zrzucam te kajdany rangi i uległości.",shape=box,color=blue];
