	3376 [label="Update boolean RoatheFail",color=orange];
		3376 -> 3398;
	3377 [label="Jeśli chcesz wybrać własną drogę? Dla siebie? Zrób to. Nie przepraszaj. Ale to twoja ścieżka wyboru, a nie kogoś innego.",shape=box,color=red];
		3377 -> 3399;
	3378 [label="Jeśli chcesz szukać przebaczenia, to możesz. Ale musisz tego chcieć. Musisz wybrać tę ścieżkę. Nikt inny nie jest w stanie tego zrobić za ciebie.",shape=box,color=red];
		3378 -> 3400;
	3381 [label="Kim jestem...?",shape=box,color=blue];
		3381 -> 3402;
	3382 [label="Kim jestem...?",shape=box,color=blue];
		3382 -> 3403;
	3383 [label="I to nasze przywiązanie do czasu. Proszę cię teraz. Nie, błagam cię, użyj daru teraz na mnie. Zabierz ode mnie te myśli. Zabierz ode mnie te wspomnienia.",shape=box,color=blue];
		3383 -> 3404;
	3384 [label="A więc dobrze. Niech tak będzie. Nie poproszę cię o to teraz. Jeśli nigdy nie zrobiłeś tego z czystej ciekawości, dla własnej zabawy, lub by cofnąć błędy, które popełniłeś w swoich relacjach z innymi?!",shape=box,color=blue];
		3384 -> 3404;
	3385 [label="Postanowiłem więc spędzić resztę swoich dni, naprawiając wszystkie krzywdy, które moi podli pobratymcy uznali za godne zadania temu systemowi od zarania czasów.",shape=box,color=blue];
		3385 -> 3405;
	3386 [label="Moje intrygi i zamysły o władzy są wyłącznie moje. A ty, mój drogi, słodki Włóczęgo, jesteś najważniejszy pośród nich… jeśli tylko zechcesz nimi władać.",shape=box,color=blue];
		3386 -> 3406;
	3392 [label="Mam do ciebie dwa słowa, których być może nie zapomnisz, bo jak słyszałem, są ci doskonale znane!",shape=box,color=blue];
		3392 -> 3414;
	3393 [label="Dobrze więc! Pozwól, że wrócę cię do tego, czymkolwiek zajmowałeś się wcześniej! Wybacz, że ci przeszkodziłem!",shape=box,color=blue];
		3393 -> 3392;
