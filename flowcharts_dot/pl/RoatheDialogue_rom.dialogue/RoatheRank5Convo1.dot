		j193243857 -> j2243099038;
	j303051039 [label="Jestem ostatnim z Orokin. Koronowanym pośród nich, póki nikt nie powstanie, by rzucić mi wyzwanie. I będę kapitanem własnych spraw aż do dnia, w którym moje życie zostanie zgaszone.",shape=box,color=blue];
