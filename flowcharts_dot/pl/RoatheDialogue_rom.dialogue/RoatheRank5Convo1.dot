		j1400472777 -> j770630554;
	j3136472619 [label="Mówiłem ci, żebyś zakończył swoje wyprawy do mojego umysłu, zanim będzie za późno! Mówiłem ci, żebyś zaprzestał swoich wysiłków, a jednak... a jednak!",shape=box,color=blue];
		j3136472619 -> j1052492085;
	j2324667890 [label="Czy ukrywałeś to przede mną, tylko po to, żeby teraz to ujawnić? Czy to wszystko było dla ciebie chorą grą?! Karmienie tego czegoś, co się we mnie skrywało, wiedząc, co mnie czeka?!",shape=box,color=blue];
		j2324667890 -> j1913759712;
	j3742299496 [label="Co teraz, kochanie? Co teraz...? Czuję, że jestem u kresu sił. Przynajmniej wcześniej mogłem w obronie otoczyć się moim poniżeniem!",shape=box,color=blue];
		j3742299496 -> j3518277273;
	j1261528978 [label="Co teraz, Uzurpatorze? Co teraz...? Czuję, że jestem u kresu sił. Przynajmniej wcześniej mogłem w obronie otoczyć się moim poniżeniem!",shape=box,color=blue];
		j1261528978 -> j2846635412;
	j2901618524 [label="Rozumiem. Uwierz mi, bardziej niż ty. Rozumiem.",shape=box,color=blue];
		j2901618524 -> j1766744328;
	j1925344344 [label="Naprawdę cię kocham. Jakąkolwiek postać przyjmiesz. Kimkolwiek zechcesz być. Kocham cię.",shape=box,color=red];
		j1925344344 -> j3434439331;
	j295955506 [label="Mówiłem ci, żebyś zakończył swoje wyprawy do mojego umysłu, zanim będzie za późno! Mówiłem ci, żebyś zaprzestał swoich wysiłków, a jednak... a jednak!",shape=box,color=blue];
		j295955506 -> j2877254930;
	j770630554 [label="Czy ukrywałeś to przede mną, tylko po to, żeby teraz to ujawnić? Czy to wszystko było dla ciebie chorą grą?! Karmienie tego czegoś, co się we mnie skrywało, wiedząc, co mnie czeka?!",shape=box,color=blue];
