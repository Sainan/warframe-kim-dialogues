	j1782686658 [label="Oszkalowana, niezrozumiana, wyklęta. Strącona z niebios i pozostawiona, by gnić. Pokrewne duchy, doprawdy!",shape=box,color=blue];
		j1782686658 -> j1930776001;
	j1954654954 [label="Wiem, że to nie pierwszy raz, gdy przez to przechodzimy. Pamiętam, że byłem tu już kiedyś. I czuję, że może to nie być ostatni. Ciągle proszę cię, byś zatrzymał się w tym miejscu i zaczął od nowa, a fakt, że tak czynisz, znaczy dla mnie wszystko.",shape=box,color=blue];
		j1954654954 -> j4136729564;
