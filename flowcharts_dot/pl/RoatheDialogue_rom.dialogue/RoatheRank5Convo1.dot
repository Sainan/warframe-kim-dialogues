		j3973594721 -> j3079240589;
	j306032007 [label="To nie ukoi bólu głębokich wspomnień, Roathe... tylko tych powierzchownych. To nie rozwiąże problemu.",shape=box,color=red];
		j306032007 -> j804041526;
	j711176513 [label="Jesteś pewien? Chcesz, żebym... znowu usunął ci pamięć?",shape=box,color=red];
		j711176513 -> j1057793703;
	j1942849240 [label="Nie, Roathe. Porozmawiajmy o tym. Zaczynanie tego od nowa niczego nie naprawi. Musimy położyć temu kres.",shape=box,color=red];
