	j2969001558 [label="Dałeś mi słowo. Słowo! Ale teraz okazuje się, że jesteś zwykłym kłamcą!",shape=box,color=blue];
		j2969001558 -> j3927221762;
		j2969001558 -> j2111674407;
	j1337254594 [label="Powinienem był wiedzieć. Powinienem był wiedzieć, żeby ci nie ufać, ty anomalio zrodzona z Pustki! Czy wiedziałeś, co tam na mnie czyha?! Czy jakimś sposobem poznałeś prawdę, a ja nie?!",shape=box,color=blue];
		j1337254594 -> j4155385289;
		j1337254594 -> j113313260;
	j2626203289 [label="I oto znów jesteśmy tam, gdzie zaczęliśmy. Znów stąpamy po trupach naszej przeszłości. Nie jesteśmy wcale lepsi niż przedtem.",shape=box,color=blue];
		j2626203289 -> j4097935718;
	j3852799706 [label="Z powodów, które najwyraźniej nie są moimi własnymi, jak się wydaje! Mimo to pamiętam mękę, jaką odczuwałem, decydując się na wzięcie tego serum.",shape=box,color=blue];
		j3852799706 -> j4097935718;
	j2761637360 [label="I oto znów jesteśmy tam, gdzie zaczęliśmy. Znów stąpamy po trupach naszej przeszłości. Nie jesteśmy wcale lepsi niż przedtem.",shape=box,color=blue];
		j2761637360 -> j1665024845;
	j1908322554 [label="Z powodów, które najwyraźniej nie są moimi własnymi, jak się wydaje! Mimo to pamiętam mękę, jaką odczuwałem, decydując się na wzięcie tego serum.",shape=box,color=blue];
		j1908322554 -> j1665024845;
	j1833846359 [label="Kiedyś wypowiedziałeś do mnie słowa, o których nie wiedziałem, że mogą być prawdziwe. Powiedz mi raz jeszcze, że to prawda. Powiedz to. Proszę. Potrzebuję ich teraz. Bardziej niż kiedykolwiek.",shape=box,color=blue];
		j1833846359 -> j2143858673;
		j1833846359 -> j636854614;
	j1165555969 [label="Dałeś mi słowo. Słowo! I tak cudownie osłodziłeś je słowami czułości. Ale teraz okazuje się, że jesteś zwykłym kłamcą!",shape=box,color=blue];
		j1165555969 -> j3420743363;
		j1165555969 -> j1328624281;
	j2121150415 [label="Czy wiedziałeś?! Czy wiedziałeś?! I czy znalazłeś drogę do mnie, szepcząc czułe słowa, mając nadzieję złagodzić cios, który będzie musiał nastąpić?",shape=box,color=blue];
		j2121150415 -> j1566079780;
		j2121150415 -> j1400472777;
