	3379 [label="Mam do ciebie dwa słowa, których być może nie zapomnisz, bo jak słyszałem, są ci doskonale znane!",shape=box,color=blue];
		3379 -> 3401;
	3380 [label="Pozwól więc, że ci to uproszczę!",shape=box,color=blue];
		3380 -> 3379;
	3374 [label="Czy to właśnie od tego chciałem się uwolnić, za każdym razem, gdy miałem ochotę wbić w siebie te pazury i rozerwać własną skórę?!",shape=box,color=blue];
		3374 -> 3394;
	3375 [label="Evaluate expressions",color=orange];
		3375 -> 3397 [label="RoatheForgivenessShortcut",color=purple];
		3375 -> 3396 [label="RoatheVillainyShortcut",color=purple];
