		3397 -> 3422;
	3396 [label="Dobrze. Złość się. Ale użyj tej złości do czegoś wartościowego. Użycz jej siły, by strząsnąć z siebie tę nienawiść, którą kierujesz nie tam, gdzie trzeba.",shape=box,color=red];
