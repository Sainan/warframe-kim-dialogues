		3359 -> 3377;
		3359 -> 3378;
	3362 [label="Pod wspomnieniami, pod zewnętrzną powłoką Orokin, pod tą... niebieską skórą i Plagą, pod Urielem i tą maską Wiceregenta Grand Carnusa Roathe'a, którą noszę...",shape=box,color=blue];
		3362 -> 3381;
	3363 [label="Pod wspomnieniami, pod zewnętrzną powłoką Orokin, pod tą... niebieską skórą i Plagą, pod Urielem i tą maską Wiceregenta Grand Carnusa Roathe'a, którą noszę...",shape=box,color=blue];
		3363 -> 3382;
	3364 [label="Masz dar. Dar zdolny cofnąć czas. Zawinąć go w spiralę, czy zamknąć w pętli. A to wywołuje… interesujący efekt w umysłach Protoframe’ów, przez ich powiązanie z Plagą oraz z samym czasem.",shape=box,color=blue];
		3364 -> 3383;
	3365 [label="Czy możesz mi powiedzieć, że nigdy nie użyłeś swoich darów, aby igrać z umysłami Protoframe'ów, które nazywasz przyjaciółmi i kochankami, i możesz to powiedzieć bez kłamstwa w duszy?",shape=box,color=blue];
		3365 -> 3384;
	3366 [label="Jestem ostatnim z Orokin. Koronowanym pośród nich, póki nikt nie powstanie, by rzucić mi wyzwanie. I będę kapitanem własnych spraw aż do dnia, w którym moje życie zostanie zgaszone.",shape=box,color=blue];
		3366 -> 3385;
	3367 [label="Jestem ostatnim z Orokin. Koronowanym pośród nich, póki nikt nie powstanie, by rzucić mi wyzwanie. I będę kapitanem własnych spraw aż do dnia, w którym moje życie zostanie zgaszone.",shape=box,color=blue];
		3367 -> 3386;
