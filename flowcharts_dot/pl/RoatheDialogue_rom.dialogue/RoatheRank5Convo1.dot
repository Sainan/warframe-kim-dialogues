	3398 [label="Nie wiem, Uzurpatorze. I w tym tkwi największy problem.",shape=box,color=blue];
		3398 -> 3423;
	3399 [label="Nie definiują cię opinie innych. Ani to, co sądzą o twoich czynach. Określa cię jedynie to, w co wierzysz o sobie samym, i twoje własne wybory.",shape=box,color=red];
		3399 -> 3424;
	3400 [label="Nie definiuje cię twoja przeszłość, Roathe. Definiuje cię twoja przyszłość. A ty wciąż masz przyszłość, którą możesz wykorzystać, w przeciwieństwie do Orokin, którzy zginęli podczas Nocy Bębnów Naga.",shape=box,color=red];
		3400 -> 3425;
	3402 [label="Gdy wszystkie wspomnienia znikną, gdy wszystkie powrócą lawiną, gdy wszystko zostanie spalone, a potem znów do mnie wróci…",shape=box,color=blue];
		3402 -> 3427;
	3403 [label="Gdy wszystkie wspomnienia znikną, gdy wszystkie powrócą lawiną, gdy wszystko zostanie spalone, a potem znów do mnie wróci…",shape=box,color=blue];
		3403 -> 3428;
	3404 [label="Muszę zapomnieć o tym, jak wziąłem serum od Entratiego. A w połączeniu z bólem twoich odwołanych słów o miłości… mam w sobie tak wiele cierpienia, które chciałbym wymazać… Proszę.",shape=box,color=blue];
		3404 -> 3429;
		3404 -> 3430;
		3404 -> 3431;
	3405 [label="Przelaliśmy zbyt wiele krwi. Zabijaliśmy zbyt wielu. Zakończyliśmy zbyt wiele istnień. Popełniliśmy zbyt wiele błędów. A to, co mogę teraz zrobić, to tylko próbować, choć odrobinę, zrekompensować cokolwiek mi się uda.",shape=box,color=blue];
