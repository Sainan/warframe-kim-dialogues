	3356 [label="Więc może masz rację. Może to nie zmieni tego, kim jestem. Może tej części mnie nie da się przepisać na nowo. Ani teraz, ani nigdy.",shape=box,color=blue];
		3356 -> 3374;
	3357 [label="I ty śmiesz mówić mi, \"żebym się uspokoił\"?!",shape=box,color=blue];
