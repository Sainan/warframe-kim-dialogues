		j1718085457 -> j3560295836;
	j2591158708 [label="Masz dar. Dar zdolny cofnąć czas. Zawinąć go w spiralę, czy zamknąć w pętli. A to wywołuje… interesujący efekt w umysłach Protoframe’ów, przez ich powiązanie z Plagą oraz z samym czasem. ",shape=box,color=blue];
		j2591158708 -> j3744782193;
