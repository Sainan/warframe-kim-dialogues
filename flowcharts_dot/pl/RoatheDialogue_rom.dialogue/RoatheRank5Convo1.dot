	"Chat ends." [color=orange];
	j1641287006 [label="I teraz sobie przypominam, kochany Włóczęgo. Pamiętam, jak rozpaczliwie cię błagałem, żebyś mnie od tego uwolnił. I jak przysiągłeś, że to zrobisz. I tak zrobiłeś.",shape=box,color=blue];
		j1641287006 -> j2626203289;
	j2140639003 [label="I teraz sobie przypominam, kochany Włóczęgo. Teraz sobie przypominam, o co prosiłem i czego ty odmówiłeś. Prosiłem cię, żebyś wymazał mi te myśli z głowy, a ty odpowiedziałeś \"nie\". A jednak oto jesteśmy tutaj, mimo wszystko. Prawda?",shape=box,color=blue];
