		j3084973566 -> j1703388821;
	j2241850926 [label="Muszę cię pochwalić, Uzurpatorze, że spełniłeś moją prośbę i nie zabrnąłeś dalej w Ciemne Refraktorium ani w moje wspomnienia w Descendii. Pomimo iż nie łączyła nas żadna obietnica.",shape=box,color=blue];
		j2241850926 -> j3310234579;
	j3307384329 [label="Kochanie, muszę cię pochwalić, że dotrzymałeś słowa i nie zabrnąłeś dalej w Ciemne Refraktorium czy Descendię, by odzyskać ostatnie z moich wspomnień. To tak wiele dla mnie znaczy.",shape=box,color=blue];
		j3307384329 -> j30255394;
