		j3792657522 -> j1397070595;
	j1930776001 [label="Gdy zjawiły się psy, trzy energie były splecione z moją własną, czwarta już nawet nie dziwiła. Ta ogromna, przerażająca rzecz, która pragnęła rozerwać mnie jak skorupę planet, by wypłynąć na zewnątrz.",shape=box,color=blue];
		j1930776001 -> j620327609;
	j4136729564 [label="Pamiętam twoją obietnicę. I to, że znalazłem miejsce w twoim sercu tak głęboko, że trzymasz mnie w tym czyśćcu? Dziękuję, mój drogi. Dziękuję.",shape=box,color=blue];
		j4136729564 -> j30255394;
	j2709610695 [label="Że znalazłem w twoim sercu takie miejsce, iż trzymasz mnie w stanie wiecznego czyśćca? Dziękuję ci, moje słodkie stworzenie. Dziękuję.",shape=box,color=blue];
		j2709610695 -> j30255394;
	j1703388821 [label="Pamiętam twoją obietnicę. I to, że znalazłem w tobie przyjaźń tak głęboką, że trzymasz mnie w tym czyśćcu? Dziękuję, mój przyjacielu.",shape=box,color=blue];
