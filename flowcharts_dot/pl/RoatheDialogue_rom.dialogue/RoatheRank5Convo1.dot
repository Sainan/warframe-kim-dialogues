	3298 [label="Co?! Uspokój się. Zastanówmy się nad tym.",shape=box,color=red];
		3298 -> 3318;
	3299 [label="Możesz mnie nienawidzić, jeśli chcesz. Ale nie zrobię nic, dopóki najpierw tego nie rozwiążemy.",shape=box,color=red];
		3299 -> 3319;
	3303 [label="Jestem tego świadomy. Boleśnie świadomy.",shape=box,color=blue];
		3303 -> 3305;
	3304 [label="Tak! Tak! Proszę! Już kiedyś tak zrobiłeś, dlaczego nie zrobisz tego jeszcze raz? Za pierwszym razem nie było tak trudno, co?!",shape=box,color=blue];
		3304 -> 3305;
	3305 [label="Chcesz poznać prawdę, Włóczęgo? Smutną, żałosną i pustą prawdę to tym wszystkim?",shape=box,color=blue];
		3305 -> 3323;
	3306 [label="Jestem tego świadomy. Boleśnie świadomy.",shape=box,color=blue];
