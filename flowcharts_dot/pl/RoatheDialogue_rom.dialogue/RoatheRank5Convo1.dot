	j3947035333 [label="Jeśli chcesz wybrać własną drogę? Dla siebie? Zrób to. Nie przepraszaj. Ale to twoja ścieżka wyboru, a nie kogoś innego.",shape=box,color=red];
		j3947035333 -> j3881260083;
	j1090325043 [label="Jeśli chcesz szukać przebaczenia, to możesz. Ale musisz tego chcieć. Musisz wybrać tę ścieżkę. Nikt inny nie jest w stanie tego zrobić za ciebie.",shape=box,color=red];
		j1090325043 -> j4023186803;
	j1720644176 [label="Kim jestem...?",shape=box,color=blue];
		j1720644176 -> j2738211715;
	j3560295836 [label="Kim jestem...?",shape=box,color=blue];
		j3560295836 -> j3035852542;
	j3744782193 [label="I to nasze przywiązanie do czasu. Proszę cię teraz. Nie, błagam cię, użyj daru teraz na mnie. Zabierz ode mnie te myśli. Zabierz ode mnie te wspomnienia.",shape=box,color=blue];
		j3744782193 -> j1857560376;
	j2243099038 [label="A więc dobrze. Niech tak będzie. Nie poproszę cię o to teraz. Jeśli nigdy nie zrobiłeś tego z czystej ciekawości, dla własnej zabawy, lub by cofnąć błędy, które popełniłeś w swoich relacjach z innymi?!",shape=box,color=blue];
		j2243099038 -> j1857560376;
	j4161320826 [label="Postanowiłem więc spędzić resztę swoich dni, naprawiając wszystkie krzywdy, które moi podli pobratymcy uznali za godne zadania temu systemowi od zarania czasów. ",shape=box,color=blue];
		j4161320826 -> j3688834821;
	j1274507462 [label="Moje intrygi i zamysły o władzy są wyłącznie moje. A ty, mój drogi, słodki Włóczęgo, jesteś najważniejszy pośród nich… jeśli tylko zechcesz nimi władać.",shape=box,color=blue];
		j1274507462 -> j4060756099;
	j2107429449 [label="Mam do ciebie dwa słowa, których być może nie zapomnisz, bo jak słyszałem, są ci doskonale znane!",shape=box,color=blue];
		j2107429449 -> j1296696486;
	j989455332 [label="Dobrze więc! Pozwól, że wrócę cię do tego, czymkolwiek zajmowałeś się wcześniej! Wybacz, że ci przeszkodziłem!",shape=box,color=blue];
		j989455332 -> j2107429449;
