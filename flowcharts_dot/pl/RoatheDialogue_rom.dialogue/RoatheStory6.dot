	j1051151920 [label="VM: ŚWIADOMOŚĆ",shape=box,color=blue];
		j1051151920 -> j1793040739;
	j1793040739 [label="Transkrypcja: Nie myśleliśmy o Świadomych jako o \"kimś\", a raczej o \"czymś\". ",shape=box,color=blue];
		j1793040739 -> j1696253841;
	j1696253841 [label="We faced legions hurled at us with no more regard for their individual lives than corpuscles have.",shape=box,color=blue];
		j1696253841 -> j899784934;
	j899784934 [label="Byli komórkami w ciele rozległej, złowrogiej masy.",shape=box,color=blue];
		j899784934 -> j3513767835;
	j3513767835 [label="We were, I think, too conditioned by our experiences with the Infestation - a hive-mind of quite a different order.",shape=box,color=blue];
		j3513767835 -> j3942536995;
	j3942536995 [label="Świadomym dano mandat ewolucji, a ich jedynym wzorem szczytu ewolucji byliśmy my.",shape=box,color=blue];
		j3942536995 -> j990083475;
	j990083475 [label="Powracali do Systemu Origin nie tylko po to, by unicestwić Orokin, ale by ich zastąpić i ostatecznie… ich udoskonalić.",shape=box,color=blue];
