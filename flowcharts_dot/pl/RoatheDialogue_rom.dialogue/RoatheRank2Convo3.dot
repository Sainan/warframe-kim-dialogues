	j4159096705 [label="Wiem, że pewnie już to słyszałeś, ale dziś nie obchodzi mnie to, nie mam cierpliwości.",shape=box,color=blue];
		j4159096705 -> j4149746299;
	j4149746299 [label="Myślę, że do upadku Imperium Orokin doprowadziło zbyt wiele warstw szkła.",shape=box,color=blue];
