	j466892616 [label="Ludzie byli od siebie zbyt oddaleni?",shape=box,color=red];
		j466892616 -> j2579960964;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j771252064 [label="Wyobraź sobie społeczeństwo oparte na założeniu, że nigdy nie grozi ci prawdziwe niebezpieczeństwo. Nawet sama śmierć.",shape=box,color=blue];
		j771252064 -> j2305125507;
	j2579960964 [label="+5 Chemistry",color=orange];
		j2579960964 -> j2355296545;
	j2305125507 [label="Nic nie może cię zranić.",shape=box,color=blue];
		j2305125507 -> j2760656063;
	j2355296545 [label="Zgadza się. Całkowite oderwanie od niebezpieczeństwa i rzeczywistości.",shape=box,color=blue];
		j2355296545 -> j771252064;
	j2760656063 [label="Prowadzi to do nudy, wskutek której zaczynasz tworzyć własne zagrożenia, Uzurpatorze. Polityka. Intrygi. Nagle zaczęliśmy tworzyć nowe zagrożenia, ponieważ pokonaliśmy już stare.",shape=box,color=blue];
		j2760656063 -> j1945737481;
		j2760656063 -> j2762092161;
	j1945737481 [label="Dlaczego mi o tym mówisz?",shape=box,color=red];
		j1945737481 -> j3177082660;
	j2762092161 [label="Co jest gorsze? Być pod ostrzałem, czy wciąż obawiać się noża w plecach?",shape=box,color=red];
		j2762092161 -> j2526497486;
	j3177082660 [label="Niewiele było interesujących czy przyjemnych momentów w moim… przymusowym pobycie w \"Galicji\". Jednym z nich było jedzenie. Drugim jednak… były burze.",shape=box,color=blue];
		j3177082660 -> j1028123635;
	j2526497486 [label="Ha! Nie mam pewności, czy mam tu jakieś preferencje, obawiam się, że dobrze poznałem obie sytuacje. A ty?",shape=box,color=blue];
		j2526497486 -> j1874866973;
		j2526497486 -> j3846941726;
	j1028123635 [label="Burze, jakich nigdy nie widziałem przez wszystkie lata mojego życia jako Orokin. Wstrząsały ziemią, grzechotały oknami w ramach. Słyszałem je nawet w zakurzonej krypcie, w której nas trzymali.",shape=box,color=blue];
		j1028123635 -> j1015441955;
	j1874866973 [label="Lubię wiedzieć, kto jest moim wrogiem, jasno i wyraźnie. Niech stawią mi czoła z ogniem w oczach.",shape=box,color=red];
		j1874866973 -> j3361995948;
	j3846941726 [label="Być pod ostrzałem. Wolę pociągać za sznurki zza kulis, żeby osiągnąć swój cel. Bez pośpiechu.",shape=box,color=red];
		j3846941726 -> j2383805696;
	j1015441955 [label="Kiedy przetaczały się przez miasto, wspinałem się na dzwonnicę, żeby najbardziej się do nich zbliżyć. Chciałem poczuć elektryczność w powietrzu i ulewny deszcz na skórze.",shape=box,color=blue];
		j1015441955 -> j1027128792;
		j1015441955 -> j2544103568;
		j1015441955 -> j2342362094;
	j3361995948 [label="Add 1 to Thermostat counter",color=orange];
		j3361995948 -> j4112773150;
	j2383805696 [label="Add -1 to Thermostat counter",color=orange];
		j2383805696 -> j166816873;
	j1027128792 [label="Brzmi jak niebezpieczna zabawa.",shape=box,color=red];
		j1027128792 -> j2837497096;
	j2544103568 [label="To brzmi niesamowicie.",shape=box,color=red];
		j2544103568 -> j3381930956;
	j2342362094 [label="Co Leon i Maria sądzili o wykradaniu się?",shape=box,color=red];
		j2342362094 -> j2058241199;
	j4112773150 [label="Rozumiem twoją perspektywę i przyznaję, że ta prostota ma swoją wartość. Ciężko pomylić wroga, kiedy trzyma cię na muszce.",shape=box,color=blue];
		j4112773150 -> j21108759;
	j166816873 [label="Hmm, to wspaniałe, czyż nie? Starannie opracowany plan, który się urzeczywistnia? Elementy układanki, które trafiają na swoje miejsce... to ogromna satysfakcja.",shape=box,color=blue];
		j166816873 -> j21108759;
	j2837497096 [label="Właśnie o to chodziło! Nie potrafię opisać, jak to było czuć tak pierwotną moc. Nie, to było coś więcej. To była prawdziwa potęga. Spojrzałem w górę, w te wirujące, ciemne chmury, błyskające wściekłymi piorunami i zobaczyłem to, co moi przodkowie tak rozpaczliwie próbowali okiełznać.",shape=box,color=blue];
		j2837497096 -> j1000112457;
	j3381930956 [label="+5 Chemistry",color=orange];
		j3381930956 -> j3116350113;
	j2058241199 [label="Pytasz, jakby tak kwestia w ogóle przeszła mi przez myśl. Nie gonili za mną, jeśli o to ci chodzi. Księdza mało interesowało, czy śmierć spadłaby na mnie w postaci pioruna, tego jestem pewien. A Maria? Ona była zbyt zajęta oddawaniem hołdów swoim fałszywym bogom. Sol albo Albrechtowi, jak wolisz.",shape=box,color=blue];
		j2058241199 -> j1418169360;
	j21108759 [label="+5 Chemistry",color=orange];
		j21108759 -> j3630598327;
	j1000112457 [label="Ponadto wiedziałem, że mogło to doprowadzić do mojej śmierci, a w pobliżu nie było Kuvy zdolnej mnie uratować. Co więcej, Kuva nie miałaby wpływu na moją zdeformowaną istotę. ",shape=box,color=blue];
		j1000112457 -> j3090401571;
	j3116350113 [label="Właśnie tak! Nie potrafię opisać, jak to było czuć tak pierwotną moc. Nie, to było coś więcej. To była prawdziwa potęga. Spojrzałem w górę, w te wirujące, ciemne chmury, błyskające wściekłymi piorunami i zobaczyłem to, co moi przodkowie tak rozpaczliwie próbowali okiełznać.",shape=box,color=blue];
		j3116350113 -> j1000112457;
	j1418169360 [label="Ale poczuć taką pierwotną moc? Nie, to było coś więcej. To była prawdziwa potęga. Spojrzałem w górę, w te wirujące, ciemne chmury, błyskające wściekłymi piorunami i zobaczyłem to, co moi przodkowie tak rozpaczliwie próbowali okiełznać.",shape=box,color=blue];
		j1418169360 -> j1000112457;
	j3630598327 [label="Uważam natomiast, że podobnie jak w wielu innych aspektów życia, najważniejsza jest równowaga. Oddanie się jednemu grozi porzuceniem drugiego.",shape=box,color=blue];
		j3630598327 -> j1354944017;
	j3090401571 [label="To mnie przerażało. Czułem strach, Włóczęgo. Po raz pierwszy od... wieków?",shape=box,color=blue];
		j3090401571 -> j4008228825;
		j3090401571 -> j3355498075;
	j1354944017 [label="Obawiam się, że tak powstają potwory jak Ballas i Nitokh. Manipulator i Królowa Krwi. Ech.",shape=box,color=blue];
		j1354944017 -> j1933152794;
	j4008228825 [label="Obawiasz się śmierci?",shape=box,color=red];
		j4008228825 -> j437578010;
	j3355498075 [label="I co zrobiłeś?",shape=box,color=red];
		j3355498075 -> j1887871897;
	j1933152794 [label="Ale chciałem porozmawiać o burzach.",shape=box,color=blue];
		j1933152794 -> j3177082660;
	j437578010 [label="Tak, na to wygląda! I to nawet bardzo, muszę przyznać. W tamtej chwili było to dla mnie samego odkrycie. Nie lękam się tego, co następuje po śmierci, Włóczęgo. Po prostu nie chcę, żeby moje życie dobiegło końca. Jeszcze nie skończyłem go przeżywać.",shape=box,color=blue];
		j437578010 -> j2784189186;
	j1887871897 [label="Wspiąłem się na kamienną balustradę obok gargulca, rozłożyłem ręce szeroko i... roześmiałem się. Roześmiałem się w burzy.",shape=box,color=blue];
		j1887871897 -> j4196678298;
	j2784189186 [label="Samo to było dla mnie odkryciem. Wspiąłem się na kamienną balustradę obok gargulca, rozłożyłem ręce szeroko i... roześmiałem się. Roześmiałem się w burzy.",shape=box,color=blue];
		j2784189186 -> j2193764658;
	j4196678298 [label="W tamtej chwili zrozumiałem, że nie lękam się tego, co następuje po śmierci, Włóczęgo. Po prostu nie chcę, żeby moje życie dobiegło końca. Jeszcze nie skończyłem go przeżywać.",shape=box,color=blue];
		j4196678298 -> j2193764658;
	j2193764658 [label="Mimo tego wszystkiego. Pomimo spustoszenia Tau. Pomimo nieuniknionego upadku Imperium Orokin. Pomimo wypaczenia mojego ciała... A nawet pomimo zostania porzuconym w przeszłości.",shape=box,color=blue];
		j2193764658 -> j356810593;
	j356810593 [label="Wiedziałem, że odnajdę swoją drogę. Do tego czasu. Tego miejsca. Tu, gdzie Albrecht pozostawił swoje najcenniejsze skarby.",shape=box,color=blue];
		j356810593 -> j1956515024;
	j1956515024 [label="+5 Chemistry",color=orange];
		j1956515024 -> j1766162289;
	j1766162289 [label="Bo w życiu zostało mi jeszcze wiele do zrobienia. Ale na Pustkę, zapewnię, że jego żywot dobiegnie końca.",shape=box,color=blue];
		j1766162289 -> j3359792563;
	j3359792563 [label="Boolean RoatheEntrati1 is now true.",color=orange];
		j3359792563 -> "Chat ends.";
}