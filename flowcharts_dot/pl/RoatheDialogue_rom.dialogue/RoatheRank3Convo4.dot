	j110649741 [label="Wydaje się, że obrałeś sobie za cel biegać za Albrechtem z mopem. Spójrz na swoje osiągnięcia z jego sługą.",shape=box,color=blue];
		j110649741 -> j2476974658;
	j715851462 [label="Wydaje się, że obrałeś sobie za cel biegać za Albrechtem z mopem.",shape=box,color=blue];
