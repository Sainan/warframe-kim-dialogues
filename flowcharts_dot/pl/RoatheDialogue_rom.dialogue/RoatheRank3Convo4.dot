	j2580827315 [label="Posiadasz moce niepowtarzalne wśród innych istot. Panujesz nad samym czasem. Tworzysz własne wszechświaty. A jednak siedzisz tutaj... i naprawiasz relacje. (Przy okazji tworząc kilka własnych.)",shape=box,color=blue];
		j2580827315 -> j3483399818;
