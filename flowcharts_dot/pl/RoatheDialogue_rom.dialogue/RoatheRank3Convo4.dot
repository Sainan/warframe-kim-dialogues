		1950 -> 1954 [label=false,color=brown];
		1950 -> 1955 [label=false,color=brown];
	1951 [label="Jeśli uważasz, że moja praca nie ma znaczenia, niech tak będzie. To twoje zdanie. Ale to, co zrobiłem, zmieniło bieg czasu.",shape=box,color=red];
		1951 -> 1957;
	1952 [label="Nie nieznaczące. Niezauważone. Kiedy wszyscy inni ściągają na siebie uwagę, ja pracuję w cieniu.",shape=box,color=red];
		1952 -> 1958;
	1953 [label="Ponieważ to przez niesienie pomocy innym możemy znów zaprowadzić porządek.",shape=box,color=red];
		1953 -> 1959;
	1954 [label="Robię to, co konieczne. Ni więcej, ni mniej.",shape=box,color=red];
		1954 -> 1960;
	1956 [label="Powiedziałeś, że nie miałeś okazji dowiedzieć się, jak to jest być kochanym. Nie sądzę, żebyś zrozumiał, jak potężny wpływ może to mieć na sposób funkcjonowania otaczającego cię świata.",shape=box,color=red];
		1956 -> 1962;
	1955 [label="Czy byłeś kiedyś zakochany, Roathe? Czy zależało ci na kimś tak bardzo, że byłbyś gotów obrócić cały wszechświat w popiół dla tej osoby?",shape=box,color=red];
		1955 -> 1961;
	1957 [label="Właśnie o to mi chodzi! Napiszmy historię na nowo! Nie siedźmy tutaj, próbując przekonać wszystkich, by chwycili się za ręce i zaśpiewali razem!",shape=box,color=blue];
		1957 -> 1963;
		1957 -> 1964;
		1957 -> 1965;
	1958 [label="Ach, rozumiem. Wolisz pozostać niezauważonym zabójcą, prawda? Atakować, kiedy jest to najmniej spodziewane? Nie. Nie wydaje mi się. Myślę, że po prostu się błąkasz.",shape=box,color=blue];
		1958 -> 1966;
	1959 [label="Mhmm. Zostać chłopcem na posyłki, aż zaczną cię wielbić, jak jakiegoś lokalnego bohatera? A może nakłonisz ich, by chwycili się za ręce i zaśpiewali razem? Wybacz mi, potrzebuję chwili, by wyrzygać się do akwarium Fibonacciego.",shape=box,color=blue];
		1959 -> 1967;
		1959 -> 1968;
	1960 [label="A to, co \"robisz\", wydaje się ograniczać do przymuszania innych, by chwycili się za ręce i wspólnie śpiewali w przerwach od wielkich pokazów przemocy. Przemoc ma sens. Od reszty chce mi się rzygać. ",shape=box,color=blue];
		1960 -> 1967;
		1960 -> 1968;
	1962 [label="Jeśli masz zamiar nalegać, że możemy uratować świat od tej \"Obojętności\" przez trzymanie się za ręce i wspólnie śpiewać, pozwól mi, że zwymiotuję do zbiornika Fibonacciego.",shape=box,color=blue];
		1962 -> 1970;
		1962 -> 1967;
		1962 -> 1968;
	1961 [label="Update boolean RoatheUnloved1",color=orange];
		1961 -> 1969;
	1963 [label="Bądź cierpliwy. Pierw musimy rozprawić się z Obojętnością.",shape=box,color=red];
		1963 -> 1971;
	1964 [label="Może, kiedy będzie już po wszystkim. Ale nie teraz.",shape=box,color=red];
		1964 -> 1972;
	1965 [label="I wierzysz, że zrobiłbym to z tobą? Nie rozśmieszaj mnie.",shape=box,color=red];
		1965 -> 1973;
	1966 [label="Nie wiesz, co robisz, ani dlaczego. Robisz po prostu to, co ci każą. Jesteś kolejnym zadufanym w sobie pomagierem zadufanego w sobie Orokin. Wstyd.",shape=box,color=blue];
		1966 -> 1974;
	1967 [label="Mówię tylko, że wyglądasz na naprawdę wściekłego na myśl, że ludzie przestaną być nieszczęśliwi. I odbierasz to bardzo osobiście.",shape=box,color=red];
		1967 -> 1975;
	1968 [label="Chciałem po prostu powiedzieć, że jeśli \"Obojętność\" wynika z braku emocji, to właśnie one mogą być kluczem do jej pokonania.",shape=box,color=red];
		1968 -> 1976;
	1970 [label="Czy uważasz, że niemożliwe jest, aby ktoś cię kochał? A może uważasz, że nie jesteś zdolny do kochania drugiej osoby? A może po prostu jeszcze nie nadszedł właściwy czas?",shape=box,color=red];
		1970 -> 1977;
	1969 [label="Nie, nie miałem okazji. A jeśli masz zamiar nalegać, że możemy uratować świat od tej \"Obojętności\" przez trzymanie się za ręce i wspólnie śpiewać, pozwól mi, że zwymiotuję do zbiornika Fibonacciego.",shape=box,color=blue];
		1969 -> 1970;
