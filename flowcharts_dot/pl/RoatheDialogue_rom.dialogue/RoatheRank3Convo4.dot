		j998936609 -> j397849961;
	j2049098563 [label="Posiadasz moce niepowtarzalne wśród innych istot. Panujesz nad samym czasem. Tworzysz własne wszechświaty. A jednak siedzisz tutaj... i naprawiasz relacje.",shape=box,color=blue];
		j2049098563 -> j397849961;
	j3483399818 [label="Jestem po prostu zdumiony. Nie mogę tego pojąć. Dlaczego? Dlaczego, skoro mógłbyś rządzić wszechświatem?",shape=box,color=blue];
		j3483399818 -> j1972262805;
		j3483399818 -> j1177605123;
		j3483399818 -> j1063647039;
	j397849961 [label="Jestem po prostu zdumiony. Nie mogę tego pojąć. Dlaczego? Dlaczego, skoro mógłbyś rządzić wszechświatem?",shape=box,color=blue];
		j397849961 -> j983163313;
		j397849961 -> j569248638;
		j397849961 -> j346661319;
	j1972262805 [label="Zadowala mnie to, co robię. Pomagam ludziom tak, jak chcę im pomóc.",shape=box,color=red];
		j1972262805 -> j1862760954;
	j1177605123 [label="Nie wiem, czy będziesz w stanie to pojąć, ale spróbuj: Nie chcę zawładnąć światem.",shape=box,color=red];
		j1177605123 -> j3557000284;
	j1063647039 [label="Wtedy nie byłbym lepszy od Albrechta. Albo Orokin. Szaleć i zmieniać świat na swój obraz. Nie jestem tym zainteresowany.",shape=box,color=red];
		j1063647039 -> j3557000284;
	j983163313 [label="Zadowala mnie to, co robię. Pomagam ludziom tak, jak chcę im pomóc.",shape=box,color=red];
		j983163313 -> j1862760954;
	j569248638 [label="Nie wiem, czy będziesz w stanie to pojąć, ale spróbuj: Nie chcę zawładnąć światem.",shape=box,color=red];
		j569248638 -> j2261482203;
	j346661319 [label="Wtedy nie byłbym lepszy od Albrechta. Albo Orokin. Szaleć i zmieniać świat na swój obraz. Nie jestem tym zainteresowany.",shape=box,color=red];
		j346661319 -> j2261482203;
	j1862760954 [label="Ale dlaczego? Tego nie jestem w stanie zrozumieć.",shape=box,color=blue];
		j1862760954 -> j1990388149;
	j3557000284 [label="Więc wolałbyś pozostać... jaki? Nieznaczący?",shape=box,color=blue];
		j3557000284 -> j2382343175;
		j3557000284 -> j3215852923;
	j2261482203 [label="Więc wolałbyś pozostać... jaki? Nieznaczący?",shape=box,color=blue];
		j2261482203 -> j3215852923;
		j2261482203 -> j2382343175;
	j1990388149 [label="Check boolean RoatheUnloved1",color=orange];
		j1990388149 -> j796784863 [label=true,color=green];
		j1990388149 -> j558836044 [label=true,color=green];
		j1990388149 -> j797688556 [label=true,color=green];
		j1990388149 -> j796784863 [label=false,color=brown];
		j1990388149 -> j558836044 [label=false,color=brown];
		j1990388149 -> j1724650546 [label=false,color=brown];
	j2382343175 [label="Jeśli uważasz, że moja praca nie ma znaczenia, niech tak będzie. To twoje zdanie. Ale to, co zrobiłem, zmieniło bieg czasu.",shape=box,color=red];
		j2382343175 -> j3448496985;
	j3215852923 [label="Nie nieznaczące. Niezauważone. Kiedy wszyscy inni ściągają na siebie uwagę, ja pracuję w cieniu.",shape=box,color=red];
		j3215852923 -> j1653315197;
	j796784863 [label="Ponieważ to przez niesienie pomocy innym możemy znów zaprowadzić porządek.",shape=box,color=red];
		j796784863 -> j2807449222;
	j558836044 [label="Robię to, co konieczne. Ni więcej, ni mniej.",shape=box,color=red];
		j558836044 -> j1798966153;
	j797688556 [label="Powiedziałeś, że nie miałeś okazji dowiedzieć się, jak to jest być kochanym. Nie sądzę, żebyś zrozumiał, jak potężny wpływ może to mieć na sposób funkcjonowania otaczającego cię świata.",shape=box,color=red];
		j797688556 -> j3778220976;
	j1724650546 [label="Czy byłeś kiedyś zakochany, Roathe? Czy zależało ci na kimś tak bardzo, że byłbyś gotów obrócić cały wszechświat w popiół dla tej osoby?",shape=box,color=red];
		j1724650546 -> j588956028;
	j3448496985 [label="Właśnie o to mi chodzi! Napiszmy historię na nowo! Nie siedźmy tutaj, próbując przekonać wszystkich, by chwycili się za ręce i zaśpiewali razem!",shape=box,color=blue];
		j3448496985 -> j1559363234;
		j3448496985 -> j3865685836;
		j3448496985 -> j3798279952;
	j1653315197 [label="Ach, rozumiem. Wolisz pozostać niezauważonym zabójcą, prawda? Atakować, kiedy jest to najmniej spodziewane? Nie. Nie wydaje mi się. Myślę, że po prostu się błąkasz.",shape=box,color=blue];
		j1653315197 -> j545160510;
	j2807449222 [label="Mhmm. Zostać chłopcem na posyłki, aż zaczną cię wielbić, jak jakiegoś lokalnego bohatera? A może nakłonisz ich, by chwycili się za ręce i zaśpiewali razem? Wybacz mi, potrzebuję chwili, by wyrzygać się do akwarium Fibonacciego.",shape=box,color=blue];
		j2807449222 -> j2293161389;
		j2807449222 -> j650893565;
	j1798966153 [label="A to, co \"robisz\", wydaje się ograniczać do przymuszania innych, by chwycili się za ręce i wspólnie śpiewali w przerwach od wielkich pokazów przemocy. Przemoc ma sens. Od reszty chce mi się rzygać. ",shape=box,color=blue];
		j1798966153 -> j2293161389;
		j1798966153 -> j650893565;
	j3778220976 [label="Jeśli masz zamiar nalegać, że możemy uratować świat od tej \"Obojętności\" przez trzymanie się za ręce i wspólnie śpiewać, pozwól mi, że zwymiotuję do zbiornika Fibonacciego.",shape=box,color=blue];
		j3778220976 -> j123076203;
		j3778220976 -> j2293161389;
		j3778220976 -> j650893565;
	j588956028 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j588956028 -> j4168812597;
	j1559363234 [label="Bądź cierpliwy. Pierw musimy rozprawić się z Obojętnością.",shape=box,color=red];
		j1559363234 -> j2202671868;
	j3865685836 [label="Może, kiedy będzie już po wszystkim. Ale nie teraz.",shape=box,color=red];
		j3865685836 -> j2354927546;
	j3798279952 [label="I wierzysz, że zrobiłbym to z tobą? Nie rozśmieszaj mnie.",shape=box,color=red];
		j3798279952 -> j1913607878;
	j545160510 [label="Nie wiesz, co robisz, ani dlaczego. Robisz po prostu to, co ci każą. Jesteś kolejnym zadufanym w sobie pomagierem zadufanego w sobie Orokin. Wstyd.",shape=box,color=blue];
		j545160510 -> "Chat ends.";
	j2293161389 [label="Mówię tylko, że wyglądasz na naprawdę wściekłego na myśl, że ludzie przestaną być nieszczęśliwi. I odbierasz to bardzo osobiście.",shape=box,color=red];
		j2293161389 -> j2598201835;
	j650893565 [label="Chciałem po prostu powiedzieć, że jeśli \"Obojętność\" wynika z braku emocji, to właśnie one mogą być kluczem do jej pokonania.",shape=box,color=red];
