	j2476974658 [label="Check boolean IsDating",color=orange];
		j2476974658 -> j1690056277 [label=true,color=green];
		j2476974658 -> j1168829093 [label=false,color=brown];
	j1690056277 [label="Wygląda na to, że w tym samym czasie zaspokajasz swoje potrzeby, za co chcę cię pochwalić, w żaden sposób cię nie oceniam. Po prostu dziwi mnie, że ktoś tak... dziko niesforny, może być tak posłuszny.",shape=box,color=blue];
		j1690056277 -> j4036622047;
		j1690056277 -> j2749511211;
		j1690056277 -> j866887162;
	j1168829093 [label="Po prostu dziwi mnie, że ktoś tak... dziko niesforny, może być tak posłuszny.",shape=box,color=blue];
		j1168829093 -> j4036622047;
		j1168829093 -> j2749511211;
		j1168829093 -> j866887162;
	j4036622047 [label="Pozwolić Obojętności zniszczyć System Origin, czy jakiekolwiek inne miejsce, nikomu nie pomoże.",shape=box,color=red];
		j4036622047 -> j2683123361;
	j2749511211 [label="Nie służę Entratiemu.",shape=box,color=red];
		j2749511211 -> j3942683982;
	j866887162 [label="Mam swoje powody, które pozostaną znane tylko mnie.",shape=box,color=red];
		j866887162 -> j3607817587;
	j2683123361 [label="Ach, rozumiem. To tylko tymczasowa usługa, którą świadczysz, dopóki sytuacja z \"Obojętnością\" nie zostanie rozwiązana. Co dalej?",shape=box,color=blue];
		j2683123361 -> j3433144879;
		j2683123361 -> j797304287;
		j2683123361 -> j1842724637;
		j2683123361 -> j2070714805;
		j2683123361 -> j3832634486;
	j3942683982 [label="Naprawdę? Bo z mojej strony, wygląda na to, że on ledwie pstryknie palcami, a ty siadasz przed nim niczym wytresowany kubrow. Byle wspomnienie o \"Tau\" sprawia, że próbujesz przypomnieć sobie każdy możliwy szczegół miejsca, które straciliście.",shape=box,color=blue];
		j3942683982 -> j108394049;
		j3942683982 -> j304190286;
	j3607817587 [label="Ależ ty tajemniczy! A to wszystko kupa bzdur. Jeśli nie chcesz po prostu przyznać, że jesteś na każde jego skinienie, niech tak będzie.",shape=box,color=blue];
		j3607817587 -> j1877063333;
	j3433144879 [label="Dlaczego cię to tak interesuje? O co właściwie chcesz mnie zapytać?",shape=box,color=red];
		j3433144879 -> j824425784;
	j797304287 [label="Szczerze mówiąc, nie myślałem o tym aż tak daleko w przyszłość.",shape=box,color=red];
		j797304287 -> j3080055354;
	j1842724637 [label="Sprawię, że odpłaci za ten cały bałagan. Ma wiele na sumieniu. ",shape=box,color=red];
		j1842724637 -> j2056299841;
	j2070714805 [label="Zakładając, że przeżyję?",shape=box,color=red];
		j2070714805 -> j102381194;
	j3832634486 [label="Pójdę tam, gdzie będę potrzebny, jak zawsze. Problemy same mnie znajdują.",shape=box,color=red];
		j3832634486 -> j4080987407;
	j108394049 [label="Dlaczego tak starasz się mnie rozzłościć?",shape=box,color=red];
		j108394049 -> j2074188471;
	j304190286 [label="Robię to, co konieczne, żeby pomóc innym.",shape=box,color=red];
		j304190286 -> j1505992891;
	j1877063333 [label="Cóż z mojej strony wygląda na to, że on ledwie pstryknie palcami, a ty siadasz przed nim niczym wytresowany kubrow. Byle wspomnienie o \"Tau\" sprawia, że próbujesz przypomnieć sobie każdy możliwy szczegół miejsca, które straciliście.",shape=box,color=blue];
		j1877063333 -> j108394049;
		j1877063333 -> j304190286;
	j824425784 [label="+5 Chemistry",color=orange];
		j824425784 -> j2489476378;
	j3080055354 [label="Ach! Więc przyznajesz, że jesteś idiotą! Jakie to orzeźwiające. Uwielbiam, kiedy głupcy otwarcie dają znać o swoim braku rozumu, dzięki temu łatwiej mi nimi manipulować.",shape=box,color=blue];
		j3080055354 -> j3250597698;
	j2056299841 [label="Ach! Więc szukasz podłej, pierwotnej zemsty! Wspaniałe. Wściekłe zwierzę, gotowe rzucić się na tych, którzy cię skrzywdzili.",shape=box,color=blue];
		j2056299841 -> j2527117398;
	j102381194 [label="+5 Chemistry",color=orange];
		j102381194 -> j3954402560;
	j4080987407 [label="Aha, rozumiem. Apatia zamaskowana szlachetnością. Nie wiesz, gdzie jest twoje miejsce, gdzie powinieneś zostać, więc przykrywasz się pozorem \"poświęcenia w imię sprawiedliwości\" i spełniasz polecenia innych?",shape=box,color=blue];
		j4080987407 -> j2939815474;
	j2074188471 [label="Ponieważ nie jestem w stanie pojąć, dlaczego ty, istota, która – o ile dobrze rozumiem – pochodzi z zupełnie innej rzeczywistości, robi bałagan z samym czasem podczas zabawy w terapeutę.",shape=box,color=blue];
		j2074188471 -> j3341063878;
	j1505992891 [label="Tak, o to właśnie chodzi! Dlaczego uparcie wędrujesz po czasie i przestrzeni, bawiąc się w terapeutę? Ty, istota, która — o ile się orientuję — pochodzi z zupełnie innej rzeczywistości, ",shape=box,color=blue];
		j1505992891 -> j3341063878;
	j2489476378 [label="Jesteś bystry. Tak, bardzo dobrze, zapytam więc bardziej bezpośrednio. Próbowałem cię sprowokować, licząc na bardziej szczerą odpowiedź w gniewie.",shape=box,color=blue];
		j2489476378 -> j2931843448;
	j3250597698 [label="Jesteś jak kubrow, który w końcu złapał kaithe. Nie wiesz, co robić, kiedy już zatopiłeś kły w jego nodze.",shape=box,color=blue];
		j3250597698 -> j304190286;
		j3250597698 -> j108394049;
	j2527117398 [label="Jedna z najprostszych i najstarszych ludzkich motywacji. A zatem jedna z najłatwiejszych do zrozumienia.",shape=box,color=blue];
		j2527117398 -> j304190286;
	j3954402560 [label="Nigdy nie byłem żołnierzem, jednak w Twoim tonie słyszę zmęczenie, typowe dla najbardziej zahartowanych w boju.",shape=box,color=blue];
		j3954402560 -> j1770279260;
	j2939815474 [label="Jakież to tragiczne.",shape=box,color=blue];
		j2939815474 -> j2742863643;
		j2939815474 -> j2681381989;
	j3341063878 [label="Na twoim miejscu wróciłbym do Duviri, próbując odkryć, przez jakie jeszcze dziury w materii Pustki mógłbym się przebić! Wyobraź sobie te możliwości! Wyobraź sobie światy, gotowe do zdobycia!",shape=box,color=blue];
		j3341063878 -> j1841645630;
		j3341063878 -> j2992303703;
	j2931843448 [label="Ale myślę, że to będzie musiało wystarczyć.",shape=box,color=blue];
		j2931843448 -> j2345698311;
	j1770279260 [label="Niech będzie. Jak żołnierz do żołnierza, zapytam bardziej bezpośrednio. Próbowałem cię sprowokować, licząc na bardziej szczerą odpowiedź w gniewie.",shape=box,color=blue];
		j1770279260 -> j2345698311;
	j2742863643 [label="Mam swoje miejsce na ziemi.",shape=box,color=red];
		j2742863643 -> j2546531312;
	j2681381989 [label="Nie masz pojęcia, o czym mówisz.",shape=box,color=red];
		j2681381989 -> j2285331715;
	j1841645630 [label="Niczym się nie różnisz od Albrechta. On podróżuje w czasie, sprawia te wszystkie problemy. A ty chcesz to zrobić z całymi wymiarami?!",shape=box,color=red];
		j1841645630 -> j1592504005;
	j2992303703 [label="W tym tkwi problem z tobą, Orokin. Myślisz, że całe światy są tylko twoje i możesz z nimi robić, co chcesz. ",shape=box,color=red];
		j2992303703 -> j498341753;
	j2345698311 [label="+5 Chemistry",color=orange];
		j2345698311 -> j3483333085;
	j2546531312 [label="Opowiedz mi o nim! Czy to Höllvania? A może Duviri? A może twój rozbity Orbiter na tym, co pozostało z Ziemi?",shape=box,color=blue];
		j2546531312 -> j304190286;
		j2546531312 -> j108394049;
	j2285331715 [label="Wiec powiedz mi, gdzie jest twój dom! Czy to Höllvania? A może Duviri? A może twój rozbity Orbiter na tym, co pozostało z Ziemi?",shape=box,color=blue];
		j2285331715 -> j304190286;
		j2285331715 -> j108394049;
	j1592504005 [label="A dlaczego mielibyśmy postępować inaczej? Jesteśmy istotami wyższymi, prawda? Albrecht robi, co mu się podoba, a ty nie masz problemu ze sprzątaniem po nim! Czemu ja nie miałbym mieć prawa robić tego samego? Co uświęca jego środki, a moich nie?",shape=box,color=blue];
		j1592504005 -> j3919299393;
	j498341753 [label="A dlaczego mielibyśmy postępować inaczej? Jesteśmy istotami wyższymi, prawda? Albrecht robi, co mu się podoba, niszcząc sam czas, szerząc chorobę, której sam nie rozumie, a wszystko to w imieniu \"pokonania tak zwanego boga\".",shape=box,color=blue];
		j498341753 -> j3919299393;
	j3483333085 [label="Nie jestem w stanie pojąć, dlaczego ty, istota, która – o ile dobrze rozumiem – pochodzi z zupełnie innej rzeczywistości, robi bałagan z samym czasem podczas zabawy w terapeutę.",shape=box,color=blue];
		j3483333085 -> j3956801596;
	j3919299393 [label="Spójrz na siebie! ",shape=box,color=blue];
		j3919299393 -> j965779903;
