		1878 -> 1881;
	1877 [label="[Koniec]",shape=box,color=red];
		1877 -> 1880;
	1882 [label="Po co to wszystko?",shape=box,color=blue];
		1882 -> 1883;
	1881 [label="Mógłbym wyrecytować całą listę, ale obawiam się, że spędzilibyśmy tu resztę dnia. Nie, moje pytania w tej sprawie dotyczą konkretnie jednego tematu. Przynajmniej dzisiaj.",shape=box,color=blue];
		1881 -> 1882;
