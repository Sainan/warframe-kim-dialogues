	1886 [label="Wydaje się, że obrałeś sobie za cel biegać za Albrechtem z mopem. Spójrz na swoje osiągnięcia z jego sługą.",shape=box,color=blue];
		1886 -> 1889;
	1887 [label="Wydaje się, że obrałeś sobie za cel biegać za Albrechtem z mopem.",shape=box,color=blue];
