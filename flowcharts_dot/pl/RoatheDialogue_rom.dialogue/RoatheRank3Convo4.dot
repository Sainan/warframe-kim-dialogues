		1889 -> 1891 [label=true,color=green];
		1889 -> 1890 [label=false,color=brown];
	1891 [label="Wygląda na to, że w tym samym czasie zaspokajasz swoje potrzeby, za co chcę cię pochwalić, w żaden sposób cię nie oceniam. Po prostu dziwi mnie, że ktoś tak... dziko niesforny, może być tak posłuszny.",shape=box,color=blue];
		1891 -> 1892;
		1891 -> 1893;
		1891 -> 1894;
	1890 [label="Po prostu dziwi mnie, że ktoś tak... dziko niesforny, może być tak posłuszny.",shape=box,color=blue];
		1890 -> 1892;
		1890 -> 1893;
		1890 -> 1894;
	1892 [label="Pozwolić Obojętności zniszczyć System Origin, czy jakiekolwiek inne miejsce, nikomu nie pomoże.",shape=box,color=red];
		1892 -> 1895;
	1893 [label="Nie służę Entratiemu.",shape=box,color=red];
		1893 -> 1896;
	1894 [label="Mam swoje powody, które pozostaną znane tylko mnie.",shape=box,color=red];
		1894 -> 1897;
	1895 [label="Ach, rozumiem. To tylko tymczasowa usługa, którą świadczysz, dopóki sytuacja z \"Obojętnością\" nie zostanie rozwiązana. Co dalej?",shape=box,color=blue];
		1895 -> 1898;
		1895 -> 1899;
		1895 -> 1900;
		1895 -> 1901;
		1895 -> 1902;
	1896 [label="Naprawdę? Bo z mojej strony, wygląda na to, że on ledwie pstryknie palcami, a ty siadasz przed nim niczym wytresowany kubrow. Byle wspomnienie o \"Tau\" sprawia, że próbujesz przypomnieć sobie każdy możliwy szczegół miejsca, które straciliście.",shape=box,color=blue];
		1896 -> 1903;
		1896 -> 1904;
	1897 [label="Ależ ty tajemniczy! A to wszystko kupa bzdur. Jeśli nie chcesz po prostu przyznać, że jesteś na każde jego skinienie, niech tak będzie.",shape=box,color=blue];
		1897 -> 1905;
	1898 [label="Dlaczego cię to tak interesuje? O co właściwie chcesz mnie zapytać?",shape=box,color=red];
		1898 -> 1906;
	1899 [label="Szczerze mówiąc, nie myślałem o tym aż tak daleko w przyszłość.",shape=box,color=red];
		1899 -> 1907;
	1900 [label="Sprawię, że odpłaci za ten cały bałagan. Ma wiele na sumieniu. ",shape=box,color=red];
		1900 -> 1908;
	1901 [label="Zakładając, że przeżyję?",shape=box,color=red];
		1901 -> 1909;
	1902 [label="Pójdę tam, gdzie będę potrzebny, jak zawsze. Problemy same mnie znajdują.",shape=box,color=red];
		1902 -> 1910;
	1903 [label="Dlaczego tak starasz się mnie rozzłościć?",shape=box,color=red];
		1903 -> 1911;
	1904 [label="Robię to, co konieczne, żeby pomóc innym.",shape=box,color=red];
		1904 -> 1912;
	1905 [label="Cóż z mojej strony wygląda na to, że on ledwie pstryknie palcami, a ty siadasz przed nim niczym wytresowany kubrow. Byle wspomnienie o \"Tau\" sprawia, że próbujesz przypomnieć sobie każdy możliwy szczegół miejsca, które straciliście.",shape=box,color=blue];
		1905 -> 1903;
		1905 -> 1904;
	1906 [label="+5 Chemistry",color=orange];
		1906 -> 1913;
	1907 [label="Ach! Więc przyznajesz, że jesteś idiotą! Jakie to orzeźwiające. Uwielbiam, kiedy głupcy otwarcie dają znać o swoim braku rozumu, dzięki temu łatwiej mi nimi manipulować.",shape=box,color=blue];
		1907 -> 1914;
	1908 [label="Ach! Więc szukasz podłej, pierwotnej zemsty! Wspaniałe. Wściekłe zwierzę, gotowe rzucić się na tych, którzy cię skrzywdzili.",shape=box,color=blue];
		1908 -> 1915;
	1909 [label="+5 Chemistry",color=orange];
		1909 -> 1916;
	1910 [label="Aha, rozumiem. Apatia zamaskowana szlachetnością. Nie wiesz, gdzie jest twoje miejsce, gdzie powinieneś zostać, więc przykrywasz się pozorem \"poświęcenia w imię sprawiedliwości\" i spełniasz polecenia innych?",shape=box,color=blue];
		1910 -> 1917;
	1911 [label="Ponieważ nie jestem w stanie pojąć, dlaczego ty, istota, która – o ile dobrze rozumiem – pochodzi z zupełnie innej rzeczywistości, robi bałagan z samym czasem podczas zabawy w terapeutę.",shape=box,color=blue];
		1911 -> 1918;
	1912 [label="Tak, o to właśnie chodzi! Dlaczego uparcie wędrujesz po czasie i przestrzeni, bawiąc się w terapeutę? Ty, istota, która — o ile się orientuję — pochodzi z zupełnie innej rzeczywistości, ",shape=box,color=blue];
		1912 -> 1918;
	1913 [label="Jesteś bystry. Tak, bardzo dobrze, zapytam więc bardziej bezpośrednio. Próbowałem cię sprowokować, licząc na bardziej szczerą odpowiedź w gniewie.",shape=box,color=blue];
		1913 -> 1919;
	1914 [label="Jesteś jak kubrow, który w końcu złapał kaithe. Nie wiesz, co robić, kiedy już zatopiłeś kły w jego nodze.",shape=box,color=blue];
		1914 -> 1904;
		1914 -> 1903;
	1915 [label="Jedna z najprostszych i najstarszych ludzkich motywacji. A zatem jedna z najłatwiejszych do zrozumienia.",shape=box,color=blue];
		1915 -> 1904;
	1916 [label="Nigdy nie byłem żołnierzem, jednak w Twoim tonie słyszę zmęczenie, typowe dla najbardziej zahartowanych w boju.",shape=box,color=blue];
		1916 -> 1920;
	1917 [label="Jakież to tragiczne.",shape=box,color=blue];
		1917 -> 1921;
		1917 -> 1922;
	1918 [label="Na twoim miejscu wróciłbym do Duviri, próbując odkryć, przez jakie jeszcze dziury w materii Pustki mógłbym się przebić! Wyobraź sobie te możliwości! Wyobraź sobie światy, gotowe do zdobycia!",shape=box,color=blue];
		1918 -> 1923;
		1918 -> 1924;
	1919 [label="Ale myślę, że to będzie musiało wystarczyć.",shape=box,color=blue];
		1919 -> 1925;
	1920 [label="Niech będzie. Jak żołnierz do żołnierza, zapytam bardziej bezpośrednio. Próbowałem cię sprowokować, licząc na bardziej szczerą odpowiedź w gniewie.",shape=box,color=blue];
		1920 -> 1925;
	1921 [label="Mam swoje miejsce na ziemi.",shape=box,color=red];
		1921 -> 1926;
	1922 [label="Nie masz pojęcia, o czym mówisz.",shape=box,color=red];
		1922 -> 1927;
	1923 [label="Niczym się nie różnisz od Albrechta. On podróżuje w czasie, sprawia te wszystkie problemy. A ty chcesz to zrobić z całymi wymiarami?!",shape=box,color=red];
		1923 -> 1928;
	1924 [label="W tym tkwi problem z tobą, Orokin. Myślisz, że całe światy są tylko twoje i możesz z nimi robić, co chcesz. ",shape=box,color=red];
		1924 -> 1929;
	1925 [label="+5 Chemistry",color=orange];
		1925 -> 1930;
	1926 [label="Opowiedz mi o nim! Czy to Höllvania? A może Duviri? A może twój rozbity Orbiter na tym, co pozostało z Ziemi?",shape=box,color=blue];
		1926 -> 1904;
		1926 -> 1903;
	1927 [label="Wiec powiedz mi, gdzie jest twój dom! Czy to Höllvania? A może Duviri? A może twój rozbity Orbiter na tym, co pozostało z Ziemi?",shape=box,color=blue];
		1927 -> 1904;
		1927 -> 1903;
	1928 [label="A dlaczego mielibyśmy postępować inaczej? Jesteśmy istotami wyższymi, prawda? Albrecht robi, co mu się podoba, a ty nie masz problemu ze sprzątaniem po nim! Czemu ja nie miałbym mieć prawa robić tego samego? Co uświęca jego środki, a moich nie?",shape=box,color=blue];
		1928 -> 1931;
	1929 [label="A dlaczego mielibyśmy postępować inaczej? Jesteśmy istotami wyższymi, prawda? Albrecht robi, co mu się podoba, niszcząc sam czas, szerząc chorobę, której sam nie rozumie, a wszystko to w imieniu \"pokonania tak zwanego boga\".",shape=box,color=blue];
		1929 -> 1931;
	1930 [label="Nie jestem w stanie pojąć, dlaczego ty, istota, która – o ile dobrze rozumiem – pochodzi z zupełnie innej rzeczywistości, robi bałagan z samym czasem podczas zabawy w terapeutę.",shape=box,color=blue];
		1930 -> 1932;
	1931 [label="Spójrz na siebie! ",shape=box,color=blue];
