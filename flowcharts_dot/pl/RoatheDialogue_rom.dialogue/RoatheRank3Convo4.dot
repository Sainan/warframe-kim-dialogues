digraph {
	1875 [label="RoatheRank3Convo4 begins.",color=orange];
		1875 -> 1876;
	1876 [label="Czy możesz mi odpowiedzieć na jedno pytanie, Uzurpatorze? Nurtuje mnie ono od jakiegoś czasu.",shape=box,color=blue];
