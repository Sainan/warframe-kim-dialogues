		1973 -> 1979;
	1974 [label="Chat ends.",color=orange];
	1975 [label="Bo w grupie raźniej? Być może. Albo po prostu nie rozumiem, dlaczego biegasz i marnujesz czas, kiedy moglibyśmy zająć się czymś naprawdę ważnym.",shape=box,color=blue];
		1975 -> 1980;
	1976 [label="Kolejny dowód na to, że to wytwór twojej wyobraźni! Jaki prawdziwy bóg lub \"antybóg\" dałby się pokonać \"pozytywne emocje ludzi\"! Ha!",shape=box,color=blue];
		1976 -> 1981;
	1977 [label="Update boolean RoatheUnloved2",color=orange];
		1977 -> 1982;
	1978 [label="Myślę, że czeka nas wiele pracy. Po prostu nie mogę pojąć, że takie... dziecinne zabawy mają jakiś cel. Ale z drugiej strony, siedzę tutaj, a ty masz klucze do wszechświata.",shape=box,color=blue];
		1978 -> 1983;
