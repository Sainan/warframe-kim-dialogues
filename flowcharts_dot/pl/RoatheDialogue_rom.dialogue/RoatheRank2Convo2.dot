	883 [label="Wiesz, że swego czasu byli w sobie zakochani.",shape=box,color=blue];
		883 -> 888;
		883 -> 887;
		883 -> 886;
	885 [label="Mieszasz nam wszystkim w głowach... w imię pożądania? Miłości? Czym to jest? Jak byś to nazwał? Chyba tylko zastanawiam się, czy to gra warta świeczki. Może przypuszczam, że jeszcze nie wiesz, bo wszystkie długi nie zostały spłacone.",shape=box,color=blue];
		885 -> 890;
	884 [label="Mieszasz nam wszystkim w głowach... w imię czego? Spełnienie jakiejś... niewidzialnej listy rzeczy do zrobienia? A może to wszystko w imię pokonania wyczarowanego przez ciebie, tak zwanego, \"boga\"?",shape=box,color=blue];
		884 -> 889;
