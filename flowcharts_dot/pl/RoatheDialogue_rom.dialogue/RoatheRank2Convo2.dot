		886 -> 891;
	890 [label="Przypuszczam, że jest to dziwnie romantyczne, choć odrobinę... dystopijne, aby zrobić coś tak wielkiego, aby zdobyć serce (i/lub ciało) ukochanej osoby.",shape=box,color=blue];
		890 -> 895;
	889 [label="A może jest jeszcze gorzej i po prostu byłeś ciekaw, co się stanie? I po prostu siedzisz i wyrywasz owadom nogi? Wyjaśniliśmy, \"co\" kryje się za twoimi działaniami. Teraz próbuję dociec, \"dlaczego\".",shape=box,color=blue];
		889 -> 894;
