		918 -> 929;
	920 [label="Skarciłbym cię za to, co zrobiłeś w imię osiągnięcia swoich celów, ale przypominam sobie, że Orokin są znani z tego, że potrafią robić o wiele gorsze rzeczy, jeśli nie bardziej kreatywne.",shape=box,color=blue];
		920 -> 931;
	927 [label="Ty się stałeś, rzecz jasna. A raczej dzieci. Tenno. Czasami zastanawiam się, czy było to nieuniknione. Czy mógł zmienić bieg losu.",shape=box,color=blue];
		927 -> 937;
	928 [label="Może i masz rację. A może wszyscy jesteśmy niczym nieoszlifowane klejnoty. Mamy swoje wady i cechy. Żyły tu, skazy tam.",shape=box,color=blue];
		928 -> 938;
