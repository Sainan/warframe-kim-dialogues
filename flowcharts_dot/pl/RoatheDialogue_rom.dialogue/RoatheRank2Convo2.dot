		974 -> 982;
	972 [label="Chat ends.",color=orange];
	966 [label="Każdy z nich niejako żyje w swojej własnej \"ciągłości\" lub czasie. Wszystkie szczepy Plagi są ze sobą powiązane, ale żyją w… guzkach. To wszystko jest bardzo skomplikowane.",shape=box,color=red];
		966 -> 976;
