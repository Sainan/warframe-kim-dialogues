		958 -> 968;
	959 [label="Albo próbujesz odwołać się do mojego ego, za co cię chwalę, albo po prostu jesteś koszmarnie znudzony. Co, jako ktoś, kto również doświadczył niezliczonych cyklów życia, niemal rozumiem.",shape=box,color=blue];
		959 -> 969;
	960 [label="Fascynujące. Albo kłamiesz, albo wciąż mam w głowie tajemnice, których nie odkryłeś. Może dlatego znów zaglądasz pod już odwrócone kamienie.",shape=box,color=blue];
		960 -> 970;
	961 [label="No cóż, małymi kroczkami przekonujesz mnie, żebym ci wybaczył ten bałagan, którego narobiłeś.",shape=box,color=blue];
		961 -> 971;
	965 [label="Na długo przed wyruszeniem Zarimana Ten Zero i zanim narodziła się idea Tenno, Archimedianka Margulis i Ballas spotkali się podczas ceremonii otwarcia nowego konserwatorium.",shape=box,color=blue];
		965 -> 975;
	973 [label="Z tego, co mi powiedziano – a ona nie jest do końca wiarygodna, więc traktuj to z przymrużeniem oka – szczepy Plagi użyte w serum protoframe'ów mogą zostać indywidualnie zmienione.",shape=box,color=red];
		973 -> 981;
