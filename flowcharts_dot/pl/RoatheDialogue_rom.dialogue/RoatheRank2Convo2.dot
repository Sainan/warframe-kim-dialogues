		925 -> 936;
	926 [label="Mhm, tak. Cóż, prawdopodobnie nie musiałeś zmagać się z innym protoframem, którego wspomnienia są... rozbite w taki sposób jak moje. Przypuszczam, że mogę to zrozumieć. A wszystko to w imię \"miłości\".",shape=box,color=blue];
		926 -> 936;
	921 [label="I tak zaczynam rozumieć, jak w ogóle doszedłeś do takiego \"spieprzenia sprawy\", Uzurpatorze.",shape=box,color=blue];
