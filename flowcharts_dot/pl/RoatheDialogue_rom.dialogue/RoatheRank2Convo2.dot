		967 -> 977;
		967 -> 978;
	968 [label="Nie będę cię więc zanudzał opowiadaniem tej historii po raz kolejny i pozwolę ci znaleźć inne rozrywki na resztę dnia.",shape=box,color=blue];
		968 -> 979;
