		936 -> 931;
	930 [label="Osobiście radziłbym posiedzieć cicho ze swoimi błędami i zaakceptować porażkę taką, jaka jest. Ale to czyniłoby mnie paskudnym hipokrytą, prawda?",shape=box,color=blue];
		930 -> 940;
	929 [label="Osobiście radziłbym posiedzieć cicho ze swoimi błędami i zaakceptować porażkę taką, jaka jest. Ale nie mam daru Pustki, który pozwala mi zapętlać czas i wymazywać myśli.",shape=box,color=blue];
		929 -> 939;
	931 [label="Czy opowiedziałem ci historię Ballasa i Margulis? Liczę na twoją szczerość, bo inaczej nie mam absolutnie żadnego sposobu, żeby poznać prawdę.",shape=box,color=blue];
		931 -> 941;
	937 [label="Chcę wierzyć, że wszyscy jesteśmy niczym nieoszlifowane klejnoty. Mamy swoje wady i cechy. Żyły tu, skazy tam.",shape=box,color=blue];
		937 -> 938;
	938 [label="Możemy zostać obrobieni w odpowiedni sposób, abyśmy pięknie błyszczeli, albo pasowali w większej kompozycji... albo przemienieni w broń... czy roztrzaskani w pył.",shape=box,color=blue];
