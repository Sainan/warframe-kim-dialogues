	997 [label="Gadająca gitara.",shape=box,color=red];
		997 -> 974;
	998 [label="Skarciłbym cię za to, co zrobiłeś w imię osiągnięcia \"miłości\" ale przypominam sobie, że Orokin są znani z tego, że potrafią robić o wiele gorsze rzeczy, jeśli nie bardziej kreatywne.",shape=box,color=blue];
		998 -> 931;
	999 [label="Ale on tego nie zrobił. Ballas spojrzał na nią tego wieczoru raz i... był porażony, Włóczęgo. Całkowicie i absolutnie oszalał.",shape=box,color=blue];
		999 -> 1000;
	1000 [label="Nigdy wcześniej czegoś takiego nie widziałem. Jakby w pokoju nie było nikogo, prócz Margulis. Wydawał się nawet... lekko onieśmielony. On! Ballas!",shape=box,color=blue];
		1000 -> 1001;
		1000 -> 1002;
	1001 [label="Serio?",shape=box,color=red];
		1001 -> 1003;
	1002 [label="Zgrywasz się.",shape=box,color=red];
		1002 -> 1004;
	1003 [label="Przysięgam na resztki mojego honoru! I dlaczego miałbym kłamać? Co mnie obchodzi twoje zdanie o ich związku?",shape=box,color=blue];
		1003 -> 1005;
	1004 [label="Przysięgam na resztki mojego honoru, nie zmyślam! I dlaczego miałbym kłamać? Co mnie obchodzi twoje zdanie o ich związku?",shape=box,color=blue];
		1004 -> 1005;
	1005 [label="Sprawia mi ogromną przykrość, że tak prędko chcesz uprościć coś, co było znacznie bardziej skomplikowane, niż byś tego chciał.",shape=box,color=blue];
		1005 -> 1006;
	1006 [label="Byli zakochani, czy chcesz w to wierzyć, czy nie. Ballas złamał wszelkie zasady i tradycję, by wybrać sobie na kochankę – i jedyną romantyczną partnerkę – Archimediankę. ",shape=box,color=blue];
		1006 -> 1007;
	1007 [label="Tylko prawdziwa miłość mogłaby doprowadzić go do takiego szaleństwa, a potem było tylko gorzej...",shape=box,color=blue];
		1007 -> 1008;
		1007 -> 1009;
	1008 [label="Dlaczego tak uważasz? Czy to nie on odpowiadał za jej śmierć?",shape=box,color=red];
		1008 -> 1010;
	1009 [label="To Ballas kazał ją stracić.",shape=box,color=red];
		1009 -> 1010;
	1010 [label="Po pierwsze, załóżmy, że wszystko, co wiesz, jest prawdą i że jego działania były całkowicie dobrowolne. Załóżmy, że nie miały miejsca inne polityczne intrygi, szantaże ani nic podobnego, co mogłoby go do tego zmusić.",shape=box,color=blue];
		1010 -> 1011;
	1011 [label="Nawet gdyby tak było i Ballas zażądał jej egzekucji zupełnie bez powodu, pomyśl, że było już za późno. Zdrada, którą czuł, już go rozdarła na dwoje.",shape=box,color=blue];
		1011 -> 1012;
	1012 [label="Jego serce i umysł były już złamane.",shape=box,color=blue];
		1012 -> 1013;
		1012 -> 1014;
	1013 [label="Nie zamierzam mu współczuć, jeśli tego ode mnie oczekujesz.",shape=box,color=red];
		1013 -> 1015;
	1014 [label="Z powodu Tenno? A może z powodu tego, co jej zrobili?",shape=box,color=red];
		1014 -> 1016;
	1015 [label="O nic takiego cię nie proszę! Ballas z pewnością zasługuje na wszelkie obelgi czy plucie na miejsce jego spoczynku, jeśli w ogóle doczekał się grobu.",shape=box,color=blue];
		1015 -> 1017;
	1016 [label="W pewnym sensie jedno i drugie. A w pewnym sensie żadne z nich. Oszalał w dniu, kiedy wydał wyrok jej egzekucji. Prawdę mówiąc, nie zdziwiłbym się, gdyby jakaś jego część nie do końca pamiętała, że dokonał tego czynu.",shape=box,color=blue];
		1016 -> 1018;
	1017 [label="Stwierdzam jedynie, że w dniu, w którym zażądał jej egzekucji, był pozbawiony rozumu. Nie zdziwiłbym się, gdyby jakaś jego część nie do końca pamiętała, że dokonał tego czynu.",shape=box,color=blue];
		1017 -> 1018;
	1018 [label="Ballas kochał Margulis. Całą swoją osobą, całkowicie, do cna jej oddany. Poświęciłby dla niej wszystko. Swoją duszę, swoje ciało, Imperium Orokin. Wszystko, o czym tylko można marzyć.",shape=box,color=blue];
		1018 -> 1019;
	1019 [label="Żadna cena nie była zbyt wielka. Głos rozsądku zamilknął. Gdybyś wręczył mu do rąk noworodka i powiedział, że Margulis życzy sobie roztrzaskania jego głowy o skały, byłby martwy, zanim skończyłbyś mówić.",shape=box,color=blue];
		1019 -> 1020;
	1020 [label="Spaliłby System Origin do reszty i odbudował go zgodnie z jej wizją, Uzurpatorze... ale w tym tkwi tragedia.",shape=box,color=blue];
		1020 -> 1021;
	1021 [label="Margulis? Ach, Margulis. Droga, słodka, kochana Margulis... nadal miała sumienie.",shape=box,color=blue];
		1021 -> 1022;
	1022 [label="A gdy zobaczyła biednych Tenno, biedne dzieci rozdarte przez Pustkę...",shape=box,color=blue];
		1022 -> 1023;
	1023 [label="W jej życiu pojawiło się coś ważniejszego niż Ballas. Coś w jej życiu było warte poświęcenia życia... co nie było nim.",shape=box,color=blue];
		1023 -> 1024;
	1024 [label="Co nie było jej miłością do niego.",shape=box,color=blue];
		1024 -> 1025;
	1025 [label="I on o tym wiedział, mój drogi Włóczęgo. Wiedział o tym od chwili, gdy na nich spojrzała. I uświadomił to sobie, gdy jej \"wściekłe zwierzęta\" sprawiły, że to były ostatnim obrazem, jaki ujrzała. A przynajmniej takie krążyły plotki wśród nas, Orokin.",shape=box,color=blue];
		1025 -> 1026;
	1026 [label="Czy wyobrażasz sobie radość wśród Orokin? Móc zobaczyć, jak dzikie, rozdarte przez Pustkę bachory najdroższej Archimedianki Ballasa, wypalają jej oczy?",shape=box,color=blue];
		1026 -> 1027;
	1027 [label="Ale myślę, że serce Ballasa zostało roztrzaskane na tysiąc kawałków jeszcze wcześniej, kiedy Margulis walczyła o ratunek Tenno.",shape=box,color=blue];
		1027 -> 1028;
	1028 [label="Bo wiedział, że został w jej sercu zastąpiony.",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="Chyba właśnie dlatego było mi go żal. Ale co dalej? Historia miłosna na wieki... i jak zakończyła się tak bolesną tragedią. ",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="Chciałbym, żebyś zobaczył, jak się do siebie uśmiechali...",shape=box,color=blue];
		1030 -> 1031;
		1030 -> 1032;
	1031 [label="Można romantyzować to, co mieli, ale to nie usprawiedliwia tego, kim był. Nie można wybaczyć Ballasowi wszystkiego, co zrobił.",shape=box,color=red];
		1031 -> 1033;
	1032 [label="Cieszę się, że ich miłość była prawdziwa. Że on był wtedy... skomplikowany. I że Margulis nie była przez cały czas wyłącznie obiektem żartów.",shape=box,color=red];
		1032 -> 1034;
	1033 [label="Add 1 to Thermostat",color=orange];
		1033 -> 1035;
	1034 [label="Add -1 to Thermostat",color=orange];
		1034 -> 1036;
	1035 [label="+10 Chemistry",color=orange];
		1035 -> 1037;
	1036 [label="+10 Chemistry",color=orange];
		1036 -> 1038;
	1037 [label="Nie próbowałem też ich do siebie równać, Uzurpatorze. Po prostu stwierdziłem, że mężczyzna może być kochany, ale jednocześnie zdolny do strasznych rzeczy. No cóż... Chyba nie ma nadziei dla nas, zdeprawowanych głupców...",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="Rzeczywiście. Czasami przynosi mi spokój myśl, że skoro nawet ten mistrz zwyrodnienia znalazł bratnią duszę, to jest nadzieja dla nas wszystkich, co? Ha!",shape=box,color=blue];
		1038 -> 1039;
	1039 [label="Update boolean RoatheMargulis1",color=orange];
		1039 -> 1040;
	1040 [label="Ale już wystarczająco dużo czasu ci zabrałem. A teraz odejdź.",shape=box,color=blue];
		1040 -> 1041;
	1041 [label="Chat ends.",color=orange];
}