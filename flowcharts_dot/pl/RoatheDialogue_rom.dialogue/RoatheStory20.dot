	"Chat ends." [color=orange];
	j3326962927 [label="VM: ULEGŁOŚĆ",shape=box,color=blue];
		j3326962927 -> j3950463872;
	j3950463872 [label="Transkrypcja: Od początku rozumiałem, zarówno na polu bitwy, jak i w sypialni, że droga do zwycięstwa wiedzie przez pozorną uległość.",shape=box,color=blue];
		j3950463872 -> j1862323693;
	j1862323693 [label="Tam, gdzie wróg zastanie cię ustępującego, możesz być pewien, że będzie nacierał; więc łatwo możesz wykorzystać co przeciwko niemu.",shape=box,color=blue];
		j1862323693 -> j1285239440;
	j1285239440 [label="\"Sługus\" – nazywali mnie. \"Piesek\". Nitokh myślała, że panuje nad sytuacją. Jak subtelnie ją prowadziłem. ",shape=box,color=blue];
		j1285239440 -> j117222005;
	j117222005 [label="Roathe o krwawych rękach. Roathe, ogr, utuczony na ciałach swoich ludzi. Marnotrawca żyć.",shape=box,color=blue];
		j117222005 -> j653218733;
	j653218733 [label="Jakbym walczył tylko dla ferworu walki! Nie. Imperium Orokin musi się skończyć.",shape=box,color=blue];
		j653218733 -> j1892498058;
	j1892498058 [label="Aby tak się stało, wojna musi trwać. Tylko klęska, absolutna i nieodwołalna, obali te siedem złotych gargulców.",shape=box,color=blue];
		j1892498058 -> j3860380487;
	j3860380487 [label="Nawet Nitokh nie znała mojego celu. Myślała, że pragnę rządzić u jej boku.",shape=box,color=blue];
		j3860380487 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}