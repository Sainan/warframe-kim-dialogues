	j1842956120 [label="VM: SUBMISSION",shape=box,color=blue];
		j1842956120 -> j1249410492;
	j1249410492 [label="Transkrypcja: Od początku rozumiałem, zarówno na polu bitwy, jak i w sypialni, że droga do zwycięstwa wiedzie przez pozorną uległość.",shape=box,color=blue];
		j1249410492 -> j825473497;
	j825473497 [label="Where the enemy finds you yielding, there you can be sure he will push; and so you may easily trip him.",shape=box,color=blue];
		j825473497 -> j3431002561;
	j3431002561 [label="“Lackey,” they called me. “Lapdog.” Nitokh thought herself in control. How subtly I guided her. ",shape=box,color=blue];
		j3431002561 -> j2543995253;
	j2543995253 [label="Roathe o krwawych rękach. Roathe, ogr, utuczony na ciałach swoich ludzi. Marnotrawca żyć.",shape=box,color=blue];
		j2543995253 -> j480414270;
	j480414270 [label="Jakbym walczył tylko dla ferworu walki! Nie. Imperium Orokin musi się skończyć.",shape=box,color=blue];
		j480414270 -> j419847765;
	j419847765 [label="For that to happen, the war must continue. Only defeat, absolute and irrevocable, would topple those seven golden gargoyles.",shape=box,color=blue];
		j419847765 -> j3860380487;
	j3860380487 [label="Nawet Nitokh nie znała mojego celu. Myślała, że pragnę rządzić u jej boku.",shape=box,color=blue];
		j3860380487 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}