	5575 [label="Jedyne, co jest groźniejsze od diabła... to diabeł z przyjaciółmi jak ty, którzy mają u niego dług. Jeśli nie masz nic więcej do dodania, muszę doprowadzić księdza do szaleństwa.",shape=box,color=blue];
		5575 -> 5630;
