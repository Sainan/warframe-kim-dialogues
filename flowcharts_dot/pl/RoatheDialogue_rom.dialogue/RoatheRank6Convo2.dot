	5477 [label="Wygląda na to, że całkowicie zawaliłeś sprawę, czyż nie? To takie zabawne. W każdym razie zapewniam, że możesz liczyć na moją pomoc, jakkolwiek niechętnie by nie przyszła.",shape=box,color=blue];
