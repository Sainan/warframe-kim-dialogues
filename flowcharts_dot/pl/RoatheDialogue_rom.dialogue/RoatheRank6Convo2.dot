	5578 [label="Jesteś nadzwyczaj nietypowym stworzonkiem. Smakowitym, ale nietypowym, kochany Włóczęgo.",shape=box,color=blue];
		5578 -> 5581;
	5576 [label="Jedyne, co jest groźniejsze od diabła... to diabeł z przyjaciółmi jak ty, którzy mają u niego dług. Jeśli nie masz nic więcej do dodania, muszę doprowadzić latającą \"Siostrę Sol\" do szaleństwa.",shape=box,color=blue];
