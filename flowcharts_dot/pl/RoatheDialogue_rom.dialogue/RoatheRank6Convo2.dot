	5588 [label="Że co?",shape=box,color=blue];
		5588 -> 5591;
	5586 [label="Jestem pewien, że w tym stwierdzeniu kryje się odrobina szczerości. Albo przynajmniej wierzę, że sam się nie oszukujesz.",shape=box,color=blue];
		5586 -> 5589;
	5590 [label="Szczerość to cudowna cecha, drogi Włóczęgo. Myślisz, że miałbym ci za złe za to, że dobrze się bawisz? W żadnym razie.",shape=box,color=blue];
		5590 -> 5593;
	5591 [label="Naprawdę, chyba żartujesz?",shape=box,color=blue];
