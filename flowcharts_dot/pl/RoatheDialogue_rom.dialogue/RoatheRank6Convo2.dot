	j3979501558 [label="Zgodnie z naszą umową jestem zmuszony ci wybaczyć, ale kontrakt nic nie wspomina o pozostawieniu twojej głowy w jedności z resztą ciała. Zalecam, żebyś uważał na słowa podczas naszej dalszej współpracy.",shape=box,color=blue];
		j3979501558 -> j547476705;
	j2995118788 [label="Zgodnie z naszą umową jestem zmuszony ci wybaczyć, więc nie rozumiem, dlaczego marnujesz czas na przeprosiny. Niemniej zostają one docenione.",shape=box,color=blue];
