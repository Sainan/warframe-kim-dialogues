		j3639785039 -> j4238361143;
	j4022639251 [label="Wygląda na to, że całkowicie zawaliłeś sprawę, czyż nie? To takie zabawne. W każdym razie zapewniam, że możesz liczyć na moją pomoc, jakkolwiek niechętnie by nie przyszła.",shape=box,color=blue];
		j4022639251 -> j4131265120;
	j3186683090 [label="Jak udało ci się zawalić sprawę z ich dwójką?! Niech będzie. Nie ma sensu płakać nad rozlanym mlekiem.",shape=box,color=blue];
		j3186683090 -> j92471488;
	j4097508684 [label="Udało ci się to spaprać, zarówno ze mną, jak i z Marią. Fantastycznie. Cóż, zapewniam, że masz moją współpracę, choć może być powściągliwa.",shape=box,color=blue];
		j4097508684 -> j2813337339;
	j932282136 [label="Udało ci się to spaprać, zarówno ze mną, jak i z Leonem. Fantastycznie. Cóż, zapewniam, że masz moją współpracę, choć może być powściągliwa.",shape=box,color=blue];
		j932282136 -> j2735325394;
	j2244796877 [label="Wygląda na to, że jestem jedynym, który się jeszcze opiera? Cóż, to upraszcza sprawę. Mogę zapewnić ci moją współpracę, nawet jeśli niechętnie.",shape=box,color=blue];
