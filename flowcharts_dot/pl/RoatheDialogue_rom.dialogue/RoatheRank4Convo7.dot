	j2266048269 [label="Usurper, I am pleased to tell you that your work in the Dark Refractory is complete, and you may stop unearthing my memories.",shape=box,color=blue];
		j2266048269 -> j2965739194;
	j2704836915 [label="Usurper, while there is still some work to be done in the Dark Refractory when it comes to recovering my memories, I am happy to announce that I think I am done with the whole bloody business.",shape=box,color=blue];
		j2704836915 -> j1768739606;
	j2769000335 [label="Usurper, while you have honestly been...remiss in beginning any work at all at the Dark Refractory, I am happy to announce that I think I am done with the whole bloody business.",shape=box,color=blue];
		j2769000335 -> j1969094516;
	j2734079484 [label="While you may believe you are owed both thanks and apologies for what transpired, my asking you to wipe my memories and beginning again, I believe it merely makes us \"even\" for all the pain that I have suffered as a result.",shape=box,color=blue];
		j2734079484 -> j2258728345;
		j2734079484 -> j2746323262;
	j392379440 [label="It feels so empty, all this tail chasing. I suppose only you would know. Well. Let us see it through, shall we?",shape=box,color=blue];
		j392379440 -> j2258728345;
		j392379440 -> j3272335268;
	j2232333382 [label="Usurper, I have a difficult request to put before you. One that brings me no pleasure to bring to you. I know at the very least you are desirous of me, and I would hope there is a place in your heart that has warmed to me...",shape=box,color=blue];
		j2232333382 -> j702451791;
		j2232333382 -> j3518551748;
		j2232333382 -> j4042853205;
	j1137386016 [label="Usurper, I have a difficult request to put before you. One that brings me no pleasure to bring to you. But first, I will ask... have we become friends? Is there some place in your heart that has come to think fondly of me?",shape=box,color=blue];
		j1137386016 -> j348627282;
		j1137386016 -> j623569860;
		j1137386016 -> j2183887114;
	j2965739194 [label="We can quit this task of dallying about inside my mind and putting us all through such fictional flagellation, yes? (Even if the priest does enjoy such a thing.)",shape=box,color=blue];
		j2965739194 -> j3411295349;
	j1768739606 [label="We can stop dallying about inside my mind and putting us all through such fictional flagellation, yes? (Even if the priest does enjoy such a thing.)",shape=box,color=blue];
		j1768739606 -> j3411295349;
	j1969094516 [label="You can forget all about it, now. I am certain you have better things to do with your day than such fictional flagellation, yes? (Even if the priest does enjoy such a thing.)",shape=box,color=blue];
		j1969094516 -> j3077456970;
	j2258728345 [label="We'll get through this. ",shape=box,color=red];
		j2258728345 -> j3363442887;
	j2746323262 [label="I only did it because you asked me to, Roathe. You warned me that you'd be angry. ",shape=box,color=red];
		j2746323262 -> j2466355338;
	j3272335268 [label="We're almost there, like you said.",shape=box,color=red];
		j3272335268 -> j3233408528;
