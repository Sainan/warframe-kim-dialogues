	j3374392925 [label="Uzurpatorze, z przyjemnością informuję, że twoja praca w Ciemnym Refraktorium dobiegła końca i możesz przestać odzyskiwać moje wspomnienia.",shape=box,color=blue];
		j3374392925 -> j466389412;
	j620477984 [label="Uzurpatorze, choć w Ciemnym Refraktorium wciąż czeka cię wiele pracy w celu odzyskania moich wspomnień, z radością ogłaszam, że skończyłem z tym całym bałaganem.",shape=box,color=blue];
		j620477984 -> j3488371890;
	j1549423022 [label="Uzurpatorze, chociaż szczerze mówiąc, zaniedbałeś sprawę podjęcia jakichkolwiek działań w Ciemnym Refraktorium, z radością ogłaszam, że skończyłem z tym całym bałaganem.",shape=box,color=blue];
		j1549423022 -> j1349312352;
	j1549778371 [label="Możesz uważać, że należą ci się podziękowania i przeprosiny za minione wydarzenia. Moja prośba odebrania mi wspomnień i zaczęcia wszystkiego od nowa, moim zdaniem zaledwie \"wyrównuje nasz rachunek\" za cały ból, jaki przez ciebie doświadczyłem.",shape=box,color=blue];
		j1549778371 -> j356529534;
		j1549778371 -> j3447356484;
	j630037165 [label="To wszystko zdaje się takie bezcelowe, ta pogoń za własnym ogonem. Chyba tylko ty to rozumiesz. No cóż, zobaczmy, jaki będzie koniec?",shape=box,color=blue];
		j630037165 -> j356529534;
		j630037165 -> j436658270;
	j139153151 [label="Uzurpatorze, przychodzę do ciebie z trudną prośbą. Prośbą, która nie sprawia mi żadnej przyjemności. Zdaję sobie sprawę, że pragniesz mnie i mam nadzieję, że znajdę jeszcze ciepły kąt w twoim sercu...",shape=box,color=blue];
		j139153151 -> j2371450869;
		j139153151 -> j433394308;
		j139153151 -> j1701005914;
	j3408984553 [label="Uzurpatorze, przychodzę do ciebie z trudną prośbą. Prośbą, która nie sprawia mi żadnej przyjemności. Pierw muszę jednak zapytać... czy zostaliśmy przyjaciółmi? Czy jakaś część ciebie ma o mnie dobre zdanie?",shape=box,color=blue];
		j3408984553 -> j677512270;
		j3408984553 -> j857513698;
		j3408984553 -> j4293195875;
	j466389412 [label="Możemy zaprzestać grzebania w moim umyśle i tej bezcelowej chłosty, prawda? (Nawet jeśli jest to ulubione zajęcie tego księdza.)",shape=box,color=blue];
		j466389412 -> j1026081358;
	j3488371890 [label="Możemy zaprzestać grzebania w moim umyśle i tej bezcelowej chłosty, prawda? (Nawet jeśli jest to ulubione zajęcie księdza.)",shape=box,color=blue];
		j3488371890 -> j1026081358;
	j1349312352 [label="Możesz zapomnieć o całym przedsięwzięciu. Jestem pewien, że masz ciekawsze zajęcia, niż biczowanie się we śnie, czyż nie? (Nawet jeśli jest to ulubione zajęcie tego księdza.)",shape=box,color=blue];
		j1349312352 -> j3077456970;
	j356529534 [label="Poradzimy sobie. ",shape=box,color=red];
		j356529534 -> j1098351795;
	j3447356484 [label="Zrobiłem to na twoje życzenie, Roathe. Ostrzegałeś mnie, że może cię to rozwścieczyć. ",shape=box,color=red];
		j3447356484 -> j2602976651;
	j436658270 [label="Jak mówiłeś, to już prawie koniec.",shape=box,color=red];
		j436658270 -> j2379014749;
	j2371450869 [label="Zależy mi na tobie, Roathe. To, czy powinienem, pozostaje kwestią sporną.",shape=box,color=red];
		j2371450869 -> j2866733524;
	j433394308 [label="Zmieniłem zdanie, kiedy miałem okazję cię lepiej poznać. Nie mogę cię znieść.",shape=box,color=red];
		j433394308 -> j485052056;
