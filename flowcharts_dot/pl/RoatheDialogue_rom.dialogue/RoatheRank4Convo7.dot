		j702451791 -> j2853311213;
	j3518551748 [label="I've changed my mind on all that after getting to know you more. I can't stand you.",shape=box,color=red];
		j3518551748 -> j739581354;
	j4042853205 [label="I care deeply about you Roathe. Legitimately, I do. I'm not sure if I should be, but... I think I'm falling in love with you.",shape=box,color=red];
