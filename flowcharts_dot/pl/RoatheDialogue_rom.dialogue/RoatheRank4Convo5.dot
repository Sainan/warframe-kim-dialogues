		j1304511923 -> j3410173454;
	j4025465238 [label="Zaskakująco... Nie. Może to dlatego, że ostatnio spędziłem... zdecydowanie zbyt wiele lat uwięziony w krypcie z tymi dwoma fanatykami, ale jestem zszokowany, że żaden zapis o tym, jak Orokin obchodzili się ze zmarłymi, nie przetrwał przez tysiąclecia.",shape=box,color=blue];
		j4025465238 -> j2638639172;
		j4025465238 -> j1745962474;
