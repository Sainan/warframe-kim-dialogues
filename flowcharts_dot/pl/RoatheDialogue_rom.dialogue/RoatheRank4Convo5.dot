	j3152757626 [label="To całkiem sprawiedliwe. Ignorujesz jednak całe fragmenty naszej historii i dziedzictwa kulturowego. Wiem, że po upadku nie cieszyliśmy się dobrą opinią, ale...",shape=box,color=blue];
		j3152757626 -> j1282756747;
	j591419577 [label="Hmm. Po prostu wydaje mi się dziwne, że tak mało pełnych zapisów o naszym społeczeństwie i naszej kulturze przetrwało. Wiem, że po upadku nie cieszyliśmy się dobrą opinią, ale...",shape=box,color=blue];
		j591419577 -> j2540139723;
	"Chat ends." [color=orange];
	j1282756747 [label="Nie ma nawet wzmianki o tym, co stało się z Krioleum?",shape=box,color=blue];
