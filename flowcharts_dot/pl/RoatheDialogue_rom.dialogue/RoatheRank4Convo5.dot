		j759024383 -> j3754059690;
	j56247934 [label="Nie myślałem, że umarłeś. Po prostu kradłeś nowe ciała w Teatrze Yuvan.",shape=box,color=red];
		j56247934 -> j642217215;
	j1344454659 [label="Mów dalej.",shape=box,color=red];
		j1344454659 -> j2501923451;
	j3628652803 [label="Tak, ale co z tymi, którzy byli \"blisko\", ale \"niewystarczająco ważni\"? Archimedianie? Niżsi rangą Orokin? Zawsze istniały warstwy w warstwach. Nawet jeśli sufity były szklane, to one istniały. Wierz mi.",shape=box,color=blue];
		j3628652803 -> j1532832606;
	j4060369304 [label="Rzeczywiście, robiliśmy to na każdym możliwym kroku. Ale nie wszyscy zostali oszczędzeni, prawda? A co z tymi, którzy byli \"blisko\", ale \"niewystarczająco ważni\"? Archimedianie? Niżsi rangą Orokin?",shape=box,color=blue];
		j4060369304 -> j3606497780;
	j3754059690 [label="Pomyśl o wszystkich tych, którzy byli \"blisko\", ale \"niewystarczająco ważni\"? Archimedianie? Niżsi rangą Orokin? Zawsze istniały warstwy w warstwach. Nawet jeśli sufity były szklane, to one istniały. Wierz mi.",shape=box,color=blue];
		j3754059690 -> j1532832606;
	j642217215 [label="Tak, ale co z tymi, którzy byli \"blisko\", ale \"niewystarczająco ważni\"? Archimedianie? Niżsi rangą Orokin? Zawsze istniały warstwy w warstwach. Nawet jeśli sufity były szklane, to one istniały. Wierz mi.",shape=box,color=blue];
		j642217215 -> j880742334;
	j2501923451 [label="Pomyśl o wszystkich tych, którzy byli \"blisko\", ale \"niewystarczająco ważni\"? Archimedianie? Niżsi rangą Orokin? Zawsze istniały warstwy w warstwach. Nawet jeśli sufity były szklane, to one istniały. Wierz mi.",shape=box,color=blue];
		j2501923451 -> j880742334;
	j1532832606 [label="Nie każdy miał tyle szczęścia, by za każdym razem, gdy jego stara forma się wypalała, otrzymać nowe ciało. Ale jestem pewny, że uważasz Teatr Yuvan za odrażającą praktykę, prawda?",shape=box,color=blue];
		j1532832606 -> j97012104;
		j1532832606 -> j3072270491;
	j3606497780 [label="Nie każdy miał tyle szczęścia, by za każdym razem, gdy jego stara forma się wypalała, otrzymać nowe ciało. Najwyraźniej uważasz Teatr Yuvan za odrażającą praktykę.",shape=box,color=blue];
		j3606497780 -> j1035032010;
		j3606497780 -> j3072270491;
	j880742334 [label="Nie każdy miał tyle szczęścia, by za każdym razem, gdy jego stara forma się wypalała, otrzymać nowe ciało. Ale jestem pewny, że uważasz Teatr Yuvan za odrażającą praktykę, prawda?",shape=box,color=blue];
		j880742334 -> j3164354337;
		j880742334 -> j722395385;
	j97012104 [label="Nie mam wystarczającej wiedzy na temat tej praktyki, aby wydać osąd.",shape=box,color=red];
		j97012104 -> j3004972647;
	j3072270491 [label="Tak. Uważam, że to, co wszyscy zrobiliście, było odrażające. Wszystko, co napisano o Teatrze Yuvan, mówi, że porwaliście dzieci i wymazaliście ich umysły.",shape=box,color=red];
		j3072270491 -> j1245830395;
	j1035032010 [label="Jak mógłbym nie? Porwaliście dzieci z ich domów i wymazaliście ich umysły, by zastąpić je swoimi własnymi!",shape=box,color=red];
		j1035032010 -> j4014308767;
	j3164354337 [label="Nie mam wystarczającej wiedzy na temat tej praktyki, aby wydać osąd.",shape=box,color=red];
		j3164354337 -> j254375552;
	j722395385 [label="Tak. Uważam, że to, co wszyscy zrobiliście, było odrażające. Wszystko, co napisano o Teatrze Yuvan, mówi, że porwaliście dzieci i wymazaliście ich umysły.",shape=box,color=red];
		j722395385 -> j967356260;
	j3004972647 [label="+5 Chemistry",color=orange];
		j3004972647 -> j3313175629;
	j1245830395 [label="\"Wszystko, co napisano o Teatrze Yuvan, mówi\". Gdzie to wszystko jest zapisane? A co ważniejsze, kto to wszystko napisał?",shape=box,color=blue];
		j1245830395 -> j2667297996;
	j4014308767 [label="A skąd wiesz o tym wszystkim? Czy byłeś świadkiem ceremonii w Teatrze Yuvan?",shape=box,color=blue];
		j4014308767 -> j3079684328;
		j4014308767 -> j3206008196;
		j4014308767 -> j1159056833;
	j254375552 [label="+5 Chemistry",color=orange];
		j254375552 -> j3313175629;
	j967356260 [label="A jednak właśnie powiedziałeś, że przetrwały jedynie kawałki naszej historii i zapisów kulturowych. A gdzie to wszystko jest zapisane? A co ważniejsze, kto to wszystko napisał?",shape=box,color=blue];
		j967356260 -> j2667297996;
	j3313175629 [label="Wstrzymujesz się z osądem, dopóki nie zdobędziesz wszystkich informacji? O rany, Uzurpatorze! Z pewnością nie brakuje ci inteligencji! Jakież to rzadkie!",shape=box,color=blue];
		j3313175629 -> j3883265986;
	j2667297996 [label="To historie opowiadane przez tych, którzy mają wyraźny interes w ukazywaniu każdego aspektu Orokin w jak najtragiczniejszym i najciemniejszym świetle.",shape=box,color=blue];
		j2667297996 -> j3380564601;
	j3079684328 [label="Nie.",shape=box,color=red];
		j3079684328 -> j2284763134;
	j3206008196 [label="Tak.",shape=box,color=red];
		j3206008196 -> j3748124245;
	j1159056833 [label="Nie ma znaczenia, czy widziałem to osobiście, czy nie, relacje są jednoznaczne.",shape=box,color=red];
		j1159056833 -> j3176831209;
	j3883265986 [label="Pozwól, że zmienię dla ciebie perspektywę historii, jeśli mogę. Zastanów się, skąd pochodzą relacje o Teatrze Yuvan, które mogłeś słyszeć.",shape=box,color=blue];
		j3883265986 -> j2667297996;
	j3380564601 [label="Ci, którzy burzą wszystkie struktury wspierające społeczeństwo Systemu Origin i pogrążają je w całkowitym chaosie, muszą dać tym, którzy polegają na tym społeczeństwie, dobry powód, aby działali w ten sposób.",shape=box,color=blue];
		j3380564601 -> j1112330550;
	j2284763134 [label="Więc polegasz na opowieściach z drugiej ręki. Zastanów się, gdzie te relacje zostały zapisane. A co ważniejsze, zastanów się, kto je napisał.",shape=box,color=blue];
		j2284763134 -> j2667297996;
	j3748124245 [label="Ha! Kłamca.",shape=box,color=blue];
		j3748124245 -> j2311733010;
	j3176831209 [label="Czyżby? Zastanów się, gdzie te relacje zostały zapisane. A co ważniejsze, zastanów się, kto napisał te wszystkie relacje.",shape=box,color=blue];
		j3176831209 -> j2667297996;
	j1112330550 [label="Rozważ życie przeciętnego człowieka na przekaźniku, Uzurpatorze. Takiego, który jest daleko od prób i udręk Tenno. Takiego, który nie troszczył się o Wielką Wojnę.",shape=box,color=blue];
		j1112330550 -> j1929402814;
	j2311733010 [label="Polegasz na opowieściach z drugiej ręki. Zastanów się, gdzie te relacje zostały zapisane. A co ważniejsze, zastanów się, kto je napisał.",shape=box,color=blue];
		j2311733010 -> j2667297996;
	j1929402814 [label="Po upadku Orokin ich istnienie przeistoczyło się w piekło, pogrążyło w bezsilności. Trzeba było wymyślić wyjaśnienia. Trzeba było stworzyć i spalić kukły. Musieliśmy stać się potworami z cieni.",shape=box,color=blue];
		j1929402814 -> j3591903549;
		j1929402814 -> j142591871;
	j3591903549 [label="Czy chcesz mi powiedzieć, że nie porwałeś żadnych dzieci wbrew ich woli do Teatru Yuvan?",shape=box,color=red];
		j3591903549 -> j3644611880;
	j142591871 [label="Więc co tak naprawdę wydarzyło się w Teatrze Yuvan?\n",shape=box,color=red];
		j142591871 -> j3068529337;
	j3644611880 [label="Nie, to jest całkowita prawda.",shape=box,color=blue];
		j3644611880 -> j1157055650;
	j3068529337 [label="+5 Chemistry",color=orange];
		j3068529337 -> j3492125838;
	j1157055650 [label="Chcę po prostu, żebyś zastanowił się nad swoimi źródłami, to wszystko.",shape=box,color=blue];
		j1157055650 -> j1072998845;
	j3492125838 [label="Mówić, że nie składaliśmy ofiar wbrew ich woli, to nieprawda. Składaliśmy. Ale to nie cała prawda. Rzadko kiedy coś jest tak proste, a już na pewno nie czarno-białe.",shape=box,color=blue];
		j3492125838 -> j3231071861;
	j1072998845 [label="Bo to nie cała prawda. Rzadko kiedy coś jest tak proste, a już na pewno nie czarno-białe. Świat jest szary, Uzurpatorze. Granice nie rysują się tak łatwo. ",shape=box,color=blue];
		j1072998845 -> j2459389716;
	j3231071861 [label="Świat jest szary, Uzurpatorze. Granice nie rysują się tak łatwo.",shape=box,color=blue];
		j3231071861 -> j2459389716;
	j2459389716 [label="Praktyka nie zaczęła się w tak haniebny sposób. Początkowo była postrzegana jako najwyższy zaszczyt. Oddać siebie, by Imperium mogło trwać nieprzerwane. Niezłamane. By praca mogła trwać.",shape=box,color=blue];
		j2459389716 -> j1054668591;
	j1054668591 [label="Nie zaczęło się też od młodych. Zaczęło się od tych, którzy po prostu mieli więcej lat życia. Ale potem ci, którzy się ofiarowali, stawali się... coraz młodsi. Oddanie to potężny narkotyk.",shape=box,color=blue];
		j1054668591 -> j1490492151;
	j1490492151 [label="Widziałem coś podobnego u tych, którzy zaciągnęli się do wojny. Kłamali o swoim wieku w dokumentach, by \"walczyć w słusznej sprawie\". Mało wiedzieli, że tym samym ustanawiali niebezpieczny precedens dla tych, którzy przyszli po nich, nieświadomie i wbrew swojej woli.",shape=box,color=blue];
		j1490492151 -> j1677688776;
	j1677688776 [label="Gdzieś po drodze, któryś z Egzekutorów zdał sobie sprawę, że można to wykorzystać jako... karę. Że niektóre miasta, a nawet... całe planety, można trzymać w ryzach, jeśli zagrożenie ze strony Teatru Yuvan stanie się realne. Jeśli kolekcja ofiar zostanie użyta w szczególnie brutalny sposób.",shape=box,color=blue];
		j1677688776 -> j2747724173;
		j1677688776 -> j1642059187;
	j2747724173 [label="A jak ty się z tym czujesz?",shape=box,color=red];
		j2747724173 -> j3938336472;
	j1642059187 [label="Czy kiedykolwiek brałeś udział w ofierze, która była składana wbrew woli?",shape=box,color=red];
		j1642059187 -> j732574153;
	j3938336472 [label="+5 Chemistry",color=orange];
		j3938336472 -> j3250695937;
	j732574153 [label="Nie będę kłamał. Zrobiłem to. I możesz mnie nazywać potworem, jeśli chcesz. Ale kiedy całe społeczeństwo opiera się na wiekach normalizacji czegoś, bardzo trudno się od tego odwrócić.",shape=box,color=blue];
		j732574153 -> j2828086387;
	j3250695937 [label="Hmm. Mam mieszane uczucia. Z jednej strony, sam brałem udział w Teatrze wiele razy. Byłbym absolutnym hipokrytą, gdybym go potępiał. Kiedy całe społeczeństwo opiera się na wiekach normalizacji czegoś, bardzo trudno się od tego odwrócić.",shape=box,color=blue];
		j3250695937 -> j781043505;
	j2828086387 [label="Nawet kiedy z perspektywy czasu, czy w chwili przejrzystości, wszystko staje się tak bardzo jasne ",shape=box,color=blue];
		j2828086387 -> j1174685899;
	j781043505 [label="Z drugiej strony, patrząc z dystansu lub z perspektywy czasu, groza tego czynu staje się całkiem oczywista.",shape=box,color=blue];
		j781043505 -> j1174685899;
	j1174685899 [label="+5 Chemistry",color=orange];
		j1174685899 -> j1069631819;
	j1069631819 [label="Nikt nie powinien żyć wiecznie, Uzurpatorze. A Teatr jest tego dowodem.",shape=box,color=blue];
		j1069631819 -> "Chat ends.";
}