digraph {
	"RoatheRank4Convo5 begins." [color=orange];
		"RoatheRank4Convo5 begins." -> j468870031;
	j468870031 [label="Co pamiętasz ze swojego pobytu w Imperium, Uzurpatorze? Wydaje się, że wspomnienia są, delikatnie mówiąc, fragmentaryczne. Oczywiście, nie mnie to oceniać.",shape=box,color=blue];
