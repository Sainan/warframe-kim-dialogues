digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank4Convo8 begins." [color=orange];
		"RoatheRank4Convo8 begins." -> j1651427989;
		"RoatheRank4Convo8 begins." -> j386906797;
	j1651427989 [label="Jak wyglądało twoje dzieciństwo?",shape=box,color=red];
		j1651427989 -> j4089267782;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j4089267782 [label="Hmm? Intrygujące pytanie. \"Jakie\" było? Szczerze, nie pamiętam z tego okresu wiele. Wszelkie gwiazdy i rzeźby, które zawierały te wspomnienia, już dawno obróciły się w proch, albo zostały przetopione na Endo.",shape=box,color=blue];
		j4089267782 -> j243693264;
	"Chat ends." [color=orange];
	j243693264 [label="Obawiam się, że pamiętam tylko niewyraźne obrazy. Zastanawiam się, czy nie wyśniłem sobie tych chwil, albo czy nie są to wspomnienia wydarzeń z książek, które czytałem.",shape=box,color=blue];
		j243693264 -> j1402799793;
	j1402799793 [label="Zatem muszę przyznać, że to, co pamiętam, raczej nie będzie rzetelne. Dlaczego pytasz?",shape=box,color=blue];
		j1402799793 -> j742885531;
		j1402799793 -> j3971986400;
		j1402799793 -> j716706902;
	j742885531 [label="Nawet jeśli te historie nie są prawdziwe, nadal uważasz je za lata swojej młodości. Warto je zapamiętać.",shape=box,color=red];
		j742885531 -> j3777368450;
	j3971986400 [label="Zastanawiałem się jak to było dorastać wśród szlachty Orokin.",shape=box,color=red];
		j3971986400 -> j1372091006;
	j716706902 [label="Zastanawiałem się, co uczyniło cię \"tobą\", jak stałeś się kimś takim.",shape=box,color=red];
		j716706902 -> j2010447310;
	j3777368450 [label="+5 Chemistry",color=orange];
		j3777368450 -> j915178411;
	j1372091006 [label="W młodym wieku zostałem zesłany w miejsce, które fanatycy nazwaliby \"szkołą z internatem\", jak cała młodzież Orokin, której pisana była świetlana przyszłość. Tam byłem poddawany próbom i trenowany pod kątem moich predyspozycji i zdolności.",shape=box,color=blue];
		j1372091006 -> j1632793270;
		j1372091006 -> j3937653641;
	j2010447310 [label="+5 Chemistry",color=orange];
		j2010447310 -> j2324031088;
	j915178411 [label="Zgadzam się. Kłamstwa, które sobie wmawiamy, często znaczą więcej, niż prawda. Cudowne spostrzeżenie, Uzurpatorze.",shape=box,color=blue];
		j915178411 -> j2120399082;
	j1632793270 [label="Rodzice cię odesłali? Na jak długo?",shape=box,color=red];
		j1632793270 -> j2428267216;
	j3937653641 [label="Jak tam było?",shape=box,color=red];
		j3937653641 -> j3985127301;
	j2324031088 [label="Próbujesz dociec, co dokładnie poszło \"nie tak\"? Teraz rozumiem! Jakie to zabawne. Nie wiem, czy moje dzieciństwo odpowie na którekolwiek z twoich pytań.",shape=box,color=blue];
		j2324031088 -> j3530685585;
	j2120399082 [label="Add -1 to Thermostat counter",color=orange];
		j2120399082 -> j1372091006;
	j2428267216 [label="Całą moją młodość. Nie sądzę, żebym jeszcze kiedykolwiek ujrzał dwójkę ludzi, która mnie spłodziła. Może podczas ceremonii, kiedy zostałem wyróżniony na tle klasy?",shape=box,color=blue];
		j2428267216 -> j1798737274;
	j3985127301 [label="Myślę, że opinie różniłyby się w zależności od tego, z kim rozmawiasz. Kiedy tam przybyłem, bicia ze strony starszych chłopców były szybkimi i brutalnie skutecznymi lekcjami.",shape=box,color=blue];
		j3985127301 -> j2992939281;
	j3530685585 [label="Add 1 to Thermostat counter",color=orange];
		j3530685585 -> j1372091006;
	j1798737274 [label="To mógł być pierwszy raz w życiu, kiedy uznali za stosowne przyznać się do mnie. Nie przywiązałem do tego większej wagi.",shape=box,color=blue];
		j1798737274 -> j342324879;
	j2992939281 [label="Ale pod każdym względem szybko się uczę. I nauczyłem się, że jeśli chcę osiągnąć sukces w tej konkretnej dziedzinie Archimediów, najlepiej będzie, jeśli zastosuję kreatywne techniki, aby nie zagubić się wśród pospólstwa.",shape=box,color=blue];
		j2992939281 -> j1434982547;
		j2992939281 -> j3080718508;
	j342324879 [label="Nie pamiętam swoich rodziców. Niektórzy z Orokin dumnie wychowywali swoje potomstwo, moi nie. Chętnie się mnie pozbyli, żeby móc wrócić do swoich żyć.",shape=box,color=blue];
		j342324879 -> j953952987;
		j342324879 -> j3763236090;
	j1434982547 [label="Archimedianie na to pozwalali?",shape=box,color=red];
		j1434982547 -> j2900404938;
	j3080718508 [label="To... brzmi okropnie.",shape=box,color=red];
		j3080718508 -> j711067188;
	j953952987 [label="Nie wygląda, żeby jakkolwiek powstrzymywało cię to w życiu.",shape=box,color=red];
		j953952987 -> j765044707;
	j3763236090 [label="Przykro mi to słyszeć. To brzmi jak bardzo smutne życie.",shape=box,color=red];
		j3763236090 -> j765044707;
	j2900404938 [label="Mój biedny Uzurpatorze, to sam Dyrektor przyprowadził sługę i butelkę Kuvy, kiedy sprawy z nowicjuszem zaszły za daleko.",shape=box,color=blue];
		j2900404938 -> j323086943;
	j711067188 [label="Tradycja to potężne narzędzie, Uzurpatorze. Potężne i niebezpieczne narzędzie, które zdoła poprowadzić każdego rozsądnego człowieka torem rozumowania szaleńca.",shape=box,color=blue];
		j711067188 -> j3108551622;
	j765044707 [label="Wręcz przeciwnie. Brak więzi pozwolił mi oddać się strategiom wojskowym, które moim rówieśnikom wydawały się archaiczne i przestarzałe. ",shape=box,color=blue];
		j765044707 -> j3658479471;
	j323086943 [label="Tradycja to potężne narzędzie. Potężne i niebezpieczne narzędzie, które zdoła poprowadzić każdego rozsądnego człowieka torem rozumowania szaleńca.",shape=box,color=blue];
		j323086943 -> j2797668578;
		j323086943 -> j1551430438;
	j3108551622 [label="To sam Dyrektor przyprowadził sługę i butelkę Kuvy, kiedy sprawy z nowicjuszem zaszły za daleko.",shape=box,color=blue];
		j3108551622 -> j2797668578;
		j3108551622 -> j1551430438;
	j3658479471 [label="Nie zdawali sobie sprawy, jak bardzo przydatne okażą się w przyszłości.",shape=box,color=blue];
		j3658479471 -> j906694899;
		j3658479471 -> j1546944335;
	j2797668578 [label="A co z twoimi rodzicami?",shape=box,color=red];
		j2797668578 -> j342324879;
	j1551430438 [label="Miałeś tam jakichś przyjaciół?",shape=box,color=red];
		j1551430438 -> j2675763175;
	j906694899 [label="Uważasz, że było warto?",shape=box,color=red];
		j906694899 -> j71340042;
	j1546944335 [label="Wygląda jednak na to, że wiodłeś samotne życie.",shape=box,color=red];
		j1546944335 -> j478907384;
	j2675763175 [label="Nie. Trzymałem się na uboczu. Szybko nauczyłem się, że strach łatwo wywołać i władać nim w innych, ale jest to delikatny szron, który znika w blasku światła dnia.",shape=box,color=blue];
		j2675763175 -> j2789934115;
	j71340042 [label="Moi rówieśnicy nie mieli pojęcia, jak bardzo pomocne okazały się te nauki w przyszłości. Ale jeśli pytasz mnie, czy było to dobre, czy złe?",shape=box,color=blue];
		j71340042 -> j2274222224;
	j478907384 [label="Tak, takie było. Ale tak wygląda przecież życie diabła, czyż nie? Nawet wtedy byłem postrzegany jako bezsilny pomocnik i konkubent potężnego wodza i szalejącego potwora.",shape=box,color=blue];
		j478907384 -> j1445083231;
	j2789934115 [label="Potwory muszą być trzymane w ciemności. Jeśli miałem zachować pozór zagrożenia, musiałem pozostać sam.",shape=box,color=blue];
		j2789934115 -> j953952987;
		j2789934115 -> j3763236090;
	j2274222224 [label="Hm. Na to nie zdołam odpowiedzieć.",shape=box,color=blue];
		j2274222224 -> j972343332;
		j2274222224 -> j1742016951;
	j1445083231 [label="Nigdy nie byłem mile widziany wśród wyżej ani niżej postawionych. Nie było też nikogo na równi.",shape=box,color=blue];
		j1445083231 -> j299591844;
	j972343332 [label="Ale otrzymałeś kolejną szansę, aby odpłacić za swoje grzechy. Oni nie.",shape=box,color=red];
		j972343332 -> j3851732159;
	j1742016951 [label="No cóż, oni nie żyją, a ty tak. Uważam, że to lepiej niż gorzej?",shape=box,color=red];
		j1742016951 -> j850951373;
	j299591844 [label="Boolean RoatheUnloved2 is now true.",color=orange];
		j299591844 -> j972343332;
		j299591844 -> j2674987073;
	j3851732159 [label="Add 1 to Thermostat counter",color=orange];
		j3851732159 -> j320078542;
	j850951373 [label="Add -1 to Thermostat counter",color=orange];
		j850951373 -> j320078542;
	j2674987073 [label="Przynajmniej masz resztę swojej przyszłości, którą możesz przeżyć, jak chcesz. Oni nie.",shape=box,color=red];
		j2674987073 -> j850951373;
	j320078542 [label="+5 Chemistry",color=orange];
		j320078542 -> j1332088024;
	j1332088024 [label="Przekonamy się, czyż nie?",shape=box,color=blue];
		j1332088024 -> "Chat ends.";
}