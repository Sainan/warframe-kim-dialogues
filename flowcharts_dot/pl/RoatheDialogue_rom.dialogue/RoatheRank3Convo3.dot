		j1787026705 -> j1378468891 [label=true,color=green];
		j1787026705 -> j406592759 [label=false,color=brown];
	j3534909646 [label="Nie wyglądają na zbyt miłe. ",shape=box,color=red];
		j3534909646 -> j3990023078;
	j548597839 [label="Nie wyglądają na zbyt miłe. Na pewno tego chcesz?",shape=box,color=red];
		j548597839 -> j2953894727;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j2132260339 [label="Miałem z tym problem... Ile bym się nie starał, wciąż umieram.",shape=box,color=red];
		j2132260339 -> j2912542134;
	j3109802633 [label="Nie rozkazuj mi, Roathe.",shape=box,color=red];
		j3109802633 -> j3624298727;
	j2146649297 [label="Miałem wiele na głowie. Zajmę się tym.",shape=box,color=red];
		j2146649297 -> j3470254174;
	j1378468891 [label="Nie tylko wybaczyłem ci to, że odebrałeś mi te wspomnienia...",shape=box,color=blue];
		j1378468891 -> j3666278889;
	j406592759 [label="Zaczynam ci wybaczać nie tylko to, że odebrałeś mi te wspomnienia...",shape=box,color=blue];
		j406592759 -> j3666278889;
	j3990023078 [label="Nie. Nie są. Czego się spodziewałeś po \"Diable z Tau\", wspomnień słonecznego popołudnia w parku, leżenia na kocu i jedzenia winogron z talerza?",shape=box,color=blue];
		j3990023078 -> j3282763705;
	j2953894727 [label="Nie dowiem się, co mi zabrał, dopóki tego wszystkiego nie odzyskam. Oczywiście, że powinniśmy iść dalej! Te wspomnienia należą do mnie, Włóczęgo. Stanowią one to, kim jestem, kim byłem. Stanowią istotę mojego bytu.",shape=box,color=blue];
		j2953894727 -> j2882489183;
	"Chat ends." [color=orange];
	j2912542134 [label="Boolean RoatheStrugglebus is now true.",color=orange];
		j2912542134 -> j2705738104;
	j3624298727 [label="Nie, nie jesteś. I nie ma dla mnie znaczenia, co robisz w ciągu dnia. Mówię tylko, że jeśli chcesz, żeby ten chudy kamerdyner wszedł po tych schodach, to masz robotę do wykonania.",shape=box,color=blue];
		j3624298727 -> j3936378787;
	j3470254174 [label="Dopilnuj tego. Nie ma dla mnie znaczenia, co robisz w ciągu dnia. Mówię tylko, że jeśli chcesz, żeby ten chudy kamerdyner wszedł po tych schodach, to masz robotę do wykonania.",shape=box,color=blue];
		j3470254174 -> j1878854518;
	j3666278889 [label="Ale zaczynam znów chcieć ci zaufać. Znów! Wiedząc doskonale, co zrobiłeś. Wiedząc, że możesz mnie po prostu zdradzić po raz kolejny!",shape=box,color=blue];
		j3666278889 -> j2307983095;
	j3282763705 [label="Mój biedny Uzurpatorze, obawiam się, że w annałach mojego umysłu znajdziemy jedynie krew, flaki i porażkę.",shape=box,color=blue];
		j3282763705 -> j1058490379;
		j3282763705 -> j126512416;
	j2882489183 [label="Z tego, co dowiedziałem się od innych na temat twojego pobytu w Duviri, wynika, że ciebie także spotkał podobny los, prawda?",shape=box,color=blue];
		j2882489183 -> j999371848;
		j2882489183 -> j2806459527;
	j2705738104 [label="Słyszę tylko opowieści o tym, jak pokonałeś Narmer. Pokonałeś hordy żołnierzy Grineer. Pokonywałeś fale Szeptu na każdym kroku. A to mnie udało się ciebie pokonać?",shape=box,color=blue];
		j2705738104 -> j1097427882;
	j3936378787 [label="Jeśli tobie nie zależy? To mnie też nie. Mam własne problemy na głowie.",shape=box,color=blue];
		j3936378787 -> "Chat ends.";
	j1878854518 [label="Jeśli tobie nie zależy? To mnie też nie. Mam własne problemy na głowie.",shape=box,color=blue];
		j1878854518 -> j1933300832;
	j2307983095 [label="Ale siedzę w tej krypcie, wstaję z krzesła i myślę sobie: \"Ciekawe, czy Włóczęga jest w pobliżu i czy chce przemówić\".",shape=box,color=blue];
		j2307983095 -> j854134557;
	j1058490379 [label="To ty jesteś kapitanem tego statku. Jeśli chcesz nim dalej płynąć w kierunku czarnej dziury, cała naprzód.",shape=box,color=red];
		j1058490379 -> j1757935439;
	j126512416 [label="Czy jesteś pewien, że chcesz kontynuować?",shape=box,color=red];
		j126512416 -> j375050718;
	j999371848 [label="Jesteśmy bardzo różnymi ludźmi, Roathe.",shape=box,color=red];
		j999371848 -> j1879407883;
	j2806459527 [label="Byłem. Pamięć i apatia. Nadal nie mogę sobie przypomnieć... długich okresów, które tam spędziłem.",shape=box,color=red];
		j2806459527 -> j1637373080;
	j1097427882 [label="+20 Chemistry",color=orange];
		j1097427882 -> j3775124311;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j854134557 [label="Jakież to żałosne! Jak nisko upadłem? Ja?! Orokin?! Roathe! Diabeł z Tau! Tak niespokojny, tak wygłodniały intelektualnie, tak zdesperowany potrzebą jakiejkolwiek stymulacji, że jestem tu i rozmawiam z tobą!",shape=box,color=blue];
		j854134557 -> j2622317018;
		j854134557 -> j2742733324;
		j854134557 -> j524438601;
		j854134557 -> j386906797;
	j1757935439 [label="+10 Chemistry",color=orange];
		j1757935439 -> j2301934714;
	j375050718 [label="Nie dowiem się, co mi zabrał, dopóki tego wszystkiego nie odzyskam. Oczywiście, że powinniśmy iść dalej! Te wspomnienia należą do mnie, Włóczęgo. Stanowią one to, kim jestem, kim byłem. Stanowią istotę mojego bytu.",shape=box,color=blue];
		j375050718 -> j4272650453;
		j375050718 -> j3604665805;
	j1879407883 [label="Może i tak, ale nie o to mi chodziło. Ty unikasz przyznania się do winy. Bardzo dobrze. Gdybyś teoretycznie stracił wspomnienia – czy próbowałbyś je odzyskać, gdybyś mógł?",shape=box,color=blue];
		j1879407883 -> j4272650453;
		j1879407883 -> j3604665805;
	j1637373080 [label="Czy gdybyś miał okazję odzyskać utracone wspomnienia, skorzystałbyś z niej?",shape=box,color=blue];
		j1637373080 -> j4272650453;
		j1637373080 -> j3604665805;
		j1637373080 -> j2883599640;
	j3775124311 [label="Zakładając, że mnie nie okłamujesz? Przyznaję, że to dość pochlebne. Urocze. Niezwykle smutne. Ale pochlebne.",shape=box,color=blue];
		j3775124311 -> "Chat ends.";
	j2622317018 [label="Z niecierpliwością czekam na nasze rozmowy, niezależnie od tego, czy ty też, czy nie.",shape=box,color=red];
		j2622317018 -> j3256662694;
	j2742733324 [label="Postaram się nie brać tego do siebie.",shape=box,color=red];
		j2742733324 -> j132704304;
	j524438601 [label="A może po prostu lubisz ze mną rozmawiać?",shape=box,color=red];
		j524438601 -> j2326869908;
	j2301934714 [label="Dobrze powiedziane, Włóczęgo. Nie dowiem się, jak wiele mi odebrano, dopóki tego wszystkiego nie odzyskam. Te wspomnienia tworzą to, kim jestem, kim byłem. Stanowią one istotę mojego bytu.",shape=box,color=blue];
		j2301934714 -> j4272650453;
		j2301934714 -> j3604665805;
		j2301934714 -> j3916559898;
	j4272650453 [label="Myślę, że lepiej wiedzieć niż nie wiedzieć, ale... musimy być na to przygotowani.",shape=box,color=red];
		j4272650453 -> j1514266398;
	j3604665805 [label="Czasami myślę, że niektóre sprawy powinny zostać zapomniane.",shape=box,color=red];
		j3604665805 -> j3131328421;
	j2883599640 [label="Masz rację. Tak bym zrobił. Czas, żebyśmy je odzyskali. Co najgorszego może się stać? Jesteś Orokin, na pewno robiłeś gorsze rzeczy.",shape=box,color=red];
		j2883599640 -> j2546945677;
	j3256662694 [label="W takim razie jestem tak strasznie szczęśliwy, że nie zamieniłeś mnie w śliniącego się idiotę, kiedy grzebałeś mi w czaszce widelcem.",shape=box,color=blue];
		j3256662694 -> j3284677091;
	j132704304 [label="Może powinieneś. W końcu to ty grzebałeś mi w głowie widelcem.",shape=box,color=blue];
		j132704304 -> j3284677091;
	j2326869908 [label="Może bym tak zrobił, gdybym nie wiedział, że grzebałeś mi w czaszce widelcem.",shape=box,color=blue];
		j2326869908 -> j3284677091;
	j3916559898 [label="Są twoje. Czas, żebyśmy je odzyskali. Co najgorszego może się stać? Jesteś Orokin, na pewno robiłeś gorsze rzeczy.",shape=box,color=red];
		j3916559898 -> j2546945677;
	j1514266398 [label="Przygotowany? W jaki dokładnie sposób? Wierzysz, że rozsypię się jak jakiś domek z kart, gdy poznam straszliwą prawdę o jakiejś groteskowej zbrodni wojennej?",shape=box,color=blue];
		j1514266398 -> j611523433;
	j3131328421 [label="Czyż nie jesteśmy skazani na powtarzanie naszych poprzednich błędów? Nigdy się nie uczymy, nigdy się nie rozwijamy, wiecznie żyjemy w błogiej nieświadomości naszego dawnego ja?",shape=box,color=blue];
		j3131328421 -> j1809257074;
	j2546945677 [label="+10 Chemistry",color=orange];
		j2546945677 -> j1887066843;
	j3284677091 [label="Check boolean RoatheResetForgiven",color=orange];
		j3284677091 -> j2241602038 [label=true,color=green];
		j3284677091 -> j3646108612 [label=false,color=brown];
	j611523433 [label="Wierzcie mi, potrafię sobie wyobrazić wszystko, co mógłbym zrobić Świadomym, Orokin czy jakiejkolwiek ich kombinacji, i niewiele jest rzeczy, które mogłyby mnie zszokować lub przerazić.",shape=box,color=blue];
		j611523433 -> j3950613850;
	j1809257074 [label="Hm. Zdaję sobie sprawę, że być może właśnie przedstawiłem argumenty przeciwko własnym argumentom.",shape=box,color=blue];
		j1809257074 -> j2293370398;
	j1887066843 [label="Słuchajcie, słuchajcie! Nie zapadnę się jak jakiś lichy domek z kart, gdy tylko poznam straszliwą prawdę o jakiejś groteskowej zbrodni wojennej.",shape=box,color=blue];
		j1887066843 -> j4189236931;
	j2241602038 [label="Powiedziałem, że ci wybaczyłem. I staram się dotrzymać swojego słowa. Po prostu słowa nie zawsze przedstawiają prawdę. Miło jest powiedzieć komuś, że otrzymał przebaczenie, ale czasami emocje nie nadążają za faktami.",shape=box,color=blue];
		j2241602038 -> j443013988;
		j2241602038 -> j562912931;
	j3646108612 [label="Naprawdę, to wszystko jest dość irytujące. Chcę z tobą porozmawiać. Ale jednocześnie mam ochotę cię udusić za to, że zatrułeś mi umysł.",shape=box,color=blue];
		j3646108612 -> j2309985111;
		j3646108612 -> j588164050;
