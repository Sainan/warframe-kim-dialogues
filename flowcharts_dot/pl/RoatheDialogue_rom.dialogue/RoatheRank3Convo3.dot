	j3932176655 [label="Boolean RoatheResetForgiven is now true.",color=orange];
		j3932176655 -> j2127543768;
	j4076458422 [label="Nie, to, co czeka na mnie w głębi duszy, mnie nie przeraża. Chcę jedynie odzyskać to, co zostało mi niesłusznie odebrane.",shape=box,color=blue];
		j4076458422 -> j3807784508;
	j4223068838 [label="Nie, to, co czeka na mnie w głębi duszy, mnie nie przeraża. Chcę jedynie odzyskać to, co zostało mi niesłusznie odebrane.",shape=box,color=blue];
		j4223068838 -> j1026259336;
	j1221618640 [label="Bądź więc cierpliwy, jeśli możesz, a ja spróbuję to wszystko naprawić.",shape=box,color=blue];
		j1221618640 -> j3323854875;
		j1221618640 -> j595148816;
