		j4189236931 -> j2960919531;
	j443013988 [label="Rozumiem. Trudno to zaakceptować i możesz tego chcieć, ale nie potrafisz.",shape=box,color=red];
		j443013988 -> j2127543768;
	j562912931 [label="Więc... nie wybaczyłeś mi?",shape=box,color=red];
		j562912931 -> j2127543768;
	j2309985111 [label="Musisz po prostu zaakceptować to, co się stało i żyć dalej, Roathe.",shape=box,color=red];
		j2309985111 -> j1671606992;
	j588164050 [label="Myślisz, że kiedykolwiek będziesz w stanie mi wybaczyć?",shape=box,color=red];
		j588164050 -> j3932176655;
	j1147047979 [label="Pamiętam wystarczająco dużo, by wiedzieć, że mógłbym prosić o \"przebaczenie\" przy ołtarzu Świetlistych przez następne dwa tysiące lat i nigdy się go nie doczekać. ",shape=box,color=blue];
		j1147047979 -> j4076458422;
	j219447369 [label="Wolałbym sam poznać wszystkie fakty i na ich podstawie ocenić sytuację.",shape=box,color=blue];
		j219447369 -> j4076458422;
	j2960919531 [label="Potrafię sobie wyobrazić wszystko, co mógłbym zrobić Świadomym, Orokin czy jakiejkolwiek ich kombinacji, i niewiele jest rzeczy, które mogłyby mnie zszokować lub przerazić.",shape=box,color=blue];
		j2960919531 -> j4223068838;
	j2127543768 [label="Robię co w mojej cholernej mocy, Uzurpatorze. Bo jest w tobie coś, co przykuło moją uwagę. Jesteś fascynujący. A to rzadkość w moim świecie.",shape=box,color=blue];
		j2127543768 -> j1221618640;
	j1671606992 [label="Mmhm.",shape=box,color=blue];
