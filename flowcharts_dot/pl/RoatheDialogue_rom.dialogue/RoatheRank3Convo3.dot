		j3791167673 -> j2135037273 [label="x == 0",color=purple];
		j3791167673 -> j2135037273 [label="false",color=purple];
	j1894097973 [label="Dręczy mnie to dniem i nocą. Ta świadomość, że nie dość, że powierzyłem ci wszystkie moje najgłębsze sekrety, to jeszcze ty to zaufanie zawiodłeś i odebrałeś mi je, a teraz nie mogę sobie przypomnieć dlaczego...",shape=box,color=blue];
		j1894097973 -> j1787026705;
	j1942324370 [label="Robimy duże postępy w odkrywaniu tajemnic mojego umysłu. Albrecht nieźle mi namieszał, wstrzykując mi to serum.",shape=box,color=blue];
		j1942324370 -> j3534909646;
		j1942324370 -> j548597839;
		j1942324370 -> j386906797;
	j4048197771 [label="Twoje postępy w pomaganiu mi w odnajdywaniu wspomnień słabną. Jeśli chcesz dotrzymać swojej części umowy, oczekuję, że będziesz kontynuował pracę w Descendii.",shape=box,color=blue];
		j4048197771 -> j2132260339;
		j4048197771 -> j3109802633;
		j4048197771 -> j2146649297;
		j4048197771 -> j386906797;
	j2135037273 [label="Nie poczyniłeś jeszcze żadnych postępów w odzyskiwaniu moich wspomnień w Descendii. Jeśli chcesz, żebym dotrzymał swojej części umowy, powinieneś dołożyć starań, żeby dotrzymać swojej.",shape=box,color=blue];
		j2135037273 -> j3109802633;
		j2135037273 -> j2146649297;
		j2135037273 -> j2132260339;
		j2135037273 -> j386906797;
