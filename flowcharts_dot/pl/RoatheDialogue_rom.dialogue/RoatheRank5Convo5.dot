		j1522246199 -> j4007296028;
	j867754161 [label="Nienawidzę was, Eternalistów. Wysługujecie się tym jak wymówką do wszystkiego. Kiedy tylko Archimedian dojdzie do wniosku, że zrozumiał ten temat, wszystko stracone.",shape=box,color=blue];
