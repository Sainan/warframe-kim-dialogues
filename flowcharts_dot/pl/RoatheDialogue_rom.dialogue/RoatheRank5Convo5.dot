	j2169615912 [label="Tak. Myślę, że to, co Entrati uwolnił z Pustki, było bezkształtnym bogiem, który istniał w eterze przed naszym przybyciem.",shape=box,color=red];
		j2169615912 -> j2385789214;
	j3666398521 [label="Tak. Myślę, że bredzisz.",shape=box,color=red];
		j3666398521 -> j4099310853;
	j2957125786 [label="Tak. Możesz mieć rację. Nie sądzę, żeby istniała ona przed nadejściem Entratiego. Chciał odnaleźć boga... więc Pustka wypluła coś, za takiego się podaje.",shape=box,color=red];
		j2957125786 -> j3993288020;
	j3107913516 [label="Tak. Myślę, że prawda leży gdzieś pośrodku. W Pustce mogło nie być boga, ale teraz tam jest. Myślę, że Entrati powołał go do istnienia w chwili, kiedy otworzył przejście do Pustki.",shape=box,color=red];
		j3107913516 -> j232000013;
