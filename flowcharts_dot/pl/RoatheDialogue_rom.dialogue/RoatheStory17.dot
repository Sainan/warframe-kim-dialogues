	j3323483515 [label="VM: WARFRAMES",shape=box,color=blue];
		j3323483515 -> j1429814695;
	j1429814695 [label="Transkrypcja: Początkowo Warframe'y wydawały się bardziej dziełem sztuki niż prawdziwą bronią.",shape=box,color=blue];
		j1429814695 -> j3381185007;
	j3381185007 [label="Wojna była niemal przegrana; Świadomi byli niezwyciężeni; stwórzmy zatem tych dziwnych i surrealistycznych wojowników i uzbrójmy ich w broń o starożytnym rodowodzie.",shape=box,color=blue];
		j3381185007 -> j1525512905;
	j1525512905 [label="Przynajmniej nasza porażka będzie piękna. Pamiętna.",shape=box,color=blue];
		j1525512905 -> j1327029785;
	j1327029785 [label="Ale wbrew wszelkim oczekiwaniom zwyciężyli. Wkrótce z frontu zaczęły napływać opowieści o oburzająco nieprawdopodobnym bohaterstwie.",shape=box,color=blue];
		j1327029785 -> j2490988023;
	j2490988023 [label="Warframes had appeared from the sky, angel-like, liberating captives and devastating Sentient strongholds. Even alone they were miracles; in groups, they were gods.",shape=box,color=blue];
		j2490988023 -> j2673834172;
	j2673834172 [label="Little wonder, then, that they were seen as mere propaganda.",shape=box,color=blue];
		j2673834172 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
