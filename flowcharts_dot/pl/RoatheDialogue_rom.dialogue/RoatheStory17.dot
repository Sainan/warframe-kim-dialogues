		j979431230 -> j2434393573;
	j2434393573 [label="Przynajmniej nasza porażka będzie piękna. Pamiętna.",shape=box,color=blue];
		j2434393573 -> j373125672;
	j373125672 [label="Ale wbrew wszelkim oczekiwaniom zwyciężyli. Wkrótce z frontu zaczęły napływać opowieści o oburzająco nieprawdopodobnym bohaterstwie.",shape=box,color=blue];
		j373125672 -> j776770641;
	j776770641 [label="Z nieba pojawiły się Warframe'y, niczym anioły, wyzwalające jeńców i niszczące twierdze Świadomych. Nawet pojedynczo były cudami; w grupach – bogami.",shape=box,color=blue];
		j776770641 -> j2167060869;
