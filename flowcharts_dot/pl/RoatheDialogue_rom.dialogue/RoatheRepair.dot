digraph {
	5182 [label="RoatheRepair begins.",color=orange];
		5182 -> 5183;
	5183 [label="Evaluate expressions",color=orange];
		5183 -> 5185 [label="LyonRoatheFailFix, MarieRoatheFailFix",color=purple];
		5183 -> 5184 [label="false",color=purple];
	5185 [label="Dość! Dość. Poddaję się! Odwołaj swoich fanatyków. Są gorsi niż wściekłe kubrodony! Te przeklęte kreatury prześladują mnie wszędzie. Nie mogę nawet zasnąć!",shape=box,color=blue];
		5185 -> 5186;
	5184 [label="Chat ends.",color=orange];
	5186 [label="Czego?! Czego ode mnie chcesz?!",shape=box,color=blue];
		5186 -> 5188;
		5186 -> 5187;
		5186 -> 5189;
	5188 [label="Chcę porozmawiać o tym, jak przyjąłeś serum. Roathe, koniec z uciekaniem od tematu.",shape=box,color=red];
		5188 -> 5191;
	5187 [label="Roathe. Przyjęcie serum nie uczyniło z ciebie tchórza. Sprawiło, że jesteś ostatnim z Orokin, który jeszcze oddycha. Pogódź się z tym.",shape=box,color=red];
		5187 -> 5190;
	5189 [label="Roathe. Przyjęcie serum nie uczyniło z ciebie tchórza. Dało ci kolejną szansę na życie. Na dokonanie zmiany.",shape=box,color=red];
		5189 -> 5192;
	5191 [label="Evaluate expressions on Thermostat",color=orange];
		5191 -> 5195 [label="x >= 5",color=purple];
		5191 -> 5194 [label="x <= 0",color=purple];
		5191 -> 5193 [label="x > 0 && x < 5",color=purple];
		5191 -> 5193 [label="false",color=purple];
	5190 [label="Add -5 to Thermostat",color=orange];
		5190 -> 5191;
	5192 [label="Add 5 to Thermostat",color=orange];
		5192 -> 5191;
	5195 [label="Pozwalasz, by ta złość rozrywała cię od środka. A mógłbyś użyć jej, by walczyć z tymi, którzy wciąż niszczą ten świat dziś. Tu i teraz.",shape=box,color=red];
		5195 -> 5198;
	5194 [label="Kierujesz to przeciwko sobie. A powinieneś wymierzyć to w świat, który obwinia cię za to, że robiłeś wszystko, co mogłeś, by ocalić go przed Imperium Orokin.",shape=box,color=red];
		5194 -> 5197;
	5193 [label="Dlatego przekonałeś ich, żeby mnie nękali dniem i nocą? Po to? Ostatnia desperacka próba przekonania mnie, żebym wysłuchał twoich żałosnych argumentów?",shape=box,color=blue];
		5193 -> 5196;
	5198 [label="Nie definiuje cię twoja przeszłość, Roathe. Definiuje cię twoja przyszłość. A ty wciąż masz przyszłość, którą możesz wykorzystać, w przeciwieństwie do Orokin, którzy zginęli podczas Nocy Bębnów Naga.",shape=box,color=red];
		5198 -> 5201;
	5197 [label="Nie definiują cię opinie innych. Ani to, co sądzą o twoich czynach. Określa cię jedynie to, w co wierzysz o sobie samym, i twoje własne wybory.",shape=box,color=red];
		5197 -> 5200;
	5196 [label="Nie.",shape=box,color=blue];
		5196 -> 5199;
	5201 [label="To jedyne, co cię teraz definiuje. Możesz się zmienić. I możesz zmienić świat wokół siebie. Moje jedyne pytanie brzmi: czy chociaż spróbujesz?",shape=box,color=red];
		5201 -> 5204;
	5200 [label="A najprostsza prawda jest taka: jesteś jednym z nielicznych Orokin, którzy przetrwali Noc Bębnów Naga. Z mojego punktu widzenia? To był strategiczny odwrót.",shape=box,color=red];
		5200 -> 5203;
	5199 [label="Żałosna porażka. Nie raz, a już dwukrotnie.",shape=box,color=blue];
		5199 -> 5202;
	5204 [label="Wybacz sobie i żyj dalej?",shape=box,color=red];
		5204 -> 5207;
	5203 [label="Nic więcej. Nic mniej.",shape=box,color=red];
		5203 -> 5206;
	5202 [label="Odradzam wzięcie udziału w wyborach.",shape=box,color=blue];
		5202 -> 5205;
	5207 [label="Update boolean RoatheRedeemed",color=orange];
		5207 -> 5209;
	5206 [label="Update boolean RoatheVillain",color=orange];
		5206 -> 5208;
	5205 [label="Chat ends.",color=orange];
	5209 [label="+20 Chemistry",color=orange];
		5209 -> 5211;
	5208 [label="+20 Chemistry",color=orange];
		5208 -> 5210;
	5211 [label="Wybaczyć sobie to, co zrobiłem? I iść naprzód, w przyszłość? Hm.",shape=box,color=blue];
		5211 -> 5213;
	5210 [label="Odwrót w celu wygrania wojny. Hm. ",shape=box,color=blue];
		5210 -> 5212;
	5213 [label="Choć mam pewne wątpliwości co do nowego podejścia do sytuacji, jestem... zbyt skuszony możliwością tej nowej przyszłością i tym, co może ona dla mnie oznaczać, by się jej oprzeć, kochany Włóczęgo.",shape=box,color=blue];
		5213 -> 5215;
	5212 [label="Choć mam... pewne wątpliwości co do tego, jak przedstawiłeś te wydarzenia jako taktyczny odwrót, przyznaję, że mimo wszystko jestem... za, kochany Włóczęgo.",shape=box,color=blue];
		5212 -> 5214;
	5215 [label="Ta \"druga szansa na życie\". Niech tak będzie. Zgadzam się z twoim argumentem. Choć spóźniony... jest niemniej rozsądny.",shape=box,color=blue];
		5215 -> 5216;
	5214 [label="Niech tak będzie. Zgadzam się z twoim argumentem. Choć spóźniony... jest niemniej rozsądny.",shape=box,color=blue];
		5214 -> 5216;
	5216 [label="Doceniam to. Bardziej, niż możesz przypuszczać.",shape=box,color=blue];
		5216 -> 5217;
	5217 [label="Update boolean RoatheFail",color=orange];
		5217 -> 5218;
	5218 [label="Update boolean RoatheFamilyFail",color=orange];
		5218 -> 5793;
	5793 [label="Update boolean RoatheFailStall",color=orange];
		5793 -> 5795;
	5795 [label="Check boolean LoidFamilyComplete",color=orange];
		5795 -> 5796 [label=true,color=green];
		5795 -> 5794 [label=false,color=brown];
	5796 [label="Chat ends.",color=orange];
	5794 [label="Myślę, że możemy przejść do następnej potyczki w tej wojnie, tak? Do Sługi.",shape=box,color=blue];
		5794 -> 5797;
	5797 [label="Nie mogę się doczekać.",shape=box,color=blue];
		5797 -> 5798;
	5798 [label="Update boolean RoatheFamilyDelay",color=orange];
		5798 -> 1702;
	1702 [label="Chat ends.",color=orange];
}