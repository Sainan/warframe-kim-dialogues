		j3136897973 -> j3545856172 [label=false,color=brown];
	j3545856172 [label="Myślę, że możemy przejść do następnej potyczki w tej wojnie, tak? Do Sługi.",shape=box,color=blue];
		j3545856172 -> j1970459572;
