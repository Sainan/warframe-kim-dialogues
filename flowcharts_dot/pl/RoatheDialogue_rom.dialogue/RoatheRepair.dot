	edge [fontname="Roboto Condensed"];

	"RoatheRepair begins." [color=orange];
		"RoatheRepair begins." -> j2688688654;
	j2688688654 [label="Evaluate expressions",color=orange];
		j2688688654 -> j2957622914 [label="LyonRoatheFailFix, MarieRoatheFailFix",color=purple];
		j2688688654 -> "Chat ends." [label="false",color=purple];
	j2957622914 [label="Dość! Dość. Poddaję się! Odwołaj swoich fanatyków. Są gorsi niż wściekłe kubrodony! Te przeklęte kreatury prześladują mnie wszędzie. Nie mogę nawet zasnąć!",shape=box,color=blue];
		j2957622914 -> j928044316;
	"Chat ends." [color=orange];
	j928044316 [label="Czego?! Czego ode mnie chcesz?!",shape=box,color=blue];
		j928044316 -> j820044421;
		j928044316 -> j2347458733;
		j928044316 -> j2835690141;
	j820044421 [label="Chcę porozmawiać o tym, jak przyjąłeś serum. Roathe, koniec z uciekaniem od tematu.",shape=box,color=red];
		j820044421 -> j1979205857;
	j2347458733 [label="Roathe. Przyjęcie serum nie uczyniło z ciebie tchórza. Sprawiło, że jesteś ostatnim z Orokin, który jeszcze oddycha. Pogódź się z tym.",shape=box,color=red];
		j2347458733 -> j1420398166;
	j2835690141 [label="Roathe. Przyjęcie serum nie uczyniło z ciebie tchórza. Dało ci kolejną szansę na życie. Na dokonanie zmiany.",shape=box,color=red];
		j2835690141 -> j62611055;
	j1979205857 [label="Evaluate expressions on Thermostat counter",color=orange];
		j1979205857 -> j1128150401 [label="x >= 5",color=purple];
		j1979205857 -> j1918239855 [label="x <= 0",color=purple];
		j1979205857 -> j8907628 [label="x > 0 && x < 5",color=purple];
		j1979205857 -> j8907628 [label="false",color=purple];
	j1420398166 [label="Add -5 to Thermostat counter",color=orange];
		j1420398166 -> j1979205857;
	j62611055 [label="Add 5 to Thermostat counter",color=orange];
		j62611055 -> j1979205857;
	j1128150401 [label="Pozwalasz, by ta złość rozrywała cię od środka. A mógłbyś użyć jej, by walczyć z tymi, którzy wciąż niszczą ten świat dziś. Tu i teraz.",shape=box,color=red];
		j1128150401 -> j1614639132;
	j1918239855 [label="Kierujesz to przeciwko sobie. A powinieneś wymierzyć to w świat, który obwinia cię za to, że robiłeś wszystko, co mogłeś, by ocalić go przed Imperium Orokin.",shape=box,color=red];
		j1918239855 -> j184953764;
	j8907628 [label="Dlatego przekonałeś ich, żeby mnie nękali dniem i nocą? Po to? Ostatnia desperacka próba przekonania mnie, żebym wysłuchał twoich żałosnych argumentów?",shape=box,color=blue];
		j8907628 -> j824983830;
	j1614639132 [label="Nie definiuje cię twoja przeszłość, Roathe. Definiuje cię twoja przyszłość. A ty wciąż masz przyszłość, którą możesz wykorzystać, w przeciwieństwie do Orokin, którzy zginęli podczas Nocy Bębnów Naga.",shape=box,color=red];
		j1614639132 -> j2076253417;
	j184953764 [label="Nie definiują cię opinie innych. Ani to, co sądzą o twoich czynach. Określa cię jedynie to, w co wierzysz o sobie samym, i twoje własne wybory.",shape=box,color=red];
		j184953764 -> j3468757528;
	j824983830 [label="Nie.",shape=box,color=blue];
		j824983830 -> j2105641038;
	j2076253417 [label="To jedyne, co cię teraz definiuje. Możesz się zmienić. I możesz zmienić świat wokół siebie. Moje jedyne pytanie brzmi: czy chociaż spróbujesz?",shape=box,color=red];
		j2076253417 -> j735736179;
	j3468757528 [label="A najprostsza prawda jest taka: jesteś jednym z nielicznych Orokin, którzy przetrwali Noc Bębnów Naga. Z mojego punktu widzenia? To był strategiczny odwrót.",shape=box,color=red];
		j3468757528 -> j1060128104;
	j2105641038 [label="Żałosna porażka. Nie raz, a już dwukrotnie.",shape=box,color=blue];
		j2105641038 -> j2629724193;
	j735736179 [label="Wybacz sobie i żyj dalej?",shape=box,color=red];
		j735736179 -> j654129645;
	j1060128104 [label="Nic więcej. Nic mniej.",shape=box,color=red];
		j1060128104 -> j2031102571;
	j2629724193 [label="Odradzam wzięcie udziału w wyborach.",shape=box,color=blue];
		j2629724193 -> "Chat ends.";
	j654129645 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j654129645 -> j2914329975;
	j2031102571 [label="Boolean RoatheVillain is now true.",color=orange];
		j2031102571 -> j3465213364;
	j2914329975 [label="+20 Chemistry",color=orange];
		j2914329975 -> j2696833839;
	j3465213364 [label="+20 Chemistry",color=orange];
		j3465213364 -> j3066340229;
	j2696833839 [label="Wybaczyć sobie to, co zrobiłem? I iść naprzód, w przyszłość? Hm.",shape=box,color=blue];
		j2696833839 -> j494576028;
	j3066340229 [label="Odwrót w celu wygrania wojny. Hm. ",shape=box,color=blue];
		j3066340229 -> j2038307178;
	j494576028 [label="Choć mam pewne wątpliwości co do nowego podejścia do sytuacji, jestem... zbyt skuszony możliwością tej nowej przyszłością i tym, co może ona dla mnie oznaczać, by się jej oprzeć, kochany Włóczęgo.",shape=box,color=blue];
		j494576028 -> j3730678184;
	j2038307178 [label="Choć mam... pewne wątpliwości co do tego, jak przedstawiłeś te wydarzenia jako taktyczny odwrót, przyznaję, że mimo wszystko jestem... za, kochany Włóczęgo.",shape=box,color=blue];
		j2038307178 -> j3242048659;
	j3730678184 [label="Ta \"druga szansa na życie\". Niech tak będzie. Zgadzam się z twoim argumentem. Choć spóźniony... jest niemniej rozsądny.",shape=box,color=blue];
		j3730678184 -> j2298419297;
	j3242048659 [label="Niech tak będzie. Zgadzam się z twoim argumentem. Choć spóźniony... jest niemniej rozsądny.",shape=box,color=blue];
		j3242048659 -> j2298419297;
	j2298419297 [label="Doceniam to. Bardziej, niż możesz przypuszczać.",shape=box,color=blue];
		j2298419297 -> j757561088;
	j757561088 [label="Boolean RoatheFail is now false.",color=orange];
