digraph {
	2475 [label="RoatheRank4Convo3 begins.",color=orange];
		2475 -> 2476;
	2476 [label="Zagadka dla ciebie, Uzurpatorze: gdyby przyszło do walki na śmierć i życie, naprawdę sądzisz, że zdołałbyś pokonać swojego odpowiednika Tenno?",shape=box,color=blue];
		2476 -> 2478;
		2476 -> 2477;
		2476 -> 2479;
	2478 [label="Co? Dlaczego...?",shape=box,color=red];
		2478 -> 2481;
	2477 [label="Nie zamierzam prowadzić tej rozmowy.",shape=box,color=red];
		2477 -> 2480;
	2479 [label="[Koniec]",shape=box,color=red];
		2479 -> 2482;
	2481 [label="Bo nie wiem, czy zauważyłeś, ale \"Lotus\" jest nie tylko Świadomą, tą, która – pozwól, że przypomnę – wrzuciła Lua w Pustkę, lecz także kimś, kto w wymierny sposób, utracił kontrolę nad swoimi obwodami.",shape=box,color=blue];
		2481 -> 2483;
		2481 -> 2484;
		2481 -> 2485;
		2481 -> 2486;
		2481 -> 2487;
	2480 [label="Nie próbuję być grubiański. Jestem całkiem poważny, zdajesz sobie z tego sprawę. To czysto pragmatyczna rozmowa. ",shape=box,color=blue];
		2480 -> 2481;
	2482 [label="Chat ends.",color=orange];
	2483 [label="Ona ma się dobrze. Nie masz pojęcia, o czym mówisz.",shape=box,color=red];
		2483 -> 2488;
	2484 [label="Straciła kontrolę nad swoimi obwodami? Co masz na myśli?",shape=box,color=red];
		2484 -> 2489;
	2485 [label="Nie. Nie zamierzam tego robić. Lotus uratowała mi życie. Niezliczoną ilość razy ratowała też życie Tenno. Zawdzięczamy jej wszystko.",shape=box,color=red];
		2485 -> 2490;
	2486 [label="Zamknij się, Roathe. Nie zrobię tego. [Koniec.]",shape=box,color=red];
		2486 -> 2491;
	2487 [label="Wiem, sam się niepokoję. Ale ona zrobiła dla nas zbyt wiele i nie mogę się od niej odwrócić. Muszę stać po jej stronie.",shape=box,color=red];
		2487 -> 2492;
	2488 [label="Nie wiem? Skup się! Rozejrzyj się! Ile miesięcy spędziła na krawędzi klifu, z tym przestarzałym pagerem w dłoni, nucąc coś pod nosem? Wpatrzona w Pustkę?",shape=box,color=blue];
		2488 -> 2493;
	2489 [label="Ile miesięcy spędziła na krawędzi klifu, z tym przestarzałym pagerem w dłoni, nucąc coś pod nosem? Wpatrzona w Pustkę?",shape=box,color=blue];
		2489 -> 2493;
	2490 [label="Nie jestem pozbawiony współczucia. Rozumiem, jak to jest. Dużo jej zawdzięczasz. Nie mówię ci, żebyś ją zabił, mówię, żebyś przestał pozwalać jej wpływać na otaczających cię ludzi.",shape=box,color=blue];
		2490 -> 2489;
	2491 [label="Jak sobie życzysz. Ale kiedy wszystko zacznie się walić wokół ciebie, nie przychodź do mnie po pomoc.",shape=box,color=blue];
		2491 -> 2494;
	2492 [label="+5 Chemistry",color=orange];
		2492 -> 2495;
	2493 [label="A teraz ona po prostu… czai się w mroku? Wciąga twoje młodsze ja w coraz głębsze wspomnienia, w jakim celu? Tylko po to, by wrócić do domu, bo Albrecht pstryknął palcami i wypowiedział magiczne słowo?",shape=box,color=blue];
		2493 -> 2496;
	2494 [label="Chat ends.",color=orange];
	2495 [label="Nie jestem pozbawiony współczucia. Rozumiem, jak to jest. Dużo jej zawdzięczasz. Nie mówię ci, żebyś ją zabił, mówię, żebyś przestał pozwalać jej wpływać na otaczających cię ludzi.",shape=box,color=blue];
		2495 -> 2497;
	2496 [label="Nie widzisz, jakie to podejrzane? Jak niebezpieczne? To pułapka. Ktoś nią steruje. Albrecht albo ta cała \"Obojętność\". To wadliwy program. Jej zasady nie działają.",shape=box,color=blue];
		2496 -> 2498;
	2497 [label="Kiedy stała na krawędzi klifu, trzymając przestarzały pager i nucąc coś pod nosem… Wpatrzona w Pustkę… Nie pomyślałeś, że może skoczyć?",shape=box,color=blue];
		2497 -> 2493;
	2498 [label="Nie sądzę, by chciała cię skrzywdzić. Myślę, że po prostu ktoś ją wykorzystuje. Ale gdy nadejdzie właściwy moment, może będziesz musiał się bronić. Albo będziesz musiał ich zneutralizować.",shape=box,color=blue];
		2498 -> 2499;
	2499 [label="I choć (mam nadzieję) zrozumiesz, że lepiej uniknąć powtórki z tego, jak Lotus stała się problemem, to jej armia dzikich dzieci już nie. Więc zapytam ponownie:",shape=box,color=blue];
		2499 -> 2500;
	2500 [label="Jak myślisz, kto by wygrał, gdyby nadszedł ten okropny dzień i musiałbyś walczyć ze wszystkich sił? Ty i wszystko, czym dysponujesz przeciwko wszystkim Tenno i Lotus?",shape=box,color=blue];
		2500 -> 2501;
		2500 -> 2502;
		2500 -> 2503;
	2501 [label="To jest idiotyczne. Nie.",shape=box,color=red];
		2501 -> 2504;
	2502 [label="Jest ich… ze sto? A ja jeden, Roathe.",shape=box,color=red];
		2502 -> 2505;
	2503 [label="Nawet nie wiem, od czego zacząć.",shape=box,color=red];
		2503 -> 2506;
	2504 [label="Można to uznać za głupią grę, jeśli tak można powiedzieć! Teoretyczną gierkę, w którą bawią się dzieci. ",shape=box,color=blue];
		2504 -> 2507;
		2504 -> 2508;
	2505 [label="+5 Chemistry",color=orange];
		2505 -> 2509;
	2506 [label="A zatem dobrze się składa, że rozmawiasz z \"Diabłem z Tau'. Nie bez powodu jestem znany jako strateg. Zacznijmy więc od samej góry: od liczebności. W tej dziedzinie jesteś druzgocąco w tyle. ",shape=box,color=blue];
		2506 -> 2510;
	2507 [label="To nie jest gra.",shape=box,color=red];
		2507 -> 2511;
	2508 [label="Po raz ostatni? Nie. [Koniec]",shape=box,color=red];
		2508 -> 2512;
	2509 [label="Doskonale. Mamy już pierwszą regułę planowania bitwy: przewaga liczebna. A ty, rzecz jasna, jesteś w tej kwestii opłakanie w tyle.",shape=box,color=blue];
		2509 -> 2510;
	2510 [label="Check boolean IsDating",color=orange];
		2510 -> 2513 [label=true,color=green];
		2510 -> 2514 [label=false,color=brown];
	2511 [label="Masz rację. To nie jest gra. I pewnego dnia może to być kwestia życia i śmierci. Ty kontra twoja mała... miniaturowa wersja. I jej stado dzikich towarzyszy.",shape=box,color=blue];
		2511 -> 2515;
	2512 [label="Chat ends.",color=orange];
	2513 [label="Jeśli jednak plotki o twoich \"prywatnych rozrywkach\" i twoim powiązaniu z protoframe'ami w innych liniach czasowych dałoby się... wykorzystać, to może dałoby się jakoś zmobilizować te zasoby. Helminthy wymagałyby jednak specjalnych badań i hodowli pod ten konkretny cel...",shape=box,color=blue];
		2513 -> 2516;
	2514 [label="Słyszałem o twoich kontaktach z innymi protoframe’ami w innych liniach czasowych. Być może dałoby się jakoś zmobilizować te zasoby. Helminthy wymagałyby jednak specjalnych badań i hodowli pod ten konkretny cel...",shape=box,color=blue];
		2514 -> 2516;
	2515 [label="To dzicy towarzysze, którzy, nawiasem mówiąc, już udowodnili, że są agresywni i niezdyscyplinowani. Co więcej, znani są z okrutnego wykluczania przedstawicieli swojego gatunku za zbytnie odchylenie od ich własnej koncepcji normalności.",shape=box,color=blue];
		2515 -> 2517;
		2515 -> 2518;
		2515 -> 2519;
	2516 [label="Nie mam pewności, czy to w ogóle wykonalne, ale skoro pozwoliło nam dotrzeć aż tutaj, nie widzę powodu, dla którego miałoby się nie udać...",shape=box,color=blue];
		2516 -> 2520;
		2516 -> 2521;
		2516 -> 2522;
	2517 [label="Czy teraz sugerujesz, że Tenno są źli?",shape=box,color=red];
		2517 -> 2523;
	2518 [label="Co próbujesz powiedzieć?",shape=box,color=red];
		2518 -> 2524;
	2519 [label="Nie. Mnie już wystarczy. [Koniec]",shape=box,color=red];
		2519 -> 2525;
	2520 [label="Roathe? Idź do piekła.",shape=box,color=red];
		2520 -> 2526;
	2521 [label="Nie zamierzam ich wciągać w ten bałagan.",shape=box,color=red];
		2521 -> 2527;
	2522 [label="Niepokoi mnie, ile uwagi temu poświęciłeś.",shape=box,color=red];
		2522 -> 2528;
	2523 [label="Nie, nie \"źli\". Nie wierzę w \"zło\", Uzurpatorze. Nigdy nie wierzyłem i nigdy nie uwierzę. Wierzę, że Tenno są cudownymi i pięknymi ludźmi, jak wszyscy inni. Po prostu ludźmi. A co więcej? Są dziećmi.",shape=box,color=blue];
		2523 -> 2529;
	2524 [label="Może nadejść taki dzień, straszliwy dzień, w którym będziesz musiał być gotów zrobić coś niewyobrażalnego.",shape=box,color=blue];
		2524 -> 2530;
	2525 [label="Możesz sobie od tej rozmowy uciekać, ile dusza zapragnie, lecz wiesz doskonale, że mówię samą prawdę. Tylko nie potrafisz jej znieść.",shape=box,color=blue];
		2525 -> 2531;
	2526 [label="+5 Chemistry",color=orange];
		2526 -> 2532;
	2527 [label="Ach! Więc przyznajesz, że mamy bałagan. To już postęp. Mogę przynajmniej przedstawić swoje stanowisko?",shape=box,color=blue];
		2527 -> 2533;
		2527 -> 2534;
	2528 [label="A mnie niepokoi skala twojej ignorancji. Mogę przynajmniej przedstawić swoje stanowisko?",shape=box,color=blue];
		2528 -> 2533;
		2528 -> 2534;
	2529 [label="Dziećmi, zmuszonymi stawiać czoła koszmarom i popełniać czyny tak straszliwe, że widziałem, jak łamały dorosłych, zahartowanych wojowników Orokin, żyjących od setek lat.",shape=box,color=blue];
		2529 -> 2535;
	2530 [label="Tenno są cudownymi i pięknymi ludźmi, jak wszyscy inni. Po prostu ludźmi. A co więcej? Są dziećmi.",shape=box,color=blue];
		2530 -> 2529;
	2531 [label="Chat ends.",color=orange];
	2532 [label="Już tam jestem, Uzurpatorze. Już tam jestem.",shape=box,color=blue];
		2532 -> 2536;
	2533 [label="Dobrze. Jasne. Mów. Posłucham.",shape=box,color=red];
		2533 -> 2537;
	2534 [label="Nie. Mnie już wystarczy.",shape=box,color=red];
		2534 -> 2538;
	2535 [label="Widziałem Daksów, złotych, elitarnych Daxów! porzucających swoje święte, pozłacane miecze i uciekających z pola walki, na które Tenno wkraczali w swoich Warframach.",shape=box,color=blue];
		2535 -> 2539;
	2536 [label="Update boolean RoatheNoDate",color=orange];
		2536 -> 2540;
	2537 [label="+5 Chemistry",color=orange];
		2537 -> 2541;
	2538 [label="I ja również.",shape=box,color=blue];
		2538 -> 2540;
	2539 [label="Ich pozorny kokon schronienia przed Plagą wprawdzie chronił ich ciała, ale nie umysły. Nie są odpowiedzialni za swój stan.",shape=box,color=blue];
		2539 -> 2542;
	2540 [label="Chat ends.",color=orange];
	2541 [label="Dziękuję. Może nadejść taki dzień, straszliwy dzień, w którym będziesz musiał być gotów zrobić coś niewyobrażalnego.",shape=box,color=blue];
		2541 -> 2530;
	2542 [label="Dręczeni przez Pustkę… zmuszani do zabijania lub bycia świadkami śmierci własnych rodziców… poddani wojnie… pozbawieni wspomnień… skazani na kriostazę przez wieki...",shape=box,color=blue];
		2542 -> 2543;
	2543 [label="To cud, że jeszcze kompletnie nie oszaleli, Uzurpatorze. Nie mówię, że to się źle skończy. Mówię tylko, że to możliwe. I absolutnie musisz mieć plan awaryjny, na wszelki wypadek.",shape=box,color=blue];
		2543 -> 2544;
	2544 [label="Nie ma nic złego w przygotowaniu się na najgorsze. Całe zło świata tkwi w braku przygotowania.",shape=box,color=blue];
		2544 -> 2545;
		2544 -> 2546;
		2544 -> 2547;
		2544 -> 2548;
	2545 [label="Będę... obserwować sytuację. Dobrze? Ale nie zamierzam działać za niczyimi plecami.",shape=box,color=red];
		2545 -> 2549;
	2546 [label="Naprawdę, naprawdę nienawidzę, że w tym akurat częściowo się z tobą zgadzam.",shape=box,color=red];
		2546 -> 2550;
	2547 [label="Zdajesz sobie sprawę, że cierpiałem równie mocno, jak Tenno, prawda?",shape=box,color=red];
		2547 -> 2551;
	2548 [label="Nie mam zamiaru zdradzać ich zaufania.",shape=box,color=red];
		2548 -> 2552;
	2549 [label="+5 Chemistry",color=orange];
		2549 -> 2553;
	2550 [label="+5 Chemistry",color=orange];
		2550 -> 2554;
	2551 [label="A kto powiedział, że nie prowadzę tych samych rozmów z nimi, hm?",shape=box,color=blue];
		2551 -> 2555;
	2552 [label="Nie sugerowałem też, żebyś postępował inaczej.",shape=box,color=blue];
		2552 -> 2556;
	2553 [label="Oczywiście! To wszystko, o co mógłby prosić diabeł, dziękuję.",shape=box,color=blue];
		2553 -> 2557;
	2554 [label="Mm. To po prostu uczucie odzyskania zmysłów po tych wszystkich latach. Przyzwyczaisz się.",shape=box,color=blue];
		2554 -> 2558;
	2555 [label="Śpij dobrze, Uzurpatorze. ",shape=box,color=blue];
		2555 -> 2559;
	2556 [label="Add 1 to Thermostat",color=orange];
		2556 -> 2560;
	2557 [label="Add 1 to Thermostat",color=orange];
		2557 -> 2561;
	2558 [label="Add -1 to Thermostat",color=orange];
		2558 -> 2562;
	2559 [label="Add -1 to Thermostat",color=orange];
		2559 -> 2563;
	2560 [label="Chat ends.",color=orange];
	2561 [label="Chat ends.",color=orange];
	2562 [label="Chat ends.",color=orange];
	2563 [label="Chat ends.",color=orange];
}