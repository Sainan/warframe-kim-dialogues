digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank4Convo3 begins." [color=orange];
		"RoatheRank4Convo3 begins." -> j1276734076;
	j1276734076 [label="Zagadka dla ciebie, Uzurpatorze: gdyby przyszło do walki na śmierć i życie, naprawdę sądzisz, że zdołałbyś pokonać swojego odpowiednika Tenno?",shape=box,color=blue];
		j1276734076 -> j481519613;
		j1276734076 -> j1569385496;
		j1276734076 -> j386906797;
	j481519613 [label="Co? Dlaczego...?",shape=box,color=red];
		j481519613 -> j2707249022;
	j1569385496 [label="Nie zamierzam prowadzić tej rozmowy.",shape=box,color=red];
		j1569385496 -> j2451935372;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j2707249022 [label="Bo nie wiem, czy zauważyłeś, ale \"Lotus\" jest nie tylko Świadomą, tą, która – pozwól, że przypomnę – wrzuciła Lua w Pustkę, lecz także kimś, kto w wymierny sposób, utracił kontrolę nad swoimi obwodami.",shape=box,color=blue];
		j2707249022 -> j1877900844;
		j2707249022 -> j1985337304;
		j2707249022 -> j797400370;
		j2707249022 -> j2035127035;
		j2707249022 -> j352532005;
	j2451935372 [label="Nie próbuję być grubiański. Jestem całkiem poważny, zdajesz sobie z tego sprawę. To czysto pragmatyczna rozmowa. ",shape=box,color=blue];
		j2451935372 -> j2707249022;
	"Chat ends." [color=orange];
	j1877900844 [label="Ona ma się dobrze. Nie masz pojęcia, o czym mówisz.",shape=box,color=red];
		j1877900844 -> j404474410;
	j1985337304 [label="Straciła kontrolę nad swoimi obwodami? Co masz na myśli?",shape=box,color=red];
		j1985337304 -> j3760652491;
	j797400370 [label="Nie. Nie zamierzam tego robić. Lotus uratowała mi życie. Niezliczoną ilość razy ratowała też życie Tenno. Zawdzięczamy jej wszystko.",shape=box,color=red];
		j797400370 -> j696110052;
	j2035127035 [label="Zamknij się, Roathe. Nie zrobię tego. [Koniec.]",shape=box,color=red];
		j2035127035 -> j1294457936;
	j352532005 [label="Wiem, sam się niepokoję. Ale ona zrobiła dla nas zbyt wiele i nie mogę się od niej odwrócić. Muszę stać po jej stronie.",shape=box,color=red];
		j352532005 -> j3601469179;
	j404474410 [label="Nie wiem? Skup się! Rozejrzyj się! Ile miesięcy spędziła na krawędzi klifu, z tym przestarzałym pagerem w dłoni, nucąc coś pod nosem? Wpatrzona w Pustkę?",shape=box,color=blue];
		j404474410 -> j2209682187;
	j3760652491 [label="Ile miesięcy spędziła na krawędzi klifu, z tym przestarzałym pagerem w dłoni, nucąc coś pod nosem? Wpatrzona w Pustkę?",shape=box,color=blue];
		j3760652491 -> j2209682187;
	j696110052 [label="Nie jestem pozbawiony współczucia. Rozumiem, jak to jest. Dużo jej zawdzięczasz. Nie mówię ci, żebyś ją zabił, mówię, żebyś przestał pozwalać jej wpływać na otaczających cię ludzi.",shape=box,color=blue];
		j696110052 -> j3760652491;
	j1294457936 [label="Jak sobie życzysz. Ale kiedy wszystko zacznie się walić wokół ciebie, nie przychodź do mnie po pomoc.",shape=box,color=blue];
		j1294457936 -> "Chat ends.";
	j3601469179 [label="+5 Chemistry",color=orange];
		j3601469179 -> j165311975;
	j2209682187 [label="A teraz ona po prostu… czai się w mroku? Wciąga twoje młodsze ja w coraz głębsze wspomnienia, w jakim celu? Tylko po to, by wrócić do domu, bo Albrecht pstryknął palcami i wypowiedział magiczne słowo?",shape=box,color=blue];
		j2209682187 -> j2301432791;
	j165311975 [label="Nie jestem pozbawiony współczucia. Rozumiem, jak to jest. Dużo jej zawdzięczasz. Nie mówię ci, żebyś ją zabił, mówię, żebyś przestał pozwalać jej wpływać na otaczających cię ludzi.",shape=box,color=blue];
		j165311975 -> j2950432481;
	j2301432791 [label="Nie widzisz, jakie to podejrzane? Jak niebezpieczne? To pułapka. Ktoś nią steruje. Albrecht albo ta cała \"Obojętność\". To wadliwy program. Jej zasady nie działają.",shape=box,color=blue];
		j2301432791 -> j2813156983;
	j2950432481 [label="Kiedy stała na krawędzi klifu, trzymając przestarzały pager i nucąc coś pod nosem… Wpatrzona w Pustkę… Nie pomyślałeś, że może skoczyć?",shape=box,color=blue];
		j2950432481 -> j2209682187;
	j2813156983 [label="Nie sądzę, by chciała cię skrzywdzić. Myślę, że po prostu ktoś ją wykorzystuje. Ale gdy nadejdzie właściwy moment, może będziesz musiał się bronić. Albo będziesz musiał ich zneutralizować.",shape=box,color=blue];
		j2813156983 -> j2725349564;
	j2725349564 [label="I choć (mam nadzieję) zrozumiesz, że lepiej uniknąć powtórki z tego, jak Lotus stała się problemem, to jej armia dzikich dzieci już nie. Więc zapytam ponownie:",shape=box,color=blue];
		j2725349564 -> j382048018;
	j382048018 [label="Jak myślisz, kto by wygrał, gdyby nadszedł ten okropny dzień i musiałbyś walczyć ze wszystkich sił? Ty i wszystko, czym dysponujesz przeciwko wszystkim Tenno i Lotus?",shape=box,color=blue];
		j382048018 -> j394195232;
		j382048018 -> j1525083528;
		j382048018 -> j3038783225;
	j394195232 [label="To jest idiotyczne. Nie.",shape=box,color=red];
		j394195232 -> j290524513;
	j1525083528 [label="Jest ich… ze sto? A ja jeden, Roathe.",shape=box,color=red];
		j1525083528 -> j3385177901;
	j3038783225 [label="Nawet nie wiem, od czego zacząć.",shape=box,color=red];
		j3038783225 -> j3594533337;
	j290524513 [label="Można to uznać za głupią grę, jeśli tak można powiedzieć! Teoretyczną gierkę, w którą bawią się dzieci. ",shape=box,color=blue];
		j290524513 -> j4205172021;
		j290524513 -> j2403910344;
	j3385177901 [label="+5 Chemistry",color=orange];
		j3385177901 -> j2531386007;
	j3594533337 [label="A zatem dobrze się składa, że rozmawiasz z \"Diabłem z Tau'. Nie bez powodu jestem znany jako strateg. Zacznijmy więc od samej góry: od liczebności. W tej dziedzinie jesteś druzgocąco w tyle. ",shape=box,color=blue];
		j3594533337 -> j4181059854;
	j4205172021 [label="To nie jest gra.",shape=box,color=red];
		j4205172021 -> j1698231551;
	j2403910344 [label="Po raz ostatni? Nie. [Koniec]",shape=box,color=red];
		j2403910344 -> "Chat ends.";
	j2531386007 [label="Doskonale. Mamy już pierwszą regułę planowania bitwy: przewaga liczebna. A ty, rzecz jasna, jesteś w tej kwestii opłakanie w tyle.",shape=box,color=blue];
		j2531386007 -> j4181059854;
	j4181059854 [label="Check boolean IsDating",color=orange];
		j4181059854 -> j3177514525 [label=true,color=green];
		j4181059854 -> j2003044189 [label=false,color=brown];
	j1698231551 [label="Masz rację. To nie jest gra. I pewnego dnia może to być kwestia życia i śmierci. Ty kontra twoja mała... miniaturowa wersja. I jej stado dzikich towarzyszy.",shape=box,color=blue];
		j1698231551 -> j2013640171;
	j3177514525 [label="Jeśli jednak plotki o twoich \"prywatnych rozrywkach\" i twoim powiązaniu z protoframe'ami w innych liniach czasowych dałoby się... wykorzystać, to może dałoby się jakoś zmobilizować te zasoby. Helminthy wymagałyby jednak specjalnych badań i hodowli pod ten konkretny cel...",shape=box,color=blue];
		j3177514525 -> j1124261083;
	j2003044189 [label="Słyszałem o twoich kontaktach z innymi protoframe’ami w innych liniach czasowych. Być może dałoby się jakoś zmobilizować te zasoby. Helminthy wymagałyby jednak specjalnych badań i hodowli pod ten konkretny cel...",shape=box,color=blue];
		j2003044189 -> j1124261083;
	j2013640171 [label="To dzicy towarzysze, którzy, nawiasem mówiąc, już udowodnili, że są agresywni i niezdyscyplinowani. Co więcej, znani są z okrutnego wykluczania przedstawicieli swojego gatunku za zbytnie odchylenie od ich własnej koncepcji normalności.",shape=box,color=blue];
		j2013640171 -> j2021933156;
		j2013640171 -> j1953987598;
		j2013640171 -> j1436781025;
	j1124261083 [label="Nie mam pewności, czy to w ogóle wykonalne, ale skoro pozwoliło nam dotrzeć aż tutaj, nie widzę powodu, dla którego miałoby się nie udać...",shape=box,color=blue];
		j1124261083 -> j3406044347;
		j1124261083 -> j3619508311;
		j1124261083 -> j296304634;
	j2021933156 [label="Czy teraz sugerujesz, że Tenno są źli?",shape=box,color=red];
		j2021933156 -> j2835719539;
	j1953987598 [label="Co próbujesz powiedzieć?",shape=box,color=red];
		j1953987598 -> j865780154;
	j1436781025 [label="Nie. Mnie już wystarczy. [Koniec]",shape=box,color=red];
		j1436781025 -> j1493859497;
	j3406044347 [label="Roathe? Idź do piekła.",shape=box,color=red];
		j3406044347 -> j477460606;
	j3619508311 [label="Nie zamierzam ich wciągać w ten bałagan.",shape=box,color=red];
		j3619508311 -> j1872940202;
	j296304634 [label="Niepokoi mnie, ile uwagi temu poświęciłeś.",shape=box,color=red];
		j296304634 -> j1201020719;
	j2835719539 [label="Nie, nie \"źli\". Nie wierzę w \"zło\", Uzurpatorze. Nigdy nie wierzyłem i nigdy nie uwierzę. Wierzę, że Tenno są cudownymi i pięknymi ludźmi, jak wszyscy inni. Po prostu ludźmi. A co więcej? Są dziećmi.",shape=box,color=blue];
		j2835719539 -> j2353248516;
	j865780154 [label="Może nadejść taki dzień, straszliwy dzień, w którym będziesz musiał być gotów zrobić coś niewyobrażalnego.",shape=box,color=blue];
		j865780154 -> j195147057;
	j1493859497 [label="Możesz sobie od tej rozmowy uciekać, ile dusza zapragnie, lecz wiesz doskonale, że mówię samą prawdę. Tylko nie potrafisz jej znieść.",shape=box,color=blue];
		j1493859497 -> "Chat ends.";
	j477460606 [label="+5 Chemistry",color=orange];
		j477460606 -> j4033122108;
	j1872940202 [label="Ach! Więc przyznajesz, że mamy bałagan. To już postęp. Mogę przynajmniej przedstawić swoje stanowisko?",shape=box,color=blue];
		j1872940202 -> j4104157249;
		j1872940202 -> j2629733422;
	j1201020719 [label="A mnie niepokoi skala twojej ignorancji. Mogę przynajmniej przedstawić swoje stanowisko?",shape=box,color=blue];
		j1201020719 -> j4104157249;
		j1201020719 -> j2629733422;
	j2353248516 [label="Dziećmi, zmuszonymi stawiać czoła koszmarom i popełniać czyny tak straszliwe, że widziałem, jak łamały dorosłych, zahartowanych wojowników Orokin, żyjących od setek lat.",shape=box,color=blue];
		j2353248516 -> j3756221817;
	j195147057 [label="Tenno są cudownymi i pięknymi ludźmi, jak wszyscy inni. Po prostu ludźmi. A co więcej? Są dziećmi.",shape=box,color=blue];
		j195147057 -> j2353248516;
	j4033122108 [label="Już tam jestem, Uzurpatorze. Już tam jestem.",shape=box,color=blue];
		j4033122108 -> j155006797;
	j4104157249 [label="Dobrze. Jasne. Mów. Posłucham.",shape=box,color=red];
		j4104157249 -> j2214571638;
	j2629733422 [label="Nie. Mnie już wystarczy.",shape=box,color=red];
		j2629733422 -> j464255565;
	j3756221817 [label="Widziałem Daksów, złotych, elitarnych Daxów! porzucających swoje święte, pozłacane miecze i uciekających z pola walki, na które Tenno wkraczali w swoich Warframach.",shape=box,color=blue];
		j3756221817 -> j2620053917;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j2214571638 [label="+5 Chemistry",color=orange];
		j2214571638 -> j3147130758;
	j464255565 [label="I ja również.",shape=box,color=blue];
		j464255565 -> "Chat ends.";
	j2620053917 [label="Ich pozorny kokon schronienia przed Plagą wprawdzie chronił ich ciała, ale nie umysły. Nie są odpowiedzialni za swój stan.",shape=box,color=blue];
		j2620053917 -> j2035162867;
	j3147130758 [label="Dziękuję. Może nadejść taki dzień, straszliwy dzień, w którym będziesz musiał być gotów zrobić coś niewyobrażalnego.",shape=box,color=blue];
		j3147130758 -> j195147057;
	j2035162867 [label="Dręczeni przez Pustkę… zmuszani do zabijania lub bycia świadkami śmierci własnych rodziców… poddani wojnie… pozbawieni wspomnień… skazani na kriostazę przez wieki...",shape=box,color=blue];
		j2035162867 -> j4272853477;
	j4272853477 [label="To cud, że jeszcze kompletnie nie oszaleli, Uzurpatorze. Nie mówię, że to się źle skończy. Mówię tylko, że to możliwe. I absolutnie musisz mieć plan awaryjny, na wszelki wypadek.",shape=box,color=blue];
		j4272853477 -> j1534250450;
	j1534250450 [label="Nie ma nic złego w przygotowaniu się na najgorsze. Całe zło świata tkwi w braku przygotowania.",shape=box,color=blue];
		j1534250450 -> j2685235722;
		j1534250450 -> j1287877100;
		j1534250450 -> j1855246801;
		j1534250450 -> j1819877789;
	j2685235722 [label="Będę... obserwować sytuację. Dobrze? Ale nie zamierzam działać za niczyimi plecami.",shape=box,color=red];
		j2685235722 -> j1943353692;
	j1287877100 [label="Naprawdę, naprawdę nienawidzę, że w tym akurat częściowo się z tobą zgadzam.",shape=box,color=red];
		j1287877100 -> j3179718423;
	j1855246801 [label="Zdajesz sobie sprawę, że cierpiałem równie mocno, jak Tenno, prawda?",shape=box,color=red];
		j1855246801 -> j2218045333;
	j1819877789 [label="Nie mam zamiaru zdradzać ich zaufania.",shape=box,color=red];
		j1819877789 -> j1817580102;
	j1943353692 [label="+5 Chemistry",color=orange];
		j1943353692 -> j3156377976;
	j3179718423 [label="+5 Chemistry",color=orange];
		j3179718423 -> j2871066147;
	j2218045333 [label="A kto powiedział, że nie prowadzę tych samych rozmów z nimi, hm?",shape=box,color=blue];
		j2218045333 -> j3528975982;
	j1817580102 [label="Nie sugerowałem też, żebyś postępował inaczej.",shape=box,color=blue];
		j1817580102 -> j346357367;
	j3156377976 [label="Oczywiście! To wszystko, o co mógłby prosić diabeł, dziękuję.",shape=box,color=blue];
		j3156377976 -> j346357367;
	j2871066147 [label="Mm. To po prostu uczucie odzyskania zmysłów po tych wszystkich latach. Przyzwyczaisz się.",shape=box,color=blue];
		j2871066147 -> j321621700;
	j3528975982 [label="Śpij dobrze, Uzurpatorze. ",shape=box,color=blue];
