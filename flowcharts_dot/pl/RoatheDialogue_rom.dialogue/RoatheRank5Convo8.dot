		j942306581 -> j592512807;
	j2045326561 [label="Boolean RoatheVillain is now true.",color=orange];
		j2045326561 -> j2653372935;
	j2533375686 [label="Masz dar. Dar zdolny cofnąć czas. Zawinąć go w spiralę, czy zamknąć w pętli. A to wywołuje… interesujący efekt w umysłach Protoframe’ów, przez ich powiązanie z Plagą oraz z samym czasem.",shape=box,color=blue];
		j2533375686 -> j321385020;
	j2869532036 [label="Czy możesz mi powiedzieć, że nigdy nie użyłeś swoich darów, aby igrać z umysłami Protoframe'ów, które nazywasz przyjaciółmi i kochankami, i możesz to powiedzieć bez kłamstwa w duszy?",shape=box,color=blue];
		j2869532036 -> j3673906990;
	j4155952447 [label="Bardzo dobrze. Zgadzam się i akceptuję twój argument. Dziękuję, Włóczęgo, za... odwiedzenie mnie od tego konkretnego kroku.",shape=box,color=blue];
		j4155952447 -> j360816619;
	j592512807 [label="+20 Chemistry",color=orange];
		j592512807 -> j3820188064;
	j2653372935 [label="+20 Chemistry",color=orange];
		j2653372935 -> j1328534061;
	j321385020 [label="I to nasze przywiązanie do czasu. Proszę cię teraz. Nie, błagam cię, użyj daru teraz na mnie. Zabierz ode mnie te myśli. Zabierz ode mnie te wspomnienia.",shape=box,color=blue];
		j321385020 -> j3089763571;
	j3673906990 [label="A więc dobrze. Niech tak będzie. Nie poproszę cię o to teraz. Jeśli nigdy nie zrobiłeś tego z czystej ciekawości, dla własnej zabawy, lub by cofnąć błędy, które popełniłeś w swoich relacjach z innymi?!",shape=box,color=blue];
		j3673906990 -> j3089763571;
	j360816619 [label="Doceniam to. Bardziej, niż możesz przypuszczać.",shape=box,color=blue];
		j360816619 -> j2937073276;
	j3820188064 [label="Mam wybaczyć sobie to, co zrobiłem? I iść naprzód, w przyszłość? Hm.",shape=box,color=blue];
		j3820188064 -> j2643165361;
	j1328534061 [label="Odwrót w celu wygrania wojny. Hm.",shape=box,color=blue];
		j1328534061 -> j1520936649;
	j3089763571 [label="Muszę zapomnieć o wzięciu serum od Entratiego. Proszę.",shape=box,color=blue];
		j3089763571 -> j3514926876;
		j3089763571 -> j1671544812;
		j3089763571 -> j3895590714;
	j2937073276 [label="Muszę iść. Mam ochotę porządnie się upić i gapić w dal bez celu.",shape=box,color=blue];
		j2937073276 -> "Chat ends. Next chat will be Roathe5Day2.";
	j2643165361 [label="Choć mam pewne wątpliwości co do nowego podejścia do sytuacji, jestem... zbyt skuszony możliwością tej nowej przyszłością i tym, co może ona dla mnie oznaczać, by się jej oprzeć, Uzurpatorze. Włóczęgo.",shape=box,color=blue];
		j2643165361 -> j4221444603;
	j1520936649 [label="Choć mam... pewne wątpliwości co do tego, jak przedstawiłeś te wydarzenia jako taktyczny odwrót, przyznaję, że mimo wszystko... jestem za, Uzurpatorze. Włóczęgo.",shape=box,color=blue];
		j1520936649 -> j3204962132;
