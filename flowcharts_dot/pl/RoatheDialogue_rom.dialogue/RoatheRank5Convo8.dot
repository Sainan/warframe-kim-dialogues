digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank5Convo8 begins." [color=orange];
		"RoatheRank5Convo8 begins." -> j4125803273;
	j4125803273 [label="Check boolean RoatheFailNot21",color=orange];
		j4125803273 -> j1758133089 [label=true,color=green];
		j4125803273 -> "Chat ends." [label=false,color=brown];
	j1758133089 [label="Evaluate expressions on HellStory counter",color=orange];
		j1758133089 -> j4114508877 [label="x >= 21",color=purple];
		j1758133089 -> "Chat ends." [label="x <= 21",color=purple];
		j1758133089 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j4114508877 [label="Głupcze! Coś ty narobił?! Po co, pytam, po co zapuszczasz się w otchłanie, gdzie nie jesteś mile widziany?!",shape=box,color=blue];
		j4114508877 -> j4221256016;
	j4221256016 [label="Masz to naprawić. To twoja wina. Czuję to, rozrywa mnie od środka, niczym dzika bestia.",shape=box,color=blue];
		j4221256016 -> j3070694592;
	j3070694592 [label="Uwolnij mnie od tego. Wyzwól mnie od tej plagi. Oczyść mój umysł z tych wspomnień. Wiem, że jesteś do tego zdolny. Skorzystaj ze swojego daru i zakończ to, natychmiast!",shape=box,color=blue];
		j3070694592 -> j1435397939;
		j3070694592 -> j2864558951;
		j3070694592 -> j2521762649;
	j1435397939 [label="Jesteś pewien? Ale... jesteś zbyt sprytny, mam przeczucie, że domyślisz się, że coś nie gra.",shape=box,color=red];
		j1435397939 -> j4280331697;
	j2864558951 [label="To inny rodzaj pamięci, Roathe. To nie zadziała. Te wspomnienia są głębiej zakopane w twojej psychice.",shape=box,color=red];
		j2864558951 -> j2123759192;
	j2521762649 [label="Uciekanie i ukrywanie się przed prawdą nie zadziała. Wrócimy do punktu wyjścia. ",shape=box,color=red];
		j2521762649 -> j2625942930;
	j4280331697 [label="Bardzo prawdopodobne. Połączę dwa do dwóch i obwinię cię za zrobienie czegoś, o co cię nie prosiłem. Jestem pewien, że przetrwasz burzę.",shape=box,color=blue];
		j4280331697 -> j1101979943;
	j2123759192 [label="Być może. Najpewniej masz rację. Ale nie mam już innych ścieżek, prawda? Warto spróbować, choćby po to.",shape=box,color=blue];
		j2123759192 -> j1101979943;
	j2625942930 [label="W takim wypadku możesz po prostu powtórzyć to samo. To tak, jakbyś miał niewyczerpany dar, prawda?",shape=box,color=blue];
		j2625942930 -> j1101979943;
	j1101979943 [label="Jestem pewny, że będę na ciebie strasznie zły, kiedy zdam sobie sprawę, że zmieniłeś moje wspomnienia. I radzę ci, kochanie, nie mów mi, że to było na moją własną prośbę.",shape=box,color=blue];
		j1101979943 -> j2175399220;
	j2175399220 [label="Po prostu stwierdzę, że kłamiesz, a to prawdopodobnie nieodwracalnie zniszczy moją opinię o tobie.",shape=box,color=blue];
		j2175399220 -> j1363714008;
		j2175399220 -> j2258858822;
	j1363714008 [label="Nie. Nie mogę tego zrobić. Nie zrobię tego. Musimy wspólnie stawić czoła tej sytuacji. Czy nie możemy po prostu o tym porozmawiać?",shape=box,color=red];
		j1363714008 -> j905876277;
	j2258858822 [label="Ja... naprawdę nie ma już innego wyjścia?",shape=box,color=red];
		j2258858822 -> j905876277;
	j905876277 [label="Nie. Jeśli chcesz, żeby sługa poszedł na górę? Wymaż mi z pamięci te wszystkie bzdury, tak jak proszę. A jeśli ci to nie zależy? Rób, co chcesz. Nie obchodzi mnie to.",shape=box,color=blue];
		j905876277 -> j2080112138;
	j2080112138 [label="To, no i oczywiście nasza osobista przyjaźń to jedyna przewaga, jaką posiadam w tej sytuacji. To proste.",shape=box,color=blue];
		j2080112138 -> j3554027715;
	j3554027715 [label="Co ty na to?",shape=box,color=blue];
		j3554027715 -> j1844427288;
		j3554027715 -> j1802105835;
	j1844427288 [label="Dobra. Zrobię to... Wyczyszczę ci pamięć. Nawet jeśli to wymaże Marię i Leona.",shape=box,color=red];
		j1844427288 -> j2504948790;
	j1802105835 [label="Nie. Odmawiam. Przepraszam. Musimy się z tym zmierzyć.",shape=box,color=red];
		j1802105835 -> j969678408;
		j1802105835 -> j1419641791;
	j2504948790 [label="+10 Chemistry",color=orange];
		j2504948790 -> j369412338;
	j969678408 [label="Porozmawiajmy o tym.",shape=box,color=red];
		j969678408 -> j2290664449;
	j1419641791 [label="Możesz mnie nienawidzić, jeśli chcesz. Ale nie zrobię nic, dopóki najpierw tego nie rozwiążemy.",shape=box,color=red];
		j1419641791 -> j2385515309;
	j369412338 [label="Doskonale. Bierz się do roboty. ",shape=box,color=blue];
		j369412338 -> j4072107213;
	j2290664449 [label="Nawet się nie waż... nie waż się mówić mi, bym się \"uspokoił\"! Czy nie sądzisz, że mam pełne prawo czuć, jakby rozrywano mnie na pół?!",shape=box,color=blue];
		j2290664449 -> j2540865863;
	j2385515309 [label="To fascynujące. Fascynujące i nieoczekiwane. Rozwiń to.",shape=box,color=blue];
		j2385515309 -> j636660265;
		j2385515309 -> j281852026;
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j2540865863 [label="Czuję się, jakby moja samoświadomość, sama podstawa mojego jestestwa, była spękana i rozdarta niczym przeklęta Lua! Jakby została ponownie zapisana rozmazanym atramentem. Tchórz!",shape=box,color=blue];
		j2540865863 -> j3112706055;
	j636660265 [label="Zrobiłem to, co zrobiłem, bo było to konieczne. Nie mogłeś się już przed tym ukrywać.",shape=box,color=red];
		j636660265 -> j3016389509;
	j281852026 [label="Myśl o mnie, co chcesz. Ale ja potrafię rozpoznać spiralę, gdy ją widzę.",shape=box,color=red];
		j281852026 -> j4230191221;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
	j3112706055 [label="I ty śmiesz mi mówić, \"żebym się uspokoił\"?!",shape=box,color=blue];
		j3112706055 -> j1830055178;
	j3016389509 [label="Boolean RoatheFail is now true.",color=orange];
		j3016389509 -> j2326269650;
	j4230191221 [label="Tak, myślę, że trochę \"gustujesz\" w takich rzeczach, prawda? No dalej.",shape=box,color=blue];
		j4230191221 -> j2300252527;
		j4230191221 -> j3592112866;
	j1830055178 [label="Evaluate expressions",color=orange];
		j1830055178 -> j1282664777 [label="RoatheForgivenessShortcut",color=purple];
		j1830055178 -> j531968278 [label="RoatheVillainyShortcut",color=purple];
		j1830055178 -> j2318547072 [label="false",color=purple];
	j2326269650 [label="Szaleje we mnie wściekła bestia, próbująca przedrzeć się przez moje żebra, by zaznać wolności.",shape=box,color=blue];
		j2326269650 -> j778680746;
	j2300252527 [label="Jeśli chcesz szukać przebaczenia, to śmiało. Ale musisz tego chcieć. Musisz wybrać tę ścieżkę. Nikt inny nie jest w stanie tego zrobić za ciebie.",shape=box,color=red];
		j2300252527 -> j3328872322;
	j3592112866 [label="Jeśli chcesz wybrać własną drogę? Dla siebie? Zrób to. Nie przepraszaj. Ale ta ścieżka należy do ciebie, a nie do kogoś innego.",shape=box,color=red];
		j3592112866 -> j980316726;
	j1282664777 [label="Złość niczego nie rozwiąże, Roathe. Jesteś zły, bo boisz się stawić czoła temu, co zrobiłeś. I temu, kim się stałeś.",shape=box,color=red];
		j1282664777 -> j2967076664;
	j531968278 [label="Dobrze. Złość się. Ale użyj tej złości do czegoś wartościowego. Użycz jej siły, by strząsnąć z siebie tę nienawiść, którą kierujesz nie tam, gdzie trzeba.",shape=box,color=red];
		j531968278 -> j1470753454;
	j2318547072 [label="Evaluate expressions on Thermostat counter",color=orange];
		j2318547072 -> j1282664777 [label="x >= 5",color=purple];
		j2318547072 -> j531968278 [label="x <= 0",color=purple];
		j2318547072 -> j2969305307 [label="x > 0 && x < 5",color=purple];
		j2318547072 -> j2969305307 [label="false",color=purple];
	j778680746 [label="A ja nie wiem, jak to zaspokoić. Nie wiem, czy w ogóle potrafię. Miałem nadzieję, że te rozmowy wskażą mi drogę, ale widzę teraz, że to daremne.",shape=box,color=blue];
		j778680746 -> j2056961572;
	j3328872322 [label="To nie przeszłość cię definiuje, Roathe. Definiuje cię twoja przyszłość. A ty wciąż masz przyszłość, którą możesz wykorzystać, w przeciwieństwie do Orokin, którzy zginęli podczas Nocy Bębnów Naga.",shape=box,color=red];
		j3328872322 -> j672815635;
	j980316726 [label="Nie definiują cię opinie innych. Ani to, co sądzą o twoich czynach. Określa cię jedynie przekonanie o sobie samym i własnych wyborach.",shape=box,color=red];
		j980316726 -> j2814838802;
	j2967076664 [label="Pozwalasz, by ta złość niszczyła od środka. A mógłbyś użyć jej, by walczyć z tymi, którzy wciąż niszczą ten świat dziś. Tu i teraz.",shape=box,color=red];
		j2967076664 -> j35971584;
	j1470753454 [label="Kierujesz to przeciwko sobie. A powinieneś wymierzyć to w świat, który obwinia cię za to, że robiłeś wszystko, co mogłeś, by ocalić go przed Imperium Orokin.",shape=box,color=red];
		j1470753454 -> j2279582075;
	j2969305307 [label="Chciałbym tylko wiedzieć, jak ci pomóc. Chciałbym wiedzieć, co powiedzieć. Wydaje się, jakbyś był rozdzierany w dwie strony. Którą ścieżką chcesz podążyć?",shape=box,color=red];
		j2969305307 -> j3486393597;
	j2056961572 [label="Ale jest jakieś rozwiązanie, prawda? To jest w twojej mocy, żeby to naprawić... tę straszną agonię w moim umyśle.",shape=box,color=blue];
		j2056961572 -> j3696279080;
	j672815635 [label="To jedyne, co cię teraz definiuje. Możesz się zmienić. I możesz zmienić świat wokół siebie. Moje jedyne pytanie brzmi: czy chociaż spróbujesz?",shape=box,color=red];
		j672815635 -> j2805189656;
	j2814838802 [label="Prawda jest taka: jesteś jednym z nielicznych Orokin, którzy przetrwali Noc Bębnów Naga. Z mojego punktu widzenia był to taktyczny odwrót.",shape=box,color=red];
		j2814838802 -> j3558109948;
	j35971584 [label="Pozwalasz, by ta złość niszczyła od środka. A mógłbyś użyć jej, by walczyć z tymi, którzy wciąż niszczą ten świat dziś. Tu i teraz.",shape=box,color=red];
		j35971584 -> j1366891547;
	j2279582075 [label="Nie definiują cię opinie innych. Ani to, co sądzą o twoich czynach. Określa cię jedynie to, w co wierzysz o sobie samym, i twoje własne wybory.",shape=box,color=red];
		j2279582075 -> j79262892;
	j3486393597 [label="Boolean RoatheFail is now true.",color=orange];
		j3486393597 -> j1833114211;
	j3696279080 [label="Uzurpatorze. Włóczęgo. Błagam cię teraz. To naprawdę jedyny sposób jak sam wierzę, by iść naprzód, dobrze? Leży to również w twoim interesie.",shape=box,color=blue];
		j3696279080 -> j2340703530;
	j2805189656 [label="Wybacz sobie i żyj dalej?",shape=box,color=red];
		j2805189656 -> j1111366773;
	j3558109948 [label="Nic więcej. Nic mniej.",shape=box,color=red];
		j3558109948 -> j1251506327;
	j1366891547 [label="To jedyne, co cię teraz definiuje. Możesz się zmienić. I możesz zmienić świat wokół siebie. Moje jedyne pytanie brzmi: czy chociaż spróbujesz?",shape=box,color=red];
		j1366891547 -> j3497260554;
	j79262892 [label="A najprostsza prawda jest taka: jesteś jednym z nielicznych Orokin, którzy przetrwali Noc Bębnów Naga. Z mojego punktu widzenia? To był strategiczny odwrót.",shape=box,color=red];
		j79262892 -> j590089525;
	j1833114211 [label="Nie wiem, Uzurpatorze. I w tym tkwi największy problem.",shape=box,color=blue];
		j1833114211 -> j2326269650;
	j2340703530 [label="Jeśli kiedykolwiek pragniesz, by sługa wrócił na górę i pojednał się z rodziną Entratich, musisz zrobić to, co mówię. Musisz.",shape=box,color=blue];
		j2340703530 -> j2998645550;
		j2340703530 -> j3396494135;
	j1111366773 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j1111366773 -> j1820893597;
