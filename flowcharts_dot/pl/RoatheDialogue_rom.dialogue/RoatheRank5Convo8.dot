		j1251506327 -> j1820893597;
	j3497260554 [label="Wybacz sobie i żyj dalej?",shape=box,color=red];
		j3497260554 -> j942306581;
	j590089525 [label="Nic więcej. Nic mniej.",shape=box,color=red];
		j590089525 -> j2045326561;
	j2998645550 [label="Czyli co...?",shape=box,color=red];
		j2998645550 -> j2533375686;
	j3396494135 [label="Nie. Wiem, o co chcesz zapytać, ale odpowiedź brzmi: nie.",shape=box,color=red];
		j3396494135 -> j2869532036;
	j1820893597 [label="+20 Chemistry",color=orange];
		j1820893597 -> j4155952447;
