digraph {
	5151 [label="RoatheRank5Convo8 begins.",color=orange];
		5151 -> 5152;
	5152 [label="Check boolean RoatheFailNot21",color=orange];
		5152 -> 5154 [label=true,color=green];
		5152 -> 5153 [label=false,color=brown];
	5154 [label="Evaluate expressions on HellStory",color=orange];
		5154 -> 5155 [label="x >= 21",color=purple];
		5154 -> 5156 [label="x <= 21",color=purple];
		5154 -> 5156 [label="false",color=purple];
	5153 [label="Chat ends.",color=orange];
	5155 [label="Głupcze! Coś ty narobił?! Po co, pytam, po co zapuszczasz się w otchłanie, gdzie nie jesteś mile widziany?!",shape=box,color=blue];
		5155 -> 5157;
	5156 [label="Chat ends.",color=orange];
	5157 [label="Masz to naprawić. To twoja wina. Czuję to, rozrywa mnie od środka, niczym dzika bestia.",shape=box,color=blue];
		5157 -> 5158;
	5158 [label="Uwolnij mnie od tego. Wyzwól mnie od tej plagi. Oczyść mój umysł z tych wspomnień. Wiem, że jesteś do tego zdolny. Skorzystaj ze swojego daru i zakończ to, natychmiast!",shape=box,color=blue];
		5158 -> 5159;
		5158 -> 5160;
		5158 -> 5161;
	5159 [label="Jesteś pewien? Ale... jesteś zbyt sprytny, mam przeczucie, że domyślisz się, że coś nie gra.",shape=box,color=red];
		5159 -> 5162;
	5160 [label="To inny rodzaj pamięci, Roathe. To nie zadziała. Te wspomnienia są głębiej zakopane w twojej psychice.",shape=box,color=red];
		5160 -> 5163;
	5161 [label="Uciekanie i ukrywanie się przed prawdą nie zadziała. Wrócimy do punktu wyjścia. ",shape=box,color=red];
		5161 -> 5164;
	5162 [label="Bardzo prawdopodobne. Połączę dwa do dwóch i obwinię cię za zrobienie czegoś, o co cię nie prosiłem. Jestem pewien, że przetrwasz burzę.",shape=box,color=blue];
		5162 -> 5165;
	5163 [label="Być może. Najpewniej masz rację. Ale nie mam już innych ścieżek, prawda? Warto spróbować, choćby po to.",shape=box,color=blue];
		5163 -> 5165;
	5164 [label="W takim wypadku możesz po prostu powtórzyć to samo. To tak, jakbyś miał niewyczerpany dar, prawda?",shape=box,color=blue];
		5164 -> 5165;
	5165 [label="Jestem pewny, że będę na ciebie strasznie zły, kiedy zdam sobie sprawę, że zmieniłeś moje wspomnienia. I radzę ci, kochanie, nie mów mi, że to było na moją własną prośbę.",shape=box,color=blue];
		5165 -> 5166;
	5166 [label="Po prostu stwierdzę, że kłamiesz, a to prawdopodobnie nieodwracalnie zniszczy moją opinię o tobie.",shape=box,color=blue];
		5166 -> 5167;
		5166 -> 5168;
	5167 [label="Nie. Nie mogę tego zrobić. Nie zrobię tego. Musimy wspólnie stawić czoła tej sytuacji. Czy nie możemy po prostu o tym porozmawiać?",shape=box,color=red];
		5167 -> 5169;
	5168 [label="Ja... naprawdę nie ma już innego wyjścia?",shape=box,color=red];
		5168 -> 5169;
	5169 [label="Nie. Jeśli chcesz, żeby sługa poszedł na górę? Wymaż mi z pamięci te wszystkie bzdury, tak jak proszę. A jeśli ci to nie zależy? Rób, co chcesz. Nie obchodzi mnie to.",shape=box,color=blue];
		5169 -> 5170;
	5170 [label="To, no i oczywiście nasza osobista przyjaźń to jedyna przewaga, jaką posiadam w tej sytuacji. To proste.",shape=box,color=blue];
		5170 -> 5171;
	5171 [label="Co ty na to?",shape=box,color=blue];
		5171 -> 5172;
		5171 -> 5173;
	5172 [label="Dobra. Zrobię to... Wyczyszczę ci pamięć. Nawet jeśli to wymaże Marię i Leona.",shape=box,color=red];
		5172 -> 5174;
	5173 [label="Nie. Odmawiam. Znajdę inny sposób, żeby przekonać cię do pójścia naprzód.",shape=box,color=red];
		5173 -> 5175;
	5174 [label="+10 Chemistry",color=orange];
		5174 -> 5176;
	5175 [label="Życzę ci powodzenia.",shape=box,color=blue];
		5175 -> 5179;
	5176 [label="Doskonale. Bierz się do roboty. ",shape=box,color=blue];
		5176 -> 5178;
	5179 [label="Update boolean LyonRoatheRepair",color=orange];
		5179 -> 5177;
	5178 [label="Add 1 to Promise",color=orange];
		5178 -> 5180;
	5177 [label="Chat ends.",color=orange];
	5180 [label="Update boolean RoatheWillReset",color=orange];
		5180 -> 5181;
	5181 [label="Chat ends.",color=orange];
}