digraph {
	"RoatheRank3Convo1 begins." [color=orange];
		"RoatheRank3Convo1 begins." -> j1235762376;
	j1235762376 [label="Czy w końcu rozmawiasz z naszym drogim Leonem? Czy nadal się przed tobą nie otworzył? Szczerze mówiąc, lepiej byłoby zachować bezpieczny dystans.",shape=box,color=blue];
		j1235762376 -> j2337517882;
		j1235762376 -> j2643170718;
		j1235762376 -> j386906797;
	j2337517882 [label="Nie dogadujecie się?",shape=box,color=red];
		j2337517882 -> j429413936;
	j2643170718 [label="Gdybyś był ciut milszy dla Marii i Leona, oni mogliby być milsi dla ciebie.",shape=box,color=red];
		j2643170718 -> j448349782;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j429413936 [label="\"Dogadalibyśmy się\", gdyby zapragnął lepiej zrozumieć mnie i skąd pochodzę. Kim byłem od wielu wieków. Nie mam zamiaru zmieniać się tylko dlatego, że teraz tego żądają.",shape=box,color=blue];
		j429413936 -> j3060654953;
	j448349782 [label="A w jaki sposób oni są mili wobec mnie, Uzurpatorze? Jestem, kim jestem. I byłem taki od wielu wieków. Nie mam zamiaru zmieniać się tylko dlatego, że teraz tego żądają.",shape=box,color=blue];
		j448349782 -> j3060654953;
	"Chat ends." [color=orange];
	j3060654953 [label="Evaluate expressions on HellStory counter",color=orange];
		j3060654953 -> j4195289240 [label="x >= 21",color=purple];
		j3060654953 -> j2750671684 [label="x < 21",color=purple];
		j3060654953 -> j2750671684 [label="false",color=purple];
	j4195289240 [label="Może przyjąłem to serum dobrowolnie, ale nie wiedziałem, że zgodziłem się na nękanie przez tę dwójkę niewdzięczników.",shape=box,color=blue];
		j4195289240 -> j4190199582;
	j2750671684 [label="To przez Albrechta tak wyglądam! To on mnie tu uwięził! Ta okropna sytuacja nie jest moją winą!",shape=box,color=blue];
		j2750671684 -> j4190199582;
	j4190199582 [label="Swoje zastrzeżenia mogą kierować do swojego drogiego \"kardynała\", nie do mnie.",shape=box,color=blue];
		j4190199582 -> j1781642501;
		j4190199582 -> j851975917;
		j4190199582 -> j259332221;
	j1781642501 [label="Mają dobre intencje, nawet jeśli ich czyny nie zawsze o tym świadczą.",shape=box,color=red];
		j1781642501 -> j1401904163;
	j851975917 [label="Nie uważasz, że potrzebujesz przebaczenia za to, co zrobiłeś?",shape=box,color=red];
		j851975917 -> j1213937062;
	j259332221 [label="Starają się tylko pomóc.",shape=box,color=red];
		j259332221 -> j1039878548;
	j1401904163 [label="Add -1 to Thermostat counter",color=orange];
		j1401904163 -> j1041976672;
	j1213937062 [label="Add 1 to Thermostat counter",color=orange];
		j1213937062 -> j1444795920;
	j1039878548 [label="\"Pomóc\". Tak. \"Pomóc\". Wybacz mi, ale uważam ich styl \"pomocy\" za wielce \"niepomocny\".",shape=box,color=blue];
		j1039878548 -> j2525002235;
	j1041976672 [label="Tak, to jest tragedia w tym wszystkim. Oni naprawdę wierzą, że próbują czynić \"dobro\".",shape=box,color=blue];
		j1041976672 -> j677656224;
	j1444795920 [label="Przebaczenia od kogo? Od ciebie? Od nich? Sługi? Albrechta? A może \"bogów\"?",shape=box,color=blue];
		j1444795920 -> j3160181153;
		j1444795920 -> j2408997450;
		j1444795920 -> j3175235050;
	j2525002235 [label="Byliby bardziej \"pomocni\", gdyby zamienili moje wino na kwas, Uzurpatorze.",shape=box,color=blue];
		j2525002235 -> j3441279455;
	j677656224 [label="A jak ty sądzisz? Czy potrzebne jest mi \"wielkie rozgrzeszenie\"? Jakieś \"święte przebaczenie\"?",shape=box,color=blue];
		j677656224 -> j937239071;
	j3160181153 [label="Na tej liście brakuje istotnej pozycji.",shape=box,color=red];
		j3160181153 -> j2121371851;
	j2408997450 [label="Jesteś Orokin. Dopuściłeś się okrucieństw na wojnie i w naturze twojego społeczeństwa. Masz wiele do odpokutowania.",shape=box,color=red];
		j2408997450 -> j3311691196;
	j3175235050 [label="Nie zdajesz sobie sprawy, że w swoim życiu zrobiłeś straszne rzeczy?",shape=box,color=red];
		j3175235050 -> j1834865492;
	j3441279455 [label="To przynajmniej by zadziałało.",shape=box,color=blue];
		j3441279455 -> j2617071005;
