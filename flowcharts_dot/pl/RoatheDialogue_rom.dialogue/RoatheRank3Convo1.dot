	j2121371851 [label="Och? Powiedz mi. ",shape=box,color=blue];
		j2121371851 -> j2257029158;
		j2121371851 -> j3138200170;
		j2121371851 -> j2277339490;
	j3311691196 [label="Nie będę przepraszał za społeczeństwo Orokin, bo nie ja je stworzyłem. Jedynie do niego należałem. A jeśli obwiniasz wszystkich, którzy uczestniczą w systemie, w którym po prostu się urodzili, potępisz miliardy w swojej moralnej wyższości. A poza tym?",shape=box,color=blue];
		j3311691196 -> j171731624;
	j1834865492 [label="A co, jeśli tak? Nie mogę tego już zmienić. Jaki sens obwiniać siebie?",shape=box,color=blue];
		j1834865492 -> j1487350795;
		j1834865492 -> j879066776;
	j2617071005 [label="Chociaż z tej dwójki, muszę przyznać, że wolę księdza. Można przemówić mu do rozsądku. Może nawet zda sobie sprawę, że Obojętność nie jest prawdziwym bogiem.",shape=box,color=blue];
		j2617071005 -> j3028472459;
	j3802913326 [label="Myślę, że warto zastanowić się nad czynami, które wyrządziły krzywdę innym, i spróbować zrozumieć, jak je naprawić. Ale nie sądzę, żeby te dwie osoby robiły to w ogóle we właściwy sposób.",shape=box,color=red];
		j3802913326 -> j3418782347;
	j4155643088 [label="Ostatecznie nie wierzę w potrzebę wybaczania komukolwiek poza sobą. Jeśli czujesz się dobrze z tym, co zrobiłeś? Niech tak będzie.",shape=box,color=red];
		j4155643088 -> j1283844610;
	j481026954 [label="Urodziłeś się w społeczeństwie, w którym wiele zachowań Orokin było po prostu... normalne. Oczekiwane. Nie było dla ciebie \"złe\". Nie twierdzę, że to wystarczające usprawiedliwienie, ale daje większe zrozumienie.",shape=box,color=red];
		j481026954 -> j813430859;
	j1560005110 [label="Planowałeś obalenie Orokin. Wiedziałeś, że są zepsuci i próbowałeś ich naprawić.",shape=box,color=red];
		j1560005110 -> j1629237732;
	j2257029158 [label="Ciebie samego.",shape=box,color=red];
		j2257029158 -> j959970570;
	j3138200170 [label="Twój własny lud, który chciałeś zdradzić.",shape=box,color=red];
		j3138200170 -> j911899810;
	j2277339490 [label="Świadomych, których zamordowałeś.",shape=box,color=red];
		j2277339490 -> j171731624;
	j171731624 [label="To była wojna. A natura wojny polega na tym, że zabija się w ogromnych ilościach tych, z którymi się walczy. Czy opłakujesz Grineer czy \"Corpus\", których zabijasz?",shape=box,color=blue];
		j171731624 -> j3159786454;
		j171731624 -> j3381835812;
		j171731624 -> j4190243521;
	j1487350795 [label="Wybaczenie ze strony innych jest ważne.",shape=box,color=red];
		j1487350795 -> j3427609272;
	j879066776 [label="Możesz zmienić swoje zachowanie w przyszłości.",shape=box,color=red];
		j879066776 -> j3927809322;
	j3028472459 [label="Właściwie, może jeszcze uda mi się go przekonać, żeby zrozumiał prawdę o swojej religii. Człowiek, który miewa wizje rzezi, ale także rozsądek i logikę. Co za rzadkość.",shape=box,color=blue];
		j3028472459 -> j2161924660;
		j3028472459 -> j99840885;
	j3418782347 [label="Rozumiem. Nie chodzi o działanie, ale o metodologię, której się sprzeciwiasz. Niniejszym wycofuję swoją wcześniejszą aprobatę i zastępuję ją konsternacją.",shape=box,color=blue];
		j3418782347 -> "Chat ends.";
	j1283844610 [label="Boolean RoatheVillainSelf is now true.",color=orange];
		j1283844610 -> j1498641161;
	j813430859 [label="Boolean RoatheVillainOrokin is now true.",color=orange];
		j813430859 -> j1498641161;
	j1629237732 [label="Więc myślę, że nawet gdybyś planował zmienić ich na swój obraz i podobieństwo? Wiedziałeś, że zmiana musi nadejść.",shape=box,color=red];
		j1629237732 -> j683187618;
		j1629237732 -> j4234922302;
	j959970570 [label="Check boolean RoatheKnowsReset2",color=orange];
		j959970570 -> j1848053635 [label=true,color=green];
		j959970570 -> j1625863010 [label=false,color=brown];
	j911899810 [label="Poczucie winy z powodu zdrady mojego ludu jeszcze nigdy nie spędziło mi snu z powiek, Uzurpatorze. Uwierz mi.",shape=box,color=blue];
		j911899810 -> j1944299202;
	j3159786454 [label="Nie. Ale sytuacja ze Świadomymi jest wyjątkowa.",shape=box,color=red];
		j3159786454 -> j2364299881;
	j3381835812 [label="Tak.",shape=box,color=red];
		j3381835812 -> j3672682082;
	j4190243521 [label="To, co myślę o życiu, które muszę odebrać, to moja sprawa. Mówimy o tobie.",shape=box,color=red];
		j4190243521 -> j2033789720;
	j3427609272 [label="Dlaczego? Żebym został sam? Żebym nie był jakimś... anatemą? Jakimś wyrzutkiem społecznym? ",shape=box,color=blue];
		j3427609272 -> j1457777794;
	j3927809322 [label="Uczenie się na własnych błędach jest kluczowe, owszem. Ale zrozumienie \"porażki\" nie wymaga \"poczucia winy\".",shape=box,color=blue];
		j3927809322 -> j2486100737;
	j2161924660 [label="Leon zdaje się mieć już dość własnych problemów na głowie, nie sądzisz?",shape=box,color=red];
		j2161924660 -> j2895834365;
	j99840885 [label="Przepraszam, co próbujesz zrobić?",shape=box,color=red];
		j99840885 -> j3399570064;
	j1498641161 [label="Żyłeś w innej sytuacji. To, co dla nas wydaje się okrutne i niedopuszczalne było dla ciebie normalną częścią świata.",shape=box,color=red];
		j1498641161 -> j3413230948;
	j683187618 [label="Wciąż nie usprawiedliwia to okropności, jakich się dopuściłeś, krzywda pozostaje krzywdą, a horror horrorem. Ale starałeś się.",shape=box,color=red];
		j683187618 -> j1283584595;
	j4234922302 [label="Z mojego punktu widzenia, znalazłeś się w środku wojny i próbowałeś odnaleźć się w społeczeństwie socjopatów, próbując jednocześnie ich obalić. I tym dorobiłeś się tytułu diabła. To niesprawiedliwe.",shape=box,color=red];
		j4234922302 -> j1596502098;
	j1848053635 [label="Za to, że uciekłeś.",shape=box,color=red];
		j1848053635 -> j2340587127;
	j1625863010 [label="Za to, że odniosłeś porażkę.",shape=box,color=red];
		j1625863010 -> j2340587127;
	j1944299202 [label="Nie będę przepraszał za Imperium Orokin, bo to nie moje dzieło, ja tylko w nim żyłem. Nie mam też zamiaru brać na siebie winy za to, że próbowałem je obalić. Zasłużyliśmy na swój los, i na wiele gorszy.",shape=box,color=blue];
		j1944299202 -> j2087868388;
	j2364299881 [label="Każda sytuacja jest \"wyjątkowa\", Uzurpatorze. Kontekst jest kluczowy. Ty po prostu patrzysz na \"Starą Wojnę\", która się już dokonała, z perspektywy czasu.",shape=box,color=blue];
		j2364299881 -> j1026009775;
	j3672682082 [label="W takim razie czuję wobec ciebie ogromny żal, Uzurpatorze, i radzę ci, abyś jak najszybciej podjął się powierzonego ci zadania, albo obrał inne życie i podjął się pracy na polu.",shape=box,color=blue];
		j3672682082 -> j2790746507;
	j2033789720 [label="Mmm. Uwielbiam, kiedy tak jasno pokazujesz, że wszedłem ci pod skórę, to przepyszne. Ale słabo wychodzi ci zmiana tematu.",shape=box,color=blue];
		j2033789720 -> j2009138642;
	j1457777794 [label="Spójrz na mnie, Uzurpatorze. Zobacz, czym jestem. Orokin, wyrzucony z ich imperium.",shape=box,color=blue];
		j1457777794 -> j1073802856;
	j2486100737 [label="Jaki jest sens przebaczenia? O czyje przebaczenie mam się domagać? Od innych? Żebym nie był jakiś przekleństwem?",shape=box,color=blue];
		j2486100737 -> j1457777794;
	j2895834365 [label="I właśnie dlatego chcę mu pomóc! Próbuję tylko pomóc mu poradzić sobie z niepewnością wobec tego, co powiedziała mu Obojętność czy Entrati.",shape=box,color=blue];
		j2895834365 -> j1294707469;
	j3399570064 [label="W żaden sposób nie chcę go zranić, niezależnie od tego, co ta irytująca muszka może próbować ci wmówić. Chcę tylko pomóc mu poradzić sobie z niepewnością wobec tego, co powiedziała mu Obojętność czy Entrati.",shape=box,color=blue];
		j3399570064 -> j1294707469;
	j3413230948 [label="+10 Chemistry",color=orange];
		j3413230948 -> j478861276;
	j1283584595 [label="Boolean RoatheVillainOrokin is now true.",color=orange];
		j1283584595 -> j3413230948;
	j1596502098 [label="Boolean RoatheVillainShortcut is now true.",color=orange];
		j1596502098 -> j2623176071;
	j2340587127 [label="Boolean RoatheForgivenessShortcut is now true.",color=orange];
		j2340587127 -> j1933300832;
	j2087868388 [label="Jeśli jest coś, czego żałuję w swoim życiu... To tego, że to Tenno mieli przywilej to wszystko spalić, nie ja.",shape=box,color=blue];
		j2087868388 -> j533316691;
	j1026009775 [label="Jeśli masz zamiar oceniać wszystkich ludzi w przeszłości na podstawie informacji z przyszłości, możesz dojść do martwiących wniosków.",shape=box,color=blue];
		j1026009775 -> j1921791122;
	j2790746507 [label="Choć byłoby szkoda. To wspaniała zabawa obserwować, jak się starasz. Nie jesteś zbyt skuteczny, ale jakże widowiskowy.",shape=box,color=blue];
		j2790746507 -> j973304183;
	j2009138642 [label="Chociaż sądzę, że spędzenie stuleci w samotności, mogąc porozmawiać tylko z postaciami z bajki, może ograniczać możliwości rozwoju umiejętności społecznych.",shape=box,color=blue];
		j2009138642 -> j118955017;
	j1073802856 [label="W swoich czasach byłem \"Diabłem z Tau\". A teraz jestem już \"diabłem\" dla każdego, kto mnie spotyka.",shape=box,color=blue];
		j1073802856 -> j3795262563;
	j1294707469 [label="Entrati powiedział mu, że te \"wizje\" nie pochodzą od Lua tylko od Obojętności. Doprowadziło to do pewnego \"kryzysu wiary\".",shape=box,color=blue];
		j1294707469 -> j3281722923;
	j478861276 [label="Jakże miło wiedzieć, że niuans jeszcze nie umarł w tych czasach. Tak, masz całkowitą rację. Jestem tworem innych czasów, innej epoki, innego społeczeństwa.",shape=box,color=blue];
		j478861276 -> j1022587721;
	j2623176071 [label="+20 Chemistry",color=orange];
		j2623176071 -> j2042438454;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j533316691 [label="Boolean RoatheForgivenessNoGuilt is now true.",color=orange];
		j533316691 -> j1933300832;
	j1921791122 [label="Pogódź się z przeszłością i zacznij żyć teraźniejszością.",shape=box,color=blue];
		j1921791122 -> j1630587433;
	j973304183 [label="Dzięki tobie na polu bitwy znów zapanowała \"zabawa\".",shape=box,color=blue];
		j973304183 -> j1630587433;
	j118955017 [label="Idź, poćwicz z księdzem, oboje na tym skorzystacie.",shape=box,color=blue];
		j118955017 -> j4081414586;
	j3795262563 [label="Albrecht zadbał o to, by ten przydomek pozostał ze mną na zawsze.",shape=box,color=blue];
		j3795262563 -> j1630587433;
	j3281722923 [label="Ja natomiast próbuję przekonać go, że jest inaczej. Że nie zesłał ich żaden \"bóg\", bo bogowie nie istnieją. Jest po prostu chory.",shape=box,color=blue];
		j3281722923 -> j1218205086;
		j3281722923 -> j3371608566;
	j1022587721 [label="Potrafiłem jednak rozpoznać okrucieństwo i zbrodnie mojego ludu takimi, jakimi były. Były upadki, w które wielu z mojego gatunku popadło, a których nawet ja nie mogłem znieść.",shape=box,color=blue];
		j1022587721 -> j3333133785;
	j2042438454 [label="Wiedziałam, że lubię cię nie bez powodu, Uzurpatorze. Nareszcie! Ktoś, kto mnie docenia! Zajęło to tylko... ile wieków?!",shape=box,color=blue];
		j2042438454 -> j1471766065;
	j1630587433 [label="Oto moja rada dla ciebie: zniszcz w swoim sercu wszelkie poczucie winy z powodu swoich czynów, tak jak ja to zrobiłem. Wbijaj nóż w pierś tego uczucia, aż padnie martwe.",shape=box,color=blue];
		j1630587433 -> j1352253289;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j1218205086 [label="Czy Leon chciał twojej pomocy?",shape=box,color=red];
		j1218205086 -> j3701295312;
	j3371608566 [label="I myślisz, że to mu pomoże?",shape=box,color=red];
		j3371608566 -> j2018871410;
	j3333133785 [label="Ale takie sprawy są... skomplikowane. I doceniam, że to dostrzegasz. Ech, sługa łypie na mnie wymownie. Muszę zakończyć tę rozmowę. Wkrótce porozmawiamy.",shape=box,color=blue];
		j3333133785 -> "Chat ends.";
	j1471766065 [label="Ech, sługa łypie na mnie wymownie. Muszę zakończyć tę rozmowę. Wkrótce porozmawiamy.",shape=box,color=blue];
		j1471766065 -> "Chat ends.";
	j1352253289 [label="Wina to nic innego jak zdrajca w nocy, który ograbi cię ze wszystkiego, co ci drogie. Wyrządza ci tylko krzywdę.",shape=box,color=blue];
		j1352253289 -> j533316691;
	j3701295312 [label="Nie odmówił wysłuchania mnie. Nie powiedział mi, żebym zamilknął. Zrobiłbym tak, gdyby tylko poprosił.",shape=box,color=blue];
		j3701295312 -> j1163758069;
	j2018871410 [label="A czy lepiej jest, by był on manipulowany religią? Wskazywać na jego halucynacje i zwać je \"objawieniami\", zamiast mu pomóc?",shape=box,color=blue];
		j2018871410 -> j2303247023;
	j1163758069 [label="Szlag mnie trafia, kiedy widzę ludzi wokół Leona, którzy go wykorzystują, nawet jeśli nie zdają sobie z tego sprawy. Wszystko w imię \"religii\" i \"wiary\".",shape=box,color=blue];
		j1163758069 -> j2303247023;
	j2303247023 [label="Czytałem zapiski o tym, co się stało. Ten... \"Czerwony Woal\" mógł spróbować uwolnić tego Tenno z wnętrza jego Harrowa przez te wszystkie wieki. Ale nie zrobili tego. Pozwolili mu zmarnieć i umrzeć.",shape=box,color=blue];
		j2303247023 -> j2435558289;
	j2435558289 [label="Po co? W imię obrony... teoretycznego \"boga Pustki\".",shape=box,color=blue];
		j2435558289 -> j1405105098;
		j2435558289 -> j392460024;
	j1405105098 [label="Uważasz, że poświęcenie Rella poszło na marne?",shape=box,color=red];
		j1405105098 -> j409952204;
	j392460024 [label="Rell był jedyną osobą, która stała mu na drodze przez te wszystkie lata.",shape=box,color=red];
		j392460024 -> j2437766223;
	j409952204 [label="Nie. Chronił nas przed czymś. Ale kto wie, czy nie uczynił sytuacji gorszą? Kto wie, ile to coś karmiło się jego strachem i nim samym przez te stulecia?",shape=box,color=blue];
		j409952204 -> j2300034496;
	j2437766223 [label="Albo przez te lata po prostu to karmił.",shape=box,color=blue];
		j2437766223 -> j2300034496;
	j2300034496 [label="Urzeczywistnienie idei może stworzyć tylko to, co zostało mu dane. A Pustka może pracować tylko z płótnem, z którego została stworzona.",shape=box,color=blue];
		j2300034496 -> j169594216;
	j169594216 [label="Jak bardzo ten jeden Tenno przyczynił się od jej istnienia? Był istną ucztą Agonii, Bólu, Zdrady, Smutku... Samotności...",shape=box,color=blue];
		j169594216 -> j3805300636;
	j3805300636 [label="I odrętwienie, które musiało nadejść po tysiącach lat w samotności, mówiąc do Nicości. Co może nastąpić później, jeśli nie Obojętność?",shape=box,color=blue];
		j3805300636 -> j2199127592;
		j3805300636 -> j3995380671;
	j2199127592 [label="Możesz mówić prawdę, ale... nie wiem, czy tak jest. Nie mam też pewności, że nie jest.",shape=box,color=red];
		j2199127592 -> j1322545360;
	j3995380671 [label="To było potężne, zanim dosięgnęło Rella. Nie poświęciłby się, gdyby nie było to konieczne.",shape=box,color=red];
		j3995380671 -> j3074652063;
	j1322545360 [label="+10 Chemistry",color=orange];
		j1322545360 -> j615689857;
	j3074652063 [label="Takie bywają też dziecięce koszmary. W świecie sześciolatka jest to najpotężniejsza siła we wszechświecie. Ale dla dorosłego są zaledwie kłębkiem kurzu zbyt blisko lampy.",shape=box,color=blue];
		j3074652063 -> j2684083947;
	j615689857 [label="Nie wiem, czy mógłbym prosić cię o cokolwiek więcej, niż tylko to, żebyś przyznał, że nie wiesz wszystkiego o tym, z czym mamy do czynienia.",shape=box,color=blue];
		j615689857 -> j437675872;
	j2684083947 [label="Potrafimy rozdmuchać drobinę kurzu do rozmiaru góry tylko po to, żeby mieć powód do bycia nieszczęśliwym i zniszczyć samych siebie.",shape=box,color=blue];
		j2684083947 -> j409145270;
	j437675872 [label="To wspaniały punkt wyjścia. Przepiękna cecha, którą może posiadać człowiek: zdolność powiedzieć... \"nie wiem\".",shape=box,color=blue];
		j437675872 -> j3320882444;
	j409145270 [label="Ludzkość w skrócie.",shape=box,color=blue];
		j409145270 -> j3208040028;
	j3320882444 [label="Gdybyśmy my, Orokin, byli do tego czasem zdolni, może byśmy przetrwali.",shape=box,color=blue];
		j3320882444 -> j3208040028;
	j3208040028 [label="Boolean RoatheMITW3 is now true.",color=orange];
		j3208040028 -> j1933300832;
}