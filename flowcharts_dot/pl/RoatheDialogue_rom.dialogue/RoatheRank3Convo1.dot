digraph {
	1333 [label="RoatheRank3Convo1 begins.",color=orange];
		1333 -> 1334;
	1334 [label="Czy w końcu rozmawiasz z naszym drogim Leonem? Czy nadal się przed tobą nie otworzył? Szczerze mówiąc, lepiej byłoby zachować bezpieczny dystans.",shape=box,color=blue];
		1334 -> 1337;
		1334 -> 1336;
		1334 -> 1335;
	1337 [label="Nie dogadujecie się?",shape=box,color=red];
		1337 -> 1340;
	1336 [label="Gdybyś był ciut milszy dla Marii i Leona, oni mogliby być milsi dla ciebie.",shape=box,color=red];
		1336 -> 1339;
	1335 [label="[Koniec]",shape=box,color=red];
		1335 -> 1338;
	1340 [label="\"Dogadalibyśmy się\", gdyby zapragnął lepiej zrozumieć mnie i skąd pochodzę. Kim byłem od wielu wieków. Nie mam zamiaru zmieniać się tylko dlatego, że teraz tego żądają.",shape=box,color=blue];
		1340 -> 1341;
	1339 [label="A w jaki sposób oni są mili wobec mnie, Uzurpatorze? Jestem, kim jestem. I byłem taki od wielu wieków. Nie mam zamiaru zmieniać się tylko dlatego, że teraz tego żądają.",shape=box,color=blue];
		1339 -> 1341;
	1338 [label="Chat ends.",color=orange];
	1341 [label="Evaluate expressions on HellStory",color=orange];
		1341 -> 1343 [label="x >= 21",color=purple];
		1341 -> 1342 [label="x < 21",color=purple];
		1341 -> 1342 [label="false",color=purple];
	1343 [label="Może przyjąłem to serum dobrowolnie, ale nie wiedziałem, że zgodziłem się na nękanie przez tę dwójkę niewdzięczników.",shape=box,color=blue];
		1343 -> 1344;
	1342 [label="To przez Albrechta tak wyglądam! To on mnie tu uwięził! Ta okropna sytuacja nie jest moją winą!",shape=box,color=blue];
		1342 -> 1344;
	1344 [label="Swoje zastrzeżenia mogą kierować do swojego drogiego \"kardynała\", nie do mnie.",shape=box,color=blue];
		1344 -> 1345;
		1344 -> 1346;
		1344 -> 1347;
	1345 [label="Mają dobre intencje, nawet jeśli ich czyny nie zawsze o tym świadczą.",shape=box,color=red];
		1345 -> 1348;
	1346 [label="Nie uważasz, że potrzebujesz przebaczenia za to, co zrobiłeś?",shape=box,color=red];
		1346 -> 1349;
	1347 [label="Starają się tylko pomóc.",shape=box,color=red];
		1347 -> 1350;
	1348 [label="Add -1 to Thermostat",color=orange];
		1348 -> 1351;
	1349 [label="Add 1 to Thermostat",color=orange];
		1349 -> 1352;
	1350 [label="\"Pomóc\". Tak. \"Pomóc\". Wybacz mi, ale uważam ich styl \"pomocy\" za wielce \"niepomocny\".",shape=box,color=blue];
		1350 -> 1353;
	1351 [label="Tak, to jest tragedia w tym wszystkim. Oni naprawdę wierzą, że próbują czynić \"dobro\".",shape=box,color=blue];
		1351 -> 1354;
	1352 [label="Przebaczenia od kogo? Od ciebie? Od nich? Sługi? Albrechta? A może \"bogów\"?",shape=box,color=blue];
		1352 -> 1355;
		1352 -> 1356;
		1352 -> 1357;
	1353 [label="Byliby bardziej \"pomocni\", gdyby zamienili moje wino na kwas, Uzurpatorze.",shape=box,color=blue];
		1353 -> 1358;
	1354 [label="A jak ty sądzisz? Czy potrzebne jest mi \"wielkie rozgrzeszenie\"? Jakieś \"święte przebaczenie\"?",shape=box,color=blue];
		1354 -> 1359;
	1355 [label="Na tej liście brakuje istotnej pozycji.",shape=box,color=red];
		1355 -> 1360;
	1356 [label="Jesteś Orokin. Dopuściłeś się okrucieństw na wojnie i w naturze twojego społeczeństwa. Masz wiele do odpokutowania.",shape=box,color=red];
		1356 -> 1361;
	1357 [label="Nie zdajesz sobie sprawy, że w swoim życiu zrobiłeś straszne rzeczy?",shape=box,color=red];
		1357 -> 1362;
	1358 [label="To przynajmniej by zadziałało.",shape=box,color=blue];
		1358 -> 1363;
	1359 [label="Evaluate expressions",color=orange];
		1359 -> 1364 [label="RoatheTraitor2",color=purple];
		1359 -> 1365 [label="RoatheTraitor2",color=purple];
		1359 -> 1366 [label="RoatheTraitor2",color=purple];
		1359 -> 1367 [label="RoatheTraitor2",color=purple];
		1359 -> 1364 [label="RoatheTraitor1",color=purple];
		1359 -> 1365 [label="RoatheTraitor1",color=purple];
		1359 -> 1366 [label="RoatheTraitor1",color=purple];
		1359 -> 1367 [label="RoatheTraitor1",color=purple];
		1359 -> 1364 [label="RoatheExecutor2",color=purple];
		1359 -> 1365 [label="RoatheExecutor2",color=purple];
		1359 -> 1366 [label="RoatheExecutor2",color=purple];
		1359 -> 1367 [label="RoatheExecutor2",color=purple];
		1359 -> 1364 [label="false",color=purple];
		1359 -> 1365 [label="false",color=purple];
		1359 -> 1366 [label="false",color=purple];
	1360 [label="Och? Powiedz mi. ",shape=box,color=blue];
		1360 -> 1368;
		1360 -> 1369;
		1360 -> 1370;
	1361 [label="Nie będę przepraszał za społeczeństwo Orokin, bo nie ja je stworzyłem. Jedynie do niego należałem. A jeśli obwiniasz wszystkich, którzy uczestniczą w systemie, w którym po prostu się urodzili, potępisz miliardy w swojej moralnej wyższości. A poza tym?",shape=box,color=blue];
		1361 -> 1371;
	1362 [label="A co, jeśli tak? Nie mogę tego już zmienić. Jaki sens obwiniać siebie?",shape=box,color=blue];
		1362 -> 1372;
		1362 -> 1373;
	1363 [label="Chociaż z tej dwójki, muszę przyznać, że wolę księdza. Można przemówić mu do rozsądku. Może nawet zda sobie sprawę, że Obojętność nie jest prawdziwym bogiem.",shape=box,color=blue];
		1363 -> 1374;
	1364 [label="Myślę, że warto zastanowić się nad czynami, które wyrządziły krzywdę innym, i spróbować zrozumieć, jak je naprawić. Ale nie sądzę, żeby te dwie osoby robiły to w ogóle we właściwy sposób.",shape=box,color=red];
		1364 -> 1375;
	1365 [label="Ostatecznie nie wierzę w potrzebę wybaczania komukolwiek poza sobą. Jeśli czujesz się dobrze z tym, co zrobiłeś? Niech tak będzie.",shape=box,color=red];
		1365 -> 1376;
	1366 [label="Urodziłeś się w społeczeństwie, w którym wiele zachowań Orokin było po prostu... normalne. Oczekiwane. Nie było dla ciebie \"złe\". Nie twierdzę, że to wystarczające usprawiedliwienie, ale daje większe zrozumienie.",shape=box,color=red];
		1366 -> 1377;
	1367 [label="Planowałeś obalenie Orokin. Wiedziałeś, że są zepsuci i próbowałeś ich naprawić.",shape=box,color=red];
		1367 -> 1378;
	1368 [label="Ciebie samego.",shape=box,color=red];
		1368 -> 1379;
	1369 [label="Twój własny lud, który chciałeś zdradzić.",shape=box,color=red];
		1369 -> 1380;
	1370 [label="Świadomych, których zamordowałeś.",shape=box,color=red];
		1370 -> 1371;
	1371 [label="To była wojna. A natura wojny polega na tym, że zabija się w ogromnych ilościach tych, z którymi się walczy. Czy opłakujesz Grineer czy \"Corpus\", których zabijasz?",shape=box,color=blue];
		1371 -> 1381;
		1371 -> 1382;
		1371 -> 1383;
	1372 [label="Wybaczenie ze strony innych jest ważne.",shape=box,color=red];
		1372 -> 1384;
	1373 [label="Możesz zmienić swoje zachowanie w przyszłości.",shape=box,color=red];
		1373 -> 1385;
	1374 [label="Właściwie, może jeszcze uda mi się go przekonać, żeby zrozumiał prawdę o swojej religii. Człowiek, który miewa wizje rzezi, ale także rozsądek i logikę. Co za rzadkość.",shape=box,color=blue];
		1374 -> 1386;
		1374 -> 1387;
	1375 [label="Rozumiem. Nie chodzi o działanie, ale o metodologię, której się sprzeciwiasz. Niniejszym wycofuję swoją wcześniejszą aprobatę i zastępuję ją konsternacją.",shape=box,color=blue];
		1375 -> 1388;
	1376 [label="Update boolean RoatheVillainSelf",color=orange];
		1376 -> 1389;
	1377 [label="Update boolean RoatheVillainOrokin",color=orange];
		1377 -> 1389;
	1378 [label="Więc myślę, że nawet gdybyś planował zmienić ich na swój obraz i podobieństwo? Wiedziałeś, że zmiana musi nadejść.",shape=box,color=red];
		1378 -> 1390;
		1378 -> 1391;
	1379 [label="Check boolean RoatheKnowsReset2",color=orange];
		1379 -> 1392 [label=true,color=green];
		1379 -> 1393 [label=false,color=brown];
	1380 [label="Poczucie winy z powodu zdrady mojego ludu jeszcze nigdy nie spędziło mi snu z powiek, Uzurpatorze. Uwierz mi.",shape=box,color=blue];
		1380 -> 1394;
	1381 [label="Nie. Ale sytuacja ze Świadomymi jest wyjątkowa.",shape=box,color=red];
		1381 -> 1395;
	1382 [label="Tak.",shape=box,color=red];
		1382 -> 1396;
	1383 [label="To, co myślę o życiu, które muszę odebrać, to moja sprawa. Mówimy o tobie.",shape=box,color=red];
		1383 -> 1397;
	1384 [label="Dlaczego? Żebym został sam? Żebym nie był jakimś... anatemą? Jakimś wyrzutkiem społecznym? ",shape=box,color=blue];
		1384 -> 1398;
	1385 [label="Uczenie się na własnych błędach jest kluczowe, owszem. Ale zrozumienie \"porażki\" nie wymaga \"poczucia winy\".",shape=box,color=blue];
		1385 -> 1399;
	1386 [label="Leon zdaje się mieć już dość własnych problemów na głowie, nie sądzisz?",shape=box,color=red];
		1386 -> 1400;
	1387 [label="Przepraszam, co próbujesz zrobić?",shape=box,color=red];
		1387 -> 1401;
	1388 [label="Chat ends.",color=orange];
	1389 [label="Żyłeś w innej sytuacji. To, co dla nas wydaje się okrutne i niedopuszczalne było dla ciebie normalną częścią świata.",shape=box,color=red];
		1389 -> 1402;
	1390 [label="Wciąż nie usprawiedliwia to okropności, jakich się dopuściłeś, krzywda pozostaje krzywdą, a horror horrorem. Ale starałeś się.",shape=box,color=red];
		1390 -> 1403;
	1391 [label="Z mojego punktu widzenia, znalazłeś się w środku wojny i próbowałeś odnaleźć się w społeczeństwie socjopatów, próbując jednocześnie ich obalić. I tym dorobiłeś się tytułu diabła. To niesprawiedliwe.",shape=box,color=red];
		1391 -> 1404;
	1392 [label="Za to, że uciekłeś.",shape=box,color=red];
		1392 -> 1405;
	1393 [label="Za to, że odniosłeś porażkę.",shape=box,color=red];
		1393 -> 1405;
	1394 [label="Nie będę przepraszał za Imperium Orokin, bo to nie moje dzieło, ja tylko w nim żyłem. Nie mam też zamiaru brać na siebie winy za to, że próbowałem je obalić. Zasłużyliśmy na swój los, i na wiele gorszy.",shape=box,color=blue];
		1394 -> 1406;
	1395 [label="Każda sytuacja jest \"wyjątkowa\", Uzurpatorze. Kontekst jest kluczowy. Ty po prostu patrzysz na \"Starą Wojnę\", która się już dokonała, z perspektywy czasu.",shape=box,color=blue];
		1395 -> 1407;
	1396 [label="W takim razie czuję wobec ciebie ogromny żal, Uzurpatorze, i radzę ci, abyś jak najszybciej podjął się powierzonego ci zadania, albo obrał inne życie i podjął się pracy na polu.",shape=box,color=blue];
		1396 -> 1408;
	1397 [label="Mmm. Uwielbiam, kiedy tak jasno pokazujesz, że wszedłem ci pod skórę, to przepyszne. Ale słabo wychodzi ci zmiana tematu.",shape=box,color=blue];
		1397 -> 1409;
	1398 [label="Spójrz na mnie, Uzurpatorze. Zobacz, czym jestem. Orokin, wyrzucony z ich imperium.",shape=box,color=blue];
		1398 -> 1410;
	1399 [label="Jaki jest sens przebaczenia? O czyje przebaczenie mam się domagać? Od innych? Żebym nie był jakiś przekleństwem?",shape=box,color=blue];
		1399 -> 1398;
	1400 [label="I właśnie dlatego chcę mu pomóc! Próbuję tylko pomóc mu poradzić sobie z niepewnością wobec tego, co powiedziała mu Obojętność czy Entrati.",shape=box,color=blue];
		1400 -> 1411;
	1401 [label="W żaden sposób nie chcę go zranić, niezależnie od tego, co ta irytująca muszka może próbować ci wmówić. Chcę tylko pomóc mu poradzić sobie z niepewnością wobec tego, co powiedziała mu Obojętność czy Entrati.",shape=box,color=blue];
		1401 -> 1411;
	1402 [label="+10 Chemistry",color=orange];
		1402 -> 1412;
	1403 [label="Update boolean RoatheVillainOrokin",color=orange];
		1403 -> 1402;
	1404 [label="Update boolean RoatheVillainShortcut",color=orange];
		1404 -> 1413;
	1405 [label="Update boolean RoatheForgivenessShortcut",color=orange];
		1405 -> 1414;
	1406 [label="Jeśli jest coś, czego żałuję w swoim życiu... To tego, że to Tenno mieli przywilej to wszystko spalić, nie ja.",shape=box,color=blue];
		1406 -> 1415;
	1407 [label="Jeśli masz zamiar oceniać wszystkich ludzi w przeszłości na podstawie informacji z przyszłości, możesz dojść do martwiących wniosków.",shape=box,color=blue];
		1407 -> 1416;
	1408 [label="Choć byłoby szkoda. To wspaniała zabawa obserwować, jak się starasz. Nie jesteś zbyt skuteczny, ale jakże widowiskowy.",shape=box,color=blue];
		1408 -> 1417;
	1409 [label="Chociaż sądzę, że spędzenie stuleci w samotności, mogąc porozmawiać tylko z postaciami z bajki, może ograniczać możliwości rozwoju umiejętności społecznych.",shape=box,color=blue];
		1409 -> 1418;
	1410 [label="W swoich czasach byłem \"Diabłem z Tau\". A teraz jestem już \"diabłem\" dla każdego, kto mnie spotyka.",shape=box,color=blue];
		1410 -> 1419;
	1411 [label="Entrati powiedział mu, że te \"wizje\" nie pochodzą od Lua tylko od Obojętności. Doprowadziło to do pewnego \"kryzysu wiary\".",shape=box,color=blue];
		1411 -> 1420;
	1412 [label="Jakże miło wiedzieć, że niuans jeszcze nie umarł w tych czasach. Tak, masz całkowitą rację. Jestem tworem innych czasów, innej epoki, innego społeczeństwa.",shape=box,color=blue];
		1412 -> 1421;
	1413 [label="+20 Chemistry",color=orange];
		1413 -> 1422;
	1414 [label="+10 Chemistry",color=orange];
		1414 -> 1423;
	1415 [label="Update boolean RoatheForgivenessNoGuilt",color=orange];
		1415 -> 1424;
	1416 [label="Pogódź się z przeszłością i zacznij żyć teraźniejszością.",shape=box,color=blue];
		1416 -> 1425;
	1417 [label="Dzięki tobie na polu bitwy znów zapanowała \"zabawa\".",shape=box,color=blue];
		1417 -> 1425;
	1418 [label="Idź, poćwicz z księdzem, oboje na tym skorzystacie.",shape=box,color=blue];
		1418 -> 1426;
	1419 [label="Albrecht zadbał o to, by ten przydomek pozostał ze mną na zawsze.",shape=box,color=blue];
		1419 -> 1425;
	1420 [label="Ja natomiast próbuję przekonać go, że jest inaczej. Że nie zesłał ich żaden \"bóg\", bo bogowie nie istnieją. Jest po prostu chory.",shape=box,color=blue];
		1420 -> 1427;
		1420 -> 1428;
	1421 [label="Potrafiłem jednak rozpoznać okrucieństwo i zbrodnie mojego ludu takimi, jakimi były. Były upadki, w które wielu z mojego gatunku popadło, a których nawet ja nie mogłem znieść.",shape=box,color=blue];
		1421 -> 1429;
	1422 [label="Wiedziałam, że lubię cię nie bez powodu, Uzurpatorze. Nareszcie! Ktoś, kto mnie docenia! Zajęło to tylko... ile wieków?!",shape=box,color=blue];
		1422 -> 1430;
	1423 [label="Chat ends.",color=orange];
	1424 [label="+10 Chemistry",color=orange];
		1424 -> 1431;
	1425 [label="Oto moja rada dla ciebie: zniszcz w swoim sercu wszelkie poczucie winy z powodu swoich czynów, tak jak ja to zrobiłem. Wbijaj nóż w pierś tego uczucia, aż padnie martwe.",shape=box,color=blue];
		1425 -> 1432;
	1426 [label="+5 Chemistry",color=orange];
		1426 -> 1433;
	1427 [label="Czy Leon chciał twojej pomocy?",shape=box,color=red];
		1427 -> 1434;
	1428 [label="I myślisz, że to mu pomoże?",shape=box,color=red];
		1428 -> 1435;
	1429 [label="Ale takie sprawy są... skomplikowane. I doceniam, że to dostrzegasz. Ech, sługa łypie na mnie wymownie. Muszę zakończyć tę rozmowę. Wkrótce porozmawiamy.",shape=box,color=blue];
		1429 -> 1436;
	1430 [label="Ech, sługa łypie na mnie wymownie. Muszę zakończyć tę rozmowę. Wkrótce porozmawiamy.",shape=box,color=blue];
		1430 -> 1437;
	1431 [label="Chat ends.",color=orange];
	1432 [label="Wina to nic innego jak zdrajca w nocy, który ograbi cię ze wszystkiego, co ci drogie. Wyrządza ci tylko krzywdę.",shape=box,color=blue];
		1432 -> 1438;
	1433 [label="Chat ends.",color=orange];
	1434 [label="Nie odmówił wysłuchania mnie. Nie powiedział mi, żebym zamilknął. Zrobiłbym tak, gdyby tylko poprosił.",shape=box,color=blue];
		1434 -> 1439;
	1435 [label="A czy lepiej jest, by był on manipulowany religią? Wskazywać na jego halucynacje i zwać je \"objawieniami\", zamiast mu pomóc?",shape=box,color=blue];
		1435 -> 1440;
	1436 [label="Chat ends.",color=orange];
	1437 [label="Chat ends.",color=orange];
	1438 [label="Update boolean RoatheForgivenessNoGuilt",color=orange];
		1438 -> 1441;
	1439 [label="Szlag mnie trafia, kiedy widzę ludzi wokół Leona, którzy go wykorzystują, nawet jeśli nie zdają sobie z tego sprawy. Wszystko w imię \"religii\" i \"wiary\".",shape=box,color=blue];
		1439 -> 1440;
	1440 [label="Czytałem zapiski o tym, co się stało. Ten... \"Czerwony Woal\" mógł spróbować uwolnić tego Tenno z wnętrza jego Harrowa przez te wszystkie wieki. Ale nie zrobili tego. Pozwolili mu zmarnieć i umrzeć.",shape=box,color=blue];
		1440 -> 1442;
	1441 [label="+10 Chemistry",color=orange];
		1441 -> 1443;
	1442 [label="Po co? W imię obrony... teoretycznego \"boga Pustki\".",shape=box,color=blue];
		1442 -> 1444;
		1442 -> 1445;
	1443 [label="Chat ends.",color=orange];
	1444 [label="Uważasz, że poświęcenie Rella poszło na marne?",shape=box,color=red];
		1444 -> 1446;
	1445 [label="Rell był jedyną osobą, która stała mu na drodze przez te wszystkie lata.",shape=box,color=red];
		1445 -> 1447;
	1446 [label="Nie. Chronił nas przed czymś. Ale kto wie, czy nie uczynił sytuacji gorszą? Kto wie, ile to coś karmiło się jego strachem i nim samym przez te stulecia?",shape=box,color=blue];
		1446 -> 1448;
	1447 [label="Albo przez te lata po prostu to karmił.",shape=box,color=blue];
		1447 -> 1448;
	1448 [label="Urzeczywistnienie idei może stworzyć tylko to, co zostało mu dane. A Pustka może pracować tylko z płótnem, z którego została stworzona.",shape=box,color=blue];
		1448 -> 1449;
	1449 [label="Jak bardzo ten jeden Tenno przyczynił się od jej istnienia? Był istną ucztą Agonii, Bólu, Zdrady, Smutku... Samotności...",shape=box,color=blue];
		1449 -> 1450;
	1450 [label="I odrętwienie, które musiało nadejść po tysiącach lat w samotności, mówiąc do Nicości. Co może nastąpić później, jeśli nie Obojętność?",shape=box,color=blue];
		1450 -> 1451;
		1450 -> 1452;
	1451 [label="Możesz mówić prawdę, ale... nie wiem, czy tak jest. Nie mam też pewności, że nie jest.",shape=box,color=red];
		1451 -> 1453;
	1452 [label="To było potężne, zanim dosięgnęło Rella. Nie poświęciłby się, gdyby nie było to konieczne.",shape=box,color=red];
		1452 -> 1454;
	1453 [label="+10 Chemistry",color=orange];
		1453 -> 1455;
	1454 [label="Takie bywają też dziecięce koszmary. W świecie sześciolatka jest to najpotężniejsza siła we wszechświecie. Ale dla dorosłego są zaledwie kłębkiem kurzu zbyt blisko lampy.",shape=box,color=blue];
		1454 -> 1456;
