	j963888043 [label="VM: KOMISJA",shape=box,color=blue];
		j963888043 -> j2137465839;
	j2137465839 [label="Transkrypcja: Spośród Siedmiu byłem – jak mi mówiono – uważany za zabawkę i konkubenta Nitokh.",shape=box,color=blue];
		j2137465839 -> j2294933831;
	j2294933831 [label="In the early days of the War they appointed me Vice Regent Grand Carnus at her goading, thinking it a jest.",shape=box,color=blue];
		j2294933831 -> j1665979;
	j1665979 [label="How quickly their laughter turned to solemn applause as I brought home the news of one victory after another.",shape=box,color=blue];
		j1665979 -> j1512926580;
	j1512926580 [label="Krew dzielnych ludzi zdobiła mnie niczym medale. W tajemnicy gromadziłem broń dla Nitokh.",shape=box,color=blue];
		j1512926580 -> j529137979;
	j529137979 [label="To było łatwe. Byłem zbyt wspaniałą postacią, żeby mnie podejrzewać.",shape=box,color=blue];
		j529137979 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
