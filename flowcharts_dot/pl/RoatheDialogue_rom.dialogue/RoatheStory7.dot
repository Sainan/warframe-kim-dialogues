	j1937293328 [label="VM: KOMISJA",shape=box,color=blue];
		j1937293328 -> j1894897435;
	j1894897435 [label="Transkrypcja: Spośród Siedmiu byłem – jak mi mówiono – uważany za zabawkę i konkubenta Nitokh.",shape=box,color=blue];
		j1894897435 -> j3705498224;
	j3705498224 [label="Na początku wojny mianowali mnie Wiceregentem Grand Carnusem, prowokując mnie, uznając to za żart.",shape=box,color=blue];
		j3705498224 -> j1892152642;
	j1892152642 [label="Jak szybko ich śmiech przerodził się w uroczyste oklaski, gdy przynosiłem do domu wieści o jednym zwycięstwie za drugim.",shape=box,color=blue];
		j1892152642 -> j1512926580;
	j1512926580 [label="Krew dzielnych ludzi zdobiła mnie niczym medale. W tajemnicy gromadziłem broń dla Nitokh.",shape=box,color=blue];
		j1512926580 -> j529137979;
	j529137979 [label="To było łatwe. Byłem zbyt wspaniałą postacią, żeby mnie podejrzewać.",shape=box,color=blue];
