	"Chat ends." [color=orange];
	j3876675747 [label="VM: SACRIFICE",shape=box,color=blue];
		j3876675747 -> j1877281627;
	j1877281627 [label="Transkrypcja: Traivon. Widziałem, jak cisnęłaś swojego Railjacka w paszczę Praghasy. Rozproszona, żarłocznie karmiąc się tobą i twoimi ludźmi, nie zauważyła, że mój statek ucieka.",shape=box,color=blue];
		j1877281627 -> j3729277252;
	j3729277252 [label="You laid down your life for your superior officer. I felt your selflessness like a slap in the face.",shape=box,color=blue];
		j3729277252 -> j3496723491;
	j3496723491 [label="Maryna. You gave me your body. Together, in that trench, we drank Kuva. My hands shook and my gashed throat leaked, but I kept enough drops down for it to take.",shape=box,color=blue];
		j3496723491 -> j3725952612;
	j3725952612 [label="I remember your last salute. The fading. Then I blinked open the eyes that had been yours, and saw my gutted corpse dead in the mud.",shape=box,color=blue];
		j3725952612 -> j1926271240;
	j1926271240 [label="Rostig. Coś nie tak z procesem klonowania, mówili. Co innego mogłoby sprawić, że Grineer pozostałby przy swojej wieżyczce, płonąc żywcem? Nawet szczur ma instynkt samozachowawczy!",shape=box,color=blue];
		j1926271240 -> j1573479192;
	j1573479192 [label="Nie. Twój \"defekt\" stawiał cię ponad nimi.",shape=box,color=blue];
		j1573479192 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}