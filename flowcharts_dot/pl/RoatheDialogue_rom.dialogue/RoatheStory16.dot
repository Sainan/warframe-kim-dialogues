	j1016143716 [label="VM: POŚWIĘCENIE",shape=box,color=blue];
		j1016143716 -> j2277303400;
	j2277303400 [label="Transkrypcja: Traivon. Widziałem, jak cisnęłaś swojego Railjacka w paszczę Praghasy. Rozproszona, żarłocznie karmiąc się tobą i twoimi ludźmi, nie zauważyła, że mój statek ucieka.",shape=box,color=blue];
		j2277303400 -> j2454276825;
	j2454276825 [label="Oddałaś życie za swojego przełożonego. Poczułem twoją bezinteresowność jak uderzenie w twarz.",shape=box,color=blue];
		j2454276825 -> j4192162954;
	j4192162954 [label="Maryna. Dałaś mi swoje ciało. Razem, w tym okopie, piliśmy Kuvę. Ręce mi się trzęsły, a z rozciętego gardła lała się krew, ale zatrzymałem wystarczająco dużo kropli, żeby wytrzymało.",shape=box,color=blue];
		j4192162954 -> j2628040448;
	j2628040448 [label="Pamiętam twój ostatni salut. To odejście. Potem mrugnąłem, otworzyłem oczy, które kiedyś należały do ciebie, i zobaczyłem moje wypatroszone ciało martwe w błocie.",shape=box,color=blue];
		j2628040448 -> j1926271240;
	j1926271240 [label="Rostig. Coś nie tak z procesem klonowania, mówili. Co innego mogłoby sprawić, że Grineer pozostałby przy swojej wieżyczce, płonąc żywcem? Nawet szczur ma instynkt samozachowawczy!",shape=box,color=blue];
		j1926271240 -> j1573479192;
	j1573479192 [label="Nie. Twój \"defekt\" stawiał cię ponad nimi.",shape=box,color=blue];
		j1573479192 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}