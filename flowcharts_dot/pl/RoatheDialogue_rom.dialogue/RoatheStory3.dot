	2150 [label="Transkrypcja: Przez długi czas Imperium Orokin nie miało wrogów. Jego armia istniała jedynie po to, by odpowiadać na drobne urazy, ród przeciwko rodowi, Egzekutor przeciwko Egzekutorowi.",shape=box,color=blue];
