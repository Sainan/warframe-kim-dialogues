	2153 [label="Kiedy zaatakowali Świadomi, poczuliśmy jedność, której tak długo nam odmawiano. Daksowie sięgnęli po miecze przeciwko czemuś innemu niż bezczelny wieśniak czy złodziejski handlarz.",shape=box,color=blue];
		2153 -> 2154;
	2154 [label="Imperatorowie, nieśmiertelni tytularni władcy Imperium, których władza spoczywała w rękach Egzekutorów, obudzili się na swoich zakurzonych złotych tronach.",shape=box,color=blue];
		2154 -> 5683;
	5683 [label="Wojna, wspaniała wojna! Wreszcie Imperium coś znaczyło. Zdefiniowani przez zagładę bardziej nieuchronną niż ostateczna śmierć Słońca, piliśmy obficie nektar życia.",shape=box,color=blue];
