		j1087834021 -> j1623649537;
	j1623649537 [label="Transkrypcja: Przez długi czas Imperium Orokin nie miało wrogów. Jego armia istniała jedynie po to, by odpowiadać na drobne urazy, ród przeciwko rodowi, Egzekutor przeciwko Egzekutorowi.",shape=box,color=blue];
		j1623649537 -> j3691828287;
	j3691828287 [label="Kiedy zaatakowali Świadomi, poczuliśmy jedność, której tak długo nam odmawiano. Daksowie sięgnęli po miecze przeciwko czemuś innemu niż bezczelny wieśniak czy złodziejski handlarz.",shape=box,color=blue];
		j3691828287 -> j1218648856;
	j1218648856 [label="Imperatorowie, nieśmiertelni tytularni władcy Imperium, których władza spoczywała w rękach Egzekutorów, obudzili się na swoich zakurzonych złotych tronach.",shape=box,color=blue];
		j1218648856 -> j2911217746;
	j2911217746 [label="Wojna, wspaniała wojna! Wreszcie Imperium coś znaczyło. Zdefiniowani przez zagładę bardziej nieuchronną niż ostateczna śmierć Słońca, piliśmy obficie nektar życia.",shape=box,color=blue];
