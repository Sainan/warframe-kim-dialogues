	j3845723475 [label="Her voice was broken glass grinding in my ears.",shape=box,color=blue];
		j3845723475 -> j3519070986;
	j3519070986 [label="Executor Nitokh was displeased. She had expected a glorious escalation, battle after battle, ending in the climactic ecstasy of the Orokin’s demise.",shape=box,color=blue];
		j3519070986 -> j1962399305;
	j1962399305 [label="After which she would emerge from hiding and… well, there I am left to speculate. Perhaps she expected to be invited into the Sentients’ confidence.",shape=box,color=blue];
		j1962399305 -> j2959390833;
	j2959390833 [label="Albo może myślała, że porzucą spalone, zanieczyszczone pozostałości Systemu Origin i pozwolą jej samej stworzyć nowe królestwo.",shape=box,color=blue];
		j2959390833 -> j2230810054;
	j2230810054 [label="Mimo wszystko pokój nie będzie tolerowany. Dlatego zabraliśmy się do pracy, by go podważyć.",shape=box,color=blue];
