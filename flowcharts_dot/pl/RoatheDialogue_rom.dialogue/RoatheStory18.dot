		j958365070 -> j4114364422;
	j4114364422 [label="Egzekutorka Nitokh była niezadowolona. Spodziewała się wspaniałej eskalacji, bitwy za bitwą, kończącej się kulminacyjną ekstazą śmierci Orokin.",shape=box,color=blue];
		j4114364422 -> j3460446397;
	j3460446397 [label="Po czym wyłoni się z ukrycia i… cóż, tutaj zostawię domysły. Może spodziewała się, że obejmie ją łaska Świadomych.",shape=box,color=blue];
		j3460446397 -> j2959390833;
	j2959390833 [label="Albo może myślała, że porzucą spalone, zanieczyszczone pozostałości Systemu Origin i pozwolą jej samej stworzyć nowe królestwo.",shape=box,color=blue];
		j2959390833 -> j2230810054;
	j2230810054 [label="Mimo wszystko pokój nie będzie tolerowany. Dlatego zabraliśmy się do pracy, by go podważyć.",shape=box,color=blue];
		j2230810054 -> j921430358;
