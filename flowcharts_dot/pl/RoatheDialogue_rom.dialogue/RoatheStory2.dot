	j3326552271 [label="VM: POŁĄCZENIE",shape=box,color=blue];
		j3326552271 -> j1814809091;
	j1814809091 [label="Transkrypcja: Kiedy Świadomi ukończyli budowę Kolei Solarnej do Tau, nie było żadnej uroczystej ceremonii. Po prostu zaczęła działać.",shape=box,color=blue];
		j1814809091 -> j948617369;
	j948617369 [label="Ceremonia została zorganizowana w pośpiechu, oczywiście, ponieważ żaden prawdziwy Orokin nie może kichnąć bez wielkiej ceremonii wokół tego wiekopomnego zdarzenia.",shape=box,color=blue];
		j948617369 -> j1685600761;
	j1685600761 [label="Wokół Pierwszego Transportu, który miał odbyć Przeprawę, zrobiło się wielkie zamieszanie.",shape=box,color=blue];
		j1685600761 -> j617467224;
	j617467224 [label="Był to majestatyczny krążownik Egzekutora Tormisa, a wybór Tormisa na członka ekspedycji mógł być zbiorową naganą dla Egzekutora Tuvula za groteskową katastrofę Zarimana Ten Zero.",shape=box,color=blue];
		j617467224 -> j3020834139;
	j3020834139 [label="Tormis wróciła, niosąc ze sobą cudowne, ozdobione klejnotami wspomnienia nowego Systemu i nowych światów do skolonizowania. ",shape=box,color=blue];
		j3020834139 -> j896430141;
	j896430141 [label="W ciągu kilku dni flotylla statków kolonizacyjnych odpłynęła, pragnąc dotrzeć do dziewiczych krain.",shape=box,color=blue];
		j896430141 -> j2768313620;
	j2768313620 [label="Następujący potem atak Świadomych nieco zepsuł nastrój.",shape=box,color=blue];
