		j4031556818 -> j2260270672;
	j1463124701 [label="Porzucił mnie w tej ohydnej, zapyziałej przeszłości, w bliżej nieokreślonym zadupiu Systemu Origin! Zdajesz sobie sprawę, że w tej zapomnianej przez Pustkę \"Cathédrale\" nie było nawet prądu?! NAWET PRĄDU!",shape=box,color=blue];
		j1463124701 -> j1134729590;
