		332 -> 341;
	333 [label="Helminth. Jak zdołał wyrosnąć w tamtych czasach, nie wiem, bo był już na miejscu, kiedy tu dotarliśmy. Potem zwiądł i umarł - myślałem, że inny mógłby zostać użyty w drodze powrotnej.",shape=box,color=blue];
		333 -> 342;
