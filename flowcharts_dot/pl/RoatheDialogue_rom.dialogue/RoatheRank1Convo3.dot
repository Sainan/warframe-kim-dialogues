		j119508418 -> j719981773;
	j4230297627 [label="Dlaczego?",shape=box,color=blue];
		j4230297627 -> j4264223896;
	j2491799117 [label="Po drugie: Jak bardzo nieudolny musisz być? Jestem pewien, że wystarczy go zaledwie podlewać i nakarmić raz dziennie, żeby zaskarbić sobie wieczną miłość i uwielbienie Księdza.",shape=box,color=blue];
		j2491799117 -> j3377736195;
	j2276034004 [label="Po drugie: Próbowałeś utykać przed nią? Udawać jakąś chorobę? Spojrzeć na nią pociągająco? Powiedzieć, że ładnie wygląda? Nie wygląda na trudną do oczarowania.",shape=box,color=blue];
		j2276034004 -> j1393620401;
	j3171749909 [label="Po potwierdzeniu moich podejrzeń nachodzą mnie dwie myśli:",shape=box,color=blue];
		j3171749909 -> j3850428096;
	j3802562141 [label="Ale to rozmowa na inny dzień. Mam dla ciebie propozycję. Wierzę, że zainteresuje cię ona o wiele bardziej.",shape=box,color=blue];
		j3802562141 -> j889748855;
	j3056637502 [label="Moje ciało było rozrywane na strzępy i budowane na nowo. Nie wybrałem tego. Nie wiem, czy w przypadku innych proces wyglądał tak samo.",shape=box,color=blue];
		j3056637502 -> j544883774;
	j2405194029 [label="Wykorzystałem własną krew, aby metodą prób i błędów odtworzyć Helmintha. Nie było to łatwe zadanie, nie miałem dostępu do żadnego sprzętu Orokin. Żadnego sprzętu, z wyjątkiem tego, co mogłem ukraść z...",shape=box,color=blue];
