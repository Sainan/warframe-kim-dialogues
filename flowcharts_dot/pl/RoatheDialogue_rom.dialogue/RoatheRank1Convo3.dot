		190 -> 192 [label="x < 21",color=purple];
		190 -> 192 [label="false",color=purple];
	189 [label="Chat ends.",color=orange];
	191 [label="Dlaczego mam przeczucie, że już dobrze znasz odpowiedź na to pytanie, mój Uzurpatorze? W jakie gierki pogrywasz, pytając mnie o takie błahostki, kiedy mój umysł jest dla ciebie jak otwarta księga?",shape=box,color=blue];
		191 -> 193;
	192 [label="Ależ oczywiście! To idealna okazja, abym mógł rozwodzić się nad własnym geniuszem i ponarzekać na niespotykaną zdolność Albrechta w byciu niezwykle pochopnym, a zarazem tchórzliwym w tej samej chwili!",shape=box,color=blue];
		192 -> 194;
	193 [label="Check boolean RoatheKnowsReset",color=orange];
		193 -> 196 [label=true,color=green];
		193 -> 195 [label=false,color=brown];
	194 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		194 -> 197 [label="x >= 1",color=purple];
		194 -> 198 [label="x <= 0",color=purple];
		194 -> 198 [label="false",color=purple];
	196 [label="Jesteś równie podły co sam Albrecht, mieszasz w głowach wszystkich w swoim otoczeniu - są dla ciebie jak zabawki! Więc powiedz mi, po co pytać, skoro już znasz odpowiedzi, hmm?",shape=box,color=blue];
		196 -> 201;
		196 -> 202;
	195 [label="Powiedz mi, czy dobrze myślę, że znasz już wszystkie odpowiedzi, których szukasz? Już wiesz, jak powróciłem tu w towarzystwie tych fanatyków i skąd dokładnie pochodzimy. Zapewne wiesz też wiele więcej, czyż nie?",shape=box,color=blue];
		195 -> 199;
		195 -> 200;
	197 [label="Rozumiem, że Albrecht nie umieścił cię tam z własnej woli.",shape=box,color=red];
		197 -> 203;
	198 [label="Ach, więc nie trafiłeś tam z własnej woli.",shape=box,color=red];
		198 -> 203;
	201 [label="Próbuję pokierować was wszystkich przez ten proces, a ostatnim razem totalnie zawaliłem. Próbuję więc \"od nowa\".",shape=box,color=red];
		201 -> 206;
	202 [label="Naprawdę nie wiem, jak to wyjaśnić. Nie prosiłem o zdolność odbierania wam wspomnień, ale staram się wykorzystać tę zdolność najlepiej, jak potrafię.",shape=box,color=red];
		202 -> 207;
	199 [label="Nie, nie wiem.",shape=box,color=red];
		199 -> 204;
	200 [label="Muszę przyznać, że tak.",shape=box,color=red];
		200 -> 205;
	203 [label="Nie, w żadnym razie. Musisz zrozumieć jedno o Orokin: Graliśmy – no cóż… dokładniej, często graliśmy ze sobą w gry. Gry wszelkiego rodzaju. Polityczne, psychologiczne, seksualne. Nie miało to znaczenia.",shape=box,color=blue];
		203 -> 208;
	206 [label="+5 Chemistry",color=orange];
		206 -> 211;
	207 [label="Jak widać idzie ci to raczej słabo, mój Ponadczasowy Towarzyszu. Co starasz się osiągnąć, czego nie zdołałeś zdobyć wcześniej?",shape=box,color=blue];
		207 -> 212;
	204 [label="Ha. Teraz wiem, że jesteś nie tylko kłamcą, ale i złodziejem wspomnień, Uzurpatorze.",shape=box,color=blue];
		204 -> 209;
	205 [label="Update boolean RoatheKnowsReset",color=orange];
		205 -> 210;
	208 [label="Dzięki Kuvie i Teatrowi Yuvan jesteśmy fundamentalnie i funkcjonalnie nieśmiertelni. Zdołasz sobie wyobrazić, jakie jest to męczące?",shape=box,color=blue];
		208 -> 213;
		208 -> 214;
	211 [label="Update boolean RoatheResetScrewedUp",color=orange];
		211 -> 215;
	212 [label="Check boolean LoidFamilyComplete",color=orange];
		212 -> 217 [label=true,color=green];
		212 -> 218 [label=true,color=green];
		212 -> 216 [label=false,color=brown];
		212 -> 217 [label=false,color=brown];
		212 -> 218 [label=false,color=brown];
	209 [label="Chat ends.",color=orange];
	210 [label="Dlaczego zwracasz się do mnie, kiedy już znasz odpowiedź?",shape=box,color=blue];
		210 -> 201;
		210 -> 202;
	213 [label="Wierz lub nie, ale wiem jak to jest.",shape=box,color=red];
		213 -> 219;
	214 [label="Jestem tego świadom. Ale proszę, kontynuuj.",shape=box,color=red];
		214 -> 220;
	215 [label="I to jest fascynujące... zawaliłeś ze mną, czy zawaliłeś z Leonem i Marią?",shape=box,color=blue];
		215 -> 221;
		215 -> 222;
		215 -> 223;
	217 [label="Widzisz, jest ta cała sprawa... o tym, dlaczego przyjąłeś serum, a ja... powiedziałem złe rzeczy w niewłaściwych chwilach.",shape=box,color=red];
		217 -> 225;
	218 [label="Próbuję... zdobyć serce jednego z was... i naprawdę... zawaliłem sprawę...",shape=box,color=red];
		218 -> 226;
	216 [label="Próbuję przekonać ciebie i resztę, żebyście pomogli mi zjednoczyć Loida z rodziną na górze, a ja... nie mogłem...",shape=box,color=red];
		216 -> 224;
	219 [label="Słyszałem, że masz doświadczenie w wieczności umierania. To o wiele ciekawsze - a jednak, ty znalazłeś sposób, by w końcu stać się obojętnym na wszystko.",shape=box,color=blue];
		219 -> 220;
	220 [label="Chodziło mi o to - jestem bardzo przyzwyczajony do machinacji i intryg, które my, Orokin, prowadzili smy wobec siebie dla zabawy. Tak po prostu zabijaliśmy czas.",shape=box,color=blue];
		220 -> 227;
	221 [label="Z Leonem...",shape=box,color=red];
		221 -> 228;
	222 [label="Z Marią...",shape=box,color=red];
		222 -> 229;
	223 [label="Z tobą...",shape=box,color=red];
		223 -> 230;
	225 [label="+5 Chemistry",color=orange];
		225 -> 232;
	226 [label="+5 Chemistry",color=orange];
		226 -> 233;
	224 [label="Hmm, rozumiem. Mieliśmy umowę, a ty nie wywiązałeś się ze swojej części, a twoja nagroda rozpłynęła się.",shape=box,color=blue];
		224 -> 231;
	227 [label="Ale są granice, których nie przekraczamy. Działania, których nie podejmujemy. Mógłbym mówić o tym szczegółowo, ale nie będę. Podsumuję to po prostu stwierdzeniem, że Albrecht złamał je wszystkie.",shape=box,color=blue];
		227 -> 234;
	228 [label="Naprawdę? Próbowałeś go karmić i podlewać raz dziennie? Niech będzie...",shape=box,color=blue];
		228 -> 235;
	229 [label="I nie udało ci się przekonać tej małej kulki cnót, żeby zeszła się z tobą? Mam nadzieję... że nie łudziłeś się na karierę negocjatora, mój Ponadczasowy Towarzyszu.",shape=box,color=blue];
		229 -> 236;
	230 [label="+5 Chemistry",color=orange];
		230 -> 237;
	232 [label="Hm.",shape=box,color=blue];
		232 -> 239;
	233 [label="HA! To niesamowite! Naprawdę zaskarbiłeś sobie moją uwagę... Więc o czyje serce chodzi? Nie wstydź się, może... uda się nam dojść do porozumienia.",shape=box,color=blue];
		233 -> 240;
		233 -> 241;
		233 -> 242;
	231 [label="Po potwierdzeniu moich podejrzeń nachodzą mnie dwie myśli:",shape=box,color=blue];
		231 -> 238;
	234 [label="Porzucił mnie w tej ohydnej, zapyziałej przeszłości, w bliżej nieokreślonym zadupiu Systemu Origin! Zdajesz sobie sprawę, że w tej zapomnianej przez Pustkę \"Cathédrale\" nie było nawet prądu?! NAWET PRĄDU!",shape=box,color=blue];
		234 -> 243;
	235 [label="Co w nim sprawiło ci taki kłopot? Może dojdziemy do porozumienia?",shape=box,color=blue];
		235 -> 244;
	236 [label="Ale powiedz mi, co w niej sprawiło ci taki kłopot? Może... dojdziemy do porozumienia?",shape=box,color=blue];
		236 -> 245;
	237 [label="HA! To niesamowite! Naprawdę zaskarbiłeś sobie moją uwagę... w jaki sposób? Nie wstydź się, może... uda się nam dojść do porozumienia.",shape=box,color=blue];
		237 -> 246;
