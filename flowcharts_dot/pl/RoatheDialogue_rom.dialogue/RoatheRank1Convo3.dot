		j3651409850 -> j2737619969;
	j12245803 [label="+5 Chemistry",color=orange];
		j12245803 -> j2157518217;
	j866138093 [label="Hmm, rozumiem. Mieliśmy umowę, a ty nie wywiązałeś się ze swojej części, a twoja nagroda rozpłynęła się.",shape=box,color=blue];
		j866138093 -> j4031556818;
	j3850523061 [label="Ale są granice, których nie przekraczamy. Działania, których nie podejmujemy. Mógłbym mówić o tym szczegółowo, ale nie będę. Podsumuję to po prostu stwierdzeniem, że Albrecht złamał je wszystkie.",shape=box,color=blue];
		j3850523061 -> j1463124701;
	j1222699570 [label="Naprawdę? Próbowałeś go karmić i podlewać raz dziennie? Niech będzie...",shape=box,color=blue];
		j1222699570 -> j957644035;
	j254478640 [label="I nie udało ci się przekonać tej małej kulki cnót, żeby zeszła się z tobą? Mam nadzieję... że nie łudziłeś się na karierę negocjatora, mój Ponadczasowy Towarzyszu.",shape=box,color=blue];
		j254478640 -> j2130139260;
	j3396037323 [label="+5 Chemistry",color=orange];
		j3396037323 -> j832948599;
	j2737619969 [label="Hm.",shape=box,color=blue];
		j2737619969 -> j3027628745;
	j2157518217 [label="HA! To niesamowite! Naprawdę zaskarbiłeś sobie moją uwagę... Więc o czyje serce chodzi? Nie wstydź się, może... uda się nam dojść do porozumienia.",shape=box,color=blue];
