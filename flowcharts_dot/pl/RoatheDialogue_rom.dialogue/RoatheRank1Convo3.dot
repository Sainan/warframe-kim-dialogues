	j1391898287 [label="+5 Chemistry",color=orange];
		j1391898287 -> j4291792823;
	j1548710313 [label="Po drugie, ogarnia mnie furia na myśl o tym, że w ostatnim czasie zostałem już oszukany nie raz, a dwukrotnie. Ale ta furia ugina się przed kolejnym uczuciem. Emocją, której do końca nie rozumiem.",shape=box,color=blue];
		j1548710313 -> j4163352813;
	j2004447136 [label="Nie znam szczegółów, bo te wspomnienia zniknęły z mojej głowy, wraz z wieloma innymi, w skutek wymuszonej na mnie transformacji.",shape=box,color=blue];
		j2004447136 -> j3564098693;
	j775402550 [label="Tak! Dokładnie to! Wykorzystując do tego własną krew! Nie zacząłem swoich prac w roku, w którym odeszliśmy, tyle mogę powiedzieć. Na Pustkę, obedrę go ze skóry tymi pazurami, kiedy tylko zobaczę jego dumną mordę -",shape=box,color=blue];
		j775402550 -> j2955262025;
	j3242068217 [label="Zaleciłbym uzbroić się w cierpliwość, ale... nie byłoby w moim stylu sugerować dłuto, kiedy zaraz obok leży kilof laserowy.",shape=box,color=blue];
		j3242068217 -> j1676867118;
	j1062245977 [label="+5 Chemistry",color=orange];
		j1062245977 -> j2373541758;
