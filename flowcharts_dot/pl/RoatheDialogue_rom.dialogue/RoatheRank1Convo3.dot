	351 [label="Update boolean RoatheHelminth1",color=orange];
		351 -> 361;
	352 [label="Palący, przeszywający ból. Jak żaden inny, jaki kiedykolwiek znałem. A moje poprzednie ciało straciło rękę i nogę podczas wojny. Włóczęgo. Byłem pokryty oparzeniami zbyt poważnymi, by się z nich wylizać bez pomocy Kuvy. Poznałem agonię.",shape=box,color=blue];
