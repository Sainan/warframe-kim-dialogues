		341 -> 350;
	342 [label="Miałem rację. Chociaż proces jego tworzenia był... powiedzieć, że pracochłonny i żmudny, to powiedzieć nic! Wykorzystałem własną krew, aby odtworzyć Helmintha metodą prób i błędów!",shape=box,color=blue];
		342 -> 351;
	343 [label="Ale miewam przebłyski. Rozbite fragmenty złotego korytarza. Głos, który rozpoznałem - ale nie twarz. To był Albrecht, ale nie ten, którego znałem.",shape=box,color=blue];
