digraph {
	186 [label="RoatheRank1Convo3 begins.",color=orange];
		186 -> 188;
		186 -> 187;
	188 [label="Czy mogę zapytać, jak się tu znalazłeś? Dokładnie... skąd?",shape=box,color=red];
		188 -> 190;
	187 [label="[Koniec]",shape=box,color=red];
		187 -> 189;
	190 [label="Evaluate expressions on HellStory",color=orange];
