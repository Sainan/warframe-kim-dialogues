		j801915847 -> j2438410637;
	j2216093577 [label="Po pierwsze: jestem pod wrażeniem! Odebrałeś nam wszystkim pamięć, tylko po to, żeby mieć kolejną szansę zawalczyć o jego względy?!",shape=box,color=blue];
		j2216093577 -> j2834667725;
	j2222154932 [label="Po pierwsze: jestem pod wrażeniem! Odebrałeś nam wszystkim pamięć, tylko po to, żeby mieć kolejną szansę zawalczyć o jej względy?!",shape=box,color=blue];
		j2222154932 -> j1545717055;
	j4291792823 [label="Po pierwsze: to takie wspaniałe! Odebrałeś nam wszystkim pamięć, tylko po to, żeby mieć kolejną szansę zawalczyć o moje względy?!",shape=box,color=blue];
		j4291792823 -> j2905929652;
	j4163352813 [label="Zdrada.",shape=box,color=blue];
		j4163352813 -> j244099314;
	j3564098693 [label="Ale miewam przebłyski. Rozbite fragmenty złotego korytarza. Głos, który rozpoznałem - ale nie twarz. To był Albrecht, ale nie ten, którego znałem.",shape=box,color=blue];
		j3564098693 -> j1932787063;
	j2955262025 [label="Daj mi chwilę, abym mógł zapanować nad sobą.",shape=box,color=blue];
		j2955262025 -> j2462175752;
	j1676867118 [label="Po potwierdzeniu moich podejrzeń nachodzą mnie dwie myśli:",shape=box,color=blue];
		j1676867118 -> j378310917;
	j2373541758 [label="Hmm, rozumiem. Szlachetne przedsięwzięcie, szczerze mówiąc. Przedsięwzięcie, którego sam wielokrotnie się podejmowałem. I równie wiele razy poniosłem porażkę.",shape=box,color=blue];
		j2373541758 -> j119508418;
	j2438410637 [label="Zdrada.",shape=box,color=blue];
		j2438410637 -> j4230297627;
	j2834667725 [label="To bardzo w stylu Orokin.",shape=box,color=blue];
		j2834667725 -> j2491799117;
	j1545717055 [label="To bardzo w stylu Orokin.",shape=box,color=blue];
		j1545717055 -> j2276034004;
	j2905929652 [label="To bardzo w stylu Orokin.",shape=box,color=blue];
		j2905929652 -> j3171749909;
	j244099314 [label="Dlaczego?",shape=box,color=blue];
		j244099314 -> j3802562141;
	j1932787063 [label="Palący, przeszywający ból. Jak żaden inny, jaki kiedykolwiek znałem. A moje poprzednie ciało straciło rękę i nogę podczas wojny. Włóczęgo. Byłem pokryty oparzeniami zbyt poważnymi, by się z nich wylizać bez pomocy Kuvy. Poznałem agonię.",shape=box,color=blue];
		j1932787063 -> j3056637502;
	j2462175752 [label="Dziękuję, możemy wrócić do rozmowy.",shape=box,color=blue];
		j2462175752 -> j2405194029;
	j378310917 [label="Zastanawiam się... Ile bitew zacząłbym od nowa i znów wygrał, gdybym miał taką moc?",shape=box,color=blue];
		j378310917 -> j2692065047;
