	5739 [label="Dla ciebie będę udawać przed tymi fanatykami, że nic nie wiem...",shape=box,color=blue];
		5739 -> 5738;
	304 [label="Szczerze nie wiem, czy mogę cię potępiać. Ile bitew zacząłbym od nowa i znów wygrał, gdybym miał taką moc?",shape=box,color=blue];
		304 -> 312;
	305 [label="Zastanawiam się... Ile bitew zacząłbym od nowa i znów wygrał, gdybym miał taką moc?",shape=box,color=blue];
		305 -> 313;
	306 [label="Ile umysłów bym zbezcześcił, gdybym twój dar należał do mnie?",shape=box,color=blue];
		306 -> 314;
	303 [label="I co ważniejsze – dopilnuję, aby tym razem udało ci się osiągnąć cel zjednoczenia sługi Albrechta i jego rodziny, bez względu na wszystko.",shape=box,color=blue];
		303 -> 311;
	307 [label="Albrecht przyprowadził mnie do ich czasów i do ich głupiej katedry. I oddał mnie pod ich \"opiekę\".",shape=box,color=blue];
		307 -> 315;
	308 [label="Miałem rację. Chociaż proces jego tworzenia był... pracochłonny i żmudny.",shape=box,color=blue];
		308 -> 316;
	309 [label="Zdrada.",shape=box,color=blue];
		309 -> 317;
	310 [label="Po drugie, ogarnia mnie furia na myśl o tym, że w ostatnim czasie zostałem już oszukany nie raz, a dwukrotnie. Ale ta furia ugina się przed kolejnym uczuciem. Emocją, której do końca nie rozumiem.",shape=box,color=blue];
