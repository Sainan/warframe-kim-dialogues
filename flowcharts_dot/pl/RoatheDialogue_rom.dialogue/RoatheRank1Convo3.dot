	j4171183944 [label="Dlaczego zwracasz się do mnie, kiedy już znasz odpowiedź?",shape=box,color=blue];
		j4171183944 -> j2887197017;
		j4171183944 -> j3561837717;
	j688761022 [label="Wierz lub nie, ale wiem jak to jest.",shape=box,color=red];
		j688761022 -> j3624031239;
	j3383658593 [label="Jestem tego świadom. Ale proszę, kontynuuj.",shape=box,color=red];
		j3383658593 -> j166668228;
	j1834085449 [label="I to jest fascynujące... zawaliłeś ze mną, czy zawaliłeś z Leonem i Marią?",shape=box,color=blue];
		j1834085449 -> j3914012250;
		j1834085449 -> j2297146092;
		j1834085449 -> j1879335753;
	j3205354893 [label="Widzisz, jest ta cała sprawa... o tym, dlaczego przyjąłeś serum, a ja... powiedziałem złe rzeczy w niewłaściwych chwilach.",shape=box,color=red];
		j3205354893 -> j3651409850;
	j3636854772 [label="Próbuję... zdobyć serce jednego z was... i naprawdę... zawaliłem sprawę...",shape=box,color=red];
		j3636854772 -> j12245803;
	j1710053854 [label="Próbuję przekonać ciebie i resztę, żebyście pomogli mi zjednoczyć Loida z rodziną na górze, a ja... nie mogłem...",shape=box,color=red];
		j1710053854 -> j866138093;
	j3624031239 [label="Słyszałem, że masz doświadczenie w wieczności umierania. To o wiele ciekawsze - a jednak, ty znalazłeś sposób, by w końcu stać się obojętnym na wszystko.",shape=box,color=blue];
		j3624031239 -> j166668228;
	j166668228 [label="Chodziło mi o to - jestem bardzo przyzwyczajony do machinacji i intryg, które my, Orokin, prowadzili smy wobec siebie dla zabawy. Tak po prostu zabijaliśmy czas.",shape=box,color=blue];
		j166668228 -> j3850523061;
	j3914012250 [label="Z Leonem...",shape=box,color=red];
		j3914012250 -> j1222699570;
	j2297146092 [label="Z Marią...",shape=box,color=red];
