		282 -> 290;
	279 [label="Dlaczego?",shape=box,color=blue];
		279 -> 287;
	283 [label="Palący, przeszywający ból. Jak żaden inny, jaki kiedykolwiek znałem. A moje poprzednie ciało straciło rękę i nogę podczas wojny. Włóczęgo. Byłem pokryty oparzeniami zbyt poważnymi, by się z nich wylizać bez pomocy Kuvy. Poznałem agonię.",shape=box,color=blue];
		283 -> 291;
	284 [label="Dziękuję, możemy wrócić do rozmowy.",shape=box,color=blue];
		284 -> 292;
	285 [label="Zastanawiam się... Ile bitew zacząłbym od nowa i znów wygrał, gdybym miał taką moc?",shape=box,color=blue];
		285 -> 293;
	286 [label="Po potwierdzeniu moich podejrzeń nachodzą mnie dwie myśli:",shape=box,color=blue];
		286 -> 294;
	5741 [label="Dlaczego?",shape=box,color=blue];
		5741 -> 5742;
	288 [label="Po drugie: Jak bardzo nieudolny musisz być? Jestem pewien, że wystarczy go zaledwie podlewać i nakarmić raz dziennie, żeby zaskarbić sobie wieczną miłość i uwielbienie Księdza.",shape=box,color=blue];
		288 -> 296;
	289 [label="Po drugie: Próbowałeś utykać przed nią? Udawać jakąś chorobę? Spojrzeć na nią pociągająco? Powiedzieć, że ładnie wygląda? Nie wygląda na trudną do oczarowania.",shape=box,color=blue];
		289 -> 297;
	290 [label="Po potwierdzeniu moich podejrzeń nachodzą mnie dwie myśli:",shape=box,color=blue];
		290 -> 298;
	287 [label="Ale to rozmowa na inny dzień. Mam dla ciebie propozycję. Wierzę, że zainteresuje cię ona o wiele bardziej.",shape=box,color=blue];
		287 -> 295;
	291 [label="Moje ciało było rozrywane na strzępy i budowane na nowo. Nie wybrałem tego. Nie wiem, czy w przypadku innych proces wyglądał tak samo.",shape=box,color=blue];
		291 -> 299;
	292 [label="Wykorzystałem własną krew, aby metodą prób i błędów odtworzyć Helmintha. Nie było to łatwe zadanie, nie miałem dostępu do żadnego sprzętu Orokin. Żadnego sprzętu, z wyjątkiem tego, co mogłem ukraść z...",shape=box,color=blue];
		292 -> 300;
	293 [label="Ile umysłów bym zbezcześcił, gdybym twój dar należał do mnie?",shape=box,color=blue];
		293 -> 301;
	294 [label="Zastanawiam się... Ile bitew zacząłbym od nowa i znów wygrał, gdybym miał taką moc?",shape=box,color=blue];
		294 -> 302;
	5742 [label="Ale to rozmowa na inny dzień. Mam dla ciebie propozycję. Wierzę, że zainteresuje cię ona o wiele bardziej.",shape=box,color=blue];
		5742 -> 5739;
	296 [label="Nie zrozum mnie źle! Jestem pod wrażeniem twojej przebiegłości. ",shape=box,color=blue];
		296 -> 304;
	297 [label="Po trzecie: siedzę tutaj i nagle ogarnia mnie świadomość, że moje podejrzenia się potwierdziły: ",shape=box,color=blue];
		297 -> 305;
	298 [label="Zastanawiam się... Ile bitew zacząłbym od nowa i znów wygrał, gdybym miał taką moc?",shape=box,color=blue];
		298 -> 306;
	295 [label="Będę udawać przed tymi fanatykami, że nic nie wiem, dla ciebie...",shape=box,color=blue];
		295 -> 303;
	299 [label="Pamiętam zimne schody, na których zostałem porzucony. Z opowieści Marii i Leona wiem, że były to schody katedry.",shape=box,color=blue];
		299 -> 307;
	300 [label="Nie były one godne nazwania ich \"prymitywnymi\" szpitalami. Albrecht wykorzystał Helmintha, aby przenieść nas do przeszłości. Jak zdołał wyrosnąć w tamtych czasach, nie wiem, bo był już na miejscu, kiedy tu dotarliśmy. Potem zwiądł i umarł - myślałem, że inny mógłby zostać użyty w drodze powrotnej.",shape=box,color=blue];
		300 -> 308;
	301 [label="Po drugie, ogarnia mnie furia na myśl o tym, że w ostatnim czasie zostałem już oszukany nie raz, a dwukrotnie. Ale ta furia ugina się przed kolejnym uczuciem. Emocją, której do końca nie rozumiem.",shape=box,color=blue];
		301 -> 309;
	302 [label="Ile umysłów bym zbezcześcił, gdybym twój dar należał do mnie?",shape=box,color=blue];
