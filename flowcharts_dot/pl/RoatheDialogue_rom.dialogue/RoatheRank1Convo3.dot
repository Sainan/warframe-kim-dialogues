		j2130139260 -> j256724246;
	j832948599 [label="HA! To niesamowite! Naprawdę zaskarbiłeś sobie moją uwagę... w jaki sposób? Nie wstydź się, może... uda się nam dojść do porozumienia.",shape=box,color=blue];
