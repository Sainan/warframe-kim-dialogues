	"Chat ends." [color=orange];
	j3620621293 [label="Dlaczego mam przeczucie, że już dobrze znasz odpowiedź na to pytanie, mój Uzurpatorze? W jakie gierki pogrywasz, pytając mnie o takie błahostki, kiedy mój umysł jest dla ciebie jak otwarta księga?",shape=box,color=blue];
		j3620621293 -> j4011668186;
	j3888292014 [label="Ależ oczywiście! To idealna okazja, abym mógł rozwodzić się nad własnym geniuszem i ponarzekać na niespotykaną zdolność Albrechta w byciu niezwykle pochopnym, a zarazem tchórzliwym w tej samej chwili!",shape=box,color=blue];
		j3888292014 -> j4070589250;
	j4011668186 [label="Check boolean RoatheKnowsReset",color=orange];
		j4011668186 -> j3148690503 [label=true,color=green];
		j4011668186 -> j2618562490 [label=false,color=brown];
	j4070589250 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4070589250 -> j530416096 [label="x >= 1",color=purple];
		j4070589250 -> j999377066 [label="x <= 0",color=purple];
		j4070589250 -> j999377066 [label="false",color=purple];
	j3148690503 [label="Jesteś równie podły co sam Albrecht, mieszasz w głowach wszystkich w swoim otoczeniu - są dla ciebie jak zabawki! Więc powiedz mi, po co pytać, skoro już znasz odpowiedzi, hmm?",shape=box,color=blue];
		j3148690503 -> j2887197017;
		j3148690503 -> j3561837717;
	j2618562490 [label="Powiedz mi, czy dobrze myślę, że znasz już wszystkie odpowiedzi, których szukasz? Już wiesz, jak powróciłem tu w towarzystwie tych fanatyków i skąd dokładnie pochodzimy. Zapewne wiesz też wiele więcej, czyż nie?",shape=box,color=blue];
		j2618562490 -> j1857518670;
		j2618562490 -> j683130741;
	j530416096 [label="Rozumiem, że Albrecht nie umieścił cię tam z własnej woli.",shape=box,color=red];
		j530416096 -> j2409370115;
	j999377066 [label="Ach, więc nie trafiłeś tam z własnej woli.",shape=box,color=red];
		j999377066 -> j2409370115;
	j2887197017 [label="Próbuję pokierować was wszystkich przez ten proces, a ostatnim razem totalnie zawaliłem. Próbuję więc \"od nowa\".",shape=box,color=red];
		j2887197017 -> j2491995991;
	j3561837717 [label="Naprawdę nie wiem, jak to wyjaśnić. Nie prosiłem o zdolność odbierania wam wspomnień, ale staram się wykorzystać tę zdolność najlepiej, jak potrafię.",shape=box,color=red];
		j3561837717 -> j1345791751;
	j1857518670 [label="Nie, nie wiem.",shape=box,color=red];
		j1857518670 -> j539750526;
	j683130741 [label="Muszę przyznać, że tak.",shape=box,color=red];
		j683130741 -> j2698916560;
	j2409370115 [label="Nie, w żadnym razie. Musisz zrozumieć jedno o Orokin: Graliśmy – no cóż… dokładniej, często graliśmy ze sobą w gry. Gry wszelkiego rodzaju. Polityczne, psychologiczne, seksualne. Nie miało to znaczenia.",shape=box,color=blue];
		j2409370115 -> j4050178151;
	j2491995991 [label="+5 Chemistry",color=orange];
		j2491995991 -> j2046687752;
	j1345791751 [label="Jak widać idzie ci to raczej słabo, mój Ponadczasowy Towarzyszu. Co starasz się osiągnąć, czego nie zdołałeś zdobyć wcześniej?",shape=box,color=blue];
		j1345791751 -> j4269406562;
	j539750526 [label="Ha. Teraz wiem, że jesteś nie tylko kłamcą, ale i złodziejem wspomnień, Uzurpatorze.",shape=box,color=blue];
		j539750526 -> "Chat ends.";
	j2698916560 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j2698916560 -> j4171183944;
	j4050178151 [label="Dzięki Kuvie i Teatrowi Yuvan jesteśmy fundamentalnie i funkcjonalnie nieśmiertelni. Zdołasz sobie wyobrazić, jakie jest to męczące?",shape=box,color=blue];
		j4050178151 -> j688761022;
		j4050178151 -> j3383658593;
