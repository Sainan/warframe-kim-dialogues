		266 -> 274;
	262 [label="Po drugie, ogarnia mnie furia na myśl o tym, że w ostatnim czasie zostałem już oszukany nie raz, a dwukrotnie. Ale ta furia ugina się przed kolejnym uczuciem. Emocją, której do końca nie rozumiem.",shape=box,color=blue];
		262 -> 271;
	267 [label="Nie znam szczegółów, bo te wspomnienia zniknęły z mojej głowy, wraz z wieloma innymi, w skutek wymuszonej na mnie transformacji.",shape=box,color=blue];
		267 -> 275;
	268 [label="Tak! Dokładnie to! Wykorzystując do tego własną krew! Nie zacząłem swoich prac w roku, w którym odeszliśmy, tyle mogę powiedzieć. Na Pustkę, obedrę go ze skóry tymi pazurami, kiedy tylko zobaczę jego dumną mordę -",shape=box,color=blue];
		268 -> 276;
	269 [label="Zaleciłbym uzbroić się w cierpliwość, ale... nie byłoby w moim stylu sugerować dłuto, kiedy zaraz obok leży kilof laserowy.",shape=box,color=blue];
		269 -> 277;
	270 [label="+5 Chemistry",color=orange];
		270 -> 278;
	5737 [label="Po drugie, ogarnia mnie furia na myśl o tym, że w ostatnim czasie zostałem już oszukany nie raz, a dwukrotnie. Ale ta furia ugina się przed kolejnym uczuciem. Emocją, której do końca nie rozumiem.",shape=box,color=blue];
		5737 -> 5740;
	272 [label="Po pierwsze: jestem pod wrażeniem! Odebrałeś nam wszystkim pamięć, tylko po to, żeby mieć kolejną szansę zawalczyć o jego względy?!",shape=box,color=blue];
		272 -> 280;
	273 [label="Po pierwsze: jestem pod wrażeniem! Odebrałeś nam wszystkim pamięć, tylko po to, żeby mieć kolejną szansę zawalczyć o jej względy?!",shape=box,color=blue];
		273 -> 281;
	274 [label="Po pierwsze: to takie wspaniałe! Odebrałeś nam wszystkim pamięć, tylko po to, żeby mieć kolejną szansę zawalczyć o moje względy?!",shape=box,color=blue];
		274 -> 282;
	271 [label="Zdrada.",shape=box,color=blue];
		271 -> 279;
	275 [label="Ale miewam przebłyski. Rozbite fragmenty złotego korytarza. Głos, który rozpoznałem - ale nie twarz. To był Albrecht, ale nie ten, którego znałem.",shape=box,color=blue];
		275 -> 283;
	276 [label="Daj mi chwilę, abym mógł zapanować nad sobą.",shape=box,color=blue];
		276 -> 284;
	277 [label="Po potwierdzeniu moich podejrzeń nachodzą mnie dwie myśli:",shape=box,color=blue];
		277 -> 285;
	278 [label="Hmm, rozumiem. Szlachetne przedsięwzięcie, szczerze mówiąc. Przedsięwzięcie, którego sam wielokrotnie się podejmowałem. I równie wiele razy poniosłem porażkę.",shape=box,color=blue];
		278 -> 286;
