	j817226203 [label="VM: SZTANDAR",shape=box,color=blue];
		j817226203 -> j3845219694;
	j3845219694 [label="Transkrypcja: Nic tak nie oddaje pompatyczności, z jaką my, istoty żywe, traktujemy rzeź wojny, jak chorążowie.",shape=box,color=blue];
		j3845219694 -> j2506987636;
	j2506987636 [label="Those who must be protected at all costs - and followed without question.",shape=box,color=blue];
		j2506987636 -> j466820280;
	j466820280 [label="And who may be threatened, I might add, to follow orders that no sane soldier would ever complete, lest they somehow come to suffer some more terrible fate. ",shape=box,color=blue];
		j466820280 -> j3978125306;
	j3978125306 [label="Choć to śmieszne.",shape=box,color=blue];
		j3978125306 -> j525922818;
	j525922818 [label="It was always their forms my eye was drawn to amongst the rest, though their mangled bodies were no different from any other. ",shape=box,color=blue];
		j525922818 -> j2303998949;
	j2303998949 [label="Był to zawsze sztandar, który wciąż nosili, lśniący złotem Orokin i pokryty cętkowaną purpurą.",shape=box,color=blue];
		j2303998949 -> j3932525805;
	j3932525805 [label="Zawsze upewniałem się, że stał dumnie na polu bitwy, zanim odszedłem.",shape=box,color=blue];
		j3932525805 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}