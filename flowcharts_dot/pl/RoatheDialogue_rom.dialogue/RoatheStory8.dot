	j2915887449 [label="VM: SZTANDAR",shape=box,color=blue];
		j2915887449 -> j3002970172;
	j3002970172 [label="Transkrypcja: Nic tak nie oddaje pompatyczności, z jaką my, istoty żywe, traktujemy rzeź wojny, jak chorążowie.",shape=box,color=blue];
		j3002970172 -> j371897244;
	j371897244 [label="Ci, których trzeba chronić za wszelką cenę – i słuchać bez pytania.",shape=box,color=blue];
		j371897244 -> j364255539;
	j364255539 [label="I którzy, dodam, mogą być zagrożeni, by wykonywać rozkazy, których żaden rozsądny żołnierz nigdy by nie wykonał, bo inaczej spotka ich jeszcze straszliwszy los. ",shape=box,color=blue];
		j364255539 -> j4044755714;
	j4044755714 [label="Choć to śmieszne.",shape=box,color=blue];
		j4044755714 -> j3531820388;
	j3531820388 [label="To zawsze ich sylwetki przyciągały mój wzrok pośród reszty, choć ich zmasakrowane ciała niczym się nie różniły od innych. ",shape=box,color=blue];
		j3531820388 -> j2303998949;
	j2303998949 [label="Był to zawsze sztandar, który wciąż nosili, lśniący złotem Orokin i pokryty cętkowaną purpurą.",shape=box,color=blue];
		j2303998949 -> j3932525805;
	j3932525805 [label="Zawsze upewniałem się, że stał dumnie na polu bitwy, zanim odszedłem.",shape=box,color=blue];
		j3932525805 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
