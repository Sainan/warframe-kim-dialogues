	j4003416036 [label="Transkrypcja: Po pierwszej inwazji Świadomych na System i katastrofalnej odpowiedzi Orokin zapadła dziwna cisza.",shape=box,color=blue];
		j4003416036 -> j1593010072;
	j1593010072 [label="Nie mieliśmy żadnych wieści od naszych ludzi uwięzionych na Tau i nie mieliśmy pojęcia, czy ich sygnały są zagłuszane, czy też ich źródła zostały całkiem unicestwione.",shape=box,color=blue];
		j1593010072 -> j1728996215;
	j1728996215 [label="Zostałem poproszony o opinię. Jako strateg, oczekiwano ode mnie zrozumienia wroga.",shape=box,color=blue];
		j1728996215 -> j1708292725;
	j1708292725 [label="Świadomi mogli zniszczyć końcowy Terminal Kolei Solarnej nad Tau w każdej chwili, a mimo to Kolej nadal działała.",shape=box,color=blue];
		j1708292725 -> j831771700;
	j831771700 [label="Dlaczego? Co zyskali, zostawiając bramę otwartą?",shape=box,color=blue];
