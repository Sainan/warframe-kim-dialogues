	j2680927288 [label="Transkrypcja: Po pierwszej inwazji Świadomych na System i katastrofalnej odpowiedzi Orokin zapadła dziwna cisza.",shape=box,color=blue];
		j2680927288 -> j1292805587;
	j1292805587 [label="Nie mieliśmy żadnych wieści od naszych ludzi uwięzionych na Tau i nie mieliśmy pojęcia, czy ich sygnały są zagłuszane, czy też ich źródła zostały całkiem unicestwione.",shape=box,color=blue];
		j1292805587 -> j4170917670;
	j4170917670 [label="Zostałem poproszony o opinię. Jako strateg, oczekiwano ode mnie zrozumienia wroga.",shape=box,color=blue];
		j4170917670 -> j1817174158;
	j1817174158 [label="Świadomi mogli zniszczyć końcowy Terminal Kolei Solarnej nad Tau w każdej chwili, a mimo to Kolej nadal działała.",shape=box,color=blue];
		j1817174158 -> j3961779914;
	j3961779914 [label="Why? What did they gain from leaving the gate open?",shape=box,color=blue];
		j3961779914 -> j3273990187;
	j3273990187 [label="Were they united in their aggression, or did some yet hope for peaceful coexistence?",shape=box,color=blue];
