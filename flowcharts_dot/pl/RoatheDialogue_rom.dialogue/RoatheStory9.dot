	j2453509370 [label="VM: DOWÓDCY",shape=box,color=blue];
		j2453509370 -> j3754251611;
	j3754251611 [label="Transkrypcja: Teraz ich sobie przypominam. Gromady roześmianej młodzieży Orokin.",shape=box,color=blue];
		j3754251611 -> j968100550;
	j968100550 [label="Szlachta odziana w niesplamione jeszcze szaty dowódcze.",shape=box,color=blue];
		j968100550 -> j1310130777;
	j1310130777 [label="Przyjaciele z dzieciństwa, teraz dowodzący legionami Daks, Grineer, komórkami zerowej materii, samoreplikującymi się karcynatorami, prymitywnymi bio-dronowymi pająkami-ostrzami, kanistrami z nisko zaawansowanymi technologicznie oddziałami.",shape=box,color=blue];
		j1310130777 -> j741162309;
	j741162309 [label="Złoci chłopcy i dziewczęta z drapieżnymi diabłami na każde skinienie.",shape=box,color=blue];
		j741162309 -> j2778274766;
	j2778274766 [label="Ich arogancja sączy się do mojego umysłu. Pili i śpiewali, przechwalając się nadchodzącymi czasami.",shape=box,color=blue];
		j2778274766 -> j2771348907;
	j2771348907 [label="Zapracują na swoją sławę. Zaszczycą swoje rodziny.",shape=box,color=blue];
		j2771348907 -> j3107461725;
	j3107461725 [label="Tak wielu z nich poległo. Nawet ich ciała nie zostały zwrócone.",shape=box,color=blue];
		j3107461725 -> j216073937;
	j216073937 [label="Aby uniemożliwić wrogowi wykradzenie naszych sekretów, zostali naszpikowani Kuvą, by upłynnić się po śmierci.",shape=box,color=blue];
		j216073937 -> j1253688326;
	j1253688326 [label="Nadzieja pokolenia zmieniła się w oleistą kałużę, przez którą kroczyły legiony Grineer.",shape=box,color=blue];
		j1253688326 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}