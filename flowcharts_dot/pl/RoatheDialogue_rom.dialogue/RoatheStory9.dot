	j654374789 [label="VM: DOWÓDCY",shape=box,color=blue];
		j654374789 -> j3853093233;
	j3853093233 [label="Transkrypcja: Teraz ich sobie przypominam. Gromady roześmianej młodzieży Orokin.",shape=box,color=blue];
		j3853093233 -> j844570216;
	j844570216 [label="Szlachta odziana w niesplamione jeszcze szaty dowódcze.",shape=box,color=blue];
		j844570216 -> j2559140942;
	j2559140942 [label="Przyjaciele z dzieciństwa, teraz dowodzący legionami Daks, Grineer, komórkami zerowej materii, samoreplikującymi się karcynatorami, prymitywnymi bio-dronowymi pająkami-ostrzami, kanistrami z nisko zaawansowanymi technologicznie oddziałami.",shape=box,color=blue];
		j2559140942 -> j2053183997;
	j2053183997 [label="Złoci chłopcy i dziewczęta z drapieżnymi diabłami na każde skinienie.",shape=box,color=blue];
		j2053183997 -> j1029012419;
	j1029012419 [label="Ich arogancja sączy się do mojego umysłu. Pili i śpiewali, przechwalając się nadchodzącymi czasami.",shape=box,color=blue];
		j1029012419 -> j1979332782;
	j1979332782 [label="They would make names for themselves. Raise their families high in honor.",shape=box,color=blue];
		j1979332782 -> j837584989;
	j837584989 [label="So many of them fell. Not even their bodies were returned.",shape=box,color=blue];
		j837584989 -> j3620218553;
	j3620218553 [label="To prevent the enemy from gleaning our secrets, they were Kuva-jolted to liquefy upon death.",shape=box,color=blue];
		j3620218553 -> j4009808197;
	j4009808197 [label="The hope of a generation turned to an oily puddle, sloshed through by Grineer boots.",shape=box,color=blue];
		j4009808197 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}