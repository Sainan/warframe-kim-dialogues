	2208 [label="Transkrypcja: Teraz ich sobie przypominam. Gromady roześmianej młodzieży Orokin.",shape=box,color=blue];
		2208 -> 2212;
	2212 [label="Szlachta odziana w niesplamione jeszcze szaty dowódcze.",shape=box,color=blue];
		2212 -> 2205;
	2205 [label="Przyjaciele z dzieciństwa, teraz dowodzący legionami Daks, Grineer, komórkami zerowej materii, samoreplikującymi się karcynatorami, prymitywnymi bio-dronowymi pająkami-ostrzami, kanistrami z nisko zaawansowanymi technologicznie oddziałami.",shape=box,color=blue];
		2205 -> 2213;
	2213 [label="Złoci chłopcy i dziewczęta z drapieżnymi diabłami na każde skinienie.",shape=box,color=blue];
		2213 -> 2215;
	2215 [label="Ich arogancja sączy się do mojego umysłu. Pili i śpiewali, przechwalając się nadchodzącymi czasami.",shape=box,color=blue];
		2215 -> 5696;
	5696 [label="They would make names for themselves. Raise their families high in honor.",shape=box,color=blue];
		5696 -> 5697;
	5697 [label="So many of them fell. Not even their bodies were returned.",shape=box,color=blue];
		5697 -> 5698;
	5698 [label="To prevent the enemy from gleaning our secrets, they were Kuva-jolted to liquefy upon death.",shape=box,color=blue];
		5698 -> 5699;
	5699 [label="The hope of a generation turned to an oily puddle, sloshed through by Grineer boots.",shape=box,color=blue];
