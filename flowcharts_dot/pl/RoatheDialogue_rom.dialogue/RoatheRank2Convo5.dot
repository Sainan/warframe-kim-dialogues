	"Chat ends." [color=orange];
	j2159694004 [label="Jak wiele przeszły Roathe opowiedział ci o swoich przygodach z Egzekutorką Nitokh? Ech, próba pogodzenia tego wszystkiego, mój poprzednik powierzył ci tak osobiste informacje... tylko po to, żebyś odebrał mi te wspomnienia?",shape=box,color=blue];
		j2159694004 -> j512328253;
	j1918363296 [label="Evaluate expressions on HellStory counter",color=orange];
		j1918363296 -> j1814737385 [label="x >= 1",color=purple];
		j1918363296 -> "Chat ends." [label="x <= 1",color=purple];
		j1918363296 -> "Chat ends." [label="false",color=purple];
	j512328253 [label="To paląca rana w moim sercu. Wiedzieć, że mogłem ci powiedzieć o wszystkim, odsłonić przed tobą swoje najgłębsze tajemnice... a ty zacząłeś wszystko od nowa. Jakbym był dla ciebie tylko zabawką.",shape=box,color=blue];
		j512328253 -> j4182077301;
	j1814737385 [label="Słyszałeś już o Egzekutorce Nitokh i moich... przygodach z nią. Musisz zrozumieć, że nie całe Imperium Orokin było przegniłe złem.",shape=box,color=blue];
		j1814737385 -> j2680644274;
	j4182077301 [label="Ale tak chyba jest sprawiedliwie. Właśnie tak my, Orokin, traktowaliśmy ludzkość, czyż nie? Teatr Yuvan? Obnoszenie się pięknym ciałem i wybieranie sobie nowej formy, nękanie siebie nawzajem gierkami dla własnej zabawy...",shape=box,color=blue];
		j4182077301 -> j2769358048;
	j2680644274 [label="Serce pęka mi na myśl, że zostanie zapamiętane tylko przez zniszczenie i zepsucie. Tak, było tego wiele, nie mogę temu przeczyć. ",shape=box,color=blue];
		j2680644274 -> j3248639067;
	j2769358048 [label="Nienawidzę tego. Tak bardzo tego nienawidzę.",shape=box,color=blue];
		j2769358048 -> j2756341554;
		j2769358048 -> j3155339811;
		j2769358048 -> j386906797;
	j3248639067 [label="Ale było też zdolne tworzyć piękno. Radość. Miłość. Rozwój naukowy i artystyczny. Spójrz, do czego byliśmy zdolni! ",shape=box,color=blue];
		j3248639067 -> j145120027;
	j2756341554 [label="Jest mi przykro i nie chciałem cię zranić, ale jest to dla ciebie lekcja, jak wyglądało życie po drugiej stronie Imperium Orokin.",shape=box,color=red];
		j2756341554 -> j138722341;
	j3155339811 [label="Nie chciałem cię tak zranić. Nie powinieneś przepraszać za to, jak działało społeczeństwo Orokin – nie ty je stworzyłeś. Próbowałeś je tylko naprawić.",shape=box,color=red];
		j3155339811 -> j998023095;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j145120027 [label="Więc kiedy Nitokh przyzwała mnie do swojego boku i powiedziała, że chce wymordować wszystkich Orokin? Natychmiast się zgodziłem. Chciałem odciąć głowę tego jadowitego węża. Chciałem zastąpić ją czymś łagodniejszym. Bardziej dobrodusznym władcą.",shape=box,color=blue];
		j145120027 -> j3620158597;
		j145120027 -> j3838128935;
		j145120027 -> j386906797;
	j138722341 [label="Add 3 to Thermostat counter",color=orange];
		j138722341 -> j3680860377;
	j998023095 [label="Add -3 to Thermostat counter",color=orange];
		j998023095 -> j3053190029;
	j3620158597 [label="Masz na myśli, że chciałeś zająć miejsce Imperatorów i Egzekutorów.",shape=box,color=red];
		j3620158597 -> j2965161204;
	j3838128935 [label="I kim byłby ten nowy władca?",shape=box,color=red];
		j3838128935 -> j1375717193;
	j3680860377 [label="Imperium Orokin nie było całkiem przegniłe złem. Serce pęka mi na myśl, że zostanie zapamiętane tylko przez zniszczenie i zepsucie. Tak, było tego wiele, nie mogę temu przeczyć. ",shape=box,color=blue];
		j3680860377 -> j1825940711;
	j3053190029 [label="Gdyby tylko inni byli w stanie to dostrzec. Gdyby tylko Nitokh była w stanie to zrozumieć. ",shape=box,color=blue];
		j3053190029 -> j2982309562;
	j2965161204 [label="Ależ tak, oczywiście!",shape=box,color=blue];
		j2965161204 -> j3630146517;
	j1375717193 [label="Byłbym to ja, rzecz jasna.",shape=box,color=blue];
		j1375717193 -> j3630146517;
	j1825940711 [label="Ale było też zdolne tworzyć piękno. Radość. Miłość. Rozwój naukowy i artystyczny. Spójrz, do czego byliśmy zdolni! ",shape=box,color=blue];
		j1825940711 -> j1165715721;
	j2982309562 [label="Imperium Orokin nie było całkiem przegniłe złem. Serce pęka mi na myśl, że zostanie zapamiętane tylko przez zniszczenie i zepsucie. Tak, było tego wiele, nie mogę temu przeczyć.",shape=box,color=blue];
		j2982309562 -> j1825940711;
	j3630146517 [label="Zadbałbym o to, żeby wszyscy Egzekutorzy i Imperatorzy zostali… odsunięci od władzy, a ja przejąłbym ich obowiązki jako Przejściowy Egzekutor do czasu wprowadzenia nowego systemu.",shape=box,color=blue];
		j3630146517 -> j1248566461;
	j1165715721 [label="Więc kiedy Nitokh przyzwała mnie do swojego boku i powiedziała, że chce wymordować wszystkich Orokin? Natychmiast się zgodziłem. Chciałem odciąć głowę tego jadowitego węża. Chciałem zastąpić ją czymś łagodniejszym. Bardziej dobrodusznym władcą.",shape=box,color=blue];
		j1165715721 -> j2122583300;
		j1165715721 -> j1914520730;
	j1248566461 [label="Ile by to zajęło, kto wie, ale byłoby to lepsze niż to, co nastąpiło po Wielkiej Wojnie, prawda?",shape=box,color=blue];
		j1248566461 -> j1091927499;
		j1248566461 -> j1410798873;
		j1248566461 -> j930364321;
	j2122583300 [label="Masz na myśli, że chciałeś zająć miejsce Imperatorów i Egzekutorów.",shape=box,color=red];
		j2122583300 -> j4148430643;
	j1914520730 [label="I kim byłby ten nowy władca?",shape=box,color=red];
		j1914520730 -> j4087791447;
	j1091927499 [label="Wielka Wojna?",shape=box,color=red];
		j1091927499 -> j3478376292;
	j1410798873 [label="Bądź ze sobą szczery, czy naprawdę oddałbyś władzę?",shape=box,color=red];
		j1410798873 -> j3440974106;
	j930364321 [label="Wątpię, że oddałbyś władzę, Roathe.",shape=box,color=red];
		j930364321 -> j2310198395;
	j4148430643 [label="Ależ tak, oczywiście! I nie udawaj, że wcześniej tego nie słyszałeś. Jestem pewien, że słyszałeś ",shape=box,color=blue];
		j4148430643 -> j3354098665;
	j4087791447 [label="Byłbym to ja, rzecz jasna. I nie udawaj, że wcześniej tego nie słyszałeś. Jestem pewien, że słyszałeś.",shape=box,color=blue];
		j4087791447 -> j3354098665;
	j3478376292 [label="Ty nazywasz to \"Starą Wojną\". Dla mnie nie jest \"stara\", w mojej pamięci miała miejsce ledwie kilka lat temu.",shape=box,color=blue];
		j3478376292 -> j3537301931;
	j3440974106 [label="Hmm, nie wiem. Nie ma to teraz znaczenia, prawda? Ale wtedy byłem przekonany, że tak bym postąpił.",shape=box,color=blue];
		j3440974106 -> j2537367210;
	j2310198395 [label="+5 Chemistry",color=orange];
		j2310198395 -> j1708319088;
	j3354098665 [label="Zadbałbym o to, żeby wszyscy Egzekutorzy i Imperatorzy zostali… odsunięci od władzy, a ja przejąłbym ich obowiązki jako Przejściowy Egzekutor do czasu wprowadzenia nowego systemu.",shape=box,color=blue];
		j3354098665 -> j150669954;
	j3537301931 [label="Śmieszna sprawa, te podróże w czasie.",shape=box,color=blue];
		j3537301931 -> j1368618682;
	j2537367210 [label="Tak bardzo chciałem powrócić, aż zrozumiałem, że... mój lud nie żyje. Zostałbym stracony razem z nimi wszystkimi.",shape=box,color=blue];
		j2537367210 -> j1858884118;
	j1708319088 [label="Zamilcz.",shape=box,color=blue];
		j1708319088 -> j2933080558;
	j150669954 [label="Ile by to zajęło, kto wie, ale byłoby to lepsze niż to, co nastąpiło po Wielkiej Wojnie, prawda?",shape=box,color=blue];
		j150669954 -> j1410798873;
		j150669954 -> j930364321;
		j150669954 -> j1091927499;
	j1368618682 [label="Kilka lat dla mnie, a w \"rzeczywistości\" minęły tysiące – Imperium upadło i ludzie odeszli. ",shape=box,color=blue];
		j1368618682 -> j1877821045;
	j1858884118 [label="Tenno wyrżnęliby mnie jak całą resztę w Noc Bębnów Naga. Prawdopodobnie zginąłbym, próbując uratować życie Nitokh.",shape=box,color=blue];
		j1858884118 -> j3509471054;
	j2933080558 [label="Wtedy byłem całkowicie przekonany, że tak. Ale teraz to już nie ma znaczenia, prawda?",shape=box,color=blue];
		j2933080558 -> j2537367210;
	j1877821045 [label="Uświadomiłem sobie, że nie ma znaczenia, czy zrzekłbym się władzy, czy nie, choć kiedyś byłem przekonany, że bym to zrobił.",shape=box,color=blue];
		j1877821045 -> j1858884118;
	j3509471054 [label="Ciekawe, jaki los ją spotkał? Archiwa nie wspominają jej imienia... wszystkie okropności popełnione w jej imieniu, śmierć, tragedie... i mogę być jedyną osobą, która o nich wie.",shape=box,color=blue];
		j3509471054 -> j3743249496;
	j3743249496 [label="No cóż. To i cokolwiek może zostać odkryte w głowie Tenno dzięki Ciemnemu Refraktorium. Ale to już nie mój problem.",shape=box,color=blue];
		j3743249496 -> j4021014865;
		j3743249496 -> j2824269563;
		j3743249496 -> j85661112;
	j4021014865 [label="Dzieciak cię chyba trochę przeraża.",shape=box,color=red];
		j4021014865 -> j1439849710;
	j2824269563 [label="Co zaszło między tobą i Nitokh?",shape=box,color=red];
		j2824269563 -> j3060878919;
	j85661112 [label="Zamierzałeś zdradzić Orokin?",shape=box,color=red];
		j85661112 -> j845061198;
	j1439849710 [label="Oglądałem, jak grupka naznaczonych przez Pustkę dzieci, zdalnie pilotowała maszyny wojenne, które kiedyś były żołnierzami, a teraz zostały przerobione na groteskowe, piękne i mordercze dzieła sztuki, niszczące całe bataliony żołnierzy.",shape=box,color=blue];
		j1439849710 -> j4084942059;
	j3060878919 [label="Wszystko.",shape=box,color=blue];
		j3060878919 -> j1626898088;
	j845061198 [label="Tak. Ja i ona. Ale podejrzewam, że Nitokh chciała zdradzić także mnie, a ja planowałem zdradzić ją. Wiesz, jak to bywa wśród Orokin.",shape=box,color=blue];
		j845061198 -> j3292724749;
	j4084942059 [label="Dowiedziałem się, że obalili moje Imperium. Imperium, które władało całym Systemem Origin i wkrótce miało stłumić rebelię na Tau.",shape=box,color=blue];
		j4084942059 -> j1408372875;
	j1626898088 [label="Między mną i Nitokh stało się wszystko.",shape=box,color=blue];
		j1626898088 -> j1832983995;
	j3292724749 [label="Każdy spiskował przeciw każdemu. Dzień jak co dzień, naprawdę.",shape=box,color=blue];
		j3292724749 -> j567405358;
	j1408372875 [label="I zrobili to w jedną noc.",shape=box,color=blue];
		j1408372875 -> j1342302936;
	j1832983995 [label="Wszystko i jeszcze więcej.",shape=box,color=blue];
		j1832983995 -> j1733267208;
	j567405358 [label="Zdrady między Orokin były całkiem powszechne. Ale zdradzić całe Imperium? Taka zdrada była godna nie tylko egzekucji przez Jadeitowe Światło, ale też programu Cefalona.",shape=box,color=blue];
		j567405358 -> j1500183088;
	j1342302936 [label="Ciebie nie przeraża?!",shape=box,color=blue];
		j1342302936 -> j3967656126;
	j1733267208 [label="To wszystko, co chcę w tej chwili powiedzieć.",shape=box,color=blue];
		j1733267208 -> j3892706021;
	j1500183088 [label="Boolean RoatheTraitor1 is now true.",color=orange];
		j1500183088 -> j15485029;
		j1500183088 -> j2862095920;
	j3967656126 [label="Nie potrafię opisać, jak wielkie ryzyko podejmowaliśmy, próbując zamordować Egzekutorów, nie mówiąc już o wszystkich Orokin, Uzurpatorze.",shape=box,color=blue];
		j3967656126 -> j567405358;
	j3892706021 [label="Boolean RoatheExecutor1 is now true.",color=orange];
		j3892706021 -> j3967656126;
	j15485029 [label="Który los uważasz za gorszy?",shape=box,color=red];
		j15485029 -> j4069593773;
	j2862095920 [label="Więc taka intryga nie była na porządku dziennym?",shape=box,color=red];
		j2862095920 -> j2062556279;
	j4069593773 [label="Program Cefalonów Nihila. Dzieła Szklarza są...",shape=box,color=blue];
		j4069593773 -> j3046532799;
	j2062556279 [label="Imperium Orokin balansowało na ostrzu sztyletu, Uzurpatorze. Tyle razy chwiało się na krawędzi zagłady, utrzymywane przy życiu przed jedno:",shape=box,color=blue];
		j2062556279 -> j3021248236;
	j3046532799 [label="Jadeitowe Światło działa szybko, kiedy nie kryjesz się za pancerzem czy tarczą. To litościwa śmierć.",shape=box,color=blue];
		j3046532799 -> j2992170196;
	j3021248236 [label="Normy społeczne.",shape=box,color=blue];
		j3021248236 -> j1720186431;
	j2992170196 [label="Cefalony powstałe z dobrowolnych osobników mogły zaistnieć bezboleśnie, nawet bezstratnie, ale... jako forma kary?",shape=box,color=blue];
		j2992170196 -> j708817421;
	j1720186431 [label="Nikt nie myślał o powstaniu i zamordowaniu Orokin! Coś takiego nie miało miejsca, Włóczęgo! To było nie do pomyślenia!",shape=box,color=blue];
		j1720186431 -> j1056998219;
	j708817421 [label="Wspomnienia są świętością dla Orokin, Włóczęgo. Ostatecznie są wszystkim, czym jesteśmy. Nasze ciała przemijają. Nasze twarze, głosy, krew, dosłownie wszystko może zostać wymienione, niczym krzyk mody.",shape=box,color=blue];
		j708817421 -> j4186474857;
	j1056998219 [label="I dlatego też osiągnięcie tego było śmiesznie łatwe, o czym przekonał się twój mały duplikat, Tenno.",shape=box,color=blue];
		j1056998219 -> j3622247507;
