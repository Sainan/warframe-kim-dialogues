		j1212154586 -> j2307857443;
	j1037693174 [label="Zostałem przemieniony siłą... w to coś, przez Albrechta, zanim mieliśmy okazję zastawić swoją pułapkę na Egzekutorów.",shape=box,color=blue];
		j1037693174 -> j2347214501;
