		1309 -> 5777 [label="x < 21",color=purple];
		1309 -> 5777 [label="false",color=purple];
	1310 [label="Oczywiście masz rację! Albrecht spotkał mnie w korytarzu, zanim zastawiliśmy z Nitokh naszą pułapkę na Egzekutorów.",shape=box,color=blue];
		1310 -> 1313;
	1311 [label="Nie, oczywiście, że nie. Zostałem przemieniony siłą... w to coś, przez Albrechta, zanim zastawiliśmy z Nitokh naszą pułapkę na Egzekutorów.",shape=box,color=blue];
		1311 -> 1314;
	1312 [label="Dobrze wiesz, co stało się z naszym planem! Albrecht spotkał mnie w korytarzu, zanim zastawiliśmy z Nitokh naszą pułapkę na Egzekutorów.",shape=box,color=blue];
		1312 -> 1315;
	5777 [label="Zostałem przemieniony siłą... w to coś, przez Albrechta, zanim mieliśmy okazję zastawić swoją pułapkę na Egzekutorów.",shape=box,color=blue];
		5777 -> 1314;
	1313 [label="Zaproponował mi serum protoframe'a i... wiesz co stało się dalej.",shape=box,color=blue];
		1313 -> 1316;
	1314 [label="W jednej chwili stałem pośród złotych korytarzy, a w następnej wydzierałem się z bólu na jakimś zadupiu zwanym \"Galicją\".",shape=box,color=blue];
		1314 -> 1317;
	1315 [label="Zaproponował mi serum protoframe'a i wiemy co stało się dalej!",shape=box,color=blue];
		1315 -> 1316;
	1316 [label="I jest to sprawa. Która. Nadal. Doprowadza mnie do szału. Dlaczego?! Dlaczego ci o tym powiedziałem?! Dlaczego to wiesz?!",shape=box,color=blue];
		1316 -> 1318;
	1317 [label="Nitokh musiała porzucić ten plan, kiedy zaginąłem. Prawdopodobnie zwaliła całą winę na mnie, wygodnego kozła ofiarnego.",shape=box,color=blue];
		1317 -> 1319;
	1318 [label="Tfu! Nie. Nieważne. Muszę iść, zanim rozniosę ten cholerny komputer na kawałki.",shape=box,color=blue];
		1318 -> 1320;
	1319 [label="To wyjaśnia, dlaczego we wszystkich archiwach jestem nazywany \"tchórzem\". Oczywiście, że jestem tchórzem, myślą, że uciekłem! Ta.",shape=box,color=blue];
		1319 -> 1321;
