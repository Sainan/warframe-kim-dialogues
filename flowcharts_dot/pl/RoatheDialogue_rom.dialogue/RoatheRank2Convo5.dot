		1304 -> 1307 [label=true,color=green];
		1304 -> 1305 [label=false,color=brown];
		1304 -> 1306 [label=false,color=brown];
	1305 [label="Ale najwidoczniej nigdy nie zaszedłeś tak daleko, żeby samemu podjąć się takiej próby.",shape=box,color=red];
		1305 -> 1308;
	1306 [label="Co się stało z twoim planem?",shape=box,color=red];
		1306 -> 1309;
	1307 [label="Co zresztą może być powodem, dla którego jestem tak głęboko i bezwzględnie zirytowany twoim wtrąceniem się. ",shape=box,color=blue];
		1307 -> 1305;
		1307 -> 1306;
