		1320 -> 1322;
	1321 [label="+10 Chemistry",color=orange];
		1321 -> 1323;
	1322 [label="Chat ends.",color=orange];
	1323 [label="Dobrze wiedzieć, że byłem tak kluczowym elementem tego planu, że musiał zostać całkowicie porzucony pod moją nieobecność.",shape=box,color=blue];
		1323 -> 1324;
		1323 -> 1325;
	1324 [label="Nie jestem pewien, jak mam to rozumieć.",shape=box,color=red];
