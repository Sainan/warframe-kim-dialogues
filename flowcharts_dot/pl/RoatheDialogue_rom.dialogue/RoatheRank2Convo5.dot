		j1851965759 -> j51235303;
	j2347214501 [label="W jednej chwili stałem pośród złotych korytarzy, a w następnej wydzierałem się z bólu na jakimś zadupiu zwanym \"Galicją\".",shape=box,color=blue];
		j2347214501 -> j886972786;
	j2307857443 [label="Zaproponował mi serum protoframe'a i wiemy co stało się dalej!",shape=box,color=blue];
		j2307857443 -> j51235303;
	j51235303 [label="I jest to sprawa. Która. Nadal. Doprowadza mnie do szału. Dlaczego?! Dlaczego ci o tym powiedziałem?! Dlaczego to wiesz?!",shape=box,color=blue];
		j51235303 -> j3403639844;
	j886972786 [label="Nitokh musiała porzucić ten plan, kiedy zaginąłem. Prawdopodobnie zwaliła całą winę na mnie, wygodnego kozła ofiarnego.",shape=box,color=blue];
		j886972786 -> j314829644;
	j3403639844 [label="Tfu! Nie. Nieważne. Muszę iść, zanim rozniosę ten cholerny komputer na kawałki.",shape=box,color=blue];
		j3403639844 -> j1933300832;
	j314829644 [label="To wyjaśnia, dlaczego we wszystkich archiwach jestem nazywany \"tchórzem\". Oczywiście, że jestem tchórzem, myślą, że uciekłem! Ta.",shape=box,color=blue];
