		j2561888713 -> j1851965759;
	j1487305338 [label="Nie, oczywiście, że nie. Zostałem przemieniony siłą... w to coś, przez Albrechta, zanim zastawiliśmy z Nitokh naszą pułapkę na Egzekutorów.",shape=box,color=blue];
		j1487305338 -> j2347214501;
