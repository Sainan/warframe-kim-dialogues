		1226 -> 1229 [label=true,color=green];
		1226 -> 1228 [label=false,color=brown];
	1227 [label="Chat ends.",color=orange];
	1229 [label="Jak wiele przeszły Roathe opowiedział ci o swoich przygodach z Egzekutorką Nitokh? Ech, próba pogodzenia tego wszystkiego, mój poprzednik powierzył ci tak osobiste informacje... tylko po to, żebyś odebrał mi te wspomnienia?",shape=box,color=blue];
		1229 -> 1232;
	1228 [label="Evaluate expressions on HellStory",color=orange];
		1228 -> 1231 [label="x >= 1",color=purple];
		1228 -> 1230 [label="x <= 1",color=purple];
		1228 -> 1230 [label="false",color=purple];
	1232 [label="To paląca rana w moim sercu. Wiedzieć, że mogłem ci powiedzieć o wszystkim, odsłonić przed tobą swoje najgłębsze tajemnice... a ty zacząłeś wszystko od nowa. Jakbym był dla ciebie tylko zabawką.",shape=box,color=blue];
		1232 -> 1234;
	1231 [label="Słyszałeś już o Egzekutorce Nitokh i moich... przygodach z nią. Musisz zrozumieć, że nie całe Imperium Orokin było przegniłe złem.",shape=box,color=blue];
		1231 -> 1233;
	1230 [label="Chat ends.",color=orange];
	1234 [label="Ale tak chyba jest sprawiedliwie. Właśnie tak my, Orokin, traktowaliśmy ludzkość, czyż nie? Teatr Yuvan? Obnoszenie się pięknym ciałem i wybieranie sobie nowej formy, nękanie siebie nawzajem gierkami dla własnej zabawy...",shape=box,color=blue];
		1234 -> 1236;
	1233 [label="Serce pęka mi na myśl, że zostanie zapamiętane tylko przez zniszczenie i zepsucie. Tak, było tego wiele, nie mogę temu przeczyć. ",shape=box,color=blue];
		1233 -> 1235;
	1236 [label="Nienawidzę tego. Tak bardzo tego nienawidzę.",shape=box,color=blue];
		1236 -> 1239;
		1236 -> 1240;
		1236 -> 1238;
	1235 [label="Ale było też zdolne tworzyć piękno. Radość. Miłość. Rozwój naukowy i artystyczny. Spójrz, do czego byliśmy zdolni! ",shape=box,color=blue];
		1235 -> 1237;
	1239 [label="Jest mi przykro i nie chciałem cię zranić, ale jest to dla ciebie lekcja, jak wyglądało życie po drugiej stronie Imperium Orokin.",shape=box,color=red];
		1239 -> 1245;
	1240 [label="Nie chciałem cię tak zranić. Nie powinieneś przepraszać za to, jak działało społeczeństwo Orokin – nie ty je stworzyłeś. Próbowałeś je tylko naprawić.",shape=box,color=red];
		1240 -> 1246;
	1238 [label="[Koniec]",shape=box,color=red];
		1238 -> 1244;
	1237 [label="Więc kiedy Nitokh przyzwała mnie do swojego boku i powiedziała, że chce wymordować wszystkich Orokin? Natychmiast się zgodziłem. Chciałem odciąć głowę tego jadowitego węża. Chciałem zastąpić ją czymś łagodniejszym. Bardziej dobrodusznym władcą.",shape=box,color=blue];
		1237 -> 1241;
		1237 -> 1242;
		1237 -> 1243;
	1245 [label="Add 3 to Thermostat",color=orange];
		1245 -> 1250;
	1246 [label="Add -3 to Thermostat",color=orange];
		1246 -> 1251;
	1244 [label="Chat ends.",color=orange];
	1241 [label="Masz na myśli, że chciałeś zająć miejsce Imperatorów i Egzekutorów.",shape=box,color=red];
		1241 -> 1247;
	1242 [label="I kim byłby ten nowy władca?",shape=box,color=red];
		1242 -> 1248;
	1243 [label="[Koniec]",shape=box,color=red];
		1243 -> 1249;
	1250 [label="Imperium Orokin nie było całkiem przegniłe złem. Serce pęka mi na myśl, że zostanie zapamiętane tylko przez zniszczenie i zepsucie. Tak, było tego wiele, nie mogę temu przeczyć. ",shape=box,color=blue];
		1250 -> 1253;
	1251 [label="Gdyby tylko inni byli w stanie to dostrzec. Gdyby tylko Nitokh była w stanie to zrozumieć. ",shape=box,color=blue];
		1251 -> 1254;
	1247 [label="Ależ tak, oczywiście!",shape=box,color=blue];
		1247 -> 1252;
	1248 [label="Byłbym to ja, rzecz jasna.",shape=box,color=blue];
		1248 -> 1252;
	1249 [label="Chat ends.",color=orange];
	1253 [label="Ale było też zdolne tworzyć piękno. Radość. Miłość. Rozwój naukowy i artystyczny. Spójrz, do czego byliśmy zdolni! ",shape=box,color=blue];
		1253 -> 1256;
	1254 [label="Imperium Orokin nie było całkiem przegniłe złem. Serce pęka mi na myśl, że zostanie zapamiętane tylko przez zniszczenie i zepsucie. Tak, było tego wiele, nie mogę temu przeczyć.",shape=box,color=blue];
		1254 -> 1253;
	1252 [label="Zadbałbym o to, żeby wszyscy Egzekutorzy i Imperatorzy zostali… odsunięci od władzy, a ja przejąłbym ich obowiązki jako Przejściowy Egzekutor do czasu wprowadzenia nowego systemu.",shape=box,color=blue];
		1252 -> 1255;
	1256 [label="Więc kiedy Nitokh przyzwała mnie do swojego boku i powiedziała, że chce wymordować wszystkich Orokin? Natychmiast się zgodziłem. Chciałem odciąć głowę tego jadowitego węża. Chciałem zastąpić ją czymś łagodniejszym. Bardziej dobrodusznym władcą.",shape=box,color=blue];
		1256 -> 1260;
		1256 -> 1261;
	1255 [label="Ile by to zajęło, kto wie, ale byłoby to lepsze niż to, co nastąpiło po Wielkiej Wojnie, prawda?",shape=box,color=blue];
		1255 -> 1257;
		1255 -> 1258;
		1255 -> 1259;
	1260 [label="Masz na myśli, że chciałeś zająć miejsce Imperatorów i Egzekutorów.",shape=box,color=red];
		1260 -> 1265;
	1261 [label="I kim byłby ten nowy władca?",shape=box,color=red];
		1261 -> 1266;
	1257 [label="Wielka Wojna?",shape=box,color=red];
		1257 -> 1262;
	1258 [label="Bądź ze sobą szczery, czy naprawdę oddałbyś władzę?",shape=box,color=red];
		1258 -> 1263;
	1259 [label="Wątpię, że oddałbyś władzę, Roathe.",shape=box,color=red];
		1259 -> 1264;
	1265 [label="Ależ tak, oczywiście! I nie udawaj, że wcześniej tego nie słyszałeś. Jestem pewien, że słyszałeś ",shape=box,color=blue];
		1265 -> 1270;
	1266 [label="Byłbym to ja, rzecz jasna. I nie udawaj, że wcześniej tego nie słyszałeś. Jestem pewien, że słyszałeś.",shape=box,color=blue];
		1266 -> 1270;
	1262 [label="Ty nazywasz to \"Starą Wojną\". Dla mnie nie jest \"stara\", w mojej pamięci miała miejsce ledwie kilka lat temu.",shape=box,color=blue];
		1262 -> 1267;
	1263 [label="Hmm, nie wiem. Nie ma to teraz znaczenia, prawda? Ale wtedy byłem przekonany, że tak bym postąpił.",shape=box,color=blue];
		1263 -> 1268;
	1264 [label="+5 Chemistry",color=orange];
		1264 -> 1269;
	1270 [label="Zadbałbym o to, żeby wszyscy Egzekutorzy i Imperatorzy zostali… odsunięci od władzy, a ja przejąłbym ich obowiązki jako Przejściowy Egzekutor do czasu wprowadzenia nowego systemu.",shape=box,color=blue];
		1270 -> 1274;
	1267 [label="Śmieszna sprawa, te podróże w czasie.",shape=box,color=blue];
		1267 -> 1271;
	1268 [label="Tak bardzo chciałem powrócić, aż zrozumiałem, że... mój lud nie żyje. Zostałbym stracony razem z nimi wszystkimi.",shape=box,color=blue];
		1268 -> 1272;
	1269 [label="Zamilcz.",shape=box,color=blue];
		1269 -> 1273;
	1274 [label="Ile by to zajęło, kto wie, ale byłoby to lepsze niż to, co nastąpiło po Wielkiej Wojnie, prawda?",shape=box,color=blue];
		1274 -> 1258;
		1274 -> 1259;
		1274 -> 1257;
	1271 [label="Kilka lat dla mnie, a w \"rzeczywistości\" minęły tysiące – Imperium upadło i ludzie odeszli. ",shape=box,color=blue];
		1271 -> 5775;
	1272 [label="Tenno wyrżnęliby mnie jak całą resztę w Noc Bębnów Naga. Prawdopodobnie zginąłbym, próbując uratować życie Nitokh.",shape=box,color=blue];
		1272 -> 1275;
	1273 [label="Wtedy byłem całkowicie przekonany, że tak. Ale teraz to już nie ma znaczenia, prawda?",shape=box,color=blue];
		1273 -> 1268;
	5775 [label="Uświadomiłem sobie, że nie ma znaczenia, czy zrzekłbym się władzy, czy nie, choć kiedyś byłem przekonany, że bym to zrobił.",shape=box,color=blue];
		5775 -> 1272;
	1275 [label="Ciekawe, jaki los ją spotkał? Archiwa nie wspominają jej imienia... wszystkie okropności popełnione w jej imieniu, śmierć, tragedie... i mogę być jedyną osobą, która o nich wie.",shape=box,color=blue];
		1275 -> 1276;
	1276 [label="No cóż. To i cokolwiek może zostać odkryte w głowie Tenno dzięki Ciemnemu Refraktorium. Ale to już nie mój problem.",shape=box,color=blue];
		1276 -> 1277;
		1276 -> 1278;
		1276 -> 1279;
	1277 [label="Dzieciak cię chyba trochę przeraża.",shape=box,color=red];
		1277 -> 1280;
	1278 [label="Co zaszło między tobą i Nitokh?",shape=box,color=red];
		1278 -> 1281;
	1279 [label="Zamierzałeś zdradzić Orokin?",shape=box,color=red];
		1279 -> 1282;
	1280 [label="Oglądałem, jak grupka naznaczonych przez Pustkę dzieci, zdalnie pilotowała maszyny wojenne, które kiedyś były żołnierzami, a teraz zostały przerobione na groteskowe, piękne i mordercze dzieła sztuki, niszczące całe bataliony żołnierzy.",shape=box,color=blue];
		1280 -> 1283;
	1281 [label="Wszystko.",shape=box,color=blue];
		1281 -> 1284;
	1282 [label="Tak. Ja i ona. Ale podejrzewam, że Nitokh chciała zdradzić także mnie, a ja planowałem zdradzić ją. Wiesz, jak to bywa wśród Orokin.",shape=box,color=blue];
		1282 -> 1285;
	1283 [label="Dowiedziałem się, że obalili moje Imperium. Imperium, które władało całym Systemem Origin i wkrótce miało stłumić rebelię na Tau.",shape=box,color=blue];
		1283 -> 1286;
	1284 [label="Między mną i Nitokh stało się wszystko.",shape=box,color=blue];
		1284 -> 1287;
	1285 [label="Każdy spiskował przeciw każdemu. Dzień jak co dzień, naprawdę.",shape=box,color=blue];
		1285 -> 1288;
	1286 [label="I zrobili to w jedną noc.",shape=box,color=blue];
		1286 -> 1289;
	1287 [label="Wszystko i jeszcze więcej.",shape=box,color=blue];
		1287 -> 1290;
	1288 [label="Zdrady między Orokin były całkiem powszechne. Ale zdradzić całe Imperium? Taka zdrada była godna nie tylko egzekucji przez Jadeitowe Światło, ale też programu Cefalona.",shape=box,color=blue];
		1288 -> 1291;
	1289 [label="Ciebie nie przeraża?!",shape=box,color=blue];
		1289 -> 1292;
	1290 [label="To wszystko, co chcę w tej chwili powiedzieć.",shape=box,color=blue];
		1290 -> 1293;
	1291 [label="Update boolean RoatheTraitor1",color=orange];
		1291 -> 1294;
		1291 -> 1295;
	1292 [label="Nie potrafię opisać, jak wielkie ryzyko podejmowaliśmy, próbując zamordować Egzekutorów, nie mówiąc już o wszystkich Orokin, Uzurpatorze.",shape=box,color=blue];
		1292 -> 1288;
	1293 [label="Update boolean RoatheExecutor1",color=orange];
		1293 -> 1292;
	1294 [label="Który los uważasz za gorszy?",shape=box,color=red];
		1294 -> 1296;
	1295 [label="Więc taka intryga nie była na porządku dziennym?",shape=box,color=red];
		1295 -> 1297;
	1296 [label="Program Cefalonów Nihila. Dzieła Szklarza są...",shape=box,color=blue];
		1296 -> 1298;
	1297 [label="Imperium Orokin balansowało na ostrzu sztyletu, Uzurpatorze. Tyle razy chwiało się na krawędzi zagłady, utrzymywane przy życiu przed jedno:",shape=box,color=blue];
		1297 -> 1299;
	1298 [label="Jadeitowe Światło działa szybko, kiedy nie kryjesz się za pancerzem czy tarczą. To litościwa śmierć.",shape=box,color=blue];
		1298 -> 1300;
	1299 [label="Normy społeczne.",shape=box,color=blue];
		1299 -> 1301;
	1300 [label="Cefalony powstałe z dobrowolnych osobników mogły zaistnieć bezboleśnie, nawet bezstratnie, ale... jako forma kary?",shape=box,color=blue];
		1300 -> 1302;
	1301 [label="Nikt nie myślał o powstaniu i zamordowaniu Orokin! Coś takiego nie miało miejsca, Włóczęgo! To było nie do pomyślenia!",shape=box,color=blue];
		1301 -> 1303;
	1302 [label="Wspomnienia są świętością dla Orokin, Włóczęgo. Ostatecznie są wszystkim, czym jesteśmy. Nasze ciała przemijają. Nasze twarze, głosy, krew, dosłownie wszystko może zostać wymienione, niczym krzyk mody.",shape=box,color=blue];
		1302 -> 1304;
	1303 [label="I dlatego też osiągnięcie tego było śmiesznie łatwe, o czym przekonał się twój mały duplikat, Tenno.",shape=box,color=blue];
		1303 -> 1305;
		1303 -> 1306;
