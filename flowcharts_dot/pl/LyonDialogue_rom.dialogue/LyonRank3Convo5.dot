digraph {
	445 [label="LyonRank3Convo5 begins.",color=orange];
		445 -> 446;
	446 [label="Tej nocy, gdy przybył do nas \"kardynał Dimanche\", szalała burza. Stanął w prezbiterium kościoła, nietknięty przez wichurę panującą na zewnątrz.",shape=box,color=blue];
		446 -> 447;
	447 [label="Już to na wstępie powinno mnie zaniepokoić. Zamiast tego pokłoniłem się przed nim i przywitałem go, jak każdego nowego wysłannika Świętej Matki.",shape=box,color=blue];
		447 -> 448;
	448 [label="Spodziewaliśmy się nowego kardynała, gdyż nasz poprzedni zmarł kilka miesięcy wcześniej z powodu choroby.",shape=box,color=blue];
		448 -> 449;
	449 [label="Dimanche przywitał mnie ciepłym uśmiechem i mocnym uściskiem dłoni. Zapytałem go, czy jego podróż była długa. Nigdy nie zapomnę jego odpowiedzi.",shape=box,color=blue];
		449 -> 450;
	450 [label="\"Była trudna... ale nie trwała długo\".",shape=box,color=blue];
		450 -> 451;
	451 [label="Ciągle chodziło mi to po głowie, podobnie jak fakt, że jego płaszcz był suchy jak pieprz. Ale zignorowałem to, jak to każdy ma w zwyczaju, stając w obliczu czegoś niecodziennego.",shape=box,color=blue];
		451 -> 452;
	452 [label="A ja nie miałem czasu się nad tym głowić, bo chwilę później przybyła zniecierpliwiona Maria.",shape=box,color=blue];
		452 -> 453;
	453 [label="Uklęknął przy jej wózku, by ją przywitać i wziął ją za ręce. Powinienem był dostrzec tę manipulację.",shape=box,color=blue];
		453 -> 454;
	454 [label="Przecież nie był jedynym diabłem, który pojawił się w naszym progu w trakcie burzy.",shape=box,color=blue];
		454 -> 455;
	455 [label="Update boolean LyonEntrati1",color=orange];
		455 -> 456;
	456 [label="Check boolean MarieEntrati1",color=orange];
		456 -> 457 [label=true,color=green];
		456 -> 459 [label=true,color=green];
		456 -> 460 [label=true,color=green];
		456 -> 458 [label=false,color=brown];
		456 -> 457 [label=false,color=brown];
	457 [label="A tym drugim diabłem jest Roathe?",shape=box,color=red];
		457 -> 461;
	459 [label="Ona wspomina tę historię zupełnie inaczej.",shape=box,color=red];
		459 -> 463;
	460 [label="Ona nadal wierzy w jego czyste intencje. A ty?",shape=box,color=red];
		460 -> 464;
	458 [label="Zakładam, że nie jesteś sojusznikiem Entratiego?",shape=box,color=red];
		458 -> 462;
	461 [label="Tak. Ale to opowieść na inny dzień. Jeśli zacznę o nim mówić, to mój i tak już kiepski nastrój będzie... ",shape=box,color=blue];
		461 -> 465;
	463 [label="Tak, to prawda.",shape=box,color=blue];
		463 -> 467;
		463 -> 468;
	464 [label="+5 Chemistry",color=orange];
		464 -> 469;
	462 [label="Jak miałbym nim być, po tym, jak byłem świadkiem jego kłamstw i zdrady, a to, jak zmanipulował Marię, w dalszym ciągu odbija się nam czkawką? Nie, z pewnością nie jestem jego sojusznikiem.",shape=box,color=blue];
		462 -> 466;
	465 [label="...nie do wytrzymania. Wolałbym skupić się na występkach Entratiego, jeśli nie zrobi ci to różnicy.",shape=box,color=blue];
		465 -> 470;
	467 [label="Mówiła mi, że czasami dostrzegasz rzeczy, których inni nie widzą.",shape=box,color=red];
		467 -> 472;
	468 [label="No i? ",shape=box,color=red];
		468 -> 473;
	469 [label="Maria wierzy, że każda dusza jest dobra. To umiejętność, którą doskonaliła i rozstawiała niczym tarczę przed otaczającym ją światem.",shape=box,color=blue];
		469 -> 474;
		469 -> 475;
	466 [label="+5 Chemistry",color=orange];
		466 -> 471;
	470 [label="Check boolean RoatheSerum1",color=orange];
		470 -> 476 [label=true,color=green];
		470 -> 477 [label=true,color=green];
		470 -> 476 [label=false,color=brown];
		470 -> 478 [label=false,color=brown];
	472 [label="I co byś z tym zrobił Włóczęgo, gdyby to była prawda?",shape=box,color=blue];
		472 -> 480;
	473 [label="\"No i\" nic. Jak byłem świadkiem tego wydarzenia, powiedziałem ci, jak to wyglądało z mojej strony. I to tyle.",shape=box,color=blue];
		473 -> 469;
	474 [label="Maria nie wie, do czego naprawdę zdolny jest Entrati, tak jak nie zdaje sobie sprawy z tych wszystkich okropieństw, których dokonał w imię \"postępu\", a teraz \"odkupienia\".",shape=box,color=red];
		474 -> 481;
	475 [label="Maria jest dorosłą kobietą. Choć podziwiam twoją chęć roztoczenia parasola ochronnego wokół niej, sama może decydować, w co chce wierzyć i komu ufać.",shape=box,color=red];
		475 -> 482;
	471 [label="Okaleczenie ciał, zniszczenie naszej przyszłości i zepsucie przeszłości – może jestem w stanie to wszystko wybaczyć.",shape=box,color=blue];
		471 -> 479;
	476 [label="Może i Entrati nie ma najlepszych manier, ale stara się uratować wszechświat.",shape=box,color=red];
		476 -> 471;
	477 [label="Zmusił cię do zostania protoframem, jak Roathe'a?",shape=box,color=red];
		477 -> 483;
	478 [label="Jasne. Dlaczego jesteś zły na Entratiego?",shape=box,color=red];
		478 -> 484;
	480 [label="Check boolean LyonVisions1",color=orange];
		480 -> 486 [label=true,color=green];
		480 -> 488 [label=true,color=green];
		480 -> 489 [label=true,color=green];
		480 -> 486 [label=false,color=brown];
		480 -> 487 [label=false,color=brown];
		480 -> 488 [label=false,color=brown];
	481 [label="Zaufanie jest niczym witraż. Delikatne, gdy się tworzy. Piękne w swej okazałości. Tragiczne, gdy się zbije. I niebezpieczne, gdy ktoś je zniszczy.",shape=box,color=blue];
		481 -> 496;
	482 [label="Zaufanie jest niczym witraż. Delikatne, gdy się tworzy. Piękne w swej okazałości. Tragiczne, gdy się zbije. I niebezpieczne, gdy ktoś je zniszczy.",shape=box,color=blue];
		482 -> 491;
	479 [label="Ale patrzeć, jak skrzywdził Marię... wykorzystał jej wiarę w dobroć innych dla własnych celów?",shape=box,color=blue];
		479 -> 485;
	483 [label="Nie. Miałem swój powód, by przyjąć eliksir. Dobrze wiedziałem, jak pokręconą kreaturą się stanę. Maria też.",shape=box,color=blue];
		483 -> 492;
	484 [label="+5 Chemistry",color=orange];
		484 -> 471;
	486 [label="Chyba mnie to za bardzo nie obchodzi.",shape=box,color=red];
		486 -> 493;
	488 [label="Nasuwa mi się tylko jedno pytanie: czy twoje wizje ci przeszkadzają?",shape=box,color=red];
		488 -> 495;
	489 [label="Przez to, co powiedziałeś ostatnio, zacząłem się zastanawiać, czy wszystko u ciebie w porządku.",shape=box,color=red];
		489 -> 494;
	487 [label="Zastanawia mnie tylko, czy wszystko u ciebie w porządku.",shape=box,color=red];
		487 -> 494;
	496 [label="+15 Chemistry",color=orange];
		496 -> 502;
	491 [label="Pławi się w ciepłym świetle Sol, nie dostrzegając skaz, które tworzą się na powierzchni. Nie słysząc pogłębiających się pęknięć.",shape=box,color=blue];
		491 -> 497;
	485 [label="Tego mu nigdy nie wybaczę. Za to pragnę wbić w jego ciało kadzielnicę, aż zacznie błagać o zbawienie.",shape=box,color=blue];
		485 -> 474;
		485 -> 475;
	492 [label="Nie zostaliśmy... złamani siłą, jak diabeł. W głębi serca współczułem Roathe'owi, że musiał przez to przejść.",shape=box,color=blue];
		492 -> 498;
	493 [label="W takim razie nie widzę potrzeby kontynuowania tej rozmowy.",shape=box,color=blue];
		493 -> 499;
	495 [label="Powiem wprost, Włóczęgo, że nie wiem, jak mam na to odpowiedzieć.",shape=box,color=blue];
		495 -> 501;
	494 [label="Update boolean LyonAllRight",color=orange];
		494 -> 500;
	502 [label="Gdybym tylko mógł przejąć to zepsucie, które zasiał w jej umyśle. Pozostaje mi tylko modlić się, aby udało ci się dokonać tego, w czym ja poniosłem porażkę.",shape=box,color=blue];
		502 -> 507;
	497 [label="Nieświadoma, że odłamki jej własnego arcydzieła wkrótce obrócą się przeciwko niej. Postanowiła nie dostrzegać tego, co nieuchronnie nastąpi.",shape=box,color=blue];
		497 -> 503;
	498 [label="A później otworzył usta i zaczął mówić.",shape=box,color=blue];
		498 -> 504;
		498 -> 505;
	499 [label="Chat ends.",color=orange];
	501 [label="Przez całe życie widuję koszmary, przez które inni trafiliby do zakładu psychiatrycznego. Co gorsza, od czasu do czasu moje wizje się urzeczywistniały.",shape=box,color=blue];
		501 -> 506;
	500 [label="Czy wszystko ze mną \"w porządku\"? Powiem wprost, Włóczęgo, że nie wiem, jak mam na to odpowiedzieć.",shape=box,color=blue];
		500 -> 501;
	507 [label="O. Leon Allard",shape=box,color=blue];
		507 -> 513;
	503 [label="Gdybym tylko mógł cierpieć za nią, jakże chętnie wytatuowałbym to w swojej duszy. Ale to jest przeznaczone jej i tylko jej.",shape=box,color=blue];
		503 -> 508;
	504 [label="Trzeba pamiętać, w jakich warunkach się wychowywał. W jakim środowisku przyszło mu nauczyć się przetrwania. To był – a w zasadzie jest – Orokin.",shape=box,color=red];
		504 -> 509;
		504 -> 510;
	505 [label="Szczerze mówiąc, to nie uważam, że jest taki zły. Chyba zaczynam go lubić.",shape=box,color=red];
		505 -> 511;
	506 [label="Update boolean LyonVisions1",color=orange];
		506 -> 512;
	513 [label="Chat ends.",color=orange];
	508 [label="Zamiast tego postaram się zapobiec temu bólowi, Włóczęgo. ",shape=box,color=blue];
		508 -> 514;
	509 [label="To go nie usprawiedliwia, ale choć trochę pozwala go zrozumieć.",shape=box,color=red];
		509 -> 515;
	510 [label="Robi to, co uważa za konieczne.",shape=box,color=red];
		510 -> 516;
	511 [label="Na twoim miejscu poszedłbym po maść do p. Loida na tę dolegliwość. Żeby się nie rozprzestrzeniła.",shape=box,color=blue];
		511 -> 517;
		511 -> 518;
	512 [label="Update boolean LyonBackstory1",color=orange];
		512 -> 519;
	514 [label="A że ty dostrzegasz w tym akcie próbę umniejszenia jej?",shape=box,color=blue];
		514 -> 520;
	515 [label="Add 1 to Thermostat",color=orange];
		515 -> 521;
	516 [label="Add -1 to Thermostat",color=orange];
		516 -> 522;
	517 [label="Diabeł musi mieć w sobie odrobinę uroku.",shape=box,color=red];
		517 -> 523;
	518 [label="Nie martw się, nie dam się zwieść jego urokowi.",shape=box,color=red];
		518 -> 524;
	519 [label="I dlatego uważałem ich za przewodników Lui. Sądziłem, że zostałem wybrany przez Świetlistych do dźwigania takiego brzemienia. A przynajmniej tak mi się wtedy wydawało. Właśnie dlatego zainteresowałem się kapłaństwem.",shape=box,color=blue];
		519 -> 525;
		519 -> 526;
		519 -> 527;
	520 [label="Niech Lua zlituje się nad twą duszą.",shape=box,color=blue];
		520 -> 528;
	521 [label="Zgodnie z naszą świętą księgą z diabłem się nie negocjuje – jego się przepędza. Ale na tę konkretną sytuację nas nie przygotowano.",shape=box,color=blue];
		521 -> 529;
	522 [label="Możliwe. Nie jestem jednak pewien, czy w sercu tej kreatury jest miejsce na wątpliwości.",shape=box,color=blue];
		522 -> 529;
	523 [label="Add -1 to Thermostat",color=orange];
		523 -> 530;
	524 [label="Add 1 to Thermostat",color=orange];
		524 -> 531;
	525 [label="Wierzyłeś w to, że wizje pochodzą od Lui? Coś się zmieniło?",shape=box,color=red];
		525 -> 532;
	526 [label="O jakich koszmarach mówisz?",shape=box,color=red];
		526 -> 533;
	527 [label="A co o tym teraz myślisz?",shape=box,color=red];
		527 -> 534;
	528 [label="O. Leon Allard",shape=box,color=blue];
		528 -> 535;
	529 [label="Zobaczymy, którą ścieżkę ów diabeł obierze, prawda?",shape=box,color=blue];
		529 -> 536;
	530 [label="I właśnie to mnie martwi. Diabeł uśmiecha się i mówi z sensem, gdy wszyscy wokół bredzą jak opętani. ",shape=box,color=blue];
		530 -> 537;
	531 [label="+20 Chemistry",color=orange];
		531 -> 538;
	532 [label="To, w co wierzę, stało się ostatnio... skomplikowane ze względu na pojawienie się nowych informacji.",shape=box,color=blue];
		532 -> 534;
	533 [label="Dopiero co zaczęliśmy rozmawiać o takich rzeczach, Włóczęgo. To nie o to chodzi, że ci nie wierzę, że widziałeś największe okropieństwa na własne oczy. Albo, że potrzebowałbyś protekcji przed jakimikolwiek szczątkowymi opisami, jakie zdołałbym przywołać.",shape=box,color=blue];
		533 -> 539;
	534 [label="Mówiąc najprościej, Włóczęgo, uczciwie byłoby przyznać, że nie wiem, w co mam wierzyć.",shape=box,color=blue];
		534 -> 540;
	535 [label="Chat ends.",color=orange];
	536 [label="O. Leon Allard",shape=box,color=blue];
		536 -> 541;
	537 [label="Zaskakuje nas w najmniej oczekiwanym momencie – gdy jesteśmy bezbronni. Gdy jesteśmy słabi. Gdy potrzebujemy odpowiedzi.",shape=box,color=blue];
		537 -> 542;
		537 -> 543;
	538 [label="To dobrze. Dopilnuj, żeby tak pozostało. Nie chciałbym być zmuszony wbijać ci rozum do głowy. Wyglądasz na kogoś, kto nie pozostaje dłużny.",shape=box,color=blue];
		538 -> 544;
	539 [label="Po prostu nie podejmuję takich tematów z kimś, kogo dopiero poznałem, by go nie wystraszyć mą osobą. Wolałbym uniknąć takiej sytuacji, w której bylibyśmy zmuszeni do współpracy, nawet na krótko.",shape=box,color=blue];
		539 -> 545;
		539 -> 546;
	540 [label="Update boolean LyonFaith1",color=orange];
		540 -> 547;
	541 [label="+20 Chemistry",color=orange];
		541 -> 548;
	542 [label="Dam sobie radę. Obiecuję, że nie pozwolę mu sobą manipulować.",shape=box,color=red];
		542 -> 549;
	543 [label="Brzmisz, jakbyś to mówił na podstawie własnych doświadczeń. Jakich odpowiedzi ci udzielił?",shape=box,color=red];
		543 -> 550;
	544 [label="A wtedy znaleźlibyśmy się w bardzo dziwnym położeniu?",shape=box,color=blue];
		544 -> 551;
	545 [label="Jeśli chcesz zaczekać, aż nabierzesz do mnie większego zaufania, to rozumiem.",shape=box,color=red];
		545 -> 552;
	546 [label="Nigdzie się nie wybieram, Leonie. Możesz mi zaufać.",shape=box,color=red];
		546 -> 553;
	547 [label="Obawiam się jednak, że to rozmowa na inny dzień.",shape=box,color=blue];
		547 -> 554;
	548 [label="Chat ends.",color=orange];
	549 [label="+20 Chemistry",color=orange];
		549 -> 555;
	550 [label="Takich, które jak się tego obawiałem... podawały w wątpliwość wiele rzeczy. Ale obawiam się, że to temat na inną dyskusję.",shape=box,color=blue];
		550 -> 556;
	551 [label="Chat ends.",color=orange];
	552 [label="+20 Chemistry",color=orange];
		552 -> 557;
	553 [label="+15 Chemistry",color=orange];
		553 -> 558;
	554 [label="+20 Chemistry",color=orange];
		554 -> 559;
	555 [label="To dobrze. Dopilnuj, żeby tak pozostało. Nie chciałbym być zmuszony wbijać ci rozum do głowy. Wyglądasz na kogoś, kto nie pozostaje dłużny.",shape=box,color=blue];
		555 -> 560;
	556 [label="Update boolean LyonFaith1",color=orange];
		556 -> 561;
	557 [label="Dziękuję. Nie chodzi o to, że nie wierzę w szczerość twoich słów. Po prostu na podstawie moich dotychczasowych doświadczeń jestem ostrożny.",shape=box,color=blue];
		557 -> 559;
	558 [label="Nie chodzi o to, że nie wierzę w szczerość twoich słów. Po prostu na podstawie moich dotychczasowych doświadczeń jestem ostrożny.",shape=box,color=blue];
		558 -> 559;
	559 [label="Do tego czasu musisz mi wybaczyć i uzbroić się w cierpliwość.",shape=box,color=blue];
		559 -> 562;
	560 [label="A wtedy znaleźlibyśmy się w bardzo dziwnym położeniu?",shape=box,color=blue];
		560 -> 563;
