digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank3Convo5 begins." [color=orange];
		"LyonRank3Convo5 begins." -> j3323768838;
	j3323768838 [label="Tej nocy, gdy przybył do nas \"kardynał Dimanche\", szalała burza. Stanął w prezbiterium kościoła, nietknięty przez wichurę panującą na zewnątrz.",shape=box,color=blue];
		j3323768838 -> j404072212;
	j404072212 [label="Już to na wstępie powinno mnie zaniepokoić. Zamiast tego pokłoniłem się przed nim i przywitałem go, jak każdego nowego wysłannika Świętej Matki.",shape=box,color=blue];
		j404072212 -> j2462079847;
	j2462079847 [label="Spodziewaliśmy się nowego kardynała, gdyż nasz poprzedni zmarł kilka miesięcy wcześniej z powodu choroby.",shape=box,color=blue];
		j2462079847 -> j253544480;
	j253544480 [label="Dimanche przywitał mnie ciepłym uśmiechem i mocnym uściskiem dłoni. Zapytałem go, czy jego podróż była długa. Nigdy nie zapomnę jego odpowiedzi.",shape=box,color=blue];
		j253544480 -> j905623181;
	j905623181 [label="\"Była trudna... ale nie trwała długo\".",shape=box,color=blue];
		j905623181 -> j1010222851;
	j1010222851 [label="Ciągle chodziło mi to po głowie, podobnie jak fakt, że jego płaszcz był suchy jak pieprz. Ale zignorowałem to, jak to każdy ma w zwyczaju, stając w obliczu czegoś niecodziennego.",shape=box,color=blue];
		j1010222851 -> j1111295271;
	j1111295271 [label="A ja nie miałem czasu się nad tym głowić, bo chwilę później przybyła zniecierpliwiona Maria.",shape=box,color=blue];
		j1111295271 -> j1548546800;
	j1548546800 [label="Uklęknął przy jej wózku, by ją przywitać i wziął ją za ręce. Powinienem był dostrzec tę manipulację.",shape=box,color=blue];
		j1548546800 -> j122002014;
	j122002014 [label="Przecież nie był jedynym diabłem, który pojawił się w naszym progu w trakcie burzy.",shape=box,color=blue];
		j122002014 -> j1928339452;
	j1928339452 [label="Boolean LyonEntrati1 is now true.",color=orange];
		j1928339452 -> j2100050873;
	j2100050873 [label="Check boolean MarieEntrati1",color=orange];
		j2100050873 -> j3286404645 [label=true,color=green];
		j2100050873 -> j2818471337 [label=true,color=green];
		j2100050873 -> j1869023591 [label=true,color=green];
		j2100050873 -> j1700129874 [label=false,color=brown];
		j2100050873 -> j3286404645 [label=false,color=brown];
	j3286404645 [label="A tym drugim diabłem jest Roathe?",shape=box,color=red];
		j3286404645 -> j2305199025;
	j2818471337 [label="Ona wspomina tę historię zupełnie inaczej.",shape=box,color=red];
		j2818471337 -> j2333763830;
	j1869023591 [label="Ona nadal wierzy w czystość jego intencji. A ty?",shape=box,color=red];
		j1869023591 -> j2230132264;
	j1700129874 [label="Zakładam, że nie jesteś sojusznikiem Entratiego?",shape=box,color=red];
		j1700129874 -> j2714492661;
	j2305199025 [label="Tak. Ale to opowieść na inny dzień. Jeśli zacznę o nim mówić, to mój i tak już kiepski nastrój będzie... ",shape=box,color=blue];
		j2305199025 -> j3152573193;
	j2333763830 [label="Tak, to prawda.",shape=box,color=blue];
		j2333763830 -> j2104046610;
		j2333763830 -> j92265762;
	j2230132264 [label="+5 Chemistry",color=orange];
		j2230132264 -> j4036841203;
	j2714492661 [label="Jak miałbym nim być, po tym, jak byłem świadkiem jego kłamstw i zdrady, a to, jak zmanipulował Marię, w dalszym ciągu odbija się nam czkawką? Nie, z pewnością nie jestem jego sojusznikiem.",shape=box,color=blue];
		j2714492661 -> j4257031157;
	j3152573193 [label="...nie do wytrzymania. Wolałbym skupić się na występkach Entratiego, jeśli nie zrobi ci to różnicy.",shape=box,color=blue];
		j3152573193 -> j1428371468;
	j2104046610 [label="Mówiła mi, że czasami dostrzegasz rzeczy, których inni nie widzą.",shape=box,color=red];
		j2104046610 -> j2862727163;
	j92265762 [label="No i? ",shape=box,color=red];
		j92265762 -> j724076232;
	j4036841203 [label="Maria wierzy, że każda dusza jest dobra. To umiejętność, którą doskonaliła i rozstawiała niczym tarczę przed otaczającym ją światem.",shape=box,color=blue];
		j4036841203 -> j3774293686;
		j4036841203 -> j2516863647;
	j4257031157 [label="+5 Chemistry",color=orange];
		j4257031157 -> j3141129593;
	j1428371468 [label="Check boolean RoatheSerum1",color=orange];
		j1428371468 -> j33727187 [label=true,color=green];
		j1428371468 -> j3535435418 [label=true,color=green];
		j1428371468 -> j33727187 [label=false,color=brown];
		j1428371468 -> j1803320593 [label=false,color=brown];
	j2862727163 [label="I co byś z tym zrobił Włóczęgo, gdyby to była prawda?",shape=box,color=blue];
		j2862727163 -> j2821822155;
	j724076232 [label="\"No i\" nic. Jak byłem świadkiem tego wydarzenia, powiedziałem ci, jak to wyglądało z mojej strony. I to tyle.",shape=box,color=blue];
		j724076232 -> j4036841203;
	j3774293686 [label="Maria nie wie, do czego naprawdę zdolny jest Entrati, tak jak nie zdaje sobie sprawy z tych wszystkich okropieństw, których dokonał w imię \"postępu\", a teraz \"odkupienia\".",shape=box,color=red];
		j3774293686 -> j217867609;
	j2516863647 [label="Maria jest dorosłą kobietą. Choć podziwiam twoją chęć roztoczenia parasola ochronnego wokół niej, sama może decydować, w co chce wierzyć i komu ufać.",shape=box,color=red];
		j2516863647 -> j816196713;
	j3141129593 [label="Okaleczenie ciał, zniszczenie naszej przyszłości i zepsucie przeszłości – może jestem w stanie to wszystko wybaczyć.",shape=box,color=blue];
		j3141129593 -> j1403050024;
	j33727187 [label="Może i Entrati nie ma najlepszych manier, ale stara się uratować wszechświat.",shape=box,color=red];
		j33727187 -> j3141129593;
	j3535435418 [label="Zmusił cię do zostania protoframem, jak Roathe'a?",shape=box,color=red];
		j3535435418 -> j2932887851;
	j1803320593 [label="Jasne. Dlaczego jesteś zły na Entratiego?",shape=box,color=red];
		j1803320593 -> j4257031157;
	j2821822155 [label="Check boolean LyonVisions1",color=orange];
		j2821822155 -> j1999343012 [label=true,color=green];
		j2821822155 -> j4072950588 [label=true,color=green];
		j2821822155 -> j1883527135 [label=true,color=green];
		j2821822155 -> j1999343012 [label=false,color=brown];
		j2821822155 -> j3975996264 [label=false,color=brown];
		j2821822155 -> j4072950588 [label=false,color=brown];
	j217867609 [label="Zaufanie jest niczym witraż. Delikatne, gdy się tworzy. Piękne w swej okazałości. Tragiczne, gdy się zbije. I niebezpieczne, gdy ktoś je zniszczy.",shape=box,color=blue];
		j217867609 -> j2650125770;
	j816196713 [label="Zaufanie jest niczym witraż. Delikatne, gdy się tworzy. Piękne w swej okazałości. Tragiczne, gdy się zbije. I niebezpieczne, gdy ktoś je zniszczy.",shape=box,color=blue];
		j816196713 -> j1945714844;
	j1403050024 [label="Ale patrzeć, jak skrzywdził Marię... wykorzystał jej wiarę w dobroć innych dla własnych celów?",shape=box,color=blue];
		j1403050024 -> j2543448167;
	j2932887851 [label="Nie. Miałem swój powód, by przyjąć eliksir. Dobrze wiedziałem, jak pokręconą kreaturą się stanę. Maria też.",shape=box,color=blue];
		j2932887851 -> j3670828003;
	j1999343012 [label="Chyba mnie to za bardzo nie obchodzi.",shape=box,color=red];
		j1999343012 -> j814979273;
	j4072950588 [label="Nasuwa mi się tylko jedno pytanie: czy twoje wizje ci przeszkadzają?",shape=box,color=red];
		j4072950588 -> j2344466313;
	j1883527135 [label="Przez to, co powiedziałeś ostatnio, zacząłem się zastanawiać, czy wszystko u ciebie w porządku.",shape=box,color=red];
		j1883527135 -> j3381081297;
	j3975996264 [label="Zastanawia mnie tylko, czy wszystko u ciebie w porządku.",shape=box,color=red];
		j3975996264 -> j3381081297;
	j2650125770 [label="+15 Chemistry",color=orange];
		j2650125770 -> j1526189318;
	j1945714844 [label="Pławi się w ciepłym świetle Sol, nie dostrzegając skaz, które tworzą się na powierzchni. Nie słysząc pogłębiających się pęknięć.",shape=box,color=blue];
		j1945714844 -> j1447606884;
	j2543448167 [label="Tego mu nigdy nie wybaczę. Za to pragnę wbić w jego ciało kadzielnicę, aż zacznie błagać o zbawienie.",shape=box,color=blue];
		j2543448167 -> j3774293686;
		j2543448167 -> j2516863647;
	j3670828003 [label="Nie zostaliśmy... złamani siłą, jak diabeł. W głębi serca współczułem Roathe'owi, że musiał przez to przejść.",shape=box,color=blue];
		j3670828003 -> j2517945028;
	j814979273 [label="W takim razie nie widzę potrzeby kontynuowania tej rozmowy.",shape=box,color=blue];
		j814979273 -> "Chat ends.";
	j2344466313 [label="Powiem wprost, Włóczęgo, że nie wiem, jak mam na to odpowiedzieć.",shape=box,color=blue];
		j2344466313 -> j4136856768;
	j3381081297 [label="Boolean LyonAllRight is now true.",color=orange];
		j3381081297 -> j2895896893;
	j1526189318 [label="Gdybym tylko mógł przejąć to zepsucie, które zasiał w jej umyśle. Pozostaje mi tylko modlić się, aby udało ci się dokonać tego, w czym ja poniosłem porażkę.",shape=box,color=blue];
		j1526189318 -> j3651491667;
	j1447606884 [label="Nieświadoma, że odłamki jej własnego arcydzieła wkrótce obrócą się przeciwko niej. Postanowiła nie dostrzegać tego, co nieuchronnie nastąpi.",shape=box,color=blue];
		j1447606884 -> j1056154057;
	j2517945028 [label="A później otworzył usta i zaczął mówić.",shape=box,color=blue];
		j2517945028 -> j4107747604;
		j2517945028 -> j2978878563;
	"Chat ends." [color=orange];
	j4136856768 [label="Przez całe życie widuję koszmary, przez które inni trafiliby do zakładu psychiatrycznego. Co gorsza, od czasu do czasu moje wizje się urzeczywistniały.",shape=box,color=blue];
		j4136856768 -> j92712514;
	j2895896893 [label="Czy wszystko ze mną \"w porządku\"? Powiem wprost, Włóczęgo, że nie wiem, jak mam na to odpowiedzieć.",shape=box,color=blue];
		j2895896893 -> j4136856768;
	j3651491667 [label="O. Leon Allard",shape=box,color=blue];
		j3651491667 -> "Chat ends.";
	j1056154057 [label="Gdybym tylko mógł cierpieć za nią, jakże chętnie wytatuowałbym to w swojej duszy. Ale to jest przeznaczone jej i tylko jej.",shape=box,color=blue];
		j1056154057 -> j4234192014;
	j4107747604 [label="Trzeba pamiętać, w jakich warunkach się wychowywał. W jakim środowisku przyszło mu nauczyć się przetrwania. To był – a w zasadzie jest – Orokin.",shape=box,color=red];
		j4107747604 -> j512118456;
		j4107747604 -> j2105925454;
	j2978878563 [label="Szczerze mówiąc, to nie uważam, że jest taki zły. Chyba zaczynam go lubić.",shape=box,color=red];
		j2978878563 -> j1556334521;
	j92712514 [label="Boolean LyonVisions1 is now true.",color=orange];
		j92712514 -> j424781057;
	j4234192014 [label="Zamiast tego postaram się zapobiec temu bólowi, Włóczęgo. ",shape=box,color=blue];
		j4234192014 -> j2318891035;
	j512118456 [label="To go nie usprawiedliwia, ale choć trochę pozwala go zrozumieć.",shape=box,color=red];
		j512118456 -> j1715401237;
	j2105925454 [label="Robi to, co uważa za konieczne.",shape=box,color=red];
		j2105925454 -> j2251683599;
	j1556334521 [label="Na twoim miejscu poszedłbym do p. Loida po maść na tę dolegliwość. Żeby się nie rozprzestrzeniła.",shape=box,color=blue];
		j1556334521 -> j3485492484;
		j1556334521 -> j2099776436;
	j424781057 [label="Boolean LyonBackstory1 is now true.",color=orange];
		j424781057 -> j3927496404;
	j2318891035 [label="A że ty dostrzegasz w tym akcie próbę umniejszenia jej?",shape=box,color=blue];
		j2318891035 -> j317406313;
	j1715401237 [label="Add 1 to Thermostat counter",color=orange];
		j1715401237 -> j2171339813;
	j2251683599 [label="Add -1 to Thermostat counter",color=orange];
		j2251683599 -> j1700403;
	j3485492484 [label="Diabeł musi mieć w sobie odrobinę uroku.",shape=box,color=red];
		j3485492484 -> j2654593842;
	j2099776436 [label="Nie martw się, nie dam się zwieść jego urokowi.",shape=box,color=red];
		j2099776436 -> j1197224389;
	j3927496404 [label="I dlatego uważałem ich za przewodników Lua. Sądziłem, że zostałem wybrany przez Świetlistych do dźwigania takiego brzemienia. A przynajmniej tak mi się wtedy wydawało. Właśnie dlatego zainteresowałem się kapłaństwem.",shape=box,color=blue];
		j3927496404 -> j951064513;
		j3927496404 -> j1388440444;
		j3927496404 -> j1931825708;
	j317406313 [label="Niech Lua zlituje się nad twą duszą.",shape=box,color=blue];
		j317406313 -> j3651491667;
	j2171339813 [label="Zgodnie z naszą świętą księgą z diabłem się nie negocjuje – jego się przepędza. Ale na tę konkretną sytuację nas nie przygotowano.",shape=box,color=blue];
		j2171339813 -> j927282942;
	j1700403 [label="Możliwe. Nie jestem jednak pewien, czy w sercu tej kreatury jest miejsce na wątpliwości.",shape=box,color=blue];
		j1700403 -> j927282942;
	j2654593842 [label="Add -1 to Thermostat counter",color=orange];
		j2654593842 -> j2385632920;
	j1197224389 [label="Add 1 to Thermostat counter",color=orange];
		j1197224389 -> j596537308;
	j951064513 [label="Wierzyłeś w to, że wizje pochodzą od Lua? Coś się zmieniło?",shape=box,color=red];
		j951064513 -> j1357017750;
	j1388440444 [label="O jakich koszmarach mówisz?",shape=box,color=red];
		j1388440444 -> j1026917655;
	j1931825708 [label="A co o tym teraz myślisz?",shape=box,color=red];
		j1931825708 -> j2846160277;
	j927282942 [label="Zobaczymy, którą ścieżkę ów diabeł obierze, prawda?",shape=box,color=blue];
		j927282942 -> j479239857;
	j2385632920 [label="I właśnie to mnie martwi. Diabeł uśmiecha się i mówi z sensem, gdy wszyscy wokół bredzą jak opętani. ",shape=box,color=blue];
		j2385632920 -> j3990516170;
	j596537308 [label="+20 Chemistry",color=orange];
		j596537308 -> j2356675129;
	j1357017750 [label="To, w co wierzę, stało się ostatnio... skomplikowane ze względu na pojawienie się nowych informacji.",shape=box,color=blue];
		j1357017750 -> j2846160277;
	j1026917655 [label="Dopiero co zaczęliśmy rozmawiać o takich rzeczach, Włóczęgo. To nie o to chodzi, że ci nie wierzę, że widziałeś największe okropieństwa na własne oczy. Albo, że potrzebowałbyś protekcji przed jakimikolwiek szczątkowymi opisami, jakie zdołałbym przywołać.",shape=box,color=blue];
		j1026917655 -> j2939549959;
	j2846160277 [label="Mówiąc najprościej, Włóczęgo, uczciwie byłoby przyznać, że nie wiem, w co mam wierzyć.",shape=box,color=blue];
		j2846160277 -> j411574698;
	j479239857 [label="O. Leon Allard",shape=box,color=blue];
		j479239857 -> j367054140;
	j3990516170 [label="Zaskakuje nas w najmniej oczekiwanym momencie – gdy jesteśmy bezbronni. Gdy jesteśmy słabi. Gdy potrzebujemy odpowiedzi.",shape=box,color=blue];
		j3990516170 -> j2005118773;
		j3990516170 -> j4276142804;
	j2356675129 [label="To dobrze. Dopilnuj, żeby tak pozostało. Nie chciałbym być zmuszony wbijać ci rozum do głowy. Wyglądasz na kogoś, kto nie pozostaje dłużny.",shape=box,color=blue];
		j2356675129 -> j2085940585;
	j2939549959 [label="Po prostu nie podejmuję takich tematów z kimś, kogo dopiero poznałem, by go nie wystraszyć mą osobą. Wolałbym uniknąć takiej sytuacji, w której bylibyśmy zmuszeni do współpracy, nawet na krótko.",shape=box,color=blue];
		j2939549959 -> j3626145497;
		j2939549959 -> j2504833636;
	j411574698 [label="Boolean LyonFaith1 is now true.",color=orange];
		j411574698 -> j3603798029;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
	j2005118773 [label="Dam sobie radę. Obiecuję, że nie pozwolę mu sobą manipulować.",shape=box,color=red];
		j2005118773 -> j596537308;
	j4276142804 [label="Brzmisz, jakbyś to mówił na podstawie własnych doświadczeń. Jakich odpowiedzi ci udzielił?",shape=box,color=red];
		j4276142804 -> j215050063;
	j2085940585 [label="A wtedy znaleźlibyśmy się w bardzo dziwnym położeniu?",shape=box,color=blue];
		j2085940585 -> "Chat ends.";
	j3626145497 [label="Jeśli chcesz zaczekać, aż nabierzesz do mnie większego zaufania, to rozumiem.",shape=box,color=red];
		j3626145497 -> j3604316460;
	j2504833636 [label="Nigdzie się nie wybieram, Leonie. Możesz mi zaufać.",shape=box,color=red];
		j2504833636 -> j1525444581;
	j3603798029 [label="Obawiam się jednak, że to rozmowa na inny dzień.",shape=box,color=blue];
		j3603798029 -> j2328488056;
	j215050063 [label="Takich, które jak się tego obawiałem... podawały w wątpliwość wiele rzeczy. Ale obawiam się, że to temat na inną dyskusję.",shape=box,color=blue];
		j215050063 -> j4061301356;
	j3604316460 [label="+20 Chemistry",color=orange];
		j3604316460 -> j1726034446;
	j1525444581 [label="+15 Chemistry",color=orange];
