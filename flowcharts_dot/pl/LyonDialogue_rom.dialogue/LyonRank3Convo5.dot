		j4061301356 -> j3641547327;
	j1726034446 [label="Dziękuję. Nie chodzi o to, że nie wierzę w szczerość twoich słów. Moje dotychczasowe doświadczenia nauczyły mnie ostrożności.",shape=box,color=blue];
		j1726034446 -> j1762874307;
	j1921807926 [label="Nie chodzi o to, że nie wierzę w szczerość twoich słów. Moje dotychczasowe doświadczenia nauczyły mnie ostrożności. ",shape=box,color=blue];
