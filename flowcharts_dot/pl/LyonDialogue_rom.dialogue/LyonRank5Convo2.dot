		j680575522 -> j1239602471 [label="LyonBackstory1",color=purple];
		j680575522 -> j2068082338 [label="false",color=purple];
	j374024424 [label="+20 Chemistry",color=orange];
		j374024424 -> j3653880603;
	j2904821152 [label="Przyjacielu, jesteś dla mnie wyrozumiały i znacznie bardziej życzliwy, niż mógłbym prosić. Wiem, że zapewne rozważałeś nad tą częścią mojej historii – nad tą nocą, gdy Lua była spowita ciemnością.",shape=box,color=blue];
		j2904821152 -> j3105186150;
	j54198243 [label="Przyjacielu, jesteś dla mnie wyrozumiały. Wiem, że zapewne rozważałeś nad tą częścią mojej historii – nad tą nocą, gdy Lua była spowita ciemnością.",shape=box,color=blue];
		j54198243 -> j3105186150;
	j1239602471 [label="Przyjacielu, ciekawiła cię moja przeszłość. I wiem, że zapewne rozważałeś nad tą częścią mojej historii – nad tą nocą, gdy Lua była spowita ciemnością.",shape=box,color=blue];
		j1239602471 -> j3105186150;
	j2068082338 [label="Przyjacielu, wiem, że zapewne rozważałeś nad moją historią i tą nocą, gdy Lua była spowita ciemnością.",shape=box,color=blue];
		j2068082338 -> j3105186150;
	j3653880603 [label="[Rozmowa pominięta ze względu na poprzednie ustawienia ostrzeżeń]",shape=box,color=blue];
		j3653880603 -> j370687875;
	j3105186150 [label="To opowieść, której przysięgałem sobie nigdy nie wyjawić. Zna ją tylko Maria, gdyż przeczytała ją w mym dzienniku. A teraz zamierzam się nią podzielić z tobą.",shape=box,color=blue];
		j3105186150 -> j1152134892;
	j370687875 [label="Boolean LyonConfession1 is now true.",color=orange];
		j370687875 -> "Chat ends.";
	j1152134892 [label="Kiedy już zacznę, to nie będę mógł przestać i nie będę w stanie opowiedzieć jej na nowo. Musisz mi więc wybaczyć, jeśli nie pozwolę ci zadawać żadnych pytań.",shape=box,color=blue];
		j1152134892 -> j4078368848;
		j1152134892 -> j2568965975;
		j1152134892 -> j3419747780;
		j1152134892 -> j322178720;
	"Chat ends." [color=orange];
	j4078368848 [label="Oczywiście.",shape=box,color=red];
		j4078368848 -> j2996057401;
	j2568965975 [label="[Pozwól mu dokończyć]",shape=box,color=red];
		j2568965975 -> j440983087;
	j3419747780 [label="[Ostrzeżenie: Rozmowa na temat samookaleczania i znęcania się nad dzieckiem. Kliknij tutaj, aby zakończyć. Nie spowoduje to utraty Chemii z Leonem]",shape=box,color=red];
		j3419747780 -> j784838610;
	j322178720 [label="[Koniec]",shape=box,color=red];
		j322178720 -> j3856020424;
	j2996057401 [label="Dziękuję.",shape=box,color=blue];
		j2996057401 -> j141195667;
	j440983087 [label="+5 Chemistry",color=orange];
		j440983087 -> j2996057401;
	j784838610 [label="Check boolean LyonSpeech",color=orange];
		j784838610 -> j3342655806 [label=true,color=green];
		j784838610 -> j483320361 [label=false,color=brown];
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j141195667 [label="Evaluate expressions",color=orange];
		j141195667 -> j1475383672 [label="LyonBackstory3a",color=purple];
		j141195667 -> j1475383672 [label="LyonBackstory3b",color=purple];
		j141195667 -> j3185008900 [label="false",color=purple];
	j3342655806 [label="+20 Chemistry",color=orange];
		j3342655806 -> j370687875;
	j483320361 [label="Jeśli uważasz się za tchórza z powodu podjęcia tego wyboru, to błagam, ale nie musisz się tak czuć. Ten ból nie jest twój. Należy do mnie. Nie prosiłeś o to, by znaleźć się w takim położeniu.",shape=box,color=blue];
		j483320361 -> j140443515;
	j1475383672 [label="Rozmawialiśmy o mojej rodzinie. O czasie spędzonym na farmie, na której się wychowywałem. O wizjach, które mnie dręczyły i zmuszały do przemocy.",shape=box,color=blue];
		j1475383672 -> j370216218;
	j3185008900 [label="Wiem, że niewiele opowiedziałem ci o ludziach, którzy mnie wychowywali. I obawiam się, że nie bez powodu.",shape=box,color=blue];
		j3185008900 -> j3324847392;
	j140443515 [label="To mechaniczne urządzenie, na którym siedzimy, sprawia takie wrażenie, jakby skrywało w sobie jakąś bezduszność. Że zapewnia nam w pewien sposób ochronę przed wszelkimi krzywdami, jakie ktoś mógłby nam wyrządzić wypowiadanymi słowami.",shape=box,color=blue];
		j140443515 -> j2496683616;
	j370216218 [label="Opowiadałem ci o głosach, których szepty słyszałem. Nawoływały mnie z innych pokojów. Czasami brzmiały tak, jakby wołały mnie po imieniu.",shape=box,color=blue];
		j370216218 -> j2624832530;
	j3324847392 [label="Moja matka... uważała moje wizje za dzieło diabła. I próbowała je wybić mi z głowy siłą. Często biła tak długo, aż nie byłem już w stanie ustać.",shape=box,color=blue];
		j3324847392 -> j3580875144;
	j2496683616 [label="Powiedziałbym raczej coś przeciwnego – uwalniając się od zbroi, którą zakładamy podczas codziennych interakcji międzyludzkich, zostajemy pozbawieni podstawowej ochrony.",shape=box,color=blue];
		j2496683616 -> j225359025;
	j2624832530 [label="Innym razem brzmiały zupełnie niezrozumiale. Niczym bełkot albo język diabła.",shape=box,color=blue];
		j2624832530 -> j2790432583;
	j3580875144 [label="A mój ojciec? No cóż. Przy całym okrucieństwie matki, to ojciec był gorszy. Oszczędzę ci szczegółów.",shape=box,color=blue];
		j3580875144 -> j3427200522;
	j225359025 [label="Dlatego w sytuacjach takich jak ta... zdaję sobie sprawę, że wypuszczam strzałę, która może trafić nie w przygotowanego do bitwy żołnierza, ale w tętnicę niczego niespodziewającego się jelenia w lesie.",shape=box,color=blue];
		j225359025 -> j1659457187;
	j2790432583 [label="Z początku te bezsensowne brednie mnie przerażały. Błagałem, by miały sens. Modliłem się do Lua, aby jej duchy mi powiedziały, czego ode mnie chcą.",shape=box,color=blue];
		j2790432583 -> j1286870961;
	j3427200522 [label="Ale ich przemoc miała silną konkurencję w postaci mojej przemocy. Wizje często sprawiały, że trudno było się im przeciwstawić – zwłaszcza wtedy, gdy już trochę dorosłem. Byłem silniejszy i bardziej postawny nawet niż mój ociec.",shape=box,color=blue];
		j3427200522 -> j2277382081;
	j1659457187 [label="Zatem zostawię cię z tą myślą:",shape=box,color=blue];
		j1659457187 -> j1797968556;
	j1286870961 [label="Ale gdy zacząłem rozszyfrowywać, czego pragną... szybko pożałowałem tego, o co tak rozpaczliwie się modliłem. Wiedziałem już, jakich czynów się domagały.",shape=box,color=blue];
		j1286870961 -> j131822571;
	j2277382081 [label="Wizje często przyjmowały formę głosów. Czasami brzmiały tak, jakby wołały mnie po imieniu.",shape=box,color=blue];
		j2277382081 -> j2624832530;
	j1797968556 [label="Musimy przypomnieć sobie, jak znaleźć w sobie siłę, aby postawić kogoś na nogi, nawet jeśli sami nie jesteśmy w stanie powstać.",shape=box,color=blue];
		j1797968556 -> j317822115;
	j131822571 [label="I cóż za straszliwą cenę przyszło im za to zapłacić.",shape=box,color=blue];
		j131822571 -> j1704134991;
	j317822115 [label="To jest właśnie prawdziwy cel opowieści.",shape=box,color=blue];
		j317822115 -> j1418907955;
	j1704134991 [label="Nie zrozum mnie źle. Nie kochałem ani ojca ani matki. Wszelka rodzinna więź, jaką mogłem do nich czuć, już dawno zniknęła pod litanią siniaków i blizn.",shape=box,color=blue];
		j1704134991 -> j2764220641;
	j1418907955 [label="+20 Chemistry",color=orange];
		j1418907955 -> j1214205907;
	j2764220641 [label="A co chciały te głosy, bym dla nich zrobił...? I do czego mnie nakłaniali podczas najmroczniejszych nocy...?",shape=box,color=blue];
		j2764220641 -> j1945634628;
	j1214205907 [label="Bądź zdrów, Włóczęgo. Wkrótce znów porozmawiamy.",shape=box,color=blue];
		j1214205907 -> j513918344;
	j1945634628 [label="Dopiero co przestałem być chłopcem – ale jeszcze nie byłem mężczyzną. Miałem może z szesnaście lat? Albo osiemnaście? Z początku myślałem, że to kolejny koszmar – pokręcony sen.",shape=box,color=blue];
		j1945634628 -> j3828960718;
	j513918344 [label="O. Leon Allard",shape=box,color=blue];
		j513918344 -> j370687875;
	j3828960718 [label="Wokół mnie stały postacie, wychudzone, pokrzywione, stworzone wyłącznie z podłości i cienia.",shape=box,color=blue];
		j3828960718 -> j2203969149;
	j2203969149 [label="Dręczyły mnie, żądały, abym zrobił to, co trzeba – że jeśli ci, którzy rzekomo mnie kochali, zapragną mojego ciała... będą musieli poświęcić swoje...",shape=box,color=blue];
		j2203969149 -> j1529559402;
	j1529559402 [label="Gdy obudziłem się z koszmaru – a może nigdy nie zasnąłem, ciężko teraz stwierdzić – trzymałem w ręku nóż myśliwski. I stałem przed drzwiami do sypialni rodziców.",shape=box,color=blue];
		j1529559402 -> j2507674356;
	j2507674356 [label="Księżyc był w nowiu. A niebo spowijała gęsta warstwa chmur. Nie było nawet najmniejszego promienia światła, które by pozwalało coś dostrzec. Panowała absolutna ciemność.",shape=box,color=blue];
		j2507674356 -> j2276895696;
	j2276895696 [label="Lua mnie opuściła.",shape=box,color=blue];
		j2276895696 -> j1059480554;
	j1059480554 [label="Nie mogłem odpowiedzieć na to wezwanie. Nie mogłem im dać dusz moich rodziców.",shape=box,color=blue];
		j1059480554 -> j2400246056;
	j2400246056 [label="Uciekłem w ciemną noc. W gęsty las, gdzie gałęzie kaleczyły mą nagą skórę, choć wcale nie czułem bólu.",shape=box,color=blue];
		j2400246056 -> j2790375741;
	j2790375741 [label="Biegłem, aż nogi się pode mną ugięły, odmawiając posłuszeństwa. Może płakałem. Nie pamiętam.",shape=box,color=blue];
		j2790375741 -> j3894854264;
	j3894854264 [label="Ale wizje podążały za mną. I wciąż domagały się krwi.",shape=box,color=blue];
		j3894854264 -> j1723550851;
	j1723550851 [label="Liczyłem na to, że jeśli nie będę ich widzieć, to odejdą... i wtedy wbiłem sobie nóż w oczodół...",shape=box,color=blue];
		j1723550851 -> j3670965926;
	j3670965926 [label="Szkoda, że straciłem przytomność i nie mogłem dokończyć. Teraz już nigdy się nie dowiem.",shape=box,color=blue];
		j3670965926 -> j3588719381;
	j3588719381 [label="Kiedy się obudziłem, byłem w miejscowej parafii Lua. Znalazł mnie Brat i opatrzył mi rany. Zapytał, przed czym tak uciekałem.",shape=box,color=blue];
		j3588719381 -> j54132710;
	j54132710 [label="Byłem wyczerpany. Nie mogłem mu skłamać. Wyznałem mu wszystko – opowiedziałem o wizjach i o tym, co mi kazały zrobić. Spodziewałem się potępienia.",shape=box,color=blue];
		j54132710 -> j4176964959;
	j4176964959 [label="Gdy skończyłem, tylko się smutno uśmiechnął i wsunął mi do ręki amulet Lua. \"Ona jest błogosławieństwem i przekleństwem, mój synu\".",shape=box,color=blue];
		j4176964959 -> j2390840323;
	j2390840323 [label="Wysłał mnie do Katedry w Cité de la Lumière. I tam pozostałem, dopóki nie znalazł mnie Entrati...",shape=box,color=blue];
		j2390840323 -> j3532202281;
	j3532202281 [label="No... i to by było na tyle.",shape=box,color=blue];
		j3532202281 -> j2527685116;
	j2527685116 [label="A teraz... muszę iść.",shape=box,color=blue];
		j2527685116 -> j3984889516;
	j3984889516 [label="Boolean LyonConfession1 is now true.",color=orange];
		j3984889516 -> j1568167793;
	j1568167793 [label="+20 Chemistry",color=orange];
		j1568167793 -> j2517419488;
	j2517419488 [label="Leon",shape=box,color=blue];
		j2517419488 -> "Chat ends.";
}