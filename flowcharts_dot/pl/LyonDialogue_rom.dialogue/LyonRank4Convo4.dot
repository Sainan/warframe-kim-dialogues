		j781860406 -> j2861596119;
	j416549260 [label="Po jej włosach pozostało zaledwie kilka siwych kosmyków, które bezładnie zwisały z głowy. Ale to jej oczy zapamiętam najbardziej. ",shape=box,color=blue];
		j416549260 -> j3306259858;
