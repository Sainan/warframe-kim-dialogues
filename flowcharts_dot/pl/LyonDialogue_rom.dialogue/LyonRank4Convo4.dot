		j1584197471 -> j3986101400 [label="false",color=purple];
	j1147585806 [label="Nie, wybacz mi. Ja... przepraszam za mój brak obycia.",shape=box,color=blue];
		j1147585806 -> j2165405540;
	j962369713 [label="Leonie, jeśli wolisz, żebym dał ci spokój, to po prostu powiedz.",shape=box,color=red];
