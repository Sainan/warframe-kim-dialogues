		j2698478763 -> j1048892711 [label=false,color=brown];
	j2774582797 [label="Moja matka już dawno nie żyła, gdy tu trafiliśmy. A obecnie pozostały po niej tylko prochy. Żyła w nieszczęściu... które była skazana szerzyć.",shape=box,color=blue];
		j2774582797 -> j3417271800;
