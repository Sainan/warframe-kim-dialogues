		j3796952290 -> j4207708300;
	j1784013549 [label="Trzy miesiące później w jednym z domów w naszej wiosce znaleziono martwą kobietę. Jej oczy wygryzły szczury.",shape=box,color=blue];
		j1784013549 -> j3635164589;
	j4207708300 [label="Trzy miesiące później w jednym z domów w naszej wiosce znaleziono martwą kobietę. Jej oczy wygryzły szczury.",shape=box,color=blue];
		j4207708300 -> j936951575;
	j3635164589 [label="Opowiedziałem swojej matce o tym, co zobaczyłem, gdy obudziła mnie wizja. Zapamiętała to tak samo, jak ja.",shape=box,color=blue];
		j3635164589 -> j904930183;
		j3635164589 -> j2251336704;
	j936951575 [label="Tak, Włóczęgo. Te wizje mnie przerażały.",shape=box,color=blue];
		j936951575 -> j3635164589;
	j904930183 [label="I co zrobiła?",shape=box,color=red];
		j904930183 -> j3588121360;
	j2251336704 [label="Uważała to za zbieg okoliczności czy za znak?",shape=box,color=red];
		j2251336704 -> j597055781;
	j3588121360 [label="Zbiła mnie rózgą, aż nie byłem w stanie ustać na nogach. Krwawiłem z pleców tak, że musiałem spać na brzuchu. Wciąż pamiętam jej krzyki, gdy mnie biła. \"Diable! Sorcier!\".",shape=box,color=blue];
		j3588121360 -> j2335794411;
		j3588121360 -> j296107292;
		j3588121360 -> j1460171992;
		j3588121360 -> j507881817;
	j597055781 [label="Pojęcia nie mam. Wiem tylko, że zbiła mnie rózgą, aż nie byłem w stanie ustać na nogach. Krwawiłem z pleców tak, że musiałem spać na brzuchu. Wciąż pamiętam jej krzyki, gdy mnie biła. \"Diable! Sorcier!\".",shape=box,color=blue];
		j597055781 -> j2335794411;
		j597055781 -> j296107292;
		j597055781 -> j1460171992;
		j597055781 -> j507881817;
	j2335794411 [label="Ile miałeś lat?",shape=box,color=red];
		j2335794411 -> j1779411637;
	j296107292 [label="Och, Leonie... tak mi przykro...",shape=box,color=red];
		j296107292 -> j1633086734;
	j1460171992 [label="To straszne...",shape=box,color=red];
		j1460171992 -> j1633086734;
	j507881817 [label="Była nieświadoma. Nie wiedziała, co zrobić.",shape=box,color=red];
		j507881817 -> j1633086734;
	j1779411637 [label="Może ze cztery. Nie więcej niż sześć. Nie pamiętam. Nie liczyliśmy lat z taką samą gorliwością, jak to się robi obecnie.",shape=box,color=blue];
		j1779411637 -> j2698478763;
