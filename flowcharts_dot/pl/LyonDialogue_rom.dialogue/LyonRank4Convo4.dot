		j2841275710 -> j1584197471;
	j3360163451 [label="Nie było tematu, jeśli wolisz o tym nie mówić.",shape=box,color=red];
		j3360163451 -> j1147585806;
	j2756698779 [label="Po prostu sądzę, że istnieją lepsze sposoby na spożytkowanie energii. Na przykład obrona twierdzy przed nadciągającą grupą wrogów, odkrywanie nieznanej wiedzy... lub składanie ubrań.",shape=box,color=blue];
