		j4264431667 -> j347980266;
	j2340186080 [label="Obrałeś już jakąś ścieżkę? A może twoje nerwy są jeszcze bardziej zszargane niż moje?",shape=box,color=blue];
		j2340186080 -> j1407489519;
		j2340186080 -> j32235478;
	j3986101400 [label="+5 Chemistry",color=orange];
		j3986101400 -> j3833674409;
	j2165405540 [label="Często zupełnie nie wiem, jak należy zareagować w tego typu sytuacjach, gdy ktoś najzwyczajniej w świecie jest ciekawy czyjejś historii. Albo, gdy próbuje nawiązać przyjacielską więź.",shape=box,color=blue];
		j2165405540 -> j264227175;
	j2658648232 [label="+5 Chemistry",color=orange];
		j2658648232 -> j1147585806;
	j347980266 [label="Tak, i właśnie ten... sentyment napawa mnie coraz większym niepokojem. Dla mojego spokoju ducha po prostu potwierdź, że masz na myśli to, czego coraz bardziej się obawiam.",shape=box,color=blue];
		j347980266 -> j989482455;
		j347980266 -> j3562477983;
	j1407489519 [label="Przepraszam, że cię wcześniej ignorowałem...",shape=box,color=red];
		j1407489519 -> j752594762;
	j32235478 [label="Co masz na myśli...?",shape=box,color=red];
		j32235478 -> j752594762;
	j3833674409 [label="Muszę przyznać, że twój dobór słów sprawia, że zaczynam się robić nerwowy. Choć nie jestem pewien, czy rozumiesz je tak, jak ja je interpretuję.",shape=box,color=blue];
		j3833674409 -> j989482455;
		j3833674409 -> j3562477983;
	j264227175 [label="Tak czy inaczej – pytałeś o moją przeszłość, prawda?",shape=box,color=blue];
		j264227175 -> j2701648559;
	j989482455 [label="W takim razie rozwieję twoje wątpliwości – nie żywię do ciebie uczuć.",shape=box,color=red];
		j989482455 -> j3545129562;
	j3562477983 [label="Czy tak trudno jest ci uwierzyć, że mogę coś do ciebie czuć, Leonie?",shape=box,color=red];
		j3562477983 -> j3781307335;
	j752594762 [label="Zaprzestałeś pogoni z równym zapałem, z jakim ją rozpocząłeś. Założyłem, że słusznie uznałeś to za błędną decyzję.",shape=box,color=blue];
		j752594762 -> j1689572145;
		j752594762 -> j2065295078;
	j2701648559 [label="Pewnie zdążyłeś już zauważyć, że miewam... wizje. Są one częścią mojego życia, odkąd byłem małym dzieckiem.",shape=box,color=blue];
		j2701648559 -> j2683520278;
	j3545129562 [label="Nie chciałem cię zbywać, ale dobrze jest wiedzieć, na czym stoimy. Ja... przepraszam za mój brak obycia.",shape=box,color=blue];
		j3545129562 -> j2165405540;
	j3781307335 [label="Boolean DrifterLyon is now true.",color=orange];
