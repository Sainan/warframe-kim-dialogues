	j4255564332 [label="+5 Chemistry",color=orange];
		j4255564332 -> j31472741;
	j3480095926 [label="Wolałbyś, żebym przestał?",shape=box,color=red];
		j3480095926 -> j781860406;
	j2525093411 [label="Była tak chuda i słabowita, że wyglądała, jakby umarła i została pochowana lata temu. Skóra tak ściśle przylegała do jej kości, że było widać ich dokładne kształty.",shape=box,color=blue];
		j2525093411 -> j416549260;
	j263536163 [label="Była tak chuda i słabowita, że wyglądała, jakby umarła i została pochowana lata temu. Skóra tak ściśle przylegała do jej kości, że było widać ich dokładne kształty.",shape=box,color=blue];
		j263536163 -> j445114330;
	j31472741 [label="Ja... ostrożnie patrzę z nadzieją, dokąd mnie ta droga zaprowadzi. A teraz – pytałeś o moją przeszłość, prawda?",shape=box,color=blue];
		j31472741 -> j3766035461;
