		974 -> 976 [label="false",color=purple];
	973 [label="+20 Chemistry",color=orange];
		973 -> 975;
	979 [label="Obawiam się, że to nie jest zbyt przyjemna historia. Mówiłem ci o wizjach, przez które trafiłem do Katedry, by oddawać cześć Świetlistym, a także o dziadkach, którzy poznali się podczas rewolucji galijskiej. Na pewno chcesz tracić swój cenny czas na takie rzeczy?",shape=box,color=blue];
		979 -> 981;
		979 -> 982;
		979 -> 980;
	978 [label="Obawiam się, że to nie jest zbyt przyjemna historia. Mówiłem ci o wizjach, przez które trafiłem do Katedry, by oddawać cześć Świetlistym. Na pewno chcesz tracić swój cenny czas na takie rzeczy?",shape=box,color=blue];
		978 -> 981;
		978 -> 982;
		978 -> 980;
	977 [label="Obawiam się, że to nie jest zbyt przyjemna historia. Mówiłem ci o moich dziadkach, którzy poznali się podczas rewolucji galijskiej. Na pewno chcesz tracić swój cenny czas na takie rzeczy?",shape=box,color=blue];
		977 -> 981;
		977 -> 982;
		977 -> 980;
	976 [label="Obawiam się, że nie jest to zbyt przyjemna historia. Na pewno chcesz tracić swój cenny czas na takie rzeczy?",shape=box,color=blue];
		976 -> 980;
	975 [label="Chat ends.",color=orange];
	981 [label="Dlaczego uważasz to za stratę czasu?",shape=box,color=red];
		981 -> 984;
	982 [label="Dla mnie to nie jest strata czasu, Leonie. Bardzo chciałbym cię lepiej poznać.",shape=box,color=red];
		982 -> 985;
	980 [label="Nie było tematu, jeśli wolisz o tym nie mówić.",shape=box,color=red];
		980 -> 983;
	984 [label="Po prostu sądzę, że istnieją lepsze sposoby na spożytkowanie energii. Na przykład obrona twierdzy przed nadciągającą grupą wrogów, odkrywanie nieznanej wiedzy... lub składanie ubrań.",shape=box,color=blue];
		984 -> 987;
		984 -> 988;
	985 [label="Evaluate expressions",color=orange];
		985 -> 991 [label="LyonFirstFlirt",color=purple];
		985 -> 989 [label="LyonFlirtIgnored",color=purple];
		985 -> 990 [label="false",color=purple];
	983 [label="Nie, wybacz mi. Ja... przepraszam za mój brak obycia.",shape=box,color=blue];
		983 -> 986;
	987 [label="Leonie, jeśli wolisz, żebym dał ci spokój, to po prostu powiedz.",shape=box,color=red];
		987 -> 993;
	988 [label="Wcale mi tego nie ułatwiasz.",shape=box,color=red];
		988 -> 983;
	991 [label="+5 Chemistry",color=orange];
		991 -> 997;
	989 [label="Obrałeś już jakąś ścieżkę? A może twoje nerwy są jeszcze bardziej zszargane niż moje?",shape=box,color=blue];
		989 -> 994;
		989 -> 995;
	990 [label="+5 Chemistry",color=orange];
		990 -> 996;
	986 [label="Często zupełnie nie wiem, jak należy zareagować w tego typu sytuacjach, gdy ktoś najzwyczajniej w świecie jest ciekawy czyjejś historii. Albo, gdy próbuje nawiązać przyjacielską więź.",shape=box,color=blue];
		986 -> 992;
	993 [label="+5 Chemistry",color=orange];
		993 -> 983;
	997 [label="Tak, i właśnie ten... sentyment napawa mnie coraz większym niepokojem. Dla mojego spokoju ducha po prostu potwierdź, że masz na myśli to, czego coraz bardziej się obawiam.",shape=box,color=blue];
		997 -> 1000;
		997 -> 1001;
	994 [label="Przepraszam, że cię wcześniej ignorowałem...",shape=box,color=red];
		994 -> 999;
	995 [label="Co masz na myśli...?",shape=box,color=red];
		995 -> 999;
	996 [label="Muszę przyznać, że twój dobór słów sprawia, że zaczynam się robić nerwowy. Choć nie jestem pewien, czy rozumiesz je tak, jak ja je interpretuję.",shape=box,color=blue];
		996 -> 1000;
		996 -> 1001;
	992 [label="Tak czy inaczej – pytałeś o moją przeszłość, prawda?",shape=box,color=blue];
		992 -> 998;
	1000 [label="W takim razie rozwieję twoje wątpliwości – nie żywię do ciebie uczuć.",shape=box,color=red];
		1000 -> 1005;
	1001 [label="Czy tak trudno jest ci uwierzyć, że mogę coś do ciebie czuć, Leonie?",shape=box,color=red];
		1001 -> 1006;
	999 [label="Zaprzestałeś pogoni z równym zapałem, z jakim ją rozpocząłeś. Założyłem, że słusznie uznałeś to za błędną decyzję.",shape=box,color=blue];
		999 -> 1003;
		999 -> 1004;
	998 [label="Pewnie zdążyłeś już zauważyć, że miewam... wizje. Są one częścią mojego życia, odkąd byłem małym dzieckiem.",shape=box,color=blue];
		998 -> 1002;
	1005 [label="Nie chciałem cię zbywać, ale dobrze jest wiedzieć, na czym stoimy. Ja... przepraszam za mój brak obycia.",shape=box,color=blue];
		1005 -> 986;
	1006 [label="Update boolean DrifterLyon",color=orange];
		1006 -> 1012;
	1003 [label="Masz rację, to jedno wielkie nieporozumienie.",shape=box,color=red];
		1003 -> 1010;
	1004 [label="Po prostu nie byłem pewien, czy moje podchody zostaną przyjęte z entuzjazmem.",shape=box,color=red];
		1004 -> 1011;
	1002 [label="Ujmując to delikatnie, rzadko kiedy te wizje były przyjemne.",shape=box,color=blue];
		1002 -> 1007;
		1002 -> 1008;
		1002 -> 1009;
	1012 [label="W skrócie? No cóż, tak... nie chcę odrzucać twoich starań. Po prostu... nie jestem przyzwyczajony... do nawiązywania relacji, Włóczęgo. Jakichkolwiek.",shape=box,color=blue];
		1012 -> 1017;
	1010 [label="Tak też myślałem. W takim razie życzę ci miłej reszty dnia.",shape=box,color=blue];
		1010 -> 1015;
	1011 [label="+5 Chemistry",color=orange];
		1011 -> 1016;
	1007 [label="Sądzisz, że te wizje pochodziły od Lua?",shape=box,color=red];
		1007 -> 1013;
	1008 [label="Co przedstawiały?",shape=box,color=red];
		1008 -> 1013;
	1009 [label="Przerażały cię?",shape=box,color=red];
		1009 -> 1014;
	1017 [label="Jeśli zdecydujesz się podążać tą drogą, nie będę cię od tego odwodził. Chyba jeszcze nigdy nie byłem w tak... obcym położeniu.",shape=box,color=blue];
		1017 -> 1021;
	1015 [label="Chat ends.",color=orange];
	1016 [label="Nie są... niemile widziane. Po prostu wprawiają w... zakłopotanie, że w ogóle są.",shape=box,color=blue];
		1016 -> 1020;
		1016 -> 1001;
	1013 [label="Pewnego razu obudziłem się w środku nocy i ujrzałem oblicze staruszki siedzącej na łóżku u mych stóp.",shape=box,color=blue];
		1013 -> 1018;
	1014 [label="Pewnego razu obudziłem się w środku nocy i ujrzałem oblicze staruszki siedzącej na łóżku u mych stóp.",shape=box,color=blue];
		1014 -> 1019;
	1021 [label="+5 Chemistry",color=orange];
		1021 -> 1025;
	1020 [label="Wolałbyś, żebym przestał?",shape=box,color=red];
		1020 -> 1024;
	1018 [label="Była tak chuda i słabowita, że wyglądała, jakby umarła i została pochowana lata temu. Skóra tak ściśle przylegała do jej kości, że było widać ich dokładne kształty.",shape=box,color=blue];
		1018 -> 1022;
	1019 [label="Była tak chuda i słabowita, że wyglądała, jakby umarła i została pochowana lata temu. Skóra tak ściśle przylegała do jej kości, że było widać ich dokładne kształty.",shape=box,color=blue];
		1019 -> 1023;
	1025 [label="Ja... ostrożnie patrzę z nadzieją, dokąd mnie ta droga zaprowadzi. A teraz – pytałeś o moją przeszłość, prawda?",shape=box,color=blue];
		1025 -> 1028;
	1024 [label="Nie, ja... nie chcę odrzucać twoich starań. Po prostu... nie jestem przyzwyczajony... do nawiązywania relacji, Włóczęgo. Jakichkolwiek.",shape=box,color=blue];
		1024 -> 1017;
	1022 [label="Po jej włosach pozostało zaledwie kilka siwych kosmyków, które bezładnie zwisały z głowy. Ale to jej oczy zapamiętam najbardziej. ",shape=box,color=blue];
		1022 -> 1026;
	1023 [label="Po jej włosach pozostało zaledwie kilka siwych kosmyków, które bezładnie zwisały z głowy. Ale to jej oczy zapamiętam najbardziej. ",shape=box,color=blue];
		1023 -> 1027;
	1028 [label="Update boolean LyonFlirt2",color=orange];
		1028 -> 998;
	1026 [label="Bo nie miała ich wcale.",shape=box,color=blue];
		1026 -> 1029;
	1027 [label="Bo nie miała ich wcale.",shape=box,color=blue];
		1027 -> 1030;
	1029 [label="Trzy miesiące później w jednym z domów w naszej wiosce znaleziono martwą kobietę. Jej oczy wygryzły szczury.",shape=box,color=blue];
		1029 -> 1031;
	1030 [label="Trzy miesiące później w jednym z domów w naszej wiosce znaleziono martwą kobietę. Jej oczy wygryzły szczury.",shape=box,color=blue];
		1030 -> 1032;
	1031 [label="Opowiedziałem swojej matce o tym, co zobaczyłem, gdy obudziła mnie wizja. Zapamiętała to tak samo, jak ja.",shape=box,color=blue];
		1031 -> 1033;
		1031 -> 1034;
	1032 [label="Tak, Włóczęgo. Te wizje mnie przerażały.",shape=box,color=blue];
		1032 -> 1031;
	1033 [label="I co zrobiła?",shape=box,color=red];
		1033 -> 1035;
	1034 [label="Uważała to za zbieg okoliczności czy za znak?",shape=box,color=red];
		1034 -> 1036;
	1035 [label="Zbiła mnie rózgą, aż nie byłem w stanie ustać na nogach. Krwawiłem z pleców tak, że musiałem spać na brzuchu. Wciąż pamiętam jej krzyki, gdy mnie biła. \"Diable! Sorcier!\".",shape=box,color=blue];
		1035 -> 1037;
		1035 -> 1038;
		1035 -> 1039;
		1035 -> 1040;
	1036 [label="Pojęcia nie mam. Wiem tylko, że zbiła mnie rózgą, aż nie byłem w stanie ustać na nogach. Krwawiłem z pleców tak, że musiałem spać na brzuchu. Wciąż pamiętam jej krzyki, gdy mnie biła. \"Diable! Sorcier!\".",shape=box,color=blue];
		1036 -> 1037;
		1036 -> 1038;
		1036 -> 1039;
		1036 -> 1040;
	1037 [label="Ile miałeś lat?",shape=box,color=red];
		1037 -> 1041;
	1038 [label="Och, Leonie... tak mi przykro...",shape=box,color=red];
		1038 -> 1042;
	1039 [label="To straszne...",shape=box,color=red];
		1039 -> 1042;
	1040 [label="Była nieświadoma. Nie wiedziała, co zrobić.",shape=box,color=red];
		1040 -> 1042;
	1041 [label="Może ze cztery. Nie więcej niż sześć. Nie pamiętam. Nie liczyliśmy lat z taką samą gorliwością, jak to się robi obecnie.",shape=box,color=blue];
		1041 -> 1043;
	1042 [label="+5 Chemistry",color=orange];
		1042 -> 1044;
	1043 [label="Check boolean LyonPainOff",color=orange];
		1043 -> 1046 [label=true,color=green];
		1043 -> 1045 [label=false,color=brown];
		1043 -> 1046 [label=false,color=brown];
	1044 [label="Moja matka już dawno nie żyła, gdy tu trafiliśmy. A obecnie pozostały po niej tylko prochy. Żyła w nieszczęściu... które była skazana szerzyć.",shape=box,color=blue];
		1044 -> 1047;
	1046 [label="Krzywdzenie dzieci... jest niewybaczalne.",shape=box,color=red];
		1046 -> 1042;
	1045 [label="Czy właśnie dlatego ty...?",shape=box,color=red];
		1045 -> 1048;
	1047 [label="Przepełniał ją lęk. Cokolwiek mnie trapiło, czy to brzemię bogów, szaleństwo – klątwa – nie była w stanie sobie z tym poradzić.",shape=box,color=blue];
		1047 -> 1049;
	1048 [label="Check boolean LyonLecture2",color=orange];
		1048 -> 1050 [label=true,color=green];
		1048 -> 1051 [label=false,color=brown];
	1049 [label="Niezależnie od tego, jak okrutna była moja matka... Ojciec był jeszcze gorszy. Oszczędzę ci szczegółów.",shape=box,color=blue];
		1049 -> 1052;
	1050 [label="Być może. Często zastanawiam się, czy nie to przyczyniło się do moich kompulsywnych zachowań. Ale jak już ci wspominałem, to również metoda stosowana przez Luę.",shape=box,color=blue];
		1050 -> 1053;
	1051 [label="Być może. Często zastanawiam się, czy nie to przyczyniło się do moich kompulsywnych zachowań. Ale to również metoda stosowana przez Luę i Świetlistych. Nie jestem w tym odosobniony.",shape=box,color=blue];
		1051 -> 1054;
	1052 [label="Z wiekiem wizje przerodziły się w głosy. Szepty, które nachodzimy mnie o każdej porze dnia i nocy. Na jawie i we śnie. Odbijało się to na mojej pracy na farmie, a później przez to cierpiałem.",shape=box,color=blue];
		1052 -> 1055;
		1052 -> 1056;
	1053 [label="+5 Chemistry",color=orange];
		1053 -> 2233;
	1054 [label="+5 Chemistry",color=orange];
		1054 -> 1058;
	1055 [label="Co cię skłoniło do zwrócenia się w stronę kościoła?",shape=box,color=red];
		1055 -> 1059;
	1056 [label="Niektórzy ludzie nie zasługują na to, by być rodzicami.",shape=box,color=red];
		1056 -> 1060;
	2233 [label="Zapewniam cię, że przynosi mi to odrobinę wytchnienia, choć rozumiem, że może to wydawać się dziwne.",shape=box,color=blue];
		2233 -> 1049;
	1058 [label="Nauczył mnie tego jeden z Ojców w Katedrze, żeby mi pomóc... oczyścić umysł. Wybrańcy Lui często otrzymują \"błogosławieństwo\" w postaci \"wizji\".",shape=box,color=blue];
		1058 -> 1061;
	1059 [label="Check boolean LyonPainOff",color=orange];
		1059 -> 1063 [label=true,color=green];
		1059 -> 1062 [label=false,color=brown];
	1060 [label="Doceniam te słowa, ale pragnę zaznaczyć, że byłem niezwykle trudnym dzieckiem do współpracy, zwłaszcza jeśli uwzględnimy to, że byłem wyższy i silniejszy od nich.",shape=box,color=blue];
		1060 -> 1059;
	1061 [label="Update boolean LyonLecture2",color=orange];
		1061 -> 1049;
	1063 [label="Moje wizje i głosy często wprawiały mnie w napady złości, Włóczęgo. Często jedynym sposobem, by otrząsnąć się z tego, co widziałem, było zadawanie sobie bólu.",shape=box,color=blue];
		1063 -> 1064;
	1062 [label="Moje wizje i głosy często wprawiały mnie w napady złości, Włóczęgo. Często brałem nóż, tnąc swoje ciało, gdyż ból był jedyną rzeczą, która mnie z nich wybudzała.",shape=box,color=blue];
		1062 -> 1064;
	1064 [label="Ale to działo się wtedy, gdy głosy kazały mi...",shape=box,color=blue];
		1064 -> 1065;
	1065 [label="Ja... nie mogę. Nie jestem w stanie. Wybacz mi. Ręce mi się trzęsą, gdy to piszę. Muszę na razie przestać.",shape=box,color=blue];
		1065 -> 1066;
		1065 -> 1067;
	1066 [label="Oczywiście. W porządku. Bez pośpiechu. Jestem tu, jeśli tylko będziesz mnie potrzebować.",shape=box,color=red];
		1066 -> 1068;
	1067 [label="Rozumiem, że to dla ciebie za dużo. Odpoczywaj, dobrze? I... dziękuję. To wiele dla mnie znaczy.",shape=box,color=red];
		1067 -> 1069;
	1068 [label="+10 Chemistry",color=orange];
		1068 -> 1070;
	1069 [label="+15 Chemistry",color=orange];
		1069 -> 1071;
	1070 [label="Dziękuję. Porozmawiamy wkrótce.",shape=box,color=blue];
		1070 -> 1072;
	1071 [label="Dla mnie również. Więcej, niż ci się zdaje. Dziękuję ci za to, przyjacielu. Do usłyszenia wkrótce.",shape=box,color=blue];
		1071 -> 1073;
	1072 [label="Update boolean LyonBackstory3b",color=orange];
		1072 -> 1074;
	1073 [label="Update boolean LyonBackstory3a",color=orange];
		1073 -> 1074;
	1074 [label="O. Leon Allard",shape=box,color=blue];
		1074 -> 1075;
	1075 [label="Chat ends.",color=orange];
