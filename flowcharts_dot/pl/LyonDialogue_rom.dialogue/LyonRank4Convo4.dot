	j4032083020 [label="Dziękuję. Porozmawiamy wkrótce.",shape=box,color=blue];
		j4032083020 -> j177636617;
	j840635206 [label="Dla mnie również. Więcej, niż ci się zdaje. Dziękuję ci za to, przyjacielu. Do usłyszenia wkrótce.",shape=box,color=blue];
		j840635206 -> j4038437960;
