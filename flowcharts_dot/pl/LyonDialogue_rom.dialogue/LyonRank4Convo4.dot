		j1689572145 -> j1735688274;
	j2065295078 [label="Po prostu nie byłem pewien, czy moje podchody zostaną przyjęte z entuzjazmem.",shape=box,color=red];
		j2065295078 -> j1224677220;
	j2683520278 [label="Ujmując to delikatnie, rzadko kiedy te wizje były przyjemne.",shape=box,color=blue];
		j2683520278 -> j3150661729;
		j2683520278 -> j3866092223;
		j2683520278 -> j3165422198;
	j986717313 [label="W skrócie? No cóż, tak... nie chcę odrzucać twoich starań. Po prostu... nie jestem przyzwyczajony... do nawiązywania relacji, Włóczęgo. Jakichkolwiek.",shape=box,color=blue];
		j986717313 -> j2861596119;
	j1735688274 [label="Tak też myślałem. W takim razie życzę ci miłej reszty dnia.",shape=box,color=blue];
