		j3165422198 -> j3244528886;
	j2861596119 [label="Jeśli zdecydujesz się podążać tą drogą, nie będę cię od tego odwodził. Chyba jeszcze nigdy nie byłem w tak... obcym położeniu.",shape=box,color=blue];
		j2861596119 -> j4255564332;
