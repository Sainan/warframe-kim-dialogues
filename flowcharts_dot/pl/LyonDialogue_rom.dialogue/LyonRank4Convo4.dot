digraph {
	970 [label="LyonRank4Convo4 begins.",color=orange];
		970 -> 972;
		970 -> 971;
	972 [label="Zdałem sobie sprawę, że niewiele wiem o tym, skąd pochodzisz i w jakim otoczeniu dorastałeś. Zechcesz mi uchylić rąbka tajemnicy?",shape=box,color=red];
		972 -> 974;
	971 [label="[Ostrzeżenie: Krótka wzmianka o znęcaniu się nad dzieckiem. Kliknij tutaj, aby zakończyć. Brak utraty Chemii z Leonem]",shape=box,color=red];
		971 -> 973;
