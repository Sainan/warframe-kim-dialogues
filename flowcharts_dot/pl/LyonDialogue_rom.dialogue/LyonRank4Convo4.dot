		j1048892711 -> j1633086734;
	j2197166494 [label="Czy właśnie dlatego ty...?",shape=box,color=red];
		j2197166494 -> j2933368378;
	j3417271800 [label="Przepełniał ją lęk. Cokolwiek mnie trapiło, czy to brzemię bogów, szaleństwo – klątwa – nie była w stanie sobie z tym poradzić.",shape=box,color=blue];
		j3417271800 -> j879966949;
	j2933368378 [label="Check boolean LyonLecture2",color=orange];
		j2933368378 -> j3496607460 [label=true,color=green];
		j2933368378 -> j3029453319 [label=false,color=brown];
	j879966949 [label="Niezależnie od tego, jak okrutna była moja matka... Ojciec był jeszcze gorszy. Oszczędzę ci szczegółów.",shape=box,color=blue];
		j879966949 -> j4197640236;
	j3496607460 [label="Być może. Często zastanawiam się, czy nie to przyczyniło się do moich kompulsywnych zachowań. Ale jak już ci wspominałem, to również metoda stosowana przez Luę.",shape=box,color=blue];
		j3496607460 -> j1928087004;
	j3029453319 [label="Być może. Często zastanawiam się, czy nie to przyczyniło się do moich kompulsywnych zachowań. Ale to również metoda stosowana przez Luę i Świetlistych. Nie jestem w tym odosobniony.",shape=box,color=blue];
		j3029453319 -> j1183949028;
	j4197640236 [label="Z wiekiem wizje przerodziły się w głosy. Szepty, które nachodzimy mnie o każdej porze dnia i nocy. Na jawie i we śnie. Odbijało się to na mojej pracy na farmie, a później przez to cierpiałem.",shape=box,color=blue];
		j4197640236 -> j830456634;
		j4197640236 -> j1207378723;
	j1928087004 [label="+5 Chemistry",color=orange];
		j1928087004 -> j3491721634;
	j1183949028 [label="+5 Chemistry",color=orange];
		j1183949028 -> j2891042592;
	j830456634 [label="Co cię skłoniło do zwrócenia się w stronę kościoła?",shape=box,color=red];
		j830456634 -> j4013567020;
	j1207378723 [label="Niektórzy ludzie nie zasługują na to, by być rodzicami.",shape=box,color=red];
		j1207378723 -> j3191434130;
	j3491721634 [label="Zapewniam cię, że przynosi mi to odrobinę wytchnienia, choć rozumiem, że może to wydawać się dziwne.",shape=box,color=blue];
		j3491721634 -> j879966949;
	j2891042592 [label="Nauczył mnie tego jeden z Ojców w Katedrze, żeby mi pomóc... oczyścić umysł. Wybrańcy Lui często otrzymują \"błogosławieństwo\" w postaci \"wizji\".",shape=box,color=blue];
		j2891042592 -> j2667459319;
	j4013567020 [label="Check boolean LyonPainOff",color=orange];
		j4013567020 -> j1522814074 [label=true,color=green];
		j4013567020 -> j866317308 [label=false,color=brown];
	j3191434130 [label="Doceniam te słowa, ale pragnę zaznaczyć, że byłem niezwykle trudnym dzieckiem do współpracy, zwłaszcza jeśli uwzględnimy to, że byłem wyższy i silniejszy od nich.",shape=box,color=blue];
		j3191434130 -> j4013567020;
	j2667459319 [label="Boolean LyonLecture2 is now true.",color=orange];
		j2667459319 -> j879966949;
	j1522814074 [label="Moje wizje i głosy często wprawiały mnie w napady złości, Włóczęgo. Często jedynym sposobem, by otrząsnąć się z tego, co widziałem, było zadawanie sobie bólu.",shape=box,color=blue];
		j1522814074 -> j2312048166;
	j866317308 [label="Moje wizje i głosy często wprawiały mnie w napady złości, Włóczęgo. Często brałem nóż, tnąc swoje ciało, gdyż ból był jedyną rzeczą, która mnie z nich wybudzała.",shape=box,color=blue];
		j866317308 -> j2312048166;
	j2312048166 [label="Ale to działo się wtedy, gdy głosy kazały mi...",shape=box,color=blue];
		j2312048166 -> j1415256031;
	j1415256031 [label="Ja... nie mogę. Nie jestem w stanie. Wybacz mi. Ręce mi się trzęsą, gdy to piszę. Muszę na razie przestać.",shape=box,color=blue];
		j1415256031 -> j2914717082;
		j1415256031 -> j3512677471;
	j2914717082 [label="Oczywiście. W porządku. Bez pośpiechu. Jestem tu, jeśli tylko będziesz mnie potrzebować.",shape=box,color=red];
		j2914717082 -> j2421403525;
	j3512677471 [label="Rozumiem, że to dla ciebie za dużo. Odpoczywaj, dobrze? I... dziękuję. To wiele dla mnie znaczy.",shape=box,color=red];
		j3512677471 -> j1726538724;
