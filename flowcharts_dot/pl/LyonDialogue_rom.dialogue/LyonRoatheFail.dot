	"Chat ends." [color=orange];
	j149266454 [label="Jeśli mogę jakkolwiek pomóc, zrobię to, mon miracle. Z czym sobie nie radzicie?",shape=box,color=blue];
		j149266454 -> j572992334;
	j1499725579 [label="Jeśli mogę jakkolwiek pomóc, zrobię to. Z czym sobie nie radzicie?",shape=box,color=blue];
		j1499725579 -> j572992334;
	j572992334 [label="Evaluate expressions",color=orange];
		j572992334 -> j1711296688 [label="RoatheFail",color=purple];
		j572992334 -> j1711296688 [label="RoatheFailStall",color=purple];
		j572992334 -> j2361513946 [label="RoatheFailUltimate",color=purple];
		j572992334 -> j1268132589 [label="RoatheFailNot21",color=purple];
		j572992334 -> j836618629 [label="RoatheFailUnloved",color=purple];
		j572992334 -> j1711296688 [label="RoatheRepair1",color=purple];
	j1711296688 [label="Roathe musiał zmierzyć się z prawdą... tego, jak przyjął serum. Nie wiem jak, ale chyba nie do końca mu w tym pomogłem.",shape=box,color=red];
		j1711296688 -> j3013425981;
	j2361513946 [label="Chyba powiedziałem coś, czego nie powinienem był powiedzieć.",shape=box,color=red];
		j2361513946 -> j2133032474;
	j1268132589 [label="Powiedział mi, żebym nie zagłębiał się w jego wspomnienia. Więc tego nie robiłem i teraz... utknęliśmy?",shape=box,color=red];
		j1268132589 -> j274961184;
	j836618629 [label="Powiedziałem mu, że szukam tylko towarzystwa i choć nie zdawało się mu to przeszkadzać, czuję, że sytuacja między nami się pogorszyła.",shape=box,color=red];
		j836618629 -> j2133032474;
	j3013425981 [label="Rozumiem. To znaczne wyzwanie, pogodzić się z nowym zrozumieniem naszych minionych działań. Przeklinam Entratiego za wciągnięcie go i nas w tę okropną sytuację.",shape=box,color=blue];
		j3013425981 -> j3738386072;
	j2133032474 [label="Rozumiem. Obawiam się, że w tej sytuacji niewiele mogę zrobić. Takie bywają konsekwencje naszych działań.",shape=box,color=blue];
		j2133032474 -> j193900272;
	j274961184 [label="Rozumiem. Czasami nasze rozumienie pomocy nie zawsze pokrywa się z tym, czego oczekują od nas inni.",shape=box,color=blue];
		j274961184 -> j820255889;
	j3738386072 [label="Zrobię, co w mojej mocy, żeby go przekonać. Radzę też, żebyś przygotował lepsze argumenty, dlaczego powinien postrzegać swoje czyny nie jako tchórzostwo.",shape=box,color=blue];
		j3738386072 -> j1333514135;
	j193900272 [label="Działanie z bezduszną ignorancją w taki sposób z pewnością doprowadzi do zachowania, które będzie odpowiadało tym samym. Zwłaszcza gdy masz do czynienia z kimś takim jak Roathe.",shape=box,color=blue];
		j193900272 -> j2963367352;
	j820255889 [label="To straszny czyn, którego musimy się dopuścić. Zignorować czyjeś prośby, szczególnie w kwestii jak zaglądanie do wspomnień i myśli.",shape=box,color=blue];
		j820255889 -> j1958564626;
	j1333514135 [label="Wiem, jaki koszmar toczy go od środka.",shape=box,color=blue];
		j1333514135 -> j4220209155;
	j2963367352 [label="Nie wiem, jaka pozostaje ci droga, aby to naprawić. Wybacz mi, ale możesz nie znaleźć rozwiązania ani we mnie, ani w Marii.",shape=box,color=blue];
		j2963367352 -> j4126050964;
	j1958564626 [label="Przeklinam Entratiego za wciągnięcie zarówno jego, jak i nas w tę okropną sytuację.",shape=box,color=blue];
		j1958564626 -> j814285382;
	j4220209155 [label="Wiem, że potrzebne będzie tu też wsparcie Marii. Ale przekonanie jej może przyjść z trudnością, nie pałają do siebie wielką miłością.",shape=box,color=blue];
		j4220209155 -> j3965507901;
	j4126050964 [label="Możliwe, że najlepiej będzie rozważyć inne rozwiązania.",shape=box,color=blue];
		j4126050964 -> "Chat ends.";
	j814285382 [label="Wydaje mi się, że jest to niestety jedyna droga, by mu pomóc. Musisz wciąż powracać do Descendii, aż nie pozostanie przed tobą żadna tajemnica.",shape=box,color=blue];
		j814285382 -> j1200320103;
	j3965507901 [label="Boolean LyonRoatheFailFix is now true.",color=orange];
		j3965507901 -> j2863138970;
	j1200320103 [label="Bez względu na to, jak bardzo diabeł mógłby się wzbraniać.",shape=box,color=blue];
		j1200320103 -> "Chat ends.";
	j2863138970 [label="Niech Lua cię prowadzi.",shape=box,color=blue];
		j2863138970 -> "Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
}