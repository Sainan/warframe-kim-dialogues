	"LyonRank3Convo2 begins." [color=orange];
		"LyonRank3Convo2 begins." -> j1759902020;
	j1759902020 [label="Jeśli mogę, chciałbym Ci opowiedzieć historię o bezdomnym dachowcu, który niegdyś przychodził na zakrystię.",shape=box,color=blue];
		j1759902020 -> j2658275169;
		j1759902020 -> j2981180117;
		j1759902020 -> j3747364732;
	j2658275169 [label="Śmiało.",shape=box,color=red];
		j2658275169 -> j3191250863;
	j2981180117 [label="Dlaczego?",shape=box,color=red];
		j2981180117 -> j4140309941;
	j3747364732 [label="[Ignoruj]",shape=box,color=red];
		j3747364732 -> "Chat ends.";
	j3191250863 [label="Dziękuję.",shape=box,color=blue];
		j3191250863 -> j1563491738;
	j4140309941 [label="Obawiam się, że wyjaśnienie tego zajęłoby więcej czasu, niż byłoby warte.",shape=box,color=blue];
		j4140309941 -> j4291363906;
	"Chat ends." [color=orange];
	j1563491738 [label="Choć podejrzewam, że ta opowieść nie dotyczy wyłącznie tego zaniedbanego włóczęgi, a moja interakcja z nim wydaje się godna uwagi, to jednak warto ją opowiedzieć.",shape=box,color=blue];
		j1563491738 -> j2091558801;
	j4291363906 [label="Nieważne.",shape=box,color=blue];
		j4291363906 -> "Chat ends.";
	j2091558801 [label="Codziennie przychodził, żeby wyżebrać jakieś resztki albo ewentualnie pieszczoty ode mnie lub od innych braci i sióstr, których spotkał.",shape=box,color=blue];
		j2091558801 -> j1085112522;
	j1085112522 [label="Był wychudzony, utykał na jedną łapę i brakowało mu części ucha. ",shape=box,color=blue];
		j1085112522 -> j518103773;
	j518103773 [label="Gdy nie pojawiał się przez kilka dni, Maria była bardzo zatroskana. Ale cóż można zrobić dla starego dachowca, który dotarł do swego kresu, poza modlitwą do Lua?",shape=box,color=blue];
		j518103773 -> j3437213928;
	j3437213928 [label="Boolean LyonStray is now true.",color=orange];
		j3437213928 -> j3500267416;
		j3437213928 -> j2790756450;
		j3437213928 -> j1667155642;
	j3500267416 [label="[Pozwól mu dokończyć]",shape=box,color=red];
		j3500267416 -> j2423744703;
	j2790756450 [label="Czy wasza religia na to pozwala? Mam na myśli modlitwę w intencji zwierząt.",shape=box,color=red];
		j2790756450 -> j3739060570;
	j1667155642 [label="Modliłbyś się za duszę zmarłego kota-przybłędy?",shape=box,color=red];
		j1667155642 -> j4116135177;
	j2423744703 [label="A więc wyobraź sobie me zdziwienie, gdy idąc po chleb na targ, dostrzegłem tam starego kocura siedzącego u boku właściciela stoiska.",shape=box,color=blue];
		j2423744703 -> j770374504;
	j3739060570 [label="+10 Chemistry",color=orange];
		j3739060570 -> j879503686;
	j4116135177 [label="Oczywiście. Niektóre z najczystszych, najjaśniejszych dusz, jakie spotkałem, były zamknięte w ciele zwierząt. Nie mnie osądzać, jak Świetliści skierowali je na tę ścieżkę.",shape=box,color=blue];
		j4116135177 -> j950950224;
	j770374504 [label="Przywitał mnie szorstkim miauknięciem, jak to miał w zwyczaju, a następnie zeskoczył, by poocierać się o moją nogę.",shape=box,color=blue];
		j770374504 -> j3474516611;
	j879503686 [label="To dobre pytanie. W niektórych sektach – nie. To zostałoby uznane za herezję. Ale w naszej – jak najbardziej. Uznajemy, że zwierzęta są obdarzone duszą.",shape=box,color=blue];
		j879503686 -> j950950224;
	j950950224 [label="Święta Elżbieta Mądra, była znana ze swojego miłosierdzia wobec zwierząt, chociaż wiele tradycji uznaje Świętych za apostołów Świetlistych.",shape=box,color=blue];
		j950950224 -> j2069504025;
	j3474516611 [label="I pragnę zauważyć, Włóczęgo, że uczynił to, wcale nie utykając.",shape=box,color=blue];
		j3474516611 -> j247073640;
	j2069504025 [label="Zastanawiam się, czy jakiś wpływ naszego zakonu przetrwał do dziś... ale wróćmy do tematu naszej rozmowy.",shape=box,color=blue];
		j2069504025 -> j1057753362;
	j247073640 [label="\"O, dostrzegam jednego z naiwniaków Starego Devereauxa\". Mężczyzna zaśmiał się, pakując mój chleb.",shape=box,color=blue];
		j247073640 -> j1226914885;
	j1057753362 [label="Boolean LyonLecture1 is now true.",color=orange];
		j1057753362 -> j2423744703;
	j1226914885 [label="Okazało się, że ten stary kocur nabierał nas i kilku innych naiwniaków z sąsiedztwa. Wcale nie przymierał głodem, nie był schorowany, ani w żaden sposób zaniedbany.",shape=box,color=blue];
		j1226914885 -> j720616726;
	j720616726 [label="Bynajmniej, gdyż jeśli wierzyć słowom tego człowieka, kocur był prawdziwym zabijaką, przetrzebiającym okoliczną populację ptaków.",shape=box,color=blue];
		j720616726 -> j627254789;
		j720616726 -> j1418934612;
		j720616726 -> j2259886882;
	j627254789 [label="Przestałeś karmić starego Devereauxa, gdy kręcił się w okolicy?",shape=box,color=red];
		j627254789 -> j1768031494;
	j1418934612 [label="Czy próbujesz mnie ostrzec przed Roathem?",shape=box,color=red];
		j1418934612 -> j1634638694;
	j2259886882 [label="Czy to ty jesteś dachowcem w tej opowieści?",shape=box,color=red];
		j2259886882 -> j3847623421;
	j1768031494 [label="+10 Chemistry",color=orange];
		j1768031494 -> j2971365953;
	j1634638694 [label="Jest mnóstwo znaków, które stanowią ostrzeżenie przed diabłem \"kardynałem Dimanche\" i dobijają się do naszych drzwi. Być może jest to jeden z nich. A może nie.",shape=box,color=blue];
		j1634638694 -> j2223895584;
	j3847623421 [label="Świetliści wiedzą, że ostatnimi czasy jestem dość mocno wyeksploatowany. Ale czy ma to stanowić ostrzeżenie przede mną? Być może. A być może nie.",shape=box,color=blue];
		j3847623421 -> j2223895584;
	j2971365953 [label="Nie, nie zrobiliśmy tego. Było wręcz przeciwnie, Maria powitała go z jeszcze większą czułością, nazywając go pieszczotliwie \"jej małym diabełkiem\".",shape=box,color=blue];
		j2971365953 -> j1340331836;
	j2223895584 [label="To po prostu opowieść o tym, że czasami, gdy jakieś stworzenie zdaje się w potrzebie –",shape=box,color=blue];
		j2223895584 -> j180129975;
	j1340331836 [label="Jednak przestaliśmy się o niego martwić. Wiedzieliśmy, że stary Devereaux sam sobie świetnie radzi. Wcale nas nie potrzebował.",shape=box,color=blue];
		j1340331836 -> j3263922914;
		j1340331836 -> j1065544152;
	j180129975 [label="+15 Chemistry",color=orange];
		j180129975 -> j500904667;
	j3263922914 [label="Wiesz, co się później stało ze starym Devereauxem?",shape=box,color=red];
		j3263922914 -> j3343909903;
	j1065544152 [label="Co Twoim zdaniem kierowało starym Devereauxem, że odwiedzał was bez potrzeby?",shape=box,color=red];
		j1065544152 -> j4031562986;
	j500904667 [label="– należy sprawdzić, czy ma ostre pazury.",shape=box,color=blue];
		j500904667 -> "Chat ends.";
	j3343909903 [label="Jego kolejne zniknięcie, dwa lata później, okazało się permanentne.",shape=box,color=blue];
		j3343909903 -> j3337995156;
		j3343909903 -> j1187301235;
	j4031562986 [label="Jeśli miałbym udzielić cynicznej odpowiedzi, rzekłbym, że \"chciwość\". Bo skoro można być na jednej uczcie, to dlaczego nie na dwóch? Albo dziesięciu?",shape=box,color=blue];
		j4031562986 -> j2046987752;
		j4031562986 -> j26494901;
	j3337995156 [label="Modliłeś się za niego?",shape=box,color=red];
		j3337995156 -> j568672570;
	j1187301235 [label="Mam nadzieję, że odszedł z tego świata z poczuciem bycia kochanym i w komfortowych warunkach.",shape=box,color=red];
		j1187301235 -> j2716536538;
	j2046987752 [label="A jaka byłaby odpowiedź pozbawiona cynizmu?",shape=box,color=red];
		j2046987752 -> j3879487839;
	j26494901 [label="Tak samo byś powiedział, gdyby łaknął jedynie uwagi?",shape=box,color=red];
		j26494901 -> j1762382250;
	j568672570 [label="W noc, w którą dowiedziałem się o jego śmierci, zapaliłem świecę w jego intencji i modliłem się do Lua, aby pokierowała jego duszę do... dokądkolwiek tylko uzna za stosowne pokierować tego diabełka.",shape=box,color=blue];
		j568672570 -> j4153016581;
	j2716536538 [label="Czy mogę zapytać dlaczego?",shape=box,color=blue];
		j2716536538 -> j3505029825;
		j2716536538 -> j2583007534;
	j3879487839 [label="+10 Chemistry",color=orange];
		j3879487839 -> j3023484123;
	j1762382250 [label="Niepohamowane pragnienie uwagi wciąż jest aktem obżarstwa, choć nie jest głodem, który można zaspokoić mięsem i winem. A szukać go pod tak fałszywym pretekstem?",shape=box,color=blue];
		j1762382250 -> j2909581945;
		j1762382250 -> j2961571418;
	j4153016581 [label="I podziękowałem staremu Devereauxowi za całą radość, jaką sprawił Marii w zamian za te wszystkie upragnione kawałki chrząstek kurczaka oraz za drapanie go po główce.",shape=box,color=blue];
		j4153016581 -> j1348178477;
	j3505029825 [label="Był zwierzęciem. Po prostu szukał spełnienia – w jedzeniu, schronieniu, miłości – nie kierowały nim te same motywacje, co ludźmi. Nie \"kłamał\", a polował, używając innego zestawu narzędzi.",shape=box,color=red];
		j3505029825 -> j801252372;
	j2583007534 [label="Widziałem mnóstwo przemocy, Leonie. Do dużej części z niej sam się przyczyniłem. Mam nadzieję, że niezależnie od tego, kim ktoś jest i co uczynił, powinien umrzeć w spokoju w otoczeniu kochających osób.",shape=box,color=red];
		j2583007534 -> j1584174306;
	j3023484123 [label="Poczułem zmieszanie... obdarzając szacunkiem kota za to, jakie miejsce sobie znalazł na tym świecie.",shape=box,color=blue];
		j3023484123 -> j1435435611;
	j2909581945 [label="To był tylko kot, Leonie. Pewnie ledwo zdawał sobie sprawę z tego, co robi.",shape=box,color=red];
		j2909581945 -> j3615895623;
	j2961571418 [label="Nadal mówimy o kocie, prawda?",shape=box,color=red];
		j2961571418 -> j4029902380;
	j1348178477 [label="Dziękuję. Nie będę już dłużej zajmował Twojego czasu.",shape=box,color=blue];
		j1348178477 -> j3651491667;
	j801252372 [label="Nie szkodził innym, czyniąc was wszystkich \"naiwniakami\". Wręcz przeciwnie... wygląda na to, że wzbogacił was swoimi odwiedzinami.",shape=box,color=red];
		j801252372 -> j2812748380;
	j1584174306 [label="To fascynujące. Spodziewałbym się po tobie pogardy do wrogów. Ale to tylko moja ignorancja – zakładać, że wiedziałbym, jak ktoś w dzisiejszych czasach by się zachował.",shape=box,color=blue];
		j1584174306 -> j2866995015;
	j1435435611 [label="Oto stworzenie, które nauczyło się wykorzystywać swoje warunki – wygląd, wiek, blizny – jako broń przeciwko otaczającym go \"naiwniakom\", którzy nie przejrzeli jego podstępu.",shape=box,color=blue];
		j1435435611 -> j3624603503;
	j3615895623 [label="Wiedział na tyle, by udawać kulawego. ",shape=box,color=blue];
		j3615895623 -> j3879487839;
	j4029902380 [label="Sam wyciągnij wnioski z tej rozmowy, Włóczęgo.",shape=box,color=blue];
		j4029902380 -> j3879487839;
	j3651491667 [label="O. Leon Allard",shape=box,color=blue];
		j3651491667 -> "Chat ends.";
	j2812748380 [label="Add -1 to Thermostat counter",color=orange];
		j2812748380 -> j3596348838;
	j2866995015 [label="Add 1 to Thermostat counter",color=orange];
		j2866995015 -> j3368580139;
	j3624603503 [label="Był prawdziwym diabełkiem o skołtunionej sierści. Mimo to, gdy wracał nas odwiedzić, wciąż głaskałem go z takim samym entuzjazmem.",shape=box,color=blue];
		j3624603503 -> j3256647117;
	j3596348838 [label="Tak. Chyba tak. I nie cierpieliśmy na brak chrząstek kurczaka ani na brak chęci drapania po główce.",shape=box,color=blue];
		j3596348838 -> j3757395279;
	j3368580139 [label="A co dopiero mówiąc o kimś takim jak ty, kto wychowywał się w jakże fascynujących okolicznościach.",shape=box,color=blue];
		j3368580139 -> j1751873530;
	j3256647117 [label="I byłem tak samo załamany, gdy dwa lata później zniknął, jak się okazało – już na zawsze.",shape=box,color=blue];
		j3256647117 -> j3337995156;
		j3256647117 -> j1187301235;
	j3757395279 [label="Być może właśnie dlatego zapaliłem świeczkę w jego intencji i modliłem się do Lua, aby przyjęła jego duszę i pokierowała ją do... dokądkolwiek tylko uzna za stosowne zabrać tego diabełka.",shape=box,color=blue];
		j3757395279 -> j1102532344;
	j1751873530 [label="+5 Chemistry",color=orange];
		j1751873530 -> j2144439766;
	j1102532344 [label="+5 Chemistry",color=orange];
		j1102532344 -> j3680606561;
	j2144439766 [label="Dziękuję. Nie będę już dłużej zajmował twojego czasu. To był niezwykle interesujący dyskurs. Do kolejnego razu.",shape=box,color=blue];
		j2144439766 -> j3651491667;
	j3680606561 [label="I dlatego tamtej nocy podziękowałem w moich modłach staremu Devereauxowi za całą radość, jaką przyniósł Marii.",shape=box,color=blue];
		j3680606561 -> j987293291;
	j987293291 [label="Być może jego drobne nikczemności były dobre w jakiś pokrętny sposób.",shape=box,color=blue];
		j987293291 -> j2144439766;
}