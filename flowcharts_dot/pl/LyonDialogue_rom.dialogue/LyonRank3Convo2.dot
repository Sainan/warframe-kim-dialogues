digraph {
	32 [label="LyonRank3Convo2 begins.",color=orange];
		32 -> 33;
	33 [label="Jeśli mogę, chciałbym Ci opowiedzieć historię o bezdomnym dachowcu, który niegdyś przychodził na zakrystię.",shape=box,color=blue];
		33 -> 36;
		33 -> 35;
		33 -> 34;
	36 [label="Śmiało.",shape=box,color=red];
		36 -> 39;
	35 [label="Dlaczego?",shape=box,color=red];
		35 -> 38;
	34 [label="[Ignoruj]",shape=box,color=red];
		34 -> 37;
	39 [label="Dziękuję.",shape=box,color=blue];
		39 -> 41;
	38 [label="Obawiam się, że wyjaśnienie tego zajęłoby więcej czasu, niż byłoby warte.",shape=box,color=blue];
		38 -> 40;
	37 [label="Chat ends.",color=orange];
	41 [label="Choć podejrzewam, że ta opowieść nie dotyczy wyłącznie tego zaniedbanego włóczęgi, a moja interakcja z nim wydaje się godna uwagi, to jednak warto ją opowiedzieć.",shape=box,color=blue];
		41 -> 43;
	40 [label="Nieważne.",shape=box,color=blue];
		40 -> 42;
	43 [label="Codziennie przychodził, żeby wyżebrać jakieś resztki albo ewentualnie pieszczoty ode mnie lub od innych braci i sióstr, których spotkał.",shape=box,color=blue];
		43 -> 44;
	42 [label="Chat ends.",color=orange];
	44 [label="Był wychudzony, utykał na jedną łapę i brakowało mu części ucha. ",shape=box,color=blue];
		44 -> 45;
	45 [label="Gdy nie pojawiał się przez kilka dni, Maria była bardzo zatroskana. Ale cóż można zrobić dla starego dachowca, który dotarł do swego kresu, poza modlitwą do Lui?",shape=box,color=blue];
		45 -> 46;
	46 [label="Update boolean LyonStray",color=orange];
		46 -> 47;
		46 -> 48;
		46 -> 49;
	47 [label="[Pozwól mu dokończyć]",shape=box,color=red];
		47 -> 50;
	48 [label="Czy wasza religia na to pozwala? Mam na myśli modlitwę w intencji zwierząt.",shape=box,color=red];
		48 -> 51;
	49 [label="Modliłbyś się za duszę zmarłego kota-przybłędy?",shape=box,color=red];
		49 -> 52;
	50 [label="A więc wyobraź sobie me zdziwienie, gdy idąc po chleb na targ, dostrzegłem tam starego kocura siedzącego u boku właściciela stoiska.",shape=box,color=blue];
		50 -> 53;
	51 [label="+10 Chemistry",color=orange];
		51 -> 54;
	52 [label="Oczywiście. Niektóre z najczystszych, najjaśniejszych dusz, jakie spotkałem, były zamknięte w ciele zwierząt. Nie mnie osądzać, jak Świetliści skierowali je na tę ścieżkę.",shape=box,color=blue];
		52 -> 55;
	53 [label="Przywitał mnie szorstkim miauknięciem, jak to miał w zwyczaju, a następnie zeskoczył, by poocierać się o moją nogę.",shape=box,color=blue];
		53 -> 56;
	54 [label="To dobre pytanie. W niektórych sektach – nie. To zostałoby uznane za herezję. Ale w naszej – jak najbardziej. Uznajemy, że zwierzęta są obdarzone duszą.",shape=box,color=blue];
		54 -> 55;
	55 [label="Święta Elżbieta Mądra, była znana ze swojego miłosierdzia wobec zwierząt, chociaż wiele tradycji uznaje Świętych za apostołów Świetlistych.",shape=box,color=blue];
		55 -> 57;
	56 [label="I pragnę zauważyć, Włóczęgo, że uczynił to, wcale nie utykając.",shape=box,color=blue];
		56 -> 58;
	57 [label="Zastanawiam się, czy jakiś wpływ naszego zakonu przetrwał do dziś... ale wróćmy do tematu naszej rozmowy.",shape=box,color=blue];
		57 -> 59;
	58 [label="\"O, dostrzegam jednego z naiwniaków Starego Devereauxa\". Mężczyzna zaśmiał się, pakując mój chleb.",shape=box,color=blue];
		58 -> 60;
	59 [label="Update boolean LyonLecture1",color=orange];
		59 -> 50;
	60 [label="Okazało się, że ten stary kocur nabierał nas i kilku innych naiwniaków z sąsiedztwa. Wcale nie przymierał głodem, nie był schorowany, ani w żaden sposób zaniedbany.",shape=box,color=blue];
		60 -> 61;
	61 [label="Bynajmniej, gdyż jeśli wierzyć słowom tego człowieka, kocur był prawdziwym zabijaką, przetrzebiającym okoliczną populację ptaków.",shape=box,color=blue];
		61 -> 62;
		61 -> 63;
		61 -> 64;
	62 [label="Przestałeś karmić starego Devereauxa, gdy kręcił się w okolicy?",shape=box,color=red];
		62 -> 65;
	63 [label="Czy próbujesz mnie ostrzec przed Roathem?",shape=box,color=red];
		63 -> 66;
	64 [label="Czy to ty jesteś dachowcem w tej opowieści?",shape=box,color=red];
		64 -> 67;
	65 [label="+10 Chemistry",color=orange];
		65 -> 68;
	66 [label="Jest mnóstwo znaków, które stanowią ostrzeżenie przed diabłem \"kardynałem Dimanche\" i dobijają się do naszych drzwi. Być może jest to jeden z nich. A może nie.",shape=box,color=blue];
		66 -> 69;
	67 [label="Świetliści wiedzą, że ostatnimi czasy jestem dość mocno wyeksploatowany. Ale czy ma to stanowić ostrzeżenie przede mną? Być może. A być może nie.",shape=box,color=blue];
		67 -> 69;
	68 [label="Nie, nie zrobiliśmy tego. Było wręcz przeciwnie, Maria powitała go z jeszcze większą czułością, nazywając go pieszczotliwie \"jej małym diabełkiem\".",shape=box,color=blue];
		68 -> 70;
	69 [label="To po prostu opowieść o tym, że czasami, gdy jakieś stworzenie zdaje się w potrzebie –",shape=box,color=blue];
		69 -> 71;
	70 [label="Jednak przestaliśmy się o niego martwić. Wiedzieliśmy, że stary Devereaux sam sobie świetnie radzi. Wcale nas nie potrzebował.",shape=box,color=blue];
		70 -> 72;
		70 -> 73;
	71 [label="+15 Chemistry",color=orange];
		71 -> 74;
	72 [label="Wiesz, co się później stało ze starym Devereauxem?",shape=box,color=red];
		72 -> 75;
	73 [label="Co Twoim zdaniem kierowało starym Devereauxem, że odwiedzał was bez potrzeby?",shape=box,color=red];
		73 -> 76;
	74 [label="– należy sprawdzić, czy ma ostre pazury.",shape=box,color=blue];
		74 -> 77;
	75 [label="Jego kolejne zniknięcie, dwa lata później, okazało się permanentne.",shape=box,color=blue];
		75 -> 78;
		75 -> 79;
	76 [label="Jeśli miałbym udzielić cynicznej odpowiedzi, rzekłbym, że \"chciwość\". Bo skoro można być na jednej uczcie, to dlaczego nie na dwóch? Albo dziesięciu?",shape=box,color=blue];
		76 -> 80;
		76 -> 81;
	77 [label="Chat ends.",color=orange];
	78 [label="Modliłeś się za niego?",shape=box,color=red];
		78 -> 82;
	79 [label="Mam nadzieję, że odszedł z tego świata z poczuciem bycia kochanym i w komfortowych warunkach.",shape=box,color=red];
		79 -> 83;
	80 [label="A jaka byłaby odpowiedź pozbawiona cynizmu?",shape=box,color=red];
		80 -> 84;
	81 [label="Tak samo byś powiedział, gdyby łaknął jedynie uwagi?",shape=box,color=red];
		81 -> 85;
	82 [label="W noc, w którą dowiedziałem się o jego śmierci, zapaliłem świecę w jego intencji i modliłem się do Lui, aby pokierowała jego duszę do... dokądkolwiek tylko uzna za stosowne pokierować tego diabełka.",shape=box,color=blue];
		82 -> 86;
	83 [label="Czy mogę zapytać dlaczego?",shape=box,color=blue];
		83 -> 87;
		83 -> 88;
	84 [label="+10 Chemistry",color=orange];
		84 -> 89;
	85 [label="Niepohamowane pragnienie uwagi wciąż jest aktem obżarstwa, choć nie jest głodem, który można zaspokoić mięsem i winem. A szukać go pod tak fałszywym pretekstem?",shape=box,color=blue];
		85 -> 90;
		85 -> 91;
	86 [label="I podziękowałem staremu Devereauxowi za całą radość, jaką sprawił Marii w zamian za te wszystkie upragnione kawałki chrząstek kurczaka oraz za drapanie go po główce.",shape=box,color=blue];
		86 -> 92;
	87 [label="Był zwierzęciem. Po prostu szukał spełnienia – w jedzeniu, schronieniu, miłości – nie kierowały nim te same motywacje, co ludźmi. Nie \"kłamał\", a polował, używając innego zestawu narzędzi.",shape=box,color=red];
		87 -> 93;
	88 [label="Widziałem mnóstwo przemocy, Leonie. Do dużej części z niej sam się przyczyniłem. Mam nadzieję, że niezależnie od tego, kim ktoś jest i co uczynił, powinien umrzeć w spokoju w otoczeniu kochających osób.",shape=box,color=red];
		88 -> 94;
	89 [label="Poczułem zmieszanie... obdarzając szacunkiem kota za to, jakie miejsce sobie znalazł na tym świecie.",shape=box,color=blue];
		89 -> 95;
	90 [label="To był tylko kot, Leonie. Pewnie ledwo zdawał sobie sprawę z tego, co robi.",shape=box,color=red];
		90 -> 96;
	91 [label="Nadal mówimy o kocie, prawda?",shape=box,color=red];
		91 -> 97;
	92 [label="Dziękuję. Nie będę już dłużej zajmował Twojego czasu.",shape=box,color=blue];
		92 -> 98;
	93 [label="Nie szkodził innym, czyniąc was wszystkich \"naiwniakami\". Wręcz przeciwnie... wygląda na to, że wzbogacił was swoimi odwiedzinami.",shape=box,color=red];
		93 -> 99;
	94 [label="To fascynujące. Spodziewałbym się po tobie pogardy do wrogów. Ale to tylko moja ignorancja – zakładać, że wiedziałbym, jak ktoś w dzisiejszych czasach by się zachował.",shape=box,color=blue];
		94 -> 100;
	95 [label="Oto stworzenie, które nauczyło się wykorzystywać swoje warunki – wygląd, wiek, blizny – jako broń przeciwko otaczającym go \"naiwniakom\", którzy nie przejrzeli jego podstępu.",shape=box,color=blue];
		95 -> 101;
	96 [label="Wiedział na tyle, by udawać kulawego. ",shape=box,color=blue];
		96 -> 84;
	97 [label="Sam wyciągnij wnioski z tej rozmowy, Włóczęgo.",shape=box,color=blue];
		97 -> 84;
	98 [label="O. Leon Allard",shape=box,color=blue];
		98 -> 102;
	99 [label="Add -1 to Thermostat",color=orange];
		99 -> 103;
	100 [label="Add 1 to Thermostat",color=orange];
		100 -> 104;
	101 [label="Był prawdziwym diabełkiem o skołtunionej sierści. Mimo to, gdy wracał nas odwiedzić, wciąż głaskałem go z takim samym entuzjazmem.",shape=box,color=blue];
		101 -> 105;
	102 [label="Chat ends.",color=orange];
	103 [label="Tak. Chyba tak. I nie cierpieliśmy na brak chrząstek kurczaka ani na brak chęci drapania po główce.",shape=box,color=blue];
		103 -> 106;
	104 [label="A co dopiero mówiąc o kimś takim jak ty, kto wychowywał się w jakże fascynujących okolicznościach.",shape=box,color=blue];
		104 -> 107;
	105 [label="I byłem tak samo załamany, gdy dwa lata później zniknął, jak się okazało – już na zawsze.",shape=box,color=blue];
		105 -> 78;
		105 -> 79;
	106 [label="Być może właśnie dlatego zapaliłem świeczkę w jego intencji i modliłem się do Lui, aby przyjęła jego duszę i pokierowała ją do... dokądkolwiek tylko uzna za stosowne zabrać tego diabełka.",shape=box,color=blue];
		106 -> 108;
	107 [label="+5 Chemistry",color=orange];
		107 -> 109;
	108 [label="+5 Chemistry",color=orange];
		108 -> 110;
	109 [label="Dziękuję. Nie będę już dłużej zajmował twojego czasu. To był niezwykle interesujący dyskurs. Do kolejnego razu.",shape=box,color=blue];
		109 -> 111;
	110 [label="I dlatego tamtej nocy podziękowałem w moich modłach staremu Devereauxowi za całą radość, jaką przyniósł Marii.",shape=box,color=blue];
		110 -> 112;
	111 [label="O. Leon Allard",shape=box,color=blue];
		111 -> 113;
	112 [label="Być może jego drobne nikczemności były dobre w jakiś pokrętny sposób.",shape=box,color=blue];
		112 -> 109;
	113 [label="Chat ends.",color=orange];
}