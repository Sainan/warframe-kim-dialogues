	j2887647917 [label="Pewnie nie będzie to dla ciebie zaskoczeniem, że wolę, by moje sprawy pozostały prywatne.",shape=box,color=blue];
		j2887647917 -> j3793588528;
	j107891641 [label="Oczywiście. Maria uzdrowiłaby cały świat wszystkimi promieniami Sol, gdyby tylko mogła. Ale pewnie nie będzie to dla ciebie zaskoczeniem, że wolę, by moje sprawy pozostały prywatne.",shape=box,color=blue];
