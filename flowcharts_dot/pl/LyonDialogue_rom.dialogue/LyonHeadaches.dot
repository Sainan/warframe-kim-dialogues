		223 -> 232;
	222 [label="Też je miewam. Nie sądzę, żeby wpatrywanie się w światło tego urządzenia mogło w czymś pomóc. Powinieneś się położyć.",shape=box,color=blue];
		222 -> 230;
		222 -> 231;
		222 -> 232;
	233 [label="Nie twierdzę, że teraz jest ta chwila. Lecz gdy nadejdzie? Jestem tu.",shape=box,color=red];
