	j2677787670 [label="U mnie wszystko dobrze. Wolałem się upewnić, gdyż doszły mnie słuchy, że wczoraj nie czułeś się najlepiej.",shape=box,color=red];
		j2677787670 -> j2095686147;
	j161020929 [label="Szczerze mówiąc, to zmagam się z migreną.",shape=box,color=red];
		j161020929 -> j3549014491;
	j2669199189 [label="Szczerze mówiąc, to zmagam się z migreną.",shape=box,color=red];
		j2669199189 -> j496801260;
	j1966875793 [label="Szczerze mówiąc, to sam zmagam się z bólem głowy.",shape=box,color=red];
		j1966875793 -> j3609258355;
	j3263765214 [label="Z własnego doświadczenia wiem, że zdarza się, że nie chcemy przyjąć czyjejś pomocy, a to właśnie w tych chwilach potrzebujemy jej najbardziej.",shape=box,color=red];
		j3263765214 -> j3110166636;
	j250298985 [label="Szanuję to. Nie będę dalej drążyć, jeśli nie chcesz rozmawiać. Ale wiedz, że jestem tu, by cię wysłuchać, jeśli tego potrzebujesz.",shape=box,color=red];
		j250298985 -> j3110166636;
	j4014221899 [label="Zdaje się, że zasugerowała, że masz jakieś teorie na temat przyczyn tych bólów głowy?",shape=box,color=red];
		j4014221899 -> j3719017901;
	j1810391809 [label="Maria uważa, że próbujesz dźwigać cały ten ciężar na własnych barkach. Chcę, żebyś wiedział, że jestem tutaj.",shape=box,color=red];
		j1810391809 -> j1371430574;
	j126904960 [label="Maria uważa, że niepotrzebnie cierpisz z powodu tej całej sytuacji. Zastanawiam się, czy mógłbym ci jakoś pomóc.",shape=box,color=red];
		j126904960 -> j1371430574;
	j2095686147 [label="Aha. Rozumiem. Czuję się już znacznie lepiej, dziękuję za troskę. Chociaż nie jestem pewien, czy to dobrze, że Maria powiedziała Ci o mojej przypadłości.",shape=box,color=blue];
		j2095686147 -> j2909909654;
		j2095686147 -> j850686011;
		j2095686147 -> j1555449730;
	j3549014491 [label="Boolean LyonSuspicious is now true.",color=orange];
		j3549014491 -> j1371075752;
	j496801260 [label="Domniemam, że tak w obecnych czasach określa się przewlekłe bóle głowy, na które też cierpię. Nie sądzę, żeby wpatrywanie się w światło tego urządzenia mogło w czymś pomóc. Powinieneś się położyć.",shape=box,color=blue];
		j496801260 -> j1588560839;
		j496801260 -> j331824301;
		j496801260 -> j2005968953;
	j3609258355 [label="Też je miewam. Nie sądzę, żeby wpatrywanie się w światło tego urządzenia mogło w czymś pomóc. Powinieneś się położyć.",shape=box,color=blue];
		j3609258355 -> j1588560839;
		j3609258355 -> j331824301;
		j3609258355 -> j2005968953;
	j3110166636 [label="Nie twierdzę, że teraz jest ta chwila. Lecz gdy nadejdzie? Jestem tu.",shape=box,color=red];
		j3110166636 -> j4024694177;
	j3719017901 [label="I niestety, ale te teorie w dużej mierze odwołują się do \"Pustki\".",shape=box,color=blue];
		j3719017901 -> j3088480656;
		j3719017901 -> j2821915004;
	j1371430574 [label="Musisz mi wybaczyć Włóczęgo, co teraz powiem:",shape=box,color=blue];
		j1371430574 -> j1616818900;
	j1371075752 [label="Hm. Też na to cierpię. Nie sądzę, żeby wpatrywanie się w światło tego urządzenia mogło w czymś pomóc. Powinieneś się położyć.",shape=box,color=blue];
		j1371075752 -> j1588560839;
		j1371075752 -> j331824301;
		j1371075752 -> j2005968953;
	j1588560839 [label="Masz rację. Pójdę już. Chciałem tylko sprawdzić, co u ciebie.",shape=box,color=red];
		j1588560839 -> j1981444993;
	j331824301 [label="Masz mnie. Po prostu nie wiem, jak inaczej... nawiązać z tobą kontakt.",shape=box,color=red];
		j331824301 -> j2354888968;
	j2005968953 [label="Jeszcze chwilę wytrzymam. Od jak dawna cierpisz na tego typu bóle głowy?",shape=box,color=red];
		j2005968953 -> j4096298276;
	j4024694177 [label="Boolean LyonOffer is now true.",color=orange];
		j4024694177 -> j1371430574;
	j3088480656 [label="Och tak?",shape=box,color=red];
		j3088480656 -> j1256388014;
	j2821915004 [label="Co to znaczy?",shape=box,color=red];
		j2821915004 -> j1256388014;
	j1616818900 [label="Jestem teraz otoczony nieznanymi mi osobami i mówiącymi bestiami w dziwacznym świecie pełnym szaleństwa i pozornie niekończącej się, niepohamowanej rzezi.",shape=box,color=blue];
		j1616818900 -> j3262682575;
	j1981444993 [label="+20 Chemistry",color=orange];
		j1981444993 -> j2906457265;
	j2354888968 [label="Doceniam twą gotowość do jawnego przyznania się do kłamstwa. I doceniam fakt, że nie jestem... najłatwiejszą osobą, z którą przyszło ci mieć do czynienia.",shape=box,color=blue];
		j2354888968 -> j4172164039;
	j4096298276 [label="To prywatna sprawa, Włóczęgo. Doceniam twą próbę nawiązania ze mną konwersacji. I doceniam fakt, że nie jestem... najłatwiejszą osobą, z którą przyszło ci mieć do czynienia.",shape=box,color=blue];
		j4096298276 -> j4172164039;
	j1256388014 [label="Boolean LyonFaithHeadache is now true.",color=orange];
		j1256388014 -> j1371430574;
	j3262682575 [label="Wszystko mi znane zostało zmiecione przez świetliste promienie \"Jadeitowego Światła\", przez \"Imperium Orokin\", przez \"Pustkę\" i wciąż zagraża nam \"Szept\".",shape=box,color=blue];
		j3262682575 -> j102800451;
	j2906457265 [label="Jak dobrze \"widzisz\", już mi przeszło. A teraz musisz się martwić o siebie. Znajdź sobie jakieś ustronne miejsce, w którym dojdziesz do siebie.",shape=box,color=blue];
		j2906457265 -> j3935823168;
	j4172164039 [label="Chciałbym zapytać wprost, dlaczego tak w ogóle próbujesz się ze mną spoufalać?",shape=box,color=blue];
		j4172164039 -> j4234279307;
		j4172164039 -> j2847072792;
		j4172164039 -> j4064429847;
		j4172164039 -> j3263765214;
	j102800451 [label="Więc musisz mi wybaczyć, jeśli uznam tę... propozycję więzi z twojej strony za osobliwie śmieszną w swej naiwności. Ani cię nie znam, ani ci nie ufam. I owszem, jedyne, co mogę zrobić, to zaufać słowom innych.",shape=box,color=blue];
		j102800451 -> j1324726257;
	j3935823168 [label="Odejdź, Włóczęgo. Zanim cię znajdę i zmuszę do odpoczynku. A to dla nikogo nie będzie przyjemne.",shape=box,color=blue];
		j3935823168 -> j442239266;
		j3935823168 -> j172647535;
	j4234279307 [label="Jak mam być szczery, to odkąd się poznaliśmy, nie mogę przestać o tobie myśleć.",shape=box,color=red];
		j4234279307 -> j2905931503;
	j2847072792 [label="Entrati zamienił was w Protoframe'y i teraz wylądowaliście tutaj, bez przygotowania, zupełnie bez niczego. Jeśli mogę w jakikolwiek sposób pomóc wam w przystosowaniu się, to z miłą chęcią.",shape=box,color=red];
		j2847072792 -> j1371430574;
	j4064429847 [label="No dobrze... Uważam, że jesteś fascynujący. Chciałbym cię bliżej poznać.",shape=box,color=red];
		j4064429847 -> j1371430574;
	j1324726257 [label="Słowom innych, których jeszcze nie znam i nie ufam. Wszystko to ciąży na nas, nie wspominając o brzemieniu, którego nie dostrzegasz.",shape=box,color=blue];
		j1324726257 -> j3129954515;
	j442239266 [label="Dobrze, już dobrze. Idę.",shape=box,color=red];
		j442239266 -> j175707006;
	j172647535 [label="No cóż... mogłoby mi się to bardziej spodobać, niż ci się wydaje.",shape=box,color=red];
		j172647535 -> j719613752;
	j2905931503 [label="+20 Chemistry",color=orange];
		j2905931503 -> j719613752;
	j3129954515 [label="Doceniam zatem twoją życzliwość i przepraszam za jej brak po mojej stronie. Wiem, że się starasz i chwała ci za to. Mam nadzieję, że gdy nadejdzie odpowiedni czas i będę potrzebował twej pomocy, ta oferta będzie nadal aktualna.",shape=box,color=blue];
		j3129954515 -> j4135464077;
