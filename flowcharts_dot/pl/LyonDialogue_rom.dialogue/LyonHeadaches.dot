	j75571130 [label="Rozumiem, że to jest współczesne określenie na moje silne bóle głowy. Czuję się już znacznie lepiej, dziękuję za troskę. Chociaż nie jestem pewien, czy to dobrze, że Maria powiedziała Ci o mojej przypadłości.",shape=box,color=blue];
