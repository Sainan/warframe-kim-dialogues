	221 [label="Update boolean LyonSuspicious",color=orange];
		221 -> 229;
	223 [label="Domniemam, że tak w obecnych czasach określa się przewlekłe bóle głowy, na które też cierpię. Nie sądzę, żeby wpatrywanie się w światło tego urządzenia mogło w czymś pomóc. Powinieneś się położyć.",shape=box,color=blue];
		223 -> 230;
