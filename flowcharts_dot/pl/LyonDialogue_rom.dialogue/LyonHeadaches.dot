		242 -> 246;
	240 [label="Jestem teraz otoczony nieznanymi mi osobami i mówiącymi bestiami w dziwacznym świecie pełnym szaleństwa i pozornie niekończącej się, niepohamowanej rzezi.",shape=box,color=blue];
		240 -> 245;
	236 [label="+20 Chemistry",color=orange];
