		j2909909654 -> j2887647917;
	j850686011 [label="Powiedziała tylko, że się o ciebie martwi, bo nie czujesz się za dobrze.",shape=box,color=red];
		j850686011 -> j107891641;
	j1555449730 [label="Jakoś to samo wynikło podczas rozmowy. Nie kazała mi sprawdzać, co u ciebie.",shape=box,color=red];
		j1555449730 -> j107891641;
	j397837220 [label="Miewam się dobrze, dziękuję, że pytasz. A ty?",shape=box,color=blue];
