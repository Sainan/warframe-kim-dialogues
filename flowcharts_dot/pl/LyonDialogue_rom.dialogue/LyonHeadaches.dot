	237 [label="Doceniam twą gotowość do jawnego przyznania się do kłamstwa. I doceniam fakt, że nie jestem... najłatwiejszą osobą, z którą przyszło ci mieć do czynienia.",shape=box,color=blue];
		237 -> 244;
	238 [label="To prywatna sprawa, Włóczęgo. Doceniam twą próbę nawiązania ze mną konwersacji. I doceniam fakt, że nie jestem... najłatwiejszą osobą, z którą przyszło ci mieć do czynienia.",shape=box,color=blue];
		238 -> 244;
	246 [label="Update boolean LyonFaithHeadache",color=orange];
		246 -> 234;
	245 [label="Wszystko mi znane zostało zmiecione przez świetliste promienie \"Jadeitowego Światła\", przez \"Imperium Orokin\", przez \"Pustkę\" i wciąż zagraża nam \"Szept\".",shape=box,color=blue];
		245 -> 251;
	243 [label="Jak dobrze \"widzisz\", już mi przeszło. A teraz musisz się martwić o siebie. Znajdź sobie jakieś ustronne miejsce, w którym dojdziesz do siebie.",shape=box,color=blue];
		243 -> 247;
	244 [label="Chciałbym zapytać wprost, dlaczego tak w ogóle próbujesz się ze mną spoufalać?",shape=box,color=blue];
		244 -> 248;
		244 -> 249;
		244 -> 250;
		244 -> 224;
	251 [label="Więc musisz mi wybaczyć, jeśli uznam tę... propozycję więzi z twojej strony za osobliwie śmieszną w swej naiwności. Ani cię nie znam, ani ci nie ufam. I owszem, jedyne, co mogę zrobić, to zaufać słowom innych.",shape=box,color=blue];
		251 -> 255;
	247 [label="Odejdź, Włóczęgo. Zanim cię znajdę i zmuszę do odpoczynku. A to dla nikogo nie będzie przyjemne.",shape=box,color=blue];
		247 -> 252;
		247 -> 253;
	248 [label="Jak mam być szczery, to odkąd się poznaliśmy, nie mogę przestać o tobie myśleć.",shape=box,color=red];
		248 -> 254;
	249 [label="Entrati zamienił was w Protoframe'y i teraz wylądowaliście tutaj, bez przygotowania, zupełnie bez niczego. Jeśli mogę w jakikolwiek sposób pomóc wam w przystosowaniu się, to z miłą chęcią.",shape=box,color=red];
		249 -> 234;
	250 [label="No dobrze... Uważam, że jesteś fascynujący. Chciałbym cię bliżej poznać.",shape=box,color=red];
		250 -> 234;
