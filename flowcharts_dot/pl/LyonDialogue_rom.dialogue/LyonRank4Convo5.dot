digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank4Convo5 begins." [color=orange];
		"LyonRank4Convo5 begins." -> j3425926750;
	j3425926750 [label="Check boolean LyonSerum1",color=orange];
		j3425926750 -> j1372664914 [label=true,color=green];
		j3425926750 -> j386906797 [label=true,color=green];
		j3425926750 -> j4116006910 [label=false,color=brown];
		j3425926750 -> j386906797 [label=false,color=brown];
	j1372664914 [label="Leonie, zastanawiam się, czy mógłbyś mi opowiedzieć dalszą część historii o tym, jak Roathe pojawił się w Katedrze, gdy byliście w niej wraz z Marią.",shape=box,color=red];
		j1372664914 -> j2997856583;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j4116006910 [label="Leonie, zastanawiam się, czy mógłbyś mi opowiedzieć o tym, jak Roathe pojawił się w Katedrze, gdy byliście w niej wraz z Marią.",shape=box,color=red];
		j4116006910 -> j3384034606;
	j2997856583 [label="Jak sobie życzysz. Nie jest to jednak zbyt przyjemna historia. Zostawiono go na naszym progu jak rannego, zdziczałego kota.",shape=box,color=blue];
		j2997856583 -> j3769319211;
	"Chat ends." [color=orange];
	j3384034606 [label="Jak sobie życzysz. Porzucono go na naszym progu jak rannego, zdziczałego kota. Nie jest to zbyt przyjemna historia.",shape=box,color=blue];
		j3384034606 -> j3769319211;
	j3769319211 [label="Evaluate expressions",color=orange];
		j3769319211 -> j2812098870 [label="LyonStray",color=purple];
		j3769319211 -> j3276965614 [label="RoatheSerum1",color=purple];
		j3769319211 -> j57774207 [label="false",color=purple];
	j2812098870 [label="Wiedziałem, że tamta historia dotyczyła Roathe'a.",shape=box,color=red];
		j2812098870 -> j2400482051;
	j3276965614 [label="Sposób, w jaki ją opowiada, dowodzi, że miał wszelkie prawo do tego, żeby być trochę... zdziczały, gdy się pojawił.",shape=box,color=red];
		j3276965614 -> j1585314081;
	j57774207 [label="Dobrze, kontynuuj.",shape=box,color=red];
		j57774207 -> j2266356665;
	j2400482051 [label="To była historia o bezpańskim kocie, który przychodził kiedyś do Katedry. To, co w niej dostrzegasz, albo powód, dlaczego ci ją opowiadam, zależy wyłącznie od ciebie. Jestem księdzem, czyż nie?",shape=box,color=blue];
		j2400482051 -> j2266356665;
	j1585314081 [label="Spodziewałbym się, że ktoś o jego statusie i usposobieniu poczuje się pokrzywdzony poczynaniami, które Entrati podjął w stosunku do niego. Szczerze mówiąc, to byłbym bardzo zaskoczony, gdyby przyjął to z godnością.",shape=box,color=blue];
		j1585314081 -> j2266356665;
	j2266356665 [label="Evaluate expressions",color=orange];
		j2266356665 -> j1763586514 [label="LyonSerum1",color=purple];
		j2266356665 -> j1599084490 [label="false",color=purple];
	j1763586514 [label="Wydaje mi się, że skończyliśmy na tym, jak Entrati dopiero co wrócił po swoim zaginięciu z odmienionym Roathem, jakiego znamy obecnie. Entrati ujawnił nam swoje wszystkie kłamstwa, które głosił przez ostatnie trzy lata.",shape=box,color=blue];
		j1763586514 -> j3898596276;
	j1599084490 [label="Spróbuję podsumować bieg wydarzeń, który doprowadził nas do tej chwili, inaczej może się to wydawać... co najmniej niedorzeczne.",shape=box,color=blue];
		j1599084490 -> j1012901762;
	j3898596276 [label="Zaproponował nam \"serum protoframe\", które miały nas uczynić tym, czym teraz jesteśmy, a gdy tylko je przyjęliśmy... natychmiast nas porzucił.",shape=box,color=blue];
		j3898596276 -> j3490040491;
	j1012901762 [label="Przez trzy lata, dwa miesiące i jedenaście dni pełnił posługę jako kardynał Dimanche w naszej Katedrze. A przez cały ten czas wraz z Marią służyliśmy mu kompletnie nieświadomi tego, jaki los nam zgotował.",shape=box,color=blue];
		j1012901762 -> j734239754;
	j3490040491 [label="I tak zostaliśmy, niczym świeżo osierocone amalgamaty, z ciałami i duszami zmienionymi w twory, które ledwo byliśmy w stanie zrozumieć, nie mówiąc już o roszczeniu sobie prawa do panowania nad nimi.",shape=box,color=blue];
		j3490040491 -> j523405738;
	j734239754 [label="Znam twoje pytania, zanim zdołasz je zadać. Co knuł? Czy zatruł miasto, tak jak rzekomo zrobił to z Höllvanią? Jakie snuł plany? Co zdołał odkryć?",shape=box,color=blue];
		j734239754 -> j331019866;
	j523405738 [label="Porzucono nas w mieście, które było naszym domem, ale już nie było nam przyjazne. Musieliśmy się... ukrywać.",shape=box,color=blue];
		j523405738 -> j3756153479;
		j523405738 -> j3207471081;
	j331019866 [label="W tej kwestii muszę cię niestety rozczarować. Modlił się. Uczył się. Odpoczywał. I znów się modlił. Następnie, pewnej nocy zniknął w środku straszliwej burzy. Takiej samej, w której się pojawił.",shape=box,color=blue];
		j331019866 -> j2575044127;
	j3756153479 [label="Z powodu waszego wyglądu?",shape=box,color=red];
		j3756153479 -> j188134809;
	j3207471081 [label="Katedra was odrzuciła?",shape=box,color=red];
		j3207471081 -> j4207784971;
	j2575044127 [label="Check boolean MarieLyonVisions",color=orange];
		j2575044127 -> j3011481613 [label=true,color=green];
		j2575044127 -> j1126701469 [label=false,color=brown];
	j188134809 [label="Nie wiem, czy zdążyłeś zauważyć, ale Maria potrafi latać, a Roathe jest... niebieski i nie tylko.",shape=box,color=blue];
		j188134809 -> j1610950431;
	j4207784971 [label="Nie… nie w ten sposób. Zostaliśmy zmuszeni do odejścia z życia publicznego. Ale nasi Bracia i Siostry nie wygnali nas na ulice ani nie spalili na stosie. \"Kardynał Dimanche\" przekonał ich, że nasza przemiana była… dziełem Świetlistych.",shape=box,color=blue];
		j4207784971 -> j2511243453;
	j3011481613 [label="Choć doskonale zdaję sobie sprawę, że burza nie była taka oczywista dla innych, dla mnie była ona aż nadto wyraźna.",shape=box,color=blue];
		j3011481613 -> j1126701469;
	j1126701469 [label="Dokładnie rok później pojawił się po raz ostatni, a u jego stóp leżał... zapadnięty w sobie i nieprzytomny Roathe, jakiego znasz.",shape=box,color=blue];
		j1126701469 -> j1448388627;
	j1610950431 [label="Rozumiem, że spędzasz swoje dni na zabawie z gadającymi zwierzętami, czaszkami i rozmyślaniu na temat kosmicznej Pustki, ale dla większości ludzi to nie jest coś normalnego.",shape=box,color=blue];
		j1610950431 -> j392977001;
	j2511243453 [label="Byliśmy ukrywani w kryptach i trzymani z dala od wzroku ciekawskich. Nasi dawni bracia bali się nas, lecz wciąż przynosili nam zapasy.",shape=box,color=blue];
		j2511243453 -> j2449417730;
	j1448388627 [label="Wyglądał jak diabeł wcielony. To właśnie wtedy Entrati wyjawił nam prawdę, kim tak naprawdę był – gdy zasalutował – i jakie zadanie ma dla nas.\" Jak wybrał nas oboje do najświętszej misji.",shape=box,color=blue];
		j1448388627 -> j2674674664;
	j392977001 [label="I to prawda, że z naszej trójki to właśnie ja mógłbym poruszać się swobodnie wśród tłumu, gdybym tylko zasłonił to i owo. ",shape=box,color=blue];
		j392977001 -> j2718359866;
		j392977001 -> j2520541334;
	j2449417730 [label="Oni... nalegali, aby kontaktować się wyłącznie z Marią, mimo że nagle pojawiała się na powitanie, niczym duch. ",shape=box,color=blue];
		j2449417730 -> j85086666;
		j2449417730 -> j2189708401;
	j2674674664 [label="Maria ochoczo przyjęła serum. Oczywiście. Jakże mogłaby tego nie zrobić? I dlaczego miałbym nie pójść w jej ślady? Jak mógłbym nie szukać prawdy, dokądkolwiek by mnie to nie zaprowadziło?",shape=box,color=blue];
		j2674674664 -> j249472217;
	j2718359866 [label="Gdzie się zatrzymaliście?",shape=box,color=red];
		j2718359866 -> j2082855922;
	j2520541334 [label="I jak się tu wszyscy znaleźliście?",shape=box,color=red];
		j2520541334 -> j3995685223;
	j85086666 [label="Potrafię zrozumieć chęć unikania Roathe'a, ale... woleli to od rozmowy z tobą?",shape=box,color=red];
		j85086666 -> j3040065258;
	j2189708401 [label="Ona jest bardzo miła...",shape=box,color=red];
		j2189708401 -> j1836898967;
	j249472217 [label="Boolean LyonSerum1 is now true.",color=orange];
		j249472217 -> j202746104;
		j249472217 -> j399666205;
		j249472217 -> j2754618115;
	j2082855922 [label="Nasi Bracia i Siostry nie wygnali nas na ulice ani nie spalili na stosie. \"Kardynał Dimanche\" przekonał ich, że nasza przemiana była… dziełem Świetlistych.",shape=box,color=blue];
		j2082855922 -> j1299904011;
	j3995685223 [label="Roathe będzie dokładnie wiedział, ale po... wielu latach pracy stworzył \"Helmintha\" z próbek naszej krwi.",shape=box,color=blue];
		j3995685223 -> j1944924885;
	j3040065258 [label="Chyba już mnie trochę poznałeś, prawda?",shape=box,color=blue];
		j3040065258 -> j3955624431;
	j1836898967 [label="Dokładnie.",shape=box,color=blue];
		j1836898967 -> j1680102392;
	j202746104 [label="Myślę, że ona wciąż otacza Entratiego zbyt wielką czcią.",shape=box,color=red];
		j202746104 -> j2380612381;
	j399666205 [label="Co się później wydarzyło?",shape=box,color=red];
		j399666205 -> j3118595847;
	j2754618115 [label="Żałujesz tego?",shape=box,color=red];
		j2754618115 -> j1489352900;
	j1299904011 [label="Byliśmy ukrywani w kryptach i trzymani z dala od wzroku ciekawskich. Nasi dawni bracia bali się nas, lecz wciąż przynosili nam zapasy.",shape=box,color=blue];
		j1299904011 -> j1007911875;
	j1944924885 [label="Wierzę, że Plaga jest w jakiś sposób powiązana ze sobą poprzez... czas... choć szczegóły są dla mnie zupełnie niezrozumiałe.",shape=box,color=blue];
		j1944924885 -> j2320441504;
		j1944924885 -> j2170702296;
	j3955624431 [label="Jak długo tam tkwiliście?",shape=box,color=red];
		j3955624431 -> j2697549917;
	j1680102392 [label="Czyli... trzymali was wszystkich w piwnicy?",shape=box,color=red];
		j1680102392 -> j3853771657;
	j2380612381 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j2380612381 -> j1308740722;
	j3118595847 [label="Roathe się wybudził. Z początku ledwo pamiętał, jak się nazywa. Entrati powiedział temu draniowi na pożegnanie: \"Urielu, wygnańcu, Heretyku Xaty, odpowiedz – czy Orokin kiedykolwiek mogą uzyskać przebaczenie?\".",shape=box,color=blue];
		j3118595847 -> j1223869533;
	j1489352900 [label="Wszystkiego żałuję, Włóczęgo. Oczywiście, że tak. Ale czy zrobiłbym to ponownie? Tak, oczywiście. Nie mógłbym zostawić Marii samej.",shape=box,color=blue];
		j1489352900 -> j3136196843;
	j1007911875 [label="Oni... nalegali, aby kontaktować się wyłącznie z Marią, mimo że nagle pojawiała się na powitanie, niczym duch. ",shape=box,color=blue];
		j1007911875 -> j57588222;
		j1007911875 -> j3030176127;
	j2320441504 [label="Dokonał inżynierii wstecznej Helmintha?! Ile to trwało?!",shape=box,color=red];
		j2320441504 -> j1124051129;
	j2170702296 [label="Nie sądzę, żeby ktokolwiek to rozumiał. To nowe odkrycie.",shape=box,color=red];
		j2170702296 -> j4162547436;
	j2697549917 [label="To nie mnie powinieneś pytać o to, ile lat minęło, odkąd zostaliśmy przemienieni w gadające, zainfekowane zlepki. Moje pojęcie o upływie tego czasu jest... zawiłe.",shape=box,color=blue];
		j2697549917 -> j2314469083;
		j2697549917 -> j2814923468;
	j3853771657 [label="Zapewne brzmi to gorzej, niż mogłoby się wydawać. Nie było innego miejsca, gdzie mogliśmy się schronić. Dzwonnica była zbyt otwarta i wystawiona na trudne warunki pogodowe. Krypta była za to osłonięta i ciepła.",shape=box,color=blue];
		j3853771657 -> j2183696899;
	j1308740722 [label="W tej kwestii się zgadzamy. Ale nie mogę mieć do niej pretensji o to. Daj jej trochę czasu. W końcu zrozumie. Jest niezwykle inteligentna, Włóczęgo. Nie traktuj jej jak kretynki.",shape=box,color=blue];
		j1308740722 -> j3136196843;
	j1223869533 [label="Entrati odszedł wtedy po raz ostatni. I porzucił u nas Roathe'a, przemienionego w to, co sam widzisz – kogoś lepiej przygotowanego do walki z rozdrażnionym diabłem.",shape=box,color=blue];
		j1223869533 -> j3490040491;
	j3136196843 [label="Kontynuując ten wątek... Entrati odszedł wtedy po raz ostatni. I porzucił u nas Roathe'a, przemienionego w to, co sam widzisz – kogoś lepiej przygotowanego do walki z rozdrażnionym diabłem.",shape=box,color=blue];
		j3136196843 -> j3490040491;
	j57588222 [label="Potrafię zrozumieć chęć unikania Roathe'a, ale... woleli to od rozmowy z tobą?",shape=box,color=red];
		j57588222 -> j2944690660;
	j3030176127 [label="Ona jest bardzo miła...",shape=box,color=red];
		j3030176127 -> j2555902224;
	j1124051129 [label="Boolean LyonRoatheHelminth is now true.",color=orange];
		j1124051129 -> j3120237246;
	j4162547436 [label="Nie wiem, czy to powinno mnie pocieszyć, czy wprawić w konsternację, ale dziękuję. Dziwnie się czuję, wiedząc, że Plaga potrafi mówić.",shape=box,color=blue];
		j4162547436 -> j2900228709;
		j4162547436 -> j232756384;
	j2314469083 [label="Jak to zawiłe?",shape=box,color=red];
		j2314469083 -> j3271717658;
	j2814923468 [label="Nie jestem pewien, czy powinienem ci o tym powiedzieć, że Plaga potrafi także mówić...",shape=box,color=red];
		j2814923468 -> j674694073;
	j2183696899 [label="I niestety, ale odkryliśmy, że były tam inne wyjścia, które Roathe wykorzystywał do... szwendania się.",shape=box,color=blue];
		j2183696899 -> j845860967;
	j2944690660 [label="Chyba już mnie trochę poznałeś, prawda?",shape=box,color=blue];
		j2944690660 -> j3955624431;
		j2944690660 -> j1680102392;
	j2555902224 [label="Dokładnie.",shape=box,color=blue];
		j2555902224 -> j1680102392;
		j2555902224 -> j3955624431;
	j3120237246 [label="To nie mnie powinieneś pytać. Moje pojęcie o upływie czasu jest... zawiłe. Choć bardziej trafne byłoby stwierdzenie \"jeszcze bardziej zawiłe\". Jakby już to nie mogło być wystarczająco przerażające...",shape=box,color=blue];
		j3120237246 -> j2314469083;
		j3120237246 -> j2814923468;
	j2900228709 [label="Nie wszystkie. Krzesła mogą być czasami... cóż... to nieistotne. Mów dalej, proszę.",shape=box,color=red];
		j2900228709 -> j3259913206;
	j232756384 [label="Oszczędzę ci rozmowy o gitarze.",shape=box,color=red];
		j232756384 -> j463858758;
	j3271717658 [label="Boolean LyonTime1 is now true.",color=orange];
		j3271717658 -> j1257373967;
	j674694073 [label="Dobrze o tym wiem. I to jest niepokojące, dziękuję. Chociaż zdaje się, że niemal każdy sprzęt domowy w tym miejscu potrafi mówić.",shape=box,color=blue];
		j674694073 -> j2900228709;
		j674694073 -> j232756384;
	j845860967 [label="Evaluate expressions",color=orange];
		j845860967 -> j4055130071 [label="MarieRoathePastry1",color=purple];
		j845860967 -> j4055130071 [label="RoatheMariePastry1",color=purple];
		j845860967 -> j2375742728 [label="false",color=purple];
	j3259913206 [label="Jeśli chciałeś powiedzieć, że \"zajęte\", to je też już widziałem, Włóczęgo. Tego szepczącego. Tego ze ściany. Słyszałem stukanie...",shape=box,color=blue];
		j3259913206 -> j1880069847;
	j463858758 [label="O tak, poproszę. Chociaż myślę, że o wiele bardziej cieszyłoby mnie, gdyby instrument muzyczny był jakimś przejezdnym półbogiem, niż... cokolwiek innego, co przychodzi prześladować i porzucić mój umysł. Czy to dziwne, że ja... odkąd on...",shape=box,color=blue];
		j463858758 -> j141929901;
	j1257373967 [label="Nie jestem pewien, czy to z powodu mojej wyjątkowego przewrażliwienia w tej kwestii, czy też... indywidualnych okoliczności, w jakich stałem się... czy nim...",shape=box,color=blue];
		j1257373967 -> j651700047;
	j4055130071 [label="Tak, słyszałem.",shape=box,color=red];
		j4055130071 -> j3168330351;
	j2375742728 [label="Och tak?",shape=box,color=red];
		j2375742728 -> j3003741708;
	j1880069847 [label="Jest pewien głos, który do mnie dotarł, a którego nigdy wcześniej nie słyszałem. A jednak sięga do mojej przeszłości i daleko w moją przyszłość...",shape=box,color=blue];
		j1880069847 -> j537441369;
	j141929901 [label="On?",shape=box,color=red];
		j141929901 -> j1880069847;
	j651700047 [label="Wiem, że pewnie weźmiesz mnie za kompletnego szaleńca, gdy to powiem, ale ja nie doświadczam czasu w sposób... czysto... liniowy.",shape=box,color=blue];
		j651700047 -> j265251570;
		j651700047 -> j831181943;
	j3168330351 [label="Postrzegam to jako jedną z jego niewielu zalet. Z pewnością nie jest złodziejem. Chodzi o ciąg myślowy. Moim zdaniem, zdobył nielegalne towary, aby sprowokować Marię do rozmowy.",shape=box,color=blue];
		j3168330351 -> j2216764361;
	j3003741708 [label="Ani w te, ani we w tę.",shape=box,color=blue];
		j3003741708 -> j3159308922;
		j3003741708 -> j3522809100;
	j537441369 [label="Niemożliwe, żeby zawsze tam tkwił. Choć potrafię go teraz przywołać, wyraźnie niczym srebrne światło samej Lui, za ścianą mojego domu, gdy byłem dzieckiem. Głos młodego mężczyzny. Czyjąś obecność u jego boku... \"Stuk, puk, puk...\"",shape=box,color=blue];
		j537441369 -> j3084535944;
	j265251570 [label="\"Nim\"? Czyli kim?",shape=box,color=red];
		j265251570 -> j1880069847;
	j831181943 [label="Od wielu stuleci doświadczam czas jako zapętlające się spirale, Leonie.",shape=box,color=red];
		j831181943 -> j478032439;
	j2216764361 [label="A może dlatego, że wywoływały uśmiech na jej twarzy, gdy sądziła, że on nie patrzy. Kiedyś mi powiedział: \"To niesprawiedliwe zrządzenie losu, że została w ten sposób pozbawiona życia\".",shape=box,color=blue];
		j2216764361 -> j3733610902;
	j3159308922 [label="Ile czasu zajął wam powrót do... no wiesz, dotąd?",shape=box,color=red];
		j3159308922 -> j2564801250;
	j3522809100 [label="Co było dalej?",shape=box,color=red];
		j3522809100 -> j3995685223;
	j3084535944 [label="Ja... wybacz. Muszę iść. Nie mogę jeszcze o tym mówić. Przepraszam. Więcej mnie o to nie pytaj.",shape=box,color=blue];
		j3084535944 -> j357141701;
	j478032439 [label="A co ty na to, że ci powiem, że mówię głosem, który dotarł do mnie spoza mojego własnego racjonalnego umysłu? Wiem, że nigdy wcześniej w życiu go nie słyszałem. Niemożliwe jest, aby zawsze tam tkwił.",shape=box,color=blue];
		j478032439 -> j1719219121;
	j3733610902 [label="Boolean LyonRoathePastry is now true.",color=orange];
		j3733610902 -> j1199398062;
		j3733610902 -> j3159308922;
