digraph {
	1076 [label="LyonRank4Convo5 begins.",color=orange];
		1076 -> 1077;
	1077 [label="Check boolean LyonSerum1",color=orange];
		1077 -> 1079 [label=true,color=green];
		1077 -> 1080 [label=true,color=green];
		1077 -> 1078 [label=false,color=brown];
		1077 -> 1080 [label=false,color=brown];
	1079 [label="Leonie, zastanawiam się, czy mógłbyś mi opowiedzieć dalszą część historii o tym, jak Roathe pojawił się w Katedrze, gdy byliście w niej wraz z Marią.",shape=box,color=red];
		1079 -> 1082;
	1080 [label="[Koniec]",shape=box,color=red];
		1080 -> 1083;
	1078 [label="Leonie, zastanawiam się, czy mógłbyś mi opowiedzieć o tym, jak Roathe pojawił się w Katedrze, gdy byliście w niej wraz z Marią.",shape=box,color=red];
		1078 -> 1081;
	1082 [label="Jak sobie życzysz. Nie jest to jednak zbyt przyjemna historia. Zostawiono go na naszym progu jak rannego, zdziczałego kota.",shape=box,color=blue];
		1082 -> 1084;
	1083 [label="Chat ends.",color=orange];
	1081 [label="Jak sobie życzysz. Porzucono go na naszym progu jak rannego, zdziczałego kota. Nie jest to zbyt przyjemna historia.",shape=box,color=blue];
		1081 -> 1084;
	1084 [label="Evaluate expressions",color=orange];
		1084 -> 1087 [label="LyonStray",color=purple];
		1084 -> 1086 [label="RoatheSerum1",color=purple];
		1084 -> 1085 [label="false",color=purple];
	1087 [label="Wiedziałem, że tamta historia dotyczyła Roathe'a.",shape=box,color=red];
		1087 -> 1090;
	1086 [label="Sposób, w jaki ją opowiada, dowodzi, że miał wszelkie prawo do tego, żeby być trochę... zdziczały, gdy się pojawił.",shape=box,color=red];
		1086 -> 1089;
	1085 [label="Dobrze, kontynuuj.",shape=box,color=red];
		1085 -> 1088;
	1090 [label="To była historia o bezpańskim kocie, który przychodził kiedyś do Katedry. To, co w niej dostrzegasz, albo powód, dlaczego ci ją opowiadam, zależy wyłącznie od ciebie. Jestem księdzem, czyż nie?",shape=box,color=blue];
		1090 -> 1088;
	1089 [label="Spodziewałbym się, że ktoś o jego statusie i usposobieniu poczuje się pokrzywdzony poczynaniami, które Entrati podjął w stosunku do niego. Szczerze mówiąc, to byłbym bardzo zaskoczony, gdyby przyjął to z godnością.",shape=box,color=blue];
		1089 -> 1088;
	1088 [label="Evaluate expressions",color=orange];
		1088 -> 1092 [label="LyonSerum1",color=purple];
		1088 -> 1091 [label="false",color=purple];
	1092 [label="Wydaje mi się, że skończyliśmy na tym, jak Entrati dopiero co wrócił po swoim zaginięciu z odmienionym Roathem, jakiego znamy obecnie. Entrati ujawnił nam swoje wszystkie kłamstwa, które głosił przez ostatnie trzy lata.",shape=box,color=blue];
		1092 -> 1094;
	1091 [label="Spróbuję podsumować bieg wydarzeń, który doprowadził nas do tej chwili, inaczej może się to wydawać... co najmniej niedorzeczne.",shape=box,color=blue];
		1091 -> 1093;
	1094 [label="Zaproponował nam \"serum protoframe\", które miały nas uczynić tym, czym teraz jesteśmy, a gdy tylko je przyjęliśmy... natychmiast nas porzucił.",shape=box,color=blue];
		1094 -> 1096;
	1093 [label="Przez trzy lata, dwa miesiące i jedenaście dni pełnił posługę jako kardynał Dimanche w naszej Katedrze. A przez cały ten czas wraz z Marią służyliśmy mu kompletnie nieświadomi tego, jaki los nam zgotował.",shape=box,color=blue];
		1093 -> 1095;
	1096 [label="I tak zostaliśmy, niczym świeżo osierocone amalgamaty, z ciałami i duszami zmienionymi w twory, które ledwo byliśmy w stanie zrozumieć, nie mówiąc już o roszczeniu sobie prawa do panowania nad nimi.",shape=box,color=blue];
		1096 -> 1098;
	1095 [label="Znam twoje pytania, zanim zdołasz je zadać. Co knuł? Czy zatruł miasto, tak jak rzekomo zrobił to z Höllvanią? Jakie snuł plany? Co zdołał odkryć?",shape=box,color=blue];
		1095 -> 1097;
	1098 [label="Porzucono nas w mieście, które było naszym domem, ale już nie było nam przyjazne. Musieliśmy się... ukrywać.",shape=box,color=blue];
		1098 -> 1100;
		1098 -> 1101;
	1097 [label="W tej kwestii muszę cię niestety rozczarować. Modlił się. Uczył się. Odpoczywał. I znów się modlił. Następnie, pewnej nocy zniknął w środku straszliwej burzy. Takiej samej, w której się pojawił.",shape=box,color=blue];
		1097 -> 1099;
	1100 [label="Z powodu waszego wyglądu?",shape=box,color=red];
		1100 -> 1104;
	1101 [label="Katedra was odrzuciła?",shape=box,color=red];
		1101 -> 1105;
	1099 [label="Check boolean MarieLyonVisions",color=orange];
		1099 -> 1103 [label=true,color=green];
		1099 -> 1102 [label=false,color=brown];
	1104 [label="Nie wiem, czy zdążyłeś zauważyć, ale Maria potrafi latać, a Roathe jest... niebieski i nie tylko.",shape=box,color=blue];
		1104 -> 1107;
	1105 [label="Nie… nie w ten sposób. Zostaliśmy zmuszeni do odejścia z życia publicznego. Ale nasi Bracia i Siostry nie wygnali nas na ulice ani nie spalili na stosie. \"Kardynał Dimanche\" przekonał ich, że nasza przemiana była… dziełem Świetlistych.",shape=box,color=blue];
		1105 -> 1108;
	1103 [label="Choć doskonale zdaję sobie sprawę, że burza nie była taka oczywista dla innych, dla mnie była ona aż nadto wyraźna.",shape=box,color=blue];
		1103 -> 1102;
	1102 [label="Dokładnie rok później pojawił się po raz ostatni, a u jego stóp leżał... zapadnięty w sobie i nieprzytomny Roathe, jakiego znasz.",shape=box,color=blue];
		1102 -> 1106;
	1107 [label="Rozumiem, że spędzasz swoje dni na zabawie z gadającymi zwierzętami, czaszkami i rozmyślaniu na temat kosmicznej Pustki, ale dla większości ludzi to nie jest coś normalnego.",shape=box,color=blue];
		1107 -> 1110;
	1108 [label="Byliśmy ukrywani w kryptach i trzymani z dala od wzroku ciekawskich. Nasi dawni bracia bali się nas, lecz wciąż przynosili nam zapasy.",shape=box,color=blue];
		1108 -> 1111;
	1106 [label="Wyglądał jak diabeł wcielony. To właśnie wtedy Entrati wyjawił nam prawdę, kim tak naprawdę był – gdy zasalutował – i jakie zadanie ma dla nas.\" Jak wybrał nas oboje do najświętszej misji.",shape=box,color=blue];
		1106 -> 1109;
	1110 [label="I to prawda, że z naszej trójki to właśnie ja mógłbym poruszać się swobodnie wśród tłumu, gdybym tylko zasłonił to i owo. ",shape=box,color=blue];
		1110 -> 1113;
		1110 -> 1114;
	1111 [label="Oni... nalegali, aby kontaktować się wyłącznie z Marią, mimo że nagle pojawiała się na powitanie, niczym duch. ",shape=box,color=blue];
		1111 -> 1115;
		1111 -> 1116;
	1109 [label="Maria ochoczo przyjęła serum. Oczywiście. Jakże mogłaby tego nie zrobić? I dlaczego miałbym nie pójść w jej ślady? Jak mógłbym nie szukać prawdy, dokądkolwiek by mnie to nie zaprowadziło?",shape=box,color=blue];
		1109 -> 1112;
	1113 [label="Gdzie się zatrzymaliście?",shape=box,color=red];
		1113 -> 1120;
	1114 [label="I jak się tu wszyscy znaleźliście?",shape=box,color=red];
		1114 -> 1121;
	1115 [label="Potrafię zrozumieć chęć unikania Roathe'a, ale... woleli to od rozmowy z tobą?",shape=box,color=red];
		1115 -> 1122;
	1116 [label="Ona jest bardzo miła...",shape=box,color=red];
		1116 -> 1123;
	1112 [label="Update boolean LyonSerum1",color=orange];
		1112 -> 1117;
		1112 -> 1118;
		1112 -> 1119;
	1120 [label="Nasi Bracia i Siostry nie wygnali nas na ulice ani nie spalili na stosie. \"Kardynał Dimanche\" przekonał ich, że nasza przemiana była… dziełem Świetlistych.",shape=box,color=blue];
		1120 -> 1127;
	1121 [label="Roathe będzie dokładnie wiedział, ale po... wielu latach pracy stworzył \"Helmintha\" z próbek naszej krwi.",shape=box,color=blue];
		1121 -> 1128;
	1122 [label="Chyba już mnie trochę poznałeś, prawda?",shape=box,color=blue];
		1122 -> 1129;
	1123 [label="Dokładnie.",shape=box,color=blue];
		1123 -> 1130;
	1117 [label="Myślę, że ona wciąż otacza Entratiego zbyt wielką czcią.",shape=box,color=red];
		1117 -> 1124;
	1118 [label="Co się później wydarzyło?",shape=box,color=red];
		1118 -> 1125;
	1119 [label="Żałujesz tego?",shape=box,color=red];
		1119 -> 1126;
	1127 [label="Byliśmy ukrywani w kryptach i trzymani z dala od wzroku ciekawskich. Nasi dawni bracia bali się nas, lecz wciąż przynosili nam zapasy.",shape=box,color=blue];
		1127 -> 1134;
	1128 [label="Wierzę, że Plaga jest w jakiś sposób powiązana ze sobą poprzez... czas... choć szczegóły są dla mnie zupełnie niezrozumiałe.",shape=box,color=blue];
		1128 -> 1135;
		1128 -> 1136;
	1129 [label="Jak długo tam tkwiliście?",shape=box,color=red];
		1129 -> 1137;
	1130 [label="Czyli... trzymali was wszystkich w piwnicy?",shape=box,color=red];
		1130 -> 1138;
	1124 [label="Update boolean LyonMarieEntrati",color=orange];
		1124 -> 1131;
	1125 [label="Roathe się wybudził. Z początku ledwo pamiętał, jak się nazywa. Entrati powiedział temu draniowi na pożegnanie: \"Urielu, wygnańcu, Heretyku Xaty, odpowiedz – czy Orokin kiedykolwiek mogą uzyskać przebaczenie?\".",shape=box,color=blue];
		1125 -> 1132;
	1126 [label="Wszystkiego żałuję, Włóczęgo. Oczywiście, że tak. Ale czy zrobiłbym to ponownie? Tak, oczywiście. Nie mógłbym zostawić Marii samej.",shape=box,color=blue];
		1126 -> 1133;
	1134 [label="Oni... nalegali, aby kontaktować się wyłącznie z Marią, mimo że nagle pojawiała się na powitanie, niczym duch. ",shape=box,color=blue];
		1134 -> 1139;
		1134 -> 1140;
	1135 [label="Dokonał inżynierii wstecznej Helmintha?! Ile to trwało?!",shape=box,color=red];
		1135 -> 1141;
	1136 [label="Nie sądzę, żeby ktokolwiek to rozumiał. To nowe odkrycie.",shape=box,color=red];
		1136 -> 1142;
	1137 [label="To nie mnie powinieneś pytać o to, ile lat minęło, odkąd zostaliśmy przemienieni w gadające, zainfekowane zlepki. Moje pojęcie o upływie tego czasu jest... zawiłe.",shape=box,color=blue];
		1137 -> 1143;
		1137 -> 1144;
	1138 [label="Zapewne brzmi to gorzej, niż mogłoby się wydawać. Nie było innego miejsca, gdzie mogliśmy się schronić. Dzwonnica była zbyt otwarta i wystawiona na trudne warunki pogodowe. Krypta była za to osłonięta i ciepła.",shape=box,color=blue];
		1138 -> 1145;
	1131 [label="W tej kwestii się zgadzamy. Ale nie mogę mieć do niej pretensji o to. Daj jej trochę czasu. W końcu zrozumie. Jest niezwykle inteligentna, Włóczęgo. Nie traktuj jej jak kretynki.",shape=box,color=blue];
		1131 -> 1133;
	1132 [label="Entrati odszedł wtedy po raz ostatni. I porzucił u nas Roathe'a, przemienionego w to, co sam widzisz – kogoś lepiej przygotowanego do walki z rozdrażnionym diabłem.",shape=box,color=blue];
		1132 -> 1096;
	1133 [label="Kontynuując ten wątek... Entrati odszedł wtedy po raz ostatni. I porzucił u nas Roathe'a, przemienionego w to, co sam widzisz – kogoś lepiej przygotowanego do walki z rozdrażnionym diabłem.",shape=box,color=blue];
		1133 -> 1096;
	1139 [label="Potrafię zrozumieć chęć unikania Roathe'a, ale... woleli to od rozmowy z tobą?",shape=box,color=red];
		1139 -> 1146;
	1140 [label="Ona jest bardzo miła...",shape=box,color=red];
		1140 -> 1147;
	1141 [label="Update boolean LyonRoatheHelminth",color=orange];
		1141 -> 1148;
	1142 [label="Nie wiem, czy to powinno mnie pocieszyć, czy wprawić w konsternację, ale dziękuję. Dziwnie się czuję, wiedząc, że Plaga potrafi mówić.",shape=box,color=blue];
		1142 -> 1149;
		1142 -> 1150;
	1143 [label="Jak to zawiłe?",shape=box,color=red];
		1143 -> 1151;
	1144 [label="Nie jestem pewien, czy powinienem ci o tym powiedzieć, że plaga potrafi także mówić...",shape=box,color=red];
		1144 -> 1152;
	1145 [label="I niestety, ale odkryliśmy, że były tam inne wyjścia, które Roathe wykorzystywał do... szwendania się.",shape=box,color=blue];
		1145 -> 1153;
	1146 [label="Chyba już mnie trochę poznałeś, prawda?",shape=box,color=blue];
		1146 -> 1129;
		1146 -> 1130;
	1147 [label="Dokładnie.",shape=box,color=blue];
		1147 -> 1130;
		1147 -> 1129;
	1148 [label="To nie mnie powinieneś pytać. Moje pojęcie o upływie czasu jest... zawiłe. Choć bardziej trafne byłoby stwierdzenie \"jeszcze bardziej zawiłe\". Jakby już to nie mogło być wystarczająco przerażające...",shape=box,color=blue];
		1148 -> 1143;
		1148 -> 1144;
	1149 [label="Nie wszystkie. Krzesła mogą być czasami... cóż... to nieistotne. Mów dalej, proszę.",shape=box,color=red];
		1149 -> 1154;
	1150 [label="Oszczędzę ci rozmowy o gitarze.",shape=box,color=red];
		1150 -> 1155;
	1151 [label="Update boolean LyonTime1",color=orange];
		1151 -> 1156;
	1152 [label="Dobrze o tym wiem. I to jest niepokojące, dziękuję. Chociaż zdaje się, że niemal każdy sprzęt domowy w tym miejscu potrafi mówić.",shape=box,color=blue];
		1152 -> 1149;
		1152 -> 1150;
	1153 [label="Evaluate expressions",color=orange];
		1153 -> 1157 [label="MarieRoathePastry1",color=purple];
		1153 -> 1157 [label="RoatheMariePastry1",color=purple];
		1153 -> 1158 [label="false",color=purple];
	1154 [label="Jeśli chciałeś powiedzieć, że \"zajęte\", to je też już widziałem, Włóczęgo. Tego szepczącego. Tego ze ściany. Słyszałem stukanie...",shape=box,color=blue];
		1154 -> 1159;
	1155 [label="O tak, poproszę. Chociaż myślę, że o wiele bardziej cieszyłoby mnie, gdyby instrument muzyczny był jakimś przejezdnym półbogiem, niż... cokolwiek innego, co przychodzi prześladować i porzucić mój umysł. Czy to dziwne, że ja... odkąd on...",shape=box,color=blue];
		1155 -> 1160;
	1156 [label="Nie jestem pewien, czy to z powodu mojej wyjątkowego przewrażliwienia w tej kwestii, czy też... indywidualnych okoliczności, w jakich stałem się... czy nim...",shape=box,color=blue];
		1156 -> 1161;
	1157 [label="Tak, słyszałem.",shape=box,color=red];
		1157 -> 1162;
	1158 [label="Och tak?",shape=box,color=red];
		1158 -> 1163;
	1159 [label="Jest pewien głos, który do mnie dotarł, a którego nigdy wcześniej nie słyszałem. A jednak sięga do mojej przeszłości i daleko w moją przyszłość...",shape=box,color=blue];
		1159 -> 1164;
	1160 [label="On?",shape=box,color=red];
		1160 -> 1159;
	1161 [label="Wiem, że pewnie weźmiesz mnie za kompletnego szaleńca, gdy to powiem, ale ja nie doświadczam czasu w sposób... czysto... liniowy.",shape=box,color=blue];
		1161 -> 1165;
		1161 -> 1166;
	1162 [label="Postrzegam to jako jedną z jego niewielu zalet. Z pewnością nie jest złodziejem. Chodzi o ciąg myślowy. Moim zdaniem, zdobył nielegalne towary, aby sprowokować Marię do rozmowy.",shape=box,color=blue];
		1162 -> 1167;
	1163 [label="Ani w te, ani we w tę.",shape=box,color=blue];
		1163 -> 1168;
		1163 -> 1169;
	1164 [label="Niemożliwe, żeby zawsze tam tkwił. Choć potrafię go teraz przywołać, wyraźnie niczym srebrne światło samej Lui, za ścianą mojego domu, gdy byłem dzieckiem. Głos młodego mężczyzny. Czyjąś obecność u jego boku... \"Stuk, puk, puk...\"",shape=box,color=blue];
		1164 -> 1170;
	1165 [label="\"Nim\"? Czyli kim?",shape=box,color=red];
		1165 -> 1159;
	1166 [label="Od wielu stuleci doświadczam czas jako zapętlające się spirale, Leonie.",shape=box,color=red];
		1166 -> 1171;
	1167 [label="A może dlatego, że wywoływały uśmiech na jej twarzy, gdy sądziła, że on nie patrzy. Kiedyś mi powiedział: \"To niesprawiedliwe zrządzenie losu, że została w ten sposób pozbawiona życia\".",shape=box,color=blue];
		1167 -> 1172;
	1168 [label="Ile czasu zajął wam powrót do... no wiesz, dotąd?",shape=box,color=red];
		1168 -> 1173;
	1169 [label="Co było dalej?",shape=box,color=red];
		1169 -> 1121;
	1170 [label="Ja... wybacz. Muszę iść. Nie mogę jeszcze o tym mówić. Przepraszam. Więcej mnie o to nie pytaj.",shape=box,color=blue];
		1170 -> 1174;
	1171 [label="A co ty na to, że ci powiem, że mówię głosem, który dotarł do mnie spoza mojego własnego racjonalnego umysłu? Wiem, że nigdy wcześniej w życiu go nie słyszałem. Niemożliwe jest, aby zawsze tam tkwił.",shape=box,color=blue];
		1171 -> 1175;
	1172 [label="Update boolean LyonRoathePastry",color=orange];
		1172 -> 1176;
		1172 -> 1168;
	1173 [label="To nie mnie powinieneś pytać o to, ile lat minęło, odkąd zostaliśmy przemienieni w gadające, zainfekowane zlepki. Moje pojęcie o upływie tego czasu jest... zawiłe.",shape=box,color=blue];
		1173 -> 1144;
		1173 -> 1143;
	1174 [label="Leonie, zaczekaj!",shape=box,color=red];
		1174 -> 1177;
	1175 [label="Choć potrafię go teraz przywołać, wyraźnie niczym srebrne światło samej Lui, za ścianą mojego domu, gdy byłem dzieckiem. Głos młodego mężczyzny... \"Stuk, puk, puk...\"",shape=box,color=blue];
		1175 -> 1170;
	1176 [label="Zgadzam się, w jego wykonaniu to brzmi niemal uroczo. Co było dalej?",shape=box,color=red];
		1176 -> 1121;
	1177 [label="Update boolean LyonRell1",color=orange];
		1177 -> 1178;
	1178 [label="+20 Chemistry",color=orange];
		1178 -> 1179;
	1179 [label="Chat ends.",color=orange];
}