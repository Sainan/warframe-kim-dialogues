digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank3Convo3 begins." [color=orange];
		"LyonRank3Convo3 begins." -> j3936030168;
	j3936030168 [label="Pomagałem p. Loidowi w jego bibliotece, odkładając książki na półki, choć upierał się, że mogłyby to robić te cudaczne... ustrojstwa.",shape=box,color=blue];
		j3936030168 -> j2896305151;
	j2896305151 [label="I tak oto natrafiłem na ciekawe tomiszcze pióra Eulerii Entrati, zawierające bajki dla dzieci, których akcja rozgrywała się w fikcyjnym świecie.",shape=box,color=blue];
		j2896305151 -> j928628686;
	j928628686 [label="Gdy tylko spostrzegłem, że autorka nosi to samo nazwisko, co nasz \"kardynał Dimanche\", natychmiast odłożyłem sobie ten egzemplarz.",shape=box,color=blue];
		j928628686 -> j3317894902;
		j928628686 -> j1608785754;
		j928628686 -> j3674632450;
	j3317894902 [label="Chyba wiem, o której książce mówisz...",shape=box,color=red];
		j3317894902 -> j614652109;
	j1608785754 [label="Czy możemy pominąć ten wstęp? Zapytaj mnie o to, czego chcesz się dowiedzieć.",shape=box,color=red];
		j1608785754 -> j2066941437;
	j3674632450 [label="[Zignoruj]",shape=box,color=red];
		j3674632450 -> "Chat ends.";
	j614652109 [label="+5 Chemistry",color=orange];
		j614652109 -> j2631269980;
	j2066941437 [label="Boolean LyonMITW1 is now true.",color=orange];
		j2066941437 -> j914820900;
	"Chat ends." [color=orange];
	j2631269980 [label="Sądząc po przerażonym spojrzeniu, jakim obdarzył mnie p. Loid, i jego naleganiu, abym natychmiast odłożył tę książkę, by \"cię nie denerwować\" – domyśliłem się, że coś o tym wiesz.",shape=box,color=blue];
		j2631269980 -> j3206754995;
	j914820900 [label="Moje pytanie dotyczy natury \"Urzeczywistnienia Idei\". Po jej przeczytaniu dotarło do mnie, że celem książki jest nauczenie dzieci, jak zapobiegać interakcji ich emocji z Pustką.",shape=box,color=blue];
		j914820900 -> j2477280487;
		j914820900 -> j687492250;
	j3206754995 [label="\"Opowieści z Duviri\". Pomimo otrzymania dosyć... wyczerpującego i cierpliwego wytłumaczenia ze strony p. Loida dotyczące tego, przez co przeszedłeś, jest taka jedna szczególna kwestia, o którą chciałbym dopytać.",shape=box,color=blue];
		j3206754995 -> j442183268;
	j2477280487 [label="Choć niewiele dobrego z tego wynikło. Zwłaszcza w moim przypadku.",shape=box,color=red];
		j2477280487 -> j2932588183;
	j687492250 [label="Silne emocje wchodzące w interakcję z Pustką mogą spowodować... poważne problemy.",shape=box,color=red];
		j687492250 -> j2751880573;
	j442183268 [label="Oczywiście tylko wtedy, jeśli nie sprawi ci to kłopotu?",shape=box,color=blue];
		j442183268 -> j1796978449;
		j442183268 -> j2487374434;
	j2932588183 [label="Jaka część naszego życia jest nam narzucana przez innych, by później okazać się zupełnie bezużyteczną w konfrontacji z rzeczywistością?",shape=box,color=blue];
		j2932588183 -> j2467441102;
	j2751880573 [label="Na to wygląda. Poznałem Cavię. Opowiadano mi o Aniołach Pustki. Widziałem Szept na własne oczy. ",shape=box,color=blue];
		j2751880573 -> j2883017920;
	j1796978449 [label="Nie. Pytaj śmiało.",shape=box,color=red];
		j1796978449 -> j2066941437;
	j2487374434 [label="Sądzę, że to zależy. Zupełnie nie mam pojęcia, o co zamierzasz mnie zapytać.",shape=box,color=red];
		j2487374434 -> j2970841808;
	j2467441102 [label="Boolean LyonFaith1 is now true.",color=orange];
		j2467441102 -> j1331873916;
	j2883017920 [label="I stąd wywodzi się moja ciekawość. Zacząłem się nad tym zastanawiać \"na głos\", żeby sprawdzić, czy mógłbyś mi to wytłumaczyć. Czy gdy Pustka nabiera formy, to co z niej dochodzi – jest \"prawdziwe\"?",shape=box,color=blue];
		j2883017920 -> j597431490;
		j2883017920 -> j2916869316;
		j2883017920 -> j3955069014;
	j2970841808 [label="+5 Chemistry",color=orange];
		j2970841808 -> j1717708532;
	j1331873916 [label="Często głowię się nad tym, po co zatruwać cudze umysły tak bezsensownymi kłamstwami? Szukając władzy? Wpływów? A może niektórzy szczerze wierzą we własne słowa i nie zdają sobie sprawy, że łżą?",shape=box,color=blue];
		j1331873916 -> j599659661;
		j1331873916 -> j2254749013;
	j597431490 [label="Nie. Uważam, że wszystko stworzone przez Pustkę jest po prostu... tymczasowe. Cząstką kogoś lub czego, co je stworzyło. Widmem wspomnienia.",shape=box,color=red];
		j597431490 -> j2137825328;
	j2916869316 [label="Tak sądzę. Niczym obraz namalowany przez artystę, który być i może powstał w czyjejś głowie, ale staje się prawdziwy, dopiero gdy zostanie namalowany.",shape=box,color=red];
		j2916869316 -> j1816249474;
	j3955069014 [label="Zależy to całkowicie od definicji \"prawdziwości\".",shape=box,color=red];
		j3955069014 -> j3517462581;
	j1717708532 [label="Oczywiście, wybacz mi. Nie jestem zbyt biegły w... prowadzeniu tak bezpośrednich konwersacji. A zwłaszcza w tak dziwaczny sposób. Ale postaram się to nadrobić.",shape=box,color=blue];
		j1717708532 -> j2066941437;
	j599659661 [label="Uważam w tym przypadku, że Euleria Entrati była przekonana o przydatności swoich tekstów. Po prostu niezbyt mi to pomogło, gdy potrzebowałem pomocy.",shape=box,color=red];
		j599659661 -> j2235315264;
	j2254749013 [label="Nie mam pojęcia. Leonie, a jakimi kłamstwami pojono twój umysł?",shape=box,color=red];
		j2254749013 -> j4270756894;
	j2137825328 [label="Czy zatem skutki spowodowane przez takie cząstki Pustki nie są \"prawdziwe\"?",shape=box,color=blue];
		j2137825328 -> j1993293087;
	j1816249474 [label="Ale użyta przez ciebie analogia nie do końca jest trafna, prawda? Materia odzyskana z Pustki powraca do Pustki, czyż nie?",shape=box,color=blue];
		j1816249474 -> j349572573;
	j3517462581 [label="+5 Chemistry",color=orange];
		j3517462581 -> j1160507822;
	j2235315264 [label="Na jej obronę dodam, że moja ekspozycja na Pustkę trwała znacznie dłużej, niż by na to wskazywał jej poradnik.",shape=box,color=red];
		j2235315264 -> j1952999054;
	j4270756894 [label="Żadnymi, o których chciałbym rozmawiać.",shape=box,color=blue];
		j4270756894 -> "Chat ends.";
	j1993293087 [label="Wiele wspomnień pchnęło ludzi do sięgnięcia po butelkę albo zainspirowało ich do targnięcia się na własne życie. Czyż takie wspomnienia nie są \"prawdziwe\"?",shape=box,color=blue];
		j1993293087 -> j1482694449;
	j349572573 [label="No dobrze, to jest myśl. Wiersz lub piosenka istnieją, nawet jeśli nie są zapisane.",shape=box,color=red];
		j349572573 -> j4002355173;
	j1160507822 [label="Możesz rozwinąć tę myśl?",shape=box,color=blue];
		j1160507822 -> j2042316215;
	j1952999054 [label="+5 Chemistry",color=orange];
		j1952999054 -> j1433846714;
	j1482694449 [label="Ale chodzi mi o to, że to były siły wewnętrzne, którym człowiek pozwolił na siebie oddziaływać. A nie zewnętrzne.",shape=box,color=red];
		j1482694449 -> j276407549;
	j4002355173 [label="Ale jeśli zostaną zapomniane, przestają istnieć. Historia zagubiona w czasie znika na zawsze.",shape=box,color=blue];
		j4002355173 -> j3835818847;
	j2042316215 [label="Jak mierzy się \"prawdziwość\"?",shape=box,color=red];
		j2042316215 -> j3435484385;
		j2042316215 -> j3915179209;
		j2042316215 -> j3593295345;
	j1433846714 [label="Nieszczęsna ignorancja jest najlepszym sposobem na wywołanie złości u innych.",shape=box,color=blue];
		j1433846714 -> j2737763657;
	j276407549 [label="Ale co to za różnica, pytam? Jeśli skutek jest taki sam, czy ma to jakiekolwiek znacznie?",shape=box,color=blue];
		j276407549 -> j3320947813;
		j276407549 -> j2568890567;
		j276407549 -> j3676820748;
	j3835818847 [label="Rewolucja wypływająca z umysłów tych, którzy władają, stanowi zaledwie stępiony miecz.",shape=box,color=blue];
		j3835818847 -> j3320947813;
		j3835818847 -> j2568890567;
		j3835818847 -> j3676820748;
	j3435484385 [label="Za pomocą fizycznej niezmienności? Ciężaru i masy? To, co wydobyło się z Pustki, jest tu tylko tymczasowo.",shape=box,color=red];
		j3435484385 -> j1019873810;
	j3915179209 [label="Poprzez jej wpływ na wydarzenia? To, co wydobyło się z Pustki, zmieniło bieg historii.",shape=box,color=red];
		j3915179209 -> j1829711504;
	j3593295345 [label="Za pomocą jej wpływu na innych? Wpływ \"rzeczy\" dochodzących z Pustki z pewnością tego dokonał.",shape=box,color=red];
		j3593295345 -> j3660781224;
	j2737763657 [label="Jednak moja ciekawość nie jest związana z książką ani z jej użytecznością. Wybacz mi to poetyckie porównanie.",shape=box,color=blue];
		j2737763657 -> j563520755;
	j3320947813 [label="Nie pytasz, czy są \"prawdziwe\", ale czy są \"ważne\". Czy należy je odrzucić czy nie.",shape=box,color=red];
		j3320947813 -> j4100641329;
	j2568890567 [label="Chciałbym również zapytać, czy ci twoi Świetliści są \"prawdziwi\", bo przecież nie możesz uścisnąć dłoni Sol lub Lua.",shape=box,color=red];
		j2568890567 -> j3434282067;
	j3676820748 [label="Pytasz okrężną drogą, czy wszystkie \"rzeczy\" z Pustki istnieją tylko dlatego, że tego chcieliśmy.",shape=box,color=red];
		j3676820748 -> j3157867057;
	j1019873810 [label="To, co z Pustki pochodzi, musi do niej powrócić, o tym mówisz? Ale czy Pustka z samej swej definicji, nie składa się z niczego?",shape=box,color=blue];
		j1019873810 -> j3049807935;
	j1829711504 [label="Trafna uwaga. Czy rewolucja nie jest \"prawdziwa\" tylko dlatego, że nie da się jej włożyć do koszyka i zważyć?",shape=box,color=blue];
		j1829711504 -> j3660781224;
	j3660781224 [label="Z pewnością wiele dusz musiało zostać pozbawionych głowy. Niektórzy argumentowaliby ze słusznością tego działania. Zastanów się jednak nad tym:",shape=box,color=blue];
		j3660781224 -> j2343915445;
	j563520755 [label="Zacząłem się nad tym zastanawiać \"na głos\", żeby sprawdzić, czy mógłbyś mi to wytłumaczyć. Czy gdy Pustka nabiera formy, to co z niej dochodzi – jest \"prawdziwe\"?",shape=box,color=blue];
		j563520755 -> j597431490;
		j563520755 -> j3955069014;
		j563520755 -> j2916869316;
	j4100641329 [label="+5 Chemistry",color=orange];
		j4100641329 -> j3867671965;
	j3434282067 [label="Nie rozmawiamy o Świetlistych. Dyskutujemy o Pustce.",shape=box,color=blue];
		j3434282067 -> j1240582416;
		j3434282067 -> j2681584937;
		j3434282067 -> j649158870;
		j3434282067 -> j2100807578;
	j3157867057 [label="+5 Chemistry",color=orange];
		j3157867057 -> j2955744694;
	j3049807935 [label="Chyba tak. Części Pustki, z którymi miałem styczność, już pozostawiły swój ślad. Nadaliśmy im jakiś kształt lub formę. Albo za bardzo rozmyliśmy granicę obu rzeczywistości.",shape=box,color=red];
		j3049807935 -> j520789306;
		j3049807935 -> j2228712353;
	j2343915445 [label="Rewolucja jest zasadna tylko wtedy, gdy istnieje w umysłach tych, którzy ją przeprowadzają.",shape=box,color=blue];
		j2343915445 -> j881518009;
	j3867671965 [label="Tak, myślę, że można to tak ująć. Czy powinniśmy zignorować zjawy nawiedzające nasze korytarze, czy też, zwracając na nie uwagę, tylko je wzmacniamy?",shape=box,color=blue];
		j3867671965 -> j1240582416;
		j3867671965 -> j2681584937;
		j3867671965 -> j649158870;
		j3867671965 -> j2100807578;
	j1240582416 [label="Wierzę, że wyzwania, przed którymi teraz stoimy, są niebezpieczne. Skrajnie niebezpieczne. I właśnie tak powinniśmy je traktować.",shape=box,color=red];
		j1240582416 -> j3205082214;
	j2681584937 [label="Duchy są na tyle prawdziwe, by sprawić nam ból. Ale nie da się ich wyleczyć ołowiem. Przynajmniej nie takim, jaki znam.",shape=box,color=red];
		j2681584937 -> j2939203833;
	j649158870 [label="O co w tym wszystkim chodzi, Leonie? Szczerze?",shape=box,color=red];
		j649158870 -> j2000101147;
	j2100807578 [label="Szczerze mówiąc... to nie mam pojęcia, Leonie. A chciałbym to wiedzieć.",shape=box,color=red];
		j2100807578 -> j2683799603;
	j2955744694 [label="Tak, myślę, że można to tak ująć. Skąd możemy mieć pewność, że nie... ujawniliśmy naszych własnych demonów?",shape=box,color=blue];
		j2955744694 -> j1240582416;
		j2955744694 -> j2681584937;
		j2955744694 -> j649158870;
		j2955744694 -> j2100807578;
	j520789306 [label="Całe struktury, a nawet sama Lua, zostały umieszczone w Pustce i stamtąd odzyskane. Nie pochłaniają więc materii przez samo istnienie w niej.",shape=box,color=red];
		j520789306 -> j383453924;
	j2228712353 [label="Sugerujesz istnienie \"głębszej\" Pustki, w której nic nie ma prawa istnieć, a ja nie jestem w stanie się do tego odnieść.",shape=box,color=red];
		j2228712353 -> j3395443688;
	j881518009 [label="Gdyby wymazać ją z umysłów wszystkich wokół, przestałaby istnieć, czyż nie?",shape=box,color=blue];
		j881518009 -> j2568890567;
		j881518009 -> j3320947813;
		j881518009 -> j3676820748;
	j3205082214 [label="Boolean LyonReal1 is now true.",color=orange];
		j3205082214 -> j3147234107;
	j2939203833 [label="Boolean LyonFake1 is now true.",color=orange];
		j2939203833 -> j211210711;
	j2000101147 [label="Boolean LyonFaith1 is now true.",color=orange];
		j2000101147 -> j1455392818;
	j2683799603 [label="Twoja szczerość w przyznawaniu się, że czegoś nie wiesz, jest niecodzienna. Gdyby tylko więcej ludzi miało taki dar.",shape=box,color=blue];
		j2683799603 -> j3326971157;
	j383453924 [label="Nie interesuje mnie materia umieszczona w Pustce i później z niej odzyskana. Interesuje mnie to, co powstało z Pustki od podstaw.",shape=box,color=blue];
		j383453924 -> j3320947813;
		j383453924 -> j2568890567;
		j383453924 -> j3676820748;
	j3395443688 [label="Doceniam Twoją szczerość. Chyba mało interesuje mnie to, co nie może istnieć, a bardziej to, co może.",shape=box,color=blue];
		j3395443688 -> j3320947813;
		j3395443688 -> j2568890567;
		j3395443688 -> j3676820748;
	j3147234107 [label="Tak, sądzę, że wiesz, co można zniszczyć z Pustki siłą, a czego nie...",shape=box,color=blue];
		j3147234107 -> j2542487438;
	j211210711 [label="Być może właśnie dlatego tak wielu ucieka się do przesady... aby zatamować krwawiącą ranę, niewidoczną, lecz jakże bolesną. Uleczalną. Tyle że siłą ducha, a nie bronią.",shape=box,color=blue];
		j211210711 -> j2542487438;
	j1455392818 [label="Najwyraźniej źle do tego podszedłem. Porozmawiajmy o tym innym razem. Wybacz mi moją wścibskość.",shape=box,color=blue];
		j1455392818 -> j3651491667;
	j3326971157 [label="Niemniej jednak nadal nie mam sprecyzowanych poglądów na ten temat.",shape=box,color=blue];
		j3326971157 -> j1455392818;
	j2542487438 [label="Choć jak zawsze, mam pewne wątpliwości. Wybacz moje wtrącenie. Dziękuję za twój czas, Włóczęgo.",shape=box,color=blue];
		j2542487438 -> j3651491667;
	j3651491667 [label="O. Leon Allard",shape=box,color=blue];
		j3651491667 -> "Chat ends.";
}