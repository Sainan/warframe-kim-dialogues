digraph {
	114 [label="LyonRank3Convo3 begins.",color=orange];
		114 -> 115;
	115 [label="Pomagałem p. Loidowi w jego bibliotece, odkładając książki na półki, choć upierał się, że mogłyby to robić te cudaczne... ustrojstwa.",shape=box,color=blue];
		115 -> 116;
	116 [label="I tak oto natrafiłem na ciekawe tomiszcze pióra Eulerii Entrati, zawierające bajki dla dzieci, których akcja rozgrywała się w fikcyjnym świecie.",shape=box,color=blue];
		116 -> 117;
	117 [label="Gdy tylko spostrzegłem, że autorka nosi to samo nazwisko, co nasz \"kardynał Dimanche\", natychmiast odłożyłem sobie ten egzemplarz.",shape=box,color=blue];
		117 -> 120;
		117 -> 119;
		117 -> 118;
	120 [label="Chyba wiem, o której książce mówisz...",shape=box,color=red];
		120 -> 123;
	119 [label="Czy możemy pominąć ten wstęp? Zapytaj mnie o to, czego chcesz się dowiedzieć.",shape=box,color=red];
		119 -> 122;
	118 [label="[Zignoruj]",shape=box,color=red];
		118 -> 121;
	123 [label="+5 Chemistry",color=orange];
		123 -> 125;
	122 [label="Update boolean LyonMITW1",color=orange];
		122 -> 124;
	121 [label="Chat ends.",color=orange];
	125 [label="Sądząc po przerażonym spojrzeniu, jakim obdarzył mnie p. Loid, i jego naleganiu, abym natychmiast odłożył tę książkę, by \"cię nie denerwować\" – domyśliłem się, że coś o tym wiesz.",shape=box,color=blue];
		125 -> 128;
	124 [label="Moje pytanie dotyczy natury \"Urzeczywistnienia Idei\". Po jej przeczytaniu dotarło do mnie, że celem książki jest nauczenie dzieci, jak zapobiegać interakcji ich emocji z Pustką.",shape=box,color=blue];
		124 -> 126;
		124 -> 127;
	128 [label="\"Opowieści z Duviri\". Pomimo otrzymania dosyć... wyczerpującego i cierpliwego wytłumaczenia ze strony p. Loida dotyczące tego, przez co przeszedłeś, jest taka jedna szczególna kwestia, o którą chciałbym dopytać.",shape=box,color=blue];
		128 -> 131;
	126 [label="Choć niewiele dobrego z tego wynikło. Zwłaszcza w moim przypadku.",shape=box,color=red];
		126 -> 129;
	127 [label="Silne emocje wchodzące w interakcję z Pustką mogą spowodować... poważne problemy.",shape=box,color=red];
		127 -> 130;
	131 [label="Oczywiście tylko wtedy, jeśli nie sprawi ci to kłopotu?",shape=box,color=blue];
		131 -> 134;
		131 -> 135;
	129 [label="Jaka część naszego życia jest nam narzucana przez innych, by później okazać się zupełnie bezużyteczną w konfrontacji z rzeczywistością?",shape=box,color=blue];
		129 -> 132;
	130 [label="Na to wygląda. Poznałem Cavię. Opowiadano mi o Aniołach Pustki. Widziałem Szept na własne oczy. ",shape=box,color=blue];
		130 -> 133;
	134 [label="Nie. Pytaj śmiało.",shape=box,color=red];
		134 -> 122;
	135 [label="Sądzę, że to zależy. Zupełnie nie mam pojęcia, o co zamierzasz mnie zapytać.",shape=box,color=red];
		135 -> 140;
	132 [label="Update boolean LyonFaith1",color=orange];
		132 -> 136;
	133 [label="I stąd wywodzi się moja ciekawość. Zacząłem się nad tym zastanawiać \"na głos\", żeby sprawdzić, czy mógłbyś mi to wytłumaczyć. Czy gdy Pustka nabiera formy, to co z niej dochodzi – jest \"prawdziwe\"?",shape=box,color=blue];
		133 -> 137;
		133 -> 138;
		133 -> 139;
	140 [label="+5 Chemistry",color=orange];
		140 -> 146;
	136 [label="Często głowię się nad tym, po co zatruwać cudze umysły tak bezsensownymi kłamstwami? Szukając władzy? Wpływów? A może niektórzy szczerze wierzą we własne słowa i nie zdają sobie sprawy, że łżą?",shape=box,color=blue];
		136 -> 142;
		136 -> 141;
	137 [label="Nie. Uważam, że wszystko stworzone przez Pustkę jest po prostu... tymczasowe. Cząstką kogoś lub czego, co je stworzyło. Widmem wspomnienia.",shape=box,color=red];
		137 -> 143;
	138 [label="Tak sądzę. Niczym obraz namalowany przez artystę, który być i może powstał w czyjejś głowie, ale staje się prawdziwy, dopiero gdy zostanie namalowany.",shape=box,color=red];
		138 -> 144;
	139 [label="Zależy to całkowicie od definicji \"prawdziwości\".",shape=box,color=red];
		139 -> 145;
	146 [label="Oczywiście, wybacz mi. Nie jestem zbyt biegły w... prowadzeniu tak bezpośrednich konwersacji. A zwłaszcza w tak dziwaczny sposób. Ale postaram się to nadrobić.",shape=box,color=blue];
		146 -> 122;
	142 [label="Uważam w tym przypadku, że Euleria Entrati była przekonana o przydatności swoich tekstów. Po prostu niezbyt mi to pomogło, gdy potrzebowałem pomocy.",shape=box,color=red];
		142 -> 148;
	141 [label="Nie mam pojęcia. Leonie, a jakimi kłamstwami pojono twój umysł?",shape=box,color=red];
		141 -> 147;
	143 [label="Czy zatem skutki spowodowane przez takie cząstki Pustki nie są \"prawdziwe\"?",shape=box,color=blue];
		143 -> 149;
	144 [label="Ale użyta przez ciebie analogia nie do końca jest trafna, prawda? Materia odzyskana z Pustki powraca do Pustki, czyż nie?",shape=box,color=blue];
		144 -> 150;
	145 [label="+5 Chemistry",color=orange];
		145 -> 151;
	148 [label="Na jej obronę dodam, że moja ekspozycja na Pustkę trwała znacznie dłużej, niż by na to wskazywał jej poradnik.",shape=box,color=red];
		148 -> 153;
	147 [label="Żadnymi, o których chciałbym rozmawiać.",shape=box,color=blue];
		147 -> 152;
	149 [label="Wiele wspomnień pchnęło ludzi do sięgnięcia po butelkę albo zainspirowało ich do targnięcia się na własne życie. Czyż takie wspomnienia nie są \"prawdziwe\"?",shape=box,color=blue];
		149 -> 154;
	150 [label="No dobrze, to jest myśl. Wiersz lub piosenka istnieją, nawet jeśli nie są zapisane.",shape=box,color=red];
		150 -> 155;
	151 [label="Możesz rozwinąć tę myśl?",shape=box,color=blue];
		151 -> 156;
	153 [label="+5 Chemistry",color=orange];
		153 -> 157;
	152 [label="Chat ends.",color=orange];
	154 [label="Ale chodzi mi o to, że to były siły wewnętrzne, którym człowiek pozwolił na siebie oddziaływać. A nie zewnętrzne.",shape=box,color=red];
		154 -> 158;
	155 [label="Ale jeśli zostaną zapomniane, przestają istnieć. Historia zagubiona w czasie znika na zawsze.",shape=box,color=blue];
		155 -> 159;
	156 [label="Jak mierzy się \"prawdziwość\"?",shape=box,color=red];
		156 -> 160;
		156 -> 161;
		156 -> 162;
	157 [label="Nieszczęsna ignorancja jest najlepszym sposobem na wywołanie złości u innych.",shape=box,color=blue];
		157 -> 163;
	158 [label="Ale co to za różnica, pytam? Jeśli skutek jest taki sam, czy ma to jakiekolwiek znacznie?",shape=box,color=blue];
		158 -> 164;
		158 -> 165;
		158 -> 166;
	159 [label="Rewolucja wypływająca z umysłów tych, którzy władają, stanowi zaledwie stępiony miecz.",shape=box,color=blue];
		159 -> 164;
		159 -> 165;
		159 -> 166;
	160 [label="Za pomocą fizycznej niezmienności? Ciężaru i masy? To, co wydobyło się z Pustki, jest tu tylko tymczasowo.",shape=box,color=red];
		160 -> 167;
	161 [label="Poprzez jej wpływ na wydarzenia? To, co wydobyło się z Pustki, zmieniło bieg historii.",shape=box,color=red];
		161 -> 168;
	162 [label="Za pomocą jej wpływu na innych? Wpływ \"rzeczy\" dochodzących z Pustki z pewnością tego dokonał.",shape=box,color=red];
		162 -> 169;
	163 [label="Jednak moja ciekawość nie jest związana z książką ani z jej użytecznością. Wybacz mi to poetyckie porównanie.",shape=box,color=blue];
		163 -> 170;
	164 [label="Nie pytasz, czy są \"prawdziwe\", ale czy są \"ważne\". Czy należy je odrzucić czy nie.",shape=box,color=red];
		164 -> 171;
	165 [label="Chciałbym również zapytać, czy ci twoi Świetliści są \"prawdziwi\", bo przecież nie możesz uścisnąć dłoni Sol lub Lui.",shape=box,color=red];
		165 -> 172;
	166 [label="Pytasz okrężną drogą, czy wszystkie \"rzeczy\" z Pustki istnieją tylko dlatego, że tego chcieliśmy.",shape=box,color=red];
		166 -> 173;
	167 [label="To, co z Pustki pochodzi, musi do niej powrócić, o tym mówisz? Ale czy Pustka z samej swej definicji, nie składa się z niczego?",shape=box,color=blue];
		167 -> 174;
	168 [label="Trafna uwaga. Czy rewolucja nie jest \"prawdziwa\" tylko dlatego, że nie da się jej włożyć do koszyka i zważyć?",shape=box,color=blue];
		168 -> 169;
	169 [label="Z pewnością wiele dusz musiało zostać pozbawionych głowy. Niektórzy argumentowaliby ze słusznością tego działania. Zastanów się jednak nad tym:",shape=box,color=blue];
		169 -> 175;
	170 [label="Zacząłem się nad tym zastanawiać \"na głos\", żeby sprawdzić, czy mógłbyś mi to wytłumaczyć. Czy gdy Pustka nabiera formy, to co z niej dochodzi – jest \"prawdziwe\"?",shape=box,color=blue];
		170 -> 137;
		170 -> 139;
		170 -> 138;
	171 [label="+5 Chemistry",color=orange];
		171 -> 176;
	172 [label="Nie rozmawiamy o Świetlistych. Dyskutujemy o Pustce.",shape=box,color=blue];
		172 -> 177;
		172 -> 178;
		172 -> 179;
		172 -> 180;
	173 [label="+5 Chemistry",color=orange];
		173 -> 181;
	174 [label="Chyba tak. Części Pustki, z którymi miałem styczność, już pozostawiły swój ślad. Nadaliśmy im jakiś kształt lub formę. Albo za bardzo rozmyliśmy granicę obu rzeczywistości.",shape=box,color=red];
		174 -> 182;
		174 -> 183;
	175 [label="Rewolucja jest zasadna tylko wtedy, gdy istnieje w umysłach tych, którzy ją przeprowadzają.",shape=box,color=blue];
		175 -> 184;
	176 [label="Tak, myślę, że można to tak ująć. Czy powinniśmy zignorować zjawy nawiedzające nasze korytarze, czy też, zwracając na nie uwagę, tylko je wzmacniamy?",shape=box,color=blue];
		176 -> 177;
		176 -> 178;
		176 -> 179;
		176 -> 180;
	177 [label="Wierzę, że wyzwania, przed którymi teraz stoimy, są niebezpieczne. Skrajnie niebezpieczne. I właśnie tak powinniśmy je traktować.",shape=box,color=red];
		177 -> 185;
	178 [label="Duchy są na tyle prawdziwe, by sprawić nam ból. Ale nie da się ich wyleczyć ołowiem. Przynajmniej nie takim, jaki znam.",shape=box,color=red];
		178 -> 186;
	179 [label="O co w tym wszystkim chodzi, Leonie? Szczerze?",shape=box,color=red];
		179 -> 187;
	180 [label="Szczerze mówiąc... to nie mam pojęcia, Leonie. A chciałbym to wiedzieć.",shape=box,color=red];
		180 -> 188;
	181 [label="Tak, myślę, że można to tak ująć. Skąd możemy mieć pewność, że nie... ujawniliśmy naszych własnych demonów?",shape=box,color=blue];
		181 -> 177;
		181 -> 178;
		181 -> 179;
		181 -> 180;
	182 [label="Całe struktury, a nawet sama Lua, zostały umieszczone w Pustce i stamtąd odzyskane. Nie pochłaniają więc materii przez samo istnienie w niej.",shape=box,color=red];
		182 -> 189;
	183 [label="Sugerujesz istnienie \"głębszej\" Pustki, w której nic nie ma prawa istnieć, a ja nie jestem w stanie się do tego odnieść.",shape=box,color=red];
		183 -> 190;
	184 [label="Gdyby wymazać ją z umysłów wszystkich wokół, przestałaby istnieć, czyż nie?",shape=box,color=blue];
		184 -> 165;
		184 -> 164;
		184 -> 166;
	185 [label="Update boolean LyonReal1",color=orange];
		185 -> 191;
	186 [label="Update boolean LyonFake1",color=orange];
		186 -> 192;
	187 [label="Update boolean LyonFaith1",color=orange];
		187 -> 193;
	188 [label="Twoja szczerość w przyznawaniu się, że czegoś nie wiesz, jest niecodzienna. Gdyby tylko więcej ludzi miało taki dar.",shape=box,color=blue];
		188 -> 194;
	189 [label="Nie interesuje mnie materia umieszczona w Pustce i później z niej odzyskana. Interesuje mnie to, co powstało z Pustki od podstaw.",shape=box,color=blue];
		189 -> 164;
		189 -> 165;
		189 -> 166;
	190 [label="Doceniam Twoją szczerość. Chyba mało interesuje mnie to, co nie może istnieć, a bardziej to, co może.",shape=box,color=blue];
		190 -> 164;
		190 -> 165;
		190 -> 166;
	191 [label="Tak, sądzę, że wiesz, co można zniszczyć z Pustki siłą, a czego nie...",shape=box,color=blue];
		191 -> 195;
	192 [label="Być może właśnie dlatego tak wielu ucieka się do przesady... aby zatamować krwawiącą ranę, niewidoczną, lecz jakże bolesną. Uleczalną. Tyle że siłą ducha, a nie bronią.",shape=box,color=blue];
		192 -> 195;
	193 [label="Najwyraźniej źle do tego podszedłem. Porozmawiajmy o tym innym razem. Wybacz mi moją wścibskość.",shape=box,color=blue];
		193 -> 196;
	194 [label="Niemniej jednak nadal nie mam sprecyzowanych poglądów na ten temat.",shape=box,color=blue];
		194 -> 193;
	195 [label="Choć jak zawsze, mam pewne wątpliwości. Wybacz moje wtrącenie. Dziękuję za twój czas, Włóczęgo.",shape=box,color=blue];
		195 -> 196;
	196 [label="O. Leon Allard",shape=box,color=blue];
		196 -> 197;
	197 [label="Chat ends.",color=orange];
}