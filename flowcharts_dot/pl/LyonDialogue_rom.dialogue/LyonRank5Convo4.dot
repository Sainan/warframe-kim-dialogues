	j2277194036 [label="Jest mi... po prostu bardzo przykro z powodu tego, przez co musieliście oboje przejść.",shape=box,color=red];
		j2277194036 -> j1869187307;
	j3033246472 [label="Jestem... taki wdzięczny, że Rell i Harrow mogli tam z tobą być, Leonie... nawet jeśli to były tylko wspomnienia.",shape=box,color=red];
		j3033246472 -> j1215427170;
	j113550612 [label="Czy mógłbyś rozważyć taką możliwość, że... może to wszystko jest dziełem boga albo bogów? Żeby cię pocieszyć?",shape=box,color=red];
		j113550612 -> j3321429461;
	j214178668 [label="Czy mógłbyś rozważyć taką możliwość, że... może to wszystko jest dziełem Lui? Żeby cię pocieszyć?",shape=box,color=red];
		j214178668 -> j3321429461;
	j904747382 [label="Nie wiem, czy te dwa wspomnienia muszą się wzajemnie wykluczać, ale... nie wiem. Nie wiem, czy kiedyś się tego dowiemy.",shape=box,color=red];
		j904747382 -> j1124173406;
	j1518157798 [label="Jestem... taki wdzięczny, że Rell i Harrow mogli tam z tobą być, Leonie... nawet jeśli to były tylko wspomnienia.",shape=box,color=red];
		j1518157798 -> j1869187307;
	j1869187307 [label="Dziękuję. Tęsknię za ich obecnością. Ale... dowiaduję się, że w tym miejscu jest więcej osób, które mogą zrozumieć mój ból.",shape=box,color=blue];
		j1869187307 -> j2104644656;
	j1215427170 [label="Dziękuję. Tęsknię za ich obecnością. Ale... już nie jestem sam, czyż nie, mon miracle?",shape=box,color=blue];
		j1215427170 -> j2104644656;
	j3321429461 [label="Rzeczywiście. Nie myśl, że nie zastanawiałem się nad tym, czy moją wiarę można tak łatwo podważyć, ale... mimo wszystko to pocieszająca przemyślenie.",shape=box,color=blue];
		j3321429461 -> j2104644656;
	j1124173406 [label="Rzeczywiście. Nie myśl, że nie zastanawiałem się nad tym, czy Rell i Harrow nie zostali przysłani przez Świetlistych, by mnie pocieszyć. Ale jak sam powiedziałeś, nie przyjdzie nam tego się dowiedzieć.",shape=box,color=blue];
		j1124173406 -> j2104644656;
