	j3967401189 [label="Słyszałem, że to jest niesamowicie bolesne.",shape=box,color=red];
		j3967401189 -> j3410336507;
	j178150616 [label="Nawet nie jestem w stanie sobie tego wyobrazić. ",shape=box,color=red];
		j178150616 -> j220467989;
	j1345073119 [label="[Ostrzeżenie: Krótkie wzmianki na temat samookaleczania i znęcania się nad dzieckiem. Kliknij tutaj, aby zakończyć. Nie spowoduje to utraty Chemii z Leonem]",shape=box,color=red];
		j1345073119 -> j1843578849;
	j322178720 [label="[Koniec]",shape=box,color=red];
		j322178720 -> j3856020424;
	j4075781927 [label="Boolean LyonWillDate is now true.",color=orange];
		j4075781927 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j3410336507 [label="Chyba tak. Choć wierzę, że mam w tym wieloletnie doświadczenie i dlatego ostrzeżenia Entratiego sprawiały wrażenie czegoś bardziej niezwykłego, niż było w rzeczywistości.",shape=box,color=blue];
		j3410336507 -> j220467989;
	j220467989 [label="Wraz z Marią postanowiliśmy wziąć nasze serum na osobności. Poprosiłem ją, żeby pozwoliła mi doświadczyć tej przemiany przed nią, abym później mógł jej pomóc. Ale jak to ona, stanowczo odmówiła.",shape=box,color=blue];
		j220467989 -> j1885572358;
	j1843578849 [label="+20 Chemistry",color=orange];
		j1843578849 -> j2698387260;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	"Chat ends. Next chat will be Lyon5FaithDay2." [color=orange];
	j1885572358 [label="Drwiąc z samego tylko pomysłu, że mógłbym dokądś pójść lub zrobić coś bez jej obecności u mojego boku, udała się do swojej komnaty.",shape=box,color=blue];
		j1885572358 -> j3403196612;
	j2698387260 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j2698387260 -> j2559080857;
	j3403196612 [label="Zamknąłem drzwi, rozebrałem się i usiadłem na środku podłogi, z dala od wszelkich przedmiotów. Następnie wbiłem sobie igłę w bok.",shape=box,color=blue];
		j3403196612 -> j251374211;
	j2559080857 [label="Boolean LyonRell3 is now true.",color=orange];
		j2559080857 -> j4008758555;
	j251374211 [label="Widziałem, co Plaga zrobiła z Roathem, wykręcając jego ciało tym, co akurat miał na sobie w tamtej chwili. Nie miałem ochoty podzielić jego losu.",shape=box,color=blue];
		j251374211 -> j3835475067;
	j4008758555 [label="Boolean LyonFaith3Unknown is now true.",color=orange];
		j4008758555 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j3835475067 [label="Kiedy agonia minęła, mój i tak już nadwątlony wzrok stał się... zamazany. Był jakby... podwojony? Jakbym widział nie raz, ale dwa razy.",shape=box,color=blue];
		j3835475067 -> j1139089512;
	j1139089512 [label="Jestem dumny ze swojej odporności, ale ledwo co udało mi się założyć spodnie, zanim zwymiotowałem i straciłem przytomność.",shape=box,color=blue];
		j1139089512 -> j2700204666;
	j2700204666 [label="Kiedy się obudziłem, nie byłem sam. Nie leżałem też na podłodze mojej komnaty. Siedziałem w mojej sypialni z dzieciństwa na skrzypiącej, starej podłodze, którą tak dobrze znałem.",shape=box,color=blue];
		j2700204666 -> j1046878640;
	j1046878640 [label="A obok mnie siedział młody mężczyzna. U jego boku stała postać, którą mogę teraz nazwać Harrowem. Młodzieniec trzymał w dłoniach niewielką drewnianą figurkę. Jej kończyny były ruchome – farba już dawno się starła, z wyjątkiem zagięć i pęknięć. Należała do mojego ojca. Przedstawiała żołnierza.",shape=box,color=blue];
		j1046878640 -> j3043223808;
	j3043223808 [label="Była to jedyna zabawka, którą jako dziecko mogłem uznać za swoją.",shape=box,color=blue];
		j3043223808 -> j2911482170;
		j3043223808 -> j26814639;
	j2911482170 [label="Miałem podobną figurkę w okresie dorastania. Była jedną z moich ulubionych zabawek.",shape=box,color=red];
		j2911482170 -> j2765623493;
	j26814639 [label="Rell?",shape=box,color=red];
		j26814639 -> j3786560793;
	j2765623493 [label="Tak słyszałem. Sądzę, że mój przypadek okazał się łagodniejszy.",shape=box,color=blue];
		j2765623493 -> j2785301790;
		j2765623493 -> j2080588180;
		j2765623493 -> j3859463472;
	j3786560793 [label="Owszem.",shape=box,color=blue];
		j3786560793 -> j4038502707;
	j2785301790 [label="Thrax to złożony temat. Wolałbym go teraz nie poruszać.",shape=box,color=red];
		j2785301790 -> j3223625850;
	j2080588180 [label="Serio, to nie była jego wina. Był dokładnie tym, kogo potrzebowałem w tamtej chwili.",shape=box,color=red];
		j2080588180 -> j1664707049;
	j3859463472 [label="W porządku. Robi postępy. Powoli. Ale jakoś mu idzie. Najwidoczniej można zmienić to, co z pozoru wydawało się niemożliwe.",shape=box,color=red];
		j3859463472 -> j2276642638;
	j4038502707 [label="Ten młodzieniec i jego cichy opiekun, którzy odwiedzili mnie we śnie – w mojej głowie – byli mi jednocześnie obcy, a jednak znani, jakbyśmy razem dorastali niczym rodzeństwo.",shape=box,color=blue];
		j4038502707 -> j2309035037;
	j3223625850 [label="Zgadza się. Moglibyśmy godzinami dyskutować o moralnych i teologicznych implikacjach Duviri.",shape=box,color=blue];
		j3223625850 -> j4038502707;
	j1664707049 [label="Kiedy pomyślę sobie o choćby najmniejszej rzeczy, której podjąłbym się na twoim miejscu, ogarnia mnie przerażenie. Ale moglibyśmy tak dyskutować o tym długimi godzinami.",shape=box,color=blue];
		j1664707049 -> j4038502707;
	j2276642638 [label="Jeśli wykazuje oznaki przemiany i jest produktem twoich emocji, może to wskazywać na coś innego. Ale to temat na zupełnie inną dyskusję.",shape=box,color=blue];
		j2276642638 -> j4038502707;
	j2309035037 [label="Wybacz mi tę przesadzoną metaforę, ale to trochę tak, jakbyśmy byli trzema drzewami, których korzenie zrosły się ze sobą tak bardzo, że nie można było ich od siebie odróżnić –",shape=box,color=blue];
		j2309035037 -> j1597710693;
	j1597710693 [label="a które pojawiły się i funkcjonowały w takim stanie. Pamiętam swoje życie bez Rella i Harrowa. A jednak ciągle tam byli. Zawsze – w każdej sytuacji – obok mnie.",shape=box,color=blue];
		j1597710693 -> j387734835;
	j387734835 [label="Nawiasem mówiąc, żałuję, że nie mogłem porozmawiać o tym z Entratim. Bardzo chciałbym wiedzieć, w jakiej nauce tkwią – nomen omen – korzenie tego wszystkiego. Ale gdy się w końcu otrząsnęliśmy po tej przemianie, Entratiego już nie było.",shape=box,color=blue];
		j387734835 -> j1937133691;
	j1937133691 [label="Check boolean LoidFamilyComplete",color=orange];
		j1937133691 -> j2014541548 [label=true,color=green];
		j1937133691 -> j1776388277 [label=false,color=brown];
		j1937133691 -> j2014541548 [label=false,color=brown];
	j2014541548 [label="Z tego, co wiem o Pladze i tym, jak działa, zdaje się w pewnym sensie... może... no nie wiem, poza czasem?",shape=box,color=red];
		j2014541548 -> j1270004949;
	j1776388277 [label="Córka Entratiego jest na górze. Uczyła się i pracowała u jego boku. Może będzie w stanie pomóc.",shape=box,color=red];
		j1776388277 -> j820180054;
	j1270004949 [label="Tam jest... gitara... ciężko to wszystko wytłumaczyć, a poza tym oboje podróżowaliśmy w czasie za pośrednictwem Helmintha...",shape=box,color=red];
		j1270004949 -> j3486379914;
	j820180054 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j820180054 -> j4207627276;
	j3486379914 [label="Był to proces, który jak sądzę, będzie się śnił w moich koszmarach przez bardzo długi czas. Tak czy inaczej, nie wiem, jak to się stało, że Rell, Harrow i ja połączyliśmy się na iście... atomowym, duchowym poziomie.",shape=box,color=blue];
		j3486379914 -> j3142059477;
	j4207627276 [label="Add 1 to Family counter",color=orange];
		j4207627276 -> j2716471444;
	j3142059477 [label="Ale to rozdroże prowadziło w obie strony. Tam, gdzie oni pojawiali się w moim życiu, tam ja pojawiałem się w ich. Widziałem Obojętność. Rozumiałem, czego się obawiali. Widziałem przebłyski Harrowa i człowieka, którym kiedyś był.",shape=box,color=blue];
		j3142059477 -> j3106207721;
	j2716471444 [label="Gdyby tylko pozwolono nam z nią porozmawiać. Podejrzewam, że są już jakieś plamy, by to urzeczywistnić. Jeśli tak, to możecie liczyć na moją... pomoc. Potrafię być przekonujący, kiedy trzeba.",shape=box,color=blue];
		j2716471444 -> j147501434;
	j3106207721 [label="Ale presja Obojętności wzięła górę i ja to czułem – słyszałem ją, tak jak oni, gdy dobijała się ze ścian. Stuku... puku... puk...",shape=box,color=blue];
		j3106207721 -> j2593650205;
	j147501434 [label="Tak czy inaczej, nie wiem, jak to się stało, że Rell, Harrow i ja połączyliśmy się na iście... atomowym, duchowym poziomie.",shape=box,color=blue];
		j147501434 -> j3142059477;
	j2593650205 [label="Wszystkie wizje mojej młodości, wszystkie okropieństwa, jakie widziałem – były zaledwie Obojętnością? A może pamięć mnie zawodzi? A może rzeczywiście \"pobłogosławiła\" mnie Lua?",shape=box,color=blue];
		j2593650205 -> j878151810;
	j878151810 [label="Moja wewnętrzna wiara... załamała się i rozpadła na kawałki. Niczym zwęglony papier, obróciła się w pył. Och, jak ja nienawidzę siebie za tę słabość...",shape=box,color=blue];
		j878151810 -> j2547210604;
	j2547210604 [label="Evaluate expressions",color=orange];
		j2547210604 -> j131028398 [label="LyonDating",color=purple];
		j2547210604 -> j3659605989 [label="DrifterFaithYesSimilar",color=purple];
		j2547210604 -> j3659605989 [label="DrifterFaithYesForeign",color=purple];
		j2547210604 -> j3659605989 [label="DrifterFaithPersonal",color=purple];
		j2547210604 -> j3334123325 [label="DrifterFaithSol",color=purple];
		j2547210604 -> j3334123325 [label="DrifterFaithLua",color=purple];
		j2547210604 -> j3334123325 [label="DrifterFaithBalance",color=purple];
		j2547210604 -> j1172424804 [label="DrifterFaithAgnostic",color=purple];
		j2547210604 -> j3204976730 [label="DrifterFaithNoFear",color=purple];
		j2547210604 -> j240434503 [label="DrifterFaithNoMITW",color=purple];
		j2547210604 -> j3204976730 [label="DrifterFaithNoMaybe",color=purple];
		j2547210604 -> j583533199 [label="false",color=purple];
	j131028398 [label="Och, Leonie... tyle musiałeś przejść. Zwątpienie nie wynika ze słabości – zwątpienie wynika z bólu.",shape=box,color=red];
		j131028398 -> j2894608508;
		j131028398 -> j3323478139;
		j131028398 -> j4194579304;
		j131028398 -> j3524377502;
		j131028398 -> j1671029760;
	j3659605989 [label="Wiara nie musi być stała – i nikt tego nie oczekuje. Ileż to opowieści krąży o ludziach, którzy zatracili wiarę tylko po to, by ją później odzyskać?",shape=box,color=red];
		j3659605989 -> j2894608508;
		j3659605989 -> j3323478139;
		j3659605989 -> j4194579304;
	j3334123325 [label="Poświęciłeś swoje życie posłudze naszym Świetlistym, Leonie. Sądzisz, że odwróciliby się od ciebie za taki czyn?",shape=box,color=red];
		j3334123325 -> j2894608508;
		j3334123325 -> j3323478139;
		j3334123325 -> j4194579304;
	j1172424804 [label="Nie wiem, czy bogowie istnieją, czy nie, Leonie. I sądzę, że nikt z nas się tego tak naprawdę nie dowie. Ale dobrze wiem, przez co musiałeś przejść.",shape=box,color=red];
		j1172424804 -> j2894608508;
		j1172424804 -> j4194579304;
		j1172424804 -> j3524377502;
	j3204976730 [label="Choć sam nie wierzę, by na tym świecie istnieli bogowie, to zdaję sobie sprawę, jak to było dla ciebie ważne. Nie zamierzam temu umniejszać.",shape=box,color=red];
		j3204976730 -> j4194579304;
		j3204976730 -> j1671029760;
	j240434503 [label="To my stworzyliśmy Obojętność – ona nie jest bogiem, Leonie. Nie pozwól, by błąd Entratiego cię zniszczył. Co z twoją wiarą?",shape=box,color=red];
		j240434503 -> j4194579304;
		j240434503 -> j1671029760;
	j583533199 [label="Nie mogę patrzeć, gdy jesteś w takim stanie. Uwięziony w samym środku absurdalnej sytuacji. Nie zasłużyłeś na to.",shape=box,color=red];
		j583533199 -> j2894608508;
		j583533199 -> j3323478139;
		j583533199 -> j4194579304;
		j583533199 -> j3524377502;
		j583533199 -> j1671029760;
	j2894608508 [label="Nie twierdzę, że musisz odzyskać wiarę. Mówię tylko, że jeśli chcesz – jeśli czujesz taką potrzebę – to zawsze możesz ją odzyskać.",shape=box,color=red];
		j2894608508 -> j2715458460;
	j3323478139 [label="Lua z pewnością widzi, przez co musiałeś przejść. Co wycierpiałeś w jej imieniu. ",shape=box,color=red];
		j3323478139 -> j2022262544;
	j4194579304 [label="Myślę, że musisz się skupić na znalezieniu wewnętrznego spokoju – czymkolwiek jest, to musisz go znaleźć.",shape=box,color=red];
		j4194579304 -> j2715458460;
	j3524377502 [label="Jeśli bóg istnieje, jeśli twoja Lua istnieje – z pewnością widzi, przez co musisz przechodzić. Co musisz znosić w jej imieniu. To z pewnością ma znaczenie.",shape=box,color=red];
		j3524377502 -> j2022262544;
	j1671029760 [label="Sądzę, że w pierwszej kolejności powinieneś porzucić wszelkie wyobrażenia o istnieniu bogów i skupić się na uzdrowieniu samego siebie.",shape=box,color=red];
		j1671029760 -> j2933612929;
	j2715458460 [label="Boolean LyonFaith3Maybe is now true.",color=orange];
		j2715458460 -> j3833060213;
	j2022262544 [label="Boolean LyonFaith3Yes is now true.",color=orange];
		j2022262544 -> j3833060213;
	j2933612929 [label="Boolean LyonFaith3No is now true.",color=orange];
		j2933612929 -> j3833060213;
	j3833060213 [label="Może masz rację... A moja smutna opowieść o zwątpieniu była nie na miejscu. Rozważę twoje słowa. Pomówmy o tym jutro.",shape=box,color=blue];
		j3833060213 -> j2494032019;
	j2494032019 [label="Widziałem życie Rella na pokładzie Zarimana Ten Zero, a także wszystko to, przez co później przechodził. Widziałem życie Harrowa jako żołnierza, gasnące podczas Plagi. Tak jak oni widzieli moje życie w Galicji i całe moje cierpienie.",shape=box,color=blue];
		j2494032019 -> j3303815027;
	j3303815027 [label="Może to wydawać ci się dziwne, ale żaden z nas nie zamienił ze sobą ani słowa. Nigdy nie czuliśmy takiej potrzeby. Po prostu było między nami... zrozumienie.",shape=box,color=blue];
		j3303815027 -> j134727702;
		j3303815027 -> j3104706931;
	j134727702 [label="Naprawdę? Nigdy?",shape=box,color=red];
		j134727702 -> j1884442476;
	j3104706931 [label="Tak... dobrze to widzę.",shape=box,color=red];
		j3104706931 -> j2010835301;
	j1884442476 [label="Słyszałem ich głosy – znałem wszystkie słowa, jakie kiedykolwiek wypowiedzieli w swoim życiu. Ale nigdy nie były skierowane do mnie.",shape=box,color=blue];
		j1884442476 -> j2010835301;
	j2010835301 [label="Czy uśmiech wymaga słów? A zmarszczenie czoła? Czy trzeba usłyszeć płacz dziecka, żeby wiedzieć, że cierpi lub się boi? Nie. Po prostu wiedzieliśmy, co nas łączy.",shape=box,color=blue];
		j2010835301 -> j4097483192;
	j4097483192 [label="Do czasu... aż przestało istnieć.",shape=box,color=blue];
		j4097483192 -> j944777217;
	j944777217 [label="Check boolean LyonDating",color=orange];
		j944777217 -> j1392467153 [label=true,color=green];
		j944777217 -> j107423378 [label=false,color=brown];
	j1392467153 [label="Oni nie odeszli, mon miracle... tylko umarli.",shape=box,color=blue];
		j1392467153 -> j3495193051;
	j107423378 [label="Oni nie odeszli, przyjacielu... tylko umarli.",shape=box,color=blue];
		j107423378 -> j3495193051;
	j3495193051 [label="Nie słyszę już tych ich nieokreślonych kwestii. Teraz, jak mniemam, słyszę tylko te kwestie, które były w jakiś sposób określone.",shape=box,color=blue];
		j3495193051 -> j2654787387;
		j3495193051 -> j713300310;
	j2654787387 [label="Przepraszam, określone?",shape=box,color=red];
		j2654787387 -> j74717672;
	j713300310 [label="Kiedy przestałeś go słyszeć?",shape=box,color=red];
		j713300310 -> j3965613197;
	j74717672 [label="Nie potrafię tego lepiej wyjaśnić. Nie wiem jak. Wybacz mi.",shape=box,color=blue];
		j74717672 -> j3965613197;
	j3965613197 [label="W chwili, gdy wraz z Roathem przeszliśmy przez Helmintha i dotarliśmy tutaj, do Sanctum. Nie wiem... dlaczego. Ani jak.",shape=box,color=blue];
		j3965613197 -> j2066228641;
	j2066228641 [label="Ale przechodząc przez ten woal czasu, moi przyjaciele, moi bracia... drzewa, których korzenie tak ściśle oplatały moją duszę... uschły i umarły u mego boku.",shape=box,color=blue];
		j2066228641 -> j3747165812;
	j3747165812 [label="Teraz panuje tam pustka. Gnijąca. Wspomnienia o nich wciąż niszczą moje własne. Ale nie oddałbym ich, gdybym tylko mógł...",shape=box,color=blue];
		j3747165812 -> j3426215055;
		j3747165812 -> j3503915398;
	j3426215055 [label="Naprawdę?",shape=box,color=red];
		j3426215055 -> j320005588;
	j3503915398 [label="Dlaczego nie?",shape=box,color=red];
		j3503915398 -> j320005588;
	j320005588 [label="Pamiętam, gdy matka uderzyła mnie po raz pierwszy. Zapamiętałem to na dwa sposoby, wyraźnie niczym najjaśniejsze światło Sol i wiem, że obie wersje są prawdziwe.",shape=box,color=blue];
		j320005588 -> j2292368821;
	j2292368821 [label="W pierwszym z nich... płaczę samotnie w ciemnościach mojego pokoju. A w drugim, dwie postacie stoją u mego boku pogrążone w cieniu.",shape=box,color=blue];
		j2292368821 -> j1653469498;
	j1653469498 [label="Pamiętam dwukrotnie, jak pierwszy raz przebiłem sobie skórę ostrzem, żeby pozbyć się głosów z mojej głowy. W jednym ze wspomnień pokój jest pusty.",shape=box,color=blue];
		j1653469498 -> j1295856163;
	j1295856163 [label="W innym słyszę nucenie za moimi plecami. Czuję cichą obecność stoickiego opiekuna.",shape=box,color=blue];
		j1295856163 -> j3304982287;
	j3304982287 [label="Jeśli miałbym stracić wiarę w moją boginię Luę, a w zamian zyskałbym ich pomoc... być może byłbym skłonny dokonać takiej wymiany.",shape=box,color=blue];
		j3304982287 -> j2400849994;
