	j2046060991 [label="I will sit in quiet prayer in thanks to whatever god guided you to us that you have had the patience... the kindness... to listen to me at such length.",shape=box,color=blue];
		j2046060991 -> j722534986;
	j3277533796 [label="That I could speak so much of my pain to you, and you endured it? And ask nothing of me in return... My thanks are paltry in comparison.",shape=box,color=blue];
		j3277533796 -> j2389167653;
	j4294739340 [label="I know that what I have become, what I have always been, is not so easy for others to suffer.",shape=box,color=blue];
		j4294739340 -> j2389167653;
	j1704665780 [label="That I could so heedlessly speak the truth of my soul to you and you withstood it with nothing but an open heart.",shape=box,color=blue];
		j1704665780 -> j810160347;
	j722534986 [label="That I could so heedlessly speak the truth of my soul to you and you withstood it with nothing but open arms.",shape=box,color=blue];
		j722534986 -> j810160347;
	j2389167653 [label="And for all the patience you have granted me, I am most grateful.",shape=box,color=blue];
