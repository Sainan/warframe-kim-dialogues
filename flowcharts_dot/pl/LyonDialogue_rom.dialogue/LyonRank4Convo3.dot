digraph {
	871 [label="LyonRank4Convo3 begins.",color=orange];
		871 -> 872;
		871 -> 873;
		871 -> 874;
	872 [label="Jak się dogadujesz z Cavią?",shape=box,color=red];
		872 -> 875;
	873 [label="Co sądzisz o Loidzie?",shape=box,color=red];
		873 -> 876;
	874 [label="[Koniec]",shape=box,color=red];
		874 -> 877;
	875 [label="Z niebywałą przyjemnością słucham ich przekomarzania się, choć jak możesz sobie wyobrazić, sam w tym nie uczestniczę. Niewiele mam do dodania do dyskursu.",shape=box,color=blue];
		875 -> 878;
	876 [label="Uważam, że jest przemiły. W zasadzie to spośród moich nowych... kompanów właśnie jego towarzystwo najbardziej mi odpowiada.",shape=box,color=blue];
		876 -> 879;
	877 [label="Chat ends.",color=orange];
	878 [label="Jednak martwi mnie, gdy widzę Roathe'a i prowadzącego wzmożoną konwersację z Ptakiem-3. Nie mam pojęcia, co chce przez to osiągnąć.",shape=box,color=blue];
		878 -> 880;
	879 [label="Choć jak mniemam, dla nikogo nie stanowi to zaskoczenia. Na pierwszy rzut oka mamy podobne usposobienie.",shape=box,color=blue];
		879 -> 881;
	880 [label="Update boolean LyonRoatheCavia1",color=orange];
		880 -> 882;
		880 -> 883;
	881 [label="Dziwniejszy wydaje mi się ten młody Operator... i ta, którą zwą Lotus. A zwłaszcza to, jak bardzo trzymają nas od nich na dystans.",shape=box,color=blue];
		881 -> 884;
	882 [label="Hmm. Zapytam go o to.",shape=box,color=red];
		882 -> 885;
	883 [label="Dlaczego uważasz, że próbuje cokolwiek osiągnąć?",shape=box,color=red];
		883 -> 886;
	884 [label="Oczywiście, że możemy wchodzić w interakcje. Ale nie w taki sposób. Nie tutaj. Pytam: dlaczego?",shape=box,color=blue];
		884 -> 887;
		884 -> 888;
	885 [label="Dobry pomysł. Roathe zawsze ma jakiś cel, gdy z kimś rozmawia. Nie chciałbym, żeby okazało się, że manipuluje tymi stworzeniami i wykorzystuje je, bardziej niż już zostały do tej pory.",shape=box,color=blue];
		885 -> 881;
	886 [label="Roathe zawsze ma jakiś cel, gdy z kimś rozmawia. Nie chciałbym, żeby okazało się, że manipuluje tymi stworzeniami i wykorzystuje je, bardziej niż już zostały do tej pory.",shape=box,color=blue];
		886 -> 889;
	887 [label="Ten dzieciak... ma swoje własne problemy. Nie możemy od niego więcej wymagać. To nie w porządku.",shape=box,color=red];
		887 -> 890;
	888 [label="Pewnie, dlatego że mam \"wcześniejsze doświadczenia\" z protoframe'ami?",shape=box,color=red];
		888 -> 891;
	889 [label="Warto się temu przyjrzeć, jeśli znajdziesz chwilę. Choć to wyłącznie twoja prerogatywa.",shape=box,color=blue];
		889 -> 881;
	890 [label="Tak. Doszły mnie słuchy, przez co musieli przejść. Historia o wojnie... i rozbitej przyjaźni.",shape=box,color=blue];
		890 -> 892;
	891 [label="Check boolean IsDating",color=orange];
		891 -> 894 [label=true,color=green];
		891 -> 893 [label=false,color=brown];
	892 [label="Serce mi pęka na myśl o tym, co pochłonęła wojna. A jeszcze bardziej, gdy pomyślę, co może stworzyć.",shape=box,color=blue];
		892 -> 895;
	894 [label="Hmm. Tak to się teraz nazywa? \"Wcześniejsze doświadczenia\"? Ależ to gustowne. Choć Entrati narobił niezłego bigosu, cieszę się, że znalazłeś sposób na zapewnienie sobie rozrywki.",shape=box,color=blue];
		894 -> 898;
		894 -> 899;
		894 -> 900;
	893 [label="P. Loid opowiedział mi o swoim \"niefortunnym incydencie\" w Höllvanii z twojej przeszłości, a naszej przyszłości. Entrati z pewnością narobił niezłego bigosu.",shape=box,color=blue];
		893 -> 896;
		893 -> 897;
	895 [label="P. Loid opowiedział mi o swoim \"niefortunnym incydencie\" w Höllvanii z twojej przeszłości, a naszej przyszłości. Entrati z pewnością narobił niezłego bigosu.",shape=box,color=blue];
		895 -> 896;
		895 -> 897;
	898 [label="Czy zrobiłem coś nie tak?",shape=box,color=red];
		898 -> 903;
	899 [label="Uważaj, bo pomyślę, że zastanawiasz się, czy trawa po drugiej stronie płotu nie jest bardziej zielona, Ojcze.",shape=box,color=red];
		899 -> 904;
	900 [label="Brzmisz, jakby to miała być zaledwie przelotna przygoda, Leonie. Proszę, nie obrażaj mnie w ten sposób.",shape=box,color=red];
		900 -> 905;
	896 [label="Mogło być znacznie gorzej, uwierz mi.",shape=box,color=red];
		896 -> 901;
	897 [label="Te protoframe'y są moimi dobrymi przyjaciółmi. Stały się dla mnie rodziną.",shape=box,color=red];
		897 -> 902;
	903 [label="Check boolean LyonFirstFlirt",color=orange];
		903 -> 908 [label=true,color=green];
		903 -> 909 [label=false,color=brown];
	904 [label="Check boolean LyonFirstFlirt",color=orange];
		904 -> 908 [label=true,color=green];
		904 -> 910 [label=false,color=brown];
	905 [label="Check boolean LyonFirstFlirt",color=orange];
		905 -> 908 [label=true,color=green];
		905 -> 911 [label=false,color=brown];
	901 [label="Jestem pewien, że to wszystko było wynikiem wielkiego, mistrzowskiego planu Entrati'ego. Powierzyć los przyszłości tobie i bandzie odmieńców.",shape=box,color=blue];
		901 -> 906;
	902 [label="Moi dziadkowie poznali się podczas rewolucji galijskiej. Wojna i śmierć zawsze szły za pan brat, co prowadziło do osobliwego tańca koleżeństwa.",shape=box,color=blue];
		902 -> 907;
	908 [label="Wybacz. Wydawało mi się, że gdy ostatnio omawialiśmy pewne sprawy, ty... ",shape=box,color=blue];
		908 -> 915;
	909 [label="Wybacz mi. Nie znam twoich uczuć ani uczuć innych. A to, co robisz w wolnym czasie z innymi osobami, jest twoją prywatną sprawą.",shape=box,color=blue];
		909 -> 916;
		909 -> 917;
	910 [label="Wybacz. Masz rację. Nie chciałem wyjść na zazdrośnika ani zabrzmieć niczym jakiś prowokator. To, co robisz w wolnym czasie z innymi osobami, jest twoją prywatną sprawą.",shape=box,color=blue];
		910 -> 916;
		910 -> 917;
	911 [label="Oczywiście. Wybacz mi. Nie znam twoich uczuć ani uczuć innych. A to, co robisz w wolnym czasie z innymi osobami, jest twoją prywatną sprawą.",shape=box,color=blue];
		911 -> 916;
		911 -> 917;
	906 [label="Ja... Włóczęgo... wiem, że nie jestem najbardziej... uprzejmą osobą, z którą jesteś zmuszony współdziałać i przepraszam cię za to.",shape=box,color=blue];
		906 -> 912;
	907 [label="Update boolean LyonBackstory2",color=orange];
		907 -> 913;
		907 -> 914;
	915 [label="Nieważne... Nie powinienem być zaskoczony, że uczucia bywają kapryśne i ulotne. A zwłaszcza wtedy, gdy dotyczy to mnie samego.",shape=box,color=blue];
		915 -> 921;
		915 -> 922;
	916 [label="Wiele z nimi przeszedłem. To znacznie zbliża ludzi.",shape=box,color=red];
		916 -> 923;
	917 [label="[Wyznaj swoje uczucia] Szczerze mówiąc, to już od jakiegoś czasu głowię się, jak poruszyć z tobą ten temat.",shape=box,color=red];
		917 -> 924;
	912 [label="Taki już po prostu jestem i nie wiem, jak to zmienić. Co więcej, nie sądzę, abym był w stanie naprawić krzywdę, jaką wyrządzili mojej duszy potępieńcy, którzy mnie prześladują.",shape=box,color=blue];
		912 -> 918;
	913 [label="Zdaje się, że historia lubi się powtarzać.",shape=box,color=red];
		913 -> 919;
	914 [label="Chciałbym się więcej dowiedzieć o twojej rodzinie.",shape=box,color=red];
		914 -> 920;
	921 [label="Chwila. Chyba źle to zrozumiałeś. Nie chciałem cię wprowadzić w błąd. To po prostu... skomplikowane.",shape=box,color=red];
		921 -> 931;
	922 [label="Wydawało mi się, że nie jesteś mną zainteresowany.",shape=box,color=red];
		922 -> 932;
	923 [label="Moi dziadkowie poznali się podczas rewolucji galijskiej. Wojna i śmierć zawsze szły za pan brat, co prowadzi do dziwnego mariażu namiętności i miłości.",shape=box,color=blue];
		923 -> 907;
	924 [label="Jestem teraz bardzo poddenerwowany... Czy mogę wiedzieć dlaczego?",shape=box,color=blue];
		924 -> 933;
		924 -> 934;
	918 [label="To, co kryje się pod taflą pękającego szkła, jest...",shape=box,color=blue];
		918 -> 925;
		918 -> 926;
	919 [label="W rzeczy samej. Zakładam, że nie powinienem mieć pretensji do wszelkich pozytywnych aspektów wynikłych z mroku i zniszczenia wojny.",shape=box,color=blue];
		919 -> 927;
		919 -> 928;
	920 [label="Nie jest to opowieść, którą lubię się dzielić. Z kimkolwiek. Więc wybacz mi, jeśli nie będę zbyt chętny, by się uzewnętrzniać. Może innym razem.",shape=box,color=blue];
		920 -> 929;
		920 -> 930;
	931 [label="Mów dalej.",shape=box,color=blue];
		931 -> 933;
		931 -> 934;
	932 [label="Z całym szacunkiem, ale cię nie znam. A biorąc pod uwagę to wszystko, co na mnie spadło, romans z nieznajomym nie jest dla mnie sprawą najwyższej wagi.",shape=box,color=blue];
		932 -> 941;
	933 [label="Ja... wrócimy do tego innym razem. Przepraszam.",shape=box,color=red];
		933 -> 942;
	934 [label="Nie wiem, czy łatwo będzie ci to pojąć, czy może wyda ci się czymś szalonym, ale ja... potrafię darzyć silnym uczuciem więcej niż jedną osobę jednocześnie.",shape=box,color=red];
		934 -> 943;
	925 [label="Już dobrze, Leonie. Dojdziemy do tego. Nie spieszę się, uwierz mi.",shape=box,color=red];
		925 -> 935;
	926 [label="Jest czym?",shape=box,color=red];
		926 -> 936;
	927 [label="Co masz na myśli?",shape=box,color=red];
		927 -> 937;
	928 [label="O jakich pretensjach mówisz?",shape=box,color=red];
		928 -> 938;
	929 [label="Będę czekać.",shape=box,color=red];
		929 -> 939;
	930 [label="Oczywiście. Gdy tylko będziesz gotowy, Leonie.",shape=box,color=red];
		930 -> 940;
	941 [label="Jestem pewien, że są inne jednostki, które w takiej sytuacji z chęcią szukałyby otuchy w ramionach drugiej osoby. Jednak ja nie należę do tego grona.",shape=box,color=blue];
		941 -> 948;
	942 [label="+20 Chemistry",color=orange];
		942 -> 949;
	943 [label="Coś do ciebie czuję. Ale czuję też coś do innych. I jak dla mnie to każde uczucie jest prawdziwe.",shape=box,color=red];
		943 -> 950;
	935 [label="+20 Chemistry",color=orange];
		935 -> 944;
	936 [label="+10 Chemistry",color=orange];
		936 -> 945;
	937 [label="Przepraszam. Nie jest to opowieść, którą lubię się dzielić. Z kimkolwiek. Więc wybacz mi, jeśli nie będę zbyt chętny, by się uzewnętrzniać. Może innym razem.",shape=box,color=blue];
		937 -> 929;
		937 -> 930;
	938 [label="Nie mam na myśli istnienia miłości, a raczej jej braku w moim życiu rodzinnym. Przepraszam. Nie jest to opowieść, którą lubię się dzielić. Z kimkolwiek. Więc wybacz mi, jeśli nie będę zbyt chętny, by się uzewnętrzniać. Może innym razem.",shape=box,color=blue];
		938 -> 929;
		938 -> 930;
	939 [label="+15 Chemistry",color=orange];
		939 -> 946;
	940 [label="+20 Chemistry",color=orange];
		940 -> 947;
	948 [label="Poszukaj jednej z takich osób, jeśli łaska. Miłego dnia.",shape=box,color=blue];
		948 -> 954;
	949 [label="Świetnie. Możemy o tym porozmawiać przy innej okazji, jeśli zechcesz. A tymczasem wracam do swoich obowiązków.",shape=box,color=blue];
		949 -> 954;
	950 [label="Tego typu koncepcja nie jest mi tak obca, jak mogłoby się wydawać. Właściwie to nie ona sama mnie tak zastanawia, jak strony, które biorą w niej udział – bez urazy.",shape=box,color=blue];
		950 -> 955;
	944 [label="Update boolean LyonVisions3",color=orange];
		944 -> 951;
	945 [label="Dla większości to zbyt wiele do zniesienia. I dziękuję ci, że nadal się starasz. To wszystko.",shape=box,color=blue];
		945 -> 952;
	946 [label="Tak, nieuchronnie dochodzę do tego wniosku. Dobrego dnia.",shape=box,color=blue];
		946 -> 953;
	947 [label="Dziękuję. Życzę ci dobrego dnia i do zobaczenia.",shape=box,color=blue];
		947 -> 953;
	954 [label="O. Leon Allard",shape=box,color=blue];
		954 -> 958;
	955 [label="A tak hipotetycznie, to jak blisko naszego nowego \"domu\" twoja strzała zamierza wylądować?",shape=box,color=blue];
		955 -> 959;
		955 -> 960;
	951 [label="Dziękuję...",shape=box,color=blue];
		951 -> 952;
	952 [label="O. Leon Allard",shape=box,color=blue];
		952 -> 956;
	953 [label="O. Leon Allard",shape=box,color=blue];
		953 -> 957;
	958 [label="Chat ends.",color=orange];
	959 [label="Szczerze mówiąc, to nie mówię, że \"teraz\". Po prostu się tłumaczę.",shape=box,color=red];
		959 -> 961;
	960 [label="A więc... mówisz, że... jest jakaś szansa?",shape=box,color=red];
		960 -> 962;
	956 [label="Chat ends.",color=orange];
	957 [label="Chat ends.",color=orange];
	961 [label="+20 Chemistry",color=orange];
		961 -> 963;
	962 [label="+20 Chemistry",color=orange];
		962 -> 964;
	963 [label="Tak, no cóż... Jeśli do tego momentu nie zacząłem darzyć cię obrzydzeniem, to całkiem możliwe, że jeszcze wrócimy do tej rozmowy.",shape=box,color=blue];
		963 -> 965;
	964 [label="Tak... być może. Skoro do tego momentu nie zacząłem darzyć cię obrzydzeniem. Ale to się dopiero okaże, Włóczęgo.",shape=box,color=blue];
		964 -> 965;
	965 [label="Do tego czasu muszę wrócić do swoich dzisiejszych obowiązków. Doceniam tę... ciekawą rozmowę. Chyba.",shape=box,color=blue];
