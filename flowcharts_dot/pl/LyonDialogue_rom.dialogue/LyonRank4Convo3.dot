	j1329677995 [label="Jak się dogadujesz z Cavią?",shape=box,color=red];
		j1329677995 -> j2714653353;
	j772157052 [label="Co sądzisz o Loidzie?",shape=box,color=red];
		j772157052 -> j2323714522;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j2714653353 [label="Z niebywałą przyjemnością słucham ich przekomarzania się, choć jak możesz sobie wyobrazić, sam w tym nie uczestniczę. Niewiele mam do dodania do dyskursu.",shape=box,color=blue];
		j2714653353 -> j433895632;
	j2323714522 [label="Uważam, że jest przemiły. W zasadzie to spośród moich nowych... kompanów właśnie jego towarzystwo najbardziej mi odpowiada.",shape=box,color=blue];
		j2323714522 -> j2488180213;
	"Chat ends." [color=orange];
	j433895632 [label="Jednak martwi mnie, gdy widzę Roathe'a i prowadzącego wzmożoną konwersację z Ptakiem-3. Nie mam pojęcia, co chce przez to osiągnąć.",shape=box,color=blue];
		j433895632 -> j2507757158;
	j2488180213 [label="Choć jak mniemam, dla nikogo nie stanowi to zaskoczenia. Na pierwszy rzut oka mamy podobne usposobienie.",shape=box,color=blue];
		j2488180213 -> j3538426708;
	j2507757158 [label="Boolean LyonRoatheCavia1 is now true.",color=orange];
		j2507757158 -> j1227764638;
		j2507757158 -> j3631533509;
	j3538426708 [label="Dziwniejszy wydaje mi się ten młody Operator... i ta, którą zwą Lotus. A zwłaszcza to, jak bardzo trzymają nas od nich na dystans.",shape=box,color=blue];
		j3538426708 -> j785851188;
	j1227764638 [label="Hmm. Zapytam go o to.",shape=box,color=red];
		j1227764638 -> j3351356014;
	j3631533509 [label="Dlaczego uważasz, że próbuje cokolwiek osiągnąć?",shape=box,color=red];
		j3631533509 -> j4118796125;
	j785851188 [label="Oczywiście, że możemy wchodzić w interakcje. Ale nie w taki sposób. Nie tutaj. Pytam: dlaczego?",shape=box,color=blue];
		j785851188 -> j3917558947;
		j785851188 -> j544746763;
	j3351356014 [label="Dobry pomysł. Roathe zawsze ma jakiś cel, gdy z kimś rozmawia. Nie chciałbym, żeby okazało się, że manipuluje tymi stworzeniami i wykorzystuje je, bardziej niż już zostały do tej pory.",shape=box,color=blue];
		j3351356014 -> j3538426708;
	j4118796125 [label="Roathe zawsze ma jakiś cel, gdy z kimś rozmawia. Nie chciałbym, żeby okazało się, że manipuluje tymi stworzeniami i wykorzystuje je, bardziej niż już zostały do tej pory.",shape=box,color=blue];
		j4118796125 -> j3386344644;
	j3917558947 [label="Ten dzieciak... ma swoje własne problemy. Nie możemy od niego więcej wymagać. To nie w porządku.",shape=box,color=red];
		j3917558947 -> j340414002;
	j544746763 [label="Pewnie, dlatego że mam \"wcześniejsze doświadczenia\" z protoframe'ami?",shape=box,color=red];
		j544746763 -> j3260070664;
	j3386344644 [label="Warto się temu przyjrzeć, jeśli znajdziesz chwilę. Choć to wyłącznie twoja prerogatywa.",shape=box,color=blue];
		j3386344644 -> j3538426708;
	j340414002 [label="Tak. Doszły mnie słuchy, przez co musieli przejść. Historia o wojnie... i rozbitej przyjaźni.",shape=box,color=blue];
		j340414002 -> j4233237934;
	j3260070664 [label="Check boolean IsDating",color=orange];
		j3260070664 -> j2469189245 [label=true,color=green];
		j3260070664 -> j2443946313 [label=false,color=brown];
	j4233237934 [label="Serce mi pęka na myśl o tym, co pochłonęła wojna. A jeszcze bardziej, gdy pomyślę, co może stworzyć.",shape=box,color=blue];
		j4233237934 -> j2443946313;
	j2469189245 [label="Hmm. Tak to się teraz nazywa? \"Wcześniejsze doświadczenia\"? Ależ to gustowne. Choć Entrati narobił niezłego bigosu, cieszę się, że znalazłeś sposób na zapewnienie sobie rozrywki.",shape=box,color=blue];
		j2469189245 -> j3699207403;
		j2469189245 -> j3428572898;
		j2469189245 -> j1958918034;
	j2443946313 [label="P. Loid opowiedział mi o swoim \"niefortunnym incydencie\" w Höllvanii z twojej przeszłości, a naszej przyszłości. Entrati z pewnością narobił niezłego bigosu.",shape=box,color=blue];
		j2443946313 -> j1280253323;
		j2443946313 -> j2049827592;
	j3699207403 [label="Czy zrobiłem coś nie tak?",shape=box,color=red];
		j3699207403 -> j3487893497;
	j3428572898 [label="Uważaj, bo pomyślę, że zastanawiasz się, czy trawa po drugiej stronie płotu nie jest bardziej zielona, Ojcze.",shape=box,color=red];
		j3428572898 -> j619519124;
	j1958918034 [label="Brzmisz, jakby to miała być zaledwie przelotna przygoda, Leonie. Proszę, nie obrażaj mnie w ten sposób.",shape=box,color=red];
		j1958918034 -> j1331458418;
	j1280253323 [label="Mogło być znacznie gorzej, uwierz mi.",shape=box,color=red];
		j1280253323 -> j2932826472;
	j2049827592 [label="Te protoframe'y są moimi dobrymi przyjaciółmi. Stały się dla mnie rodziną.",shape=box,color=red];
		j2049827592 -> j969300699;
	j3487893497 [label="Check boolean LyonFirstFlirt",color=orange];
		j3487893497 -> j1501709036 [label=true,color=green];
		j3487893497 -> j1444974739 [label=false,color=brown];
	j619519124 [label="Check boolean LyonFirstFlirt",color=orange];
		j619519124 -> j1501709036 [label=true,color=green];
		j619519124 -> j1848254388 [label=false,color=brown];
	j1331458418 [label="Check boolean LyonFirstFlirt",color=orange];
		j1331458418 -> j1501709036 [label=true,color=green];
		j1331458418 -> j3358527391 [label=false,color=brown];
	j2932826472 [label="Jestem pewien, że to wszystko było wynikiem wielkiego, mistrzowskiego planu Entrati'ego. Powierzyć los przyszłości tobie i bandzie odmieńców.",shape=box,color=blue];
		j2932826472 -> j2651414638;
	j969300699 [label="Moi dziadkowie poznali się podczas rewolucji galijskiej. Wojna i śmierć zawsze szły za pan brat, co prowadziło do osobliwego tańca koleżeństwa.",shape=box,color=blue];
		j969300699 -> j3628502303;
	j1501709036 [label="Wybacz. Wydawało mi się, że gdy ostatnio omawialiśmy pewne sprawy, ty... ",shape=box,color=blue];
		j1501709036 -> j1366033811;
	j1444974739 [label="Wybacz mi. Nie znam twoich uczuć ani uczuć innych. A to, co robisz w wolnym czasie z innymi osobami, jest twoją prywatną sprawą.",shape=box,color=blue];
		j1444974739 -> j927267282;
		j1444974739 -> j3232184393;
	j1848254388 [label="Wybacz. Masz rację. Nie chciałem wyjść na zazdrośnika ani zabrzmieć niczym jakiś prowokator. To, co robisz w wolnym czasie z innymi osobami, jest twoją prywatną sprawą.",shape=box,color=blue];
		j1848254388 -> j927267282;
		j1848254388 -> j3232184393;
	j3358527391 [label="Oczywiście. Wybacz mi. Nie znam twoich uczuć ani uczuć innych. A to, co robisz w wolnym czasie z innymi osobami, jest twoją prywatną sprawą.",shape=box,color=blue];
		j3358527391 -> j927267282;
		j3358527391 -> j3232184393;
	j2651414638 [label="Ja... Włóczęgo... wiem, że nie jestem najbardziej... uprzejmą osobą, z którą jesteś zmuszony współdziałać i przepraszam cię za to.",shape=box,color=blue];
		j2651414638 -> j3082111008;
	j3628502303 [label="Boolean LyonBackstory2 is now true.",color=orange];
		j3628502303 -> j1041667126;
		j3628502303 -> j3037864761;
	j1366033811 [label="Nieważne... Nie powinienem być zaskoczony, że uczucia bywają kapryśne i ulotne. A zwłaszcza wtedy, gdy dotyczy to mnie samego.",shape=box,color=blue];
		j1366033811 -> j2716800842;
		j1366033811 -> j322044561;
	j927267282 [label="Wiele z nimi przeszedłem. To znacznie zbliża ludzi.",shape=box,color=red];
		j927267282 -> j217497348;
	j3232184393 [label="[Wyznaj swoje uczucia] Szczerze mówiąc, to już od jakiegoś czasu głowię się, jak poruszyć z tobą ten temat.",shape=box,color=red];
		j3232184393 -> j30035431;
	j3082111008 [label="Taki już po prostu jestem i nie wiem, jak to zmienić. Co więcej, nie sądzę, abym był w stanie naprawić krzywdę, jaką wyrządzili mojej duszy potępieńcy, którzy mnie prześladują.",shape=box,color=blue];
		j3082111008 -> j4029359413;
	j1041667126 [label="Zdaje się, że historia lubi się powtarzać.",shape=box,color=red];
		j1041667126 -> j4103710722;
	j3037864761 [label="Chciałbym się więcej dowiedzieć o twojej rodzinie.",shape=box,color=red];
		j3037864761 -> j3290887919;
	j2716800842 [label="Chwila. Chyba źle to zrozumiałeś. Nie chciałem cię wprowadzić w błąd. To po prostu... skomplikowane.",shape=box,color=red];
		j2716800842 -> j3141720883;
	j322044561 [label="Wydawało mi się, że nie jesteś mną zainteresowany.",shape=box,color=red];
		j322044561 -> j609066449;
	j217497348 [label="Moi dziadkowie poznali się podczas rewolucji galijskiej. Wojna i śmierć zawsze szły za pan brat, co prowadzi do dziwnego mariażu namiętności i miłości.",shape=box,color=blue];
		j217497348 -> j3628502303;
	j30035431 [label="Jestem teraz bardzo poddenerwowany... Czy mogę wiedzieć dlaczego?",shape=box,color=blue];
		j30035431 -> j3920420187;
		j30035431 -> j1044866007;
	j4029359413 [label="To, co kryje się pod taflą pękającego szkła, jest...",shape=box,color=blue];
		j4029359413 -> j4206340729;
		j4029359413 -> j1592494393;
	j4103710722 [label="W rzeczy samej. Zakładam, że nie powinienem mieć pretensji do wszelkich pozytywnych aspektów wynikłych z mroku i zniszczenia wojny.",shape=box,color=blue];
		j4103710722 -> j3164343965;
		j4103710722 -> j3961256778;
	j3290887919 [label="Nie jest to opowieść, którą lubię się dzielić. Z kimkolwiek. Więc wybacz mi, jeśli nie będę zbyt chętny, by się uzewnętrzniać. Może innym razem.",shape=box,color=blue];
		j3290887919 -> j2355000947;
		j3290887919 -> j1623680394;
	j3141720883 [label="Mów dalej.",shape=box,color=blue];
		j3141720883 -> j3920420187;
		j3141720883 -> j1044866007;
	j609066449 [label="Z całym szacunkiem, ale cię nie znam. A biorąc pod uwagę to wszystko, co na mnie spadło, romans z nieznajomym nie jest dla mnie sprawą najwyższej wagi.",shape=box,color=blue];
		j609066449 -> j17872386;
	j3920420187 [label="Ja... wrócimy do tego innym razem. Przepraszam.",shape=box,color=red];
		j3920420187 -> j4030528362;
	j1044866007 [label="Nie wiem, czy łatwo będzie ci to pojąć, czy może wyda ci się czymś szalonym, ale ja... potrafię darzyć silnym uczuciem więcej niż jedną osobę jednocześnie.",shape=box,color=red];
		j1044866007 -> j3860852389;
	j4206340729 [label="Już dobrze, Leonie. Dojdziemy do tego. Nie spieszę się, uwierz mi.",shape=box,color=red];
		j4206340729 -> j3205029787;
	j1592494393 [label="Jest czym?",shape=box,color=red];
		j1592494393 -> j71769407;
	j3164343965 [label="Co masz na myśli?",shape=box,color=red];
		j3164343965 -> j1843986248;
	j3961256778 [label="O jakich pretensjach mówisz?",shape=box,color=red];
		j3961256778 -> j4125041194;
	j2355000947 [label="Będę czekać.",shape=box,color=red];
		j2355000947 -> j992964409;
	j1623680394 [label="Oczywiście. Gdy tylko będziesz gotowy, Leonie.",shape=box,color=red];
		j1623680394 -> j2947556609;
	j17872386 [label="Jestem pewien, że są inne jednostki, które w takiej sytuacji z chęcią szukałyby otuchy w ramionach drugiej osoby. Jednak ja nie należę do tego grona.",shape=box,color=blue];
		j17872386 -> j721842744;
	j4030528362 [label="+20 Chemistry",color=orange];
		j4030528362 -> j3003845671;
	j3860852389 [label="Coś do ciebie czuję. Ale czuję też coś do innych. I jak dla mnie to każde uczucie jest prawdziwe.",shape=box,color=red];
		j3860852389 -> j1566560431;
	j3205029787 [label="+20 Chemistry",color=orange];
		j3205029787 -> j2016647866;
	j71769407 [label="+10 Chemistry",color=orange];
		j71769407 -> j1308796811;
	j1843986248 [label="Przepraszam. Nie jest to opowieść, którą lubię się dzielić. Z kimkolwiek. Więc wybacz mi, jeśli nie będę zbyt chętny, by się uzewnętrzniać. Może innym razem.",shape=box,color=blue];
		j1843986248 -> j2355000947;
		j1843986248 -> j1623680394;
	j4125041194 [label="Nie mam na myśli istnienia miłości, a raczej jej braku w moim życiu rodzinnym. Przepraszam. Nie jest to opowieść, którą lubię się dzielić. Z kimkolwiek. Więc wybacz mi, jeśli nie będę zbyt chętny, by się uzewnętrzniać. Może innym razem.",shape=box,color=blue];
		j4125041194 -> j2355000947;
		j4125041194 -> j1623680394;
	j992964409 [label="+15 Chemistry",color=orange];
		j992964409 -> j2760084111;
	j2947556609 [label="+20 Chemistry",color=orange];
		j2947556609 -> j2840971838;
	j721842744 [label="Poszukaj jednej z takich osób, jeśli łaska. Miłego dnia.",shape=box,color=blue];
		j721842744 -> j3651491667;
	j3003845671 [label="Świetnie. Możemy o tym porozmawiać przy innej okazji, jeśli zechcesz. A tymczasem wracam do swoich obowiązków.",shape=box,color=blue];
		j3003845671 -> j3651491667;
	j1566560431 [label="Tego typu koncepcja nie jest mi tak obca, jak mogłoby się wydawać. Właściwie to nie ona sama mnie tak zastanawia, jak strony, które biorą w niej udział – bez urazy.",shape=box,color=blue];
		j1566560431 -> j76488385;
	j2016647866 [label="Boolean LyonVisions3 is now true.",color=orange];
		j2016647866 -> j978446515;
	j1308796811 [label="Dla większości to zbyt wiele do zniesienia. I dziękuję ci, że nadal się starasz. To wszystko.",shape=box,color=blue];
		j1308796811 -> j3651491667;
	j2760084111 [label="Tak, nieuchronnie dochodzę do tego wniosku. Dobrego dnia.",shape=box,color=blue];
		j2760084111 -> j3651491667;
	j2840971838 [label="Dziękuję. Życzę ci dobrego dnia i do zobaczenia.",shape=box,color=blue];
		j2840971838 -> j3651491667;
	j3651491667 [label="O. Leon Allard",shape=box,color=blue];
		j3651491667 -> "Chat ends.";
	j76488385 [label="A tak hipotetycznie, to jak blisko naszego nowego \"domu\" twoja strzała zamierza wylądować?",shape=box,color=blue];
		j76488385 -> j586404563;
		j76488385 -> j3508161436;
	j978446515 [label="Dziękuję...",shape=box,color=blue];
		j978446515 -> j3651491667;
	j586404563 [label="Szczerze mówiąc, to nie mówię, że \"teraz\". Po prostu się tłumaczę.",shape=box,color=red];
		j586404563 -> j351658462;
	j3508161436 [label="A więc... mówisz, że... jest jakaś szansa?",shape=box,color=red];
		j3508161436 -> j3800692595;
	j351658462 [label="+20 Chemistry",color=orange];
		j351658462 -> j1536752513;
	j3800692595 [label="+20 Chemistry",color=orange];
		j3800692595 -> j3412404921;
	j1536752513 [label="Tak, no cóż... Jeśli do tego momentu nie zacząłem darzyć cię obrzydzeniem, to całkiem możliwe, że jeszcze wrócimy do tej rozmowy.",shape=box,color=blue];
		j1536752513 -> j3470728145;
	j3412404921 [label="Tak... być może. Skoro do tego momentu nie zacząłem darzyć cię obrzydzeniem. Ale to się dopiero okaże, Włóczęgo.",shape=box,color=blue];
		j3412404921 -> j3470728145;
	j3470728145 [label="Do tego czasu muszę wrócić do swoich dzisiejszych obowiązków. Doceniam tę... ciekawą rozmowę. Chyba.",shape=box,color=blue];
