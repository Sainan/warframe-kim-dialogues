		j1881357492 -> j3214006813;
	j2883342425 [label="Boolean LyonFlirtIgnored is now true.",color=orange];
		j2883342425 -> "Chat ends.";
	j2503127734 [label="O twoim kokieteryjnym komentarzu dla własnej rozrywki? A może chcesz poruszyć inne kwestie?",shape=box,color=blue];
		j2503127734 -> j441898765;
		j2503127734 -> j3221192329;
		j2503127734 -> j3214006813;
	j1825364457 [label="Bardzo mnie ciekawisz, Leonie. Tylko i aż tyle.",shape=box,color=red];
		j1825364457 -> j1664277742;
	j3864674192 [label="Nie wiem, co we mnie wstąpiło, Leonie. Najwyraźniej pomyliłem się. Bardzo cię przepraszam.",shape=box,color=red];
		j3864674192 -> j3836174037;
	j3214006813 [label="Ja... podtrzymuję to, co powiedziałem. Ale rozumiem, że to dla ciebie za szybko.",shape=box,color=red];
		j3214006813 -> j3836174037;
	"Chat ends." [color=orange];
	j441898765 [label="Nie flirtowałem z tobą dla swojej rozrywki, Leonie. Przepraszam, że tak to odebrałeś.",shape=box,color=red];
		j441898765 -> j3836174037;
	j3221192329 [label="Nie chciałem Cię urazić. Tylko żartowałem. Przepraszam.",shape=box,color=red];
		j3221192329 -> j2259577589;
	j1664277742 [label="Bez wzajemności. Tyle i aż tyle.",shape=box,color=blue];
		j1664277742 -> "Chat ends.";
	j3836174037 [label="Ja... Wybacz mi, Włóczęgo.",shape=box,color=blue];
		j3836174037 -> j2277978882;
	j2259577589 [label="Rozumiem.",shape=box,color=blue];
		j2259577589 -> "Chat ends.";
	j2277978882 [label="I wybacz mi moją bezpośredniość. Pragnę raz jeszcze jasno wyrazić, co ostatnio przytłoczyło mój umysł:",shape=box,color=blue];
		j2277978882 -> j2267828013;
	j2267828013 [label="Jestem teraz otoczony nieznanymi mi osobami i mówiącymi bestiami w dziwacznym świecie pełnym szaleństwa i pozornie niekończącej się, niepohamowanej rzezi.",shape=box,color=blue];
		j2267828013 -> j989842425;
	j989842425 [label="Wszystko mi znane zostało zmiecione przez świetliste promienie \"Jadeitowego Światła\", przez \"Imperium Orokin\", przez \"Pustkę\" i wciąż zagraża nam \"Szept\".",shape=box,color=blue];
		j989842425 -> j1221605403;
	j1221605403 [label="Więc musisz mi wybaczyć, jeśli uznam tę... propozycję sympatii z twojej strony za osobliwie śmieszną w swej naiwności. Ani cię nie znam, ani ci nie ufam. I owszem, jedyne, co mogę zrobić, to zaufać słowom innych.",shape=box,color=blue];
		j1221605403 -> j968975354;
	j968975354 [label="Słowom innych, których jeszcze nie znam i nie ufam.",shape=box,color=blue];
		j968975354 -> j1005984655;
	j1005984655 [label="A wszystko to, co się teraz dzieje, to jedynie zewnętrzne siły, które piętrzą się przede mną i przed Marią – nie mówiąc już o całej reszcie, z którą muszę się zmagać, a której ty nie możesz dostrzec.",shape=box,color=blue];
		j1005984655 -> j2327657859;
	j2327657859 [label="Doceniam twoją pewność siebie. Wiem, co próbujesz zrobić i chwała ci za to. Być może nadejdzie taki czas, że będę chciał... ponownie przemyśleć twoją ofertę? Jeśli nadal będzie aktualna.",shape=box,color=blue];
		j2327657859 -> j2645266943;
		j2327657859 -> j2241400506;
		j2327657859 -> j1290935349;
	j2645266943 [label="Nic nie mogę obiecać, Ojcze.",shape=box,color=red];
		j2645266943 -> j3337208053;
