	j545924170 [label="Leonie? Możemy porozmawiać? ",shape=box,color=red];
		j545924170 -> j2865764358;
	j163346980 [label="Leonie? Wybacz mi, jeśli powiedziałem coś, co było dla ciebie niezręczne. Nie miałem takich intencji.",shape=box,color=red];
		j163346980 -> j1881357492;
	j2697133523 [label="[Koniec]",shape=box,color=red];
		j2697133523 -> j2883342425;
	j2865764358 [label="O czym chcesz porozmawiać, Włóczęgo?",shape=box,color=blue];
		j2865764358 -> j2503127734;
	j1881357492 [label="Zakładam więc, że niepotrzebnie się głowię, dlaczego w ogóle ze mną flirtowałeś ku własnej rozrywce, skoro nie chciałeś mi sprawić przykrości... jaki był powód tego flirtu?",shape=box,color=blue];
		j1881357492 -> j1825364457;
