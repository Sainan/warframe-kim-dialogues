	"LyonRank4Convo7 begins." [color=orange];
		"LyonRank4Convo7 begins." -> j1005163561;
	j1005163561 [label="Włóczęgo? Czy mogę cię za coś przeprosić?",shape=box,color=blue];
		j1005163561 -> j818029550;
		j1005163561 -> j3305873202;
		j1005163561 -> j386906797;
	j818029550 [label="Pewnie. Tylko za co?",shape=box,color=red];
		j818029550 -> j2087815746;
	j3305873202 [label="Nie musisz, Leonie. Nie zrobiłeś nic złego.",shape=box,color=red];
		j3305873202 -> j1807258352;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j2087815746 [label="+5 Chemistry",color=orange];
		j2087815746 -> j2608154827;
	j1807258352 [label="Doceniam to, ale i tak czuję, że na to zasługujesz. Postaram się być zwięzły i nie silić się zbędną erudycję.",shape=box,color=blue];
		j1807258352 -> j2436562561;
	"Chat ends." [color=orange];
	j2608154827 [label="Dziękuję. Postaram się być zwięzły i nie obciążać się zbędną erudycją.",shape=box,color=blue];
		j2608154827 -> j2436562561;
	j2436562561 [label="Trudno jest mi prowadzić rozmowy. A zwłaszcza w taki bezosobowy, mechaniczny sposób, gdy dotyczą intymnych spraw.",shape=box,color=blue];
		j2436562561 -> j1312129872;
	j1312129872 [label="Nie wiem, jak to opisać. To trochę tak, jakbym... próbował coś chwycić, a widział jedynie, jak kawałki pyłu przelatują mi przez palce. ",shape=box,color=blue];
		j1312129872 -> j4025695605;
	j4025695605 [label="Często czuję się, jakbym był pustym kawałkiem płótna, rozmazującym farbę olejną na jego powierzchni... bezskutecznie próbując stworzyć zarys obrazu, który dostrzegam oczyma wyobraźni.",shape=box,color=blue];
		j4025695605 -> j338562135;
	j338562135 [label="A jednak im więcej wkładam w to wysiłku, tym gorszy rezultat.",shape=box,color=blue];
		j338562135 -> j4147840129;
	j4147840129 [label="Im bardziej się staram, tym bardziej mi wszystko umyka. Więc nauczyłem się, by... nie podejmować żadnych prób.",shape=box,color=blue];
		j4147840129 -> j237926472;
	j237926472 [label="Właśnie dlatego z początku cię unikałem. I dlatego wciąż mam... skłonności do pogrążania się w samotności. Brakuje mi słów.",shape=box,color=blue];
		j237926472 -> j4260196300;
		j237926472 -> j4058216918;
		j237926472 -> j1526297770;
	j4260196300 [label="Przy tobie nawet cisza jest dla mnie przyjemna.",shape=box,color=red];
		j4260196300 -> j3984464430;
	j4058216918 [label="Ja też się czasami tak czuję. Nic w tym złego.",shape=box,color=red];
		j4058216918 -> j2090327155;
	j1526297770 [label="Przeprosiny przyjęte.",shape=box,color=red];
		j1526297770 -> j2730656229;
	j3984464430 [label="+15 Chemistry",color=orange];
		j3984464430 -> j74034595;
	j2090327155 [label="+15 Chemistry",color=orange];
		j2090327155 -> j5665359;
	j2730656229 [label="+10 Chemistry",color=orange];
		j2730656229 -> j1123058882;
	j74034595 [label="Zapamiętam to sobie. Dziękuję, Włóczęgo.",shape=box,color=blue];
		j74034595 -> j3651491667;
	j5665359 [label="Nie zdawałem sobie z tego sprawy. Muszę sobie zapamiętać, żeby nie zakładać, że jestem sam na tym świecie... Dziękuję, Włóczęgo.",shape=box,color=blue];
		j5665359 -> j3651491667;
	j1123058882 [label="To dobrze. Dziękuję, Włóczęgo.",shape=box,color=blue];
		j1123058882 -> j3651491667;
	j3651491667 [label="O. Leon Allard",shape=box,color=blue];
		j3651491667 -> "Chat ends.";
}