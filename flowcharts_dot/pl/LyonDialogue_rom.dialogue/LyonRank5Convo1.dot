		j745022599 -> j33930426;
	j2222142111 [label="Wiem. Celowo unikałem tego tematu. Samo jego imię...",shape=box,color=blue];
		j2222142111 -> j4258631663;
	j3154741527 [label="Wiem, że jawnie unikałem tego tematu i przepraszam cię za to. Ale grozi mi to wizją, z której nie jestem pewien, czy szybko się otrząsnę.",shape=box,color=blue];
		j3154741527 -> j3924464485;
	j33930426 [label="Nie martw się, zrobimy to. Wiem, że jawnie unikałem tego tematu i przepraszam cię za to. Ale grozi mi to wizją, z której nie jestem pewien, czy szybko się otrząsnę.",shape=box,color=blue];
