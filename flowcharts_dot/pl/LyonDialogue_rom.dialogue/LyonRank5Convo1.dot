		j3666994298 -> j2044074192;
	j424446243 [label="Wiem, że to okropne brzemię, które musisz dźwigać. I może to wydawać się nie w porządku. Ale nie widzę innego wyjścia.",shape=box,color=red];
		j424446243 -> j1124369398;
	j1528057340 [label="Jesteś dla Marii całym światem. Stałeś się bliskim mi przyjacielem. Sądzę, że nawet Roathe by za tobą tęsknił, choć nie przyzna się do tego.",shape=box,color=red];
		j1528057340 -> j1070787418;
