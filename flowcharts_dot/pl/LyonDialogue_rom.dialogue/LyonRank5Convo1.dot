	j2849948270 [label="Wspomniałeś wcześniej, że chcesz porozmawiać o tym, że tak naprawdę nie wierzę, że Obojętność jest \"prawdziwym bogiem\". Czy to dobry moment na to?",shape=box,color=red];
		j2849948270 -> j266097671;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j2430956122 [label="Ostatnio pytałeś mnie o Urzeczywistnienie Idei i o Obojętność. Czy coś cię trapi?",shape=box,color=red];
		j2430956122 -> j2275780839;
	j2395289569 [label="Roathe jest przekonany, że Pan ze Ściany nie jest prawdziwym bogiem. Że jest produktem \"Urzeczywistnienia Idei\". Co o tym sądzisz?",shape=box,color=red];
		j2395289569 -> j685213342;
	j1570084604 [label="Leonie, co się dzieje między tobą a Roathem? Mam zaledwie szczątkowe informacje na ten temat.",shape=box,color=red];
		j1570084604 -> j2573598645;
	j266097671 [label="Nie jestem pewien, czy jakakolwiek pora jest \"dobrym\" momentem na przedyskutowanie tego namacalnego problemu, Włóczęgo.",shape=box,color=blue];
		j266097671 -> j1246378999;
	"Chat ends." [color=orange];
	j2275780839 [label="Trapi mnie wiele rzeczy, Włóczęgo. Obawiam się, że temat Obojętności i Urzeczywistnienia Idei jest zaledwie jedną z nich.",shape=box,color=blue];
		j2275780839 -> j1136588675;
	j685213342 [label="Problem w tym, Włóczęgo, że nie wiem. Gdybym znał odpowiedź, nie prowadziłbym tej wewnętrznej debaty.",shape=box,color=blue];
		j685213342 -> j1156232987;
	j2573598645 [label="Podsumuję to, choć jestem wstrząśnięty, że unikasz jego tyrad w tej kwestii. Z niebywałą gorliwością dzieli się nimi przy każdej okazji.",shape=box,color=blue];
		j2573598645 -> j1234379204;
	j1246378999 [label="Lecz kierując się tą myślą, teraz jest równie \"dobry\" czas na to, jak każdy inny. Zaintrygowało mnie, że zdajesz się trzymać stronę Roathe'a w swym przekonaniu, że Obojętność nie jest prawdziwym bogiem.",shape=box,color=blue];
		j1246378999 -> j1156232987;
	j1136588675 [label="Albo potencjalnie dwiema, w zależności od tego, jak to interpretujesz. Chociaż przypuszczam, że właśnie to stanowi sedno mojej rozterki.",shape=box,color=blue];
		j1136588675 -> j1156232987;
	j1156232987 [label="Powinienem jednak... zacząć od początku. Nie zrozumiesz, dlaczego akurat ten temat jest dla mnie tak ważny, nie znając kontekstu...",shape=box,color=blue];
		j1156232987 -> j3792729430;
	j1234379204 [label="Uważa, że Obojętność nie jest bogiem Pustki w żadnym znaczeniu tego słowa i że została tak naprawdę stworzona przez Entratiego i wszystkich tych, którzy później się z nią zetknęli.",shape=box,color=blue];
		j1234379204 -> j1065524571;
	j3792729430 [label="Jestem Bratem Lua. Poświęciłem swoje życie, oddając jej cześć. Wierzyłem w to przez całe życie.",shape=box,color=blue];
		j3792729430 -> j285036178;
	j1065524571 [label="Stworzono ją z Pustki poprzez to, co znasz pod pojęciem \"Urzeczywistnieniem Idei\". ",shape=box,color=blue];
		j1065524571 -> j654109713;
	j285036178 [label="I przez te wszystkie lata, odkąd dołączyłem do Kościoła, mocno trzymałem się swej wiary – tego, co stanowiło niewyczerpane źródło wiedzy o moim cierpieniu, bólu i wizjach –",shape=box,color=blue];
		j285036178 -> j1539498825;
	j654109713 [label="Myślę, że w podobny sposób stworzyliście Duviri.",shape=box,color=blue];
		j654109713 -> j1156232987;
	j1539498825 [label="nie szczędziłem, służąc jej. W jej imieniu. I służąc jej celom.",shape=box,color=blue];
		j1539498825 -> j2764893438;
	j2764893438 [label="Tak było... dopóki \"kardynał Dimanche\" nie ujawnił się jako Albrecht Entrati.",shape=box,color=blue];
		j2764893438 -> j2665279091;
	j2665279091 [label="I opowiedział nam prawdę o sobie, historię swoich występków z Pustką i ich następstw. A konkretnie tego, co z niej wyszło.",shape=box,color=blue];
		j2665279091 -> j4231768590;
		j2665279091 -> j2796743258;
	j4231768590 [label="Obojętność.",shape=box,color=red];
		j4231768590 -> j3633089793;
	j2796743258 [label="I co dalej?",shape=box,color=red];
		j2796743258 -> j4183768702;
	j3633089793 [label="Zgadza się. Opowiedział nam tej pogardzie, która go powitała, o palcach, które wyjął z miejsca przypominającego jego laboratorium.",shape=box,color=blue];
		j3633089793 -> j2487323487;
	j4183768702 [label="Opowiedział nam o swoim zejściu do otchłani w dzwonie z seriszkła. O miejscu, które przypominało jego laboratorium. ",shape=box,color=blue];
		j4183768702 -> j2487323487;
	j2487323487 [label="Co więcej, opowiedział nam o wielkim przerażeniu, jakiego doznał, wiedząc, że uwolnił coś, co będzie podążać z nim nie tylko w przestrzeni, ale i w czasie.",shape=box,color=blue];
		j2487323487 -> j1187969297;
	j1187969297 [label="Boga nicości. Istotę, którą trzeba było powstrzymać. Stworzenie, którego miał fragmenty, a które drapałoby ściany, by je uwolnić.",shape=box,color=blue];
		j1187969297 -> j1694715410;
	j1694715410 [label="Straszliwego i niszczycielskiego boga, który był, a zarazem nie był oswobodzony.",shape=box,color=blue];
		j1694715410 -> j1194900038;
		j1694715410 -> j1780642203;
	j1194900038 [label="Co masz na myśli?",shape=box,color=red];
		j1194900038 -> j3826452011;
	j1780642203 [label="\"Był\" a \"zarazem nie był\" oswobodzony?",shape=box,color=red];
