	j4258631663 [label="grozi to...",shape=box,color=blue];
		j4258631663 -> j1617713331;
	j3924464485 [label="Nie chcę po raz kolejny przerywać tej rozmowy tylko dlatego, że nie jestem w stanie jej kontynuować ze względu na własne słabości.",shape=box,color=blue];
		j3924464485 -> j397964380;
