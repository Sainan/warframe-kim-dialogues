	j1070787418 [label="Jesteś otoczony opieką. Jesteś kochany. Masz rodzinę i przyjaciół. Nawet jeśli nie zawsze to odczuwasz.",shape=box,color=red];
		j1070787418 -> j3024140527;
	j2687849886 [label="Ja... Chyba sobie drwisz ze mnie. Nie mówisz tego poważnie, będąc świadkiem tego, co tu przed chwilą zaszło? Albo sam postradałeś rozum, albo współczucie wzięło górę nad rozumem.",shape=box,color=blue];
