		j3826452011 -> j3435297842 [label=false,color=brown];
	j2375656099 [label="Czas jest... splątany, dla kogoś takiego jak ja, w stanie, w jakim się teraz znajduję. Trudno to opisać. Już kiedyś podjąłem marną próbę wyjaśnienia tego i poniosłem sromotną porażkę.",shape=box,color=blue];
		j2375656099 -> j4017877816;
	j3435297842 [label="Czas jest... splątany, dla kogoś takiego jak ja, w stanie, w jakim się teraz znajduję. Trudno to opisać i wcale mi to dobrze nie idzie.",shape=box,color=blue];
		j3435297842 -> j4017877816;
	j4017877816 [label="Wolałbym objaśnić to szczegółowo innym razem, gdyż dzisiaj nie bardzo mi to wychodzi.",shape=box,color=blue];
