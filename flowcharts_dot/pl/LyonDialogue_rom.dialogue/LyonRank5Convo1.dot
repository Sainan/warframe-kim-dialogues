		j397964380 -> j3048249619;
	j3748088331 [label="\"Słabość\" to okropny sposób na określenie kogoś \"nawiedzanego wizjami, o które nie prosił\". Ale jak wolisz.",shape=box,color=red];
		j3748088331 -> j3048249619;
