		j1097881676 -> j3201339919;
	j2335821365 [label="skąpanego we krwi",shape=box,color=blue];
		j2335821365 -> j382469151;
	j3048249619 [label="Doceniam ten gest. Ale dobrze wiem, że nawet w najlepszym wypadku jestem zaledwie rozbitym witrażem. Stoję tu i zastanawiam się, gdzie podziały się brakujące kawałki.",shape=box,color=blue];
		j3048249619 -> j1697646869;
	j3201339919 [label="Dziękuję. Podziwiam twoją cierpliwość. Ale dobrze wiem, że nawet w najlepszym wypadku jestem zaledwie rozbitym witrażem. Stoję tu i zastanawiam się, gdzie podziały się brakujące kawałki.",shape=box,color=blue];
		j3201339919 -> j1697646869;
	j382469151 [label="pozbawionego ścięgien i mięśni",shape=box,color=blue];
		j382469151 -> j2960784315;
	j1697646869 [label="Za każdym razem, gdy znajdę brakujący fragment, wzrasta ryzyko, że skaleczę się jego ostrymi krawędziami, próbując złożyć go na nowo.",shape=box,color=blue];
		j1697646869 -> j1562100716;
