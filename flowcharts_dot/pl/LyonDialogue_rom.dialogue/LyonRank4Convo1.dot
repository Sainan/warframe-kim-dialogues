		663 -> 675 [label="false",color=purple];
	662 [label="Obawiam się, że jest tak wiele tematów, że mogłoby Ci się dłużyć. Ale nie zrozum mnie źle, chętnie to zrobię, po prostu nie chciałbym cię zanudzić na śmierć. Od czego mam zacząć?",shape=box,color=blue];
		662 -> 664;
		662 -> 665;
	675 [label="Nie, bardziej kieruję się ciekawością.",shape=box,color=red];
		675 -> 686;
	676 [label="Jestem pobożny. Moja religia jest podobna do twojej, choć ty byś jej nie uznał.",shape=box,color=red];
		676 -> 687;
	674 [label="Jestem pobożny. Chociaż nie uznałbyś żadnych z naszych praktyk.",shape=box,color=red];
		674 -> 685;
	673 [label="Jestem osobą religijną. Ale to dosyć osobista wiara – nawet nie ma swojej nazwy.",shape=box,color=red];
		673 -> 684;
	672 [label="Podążam ścieżką Sol, tak jak Maria.",shape=box,color=red];
		672 -> 679;
	671 [label="Jestem taki jak ty, podążam ścieżką Lui.",shape=box,color=red];
		671 -> 679;
	666 [label="Podążam za Świetlistymi, ale staram się zachować równowagę.",shape=box,color=red];
		666 -> 679;
	667 [label="Wierzę, że coś tam jest, ale koniec końców nie sądzę, żeby ludzie byli w stanie poznać odpowiedzi.",shape=box,color=red];
		667 -> 680;
	668 [label="Nie jestem osobą religijną. Sądzę, że religia jest podporą dla zlęknionych – bez urazy.",shape=box,color=red];
		668 -> 681;
	669 [label="Nie jestem osobą religijną. Nie twierdzę, że niczego tam nie ma, ale po prostu tym nie przejmuję.",shape=box,color=red];
		669 -> 682;
	670 [label="Nie jestem osobą religijną. Sądzę, że wszyscy bogowie – a nawet Obojętność – są wytworem naszej wyobraźni. Bez urazy.",shape=box,color=red];
		670 -> 683;
	664 [label="Możesz mi opowiedzieć o waszych świętach?",shape=box,color=red];
		664 -> 677;
	665 [label="Możesz mi opowiedzieć o Sol i Lui?",shape=box,color=red];
