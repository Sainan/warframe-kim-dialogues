	699 [label="Update boolean DrifterLiar",color=orange];
		699 -> 710;
	700 [label="Update boolean LyonSuspicious",color=orange];
		700 -> 710;
	701 [label="Zastanawiam się, jak bardzo nasze wiary się przenikały, celowo lub nie, gdyż i tak mogło być.",shape=box,color=blue];
		701 -> 704;
	698 [label="To fascynujące! Jako badacz duchowości mam nadzieję, że w końcu znajdziemy czas, by poznać nasze wzajemne przekonania.",shape=box,color=blue];
		698 -> 704;
	695 [label="To długa historia. ",shape=box,color=red];
		695 -> 707;
	696 [label="Zgłębiałem wiele różnych religii i żadna mi nie odpowiadała. Skończyłem z całkiem dziwną kolekcją przedstawicieli ludzkości.",shape=box,color=red];
		696 -> 708;
	697 [label="Wierzę w to, co czuję. I nie potrzebuję, żeby jakiś budynek lub książki musiały mi to tłumaczyć.",shape=box,color=red];
		697 -> 709;
	690 [label="Doprawdy? Jestem... zaskoczony. Zaskoczony, lecz uradowany. Nic więc dziwnego, że jesteś ciekaw. Nasze nauki z pewnością są już odległe obecnemu stanowi wiedzy. Minęło tyle czasu.",shape=box,color=blue];
		690 -> 704;
	691 [label="Szanuję to. Jest coś zaszczytnego w przyznaniu, że czegoś nie wiemy, w dostrzeżeniu maleńkości ludzkich horyzontów.",shape=box,color=blue];
		691 -> 704;
	692 [label="Możesz mi wierzyć na słowo, że nie czuję urazy. W wielu kwestiach masz dużo racji.",shape=box,color=blue];
		692 -> 705;
		692 -> 706;
	693 [label="Muszę przyznać, że ci zazdroszczę, iż nie martwisz się tym, co może nas czekać po drugiej stronie. Gdyby inni tak czynili, nasz świat zaznałby większego spokoju w moich czasach.",shape=box,color=blue];
		693 -> 704;
	694 [label="To temat, który chciałbym omówić z tobą bardziej szczegółowo. Ale nie teraz, gdy zupełnie nie jestem przygotowany na tego typu dyskusję.",shape=box,color=blue];
		694 -> 704;
	688 [label="To dobry punkt wyjścia. Poznanie kultury przez pryzmat jej świąt jest niczym poznanie jej ducha. Bo sposób, w jaki ludzie świętują, decyduje o tym, jak zostaną zapamiętani. Właśnie te chwile są najcenniejsze dla ludzi, którzy je przeżywają.",shape=box,color=blue];
		688 -> 702;
	689 [label="Oczywiście. Zacznijmy od tego, co być może już znasz: Sol i Lui – słońca i księżyca. To bóstwa, które wiecznie przeobrażają się w swym aspekcie.",shape=box,color=blue];
		689 -> 703;
	710 [label="Hmm. Pozwól, że zaspokoję twoją ciekawość. Nie chcę cię zanudzić na śmierć, więc od czego mam zacząć?",shape=box,color=blue];
		710 -> 665;
		710 -> 664;
	704 [label="A ja mam poczucie winy w związku z tym. Obawiam się, że zbyt daleko odszedłem od głównego tematu.",shape=box,color=blue];
		704 -> 714;
	707 [label="+20 Chemistry",color=orange];
		707 -> 717;
	708 [label="+20 Chemistry",color=orange];
		708 -> 718;
	709 [label="+20 Chemistry",color=orange];
		709 -> 719;
	705 [label="To nie znaczy, że nie chciałbym się dowiedzieć.",shape=box,color=red];
		705 -> 715;
	706 [label="A w kwestii ciebie?",shape=box,color=red];
		706 -> 716;
	702 [label="Naszymi głównymi i najpopularniejszymi świętami są Letnie i Zimowe Przesilenia, które wyznaczają najdłuższy i najkrótszy dzień w roku.",shape=box,color=blue];
		702 -> 711;
	703 [label="Dla licznych wyznawców na przestrzeni wieków objawiali się w różnych formach. Czasami w formie męskiej, czasami żeńskiej. Ale zawsze jako słońce – Sol – i księżyc – Lua.",shape=box,color=blue];
		703 -> 712;
		703 -> 713;
	714 [label="Chciałeś dowiedzieć się czegoś o Kościele Świetlistych. Nie chcę cię zanudzić na śmierć, więc od czego mam zacząć?",shape=box,color=blue];
		714 -> 665;
		714 -> 664;
	717 [label="Mhm. Zapewne taka, którą najlepiej opowiedzieć zaufanemu przyjacielowi. Całkowicie to rozumiem. Poza tym, że to ty przyszedłeś do mnie z informacjami, a nie na odwrót.",shape=box,color=blue];
		717 -> 704;
	718 [label="Witraż duszy. Luzem to zaledwie porozrzucane fragmenty, lecz jakiż piękny obraz tworzy po złożeniu w całość.",shape=box,color=blue];
		718 -> 704;
	719 [label="Świat byłby lepszym miejscem, gdyby podzielał twoją wiarę.",shape=box,color=blue];
		719 -> 704;
	715 [label="I chwała za twą ciekawość i dociekliwość.",shape=box,color=blue];
		715 -> 704;
	716 [label="Mój przypadek jest... złożony. Ale nie będę kłamał, mówiąc, że nie towarzyszył mi lęk. Chociaż religia przyniosła mi ukojenie, to nigdy całkowicie nie ustąpił.",shape=box,color=blue];
		716 -> 704;
	711 [label="Oba święta kojarzą się z wielkimi ucztami, choć ich przebieg zależy od tego, z kim się je dzieli. Zimowe Przesilenie jest świętem, które spędzamy w gronie rodziny i bliskich przyjaciół, a Letnie Przesilenie jest świętem nieznajomych.",shape=box,color=blue];
		711 -> 720;
		711 -> 721;
	712 [label="Och, teraz jest to znacznie bardziej zrozumiałe.",shape=box,color=red];
		712 -> 722;
	713 [label="[Pozwól mu dokończyć]",shape=box,color=red];
		713 -> 723;
	720 [label="Naprawdę? Opowiedz mi więcej o Letnim Przesileniu.",shape=box,color=red];
		720 -> 724;
	721 [label="Opowiedz mi więcej o Zimowym Przesileniu.",shape=box,color=red];
		721 -> 725;
	722 [label="Tak, niektóre odłamy mogą być nieco nadgorliwe w swym wyborze ikonografii, twierdząc, że Sol \"musi\" być taki, albo inny, lecz Kościół nie uznaje tego za konieczne.",shape=box,color=blue];
		722 -> 726;
	723 [label="Każdy ze Świetlistych mieści w sobie wiele aspektów. Każdy aspekt można postrzegać jako funkcję całości. Na przykład Lua jest matką, dziewicą, staruchą.",shape=box,color=blue];
		723 -> 731;
	724 [label="Letnie Przesilenie to czas dzielenia się podarkami i spotykania z obcymi ludźmi. Ludzie zbierają się na świeżym powietrzu, przynosząc prowiant i własnoręcznie wykonane rzeczy, bez względu na okoliczności.",shape=box,color=blue];
		724 -> 728;
	725 [label="Zimowe Przesilenie jest porą, gdy wszyscy stawiają czoła zimnu i doceniają tych, którzy zapewniają nam ciepło w najmroczniejszych chwilach. Drzewka dekoruje się świeczkami – po jednej lampce za każdego, kto odszedł przed nami i wskazuje nam drogę niczym gwiazdy na nocnym niebie.",shape=box,color=blue];
		725 -> 729;
	726 [label="Podejrzewam, że cokolwiek z tego przetrwało do tej odległej przyszłości, mogło okazać się... nieco zagmatwane z powodu sposobu dokumentowania mojej religii.",shape=box,color=blue];
		726 -> 730;
	731 [label="Ale Lua może również stać się tym, kto prowadzi dusze wzdłuż rzeki łez ku wiecznej nocy. Samą śmiercią. Jej zwiastunem i heroldem.",shape=box,color=blue];
		731 -> 734;
	728 [label="Mogą to być świece, pieczywo, odzienie lub malunki. Albo tomiki poezji. Albo wieńce z kwiatów. Nawet przybycie z pustymi rękoma, ale z \"dobrymi nowinami\" należy uznać za błogosławieństwo.",shape=box,color=blue];
		728 -> 732;
	729 [label="A na szczycie zasiada sam Sol, cierpiąc w rozgwieżdżonym drzewie wśród ciemności. Przyćmiony, lecz nie zapomniany. To czas Lui. I czcimy ją w ciemnych chwilach.",shape=box,color=blue];
		729 -> 733;
	730 [label="Czuję się jak chodzące odkrycie archeologiczne. Jakież to przygnębiające. Ale koniec tej dygresji.",shape=box,color=blue];
		730 -> 723;
	734 [label="A w innych odłamach śmierć jest starą kobietą w woalu. Znacznie się to różni. Ale odwołuje się do tego samego ducha, wyciągając rękę po nas wszystkich. Srebrzysta dłoń, która pragnie nas prowadzić w tej ostatniej chwili.",shape=box,color=blue];
		734 -> 737;
	732 [label="Celebracja życia, śmiechu, muzyki – i dzielenie się wszystkim – miały mieć miejsce właśnie w tych najdłuższych dniach Sol. ",shape=box,color=blue];
		732 -> 735;
	733 [label="A gdy zbieramy się do kupy i ucztujemy przy pieczonym ptaku i korzeniowych warzywach, a także tym wszystkim, co nie wyrasta ze zamarzniętej ziemi, mamy u swego boku naszych bliskich. A później opowiadamy historie o tych, których już z nami nie ma.",shape=box,color=blue];
		733 -> 736;
	737 [label="Jest księżycem przysłaniającym słońce podczas zaćmienia, prowadzącym nas przez rozdroża w chwilach, gdy wszystko już przepadło.",shape=box,color=blue];
		737 -> 739;
	735 [label="Każdy zawierał nowe znajomości z obcymi osobami i zabierał do domu to, czego potrzebował.",shape=box,color=blue];
		735 -> 738;
	736 [label="W najdłuższą noc Lui pamiętamy, że to ona poprowadzi nas i naszych bliskich do końca.",shape=box,color=blue];
		736 -> 738;
	739 [label="Update boolean DrifterEclipse",color=orange];
		739 -> 741;
	738 [label="Lecz najświętszym ze świąt dla Świetlistych jest Summum Bonum. Jest to rzadkie wydarzenie, do którego dochodzi, gdy Sol i Lua zbiegają się w całkowitym zaćmieniu.",shape=box,color=blue];
		738 -> 740;
	741 [label="Check boolean VelimirEclipse",color=orange];
		741 -> 744 [label=true,color=green];
		741 -> 743 [label=false,color=brown];
	740 [label="To cudowne i święte wydarzenie, na które reaguje cała natura. Miałeś takie szczęście, by go doświadczyć?",shape=box,color=blue];
		740 -> 742;
	744 [label="Chwila...",shape=box,color=red];
		744 -> 747;
	743 [label="Widziałeś kiedyś zaćmienie na własne oczy?",shape=box,color=red];
		743 -> 746;
	742 [label="Update boolean DrifterEclipse",color=orange];
		742 -> 745;
	747 [label="To brzmi... znajomo.",shape=box,color=red];
		747 -> 755;
	746 [label="Dwukrotnie miałem szczęście być tego świadkiem. I za każdym razem było to dla mnie... odmieniającym doświadczeniem. Gdybym mógł zatrzymać się w tamtej chwili, zawieszony na zawsze, zrobiłbym to.",shape=box,color=blue];
		746 -> 754;
	745 [label="Evaluate expressions",color=orange];
		745 -> 748 [label="Megrim",color=purple];
		745 -> 749 [label="Megrim",color=purple];
		745 -> 750 [label="Megrim",color=purple];
		745 -> 751 [label="Megrim",color=purple];
		745 -> 753 [label="Megrim",color=purple];
		745 -> 748 [label="Migraine",color=purple];
		745 -> 749 [label="Migraine",color=purple];
		745 -> 750 [label="Migraine",color=purple];
		745 -> 751 [label="Migraine",color=purple];
		745 -> 752 [label="Migraine",color=purple];
		745 -> 748 [label="false",color=purple];
		745 -> 749 [label="false",color=purple];
		745 -> 750 [label="false",color=purple];
		745 -> 751 [label="false",color=purple];
	755 [label="Co masz na myśli?",shape=box,color=blue];
		755 -> 760;
	754 [label="Innym razem opowiem ci, jak doświadczyłem pierwszego zaćmienia. Zrobiło się późno. A w zasadzie wcześnie. Trudno to określić.",shape=box,color=blue];
		754 -> 759;
	748 [label="Nie miałem.",shape=box,color=red];
		748 -> 756;
	749 [label="Miałem. To nie było tak imponujące.",shape=box,color=red];
		749 -> 757;
	750 [label="Miałem i było w porządku.",shape=box,color=red];
		750 -> 757;
	751 [label="Miałem. Było niesamowite.",shape=box,color=red];
		751 -> 746;
	753 [label="Miałem. Możesz mi wierzyć lub nie, ale dostałem okropnej migreny ocznej. Ale warto było.",shape=box,color=red];
		753 -> 758;
	752 [label="Miałem. Możesz mi wierzyć lub nie, ale dostałem okropnej migreny ocznej. Ale warto było.",shape=box,color=red];
		752 -> 758;
	760 [label="Pewnie słyszałeś to powiedzenie: \"Na rozstaju dróg, podążaj za zaćmieniem – kiedy Sol i Lua zejdą się, zagubieni odnajdą drogę do domu\".",shape=box,color=red];
		760 -> 764;
	759 [label="Update boolean LyonFirstEclipse",color=orange];
		759 -> 762;
		759 -> 763;
	756 [label="To zrób to, jeśli tylko będziesz mieć okazję.",shape=box,color=blue];
		756 -> 746;
	757 [label="Chciałbym móc podzielać twoją obojętność wobec tego wydarzenia...",shape=box,color=blue];
		757 -> 746;
	758 [label="Zapewne dotknęli cię Świetliści, a ich obecność cię przytłoczyła. A może chcieli cię ukarać za jakiś ciężki grzech. A może i jedno i drugie. He, he.",shape=box,color=blue];
		758 -> 761;
	764 [label="Celestyni 18:19, z Trzeciej Księgi Kościoła Lua. Na Świetlistych, gdzie to usłyszałeś?",shape=box,color=blue];
		764 -> 767;
		764 -> 768;
	762 [label="Jasne, gdy tylko będziesz gotowy.",shape=box,color=red];
		762 -> 765;
	763 [label="Nie mogę się doczekać. Dziękuję za poświęcony mi czas, Leonie.",shape=box,color=red];
		763 -> 766;
	761 [label="Taka jest natura bogów. Ich znaki często można interpretować wieloznacznie.",shape=box,color=blue];
		761 -> 754;
	767 [label="To bardzo długa historia. Ale nie muszę chyba dodawać, że część twojego pisma jest teraz przesiąknięta Obojętnością.",shape=box,color=red];
		767 -> 770;
	768 [label="Od starych znajomych. Używali tego jako dwóch połówek szpiegowskiego hasła w rozmowie z ich córką, która... w zasadzie to nie jest ważne.",shape=box,color=red];
		768 -> 771;
	765 [label="+5 Chemistry",color=orange];
		765 -> 769;
	766 [label="+5 Chemistry",color=orange];
		766 -> 769;
	770 [label="Update boolean LyonMITWNeci",color=orange];
		770 -> 773;
	771 [label="Dotyczy to Pana ze Ściany i jest strasznie zagmatwane.",shape=box,color=red];
		771 -> 770;
	769 [label="Tak, no cóż. Co się odwlecze to nie uciecze. ",shape=box,color=blue];
		769 -> 772;
	773 [label="Ja... rozumiem. Chciałbym wkrótce cię o to dopytać, jeśli nie masz nic przeciwko. Po prostu nie jestem teraz na to przygotowany, i zrobiło się dosyć późno. A może wcześnie. Trudno to określić.",shape=box,color=blue];
		773 -> 775;
		773 -> 776;
