		j3287457751 -> j1339019900 [label="DrifterFaithNoMITW",color=purple];
		j3287457751 -> j2569442424 [label="DrifterFaithNoMaybe",color=purple];
		j3287457751 -> j3085057789 [label="false",color=purple];
	j4250961830 [label="Podczas gdy Sol ukoiłby ból, niczym rozgrzany nóż zasklepiający ranę – Lua chciałaby, żebym przyjął ciepło bólu spowodowane jego utratą.",shape=box,color=blue];
		j4250961830 -> j1223392733;
	j2254700650 [label="I wiem, że gdybym nadal mógł odnaleźć obecność Rella i jego Harrowa, nie chcieliby, żebym cierpiał z powodu ich utraty. Znaleźli spokój.",shape=box,color=blue];
		j2254700650 -> j2992270568;
	j4097600307 [label="Och, Leonie... tyle musiałeś przejść. Zwątpienie nie wynika ze słabości – zwątpienie wynika z bólu.",shape=box,color=red];
		j4097600307 -> j713535388;
		j4097600307 -> j2945104373;
		j4097600307 -> j1678187461;
		j4097600307 -> j2478419157;
		j4097600307 -> j3607299248;
	j85002475 [label="Wiara nie musi być stała – i nikt tego nie oczekuje. Ileż to opowieści krąży o ludziach, którzy zatracili wiarę tylko po to, by ją później odzyskać?",shape=box,color=red];
		j85002475 -> j713535388;
		j85002475 -> j2945104373;
		j85002475 -> j1678187461;
	j3743960640 [label="Poświęciłeś swoje życie posłudze naszym Świetlistym, Leonie. Sądzisz, że odwróciliby się od ciebie za taki czyn?",shape=box,color=red];
		j3743960640 -> j713535388;
		j3743960640 -> j2945104373;
		j3743960640 -> j1678187461;
	j1487690032 [label="Nie wiem, czy bogowie istnieją, czy nie, Leonie. I sądzę, że nikt z nas się tego tak naprawdę nie dowie. Ale dobrze wiem, przez co musiałeś przejść.",shape=box,color=red];
		j1487690032 -> j713535388;
		j1487690032 -> j1678187461;
		j1487690032 -> j2478419157;
	j2569442424 [label="Choć sam nie wierzę, by na tym świecie istnieli bogowie, to zdaję sobie sprawę, jak to było dla ciebie ważne. Nie zamierzam temu umniejszać.",shape=box,color=red];
		j2569442424 -> j1678187461;
		j2569442424 -> j3607299248;
	j1339019900 [label="To my stworzyliśmy Obojętność – ona nie jest bogiem, Leonie. Nie pozwól, by błąd Entratiego cię zniszczył. Co z twoją wiarą?",shape=box,color=red];
		j1339019900 -> j1678187461;
		j1339019900 -> j3607299248;
	j3085057789 [label="Nie mogę patrzeć, gdy jesteś w takim stanie. Uwięziony w samym środku absurdalnej sytuacji. Nie zasłużyłeś na to.",shape=box,color=red];
		j3085057789 -> j713535388;
		j3085057789 -> j2945104373;
		j3085057789 -> j1678187461;
		j3085057789 -> j2478419157;
		j3085057789 -> j3607299248;
	j1223392733 [label="Gdyż to właśnie brak bólu grozi naszym zniszczeniem, tak jak jego nadmiar może nas pochłonąć.",shape=box,color=blue];
		j1223392733 -> j1725819543;
		j1223392733 -> j1326885738;
		j1223392733 -> j322178720;
	j2992270568 [label="Nie wierzę też, że moje całe cierpienie było po nic. To nie unieważnia tego wszystkiego, przez co przeszedłem.",shape=box,color=blue];
		j2992270568 -> j1277708390;
	j713535388 [label="Nie twierdzę, że musisz odzyskać wiarę. Mówię tylko, że jeśli chcesz – jeśli czujesz taką potrzebę – to zawsze możesz ją odzyskać.",shape=box,color=red];
		j713535388 -> j850899081;
	j2945104373 [label="Lua z pewnością widzi, przez co musiałeś przejść. Co wycierpiałeś w jej imieniu. ",shape=box,color=red];
		j2945104373 -> j4084448464;
	j1678187461 [label="Myślę, że musisz się skupić na znalezieniu wewnętrznego spokoju – czymkolwiek jest, to musisz go znaleźć.",shape=box,color=red];
		j1678187461 -> j850899081;
	j2478419157 [label="Jeśli bóg istnieje, jeśli twoja Lua istnieje – z pewnością widzi, przez co musisz przechodzić. Co musisz znosić w jej imieniu. To z pewnością ma znaczenie.",shape=box,color=red];
		j2478419157 -> j4084448464;
	j3607299248 [label="Sądzę, że w pierwszej kolejności powinieneś porzucić wszelkie wyobrażenia o istnieniu bogów i skupić się na uzdrowieniu samego siebie.",shape=box,color=red];
		j3607299248 -> j4258944335;
	j1725819543 [label="Zaufaj mi... Dobrze wiem, jak niebezpieczna może być apatia.",shape=box,color=red];
		j1725819543 -> j796802746;
	j1326885738 [label="Czy to oznacza, że odnalazłeś swoją wiarę?",shape=box,color=red];
		j1326885738 -> j2133138890;
	j322178720 [label="[Koniec]",shape=box,color=red];
		j322178720 -> j3856020424;
	j1277708390 [label="Gdyż to właśnie brak bólu grozi naszym zniszczeniem, tak jak jego nadmiar może nas pochłonąć.",shape=box,color=blue];
		j1277708390 -> j1725819543;
		j1277708390 -> j2359272733;
