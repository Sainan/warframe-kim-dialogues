		j2359272733 -> j2133138890;
	j3247202166 [label="Zastanawiam się nad znaczeniem tej nieubłaganej obecności Rella i Harrowa w moim życiu...",shape=box,color=blue];
		j3247202166 -> j1181937853;
	j3761599234 [label="Myślę o tych wszystkich latach służby w organizacji, która z założenia miała czynić dobro na świecie... jakie jest znaczenie tej nieubłaganej obecności Rella i Harrowa w moim życiu...",shape=box,color=blue];
		j3761599234 -> j1383808976;
	j3647490820 [label="Zastanawiam się nad znaczeniem tej nieubłaganej obecności Rella i Harrowa w moim życiu...",shape=box,color=blue];
		j3647490820 -> j3724440328;
	j1521284970 [label="Nie wiem, czy w kwestii wiary ktoś taki jak ja może powiedzieć, że coś \"znalazł\" albo \"stracił\", ale zamiast tego wiecznie czegoś szuka. Wiecznie pyta, gdyż wiecznie poszukuje odpowiedzi.",shape=box,color=blue];
		j1521284970 -> j2337628554;
	j2337628554 [label="Ale sądzę, że podobnie jak w przypadku bólu, trzeba znaleźć równowagę, dzięki której nie damy mu się pochłonąć, ani nie uodpornimy się na niego i nie staniemy się otępiali.",shape=box,color=blue];
		j2337628554 -> j1286686499;
	j1181937853 [label="Tylko po to, by ich obecność znów zniknęła z mojej duszy, pozostając zaledwie wspomnieniem. A ja już sam nie wiem, czy to oznacza, że bogowie istnieją czy nie.",shape=box,color=blue];
		j1181937853 -> j835819455;
	j1383808976 [label="Tylko po to, by ich obecność znów zniknęła z mojej duszy, pozostając zaledwie wspomnieniem. I jak to niby mogło stanowić dar od Lua...",shape=box,color=blue];
		j1383808976 -> j656435051;
	j3724440328 [label="Tylko po to, by ich obecność znów zniknęła z mojej duszy, pozostając zaledwie wspomnieniem. I masz rację. Może to oznaczać, że bogowie nie istnieją.",shape=box,color=blue];
