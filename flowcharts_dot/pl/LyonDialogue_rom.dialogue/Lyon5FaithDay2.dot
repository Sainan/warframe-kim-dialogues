	j656435051 [label="Może masz rację. Możliwe, że nasza srebrna pani mogłaby jedynie udzielić nam tak tragicznego błogosławieństwa. Nie chciałaby wymazać wspomnień bólu, zupełnie jak w przypadku Roathe'a.",shape=box,color=blue];
		j656435051 -> j1962275506;
	j83479910 [label="Zgadzasz się z Roathem i ze mną, że Pan ze Ściany nie jest prawdziwym bogiem?",shape=box,color=red];
		j83479910 -> j3009938192;
	j1782056698 [label="A gdzie w tym wszystkim plasuje się Obojętność?",shape=box,color=red];
		j1782056698 -> j2049842986;
	j2000169208 [label="Zgadzasz się z Roathem co do tego, że Obojętność jest prawdziwym bogiem, czy nie?",shape=box,color=red];
		j2000169208 -> j3009938192;
	j3009938192 [label="Nie zająłem stanowiska w tej sprawie. Nie mam wystarczających dowodów, żeby podjąć decyzję. Ale to chyba niewiele zmienia, prawda?",shape=box,color=blue];
		j3009938192 -> j2850484854;
		j3009938192 -> j2128906246;
	j2049842986 [label="Bez względu na to, czy Obojętność jest bogiem czy nie, nie zająłem stanowiska w tej sprawie. Nie mam wystarczających dowodów, żeby podjąć decyzję. Ale to chyba niewiele zmienia, prawda?",shape=box,color=blue];
		j2049842986 -> j2850484854;
		j2049842986 -> j2128906246;
	j2850484854 [label="Sądzę, że to wiele zmienia. Jeśli nie jest to prawdziwy bóg, to stworzyli go ludzie. A to oznacza, że ludzie mogą go pokonać.",shape=box,color=red];
		j2850484854 -> j3334014248;
	j2128906246 [label="Co masz na myśli?",shape=box,color=red];
		j2128906246 -> j1444047322;
	j3334014248 [label="Skoro nie miałeś złudzeń, że nasze działania są w stanie ją pokonać, to po co w ogóle walczyć? Jesteś pełen zagadek.",shape=box,color=blue];
		j3334014248 -> j3639368550;
	j1444047322 [label="Sposób, w jaki przybyła do naszego wszechświata nie wpływa na to, w jaki sposób moglibyśmy się jej pozbyć.",shape=box,color=blue];
		j1444047322 -> j4111118255;
	j3639368550 [label="Chyba nie masz na myśli tych słów. Czy po prostu podporządkowujesz się działaniom innych? Walczysz z nią, bo nie masz ciekawszego zajęcia?",shape=box,color=blue];
		j3639368550 -> j3944370059;
	j4111118255 [label="Oto bóg, którego stworzyliśmy, uszyty z materii naszej własnej pustki.",shape=box,color=blue];
		j4111118255 -> j1107100601;
	j3944370059 [label="Z pewnością jesteś w stanie znaleźć sobie lepsze zajęcie.",shape=box,color=blue];
		j3944370059 -> j838507211;
		j3944370059 -> j2465930640;
	j1107100601 [label="Szmaciana lalka, którą możemy wypełnić naszym smutkiem, żalem, bólem, złością i cierpieniem, aż zacznie pękać w szwach.",shape=box,color=blue];
		j1107100601 -> j4042916560;
	j838507211 [label="Nie sądzę, żeby to było bezcelowe – nie to miałem na myśli.",shape=box,color=red];
		j838507211 -> j2843391789;
	j2465930640 [label="Chodzi mi o to, że to zmienia nasze postrzeganie jego uśmiercenia. Pozwala nam je zrozumieć.",shape=box,color=red];
		j2465930640 -> j2972685152;
	j4042916560 [label="Wybacz mi, jeśli stwierdzę, że napawa mnie to znacznie większym przerażeniem, niż gdyby ten bóg przybył przed nami. ",shape=box,color=blue];
		j4042916560 -> j4196321547;
	j2843391789 [label="Myślenie przed posłaniem słów w świat nie jest obowiązkowe. Tak jak w wypadku pocisków. ",shape=box,color=blue];
		j2843391789 -> j4111118255;
	j2972685152 [label="Nie sądzę, żeby to było prawdą. Powiedziałbym, że wiemy teraz o jego motywacji równie mało, jakby był jakimś \"wielkim i nieznanym bogiem\".",shape=box,color=blue];
		j2972685152 -> j4111118255;
	j4196321547 [label="Tak, w zasadzie to wolę tę myśl.",shape=box,color=blue];
		j4196321547 -> j3507329190;
	j3507329190 [label="Można mieć nadzieję, że byłby bardziej inteligentny od całej ludzkości.",shape=box,color=blue];
		j3507329190 -> j2715890004;
	j2715890004 [label="I z tą... niezwykle ponurą myślą, zostawię cię na dziś.",shape=box,color=blue];
		j2715890004 -> j742749064;
	j742749064 [label="Check boolean LyonDating",color=orange];
