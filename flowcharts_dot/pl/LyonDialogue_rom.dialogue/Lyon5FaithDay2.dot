		j4258944335 -> j3647490820;
	j796802746 [label="Na to wygląda. ",shape=box,color=blue];
		j796802746 -> j1521284970;
	j2133138890 [label="Trudno powiedzieć. Nie wiem, czy ktoś taki jak ja może powiedzieć, że coś \"znalazł\" albo \"stracił\", czy też wiecznie czegoś szuka. Wiecznie pyta, gdyż wiecznie poszukuje odpowiedzi.",shape=box,color=blue];
		j2133138890 -> j2337628554;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
