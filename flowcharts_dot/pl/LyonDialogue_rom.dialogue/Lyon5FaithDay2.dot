		j3689649944 -> j2089770573;
	j640982062 [label="Jest coś, o czym chciałem ci powiedzieć, ale dopiero teraz nadarzyła się okazja. Gdy... losy Rella, Harrowa i moje zostały splątane – bez znaczenia, jak i dlaczego –",shape=box,color=blue];
		j640982062 -> j2410169292;
	"Chat ends." [color=orange];
	j81123376 [label="Tylko po to, by ich obecność znów zniknęła z mojej duszy, pozostając zaledwie wspomnieniem. I jak to niby mogło stanowić dar od Lua...",shape=box,color=blue];
		j81123376 -> j2268041864;
	j1307926828 [label="Tylko po to, by ich obecność znów zniknęła z mojej duszy, pozostając zaledwie wspomnieniem. I masz rację. Może to oznaczać, że bogowie nie istnieją.",shape=box,color=blue];
		j1307926828 -> j3103247835;
	j2089770573 [label="Tylko po to, by ich obecność znów zniknęła z mojej duszy, pozostając zaledwie wspomnieniem. A ja już sam nie wiem, czy to oznacza, że bogowie istnieją czy nie.",shape=box,color=blue];
		j2089770573 -> j835819455;
	j2410169292 [label="Zaplątałem się w ich przeszłości tak samo, jak oni w mojej. Widziałem Zarimana Ten Zero, przebłyski Starej Wojny, a oni w ten sam sposób zobaczyli całą moją przeszłość.",shape=box,color=blue];
		j2410169292 -> j2601001251;
	j2268041864 [label="Uświadomiłem sobie, że nasza srebrna pani mogłaby udzielić nam tak tragicznego błogosławieństwa. Nie chciałaby wymazać wspomnień bólu, zupełnie jak w przypadku Roathe'a.",shape=box,color=blue];
		j2268041864 -> j1962275506;
	j3103247835 [label="Sądzę jednak, że nie przekreśla to lat służby w organizacji, która z założenia miała czynić dobro na świecie.",shape=box,color=blue];
		j3103247835 -> j3721272906;
	j835819455 [label="Tak jak powiedziałeś, możemy... nigdy się tego nie dowiedzieć. I może nie będzie nam dane się o tym przekonać. Taka jest kolej rzeczy. Sądzę jednak, że nie przekreśla to lat służby w organizacji, która z założenia miała czynić dobro na świecie.",shape=box,color=blue];
		j835819455 -> j3721272906;
	j2601001251 [label="To... poddało w wątpliwości wiele rzeczy, a mianowicie... moją wiarę. Załamała się i rozpadła na kawałki. Niczym zwęglony papier, obróciła się w pył. Nienawidzę siebie za tę słabość...",shape=box,color=blue];
		j2601001251 -> j3287457751;
	j1962275506 [label="Nigdy też nie zdjęłaby piętna bicza z mojej skóry. Z pewnością nie jest to sposób, w jaki chciałaby mnie uchronić przed żalem wywołanym jego odejściem.",shape=box,color=blue];
		j1962275506 -> j4250961830;
	j3721272906 [label="Pomagając tym, którzy chcą złagodzić ból w swoim życiu w chwili, gdy mógłby ich pochłonąć.",shape=box,color=blue];
		j3721272906 -> j2254700650;
	j3287457751 [label="Evaluate expressions",color=orange];
		j3287457751 -> j4097600307 [label="LyonDating",color=purple];
		j3287457751 -> j85002475 [label="DrifterFaithYesSimilar",color=purple];
