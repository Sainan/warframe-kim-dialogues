		j1316396836 -> "Chat ends." [label=false,color=brown];
	j831805876 [label="Chciałbym pokrótce omówić z tobą pewną kwestię, co z pewnością zapewni naszej dwójce spokój ducha, mon miracle.",shape=box,color=blue];
		j831805876 -> j2690647486;
		j831805876 -> j3228077126;
	j2690647486 [label="[Koniec]",shape=box,color=red];
		j2690647486 -> j3944516755;
	j3228077126 [label="Coś się stało?",shape=box,color=red];
		j3228077126 -> j2270071981;
	j3944516755 [label="Boolean LyonConsentComplete is now true.",color=orange];
		j3944516755 -> "Chat ends.";
	j2270071981 [label="Nie, nic takiego. Chciałem powiedzieć tylko, że wiem... że spędzasz czas z kimś innym, kiedy nie jesteś przy mnie.",shape=box,color=blue];
		j2270071981 -> j2873422662;
	j2873422662 [label="Pragnąłem zapewnić cię, że nie sprawia mi to lęku ani przykrości. Twoja obecność zapewniła mi samą radość i ukojenie...",shape=box,color=blue];
		j2873422662 -> j4146169353;
	j4146169353 [label="Jak mógłbym odmówić komukolwiek innemu takiego daru?",shape=box,color=blue];
		j4146169353 -> j555987847;
		j4146169353 -> j2047220554;
	j555987847 [label="Myślę, że też by się w tobie zakochali.",shape=box,color=red];
		j555987847 -> j2749030385;
	j2047220554 [label="Dziękuję, to wiele dla mnie znaczy.",shape=box,color=red];
		j2047220554 -> j2902887110;
	j2749030385 [label="Uśmiecham się na tę myśl. Może kiedyś, innego dnia, w innym życiu, będzie nam dane się spotkać. ",shape=box,color=blue];
		j2749030385 -> j3240104597;
	j2902887110 [label="Jesteśmy... jestem spełniony, dzięki temu wszystkiemu, co mi przynieśliście, co sobą reprezentujemy... Nie... jestem szczęśliwy. Po raz pierwszy od bardzo dawna.",shape=box,color=blue];
		j2902887110 -> j1477595300;
	j3240104597 [label="Ale nie teraz, jestem zadowolony z tego, gdzie jestem. Nie... jestem szczęśliwy. Po raz pierwszy od dawna.",shape=box,color=blue];
		j3240104597 -> j1477595300;
	j1477595300 [label="I chciałem ci za to podziękować. Do później, mon miracle.",shape=box,color=blue];
		j1477595300 -> j1353685350;
	j1353685350 [label="Leon",shape=box,color=blue];
		j1353685350 -> j3944516755;
}