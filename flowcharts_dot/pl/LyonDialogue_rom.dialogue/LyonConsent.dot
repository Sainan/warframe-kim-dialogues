	"Chat ends." [color=orange];
	j1181132753 [label="Check boolean LyonConsentComplete",color=orange];
		j1181132753 -> "Chat ends." [label=true,color=green];
		j1181132753 -> j2714890705 [label=false,color=brown];
	j1316396836 [label="Check boolean LyonPolyamorySuccess",color=orange];
		j1316396836 -> j1181132753 [label=true,color=green];
		j1316396836 -> "Chat ends." [label=false,color=brown];
	j2714890705 [label="I wish, if I may, to discuss something briefly that I think would put both of our minds at ease, mon miracle.",shape=box,color=blue];
		j2714890705 -> j2690647486;
		j2714890705 -> j1924426120;
	j2690647486 [label="[Koniec]",shape=box,color=red];
		j2690647486 -> j3944516755;
	j1924426120 [label="Coś się stało?",shape=box,color=red];
		j1924426120 -> j4181882624;
	j3944516755 [label="Boolean LyonConsentComplete is now true.",color=orange];
		j3944516755 -> "Chat ends.";
	j4181882624 [label="No, nothing is the matter. I simply wished to say that I know you spend time with another in a... amorous way, when you are not with me.",shape=box,color=blue];
		j4181882624 -> j392826153;
	j392826153 [label="And I simply wished to assure you that this does not give me pause nor unease. Your presence in my life has brought me nothing but peace, nothing but joy...",shape=box,color=blue];
		j392826153 -> j3316743480;
	j3316743480 [label="And how could I ever deny that kind of gift to be bestowed upon another?",shape=box,color=blue];
		j3316743480 -> j2848381733;
		j3316743480 -> j3012628740;
	j2848381733 [label="I do think they would adore you, for what it's worth.",shape=box,color=red];
		j2848381733 -> j2509417307;
	j3012628740 [label="Thank you. That means a lot to me.",shape=box,color=red];
		j3012628740 -> j3838649855;
	j2509417307 [label="The thought of it makes me smile. And who knows, perhaps in another life, or another day, we may meet. ",shape=box,color=blue];
		j2509417307 -> j2985365446;
	j3838649855 [label="As we are - as I am, with all you have brought me, all that we represent... I am content. Nay, I am... happy. For the first time in a very, very long time.",shape=box,color=blue];
		j3838649855 -> j834663341;
	j2985365446 [label="But in this one, I am content as we are. Nay, I am... happy. For the first time in a very, very long time.",shape=box,color=blue];
		j2985365446 -> j834663341;
	j834663341 [label="And I have you to thank for it. For now, however, I bid you farewell.",shape=box,color=blue];
		j834663341 -> j1353685350;
	j1353685350 [label="Leon",shape=box,color=blue];
		j1353685350 -> j3944516755;
}