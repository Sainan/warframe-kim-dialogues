digraph {
	781 [label="LyonRank4Convo2 begins.",color=orange];
		781 -> 782;
		781 -> 783;
		781 -> 784;
	782 [label="Jak to możliwe, że ty i Maria potraficie pogodzić duchowieństwo z... dopuszczaniem się aktów przemocy?",shape=box,color=red];
		782 -> 785;
		782 -> 786;
		782 -> 787;
	783 [label="Mogę zadać ci trochę dziwne pytanie, Leonie?",shape=box,color=red];
		783 -> 788;
	784 [label="[Koniec]",shape=box,color=red];
		784 -> 789;
	785 [label="Słyszę, jak Maria krzyczy \"païens!\" i rzuca się do walki, i… a jednak trudno mi uwierzyć, że jest osobą, która potępia kogoś za odmienne poglądy. Nie mogę sobie wyobrazić, żebyś ty też się aż tak bardzo różnił. Ona ma o tobie tak wysokie mniemanie.",shape=box,color=red];
		785 -> 790;
	786 [label="Jak twój kościół zareagowałby na to, co ty i Maria robicie? Na to... o co jesteście proszeni w ich imieniu?",shape=box,color=red];
		786 -> 791;
	787 [label="Przyglądam się tobie i Marii na polu bitwy, a potem rozmawiam z nią prywatnie, widzę, jak w ciszy czytacie książki... i chyba mam problem z identyfikowaniem tych indywidualności w mojej głowie.",shape=box,color=red];
	788 [label="Jeśli uważasz, że nasza obecna sytuacja jest dla ciebie po prostu \"dziwna\", to albo jestem pod wrażeniem twojego zahartowania, albo zaniepokojony twoim brakiem słownictwa. Podejrzewam jednak, że chodzi o to pierwsze.",shape=box,color=blue];
		788 -> 793;
	789 [label="Chat ends.",color=orange];
	790 [label="Masz całkowitą rację. Maria nie jest osobą, która potępia innych za trzymanie w sercu starożytnego boga drzew – zamiast tego stara się odkryć, jakie przekonania łączą ją z daną osobą.",shape=box,color=blue];
		790 -> 794;
	791 [label="W tamtych czasach toczono święte wojny w imię Sol i Lui. Krwawe \"krucjaty\", których celem było wyparcie \"pogan\", \"zajęcie świętej ziemi\" – albo jakiekolwiek inne uzasadnienia – były wtedy częste.",shape=box,color=blue];
		791 -> 795;
	793 [label="+5 Chemistry",color=orange];
		793 -> 797;
	794 [label="Czy drzewo nie może się nasycić światłem Sol? Czy nie ma wspólnej przestrzeni, która mogłaby ich połączyć? Jest bardziej skłonna usiąść i wysłuchać ich opowieści, niż próbować zaszkodzić ich wierze.",shape=box,color=blue];
		794 -> 798;
	795 [label="Kościół Świetlistych nie ma armii i nie prowadzi wojen. Jednak nie zabrania swoim wyznawcom podejmowania działań ani chronienia innych.",shape=box,color=blue];
		795 -> 727;
	797 [label="Ale oczywiście, kontynuuj. Nie możesz sprawić, żeby to było dla mnie jeszcze bardziej \"dziwne\", pytając o to, co cię intryguje.",shape=box,color=blue];
		797 -> 785;
		797 -> 786;
		797 -> 787;
	798 [label="Kiedy ona walczy z wrogiem na polu bitwy, myślę, że dzieje się jedna z tych rzeczy: albo bawi się, odgrywając rolę uczestniczki pradawnej krucjaty, wyobrażając sobie swą postać w lśniącej zbroi rycerza Sol...",shape=box,color=blue];
		798 -> 796;
	727 [label="When Marie engages with her foes upon the battlefield, I believe it is one of two things: either, she is having a bit of fun, play-acting as an ancient crusader, imagining herself in the shining armor of a Knight of Sol -",shape=box,color=blue];
		727 -> 796;
	796 [label="Albo, co bardziej prawdopodobne, przypomina sobie Astafora 8:23 \"Samotne są dusze, które pragną wedrzeć się do mego domu siłą, bo to one zostały pozbawione światła Sol\".",shape=box,color=blue];
		796 -> 799;
	799 [label="W jej oczach przemoc, której się dopuszcza, jest słuszna i służy obronie większego dobra. Zakładam, że ty i osoby walczące u twego boku zrobilibyście tak samo.",shape=box,color=blue];
		799 -> 800;
	800 [label="Dlatego ci, z którymi walczy, niezależnie od ich religii, są wygnańcami Sol. Nawet gdyby nosili święte szaty jej własnego zakonu, w jej oczach nadal są poganami.",shape=box,color=blue];
		800 -> 801;
		800 -> 802;
	801 [label="Zauważyłem, że starasz się w to nie mieszać. Co ty czujesz w związku z tą całą walką?",shape=box,color=red];
		801 -> 803;
	802 [label="To ma sens. Dziękuję.",shape=box,color=red];
		802 -> 804;
	803 [label="Celowo tego unikam, Wysłanniku.",shape=box,color=blue];
		803 -> 805;
		803 -> 806;
	804 [label="+5 Chemistry",color=orange];
		804 -> 807;
	805 [label="A ja celowo o to pytam, Ojcze.",shape=box,color=red];
		805 -> 808;
	806 [label="No dobrze. Musi mi na dzisiaj wystarczyć to, co już mam.",shape=box,color=red];
		806 -> 804;
	807 [label="Jeśli to ma jakieś znaczenie, Maria... powiedziała mi, że chcesz dobrze. A ja jej wierzę, nawet jeśli nie wierzę sam sobie.",shape=box,color=blue];
		807 -> 809;
	808 [label="+10 Chemistry",color=orange];
		808 -> 810;
	809 [label="Mogę zaledwie prosić cię o cierpliwość. Lua dobrze wie, że często mi jej brakuje.",shape=box,color=blue];
		809 -> 811;
	810 [label="Niech będzie. Skoro cię to nie zniechęca i w dalszym ciągu jesteś ciekaw... Aż tak bardzo nie strofuję się śmiercią, którą zadaję... jak mógłbyś tego oczekiwać.",shape=box,color=blue];
		810 -> 812;
	811 [label="O. Leon Allard",shape=box,color=blue];
		811 -> 813;
	812 [label="Albo, że ktoś mógłby uznać to za \"niestosowne\" dla duchownego i uczonego mojego pokroju.",shape=box,color=blue];
		812 -> 814;
		812 -> 815;
	813 [label="Chat ends.",color=orange];
	814 [label="W życiu zaznałem więcej wojen niż spokoju, Leonie. Gdybym pozwolił, by mnie to dręczyło, to raczej by mnie tu nie było. Ale nie oznacza to, że nie wiąże się to z prawdziwym ciężarem – który stanowi koszt tego wszystkiego.",shape=box,color=red];
		814 -> 816;
	815 [label="Jestem pewien, że inni powiedzieli ci, kim jestem. Czym jestem. Skąd pochodzę. O śmierci, która za mną podąża i przed którą uciekam. Śmierć mnie definiuje. Sądzisz, że twoje uczucia są w stanie mnie zaskoczyć?",shape=box,color=red];
		815 -> 817;
	816 [label="Add 1 to Thermostat",color=orange];
		816 -> 818;
	817 [label="Add -1 to Thermostat",color=orange];
		817 -> 819;
	818 [label="Tak sądzę.",shape=box,color=blue];
		818 -> 820;
		818 -> 821;
	819 [label="To prawda.",shape=box,color=blue];
		819 -> 820;
		819 -> 821;
	820 [label="Przepraszam. Czuję, że cię zdenerwowałem. Nie miałem takiego zamiaru.",shape=box,color=red];
		820 -> 822;
	821 [label="Czy możesz... rozwinąć tę myśl?",shape=box,color=red];
		821 -> 823;
	822 [label="Nie obwiniaj się, Włóczęgo. Jestem niczym – jak mawiają nasi bracia i siostry z Libertacji – \"twardy orzech do zgryzienia\".",shape=box,color=blue];
		822 -> 824;
	823 [label="Okropieństwa, które rezonują w mojej głowie, nie znają granic. Widzę łańcuchy ludzkich ścięgien, które niegdyś ociekały świeżym karmazynem, a teraz stały się kruche i poczerniałe.",shape=box,color=blue];
		823 -> 825;
	824 [label="Jestem zaledwie oblężoną twierdzą. Podtrzymuję mur. Otwarcie bramy zagraża naruszeniem integralności całej obrony.",shape=box,color=blue];
		824 -> 826;
		824 -> 827;
	825 [label="Dostrzegam sto tysięcy twarzy samego siebie, z pozoru podobnych, lecz zupełnie obcych. Zapadnięte trumny, powykręcane ciała o rozszarpanych tkankach, zawieszone w próżni między życiem a śmiercią.",shape=box,color=blue];
		825 -> 828;
	826 [label="Rozumiem. Porozmawiamy, gdy będziesz gotowy.",shape=box,color=red];
		826 -> 829;
	827 [label="Co masz na myśli?",shape=box,color=red];
		827 -> 823;
	828 [label="Ekspresja zamknięta w masce o pustym spojrzeniu. Ale wśród majaczących pozostałości ich dusz, wciąż tlą się ich resztki i nie chcą umrzeć. Słyszę ich krzyki. Nieustanne, budzące grozę wycie dopominające się zemsty. Wolności.",shape=box,color=blue];
		828 -> 830;
	829 [label="Zaczynam dochodzić do wniosku, że nie mam wyboru w tej kwestii.",shape=box,color=blue];
		829 -> 831;
	830 [label="Śmierci.",shape=box,color=blue];
		830 -> 832;
	831 [label="+15 Chemistry",color=orange];
		831 -> 833;
	832 [label="Wizje te nawiedzają mnie na jawie. To moje sny. Nie miewam koszmarów, bo doświadczam tego wszystkiego – i tym się stałem.",shape=box,color=blue];
		832 -> 834;
	833 [label="Ale jeśli to ma jakieś znaczenie, Maria... powiedziała mi, że chcesz dobrze. A ja jej wierzę, nawet jeśli nie wierzę sam sobie.",shape=box,color=blue];
		833 -> 835;
	834 [label="Check boolean LyonPainOff",color=orange];
		834 -> 836 [label=true,color=green];
		834 -> 837 [label=false,color=brown];
	835 [label="Mogę zaledwie prosić cię o cierpliwość. Lua dobrze wie, że często mi jej brakuje.",shape=box,color=blue];
		835 -> 838;
	836 [label="Tylko wtedy, gdy składam ofiarę szeptom, które rozbrzmiewają w mojej duszy, świat odbija się we mnie w sposób zbliżony do tego, co tobie może wydawać się znajome.",shape=box,color=blue];
		836 -> 839;
	837 [label="Tylko wtedy, gdy rozdzieram swoje ciało, składając je w ofierze szeptom, które rozbrzmiewają w mojej duszy, świat odbija się we mnie w sposób zbliżony do tego, co tobie może wydawać się znajome.",shape=box,color=blue];
		837 -> 839;
	838 [label="O. Leon Allard",shape=box,color=blue];
		838 -> 840;
	839 [label="Proszę, nie udawaj, że wiesz, co \"czuję\", Włóczęgo. Obawiam się, że dopiero zaczynasz to pojmować.",shape=box,color=blue];
		839 -> 841;
		839 -> 842;
		839 -> 843;
	840 [label="Update boolean LyonVisions2d",color=orange];
		840 -> 844;
	841 [label="Ja... przepraszam. Nie, nie wiedziałem.",shape=box,color=red];
		841 -> 845;
	842 [label="Widziałem okropieństwa i ból, których ty również nie rozumiesz, Leonie.",shape=box,color=red];
		842 -> 846;
	843 [label="Przykro mi, jeśli czujesz, że się jestem napastliwy. Ale pragnę zrozumieć. Te twoje wizje...",shape=box,color=red];
		843 -> 847;
	844 [label="Chat ends.",color=orange];
	845 [label="Tak. No cóż. Przetrwałem te długie lata. Jestem pewien, że wytrzymam jeszcze kilka. Nie musisz się o mnie martwić.",shape=box,color=blue];
		845 -> 848;
	846 [label="Jestem tego niemal pewien, wnioskując po tym miejscu. Ale czy to powód, by się wywyższać? Najwyższy Wiedzący Wszelkich Okropieństw i Cierpienia?",shape=box,color=blue];
		846 -> 849;
		846 -> 850;
	847 [label="Tak. No cóż. Wytrwałem te wszystkie lata. Jestem pewien, że wytrzymam jeszcze kilka. Nie musisz się o mnie martwić.",shape=box,color=blue];
		847 -> 848;
	848 [label="Update boolean LyonVisions2a",color=orange];
		848 -> 851;
		848 -> 852;
	849 [label="Chodzi mi o to, że być może jestem w stanie lepiej zrozumieć, czego doświadczasz, niż ci się wydaje.",shape=box,color=red];
		849 -> 853;
	850 [label="Twierdzę jedynie, że przeżyłem mnóstwo okropieństw i śmierci, Leonie. Nie lubię, gdy ktoś mnie z tego powodu poucza.",shape=box,color=red];
		850 -> 854;
	851 [label="Leonie, to co opisujesz... czy ta wizja powstała przed, czy po tym, jak stałeś się protoframem?",shape=box,color=red];
		851 -> 855;
	852 [label="Możemy wrócić do tego tematu? Proszę?",shape=box,color=red];
		852 -> 856;
	853 [label="Update boolean LyonVisions2b",color=orange];
		853 -> 857;
	854 [label="Update boolean LyonVisions2c",color=orange];
		854 -> 858;
	855 [label="Gdyby tylko odpowiedź na to pytanie była równie prosta, jak ci się wydaje. Tak czy owak, nie jestem udzielić ci dzisiaj odpowiedzi. Już czuję nadchodzący ból głowy.",shape=box,color=blue];
		855 -> 859;
	856 [label="Zaczynam dochodzić do wniosku, że nie mam wyboru w tej kwestii.",shape=box,color=blue];
		856 -> 859;
	857 [label="Może ci się to wydawać dziwne, ale nie szukam zrozumienia, Włóczęgo. Szukam odpowiedzi. Pewności. Niebios, gdy wszystko wokół jest iluzją i kłamstwem.",shape=box,color=blue];
		857 -> 860;
		857 -> 861;
	858 [label="W takim razie pozwól, że padnę do twych stóp. Chwała ci za to, co musiałeś wycierpieć. Zastanawiam się, jak pozostałeś przy swych zmysłach, mimo wszystkich rzeczy, których byłeś świadkiem.",shape=box,color=blue];
		858 -> 862;
	859 [label="+10 Chemistry",color=orange];
		859 -> 863;
	860 [label="Zrobię co w mojej mocy.",shape=box,color=red];
		860 -> 864;
	861 [label="W takim razie mogę ci się do czegoś przydać. Wróćmy do tego tematu? Proszę?",shape=box,color=red];
		861 -> 856;
	862 [label="I dziwię się, jak ty wciąż znajdujesz czas na nas wszystkich – na tych, których status uważasz za tak odległy sobie.",shape=box,color=blue];
		862 -> 865;
	863 [label="Ale jeśli to ma jakieś znaczenie, Maria... powiedziała mi, że chcesz dobrze. A ja jej wierzę, nawet jeśli nie wierzę sam sobie.",shape=box,color=blue];
		863 -> 866;
	864 [label="+5 Chemistry",color=orange];
		864 -> 867;
	865 [label="Chat ends.",color=orange];
	866 [label="Mogę zaledwie prosić cię o cierpliwość. Lua dobrze wie, że często mi jej brakuje.",shape=box,color=blue];
		866 -> 868;
	867 [label="Chociaż na tyle można liczyć, co?",shape=box,color=blue];
		867 -> 869;
	868 [label="O. Leon Allard",shape=box,color=blue];
		868 -> 870;
	869 [label="Chat ends.",color=orange];
	870 [label="Chat ends.",color=orange];
}