digraph {
	"LyonRank4Convo2 begins." [color=orange];
		"LyonRank4Convo2 begins." -> j1761828159;
		"LyonRank4Convo2 begins." -> j1089054539;
		"LyonRank4Convo2 begins." -> j386906797;
	j1761828159 [label="Jak to możliwe, że ty i Maria potraficie pogodzić duchowieństwo z... dopuszczaniem się aktów przemocy?",shape=box,color=red];
		j1761828159 -> j3998823464;
		j1761828159 -> j910230373;
		j1761828159 -> j1080908713;
	j1089054539 [label="Mogę zadać ci trochę dziwne pytanie, Leonie?",shape=box,color=red];
		j1089054539 -> j2750844508;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j3998823464 [label="Słyszę, jak Maria krzyczy \"païens!\" i rzuca się do walki, i… a jednak trudno mi uwierzyć, że jest osobą, która potępia kogoś za odmienne poglądy. Nie mogę sobie wyobrazić, żebyś ty też się aż tak bardzo różnił. Ona ma o tobie tak wysokie mniemanie.",shape=box,color=red];
		j3998823464 -> j961629943;
	j910230373 [label="Jak twój kościół zareagowałby na to, co ty i Maria robicie? Na to... o co jesteście proszeni w ich imieniu?",shape=box,color=red];
		j910230373 -> j3304732479;
	j1080908713 [label="Przyglądam się tobie i Marii na polu bitwy, a potem rozmawiam z nią prywatnie, widzę, jak w ciszy czytacie książki... i chyba mam problem z identyfikowaniem tych indywidualności w mojej głowie.",shape=box,color=red];
	j2750844508 [label="Jeśli uważasz, że nasza obecna sytuacja jest dla ciebie po prostu \"dziwna\", to albo jestem pod wrażeniem twojego zahartowania, albo zaniepokojony twoim brakiem słownictwa. Podejrzewam jednak, że chodzi o to pierwsze.",shape=box,color=blue];
		j2750844508 -> j3264856031;
	"Chat ends." [color=orange];
	j961629943 [label="Masz całkowitą rację. Maria nie jest osobą, która potępia innych za trzymanie w sercu starożytnego boga drzew – zamiast tego stara się odkryć, jakie przekonania łączą ją z daną osobą.",shape=box,color=blue];
		j961629943 -> j741050131;
	j3304732479 [label="W tamtych czasach toczono święte wojny w imię Sol i Lui. Krwawe \"krucjaty\", których celem było wyparcie \"pogan\", \"zajęcie świętej ziemi\" – albo jakiekolwiek inne uzasadnienia – były wtedy częste.",shape=box,color=blue];
		j3304732479 -> j3707363373;
	j3264856031 [label="+5 Chemistry",color=orange];
		j3264856031 -> j4124522260;
	j741050131 [label="Czy drzewo nie może się nasycić światłem Sol? Czy nie ma wspólnej przestrzeni, która mogłaby ich połączyć? Jest bardziej skłonna usiąść i wysłuchać ich opowieści, niż próbować zaszkodzić ich wierze.",shape=box,color=blue];
		j741050131 -> j4215482955;
	j3707363373 [label="Kościół Świetlistych nie ma armii i nie prowadzi wojen. Jednak nie zabrania swoim wyznawcom podejmowania działań ani chronienia innych.",shape=box,color=blue];
		j3707363373 -> j3398873255;
	j4124522260 [label="Ale oczywiście, kontynuuj. Nie możesz sprawić, żeby to było dla mnie jeszcze bardziej \"dziwne\", pytając o to, co cię intryguje.",shape=box,color=blue];
		j4124522260 -> j3998823464;
		j4124522260 -> j910230373;
		j4124522260 -> j1080908713;
	j4215482955 [label="Kiedy ona walczy z wrogiem na polu bitwy, myślę, że dzieje się jedna z tych rzeczy: albo bawi się, odgrywając rolę uczestniczki pradawnej krucjaty, wyobrażając sobie swą postać w lśniącej zbroi rycerza Sol...",shape=box,color=blue];
		j4215482955 -> j13597489;
	j3398873255 [label="Kiedy Maria walczy z wrogami na polu bitwy, myślę, że dzieje się jedna z tych rzeczy: albo bawi się, odgrywając rolę uczestniczki pradawnej krucjaty i wyobrażając sobie swą postać w lśniącej zbroi rycerza Sol...",shape=box,color=blue];
		j3398873255 -> j13597489;
	j13597489 [label="Albo, co bardziej prawdopodobne, przypomina sobie Astafora 8:23 \"Samotne są dusze, które pragną wedrzeć się do mego domu siłą, bo to one zostały pozbawione światła Sol\".",shape=box,color=blue];
		j13597489 -> j2007077672;
	j2007077672 [label="W jej oczach przemoc, której się dopuszcza, jest słuszna i służy obronie większego dobra. Zakładam, że ty i osoby walczące u twego boku zrobilibyście tak samo.",shape=box,color=blue];
		j2007077672 -> j2284183243;
	j2284183243 [label="Dlatego ci, z którymi walczy, niezależnie od ich religii, są wygnańcami Sol. Nawet gdyby nosili święte szaty jej własnego zakonu, w jej oczach nadal są poganami.",shape=box,color=blue];
		j2284183243 -> j1789008664;
		j2284183243 -> j3137038587;
	j1789008664 [label="Zauważyłem, że starasz się w to nie mieszać. Co ty czujesz w związku z tą całą walką?",shape=box,color=red];
		j1789008664 -> j536980853;
	j3137038587 [label="To ma sens. Dziękuję.",shape=box,color=red];
		j3137038587 -> j1243439414;
	j536980853 [label="Celowo tego unikam, Wysłanniku.",shape=box,color=blue];
		j536980853 -> j312203622;
		j536980853 -> j3843973268;
	j1243439414 [label="+5 Chemistry",color=orange];
		j1243439414 -> j2575821337;
	j312203622 [label="A ja celowo o to pytam, Ojcze.",shape=box,color=red];
		j312203622 -> j3657882902;
	j3843973268 [label="No dobrze. Musi mi na dzisiaj wystarczyć to, co już mam.",shape=box,color=red];
		j3843973268 -> j1243439414;
	j2575821337 [label="Jeśli to ma jakieś znaczenie, Maria... powiedziała mi, że chcesz dobrze. A ja jej wierzę, nawet jeśli nie wierzę sam sobie.",shape=box,color=blue];
		j2575821337 -> j2864770198;
	j3657882902 [label="+10 Chemistry",color=orange];
		j3657882902 -> j1371848412;
	j2864770198 [label="Mogę zaledwie prosić cię o cierpliwość. Lua dobrze wie, że często mi jej brakuje.",shape=box,color=blue];
		j2864770198 -> j3651491667;
	j1371848412 [label="Niech będzie. Skoro cię to nie zniechęca i w dalszym ciągu jesteś ciekaw... Aż tak bardzo nie strofuję się śmiercią, którą zadaję... jak mógłbyś tego oczekiwać.",shape=box,color=blue];
		j1371848412 -> j4165970841;
	j3651491667 [label="O. Leon Allard",shape=box,color=blue];
		j3651491667 -> "Chat ends.";
	j4165970841 [label="Albo, że ktoś mógłby uznać to za \"niestosowne\" dla duchownego i uczonego mojego pokroju.",shape=box,color=blue];
		j4165970841 -> j4217199189;
		j4165970841 -> j2836933331;
	j4217199189 [label="W życiu zaznałem więcej wojen niż spokoju, Leonie. Gdybym pozwolił, by mnie to dręczyło, to raczej by mnie tu nie było. Ale nie oznacza to, że nie wiąże się to z prawdziwym ciężarem – który stanowi koszt tego wszystkiego.",shape=box,color=red];
		j4217199189 -> j3445932126;
	j2836933331 [label="Jestem pewien, że inni powiedzieli ci, kim jestem. Czym jestem. Skąd pochodzę. O śmierci, która za mną podąża i przed którą uciekam. Śmierć mnie definiuje. Sądzisz, że twoje uczucia są w stanie mnie zaskoczyć?",shape=box,color=red];
		j2836933331 -> j4242920124;
	j3445932126 [label="Add 1 to Thermostat counter",color=orange];
		j3445932126 -> j1043643551;
	j4242920124 [label="Add -1 to Thermostat counter",color=orange];
		j4242920124 -> j1568504649;
	j1043643551 [label="Tak sądzę.",shape=box,color=blue];
		j1043643551 -> j2056086269;
		j1043643551 -> j1197491532;
	j1568504649 [label="To prawda.",shape=box,color=blue];
		j1568504649 -> j2056086269;
		j1568504649 -> j1197491532;
	j2056086269 [label="Przepraszam. Czuję, że cię zdenerwowałem. Nie miałem takiego zamiaru.",shape=box,color=red];
		j2056086269 -> j926123597;
	j1197491532 [label="Czy możesz... rozwinąć tę myśl?",shape=box,color=red];
		j1197491532 -> j4268016844;
	j926123597 [label="Nie obwiniaj się, Włóczęgo. Jestem niczym – jak mawiają nasi bracia i siostry z Libertacji – \"twardy orzech do zgryzienia\".",shape=box,color=blue];
		j926123597 -> j2002041602;
	j4268016844 [label="Okropieństwa, które rezonują w mojej głowie, nie znają granic. Widzę łańcuchy ludzkich ścięgien, które niegdyś ociekały świeżym karmazynem, a teraz stały się kruche i poczerniałe.",shape=box,color=blue];
		j4268016844 -> j3990680737;
	j2002041602 [label="Jestem zaledwie oblężoną twierdzą. Podtrzymuję mur. Otwarcie bramy zagraża naruszeniem integralności całej obrony.",shape=box,color=blue];
		j2002041602 -> j1599569348;
		j2002041602 -> j1465452411;
	j3990680737 [label="Dostrzegam sto tysięcy twarzy samego siebie, z pozoru podobnych, lecz zupełnie obcych. Zapadnięte trumny, powykręcane ciała o rozszarpanych tkankach, zawieszone w próżni między życiem a śmiercią.",shape=box,color=blue];
		j3990680737 -> j1311362021;
	j1599569348 [label="Rozumiem. Porozmawiamy, gdy będziesz gotowy.",shape=box,color=red];
		j1599569348 -> j4029100145;
	j1465452411 [label="Co masz na myśli?",shape=box,color=red];
		j1465452411 -> j4268016844;
	j1311362021 [label="Ekspresja zamknięta w masce o pustym spojrzeniu. Ale wśród majaczących pozostałości ich dusz, wciąż tlą się ich resztki i nie chcą umrzeć. Słyszę ich krzyki. Nieustanne, budzące grozę wycie dopominające się zemsty. Wolności.",shape=box,color=blue];
		j1311362021 -> j449456617;
	j4029100145 [label="Zaczynam dochodzić do wniosku, że nie mam wyboru w tej kwestii.",shape=box,color=blue];
		j4029100145 -> j3626780772;
	j449456617 [label="Śmierci.",shape=box,color=blue];
		j449456617 -> j2145474103;
	j3626780772 [label="+15 Chemistry",color=orange];
		j3626780772 -> j1992424473;
	j2145474103 [label="Wizje te nawiedzają mnie na jawie. To moje sny. Nie miewam koszmarów, bo doświadczam tego wszystkiego – i tym się stałem.",shape=box,color=blue];
		j2145474103 -> j1274675553;
	j1992424473 [label="Ale jeśli to ma jakieś znaczenie, Maria... powiedziała mi, że chcesz dobrze. A ja jej wierzę, nawet jeśli nie wierzę sam sobie.",shape=box,color=blue];
		j1992424473 -> j4135197518;
	j1274675553 [label="Check boolean LyonPainOff",color=orange];
		j1274675553 -> j3966790437 [label=true,color=green];
		j1274675553 -> j2933125144 [label=false,color=brown];
	j4135197518 [label="Mogę zaledwie prosić cię o cierpliwość. Lua dobrze wie, że często mi jej brakuje.",shape=box,color=blue];
		j4135197518 -> j645521656;
	j3966790437 [label="Tylko wtedy, gdy składam ofiarę szeptom, które rozbrzmiewają w mojej duszy, świat odbija się we mnie w sposób zbliżony do tego, co tobie może wydawać się znajome.",shape=box,color=blue];
		j3966790437 -> j1225195985;
	j2933125144 [label="Tylko wtedy, gdy rozdzieram swoje ciało, składając je w ofierze szeptom, które rozbrzmiewają w mojej duszy, świat odbija się we mnie w sposób zbliżony do tego, co tobie może wydawać się znajome.",shape=box,color=blue];
		j2933125144 -> j1225195985;
	j645521656 [label="O. Leon Allard",shape=box,color=blue];
		j645521656 -> j2522325746;
	j1225195985 [label="Proszę, nie udawaj, że wiesz, co \"czuję\", Włóczęgo. Obawiam się, że dopiero zaczynasz to pojmować.",shape=box,color=blue];
		j1225195985 -> j949027793;
		j1225195985 -> j3728666617;
		j1225195985 -> j3553966322;
	j2522325746 [label="Boolean LyonVisions2d is now true.",color=orange];
		j2522325746 -> "Chat ends.";
	j949027793 [label="Ja... przepraszam. Nie, nie wiedziałem.",shape=box,color=red];
		j949027793 -> j1708688887;
	j3728666617 [label="Widziałem okropieństwa i ból, których ty również nie rozumiesz, Leonie.",shape=box,color=red];
		j3728666617 -> j1316785298;
	j3553966322 [label="Przykro mi, jeśli czujesz, że się jestem napastliwy. Ale pragnę zrozumieć. Te twoje wizje...",shape=box,color=red];
		j3553966322 -> j2441840504;
	j1708688887 [label="Tak. No cóż. Przetrwałem te długie lata. Jestem pewien, że wytrzymam jeszcze kilka. Nie musisz się o mnie martwić.",shape=box,color=blue];
		j1708688887 -> j4270520825;
	j1316785298 [label="Jestem tego niemal pewien, wnioskując po tym miejscu. Ale czy to powód, by się wywyższać? Najwyższy Wiedzący Wszelkich Okropieństw i Cierpienia?",shape=box,color=blue];
		j1316785298 -> j1851382905;
		j1316785298 -> j264485764;
	j2441840504 [label="Tak. No cóż. Wytrwałem te wszystkie lata. Jestem pewien, że wytrzymam jeszcze kilka. Nie musisz się o mnie martwić.",shape=box,color=blue];
		j2441840504 -> j4270520825;
	j4270520825 [label="Boolean LyonVisions2a is now true.",color=orange];
		j4270520825 -> j2152798147;
		j4270520825 -> j1884730974;
	j1851382905 [label="Chodzi mi o to, że być może jestem w stanie lepiej zrozumieć, czego doświadczasz, niż ci się wydaje.",shape=box,color=red];
		j1851382905 -> j620778028;
	j264485764 [label="Twierdzę jedynie, że przeżyłem mnóstwo okropieństw i śmierci, Leonie. Nie lubię, gdy ktoś mnie z tego powodu poucza.",shape=box,color=red];
		j264485764 -> j2071760456;
	j2152798147 [label="Leonie, to co opisujesz... czy ta wizja powstała przed, czy po tym, jak stałeś się protoframem?",shape=box,color=red];
		j2152798147 -> j3042066651;
	j1884730974 [label="Możemy wrócić do tego tematu? Proszę?",shape=box,color=red];
		j1884730974 -> j201046679;
	j620778028 [label="Boolean LyonVisions2b is now true.",color=orange];
		j620778028 -> j886856900;
	j2071760456 [label="Boolean LyonVisions2c is now true.",color=orange];
		j2071760456 -> j963552591;
	j3042066651 [label="Gdyby tylko odpowiedź na to pytanie była równie prosta, jak ci się wydaje. Tak czy owak, nie jestem udzielić ci dzisiaj odpowiedzi. Już czuję nadchodzący ból głowy.",shape=box,color=blue];
		j3042066651 -> j286670261;
	j201046679 [label="Zaczynam dochodzić do wniosku, że nie mam wyboru w tej kwestii.",shape=box,color=blue];
		j201046679 -> j286670261;
	j886856900 [label="Może ci się to wydawać dziwne, ale nie szukam zrozumienia, Włóczęgo. Szukam odpowiedzi. Pewności. Niebios, gdy wszystko wokół jest iluzją i kłamstwem.",shape=box,color=blue];
		j886856900 -> j472960760;
		j886856900 -> j2478727482;
	j963552591 [label="W takim razie pozwól, że padnę do twych stóp. Chwała ci za to, co musiałeś wycierpieć. Zastanawiam się, jak pozostałeś przy swych zmysłach, mimo wszystkich rzeczy, których byłeś świadkiem.",shape=box,color=blue];
		j963552591 -> j1965717089;
	j286670261 [label="+10 Chemistry",color=orange];
		j286670261 -> j1705585846;
	j472960760 [label="Zrobię co w mojej mocy.",shape=box,color=red];
		j472960760 -> j3928741527;
	j2478727482 [label="W takim razie mogę ci się do czegoś przydać. Wróćmy do tego tematu? Proszę?",shape=box,color=red];
		j2478727482 -> j201046679;
	j1965717089 [label="I dziwię się, jak ty wciąż znajdujesz czas na nas wszystkich – na tych, których status uważasz za tak odległy sobie.",shape=box,color=blue];
		j1965717089 -> "Chat ends.";
	j1705585846 [label="Ale jeśli to ma jakieś znaczenie, Maria... powiedziała mi, że chcesz dobrze. A ja jej wierzę, nawet jeśli nie wierzę sam sobie.",shape=box,color=blue];
		j1705585846 -> j2864770198;
	j3928741527 [label="+5 Chemistry",color=orange];
		j3928741527 -> j2408862388;
	j2408862388 [label="Chociaż na tyle można liczyć, co?",shape=box,color=blue];
		j2408862388 -> "Chat ends.";
}