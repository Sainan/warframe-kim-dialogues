		j4196769031 -> j4249387106 [label="LyonVisions1",color=purple];
		j4196769031 -> j1281561481 [label="false",color=purple];
		j4196769031 -> j186628466 [label="false",color=purple];
	j4249387106 [label="Ostrzegano mnie, że możesz postrzegać niektóre rzeczy inaczej, niż my. Ale wcale mi to nie przeszkadza. Interesuje mnie to, co wiesz.",shape=box,color=red];
		j4249387106 -> j4129756131;
	j1281561481 [label="Maria wydaje się mieć obsesję na punkcie \"le Cardinala\". A Roathe ewidentnie go nienawidzi. Szukam kogoś neutralnego. Ty jesteś najbliżej.",shape=box,color=red];
		j1281561481 -> j4170049148;
	j186628466 [label="Ja... nie wiem, o co innego mógłbym cię zapytać?",shape=box,color=red];
		j186628466 -> j3006081023;
	j557818757 [label="Ostrzegano mnie, że możesz postrzegać niektóre rzeczy inaczej, niż my. Ale ja myślę, że potrafisz dostrzec prawdę tam, gdzie inni jej nie widzą.",shape=box,color=red];
		j557818757 -> j1984956485;
	j4129756131 [label="Hm. Nie przeszkadza ci spoufalanie się z szaleńcami i lunatykami? To ciekawe. Chociaż zdaje się, że zadajesz się z gadającymi zwierzętami i... tworami z innego wymiaru. Chyba wcale nie jestem większym dziwakiem niż ta cała reszta twej kolekcji.",shape=box,color=blue];
		j4129756131 -> j2845885253;
	j4170049148 [label="Ależ w niekomfortowej pozycji musiałeś się znaleźć, skoro szaleniec i lunatyk jest twoim jedynym źródłem \"neutralnej\" opinii. Nie jestem w stanie pojąć, dlaczego w ogóle ze mną rozmawiasz.",shape=box,color=blue];
		j4170049148 -> j2845885253;
	j3006081023 [label="Dlaczego w ogóle upierasz się, by ze mną rozmawiać? Zrozum, że nie musisz. Jeśli chcesz się zaprzyjaźnić z Marią – albo nawet zabiegać o jej względy – to nie jestem ani jej opiekunem ani jej ojcem. I jakiekolwiek masz zamiary wobec tego drania Roathe'a, niewiele mnie obchodzą poza odpowiedziami, które jest mi winien.",shape=box,color=blue];
		j3006081023 -> j2845885253;
	j1984956485 [label="\"Prawdę\". Szkoda, że nie zdajesz sobie sprawy, jakie to było zabawne. Nie przeszkadza ci spoufalanie się z szaleńcami i lunatykami? To ciekawe. Chociaż zdaje się, że zadajesz się z gadającymi zwierzętami i... tworami z innego wymiaru. Chyba wcale nie jestem większym dziwakiem niż ta cała reszta twej kolekcji.",shape=box,color=blue];
		j1984956485 -> j2845885253;
	j2845885253 [label="Evaluate expressions",color=orange];
		j2845885253 -> j2253251860 [label="LyonFirstFlirt",color=purple];
		j2845885253 -> j2253251860 [label="DrifterLyon",color=purple];
		j2845885253 -> j3255633926 [label="LyonOffer",color=purple];
		j2845885253 -> j2070018825 [label="false",color=purple];
	j2253251860 [label="I proszę, oszczędź nam obu kolejnej... żenującej chwili, dobrze? Wiem, że to, o czym wspomniałeś, jest powodem, dlaczego ze mną rozmawiasz. I choć mi to schlebia, to jednocześnie uznaję to za wręcz absurdalnie nieszczere.",shape=box,color=blue];
		j2253251860 -> j886882910;
		j2253251860 -> j1502932083;
		j2253251860 -> j3698671380;
	j3255633926 [label="I proszę, oszczędź nam obu kolejnego wykładu o tym, jak chcesz mi \"pomóc\", dobrze? Jestem przekonany, że chcesz być miły, ale drażni mnie ten niedorzeczny brak szczerości.",shape=box,color=blue];
		j3255633926 -> j886882910;
		j3255633926 -> j1502932083;
		j3255633926 -> j3698671380;
	j2070018825 [label="I proszę, oszczędź nam obu przydługich wykładów na temat tego, jak chcesz mi \"pomóc\" albo jak \"chcesz zostać moim przyjacielem\". Jestem przekonany, że chcesz być miły, ale drażni mnie ten niedorzeczny brak szczerości.",shape=box,color=blue];
		j2070018825 -> j886882910;
		j2070018825 -> j1502932083;
		j2070018825 -> j3698671380;
	j886882910 [label="Nieszczere, bo uważasz, że nie mam na myśli tego, co mówię? Czy nieszczere, bo uważasz, że nie mogę tego myśleć o tobie?",shape=box,color=red];
		j886882910 -> j1378152550;
	j1502932083 [label="Ojcze, chciałem tylko usłyszeć historię o tym, jak długo Entrati udawał kardynała. To tyle.",shape=box,color=red];
		j1502932083 -> j4004492968;
	j3698671380 [label="Co masz na myśli, mówiąc \"nieszczere\"? Nazywasz mnie kłamcą?",shape=box,color=red];
		j3698671380 -> j5625625;
	j1378152550 [label="Ani jedno ani drugie. Twoje słowa są aktem miłosierdzia, którego nie chcę i nie potrzebuję.",shape=box,color=blue];
		j1378152550 -> j4275260433;
		j1378152550 -> j4210754903;
	j4004492968 [label="Oczywiście. Pełnił posługę jako kardynał Dimanche w naszej Katedrze przez trzy lata, dwa miesiące i jedenaście dni. A przez cały ten czas wraz z Marią służyliśmy mu kompletnie nieświadomi tego, jaki los dla nas sobie upatrzył.",shape=box,color=blue];
		j4004492968 -> j1509400624;
	j5625625 [label="Evaluate expressions",color=orange];
		j5625625 -> j5118226 [label="DrifterLiar",color=purple];
		j5625625 -> j2711623397 [label="LyonSuspicious",color=purple];
		j5625625 -> j3832477081 [label="false",color=purple];
	j4275260433 [label="Jak Maria to znosi...?",shape=box,color=red];
		j4275260433 -> j2666572165;
	j4210754903 [label="Twierdzisz, że każdy, kto decyduje się nawiązać z tobą kontakt, porywa się na akt miłosierdzia?",shape=box,color=red];
		j4210754903 -> j2732893407;
	j1509400624 [label="Znam twoje pytania, zanim zdołasz je zadać. Co knuł? Czy zatruł miasto, tak jak rzekomo zrobił to z Höllvanią? Jakie snuł plany? Co zdołał odkryć?",shape=box,color=blue];
		j1509400624 -> j2390561167;
	j5118226 [label="Chciałbyś coś wyznać, Włóczęgo? Czy jesteś gotów odbyć pokutę?",shape=box,color=blue];
		j5118226 -> j1923520263;
	j2711623397 [label="Hmm. Nie. Jeszcze nie teraz.",shape=box,color=blue];
		j2711623397 -> j3832477081;
	j3832477081 [label="Twoja nieszczerość nie jest kłamstwem. To miłosierdzie. Miłosierdzie, którego nie chcę i nie potrzebuję.",shape=box,color=blue];
		j3832477081 -> j4275260433;
		j3832477081 -> j4210754903;
	j2666572165 [label="Najlepiej sam ją o to zapytaj. Często się nad tym zastanawiam.",shape=box,color=blue];
		j2666572165 -> "Chat ends.";
	j2732893407 [label="W skrócie? Tak.",shape=box,color=blue];
		j2732893407 -> j3994772085;
	j2390561167 [label="W tej kwestii muszę cię niestety rozczarować. Co robił przez te trzy lata, dwa miesiące i jedenaście dni? Modlił się. Uczył się. Odpoczywał. I znów się modlił.",shape=box,color=blue];
		j2390561167 -> j4012545737;
		j2390561167 -> j1692769841;
		j2390561167 -> j835199530;
	j1923520263 [label="To i tak nie ma znaczenia. Nie zacząłeś tej rozmowy, by szukać przebaczenia, a twoje dawne kłamstwa nie są tym samym, co twoja obecna nieszczerość.",shape=box,color=blue];
		j1923520263 -> j1983993845;
	j3994772085 [label="Boolean LyonHate1 is now true.",color=orange];
		j3994772085 -> j3792566022;
		j3994772085 -> j2119403020;
		j3994772085 -> j3401688406;
	j4012545737 [label="Kiedy zamienił was w protoframe'y?",shape=box,color=red];
		j4012545737 -> j1587495798;
	j1692769841 [label="Bardzo trudno mi sobie wyobrazić modlącego się Entratiego.",shape=box,color=red];
		j1692769841 -> j2607140529;
	j835199530 [label="Czyli był na... urlopie naukowym?!",shape=box,color=red];
		j835199530 -> j3860850304;
	j1983993845 [label="To, co teraz mówisz stanowi zaledwie akt miłosierdzia. Miłosierdzia, którego nie chcę i nie potrzebuję.",shape=box,color=blue];
		j1983993845 -> j4275260433;
		j1983993845 -> j4210754903;
	j3792566022 [label="To temat na inny dzień – czuję, że ta rozmowa wymyka się spod kontroli.",shape=box,color=red];
		j3792566022 -> j2590065014;
	j2119403020 [label="A co z Marią...?",shape=box,color=red];
		j2119403020 -> j1929043978;
	j3401688406 [label="Masz o sobie złe mniemanie.",shape=box,color=red];
		j3401688406 -> j3535833366;
	j1587495798 [label="Po tych trzech latach i kilku dniach zniknął w środku straszliwej burzy. Takiej samej, w której się pojawił.",shape=box,color=blue];
		j1587495798 -> j3307858394;
	j2607140529 [label="Nie da się zajrzeć do wnętrza umysłu drugiego człowieka. Klękał przy ołtarzu i pochylał głowę. A czy się modlił? Czy może najzwyczajniej pogrążał się we własnych myślach? Tego nie wiem.",shape=box,color=blue];
		j2607140529 -> j1587495798;
	j3860850304 [label="+5 Chemistry",color=orange];
		j3860850304 -> j2027473440;
	j2590065014 [label="+5 Chemistry",color=orange];
		j2590065014 -> j2002326683;
	j1929043978 [label="Maria utuliłaby wściekłego niedźwiedzia i pozwoliłaby mu rozszarpać sobie gardło, gdyby dzięki temu mógł zaznać choćby chwili ukojenia.",shape=box,color=blue];
		j1929043978 -> j1092944017;
	j3535833366 [label="Uznałbym to za niezłomne oddanie pragmatyzmowi, ale możesz to dowolnie interpretować.",shape=box,color=blue];
		j3535833366 -> j3619864005;
	j3307858394 [label="Evaluate expressions",color=orange];
		j3307858394 -> j442871917 [label="MarieLyonVisions",color=purple];
		j3307858394 -> j442871917 [label="LyonVisions1",color=purple];
		j3307858394 -> j3158876755 [label="false",color=purple];
	j2027473440 [label="He. Nie myślałem o tym w ten sposób, ale tak – chyba był. Ależ to musi być irytujące dla was wszystkich. Doskonale się to wpisuje w fakt, jak mało wiemy o jego prawdziwej naturze.",shape=box,color=blue];
		j2027473440 -> j1587495798;
	j2002326683 [label="To prawdopodobnie mądra decyzja. Pytałeś o \"kardynała Dimanche\" i jego posługę w Katedrze.",shape=box,color=blue];
		j2002326683 -> j3761451442;
	j1092944017 [label="Jest wyjątkowo piękną duszą, którą będę chronić aż do ostatniego tchnienia.",shape=box,color=blue];
		j1092944017 -> j3619864005;
	j3619864005 [label="+5 Chemistry",color=orange];
		j3619864005 -> j2134244700;
	j442871917 [label="Choć doskonale zdaję sobie sprawę, że burza nie była taka oczywista dla innych, dla mnie była ona aż nadto wyraźna.",shape=box,color=blue];
		j442871917 -> j3158876755;
	j3158876755 [label="Dokładnie rok później pojawił się po raz ostatni, a u jego stóp leżał... zapadnięty w sobie i nieprzytomny Roathe, jakiego znasz.",shape=box,color=blue];
		j3158876755 -> j2106276638;
	j3761451442 [label="Pełnił posługę jako kardynał Dimanche w naszej Katedrze przez trzy lata, dwa miesiące i jedenaście dni. A przez cały ten czas wraz z Marią służyliśmy mu kompletnie nieświadomi tego, jaki los nam zgotował.",shape=box,color=blue];
		j3761451442 -> j1509400624;
	j2134244700 [label="Ale tego właśnie należy się spodziewać, zadając szaleńcowi proste pytanie – odpowiedź często prowadzi na manowce. Pozwól, że wrócimy do twojego pierwotnego tematu, a mój zostawmy w spokoju.",shape=box,color=blue];
		j2134244700 -> j3761451442;
	j2106276638 [label="Wyglądał jak diabeł wcielony. To właśnie wtedy Entrati wyjawił nam prawdę, kim tak naprawdę był – skąd się wziął – i jakie zadanie ma dla nas.",shape=box,color=blue];
		j2106276638 -> j1108915555;
	j1108915555 [label="Że wybrał nas oboje do swojej \"świętej misji\".",shape=box,color=blue];
		j1108915555 -> j594896118;
		j1108915555 -> j1026581663;
	j594896118 [label="Po co ten cudzysłów?",shape=box,color=red];
		j594896118 -> j4153846746;
	j1026581663 [label="Zabrzmiało to tak, jakbyś mu nie wierzył.",shape=box,color=red];
		j1026581663 -> j4153846746;
	j4153846746 [label="Dowiedziałem się na tyle dużo, by zacząć kwestionować przywiązanie Entratiego do czegokolwiek, co można nazwać świętym, bez względu na naturę, boga czy wszelkie... jeśli cokolwiek z tego w ogóle istnieje...",shape=box,color=blue];
		j4153846746 -> j551062590;
		j4153846746 -> j2694180016;
	j551062590 [label="Jeśli cokolwiek z tego istnieje? Leonie, co masz na myśli?",shape=box,color=red];
		j551062590 -> j511773465;
	j2694180016 [label="Mów dalej.",shape=box,color=red];
		j2694180016 -> j3737386424;
	j511773465 [label="Boolean LyonFaith2 is now true.",color=orange];
		j511773465 -> j2030529258;
	j3737386424 [label="Maria ochoczo przyjęła serum. Oczywiście. Jakże mogłaby tego nie zrobić? I dlaczego miałbym nie pójść w jej ślady? Jak mógłbym nie szukać prawdy, dokądkolwiek by mnie to nie zaprowadziło?",shape=box,color=blue];
		j3737386424 -> j1813802388;
	j2030529258 [label="To sprawa na inną rozmowę, jeśli będziesz łaskaw.",shape=box,color=blue];
		j2030529258 -> j3737386424;
	j1813802388 [label="Boolean LyonSerum1 is now true.",color=orange];
		j1813802388 -> j817137072;
		j1813802388 -> j3200193344;
		j1813802388 -> j2630967378;
	j817137072 [label="Myślę, że ona wciąż otacza Entratiego zbyt wielką czcią.",shape=box,color=red];
		j817137072 -> j2922330100;
	j3200193344 [label="Co się później wydarzyło?",shape=box,color=red];
		j3200193344 -> j409746230;
	j2630967378 [label="Żałujesz tego?",shape=box,color=red];
		j2630967378 -> j4163775376;
	j2922330100 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j2922330100 -> j2305034329;
	j409746230 [label="Roathe się wybudził. Z początku ledwo pamiętał, jak się nazywa. Entrati powiedział temu draniowi na pożegnanie: \"Urielu, wygnańcu, Heretyku Xaty, odpowiedz – czy Orokin kiedykolwiek mogą uzyskać przebaczenie?\".",shape=box,color=blue];
		j409746230 -> j1022555962;
	j4163775376 [label="Wszystkiego żałuję, Włóczęgo. Oczywiście, że tak. Ale czy zrobiłbym to ponownie? Tak, oczywiście. Nie mógłbym zostawić Marii samej.",shape=box,color=blue];
		j4163775376 -> j3352759261;
	j2305034329 [label="W tej kwestii się zgadzamy. Ale nie mogę mieć do niej pretensji o to. Daj jej trochę czasu. W końcu zrozumie. Jest niezwykle inteligentna, Włóczęgo. Nie traktuj jej jak kretynki.",shape=box,color=blue];
		j2305034329 -> j3352759261;
	j1022555962 [label="Entrati odszedł wtedy po raz ostatni. I porzucił u nas Roathe'a, przemienionego w to, co sam widzisz – kogoś lepiej przygotowanego do walki z rozdrażnionym diabłem.",shape=box,color=blue];
		j1022555962 -> j1712164722;
	j3352759261 [label="Już kończąc tę historię... Entrati odszedł wtedy po raz ostatni. I porzucił u nas Roathe'a, przemienionego w to, co sam widzisz – kogoś lepiej przygotowanego do walki z rozdrażnionym diabłem.",shape=box,color=blue];
		j3352759261 -> j1712164722;
	j1712164722 [label="Obawiam się, że reszta tej opowieści będzie musiała zaczekać. p. Loid potrzebuje skorzystać z POM-2, a ja z chęcią mu to umożliwię. Mam nadzieję, że znalazłeś odpowiedzi na przynajmniej część swoich pytań.",shape=box,color=blue];
		j1712164722 -> j114435358;
		j1712164722 -> j4114598173;
	j114435358 [label="Teraz mam dwa razy tyle nowych pytań.",shape=box,color=red];
		j114435358 -> j2967160083;
	j4114598173 [label="Zdecydowanie, dziękuję.",shape=box,color=red];
		j4114598173 -> j2229124449;
	j2967160083 [label="+15 Chemistry",color=orange];
		j2967160083 -> j4284228125;
	j2229124449 [label="+10 Chemistry",color=orange];
		j2229124449 -> j369339128;
	j4284228125 [label="W takim razie spełniłem swój kapłański obowiązek. Życzę ci dobrej nocy.",shape=box,color=blue];
		j4284228125 -> j3651491667;
	j369339128 [label="W takim razie życzę ci dobrej nocy.",shape=box,color=blue];
		j369339128 -> j3651491667;
	j3651491667 [label="O. Leon Allard",shape=box,color=blue];
