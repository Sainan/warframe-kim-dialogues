		j1362873808 -> j320737570;
	j2124778168 [label="Bez obrazy.",shape=box,color=blue];
		j2124778168 -> j703266949;
		j2124778168 -> j2595890355;
	j3236040434 [label="Once more, I digress. As I said, when the time comes. And, speaking of time, it is for me to leave you now.",shape=box,color=blue];
		j3236040434 -> j3263533434;
	j3074599669 [label="While I despise admitting it, Marie and I would still be bumbling about attempting to discern how to use half the equipment in this building, while he would wield it with ease.",shape=box,color=blue];
		j3074599669 -> j6789039;
