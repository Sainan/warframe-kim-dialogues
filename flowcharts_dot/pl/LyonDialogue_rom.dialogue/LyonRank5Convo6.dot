		j2480936299 -> j112276157;
	j1025208160 [label="Czy mógłbyś poprosić Marię, aby przestała wykorzystywać nekramity do replikowania mebli? Nie mam pojęcia co począć z tymi wszystkimi krzesłami.",shape=box,color=blue];
		j1025208160 -> j3286802293;
	j2828691090 [label="Dlatego też powstał termin \"zbrodni w afekcie\". Gdybyśmy nie pozostawali wierni swoim przekonaniem, sądzę, że świat stałby się nadwyraz nudny.",shape=box,color=blue];
		j2828691090 -> j2670506598;
	j112276157 [label="Tak zrobiła. Każdej nocy rozmawiamy o wydarzeniach dnia, a po waszej rozmowie prędko przybyła do mojego boku, by podzielić się swoimi przemyśleniami.",shape=box,color=blue];
		j112276157 -> j1158977206;
		j112276157 -> j1615513468;
	j3286802293 [label="+20 Chemistry",color=orange];
		j3286802293 -> j3606643197;
	j2670506598 [label="Z pewnością byłoby ciszej. Spokojniej. Ale też nudniej. I raczej nie zaistniałaby w takim życiu sztuka.",shape=box,color=blue];
		j2670506598 -> j419830604;
	j1158977206 [label="Co ona ci powiedziała?",shape=box,color=red];
		j1158977206 -> j3495933037;
	j1615513468 [label="... I?",shape=box,color=red];
		j1615513468 -> j3495933037;
	j3606643197 [label="A ja odmawiam rozmowy na temat jej... barwnych opisów, w której części anatomii Roathe'a mogłyby się one znaleźć.",shape=box,color=blue];
		j3606643197 -> "Chat ends.";
	j419830604 [label="Odbiegam jednak od tematu. Zastanawiam się, w naszej rozmowie zabrzmiałoby to, jakby twoje słowa ją poruszyły. Muszę zapytać, czy jesteś zadowolony z tego, jak mają się sprawy między wami?",shape=box,color=blue];
		j419830604 -> j1424199455;
