		j1607505180 -> j991827702;
	j1965293069 [label="Nie, ale zależy mi na obronie tych, którzy tego potrzebują. Nie jestem w stanie bronic ich i tego miejsca przed Szeptem i Plagą w nieskończoność. Ale wasza dwójka, i może nawet Roathe, tak.",shape=box,color=red];
		j1965293069 -> j991827702;
	j2924740923 [label="Nie do końca mu ufam, ale nie uważam, żeby był naszym wrogiem. Czuję, że nadciąga wojna, a my wszyscy zostaliśmy rozstawieni jak pionki na planszy. Jesteśmy tam, gdzie powinniśmy być.",shape=box,color=red];
		j2924740923 -> j3801600537;
