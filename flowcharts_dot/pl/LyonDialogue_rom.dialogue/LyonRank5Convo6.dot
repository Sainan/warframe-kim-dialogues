	j3027638055 [label="Nie jestem dumny z rzeczy, które powiedziałem, ale...",shape=box,color=red];
		j3027638055 -> j1064740223;
	j2480936299 [label="Powiedziała ci, prawda?",shape=box,color=red];
		j2480936299 -> j112276157;
	j3293942968 [label="Czy mógłbyś poprosić Marię, aby przestała wykorzystywać nekramity do replikowania mebli? Nie mam pojęcia co począć z tymi wszystkimi krzesłami.",shape=box,color=blue];
		j3293942968 -> j2581524567;
	j1064740223 [label="There is a reason why the term \"crime of passion\" was invented, after all. If we as creatures were not adhered to our beliefs, life would be terribly dull, I think.",shape=box,color=blue];
		j1064740223 -> j1589530403;
	j112276157 [label="Tak zrobiła. Każdej nocy rozmawiamy o wydarzeniach dnia, a po waszej rozmowie prędko przybyła do mojego boku, by podzielić się swoimi przemyśleniami.",shape=box,color=blue];
		j112276157 -> j1158977206;
		j112276157 -> j1615513468;
	j2581524567 [label="+20 Chemistry",color=orange];
		j2581524567 -> j3485508722;
	j1589530403 [label="Certainly quieter. More peaceful. But dull. There certainly would be no art to speak of.",shape=box,color=blue];
		j1589530403 -> j2144596471;
	j1158977206 [label="Co ona ci powiedziała?",shape=box,color=red];
		j1158977206 -> j3495933037;
	j1615513468 [label="... I?",shape=box,color=red];
		j1615513468 -> j3495933037;
	j3485508722 [label="And I refuse to take her... colorful suggestions as to where inside Roathe's anatomy they are intended to be stored.",shape=box,color=blue];
		j3485508722 -> "Chat ends.";
	j2144596471 [label="But I digress. I wonder - in my conversations with her, it sounds as though your words were moving. I have to ask - were you pleased with how you left matters between you?",shape=box,color=blue];
		j2144596471 -> j1424199455;
	j3495933037 [label="Check boolean LyonDating",color=orange];
		j3495933037 -> j123177775 [label=true,color=green];
		j3495933037 -> j286216958 [label=false,color=brown];
	j1424199455 [label="Evaluate expressions",color=orange];
		j1424199455 -> j1983390894 [label="MarieDating, MarieFamilyFail",color=purple];
		j1424199455 -> j2037822698 [label="MarieDating, MarieFamilyFail",color=purple];
		j1424199455 -> j3168048859 [label="MarieFamilyFail",color=purple];
		j1424199455 -> j1209068455 [label="MarieFamilyFail",color=purple];
		j1424199455 -> j1983390894 [label="MarieFamilySuccess",color=purple];
		j1424199455 -> j36279040 [label="MarieEntratiCompleteA",color=purple];
		j1424199455 -> j2360331052 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j1099287565 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j3234001550 [label="MarieEntratiCompleteC",color=purple];
		j1424199455 -> j1822202607 [label="false",color=purple];
	j123177775 [label="Ha! As though I would betray her confidence to you. As precious as you are to me, mon miracle - she has been the sister of my soul for many, many long years.",shape=box,color=blue];
		j123177775 -> j3190964011;
	j286216958 [label="Ha! As though I would betray her confidence to you. As precious as you are to me, my friend - she has been the sister of my soul for many, many long years.",shape=box,color=blue];
		j286216958 -> j3190964011;
	j1983390894 [label="I am. I think have her help in mending things between Loid and the family upstairs. And that's... Huge, Lyon. I don't think I can explain how huge.",shape=box,color=red];
		j1983390894 -> j2272513289;
	j2037822698 [label="No - Honestly, the way things have been left between us, I've ruined any chance I have of having her help mend things between Loid and the family upstairs.",shape=box,color=red];
		j2037822698 -> j785546495;
	j3168048859 [label="No - Honestly, the way things have been left between us, I've ruined any chance I have of having her help mend things between Loid and the family upstairs.",shape=box,color=red];
		j3168048859 -> j3651528583;
	j1209068455 [label="I am. She won't help me mend Loid and the family upstairs, and that's fine with me.",shape=box,color=red];
		j1209068455 -> j2443997046;
	j36279040 [label="I am. I'm glad she saw that Entrati may not be purely \"good,\" and... well, he's not purely \"evil\" either, is he?",shape=box,color=red];
		j36279040 -> j910048816;
	j2360331052 [label="I'm happy with where I left things. I'm on her side about Entrati, honestly, the more that I've thought about it.",shape=box,color=red];
		j2360331052 -> j2443997046;
	j1099287565 [label="We didn't see eye-to-eye on Entrati. I failed in convincing her and... I just wish I could have done better.",shape=box,color=red];
		j1099287565 -> j562224201;
	j3234001550 [label="We \"agreed to disagree\" on Entrati, and I think that's about as good as we're ever going to get on the subject. I don't think any more talk is going to help matters.",shape=box,color=red];
		j3234001550 -> j34698647;
	j1822202607 [label="Honestly, it's fine. I don't think it's going to get any better or worse at this point.",shape=box,color=red];
		j1822202607 -> j34698647;
	j3190964011 [label="No, I fear her words to me shall be kept my secret. But they were moving to her, all the same. I wonder though, were you pleased with how you left matters between you?",shape=box,color=blue];
		j3190964011 -> j1424199455;
	j2272513289 [label="I do believe I can fathom the grandeur of it, if not the magnitude. I am... quite honored to be a part of it, in some small way.",shape=box,color=blue];
		j2272513289 -> j2935663643;
		j2272513289 -> j4055608771;
	j785546495 [label="Fascinating... Well, you are her lover now, are you not? If anyone in this place were to have the influence to convince her - it would be you, yes?",shape=box,color=blue];
		j785546495 -> j2309154412;
	j3651528583 [label="Fascinating... Well, I have been known to have some... influence over her, limited as it may be. You feel as though this mending of relationships between M. Loid and Entrati's estranged family is important?",shape=box,color=blue];
		j3651528583 -> j1038111982;
		j3651528583 -> j2983632313;
	j2443997046 [label="I cannot tell if that is the tone of petulance, arrogance, ignorance, or apathy. I will therefore settle upon a mixture of all four, and move along with my day.",shape=box,color=blue];
		j2443997046 -> j963564661;
	j910048816 [label="Indeed. I am of a similar mindset as you. I don't believe him to be one way or the other, yet... mixed in his motivations.",shape=box,color=blue];
		j910048816 -> j896022814;
	j562224201 [label="Hm. Well, unfortunately, there comes a time when all things must be put to rest. A dough can be over-worked. A artist can add too much their painting. And an argument can certainly be overwrought.",shape=box,color=blue];
		j562224201 -> j402935459;
	j34698647 [label="Yes, perhaps it is better for topics to move on to greener pastures.",shape=box,color=blue];
		j34698647 -> j2222416481;
	j2935663643 [label="I didn't think you'd offer to help.",shape=box,color=red];
		j2935663643 -> j1776312677;
	j4055608771 [label="Does this mean you'll help me convince Loid to go upstairs and talk to them?",shape=box,color=red];
		j4055608771 -> j3495472484;
	j2309154412 [label="I simply hope you did not make some manner of sacrifice in your words to her - placing one priority over another in an attempt to woo her.",shape=box,color=blue];
		j2309154412 -> j2581849028;
	j1038111982 [label="There's so much loneliness in this world, Lyon. So much sadness. Why not end some of it when we can? ",shape=box,color=red];
		j1038111982 -> j143093239;
	j2983632313 [label="I'm not sure, it's an instinct - a gut feeling. I feel like you three were brought here by Entrati this moment for a reason.",shape=box,color=red];
		j2983632313 -> j1356734450;
	j963564661 [label="Shame.",shape=box,color=blue];
		j963564661 -> j3497962379;
	j896022814 [label="Hubris drove him. A greed for knowledge. Now, perhaps, a greed for forgiveness. Who is to say? I wonder even if he knows, himself.",shape=box,color=blue];
		j896022814 -> j2577152489;
	j402935459 [label="I suppose I would simply choose to let this go. And hope that some day she might have the chance to see Entrati for what we know him to be - at the very best, complicated.",shape=box,color=blue];
		j402935459 -> j2577152489;
	j2222416481 [label="I, for one, am ready for them to drift away from endless conversations regarding the wondrous and faultless \"le Cardinal.\"",shape=box,color=blue];
		j2222416481 -> j2577152489;
	j1776312677 [label="I know I am not terribly affable, but neither am I some ghoul. If you would like my assistance, you shall have it.",shape=box,color=blue];
		j1776312677 -> j2800191596;
	j3495472484 [label="Of course. If you would like my assistance, you shall have it.",shape=box,color=blue];
		j3495472484 -> j2800191596;
	j2581849028 [label="What a sorry state of affairs that would be.",shape=box,color=blue];
		j2581849028 -> j2152768158;
	j143093239 [label="Hm. And what of the possible pain a reintroduction might cause between the involved parties when such revelations are made?",shape=box,color=blue];
		j143093239 -> j733394605;
		j143093239 -> j1119820085;
	j1356734450 [label="And are you in the business of going about doing the bidding of Entrati on the influence of a \"gut feeling?\"",shape=box,color=blue];
		j1356734450 -> j4236523639;
		j1356734450 -> j3030182339;
	j3497962379 [label="Boolean LyonFamilyFail is now true.",color=orange];
		j3497962379 -> "Chat ends.";
	j2577152489 [label="I do not know how matters will play out between M. Loid and Entrati's estranged family. I merely wished to say that if you are in need of my assistance, you shall have it.",shape=box,color=blue];
		j2577152489 -> j2800191596;
	j2800191596 [label="Evaluate expressions",color=orange];
		j2800191596 -> j2977652912 [label="RoatheFamilyDelay",color=purple];
		j2800191596 -> j3131515230 [label="RoatheFamilyFail",color=purple];
		j2800191596 -> j2419006471 [label="false",color=purple];
	j2152768158 [label="You shall have my aid, what little good it will do you.",shape=box,color=blue];
		j2152768158 -> j3326134915;
	j733394605 [label="It will hurt at first, for sure. Like setting a broken bone. But it's the only way something like this can heal properly.",shape=box,color=red];
		j733394605 -> j3341464600;
	j1119820085 [label="I think what we all stand to gain by being together is greater than what we stand to lose by being apart.",shape=box,color=red];
		j1119820085 -> j3341464600;
	j4236523639 [label="No, but I am in the business of protecting people who need it. And I can't guard them, and this place, from the Murmur and the Infestation forever. But you two - and maybe even Roathe - can.",shape=box,color=red];
		j4236523639 -> j3341464600;
	j3030182339 [label="I don't trust him, necessarily - but I still don't think he's our enemy. I feel like a war is coming, and we're all being placed on the board where we need to be. And this is where we belong.",shape=box,color=red];
		j3030182339 -> j2084070343;
	j2977652912 [label="Though I believe you have already completed that which was the most onerous task - convincing Roathe.",shape=box,color=blue];
		j2977652912 -> j6789039;
	j3131515230 [label="Though I will have to sit and think on how to convince Roathe to change his mind... which I am not certain I will be able to do. And without him, it may be a lost cause.",shape=box,color=blue];
		j3131515230 -> j3307003323;
		j3131515230 -> j311002999;
	j2419006471 [label="Though the hardest to convince is, I dread to consider, likely the most important - Roathe.",shape=box,color=blue];
		j2419006471 -> j3307003323;
		j2419006471 -> j311002999;
	j3326134915 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j3326134915 -> j1721305196;
	j3341464600 [label="+20 Chemistry",color=orange];
		j3341464600 -> j2099597767;
	j2084070343 [label="Mm. Perhaps. But we are not chess pieces, and I refuse to be treated as such. If Entrati wishes to make such an appeal, he can send a damnable letter.",shape=box,color=blue];
		j2084070343 -> j1822829738;
	j6789039 [label="The damnable bastard is - as much as I do very much wish I could find a method by which to secure his mouth closed - useful.",shape=box,color=blue];
		j6789039 -> j3941867773;
	j3307003323 [label="Tak...",shape=box,color=red];
		j3307003323 -> j6789039;
	j311002999 [label="Why is Roathe even that important to this whole thing?",shape=box,color=red];
		j311002999 -> j2188819276;
	j1721305196 [label="Leon",shape=box,color=blue];
		j1721305196 -> j1933300832;
	j2099597767 [label="Indeed. Wise words. Very well. I will speak to her. I will see if I can convince her to talk to you again regarding this.",shape=box,color=blue];
		j2099597767 -> j3901814660;
		j2099597767 -> j870248256;
	j1822829738 [label="In this way, I fear I side with the complaints of M. Loid. You may have my assistance in convincing him, but I do not think you will get far without Marie.",shape=box,color=blue];
		j1822829738 -> j1362873808;
	j3941867773 [label="Check boolean RoatheDating",color=orange];
		j3941867773 -> j2124778168 [label=true,color=green];
		j3941867773 -> j3236040434 [label=false,color=brown];
	j2188819276 [label="Marie and I are outsiders. Roathe, Loid, Entrati, and Entrati's daughter are all contemporaries. Not to mention, he has knowledge he might utilize to protect them, should things go awry.",shape=box,color=blue];
		j2188819276 -> j3074599669;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
