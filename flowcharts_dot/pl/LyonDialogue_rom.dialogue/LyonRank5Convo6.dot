		j2222111486 -> j3339290944;
	j3875082673 [label="Chociaż będę musiał przysiąść i zastanowić się, jak nakłonić Roathe'a... nie wiem, czy zdołam. A bez niego, jesteśmy skazani na porażkę.",shape=box,color=blue];
