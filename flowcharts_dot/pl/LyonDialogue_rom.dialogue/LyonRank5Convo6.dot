		j1424199455 -> j2773978333 [label="false",color=purple];
	j1537496213 [label="Ha! Nie śmiałbym zawieść jej zaufania. Choć jesteś mi bardzo bliski, mon miracle, ona była siostrą mojej duszy przez wiele, wiele lat.",shape=box,color=blue];
		j1537496213 -> j2088239718;
	j1915983584 [label="Ha! Nie śmiałbym zawieść jej zaufania. Choć jesteś mi bliskim przyjacielem, ona była siostrą mojej duszy przez wiele, wiele lat.",shape=box,color=blue];
		j1915983584 -> j2088239718;
	j2560621138 [label="Tak. Myślę, że pomoże mi w naprawie relacji między Loidem i rodziną. A to... wielki przełom, Leonie. Nie mogę wyrazić, jak bardzo jest to ważne.",shape=box,color=red];
		j2560621138 -> j823289615;
	j1109768182 [label="Nie, szczerze mówiąc, zrujnowałem nasze szanse na pojednanie Loida i rodziny nad nami.",shape=box,color=red];
		j1109768182 -> j573656919;
	j1152189781 [label="Nie, szczerze mówiąc, zrujnowałem nasze szanse na pojednanie Loida i rodziny nad nami.",shape=box,color=red];
		j1152189781 -> j2899782786;
	j1345050385 [label="Tak. Nie pomoże mi pogodzić Loida z rodziną na górze, ale nie przeszkadza mi to.",shape=box,color=red];
		j1345050385 -> j4171950634;
	j1348211668 [label="Tak. Cieszę się, że zrozumiała, że Entrati nie był całkowicie dobry i... cóż, nie był też całkowicie zły, prawda?",shape=box,color=red];
		j1348211668 -> j2018376364;
	j3714777820 [label="Cieszę się z tego, jak sprawy się potoczyły. Im więcej się dowiedziałem, tym bardziej podzielałem jej zdanie na temat Entratiego.",shape=box,color=red];
		j3714777820 -> j4171950634;
	j3965373870 [label="Nie zgadzaliśmy się w sprawie Entratiego. Próbowałem ją przekonać i... żałuję, że nie zdołałem zrobić tego lepiej.",shape=box,color=red];
		j3965373870 -> j2147930142;
	j2648412704 [label="Zgodziliśmy się, że pozostaniemy niezgodni w sprawie Entratiego, ale to chyba najlepsze rozwiązanie. Wątpię, żeby dalsza dyskusja na ten temat miała jakąkolwiek wartość.",shape=box,color=red];
		j2648412704 -> j1836152109;
	j2773978333 [label="Jest w porządku. Nie sądzę, żeby sprawy mogły się zmienić między nami.",shape=box,color=red];
		j2773978333 -> j1836152109;
	j2088239718 [label="Nie, obawiam się, że jej słowa pozostaną znane tylko mnie. Ale niemniej poruszyłeś ją. Zastanawiam się, czy jesteś zadowolony z tego, jak mają się sprawy między wami?",shape=box,color=blue];
		j2088239718 -> j1424199455;
	j823289615 [label="Wierzę, że potrafię pojąć znaczenie, choćby w części. Jestem... zaszczycony, że mogę być tego częścią.",shape=box,color=blue];
		j823289615 -> j3644718708;
		j823289615 -> j450803222;
	j573656919 [label="Fascynujące... Teraz jesteście kochankami, czyż nie? Jeśli ktokolwiek tutaj mógłby ją przekonać, byłbyś to ty, prawda?",shape=box,color=blue];
		j573656919 -> j841023965;
	j2899782786 [label="Fascynujące.... Wiadome było, że mam na nią... pewien ograniczony wpływ. Uważasz, że pojednanie M. Loida i porzuconej rodziny Entratiego jest kluczowe?",shape=box,color=blue];
		j2899782786 -> j3858256493;
		j2899782786 -> j2307219972;
	j4171950634 [label="Nie potrafię stwierdzić, czy to ton złości, arogancji, ignorancji czy apatii. Uznam więc, że to wszystko po trochu i wrócę do swoich obowiązków.",shape=box,color=blue];
		j4171950634 -> j3404413764;
	j2018376364 [label="W rzeczy samej. Podzielam twoje zdanie, nie uważam, że jest w pełni oddany jednej ze stron... kroczy pomiędzy nimi.",shape=box,color=blue];
		j2018376364 -> j3696727474;
	j2147930142 [label="Hmm. Niestety, przychodzi czas, kiedy trzeba pozostawić sprawy, jakimi są. Ciasto można przepracować. Artysta może zawrzeć zbyt wiele w swoim dziele. A kłótnia z pewnością może zostać przeciągnięta.",shape=box,color=blue];
		j2147930142 -> j3889326625;
	j1836152109 [label="Tak, może lepiej będzie, abyście przeszli do przyjemniejszych tematów.",shape=box,color=blue];
		j1836152109 -> j3596528923;
	j3644718708 [label="Nie spodziewałem się, że zechcesz mi pomóc.",shape=box,color=red];
		j3644718708 -> j4123357593;
	j450803222 [label="Czy to znaczy, że pomożesz mi przekonać Loida, żeby z nimi porozmawiał?",shape=box,color=red];
		j450803222 -> j1075832156;
	j841023965 [label="Mam tylko nadzieję, że w swych słowach nie zmusiłeś siebie do poświęcenia, zmiany swoich priorytetów, aby jej zaimponować.",shape=box,color=blue];
		j841023965 -> j1852037172;
	j3858256493 [label="Na tym świecie jest tyle samotności, Leonie. Tyle smutku. Dlaczego nie ulżyć, chociaż części z tego, kiedy mamy okazję?",shape=box,color=red];
		j3858256493 -> j1721434694;
	j2307219972 [label="Nie jestem pewien, to przekonanie, instynkt. Czuję, że Entrati sprowadził tu waszą trójkę z jakiegoś powodu.",shape=box,color=red];
		j2307219972 -> j1941973284;
	j3404413764 [label="Szkoda.",shape=box,color=blue];
		j3404413764 -> j3497962379;
	j3696727474 [label="Kierowała nim pycha. Głód wiedzy. A teraz, może nawet pragnienie przebaczenia. Kto wie? Zastanawiam się, czy on sam siebie rozumie.",shape=box,color=blue];
		j3696727474 -> j2884568125;
	j3889326625 [label="Myślę, że na twoim miejscu bym odpuścił. Ale miał nadzieję na to, że pewnego dnia ujrzy Entratiego takim, jakim widzimy go my, bardzo skomplikowanego człowieka.",shape=box,color=blue];
		j3889326625 -> j2884568125;
	j3596528923 [label="Osobiście jestem gotów odejść od niekończących się wywodów na temat cudownego i nieskazitelnego \"le Cardinal\".",shape=box,color=blue];
		j3596528923 -> j2884568125;
	j4123357593 [label="Wiem, że nie bywam szczególnie uprzejmy, ale nie jestem też potworem. Jeśli zechcesz mojej pomocy, możesz na nią liczyć.",shape=box,color=blue];
		j4123357593 -> j2800191596;
	j1075832156 [label="Oczywiście, jeśli zechcesz mojej pomocy, możesz na nią liczyć.",shape=box,color=blue];
