	"LyonRank3Convo1 begins." [color=orange];
		"LyonRank3Convo1 begins." -> j4056534885;
	j4056534885 [label="Witaj, Włóczęgo.",shape=box,color=blue];
		j4056534885 -> j3908569279;
	j3908569279 [label="Doszły mnie słuchy, iż pragniesz ze mną porozmawiać.",shape=box,color=blue];
		j3908569279 -> j3989850214;
		j3908569279 -> j1549880651;
		j3908569279 -> j1150498580;
	j3989850214 [label="Rozmowa z tobą stanowi czystą przyjemność, Leonie. Dziękuję.",shape=box,color=red];
		j3989850214 -> j1626567970;
	j1549880651 [label="Maria w końcu cię przekonała, że nie stanowię zagrożenia?",shape=box,color=red];
		j1549880651 -> j2818689802;
	j1150498580 [label="Och! Witaj, Leonie. Szczerze mówiąc, to nie spodziewałem się, że dasz się przekonać. Cieszę się, że zmieniłeś zdanie.",shape=box,color=red];
		j1150498580 -> j2524558150;
	j1626567970 [label="Jeszcze może okazać się, że zmienisz zdanie, ale cóż. Przyjemność po mojej stronie.",shape=box,color=blue];
		j1626567970 -> j2417626589;
		j1626567970 -> j1213705070;
	j2818689802 [label="Nie podsuwaj mi tak szybko argumentów, bym zmienił zdanie.",shape=box,color=blue];
		j2818689802 -> j1933300832;
	j2524558150 [label="No cóż. Możesz nie być w tak dobrym nastroju, gdy już wszystko usłyszysz i zrobisz, co masz zrobić.",shape=box,color=blue];
		j2524558150 -> j2417626589;
		j2524558150 -> j1213705070;
	j2417626589 [label="Dowiedziałem się od innych, że chcesz omówić pewne sprawy. W czym ci mogę pomóc?",shape=box,color=red];
		j2417626589 -> j179855483;
	j1213705070 [label="Coś się stało?",shape=box,color=red];
		j1213705070 -> j1765481244;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j179855483 [label="Być może przyjdzie na to pora. Ale dopiero rozpoczęliśmy nasz dyskurs. Wszedłem tu tylko po to... by powiedzieć ci, że uległem naleganiom Marii, iż można ci zaufać w kwestii rozmowy.",shape=box,color=blue];
		j179855483 -> j2777944732;
	j1765481244 [label="Cóż za niemal komicznie wybrakowane pytanie, na które nawet nie spróbuję udzielić odpowiedzi, gdyż dopiero co rozpoczęliśmy nasz dyskurs. Wszedłem tu tylko po to... by powiedzieć ci, że uległem naleganiom Marii, iż można ci zaufać w kwestii rozmowy.",shape=box,color=blue];
		j1765481244 -> j2777944732;
	"Chat ends." [color=orange];
	j2777944732 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j2777944732 -> j4032717590 [label="x > 0",color=purple];
		j2777944732 -> j1581697876 [label="x <= 0",color=purple];
		j2777944732 -> j1581697876 [label="false",color=purple];
	j4032717590 [label="Patrząc na to, że jesteśmy teraz partnerami w tym przedsięwzięciu, które Roathe realizuje \"diabelskim\" kosztem? Wydaje się, że rozsądnym zachowaniem będzie bliższe poznanie się. Pokuszę się o stwierdzenie, że wolisz to zrobić w ten właśnie sposób. Więc oto jestem.",shape=box,color=blue];
		j4032717590 -> j1446146925;
		j4032717590 -> j413167609;
	j1581697876 [label="Patrząc na to, że nie wiadomo, jak długo będziemy partnerami w tym przedsięwzięciu, które Roathe realizuje \"diabelskim\" kosztem? Wydaje się, że rozsądnym zachowaniem będzie bliższe poznanie się. Zakładam, że wolisz to zrobić w ten właśnie sposób. Więc oto jestem.",shape=box,color=blue];
		j1581697876 -> j1446146925;
		j1581697876 -> j413167609;
	j1446146925 [label="Mam przeczucie, że już na samym początku zrobiłem coś nie tak.",shape=box,color=red];
		j1446146925 -> j325671039;
	j413167609 [label="Czy... wolałbyś to zrobić w inny sposób?",shape=box,color=red];
		j413167609 -> j3356810316;
	j325671039 [label="Nie. To nie prawda. Po prostu diametralnie różnię się od osób, z którymi przyszło ci rozmawiać do tej pory. Do tej pory sprzyjały ci niebiosa, gdyż nie jest łatwo znaleźć lunatyków mojego pokroju.",shape=box,color=blue];
		j325671039 -> j1685863273;
	j3356810316 [label="Nie. To jest do przyjęcia. Co więcej, umożliwia mi to zebranie i zwerbalizowanie myśli tak, jak tego chcę. Już rozumiem, dlaczego ten wynalazek cieszy się takim powodzeniem.",shape=box,color=blue];
		j3356810316 -> j4237465591;
	j1685863273 [label="Odbiegam od tematu. Obawiam się, że nie spędzę tu zbyt dużo czasu na \"pisaniu\", co bez wątpienia cię rozczaruje. Chciałem tylko cię poinformować o mojej kapitulacji.",shape=box,color=blue];
		j1685863273 -> j1305127239;
		j1685863273 -> j1401037913;
	j4237465591 [label="Obawiam się jednak, że nie spędzę tu zbyt dużo czasu na \"pisaniu\", co bez wątpienia cię rozczaruje. Chciałem tylko cię poinformować o mojej kapitulacji.",shape=box,color=blue];
		j4237465591 -> j1401037913;
		j4237465591 -> j1305127239;
	j1305127239 [label="Maria jest bardziej niebezpieczna, niż wygląda, prawda?",shape=box,color=red];
		j1305127239 -> j2428788198;
	j1401037913 [label="Powiem to jeszcze raz: dziękuję.",shape=box,color=red];
		j1401037913 -> j3517201296;
	j2428788198 [label="+20 Chemistry",color=orange];
		j2428788198 -> j3808860472;
	j3517201296 [label="+15 Chemistry",color=orange];
		j3517201296 -> j3784714070;
	j3808860472 [label="Ledwo co zacząłeś dostrzegać, co się kryje pod powierzchnią wody.",shape=box,color=blue];
		j3808860472 -> j3651491667;
	j3784714070 [label="I jeśli to ma jakieś znaczenie, jesteś... mile widziany.",shape=box,color=blue];
		j3784714070 -> j3651491667;
	j3651491667 [label="O. Leon Allard",shape=box,color=blue];
		j3651491667 -> "Chat ends.";
}