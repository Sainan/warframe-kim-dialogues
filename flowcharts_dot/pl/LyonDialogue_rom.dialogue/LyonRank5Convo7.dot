		j4132121638 -> j2868858463;
	j1964990035 [label="I właśnie dlatego nie jestem w stanie wyrazić tego, co czuje moje serce. Ale jestem ci dozgonnie wdzięczny, że nasze samotne, pogrążone w bólu dusze mogły się odnaleźć.",shape=box,color=blue];
