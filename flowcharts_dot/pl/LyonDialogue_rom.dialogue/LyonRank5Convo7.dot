		j1738813062 -> j1076946694;
	j485489215 [label="Cieszę się, że podobają ci się moje dygresje. Właśnie dlatego wolę za dużo nie mówić. Wyobrażasz sobie znosić to twarzą w twarz? Maria już dawno pokazałaby mi, gdzie raki zimują.",shape=box,color=blue];
		j485489215 -> j1076946694;
	j140948287 [label="Jest w tobie pewna doza bezczelności i sarkazmu, do której z natury jestem przyzwyczajony, ale sam bym się do niej nie posunął. To twoja domena.",shape=box,color=blue];
