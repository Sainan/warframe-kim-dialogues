	j1076946694 [label="Niemniej jednak wszystko to miało służyć za pretekst do opowieści, która będzie teraz wydawała się stosunkowo krótka w porównaniu do całej reszty...",shape=box,color=blue];
		j1076946694 -> j540224659;
	j540224659 [label="Zeszłej nocy obudziłem się z koszmaru. Otaczały mnie cienie. To żadna nowość, biorąc pod uwagę stan mojego umysłu. Majaczyły nad łóżkiem i nie chciały zniknąć.",shape=box,color=blue];
		j540224659 -> j3437655253;
	j3437655253 [label="Nie bałem się ich, bo wiedziałem, że nie mogą mnie skrzywdzić. Ale nie chciały też zniknąć z mojej pamięci. Był tylko jeden sposób, by się ich pozbyć.",shape=box,color=blue];
		j3437655253 -> j3030281373;
	j3030281373 [label="Po wygramoleniu się z łóżka ubrałem się najlepiej, jak potrafiłem, chwiejąc się przez zaburzenia widzenia spowodowane nieustającym koszmarem. Chwyciłem kadzielnicę i padłem na kolana na środku pokoju, przygotowując się do... no cóż. ",shape=box,color=blue];
		j3030281373 -> j787555274;
