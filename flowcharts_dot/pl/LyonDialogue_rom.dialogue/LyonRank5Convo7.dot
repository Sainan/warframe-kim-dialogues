	j3646883037 [label="Jak się dzisiaj miewasz, Leonie?",shape=box,color=red];
		j3646883037 -> j2482801669;
	j3581062560 [label="[Wyznaj uczucia] Leonie? Chciałbym z tobą o czymś porozmawiać.",shape=box,color=red];
		j3581062560 -> j1512992102;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j802785318 [label="Jest to dla mnie niezmiernie ważne, abyś uważnie przeczytał moje słowa. Rozumiesz?",shape=box,color=blue];
		j802785318 -> j577126261;
		j802785318 -> j2568138074;
