		j2183298434 -> j3095950926 [label=false,color=brown];
		j2183298434 -> j3160513667 [label=false,color=brown];
	j3904956628 [label="Cieszę się, że jest ktoś, kto potrafi znaleźć w sobie siłę, by przebić się przez zawiłości osobowości Roathe'a i dostrzec to, co jest z nim nie tak.",shape=box,color=blue];
		j3904956628 -> j2915671760;
	j217480016 [label="Czy mogę zadać ci dość niedelikatne pytanie, przyjacielu?",shape=box,color=blue];
		j217480016 -> j901957267;
		j217480016 -> j4236889169;
	j2482801669 [label="Cóż za dobrotliwe i uroczo prozaiczne pytanie. Nieczęsto je słyszę.",shape=box,color=blue];
		j2482801669 -> j2123703713;
	j1512992102 [label="Tak? O co chodzi? Coś się stało?",shape=box,color=blue];
		j1512992102 -> j285748197;
		j1512992102 -> j996296146;
	j577126261 [label="Zaczynam się niepokoić. Co się stało?",shape=box,color=red];
		j577126261 -> j2191081622;
	j2568138074 [label="Tak, rozumiem. Możesz zaczynać.",shape=box,color=red];
		j2568138074 -> j3112453254;
	j590322451 [label="Nie spodziewałem się, że tak to odbierzesz, bo...",shape=box,color=red];
		j590322451 -> j3832890395;
	j3095950926 [label="Wzbudza we mnie... zachwyt.",shape=box,color=red];
		j3095950926 -> j1316420446;
	j3160513667 [label="Czy to jest ta rozmowa, w której zaczniesz mi grozić?",shape=box,color=red];
		j3160513667 -> j460777868;
	j2915671760 [label="Choć on sam temu stanowczo zaprzecza, to wiem, że sam uważa się za tchórza. Ja bym go tak nie nazwał.",shape=box,color=blue];
		j2915671760 -> j3217494059;
	j901957267 [label="Oczywiście. Ja zadaję ci ich całe mnóstwo.",shape=box,color=red];
		j901957267 -> j2920555125;
	j4236889169 [label="Dlaczego spotykam się z Roathem?",shape=box,color=red];
		j4236889169 -> j1919176339;
	j2123703713 [label="Mam się... całkiem nieźle. Dziękuję.",shape=box,color=blue];
		j2123703713 -> j4215152090;
	j285748197 [label="Nieważne. Przepraszam. Zapomniałem już, co chciałem powiedzieć.",shape=box,color=red];
		j285748197 -> j3258496885;
	j996296146 [label="Nie wiem, jak to najlepiej ująć, więc powiem to wprost – coś do ciebie czuję.",shape=box,color=red];
		j996296146 -> j2846855504;
	j2191081622 [label="Nic złego – wręcz przeciwnie. Dlatego kluczowe jest, żebyś to zrozumiał – chcę cię uchronić przed tragicznymi konsekwencjami, które mogą nadejść.",shape=box,color=blue];
		j2191081622 -> j1507238061;
		j2191081622 -> j1214781166;
		j2191081622 -> j3433894046;
	j3112453254 [label="+5 Chemistry",color=orange];
		j3112453254 -> j2096947649;
	j3832890395 [label="Ha. Myślisz, że jestem zaskoczony? Od zawsze stoję w cieniu jej blasku i tak już pozostanie. Nie, mój przyjacielu – nie jestem z tego powodu ani rozgoryczony ani zazdrosny. Masz moje słowo.",shape=box,color=blue];
		j3832890395 -> j628823701;
	j1316420446 [label="Tak jak my wszyscy. Moja siostrzana dusza nigdy nie przestanie mnie zadziwiać. Moje słowa nie są w stanie wyrazić, jak się cieszę z waszego szczęścia.",shape=box,color=blue];
		j1316420446 -> j2476632459;
	j460777868 [label="Hm? Nie. Nie jestem taki pewny siebie, by udawać jej stróża i wtrącać się na każdym kroku. Ona sama jest w stanie przetrzepać ci skórę, jeśli uzna, że ci się należy.",shape=box,color=blue];
		j460777868 -> j2926879898;
	j3217494059 [label="Entrati powiedział mu, że będzie potrzebny, by ocalić przyszłość, której nie znał. Przyszłość, nad którą nie piastował królewskiej władzy, bez ludzi płaszczących się mu do stóp i bez sług oddających mu cześć.",shape=box,color=blue];
		j3217494059 -> j526956158;
	j2920555125 [label="Co takiego... dostrzegasz w Roathe'u, że zaczęliście... smalić do siebie cholewki?",shape=box,color=blue];
		j2920555125 -> j1274671375;
		j2920555125 -> j268216188;
		j2920555125 -> j3803096828;
	j1919176339 [label="Widzę, że już ktoś ci zadał to pytanie, albo najzwyczajniej w świecie spodziewałeś się go. Tak. Właśnie to pytanie. Co... w nim widzisz?",shape=box,color=blue];
		j1919176339 -> j1274671375;
		j1919176339 -> j268216188;
		j1919176339 -> j3803096828;
	j4215152090 [label="+20 Chemistry",color=orange];
		j4215152090 -> j134533538;
	j3258496885 [label="Często mi się to zdarza. Zwłaszcza gdy przechodzę przez drzwi. Zastanawiam się, dlaczego właśnie wtedy.",shape=box,color=blue];
		j3258496885 -> j1523065705;
	j2846855504 [label="Ja... jesteś tego... pewny? Wszystko w porządku? Chyba nie uderzyłeś się ostatnio w głowę, co?",shape=box,color=blue];
		j2846855504 -> j3658360098;
		j2846855504 -> j2908385544;
	j1507238061 [label="Słucham.",shape=box,color=red];
		j1507238061 -> j2909722009;
	j1214781166 [label="Twoje słowa nie mają większego sensu.",shape=box,color=red];
		j1214781166 -> j3897713198;
	j3433894046 [label="Tragicznymi konsekwencjami... czego?",shape=box,color=red];
		j3433894046 -> j1414352104;
	j2096947649 [label="Dziękuję. Zanim zaczniemy, pragnę cię zapewnić, że wszystko jest w porządku. Jednakże kluczowe jest, żebyś to zrozumiał – chcę cię uchronić przed tragicznymi konsekwencjami, które mogą nadejść.",shape=box,color=blue];
		j2096947649 -> j1507238061;
		j2096947649 -> j1214781166;
		j2096947649 -> j3433894046;
	j628823701 [label="Nie chowam urazy do tego, co między nami zaszło. Mogę jedynie wyrazić moją wdzięczność za ten cudowny czas, który razem spędziliśmy.",shape=box,color=blue];
		j628823701 -> j3238270001;
	j2476632459 [label="Z jej oczu bije taka radość, gdy o tobie mówi. Jest podekscytowana na samą tylko myśl, że możesz się pojawić.",shape=box,color=blue];
		j2476632459 -> j3728031886;
	j2926879898 [label="Chciałem ci tylko powiedzieć, że jej szczęście jest zaraźliwe – i też się uśmiecham na samą myśl o tym. Więc muszę ci za to podziękować.",shape=box,color=blue];
		j2926879898 -> j2517419488;
	j526956158 [label="Mógł to uznać za przejaw strachu – niczym szczur uciekający z tonącego statku – gdyby wziął serum i zapomniał o czynach, które do tego doprowadziły. ",shape=box,color=blue];
		j526956158 -> j3473065383;
	j1274671375 [label="Mówiąc wprost? Widziałeś go?",shape=box,color=red];
		j1274671375 -> j2018436188;
	j268216188 [label="Myślę, że gdzieś pod całym tym jego humorem i osobowością, kryje się... ból.",shape=box,color=red];
		j268216188 -> j1982828608;
	j3803096828 [label="Ja... nie mogę nic na to poradzić. Jest w nim jakiś mrok i niebezpieczeństwo, które mnie pociągają.",shape=box,color=red];
		j3803096828 -> j3583721958;
	j134533538 [label="Tak, rzeczywiście czuję się dzisiaj dosyć dobrze.",shape=box,color=blue];
		j134533538 -> j3591186650;
	j1523065705 [label="+5 Chemistry",color=orange];
		j1523065705 -> j3591186650;
	j3658360098 [label="Dlaczego tak trudno w to uwierzyć?",shape=box,color=red];
		j3658360098 -> j1167195061;
	j2908385544 [label="Jestem tego pewny, Leonie. Nie mam wstrząsu mózgu.",shape=box,color=red];
		j2908385544 -> j1167195061;
	j2909722009 [label="+5 Chemistry",color=orange];
		j2909722009 -> j2671133893;
	j3897713198 [label="Tak. Boleśnie zdaję sobie z tego sprawę.",shape=box,color=blue];
		j3897713198 -> j1414352104;
	j1414352104 [label="Pozwól, że zacznę od nowa.",shape=box,color=blue];
		j1414352104 -> j2671133893;
	j3238270001 [label="+10 Chemistry",color=orange];
		j3238270001 -> j1466352734;
	j3728031886 [label="+10 Chemistry",color=orange];
		j3728031886 -> j2926879898;
	j2517419488 [label="Leon",shape=box,color=blue];
		j2517419488 -> "Chat ends.";
	j3473065383 [label="Dostrzegam to jako człowiek, który widział kalkulacje na polu bitwy i wiedział, kiedy należy porzucić tonący statek. Bo wojna jeszcze się nie skończyła.",shape=box,color=blue];
		j3473065383 -> j1494212890;
	j2018436188 [label="Daleki jestem od tego, by cię potępiać.",shape=box,color=blue];
		j2018436188 -> j1505907079;
	j1982828608 [label="+5 Chemistry",color=orange];
		j1982828608 -> j3331896205;
	j3583721958 [label="Rozumiem ten pociąg. Nie będę zaprzeczał, że sam tego nie dostrzegam. Mam jednak nadzieję, że dla własnego dobra nie pozwolisz, by cię pochłonął.",shape=box,color=blue];
		j3583721958 -> j1769278165;
	j3591186650 [label="Życzę miłego dnia. Leon",shape=box,color=blue];
		j3591186650 -> "Chat ends.";
	j1167195061 [label="Cóż, mówiąc wprost – kiedy ma się przed sobą tak wiele opcji... Marię lub Roathe'a albo... kogokolwiek innego we wszechświecie...",shape=box,color=blue];
		j1167195061 -> j1257587833;
	j2671133893 [label="Zdaję sobie sprawę, że można mnie źle zinterpretować i całkiem możliwe, że jestem... chory. A przynajmniej nie jestem całkowicie przy zdrowych zmysłach.",shape=box,color=blue];
		j2671133893 -> j2033183891;
	j1466352734 [label="Teraz cieszę się, że spędzasz go z nią. Ona wniesie radość tam, gdzie ja mogłem przynieść ci jedynie smutek. Bądź z nią szczęśliwy. Masz moje błogosławieństwo.",shape=box,color=blue];
		j1466352734 -> j2517419488;
	j1494212890 [label="Evaluate expressions",color=orange];
		j1494212890 -> j2491859890 [label="RoatheVillian",color=purple];
		j1494212890 -> j2087130536 [label="RoatheVillian",color=purple];
		j1494212890 -> j4255522088 [label="RoatheVillian",color=purple];
		j1494212890 -> j2491859890 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j2087130536 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j2223622619 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j4255522088 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j2491859890 [label="false",color=purple];
		j1494212890 -> j2087130536 [label="false",color=purple];
	j1505907079 [label="Chociaż dla twojego dobra mam nadzieję, że ta fantazja szybko przeminie i nie przerodzi się w uzależnienie. Widziałem, jak takie rzeczy niszczą innych.",shape=box,color=blue];
		j1505907079 -> j3094695106;
	j3331896205 [label="Tak, też to dostrzegłem. Choć ukryty bardzo głęboko. Ale ta twoja wścibskość może go rozsierdzić. Sądzę, że lubi to, czym się stał.",shape=box,color=blue];
		j3331896205 -> j3094695106;
	j1769278165 [label="Tego typu sprawy nie powinny opierać się wyłącznie na... zwykłym mroku. Nie zamierzam cię jednak pouczać.",shape=box,color=blue];
		j1769278165 -> j3094695106;
	j1257587833 [label="Nie mogę uwierzyć, że zdecydowałbyś się igrać z takim rozbitym witrażem, jak ja... no... chyba że upadłeś na głowę.",shape=box,color=blue];
		j1257587833 -> j84487250;
		j1257587833 -> j3231328379;
	j2033183891 [label="Już dawno się z tym pogodziłem. Przestało mnie to martwić. Wizje, które mnie dręczą – te głosy – znalazłem sposób, by żyć z nimi w zgodzie, bez strachu i nienawiści.",shape=box,color=blue];
		j2033183891 -> j2885641308;
	j2491859890 [label="Cieszę się, że mogę stanowić dla niego jakieś oparcie.",shape=box,color=red];
		j2491859890 -> j481216861;
	j2087130536 [label="To, co mu się przydarzyło, jest... skomplikowane. Sądzę, że będzie się z tym zmagał jeszcze przez długi czas.",shape=box,color=red];
		j2087130536 -> j481216861;
	j4255522088 [label="W rzeczy samej. Zrobił to, żeby wygrać wojnę, a to czasami wiąże się z przegraniem kilku bitew.",shape=box,color=red];
		j4255522088 -> j481216861;
	j2223622619 [label="Z czasem sobie wybaczy. Ale nie sądzę, żeby zewnętrzna skorupa kiedykolwiek się zmieniła.",shape=box,color=red];
		j2223622619 -> j481216861;
	j3094695106 [label="Sam najlepiej znasz własny umysł i swoje ograniczenia. Życzę wam wszystkiego dobrego.",shape=box,color=blue];
		j3094695106 -> j1157352759;
	j84487250 [label="Leonie? Czuję do ciebie miętę. Zależy mi na tobie. Chcę być z tobą, jeśli ty chciałbyś być ze mną.",shape=box,color=red];
		j84487250 -> j3415209101;
	j3231328379 [label="Skoro twierdzisz, że nie ma w tym wzajemności...",shape=box,color=red];
		j3231328379 -> j3923634888;
	j2885641308 [label="(Ostatnio, jak sądzę, trochę przez złośliwość, jeśli mam być szczery, ale nie ma to żadnego znaczenia.)",shape=box,color=blue];
		j2885641308 -> j2633387891;
	j481216861 [label="+10 Chemistry",color=orange];
		j481216861 -> j2414018668;
	j1157352759 [label="+10 Chemistry",color=orange];
		j1157352759 -> j2233757749;
	j3415209101 [label="Wybacz mi, proszę – po prostu – myślałem, że to niemożliwe, że to... nie jest coś... co mógłbym sobie... wyobrazić...",shape=box,color=blue];
		j3415209101 -> j4291643733;
	j3923634888 [label="Wręcz przeciwnie! Wcale tego nie sugeruję! Jestem od tego bardzo, bardzo daleki i po prostu – myślałem, że to niemożliwe, że to... nie jest coś... co mógłbym sobie... wyobrazić...",shape=box,color=blue];
		j3923634888 -> j4291643733;
	j2633387891 [label="Ale chcę, żebyś zrozumiał, że gdybyś chciał zakończyć to coś między nami – tę więź, pomiędzy mną, a drugą osobą, którą wcześniej uważałem za niemożliwą...",shape=box,color=blue];
		j2633387891 -> j3896593538;
	j2414018668 [label="I dlatego życzę wam obojgu wszystkiego dobrego.",shape=box,color=blue];
		j2414018668 -> j2233757749;
	j2233757749 [label="Poza tym odkąd ma tę chęć do \"zaspokojenia tego pragnienia\", przestał prowokować Marię do otwartego konfliktu.",shape=box,color=blue];
		j2233757749 -> j3326127961;
	j4291643733 [label="Evaluate expressions",color=orange];
		j4291643733 -> j552099044 [label="RoatheDating",color=purple];
		j4291643733 -> j443905054 [label="MarieDating",color=purple];
		j4291643733 -> j1292809614 [label="false",color=purple];
	j3896593538 [label="Gdyby twoje serce kiedykolwiek pożeglowało w inną stronę...",shape=box,color=blue];
		j3896593538 -> j267418086;
	j3326127961 [label="Cóż. Przynajmniej nie tak często, jak wcześniej. Do później.",shape=box,color=blue];
		j3326127961 -> j2517419488;
	j552099044 [label="+5 Chemistry",color=orange];
		j552099044 -> j433732405;
	j443905054 [label="+5 Chemistry",color=orange];
		j443905054 -> j329162724;
	j1292809614 [label="+20 Chemistry",color=orange];
		j1292809614 -> j3625414424;
	j267418086 [label="Zniosę to, mon miracle.",shape=box,color=blue];
		j267418086 -> j4231554494;
	j433732405 [label="Chociaż jestem... głęboko wzruszony i nie znam zwyczajów panujących w tamtych czasach, obawiam się, że muszę odmówić.",shape=box,color=blue];
		j433732405 -> j3757378996;
	j329162724 [label="Chociaż jestem... głęboko wzruszony i nie znam zwyczajów panujących w tamtych czasach, obawiam się, że muszę odmówić.",shape=box,color=blue];
		j329162724 -> j3092774142;
	j3625414424 [label="Jesteś naprawdę mon miracle...",shape=box,color=blue];
		j3625414424 -> j1374158912;
	j4231554494 [label="Nie pozwolę, by ta udręka mnie pochłonęła. ",shape=box,color=blue];
		j4231554494 -> j1697539566;
	j3757378996 [label="Ponieważ obecnie jesteś... związany z Roathem. Nie chcę nawet wyobrażać sobie, jakie komplikacje spowodowałoby takie uwikłanie.",shape=box,color=blue];
		j3757378996 -> j3404024765;
	j3092774142 [label="Jesteś obecnie w związku z Marią. Jest mi zbyt bliska i myślę, że mój związek z tobą mógłby zaszkodzić jej relacji lub w jakiś sposób ją zranić.",shape=box,color=blue];
		j3092774142 -> j3899447892;
	j1374158912 [label="Boolean LyonDating is now true.",color=orange];
		j1374158912 -> j4115967391;
	j1697539566 [label="Check boolean LyonAllRight",color=orange];
		j1697539566 -> j2579340539 [label=true,color=green];
		j1697539566 -> j4115089982 [label=false,color=brown];
	j3404024765 [label="Obawiam się, że mój umysł jest aż nazbyt skomplikowany, by wyobrazić sobie was dwoje, ciebie i tego mężczyznę, którego tak dobrze znam. Być może pod tym względem jestem staromodny. Wydaje się, że jestem chodzącym reliktem. Musisz mi to wybaczyć.",shape=box,color=blue];
		j3404024765 -> j2517419488;
	j3899447892 [label="Być może jestem pod tym względem staromodny. Ona jest dla mnie jak rodzina, jesteśmy zbyt blisko. Wydaje się, że jestem chodzącym reliktem. Musisz mi to wybaczyć.",shape=box,color=blue];
		j3899447892 -> j2517419488;
