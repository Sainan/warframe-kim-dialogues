	j1392651392 [label="Evaluate expressions",color=orange];
		j1392651392 -> "Chat ends." [label="LyonDating, LyonDatingConfession",color=purple];
		j1392651392 -> j3193862264 [label="LyonDating",color=purple];
		j1392651392 -> j3287480167 [label="MarieDating",color=purple];
		j1392651392 -> j1243665097 [label="RoatheDating",color=purple];
		j1392651392 -> "Chat ends." [label="LyonDatingConfession",color=purple];
		j1392651392 -> j1461722831 [label="false",color=purple];
		j1392651392 -> j2614499038 [label="false",color=purple];
		j1392651392 -> j386906797 [label="false",color=purple];
	"Chat ends." [color=orange];
	j3193862264 [label="Mon miracle, I... must make very certain you understand something before I tell you this next anecdote of mine. ",shape=box,color=blue];
		j3193862264 -> j2428223341;
	j3287480167 [label="I am not surprised that Marie caught your heart in her hands like a butterfly. She is... quite something.",shape=box,color=blue];
		j3287480167 -> j2183298434;
	j1243665097 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1243665097 -> j4081834027 [label="x >= 21",color=purple];
		j1243665097 -> j1766143879 [label="x < 21",color=purple];
		j1243665097 -> j1766143879 [label="false",color=purple];
	j1461722831 [label="Jak się dzisiaj miewasz, Leonie?",shape=box,color=red];
		j1461722831 -> j2158310743;
	j2614499038 [label="[Confess feelings.] Lyon? I was wondering if we could talk about something.",shape=box,color=red];
		j2614499038 -> j2661440882;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j2428223341 [label="It is important to me that you are paying very close attention to these next words that I send you. Do you understand?",shape=box,color=blue];
		j2428223341 -> j4070374332;
		j2428223341 -> j3410229811;
	j2183298434 [label="Check boolean LyonHasDated",color=orange];
		j2183298434 -> j3105939663 [label=true,color=green];
		j2183298434 -> j1574939222 [label=true,color=green];
		j2183298434 -> j3345423031 [label=true,color=green];
		j2183298434 -> j1574939222 [label=false,color=brown];
		j2183298434 -> j3345423031 [label=false,color=brown];
	j4081834027 [label="I am glad there is someone who can find the strength to reach through the nettles of Roathe's personality to see the broken thing that lies within.",shape=box,color=blue];
		j4081834027 -> j58302161;
	j1766143879 [label="Might I ask what I fear is to be an indelicate question, my friend?",shape=box,color=blue];
		j1766143879 -> j843739938;
		j1766143879 -> j1666987093;
	j2158310743 [label="What a wonderfully benign and charmingly mundane question. I do not get asked this often.",shape=box,color=blue];
		j2158310743 -> j2518028144;
	j2661440882 [label="Yes, what is it? Is something the matter?",shape=box,color=blue];
		j2661440882 -> j3124429866;
		j2661440882 -> j3773332689;
	j4070374332 [label="You're making me nervous. What's wrong?",shape=box,color=red];
		j4070374332 -> j548002484;
	j3410229811 [label="Yes, I'm here. Go ahead.",shape=box,color=red];
		j3410229811 -> j613804273;
	j3105939663 [label="I didn't know how you'd feel, since...",shape=box,color=red];
		j3105939663 -> j1841003861;
	j1574939222 [label="I'm kind of... in awe of her.",shape=box,color=red];
		j1574939222 -> j3835132698;
	j3345423031 [label="Is this a conversation where you threaten me? Or?",shape=box,color=red];
		j3345423031 -> j1857321856;
	j58302161 [label="I know, though he denies it vehemently, that he believes himself a coward. I would not label him as such.",shape=box,color=blue];
		j58302161 -> j3323593791;
	j843739938 [label="Of course. I've asked you plenty.",shape=box,color=red];
		j843739938 -> j3874385234;
	j1666987093 [label="Dlaczego spotykam się z Roathem?",shape=box,color=red];
		j1666987093 -> j930926675;
	j2518028144 [label="I am... quite well, thank you.",shape=box,color=blue];
		j2518028144 -> j3811952394;
	j3124429866 [label="Never mind. Sorry. Forgot what I was going to say, actually.",shape=box,color=red];
		j3124429866 -> j3815842972;
	j3773332689 [label="I don't know how to phrase it best, so I'm going to come right out and say it - I have feelings for you.",shape=box,color=red];
		j3773332689 -> j2434090358;
	j548002484 [label="Nothing is wrong - quite the opposite. That is what is so imperative for you to comprehend - the dire consequences from which I wish to free you, should you assume they might follow.",shape=box,color=blue];
		j548002484 -> j2903177783;
		j548002484 -> j3102562501;
		j548002484 -> j875811590;
	j613804273 [label="+5 Chemistry",color=orange];
		j613804273 -> j2309858857;
	j1841003861 [label="Ha. Do you think I am surprised? I stand in the shadow of her light and always have. No, my friend - I am not bitter or jealous over this, I promise you.",shape=box,color=blue];
		j1841003861 -> j3848170047;
	j3835132698 [label="As are we all. The sister of my soul never ceases to amaze me. I am happy for you both beyond the ability for words to express.",shape=box,color=blue];
		j3835132698 -> j2304593496;
	j1857321856 [label="Hm? No. I would hardly be so bullish as to stomp about and pretend to be her guardian. She is quite capable of breaking your bones if she decides you are so worthy.",shape=box,color=blue];
		j1857321856 -> j4081034003;
	j3323593791 [label="Entrati told him he would be needed to save a future he did not know. One that he had no kingship over, no people to grovel at his feet, no servants to worship him.",shape=box,color=blue];
		j3323593791 -> j1772488340;
	j3874385234 [label="What... do you see in Roathe that has led you two into... courtship?",shape=box,color=blue];
		j3874385234 -> j3200384893;
		j3874385234 -> j3282291551;
		j3874385234 -> j2400866627;
	j930926675 [label="I see you have either already faced this line of questioning, or you were expecting it. Yes. Precisely that. What... do you see in him?",shape=box,color=blue];
		j930926675 -> j3200384893;
		j930926675 -> j3282291551;
		j930926675 -> j2400866627;
	j3811952394 [label="+20 Chemistry",color=orange];
		j3811952394 -> j1408691258;
	j3815842972 [label="Happens to me frequently. Often when I pass through doorways. Oft I have wondered why that is.",shape=box,color=blue];
		j3815842972 -> j1523065705;
	j2434090358 [label="I... you are... certain? Are you well? You have not hit your head recently, have you?",shape=box,color=blue];
		j2434090358 -> j4166409739;
		j2434090358 -> j1681022814;
	j2903177783 [label="Słucham.",shape=box,color=red];
		j2903177783 -> j3496963987;
	j3102562501 [label="You're not making much sense.",shape=box,color=red];
		j3102562501 -> j86127131;
	j875811590 [label="Dire consequences of... what?",shape=box,color=red];
		j875811590 -> j3710382669;
	j2309858857 [label="Thank you. Before I begin I wish to assure you that there is nothing wrong - however, therein lies perhaps the dire consequences from which I wish to free you, should you assume they might follow.",shape=box,color=blue];
		j2309858857 -> j2903177783;
		j2309858857 -> j3102562501;
		j2309858857 -> j875811590;
	j3848170047 [label="I hold no resentment over what passed between us, I am still only able to express my grateful soul for the time we did spend together.",shape=box,color=blue];
		j3848170047 -> j3531370122;
	j2304593496 [label="There is such joy in her eyes when she speaks of you. She is giddy with excitement whenever she thinks you might be stopping by.",shape=box,color=blue];
		j2304593496 -> j2479686351;
	j4081034003 [label="I merely wished to tell you that her happiness is contagious - and I find myself smiling in the thought of it as well. So for that, I also must thank you.",shape=box,color=blue];
		j4081034003 -> j2517419488;
	j1772488340 [label="He might think it an act of fear - a rat fleeing a sinking ship - to take the serum and forget the actions that led to it. ",shape=box,color=blue];
		j1772488340 -> j506714654;
	j3200384893 [label="To put it bluntly? Have you seen him?",shape=box,color=red];
		j3200384893 -> j2990006021;
	j3282291551 [label="I think there's a pain in him, somewhere beneath all the... humor and personality.",shape=box,color=red];
		j3282291551 -> j3059459434;
	j2400866627 [label="I... can't help it. There's a darkness and a danger in him that I find alluring. It draws me in.",shape=box,color=red];
		j2400866627 -> j3406869653;
	j1408691258 [label="Yes, I think I am now quite well today, indeed.",shape=box,color=blue];
		j1408691258 -> j3591186650;
	j1523065705 [label="+5 Chemistry",color=orange];
		j1523065705 -> j3591186650;
	j4166409739 [label="Dlaczego tak trudno w to uwierzyć?",shape=box,color=red];
		j4166409739 -> j2799241080;
	j1681022814 [label="I'm sure, Lyon. I'm not concussed.",shape=box,color=red];
		j1681022814 -> j2799241080;
	j3496963987 [label="+5 Chemistry",color=orange];
		j3496963987 -> j2783825046;
	j86127131 [label="Yes. I am painfully aware of this.",shape=box,color=blue];
		j86127131 -> j3710382669;
	j3710382669 [label="Pozwól, że zacznę od nowa.",shape=box,color=blue];
		j3710382669 -> j2783825046;
	j3531370122 [label="+10 Chemistry",color=orange];
		j3531370122 -> j3952372330;
	j2479686351 [label="+10 Chemistry",color=orange];
		j2479686351 -> j4081034003;
	j2517419488 [label="Leon",shape=box,color=blue];
		j2517419488 -> "Chat ends.";
	j506714654 [label="I see it as a man who saw the calculations of the battlefield and knew when to abandon a vessel already lost. For the war was not yet over.",shape=box,color=blue];
		j506714654 -> j1494212890;
	j2990006021 [label="Far be it from me to condemn you.",shape=box,color=blue];
		j2990006021 -> j1268501912;
	j3059459434 [label="+5 Chemistry",color=orange];
		j3059459434 -> j1613539666;
	j3406869653 [label="I can understand the pull. I will not deny that I do not see it myself. However, I do hope for your sake you do not allow it to consume you.",shape=box,color=blue];
		j3406869653 -> j3942625535;
	j3591186650 [label="Życzę miłego dnia. Leon",shape=box,color=blue];
		j3591186650 -> "Chat ends.";
	j2799241080 [label="Well, to be blunt - when you have such other options before you... Marie or Roathe or... anyone else in the universe for that matter...",shape=box,color=blue];
		j2799241080 -> j489569787;
	j2783825046 [label="I am aware that I can be construed by many, and in fact, very well might be, in reality, to be... unwell. At the very least, I am not entirely of sound mind.",shape=box,color=blue];
		j2783825046 -> j2189956678;
	j3952372330 [label="Now, I am happy you spend it with her. She will bring you joy, where I could only bring you sadness. Be happy with her. You have all of my blessings.",shape=box,color=blue];
		j3952372330 -> j2517419488;
	j1494212890 [label="Evaluate expressions",color=orange];
		j1494212890 -> j1540080405 [label="RoatheVillian",color=purple];
		j1494212890 -> j1729553871 [label="RoatheVillian",color=purple];
		j1494212890 -> j3014542378 [label="RoatheVillian",color=purple];
		j1494212890 -> j1540080405 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j1729553871 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j3562043469 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j3014542378 [label="RoatheRedeemed",color=purple];
		j1494212890 -> j1540080405 [label="false",color=purple];
		j1494212890 -> j1729553871 [label="false",color=purple];
	j1268501912 [label="Though, for your sake, I do hope this fancy passes quickly and does not become an addiction. I have seen such things destroy others.",shape=box,color=blue];
		j1268501912 -> j729743092;
	j1613539666 [label="Yes, I have seen it myself. Buried deep, though it may be. But he may not welcome your attempts to pry. I believe he enjoys what he has become.",shape=box,color=blue];
		j1613539666 -> j729743092;
	j3942625535 [label="Such arrangements should be based on more than... simple darkness. I shall not lecture you, however.",shape=box,color=blue];
		j3942625535 -> j729743092;
	j489569787 [label="I have trouble believing you would choose to dally with a broken stained glass window such as I... lest you were gravely ill.",shape=box,color=blue];
		j489569787 -> j3973474304;
		j489569787 -> j596445342;
	j2189956678 [label="I have long since come to be at peace with this. It does not trouble me any longer. The visions that plague me - the voices - I have come to find ways to live with them without fear or hatred.",shape=box,color=blue];
		j2189956678 -> j3158466825;
	j1540080405 [label="I'm just happy to be there for him, in any way that I can.",shape=box,color=red];
		j1540080405 -> j600768636;
	j1729553871 [label="What happened to him is... complicated. I think he'll be sorting through it for a long while.",shape=box,color=red];
		j1729553871 -> j600768636;
	j3014542378 [label="Exactly. He did it to win the war - and sometimes that means losing a few battles.",shape=box,color=red];
		j3014542378 -> j600768636;
	j3562043469 [label="Z czasem sobie wybaczy. Ale nie sądzę, żeby zewnętrzna skorupa kiedykolwiek się zmieniła.",shape=box,color=red];
		j3562043469 -> j600768636;
	j729743092 [label="You know your own mind and your limits. I wish you both well.",shape=box,color=blue];
		j729743092 -> j1741207979;
	j3973474304 [label="Lyon? I have feelings for you. I care about you. I'd like to be with you, if you'd like to be with me.",shape=box,color=red];
		j3973474304 -> j3927477593;
	j596445342 [label="If you're saying it's not mutual...",shape=box,color=red];
		j596445342 -> j2905698196;
	j3158466825 [label="(Lately, I think, a little out of spite if I might be honest, but that is neither here nor there.)",shape=box,color=blue];
		j3158466825 -> j3693792089;
	j600768636 [label="+10 Chemistry",color=orange];
		j600768636 -> j2359399360;
	j1741207979 [label="+10 Chemistry",color=orange];
		j1741207979 -> j3304946252;
	j3927477593 [label="Forgive me, please forgive me - I simply - I thought it was impossible, this is... not something I... could have... imagined...",shape=box,color=blue];
		j3927477593 -> j184601558;
	j2905698196 [label="Hardly! That is not what I mean to imply! Far - far from it, in fact, I simply - I thought it was impossible, this is... not something I... could have... imagined...",shape=box,color=blue];
		j2905698196 -> j184601558;
	j3693792089 [label="But I wish you to understand that if you were to end this between us - this bond that I thought was previously heretofore impossible between myself and another -",shape=box,color=blue];
		j3693792089 -> j181320283;
	j2359399360 [label="To which I wish you both the absolute best of luck.",shape=box,color=blue];
		j2359399360 -> j3304946252;
	j3304946252 [label="Besides, now that he seems to have an \"itch to scratch,\" he has stopped goading Marie in to open conflict.",shape=box,color=blue];
		j3304946252 -> j3919320995;
	j184601558 [label="+20 Chemistry",color=orange];
		j184601558 -> j1271585627;
	j181320283 [label="If you were to ever let your heart wander away from mine? ",shape=box,color=blue];
		j181320283 -> j552213775;
	j3919320995 [label="Well. Not as frequently, at any rate. Farewell for now.",shape=box,color=blue];
		j3919320995 -> j2517419488;
	j1271585627 [label="You truly are mon miracle...",shape=box,color=blue];
		j1271585627 -> j1374158912;
	j552213775 [label="I will endure, mon miracle.",shape=box,color=blue];
		j552213775 -> j3242067955;
	j1374158912 [label="Boolean LyonDating is now true.",color=orange];
		j1374158912 -> j4115967391;
	j3242067955 [label="I will not be consumed by that which has plagued me. ",shape=box,color=blue];
		j3242067955 -> j1697539566;
	j4115967391 [label="Boolean IsDating is now true.",color=orange];
		j4115967391 -> j3642226382;
	j1697539566 [label="Check boolean LyonAllRight",color=orange];
		j1697539566 -> j744145472 [label=true,color=green];
		j1697539566 -> j2073349236 [label=false,color=brown];
	j3642226382 [label="Boolean LyonHasDated is now true.",color=orange];
		j3642226382 -> "Chat ends.";
	j744145472 [label="I will be, to use your colloquialism, \"all right.\" I will find cause to smile and laugh once more.",shape=box,color=blue];
		j744145472 -> j1877637589;
		j744145472 -> j363282189;
	j2073349236 [label="I will survive. I will be fine. I will find cause to smile and laugh once more.",shape=box,color=blue];
		j2073349236 -> j1877637589;
		j2073349236 -> j363282189;
	j1877637589 [label="Oh, Lyon... you aren't a burden to me.",shape=box,color=red];
		j1877637589 -> j2219990608;
	j363282189 [label="Are you... saying you want to end things between us?",shape=box,color=red];
		j363282189 -> j4181332823;
	j2219990608 [label="I am simply attempting to free you of any perceived hardship you might feel on my account...",shape=box,color=blue];
		j2219990608 -> j3011004471;
		j2219990608 -> j2588881899;
		j2219990608 -> j3411285387;
	j4181332823 [label="No! Anything of the sort! I am simply attempting to free you of any perceived hardship you might feel on my account.",shape=box,color=blue];
		j4181332823 -> j3011004471;
		j4181332823 -> j2588881899;
		j4181332823 -> j3411285387;
	j3011004471 [label="Your pain... echoes a kind of my own. It'd never be a hardship to help you through it.",shape=box,color=red];
		j3011004471 -> j2989175492;
	j2588881899 [label="I can't describe what draws me to you. But you will never be a duty or a burden.",shape=box,color=red];
		j2588881899 -> j1433573642;
	j3411285387 [label="[Zerwij] To wszystko mnie przerasta, przepraszam. Lepiej będzie, jak zakończymy to w tym punkcie.",shape=box,color=red];
		j3411285387 -> j2907805328;
	j2989175492 [label="To which I cannot express how much my heart breaks in turn for you. But that I am forever grateful that our lonely ghosts of pain have found each other.",shape=box,color=blue];
		j2989175492 -> j275442452;
	j1433573642 [label="To which I cannot properly express my gratitude, and I do not think any words ever can.",shape=box,color=blue];
		j1433573642 -> j275442452;
	j2907805328 [label="Yes. Of course. It would be... hypocritical to accept any other answer at this point in time... ",shape=box,color=blue];
		j2907805328 -> j3639684846;
	j275442452 [label="But now that I have gone through great pains to go through what has been a most spectacularly self-indulgent preamble...",shape=box,color=blue];
		j275442452 -> j3461261388;
		j275442452 -> j1170245561;
		j275442452 -> j2145672600;
	j3639684846 [label="I understand completely. And I wish you nothing but the best. And I will cherish all the moments we have spent together.",shape=box,color=blue];
		j3639684846 -> j344289129;
	j3461261388 [label="For a guy who started off silent, you really did get wordy.",shape=box,color=red];
		j3461261388 -> j683023972;
	j1170245561 [label="I find them endearing, don't worry.",shape=box,color=red];
		j1170245561 -> j4266043295;
	j2145672600 [label="You could've just said \"I'll be fine, you know, if we ever go our separate ways.\"",shape=box,color=red];
		j2145672600 -> j2878093719;
	j344289129 [label="I will remember them in my soul, even if they vanish from my mind. Farewell.",shape=box,color=blue];
		j344289129 -> j2603405539;
	j683023972 [label="+5 Chemistry",color=orange];
		j683023972 -> j4132458378;
	j4266043295 [label="+5 Chemistry",color=orange];
		j4266043295 -> j3916605766;
	j2878093719 [label="+5 Chemistry",color=orange];
		j2878093719 -> j400906481;
	j2603405539 [label="Boolean LyonDating is now false.",color=orange];
		j2603405539 -> j2874744099;
	j4132458378 [label="Bah! If you did not wish to be privy to the inner workings of my mind, you should not have gone poking about. You are entirely to blame for that.",shape=box,color=blue];
		j4132458378 -> j2438178722;
	j3916605766 [label="I am quite glad you enjoy my wanderings. This is precisely why I choose to speak as little as I do. Can you imagine enduring this in person? Marie would have put me down years ago like a mad dog.",shape=box,color=blue];
		j3916605766 -> j2438178722;
	j400906481 [label="There is a certain amount of irreverence and sarcasm to which you naturally prevail that I could never hope to ascend. I will leave it to you.",shape=box,color=blue];
		j400906481 -> j2438178722;
	j2874744099 [label="Boolean IsDating is now false.",color=orange];
		j2874744099 -> j2517419488;
	j2438178722 [label="Nevertheless, all of this was meant to serve as pretext to a story that will now seem quite short in comparison to the rest...",shape=box,color=blue];
		j2438178722 -> j1066667781;
	j1066667781 [label="I awoke last night from a nightmare. When I did, shadows surrounded me. This is nothing foreign or new in my state of mind. They loomed over my bed, and would not clear.",shape=box,color=blue];
		j1066667781 -> j1758270468;
	j1758270468 [label="I was not frightened of them, for I knew they could not harm me. However, they would not be gone from my mind, either. There was only one I knew to be rid of them.",shape=box,color=blue];
		j1758270468 -> j1030545740;
	j1030545740 [label="Pushing up from bed, I dressed as best I could, staggering through the blurry vision of the continued nightmare. I grasped my thurible and fell to my knees in the middle of my floor, and prepared to... well. ",shape=box,color=blue];
		j1030545740 -> j2653975172;
	j2653975172 [label="I prepared to \"clear my mind.\" We shall leave it at that.",shape=box,color=blue];
		j2653975172 -> j3277704813;
	j3277704813 [label="But as I shut my eyes, my mind wandered. My thoughts drifted... to you, mon miracle...",shape=box,color=blue];
		j3277704813 -> j757135987;
	j757135987 [label="The sound of your voice. The touch of your hand upon my shoulder... ",shape=box,color=blue];
		j757135987 -> j3478585529;
	j3478585529 [label="A wizje... ulotniły się. Opuściły swoje stanowisko, przepędzone przez silniejszą zjawę... przez ciebie.",shape=box,color=blue];
		j3478585529 -> j1688663544;
	j1688663544 [label="I... stood. Placed my thurible upon the nightstand, and... opted to walk through the sand of the Sanctum instead...",shape=box,color=blue];
		j1688663544 -> j98295308;
		j1688663544 -> j1686268280;
