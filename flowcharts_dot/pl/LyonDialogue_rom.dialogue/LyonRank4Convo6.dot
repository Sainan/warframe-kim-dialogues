	j3300619262 [label="+20 Chemistry",color=orange];
		j3300619262 -> j579295361;
	j255027449 [label="Leonie, rozmawiałem z Marią o twoich... zwyczajach i zastanawiałem się, czy moglibyśmy pomówić?",shape=box,color=red];
		j255027449 -> j668384320;
	j798335143 [label="[Wyłącz wszystkie rozmowy o samookaleczeniu. Nie nastąpi żadna utrata punktów chemii z Leonem ani żadną inną postacią.]",shape=box,color=red];
		j798335143 -> j3008690296;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j1356560576 [label="Leonie? Czy możemy porozmawiać o czymś, co może być dla ciebie trochę... niekomfortowe?",shape=box,color=red];
		j1356560576 -> j1635454451;
	j2605509605 [label="Leonie, zastanawiałem się, czy moglibyśmy porozmawiać o tym, dlaczego... zadajesz sobie ból, jeśli nie masz nic przeciwko?",shape=box,color=red];
		j2605509605 -> j2955109284;
	j579295361 [label="[Rozmowa pominięta ze względu na poprzednie ustawienia ostrzeżeń]",shape=box,color=blue];
		j579295361 -> "Chat ends.";
	j668384320 [label="Ostrzegła mnie, że rozmawialiście – i tak, oczywiście. Możesz być zaskoczony, jak łatwo przychodzi mi rozmowa o tej szczególnej przywarze.",shape=box,color=blue];
		j668384320 -> j828470248;
	j3008690296 [label="Boolean LyonPainOff is now true.",color=orange];
		j3008690296 -> j3779466002;
	"Chat ends." [color=orange];
	j1635454451 [label="Zapytać możesz, ale zastrzegam sobie prawo do zaprzestania dyskusji, jeśli uznam, że poruszamy kwestie, które nieszczególnie mam ochotę poruszać.",shape=box,color=blue];
		j1635454451 -> j562939039;
	j2955109284 [label="Mhm. Szczerze mówiąc, to jestem zaskoczony, że tak długo zbierałeś się, by zapytać właśnie o tę moją przywarę. Zwykle to właśnie ona jest powodem największej konsternacji.",shape=box,color=blue];
		j2955109284 -> j2356324916;
	j828470248 [label="Zazwyczaj stanowi ona najczęstszy powód do rozmowy. Czy to z powodu niepokoju, obrzydzenia czy też chorobliwej ciekawości.",shape=box,color=blue];
		j828470248 -> j897187574;
	j3779466002 [label="Jeśli uważasz się za tchórza z powodu podjęcia tego wyboru, to błagam, ale nie musisz się tak czuć. Ten ból nie jest twój. Należy do mnie. Nie prosiłeś o to, by znaleźć się w takim położeniu.",shape=box,color=blue];
		j3779466002 -> j1195590452;
	j562939039 [label="Chodzi o to, że czasami robisz sobie krzywdę. Wolałbym być delikatny, poruszając z tobą tę kwestię i tyle.",shape=box,color=red];
		j562939039 -> j2511304188;
	j2356324916 [label="Czy to z powodu niepokoju, obrzydzenia albo chorobliwej ciekawości, która mogłaby popchnąć kogoś do zajrzenia do celi szaleńca. Zastanawiam się, którym głosem jesteś?",shape=box,color=blue];
		j2356324916 -> j1309031401;
		j2356324916 -> j2836705122;
		j2356324916 -> j87338234;
		j2356324916 -> j2023294335;
	j897187574 [label="Evaluate expressions",color=orange];
		j897187574 -> j1309031401 [label="LyonBackstory3a",color=purple];
		j897187574 -> j3314661114 [label="LyonBackstory3a",color=purple];
		j897187574 -> j1309031401 [label="LyonBackstory3b",color=purple];
		j897187574 -> j3314661114 [label="LyonBackstory3b",color=purple];
		j897187574 -> j1309031401 [label="DrifterHarmHelp",color=purple];
		j897187574 -> j87338234 [label="DrifterHarmHelp",color=purple];
		j897187574 -> j1309031401 [label="DrifterHarmStop",color=purple];
		j897187574 -> j2023294335 [label="DrifterHarmStop",color=purple];
		j897187574 -> j1309031401 [label="DrifterHarmLoss",color=purple];
		j897187574 -> j2836705122 [label="DrifterHarmLoss",color=purple];
		j897187574 -> j1309031401 [label="false",color=purple];
	j1195590452 [label="To mechaniczne urządzenie, na którym siedzimy, sprawia takie wrażenie, jakby skrywało w sobie jakąś bezduszność. Że zapewnia nam w pewien sposób ochronę przed wszelkimi krzywdami, jakie ktoś mógłby nam wyrządzić wypowiadanymi słowami.",shape=box,color=blue];
		j1195590452 -> j3001681307;
	j2511304188 [label="+5 Chemistry",color=orange];
		j2511304188 -> j3159171128;
	j1309031401 [label="Przepraszam, ale po chwili namysłu stwierdzam, że nie mogę tego zrobić. [Koniec]",shape=box,color=red];
		j1309031401 -> j3779466002;
	j2836705122 [label="[Ostrzeżenie: Rozmowa poruszy temat samobójstwa] Ja... kiedyś utraciłem kogoś bliskiego z powodu tego typu \"nawyków\" i...",shape=box,color=red];
		j2836705122 -> j3603450720;
	j87338234 [label="I just want to help you. To make sure you're all right. That's all.",shape=box,color=red];
		j87338234 -> j4278740242;
	j2023294335 [label="I just feel like this isn't healthy - that it's something that should stop. ",shape=box,color=red];
		j2023294335 -> j2322491070;
	j3314661114 [label="I know you said you used to hurt yourself before the serum, but... I can't imagine it's made it any better.",shape=box,color=red];
		j3314661114 -> j2356034474;
	j3001681307 [label="I would argue instead the opposite - that free of the armor we don in our more mundane social interactions, we are stripped of that which might protect us.",shape=box,color=blue];
		j3001681307 -> j846885579;
	j3159171128 [label="Doceniam to, że podchodzisz do tej sprawy w delikatny sposób, Włóczęgo. Dziękuję. Ale przyzwyczaiłem się, że jest to temat do dyskusji. Czy to z powodu niepokoju, obrzydzenia albo chorobliwej ciekawości – choć sądzę, że już dowiodłeś, iż chodzi o to pierwsze.",shape=box,color=blue];
		j3159171128 -> j1309031401;
		j3159171128 -> j2836705122;
		j3159171128 -> j87338234;
		j3159171128 -> j2023294335;
	j3603450720 [label="Boolean DrifterHarmLoss is now true.",color=orange];
		j3603450720 -> j1691833927;
	j4278740242 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j4278740242 -> j4131174356;
	j2322491070 [label="Boolean DrifterHarmStop is now true.",color=orange];
		j2322491070 -> j249870306;
	j2356034474 [label="No, I fear it has not. It has taken something that was... a requirement to clear my mind of the visions that plagued me, and turned it into a requirement to wield the \"gifts\" of this serum.",shape=box,color=blue];
		j2356034474 -> j1055340182;
	j846885579 [label="Therefore, in situations like these... I am well aware that I let loose an arrow that might find not the battle-ready soldier, but the unsuspecting jugular of a deer in the woods.",shape=box,color=blue];
		j846885579 -> j507297600;
	j1691833927 [label="Oh, my friend... there are no words that I can put down that will adequately express my sympathy for what you have endured.",shape=box,color=blue];
		j1691833927 -> j3557935114;
	j4131174356 [label="Check boolean LyonAllRight",color=orange];
		j4131174356 -> j986201914 [label=true,color=green];
		j4131174356 -> j4249972755 [label=false,color=brown];
	j249870306 [label="I believe you are several years and one protoframe serum too late to put an end to this particular compulsion of mine - indeed, I fear it is now more of a required action, is it not?",shape=box,color=blue];
		j249870306 -> j1810356245;
	j1055340182 [label="+5 Chemistry",color=orange];
		j1055340182 -> j2909782191;
	j507297600 [label="So I shall, therefore, leave you with this:",shape=box,color=blue];
		j507297600 -> j3234717611;
	j3557935114 [label="Language seems paltry when moments like these come to pass. We scramble to wield them as best we can, yet they always seem to fail us.",shape=box,color=blue];
		j3557935114 -> j497660495;
	j986201914 [label="I once more am attempting not to chuckle at the notion of my ever approaching the concept of \"all right.\" But I very much appreciate the sentiment, Drifter.",shape=box,color=blue];
		j986201914 -> j833720367;
	j4249972755 [label="I am attempting not to chuckle at the notion of my ever approaching the concept of \"all right.\" But I very much appreciate the sentiment, Drifter.",shape=box,color=blue];
		j4249972755 -> j833720367;
	j1810356245 [label="+5 Chemistry",color=orange];
		j1810356245 -> j4112952551;
	j2909782191 [label="If the ability to cure my compulsion to harm myself were within my grasp prior to injecting the serum, I believe joining with the \"Harrow\" Warframe has made it quite impossible now.",shape=box,color=blue];
		j2909782191 -> j3723888763;
	j3234717611 [label="We must remind ourselves how to find the strength to pull another to their feet, even when we cannot find the will to stand.",shape=box,color=blue];
		j3234717611 -> j3222237627;
	j497660495 [label="There are three things I might do, if you would indulge me, in light of your confession.",shape=box,color=blue];
		j497660495 -> j2488641769;
	j833720367 [label="+5 Chemistry",color=orange];
		j833720367 -> j1400066390;
		j833720367 -> j711871291;
	j4112952551 [label="But I do not mean to be so flippant over what I believe is an expression of concern over my physical and mental well-being, forgive me. I simply do not think it is within my ability to cease.",shape=box,color=blue];
		j4112952551 -> j1400066390;
		j4112952551 -> j711871291;
	j3723888763 [label="If I might be quite crass, Drifter, I do not think I am capable of causing myself any real permanent harm in such a fashion any longer.",shape=box,color=blue];
		j3723888763 -> j2931507029;
	j3222237627 [label="That is the true purpose of story.",shape=box,color=blue];
		j3222237627 -> j2915308259;
	j2488641769 [label="First; is that I am quick to assure you that I am in no danger. If you believe there is some deep and terrible self-loathing that drives my desire to harm myself, I would be quite eager to put those fears to rest.",shape=box,color=blue];
		j2488641769 -> j1496334664;
	j1400066390 [label="May I ask why you do it?",shape=box,color=red];
		j1400066390 -> j3106172300;
	j711871291 [label="I'm just worried you're going to go too far.",shape=box,color=red];
		j711871291 -> j3723888763;
	j2931507029 [label="While I am not capable of the hubris required to think myself impervious, such an act seems... shall we say... part of the design.",shape=box,color=blue];
		j2931507029 -> j4209829057;
	j2915308259 [label="+20 Chemistry",color=orange];
		j2915308259 -> j3203327403;
	j1496334664 [label="While I... know that great melancholy, it does not inspire my thurible. (Marie would never allow it, for one. She is liable to feed it to me before she would let me near one ever again.)",shape=box,color=blue];
		j1496334664 -> j2874568232;
	j3106172300 [label="Evaluate expressions",color=orange];
		j3106172300 -> j1487070556 [label="LyonBackstory3a, LyonLecture2",color=purple];
		j3106172300 -> j1487070556 [label="LyonBackstory3b, LyonLecture2",color=purple];
		j3106172300 -> j3189595222 [label="LyonBackstory3a",color=purple];
		j3106172300 -> j3189595222 [label="LyonBackstory3b",color=purple];
		j3106172300 -> j1568797432 [label="false",color=purple];
	j4209829057 [label="+5 Chemistry",color=orange];
		j4209829057 -> j190981148;
	j3203327403 [label="Bądź zdrów, Włóczęgo. Wkrótce znów porozmawiamy.",shape=box,color=blue];
		j3203327403 -> j2524336129;
	j2874568232 [label="But such deep pains have never whispered to me in the night, my friend. This, I can vow to you. This, I pledge to you, on all that I hold dear.",shape=box,color=blue];
		j2874568232 -> j4061128784;
	j1487070556 [label="I have spoken you the truth of what inspires me to act - the pain clears my mind of the visions that plague me. And the practice is not so shamed amongst the Brothers of Lua as it might be in your culture. I can vow upon all I hold dear there is no hidden secret I am withholding.",shape=box,color=blue];
		j1487070556 -> j2141972704;
	j3189595222 [label="That is a complicated topic, as the reasons behind my rending my own flesh are not singular. I have told you of the visions that plague me, and that the pain clears my mind. But the act itself is not so taboo as you might believe.",shape=box,color=blue];
		j3189595222 -> j1818589572;
	j1568797432 [label="That is a complicated topic, as the reasons behind my rending my own flesh are not singular. I must start by saying that the matter is not nearly as taboo as it may seem to you in this day and age.",shape=box,color=blue];
		j1568797432 -> j1818589572;
	j190981148 [label="I do not think what I do is \"right.\" I do not think what I do should be practiced by others. I do not think what I do is enviable.",shape=box,color=blue];
		j190981148 -> j4017653653;
	j2524336129 [label="O. Leon Allard",shape=box,color=blue];
		j2524336129 -> j3787621160;
	j4061128784 [label="Second; I must commend you on your bravery to send these words to me. It would have been easier to avoid them. You did not.",shape=box,color=blue];
		j4061128784 -> j326880511;
	j2141972704 [label="If you believe there is some deep and terrible self-loathing that drives my desire to harm myself, I would be quite eager to put those fears to rest.",shape=box,color=blue];
		j2141972704 -> j1796130715;
	j1818589572 [label="Amongst the Brothers of Lua, there is an ancient practice of flagellation. It is rare, and even in my day it was seen as archaic and used by those who were \"blessed by her visions.\"",shape=box,color=blue];
		j1818589572 -> j3453828234;
	j4017653653 [label="However it is not - in my incredibly unique and rather \"supernatural\" in the most literal sense of the word, state - strictly dangerous for me, either.",shape=box,color=blue];
		j4017653653 -> j3721717014;
	j3787621160 [label="Boolean LyonSpeech is now true.",color=orange];
		j3787621160 -> "Chat ends.";
	j326880511 [label="Third; I do not, nor shall I never comprehend the context of what your companion suffered. And, in a way, no one but they themselves ever shall.",shape=box,color=blue];
		j326880511 -> j2479951756;
	j1796130715 [label="While I... know that great melancholy, it does not inspire my thurible. Marie would never allow it, for one.",shape=box,color=blue];
		j1796130715 -> j1956864042;
	j3453828234 [label="One of the Fathers at the Cathedral taught it to me, not long after I arrived, when he saw that I was similarly... \"blessed,\" and saw fit to aid me. ",shape=box,color=blue];
		j3453828234 -> j2632916461;
	j3721717014 [label="Indeed, I have often wondered if there were not some modern miracle of science that could aid me with my afflictions. Would that I be in such a condition to accept any such help, I would take it. I doubt my physiology would allow for it, now.",shape=box,color=blue];
		j3721717014 -> j991224351;
	j2479951756 [label="To suffer in such a way that is so all-consuming is, by its definition, a solitary thing.",shape=box,color=blue];
		j2479951756 -> j2520278974;
	j1956864042 [label="Boolean LyonSNo is now true.",color=orange];
		j1956864042 -> j1943141243;
		j1956864042 -> j1193472406;
		j1956864042 -> j2807808070;
	j2632916461 [label="Boolean LyonLecture2 is now true.",color=orange];
		j2632916461 -> j2807808070;
		j2632916461 -> j1193472406;
		j2632916461 -> j1943141243;
	j991224351 [label="Regardless, I assure you - I will not die of this. It is an burden I have carried with me since I was a child. And it is a symptom I have decided is better than the underlying festering wound, should I leave the scab un-picked.",shape=box,color=blue];
		j991224351 -> j1511931022;
	j2520278974 [label="I simply pray to my god, and yours, and theirs, that you do not hold guilt in your heart. For if anything in this world or any other is to be forgiven, it is the kindness of knowing someone who has suffered so.",shape=box,color=blue];
		j2520278974 -> j539509983;
	j1943141243 [label="And you're certain you're never going to... take it too far?",shape=box,color=red];
		j1943141243 -> j3723888763;
	j1193472406 [label="I'm struck by how odd religious practices can be, sometimes.",shape=box,color=red];
		j1193472406 -> j585869672;
	j2807808070 [label="That makes me feel a little better, I suppose.",shape=box,color=red];
		j2807808070 -> j3723888763;
	j1511931022 [label="Check boolean LyonSNo",color=orange];
		j1511931022 -> j2997411303 [label=true,color=green];
		j1511931022 -> j1146817606 [label=false,color=brown];
	j539509983 [label="+15 Chemistry",color=orange];
		j539509983 -> j978995653;
	j585869672 [label="I will not find cause to argue with you there. I am fascinated by the differences in religious ceremonies. I deeply enjoy studying all documentation of them.",shape=box,color=blue];
		j585869672 -> j2452264747;
	j2997411303 [label="+10 Chemistry",color=orange];
		j2997411303 -> j478959458;
	j1146817606 [label="If you believe there is some deep and terrible self-loathing that drives my desire to harm myself, I would be quite eager to put those fears to rest.",shape=box,color=blue];
		j1146817606 -> j1660166807;
	j978995653 [label="Bądź zdrów, Włóczęgo. Wkrótce znów porozmawiamy.",shape=box,color=blue];
		j978995653 -> j3651491667;
	j2452264747 [label="Religious anthropology is a subject near and dear to me. There is much you can learn from a society and a people by studying their rituals. ",shape=box,color=blue];
		j2452264747 -> j4253433446;
	j478959458 [label="I will promise you this, however - should I ever truly fear that it comes to a moment that I can no longer trust myself, I will speak the words.",shape=box,color=blue];
		j478959458 -> j4142886171;
	j1660166807 [label="While I... know that great melancholy, it does not inspire my thurible. Marie would never allow it, for one.",shape=box,color=blue];
		j1660166807 -> j2997411303;
	j3651491667 [label="O. Leon Allard",shape=box,color=blue];
		j3651491667 -> "Chat ends.";
	j4253433446 [label="There is a Luminary sect in the far frozen north who worship a corpse they unearthed from a receding glacier. It was perfectly preserved, and no one is certain how old it is. But the brass disk it wore around its neck was stamped with the image of a sun.",shape=box,color=blue];
		j4253433446 -> j2416477871;
	j4142886171 [label="To Marie, to you, to M. Loid, even to Roathe, it will not matter. I will speak the words. This, I vow.",shape=box,color=blue];
		j4142886171 -> j2535636565;
		j4142886171 -> j1158140960;
	j2416477871 [label="They believe the mummified body to be that of Sol himself. And they believe that someday he will return to life and rise again. Every hundred years, they prepare for \"The Great Eve\" and many of their followers drink poisoned wine the night before.",shape=box,color=blue];
		j2416477871 -> j246442559;
	j2535636565 [label="That's the most I could ask for. Thank you, Lyon.",shape=box,color=red];
		j2535636565 -> j3099129276;
	j1158140960 [label="I trust you. I just wanted to walk through it with you.",shape=box,color=red];
		j1158140960 -> j3099129276;
	j246442559 [label="Needless to say, when their mummified body has failed to return come the morning, they have a perfectly good reason as to why their calculations had been wrong, and the date is shifted another century or so.",shape=box,color=blue];
		j246442559 -> j909161093;
	j3099129276 [label="And I deeply appreciate your desire to know that I am not acting out of some unfettered drive to destroy myself.",shape=box,color=blue];
		j3099129276 -> j2721733422;
	j909161093 [label="But I have digressed quite far from the topic at hand.",shape=box,color=blue];
		j909161093 -> j4209829057;
	j2721733422 [label="I am not accustomed to having such companions in my life.",shape=box,color=blue];
		j2721733422 -> j978995653;
}