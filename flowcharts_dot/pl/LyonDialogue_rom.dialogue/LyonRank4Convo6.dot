	j255027449 [label="Leonie, rozmawiałem z Marią o twoich... zwyczajach i zastanawiałem się, czy moglibyśmy pomówić?",shape=box,color=red];
		j255027449 -> j668384320;
	j1298319493 [label="[Wyłącz wszystkie rozmowy o samookaleczeniu. Nie nastąpi żadna utrata punktów chemii z Leonem ani żadną inną postacią.]",shape=box,color=red];
		j1298319493 -> j2161422652;
	j386906797 [label="[Koniec]",shape=box,color=red];
		j386906797 -> "Chat ends.";
	j1356560576 [label="Leonie? Czy możemy porozmawiać o czymś, co może być dla ciebie trochę... niekomfortowe?",shape=box,color=red];
		j1356560576 -> j1635454451;
	j2605509605 [label="Leonie, zastanawiałem się, czy moglibyśmy porozmawiać o tym, dlaczego... zadajesz sobie ból, jeśli nie masz nic przeciwko?",shape=box,color=red];
		j2605509605 -> j2955109284;
	j579295361 [label="[Rozmowa pominięta ze względu na poprzednie ustawienia ostrzeżeń]",shape=box,color=blue];
		j579295361 -> "Chat ends.";
	j668384320 [label="Ostrzegła mnie, że rozmawialiście – i tak, oczywiście. Możesz być zaskoczony, jak łatwo przychodzi mi rozmowa o tej szczególnej przywarze.",shape=box,color=blue];
		j668384320 -> j828470248;
	j2161422652 [label="Boolean LyonPainOff is now true.",color=orange];
		j2161422652 -> j1720833816;
	"Chat ends." [color=orange];
	j1635454451 [label="Zapytać możesz, ale zastrzegam sobie prawo do zaprzestania dyskusji, jeśli uznam, że poruszamy kwestie, które nieszczególnie mam ochotę poruszać.",shape=box,color=blue];
		j1635454451 -> j562939039;
	j2955109284 [label="Mhm. Szczerze mówiąc, to jestem zaskoczony, że tak długo zbierałeś się, by zapytać właśnie o tę moją przywarę. Zwykle to właśnie ona jest powodem największej konsternacji.",shape=box,color=blue];
		j2955109284 -> j2356324916;
	j828470248 [label="Zazwyczaj stanowi ona najczęstszy powód do rozmowy. Czy to z powodu niepokoju, obrzydzenia czy też chorobliwej ciekawości.",shape=box,color=blue];
		j828470248 -> j897187574;
	j1720833816 [label="Jeśli uważasz się za tchórza z powodu podjęcia tego wyboru, to błagam, ale nie musisz się tak czuć. Ten ból nie jest twój. Należy do mnie. Nie prosiłeś o to, by znaleźć się w takim położeniu.",shape=box,color=blue];
		j1720833816 -> j3673824415;
	j562939039 [label="Chodzi o to, że czasami robisz sobie krzywdę. Wolałbym być delikatny, poruszając z tobą tę kwestię i tyle.",shape=box,color=red];
		j562939039 -> j2511304188;
	j2356324916 [label="Czy to z powodu niepokoju, obrzydzenia albo chorobliwej ciekawości, która mogłaby popchnąć kogoś do zajrzenia do celi szaleńca. Zastanawiam się, którym głosem jesteś?",shape=box,color=blue];
		j2356324916 -> j3806298358;
		j2356324916 -> j1559816090;
		j2356324916 -> j1194972153;
		j2356324916 -> j3704700009;
	j897187574 [label="Evaluate expressions",color=orange];
		j897187574 -> j3806298358 [label="LyonBackstory3a",color=purple];
		j897187574 -> j1714035017 [label="LyonBackstory3a",color=purple];
		j897187574 -> j3806298358 [label="LyonBackstory3b",color=purple];
