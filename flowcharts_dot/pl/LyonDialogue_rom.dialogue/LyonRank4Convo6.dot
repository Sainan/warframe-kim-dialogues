		j897187574 -> j1559816090 [label="DrifterHarmLoss",color=purple];
		j897187574 -> j3806298358 [label="false",color=purple];
	j3673824415 [label="To mechaniczne urządzenie, na którym siedzimy, sprawia takie wrażenie, jakby skrywało w sobie jakąś bezduszność. Że zapewnia nam w pewien sposób ochronę przed wszelkimi krzywdami, jakie ktoś mógłby nam wyrządzić wypowiadanymi słowami.",shape=box,color=blue];
		j3673824415 -> j3976876368;
	j2511304188 [label="+5 Chemistry",color=orange];
		j2511304188 -> j3159171128;
	j3806298358 [label="Przepraszam, ale po chwili namysłu stwierdzam, że nie mogę tego zrobić. [Koniec]",shape=box,color=red];
		j3806298358 -> j1720833816;
	j1559816090 [label="[Ostrzeżenie: Rozmowa poruszy temat samobójstwa] Ja... kiedyś utraciłem kogoś bliskiego z powodu tego typu \"nawyków\" i...",shape=box,color=red];
		j1559816090 -> j1215315897;
	j1194972153 [label="Chcę ci tylko pomóc. Upewnić się, że wszystko u ciebie w porządku. To wszystko.",shape=box,color=red];
		j1194972153 -> j4278740242;
	j3704700009 [label="Po prostu uważam, że to nie jest zdrowe i należy to przerwać.",shape=box,color=red];
		j3704700009 -> j4173458533;
	j1714035017 [label="Wiem, że powiedziałeś, że robiłeś sobie krzywdę jeszcze przed spożyciem serum, ale... nie sądzę, żeby to w czymkolwiek miało pomóc.",shape=box,color=red];
		j1714035017 -> j3689351923;
	j3976876368 [label="Powiedziałbym raczej coś przeciwnego – uwalniając się od zbroi, którą zakładamy podczas codziennych interakcji międzyludzkich, zostajemy pozbawieni podstawowej ochrony.",shape=box,color=blue];
		j3976876368 -> j224459537;
	j3159171128 [label="Doceniam to, że podchodzisz do tej sprawy w delikatny sposób, Włóczęgo. Dziękuję. Ale przyzwyczaiłem się, że jest to temat do dyskusji. Czy to z powodu niepokoju, obrzydzenia albo chorobliwej ciekawości – choć sądzę, że już dowiodłeś, iż chodzi o to pierwsze.",shape=box,color=blue];
		j3159171128 -> j3806298358;
		j3159171128 -> j1559816090;
		j3159171128 -> j1194972153;
		j3159171128 -> j3704700009;
	j1215315897 [label="Boolean DrifterHarmLoss is now true.",color=orange];
		j1215315897 -> j1913035626;
	j4278740242 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j4278740242 -> j4131174356;
	j4173458533 [label="Boolean DrifterHarmStop is now true.",color=orange];
		j4173458533 -> j2783851953;
	j3689351923 [label="Nie, obawiam się, że to wcale nie pomaga. To zabrało coś, co było... koniecznością do oczyszczenia umysłu z dręczących mnie wizji i przekształciło się w coś, co jest konieczne, bym mógł korzystać z \"dobrodziejstw\" serum.",shape=box,color=blue];
		j3689351923 -> j1661554809;
	j224459537 [label="Dlatego w sytuacjach takich jak ta... zdaję sobie sprawę, że wypuszczam strzałę, która może trafić nie w przygotowanego do bitwy żołnierza, ale w tętnicę niczego niespodziewającego się jelenia w lesie.",shape=box,color=blue];
		j224459537 -> j2050259222;
	j1913035626 [label="Och, mój przyjacielu... nie potrafię znaleźć słów, które byłyby w stanie odpowiednio wyrazić moje współczucie w związku z tym, przez co musiałeś przejść.",shape=box,color=blue];
		j1913035626 -> j3158336978;
	j4131174356 [label="Check boolean LyonAllRight",color=orange];
		j4131174356 -> j1044303596 [label=true,color=green];
		j4131174356 -> j4093968176 [label=false,color=brown];
	j2783851953 [label="Sądzę, że jest o kilka lat i o jedno serum protoframe'a za późno, żeby położyć kres akurat temu kompulsywnemu zachowaniu, które mam w zwyczaju – obawiam się, że w obecnych okolicznościach ta czynność jest wręcz wskazana, czyż nie?",shape=box,color=blue];
		j2783851953 -> j4165767710;
	j1661554809 [label="+5 Chemistry",color=orange];
		j1661554809 -> j3906539852;
	j2050259222 [label="Zatem zostawię cię z tą myślą:",shape=box,color=blue];
		j2050259222 -> j3286559501;
	j3158336978 [label="W takich chwilach słowa wydają się zbędne. Staramy się wykorzystać je najlepiej, jak potrafimy, ale one zawsze nas zawodzą.",shape=box,color=blue];
		j3158336978 -> j4172214547;
	j1044303596 [label="Po raz kolejny staram się nie roześmiać na myśl tym, że zbliżam się do koncepcji czucia się \"w porządku\". Ale doceniam twoje starania, Włóczęgo.",shape=box,color=blue];
		j1044303596 -> j833720367;
	j4093968176 [label="Staram się nie roześmiać na myśl tym, że zbliżam się do koncepcji czucia się \"w porządku\". Ale doceniam twoje starania, Włóczęgo.",shape=box,color=blue];
		j4093968176 -> j833720367;
	j4165767710 [label="+5 Chemistry",color=orange];
		j4165767710 -> j569560351;
	j3906539852 [label="O ile zdolność do uleczenia mojej potrzeby do samookaleczania się była w moim zasięgu przed wstrzyknięciem serum, to sądzę, że połączenie z Warframem \"Harrow\" sprawiło, że teraz jest to całkowicie niemożliwe.",shape=box,color=blue];
		j3906539852 -> j2232557880;
	j3286559501 [label="Musimy przypomnieć sobie, jak znaleźć w sobie siłę, aby postawić kogoś na nogi, nawet jeśli sami nie jesteśmy w stanie powstać.",shape=box,color=blue];
		j3286559501 -> j450456198;
	j4172214547 [label="Biorąc pod uwagę twoje wyznanie, są trzy rzeczy, które mógłbym zrobić, jeśli mi na to pozwolisz.",shape=box,color=blue];
		j4172214547 -> j3256266734;
	j833720367 [label="+5 Chemistry",color=orange];
		j833720367 -> j244461069;
		j833720367 -> j2842243140;
	j569560351 [label="Ale rzecz jasna nie chcę traktować lekceważąco tego, co w moim mniemaniu jest wyrazem troski o moje zdrowie psychiczne i fizyczne. Wybacz mi. Po prostu nie sądzę, żebym był w stanie tego zaprzestać.",shape=box,color=blue];
		j569560351 -> j244461069;
		j569560351 -> j2842243140;
	j2232557880 [label="Jeśli mogę to ująć prostacko, Włóczęgo, to nie sądzę, abym wciąż był zdolny do wyrządzenia sobie jakiejkolwiek trwałej krzywdy w ten sposób.",shape=box,color=blue];
		j2232557880 -> j477867957;
	j450456198 [label="To jest właśnie prawdziwy cel opowieści.",shape=box,color=blue];
		j450456198 -> j2915308259;
	j3256266734 [label="Po pierwsze: mogę cię zapewnić, że nie zagraża mi żadne niebezpieczeństwo. Jeśli uważasz, że głęboka i straszliwa nienawiść do samego siebie napędza moją chęć do zrobienia sobie krzywdy, to z chęcią rozwieję twoje wątpliwości.",shape=box,color=blue];
		j3256266734 -> j1321311462;
	j244461069 [label="Mogę wiedzieć dlaczego?",shape=box,color=red];
		j244461069 -> j3106172300;
	j2842243140 [label="Obawiam się tylko, że możesz pójść o krok za daleko.",shape=box,color=red];
		j2842243140 -> j2232557880;
	j477867957 [label="Choć nie silę się na pychę, by uważać się za osobę całkowicie odporną, takie działanie wydaje mi się... jakby to powiedzieć... częścią większego planu.",shape=box,color=blue];
		j477867957 -> j548168603;
	j2915308259 [label="+20 Chemistry",color=orange];
		j2915308259 -> j3203327403;
	j1321311462 [label="Choć... noszę w sobie tę wielką melancholię, nie stanowi ona inspiracji dla mojej kadzielnicy. (Maria nigdy by na to nie pozwoliła. Sama prędzej dałaby mi popalić, niż pozwoliłaby mi się do niej ponownie zbliżyć).",shape=box,color=blue];
		j1321311462 -> j1395200926;
	j3106172300 [label="Evaluate expressions",color=orange];
		j3106172300 -> j4154335739 [label="LyonBackstory3a, LyonLecture2",color=purple];
		j3106172300 -> j4154335739 [label="LyonBackstory3b, LyonLecture2",color=purple];
		j3106172300 -> j3010982390 [label="LyonBackstory3a",color=purple];
		j3106172300 -> j3010982390 [label="LyonBackstory3b",color=purple];
		j3106172300 -> j3497999195 [label="false",color=purple];
	j548168603 [label="+5 Chemistry",color=orange];
		j548168603 -> j2684750532;
	j3203327403 [label="Bądź zdrów, Włóczęgo. Wkrótce znów porozmawiamy.",shape=box,color=blue];
		j3203327403 -> j2524336129;
	j1395200926 [label="Lecz tak głęboki ból nigdy nie szeptał mi nocą do ucha, przyjacielu. Mogę cię o tym zapewnić. I przysiąc na wszystko, co jest mi bliskie.",shape=box,color=blue];
		j1395200926 -> j2223197474;
	j4154335739 [label="Powiedziałem prawdę o tym, co mnie inspiruje do działania – ból oczyszcza mój umysł z dręczących mnie wizji. I ta praktyka nie jest czymś wstydliwym dla Braci Lua, jak mogłoby być w twojej kulturze. Mogę przysiąc na wszystko, co mi bliskie, że wcale nie próbuję robić z tego tajemnicy.",shape=box,color=blue];
		j4154335739 -> j2198489953;
	j3010982390 [label="To skomplikowany temat, ponieważ powody, dla których krzywdzę własne ciało, nie są odosobnione. Mówiłem ci o wizjach, które mnie trapią i o tym, że ból pozwala mi oczyścić umysł. Ale sam akt samookaleczania nie stanowi tematu tabu, jak mogłoby się wydawać.",shape=box,color=blue];
		j3010982390 -> j1084587307;
	j3497999195 [label="To skomplikowany temat, ponieważ powody, dla których krzywdzę własne ciało, nie są odosobnione. Pragnę cię najpierw zapewnić, że wcale nie stanowi to dla mnie tematu tabu, jak mogłoby się wydawać w dzisiejszych czasach.",shape=box,color=blue];
		j3497999195 -> j1084587307;
	j2684750532 [label="Nie uważam, że to, co robię, jest \"słuszne\". Nie uważam, że inni powinni mnie naśladować. Nie uważam, że moje praktyki są godne pozazdroszczenia.",shape=box,color=blue];
		j2684750532 -> j3856867411;
	j2524336129 [label="O. Leon Allard",shape=box,color=blue];
		j2524336129 -> j3787621160;
	j2223197474 [label="Po drugie: muszę cię pochwalić za to, że wykazałeś się nie lada odwagą, kierując do mnie te słowa. Łatwiej byłoby ich uniknąć. Ty tego nie zrobiłeś.",shape=box,color=blue];
		j2223197474 -> j1539130300;
	j2198489953 [label="Jeśli uważasz, że głęboka i straszliwa nienawiść do samego siebie napędza moją chęć do zrobienia sobie krzywdy, to z chęcią rozwieję twoje wątpliwości.",shape=box,color=blue];
		j2198489953 -> j2596485229;
	j1084587307 [label="Praktyka biczowania funkcjonuje wśród Braci Lua od zarania dziejów. Jest ona rzadka i nawet w moich czasach postrzegano ją jako archaiczną i stosowana przez tych, którzy zostali \"pobłogosławieni jej wizjami\".",shape=box,color=blue];
		j1084587307 -> j4035723294;
	j3856867411 [label="Jednak nie jest to – w moim jakże wyjątkowym i raczej \"nadprzyrodzonym\" w najbardziej dosłownym tego słowa znaczeniu – stan, który bezpośrednio mi zagraża.",shape=box,color=blue];
		j3856867411 -> j2583656390;
	j3787621160 [label="Boolean LyonSpeech is now true.",color=orange];
		j3787621160 -> "Chat ends.";
	j1539130300 [label="Po trzecie: nie rozumiałem i nigdy nie poznałem kontekstu cierpienia twojego towarzysza. I w pewnym sensie nikt poza nim samym nie jest w stanie tego zrozumieć.",shape=box,color=blue];
		j1539130300 -> j2744246862;
	j2596485229 [label="Choć... noszę w sobie tę wielką melancholię, nie stanowi ona inspiracji dla mojej kadzielnicy. Maria nigdy by na to nie pozwoliła.",shape=box,color=blue];
		j2596485229 -> j1956864042;
	j4035723294 [label="Jeden z Ojców w Katedrze nauczył mnie tego niedługo po moim przybyciu, gdy dostrzegł, że zostałem podobnie... \"pobłogosławiony\" i postanowił mi pomóc.",shape=box,color=blue];
		j4035723294 -> j2632916461;
	j2583656390 [label="Owszem, często zastanawiam się, czy nie istnieje jakiś współczesny cud nauki, który mógłby pomóc w moich dolegliwościach. I gdybym był w stanie przyjąć tego typu pomoc, to bym się nie wahał. Wątpię jednak, żeby moja obecna fizjologia na to pozwalała.",shape=box,color=blue];
		j2583656390 -> j1654551819;
	j2744246862 [label="Tego typu cierpienie jest tak ze wszech miar pochłaniające, że zgodnie z definicją, jest czymś doświadczanym w samotności.",shape=box,color=blue];
		j2744246862 -> j1347959713;
	j1956864042 [label="Boolean LyonSNo is now true.",color=orange];
		j1956864042 -> j4040620207;
		j1956864042 -> j4110168609;
		j1956864042 -> j4009188622;
	j2632916461 [label="Boolean LyonLecture2 is now true.",color=orange];
		j2632916461 -> j4009188622;
		j2632916461 -> j4110168609;
		j2632916461 -> j4040620207;
	j1654551819 [label="Tak czy inaczej, mogę cię zapewnić, że nie umrę z tego powodu. To ciężar, który noszę w sobie od dziecka. I to objaw, który uznałem za lepszy, niż ropiejąca rana, jeśli nie będę rozdrapywać tego strupa.",shape=box,color=blue];
		j1654551819 -> j1511931022;
	j1347959713 [label="Modlę się o to do swojego i twojego boga, abyś nie nosił w sercu poczucia winy. Bo jeśli cokolwiek na tym świecie czy jakimkolwiek innym zasługuje na wybaczenie, to dobroć obcowania z kimś, kto takie cierpienie nosił w sobie.",shape=box,color=blue];
		j1347959713 -> j539509983;
	j4040620207 [label="I jesteś pewny, że nigdy nie posuniesz się... za daleko?",shape=box,color=red];
		j4040620207 -> j2232557880;
	j4110168609 [label="Czasem zdumiewa mnie, jak dziwne potrafią być praktyki religijne.",shape=box,color=red];
		j4110168609 -> j1270003004;
	j4009188622 [label="Chyba czuję się dzięki temu trochę lepiej.",shape=box,color=red];
		j4009188622 -> j2232557880;
