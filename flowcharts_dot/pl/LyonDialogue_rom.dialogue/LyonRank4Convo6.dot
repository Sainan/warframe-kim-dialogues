		j539509983 -> j978995653;
	j1270003004 [label="Nie będę się z tobą sprzeczał w tej kwestii. Fascynują mnie różnice w obrządkach religijnych. Z wielką przyjemnością zgłębiam wszelką dokumentację na ich temat.",shape=box,color=blue];
		j1270003004 -> j3687079624;
	j3273018270 [label="+10 Chemistry",color=orange];
		j3273018270 -> j3789917396;
	j1459870305 [label="Jeśli uważasz, że głęboka i straszliwa nienawiść do samego siebie napędza moją chęć do zrobienia sobie krzywdy, to z chęcią rozwieję twoje wątpliwości.",shape=box,color=blue];
		j1459870305 -> j2909744289;
	j978995653 [label="Bądź zdrów, Włóczęgo. Wkrótce znów porozmawiamy.",shape=box,color=blue];
		j978995653 -> j3651491667;
	j3687079624 [label="Antropologia religijna jest dziedziną bliską mojemu sercu. Można się wiele nauczyć o społeczeństwie i ludziach, poznając ich rytuały. ",shape=box,color=blue];
		j3687079624 -> j3284272525;
	j3789917396 [label="Mogę ci to obiecać. Jeśli jednak kiedyś zacznę się obawiać, że nadchodzi taka chwila, w której nie mogę już sobie zaufać, to z pewnością powiem o tym.",shape=box,color=blue];
		j3789917396 -> j2395261443;
	j2909744289 [label="Choć... noszę w sobie tę wielką melancholię, nie stanowi ona inspiracji dla mojej kadzielnicy. Maria nigdy by na to nie pozwoliła.",shape=box,color=blue];
		j2909744289 -> j3273018270;
	j3651491667 [label="O. Leon Allard",shape=box,color=blue];
		j3651491667 -> "Chat ends.";
	j3284272525 [label="Na dalekiej, mroźnej północy istnieje sekta Świetlistych, która czci zwłoki ujawnione przez cofający się lodowiec. Były doskonale zachowane i nikt nie wie, ile mają lat. Na szyi wisiała mosiężna płytka z wytłoczonym wizerunkiem słońca.",shape=box,color=blue];
		j3284272525 -> j3781649672;
	j2395261443 [label="Marii, tobie, P. Loidowi, nawet Roathe'owi – to bez znaczenia. Tak powiadam. Przysięgam.",shape=box,color=blue];
		j2395261443 -> j909670948;
		j2395261443 -> j1366221524;
	j3781649672 [label="Wierzą, że zmumifikowane ciało należy do samego Sol. Wierzą też, że pewnego dnia powróci do żywych i zmartwychwstanie. Co sto lat przygotowują się do \"Wielkiej Wigilii\", a ich liczni wyznawcy wcześniejszego wieczora piją zatrute wino.",shape=box,color=blue];
		j3781649672 -> j2798772281;
	j909670948 [label="O więcej nie mógłbym prosić. Dziękuję, Leonie.",shape=box,color=red];
		j909670948 -> j3438928731;
	j1366221524 [label="Ufam ci. Po prostu chciałem to z tobą omówić.",shape=box,color=red];
		j1366221524 -> j3438928731;
	j2798772281 [label="Nie muszę chyba dodawać, że gdy okazywało się rano, że zmumifikowane ciało nie zmartwychwstało, zawsze mieli doskonałe wytłumaczenie, dlaczego ich obliczenia był błędne, a ten wielki dzień przesuwał się na kolejne stulecie.",shape=box,color=blue];
		j2798772281 -> j1671723639;
	j3438928731 [label="I niezmiernie doceniam twoją chęć upewnienia się, że nie kieruje mną nieokiełznana chęć samozniszczenia.",shape=box,color=blue];
		j3438928731 -> j2231508864;
	j1671723639 [label="Ale sądzę, że zbyt daleko odszedłem od głównego tematu.",shape=box,color=blue];
		j1671723639 -> j548168603;
	j2231508864 [label="Nie przywykłem do takich towarzyszy w moim życiu.",shape=box,color=blue];
		j2231508864 -> j978995653;
}