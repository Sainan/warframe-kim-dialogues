		j897187574 -> j1194972153 [label="DrifterHarmHelp",color=purple];
		j897187574 -> j3806298358 [label="DrifterHarmStop",color=purple];
		j897187574 -> j3704700009 [label="DrifterHarmStop",color=purple];
