		342 -> 354;
	343 [label="Wybacz, ale zaczynam się martwić, gdy ktoś czuje się \"usprawiedliwiony\" w jakimś działaniu, zwłaszcza wtedy, gdy mówimy o przewidywaniu czyichś motywacji.",shape=box,color=blue];
		343 -> 355;
