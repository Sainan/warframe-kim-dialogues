		j1380986697 -> j3416524976;
	j3432879884 [label="Ach. Tak. Sensowne uściślenie. Chyba chodzi mi o metaforę. Szept wyraźnie składa się z pyłu i popiołu.",shape=box,color=blue];
		j3432879884 -> j681622754;
