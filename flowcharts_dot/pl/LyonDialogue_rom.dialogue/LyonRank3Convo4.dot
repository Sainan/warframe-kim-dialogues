		j489671608 -> j1670382734;
	j2570830398 [label="Przykro mi, że ci to powiedziała. Myślę, że Obojętność jest prawdziwym bóstwem – obdarzonym prawdziwą świadomością.",shape=box,color=red];
		j2570830398 -> j4217905354;
