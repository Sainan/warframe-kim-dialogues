		344 -> 357;
	345 [label="Myślę, że Obojętność próbuje nauczyć się być \"ludzką\". Zawsze była czymś więcej. Czymś innym. Więc uczy się, jak istnieć jako coś mniejszego, jak my.",shape=box,color=red];
