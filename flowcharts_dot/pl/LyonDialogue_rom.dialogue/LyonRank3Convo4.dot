	j320988305 [label="Ach. Wybacz mi, że źle to odebrałem. Doceniam twoją szczerość, nawet w obliczu niepewności, choć pozostawia mnie samego z moimi rozważaniami.",shape=box,color=blue];
		j320988305 -> j3330080882;
