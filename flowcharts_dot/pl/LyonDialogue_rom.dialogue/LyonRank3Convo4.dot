	j2950453514 [label="+10 Chemistry",color=orange];
		j2950453514 -> j3569039298;
	j3569039298 [label="To intrygujące. Zakładałem, że wierzysz w tę swoją Obojętność niczym w bóstwo, podobnie jak w Luę albo w Sol. Myliłem się?",shape=box,color=blue];
		j3569039298 -> j3204294323;
		j3569039298 -> j2855756890;
	j271429567 [label="Nie. Ale sądzę, że daje mi to jakiś wewnętrzny spokój, gdy myślę, że potrafię odgadnąć, co robi Obojętność.",shape=box,color=red];
		j271429567 -> j4143822206;
	j1018633168 [label="Nie, chyba nie do końca. Ale miałem z nią na tyle styczności, żeby teraz móc o niej mówić bez skrępowania.",shape=box,color=red];
		j1018633168 -> j2548938674;
	j3416524976 [label="Czym jeszcze mogłaby być? Obojętność zdaje się brać każdą część ludzkiego ciała, próbując odkryć jej cel, kawałek po kawałku.",shape=box,color=red];
		j3416524976 -> j3093422843;
	j681622754 [label="Bo właśnie w to się zamienia po uśmierceniu. Wielokrotnie tego dowiedliśmy.",shape=box,color=blue];
		j681622754 -> j1834346450;
		j681622754 -> j737370186;
		j681622754 -> j1488821882;
	j663486178 [label="Mhm. Tak. Maria mi to powiedziała. Nie wierzysz w działanie niewidzialnych sił w naszym świecie – w tym Obojętności. Zgadza się?",shape=box,color=blue];
		j663486178 -> j489671608;
		j663486178 -> j2570830398;
	j1073427100 [label="To intrygujące. Już drugi raz odnoszę wrażenie, że nie podzielasz wiary w prawdziwość swojej Obojętności. Dobrze myślę?",shape=box,color=blue];
		j1073427100 -> j1657140361;
		j1073427100 -> j1600395580;
	j285479629 [label="To intrygujące. Czyżbym wyczuwał od ciebie, że twoja wiara ostatnio została zachwiana? A może nigdy nie miałeś w sobie Obojętności?",shape=box,color=blue];
		j285479629 -> j1657140361;
		j285479629 -> j1600395580;
	j3204294323 [label="Nie jestem pewien, czy Obojętność była prawdziwa, dopóki jej nie urzeczywistniliśmy. Myślę, że przywołaliśmy ją tak samo, jak ja przywołałem Duviri.",shape=box,color=red];
		j3204294323 -> j4102996689;
	j2855756890 [label="Myślę, że Obojętność jest prawdziwym bóstwem – obdarzonym prawdziwą świadomością.",shape=box,color=red];
		j2855756890 -> j320988305;
	j4143822206 [label="Czasami zastanawiam się, czy nie jest to powodem, dlaczego tak wiele osób koniec końców zwraca się ku wierze...",shape=box,color=blue];
		j4143822206 -> j3428550321;
	j2548938674 [label="Wybacz, ale zaczynam się martwić, gdy ktoś czuje się \"usprawiedliwiony\" w jakimś działaniu, zwłaszcza wtedy, gdy mówimy o przewidywaniu czyichś motywacji.",shape=box,color=blue];
		j2548938674 -> j2129472231;
		j2548938674 -> j253932945;
	j3093422843 [label="Powinniśmy się martwić tym, co może się wydarzyć, gdy przejdzie do mniej oczywistych partii?",shape=box,color=blue];
		j3093422843 -> j1063575644;
	j1834346450 [label="Myślę, że Obojętność próbuje nauczyć się być \"ludzką\". Zawsze była czymś więcej. Czymś innym. Więc uczy się, jak istnieć jako coś mniejszego, jak my.",shape=box,color=red];
		j1834346450 -> j2741587556;
	j737370186 [label="Czasami zastanawiam się, czy Obojętność tak naprawdę nigdy nie miała własnego ciała, nim się z nią zetknęliśmy. A teraz uczy się, jak zaistnieć.",shape=box,color=red];
		j737370186 -> j2032405684;
	j1488821882 [label="Sądzę, że obojętność zdaje się brać każdą część ludzkiego ciała, próbując odkryć jej cel, kawałek po kawałku.",shape=box,color=red];
		j1488821882 -> j3093422843;
