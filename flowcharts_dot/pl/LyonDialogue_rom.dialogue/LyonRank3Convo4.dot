		j1657140361 -> j4102996689;
	j1600395580 [label="Nie, nie chciałem, żeby tak to zabrzmiało, przepraszam. Myślę, że Obojętność jest prawdziwym bóstwem – obdarzonym prawdziwą świadomością.",shape=box,color=red];
