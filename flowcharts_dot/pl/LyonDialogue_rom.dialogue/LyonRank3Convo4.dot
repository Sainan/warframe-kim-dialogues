	328 [label="To intrygujące. Zakładałem, że wierzysz w tę swoją Obojętność niczym w bóstwo, podobnie jak w Luę albo w Sol. Myliłem się?",shape=box,color=blue];
		328 -> 337;
		328 -> 338;
	333 [label="Nie. Ale sądzę, że daje mi to jakiś wewnętrzny spokój, gdy myślę, że potrafię odgadnąć, co robi Obojętność.",shape=box,color=red];
		333 -> 342;
	334 [label="Nie, chyba nie do końca. Ale miałem z nią na tyle styczności, żeby teraz móc o niej mówić bez skrępowania.",shape=box,color=red];
		334 -> 343;
	335 [label="Czym jeszcze mogłaby być? Obojętność zdaje się brać każdą część ludzkiego ciała, próbując odkryć jej cel, kawałek po kawałku.",shape=box,color=red];
		335 -> 344;
	336 [label="Bo właśnie w to się zamienia po uśmierceniu. Wielokrotnie tego dowiedliśmy.",shape=box,color=blue];
		336 -> 345;
		336 -> 346;
		336 -> 347;
	341 [label="Mhm. Tak. Maria mi to powiedziała. Nie wierzysz w działanie niewidzialnych sił w naszym świecie – w tym Obojętności. Zgadza się?",shape=box,color=blue];
		341 -> 352;
		341 -> 353;
	340 [label="To intrygujące. Już drugi raz odnoszę wrażenie, że nie podzielasz wiary w prawdziwość swojej Obojętności. Dobrze myślę?",shape=box,color=blue];
		340 -> 350;
		340 -> 351;
	339 [label="To intrygujące. Czyżbym wyczuwał od ciebie, że twoja wiara ostatnio została zachwiana? A może nigdy nie miałeś w sobie Obojętności?",shape=box,color=blue];
		339 -> 350;
		339 -> 351;
	337 [label="Nie jestem pewien, czy Obojętność była prawdziwa, dopóki jej nie urzeczywistniliśmy. Myślę, że przywołaliśmy ją tak samo, jak ja przywołałem Duviri.",shape=box,color=red];
		337 -> 348;
