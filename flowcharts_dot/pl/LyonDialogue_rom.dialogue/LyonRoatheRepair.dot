	j1328555141 [label="Czy naprawdę znalazłeś się w tak nędznej sytuacji, żeby zwracać się do Roathe'a, by ten nękał mnie w twoim imieniu w sprawie... przyjęcia przeprosin?",shape=box,color=blue];
