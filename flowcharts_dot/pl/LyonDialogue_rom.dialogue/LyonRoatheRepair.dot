	j2198846785 [label="Czy naprawdę znalazłeś się w tak nędznej sytuacji, żeby zwracać się do Roathe'a, by ten nękał mnie w twoim imieniu?",shape=box,color=blue];
		j2198846785 -> j2663964586;
	"Chat ends." [color=orange];
	j3178670663 [label="Zdajesz sobie sprawę, że to brzmi jak farsa, prawda?",shape=box,color=blue];
		j3178670663 -> j77325151;
		j3178670663 -> j3729384244;
	j1851844330 [label="Nie chcę marnować więcej czasu, niż jest to konieczne. Powiem tylko: niech będzie.",shape=box,color=blue];
		j1851844330 -> j2169173578;
	j2663964586 [label="Popraw mnie, jeśli się mylę, ale problemem było to, że nie chciałeś brnąć przez moją przeszłość. Teraz zmieniłeś zdanie?",shape=box,color=blue];
		j2663964586 -> j1045135954;
	j77325151 [label="Nie wiedziałem, że powiedział, że przeproszę.",shape=box,color=red];
		j77325151 -> j2259577589;
	j3729384244 [label="Nie wiedziałem, co innego zrobić. Teraz rozumiem, jakie to absurdalne.",shape=box,color=red];
		j3729384244 -> j4089504848;
	j2169173578 [label="Check boolean MarieFamilyFail",color=orange];
		j2169173578 -> j2292527559 [label=true,color=green];
		j2169173578 -> j895844599 [label=false,color=brown];
	j1045135954 [label="Nie rozumiem. Nie możemy tego cofnąć. Nie możemy nie spalić tego mostu.",shape=box,color=blue];
		j1045135954 -> j3503588836;
		j1045135954 -> j49686605;
	j2259577589 [label="Rozumiem.",shape=box,color=blue];
		j2259577589 -> "Chat ends.";
	j4089504848 [label="Przyznam, że komiczna natura tej prośby, nakłoniła mnie do poświęcenia jej czasu. Jesteś aż tak zrozpaczony? Nie potrafię sobie wyobrazić, by brak mojej obecności w twoim życiu był tak okropny.",shape=box,color=blue];
		j4089504848 -> j3050312060;
	j2292527559 [label="Możesz liczyć na moją pomoc. Lękam się tego, co twój diabeł zrobi z Marią.",shape=box,color=blue];
		j2292527559 -> j92487004;
	j895844599 [label="Możesz liczyć na moją pomoc. Teraz proszę, odwołaj swojego czorta.",shape=box,color=blue];
		j895844599 -> j770168571;
	j3503588836 [label="No cóż, to kompletna strata czasu, nie?",shape=box,color=red];
		j3503588836 -> "Chat ends.";
	j49686605 [label="Więc... powiem tylko, że popełniłem błąd. Powinienem był cię wysłuchać.",shape=box,color=red];
		j49686605 -> j3724425758;
	j3050312060 [label="Ale tak jest. Zależy mi na tobie i wiem, że cię zawiodłem.",shape=box,color=red];
		j3050312060 -> j2241593249;
	j92487004 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j92487004 -> j547953661;
	j770168571 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j770168571 -> j3711686580;
	j3724425758 [label="Mogę wiedzieć, dlaczego tak postąpiłeś? Czy przeraziło cię to, czego mogłeś się dowiedzieć? A może cię to nudziło? Myślałeś, że zabraknie ci sił, żeby nie załamać się pod ciężarem moich zwierzeń?",shape=box,color=blue];
		j3724425758 -> j1459446150;
		j3724425758 -> j2154048461;
		j3724425758 -> j756835646;
	j2241593249 [label="I jest mi tak bardzo, bardzo przykro.",shape=box,color=red];
		j2241593249 -> j3935570917;
	j547953661 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j547953661 -> "Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j3711686580 [label="Boolean LyonFamilyFail is now false.",color=orange];
