	2306 [label="Rozumiem.",shape=box,color=blue];
		2306 -> 2312;
	2307 [label="The comical nature of it, I admit, is part of what made me come and investigate. Are you so distraught? I cannot imagine the lack of my companionship in your life is so terrible a thing.",shape=box,color=blue];
