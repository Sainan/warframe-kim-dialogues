	j1459446150 [label="Bałem się tego.",shape=box,color=red];
		j1459446150 -> j3651412881;
	j2154048461 [label="Nie sądziłem, że mam w sobie wystarczająco siły, żeby sobie z tym poradzić.",shape=box,color=red];
		j2154048461 -> j3651412881;
	j756835646 [label="Wtedy mnie to nie obchodziło. Ale teraz już tak.",shape=box,color=red];
		j756835646 -> j865928976;
	j3935570917 [label="Nie wiedziałem, co jeszcze mogę zrobić, poza zwróceniem się do Roathe'a z prośbą o pomoc.",shape=box,color=red];
		j3935570917 -> j559923617;
	"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
	j3651412881 [label="W takim razie moim jedynym wyjściem jest ci przebaczyć.",shape=box,color=blue];
		j3651412881 -> j106665696;
	j865928976 [label="A co się zmieniło, że nagle zaczęło ci zależeć?",shape=box,color=blue];
		j865928976 -> j1544259699;
		j865928976 -> j2746204601;
	j559923617 [label="Nie pozostaje mi więc nic innego, jak tylko ci przebaczyć. Nie pojmuję, dlaczego pragnąłbyś, aby ktoś tak zniszczony jak ja, marnował miejsce w twoim życiu.",shape=box,color=blue];
