		j1544259699 -> j3651412881;
	j2746204601 [label="Czuję, że zrozumienie twojej historii, jest kluczowe dla naszego sukcesu.",shape=box,color=red];
		j2746204601 -> j2759640754;
	j311282731 [label="Ale czuję, że moje poirytowanie twoimi słowami zanika, kiedy zrozumiałem, do czego jesteś gotów się posunąć, żeby utrzymać mnie przy sobie.",shape=box,color=blue];
