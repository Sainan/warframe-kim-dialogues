		j410090499 -> j3511307974 [label="LyonRell1",color=purple];
		j410090499 -> "Chat ends." [label="false",color=purple];
	j818020220 [label="Nie jestem z tego dumny, ale wypiłem całą butelkę wina i teraz jestem gotów opowiedzieć ci to wszystko, czego tak rozpaczliwie starałem się nie mówić, mon miracle...",shape=box,color=blue];
		j818020220 -> j3533120738;
	j3511307974 [label="Nie jestem z tego dumny, ale wypiłem całą butelkę wina i teraz jestem gotów opowiedzieć ci to wszystko, czego tak rozpaczliwie starałem się nie mówić...",shape=box,color=blue];
		j3511307974 -> j3533120738;
	"Chat ends." [color=orange];
	j3533120738 [label="Jeśli w tej butelce faktycznie znajdowało się wino, bo ciężko to wywnioskować po etykiecie – a p. Loid nie był do końca pewien, czy to, co w moich czasach nazywaliśmy winem, jest tym samym.",shape=box,color=blue];
		j3533120738 -> j2030427229;
	j2030427229 [label="Na swoją obronę dodam, że nie miałem zamiaru wypić całej butelki... próbowałem tylko stwierdzić, czy to faktycznie ta sama substancja, no a po chwili już nic nie zostało...",shape=box,color=blue];
		j2030427229 -> j3940009447;
		j2030427229 -> j2052459873;
		j2030427229 -> j2859189591;
	j3940009447 [label="Nie, nie będę brał w tym udziału.",shape=box,color=red];
		j3940009447 -> j3220387131;
	j2052459873 [label="I smakuje tak samo?",shape=box,color=red];
		j2052459873 -> j569426797;
	j2859189591 [label="Jesteś pijany?",shape=box,color=red];
		j2859189591 -> j3913173833;
	j3220387131 [label="Gdybym tylko ja mógł od tego tak łatwo uciec. Wcale ci się nie dziwię.",shape=box,color=blue];
		j3220387131 -> j3856020424;
	j569426797 [label="Nie wiem! Właśnie to było najbardziej frustrujące! Ale ja nie o tym. Celem było upicie się. A nawet nie wiem, czy mi się to udało. Z całą pewnością nie jestem trzeźwy, ale...",shape=box,color=blue];
		j569426797 -> j916015723;
	j3913173833 [label="Jest taka możliwość. Z pewnością nie nazwałbym się trzeźwą osobą.",shape=box,color=blue];
		j3913173833 -> j2018798778;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j916015723 [label="Myślę, że to musi mi wystarczyć.",shape=box,color=blue];
		j916015723 -> j3039569478;
		j916015723 -> j1263790046;
	j2018798778 [label="A właśnie taki był cel tego przedsięwzięcia. Więc przypuszczam, że to musi już wystarczyć.",shape=box,color=blue];
		j2018798778 -> j3039569478;
		j2018798778 -> j1263790046;
	j3039569478 [label="Co jest tak okropnego, że musiałeś się upić, żeby mi o tym powiedzieć?",shape=box,color=red];
		j3039569478 -> j2334048188;
	j1263790046 [label="To opowiadaj...",shape=box,color=red];
		j1263790046 -> j2334048188;
	j2334048188 [label="Stuku... puku... puk...",shape=box,color=blue];
		j2334048188 -> j4169440869;
		j2334048188 -> j2922833442;
	j4169440869 [label="... Och.",shape=box,color=red];
		j4169440869 -> j1945614689;
	j2922833442 [label="Zapowiada się ciekawie.",shape=box,color=red];
		j2922833442 -> j1945614689;
	j1945614689 [label="Wiem z całą pewnością, że nie byli obecni w mojej głowie od zawsze. Tenno zwany Rellem i jego opiekun, Harrow. To niemożliwe, by kiedykolwiek byli w moim rodzinnym domu.",shape=box,color=blue];
		j1945614689 -> j3532775973;
	j3532775973 [label="Niemożliwe też, by przez te wszystkie lata rozbrzmiewali w mojej głowie za sprawą szeptów, bełkotu i wizji. A jednak w moich wspomnieniach wciąż ich tam widzę i słyszę.",shape=box,color=blue];
		j3532775973 -> j252073137;
	j252073137 [label="Check boolean LyonTime1",color=orange];
		j252073137 -> j3057162595 [label=true,color=green];
		j252073137 -> j4103580642 [label=false,color=brown];
	j3057162595 [label="Zrozumiałem wszystko, co Entrati mówił o tym, jak energia może istnieć w czasie w kilku miejscach jednocześnie w sensie filozoficznym. Ale nie rozumiałem tego na płaszczyźnie emocjonalnej, dopóki... nie wstrzyknąłem sobie serum.",shape=box,color=blue];
		j3057162595 -> j1163198122;
	j4103580642 [label="To tak, jakby w chwili wstrzyknięcia serum, wszystko stało się jednością. Gdy Entrati się ujawnił i wyznał całą prawdę o swoim istnieniu... ",shape=box,color=blue];
		j4103580642 -> j517578781;
	j1163198122 [label="Czasami widzę oczyma wyobraźni rozległą, spokojną taflę jeziora, która rozciąga się we wszystkich kierunkach. Czarną i gładką, niczym onyksowe lustro przepowiadające przyszłość.",shape=box,color=blue];
		j1163198122 -> j3733572690;
	j517578781 [label="Opowiedział mi wszystko, co wiedział o \"splątaniu kwantowym\", \"superpozycji\", \"eternalizmie\" i tym podobnych.",shape=box,color=blue];
		j517578781 -> j311644748;
	j3733572690 [label="Wielkie, wspaniałe jezioro, które ciągnie się w nieskończoność. Nie da się tego pojąć.",shape=box,color=blue];
		j3733572690 -> j3436779522;
	j311644748 [label="Zrozumiałem te wszystkie naukowe zagadnienia raczej w aspekcie filozoficznym. Ale nie rozumiałem tego na płaszczyźnie emocjonalnej, dopóki... nie wstrzyknąłem sobie serum.",shape=box,color=blue];
		j311644748 -> j1163198122;
	j3436779522 [label="I właśnie tam ich znalazłem. Tam się spotykaliśmy. I tam też mogłem Ich poczuć...",shape=box,color=blue];
		j3436779522 -> j492557451;
	j492557451 [label="Ich?",shape=box,color=red];
		j492557451 -> j1072880389;
	j1072880389 [label="Innych Harrowów... Puste posągi, echa ech ech... Ciągną się i ciągną w nieskończoność we wszystkich kierunkach...",shape=box,color=blue];
		j1072880389 -> j3565460081;
	j3565460081 [label="Rell rozgościł się w jednym z nich. Zatracił się w jego wnętrzu. I robiąc to, zatracił się w nich wszystkich...",shape=box,color=blue];
		j3565460081 -> j3796007555;
	j3796007555 [label="Łącznie ze mną. A także Harrowem w serum, które mnie stworzyło.",shape=box,color=blue];
		j3796007555 -> j1354691274;
		j3796007555 -> j4184644889;
	j1354691274 [label="Na Pustkę, nie zdawałem sobie z tego sprawy...",shape=box,color=red];
		j1354691274 -> j2565162695;
	j4184644889 [label="Och nie...",shape=box,color=red];
		j4184644889 -> j2565162695;
	j2565162695 [label="Byli tam ze mną, w moich myślach – Rell i jego Harrow, tak podobni do mnie, a jednocześnie tak ode mnie różni.",shape=box,color=blue];
		j2565162695 -> j2234864929;
	j2234864929 [label="Nie bał się. Był tak pewny siebie. Dwie rzeczy, którymi ja nie dysponowałem.",shape=box,color=blue];
		j2234864929 -> j3262167875;
	j3262167875 [label="Nie kłaniał się Obojętności, nie dbając o to, czym była, a czym nie. Po prostu wiedział, co trzeba zrobić.",shape=box,color=blue];
		j3262167875 -> j1173531996;
	j1173531996 [label="Nawet po tym całym okrucieństwie, którego doświadczył. Przez te wszystkie lata \"teraz\" i \"wtedy\" w tej wieczności, w chwili, gdy wstrzyknąłem serum... \"przed\" i \"po\" on wciąż przy mnie był.",shape=box,color=blue];
		j1173531996 -> j3864959525;
	j3864959525 [label="Był moim przyjacielem. Był moim bratem.",shape=box,color=blue];
		j3864959525 -> j582195329;
	j582195329 [label="Wtedy? A w teraz?",shape=box,color=blue];
		j582195329 -> j1747881440;
	j1747881440 [label="Już go nie wyczuwam.",shape=box,color=blue];
		j1747881440 -> j1635108473;
		j1747881440 -> j3197097090;
	j1635108473 [label="On... odpoczywa teraz, Leonie... zaznał spokoju.",shape=box,color=red];
		j1635108473 -> j3977884861;
	j3197097090 [label="Och, Leonie...",shape=box,color=red];
		j3197097090 -> j3220660979;
	j3977884861 [label="Wiem. Czułem to, gdy odszedł. I płakałem. Bardzo za nim tęsknię. Wiem, że wciąż rezonuje – w jakiś dziwny sposób, choć nie do końca wiem jak.",shape=box,color=blue];
		j3977884861 -> j4203997273;
		j3977884861 -> j1072767011;
	j3220660979 [label="Bardzo za nim tęsknię. Wiem, że wciąż rezonuje – w jakiś dziwny sposób, choć nie do końca wiem jak.",shape=box,color=blue];
		j3220660979 -> j4203997273;
		j3220660979 -> j1072767011;
	j4203997273 [label="Rell był najsilniejszy z nas wszystkich. Cieszę się, że miałeś okazję go poznać.",shape=box,color=red];
		j4203997273 -> j2027252854;
	j1072767011 [label="Rell był wyrzutkiem z powodu ignorancji i okrucieństwa dzieci... nie zasłużył na to, co go spotkało.",shape=box,color=red];
		j1072767011 -> j873853199;
	j2027252854 [label="I ja też się cieszę, że go poznałem. A co do jego siły? Może tak, a może nie. Koniec końców najzwyczajniej zrobił to, co trzeba było zrobić. I był wystarczająco silny, żeby tego dokonać.",shape=box,color=blue];
		j2027252854 -> j20797382;
	j873853199 [label="Możliwe. Ale koniec końców zrobił to, co trzeba. I był wystarczająco silny, żeby tego dokonać.",shape=box,color=blue];
		j873853199 -> j20797382;
	j20797382 [label="Sądzę, że w takich czasach \"wystarczająca siła\" to jedyne, o co możemy się modlić.",shape=box,color=blue];
		j20797382 -> j2393253669;
	j2393253669 [label="Czego niestety, ale nie można powiedzieć o tym winie... było bardzo mocne, ale powolne w swym działaniu.",shape=box,color=blue];
		j2393253669 -> j4130560401;
	j4130560401 [label="Powinienem już pójść, zanim... ",shape=box,color=blue];
		j4130560401 -> j3722592663;
	j3722592663 [label="Powinienem już pójść.",shape=box,color=blue];
		j3722592663 -> j111445917;
