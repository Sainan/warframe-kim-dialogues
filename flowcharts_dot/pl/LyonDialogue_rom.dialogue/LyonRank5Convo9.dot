digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank5Convo9 begins." [color=orange];
		"LyonRank5Convo9 begins." -> j3594191379;
	j3594191379 [label="Evaluate expressions",color=orange];
		j3594191379 -> "Chat ends." [label="LyonDating & LyonDatingConfession",color=purple];
		j3594191379 -> j539670002 [label="LyonDating",color=purple];
		j3594191379 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j539670002 [label="Mon miracle, muszę... się upewnić, że wszystko rozumiesz, zanim opowiem ci kolejną anegdotę. ",shape=box,color=blue];
		j539670002 -> j1052891984;
	j1052891984 [label="Ważne dla mnie jest, abyś uważnie przeczytał moje słowa. Rozumiesz?",shape=box,color=blue];
		j1052891984 -> j691247043;
		j1052891984 -> j1558563176;
	j691247043 [label="Zaczynasz mnie niepokoić, co się stało?",shape=box,color=red];
		j691247043 -> j3388832472;
	j1558563176 [label="Tak, oczywiście.",shape=box,color=red];
		j1558563176 -> j848165751;
	j3388832472 [label="Nic złego – wręcz przeciwnie. Dlatego kluczowe jest, żebyś to zrozumiał – chcę cię uchronić przed tragicznymi konsekwencjami, które mogą nadejść.",shape=box,color=blue];
		j3388832472 -> j1114820295;
		j3388832472 -> j1040297540;
		j3388832472 -> j88502549;
	j848165751 [label="+5 Chemistry",color=orange];
		j848165751 -> j2827881234;
	j1114820295 [label="Zamieniam się w słuch.",shape=box,color=red];
		j1114820295 -> j3364875433;
	j1040297540 [label="Twoje słowa nie mają większego sensu.",shape=box,color=red];
		j1040297540 -> j3712754447;
	j88502549 [label="Tragicznymi konsekwencjami... czego?",shape=box,color=red];
		j88502549 -> j4220633157;
	j2827881234 [label="Dziękuję. Zanim zaczniemy, pragnę cię zapewnić, że wszystko jest w porządku. Jednakże kluczowe jest, żebyś to zrozumiał – chcę cię uchronić przed tragicznymi konsekwencjami, które mogą nadejść.",shape=box,color=blue];
		j2827881234 -> j1114820295;
		j2827881234 -> j1040297540;
		j2827881234 -> j88502549;
	j3364875433 [label="+5 Chemistry",color=orange];
		j3364875433 -> j3096060249;
	j3712754447 [label="Tak. Boleśnie zdaję sobie z tego sprawę.",shape=box,color=blue];
		j3712754447 -> j4220633157;
	j4220633157 [label="Pozwól, że zacznę od nowa.",shape=box,color=blue];
		j4220633157 -> j3096060249;
	j3096060249 [label="Zdaję sobie sprawę, że można mnie źle zinterpretować i całkiem możliwe, że jestem... chory. A przynajmniej nie jestem całkowicie przy zdrowych zmysłach.",shape=box,color=blue];
		j3096060249 -> j1115394054;
	j1115394054 [label="Już dawno się z tym pogodziłem. Przestało mnie to martwić. Wizje, które mnie dręczą – te głosy – znalazłem sposób, by żyć z nimi w zgodzie, bez strachu i nienawiści.",shape=box,color=blue];
		j1115394054 -> j1436901244;
	j1436901244 [label="(Ostatnio, jak sądzę, trochę przez złośliwość, jeśli mam być szczery, ale nie ma to żadnego znaczenia.)",shape=box,color=blue];
		j1436901244 -> j1401358586;
	j1401358586 [label="Ale chcę, żebyś zrozumiał, że gdybyś chciał zakończyć to coś między nami – tę więź, pomiędzy mną, a drugą osobą, którą wcześniej uważałem za niemożliwą...",shape=box,color=blue];
		j1401358586 -> j34366665;
	j34366665 [label="Gdyby twoje serce kiedykolwiek pożeglowało w inną stronę...",shape=box,color=blue];
		j34366665 -> j3107380789;
	j3107380789 [label="Zniosę to, mon miracle.",shape=box,color=blue];
		j3107380789 -> j4106042021;
	j4106042021 [label="Nie pozwolę, by ta udręka mnie pochłonęła. ",shape=box,color=blue];
		j4106042021 -> j2851720794;
	j2851720794 [label="Check boolean LyonAllRight",color=orange];
		j2851720794 -> j4106863296 [label=true,color=green];
		j2851720794 -> j2004026321 [label=false,color=brown];
	j4106863296 [label="Używając twoich kolokwialnych słów, \"dam sobie radę\". Znów znajdę jakiś powód, by się cieszyć i śmiać.",shape=box,color=blue];
		j4106863296 -> j3345209608;
		j4106863296 -> j1199440129;
	j2004026321 [label="Przetrwam. Poradzę sobie. Znów znajdę jakiś powód, by się cieszyć i śmiać.",shape=box,color=blue];
		j2004026321 -> j3345209608;
		j2004026321 -> j1199440129;
	j3345209608 [label="Och, Leonie... nie jesteś dla mnie ciężarem.",shape=box,color=red];
		j3345209608 -> j2942003156;
	j1199440129 [label="Czy... właśnie mi mówisz, że chcesz zakończyć naszą relację?",shape=box,color=red];
		j1199440129 -> j1910336212;
	j2942003156 [label="Po prostu próbuję uwolnić cię od wszelkich niedogodności, które możesz odczuwać z mojego powodu...",shape=box,color=blue];
		j2942003156 -> j390050294;
		j2942003156 -> j3602209870;
		j2942003156 -> j4132121638;
	j1910336212 [label="Nie! Nic takiego! Po prostu próbuję uwolnić cię od wszelkich niedogodności, które możesz odczuwać z mojego powodu.",shape=box,color=blue];
		j1910336212 -> j390050294;
		j1910336212 -> j3602209870;
		j1910336212 -> j4132121638;
	j390050294 [label="Twój ból... traktuję, jakby był moim bólem. Pomoc w przezwyciężeniu go nigdy nie była dla mnie ciężarem.",shape=box,color=red];
		j390050294 -> j3945615922;
	j3602209870 [label="Nie potrafię opisać, co mnie w tobie pociąga. Ale nigdy nie będziesz dla mnie obowiązkiem ani ciężarem.",shape=box,color=red];
		j3602209870 -> j1775901752;
	j4132121638 [label="[Zerwij] To wszystko mnie przerasta, przepraszam. Lepiej będzie, jak zakończymy to w tym punkcie.",shape=box,color=red];
		j4132121638 -> j2868858463;
	j3945615922 [label="I właśnie dlatego nie jestem w stanie wyrazić tego, co czuje moje serce. Ale jestem ci dozgonnie wdzięczny, że nasze samotne, pogrążone w bólu dusze mogły się odnaleźć.",shape=box,color=blue];
		j3945615922 -> j2406491996;
	j1775901752 [label="Nie potrafię odpowiednio wyrazić swojej wdzięczności i nie sądzę, żeby jakieś słowa były w stanie to uczynić.",shape=box,color=blue];
		j1775901752 -> j2406491996;
	j2868858463 [label="Tak. Oczywiście. Byłoby... czystą hipokryzją przyjąć inną odpowiedź w tej chwili... ",shape=box,color=blue];
		j2868858463 -> j2091212593;
	j2406491996 [label="Skoro zdążyłem już włożyć tyle wysiłku, by przebrnąć przez ten jakże spektakularny wstęp do samouwielbienia...",shape=box,color=blue];
		j2406491996 -> j4098242577;
		j2406491996 -> j2138907362;
		j2406491996 -> j1328342644;
	j2091212593 [label="Doskonale cię rozumiem. Życzę ci wszystkiego dobrego. Będę pamiętał o tych wszystkich chwilach spędzonych razem z tobą.",shape=box,color=blue];
		j2091212593 -> j901739912;
	j4098242577 [label="Jak na kogoś, kto zaczynał w milczeniu, naprawdę się rozgadałeś.",shape=box,color=red];
		j4098242577 -> j745132946;
	j2138907362 [label="Nie przejmuj się. Uważam, że to było urocze.",shape=box,color=red];
		j2138907362 -> j2631886718;
	j1328342644 [label="Na litość, mogłeś po prostu powiedzieć \"Nic mi nie będzie, nawet jeśli nasze drogi się rozejdą\".",shape=box,color=red];
		j1328342644 -> j572174364;
	j901739912 [label="Będę je nosił w duszy, nawet jeśli znikną z mojego umysłu. Żegnaj.",shape=box,color=blue];
		j901739912 -> j2603405539;
	j745132946 [label="+5 Chemistry",color=orange];
		j745132946 -> j1860066948;
	j2631886718 [label="+5 Chemistry",color=orange];
		j2631886718 -> j1179007299;
	j572174364 [label="+5 Chemistry",color=orange];
		j572174364 -> j1315553668;
	j2603405539 [label="Boolean LyonDating is now false.",color=orange];
		j2603405539 -> j2874744099;
	j1860066948 [label="Ba! Jeśli nie chciałeś zostać wtajemniczony w to, co dzieje się w moich myślach, nie powinieneś był tu zaglądać. Sam jesteś sobie winny.",shape=box,color=blue];
		j1860066948 -> j1275483414;
	j1179007299 [label="Cieszę się, że podobają ci się moje dygresje. Właśnie dlatego wolę za dużo nie mówić. Wyobrażasz sobie znosić to twarzą w twarz? Maria już dawno pokazałaby mi, gdzie raki zimują.",shape=box,color=blue];
		j1179007299 -> j1275483414;
	j1315553668 [label="Jest w tobie pewna doza bezczelności i sarkazmu, do której z natury jestem przyzwyczajony, ale sam bym się do niej nie posunął. To twoja domena.",shape=box,color=blue];
		j1315553668 -> j1275483414;
	j2874744099 [label="Boolean IsDating is now false.",color=orange];
		j2874744099 -> j2517419488;
	j1275483414 [label="Niemniej jednak wszystko to miało służyć za pretekst do opowieści, która będzie teraz wydawała się stosunkowo krótka w porównaniu do całej reszty...",shape=box,color=blue];
		j1275483414 -> j2415998484;
	j2517419488 [label="Leon",shape=box,color=blue];
		j2517419488 -> "Chat ends.";
	j2415998484 [label="Zeszłej nocy obudziłem się z koszmaru. Otaczały mnie cienie. To żadna nowość, biorąc pod uwagę stan mojego umysłu. Majaczyły nad łóżkiem i nie chciały zniknąć.",shape=box,color=blue];
		j2415998484 -> j2466089516;
	j2466089516 [label="Nie bałem się ich, bo wiedziałem, że nie mogą mnie skrzywdzić. Ale nie chciały też zniknąć z mojej pamięci. Był tylko jeden sposób, by się ich pozbyć.",shape=box,color=blue];
		j2466089516 -> j4112005925;
	j4112005925 [label="Po wygramoleniu się z łóżka ubrałem się najlepiej, jak potrafiłem, chwiejąc się przez zaburzenia widzenia spowodowane nieustającym koszmarem. Chwyciłem kadzielnicę i padłem na kolana na środku pokoju, przygotowując się do... no cóż. ",shape=box,color=blue];
		j4112005925 -> j3887353698;
	j3887353698 [label="Przygotowując się do \"oczyszczenia umysłu\". I na tym poprzestańmy.",shape=box,color=blue];
		j3887353698 -> j123303792;
	j123303792 [label="Lecz gdy zamknąłem oczy, umysł zaczął błądzić. Myślami szukałem... ciebie, mon miracle...",shape=box,color=blue];
		j123303792 -> j816584771;
	j816584771 [label="Twojego głosu. Dotyku twojej dłoni na moim ramieniu... ",shape=box,color=blue];
		j816584771 -> j686589193;
	j686589193 [label="A wizje... ulotniły się. Opuściły swoje stanowisko, przepędzone przez silniejszą zjawę... przez ciebie.",shape=box,color=blue];
		j686589193 -> j270972789;
	j270972789 [label="Ja... wstałem. Odłożyłem kadzielnicę na stolik nocny i... zamiast tego postanowiłem przejść się po piaskach Sanctum...",shape=box,color=blue];
		j270972789 -> j1326890817;
		j270972789 -> j547635919;
	j1326890817 [label="Teraz rozumiem, dlaczego potrzebowałeś wstępu.",shape=box,color=red];
		j1326890817 -> j672811940;
	j547635919 [label="Nie wiem co powiedzieć...",shape=box,color=red];
		j547635919 -> j4108838206;
	j672811940 [label="Tak. No cóż. Idąc tam... natychmiast zdałem sobie sprawę z niebezpieczeństwa tamtej chwili. Że możesz to uznać za... obowiązek – i zacząć mnie postrzegać przez pryzmat ciążących ci łańcuchów.",shape=box,color=blue];
		j672811940 -> j2053723956;
	j4108838206 [label="+5 Chemistry",color=orange];
		j4108838206 -> j2379423599;
	j2053723956 [label="Błagam cię – modlę się do każdego boga, czy bogów na wysokościach, czy na dole – abyś nigdy tego nie uczynił. To dar, który mi dałeś i za każdym razem, gdy będzie nowy, będę go pielęgnował.",shape=box,color=blue];
		j2053723956 -> j2964464389;
	j2379423599 [label="Nic nie musisz mówić, mon miracle... ",shape=box,color=blue];
		j2379423599 -> j2031190296;
	j2964464389 [label="Przysięgnij mi, mon miracle, że gdy nadejdzie taki czas, że stanę się dla ciebie pustą klatką... uwolnisz się ode mnie.",shape=box,color=blue];
		j2964464389 -> j335784906;
	j2031190296 [label="Idąc tam... natychmiast zdałem sobie sprawę z niebezpieczeństwa tamtej chwili. Że możesz to uznać za... obowiązek – i zacząć mnie postrzegać przez pryzmat ciążących ci łańcuchów.",shape=box,color=blue];
		j2031190296 -> j2053723956;
	j335784906 [label="Nie zamierzam być pustym więzieniem dla tych, których kocham. Nie dla Marii.",shape=box,color=blue];
		j335784906 -> j3676338145;
		j335784906 -> j3886163771;
	j3676338145 [label="[Zerwij] Ja... nie mogę. Nie mogę tego obiecać, przepraszam.",shape=box,color=red];
		j3676338145 -> j1540451057;
	j3886163771 [label="Przysięgam.",shape=box,color=red];
		j3886163771 -> j3960862424;
	j1540451057 [label="+10 Chemistry",color=orange];
		j1540451057 -> j3006704855;
	j3960862424 [label="+10 Chemistry",color=orange];
		j3960862424 -> j4210585963;
	j3006704855 [label="Dziękuję. Dziękuję, mon miracle, za twoją szczerość. To wymagało odwagi i chwała ci za to.",shape=box,color=blue];
		j3006704855 -> j2273902975;
	j4210585963 [label="Dziękuję. Dziękuję, mon miracle...",shape=box,color=blue];
		j4210585963 -> j140393110;
	j2273902975 [label="Będę pielęgnować wspomnienia wszystkich chwil, które spędziliśmy razem. To znaczy więcej, niż możesz sobie wyobrazić.",shape=box,color=blue];
		j2273902975 -> j901739912;
	j140393110 [label="Nagle poczułem się tak bardzo zmęczony, jakby... ogromny ciężar spadł mi z ramion. Obawiam się, że muszę się położyć.",shape=box,color=blue];
		j140393110 -> j3933449302;
	j3933449302 [label="Leon",shape=box,color=blue];
		j3933449302 -> j3446510588;
	j3446510588 [label="Boolean LyonDatingConfession is now true.",color=orange];
		j3446510588 -> "Chat ends.";
}