	90 [label="Soldja1Shot1kil: daj mi dokończyć. powiedzmy, że facet jest głodny, ale w uszach ciągle gra nam do porzygania ta przesłodzona, reklama z korporacji dokładnie w tej części strefy gastronomicznej. co byś powiedział na to, jakbym postrzelał sobie do źródła tego jazgotu?",shape=box,color=blue];
		90 -> 91;
	91 [label="xX GLIMMER Xx: oo oo pozwól mi to zmiażdżyć. będę ostrożna, żeby nie uszkodzić Zeke'a! <RETRO_EMOJI_PUMPEDUP>",shape=box,color=blue];
		91 -> 92;
	92 [label="Belladonna ~{@: ¡Ay, no!
