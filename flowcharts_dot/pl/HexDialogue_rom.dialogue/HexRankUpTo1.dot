	j2721131401 [label="Broadsword: Utknęliśmy tutaj, rozumiecie to? Więc posprzątajcie po sobie — Strefa restauracyjna jest bardziej uwalona niż ulice. To nie jest cholerne zoo.",shape=box,color=blue];
