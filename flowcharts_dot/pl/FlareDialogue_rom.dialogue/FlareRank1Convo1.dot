	7 [label="Zależy, co mówili. Ale raczej tak.",shape=box,color=red];
		7 -> 12;
	8 [label="Nudzisz się, więc pukasz w szybę w zoo. Fajnie.",shape=box,color=red];
		8 -> 13;
