		17 -> 22;
	18 [label="Co mogę dla ciebie zrobić?",shape=box,color=red];
		18 -> 20;
	19 [label="och, na sol. nie. przepraszam, jeśli tak to wygląda. masz rację. protoframe'y to nie jedyne dziwadła w tym cyrku, nie?",shape=box,color=blue];
		19 -> 23;
		19 -> 24;
		19 -> 25;
	20 [label="ta zaraza. ta plaga. to coś krąży w moich żyłach. powiedz mi wszystko, co wiesz",shape=box,color=blue];
