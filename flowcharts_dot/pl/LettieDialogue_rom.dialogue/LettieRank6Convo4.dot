		j2527286945 -> j756455913;
	j1799415043 [label="Ay, sí, wiem\nI wiem, że ty też\nAle chciałabym\nŻeby ludzie zrozumieli, że ta część mnie\nNigdy nie pozwoli mi się z tym pogodzić",shape=box,color=blue];
		j1799415043 -> j2930020488;
	j756455913 [label="Síí...\nAle to bywa kuszące jajaja\nPozbyć się wszystkiego\nAle mówiłeś mi, co się wtedy dzieje\nWszystko staje się szare",shape=box,color=blue];
		j756455913 -> j3776790898;
	j2930020488 [label="Chciałabym być inna\nAle jestem kim jestem\nI dawno temu postanowiłam\nŻe nie będę za to przepraszać",shape=box,color=blue];
		j2930020488 -> "Chat ends.";
	j3776790898 [label="Nie życzyłabym tego nikomu\nOk może Albrechtowi\nPinche güey\nAle jego serce i tak jest już zimne",shape=box,color=blue];
		j3776790898 -> j527462787;
		j3776790898 -> j863644418;
	j527462787 [label="Jak mogę ci pomóc przez to przejść? Czy chcesz może w tym posiedzieć?",shape=box,color=red];
		j527462787 -> j188443375;
	j863644418 [label="Możemy mieć tylko nadzieję, że to dopiero początek jego planu.",shape=box,color=red];
		j863644418 -> j859815577;
