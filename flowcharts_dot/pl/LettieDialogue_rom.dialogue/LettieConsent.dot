		j3508297219 -> j3702107533;
	j1181491506 [label="Zawsze\nAle dla ciebie?\n¿Qué?",shape=box,color=blue];
		j1181491506 -> j2044326787;
	j3702107533 [label="Boolean LettieConsentComplete is now true.",color=orange];
		j3702107533 -> "Chat ends.";
	j2044326787 [label="Muszę cię o coś zapytać, chcę mieć pewność, że się na to zgadasz.",shape=box,color=red];
		j2044326787 -> j623360889;
	j623360889 [label="Zależy mi na tym, żebyś nie czuła się, jakbym cię okłamywał.",shape=box,color=red];
		j623360889 -> j1536364655;
		j623360889 -> j1953149905;
		j623360889 -> j956755873;
	j1536364655 [label="Proszę, nie zrób mi krzywdy.",shape=box,color=red];
		j1536364655 -> j1346396927;
	j1953149905 [label="Proszę, nie denerwuj się.",shape=box,color=red];
		j1953149905 -> j3643942481;
	j956755873 [label="Mam nadzieję, że rozumiesz.",shape=box,color=red];
		j956755873 -> j4159159809;
	j1346396927 [label="Jajajajaj\nJuż o tym rozmawialiśmy\nKrzywdzę cię tylko tak, jak lubisz\nA teraz o co chodzi",shape=box,color=blue];
		j1346396927 -> j1589097026;
	j3643942481 [label="¿Sí?\nCzym mam się nie denerwować?",shape=box,color=blue];
		j3643942481 -> j1589097026;
	j4159159809 [label="¿Sí?\nCo mam zrozumieć?",shape=box,color=blue];
		j4159159809 -> j1589097026;
	j1589097026 [label="Nie chcę stawiać cię w sytuacji, w której czujesz się źle. To nie jest coś, o czym rozmawialiśmy wcześniej. Zrozumiem, jeśli się nie zgodzisz.",shape=box,color=red];
		j1589097026 -> j1794184481;
	j1794184481 [label="To co stworzyliśmy jest dla mnie bardzo ważne, nie chcę, żebyś w to zwątpiła.",shape=box,color=red];
		j1794184481 -> j2052438912;
	j2052438912 [label="Aah, entiendo...\nWiesz, że zazwyczaj nie lubię być taka.\nChyba chcę tylko wiedzieć\nCzy naprawdę ci zależy na tej osobie, solecito?\n¿Quiénes son?\nCzy naprawdę ci na niej zależy?",shape=box,color=blue];
		j2052438912 -> j2444860460;
		j2052438912 -> j2565410424;
	j2444860460 [label="Tak. Ale też bardzo zależy mi na tobie.",shape=box,color=red];
		j2444860460 -> j4092188454;
	j2565410424 [label="Nie powinno mnie dziwić, że tak szybko mnie rozpracowałaś.",shape=box,color=red];
		j2565410424 -> j2040051204;
	j4092188454 [label="Ay, sí\nCiężko cię winić, kiedy tak wiele widziałeś\nTak wiele podróżujesz\nTylko nie proś mnie, żebym się przyłączyła.\nMi to nie przeszkadza",shape=box,color=blue];
		j4092188454 -> j2451634760;
	j2040051204 [label="Oszukiwałam\nEleanor mnie ostrzegła\nJajaja okropna z niej plotkara",shape=box,color=blue];
		j2040051204 -> j3933997208;
	j2451634760 [label="Byle nikt z hex\n¿No mi familia, por favor?\nPrzez tydzień szorowałabym się w alkoholu",shape=box,color=blue];
		j2451634760 -> j1888291503;
	j3933997208 [label="Ciężko cię winić, kiedy tak wiele widziałeś\nTak wiele podróżujesz\nTylko nie proś mnie, żebym się przyłączyła.\nMi to nie przeszkadza",shape=box,color=blue];
		j3933997208 -> j2451634760;
	j1888291503 [label="+20 Chemistry",color=orange];
		j1888291503 -> j3481753229;
	j3481753229 [label="Też jesteś dla mnie bardzo ważny, solecito\nAle jeśli jesteś szczęśliwy?\nTo ja też jestem szczęśliwa\nTak po prostu",shape=box,color=blue];
		j3481753229 -> j1014891637;
	j1014891637 [label="Och\nI jeśli wymyślisz kiedyś, jak zorganizować spotkanie\nTo mnie przedstawisz",shape=box,color=blue];
		j1014891637 -> j242506882;
		j1014891637 -> j3085559356;
	j242506882 [label="Tak, proszę pani. :)",shape=box,color=red];
		j242506882 -> j3702107533;
	j3085559356 [label="Zobaczę, co da się zrobić.",shape=box,color=red];
		j3085559356 -> j3702107533;
}