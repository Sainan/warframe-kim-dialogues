		2797 -> 2798;
	2798 [label="Nie chcę stawiać cię w sytuacji, w której czujesz się źle. To nie jest coś, o czym rozmawialiśmy wcześniej. Zrozumiem, jeśli się nie zgodzisz.",shape=box,color=red];
		2798 -> 2799;
