		j644366305 -> j2832672837;
	j3313601206 [label="Jak osoba\nJakby próbowała wymyślić jak mnie ZJEŚĆ\nZa tymi oczami kryje się za duża inteligencja\nCzy w przyszłości macie mądre zwierzęta?",shape=box,color=blue];
