	j3133275612 [label="Chyba nie mogę być tego pewien.",shape=box,color=red];
		j3133275612 -> j2767780656;
	j3839203353 [label="SZCZURY LABORATORYJNE?!\nNiech zgadnę\nTo Entrati je torturował",shape=box,color=blue];
		j3839203353 -> j947943285;
	j207138380 [label="¿Ay, sí?\nCo to ma wspólnego z entratim?",shape=box,color=blue];
		j207138380 -> j2661725915;
	j2115650893 [label="I co z tego?\nJest na tyle mądra, żeby udawać głupią\nSzpieguje nas dla niego, jestem tego pewna\nNie możemy jej ufać",shape=box,color=blue];
		j2115650893 -> j3233303447;
		j2115650893 -> j90034938;
	j2767780656 [label="Sí\nMoże być szpiegiem\nPracuje dla Entratiego\nNie możemy jej ufać",shape=box,color=blue];
