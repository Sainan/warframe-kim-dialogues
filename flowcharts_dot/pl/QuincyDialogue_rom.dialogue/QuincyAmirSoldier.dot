		1853 -> 1852;
	1849 [label="najpierw myślał, że chcę zdzielić go przez łeb lmao. ale zabrałem go na dach, siedliśmy i pogadaliśmy",shape=box,color=blue];
		1849 -> 1854;
	1851 [label="cholera zamknij się i daj mi mówić, dobra?",shape=box,color=blue];
		1851 -> 1849;
	1852 [label="Chat ends.",color=orange];
	1854 [label="powiedziałem mu o tym, jak dołączyłem do woja i zostałem snajperem",shape=box,color=blue];
		1854 -> 1856;
		1854 -> 1855;
	1856 [label="Jak w ogóle *zostałeś* snajperem?",shape=box,color=red];
		1856 -> 1857;
	1855 [label="I?",shape=box,color=red];
		1855 -> 1858;
	1857 [label="to nie jest teraz ważne",shape=box,color=blue];
		1857 -> 1858;
	1858 [label="powiedziałem mu o tym, jak pierwszy raz kogoś zabiłem",shape=box,color=blue];
		1858 -> 1859;
	1859 [label="kiedy po raz pierwszy spojrzałem przez lunetę i odebrałem komuś życie",shape=box,color=blue];
		1859 -> 1860;
	1860 [label="to jedna sprawa w ferworze walki... kiedy jakiś gość biegnie na ciebie ze spluwą, nożem czy czymś...",shape=box,color=blue];
		1860 -> 1861;
	1861 [label="to coś zupełnie innego, kiedy siedzisz sobie na dachu 300 metrów dalej i nawet o tobie nie wie...",shape=box,color=blue];
		1861 -> 1864;
	1864 [label="kiedy masz czas *pomyśleć* o nim, o celu. kim jest. dlaczego tam jest. czy mają rodzinę? dzieci?",shape=box,color=blue];
		1864 -> 1862;
	1862 [label="a potem... pociągasz za spust i BUM",shape=box,color=blue];
		1862 -> 1863;
	1863 [label="teraz nie ma znaczenia",shape=box,color=blue];
		1863 -> 1865;
	1865 [label="nie żyją i to ja odebrałem to życie",shape=box,color=blue];
		1865 -> 1866;
	1866 [label="i jego twarz nadal żyje w mojej głowie",shape=box,color=blue];
		1866 -> 1867;
	1867 [label="i tak każdy następny po nim",shape=box,color=blue];
		1867 -> 1868;
		1867 -> 1869;
	1868 [label="Jak zareagował...?",shape=box,color=red];
		1868 -> 1871;
	1869 [label="Brzmi... budująco.",shape=box,color=red];
		1869 -> 1871;
	1871 [label="przez długi czas nic nie powiedział. po prostu siedzieliśmy w ciszy",shape=box,color=blue];
		1871 -> 1877;
	1877 [label="potem... powiedział mi o swoich koszmarach",shape=box,color=blue];
		1877 -> 1874;
	1874 [label="o tym jak nie czuje się członkiem zespołu, bo nie jest żołnierzem",shape=box,color=blue];
		1874 -> 1872;
	1872 [label="powiedziałem mu, jak przerażające było zabić pierwszego człowieka jako żołnierz",shape=box,color=blue];
		1872 -> 1873;
	1873 [label="i o tym, jak nękały mnie po tym koszmary, gorsze niż te za dzieciaka",shape=box,color=blue];
		1873 -> 1875;
	1875 [label="ale przeprosiłem go za, to że traktowałem go jak worek treningowy przez ten cały czas",shape=box,color=blue];
		1875 -> 1876;
	1876 [label="i że jest częścią zespołu jak wszyscy inni. i że po prostu jestem jaki jestem, tak jak on jest jaki jest, bo jesteśmy kim jesteśmy, no nie?",shape=box,color=blue];
		1876 -> 1870;
	1870 [label=".... a wiesz co potem powiedział...?",shape=box,color=blue];
		1870 -> 1878;
		1870 -> 1879;
	1878 [label="Co?",shape=box,color=red];
		1878 -> 1882;
	1879 [label="Nie?",shape=box,color=red];
		1879 -> 1882;
	1882 [label="\"masz rację, jesteś dupkiem\"",shape=box,color=blue];
		1882 -> 1884;
	1884 [label="ale kiedy miałem już go zrzucić z dachu...",shape=box,color=blue];
		1884 -> 1883;
	1883 [label="przytulił się do mnie. wariat mnie krwa przytulił i powiedział, \"ale jesteś też moim starszym bratem\"",shape=box,color=blue];
		1883 -> 1881;
	1881 [label="ja pierdole",shape=box,color=blue];
		1881 -> 1880;
	1880 [label="ale... nie. warto było. myślę, że wiele to dla niego znaczyło. i... znaczyło też coś dla mnie, chyba",shape=box,color=blue];
