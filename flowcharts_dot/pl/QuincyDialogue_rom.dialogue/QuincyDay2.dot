		3021 -> 3020;
	3026 [label="powiedziałem ci, dlaczego wstąpiłem do wojska. jak chciałem mieć lepsze życie dla siebie i mojej rodziny",shape=box,color=blue];
		3026 -> 3119;
	3027 [label="nigdy ci nie powiedziałem, dlaczego wstąpiłem do wojska. w skrócie. to proste. chciałem zapewnić sobie i swojej rodzinie lepsze życie.",shape=box,color=blue];
