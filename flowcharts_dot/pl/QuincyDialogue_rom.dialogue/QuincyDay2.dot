		3028 -> 3029;
	3019 [label="Update boolean IsDating",color=orange];
		3019 -> 3018;
	3038 [label="nie trzeba być geniuszem, żeby to ułożyć układankę w całość i stwierdzić, że to Jaśniepanek jest powodem, dla którego w moim życiu wszystko poszło się walić. i dlatego ślubowałem, że nigdy więcej nie pozwolę, żeby ktoś się tak do mnie zbliżył",shape=box,color=blue];
		3038 -> 3035;
	3029 [label="jaki jest najłatwiejszy sposób, aby ktoś taki jak ja mógł się wydostać? armia. rozdawali stypendia, aby żołnierzy zapłacić za pójście na studia",shape=box,color=blue];
		3029 -> 3032;
	3018 [label="Chat ends.",color=orange];
	3035 [label="więc",shape=box,color=blue];
		3035 -> 3036;
	3032 [label="więc sobie myślałem, będę dla nich zabijać kilka lat, a potem dostanę bilecik do szkoły biznesu. Skoupię się na finansach, albo może MBA albo coś",shape=box,color=blue];
		3032 -> 3030;
	3036 [label="tylko przez przypadek, losowy rzut kostką, trafiłem do tego samego pułku co jaśniepanek. 3. batalion, karmazynowa straż",shape=box,color=blue];
		3036 -> 3034;
	3030 [label="wróć do domu i ustaw swoją rodzinę, zrób różnicę w sposób, który ma znaczenie",shape=box,color=blue];
		3030 -> 3031;
	3034 [label="on już jest dowódcą, tak? a ja dołączam świeżo po akademii",shape=box,color=blue];
		3034 -> 3039;
	3031 [label="ale wszystko poszło w diabły, zanim miałem szansę",shape=box,color=blue];
		3031 -> 3033;
	3039 [label="i przez jakiś czas starałem się grać według zasad, być dobrym żołnierzem. ale im więcej czasu mijało, tym bardziej zdawałem sobie sprawę, że karty wciąż są ustawione przeciwko mnie",shape=box,color=blue];
		3039 -> 3037;
	3033 [label="Update boolean QuincyArthur3",color=orange];
		3033 -> 3038;
	3037 [label="życie nie jest fair. nieważne gdzie jesteś. nepotyzm. faworytyzm. bigoteria. wszędzie. ludzie patrzący na mnie z góry z powodu miejsca, z którego pochodzę",shape=box,color=blue];
		3037 -> 3044;
	3044 [label="z powodu tego kim jestem",shape=box,color=blue];
		3044 -> 3041;
	3041 [label="więc ja... zacząłem robić głupoty. zacząłem robić rzeczy, których teraz żałuję. zacząłem się głupio odreagowywać. jeśli chcieli mi coś zabrać? ja też bym im zabrał",shape=box,color=blue];
		3041 -> 3042;
	3042 [label="bo jeśli oni nie pilnowali moich pleców, to dlaczego ja miałbym pilnować ich? więc dbałem tylko o siebie i TYLKO o siebie, rozumiesz?",shape=box,color=blue];
		3042 -> 3040;
	3040 [label="nie kradłem niczego. nie łamałem reguł. byłem dobrym żołnierzem. ale jeśli kiedykolwiek słyszałeś zwrot \"złośliwe podporządkowanie się\" to wiesz, o co mi chodzi",shape=box,color=blue];
		3040 -> 3045;
	3045 [label="nie było ani jednej sekundy mojego życia, którą spędziłbym na wychodzeniu poza swoje obowiązki dla nikogo, nigdy. chciałem odsiedzieć swój wyrok i wyjść z moimi czekami",shape=box,color=blue];
		3045 -> 3049;
	3049 [label="potem wszystko poszło nie tak. jesteśmy na misji. ja na czatach. z mojego punktu widzenia widzę, że opz– opozycja – nagle zaczynają się na nas zbierać. wiedzą, że tam jesteśmy",shape=box,color=blue];
		3049 -> 3046;
	3046 [label="artur i reszta wojsk są na polu, mamy ułamek sekundy, aby podjąć decyzję. mogę zdradzić swoją pozycję i otworzyć ogień do zbliżających się opzów, aby ostrzec jaśniepanka i ferajnę i dać im czas na dostanie się na bezpieczniejszą pozycję",shape=box,color=blue];
		3046 -> 3047;
	3047 [label="ale robiąc to, wpakuję się w niezłe gówno. gwarancja, że ci opz szybko zaczną polować na mój durny zad. więc...",shape=box,color=blue];
		3047 -> 3051;
	3051 [label="spakowałem swoje graty i powiedziałem, że jesteśmy załatwieni... uznałem, że jaśniepanek i pozostali są już spaleni...",shape=box,color=blue];
		3051 -> 3050;
	3050 [label="wychodzę z pokoju, w którym się ukrywałem i skręcam za róg, centralnie natykając się na lufę karabinu opza",shape=box,color=blue];
		3050 -> 3048;
	3048 [label="nie, brachu. wiedzieli, że tam byłem przez cały czas. od początku znali moją pozycję.",shape=box,color=blue];
		3048 -> 3054;
	3054 [label="wywleki mój tyłek na ulicę. obalili mnie na kolana i przyłożyli pistolet z tyłu głowy",shape=box,color=blue];
