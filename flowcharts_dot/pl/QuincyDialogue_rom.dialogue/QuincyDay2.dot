		3059 -> 3066;
	3066 [label="MUSZĘ WYBRAĆ. Czy mam krwa nałgać tym z wyższą rangą? czy mam go rzucić go pod nadjeżdzające auto, co już wcześniej zrobiłem? czy mam zrobić to, co SŁUSZNE",shape=box,color=blue];
		3066 -> 3057;
