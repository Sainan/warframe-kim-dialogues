		2266 -> 2269 [label=false,color=brown];
	2339 [label="そっか。うーん…　そこまで詳しく知ってるわけじゃないんだ。あの子の方がLotusのことをもっと知ってる。でもLotusは自分の命の恩人なんだ。",shape=box,color=red];
		2339 -> 2341;
