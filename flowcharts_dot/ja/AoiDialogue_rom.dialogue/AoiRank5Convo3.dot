	3409 [label="Amirはマネージャーのメールをハッキングして、スカルドラとの契約を暴いたの。奴らはバンドをクローン化して、危険にさらしてたんだけど、マネージメントによって隠蔽されてたんだ～",shape=box,color=blue];
		3409 -> 3410;
	3408 [label="スーパーファンがスーパーハッカーと力を合わせるとどうなると思う？　もう誰も止められない～",shape=box,color=blue];
