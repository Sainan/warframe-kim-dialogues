	2942 [label="魔法？　そうは思わないな。でもいい歌は好きだよ。",shape=box,color=red];
		2942 -> 2946;
	2943 [label="音楽って、自分が経験してきたことの一部だ。歌を通して思い出が生まれる、わかるよ。",shape=box,color=red];
		2943 -> 2944;
	2945 [label="お願い。あなたのお気に入りの曲を教えて。",shape=box,color=blue];
