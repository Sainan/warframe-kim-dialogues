	2925 [label="Voidタングを考えずにピアノを弾く方法。どんな音楽でも演奏できる方法",shape=box,color=blue];
		2925 -> 2926;
	2929 [label="簡単に答えられるものじゃない。音、言葉、Voidから発せられる声。呪い、って言うよりは、それに近いものかな。耳に聞こえるものすべてへの、何かの伝達。",shape=box,color=red];
