		2945 -> 2975;
		2945 -> 2976;
	2965 [label="音楽って突破口を開いて、希望の光になれると思わない？　いや、動物たちだけじゃなくて、皆に。Voidタングが「魔法」なら、音楽も魔法だよ。",shape=box,color=blue];
		2965 -> 2967;
