		2962 -> 2963;
	2937 [label="でも想像して。この世界のために人々を泣かせたり、踊らせたり、歌わせたりできる何かを創り出すって、魔法そのものデショ？",shape=box,color=blue];
		2937 -> 2942;
		2937 -> 2943;
	2941 [label="でもちょっと待って。未来には音楽があるって言ってたよね。そしたら希望はまだあるね…",shape=box,color=blue];
		2941 -> 2945;
	2958 [label="的外れだったらごめん。その動物たちに音楽を聴かせたことある？　友だちに。ほんの少しでも効果があるかもよ？",shape=box,color=blue];
		2958 -> 2965;
	2963 [label="怖いんだ。決して聴きたくない歌。消え去るべき魔法の呪いのようだ。",shape=box,color=red];
