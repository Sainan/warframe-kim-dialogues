	2931 [label="おそらく、すべてを引き起こしているものの言語だ。それがどのように語るかで物事が左右される。",shape=box,color=red];
		2931 -> 2953;
	2928 [label="ピアノのレッスンを始めるには、この方法の方がいいよ。だって…　ピアノが見つからないから。セオリーから始めよ。",shape=box,color=blue];
		2928 -> 2934;
