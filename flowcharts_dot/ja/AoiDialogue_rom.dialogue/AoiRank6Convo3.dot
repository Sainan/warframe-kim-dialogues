	3939 [label="次に",shape=box,color=blue];
		3939 -> 3941;
	3940 [label="それで彼が意識を取り戻すと、研究室に戻っていた。でも自分の研究室ではなかった。そして自分の姿と見つめ合う羽目になった。自分自身ではないものと。そして「彼」は、母親しか知らないはずの名前で彼を呼んだ。",shape=box,color=red];
