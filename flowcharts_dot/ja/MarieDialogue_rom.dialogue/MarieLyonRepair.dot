	3879 [label="Oui…　いいでしょう。今の漂流者様への怒りは、他の人に向けるべきではありませんから。",shape=box,color=blue];
		3879 -> 3882;
	3880 [label="Oui. その点では、ごもっともです。今の漂流者様への怒りは、他の人に向けるべきではありませんから。",shape=box,color=blue];
