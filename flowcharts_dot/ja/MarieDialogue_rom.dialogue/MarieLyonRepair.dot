	j1069174942 [label="Marie、本当に助けてほしい。 ",shape=box,color=red];
		j1069174942 -> j1234437232;
	j3221062607 [label="Marie、君が必要なんだ。君がいないと何もできない。お願い。許してくれないか？",shape=box,color=red];
		j3221062607 -> j3264804973;
	j1088171655 [label="Marieの気を損ねたことを謝るよ。でも、Loidに八つ当たりしないで。階上の家族にも。",shape=box,color=red];
		j1088171655 -> j1084243125;
	j1234437232 [label="私はただ、Lyonの優しさを使わないよう注意しに来たのです。ご自分の失敗を埋め合わせるために、彼を利用しないでください。",shape=box,color=blue];
		j1234437232 -> "Chat ends.";
	j3264804973 [label="Oui…　いいでしょう。今の漂流者様への怒りは、他の人に向けるべきではありませんから。",shape=box,color=blue];
		j3264804973 -> j275828560;
	j1084243125 [label="Oui. その点では、ごもっともです。今の漂流者様への怒りは、他の人に向けるべきではありませんから。",shape=box,color=blue];
		j1084243125 -> j1493616662;
