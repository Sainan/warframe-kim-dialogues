		j738393015 -> "Chat ends.";
	j2373805708 [label="Bird Trois様に誕生日を尋ねたのですが、ご存知ないんですって！　なんて悲しいことでしょう！",shape=box,color=blue];
		j2373805708 -> j3409195114;
	"Chat ends." [color=orange];
	j3409195114 [label="カビアの誰も自分の誕生日を知らないのです。私たちのように話すこともcalendrierを知ることもできないのだから、当然のことかも知れないけれど。",shape=box,color=blue];
		j3409195114 -> j3711207426;
	j3711207426 [label="それで思ったのです。なんという悲劇！すぐに解決させなければ、と。non？",shape=box,color=blue];
		j3711207426 -> j2993662086;
		j3711207426 -> j4255023408;
		j3711207426 -> j3623156901;
	j2993662086 [label="考えたことなかった。",shape=box,color=red];
		j2993662086 -> j1704484038;
	j4255023408 [label="どうやって調べる？",shape=box,color=red];
		j4255023408 -> j4273165028;
	j3623156901 [label="自分たちに誕生日を選ばせる？",shape=box,color=red];
		j3623156901 -> j4136668288;
	j1704484038 [label="Oui！　Loid様もそうでした。私が知ったときのLoid様の顔には純粋な悲しみが浮かんでいました…",shape=box,color=blue];
		j1704484038 -> j2265290725;
	j4273165028 [label="最初は、カーディナルの記録を調べようと思ったのです。誕生日を書き残しているんじゃないかって、oui？",shape=box,color=blue];
		j4273165028 -> j2402114516;
	j4136668288 [label="「選ばせる？」まるで私に主導権があるかのように仰るのですね！ ",shape=box,color=blue];
		j4136668288 -> j4273165028;
	j2265290725 [label="Loid様が、ご自分を責めておられるのが辛いのです。Loid様のせいではないのですから。Loid様は本当に多くの人のために尽くしてくださっているのに…",shape=box,color=blue];
		j2265290725 -> j385611056;
	j2402114516 [label="Evaluate expressions",color=orange];
		j2402114516 -> j527848569 [label="MarieEntratiComplete",color=purple];
		j2402114516 -> j527848569 [label="MarieEntrati3a",color=purple];
		j2402114516 -> j2774815901 [label="false",color=purple];
	j385611056 [label="Loid様の優しさを知ることができ、私たちは皆幸せです。彼の懐の深さは計り知れません。",shape=box,color=blue];
		j385611056 -> j239762421;
		j385611056 -> j281710581;
	j527848569 [label="でも...　Tagfer様や他の方たちとの会話を思い出し、あまり賢明ではないと考え直しました。",shape=box,color=blue];
		j527848569 -> j1143495693;
	j2774815901 [label="でも、過去の記録を探すことにはご興味がないようです。自分の起源を考えることがどれほど辛いことか、私もよく分かります。",shape=box,color=blue];
		j2774815901 -> j1143495693;
	j239762421 [label="Loidがいてくれて本当に幸運だ。",shape=box,color=red];
		j239762421 -> j3728747250;
	j281710581 [label="時々はLoidが元気になるといいな。",shape=box,color=red];
		j281710581 -> j2360677321;
	j1143495693 [label="結局のところ、私も自分の誕生日を知らないのです。 ",shape=box,color=blue];
		j1143495693 -> j3137541775;
		j1143495693 -> j775901422;
		j1143495693 -> j3742292931;
	j3728747250 [label="Oui、そうですね。私たちは皆、Loid様に感謝しています。",shape=box,color=blue];
		j3728747250 -> j3542593548;
	j2360677321 [label="Loid様は真面目なお方ですが、笑っておられるのを見たことがあります。思いがけない時に、ユーモアが溢れるのです。ただ、辛抱強く待つしかありません。",shape=box,color=blue];
		j2360677321 -> j3542593548;
	j3137541775 [label="気休めになるかわからないけど、自分もなんだ。誕生日を覚えていない。",shape=box,color=red];
		j3137541775 -> j32326978;
	j775901422 [label="誕生日なんて大したことじゃないよ。",shape=box,color=red];
		j775901422 -> j2199873695;
	j3742292931 [label="自分で自分の誕生日を選べる方が楽しいし、印象的かも。 ",shape=box,color=red];
		j3742292931 -> j989224962;
	j3542593548 [label="Check boolean MarieDating",color=orange];
		j3542593548 -> j423113241 [label=true,color=green];
		j3542593548 -> j3784315075 [label=false,color=brown];
	j32326978 [label="漂流者様とminuscule copie - オペレーター様のために泣く理由がまた一つ増えました。そして、私たちの共通点もまた一つ増えましたね！",shape=box,color=blue];
		j32326978 -> j3542593548;
	j2199873695 [label="誕生日が大したことないなんて、ありえません！　亡くなった人たちを称えるのと同じように、今共にいる人たちも称えられるべきなのです。",shape=box,color=blue];
		j2199873695 -> j3542593548;
	j989224962 [label="印象的？　漂流者様がガリア語を話せるとは知りませんでした！　私から学んだのですか？",shape=box,color=blue];
		j989224962 -> j1157605739;
		j989224962 -> j2378811431;
	j423113241 [label="+20 Chemistry",color=orange];
		j423113241 -> j2885733045;
	j3784315075 [label="+20 Chemistry",color=orange];
		j3784315075 -> j3290104891;
	j1157605739 [label="いや...　どちらの言語でも同じように言うんだと思うよ...",shape=box,color=red];
		j1157605739 -> j1675510385;
	j2378811431 [label="Marieから学んだんだろうな。",shape=box,color=red];
		j2378811431 -> j752950942;
	j2885733045 [label="さあ！　一緒に行きましょう、mon cœur！　たとえ何も起こらなくても、いつだって気持ちが大切です！　暦を確認しましょう。Au calendrier！",shape=box,color=blue];
		j2885733045 -> "Chat ends.";
	j3290104891 [label="さあ！　一緒に行きましょう！　たとえ何も起こらなくても、気持ちが大切です！　暦を確認しましょう。Au calendrier！",shape=box,color=blue];
		j3290104891 -> "Chat ends.";
	j1675510385 [label="ふぅ！　他言語はいつだってガリア語の良いところを盗むのです！　時代は永遠に変わらないのですね！",shape=box,color=blue];
		j1675510385 -> j3542593548;
	j752950942 [label="漂流者様は本当に聡明ですね！　ガリア語は史上最も美しい言語の一つです。この未来に伝承されているのは嬉しいです。",shape=box,color=blue];
