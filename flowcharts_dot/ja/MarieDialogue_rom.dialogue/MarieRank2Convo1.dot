	384 [label="Ô joie！　学ぶことは大好きです。ルミナリーズもかつては別の顔、別の名前があったか考えることがあります。",shape=box,color=blue];
		384 -> 398;
	385 [label="確かに、この布をまといながら、他人に厳しい期待を抱かないのは意外かもしれませんね。慰めを求めない人々に説教を与えても、多くの場合それは愛を生まない行為だと考えています。",shape=box,color=blue];
		385 -> 399;
	382 [label="ただ、私たちの信仰があなたに平安をもたらしているか気になっただけです。",shape=box,color=blue];
		382 -> 394;
		382 -> 395;
		382 -> 396;
	383 [label="それは稀有な才能…　あなたがそれを行使してくれることを願っています。岐路に長く留まりすぎると、争いに飲み込まれてしまうのではないかと心配です。",shape=box,color=blue];
		383 -> 397;
	376 [label="では、より寛容な人生を歩んでいるのでしょう。神々や教会の規則に縛られない人生。正直、少し羨ましいです。",shape=box,color=blue];
		376 -> 389;
	377 [label="あなたが羨ましく感じますわ！　神々を知る必要もなく、幾世紀も生きていたなんて。",shape=box,color=blue];
		377 -> 389;
	378 [label="まるでルアの使徒ですね、もちろん悪気はありません。Oui、いつか老婆が迎えに来て、銀の涙を流すのです。でも、あなたの言葉には気になる点があります…",shape=box,color=blue];
		378 -> 390;
	379 [label="Oui、でも気になります。あなたも、子供も、悪魔、Loid様、カーディナルでさえも…　あなた方全員の背後には、幾世紀もの歴史が流れています。",shape=box,color=blue];
		379 -> 391;
	380 [label="どんな引き合い？",shape=box,color=red];
		380 -> 392;
