	396 [label="もたらす。",shape=box,color=red];
		396 -> 402;
	398 [label="彼らは他の宗派の信者を喜ばせるために姿を変えることで知られていますから。しかし、それは私の信仰であって、あなたの信仰ではありません。慰めを求めない人々に説教は与えません。多くの場合それは愛を生まない行為ですから。",shape=box,color=blue];
		398 -> 399;
	399 [label="そう、私の信仰は私のもの、あなたの信仰はあなたのものです。私はただ、あなたの信仰があなたに平安をもたらすことを願っています。",shape=box,color=blue];
		399 -> 394;
		399 -> 395;
		399 -> 396;
	397 [label="最終的には、誰もが歩むべき道を選ばなければなりません。しかし、岐路は皆が出発すべき場所であり、均衡こそがあらゆる構造の基盤なのです。",shape=box,color=blue];
		397 -> 403;
	389 [label="それでも…　信仰を持たないことで、あなたに平安をもたらしていますか？",shape=box,color=blue];
		389 -> 394;
		389 -> 395;
		389 -> 396;
	390 [label="「そうあるべき」とは誰を指して言っているのですか？　あなたも、子供も、悪魔、Loid様、カーディナルでさえも…　あなた方全員の背後には、幾世紀もの歴史が流れています。",shape=box,color=blue];
		390 -> 391;
	391 [label="ルアが私たちを迎えに来るまで、一体何世紀も先があるのでしょう。そして、その日が来たら、どれほど熱烈に彼女を受け入れるのでしょうか。でもそれは私の信仰であって、あなたの信仰ではありませんね。",shape=box,color=blue];
		391 -> 389;
	392 [label="まだ確信していません。悪魔らしく、策を公にしないので。でも彼は神々を信じていません。おそらく、彼自身を除いては。",shape=box,color=blue];
		392 -> 389;
	393 [label="Non、まったくもって。あなたと同じく、神々を信じていません。おそらく、彼自身を除いては。",shape=box,color=blue];
		393 -> 389;
	387 [label="Non、多様な心を持つ人は喜んで迎え入れます。",shape=box,color=blue];
		387 -> 388;
	388 [label="ただ、その考えがあなたに平安をもたらしているか気になっただけです。",shape=box,color=blue];
