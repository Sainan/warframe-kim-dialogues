	3904 [label="でも、漂流者様は私の気をそらそうとしているのですね！　反対はしませんが、早すぎるのでは？　n'est pas？",shape=box,color=blue];
		3904 -> 3905;
	318 [label="+5 Chemistry",color=orange];
		318 -> 326;
	317 [label="信仰はどのような名前で呼ばれても、私はそこに美しさを見出します。教えてください、それは新しいものですか？　古いものですか？　私はそれを認知していますか？",shape=box,color=blue];
		317 -> 324;
		317 -> 325;
	316 [label="まあそうなのですね！　Oh, comme c'est fascinant！　こんな遠い未来にも信者がいるなんて、cela remplit mon cœur de joie。喜びで胸がいっぱいです。でも、もしかしたら過去の世界での経験が関係しているのかもしれませんね？　どっちみちにせよ嬉しいです。",shape=box,color=blue];
		316 -> 323;
	315 [label="あなたの意見を尊重します。しかしお聞きしたいのですが、どうしてそんなに確信を持てるのですか？　それ自体が一種の信仰ではないでしょうか？　そしてこの…　無関心のモノ、は、神ではないのですか？",shape=box,color=blue];
		315 -> 320;
		315 -> 321;
		315 -> 322;
	314 [label="+10 Chemistry",color=orange];
		314 -> 319;
	3905 [label="もしよろしければ、私の質問にお答えいただきたいのですが、s'il vous plait。ですが、漂流者様には赤面させられます！",shape=box,color=blue];
		3905 -> 308;
		3905 -> 307;
		3905 -> 306;
		3905 -> 305;
		3905 -> 304;
	326 [label="ああ、なるほど。名前の如く放浪しているのですね。あなたは多くの文化、信仰、世界を見てきました。Cela est très spirituel, non？　海辺の貝殻のように寄せ集めてきました。",shape=box,color=blue];
		326 -> 336;
		326 -> 337;
	324 [label="知らないんじゃないかな。",shape=box,color=red];
		324 -> 334;
	325 [label="一部はわかるかも。でもその他は馴染みがないかもしれない。",shape=box,color=red];
		325 -> 335;
	323 [label="ちなみに、ソルとルア、どちらに傾倒しているのですか？　それとも均等を追求しているのですか？",shape=box,color=blue];
		323 -> 331;
		323 -> 332;
		323 -> 333;
	320 [label="自分が正しいと確信しているわけではないし、誰もそう断言できない。ただ、自分は神を信じていないだけ。",shape=box,color=red];
		320 -> 328;
	321 [label="宗教は、死や未知への恐怖によって生じた穴を埋めるために存在していると思う。",shape=box,color=red];
		321 -> 329;
	322 [label="無関心のモノが何なのかはわからない、でも神ではない。真相を暴くまでだ。",shape=box,color=red];
		322 -> 330;
	319 [label="なるほど、もしかしたらそれが最も賢い答えなのかもしれませんね！　所詮私たちは人間（まだそう呼べるか疑わしいですが）、神々のみぞ知る構想を描こうなど、何様なのでしょう？",shape=box,color=blue];
		319 -> 327;
	336 [label="それより、全員に語りかける、もっと古く、より真相に近い、もっと深い何かがあると思う。絆のような何かが。",shape=box,color=red];
		336 -> 347;
	337 [label="そう。それぞれには独自の美学があって、信憑性を定められない。",shape=box,color=red];
