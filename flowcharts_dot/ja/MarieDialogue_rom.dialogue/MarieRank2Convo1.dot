	405 [label="嫉妬が止まりません！　私を蝕んでしまいそうです。もしお許しいただければ、このことについてもう一度お話ししたいのですが…　説教や詮索したいわけではありません。苦痛も与えたくはありません。",shape=box,color=blue];
		405 -> 409;
	406 [label="嗚呼、あなたの信仰がどうであれ、ソルはあなたに微笑んでいます。なぜなら、あなたが必要とする唯一の道を見つけたからです。",shape=box,color=blue];
		406 -> 410;
	407 [label="Aah, pardonne-moi！　失礼しました！　説教じみてしまって、お恥ずかしいです！　教師みたいに語るつもりはなかったのです。",shape=box,color=blue];
		407 -> 382;
	408 [label="あなたの正直さに深く感動しました。もしお許しいただければ、このことについてもう一度お話ししたいのですが…　説教や詮索したいわけではありません。苦痛も与えたくはありません。",shape=box,color=blue];
		408 -> 409;
	409 [label="好奇心もありますが、できることならお力になりたいのです。もちろん拒否していただいて構いません、そうすれば二度とこの話はしません。",shape=box,color=blue];
		409 -> 411;
		409 -> 412;
	410 [label="もし、差し支えなければ、またこの話をしても宜しいでしょうか？　好奇心が抑えられません。",shape=box,color=blue];
		410 -> 411;
		410 -> 412;
	411 [label="もう、結構だ。",shape=box,color=red];
		411 -> 413;
	412 [label="もちろん。",shape=box,color=red];
		412 -> 414;
