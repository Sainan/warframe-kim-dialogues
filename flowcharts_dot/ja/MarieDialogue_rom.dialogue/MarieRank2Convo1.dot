		372 -> 385;
	368 [label="まあ、私の心に響く旅人なのですね！　つい笑みを浮かべてしまいます。ご機嫌取りのための嘘でなければいいのですが。",shape=box,color=blue];
		368 -> 382;
	369 [label="なるほど、旅人はLyonと同じ夜の道を巡るのですね。彼の準備ができたら、闇の貴婦人の生き方について語ってもらうといいでしょう。きっと喜びます。",shape=box,color=blue];
		369 -> 382;
	370 [label="優柔不断にならず均等を保つ。人生とは、太陽が昇る時、月がそれに応える時を悟り、決して疑念に陥ることなく歩むこと。",shape=box,color=blue];
		370 -> 383;
