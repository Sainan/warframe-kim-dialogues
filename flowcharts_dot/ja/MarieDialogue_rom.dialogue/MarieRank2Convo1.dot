	339 [label="Oui, je vois...　確信するには、あなた自身の「証拠」が必要なのかもしれませんね。あなたの人生には、私たちが感じる信仰や熱意のような感情を抱かせるような出来事はなかったのですか？",shape=box,color=blue];
		339 -> 350;
		339 -> 351;
	340 [label="Oui, c'est vrai、まさにその通りです。信仰は多くの魂にとって多くの疑問に答えてくれます。死後に何が起こるのか、恐れませんか？",shape=box,color=blue];
		340 -> 352;
		340 -> 353;
	341 [label="Comme c'est fascinant...　同じ言葉を繰り返す者が二人になりました…　悪魔も同じことを囁いていました。",shape=box,color=blue];
		341 -> 354;
	338 [label="私たちの信仰にどれだけ興味があっても、「はい、はい、これが真実です」と伝えるのを拒んでしまいます。私たちの喜びの一部を彼らに少しでも伝わればと願うばかりです。",shape=box,color=blue];
		338 -> 348;
		338 -> 349;
	360 [label="Je comprends et c'est magnifique。ルミナリーズもかつては別の顔、別の名前があったか考えることがあります。",shape=box,color=blue];
