		413 -> 415;
	414 [label="Merch merci！　あなたが私に与えてくださった深い信頼に感謝します。決して失望させません。それではまた。",shape=box,color=blue];
		414 -> 416;
	415 [label="了解しました、そして私の事はお気になさらず。話を聞いてくださり、そちらからもお話いただき感謝しています。他の話題についてもお話しましょう。ソルの下、話すことは絶えませんから！",shape=box,color=blue];
