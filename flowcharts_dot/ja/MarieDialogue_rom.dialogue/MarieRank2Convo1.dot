		381 -> 393;
	374 [label="+5 Chemistry",color=orange];
		374 -> 387;
	375 [label="あなたの知恵と他人の信念に対する優しさに私は微笑んでいます。",shape=box,color=blue];
		375 -> 388;
	394 [label="もたらさない。",shape=box,color=red];
		394 -> 400;
	395 [label="あまり考えたことがない。",shape=box,color=red];
