		3530 -> 3534 [label="false",color=purple];
	3531 [label="ああ、ルミナリーズ - 彼の魂を科学と明滅する光の殻に閉じ込めておくために、どんな地獄をお創りになられたのでしょう！",shape=box,color=blue];
		3531 -> 3535;
	3532 [label="私はルミナリーズに祈ることしかできません。漂流者様が仰るように、殻の中に残っているのが科学と明滅する光だけであるように。",shape=box,color=blue];
		3532 -> 3536;
	3533 [label="セファロンに魂が宿るかどうか、漂流者様が確信を持てないのは存じております。でも私ができることは、ルミナリーズに祈ることだけなのです…　哀れなOtak様が苦しまないように。",shape=box,color=blue];
		3533 -> 3537;
	3534 [label="私は、ただルミナリーズに祈ることしかできません。殻の中に残っているのが科学と明滅する光だけでありますように、と。",shape=box,color=blue];
		3534 -> 3538;
	3535 [label="なぜそこに彼を置き去りにし、打ちのめし、安らぎを得るまで息絶えるのを待つのでしょうか？　私はただ祈るしかありません…　そこに何か存在があれば…",shape=box,color=blue];
		3535 -> 3539;
	3536 [label="そして、その殻の中に閉じ込められ、最終的に息絶え、平安が与えられるまで待てる魂など存在しません。",shape=box,color=blue];
		3536 -> 3540;
	3537 [label="その殻の中に閉じ込められ、最終的に息絶え、平安が与えられるまで待てる魂など存在しません。",shape=box,color=blue];
		3537 -> 3541;
	3538 [label="そして、その殻の中に閉じ込められ、最終的に息絶え、平安が与えられるまで待てる魂など存在しません。",shape=box,color=blue];
		3538 -> 3541;
	3539 [label="なぜなら、魂が自らの意志で孤独な見張りとして留まるからでは...",shape=box,color=blue];
		3539 -> 3542;
	3540 [label="もし漂流者様が間違っていて、魂が意志に反してその檻の中に留まるとしたら？",shape=box,color=blue];
		3540 -> 3543;
	3541 [label="あるいは、もし何らかの存在があるとすれば、それは彼が自らの選択で、ある種の孤独な見張りとしてそこに留まっているのでしょう。",shape=box,color=blue];
		3541 -> 3544;
	3542 [label="そうでないと考えると、神々の優しさに疑問を抱かずにはいられません、non？",shape=box,color=blue];
		3542 -> 3545;
	3543 [label="神々の優しさを疑わせるのに、十分ではございませんか、non？",shape=box,color=blue];
		3543 -> 3545;
	3544 [label="そうでないと考えると、神々の優しさに疑問を抱かずにはいられません、non？",shape=box,color=blue];
