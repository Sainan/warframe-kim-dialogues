	3485 [label="狼さん！　私の狼さん！　私、ネクロなLoid様の後ろにあるお顔に、遂に会えました！",shape=box,color=blue];
		3485 -> 3489;
		3485 -> 3490;
		3485 -> 3491;
	3486 [label="ネクロなLoid様の後ろにあるお顔！　ついに会えたのです！",shape=box,color=blue];
		3486 -> 3489;
		3486 -> 3490;
		3486 -> 3491;
	3487 [label="Otakと話すのは楽しかった？",shape=box,color=red];
		3487 -> 3492;
	3488 [label="Otakとの会話はどうだった？",shape=box,color=red];
		3488 -> 3493;
	3489 [label="かわいそうなOtak…　どうだった？",shape=box,color=red];
		3489 -> 3494;
	3490 [label="やっと会えて良かったな。Otakって、ちょっと説明しにくい性格だよな。",shape=box,color=red];
		3490 -> 3495;
	3491 [label="Otakに会ったの？　おお...　どうだった？",shape=box,color=red];
		3491 -> 3496;
	3492 [label="ええ楽しみました。でも同時に、泣きたくもなったのです。同じ会話の中で3回も自己紹介されたのです、まるで初対面かのように。",shape=box,color=blue];
		3492 -> 3497;
	3493 [label="Otak様は...　まるで初対面かのように、同じ会話の中で3回も自己紹介されました。",shape=box,color=blue];
		3493 -> 3497;
	3494 [label="Otak様は本当に優しくて魅力的なお方でした！　でも、ユーモアの裏に深い悲しみを感じました。",shape=box,color=blue];
		3494 -> 3498;
	3495 [label="ああ、確かにそうですね。子供が自動装置の裏に書いた落書きみたいな。本当に可愛くて魅力的なお方でした！",shape=box,color=blue];
		3495 -> 3499;
	3496 [label="私がOtak様に会ったこと、あまり嬉しくないのですか？",shape=box,color=blue];
		3496 -> 3500;
		3496 -> 3501;
		3496 -> 3502;
	3497 [label="前回と変わらず、いつものように明るく挨拶してくれました。でも、Otak様は私を「Sœur de Soll - ソルの修道女」と呼んだのです！ ",shape=box,color=blue];
		3497 -> 3503;
	3498 [label="Otak様の物語を教えていただけますでしょうか。",shape=box,color=blue];
		3498 -> 3504;
	3499 [label="しかし、そのおかしみの下には、大きな悲しみが隠されているのでしょうね。",shape=box,color=blue];
		3499 -> 3498;
	3500 [label="Otakには時々イライラさせるんだ、それだけ。 ",shape=box,color=red];
		3500 -> 3505;
	3501 [label="そんなつもりじゃなかった。ただOtakって人によってはちょっと…　うざったくなるんだ。",shape=box,color=red];
		3501 -> 3506;
	3502 [label="ごめんな。Otakって時々うざったくなるんだ。彼のせいじゃないけど。",shape=box,color=red];
		3502 -> 3506;
	3503 [label="実にOtak様はルミナリーズについてよくご存じでした！　私たちは、彼が言う「オロキン帝国以前」の「古代宗教」について長々と語り合いました。",shape=box,color=blue];
		3503 -> 3507;
	3504 [label="Otakはかつてアルキメデス、オロキンの科学者、研究家だったんだ。彼に起きたことは、決してハッピーエンドではなかった。",shape=box,color=red];
		3504 -> 3508;
	3505 [label="明らかに病弱な人に対しては、もっと優しく接するべきです。Mais par la grâce de Sol, go we all。ソルの恵みによって、皆が進みますよう。",shape=box,color=blue];
		3505 -> 3509;
	3506 [label="人々がOtak様に優しさと忍耐を示してくれることを祈ります。Mais par la grâce de Sol, go we all. ソルの恵みによって、皆が進みますよう。",shape=box,color=blue];
		3506 -> 3509;
	3507 [label="ですが、その知識の多くは今では失われ、書庫の奥深くへ格納され、厳重に禁じられているそうです。Otak様は私に秘密を守るよう命ぜられました。",shape=box,color=blue];
		3507 -> 3510;
	3508 [label="誰から見ても彼は天才であり、アルゴンクリスタルの活用方法を考案した張本人だ。",shape=box,color=red];
		3508 -> 3511;
	3509 [label="そのような運命は誰にでも訪れるかもしれません。漂流者様にも。",shape=box,color=blue];
		3509 -> 3512;
		3509 -> 3513;
	3510 [label="Otak様はこうも仰りました。執行官Ballasが異端の宗派を発見して信者を処刑するかもしれないことを深く心配されている、と。",shape=box,color=blue];
		3510 -> 3514;
		3510 -> 3515;
	3511 [label="アルゴンクリスタルはVoidから採取できて…　これがあるからこそ強力なWARFRAMEや武器を作れるんだ。",shape=box,color=red];
		3511 -> 3516;
	3512 [label="そうだな、ごめん。そういうつもりじゃなかったんだ。",shape=box,color=red];
		3512 -> 3498;
	3513 [label="Otakに費やす時間なんてない、ごめん。",shape=box,color=red];
		3513 -> 3517;
	3514 [label="Ballasは死んだんだ... 　続けて。",shape=box,color=red];
		3514 -> 3518;
	3515 [label="そんなこと起こらないよ。続けて。",shape=box,color=red];
		3515 -> 3518;
	3516 [label="彼は結晶学を専門としていた。そして彼の研究成果はここの研究所に保管されている。",shape=box,color=red];
		3516 -> 3519;
	3517 [label="あら、漂流者様のお時間をさらに無駄にして申し訳ありません。",shape=box,color=blue];
		3517 -> 3520;
	3518 [label="+5 Chemistry",color=orange];
		3518 -> 3521;
	3519 [label="何らかの理由で、彼はセファロンに変えられ、ネクロロイドの器を与えられた。",shape=box,color=red];
		3519 -> 3522;
	3520 [label="Update boolean MarieOtakComplete",color=orange];
		3520 -> 3523;
	3521 [label="そうかもしれないと思っていました…　Otak様は私がどこから来たのかお訊ねになられ、私が答えると笑って「いや、それは無理！　知ってるはずなんだけど…」と仰りました。",shape=box,color=blue];
		3521 -> 3524;
	3522 [label="すべてのセファロンは刑罰でそうさせられた訳ではない。でも、ダイモスの環境下で…　不運にも彼は重症を受けた。",shape=box,color=red];
		3522 -> 3525;
	3523 [label="Chat ends.",color=orange];
	3524 [label="それから、Otak様は…　また再度自己紹介をされて、鉱物の標本を持って草原から来たのかと尋ねられました…",shape=box,color=blue];
		3524 -> 3526;
