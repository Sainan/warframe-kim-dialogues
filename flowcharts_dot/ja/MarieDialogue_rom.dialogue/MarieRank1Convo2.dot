	j1466110566 [label="Marieから何か言ってもらえる？",shape=box,color=red];
		j1466110566 -> j165109991;
	j3679437140 [label="自分のせいじゃないならいいけど…",shape=box,color=red];
		j3679437140 -> j533195452;
	j165109991 [label="Lyonは…　心にある騒音と向き合っています。それを打ち明ける相手に慎重になっているのです。",shape=box,color=blue];
		j165109991 -> j3361415067;
	j533195452 [label="+5 Chemistry",color=orange];
		j533195452 -> j3524069375;
	j3361415067 [label="+15 Chemistry",color=orange];
		j3361415067 -> j2008674690;
	j3524069375 [label="Non non non、あなたの所為ではありません。Lyonは…　心にある騒音と向き合っています。それを打ち明ける相手に慎重になっているのです。",shape=box,color=blue];
		j3524069375 -> j3361415067;
