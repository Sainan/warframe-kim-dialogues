		j1591341850 -> j2626225715;
	j2679115625 [label="そう。MarieもRoatheも使っているから…",shape=box,color=red];
		j2679115625 -> j4021447287;
	j2927755826 [label="ご冗談を！　彼の学習速度は類がないほど早いですから。彼と金銭を賭けたパズルに挑むのことは勧めませんわ。",shape=box,color=blue];
		j2927755826 -> j4021447287;
	j2626225715 [label="いいえ、彼は新しいものへの理解は早い方です。彼なら下層を闊歩するmanœuvres de marcheを研究して、独自の構想を練り上げることも無理ではないでしょう。",shape=box,color=blue];
		j2626225715 -> j4021447287;
	j4021447287 [label="ただ彼は、あなたを知らないだけなのです。Lyonは…　あまり社交的に振る舞う類ではありません。別にあなたを軽蔑しているわけではありません。",shape=box,color=blue];
		j4021447287 -> j1466110566;
