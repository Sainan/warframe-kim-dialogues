		j1631090094 -> j2152951926 [label="false",color=purple];
	j238137091 [label="以前話して頂いたOtak様について、考えてきました。",shape=box,color=blue];
		j238137091 -> j2867687879;
	j1855406373 [label="以前話して頂いたカーディナルのご家族について、考えてきました。",shape=box,color=blue];
		j1855406373 -> j2276593399;
	j2152951926 [label="「ネクロなLoid様」について、また質問があるのですが、宜しいでしょうか？",shape=box,color=blue];
		j2152951926 -> j1911290291;
		j2152951926 -> j738393015;
	j2867687879 [label="もしかしたら、私の体験に似ているかもしれないと思いまして。もしお時間があれば、聞いてくださいますか？",shape=box,color=blue];
		j2867687879 -> j1790716942;
		j2867687879 -> j738393015;
	j2276593399 [label="ネクロロイドの後ろにある子供のような顔をした、Otak様の話を聞かせてもらえますか？",shape=box,color=blue];
		j2276593399 -> j3541274989;
		j2276593399 -> j2583803847;
	j1911290291 [label="大丈夫だよ、何が聞きたい？",shape=box,color=red];
		j1911290291 -> j2679606654;
	j738393015 [label="[閉じる]",shape=box,color=red];
		j738393015 -> "Chat ends.";
	j1790716942 [label="どうぞ。",shape=box,color=red];
		j1790716942 -> j449001354;
	j3541274989 [label="いいよ。",shape=box,color=red];
		j3541274989 -> j832106209;
	j2583803847 [label="後にして。[閉じる]",shape=box,color=red];
		j2583803847 -> "Chat ends.";
	j2679606654 [label="なぜあの方の後ろには子供の落書きのような顔があるのでしょうか。",shape=box,color=blue];
		j2679606654 -> j3405120395;
	"Chat ends." [color=orange];
	j449001354 [label="かつて大聖堂に、過去の回廊に迷い込んでしまったシスターがいました。名をシスターCéciliaと言いました。",shape=box,color=blue];
		j449001354 -> j3862516195;
	j832106209 [label="誰から見ても彼は天才であり、アルゴンクリスタルの活用方法を考案した張本人だ。",shape=box,color=red];
		j832106209 -> j2319615412;
	j3405120395 [label="ネクロなLoid様とLoid様にお尋ねしたのですが、あまり触れたくないようで、名前だけ教えていただきました。Otak、と。とても悲しそうに口ずさんでいました。",shape=box,color=blue];
		j3405120395 -> j3912072516;
	j3862516195 [label="彼女は廊下にある大きな時計の前に立って、現在の時刻を午後2時だと宣言しましたが、それが何時なのかを理解していませんでした。",shape=box,color=blue];
		j3862516195 -> j2628118011;
	j2319615412 [label="アルゴンクリスタルはVoidから採取できて…　これがあるからこそ強力なWARFRAMEや武器を作れるんだ。",shape=box,color=red];
		j2319615412 -> j3852033869;
	j3912072516 [label="それであなたならと思い、こうして聞いているのです。",shape=box,color=blue];
		j3912072516 -> j3975927772;
		j3912072516 -> j1379542834;
	j2628118011 [label="別の廊下にある絵画なども表裏を逆にして、絵が恐ろしい陰謀を囁いていると訴えました。",shape=box,color=blue];
		j2628118011 -> j892091393;
	j3852033869 [label="彼は結晶学を専門としていた。そして彼の研究成果はここの研究所に保管されている。",shape=box,color=red];
		j3852033869 -> j1565393099;
	j3975927772 [label="Otakについて知りたい？　それともなぜ話せないか知りたい？",shape=box,color=red];
		j3975927772 -> j2782632879;
	j1379542834 [label="Otakは…　なんて言うか、そうだな…",shape=box,color=red];
		j1379542834 -> j2100059297;
	j892091393 [label="後日それは向かいにある部屋からの声であることが判明しましたが、彼女はずっとそれが絵から発せられた声だと信じていました。",shape=box,color=blue];
		j892091393 -> j1455980445;
	j1565393099 [label="何らかの理由で、彼はセファロンに変えられ、ネクロロイドの器を与えられた。",shape=box,color=red];
		j1565393099 -> j1808405121;
	j2782632879 [label="できれば両方を知りたいですが、時間のこともありますし、どこから始めるかはあなたにお任せします。どちらが重要かもわかりませんし、après tout。",shape=box,color=blue];
		j2782632879 -> j2100059297;
	j2100059297 [label="Check boolean LoidFamilyComplete",color=orange];
		j2100059297 -> j2853138337 [label=true,color=green];
		j2100059297 -> j2853138337 [label=false,color=brown];
		j2100059297 -> j374068259 [label=false,color=brown];
	j1455980445 [label="一度、居間にある座席を子供たちと勘違いし、お茶会を開いていました…",shape=box,color=blue];
		j1455980445 -> j2501701544;
	j1808405121 [label="すべてのセファロンは刑罰でそうさせられた訳ではない。でも、ダイモスの環境下で…　不運にも彼は重症を受けた。",shape=box,color=red];
		j1808405121 -> j1758135524;
	j2853138337 [label="Otakはかつてアルキメデス、オロキンの科学者、研究家だったんだ。彼に起きたことは、決してハッピーエンドではなかった。",shape=box,color=red];
		j2853138337 -> j204025420;
	j374068259 [label="まぁ…　簡単に言うと、Entratiの家族の何人かが上の階にいて、彼らは…　自分たちがここにいることを把握していないんだ。",shape=box,color=red];
		j374068259 -> j2690042968;
	j2501701544 [label="私が部屋に入ると、私を見上げこう言いました。「あら、シスターOdette、そこにいらしたのですね！　孤児院からの子供たちがお越しです、ご一緒にいかがですか？」と。",shape=box,color=blue];
		j2501701544 -> j113602167;
		j2501701544 -> j13978424;
	j1758135524 [label="+5 Chemistry",color=orange];
		j1758135524 -> j2863737667;
	j204025420 [label="Boolean MarieOtak1 is now true.",color=orange];
		j204025420 -> j1593634802;
	j2690042968 [label="Boolean MarieFamily1 is now true.",color=orange];
		j2690042968 -> j4202909663;
	j113602167 [label="それでどうしたの？",shape=box,color=red];
		j113602167 -> j159738350;
	j13978424 [label="シスターOdetteって？",shape=box,color=red];
		j13978424 -> j2441220081;
	j2863737667 [label="Pauvre petit...",shape=box,color=blue];
		j2863737667 -> j4130373162;
	j1593634802 [label="まあ…　続けてください。",shape=box,color=blue];
		j1593634802 -> j832106209;
	j4202909663 [label="まあ…　つまり私たちは秘密裏にここにいると？　それがここを出てはならない理由なのですか？！Mais pourquoi？！",shape=box,color=blue];
		j4202909663 -> j2687575481;
	j159738350 [label="私は自分の椅子を空いている場所まで運び、彼女と、座席たちとお茶会をしました。他に何ができたでしょうか？",shape=box,color=blue];
		j159738350 -> j1907667838;
	j2441220081 [label="残念ですが、その時点でシスターOdetteが亡くなってから30年が経っていました。",shape=box,color=blue];
		j2441220081 -> j1237154733;
	j4130373162 [label="それで彼は主体のネクロロイド、残った最後の1体に精神を移されて、それで…　その、説明しづらいな。",shape=box,color=red];
		j4130373162 -> j3868477425;
		j4130373162 -> j2769213082;
		j4130373162 -> j2245904468;
	j2687575481 [label="Entratiの娘、Euleria、通称Motherね、それと彼女の家族は、ずっとダイモスの管理をしてきた。",shape=box,color=red];
		j2687575481 -> j1227716472;
	j1907667838 [label="私たちは笑いを交わしながら、彼女の過去について語ってくれました。私が知る限り、シスターCéciliaが他の誰にも伝えていないような話を。",shape=box,color=blue];
		j1907667838 -> j2068685542;
	j1237154733 [label="私は自分の椅子を空いている場所まで運び、彼女と、座席たちとお茶会をしました。",shape=box,color=blue];
		j1237154733 -> j1907667838;
	j3868477425 [label="正直修復できたらいいのになって思う。本物のOtakを蘇らせて。",shape=box,color=red];
		j3868477425 -> j449001354;
	j2769213082 [label="彼は自分を笑わせてくれる。面白い人だ、でもその裏には悲劇的で繊細な何かが隠れている。",shape=box,color=red];
		j2769213082 -> j449001354;
	j2245904468 [label="残念ながら、修復は不可能だ。あまり周りからも評判ではないみたいだ。",shape=box,color=red];
		j2245904468 -> j449001354;
	j1227716472 [label="Entratiが去ってからずっと、この場所と、VoidからOrigin太陽系へエネルギーを送る心臓を監視して、自分たちが…　力を維持できるようにしてるんだ。",shape=box,color=red];
		j1227716472 -> j3382079857;
	j2068685542 [label="彼女の目は、輝きを見せる時もあれば、虚ろになることもありました。そう、人形のように…",shape=box,color=blue];
		j2068685542 -> j2865799086;
