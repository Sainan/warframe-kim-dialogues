	j3476875989 [label="+15 Chemistry",color=orange];
		j3476875989 -> j2779984008;
	j3371470345 [label="…よくある話です。太陽の光に晒された絵のように、何も残らなくなるまで衰え続けました。",shape=box,color=blue];
		j3371470345 -> j2048188935;
	j1368659067 [label="+10 Chemistry",color=orange];
		j1368659067 -> j2905772652;
	j2960492595 [label="+5 Chemistry",color=orange];
		j2960492595 -> j436674095;
	j3153660389 [label="自分が、彼がまだ外で暴れ回っていて、彼女には一言もなしに、手紙さえ送っていないことを知りながら…？",shape=box,color=red];
		j3153660389 -> j2960116065;
	j2640596971 [label="彼女はAlbrechtの不在をまだ受け入れていなくて、家族は今もいがみ合っている。",shape=box,color=red];
		j2640596971 -> j2099080912;
	j2779984008 [label="良い質問です。知的な質問です。色々な理由が私をそうさせたのでしょう。でもあえて言うなら、優しさ、だったと信じたいです。",shape=box,color=blue];
		j2779984008 -> j2374849507;
	j2048188935 [label="そしていずれ彼女は去っていき、私たちは彼女のためにろうそくを灯して、祈りを捧げました。最後の時まで、彼女が私たちの思いやりを覚えていたことを願います。",shape=box,color=blue];
		j2048188935 -> j2793126835;
	j2905772652 [label="彼女が、心のどこかで理解していたと信じたいです。",shape=box,color=blue];
		j2905772652 -> j2793126835;
	j436674095 [label="本当に優しさなんでしょうか？　それとも罪悪感が生じた行動なのでしょうか？　ああ、でもそう言ってくれるあなたも優しいのですね。",shape=box,color=blue];
		j436674095 -> j2793126835;
	j2960116065 [label="それが彼女と、家族にとってどれだけ辛いか、想像もつかない。",shape=box,color=red];
		j2960116065 -> j2176639216;
	j2099080912 [label="自分が、彼がまだ外で暴れ回っていて、彼女には一言もなしに、手紙さえ送っていないことを知りながら…？",shape=box,color=red];
		j2099080912 -> j1584026076;
	j2374849507 [label="でも、心の奥底では、罪悪感があったのかもしれません。もしそうしなかったら、彼女を否定してしまうと。まるで子供を拒むように。",shape=box,color=blue];
		j2374849507 -> j2793126835;
	j2793126835 [label="Otak様も誰が誠に優しく、誰が気を遣ってくれているか理解していることを願います。でも…　本当の彼はここにいないのでしょう？",shape=box,color=blue];
		j2793126835 -> j3117117090;
	j2176639216 [label="カーディナルの不在によって生じた苦痛から、彼らを守ろうとする決断の論理は理解できますが…",shape=box,color=blue];
		j2176639216 -> j1144774753;
	j1584026076 [label="もうあの家族の和解は無理なのかもしれない。",shape=box,color=red];
		j1584026076 -> j1892208759;
	j3117117090 [label="今の彼は、人間に似せて作られた、精巧な機械なのでしょう？　何倍にも複雑な蓄音機のように。ネクロロイドらしく、魂がないのです。",shape=box,color=blue];
		j3117117090 -> j2490788361;
		j3117117090 -> j1071480485;
		j3117117090 -> j2782113483;
		j3117117090 -> j933273966;
		j3117117090 -> j205257963;
	j1144774753 [label="不必要に残酷だとは思いませんか？　もう死んでいるのか、それ以上に酷いことが起きているのかも知らないのです。それを私たちは黙って…　comme des rats d'égout？",shape=box,color=blue];
		j1144774753 -> j2443114856;
		j1144774753 -> j112926443;
	j1892208759 [label="+10 Chemistry",color=orange];
		j1892208759 -> j3063076710;
	j2490788361 [label="普通のネクロロイドにはないかもだけど、彼は特別なんだ。Otakみたいなセファロンには魂がある。ただ作る工程で破壊されただけだ。",shape=box,color=red];
		j2490788361 -> j554447582;
	j1071480485 [label="確かにそうだ。それでどうしろと？",shape=box,color=red];
		j1071480485 -> j1199133669;
	j2782113483 [label="確かにそうだ。だからと言ってひどい扱いをしていい訳ではない。",shape=box,color=red];
		j2782113483 -> j1069148068;
	j933273966 [label="その発言が正しいかはわからない。でも彼らは考え、感じることができる。物みたいな扱いはできない。",shape=box,color=red];
		j933273966 -> j99239041;
	j205257963 [label="ネクロロイドには魂がある。全てのセファロンがそうだ。",shape=box,color=red];
		j205257963 -> j488478189;
	j2443114856 [label="自分が決めることじゃない。",shape=box,color=red];
		j2443114856 -> j3314821568;
	j112926443 [label="Rats…　ネズミか？　実はネズミ好きな友人がいるんだ。結構カワイイと思っている。",shape=box,color=red];
		j112926443 -> j1004435350;
	j3063076710 [label="Oui…　なるほど。それなら家族の絆を修復するために動いたほうが良いのでは、non？　それが、ここから出るための唯一の手段だと思いますが。",shape=box,color=blue];
		j3063076710 -> j833669289;
	j554447582 [label="Boolean MarieCephalonSoul is now true.",color=orange];
