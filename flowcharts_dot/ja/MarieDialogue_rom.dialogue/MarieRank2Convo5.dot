		j99239041 -> j549793838;
	j488478189 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j488478189 -> j1416568157;
	j3314821568 [label="ええ、わかっています。Loid様と、他の全員も、ご自身の存在を公にするかはその方の判断です。",shape=box,color=blue];
		j3314821568 -> j836503654;
	j1004435350 [label="+15 Chemistry",color=orange];
		j1004435350 -> j3580457466;
	j833669289 [label="それか余生をここで過ごすかですね、comme des rats d'égout。",shape=box,color=blue];
		j833669289 -> j2825705086;
		j833669289 -> j2623750172;
	j1451205873 [label="+5 Chemistry",color=orange];
		j1451205873 -> j1587709158;
	j2986017147 [label="あなたを残酷と呼んでいるわけではありません！　Non！　彼らを大切にしてください、なぜなら彼は尊い存在なのですから。彼らは決して望んでああなったわけではありません。",shape=box,color=blue];
		j2986017147 -> j3236180914;
	j1940728010 [label="+5 Chemistry",color=orange];
		j1940728010 -> j2986017147;
	j549793838 [label="+5 Chemistry",color=orange];
		j549793838 -> j637957521;
	j1416568157 [label="+5 Chemistry",color=orange];
		j1416568157 -> j1493827146;
	j836503654 [label="私たちがここに留まっているのは、高潔さではなく、罪悪感からだと私は思います。",shape=box,color=blue];
		j836503654 -> j565029853;
	j3580457466 [label="いつかお会いしてみたいです、でもそうじゃありませんわ、おかしな狼さん。",shape=box,color=blue];
		j3580457466 -> j836503654;
	j2825705086 [label="確かに、あとに引き伸ばしすぎていた。すぐ取り掛かるよ。",shape=box,color=red];
		j2825705086 -> j2748987991;
	j2623750172 [label="Rats…　ネズミか？　実はネズミ好きな友人がいるんだ。結構カワイイと思っている。",shape=box,color=red];
		j2623750172 -> j3940578757;
	j1587709158 [label="悪魔とその同類が断罪されるべき存在だと更なる確信を持てました。しかし、Otak様とその同類についてあなたの見解は正しいのかもしれませんし、そう信じることで安らぎを得ているのかもしれません。",shape=box,color=blue];
		j1587709158 -> j377109522;
	j3236180914 [label="私の心が痛むのは、オロキンの悪魔たちが犠牲にしたものたちを想ってのことです。神でない彼らは、冒涜的にも進む道に血を流してきました。私が共に旅する彼を見れば一目瞭然です。",shape=box,color=blue];
		j3236180914 -> j2633779628;
	j637957521 [label="そうかもしれませんが、オロキンの悪魔たちが私たち以上に魂の仕組みを理解していたとは信じ難いです。大いなる神ではないのですから。",shape=box,color=blue];
		j637957521 -> j1523901029;
	j1493827146 [label="そうかもしれませんが、そう信じることで安らぎを得ているのかもしれません。",shape=box,color=blue];
		j1493827146 -> j2633779628;
	j565029853 [label="何か大きく、恐ろしい罪を隠していると。",shape=box,color=blue];
		j565029853 -> j1524001100;
	j2748987991 [label="+5 Chemistry",color=orange];
		j2748987991 -> j256704580;
	j3940578757 [label="+5 Chemistry",color=orange];
		j3940578757 -> j3580457466;
	j377109522 [label="どちらにせよ、今残るOtak様の記憶を大切にすれば、あの世のOtak様も微笑んでくれると私は信じています。",shape=box,color=blue];
		j377109522 -> j1531393501;
	j2633779628 [label="ただ、隣にLoid様がいる状態で、ネクロロイドに魂があると断言できないのです。違いますか？",shape=box,color=blue];
		j2633779628 -> j377109522;
