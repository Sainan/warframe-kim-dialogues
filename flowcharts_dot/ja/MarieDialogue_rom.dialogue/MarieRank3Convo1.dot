		917 -> 929 [label="false",color=purple];
	918 [label="感染体については知識が浅いのですが、あなたの考えを信じます。感じる「何か」が私の勘違いでなく、真実ならば…　彼女が閉じ込められているとは思いません。",shape=box,color=blue];
		918 -> 933;
	919 [label="なんと優しいお言葉なのでしょう。感じる「何か」が私の勘違いでなく、真実ならば…　あなたのおっしゃる通りだと思います。彼女が閉じ込められているとは言い難いです。",shape=box,color=blue];
		919 -> 933;
	920 [label="感じる「何か」が私の勘違いでなく、真実ならば…　彼女が閉じ込められているとは思いません。",shape=box,color=blue];
		920 -> 933;
	921 [label="感じる「何か」が私の勘違いでなく、真実ならば…　あなたのおっしゃる通りだと思います。彼らは私たちを助けてくれている。閉じ込められているとは言い難いです。",shape=box,color=blue];
		921 -> 933;
	922 [label="はい。私はカーディナルに祝福されました…　しかし、彼に対する私の愛情が特別なものであることも知っています。おそらく悲しみ、憎しみや恨みによって汚されていないからでしょう。",shape=box,color=blue];
		922 -> 934;
	925 [label="彼が何か恐ろしい怪物だって思っているのは承知しているのですが、なぜそれほど彼を信用しないのですか？",shape=box,color=blue];
		925 -> 937;
		925 -> 939;
		925 -> 938;
	923 [label="彼を信じていると思っていたのですが。気が変わったのですか？　そんなに気まぐれなのでしょうか。",shape=box,color=blue];
