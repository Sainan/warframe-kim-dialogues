	953 [label="+5 Chemistry",color=orange];
		953 -> 962;
	956 [label="始めは、残してきた娘の面影を探し求めていた部分もあったと思う。だけど、彼は代わりに無関心のモノと戦う方法を見つけたんだ…　自分が距離を置きたいと思っていた感情で…　",shape=box,color=red];
		956 -> 964;
	957 [label="彼の文書には、概念の具体化を研究し始めたことが記されているが、無関心のモノと戦うことの価値を見いだしたと、不快なほど自己満足的に書かれているんだ。",shape=box,color=red];
		957 -> 965;
	958 [label="彼の文書を信じるなら、彼はデュヴィリに、そしてひいては自分にも、無関心のモノからの防護術を教えるためにいたように書かれている。結局、何の役にも立たなかったけど。",shape=box,color=red];
		958 -> 966;
