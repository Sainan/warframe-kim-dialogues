	978 [label="彼は自分をそこに置き去りにしたんだ。彼はそこに着き、Voidで見捨てられた者を見て、ただ…　置き去りにしたんだ。",shape=box,color=red];
		978 -> 986;
	979 [label="結局、無関心のモノはデュヴィリを襲ったんだ（とはいえ、予想外の助けもあったのだが。この話とは関係ないけど）。",shape=box,color=red];
		979 -> 987;
