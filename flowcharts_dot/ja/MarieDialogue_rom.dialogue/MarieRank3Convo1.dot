	883 [label="+5 Chemistry",color=orange];
		883 -> 890;
	887 [label="彼女の声が聞こえるのとは少し違いますわ。Lyonが神々や守護霊の声を聞くのとは少し違います。彼女が見えるわけではないし。ただ、彼女がそこに…　私のそばにいるのを感じるのです。",shape=box,color=blue];
