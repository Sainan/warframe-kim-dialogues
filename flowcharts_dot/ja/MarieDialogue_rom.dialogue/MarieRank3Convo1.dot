		876 -> 882;
	877 [label="どっちも有力な理論だと思うよ。創造主にとって、武器であって、芸術作品でもあったんだよ。",shape=box,color=red];
		877 -> 883;
	881 [label="Vraiment？　私にとって、彼女は自分の妹のように知っている気がするんです。大聖堂の一員ではなく、自分の血を分けた姉妹のように。",shape=box,color=blue];
		881 -> 887;
