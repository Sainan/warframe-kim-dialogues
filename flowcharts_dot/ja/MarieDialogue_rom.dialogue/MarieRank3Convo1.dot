	931 [label="ルミナリーズの信奉者として、ある者は一人で未知の場を歩むと、教えがあることをご存知のはず。Oui？",shape=box,color=blue];
		931 -> 942;
	929 [label="私の信仰では、人生の道を歩む者の中に、ルアとソルが出会う岐路に立つ者がいることを知っています。 ",shape=box,color=blue];
		929 -> 942;
	933 [label="彼女からは、ソルの温もりを感じます。そして、カーディナルの選択は賢明だとも思います。彼女の血を受け継げたことは光栄です。",shape=box,color=blue];
		933 -> 908;
		933 -> 907;
		933 -> 905;
		933 -> 906;
	934 [label="彼が私たちのもとを去ったことを許します。他の方はそうでないようですが…",shape=box,color=blue];
		934 -> 943;
		934 -> 944;
		934 -> 937;
		934 -> 938;
	937 [label="彼は…　デュヴィリに来たんだ。ずっと昔に…",shape=box,color=red];
		937 -> 947;
	939 [label="そうだな。まず、彼は自分の胸を撃ち、死んだと思って放置したんだ。",shape=box,color=red];
		939 -> 948;
	938 [label="彼が去った後に残るのは、苦しみや死だけ。見捨てられるだけなんだ。",shape=box,color=red];
		938 -> 917;
	935 [label="彼を信頼したことは一度もない。Marieをびっくりさせたくなかったんだ。",shape=box,color=red];
		935 -> 945;
	936 [label="先日話したときに嘘をつくつもりはなかったんだけど、どう話せばいいのか分からなかったんだ。Marieは明らかに彼を崇拝しているみたいだし…",shape=box,color=red];
		936 -> 946;
	941 [label="Update boolean MarieNoDate",color=orange];
		941 -> 950;
	940 [label="そう、私たちは強くあらねばなりません。Braves contre les ténèbres, pour toujours et à jamais !",shape=box,color=blue];
		940 -> 949;
	942 [label="Update boolean DrifterCrossroads",color=orange];
		942 -> 951;
	943 [label="彼は多くの人を傷つけ、見捨ててきた。Marieの言う通りだ。そうざるを得なかったのではと今では思っている。",shape=box,color=red];
		943 -> 952;
	944 [label="自分にとって大切な人…　愛して頼りにしていた人がいなくなること以上に辛いものはないんだ。特に理由が分らなかったり、戻ってこなかった時には特に…",shape=box,color=red];
		944 -> 953;
	947 [label="ああソルよ！　あなたが創ったこの世界は、娘様が書いた本から描かれたのですね。Loid様が話していた世界に…　カーディナルがいらっしゃったのですか？　理由を教えてください。",shape=box,color=blue];
		947 -> 956;
		947 -> 957;
		947 -> 958;
	948 [label="Et pourtant, vous êtes toujours en vie ! あなたは生きているでしょう？　満足なほどに。Loid様が語ったあなたの過去と未来の冒険談が本当なら、生き生きとしているように見えますが…",shape=box,color=blue];
		948 -> 959;
	945 [label="Ah, je vois ! Je suis une idiote, c'est ça ?! Juste une petite invalide venue d'un passé lointain, incapable de penser par elle-même ?! Mieux vaut l'approcher comme un faon dans les bois, de peur de l'effrayer !",shape=box,color=blue];
		945 -> 954;
	946 [label="Ah, oui...　まだ本音で話し合えるような関係じゃなかったものね、そうでしょう？",shape=box,color=blue];
		946 -> 955;
	950 [label="Chat ends.",color=orange];
	949 [label="私は、彼が去ったことを許します。他の方はそうでないようですが…",shape=box,color=blue];
		949 -> 943;
		949 -> 944;
	951 [label="カーディナルは必ず私たちの元へ戻って来なければなりません。私たちにできるのは、彼が呼びかけた時にできる限りのことをして、祝福された者たちの命令に従うことだけです。",shape=box,color=blue];
		951 -> 960;
	952 [label="+5 Chemistry",color=orange];
