	991 [label="Update boolean MarieEntratiFan2",color=orange];
		991 -> 1000;
	989 [label="Oui, c'est raisonnable 公平だと思いますわ。あなたが見てきたこと、知っていることを全て考慮すると、合理的で公平な考え方だと評価します。それ以上、あなたに求めません。",shape=box,color=blue];
		989 -> 999;
	992 [label="Update boolean MarieLyonSuffering3",color=orange];
		992 -> 917;
	993 [label="それではあなたに、先入観のみで彼が最悪の選択を取ったことを想定しないようお願いします。決めつけると心が痛みますから。",shape=box,color=blue];
		993 -> 1001;
	994 [label="正当な理由があったことを願うばかりだ。",shape=box,color=red];
		994 -> 1002;
	995 [label="そう。でもそれが問題じゃないんだ。彼は自分を助けられるはずだったのに、助けない選択をしたんだ。",shape=box,color=red];
		995 -> 1003;
	996 [label="他の仮面をかぶっているだけだ。",shape=box,color=red];
		996 -> 1004;
	997 [label="そうかもしれない。あるいは人質だったのかも。彼女が仮面をかぶっているだけかもしれないし。本当のところは分からない。",shape=box,color=red];
		997 -> 1004;
	998 [label="+10 Chemistry",color=orange];
		998 -> 1005;
	1000 [label="あ、Lyonが呼んでいます。À la revoyure !",shape=box,color=blue];
