	873 [label="原版のWispに関する情報はあまりないんだ。残念なんだが。",shape=box,color=red];
		873 -> 881;
	872 [label="「魂」についての議論が苦痛でないなら…　触れたくない題材なら、もっと実際的な話に絞り込めるかもしれませんが、あなたを不快にするつもりは全くありません。",shape=box,color=blue];
		872 -> 880;
