	968 [label="もし、カビアに関する噂が本当なら、喜びを味わうことができないのかしら。",shape=box,color=blue];
		968 -> 967;
	967 [label="Non, カーディナルは他の多くの人々にもっと酷いことをしてきたかもしれません。しかし、単に不便を被ったことに腹を立てているだけではないでしょうか。",shape=box,color=blue];
