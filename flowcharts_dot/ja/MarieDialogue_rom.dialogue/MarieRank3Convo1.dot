	976 [label="要点を理解してくれないかな。彼は自分をそこに置き去りにしたんだ。Voidで見捨てられた者を見て、ただ…　置き去りにしたんだ。",shape=box,color=red];
		976 -> 986;
	977 [label="わからない。彼は自分をそこに置き去りにしたんだ。Voidで見捨てられた者を見て、ただ…　置き去りにしたんだ。",shape=box,color=red];
