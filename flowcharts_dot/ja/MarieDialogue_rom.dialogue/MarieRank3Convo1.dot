	897 [label="かなり正常でないように聞こえたのではないかしら。ごめんなさい。",shape=box,color=blue];
		897 -> 901;
		897 -> 902;
		897 -> 903;
		897 -> 904;
	896 [label="Oui, bien sûr！　おっしゃる通り。誰も説教されたくないですもんね。ましてやシスターからなんて。わかりました。私も恥をかくつもりはありません。",shape=box,color=blue];
		896 -> 868;
		896 -> 867;
		896 -> 900;
	898 [label="ええ、おっしゃる通りです。ササヤキ達もご存知の通り、今となっては私も武器です。しかし、カーディナルが導いてくださった道、それは祝福された道なのですから、私はその道を歩みます。",shape=box,color=blue];
		898 -> 905;
		898 -> 906;
	899 [label="カーディナルのように。彼はオロキンでいらっしゃいました。私が非難するような方ではなかったのです。彼のおかげで、今の私が存在するのです。恩人です。",shape=box,color=blue];
		899 -> 907;
		899 -> 908;
	901 [label="WARFRAMEは…　愛情を込められて作られていない。彼女が感染体に閉じ込められていないことを祈るばかりだ。",shape=box,color=red];
		901 -> 910;
	902 [label="Wispが誰だって、彼女はMarieと知り合えたら喜ぶと思う。",shape=box,color=red];
		902 -> 911;
	903 [label="彼らの魂が安らかに旅立っていることを願っている。でも記憶の一部は残っているかもしれない。",shape=box,color=red];
		903 -> 912;
	904 [label="そんなことない。WARFRAMEに変えられた人々の中には、その核となる設計図の中に残っている者もいると信じている。",shape=box,color=red];
		904 -> 913;
	900 [label="[閉じる]",shape=box,color=red];
		900 -> 909;
	905 [label="彼と議論したい点は多くある。しかし、彼はPROTOFRAME血清を誰に投与すべきかについては優れた直感を持ち合わせているようだ。なぜそんなことをするのかは理解できないが。",shape=box,color=red];
		905 -> 914;
