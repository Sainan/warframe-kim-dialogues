	999 [label="Update boolean MarieEntratiNeutral",color=orange];
		999 -> 1000;
	1001 [label="もしかしたら、あなたはまだデュヴィリを見捨てたくなかったのかもしれません。あなたにとって、まだ状況がそこまで悪化していなかった可能性も…　友人たちと別れる気はなかったのかもしれないですね。",shape=box,color=blue];
		1001 -> 1007;
	1002 [label="+5 Chemistry",color=orange];
