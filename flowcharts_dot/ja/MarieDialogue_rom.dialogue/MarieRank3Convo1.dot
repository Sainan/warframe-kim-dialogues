	1005 [label="なんて素晴らしい考え方でしょう。擁護する価値のある大義だと思います。",shape=box,color=blue];
		1005 -> 1010;
	1006 [label="Chat ends.",color=orange];
	1007 [label="あと…　彼は弱ったあなたをそこから連れ出せるかどうか分からなかったという理由も考えられるかしら。あなたがいなかったら無関心のモノがそれを奪ってしまうと考えたかもしれない…　Peut-être, peut-être, peut-être.",shape=box,color=blue];
		1007 -> 917;
	1008 [label="Merci, merci - 私の大切な信念を分かってくれたようですね。最悪の事態を想定してはいけません。最悪の事態は心を最も苦しめるからです。",shape=box,color=blue];
		1008 -> 1011;
	1009 [label="どうとらえたらいいのか迷います…　非常に興味深いお話…",shape=box,color=blue];
