		960 -> 970 [label="false",color=purple];
	961 [label="Oui,　その通りよ。今までやって来たこと全てに対して罪悪感に苛まれているのだと思うわ。おそらく、意図的に他人と距離を置いているのだと。",shape=box,color=blue];
		961 -> 973;
	962 [label="Oui, なんと痛々しい。誰かが…　まだ生きている方が、あなたのそばを離れることを選んでいるなんて。",shape=box,color=blue];
		962 -> 973;
	964 [label="Mon cœur se brise dans la tragédie. 私はその悲しみに耐えられないと思います。それでも、娘様は彼を許してくれないのでしょうか。",shape=box,color=blue];
		964 -> 975;
