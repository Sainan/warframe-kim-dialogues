		924 -> 937;
		924 -> 938;
		924 -> 939;
	928 [label="Oui, そんなに急に気が変わるとは…　嘘なのではないでしょうか。何が目的なのか、私には分かりません。Et je ne veux pas le savoir - 知りたくもありません。",shape=box,color=blue];
