		971 -> 982;
	972 [label="エントラティの悪行の動機を理解できれば、許しやすいだろうに。",shape=box,color=red];
		972 -> 983;
	970 [label="この問題を解決するために、彼が求めていることを全てこなすつもりだ。だが、全てが終わった後に、奴を裁く。",shape=box,color=red];
		970 -> 981;
	973 [label="Il inflige la douleur dans le cœur des autres, car la douleur vaut mieux que rien du tout. 苦しみを感じる方が空虚より安心できるから…",shape=box,color=blue];
		973 -> 984;
