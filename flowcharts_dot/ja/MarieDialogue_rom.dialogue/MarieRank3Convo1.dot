	980 [label="Update boolean MarieEntratiFamily",color=orange];
		980 -> 988;
	982 [label="意見が一致しないことに合意せざるを得ないかもしれませんね。",shape=box,color=blue];
		982 -> 990;
	983 [label="いつか許せるときが来ることを祈ります。最終的には、私たち全員が生き残ってその場を見届けられるのが理想ですね。でも今は、周りの famille を見て、心の中で許せることを祈っています。彼ら自身の幸せのために…",shape=box,color=blue];
		983 -> 991;
	981 [label="+10 Chemistry",color=orange];
		981 -> 989;
	984 [label="それは、私の最愛のLyonが誰よりもよく知っている教訓です…　会話を交わせる関係になれたことを本当にうれしく思っています。たとえ今日はカーディナルの話をすることになっても。",shape=box,color=blue];
		984 -> 992;
	985 [label="殺人が繰り返される前に起こったとしか思えません。",shape=box,color=red];
		985 -> 993;
	986 [label="彼があなたを置き去りにした理由を知らないのですか？",shape=box,color=blue];
		986 -> 994;
		986 -> 985;
		986 -> 995;
	987 [label="Non. え？　すみません。無関心のモノには…　味方がいるのですか？",shape=box,color=blue];
		987 -> 996;
		987 -> 997;
	988 [label="Add 1 to Family",color=orange];
