	888 [label="武器は、守るためにも、傷つけるためにも使える。武器を手に取るのはいい気がしない…　しかし、必要な時もある。",shape=box,color=red];
		888 -> 894;
	889 [label="全員がそうとは言い切れない。でも奴は？　そう。でもすぐに非難できない者もいる。",shape=box,color=red];
		889 -> 895;
	890 [label="Une horrible toile d'os peinte avec du sang... ご理解いただけましたか？　オロキンは悪魔なのです。",shape=box,color=blue];
		890 -> 888;
		890 -> 889;
	893 [label="まるで古い友人のように。彼女は何が好きか、どんな風に振る舞うとか…　手に取るように分るんです。風に吹かれて響く彼女の笑い声を思い出します。",shape=box,color=blue];
		893 -> 897;
