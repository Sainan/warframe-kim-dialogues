		j2768654365 -> "Chat ends.";
	j2655830472 [label="Bonjour mon cœur！　考えてみたのですが…　でも、本当に認めたくないのです。このようなことを申し上げるのは、私にとって何の喜びにもならないのです。",shape=box,color=blue];
		j2655830472 -> j1042211650;
	j1538348148 [label="Bonjour。少し考えてみましたが…　認めたくないのです。こんなことを申し上げるのは、心苦しいのです。",shape=box,color=blue];
		j1538348148 -> j1042211650;
	j1341593947 [label="Bonjour, mon cœur！　私が何に反対するとお考えですか？",shape=box,color=blue];
		j1341593947 -> j4181172647;
	j3272658179 [label="Bonjourr！　あら？　私が何に反対するとお考えですか？",shape=box,color=blue];
		j3272658179 -> j4181172647;
	j3095769209 [label="Bonjour, bonjour, mon cœur！　考えてみたのですが…　でも、本当に認めたくないのです。このようなことを申し上げるのは、私にとって何の喜びにもならないのです。",shape=box,color=blue];
		j3095769209 -> j2674234886;
	j929392170 [label="Bonjour。少し考えてみましたが…　認めたくないのです。こんなことを申し上げるのは、心苦しいのです。",shape=box,color=blue];
		j929392170 -> j2674234886;
	j1230625472 [label="でも、何かしらの...　要塞が必要ではありませんか？　何かお考えはありますか？",shape=box,color=blue];
		j1230625472 -> j1119980384;
		j1230625472 -> j4181172647;
	j1042211650 [label="でも、思うに…　ああ、ソル、お許しを。悪魔の助けが必要かもしれません。さもなくば、Loid様は私たちに耳を貸してはくれないでしょう。",shape=box,color=blue];
		j1042211650 -> j191257832;
	j4181172647 [label="Loidにエントラティ家と対話させるには、Roatheの助けが必要かなって。他に手段はないだろう。家族と彼が守られるという保証がなければ。",shape=box,color=red];
		j4181172647 -> j645638819;
	j2674234886 [label="漂流者様の仰る通りかもしれません。悪魔こそが、必要な要素なのかもしれませんね。ああ、この文字を打つのすら不快です！ ",shape=box,color=blue];
		j2674234886 -> j409794056;
	j1119980384 [label="藁にもすがる以外に、いい案が思いつかないんだ。後始末が大変だったとしても。つまり、具体的にはRoatheだ。",shape=box,color=red];
		j1119980384 -> j3187880449;
	j191257832 [label="悪魔は強力で、難航する場面での強靭さは、信頼できるかもしれません。 non？",shape=box,color=blue];
		j191257832 -> j3355641093;
		j191257832 -> j2985307212;
	j645638819 [label="私は...　認めたくございませんが、漂流者様のお考えは正しいかもしれません...　ソル、お許しを。",shape=box,color=blue];
		j645638819 -> j409794056;
	j409794056 [label="Evaluate expressions",color=orange];
		j409794056 -> j1791132779 [label="RoatheFamilyFail",color=purple];
