",color=purple];
		j409794056 -> j3212812358 [label="RoatheVillain, RoatheFamilyDelay",color=purple];
		j409794056 -> j3388504010 [label="false",color=purple];
	j3187880449 [label="本当にそうお考えですか？　私が悪魔とのdifférencesに目をつぶれるなら、漂流者様もできるはず、non？",shape=box,color=blue];
		j3187880449 -> j1030437987;
		j3187880449 -> j221917744;
	j3355641093 [label="そうだな。Marieが同意してくれるとは思ってなかった。聞くのが怖かったんだ。",shape=box,color=red];
		j3355641093 -> j409794056;
	j2985307212 [label="いや、別の手段があるはず。彼に助けを求めるのは拒否する。",shape=box,color=red];
		j2985307212 -> j3187880449;
	j1791132779 [label="この件について、彼が助けになるでしょうか？",shape=box,color=blue];
		j1791132779 -> j1404485644;
	j1832644229 [label="この件について、彼が助けになるでしょうか？",shape=box,color=blue];
		j1832644229 -> j3889327159;
	j3212812358 [label="この件について、彼が助けになるでしょうか？",shape=box,color=blue];
		j3212812358 -> j977334657;
	j3388504010 [label="ですが、彼を説得すれば、私たちは助かるとお考えですか？",shape=box,color=blue];
		j3388504010 -> j2806432459;
		j3388504010 -> j3074124180;
	j1030437987 [label="わかった。Marieがいいなら、賛成する。",shape=box,color=red];
		j1030437987 -> j2135497267;
	j221917744 [label="できない、ごめん。 ",shape=box,color=red];
		j221917744 -> j1256711439;
	j1404485644 [label="いや、残念ながら…　Roatheに関してはもう行き詰まってた。他に良い考えはある？",shape=box,color=red];
		j1404485644 -> j3260102237;
	j3889327159 [label="そう思うよ。Roatheを説得して、再会を促したいんだ。信じられないかもしれないけど、エントラティの家族を守るためなら。何といっても、オロキンに残されたものはあの家族だけだから。",shape=box,color=red];
		j3889327159 -> j658130215;
	j977334657 [label="そうなると思う。再会をけしかけさせるよう、Roatheを説得したんだ。解ってるだろ、Albrechtがいない間に嫌がらせするために。",shape=box,color=red];
		j977334657 -> j218725753;
	j2806432459 [label="まだ準備段階だけど、できるはず。",shape=box,color=red];
		j2806432459 -> j961489522;
	j3074124180 [label="まだ何も決まってないんだ。彼は…　まあ、お察しの通りだ。",shape=box,color=red];
		j3074124180 -> j3827853471;
