		j1974428419 -> j2693911284;
	j1215089889 [label="彼は…　長い間、辛い思いをしてきた。それが心のかさぶたになって棘だらけに見えるだけ。",shape=box,color=red];
		j1215089889 -> j3236684303;
	j2531883574 [label="Roatheがどれだけの年月を生きてきたか、理解できる。自分も同じくらい多くの死を見てきた。",shape=box,color=red];
		j2531883574 -> j911736967;
	j371630537 [label="Roatheは常に正しいことをしようとしてきた。確かに、やり方は間違っていたかもしれない。でも、オロキンからOrigin太陽系を救おうとしていたんだ。",shape=box,color=red];
		j371630537 -> j3351187116;
	j3631340251 [label="Roatheには皮肉なユーモアのセンスがあって楽しいんだ。彼が心を許せば、賢いことが見て取れる。",shape=box,color=red];
		j3631340251 -> j2271742041;
