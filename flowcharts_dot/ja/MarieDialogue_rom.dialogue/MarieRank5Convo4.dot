	j1728751216 [label="漂流者が悪魔の肩でちょっとしたun angeとなって彼を落ち着かせることができるなら、なおさらに。",shape=box,color=blue];
		j1728751216 -> j962241740;
		j1728751216 -> j832153635;
	j4051357404 [label="近頃では私がその筆頭でしょうね、non？　悪魔がなぜあんな風になっているのか、その理由を考えるべきでは？　他者を非難しても何の役にも立ちません。",shape=box,color=blue];
		j4051357404 -> j2384198371;
	j2693911284 [label="私たちはいつも、他人に利用されるのを恐れ、自分の痛みを隠そうとします。もし漂流者様の仰ることが本当なら、悪魔にもっと優しくするよう努めます。",shape=box,color=blue];
		j2693911284 -> j2384198371;
	j3236684303 [label="これほどの年月で、悪魔はどれほどの愛と喪失を味わってきたのでしょう。私が見てきたことすべてを考慮したとしても、想像もつきません。",shape=box,color=blue];
		j3236684303 -> j761959541;
	j911736967 [label="悪魔と話していると、彼が何世紀も生きてきたことを忘れることがあります。私が見てきたすべてのことを考えても、まるで現実とは思えないのです。",shape=box,color=blue];
		j911736967 -> j1463491130;
	j3351187116 [label="Nuanceというものがあるでしょう…　oui？ 　行動は理由を伴うもの。もし漂流者様の仰ることが本当なら、悪魔にもっと優しくするよう努めます。",shape=box,color=blue];
		j3351187116 -> j2384198371;
	j2271742041 [label="誰も悪魔の知恵を否定したりはしません。",shape=box,color=blue];
