	j2384198371 [label="+10 Chemistry",color=orange];
		j2384198371 -> j2047584388;
	j761959541 [label="Oui、それで魂にどんな害が及ぶというのです？　理解してくれる人を見つけたい気持ちは理解できます。そして、彼にとってはあなたがそうなのですね。",shape=box,color=blue];
		j761959541 -> j2384198371;
