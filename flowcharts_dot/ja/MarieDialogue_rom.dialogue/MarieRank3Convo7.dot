		j678565364 -> j738393015;
	j3143297576 [label="Lyonとどうやって出会ったの？",shape=box,color=red];
		j3143297576 -> j1319013294;
	j3152800639 [label="Lyonは…　大丈夫？",shape=box,color=red];
		j3152800639 -> j2496052669;
	j738393015 [label="[閉じる]",shape=box,color=red];
		j738393015 -> "Chat ends.";
	j1319013294 [label="私がMère Supérieure修道院長に迎えられた時にはもう、愛しいLyonはすでに長い月日を大聖堂で過ごしていました。ルミナリーズ教会の修道女になった時の話です。（Lyonと会話を交わしているとお聞きしてとても胸がわくわくします）",shape=box,color=blue];
		j1319013294 -> j1787457068;
		j1319013294 -> j3094988693;
	j2496052669 [label="話を進める前に「大丈夫」の意味を明確にしていただけませんか。彼は私の魂の兄弟であることを思い出して、優しい気持ちで説明してください。",shape=box,color=blue];
		j2496052669 -> j4084960620;
		j2496052669 -> j1328131604;
	"Chat ends." [color=orange];
	j1787457068 [label="住む場所に…　困っていたの？",shape=box,color=red];
		j1787457068 -> j2943053832;
	j3094988693 [label="失礼かもしれない質問をしてもいい？",shape=box,color=red];
		j3094988693 -> j356920697;
	j4084960620 [label="この題材が不快になるようだったら、他のことを喋ってもいい。",shape=box,color=red];
		j4084960620 -> j4177683981;
	j1328131604 [label="Marieを悲しい気持ちにさせたいんじゃないんだ。ただ、Lyonのことは心配だ。一見冷静そうに見えるけど、苦しんでいるようにも感じる。だから少し教えて欲しかったんだ。",shape=box,color=red];
		j1328131604 -> j1167606604;
	j2943053832 [label="幼い頃、famille に捨てられたからです。物乞いとして何年も過ごし、何とか生きていました。",shape=box,color=blue];
		j2943053832 -> j2820608954;
	j356920697 [label="+5 Chemistry",color=orange];
		j356920697 -> j2094875668;
	j4177683981 [label="いえいえ、今のところ問題ありません。好奇心旺盛な見物人が、Lyonをまるで monstre de cirque - サーカスの怪物のように、檻の策を叩きながら寄ってくる経験があるので、構えてしまいました。",shape=box,color=blue];
		j4177683981 -> j3457539268;
		j4177683981 -> j66176834;
		j4177683981 -> j1058887668;
	j1167606604 [label="+5 Chemistry",color=orange];
		j1167606604 -> j275554586;
	j2820608954 [label="Boolean MarieBeggar1 is now true.",color=orange];
		j2820608954 -> j2076236096;
	j2094875668 [label="狼のようだと言われている方が、私の前では実に礼儀正しいのですね。微笑ましい。それとなく、質問したい内容がわかるのですが…　もしかして、どうして路上で住んでいたのかとお尋ねになりたいのでしょうか。",shape=box,color=blue];
		j2094875668 -> j2943053832;
	j3457539268 [label="二人はどうやって出会ったの？",shape=box,color=red];
		j3457539268 -> j3339425572;
	j66176834 [label="自分も「地元の名物」になることに慣れてる。Marieが防御的になる心境を察する。",shape=box,color=red];
		j66176834 -> j1985479210;
	j1058887668 [label="大丈夫だよ。ただ彼のことが心配なんだ。",shape=box,color=red];
		j1058887668 -> j565142106;
	j275554586 [label="いえいえ、ぶっきらぼうな態度をしてしまって申し訳ございません。好奇心旺盛な見物人が、Lyonをまるで monstre de cirque - サーカスの怪物のように、檻の策を叩きながら寄ってくる経験があるので、構えてしまいました。",shape=box,color=blue];
		j275554586 -> j66176834;
		j275554586 -> j1058887668;
	j2076236096 [label="ご想像のとおり、la Cité de la Lumièreには、足の動かない私のような人間が行ける仕事も場所もほとんどありません。",shape=box,color=blue];
		j2076236096 -> j125603175;
	j3339425572 [label="私がMère Supérieure修道院長に迎えられた時にはもう、愛しいLyonはすでに長い月日を大聖堂で過ごしていました。ルミナリーズ教会の修道女になった時の話です。",shape=box,color=blue];
		j3339425572 -> j1410598991;
		j3339425572 -> j371043004;
	j1985479210 [label="Oui, そうでしょうね。時間をループさせて、新しい世界を召喚して時間旅行をこなせる方はさぞかし興味深い目で見られたのでは。ちょっとした魔法使いのような、non？",shape=box,color=blue];
		j1985479210 -> j1019087560;
		j1985479210 -> j2083404360;
	j565142106 [label="+5 Chemistry",color=orange];
		j565142106 -> j84579553;
	j125603175 [label="そうだから、Lyonとはすぐに家族になれたのだと思います。彼は一度も私を哀れむような目で見なかったし、私も彼を哀れむことはありませんでした。",shape=box,color=blue];
		j125603175 -> j2080598077;
	j1410598991 [label="住む場所に…　困っていたの？",shape=box,color=red];
		j1410598991 -> j2773205535;
	j371043004 [label="失礼かもしれない質問をしてもいい？",shape=box,color=red];
		j371043004 -> j1751117701;
	j1019087560 [label="かなり簡潔な概略だな。",shape=box,color=red];
		j1019087560 -> j3461875915;
	j2083404360 [label="見た目だけで判断してもらいたくない。正直なところ。",shape=box,color=red];
		j2083404360 -> j953993636;
	j84579553 [label="彼のことを親身に心配してくれることを心から尊敬しています。Lyonは芯が強く、課されたものに耐える力を持っています。しかし、どんな重荷も一緒に背負うほうが楽なのではないでしょうか。",shape=box,color=blue];
		j84579553 -> j3942518832;
		j84579553 -> j1286977600;
	j2080598077 [label="他人は、Lyonをまるで monstre de cirque - サーカスの怪物のように、檻の策を叩きながら寄ってくる場合もあったのです。",shape=box,color=blue];
		j2080598077 -> j1131432654;
	j2773205535 [label="幼い頃、famille に捨てられたからです。物乞いとして何年も過ごし、何とか生きていました。",shape=box,color=blue];
		j2773205535 -> j2187828253;
	j1751117701 [label="+5 Chemistry",color=orange];
		j1751117701 -> j2320359352;
	j3461875915 [label="+10 Chemistry",color=orange];
		j3461875915 -> j1842036712;
	j953993636 [label="+15 Chemistry",color=orange];
		j953993636 -> j119340446;
	j3942518832 [label="心を閉ざされたようだ。",shape=box,color=red];
		j3942518832 -> j3593442583;
	j1286977600 [label="できることならその重荷を軽くさせてあげたい。いい方法はない？",shape=box,color=red];
		j1286977600 -> j3593442583;
	j1131432654 [label="私たちの会話が興味心からくる探りでないことを願っています。",shape=box,color=blue];
		j1131432654 -> j3032006787;
		j1131432654 -> j3321659054;
	j2187828253 [label="Boolean MarieBeggar1 is now true.",color=orange];
		j2187828253 -> j3031263971;
	j2320359352 [label="狼のようだと言われている方が、私の前では実に礼儀正しいのですね。微笑ましい。それとなく、質問したい内容がわかるのですが…　もしかして、どうして路上で住んでいたのかとお尋ねになりたいのでしょうか。",shape=box,color=blue];
		j2320359352 -> j2773205535;
	j1842036712 [label="いつか、あなたの物語が書かれる日が来るかもしれません。なんて素敵な考えでしょう。私が書いてみるかもしれません。ガリア語で書こうかしら。Imaginez cela !",shape=box,color=blue];
		j1842036712 -> j1856685831;
	j119340446 [label="本当に理解できる立場にいらっしゃるのですね。私には、足がないのに空を飛ぶ力を与えられた少女「シスターMarie」以上の価値があると。そして、Lyonは沈黙の中で重荷を背負う「悲劇の司祭」以上であることも。",shape=box,color=blue];
		j119340446 -> j4176848803;
	j3593442583 [label="+10 Chemistry",color=orange];
		j3593442583 -> j423183310;
	j3032006787 [label="自分も「地元の名物」になることに慣れていたから、MarieとLyonの気持ちは良くわかる。でも興味本位で茶化しているだけではない。 ",shape=box,color=red];
		j3032006787 -> j3361468517;
	j3321659054 [label="いや、ただ気になっただけだ。正直なところ、Lyonのことが心配なんだ。自分の痛みを隠している彼が。",shape=box,color=red];
		j3321659054 -> j1162156636;
	j3031263971 [label="ご想像のとおり、la Cité de la Lumièreには、足の動かない私のような人間が行ける仕事も場所もほとんどありません。",shape=box,color=blue];
		j3031263971 -> j3423822341;
	j1856685831 [label="あまり夢を膨らまさない方が良いかもしれませんね。現実になってしまうので。Hah！　お別れの時間のようです、adieu。ササヤキはいつも邪魔ばかり。",shape=box,color=blue];
		j1856685831 -> "Chat ends.";
	j4176848803 [label="それだけを心に留めていただければ、きっと良いお友達になれると思います。あら、お別れの時間のようです、adieu。ササヤキはいつも邪魔ばかり。",shape=box,color=blue];
		j4176848803 -> "Chat ends.";
	j423183310 [label="もう少し時間を与えてあげてください。彼は…　最初は心の中をさらけ出すことはないでしょう。しかし、時が来れば、必ずあなたの元にやって来ます。あなたの善意はきっと伝わっているでしょう。また後ほどお話ししましょう、adieu。",shape=box,color=blue];
		j423183310 -> "Chat ends.";
	j3361468517 [label="Oui, そうでしょうね。時間をループさせて、新しい世界を召喚して時間旅行をこなせる方はさぞかし興味深い目で見られたのでは。ちょっとした魔法使いのような、non？",shape=box,color=blue];
		j3361468517 -> j1019087560;
		j3361468517 -> j2083404360;
	j1162156636 [label="+15 Chemistry",color=orange];
		j1162156636 -> j1569214450;
	j3423822341 [label="そうだから、Lyonとはすぐに家族になれたのだと思います。彼は一度も私を哀れむような目で見なかったし、私も彼を哀れむことはありませんでした。",shape=box,color=blue];
		j3423822341 -> j3981218846;
		j3423822341 -> j1266288868;
	j1569214450 [label="おっしゃる通り、Lyonは感情をさらけ出しません。周りの人を守るためにそうしているようです。あなたが真実を受け止められる、信頼ある方だと認められたとき、彼は心を開いてくれるでしょう。辛抱強く待ってあげてください。いつか心の内を打ち明けます。",shape=box,color=blue];
		j1569214450 -> j1157380864;
	j3981218846 [label="できるだけ早く、Lyonと打ち解けられるといいのだが。",shape=box,color=red];
		j3981218846 -> j3593442583;
	j1266288868 [label="二人が出会えたことは人生の宝物だ。人は一見しただけでは計り知れない。それぞれ、いろいろな個性を持ち合わせているから。",shape=box,color=red];
		j1266288868 -> j953993636;
	j1157380864 [label="Bah. お別れの時間のようです、adieu。ササヤキはいつも邪魔してくれます。",shape=box,color=blue];
		j1157380864 -> "Chat ends.";
}