		j1985950621 -> "Chat ends." [label=true,color=green];
		j1985950621 -> j1115389626 [label=false,color=brown];
	j1134465740 [label="Check boolean MariePolyamorySuccess",color=orange];
		j1134465740 -> j1985950621 [label=true,color=green];
		j1134465740 -> "Chat ends." [label=false,color=brown];
	j1115389626 [label="Mon cœur、少しだけお話しできますか？ ",shape=box,color=blue];
		j1115389626 -> j1831606295;
		j1115389626 -> j2431588260;
	j1831606295 [label="やあ、もちろん。元気にしてる？",shape=box,color=red];
		j1831606295 -> j1284737916;
	j2431588260 [label="[閉じる]",shape=box,color=red];
		j2431588260 -> j952339130;
	j1284737916 [label="申し上げたいのは…　漂流者様の心は他の誰かのものであると、存じております。お相手の方を知りませんが、嬉しく思っています。",shape=box,color=blue];
		j1284737916 -> j3142978840;
	j952339130 [label="Boolean MarieConsentComplete is now true.",color=orange];
		j952339130 -> "Chat ends.";
	j3142978840 [label="私は漂流者様を信頼しています。もし漂流者様の魂の中にその方の居場所があるのなら、私は分かち合えることを嬉しく思います。",shape=box,color=blue];
		j3142978840 -> j2692699876;
	j2692699876 [label="ただ、いつかその方に会えればと、ただ願っているのです、oui？　私の恋人の恋人は、私の恋人でもあるから…",shape=box,color=blue];
		j2692699876 -> j675644624;
	j675644624 [label="それだけです、もし、その方に興味がおありでしたら。",shape=box,color=blue];
		j675644624 -> j1032603486;
		j675644624 -> j3747680996;
		j675644624 -> j1394027995;
	j1032603486 [label="正直に言うと、Marieはタイプじゃないかも。",shape=box,color=red];
		j1032603486 -> j1106242189;
	j3747680996 [label="きっとMarieのことを大好きになるよ。自分みたいに。",shape=box,color=red];
		j3747680996 -> j2285436348;
	j1394027995 [label="耐えられないんじゃないかな。",shape=box,color=red];
		j1394027995 -> j2285436348;
	j1106242189 [label="Pff！　ひどいです、私の狼さん。夢を見るくらい良いでしょう？　それまでは、私には漂流者様がいますものね！",shape=box,color=blue];
		j1106242189 -> j2036357641;
	j2285436348 [label="それまでは、私には漂流者様がいますものね。そして、私と同じように漂流者様をお慕いする方たちと、あなたを分かち合えることを嬉しく思います。",shape=box,color=blue];
		j2285436348 -> j2036357641;
	j2036357641 [label="結局のところ、漂流者様が遊び回ってお楽しみになる間、誰かがササヤキに警戒していなければなりません。",shape=box,color=blue];
		j2036357641 -> j2507310729;
	j2507310729 [label="それでは行かなくては。À la revoyure！",shape=box,color=blue];
		j2507310729 -> j952339130;
}