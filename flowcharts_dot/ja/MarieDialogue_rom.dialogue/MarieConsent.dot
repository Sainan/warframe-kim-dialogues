	3578 [label="Mon cœur、少しだけお話しできますか？ ",shape=box,color=blue];
		3578 -> 3580;
		3578 -> 3579;
	3576 [label="Chat ends.",color=orange];
	3580 [label="やあ、もちろん。元気にしてる？",shape=box,color=red];
		3580 -> 3582;
	3579 [label="[閉じる]",shape=box,color=red];
		3579 -> 3581;
	3582 [label="申し上げたいのは…　漂流者様の心は他の誰かのものであると、存じております。お相手の方を知りませんが、嬉しく思っています。",shape=box,color=blue];
		3582 -> 3584;
	3581 [label="Update boolean MarieConsentComplete",color=orange];
		3581 -> 3583;
	3584 [label="私は漂流者様を信頼しています。もし漂流者様の魂の中にその方の居場所があるのなら、私は分かち合えることを嬉しく思います。",shape=box,color=blue];
		3584 -> 3585;
	3583 [label="Chat ends.",color=orange];
	3585 [label="ただ、いつかその方に会えればと、ただ願っているのです、oui？　私の恋人の恋人は、私の恋人でもあるから…",shape=box,color=blue];
		3585 -> 3586;
	3586 [label="それだけです、もし、その方に興味がおありでしたら。",shape=box,color=blue];
		3586 -> 3587;
		3586 -> 3588;
		3586 -> 3589;
	3587 [label="正直に言うと、Marieはタイプじゃないかも。",shape=box,color=red];
		3587 -> 3590;
	3588 [label="きっとMarieのことを大好きになるよ。自分みたいに。",shape=box,color=red];
		3588 -> 3591;
	3589 [label="耐えられないんじゃないかな。",shape=box,color=red];
		3589 -> 3591;
	3590 [label="Pff！　ひどいです、私の狼さん。夢を見るくらい良いでしょう？　それまでは、私には漂流者様がいますものね！",shape=box,color=blue];
		3590 -> 3592;
	3591 [label="それまでは、私には漂流者様がいますものね。そして、私と同じように漂流者様をお慕いする方たちと、あなたを分かち合えることを嬉しく思います。",shape=box,color=blue];
		3591 -> 3592;
	3592 [label="結局のところ、漂流者様が遊び回ってお楽しみになる間、誰かがササヤキに警戒していなければなりません。",shape=box,color=blue];
		3592 -> 3593;
	3593 [label="それでは行かなくては。À la revoyure！",shape=box,color=blue];
		3593 -> 3594;
	3594 [label="Update boolean MarieConsentComplete",color=orange];
		3594 -> 3595;
	3595 [label="Chat ends.",color=orange];
