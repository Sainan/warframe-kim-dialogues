	1421 [label="全力を尽くすよ。",shape=box,color=red];
		1421 -> 1424;
	1422 [label="[閉じる]",shape=box,color=red];
		1422 -> 1425;
	1423 [label="私のことも、私が書こうとしていることも知らないのに、Vraiment gentil - とっても優しい…　感謝します。",shape=box,color=blue];
		1423 -> 1426;
	1424 [label="+10 Chemistry",color=orange];
		1424 -> 1427;
	1425 [label="Chat ends.",color=orange];
	1426 [label="でも…　頭の大きなおしゃべり魚も、あなたにとって頭痛の種ですか？　Fibonacci？",shape=box,color=blue];
		1426 -> 1428;
		1426 -> 1429;
		1426 -> 1430;
	1427 [label="感謝いたします、ありがとうございます。",shape=box,color=blue];
		1427 -> 1426;
	1428 [label="全くその通り。ありがとう。",shape=box,color=red];
		1428 -> 1431;
	1429 [label="MarieがFibonacciにイライラしてるなんて、信じられないほど愛らしいな。",shape=box,color=red];
		1429 -> 1432;
	1430 [label="そんなことない。Fibonacciのことは大好きだよ。",shape=box,color=red];
		1430 -> 1433;
	1431 [label="私だけじゃなくて安心しました。もちろん、Fibonacci様を侮辱するつもりはありません。今の私の状況は居心地が悪いのですが、Fibonacci様も彼の状況に耐えているのでしょうね。",shape=box,color=blue];
		1431 -> 1434;
	1432 [label="ああ？　どうして？　嬉しいですが、理由がわかりません。私のイライラは面白いかしら。",shape=box,color=blue];
		1432 -> 1435;
		1432 -> 1436;
	1433 [label="どうかお許しください。彼を侮辱するつもりは全くないのです。今の私の状況は居心地が悪いのですが、Fibonacci様も彼の状況に耐えているのでしょうね。",shape=box,color=blue];
		1433 -> 1437;
	1434 [label="ただ、彼の話が長いので、私の性に合わないのです。　C'est tout.",shape=box,color=blue];
		1434 -> 1438;
	1435 [label="自分は人生の大半を生きるために戦って過ごしてきた。だから、ちょっとした人間らしさに触れる瞬間って…　興味をそそられる。",shape=box,color=red];
		1435 -> 1439;
	1436 [label="時々、一歩下がって、この不条理について考えてみることも必要かもしれない。ノルグとソルの修道女さん…",shape=box,color=red];
		1436 -> 1440;
	1437 [label="ただ、彼の話が長いので、私の性に合わないのです。",shape=box,color=blue];
		1437 -> 1441;
	1438 [label="ふん。文句を言うべきではありませんね。今夜はLyonに夕食を持って行かなくてはなりません。またひどいmegrimで寝込んでいるのです。",shape=box,color=blue];
		1438 -> 1442;
		1438 -> 1443;
	1439 [label="+5 Chemistry",color=orange];
		1439 -> 1444;
	1440 [label="+5 Chemistry",color=orange];
		1440 -> 1445;
	1441 [label="ふん。文句を言うべきではありませんね。今夜はLyonに夕食を持って行かなくてはなりません。またひどいmegrimで寝込んでいるのです。",shape=box,color=blue];
		1441 -> 1442;
		1441 -> 1443;
	1442 [label="Lyonは、よくmegrimで寝込むのか？",shape=box,color=red];
		1442 -> 1446;
	1443 [label="どういうこと？",shape=box,color=red];
		1443 -> 1447;
	1444 [label="漂流者様、変わらないでください。生命の輝きを求めるその気性を決して手放さないでくださいね。",shape=box,color=blue];
		1444 -> 1448;
	1445 [label="まあ、そう言われてみれば、そうなのでしょうね。まるで子供っぽい冗談ね。N'est-ce pas？",shape=box,color=blue];
		1445 -> 1449;
	1446 [label="Oui, oui. 　数週間に一度か、数か月に一度くらいかしら。彼がmegrimなしに過ごせた最長期間は、おそらく半年くらいでしょう。",shape=box,color=blue];
		1446 -> 1450;
	1447 [label="ああ！　大変なのです。ええ。頭痛のようで、もっとひどいものです。胆汁性頭痛とも呼ばれています。女性に多く見られるそうです。",shape=box,color=blue];
		1447 -> 1451;
		1447 -> 1452;
	1448 [label="この世はより暗く深刻な場所になろうとしていて、あらゆる方法で私たちに苦しみを強いているように感じませんか。",shape=box,color=blue];
		1448 -> 1453;
	1449 [label="未来から送られた修道女、司祭、悪魔が過去へ送られ...　その後 futur へ送られ...　魚や、鹿のような生き物、巨大な鳥、そして執事と出会うのです...",shape=box,color=blue];
		1449 -> 1454;
	1450 [label="Check boolean Megrim",color=orange];
		1450 -> 1455 [label=true,color=green];
		1450 -> 1456 [label=true,color=green];
		1450 -> 1458 [label=true,color=green];
		1450 -> 1455 [label=false,color=brown];
		1450 -> 1456 [label=false,color=brown];
		1450 -> 1457 [label=false,color=brown];
	1451 [label="今の言葉では、「片頭痛」って呼ばれているんだ。",shape=box,color=red];
		1451 -> 1459;
	1452 [label="へー。Megrimsって呼ばれているんだ。わかったよ。",shape=box,color=red];
		1452 -> 1460;
	1453 [label="そんな世の中では、たとえ大人げなくても、できる限りの明るさや、軽快さを追求すべきだと思いませんか。",shape=box,color=blue];
		1453 -> 1461;
	1454 [label="とっても面白いですね、まさにその通り！",shape=box,color=blue];
		1454 -> 1462;
	1455 [label="原因は何だろう。",shape=box,color=red];
		1455 -> 1463;
	1456 [label="それはひどい...",shape=box,color=red];
		1456 -> 1464;
	1458 [label="自分もmegrimsに悩まされることがある。本当にひどい。",shape=box,color=red];
		1458 -> 1465;
	1457 [label="自分にも同じような頭痛が起こることがあるけど、最低の気分になる。",shape=box,color=red];
		1457 -> 1465;
	1459 [label="他にも歴史的particularitésを発見できるのでしょうか。新しいことを学ぶのって、とても楽しいことです。「片頭痛」ね。文明の進歩は素晴らしいです。",shape=box,color=blue];
		1459 -> 1466;
