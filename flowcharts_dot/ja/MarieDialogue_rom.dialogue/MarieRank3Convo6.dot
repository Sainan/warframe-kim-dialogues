	"MarieRank3Convo6 begins." [color=orange];
		"MarieRank3Convo6 begins." -> j3004716418;
	j3004716418 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3004716418 -> j599409398;
	j599409398 [label="あなたに質問があるのですが、馬鹿にしないってお約束いただけますか、漂流者様。",shape=box,color=blue];
		j599409398 -> j985090356;
		j599409398 -> j1918207589;
		j599409398 -> j738393015;
	j985090356 [label="奇妙な状況に放り込まれたね。もちろん、非難なんてしないよ。",shape=box,color=red];
		j985090356 -> j3101574033;
	j1918207589 [label="全力を尽くすよ。",shape=box,color=red];
		j1918207589 -> j1326998365;
	j738393015 [label="[閉じる]",shape=box,color=red];
		j738393015 -> "Chat ends.";
	j3101574033 [label="私のことも、私が書こうとしていることも知らないのに、Vraiment gentil - とっても優しい…　感謝します。",shape=box,color=blue];
		j3101574033 -> j74387185;
	j1326998365 [label="+10 Chemistry",color=orange];
		j1326998365 -> j4099807908;
	"Chat ends." [color=orange];
	j74387185 [label="でも…　頭の大きなおしゃべり魚も、あなたにとって頭痛の種ですか？　Fibonacci？",shape=box,color=blue];
		j74387185 -> j4137332589;
		j74387185 -> j950963471;
		j74387185 -> j4052831724;
	j4099807908 [label="感謝いたします、ありがとうございます。",shape=box,color=blue];
		j4099807908 -> j74387185;
	j4137332589 [label="全くその通り。ありがとう。",shape=box,color=red];
		j4137332589 -> j2408824157;
	j950963471 [label="MarieがFibonacciにイライラしてるなんて、信じられないほど愛らしいな。",shape=box,color=red];
		j950963471 -> j2825698895;
	j4052831724 [label="そんなことない。Fibonacciのことは大好きだよ。",shape=box,color=red];
		j4052831724 -> j4250570605;
	j2408824157 [label="私だけじゃなくて安心しました。もちろん、Fibonacci様を侮辱するつもりはありません。今の私の状況は居心地が悪いのですが、Fibonacci様も彼の状況に耐えているのでしょうね。",shape=box,color=blue];
		j2408824157 -> j2534513186;
	j2825698895 [label="ああ？　どうして？　嬉しいですが、理由がわかりません。私のイライラは面白いかしら。",shape=box,color=blue];
		j2825698895 -> j3592163855;
		j2825698895 -> j1006652378;
	j4250570605 [label="どうかお許しください。彼を侮辱するつもりは全くないのです。今の私の状況は居心地が悪いのですが、Fibonacci様も彼の状況に耐えているのでしょうね。",shape=box,color=blue];
		j4250570605 -> j2749458786;
	j2534513186 [label="ただ、彼の話が長いので、私の性に合わないのです。　C'est tout.",shape=box,color=blue];
		j2534513186 -> j2974232279;
	j3592163855 [label="自分は人生の大半を生きるために戦って過ごしてきた。だから、ちょっとした人間らしさに触れる瞬間って…　興味をそそられる。",shape=box,color=red];
		j3592163855 -> j256710128;
	j1006652378 [label="時々、一歩下がって、この不条理について考えてみることも必要かもしれない。ノルグとソルの修道女さん…",shape=box,color=red];
		j1006652378 -> j348097512;
	j2749458786 [label="ただ、彼の話が長いので、私の性に合わないのです。",shape=box,color=blue];
		j2749458786 -> j2974232279;
	j2974232279 [label="ふん。文句を言うべきではありませんね。今夜はLyonに夕食を持って行かなくてはなりません。またひどいmegrimで寝込んでいるのです。",shape=box,color=blue];
		j2974232279 -> j2057590716;
		j2974232279 -> j2114736463;
	j256710128 [label="+5 Chemistry",color=orange];
		j256710128 -> j2361585591;
	j348097512 [label="+5 Chemistry",color=orange];
		j348097512 -> j2331636827;
	j2057590716 [label="Lyonは、よくmegrimで寝込むのか？",shape=box,color=red];
		j2057590716 -> j1584690685;
	j2114736463 [label="どういうこと？",shape=box,color=red];
		j2114736463 -> j1641554475;
	j2361585591 [label="漂流者様、変わらないでください。生命の輝きを求めるその気性を決して手放さないでくださいね。",shape=box,color=blue];
		j2361585591 -> j1071962204;
	j2331636827 [label="まあ、そう言われてみれば、そうなのでしょうね。まるで子供っぽい冗談ね。N'est-ce pas？",shape=box,color=blue];
		j2331636827 -> j2948142209;
	j1584690685 [label="Oui, oui. 　数週間に一度か、数か月に一度くらいかしら。彼がmegrimなしに過ごせた最長期間は、おそらく半年くらいでしょう。",shape=box,color=blue];
		j1584690685 -> j547018639;
	j1641554475 [label="ああ！　大変なのです。ええ。頭痛のようで、もっとひどいものです。胆汁性頭痛とも呼ばれています。女性に多く見られるそうです。",shape=box,color=blue];
		j1641554475 -> j2653463588;
		j1641554475 -> j4253055285;
	j1071962204 [label="この世はより暗く深刻な場所になろうとしていて、あらゆる方法で私たちに苦しみを強いているように感じませんか。",shape=box,color=blue];
		j1071962204 -> j925721572;
	j2948142209 [label="未来から送られた修道女、司祭、悪魔が過去へ送られ...　その後 futur へ送られ...　魚や、鹿のような生き物、巨大な鳥、そして執事と出会うのです...",shape=box,color=blue];
		j2948142209 -> j2175800934;
	j547018639 [label="Check boolean Megrim",color=orange];
		j547018639 -> j2659147777 [label=true,color=green];
		j547018639 -> j3223790679 [label=true,color=green];
		j547018639 -> j3550852951 [label=true,color=green];
		j547018639 -> j2659147777 [label=false,color=brown];
		j547018639 -> j3223790679 [label=false,color=brown];
		j547018639 -> j3291513253 [label=false,color=brown];
	j2653463588 [label="今の言葉では、「片頭痛」って呼ばれているんだ。",shape=box,color=red];
		j2653463588 -> j2932555739;
	j4253055285 [label="へー。Megrimsって呼ばれているんだ。わかったよ。",shape=box,color=red];
		j4253055285 -> j956160475;
	j925721572 [label="そんな世の中では、たとえ大人げなくても、できる限りの明るさや、軽快さを追求すべきだと思いませんか。",shape=box,color=blue];
		j925721572 -> j3388591279;
	j2175800934 [label="とっても面白いですね、まさにその通り！",shape=box,color=blue];
		j2175800934 -> j3517167823;
	j2659147777 [label="原因は何だろう。",shape=box,color=red];
		j2659147777 -> j2432035868;
	j3223790679 [label="それはひどい...",shape=box,color=red];
		j3223790679 -> j1805249446;
	j3550852951 [label="自分もmegrimsに悩まされることがある。本当にひどい。",shape=box,color=red];
		j3550852951 -> j1827695246;
	j3291513253 [label="自分にも同じような頭痛が起こることがあるけど、最低の気分になる。",shape=box,color=red];
		j3291513253 -> j1827695246;
	j2932555739 [label="他にも歴史的particularitésを発見できるのでしょうか。新しいことを学ぶのって、とても楽しいことです。「片頭痛」ね。文明の進歩は素晴らしいです。",shape=box,color=blue];
		j2932555739 -> j3128411258;
	j956160475 [label="Boolean Megrim is now true.",color=orange];
		j956160475 -> j869301410;
	j3388591279 [label="Lyonも同じように考えてくれればいいのですが。",shape=box,color=blue];
		j3388591279 -> j742094531;
	j3517167823 [label="愛しいLyonも同じようにその輝きに気付いてくれるといいのですが。",shape=box,color=blue];
		j3517167823 -> j742094531;
	j2432035868 [label="Lyonには持論があるようです。 ",shape=box,color=blue];
		j2432035868 -> j2045033788;
	j1805249446 [label="あなたがお見舞いの気持ちを表したなら、Lyonは嬉しいでしょう。顔に出さなくても、内心は喜ぶに違いありません。",shape=box,color=blue];
		j1805249446 -> j310462958;
	j1827695246 [label="そうなのですね。どうぞLyonにも知らせてあげてください。苦しみを分かち合えるのは、心強いでしょうから。",shape=box,color=blue];
		j1827695246 -> j1735676213;
	j3128411258 [label="Boolean Migraine is now true.",color=orange];
		j3128411258 -> j869301410;
	j869301410 [label="病名はともかく、哀れなことにLyonは朝までずっと伏せたままなのです。視界が不明瞭で、手足の感覚もなく、耐え難い痛みだと申しております。",shape=box,color=blue];
		j869301410 -> j547018639;
	j742094531 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j742094531 -> j647369219;
	j2045033788 [label="最近まで独自の理論を持っていた、と言った方が正確かもしれません。",shape=box,color=blue];
		j2045033788 -> j20751244;
	j310462958 [label="Lyonの態度が悪いと感じても、どうか耐えてみてください、漂流者様。一見冷淡で無表情に見えても、その裏には、深い苦悩が潜んでいるのですから。",shape=box,color=blue];
		j310462958 -> j3197823568;
		j310462958 -> j2949398926;
		j310462958 -> j1913042138;
	j1735676213 [label="+5 Chemistry",color=orange];
		j1735676213 -> j104450095;
	j647369219 [label="ああ、頭痛を訴えている場合ではないのです。今夜はLyonに夕食を持って行かなくてはなりません。またひどいmegrimで寝込んでいるのです。",shape=box,color=blue];
		j647369219 -> j2114736463;
		j647369219 -> j2057590716;
	j20751244 [label="Boolean MarieLyonFaith1 is now true.",color=orange];
		j20751244 -> j310462958;
	j3197823568 [label="自分が頑固なだけ。心配しないで。",shape=box,color=red];
		j3197823568 -> j1880142082;
	j2949398926 [label="壁の中のモノは1人...　2人じゃないよ？",shape=box,color=red];
		j2949398926 -> j217028463;
	j1913042138 [label="Lyonはいい大人なんだから、話したいんだったら自分から話すだろう。",shape=box,color=red];
		j1913042138 -> j2219135971;
	j104450095 [label="ルミナリーズは、Lyonが一人で苦しむだろうと思っているのです...",shape=box,color=blue];
		j104450095 -> j4277240003;
	j1880142082 [label="+5 Chemistry",color=orange];
		j1880142082 -> j3684730333;
	j217028463 [label="私は構いませんが、Lyonへはそのような冗談は言わないでくださいね。彼は、あなたの Indifférence に心を痛めているのです。",shape=box,color=blue];
		j217028463 -> j2992798303;
	j2219135971 [label="ええ、確かにLyonは大人の男性です。そして、彼は話したいと思っているでしょう。話したくても話せない状況もあるのです。",shape=box,color=blue];
		j2219135971 -> j2477178750;
	j4277240003 [label="Boolean MarieLyonSuffering2 is now true.",color=orange];
		j4277240003 -> j310462958;
	j3684730333 [label="あなたも彼と一緒にいる必要があるかもしれません。感謝いたします、漂流者様。Lyonは私の最愛の友であり、魂の兄弟なのです。彼が苦しんでいる様子を見ると、胸が張り裂ける思いがいたします。",shape=box,color=blue];
		j3684730333 -> j455552641;
	j2992798303 [label="強く、忍耐強く、優しくしてくださいね、漂流者様。Lyonは私の最愛の友であり、魂の兄弟なのです。彼が苦しんでいる様子を見ると、胸が張り裂ける思いがいたします。",shape=box,color=blue];
		j2992798303 -> j455552641;
	j2477178750 [label="誰もが才能に恵まれているわけではありません。そして、自分が特別だと感じているわけでもありません。Lyonは苦しみを抱えており、それこそが自分の運命だと信じているのです。",shape=box,color=blue];
		j2477178750 -> j1708745399;
	j455552641 [label="またお話ししましょう。　Par la grâce de Sol.",shape=box,color=blue];
		j455552641 -> "Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j1708745399 [label="Lyonは私の最愛の友であり、魂の兄弟なのです。彼が苦しんでいる様子を見ると、胸が張り裂ける思いがいたします。ですから、あなたにお願いできることがあるとすれば、ただ可能な限りLyonに優しく、辛抱強く接してあげて欲しいのです。",shape=box,color=blue];
		j1708745399 -> j455552641;
	"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
