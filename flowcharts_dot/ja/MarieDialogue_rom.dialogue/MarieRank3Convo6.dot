	1471 [label="+5 Chemistry",color=orange];
		1471 -> 1477;
	1472 [label="ああ、頭痛を訴えている場合ではないのです。今夜はLyonに夕食を持って行かなくてはなりません。またひどいmegrimで寝込んでいるのです。",shape=box,color=blue];
		1472 -> 1443;
		1472 -> 1442;
	1473 [label="Update boolean MarieLyonFaith1",color=orange];
		1473 -> 1470;
	1474 [label="自分が頑固なだけ。心配しないで。",shape=box,color=red];
		1474 -> 1478;
	1475 [label="壁の中のモノは1人...　2人じゃないよ？",shape=box,color=red];
		1475 -> 1479;
	1476 [label="Lyonはいい大人なんだから、話したいんだったら自分から話すだろう。",shape=box,color=red];
		1476 -> 1480;
	1477 [label="ルミナリーズは、Lyonが一人で苦しむだろうと思っているのです...",shape=box,color=blue];
		1477 -> 1481;
	1478 [label="+5 Chemistry",color=orange];
		1478 -> 1482;
	1479 [label="私は構いませんが、Lyonへはそのような冗談は言わないでくださいね。彼は、あなたの Indifférence に心を痛めているのです。",shape=box,color=blue];
		1479 -> 1483;
	1480 [label="ええ、確かにLyonは大人の男性です。そして、彼は話したいと思っているでしょう。話したくても話せない状況もあるのです。",shape=box,color=blue];
		1480 -> 1484;
	1481 [label="Update boolean MarieLyonSuffering2",color=orange];
		1481 -> 1470;
	1482 [label="あなたも彼と一緒にいる必要があるかもしれません。感謝いたします、漂流者様。Lyonは私の最愛の友であり、魂の兄弟なのです。彼が苦しんでいる様子を見ると、胸が張り裂ける思いがいたします。",shape=box,color=blue];
		1482 -> 1485;
	1483 [label="強く、忍耐強く、優しくしてくださいね、漂流者様。Lyonは私の最愛の友であり、魂の兄弟なのです。彼が苦しんでいる様子を見ると、胸が張り裂ける思いがいたします。",shape=box,color=blue];
		1483 -> 1485;
	1484 [label="誰もが才能に恵まれているわけではありません。そして、自分が特別だと感じているわけでもありません。Lyonは苦しみを抱えており、それこそが自分の運命だと信じているのです。",shape=box,color=blue];
		1484 -> 1486;
	1485 [label="またお話ししましょう。　Par la grâce de Sol.",shape=box,color=blue];
		1485 -> 3734;
	1486 [label="Lyonは私の最愛の友であり、魂の兄弟なのです。彼が苦しんでいる様子を見ると、胸が張り裂ける思いがいたします。ですから、あなたにお願いできることがあるとすれば、ただ可能な限りLyonに優しく、辛抱強く接してあげて欲しいのです。",shape=box,color=blue];
		1486 -> 1485;
