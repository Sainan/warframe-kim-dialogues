	1462 [label="愛しいLyonも同じようにその輝きに気付いてくれるといいのですが。",shape=box,color=blue];
		1462 -> 1468;
	1463 [label="Lyonには持論があるようです。 ",shape=box,color=blue];
		1463 -> 1469;
	1464 [label="あなたがお見舞いの気持ちを表したなら、Lyonは嬉しいでしょう。顔に出さなくても、内心は喜ぶに違いありません。",shape=box,color=blue];
		1464 -> 1470;
	1465 [label="そうなのですね。どうぞLyonにも知らせてあげてください。苦しみを分かち合えるのは、心強いでしょうから。",shape=box,color=blue];
		1465 -> 1471;
	1466 [label="Update boolean Migraine",color=orange];
		1466 -> 1467;
	1467 [label="病名はともかく、哀れなことにLyonは朝までずっと伏せたままなのです。視界が不明瞭で、手足の感覚もなく、耐え難い痛みだと申しております。",shape=box,color=blue];
		1467 -> 1450;
	1468 [label="Update boolean MarieLyonSuffering1",color=orange];
		1468 -> 1472;
	1469 [label="最近まで独自の理論を持っていた、と言った方が正確かもしれません。",shape=box,color=blue];
		1469 -> 1473;
	1470 [label="Lyonの態度が悪いと感じても、どうか耐えてみてください、漂流者様。一見冷淡で無表情に見えても、その裏には、深い苦悩が潜んでいるのですから。",shape=box,color=blue];
		1470 -> 1474;
		1470 -> 1475;
