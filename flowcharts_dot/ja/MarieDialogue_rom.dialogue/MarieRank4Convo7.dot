	"MarieRank4Convo7 begins." [color=orange];
		"MarieRank4Convo7 begins." -> j2946575423;
	j2946575423 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j2946575423 -> j3255816954;
	j3255816954 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j3255816954 -> j408202037 [label="x >= 0",color=purple];
		j3255816954 -> "Chat ends." [label="x <= 0",color=purple];
		j3255816954 -> "Chat ends." [label="false",color=purple];
	j408202037 [label="excusez-moi...　漂流者様。悪魔を助けるなんて、本気で思っておられるのですか？",shape=box,color=blue];
		j408202037 -> j3733522886;
	"Chat ends." [color=orange];
	j3733522886 [label="赦免や援助を求める人々を拒むつもりはありません。ただ...　悪魔はどちらも求めていないでしょう。",shape=box,color=blue];
		j3733522886 -> j3542165262;
		j3733522886 -> j3515306307;
		j3733522886 -> j2712745643;
		j3733522886 -> j738393015;
	j3542165262 [label="じゃあ、悪魔が求めているのは何なんだ？",shape=box,color=red];
		j3542165262 -> j2268879921;
	j3515306307 [label="Marieと悪魔が相容れない関係なのは分かっている。でも、悪魔を追い出すなんて無理だ。",shape=box,color=red];
		j3515306307 -> j3264434889;
	j2712745643 [label="Roatheはオロキンについて、多くのことを忘れた。文字通りな。でも、Roatheが必要なんだ。",shape=box,color=red];
		j2712745643 -> j4090621014;
	j738393015 [label="[閉じる]",shape=box,color=red];
		j738393015 -> "Chat ends.";
	j2268879921 [label="彼はどう猛なのです。食べ物や暖かい場所を与えれば近づいてくるかもしれません。けれど、あなたがお役ごめんになれば、すべてが無に帰するでしょう。",shape=box,color=blue];
		j2268879921 -> j683102736;
	j3264434889 [label="Add 1 to Thermostat counter",color=orange];
		j3264434889 -> j1745884213;
	j4090621014 [label="Add -1 to Thermostat counter",color=orange];
		j4090621014 -> j2268879921;
	j683102736 [label="彼はあなたや私たちから何かを必要としています。 ",shape=box,color=blue];
		j683102736 -> j863296879;
	j1745884213 [label="Non、　追い出して欲しい訳ではございません。ただ…　彼は信用ならないのです。今も、そしてこれからも。",shape=box,color=blue];
		j1745884213 -> j2268879921;
	j863296879 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j863296879 -> j4093421340 [label="x > 5",color=purple];
		j863296879 -> j678583583 [label="x <= 5",color=purple];
		j863296879 -> j678583583 [label="false",color=purple];
	j4093421340 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4093421340 -> j1890197961 [label="x >= 21",color=purple];
		j4093421340 -> j686098215 [label="x < 21",color=purple];
		j4093421340 -> j686098215 [label="false",color=purple];
	j678583583 [label="彼の失われた記憶、Tauの過去の恐怖…　何の前兆なのでしょうか。",shape=box,color=blue];
		j678583583 -> j190028384;
		j678583583 -> j1998632874;
	j1890197961 [label="彼の壊れた心の中から、必要なことはすべて理解できたと思っているのでしょう？",shape=box,color=blue];
		j1890197961 -> j3404719656;
		j1890197961 -> j1998632874;
	j686098215 [label="彼の打ち砕かれた精神を深く知っていくほど、私はますます不安になるのです。ますます危険を感じるのです。",shape=box,color=blue];
		j686098215 -> j1998632874;
		j686098215 -> j190028384;
	j190028384 [label="彼の記憶が戻ればすぐに去るとは思えない。もっと何かがあるはずだ。",shape=box,color=red];
		j190028384 -> j29619979;
	j1998632874 [label="彼は他にもまだ何か求めているに違いない。記憶の中だけじゃなく、我々から。",shape=box,color=red];
		j1998632874 -> j3700666473;
	j3404719656 [label="Roatheがこれで終わりと言うのなら、信じるよ。でもそれが本当なら、なぜ彼はまだここにいるんだろう？",shape=box,color=red];
		j3404719656 -> j29619979;
	j29619979 [label="認めます。私が心配しているのは、知識そのものよりも、彼が知識を使って何をしでかすのかということなのです。",shape=box,color=blue];
		j29619979 -> j2639339337;
	j3700666473 [label="Oui！　それこそが私が心配していることなのです。でも、一体何なのでしょう？一体何のために私たちは彼に仕えているのでしょう？",shape=box,color=blue];
		j3700666473 -> j2639339337;
	j2639339337 [label="この新たな存在を彼がどのように利用するつもりか分かりません。ただ、巻き込まれたくないのです。彼が善意を持っていると鵜呑みにしないよう、用心しておきたいのです。",shape=box,color=blue];
		j2639339337 -> j1869823121;
		j2639339337 -> j4207341102;
		j2639339337 -> j3565058485;
	j1869823121 [label="ああ、彼は信用ならない。同感だ。",shape=box,color=red];
		j1869823121 -> j1809299319;
	j4207341102 [label="彼は強くて聡明です。彼のような人物が味方だったら、どんなに心丈夫でしょう。",shape=box,color=red];
		j4207341102 -> j3804011702;
	j3565058485 [label="裏切られるかどうか心配しても無駄だ。実際にそうなった訳じゃない。未遂の状態で、彼を罪人扱いできないだろう。",shape=box,color=red];
		j3565058485 -> j4290325904;
	j1809299319 [label="+20 Chemistry",color=orange];
		j1809299319 -> j1504182367;
	j3804011702 [label="Add -1 to Thermostat counter",color=orange];
		j3804011702 -> j4279735284;
	j4290325904 [label="Add 1 to Thermostat counter",color=orange];
		j4290325904 -> j4009071996;
	j1504182367 [label="Bien！　漂流者様もあの悪魔に注意を払っていただけるなら安心です。いくらか穏やかに休めます。Merci.",shape=box,color=blue];
		j1504182367 -> j3984234322;
	j4279735284 [label="Oui、でも、その同盟の代償は何でしょう。漂流者様が望むことではないかもしれません。",shape=box,color=blue];
		j4279735284 -> j1043173644;
	j4009071996 [label="Oui...　おっしゃる通り、陰に飛びつくわけには参りませんね。無関心のモノを倒せるよう、肩を並べて立ち向かわなければ。",shape=box,color=blue];
		j4009071996 -> j808986917;
	j3984234322 [label="Boolean MarieRoatheNoTrust is now true.",color=orange];
		j3984234322 -> "Chat ends.";
	j1043173644 [label="ただ、漂流者様にご用心いただきたいのです…　彼は紳士の皮を被った化け物です。お気をつけください。s'il te plaît ？",shape=box,color=blue];
		j1043173644 -> j1583574306;
		j1043173644 -> j134885392;
	j808986917 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j808986917 -> j3593550002 [label=true,color=green];
		j808986917 -> j3593550002 [label=false,color=brown];
	j1583574306 [label="彼に対して少し勘ぐりすぎじゃないか。",shape=box,color=red];
		j1583574306 -> j2460928534;
	j134885392 [label="気をつける。約束するよ。",shape=box,color=red];
		j134885392 -> j1118715880;
	j3593550002 [label="神から生まれたにせよ、私たち自身の心から生まれたにせよ、背後にある力は依然として脅威なのですから。",shape=box,color=blue];
		j3593550002 -> j1043173644;
	j2460928534 [label="Add -1 to Thermostat counter",color=orange];
		j2460928534 -> j820962158;
	j1118715880 [label="+20 Chemistry",color=orange];
		j1118715880 -> j2819753364;
	j820962158 [label="Oui？　どうしてですか？　純粋に興味があるのです。無慈悲なわけではございません。",shape=box,color=blue];
		j820962158 -> j669188843;
		j820962158 -> j103930718;
		j820962158 -> j4253995990;
		j820962158 -> j2801015975;
	j2819753364 [label="Merci.　これ以上望むものはございません。",shape=box,color=blue];
		j2819753364 -> "Chat ends.";
	j669188843 [label="彼は異なる社会、時代、期待の中で育った。自分たちがどう思おうと、彼は彼なんだ。",shape=box,color=red];
		j669188843 -> j140913141;
	j103930718 [label="MarieとLyonはEntratiからPROTOFRAMEの血清を受け取った。自発的に。Roatheは拒否した。それがどんな感じか想像できる？",shape=box,color=red];
		j103930718 -> j1548601064;
		j103930718 -> j3765823040;
		j103930718 -> j140913141;
	j4253995990 [label="彼は何世紀にもわたって、彼自身が必要だと信じる道を生きてきたんだ。ただ、その内容に我々が賛成できないだけ。",shape=box,color=red];
		j4253995990 -> j1548601064;
		j4253995990 -> j3388105057;
	j2801015975 [label="Marieが怒っているのは...　彼の行動ではなく、彼の態度に対してじゃないか。",shape=box,color=red];
		j2801015975 -> j3388105057;
		j2801015975 -> j1548601064;
	j140913141 [label="彼は上級軍人であり、社交界の名士でもある。どちの側面も、時に秘密裏の決断を必要とする。",shape=box,color=red];
		j140913141 -> j681163897;
	j1548601064 [label="人は善意のためなら「間違っている」と感じることでも行うことがある。",shape=box,color=red];
		j1548601064 -> j1141484653;
	j3765823040 [label="オロキン帝国を救うため彼は全力を尽くした。その結果、この混乱に巻き込まれてしまった。",shape=box,color=red];
		j3765823040 -> j681163897;
	j3388105057 [label="Marieが気に食わないのは、彼が自分の成し遂げたことに誇りを持っているからだろ。",shape=box,color=red];
		j3388105057 -> j492200641;
	j681163897 [label="Check boolean MarieGrineer",color=orange];
		j681163897 -> j1134812388 [label=true,color=green];
		j681163897 -> j502210892 [label=false,color=brown];
	j1141484653 [label="Marieは彼を悪魔だと思っているかもしれないが、彼は全くそう思っていない。",shape=box,color=red];
		j1141484653 -> j681163897;
	j492200641 [label="Oui, 死を謳歌する人など、好きになれるはずがありません。血を流すことに熱意を燃やす彼には不安を覚えます。そして、あなたがそれを不安に感じないという事実にも。",shape=box,color=blue];
		j492200641 -> j1885110759;
	j1134812388 [label="そして、あなたが戦う「コーパス」や「グリニア」の指揮官たちも同じように言うのでしょうね。自分が正しいと思い込んでいるのです。",shape=box,color=blue];
		j1134812388 -> j1583095449;
	j502210892 [label="そして、あなたが戦う「コーパス」や「ぐりにや」の指揮官たちも同じように言うのでしょうね。自分が正しいと思い込んでいるのです。",shape=box,color=blue];
		j502210892 -> j1583095449;
	j1885110759 [label="暴力行為と自己犠牲を取り違え、その恐ろしさに目もくれず、「重要なこと」のために軽視するのは、あまりにも短絡的です。",shape=box,color=blue];
		j1885110759 -> j649626924;
	j1583095449 [label="彼らは自分たちの行いこそが正義、善、必要だと妄信しているのです。どうして一部の悪魔は容認され、別の悪魔は容認されないのでしょう？",shape=box,color=blue];
		j1583095449 -> j264629477;
		j1583095449 -> j2385194585;
		j1583095449 -> j615078356;
		j1583095449 -> j3974866892;
	j649626924 [label="行為そのものに誇りを持つというのは…　私にはできません。彼とは違って、私は命を奪うことに喜びなど感じません。そういう意味で、私たちは全く違います。",shape=box,color=blue];
		j649626924 -> j107221214;
	j264629477 [label="彼らが支持できない行為に及ぶなら、止めようと努力する。でも…　必要ならば、彼らと共に戦うだろう。",shape=box,color=red];
		j264629477 -> j4221646617;
	j2385194585 [label="定義上の「善」や「悪」かは、行動によってのみ決まるだろう。",shape=box,color=red];
		j2385194585 -> j3613040645;
	j615078356 [label="行動の善悪を裁く立場にいない。自分はただ守るべき人々を守るために戦うんだ。",shape=box,color=red];
		j615078356 -> j4221646617;
	j3974866892 [label="Marieは、個人を裁く基準で、集団全体を裁いてほしいんだな。",shape=box,color=red];
		j3974866892 -> j3613040645;
	j107221214 [label="悪魔が肋骨を突き刺そうとしても、漂流者様が助かることを祈るばかりです。漂流者様が「Marieが警告してくれたのに」と思いながら最期を迎えるなど耐えられません。",shape=box,color=blue];
		j107221214 -> j3969411692;
		j107221214 -> j3301854202;
	j4221646617 [label="悪魔が脅威ではないと？　周囲の人々にとってdangereuxではないと信じているのですか？　甚大な被害を及ぼすかもしれませんよ。",shape=box,color=blue];
		j4221646617 -> j2894264485;
		j4221646617 -> j4289514129;
	j3613040645 [label="では、彼が犯した悪行はどうでしょう？　数々の死、数々の虐殺、漂流者様にとっても理にかなった振る舞いなのですか？",shape=box,color=blue];
		j3613040645 -> j4289514129;
	j3969411692 [label="彼はそんなことしない。もしそうなっても止めてみせるよ。",shape=box,color=red];
		j3969411692 -> j1055880311;
	j3301854202 [label="最期を迎える時にそんなこと考えないよ。",shape=box,color=red];
		j3301854202 -> j2491667859;
	j2894264485 [label="もし彼が反旗を翻すなら、こちらも行動を起こす。それまでは、無実が証明されている…　少し大げさかもしれないが。",shape=box,color=red];
		j2894264485 -> j665235906;
	j4289514129 [label="彼が危険だとは思えない。彼は武器であり、武器とは殺害にも防衛にも使えるものだから。",shape=box,color=red];
		j4289514129 -> j2199876973;
	j1055880311 [label="漂流者様が彼を信じていることは残念ですが、ご自身の信念を貫くお姿は尊敬します。だから、私もあなたを信じることにします。",shape=box,color=blue];
		j1055880311 -> j2201374569;
	j2491667859 [label="私が期待するような意味ではないのでしょうが、漂流者様のお言葉を深読みしないようにしておきます。",shape=box,color=blue];
		j2491667859 -> j2201374569;
	j665235906 [label="Add 1 to Thermostat counter",color=orange];
		j665235906 -> j107221214;
	j2199876973 [label="Add -1 to Thermostat counter",color=orange];
		j2199876973 -> j107221214;
	j2201374569 [label="そろそろ失礼しなくては。もう一度申しますが、どうかご用心ください。漂流者様のためだけはなく、私のためにも。d'accord？",shape=box,color=blue];
		j2201374569 -> j367054140;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
}