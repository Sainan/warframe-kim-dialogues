		1902 -> 1904;
	1901 [label="そして、あなたが戦う「コーパス」や「ぐりにや」の指揮官たちも同じように言うのでしょうね。自分が正しいと思い込んでいるのです。",shape=box,color=blue];
		1901 -> 1904;
	1903 [label="暴力行為と自己犠牲を取り違え、その恐ろしさに目もくれず、「重要なこと」のために軽視するのは、あまりにも短絡的です。",shape=box,color=blue];
		1903 -> 1905;
	1904 [label="彼らは自分たちの行いこそが正義、善、必要だと妄信しているのです。どうして一部の悪魔は容認され、別の悪魔は容認されないのでしょう？",shape=box,color=blue];
		1904 -> 1906;
		1904 -> 1907;
		1904 -> 1908;
		1904 -> 1909;
	1905 [label="行為そのものに誇りを持つというのは…　私にはできません。彼とは違って、私は命を奪うことに喜びなど感じません。そういう意味で、私たちは全く違います。",shape=box,color=blue];
		1905 -> 1910;
	1906 [label="彼らが支持できない行為に及ぶなら、止めようと努力する。でも…　必要ならば、彼らと共に戦うだろう。",shape=box,color=red];
		1906 -> 1911;
	1907 [label="定義上の「善」や「悪」かは、行動によってのみ決まるだろう。",shape=box,color=red];
		1907 -> 1912;
	1908 [label="行動の善悪を裁く立場にいない。自分はただ守るべき人々を守るために戦うんだ。",shape=box,color=red];
		1908 -> 1911;
	1909 [label="Marieは、個人を裁く基準で、集団全体を裁いてほしいんだな。",shape=box,color=red];
		1909 -> 1912;
	1910 [label="悪魔が肋骨を突き刺そうとしても、漂流者様が助かることを祈るばかりです。漂流者様が「Marieが警告してくれたのに」と思いながら最期を迎えるなど耐えられません。",shape=box,color=blue];
		1910 -> 1913;
		1910 -> 1914;
	1911 [label="悪魔が脅威ではないと？　周囲の人々にとってdangereuxではないと信じているのですか？　甚大な被害を及ぼすかもしれませんよ。",shape=box,color=blue];
		1911 -> 1915;
		1911 -> 1916;
	1912 [label="では、彼が犯した悪行はどうでしょう？　数々の死、数々の虐殺、漂流者様にとっても理にかなった振る舞いなのですか？",shape=box,color=blue];
		1912 -> 1916;
