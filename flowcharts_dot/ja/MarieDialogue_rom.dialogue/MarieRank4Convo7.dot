	1874 [label="Bien！　漂流者様もあの悪魔に注意を払っていただけるなら安心です。いくらか穏やかに休めます。Merci.",shape=box,color=blue];
		1874 -> 1877;
	1875 [label="Oui、でも、その同盟の代償は何でしょう。漂流者様が望むことではないかもしれません。",shape=box,color=blue];
		1875 -> 1878;
	1876 [label="Oui...　おっしゃる通り、陰に飛びつくわけには参りませんね。無関心のモノを倒せるよう、肩を並べて立ち向かわなければ。",shape=box,color=blue];
