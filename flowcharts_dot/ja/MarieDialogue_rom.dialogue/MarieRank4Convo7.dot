		1863 -> 1866;
		1863 -> 1861;
	1862 [label="彼の打ち砕かれた精神を深く知っていくほど、私はますます不安になるのです。ますます危険を感じるのです。",shape=box,color=blue];
		1862 -> 1861;
		1862 -> 1860;
	1860 [label="彼の記憶が戻ればすぐに去るとは思えない。もっと何かがあるはずだ。",shape=box,color=red];
		1860 -> 1864;
