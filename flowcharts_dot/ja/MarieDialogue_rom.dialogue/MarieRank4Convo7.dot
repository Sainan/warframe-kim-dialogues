		1915 -> 1919;
	1916 [label="彼が危険だとは思えない。彼は武器であり、武器とは殺害にも防衛にも使えるものだから。",shape=box,color=red];
		1916 -> 1920;
	1917 [label="漂流者様が彼を信じていることは残念ですが、ご自身の信念を貫くお姿は尊敬します。だから、私もあなたを信じることにします。",shape=box,color=blue];
		1917 -> 1921;
	1918 [label="私が期待するような意味ではないのでしょうが、漂流者様のお言葉を深読みしないようにしておきます。",shape=box,color=blue];
