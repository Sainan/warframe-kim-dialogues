		1861 -> 1865;
	1866 [label="Roatheがこれで終わりと言うのなら、信じるよ。でもそれが本当なら、なぜ彼はまだここにいるんだろう？",shape=box,color=red];
		1866 -> 1864;
	1864 [label="認めます。私が心配しているのは、知識そのものよりも、彼が知識を使って何をしでかすのかということなのです。",shape=box,color=blue];
		1864 -> 1867;
	1865 [label="Oui！　それこそが私が心配していることなのです。でも、一体何なのでしょう？一体何のために私たちは彼に仕えているのでしょう？",shape=box,color=blue];
		1865 -> 1867;
	1867 [label="この新たな存在を彼がどのように利用するつもりか分かりません。ただ、巻き込まれたくないのです。彼が善意を持っていると鵜呑みにしないよう、用心しておきたいのです。",shape=box,color=blue];
		1867 -> 1868;
