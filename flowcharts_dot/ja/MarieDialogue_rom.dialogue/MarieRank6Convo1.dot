		j880881669 -> j115854148;
	j4179243037 [label="恋に落ちれば喜びを分かち合い、憎しみに溺れればagonieを分かち合う。これこそがhumanitéの賜物なのです。無関心のモノとは違うのです。",shape=box,color=blue];
		j4179243037 -> j992753971;
	j4216106834 [label="無関心のモノは私たちに何を教えるのでしょう？　起源に関係なく、拒絶するものすべて、破壊するものすべてにすがることでないとしたら？",shape=box,color=blue];
		j4216106834 -> j3716572224;
	j426633184 [label="私たち、どれほどの時間を一緒に過ごしたでしょうね。漂流者様が生きてきた長い年月の中で、どれほど短い時間だったことでしょう。",shape=box,color=blue];
		j426633184 -> j1016202268;
	j2347997220 [label="代わりに？　それなら…　放浪者様、まずはご自分の心の糸を解いた方がよろしいかと。私にできることではありません。",shape=box,color=blue];
		j2347997220 -> j3699890413;
	j3015260722 [label="そういうことなのですね。私は嫉妬深い人間ではございません。ですが、知らない誰かが漂流者様の心を掴んだと知るのは - ",shape=box,color=blue];
