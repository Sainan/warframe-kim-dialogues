	j3479105230 [label="私は思うのです、無関心のモノが破壊しようとしているのはこれなのでしょうか？　無関心のモノが消費しているのはこれでしょうか？　他者が他者に影響を与える力？",shape=box,color=blue];
		j3479105230 -> j1105952760;
	j4167009613 [label="漂流者様が、取り返しのつかない言葉を仰るのではないか心配です。私たちの関係を永遠に変えてしまうような。",shape=box,color=blue];
		j4167009613 -> j4167653779;
	j2596067361 [label="出会った日からずっと、お慕いしておりました。Mon cœur t'appartient depuis notre première rencontre...",shape=box,color=blue];
		j2596067361 -> j2575459990;
		j2596067361 -> j880881669;
	j733812027 [label="互いに笑わせあうこと。泣かせること。真偽のほどを納得させること。歩み寄ること。苦難のときに励まし合うこと。愚かなことで傷つけ合うこと。",shape=box,color=blue];
		j733812027 -> j4179243037;
	j3995253717 [label="困難な時にLyonを導くことと、痛みとagonieを感じるLyonを抱きしめてあげることと、何の違いがあるのでしょう？",shape=box,color=blue];
		j3995253717 -> j4216106834;
	j3760280994 [label="Roatheはここにいて、カーディナルの家族を守ってくれているのです。間違いなく漂流者様のおかげです。",shape=box,color=blue];
		j3760280994 -> j3961652911;
	j3961652911 [label="悪魔は敵ではないと分かっています、oui？　敵は無関心のモノです。拒絶するもの、破壊するものにしがみつくこと以外に、無関心のモノが、私たちに何を教えるというのでしょう？",shape=box,color=blue];
		j3961652911 -> j426633184;
	j3302439788 [label="でも…　もし ",shape=box,color=red];
		j3302439788 -> j2347997220;
	j3737630203 [label="自分も君に好意を抱いているんだ、Marie。",shape=box,color=red];
		j3737630203 -> j3015260722;
	j2502978139 [label="Oui、分かります。もちろん、分かります！　魂に従う漂流者様のことを、責めることなどできません！",shape=box,color=blue];
