		j3470333215 -> j2080852720 [label="false",color=purple];
	j658892652 [label="一度、漂流者様は私に好意を抱いていたと、仰いましたね。でも今、あなたは別の方をお別れされるのでしょうか。私は、ただ漂流者様のお幸せを祈っているのです。",shape=box,color=blue];
		j658892652 -> j2087235099;
	j3563615751 [label="一度、漂流者様は私に…　ああ、どう表現すれば良いでしょう。好意を抱いていたと。でも、漂流者様は他にも好きな方がいらっしゃるのでしょう？",shape=box,color=blue];
		j3563615751 -> j1172920931;
		j3563615751 -> j2376340802;
	j3938932313 [label="一度、漂流者様は私に…　ああ、どう表現すれば良いでしょう。好意を抱いていたと。",shape=box,color=blue];
		j3938932313 -> j1928846357;
	j4020081784 [label="ですが、私にとってどれほど大切な存在だったか、海に浮かぶ船のように、私と私の人生の進路をどれほど変えてくれたか、想いを馳せます。",shape=box,color=blue];
