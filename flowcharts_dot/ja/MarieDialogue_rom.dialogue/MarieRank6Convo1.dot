	j1105952760 [label="互いに笑わせあうこと。泣かせること。真偽のほどを納得させること。歩み寄ること。苦難のときに励まし合うこと。愚かなことで傷つけ合うこと。",shape=box,color=blue];
		j1105952760 -> j2757430911;
	j4167653779 [label="そして、私が事前に漂流者様を止めるのは、とてもつらいのです。",shape=box,color=blue];
		j4167653779 -> j2708165557;
	j2575459990 [label="それは...　どういう意味か分からないな、Marie。",shape=box,color=red];
