		j1471879296 -> j2596067361 [label="MarieWillDate",color=purple];
		j1471879296 -> j4167009613 [label="false",color=purple];
	j1861872571 [label="私は思うのです、無関心のモノが破壊しようとしているのはこれなのでしょうか？　無関心のモノが消費しているのはこれでしょうか？　他者が他者に影響を与える力？",shape=box,color=blue];
		j1861872571 -> j733812027;
	j1609794796 [label="漂流者様は私の魂の兄弟に、こんなにも安らぎを与えてくれました。私たちには戦うべき真の敵がいると確信させ、希望を与えてくださいました。",shape=box,color=blue];
		j1609794796 -> j3995253717;
	j614146667 [label="漂流者様は私の魂の兄弟に、これまで得たことのない思いやりや安らぎを与えてくれました。あなた方の結びつきはLyonにとって言葉では言い表せないほどのものなのでしょうね。",shape=box,color=blue];
		j614146667 -> j3995253717;
	j3346104856 [label="無関心のモノの正体を、真に突き止めることはできないかもしれません。ですが、そんなことは重要ではありません。私たちは、無関心のモノがもたらす困難に立ち向かわねばならないのです。それこそが現実的な課題なのです。",shape=box,color=blue];
		j3346104856 -> j3995253717;
	j3889746985 [label="ネクロなLoid様とカーディナルのご家族との復縁において、悪魔が助けになるとは思いもしませんでした。彼の動機は…　疑わしいものかもしれません、私はまだ完全には悪魔を信頼できていないのです。 ",shape=box,color=blue];
		j3889746985 -> j3760280994;
	j3062797652 [label="悪魔が自らの過ちを悟るとは思いもよりませんでした。罪のない人々の命を奪ったことを少しでも後悔していたとは。私の考えが間違っていたことを、漂流者様は証明してくださったのですね。",shape=box,color=blue];
		j3062797652 -> j3961652911;
	j2238958090 [label="漂流者様が悪魔をどんな鎖で縛ろうと、その鎖は彼を縛り続けるでしょう。　彼は以前より…　穏やかになったように見えます。　漂流者様のおかげです。",shape=box,color=blue];
		j2238958090 -> j3961652911;
	j3948406938 [label="記憶を呼び覚ましたおかげで、悪魔は落ち着きを取り戻したようです。も失ったすべての人々への悲しみについて考えることが、失うかもしれない人々のことを思い出させたのかもしれません。",shape=box,color=blue];
		j3948406938 -> j3961652911;
	j2080852720 [label="漂流者様への愛情が悪魔を穏やかにしているのかもしれません。理由が何であれ、漂流者様のおかげです。",shape=box,color=blue];
		j2080852720 -> j3961652911;
	j2087235099 [label="私はお二人に対して悪意など抱いておらず、ただ joieだけを抱いています、oui？",shape=box,color=blue];
		j2087235099 -> j3302439788;
		j2087235099 -> j3737630203;
	j1172920931 [label="状況が変わったんだ。一途でいたいんだ。ごめん。",shape=box,color=red];
		j1172920931 -> j2502978139;
	j2376340802 [label="信じ難い、受け入れ難いかもしれない、それは分かっている。でも…　Marieを愛しているんだ。そして、彼らのことも。同じくらい。",shape=box,color=red];
		j2376340802 -> j3734127592;
