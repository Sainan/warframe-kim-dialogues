	j1231843301 [label="漂流者様がLyonを迷わせたり、不必要に傷つけたりしないよう、お祈りするばかりです。Lyonは外面は石のように見えても、内面は繊細な存在なのです。",shape=box,color=blue];
		j1231843301 -> j2874982279;
	j3023838727 [label="悪魔を挑発したり説教したりしている私ですが、それでもRoatheに苦しんでほしくありません。悪魔に苦痛を与えないでくださいね。",shape=box,color=blue];
		j3023838727 -> j2874982279;
	j1248919129 [label="漂流者様を他者と共有するという考えは、私に平穏や喜びさえ感じさせるものです。 - ですが、家族や敵と共有するとなると、私には考えられません。",shape=box,color=blue];
		j1248919129 -> j3242363591;
		j1248919129 -> j2372873957;
	j4104482641 [label="そして、何が起ころうとも、最後まで漂流者様の側には小さなMarieというお友達がいることを覚えておいてくださいね。",shape=box,color=blue];
		j4104482641 -> "Chat ends.";
	j2984569471 [label="私たち、どれほどの時間を一緒に過ごしたでしょうね。漂流者様が生きてきた長い年月の中で、どれほど短い時間だったことでしょう。",shape=box,color=blue];
		j2984569471 -> j1919667144;
	j528735834 [label="あなたが友と呼べる人々の一員になれたこと、私はただ幸せに思います！",shape=box,color=blue];
		j528735834 -> j4104482641;
	j122442216 [label="すべては精密さに欠ける細かいことばかりですね、oui？　どこから来たのかなんて誰も気にとめない…　それが私たちなのですね。",shape=box,color=blue];
		j122442216 -> j2577131191;
	j2934499944 [label="そして、すべてのことをあなたは私と共有しているのですね、oui？",shape=box,color=blue];
		j2934499944 -> j2490941141;
	j1418667001 [label="私は思うのです、無関心のモノが破壊しようとしているのはこれなのでしょうか？　無関心のモノが消費しているのはこれでしょうか？　他者が他者に影響を与える力？",shape=box,color=blue];
		j1418667001 -> j3351873584;
