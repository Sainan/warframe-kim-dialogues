	"Chat ends." [color=orange];
	j1488591750 [label="漂流者様は本当に優しくて素敵な友人です。私が祈ることさえできなかった、そんな仲間です。 ",shape=box,color=blue];
		j1488591750 -> j3352154434;
	j1035760264 [label="Oui、その方が漂流者様の好みでは、non？　Ha！　私は悪魔をそんな風に捉えておりません。気になさらないで！　私が話したいのは、そのようなことではないのです。",shape=box,color=blue];
