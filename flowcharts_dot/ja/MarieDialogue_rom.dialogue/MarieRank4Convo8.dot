	1556 [label="アルゴンクリスタルはVoidから採取できて…　これがあるからこそ強力なWARFRAMEや武器を作れるんだ。",shape=box,color=red];
		1556 -> 1561;
	1562 [label="もしかしたら、Marieの言う通りかもしれない。もしかしたら、本当に人間のコピーなのかもしれない。でも、確信はない。いずれにせよ、彼らを人間として扱わなければ。",shape=box,color=red];
		1562 -> 1571;
	1563 [label="ネクロなLoidが例外であって、一般的じゃないんだと思う。彼は人間から作られたのではなく、人間のレプリカとして作られたんだろう。",shape=box,color=red];
		1563 -> 1572;
	1564 [label="Marieが正しと思う。彼らが精巧な科学の中に閉じ込められた魂でなければ、その方がきっと良いし、より人道的だろう…",shape=box,color=red];
		1564 -> 1573;
	1565 [label="普通のネクロロイドにはないかもだけど、彼は特別なんだ。Otakみたいなセファロンには魂がある。ただ作る工程で破壊されただけだ。",shape=box,color=red];
		1565 -> 1574;
	1566 [label="確かにそうだ。それでどうしろと？",shape=box,color=red];
		1566 -> 1575;
	1567 [label="確かにそうだ。だからと言ってひどい扱いをしていい訳ではない。",shape=box,color=red];
		1567 -> 1576;
