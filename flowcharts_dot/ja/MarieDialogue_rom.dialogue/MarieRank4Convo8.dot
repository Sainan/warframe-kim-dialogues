		1616 -> 1617;
	1609 [label="Oui. しかし、私が困惑しているのは彼の沈黙ではないようです。ネクロなLoid様に、彼を飾る頭蓋骨はかつて生きた方のものであったか尋ねてみました。",shape=box,color=blue];
		1609 -> 1936;
	1617 [label="Chat ends.",color=orange];
	1618 [label="伝統的な納骨所では、遺体が露出していることが多かったのです。だから、こういう儀式が生まれたんだと思います。今でも、いくつかは残っているはず。",shape=box,color=blue];
		1618 -> 1619;
	1619 [label="オロキンの絵画にも、頭蓋骨への愛が反映されている作品が何点かありました。",shape=box,color=blue];
		1619 -> 1620;
		1619 -> 1621;
