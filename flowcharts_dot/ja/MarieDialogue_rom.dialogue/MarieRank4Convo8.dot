		1948 -> 1560 [label="false",color=purple];
	1949 [label="Oui！　そうかもしれません。それがもっとも知りたい中心、いや頭蓋骨、なのだと思います。お一人は  sacro-saint - 聖なるものと信じている一方、もうお一人は copie - 模造品と考えておられる。なんて不思議なことでしょう。",shape=box,color=blue];
		1949 -> 1948;
	1947 [label="誰から見ても彼は天才であり、アルゴンクリスタルの活用方法を考案した張本人だ。",shape=box,color=red];
		1947 -> 1556;
	1558 [label="ネクロなLoid様は自分の骨を持っていないのに、どうして魂を持てるのでしょうか。",shape=box,color=blue];
		1558 -> 1562;
		1558 -> 1563;
