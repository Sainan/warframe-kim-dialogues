	1557 [label="これは…　ネクロなLoid様に魂が宿っていないという、さらなる証拠なのでしょうか。",shape=box,color=blue];
		1557 -> 1562;
		1557 -> 1563;
		1557 -> 1564;
	1559 [label="ネクロなLoid様が魂を持っているかどうか、確信が持てないようですね。しかし、自分の骨を持っていない彼が、どうして魂を持てるのか、私には分かりません。",shape=box,color=blue];
		1559 -> 1562;
		1559 -> 1563;
		1559 -> 1564;
	1560 [label="今の彼は、人間に似せて作られた、精巧な機械なのでしょう？　何倍にも複雑な蓄音機のように。",shape=box,color=blue];
