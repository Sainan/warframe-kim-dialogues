		1621 -> 1623;
	1622 [label="Daughterが以前、そんなことをしようとしたことがあったと思う。彼女が嫉妬するぞ。",shape=box,color=red];
		1622 -> 1624;
	1623 [label="Oui！　どんなに時が流れても、その影響は残っているみたいですね。たとえ小さなかけらでも残っていると思うと、胸が躍ります。",shape=box,color=blue];
		1623 -> 1625;
	1624 [label="Oui？　彼女に会える日を楽しみにしています。彼には容赦しなかったと伝えますね。",shape=box,color=blue];
		1624 -> 1625;
	1625 [label="偽物の頭蓋骨であろうとなかろうと、ネクロなLoid様には王冠を被っていただきたいです。彼を気に入っている態度を示すと、本当に恥ずかしがるんです。可能なら、顔が真っ赤になっていると思います。そのことを思うと、思わず笑みがこぼれます。",shape=box,color=blue];
