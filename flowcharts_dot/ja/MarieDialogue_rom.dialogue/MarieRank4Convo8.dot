	1929 [label="[閉じる]",shape=box,color=red];
		1929 -> 1933;
	1934 [label="ネクロなLoid様に、彼を飾る頭蓋骨はかつて生きた方のものであったか尋ねてみました。",shape=box,color=blue];
		1934 -> 1936;
	1932 [label="なぜあの方の後ろには子供の落書きのような顔があるのでしょうか。",shape=box,color=blue];
		1932 -> 1935;
	1933 [label="Chat ends.",color=orange];
	1936 [label="ネクロなLoid様は、Loid様が「原本」であることを認めながらも、「自分の」頭蓋骨だとおっしゃります。Loid様は自分の頭蓋骨の「複製」版だと口を挟みました。",shape=box,color=blue];
		1936 -> 1938;
	1935 [label="ネクロなLoid様とLoid様にお尋ねしたのですが、あまり触れたくないようで、名前だけ教えていただきました。Otak、と。とても悲しそうに口ずさんでいました。",shape=box,color=blue];
		1935 -> 1937;
	1938 [label="どうしてそんなことができるのですか？　「複製」とはどういう意味ですか？　本物の頭蓋骨、それとも bien c'est un faux - 偽物なのですか？　なぜネクロなLoid様とLoid様の答えが違うのですか？",shape=box,color=blue];
		1938 -> 1940;
		1938 -> 1941;
		1938 -> 1942;
	1937 [label="それであなたならと思い、こうして聞いているのです。",shape=box,color=blue];
		1937 -> 1939;
	1940 [label="ネクロなLoidから見れば、自分の頭蓋骨なんだろう。確かに。しかし、Loidから見れば、複製なんだ。",shape=box,color=red];
		1940 -> 1944;
	1941 [label="正直、自分も何でできているのか分からない。骨かもしれないし、ポリマーのようなものかもしれない…",shape=box,color=red];
		1941 -> 1945;
	1942 [label="Marieが気になっているのはおそらく、「頭蓋骨は本物か」ではなく、「ネクロなLoidは実在するか」にあるんだと思う。",shape=box,color=red];
		1942 -> 1946;
	1939 [label="Otak様の物語を教えていただけますでしょうか。",shape=box,color=blue];
		1939 -> 1943;
	1944 [label="おそらくこの解釈が気になるのだと思います。あの紳士お二人がその起源をどう考えているか、興味深々なのです。お一人は  sacro-saint - 聖なるものと信じている一方、もうお一人は copie - 模造品と考えておられる。なんて不思議なことでしょう。",shape=box,color=blue];
		1944 -> 1948;
	1945 [label="頭蓋骨の材質がなぜこれまで気になるのか分かりません。おそらく起源を理解したいのでしょう。あるいは、あの紳士お二人がその起源をどう考えているか、興味深々なのです。お一人は  sacro-saint - 聖なるものと信じている一方、もうお一人は copie - 模造品と考えておられる。なんて不思議なことでしょう。",shape=box,color=blue];
		1945 -> 1948;
	1946 [label="+5 Chemistry",color=orange];
		1946 -> 1949;
	1943 [label="Otakはかつてアルキメデス、オロキンの科学者、研究家だったんだ。彼に起きたことは、決してハッピーエンドではなかった。",shape=box,color=red];
		1943 -> 1947;
