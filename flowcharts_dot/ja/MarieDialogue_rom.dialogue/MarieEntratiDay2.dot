	2687 [label="いいだろう。賛成するよ。",shape=box,color=red];
		2687 -> 2697;
	2688 [label="あなたの嘘を許します、漂流者様。これからも友人として、仲間であり続けましょう。ですが、どうして私に嘘をついたのですか…　どんな企みがあったのですか？",shape=box,color=blue];
