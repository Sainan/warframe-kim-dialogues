		2661 -> 2673 [label="DrifterRoathe",color=purple];
		2661 -> 2674 [label="false",color=purple];
	2662 [label="そして、私のLyonに対して、さらに悪魔に対してさえも、漂流者様が思いやりの気持ちを持つことはできるでしょう...",shape=box,color=blue];
		2662 -> 2675;
		2662 -> 2676;
	2652 [label="Loid様が階上の方々と巡り合うことを、今も願っております。カーディナルの残されたfamilleに慰めがもたらされることを。そして、漂流者様はまさにその道筋なのです。",shape=box,color=blue];
		2652 -> 2662;
	2663 [label="+10 Chemistry",color=orange];
		2663 -> 2677;
	2664 [label="ご存知のとおり、「勝った」ときには寛大な態度を取るものです。",shape=box,color=blue];
		2664 -> 2678;
		2664 -> 2679;
	2665 [label="結果としてカーディナルに残されるのが死と傷心だとすれば、何のための「大きな善」だというのでしょう？",shape=box,color=blue];
		2665 -> 2645;
	2666 [label="Non。もちろんカーディナルは私の父ではありません。私の父は幼い私を路上に置き去りにしたのですから。カーディナルはそんな残酷なことはされませんでした。",shape=box,color=blue];
		2666 -> 2680;
	2667 [label="熱狂の中では、多くの愚行が繰り広げられます。それが世の常なのです。 ",shape=box,color=blue];
		2667 -> 2681;
	2668 [label="それが何かは、わかっているよ。 ",shape=box,color=red];
		2668 -> 2682;
	2669 [label="Marie、君を軽蔑したりなんかしない。約束するよ。",shape=box,color=red];
		2669 -> 2683;
	2670 [label="私の心の傷はさておき、カーディナルに関する会話を終わらせましょう、s'il te plaît？",shape=box,color=blue];
		2670 -> 2684;
	2671 [label="お気持ちを告白された漂流者様を、どうして遠ざけることなどできましょう？",shape=box,color=blue];
		2671 -> 2685;
	2672 [label="愛しいLyonへの想いを打ち明けてくださった漂流者様のことを、どうして拒絶などできるでしょう？　彼に...　安らぎと慰めを与えてくれるのですね。",shape=box,color=blue];
		2672 -> 2685;
	2673 [label="漂流者様が悪魔に執着していて、どうして私が漂流者様を遠ざけるのでしょう？　あなたの趣味は理解できませんが…　どうやら私たちは同じ側にいるようですね、 oui？",shape=box,color=blue];
		2673 -> 2685;
	2674 [label="仲間として漂流者様を失いたくありません。意見の食い違いは受け入れつつ、それでも一緒に進んでいけるでしょうか？",shape=box,color=blue];
		2674 -> 2686;
		2674 -> 2687;
	2675 [label="Marie、待って。お願い。謝らせて。",shape=box,color=red];
		2675 -> 2688;
	2676 [label="正直に言って、Marieが気にするとは思ってなかった。重要なことを言ったつもりじゃなかったんだ。",shape=box,color=red];
		2676 -> 2688;
	2677 [label="漂流者様が思う以上に感謝しております。ありがとうございます。",shape=box,color=blue];
