digraph {
	2615 [label="MarieEntratiDay2 begins.",color=orange];
		2615 -> 2616;
	2616 [label="漂流者様。落ち着きを取り戻すまで…　少し時間をかけて考えました。　激高している間は会話をしないという厳格な規則を守っているのです。",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="Evaluate expressions",color=orange];
		2617 -> 2618 [label="MarieEntrati5a",color=purple];
		2617 -> 2619 [label="MarieEntrati5b",color=purple];
		2617 -> 2620 [label="MarieEntrati5c",color=purple];
		2617 -> 2621 [label="MarieEntrati5d",color=purple];
		2617 -> 2622 [label="MarieEntrati5e",color=purple];
		2617 -> 2623 [label="MarieEntrati5f",color=purple];
		2617 -> 2624 [label="MarieEntrati5g",color=purple];
		2617 -> 2625 [label="MarieEntrati5h",color=purple];
		2617 -> 2626 [label="MarieEntrati5i",color=purple];
		2617 -> 2627 [label="false",color=purple];
	2618 [label="昨日、あなたが私の肋骨に突き刺したのは…　ナイフでしたね。怒りで逃げ出したことは認めます、oui。ですが、同時にrépulsion、嫌悪感も感じていたのです。あなたに対してではなく、自分自身に対して。",shape=box,color=blue];
		2618 -> 2628;
	2619 [label="ですが、お話を続ける前に申し上げたいことがあります。それは、漂流者様の口調です。私のことを子供だと思っているのでしょう。あなたは何世紀か、いえ、それ以上生きておられるのですから。",shape=box,color=blue];
		2619 -> 2629;
	2620 [label="漂流者様のお言葉について、長い間考えました。これは聖戦ではなく、カーディナルは巧妙に人を操ってきたのですね。",shape=box,color=blue];
		2620 -> 2630;
	2621 [label="漂流者様の…　ご質問は正しいのです。ソルの聖典のどこに、罪なき者を犠牲にできると書いてあるのかと…　そうような教えはございません。",shape=box,color=blue];
		2621 -> 2631;
	2622 [label="お話を続ける前に、お断りしておくことがあります。漂流者様ご自身には信仰がないのに、どうして私の信仰を議論に利用するのでしょう。",shape=box,color=blue];
		2622 -> 2632;
	2623 [label="昨日の会話から逃げてしまって、申し訳ありません。　私には辛すぎたのです。　でも…　お訊ねしておきたいのですが、本気で仰ったのですか？　それとも、気まずい議論を避けるために言っただけなのでしょうか？",shape=box,color=blue];
		2623 -> 2633;
		2623 -> 2634;
	2624 [label="どうやら、カーディナルに関する議論は行き詰まりに陥ったようですね？　漂流者様は彼をmonstreとみなし、私は聖人だと崇めているのです。",shape=box,color=blue];
		2624 -> 2635;
	2625 [label="もしよろしければ、私に好かれるためだけにEntrati側につくという漂流者様の決断についてお話ししたいのです。",shape=box,color=blue];
		2625 -> 2636;
	2626 [label="もしよろしければ、今、漂流者様の嘘についてお話ししたいのです。",shape=box,color=blue];
		2626 -> 2636;
	2627 [label="Chat ends.",color=orange];
	2628 [label="漂流者様の狙いがあまりにも正確だったことに、どうして驚くことができましょう？　私の言葉と悪魔の言葉を比較されるとは…",shape=box,color=blue];
		2628 -> 2637;
	2629 [label="漂流者様は未知の次元、虚空そのものを旅して、神々や天使と戦ってきましたね。あなたにとって、私は一体何者なのでしょうか、oui？　ただのお馬鹿なMarieでしょうか？",shape=box,color=blue];
		2629 -> 2638;
	2630 [label="そして私は信じます…　 Oui、漂流者様の仰る通り、これは聖戦ではないのですね。聖戦なんて存在しない。戦争は決して神聖でも、正義でもない。痛みは決して導きの光であってはならないのですから。",shape=box,color=blue];
		2630 -> 2639;
	2631 [label="戦争は決して神聖でも、正義でもありません。痛みは、導きの光であってはならないのですから。",shape=box,color=blue];
		2631 -> 2639;
	2632 [label="不誠実な弁論だど思わないのですか、漂流者様。残酷だし、効果もない。ただ議論に「勝つ」ための手法で、道徳的な振る舞いではありません。",shape=box,color=blue];
		2632 -> 2640;
	2633 [label="本気で言ったよ。タイミングが変だったら…　申し訳ないけど。Marie、君のことを心から大切に思っているんだ…",shape=box,color=red];
		2633 -> 2641;
	2634 [label="そんなつもりじゃなかったよ。ただ…　議論に夢中だったんだ。本当に、本当にごめん。つい、かっとなって…　",shape=box,color=red];
		2634 -> 2642;
	2635 [label="でも…　私たちの関係をこのまま終わらせたくはありません。漂流者様はお優しい方です、私たちの間に気まずさを残したくないのです。",shape=box,color=blue];
		2635 -> 2946;
	2636 [label="私の感情を操作するために状況をねじ曲げるのは…　不誠実で残酷です。隠さず言えば、あなたを憎みたくなります、漂流者。",shape=box,color=blue];
		2636 -> 2644;
	2637 [label="私は自分のことを、世界とすべての人々に心を開く性格だと思っていました。ですが、あなたはいとも簡単に、一本のとげのある矢で、その間違いを証明したのです。",shape=box,color=blue];
		2637 -> 2645;
	2638 [label="私は理解もしているのですよ。ええ、私たちは共に取り乱しました。ですが一方で、漂流者様に、もっと優しく、気配りを持って接していただきたいのです。",shape=box,color=blue];
		2638 -> 2646;
	2639 [label="私たちが今やっていること、つまりササヤキを破壊し、多くの敵と戦うことも、ルミナリーズの教えに反します。",shape=box,color=blue];
		2639 -> 2647;
	2640 [label="信仰は、他者を攻撃する手段になってはなりません。信仰は盾であり、闇を照らす光であり、道を導く声なのですから。",shape=box,color=blue];
		2640 -> 2648;
	2641 [label="ことの重大さに直面する前に、私は自分自身へカーディナルについて説かなくてはなりません、s'il vous plaît.",shape=box,color=blue];
		2641 -> 2649;
	2642 [label="Update boolean DrifterMarie",color=orange];
		2642 -> 2650;
	2946 [label="Check boolean LoidFamilyComplete",color=orange];
		2946 -> 2651 [label=true,color=green];
		2946 -> 2643 [label=false,color=brown];
	2644 [label="ですが…　私たちの関係をこのまま終わらせたくはありません。私たちの間に気まずさを残したくないのです。",shape=box,color=blue];
		2644 -> 1395;
	2645 [label="愚かにも頑固にふるまったことをpour m'excuser - 許していただくために、ここに参りました。ご理解いただければよいのですが。",shape=box,color=blue];
		2645 -> 2653;
		2645 -> 2654;
	2646 [label="私は路上で暮らしてきたのです。肉体的な苦痛の日々を過ごし、失恋も、愛も、恐怖も、拒絶も、生と死も、くぐりぬけて生きてきました。",shape=box,color=blue];
		2646 -> 2655;
	2647 [label="剣を掲げることは、崇拝されるべきではございません。たとえ世界から身を守るために必要でも。そして、無実の人々が傷つけられるのを受け入れることは、決して許されるべきではございません。",shape=box,color=blue];
		2647 -> 2656;
	2648 [label="それを、私を「打ち負かす」ために利用するなど、卑怯な戦術です。私たち二人とも、怒りに任せた心ない発言があったかもしれません。もし漂流者様が私を許してくれるのであれば、私もそのように致します。",shape=box,color=blue];
		2648 -> 2657;
		2648 -> 2658;
	2649 [label="私は、カーディナルを擁護せずにはいられなかったのです...　そして、どうして自分が彼を庇いたかったのか理解するのに時間がかかりました。",shape=box,color=blue];
		2649 -> 2659;
	2650 [label="Non、分かります…「情熱の犯罪」の名のもとに、どれだけの殺人が起きたでしょう、oui？　この世に生を受けた子供の数と同じくらいかもしれません。",shape=box,color=blue];
		2650 -> 2660;
	2651 [label="そして、こんなに短時間で、漂流者様が私にとって大切な存在になりました...　漂流者様とお話するのは、とてもjoyeusesです。",shape=box,color=blue];
		2651 -> 2661;
	2643 [label="Loid様が階上の方々と巡り合うことを、今も願っております。カーディナルの残されたfamilleに慰めがもたらされることを。そして、漂流者様はまさにその道筋なのです。",shape=box,color=blue];
		2643 -> 2651;
	1395 [label="Check boolean LoidFamilyComplete",color=orange];
		1395 -> 2662 [label=true,color=green];
		1395 -> 2652 [label=false,color=brown];
	2653 [label="ああ。言葉で傷つけてしまったことを謝るよ。他にどう言えばいいのか分からなかったんだ。",shape=box,color=red];
		2653 -> 2663;
	2654 [label="自分の言葉がMarieに届いて嬉しいよ。希望を失うかと思っていたんだ。",shape=box,color=red];
		2654 -> 2664;
	2655 [label="そして、もし自分が他者より高貴な存在だと本当に信じているような者は、ただ雲の中で妄想的になっているに過ぎないでしょう。",shape=box,color=blue];
		2655 -> 2657;
		2655 -> 2658;
	2656 [label="ですから…　カーディナルが「大きな善」の名目で他人を傷つけることは正当化されないと認めます。",shape=box,color=blue];
		2656 -> 2665;
	2657 [label="イライラしたけど、他にどうすればMarieに納得してもらえるか分からないんだ。Entratiは君の友達じゃなければ父親でもない。",shape=box,color=red];
		2657 -> 2666;
	2658 [label="ごめん。ついカッとなって、思ってもないことまで言ってしまった。",shape=box,color=red];
		2658 -> 2667;
	2659 [label="すべてを告白して、漂流者様に軽んじられたくないんです。あまりにもつまらない、pathétiqueなMarieだって。",shape=box,color=blue];
		2659 -> 2668;
		2659 -> 2669;
	2660 [label="私は…　失望し、傷つきました。でも…　漂流者様を許しましょう。",shape=box,color=blue];
		2660 -> 2670;
	2661 [label="Evaluate expressions",color=orange];
