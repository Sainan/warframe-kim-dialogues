digraph {
	2239 [label="MarieRank4Convo3 begins.",color=orange];
		2239 -> 2240;
		2239 -> 2241;
	2240 [label="元気かい、Marie?",shape=box,color=red];
		2240 -> 2242;
	2241 [label="[閉じる]",shape=box,color=red];
		2241 -> 2243;
	2242 [label="あまり気分が良くありません。また明日にしませんか。今日はあまりいい話し相手になる自信がありません。",shape=box,color=blue];
		2242 -> 2244;
		2242 -> 2245;
		2242 -> 2246;
	2243 [label="Chat ends.",color=orange];
	2244 [label="明日にしてもいいけど、悩み事があるなら聞く。",shape=box,color=red];
		2244 -> 2247;
	2245 [label="そう、分かった。",shape=box,color=red];
		2245 -> 2248;
	2246 [label="どうしたんだ？",shape=box,color=red];
		2246 -> 2247;
	2247 [label="C'est vraiment gentil、でも古い悩み事なんです…　あなたに伝えるほど大きな問題ではないのですが。大丈夫です。",shape=box,color=blue];
		2247 -> 2249;
	2248 [label="Chat ends.",color=orange];
	2249 [label="Update boolean MarieChronicPain",color=orange];
		2249 -> 2250;
		2249 -> 2251;
		2249 -> 2252;
	2250 [label="無理強いはしない。でもいつでも相談に乗る。",shape=box,color=red];
		2250 -> 2253;
	2251 [label="その気持ち、わかる。「ループ」を始める前、デュヴィリでひどい怪我をしたんだ。傷は治ったけど、今でも時々ひどい痛みが走る。そんな時、辛い顔を見せないよう努力しているから。",shape=box,color=red];
		2251 -> 2254;
	2252 [label="昔から続く問題は、新しい問題と変わらないくらい厄介な時がある。現れては消え、現れては消えと繰り返すからといって、話す価値がないわけではない。",shape=box,color=red];
		2252 -> 2255;
	2253 [label="本当に優しいのですね。わかりました。ちょっと頑固なMarieになっていますね。",shape=box,color=blue];
		2253 -> 2256;
	2254 [label="Update boolean DrifterChronicPain",color=orange];
		2254 -> 2257;
	2255 [label="Oui, tu as raison. ちょっと頑固なMarieになっていますね。",shape=box,color=blue];
		2255 -> 2256;
	2256 [label="説明するのは難しいのですが、やってみます。Mes pieds, oui？　私の足。血清が私を変え、飛翔力を与えてくれました…",shape=box,color=blue];
		2256 -> 2258;
	2257 [label="Par les Luminaires、それは辛かったでしょう。私の状況と似てますね、oui？",shape=box,color=blue];
		2257 -> 2259;
	2258 [label="しかし、まだ足があるような感覚に陥るときがあります。私を食い尽くそうと脅かし、魂から希望と喜びを砕こうとするあの歪んだものたちを。",shape=box,color=blue];
		2258 -> 2260;
	2259 [label="自分を裏切り、精神を鈍らせる身体を持つなんて。今でもとても不思議な気がします。sérum - 血清は私を変え、飛翔力を与えてくれました。",shape=box,color=blue];
		2259 -> 2258;
	2260 [label="常に痛いのです。いつも。今ここに座りながら思い出すと、痛みを感じます。しかし、気付くだけでは十分でありません。",shape=box,color=blue];
		2260 -> 2261;
	2261 [label="今でも夜中に痛みで目が覚める時があります。ソル、どうして。Sol, pourquoi？　どうして agonie interminable - 終わりのない苦しみを感じなければいけないのでしょう。",shape=box,color=blue];
		2261 -> 2262;
	2262 [label="何の役に立つのでしょう。ああ、しかし朝が来ると、笑いながら自分に言い聞かせます。「文句を言っている場合じゃないわ、Marie。あなたはどんなに恵まれているか。あなたが持っているもの、できることを思い出して」と。",shape=box,color=blue];
		2262 -> 2263;
	2263 [label="大聖堂ではこう言われていました。「Marieは読み書きができ、食べるのに困っていない。眠ったり、十分動き回れるじゃないか。視力もあり、話せる。書き物をする手も。Marieを大切に思う人たちもいる」と。そして今、私は飛べるようになりました。futur - 未来をVoidそのものから守ることができる。無関心のモノからも。",shape=box,color=blue];
		2263 -> 2264;
	2264 [label="それを聞いた私は「さあ、泣くのです、バカな子。この絶え間ない痛みは、これから起こる困難に立ち向かう強さを与えてくれるのです」と自分に言い聞かせました。一日が始まり、次の朝を迎えるころには、痛みが治まるときがありました。",shape=box,color=blue];
		2264 -> 2265;
	2265 [label="Check boolean DrifterChronicPain",color=orange];
		2265 -> 2266 [label=true,color=green];
		2265 -> 2269 [label=true,color=green];
		2265 -> 2267 [label=false,color=brown];
		2265 -> 2268 [label=false,color=brown];
	2266 [label="自分たちに与えられた「何か」は、痛みに対する耐性かもしれないな。",shape=box,color=red];
		2266 -> 2270;
	2269 [label="でも、時々…　目が覚めた時…　今日自分が壊れる日になるような不安感に襲われる。",shape=box,color=red];
		2269 -> 2270;
	2267 [label="ずっと…　痛みが続くの？　それは大変だ、Marie…",shape=box,color=red];
		2267 -> 2271;
	2268 [label="薬とか…　治療方法とかないの？",shape=box,color=red];
		2268 -> 2272;
	2270 [label="ある時、教区民に尋ねられたのです。「いつも痛いの？」私は「Oui, monsieur. Je le suis - そうです」と答えました。その方は恐怖が入り混じった表情をしていたのです。",shape=box,color=blue];
		2270 -> 2273;
	2271 [label="私は時々座りながら、もしこんな agonie - 困難に陥っていなければ、どれだけ人のために働けたか考えます。もし私の体が檻に閉じ込められていなければ。",shape=box,color=blue];
		2271 -> 2274;
	2272 [label="あったらいいのですが。Mais non, 残念ながら、ありません。この時代では解決策がないと思います。",shape=box,color=blue];
		2272 -> 2275;
	2273 [label="「毎日どうやって生きていくんだい」と尋ねられましたが「他の選択肢はありますか、Monsieur...？」と微笑みながら答えたのを覚えています。",shape=box,color=blue];
		2273 -> 2276;
		2273 -> 2277;
	2274 [label="どれだけ悔しい思いをしたか。五体満足で生まれてきた者たちに、どれほど嫉妬したでしょう。しかし、結局のところ、 à part rendre nos vies plus amères - 私たちのことを理解しても、何の役に立つのか分かりません。より一層、憤慨することになるだけでしょうか。",shape=box,color=blue];
		2274 -> 2278;
	2275 [label="ものによっては、人間、科学、信仰では治せないものもあるのでしょう。",shape=box,color=blue];
		2275 -> 2271;
	2276 [label="同じような会話を何度したことか…",shape=box,color=red];
		2276 -> 2271;
	2277 [label="良くわかる。気の毒だな。",shape=box,color=red];
		2277 -> 2279;
	2278 [label="Aucun - 利点はなさそうです。私は私。これからも頑張り続けるだけです。",shape=box,color=blue];
		2278 -> 2280;
	2279 [label="Non, いえ、あなたが私と同じような agonie - 苦しい体験をしたことを残念に思います。",shape=box,color=blue];
		2279 -> 2271;
	2280 [label="Check boolean DrifterChronicPain",color=orange];
		2280 -> 2281 [label=true,color=green];
		2280 -> 2282 [label=false,color=brown];
	2281 [label="おそらくあなたも同じ。一緒ですね。一緒に頑張りましょう。",shape=box,color=blue];
		2281 -> 2282;
	2282 [label="+20 Chemistry",color=orange];
		2282 -> 2283;
	2283 [label="この会話がどれだけ私のためになったか、計り知れないでしょう。言葉では言い表せませんが、感謝の気持ちでいっぱいです、漂流者様。",shape=box,color=blue];
		2283 -> 2284;
	2284 [label="Et encore merci.",shape=box,color=blue];
		2284 -> 2285;
	2285 [label="Chat ends.",color=orange];
}