digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo3 begins." [color=orange];
		"MarieRank4Convo3 begins." -> j1608671930;
	j1608671930 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j1608671930 -> j117525182;
		j1608671930 -> j738393015;
	j117525182 [label="元気かい、Marie?",shape=box,color=red];
		j117525182 -> j1406200509;
	j738393015 [label="[閉じる]",shape=box,color=red];
		j738393015 -> "Chat ends.";
	j1406200509 [label="あまり気分が良くありません。また明日にしませんか。今日はあまりいい話し相手になる自信がありません。",shape=box,color=blue];
		j1406200509 -> j1338728987;
		j1406200509 -> j776347482;
		j1406200509 -> j1300934480;
	"Chat ends." [color=orange];
	j1338728987 [label="明日にしてもいいけど、悩み事があるなら聞く。",shape=box,color=red];
		j1338728987 -> j1396753837;
	j776347482 [label="そう、分かった。",shape=box,color=red];
		j776347482 -> "Chat ends.";
	j1300934480 [label="どうしたんだ？",shape=box,color=red];
		j1300934480 -> j1396753837;
	j1396753837 [label="C'est vraiment gentil、でも古い悩み事なんです…　あなたに伝えるほど大きな問題ではないのですが。大丈夫です。",shape=box,color=blue];
		j1396753837 -> j3096270068;
	j3096270068 [label="Boolean MarieChronicPain is now true.",color=orange];
		j3096270068 -> j1550694841;
		j3096270068 -> j241276011;
		j3096270068 -> j745452829;
	j1550694841 [label="無理強いはしない。でもいつでも相談に乗る。",shape=box,color=red];
		j1550694841 -> j729087546;
	j241276011 [label="その気持ち、わかる。「ループ」を始める前、デュヴィリでひどい怪我をしたんだ。傷は治ったけど、今でも時々ひどい痛みが走る。そんな時、辛い顔を見せないよう努力しているから。",shape=box,color=red];
		j241276011 -> j1118325516;
	j745452829 [label="昔から続く問題は、新しい問題と変わらないくらい厄介な時がある。現れては消え、現れては消えと繰り返すからといって、話す価値がないわけではない。",shape=box,color=red];
		j745452829 -> j4028765387;
	j729087546 [label="本当に優しいのですね。わかりました。ちょっと頑固なMarieになっていますね。",shape=box,color=blue];
		j729087546 -> j466886903;
	j1118325516 [label="Boolean DrifterChronicPain is now true.",color=orange];
		j1118325516 -> j2335608802;
	j4028765387 [label="Oui, tu as raison. ちょっと頑固なMarieになっていますね。",shape=box,color=blue];
		j4028765387 -> j466886903;
	j466886903 [label="説明するのは難しいのですが、やってみます。Mes pieds, oui？　私の足。血清が私を変え、飛翔力を与えてくれました…",shape=box,color=blue];
		j466886903 -> j1107129140;
	j2335608802 [label="Par les Luminaires、それは辛かったでしょう。私の状況と似てますね、oui？",shape=box,color=blue];
		j2335608802 -> j4268500609;
	j1107129140 [label="しかし、まだ足があるような感覚に陥るときがあります。私を食い尽くそうと脅かし、魂から希望と喜びを砕こうとするあの歪んだものたちを。",shape=box,color=blue];
		j1107129140 -> j2347150851;
	j4268500609 [label="自分を裏切り、精神を鈍らせる身体を持つなんて。今でもとても不思議な気がします。sérum - 血清は私を変え、飛翔力を与えてくれました。",shape=box,color=blue];
		j4268500609 -> j1107129140;
	j2347150851 [label="常に痛いのです。いつも。今ここに座りながら思い出すと、痛みを感じます。しかし、気付くだけでは十分でありません。",shape=box,color=blue];
		j2347150851 -> j1701534886;
	j1701534886 [label="今でも夜中に痛みで目が覚める時があります。ソル、どうして。Sol, pourquoi？　どうして agonie interminable - 終わりのない苦しみを感じなければいけないのでしょう。",shape=box,color=blue];
		j1701534886 -> j3852106334;
	j3852106334 [label="何の役に立つのでしょう。ああ、しかし朝が来ると、笑いながら自分に言い聞かせます。「文句を言っている場合じゃないわ、Marie。あなたはどんなに恵まれているか。あなたが持っているもの、できることを思い出して」と。",shape=box,color=blue];
		j3852106334 -> j2264693435;
	j2264693435 [label="大聖堂ではこう言われていました。「Marieは読み書きができ、食べるのに困っていない。眠ったり、十分動き回れるじゃないか。視力もあり、話せる。書き物をする手も。Marieを大切に思う人たちもいる」と。そして今、私は飛べるようになりました。futur - 未来をVoidそのものから守ることができる。無関心のモノからも。",shape=box,color=blue];
		j2264693435 -> j1234457891;
	j1234457891 [label="それを聞いた私は「さあ、泣くのです、バカな子。この絶え間ない痛みは、これから起こる困難に立ち向かう強さを与えてくれるのです」と自分に言い聞かせました。一日が始まり、次の朝を迎えるころには、痛みが治まるときがありました。",shape=box,color=blue];
		j1234457891 -> j830269311;
	j830269311 [label="Check boolean DrifterChronicPain",color=orange];
		j830269311 -> j3279792701 [label=true,color=green];
		j830269311 -> j102223422 [label=true,color=green];
		j830269311 -> j1647779126 [label=false,color=brown];
		j830269311 -> j2733430847 [label=false,color=brown];
	j3279792701 [label="自分たちに与えられた「何か」は、痛みに対する耐性かもしれないな。",shape=box,color=red];
		j3279792701 -> j2942820690;
	j102223422 [label="でも、時々…　目が覚めた時…　今日自分が壊れる日になるような不安感に襲われる。",shape=box,color=red];
		j102223422 -> j2942820690;
	j1647779126 [label="ずっと…　痛みが続くの？　それは大変だ、Marie…",shape=box,color=red];
		j1647779126 -> j720970334;
	j2733430847 [label="薬とか…　治療方法とかないの？",shape=box,color=red];
		j2733430847 -> j2467708136;
	j2942820690 [label="ある時、教区民に尋ねられたのです。「いつも痛いの？」私は「Oui, monsieur. Je le suis - そうです」と答えました。その方は恐怖が入り混じった表情をしていたのです。",shape=box,color=blue];
		j2942820690 -> j415950215;
	j720970334 [label="私は時々座りながら、もしこんな agonie - 困難に陥っていなければ、どれだけ人のために働けたか考えます。もし私の体が檻に閉じ込められていなければ。",shape=box,color=blue];
		j720970334 -> j3296042431;
	j2467708136 [label="あったらいいのですが。Mais non, 残念ながら、ありません。この時代では解決策がないと思います。",shape=box,color=blue];
		j2467708136 -> j1396092214;
	j415950215 [label="「毎日どうやって生きていくんだい」と尋ねられましたが「他の選択肢はありますか、Monsieur...？」と微笑みながら答えたのを覚えています。",shape=box,color=blue];
		j415950215 -> j3101683489;
		j415950215 -> j200660281;
	j3296042431 [label="どれだけ悔しい思いをしたか。五体満足で生まれてきた者たちに、どれほど嫉妬したでしょう。しかし、結局のところ、 à part rendre nos vies plus amères - 私たちのことを理解しても、何の役に立つのか分かりません。より一層、憤慨することになるだけでしょうか。",shape=box,color=blue];
		j3296042431 -> j3763650642;
	j1396092214 [label="ものによっては、人間、科学、信仰では治せないものもあるのでしょう。",shape=box,color=blue];
		j1396092214 -> j720970334;
	j3101683489 [label="同じような会話を何度したことか…",shape=box,color=red];
		j3101683489 -> j720970334;
	j200660281 [label="良くわかる。気の毒だな。",shape=box,color=red];
		j200660281 -> j1373693325;
	j3763650642 [label="Aucun - 利点はなさそうです。私は私。これからも頑張り続けるだけです。",shape=box,color=blue];
		j3763650642 -> j2980398560;
	j1373693325 [label="Non, いえ、あなたが私と同じような agonie - 苦しい体験をしたことを残念に思います。",shape=box,color=blue];
		j1373693325 -> j720970334;
	j2980398560 [label="Check boolean DrifterChronicPain",color=orange];
		j2980398560 -> j1823109699 [label=true,color=green];
		j2980398560 -> j3881441142 [label=false,color=brown];
	j1823109699 [label="おそらくあなたも同じ。一緒ですね。一緒に頑張りましょう。",shape=box,color=blue];
		j1823109699 -> j3881441142;
	j3881441142 [label="+20 Chemistry",color=orange];
		j3881441142 -> j2109620741;
	j2109620741 [label="この会話がどれだけ私のためになったか、計り知れないでしょう。言葉では言い表せませんが、感謝の気持ちでいっぱいです、漂流者様。",shape=box,color=blue];
		j2109620741 -> j3563974437;
	j3563974437 [label="Et encore merci.",shape=box,color=blue];
		j3563974437 -> "Chat ends.";
}