		j4175335467 -> j3023632877;
	j1349099430 [label="Oui ! Imaginez…　想像してみてください。悪魔が仮面と上着をまとって、衣嚢に盗んだお菓子を詰めながらふらりと大聖堂に入ってくるところをLyonと私が目撃した時のことを。",shape=box,color=blue];
		j1349099430 -> j1976135789;
	j2549598956 [label="寄り道も悪くありませんわ。",shape=box,color=blue];
		j2549598956 -> j3023632877;
	j3023632877 [label="Ah ! 昼食の時間のようです。また後ほど…",shape=box,color=blue];
		j3023632877 -> "Chat ends.";
	j1976135789 [label="その時、彼は何て言ったと思いますか。オロキンが間もなくこの星系を支配するのだから、「真の」窃盗ではないと言うのです。Et puis on se crie dessus et…　大きな声で言い合いをしていると、Lyonがうるさいと叱咤しました。",shape=box,color=blue];
		j1976135789 -> j1528846158;
		j1976135789 -> j630903545;
	j1528846158 [label="Roatheは皆と分け合えるくらい持ってきたの？",shape=box,color=red];
