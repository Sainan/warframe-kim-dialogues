		j1567753296 -> j3075862626;
		j1567753296 -> j1084914938;
		j1567753296 -> j738393015;
	j3922213608 [label="ああ、あの minuscule copie 小さなコピーと彼らの悲痛な物語…　考えるだけで涙がこぼれそうです。famille だと思っていた者たちに、戦争の道具にされてしまうなんて？",shape=box,color=blue];
		j3922213608 -> j3554579496;
	j3689951736 [label="Oui ! 　お伺いしています。あなたは戦い方を学ぶために、多くの苦しみを味わったと。死はなんと残酷な教師なのでしょう。私には想像がつきません。",shape=box,color=blue];
		j3689951736 -> j3554579496;
	j3310385538 [label="私が言っていることはためになるか分かりません。それとも、回転する機会の上で光る点に過ぎないのでしょうか。",shape=box,color=blue];
		j3310385538 -> j3111079104;
	j2501571315 [label="あなたのその友人をことを知りませんが、あなたは彼らの心の支えになったでしょう。",shape=box,color=blue];
		j2501571315 -> j956136727;
	j2054889197 [label="礼拝堂に、あなたとよく似た気質の神父様がおられました。彼はどんなことにも耐えることができたのです。ある日、耐えられなくなってしまうまでは。",shape=box,color=blue];
		j2054889197 -> j1826836784;
	j3399527413 [label="すまない。大人げないことをしてしまった。",shape=box,color=red];
		j3399527413 -> j3290388327;
	j3454829915 [label="許してくれる？",shape=box,color=red];
		j3454829915 -> j3950231933;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j1663167267 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j1663167267 -> j1858615417;
	j3554579496 [label="Non. 今の自分のままでいたいです。カーディナルの手を握り、彼が差し出した血清を受け取ることを選んだ私で。",shape=box,color=blue];
		j3554579496 -> j4155364767;
	j3111079104 [label="実際、現実を考えてみると、私が考えを文章にまとめる時、あなたが歴史上のどこにいるかによって、その文章が遠い過去に書かれたか、つい最近書かれたか観点が変わるのですね。",shape=box,color=blue];
		j3111079104 -> j38164938;
	j1826836784 [label="圧倒されて、すべてがめちゃくちゃになったように見えたとき、彼に「誰か一緒にいた方が良い」と尋ねました。Des fois, oui, des fois, non. - 頷くときもあれば、「大丈夫」と言うこともありました。",shape=box,color=blue];
		j1826836784 -> j956136727;
	j3290388327 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j3290388327 -> j687144825;
	j3950231933 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j3950231933 -> j2715541412;
	j1858615417 [label="私たちは皆、この世界で自分の進むべき道を手探りで見つけようとしていますものね。",shape=box,color=blue];
		j1858615417 -> j3712716573;
	j4155364767 [label="でも、私を苦しめる悲しみ、不安をご存知でしょう。この戦争の世界に生まれ育つのがどんなに悲しいことであるか。",shape=box,color=blue];
		j4155364767 -> j4160565543;
		j4155364767 -> j2754047754;
	j38164938 [label="つまり、あなたが一人ではないと書いても、虚しく感じるかもしれない。",shape=box,color=blue];
		j38164938 -> j238972011;
	j687144825 [label="+10 Chemistry",color=orange];
		j687144825 -> j2667691341;
	j2715541412 [label="+5 Chemistry",color=orange];
		j2715541412 -> j2501345007;
	j3712716573 [label="話を戻しますと…　あなたのご機嫌を尋ねたのですが。petit mensonge ou non 小さな嘘つきさん、もう一度尋ねます。お元気ですか。",shape=box,color=blue];
		j3712716573 -> j3854966715;
		j3712716573 -> j1884666170;
		j3712716573 -> j3721054369;
	j4160565543 [label="時々、自分がどれだけ一人でさまざまなことを発見しなければいけなかったか振り返るときがあるんだ。本格的な訓練を受けた子供たちを羨ましくも思う。",shape=box,color=red];
		j4160565543 -> j3491552421;
	j2754047754 [label="戦争中に生きることに「良い」道などないと思う。戦地で生まれ育つことも、自ら選択して戦地に行くことも。結局、重要なのは自分の芯を保ち、長所をどう生かすかを考え抜くことだと思う。",shape=box,color=red];
		j2754047754 -> j279084850;
	j238972011 [label="しかし、あなたの周りの人々は、遠く離れていたり、あなたから声をかけてもらえることを辛抱強く待っているだけなのかもしれません。",shape=box,color=blue];
		j238972011 -> j2280962287;
	j2667691341 [label="Oui, もしあなたがLyonだったら、10回の鞭打ち刑が罰として下されるでしょう。でもあなたは違う。だから許します。",shape=box,color=blue];
		j2667691341 -> j1858615417;
	j2501345007 [label="Oui, 許します。でも、もしあなたがLyonだったら、10回の鞭打ち刑が罰として下されるでしょう。",shape=box,color=blue];
		j2501345007 -> j1858615417;
	j3854966715 [label="正直なところ、あまり良くない。",shape=box,color=red];
		j3854966715 -> j3862696555;
	j1884666170 [label="正直、大丈夫だ。Marieはどう？",shape=box,color=red];
		j1884666170 -> j1095527674;
	j3721054369 [label="さっきより良くなった。ありがとう。告解は助けになるときいてるけど…",shape=box,color=red];
		j3721054369 -> j2557686262;
	j3491552421 [label="Add -1 to Thermostat counter",color=orange];
