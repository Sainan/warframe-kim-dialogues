		j4132951681 -> j3078544506 [label=false,color=brown];
	j3823388737 [label="今、私にはとても孤独な minuscule copie - オペレーター様と、群れとともに走る狼さんにしか見えません。",shape=box,color=blue];
		j3823388737 -> j1581398558;
	j2537121772 [label="難しい…　戦いと死が自分の唯一の定め、存在の意義だと教えられて育てられたら、その型から抜け出すのは難しい。目的があることは悪いことではない。",shape=box,color=red];
		j2537121772 -> j3827744133;
	j3273907461 [label="選ぶと思う。といっても、会ったことがあるグリニアの中には、戦争と死以上の何かがあるということを証明してくれたものもいるけど。",shape=box,color=red];
		j3273907461 -> j3938201304;
	j1456205260 [label="甘い焼き菓子を全員分用意しなきゃな。",shape=box,color=red];
