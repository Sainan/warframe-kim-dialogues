	j1896669728 [label="良い調子だ。Marieは？",shape=box,color=red];
		j1896669728 -> j1095527674;
	j3075862626 [label="もっと元気な時もあったけど、不満はないよ。Marieは元気？",shape=box,color=red];
		j3075862626 -> j2491959251;
	j1084914938 [label="自分は…　正直に話すべきなことを話していないんだ。自分は…　ソルの信奉者じゃないんだ。",shape=box,color=red];
		j1084914938 -> j3433720416;
	j3949678410 [label="Marieと話せるようになったから、気分が良いよ。Marieがいると、毎日が明るくなる。",shape=box,color=red];
		j3949678410 -> j2540136831;
	j738393015 [label="[閉じる]",shape=box,color=red];
		j738393015 -> "Chat ends.";
	j1095527674 [label="まあまあです。でも…　ふとした瞬間に、こんなはずじゃなかったな、と熟考してしまう私がいます。",shape=box,color=blue];
		j1095527674 -> j3594541697;
		j1095527674 -> j2241755791;
	j2491959251 [label="そんなこと言われたら探りたくなってしまいます。Qu'y a-t-il ? 教えてください。",shape=box,color=blue];
		j2491959251 -> j2695834855;
		j2491959251 -> j3554605123;
		j2491959251 -> j838083898;
		j2491959251 -> j964674698;
	j3433720416 [label="え？　そうなん…　ですか。Pourquoi ?",shape=box,color=blue];
		j3433720416 -> j242072466;
		j3433720416 -> j3328898814;
		j3433720416 -> j2887605114;
	j2540136831 [label="狼さん！　あなたの言葉に、椅子から落ちてしまいそうです！",shape=box,color=blue];
		j2540136831 -> j246656455;
		j2540136831 -> j2944000026;
	"Chat ends." [color=orange];
	j3594541697 [label="どうして？",shape=box,color=red];
		j3594541697 -> j2222938040;
	j2241755791 [label="自分も同じような立ち位置だった時もある。",shape=box,color=red];
		j2241755791 -> j2612760005;
	j2695834855 [label="うまく説明できないんだ。",shape=box,color=red];
		j2695834855 -> j3714692149;
	j3554605123 [label="悩み事が多いんだ。時間が足りない。",shape=box,color=red];
		j3554605123 -> j3993695635;
	j838083898 [label="友達はかつて「虫の知らせ」があるって表現してた。虫といっても虫の話じゃないけど。",shape=box,color=red];
		j838083898 -> j4083372702;
	j964674698 [label="時々、何もかもが…　自分を苦しめる。でも大丈夫になるさ。",shape=box,color=red];
		j964674698 -> j1672693474;
	j242072466 [label="Marieのことをもっと知れると思ったから…",shape=box,color=red];
		j242072466 -> j1514143507;
	j3328898814 [label="冗談だって分かると思った。",shape=box,color=red];
		j3328898814 -> j446440888;
	j2887605114 [label="正直わからない。衝動に駆られたようだ。",shape=box,color=red];
		j2887605114 -> j10917685;
	j246656455 [label="でも本気なんだ。不快な思いをさせたら、ごめん。",shape=box,color=red];
		j246656455 -> j3336088220;
	j2944000026 [label="ごめん。ただの冗談だよ。",shape=box,color=red];
		j2944000026 -> j3336088220;
	j2222938040 [label="私は une Sœur de Sol - ソルの修道女。戦う…　べきではないのです。敵を殺すなど。カビアはササヤキは生きていない、と言いますが…　私が対峙する他の者たちはどうすればよいのでしょう。",shape=box,color=blue];
		j2222938040 -> j2411093416;
	j2612760005 [label="+5 Chemistry",color=orange];
		j2612760005 -> j3184728228;
	j3714692149 [label="承知いたしました。言葉にするのが難しい時もありますものね。",shape=box,color=blue];
		j3714692149 -> j956136727;
	j3993695635 [label="大聖堂に、同じように悩んでいる修道女がおりました。不安で不安で、心が落ち着かないようで…　一度、真夜中に銀食器を磨いているのを見つけたのです。",shape=box,color=blue];
		j3993695635 -> j3535093806;
	j4083372702 [label="Ah, oui. あなたがおっしゃっていること分かる気がします。虫がソワソワと動く様子ですよね。",shape=box,color=blue];
		j4083372702 -> j3505969894;
	j1672693474 [label="一滴ずつ水が満たされるコップのように、non ?",shape=box,color=blue];
		j1672693474 -> j3790467265;
	j1514143507 [label="私のことを知るために、そのような mensonge - 嘘をつく必要はありません。",shape=box,color=blue];
		j1514143507 -> j3143887180;
	j446440888 [label="Je ne comprends pas votre humour. あなたのユーモアは理解できません。未来の世界の「ユーモア」は違うのでしょうか。",shape=box,color=blue];
		j446440888 -> j3970446712;
	j10917685 [label="どんな気持ちで私にそのような mensonge - 嘘をついたのでしょう。",shape=box,color=blue];
		j10917685 -> j1376195297;
	j3336088220 [label="Bon, où en étais-je？",shape=box,color=blue];
		j3336088220 -> j4244769428;
	j2411093416 [label="ソルの名の下に戦う…　これが私に定められた道なのでしょうか。彼の名の下に殺し屋になるなんて。Moi, petite Marie ?  私、Marieが？",shape=box,color=blue];
		j2411093416 -> j3432193936;
		j2411093416 -> j316548026;
	j3184728228 [label="比喩表現を使っているのは十分承知なのですが、「立ち」位置とは、大笑いしてしまいました。たとえあなたが私の立ち位置にいようとも、滑稽な場面しか頭に浮かびません。",shape=box,color=blue];
		j3184728228 -> j4258875025;
	j956136727 [label="私たちの日々や心は、様々な形で狂い始めます。泥沼に陥れてしまうような、暗い穴を見つけてしまうこともあるでしょう。",shape=box,color=blue];
		j956136727 -> j4039247951;
	j3535093806 [label="どうして真夜中に磨いているのですか、と尋ねると、「不安過ぎて寝られない」と言ったのです。",shape=box,color=blue];
		j3535093806 -> j1023891829;
	j3505969894 [label="ああ、私の言語にもこの表現があります。不吉な予感がする感覚ですよね。",shape=box,color=blue];
		j3505969894 -> j3458295825;
	j3790467265 [label="いっぱいになると溢れ出す…　もしかしたら流れ出してしまうかもしれない？　まるで大惨事のよう…",shape=box,color=blue];
		j3790467265 -> j3222474920;
	j3143887180 [label="魂とは、身につけている信仰以上のものです。私は une Sœur de Sol - ソルの修道女ですが、あなたには肩書き以上のものを見出してもらいたい。",shape=box,color=blue];
		j3143887180 -> j2608842016;
	j3970446712 [label="さっぱり意図が掴めません。",shape=box,color=blue];
		j3970446712 -> j1097657522;
	j1376195297 [label="悪気がなかったと祈るばかりです。私をからかうための残酷な冗談でないことを願います。ソルの教えに従います…",shape=box,color=blue];
		j1376195297 -> j2118869824;
	j4244769428 [label="Check boolean DrifterFaithSol",color=orange];
		j4244769428 -> j850510234 [label=true,color=green];
		j4244769428 -> j1567753296 [label=false,color=brown];
	j3432193936 [label="自分は兵隊になるよう訓練されたわけではない。あの子みたいに。Marieもきっとそうじゃなかったと思う。",shape=box,color=red];
		j3432193936 -> j3922213608;
	j316548026 [label="自分は…　いつもこうだったわけじゃない。いつも闘志旺盛だった。苦い経験を通して学ぶことになってしまったが。",shape=box,color=red];
		j316548026 -> j3689951736;
	j4258875025 [label="頭の中に浮かぶ発想は、面白すぎて笑いが止められません。息ができなくなる前に教えてください。いったい何のことを仰っているのでしょう。",shape=box,color=blue];
		j4258875025 -> j3432193936;
		j4258875025 -> j316548026;
	j4039247951 [label="そうなってしまったとき、私たちにできるのは自分自身に対して優しく、忍耐強くあることだけです。",shape=box,color=blue];
		j4039247951 -> j3310385538;
	j1023891829 [label="そんな彼女を見つけるたびに、「手伝おうか」と尋ねると、頷くときもあれば、「大丈夫」と言うこともありました。",shape=box,color=blue];
		j1023891829 -> j956136727;
	j3458295825 [label="それとも、願望は隠れたり、泣いたり…　どちらかというと絶望に近いのでしょうか。やはり難しいです。",shape=box,color=blue];
		j3458295825 -> j2501571315;
	j3222474920 [label="こぼれた液体を吹き上げ、カップを元通りにしても…　また最初からやり直し、oui ?",shape=box,color=blue];
		j3222474920 -> j2054889197;
	j2608842016 [label="話の題材は、空の星の数ほどあるのではないでしょうか。",shape=box,color=blue];
		j2608842016 -> j3399527413;
		j2608842016 -> j3454829915;
	j1097657522 [label="Boolean DrifterFaithSol is now false.",color=orange];
		j1097657522 -> j1508231473;
	j2118869824 [label="- あなたが従うかどうかは別として、私はソルの信仰に従います。そしてあなたを許します。もしあなたがLyonだったら、10回の鞭打ち刑が罰として下されるでしょう。",shape=box,color=blue];
		j2118869824 -> j1663167267;
	j850510234 [label="Ma famille à Sol ! 　ソルの下、私の家族は今日もお元気でしょうか。",shape=box,color=blue];
		j850510234 -> j1896669728;
		j850510234 -> j3075862626;
