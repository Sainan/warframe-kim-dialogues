		j3157750603 -> j2367042698;
	j526902421 [label="もし上手くいかなかったら…　とっておきの解決策があります。",shape=box,color=blue];
		j526902421 -> j2741842295;
	j585485884 [label="Hah ! Oui, そう、健康的です。Très bien 気持ちが晴れたと聞いて嬉しいです。",shape=box,color=blue];
		j585485884 -> j123458901;
	j4117373029 [label="Oui, でもその経緯が無かったら、あなたは皆のお気に入りの狼さんでなくなるのではないですか。ソルはあなたを適切な場所に導いたと思います。",shape=box,color=blue];
		j4117373029 -> j4290639377;
	j2367042698 [label="Oui, まったく同感です。戦争のために生まれてくる人間はいません。まあ、「ぐりにや」は別かもしれませんが。それでも…",shape=box,color=blue];
		j2367042698 -> j184689589;
	j2741842295 [label="Des pâtisseries !",shape=box,color=blue];
		j2741842295 -> j4132951681;
	j123458901 [label="Ah ! 昼食の時間のようです。また後ほど…　狼さん、お話しできて楽しかったです。",shape=box,color=blue];
		j123458901 -> "Chat ends.";
	j4290639377 [label="でも仰りたいことは理解できます。他の人が受けた教育や導きを見て、自分もそういう道が切り開かれていたら、と思うのはとても自然かと。特にあなたがとても孤独だったころは。",shape=box,color=blue];
		j4290639377 -> j3823388737;
