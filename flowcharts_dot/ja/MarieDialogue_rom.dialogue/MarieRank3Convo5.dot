	j630903545 [label="焼き菓子の行方は？",shape=box,color=red];
		j630903545 -> j3599227520;
	j1045417654 [label="Oui, 足りる量を盗んでいました。しかし、皆と分けられるほど計画的に盗んできたのか、Lyonからの警告が分け合う合図であったのかは不明です。",shape=box,color=blue];
		j1045417654 -> j2289958;
