	j886429264 [label="悪魔はダメですけど。Sinon, il va les voler ! 　彼は自分の分が貰えないと横取りする癖があるんです。",shape=box,color=blue];
		j886429264 -> j420323306;
	j1149208040 [label="彼らはまだ回復中だ。旅はまだ終わっていない。",shape=box,color=red];
		j1149208040 -> j3093577916;
	j225226649 [label="もっと何かできることがあればいいのに。 ",shape=box,color=red];
		j225226649 -> j3093577916;
	j1542854142 [label="Oui, おっしゃる通りです。多くの人が信仰を求める理由には、人生の目的、つまり方向性を与えてくれると期待している場合があるのでしょう。",shape=box,color=blue];
		j1542854142 -> j3672350042;
	j153045540 [label="（グリニアとはそう書くのですね、merci !）少数でもそういうグリニアがいると聞いて嬉しいです。戦いが人生の唯一の目的だと教えられた種族でさえ、他の定めを見つけることができるのですね。",shape=box,color=blue];
		j153045540 -> j3010922666;
	j1120642786 [label="その意気です。悪魔だって、たまには焼き菓子を食べさせてあげてもよろしいかもしれません。",shape=box,color=blue];
		j1120642786 -> j2289958;
	j2906294499 [label="Je vous en prie. 少しでも元気づけられたら嬉しいです。私はあなたから元気をもらいましたから。",shape=box,color=blue];
		j2906294499 -> "Chat ends.";
	j3718551098 [label="Ah, 愚痴ばかりお聞かせして申し訳ないです。しかし、最低の悪魔だって、たまには焼き菓子を食べさせてあげてもよろしいかもしれません。",shape=box,color=blue];
		j3718551098 -> j2289958;
