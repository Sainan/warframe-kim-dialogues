		j420323306 -> j4136047554;
		j420323306 -> j684482966;
	j3093577916 [label="できる限りのことをしていると思います。彼らは必要な時にあなたの元へやってくるでしょう。",shape=box,color=blue];
		j3093577916 -> j3672350042;
	j3672350042 [label="多くの人が、答えにたどり着くことを願って進むべき道を見つけるのですから。",shape=box,color=blue];
		j3672350042 -> j2333483066;
		j3672350042 -> j488125036;
	j3010922666 [label="Boolean MarieGrineer is now true.",color=orange];
		j3010922666 -> j3672350042;
	j2289958 [label="さて、昼食の時間だそうです。お腹が空いてきました。少しでも元気づけられたら嬉しいです。私はあなたから元気をもらいましたから。",shape=box,color=blue];
		j2289958 -> "Chat ends.";
	j4136047554 [label="皆と分け合えるくらい持ってくる。",shape=box,color=red];
		j4136047554 -> j3091188358;
