	j1476653394 [label="Entratiとはどうやって出会ったの？",shape=box,color=red];
		j1476653394 -> j2955820960;
	j3315872298 [label="ここに来て、Entratiについて考えが変わった？",shape=box,color=red];
		j3315872298 -> j4196444516;
	j738393015 [label="[閉じる]",shape=box,color=red];
		j738393015 -> "Chat ends.";
	j2955820960 [label="私は彼をカーディナル・ディマンシュとして知りました。驚きかもしれませんが、彼は長い年月を教会で過ごし、信徒たちに教えを伝えていました。",shape=box,color=blue];
		j2955820960 -> j2178634750;
		j2955820960 -> j1258140424;
	j4196444516 [label="+5 Chemistry",color=orange];
		j4196444516 -> j3443021807;
	"Chat ends." [color=orange];
	j2178634750 [label="全て嘘だったと思う？　それとも信じていたと思う？",shape=box,color=red];
		j2178634750 -> j3948220878;
	j1258140424 [label="驚きはしない。彼は嘘が上手だ。",shape=box,color=red];
		j1258140424 -> j1039031980;
	j3443021807 [label="まぁ、とても丁寧な質問ですが、色々混みあって回答するのが難しいですね。巧妙な言い回しだと認めざる得ません。",shape=box,color=blue];
		j3443021807 -> j4240992937;
	j3948220878 [label="彼は許し、家族、共感について、とても熱心に、献身的に語りました。あれが演技だったとは私には信じられません。",shape=box,color=blue];
		j3948220878 -> j1167154705;
	j1039031980 [label="彼との経験が私とは違うのは承知しています。しかし、私にとって彼は本当に優しくて思いやりのある人だったということも理解していただきたいです。",shape=box,color=blue];
		j1039031980 -> j1731147834;
	j4240992937 [label="今も、彼が説教壇から教区民に向けて説教するのを拝めた日と同じ気持ちです。彼のおそばにいられて光栄でした。",shape=box,color=blue];
		j4240992937 -> j4033761768;
		j4240992937 -> j3454011724;
		j4240992937 -> j1988852558;
	j1167154705 [label="彼はルミナリーズを本当に信仰していたか？　ソルとルアを信じていたか？　彼の起源を知る今、確信は持てません。でも関係ありません。Peu importe。",shape=box,color=blue];
		j1167154705 -> j1089045529;
	j1731147834 [label="あなたが伝える真実が私の真実を否定するのでしょうか？　それによって私は誰を信じるべきか変えるべきなのでしょうか？　彼が教区で長年示してきた慈悲の行為、優しさの行為をすべて否定するべきなのでしょうか？",shape=box,color=blue];
		j1731147834 -> j3441319161;
	j4033761768 [label="そう言ってくれて嬉しい。みんな彼を非難するには早すぎると思う。",shape=box,color=red];
		j4033761768 -> j2175123551;
	j3454011724 [label="人々を騙すためにやっていたと思う？　それとも信じていたと思う？",shape=box,color=red];
		j3454011724 -> j3948220878;
	j1988852558 [label="彼に騙されていたと思うと…　残念だ。",shape=box,color=red];
		j1988852558 -> j1039031980;
	j1089045529 [label="心に愛があるのなら、祈る神々の名に意味はあるのでしょうか？　全くありません、と私は思います。",shape=box,color=blue];
		j1089045529 -> j3741395459;
		j1089045529 -> j4265952406;
	j3441319161 [label="Non。そうは思いません。",shape=box,color=blue];
		j3441319161 -> j3014523480;
	j2175123551 [label="+10 Chemistry",color=orange];
		j2175123551 -> j2134612387;
	j3741395459 [label="素敵な見方だ。",shape=box,color=red];
		j3741395459 -> j3219922755;
	j4265952406 [label="同意できない。優しい人間だからといって、慈悲の神々の信者になれるわけではない。",shape=box,color=red];
		j4265952406 -> j434406414;
	j3014523480 [label="申し訳ありませんが、あなたがどのような見解を持とうと、私は彼を怪物として扱いません。",shape=box,color=blue];
		j3014523480 -> j2209081154;
	j2134612387 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j2134612387 -> j2789956736;
	j3219922755 [label="カーディナルは、死後の世界でルミナリーズたちが彼を待っているとは信じていなかったとしても、魂の中で信仰を抱いていると私は信じています。",shape=box,color=blue];
		j3219922755 -> j3502695713;
	j434406414 [label="+5 Chemistry",color=orange];
		j434406414 -> j2887477155;
	j2209081154 [label="Boolean MarieEntratiMonster1 is now true.",color=orange];
		j2209081154 -> "Chat ends.";
	j2789956736 [label="まあ！　聞いて心が明るくなります。同士がいるとは思いませんでした。周りはカーディナルを悪く言う人ばかりですから。",shape=box,color=blue];
		j2789956736 -> j3544310626;
		j2789956736 -> j1021833882;
		j2789956736 -> j650473023;
	j3502695713 [label="なぜなら無関心の闇に対する共感の価値を知っている人間が他にいないからです、non？",shape=box,color=blue];
		j3502695713 -> j2413258194;
	j2887477155 [label="確かに、その通りです。意義もなしにソルの道に従っていても、ソルの信奉者とは呼びません。世界に善が増えれば世界はより良くなります。それがどんな名前で呼ばれようと、私には関係ありません。",shape=box,color=blue];
		j2887477155 -> j4046976409;
	j3544310626 [label="みんなに彼を許してもらえる方法があればいいんだけど。彼は最善を尽くしているだけなんだ。",shape=box,color=red];
		j3544310626 -> j2154133288;
	j1021833882 [label="それぞれの理由がある。でも無関心のモノを止めるには彼が必要なんだ。",shape=box,color=red];
		j1021833882 -> j826243817;
	j650473023 [label="Entratiも自分自身をあまり過大評価していないみたいだ。",shape=box,color=red];
		j650473023 -> j3581998943;
