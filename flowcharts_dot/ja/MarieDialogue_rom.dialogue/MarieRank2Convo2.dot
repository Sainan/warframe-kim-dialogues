	j826243817 [label="Add -1 to Thermostat counter",color=orange];
		j826243817 -> j234635654;
	j3581998943 [label="Oui, et comme c'est tragique...　考えるだけで涙が出ます。そしてLoid様も、二人の愛は漂流したままです。",shape=box,color=blue];
		j3581998943 -> j2846427398;
	j2407856504 [label="しかし、確かあなたは…　無関心のモノが実在すると信じていないのでしょう？　幻影だと。それでもあなたはその感情を信じているのですか？",shape=box,color=blue];
		j2407856504 -> j3190659193;
		j2407856504 -> j488400087;
	j4052544188 [label="彼が解き放ったモノに対抗するかのように、教えを伝えに来たのかもしれませんね、n'est-ce pas？",shape=box,color=blue];
		j4052544188 -> j3268420447;
		j4052544188 -> j2696134745;
		j4052544188 -> j2723554079;
	j3359672204 [label="Oui、それこそ私たちが目指す探求だと思います。",shape=box,color=blue];
		j3359672204 -> j2846427398;
	j234635654 [label="Oui、しかし、無関心のモノとの戦いは剣や石では勝てません。心で勝つ、そう思いませんか？",shape=box,color=blue];
		j234635654 -> j2846427398;
	j2846427398 [label="彼が私たちに許してほしいのは悪魔のオロキンではない、そうですよね？　カーディナル、そうなのでしょう。Loid様の愛がそれを促しているのだと思います。",shape=box,color=blue];
		j2846427398 -> j4148461874;
	j3190659193 [label="すべての感情には意味がある、無関心も含めて。",shape=box,color=red];
		j3190659193 -> j720988808;
