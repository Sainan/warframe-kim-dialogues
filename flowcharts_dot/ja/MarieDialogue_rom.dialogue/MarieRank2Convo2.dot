		j488400087 -> j3153976107;
	j3268420447 [label="どうすればその問題を解決するため動けるかしりたい。",shape=box,color=red];
		j3268420447 -> j3583903333;
	j2696134745 [label="「説教」以外で行動してほしかった。",shape=box,color=red];
		j2696134745 -> j3873526936;
	j2723554079 [label="アレが暴れまわっているのは彼のせいだし…　責任は取ってもらわないと困る。",shape=box,color=red];
		j2723554079 -> j992893419;
	j4148461874 [label="心が痛みます。二人が再会するのをただ願うばかりです！",shape=box,color=blue];
