		j2413258194 -> j2407856504 [label=true,color=green];
		j2413258194 -> j4052544188 [label=false,color=brown];
	j4046976409 [label="ですから、たとえカーディナルが信仰するものが私の知るものと異なっていても、彼は祝福されていると信じています。",shape=box,color=blue];
		j4046976409 -> j3502695713;
