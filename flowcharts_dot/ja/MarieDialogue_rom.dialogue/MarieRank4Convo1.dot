	j3912299351 [label="Lyonが被害に遭わないようにしたいんだ…",shape=box,color=red];
		j3912299351 -> j676488216;
	j580139003 [label="Marieからの助言をできる限り受け入れる。ただ、彼にどう伝えたらいいのか分からない。",shape=box,color=red];
		j580139003 -> j3654660006;
	j1613568714 [label="できる限りのことはするつもりだけど、ただ...　もっと力になれる方法はあるはずだ。",shape=box,color=red];
		j1613568714 -> j1526568732;
	j3726326078 [label="よくイライラ…　させられる。",shape=box,color=red];
		j3726326078 -> j3654660006;
	j3099279951 [label="でももしかしたら、もうご存知かもしれませんね。Lyonは見た目とは裏腹に苦しみに満ちていますから。",shape=box,color=blue];
		j3099279951 -> j2055486407;
