		j2343001963 -> j3196142596;
	j98176110 [label="Lyonが同じ運命を辿らないようにしたいのはお知り合いの事象のせいですか。それとも、この話題が心を動揺させているのですか？",shape=box,color=blue];
		j98176110 -> j435894801;
		j98176110 -> j3912299351;
	j3440784434 [label="それでも、辛い状況に閉じ込められて、最悪な方法でしか逃げ道がないと感じている人が身近にいるとしたら…　",shape=box,color=blue];
		j3440784434 -> j98176110;
