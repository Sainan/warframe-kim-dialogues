	j873604920 [label="[自傷行為に関する会話をすべて無効にします。どのキャラクターとの好感度も失われません]",shape=box,color=red];
		j873604920 -> j1035018767;
	j460019927 [label="正直、彼の幻覚が現実のものであってほしいのか、それとも偽物であってほしいのか分からない。",shape=box,color=red];
		j460019927 -> j972009604;
	j2698034463 [label="彼が見る恐ろしいものすべて。その描写の話…",shape=box,color=red];
		j2698034463 -> j972009604;
	j3535031470 [label="いつか、取り返しのつかないほど自分自身を傷付けてしまうかもしれないこと。",shape=box,color=red];
		j3535031470 -> j4231102213;
	j122294818 [label="Lyonのそばにいる時、自分の身に危険があると感じたことない？　気付かないうちにMarieを傷つけかもしれない、と。",shape=box,color=red];
		j122294818 -> j858852812;
	j1035018767 [label="Boolean LyonPainOff is now true.",color=orange];
		j1035018767 -> j1246470848;
	j972009604 [label="+5 Chemistry",color=orange];
		j972009604 -> j1317564664;
	j4231102213 [label="ああ…　話しにくい話題ですよね。申し訳ないのですが、私自身もこのことについて心を痛めずに話す方法がわかりません。",shape=box,color=blue];
		j4231102213 -> j1103203118;
	j858852812 [label="Lyonはきっと、私を傷つける前に自ら命を絶つと思います。私はあらゆる神々、そして悪魔を心から信じています。",shape=box,color=blue];
		j858852812 -> j1161380797;
	j1246470848 [label="+20 Chemistry",color=orange];
		j1246470848 -> j1378845383;
	j1317564664 [label="彼の心を満たす悪夢のことですか？　ルアは彼を困難な道へと導いているようですね。",shape=box,color=blue];
		j1317564664 -> j4012832487;
	j1103203118 [label="でもやってみます。彼のことが心配だからそうおっしゃるのでしょうか。",shape=box,color=blue];
		j1103203118 -> j2965889303;
		j1103203118 -> j3474585967;
	j1161380797 [label="- 無関心のモノでさえ、Lyonを騙して私に暴力を振るわせることに成功できなかったのです。 ",shape=box,color=blue];
		j1161380797 -> j2642935199;
	j1378845383 [label="[この操作により、自傷行為に関するすべての会話を回避します]",shape=box,color=blue];
		j1378845383 -> "Chat ends.";
	j4012832487 [label="残念なのですが、話すのが難しいです。あってはならないことと分かるから。",shape=box,color=blue];
		j4012832487 -> j105761512;
	j2965889303 [label="彼に血清が与えられたWARFRAMEは...　えっと...",shape=box,color=red];
		j2965889303 -> j2511793930;
		j2965889303 -> j57772603;
		j2965889303 -> j2605472756;
	j3474585967 [label="Lyonを見れば一目瞭然だ…　悪気はないんだ。見ただけでわかる。",shape=box,color=red];
		j3474585967 -> j2511793930;
		j3474585967 -> j57772603;
		j3474585967 -> j2605472756;
	j2642935199 [label="魂の兄弟を恐れる前に、蝶が私を丸ごと飲み込む可能性の方が高いと思います。",shape=box,color=blue];
		j2642935199 -> j4012832487;
	j105761512 [label="彼を止めたいのはやまやまです。彼の自分を傷つけたいという欲望から守りたくてしょうがありません。",shape=box,color=blue];
		j105761512 -> j1284688601;
	j2511793930 [label="ただ、いつかやり過ぎてしまうのではないかと心配なんだ。",shape=box,color=red];
		j2511793930 -> j4012832487;
	j57772603 [label="無傷でいて欲しいから。",shape=box,color=red];
		j57772603 -> j4125015395;
	j2605472756 [label="彼が帰らぬ人になったら…　と心配でしょうがない。",shape=box,color=red];
		j2605472756 -> j297675919;
	j1284688601 [label="Lyonについて確実なことが一つあるとすれば、どんな理由であれ、あなたが彼を必要とするとき、一緒にいてくれるということです。",shape=box,color=blue];
		j1284688601 -> j2700659898;
	j4125015395 [label="あなたは悪魔の言葉を繰り返しているようです。あなたを奮い立たせるのは、有能な手ヘの冷酷な欲求だけなのですか？",shape=box,color=blue];
		j4125015395 -> j683950155;
		j4125015395 -> j4017452888;
	j297675919 [label="Dégoûtant - 信じられません。",shape=box,color=blue];
		j297675919 -> j1508231473;
	j2700659898 [label="Lyonは偉大な守護者、le bouclier sacré de Lua - ルアの聖なる盾....　夜の闇に輝く光です。",shape=box,color=blue];
		j2700659898 -> j1726144111;
	j683950155 [label="そんなことはない。Lyonのことは大事に思っている。ただ…　必要な時に彼がいないのが心配なんだ。",shape=box,color=red];
		j683950155 -> j1284688601;
	j4017452888 [label="自分が知りたいのは、彼を頼りにしてもいいかどうかだ。すでに心が崩壊しているのなら、頼りにできない。",shape=box,color=red];
		j4017452888 -> j723831789;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j1726144111 [label="彼が自らに与える痛み…　それは、自らの思考を聞くため、自らの体の痛みを感じるためなのです。",shape=box,color=blue];
		j1726144111 -> j2188703421;
	j723831789 [label="あなたが困窮し、助けが必要なとき、誰が助けてくれるのでしょう。",shape=box,color=blue];
		j723831789 -> j3037583312;
	j2188703421 [label="空を満たす星々は、彼にささやくのです。そのささやきを聞いたLyonはいつか、ルア自身のように星々の中に埋もれてしまうのでしょう。",shape=box,color=blue];
		j2188703421 -> j3562329542;
	j3037583312 [label="それとも、救いの手を差し伸べる時間はもう過ぎ去り、助けの余地がないと信じているのですか？",shape=box,color=blue];
		j3037583312 -> j297675919;
	j3562329542 [label="そしてルアのように、満ちたり欠けたりする段階を幾度も経てVoidに飲み込まれ、輝きを放つでしょう。私たち残されたもの達が恐れることなく闇の中を歩めるように。",shape=box,color=blue];
		j3562329542 -> j1631737277;
	j1631737277 [label="特別な能力を持ち合わせるものは幸運なだけでなく、災いも伴うものです。ご理解いただけますか。ただの独り言のように聞こえますか？",shape=box,color=blue];
		j1631737277 -> j676991163;
		j1631737277 -> j2511592588;
		j1631737277 -> j2299992023;
		j1631737277 -> j395954501;
		j1631737277 -> j830231851;
	j676991163 [label="十分理解しているつもりだ。それから…　ちょっと告白させてほしい。[Lyonへの想いを告白する]",shape=box,color=red];
		j676991163 -> j1723741983;
	j2511592588 [label="Marieが言いたいことは分かる。でも、自傷行為は許せない。止めるべきだ。",shape=box,color=red];
		j2511592588 -> j11491687;
	j2299992023 [label="[警告：自ら命を絶つことに関する題材です] かつて、そのような自傷行為で人を失ったことがある。許す…　ことができないんだ。",shape=box,color=red];
		j2299992023 -> j4038565006;
	j395954501 [label="他に方法があるはず。",shape=box,color=red];
		j395954501 -> j2803625223;
	j830231851 [label="言ってることは分かる。ただ…　彼を助けたいんだ。",shape=box,color=red];
