		j2679143863 -> j3726326078;
	j1218199674 [label="ああ、嬉しいを超えるくらい嬉しいです。Tellement ravie！　Lyonはどれだけ愛情に飢えているか知る由もないでしょう。",shape=box,color=blue];
		j1218199674 -> j3099279951;
	j3974858523 [label="ああ、まるで statue de marbre - 大理石の彫像に話しかけているみたいですものね。お気持ちを察します。私もよく、20分ほど熱心に語っていても、聞き手が聞いていなくてがっかりすることがあります。",shape=box,color=blue];
		j3974858523 -> j3519064706;
	j3196142596 [label="行間を読むことを学ばないといけませんね、non？　Lyonはたとえ話で語ります。言葉で表さないなら、行動に耳を傾けてみてください。",shape=box,color=blue];
		j3196142596 -> j2446370256;
	j435894801 [label="お願いだから…　この話題は避けて欲しい。無理なんだ。",shape=box,color=red];
