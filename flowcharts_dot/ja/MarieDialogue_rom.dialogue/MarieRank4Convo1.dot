		j1403127760 -> j758510050;
	j1734334787 [label="誰にもこの秘密は言わないさ。",shape=box,color=red];
		j1734334787 -> j2511653256;
	j3096741974 [label="声が詰まった時のことを今でも鮮明に覚えています。しかし、私は強くならなければいけなかったのです。その時でさえ、他の人々に対する義務があることを認識していましたから。",shape=box,color=blue];
		j3096741974 -> j1793032409;
	j2800537863 [label="しかし、重荷に疲れて果ててしまったようです。文字を読み書きさえままならない私は、泥沼に陥っていました。",shape=box,color=blue];
		j2800537863 -> j716794340;
