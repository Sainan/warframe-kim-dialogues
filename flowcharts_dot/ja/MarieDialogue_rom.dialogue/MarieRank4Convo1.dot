		j861143780 -> j3698613401;
		j861143780 -> j3886117942;
	j2430536603 [label="彼に「野良犬と比べられていた」と言わないでください。お願いです、oui...",shape=box,color=blue];
		j2430536603 -> j1672678032;
	j1226980094 [label="Je...　詳細は省きます。きっとご想像がつくと思うので。",shape=box,color=blue];
