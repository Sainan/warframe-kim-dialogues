	j2643822400 [label="行間を読むことを学ばないといけませんね、non？　Lyonはたとえ話で語ります。言葉で表さないなら、行動に耳を傾けてみてください。",shape=box,color=blue];
		j2643822400 -> j720957795;
	j720957795 [label="でも、あなたの善意は親切の押し売りではなく、Lyonへの気遣いだと分かっています。Lyonもきっと理解してくれるでしょう。Lyonは野良犬の様で、足に傷跡があります。傷は「治った」のですが、後遺症があるようで、常に痛みやかゆみが伴っていました。",shape=box,color=blue];
		j720957795 -> j1666465186;
	j2858760954 [label="え？　干渉してくれと頼んだわけではない。",shape=box,color=red];
		j2858760954 -> j309375235;
	j2923680037 [label="心配した方がいい？",shape=box,color=red];
		j2923680037 -> j309375235;
	j1100003858 [label="手伝ってくれたら嬉しい。",shape=box,color=red];
		j1100003858 -> j2894743739;
	j81551795 [label="Lyonは野良犬の様で、足に傷跡があります。傷は「治った」のですが、後遺症があるようで、常に痛みやかゆみが伴っていました。",shape=box,color=blue];
		j81551795 -> j1666465186;
