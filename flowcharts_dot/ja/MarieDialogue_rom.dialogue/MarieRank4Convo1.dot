	j2511653256 [label="Merci！　ホッとしました。",shape=box,color=blue];
		j2511653256 -> "Chat ends.";
	j1793032409 [label="Hugoはいつでも幸せそうに見えた、と他のお友達は口をそろえて言いました。そう、 Si joyeux - 幸せそう。笑いと冷笑を織り込んで、人生に立ち向かっていたHugo。",shape=box,color=blue];
