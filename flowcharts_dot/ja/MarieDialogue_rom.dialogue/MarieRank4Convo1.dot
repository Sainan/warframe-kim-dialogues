		j735512819 -> j3440784434;
	j696394026 [label="彼が心の支えを必要にしているとき、一緒に座ったり、泣きながら話す言葉を熱心に聞いたり、背中をさすってあげたり…　すべてを受け止めてあげることが大切なんだと心得ています。",shape=box,color=blue];
		j696394026 -> j2679143863;
