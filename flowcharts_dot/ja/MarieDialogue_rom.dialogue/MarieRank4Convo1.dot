		j660126702 -> j3996623948;
		j660126702 -> j735512819;
	j2600107190 [label="鳥のヒナを助けることは、最終的に命を奪うことになる場合もあります。ろうそくの炎を強くするために息を吹きかけると、誤って炎を吹き消してしまうかもしれません。",shape=box,color=blue];
		j2600107190 -> j696394026;
	j347242708 [label="でも本当に嬉しいお知らせです。",shape=box,color=blue];
		j347242708 -> j1014465487;
		j347242708 -> j2009425276;
	j3015114569 [label="彼が心の支えを必要にしているとき、そばにいたり、泣きながら話す言葉を熱心に聞いたり、背中をさすってあげたり…　すべてを受け止めてあげることが大切なんだと心得ています。",shape=box,color=blue];
