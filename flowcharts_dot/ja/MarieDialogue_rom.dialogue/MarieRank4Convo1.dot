	j2329812043 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j2329812043 -> j692202294;
	j3734193460 [label="もちろん、傷は深まるばかりなのですが、彼の一部だったんです。もしあなたが avec colère - 無理やり近づいたり、厳しい態度を取ると、尻込みをしました。",shape=box,color=blue];
		j3734193460 -> j517121430;
	j2311124113 [label="幼い頃、路上で物乞いをしていたことを話しましたが、覚えていらっしゃいますか。友達も多く、報酬も豊かだったのですよ。",shape=box,color=blue];
		j2311124113 -> j557564914;
	j692202294 [label="驚くかもしれませんが、実は裕福な famille 家庭に生まれました。ブルジョア階級で、オロキンに近い存在です。",shape=box,color=blue];
		j692202294 -> j2022498400;
	j517121430 [label="野良の信頼は得るものです。じっと待ち、その時が実際来るのを待つのが一番、non？　そうではありませんか？",shape=box,color=blue];
		j517121430 -> j1338488195;
		j517121430 -> j2003542999;
		j517121430 -> j3211391384;
	j557564914 [label="お友達のうち、一人はHugoという名前の体の大きな年上の男の子でした。",shape=box,color=blue];
		j557564914 -> j1860821430;
	j2022498400 [label="しかし、生まれつき足が不自由で… mes pieds tordus et inutilisables。マモン ma mère は耐えられなかったようです。",shape=box,color=blue];
		j2022498400 -> j2562176494;
	j1338488195 [label="うん、良く分かる。ありがとう。",shape=box,color=red];
		j1338488195 -> j727136115;
	j2003542999 [label="うん、ビックリするくらい分かる。",shape=box,color=red];
		j2003542999 -> j3582132186;
	j3211391384 [label="わからない。でも詳しく説明してくれてありがとう。",shape=box,color=red];
		j3211391384 -> j1747960153;
	j1860821430 [label="ちょっとしたリーダー的存在で、私をいじめないように、そして私が必要なものは手に入るよう、いつも気配りしてくれたんです。",shape=box,color=blue];
		j1860821430 -> j1755432084;
	j2562176494 [label="体裁を保たなければいけなかったのでしょう。守るべき「基準」を。",shape=box,color=blue];
		j2562176494 -> j3551309541;
	j727136115 [label="Bien！　安心しました。私の比喩が伝わらなかったのか心配でした。",shape=box,color=blue];
		j727136115 -> j2088172500;
	j3582132186 [label="Marieの比喩は分かりにくいですよね。Ah, bon.",shape=box,color=blue];
		j3582132186 -> j2088172500;
	j1747960153 [label="Mince alors. あらら、私の比喩がまた伝わっていませんでしたね。",shape=box,color=blue];
		j1747960153 -> j2088172500;
	j1755432084 [label="「des béquilles」を作るのを手伝ってくれました。マツバヅエとでも言うのでしょうか。体を引きずって歩くのに使える、拾ってきた木片で作ったものでした。",shape=box,color=blue];
		j1755432084 -> j493598107;
	j3551309541 [label="そうすると、動かぬ足と共に生まれたMarieはどうすればいいのでしょう。la Cité de la Lumièreに連れていかれ、自力で生きていくよう仕向けられました。",shape=box,color=blue];
		j3551309541 -> j861143780;
	j2088172500 [label="Hm. Lyonを野良犬と表現するのは、分かりにくい表現かもしれませんね。",shape=box,color=blue];
		j2088172500 -> j2430536603;
	j493598107 [label="ある朝、起こしに行ったら…",shape=box,color=blue];
		j493598107 -> j1226980094;
