		j714426695 -> j3215002372 [label=false,color=brown];
	j1118891906 [label="しかし、他の人の心の中の痛みは、本人以外計り知れないのです。彼が残した置手紙で、どんなにルアと涙を流していたか、やっと分かったのです。",shape=box,color=blue];
		j1118891906 -> j1624880722;
	j149067554 [label="あなたがおっしゃった通りですよね non？　不都合には必ず秘密の力が宿る、と。",shape=box,color=blue];
		j149067554 -> j3215002372;
	j3215002372 [label="une indésirable pour ma mère マモンにとって望ましくない私だったけど、孤児の間では人気者になれたんです。",shape=box,color=blue];
		j3215002372 -> j2243627046;
	j1624880722 [label="彼は今、彼女の傍らで安らかに眠っていると信じています。しばらくの間、彼を許せなかったし、恨んでもいました。他の子たちが私に導きを求め出したから。彼は私を捨てたと思っていたんです。",shape=box,color=blue];
		j1624880722 -> j2805431403;
	j2243627046 [label="障害を持つ子供より哀れなものはありません。他の子達が一週間かけて盗み事をしても、私はたった一日で彼らの成果より多く稼げるのですから。",shape=box,color=blue];
		j2243627046 -> j4249441761;
	j2805431403 [label="しかし、時間が経つにつれて、真実を理解できるようになりました。",shape=box,color=blue];
		j2805431403 -> j2796807476;
	j4249441761 [label="お友達と報酬を分け合うのが大好きだった私を気にかけ、世話をしてくれる友達がたくさんいました。そのうち一人が、Hugoという名前の体の大きい年上の男の子でした。",shape=box,color=blue];
		j4249441761 -> j1860821430;
	j2796807476 [label="私たちにできるのは、人間である自分自身を許すことだけです。そして、他の人が去っていく痛みも許すことです。",shape=box,color=blue];
		j2796807476 -> j1693827944;
	j1693827944 [label="去った者の心の支えになれなかったことが一番つらいのです。もっと助ける方法はなかったのだろうか、自問自答を繰り返して、自分で自分の首をしめるようなものです。",shape=box,color=blue];
		j1693827944 -> j265780720;
	j265780720 [label="他人が背負っている重荷をそう簡単に理解できません。",shape=box,color=blue];
		j265780720 -> j2580782311;
	j2580782311 [label="とても tragédie - 悲しいことです。しかし、それが人間であることの意味かもしれません。",shape=box,color=blue];
		j2580782311 -> j3155524751;
	j3155524751 [label="この話がお役に立てたかどうかは分かりません。でも、そうであることを祈るばかりです。Loid様が呼んでいます。また次の機会にお話ししましょう。",shape=box,color=blue];
		j3155524751 -> j6710414;
