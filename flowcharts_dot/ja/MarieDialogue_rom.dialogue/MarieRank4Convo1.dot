		j1672678032 -> j1403127760;
		j1672678032 -> j1734334787;
	j1170462940 [label="置手紙を残してくれたのです。ほとんど判読できませんでしたが…　子供たちの中で字を読めるのは私だけだったので、他の子たちに内容を伝えるのは私の役目になりました。",shape=box,color=blue];
		j1170462940 -> j3096741974;
	j152705914 [label="6歳？　７歳？　両親は何年もかけて、障害を乗り越えようと頑張ってくれたようですが…　歩き方を教えてくれた家庭教師。矯正器具や靴など…",shape=box,color=blue];
		j152705914 -> j2800537863;
	j4283088434 [label="両親は何年もかけて、障害を乗り越えようと頑張ってくれたようですが…　歩き方を教えてくれた家庭教師。矯正器具や靴など…",shape=box,color=blue];
		j4283088434 -> j2800537863;
