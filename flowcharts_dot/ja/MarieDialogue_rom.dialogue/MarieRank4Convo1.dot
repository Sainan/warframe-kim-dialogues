	j2803625223 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j2803625223 -> j2508377305;
	j3184973199 [label="自分の…　心を掴んだようだ。苦しんでいるのを見ると胸が張り裂けそうなんだ。",shape=box,color=red];
		j3184973199 -> j4210637843;
	j63484801 [label="Lyonが感じる痛みは、肉体に与える痛みよりも深いものです。もはや自ら与える痛みから抜け出すことができないところまで来ているようです。",shape=box,color=blue];
		j63484801 -> j3789243252;
	j536848204 [label="ああ、そうなのですね。本当にお気の毒です。どんなに哀れな決まり文句やお祈りを捧げても、心の穴を塞ぐことができないでしょう。",shape=box,color=blue];
		j536848204 -> j2588061844;
