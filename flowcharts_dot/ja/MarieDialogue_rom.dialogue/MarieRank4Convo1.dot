		j2508377305 -> j3366990923;
	j4210637843 [label="+20 Chemistry",color=orange];
		j4210637843 -> j1997981032;
	j3789243252 [label="肉体的な痛みは心を清め、魂を落ち着かせます。そして今、PROTOFRAMEとして…　私がWispであるように、彼はHarrowとして…　PROTOFRAMEに化したからと、彼の命を奪うことはないですよね、oui ？",shape=box,color=blue];
		j3789243252 -> j3818386809;
		j3789243252 -> j2433749253;
	j2588061844 [label="あなたの歴史を知らない人が、人生における tragédie - 悲劇に慰めとなるような弔意を表せるはずがありません。",shape=box,color=blue];
		j2588061844 -> j660126702;
	j3366990923 [label="そう言っていただいて尊敬の心でいっぱいです。しかし、「助け」は様々な方法があると信じています。",shape=box,color=blue];
		j3366990923 -> j2600107190;
	j1997981032 [label="ああ！　まるでネズミを発見したように叫んでしまい、Loid様を驚かせてしまいました。Pardon !!",shape=box,color=blue];
		j1997981032 -> j347242708;
