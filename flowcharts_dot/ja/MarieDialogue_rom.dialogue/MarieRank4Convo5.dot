		1629 -> 1632 [label="false",color=purple];
	2930 [label="漂流者様！　作戦を企んでいました。",shape=box,color=blue];
		2930 -> 2931;
		2930 -> 2932;
	1630 [label="漂流者様！　作戦を企んでいました。上の階の家族についておっしゃったことを思い出して、ずっと考えていました。もしかしたら私たちを侵入者と思っているかもしれないと。",shape=box,color=blue];
		1630 -> 1633;
	1631 [label="漂流者様！　上の階の家族についておっしゃったことを思い出して、ずっと考えていました。この家族のことを考えると胸が痛みます。",shape=box,color=blue];
		1631 -> 1634;
	1632 [label="どうして私たちは上の階に上がれないのですか。Le Cardinal famille - カーディナルの家族と呼ぶ人たちと会話を交わせないのですか？",shape=box,color=blue];
		1632 -> 1635;
		1632 -> 1636;
	2931 [label="ちょっと怖いな。",shape=box,color=red];
		2931 -> 2934;
	2932 [label="[閉じる]",shape=box,color=red];
		2932 -> 2933;
	1633 [label="「別の家族」とcompétition - 争いにあると、oui ？　私はとても悩んでいます。",shape=box,color=blue];
		1633 -> 1634;
	1634 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1634 -> 1637 [label=true,color=green];
		1634 -> 1638 [label=false,color=brown];
	1635 [label="まぁ…　簡単に言うと、Entratiの家族の何人かが上の階にいて、彼らは…　自分たちがここにいることを把握していないんだ。",shape=box,color=red];
		1635 -> 1639;
	1636 [label="[閉じる]",shape=box,color=red];
		1636 -> 1640;
	2934 [label="Oui。小さな空飛ぶロボット…　ネクロ…　ネクロ…　何て呼ぶのでしたか？",shape=box,color=blue];
		2934 -> 2935;
	2933 [label="Chat ends.",color=orange];
	1637 [label="カーディナルに対してどれだけ愛情を持っているか競うつもりはありません。どうすればこのことを理解してもらえるのでしょうか。",shape=box,color=blue];
		1637 -> 1641;
		1637 -> 1642;
		1637 -> 1643;
	1638 [label="心の葛藤を修復する任務は順調に進んでいますか？",shape=box,color=blue];
		1638 -> 1644;
		1638 -> 1645;
		1638 -> 1646;
		1638 -> 1647;
	1639 [label="Update boolean MarieFamily1",color=orange];
		1639 -> 1648;
	1640 [label="Chat ends.",color=orange];
	2935 [label="ネクロマイト？",shape=box,color=red];
		2935 -> 2936;
	1641 [label="そうだな。これ以上与えてくれることがない人から何かを得ようとするのは間違っているかもしれない。",shape=box,color=red];
		1641 -> 1649;
	1642 [label="かさぶただらけの傷口を開くのは危険だ。感染症を治せる可能性がある代わり…　傷を開き出血してしまうかもしれない。",shape=box,color=red];
		1642 -> 1650;
	1643 [label="Marie…　というか自分たち全員、共通点がある。ある時Entratiに見捨てられたということ。",shape=box,color=red];
		1643 -> 1651;
	1644 [label="正直なところ、気が散ってうまくいってない。",shape=box,color=red];
		1644 -> 1652;
	1645 [label="もう少し努力できる余地がある。",shape=box,color=red];
		1645 -> 1653;
	1646 [label="順調に進んでいる。",shape=box,color=red];
		1646 -> 1654;
	1647 [label="[閉じる]",shape=box,color=red];
		1647 -> 1655;
	1648 [label="まあ…　つまり私たちは秘密裏にここにいると？　それがここを出てはならない理由なのですか？！Mais pourquoi？！",shape=box,color=blue];
		1648 -> 1656;
	2936 [label="Oui ! Ha !  家具の交換に執着しているようです。でも物を移動することと…　同じことをするんですね。",shape=box,color=blue];
		2936 -> 2937;
