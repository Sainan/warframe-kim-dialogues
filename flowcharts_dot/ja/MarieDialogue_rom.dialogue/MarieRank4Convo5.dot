		1651 -> 1673 [label="MarieEntratiNeutral",color=purple];
		1651 -> 1674 [label="false",color=purple];
	1652 [label="一体何に気を取られているのですか。Mécontents - 不服を抱いている者の不満を整理することより大事なことがあるとおっしゃるのですか。",shape=box,color=blue];
		1652 -> 1676;
	1653 [label="Mécontents - 不服を抱いている者の不満を整理することより大事なことがあるとおっしゃるのですか。",shape=box,color=blue];
		1653 -> 1677;
	1654 [label="Oh, magnifique !　素晴らしい。",shape=box,color=blue];
		1654 -> 1678;
	1655 [label="Chat ends.",color=orange];
	1656 [label="Entratiの娘、Euleria、通称Motherね、それと彼女の家族は、ずっとダイモスの管理をしてきた。",shape=box,color=red];
		1656 -> 1679;
	2937 [label="家具を全部移動して、業者に交換してもらい、また同じことを繰り返す…　をやってみようかと思うくらいです。Ce mobilier étrange - 変な家具を全部売り払って利益を得ることもできるのではないでしょうか。",shape=box,color=blue];
		2937 -> 2938;
		2937 -> 2939;
		2937 -> 2940;
	1658 [label="カーディナルに対する意見が違うことは承知しています。この話し合いを civilisée - 礼儀正しく進めたいです。",shape=box,color=blue];
		1658 -> 1680;
	1661 [label="責任がある人たちを指摘する機会がないのなら、傷を修復するための話し合いをしたくない気持ち、分かります。",shape=box,color=blue];
		1661 -> 1680;
	1657 [label="Oui！　いつも思い出させてくれるように、彼を un monstre - 怪物だと信じているのですね。心には悪意と空虚さしかない。",shape=box,color=blue];
		1657 -> 1680;
	1659 [label="カーディナルの魂をめぐるこの戦いにおいて、あなたが私の味方でいてくれると信じていたのですが…",shape=box,color=blue];
		1659 -> 1681;
	1660 [label="カーディナルの人格をまだ判定しきっていないと思っていましたが…　考えが変わったのでしょうか。",shape=box,color=blue];
		1660 -> 1682;
		1660 -> 1683;
	1668 [label="Oui. Tagfer様の件で学びました。",shape=box,color=blue];
		1668 -> 1686;
	1662 [label="かさぶただらけの傷の話はお断りです、狼さん。前回カーディナルの話をしたときに負った傷をまだ引きずっているのですから。",shape=box,color=blue];
		1662 -> 1680;
	1663 [label="Oui。あなたも以前、こう言いました。私たちが受けた傷についてお互いを責めるのを辞めよう、と。",shape=box,color=blue];
		1663 -> 1684;
	1664 [label="あなたは、カーディナルが深い傷を負わせた恐ろしい怪物だと信じていることを知っています。",shape=box,color=blue];
		1664 -> 1680;
	1665 [label="カーディナルの魂をめぐるこの戦いにおいて、あなたが私の味方でいてくれることを知っています。そのことについては永遠に感謝します。",shape=box,color=blue];
		1665 -> 1666;
	1667 [label="あなたがカーディナルを簡単に批判しないよう努力されていることは知っています。そのことに私は感謝します。",shape=box,color=blue];
		1667 -> 1666;
	1666 [label="他の方たちがすぐに彼を責めるのは分かっています。しかし、皆で協力し合えるときに、バラバラな行動をとって血を流すのは見たくありません。",shape=box,color=blue];
		1666 -> 1685;
	1675 [label="Oui, Tagfer様と同じように学んできますが、全員が同じ程度、見捨てられたのではないのかもしれません。",shape=box,color=blue];
		1675 -> 1686;
	1669 [label="あなたがとても「親切に」指摘してくれたように、全員が同じ程度見捨てられたわけではないようですが。",shape=box,color=blue];
		1669 -> 1680;
	1670 [label="そうですね。カーディナルが去ったことを責めるつもりはありません。彼の定めは sacro-saint - きわめて神聖ですから…",shape=box,color=blue];
		1670 -> 1666;
	1671 [label="そして、あなたは、カーディナルが深い傷を負わせた恐ろしい怪物だと信じていることを知っています。",shape=box,color=blue];
		1671 -> 1680;
	1672 [label="カーディナルの魂をめぐるこの戦いにおいて、あなたが私の味方でいてくれることを知っています。そのことについては永遠に感謝します。",shape=box,color=blue];
		1672 -> 1666;
	1673 [label="あなたがカーディナルを簡単に批判しないよう努力されていることは知っています。そのことに私は感謝します。",shape=box,color=blue];
		1673 -> 1666;
	1674 [label="他の方たちがすぐに彼を責めるのは分かっています。しかし、皆で協力し合えるときに、バラバラな行動をとって争うことになるのを避けたいのです。",shape=box,color=blue];
		1674 -> 1685;
	1676 [label="冗談です。さまざまな場所や「時代」で必要とされているあなたは、猫の手も借りたいほどお忙しいことと心得ています。",shape=box,color=blue];
		1676 -> 1678;
	1677 [label="冗談です。彼らの苦悩はさぞかし辛いものでしょう。この辛い思いを癒すお手伝いはさぞかし難しい課題だと心得ています。",shape=box,color=blue];
		1677 -> 1678;
	1678 [label="あの家族の問題が解消されない限り、一緒に食卓を囲むことはないのではと、勝手ながら心配していました。大きな悩みは未解消なままなので…　",shape=box,color=blue];
		1678 -> 1637;
	1679 [label="Entratiが去ってからずっと、この場所と、VoidからOrigin太陽系へエネルギーを送る心臓を監視して、自分たちが…　力を維持できるようにしてるんだ。",shape=box,color=red];
		1679 -> 1687;
	2938 [label="Entratiの椅子に価値はないんじゃないかな。",shape=box,color=red];
		2938 -> 2942;
	2939 [label="どこにでも溢れるほどあるくらい商品が増えるんじゃない？　値段がかなり叩かれると思うけど…　",shape=box,color=red];
		2939 -> 2942;
	2940 [label="グッドアイデア。今すぐ始めよう。",shape=box,color=red];
		2940 -> 2941;
	1680 [label="この話題2つは密接に関連していることを承知しています。でも今日は平穏な一日を過ごせませんか。",shape=box,color=blue];
		1680 -> 1688;
	1681 [label="狼さん、これはいったい何のごまかしですか。私とun jeu - お遊びしていただけなのですか。",shape=box,color=blue];
		1681 -> 1689;
		1681 -> 1683;
	1682 [label="彼の行動の必要性についてはまだ判断しかねる。でも、冷酷な性格はまったく尊敬できない。",shape=box,color=red];
		1682 -> 1680;
	1683 [label="ごまかすのに疲れた、Marie。ごめん。",shape=box,color=red];
		1683 -> 1690;
	1686 [label="私たちが受けた傷についてお互いを責めるのを辞めましょう。",shape=box,color=blue];
		1686 -> 1684;
	1684 [label="カーディナルを責めることに私も賛成しません。でも団結して一緒に困難を乗り越えていく方がよっぽど良い策だと信じています。",shape=box,color=blue];
		1684 -> 1691;
		1684 -> 1692;
	1685 [label="誰のせいであっても、私たちが受けた傷についてお互いを責めるのを辞めましょう。",shape=box,color=blue];
		1685 -> 1691;
		1685 -> 1692;
	1687 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1687 -> 1693 [label=true,color=green];
		1687 -> 1694 [label=false,color=brown];
	2942 [label="Pff ! 私には価値がある実験です。多くの本棚で悪魔を囲むことができるかもしれません。",shape=box,color=blue];
		2942 -> 2943;
	2941 [label="私は本気です。あなたの皮肉は忠実に無視します。私には価値がある実験なんです。多くの本棚で悪魔を囲むことができるかもしれません。",shape=box,color=blue];
		2941 -> 2943;
	1688 [label="私は喧嘩するより…　奇妙な共存を共にする方々を助けたいのです。",shape=box,color=blue];
		1688 -> 1686;
	1689 [label="いや、お遊びではない。Entratiは信用できないけど、Marieの味方をしているふりをする以外、Marieを説得する方法が分からないんだ。",shape=box,color=red];
		1689 -> 1695;
	1690 [label="Oui ? 　もうその様なごまかしは必要ありません。",shape=box,color=blue];
		1690 -> 1696;
	1691 [label="全員が一つになると、奇妙な家族になるな。でも、それでも絆の強い家族になれると思う。",shape=box,color=red];
		1691 -> 1697;
	1692 [label="バラバラに行動するより、力を合わせた方が良いもんな。",shape=box,color=red];
		1692 -> 1698;
		1692 -> 1699;
	1693 [label="彼女はAlbrechtの不在を受け入れ、家族は和解したけど、それは苦労して勝ち取ったものだ。",shape=box,color=red];
		1693 -> 1700;
	1694 [label="彼女はAlbrechtの不在をまだ受け入れていなくて、家族は今もいがみ合っている。",shape=box,color=red];
		1694 -> 1701;
	2943 [label="+20 Chemistry",color=orange];
		2943 -> 2944;
	1695 [label="Oui ? そうですか。残念ながら失敗に終わりそうです。",shape=box,color=blue];
		1695 -> 1696;
	1696 [label="Update boolean MarieEntratiFan1",color=orange];
		1696 -> 1702;
	1697 [label="Add +1 to Family",color=orange];
		1697 -> 1698;
		1697 -> 1699;
	1698 [label="苦しい時、本当に頼れるのはお互いだけかもしれない。「与えられた」形でも、自ら見つけた形でも。",shape=box,color=red];
		1698 -> 1703;
	1699 [label="長い目でみて、団結することが役に立つのか、害になるのかは分からない。でもこの…　苦難の場も正しくない。",shape=box,color=red];
		1699 -> 1704;
	1700 [label="自分が、彼がまだ外で暴れ回っていて、彼女には一言もなしに、手紙さえ送っていないことを知りながら…？",shape=box,color=red];
		1700 -> 1705;
	1701 [label="自分が、彼がまだ外で暴れ回っていて、彼女には一言もなしに、手紙さえ送っていないことを知りながら…？",shape=box,color=red];
		1701 -> 1706;
	2944 [label="今日は忙しい日になりそうです。À la revoyure !",shape=box,color=blue];
		2944 -> 2929;
	1702 [label="Update boolean MarieEntratiFan2",color=orange];
		1702 -> 1707;
	1703 [label="Add +1 to Family",color=orange];
		1703 -> 1704;
	1704 [label="Oui, 同感です。でも、私は上の階の家族との溝を埋められません。どうすればいいのかさっぱり分かりません。上の階の方にとって、私は赤の他人なので…",shape=box,color=blue];
		1704 -> 1708;
		1704 -> 1709;
	1705 [label="それが彼女と、家族にとってどれだけ辛いか、想像もつかない。",shape=box,color=red];
		1705 -> 1710;
	1706 [label="もうあの家族の和解は無理なのかもしれない。",shape=box,color=red];
		1706 -> 1711;
	2929 [label="Chat ends.",color=orange];
	1707 [label="Update boolean MarieNoDate",color=orange];
		1707 -> 1712;
	1708 [label="Loidはエントラティ家を知っていた。彼に任せよう。でも、彼を説得するのは…　骨が折れそうだ。",shape=box,color=red];
		1708 -> 1713;
	1709 [label="Roatheはどうだろう。彼はオロキンだから、あの家族のことを知ってたはずだ。",shape=box,color=red];
		1709 -> 1714;
	1710 [label="カーディナルの不在によって生じた苦痛から、彼らを守ろうとする決断の論理は理解できますが…",shape=box,color=blue];
		1710 -> 1715;
	1711 [label="Oui…　なるほど。それなら家族の絆を修復するために動いたほうが良いのでは、non？　それが、ここから出るための唯一の手段だと思いますが。",shape=box,color=blue];
		1711 -> 1716;
	1712 [label="Chat ends.",color=orange];
	1713 [label="+5 Chemistry",color=orange];
		1713 -> 1717;
	1714 [label="Non, 悪魔は無理です。絶対無理。でも、何かに気づいているのではないでしょうか。明らかな選択肢はMonsieur Loidではありませんか？",shape=box,color=blue];
		1714 -> 1718;
	1715 [label="不必要に残酷だとは思いませんか？　もう死んでいるのか、それ以上に酷いことが起きているのかも知らないのです。それを私たちは黙って…　comme des rats d'égout？",shape=box,color=blue];
		1715 -> 1719;
		1715 -> 1720;
		1715 -> 1721;
	1716 [label="それか余生をここで過ごすかですね、comme des rats d'égout。",shape=box,color=blue];
		1716 -> 1722;
		1716 -> 1723;
	1717 [label="Oui, oui ! C'est ça ! そうです。でもどうやって説得すればいいのでしょう。彼はいつも立場を固守してきました。",shape=box,color=blue];
		1717 -> 1724;
		1717 -> 1725;
	1718 [label="でもどうやって説得すればいいのでしょう。彼はいつも立場を固守してきました。",shape=box,color=blue];
		1718 -> 1725;
		1718 -> 1724;
	1719 [label="Rats…　ネズミか？　実はネズミ好きな友人がいるんだ。結構カワイイと思っている。",shape=box,color=red];
		1719 -> 1726;
	1720 [label="自分が決めることじゃない。",shape=box,color=red];
		1720 -> 1727;
	1721 [label="どうしたらいいと思う？",shape=box,color=red];
		1721 -> 1728;
	1722 [label="Rats…　ネズミか？　実はネズミ好きな友人がいるんだ。結構カワイイと思っている。",shape=box,color=red];
		1722 -> 1729;
	1723 [label="確かに、あとに引き伸ばしすぎていた。すぐ取り掛かるよ。",shape=box,color=red];
		1723 -> 1730;
	1724 [label="Lyonだったら彼を説得できるかな？",shape=box,color=red];
		1724 -> 1731;
	1725 [label="今から言うことは気に入らないと思う、Marie。",shape=box,color=red];
		1725 -> 1732;
	1726 [label="いつかお会いしてみたいです、でもそうじゃありませんわ、おかしな狼さん。",shape=box,color=blue];
		1726 -> 1728;
	1727 [label="ええ、わかっています。Loid様と、他の全員も、ご自身の存在を公にするかはその方の判断です。",shape=box,color=blue];
		1727 -> 1728;
	1728 [label="私たちがここに留まっているのは、高潔さではなく、罪悪感からだと私は思います。",shape=box,color=blue];
		1728 -> 1733;
	1729 [label="いつかお会いしてみたいです、でもそうじゃありませんわ、おかしな狼さん。",shape=box,color=blue];
		1729 -> 1728;
	1730 [label="ありがとうございます。成功するかどうかはわかりませんが、挑戦する価値はあると思います。",shape=box,color=blue];
		1730 -> 1728;
	1731 [label="彼は私たちを気に入ってくれているし、優しくて温厚ですものね。でも、彼にとって私たちは étrangers - 見知らぬ人、新参者なのでうまくいくかどうか。",shape=box,color=blue];
		1731 -> 1734;
	1732 [label="Ah bon ?",shape=box,color=blue];
		1732 -> 1735;
	1733 [label="何か大きく、恐ろしい罪を隠していると。",shape=box,color=blue];
		1733 -> 1736;
	1734 [label="少し考えてみます。あなたもそうしてください。解決策は必ず見つかります。ソルがここまで導いてくれたのですから。",shape=box,color=blue];
		1734 -> 1737;
	1735 [label="LoidだったらRoatheの言い分を聞くかもしれない。Roatheはオロキンだろ。二人が共有してきた歴史が、ここで役に立つかもしれない。",shape=box,color=red];
		1735 -> 1738;
	1736 [label="そしてその罪こそ許されるべきなのかもしれません。または、誤りであることを証明するべきです。",shape=box,color=blue];
		1736 -> 1739;
		1736 -> 1740;
	1737 [label="+15 Chemistry",color=orange];
		1737 -> 1741;
	1738 [label="Non !　あの悪魔は策略家で根っからの嘘つきです。高額な報酬との駆け引きに使われるだけです。",shape=box,color=blue];
		1738 -> 1742;
	1739 [label="上の階の状況は…　最良の日でも不安定だ。彼らを怒らせたくない。",shape=box,color=red];
		1739 -> 1743;
	1740 [label="ただ、片方がもう片方のことを「別の家族」と見なさないように気をつけないと。",shape=box,color=red];
		1740 -> 1744;
	1741 [label="Monsieur Loidを説得してあの階段を上っていただきましょう。必ずうまくいきます。",shape=box,color=blue];
		1741 -> 1745;
	1742 [label="Monsieur Loidを他の方法で説得して階段を上っていただきましょう。必ずうまくいきます。",shape=box,color=blue];
		1742 -> 1746;
	1743 [label="魂の回復力に驚かれるでしょうね。私の周りの方たちは、年老いてなお壮健なのです。",shape=box,color=blue];
		1743 -> 1747;
	1744 [label="Add +1 to Family",color=orange];
		1744 -> 1748;
	1745 [label="用事の時間が迫りました。考えることが増えましたね。À la revoyure - それではまた。",shape=box,color=blue];
