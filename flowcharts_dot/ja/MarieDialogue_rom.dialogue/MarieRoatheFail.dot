		j3234840988 -> j3382234215;
	j3503637294 [label="Loidとエントラティ家を再会させるために、Roatheを説得してるんだけど、血清を摂取しようとしないんだ。Marieの助けが必要だ。",shape=box,color=red];
		j3503637294 -> j3111663668;
	j3022284413 [label="Roatheに、変わる力があることや、過去の行いを許せることを気づかせたいんだけど、そのためにMarieの協力が必要なんだ。",shape=box,color=red];
		j3022284413 -> j1143486084;
	j2454088395 [label="Roatheは自分の行いに心を痛めてる。Marieの助けがなければ、Roatheは自分自身を受け入れられず、ただ自滅し続けるかもしれない。",shape=box,color=red];
		j2454088395 -> j2583868426;
	j2055644913 [label="Roatheは血清の真実を理解した。自ら望んで血清を摂取したんだ。そして、それが彼を蝕んでいる。落ち着かせるために、Marieの協力が必要なんだ。",shape=box,color=red];
		j2055644913 -> j3111663668;
	j3382234215 [label="Roatheのせいで気が狂いそうだ。彼にどう話せばいいか分からない。何かアドバイスない？",shape=box,color=red];
		j3382234215 -> j3111663668;
	j3111663668 [label="Non、もし私があの悪魔と話すのが上手かったら、ガウリアで叫び続けることなんてしないでしょう？",shape=box,color=blue];
		j3111663668 -> j4267733964;
