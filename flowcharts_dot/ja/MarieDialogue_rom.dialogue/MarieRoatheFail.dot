	j2583868426 [label="Add -10 to Thermostat counter",color=orange];
		j2583868426 -> j3694360571;
	j4267733964 [label="Pardonne-moi、漂流者様は一人ぼっちだと思います...",shape=box,color=blue];
		j4267733964 -> "Chat ends.";
	j3694360571 [label="できる限りのことをしましょう。漂流者様のためなら試してみます。",shape=box,color=blue];
