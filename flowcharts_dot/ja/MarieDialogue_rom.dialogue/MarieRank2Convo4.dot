	651 [label="+5 Chemistry",color=orange];
		651 -> 660;
	652 [label="それを私が理解していないとでも？　私は愚者ではありません。癇癪持ちでもありません。異なる時代に飛ばされようと、姿形を変えられようと。",shape=box,color=blue];
		652 -> 661;
		652 -> 662;
	649 [label="何を目的に理解したいのかが、私にはわかりません。でも私はあなたを説教するつもりはありません。私はあなたの母親ではありませんし、芽生え始めた友情を壊したくもありません…",shape=box,color=blue];
		649 -> 658;
