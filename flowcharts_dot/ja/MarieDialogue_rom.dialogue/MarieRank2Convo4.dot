	689 [label="猫は素晴らしいです、普通の猫であるならば！　でも彼は幾世紀も生きてきた大人なのです！",shape=box,color=blue];
		689 -> 695;
	690 [label="猫は好きです、普通の猫であるならば！　でも彼は幾世紀も生きてきた大の大人なのです！",shape=box,color=blue];
		690 -> 695;
	691 [label="カーディナルは悪魔を見下ろしてこう言いました、「Uriel、Xataの異端者よ、追放の中で答えを導け、オロキンは許されるのか？」と。",shape=box,color=blue];
		691 -> 696;
	693 [label="ちなみにLyonからこの話を語られたら、私も体験した真実だという事を考慮してください。",shape=box,color=blue];
		693 -> 692;
	692 [label="今思うと、嵐の中悪魔が訪れるとはなんとありきたりなのでしょう。",shape=box,color=blue];
		692 -> 678;
	695 [label="普通の人間ならなりえない青い肌や変異を起こすほど、彼は長すぎる人生を歩んでいるのです。",shape=box,color=blue];
		695 -> 697;
		695 -> 698;
		695 -> 3906;
	696 [label="そして雷鳴とともに、まるで神々から呼び出されたように、カーディナルは消えさったのです。",shape=box,color=blue];
		696 -> 699;
	697 [label="オロキンの時代では、遺伝子操作で自身の姿を変えることはファッションの一つだった。それでも彼らは自分らと同じ人間だった。自分らを人間と呼べるなら。",shape=box,color=red];
		697 -> 700;
	698 [label="しっぽを除けば、当時のオロキンと比べて…　結構人間よりに見えるけど。",shape=box,color=red];
		698 -> 701;
	3906 [label="心配しないで、Marieの方が彼よりずっと可愛いよ。",shape=box,color=red];
		3906 -> 3907;
	699 [label="そうして私たちに…　悪魔が残されました。",shape=box,color=blue];
		699 -> 702;
	700 [label="確かに、私が何であるかはもう定かではありませんね。片やMarie…　片や「Wisp」…　私はこの感染と血を分け合う存在となりました。",shape=box,color=blue];
		700 -> 703;
	701 [label="ええ、カーディナルの古い肖像画を拝見しましたが、確かに悪魔に近い容姿でした。彼からも、オロキンの間では自らを変異させることが習性だとお聞きしています。",shape=box,color=blue];
		701 -> 704;
	3907 [label="Check boolean DrifterMarie",color=orange];
		3907 -> 3908 [label=true,color=green];
		3907 -> 3909 [label=false,color=brown];
	702 [label="カーディナルは私たちに…　彼の魂を見守ることを託したのでしょうか？　あるいは彼を縛る鎖を解くことを。Je préférerais le renvoyer en enfer。",shape=box,color=blue];
		702 -> 705;
		702 -> 706;
	703 [label="この話はまた別の機会にしましょう。",shape=box,color=blue];
		703 -> 707;
	704 [label="私の時代の女性たちが、天に届くほどの派手なかつらや、孤児院を収容できそうなほどのドレスを着ていたのと、どことなく似ているようで、まったく異質にも感じます！",shape=box,color=blue];
		704 -> 708;
	3908 [label="赤面させないでください！　私がここで何をしているのか、Loid様が不思議に思うかもしれません！",shape=box,color=blue];
		3908 -> 3911;
	3909 [label="Update boolean DrifterMarie",color=orange];
		3909 -> 3910;
	705 [label="最後の時でも、誰もが許されると思う？",shape=box,color=red];
		705 -> 709;
	706 [label="何か彼と共感できるものはないの？　なんでもいい。",shape=box,color=red];
		706 -> 710;
	707 [label="Update boolean MarieInfestation",color=orange];
		707 -> 711;
	708 [label="人はそういう生き物なのです。ソルに与えられた自らの姿に不満を抱き、不幸に感じるもの。肉体を粘土のように加工することに躍起になる。かく言う私も、例外ではないのでしょう。",shape=box,color=blue];
		708 -> 712;
	3911 [label="それに、悪魔より可愛くなるのは難しいことじゃないでしょう？　彼の顔立ちは端正ですが、青くて...　 ce n'est pas pour moi。",shape=box,color=blue];
		3911 -> 3912;
	3910 [label="ああ！　赤面してしまう！　私がこんな風にここで座っているのを見たら、Loid様はどう思うでしょう？",shape=box,color=blue];
		3910 -> 3911;
	709 [label="Oui、もちろんです。すべての魂は、罪の赦しを得る力を持っていると信じています。",shape=box,color=blue];
		709 -> 713;
	710 [label="いいえ。まったく。",shape=box,color=blue];
		710 -> 714;
		710 -> 715;
	711 [label="悪魔に対して私が抱く問題は、小さくて愛らしい愛玩動物としての魅力がまったくなく、捕食者の自尊心だけを持っていることです。",shape=box,color=blue];
		711 -> 716;
	712 [label="片やMarie…　片や「Wisp」…　この感染と血を分け合う存在となれる血清を心して受け入れたのですから。",shape=box,color=blue];
		712 -> 703;
	3912 [label="心からのお褒めの言葉であれば、喜んでお受けします。ただ驚いてしまったのです。さて...　本題に戻りましょう？",shape=box,color=blue];
		3912 -> 707;
	713 [label="ただ疑問に思うのです…　そもそも彼は許しを希望しているのでしょうか？",shape=box,color=blue];
		713 -> 717;
	714 [label="話してくれてありがとう。じゃあEntratiは彼に…　許しを与えたいのか？　何に？　Tauか？　それともオロキンであることに？",shape=box,color=red];
		714 -> 718;
	715 [label="わかったよ、信じるよ。嘘はつかないと思うし。",shape=box,color=red];
		715 -> 719;
	716 [label="彼は自身のことを過大評価しています。ためらうことなく命を奪い、追い詰めたネズミのように敵を弄ぶ。",shape=box,color=blue];
		716 -> 702;
	717 [label="許しを必要としていないと思っている人に許しを与えることはできません。そうするよりかは魚に飛び方を教える方が適任でしょう。",shape=box,color=blue];
		717 -> 720;
	718 [label="わかりません。ただ疑問に思うのです…　そもそも彼は許しを希望しているのでしょうか？",shape=box,color=blue];
		718 -> 717;
	719 [label="わかりました、告白します！　私たちには共通点が一つあります…　甘味の誘惑に弱いことです。悪魔はよく外出しては、店から代金を支払わずにパン菓子を盗んで大聖堂に持ち帰ってきました。",shape=box,color=blue];
		719 -> 721;
	720 [label="しかし、もしあなたがの直面している戦争に勝利したい、自身に課した壮大な試練を理解したいのであれば、あなたからこのことを彼に話してください。",shape=box,color=blue];
		720 -> 722;
	721 [label="それは窃盗だと説明しても、「オロキンがすぐに太陽系を支配するのだから大局的に見れば窃盗ではない」と長々と講義を続けました...",shape=box,color=blue];
		721 -> 723;
	722 [label="私はただ幸運を祈るだけです。",shape=box,color=blue];
		722 -> 724;
	723 [label="私は彼に怒鳴りつけ、よくLyonが仲裁に入りました…",shape=box,color=blue];
		723 -> 725;
		723 -> 726;
