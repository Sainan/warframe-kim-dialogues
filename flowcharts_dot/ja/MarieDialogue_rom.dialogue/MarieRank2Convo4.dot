		650 -> 659;
	647 [label="+5 Chemistry",color=orange];
		647 -> 656;
	648 [label="油断だけはしないでください。彼ならルアさえも魅了して、空の星を頂戴するでしょう。",shape=box,color=blue];
		648 -> 657;
	645 [label="何を目的に理解したいのかが、私にはわかりません。でも私はあなたを説教するつもりはありません。",shape=box,color=blue];
