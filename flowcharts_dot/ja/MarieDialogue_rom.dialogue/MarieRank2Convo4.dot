	624 [label="しかし、私に聞きに来るとは驚きです。以前彼に関して助言は必要ないと申していました。私の彼への批判は聞きたくないと。",shape=box,color=blue];
		624 -> 633;
		624 -> 634;
	623 [label="正直この話題を続けるべきか迷っています。あなたは彼に惹かれているようですし、comme un papillon vers une flamme。",shape=box,color=blue];
		623 -> 631;
		623 -> 632;
	622 [label="まだ彼を味方として付けたいのですか？　彼を群れに迎え入れるのは危険な取引です、狼さん。予期せぬ時にあなたの喉を引き裂くかもしれません。",shape=box,color=blue];
		622 -> 629;
		622 -> 630;
	621 [label="しかし、私に聞くとは驚きです。私があの悪魔を毛嫌いしているのは明らかだと思いますが。",shape=box,color=blue];
		621 -> 627;
		621 -> 628;
	619 [label="ゾウがいたらそれは驚きます！　ここはすでにménagerieのようですし。",shape=box,color=blue];
		619 -> 625;
	620 [label="Oui、可愛らしいでしょう？　私もLoid様に話すときたまに不意打ちされたような反応をされます。",shape=box,color=blue];
		620 -> 626;
	633 [label="以前は言葉が強かった、申し訳ないと思っている。まだ彼を非難するのは早いと思うし、彼を多方面から理解したい。",shape=box,color=red];
		633 -> 642;
	634 [label="今も助けは必要としていない。でも彼の人生を理解するには複雑すぎる。でも二人の出会いが気になっただけだ。",shape=box,color=red];
		634 -> 643;
	631 [label="自分はただなぜ彼があのような態度を取るのか知りたいだけだ。理解したいんだ。",shape=box,color=red];
		631 -> 640;
	632 [label="彼をもっと理解できれば、彼をもっと…　穏やかな道に導けるかもしれない。",shape=box,color=red];
		632 -> 641;
	629 [label="わかっている。でも彼はオロキンと民のために最善を尽くしただけだ、それは憎めない。自分も同じことをした。",shape=box,color=red];
		629 -> 638;
	630 [label="彼はオロキン帝国で最も危険な人物の一人だ。あれを手放すのは愚かだ。",shape=box,color=red];
