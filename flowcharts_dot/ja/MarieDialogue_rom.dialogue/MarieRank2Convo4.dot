		644 -> 653;
	660 [label="謝罪をありがとうございます。受け入れましょう。でも私はここへ移送され、変貌し、有り得ない存在たちに囲まれて暮らしていることをお忘れなく。",shape=box,color=blue];
		660 -> 666;
	661 [label="もういい。直接話してくる。",shape=box,color=red];
