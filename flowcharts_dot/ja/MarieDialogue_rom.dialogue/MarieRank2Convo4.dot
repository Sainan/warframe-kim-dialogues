	662 [label="すまない。議論するつもりはないんだ。",shape=box,color=red];
		662 -> 668;
		662 -> 669;
	658 [label="私はただあなたが心配なのです。彼は巧妙かつ狡猾な獣です…",shape=box,color=blue];
		658 -> 664;
	659 [label="なら私はその試みを考えるあなたを、ソルの聖人として宣言します。",shape=box,color=blue];
		659 -> 664;
	656 [label="Oui、兵士の呪い…　お国のために村を焼き払う。家族を救うため人を殺す。争いの恐怖はどこへ向かっているのでしょうか？",shape=box,color=blue];
		656 -> 665;
	657 [label="彼が根本的に誰なのか、何なのかを覚えておいてください…　彼は神でも、獣でもありません。人間です。それもかなり高飛車な。",shape=box,color=blue];
		657 -> 664;
	654 [label="彼ならルアさえも魅了して、空の星を頂戴するでしょう。ただただ、用心してください。",shape=box,color=blue];
		654 -> 664;
	655 [label="それが賢明です、彼の甘い言葉に耳を傾けてはいけません。彼ならルアさえも魅了して、空の星を頂戴するでしょう。",shape=box,color=blue];
		655 -> 664;
	653 [label="そうだね。「避けている話題を話してもいいか」と言う意味で、ことわざみたいなものだ。",shape=box,color=red];
		653 -> 663;
	666 [label="私を他人の話を理解できない、同情できない人間とお考えなら、評価を改めてください。",shape=box,color=blue];
		666 -> 673;
	667 [label="Qu'il en soit ainsi。",shape=box,color=blue];
		667 -> 674;
	668 [label="彼は兵士だ。「大義のため」にたくさんのひどいことをしてきた。その気持ちはよくわかる。こういう人生を歩んでいると、その…　彼みたいになるんだ。",shape=box,color=red];
		668 -> 675;
	669 [label="彼は何百、何千年と生きてきた。それが人にどう影響するか、想像もできないだろう？　どれだけの苦痛を味わってきたか？　自分はその気持ちをよく理解している。",shape=box,color=red];
		669 -> 676;
	664 [label="それでもあなたは悪魔のことを聞きたいのですよね？　何を知りたいのですか？",shape=box,color=blue];
		664 -> 670;
		664 -> 671;
		664 -> 672;
	665 [label="私たちは戦争を、統計家の視点から見なければなりません。戦死者の目ばかりでは、涙が絶えることがありませんから。",shape=box,color=blue];
		665 -> 664;
