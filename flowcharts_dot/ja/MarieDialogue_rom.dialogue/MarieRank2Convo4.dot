		672 -> 679;
	680 [label="賛成だ。",shape=box,color=red];
		680 -> 687;
	681 [label="ああ、自分の愚かさに気付いてしまいました。確かに、あなたは「大義のため」に殺すことがどのように影響を与えるか理解しているのですね…　同じ道を歩んだ者を理解したいのは当然です。",shape=box,color=blue];
		681 -> 688;
	682 [label="ああ、自分の愚かさに気付いてしまいました。確かに、あなたは久遠の時を生きることがどのように影響を与えるか理解しているのですね…　同じ道を歩んだ者を理解したいのは当然です。",shape=box,color=blue];
		682 -> 688;
	677 [label="理由は明白です。彼の態度は、自身の縄張りを主張し、棚から物を落とす大きな猫のようです。",shape=box,color=blue];
		677 -> 683;
		677 -> 684;
	678 [label="カーディナル・ディマンシュ…　あなたのEntratiが旅立つ直前、悪魔を玄関先に残していきました。その悪魔は傷つき、血を流し、自身の名さえ思い出せないほど弱った状態だったのです。",shape=box,color=blue];
		678 -> 685;
	679 [label="悪魔が訪れたなのは、暗い嵐の夜でした。大聖堂の壁を揺るがすほど恐ろしい雷鳴が響いていました。",shape=box,color=blue];
