	j3172012938 [label="Oui, qu'est-ce qu'il ya - 何でしょう？",shape=box,color=blue];
		j3172012938 -> j1050572280;
	"Chat ends." [color=orange];
	j177869983 [label="彼を「私たちの」悪魔と呼ばなくてはならないか心配です。non？　悪魔はすぐには去らないでしょう。Ha！",shape=box,color=blue];
		j177869983 -> j1928460202;
	j2607029168 [label="その質問は漂流者様ご自身に聞くべきでは、non？　今悪魔といいご関係なのは、あなたでしょう！",shape=box,color=blue];
		j2607029168 -> j794829364;
	j4098904247 [label="漂流者様がどのようにして成し遂げたのかは分かりませんが、悪魔は血清を摂取した真実を話しましたね。",shape=box,color=blue];
		j4098904247 -> j3856858380;
	j368618011 [label="漂流者様がどのようにして成し遂げたのかは分かりませんが、悪魔はsérumを摂取した真実を話しましたね。",shape=box,color=blue];
	j4256079813 [label="悪魔のことが心配です。彼は自分が思っている以上に自分を傷つけていると思います。そうでしょう、n'est-ce pas？",shape=box,color=blue];
		j4256079813 -> j2139972646;
	j1050572280 [label="突然だと感じさせてたら、ごめん。前はどう伝えたらいいのか分からなかったんだ。",shape=box,color=red];
		j1050572280 -> j71989958;
	j1928460202 [label="ネクロなLoid様の件で悪魔の協力を得られることになったのは、漂流者様のおかげです。まさかできるとは思いませんでした。",shape=box,color=blue];
		j1928460202 -> j4000585533;
	j794829364 [label="漂流者様に噂話 - toutes sortes de commérages を聞かずにはいられないのです。",shape=box,color=blue];
		j794829364 -> j4000585533;
	j3856858380 [label="ソル、心が張り裂けそうでした。悪魔は話す時平常を装った。でも彼の目が語っていたのです。Mais je l'ai vu dans ses yeux. ",shape=box,color=blue];
		j3856858380 -> j4000585533;
	j2139972646 [label="胸が張り裂けそうです。いつか悪魔の胸が砕け散りませんように。彼が生き残れるかどうかは分かりません。私たちの誰が生き残れるかどうかも分からないのです。",shape=box,color=blue];
		j2139972646 -> "Chat ends.";
	j71989958 [label="Marieを愛してる。ただただ愛しているんだ。",shape=box,color=red];
		j71989958 -> j1899957000;
	j4000585533 [label="悪魔の中に変化がありました。微妙でも、確かに。 ",shape=box,color=blue];
		j4000585533 -> j2345654532;
	j1899957000 [label="えっと、聞きたかったんだけど…　えーと…　カップルになってみない？",shape=box,color=red];
		j1899957000 -> j2298753926;
	j2345654532 [label="+5 Chemistry",color=orange];
		j2345654532 -> j3919371005;
	j2298753926 [label="Evaluate expressions",color=orange];
		j2298753926 -> j226206046 [label="MarieNoDate",color=purple];
		j2298753926 -> j2307344276 [label="MarieWillDate",color=purple];
		j2298753926 -> j226206046 [label="false",color=purple];
	j3919371005 [label="漂流者様に感謝しなくては。",shape=box,color=blue];
		j3919371005 -> j1543134100;
	j226206046 [label="ああ！　ああ、漂流者様。どう言えばいいのか分からないから、はっきり申し上げます。 ",shape=box,color=blue];
		j226206046 -> j617350017;
	j2307344276 [label="ああ、私も同じ想いです！　Mais je ne sais pas comment te l'écrire. 何と書き込めばよいかしら。考えるだけでも恥ずかしい！",shape=box,color=blue];
		j2307344276 -> j3468360581;
	j1543134100 [label="悪魔が歓迎しなかったとしても、彼との友情はいつまでも続くでしょう。",shape=box,color=blue];
		j1543134100 -> j1990682275;
	j617350017 [label="Non.",shape=box,color=blue];
		j617350017 -> "Chat ends.";
	j3468360581 [label="ああ！　とても幸せです！",shape=box,color=blue];
		j3468360581 -> j2443772357;
	j1990682275 [label="それでも、私は悪魔に向かって怒鳴り続けるのでしょうね！",shape=box,color=blue];
		j1990682275 -> j2764243290;
		j1990682275 -> j912316410;
	j2443772357 [label="もっと…　正式な求愛をされておられるなら、oui！　Oui！　お受けいたします。",shape=box,color=blue];
		j2443772357 -> j843281605;
		j2443772357 -> j2882147603;
	j2764243290 [label="RoatheはMarieをからかうのが好きなんだと思うよ。",shape=box,color=red];
		j2764243290 -> j2833296393;
	j912316410 [label="MarieとRoatheが親交を深められて嬉しいよ。",shape=box,color=red];
		j912316410 -> j2657942388;
	j843281605 [label="いや、結婚は申し込んでないよ、絶対にまだ。 ",shape=box,color=red];
		j843281605 -> j327750565;
	j2882147603 [label="確かに少し進化したかな。「フォーマル」になったとは言い難いけど…　教えてあげるよ。",shape=box,color=red];
		j2882147603 -> j3315769859;
	j2833296393 [label="Comme un gros chat de gouttière. まるで大きな野良猫のよう。悪魔に慣れてきたみたいです。",shape=box,color=blue];
		j2833296393 -> j623079659;
	j2657942388 [label="Oui！　私もです。日に日に、悪魔が癪に障らなくなってきました。",shape=box,color=blue];
		j2657942388 -> j2833296393;
	j327750565 [label="今度は私がからかう順でしょうか、心配なさらないで。でも、どちらにしても高揚しています、 je suis ravie！　この新しい…　romantiquesな風習を学ぶのが楽しみです。",shape=box,color=blue];
		j327750565 -> j787298138;
	j3315769859 [label="Hah！　あなたが意地悪な時は分かります。　まあ、楽しみにしています。",shape=box,color=blue];
		j3315769859 -> j787298138;
	j623079659 [label="彼がいなくなったら悲しくなる程度には。",shape=box,color=blue];
		j623079659 -> "Chat ends.";
