		j4217867269 -> "Chat ends." [label="false",color=purple];
	j4043390227 [label="漂流者様。私は悪魔に追い回されているのです。彼の小悪魔たちには本当に苛立たされます！　全てはあなたの名の下に！　悪魔は、漂流者様がひざまずいて謝りたいだけだと言っています。",shape=box,color=blue];
		j4043390227 -> j590899526;
		j4043390227 -> j68082465;
	j4200045864 [label="私は悪魔に追い回されているのです。彼の小悪魔たちには本当に苛立たされます！　全てはあなたの名の下に！　悪魔は、漂流者様が相談したいと言っています。Loid様とカーディナルのご家族との和解に、私の協力が必要ですか？",shape=box,color=blue];
		j4200045864 -> j868978784;
		j4200045864 -> j68082465;
	j3502288255 [label="私は悪魔に追い回されているのです。彼の小悪魔たちには本当に苛立たされます！　全てはあなたの名の下に！　悪魔は、漂流者様が相談したいと言っています。Loid様とカーディナルのご家族との和解に、私の協力が必要ですか？",shape=box,color=blue];
		j3502288255 -> j3493634836;
		j3502288255 -> j68082465;
	"Chat ends." [color=orange];
	j590899526 [label="そうだ。",shape=box,color=red];
		j590899526 -> j1630547179;
	j68082465 [label="何だって？",shape=box,color=red];
		j68082465 -> j4177712951;
	j868978784 [label="そうだ。",shape=box,color=red];
		j868978784 -> j2823261983;
	j3493634836 [label="そうだ。",shape=box,color=red];
		j3493634836 -> j3743902930;
	j1630547179 [label="本当にごめん。Marieが気分を害したことは解る。そんなつもりはなかったんだ。そんなことしたくなかった。信じてほしい。",shape=box,color=red];
		j1630547179 -> j2038299491;
	j4177712951 [label="Je vais le tuer ! Je savais que ce démon était rempli de la pire merde qui soit ! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses !",shape=box,color=blue];
		j4177712951 -> "Chat ends.";
	j2823261983 [label="漂流者様がいない間に、悪魔はかなりの説得をしました、ですから私はもう長くはいられないでしょう。いつものように、悪魔にはなかなかの説得力があったのですよ。",shape=box,color=blue];
		j2823261983 -> j700171379;
	j3743902930 [label="漂流者様がいない間に、悪魔はかなりの説得をしました、ですから私はもう長くはいられないでしょう。いつものように、悪魔にはなかなかの説得力があったのですよ。",shape=box,color=blue];
		j3743902930 -> j963348107;
	j2038299491 [label="なぜそう思うのですか？",shape=box,color=blue];
		j2038299491 -> j94674480;
		j2038299491 -> j656213609;
	j700171379 [label="認めます...　Sans recoursでここに閉じ込められることに、かなり疲れてきています。",shape=box,color=blue];
		j700171379 -> j2074104745;
	j963348107 [label="ですが、それは悪魔の言葉ではなく賢さなのです。彼は私をネクロなLoid様と一緒に座らせてくれました。",shape=box,color=blue];
		j963348107 -> j1737395857;
		j963348107 -> j1085489997;
	j94674480 [label="[告白する] Marie、君のことを心から大切に思っている。大好きだよ。",shape=box,color=red];
		j94674480 -> j307088371;
	j656213609 [label="気にしないで。明らかに間違ってた。",shape=box,color=red];
		j656213609 -> j610157964;
	j2074104745 [label="ですから、言わせてください。お手伝いいたします。ご協力しましょう。",shape=box,color=blue];
		j2074104745 -> j3151953893;
	j1737395857 [label="え？",shape=box,color=red];
		j1737395857 -> j3378550570;
	j1085489997 [label="LoidはAlbrechtを愛しているのに？",shape=box,color=red];
		j1085489997 -> j2797326713;
	j307088371 [label="失言するかもって心配してたけど、本当にそうなるとは。",shape=box,color=red];
		j307088371 -> j4165093404;
	j610157964 [label="漂流者様も悪魔も酷いですね。",shape=box,color=blue];
		j610157964 -> "Chat ends.";
	j3151953893 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3151953893 -> j2529015854;
	j3378550570 [label="Loid様の澄んだ視力のおかげで、私は自分の曇ったレンズで見ることができました。 Loid様はカーディナル - 彼のAlbrecht - を愛していますが、同時に彼の欠点も全て同じように見えているのです。",shape=box,color=blue];
		j3378550570 -> j2382235433;
	j2797326713 [label="ええ、そうなんです。Loid様は彼の欠点もすべて同じように見ることができるんです。そのLoid様の澄んだ視力のおかげで、私も自分の曇ったレンズで見ることができました。",shape=box,color=blue];
		j2797326713 -> j2382235433;
	j4165093404 [label="Roatheに頼ってごめん。Marieの気を引きたかったけど、誰に頼ればいいのか分からなかったんだ。",shape=box,color=red];
		j4165093404 -> j3900610694;
	j2529015854 [label="Boolean MarieFamilyFail is now false.",color=orange];
		j2529015854 -> "Chat ends.";
	j2382235433 [label="人を愛するということは、長所も短所もすべて受け入れることでしょう、après tout？",shape=box,color=blue];
		j2382235433 -> j3722403271;
	j3900610694 [label="ああ、漂流者様…　哀れな漂流者様。　私に許してもらうのに、そんなことをする必要はありませんのに。 ",shape=box,color=blue];
		j3900610694 -> j227073409;
	j3722403271 [label="Boolean MarieEntratiCompleteA is now true.",color=orange];
		j3722403271 -> j2737891827;
	j227073409 [label="もし頼まれたら、そうしましたのに。漂流者様はもう私の心の中にいらっしゃるのです、ご存じでしょう？",shape=box,color=blue];
		j227073409 -> j1998002755;
