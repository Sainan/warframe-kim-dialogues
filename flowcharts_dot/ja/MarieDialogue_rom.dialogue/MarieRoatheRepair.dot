		3816 -> 3820 [label="false",color=purple];
	3817 [label="漂流者様。私は悪魔に追い回されているのです。彼の小悪魔たちには本当に苛立たされます！　全てはあなたの名の下に！　悪魔は、漂流者様がひざまずいて謝りたいだけだと言っています。",shape=box,color=blue];
		3817 -> 3821;
		3817 -> 3822;
	3818 [label="私は悪魔に追い回されているのです。彼の小悪魔たちには本当に苛立たされます！　全てはあなたの名の下に！　悪魔は、漂流者様が相談したいと言っています。Loid様とカーディナルのご家族との和解に、私の協力が必要ですか？",shape=box,color=blue];
		3818 -> 3823;
		3818 -> 3824;
	3819 [label="私は悪魔に追い回されているのです。彼の小悪魔たちには本当に苛立たされます！　全てはあなたの名の下に！　悪魔は、漂流者様が相談したいと言っています。Loid様とカーディナルのご家族との和解に、私の協力が必要ですか？",shape=box,color=blue];
		3819 -> 3825;
		3819 -> 3826;
	3820 [label="Chat ends.",color=orange];
	3821 [label="そうだ。",shape=box,color=red];
		3821 -> 3827;
	3822 [label="何だって？",shape=box,color=red];
		3822 -> 3828;
	3823 [label="そうだ。",shape=box,color=red];
		3823 -> 3829;
	3824 [label="何だって？",shape=box,color=red];
		3824 -> 3828;
	3825 [label="そうだ。",shape=box,color=red];
		3825 -> 3830;
	3826 [label="何だって？",shape=box,color=red];
		3826 -> 3828;
	3827 [label="本当にごめん。Marieが気分を害したことは解る。そんなつもりはなかったんだ。そんなことしたくなかった。信じてほしい。",shape=box,color=red];
		3827 -> 3831;
	3828 [label="Je vais le tuer ! Je savais que ce démon était rempli de la pire merde qui soit ! Je vais renvoyer ses conscrits d'où ils viennent par la peau des fesses !",shape=box,color=blue];
		3828 -> 3832;
	3829 [label="漂流者様がいない間に、悪魔はかなりの説得をしました、ですから私はもう長くはいられないでしょう。いつものように、悪魔にはなかなかの説得力があったのですよ。",shape=box,color=blue];
		3829 -> 3833;
	3830 [label="漂流者様がいない間に、悪魔はかなりの説得をしました、ですから私はもう長くはいられないでしょう。いつものように、悪魔にはなかなかの説得力があったのですよ。",shape=box,color=blue];
		3830 -> 3834;
	3831 [label="なぜそう思うのですか？",shape=box,color=blue];
		3831 -> 3835;
		3831 -> 3836;
	3832 [label="Chat ends.",color=orange];
	3833 [label="認めます...　Sans recoursでここに閉じ込められることに、かなり疲れてきています。",shape=box,color=blue];
		3833 -> 3837;
	3834 [label="ですが、それは悪魔の言葉ではなく賢さなのです。彼は私をネクロなLoid様と一緒に座らせてくれました。",shape=box,color=blue];
		3834 -> 3838;
		3834 -> 3839;
	3835 [label="[告白する] Marie、君のことを心から大切に思っている。大好きだよ。",shape=box,color=red];
		3835 -> 3840;
	3836 [label="気にしないで。明らかに間違ってた。",shape=box,color=red];
		3836 -> 3841;
	3837 [label="ですから、言わせてください。お手伝いいたします。ご協力しましょう。",shape=box,color=blue];
		3837 -> 3842;
	3838 [label="え？",shape=box,color=red];
		3838 -> 3843;
	3839 [label="LoidはAlbrechtを愛しているのに？",shape=box,color=red];
		3839 -> 3844;
	3840 [label="失言するかもって心配してたけど、本当にそうなるとは。",shape=box,color=red];
		3840 -> 3845;
	3841 [label="漂流者様も悪魔も酷いですね。",shape=box,color=blue];
