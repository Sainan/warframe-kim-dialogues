digraph {
	0 [label="MarieRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Bonjour, bonjour！　この恵まれた昼時をどうお過ごしで？　それとももう夕方でしょうか。ここにいると時の流れがうまくつかめません。",shape=box,color=blue];
		1 -> 2;
	2 [label="Loid様が保管しているこれらのからくりのどれかが時計なのでしょうが、どれなのかさっぱりわかりませんわ。",shape=box,color=blue];
		2 -> 3;
	3 [label="この奇妙なサンクタムにある装置はどれも怖くて触れられません。紅茶を淹れるつもりで遠い過去へ飛ばされてしまっては困りますからね。",shape=box,color=blue];
		3 -> 5;
		3 -> 6;
		3 -> 4;
	5 [label="理解せずあちこち触るのは多分よくないだろう。",shape=box,color=red];
		5 -> 8;
	6 [label="多分大丈夫だろう。",shape=box,color=red];
		6 -> 9;
	4 [label="[閉じる]",shape=box,color=red];
		4 -> 7;
	8 [label="そうしますわ。Loid様からあなたの時をかけた冒険について聞きましたわ。それについてですが…",shape=box,color=blue];
		8 -> 10;
	9 [label="C'est très gentil de votre part、でも…　時空を超える体験はとても…　ああ、そうでしたね",shape=box,color=blue];
		9 -> 11;
	7 [label="Chat ends.",color=orange];
	10 [label="あちらも危険多かったのでしょうか？",shape=box,color=blue];
		10 -> 12;
		10 -> 13;
	11 [label="あなたは体験しているのでしたね。ご無礼を。あちらでの冒険も危険が多かったのですか？",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="時代の話？　それとも自分の滞在体験？",shape=box,color=red];
		12 -> 14;
	13 [label="違った。でもここは安全だと約束する。",shape=box,color=red];
		13 -> 15;
	14 [label="+10 Chemistry",color=orange];
		14 -> 16;
	15 [label="あなたからの熱烈な信頼に心から感謝しますが、私自身そうは思いません。なにせ時間さえわからないのですから。",shape=box,color=blue];
		15 -> 17;
	16 [label="確かに言葉足らずでしたね。あなたの過去での体験は常人からすれば「平常」でないことは明らかですし。ええ、きっとそうなのでしょう。",shape=box,color=blue];
		16 -> 18;
	17 [label="この…「画面」の隅からわかるはずなのですが、どこにも見当たりません！　実にmauvaise qualitéです。",shape=box,color=blue];
		17 -> 19;
	18 [label="この場合は「時代」のことですね。言い換えると…",shape=box,color=blue];
		18 -> 20;
	19 [label="とにかく、元の質問から脱線してしまいました！",shape=box,color=blue];
		19 -> 20;
	20 [label="あなたが訪れた「過去」の時代、確かにここより私の「さらに過去」の時代に近いようですが、この未来の世界より危険なところだったのでしょうか？",shape=box,color=blue];
		20 -> 21;
	21 [label="（まあ、なんて楽しいのでしょう！　聖餐台のお掃除よりずっと面白いわ。）",shape=box,color=blue];
		21 -> 22;
		21 -> 23;
		21 -> 24;
		21 -> 25;
	22 [label="同じくらいだと思う。武器技術も違うし、戦う相手の知識も少ないけど、戦争は戦争、死は死だ。",shape=box,color=red];
		22 -> 26;
	23 [label="この時代の方が危険を感じない。今は脅威に立ち向かうための手段が豊富だ。あっちだとまだ初歩的だ。",shape=box,color=red];
		23 -> 27;
	24 [label="この時代の方が危険だ。感染体の脅威は同じでも、相手にしていた兵器は今に比べると原始的だ。",shape=box,color=red];
		24 -> 27;
	25 [label="正直、Marieが楽しそうで何よりだ。一度にたくさんのことに慣れるのは大変だ。",shape=box,color=red];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="おっしゃる通りかもしれませんね。考察してみます。ありがとうございます。",shape=box,color=blue];
		27 -> 30;
	28 [label="+5 Chemistry",color=orange];
		28 -> 31;
	29 [label="相対的なのがこの世の理、non？　我々を狩る今の捕食者は、かつての捕食者と同様に恐ろしいのです。ただただ牙を研ぎ澄ましているだけ。",shape=box,color=blue];
		29 -> 32;
		29 -> 33;
	30 [label="Chat ends.",color=orange];
	31 [label="カーディナル・ディマンシュ、あなたの言うAlbrecht Entratiから事態の備えを得ていましたからね。愛しいLyonとは意見が異なり、私は彼の言葉を真実と受け入れましたから。そしてまたLyonとは違って、これを苦難と捉えず、大いなる冒険と考えていますからね。",shape=box,color=blue];
		31 -> 34;
	32 [label="オロキンなら話は違うけど。彼らは死を免れる方法を…　理論上、もしかしたら実用的にしたから。",shape=box,color=red];
		32 -> 35;
	33 [label="未来の世界に馴染んでいるようで安心した。",shape=box,color=red];
		33 -> 36;
	34 [label="ルミナリーズへのご奉仕は必ずしも苦行ではないのです。この点においては中々合意しないのですが。",shape=box,color=blue];
		34 -> 37;
	35 [label="そして悪魔の存在こそ、死がルアが私たちに与えてくれた最大の贈り物なのだと示している、そう信じています。",shape=box,color=blue];
		35 -> 38;
	36 [label="+5 Chemistry",color=orange];
		36 -> 39;
	37 [label="Update boolean MarieLyonSuffering1",color=orange];
		37 -> 40;
	38 [label="Update boolean MarieRoathe1",color=orange];
		38 -> 41;
	39 [label="カーディナル・ディマンシュ、あなたの言うAlbrecht Entratiから事態の備えを得ていましたからね。愛しいLyonとは意見が異なり、私は彼の言葉を真実と受け入れましたから。そしてまたLyonとは違って、これを苦難と捉えず、大いなる冒険と考えていますからね。",shape=box,color=blue];
		39 -> 42;
	40 [label="それと質問を避けないでください！　どちらの方が危険だと思いますの？",shape=box,color=blue];
		40 -> 43;
		40 -> 44;
		40 -> 45;
	41 [label="あら！　聞き慣れた時計の音がしますわ。はて、一体どこから鳴っているのでしょう？　いずれにせよ、もう行かなければなりません。楽しい時間でしたわ。また「お会い」するまで！　Aux Dieux！",shape=box,color=blue];
		41 -> 46;
	42 [label="ルミナリーズへのご奉仕は必ずしも苦行ではないのです。この点においては中々合意しないのですが。",shape=box,color=blue];
		42 -> 47;
	43 [label="この時代の方が危険かな。だって殺気いっぱいの敵がこんなにもいるんだから。",shape=box,color=red];
		43 -> 48;
	44 [label="この時代の方が安全かな。あっちじゃまだ戦い方がシンプルだ。それかこの時代での戦い方がハデなだけかもしれない。",shape=box,color=red];
		44 -> 48;
	45 [label="結局のところ、同じくらいじゃないかな。死は死、そうだろう？",shape=box,color=red];
		45 -> 49;
	46 [label="Chat ends.",color=orange];
	47 [label="Update boolean MarieLyonSuffering1",color=orange];
		47 -> 41;
	48 [label="おっしゃる通りかもしれませんね。考察してみます。ありがとうございます。",shape=box,color=blue];
		48 -> 50;
	49 [label="+5 Chemistry",color=orange];
		49 -> 51;
	50 [label="Chat ends.",color=orange];
	51 [label="相対的なのがこの世の理、non？　我々を狩る今の捕食者は、かつての捕食者と同様に恐ろしいのです。ただただ牙を研ぎ澄ましているだけ。",shape=box,color=blue];
		51 -> 52;
		51 -> 53;
	52 [label="狼から身を守ろうとしている側からすると、結構疲れるけど。",shape=box,color=red];
		52 -> 54;
	53 [label="オロキンなら話は違うけど。彼らは死を免れる方法を…　理論上、もしかしたら実用的にしたから。",shape=box,color=red];
		53 -> 55;
	54 [label="私から見たら、あなたは狼の群れに対抗するより、逃げ出して群れに加わろうとしていそうですが。もちろん褒め言葉としておっしゃっていますわ。",shape=box,color=blue];
		54 -> 41;
	55 [label="そして悪魔の存在こそ、死がルアが私たちに与えてくれた最大の贈り物なのだと示している、そう信じています。",shape=box,color=blue];
