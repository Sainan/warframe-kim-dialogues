digraph {
	77 [label="MarieRank1Convo3 begins.",color=orange];
		77 -> 78;
	78 [label="Il y a un crâne volant！Keksekça？！　空飛ぶ頭蓋骨が徘徊しているというのに、誰もそれについて触れません。私の認識が狂っているのでしょうか？",shape=box,color=blue];
		78 -> 79;
		78 -> 81;
		78 -> 80;
	79 [label="ネクロロイドだよ。ネクロなLoid、かな。複雑なんだ。",shape=box,color=red];
		79 -> 82;
	81 [label="ネクロロイドだよ。セファロンだから、害はない。",shape=box,color=red];
		81 -> 84;
	80 [label="[閉じる]",shape=box,color=red];
		80 -> 83;
	82 [label="それは名前なのですか、物体なのですか？",shape=box,color=blue];
		82 -> 85;
		82 -> 86;
	84 [label="害があるとは思っていませんわ！　恐ろしいと感じていません。",shape=box,color=blue];
		84 -> 87;
	83 [label="Chat ends.",color=orange];
	85 [label="それは…　正確にはわからない。",shape=box,color=red];
		85 -> 88;
	86 [label="両方にイエス。",shape=box,color=red];
		86 -> 89;
	87 [label="むしろ、魅力的に感じます、少し会話に難癖があることは認めますが。それでも元となった方ほどではありません。私を憑きまとうものを考えると、それほど気にはなりません。",shape=box,color=blue];
		87 -> 90;
	88 [label="まず、この「ネクロロイド」の構想は誰のものなのです？　名前であると同時に、意義のようにも感じますが？",shape=box,color=blue];
		88 -> 91;
		88 -> 92;
	89 [label="理解に…　苦しみますね。Loid様はどう関係しているのです？",shape=box,color=blue];
		89 -> 88;
	90 [label="いいえ、あなたが怪奇的と感じる容貌は、私が持つ疑問とは異なるものです。",shape=box,color=blue];
		90 -> 93;
		90 -> 94;
	91 [label="Marieの言うカーディナル・ディマンシュ。Entratiだ。",shape=box,color=red];
		91 -> 95;
	92 [label="Entratiが造ったんだ。でもコンセプトとなったセファロンは、オロキンによって発明された。",shape=box,color=red];
		92 -> 95;
	93 [label="頭蓋骨のデザインが気にならないとは驚きだ。",shape=box,color=red];
		93 -> 96;
	94 [label="確かに、事情を知らないと、彼は奇妙かもしれない。何が気になるの？",shape=box,color=red];
		94 -> 97;
	95 [label="Excusez-moi、カーディナルは好んで彼の従者を空飛ぶ頭蓋骨に見立てて複製して、同じ名前まで与えたと言うのですか？",shape=box,color=blue];
		95 -> 98;
	96 [label="それはあなたが私を知り尽くしていないからですが、あなたの所為ではありません。私は人生の大半を、死者と彼らが眠る場所の世話に尽くしてきましたから。",shape=box,color=blue];
		96 -> 99;
	97 [label="なぜあの方の後ろには子供の落書きのような顔があるのでしょうか。",shape=box,color=blue];
		97 -> 100;
	98 [label="ではなぜネクロロイドを量産しなかったのでしょうか？",shape=box,color=blue];
		98 -> 101;
		98 -> 102;
		98 -> 103;
	99 [label="実際、私の良き仲間たちと同様の時間を共に過ごしてきました。彼らは進んで私の日々の悩みに耳を傾けてくれます。",shape=box,color=blue];
		99 -> 104;
	100 [label="ネクロなLoid様とLoid様にお尋ねしたのですが、あまり触れたくないようで、名前だけ教えていただきました。Otak、と。とても悲しそうに口ずさんでいました。",shape=box,color=blue];
		100 -> 105;
	101 [label="愛人のコピーを何体も作るのがどれだけ恐ろしいか気づいたのかも？",shape=box,color=red];
		101 -> 106;
	102 [label="最初から1体だけにしておく気だったのかも。",shape=box,color=red];
		102 -> 107;
	103 [label="わからない。作る時間がなかったとか？",shape=box,color=red];
		103 -> 108;
	104 [label="Update boolean MarieGraveyard1",color=orange];
		104 -> 109;
		104 -> 110;
	105 [label="それであなたならと思い、こうして聞いているのです。",shape=box,color=blue];
		105 -> 111;
		105 -> 112;
	106 [label="Ou bien、これは彼の愛と尊敬の証なのかもしれませんね。この奇妙な研究所もLoid様なしでは機能しないと信じて。",shape=box,color=blue];
		106 -> 113;
		106 -> 114;
	107 [label="+5 Chemistry",color=orange];
		107 -> 115;
	108 [label="効率的に作業をこなす、空飛ぶ頭蓋骨の群れ…　面白そうですね！",shape=box,color=blue];
		108 -> 114;
		108 -> 116;
	109 [label="墓地の世話をするのが好きなの？",shape=box,color=red];
		109 -> 117;
	110 [label="反応したりするの？",shape=box,color=red];
		110 -> 118;
	111 [label="Otakについて知りたい？　それともなぜ話せないか知りたい？",shape=box,color=red];
		111 -> 119;
	112 [label="Otakは…　なんて言うか、そうだな…",shape=box,color=red];
		112 -> 2918;
	113 [label="愛情表現としてはかなりズレているかもしれないけど、人のことは言えないか。",shape=box,color=red];
		113 -> 122;
	114 [label="正直自分のところにもネクロロイドが欲しいくらいだ。",shape=box,color=red];
		114 -> 123;
	115 [label="それは何とも悲劇的かつ美しいのでしょう。これは彼の愛と尊敬の証なのかもしれませんね。この奇妙な研究所もLoid様なしでは機能しないと信じて。",shape=box,color=blue];
		115 -> 124;
		115 -> 113;
	116 [label="1体だけでよかったと思う。これ以上は想像できない。",shape=box,color=red];
		116 -> 125;
	117 [label="霊廟や納骨堂もです、はい。でも確かに、椅子での移動は大変だったとはいえ、屋外の方が好ましかったのは認めます。まだ階段の方が良かった時もありました。",shape=box,color=blue];
		117 -> 126;
	118 [label="ふふ、いいえ、ありがたいことに会話が返ってくることはありませんわ。陰気な顔をした「ネクロロイド」を除いて。死者との会話がルミナリーズからの加護だとしても、それを知る術は私にはありません。",shape=box,color=blue];
		118 -> 127;
	119 [label="できれば両方を知りたいですが、時間のこともありますし、どこから始めるかはあなたに任せますわ。どちらが重要かもわかりませんし、après tout。",shape=box,color=blue];
		119 -> 2918;
