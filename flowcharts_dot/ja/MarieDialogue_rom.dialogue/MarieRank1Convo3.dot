		134 -> 138;
	140 [label="あら！　まぁなんて可哀想に。これまでずっと、カーディナルによって足を奪われたと思っていたのですね！　Non non non、そうではありません。",shape=box,color=blue];
		140 -> 144;
	141 [label="今まさしく、この小さくて愛らしい装置の前で会話するために座っているような。でも、側面に車輪がついていて、移動できる代物です。言うなれば、車輪付きの椅子でしょうか。",shape=box,color=blue];
		141 -> 145;
		141 -> 146;
	139 [label="誰から見ても彼は天才であり、アルゴンクリスタルの活用方法を考案した張本人だ。",shape=box,color=red];
		139 -> 143;
	138 [label="Entratiの娘、Euleria、通称Motherね、それと彼女の家族は、ずっとダイモスの管理を行ってきたんだ。",shape=box,color=red];
		138 -> 142;
	144 [label="ソルは、不格好な足を持って生を受ける不便さを、私の人生にもたらすのが適切だとお考えになったのです。歩くことはできませんでした。",shape=box,color=blue];
		144 -> 149;
