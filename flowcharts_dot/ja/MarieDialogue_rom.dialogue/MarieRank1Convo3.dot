	173 [label="Update boolean MarieSecretPower",color=orange];
		173 -> 179;
	174 [label="Ce qui est fait est fait。周りの多くの人が私より苦しんでいるのに、多くの人が私より困っているのに、ソルに奇跡を祈ることはできませんでした。ルミナリーズは私に多くのものを与えてくれたのですから。",shape=box,color=blue];
		174 -> 180;
	175 [label="それでも私は、これまでのように、喜んで受け入れました。しかしLyonは…　いえ、これは私からの口から伝えていいものではないのかもしれません。",shape=box,color=blue];
		175 -> 181;
