	150 [label="Non。まったくもって違いますわ。",shape=box,color=blue];
		150 -> 156;
	151 [label="まぁ！　自分の愚かさに笑いが止まりません。そうですよね、車輪が付いた椅子なのですから、車椅子。お恥ずかしいです。",shape=box,color=blue];
