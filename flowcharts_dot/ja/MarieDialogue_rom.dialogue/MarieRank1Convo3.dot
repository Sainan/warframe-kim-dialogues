	122 [label="それはそれで気になる回答ですが、また別の機会にお話ししましょう。Cela dit…",shape=box,color=blue];
		122 -> 97;
	123 [label="もしそうでしたら、あなたはきっと、仲間や組織、あるいはその両方を求める気持ちに苛まれているのでしょうね。それはまた別の機会にお話ししましょう。",shape=box,color=blue];
		123 -> 97;
	124 [label="どちらかと言うと、ここが崩壊しないようにするためだと思う。",shape=box,color=red];
