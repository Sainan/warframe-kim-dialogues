		143 -> 148;
	142 [label="Entratiが去ってからずっと、この場所と、Origin太陽系にVoidからのエネルギーを送り込む心臓を監視して、自分たちが…　力を維持できるようにしてるんだ。",shape=box,color=red];
		142 -> 861;
	149 [label="そう、それは単に不便なだけでした。",shape=box,color=blue];
