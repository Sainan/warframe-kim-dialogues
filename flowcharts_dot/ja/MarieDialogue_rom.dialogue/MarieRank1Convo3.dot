		170 -> 176;
	171 [label="+10 Chemistry",color=orange];
		171 -> 177;
	179 [label="Oui！　そうなのです。私は世界を別の視点から知ることができました。腕も強くなりました。忍耐力もつきました。その瞬間を楽しむことがどういうことか、理解できました。",shape=box,color=blue];
		179 -> 190;
