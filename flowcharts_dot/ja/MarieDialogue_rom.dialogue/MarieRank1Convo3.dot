		187 -> 199;
	188 [label="彼は自分を笑わせてくれる。面白い人だ、でもその裏には悲劇的で繊細な何かが隠れている。",shape=box,color=red];
		188 -> 200;
	189 [label="残念ながら、修復は不可能だ。あまり周りからも評判ではないみたいだ。",shape=box,color=red];
