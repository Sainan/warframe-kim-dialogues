		178 -> 187;
		178 -> 188;
		178 -> 189;
	176 [label="不必要に残酷だとは思いませんか？　もう死んでいるのか、それ以上に酷いことが起きているのかも知らないのです。それを私たちは黙って…　comme des rats d'égout？",shape=box,color=blue];
		176 -> 183;
