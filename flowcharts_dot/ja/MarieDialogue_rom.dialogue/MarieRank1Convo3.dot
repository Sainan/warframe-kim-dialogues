	126 [label="Update boolean MarieSerum1",color=orange];
		126 -> 131;
		126 -> 132;
	127 [label="ええ、霊や声が聞こえるというのは、私よりLyonの方がより詳しいでしょう。でも、ネクロなLoid様はどうなのでしょうか、後頭部に子供の落書きみたいなものもありますし。",shape=box,color=blue];
		127 -> 133;
	121 [label="Otakはかつてアルキメデス、オロキンの科学者、研究家だったんだ。彼に起きたことは、決してハッピーエンドではなかった。",shape=box,color=red];
		121 -> 129;
	120 [label="まぁ…　簡単に言うと、Entratiの家族の何人かが上の階にいて、彼らは…　自分たちがここにいることを把握していないんだ。",shape=box,color=red];
		120 -> 128;
	130 [label="そうなのかもしれませんね。あの空飛ぶ混合物は本物のLoid様のraison d'êtreや色合いに欠けているようですし。Cela dit...",shape=box,color=blue];
