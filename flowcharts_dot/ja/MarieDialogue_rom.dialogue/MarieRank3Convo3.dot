		1175 -> 1180;
	1176 [label="え？　いくつの時の話？",shape=box,color=red];
		1176 -> 1181;
	1182 [label="エントラティは私たちの生活を犯したわけではありません。Lyonと私の絆はこれまで以上に強いのです。ただ…　状況が変わっただけ、non ?",shape=box,color=blue];
		1182 -> 1186;
	1183 [label="彼がいなかったら、一体どうなっていたやら。多分丘のふもとに落ちていたかもしれませんね、Hah !",shape=box,color=blue];
		1183 -> 1187;
	1184 [label="彼は奇妙な方法で私を笑わせてくれます。でもあなたもそう、狼さん。ここにいるとがますます幸せに思えるようになっています。",shape=box,color=blue];
		1184 -> 1188;
	3923 [label="ちょっと聞いただけだよ。",shape=box,color=red];
		3923 -> 3925;
	3924 [label="安心した。",shape=box,color=red];
		3924 -> 3931;
	1180 [label="両親は何年もかけて、障害を乗り越えようと頑張ってくれたようですが…　歩き方を教えてくれた家庭教師。矯正器具や靴など…",shape=box,color=blue];
		1180 -> 1185;
	1181 [label="6歳？　７歳？　両親は何年もかけて、障害を乗り越えようと頑張ってくれたようですが…　歩き方を教えてくれた家庭教師。矯正器具や靴など…",shape=box,color=blue];
		1181 -> 1185;
	1186 [label="ルアは常に変化し続けています。ぶれないソルでさえ、その軌道は影響を受けているようです。",shape=box,color=blue];
		1186 -> 1191;
	1187 [label="彼は私の魂の片割れなの。私はここにいることについて、ますます幸せを感じています。",shape=box,color=blue];
		1187 -> 1188;
	1188 [label="彼が近々同じことに気づくことを願うばかりです...　しかし、悪魔はささやきと嘘で彼を悩ませているようです。",shape=box,color=blue];
		1188 -> 1192;
	3925 [label="+10 Chemistry",color=orange];
