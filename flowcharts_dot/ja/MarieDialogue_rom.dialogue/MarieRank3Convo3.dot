		1114 -> 1118 [label=false,color=brown];
	1115 [label="大聖堂での暮らしはどんな感じだったの？　エントラティが来た前の話を教えてほしい。",shape=box,color=red];
		1115 -> 1119;
	1117 [label="Marieはどこで生まれ育ったの？",shape=box,color=red];
		1117 -> 2425;
	1118 [label="[閉じる]",shape=box,color=red];
		1118 -> 1122;
	1116 [label="エントラティが来る前の大聖堂の生活の様子を教えてほしい。",shape=box,color=red];
		1116 -> 1120;
	1119 [label="寂しい、というのが本当のところでしょう。私にはLyonがいましたが、彼が時々豹変することはご存知ですよね。（ああ、あなたが彼と話すようになって、本当にうれしいです）",shape=box,color=blue];
		1119 -> 1123;
	2425 [label="Update boolean MarieBackstory1",color=orange];
		2425 -> 1121;
	1122 [label="Chat ends.",color=orange];
	1120 [label="ああ、あなたにとって興味深い話かどうかは分かりませんが、興味があるならお話ししてもいいでしょう。",shape=box,color=blue];
		1120 -> 1124;
	1123 [label="Update boolean MarieGraveyard2",color=orange];
		1123 -> 1126;
	1121 [label="言葉遣いでわかるかと思いましたが、あなたが私の知っている世界出身でないことを思い出しました。hah !",shape=box,color=blue];
		1121 -> 1125;
	1124 [label="私はソルの修道女としての義務を果たしながら過ごしました。聖餐台の器を磨いたり、教区民のための奉納物を並べたりしていたのです。",shape=box,color=blue];
		1124 -> 1127;
	1126 [label="でも寂しさに負けたから死者と多くの時間を費やしたわけではありません。",shape=box,color=blue];
		1126 -> 1129;
	1125 [label="ガリアという国の首都、la Cité de la Lumière出身です。広い世界の全体から見れば、ホルバニアからそれほど遠くありません。",shape=box,color=blue];
		1125 -> 1128;
	1127 [label="聖堂の地下室と墓地の手入れが一番好きな仕事でした。",shape=box,color=blue];
		1127 -> 1130;
		1127 -> 1131;
	1129 [label="Update boolean MarieGraveyard2",color=orange];
		1129 -> 1134;
	1128 [label="私の大聖堂は1999年にもまだ建っているのでしょうか。こう考えると面白いですね。",shape=box,color=blue];
		1128 -> 1132;
		1128 -> 1133;
	1130 [label="どうしてお気に入りの仕事だった？",shape=box,color=red];
		1130 -> 1135;
	1131 [label="え？　最後の部分を説明して。",shape=box,color=red];
		1131 -> 1136;
	1134 [label="その場には美しさと静寂があったのです。とても静かで、平和な場所。",shape=box,color=blue];
		1134 -> 1139;
	1132 [label="Marieはよく話がそれるな。",shape=box,color=red];
		1132 -> 1137;
	1133 [label="お友達に聞いてみようかな。二人ともかなり旅慣れてるから知っているかもしれない。確か、その街に行ったことがあるって言ってたような。",shape=box,color=red];
		1133 -> 1138;
	1135 [label="安らかに眠る方々とお話しするのは、意外に楽しかったのです。眠られている方は、私の悩み事を一言も避難せず、聞いてくれるのですから。",shape=box,color=blue];
		1135 -> 1140;
	1136 [label="大聖堂で亡くなった方のお世話をするのが仕事だったんです。地下納骨堂の床の埃を掃き、草むしりをすることを任されていました。",shape=box,color=blue];
		1136 -> 1135;
	1139 [label="安らかに眠る方々はもう、悩み事がないではないですか。誰にも話せない自分の悩みや et les activités des autres - 他の方の行動を誰かに喋りたいという欲求を満たしてくれたのではと今となっては思います。",shape=box,color=blue];
		1139 -> 1143;
	1137 [label="+5 Chemistry",color=orange];
		1137 -> 1141;
	1138 [label="+5 Chemistry",color=orange];
		1138 -> 1142;
	1140 [label="一言も返事をしてくれなかったのですが、気になりませんでした。mais cela me convenait tout à fait ! とはいえ、返事をしないほうが無難なのですがね。",shape=box,color=blue];
		1140 -> 1144;
	1143 [label="私にとって大きな悩みでも、安らかに受け止めてくれて、落ち着きを取り戻すことができるのです。",shape=box,color=blue];
		1143 -> 1146;
		1143 -> 1147;
		1143 -> 1148;
	1141 [label="気が付きましたか、oui？　Lyonはいつも、私が太陽の光を浴びて、そよ風に吹かれながらどこへでも漂うチリのようだってからかうのです。（彼と交流を始めたようで…　とても嬉しく思っています）",shape=box,color=blue];
		1141 -> 1145;
	1142 [label="ああ、気にしないでください。私の夢想です。もしその場所がもうないのなら、どんなに心が痛むでしょう。",shape=box,color=blue];
		1142 -> 1145;
	1144 [label="+5 Chemistry",color=orange];
		1144 -> 1149;
	1146 [label="うーん、自分は…　本当の死がとても怖い。死のそばにいるのは好きじゃないんだ。",shape=box,color=red];
		1146 -> 1151;
	1147 [label="そんな風に考えたことはなかった。",shape=box,color=red];
		1147 -> 1152;
	1148 [label="自分も墓地や霊園にいると同じような安らぎを感じる。言いたいことは分かるよ。",shape=box,color=red];
		1148 -> 1153;
	1145 [label="好奇心が旺盛なんです。tout ce qui existe - いろいろなことを知りたがる。カーディナルと出会う運命だったんだと思います。",shape=box,color=blue];
		1145 -> 1150;
	1149 [label="どう思います？　あなたのネクロLoid様のように、頭蓋骨が話しかけてきたら。Ha !",shape=box,color=blue];
		1149 -> 1154;
		1149 -> 1155;
	1151 [label="分かります。ちょっとmorbide Marie - 病的なMarie！　変な考えを持っていることは知っています。しかし、人それぞれではないのでしょうか。",shape=box,color=blue];
		1151 -> 1157;
	1152 [label="そういう発想がある方は少ないのかもしれませんね。私たちは、永遠の眠りにつく時のことを考えたくありませんもの。最期に近づくまでは。",shape=box,color=blue];
		1152 -> 1158;
	1153 [label="理解していただけて光栄です。",shape=box,color=blue];
		1153 -> 1158;
	1150 [label="Où en étais-je ? Ah ! Oui. あ、そうそう。私の話ですね。",shape=box,color=blue];
		1150 -> 1156;
	1154 [label="仕事といっても大変だったのではないか？　特に車椅子では。",shape=box,color=red];
		1154 -> 1159;
	1155 [label="話をできる友人はいなかったの？",shape=box,color=red];
		1155 -> 1160;
	1157 [label="誰かがあの世に去った方々のお世話をしなくてはいけませんもの。私は喜んで引き受けます。",shape=box,color=blue];
		1157 -> 1158;
	1158 [label="Lyonは私が地面に近いからお墓のことばかり考えるんだ、と冗談を言います。",shape=box,color=blue];
		1158 -> 1162;
	1156 [label="驚くかもしれませんが、実は裕福な famille 家庭に生まれました。ブルジョア階級で、オロキンに近い存在です。",shape=box,color=blue];
		1156 -> 1161;
	1159 [label="大変でした。しかし、時間になるとLyonが聖堂の地下室までの階段を手伝ってくれましたし、時間があれば何とかこなせたのです。",shape=box,color=blue];
		1159 -> 1163;
	1160 [label="Update boolean MarieGraveyard1",color=orange];
		1160 -> 1164;
	1162 [label="「頭の中が空っぽだから、幽霊でいっぱいなんでしょう」と言い返してやりました。",shape=box,color=blue];
		1162 -> 1166;
	1161 [label="しかし、生まれつき足が不自由で… mes pieds tordus et inutilisables。マモン ma mère は耐えられなかったようです。",shape=box,color=blue];
		1161 -> 1165;
	1163 [label="頑固さがあればさまざまな試練に乗り越えることができるのです。",shape=box,color=blue];
		1163 -> 1167;
	1164 [label="もちろん、Lyonが傍にいてくれました。でも、うまくいかない日もあったことを今なら理解いただけるでしょう。",shape=box,color=blue];
		1164 -> 1129;
	1166 [label="そうすると、私を丘から突き落とすぞと脅し、私は彼の法服をイラクサで満たすわよと脅し返しました。",shape=box,color=blue];
		1166 -> 1169;
	1165 [label="体裁を保たなければいけなかったのでしょう。守るべき「基準」を。",shape=box,color=blue];
		1165 -> 1168;
	1167 [label="まあ、意地と上半身の筋力があれば…　ha !",shape=box,color=blue];
		1167 -> 1170;
	1169 [label="La famille - 家族だから。",shape=box,color=blue];
		1169 -> 1172;
		1169 -> 1173;
		1169 -> 1174;
		1169 -> 3921;
	1168 [label="そうすると、障害をもって生まれたMarieはどうすればいいのでしょう。la Cité de la Lumièreに連れていかれ、自力で生きていくよう仕向けられました。",shape=box,color=blue];
		1168 -> 1171;
	1170 [label="Update boolean MarieGraveyard1",color=orange];
