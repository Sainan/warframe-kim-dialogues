	3941 [label="Vraiment？！",shape=box,color=blue];
		3941 -> 3942;
	1196 [label="あなたがおっしゃった通りですよね non？　不都合には必ず秘密の力が宿る、と。",shape=box,color=blue];
		1196 -> 1195;
	1195 [label="une indésirable pour ma mère マモンにとって望ましくない私だったけど、孤児の間では人気者になれたんです。",shape=box,color=blue];
		1195 -> 1197;
	3930 [label="でも、あなたに興味をそそられます、狼さん。ここにいるのが、ますます幸せに思えてきました。",shape=box,color=blue];
		3930 -> 1188;
	3937 [label="+10 Chemistry",color=orange];
		3937 -> 3938;
	3942 [label="+10 Chemistry",color=orange];
		3942 -> 3943;
	1197 [label="障害を持つ子供より哀れなものはありません。他の子達が一週間かけて盗み事をしても、私はたった一日で彼らの成果より多く稼げるのですから。",shape=box,color=blue];
		1197 -> 1198;
	3938 [label="ああ！Par Sol。正直言って、驚かされました。そして今、私はLoid様から隠れて、顔を赤らめながらここに座っているんです…",shape=box,color=blue];
		3938 -> 3939;
	3943 [label="これがどれほど私を幸せにするか、漂流者様には分からないでしょうね。でも、どうか、ご慎重に。",shape=box,color=blue];
		3943 -> 3944;
	1198 [label="でも人生は面白いですよね。les Sœurs de Sol ソルの修道女に見つけられ、保護を申し出られたのです。",shape=box,color=blue];
		1198 -> 1199;
		1198 -> 1200;
	3939 [label="Lyronを見捨てるなんてことはしませんよ。彼のことは漂流者様よりずっと長く知っています。",shape=box,color=blue];
		3939 -> 3940;
	3944 [label="Update boolean DrifterLyon",color=orange];
		3944 -> 3945;
	1199 [label="他の子供たちはどうなったの？",shape=box,color=red];
		1199 -> 1201;
	1200 [label="明らかに、Marieは受け入れたんだ。",shape=box,color=red];
		1200 -> 1202;
	3940 [label="+10 Chemistry",color=orange];
		3940 -> 1188;
	3945 [label="Lyonは私の魂の兄弟です。漂流者様が想像する以上に彼のことを愛していますが、彼は問題を抱えているのです。彼に恋焦がれる前に、どうか、ご慎重に。n'est-ce pas？",shape=box,color=blue];
		3945 -> 3946;
	1201 [label="+5 Chemistry",color=orange];
		1201 -> 1203;
	1202 [label="Oui どうすればよかったのでしょう。病気になるのは時間の問題だったのです。幼いころから十分に理解していました。",shape=box,color=blue];
		1202 -> 1204;
		1202 -> 1205;
	3946 [label="この件については近いうちにまたお話ししましょう。誤解しないでください。私は漂流者様を応援します！ただ、よく考えてみてほしいのです。",shape=box,color=blue];
		3946 -> 3940;
	1203 [label="本当に優しい心をお持ちなのですね。もちろん、全員一緒にとはできませんでしたが…　友だちのことは忘れません。",shape=box,color=blue];
		1203 -> 1206;
	1204 [label="修道女は親切だった？",shape=box,color=red];
		1204 -> 1207;
	1205 [label="大聖堂の暮らしにはすぐ慣れた？",shape=box,color=red];
		1205 -> 1208;
	1206 [label="私は毎週、給料と、台所や他の人から集めた残り物をもって友達たちに会いに行きました。",shape=box,color=blue];
		1206 -> 1209;
	1207 [label="Les Sœurs - 修道女たちはとても親切でした。でも、あなたがそうでないと不思議に思う理由は分かっています。",shape=box,color=blue];
		1207 -> 1210;
	1208 [label="とても心地いい場所でした。でも、あなたがそうでないと不思議に思う理由は分かっています。",shape=box,color=blue];
		1208 -> 1210;
	1209 [label="自分でできる限り、路頭で生活しているお友達の面倒を見ていたのですが、多くの子たちが天然痘や結核で亡くなってしまったのです…　",shape=box,color=blue];
		1209 -> 1211;
	1210 [label="三度の食事、温かい寝床、そして屋根がある家。殴られたり、強盗に遭ったり、酷い目に遭う心配を取り除いてくれた場所なのです。",shape=box,color=blue];
		1210 -> 1212;
	1211 [label="他の子は引っ越したり、喧嘩や暴力で亡くなった子もいました。しかし、大半の友達はまともな仕事を見つけて成長を遂げ、自分の famille を築いたんです。",shape=box,color=blue];
		1211 -> 1213;
	1212 [label="学校にも行かせてもらえ、ソルとルアの福音書も教えていただきました。信仰する中で自分の道を見つけるように言われたのです。いやだったら、いつでも去ることができました。",shape=box,color=blue];
		1212 -> 1214;
	1213 [label="中には大聖堂まで立ち寄って私に会いに来てくれる子もいたんです。心が温まりました。",shape=box,color=blue];
		1213 -> 1214;
	1214 [label="他の子たちに救出の手が伸びなかったのに、何で私だけ？　と長い間罪悪感を感じていました。今でも時々、その時の罪悪感がわきます。",shape=box,color=blue];
		1214 -> 1215;
		1214 -> 1216;
	1215 [label="周りで亡くなった人たちのことを考えながら、自分が生き残ったことに目を向けると、自分もMarieと同じ気持ちになる。でも、自分を追い込むのは良くない。現状を改善するための戦いを続けるほうが賢明だと自分は思う。",shape=box,color=red];
		1215 -> 1217;
	1216 [label="Marieは与えられた状況を活かして、他の人も助けようと最善を尽くしたんだね。他の人が今までMarieを支え、これからは他の人を支えようとしている想いは十分に伝わる。",shape=box,color=red];
		1216 -> 1218;
	1217 [label="この状況は永遠に続くものなのでしょうか。戦い？　私たちを溺れさせようとする者との潮流との戦いへと…",shape=box,color=blue];
		1217 -> 1219;
