		3931 -> 3933 [label=false,color=brown];
	1185 [label="しかし、重荷に疲れて果ててしまったようです。文字の読み書きさえままならない私は、泥沼に陥っていました。",shape=box,color=blue];
		1185 -> 1189;
		1185 -> 1190;
	1191 [label="狼さん、自分のやり方に執着してはいけないと思いません？　でないと、崩壊してしまうかもしれません。私はこの頃、ここにいることがますます幸せに思えるようになっています。",shape=box,color=blue];
