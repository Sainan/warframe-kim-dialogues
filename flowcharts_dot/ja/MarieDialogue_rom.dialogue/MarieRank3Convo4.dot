		j1328220227 -> j398906436;
	j3489892294 [label="Marieの方がLoidに詳しいんだって、驚いただけ。",shape=box,color=red];
		j3489892294 -> j1328220227;
	j1074605869 [label="Loidとの付き合いは長いけど、彼の過去については何も知らないんだ。",shape=box,color=red];
		j1074605869 -> j1328220227;
	j3703884515 [label="よくあること。Marieに限ったことじゃないよ。",shape=box,color=red];
		j3703884515 -> j30337456;
	j398906436 [label="まあ、お気を悪くしないで。S'il vous plaît！",shape=box,color=blue];
		j398906436 -> j2836830922;
	j30337456 [label="オロキンはわざと社会を混乱させたのでしょうか？",shape=box,color=blue];
