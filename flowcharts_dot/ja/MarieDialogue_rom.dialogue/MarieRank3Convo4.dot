		j30337456 -> j1208685145;
		j30337456 -> j3277274312;
	j2836830922 [label="ネクロなLoid様は、なんと言うか、遠い存在ではありませんか？",shape=box,color=blue];
		j2836830922 -> j319802000;
		j2836830922 -> j3445932819;
	j291526404 [label="何千年もの間、権力を握ってきたら…　飽きてしまって、複雑なシステムを作ろうとする。",shape=box,color=red];
		j291526404 -> j3479158669;
	j1208685145 [label="彼らは華麗で複雑なものを好んだ。　そして、官僚主義でさえも華麗で複雑にしたんだ。",shape=box,color=red];
		j1208685145 -> j3479158669;
	j3277274312 [label="正直なところ、そう思い始めているよ。",shape=box,color=red];
		j3277274312 -> j3479158669;
	j319802000 [label="Loidについては何も知らないんだ。",shape=box,color=red];
		j319802000 -> j2097943004;
