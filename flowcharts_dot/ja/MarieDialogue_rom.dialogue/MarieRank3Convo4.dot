		j3445932819 -> j2097943004;
	j3479158669 [label="+10 Chemistry",color=orange];
		j3479158669 -> j2959243711;
	j2097943004 [label="実際に私が時間を過ごしているのは誰でしょう、oui？　一を聞いて十を知るのはそれほど難しくありません。",shape=box,color=blue];
		j2097943004 -> j3544933495;
	j2959243711 [label="いらいらさせるのが目的だったのではないかしら。",shape=box,color=blue];
		j2959243711 -> j1451255618;
	j3544933495 [label="+10 Chemistry",color=orange];
		j3544933495 -> j923859140;
	j1451255618 [label="Et ils se demandent pourquoi des rébellions éclatent. Vous aviez peut-être vos warframes, mais nous avions nos guillotines !",shape=box,color=blue];
		j1451255618 -> j3566713005;
