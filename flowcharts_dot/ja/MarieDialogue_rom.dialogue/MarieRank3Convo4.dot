		j2262484473 -> j1096739946;
		j2262484473 -> j2457732779;
	j2271118669 [label="アルキメデスはオロキンだったのですか？　それとも、違ったのですか？　この言葉は軽々しく使われているようですが…",shape=box,color=blue];
		j2271118669 -> j761908374;
