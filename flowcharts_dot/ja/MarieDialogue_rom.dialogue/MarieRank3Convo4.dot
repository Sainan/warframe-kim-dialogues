	j2457732779 [label="ただ…　驚いただけだよ。",shape=box,color=red];
		j2457732779 -> j4088939371;
	j761908374 [label="悪魔に聞くこともできるでしょうが、できれば話したありません。",shape=box,color=blue];
		j761908374 -> j128052117;
		j761908374 -> j3870989586;
	j3613012973 [label="De la jalousie？　Pourquoi？　どうして嫉妬なさるの？",shape=box,color=blue];
		j3613012973 -> j1328220227;
	j4088939371 [label="Pourquoi？　どうして？",shape=box,color=blue];
