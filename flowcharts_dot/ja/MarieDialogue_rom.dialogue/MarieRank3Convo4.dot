		j4088939371 -> j1074605869;
	j128052117 [label="いや、アルキメデスはオロキンより低階級だった。",shape=box,color=red];
		j128052117 -> j3703884515;
	j3870989586 [label="オロキン帝国はオロキンが統治してたってだけじゃなく、オロキンっていうのは支配階級の名称でもあったんだ。",shape=box,color=red];
		j3870989586 -> j3703884515;
