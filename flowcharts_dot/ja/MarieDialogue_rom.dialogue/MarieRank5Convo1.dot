		2462 -> 2471 [label="MarieEntratiFan1",color=purple];
		2462 -> 2471 [label="MarieEntratiFan2",color=purple];
		2462 -> 2472 [label="false",color=purple];
	2463 [label="私たちがそのようなことをするのですか？　追放されたと？　カーディナルは自らそうしたように思えますが、そうではないと仰るのですか？",shape=box,color=blue];
		2463 -> 2474;
		2463 -> 2467;
	2464 [label="Lyonは多くの病を抱えています。そして、その多くは彼自身や彼の心に対する疑念が病因です。カーディナルは…事態を悪化させただけなのです。",shape=box,color=blue];
		2464 -> 2475;
		2464 -> 2467;
	2465 [label="私に何をしろというのですか？　カーディナルの肖像を燃やして非難しろと？　カーディナルをVoidへ堕とし、Tagfer様のように危害を加えると？",shape=box,color=blue];
		2465 -> 2474;
		2465 -> 2467;
	2466 [label="それこそが問題だ、Marie。君が他人に何を求めているかだ。他人が君やEntratiに求めていることじゃない。",shape=box,color=red];
		2466 -> 2476;
	2467 [label="Entratiはどこへ行っても人々を傷つける。だから、その傷を癒して元の状態に戻せるよう助けしたいんだ。「善」とか「悪」とかはどうだっていい。",shape=box,color=red];
		2467 -> 2477;
	2469 [label="Oui、一貫して彼を憎しんでおられるのですね。私が何を申し上げても、カーディナルへの憤りが和らぐことはないのでしょうか？",shape=box,color=blue];
		2469 -> 2482;
	2468 [label="つい先程まで、漂流者様も私と同じようにカーディナルを気に入っていると仰っていませんでしたか？ 心変わりされたのですか？",shape=box,color=blue];
		2468 -> 2478;
		2468 -> 2479;
		2468 -> 2480;
		2468 -> 2481;
	2470 [label="Oui、カーディナルをmonstreだと思っておられるのですね。彼には優しさもあるのに！",shape=box,color=blue];
		2470 -> 2482;
	2473 [label="つい先程まで、カーディナルがmonstruositéだと仰っていませんでしたか？　心変わりされたのですか？",shape=box,color=blue];
		2473 -> 2478;
		2473 -> 2479;
		2473 -> 2480;
		2473 -> 2481;
	2471 [label="Merci。この戦いにおいて、漂流者様は本当に頼りになりました！ 恐らく私たちだけがそう思っているのでしょう。Loid様でさえ、そのような憤りを抱いているのですから…",shape=box,color=blue];
		2471 -> 2483;
	2472 [label="Merci。本当に嬉しく思います。恐らく私たちだけがそう思っているのでしょう。Loid様でさえ、そのような憤りを抱いているのですから…",shape=box,color=blue];
		2472 -> 2483;
	2474 [label="問題は、Marieが他人に何を求めているかであって、他人がMarieやEntratiに求めていることではないと思う。",shape=box,color=red];
		2474 -> 2476;
	2475 [label="気にならないのか？",shape=box,color=red];
		2475 -> 2484;
	2476 [label="それで、私が他人に一体どんなグロテスクなことを求めるというのでしょう？ 心から許しを受け入れることでしょうか？",shape=box,color=blue];
		2476 -> 2485;
		2476 -> 2486;
	2477 [label="退屈でも、時空を越えてmécontents - 反対勢力を助けるのは、高潔な行為ではないでしょうか、non？　漂流者様が彼を恨んでいても…",shape=box,color=blue];
		2477 -> 2487;
		2477 -> 2488;
	2482 [label="この会話は間違いでした...",shape=box,color=blue];
		2482 -> 2493;
		2482 -> 2494;
	2478 [label="正直に言うと、この件についてMarieと話し合うのは大変だった。かなり辛かったよ。個人的には、Entratiは…　良い人でも悪い人でもなく、ただ善悪が混ざり合っているだけだと思ってる。",shape=box,color=red];
		2478 -> 2489;
	2479 [label="考えを変えるよ。Entratiの味方になる。Marieの味方だ。Marieの説得のおかげだよ。",shape=box,color=red];
		2479 -> 2490;
	2480 [label="[告白する] Marieに気に入られようって…　一生懸命頑張ってきたんだ。Marieに気持ちがある。自分が思っている以上に。",shape=box,color=red];
		2480 -> 2491;
	2481 [label="考えが固まった。Entratiは怪物だ。はっきりした。",shape=box,color=red];
		2481 -> 2492;
	2483 [label="一緒にいれば、彼の善行に泥を塗ろうとする人々から身を守れるかもしれません、oui？　でも…　なぜ周りを敵に回してまで、私の味方をしてくれるのですか？",shape=box,color=blue];
		2483 -> 2495;
	2484 [label="Check boolean LyonDating",color=orange];
		2484 -> 2496 [label=true,color=green];
		2484 -> 2497 [label=false,color=brown];
	2485 [label="Marie、MarieはEntratiを崇拝している。人にも同調を求めるなんてバカげているよ。",shape=box,color=red];
		2485 -> 2498;
	2486 [label="MarieはEntratiを許す以上のことを要求していると思う。Entratiのしたことが何も悪くなかったかのように振る舞うなんて無茶な要求だ。",shape=box,color=red];
		2486 -> 2499;
	2487 [label="まぁな。でも、自分がこれまでに築いてきた最も大切な人間関係の一部は、確かに彼に「感謝」すべきことかもしれない。",shape=box,color=red];
		2487 -> 2500;
	2488 [label="いや、そうでもない。Entratiが望むことをするだけだ。批判は、後回しでいい。",shape=box,color=red];
		2488 -> 2500;
	2493 [label="待って、Marie。お願いだ。聞いて欲しい。",shape=box,color=red];
		2493 -> 2505;
