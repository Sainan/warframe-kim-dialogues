		2492 -> 2504;
	2495 [label="不平を言っているわけではございません！",shape=box,color=blue];
		2495 -> 2510;
		2495 -> 2511;
		2495 -> 2512;
	2496 [label="漂流者様の心の中にLyonが居場所を見つけたことは知っています。そして、そのことに心から感謝しています。もしかすると、Lyonのことを心配しなくてもよくなるのかもしれませんね。そして、この争いもすぐに無意味なものになるかもしれません。",shape=box,color=blue];
		2496 -> 2497;
	2497 [label="もちろん彼のことはいつも気にはなります。魂の兄弟なのですから！　Lyonは私にとってこの世で最も大切な存在です。彼が苦しんでいるのを見ると、まるで自分のagonieであるかのように胸が痛むのです。",shape=box,color=blue];
		2497 -> 2513;
	2498 [label="ご発言にはお気をつけください、漂流者様。",shape=box,color=blue];
		2498 -> 2514;
	2499 [label="Je ne suis pas naïve - 子ども扱いなさらないで。私が幼く未熟かのように話さないでください！",shape=box,color=blue];
		2499 -> 2515;
	2500 [label="おそらくカーディナルは治療ために毒を刺していて、単に必要な残酷行為と言えるのではないでしょうか。",shape=box,color=blue];
		2500 -> 2516;
		2500 -> 2517;
	2505 [label="[告白する] Marieのことを気にかけてるんだ。今まで以上に。それに…　厳しく聞こえたら悪いんだけど、MarieがEntratiから傷つけられるのを見たくない。たくさんの人が傷つけられたのを見てきたから。",shape=box,color=red];
		2505 -> 2523;
	2506 [label="Entratiが、大切に思っているはずの人、愛する人、すべてを焼き尽くすのを見てきた。Marieに巻き込まれてほしくないんだ…",shape=box,color=red];
		2506 -> 2524;
	2507 [label="うまく言い表せられなくて、ごめん。　Entratiが…　Marieを、Marieの優しさを利用して操ろうとしているんじゃないかと思う。それだけ。",shape=box,color=red];
		2507 -> 2525;
	2508 [label="MarieはEntratiのことを救世主と思っているかもしれないけど、自分には答えを探し求める怯えた老人にしか見えないんだ。もしかしたら真の姿はその中間にあるのかもしれない。",shape=box,color=red];
		2508 -> 2498;
	2509 [label="Oui。そのようですね。",shape=box,color=blue];
		2509 -> 2526;
	2501 [label="Update boolean MarieEntratiMonster2",color=orange];
		2501 -> 2518;
	2502 [label="Update boolean MarieEntratiMonster2",color=orange];
		2502 -> 2519;
	2503 [label="私に好かれるために、私を騙そうとしたのですね...　je vois.",shape=box,color=blue];
		2503 -> 2520;
		2503 -> 2521;
	2504 [label="Update boolean MarieEntratiFan2",color=orange];
		2504 -> 2522;
	2510 [label="[告白する] Marieのことを大切に思っている。今まで自分が思ってきた以上に。",shape=box,color=red];
		2510 -> 2527;
	2511 [label="この戦いには何だって必要だと信じているんだ。何といっても、無関心のモノから宇宙を救うためだから。",shape=box,color=red];
		2511 -> 2528;
	2512 [label="Entratiを信じるよ。本当に。この問題を解決する計画があると思うし、全ては究極の善のためだから。",shape=box,color=red];
		2512 -> 2529;
	2513 [label="ですが、Lyonが信仰を喪失したのはカーディナルのせいではございません。信仰の土台にはすでに亀裂があったのですから。ただそこへ圧力が加わっただけなのです。oui？",shape=box,color=blue];
		2513 -> 2500;
	2514 [label="Update boolean MarieWarning",color=orange];
		2514 -> 2499;
	2515 [label="カーディナルがルアとソル、光と闇、善と悪の両方であることはよく知っています。彼はどちらでもなく、また両方でもあり、優しさと残酷さを持ち合わせているのです。",shape=box,color=blue];
		2515 -> 2530;
		2515 -> 2531;
	2516 [label="そんなこと言うから、皆が怒るんだ。MarieがEntratiについて話すとき、皆を傷つけた悪行を全部無視して、まるでなかったことのように話すじゃないか。バカみたいに。",shape=box,color=red];
		2516 -> 2498;
	2517 [label="ちょっと待ってMarie。Entratiがこんなことをするのは、ただ善人だからじゃないってことを受け入れるべきだ。彼は清廉潔白じゃない。もっと複雑な人間なんだ。",shape=box,color=red];
		2517 -> 2499;
	2523 [label="Update boolean DrifterMarie",color=orange];
		2523 -> 2536;
	2524 [label="ご発言にはお気をつけください、漂流者様。",shape=box,color=blue];
		2524 -> 2537;
	2525 [label="未熟な子供のように守られる必要はないのです！ 　Je ne suis pas une enfant naïve！",shape=box,color=blue];
		2525 -> 2538;
	2526 [label="Update boolean MarieEntrati5g",color=orange];
		2526 -> 2539;
	2518 [label="Update boolean MarieEntratiFan1",color=orange];
		2518 -> 2532;
	2519 [label="Update boolean MarieEntratiFan2",color=orange];
		2519 -> 2533;
	2520 [label="まあ、そう言われると… ",shape=box,color=red];
		2520 -> 2534;
	2521 [label="断片的にはそうかもしれない。",shape=box,color=red];
		2521 -> 2534;
	2522 [label="Update boolean MarieEntratiMonster2",color=orange];
		2522 -> 2535;
	2527 [label="Update boolean DrifterMarieWhoops",color=orange];
		2527 -> 2540;
	2528 [label="Oui！　その通りです！　やっと分別のある人を見つけられました。この戦いで無罪の人々が傷つけられるのは心が痛みますが、すべてが危機に瀕しているのです。 ",shape=box,color=blue];
		2528 -> 2541;
	2529 [label="Update boolean MarieWillDate",color=orange];
		2529 -> 2542;
	2530 [label="Marie、Entratiは神なんかじゃない。ただの男だ。Roatheと同じくらい傲慢で危険なんだ。Roatheと同じ社会に生まれ、同じ問題を抱えている。",shape=box,color=red];
		2530 -> 2543;
	2531 [label="EntratiがMarieに優しかったことは解ってる。もしかしたら、Marieを特別扱いしていたのかもしれない。娘のように接していたのかも…でも、もっと広い視野で考えてみたら？",shape=box,color=red];
		2531 -> 2544;
	2536 [label="今の、今の会話を…　この知らせをどう受け止めたらいいのか。本当に…　驚いています。 ",shape=box,color=blue];
		2536 -> 2549;
