		2429 -> 2435 [label="false",color=purple];
	2430 [label="カーディナルについておっしゃったことをずっと考えていました。彼の行動は…　善意と悪意が「混ざり合った」ものだと。",shape=box,color=blue];
		2430 -> 2436;
	2431 [label="カーディナルについておっしゃったことをずっと考えていました。彼の行動はLyonに計り知れない苦痛をもたらしました。",shape=box,color=blue];
		2431 -> 2436;
	2432 [label="Tagfer様に関する会話をしたときのことを思い出してください。彼がなぜカーディナルを軽蔑しているのかというあなたの説明を受けてから、私はじっくり考えていました。",shape=box,color=blue];
		2432 -> 2436;
	2433 [label="Tagfer様との口論についてずっと考えていました。なぜ彼がカーディナルをそれほど嫌うのか。",shape=box,color=blue];
		2433 -> 2436;
	2434 [label="Tagfer様との口論についてずっと考えていました。そしてこの口論に関するあなたの見解を。",shape=box,color=blue];
		2434 -> 2436;
	2435 [label="カーディナルについては、まだ語られていないことがたくさんあるように感じます。他の方々は、私と口論を勃発させないよう気を使って、神経質になっているようです。",shape=box,color=blue];
		2435 -> 2436;
	2436 [label="意地悪者、狂人、裏切り者と決めつけようとしている方がいるのは承知しています。しかし、私にとって、カーディナルはそのような存在ではなかったのです。",shape=box,color=blue];
		2436 -> 2437;
	2437 [label="Check boolean MarieBackstory1",color=orange];
		2437 -> 2439 [label=true,color=green];
		2437 -> 2438 [label=false,color=brown];
	2439 [label="おそらく見捨てられることに免疫を持っているからかもしれませんね。",shape=box,color=blue];
		2439 -> 2440;
	2438 [label="私は子供のころから異常だったから、壊れていたから…　家族に見捨てられ、路上での生活を余儀なくされました。上流社会に不向きだったからです。",shape=box,color=blue];
		2438 -> 2440;
	2440 [label="また、私には父親の立場で行く道を示してくれる人物がいませんでした。だからカーディナルの不在を許せるのかもしれません。",shape=box,color=blue];
		2440 -> 2441;
	2441 [label="Evaluate expressions",color=orange];
		2441 -> 2442 [label="MarieEntrati4a",color=purple];
		2441 -> 2443 [label="MarieEntrati4b",color=purple];
		2441 -> 2444 [label="MarieEntrati3a",color=purple];
		2441 -> 2445 [label="MarieEntrati3b",color=purple];
		2441 -> 2446 [label="MarieEntrati3",color=purple];
		2441 -> 2447 [label="false",color=purple];
	2442 [label="しかし、私は彼を許します。その事実は変わりません。彼の悪行よりも善行に価値があると信じているからです。",shape=box,color=blue];
		2442 -> 2448;
		2442 -> 2449;
		2442 -> 2450;
		2442 -> 2451;
		2442 -> 2452;
	2443 [label="Lyonが強く、信仰の危機を乗り越えることを祈っています。しかし、この危機は、カーディナルが生み出したものだとは思いません。",shape=box,color=blue];
		2443 -> 2448;
		2443 -> 2449;
		2443 -> 2450;
		2443 -> 2453;
		2443 -> 2454;
	2444 [label="ですから、Tagfer様とカーディナルによって被害を受けた方に関する説得力のある議論には感謝します。それでも私は、「悪行による害」よりも「善行」の方を高く評価します。",shape=box,color=blue];
		2444 -> 2448;
		2444 -> 2449;
		2444 -> 2450;
		2444 -> 2455;
		2444 -> 2456;
	2445 [label="ですから、Tagfer様の怒りは理解できますし、彼の主張にも共感できます。しかし、彼は心の中にカーディナルを許す余裕を見つけなければなりません。私は、「悪行による害」よりも「善行」の方を高く評価するからです。",shape=box,color=blue];
		2445 -> 2448;
		2445 -> 2449;
		2445 -> 2450;
		2445 -> 2457;
		2445 -> 2458;
	2446 [label="ですから、皆様…　特にTagfer様…　の体験談をお聞きできたことに感謝します。それでも私は、カーディナルの「悪行による害」よりも「善行」の方を高く評価します。",shape=box,color=blue];
		2446 -> 2448;
		2446 -> 2449;
		2446 -> 2450;
		2446 -> 2459;
	2447 [label="ですから、皆様の体験談をお聞きできたことに感謝します。それでも私は、カーディナルの「悪行による害」よりも「善行」の方を高く評価します。",shape=box,color=blue];
		2447 -> 2448;
		2447 -> 2449;
		2447 -> 2450;
	2448 [label="Marieが受けた善行に感謝することを責めている訳じゃない。ただ同じように、他の人々がEntratiの「悪行による害」に対し憤慨していることも責めないよ。",shape=box,color=red];
		2448 -> 2460;
	2449 [label="どうだかな。Entratiの行動は「善行」よりも「悪行による害」をもたらしたと思う。それをMarieにも分かってほしいんだ。",shape=box,color=red];
		2449 -> 2461;
	2450 [label="君の味方をするよ、Marie。Entratiの行いを責めることはできない。無関心のモノと戦っているのだから。",shape=box,color=red];
		2450 -> 2462;
	2451 [label="Entratiを許すのは正しい。もっと多くの人がMarieの導きに従えばいいな。",shape=box,color=red];
		2451 -> 2462;
	2452 [label="許した者を責めるつもりなんてない。自分達をEntratiから守らなければならない状況で、Entratiを許すことだってできる。",shape=box,color=red];
		2452 -> 2463;
	2453 [label="Lyonの苦しみは自業自得だと思う？",shape=box,color=red];
		2453 -> 2464;
	2454 [label="Marie、Lyonは信仰の危機以上の苦しみを抱えている。そして、その多くはEntratiに関係しているんだ。",shape=box,color=red];
		2454 -> 2461;
	2455 [label="自分がMarieに言ったことなんて、どうでも良かった？",shape=box,color=red];
		2455 -> 2465;
	2456 [label="Entratiがやったことを全部見たのに、どうして「悪行による害」よりも「善行」の方を高く評価するなんて思えるんだ？",shape=box,color=red];
		2456 -> 2461;
	2457 [label="Marieは、カビアとTagferが受けた被害の深刻さを軽く見ているよ。",shape=box,color=red];
		2457 -> 2461;
	2458 [label="許すことは大切だけど、Marieが思う以上にEntratiが複雑な存在であることも認めるべきだ。",shape=box,color=red];
		2458 -> 2465;
	2459 [label="Tagferとカビアがどんな苦しみを味わったのか、Marieには理解できないのか。君が経験したことよりもずっと酷いことなのに。",shape=box,color=red];
		2459 -> 2461;
	2460 [label="ですが、その二つに同等の価値などございません。　憤慨と感謝？　私は、人々が憎悪することに耐えられないのです。",shape=box,color=blue];
		2460 -> 2466;
		2460 -> 2467;
	2461 [label="Evaluate expressions",color=orange];
		2461 -> 2469 [label="MarieEntratiMonster1",color=purple];
		2461 -> 2469 [label="MarieEntratiMonster2",color=purple];
