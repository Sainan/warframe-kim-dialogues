		j148501058 -> j339456421 [label="false",color=purple];
	j617110327 [label="Loidを説得して階上のエントラティ家と話をさせる件について、また考えたんだ...　Marieは反対するかもしれないけど、いい案があるんだ。",shape=box,color=red];
		j617110327 -> j3431982611;
	j497611358 [label="Loidに階上のエントラティ家と話をさせる件について、また考えた？",shape=box,color=red];
		j497611358 -> j2607534784;
	j3692343244 [label="Loidとエントラティ家に話をさせる件について、Roatheも関わるべきか、また考えた？",shape=box,color=red];
		j3692343244 -> j1903226774;
	j2844003784 [label="Marie、Loidへ「上の階の住人」と話をすよう説得することに今もまだ賛成？　この間、話が変な感じで途切れてしまったから。",shape=box,color=red];
		j2844003784 -> j1903226774;
	j339456421 [label="どうしてLoid様がカーディナルのご家族と話すことをそんなに恐れているのかと考えておりました。",shape=box,color=blue];
		j339456421 -> j3149752599;
	j3431982611 [label="Check boolean MarieDating",color=orange];
		j3431982611 -> j2351691376 [label=true,color=green];
		j3431982611 -> j805801355 [label=false,color=brown];
	j2607534784 [label="Check boolean MarieDating",color=orange];
		j2607534784 -> j3324348136 [label=true,color=green];
		j2607534784 -> j3324348136 [label=false,color=brown];
	j1903226774 [label="Check boolean MarieDating",color=orange];
		j1903226774 -> j2550199527 [label=true,color=green];
		j1903226774 -> j3418456581 [label=false,color=brown];
	j3149752599 [label="そして、この袋小路をどう打破すべきか。私たちを閉じ込めているこのpurgatoireは、このまま存続すべきではないでしょう。あまりにも不要な苦難ではございませんか。",shape=box,color=blue];
		j3149752599 -> j3605328332;
	j2351691376 [label="Bonjour, mon cœur！　私が何に反対するとお考えですか？",shape=box,color=blue];
		j2351691376 -> j2995596583;
	j805801355 [label="Bonjourr！　あら？　私が何に反対するとお考えですか？",shape=box,color=blue];
		j805801355 -> j2995596583;
	j3324348136 [label="Bonjour mon cœur！　考えてみたのですが、oui…　でも、本当に認めたくないのです。このようなことを申し上げるのは、私にとって何の喜びにもならないのです。",shape=box,color=blue];
		j3324348136 -> j3624260175;
	j2550199527 [label="Bonjour, bonjour, mon cœur！　考えてみたのですが…　oui...　でも、本当に認めたくないのです。このようなことを申し上げるのは、私にとって何の喜びにもならないのです。",shape=box,color=blue];
		j2550199527 -> j2005833140;
	j3418456581 [label="Bonjour。少し考えてみましたが、oui…　認めたくないのです。こんなことを申し上げるのは、心苦しいのです。",shape=box,color=blue];
		j3418456581 -> j2005833140;
	j3605328332 [label="でも、何かしらの...　要塞が必要ではありませんか？　何かお考えはありますか？",shape=box,color=blue];
		j3605328332 -> j1274947719;
		j3605328332 -> j2995596583;
	j2995596583 [label="Loidにエントラティ家と対話させるには、Roatheの助けが必要かなって。他に手段はないだろう。家族と彼が守られるという保証がなければ。",shape=box,color=red];
		j2995596583 -> j1916115307;
	j3624260175 [label="でも、思うに…　ああ、ソル、お許しを。悪魔の助けが必要かもしれません。さもなくば、Loid様は私たちに耳を貸してはくれないでしょう。",shape=box,color=blue];
		j3624260175 -> j1458216234;
	j2005833140 [label="漂流者様の仰る通りかもしれません。悪魔こそが、必要な要素なのかもしれませんね。ああ、この文字を打つのすら不快です！ ",shape=box,color=blue];
		j2005833140 -> j636489540;
	j1274947719 [label="藁にもすがる以外に、いい案が思いつかないんだ。後始末が大変だったとしても。つまり、具体的にはRoatheだ。",shape=box,color=red];
		j1274947719 -> j3713453064;
	j1916115307 [label="私は...　認めたくございませんが、漂流者様のお考えは正しいかもしれません...　ソル、お許しを。",shape=box,color=blue];
		j1916115307 -> j636489540;
	j1458216234 [label="悪魔は強力で、難航する場面での強靭さは、信頼できるかもしれません。 non？",shape=box,color=blue];
		j1458216234 -> j1581903082;
		j1458216234 -> j959564936;
	j636489540 [label="Evaluate expressions",color=orange];
		j636489540 -> j1791132779 [label="RoatheFamilyFail",color=purple];
		j636489540 -> j3367479258 [label="RoatheRedeemed & RoatheFamilyDelay
",color=purple];
		j636489540 -> j3367479258 [label="RoatheRedeemed & RoatheFamilySuccess
",color=purple];
		j636489540 -> j3510132998 [label="RoatheVillain & RoatheFamilyDelay
",color=purple];
		j636489540 -> j3510132998 [label="RoatheVillain & RoatheFamilySuccess",color=purple];
		j636489540 -> j3766618356 [label="false",color=purple];
	j3713453064 [label="本当にそうお考えですか？　私が悪魔とのdifférencesに目をつぶれるなら、漂流者様もできるはず、non？",shape=box,color=blue];
		j3713453064 -> j221917744;
		j3713453064 -> j829882090;
	j1581903082 [label="いや、別の手段があるはず。彼に助けを求めるのは拒否する。",shape=box,color=red];
		j1581903082 -> j3713453064;
	j959564936 [label="そうだな。Marieが同意してくれるとは思ってなかった。聞くのが怖かったんだ。",shape=box,color=red];
		j959564936 -> j636489540;
	j1791132779 [label="この件について、彼が助けになるでしょうか？",shape=box,color=blue];
		j1791132779 -> j1404485644;
	j3367479258 [label="この件について、彼が助けになるでしょうか？",shape=box,color=blue];
		j3367479258 -> j3865368413;
	j3510132998 [label="この件について、彼が助けになるでしょうか？",shape=box,color=blue];
		j3510132998 -> j574597061;
	j3766618356 [label="ですが、彼を説得すれば、私たちは助かるとお考えですか？",shape=box,color=blue];
		j3766618356 -> j3670751987;
		j3766618356 -> j1095436944;
	j221917744 [label="できない、ごめん。 ",shape=box,color=red];
		j221917744 -> j1256711439;
	j829882090 [label="わかった。Marieがいいなら、賛成する。",shape=box,color=red];
		j829882090 -> j2219989327;
	j1404485644 [label="いや、残念ながら…　Roatheに関してはもう行き詰まってた。他に良い考えはある？",shape=box,color=red];
		j1404485644 -> j3260102237;
	j3865368413 [label="そう思うよ。Roatheを説得して、再会を促したいんだ。信じられないかもしれないけど、エントラティの家族を守るためなら。何といっても、オロキンに残されたものはあの家族だけだから。",shape=box,color=red];
		j3865368413 -> j9906375;
	j574597061 [label="そうなると思う。再会をけしかけさせるよう、Roatheを説得したんだ。解ってるだろ、Albrechtがいない間に嫌がらせするために。",shape=box,color=red];
		j574597061 -> j999545410;
	j3670751987 [label="まだ何も決まってないんだ。彼は…　まあ、お察しの通りだ。",shape=box,color=red];
		j3670751987 -> j2913252443;
	j1095436944 [label="まだ準備段階だけど、できるはず。",shape=box,color=red];
		j1095436944 -> j1104176810;
	j1256711439 [label="+20 Chemistry",color=orange];
		j1256711439 -> j454552271;
	j2219989327 [label="Oui、お楽しみは求めていませんが、服用しなくてはならないun médicamentということですね。",shape=box,color=blue];
		j2219989327 -> j636489540;
	j3260102237 [label="ああ！　それは…　残念です。どうでしょう？　解りません…　悪魔への別の交渉方法？　漂流者様は思いつきますか？",shape=box,color=blue];
		j3260102237 -> j2323580369;
	j9906375 [label="悪魔は、彼の意に反して彼をPROTOFRAMEに変え、記憶を奪って過去に送り込んだ男の家族を守ろうとするのですね...",shape=box,color=blue];
		j9906375 -> j1968905066;
	j999545410 [label="そうですね、私は...　驚きません。",shape=box,color=blue];
		j999545410 -> j924836722;
		j999545410 -> j4038074605;
	j2913252443 [label="Check boolean RoatheDating",color=orange];
		j2913252443 -> j103879065 [label=true,color=green];
		j2913252443 -> j3843981301 [label=false,color=brown];
	j1104176810 [label="Check boolean RoatheDating",color=orange];
		j1104176810 -> j2919680647 [label=true,color=green];
		j1104176810 -> j1031179415 [label=false,color=brown];
	j454552271 [label="そうならば、漂流者様のご選択を支持しましょう。",shape=box,color=blue];
		j454552271 -> j1179567760;
	j2323580369 [label="その間に私はLyonと話をするつもりです。でも、見通しは暗いかもしれません。",shape=box,color=blue];
		j2323580369 -> j715112311;
	j1968905066 [label="+20 Chemistry",color=orange];
		j1968905066 -> j1487868231;
	j924836722 [label="少なくとも助けにはなる。Roatherが実際に脅迫しないよう注意するつもりだ。",shape=box,color=red];
		j924836722 -> j2791117322;
	j4038074605 [label="隠蔽するための彼なりの言い訳だろう。",shape=box,color=red];
		j4038074605 -> j2751659349;
	j103879065 [label="Oui、わかります。でも、漂流者様は悪魔を説得する特別な方法をご計画のことと存じます、他の誰もなしえなかった、non？",shape=box,color=blue];
		j103879065 -> j605961896;
		j103879065 -> j966627920;
	j3843981301 [label="Oui、もちろんです。あの悪魔は、手に負えないところがあります。ただ反対意見を言って楽しんでいるように見える時もあるほどです！",shape=box,color=blue];
		j3843981301 -> j523744064;
		j3843981301 -> j2502401639;
	j2919680647 [label="悪魔を説得する特別な方法をご計画のことと存じます、他の誰もなしえなかった、non？",shape=box,color=blue];
		j2919680647 -> j605961896;
		j2919680647 -> j966627920;
	j1031179415 [label="幸運をお祈りします。あの悪魔は、手に負えないところがあります。ただ反対意見を言って楽しんでいるように見える時もあるほどです！",shape=box,color=blue];
		j1031179415 -> j523744064;
		j1031179415 -> j2502401639;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j715112311 [label="+20 Chemistry",color=orange];
		j715112311 -> j2235223957;
	j1487868231 [label="この悪魔のことを、ひどく誤解しておりました...",shape=box,color=blue];
		j1487868231 -> j28702733;
	j2791117322 [label="Oui。少なくとも、漂流者様のおかげで、悪魔が…下劣な本能に突き動かされないでしょう。",shape=box,color=blue];
		j2791117322 -> j2198758823;
	j2751659349 [label="Oui、漂流者様が正しいことを願います。",shape=box,color=blue];
		j2751659349 -> j2198758823;
	j605961896 [label="Roatheとの関係を、交渉手段として利用するつもりはない。",shape=box,color=red];
		j605961896 -> j1420284897;
	j966627920 [label="何が言いたいんだ、Marie？",shape=box,color=red];
		j966627920 -> j2716116272;
	j523744064 [label="奇妙に聞こえるかもしれないけど、自分も結構楽しんでいるんだ。相性がいいのかも。",shape=box,color=red];
		j523744064 -> j2447410170;
	j2502401639 [label="そうかもしれないが、でもほとんどの場合は単なる見せかけだと思う。",shape=box,color=red];
		j2502401639 -> j2470143502;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j2235223957 [label="悪魔は気まぐれです！　C'est la vie、と言うでしょう？",shape=box,color=blue];
		j2235223957 -> j3569999725;
	j28702733 [label="そして、このすべてが実現するよう、漂流者様がご尽力されたことも理解できております！",shape=box,color=blue];
		j28702733 -> j3242583483;
	j2198758823 [label="Check boolean MarieDating",color=orange];
		j2198758823 -> j3262641131 [label=true,color=green];
		j2198758823 -> j1875583284 [label=false,color=brown];
	j1420284897 [label="ああ！　そのようなつもりではございません、pardonne-moi！　ただ、悪魔は漂流者様に好意を持っているようですから、他人いうことは無視しても、漂流者様の声には耳を傾けてるかもしれません。",shape=box,color=blue];
		j1420284897 -> j3049862995;
	j2716116272 [label="+5 Chemistry",color=orange];
		j2716116272 -> j2855158212;
	j2447410170 [label="Oui、悪魔は漂流者様に好意を持っているのですね。同じ時間と場所を共有しているからでしょうか？　私には理解できないことですから。",shape=box,color=blue];
		j2447410170 -> j3822691405;
	j2470143502 [label="Oui？　どういう意味ですか？",shape=box,color=blue];
		j2470143502 -> j3822691405;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j3242583483 [label="Check boolean MarieDating",color=orange];
		j3242583483 -> j337127147 [label=true,color=green];
		j3242583483 -> j1366818043 [label=false,color=brown];
	j3262641131 [label="+10 Chemistry",color=orange];
		j3262641131 -> j209205829;
	j1875583284 [label="+10 Chemistry",color=orange];
		j1875583284 -> j1310432009;
	j3049862995 [label="+5 Chemistry",color=orange];
		j3049862995 -> j991842886;
	j2855158212 [label="何を仰っているのか全く分かりません！　何かをほのめかしている訳ではありません。私はただ単にune innocente Sœur de Solなのです。",shape=box,color=blue];
		j2855158212 -> j893660796;
	j3822691405 [label="Evaluate expressions",color=orange];
		j3822691405 -> j2733240581 [label="RoatheVillain",color=purple];
		j3822691405 -> j2038952119 [label="RoatheRedeemed",color=purple];
		j3822691405 -> j1261845683 [label="RoatheUnloved3",color=purple];
		j3822691405 -> j763156210 [label="RoatheTraitor2",color=purple];
		j3822691405 -> j1429710537 [label="RoatheExecutor2",color=purple];
		j3822691405 -> j1465964423 [label="false",color=purple];
	j337127147 [label="Merci, merci, merci, mon cœur！",shape=box,color=blue];
		j337127147 -> j955707618;
	j1366818043 [label="Merci, merci, merci！",shape=box,color=blue];
		j1366818043 -> j955707618;
	j209205829 [label="そうですね！　その時が来たら、準備万端で待っています！　それでは、merci, mon cœur.",shape=box,color=blue];
		j209205829 -> j3569999725;
	j1310432009 [label="そうですね！　その時が来たら、準備万端で待っています！　それでは、merci.",shape=box,color=blue];
		j1310432009 -> j3569999725;
	j991842886 [label="漂流者様がお幸せなら、私も嬉しいです。悪魔も努力するならば…なおのこと嬉しいですが、non？",shape=box,color=blue];
		j991842886 -> j1932572461;
	j893660796 [label="悪魔が漂流者様に好意を抱いているように見えるからといって、私は信用できません。すべての他人を無視して、漂流者様のことは聞くのでしょうか。",shape=box,color=blue];
		j893660796 -> j1214701684;
	j2733240581 [label="Roatheに関わる人は皆、彼を怪物に仕立て上げようとしてきた。自分以外は。",shape=box,color=red];
		j2733240581 -> j2889665744;
	j2038952119 [label="Roatheは、不器用なんだ。鎧とまでは言わないけど、他人から傷つけられないよう用心している。",shape=box,color=red];
		j2038952119 -> j1292323002;
	j1261845683 [label="彼は…　長い間、辛い思いをしてきた。それが心のかさぶたになって棘だらけに見えるだけ。",shape=box,color=red];
		j1261845683 -> j3975980492;
	j763156210 [label="Roatheがどれだけの年月を生きてきたか、理解できる。自分も同じくらい多くの死を見てきた。",shape=box,color=red];
		j763156210 -> j3994672832;
	j1429710537 [label="Roatheは常に正しいことをしようとしてきた。確かに、やり方は間違っていたかもしれない。でも、オロキンからOrigin太陽系を救おうとしていたんだ。",shape=box,color=red];
		j1429710537 -> j737587427;
	j1465964423 [label="Roatheには皮肉なユーモアのセンスがあって楽しいんだ。彼が心を許せば、賢いことが見て取れる。",shape=box,color=red];
		j1465964423 -> j216361732;
	j955707618 [label="そうですね！　その時が来たら、準備万端で待っています！　それでは！",shape=box,color=blue];
		j955707618 -> j3569999725;
	j1932572461 [label="漂流者が悪魔の肩でちょっとしたun angeとなって彼を落ち着かせることができるなら、なおさらに。",shape=box,color=blue];
		j1932572461 -> j832153635;
		j1932572461 -> j962241740;
	j1214701684 [label="個人的な時間には決してそうしません。Non. Jamais。",shape=box,color=blue];
		j1214701684 -> j2771766031;
		j1214701684 -> j4105372635;
	j2889665744 [label="近頃では私がその筆頭でしょうね、non？　悪魔がなぜあんな風になっているのか、その理由を考えるべきでは？　他者を非難しても何の役にも立ちません。",shape=box,color=blue];
		j2889665744 -> j3631445536;
	j1292323002 [label="私たちはいつも、他人に利用されるのを恐れ、自分の痛みを隠そうとします。もし漂流者様の仰ることが本当なら、悪魔にもっと優しくするよう努めます。",shape=box,color=blue];
		j1292323002 -> j3631445536;
	j3975980492 [label="これほどの年月で、悪魔はどれほどの愛と喪失を味わってきたのでしょう。私が見てきたことすべてを考慮したとしても、想像もつきません。",shape=box,color=blue];
		j3975980492 -> j300981845;
	j3994672832 [label="悪魔と話していると、彼が何世紀も生きてきたことを忘れることがあります。私が見てきたすべてのことを考えても、まるで現実とは思えないのです。",shape=box,color=blue];
		j3994672832 -> j477364563;
