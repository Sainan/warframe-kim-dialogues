		j3943324593 -> j610699294;
	j2596974909 [label="Add -1 to Thermostat counter",color=orange];
		j2596974909 -> j964400597;
	j1839947247 [label="+5 Chemistry",color=orange];
		j1839947247 -> j3235878789;
	j560837837 [label="なるほど。あなたは兵士を必要としているのですね。それでも、あの悪魔はあなたの背中を守るより、あなたの肋骨の間に短剣を突き刺すでしょうが。",shape=box,color=blue];
		j560837837 -> j4280914412;
	j610699294 [label="Le diable séduit les cœurs les plus forts。彼は狡猾な遊戯を仕掛けてきますが、油断は禁物です。目と目で向き合って確かめられないなら、用心するべきです。",shape=box,color=blue];
		j610699294 -> j2335823638;
	j964400597 [label="もう十分生き延びているようですが。地獄も一族が勝手に放浪して、すぐ呼び戻したいでしょうに。",shape=box,color=blue];
		j964400597 -> j2335823638;
	j3235878789 [label="あなたの慈悲を讃えます。心が喜びで満たされます。ルミナリーズでは、誰もが助けられ、誰もが許されると教えています。ただしそれは…　彼らがそれを求める場合に限ります。",shape=box,color=blue];
		j3235878789 -> j1623656206;
	j4280914412 [label="彼はあなたの味方ではありません、なりえません。あの悪魔は、自身の要求を満たす者だけに価値を見出しているのですから。",shape=box,color=blue];
		j4280914412 -> j3494804043;
		j4280914412 -> j4179993757;
		j4280914412 -> j929014736;
	j2335823638 [label="+5 Chemistry",color=orange];
		j2335823638 -> j3687693914;
	j1623656206 [label="自分自身の救済のために汗を流さない人々を助ける終わりのない奉仕は、欲求不満のままに残された奴隷の人生です。",shape=box,color=blue];
		j1623656206 -> j3494804043;
		j1623656206 -> j4179993757;
		j1623656206 -> j929014736;
	j3494804043 [label="オロキンに関しては自分の方が理解がある。助けはいらない。",shape=box,color=red];
		j3494804043 -> j3825252801;
	j4179993757 [label="忠告ありがとう。彼と接する際に覚えておくよ。",shape=box,color=red];
		j4179993757 -> j2315276204;
	j929014736 [label="ありがとう。でも自分で対処できる。彼よりもっと酷いものを対処してきたし。",shape=box,color=red];
		j929014736 -> j2567694325;
	j3687693914 [label="でも、不公平ですよね…　あなたは彼を知らないのですから。彼の本心を見抜いていない。それでも、あなたが傷つくのは悔やまれます。",shape=box,color=blue];
		j3687693914 -> j3494804043;
		j3687693914 -> j4179993757;
		j3687693914 -> j929014736;
	j3825252801 [label="Boolean MarieRoatheWarning is now true.",color=orange];
		j3825252801 -> j1804593188;
	j2315276204 [label="+10 Chemistry",color=orange];
		j2315276204 -> j2107367344;
	j2567694325 [label="+5 Chemistry",color=orange];
		j2567694325 -> j4038750903;
	j1804593188 [label="失礼しました。私はあなたのことをよく知りませんし、彼に対しての対抗策がどれほどなのかも理解していません。ただ、心配しているだけなのです。私たちのこともありますし。",shape=box,color=blue];
		j1804593188 -> j1271409015;
	j2107367344 [label="お願いできるのはそれだけです。Merci merci merci。さて、もう行かなくてはならないようです。",shape=box,color=blue];
		j2107367344 -> "Chat ends.";
	j4038750903 [label="Oui, vous avez raison。私はあなたのことをよく知りませんし、彼に対しての対抗策がどれほどなのかも理解していません。ただ、心配しているだけなのです。私たちのこともありますし。",shape=box,color=blue];
		j4038750903 -> j3093979999;
	j1271409015 [label="これ以上踏み込むような行為は控えます。",shape=box,color=blue];
		j1271409015 -> "Chat ends.";
	j3093979999 [label="ただ今は、行かなければなりません。",shape=box,color=blue];
		j3093979999 -> "Chat ends.";
