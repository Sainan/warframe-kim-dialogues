digraph {
	"MarieRank1Convo4 begins." [color=orange];
		"MarieRank1Convo4 begins." -> j3786372875;
	j3786372875 [label="私たちはまだ知り合って間もないです、なのでもし質問に無礼があれば謝ります。ただ、長い時を知るあなたの意見をどうしても知りたいのです。",shape=box,color=blue];
		j3786372875 -> j675041210;
		j3786372875 -> j1659195736;
		j3786372875 -> j738393015;
	j675041210 [label="正直、ほぼ覚えていないけど。",shape=box,color=red];
		j675041210 -> j3949323381;
	j1659195736 [label="もちろん構わない。どうぞ。",shape=box,color=red];
		j1659195736 -> j2947588656;
	j738393015 [label="[閉じる]",shape=box,color=red];
		j738393015 -> "Chat ends.";
	j3949323381 [label="ああソルよ！　なんて心苦しい言葉なのでしょう。あなたも悪魔も、破かれた本のように知識が断片的なのですね？",shape=box,color=blue];
		j3949323381 -> j150613363;
		j3949323381 -> j3022757889;
	j2947588656 [label="+5 Chemistry",color=orange];
		j2947588656 -> j523704316;
	"Chat ends." [color=orange];
	j150613363 [label="忘れている部分はそのままでいいと思っている。",shape=box,color=red];
		j150613363 -> j2433633230;
	j3022757889 [label="理由は違えど、ね。",shape=box,color=red];
		j3022757889 -> j4147271315;
	j523704316 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j523704316 -> j431475095 [label="x > 0",color=purple];
		j523704316 -> j1623207256 [label="x <= 0",color=purple];
		j523704316 -> j1623207256 [label="false",color=purple];
	j2433633230 [label="本当なのですか？　そう思っているのはあなただけみたいですが。あの子供から悪魔まで、誰もが自分の置き忘れた部分を探しているようです。",shape=box,color=blue];
		j2433633230 -> j418641112;
		j2433633230 -> j3959660885;
	j4147271315 [label="何故あなたはそこまでも見限っているのでしょうか？　子供と悪魔の理由は知っていますが、あなたのは理解できていません。",shape=box,color=blue];
		j4147271315 -> j418641112;
		j4147271315 -> j3959660885;
	j431475095 [label="何故悪魔の企みに加担するのですか？　かつて悪魔の同族を虐殺したとお聞きしたのですが。",shape=box,color=blue];
		j431475095 -> j2367439859;
		j431475095 -> j2584070786;
		j431475095 -> j908728377;
	j1623207256 [label="悪魔の企みに加担するつもりなのですか？　かつて悪魔の同族を虐殺したとお聞きしたのですが。",shape=box,color=blue];
		j1623207256 -> j2367439859;
		j1623207256 -> j2584070786;
		j1623207256 -> j908728377;
	j418641112 [label="自分は数えきれないほどの間…　ある意味、自分を殺していた。細部は思い出せなくてもいいと思っている。",shape=box,color=red];
		j418641112 -> j1674457478;
	j3959660885 [label="要約すると、自分は…　長い間苦しみ続けていた。忘れることは、ある種の自己防衛なのかもしれない。",shape=box,color=red];
		j3959660885 -> j818563749;
	j2367439859 [label="あれはもう一人の自分の行いだ。自分は社会ではなく個人に責任があると考えている。",shape=box,color=red];
		j2367439859 -> j414268083;
	j2584070786 [label="あれは自分じゃない、子供の方がしたことだ。でもあいつと同じくらいオロキンは嫌いだ。",shape=box,color=red];
		j2584070786 -> j493074310;
	j908728377 [label="ナーガ太鼓の夜、テンノがオロキンに反逆した時に、自分はいなかった。いたのは子供のほうだ。",shape=box,color=red];
		j908728377 -> j3696107583;
	j1674457478 [label="あなたを責めるつもりはありません。もし私がそのような虐待を受けたら、すべて隠してしまおうと躍起になるでしょう。少なくとも、掘り出したりはしないでしょう。",shape=box,color=blue];
		j1674457478 -> j1118350341;
	j818563749 [label="間違いありませんわ！　もし私がそのような虐待を受けたら、私の魂も同じようなことをするでしょう。治癒できないもの、善となりえないものを隠して。",shape=box,color=blue];
		j818563749 -> j1118350341;
	j414268083 [label="Add 1 to Thermostat counter",color=orange];
		j414268083 -> j3934288878;
	j493074310 [label="Add -1 to Thermostat counter",color=orange];
		j493074310 -> j1845577855;
	j3696107583 [label="ナーガ太鼓の夜。ああ、見えてきましたわ。Quelles couleurs magnifiques！",shape=box,color=blue];
		j3696107583 -> j1563746505;
	j1118350341 [label="+5 Chemistry",color=orange];
		j1118350341 -> j4280297291;
	j3934288878 [label="Oui, je comprends。異臭の原因は壁の中のネズミなのに、私たちは建物ごと燃やしてしまう傾向がありますからね。",shape=box,color=blue];
		j3934288878 -> j3533658022;
	j1845577855 [label="Je meurs d'envie de savoir pourquoi！　けどその話はまた今度、今は時間が足りませんし、これ以上Loid様を待たせても失礼です。",shape=box,color=blue];
		j1845577855 -> j4192617946;
	j1563746505 [label="詳細はLoid様に聞かないとなりませんわね。でも！",shape=box,color=blue];
		j1563746505 -> j4192617946;
	j4280297291 [label="しかし、これでこれから問う質問に対して理解が深まるかもしれません。",shape=box,color=blue];
		j4280297291 -> j523704316;
	j3533658022 [label="けどその話はまた今度、今は時間が足りませんし、これ以上Loid様を待たせても失礼です。",shape=box,color=blue];
		j3533658022 -> j4192617946;
	j4192617946 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
