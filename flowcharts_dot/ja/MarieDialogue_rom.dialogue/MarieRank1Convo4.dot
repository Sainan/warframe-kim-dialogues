	j4111045124 [label="Pardonnez-moi！　答えさせていませんでしたね。では、何故悪魔に加担するおつもりなのですか？",shape=box,color=blue];
		j4111045124 -> j2971888094;
		j4111045124 -> j3683974440;
		j4111045124 -> j2951518709;
		j4111045124 -> j773569758;
	j1617021889 [label="Pardonnez-moi！　答えさせていませんでしたね。それで悪魔に加担するおつもりなのですか？",shape=box,color=blue];
		j1617021889 -> j773569758;
		j1617021889 -> j2951518709;
		j1617021889 -> j3683974440;
		j1617021889 -> j2971888094;
	j2971888094 [label="助けない理由がまだ見つからないし…　一応。",shape=box,color=red];
		j2971888094 -> j592879036;
	j3683974440 [label="味方になりえるものを拒否する立場にいないから。",shape=box,color=red];
		j3683974440 -> j2180212628;
	j2951518709 [label="[Roatheへの興味を告白する] 少し気になっていて…",shape=box,color=red];
		j2951518709 -> j3943324593;
	j773569758 [label="彼は生き残るために必死みたいだ。それについて彼を責めることはできない。",shape=box,color=red];
		j773569758 -> j2596974909;
	j592879036 [label="Add 1 to Thermostat counter",color=orange];
		j592879036 -> j1839947247;
