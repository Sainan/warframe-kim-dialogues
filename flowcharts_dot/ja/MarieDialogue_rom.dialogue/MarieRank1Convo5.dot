digraph {
	3964 [label="MarieRank1Convo5 begins.",color=orange];
		3964 -> 3965;
	3965 [label="Bonjour, bonjour！漂流者様ですね？　ロイド様からあなたについてたくさんお話を伺いました。こうして「お会いできて」本当に嬉しいです…",shape=box,color=blue];
		3965 -> 3966;
	3966 [label="Appareil cliquetant、精密ね！",shape=box,color=blue];
		3966 -> 3967;
	3967 [label="私は修道女のMarie Lerouxです。Marieと呼んでください。最近、魂の兄弟である神父Lyon Allardと一緒にここへ参りました。　…あの、Loid様が悪魔について警告したかもしれませんね。",shape=box,color=blue];
		3967 -> 3968;
		3967 -> 3969;
		3967 -> 3970;
	3968 [label="初めまして。誤解しないで欲しいんだけど…　ここで何してるんだ？",shape=box,color=red];
		3968 -> 3972;
	3969 [label="悪魔？　オロキンのこと？",shape=box,color=red];
		3969 -> 3974;
	3970 [label="[閉じる]",shape=box,color=red];
		3970 -> 3971;
	3972 [label="+5 Chemistry",color=orange];
		3972 -> 3973;
	3974 [label="Oui、カーディナルから託された、ce monstre irritant à la peau bleueです。カーディナルのことは、Albrecht Entratiという名前でご存知ですね？　私たちがここにいる理由は彼にあるのです。長い話になりますが、 j'en ai bien peur。",shape=box,color=blue];
		3974 -> 3975;
		3974 -> 3976;
	3971 [label="Chat ends.",color=orange];
	3973 [label="Merci ! The what and the how of our being here is a very long story, j'en ai bien peur. We were sent here by le Cardinal. I believe you know him as Albrecht Entrati ? He entrusted us with that blue-skinned monstre irritant.",shape=box,color=blue];
		3973 -> 3975;
		3973 -> 3976;
	3975 [label="できる限りの助けになろう。",shape=box,color=red];
		3975 -> 3980;
	3976 [label="「託された」？",shape=box,color=red];
		3976 -> 3977;
	3980 [label="+5 Chemistry",color=orange];
		3980 -> 3981;
	3977 [label="彼の魂を導くため、si c'est possible、できる限りのことをしなくてはなりません。Et si ce n'est pas le cas、少なくとも彼がこれ以上の害を及ぼさないように。",shape=box,color=blue];
		3977 -> 3978;
		3977 -> 3979;
	3981 [label="Loid様とカビアが言った通り！　私たち、きっと良いお友達になれるでしょう。",shape=box,color=blue];
		3981 -> 3983;
	3978 [label="手を貸そう。",shape=box,color=red];
		3978 -> 3980;
	3979 [label="彼はオロキンだ。眉間に弾丸を撃ち込むしかない。",shape=box,color=red];
		3979 -> 3982;
	3983 [label="ああ！もう行かなくては。ごめんください。また近いうちにお話できますことを！À la revoyure！",shape=box,color=blue];
		3983 -> 3984;
	3982 [label="Lyonみたいな口調ですね。私は希望を捨てません。まだ今は。",shape=box,color=blue];
		3982 -> 3983;
	3984 [label="Chat ends.",color=orange];
}