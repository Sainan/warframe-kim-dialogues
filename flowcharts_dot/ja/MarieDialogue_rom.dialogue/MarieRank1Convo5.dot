digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo5 begins." [color=orange];
		"MarieRank1Convo5 begins." -> j2567659731;
	j2567659731 [label="Bonjour, bonjour！漂流者様ですね？　ロイド様からあなたについてたくさんお話を伺いました。こうして「お会いできて」本当に嬉しいです…",shape=box,color=blue];
		j2567659731 -> j1837127922;
	j1837127922 [label="Appareil cliquetant、精密ね！",shape=box,color=blue];
		j1837127922 -> j3216046071;
	j3216046071 [label="私は修道女のMarie Lerouxです。Marieと呼んでください。最近、魂の兄弟である神父Lyon Allardと一緒にここへ参りました。　…あの、Loid様が悪魔について警告したかもしれませんね。",shape=box,color=blue];
		j3216046071 -> j2892962508;
		j3216046071 -> j2415625058;
		j3216046071 -> j738393015;
	j2892962508 [label="初めまして。誤解しないで欲しいんだけど…　ここで何してるんだ？",shape=box,color=red];
		j2892962508 -> j2800597798;
	j2415625058 [label="悪魔？　オロキンのこと？",shape=box,color=red];
		j2415625058 -> j1049106474;
	j738393015 [label="[閉じる]",shape=box,color=red];
		j738393015 -> "Chat ends.";
	j2800597798 [label="+5 Chemistry",color=orange];
		j2800597798 -> j2054765310;
	j1049106474 [label="Oui、カーディナルから託された、ce monstre irritant à la peau bleueです。カーディナルのことは、Albrecht Entratiという名前でご存知ですね？　私たちがここにいる理由は彼にあるのです。長い話になりますが、 j'en ai bien peur。",shape=box,color=blue];
		j1049106474 -> j4176207427;
		j1049106474 -> j3121992435;
	"Chat ends." [color=orange];
	j2054765310 [label="Merci！　私たちがどうしてここにたどり着いたのかは、とても長い話なのです、j'en ai bien peur。私たちはカーディナルによってここへ来ました。Albrecht Entratiという名前はご存知ですね？　あの青い肌のmonstre irritantを私たちへ託したのです。",shape=box,color=blue];
		j2054765310 -> j4176207427;
		j2054765310 -> j3121992435;
	j4176207427 [label="できる限りの助けになろう。",shape=box,color=red];
		j4176207427 -> j4132213764;
	j3121992435 [label="「託された」？",shape=box,color=red];
		j3121992435 -> j2124665863;
	j4132213764 [label="+5 Chemistry",color=orange];
		j4132213764 -> j140704576;
	j2124665863 [label="彼の魂を導くため、si c'est possible、できる限りのことをしなくてはなりません。Et si ce n'est pas le cas、少なくとも彼がこれ以上の害を及ぼさないように。",shape=box,color=blue];
		j2124665863 -> j545790953;
		j2124665863 -> j2991647166;
	j140704576 [label="Loid様とカビアが言った通り！　私たち、きっと良いお友達になれるでしょう。",shape=box,color=blue];
		j140704576 -> j1454845948;
	j545790953 [label="手を貸そう。",shape=box,color=red];
		j545790953 -> j4132213764;
	j2991647166 [label="彼はオロキンだ。眉間に弾丸を撃ち込むしかない。",shape=box,color=red];
		j2991647166 -> j280427035;
	j1454845948 [label="ああ！もう行かなくては。ごめんください。また近いうちにお話できますことを！À la revoyure！",shape=box,color=blue];
		j1454845948 -> "Chat ends.";
	j280427035 [label="Lyonみたいな口調ですね。私は希望を捨てません。まだ今は。",shape=box,color=blue];
		j280427035 -> j1454845948;
}