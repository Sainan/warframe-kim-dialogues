digraph {
	"MarieRank3Convo2 begins." [color=orange];
		"MarieRank3Convo2 begins." -> j3102612293;
	j3102612293 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3102612293 -> j369807617;
	j369807617 [label="Check boolean LoidFamilyComplete",color=orange];
		j369807617 -> j2961086700 [label=true,color=green];
		j369807617 -> j1668831657 [label=false,color=brown];
	j2961086700 [label="おかしなことを言っていると思われそうですが、以前にも同じことをしたような奇妙な感覚がします。",shape=box,color=blue];
		j2961086700 -> j390748570;
	j1668831657 [label="Check boolean MarieFamily1",color=orange];
		j1668831657 -> j2688761601 [label=true,color=green];
		j1668831657 -> j3669878213 [label=false,color=brown];
	j390748570 [label="同じような会話をしたのです...　そして同じような人々に会いました...　ありえないことですが、non？",shape=box,color=blue];
		j390748570 -> j4220188979;
	j2688761601 [label="カーディナルのfamilleについて、もっと教えてくださいますか？　彼の過去を知りたいのです。",shape=box,color=blue];
		j2688761601 -> j1324378677;
		j2688761601 -> j4146510406;
		j2688761601 -> j738393015;
	j3669878213 [label="カーディナルのfamilleについて、教えてくださいますか？　彼の過去を知りたいのです。",shape=box,color=blue];
		j3669878213 -> j1324378677;
		j3669878213 -> j4146510406;
		j3669878213 -> j738393015;
	j4220188979 [label="+20 Chemistry",color=orange];
		j4220188979 -> j2622316766;
	j1324378677 [label="知っていることなら何でも話せるけど、残念ながらそれほど詳しくないんだ。",shape=box,color=red];
		j1324378677 -> j2704348015;
	j4146510406 [label="ああ。いいよ、でも…　Loidと話した方が良いんじゃないか？",shape=box,color=red];
		j4146510406 -> j2597954935;
	j738393015 [label="[閉じる]",shape=box,color=red];
		j738393015 -> "Chat ends.";
	j2622316766 [label="いわゆる、déjà vuですね。sérumと時間旅行のせいでしょうか。C'est la vie！",shape=box,color=blue];
		j2622316766 -> "Chat ends.";
	j2704348015 [label="あなたがお話してくれることなら何でも、興味があるのです。Promis！",shape=box,color=blue];
		j2704348015 -> j2778434895;
	j2597954935 [label="カーディナルが…　Loid様を深く傷つけたようですね。あまり強く言いたくはないけれど。",shape=box,color=blue];
		j2597954935 -> j2778434895;
	"Chat ends." [color=orange];
	j2778434895 [label="特に私はavec une certaine joie、誰よりカーディナルのことを知りたいのです。",shape=box,color=blue];
		j2778434895 -> j4152081396;
		j2778434895 -> j2737982492;
	j4152081396 [label="誰について知りたい？",shape=box,color=red];
		j4152081396 -> j2818708093;
	j2737982492 [label="えっと、2階にMother、Father、Son、DaughterとGrandmotherがいる。",shape=box,color=red];
		j2737982492 -> j2818708093;
	j2818708093 [label="一人ずつ教えてくれませんか？　私が尋ねるたびに、悪魔が駄洒落を言っているみたい。Grand-mèreとかGrandmotherとか。",shape=box,color=blue];
		j2818708093 -> j3064901851;
	j3064901851 [label="カーディナルの妻ではないのですね、non？",shape=box,color=blue];
		j3064901851 -> j3127619366;
	j3127619366 [label="いや、Fatherの母だ。Motherにとって姑。",shape=box,color=red];
		j3127619366 -> j49729768;
	j49729768 [label="Je... vois. では...　名前で呼ぶ方が簡単なのではないですか。Ne serait-ce pas plus simple？",shape=box,color=blue];
		j49729768 -> j1975545724;
		j49729768 -> j655136971;
	j1975545724 [label="詳しく知りたい？",shape=box,color=red];
		j1975545724 -> j1928341362;
	j655136971 [label="簡単に説明すると...",shape=box,color=red];
		j655136971 -> j2396612904;
	j1928341362 [label="Oui！　ぜひお聞かせください。",shape=box,color=blue];
		j1928341362 -> j2111302084;
	j2396612904 [label="オロキン帝国が崩壊したとき、上の階に住む一家が閉じ込められてしまった。エントラティの孫息子、Sonが感染体を侵入させたんだ。",shape=box,color=red];
		j2396612904 -> j1873198222;
	j2111302084 [label="自分たちはダイモスっていう衛星にいて、遠い昔、センティエントを撃退しようと必死になって、生物爆弾が爆発したんだ。",shape=box,color=red];
		j2111302084 -> j547998912;
	j1873198222 [label="Par Sol！　故意にですか？",shape=box,color=blue];
		j1873198222 -> j385755729;
	j547998912 [label="昔、オロキンが戦争していた者たちですか？　ダーク・リフラクトリーで悪魔と一緒にいる？　oui ？",shape=box,color=blue];
		j547998912 -> j3292886360;
	j385755729 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j385755729 -> j1620263571 [label=true,color=green];
		j385755729 -> j3342954407 [label=true,color=green];
		j385755729 -> j3342954407 [label=false,color=brown];
		j385755729 -> j4085152852 [label=false,color=brown];
	j3292886360 [label="そう。彼らはセンティエントと戦うために感染体を利用したがった。でも、ダイモスが侵略されて...　上にあるネクロリスクに避難したんだ。",shape=box,color=red];
		j3292886360 -> j1437696980;
	j1620263571 [label=" いや、事故だったと思う。彼には善意があったから。",shape=box,color=red];
		j1620263571 -> j2913995753;
	j3342954407 [label="まだ真実は分からない。詳細が分かるまでは判断しないでおく。",shape=box,color=red];
		j3342954407 -> j2913995753;
	j4085152852 [label="まだ真実は分からない。でも彼が横柄だってことは確実。",shape=box,color=red];
		j4085152852 -> j2446428393;
	j1437696980 [label="でも、エントラティの孫息子は、感染体生物を保護して研究することに熱心だった。",shape=box,color=red];
		j1437696980 -> j1864501119;
	j2913995753 [label="+10 Chemistry",color=orange];
		j2913995753 -> j807955359;
	j2446428393 [label="みっともない。彼のためにも、私たちのためにも、真実でないことを願うばかりです。続けてください。",shape=box,color=blue];
		j2446428393 -> j4048468201;
	j1864501119 [label="ああソルよ...　それは善意からの行いだったのですか？",shape=box,color=blue];
		j1864501119 -> j240603373;
	j807955359 [label="ご親切なのですね。続けてください、s'il vous plaît.",shape=box,color=blue];
		j807955359 -> j4048468201;
	j4048468201 [label="閉じ込められたネクロリスクの中、オロキン帝国に救われることもなく、悲しみに暮れている。そして今や感染体が侵入してきている...",shape=box,color=red];
		j4048468201 -> j2903845860;
	j240603373 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j240603373 -> j2982516838 [label=true,color=green];
		j240603373 -> j1610788470 [label=true,color=green];
		j240603373 -> j1243862901 [label=true,color=green];
		j240603373 -> j2982516838 [label=false,color=brown];
		j240603373 -> j1610788470 [label=false,color=brown];
		j240603373 -> j2499900232 [label=false,color=brown];
	j2903845860 [label="彼らは互いに攻撃し合い、引き裂き合った。そして、感染体が残りを奪い、彼らの名前まで奪い去った。 ",shape=box,color=red];
		j2903845860 -> j2028537553;
	j2982516838 [label="そうだと思う。Sonは本当に生き物のことを気にかけている。",shape=box,color=red];
		j2982516838 -> j3499295989;
	j1610788470 [label="そんなこと、どうだって良かったんだ。　あんなことが起こったから。",shape=box,color=red];
		j1610788470 -> j2663631032;
	j1243862901 [label="いや、Sonを突き動かしたのは傲慢さだった。本人が認めなかったとしても。",shape=box,color=red];
		j1243862901 -> j2446428393;
	j2499900232 [label="まだ真実は分からない。でも彼が横柄だってことは確実。",shape=box,color=red];
		j2499900232 -> j2446428393;
	j2028537553 [label="名前を奪われるなんて、残酷の極みですね...",shape=box,color=blue];
		j2028537553 -> j482800561;
	j3499295989 [label="+10 Chemistry",color=orange];
		j3499295989 -> j4179556189;
	j2663631032 [label="+5 Chemistry",color=orange];
		j2663631032 -> j3900675575;
	j482800561 [label="Boolean MarieFamily2 is now true.",color=orange];
		j482800561 -> j3553082885;
		j482800561 -> j851789173;
		j482800561 -> j3861325599;
	j4179556189 [label="Sonはカビアのことをどう思っていたのでしょう…　彼らに会えないなんて心苦しいでしょうに…",shape=box,color=blue];
		j4179556189 -> j2956778708;
		j4179556189 -> j2464107678;
	j3900675575 [label="もし、心の純粋さが重要視されるなら、世界は美しい場所になるでしょう、non？　C'est la vie.",shape=box,color=blue];
		j3900675575 -> j2019097572;
	j3553082885 [label="Grandmotherのように、手放さない限り。",shape=box,color=red];
		j3553082885 -> j4181180253;
	j851789173 [label="それほど悪くない。すぐに慣れるから。",shape=box,color=red];
		j851789173 -> j3651678465;
	j3861325599 [label="本来、動物たちに名前はないけど、とても幸せそうにしているんだ。勝手に名付けたのは、こちらの都合だ。",shape=box,color=red];
		j3861325599 -> j2195857006;
	j2956778708 [label="そうなれば良いけど、賢明な選択とは言えなそうだ。",shape=box,color=red];
		j2956778708 -> j1166006308;
	j2464107678 [label="いつかそうなることを願っているよ。本当に。",shape=box,color=red];
		j2464107678 -> j1526667533;
	j2019097572 [label="Et ensuite？　それから？",shape=box,color=blue];
		j2019097572 -> j4048468201;
	j4181180253 [label="+5 Chemistry",color=orange];
		j4181180253 -> j74589348;
	j3651678465 [label="ああ！　Quelle horreur！　そんなつもりではなかったのです！　本当にかたじけない、お許しください、そんなつもりでは決して。ああ、恥ずかしい！",shape=box,color=blue];
		j3651678465 -> j4093084074;
		j3651678465 -> j3172268577;
	j2195857006 [label="+5 Chemistry",color=orange];
		j2195857006 -> j1986490754;
	j1166006308 [label="どうして賢明でないのですか？",shape=box,color=blue];
		j1166006308 -> j4134305401;
		j1166006308 -> j2878716532;
	j1526667533 [label="Add 1 to Family counter",color=orange];
		j1526667533 -> j788680427;
	j74589348 [label="彼女に、お会いしてみたいです... ",shape=box,color=blue];
		j74589348 -> j2384124745;
	j4093084074 [label="どうやって謝ってくれる？",shape=box,color=red];
		j4093084074 -> j1783428898;
	j3172268577 [label="大丈夫、怒ってない。からかっただけだよ。",shape=box,color=red];
		j3172268577 -> j3031061061;
	j1986490754 [label="その通りですね、そんな風に考えたことはありませんでした。自分で名前を選べるなんて。本当に自由ですね。",shape=box,color=blue];
		j1986490754 -> j2384124745;
	j4134305401 [label="片方がもう片方を「別の家族」と見なさないか、心配だからだよ。",shape=box,color=red];
		j4134305401 -> j2696028897;
	j2878716532 [label="上の階の状況は…　最良の日でも不安定だ。彼らを怒らせたくない。",shape=box,color=red];
		j2878716532 -> j338036262;
	j788680427 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		j788680427 -> j383846575 [label=true,color=green];
		j788680427 -> j636474113 [label=false,color=brown];
	j2384124745 [label="素晴らしいお話でしたが、残念ながらluncheonを用意しなくては。Loid様が、紅茶の出し方を教えてくだださるのです。",shape=box,color=blue];
		j2384124745 -> "Chat ends.";
	j1783428898 [label="Maintenant, vous parlez aussi mal que le diable.　騙されませんよ、ご自分で解決なさって。",shape=box,color=blue];
		j1783428898 -> "Chat ends.";
	j3031061061 [label="+5 Chemistry",color=orange];
		j3031061061 -> j785089141;
	j2696028897 [label="Add 1 to Family counter",color=orange];
		j2696028897 -> j2430682999;
	j338036262 [label="魂の回復力に驚かれるでしょうね。私の周りの方たちは、年老いてなお壮健なのです。",shape=box,color=blue];
		j338036262 -> j2505184981;
	j383846575 [label="できるでしょう。うまく計画を立てられるなら、予想外に簡単かもしれません。 ",shape=box,color=blue];
		j383846575 -> j632231269;
		j383846575 -> j2878716532;
	j636474113 [label="Oui？　あなたの minuscule copie - オペレーター様と、階上のfamilleとは、どのようにやっていけるのかしら？",shape=box,color=blue];
		j636474113 -> j414317486;
		j636474113 -> j2878716532;
	j785089141 [label="Oh, loué soit Sol！　でも、疑問が湧いてきます…　あなたの呼び名の由来は？「Le Drifter」？",shape=box,color=blue];
		j785089141 -> j3589141736;
		j785089141 -> j1053574741;
	j2430682999 [label="+5 Chemistry",color=orange];
		j2430682999 -> j2377140318;
	j2505184981 [label="+5 Chemistry",color=orange];
		j2505184981 -> j2272384537;
	j632231269 [label="ただ、片方がもう片方のことを「別の家族」と見なさないように気をつけないと。",shape=box,color=red];
		j632231269 -> j2696028897;
	j414317486 [label="ゆっくり。慎重に。片方がもう片方のことを「別の家族」と見なさないように気をつけないと。",shape=box,color=red];
		j414317486 -> j2696028897;
	j3589141736 [label="自分で選んだわけじゃないんだ。",shape=box,color=red];
		j3589141736 -> j3365096639;
	j1053574741 [label="正直に言うと、覚えていないんだ。",shape=box,color=red];
		j1053574741 -> j3625413875;
	j2377140318 [label="Oh... ソル。あなたはもう、解決の糸口を見出したかもしれません。",shape=box,color=blue];
		j2377140318 -> j193346606;
	j2272384537 [label="あなたは彼らを何度も驚かせました。今度は彼らがあなたを驚かせる番でしょう。",shape=box,color=blue];
		j2272384537 -> j1125599955;
	j3365096639 [label="なんて自由でしょう！　自分の呼び名を選べるなんて。大聖堂では着る物さえ選べませんでした。Hah！",shape=box,color=blue];
		j3365096639 -> j2384124745;
	j3625413875 [label="あなたはたくさんのmystèresを持ち歩いているのですね！ ",shape=box,color=blue];
		j3625413875 -> j2384124745;
	j193346606 [label="Boolean MarieFamilyOther is now true.",color=orange];
		j193346606 -> j2817488205;
	j1125599955 [label="でも、お願いです。お話を続けてください。s'il vous plaît。あなたの小さな狼Marieは、狩りへ出る前に獲物について学ばなくてはなりません。non？",shape=box,color=blue];
		j1125599955 -> j3491640694;
		j1125599955 -> j3270763385;
		j1125599955 -> j4191119955;
	j2817488205 [label="興奮して我を忘れてしまいそうです - je suis assise ici, remuant sur ma chaise！",shape=box,color=blue];
		j2817488205 -> j1125599955;
	j3491640694 [label="どこまで話したっけ？",shape=box,color=red];
		j3491640694 -> j1367293090;
	j3270763385 [label="ちょっと不道徳じゃないか？",shape=box,color=red];
		j3270763385 -> j3150889842;
	j4191119955 [label="Marieの狩りなら、獲物になってやろうか...",shape=box,color=red];
		j4191119955 -> j2124441318;
	j1367293090 [label="Sonは、Animaux Infestés - 感染した生物を近づけ過ぎたのですね。",shape=box,color=blue];
		j1367293090 -> j4048468201;
	j3150889842 [label="Peut-être！　でも、善の名のもとにちょっぴり不道徳になったとしても、構わないわ。",shape=box,color=blue];
		j3150889842 -> j846052821;
		j3150889842 -> j227441666;
	j2124441318 [label="Boolean DrifterMarie is now true.",color=orange];
		j2124441318 -> j3475498505;
	j846052821 [label="そうだな…　じゃあ、話に戻ろう。",shape=box,color=red];
		j846052821 -> j4048468201;
	j227441666 [label="私は楽しかった。本当に。",shape=box,color=red];
		j227441666 -> j2152468697;
	j3475498505 [label="私を窮地に立たせるおつもりですか？　思わず声をあげてしまったので、Loid様に大丈夫かと聞かれました。ネズミを見たと嘘をついたのですが、この時期はネズミなどいないと言われました！",shape=box,color=blue];
		j3475498505 -> j2616478708;
	j2152468697 [label="Hah！　そう思っていました。冗談はさておき、お話に戻りましょう。 SonはAnimaux Infestés - 感染した生物を近づけ過ぎたのですね、oui？",shape=box,color=blue];
		j2152468697 -> j4048468201;
	j2616478708 [label="+5 Chemistry",color=orange];
		j2616478708 -> j2189726668;
	j2189726668 [label="Quelle méchanceté, tu es terrible ! Je te déteste et tu me fais rougir maintenant !",shape=box,color=blue];
		j2189726668 -> j1547246508;
		j2189726668 -> j846052821;
	j1547246508 [label="怒らせた？",shape=box,color=red];
		j1547246508 -> j1615517289;
	j1615517289 [label="Non！　お話を続けてください！",shape=box,color=blue];
		j1615517289 -> j4048468201;
}