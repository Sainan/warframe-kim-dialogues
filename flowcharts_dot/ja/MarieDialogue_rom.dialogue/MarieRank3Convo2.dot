		1069 -> 1074;
		1069 -> 1075;
	1070 [label="Add 1 to Family",color=orange];
		1070 -> 1050;
	1077 [label="彼女に、お会いしてみたいです... ",shape=box,color=blue];
		1077 -> 1085;
	1078 [label="どうやって謝ってくれる？",shape=box,color=red];
		1078 -> 1086;
	1079 [label="大丈夫、怒ってない。からかっただけだよ。",shape=box,color=red];
		1079 -> 1087;
	1080 [label="その通りですね、そんな風に考えたことはありませんでした。自分で名前を選べるなんて。本当に自由ですね。",shape=box,color=blue];
		1080 -> 1085;
	1074 [label="片方がもう片方を「別の家族」と見なさないか、心配だからだよ。",shape=box,color=red];
		1074 -> 1081;
	1075 [label="上の階の状況は…　最良の日でも不安定だ。彼らを怒らせたくない。",shape=box,color=red];
		1075 -> 1082;
	1050 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1050 -> 1083 [label=true,color=green];
		1050 -> 1084 [label=false,color=brown];
	1085 [label="素晴らしいお話でしたが、残念ながらluncheonを用意しなくては。Loid様が、紅茶の出し方を教えてくだださるのです。",shape=box,color=blue];
		1085 -> 1094;
	1086 [label="Maintenant, vous parlez aussi mal que le diable.　騙されませんよ、ご自分で解決なさって。",shape=box,color=blue];
		1086 -> 1095;
	1087 [label="+5 Chemistry",color=orange];
		1087 -> 1096;
	1081 [label="Add 1 to Family",color=orange];
		1081 -> 1088;
	1082 [label="魂の回復力に驚かれるでしょうね。私の周りの方たちは、年老いてなお壮健なのです。",shape=box,color=blue];
		1082 -> 1089;
	1083 [label="できるでしょう。うまく計画を立てられるなら、予想外に簡単かもしれません。 ",shape=box,color=blue];
		1083 -> 1090;
		1083 -> 1091;
	1084 [label="Oui？　あなたの minuscule copie - オペレーター様と、階上のfamilleとは、どのようにやっていけるのかしら？",shape=box,color=blue];
		1084 -> 1092;
		1084 -> 1093;
	1094 [label="Chat ends.",color=orange];
	1095 [label="Chat ends.",color=orange];
	1096 [label="Oh, loué soit Sol！　でも、疑問が湧いてきます…　あなたの呼び名の由来は？「Le Drifter」？",shape=box,color=blue];
		1096 -> 1099;
		1096 -> 1100;
	1088 [label="+5 Chemistry",color=orange];
		1088 -> 1097;
	1089 [label="+5 Chemistry",color=orange];
		1089 -> 1098;
	1090 [label="ただ、片方がもう片方のことを「別の家族」と見なさないように気をつけないと。",shape=box,color=red];
		1090 -> 1081;
	1091 [label="上の階の状況は…　最良の日でも不安定だ。彼らを怒らせたくない。",shape=box,color=red];
		1091 -> 1082;
	1092 [label="ゆっくり。慎重に。片方がもう片方のことを「別の家族」と見なさないように気をつけないと。",shape=box,color=red];
		1092 -> 1081;
	1093 [label="上の階の状況は…　最良の日でも不安定だ。彼らを怒らせたくない。",shape=box,color=red];
		1093 -> 1082;
	1099 [label="自分で選んだわけじゃないんだ。",shape=box,color=red];
		1099 -> 1103;
	1100 [label="正直に言うと、覚えていないんだ。",shape=box,color=red];
		1100 -> 1104;
	1097 [label="Oh... ソル。あなたはもう、解決の糸口を見出したかもしれません。",shape=box,color=blue];
		1097 -> 1101;
	1098 [label="あなたは彼らを何度も驚かせました。今度は彼らがあなたを驚かせる番でしょう。",shape=box,color=blue];
		1098 -> 1102;
	1103 [label="なんて自由でしょう！　自分の呼び名を選べるなんて。大聖堂では着る物さえ選べませんでした。Hah！",shape=box,color=blue];
		1103 -> 1085;
	1104 [label="あなたはたくさんのmystèresを持ち歩いているのですね！ ",shape=box,color=blue];
		1104 -> 1085;
	1101 [label="Update boolean MarieFamilyOther",color=orange];
		1101 -> 1105;
	1102 [label="でも、お願いです。お話を続けてください。s'il vous plaît。あなたの小さな狼Marieは、狩りへ出る前に獲物について学ばなくてはなりません。non？",shape=box,color=blue];
		1102 -> 1106;
		1102 -> 1107;
		1102 -> 3914;
	1105 [label="興奮して我を忘れてしまいそうです - je suis assise ici, remuant sur ma chaise！",shape=box,color=blue];
		1105 -> 1102;
	1106 [label="どこまで話したっけ？",shape=box,color=red];
		1106 -> 1108;
	1107 [label="ちょっと不道徳じゃないか？",shape=box,color=red];
		1107 -> 1109;
	3914 [label="Marieの狩りなら、獲物になってやろうか...",shape=box,color=red];
		3914 -> 3915;
	1108 [label="Sonは、Animaux Infestés - 感染した生物を近づけ過ぎたのですね。",shape=box,color=blue];
		1108 -> 1049;
	1109 [label="Peut-être！　でも、善の名のもとにちょっぴり不道徳になったとしても、構わないわ。",shape=box,color=blue];
		1109 -> 1110;
		1109 -> 1111;
	3915 [label="Update boolean DrifterMarie",color=orange];
		3915 -> 3913;
	1110 [label="そうだな…　じゃあ、話に戻ろう。",shape=box,color=red];
		1110 -> 1049;
	1111 [label="私は楽しかった。本当に。",shape=box,color=red];
		1111 -> 1112;
	3913 [label="私を窮地に立たせるおつもりですか？　思わず声をあげてしまったので、Loid様に大丈夫かと聞かれました。ネズミを見たと嘘をついたのですが、この時期はネズミなどいないと言われました！",shape=box,color=blue];
		3913 -> 3916;
	1112 [label="Hah！　そう思っていました。冗談はさておき、お話に戻りましょう。 SonはAnimaux Infestés - 感染した生物を近づけ過ぎたのですね、oui？",shape=box,color=blue];
		1112 -> 1049;
	3916 [label="+5 Chemistry",color=orange];
		3916 -> 3917;
	3917 [label="Quelle méchanceté, tu es terrible ! Je te déteste et tu me fais rougir maintenant !",shape=box,color=blue];
		3917 -> 3918;
		3917 -> 3919;
	3918 [label="怒らせた？",shape=box,color=red];
		3918 -> 3920;
	3919 [label="そうだな…　じゃあ、話に戻ろう。",shape=box,color=red];
		3919 -> 1049;
	3920 [label="Non！　お話を続けてください！",shape=box,color=blue];
