	2923 [label="Check boolean LoidFamilyComplete",color=orange];
		2923 -> 2924 [label=true,color=green];
		2923 -> 1016 [label=false,color=brown];
	2924 [label="おかしなことを言っていると思われそうですが、以前にも同じことをしたような奇妙な感覚がします。",shape=box,color=blue];
		2924 -> 2925;
	1016 [label="Check boolean MarieFamily1",color=orange];
		1016 -> 1017 [label=true,color=green];
		1016 -> 1018 [label=false,color=brown];
	2925 [label="同じような会話をしたのです...　そして同じような人々に会いました...　ありえないことですが、non？",shape=box,color=blue];
		2925 -> 2926;
	1017 [label="カーディナルのfamilleについて、もっと教えてくださいますか？　彼の過去を知りたいのです。",shape=box,color=blue];
		1017 -> 1020;
		1017 -> 1021;
		1017 -> 1019;
	1018 [label="カーディナルのfamilleについて、教えてくださいますか？　彼の過去を知りたいのです。",shape=box,color=blue];
		1018 -> 1020;
		1018 -> 1021;
		1018 -> 1019;
	2926 [label="+20 Chemistry",color=orange];
		2926 -> 2927;
	1020 [label="知っていることなら何でも話せるけど、残念ながらそれほど詳しくないんだ。",shape=box,color=red];
		1020 -> 1023;
	1021 [label="ああ。いいよ、でも…　Loidと話した方が良いんじゃないか？",shape=box,color=red];
		1021 -> 1024;
	1019 [label="[閉じる]",shape=box,color=red];
		1019 -> 1022;
	2927 [label="いわゆる、déjà vuですね。sérumと時間旅行のせいでしょうか。C'est la vie！",shape=box,color=blue];
		2927 -> 2928;
	1023 [label="あなたがお話してくれることなら何でも、興味があるのです。Promis！",shape=box,color=blue];
		1023 -> 1025;
	1024 [label="カーディナルが…　Loid様を深く傷つけたようですね。あまり強く言いたくはないけれど。",shape=box,color=blue];
		1024 -> 1025;
	1022 [label="Chat ends.",color=orange];
	2928 [label="Chat ends.",color=orange];
	1025 [label="特に私はavec une certaine joie、誰よりカーディナルのことを知りたいのです。",shape=box,color=blue];
		1025 -> 1026;
		1025 -> 1027;
	1026 [label="誰について知りたい？",shape=box,color=red];
		1026 -> 1028;
	1027 [label="えっと、2階にMother、Father、Son、DaughterとGrandmotherがいる。",shape=box,color=red];
		1027 -> 1028;
	1028 [label="一人ずつ教えてくれませんか？　私が尋ねるたびに、悪魔が駄洒落を言っているみたい。Grand-mèreとかGrandmotherとか。",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="カーディナルの妻ではないのですね、non？",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="いや、Fatherの母だ。Motherにとって姑。",shape=box,color=red];
		1030 -> 1031;
	1031 [label="Je... vois. では...　名前で呼ぶ方が簡単なのではないですか。Ne serait-ce pas plus simple？",shape=box,color=blue];
		1031 -> 1032;
		1031 -> 1033;
	1032 [label="詳しく知りたい？",shape=box,color=red];
		1032 -> 1034;
	1033 [label="簡単に説明すると...",shape=box,color=red];
		1033 -> 1035;
	1034 [label="Oui！　ぜひお聞かせください。",shape=box,color=blue];
		1034 -> 1036;
	1035 [label="オロキン帝国が崩壊したとき、上の階に住む一家が閉じ込められてしまった。エントラティの孫息子、Sonが感染体を侵入させたんだ。",shape=box,color=red];
		1035 -> 1037;
	1036 [label="自分たちはダイモスっていう衛星にいて、遠い昔、センティエントを撃退しようと必死になって、生物爆弾が爆発したんだ。",shape=box,color=red];
		1036 -> 1038;
	1037 [label="Par Sol！　故意にですか？",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="昔、オロキンが戦争していた者たちですか？　ダーク・リフラクトリーで悪魔と一緒にいる？　oui ？",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1039 -> 1041 [label=true,color=green];
		1039 -> 1042 [label=true,color=green];
		1039 -> 1042 [label=false,color=brown];
		1039 -> 1043 [label=false,color=brown];
	1040 [label="そう。彼らはセンティエントと戦うために感染体を利用したがった。でも、ダイモスが侵略されて...　上にあるネクロリスクに避難したんだ。",shape=box,color=red];
		1040 -> 1044;
	1041 [label=" いや、事故だったと思う。彼には善意があったから。",shape=box,color=red];
		1041 -> 1045;
	1042 [label="まだ真実は分からない。詳細が分かるまでは判断しないでおく。",shape=box,color=red];
		1042 -> 1045;
	1043 [label="まだ真実は分からない。でも彼が横柄だってことは確実。",shape=box,color=red];
		1043 -> 1046;
	1044 [label="でも、エントラティの孫息子は、感染体生物を保護して研究することに熱心だった。",shape=box,color=red];
		1044 -> 1047;
	1045 [label="+10 Chemistry",color=orange];
		1045 -> 1048;
	1046 [label="みっともない。彼のためにも、私たちのためにも、真実でないことを願うばかりです。続けてください。",shape=box,color=blue];
		1046 -> 1049;
	1047 [label="ああソルよ...　それは善意からの行いだったのですか？",shape=box,color=blue];
		1047 -> 1076;
	1048 [label="ご親切なのですね。続けてください、s'il vous plaît.",shape=box,color=blue];
		1048 -> 1049;
	1049 [label="閉じ込められたネクロリスクの中、オロキン帝国に救われることもなく、悲しみに暮れている。そして今や感染体が侵入してきている...",shape=box,color=red];
		1049 -> 1053;
	1076 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1076 -> 1051 [label=true,color=green];
		1076 -> 1052 [label=true,color=green];
		1076 -> 1055 [label=true,color=green];
		1076 -> 1051 [label=false,color=brown];
		1076 -> 1052 [label=false,color=brown];
		1076 -> 1054 [label=false,color=brown];
	1053 [label="彼らは互いに攻撃し合い、引き裂き合った。そして、感染体が残りを奪い、彼らの名前まで奪い去った。 ",shape=box,color=red];
		1053 -> 1058;
	1051 [label="そうだと思う。Sonは本当に生き物のことを気にかけている。",shape=box,color=red];
		1051 -> 1056;
	1052 [label="そんなこと、どうだって良かったんだ。　あんなことが起こったから。",shape=box,color=red];
		1052 -> 1057;
	1055 [label="いや、Sonを突き動かしたのは傲慢さだった。本人が認めなかったとしても。",shape=box,color=red];
		1055 -> 1059;
	1054 [label="まだ真実は分からない。でも彼が横柄だってことは確実。",shape=box,color=red];
		1054 -> 1059;
	1058 [label="名前を奪われるなんて、残酷の極みですね...",shape=box,color=blue];
		1058 -> 1062;
	1056 [label="+10 Chemistry",color=orange];
		1056 -> 1060;
	1057 [label="+5 Chemistry",color=orange];
		1057 -> 1061;
	1059 [label="みっともない。彼のためにも、私たちのためにも、真実でないことを願うばかりです。続けてください。",shape=box,color=blue];
		1059 -> 1049;
	1062 [label="Update boolean MarieFamily2",color=orange];
		1062 -> 1066;
		1062 -> 1067;
