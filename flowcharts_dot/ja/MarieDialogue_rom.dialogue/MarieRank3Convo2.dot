	1060 [label="Sonはカビアのことをどう思っていたのでしょう…　彼らに会えないなんて心苦しいでしょうに…",shape=box,color=blue];
		1060 -> 1063;
		1060 -> 1064;
	1061 [label="もし、心の純粋さが重要視されるなら、世界は美しい場所になるでしょう、non？　C'est la vie.",shape=box,color=blue];
		1061 -> 1065;
	1066 [label="Grandmotherのように、手放さない限り。",shape=box,color=red];
		1066 -> 1071;
	1067 [label="それほど悪くない。すぐに慣れるから。",shape=box,color=red];
		1067 -> 1072;
	1068 [label="本来、動物たちに名前はないけど、とても幸せそうにしているんだ。勝手に名付けたのは、こちらの都合だ。",shape=box,color=red];
		1068 -> 1073;
	1063 [label="そうなれば良いけど、賢明な選択とは言えなそうだ。",shape=box,color=red];
		1063 -> 1069;
	1064 [label="いつかそうなることを願っているよ。本当に。",shape=box,color=red];
		1064 -> 1070;
	1065 [label="Et ensuite？　それから？",shape=box,color=blue];
		1065 -> 1049;
	1071 [label="+5 Chemistry",color=orange];
		1071 -> 1077;
	1072 [label="ああ！　Quelle horreur！　そんなつもりではなかったのです！　本当にかたじけない、お許しください、そんなつもりでは決して。ああ、恥ずかしい！",shape=box,color=blue];
		1072 -> 1078;
		1072 -> 1079;
