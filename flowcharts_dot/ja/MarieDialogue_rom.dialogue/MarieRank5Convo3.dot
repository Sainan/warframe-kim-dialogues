		j1695872261 -> j2716662205;
	j4036451400 [label="本当に治療法はないの？　完治することも？",shape=box,color=red];
		j4036451400 -> j2776975771;
	j1697793753 [label="無理強いはしない。でもいつでも相談に乗る。",shape=box,color=red];
		j1697793753 -> j3202886260;
	j2841244982 [label="その気持ち、わかる。「ループ」を始める前、デュヴィリでひどい怪我をしたんだ。傷は治ったけど、今でも時々ひどい痛みが走る。そんな時、辛い顔を見せないよう努力しているから。",shape=box,color=red];
		j2841244982 -> j4156372010;
	j204257106 [label="昔から続く問題は、新しい問題と変わらないくらい厄介な時がある。現れては消え、現れては消えと繰り返すからといって、話す価値がないわけではない。",shape=box,color=red];
		j204257106 -> j2798692267;
	j812084048 [label="心とは本当に不思議なものですね。いつも傷ついているはずなのに、傷心を無視する術を身に着けたのです。",shape=box,color=blue];
		j812084048 -> j424630961;
		j812084048 -> j3847713567;
		j812084048 -> j1415023941;
	j424630961 [label="まったく同感。集中した瞬間に、そう、また痛みが湧いてくる。だから自分を忙しくさせてるのかな、って思うこともある。",shape=box,color=red];
		j424630961 -> j1453836946;
	j3847713567 [label="痛みに気を取られていなければ、もっと多くのことを成し遂げられたって考えると、腹が立つことだってある。",shape=box,color=red];
		j3847713567 -> j1378819069;
	j1415023941 [label="Marieもいつも疲れている？　時々、自分がこんなに疲れるのは、痛みのせいかって考えることがあるんだ。痛みを感じながら、何時間も過ごすこともあるから。",shape=box,color=red];
