	j819297735 [label="Oui、大丈夫です。ご心配いただきありがとうございます。Merci。",shape=box,color=blue];
		j819297735 -> "Chat ends.";
	j2020523874 [label="Ha！　何がおかしいのです、non？　漂流者様のおっしゃる通り。Mes piedsのことなんて考えていませんでしたが、今考えてみると、痛みます。 ",shape=box,color=blue];
		j2020523874 -> j812084048;
	j4111090 [label="Oui！　漂流者様から話しかけていただくことが、まさに助けです。心とは素晴らしいものですね？　きっといつも痛みを感じているのでしょうが、それを無視する術を学びました。",shape=box,color=blue];
