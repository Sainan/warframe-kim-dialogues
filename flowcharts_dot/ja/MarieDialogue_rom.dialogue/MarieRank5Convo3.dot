		j2532233654 -> j294333591;
	j3804663449 [label="Oui、そうです。Par exemple -",shape=box,color=blue];
		j3804663449 -> j411946851;
	j124963930 [label="でも、漂流者様が仰った通りですね？　私のような不自由な者には、必ず秘密の力があります。それを見つけ出さなければなりません。",shape=box,color=blue];
		j124963930 -> j3535074003;
