		j2970100664 -> j3790003360;
	j1905811962 [label="Oui、漂流者様のイライラはよく分かります。私も本棚の一番上にある本を眺めるとき、届かないなんてなんて不公平だろう、と考えてしまうのです。",shape=box,color=blue];
		j1905811962 -> j3437286034;
	j294333591 [label="Oui！　ああ、よく分かります！　Par exemple -",shape=box,color=blue];
		j294333591 -> j3846251900;
	j411946851 [label="他の人が歩いているのに、私はいつも、jour après jour, heure après heure、浮かんでいなければならないのって、どんなに疲れることか、ご存知ですか？",shape=box,color=blue];
		j411946851 -> j1311290139;
	j3535074003 [label="でも、確かにイライラします。本棚の一番上にある本を眺めるとき、届かないなんてなんて不公平だろう、と考えてしまうのです。",shape=box,color=blue];
		j3535074003 -> j3395738179;
	j3395738179 [label="書物には、他の誰よりも私が大切にしている知識が詰まっているのに、なぜ私には届かないのか？そして、憐れみの心からその知識を取ってくれる親切な人が現れたのです…",shape=box,color=blue];
		j3395738179 -> j201146417;
	j3114470247 [label="忙しく動き続けていなくてはならないのです、とLoid様に申しました。私がなぜそんなに活動的でいる必要があるのか、Loid様には理解できなかったかもしれません。",shape=box,color=blue];
		j3114470247 -> j313489817;
	j1285042220 [label="しかし、まだ足があるような感覚に陥るときがあります。私を食い尽くそうと脅かし、魂から希望と喜びを砕こうとするあの歪んだものたちを。",shape=box,color=blue];
		j1285042220 -> j1953711703;
	j552941083 [label="自分を裏切り、精神を鈍らせる身体を持つなんて。今でもとても不思議な気がします。Sérum - 血清は私を変え、飛翔力を与えてくれました。",shape=box,color=blue];
		j552941083 -> j3176043779;
	j3650673224 [label="忙しく動き続けていなくてはならないのです、とLoid様に申しました。私がなぜそんなに活動的でいる必要があるのか、Loid様には理解できなかったかもしれません。",shape=box,color=blue];
		j3650673224 -> j2226955590;
	j3790003360 [label="でも、漂流者様のイライラはよく分かります。私も本棚の一番上にある本を眺めるとき、届かないなんてなんて不公平だろう、と考えてしまうのです。",shape=box,color=blue];
		j3790003360 -> j3437286034;
	j3437286034 [label="書物には、他の誰よりも私が大切にしている知識が詰まっているのに、なぜ私には届かないのか？　そして、憐れみの心からその知識を取ってくれる親切な人が現れたのです…",shape=box,color=blue];
		j3437286034 -> j2074066855;
		j3437286034 -> j465370634;
	j3846251900 [label="他の人が歩いているのに、私はいつも、jour après jour, heure après heure、浮かんでいなければならないのって、どんなに疲れることか、ご存知ですか？",shape=box,color=blue];
		j3846251900 -> j1336432379;
	j1311290139 [label="誤解なさらないで。こんなに機動力があって、欲しいものに何でも手が届くなんて、本当にravie。でも、本当に疲れるのです！",shape=box,color=blue];
		j1311290139 -> j313489817;
	j201146417 [label="彼らは親切な行為をしているのですから、決して彼らのせいではありません。私が助けを必要としていただけなのです。私が助けを必要としていたことは、彼らのせいではありません。だた、ああ、助けを求めるというのは、なんてもどかしいことなのでしょう。",shape=box,color=blue];
		j201146417 -> j1183262772;
		j201146417 -> j2117057163;
	j313489817 [label="こういうことを話せるなんて…　本当に嬉しいです。うまく言葉にできませんが、目に見えない私の苦しみ…　静かな病について話せるなんて、本当に貴重な経験です。",shape=box,color=blue];
		j313489817 -> j572840585;
	j1953711703 [label="常に痛いのです。いつも。今ここに座りながら思い出すと、痛みを感じます。しかし、気付くだけでは十分でありません。",shape=box,color=blue];
		j1953711703 -> j2881833750;
		j1953711703 -> j1810495003;
	j3176043779 [label="しかし、まだ足があるような感覚に陥るときがあります。私を食い尽くそうと脅かし、魂から希望と喜びを砕こうとするあの歪んだものたちを。",shape=box,color=blue];
		j3176043779 -> j463112673;
	j2226955590 [label="ああ、ここに誰かがこの気持ちを理解してくれていると知るだけで、本当に嬉しいです。本当に稀なことですから。私たちを苦しめる、静かで目に見えない病。",shape=box,color=blue];
		j2226955590 -> j1733733774;
	j2074066855 [label="何が悪いんだ？",shape=box,color=red];
		j2074066855 -> j4268774793;
	j465370634 [label="ああ、分かってる。彼らのせいじゃない。",shape=box,color=red];
		j465370634 -> j542783322;
	j1336432379 [label="誤解なさらないで。こんなに機動力があって、欲しいものに何でも手が届くなんて、本当にravie。でも、本当に疲れるのです！！",shape=box,color=blue];
		j1336432379 -> j2226955590;
	j1183262772 [label="Marieが全部我慢しなくちゃいけないなんて可哀そうだ。 ",shape=box,color=red];
		j1183262772 -> j114677902;
	j2117057163 [label="そしてその不満を表現することもできないんだな。",shape=box,color=red];
		j2117057163 -> j114677902;
	j572840585 [label="まるで小さなabeilleが肩に舞い降りて毎日刺してくるように。私たちを滅ぼす程ではないけれど、とても気に障るような。",shape=box,color=blue];
		j572840585 -> j1366759076;
		j572840585 -> j3474558921;
	j463112673 [label="常に痛いのです。いつも。今ここに座りながら思い出すと、痛みを感じます。しかし、気付くだけでは十分でありません。",shape=box,color=blue];
		j463112673 -> j2167504986;
		j463112673 -> j1940057466;
	j1733733774 [label="まるで小さなabeilleが私たちの上に舞い降りて、毎日刺してくるかのように。私たちを滅ぼす程ではないけれど、とても気に障るような。",shape=box,color=blue];
		j1733733774 -> j3474558921;
		j1733733774 -> j1366759076;
	j4268774793 [label="いえ！　何も問題ないのです。ただ助けが必要でした。でも、それが根本的な問題でしょうか。私は助けを必要としていました。そして、あなたが仰ったように…　その事実が気に障るのです。",shape=box,color=blue];
		j4268774793 -> j488783335;
	j542783322 [label="Oui！　彼らは親切な行為をしているのですから、決して彼らのせいではありません。私が助けを必要としていただけなのです。私が助けを必要としていたことは、彼らのせいではありません。だた、ああ、助けを求めるというのは、なんてもどかしいことなのでしょう。",shape=box,color=blue];
		j542783322 -> j488783335;
	j114677902 [label="+10 Chemistry",color=orange];
