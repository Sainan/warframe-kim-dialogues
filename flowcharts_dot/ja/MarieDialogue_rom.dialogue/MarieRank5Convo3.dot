	j488783335 [label="+5 Chemistry",color=orange];
		j488783335 -> j2226955590;
	j3017492382 [label="私もそう願います！　でも同時に、その病ですら私たちを私たちたらしめるとも思うのです。私たちのどの部分が重要で、どの部分が重要でないのか...　そのようなことは私たち自身が決められることでしょうか？",shape=box,color=blue];
