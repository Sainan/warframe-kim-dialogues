	3211 [label="+20 Chemistry",color=orange];
		3211 -> 3214;
	3212 [label="Ha！　ありがとうございます。これで私の愚かな涙は止まるでしょう。狼さんは、お馬鹿なMarieを元気づける方法をよくご存じね、non？",shape=box,color=blue];
		3212 -> 3215;
		3212 -> 3216;
	3213 [label="Oui。漂流者様の仰るとおりです。世の中にはOtak様のような話は尽きることがなく、もっとひどい話もたくさんあります。いちいち泣くべきではないですね。 ",shape=box,color=blue];
		3213 -> 3217;
	3214 [label="Merci。もうそんな気分にはなれません。気晴らしになるようなことをします！　Fibonacci様の水槽はそろそろ掃除した方がよろしいかと。",shape=box,color=blue];
