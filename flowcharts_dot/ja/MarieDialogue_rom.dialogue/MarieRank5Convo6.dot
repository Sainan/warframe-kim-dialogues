		3186 -> 3188 [label="MarieCephalonUnsure",color=purple];
		3186 -> 3187 [label="false",color=purple];
	3190 [label="ああ、ルミナリーズ - 彼の魂を科学と明滅する光の殻に閉じ込めておくために、どんな地獄をお創りになられたのでしょう？",shape=box,color=blue];
		3190 -> 3194;
	3189 [label="私はルミナリーズに祈ることしかできません。漂流者様が仰るように、殻の中に残っているのが科学と明滅する光だけであるように。",shape=box,color=blue];
		3189 -> 3193;
	3188 [label="セファロンに魂が宿るかどうか、漂流者様が確信を持てないのは存じております。でも私ができることは、ルミナリーズに祈ることだけなのです…　哀れなOtak様が苦しまないように。",shape=box,color=blue];
		3188 -> 3192;
	3187 [label="私は、ただルミナリーズに祈ることしかできません。殻の中に残っているのが科学と明滅する光だけでありますように、と。",shape=box,color=blue];
		3187 -> 3191;
	3194 [label="なぜそこに彼を置き去りにし、打ちのめし、安らぎを得るまで息絶えるのを待つのでしょうか？　私はただ祈るしかありません…　そこに何か存在があれば…",shape=box,color=blue];
		3194 -> 3197;
	3193 [label="そして、その殻の中に閉じ込められ、最終的に息絶え、平安が与えられるまで待てる魂など存在しません。",shape=box,color=blue];
		3193 -> 3196;
	3192 [label="その殻の中に閉じ込められ、最終的に息絶え、平安が与えられるまで待てる魂など存在しません。",shape=box,color=blue];
		3192 -> 3195;
	3191 [label="そして、その殻の中に閉じ込められ、最終的に息絶え、平安が与えられるまで待てる魂など存在しません。",shape=box,color=blue];
		3191 -> 3195;
	3197 [label="なぜなら、魂が自らの意志で孤独な見張りとして留まるからでは...",shape=box,color=blue];
		3197 -> 3200;
	3196 [label="もし漂流者様が間違っていて、魂が意志に反してその檻の中に留まるとしたら？",shape=box,color=blue];
		3196 -> 3199;
	3195 [label="あるいは、もし何らかの存在があるとすれば、それは彼が自らの選択で、ある種の孤独な見張りとしてそこに留まっているのでしょう。",shape=box,color=blue];
		3195 -> 3198;
	3200 [label="そうでないと考えると、神々の優しさに疑問を抱かずにはいられません、non？",shape=box,color=blue];
		3200 -> 3201;
