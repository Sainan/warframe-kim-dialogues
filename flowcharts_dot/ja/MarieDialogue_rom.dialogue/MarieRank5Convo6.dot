	3140 [label="私、やっとOtak様に会えました！",shape=box,color=blue];
		3140 -> 3143;
		3140 -> 3144;
	3142 [label="狼さん！　私の狼さん！　私、ネクロなLoid様の後ろにあるお顔に、遂に会えました！",shape=box,color=blue];
		3142 -> 3145;
		3142 -> 3146;
		3142 -> 3147;
	3141 [label="ネクロなLoid様の後ろにあるお顔！　ついに会えたのです！",shape=box,color=blue];
		3141 -> 3145;
		3141 -> 3146;
		3141 -> 3147;
	3143 [label="Otakとの会話はどうだった？",shape=box,color=red];
		3143 -> 3148;
	3144 [label="Otakと話すのは楽しかった？",shape=box,color=red];
		3144 -> 3149;
	3145 [label="Otakに会ったの？　おお...　どうだった？",shape=box,color=red];
		3145 -> 3150;
	3146 [label="やっと会えて良かったな。Otakって、ちょっと説明しにくい性格だよな。",shape=box,color=red];
		3146 -> 3151;
	3147 [label="かわいそうなOtak…　どうだった？",shape=box,color=red];
		3147 -> 3152;
	3148 [label="Otak様は...　まるで初対面かのように、同じ会話の中で3回も自己紹介されました。",shape=box,color=blue];
		3148 -> 3153;
	3149 [label="ええ楽しみました。でも同時に、泣きたくもなったのです。同じ会話の中で3回も自己紹介されたのです、まるで初対面かのように。",shape=box,color=blue];
		3149 -> 3153;
	3150 [label="私がOtak様に会ったこと、あまり嬉しくないのですか？",shape=box,color=blue];
		3150 -> 3154;
		3150 -> 3155;
		3150 -> 3156;
	3151 [label="ああ、確かにそうですね。子供が自動装置の裏に書いた落書きみたいな。本当に可愛くて魅力的なお方でした！",shape=box,color=blue];
		3151 -> 3157;
	3152 [label="Otak様は本当に優しくて魅力的なお方でした！　でも、ユーモアの裏に深い悲しみを感じました。",shape=box,color=blue];
		3152 -> 3158;
	3153 [label="前回と変わらず、いつものように明るく挨拶してくれました。でも、Otak様は私を「Sœur de Soll - ソルの修道女」と呼んだのです！ ",shape=box,color=blue];
		3153 -> 3159;
	3154 [label="ごめんな。Otakって時々うざったくなるんだ。彼のせいじゃないけど。",shape=box,color=red];
		3154 -> 3160;
	3155 [label="そんなつもりじゃなかった。ただOtakって人によってはちょっと…　うざったくなるんだ。",shape=box,color=red];
		3155 -> 3160;
	3156 [label="Otakには時々イライラさせるんだ、それだけ。 ",shape=box,color=red];
		3156 -> 3161;
	3157 [label="しかし、そのおかしみの下には、大きな悲しみが隠されているのでしょうね。",shape=box,color=blue];
		3157 -> 3158;
	3158 [label="Otak様の物語を教えていただけますでしょうか。",shape=box,color=blue];
		3158 -> 3162;
	3159 [label="実にOtak様はルミナリーズについてよくご存じでした！　私たちは、彼が言う「オロキン帝国以前」の「古代宗教」について長々と語り合いました。",shape=box,color=blue];
		3159 -> 3163;
	3160 [label="人々がOtak様に優しさと忍耐を示してくれることを祈ります。Mais par la grâce de Sol, go we all. ソルの恵みによって、皆が進みますよう。",shape=box,color=blue];
		3160 -> 3164;
	3161 [label="明らかに病弱な人に対しては、もっと優しく接するべきです。結局のところ、ソルの恵みがなければ、私たちは生きていけないのですから。",shape=box,color=blue];
		3161 -> 3164;
	3162 [label="Otakはかつてアルキメデス、オロキンの科学者、研究家だったんだ。彼に起きたことは、決してハッピーエンドではなかった。",shape=box,color=red];
		3162 -> 3165;
	3163 [label="ですが、その知識の多くは今では失われ、書庫の奥深くへ格納され、厳重に禁じられているそうです。Otak様は私に秘密を守るよう命ぜられました。",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="そのような運命は誰にでも訪れるかもしれません。漂流者様にも。",shape=box,color=blue];
		3164 -> 3167;
		3164 -> 3168;
	3165 [label="誰から見ても彼は天才であり、アルゴンクリスタルの活用方法を考案した張本人だ。",shape=box,color=red];
		3165 -> 3169;
	3166 [label="Otak様はこうも仰りました。執行官Ballasが異端の宗派を発見して信者を処刑するかもしれないことを深く心配されている、と。",shape=box,color=blue];
		3166 -> 3170;
		3166 -> 3171;
	3167 [label="Otakに費やす時間なんてない、ごめん。",shape=box,color=red];
		3167 -> 3172;
	3168 [label="そうだな、ごめん。そういうつもりじゃなかったんだ。",shape=box,color=red];
		3168 -> 3158;
	3169 [label="アルゴンクリスタルはVoidから採取できて…　これがあるからこそ強力なWARFRAMEや武器を作れるんだ。",shape=box,color=red];
		3169 -> 3173;
	3170 [label="そんなこと起こらないよ。続けて。",shape=box,color=red];
		3170 -> 3174;
	3171 [label="Ballasは死んだんだ... 　続けて。",shape=box,color=red];
		3171 -> 3174;
	3172 [label="あら、漂流者様のお時間をさらに無駄にして申し訳ありません。",shape=box,color=blue];
		3172 -> 3175;
	3173 [label="彼は結晶学を専門としていた。そして彼の研究成果はここの研究所に保管されている。",shape=box,color=red];
		3173 -> 3176;
	3174 [label="+5 Chemistry",color=orange];
		3174 -> 3177;
	3175 [label="Update boolean MarieOtakComplete",color=orange];
		3175 -> 3178;
	3176 [label="何らかの理由で、彼はセファロンに変えられ、ネクロロイドの器を与えられた。",shape=box,color=red];
		3176 -> 3179;
	3177 [label="そうかもしれないと思っていました…　Otak様は私がどこから来たのかお訊ねになられ、私が答えると笑って「いや、それは無理！　知ってるはずなんだけど…」と仰りました。",shape=box,color=blue];
		3177 -> 3180;
	3178 [label="Chat ends.",color=orange];
	3179 [label="すべてのセファロンは刑罰でそうさせられた訳ではない。でも、ダイモスの環境下で…　不運にも彼は重症を受けた。",shape=box,color=red];
		3179 -> 3181;
	3180 [label="それから、Otak様は…　また再度自己紹介をされて、鉱物の標本を持って草原から来たのかと尋ねられました…",shape=box,color=blue];
		3180 -> 3182;
