		j946548047 -> j567893767 [label="MarieEntratiNeutral",color=purple];
		j946548047 -> j691060938 [label="false",color=purple];
	j4188043169 [label="そうかもしれませんが、彼の発言には我慢できません。その言葉がどれほど深く私を傷つけたか…　気付いているかどうかは分かりません。",shape=box,color=blue];
		j4188043169 -> j946548047;
	j2706889580 [label="Merci, その言葉がどれほど深く私を傷つけたか…　気付いているかどうかは分かりません。",shape=box,color=blue];
		j2706889580 -> j594480650;
		j2706889580 -> j3936643234;
		j2706889580 -> j1634429559;
	j3091443982 [label="この態度が、カーディナルが帰還したときに期待できる歓迎だとしたら、戻ってこないのも不思議ではありません。",shape=box,color=blue];
		j3091443982 -> j2295807228;
		j3091443982 -> j1547991341;
	j3418485735 [label="そして、あなたはTagfer様の味方をするのですよね、non？　あなたはカーディナルがあの獣と同じように怪物だと思っているのですよね？",shape=box,color=blue];
		j3418485735 -> j2295807228;
		j3418485735 -> j3834156276;
	j2662294864 [label="驚きを隠せません。Je pensais que tu étais de mon côté - 私の味方をしてくれると思っていたのに…　つい先ほどまでカーディナルの大義を擁護していたのではないのですか。",shape=box,color=blue];
		j2662294864 -> j799650946;
	j567893767 [label="前にも言いましましたが、それがどうだというのですか。私たちは彼の行いに従って仕え、後で裁きます。この喧嘩には意味がないのではありませんか、non？",shape=box,color=blue];
		j567893767 -> j1785129668;
		j567893767 -> j3197934837;
	j691060938 [label="カーディナルの手でVoidによって作られたものだと知っています。カーディナルから得た贈り物は、傷付いた心で見れば呪いとなるのでしょう。",shape=box,color=blue];
		j691060938 -> j1330524132;
	j594480650 [label="Marieの言葉がどれだけ彼を動揺させたか知ってる？　Tagferの全容を知ってる？",shape=box,color=red];
		j594480650 -> j691060938;
	j3936643234 [label="Marieの言い分も彼を傷つけたと思う。",shape=box,color=red];
		j3936643234 -> j2157492343;
	j1634429559 [label="自分はMarieの味方だ。でも…　喧嘩は良くない。",shape=box,color=red];
		j1634429559 -> j3924224526;
		j1634429559 -> j4248074481;
	j2295807228 [label="Marie、Marieと喧嘩するつもりはない。Tagferの立場に立って少し考えてみて欲しいだけだ。",shape=box,color=red];
		j2295807228 -> j1533934400;
	j1547991341 [label="もしEntratiが自分の後始末を手伝うためにここへ留まるなら、この世界にもっと多くの友達がいたかもしれない。",shape=box,color=red];
		j1547991341 -> j2241551147;
	j3834156276 [label="そう、自分はTagferの肩を持つ。Marieは理性に耳を傾けていない。「カーディナル」は見た目通りの人物じゃないんだ。",shape=box,color=red];
		j3834156276 -> j1533934400;
	j799650946 [label="大きな嘘だったのですか。私とun jeu - お遊びしていただけなのですか。",shape=box,color=blue];
		j799650946 -> j415881543;
		j799650946 -> j818370831;
	j1785129668 [label="この危機を乗り越えた時に、自分たちの周りに誰も残っていないのは良くない。彼らは多くのことを経験してきたんだ。",shape=box,color=red];
		j1785129668 -> j1533934400;
	j3197934837 [label="恐らくもうすぐ忘れるさ。Marieも。",shape=box,color=red];
		j3197934837 -> j1263422362;
	j1330524132 [label="私たちは全員、彼に見捨てられたのです。教えてください。彼らが置かれた状況がひどいとしましょう。たとえひどい状況でも、彼らの憎しみや怒りの感情に同意する必要があるのでしょうか。",shape=box,color=blue];
		j1330524132 -> j1639327012;
	j2157492343 [label="Oui ?! ではきちんと説明してください。",shape=box,color=blue];
		j2157492343 -> j691060938;
	j3924224526 [label="カビアが経験してきた状況は…　厳しいものだったんだ。",shape=box,color=red];
		j3924224526 -> j691060938;
	j4248074481 [label="彼らは動物だ。どれだけ知性があるとしても、最終的には動物なんだ。理解できる能力には限界がある。",shape=box,color=red];
		j4248074481 -> j1221195220;
	j1533934400 [label="Oui ? それでは La Lumière Sacrée de Sol - ソルの聖なる光を演じて、闇を払いのけてください。愚かなMarieに教えてください。",shape=box,color=blue];
		j1533934400 -> j691060938;
	j2241551147 [label="Oui ! そうかもしれません。ただ…　カーディナルがVoidの神から宇宙を救おうとしているだけでは不十分とおっしゃるのですか、non ?!",shape=box,color=blue];
		j2241551147 -> j67510806;
	j415881543 [label="嘘をついているわけじゃない。Marieの味方だ。でも状況は…　そう容易ではなかったんだ。",shape=box,color=red];
		j415881543 -> j1533934400;
	j818370831 [label="いや、お遊びではない。Entratiは信用できないけど、Marieの味方をしているふりをする以外、Marieを説得する方法が分からないんだ。",shape=box,color=red];
		j818370831 -> j1927119106;
	j1263422362 [label="そんなことありません。あなたがこの会話を始めたのだから、最後まできちんと説明してください。Explique !",shape=box,color=blue];
		j1263422362 -> j691060938;
