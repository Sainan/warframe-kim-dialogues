	"Chat ends." [color=orange];
	j473008750 [label="Oui。しかし、どの話か見当がつきます…　私の行いが悪かったのです。誰からこの話を聞きましたか？",shape=box,color=blue];
		j473008750 -> j3499787307;
		j473008750 -> j2648292573;
		j473008750 -> j115427458;
	j3760783413 [label="Bien sûr, ce salaud de diable ouvre sa bouche et vous raconte tout ! Il ne cherche qu'à m'embarrasser ! [あーあ、あの悪魔が大きな口を開けて余計な話をしたな。私に恥をかかせようとしたんだ]",shape=box,color=blue];
		j3760783413 -> j1315778304;
	j3499787307 [label="誰かは関係ない。",shape=box,color=red];
		j3499787307 -> j3383049545;
	j2648292573 [label="Loid。",shape=box,color=red];
		j2648292573 -> j2436075079;
	j115427458 [label="Roathe。",shape=box,color=red];
		j115427458 -> j3760783413;
	j1315778304 [label="Si je le pouvais, je prendrais ce couteau qu'il aime tant utiliser pour agacer les autres et je le fourrerais là où seule Lua peut le voir ! [私が好きなようにできるなら、彼がちょっかいかけながら振り回しているナイフを手にとって、ルアしか見えない場所に突き刺してやる]",shape=box,color=blue];
		j1315778304 -> j498642394;
	j3383049545 [label="そうかもしれませんが、私の機嫌を損ねたくないからそう言うのではないですか？　でも、これ以上攻めないことにします。",shape=box,color=blue];
		j3383049545 -> j3119813083;
	j2436075079 [label="私の機嫌を損ねたくないからそう言うのではないですか？　でも、これ以上攻めないことにします。",shape=box,color=blue];
		j2436075079 -> j3119813083;
	j498642394 [label="大変失礼いたしました。不適切な態度でしたね。une Sœur de Sol - ソルの修道女はそんな風に怒ったり、口を滑らすべきではありません。",shape=box,color=blue];
		j498642394 -> j3187783962;
	j3119813083 [label="+5 Chemistry",color=orange];
		j3119813083 -> j164349745;
	j3187783962 [label="+5 Chemistry",color=orange];
		j3187783962 -> j32552844;
	j164349745 [label="我慢できる限り、平穏を保ちます。",shape=box,color=blue];
		j164349745 -> j1613647930;
	j32552844 [label="あなたに怒りを感じているのではありません。正直に話してくれてありがとうございます。",shape=box,color=blue];
		j32552844 -> j1394433813;
	j1613647930 [label="Tagfer様との口論についてですが…　口論が起きたことは認めます。",shape=box,color=blue];
		j1613647930 -> j1394433813;
	j1394433813 [label="悪魔はその喧嘩が何に関するものだったか説明しましたか？",shape=box,color=blue];
		j1394433813 -> j370765590;
	j370765590 [label="Evaluate expressions",color=orange];
		j370765590 -> j3457278647 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j2384635425 [label="MarieTagferFight2a",color=purple];
		j370765590 -> j1097546661 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j3457278647 [label="MarieTagferFight2b",color=purple];
		j370765590 -> j3457278647 [label="false",color=purple];
		j370765590 -> j2164020901 [label="false",color=purple];
	j3457278647 [label="何も言わなくても分かった。推測はできる。Entratiだろ？",shape=box,color=red];
		j3457278647 -> j1616052943;
	j2384635425 [label="教えてくれた。でもMarieのことの方が心配そうだった。",shape=box,color=red];
		j2384635425 -> j809054832;
	j1097546661 [label="教えてくれた。カビアのことが気になっているからこそ、その状況を心配しているんだと思う。",shape=box,color=red];
		j1097546661 -> j3600661594;
	j2164020901 [label="いや。本当だ。彼はMarieから事情を聴いてくれと言った。",shape=box,color=red];
		j2164020901 -> j956236671;
	j1616052943 [label="Oui. Tagfer様とはカーディナルの件で議論していました。",shape=box,color=blue];
		j1616052943 -> j2836446594;
		j1616052943 -> j2368492901;
	j809054832 [label="悪魔がなぜそんなことを信じ込ませようとするのか、私には分かりません。悪魔にとって何の役に立つのか。",shape=box,color=blue];
		j809054832 -> j3930384331;
	j3600661594 [label="悪魔は三匹の傷ついた動物を見て、自分のcharisme - カリスマ性を利用して従わせることができると知っているようです。",shape=box,color=blue];
		j3600661594 -> j112239053;
	j956236671 [label="悪魔がなぜあなたにそんなことをさせようとするのか、私には分かりません。悪魔にとってどんなことに役に立つのか。",shape=box,color=blue];
		j956236671 -> j3920120037;
	j2836446594 [label="TagferはEntratiの支持者ではないからな、うん。",shape=box,color=red];
		j2836446594 -> j1532140774;
	j2368492901 [label="さぞかし大きな声で喧嘩したんだろうな。",shape=box,color=red];
		j2368492901 -> j4031343935;
	j3930384331 [label="悪魔が差し伸べる見せかけの親切な行為はすべて、彼の目的…　カーディナルに敵対させることに貢献するのです。すべてお見通しです。",shape=box,color=blue];
		j3930384331 -> j2353375808;
	j112239053 [label="彼は私に逆らうためにこうするのです。カーディナルに反抗する私を堕落させようと。私がカーディナルに背を向けるのを見たいのでしょう。彼の目的は明らかです。",shape=box,color=blue];
		j112239053 -> j2353375808;
	j3920120037 [label="しかし、悪魔のことを議論するために会話しているのではありませんでしたね。あの喧嘩は、カーディナルに関するものでした。",shape=box,color=blue];
		j3920120037 -> j2836446594;
		j3920120037 -> j2368492901;
	j1532140774 [label="私はどうしても理解できないのです。彼らに与えられたすべてを見てください。",shape=box,color=blue];
		j1532140774 -> j3581527733;
		j1532140774 -> j2964092579;
	j4031343935 [label="Oui ! 　彼は私をバカ呼ばわりしました。まだ子供だ、と。",shape=box,color=blue];
		j4031343935 -> j172398739;
		j4031343935 -> j3581527733;
	j2353375808 [label="Tagfer様と私が口論していたのは、カーディナルのことです。",shape=box,color=blue];
		j2353375808 -> j2836446594;
		j2353375808 -> j2368492901;
	j3581527733 [label="初めまでさかのぼって、説明してくれ。どうやって喧嘩が始まったんだ？",shape=box,color=red];
		j3581527733 -> j2962398930;
	j2964092579 [label="どうしてこの喧嘩が起きたのか、分かってきたような気がする。",shape=box,color=red];
		j2964092579 -> j2962398930;
	j172398739 [label="本当にMarieのことをバカとか子供っぽいと言ったの？",shape=box,color=red];
		j172398739 -> j2458867037;
	j2962398930 [label="Oui. カーディナルについて言及したんですが、何のことだったかまでは覚えていません。",shape=box,color=blue];
		j2962398930 -> j4136115538;
	j2458867037 [label="もしかしたら、それより悪いかも。",shape=box,color=blue];
		j2458867037 -> j3247292907;
	j4136115538 [label="その時、Tagfer様は呆れた顔をしたので、どうしてそんな顔をするのと尋ねました。",shape=box,color=blue];
		j4136115538 -> j1664749187;
	j3247292907 [label="「Marieは幼稚だな。世間知らずだ。一生他の人に依存して、盲目的な信仰をしてるだけだろう」と言いました。",shape=box,color=blue];
		j3247292907 -> j2206229279;
	j1664749187 [label="すると彼は「Albrechtは汚い、クサい嘘つきだ」と言いました。",shape=box,color=blue];
		j1664749187 -> j453411686;
	j2206229279 [label="「騙されやすいMarieの耳にささやき、なんでも信じさせる年長者が大事なんだ」。",shape=box,color=blue];
		j2206229279 -> j471012429;
	j453411686 [label="Et j'ai répondu - そう言われた私は「こんなに多くの贈り物をもたらしてくれた方なのに？　思考、言語、そして自分自身という贈り物に目を向けた方が良いのではないですか」と返しました。",shape=box,color=blue];
		j453411686 -> j672386949;
	j471012429 [label="Boolean MarieEntrati3 is now true.",color=orange];
		j471012429 -> j289952165;
		j471012429 -> j1821830265;
		j471012429 -> j3022876892;
	j672386949 [label="「カーディナルがあなたに与えてくれたお恵みを感謝するべきです」と。",shape=box,color=blue];
		j672386949 -> j491908279;
		j672386949 -> j1792529341;
	j289952165 [label="Tagferは自分の言い分しか知らない。Entratiの真の動機や見解は…　きちんと説明されてなかったんだ。",shape=box,color=red];
		j289952165 -> j163963719;
	j1821830265 [label="Marieが他人に「依存する」ことをどれだけ気にしているか知っている。なんと意地悪な発言なんだ。",shape=box,color=red];
		j1821830265 -> j1388652625;
	j3022876892 [label="Tagferがそう感じる理由がある。",shape=box,color=red];
		j3022876892 -> j946548047;
	j491908279 [label="どう反応した？",shape=box,color=red];
		j491908279 -> j3247292907;
	j1792529341 [label="あらら…",shape=box,color=red];
		j1792529341 -> j3247292907;
	j163963719 [label="+5 Chemistry",color=orange];
		j163963719 -> j4188043169;
	j1388652625 [label="+5 Chemistry",color=orange];
		j1388652625 -> j2706889580;
	j946548047 [label="Evaluate expressions",color=orange];
