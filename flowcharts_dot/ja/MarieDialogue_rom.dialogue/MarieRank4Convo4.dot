	j1221195220 [label="私を彼らに同情させ、あなたへ怒りを向けさせようとしているなら、成功するかもしれません。",shape=box,color=blue];
		j1221195220 -> j67510806;
	j67510806 [label="これ以上話がこじれる前に、一時停止した方が良いかと思います。怒りをぶちまけてしまう前に。",shape=box,color=blue];
		j67510806 -> "Chat ends.";
	j1927119106 [label="Oui ? そうですか。残念ながら失敗に終わりそうです。",shape=box,color=blue];
		j1927119106 -> j1509439757;
	j3012179723 [label="カビアは実験によって偶然生み出された。本来存在するはずのない実験動物だったんだ。Voidが知性を与えた…",shape=box,color=red];
		j3012179723 -> j920861358;
	j1740653602 [label="Marieは言っただろ「名前を奪われるなんて、残酷の極みですね...」と。Entratiは彼らに名前すら付けなかったんだ。それほど彼らの価値は評価されていなかった。",shape=box,color=red];
		j1740653602 -> j1891115696;
	j3922554364 [label="Marieが路上で育った話をしたよね。家族に見捨てられたこと…",shape=box,color=red];
		j3922554364 -> j1326381483;
	j129328050 [label="もし、自分の意志に反してPROTOFRAMEに変えられ、その後見捨てられたら、どんな気持ちになったと思う？",shape=box,color=red];
		j129328050 -> j3668738797;
	j3090089754 [label="もしEntratiが突然現れて、LyonをPROTOFRAMEに変えた後、彼を捨てたらMarieはどう感じると思う？",shape=box,color=red];
		j3090089754 -> j2652128412;
	j1509439757 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j1509439757 -> j2631316640;
	j920861358 [label="Entratiは自分が作り上げた実験動物を見たとき…　自分が創造したと気づいたとき…　なんと考えただろう。Voidの言葉を話す、哀れな動物たちを。",shape=box,color=red];
		j920861358 -> j2159083284;
	j1891115696 [label="Entratiにとって彼らはただの「モノ」だった。使い捨ての。「Tagfer」とは「廃棄用タグ」って意味だ。",shape=box,color=red];
		j1891115696 -> j194997411;
	j1326381483 [label="家族がMarieを価値のない人間として扱ったこと…",shape=box,color=red];
		j1326381483 -> j1831933460;
	j3668738797 [label="想像してみて。Marieの身体の中に感染体が入り込み苦しんでるのに、心配してくれる人がいない状況を。",shape=box,color=red];
		j3668738797 -> j2093699732;
	j2652128412 [label="安っぽい科学実験に使ってから見捨てたら。Lyonとは、変わる前の後も、お互いに頼り合ってだろ？　カビアにはその支えがなかったんだ。",shape=box,color=red];
