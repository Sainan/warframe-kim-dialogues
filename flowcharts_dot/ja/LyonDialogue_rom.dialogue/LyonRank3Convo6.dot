	j4196769031 [label="Evaluate expressions",color=orange];
		j4196769031 -> j2358890779 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j2508270017 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j1769875599 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j1942136558 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j2508270017 [label="LyonVisions1",color=purple];
		j4196769031 -> j1769875599 [label="LyonVisions1",color=purple];
		j4196769031 -> j1942136558 [label="LyonVisions1",color=purple];
		j4196769031 -> j2358890779 [label="LyonVisions1",color=purple];
		j4196769031 -> j2508270017 [label="false",color=purple];
		j4196769031 -> j1769875599 [label="false",color=purple];
	j2358890779 [label="Lyonは他とは違うものが見えていると警告された。でもそんなことは気にしていない。Lyonの見解を知りたいんだ。",shape=box,color=red];
		j2358890779 -> j2457600455;
	j2508270017 [label="Marieは「カーディナル」に執着しているようだし、Roatheは明らかに嫌いみたいだ。だから中立な意見を聞きたくて。Lyonがそれに一番近かった。",shape=box,color=red];
		j2508270017 -> j1533826822;
	j1769875599 [label="他に…　聞くことがなかったから？",shape=box,color=red];
		j1769875599 -> j3561221253;
	j1942136558 [label="Lyonは他とは違うものが見えていると警告された。でもそこには何らかの真実があると思って。",shape=box,color=red];
		j1942136558 -> j2245824409;
	j2457600455 [label="ほう。こんな狂人に構って、自身に泥を塗ることを恐れないのですか？　実に興味深い。確かにあなたは言葉を話す動物や…　別時代の人間と話す傾向があるようです。それを考慮すると、あなたにとって私などさぞ珍しい存在ではないのかもしれませんね。",shape=box,color=blue];
		j2457600455 -> j2845885253;
	j1533826822 [label="私のような狂人が「中立」とは、賢明な選択肢が残っていないようにも思える。何故わざわざ私に話しかけるのか、理解に苦しみます。",shape=box,color=blue];
		j1533826822 -> j2845885253;
	j3561221253 [label="そもそも、何故私に話しかけることに固執するのです？　必要ではない行為です。Marieと仲良く、あるいは求愛したいのなら、そうするといい。私は彼女の保護者でも、父親でもない。そしてRoatheとどんな意図があろうと、私が彼に求める答え以外取るに足りません。",shape=box,color=blue];
		j3561221253 -> j2845885253;
	j2245824409 [label="「真実」。最近、それがどれほど滑稽と感じるか。こんな狂人に構って、自身に泥を塗ることを恐れないのですか？　実に興味深い。確かにあなたは言葉を話す動物や…　別時代の人間と話す傾向があるようです。それを考慮すると、あなたにとって私などさぞ珍しい存在ではないのかもしれませんね。",shape=box,color=blue];
		j2245824409 -> j2845885253;
	j2845885253 [label="Evaluate expressions",color=orange];
		j2845885253 -> j322056163 [label="LyonFirstFlirt",color=purple];
		j2845885253 -> j322056163 [label="DrifterLyon",color=purple];
		j2845885253 -> j2483966921 [label="LyonOffer",color=purple];
		j2845885253 -> j357204639 [label="false",color=purple];
	j322056163 [label="それと…　以前のような不愉快な発言は控えてください。あなたが何故私に話しかけるかは承知しました。その行為は嬉しいですが、同時に不誠実で耳障りでもあります。",shape=box,color=blue];
		j322056163 -> j1481239916;
		j322056163 -> j2528203339;
		j322056163 -> j3362530442;
	j2483966921 [label="それと、私を「助けたい」などと媚びる発言は控えてください。親切心で言っているつもりでしょうが、あまりにも不誠実で耳障りです。",shape=box,color=blue];
		j2483966921 -> j1481239916;
		j2483966921 -> j2528203339;
		j2483966921 -> j3362530442;
	j357204639 [label="それと、私を「助けたい」や「友達になりたい」などの長々とした説教は控えてください。親切心で言っているつもりでしょうが、あまりにも不誠実で耳障りです。",shape=box,color=blue];
		j357204639 -> j1481239916;
		j357204639 -> j2528203339;
		j357204639 -> j3362530442;
	j1481239916 [label="自分が本気に聞こえないから不誠実だって？　それともLyonのことを思って言ってないと感じるから？",shape=box,color=red];
		j1481239916 -> j2150830396;
	j2528203339 [label="Lyon、自分はただEntratiがどれくらいカーディナルとして身を潜めていたかを知りたい。それだけだ。",shape=box,color=red];
		j2528203339 -> j1377323438;
	j3362530442 [label="「不誠実」って何さ。自分が嘘つきだって？",shape=box,color=red];
		j3362530442 -> j5625625;
	j2150830396 [label="どちらでもありません。あなたの言葉は慈善行為であり、私はそれを求めていません。",shape=box,color=blue];
		j2150830396 -> j1221105824;
		j2150830396 -> j2476979101;
	j1377323438 [label="そうでしたね。3年、2ヶ月と、11日です。それが彼がカーディナル・ディマンシュとして大聖堂に在籍していた期間です。その間、Marieも私も彼の策略に気付くことなく仕えていました。",shape=box,color=blue];
		j1377323438 -> j2035875107;
	j5625625 [label="Evaluate expressions",color=orange];
		j5625625 -> j3068428829 [label="DrifterLiar",color=purple];
		j5625625 -> j3485004867 [label="LyonSuspicious",color=purple];
		j5625625 -> j1510916928 [label="false",color=purple];
	j1221105824 [label="Marieはこれをどうやって対処しているんだ…？",shape=box,color=red];
		j1221105824 -> j3254338542;
	j2476979101 [label="もしかして、Lyonと交流する人はみんな慈善行為でそうしていると思っている？",shape=box,color=red];
		j2476979101 -> j3388556721;
	j2035875107 [label="尋ねる前に、次の質問は予想できます。彼は何を企んでいたと？　噂に聞くホルバニアのように、街を感染させたのか？　彼の計画は何だったのか？　彼の発見は何だったのか？",shape=box,color=blue];
		j2035875107 -> j735073778;
	j3068428829 [label="何か告白することはありますか、漂流者？　償いをしたいことでも？",shape=box,color=blue];
		j3068428829 -> j2962094797;
	j3485004867 [label="？ふむ。いいえ。少なくても今は。",shape=box,color=blue];
		j3485004867 -> j1510916928;
	j1510916928 [label="虚言からの不誠実ではありません。あなたの言葉は慈善行為であり、私はそれを求めていません。",shape=box,color=blue];
		j1510916928 -> j1221105824;
		j1510916928 -> j2476979101;
	j3254338542 [label="彼女に聞いてください。私にも理解できません。",shape=box,color=blue];
		j3254338542 -> "Chat ends.";
	j3388556721 [label="ええ。はい。",shape=box,color=blue];
		j3388556721 -> j3994772085;
	j735073778 [label="これらの問いに対しての答えは、あなたの期待を裏切るものでしょう。3年、2ヶ月、11日間、彼は説教し、学び、休息し、祈りました。",shape=box,color=blue];
		j735073778 -> j3367780307;
		j735073778 -> j3159735081;
		j735073778 -> j3954690921;
	j2962094797 [label="違います。あなたは許しを乞うためでもなく、これまでの嘘を認めるためにここにいるわけではありません。私の言う不誠実とは別にそれは不浄です。",shape=box,color=blue];
		j2962094797 -> j3385480956;
	j3994772085 [label="Boolean LyonHate1 is now true.",color=orange];
		j3994772085 -> j1599560770;
		j3994772085 -> j2154389601;
		j3994772085 -> j1013035992;
	j3367780307 [label="いつPROTOFRAMEに変えられた？",shape=box,color=red];
		j3367780307 -> j44653208;
	j3159735081 [label="Entratiが祈る姿は想像できない。",shape=box,color=red];
		j3159735081 -> j2027605821;
	j3954690921 [label="じゃあ…　研究休暇ってこと？！",shape=box,color=red];
		j3954690921 -> j3044758822;
	j3385480956 [label="あなたの言葉は慈善行為であり、私はそれを求めていません。",shape=box,color=blue];
		j3385480956 -> j1221105824;
		j3385480956 -> j2476979101;
	j1599560770 [label="別の日に掘り下げるとしよう、多分このままだとよくない方向に行きそうだ。",shape=box,color=red];
		j1599560770 -> j3782570847;
	j2154389601 [label="Marieは…？",shape=box,color=red];
		j2154389601 -> j3389531491;
	j1013035992 [label="自己評価が低いんだね。",shape=box,color=red];
		j1013035992 -> j2075886740;
	j44653208 [label="その3年と数日が経った後、彼は嵐の中に消えて行きました。訪れた最初の日と同じような、雷雨へ。",shape=box,color=blue];
		j44653208 -> j3307858394;
	j2027605821 [label="他人の心の内を知ることは不可能です。彼は祭壇に膝をつき、頭を下げていた。祈っていたのか、それともただ自分の考えに浸っていたのだろうか？　私にはわかりません。",shape=box,color=blue];
		j2027605821 -> j44653208;
	j3044758822 [label="+5 Chemistry",color=orange];
		j3044758822 -> j1482922224;
	j3782570847 [label="+5 Chemistry",color=orange];
		j3782570847 -> j2127782534;
	j3389531491 [label="Marieは、狂暴な熊を膝に抱きかかえ、自分の喉を引き裂かせても構わないと思うような人間です。そうすることで安らぎをもたらすと信じているから。",shape=box,color=blue];
		j3389531491 -> j322221452;
	j2075886740 [label="私はそれを現実主義への揺るぎない献身とみなしますが、どのように定義するかはあなた次第です。",shape=box,color=blue];
		j2075886740 -> j682675404;
	j3307858394 [label="Evaluate expressions",color=orange];
		j3307858394 -> j1290947886 [label="MarieLyonVisions",color=purple];
		j3307858394 -> j1290947886 [label="LyonVisions1",color=purple];
		j3307858394 -> j969713641 [label="false",color=purple];
	j1482922224 [label="ふふ。なるほど、その発想はありませんでしたが、確かに、そうなのかもしれませんね。あなた方からすれば腹立たしいことに違いありません。彼の本心を知ることは不可能なのかもしれません。",shape=box,color=blue];
		j1482922224 -> j44653208;
	j2127782534 [label="それは賢明な判断でしょう。「カーディナル・ディマンシュ」と彼の大聖堂での在任期間についてですね。",shape=box,color=blue];
		j2127782534 -> j746047134;
	j322221452 [label="彼女は比類なく美しい魂の持ち主で、私は人生をかけて彼女を守り続けます。",shape=box,color=blue];
		j322221452 -> j682675404;
	j682675404 [label="+5 Chemistry",color=orange];
		j682675404 -> j3509063462;
	j1290947886 [label="他の人々がそんな嵐は起こらなかったと主張していることは承知していますが、私はそう記憶しています。",shape=box,color=blue];
		j1290947886 -> j969713641;
	j969713641 [label="それからちょうど一年後、彼は最後にもう一度現れました…　Roatheを連れて。今知る姿で、Entratiの足元で意識を失った状態で。",shape=box,color=blue];
		j969713641 -> j741185158;
	j746047134 [label="3年、2ヶ月と、11日です。それが彼がカーディナル・ディマンシュとして大聖堂に在籍していた期間です。その間、Marieも私も彼の策略に気付くことなく仕えていました。",shape=box,color=blue];
		j746047134 -> j2035875107;
	j3509063462 [label="しかし、これは当然のことと言えるでしょう。狂人に単純な質問をするのは、往々にして的外れな道に迷い込むものです。私の話から離れ、元の話題に戻らせていただきます。",shape=box,color=blue];
		j3509063462 -> j746047134;
	j741185158 [label="本物の悪魔、当時はそう思いました。その時、Entratiは彼が何者なのか、何処から来たか、我々への任務を明かしました。",shape=box,color=blue];
		j741185158 -> j3770528951;
	j3770528951 [label="我々は「神聖な使命」のために選ばれたのだと。",shape=box,color=blue];
		j3770528951 -> j643193502;
		j3770528951 -> j206538783;
	j643193502 [label="強調するね？",shape=box,color=red];
		j643193502 -> j3986554290;
	j206538783 [label="彼を信じていないみたいだ。",shape=box,color=red];
		j206538783 -> j3986554290;
	j3986554290 [label="私は、疑念を持つような知識を得ました。Entratiが語る神聖視されているものや、天啓、神々に対して...　もし存在するならの話ですが…",shape=box,color=blue];
		j3986554290 -> j210567542;
		j3986554290 -> j3766441298;
	j210567542 [label="もし存在するなら？　どういうこと、Lyon？",shape=box,color=red];
		j210567542 -> j1155747520;
	j3766441298 [label="続けて。",shape=box,color=red];
		j3766441298 -> j1231037647;
	j1155747520 [label="Boolean LyonFaith2 is now true.",color=orange];
		j1155747520 -> j420651979;
	j1231037647 [label="Marieは血清を喜んで受け入れました。当然。そうしない理由がないから。そして私も、彼女を追わない理由がなかった。何であろうと、真実を追求できるなら？",shape=box,color=blue];
		j1231037647 -> j1813802388;
	j420651979 [label="別の機会でお願いします。",shape=box,color=blue];
		j420651979 -> j1231037647;
	j1813802388 [label="Boolean LyonSerum1 is now true.",color=orange];
		j1813802388 -> j832581674;
		j1813802388 -> j4017078994;
		j1813802388 -> j3625956636;
	j832581674 [label="MarieはEntratiを崇拝しすぎている。",shape=box,color=red];
		j832581674 -> j3744704210;
	j4017078994 [label="それで？",shape=box,color=red];
		j4017078994 -> j2522313217;
	j3625956636 [label="後悔している？",shape=box,color=red];
		j3625956636 -> j1855031459;
	j3744704210 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j3744704210 -> j4039110636;
	j2522313217 [label="Roatheが目覚めました。最初は、名前さえ思い出せない状態でした。Entratiは去り際に、彼に言葉を残しました。「Uriel、Xataの異端者よ、追放の中で答えを導け、オロキンは許されるのか？」と。",shape=box,color=blue];
		j2522313217 -> j438636504;
	j1855031459 [label="全てを後悔しています。もちろんです。しかし、もし同じ状況に陥ったら？　ええ、ためらわず繰り返すでしょう。Marieを一人にさせないためにも。",shape=box,color=blue];
		j1855031459 -> j2557634286;
	j4039110636 [label="同感です。しかし彼女を責めることもできません。辛抱してください。いずれ理解できます。彼女は非常に賢いのです、愚か者ではありません。",shape=box,color=blue];
		j4039110636 -> j2557634286;
	j438636504 [label="そしてEntratiは旅立ちました。Roatheを置いて。変貌したその姿は、まさに悪魔そのものでした。",shape=box,color=blue];
		j438636504 -> j573452011;
	j2557634286 [label="話の結末ですが。血清を受け取ると、Entratiは旅立ちました。Roatheを置いて。変貌した彼の姿は、まさに悪魔そのものでした。",shape=box,color=blue];
		j2557634286 -> j573452011;
	j573452011 [label="話の続きは、日を改める必要があります。Loid殿がPOM-2の使用を要求しており、私も手放したいと思います。納得できる答えを出せたことを願います。",shape=box,color=blue];
		j573452011 -> j1926869758;
		j573452011 -> j3401457069;
	j1926869758 [label="答えより新しい疑問の方が増えた。",shape=box,color=red];
		j1926869758 -> j115810078;
	j3401457069 [label="うん、ありがとう。",shape=box,color=red];
		j3401457069 -> j2757069575;
	j115810078 [label="+15 Chemistry",color=orange];
		j115810078 -> j268330334;
	j2757069575 [label="+10 Chemistry",color=orange];
		j2757069575 -> j2467704102;
	j268330334 [label="では司祭としての務めを果たせました。おやすみなさい。",shape=box,color=blue];
		j268330334 -> j2834389190;
	j2467704102 [label="おやすみなさい。",shape=box,color=blue];
		j2467704102 -> j2834389190;
	j2834389190 [label="-神父 Lyon Allard",shape=box,color=blue];
		j2834389190 -> "Chat ends.";
}