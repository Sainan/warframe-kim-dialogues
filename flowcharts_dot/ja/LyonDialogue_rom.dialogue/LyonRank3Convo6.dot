	"LyonRank3Convo6 begins." [color=orange];
		"LyonRank3Convo6 begins." -> j3112535666;
		"LyonRank3Convo6 begins." -> j738393015;
	j3112535666 [label="EntratiはRoatheが現れるまで、大聖堂でどれだけの時間を過ごしたの？",shape=box,color=red];
		j3112535666 -> j772651308;
	j738393015 [label="[閉じる]",shape=box,color=red];
