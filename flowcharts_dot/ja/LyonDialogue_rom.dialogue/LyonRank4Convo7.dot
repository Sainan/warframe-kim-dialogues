digraph {
	1285 [label="LyonRank4Convo7 begins.",color=orange];
		1285 -> 1286;
	1286 [label="漂流者よ、お詫びしたいことがあります。",shape=box,color=blue];
		1286 -> 1287;
		1286 -> 1288;
		1286 -> 1289;
	1287 [label="いいけど。どうしたの？",shape=box,color=red];
		1287 -> 1290;
	1288 [label="何のお詫び？　謝れられるようなことはないけど。",shape=box,color=red];
		1288 -> 1291;
	1289 [label="[閉じる]",shape=box,color=red];
		1289 -> 1292;
	1290 [label="+5 Chemistry",color=orange];
		1290 -> 1293;
	1291 [label="そう言っていただけて嬉しいのですが…　やはりお詫び申し上げる方が最善かと思います。できるだけ簡潔にまとめ、無駄な知識で負担をかけないよう最善を尽くします。",shape=box,color=blue];
		1291 -> 1294;
	1292 [label="Chat ends.",color=orange];
	1293 [label="ありがとうございます。できるだけ簡潔にまとめ、無駄な知識で負担をかけないよう最善を尽くします。",shape=box,color=blue];
		1293 -> 1294;
	1294 [label="私は会話というものが苦手です。この機器のように非人間的で機械的な会話や、お便りでのやり取りより、一対一で対面しながら会話することを難しく感じます。",shape=box,color=blue];
		1294 -> 1295;
	1295 [label="どう表現したらいいのか分かりませんが…　ただ、何かを掴もうとしているのに、指の間から埃がこぼれ落ちるような感じです。 ",shape=box,color=blue];
		1295 -> 1296;
	1296 [label="まるで何も描かれていない画布の切れ端に、絵の具を塗りつけ、心の中に思い描いた画像の影を無駄に造り出そうとしているとさえ思う時があります。",shape=box,color=blue];
		1296 -> 1297;
	1297 [label="この問題を真摯に解消できるよう努めれば努めるほど、絶望感が増すのです。",shape=box,color=blue];
		1297 -> 1298;
	1298 [label="努力すればするほど、目標が遠ざかっていくような…　そのため、これ以上試みないことを学びました。",shape=box,color=blue];
		1298 -> 1299;
	1299 [label="この理由であなたが現れた時、避けていたんです。今でも孤独の方が心地いい。言葉で表現するのが極端に苦手なのです。",shape=box,color=blue];
		1299 -> 1300;
		1299 -> 1301;
		1299 -> 1302;
	1300 [label="無言でも結構です。一緒に傍にいてくれるのが一番嬉しい。",shape=box,color=red];
		1300 -> 1303;
	1301 [label="自分もそういう時あるよ。気にしないで。",shape=box,color=red];
		1301 -> 1304;
	1302 [label="許してあげる。",shape=box,color=red];
		1302 -> 1305;
	1303 [label="+15 Chemistry",color=orange];
		1303 -> 1306;
	1304 [label="+15 Chemistry",color=orange];
		1304 -> 1307;
	1305 [label="+10 Chemistry",color=orange];
		1305 -> 1308;
	1306 [label="覚えておきます。ありがとうございます。漂流者。",shape=box,color=blue];
		1306 -> 1309;
	1307 [label="あなたもそう感じる時があるのですね。気付きませんでした。このように感じるは私一人ではないと確認できて嬉しいです。",shape=box,color=blue];
		1307 -> 1309;
	1308 [label="よかったです。感謝申し上げます、漂流者。",shape=box,color=blue];
		1308 -> 1309;
	1309 [label="-神父 Lyon Allard",shape=box,color=blue];
