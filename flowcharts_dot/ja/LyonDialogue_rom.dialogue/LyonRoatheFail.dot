digraph {
	2262 [label="LyonRoatheFail begins.",color=orange];
		2262 -> 2264;
		2262 -> 2263;
	2264 [label="Lyon。Roatheのことで手伝ってほしいことがあるんだけど…",shape=box,color=red];
		2264 -> 2266;
	2263 [label="[閉じる]",shape=box,color=red];
		2263 -> 2265;
	2266 [label="Check boolean LyonDating",color=orange];
		2266 -> 2267 [label=true,color=green];
		2266 -> 2268 [label=false,color=brown];
	2265 [label="Chat ends.",color=orange];
	2267 [label="Mon miracle、お力添えできますことは、何なりとお申し付けください。Roatheとあなたの間に何か問題が発生したようですね？",shape=box,color=blue];
		2267 -> 2269;
	2268 [label="友よ、お力添えできますことは、何なりとお申し付けください。Roatheとあなたの間に何か問題が発生したようですね？",shape=box,color=blue];
		2268 -> 2269;
	2269 [label="Evaluate expressions",color=orange];
		2269 -> 2273 [label="RoatheFail",color=purple];
		2269 -> 2273 [label="RoatheFailStall",color=purple];
		2269 -> 2272 [label="RoatheFailUltimate",color=purple];
		2269 -> 2271 [label="RoatheFailNot21",color=purple];
		2269 -> 2270 [label="RoatheFailUnloved",color=purple];
	2273 [label="Roatheは血清を摂取したという…　その…　事実と向き合っている。残念ながら、その過程で十分な気配りができていないかったようだ。",shape=box,color=red];
		2273 -> 2277;
	2272 [label="よく分からない。何か言ってはいけないことを言ってしまったようだ。",shape=box,color=red];
		2272 -> 2276;
	2271 [label="Roatheはこれ以上、彼の記憶を辿らないよう警告してきた。だから一線引いたんだ。でもその結果…　自分たちの関係が行き詰っているみたいだ。",shape=box,color=red];
		2271 -> 2275;
	2270 [label="Roatheとはさっぱりとして、気軽なお付き合いをしたいって伝えたんだ。最初は問題視してないようだったけど、関係が後退してしまったような気がする。",shape=box,color=red];
		2270 -> 2274;
	2277 [label="そうなのですね。過去の行いを新たな焦点を当てながら語り合うと、状況を受け入れざるを得なくなるものです。Entratiが私たちをこの卑劣な状況に追い込んだことを呪います。",shape=box,color=blue];
		2277 -> 2280;
	2276 [label="なるほど。残念ながら、「自業自得」の結果に陥っているあなた方へどのように助言したり、手助けできるのか不明です。",shape=box,color=blue];
		2276 -> 2278;
	2275 [label="なるほど。相手の最善の願いを叶えることと、要望を忠実に守ることは必ずしも同じではないのですね。",shape=box,color=blue];
		2275 -> 2279;
	2274 [label="なるほど。残念ながら、「自業自得」の結果に陥っているあなた方へどのように助言したり、手助けできるのか不明です。",shape=box,color=blue];
		2274 -> 2278;
	2280 [label="あなたの言うことを聞いてもらうよう、説得してみます。しかし、Roatheは自分の行動が臆病者が取る行動だと解釈しています。考えを変えれるきっかけを与える論拠を用意しておくよう、助言いたします。",shape=box,color=blue];
		2280 -> 2282;
	2278 [label="冷酷に無視したり、煩わしい態度を取れば、相手も同じ行動に出ても不思議ではありません。特にRoatheのような人を相手にするなら。",shape=box,color=blue];
		2278 -> 2281;
	2279 [label="誰かの欲望に背くこと…　特にその人の個人的な記憶や考えをかき回すような行為は、どの関係へも悪影響を及ぼすでしょう。",shape=box,color=blue];
		2279 -> 2341;
	2282 [label="なぜなら、Roatheの心の葛藤は、彼を内側から蝕むものであることを知っていますから…",shape=box,color=blue];
		2282 -> 2284;
	2281 [label="事態を正すためにどのような策を講じたらいいのか…　少なくとも、Marieや私にはそのような影響力が備わっていません。どうぞお許しください。",shape=box,color=blue];
		2281 -> 2283;
	2341 [label="Entratiが彼と我々をこのような卑劣な立場に追い込んだことを呪います。",shape=box,color=blue];
		2341 -> 2342;
	2284 [label="また、Marieの協力も不可欠でしょう。しかしご存知の通り、RoatheとMarieの間には信頼心がほとんどありません。Marieを説得するのも難航するでしょう。",shape=box,color=blue];
		2284 -> 2286;
	2283 [label="ここまで事がこじれているのなら、他の選択肢を検討するのが最善でしょう。",shape=box,color=blue];
		2283 -> 2285;
	2342 [label="残念ながら、彼を助ける唯一の方法は、止めてくれと言われていることを実行するのみ…　未発見の記憶がなくなるまで、ディセンディアでの探索を続けることのみなのです。",shape=box,color=blue];
		2342 -> 2343;
	2286 [label="Update boolean LyonRoatheFailFix",color=orange];
		2286 -> 2287;
	2285 [label="Chat ends.",color=orange];
	2343 [label="どんなにあの悪魔が抗議しようとも。",shape=box,color=blue];
		2343 -> 2344;
	2287 [label="ルアよ、導きたまえ…",shape=box,color=blue];
		2287 -> 2288;
	2344 [label="Chat ends.",color=orange];
	2288 [label="Update boolean MarieRoatheFail",color=orange];
		2288 -> 2339;
	2339 [label="Chat ends.",color=orange];
}