digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRoatheFail begins." [color=orange];
		"LyonRoatheFail begins." -> j2354889339;
		"LyonRoatheFail begins." -> j738393015;
	j2354889339 [label="Lyon。Roatheのことで手伝ってほしいことがあるんだけど…",shape=box,color=red];
		j2354889339 -> j421763245;
	j738393015 [label="[閉じる]",shape=box,color=red];
		j738393015 -> "Chat ends.";
	j421763245 [label="Check boolean LyonDating",color=orange];
		j421763245 -> j3438542082 [label=true,color=green];
		j421763245 -> j154434311 [label=false,color=brown];
	"Chat ends." [color=orange];
	j3438542082 [label="Mon miracle、お力添えできますことは、何なりとお申し付けください。Roatheとあなたの間に何か問題が発生したようですね？",shape=box,color=blue];
		j3438542082 -> j477154082;
	j154434311 [label="友よ、お力添えできますことは、何なりとお申し付けください。Roatheとあなたの間に何か問題が発生したようですね？",shape=box,color=blue];
		j154434311 -> j477154082;
	j477154082 [label="Evaluate expressions",color=orange];
		j477154082 -> j4104811627 [label="RoatheFail",color=purple];
		j477154082 -> j4104811627 [label="RoatheFailStall",color=purple];
		j477154082 -> j3552567616 [label="RoatheFailUltimate",color=purple];
		j477154082 -> j3935063165 [label="RoatheFailNot21",color=purple];
		j477154082 -> j1999332439 [label="RoatheFailUnloved",color=purple];
		j477154082 -> j4104811627 [label="RoatheRepair1",color=purple];
		j477154082 -> j4104811627 [label="false",color=purple];
	j4104811627 [label="Roatheは血清を摂取したという…　その…　事実と向き合っている。残念ながら、その過程で十分な気配りができていないかったようだ。",shape=box,color=red];
		j4104811627 -> j4167861627;
	j3552567616 [label="よく分からない。何か言ってはいけないことを言ってしまったようだ。",shape=box,color=red];
		j3552567616 -> j1950193831;
	j3935063165 [label="Roatheはこれ以上、彼の記憶を辿らないよう警告してきた。だから一線引いたんだ。でもその結果…　自分たちの関係が行き詰っているみたいだ。",shape=box,color=red];
		j3935063165 -> j2695243152;
	j1999332439 [label="Roatheとはさっぱりとして、気軽なお付き合いをしたいって伝えたんだ。最初は問題視してないようだったけど、関係が後退してしまったような気がする。",shape=box,color=red];
		j1999332439 -> j1950193831;
	j4167861627 [label="そうなのですね。過去の行いを新たな焦点を当てながら語り合うと、状況を受け入れざるを得なくなるものです。Entratiが私たちをこの卑劣な状況に追い込んだことを呪います。",shape=box,color=blue];
		j4167861627 -> j2571343821;
	j1950193831 [label="なるほど。残念ながら、「自業自得」の結果に陥っているあなた方へどのように助言したり、手助けできるのか不明です。",shape=box,color=blue];
		j1950193831 -> j3592070565;
	j2695243152 [label="なるほど。相手の最善の願いを叶えることと、要望を忠実に守ることは必ずしも同じではないのですね。",shape=box,color=blue];
		j2695243152 -> j251233324;
	j2571343821 [label="あなたの言うことを聞いてもらうよう、説得してみます。しかし、Roatheは自分の行動が臆病者が取る行動だと解釈しています。考えを変えれるきっかけを与える論拠を用意しておくよう、助言いたします。",shape=box,color=blue];
		j2571343821 -> j2351388117;
	j3592070565 [label="冷酷に無視したり、煩わしい態度を取れば、相手も同じ行動に出ても不思議ではありません。特にRoatheのような人を相手にするなら。",shape=box,color=blue];
		j3592070565 -> j640055328;
	j251233324 [label="誰かの欲望に背くこと…　特にその人の個人的な記憶や考えをかき回すような行為は、どの関係へも悪影響を及ぼすでしょう。",shape=box,color=blue];
		j251233324 -> j99400642;
	j2351388117 [label="なぜなら、Roatheの心の葛藤は、彼を内側から蝕むものであることを知っていますから…",shape=box,color=blue];
		j2351388117 -> j558081994;
	j640055328 [label="事態を正すためにどのような策を講じたらいいのか…　少なくとも、Marieや私にはそのような影響力が備わっていません。どうぞお許しください。",shape=box,color=blue];
		j640055328 -> j3419602300;
	j99400642 [label="Entratiが彼と我々をこのような卑劣な立場に追い込んだことを呪います。",shape=box,color=blue];
		j99400642 -> j952491160;
	j558081994 [label="Boolean LyonRoatheFailFix is now true.",color=orange];
		j558081994 -> j618688711;
	j3419602300 [label="ここまで事がこじれているのなら、他の選択肢を検討するのが最善でしょう。",shape=box,color=blue];
		j3419602300 -> "Chat ends.";
	j952491160 [label="残念ながら、彼を助ける唯一の方法は、止めてくれと言われていることを実行するのみ…　未発見の記憶がなくなるまで、ディセンディアでの探索を続けることのみなのです。",shape=box,color=blue];
		j952491160 -> j2343348678;
	j618688711 [label="Check boolean MarieRoatheFailFix",color=orange];
		j618688711 -> j1388044561 [label=true,color=green];
		j618688711 -> j247224379 [label=false,color=brown];
	j2343348678 [label="どんなにあの悪魔が抗議しようとも。",shape=box,color=blue];
		j2343348678 -> "Chat ends.";
	j1388044561 [label="どうやら既にMarieの説得は終えているようですね。正直驚いています。あの二人は水と油のような存在ですから。",shape=box,color=blue];
		j1388044561 -> j1829208953;
	j247224379 [label="また、Marieの協力も不可欠でしょう。しかしご存知の通り、RoatheとMarieの間には信頼心がほとんどありません。Marieを説得するのも難航するでしょう。",shape=box,color=blue];
		j247224379 -> j3411835656;
	j1829208953 [label="では、始めるとしましょう。",shape=box,color=blue];
		j1829208953 -> "Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue";
	j3411835656 [label="ルアよ、導きたまえ…",shape=box,color=blue];
		j3411835656 -> "Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	"Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue" [label="Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue",color=orange];
		"Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue" -> "Chat ends.";
	"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
}