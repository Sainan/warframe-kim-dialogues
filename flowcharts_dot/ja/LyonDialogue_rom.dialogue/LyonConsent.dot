	2215 [label="Chat ends.",color=orange];
	2216 [label="もしよろしければ、私たちの心を落ち着かせるための話をしたいのですが…　Mon miracle。",shape=box,color=blue];
		2216 -> 2217;
		2216 -> 2218;
	2214 [label="Chat ends.",color=orange];
	2217 [label="[閉じる]",shape=box,color=red];
		2217 -> 2219;
	2218 [label="どうかしたの、Lyon？",shape=box,color=red];
		2218 -> 2220;
	2219 [label="Update boolean LyonConsentComplete",color=orange];
		2219 -> 2221;
	2220 [label="いえ、問題ではありません。ただ、あなたが私と一緒にいない時、他の人と…　愛情がこもった時間をお過ごしになっていることを承知しています。",shape=box,color=blue];
		2220 -> 2222;
	2221 [label="Chat ends.",color=orange];
	2222 [label="私は不安になったり、動揺したりしていないことをお伝えしたくて…　あなたの存在は、私の人生に平安と潤いをもたらせてくれました。",shape=box,color=blue];
		2222 -> 2223;
	2223 [label="このような賜物を他の人と分け合わないなんて、どんなに悲しい状況なのでしょう。",shape=box,color=blue];
		2223 -> 2224;
		2223 -> 2225;
	2224 [label="彼らはきっとLyonのことを気にいるよ。",shape=box,color=red];
		2224 -> 2226;
	2225 [label="ありがとう。そう言ってくれると安心する。",shape=box,color=red];
		2225 -> 2227;
	2226 [label="その場面を思い浮かべると、思わず笑顔になります。別の人生で…　また別の時空で会えるのかもしれませんね。",shape=box,color=blue];
		2226 -> 2228;
	2227 [label="あなたが私にもたらしたものすべて…　私たちが象徴するものすべてと共に…　満足しています。私は…　今までになく幸せで幸せで仕方ありません。",shape=box,color=blue];
		2227 -> 2229;
	2228 [label="しかし、今。この時代を一緒に歩めることに…　とても満足しています。私は…　今までになく幸せで幸せで仕方ありません。",shape=box,color=blue];
		2228 -> 2229;
	2229 [label="全部あなたのおかげです。しかし今は、さよならを告げることとします。",shape=box,color=blue];
		2229 -> 2230;
	2230 [label="- Lyon",shape=box,color=blue];
		2230 -> 1193;
	1193 [label="Update boolean LyonConsentComplete",color=orange];
		1193 -> 1187;
	1187 [label="Chat ends.",color=orange];
}