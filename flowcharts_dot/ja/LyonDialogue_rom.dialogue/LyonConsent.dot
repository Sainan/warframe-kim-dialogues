	"Chat ends." [color=orange];
	j1181132753 [label="Check boolean LyonConsentComplete",color=orange];
		j1181132753 -> "Chat ends." [label=true,color=green];
		j1181132753 -> j2037879380 [label=false,color=brown];
	j1316396836 [label="Check boolean LyonPolyamorySuccess",color=orange];
		j1316396836 -> j1181132753 [label=true,color=green];
		j1316396836 -> "Chat ends." [label=false,color=brown];
	j2037879380 [label="もしよろしければ、私たちの心を落ち着かせるための話をしたいのですが…　Mon miracle。",shape=box,color=blue];
		j2037879380 -> j1926539494;
		j2037879380 -> j847320662;
	j1926539494 [label="[閉じる]",shape=box,color=red];
		j1926539494 -> j3944516755;
	j847320662 [label="どうかしたの、Lyon？",shape=box,color=red];
		j847320662 -> j343099906;
	j3944516755 [label="Boolean LyonConsentComplete is now true.",color=orange];
		j3944516755 -> "Chat ends.";
	j343099906 [label="いえ、問題ではありません。ただ、あなたが私と一緒にいない時、他の人と…　愛情がこもった時間をお過ごしになっていることを承知しています。",shape=box,color=blue];
		j343099906 -> j1671697289;
	j1671697289 [label="私は不安になったり、動揺したりしていないことをお伝えしたくて…　あなたの存在は、私の人生に平安と潤いをもたらせてくれました。",shape=box,color=blue];
		j1671697289 -> j763800612;
	j763800612 [label="このような賜物を他の人と分け合わないなんて、どんなに悲しい状況なのでしょう。",shape=box,color=blue];
		j763800612 -> j1143238717;
		j763800612 -> j845327857;
	j1143238717 [label="彼らはきっとLyonのことを気にいるよ。",shape=box,color=red];
		j1143238717 -> j3385148539;
	j845327857 [label="ありがとう。そう言ってくれると安心する。",shape=box,color=red];
		j845327857 -> j1920472609;
	j3385148539 [label="その場面を思い浮かべると、思わず笑顔になります。別の人生で…　また別の時空で会えるのかもしれませんね。",shape=box,color=blue];
		j3385148539 -> j176799015;
	j1920472609 [label="あなたが私にもたらしたものすべて…　私たちが象徴するものすべてと共に…　満足しています。私は…　今までになく幸せで幸せで仕方ありません。",shape=box,color=blue];
		j1920472609 -> j786487762;
	j176799015 [label="しかし、今。この時代を一緒に歩めることに…　とても満足しています。私は…　今までになく幸せで幸せで仕方ありません。",shape=box,color=blue];
		j176799015 -> j786487762;
	j786487762 [label="全部あなたのおかげです。しかし今は、さよならを告げることとします。",shape=box,color=blue];
		j786487762 -> j698039068;
	j698039068 [label="- Lyon",shape=box,color=blue];
		j698039068 -> j3944516755;
}