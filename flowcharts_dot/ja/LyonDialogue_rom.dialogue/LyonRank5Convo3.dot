digraph {
	1556 [label="LyonRank5Convo3 begins.",color=orange];
		1556 -> 1557;
	1557 [label="Evaluate expressions",color=orange];
		1557 -> 1559 [label="LyonDating",color=purple];
		1557 -> 1560 [label="LyonConvession1",color=purple];
		1557 -> 1560 [label="LyonRell2a",color=purple];
		1557 -> 1560 [label="LyonRell2b",color=purple];
		1557 -> 1560 [label="LyonRell1",color=purple];
		1557 -> 1558 [label="false",color=purple];
	1559 [label="自慢じゃないけど、ワインを一本飲み干し、これまで必死に言い逃れてきた残りの話をする準備ができました。Mon miracle - 私の奇跡よ。",shape=box,color=blue];
		1559 -> 1561;
	1560 [label="自慢じゃないけど、ワインを一本飲み干し、これまで必死に言い逃れてきた残りの話をする準備ができました。",shape=box,color=blue];
		1560 -> 1561;
	1558 [label="Chat ends.",color=orange];
	1561 [label="このボトルは本当にワインなら、適切なラベルが張られていなかったようだ。Loid殿は、私たちが飲むワインと彼が「ワイン」と知るものが同じものであるか、定かでないようです。",shape=box,color=blue];
		1561 -> 1562;
	1562 [label="弁解するとなると…　本当はボトル一本飲み干すつもりはなかった。実際にLoid殿がワインと呼ぶものと私たちのワインが同じものであると定義しようとしたんだ。見極めるために味見をし続けていたら、うっかり一本消費してしまったのです。",shape=box,color=blue];
		1562 -> 1563;
		1562 -> 1564;
		1562 -> 1565;
	1563 [label="付き合ってられない。",shape=box,color=red];
		1563 -> 1566;
	1564 [label="同じ味だった？",shape=box,color=red];
		1564 -> 1567;
	1565 [label="酔っぱらってるの？",shape=box,color=red];
		1565 -> 1568;
	1566 [label="私もあなたのように簡単に逃げ道があったらいいのに。逃げられるうちに逃げるが勝ち、です。",shape=box,color=blue];
		1566 -> 1569;
	1567 [label="分からない！　それが一番イライラした部分でした。しかし、それが大事な問題ではありません。言い訳したけど、結局は酔っぱらいたかったのです。目的を果たしたとは言い難いです。シラフではありませんけど…",shape=box,color=blue];
		1567 -> 1570;
	1568 [label="その可能性は十分あります。少なくともシラフとは呼べる状況ではないことは確かでしょう。",shape=box,color=blue];
		1568 -> 1571;
	1569 [label="Update boolean LyonConfessionFail",color=orange];
		1569 -> 1572;
	1570 [label="この程度の酔いで満足するとします。",shape=box,color=blue];
		1570 -> 1573;
		1570 -> 1574;
	1571 [label="ワインを手にしたときから酔う形状になることが目的だったので、この程度で満足するとします。",shape=box,color=blue];
		1571 -> 1573;
		1571 -> 1574;
	1572 [label="Chat ends.",color=orange];
	1573 [label="そこまで酔っぱらわなくてはいけない理由はあるの？",shape=box,color=red];
		1573 -> 1575;
	1574 [label="話をじっくり聴くよ。",shape=box,color=red];
		1574 -> 1575;
	1575 [label="Rap... tap... tap...",shape=box,color=blue];
		1575 -> 1576;
		1575 -> 1577;
	1576 [label="…　そういうこと？！",shape=box,color=red];
		1576 -> 1578;
	1577 [label="ああ、状況が分かってきた。",shape=box,color=red];
		1577 -> 1578;
	1578 [label="彼らの声は、物心つく前から私の心の中に宿っていたわけではありません。Rellと知られるテンノと、彼の守護者Harrow。幼少期の家の壁の中に生涯継続して居たとは考えられないのです。",shape=box,color=blue];
		1578 -> 1579;
	1579 [label="幻覚の中で囁かれる不明瞭な声は、私が生まれたときから宿っているわけありません。しかし、記憶を辿ると、幻覚で姿を現し、声も響いていた。変わらずずっと。",shape=box,color=blue];
		1579 -> 1580;
	1580 [label="Check boolean LyonTime1",color=orange];
		1580 -> 1581 [label=true,color=green];
		1580 -> 1582 [label=false,color=brown];
	1581 [label="Entratiがエネルギーは時空の中で同時に空く数の場所へ存在できるという哲学的な説明は理解できました。しかし、血清を注入するまで確信を持てませんでした。",shape=box,color=blue];
		1581 -> 1583;
	1582 [label="まるで血清を注入した瞬間、すべてが一つに結合されるような気分になりました。Entratiが自らを、そして彼の存在の真実が明らかになった時…",shape=box,color=blue];
		1582 -> 1584;
	1583 [label="時々心の中で、四方八方に広がる大きく浅く静かな湖を思い浮かべます。黒く滑らかで、まるでオニキスの水晶鏡のような湖を。",shape=box,color=blue];
		1583 -> 1585;
	1584 [label="「量子もつれ」「量子力学の重ね合わせ」「永遠主義理論」という概念を説明しだしたのです。",shape=box,color=blue];
		1584 -> 1586;
	1585 [label="無限に流れ出る巨大な黒い湖…　壮大さに圧倒され、気が動転するような湖を…",shape=box,color=blue];
		1585 -> 1587;
	1586 [label="科学的…　というより哲学的な説明は理解したつもりです。しかし、血清を注入するまで、この概念の可能性に確信を持てませんでした。",shape=box,color=blue];
		1586 -> 1583;
	1587 [label="そこで彼らを見つけることになるのでしょう。私たちが出逢う場所。その場で私は「彼ら」の気配を感じるのです。",shape=box,color=blue];
		1587 -> 1588;
	1588 [label="「彼ら」？",shape=box,color=red];
		1588 -> 1589;
	1589 [label="他のHarrow…　抜け殻の像。エコーのエコーのエコー…　永遠に、あらゆる方向に延々と続く…",shape=box,color=blue];
		1589 -> 1590;
	1590 [label="Rellはその像の中に身を置き、自分を見失いました。すべての世界に自分を見失う結果を迎え入れることになったのです。",shape=box,color=blue];
		1590 -> 1591;
	1591 [label="私もです。私を形付けた血清の中に流れるHarrowも。",shape=box,color=blue];
		1591 -> 1592;
		1591 -> 1593;
	1592 [label="ああ、Void。気付かなかったよ…",shape=box,color=red];
		1592 -> 1594;
	1593 [label="えっ。",shape=box,color=red];
		1593 -> 1594;
	1594 [label="Rellと彼のHarrowは、私の心の中に存在していました。私ととてもよく似ているのに、それでも違う…",shape=box,color=blue];
		1594 -> 1595;
	1595 [label="彼は恐れを知らず、確信に満ちていました。私にはそのような力が備わっていません。",shape=box,color=blue];
		1595 -> 1596;
	1596 [label="彼は無関心のモノに断固として抵抗し、それが何であろうか、なかろうか気にしていないようでした。ただ、その時に何をすべきか熟知していたことは確かです。",shape=box,color=blue];
		1596 -> 1597;
	1597 [label="たとえ、どんな残酷な仕打ちを受けたことがあったとしても…　あの永劫の歳月、あの永遠の「今」と「その後」、私が結成を注入した瞬間…　「前」と「後」、彼は常にその場にいたのです。",shape=box,color=blue];
		1597 -> 1598;
	1598 [label="Rellは私の友です。兄弟です。",shape=box,color=blue];
		1598 -> 1599;
	1599 [label="「昔」のこと？　「今」のこと？",shape=box,color=blue];
		1599 -> 1600;
	1600 [label="彼の気配を失ってしまいました。",shape=box,color=blue];
		1600 -> 1601;
		1600 -> 1602;
	1601 [label="彼は今や…　安らかな眠りについている。Lyon…　彼は平静を取り戻したんだ。",shape=box,color=red];
		1601 -> 1603;
	1602 [label="Lyon...",shape=box,color=red];
		1602 -> 1604;
	1603 [label="理解しています。彼が亡くなった時、私も同じ思いで、涙を流しました。彼がいなくなって本当に寂しい。彼の言葉が、今でもどこかで響いているのです。どういうわけか、どういう形でか。その理由は完全に理解しきれません。",shape=box,color=blue];
		1603 -> 1605;
		1603 -> 1606;
	1604 [label="彼がいなくなって本当に寂しい。彼の言葉が、今でもどこかで響いているのです。どういうわけか、どういう形でか。その理由は完全に理解しきれません。",shape=box,color=blue];
		1604 -> 1605;
		1604 -> 1606;
	1605 [label="Rellは自分たちの中で一番強かった。Lyonが彼を知る機会があったと聞いて、嬉しく思う。",shape=box,color=red];
		1605 -> 1607;
	1606 [label="Rellは子供たちの無知さと残酷さのせいで追放されたんだ。起きた事象は彼にとって、悲劇でしかない。",shape=box,color=red];
		1606 -> 1608;
	1607 [label="私もRellと出会えてよかったと思えるようになりました。彼の強さは…　判断しきれるほど分かっていない。結局のところ、彼は何が必要かを把握していて、やり遂げるだけの強さを持っていたのでしょう。",shape=box,color=blue];
		1607 -> 1609;
	1608 [label="そうかもしれません。しかし、彼は最期に、成し遂げるべきことを果たしました。それだけの力が備わっていたのです。",shape=box,color=blue];
		1608 -> 1609;
	1609 [label="このご時世、私たちが祈ることができるのは「十分に強い」ことだけだと思います。",shape=box,color=blue];
		1609 -> 1610;
	1610 [label="残念ながら、このワインについてそう言及できません。非常に酔いやすいワインなのですが、効き目がでるまでに時間がかかるようです。",shape=box,color=blue];
		1610 -> 1611;
	1611 [label="そろそろ締めくくる…",shape=box,color=blue];
		1611 -> 1612;
	1612 [label="時間です。",shape=box,color=blue];
		1612 -> 1613;
	1613 [label="Check boolean LyonDating",color=orange];
		1613 -> 1614 [label=true,color=green];
		1613 -> 1615 [label=false,color=brown];
	1614 [label="+20 Chemistry",color=orange];
		1614 -> 1616;
	1615 [label="+20 Chemistry",color=orange];
		1615 -> 1617;
	1616 [label="ありがとう、愛しい人。",shape=box,color=blue];
		1616 -> 1618;
	1617 [label="ありがとう、友よ。",shape=box,color=blue];
		1617 -> 1618;
	1618 [label="- Lyon",shape=box,color=blue];
		1618 -> 1619;
	1619 [label="Update boolean LyonConfession2",color=orange];
		1619 -> 1620;
	1620 [label="Update boolean LyonWillDate",color=orange];
		1620 -> 1621;
	1621 [label="Chat ends.",color=orange];
}