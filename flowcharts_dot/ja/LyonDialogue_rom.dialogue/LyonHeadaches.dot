		j727756532 -> j1384529684;
	j2322126973 [label="なのであなたのこの…　親睦を深めるための行為が滑稽なほど単純に思えるのです。私はあなたを知らない、そして信頼していない。ただただ他人の意見を鵜呑みにするしかないのです。",shape=box,color=blue];
		j2322126973 -> j2119255825;
