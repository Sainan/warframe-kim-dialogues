	298 [label="Chat ends.",color=orange];
	299 [label="今私は空想的な狂気と、果て無く見える殺戮の世界で、見知らぬ人々や言葉を話す獣たちに囲まれています。",shape=box,color=blue];
		299 -> 300;
	300 [label="私のこれまでの常識が「ヒスイの光」や「オロキン帝国」、「Void」、「ササヤキ」によってかき消されてしまったのです。",shape=box,color=blue];
		300 -> 301;
	301 [label="なのであなたのこの…　お誘いの申し出を滑稽なほど単調に思えるのです。私はあなたを知らない、そして信頼していない。ただただ他人の意見を鵜呑みにするしかないのです。",shape=box,color=blue];
