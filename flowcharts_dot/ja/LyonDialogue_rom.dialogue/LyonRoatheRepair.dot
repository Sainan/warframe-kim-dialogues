	"LyonRoatheRepair begins." [color=orange];
		"LyonRoatheRepair begins." -> j8348369;
	j8348369 [label="Evaluate expressions",color=orange];
		j8348369 -> j4204251714 [label="RoatheLyonDatingDeal, LyonNoDate",color=purple];
		j8348369 -> j862195377 [label="RoatheFamilyDeal, LyonFamilyFail",color=purple];
		j8348369 -> j862195377 [label="LyonFamilyFail",color=purple];
		j8348369 -> j83859304 [label="RoatheLyonConfessionDeal, LyonConfessionFail",color=purple];
		j8348369 -> "Chat ends." [label="false",color=purple];
	j4204251714 [label="あなたには本当に他の選択肢が見えず、困りに困り果てた挙句、謝罪を検討するよう、Roatheに嘆願するしかなかったのですか?",shape=box,color=blue];
		j4204251714 -> j2583465015;
	j862195377 [label="Loid殿を上の階に送り込む方法に選択肢が見えず、困りに困り果てた挙句、Roatheに私を説得するよう嘆願するしかなかったのですか?",shape=box,color=blue];
		j862195377 -> j4056703286;
	j83859304 [label="あなたは本当に選択肢が見えず、困りに困り果てた挙句、Roatheに私を説得するよう嘆願するしかなかったのですか?",shape=box,color=blue];
		j83859304 -> j2712221799;
	"Chat ends." [color=orange];
	j2583465015 [label="いかに滑稽に聞こえるか明らかですよね。",shape=box,color=blue];
		j2583465015 -> j4267558950;
		j2583465015 -> j4113183109;
	j4056703286 [label="彼の議論を聞いたせいで既に失った時間をこれ以上増やしたくありません。「よくやりましたね」とでも言っておきます。",shape=box,color=blue];
		j4056703286 -> j2169173578;
	j2712221799 [label="もし間違っていたら訂正してください。問題は、あなたが私の過去を掘り下げたくないことだったのです。今では考えが変わったようなのですが…",shape=box,color=blue];
		j2712221799 -> j2076263072;
	j4267558950 [label="彼が自分が謝ると言ったとは知らなかった。",shape=box,color=red];
		j4267558950 -> j272243652;
	j4113183109 [label="何をすればいいのか分からなかった。今思えば、馬鹿げたことだということは分かっている。",shape=box,color=red];
		j4113183109 -> j632135555;
	j2169173578 [label="Check boolean MarieFamilyFail",color=orange];
		j2169173578 -> j2794014238 [label=true,color=green];
		j2169173578 -> j2839860073 [label=false,color=brown];
	j2076263072 [label="理解に苦しみます。後戻りはできません。あの海域を再び踏むことはできないからです。",shape=box,color=blue];
		j2076263072 -> j644773199;
		j2076263072 -> j3275804551;
	j272243652 [label="左様ですか。",shape=box,color=blue];
		j272243652 -> "Chat ends.";
	j632135555 [label="正直に言うと、その滑稽さが、調査するきっかけの一つになりました。そんなに取り乱しているのですか。あなたの人生に仲間がいないことが、そんなに辛いことなのですか？",shape=box,color=blue];
		j632135555 -> j3970581874;
	j2794014238 [label="ご要望に応じて、私も協力いたします。あなたの攻撃魔が次にMarieへどの様な作戦を繰り広げるのか…　心配でしょうがありません。",shape=box,color=blue];
		j2794014238 -> j92487004;
	j2839860073 [label="ご要望に応じて、私も協力いたします。しかし、攻撃魔に矛を収めるよう指示してください。",shape=box,color=blue];
		j2839860073 -> j770168571;
	j644773199 [label="ああ。まあ、時間の無駄だったんだな。",shape=box,color=red];
		j644773199 -> "Chat ends.";
	j3275804551 [label="そうだ。じゃあ…　シンプルに謝るよ。聞く耳を持たなかったことを。",shape=box,color=red];
		j3275804551 -> j1625421066;
	j3970581874 [label="辛いよ、Lyon。Lyonのことを心から大切に想っている。真の底から。そして、Lyonとの関係を壊すような、大きな過ちを犯してしまったことも反省している。",shape=box,color=red];
		j3970581874 -> j3461455977;
	j92487004 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j92487004 -> j547953661;
	j770168571 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j770168571 -> j3711686580;
	j1625421066 [label="どうして私の言い分を聞いてくれなかったのですか。会話のテーマを恐れていたからですか。退屈だったのですか。この重い会話に耐えられるほどの強さがあなたには備わっていないとでも思ったのですか。",shape=box,color=blue];
		j1625421066 -> j2831906690;
		j1625421066 -> j1791139724;
		j1625421066 -> j572785755;
	j3461455977 [label="本当に、本当に申し訳ない。",shape=box,color=red];
		j3461455977 -> j2532759430;
	j547953661 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j547953661 -> "Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j3711686580 [label="Boolean LyonFamilyFail is now false.",color=orange];
		j3711686580 -> "Chat ends.";
	j2831906690 [label="話のテーマに恐怖を感じていたから。",shape=box,color=red];
		j2831906690 -> j1789176635;
	j1791139724 [label="自分には引き受けるだけの強さはないと悟ったから。",shape=box,color=red];
		j1791139724 -> j1789176635;
	j572785755 [label="当時は気にしていなかった。でも今は気にしている。",shape=box,color=red];
		j572785755 -> j1088086829;
	j2532759430 [label="Roatheに助けを求める以外、方法が思いつかなかったんだ。",shape=box,color=red];
		j2532759430 -> j167244209;
	"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieLyonRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
	j1789176635 [label="左様ですか。あなたを許す以外選択肢はなさそうです。",shape=box,color=blue];
		j1789176635 -> j106665696;
	j1088086829 [label="以前気にならなかったことが、何故急に気にするようになったのですか。何が変わったのですか？",shape=box,color=blue];
		j1088086829 -> j1251591369;
		j1088086829 -> j386455606;
	j167244209 [label="あなたを許す以外選択肢はありません。私のような壊れたものを大事に思うのか、理解に苦しみます。",shape=box,color=blue];
		j167244209 -> j2275631365;
	j106665696 [label="Boolean LyonConfessionFail is now false.",color=orange];
		j106665696 -> "Chat ends.";
	j1251591369 [label="Lyonに対する考えが変わったから。",shape=box,color=red];
		j1251591369 -> j1789176635;
	j386455606 [label="Lyonの話には、進歩を得る鍵が秘められていると感じたからだ。",shape=box,color=red];
		j386455606 -> j2935788739;
	j2275631365 [label="しかし、あなたが私を傍らに置くため、どんなに異常な努力を費やすのか知ったところで、あなたの行動への苛立ちは薄れてきました。",shape=box,color=blue];
		j2275631365 -> j2398113586;
	j2935788739 [label="目的を達成するための口実なのですね。",shape=box,color=blue];
		j2935788739 -> "Chat ends.";
	j2398113586 [label="Boolean LyonDating is now true.",color=orange];
		j2398113586 -> j3015983147;
	j3015983147 [label="Boolean IsDating is now true.",color=orange];
		j3015983147 -> j1098454340;
	j1098454340 [label="Boolean LyonHasDated is now true.",color=orange];
		j1098454340 -> j2749259789;
	j2749259789 [label="Boolean LyonWillDate is now true.",color=orange];
		j2749259789 -> j1458716842;
	j1458716842 [label="Boolean LyonNoDate is now false.",color=orange];
		j1458716842 -> "Chat ends.";
}