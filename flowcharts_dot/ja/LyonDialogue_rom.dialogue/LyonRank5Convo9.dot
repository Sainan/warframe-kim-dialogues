digraph {
	"LyonRank5Convo9 begins." [color=orange];
		"LyonRank5Convo9 begins." -> j3594191379;
	j3594191379 [label="Evaluate expressions",color=orange];
		j3594191379 -> "Chat ends." [label="LyonDating, LyonDatingConfession",color=purple];
		j3594191379 -> j2651396243 [label="LyonDating",color=purple];
		j3594191379 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j2651396243 [label="Mon miracle…　今から話す逸話の前に、あることを理解していると確認させてください。",shape=box,color=blue];
		j2651396243 -> j3267241731;
	j3267241731 [label="あなたに送る次の言葉に、細心の注意を払ってください。よく聞いてください。私にとって最大限に重要です。ご理解いただけましたか？",shape=box,color=blue];
		j3267241731 -> j29536174;
		j3267241731 -> j1755745155;
	j29536174 [label="不安になるんだけど。どうかした？",shape=box,color=red];
		j29536174 -> j3681039231;
	j1755745155 [label="わかった。書いてみて。",shape=box,color=red];
		j1755745155 -> j3683791745;
	j3681039231 [label="問題は生じていません。むしろ、その正反対です。あなたに理解していただきたいのは…　もしあなたが、耐えられない問題に遭遇するかもしれないと想定するなら、悲惨な結末が待ち受けているかもしれません。その状況に陥ったら、ぜひあなたをそこから救いたいと願っています。",shape=box,color=blue];
		j3681039231 -> j1962403849;
		j3681039231 -> j3918717145;
		j3681039231 -> j1489906946;
	j3683791745 [label="+5 Chemistry",color=orange];
		j3683791745 -> j1399774057;
	j1962403849 [label="続けて。",shape=box,color=red];
		j1962403849 -> j1966810846;
	j3918717145 [label="意味が分からないな…",shape=box,color=red];
		j3918717145 -> j165954048;
	j1489906946 [label="悲惨な結果とは？",shape=box,color=red];
		j1489906946 -> j673731262;
	j1399774057 [label="感謝を述べます。書き込む前に、何も問題が生じていないことを断言します。しかし、もしあなたが、耐えられない問題に遭遇するかもしれないと想像するなら、悲惨な結末が待ち受けているかもしれません。その状況に陥ったら、ぜひあなたをそこから救いたいと願っています。",shape=box,color=blue];
		j1399774057 -> j1962403849;
		j1399774057 -> j3918717145;
		j1399774057 -> j1489906946;
	j1966810846 [label="+5 Chemistry",color=orange];
		j1966810846 -> j2523503003;
	j165954048 [label="はい。よく理解しているつもりです。",shape=box,color=blue];
		j165954048 -> j673731262;
	j673731262 [label="もう一度始めますね。",shape=box,color=blue];
		j673731262 -> j2523503003;
	j2523503003 [label="私は、多くの方から、「具合が良くない」と解釈される可能性があることを承知しています。また、おそらく実際に具合が良くないのかもしれません。少なくとも、完全に正気ではない。",shape=box,color=blue];
		j2523503003 -> j1868685496;
	j1868685496 [label="私はずいぶん昔から、この事実を自分自身の心の中で認めてきました。もう、このことで悩むことはありません。私を悩ませる幻視、幻聴…　幻覚を恐れたり、憎しみを感じることなく、共に生きる方法を生み出したのです。",shape=box,color=blue];
		j1868685496 -> j20322415;
	j20322415 [label="（しかし最近は、正直に言えば、少し意地悪な気もするのですが、そのことはこの話と関係ありません）",shape=box,color=blue];
		j20322415 -> j2682734836;
	j2682734836 [label="もししかし、万が一ですが…　もしあなたと私との関係が終わることとなれば…　これまで他の人と結べなかった絆が解きほぐされることになれば…",shape=box,color=blue];
		j2682734836 -> j1215360377;
	j1215360377 [label="あなたの心が迷子になってしまったとしても…",shape=box,color=blue];
		j1215360377 -> j1532235297;
	j1532235297 [label="私は耐え続けます、mon miracle。",shape=box,color=blue];
		j1532235297 -> j1322396750;
	j1322396750 [label="病んだ私を悩ませてきたものに溺れることはありません。",shape=box,color=blue];
		j1322396750 -> j2851720794;
	j2851720794 [label="Check boolean LyonAllRight",color=orange];
		j2851720794 -> j1591556450 [label=true,color=green];
		j2851720794 -> j3995135551 [label=false,color=brown];
	j1591556450 [label="あなたの口語表現を借りれば、「大丈夫」になります。もう一度、笑顔や笑いを見つけ出します。",shape=box,color=blue];
		j1591556450 -> j1503417607;
		j1591556450 -> j3807383979;
	j3995135551 [label="私は生き残ります。大丈夫になります。もう一度、笑顔や笑いを見つけ出します。",shape=box,color=blue];
		j3995135551 -> j1503417607;
		j3995135551 -> j3807383979;
	j1503417607 [label="ああ、Lyon…　Lyonは自分の重荷ではない。",shape=box,color=red];
		j1503417607 -> j3290758154;
	j3807383979 [label="もしかして…　別れを切り出されているの？",shape=box,color=red];
		j3807383979 -> j4086819771;
	j3290758154 [label="私はただ、私の存在によってあなたに困難が降りかかる前にあなたを解放しようとしているだけです…",shape=box,color=blue];
		j3290758154 -> j3154246409;
		j3290758154 -> j2117953623;
		j3290758154 -> j2776624646;
	j4086819771 [label="そんなことはありません。絶対。私はただ、私の存在によってあなたに困難が降りかかる前にあなたを解放しようとしているだけです…",shape=box,color=blue];
		j4086819771 -> j3154246409;
		j4086819771 -> j2117953623;
		j4086819771 -> j2776624646;
	j3154246409 [label="Lyonの痛みはある意味…　自分自身の痛みと重なる。Lyonが傷を乗り越えられるよう手伝うのは、決して苦ではない。",shape=box,color=red];
		j3154246409 -> j2369090913;
	j2117953623 [label="何でLyonに惹かれるのか、言葉で言い表せない。でもLyonは決して自分の義務でも負担でもない。",shape=box,color=red];
		j2117953623 -> j1880392842;
	j2776624646 [label="[別れる]もう、もう限界だ。ごめん。Lyonとは別れた方が良いと思う。",shape=box,color=red];
		j2776624646 -> j577134176;
	j2369090913 [label="私も…　あなたの痛みを考えると、自分自身の心が痛みます。しかし、私たち両方の孤独な苦しみの亡霊に再び出逢えたことに、永遠に感謝します。",shape=box,color=blue];
		j2369090913 -> j3133402151;
	j1880392842 [label="そう思っていただけることに対する感謝の気持ちを表しきれません。きっとどんな言葉を発しても、感謝を伝えきれないでしょう。",shape=box,color=blue];
		j1880392842 -> j3133402151;
	j577134176 [label="ええ。そうですよね。この話を自分で切り出した限り、他の答えを受け入れるのは、偽善でしかないでしょう。",shape=box,color=blue];
		j577134176 -> j1258474860;
	j3133402151 [label="私はこれまで、非常に自己満足的な苦労をして自分の人生を歩んできました。",shape=box,color=blue];
		j3133402151 -> j3413466998;
		j3133402151 -> j3382816392;
		j3133402151 -> j2262646863;
	j1258474860 [label="お気持ち察します。あなたに幸運が訪れることを心から願います。一緒に過ごした時間、瞬間を大事な思い出として残しておきます。",shape=box,color=blue];
		j1258474860 -> j3094636858;
	j3413466998 [label="「愛想が良くない」で知られているLyonは、結構お喋りなんだね。",shape=box,color=red];
		j3413466998 -> j2556630477;
	j3382816392 [label="いろいろ話してくれるのは、シンプルに嬉しい。",shape=box,color=red];
		j3382816392 -> j935907361;
	j2262646863 [label="そんな長々と言葉を綴らなくても、「別々の道に歩むことになったとしても、自分は大丈夫」と単刀直入に言えばいいのに。",shape=box,color=red];
		j2262646863 -> j4206419896;
	j3094636858 [label="たとえ記憶から消え去る日が来るとしても、素敵な思い出を魂に刻み込みます。さようなら。",shape=box,color=blue];
		j3094636858 -> j3994460333;
	j2556630477 [label="+5 Chemistry",color=orange];
		j2556630477 -> j1799507466;
	j935907361 [label="+5 Chemistry",color=orange];
		j935907361 -> j2295002019;
	j4206419896 [label="+5 Chemistry",color=orange];
		j4206419896 -> j2583488294;
	j3994460333 [label="Boolean LyonDating is now false.",color=orange];
		j3994460333 -> j4254443866;
	j1799507466 [label="Bah！　私の心境を知りたくないのなら、詮索しないでいただきたい。いろいろ聞いてきたあなたに責任があるのですよ。",shape=box,color=blue];
		j1799507466 -> j2090290626;
	j2295002019 [label="ふらふら言葉の散歩をする私を受け止めてくれて、幸福感に満たされます。だからこそ、日常ではあまり口を開かないように努めているのです。直接会って面と向き合いながら回りくどく話されるとどうなると思いますか？　Marieなら、何年も前に狂犬のごとく殺人を犯していたでしょう。",shape=box,color=blue];
		j2295002019 -> j2090290626;
	j2583488294 [label="あなたには、ある程度の不敬と皮肉さが自然に備わっているようです。私には到底及びません。この分野はあなたにお任せします。",shape=box,color=blue];
		j2583488294 -> j2090290626;
	j4254443866 [label="Boolean IsDating is now false.",color=orange];
		j4254443866 -> j3311435967;
	j2090290626 [label="しかしながら、とっても短い物語を話し始める前置きに過ぎません。本題に入ろうと思います。",shape=box,color=blue];
		j2090290626 -> j20714970;
	j3311435967 [label="- Lyon",shape=box,color=blue];
		j3311435967 -> "Chat ends.";
	j20714970 [label="昨夜、悪夢から目覚めました。目が覚めた私の周りに影が取り囲んでいたのです。私の精神状態を考えると、珍しいことではありません。影はベッドの上まで迫り寄り、なかなか消えてくれませんでした。",shape=box,color=blue];
		j20714970 -> j32812234;
	j32812234 [label="彼らを恐れることはありませんでした。私を傷つけられないことを承知していたから。しかし、その影は心から消えることはありませんでした。追い払う方法はただ一つ。私が知っている方法だけです。",shape=box,color=blue];
		j32812234 -> j456565437;
	j456565437 [label="ベッドから起き上がり、できるだけ多くの服を厚着した。続く悪夢のぼんやりとした視界の中をよろめきながら進みました。香炉を掴み、床の真ん中に膝をつき、そして…　そうです。準備をしたのです。",shape=box,color=blue];
		j456565437 -> j629116951;
	j629116951 [label="「心を清める」準備をしたのです。これ以上説明しません。",shape=box,color=blue];
		j629116951 -> j524416525;
	j524416525 [label="精神を整えるために目を閉じると、心はさまよい出ました。思考はあなた…　mon miracleへと流れだしたのです。",shape=box,color=blue];
		j524416525 -> j3419220291;
	j3419220291 [label="あなたの声。肩に触れる手の感触…",shape=box,color=blue];
		j3419220291 -> j4245129268;
	j4245129268 [label="その瞬間、幻視は…　逃げ去りました。持ち場を放棄し、より強い幽霊…　あなたへと追い払われた…",shape=box,color=blue];
		j4245129268 -> j3311442762;
	j3311442762 [label="立ち上がった私は、香炉をベッドの横のテーブルに置き、聖域の砂の上を歩くことを選択しました。",shape=box,color=blue];
		j3311442762 -> j804140626;
		j3311442762 -> j489102991;
	j804140626 [label="長い前置きの理由が分ったような気がする。",shape=box,color=red];
		j804140626 -> j2141140311;
	j489102991 [label="どうコメントすればいいかわからない。",shape=box,color=red];
		j489102991 -> j3546514164;
	j2141140311 [label="ええ。砂の上を散歩中…　この「暗闇」の危険さを悟りました。もしかしたら…　あなたが責任を重く感じるかもしれない。私の存在は、あなたを縛り付ける鎖のように機能するのかもと…",shape=box,color=blue];
		j2141140311 -> j1696841756;
	j3546514164 [label="+5 Chemistry",color=orange];
		j3546514164 -> j2660171298;
	j1696841756 [label="どうか、決してそう考え始めなさらぬよう、天上界の神々に、あるいは下界の神々に、心からお祈りいたします。あなたがくださった贈り物です。その真新しい時を、私は愛情を注ぎながら守ります。",shape=box,color=blue];
		j1696841756 -> j2212097623;
	j2660171298 [label="何も言わなくても結構です、mon miracle... ",shape=box,color=blue];
		j2660171298 -> j1217439251;
	j2212097623 [label="誓ってください、mon miracle。私があなたにとって空の檻になる時が到来したら…　私から自由な身を得ることを…",shape=box,color=blue];
		j2212097623 -> j3570466209;
	j1217439251 [label="砂の上を散歩中…　この「暗闇」の危険さを悟りました。もしかしたら…　あなたが責任を重く感じるかもしれない。私の存在は、あなたを縛り付ける鎖のように機能するのかもと…",shape=box,color=blue];
		j1217439251 -> j1696841756;
	j3570466209 [label="愛する人々の、虚しい牢獄になりたくありません。あなたにとっても、Marieにとっても。",shape=box,color=blue];
		j3570466209 -> j786481159;
		j3570466209 -> j1641910878;
	j786481159 [label="[別れる] えっ…　そんなこと無理だ。約束できない、ごめん。",shape=box,color=red];
		j786481159 -> j191285511;
	j1641910878 [label="そう誓うよ。",shape=box,color=red];
		j1641910878 -> j2953375660;
	j191285511 [label="+10 Chemistry",color=orange];
		j191285511 -> j1696188133;
	j2953375660 [label="+10 Chemistry",color=orange];
		j2953375660 -> j3703133296;
	j1696188133 [label="ありがとう。正直に向き合ってくれたことを称えます、mon miracle。勇気を振り絞って教えてくれたことを称賛します。",shape=box,color=blue];
		j1696188133 -> j3673176391;
	j3703133296 [label="ありがとう。本当にありがとう、mon miracle…",shape=box,color=blue];
		j3703133296 -> j3312854645;
	j3673176391 [label="一緒に過ごしたすべての瞬間を一生の宝物にします。あなたが想像する以上に大事な思い出を得たので。",shape=box,color=blue];
		j3673176391 -> j3094636858;
	j3312854645 [label="急に疲れに見舞われています。まるで肩の重荷が下りたようです。ベッドで休憩することにします。",shape=box,color=blue];
		j3312854645 -> j21916968;
