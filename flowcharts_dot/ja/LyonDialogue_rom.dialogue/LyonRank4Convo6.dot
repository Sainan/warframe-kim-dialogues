		j897187574 -> j2667589497 [label="DrifterHarmLoss",color=purple];
		j897187574 -> j143569483 [label="false",color=purple];
	j517427652 [label="私たちが座っているこの機械仕掛けは、覆い隠された非人格的な印象を与えます。誰かがそこに入力した言葉を通して私たちにもたらすであろうあらゆる危害から、何らかの形で守られているかのようです。",shape=box,color=blue];
		j517427652 -> j1743838733;
	j233252638 [label="+5 Chemistry",color=orange];
		j233252638 -> j2854842276;
	j143569483 [label="この話題を話すことに耐えられると思ったけど…　やっぱり無理。[閉じる]",shape=box,color=red];
		j143569483 -> j867880352;
	j2667589497 [label="[警告：自ら命を絶つことに関する題材です] 自分はかつて…　この種の「癖」のせいで帰らぬ人になった人を知っている。自分は…",shape=box,color=red];
		j2667589497 -> j946443255;
	j1300509362 [label="Lyonの力になりたいんだ。大丈夫か確認したい。それだけ。",shape=box,color=red];
		j1300509362 -> j4278740242;
	j229819467 [label="健全じゃない。やめるべきだと思っている。",shape=box,color=red];
		j229819467 -> j1636149717;
	j63617295 [label="血清を服用した前は、自分自身を傷つけたと言ってたけど…　その癖が治ったとは思わない。",shape=box,color=red];
		j63617295 -> j3050257674;
	j1743838733 [label="わたしはむしろ、その逆を主張します。より日常的で社会的なやり取りで身を纏う鎖を脱ぐと、自分たちを守ってくれるかもしれないものを剥ぎ取られるのと等しい。",shape=box,color=blue];
		j1743838733 -> j2359025568;
	j2854842276 [label="漂流者よ、この件を繊細に扱っていただけることに…　感謝を述べる。しかし、私はこの話題に慣れています。懸念、嫌悪、または病的な好奇心と言った観点から。あなたの好奇心は懸念から来ることは既に証明されているが…",shape=box,color=blue];
		j2854842276 -> j143569483;
		j2854842276 -> j2667589497;
		j2854842276 -> j1300509362;
		j2854842276 -> j229819467;
	j946443255 [label="Boolean DrifterHarmLoss is now true.",color=orange];
		j946443255 -> j259757172;
	j4278740242 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j4278740242 -> j4131174356;
	j1636149717 [label="Boolean DrifterHarmStop is now true.",color=orange];
		j1636149717 -> j1103909944;
	j3050257674 [label="いや、残念ながらそうではありません。かつて私を悩ませていた幻覚から心を解放するために必要なものだったものが、この血清の「恩恵」を行使するための必要条件へと変わってしまいました。",shape=box,color=blue];
		j3050257674 -> j2313433147;
	j2359025568 [label="したがって、このような状況では... 　私が放った矢は戦闘準備の整った兵士ではなく、森の中の何も知らない鹿の頸動脈に当たる可能性があるということをよく理解しています。",shape=box,color=blue];
		j2359025568 -> j2637942426;
	j259757172 [label="ああ、友よ…　あなたが耐えてきたことに対する同情を十分に表現する言葉がありません。",shape=box,color=blue];
		j259757172 -> j1253527541;
	j4131174356 [label="Check boolean LyonAllRight",color=orange];
		j4131174356 -> j1858189531 [label=true,color=green];
		j4131174356 -> j2561780225 [label=false,color=brown];
	j1103909944 [label="この特別な衝動に終止符を打つには、数年とPROTOFRAME血清だけでは足りません。実際、以前より必要な行動になっているのではないかと懸念しています。そうではありませんか?",shape=box,color=blue];
		j1103909944 -> j223868322;
	j2313433147 [label="+5 Chemistry",color=orange];
		j2313433147 -> j1800747523;
	j2637942426 [label="つきましては、次のことをお伝えします。",shape=box,color=blue];
		j2637942426 -> j3288983250;
	j1253527541 [label="こういう瞬間に言葉は取るに足らないものに思える。必死に言葉を使いこなそうとするが、結局言葉はいつも我々を失望させます。",shape=box,color=blue];
		j1253527541 -> j2968862799;
	j1858189531 [label="私が「大丈夫」という概念に近づくことを、またしても笑わないように努力しようとしています。でも、漂流者よ、あなたのそのお気持ちは有難く頂戴いたします。",shape=box,color=blue];
		j1858189531 -> j833720367;
	j2561780225 [label="私が「大丈夫」という概念に近づくことを、笑わないように努力しようとしています。でも、漂流者よ、あなたのそのお気持ちは有難く頂戴いたします。",shape=box,color=blue];
		j2561780225 -> j833720367;
	j223868322 [label="+5 Chemistry",color=orange];
		j223868322 -> j2772397837;
	j1800747523 [label="血清を注入する前は、自分自身を傷つける衝動を治す能力を握ることが可能だったかもしれません。しかし、「Harrow」WARFRAMEに変身したことで、完全に不可能になったと思います。",shape=box,color=blue];
		j1800747523 -> j365200540;
	j3288983250 [label="立ち上がる意志がないときでも、他の人を立ち上がらせる強さを見つける方法を自分自身に思い出させなければなりません。",shape=box,color=blue];
		j3288983250 -> j2016165084;
	j2968862799 [label="あなたの告白を考慮して、許していただけるのなら、私が遂げようとしていることが三つあります。",shape=box,color=blue];
		j2968862799 -> j501087245;
	j833720367 [label="+5 Chemistry",color=orange];
		j833720367 -> j452780687;
		j833720367 -> j3349837614;
	j2772397837 [label="私の心身の健康を心配してくれているあなたの言葉は、軽々しく発せられたものとは言いません。お許しを。しかし、今となって止めるのは不可能に近いのです。",shape=box,color=blue];
		j2772397837 -> j452780687;
		j2772397837 -> j3349837614;
	j365200540 [label="失礼なことを申し上げると…　漂流者よ。私は今や、この方法で自分自身に永久的な危害を加える力を失ったのだ。",shape=box,color=blue];
		j365200540 -> j3276993853;
	j2016165084 [label="それが物語の真の目的です。",shape=box,color=blue];
		j2016165084 -> j3351162940;
	j501087245 [label="まずはじめに。私は危険にさらされていないことを保証します。もし、自傷行為の誘惑や欲求を駆り立てているのが、深く恐ろしい自己嫌悪だと信じているのなら、その仮説を否定します。",shape=box,color=blue];
		j501087245 -> j2081325430;
	j452780687 [label="どうして自分を痛めつけるの？",shape=box,color=red];
		j452780687 -> j3106172300;
	j3349837614 [label="ただ、行き過ぎてしまうのではないかと心配なんだ。",shape=box,color=red];
		j3349837614 -> j365200540;
	j3276993853 [label="自分が影響を受けないと考えるほどの傲慢さは私にはありません。しかし、その行為は...　そう言うべきか迷うのですが...　計画の一部のようにも考えられます。",shape=box,color=blue];
		j3276993853 -> j4148506203;
	j3351162940 [label="+20 Chemistry",color=orange];
		j3351162940 -> j715745080;
	j2081325430 [label="私は…　その深い憂鬱さを知っているが、それが香炉に火をつける気配はない。（そもそもMarieは絶対に許さないだろう。香炉に近づけさせる前に、彼女は私に香炉を食べさせようとするから）",shape=box,color=blue];
		j2081325430 -> j2055011562;
	j3106172300 [label="Evaluate expressions",color=orange];
		j3106172300 -> j289012772 [label="LyonBackstory3a & LyonLecture2",color=purple];
		j3106172300 -> j289012772 [label="LyonBackstory3b & LyonLecture2",color=purple];
		j3106172300 -> j1713609439 [label="LyonBackstory3a",color=purple];
		j3106172300 -> j1713609439 [label="LyonBackstory3b",color=purple];
		j3106172300 -> j1315152434 [label="false",color=purple];
	j4148506203 [label="+5 Chemistry",color=orange];
		j4148506203 -> j2113696771;
	j715745080 [label="肩を落とさないでください、漂流者。近いうちにまた話しましょう。",shape=box,color=blue];
		j715745080 -> j1411791522;
	j2055011562 [label="だが、友よ、壮大な深い苦しみが囁かれたことは一度もありません。これは誓える。私が大切にしているもの全てにかけて誓います。",shape=box,color=blue];
		j2055011562 -> j1754346977;
	j289012772 [label="私の行動の動機の真実をお話ししましたことを覚えていますか。痛みは、私を苦しめる幻覚から目覚めさせてくれるのです。ルアの神父の間では、あなた方の文化が持つ固定観念ほど恥ずかしい行為と定められていません。大切にしている全てのものに誓います。隠している秘密などない。",shape=box,color=blue];
		j289012772 -> j2610473712;
	j1713609439 [label="とても複雑な話題です。私が自らの肉体を引き裂く理由は一つではありません。私を悩ませる幻覚について、また、その痛みが心を清めることについてお話したことを思い出してください。自傷行為はあなたの時代の皆さんが思うほど禁忌な行動ではありません。",shape=box,color=blue];
		j1713609439 -> j2152402894;
	j1315152434 [label="とても複雑な話題です。私が自らの肉体を引き裂く理由は一つではありません。まず最初に申し上げたいのは、私の自傷行為はあなたの時代の皆さんが思うほど禁忌な行動ではないことです。",shape=box,color=blue];
		j1315152434 -> j2152402894;
	j2113696771 [label="自分の行為が「正しい」とは思いません。他人が真似するべき行為だとも思いません。羨ましく思われることでもないと確信しています。",shape=box,color=blue];
		j2113696771 -> j3090619328;
	j1411791522 [label="-神父 Lyon Allard",shape=box,color=blue];
		j1411791522 -> j3787621160;
	j1754346977 [label="二つ目。この話題を振ってくれたあなたの勇気を称賛します。避けた方が無難な話題。しかし、あなたは見放しませんでした。",shape=box,color=blue];
		j1754346977 -> j2121685300;
	j2610473712 [label="もし、自傷行為の誘惑や欲求を駆り立てているのが、深く恐ろしい自己嫌悪だと信じているのなら、その仮説を否定します。",shape=box,color=blue];
		j2610473712 -> j2219691105;
	j2152402894 [label="ルアの司祭たちの間では、鞭打ちという古代の慣習が残っています。これは私の時代でさえ古風なものとみなされ、「彼女の幻視に祝福された」者たちによって行われていました。",shape=box,color=blue];
		j2152402894 -> j2505370419;
	j3090619328 [label="しかし、この行為は、信じられないほど独特で、文字通りの意味で「超自然的」な状態ではなく、厳密に言えば私にとって危険なわけではありません。",shape=box,color=blue];
		j3090619328 -> j802393445;
	j3787621160 [label="Boolean LyonSpeech is now true.",color=orange];
		j3787621160 -> "Chat ends.";
	j2121685300 [label="三つ目。私はあなたの同伴者がどのような苦しみを経験したのか、その背景を理解できませんし、これからも理解することはありません。ある意味、彼ら自身以外に理解できる人はいませんから。",shape=box,color=blue];
		j2121685300 -> j4097962767;
	j2219691105 [label="私は…　その深い憂鬱さを知っているが、それが香炉に火をつける気配はない。そもそもMarieが絶対に許さないだろう。",shape=box,color=blue];
		j2219691105 -> j1956864042;
	j2505370419 [label="私が大聖堂へ到着して間もないとき…　神父の一人が、私が同じように「祝福」されているのを見て、私の苦難を乗り越える適切な方法として導いてくれたのです。",shape=box,color=blue];
		j2505370419 -> j2632916461;
	j802393445 [label="実際、私は何度も、この苦しみを助けてくれる現代科学の奇跡のようなものが存在しないだろうかと考えてきました。そのような助けを受け入れられる状態であれば、喜んで受け入れます。しかし、今の私の生理的機能では、到底受け入れられるかどうか疑問です。",shape=box,color=blue];
		j802393445 -> j1529471418;
	j4097962767 [label="全てを消耗させるほどの困難は、定義上、孤独なものです。",shape=box,color=blue];
		j4097962767 -> j3931660624;
	j1956864042 [label="Boolean LyonSNo is now true.",color=orange];
		j1956864042 -> j2862098418;
		j1956864042 -> j2963364861;
		j1956864042 -> j3060179201;
	j2632916461 [label="Boolean LyonLecture2 is now true.",color=orange];
		j2632916461 -> j3060179201;
		j2632916461 -> j2963364861;
		j2632916461 -> j2862098418;
	j1529471418 [label="いずれにせよ、私はこの行為によって死ぬことはないと断言します。子供の頃からずっと背負ってきた重荷です。かさぶたを剥がさずに放置すれば、根底にある化膿した傷よりも、この症状の方がましだと私は判断します。",shape=box,color=blue];
		j1529471418 -> j1511931022;
	j3931660624 [label="私はただ、私の神、あなたの神、そして彼らの神に、あなたが罪悪感を抱かないことを祈るのみです。この世で…　その他の世界でも、許されるべきであるのは、同じように苦しみを抱く人を愛しむ優しさです。",shape=box,color=blue];
		j3931660624 -> j3847195347;
	j2862098418 [label="決して行き過ぎてしまわないと…　確信しているの？",shape=box,color=red];
		j2862098418 -> j365200540;
	j2963364861 [label="時々、宗教的慣習がいかに奇妙なものかに驚かされる。",shape=box,color=red];
		j2963364861 -> j3744955324;
	j3060179201 [label="少し安心したよ。",shape=box,color=red];
		j3060179201 -> j365200540;
	j1511931022 [label="Check boolean LyonSNo",color=orange];
		j1511931022 -> j1619037858 [label=true,color=green];
		j1511931022 -> j4080389834 [label=false,color=brown];
	j3847195347 [label="+15 Chemistry",color=orange];
		j3847195347 -> j1423626716;
	j3744955324 [label="その点について、あなたと口論する理由はありません。宗教儀式の違いに魅了されているだけで、あらゆる記録を研究することを楽しんでいる。",shape=box,color=blue];
		j3744955324 -> j3188289488;
	j1619037858 [label="+10 Chemistry",color=orange];
		j1619037858 -> j809621102;
	j4080389834 [label="もし、自傷行為の誘惑や欲求を駆り立てているのが、深く恐ろしい自己嫌悪だと信じているのなら、その仮説を否定します。",shape=box,color=blue];
		j4080389834 -> j1393817855;
	j1423626716 [label="肩を落とさないでください、漂流者。近いうちにまた話しましょう。",shape=box,color=blue];
		j1423626716 -> j2834389190;
	j3188289488 [label="宗教人類学は私にとって、非常に大切な学問です。社会や人々の儀式を研究することで、そ多くのことを学べるからです ",shape=box,color=blue];
		j3188289488 -> j541542431;
	j809621102 [label="私はこう誓います。自分自身を信頼できない瞬間が来たら、その言葉を口にすることを。",shape=box,color=blue];
		j809621102 -> j3204775078;
	j1393817855 [label="私は…　その深い憂鬱さを知っているが、それが香炉に火をつける気配はない。そもそもMarieが絶対に許さないだろう。",shape=box,color=blue];
		j1393817855 -> j1619037858;
	j2834389190 [label="-神父 Lyon Allard",shape=box,color=blue];
		j2834389190 -> "Chat ends.";
	j541542431 [label="極寒の北方に位置するルミナリーズのある宗派は、後退する氷河から発掘した遺体を崇拝している。遺体は完璧な状態で保存されており、その年代は誰にも分からない。しかし、首にかけていた真鍮の円盤には太陽の紋章が刻まれていたのです。",shape=box,color=blue];
		j541542431 -> j2300303855;
	j3204775078 [label="Marieへ。あなたへ。Loid殿へ。Roatheにも。誰にでも。私は固く誓います。",shape=box,color=blue];
		j3204775078 -> j578796218;
		j3204775078 -> j2542154160;
	j2300303855 [label="彼らはミイラ化した遺体がソル本人であると信じている。いつか彼が蘇り、再び立ち上がると信じているのです。彼らは100年ごとに「壮大なイブ」の準備を整え、多くの信者が前夜に毒入りのワインを飲みます。",shape=box,color=blue];
		j2300303855 -> j1540834958;
	j578796218 [label="それ以上望むことはできない。ありがとう、Lyon。",shape=box,color=red];
		j578796218 -> j194671078;
	j2542154160 [label="Lyonを信頼するよ。ただ、一緒に苦難を乗り越えたいんだ。",shape=box,color=red];
		j2542154160 -> j194671078;
	j1540834958 [label="言うまでもなく、翌朝になってもミイラ遺体の本人が帰還しなかったのは、計算が間違っていたと理由づけされ、日付が一世紀ほどずれていたと結論を下します。",shape=box,color=blue];
		j1540834958 -> j379137065;
	j194671078 [label="自分自身を破滅させたいという束縛されない衝動から行動しているのではないということを理解したいというあなたの願いに、心から深く感謝を申し上げます。",shape=box,color=blue];
		j194671078 -> j4013092065;
	j379137065 [label="しかし、本題からかなり逸れてしまいました。",shape=box,color=blue];
		j379137065 -> j4148506203;
	j4013092065 [label="人生において、その様に思ってくれる仲間に恵まれたことが無いのですから。",shape=box,color=blue];
		j4013092065 -> j1423626716;
}