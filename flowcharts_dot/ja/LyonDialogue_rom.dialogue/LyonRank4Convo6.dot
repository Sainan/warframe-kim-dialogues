	j3659605674 [label="Lyon…　Lyonの癖についてMarieと話し合ったんだけど…　そのことを教えてくれないかい？",shape=box,color=red];
		j3659605674 -> j3715475219;
	j2594590237 [label="[自傷行為に関する会話を無効にします。Lyonや他のキャラクターとの好感度うが失われることはありません]",shape=box,color=red];
		j2594590237 -> j495300291;
	j738393015 [label="[閉じる]",shape=box,color=red];
		j738393015 -> "Chat ends.";
	j3978910786 [label="Lyon…　不快にさせなければいいけど、聞きたいことがある。",shape=box,color=red];
		j3978910786 -> j3553636339;
	j1770344328 [label="Lyon、もしよかったら、どうして自分を傷付けるのか教えてくれない？　もしよかったらだけど。",shape=box,color=red];
		j1770344328 -> j4000294739;
	j3490860145 [label="[トリガー警告が事前に設定されているため、会話をスキップしました]",shape=box,color=blue];
		j3490860145 -> "Chat ends.";
	j3715475219 [label="あなたたちがこのことについて議論したと、彼女は教えてくれました。ええ、結構です。この特性について話すのが、どれほど気にならないか、驚くかもしれません。",shape=box,color=blue];
		j3715475219 -> j4019218337;
	j495300291 [label="Boolean LyonPainOff is now true.",color=orange];
		j495300291 -> j867880352;
	"Chat ends." [color=orange];
	j3553636339 [label="聞くことに罪はありません。しかし、もうこれ以上話せない議論の領域に踏み込んだと考えられるとき、会話をそれ以上進めない権利を留保します。",shape=box,color=blue];
		j3553636339 -> j3119328774;
	j4000294739 [label="ふむ。正直言って、この特性についての話題がこれまで上がらなかったことに驚きを隠せません。たいていの場合、この特性は他の方から早い段階で指摘されるものですから。",shape=box,color=blue];
		j4000294739 -> j2271604606;
	j4019218337 [label="多くの人が通常、最も容易に言及する理由となるものです。懸念、嫌悪、または病的な好奇心と言った観点から。",shape=box,color=blue];
		j4019218337 -> j897187574;
	j867880352 [label="この選択が臆病なものだと思っているなら、心配ありません。この問題は…　痛みは、あなたが直面するべき苦しみではありません。私個人の苦しみです。この瞬間を耐えることをあなたに望んいるのではない。",shape=box,color=blue];
		j867880352 -> j517427652;
	j3119328774 [label="時々、Lyonが自分自身を傷つけることについて話したい。その件についてどう切り出すか、慎重に考えたいだけ。",shape=box,color=red];
		j3119328774 -> j233252638;
	j2271604606 [label="懸念、嫌悪、または病的な好奇心と言った観点から、狂人の檻の隙間から覗き込む人は多くいます。あなたの動機はどれが当てはまるのでしょう。",shape=box,color=blue];
		j2271604606 -> j143569483;
		j2271604606 -> j2667589497;
		j2271604606 -> j1300509362;
		j2271604606 -> j229819467;
	j897187574 [label="Evaluate expressions",color=orange];
		j897187574 -> j143569483 [label="LyonBackstory3a",color=purple];
		j897187574 -> j63617295 [label="LyonBackstory3a",color=purple];
		j897187574 -> j143569483 [label="LyonBackstory3b",color=purple];
		j897187574 -> j63617295 [label="LyonBackstory3b",color=purple];
