		j2692809590 -> j1733640318;
	j1561962860 [label="そしてもしあなたが阻止したり、彼女を傷つけるようなことをすれば？",shape=box,color=blue];
		j1561962860 -> j3123153591;
	j947883529 [label="Add 1 to Thermostat counter",color=orange];
		j947883529 -> j1229266438;
	j1795000301 [label="Add -1 to Thermostat counter",color=orange];
		j1795000301 -> j1306294733;
	j2444924329 [label="あの悪魔には何か魅力を感じる。",shape=box,color=red];
		j2444924329 -> j3804436564;
	j1588718014 [label="安心して、彼の魅力に惹かれたりしない。",shape=box,color=red];
		j1588718014 -> j3719138420;
	j1733640318 [label="なので私はそれを、ルアの導きだと信じました。ルミナリーズからこの苦難を背負うため選ばれたのだと。少なくても、当時はそう信じていました。だから私は聖職に就いたのです。",shape=box,color=blue];
		j1733640318 -> j2374471811;
