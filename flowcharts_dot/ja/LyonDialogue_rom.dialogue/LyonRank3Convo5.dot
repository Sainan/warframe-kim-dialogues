	j1221389757 [label="彼が口を開くまでは。",shape=box,color=blue];
		j1221389757 -> j1556687206;
		j1221389757 -> j2005143295;
	"Chat ends." [color=orange];
	j1789556064 [label="物心がついた時から、常人なら施設送りになるような恐ろしい幻覚を見てきました。それによって現実との区別が曖昧になることもあります。",shape=box,color=blue];
		j1789556064 -> j2473117867;
	j1383236691 [label="私が「大丈夫」かと？　率直に言って、どうお答えしていいか分かりません、漂流者。",shape=box,color=blue];
		j1383236691 -> j1789556064;
	j2834389190 [label="-神父 Lyon Allard",shape=box,color=blue];
		j2834389190 -> "Chat ends.";
	j1955943272 [label="彼女の苦しみを私が背負えるなら、魂さえ捧げたって構わない。しかしこれは彼女の、彼女だけが背負う苦難です。",shape=box,color=blue];
		j1955943272 -> j3832556051;
	j1556687206 [label="彼の生い立ちを考慮しないと。彼が生き残った環境を。彼は…　オロキンなんだ。",shape=box,color=red];
		j1556687206 -> j2920713613;
		j1556687206 -> j948785390;
	j2005143295 [label="あまりひどい人じゃないと思うけど。愛着が湧いてきた。",shape=box,color=red];
		j2005143295 -> j2663416385;
	j2473117867 [label="Boolean LyonVisions1 is now true.",color=orange];
		j2473117867 -> j2692809590;
	j3832556051 [label="だから私はこの痛みを防ぐために動いているのです、漂流者。",shape=box,color=blue];
		j3832556051 -> j1561962860;
	j2920713613 [label="だからと言って彼が正しいわけじゃないけど、折り合いをつけるのも大事かも。",shape=box,color=red];
		j2920713613 -> j947883529;
	j948785390 [label="彼は彼なりに最善を尽くしているだけだ。",shape=box,color=red];
		j948785390 -> j1795000301;
	j2663416385 [label="Loid殿から薬を処方してもらうことをお勧めします。",shape=box,color=blue];
