	502 [label="彼がMarieの心に植え付けた腐敗を、私は取り除けませんでした。今はあなたが成功することを祈るばかりです。",shape=box,color=blue];
		502 -> 507;
	497 [label="自らの傑作の破片が、やがて自分に向けられるとは知らずに。避けられない結末から目を背けることを選んだのです。",shape=box,color=blue];
