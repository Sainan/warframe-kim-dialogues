	j716681724 [label="Boolean LyonAllRight is now true.",color=orange];
		j716681724 -> j1383236691;
	j1446356838 [label="彼がMarieの心に植え付けた腐敗を、私は取り除けませんでした。今はあなたが成功することを祈るばかりです。",shape=box,color=blue];
		j1446356838 -> j2834389190;
	j3185610559 [label="自らの傑作の破片が、やがて自分に向けられるとは知らずに。避けられない結末から目を背けることを選んだのです。",shape=box,color=blue];
