	481 [label="信頼とはステンドグラスの窓みたいなものです。その創造は繊細で、その壮麗さは美しい。そして壊れれば悲劇となり、破片は刃を持つ。",shape=box,color=blue];
		481 -> 496;
	482 [label="信頼とはステンドグラスの窓みたいなものです。その創造は繊細で、その壮麗さは美しい。そして壊れれば悲劇となり、破片は刃を持つ。",shape=box,color=blue];
