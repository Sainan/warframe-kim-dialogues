digraph {
	445 [label="LyonRank3Convo5 begins.",color=orange];
		445 -> 446;
	446 [label="「カーディナル・ディマンシュ」が我々を訪れたのは、雷雨が響く夜のことでした。外の暴風に動じず、彼は教会の祭壇に立っていました。",shape=box,color=blue];
		446 -> 447;
	447 [label="まずそこを懸念するべきでした。しかし私は、他の聖母からの使者同様、彼に頭を下げ挨拶しました。",shape=box,color=blue];
		447 -> 448;
	448 [label="事の数ヶ月前に以前のカーディナルが病気で亡くなってしまい、我々は新しいカーディナルを期待していました。",shape=box,color=blue];
		448 -> 449;
	449 [label="カーディナルは温かい笑顔と力強い握手で私に挨拶しました。そして彼に旅は長かったか聞きました。彼の答えは今も忘れません。",shape=box,color=blue];
		449 -> 450;
	450 [label="「困難だった…　しかし長くはなかった。」",shape=box,color=blue];
		450 -> 451;
	451 [label="最初はこの発言の意味を理解できなかった、それに彼のコートがまったく濡れていなかったことも。しかし、私はそれを無視しました。",shape=box,color=blue];
		451 -> 452;
	452 [label="考える間もなく、新しいカーディナルを迎えるため熱心なMarieが現れました。",shape=box,color=blue];
		452 -> 453;
	453 [label="彼は膝をついて、車椅子に座るMarieの高さに合わせ挨拶し、彼女の手を取りました。この時から策略は始まっていたのです。",shape=box,color=blue];
		453 -> 454;
	454 [label="嵐の中現れた悪魔は、一人ではなかったのです。",shape=box,color=blue];
		454 -> 455;
	455 [label="Update boolean LyonEntrati1",color=orange];
