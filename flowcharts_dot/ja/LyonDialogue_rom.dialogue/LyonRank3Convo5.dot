		456 -> 457 [label=true,color=green];
		456 -> 459 [label=true,color=green];
		456 -> 460 [label=true,color=green];
		456 -> 458 [label=false,color=brown];
		456 -> 457 [label=false,color=brown];
	457 [label="一人はRoatheのこと？",shape=box,color=red];
		457 -> 461;
	459 [label="Marieとは少し内容が違うような。",shape=box,color=red];
		459 -> 463;
	460 [label="MarieはEntratiの良心を信じている。Lyonは？",shape=box,color=red];
		460 -> 464;
	458 [label="Entratiがあまり好きじゃないみたいだね？",shape=box,color=red];
		458 -> 462;
	461 [label="ええ。でもそれはまた別の話です。彼の話を始めたら、ただでさえ不機嫌だというのに…",shape=box,color=blue];
		461 -> 465;
	463 [label="ええ。そうでしょうね。",shape=box,color=blue];
		463 -> 467;
		463 -> 468;
	464 [label="+5 Chemistry",color=orange];
		464 -> 469;
	462 [label="彼の虚言や裏切りに耐え、未だに続くMarieへの悪影響を目撃して、あなたは彼に好意を抱けると？　私には不可能です。",shape=box,color=blue];
		462 -> 466;
	465 [label="…これ以上は耐えられない。もしあなたが同意するなら、今はEntratiの悪行について集中したい。",shape=box,color=blue];
		465 -> 470;
	467 [label="Marieは、Lyonは他の人が見えないものがたまに見えると言っていた。",shape=box,color=red];
		467 -> 472;
	468 [label="それで？",shape=box,color=red];
		468 -> 473;
	469 [label="Marieは全ての魂の最善を信じています。それは自身を周囲の世界を身を守る盾として、彼女が磨き上げ、完成させた術です。",shape=box,color=blue];
		469 -> 474;
		469 -> 475;
