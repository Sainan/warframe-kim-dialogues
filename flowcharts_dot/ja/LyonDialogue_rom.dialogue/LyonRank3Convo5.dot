		470 -> 478 [label=false,color=brown];
	472 [label="そしてもしそれが真実だとしたら、あなたはその発言をどう捉えますか、漂流者？",shape=box,color=blue];
		472 -> 480;
	473 [label="「それで」終わりです。私から見た経験を、私が体験した真実を述べたまでです。ただそれだけ。",shape=box,color=blue];
		473 -> 469;
	474 [label="MarieはEntratiの全貌を把握していない。彼がこれまで「進捗」と「贖罪」のためにしてきたことも。",shape=box,color=red];
		474 -> 481;
	475 [label="Marieはもう大人だ。彼女を守りたい気持ちはわかるけど、Marieが誰と、何を信じるかは彼女が決めることだ。",shape=box,color=red];
		475 -> 482;
	471 [label="我々の身体を汚し、我々の未来を破壊し、過去を腐敗させて…　ここまでは、まだ許せます。",shape=box,color=blue];
		471 -> 479;
