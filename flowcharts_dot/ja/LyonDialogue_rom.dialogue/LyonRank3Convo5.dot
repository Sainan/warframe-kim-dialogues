		j1578610626 -> j858008730;
	j2447753031 [label="この悪魔がどの道を歩むか、見届けるしかありません。",shape=box,color=blue];
		j2447753031 -> j1582243248;
	j3796976319 [label="それが心配なのです。他が狂気を吐き散らす中、悪魔は微笑んで理性を語るのです。",shape=box,color=blue];
		j3796976319 -> j2215712318;
	j2945290861 [label="+20 Chemistry",color=orange];
		j2945290861 -> j1863166122;
	j149946039 [label="私が信じるものは最近…　新たな情報の導入によって複雑になりました。",shape=box,color=blue];
		j149946039 -> j858008730;
	j2701534854 [label="我々はまだ語り合いを始めて日が浅いです、漂流者。確かにあなたは宇宙の様々な恐怖を目のあたりにし、体験し、苦しんできたことでしょう。私の説明で怖気づいてしまうとも思いません。",shape=box,color=blue];
		j2701534854 -> j2878589960;
	j858008730 [label="言ってしまえば、正直、何を信じていいかわからないのです、漂流者。",shape=box,color=blue];
		j858008730 -> j4258310074;
	j1582243248 [label="-神父 Lyon Allard",shape=box,color=blue];
		j1582243248 -> j367054140;
	j2215712318 [label="彼は我々が最も油断している時、つまり、傷ついている時、弱っている時、答えを求めている時に我々を掴むのです。",shape=box,color=blue];
		j2215712318 -> j305544006;
		j2215712318 -> j3685769195;
	j1863166122 [label="よろしい。そうならないよう精進してください。あなたに理性を叩き込む行為は避けたい。反撃されかねないので。",shape=box,color=blue];
		j1863166122 -> j3833153990;
	j2878589960 [label="私はただ、会って間もない人にこれを話し、遠ざけてしまうと思うと、心底疲れてしまうのです。特に現状我々は強制的に協力関係にあるわけで、期間も分からない中そのようなことが起きるのは避けたいのです。",shape=box,color=blue];
		j2878589960 -> j4082170266;
