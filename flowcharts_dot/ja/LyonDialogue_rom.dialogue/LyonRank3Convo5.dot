digraph {
	"LyonRank3Convo5 begins." [color=orange];
		"LyonRank3Convo5 begins." -> j1705485810;
	j1705485810 [label="「カーディナル・ディマンシュ」が我々を訪れたのは、雷雨が響く夜のことでした。外の暴風に動じず、彼は教会の祭壇に立っていました。",shape=box,color=blue];
		j1705485810 -> j2547847082;
	j2547847082 [label="まずそこを懸念するべきでした。しかし私は、他の聖母からの使者同様、彼に頭を下げ挨拶しました。",shape=box,color=blue];
		j2547847082 -> j1078846603;
	j1078846603 [label="事の数ヶ月前に以前のカーディナルが病気で亡くなってしまい、我々は新しいカーディナルを期待していました。",shape=box,color=blue];
		j1078846603 -> j1963254385;
	j1963254385 [label="カーディナルは温かい笑顔と力強い握手で私に挨拶しました。そして彼に旅は長かったか聞きました。彼の答えは今も忘れません。",shape=box,color=blue];
		j1963254385 -> j3952580123;
	j3952580123 [label="「困難だった…　しかし長くはなかった。」",shape=box,color=blue];
		j3952580123 -> j2890732380;
	j2890732380 [label="最初はこの発言の意味を理解できなかった、それに彼のコートがまったく濡れていなかったことも。しかし、私はそれを無視しました。",shape=box,color=blue];
		j2890732380 -> j1729216731;
	j1729216731 [label="考える間もなく、新しいカーディナルを迎えるため熱心なMarieが現れました。",shape=box,color=blue];
		j1729216731 -> j1249925728;
	j1249925728 [label="彼は膝をついて、車椅子に座るMarieの高さに合わせ挨拶し、彼女の手を取りました。この時から策略は始まっていたのです。",shape=box,color=blue];
		j1249925728 -> j2037596407;
	j2037596407 [label="嵐の中現れた悪魔は、一人ではなかったのです。",shape=box,color=blue];
		j2037596407 -> j1928339452;
	j1928339452 [label="Boolean LyonEntrati1 is now true.",color=orange];
		j1928339452 -> j2100050873;
	j2100050873 [label="Check boolean MarieEntrati1",color=orange];
		j2100050873 -> j2419759407 [label=true,color=green];
		j2100050873 -> j1294162953 [label=true,color=green];
		j2100050873 -> j1112266268 [label=true,color=green];
		j2100050873 -> j920750425 [label=false,color=brown];
		j2100050873 -> j2419759407 [label=false,color=brown];
	j2419759407 [label="一人はRoatheのこと？",shape=box,color=red];
		j2419759407 -> j2155685082;
	j1294162953 [label="Marieとは少し内容が違うような。",shape=box,color=red];
		j1294162953 -> j3785931039;
	j1112266268 [label="MarieはEntratiの良心を信じている。Lyonは？",shape=box,color=red];
		j1112266268 -> j2007163971;
	j920750425 [label="Entratiがあまり好きじゃないみたいだね？",shape=box,color=red];
		j920750425 -> j3064321051;
	j2155685082 [label="ええ。でもそれはまた別の話です。彼の話を始めたら、ただでさえ不機嫌だというのに…",shape=box,color=blue];
		j2155685082 -> j2271775885;
	j3785931039 [label="ええ。そうでしょうね。",shape=box,color=blue];
		j3785931039 -> j1488851379;
		j3785931039 -> j1942023388;
	j2007163971 [label="+5 Chemistry",color=orange];
		j2007163971 -> j139686815;
	j3064321051 [label="彼の虚言や裏切りに耐え、未だに続くMarieへの悪影響を目撃して、あなたは彼に好意を抱けると？　私には不可能です。",shape=box,color=blue];
		j3064321051 -> j3616409399;
	j2271775885 [label="…これ以上は耐えられない。もしあなたが同意するなら、今はEntratiの悪行について集中したい。",shape=box,color=blue];
		j2271775885 -> j1428371468;
	j1488851379 [label="Marieは、Lyonは他の人が見えないものがたまに見えると言っていた。",shape=box,color=red];
		j1488851379 -> j835698493;
	j1942023388 [label="それで？",shape=box,color=red];
		j1942023388 -> j2400434404;
	j139686815 [label="Marieは全ての魂の最善を信じています。それは自身を周囲の世界を身を守る盾として、彼女が磨き上げ、完成させた術です。",shape=box,color=blue];
		j139686815 -> j1055889911;
		j139686815 -> j1452122284;
	j3616409399 [label="+5 Chemistry",color=orange];
		j3616409399 -> j2465593072;
	j1428371468 [label="Check boolean RoatheSerum1",color=orange];
		j1428371468 -> j3679695386 [label=true,color=green];
		j1428371468 -> j1669346086 [label=true,color=green];
		j1428371468 -> j3679695386 [label=false,color=brown];
		j1428371468 -> j2853084806 [label=false,color=brown];
	j835698493 [label="そしてもしそれが真実だとしたら、あなたはその発言をどう捉えますか、漂流者？",shape=box,color=blue];
		j835698493 -> j2821822155;
	j2400434404 [label="「それで」終わりです。私から見た経験を、私が体験した真実を述べたまでです。ただそれだけ。",shape=box,color=blue];
		j2400434404 -> j139686815;
	j1055889911 [label="MarieはEntratiの全貌を把握していない。彼がこれまで「進捗」と「贖罪」のためにしてきたことも。",shape=box,color=red];
		j1055889911 -> j1639043448;
	j1452122284 [label="Marieはもう大人だ。彼女を守りたい気持ちはわかるけど、Marieが誰と、何を信じるかは彼女が決めることだ。",shape=box,color=red];
		j1452122284 -> j245451391;
	j2465593072 [label="我々の身体を汚し、我々の未来を破壊し、過去を腐敗させて…　ここまでは、まだ許せます。",shape=box,color=blue];
		j2465593072 -> j2270814964;
	j3679695386 [label="Entratiのやり方は正統ではないかもしれないけど、宇宙を救おうと最善を尽くしているんだ。",shape=box,color=red];
		j3679695386 -> j2465593072;
	j1669346086 [label="Roatheみたいに、Lyonも強制的にPROTOFRAMEにされたの？",shape=box,color=red];
		j1669346086 -> j2081702075;
	j2853084806 [label="もちろん。なぜEntratiに怒っているの？",shape=box,color=red];
		j2853084806 -> j3616409399;
	j2821822155 [label="Check boolean LyonVisions1",color=orange];
		j2821822155 -> j2992887792 [label=true,color=green];
		j2821822155 -> j552811899 [label=true,color=green];
		j2821822155 -> j1886222895 [label=true,color=green];
		j2821822155 -> j2992887792 [label=false,color=brown];
		j2821822155 -> j2480581279 [label=false,color=brown];
		j2821822155 -> j552811899 [label=false,color=brown];
	j1639043448 [label="信頼とはステンドグラスの窓みたいなものです。その創造は繊細で、その壮麗さは美しい。そして壊れれば悲劇となり、破片は刃を持つ。",shape=box,color=blue];
		j1639043448 -> j1332997922;
	j245451391 [label="信頼とはステンドグラスの窓みたいなものです。その創造は繊細で、その壮麗さは美しい。そして壊れれば悲劇となり、破片は刃を持つ。",shape=box,color=blue];
		j245451391 -> j1366623119;
	j2270814964 [label="だがMarieをあのように歪め…　彼女の善良さを利用するなど…",shape=box,color=blue];
		j2270814964 -> j786968067;
	j2081702075 [label="いいえ。私には血清を受け取る理由がありました。それの歪んだ効力は熟知していました。Marieも。",shape=box,color=blue];
		j2081702075 -> j2380097794;
	j2992887792 [label="どっちでもいいと思うかな？",shape=box,color=red];
		j2992887792 -> j3296697403;
	j552811899 [label="幻覚が見えるなら、視界に問題があったりするの？",shape=box,color=red];
		j552811899 -> j2922364241;
	j1886222895 [label="この前の話もあったし、大丈夫か心配しただけだ。",shape=box,color=red];
		j1886222895 -> j716681724;
	j2480581279 [label="大丈夫かなって思っただけ。",shape=box,color=red];
		j2480581279 -> j716681724;
	j1332997922 [label="+15 Chemistry",color=orange];
		j1332997922 -> j1446356838;
	j1366623119 [label="ソルの温かい光を浴びながら、彼女は表面に生じる不純を見ることも、深まる亀裂の音を聞くこともできないのです。",shape=box,color=blue];
		j1366623119 -> j3185610559;
	j786968067 [label="これだけは、決して許せません。彼が許しを乞うまで、つり香炉で体罰を与えたいほどに。",shape=box,color=blue];
		j786968067 -> j1055889911;
		j786968067 -> j1452122284;
	j2380097794 [label="我々は…　悪魔のように無理やり壊されたわけではありません。今でもRoatheには少しの同情があります。",shape=box,color=blue];
		j2380097794 -> j1221389757;
	j3296697403 [label="ではこの話は終わりです。",shape=box,color=blue];
		j3296697403 -> "Chat ends.";
	j2922364241 [label="率直に言って、どうお答えしていいか分かりません、漂流者。",shape=box,color=blue];
