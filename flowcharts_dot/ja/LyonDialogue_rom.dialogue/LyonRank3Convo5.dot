		j1733640318 -> j1578610626;
	j3123153591 [label="ルアがあなたの魂に慈悲を施すよう祈ります。",shape=box,color=blue];
		j3123153591 -> j2834389190;
	j1229266438 [label="我々の聖典では、悪魔と交渉はせず、追い払うのです。しかしこのような状況への備えは教えにはありませんでした。",shape=box,color=blue];
		j1229266438 -> j2447753031;
