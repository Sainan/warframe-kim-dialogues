digraph {
	0 [label="LyonRank3Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="どうも、漂流者。",shape=box,color=blue];
		1 -> 2;
	2 [label="あなたが私に話したいと伺いましたが。",shape=box,color=blue];
		2 -> 3;
		2 -> 4;
		2 -> 5;
	3 [label="話せて嬉しいよ、Lyon。ありがとう。",shape=box,color=red];
		3 -> 6;
	4 [label="やっとMarieが説得してくれたの？",shape=box,color=red];
		4 -> 7;
	5 [label="こんにちは、Lyon！　正直話してくれるとは思わなかった。話してくれて嬉しいよ。",shape=box,color=red];
		5 -> 8;
	6 [label="後悔しても知りませんが、いいでしょう。どういたしまして。",shape=box,color=blue];
		6 -> 9;
		6 -> 10;
	7 [label="迅速な方向転換を考慮させる発言は慎みたまえ。",shape=box,color=blue];
		7 -> 11;
	8 [label="ええ、まあ。その期待を裏切るかもしれませんが。",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
	9 [label="他からLyonから相談があると聞いたんだけど。何か手伝えることはある？",shape=box,color=red];
		9 -> 12;
	10 [label="何か問題でも？",shape=box,color=red];
		10 -> 13;
	11 [label="+10 Chemistry",color=orange];
		11 -> 14;
	12 [label="おそらく、いずれは。我々はまだ語り始めたばかりです。私はただ…　あなたは会話において信用できるとMarieに説得されたことを報告しに来ただけです。",shape=box,color=blue];
		12 -> 15;
	13 [label="滑稽なほど、なんて不十分な質問なのでしょう。我々はまだ語り始めたばかりです、それに答えるつもりはありません。私はただ…　あなたは会話において信用できるとMarieに説得されたことを報告しに来ただけです。",shape=box,color=blue];
		13 -> 15;
	14 [label="Chat ends.",color=orange];
	15 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		15 -> 16 [label="x > 0",color=purple];
		15 -> 17 [label="x <= 0",color=purple];
		15 -> 17 [label="false",color=purple];
	16 [label="それに、今後Roatheの「必死」な追求に協力しあう関係がら、誠実に知り合うのが賢明かと。そしてあなたはこの手段を希望している。それで、今こうして参じたのです。",shape=box,color=blue];
		16 -> 18;
		16 -> 19;
	17 [label="それに、今後Roatheの「必死」な追求に協力しあうかもしれない関係がら、誠実に知り合うのが賢明かと。そしてあなたはこの手段を希望している。それで、今こうして参じたのです。",shape=box,color=blue];
		17 -> 18;
		17 -> 19;
	18 [label="なんか、あまりいいスタートを切っていないような気がする。",shape=box,color=red];
		18 -> 20;
	19 [label="えっと…　別の方法がいい？",shape=box,color=red];
		19 -> 21;
	20 [label="お気にせず。私はおそらく、あなたが普段会話を交わすような人間とは異なります。それも考慮し、現時点で問題はありませんが、私のような狂人も滅多にいません。",shape=box,color=blue];
		20 -> 22;
	21 [label="いいえ。この方法で問題ありません。確かに、これなら思考をまとめ文を構造してから発言できます。この機械の魅力も納得できます。",shape=box,color=blue];
		21 -> 23;
	22 [label="とにかく。残念ながら、私はここで「タイピング」に時間を費やすために来たわけではありません。ただ、降伏したことをお知らせしたかっただけです。",shape=box,color=blue];
		22 -> 24;
		22 -> 25;
	23 [label="しかし。残念ながら、私はここで「タイピング」に時間を費やすために来たわけではありません。ただ、降伏したことをお知らせしたかっただけです。",shape=box,color=blue];
		23 -> 25;
		23 -> 24;
	24 [label="Marieって見た目より危険な人だよね？",shape=box,color=red];
		24 -> 26;
	25 [label="じゃあもう一度、話してくれてありがとう。",shape=box,color=red];
		25 -> 27;
	26 [label="+20 Chemistry",color=orange];
		26 -> 28;
	27 [label="+15 Chemistry",color=orange];
		27 -> 29;
	28 [label="氷山の一角を見ただけです。",shape=box,color=blue];
		28 -> 30;
	29 [label="では礼儀にしたがって、どういたしまして。",shape=box,color=blue];
		29 -> 30;
	30 [label="-神父 Lyon Allard",shape=box,color=blue];
		30 -> 31;
	31 [label="Chat ends.",color=orange];
}