digraph {
	"LyonRank3Convo1 begins." [color=orange];
		"LyonRank3Convo1 begins." -> j3279628219;
	j3279628219 [label="どうも、漂流者。",shape=box,color=blue];
		j3279628219 -> j2924806458;
	j2924806458 [label="あなたが私に話したいと伺いましたが。",shape=box,color=blue];
		j2924806458 -> j1027085401;
		j2924806458 -> j3113631971;
		j2924806458 -> j3416431231;
	j1027085401 [label="話せて嬉しいよ、Lyon。ありがとう。",shape=box,color=red];
		j1027085401 -> j1223952249;
	j3113631971 [label="やっとMarieが説得してくれたの？",shape=box,color=red];
		j3113631971 -> j2669230387;
	j3416431231 [label="こんにちは、Lyon！　正直話してくれるとは思わなかった。話してくれて嬉しいよ。",shape=box,color=red];
		j3416431231 -> j436366121;
	j1223952249 [label="後悔しても知りませんが、いいでしょう。どういたしまして。",shape=box,color=blue];
		j1223952249 -> j1140562187;
		j1223952249 -> j1159048481;
	j2669230387 [label="迅速な方向転換を考慮させる発言は慎みたまえ。",shape=box,color=blue];
		j2669230387 -> j1933300832;
	j436366121 [label="ええ、まあ。その期待を裏切るかもしれませんが。",shape=box,color=blue];
		j436366121 -> j1140562187;
		j436366121 -> j1159048481;
	j1140562187 [label="他からLyonから相談があると聞いたんだけど。何か手伝えることはある？",shape=box,color=red];
		j1140562187 -> j1240079322;
	j1159048481 [label="何か問題でも？",shape=box,color=red];
		j1159048481 -> j2760870598;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j1240079322 [label="おそらく、いずれは。我々はまだ語り始めたばかりです。私はただ…　あなたは会話において信用できるとMarieに説得されたことを報告しに来ただけです。",shape=box,color=blue];
		j1240079322 -> j2777944732;
	j2760870598 [label="滑稽なほど、なんて不十分な質問なのでしょう。我々はまだ語り始めたばかりです、それに答えるつもりはありません。私はただ…　あなたは会話において信用できるとMarieに説得されたことを報告しに来ただけです。",shape=box,color=blue];
		j2760870598 -> j2777944732;
	"Chat ends." [color=orange];
	j2777944732 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j2777944732 -> j2696558013 [label="x > 0",color=purple];
		j2777944732 -> j448282659 [label="x <= 0",color=purple];
		j2777944732 -> j448282659 [label="false",color=purple];
	j2696558013 [label="それに、今後Roatheの「必死」な追求に協力しあう関係がら、誠実に知り合うのが賢明かと。そしてあなたはこの手段を希望している。それで、今こうして参じたのです。",shape=box,color=blue];
		j2696558013 -> j821509818;
		j2696558013 -> j3583354178;
	j448282659 [label="それに、今後Roatheの「必死」な追求に協力しあうかもしれない関係がら、誠実に知り合うのが賢明かと。そしてあなたはこの手段を希望している。それで、今こうして参じたのです。",shape=box,color=blue];
		j448282659 -> j821509818;
		j448282659 -> j3583354178;
	j821509818 [label="なんか、あまりいいスタートを切っていないような気がする。",shape=box,color=red];
		j821509818 -> j17912217;
	j3583354178 [label="えっと…　別の方法がいい？",shape=box,color=red];
		j3583354178 -> j368088564;
	j17912217 [label="お気にせず。私はおそらく、あなたが普段会話を交わすような人間とは異なります。それも考慮し、現時点で問題はありませんが、私のような狂人も滅多にいません。",shape=box,color=blue];
		j17912217 -> j210822672;
	j368088564 [label="いいえ。この方法で問題ありません。確かに、これなら思考をまとめ文を構造してから発言できます。この機械の魅力も納得できます。",shape=box,color=blue];
		j368088564 -> j1756884488;
	j210822672 [label="とにかく。残念ながら、私はここで「タイピング」に時間を費やすために来たわけではありません。ただ、降伏したことをお知らせしたかっただけです。",shape=box,color=blue];
		j210822672 -> j1742114732;
		j210822672 -> j2648585403;
	j1756884488 [label="しかし。残念ながら、私はここで「タイピング」に時間を費やすために来たわけではありません。ただ、降伏したことをお知らせしたかっただけです。",shape=box,color=blue];
		j1756884488 -> j2648585403;
		j1756884488 -> j1742114732;
	j1742114732 [label="Marieって見た目より危険な人だよね？",shape=box,color=red];
		j1742114732 -> j3870616222;
	j2648585403 [label="じゃあもう一度、話してくれてありがとう。",shape=box,color=red];
		j2648585403 -> j1732357629;
	j3870616222 [label="+20 Chemistry",color=orange];
		j3870616222 -> j2445166817;
	j1732357629 [label="+15 Chemistry",color=orange];
		j1732357629 -> j726261718;
	j2445166817 [label="氷山の一角を見ただけです。",shape=box,color=blue];
		j2445166817 -> j2834389190;
	j726261718 [label="では礼儀にしたがって、どういたしまして。",shape=box,color=blue];
		j726261718 -> j2834389190;
	j2834389190 [label="-神父 Lyon Allard",shape=box,color=blue];
		j2834389190 -> "Chat ends.";
}