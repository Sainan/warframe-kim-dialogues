	j4231501517 [label="自分は…　RellとHarrowがLyonと一緒にいてくれたことに感謝する。たとえそれが思い出や記憶だけの中であっても。",shape=box,color=red];
		j4231501517 -> j133992831;
	j3573228566 [label="もしかしたら…　もしかしたらだよ。全部神々の仕業かもしれない、っていう可能性もあるよね。慰めるために…",shape=box,color=red];
		j3573228566 -> j226808130;
	j362440701 [label="もしかしたら…　もしかしたらだよ。全部ルアの仕業かもしれない、っていう可能性もあるよね。慰めるために…",shape=box,color=red];
		j362440701 -> j226808130;
	j122895579 [label="二つはお互いに排他的であるはずだから、理解に苦しむ…　謎はいつになっても解き放たれないかもしれない。",shape=box,color=red];
		j122895579 -> j1521426940;
	j2713533731 [label="自分は…　RellとHarrowがLyonと一緒にいてくれたことに感謝する。たとえそれが思い出や記憶だけの中であっても。",shape=box,color=red];
		j2713533731 -> j2933270013;
	j2933270013 [label="ありがとう。RellとHarrowの存在が恋しいです。しかし、この場所には、私の痛みを理解しくれる人の方が、理解しない人よりも多いことを学びました。",shape=box,color=blue];
		j2933270013 -> j3079865727;
	j133992831 [label="ありがとう。RellとHarrowの存在が恋しいです。でも、もう孤独ではありません。そうではありませんか、mon miracle？",shape=box,color=blue];
		j133992831 -> j3079865727;
	j226808130 [label="はい。私を慰めるために派遣されたのかどうか、考えたことがないと否定しません。私の信仰心が蘇るかどうかは不明ですが…　深く考えることは私の癒しでもあります。",shape=box,color=blue];
		j226808130 -> j3079865727;
	j1521426940 [label="そうですね。RellとHarrowがルミナリーズによって私を慰めるために派遣されたのかどうか、考えたことがないと言えば嘘です。しかし、あなたもおっしゃる通り、私たちには一生明らかにならないかもしれません。",shape=box,color=blue];
		j1521426940 -> j3079865727;
