		j2793227429 -> "Chat ends." [label="false",color=purple];
	j924432503 [label="[トリガー警告が事前に設定されているため、会話をスキップしました]",shape=box,color=blue];
		j924432503 -> j1028404978;
	j4110733438 [label="Mon miracle、血清を注射した瞬間が、いかに奇妙であったか…　私の奇跡を十分に説明できる語源力があるのかどうか不安です。",shape=box,color=blue];
