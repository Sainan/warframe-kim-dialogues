	"Chat ends." [color=orange];
	j1028404978 [label="Boolean LyonRell3 is now true.",color=orange];
		j1028404978 -> j4075781927;
	j2282302516 [label="ものすごく痛いと聞きたけど。",shape=box,color=red];
		j2282302516 -> j1703557122;
	j3282796577 [label="想像もできない。 ",shape=box,color=red];
		j3282796577 -> j3424999180;
	j3231005689 [label="[警告：自傷行為と児童虐待について触れます。この題材が苦手な方は、ここをクリックして会話を終了してください。Lyonとの好感度は下がりません。]",shape=box,color=red];
		j3231005689 -> j1843578849;
	j1683560455 [label="[閉じる]",shape=box,color=red];
		j1683560455 -> j3856020424;
	j4075781927 [label="Boolean LyonWillDate is now true.",color=orange];
		j4075781927 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j1703557122 [label="そうです。とはいえ、痛みに耐える忍耐力は長年磨き上げてきたので、Entratiからの警告は実際よりもはるかに印象に残るものでした。",shape=box,color=blue];
		j1703557122 -> j3424999180;
	j3424999180 [label="Marieと私は人目を避けた場所で血清を注入することにしました。まず、私が行って変身を体験し、その後Marie自身の変身を一緒に体験したかったのですが…　もちろん、Marieは断固として私の提案を拒否しました。",shape=box,color=blue];
		j3424999180 -> j2019478398;
	j1843578849 [label="+20 Chemistry",color=orange];
		j1843578849 -> j2698387260;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	"Chat ends. Next chat will be Lyon5FaithDay2." [color=orange];
	j2019478398 [label="Marieは、私がしっかり彼女の傍にいて守ろうとしている姿勢を嘲笑し、自分の部屋へ向かいました。",shape=box,color=blue];
		j2019478398 -> j98590030;
	j2698387260 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j2698387260 -> j2559080857;
	j98590030 [label="私は自室のドアに鍵をかけ、服を脱ぎ、床の真ん中に座りました。できる限り、家具や物から離れた場所で…　脇腹に注射を突き刺したのです。",shape=box,color=blue];
		j98590030 -> j825426238;
	j2559080857 [label="Boolean LyonRell3 is now true.",color=orange];
		j2559080857 -> j4008758555;
	j825426238 [label="感染体が残したRoatheの傷を見て…　彼がその時来ていたであろうもので彼の身体を捻じ曲げたのを見てきたので。同じ運命の犠牲者にならないよう準備をしたのです。",shape=box,color=blue];
		j825426238 -> j1751520812;
	j4008758555 [label="Boolean LyonFaith3Unknown is now true.",color=orange];
		j4008758555 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j1751520812 [label="痛みが過ぎ去ると、ただでさえ信頼できない視界が…　ぼやけたのです。まるで、何もかもが二重に重なって見えるように。まるで一度ではなく、二度見えたかのようでした。",shape=box,color=blue];
		j1751520812 -> j2911777430;
	j2911777430 [label="嘔吐して意識を失う前になんとか平静を保つことができた自分の回復力にはかなり誇りを感じています。",shape=box,color=blue];
		j2911777430 -> j1555294885;
	j1555294885 [label="目が覚めたとき、部屋にはもう一人の存在を感じました。自分の部屋の床にいたわけでもありません。子供の頃の寝室で、あの軋む古い床の上に座っていることを認識したのです。",shape=box,color=blue];
		j1555294885 -> j3930360983;
	j3930360983 [label="私の隣には、若い男性が座っていました。今ではHarrowと名乗っている方です。その若い男性が持っていた木製の人形は塗装がずいぶん剥がれ落ちており、折り目やひび割れだけが残っているようでした。この人形は、私の父親の所有物です。兵士の像でした。",shape=box,color=blue];
		j3930360983 -> j3786365362;
	j3786365362 [label="その人形は、私が子供の頃、自分のものだと主張した唯一のおもちゃだったのです。",shape=box,color=blue];
		j3786365362 -> j852718320;
		j3786365362 -> j901817852;
	j852718320 [label="自分も子供の頃、同じようなフィギュアを持っていた。お気に入りだったよ。",shape=box,color=red];
		j852718320 -> j3784668476;
	j901817852 [label="Rell？",shape=box,color=red];
		j901817852 -> j1599626741;
	j3784668476 [label="そう聞きました。私の場合はより良性だったようですが。",shape=box,color=blue];
		j3784668476 -> j1064895830;
		j3784668476 -> j2370217740;
		j3784668476 -> j3470456533;
	j1599626741 [label="その通り。",shape=box,color=blue];
		j1599626741 -> j3847048741;
	j1064895830 [label="Thraxはとても複雑な話題なんだ。できれば避けたい題材。",shape=box,color=red];
		j1064895830 -> j746996910;
	j2370217740 [label="彼のせいじゃなかったんだ。ただ、あの瞬間に自分が求めていた人だっただけ。",shape=box,color=red];
		j2370217740 -> j3133305788;
	j3470456533 [label="大丈夫。彼は前進している。ゆっくりと。何とか。不可能に思えることも、変えられる。",shape=box,color=red];
		j3470456533 -> j2192436747;
	j3847048741 [label="夢の中で心の中の私を訪ねてきたその青年と沈黙の守護者は、見知らぬ人でありながら、まるで一緒に育った兄弟のようにお互いのことを知り尽くしている感覚に襲われたのです。",shape=box,color=blue];
		j3847048741 -> j3436531985;
	j746996910 [label="そうですね。デュヴィリの道徳的、神学的含意について議論すれば、何時間も費やすことになるでしょう。",shape=box,color=blue];
		j746996910 -> j3847048741;
	j3133305788 [label="ほんの少しでもあなたに代わって私が何を思いついただろうかと考えると、恐怖の波が押し寄せてきます。しかし、そのことについて何時間議論しても、成果は実らないでしょう。",shape=box,color=blue];
		j3133305788 -> j3847048741;
	j2192436747 [label="もし彼に変化の兆しが見られ、彼があなたの感情の産物であるなら、それは何か別の兆候かもしれません。しかし、また別の機会に話しましょう。",shape=box,color=blue];
		j2192436747 -> j3847048741;
	j3436531985 [label="誇張した比喩で申し訳ないのですが、私たちはまるで根が互いに区別がつかなくなるほどに一緒に育った3本の木のようです。",shape=box,color=blue];
		j3436531985 -> j3590305790;
	j3590305790 [label="瞬きしただけで…　あんな状態で存在し始めたのに…　RellとHarrowが私の人生に存在していなかった時の記憶があります。しかし、彼らは私と共に人生を歩んできたのです。常に一緒だった。あらゆる瞬間に、私の傍に出現する…　",shape=box,color=blue];
		j3590305790 -> j2201014022;
	j2201014022 [label="余談ですが、このことについてEntratiと話せたらいいのにと悔やまれます。この現象の根底にある化学がどのようなものなのか…　知りたくてたまりません。私たちが変身から立ち直った時には、Entratiはもう、影をくらませた後でした。",shape=box,color=blue];
		j2201014022 -> j1937133691;
	j1937133691 [label="Check boolean LoidFamilyComplete",color=orange];
		j1937133691 -> j3852564706 [label=true,color=green];
		j1937133691 -> j3683177439 [label=false,color=brown];
		j1937133691 -> j3852564706 [label=false,color=brown];
	j3852564706 [label="感染とその仕組みにはまだ多くの謎が秘められていますが、ある種…　多分…　時空を超えるものなのと思う。",shape=box,color=red];
		j3852564706 -> j2999647106;
	j3683177439 [label="Entartiの娘は上の階にいる。Entratiと一緒に勉強したり研究を進めていたんだ。何か手掛かりを掴んでいるかも。",shape=box,color=red];
		j3683177439 -> j3522181345;
	j2999647106 [label="例えば、そこにギターがある…　説明しにくいな。私たちは二人ともヘルミンス経由で時空を超えた。",shape=box,color=red];
		j2999647106 -> j2583606087;
	j3522181345 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j3522181345 -> j3227540231;
	j2583606087 [label="このことはきっと、これから先もずっと悪夢に刻まれる出来事なのでしょう。いずれにせよ、Rell、Harrowそして私がどのようにして分子的なの度合い、精神的な度合いで結びついているのかを証明する詳細はありません。",shape=box,color=blue];
		j2583606087 -> j809090372;
	j3227540231 [label="Add 1 to Family counter",color=orange];
		j3227540231 -> j2624902404;
	j809090372 [label="しかし、岐路は両方向へ向かっていました。彼らが私の人生にいたように、私も彼らの人生にいた。無関心のモノを見たことがあります。その瞬間、彼らが何に警戒しているのか十分に理解できました。Harrowの、そしてかつての彼の姿を垣間見たのです。",shape=box,color=blue];
		j809090372 -> j757029737;
	j2624902404 [label="彼女と話す機会が設けられると良いのですが…　すでにそのような計画が進行中ともお聞きしています。もし何かお手伝いできることがあれば…　お知らせください。説得する努力もします。",shape=box,color=blue];
		j2624902404 -> j2532080314;
	j757029737 [label="無関心のモノの圧力が私を圧倒しました。壁を叩く音を、私は感じた。Rap... tap... tap...",shape=box,color=blue];
		j757029737 -> j2401614237;
	j2532080314 [label="いずれにせよ、Rell、Harrowそして私がどのようにして分子的な度合い、精神的な度合いで結びついているのかを証明する詳細はありません。",shape=box,color=blue];
		j2532080314 -> j809090372;
	j2401614237 [label="幼い頃に見た幻覚、恐れる恐怖…　ただ無関心のモノだけの仕業だったのでしょうか。記憶違いをしているのでしょうか。それとも、私は本当にルアに「祝福」されていたのでしょうか。",shape=box,color=blue];
		j2401614237 -> j3559680430;
	j3559680430 [label="それは…　私の信仰心を疑わせるきっかけになりました。私の信仰心は、くしゃくしゃに崩れ落ち、焦げた紙のように塵と化したのです。こんな弱い人間でなかったはず…　",shape=box,color=blue];
		j3559680430 -> j2547210604;
	j2547210604 [label="Evaluate expressions",color=orange];
		j2547210604 -> j3281338285 [label="LyonDating",color=purple];
		j2547210604 -> j1210290563 [label="DrifterFaithYesSimilar",color=purple];
		j2547210604 -> j1210290563 [label="DrifterFaithYesForeign",color=purple];
		j2547210604 -> j1210290563 [label="DrifterFaithPersonal",color=purple];
		j2547210604 -> j1375047744 [label="DrifterFaithSol",color=purple];
		j2547210604 -> j1375047744 [label="DrifterFaithLua",color=purple];
		j2547210604 -> j1375047744 [label="DrifterFaithBalance",color=purple];
		j2547210604 -> j2121953952 [label="DrifterFaithAgnostic",color=purple];
		j2547210604 -> j391632471 [label="DrifterFaithNoFear",color=purple];
		j2547210604 -> j211900063 [label="DrifterFaithNoMITW",color=purple];
		j2547210604 -> j391632471 [label="DrifterFaithNoMaybe",color=purple];
		j2547210604 -> j3042743944 [label="false",color=purple];
	j3281338285 [label="Lyon。Lyonはとても辛い経験をしてきた。疑いは弱さから生まれるものではなく、痛みから生まれるものなんだ。",shape=box,color=red];
		j3281338285 -> j102090141;
		j3281338285 -> j1834675887;
		j3281338285 -> j2318565961;
		j3281338285 -> j2733099480;
		j3281338285 -> j1926532865;
	j1210290563 [label="信仰は必ずしも一定である必要はない。そうも期待されていない。信仰心を失った人が再び見つけ出すという話は、そう稀なものではない。",shape=box,color=red];
		j1210290563 -> j102090141;
		j1210290563 -> j1834675887;
		j1210290563 -> j2318565961;
	j1375047744 [label="Lyon。Lyonは人生をルミナリーズのために捧げてきた。こんな小さなことでLyonを追い出すことがあると思う？",shape=box,color=red];
		j1375047744 -> j102090141;
		j1375047744 -> j1834675887;
		j1375047744 -> j2318565961;
	j2121953952 [label="自分には神が存在するか、しないかは分からない、Lyon。どんなに考えても真に知ることはないと思う。でも、Lyonが多くの苦難を乗り越えてきたことは確かだ。",shape=box,color=red];
		j2121953952 -> j102090141;
		j2121953952 -> j2318565961;
		j2121953952 -> j2733099480;
	j391632471 [label="個人的にはこの世に神は存在しないと思っている。でも、Lyonにとって、神は絶対的な存在であることは承知だ。軽視するつもりはない。",shape=box,color=red];
		j391632471 -> j2318565961;
		j391632471 -> j1926532865;
	j211900063 [label="無関心のモノは自分たちの手によって作られた。奴は神ではない。Entratiの過ちによって、苦労する必要はない。Lyonの信仰心は…",shape=box,color=red];
		j211900063 -> j2318565961;
		j211900063 -> j1926532865;
	j3042743944 [label="くだらない話に巻き込まれて、凹んでいる姿を見るのは辛い。こんな目に遭うべきではなかった。",shape=box,color=red];
		j3042743944 -> j102090141;
		j3042743944 -> j1834675887;
		j3042743944 -> j2318565961;
		j3042743944 -> j2733099480;
		j3042743944 -> j1926532865;
	j102090141 [label="信仰心を再び見つけ出すべきだと言っているんじゃない。もう一度興味が湧いたり、信仰し直したいと感じるなら、その時から学び直したらいいんじゃないか、と提案しているだけだ。",shape=box,color=red];
		j102090141 -> j965305821;
	j1834675887 [label="ルアはきっと、Lyonの苦悩を知り尽くしているはずだ。彼女の名の下に耐えてきたこと全部を。",shape=box,color=red];
		j1834675887 -> j3563338396;
	j2318565961 [label="Lyonの一番の課題は、自分自身の中に何らかの平穏を見つけ出すことだ。どんな方法であっても…",shape=box,color=red];
		j2318565961 -> j965305821;
	j2733099480 [label="もし神が存在するなら…　Lyonのルアが本当に存在するのなら、きっとLyonの苦悩を知り尽くしているはずだ。彼女の名の下に耐えてきたこと全部を。Lyonの苦悩はきっと、何か価値があることなんだろう。",shape=box,color=red];
		j2733099480 -> j3563338396;
	j1926532865 [label="神が存在するかどうかという観念を捨てて、まず自分自身の傷を癒すことに取り組んだ方が良いと思う。",shape=box,color=red];
		j1926532865 -> j1793247559;
	j965305821 [label="Boolean LyonFaith3Maybe is now true.",color=orange];
		j965305821 -> j4198407665;
	j3563338396 [label="Boolean LyonFaith3Yes is now true.",color=orange];
		j3563338396 -> j4198407665;
	j1793247559 [label="Boolean LyonFaith3No is now true.",color=orange];
		j1793247559 -> j4198407665;
	j4198407665 [label="あなたのおっしゃる通りかもしれません。私の疑念に関する悲しい話が肝心なのではありません。あなたの言葉をよく考えてみることとします。明日、もう一度お話しできると嬉しいのですが…",shape=box,color=blue];
		j4198407665 -> j2269218355;
	j2269218355 [label="Zariman Ten Zero船に乗艦したRellの人生、そしてその後彼が経験したすべての苦難を目撃しました。侵略によって薄れゆく兵士としてのHarrowの人生も…　私のガウルで過ごした人生と、経験した苦しみを彼らが見たのと同じ様に…",shape=box,color=blue];
		j2269218355 -> j2027049850;
	j2027049850 [label="あなたにとって、私たちが一度も言葉を交わしたことがないことは不思議な現象かと思います。しかし、その必要性を感じたことがありません。ただ私たちの間には、沈黙の理解が存在するのです。",shape=box,color=blue];
		j2027049850 -> j3840001366;
		j2027049850 -> j1682905325;
	j3840001366 [label="え？　一度もないの？",shape=box,color=red];
		j3840001366 -> j1639777726;
	j1682905325 [label="うん。わかるよ。",shape=box,color=red];
		j1682905325 -> j1497526332;
	j1639777726 [label="彼らの声ははっきり聞こえました。彼らの人生で発した言葉をすべて知り尽くしていました。しかし、私に直接向けられたものではありません。",shape=box,color=blue];
		j1639777726 -> j1497526332;
	j1497526332 [label="笑顔に言葉は必要でしょうか。しかめっ面には？　子供が苦しい思いをしているか、恐怖を感じているか…　泣き声を聞く必要がありますか。私たちの心は、言葉が交わされなくても交わっていたのです。",shape=box,color=blue];
		j1497526332 -> j1590224204;
	j1590224204 [label="その沈黙の伝達が途切れるまでは…",shape=box,color=blue];
		j1590224204 -> j944777217;
	j944777217 [label="Check boolean LyonDating",color=orange];
		j944777217 -> j2316469651 [label=true,color=green];
		j944777217 -> j3049272546 [label=false,color=brown];
	j2316469651 [label="消え去ったではなく、亡くなったのです。Mon miracle。",shape=box,color=blue];
		j2316469651 -> j1120344056;
	j3049272546 [label="消え去ったではなく、亡くなったのです。友よ。",shape=box,color=blue];
		j3049272546 -> j1120344056;
	j1120344056 [label="もはや、未確定な部分は聞こえません。今となっては、確定した箇所だけが聞こえます。",shape=box,color=blue];
		j1120344056 -> j1506466772;
		j1120344056 -> j2682793286;
	j1506466772 [label="確定…　してる？",shape=box,color=red];
		j1506466772 -> j190231948;
	j2682793286 [label="いつから聞こえなくなったの？",shape=box,color=red];
		j2682793286 -> j3827261852;
	j190231948 [label="これ以上明確な説明を提供できません。どうすればいいのでしょう。お許しください。",shape=box,color=blue];
		j190231948 -> j3827261852;
	j3827261852 [label="Roatheと一緒にヘルミンスを抜け、ここ、サンクタムに着た瞬間。何故、どうやって来たのかは不明です。",shape=box,color=blue];
		j3827261852 -> j2077884111;
	j2077884111 [label="時間のベールを通過すると共に、私の友人、兄弟、その木の根が…　私の魂に絡みついていた木々が、私の傍で枯れ死んでいったのです。",shape=box,color=blue];
		j2077884111 -> j641786776;
	j641786776 [label="今そこには、空虚が住み着いています。腐りかけている。彼らの記憶は、今もなお私の記憶を蝕んでいる。でも、たとえ機会があったとしても、私はそれを手放したくない…",shape=box,color=blue];
		j641786776 -> j2302007176;
		j641786776 -> j3921371830;
	j2302007176 [label="え？",shape=box,color=red];
		j2302007176 -> j1856499829;
	j3921371830 [label="どうして？",shape=box,color=red];
		j3921371830 -> j1856499829;
	j1856499829 [label="母親に初めて殴られたときの記憶は鮮明に思い出せます。ソルの最も明るい光のように鮮明に…　二つの記憶が存在しています。そして、どちらの記憶も真実だと確信しています。",shape=box,color=blue];
		j1856499829 -> j3102686988;
	j3102686988 [label="一つ目の記憶では…　部屋の暗闇の中で一人泣いています。もう一つの記憶では、二人が影の中で私の傍に立っています。",shape=box,color=blue];
		j3102686988 -> j4131028113;
	j4131028113 [label="心の声を消し去るため、初めて刃物を肌に当てた時も記憶が二通りあります。一つ目の記憶では、部屋が空っぽでした。",shape=box,color=blue];
		j4131028113 -> j2131166632;
	j2131166632 [label="同じ場面の二つ目の記憶では、背後からブンブンする音が聞こえます。冷静な守護者の静かな存在を感じました。",shape=box,color=blue];
		j2131166632 -> j3178090660;
	j3178090660 [label="もし私がルアの女神への信仰心を失い、その代わりに彼女たちの導きをえることができたなら…　喜んで引き受けたかもしれません。",shape=box,color=blue];
