digraph {
	114 [label="LyonRank3Convo3 begins.",color=orange];
		114 -> 115;
	115 [label="先ほどLoid殿の図書室で本の整理をしていて…　Loid殿から空飛ぶ機械に任せればいいと主張されましたが、それでも世話になっている側として何もしないのは申し訳ないと感じ…",shape=box,color=blue];
		115 -> 116;
	116 [label="整理中に「Euleria Entrati」という人物が書いた架空の世界を舞台にした、子供向けの物語を述べた興味深い本に出会いました。",shape=box,color=blue];
		116 -> 117;
	117 [label="著者の名字が我らが「カーディナル・ディマンシュ」の本名と同じであることに気付き、私はその一冊を借りました。",shape=box,color=blue];
		117 -> 120;
		117 -> 119;
		117 -> 118;
	120 [label="その本に心当たりがある…",shape=box,color=red];
		120 -> 123;
	119 [label="前置きはいいから、何が聞きたいのか本題に入って。",shape=box,color=red];
		119 -> 122;
	118 [label="[無視する]",shape=box,color=red];
		118 -> 121;
	123 [label="+5 Chemistry",color=orange];
		123 -> 125;
	122 [label="Update boolean LyonMITW1",color=orange];
		122 -> 124;
	121 [label="Chat ends.",color=orange];
	125 [label="そうなのでしょう。本をLoid殿に見せた瞬間、彼は青ざめた表情を浮かべ、「漂流者を動揺させないよう」この本を戻すよう要求しました。あなたにとって思い入れ深い一冊なのでしょう。",shape=box,color=blue];
		125 -> 128;
	124 [label="私が聞きたいのは「概念の具体化」についてです。読み通す限り、この本は子供たちにVoidの感情への干渉の危険性を伝えようとしている、と捉えたのですが。",shape=box,color=blue];
		124 -> 126;
		124 -> 127;
	128 [label="「デュヴィリの伝説」。Loid殿からはあなたの経緯と苦難についてかなり…　長々とした説明を受けましたが、一つだけお尋ねしたいことがあるのです。",shape=box,color=blue];
		128 -> 131;
	126 [label="あまり役に立たなかったけどね。得に自分の場合は。",shape=box,color=red];
		126 -> 129;
	127 [label="強い感情にVoidが触れると…　大問題を引き起こすことがある。",shape=box,color=red];
		127 -> 130;
	131 [label="もちろん、あなたがよろしければ、ですが？",shape=box,color=blue];
		131 -> 134;
		131 -> 135;
	129 [label="我々はこれまで、どれだけ他人から事実を規定され、後の検証でそれが無益と知らされたことでしょう？",shape=box,color=blue];
		129 -> 132;
	130 [label="そのようです。カビアたちには会いました。Void天使の話も聞きました。ササヤキにも直面しました。",shape=box,color=blue];
		130 -> 133;
	134 [label="大丈夫。続けて。",shape=box,color=red];
		134 -> 122;
	135 [label="具体的な内容による、かな。何を聞かれるか分からないわけだし。",shape=box,color=red];
		135 -> 140;
	132 [label="Update boolean LyonFaith1",color=orange];
		132 -> 136;
	133 [label="それがこの好奇心の理由です。それで私はこの疑問を「声に出して」考えるにあたって、あなたの説明を聞こうと試みたのです。Voidが形取る時、何が現れるのでしょうか。それは「実在」するのですか？",shape=box,color=blue];
		133 -> 137;
		133 -> 138;
		133 -> 139;
	140 [label="+5 Chemistry",color=orange];
		140 -> 146;
	136 [label="なぜ他人の頭にそんな無駄な嘘を詰め込むのか、疑問に思うことがあります。彼らが求めているのは権力か、影響力か？　それとも、彼らは自身の言葉を真実と信じ、偽りに気付けていないのだろうか？",shape=box,color=blue];
		136 -> 142;
		136 -> 141;
	137 [label="いや、Voidが創り出すものは…　一時的だと思う。誰か、それか何かの断片。記憶の亡霊みたいな。",shape=box,color=red];
		137 -> 143;
	138 [label="そうだと思う。画家によって描かれた絵のように、誰かの頭から生まれたものでも、出来上がればそれは実在する。",shape=box,color=red];
		138 -> 144;
	139 [label="それは「実在」の定義による。",shape=box,color=red];
		139 -> 145;
	146 [label="ええ、仰る通りです。失礼しました。私はあまり…　直接的に会話をするのが得意ではないのです。特にこのように慣れない方法では。以後そうするよう努めます。",shape=box,color=blue];
		146 -> 122;
	142 [label="この場合、Euleria Entratiは他人の役に立つと思って書いたんだと思う。ただ、自分の場合そうでなかっただけで。",shape=box,color=red];
		142 -> 148;
	141 [label="わからない。Lyonの頭にはどんな嘘が詰め込まれたの？",shape=box,color=red];
		141 -> 147;
	143 [label="ではVoidが引き起こすこの現象は「実在」しないと？",shape=box,color=blue];
		143 -> 149;
	144 [label="その例えは以前の発言と矛盾していませんか？　Voidから回収した物質はVoidに戻る、違いますか？",shape=box,color=blue];
		144 -> 150;
	145 [label="+5 Chemistry",color=orange];
		145 -> 151;
	148 [label="彼女に代わって言い訳するなら、自分がVoidに触れていた期間が、彼女のガイドで想定されていたもの以上だったこと。",shape=box,color=red];
		148 -> 153;
	147 [label="あなたと共有するものではありません。",shape=box,color=blue];
		147 -> 152;
	149 [label="記憶によって人は酒に溺れたり、自決に追い込まれることもあります。その記憶は「実在」しないと？",shape=box,color=blue];
		149 -> 154;
	150 [label="なるほど、なら思考はどうだ。詩や歌は書き留めてなくても実在する。",shape=box,color=red];
		150 -> 155;
	151 [label="詳しく説明していただけますか？",shape=box,color=blue];
		151 -> 156;
	153 [label="+5 Chemistry",color=orange];
		153 -> 157;
	152 [label="Chat ends.",color=orange];
	154 [label="でもそれらは自らに働きかけた内なる力だ。外的な力じゃない。",shape=box,color=red];
		154 -> 158;
	155 [label="しかし忘れ去られれば、存在が消える。時の流れに失われた物語は、二度と戻ってきません。",shape=box,color=blue];
		155 -> 159;
	156 [label="「実在の度合い」、リアルさはどうやって測る？",shape=box,color=red];
		156 -> 160;
		156 -> 161;
		156 -> 162;
	157 [label="それが無知だったとしても、不運以外で他人が傷つかないこと願うしかありません。",shape=box,color=blue];
		157 -> 163;
	158 [label="では、その二つに何の違いがあるのでしょう？　結果が同じなら、違いを定義する意味があるのですか？",shape=box,color=blue];
		158 -> 164;
		158 -> 165;
		158 -> 166;
	159 [label="革命も、それを考えるものを討てば鈍い剣となります。",shape=box,color=blue];
		159 -> 164;
		159 -> 165;
		159 -> 166;
	160 [label="物理的によって？　重さと質量によって？　Voidから来たものは、ここでは一時的にしか存在できない。",shape=box,color=red];
		160 -> 167;
	161 [label="出来事への影響によって？　Voidから来たものは歴史の進路を変えた。",shape=box,color=red];
		161 -> 168;
	162 [label="他人への影響によって？　Voidから来た「モノ」は十分そうしているみたいだ。",shape=box,color=red];
		162 -> 169;
	163 [label="しかし私の好奇心は、この本やその有用性についてではありません。少し詩的になってしまいましたが、ご容赦ください。",shape=box,color=blue];
		163 -> 170;
	164 [label="Lyonが聞きたいのはものの「実在」じゃなくて「正当さ」なんじゃないか？　それを受け入れるかどうかで迷っているようだ。",shape=box,color=red];
		164 -> 171;
	165 [label="自分から言われせれば、神々であるソルとルアと握手できないルミナリーズが「実在」するかも疑問だけど。",shape=box,color=red];
		165 -> 172;
	166 [label="Lyonは遠まわしに、Voidから来る「もの」全ては、自分たちがその存在を望んだからかと、そう聞いているみたいだ。",shape=box,color=red];
		166 -> 173;
	167 [label="Voidから来るものはVoidへ帰る、と言いたいのですか？　しかしVoidとは、文字通り捉えるなら、空虚ではないのですか？",shape=box,color=blue];
		167 -> 174;
	168 [label="確かに。カゴに入れて重さを測れないとは言え、革命は「実在」した出来事です。",shape=box,color=blue];
		168 -> 169;
	169 [label="多くの犠牲が出たことは間違いありません。彼らはその正当性について激しく議論するでしょう。ですが、考えてみてください：",shape=box,color=blue];
		169 -> 175;
	170 [label="私はこの疑問を「声に出して」考えるにあたって、あなたの説明を聞こうと試みたのです。Voidが形取る時、何が現れるのでしょうか。それは「実在」するのですか？",shape=box,color=blue];
		170 -> 137;
		170 -> 139;
		170 -> 138;
	171 [label="+5 Chemistry",color=orange];
		171 -> 176;
	172 [label="ルミナリーズの議論をしているのではありません。Voidの話をしているのです。",shape=box,color=blue];
		172 -> 177;
		172 -> 178;
		172 -> 179;
		172 -> 180;
	173 [label="+5 Chemistry",color=orange];
		173 -> 181;
	174 [label="どうだろうか？　自分が触れたVoidの部分は、既に現実世界からの干渉があった。何らかの形を与えている。それか両次元の境目が曖昧になっている。",shape=box,color=red];
		174 -> 182;
		174 -> 183;
	175 [label="革命は、それを実行する人々の心の中に存在することによって、初めて正当性を与えられるのです。",shape=box,color=blue];
		175 -> 184;
	176 [label="確かに、そう言い換えることもできます。廊下の亡霊を無視するべきか、もし認識したら、その存在を定着させてしまうのか。",shape=box,color=blue];
		176 -> 177;
		176 -> 178;
		176 -> 179;
		176 -> 180;
	177 [label="今自分たちが直面している課題は危険だ。とっても。相応の対応が必要だ。",shape=box,color=red];
		177 -> 185;
	178 [label="亡霊は自分たちに苦痛を与えるほどに実在する。しかし銃弾で撃ち殺すことはできない。少なくとも自分が知る亡霊は。",shape=box,color=red];
		178 -> 186;
	179 [label="結局何が言いたいんだ、Lyon？",shape=box,color=red];
		179 -> 187;
	180 [label="正直…　わからない。自分が聞きたいくらいだ。",shape=box,color=red];
		180 -> 188;
	181 [label="確かに、そう言い換えることもできます。我々は自分自身の悪魔を顕現させていないと、どう確信できるのでしょうか？",shape=box,color=blue];
		181 -> 177;
		181 -> 178;
		181 -> 179;
		181 -> 180;
	182 [label="構造物だってそうだ。ルアはVoid内に隠されて、回収された。つまりVoidに存在するだけで消滅したりはしない。",shape=box,color=red];
		182 -> 189;
	183 [label="Lyonが言っているのは本当に何もない「より深い」Voidの存在のことかもだけど、正直それについてはわからない。",shape=box,color=red];
		183 -> 190;
	184 [label="もしそれが周囲の人々の思考から抹消されたら、存在が消えてしまうのではないでしょうか。",shape=box,color=blue];
		184 -> 165;
		184 -> 164;
		184 -> 166;
	185 [label="Update boolean LyonReal1",color=orange];
		185 -> 191;
	186 [label="Update boolean LyonFake1",color=orange];
		186 -> 192;
	187 [label="Update boolean LyonFaith1",color=orange];
		187 -> 193;
	188 [label="知らないことを正直に認めるあなたの姿は、実に清々しい。もっと多くの人が、このような才を持ち合わせていたならば。",shape=box,color=blue];
		188 -> 194;
	189 [label="Voidに投入され回収された物に興味はありません。私はVoidから生み出されたものの話をしているのです。",shape=box,color=blue];
		189 -> 164;
		189 -> 165;
		189 -> 166;
	190 [label="率直なご意見、ありがとうございます。私は、存在し得ないものよりも、今存在しているものにあまり興味がないのかもしれません。",shape=box,color=blue];
		190 -> 164;
		190 -> 165;
		190 -> 166;
	191 [label="ええ、Voidから来たもので、力で打ち倒せるものと、打ち倒せないものをあなたは熟知しているでしょうし…",shape=box,color=blue];
		191 -> 195;
	192 [label="だからこそ、多くの人が過剰に走ってしまうのかもしれません…　目に見えない傷を止血しようと。不治ではありませんが、それは武力ではなく、魂の強さが必要になります。",shape=box,color=blue];
		192 -> 195;
	193 [label="自分の手段の過ちに気付きました。この件についてはまた別の機会に話し合いましょう。お邪魔しました。",shape=box,color=blue];
		193 -> 196;
	194 [label="いずれにせよ、私はこの件に関してまだ考えが定まっていないと感じています。",shape=box,color=blue];
		194 -> 193;
	195 [label="ただ私は、変わらず疑念を抱いています。お邪魔しました。お時間をいただきありがとうございます、漂流者。",shape=box,color=blue];
		195 -> 196;
	196 [label="-神父 Lyon Allard",shape=box,color=blue];
		196 -> 197;
