		1347 -> 1350 [label=false,color=brown];
	1348 [label="でも、もし今でもRellの声が聞こえていたり、過去に聞こえていたなら…　それについて話せないかな。",shape=box,color=red];
		1348 -> 1351;
	1349 [label="わかった。Lyonのタイミングで話そう。",shape=box,color=red];
		1349 -> 1352;
