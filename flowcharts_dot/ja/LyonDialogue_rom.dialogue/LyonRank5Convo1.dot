		1387 -> 1379;
	1388 [label="振り返って、その部屋から出よう。心を休めるために。",shape=box,color=red];
		1388 -> 1394;
	1390 [label="ネクロなLoid殿の姿を見ました。Ordis殿やOtak殿の話も耳にします。さらに、頭蓋骨から思考が引き抜かれた、空っぽのWARFRAMEを思い浮かべることもあります。",shape=box,color=blue];
		1390 -> 1396;
