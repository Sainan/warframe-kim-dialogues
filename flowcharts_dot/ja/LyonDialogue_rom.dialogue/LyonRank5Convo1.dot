	1369 [label="落ち着いて、Lyon。落ち着くんだ。実際にそこにいない。",shape=box,color=red];
		1369 -> 1374;
	1370 [label="ご、ごめん、Lyon。画面に集中して。自分はここにいる。",shape=box,color=red];
		1370 -> 1375;
	1372 [label="Lyonが背負わされている重荷が、どれほど恐ろしいものかは知っている。正しいことではないのかもしれない。でも、その重みから抜け出す方法が分からない。",shape=box,color=red];
		1372 -> 1377;
	1371 [label="Marieにとって、Lyonはかけがえのない存在だ。自分にも、本当に大切な友人になったよ。Roatheでさえ、認めることはないけど、きっと寂しがるに違いない。",shape=box,color=red];
		1371 -> 1376;
	1373 [label="[気持ちを告白する] Lyon。もしLyonが自分自身を傷つけることになったら…　心が張り裂けるほど辛い。自分は…　Lyonのことを大切に想っている。",shape=box,color=red];
		1373 -> 1378;
	1374 [label="間違っている
奴らはそこにいる
決して私から離れない
もう二度とない
Entratiは見届けた
許せ",shape=box,color=blue];
		1374 -> 1379;
	1375 [label="肉を引き裂き
私の骨からそれを剥ぎ取り
何故？　何のため
誰の飢えを満たす？",shape=box,color=blue];
		1375 -> 1380;
		1375 -> 1381;
	1377 [label="想像もできない手段を頼らない以外の方法を。それさえも。",shape=box,color=red];
		1377 -> 1383;
	1376 [label="Lyonを大切だと思う人がいる。Lyonを頼りにする人もいる。家族や友人がいるじゃないか。寂しいと思う時があっても、Lyonを支えにしている人がいる。",shape=box,color=red];
		1376 -> 1382;
	1378 [label="まさか…　ご冗談でしょう。今見た光景を目の当たりにして、本気でそう言う訳がありません。正気を失ったか、同情心が理性を圧倒しただけではないですか。",shape=box,color=blue];
		1378 -> 1384;
		1378 -> 1385;
	1379 [label="+10 Chemistry",color=orange];
		1379 -> 1386;
	1380 [label="誰の飢えも満たさない。もう苦しむ必要はない。手放そう。",shape=box,color=red];
		1380 -> 1387;
	1381 [label="わかる。辛いのはわかる。ごめん。本当にごめん。今すぐ画面から離れて。",shape=box,color=red];
		1381 -> 1388;
	1383 [label="+10 Chemistry",color=orange];
		1383 -> 1390;
	1382 [label="Lyon。Lyonは一人じゃない。いなくなると寂しくなるよ。",shape=box,color=red];
		1382 -> 1389;
	1384 [label="いや、Lyon。自分は本気だ。Lyonは自分にとってかけがえのない存在だ。どうすれば信じてもらえる？　そう願うばかり。",shape=box,color=red];
		1384 -> 1391;
	1385 [label="いや...　でも、もしかしたらLyonの言う通りかもしれない。適切なタイミングは今でないのかもしれない。",shape=box,color=red];
		1385 -> 1392;
