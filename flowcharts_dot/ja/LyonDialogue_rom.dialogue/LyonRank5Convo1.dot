	1398 [label="Chat ends.",color=orange];
	1399 [label="どうかお許しください。時々、正気を失う瞬間に見舞われます。他人に見られると強い罪悪感を覚えます。",shape=box,color=blue];
		1399 -> 1405;
	1400 [label="屈服するのは簡単でしょう。諦めるのも。苦しみの祭壇に私の苦悩を置き、それ以上言及しないことは…　なんと容易いものなのでしょうか。",shape=box,color=blue];
		1400 -> 1406;
	1401 [label="屈服するのは簡単でしょう。諦めるのも。苦しみの祭壇に私の苦悩を置き、それ以上言及しないことは…　なんと容易いものなのでしょうか。それか、もっと酷いこともあるかもしれません。多くの人は、私が夜の暗闇の中で刃物で殺人を犯すのではないかと心配しています。",shape=box,color=blue];
		1401 -> 1406;
	1403 [label="問題は…　ただ一つ、漂流者よ。嘘を吐いたことがあることを認めたあなたの言葉を、どうすれば真実と受け止められるのでしょう。",shape=box,color=blue];
		1403 -> 1408;
