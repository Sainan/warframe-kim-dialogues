		1356 -> 1360;
	1357 [label="Lyon…　Lyonが経験したような苦難に耐えてきた人を「体調不良」と決めつけることはない。",shape=box,color=red];
		1357 -> 1361;
	1358 [label="「望まない幻視に呪われている」ことを「体調不良」と柔らかく表現することはない。もっともLyonがそう言いたいなら別だけど。",shape=box,color=red];
		1358 -> 1361;
	1359 [label="Lyonは自分が持ち合わせる能力を知っているから、Lyonのペースに合わせるよ。",shape=box,color=red];
		1359 -> 1362;
	1360 [label="血まみれの",shape=box,color=blue];
		1360 -> 1363;
	1361 [label="お気持ちを嬉しく頂戴いたします。私はどんなに良い日でも、粉々に砕けたステンドグラスの窓でしかないことを分かっています。ここに立ち、多くの破片がどこへ行ってしまったのか、考えさせられます。",shape=box,color=blue];
		1361 -> 1364;
	1362 [label="お気持ちを嬉しく頂戴いたします。あなたの辛抱強さを尊敬します。私はどんなに良い日でも、粉々に砕けたステンドグラスの窓でしかないことを分かっています。ここに立ち、多くの破片がどこへ行ってしまったのか、考えさせられます。",shape=box,color=blue];
		1362 -> 1364;
	1363 [label="腱と肉から切り出された",shape=box,color=blue];
		1363 -> 1365;
	1364 [label="砕けた破片を見つけるたびに、元の位置に戻すよりも、怪我をしてしまう可能性が高いのですから。",shape=box,color=blue];
		1364 -> 1366;
	1365 [label="やめろ！　やめさせろ！",shape=box,color=blue];
		1365 -> 1367;
	1366 [label="時々悪夢が許す限り、心の中で思い描く、本当に虚ろな目をしたHarrowになった方が良いのではないかと考慮します。",shape=box,color=blue];
		1366 -> 1368;
	1367 [label="奴らの顔は
