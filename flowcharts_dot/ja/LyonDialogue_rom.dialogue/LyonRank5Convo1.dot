		1406 -> 1413;
	1408 [label="あなたの嘘を見破ったこともあるのです。今回の嘘の目的は分かりません。しかし、あなたを信頼できなくなっている自分自身が不安で仕方ありません。",shape=box,color=blue];
		1408 -> 1414;
	1407 [label="Chat ends.",color=orange];
	1409 [label="発言できないことは珍しいことではないことを承知しています。しかし、何らかの形で回答差し上げます。",shape=box,color=blue];
		1409 -> 1415;
	1410 [label="ここで一度休む？　それとも続ける？　どっちでも自分は構わない。",shape=box,color=red];
		1410 -> 1416;
	1412 [label="構わないさ。Lyonの傍を離れない。大丈夫になるかな？",shape=box,color=red];
		1412 -> 1418;
	1411 [label="[気持ちを告白する] Lyon、自分は…　Lyonのことを大切に思っている。こういう時、自分の存在を許してくれるなら、いつでもそばにいたいと思う。",shape=box,color=red];
		1411 -> 1417;
	1413 [label="常に流血しながらも、決して死ぬことはない…",shape=box,color=blue];
		1413 -> 1419;
	1414 [label="光栄ではありますが、私の答えは極めて単純かつ明白なものになるのではないかと懸念しています…",shape=box,color=blue];
		1414 -> 1420;
	1415 [label="- 何らかの賢いやり方で…　少なくとも状況に見合ったやり方で",shape=box,color=blue];
		1415 -> 1421;
	1416 [label="続行して大丈夫です、ありがとうございます。いつものように、過ぎ去りました。私の…　幻覚は、ルアの上を通り過ぎる雲のようなものです。暗闇に包まれることもありますが、たいていは束の間です。",shape=box,color=blue];
		1416 -> 1422;
	1418 [label="大丈夫です。ありがとうございます。いつものように、過ぎ去りました。私の…　幻覚は、ルアの上を通り過ぎる雲のようなものです。暗闇に包まれることもありますが、たいていは束の間です。",shape=box,color=blue];
		1418 -> 1422;
	1417 [label="ご冗談でしょう。今見た光景を目の当たりにして、本気でそう言う訳がありません。正気を失ったか、同情心が理性を圧倒しただけではないですか。",shape=box,color=blue];
		1417 -> 1423;
