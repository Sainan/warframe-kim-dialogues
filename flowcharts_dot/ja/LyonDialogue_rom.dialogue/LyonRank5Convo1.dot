		1389 -> 1395;
	1391 [label="私。",shape=box,color=blue];
		1391 -> 1397;
	1392 [label="安心しました。一時的な狂気から立ち直れたとお聞きし安心です。やはり狂気は伝染するのか。この装置から少し距離を置いた方が良さそうです。あなたの脳が腐り始めているのではないか心配です。",shape=box,color=blue];
		1392 -> 1398;
	1393 [label="Chat ends.",color=orange];
