digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank4Convo5 begins." [color=orange];
		"LyonRank4Convo5 begins." -> j3425926750;
	j3425926750 [label="Check boolean LyonSerum1",color=orange];
		j3425926750 -> j2100609990 [label=true,color=green];
		j3425926750 -> j738393015 [label=true,color=green];
		j3425926750 -> j1631800673 [label=false,color=brown];
		j3425926750 -> j738393015 [label=false,color=brown];
	j2100609990 [label="Lyon、RoatheがLyonとMarieと一緒に大聖堂に来た経緯の続きを教えて。",shape=box,color=red];
		j2100609990 -> j1279295236;
	j738393015 [label="[閉じる]",shape=box,color=red];
		j738393015 -> "Chat ends.";
	j1631800673 [label="Lyon、RoatheがLyonとMarieと一緒に大聖堂に来た経緯を教えて。",shape=box,color=red];
		j1631800673 -> j4044041353;
	j1279295236 [label="お望みならお話しします。本当によろしいですか。不快な話なのですが…　Roatheはある日、まるで傷付いた野良猫のように、玄関先に捨てられていました。",shape=box,color=blue];
		j1279295236 -> j3769319211;
	"Chat ends." [color=orange];
	j4044041353 [label="お望みならお話しします。Roatheはまるで傷付いた野良猫のように、玄関先に捨てられていました。ここまま続けますか？　不快な話になるかもしれません。",shape=box,color=blue];
		j4044041353 -> j3769319211;
	j3769319211 [label="Evaluate expressions",color=orange];
		j3769319211 -> j2608229781 [label="LyonStray",color=purple];
		j3769319211 -> j1821437416 [label="RoatheSerum1",color=purple];
		j3769319211 -> j1800702880 [label="false",color=purple];
	j2608229781 [label="自分は間違っていなかった。やっぱりRoatheの話だったんだ。",shape=box,color=red];
		j2608229781 -> j3550322599;
	j1821437416 [label="Roatheによると、出現したとき、ちょっと…　野性的になる理由は備わっているそうだ。",shape=box,color=red];
		j1821437416 -> j3195217168;
	j1800702880 [label="警告してくれてありがとう。でも聞きたい。",shape=box,color=red];
		j1800702880 -> j2266356665;
	j3550322599 [label="よろしいでしょう。それは大聖堂をよく訪問していた野良猫の物語です。その意味をどう解釈するか、および話を教えてあげる理由を受け止めるのは、すべてあなた自身の責任です。私は単なる神父であるのみですから。",shape=box,color=blue];
		j3550322599 -> j2266356665;
	j3195217168 [label="彼のような地位と気質の人間であれば、Entratiの行動に不当な扱いを受けたと反応するのが当然でしょう。正直なところ、もしRoatheがそれを潔く処理したなら、もっと驚くところです。",shape=box,color=blue];
		j3195217168 -> j2266356665;
	j2266356665 [label="Evaluate expressions",color=orange];
		j2266356665 -> j1411885631 [label="LyonSerum1",color=purple];
		j2266356665 -> j3929781021 [label="false",color=purple];
	j1411885631 [label="確か、Entratiはその頃、Roatheとの失踪から帰還したばかりだと記憶しています。その彼は、すでの変化した後でした。Entratiは3年以上も言い続けてきた嘘を打ち明けたのです。",shape=box,color=blue];
		j1411885631 -> j3408995879;
	j3929781021 [label="その瞬間に至るまでの出来事を要約します。そうしないと、話を理解しにくいかと存じます。",shape=box,color=blue];
		j3929781021 -> j635658219;
	j3408995879 [label="彼は、今の我々を形作った「PROTOFRAME血清」を提供してくれましたが、それを受け入れると...　すぐにまた私たちを見捨てました。",shape=box,color=blue];
		j3408995879 -> j3379547168;
	j635658219 [label="3年、2ヶ月と、11日の間、Entratiはカーディナル・ディマンシュとして大聖堂に在籍していました。その間、Marieも私も彼の策略に気付くことなく仕えていました。",shape=box,color=blue];
		j635658219 -> j966774994;
	j3379547168 [label="そして、新たに孤児となった混合物として留まる我々の身体と魂は、支配権を主張するどころか、理解できない創造物に変容しました。",shape=box,color=blue];
		j3379547168 -> j4104057021;
	j966774994 [label="あなたが尋ねる前に、次の質問は予想できます。彼は何を企んでいたと？　噂に聞くホルバニアのように、街を感染させたのか？　彼の計画は何だったのか？　彼の発見は何だったのか？",shape=box,color=blue];
		j966774994 -> j206772466;
	j4104057021 [label="かつて故郷だった場所は、取り残された我々にとって敵対的な街へと豹変し、身を隠すことを余儀なくされました。",shape=box,color=blue];
		j4104057021 -> j3582583178;
		j4104057021 -> j2506462167;
	j206772466 [label="これらの問いに対しての答えは、あなたの期待を裏切るものでしょう。彼は説教し、学び、休息し、祈りました。そしてある夜、恐ろしい嵐の中、姿を消しました。現れた時と同じような嵐の中へ。",shape=box,color=blue];
		j206772466 -> j2575044127;
	j3582583178 [label="見た目のせいで？",shape=box,color=red];
		j3582583178 -> j3741122732;
	j2506462167 [label="大聖堂がMarieとLyonを拒否したの？",shape=box,color=red];
		j2506462167 -> j3320350239;
	j2575044127 [label="Check boolean MarieLyonVisions",color=orange];
		j2575044127 -> j2376974365 [label=true,color=green];
		j2575044127 -> j490855627 [label=false,color=brown];
	j3741122732 [label="気づいていないかもしれませんが、Marieには飛翔能力が備わりました。Roatheはその一方、青いですし他の問題も存在します。",shape=box,color=blue];
		j3741122732 -> j3483301585;
	j3320350239 [label="正確には…　拒否されのではありません。公的生活から追い出されただけです。かろうじて他の神父や修道女は、我々を路上に追放したり、火あぶりの刑を科すことはありませんでした。「カーディナル・ディマンシュ」が我々の変身は…　ルミナリーズの働きだと確信させたため。",shape=box,color=blue];
		j3320350239 -> j4158873707;
	j2376974365 [label="他の人々がそんな嵐は起こらなかったと主張していることは承知していますが、私はそう記憶しています。",shape=box,color=blue];
		j2376974365 -> j490855627;
	j490855627 [label="それからちょうど一年後、彼は最後にもう一度現れました…　Roatheを連れて。今知る姿で、Entratiの足元で意識を失った状態で。",shape=box,color=blue];
		j490855627 -> j76991955;
	j3483301585 [label="あなたは喋る生き物や頭蓋骨に夢中になったり、宇宙のVoidの問題について考えたりして日々過ごしていることは承知しています。しかし、この行動はほとんどの人間にとって標準的な行いではなく、奇妙に見えるのです。",shape=box,color=blue];
		j3483301585 -> j460507233;
	j4158873707 [label="我々はその後、地下納骨堂に隠され、人目につかないようにされた。かつての同胞たちは、我々を恐れつつ、物資を運んできてくれました。",shape=box,color=blue];
		j4158873707 -> j1597391009;
	j76991955 [label="本物の悪魔、当時はそう思いました。その時、Entratiは彼が何者なのか、何処から来たか、我々への任務を明かしました。我々二人を、最も「神聖な使命」に選んだと。",shape=box,color=blue];
		j76991955 -> j1509504430;
	j460507233 [label="実際、うまく身を隠せれば、群衆の中を歩き回れるのは我々三名のうち私だけです。",shape=box,color=blue];
		j460507233 -> j510159471;
		j460507233 -> j3448798503;
	j1597391009 [label="彼らは、幽霊のように突然階段に出現して挨拶するMarieとだけ交流することを主張しましたが…",shape=box,color=blue];
		j1597391009 -> j3142930794;
		j1597391009 -> j1725388881;
	j1509504430 [label="Marieは血清を喜んで受け入れました。当然。そうしない理由がないから。そして私も、彼女を追わない理由がなかった。何であろうと、真実を追求できるなら？",shape=box,color=blue];
		j1509504430 -> j249472217;
	j510159471 [label="Lyonは何て言ったの？",shape=box,color=red];
		j510159471 -> j34410508;
	j3448798503 [label="どうやって皆、この状況に至ったの？",shape=box,color=red];
		j3448798503 -> j3008099195;
	j3142930794 [label="Roatheを避けるのは理解できるけど... 　Lyonと話すよりもそれを好むの？",shape=box,color=red];
		j3142930794 -> j694152674;
	j1725388881 [label="Marieが一番やさしそうだもんね。",shape=box,color=red];
		j1725388881 -> j75605491;
	j249472217 [label="Boolean LyonSerum1 is now true.",color=orange];
		j249472217 -> j3703181309;
		j249472217 -> j2742532789;
		j249472217 -> j3224719202;
	j34410508 [label="他の神父や修道女は、我々を路上に追放したり、火あぶりの刑を科すことはありませんでした。「カーディナル・ディマンシュ」が我々の変身は…　ルミナリーズの働きだと確信させたため。",shape=box,color=blue];
		j34410508 -> j2215934715;
	j3008099195 [label="具体的な方法はRoatheの方が詳しい。何年もの研究を経て、我々の血液サンプルから「Helminth」を作成したようです。",shape=box,color=blue];
		j3008099195 -> j3832303892;
	j694152674 [label="私の本質に会ったことがありますよね。",shape=box,color=blue];
		j694152674 -> j677546587;
	j75605491 [label="その通り。",shape=box,color=blue];
		j75605491 -> j3701430010;
	j3703181309 [label="MarieはEntratiを崇拝しすぎている。",shape=box,color=red];
		j3703181309 -> j857869069;
	j2742532789 [label="それで？",shape=box,color=red];
		j2742532789 -> j2956925400;
	j3224719202 [label="後悔している？",shape=box,color=red];
		j3224719202 -> j2610140173;
	j2215934715 [label="我々はその後、地下納骨堂に隠され、人目につかないようにされた。かつての同胞たちは、我々を恐れつつ、物資を運んできてくれました。",shape=box,color=blue];
		j2215934715 -> j2724583871;
	j3832303892 [label="感染体は、何らかの形で...　時間を通じて...　繋がっていると私は信じていますが...　詳細はよく分かりません。",shape=box,color=blue];
		j3832303892 -> j3547943096;
		j3832303892 -> j4195977796;
	j677546587 [label="どれくらいの時間、地下に閉じ込められていたの？",shape=box,color=red];
		j677546587 -> j3796797964;
	j3701430010 [label="皆を地下室に閉じ込めていたの？",shape=box,color=red];
		j3701430010 -> j4173152511;
	j857869069 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j857869069 -> j3464277876;
	j2956925400 [label="Roatheが目覚めました。最初は、名前さえ思い出せない状態でした。Entratiは去り際に、彼に言葉を残しました。「Uriel、Xataの異端者よ、追放の中で答えを導け、オロキンは許されるのか？」と。",shape=box,color=blue];
		j2956925400 -> j2223166059;
	j2610140173 [label="全てを後悔しています。もちろんです。しかし、もし同じ状況に陥ったら？　ええ、ためらわず繰り返すでしょう。Marieを一人にさせないためにも。",shape=box,color=blue];
		j2610140173 -> j3177797249;
	j2724583871 [label="彼らは、幽霊のように突然階段に出現して挨拶するMarieとだけ交流することを主張しましたが…",shape=box,color=blue];
		j2724583871 -> j2645388679;
		j2724583871 -> j4053102830;
	j3547943096 [label="Helminthを逆算作業したのか？！ 　どれくらい時間がかかった？",shape=box,color=red];
		j3547943096 -> j2967530251;
	j4195977796 [label="誰も理解できないと思う。新しい発見だから。",shape=box,color=red];
		j4195977796 -> j2093974782;
	j3796797964 [label="我々が喋る感染体アマルガムに変わってから何年経ったのか、と尋ねるべき相手は私ではありません。それ以来の時間の経過については、私には…　複雑な理解しかありません。",shape=box,color=blue];
		j3796797964 -> j4105446679;
		j3796797964 -> j3869974449;
	j4173152511 [label="想像よりずっと厳しいように聞こえるかもしれません。他に収容できる場所がなかったのです。鐘楼は開け放たれすぎて、厳しい自然にさらされすぎます。地下聖堂は風雨から守られて暖かかった。",shape=box,color=blue];
		j4173152511 -> j2085662766;
	j3464277876 [label="同感です。しかし彼女を責めることもできません。辛抱してください。いずれ理解できます。彼女は非常に賢いのです、愚か者ではありません。",shape=box,color=blue];
		j3464277876 -> j3177797249;
	j2223166059 [label="そしてEntratiは旅立ちました。Roatheを置いて。変貌したその姿は、まさに悪魔そのものでした。",shape=box,color=blue];
		j2223166059 -> j3379547168;
	j3177797249 [label="話の続きですが…　血清を受け取ると、Entratiは旅立ちました。Roatheを置いて。変貌した彼の姿は、まさに悪魔そのものでした。",shape=box,color=blue];
		j3177797249 -> j3379547168;
	j2645388679 [label="Roatheを避けるのは理解できるけど... 　Lyonと話すよりもそれを好むの？",shape=box,color=red];
		j2645388679 -> j1028299847;
	j4053102830 [label="Marieが一番やさしそうだもんね。",shape=box,color=red];
		j4053102830 -> j42287338;
	j2967530251 [label="Boolean LyonRoatheHelminth is now true.",color=orange];
		j2967530251 -> j2081717957;
	j2093974782 [label="他の人も理解できないと聞いて、安心するのか、がっかりするのかは分かりません。感染体が話せるようになったこと自体、不思議な気持ちが湧きます。",shape=box,color=blue];
		j2093974782 -> j534325929;
		j2093974782 -> j2813038449;
	j4105446679 [label="どういうふうに複雑？",shape=box,color=red];
		j4105446679 -> j2214425622;
	j3869974449 [label="感染体が話せることを伝えた方が良いのか、悪いのか…",shape=box,color=red];
		j3869974449 -> j2689439547;
	j2085662766 [label="そして残念なことに、Roatheが街を歩き回ることを可能にした隠れ出口を発見しました。",shape=box,color=blue];
		j2085662766 -> j845860967;
	j1028299847 [label="私の本質に会ったことがありますよね。",shape=box,color=blue];
		j1028299847 -> j677546587;
		j1028299847 -> j3701430010;
	j42287338 [label="その通り。",shape=box,color=blue];
		j42287338 -> j3701430010;
		j42287338 -> j677546587;
	j2081717957 [label="質問するべき相手は私ではありません。その事象以来、時間の経過に関する私の見解は…　複雑になっています。もっとも、「より複雑になった」と言及する方が正確かと。これ以上恐ろしいことはないかのように…",shape=box,color=blue];
		j2081717957 -> j4105446679;
		j2081717957 -> j3869974449;
	j534325929 [label="家にあるもの全部が喋れるわけではない。椅子は時々…　まあ…　まあいいや。続けて。",shape=box,color=red];
		j534325929 -> j2441408828;
	j2813038449 [label="ギターの話はまた他の時にするよ。",shape=box,color=red];
		j2813038449 -> j1186995381;
	j2214425622 [label="Boolean LyonTime1 is now true.",color=orange];
		j2214425622 -> j1839314704;
	j2689439547 [label="信じてください。理解しています。そして不安にもなります。しかし、この場所にあるもの全てが喋れるようですが。",shape=box,color=blue];
		j2689439547 -> j534325929;
		j2689439547 -> j2813038449;
	j845860967 [label="Evaluate expressions",color=orange];
		j845860967 -> j3973071302 [label="MarieRoathePastry1",color=purple];
		j845860967 -> j3973071302 [label="RoatheMariePastry1",color=purple];
		j845860967 -> j4143710922 [label="false",color=purple];
	j2441408828 [label="もしあなたが「占拠されている」って言いたかったなら、漂流者、私も見たことがあります。ささやいたあの人。壁の中にいたあの人。叩く音も聞こえました…",shape=box,color=blue];
		j2441408828 -> j3008286469;
	j1186995381 [label="どうか教えてください。楽器が儚い半神のような存在である方が、私の心を悩ませ、見捨ててきた他の何かよりもずっと慰めになると思うんです。彼が…　以来ずっと…　というのは、おかしなことでしょうか。",shape=box,color=blue];
		j1186995381 -> j2121895087;
	j1839314704 [label="その問題に対して特別に敏感なせいなのか、それとも私が作った個人的な状況によるものなのか、それとも...　彼によるものなのかは分かりません。",shape=box,color=blue];
		j1839314704 -> j2550411607;
	j3973071302 [label="うん、そう聞いた。",shape=box,color=red];
		j3973071302 -> j4100763406;
	j4143710922 [label="え？",shape=box,color=red];
		j4143710922 -> j3620449679;
	j3008286469 [label="生まれてから聞いたことのない声が私に告げている。私の過去からずっと未来まで続いている...",shape=box,color=blue];
		j3008286469 -> j2248983388;
	j2121895087 [label="彼？",shape=box,color=red];
		j2121895087 -> j3008286469;
	j2550411607 [label="こう言うと狂人だと思われるだろうが、私は時間を...　純粋に...　直線的に経験しているわけではない。",shape=box,color=blue];
		j2550411607 -> j245680031;
		j2550411607 -> j1674805990;
	j4100763406 [label="彼の数少ない救いの一つです。盗みのことを言っているのではありません。脱出する背後にある理由を指します。違法な品物を入手したのは、Marieを誘い出して会話を交わすためだったというのが私の考えです。",shape=box,color=blue];
		j4100763406 -> j2521904218;
	j3620449679 [label="とくに追求する理由はありません。",shape=box,color=blue];
		j3620449679 -> j2062323571;
		j3620449679 -> j2109467463;
	j2248983388 [label="いつも聞こえていたわけではありません。それでも、今でも…　思い出せます。ルア自身の銀色の光のように、幼少期の家の壁の内側から聞こえた、若い男の声…　彼の隣に立つ別の存在…　「Rap Tap Tap…」",shape=box,color=blue];
		j2248983388 -> j1367900861;
	j245680031 [label="「彼？」「彼」って誰？",shape=box,color=red];
		j245680031 -> j3008286469;
	j1674805990 [label="Lyon、自分は数え切れないほどの世紀にわたる時間を、渦巻く螺旋として体験した。",shape=box,color=red];
		j1674805990 -> j2399393787;
	j2521904218 [label="おそらく、彼が見ていないと察したときに、Marieがほほ笑んだからでしょう。かつてRoatheは私にこう言いました。「彼女の生きる力を奪われたのは、運命の大きな過ちだ」と。",shape=box,color=blue];
		j2521904218 -> j3733610902;
	j2062323571 [label="元の状態に戻るまで…　どれ位経ったの？",shape=box,color=red];
		j2062323571 -> j2715684874;
	j2109467463 [label="それからどうなったの？",shape=box,color=red];
		j2109467463 -> j3008099195;
	j1367900861 [label="すみません。もうこれ以上は無理です。心の準備が整っていません。このことについて、もうこれ以上聞かないでください。",shape=box,color=blue];
		j1367900861 -> j4294793933;
	j2399393787 [label="では、私の理性を超えた声が告げているとしたら、どう思われますか？　生涯ずっとその声を聞いてきたわけではないことは理解しています。ずっとそこにあったはずがありません。",shape=box,color=blue];
		j2399393787 -> j4009014658;
	j3733610902 [label="Boolean LyonRoathePastry is now true.",color=orange];
		j3733610902 -> j3708917293;
		j3733610902 -> j2062323571;
	j2715684874 [label="我々が喋る感染体アマルガムに変わってから何年経ったのか、と尋ねるべき相手は私ではありません。それ以来の時間の経過については、私には…　複雑な理解しかありません。",shape=box,color=blue];
		j2715684874 -> j3869974449;
