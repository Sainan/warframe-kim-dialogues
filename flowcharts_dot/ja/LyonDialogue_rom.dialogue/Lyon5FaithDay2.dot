		j3797288467 -> j2651106201;
	j3207200468 [label="彼らの存在は再び私の魂からもぎ取られ、記憶としてのみ残っています。もしかしたら…　ルアからの贈り物だったのかもしれません。",shape=box,color=blue];
		j3207200468 -> j1226451328;
