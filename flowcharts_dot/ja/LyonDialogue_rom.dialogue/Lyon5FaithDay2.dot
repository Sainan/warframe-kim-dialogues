		j1286686499 -> j3410162714 [label=false,color=brown];
		j1286686499 -> j400754915 [label=false,color=brown];
	j1226451328 [label="もしかしたら、あなたは正しいのかもしれません。銀の女神は、そのような悲劇的な祝福しか与えないのかもしれません。Roatheのように、苦痛の記憶を消し去られる必要はあるのでしょうか。",shape=box,color=blue];
		j1226451328 -> j3711192799;
	j2967855426 [label="壁の中のモノが本物の神でないと思っているRoatheと自分の意見に賛成する？",shape=box,color=red];
		j2967855426 -> j2856000326;
	j400754915 [label="無関心のモノはどっちのシナリオに当てはまると思う？",shape=box,color=red];
		j400754915 -> j2837619658;
	j3410162714 [label="無関心のモノが本物の神でないと唱えるRoatheの意見に賛成する？",shape=box,color=red];
		j3410162714 -> j2856000326;
	j2856000326 [label="私の意見がどちら寄りか、自信をもてません。十分な証拠がないからです。しかし、どちら寄りになろうと、あまり変わらないのではないでしょうか。",shape=box,color=blue];
		j2856000326 -> j2134652117;
		j2856000326 -> j2561204492;
	j2837619658 [label="無関心のモノが神であるかないか、私は胸を張って宣言できません。十分な証拠がないからです。しかし、どちら寄りになろうと、あまり変わらないのではないでしょうか。",shape=box,color=blue];
		j2837619658 -> j2134652117;
		j2837619658 -> j2561204492;
	j2134652117 [label="大きく左右されると思う。無関心のモノが真の神でないなら、人間が創り上げたものだ。人が作り上げたものは、人間の手によって打ち負かせる可能性がある。",shape=box,color=red];
		j2134652117 -> j1523847896;
	j2561204492 [label="よくわからないんだけど。",shape=box,color=red];
		j2561204492 -> j4154810041;
	j1523847896 [label="我々の努力により打ち負かす希望を見出せないのなら、そもそもなぜ抵抗するのですか？　あなた方は不可解な生き物です。",shape=box,color=blue];
		j1523847896 -> j1926591837;
	j4154810041 [label="宇宙に到来する方法によって、打ち負かす方法が左右されるわけではありません。",shape=box,color=blue];
		j4154810041 -> j1779398593;
	j1926591837 [label="本心で言っている訳ではありませんよね。あなたは他人の行動にただただ「同調」しているだけなのですか。時間が余りすぎて、他に行いたいことがないからですか？",shape=box,color=blue];
		j1926591837 -> j3084774501;
	j1779398593 [label="見よ。我々自身の空虚さから縫い上げられた、我々が創造した神。",shape=box,color=blue];
		j1779398593 -> j813620231;
	j3084774501 [label="もっとましな趣味があるでしょう。",shape=box,color=blue];
		j3084774501 -> j205831006;
		j3084774501 -> j1602085050;
	j813620231 [label="布製の人形に、悲しみ、悲嘆、痛み、怒り、苦悩を詰め込み過ぎると、縫い目が破裂するかもしれない。",shape=box,color=blue];
		j813620231 -> j2509338843;
	j205831006 [label="いや、絶望的だとは言ってない。そういう意味じゃない。",shape=box,color=red];
		j205831006 -> j1838197223;
	j1602085050 [label="何を言いたいかというと…　殺すことと、その動機を理解する考え方が変わるかもしれないということだ。",shape=box,color=red];
		j1602085050 -> j1015342630;
	j2509338843 [label="我々が到着する前に存在した神であったとしても、はるかに大きな恐怖を与えると感じたとしても、私を許してくれますか。",shape=box,color=blue];
		j2509338843 -> j695050980;
	j1838197223 [label="言葉を発する前に考える時間を費やすことは、必須条件ではありません。弾丸を撃つのと同じように。",shape=box,color=blue];
		j1838197223 -> j1779398593;
	j1015342630 [label="私はそう思いません。もしそれが「偉大で不可知の神」であったとしたら、私たちはその動機について何も理解できないことを示すでしょう。",shape=box,color=blue];
		j1015342630 -> j1779398593;
	j695050980 [label="実際、そうであってくれることを願います。",shape=box,color=blue];
		j695050980 -> j1728291461;
	j1728291461 [label="人類全体よりも知能が高いかもしれない希望が残っています。",shape=box,color=blue];
		j1728291461 -> j3878534287;
	j3878534287 [label="そういうわけで...　まったく暗い考えですが、今日はこれでお別れすることにします。",shape=box,color=blue];
