		j1561485339 -> j3797288467;
	j685928042 [label="この世界で善行をすることを根本とする組織に奉仕した年月を思い返します。私の人生にRellとHarrowの存在がこれほどまでに不可分であったことの意味を。",shape=box,color=blue];
		j685928042 -> j3207200468;
	j1921923843 [label="RellとHarrowが私の人生にこれほどまで揺るぎなく存在することが何を示すのか…",shape=box,color=blue];
		j1921923843 -> j964305015;
	j2588359528 [label="私のような人にとって、信仰心は「見つける」や「失う」ものではありません。永遠に疑問を持ち、永遠に答えを探し求めているので。",shape=box,color=blue];
		j2588359528 -> j1657183899;
	j1657183899 [label="しかし、痛みと同じように、強い信仰心の中で溺れたり、慣れすぎて麻痺したりしないよう、調和を保つ必要があると思います。",shape=box,color=blue];
		j1657183899 -> j1286686499;
