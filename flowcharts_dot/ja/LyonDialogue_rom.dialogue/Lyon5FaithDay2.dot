		j1277428542 -> j1257906171;
	j334907840 [label="昨日の会話の内容について考えていました。そして、RellとHarrowが私の人生にこれほどまで揺るぎなく存在することが何を意味するのかを。",shape=box,color=blue];
		j334907840 -> j1662665133;
	j3918700587 [label="ずっとあなたに話したいと思っていたことがあります。やっと話す機会が巡ってきました。Rell、Harrowそして私が絡み合うようになった時…　「どうして起きた」や「なぜそんなことになった」などは、あまり重要ではありません。",shape=box,color=blue];
		j3918700587 -> j299039593;
	"Chat ends." [color=orange];
	j2557020402 [label="彼らの存在は再び私の魂からもぎ取られ、記憶としてのみ残っています。もしかしたら…　ルアからの贈り物だったのかもしれません。",shape=box,color=blue];
		j2557020402 -> j3226087824;
	j1257906171 [label="彼らの存在は再び私の魂からもぎ取られ、記憶としてのみ残っています。おそらくあなたは正しい。この世に神は存在しないのかもしれません。",shape=box,color=blue];
		j1257906171 -> j3546792082;
	j1662665133 [label="彼らの存在は再び私の魂からもぎ取られ、記憶としてのみ残っています。それが神の存在を意味するのかどうか、私には分かりません。",shape=box,color=blue];
		j1662665133 -> j2651106201;
	j299039593 [label="彼らが私の過去に囚われたように、私も彼らの過去に囚われました。私には、Zariman Ten Zeroのすべて、古の大戦の断片などの記憶が蘇りました。彼らも同じように、私の過去を熟知しています。",shape=box,color=blue];
		j299039593 -> j483150529;
	j3226087824 [label="我らの銀の貴婦人が、悲劇的な祝福を与えるとは…　Roatheのように、苦痛の記憶を消し去られる必要はあるのでしょうか。",shape=box,color=blue];
		j3226087824 -> j3711192799;
	j3546792082 [label="しかし、この世界で善行をすることを根本とする組織に奉仕した私の年月は、決して揺るがない…",shape=box,color=blue];
		j3546792082 -> j1195856173;
	j2651106201 [label="おっしゃる通り…　決して知ることはないかもしれません。そして、無理に理解できることではないのかもしれません。この世界で善行をすることを根本とする組織に奉仕した私の年月は、決して揺るがない…",shape=box,color=blue];
		j2651106201 -> j1195856173;
	j483150529 [label="それは…　多くのことを疑わせるきっかけになりました。特に…　私の信仰心を。私の信仰心は、くしゃくしゃに崩れ落ち、焦げた紙のように塵と化したのです。こんな弱い人間でなかったはず…　",shape=box,color=blue];
		j483150529 -> j3287457751;
	j3711192799 [label="彼女は私の肉体から鞭の痛みを消し去ることもありませんでした。彼の死の悲しみから私を守るなど、彼女のやり方ではないのでしょう。",shape=box,color=blue];
		j3711192799 -> j919453386;
	j1195856173 [label="人生の苦難に溺れそうな時に、その痛みを和らげたいと願う人々を助けるため。",shape=box,color=blue];
		j1195856173 -> j1813821966;
	j3287457751 [label="Evaluate expressions",color=orange];
		j3287457751 -> j2787451975 [label="LyonDating",color=purple];
