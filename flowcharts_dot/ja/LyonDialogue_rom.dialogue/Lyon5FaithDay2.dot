		j3287457751 -> j3000719349 [label="false",color=purple];
	j919453386 [label="ソルなら熱いナイフで傷口を焼き放つように燃やし去るでしょうが、ルアは彼の不在がもたらす心の痛みの温かさを抱かせてくれるのです。",shape=box,color=blue];
		j919453386 -> j3496149117;
	j1813821966 [label="そして、もしまだRellとHarrowと交流できるなら、私が彼らを失った喪失感に苦しむことを望まないであろうと確信する。彼らは安らかな眠りにつけたのですから。",shape=box,color=blue];
		j1813821966 -> j3233198761;
	j2787451975 [label="Lyon。Lyonはとても辛い経験をしてきた。疑いは弱さから生まれるものではなく、痛みから生まれるものなんだ。",shape=box,color=red];
		j2787451975 -> j3761802369;
		j2787451975 -> j1857989159;
		j2787451975 -> j2487764212;
		j2787451975 -> j1137808823;
		j2787451975 -> j1580919084;
	j3025674274 [label="信仰は必ずしも一定である必要はない。そうも期待されていない。信仰心を失った人が再び見つけ出すという話は、そう稀なものではない。",shape=box,color=red];
		j3025674274 -> j3761802369;
		j3025674274 -> j1857989159;
		j3025674274 -> j2487764212;
	j2494944731 [label="Lyon。Lyonは人生をルミナリーズのために捧げてきた。こんな小さなことでLyonを追い出すことがあると思う？",shape=box,color=red];
		j2494944731 -> j3761802369;
		j2494944731 -> j1857989159;
		j2494944731 -> j2487764212;
	j1874942652 [label="自分には神が存在するか、しないかは分からない、Lyon。どんなに考えても真に知ることはないと思う。でも、Lyonが多くの苦難を乗り越えてきたことは確かだ。",shape=box,color=red];
		j1874942652 -> j3761802369;
		j1874942652 -> j2487764212;
		j1874942652 -> j1137808823;
	j2738687467 [label="個人的にはこの世に神は存在しないと思っている。でも、Lyonにとって、神は絶対的な存在であることは承知だ。軽視するつもりはない。",shape=box,color=red];
		j2738687467 -> j2487764212;
		j2738687467 -> j1580919084;
	j2742339382 [label="無関心のモノは自分たちの手によって作られた。奴は神ではない。Entratiの過ちによって、苦労する必要はない。Lyonの信仰心は…",shape=box,color=red];
		j2742339382 -> j2487764212;
		j2742339382 -> j1580919084;
	j3000719349 [label="くだらない話に巻き込まれて、凹んでいる姿を見るのは辛い。こんな目に遭うべきではなかった。",shape=box,color=red];
		j3000719349 -> j3761802369;
		j3000719349 -> j1857989159;
		j3000719349 -> j2487764212;
		j3000719349 -> j1137808823;
		j3000719349 -> j1580919084;
	j3496149117 [label="痛みの不在は私たちを破滅させる脅威です。痛みすぎると苦難に溺れてしまうかもしれないのと同じように。",shape=box,color=blue];
		j3496149117 -> j2378105887;
		j3496149117 -> j3407825523;
		j3496149117 -> j1683560455;
	j3233198761 [label="さらに…　私のこれまでの苦しみがすべて無駄なものだとも思いません。耐えてきたことすべてが、無益な試練であったとは思わない。",shape=box,color=blue];
		j3233198761 -> j1801914240;
	j3761802369 [label="信仰心を再び見つけ出すべきだと言っているんじゃない。もう一度興味が湧いたり、信仰し直したいと感じるなら、その時から学び直したらいいんじゃないか、と提案しているだけだ。",shape=box,color=red];
		j3761802369 -> j2713714483;
	j1857989159 [label="ルアはきっと、Lyonの苦悩を知り尽くしているはずだ。彼女の名の下に耐えてきたこと全部を。",shape=box,color=red];
		j1857989159 -> j570403706;
	j2487764212 [label="Lyonの一番の課題は、自分自身の中に何らかの平穏を見つけ出すことだ。どんな方法であっても…",shape=box,color=red];
		j2487764212 -> j2713714483;
	j1137808823 [label="もし神が存在するなら…　Lyonのルアが本当に存在するのなら、きっとLyonの苦悩を知り尽くしているはずだ。彼女の名の下に耐えてきたこと全部を。Lyonの苦悩はきっと、何か価値があることなんだろう。",shape=box,color=red];
		j1137808823 -> j570403706;
	j1580919084 [label="神が存在するかどうかという観念を捨てて、まず自分自身の傷を癒すことに取り組んだ方が良いと思う。",shape=box,color=red];
		j1580919084 -> j350908483;
	j2378105887 [label="信じて...　無関心がどれほど危険であるかを知っている。",shape=box,color=red];
		j2378105887 -> j3274459124;
