	84 [label="+10 Chemistry",color=orange];
		84 -> 89;
	85 [label="愛情への過剰な欲望は、肉や酒で満たされる飢えではないにせよ、暴食です。特に偽りをもって要求するとなるとなおさらです。",shape=box,color=blue];
		85 -> 90;
		85 -> 91;
	86 [label="そして鶏の軟骨や頭掻きと引き換えに、Marieに喜びをもたらしたことをDevereaux爺に感謝しました。",shape=box,color=blue];
		86 -> 92;
	87 [label="彼は動物だった。ただ単純に、食べ物、住処、愛…　充実感を求めていた。人間と同じ動機で動いていたわけじゃない。彼は「嘘」をついていたわけじゃなくて、人間とは違う道具を使って狩りをしていたんだ。",shape=box,color=red];
		87 -> 93;
	88 [label="自分は多くの暴力を見てきた。そのほとんどが自分で引き起こしたものだ。誰であろうと、何をしたかに関わらず、愛する人々に囲まれながら安らかに死ねることを願うようになった。",shape=box,color=red];
		88 -> 94;
	89 [label="私は奇妙にも…　その老猫が世界に自分の居場所を見つけたことに対して、尊敬しているのです。",shape=box,color=blue];
		89 -> 95;
	90 [label="ただの猫の話だ、Lyon。知ってやっていたとは思えない。",shape=box,color=red];
		90 -> 96;
	91 [label="猫の話、なんだよね？",shape=box,color=red];
		91 -> 97;
	92 [label="長話にお付き合いいただき感謝します。本日はここまでです。",shape=box,color=blue];
		92 -> 98;
	93 [label="Lyonたちを「利用」することで、彼は他者を否定したわけじゃない。むしろ…　彼の訪問によって、Lyonたちに歓喜を与えたようだ。",shape=box,color=red];
		93 -> 99;
	94 [label="なるほど。あなたは敵を軽蔑する人種と予想していましたが、愚かな偏見でした。違う時代と世界で、人がどう振る舞うかを勝手に決めつけていました。",shape=box,color=blue];
		94 -> 100;
	95 [label="この生き物は自分の状態、容姿、年齢、傷跡を、策略を見抜けない周囲の「愚か者」たちに対する武器として使ったのです。",shape=box,color=blue];
		95 -> 101;
	96 [label="足を引きずるフリは知っていましたが。",shape=box,color=blue];
		96 -> 84;
	97 [label="ご自由に解釈していただいて構いません、漂流者。",shape=box,color=blue];
