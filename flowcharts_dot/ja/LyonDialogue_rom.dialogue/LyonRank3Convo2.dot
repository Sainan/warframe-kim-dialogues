		64 -> 67;
	65 [label="+10 Chemistry",color=orange];
		65 -> 68;
	66 [label="「カーディナル・ディマンシュ」が置き去った悪魔に関する警告は多々あります。もしかしたらこれもその内の一つかもしれませんし、そうでないかもしれません。",shape=box,color=blue];
		66 -> 69;
	67 [label="ルミナリーズも私の精神が酷使されていることは承知しているでしょう。それでも、この話は私に対する警告なのでしょうか？　そうかもしれませんし、そうではないかもしれません。",shape=box,color=blue];
		67 -> 69;
	68 [label="いいえ、やめませんでした。それどころか、Marieは彼を「私の小悪魔」と呼んでからかって、より一層愛情を込めて迎え入れました。",shape=box,color=blue];
		68 -> 70;
	69 [label="単純な話、もし誰かが困っているように見えたら…",shape=box,color=blue];
		69 -> 71;
	70 [label="しかし、我々はもう彼のことで心配しませんでした。Devereaux爺は一匹でも生き残れたから。私たちを必要としていなかったから。",shape=box,color=blue];
		70 -> 72;
		70 -> 73;
	71 [label="+15 Chemistry",color=orange];
		71 -> 74;
	72 [label="その後Devereaux爺はどうなったの？",shape=box,color=red];
		72 -> 75;
	73 [label="必要としていないなら、なぜDevereaux爺は教会を訪れた？",shape=box,color=red];
		73 -> 76;
	74 [label="…爪がどれほど研ぎ澄まされているか確認をするように。",shape=box,color=blue];
		74 -> 77;
	75 [label="話の2年後、彼は再び失踪し、帰らぬものとなりました。",shape=box,color=blue];
		75 -> 78;
		75 -> 79;
	76 [label="皮肉な答えは「貪欲」でしょう。一度ご馳走を手に入れたなら、二度目がない理由はありません。十度目も。",shape=box,color=blue];
		76 -> 80;
		76 -> 81;
	77 [label="Chat ends.",color=orange];
	78 [label="祈ってあげたの？",shape=box,color=red];
		78 -> 82;
	79 [label="安らかに、愛されてこの世を去ったことを願うよ。",shape=box,color=red];
		79 -> 83;
	80 [label="皮肉じゃない答えは？",shape=box,color=red];
		80 -> 84;
	81 [label="彼が愛情だけを求めていたら、同じことを言える？",shape=box,color=red];
		81 -> 85;
	82 [label="彼の死を知った夜、彼のためにろうそくを灯し、ルアに彼の魂…　小悪魔を導いてくれるよう祈りました。",shape=box,color=blue];
		82 -> 86;
	83 [label="理由をお伺いしても？",shape=box,color=blue];
