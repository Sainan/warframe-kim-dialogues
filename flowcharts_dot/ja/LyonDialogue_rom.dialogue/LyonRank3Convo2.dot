		99 -> 103;
	100 [label="Add 1 to Thermostat",color=orange];
		100 -> 104;
	101 [label="まさにもつれた毛皮をまとった小悪魔。それでも私は彼が訪れる度に、いつものように撫でていました。",shape=box,color=blue];
		101 -> 105;
	102 [label="Chat ends.",color=orange];
	103 [label="そうかもしれません。それに鶏の軟骨も頭掻きも不足していませんでしたし。",shape=box,color=blue];
		103 -> 106;
	104 [label="ましてや、あなたのような特殊な生い立ちを持つ人であればなおさらです。 ",shape=box,color=blue];
