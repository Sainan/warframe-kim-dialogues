	41 [label="とは言え、この老猫の話は珍しいものではないかもしれないですし、あくまで私の体験談ですが、話の根本は同じです。",shape=box,color=blue];
		41 -> 43;
	40 [label="お気にせず。",shape=box,color=blue];
		40 -> 42;
	43 [label="この猫は毎日、私や彼を溺愛する他の兄弟姉妹に食べ物や愛情を乞うためにやって来ました。",shape=box,color=blue];
		43 -> 44;
	42 [label="Chat ends.",color=orange];
	44 [label="彼はいつもぼろぼろで、足を引きずり、耳の一部が欠けていました。",shape=box,color=blue];
		44 -> 45;
	45 [label="彼が数日間来なかった時、Marieは不安を隠せていませんでした。かと言って、最期を迎えたかもしれない路地裏の老猫のために我々ができるのは、ルアに祈りを捧げることだけでした。",shape=box,color=blue];
		45 -> 46;
	46 [label="Update boolean LyonStray",color=orange];
		46 -> 47;
		46 -> 48;
		46 -> 49;
	47 [label="[続けさせる]",shape=box,color=red];
		47 -> 50;
	48 [label="それって宗教的に大丈夫なの？　動物に祈りを捧げて。",shape=box,color=red];
		48 -> 51;
	49 [label="亡くなった野良猫に祈りを捧げるの？",shape=box,color=red];
		49 -> 52;
	50 [label="ある日、私が市場でパンを買っているときに、なんと屋台の主人の隣にその老猫が座っていたのです。",shape=box,color=blue];
		50 -> 53;
	51 [label="+10 Chemistry",color=orange];
		51 -> 54;
	52 [label="もちろん。私が出会った中で最も純粋で輝かしい魂は、獣の身体を持つものもいました。ルミナリーズがどのようにして彼らを導いたのかを判断するのは、私にはできません。",shape=box,color=blue];
		52 -> 55;
	53 [label="彼はいつものように、にごった鳴き声で私に挨拶し、軽々しく降りると私の足に体をこすりつけました。",shape=box,color=blue];
		53 -> 56;
	54 [label="良い質問です。一部の宗派では許されないでしょう。異端とみなされる場合も。でも我々の教会では許されています。動物にも魂があると信じています。",shape=box,color=blue];
		54 -> 55;
	55 [label="賢者聖Elizabethは動物に対する慈善活動で知られていましたが、多くの伝承では彼女をルミナリーズの使徒として認めていません。",shape=box,color=blue];
		55 -> 57;
	56 [label="そう、その時彼は足を引きずっていなかったのです。",shape=box,color=blue];
		56 -> 58;
	57 [label="果たして、我々の教えはこの未来にも残っているのでしょうか…　失礼、脱線してしまいました。",shape=box,color=blue];
		57 -> 59;
	58 [label="「おお、Devereaux爺のパトロンの一人かい」店主はパンを袋に詰めながら笑っていました。",shape=box,color=blue];
		58 -> 60;
	59 [label="Update boolean LyonLecture1",color=orange];
		59 -> 50;
	60 [label="結局、その老猫は我々や近所の人たちをたらし込んでいたそうです。飢えていたわけでも、体調を崩していたわけでも、放置されていたわけでもありませんでした。",shape=box,color=blue];
		60 -> 61;
	61 [label="そう、店主の言葉を鵜呑みにするならば、この猫は地元の鳥たちの天敵でもあったそうです。",shape=box,color=blue];
		61 -> 62;
		61 -> 63;
		61 -> 64;
	62 [label="そのDevereaux爺にエサを与えるのをやめたの？",shape=box,color=red];
		62 -> 65;
	63 [label="Roatheについて警告しようとしている？",shape=box,color=red];
		63 -> 66;
