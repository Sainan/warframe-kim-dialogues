digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank4Convo2 begins." [color=orange];
		"LyonRank4Convo2 begins." -> j3642908040;
		"LyonRank4Convo2 begins." -> j1716623257;
		"LyonRank4Convo2 begins." -> j738393015;
	j3642908040 [label="LyonとMarieは、司祭と修道女でありながら…　暴力行為を犯していいの？",shape=box,color=red];
		j3642908040 -> j3618562882;
		j3642908040 -> j1995891147;
		j3642908040 -> j1485706933;
	j1716623257 [label="Lyon、奇妙な質問していい？",shape=box,color=red];
		j1716623257 -> j2386225628;
	j738393015 [label="[閉じる]",shape=box,color=red];
		j738393015 -> "Chat ends.";
	j3618562882 [label="Marieが「païens」と叫びながら戦いに駆け出すのを聞いたんだ。でも、信念の違いを理由に人を非難するような人だと、到底思えない。Lyonもきっとそうだろう？　Marieは明らかにLyonのことを高く評価しているのだから。",shape=box,color=red];
		j3618562882 -> j3854286866;
	j1995891147 [label="LyonとMarieがここで行っていることについて、ルミナリーズはどう思うと思う？　教会の名において、時には戦いに出てることについて。",shape=box,color=red];
		j1995891147 -> j1626611531;
	j1485706933 [label="戦場で戦うMarieとLyonを見た後、Marieと一対一で会話したり、Lyonが静かに本を読んでいる光景を見ると…　違和感が多くて困惑する。",shape=box,color=red];
	j2386225628 [label="今の我々の苦境をただ「奇妙」としか言いようがないと思うなら、私はあなたの不屈の精神に感心するか、語彙力のなさに落胆するかのどちらかです。おそらく前者でしょう。",shape=box,color=blue];
		j2386225628 -> j1748460214;
	"Chat ends." [color=orange];
	j3854286866 [label="全くその通りです。Marieは、古代樹木の神を信じている者を非難するようなタイプではない。むしろ、自分と共通する信念は何かを追求するタイプだろう。",shape=box,color=blue];
		j3854286866 -> j4053960944;
	j1626611531 [label="かつてはソルやルアの名の下に多くの聖戦が繰り広げられました。血みどろの「十字軍」は「異教徒」を駆逐するため…　または「聖地を奪取するため」…　ある時には流行した理不尽な理由付けによって戦われることもありました。",shape=box,color=blue];
		j1626611531 -> j3277431932;
	j1748460214 [label="+5 Chemistry",color=orange];
		j1748460214 -> j2512081744;
	j4053960944 [label="その木はソルの光によって養われているのではないか。食事を分け合う共通の基盤ではないのだろうか。信仰のために彼らを傷付けるより、寄り添って彼らの話に耳を傾ける方が、彼女らしいだろう。",shape=box,color=blue];
		j4053960944 -> j833357999;
	j3277431932 [label="ルミナリー・オーソドキシーには軍隊がなく、戦争もありません。だが、同教団員が行動を起こしたり、他者を守ったりすることを禁じることはない。",shape=box,color=blue];
		j3277431932 -> j2392713843;
	j2512081744 [label="つまり、なにが言いたいかというと。質問することに問題はない。何について興味を持っているかを尋ねたことろで、これ以上「奇妙」なことは起きないのだから。",shape=box,color=blue];
		j2512081744 -> j3618562882;
		j2512081744 -> j1995891147;
		j2512081744 -> j1485706933;
	j833357999 [label="彼女が戦場で戦うとき、次の信念のうち一つであると、私は信じています。ソルの騎士の輝く鎖を身にまとった自分を想像しながら、古代の十字軍のように戦うのか…",shape=box,color=blue];
		j833357999 -> j2161716531;
	j2392713843 [label="Marieが戦場で戦うとき、次の信念のうち一つであると、私は信じています。ソルの騎士の輝く鎖を身にまとった自分を想像しながら、古代の十字軍のように戦うのか…",shape=box,color=blue];
		j2392713843 -> j2161716531;
	j2161716531 [label="あるいは、おそらく彼女はアスタフォール8章23節の「暴力によって私の家に入ろうとする魂は孤独です。彼らはソルの光から追放された者たちであります」という言葉を思い出しているのだろう。私の見解からでは、こちらの方が有力な理由だと認識している。",shape=box,color=blue];
		j2161716531 -> j2265272981;
	j2265272981 [label="彼女にしてみれば、より大きな善を守るという名目での正義により、戦いを正当だと理由づけている。漂流者もそうお思いであると推測し、戦場の仲間もそのように理由をつけていると理解している。",shape=box,color=blue];
		j2265272981 -> j551240291;
	j551240291 [label="それゆえ、彼女の戦い相手は、どの宗教に属すかに関わらず、ソルから追放される。たとえ彼女自身の教団の聖衣をまとっていたとしても、Marieにとって異教徒と映るのです。",shape=box,color=blue];
		j551240291 -> j3255959901;
		j551240291 -> j3807222751;
	j3255959901 [label="Lyonの動機には触れなかったけど、Lyonは戦いに関してどう思っている？",shape=box,color=red];
		j3255959901 -> j566830344;
	j3807222751 [label="なるほど。ありがとう。",shape=box,color=red];
		j3807222751 -> j929973906;
	j566830344 [label="漂流者よ、意図的に言葉を濁したのです。",shape=box,color=blue];
		j566830344 -> j3758469793;
		j566830344 -> j3074755184;
	j929973906 [label="+5 Chemistry",color=orange];
		j929973906 -> j1585643038;
	j3758469793 [label="あからさまにしつこく言っているんだけどな、神父さん。",shape=box,color=red];
		j3758469793 -> j4055239837;
	j3074755184 [label="わかった。教えてくれることだけで満足するようにする。",shape=box,color=red];
		j3074755184 -> j929973906;
	j1585643038 [label="一応言っておくと、Marieは…　あなたの気持ちは善意からくるものだと言っていました。私自身は信じないけれど、Marieは信じている。",shape=box,color=blue];
		j1585643038 -> j2224850998;
	j4055239837 [label="+10 Chemistry",color=orange];
		j4055239837 -> j1497861008;
	j2224850998 [label="私にできることは、皆さんの忍耐を乞うことだけです。ルアは、私がほとんど毎日、自分自身に対して忍耐が足りないことを熟知しているのです。",shape=box,color=blue];
		j2224850998 -> j2834389190;
	j1497861008 [label="承知いたしました。もしどうしてもと言うなら、どうしてそこまでして知りたいのか教えてください。私が引き起こす死は…　私自身、あまり戸惑うものではないのですが。",shape=box,color=blue];
		j1497861008 -> j3231781980;
	j2834389190 [label="-神父 Lyon Allard",shape=box,color=blue];
		j2834389190 -> "Chat ends.";
	j3231781980 [label="少なくとも、私のような聖職者や学者が行うべき、つまり…　「適切な」行動を基準にしても。",shape=box,color=blue];
		j3231781980 -> j3190565007;
		j3231781980 -> j4184011182;
	j3190565007 [label="Lyon、自分はこの人生を平和な世界より戦時中の世界を多く経験した。「あるべき」にこだわっていたら、今この場にいないだろう。だが、だからといって、戦争が苦悩や苦い代償を伴わないわけではない。",shape=box,color=red];
		j3190565007 -> j2293183603;
	j4184011182 [label="他の人から、自分が誰なのか、何者なのか、どこから来たのかを聞いていると思う。自分に付きまとう死、かつて経験した死。自分を定義づける死。Lyonの感情が自分を動揺させると思う？",shape=box,color=red];
		j4184011182 -> j1041630919;
	j2293183603 [label="Add 1 to Thermostat counter",color=orange];
		j2293183603 -> j3387177625;
	j1041630919 [label="Add -1 to Thermostat counter",color=orange];
		j1041630919 -> j1544888345;
	j3387177625 [label="はい。その通り。",shape=box,color=blue];
		j3387177625 -> j3369024309;
		j3387177625 -> j2574509528;
	j1544888345 [label="はい。動揺すると思います。",shape=box,color=blue];
		j1544888345 -> j3369024309;
		j1544888345 -> j2574509528;
	j3369024309 [label="ごめん。もし自分の発言で不快な思いをしたなら。そんなつもりはなかった。",shape=box,color=red];
		j3369024309 -> j3744046044;
	j2574509528 [label="説明してもらえるかな？",shape=box,color=red];
		j2574509528 -> j2359572244;
	j3744046044 [label="あなたのせいではありません、漂流者。私はリバタチアの仲間たちが言うように「何を考えているか分からない」人ですから。",shape=box,color=blue];
		j3744046044 -> j2033990359;
	j2359572244 [label="心の中で響き渡る恐怖は、もはや限界がありません。かつては鮮烈な紅潮を湛えていた人間の腱の鎖が、脆く黒ずんでいくのを目の当たりにします。",shape=box,color=blue];
		j2359572244 -> j4158643004;
	j2033990359 [label="ただ包囲された一個人に過ぎません。壁を守っているだけです。門を開けることは、防衛の完全性を脅かすことになりかねないので。",shape=box,color=blue];
		j2033990359 -> j3508393749;
		j2033990359 -> j41226216;
	j4158643004 [label="私自身の顔が十万も見えます。似てはいるが、どこか異質な顔が。空洞の棺桶、捻じ曲げられ、砕け散った人間の肉の死体が、生と死のベールに吊るされているのです。",shape=box,color=blue];
		j4158643004 -> j1072883542;
	j3508393749 [label="分かった。話す準備ができたら話そう。",shape=box,color=red];
		j3508393749 -> j1566281812;
	j41226216 [label="どういうこと？",shape=box,color=red];
		j41226216 -> j2359572244;
	j1072883542 [label="空虚な安息の仮面に包まれた表情。だが、彼らの魂の揺らめく残骸、消えることのない燃えさしの中で、彼らの叫び声が聞こえます。報復を求めて、自由を求めて、果てしなく吠え続けるさまが…",shape=box,color=blue];
		j1072883542 -> j2921542329;
	j1566281812 [label="この件に関しては選択の余地がないという明確な印象を受け始めています。",shape=box,color=blue];
		j1566281812 -> j254159992;
	j2921542329 [label="死のために。",shape=box,color=blue];
		j2921542329 -> j344889877;
	j254159992 [label="+15 Chemistry",color=orange];
		j254159992 -> j4143887432;
	j344889877 [label="これらの幻覚は、起きている間も私を悩ませます。私の夢。悪夢などありません。私が体験しているのは悪夢だけなのですから。悪夢が現実と重なり合うのですから。",shape=box,color=blue];
		j344889877 -> j1274675553;
	j4143887432 [label="だが、一応言っておくと、Marieは…　あなたの気持ちは善意からくるものだと言っていた。私自身は信じていないけれど、Marieは信じているようです。",shape=box,color=blue];
		j4143887432 -> j2639622810;
	j1274675553 [label="Check boolean LyonPainOff",color=orange];
		j1274675553 -> j2837355730 [label=true,color=green];
		j1274675553 -> j3824354778 [label=false,color=brown];
	j2639622810 [label="私にできることは、皆さんの忍耐を乞うことだけです。ルアは、私がほとんど毎日、自分自身に対して忍耐が足りないことを熟知しているのです。",shape=box,color=blue];
		j2639622810 -> j282291474;
	j2837355730 [label="私の魂の中に響くささやきに身を捧げたときのみ、世界はあなたにとって馴染み深いものと似た形で反映されます。",shape=box,color=blue];
		j2837355730 -> j156596806;
	j3824354778 [label="私の魂の中に響くささやきへの供物として肉体から肉を引き裂いたときにのみ、世界はあなたにとって馴染み深いものと似た形で反映されます。",shape=box,color=blue];
		j3824354778 -> j156596806;
	j282291474 [label="-神父 Lyon Allard",shape=box,color=blue];
		j282291474 -> j2522325746;
	j156596806 [label="漂流者よ、私が「感じている」ことを知っているふりを慎みたまえ。あなたの知識は浅はかなのだから。",shape=box,color=blue];
		j156596806 -> j3965990399;
		j156596806 -> j108725527;
		j156596806 -> j2923704362;
	j2522325746 [label="Boolean LyonVisions2d is now true.",color=orange];
		j2522325746 -> "Chat ends.";
	j3965990399 [label="ご、ごめん。知らなかったんだ。",shape=box,color=red];
		j3965990399 -> j3330269418;
	j108725527 [label="自分が見てきた恐怖と苦痛の多くも、Lyonが理解できないものだ。",shape=box,color=red];
		j108725527 -> j2136530968;
	j2923704362 [label="場違いな発言だったらごめん。ただ、知りたかったんだ。Lyonの幻覚のことを…",shape=box,color=red];
		j2923704362 -> j3576913823;
	j3330269418 [label="ええ、まあ。私は長年ずっと生き延びてきました。きっと、これからも耐えられるでしょう。心配は無用。",shape=box,color=blue];
		j3330269418 -> j4270520825;
	j2136530968 [label="ええ、そうでしょう。この場の画像にも反映されていますので。でもあなたは自分が至高の存在だと思うのですか？　あらゆる恐怖と苦しみを知り尽くした至高の存在だと？",shape=box,color=blue];
		j2136530968 -> j2583898414;
		j2136530968 -> j2145310760;
	j3576913823 [label="ええ、まあ。私は長年ずっと耐えてきました。きっと、これからも耐えられるでしょう。心配は無用。",shape=box,color=blue];
		j3576913823 -> j4270520825;
	j4270520825 [label="Boolean LyonVisions2a is now true.",color=orange];
		j4270520825 -> j2220349218;
		j4270520825 -> j3275009036;
	j2583898414 [label="表現しにくいけど、Lyonが体験していることは、思っている以上に共感できる自信がある。",shape=box,color=red];
		j2583898414 -> j305167783;
	j2145310760 [label="Lyon、自分はたくさんの死と恐怖を経験した。そのことで見下されるのは許せない。",shape=box,color=red];
		j2145310760 -> j2027952063;
	j2220349218 [label="説明していることは..　その幻覚はPROTOFRAMEになる前に始まったの？　それともその後の話？",shape=box,color=red];
		j2220349218 -> j3209973977;
	j3275009036 [label="他の機会にもう一度話そう。お願いだ。",shape=box,color=red];
		j3275009036 -> j4183633292;
	j305167783 [label="Boolean LyonVisions2b is now true.",color=orange];
		j305167783 -> j1689104212;
	j2027952063 [label="Boolean LyonVisions2c is now true.",color=orange];
		j2027952063 -> j1253257845;
	j3209973977 [label="もしそれが思っているほど容易に回答できる質問だったらどうでしょう。いずれにせよ、今日軽々しく回答できるものではありません。頭痛が開始しそうです。",shape=box,color=blue];
		j3209973977 -> j2779662554;
	j4183633292 [label="この件に関しては選択の余地がないという明確な印象を受け始めています。",shape=box,color=blue];
		j4183633292 -> j2779662554;
	j1689104212 [label="漂流者よ、私は同情を求めているのではない。そのことについて奇妙だと思われても構いません。求めているのは答えのみ。保証。全てが幻覚と嘘に過ぎない天空。",shape=box,color=blue];
		j1689104212 -> j3048547241;
		j1689104212 -> j3854257872;
	j1253257845 [label="それならば、足元にひれ状させていただきたい。耐え忍んできたすべてを讃えます。これまで目撃してきたすべてを目のあたりにしながら、正気でいられるのが不思議です。",shape=box,color=blue];
		j1253257845 -> j3043712844;
	j2779662554 [label="+10 Chemistry",color=orange];
		j2779662554 -> j3090111372;
	j3048547241 [label="できる限りのことをするよ。",shape=box,color=red];
		j3048547241 -> j1511405247;
	j3854257872 [label="自分が役に立つかもしれません。他の機会にもう一度話せますか？　お願いです。",shape=box,color=red];
		j3854257872 -> j4183633292;
	j3043712844 [label="自分の高貴な地位よりはるかに下と軽蔑している我々のために、まだ時間を割いていることに驚嘆します。",shape=box,color=blue];
		j3043712844 -> "Chat ends.";
	j3090111372 [label="だが、一応言っておくと、Marieは…　あなたの気持ちは善意からくるものだと言っていた。私自身は信じていないけれど、Marieは信じているようです。",shape=box,color=blue];
		j3090111372 -> j2224850998;
	j1511405247 [label="+5 Chemistry",color=orange];
		j1511405247 -> j1931859274;
