	j1667516410 [label="偽の地下墓地の状況は随分改善されたと言わざるを得ません。または、私の認識に問題があるのかもしれません。最近…　上の空な時があるので…",shape=box,color=blue];
		j1667516410 -> j1890799654;
	j3562358973 [label="偽の地下墓地の状況は随分改善されたと言わざるを得ません。あなたは彼に欲求未満の解消法を与えてきたのではないですか？",shape=box,color=blue];
		j3562358973 -> j2782992422;
	j1114164338 [label="あなたはRoatheにある種の保証、目的を与えました。彼を支援してくれたことに、これ以上ないほど感謝いたします。Marieもおそらく同じ思いでしょう。",shape=box,color=blue];
		j1114164338 -> j1525389993;
	j151516461 [label="残念ながら進歩はありません。あの哀れな獣は、近いうちに激怒のあまり自ら命を絶ってしまうかもしれません。",shape=box,color=blue];
		j151516461 -> j427242994;
