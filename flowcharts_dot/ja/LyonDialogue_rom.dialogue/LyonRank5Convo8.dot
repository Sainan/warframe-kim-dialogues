	j427242994 [label="Marieが先にその仕事をやり遂げなければ、ですけど…",shape=box,color=blue];
		j427242994 -> "Chat ends.";
	j2501152300 [label="あなたはRoatheにある種の自己反省を与えました。方向性も。彼を支援してくれたことに、これ以上ないほど感謝いたします。Marieもおそらく同じ思いでしょう。",shape=box,color=blue];
		j2501152300 -> j90808066;
	j258933358 [label="あなたはRoatheにある種の保証、目的を与えました。彼を支援してくれたことに、これ以上ないほど感謝いたします。Marieもおそらく同じ思いでしょう。",shape=box,color=blue];
		j258933358 -> j90808066;
	j3875465445 [label="彼にどのような運命が定まっているのかは不明です。知恵を絞って解決できることを祈っています。もしRoatheが長い間放置されたら、どんな結末を迎えることになるか不安で、不安で…",shape=box,color=blue];
