	j2303091596 [label="放浪者よ、お願いがあるのですが。",shape=box,color=blue];
		j2303091596 -> j2152867798;
		j2303091596 -> j738393015;
	j4087253387 [label="今まで不可能だと思っていたことを成し遂げたあなたをお褒めしたいのですが…",shape=box,color=blue];
		j4087253387 -> j79693109;
		j4087253387 -> j2335717276;
		j4087253387 -> j738393015;
	j1883982704 [label="Marieと「カーディナル」の件で、あなたの高貴でありながらも悲劇的に短命な努力を注ぐことになったのですが…　哀悼の意を表さなければなりません。",shape=box,color=blue];
		j1883982704 -> j2335717276;
		j1883982704 -> j79693109;
		j1883982704 -> j738393015;
	j375216352 [label="「カーディナル」の件で、あなたとMarieの意見が一致しなかったのは残念です。しかし、少なくとも殴り合いに発展しなかったのを称えたい。",shape=box,color=blue];
		j375216352 -> j2335717276;
		j375216352 -> j79693109;
		j375216352 -> j738393015;
	"Chat ends." [color=orange];
	j2152867798 [label="どうしたの？",shape=box,color=red];
		j2152867798 -> j2075448750;
	j738393015 [label="[閉じる]",shape=box,color=red];
		j738393015 -> "Chat ends.";
	j79693109 [label="言った言葉を取り返したい衝動に駆られるけど…",shape=box,color=red];
		j79693109 -> j1201213129;
	j2335717276 [label="Marieはもう、このこと全部話したの？",shape=box,color=red];
		j2335717276 -> j1146917006;
	j2075448750 [label="Marieにネクロマイトを使った家具の複製をやめるよう説得してください。この数の椅子を何に使おうとしているのか…　さっぱり分かりません。",shape=box,color=blue];
		j2075448750 -> j1203412187;
	j1201213129 [label="「情熱の犯罪」という言葉が生まれたのには正当な理由があります。もし私たち人間が自分の信念に固執しない生き物だったら、人生はひどく退屈なものになるのではありませんか。",shape=box,color=blue];
		j1201213129 -> j398796502;
	j1146917006 [label="ええ、話してくれました。私たちは毎晩、その日の出来事について話し合います。あなたとの会話が終えてからすぐ、Marieは駆け寄ってきて、話した内容を教えてくれました。",shape=box,color=blue];
		j1146917006 -> j2367574494;
		j1146917006 -> j3434154485;
	j1203412187 [label="+20 Chemistry",color=orange];
		j1203412187 -> j2874903993;
	j398796502 [label="確かに平穏で静かでしょう。しかし、退屈でもあります。話術も必要ない。",shape=box,color=blue];
		j398796502 -> j2967315184;
	j2367574494 [label="Marieは何て言ってた？",shape=box,color=red];
		j2367574494 -> j3495933037;
	j3434154485 [label="…それで？",shape=box,color=red];
		j3434154485 -> j3495933037;
	j2874903993 [label="Roatheの体内のどこに保管するべきなど、Marieの「多彩な」提案を拒否します。",shape=box,color=blue];
		j2874903993 -> "Chat ends.";
	j2967315184 [label="話が逸れてしましましたが…　あなたとの会話によって、Marieの心が動いたようです。あなたはMarieとの会話をどう捉えましたか。",shape=box,color=blue];
		j2967315184 -> j1424199455;
	j3495933037 [label="Check boolean LyonDating",color=orange];
		j3495933037 -> j1060261723 [label=true,color=green];
		j3495933037 -> j879878707 [label=false,color=brown];
	j1424199455 [label="Evaluate expressions",color=orange];
		j1424199455 -> j974918338 [label="MarieDating, MarieFamilyFail",color=purple];
		j1424199455 -> j502344259 [label="MarieDating, MarieFamilyFail",color=purple];
		j1424199455 -> j2510444814 [label="MarieFamilyFail",color=purple];
		j1424199455 -> j211458650 [label="MarieFamilyFail",color=purple];
		j1424199455 -> j974918338 [label="MarieFamilySuccess",color=purple];
		j1424199455 -> j612177881 [label="MarieEntratiCompleteA",color=purple];
		j1424199455 -> j2403681597 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j2272535562 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j1006134391 [label="MarieEntratiCompleteC",color=purple];
		j1424199455 -> j2070241540 [label="false",color=purple];
	j1060261723 [label="彼女の秘密を漏らすなど、断固お断りします。あなたは私にとって大切な存在です、mon miracle。しかし、Marieは長年の間、私の心の妹でした。",shape=box,color=blue];
		j1060261723 -> j3271024146;
	j879878707 [label="彼女の秘密を漏らすなど、断固お断りします。あなたは私にとって大切な存在です。しかし、Marieは長年の間、私の心の妹でした。",shape=box,color=blue];
		j879878707 -> j3271024146;
	j974918338 [label="満足している。Loidと上の階の家族の絆の修復にMarieの協力を仰ぐつもりだ。これは…　とても大きなステップだ。Lyon。どれほど大きな進歩か、言葉では言い表せない。",shape=box,color=red];
		j974918338 -> j768926042;
	j502344259 [label="あまり満足していない。正直に言って、少なくとも話が終わった時点で、Loidと上の階の家族の関係を修復するためにMarieに協力してもらうチャンスが台無しになったようだ。",shape=box,color=red];
		j502344259 -> j3822969340;
	j2510444814 [label="あまり満足していない。正直に言って、少なくとも話が終わった時点で、Loidと上の階の家族の関係を修復するためにMarieに協力してもらうチャンスが台無しになったようだ。",shape=box,color=red];
		j2510444814 -> j2918847969;
	j211458650 [label="満足している。Loidと上の階の家族の関係を修復する計画に協力してもらえないみたいだけど。それでも満足だ。",shape=box,color=red];
		j211458650 -> j3622335206;
	j612177881 [label="うん。Entratiが純粋な「善」ではないかもしれないと気づいてよかった。それに…　まあ、彼は純粋な「悪」でもないし。",shape=box,color=red];
		j612177881 -> j3401478003;
	j2403681597 [label="満足している。Entratiについては、正直なところ…　考えれば考えるほど、Marieの味方だ。",shape=box,color=red];
		j2403681597 -> j3622335206;
	j2272535562 [label="Entratiに関しては、どうしても意見が食い違った。納得できる説明ができなかったんだ。もっとうまく説得出来たらよかったんだけど。",shape=box,color=red];
		j2272535562 -> j1548265994;
	j1006134391 [label="Entratiについては「意見の相違を認める」ことにした。これ以上の妥協は考えられない。これ以上話し合っても事態は改善しない。",shape=box,color=red];
		j1006134391 -> j1993371385;
	j2070241540 [label="正直、大丈夫だ。今のところ、これ以上良くなることも悪くなることもない。",shape=box,color=red];
		j2070241540 -> j1993371385;
	j3271024146 [label="Marieから教えてもらったことは秘密です。しかし、あなたとの会話によって、心が動いたようです。あなたはMarieとの会話をどう捉えましたか。",shape=box,color=blue];
		j3271024146 -> j1424199455;
	j768926042 [label="規模はともかく、その壮大さは理解できると信じています。少しでも、この出来事に関われたことを光栄に思います。",shape=box,color=blue];
		j768926042 -> j4166207794;
		j768926042 -> j3035647612;
	j3822969340 [label="とても興味深い…　Marieはあなたの恋人なのですよね。この場で彼女を説得できる影響力を持つ人は、あなたしかいないはず。",shape=box,color=blue];
		j3822969340 -> j3080625399;
	j2918847969 [label="なんと興味深い…　私はMarieに対して、たとえ限定的であれ、ある程度の影響力をもっていることで知られています。Loid殿とEntratiの疎遠になった家族との関係を修復する必要があるとお考えですか。",shape=box,color=blue];
		j2918847969 -> j1729097890;
		j2918847969 -> j3379050709;
	j3622335206 [label="今おっしゃった言葉が不機嫌さ、傲慢さ、無知さ、それとも無関心さを表すのか、私には識別できません。ですから、この4つをすべて混合させた口調であると結論付けます。",shape=box,color=blue];
		j3622335206 -> j1789302362;
	j3401478003 [label="その通り。私もあなたと同じような視点です。一方に偏っているとは思いませんが、彼の動機は複雑だと認識しています。",shape=box,color=blue];
		j3401478003 -> j973240195;
	j1548265994 [label="ふむ。残念ながら、物事を諦めを得ない時が来ることもあるでしょう。生地を練り過ぎたり、画家が絵を書き込み過ぎたりするように…　議論にも、きっと潮時があるのでしょう。",shape=box,color=blue];
		j1548265994 -> j223524387;
	j1993371385 [label="そう。話題をもっと良い方向へ移した方が良いかもしれません。",shape=box,color=blue];
		j1993371385 -> j2919726545;
	j4166207794 [label="助けてくれるとは予想が付かなかった。",shape=box,color=red];
		j4166207794 -> j4071649951;
	j3035647612 [label="そう言ってくれるのは、つまり…　Loidを説得して上の階の人たちとの話し合いを手伝ってくれるということ？",shape=box,color=red];
		j3035647612 -> j1079694226;
	j3080625399 [label="彼女を口説こうとして、優先順位を間違ったゆえに、何らかの犠牲を払っていないことを願います。",shape=box,color=blue];
		j3080625399 -> j2973825246;
	j1729097890 [label="Lyon、この世には孤独が多すぎる。悲しみで溢れている。できるなら…　ほんの一握りでも助ける努力をしても罰が当たらない。",shape=box,color=red];
		j1729097890 -> j3863010897;
	j3379050709 [label="確信は持てないけど、本能、直感では修復した方が良いと思っている。Marie、RoatheとLyonが今、Entratiによってここにいるのは、何か理由があるような気がするから。",shape=box,color=red];
		j3379050709 -> j2425585542;
	j1789302362 [label="とても残念です。",shape=box,color=blue];
		j1789302362 -> j3497962379;
	j973240195 [label="傲慢さが彼を駆り立てたのでしょう。知識への貪欲。そして今、もしかしたら、許しへの貪欲さも…　彼自身も認識しているのかどうか、私には分かりかねます。",shape=box,color=blue];
		j973240195 -> j1832227504;
	j223524387 [label="この件に関してはもう、手放すことにします。そしていつかMarieは、私たちが知っているEntratiのありのままの姿…　せいぜい「複雑な人」…　を目にする機会がやってくるでしょう。",shape=box,color=blue];
		j223524387 -> j1832227504;
	j2919726545 [label="とにかく私は、素晴らしく欠点がない「カーディナル」のことを話し続けたくありません。",shape=box,color=blue];
		j2919726545 -> j1832227504;
	j4071649951 [label="愛想が良い人格でないことを承知していますが、別に悪党でもありません。私のお力添えが役に立つのなら…　お助けします。",shape=box,color=blue];
		j4071649951 -> j2800191596;
	j1079694226 [label="ええ。私のお力添えが役に立つのなら…　お助けします。",shape=box,color=blue];
		j1079694226 -> j2800191596;
	j2973825246 [label="もしそれが事実なら、何と残念な事態でしょう。",shape=box,color=blue];
		j2973825246 -> j1200495767;
	j3863010897 [label="ふむ。事実が明らかになった時、関係者内で傷を深めることになる可能性があってもですか。",shape=box,color=blue];
		j3863010897 -> j3635917403;
		j3863010897 -> j2775556088;
	j2425585542 [label="あなたは「直感」でEntratiの命令を実行する仕事を承っているのですか？",shape=box,color=blue];
		j2425585542 -> j3569740536;
		j2425585542 -> j2577245756;
	j3497962379 [label="Boolean LyonFamilyFail is now true.",color=orange];
		j3497962379 -> "Chat ends.";
	j1832227504 [label="Loid殿とエントラティの疎遠になった家族との絆が修復されるかどうか、誰にも分かりません。ただ、もしあなたが私の手助けを必要とするなら、必ず差し上げて頂戴いたします。とだけ、伝えておきます。",shape=box,color=blue];
		j1832227504 -> j2800191596;
	j2800191596 [label="Evaluate expressions",color=orange];
