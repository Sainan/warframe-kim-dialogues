	j3193436485 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j3193436485 -> j165831970;
	j1761132702 [label="ご放念ください。",shape=box,color=blue];
		j1761132702 -> j507116052;
		j1761132702 -> j155901254;
	j329838292 [label="また話が脱線してしまいました。先ほども述べました通り、時が来たらご協力します。時間と言えば…　そろそろお別れの時間です。",shape=box,color=blue];
		j329838292 -> j17394096;
	j3275751591 [label="認めるのは気が引けますが、Marieと私はこの建物に存在する機器の使い方をまったく理解していません。Roatheはその一方、難なく使いこなしているではないですか。",shape=box,color=blue];
		j3275751591 -> j1260857378;
