		j2800191596 -> j3019811655 [label="RoatheFamilyFail",color=purple];
		j2800191596 -> j554996064 [label="false",color=purple];
	j1200495767 [label="私の援助を提供しますが、役に立つのかは不明です。",shape=box,color=blue];
		j1200495767 -> j2256886096;
	j3635917403 [label="最初は確かに痛いと思うよ。骨折した骨のずれを直して正しい位置に戻すような痛み。でも骨折と同じで、きちんと治すためには、必要なステップなんだ。",shape=box,color=red];
		j3635917403 -> j1168940820;
	j2775556088 [label="全員が一緒にいることで得られるものは、離れていることによって失うものより大きいと信じている。",shape=box,color=red];
		j2775556088 -> j1168940820;
	j3569740536 [label="違う。助けを必要とする人々を守るのが仕事なんだ。彼らとこの場所を、ナルメルと感染体から永遠に守り続けることはできない。でも、MarieとLyonなら…　もしかしたらRoatheなら守り切ることが出来るかもしれない。",shape=box,color=red];
		j3569740536 -> j1168940820;
	j2577245756 [label="必ずしも彼を信用しているわけではない。でも彼が敵だとも思えない。争いが起きる気がする。そして、自分たちは、居るべき場所に、地図のようなボード上に配置されている。ここが自分たちの居場所なのだから。",shape=box,color=red];
		j2577245756 -> j747096271;
	j1720815859 [label="ただし、最も困難な課題である、Roatheの説得には成功したようですね。",shape=box,color=blue];
		j1720815859 -> j1260857378;
	j3019811655 [label="そうはいえ、Roatheの思考を変えるにはどうすればいいか。熟考しなければいけません…　良い案を生み出せるのでしょうか。鍵を握る彼が協力してくれないのなら、この案は徒労に終わる。",shape=box,color=blue];
		j3019811655 -> j3299520461;
		j3019811655 -> j4165842527;
	j554996064 [label="最も説得するのが難しいのは…　考えたくもないが…　複雑なのは、Roatheであろう。",shape=box,color=blue];
		j554996064 -> j3299520461;
		j554996064 -> j4165842527;
	j2256886096 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j2256886096 -> j4280312797;
	j1168940820 [label="+20 Chemistry",color=orange];
		j1168940820 -> j1996438152;
	j747096271 [label="ふむ。そうかもしれませんね。しかし、我々はチェスの駒ではないし、少なくとも私はそのような扱いを受けることを拒否する。もしEntratiがそのような訴えを起こしたいなら、忌々しい手紙を送ってくれればいい。",shape=box,color=blue];
		j747096271 -> j3824945754;
	j1260857378 [label="この忌々しい野郎は、彼の口をしっかり閉じる方法を見つけたいと心から願うのですが…　時に役に立つのです。",shape=box,color=blue];
		j1260857378 -> j3941867773;
	j3299520461 [label="そうだね…",shape=box,color=red];
		j3299520461 -> j1260857378;
	j4165842527 [label="どうしてRoatheが重要なんだ？",shape=box,color=red];
		j4165842527 -> j127460367;
	j4280312797 [label="- Lyon",shape=box,color=blue];
		j4280312797 -> j1933300832;
	j1996438152 [label="なるほど。賢明な言葉です。わかりました。Marieに話してみます。この件について、もう一度あなたと話せるよう説得できるか、確かめてみます。",shape=box,color=blue];
		j1996438152 -> j4159607781;
		j1996438152 -> j4252681169;
	j3824945754 [label="この点については、Loid殿の不満と同調してしまうのではないかと不安です。Loid殿を説得するためには私の協力が必要でしょうが、Marieが鍵を握ることになるでしょう。",shape=box,color=blue];
		j3824945754 -> j3193436485;
	j3941867773 [label="Check boolean RoatheDating",color=orange];
		j3941867773 -> j1761132702 [label=true,color=green];
		j3941867773 -> j329838292 [label=false,color=brown];
	j127460367 [label="Marieと私は部外者です。Roathe、Loid、Entrati、そしてエントラティのDaughterは皆同世代です。万が一事態が悪化した際に、Roatheは皆を守るために活用できる知識も備わっているからです。",shape=box,color=blue];
		j127460367 -> j3275751591;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j4159607781 [label="え、待って...　Lyonは...　彼女を説得して、家族の絆の修復を手伝ってくれるの？",shape=box,color=red];
		j4159607781 -> j1339652253;
	j4252681169 [label="え、ほんと？　本当に？",shape=box,color=red];
