		1486 -> 1487 [label="LyonPainOff",color=purple];
		1486 -> 1491 [label="LyonBackstory3a",color=purple];
		1486 -> 1490 [label="LyonBackstory3b",color=purple];
		1486 -> 1489 [label="LyonBackstory2",color=purple];
		1486 -> 1489 [label="LyonBackstory1",color=purple];
		1486 -> 1488 [label="false",color=purple];
	1487 [label="+20 Chemistry",color=orange];
		1487 -> 490;
	1491 [label="友よ、とても辛抱強く待ってくれただけではなく、通常求められる優しさ以上に優しく接してくれた。私の物語のある部分…　ルアが最も暗かった夜に起きた事件のことを不思議に思われたのではないでしょうか。",shape=box,color=blue];
		1491 -> 1493;
	1490 [label="友よ、とても辛抱強く待ってくれました。私の物語のある部分…　ルアが最も暗かった夜に起きた事件のことを不思議に思ったでしょう。",shape=box,color=blue];
		1490 -> 1493;
	1489 [label="友よ、私の過去が気になっていたのではありませんか。私の物語のこの部分…　ルアが最も暗かった夜に起きた事件のことを不思議に思ったでしょう。",shape=box,color=blue];
		1489 -> 1493;
	1488 [label="友よ、私の話を聞いた後、ルアが最も暗かった夜に起きた事件のことを不思議に思われたのではないでしょうか。",shape=box,color=blue];
		1488 -> 1493;
	490 [label="[トリガー警告が事前に設定されているため、会話をスキップしました]",shape=box,color=blue];
		490 -> 1492;
	1493 [label="決して口には出さないと誓った話です。Marieしか知りません。私の日記を盗み読みしていたようです。しかし、決心がつきました。お伝えいたします。",shape=box,color=blue];
		1493 -> 1495;
	1492 [label="Update boolean LyonConfession1",color=orange];
		1492 -> 1494;
	1495 [label="一度話を開始したら、中断する余地がありません。この話を繰り返し語ることは二度とありません。質問を承れなくても、ご容赦ください。",shape=box,color=blue];
		1495 -> 1499;
		1495 -> 1498;
		1495 -> 1497;
		1495 -> 1496;
	1494 [label="Chat ends.",color=orange];
	1499 [label="分かった。",shape=box,color=red];
		1499 -> 1503;
	1498 [label="[続けさせる]",shape=box,color=red];
		1498 -> 1502;
	1497 [label="[警告：自傷行為と児童虐待について触れます。この題材が苦手な方は、ここをクリックして会話を終了してください。Lyonとの好感度は下がりません。]",shape=box,color=red];
		1497 -> 1501;
	1496 [label="[閉じる]",shape=box,color=red];
		1496 -> 1500;
	1503 [label="感謝いたします。",shape=box,color=blue];
		1503 -> 1507;
	1502 [label="+5 Chemistry",color=orange];
		1502 -> 1503;
	1501 [label="Check boolean LyonSpeech",color=orange];
		1501 -> 1505 [label=true,color=green];
		1501 -> 1506 [label=false,color=brown];
	1500 [label="Update boolean LyonConfessionFail",color=orange];
		1500 -> 1504;
	1507 [label="Evaluate expressions",color=orange];
		1507 -> 1511 [label="LyonBackstory3a",color=purple];
		1507 -> 1511 [label="LyonBackstory3b",color=purple];
		1507 -> 1510 [label="false",color=purple];
	1505 [label="+20 Chemistry",color=orange];
		1505 -> 1508;
	1506 [label="この選択が臆病なものだと思っているなら、心配ありません。この問題は…　痛みは、あなたが直面するべき苦しみではありません。私個人の苦しみです。この瞬間を耐えることをあなたに望んいるのではない。",shape=box,color=blue];
		1506 -> 1509;
	1504 [label="Chat ends.",color=orange];
	1511 [label="私が自分の家族のこと、故郷の農場のこと、そして私を苦しめ、暴力へと駆り立てた幻覚のことを少しお話したことを覚えていますか。",shape=box,color=blue];
		1511 -> 1515;
	1510 [label="私を育ててくれた方について、あまり言及していないことを承知しています。実は…　今まで明かせられなかった理由があるのです。",shape=box,color=blue];
		1510 -> 1514;
	1508 [label="Update boolean LyonConfession1",color=orange];
		1508 -> 1512;
	1509 [label="私たちが利用しているこの機械は、覆い隠された非人格的な印象を与えます。誰かがそこに入力した言葉を通して私たちにもたらすであろうあらゆる危害から、何らかの形で守られているかのようです。",shape=box,color=blue];
		1509 -> 1513;
	1515 [label="別の部屋から聞こえてくる声に関してもお話ししたことを思い出してください。囁きながら、私を求める声。時にはまるで、私の名前を呼んでいるように聞こえたのです。",shape=box,color=blue];
		1515 -> 1518;
	1514 [label="私の母親は、私の幻視を悪魔の仕業と決め込み、私の体から鞭で叩き出そうとしました。何度も…　立ち上がれなくなるまで。",shape=box,color=blue];
		1514 -> 1517;
	1512 [label="Chat ends.",color=orange];
	1513 [label="わたしはむしろ、その逆を主張します。より日常的で社会的なやり取りで身を纏う鎖を脱ぐと、自分たちを守ってくれるかもしれないものを剥ぎ取られるのと等しい。",shape=box,color=blue];
		1513 -> 1516;
	1518 [label="時には、意味不明な言葉のように聞こえることもあったのです。解読できない言葉…　または悪魔のささやきのように…",shape=box,color=blue];
		1518 -> 1521;
	1517 [label="私の父親は…　ええ。母親の残酷さを超えて、酷いものでした。詳しい詳細は省かせていただきたい。",shape=box,color=blue];
		1517 -> 1520;
	1516 [label="したがって、このような状況では... 　私が放った矢は戦闘準備の整った兵士ではなく、森の中の何も知らない鹿の頸動脈に当たる可能性があるということをよく理解しています。",shape=box,color=blue];
		1516 -> 1519;
	1521 [label="当初は、意味不明な言葉が連発していることに恐怖を覚えました。どうか意味を理解させてくださいと懇願し、ルアの霊に、何を望んでいるのか教示してくれるよう祈り続けました。",shape=box,color=blue];
		1521 -> 1524;
	1520 [label="しかし、両親からの暴力は私自身の自傷に比べものになりませんでした。襲いよる幻視によって混乱する私は、成長に伴い対処できなくなったのでしょう。特に、父親より背が高く、体格も強くなった時にはなおさら…",shape=box,color=blue];
		1520 -> 1523;
	1519 [label="つきましては、次のことをお伝えします。",shape=box,color=blue];
		1519 -> 1522;
	1524 [label="しかし、その声が何を望んでいるか解き明かし始めた時、必死に祈ったことを後悔しました。その声が彼らの名において要求している行為を…",shape=box,color=blue];
		1524 -> 1526;
	1523 [label="幻視はしばしば幻聴に代わり、まるで私の名を呼んでいるかのように聞こえたのです。",shape=box,color=blue];
		1523 -> 1518;
	1522 [label="立ち上がる意志がないときでも、他の人を立ち上がらせる強さを見つける方法を自分自身に思い出させなければなりません。",shape=box,color=blue];
		1522 -> 1525;
	1526 [label="要求されていることを満たすとなると、両親はなんと恐ろしい代償を払うことになるのでしょう。",shape=box,color=blue];
		1526 -> 1528;
	1525 [label="それが物語の真の目的です。",shape=box,color=blue];
		1525 -> 1527;
	1528 [label="誤解しないでください。両親への愛情はその頃すでに存在しませんでした。幼いときに抱いていた家族への忠誠心は、幾重にも重なった傷跡の下に、とうの昔に消え去っていました。",shape=box,color=blue];
		1528 -> 1530;
	1527 [label="+20 Chemistry",color=orange];
		1527 -> 1529;
	1530 [label="しかし、幻聴の声が叫ぶ要求は…　その最も暗い夜に、成し遂げるよう命ざれた任務…",shape=box,color=blue];
		1530 -> 1532;
	1529 [label="肩を落とさないでください、漂流者。近いうちにまた話しましょう。",shape=box,color=blue];
		1529 -> 1531;
	1532 [label="そう命ざれている時、私はまだ若い少年でした。大人どころか、16歳？　18歳だったかもしれません。この要求が含まれている幻覚を見出した当初は、またしても恐ろしい悪夢、歪んだ夢だと認識したのを覚えています。",shape=box,color=blue];
		1532 -> 1534;
	1531 [label="-神父 Lyon Allard",shape=box,color=blue];
		1531 -> 1533;
	1534 [label="私の周りには、悪意と影によって生み出された、やつれて歪んだ姿の人影が立っていたので…",shape=box,color=blue];
		1534 -> 1536;
	1533 [label="Update boolean LyonConfession1",color=orange];
		1533 -> 1535;
	1536 [label="私を嘲り、信じられない案を要求しました。私のことを大切にしていると唱える人々が私の肉体を痛めつけるのなら、私も彼らの肉体を手に入れなければならないと…",shape=box,color=blue];
		1536 -> 1537;
	1535 [label="Chat ends.",color=orange];
	1537 [label="悪夢から目覚めたとき…　いや、もしかしたらずっと起きていたのかもしれません。今となっては、どちらが正しいの分からない…　私は狩猟用ナイフを手に持っていた。そして、両親の部屋の扉の前に立っていたのです…",shape=box,color=blue];
		1537 -> 1538;
	1538 [label="その夜…　新月の夜…　雲は厚く、かすかな光さえも届かないほど、暗闇は深かった… ",shape=box,color=blue];
		1538 -> 1539;
	1539 [label="ルアは私を見捨てたのです。",shape=box,color=blue];
		1539 -> 1540;
	1540 [label="私は、幻聴の呼びかけに応じることが出来ませんでした。両親の魂を手にし、捧げることが出来なかったのです。",shape=box,color=blue];
		1540 -> 1541;
	1541 [label="何もない夜空へと、逃げ出しました。深い森の中へ。枝が素肌を引き裂きましたが、痛みを感じる余裕はありませんでした。",shape=box,color=blue];
		1541 -> 1542;
	1542 [label="足がもつれだし、これ以上走り続けられなくなるまで全力で走りました。涙がこぼれていたかも思い出せません。",shape=box,color=blue];
		1542 -> 1543;
	1543 [label="しかし、幻覚は私を追い続け、なおも血を求めて囁き続けた…",shape=box,color=blue];
		1543 -> 1544;
	1544 [label="見えなくなったらこれ以上追われないと願い…　自分の眼球にナイフを突き刺した…",shape=box,color=blue];
		1544 -> 1545;
	1545 [label="残念ながら、気を失ってしまった私は、課題を終えませんでした。今となっては、知る由もありません。",shape=box,color=blue];
		1545 -> 1546;
	1546 [label="意識を取り戻した私は、地元のルア教区にいました。ある修道士が私を見つけ、手当てをしてくれたのです。彼は優しく、何から逃げようとしていたのか尋ねてくれました。",shape=box,color=blue];
		1546 -> 1547;
	1547 [label="酷く動揺していた私は、嘘をつくことが出来ませんでした。幻覚のこと、囁く声が何を求めているか…　非難される覚悟をして、全てを告白しました。",shape=box,color=blue];
		1547 -> 1548;
	1548 [label="話し終えると、その修道士はただ、悲しみを察したような微笑みを浮かべ、ルアのお守りを私の手に託しました。「ルアは祝福するだけではなく、同時に呪いでもあるんだ。我が息子よ」と。",shape=box,color=blue];
		1548 -> 1549;
	1549 [label="私はCité de la Lumièreに送り込まれ、大聖堂での生活を始めました。Entratiが来るまで、忠実に…",shape=box,color=blue];
		1549 -> 1550;
	1550 [label="これが、包み隠さずありのままの話です。",shape=box,color=blue];
		1550 -> 1551;
	1551 [label="これ以上お話しすることはありません。",shape=box,color=blue];
		1551 -> 1552;
	1552 [label="Update boolean LyonConfession1",color=orange];
		1552 -> 1553;
	1553 [label="+20 Chemistry",color=orange];
		1553 -> 1554;
	1554 [label="- Lyon",shape=box,color=blue];
		1554 -> 1555;
	1555 [label="Chat ends.",color=orange];
}