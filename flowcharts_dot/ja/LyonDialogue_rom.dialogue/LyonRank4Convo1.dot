	705 [label="でも、学ぶことに興味がないわけではない。",shape=box,color=red];
		705 -> 715;
	706 [label="Lyonは？",shape=box,color=red];
		706 -> 716;
	702 [label="我々の主な、そして最も一般的な祝日は、一年で最も日が短い冬至と最も長い夏至です。",shape=box,color=blue];
		702 -> 711;
	703 [label="何世紀にもわたり、様々な姿で現れ多くの信者を抱えてきました。時には男性、時には女性。しかし、常に太陽のソルと月のルアとして現れました。",shape=box,color=blue];
		703 -> 712;
		703 -> 713;
	714 [label="ルミナリー・オーソドキシーについて知りたいのでしょう？　退屈させないため、どこから始めますか？",shape=box,color=blue];
		714 -> 665;
		714 -> 664;
	717 [label="なるほど。信頼できる友人に話した方が有意義と。その気持ちはよくわかります。それに、今回は私からではなく、あなたから質問されているのです。",shape=box,color=blue];
		717 -> 704;
	718 [label="魂のステンドグラス。、バラバラだと混沌としているが、組み立てるとなんと美しい光景が浮かび上がることか。",shape=box,color=blue];
		718 -> 704;
	719 [label="世界があなたの信仰を共有すれば、良い世の中になるでしょう。",shape=box,color=blue];
		719 -> 704;
	715 [label="それに関しては、あなたの好奇心と学問的な性質を称賛します。",shape=box,color=blue];
		715 -> 704;
	716 [label="私の場合は…　複雑です。しかし恐怖がまったくないとは言いません。宗教を通じて多くの恐怖も得ましたし、消し去ることもありませんでした。",shape=box,color=blue];
		716 -> 704;
	711 [label="どちらの祝日も盛大な祝宴で彩られますが、誰と祝宴を共にするかによって区別されます。冬至は家族や親しい友人と祝うのに対し、夏至は見知らぬ人々と祝うのです。",shape=box,color=blue];
		711 -> 720;
		711 -> 721;
	712 [label="なるほど、わかりやすい。",shape=box,color=red];
		712 -> 722;
	713 [label="[続けさせる]",shape=box,color=red];
		713 -> 723;
	720 [label="へえ？　夏至について詳しく。",shape=box,color=red];
		720 -> 724;
	721 [label="冬至について詳しく。",shape=box,color=red];
		721 -> 725;
	722 [label="はい、宗派によっては、図像の選択に厳格で、ソルは「こうでなければならない」あるいは「ああでなければならない」と主張するところもありますが、オーソドキシーではその固執を事実として認めていません。",shape=box,color=blue];
		722 -> 726;
	723 [label="それぞれのルミナリーズは、複数の側面を内包しています。それぞれの側面は全体の機能として捉えることができます。例えば、ルアは母であり、乙女であり、老婆です。",shape=box,color=blue];
		723 -> 731;
	724 [label="夏至は、豊かな恵みを分かち合い、出会いを祝う日です。畑に集まり、食べ物や手作りの品々を持ち寄ります。どんなものでも構いません。",shape=box,color=blue];
		724 -> 728;
	725 [label="冬至は、寒さに耐え、暗い時に我々を温めてくれる人々を愛でる日です。ツリーをろうそくで飾り、空の星のように我々の道を導いてくれた先人たちに一つずつろうそくを灯します。",shape=box,color=blue];
		725 -> 729;
	726 [label="この遠い未来まで伝承されたものは…　多分、記録に混乱を生じたことでしょう。",shape=box,color=blue];
		726 -> 730;
	731 [label="しかしルアは魂を涙の川に沿って永遠の夜へと導く者でもあります。死神そのもの。先駆者、布告者。",shape=box,color=blue];
		731 -> 734;
	728 [label="ろうそく、パン、衣服、絵画、詩集、花輪など。たとえ何も持たずとも「喜ばしい知らせ」を持って来ることは、祝福とみなされます。",shape=box,color=blue];
		728 -> 732;
	729 [label="そしてツリーの頂上には、闇に沈む星樹の上で苦難に耐えるソル自身を飾ります。薄暗くなっても、忘れ去られてはいない。今はルアの時なのだから。そしてこの影の時代に、我々は彼女を讃える。",shape=box,color=blue];
		729 -> 733;
	730 [label="私はまるで生きた考古学的遺物みたいです。なんて憂鬱な。話を戻します。",shape=box,color=blue];
		730 -> 723;
	734 [label="ですが他の宗派では、死神はベールをかぶった老婆です。宗派によってその姿は異なりますが、皆に手を差し伸べる同じ霊を象徴しています。最後の瞬間に我々を導く銀の手。",shape=box,color=blue];
		734 -> 737;
	732 [label="人生を祝うこと、笑い、音楽を奏で、これらすべてを共有することで、ソルの最も長い日の始まりを告げるのです。",shape=box,color=blue];
		732 -> 735;
	733 [label="そして我々は近づき、焼いた鳥や根菜、凍てつく大地で新鮮に育たないあらゆるものを味わいながら、愛する人々を抱きしめます。そして亡くなった人々の物語を語り合います。",shape=box,color=blue];
		733 -> 736;
	737 [label="日食の時にに太陽の上を這う月は、すべてが失われる瞬間に我々を交差点に導きます。",shape=box,color=blue];
		737 -> 739;
	735 [label="誰もが見知らぬ人と新しい友達を作ったり、必要なものを持ち帰ったりすることが歓迎されました。",shape=box,color=blue];
		735 -> 738;
	736 [label="ルアの最も長い夜に、彼女が自身と家族を最後の瞬間に導いてくれることを思い出します。",shape=box,color=blue];
		736 -> 738;
	739 [label="Update boolean DrifterEclipse",color=orange];
		739 -> 741;
	738 [label="しかし、ルミナリーズにとって最も神聖な祝日は、至善の日です。これは、ソルとルアが並ぶ日食時のみ行われる行事です。",shape=box,color=blue];
