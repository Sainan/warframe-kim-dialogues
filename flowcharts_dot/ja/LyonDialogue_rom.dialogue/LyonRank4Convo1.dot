	701 [label="お互いの信仰がどれだけ影響を与え合ったか気になります。そしてそれが意図的か、そうでなかったか。",shape=box,color=blue];
		701 -> 704;
	698 [label="素晴らしい！　聖学者として、いつかお互いの信仰の共通点や違いについて語り合いたいです。",shape=box,color=blue];
		698 -> 704;
	695 [label="長い話だ。",shape=box,color=red];
		695 -> 707;
	696 [label="色んな宗教を研究して、どれもしっくりこなかった。最終的に、様々な人間性のツギハギになってしまった。",shape=box,color=red];
		696 -> 708;
	697 [label="自分が感じたものを信じている。それを教えてくれる建物や本はいらない。",shape=box,color=red];
		697 -> 709;
	690 [label="誠ですか？　驚きました…　驚きですが、嬉しくもあります。なら好奇心を抱くのも当然です。我々の教えはあなたが知るものとかけ離れているのでしょう。なんせ時代が違うのですから。",shape=box,color=blue];
		690 -> 704;
	691 [label="尊敬します。我々が知り得ないことを認識し、人間の小さな境遇に気づくことは、尊いことだと思います。",shape=box,color=blue];
		691 -> 704;
	692 [label="心配せずとも、気を悪くしていません。多くの場合、間違っていませんから。",shape=box,color=blue];
		692 -> 705;
		692 -> 706;
	693 [label="ベールの向こう側で何が待ち受けているのか、あなたたちが思い悩む理由を見出せないのが、羨ましく感じます。より多くの人がそれに気づいていれば、世界はもっと平和だったでしょう。",shape=box,color=blue];
		693 -> 704;
	694 [label="それに関してはまた日を改めて語り合いたいですが、未だ心の準備が整っていません。",shape=box,color=blue];
		694 -> 704;
	688 [label="よい着眼点です。祝祭日を通して文化を知ることは、その文化の心を知ることです。人々がどのように祝うかによって、彼らはどのように記憶されるかが決まります。なぜなら、それを共有する人々にとって最も大切な瞬間だからです。",shape=box,color=blue];
		688 -> 702;
	689 [label="もちろんです。まずは基礎知識から始めましょう。ソルとルア、つまり太陽と月です。彼らは永遠にその様相を変え続ける神々です。",shape=box,color=blue];
		689 -> 703;
	710 [label="ふむ。ではその好奇心に応えましょう。退屈させないため、どこから始めますか？",shape=box,color=blue];
		710 -> 665;
		710 -> 664;
	704 [label="話題から逸れてしまい申し訳ありません。本題から大きく離れてしまいました。",shape=box,color=blue];
		704 -> 714;
