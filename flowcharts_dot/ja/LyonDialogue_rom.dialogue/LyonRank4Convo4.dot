		j1584197471 -> j2054447663 [label="LyonFlirtIgnored",color=purple];
		j1584197471 -> j3749382333 [label="false",color=purple];
	j24887315 [label="いや、お許しください。この件に関して、私の反応があまりにも未熟だったことをお詫びします。",shape=box,color=blue];
		j24887315 -> j2883291450;
