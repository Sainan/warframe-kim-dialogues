		j1905875186 -> j2246204690;
	j3770365383 [label="時間の無駄ではない。Lyonのことをもっと知りたい。",shape=box,color=red];
		j3770365383 -> j1584197471;
	j1666455990 [label="じゃあ、いいよ。Lyonが話したくないなら。",shape=box,color=red];
		j1666455990 -> j24887315;
	j2246204690 [label="あなたにはもっと優先するべきことがあるのではないでしょうか。例えば…　侵略してくる敵から砦を防衛したり、未知の知識を発見したり…　衣服を整理したり。",shape=box,color=blue];
		j2246204690 -> j910359550;
