	j2730795620 [label="いくつの時の話？",shape=box,color=red];
		j2730795620 -> j1816327751;
	j3833952959 [label="Lyon。それは辛かった。",shape=box,color=red];
		j3833952959 -> j1947909114;
	j3241259969 [label="そんな…",shape=box,color=red];
		j3241259969 -> j1947909114;
	j3268757845 [label="母は無知だった。知識がなかったのです。",shape=box,color=red];
		j3268757845 -> j1947909114;
	j1816327751 [label="4歳…　遅くても6歳くらいかと。明確には覚えていません。その頃は、今のあなた達のように熱心に歳月を記録しませんでしたから。",shape=box,color=blue];
		j1816327751 -> j2698478763;
	j1947909114 [label="+5 Chemistry",color=orange];
		j1947909114 -> j2541076450;
	j2698478763 [label="Check boolean LyonPainOff",color=orange];
		j2698478763 -> j232439842 [label=true,color=green];
		j2698478763 -> j113853784 [label=false,color=brown];
		j2698478763 -> j232439842 [label=false,color=brown];
	j2541076450 [label="ここに来るために出発したとき、母は既に戻らなき人でした。今となってはただの塵です。悲惨な人生を歩んだ彼女。悲惨な運命を自ら歩むだけではなく、周りの人に広める人だったのです。",shape=box,color=blue];
		j2541076450 -> j3309925234;
	j232439842 [label="子供を傷つけるなんて…　許せない。",shape=box,color=red];
		j232439842 -> j1947909114;
	j113853784 [label="それだから…",shape=box,color=red];
		j113853784 -> j2933368378;
	j3309925234 [label="とても怯えていた人でした。私を苦しめるものは何であれ…　たとえ神の重荷であろうと、狂気であろうと、呪いであろうと、対処する能力が備わっていない人だったのです。",shape=box,color=blue];
		j3309925234 -> j4037254989;
	j2933368378 [label="Check boolean LyonLecture2",color=orange];
		j2933368378 -> j1853098780 [label=true,color=green];
		j2933368378 -> j104126153 [label=false,color=brown];
	j4037254989 [label="それほど残酷だった母を超えるのは…　私の父でした。詳細は、口にできるようなものではありません。",shape=box,color=blue];
		j4037254989 -> j4249766650;
	j1853098780 [label="おそらく。強制の一部ではないかと考慮する時があります。以前お伝えしたように、この試練もルアの方法の一つです。",shape=box,color=blue];
		j1853098780 -> j3177212418;
	j104126153 [label="おそらく。強制の一部ではないかと考慮する時があります。この試練もルアの方法。ルミナリーズのやり方なのでしょう。実践しているのは私だけに限ったことではありません。",shape=box,color=blue];
		j104126153 -> j713839702;
	j4249766650 [label="成長するにつれ、幻視は幻聴へも変わりました。四六時中囁かれる声。目覚めても夢を見ても続く…　農場での仕事に影響が出るだけではなく、苦悩で飲み込まれそうでした。",shape=box,color=blue];
		j4249766650 -> j254490114;
		j4249766650 -> j783235406;
	j3177212418 [label="+5 Chemistry",color=orange];
		j3177212418 -> j2496558651;
	j713839702 [label="+5 Chemistry",color=orange];
		j713839702 -> j1491534920;
	j254490114 [label="それだから大聖堂に送られたの？",shape=box,color=red];
		j254490114 -> j4013567020;
	j783235406 [label="親になる資格のない人もいる。",shape=box,color=red];
		j783235406 -> j374166189;
	j2496558651 [label="私にとって少しばかりの平穏をもたらせてくれると主張しますが、あなたには奇妙に見えておかしくはないかと存じます。",shape=box,color=blue];
		j2496558651 -> j4037254989;
	j1491534920 [label="大聖堂の他の神父が、私の心を清めるために指導してくれたのです。ルアに選ばれた者は、「幻視」によって「祝福」されることがありますから。",shape=box,color=blue];
		j1491534920 -> j2856337543;
	j4013567020 [label="Check boolean LyonPainOff",color=orange];
		j4013567020 -> j1078416325 [label=true,color=green];
		j4013567020 -> j2150485199 [label=false,color=brown];
	j374166189 [label="その気持ちは有難くいただきます。しかし、背が高くなり、体格も大きかった私を育児するのはどれだけ困難なものだったか…　親も親で苦労したのでしょう。",shape=box,color=blue];
		j374166189 -> j4013567020;
	j2856337543 [label="Boolean LyonLecture2 is now true.",color=orange];
		j2856337543 -> j4037254989;
	j1078416325 [label="漂流者よ、幻視や幻聴のせいで、よく激しい発作を起こしたのです。自分を苦しめることが、見えるものから目を覚ます唯一の方法だったのです。",shape=box,color=blue];
		j1078416325 -> j1559795171;
	j2150485199 [label="漂流者よ、幻視や幻聴のせいで、よく激しい発作を起こしたのです。自ら自分の身体を傷つけるしか目覚める方法がなかったので、刃物で自分の身体を切り刻むこともあったのです。",shape=box,color=blue];
		j2150485199 -> j1559795171;
	j1559795171 [label="しかしやがて、その声は私に指示を出すようになり…",shape=box,color=blue];
		j1559795171 -> j3146207230;
	j3146207230 [label="む、無理です。これ以上話すことを拒否します。お詫びします。この文章を打つだけで手が震えます。これ以上話せません。",shape=box,color=blue];
		j3146207230 -> j4275316082;
		j3146207230 -> j1647224997;
	j4275316082 [label="もちろん。大丈夫。急がなくていい。心の準備ができたら、また声をかけて。",shape=box,color=red];
		j4275316082 -> j3511384097;
	j1647224997 [label="もういいよ。辛い思いをしたんだね。ゆっくり休もう。それから…　話してくれてありがとう。話してくれただけで、大きな意味があると思う。",shape=box,color=red];
		j1647224997 -> j2490157559;
	j3511384097 [label="+10 Chemistry",color=orange];
		j3511384097 -> j3759071026;
	j2490157559 [label="+15 Chemistry",color=orange];
		j2490157559 -> j2046608752;
	j3759071026 [label="お礼を申し上げます。またの機会に話しましょう。",shape=box,color=blue];
		j3759071026 -> j179376269;
	j2046608752 [label="私も同感です。あなたが想像する以上に。お礼を言います、友よ。近いうちにまた話しましょう。",shape=box,color=blue];
