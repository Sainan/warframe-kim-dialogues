	j633220920 [label="怖かった？",shape=box,color=red];
		j633220920 -> j4033684002;
	j158260598 [label="この道に踏み出す決心をお持ちであれば、あなたを阻止しません。そして私は自分自身で思っているように…　不安定で…　異質なものだとお考えですか？",shape=box,color=blue];
		j158260598 -> j2175217852;
