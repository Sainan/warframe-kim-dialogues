		j2189182407 -> j692275016;
		j2189182407 -> j1747345303;
	j710306685 [label="かつて真夜中に、ベッドの足元に座っている老女の姿を見て目が覚めたことがあります。",shape=box,color=blue];
		j710306685 -> j322529874;
	j4033684002 [label="かつて真夜中に、ベッドの足元に座っている老女の姿を見て目が覚めたことがあります。",shape=box,color=blue];
