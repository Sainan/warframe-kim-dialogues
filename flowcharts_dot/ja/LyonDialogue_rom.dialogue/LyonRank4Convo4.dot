		j1711231969 -> j3651374799;
	j4003177433 [label="ただ、この想いが歓迎されるかどうかわからなかっただけ。 ",shape=box,color=red];
		j4003177433 -> j989363742;
	j2933913471 [label="このような幻視は、控えめに言っても、決して楽しいものではありません。",shape=box,color=blue];
		j2933913471 -> j665152679;
		j2933913471 -> j1809591160;
		j2933913471 -> j633220920;
	j372044799 [label="簡潔に言えば…　ええ、いや…　あなたの努力を拒絶するつもりではありません。ただ…　愛情に…　慣れていないのです、漂流者。どんな愛情にも。",shape=box,color=blue];
		j372044799 -> j158260598;
	j3651374799 [label="私もそう思います。本日の残りの一日がよい一日になりますよう、お祈りいたします。",shape=box,color=blue];
