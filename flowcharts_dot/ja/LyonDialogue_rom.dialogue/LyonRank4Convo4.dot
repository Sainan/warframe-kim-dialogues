		j1747345303 -> j3150264476;
	j997101448 [label="あなたは、開始した時と同じ熱意で追求を放棄した。誤った決断だったと正しく判断したと私は認識した。",shape=box,color=blue];
		j997101448 -> j1711231969;
		j997101448 -> j4003177433;
	j2246914398 [label="おそらくもうお気づきかと思いますが、幻視に見舞われるときがあります。幼いころからずっと。",shape=box,color=blue];
		j2246914398 -> j2933913471;
	j2329134230 [label="拒絶するつもりはありません。お互いの立ち位置が理解できてよかった。この件に関して、私の反応があまりにも未熟だったことをお詫びします。",shape=box,color=blue];
		j2329134230 -> j2883291450;
	j3150264476 [label="Boolean DrifterLyon is now true.",color=orange];
		j3150264476 -> j372044799;
