		j692275016 -> j260971543;
	j322529874 [label="とても痩せて弱々しく、すでに何年も前に亡くなって埋葬されていたのかもしれません。彼女の皮膚は骨にぴったりと張り付き、骨と骨の間の隙間が見えるほどでした。",shape=box,color=blue];
		j322529874 -> j537602473;
	j174340468 [label="とても痩せて弱々しく、すでに何年も前に亡くなって埋葬されていたのかもしれません。彼女の皮膚は骨にぴったりと張り付き、骨と骨の間の隙間が見えるほどでした。",shape=box,color=blue];
		j174340468 -> j2380859466;
	j3217459557 [label="この新しい道が何処へ繋がるのか…　慎重に期待している自分に驚いています。ああ、本日は、私の過去についてお尋ねだったのでしたね。",shape=box,color=blue];
		j3217459557 -> j2017096624;
	j260971543 [label="いや…　あなたの努力を拒絶するつもりではありません。ただ…　愛情に…　慣れていないのです、漂流者。どんな愛情にも。",shape=box,color=blue];
		j260971543 -> j158260598;
