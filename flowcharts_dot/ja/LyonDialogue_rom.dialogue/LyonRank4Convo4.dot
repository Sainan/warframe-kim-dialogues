		j3115630158 -> j3740065647;
	j2146922730 [label="その幻視から3か月経ったあと、村の女性が遺体で発見されました。両目はネズミに食い荒らされていたようです。",shape=box,color=blue];
		j2146922730 -> j1203648813;
	j3740065647 [label="その幻視から3か月経ったあと、村の女性が遺体で発見されました。両目はネズミに食い荒らされていたようです。",shape=box,color=blue];
		j3740065647 -> j3118219150;
	j1203648813 [label="幻視から目覚めた夜、私は母に見たものを話しました。村の女性の遺体が見つかった時、母もこの幻視の話を思い出したようです。",shape=box,color=blue];
		j1203648813 -> j410972541;
		j1203648813 -> j102719626;
	j3118219150 [label="そう、漂流者よ。あの幻視は恐ろしいものでした。",shape=box,color=blue];
		j3118219150 -> j1203648813;
	j410972541 [label="どれでどうしたの？",shape=box,color=red];
		j410972541 -> j3051367270;
	j102719626 [label="お母さんは、偶然と思った？　それとも何かの兆候だと思った？",shape=box,color=red];
		j102719626 -> j4074538062;
	j3051367270 [label="母は、私が立つことが出来なくなるまで殴り続けました。背中から血が流れ、うつ伏せでしか眠れなくなるほど。今でも殴りながら叫んでいる様子を思い出します。「Diable ! Sorcier !」と叫ばれながら。",shape=box,color=blue];
		j3051367270 -> j2730795620;
		j3051367270 -> j3833952959;
		j3051367270 -> j3241259969;
		j3051367270 -> j3268757845;
	j4074538062 [label="はっきり覚えていません。母は、私が立つことが出来なくなるまで殴り続けました。背中から血が流れ、うつ伏せでしか眠れなくなるほど。今でも殴りながら叫んでいる様子を思い出します。「Diable ! Sorcier !」と叫ばれながら。",shape=box,color=blue];
