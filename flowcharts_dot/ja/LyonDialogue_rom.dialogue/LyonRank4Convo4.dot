	j384011979 [label="+5 Chemistry",color=orange];
		j384011979 -> j1141106361;
	j2054447663 [label="もう進路は決定しましたか。それとも、私より神経がすり減っているだけですか？",shape=box,color=blue];
		j2054447663 -> j746294827;
		j2054447663 -> j3981864066;
	j3749382333 [label="+5 Chemistry",color=orange];
		j3749382333 -> j3836130755;
	j2883291450 [label="他人の経歴に興味を持ったり、友好的な態度を示したりという状況に置かれると、どう適切に反応したらよいのか、私には分かりません。",shape=box,color=blue];
		j2883291450 -> j3347707794;
	j2517908411 [label="+5 Chemistry",color=orange];
		j2517908411 -> j24887315;
	j1141106361 [label="ええ、そしてこの…　感情が私をますます不安にさせているのだと、認めざるを得ません。心の平安のため、あなたの本音が聞きたい。私をどんどん不安にすることを示しているのか確認させていただきたい。",shape=box,color=blue];
		j1141106361 -> j3928156040;
		j1141106361 -> j1747345303;
	j746294827 [label="さっき無視してごめん。",shape=box,color=red];
		j746294827 -> j997101448;
	j3981864066 [label="意味が分からない。",shape=box,color=red];
		j3981864066 -> j997101448;
	j3836130755 [label="正直なところ、あなたの言葉遣いには不安を感じます。ただ、私の解釈があなたのと同調するのかは不明です。",shape=box,color=blue];
		j3836130755 -> j3928156040;
		j3836130755 -> j1747345303;
	j3347707794 [label="いずれにせよ、私の過去を知りたいということで間違いありませんか。",shape=box,color=blue];
