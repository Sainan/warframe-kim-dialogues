	"KayaRank4Convo3 begins." [color=orange];
		"KayaRank4Convo3 begins." -> j79587202;
	j79587202 [label="あんたを信じるわ。",shape=box,color=blue];
		j79587202 -> j3611459251;
	j3611459251 [label="だからと言って、脱出路もなしにここにずっと居る気はないわ。",shape=box,color=blue];
		j3611459251 -> j825355788;
		j3611459251 -> j3348851391;
		j3611459251 -> j1866943380;
	j825355788 [label="お互いを信頼できるようになってうれしいよ。[閉じる]",shape=box,color=red];
		j825355788 -> j465934596;
	j3348851391 [label="その「脱出路」ってあとどれくらいでできそうなんだ？",shape=box,color=red];
		j3348851391 -> j3060416548;
	j1866943380 [label="何が決定打だった？",shape=box,color=red];
		j1866943380 -> j6761300;
	j465934596 [label="+20 Chemistry",color=orange];
		j465934596 -> "Chat ends. Next chat will be KayaRank4Convo4.";
	j3060416548 [label="あーまた明日聞いて？",shape=box,color=blue];
		j3060416548 -> j480802706;
	j6761300 [label="もう高校生なんて年じゃないってわかってる。",shape=box,color=blue];
		j6761300 -> j3930178933;
	"Chat ends. Next chat will be KayaRank4Convo4." [color=orange];
	j480802706 [label="本当にあと少しかもしれない、あとちょっとでモノになりそう。",shape=box,color=blue];
		j480802706 -> j3017392408;
		j480802706 -> j3453841222;
	j3930178933 [label="でも、あんたが皆を本当に大切にしてることは天才少女じゃなくたってわかる。みんな尊敬してる。",shape=box,color=blue];
		j3930178933 -> j1115452161;
	j3017392408 [label="1999年から抜け出せそうなのか？",shape=box,color=red];
		j3017392408 -> j4007711246;
	j3453841222 [label="手がかりは？",shape=box,color=red];
		j3453841222 -> j3416926766;
	j1115452161 [label="Arthurだってね。ちなみに彼超タイプ。",shape=box,color=blue];
		j1115452161 -> j1211137507;
	j4007711246 [label="そ！　もちろん、注意しなきゃいけない。一番安全で確実なのは、あんたが居た場所と*全く同じ*場所に行くこと、そこには「Voidの指紋」みたいなのがあるから。",shape=box,color=blue];
		j4007711246 -> j1451585784;
		j4007711246 -> j668375557;
		j4007711246 -> j2110513429;
	j3416926766 [label="もちろん、あんたよ。",shape=box,color=blue];
		j3416926766 -> j3489361880;
		j3416926766 -> j1858569963;
	j1211137507 [label="Check boolean ArthurDating",color=orange];
		j1211137507 -> j3386522668 [label=true,color=green];
		j1211137507 -> j4076078933 [label=false,color=brown];
		j1211137507 -> j1628697555 [label=false,color=brown];
	j1451585784 [label="じゃあ、本当にやるんだね？",shape=box,color=red];
		j1451585784 -> j2973535455;
	j668375557 [label="こっちの時代だって大してマシじゃないけど、手助けはできる。",shape=box,color=red];
		j668375557 -> j801742877;
	j2110513429 [label="確かに、Voidは指についてかなり執着している。",shape=box,color=red];
		j2110513429 -> j2299069912;
	j3489361880 [label="自分って特別な存在なんだな。",shape=box,color=red];
		j3489361880 -> j4007711246;
	j1858569963 [label="自分が？",shape=box,color=red];
		j1858569963 -> j4007711246;
	j3386522668 [label="彼が先約済みって知ってるよね？",shape=box,color=red];
		j3386522668 -> j1722229675;
	j4076078933 [label="いい評価を伝えておくよ。",shape=box,color=red];
		j4076078933 -> j973740267;
	j1628697555 [label="気持ち悪い。",shape=box,color=red];
		j1628697555 -> j1837466929;
	j2973535455 [label="もちろん。これは難題よ。なるようになる、でしょ？　何かに集中できるし…",shape=box,color=blue];
		j2973535455 -> j3435029400;
	j801742877 [label="その通り！　背水の陣よ！　突撃あるのみ！",shape=box,color=blue];
		j801742877 -> j465934596;
	j2299069912 [label="へ？",shape=box,color=blue];
		j2299069912 -> j2484298197;
	j1722229675 [label="プッ　知ってる、なんてラッキーなやつ！　まーそれはおいといてー",shape=box,color=blue];
		j1722229675 -> j3635934328;
	j973740267 [label="プッ　やめてよ、内緒で言ったんだから！　とにかく…",shape=box,color=blue];
		j973740267 -> j3635934328;
	j1837466929 [label="は？　マジで言ってんの？　キモくないし。とにかく！",shape=box,color=blue];
		j1837466929 -> j3635934328;
	j3435029400 [label="デメリットはないわ。理解するか、しないかだけ。ここで会うか、向こうで会うか。いいわね？　じゃ！",shape=box,color=blue];
		j3435029400 -> j465934596;
	j2484298197 [label="この事態、Entratiがやった全て。Voidへの探求、その本質も…　全部…",shape=box,color=red];
		j2484298197 -> j825437339;
	j3635934328 [label="でも高校物語みたいに、みんなあんたを敬っている。",shape=box,color=blue];
		j3635934328 -> j1505312822;
	j825437339 [label="指の話になるんだ。指一本の。",shape=box,color=red];
		j825437339 -> j4215464447;
	j1505312822 [label="それは多分人気ってだけじゃないんだろうね。",shape=box,color=blue];
		j1505312822 -> j390972160;
	j4215464447 [label="Arthurのビールでも飲んだの？　なんでもっと早く言わないの？",shape=box,color=blue];
		j4215464447 -> j3230877614;
		j4215464447 -> j3536838185;
		j4215464447 -> j1821058354;
	j390972160 [label="なんせみんなそれぞれの分野で狂っているから。",shape=box,color=blue];
		j390972160 -> j3454441962;
		j390972160 -> j3108305325;
		j390972160 -> j679119988;
	j3230877614 [label="Void。教科書に載ってるようなものじゃない。",shape=box,color=red];
		j3230877614 -> j2628055653;
	j3536838185 [label="ビールでもあれば少しは楽に理解できるかな。",shape=box,color=red];
		j3536838185 -> j2628055653;
	j1821058354 [label="それは「言及される」ものじゃない。それが終わりで始まりなんだ。",shape=box,color=red];
		j1821058354 -> j2628055653;
	j3454441962 [label="狂っていて忙しいさ！　チームへようこそ。[閉じる]",shape=box,color=red];
		j3454441962 -> j465934596;
	j3108305325 [label="この中で一番狂ってるの誰だと思う？",shape=box,color=red];
		j3108305325 -> j218627410;
	j679119988 [label="それって褒めてるの？",shape=box,color=red];
		j679119988 -> j1768740342;
	j2628055653 [label="でも指ってどういう意味？",shape=box,color=blue];
		j2628055653 -> j904733325;
		j2628055653 -> j3150952308;
	j218627410 [label="えええ…　ゴシップ？　あたしがあんだけ言った後で？",shape=box,color=blue];
		j218627410 -> j2023595276;
	j1768740342 [label="褒めてるわよ。100パーセント。ここでは誰も競争していない。",shape=box,color=blue];
		j1768740342 -> j1449001017;
	j904733325 [label="Albrechtはソレの指を持ってる。",shape=box,color=red];
		j904733325 -> j3376592300;
	j3150952308 [label="アレの、指一本が…　あるんだ。自分の時代に。世界に、か。",shape=box,color=red];
		j3150952308 -> j3376592300;
	j2023595276 [label="（でも、明らかにArthurね。前に話したとき、あんたがずいぶんArthurの頭の中かきまわしたみたいな口ぶりだったし）",shape=box,color=blue];
		j2023595276 -> j2829559467;
	j1449001017 [label="これってホント、妙なことよ。化け物になりかけてるのに、一番人間らしい感じがする。",shape=box,color=blue];
		j1449001017 -> j2825190983;
	j3376592300 [label="あ、じゃそれは保存されてるのね、オッケー！",shape=box,color=blue];
		j3376592300 -> j2148098491;
	j2829559467 [label="それはそうと、結果的に、あんたの肉体が1999年とどう結びついているかの仮説も裏付けたわ。",shape=box,color=blue];
		j2829559467 -> j372344237;
	j2825190983 [label="やっと自分らしくいられる。",shape=box,color=blue];
		j2825190983 -> j1514724338;
	j2148098491 [label="それだけ？",shape=box,color=red];
		j2148098491 -> j1390324469;
	j372344237 [label="それがなぜ重要かと言うと…　あ！　実験終わったみたい。続きはあとでね。",shape=box,color=blue];
		j372344237 -> j465934596;
	j1514724338 [label="もう怖くない。",shape=box,color=blue];
		j1514724338 -> j2124614167;
	j1390324469 [label="「何なのか」じゃなくて？　なぜ指があるのじゃなくて？",shape=box,color=red];
		j1390324469 -> j3389738871;
	j2124614167 [label="だから、ありがと？　ね。",shape=box,color=blue];
		j2124614167 -> j465934596;
	j3389738871 [label="それはそっちに任せるわ。物質の状態保持の方が興味深いわ。ありがとう！",shape=box,color=blue];
		j3389738871 -> j465934596;
}