	j400007183 [label="さぞ優秀な学生だったんだろう。",shape=box,color=red];
		j400007183 -> j1991714381;
	j904459823 [label="謙遜する必要なんてない。高校で歴代一位だったし大学一年目だって百年来の成績だもん。",shape=box,color=blue];
		j904459823 -> j2980249215;
		j904459823 -> j2660922982;
	j3395078759 [label="「Nora Night」って知ってる？",shape=box,color=blue];
		j3395078759 -> j1577866278;
		j3395078759 -> j3964837860;
	j1991714381 [label="高校で歴代一位だったし大学一年目だって百年来の成績だった。",shape=box,color=blue];
		j1991714381 -> j2357503963;
	j2980249215 [label="それでもケーキが焼けるとは限らないだろう。お菓子作りを学びでもしない限り。",shape=box,color=red];
		j2980249215 -> j501885110;
	j2660922982 [label="Entratiの血清を注射しないほど賢くはないけど、ね？",shape=box,color=red];
		j2660922982 -> j3558488063;
	j1577866278 [label="多分、でも彼女は自分のことを確実に聞いたことがあると思う。",shape=box,color=red];
		j1577866278 -> j1467216146;
	j3964837860 [label="えっ、すごい。自分の時代の人だ",shape=box,color=red];
		j3964837860 -> j1467216146;
	j2357503963 [label="あたしはただの優秀な学生じゃない。いろんな大学から誘いだって受けてたの。完璧な一年目を過ごすはずだった…",shape=box,color=blue];
		j2357503963 -> j477882181;
