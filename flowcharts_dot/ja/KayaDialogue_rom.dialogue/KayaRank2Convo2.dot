	j501885110 [label="Boolean KayaCake is now true.",color=orange];
		j501885110 -> j2923602233;
	j3558488063 [label="笑？　どの面下げて言うの？　おやおや「Entratiセンセーのお気に入り」じゃない。みーんな噂してたわ",shape=box,color=blue];
		j3558488063 -> j1777120084;
		j3558488063 -> j3827092145;
	j1467216146 [label="んーー、いいわ。時間に割り込んで音波を受信できる方式を編み出したの！",shape=box,color=blue];
		j1467216146 -> j800564536;
	j477882181 [label="もし…　今の状況がなければ？",shape=box,color=red];
		j477882181 -> j4098782075;
	j1341368122 [label="もし…　Entratiがいなければ？",shape=box,color=red];
		j1341368122 -> j4098782075;
	j2923602233 [label="は、超ウケる。ケーキを焼く程度の簡単なこともできないってホントに思ってるの？",shape=box,color=blue];
		j2923602233 -> j3618577842;
	j1777120084 [label="責め立てるために話を盛っているね。どうして？",shape=box,color=red];
		j1777120084 -> j2397967779;
	j3827092145 [label="煽っているの？",shape=box,color=red];
		j3827092145 -> j2397967779;
	j800564536 [label="だからたまに聴いているの。彼女とは気が合いそう。",shape=box,color=blue];
		j800564536 -> j3391128297;
	j4098782075 [label="あのクソバカインターネットさえなければ。",shape=box,color=blue];
		j4098782075 -> j1702491805;
		j4098782075 -> j164269681;
	j3618577842 [label="ちょうどいい気晴らしね。待ってなさい。",shape=box,color=blue];
		j3618577842 -> j2906669224;
	j2397967779 [label="人気者もいいことばかりじゃないわよ。皆が失敗を手ぐすねを引いて待っていたら？　頂点にいるってことは、みんながいつか引きずりおろそうとしてるってことよ。",shape=box,color=blue];
		j2397967779 -> j245498816;
		j2397967779 -> j78193924;
	j3391128297 [label="最初は理論をまとめて、物質の形態に割り込んでみようかな、安全を考えて生き物以外で。",shape=box,color=blue];
		j3391128297 -> j766782545;
