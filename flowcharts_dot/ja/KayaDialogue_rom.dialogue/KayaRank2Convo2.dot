	j3053016816 [label="ここのやりかたを知らないっていう言い訳をしてきそうだから、先に説明しとくわよ。",shape=box,color=blue];
		j3053016816 -> j1380650965;
	j3878250716 [label="でも本当は自分がラジオ消し忘れただけじゃない？",shape=box,color=red];
