	j3858178725 [label="ミックス？　ケーキでも焼いているの？",shape=box,color=red];
		j3858178725 -> j2365390794;
	j937164211 [label="研究は順調そう、だね？",shape=box,color=red];
		j937164211 -> j3620111957;
