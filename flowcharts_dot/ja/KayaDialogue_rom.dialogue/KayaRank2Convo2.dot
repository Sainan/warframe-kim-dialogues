	j2583648148 [label="ねぇ。ちょっと確認したいことがあるんだけど？",shape=box,color=blue];
		j2583648148 -> j914341642;
	j914341642 [label="あんたのタイムトラベル能力は、テクノサイトとVoidを一定割合でミックスしたこと、が鍵なの？",shape=box,color=blue];
