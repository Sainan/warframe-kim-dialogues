digraph {
	"KayaRank3Convo1 begins." [color=orange];
		"KayaRank3Convo1 begins." -> j2981243411;
	j2981243411 [label="あんたが誰に似ているか、今思い出したわ。 ",shape=box,color=blue];
		j2981243411 -> j1209496772;
	j1209496772 [label="大学一年の時にペアになった生徒。",shape=box,color=blue];
		j1209496772 -> j2561229719;
	j2561229719 [label="Check boolean KayaCake",color=orange];
		j2561229719 -> j1692420867 [label=true,color=green];
		j2561229719 -> j2501549900 [label=false,color=brown];
		j2561229719 -> j3584926287 [label=false,color=brown];
	j1692420867 [label="え。それっていい意味で？",shape=box,color=red];
		j1692420867 -> j2258095631;
	j2501549900 [label="すごく魅力的で優秀な学生？",shape=box,color=red];
		j2501549900 -> j2112950490;
	j3584926287 [label="喧嘩にならないように身構えているよ…",shape=box,color=red];
		j3584926287 -> j4192351652;
	j2258095631 [label="いい意味で。",shape=box,color=blue];
		j2258095631 -> j4233291784;
	j2112950490 [label="キモ。悪いけど、ナンパとかはしないの。絶対。",shape=box,color=blue];
		j2112950490 -> j2326875641;
	j4192351652 [label="えっ、違うわよ、もう。これはハッピーな思い出なの。",shape=box,color=blue];
		j4192351652 -> j1087280415;
		j4192351652 -> j1249684027;
	j4233291784 [label="あんたに間違いを認めさせるためにケーキ焼いてたの。",shape=box,color=blue];
		j4233291784 -> j1990045193;
	j2326875641 [label="特にインターネット上ではね。",shape=box,color=blue];
		j2326875641 -> j359203149;
		j2326875641 -> j3359494611;
	j1087280415 [label="そう言うなら。",shape=box,color=red];
		j1087280415 -> j2295434476;
	j1249684027 [label="あまり沢山は持ってないみたいだね。",shape=box,color=red];
		j1249684027 -> j169306448;
	j1990045193 [label="そうしたら、以前あたしのためにケーキを焼いてくれたシャイな子のことを思い出したの。",shape=box,color=blue];
		j1990045193 -> j502170;
	j359203149 [label="もしそうしたいと思っていたら？",shape=box,color=red];
		j359203149 -> j4009557827;
	j3359494611 [label="おいおい。悪かった、悪かったよ。",shape=box,color=red];
		j3359494611 -> j853171902;
	j2295434476 [label="これはあたしの誕生日についてだけど、あたしの話じゃないの。",shape=box,color=blue];
		j2295434476 -> j1192520663;
	j169306448 [label="じゃあ一つ教えてあげるわ！",shape=box,color=blue];
		j169306448 -> j2295434476;
	j502170 [label="一度も仲よくしたことないのに、どうやってかあたしの誕生日を知っていた。",shape=box,color=blue];
		j502170 -> j703414217;
	j4009557827 [label="絶対にあり得ないわ。",shape=box,color=blue];
		j4009557827 -> j2013445877;
	j853171902 [label="二度とやらないで。",shape=box,color=blue];
		j853171902 -> j1984869718;
	j1192520663 [label="まあちょっとはそうかも。言っとくけど前は皆あたしと居たがるような人気者だったのよ。",shape=box,color=blue];
		j1192520663 -> j88530464;
	j703414217 [label="それでバニラアイシングのかかったバニラケーキを持ってきたんだけど、それがマジ三段重ねぐらいに高くて。",shape=box,color=blue];
		j703414217 -> j1722725015;
	j2013445877 [label="+5 Chemistry",color=orange];
		j2013445877 -> "Chat ends. Next chat will be KayaRank3Convo2.";
	j1984869718 [label="やらないって約束する。",shape=box,color=red];
		j1984869718 -> j2118457896;
	j88530464 [label="成績が、それこそ頭抜けてて。チアリーダー部のキャプテンで。みんなあたしの誕生日パーティーに招待されるかどうか気にしてた。",shape=box,color=blue];
		j88530464 -> j583474388;
	j1722725015 [label="でさあ、そのケーキ持ってるの見たのよ。正直ウゲってなって、ほかの誰かにケーキ受け取ってるの知られたらっマズいって。だって違うスクールカーストだったのよ。",shape=box,color=blue];
		j1722725015 -> j2337149047;
	"Chat ends. Next chat will be KayaRank3Convo2." [color=orange];
	j2118457896 [label="Boolean KayaFlirtPromise is now true.",color=orange];
		j2118457896 -> j3487888324;
	j583474388 [label="とにかく、その生徒はあたしに誕生日ケーキを焼いてきて、誰ともシェアせずに家で食べてっていうわけ。",shape=box,color=blue];
		j583474388 -> j4113158623;
	j2337149047 [label="成績優秀、それにチアリーダー部のキャプテンだった。みんなあたしの誕生日パーティーに招待されるかどうか気にするくらい人気だった。",shape=box,color=blue];
		j2337149047 -> j583474388;
	j3487888324 [label="いいわ。",shape=box,color=blue];
		j3487888324 -> j583474388;
	j4113158623 [label="いやまあ正直かなり怪しんだわよね、最初あんたと話したみたいに。それでケーキ切ろうとキッチンナイフ入れた時、固いものにぶつかったの。",shape=box,color=blue];
		j4113158623 -> j2319195108;
	j2319195108 [label="キモいっしょ？　半端なくキモい。でも中をみたらケーキの底にプラ容器が隠してあって、中にはあたしの大好きなジニモンカードパックが封されてたの。",shape=box,color=blue];
		j2319195108 -> j3389014218;
	j3389014218 [label="あたしみたいな子がこんなの持ってるって学校の連中にバレたら社会的に死ぬから。でもあの内気な子はあたしが好きなのに気づいて、本当に喜ぶプレゼントを作って、でも外面はデカいケーキであたしの気を引きたいとかなんかそういうフリしてたの。",shape=box,color=blue];
		j3389014218 -> j3090809834;
		j3389014218 -> j2027283666;
		j3389014218 -> j4286286602;
	j3090809834 [label="ケーキを焼いてあげる気はないよ。",shape=box,color=red];
		j3090809834 -> j1163940315;
	j2027283666 [label="天才少女という触れ込みのわりには本題にたどり着くまで時間かかるね…",shape=box,color=red];
		j2027283666 -> j112294482;
	j4286286602 [label="それがどうやってこっちに繋がるんだ？",shape=box,color=red];
		j4286286602 -> j3697036780;
	j1163940315 [label="+20 Chemistry",color=orange];
		j1163940315 -> j363313798;
	j112294482 [label="大いなる未来からの来訪者って触れ込みの割には要点がつかめてないわね。ジニモンカードよ！　あたしが！　信じられる？",shape=box,color=blue];
		j112294482 -> j2298746259;
		j112294482 -> j395099463;
	j3697036780 [label="だから、あんたにジニモンカードを集めてるって言うことで、あたしなりに信頼してるって言いたいの。ジニモンカードって普通負け犬がやるものだから。",shape=box,color=blue];
		j3697036780 -> j1035743312;
	j363313798 [label="ハーハハハ！",shape=box,color=blue];
		j363313798 -> j1849881961;
	j2298746259 [label="それが何なのかそもそも知らない！",shape=box,color=red];
		j2298746259 -> j3612266221;
	j395099463 [label="それって、何か、特別なコレクターアイテムみたいなもの？",shape=box,color=red];
		j395099463 -> j3612266221;
	j1035743312 [label="少なくともそう思ってたわ。でもホントの負け犬はそれ以外の皆よ。 ",shape=box,color=blue];
		j1035743312 -> j3402732021;
		j1035743312 -> j1738983169;
		j1035743312 -> j3038007876;
	j1849881961 [label="焼いたところで失敗作でしょ。",shape=box,color=blue];
		j1849881961 -> j4146105832;
		j1849881961 -> j3551675046;
	j3612266221 [label="要するに子供向けのモンスターカードゲームで、遊んでるのは負け犬とかよ、特に大学でなら確実にそう。",shape=box,color=blue];
		j3612266221 -> j1035743312;
	j3402732021 [label="いつかジニモンカードを見せてくれる？",shape=box,color=red];
		j3402732021 -> j2167014;
	j1738983169 [label="すごい、タイムトラベルの話をまったくしないで会話が成り立った！",shape=box,color=red];
		j1738983169 -> j1167676627;
	j3038007876 [label="心を開いてくれたってこと？　新鮮だね！",shape=box,color=red];
		j3038007876 -> j3393719380;
	j4146105832 [label="多分そうなるだろう。",shape=box,color=red];
		j4146105832 -> j1738217194;
	j3551675046 [label="なんとかなるだろう。",shape=box,color=red];
		j3551675046 -> j1738217194;
	j2167014 [label="気が向いたらね。",shape=box,color=blue];
		j2167014 -> j1895387827;
	j1167676627 [label="じゃーん！",shape=box,color=blue];
		j1167676627 -> j1895387827;
	j3393719380 [label="これに慣れないでよ。多分。知らんけど。",shape=box,color=blue];
		j3393719380 -> j1895387827;
	j1738217194 [label="そうねそーね！",shape=box,color=blue];
