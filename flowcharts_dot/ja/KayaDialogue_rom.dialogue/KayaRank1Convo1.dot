		"Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j1330064704 [label="ヘックスの誰かが解明したりしてない？　誰か情報持ってない？",shape=box,color=blue];
		j1330064704 -> j3639927541;
		j1330064704 -> j3332627443;
	j4252658415 [label="おっけ。",shape=box,color=blue];
		j4252658415 -> j2547432773;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j3639927541 [label="Amirとか？　多分時間旅行が出てくるゲームをやったことあるだろうし…",shape=box,color=red];
		j3639927541 -> j63446627;
	j3332627443 [label="そうは思わないね、お嬢ちゃん。もし実用的なものを学びたいならLettieにメディック初級コースでも習えばいい。",shape=box,color=red];
		j3332627443 -> j1106163443;
	j63446627 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j63446627 -> j3874092439;
	j1106163443 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j1106163443 -> j4288530697;
	j3874092439 [label="ゲーム？　答えでも、方向性でもいいから、何でもいいの。なんとか解くわよ。何か「役に立ちそう」なものがあれば、教えて。",shape=box,color=blue];
		j3874092439 -> j2547432773;
	j4288530697 [label="なにそれ。まじありえない。",shape=box,color=blue];
