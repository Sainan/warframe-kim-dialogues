digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j3887183305;
	j3887183305 [label="やあ。誰でも時間旅行できるの、それともあんただけ？",shape=box,color=blue];
		j3887183305 -> j1792732743;
		j3887183305 -> j3305116220;
	j1792732743 [label="ごきげんよう。いいかいお嬢ちゃん、そんな単純な話じゃない。",shape=box,color=red];
		j1792732743 -> j2298984209;
	j3305116220 [label="こんにちは？　Kayaなの？　調子はどう。",shape=box,color=red];
		j3305116220 -> j4254152149;
	j2298984209 [label="お嬢ちゃんはやめて。もう19歳よ。",shape=box,color=blue];
		j2298984209 -> j705988090;
		j2298984209 -> j110884512;
	j4254152149 [label="普通。",shape=box,color=blue];
		j4254152149 -> j4249438286;
	j705988090 [label="そうか。グループの最年少で、お嬢ちゃん、だと思うけど。",shape=box,color=red];
		j705988090 -> j2109220049;
	j110884512 [label="はいはい、時間旅行の話は急かさないでくれ。これは…　複雑なトピックなんだ。",shape=box,color=red];
		j110884512 -> j1558076053;
	j4249438286 [label="それで。あんただけなの？　未来じゃ時間旅行は学校で習うの？",shape=box,color=blue];
		j4249438286 -> j3809237604;
	j2109220049 [label="ふん。確かに最年少だけど、答えを見つけるやる気が一番あるのよ。ついてこれるならついてきなさいよ。で。タイムトラベル、どうやって、誰に話せばいい？",shape=box,color=blue];
		j2109220049 -> j482783704;
	j1558076053 [label="ふーん。どんだけ複雑なの？　構造式？　化学式、それとも原子レベル？　自分で調べるから方向性だけ教えて。",shape=box,color=blue];
		j1558076053 -> j2832860950;
		j1558076053 -> j1485608721;
	j3809237604 [label="自分だけと言っておこう。そのほうが単純だ。",shape=box,color=red];
		j3809237604 -> j2304693978;
	j482783704 [label="それでどうしてあんたができるの？　何か方法があるの？",shape=box,color=blue];
		j482783704 -> j968628046;
	j2832860950 [label="なんて言えばいいかわからないけど。これは単なる科学の領域じゃなくて、Entratiが理解する科学の体系なんだ。",shape=box,color=red];
		j2832860950 -> j282050810;
	j1485608721 [label="「止める」っていう方向性はどうかな。[閉じる]",shape=box,color=red];
		j1485608721 -> "Chat ends.";
	j2304693978 [label="学校の教育については、もしそうだったら習ってない。でも教えてたのかも？",shape=box,color=red];
		j2304693978 -> j3693673355;
	j968628046 [label="ないなら、あんたの能力を科学的に説明する方法を調べるのに何かおススメある？",shape=box,color=blue];
		j968628046 -> j2395048661;
	j282050810 [label="げ、あのクソ野郎。確かにもっと訊いとくべきだったね。オッケー。まあ科学なら再現性はあるはずだし、あんたがこうやって行き来できてるんだし、解明できるっしょ。じゃね。",shape=box,color=blue];
		j282050810 -> j2547432773;
	"Chat ends." [color=orange];
	j3693673355 [label="何、宿題でも欲しいのか？　時間旅行はこの時代にはまだ少し難しいかもね…",shape=box,color=red];
		j3693673355 -> j813542;
	j2395048661 [label="質問が多いね、お嬢ちゃん。悪いけど、わからない。わかってるのはEntratiだけ。",shape=box,color=red];
		j2395048661 -> j2298011835;
	j2547432773 [label="+20 Chemistry",color=orange];
		j2547432773 -> "Initiate conversation HexKayaConvo1 in HexDialogue_rom.dialogue";
	j813542 [label="はぁ、それマジで言ってる？",shape=box,color=blue];
		j813542 -> j1330064704;
	j2298011835 [label="Boolean KayaSetKid is now true.",color=orange];
		j2298011835 -> j4252658415;
