		822 -> 823 [label=false,color=brown];
	824 [label="一番の後悔の話とか？",shape=box,color=red];
		824 -> 827;
	825 [label="例えばどういうの？　そっちが選んで。",shape=box,color=red];
		825 -> 828;
	823 [label="じゃあ…　Kalymosの話はどう？",shape=box,color=red];
		823 -> 826;
	827 [label="うーんわかったわ。それって何？",shape=box,color=blue];
		827 -> 832;
		827 -> 833;
		827 -> 834;
	828 [label="んんーじゃあ…　あたしの最初のペットの話？",shape=box,color=blue];
		828 -> 835;
	826 [label="あーうん、Kalymosもいいけど。でもあたしは犬派なの。犬と一緒に育ったから。また会えたらいいのに。",shape=box,color=blue];
		826 -> 829;
		826 -> 830;
		826 -> 831;
	832 [label="Albrechtからもっと要求すべきだったこと。",shape=box,color=red];
		832 -> 838;
	833 [label="Ballasをもっと早く止められなかったこと。",shape=box,color=red];
		833 -> 839;
	834 [label="自分自身を諦めたこと。",shape=box,color=red];
		834 -> 840;
	835 [label="でもこれはインターネットのハッカーがよく聞く質問の一つだから、その…　誰にも言わないでよ。",shape=box,color=blue];
		835 -> 841;
	829 [label="お悔やみを。話はここまでにしよう。[閉じる]",shape=box,color=red];
		829 -> 836;
	830 [label="そうなのか…　そのペットについて教えて。",shape=box,color=red];
		830 -> 837;
	831 [label="自分もペットを亡くしたことがある。名前は？",shape=box,color=red];
		831 -> 837;
	838 [label="結局あれだけのことをしても、また逃げられてしまった。",shape=box,color=red];
		838 -> 844;
	839 [label="どうすれば状況を変えられたのかわからない。",shape=box,color=red];
		839 -> 845;
	840 [label="他の人がどう見てるかなんて関係ない。自分を、ほかの何者以上に憎んでいた頃がある。",shape=box,color=red];
		840 -> 846;
	841 [label="でも彼の名前はZyloよ。あんたならクブロウと言うのかな。",shape=box,color=blue];
		841 -> 847;
	836 [label="+20 Chemistry",color=orange];
		836 -> 842;
	837 [label="ずるいわ実際。Entratiは飼ってる化け猫と一緒にタイムトラベルしてるって？",shape=box,color=blue];
		837 -> 843;
	844 [label="自分に何かを教えようとしてるのは分かるけど、あのクソ野郎はそのために自分をどんな状況に追い込んだのかわかってない。",shape=box,color=red];
		844 -> 849;
	845 [label="でも、一分でも早く辿り着いていれば、苦しんだ人は減ったはずだった。",shape=box,color=red];
		845 -> 850;
	846 [label="死ぬことすらできなかった。できたらよかったのに。",shape=box,color=red];
		846 -> 851;
	847 [label="デッカいよ、想像できる一番大きい犬よ。多分Volkovだって真っ二つに噛み切れると思うわ。",shape=box,color=blue];
		847 -> 852;
		847 -> 853;
	842 [label="Chat ends. Next chat will be KayaRank5Convo3.",color=orange];
	843 [label="もしZyloが一緒だったら…　この旅はずっと楽だっただろうね。",shape=box,color=blue];
		843 -> 848;
	849 [label="自分だけじゃない。皆、全員だ。Loid、Gomaitruも…　吐き気がするよ。もし彼を見つけたら自分を抑えられる自信がない。",shape=box,color=red];
		849 -> 851;
	850 [label="Ballasは恐怖そのものだ。生命そのものの中で最悪。",shape=box,color=red];
		850 -> 851;
	851 [label="そういう風に言われると…　人生も人間も単に時々クソなんだろうね、違う？",shape=box,color=blue];
		851 -> 855;
	852 [label="自分がやってきたところにだって大きなクブロウはいるよ！",shape=box,color=red];
		852 -> 856;
	853 [label="えーどうだろうか、Volkovはかなりタフだけど。",shape=box,color=red];
		853 -> 857;
	848 [label="Zyloはあたしが泣いてるのを初めて見た生き物なの。",shape=box,color=blue];
		848 -> 854;
	855 [label="でもまあ時には素晴らしいわ。",shape=box,color=blue];
		855 -> 859;
	856 [label="えーマジヤバい…　行かなきゃいけない理由が増えたじゃん。もう！",shape=box,color=blue];
		856 -> 860;
	857 [label="確かに、そうかもね…　でもとにかく、大きくていかついZylo。でもあたしを一生懸命守ってくれた。",shape=box,color=blue];
		857 -> 848;
	854 [label="5歳の時なんだけど、覚えてる限りあたし絶対泣かなかったのよね。",shape=box,color=blue];
		854 -> 858;
	859 [label="人は一番後悔してることで自身を定義できないんでしょうね。あたしもあんたのおかげでそれを乗り越えられたし。",shape=box,color=blue];
		859 -> 862;
	860 [label="Zyloは全力であたしを守ってくれた。 ",shape=box,color=blue];
		860 -> 848;
	858 [label="でも小学校一年生の初日の日に、家に帰るとZyloがいたの。",shape=box,color=blue];
		858 -> 861;
	862 [label="でも起きた出来事は変えたくないと思う。",shape=box,color=blue];
		862 -> 865;
	861 [label="部屋までついてきて、泣いてる間ドアを守ってくれた。",shape=box,color=blue];
		861 -> 863;
		861 -> 864;
	865 [label="だって、あたし嫌いじゃないもん。Novaを。いままで一番カッコイイでしょ。",shape=box,color=blue];
		865 -> 868;
	863 [label="何故泣いたんだ？",shape=box,color=red];
