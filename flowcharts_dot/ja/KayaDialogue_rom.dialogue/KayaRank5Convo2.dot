		864 -> 867;
	868 [label="何も変えようと思わないのか？",shape=box,color=red];
		868 -> 871;
	866 [label="太ってるって言われたから。",shape=box,color=blue];
		866 -> 869;
	867 [label="忘れるわけないでしょ！？",shape=box,color=blue];
		867 -> 870;
	871 [label="何一つも。あんたもそうしてくれると嬉しいんだけど。",shape=box,color=blue];
		871 -> 874;
	869 [label="子供のころそれ言われたらクラスの落ちこぼれよ。",shape=box,color=blue];
