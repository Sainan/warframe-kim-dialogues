digraph {
	819 [label="KayaRank5Convo2 begins.",color=orange];
		819 -> 820;
	820 [label="今回は*Novaに*タイムトラベルについて訊くってのはどう？",shape=box,color=red];
		820 -> 821;
	821 [label="やだ。別の話にしましょ、ね！　いい？",shape=box,color=blue];
