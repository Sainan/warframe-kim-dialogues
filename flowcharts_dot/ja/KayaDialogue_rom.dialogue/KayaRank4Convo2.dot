		j3580046859 -> j409085106;
	j409085106 [label="ニュースの話題にだってなったのよ。写真を共有すると決めたのはあたし自身なのに被害者ぶってるって、皆はあたしを嘲笑った。",shape=box,color=blue];
		j409085106 -> j921356594;
	j921356594 [label="学生データベースであたしの名前を調べるときは皆必ず「オキニ」つまり「ふしだらな先生のお気に入り」のことを思い浮かべてるのよ。",shape=box,color=blue];
		j921356594 -> j1369686464;
	j1369686464 [label="いつかあんたたちもその写真を見つけて、誰も二度と同じ目で見てくれない。尊敬とか全部…　消えてしまうの",shape=box,color=blue];
		j1369686464 -> j349927285;
	j349927285 [label="ここから抜け出さないといけない、前に進まないといけない、この全部を置き去りにしていけるほど賢いあたしがいる時間と場所へ",shape=box,color=blue];
		j349927285 -> j310250696;
		j349927285 -> j1114415556;
		j349927285 -> j1169515265;
	j310250696 [label="自分から言うことは何もないよ。皆後悔するようなことはしたことがある。",shape=box,color=red];
