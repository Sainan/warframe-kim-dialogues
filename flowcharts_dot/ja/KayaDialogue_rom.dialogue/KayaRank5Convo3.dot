	j453973988 [label="おおー、やあ、ジニモンカードの基本を教わる気はない？",shape=box,color=blue];
		j453973988 -> j2925295484;
	j2925295484 [label="Amirはやっと一緒にプレイする（そして負ける）相手ができて大喜びだったわ。",shape=box,color=blue];
		j2925295484 -> j4275146918;
	j4275146918 [label="それで、あんたにジニモンを紹介したら楽しいだろうって二人で思ったわけ。",shape=box,color=blue];
		j4275146918 -> j4022770608;
		j4275146918 -> j1238857104;
		j4275146918 -> j2268124287;
	j4022770608 [label="二人で遊んでくれ。こっちは忙しい。[閉じる]",shape=box,color=red];
		j4022770608 -> j145506587;
	j1238857104 [label="余ったホラーズがあるけど、なにから始めるの？",shape=box,color=red];
		j1238857104 -> j1741836476;
	j2268124287 [label="えっと…　何の話だっけ？",shape=box,color=red];
		j2268124287 -> j1703631893;
	j145506587 [label="+20 Chemistry",color=orange];
		j145506587 -> "Chat ends. Next chat will be KayaRank5Convo4.";
	j1741836476 [label="オーーーケイ、よし！　そうね、じゃあまず自分に焦点を当てて。あんたは自分がドラゴン、イーグル、パンサーのどれだと思う？",shape=box,color=blue];
		j1741836476 -> j1562866;
		j1741836476 -> j1317232472;
		j1741836476 -> j3343817701;
	j1703631893 [label="1999年に一番人気な番組で、ゲームで、コレクター商品よ！",shape=box,color=blue];
		j1703631893 -> j2672305763;
	"Chat ends. Next chat will be KayaRank5Convo4." [color=orange];
	j1562866 [label="パンサー。",shape=box,color=red];
		j1562866 -> j388871162;
	j1317232472 [label="イーグル。",shape=box,color=red];
		j1317232472 -> j1880110053;
	j3343817701 [label="ドラゴン。",shape=box,color=red];
		j3343817701 -> j2761864903;
	j2672305763 [label="超カッコイイキャラとかクリーチャーとかそういうの…",shape=box,color=blue];
		j2672305763 -> j2824595830;
	j388871162 [label="オッケー。じゃあ絶対にテイララでゲームを始めるべきね",shape=box,color=blue];
		j388871162 -> j2288216053;
	j1880110053 [label="オッケー。じゃあ確実にプルームベルトでゲームを始めるべきね",shape=box,color=blue];
		j1880110053 -> j2964038830;
	j2761864903 [label="オッケー。じゃあ多分フロゴボゴでゲームを始めるべきね。",shape=box,color=blue];
		j2761864903 -> j154813968;
	j2824595830 [label="それは置いておいて。とにかく、まずあんたからね。自分から見てあんたはドラゴン、イーグル、それともパンサー？",shape=box,color=blue];
		j2824595830 -> j1562866;
		j2824595830 -> j1317232472;
		j2824595830 -> j3343817701;
	j2288216053 [label="これは超クールな選択肢だけど、ちょっと癖があって、最初はすごい弱いわ。",shape=box,color=blue];
		j2288216053 -> j156404540;
	j2964038830 [label="少し上級者向けだけど、中々クールよ。",shape=box,color=blue];
		j2964038830 -> j2244590792;
	j154813968 [label="初心者には一番の選択肢ね。 ",shape=box,color=blue];
		j154813968 -> j1729127880;
	j156404540 [label="でも最後には、最もゴージャスで神々しいパンサーが自分のものになるわけ。",shape=box,color=blue];
		j156404540 -> j274233000;
	j2244590792 [label="あとプルームベルトはパチパチぶどうをエサにすると他の誰よりも早くレベルアップから超カワイイわ。",shape=box,color=blue];
		j2244590792 -> j4061330396;
	j1729127880 [label="最初はサイコーに可愛いカエルから始めるんだけど、十分な戦いに勝てば、最終的には…",shape=box,color=blue];
		j1729127880 -> j3157805216;
	j274233000 [label="まさに粋な選択ね。",shape=box,color=blue];
		j274233000 -> j2095435469;
	j4061330396 [label="それで収穫システム全体を使えるようになるし。",shape=box,color=blue];
		j4061330396 -> j2095435469;
	j3157805216 [label="フロゴボゴはドラゴンにレベルアップさせられるのよ！",shape=box,color=blue];
		j3157805216 -> j2095435469;
	j2095435469 [label="一体何のゲームなんだ…",shape=box,color=red];
		j2095435469 -> j636021495;
	j636021495 [label="ああそうね、ジニモンを集めて、集めたのは自分のために戦ってくれて、それで冒険に出るのよ。",shape=box,color=blue];
		j636021495 -> j2018714501;
	j2018714501 [label="でもこれはビデオゲーム版の話で、カードゲーム版だと現実の誰かと自分が実際に戦うわけ。",shape=box,color=blue];
		j2018714501 -> j3950929759;
	j3950929759 [label="考えは一緒なんだけど。ジニモン、ジニモン、ジニモン。",shape=box,color=blue];
		j3950929759 -> j1316785528;
	j1316785528 [label="それで、最初の一戦やる準備はいい？",shape=box,color=blue];
		j1316785528 -> j52383115;
		j1316785528 -> j769021900;
		j1316785528 -> j3791959278;
		j1316785528 -> j747304510;
	j52383115 [label="嫌だ。[閉じる]",shape=box,color=red];
		j52383115 -> j145506587;
	j769021900 [label="やってみようか。ビギナーズラックで勝てるはずだ。",shape=box,color=red];
		j769021900 -> j4171250027;
	j3791959278 [label="手軽に勝ちたいだけだろう。やりたくない。",shape=box,color=red];
		j3791959278 -> j1642736953;
	j747304510 [label="いや、むしろもっと混乱した。何も説明しなかっただろう！",shape=box,color=red];
		j747304510 -> j1642736953;
	j4171250027 [label="OK…　じゃあまず10000ホラーズでスターターパック買って…",shape=box,color=blue];
		j4171250027 -> j558174309;
		j4171250027 -> j1754645002;
