	j2877923234 [label="はいはい。",shape=box,color=blue];
		j2877923234 -> j145506587;
	j2983336237 [label="おめでとう。KOLの安全性テストに合格よ。",shape=box,color=blue];
		j2983336237 -> j361550110;
	j793584146 [label="ちょっと、だめ！　これはテストよ、KOLインターネットサービスに銀行口座なんて入れちゃだめだからね！",shape=box,color=blue];
		j793584146 -> j1683073493;
