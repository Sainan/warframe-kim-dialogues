digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank3Convo2 begins." [color=orange];
		"KayaRank3Convo2 begins." -> j2095165364;
	j2095165364 [label="本当に「タイムトラベル」に関心があるんだな。熱狂するほどに。",shape=box,color=red];
		j2095165364 -> j2750342311;
	j2750342311 [label="進捗中よ。あと少しなの。",shape=box,color=blue];
		j2750342311 -> j420204992;
	j420204992 [label="タイムトラベルがわかったら、さらに大きな問題が出てくる。永遠主義理論だ。",shape=box,color=red];
		j420204992 -> j3986883509;
	j3986883509 [label="え…　何？",shape=box,color=blue];
		j3986883509 -> j2633601063;
		j3986883509 -> j2807960066;
	j2633601063 [label="自力でこれがわかるかお手並み拝見だ。永遠主義理論がある限り、ここで話が終わらない世界線もあるんだから。[閉じる]",shape=box,color=red];
		j2633601063 -> j3655577789;
	j2807960066 [label="忙しくなければいいけど、これこそが自分がここにいる本当の理由だから。",shape=box,color=red];
		j2807960066 -> j681813299;
	j3655577789 [label="Boolean KayaEternalismTest is now true.",color=orange];
		j3655577789 -> j2156753723;
	j681813299 [label="今時間あるから、説明して。それは時間制御理論の最後の詰めに効いてくる話かもしれない。",shape=box,color=blue];
		j681813299 -> j1561220685;
	j2156753723 [label="+20 Chemistry",color=orange];
		j2156753723 -> "Chat ends. Next chat will be KayaRank3Convo3.";
	j1561220685 [label="これは科学者の誰かが方式を発見したから始まったわけじゃない。",shape=box,color=red];
		j1561220685 -> j1790922509;
	"Chat ends. Next chat will be KayaRank3Convo3." [color=orange];
	j1790922509 [label="ああでも、きっかけではあったか。",shape=box,color=red];
		j1790922509 -> j498498417;
	j498498417 [label="だけど今の有様は？　異常なんだ。Albrechtがどこかへ行き、何かを目覚めさせて、追いかけてきた。それがVoidだ。",shape=box,color=red];
		j498498417 -> j433160186;
		j498498417 -> j4141521118;
	j433160186 [label="Voidは生きているけど死んでもいる。そうであり、そうでもない。これはパラドックスであると同時に、自分たち全員がこうなってる理由でもある。",shape=box,color=red];
		j433160186 -> j3394551614;
	j4141521118 [label="これの「周期表」や方式はないんだ。",shape=box,color=red];
		j4141521118 -> j1955126371;
	j3394551614 [label="「Hello World」",shape=box,color=blue];
		j3394551614 -> j1573569676;
		j3394551614 -> j2943342158;
	j1955126371 [label="科学で説明つくわよ。あらゆるものは記述できる。",shape=box,color=blue];
		j1955126371 -> j3668359530;
	j1573569676 [label="「Goodbye Albrecht」",shape=box,color=red];
		j1573569676 -> j3275343846;
	j2943342158 [label="何て？",shape=box,color=red];
		j2943342158 -> j920637506;
	j3668359530 [label="Check boolean KayaVoidTest",color=orange];
		j3668359530 -> j4154392131 [label=true,color=green];
		j3668359530 -> j2115855027 [label=false,color=brown];
	j3275343846 [label="+5 Chemistry",color=orange];
		j3275343846 -> j3975714573;
	j920637506 [label="それがインターネットで送られた*最初*のメッセージよ。インターネットの創設者がそれで「機能する」って証明した。",shape=box,color=blue];
		j920637506 -> j3903369070;
	j4154392131 [label="Voidには気をつけろと言ったのは、これが理由だ。",shape=box,color=red];
		j4154392131 -> j383535800;
	j2115855027 [label="もしできないとしたら？",shape=box,color=red];
		j2115855027 -> j266812645;
	j3975714573 [label="は！　夢のまた夢ね。でも「Hello World」って知ってる？",shape=box,color=blue];
		j3975714573 -> j920637506;
	j3903369070 [label="で後は雪だるま式に転がり落ちたの。みんなが熱狂した。科学。金融。技術。娯楽。",shape=box,color=blue];
		j3903369070 -> j3381353160;
	j383535800 [label="記述できないものもある。",shape=box,color=red];
		j383535800 -> j2438747792;
	j266812645 [label="もし厳密なルールだと思っていたものが…",shape=box,color=red];
		j266812645 -> j3216817842;
	j3381353160 [label="そして何十億もの決断とその結果が影響して、あたしはある日オンラインして、それで…",shape=box,color=blue];
		j3381353160 -> j1998356275;
	j2438747792 [label="説明できないものもある。",shape=box,color=red];
		j2438747792 -> j2129142352;
	j3216817842 [label="起きてほしいと何かが思ったから起きたとしたら。",shape=box,color=red];
		j3216817842 -> j2129142352;
	j1998356275 [label="それがNovaの、むしろKayaの最後ね。未来も、経歴も、友達も、全部が。たった一つのミスで。",shape=box,color=blue];
		j1998356275 -> j2099649775;
	j2129142352 [label="じゃああたしの実験に、テストに、研究に、仮説に欠けてるのは「魔法」だって言うの。",shape=box,color=blue];
		j2129142352 -> j841433493;
		j2129142352 -> j3644355900;
	j2099649775 [label="だから他人を信じるよりもVoidを信じてる。",shape=box,color=blue];
		j2099649775 -> j1961772979;
		j2099649775 -> j574671081;
		j2099649775 -> j2948039655;
	j841433493 [label="魔法じゃない。単に…　Void。Voidだ。別の場所からのエネルギーだ。",shape=box,color=red];
		j841433493 -> j3229710145;
	j3644355900 [label="自分に何ができるか見ただろう？",shape=box,color=red];
		j3644355900 -> j4017878707;
	j1961772979 [label="やめときな。[閉じる]",shape=box,color=red];
		j1961772979 -> j2156753723;
	j574671081 [label="気が滅入るね、Nova。",shape=box,color=red];
		j574671081 -> j2529799180;
	j2948039655 [label="自分も信じていた。",shape=box,color=red];
		j2948039655 -> j2529799180;
	j3229710145 [label="それならなんとかできる。",shape=box,color=blue];
		j3229710145 -> j2623744609;
		j3229710145 -> j1566175838;
	j4017878707 [label="見たし。観察したし。記録したし。研究したし。また研究したわ。ふむ。説明がつくわ。何かに依存している。多分「魔法」ね。",shape=box,color=blue];
		j4017878707 -> j3229710145;
	j2529799180 [label="まだ気づいていないのね。",shape=box,color=blue];
		j2529799180 -> j1017403678;
	j2623744609 [label="無茶をしたら全部失う羽目になるかもしれない。",shape=box,color=red];
		j2623744609 -> j2529799180;
	j1566175838 [label="「なんとかできる」って？",shape=box,color=red];
		j1566175838 -> j2529799180;
	j1017403678 [label="あたしは1999年から出ていく。",shape=box,color=blue];
		j1017403678 -> j1314422464;
	j1314422464 [label="それを成し遂げるまでに何が起きようがどうでもいいの。",shape=box,color=blue];
		j1314422464 -> j250637023;
	j250637023 [label="それで頭が一杯。",shape=box,color=blue];
		j250637023 -> j3621467111;
	j3621467111 [label="あたしにとっては、いいことよ。",shape=box,color=blue];
		j3621467111 -> j2156753723;
}