	"Chat ends. Next chat will be KayaRank4Convo1." [color=orange];
	j3745546575 [label="あんたはあたしを人生最悪の年に閉じ込めたの。",shape=box,color=blue];
		j3745546575 -> j147958681;
	j147958681 [label="要はここから出るためにあんたを利用してるだけ。",shape=box,color=blue];
		j147958681 -> j1525827354;
		j147958681 -> j1208734662;
	j1525827354 [label="何がNovaをそうさせたか知らないけど、それのせいで幸せを掴むチャンスを見逃している。",shape=box,color=red];
		j1525827354 -> j1236716121;
	j1208734662 [label="ご自由に。そっちが早くいなくなればいなくなるほど、面倒くさい態度の連中が減るんでね。",shape=box,color=red];
		j1208734662 -> j314253610;
	j1236716121 [label="憎ませようとしても無駄だよ。確かにイラつかせはするけど、それは憎しみじゃない。",shape=box,color=red];
		j1236716121 -> j1069201330;
		j1236716121 -> j3677258649;
	j314253610 [label="考えが一致して助かるわ。",shape=box,color=blue];
		j314253610 -> j1173661291;
	j1069201330 [label="もし皆を利用してると思いたいなら、どうぞご自由に。",shape=box,color=red];
