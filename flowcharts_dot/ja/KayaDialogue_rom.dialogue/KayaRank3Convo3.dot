	j3677258649 [label="なんとかして手を貸すから。",shape=box,color=red];
		j3677258649 -> j248929565;
	j1173661291 [label="Boolean KayaAttitude is now true.",color=orange];
		j1173661291 -> j3588492270;
	j1675581560 [label="いつか来るであろう、全て解った後も、皆ここにいるよ。",shape=box,color=red];
