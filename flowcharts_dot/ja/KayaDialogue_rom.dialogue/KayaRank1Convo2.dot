		43 -> 45;
	44 [label="だから。インターネットは？　ネットワークの性質を考えれば、わからなくはないけど…",shape=box,color=blue];
		44 -> 45;
	45 [label="本当に何も知らないんだ。自分が知ってるのは、シークエンスがあって、Entratiは何か計画があって、そこに自分が組み込まれていて、ここに来て皆に会わないといけないってだけ。",shape=box,color=red];
		45 -> 46;
