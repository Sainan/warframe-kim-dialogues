		j637248581 -> j3694815991;
	j785628055 [label="嫌。",shape=box,color=blue];
		j785628055 -> j1557784581;
	j1524618846 [label="Kayaが？　Entratiを見つけたって、ほかの誰も見つけられなかったのに？",shape=box,color=red];
		j1524618846 -> j1048838503;
	j3228604019 [label="見つけたのか？　どうやって？",shape=box,color=red];
		j3228604019 -> j1048838503;
	j1575485264 [label="こっちは爆速で成長しなきゃならなかったの。インターネットのクソ野郎どもがそれを後押ししたから。",shape=box,color=blue];
		j1575485264 -> j1557784581;
