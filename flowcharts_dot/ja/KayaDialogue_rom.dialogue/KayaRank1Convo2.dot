digraph {
	"KayaRank1Convo2 begins." [color=orange];
		"KayaRank1Convo2 begins." -> j1120848006;
	j1120848006 [label="それで。なんでEntratiの時空連結構成に、キネマンティック・オンライン・ネットワークへのアクティブ接続が入ってるの？",shape=box,color=blue];
		j1120848006 -> j2768261507;
	j2768261507 [label="あ、そうだった。こんにちは。タイムトラベルにインターネットって必須？",shape=box,color=blue];
		j2768261507 -> j2345598985;
		j2768261507 -> j3859555681;
	j2345598985 [label="いきなりだね。いいけど。いいや、インターネットは自分の時代にはない、だから必須じゃないはず。そうかもしれないけど。",shape=box,color=red];
		j2345598985 -> j2451298211;
	j3859555681 [label="こんにちは、Kaya。",shape=box,color=red];
		j3859555681 -> j1384330831;
	j2451298211 [label="じゃああんたは自由にタイムトラベルするのにインターネット接続は要らないってことね？　Entratiはどうなの？",shape=box,color=blue];
		j2451298211 -> j3924470824;
	j1384330831 [label="だから。インターネットは？　ネットワークの性質を考えれば、わからなくはないけど…",shape=box,color=blue];
		j1384330831 -> j3924470824;
	j3924470824 [label="本当に何も知らないんだ。自分が知ってるのは、シークエンスがあって、Entratiは何か計画があって、そこに自分が組み込まれていて、ここに来て皆に会わないといけないってだけ。",shape=box,color=red];
		j3924470824 -> j3362576611;
	j3362576611 [label="いいわ、でもなぜインターネット接続が必須だとEntratiのメモに書いてあるの？",shape=box,color=blue];
		j3362576611 -> j2504104636;
		j3362576611 -> j904490676;
		j3362576611 -> j246068357;
	j2504104636 [label="次に会ったときに聞いてみる。",shape=box,color=red];
		j2504104636 -> j3135231552;
	j904490676 [label="彼のメモを持ってるのか？",shape=box,color=red];
		j904490676 -> j2172188385;
	j246068357 [label="それは問題なのか？　お嬢ちゃんみたいなのはインターネットが大好きじゃないのか？ ",shape=box,color=red];
		j246068357 -> j2322558332;
	j3135231552 [label="?",shape=box,color=blue];
		j3135231552 -> j2250798173;
		j3135231552 -> j1163247854;
	j2172188385 [label="厳密には違うわ。彼を見つけた時のものだけ。向こうは見つかるとは思ってなかったと思う。",shape=box,color=blue];
		j2172188385 -> j448789439;
