digraph {
	38 [label="KayaRank1Convo2 begins.",color=orange];
		38 -> 39;
	39 [label="それで。なんでEntratiの時空連結構成に、キネマンティック・オンライン・ネットワークへのアクティブ接続が入ってるの？",shape=box,color=blue];
