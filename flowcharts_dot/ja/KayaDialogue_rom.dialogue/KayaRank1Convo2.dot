	"Chat ends. Next chat will be KayaRank1Convo3." [color=orange];
	j127001341 [label="で本当にあんたの未来にはインターネットがないの？　本当に本当？",shape=box,color=blue];
		j127001341 -> j538418622;
	j194977217 [label="+20 Chemistry",color=orange];
		j194977217 -> j27641574;
	j538418622 [label="あーいや、忘れて。自分で行って確かめるから。",shape=box,color=blue];
		j538418622 -> j1557784581;
	j27641574 [label="このクソみたいなところではすぐ事情が変わるの。特にドクターの話題でいっぱいのンターネットの場末ではね。",shape=box,color=blue];
		j27641574 -> j1383752745;
	j1383752745 [label="それで見つけたの、驚かせたし。それでうわーーーって。ドクターのおじーちゃんは不満そうだったけど、あたしは単刀直入に聞いたわ。",shape=box,color=blue];
		j1383752745 -> j2016168445;
	j2016168445 [label="あいつが未来から来たことは知っていた。あたしがそれを知っていることも、向こうは知っていた。であたしに選択肢が云々。で、今はあんたを見つけた。",shape=box,color=blue];
		j2016168445 -> j3056729001;
	j3056729001 [label="そして今あんたに選択肢を与えているのよ。手を貸すか、それとも後になって悔やむか。",shape=box,color=blue];
		j3056729001 -> j2507632518;
		j3056729001 -> j4036352045;
	j2507632518 [label="可愛いね。わかってると思うけど、自分は敵じゃないんだ。",shape=box,color=red];
		j2507632518 -> j531696951;
	j4036352045 [label="いつも新しい友達を威嚇するの？",shape=box,color=red];
