		j695542862 -> j2819390407;
	j3317551095 [label="そうなって欲しくはない。",shape=box,color=red];
		j3317551095 -> j2778644390;
	j230749241 [label="それが「Void」だ。何かが起こるまでは何もない。",shape=box,color=red];
		j230749241 -> j2538055962;
	j1301308888 [label="Albrechtを見つけたらそこに戻すなり何なりしないと。具体的な案はないけど。",shape=box,color=red];
		j1301308888 -> j2538055962;
	j3018205604 [label="まあ、あんたの科学的な疑問に答えられたら面白いと思うわ。答えが見つかるといいわね。",shape=box,color=blue];
		j3018205604 -> j1640452266;
		j3018205604 -> j2405941417;
	j1829694209 [label="そうかもね？　ま、「苦手」って訳じゃないけど。何故、とか誰が、なんてどうでもいいから。単に面白いのを作れればいい。",shape=box,color=blue];
		j1829694209 -> j1466397601;
		j1829694209 -> j2934192194;
	j2819390407 [label="ありがと～～～！",shape=box,color=blue];
		j2819390407 -> j392027042;
	j2778644390 [label="あっそ。でも",shape=box,color=blue];
		j2778644390 -> j2819390407;
	j2538055962 [label="まあ、関連はありそうだけど、研究の中心じゃないかな。また話しましょ！",shape=box,color=blue];
		j2538055962 -> j392027042;
	j1640452266 [label="答えが気に入るかは分からないよ、Nova。",shape=box,color=red];
		j1640452266 -> j392027042;
	j2405941417 [label="そうだね、いつの日か。",shape=box,color=red];
		j2405941417 -> j392027042;
	j1466397601 [label="そうかもだけど、この惑星は自分一人のものじゃないから、自分たちの選択はどうやっても他人にも影響する。",shape=box,color=red];
		j1466397601 -> j3814151107;
	j2934192194 [label="Entratiが最初にVoidに到達するまではそう思っていたかもしれない、結果が今の自分たちだ。",shape=box,color=red];
