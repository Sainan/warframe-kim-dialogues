		j1487584150 -> j3317551095 [label=false,color=brown];
	j3758818966 [label="既知の世界のすべてのものは、天体との関係で規定される。このVoidってのは随分奇妙ね。",shape=box,color=blue];
		j3758818966 -> j230749241;
		j3758818966 -> j1301308888;
	j331878158 [label="知りたいかどうかは微妙だ。",shape=box,color=red];
		j331878158 -> j3018205604;
	j1912106933 [label="もし「それ」が可能なら、色んな問題が解ける。",shape=box,color=red];
		j1912106933 -> j3018205604;
	j1158745215 [label="哲学は苦手なのか？",shape=box,color=red];
		j1158745215 -> j1829694209;
	j266981395 [label="状況にかかわらず…　その時がきたら、そうする。",shape=box,color=red];
		j266981395 -> j2819390407;
