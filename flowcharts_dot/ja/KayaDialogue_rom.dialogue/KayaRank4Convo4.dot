	j1683150994 [label="ハハハ。",shape=box,color=blue];
		j1683150994 -> j953172726;
	j473607067 [label="ほかの天体もないの？",shape=box,color=blue];
		j473607067 -> j287858929;
		j473607067 -> j365037989;
	j2500915900 [label="科学で説明がつくかは怪しい。「それ」がこの全ての原因なんだ。",shape=box,color=red];
		j2500915900 -> j1503988302;
	j2473112550 [label="むしろ哲学みたいに聞こえる。",shape=box,color=red];
		j2473112550 -> j1620306236;
	j2997362965 [label="それと、もし本当にいなくなったら、Arthurにかわいいと思ってるって伝えといて。",shape=box,color=blue];
		j2997362965 -> j1487584150;
	j953172726 [label="やってみるわ。",shape=box,color=blue];
		j953172726 -> j392027042;
	j287858929 [label="知る限りにはない。",shape=box,color=red];
