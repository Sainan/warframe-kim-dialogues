	j3444971632 [label="詩的に言ったつもりだけど、太陽はない。",shape=box,color=red];
		j3444971632 -> j473607067;
	j2570856360 [label="そうかな？　デュヴィリを観察すれば存在する秘密に迫れるって考える学派も出てくるかもよ。",shape=box,color=blue];
		j2570856360 -> j2500915900;
		j2570856360 -> j2473112550;
	j3815853559 [label="わからないけど、もしあたしがいなくなったら、葬式でイイ感じのこと喋ってよ。",shape=box,color=blue];
		j3815853559 -> j2997362965;
	j3850686474 [label="もちろん、手伝ってくれるなら言ってね！ ",shape=box,color=blue];
