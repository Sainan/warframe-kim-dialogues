digraph {
	"KayaRank5Convo1 begins." [color=orange];
		"KayaRank5Convo1 begins." -> j2321931300;
	j2321931300 [label="その紫色のやつさあ、いつも見かけた次の日には消えてるんだけど。",shape=box,color=blue];
		j2321931300 -> j1653207392;
	j1653207392 [label="その崩壊に何かヒントがあると思うのよ。",shape=box,color=blue];
		j1653207392 -> j726234130;
	j726234130 [label="だってこの物質は普通に崩壊して新しい同位体に変わってるわけじゃないもん。",shape=box,color=blue];
		j726234130 -> j51001247;
	j51001247 [label="マジで「ここ」から消えてるの。",shape=box,color=blue];
		j51001247 -> j499693226;
		j51001247 -> j2865543800;
	j499693226 [label="クライオティックのこと？",shape=box,color=red];
		j499693226 -> j732787238;
	j2865543800 [label="アルゴンクリスタルのこと？",shape=box,color=red];
		j2865543800 -> j3014542216;
	j732787238 [label="んー、いや、それじゃない。",shape=box,color=blue];
		j732787238 -> j2865543800;
		j732787238 -> j1475486763;
	j3014542216 [label="そうそれよ！",shape=box,color=blue];
		j3014542216 -> j3002849080;
	j1475486763 [label="オロキンセルのこと？",shape=box,color=red];
		j1475486763 -> j2498486852;
	j3002849080 [label="あんたの時代ではこれを保持できるの？",shape=box,color=blue];
		j3002849080 -> j1940543906;
		j3002849080 -> j2236413398;
	j2498486852 [label="んー、いや絶対それじゃないわね。",shape=box,color=blue];
		j2498486852 -> j2003851581;
		j2498486852 -> j2865543800;
	j1940543906 [label="これはVoidの外に持ち出したら、必ず消えてしまうんだ。",shape=box,color=red];
		j1940543906 -> j1573337460;
	j2236413398 [label="やったことはない。単に崩壊していったんだと思っていた。",shape=box,color=red];
		j2236413398 -> j1573337460;
	j2003851581 [label="ルビドーのこと？",shape=box,color=red];
		j2003851581 -> j1566071193;
	j1573337460 [label="そう、Voidの中だとこれは不活性なの。",shape=box,color=blue];
		j1573337460 -> j3724789888;
	j1566071193 [label="それじゃないかも。ここで分からないと永遠に解けないままよ。",shape=box,color=blue];
		j1566071193 -> j3297522953;
		j1566071193 -> j2865543800;
	j3724789888 [label="そしてVoidから離れると、必ずVoidへ戻る。崩壊して別の物質になるわけじゃない。",shape=box,color=blue];
		j3724789888 -> j1175952301;
	j3297522953 [label="ナノ胞子のこと？",shape=box,color=red];
		j3297522953 -> j4026047817;
	j1175952301 [label="これはVoidに移相するんだわ。Voidはどこにでもあって、呼び戻している。",shape=box,color=blue];
		j1175952301 -> j221969447;
	j4026047817 [label="ああ、もう無理。最後のサンプルがなくなっちゃった。ああ…　もう。行かなきゃ。",shape=box,color=blue];
		j4026047817 -> j1886307270;
	j221969447 [label="Boolean KayaFutureWin2 is now true.",color=orange];
		j221969447 -> j1971410838;
		j221969447 -> j2228203842;
	j1886307270 [label="こんなのできっこない。",shape=box,color=blue];
		j1886307270 -> j4123196853;
	j1971410838 [label="これで1999年から脱出できるのか？　Voidに隠れるつもりか？　お勧めはできない。",shape=box,color=red];
		j1971410838 -> j1093653499;
	j2228203842 [label="これは目的にとって重要なのか？",shape=box,color=red];
		j2228203842 -> j1189346182;
	j4123196853 [label="+20 Chemistry",color=orange];
		j4123196853 -> "Chat ends. Next chat will be KayaRank5Convo2.";
	j1093653499 [label="どちらかっていうと、物質の状態と、現時点でわかってるVoidは「線形」じゃないという理論に基づいた話ね。それをトランポリンみたいに使って、実質あんたを逆行して追跡できるってこと。",shape=box,color=blue];
		j1093653499 -> j180498498;
	j1189346182 [label="メチャクチャ重要！　つまり物質はVoidと「ここ」の間につながりを持てる。原子も、その存在も、どちら側でも一致してる。",shape=box,color=blue];
		j1189346182 -> j743162826;
	"Chat ends. Next chat will be KayaRank5Convo2." [color=orange];
	j180498498 [label="ちょっと待って、自分を追うって？",shape=box,color=red];
		j180498498 -> j3606046905;
	j743162826 [label="わかってる限りではVoidは「線形」じゃない。だからトランポリンみたいに使って、実質あんたを逆行して追跡できるってわけ。",shape=box,color=blue];
		j743162826 -> j180498498;
	j3606046905 [label="そ。どれだけテストして、計算しても、「灯台」みたいなのが欠けてるのね。。トランポリンはどこかに着地しなきゃいけない。一度行って帰ってくるだけでも、較正するには十分なはずだわ。",shape=box,color=blue];
		j3606046905 -> j1733766465;
		j3606046905 -> j3644042845;
	j1733766465 [label="バックフリップはできる？　灯台注文入りました。",shape=box,color=red];
		j1733766465 -> j915334252;
	j3644042845 [label="うわぁ。不安だな。行き詰ったり、迷ったらどうする？",shape=box,color=red];
		j3644042845 -> j804435985;
	j915334252 [label="もちろん、全然準備はできてない。二回計ってから、一回切る。千回…　計ってから。",shape=box,color=blue];
		j915334252 -> j2095963509;
		j915334252 -> j3248919314;
	j804435985 [label="しないわ。",shape=box,color=blue];
		j804435985 -> j2097419025;
	j2095963509 [label="そうだね。科学は自信をもってやってこそだ。",shape=box,color=red];
		j2095963509 -> j484700422;
	j3248919314 [label="やってみよう！　慎重に行く時間はない、今すぐ行こう！ ",shape=box,color=red];
		j3248919314 -> j458582571;
	j2097419025 [label="するかも。",shape=box,color=red];
		j2097419025 -> j1932629761;
	j484700422 [label="教えが伝わったみたいね。",shape=box,color=blue];
		j484700422 -> j2175070258;
		j484700422 -> j3578303401;
	j458582571 [label="あーだめだめ準備まだ！　これを急かさないでよ！",shape=box,color=blue];
		j458582571 -> j1780613442;
	j1932629761 [label="しないわね。",shape=box,color=blue];
		j1932629761 -> j735505248;
		j1932629761 -> j2698426472;
	j2175070258 [label="言ってな！",shape=box,color=red];
		j2175070258 -> j4123196853;
	j3578303401 [label="ああ、とてもいい教師だよ。でも自分が見たのはMinervaに新しい飲み会ゲームのやり方を教えてるのだけだな。",shape=box,color=red];
		j3578303401 -> j2077992299;
	j1780613442 [label="よかった、これがどれだけヤバいことかわかってるってことだ。よくできました。",shape=box,color=red];
