	j2698426472 [label="でも…　するかも。",shape=box,color=red];
		j2698426472 -> j1317335347;
	j2077992299 [label="二日酔いのMinervaはタイムトラベルより危険だけどね。逃げるのよ！",shape=box,color=blue];
