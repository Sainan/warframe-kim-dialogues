digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank2Convo1 begins." [color=orange];
		"KayaRank2Convo1 begins." -> j500703440;
	j500703440 [label="やあ、Kaya！",shape=box,color=red];
		j500703440 -> j1470626109;
	j1470626109 [label="Nova。オンラインではNovaよ。",shape=box,color=blue];
		j1470626109 -> j2227812335;
		j1470626109 -> j3886015095;
	j2227812335 [label="わかった、じゃあNova。",shape=box,color=red];
		j2227812335 -> j1961515325;
	j3886015095 [label="なるほど。いつから？",shape=box,color=red];
		j3886015095 -> j87675152;
	j1961515325 [label="オッケー、ありがと。ネットではKayaって呼ばないで。直接会っ時ならいいけど、ここでは「NOVA」。いい？",shape=box,color=blue];
		j1961515325 -> j2517108097;
		j1961515325 -> j1372910808;
	j87675152 [label="何か問題でも？　インターネットで本名を使いたくないの。",shape=box,color=blue];
		j87675152 -> j3112777682;
		j87675152 -> j924695686;
	j2517108097 [label="わかった。でも、理由を訊いていい？",shape=box,color=red];
		j2517108097 -> j2859923413;
	j1372910808 [label="分かった。Nova。Novaね。了解。聞きたいんだけど、ここの暮らしを楽にするのに手助けできることはない？",shape=box,color=red];
		j1372910808 -> j2544101744;
	j3112777682 [label="そうだね、タイムトラベルについてずっと聞き回ってるのを皆に知られたくはないだろうしね。",shape=box,color=red];
		j3112777682 -> j2723444654;
	j924695686 [label="え？　Amirはここのネットワークを厳重に管理してると思うけど、何か見落としてた？",shape=box,color=red];
		j924695686 -> j2721199648;
	j2859923413 [label="他の人にも好きなニックネームについて聞いたことあるの？　受け入れなさい。",shape=box,color=blue];
		j2859923413 -> j1372910808;
	j2544101744 [label="ここの仮住まいに本当に居たい人なんていないのは知ってるけど、できることは手を尽くしてる。",shape=box,color=red];
		j2544101744 -> j2537021076;
	j2723444654 [label="あんた本気で言ってる？　インターネットは危険なのよ。ガチで。",shape=box,color=blue];
		j2723444654 -> j1508750049;
		j2723444654 -> j2703889140;
	j2721199648 [label="あたしにとって重要なの。誰もKayaをオンラインで見つけて欲しくない。",shape=box,color=blue];
		j2721199648 -> j1272022054;
		j2721199648 -> j2482337792;
	j2537021076 [label="ふーん。うーん。むう。暮らしやすい、ねえ。誰もあたしの噂してないわよね？",shape=box,color=blue];
		j2537021076 -> j3096711201;
		j2537021076 -> j882424372;
	j1508750049 [label="何かあったの？",shape=box,color=red];
		j1508750049 -> j960515419;
	j2703889140 [label="タイムトラベルはそうでないと思うの？",shape=box,color=red];
		j2703889140 -> j4294415938;
	j1272022054 [label="時間警察は捕まえに来ないって。",shape=box,color=red];
		j1272022054 -> j2791035075;
	j2482337792 [label="何かトラブルに巻き込まれた？",shape=box,color=red];
		j2482337792 -> j2499352775;
	j3096711201 [label="そういえばAoiが…",shape=box,color=red];
		j3096711201 -> j2446442484;
	j882424372 [label="何も言っていない。居てくれて嬉しそうだ。",shape=box,color=red];
		j882424372 -> j191594090;
	j960515419 [label="Check boolean KayaSetKid",color=orange];
		j960515419 -> j3355025557 [label=true,color=green];
		j960515419 -> j2226883652 [label=false,color=brown];
	j4294415938 [label="Check boolean KayaSetKid",color=orange];
		j4294415938 -> j279357322 [label=true,color=green];
		j4294415938 -> j4112403187 [label=false,color=brown];
	j2791035075 [label="うざ。面白くないわ。",shape=box,color=blue];
		j2791035075 -> j2292283515;
	j2499352775 [label="昔アホなヘマしたの。一度だけ。",shape=box,color=blue];
		j2499352775 -> j931142406;
	j2446442484 [label="マジ、冗談でもやめて。",shape=box,color=blue];
		j2446442484 -> j2563378268;
	j191594090 [label="ArthurとEleanorは、自分たちよりずっと賢い妹だと思ってるよ。",shape=box,color=red];
		j191594090 -> j3106438769;
	j3355025557 [label="あたしのことお嬢ちゃん呼ばわりするけど、もしあたしに何か起きたらどうするの？",shape=box,color=blue];
		j3355025557 -> j1440516839;
	j2226883652 [label="今更何も変えられない。",shape=box,color=blue];
		j2226883652 -> j3650811130;
	j279357322 [label="あんたがあたしのことただのガキだって思ってるのは分かってる。",shape=box,color=blue];
		j279357322 -> j4142708235;
	j4112403187 [label="そうね。それもそう。",shape=box,color=blue];
		j4112403187 -> j2541335978;
	j2292283515 [label="+20 Chemistry",color=orange];
		j2292283515 -> "Chat ends. Next chat will be KayaRank2Convo2.";
	j931142406 [label="そしてあたしはヘマはしないの。",shape=box,color=blue];
		j931142406 -> j193405577;
	j2563378268 [label="全然面白くない。あたしたち女子をひとまとめの部屋にしてキャットファイトでも期待してるんでしょ。",shape=box,color=blue];
		j2563378268 -> j1279275582;
	j3106438769 [label="AmirとQuincyはWormholeのことが忘れられなくて、見てないときにWormholeをくぐってるに違いないよ。",shape=box,color=red];
		j3106438769 -> j2057786515;
	j1440516839 [label="その時は、ここにいる皆が互いに助け合うチームだってことをわかってくれるといいな。",shape=box,color=red];
		j1440516839 -> j2309611397;
	j3650811130 [label="じゃあ、それがタイムトラベルをしたい理由？　何かを証明するため？",shape=box,color=red];
		j3650811130 -> j3208501013;
	j4142708235 [label="でも",shape=box,color=blue];
		j4142708235 -> j2499352775;
	j2541335978 [label="多分そう。だからこそ、ちゃんとやらないといけない。ヘマは踏めない。",shape=box,color=blue];
		j2541335978 -> j2499352775;
	"Chat ends. Next chat will be KayaRank2Convo2." [color=orange];
	j193405577 [label="だから、あと数日、いや数週間だけ待ってて。そしたらこの全部を解決して、1999年ともおさらばよ。",shape=box,color=blue];
		j193405577 -> j1007523847;
	j1279275582 [label="嫉妬。比較。ああ。もういうのはもう人生で懲り懲りなの。他の女の子たちと敵対させようとしないで。 ",shape=box,color=blue];
		j1279275582 -> j2292283515;
	j2057786515 [label="AoiとLettieは、親友役をやりたいのか、母親役になりたいのか決めかねてるみたいだ。",shape=box,color=red];
		j2057786515 -> j2006180985;
	j2309611397 [label="ふーん。",shape=box,color=blue];
		j2309611397 -> j523098305;
	j3208501013 [label="多分ね。",shape=box,color=blue];
		j3208501013 -> j57022177;
	j1007523847 [label="賭けてもいい。",shape=box,color=blue];
		j1007523847 -> j2292283515;
	j2006180985 [label="それに自分だって、ここに辿り着いた理由を解き明かしたい人がいて嬉しいよ。",shape=box,color=red];
		j2006180985 -> j3942740547;
	j523098305 [label="そうね。あんたは不人気ってワケじゃない。",shape=box,color=blue];
		j523098305 -> j3726761699;
	j57022177 [label="なんでそんな構うの？",shape=box,color=blue];
		j57022177 -> j2319514454;
		j57022177 -> j732577099;
		j57022177 -> j1476492575;
	j3942740547 [label="ホントに、皆あたしが…　好きなの？",shape=box,color=blue];
		j3942740547 -> j1067537143;
		j3942740547 -> j3593239185;
	j3726761699 [label="みんなあんたを信頼してる、少なくともそう言いはしてる。",shape=box,color=blue];
		j3726761699 -> j1476492575;
		j3726761699 -> j732577099;
		j3726761699 -> j2319514454;
	j2319514454 [label="人を信じて、協力することで自分たちでいられるんだ。",shape=box,color=red];
		j2319514454 -> j2368919594;
	j732577099 [label="友達を気遣うことは強さだ。それで、このすべての苦難に耐えられる。",shape=box,color=red];
		j732577099 -> j2368919594;
	j1476492575 [label="皆いろんな問題を抱えてる。一人じゃ乗り越えられない。",shape=box,color=red];
		j1476492575 -> j2368919594;
	j1067537143 [label="だから皆でここを居心地良く感じてくれるのをずっと待ってるんだ。",shape=box,color=red];
		j1067537143 -> j1112381822;
	j3593239185 [label="そうしない理由がないよ？",shape=box,color=red];
		j3593239185 -> j1112381822;
	j2368919594 [label="笑 ソロリティのスローガンみたいね。",shape=box,color=blue];
		j2368919594 -> j1642339009;
		j2368919594 -> j2146434160;
	j1112381822 [label="そう…　なんだ。",shape=box,color=blue];
		j1112381822 -> j2292283515;
	j1642339009 [label="「ソロリティのスローガン」って何？",shape=box,color=red];
		j1642339009 -> j1872536517;
	j2146434160 [label="ソロリティ？　何それ。",shape=box,color=red];
		j2146434160 -> j1872536517;
	j1872536517 [label="笑　マジで？　それがない時代ってなら未来に行かなきゃじゃん。うっわー。",shape=box,color=blue];
		j1872536517 -> j408927295;
	j408927295 [label="話が読めない…",shape=box,color=red];
		j408927295 -> j2861173101;
	j2861173101 [label="大学で、女の子が自分たちを「シスター」と呼びあって、それが凄いことだと思ってんのよ。「サークル」みたいなやつだと思うわ。",shape=box,color=blue];
		j2861173101 -> j1237255539;
	j1237255539 [label="ああ、Parvosシスターみたいな感じ？",shape=box,color=red];
		j1237255539 -> j1751573615;
	j1751573615 [label="ダサ。うええ。本物のソロリティじゃないでしょうね。",shape=box,color=blue];
		j1751573615 -> j2397598935;
	j2397598935 [label="まあ、自分を殺そうとしてくる。何回も。",shape=box,color=red];
		j2397598935 -> j805401260;
	j805401260 [label="あたしと同じようなもんね…",shape=box,color=blue];
		j805401260 -> j2292283515;
}