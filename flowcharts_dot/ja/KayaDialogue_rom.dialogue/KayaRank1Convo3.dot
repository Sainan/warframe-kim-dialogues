		109 -> 114 [label=false,color=brown];
	111 [label="ええ、知らないわ。でも何ができるかは知ってる、だから話してるのよ。真面目に話して。",shape=box,color=blue];
		111 -> 117;
	112 [label="インターネットの見知らぬ誰かさんからの約束。勘弁してよ。あたしの知りたいことだけ教えて。",shape=box,color=blue];
		112 -> 118;
	113 [label="であたしが来たら、あいつビビったのよね。マジでさ、まるで誰かが来ることなんて*全く*予想してなかったみたいに。",shape=box,color=blue];
		113 -> 119;
		113 -> 120;
	116 [label="訊いたわ。いくつかの原則については同意がとれた。でも具体的な、再現性のあるタイムトラベルには興味なさそうだった。",shape=box,color=blue];
		116 -> 123;
	115 [label="まぁ、ここにあるものを活用しようってこと。Lettieとは話してみた？　なんか気が合いそう。",shape=box,color=red];
		115 -> 122;
	114 [label="ああ、つまりこっちの時代のツールにアクセスできれば楽になるかもって思って…",shape=box,color=red];
		114 -> 121;
	117 [label="わかった、真面目にやろう。",shape=box,color=red];
		117 -> 124;
		117 -> 125;
	118 [label="何か起きたのか？",shape=box,color=red];
		118 -> 126;
	119 [label="わお、それはすごい。",shape=box,color=red];
		119 -> 127;
	120 [label="え、ただの自慢話？",shape=box,color=red];
		120 -> 127;
	123 [label="実際、最初の仮説のいくつかは間違ってるって示してきたから、役には立ったし。でも彼も金払って答えを教えてもらえばいいと肯定してくれたし、あんたが手を貸してくれないなら他に未来から来た誰かに聞けばいいとも思った。",shape=box,color=blue];
		123 -> 130;
		123 -> 131;
	122 [label="うまくやってるわ。昔の先生を思い出す。嫌みなところが全然なくて、あたしの頭脳を見抜いたの。",shape=box,color=blue];
		122 -> 129;
	121 [label="それってオファー？　何にアクセスできるの？　なんだって助かる。",shape=box,color=blue];
		121 -> 128;
	124 [label="タイムトラベルをしたいのはわかった、でもどこへ？　どうして？",shape=box,color=red];
		124 -> 132;
	125 [label="周りを見回してみた？",shape=box,color=red];
		125 -> 133;
	126 [label="あたしたち全員に何かが起きた。これを何とかするあたしを助ける方法がわかったら教えて。",shape=box,color=blue];
		126 -> 134;
	127 [label="ああもう、なんであんたにこの話をしてるの？",shape=box,color=blue];
		127 -> 135;
	130 [label="10ホラーズでどうやって死ぬか教えてあげる。",shape=box,color=red];
		130 -> 139;
	131 [label="そんなのを売りつけようとする人間がいたら詐欺師だ。心配しなくても、手を貸すよ。金はいらない。",shape=box,color=red];
		131 -> 140;
	129 [label="実際メチャクチャチルだしね。頭もいい。でもあんたのこと信じろって言うから、まあお手並み拝見ね。",shape=box,color=blue];
		129 -> 137;
		129 -> 138;
	128 [label="そっちが自力で見つけ出したいなら、何か役に立ちそうなものを探すよ。",shape=box,color=red];
