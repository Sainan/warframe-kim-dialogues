digraph {
	541 [label="KayaRank4Convo1 begins.",color=orange];
		541 -> 542;
	542 [label="どんな感じか分かる？　インターネットが現れて、沢山のことを約束されて。",shape=box,color=blue];
		542 -> 543;
	543 [label="あたしの立場で考えてみて。18歳になって、インターネットに繋がって、世界中の新しい友達とチャット始めて！",shape=box,color=blue];
		543 -> 544;
	544 [label="そしてあたしみたいな「お利口な女の子」が、インターネットで一番馬鹿げたことをしてしまうの。",shape=box,color=blue];
		544 -> 545;
	545 [label="向こう側の誰かを信じてしまう。",shape=box,color=blue];
		545 -> 546;
	546 [label="新しいテクノロジーを見て、人間は結局人間ってことを忘れてしまう。",shape=box,color=blue];
		546 -> 547;
	547 [label="それで、ルアだって恥ずかしがるような自分のヌード写真を送るの。インターネットで出会った人と繋がりがあると感じて。オンラインのボーイフレンドは信頼できると信じて。",shape=box,color=blue];
		547 -> 548;
	548 [label="翌日、その写真があらゆるところに広まる。キャンパスの全員がそれを見て、共有して、教授に送られ、インターネットの隅々にまで広まった。あたしが存在すら知らなかった国々にさえ。",shape=box,color=blue];
		548 -> 549;
	549 [label="あたしはこの地球上で一番頭が良い人間になれたかもしれないのに、皆はあたしをこの写真でしか覚えていないかもしれない。",shape=box,color=blue];
		549 -> 550;
	550 [label="だから、ここから出て行くってのは、そういうことよ。あの写真に何の意味もないことはわかっている。未来は進み、その話題も過ぎた話。",shape=box,color=blue];
		550 -> 551;
	551 [label="でもあたしの人生は台無しになったの。あたしはインターネットのない未来に生きたい。これからも先に進めるって証明したい。過去に戻ることは、*あいつら*が正しいって、あたしが前へ進めないって証明してしまう。",shape=box,color=blue];
		551 -> 552;
	552 [label="だから、待ってなさい。あんたが来た場所で会うまでね。",shape=box,color=blue];
		552 -> 553;
	553 [label="二人で世界を見渡して、あたしは自分の選択で自滅しなかったって笑い飛ばせる。単にあたしをより賢くしたって。出ていけるぐらいに。",shape=box,color=blue];
		553 -> 554;
	554 [label="+20 Chemistry",color=orange];
		554 -> 555;
	555 [label="Chat ends. Next chat will be KayaRank4Convo2.",color=orange];
}