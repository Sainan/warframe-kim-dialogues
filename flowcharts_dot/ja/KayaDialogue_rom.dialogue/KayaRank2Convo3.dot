		j2497812411 -> j1132175153;
	j4130281974 [label="彼女が何者であったにせよ、今はParvos Granumに仕えていた誰かさ。",shape=box,color=red];
		j4130281974 -> j3191466762;
	j371700399 [label="投げて、また投げる。",shape=box,color=red];
		j371700399 -> j3370275627;
	j3519779306 [label="聞いたのはそっちだ。",shape=box,color=red];
		j3519779306 -> j291095320;
	j1132175153 [label="そ。",shape=box,color=blue];
		j1132175153 -> j2304967733;
	j3191466762 [label="そーそー、お金持ちで頭のいい悪役。いつものやつね。",shape=box,color=blue];
		j3191466762 -> j2346014325;
		j3191466762 -> j769510814;
		j3191466762 -> j1832968773;
	j3370275627 [label="はー。じゃあ。また。",shape=box,color=blue];
		j3370275627 -> j2189522063;
	j291095320 [label="聞いたのは、少なくとも時間と関係性に関係する答えが聞けると思ったからよ…",shape=box,color=blue];
		j291095320 -> j2304967733;
	j2304967733 [label="そう。つまりタイムトラベル、あるいは時間に関する何かを操るするものの出現。",shape=box,color=red];
		j2304967733 -> j65313796;
	j2346014325 [label="このタイプは知ってる？",shape=box,color=red];
		j2346014325 -> j2114568091;
	j769510814 [label="完全な悪人ではないが、限りなく近い。",shape=box,color=red];
		j769510814 -> j2866995308;
	j1832968773 [label="多くの事件の責任者だ。全部語るには多すぎるけど、Proteaもその一つだ。",shape=box,color=red];
		j1832968773 -> j2916988774;
	j65313796 [label="そう。",shape=box,color=blue];
		j65313796 -> j3492057015;
		j65313796 -> j1631343270;
	j2114568091 [label="うん。",shape=box,color=blue];
		j2114568091 -> j2459885079;
	j2866995308 [label="あっそ",shape=box,color=blue];
		j2866995308 -> j2916988774;
	j2916988774 [label="じゃあそいつに話をすればいいの？",shape=box,color=blue];
		j2916988774 -> j1754041829;
		j2916988774 -> j4032719999;
	j3492057015 [label="どういうわけか、Novaは自分が知っている唯一のタイムトラベラーにタイムトラベルについて聞くことしかできないから。",shape=box,color=red];
		j3492057015 -> j258558381;
	j1631343270 [label="だって本当に諦めが悪いし？　そうしてほしいわけじゃないけど、どうやったら手助けできるのか見当がつかない。",shape=box,color=red];
		j1631343270 -> j442147148;
	j2459885079 [label="大学の学部長もあんなんだったわ。また会うことはないだろうけど…",shape=box,color=blue];
		j2459885079 -> j3532935803;
	j1754041829 [label="一生実験動物として扱われたいなら、そうだね。",shape=box,color=red];
		j1754041829 -> j2024884860;
	j4032719999 [label="たとえ可能だったとしても、おすすめはしない。",shape=box,color=red];
		j4032719999 -> j3065106254;
	j258558381 [label="+5 Chemistry",color=orange];
		j258558381 -> j3006950156;
	j442147148 [label="Proteaの詳細。彼女の中にあたしみたいなのがいるの？　半怪物みたいなのが？",shape=box,color=blue];
		j442147148 -> j2031210862;
		j442147148 -> j124220069;
	j3532935803 [label="あたしに味方してくれると思ってたけど… ",shape=box,color=blue];
		j3532935803 -> j915576377;
		j3532935803 -> j2120465897;
	j2024884860 [label="一番高値を付けた奴に売り飛ばされたいなら。",shape=box,color=red];
		j2024884860 -> j520074684;
	j3065106254 [label="とりあえず、役に立ちそうなものだけに絞ってみよう。",shape=box,color=red];
		j3065106254 -> j1300268680;
	j3006950156 [label="そう。",shape=box,color=blue];
		j3006950156 -> j3075122852;
	j2031210862 [label="でもその半怪物はタイムトラベルを解くんだろ。もう少し自身を評価しようよ。",shape=box,color=red];
		j2031210862 -> j1017135455;
	j124220069 [label="WARFRAMEのProteaはProteaそのものだ。",shape=box,color=red];
		j124220069 -> j3892145037;
	j915576377 [label="大学で何があったんだ？",shape=box,color=red];
		j915576377 -> j1799084399;
	j2120465897 [label="何について味方をするって？",shape=box,color=red];
		j2120465897 -> j1799084399;
	j520074684 [label="彼は頭が切れるが、善人ではない。味方にはならないと思う。",shape=box,color=red];
		j520074684 -> j1196617829;
	j1300268680 [label="時間の…　なにか。",shape=box,color=red];
		j1300268680 -> j3492057015;
	j3075122852 [label="分かってくれてホントウにうれしい。",shape=box,color=blue];
