	j1017135455 [label="+5 Chemistry",color=orange];
		j1017135455 -> j2378246868;
	j3892145037 [label="悲しいことね。",shape=box,color=blue];
		j3892145037 -> j3556037561;
	j1799084399 [label="とりあえず「Nova vs. インターネット」と言うことにしておきましょう。",shape=box,color=blue];
		j1799084399 -> j2124847863;
	j1196617829 [label="考え中。",shape=box,color=blue];
		j1196617829 -> j3636931769;
	j2921226442 [label="1999 年について質問がある場合はどうすればいい？",shape=box,color=red];
		j2921226442 -> j1055995636;
	j3544667325 [label="こっちから質問していい時あるの？",shape=box,color=red];
		j3544667325 -> j1055995636;
	j2378246868 [label="そうね。",shape=box,color=blue];
		j2378246868 -> j3556037561;
	j3556037561 [label="でも",shape=box,color=blue];
		j3556037561 -> j1055995636;
	j2124847863 [label="おバカさんなNova。",shape=box,color=blue];
		j2124847863 -> j4118081315;
	j3636931769 [label="うーん。じゃあProteaがこの手の製造物のなかで一番高度な時間制御ができると考えて",shape=box,color=blue];
		j3636931769 -> j4284733315;
	j1055995636 [label="これが条件で、手順がこうよ。",shape=box,color=blue];
		j1055995636 -> j105466797;
	j4118081315 [label="先生が授業を拒否したら、成績なんて何の意味もないわよ。",shape=box,color=blue];
		j4118081315 -> j2256258038;
		j4118081315 -> j1456554434;
	j4284733315 [label="その制御が理論か、科学的なものか、生来の能力に基づくものか、それとも…　うーん。 ",shape=box,color=blue];
		j4284733315 -> j3847172551;
	j105466797 [label="あたしはあんたのようにタイムトラベルする。 ",shape=box,color=blue];
		j105466797 -> j2893624301;
	j2256258038 [label="今は違う世界だ。",shape=box,color=red];
		j2256258038 -> j3153614674;
	j1456554434 [label="その話をしたくなったら…",shape=box,color=red];
		j1456554434 -> j3153614674;
	j3847172551 [label="うーん。んー。そうね、Void がそれに関係しているとして。",shape=box,color=blue];
		j3847172551 -> j1346670455;
		j3847172551 -> j2941326983;
	j2893624301 [label="あんたが来た場所へ行く。",shape=box,color=blue];
		j2893624301 -> j3686242724;
	j3153614674 [label="わかってる、わかってるわよ…",shape=box,color=blue];
		j3153614674 -> j600813326;
	j1346670455 [label="Voidは単に「解ける」ものじゃない。",shape=box,color=red];
		j1346670455 -> j3466920785;
	j2941326983 [label="Voidは…　あらゆるものに関係してる。",shape=box,color=red];
		j2941326983 -> j1413257574;
	j3686242724 [label="そしたら、あんたが裏切るかどうか、あたしが本当にあんたを信じられるかどうかわかる。それで未来がどうなるかがわかる。",shape=box,color=blue];
		j3686242724 -> j174515710;
	j600813326 [label="わかったわ、この「タイムトラベル」を理解したら、もっと教えてあげるわよ。そうなったらもう失うものはないから。",shape=box,color=blue];
		j600813326 -> j2189522063;
	j3466920785 [label="でも、使えるものかもしれない！　ハッ！　テストしなきゃ。 ",shape=box,color=blue];
		j3466920785 -> j2723069607;
	j1413257574 [label="そしてそのあらゆるものこそまさしく次の実験に必要なものかも。じゃあまたね！",shape=box,color=blue];
		j1413257574 -> j2723069607;
	j174515710 [label="さ、研究の再開よ！　Proteaに関する何か…　うーん。",shape=box,color=blue];
