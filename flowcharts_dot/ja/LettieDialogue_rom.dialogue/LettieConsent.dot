		j4172583155 -> "Chat ends." [label=false,color=brown];
	j1333759720 [label="Lettie？　今忙しい？[複数のパートナーについて同意を得る]",shape=box,color=red];
		j1333759720 -> j3668202601;
	j1365172149 [label="[閉じる]",shape=box,color=red];
		j1365172149 -> j3702107533;
	j3668202601 [label="いつものこと\nでもあんたのためなら大丈夫\n¿Qué?",shape=box,color=blue];
		j3668202601 -> j1779573449;
	j3702107533 [label="Boolean LettieConsentComplete is now true.",color=orange];
		j3702107533 -> "Chat ends.";
	j1779573449 [label="話したいことがある。Lettieの意見を聞きたいんだ。",shape=box,color=red];
		j1779573449 -> j518895186;
	j518895186 [label="Lettieに嘘をついているとか、不誠実だと思わせたくないから。",shape=box,color=red];
		j518895186 -> j3927395243;
		j518895186 -> j84122300;
		j518895186 -> j3421935680;
	j3927395243 [label="聞いても襲わないでね。",shape=box,color=red];
		j3927395243 -> j3764990197;
	j84122300 [label="聞いても怒らないでほしい。",shape=box,color=red];
		j84122300 -> j3408966783;
	j3421935680 [label="わかってくれると嬉しい。",shape=box,color=red];
		j3421935680 -> j3514473940;
	j3764990197 [label="Jajajaja\n言ったでしょ\nあんたが好む方法でしか痛みつけない\nそれで何の話",shape=box,color=blue];
		j3764990197 -> j1508371124;
	j3408966783 [label="¿Sí?\n何に怒るって？",shape=box,color=blue];
		j3408966783 -> j1508371124;
	j3514473940 [label="¿Sí?\n何をわかるって？",shape=box,color=blue];
		j3514473940 -> j1508371124;
	j1508371124 [label="納得できない状況にLettieを置きたくない。こう言った話はしたことがないから。もしダメなら、そう言ってほしい。",shape=box,color=red];
		j1508371124 -> j3731379174;
	j3731379174 [label="自分たちの関係は大切に思っている。本当に。切実に。それだけはわかってほしい。",shape=box,color=red];
		j3731379174 -> j585685064;
	j585685064 [label="ああ、entiendo...\n普段はこうじゃないって知ってるでしょ\nただ知りたいだけ\nあんた本当に彼らのことを気にかけてる？solecito?\n¿Quiénes son?\n本当に彼らのことを気にかけてる？",shape=box,color=blue];
		j585685064 -> j1303641179;
		j585685064 -> j2581705741;
	j1303641179 [label="大切に思っている。でもLettieもすごく大切だ。",shape=box,color=red];
		j1303641179 -> j768670751;
	j2581705741 [label="流石に気付いていたか。",shape=box,color=red];
		j2581705741 -> j3166394513;
	j768670751 [label="ああ、sí\n多くを知っているあんたを責めるのは難しい\nたくさん旅しているんだからね\nただ、アタシに一緒に行こうなんて言わないで\nアタシはそれでいいんだから",shape=box,color=blue];
		j768670751 -> j3790293646;
	j3166394513 [label="ズルした\nEleanorから忠告を受けた\nJajaja 彼女はゴシップ好き",shape=box,color=blue];
		j3166394513 -> j2845502120;
	j3790293646 [label="でもヘックスの一人じゃないわよね？\nMi familia no, ¿por favor?\nもしそうなら色々消毒しないといけない",shape=box,color=blue];
		j3790293646 -> j1420397027;
	j2845502120 [label="多くを知っているあんたを責めるのは難しい\nたくさん旅しているんだからね\nただ、アタシに一緒に行こうなんて言わないで\nアタシはそれでいいんだから",shape=box,color=blue];
		j2845502120 -> j3790293646;
	j1420397027 [label="+20 Chemistry",color=orange];
		j1420397027 -> j2864114484;
	j2864114484 [label="あんたはアタシにとってとても大切な人よ、solecito\nその人があんたに幸せをもたらすなら\nアタシも幸せ\nそれだけの話",shape=box,color=blue];
		j2864114484 -> j1732372370;
	j1732372370 [label="それと\nいつかここに連れてきて\n会ってみたいから",shape=box,color=blue];
		j1732372370 -> j3504231656;
		j1732372370 -> j555969339;
	j3504231656 [label="イエスマム。:)",shape=box,color=red];
		j3504231656 -> j3702107533;
	j555969339 [label="努力する。",shape=box,color=red];
		j555969339 -> j3702107533;
}