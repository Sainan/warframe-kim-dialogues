		j2314015532 -> j3158675495;
	j3158675495 [label="納得できない状況にLettieを置きたくない。こう言った話はしたことがないから。もしダメなら、そう言ってほしい。",shape=box,color=red];
		j3158675495 -> j765515011;
	j765515011 [label="自分たちの関係は大切に思っている。本当に。切実に。それだけはわかってほしい。",shape=box,color=red];
