		j3422567924 -> j3869176340;
	j4135016621 [label="Sólo las arañas\n我が物顔してるだけね\nそのうち通り過ぎるわ",shape=box,color=blue];
		j4135016621 -> j1001608306;
	j3869176340 [label="新しいことは何も\nSólo las arañas\n我が物顔してるだけね\nそのうち通り過ぎるわ",shape=box,color=blue];
		j3869176340 -> j1001608306;
	j1001608306 [label="時々思うわ\nこれが問題みたいに単純だったら\nそうだったら解決できる、 ¿sí?\n吐き出して、叩き出せるのにって jajaja",shape=box,color=blue];
		j1001608306 -> j2497910439;
	j2497910439 [label="問題とは解決できるもの\n問題には答えがあるもの\nLos sentimientos no se arreglan\nもちろん、試したけど",shape=box,color=blue];
		j2497910439 -> j3574700561;
		j2497910439 -> j609182302;
	j3574700561 [label="でも、喜べることもたくさんあるだろう。",shape=box,color=red];
		j3574700561 -> j987109690;
	j609182302 [label="デュヴィリで、「感情を矯正する」のは悪手になりえるって身に染みたよ。",shape=box,color=red];
		j609182302 -> j3516346123;
	j987109690 [label="Ay, sí, その通り\nその通りって分かってるわ\n時々望むのよ\nアタシのそういう所を理解してる人が皆\nそれを考えないことを",shape=box,color=blue];
		j987109690 -> j1719291702;
	j3516346123 [label="Síí...\nでも時々魅力的に見えるの jajaja\n全部なくなってしまえば\nでも末路は教えてくれたものね\n何も感じなくなった時の",shape=box,color=blue];
		j3516346123 -> j2553304550;
	j1719291702 [label="自身が違う自分だったらと願う\nでもアタシはアタシ\nそしてそれを詫びるのもやめた\nずっと昔に",shape=box,color=blue];
		j1719291702 -> "Chat ends.";
	j2553304550 [label="あんなの誰にも味わってほしくない\nAlbrechtならいいか\nPinche güey\nそれがなくとも奴の心は冷たすぎるケド",shape=box,color=blue];
		j2553304550 -> j4156474481;
		j2553304550 -> j2318569581;
	j4156474481 [label="気分転換に何かできることはある？　それともゆっくりしようか？",shape=box,color=red];
		j4156474481 -> j2604797533;
	j2318569581 [label="彼が長期的な視点で動いていることを願うばかりだ。",shape=box,color=red];
		j2318569581 -> j1953303119;
	j2604797533 [label="えーと、そうね\n正直わからない\nゆっくりするのがいいかも\nそれか殺しに出かけるか\n¿Te quedas?, ¿o vamos a matar cosas? \n選択肢が多いわ",shape=box,color=blue];
		j2604797533 -> j1557217654;
		j2604797533 -> j3818804412;
	j1953303119 [label="あのcabrónに望むのはただ一つ\nエレベーターに長く乗ること\nアタシと一緒に\nあとバットも一緒に",shape=box,color=blue];
		j1953303119 -> j416947272;
	j1557217654 [label="今日はゆっくりしよう。",shape=box,color=red];
		j1557217654 -> j4074455537;
	j3818804412 [label="狩りに出かけるのがいい。",shape=box,color=red];
		j3818804412 -> j1364368780;
	j416947272 [label="そのイメージがアタシの元気づけになるわ\nJajaja",shape=box,color=blue];
		j416947272 -> j3819368348;
	j4074455537 [label="いいわね\nバーでM&Vと一緒に\nカード遊びもアリね\n気分転換になるかも",shape=box,color=blue];
		j4074455537 -> j3819368348;
	j1364368780 [label="Jajajaいいわね\nアタシの思考から痛みを取り除きましょう\n他人に痛みを植え付けることで",shape=box,color=blue];
