		j3525909101 -> j2183338561;
	j443261964 [label="JAJAJAアンタを緊急連絡先にしないよう覚えとくわ\nSííí, 彼女は時間を超えたけどここに戻ってきた\n次元アルキなんちゃらのため\nけどそれと…　アタシたちのため、と思う",shape=box,color=blue];
