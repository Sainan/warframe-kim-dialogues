		j580547789 -> j1937779921 [label=false,color=brown];
	j4139917595 [label="彼女が逃げ出したがったこともムリはない\nアタシにできてたら、そうしてた\nでも\n彼女はいなくなっていないって気付いた？",shape=box,color=blue];
		j4139917595 -> j2501263691;
		j4139917595 -> j88323344;
	j1937779921 [label="彼女が逃げ出したがったこともムリはない\nアタシにできてたら、そうしてた\n彼女がもっと年取ったら、痛みは消える",shape=box,color=blue];
