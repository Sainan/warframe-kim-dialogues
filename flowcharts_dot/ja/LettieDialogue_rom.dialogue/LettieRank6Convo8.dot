		j2952785461 -> j776587099;
	j1509355899 [label="自分が怖がる側になって、世界中が敵だと感じられるのがどんな気持ちになるかか分からせてやりたい\n皆が自分を笑っていると\n嘲笑っていると",shape=box,color=blue];
		j1509355899 -> j2428916332;
	j776587099 [label="誰も傷つけるなんて言ってない\nああいうタイプは知ってる\n臆病者、どいつもこいつも、安全地帯だとわかってるから言葉を振り回す",shape=box,color=blue];
		j776587099 -> j1509355899;
	j2428916332 [label="アタシみたいな見た目の子供時代がどうだったかわかる？\nこんな話し方の？\nこんな服装をした？\n軍事基地で、そうじゃない子どもに囲まれて？",shape=box,color=blue];
		j2428916332 -> j731426195;
	j731426195 [label="ボコボコにされて帰ってくる方が多い、蔑ろにされるのは許さないから\nMi mamá はそんな時いつも舌打ちして、目を付けられないようにしろと言う\n¿Quedarme callada?\nふざけるな",shape=box,color=blue];
