	j2645052256 [label="Sííí, 次元アルキ云々\nそれと…　アタシたちのため、と思う",shape=box,color=blue];
		j2645052256 -> j1491959667;
	j2183338561 [label="時には時間がかかる\nでもできるなら彼女を助けてみせる\n彼女が医学に興味があるのは明らかよjajaja\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j2183338561 -> j4249271804;
	j1491959667 [label="彼女といっしょにいるのは好きよ\n彼女もそれを分かってると思う\n手術でアタシの援助をするのが好きみたいだけど…\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
