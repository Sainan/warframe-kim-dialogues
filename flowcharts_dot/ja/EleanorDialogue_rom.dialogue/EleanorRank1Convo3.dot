	163 [label="なるべく主観で。",shape=box,color=blue];
		163 -> 164;
		163 -> 165;
		163 -> 166;
	164 [label="Voidは自分に不可能を可能にする力を与えてくれる。エネルギー光線を撃ったり、実体を消失させたり、そんなところ。自分が来たところでは、それがWARFRAMEの力の源なんだ。",shape=box,color=red];
		164 -> 201;
	165 [label="Voidは両親を狂わせた。",shape=box,color=red];
		165 -> 167;
	166 [label="Voidは自分にとっての故郷、忘れるほどの時間を過ごした。Voidあってこそ今の自分がいる。それとも自分が形作ったのか、そこは明らかではないけど。",shape=box,color=red];
		166 -> 169;
	201 [label="待って。待って。",shape=box,color=blue];
		201 -> 202;
	167 [label="ごめんなさい。聞いた私が不謹慎だったわ。",shape=box,color=blue];
		167 -> 168;
	169 [label="ほうほう。興味が増したわ。",shape=box,color=blue];
		169 -> 170;
	202 [label="Voidは奇跡のエンジン、と言いたいの？",shape=box,color=blue];
