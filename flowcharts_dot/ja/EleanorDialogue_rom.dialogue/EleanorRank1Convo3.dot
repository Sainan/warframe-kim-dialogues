	182 [label="それは現実だったの？　夢のような感じじゃなくて？",shape=box,color=blue];
		182 -> 189;
	180 [label="Voidはそれを具現化して自分はそれを体験した。そしてそこは牢獄となった。でもそれは別の話。",shape=box,color=red];
		180 -> 181;
	206 [label="そして今の私には力がある。精神操作とか。顔を溶かしたりとか。",shape=box,color=blue];
