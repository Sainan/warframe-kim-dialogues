		157 -> 160;
	158 [label="Voidが何なのか誰も理解していない。それは次元であり、エネルギー源であり、空間の近道であり、オロキンが隠れた場所でもあって…",shape=box,color=red];
		158 -> 161;
	159 [label="ごめんなさいね。昔からの癖で。",shape=box,color=blue];
		159 -> 162;
	160 [label="そう。",shape=box,color=blue];
		160 -> 163;
	161 [label="興味深いけど、複雑そうね。私が聞きたいのはあなたにとって何を意味するかよ。見た感じ、その、生命線みたいだし。文字通り。",shape=box,color=blue];
		161 -> 164;
		161 -> 165;
		161 -> 166;
	162 [label="私はもうジャーナリストでもないし、あなたはスクープでもない。ただ深い好奇心があるだけなの。",shape=box,color=blue];
		162 -> 164;
		162 -> 165;
