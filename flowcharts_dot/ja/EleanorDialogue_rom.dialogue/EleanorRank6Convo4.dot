digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"EleanorRank6Convo4 begins." [color=orange];
		"EleanorRank6Convo4 begins." -> j662384996;
	j662384996 [label="シャワーを浴びている時に、突然、奇妙な小さな声が、これまで思いもしなかったことを問いかけるようなことある？",shape=box,color=blue];
		j662384996 -> j749954302;
		j662384996 -> j1852817563;
		j662384996 -> j1890263590;
	j749954302 [label="いや、ない。[閉じる]",shape=box,color=red];
		j749954302 -> "Chat ends.";
	j1852817563 [label="「ルアがまた空に現れた時地球の人たちはどう思っただろう？」とか？",shape=box,color=red];
		j1852817563 -> j3521247559;
	j1890263590 [label="「オペレーター！　クブロウの剥製を作るのはどうでしょう？」みたいな？",shape=box,color=red];
		j1890263590 -> j3021157683;
	"Chat ends." [color=orange];
	j3521247559 [label="そう、そういうの。",shape=box,color=blue];
		j3521247559 -> j2427224740;
	j3021157683 [label="今のOrdisね。よく言う。",shape=box,color=red];
		j3021157683 -> j1845007813;
	j2427224740 [label="待って",shape=box,color=blue];
		j2427224740 -> j2354181535;
	j1845007813 [label="そうなの。じゃなくて、内なる声のことよ。",shape=box,color=blue];
		j1845007813 -> j338464374;
	j2354181535 [label="ルアって消えたの？",shape=box,color=blue];
		j2354181535 -> j3828424863;
	j338464374 [label="衛生管理という重要な仕事中に脳の一部がフル稼働する感じの。",shape=box,color=blue];
		j338464374 -> j3685185468;
	j3828424863 [label="どれくらいの間？　どこへ行ったの？　潮はどうなったの？",shape=box,color=blue];
		j3828424863 -> j2515670903;
		j3828424863 -> j1759517848;
	j3685185468 [label="私の場合はいつものことね。不思議なくらい奇妙なやつ。最近だと本当に自分の脳から発した思考なのか疑うくらい。",shape=box,color=blue];
		j3685185468 -> j1703101446;
	j2515670903 [label="順番に答えると：知らない、Void、知らない。",shape=box,color=red];
		j2515670903 -> j3216031025;
	j1759517848 [label="古の大戦の終盤で、LotusがルアをVoidに転送したんだ。子供が元に戻したのは最近の話だ。",shape=box,color=red];
		j1759517848 -> j2375405967;
	j1703101446 [label="中には絵画にしたものもあるわ。",shape=box,color=blue];
		j1703101446 -> j3216031025;
	j3216031025 [label="いや、今この話はよしておきましょう。",shape=box,color=blue];
		j3216031025 -> j2211452626;
	j2375405967 [label="潮に関しては知らない。",shape=box,color=red];
		j2375405967 -> j2953540061;
	j2211452626 [label="とにかく、シャワーでの考え事。今朝のは特に最高だったわ。",shape=box,color=blue];
		j2211452626 -> j3598536742;
	j2953540061 [label="Lotusはどうやってルア丸ごとを転送したの！？",shape=box,color=blue];
		j2953540061 -> j3216031025;
	j3598536742 [label="「神々が実在したら？」って。",shape=box,color=blue];
		j3598536742 -> j3454606595;
	j3454606595 [label="のぼせるくらい考えちゃって。冷水で正気に戻ったわ。",shape=box,color=blue];
		j3454606595 -> j2327758783;
		j3454606595 -> j1965234692;
		j3454606595 -> j779527311;
	j2327758783 [label="それって変なこと？　至って普通の質問に聞こえる。",shape=box,color=red];
		j2327758783 -> j3453160874;
	j1965234692 [label="…神々が実在しないと思う人がいるの？　Lettieは信じているみたいだけど。",shape=box,color=red];
		j1965234692 -> j507969670;
	j779527311 [label="恐ろしい考えだね。",shape=box,color=red];
		j779527311 -> j415750604;
	j3453160874 [label="これよこれ、だからあなたのこういう会話をするのが好きなの。",shape=box,color=blue];
		j3453160874 -> j2536708177;
	j507969670 [label="何を言っているの。神々が実在するなんて誰も思わないわよ。机や椅子みたいな意味ではね。",shape=box,color=blue];
		j507969670 -> j2017449450;
	j415750604 [label="そうでしょう？　世界が人類にメッセージを送っていると感じた時、もしそれが事実だったら？",shape=box,color=blue];
		j415750604 -> j382796786;
	j2536708177 [label="あなたの人生はあまりにも破天荒で、あなたにとって神々の存在なんてピザのトッピングの組み合わせを考えるのと同等なのよね。",shape=box,color=blue];
		j2536708177 -> j2357092175;
	j2017449450 [label="本物の神は村にある井戸や野外トイレみたいなもの。かつて人々が持っていたものよ。",shape=box,color=blue];
		j2017449450 -> j2667547978;
	j382796786 [label="理のすべてが、自分たちがそれに値するからではなく、ただそれが物事のあり方だからという理由で、卑劣で不死のろくでなしの手に握られている世界を想像してみて。",shape=box,color=blue];
		j382796786 -> j3982318552;
	j2357092175 [label="あなたなら神に会ったことがあるかもしれないし。無関心のモノがそれなら。",shape=box,color=blue];
		j2357092175 -> j2545749841;
	j2667547978 [label="今は単なる象徴、それか比喩、あるいはそれに似たナンセンスね。",shape=box,color=blue];
		j2667547978 -> j885969322;
		j2667547978 -> j184286544;
	j3982318552 [label="狂った話、かつて人々はそう生きてきたのよ。それが彼らの現実であり、日々の生活だったの。",shape=box,color=blue];
		j3982318552 -> j1167350683;
	j2545749841 [label="その話で思い出した、Zarimanでの話。無関心のモノに初めて出会った時。",shape=box,color=red];
		j2545749841 -> j3419565106;
	j885969322 [label="もしかしたら、人々は以前ほど恐れていないのかも？",shape=box,color=red];
		j885969322 -> j3514821093;
	j184286544 [label="ソルとルアがEleanorたちの神さまじゃないの？",shape=box,color=red];
		j184286544 -> j3553656140;
	j1167350683 [label="彼らにとって神々は天気と同じくらい現実的であり、天気と同等に気にかけていた。",shape=box,color=blue];
		j1167350683 -> j1962140715;
	j3419565106 [label="もちろん、その時はそれが何なのか知らなかった。でも何を言ったかは覚えている。",shape=box,color=red];
		j3419565106 -> j3501185605;
	j3514821093 [label="多分そうね。",shape=box,color=blue];
		j3514821093 -> j1391960648;
	j3553656140 [label="まぁ、そうだけど。でも単なる天体でもあるわ。",shape=box,color=blue];
		j3553656140 -> j1731411040;
	j1962140715 [label="オロキン時代の生活とそれほど違いはないようだけど。",shape=box,color=red];
		j1962140715 -> j1729640421;
	j3501185605 [label="自分はそれに光を貸してもいいと言った。「ありごとよ、ガキンチョ。使わせて貰うぜ。」とそれは応えた。",shape=box,color=red];
		j3501185605 -> j683565220;
	j1391960648 [label="理由もわかる気がするわ。",shape=box,color=blue];
		j1391960648 -> j487345465;
	j1731411040 [label="ブリタニアは国であり、名前や定義があるけれど、同時にただの土と岩の塊でもあるの。両立が可能なの。",shape=box,color=blue];
		j1731411040 -> j4162252793;
	j1729640421 [label="不死、ろくでなし、支配者だから支配した…",shape=box,color=red];
		j1729640421 -> j2661532327;
	j683565220 [label="寒気のする話ね。",shape=box,color=blue];
		j683565220 -> j1998301520;
	j487345465 [label="光よ。",shape=box,color=blue];
		j487345465 -> j97054544;
	j4162252793 [label="晴れた素敵な日に外に出て、感謝の気持ちでソルを見上げて「ありがとう！」と叫ぶことができる。本心から。実に人間らしいこと。",shape=box,color=blue];
		j4162252793 -> j2966155548;
	j2661532327 [label="そうよね。あなたには生きた神々がいた。でもそれをあなたは殺した。",shape=box,color=blue];
		j2661532327 -> j3302888186;
	j1998301520 [label="古い民話ではよく、悪魔は法の文言を厳格に従う存在として登場するわ。",shape=box,color=blue];
		j1998301520 -> j2973393332;
	j97054544 [label="結局のところ、ソルとルアとは何？　人がそれを神々と崇めるそれ以前に？　「光」なのよ。",shape=box,color=blue];
		j97054544 -> j3200718944;
		j97054544 -> j1452770760;
	j2966155548 [label="でも最近では誰もソルやルアが人間の女性を孕ませてそこから王が生まれたなんて信じないわ。",shape=box,color=blue];
		j2966155548 -> j3990805367;
	j3302888186 [label="（勘違いしないで、それは素敵だと思うわ）",shape=box,color=blue];
		j3302888186 -> j1844823620;
	j2973393332 [label="何かを誓ったと思われているのかしら？　あなたの「光」を？",shape=box,color=blue];
		j2973393332 -> j3849146680;
		j2973393332 -> j2916300983;
	j3200718944 [label="確かに。どこへ行っても、光は善を象徴する。",shape=box,color=red];
		j3200718944 -> j1225825094;
	j1452770760 [label="長い間、人類が与えられた唯一の光。",shape=box,color=red];
		j1452770760 -> j1225825094;
	j3990805367 [label="昔はそれを本気で信じていた人々がいた。今ではそれが単なる伝説だというのが分かっている。人類はその段階を過ぎているの。",shape=box,color=blue];
		j3990805367 -> j2319089082;
		j3990805367 -> j592915361;
	j1844823620 [label="それは子供のほうの話だ。自分はテンノの反逆に参加していない。",shape=box,color=red];
		j1844823620 -> j3418702179;
	j3849146680 [label="あれは「取り引きをした」と言っていた。だから自分はあれに…　何か借りがあるのかも。",shape=box,color=red];
		j3849146680 -> j2633980260;
	j2916300983 [label="持っていたグローブライトのことだと思うけど、実際どうだろうか。",shape=box,color=red];
		j2916300983 -> j2633980260;
	j1225825094 [label="そう！",shape=box,color=blue];
		j1225825094 -> j379329817;
	j2319089082 [label="神々と人間が…　え？",shape=box,color=red];
		j2319089082 -> j4214286813;
	j592915361 [label="神々を親に持つ王様？　デタラメ言うのはオロキンだけかと思った。",shape=box,color=red];
		j592915361 -> j4214286813;
	j3418702179 [label="Margulisの「特別な子供たちのためのプログラム」に参加していないし、WARFRAMEも貰えなった、古の大戦で戦わなかった。",shape=box,color=red];
		j3418702179 -> j1046128099;
	j2633980260 [label="一つだけ確かなのは、それは駆け引きが好きなことだ。",shape=box,color=red];
		j2633980260 -> j3020267598;
	j379329817 [label="そしてある日、洞窟に住む大柄な女性にいじめられた小柄の洞窟男が、石をぶつけ合わせるというトリックを思いついて、そこから歴史は変わった。",shape=box,color=blue];
		j379329817 -> j1112625721;
	j4214286813 [label="どこでもある話よ。世界中でね。",shape=box,color=blue];
		j4214286813 -> j1530031346;
	j1046128099 [label="…そうしたかったの？",shape=box,color=blue];
		j1046128099 -> j3147156586;
		j1046128099 -> j3979186002;
		j1046128099 -> j3186366108;
	j3020267598 [label="+20 Chemistry",color=orange];
		j3020267598 -> j367457888;
	j1112625721 [label="いつでも光が灯せるようになった！　空の光から独立したのよ！",shape=box,color=blue];
		j1112625721 -> j1164345076;
	j1530031346 [label="自分が傲慢な司祭で、ソルの福音を新世界の「未開人」に広めるために海を渡ったところ、彼らがすでにソルのことをすべて知っているだけでなく、ソルの実子が彼らを支配していることに気付いた時のことを想像してごらんなさい。",shape=box,color=blue];
		j1530031346 -> j1423592316;
	j3147156586 [label="正直わからない。",shape=box,color=red];
		j3147156586 -> j3750272696;
	j3979186002 [label="いやだ、絶対に。",shape=box,color=red];
		j3979186002 -> j2779193;
	j3186366108 [label="そうしたかった。",shape=box,color=red];
		j3186366108 -> j1571431381;
	j367457888 [label="そう。今日なにしようと、誰といようと、私かArthurといても…　気を付けて。",shape=box,color=blue];
		j367457888 -> j3435349021;
	j1164345076 [label="今の私たちを見てみなさい。どこでも光はある。その価値を弱めてしまったの。",shape=box,color=blue];
		j1164345076 -> j2545749841;
	j1423592316 [label="尻尾を巻いて家に走って帰るか、その場で改心するでしょうね。",shape=box,color=blue];
		j1423592316 -> j1724463031;
		j1423592316 -> j3242186862;
	j3750272696 [label="それもそうね。それでいいと思うわ。",shape=box,color=blue];
		j3750272696 -> j2991126293;
	j2779193 [label="安心したわ。今以上に最悪な人生を歩んでいた可能性があると思うなら、今を祝うべきなのでしょうね？",shape=box,color=blue];
		j2779193 -> j2991126293;
	j1571431381 [label="理解できる、と思うわ。大いなる機会を見逃した、そう感じているのね？",shape=box,color=blue];
		j1571431381 -> j2991126293;
	j3435349021 [label="Check boolean EleanorDating",color=orange];
		j3435349021 -> j4125615015 [label=true,color=green];
		j3435349021 -> j3960982675 [label=false,color=brown];
	j1724463031 [label="Eleanorは本当に神々が実在すると思う？　それとも実在するかもしれないということに恐れているだけ？",shape=box,color=red];
		j1724463031 -> j3010923159;
	j3242186862 [label="なるほど。つまり、もし過去の人々が正しかったらって言いたいの？",shape=box,color=red];
		j3242186862 -> j3010923159;
	j2991126293 [label="Check boolean EleanorDating",color=orange];
		j2991126293 -> j3828547347 [label=true,color=green];
		j2991126293 -> j2538439276 [label=false,color=brown];
	j4125615015 [label="あなたを愛しているわ。それを阻む神がいるなら、その神が信じる神に祈らせてやるわ。",shape=box,color=blue];
		j4125615015 -> "Chat ends.";
	j3960982675 [label="あなたは大切な親友よ。あなたを奪おうとするのが神であっても、タダでは済ませないわ。",shape=box,color=blue];
		j3960982675 -> "Chat ends.";
	j3010923159 [label="昔は今の私よりずっとひねりのない物質的現実を過信していたわ。",shape=box,color=blue];
		j3010923159 -> j2354200431;
	j3828547347 [label="+20 Chemistry",color=orange];
		j3828547347 -> j1457163801;
	j2538439276 [label="+20 Chemistry",color=orange];
		j2538439276 -> j1135213093;
	j2354200431 [label="今その考えには漂流者型の穴がぽっかり空いているけれど。",shape=box,color=blue];
		j2354200431 -> j1528102399;
	j1457163801 [label="私たちには背負う傷があるのよ、愛しい人。",shape=box,color=blue];
		j1457163801 -> "Chat ends.";
	j1135213093 [label="私たちには背負う傷があるのよ。",shape=box,color=blue];
		j1135213093 -> "Chat ends.";
	j1528102399 [label="+20 Chemistry",color=orange];
		j1528102399 -> j264893319;
	j264893319 [label="正直な話、それでいいと思っているわ。その可能性に時折脅威を感じるのもいいことよ。",shape=box,color=blue];
		j264893319 -> "Chat ends.";
}