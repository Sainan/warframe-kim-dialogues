	2391 [label="Arthurの夢をまたみたの。彼に殺される夢。",shape=box,color=blue];
		2391 -> 2394;
		2391 -> 2395;
	2392 [label="Arthurが私を殺さなければならない恐ろしい夢を何度も見るの。彼が剣を私の胸に突き刺して、私が「Eleanorはここよ、このバカタレが！」と叫んでも、その声はもう彼に届かない。そんな夢を。",shape=box,color=blue];
		2392 -> 2393;
