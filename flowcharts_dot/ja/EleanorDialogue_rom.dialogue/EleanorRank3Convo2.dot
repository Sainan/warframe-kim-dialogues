	966 [label="私は、純粋な頑固さで戦い続けるわ。",shape=box,color=blue];
		966 -> 969;
	967 [label="今年あったことを考えると、どうやってまともな計画を立てればいいの？",shape=box,color=blue];
		967 -> 970;
	968 [label="お願いだから。",shape=box,color=blue];
		968 -> 971;
	955 [label="名前があるって分かって少し落ち着いたわ。",shape=box,color=blue];
		955 -> 959;
	969 [label="憎しみ。怒り。なんでもいい。",shape=box,color=blue];
		969 -> 973;
	970 [label="希望は幻想なのかもしれない。分からないわ。",shape=box,color=blue];
		970 -> 974;
	971 [label="私はRusalkaの心を触れようとした、彼女の心の顔を触れた瞬間、スッと通り抜けた。仮面が崩れ落ちたの。",shape=box,color=blue];
		971 -> 975;
	959 [label="Update boolean EleanorIndifference",color=orange];
		959 -> 972;
	973 [label="何もしないよりマシ。従順な降伏はゴメンよ。",shape=box,color=blue];
		973 -> 978;
	974 [label="でも希望があって欲しいと思う私もいる。",shape=box,color=blue];
		974 -> 977;
	975 [label="その中にあったのは…",shape=box,color=blue];
		975 -> 976;
	972 [label="あれを心で触れたの。Rusalkaの心を読むつもりで…　でも、触った表面が、湿ったスポンジの石膏ボードみたいに崩れ落ちて、気付いたらその中に浸かっていた。もがき苦しみながら。",shape=box,color=blue];
		972 -> 976;
	978 [label="覚悟はできている。",shape=box,color=blue];
		978 -> 979;
	977 [label="でもそうね。それが現実よ。たとえ闇の中に迷い込んでも、少なくてもお互いがいるわよね。",shape=box,color=blue];
		977 -> 980;
	976 [label="「カレンチュア」という言葉があるわ。かつて船乗りを悩ませたという、狂気の類。辺りのあおい海が、あおく茂った草原と思い込んでしまう病気よ。",shape=box,color=blue];
		976 -> 981;
	979 [label="Chat ends.",color=orange];
	980 [label="Chat ends.",color=orange];
	981 [label="船乗りはその美しさから、船から草原へ飛び込んで、駆け回ろうとするの。他が止めようとすると、暴力的になる。",shape=box,color=blue];
		981 -> 982;
	982 [label="その船乗りのように、私は飛び込んだの。次の瞬間、凍てつく闇の中で目覚めたわ。",shape=box,color=blue];
		982 -> 983;
	983 [label="Update boolean EleanorIndifference2",color=orange];
		983 -> 984;
		983 -> 986;
	984 [label="これ以上この話は危険だ。",shape=box,color=red];
		984 -> 985;
	986 [label="ここにいる。続けて。",shape=box,color=red];
		986 -> 987;
	985 [label="あ、そう。",shape=box,color=blue];
		985 -> 988;
	987 [label="この感じは言葉では表せない。世界を見渡して、確信する。私たちが思う日常：建物、車、人、職業、仕事、ルーティーン、それらは全て底のない恐怖を覆う薄い殻でしかない。人々がそれに気づいたら、悲鳴が響き渡り、止むことがない。",shape=box,color=blue];
		987 -> 989;
	988 [label="やっとの思いでこの話を持ち出したのに、何よ？　悪魔を呼び出すのが怖くて触れないつもり？",shape=box,color=blue];
		988 -> 990;
	989 [label="その殻を私は突き破ったの。",shape=box,color=blue];
		989 -> 992;
	990 [label="夜中悲鳴が聞こえたら、それ私だから。",shape=box,color=blue];
		990 -> 991;
	992 [label="無ではなかった。そうだったら耐えられた。それは無限に続いて、ただ寒い空間ではなかった。そこには私と一緒になにかがいたの。",shape=box,color=blue];
		992 -> 993;
		992 -> 994;
		992 -> 995;
	991 [label="Chat ends.",color=orange];
	993 [label="目？",shape=box,color=red];
		993 -> 997;
	994 [label="壁に閉じ込められた男？",shape=box,color=red];
		994 -> 997;
	995 [label="なにがあったの？",shape=box,color=red];
		995 -> 996;
	997 [label="わからない。でもいたことは確か。気付かれていた。まるで像が目の前を通るハエに気付くように。",shape=box,color=blue];
		997 -> 998;
	996 [label="+5 Chemistry",color=orange];
		996 -> 997;
	998 [label="「こんな大きな存在が私の存在を知るはずがない」と、その時は思ったわ。",shape=box,color=blue];
		998 -> 999;
	999 [label="それは私に対する完全な没却、とてつもない無関心のように感じられて、私は自身という存在を消滅したかった。",shape=box,color=blue];
		999 -> 1000;
		999 -> 1001;
	1000 [label="分かる…",shape=box,color=red];
		1000 -> 1002;
	1001 [label="それでどうしたの？",shape=box,color=red];
		1001 -> 1002;
	1002 [label="嫌われていたらまだ耐えられたと思う。そうすれば私に存在価値が、意義があったから。でもそれは私を無意味なものとみなし、私をどう観ているか私は観た。ただの点。無いに等しいもの。",shape=box,color=blue];
		1002 -> 1003;
	1003 [label="私がこれまでに経験したこと、嬉しい瞬間、笑い、Eleanor Nightingaleのすべてが、嵐に吹き飛ばされた。",shape=box,color=blue];
		1003 -> 1004;
	1004 [label="それは私の光が消えていくのを感じ、そして、小さな満足感を感じた、はずよ。まるで押し潰して喜んだかのような、爪に挟まったノミを取り除いたような。",shape=box,color=blue];
		1004 -> 1005;
	1005 [label="でもこうして帰ってきた、そうだろ？　Eleanorは今ここにいる。存在を証明したんだ。",shape=box,color=red];
		1005 -> 1006;
	1006 [label="本当にそうかしら？",shape=box,color=blue];
		1006 -> 1007;
	1007 [label="まだいるのでしょ、あれが。",shape=box,color=blue];
		1007 -> 1008;
		1007 -> 1009;
	1008 [label="いる。でもEleanorもここにいる。",shape=box,color=red];
		1008 -> 1011;
	1009 [label="宇宙が大きくて寒くて暗いからって、星が燃え尽きることはない。",shape=box,color=red];
		1009 -> 1010;
	1011 [label="どんなに決まり文句を深淵に投げ捨てても、最後には無関心のモノが勝つの。",shape=box,color=blue];
		1011 -> 1012;
	1010 [label="でも燃え尽きるのよ。いつかは。宇宙の熱的死。",shape=box,color=blue];
		1010 -> 1011;
	1012 [label="これが狂わないことの欠点よ。常に思考がクリアである呪い。",shape=box,color=blue];
		1012 -> 1013;
	1013 [label="あなたなら理解できるでしょう。スズメの卵みたいに砕かれたり、脳みそをドラッグで焼き切られたとしても、これを…　知ることよりは苦しまなかった。",shape=box,color=blue];
		1013 -> 1014;
	1014 [label="この会話からまだ逃げ出していないのが驚きよ。",shape=box,color=blue];
		1014 -> 1015;
		1014 -> 1016;
	1015 [label="エントロピーは理解している。大いなる無関心がそれなのかもしれない。最終的にそれが勝つのかもしれない。でも確かなのは、今それに勝たせないということだけ。",shape=box,color=red];
		1015 -> 1017;
	1016 [label="Eleanorがさっさと決断するのを待っている。楽な道を取って狂うか、それともそのソファから立ち上がって戦うかを。",shape=box,color=red];
		1016 -> 1018;
	1017 [label="生き残れるなら、全員で生き残る。",shape=box,color=red];
		1017 -> 1020;
	1018 [label="どうやって戦えと言うの！？",shape=box,color=blue];
		1018 -> 1019;
	1020 [label="私の存在への絶望を戦術的と捉えるつもり？　まるでArthurね。",shape=box,color=blue];
		1020 -> 1021;
	1019 [label="あなたもARTHURもそれしか分からないの！？　戦うことしか！？",shape=box,color=blue];
		1019 -> 1022;
	1021 [label="正直、言っても信じないかもだけど、Eleanorのことを気に掛けている。",shape=box,color=red];
		1021 -> 1027;
	1022 [label="存在の根底にある無意味さに対するあなたの答えは「どうやったら殴れるか」だと言うの！？",shape=box,color=blue];
		1022 -> 1023;
	1027 [label="私もよ。私たちは仲間なのだから。色んなことを共に乗り越えてきた。",shape=box,color=blue];
		1027 -> 1028;
	1023 [label="あなたと共通点があると思った私が信じられない。",shape=box,color=blue];
		1023 -> 1024;
	1028 [label="でもこれだけは言わせて。Eleanor号が血の海だろうが、常闇の沼に沈みそうなら、船に乗り合わせないことね。",shape=box,color=blue];
		1028 -> 1030;
	1024 [label="バカみたい。",shape=box,color=blue];
