	j1543988218 [label="そうね、悪くはないわ",shape=box,color=blue];
		j1543988218 -> j254897712;
	j1315099464 [label="絶対知っているはずだけど、いいでしょう、知らない仮定で話を進めるわ。",shape=box,color=blue];
		j1315099464 -> j857165371;
	j744620542 [label="素晴らしい。自然免疫の好例ね！",shape=box,color=blue];
