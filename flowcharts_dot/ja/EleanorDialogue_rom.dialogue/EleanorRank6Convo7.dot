	j857165371 [label="Arthurは大抵ごく普通に喋るけど、時に「あの声」をやるのよ。",shape=box,color=blue];
		j857165371 -> j3148041996;
	j3188260485 [label="あなたの体を医学発展のため寄付しないとね。",shape=box,color=blue];
