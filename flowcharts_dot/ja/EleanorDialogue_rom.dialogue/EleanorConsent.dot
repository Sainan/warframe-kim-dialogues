	3319 [label="このことで苛立たしいのは、先にあなたの思考からこのことを知ったことかしら。",shape=box,color=blue];
		3319 -> 3320;
	3317 [label="Chat ends.",color=orange];
	3320 [label="言わなくても、丁寧に許しを貰えるかどうか、聞きに来たと思うけど。こんにちは。",shape=box,color=blue];
		3320 -> 3321;
	3321 [label="あなたがするであろう質問に対しての答えは、ふくれ面で腕を組みながら「もちろん、いいわよ」になるわ。少し見えたあなたの素敵な妄想で、気持ちが高まったあなたが踊りまわる姿は無視できそうにないけど。",shape=box,color=blue];
		3321 -> 3322;
	3322 [label="おかげでその妄想が私の妄想にもなって、この場所と時代から出られないことに不満しているわ。どうも。",shape=box,color=blue];
		3322 -> 3323;
	3323 [label="ごめん。ちゃんと話しに来るつもりだった。こう言った話はしたことがないから。Eleanorの気持ちを知りたかった。",shape=box,color=red];
		3323 -> 3324;
	3324 [label="もちろん大丈夫よ！　あなたの精神からその人の姿が見えるわ。あなたがその人を信じるなら、私も信じる。",shape=box,color=blue];
		3324 -> 3325;
	3325 [label="ただ直接会えないのが残念ね。",shape=box,color=blue];
		3325 -> 3326;
	3326 [label="+20 Chemistry",color=orange];
		3326 -> 3327;
