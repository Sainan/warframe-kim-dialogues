	"Chat ends." [color=orange];
	j3364311394 [label="Check boolean EleanorConsentComplete",color=orange];
		j3364311394 -> "Chat ends." [label=true,color=green];
		j3364311394 -> j2465015694 [label=false,color=brown];
	j3528729371 [label="Check boolean EleanorPolyamorySuccess",color=orange];
		j3528729371 -> j3364311394 [label=true,color=green];
		j3528729371 -> "Chat ends." [label=false,color=brown];
	j2465015694 [label="このことで苛立たしいのは、先にあなたの思考からこのことを知ったことかしら。",shape=box,color=blue];
		j2465015694 -> j3068586032;
	j3068586032 [label="言わなくても、丁寧に許しを貰えるかどうか、聞きに来たと思うけど。こんにちは。",shape=box,color=blue];
		j3068586032 -> j766920721;
	j766920721 [label="あなたがするであろう質問に対しての答えは、ふくれ面で腕を組みながら「もちろん、いいわよ」になるわ。少し見えたあなたの素敵な妄想で、気持ちが高まったあなたが踊りまわる姿は無視できそうにないけど。",shape=box,color=blue];
		j766920721 -> j2306362887;
	j2306362887 [label="おかげでその妄想が私の妄想にもなって、この場所と時代から出られないことに不満しているわ。どうも。",shape=box,color=blue];
		j2306362887 -> j504256142;
	j504256142 [label="ごめん。ちゃんと話しに来るつもりだった。こう言った話はしたことがないから。Eleanorの気持ちを知りたかった。",shape=box,color=red];
		j504256142 -> j2401083558;
	j2401083558 [label="もちろん大丈夫よ！　あなたの精神からその人の姿が見えるわ。あなたがその人を信じるなら、私も信じる。",shape=box,color=blue];
		j2401083558 -> j3725245137;
	j3725245137 [label="ただ直接会えないのが残念ね。",shape=box,color=blue];
		j3725245137 -> j3681135575;
	j3681135575 [label="+20 Chemistry",color=orange];
		j3681135575 -> j1476054549;
	j1476054549 [label="でも、あなたを通して間接的に色々できるかもしれないわね。面白そう。",shape=box,color=blue];
		j1476054549 -> j298331240;
	j298331240 [label="Boolean EleanorConsentComplete is now true.",color=orange];
		j298331240 -> "Chat ends.";
}