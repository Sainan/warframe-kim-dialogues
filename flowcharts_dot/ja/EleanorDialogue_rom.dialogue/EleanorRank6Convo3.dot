digraph {
	2888 [label="EleanorRank6Convo3 begins.",color=orange];
		2888 -> 2889;
	2889 [label="気づいたか知らないけど、本当に素敵なことが起きたわ。",shape=box,color=blue];
		2889 -> 2890;
	2890 [label="Arthurがまた歌ってる。よかったわ。",shape=box,color=blue];
		2890 -> 2891;
		2890 -> 2892;
		2890 -> 2893;
	2891 [label="なんで辞めたの？",shape=box,color=red];
		2891 -> 2894;
	2892 [label="決して好みではないけど、彼が楽しいなら…",shape=box,color=red];
		2892 -> 2895;
	2893 [label="よかった。上手いしね。",shape=box,color=red];
		2893 -> 2896;
	2894 [label="あがり症。それだけの話。",shape=box,color=blue];
		2894 -> 2897;
	2895 [label="率直に言ってくれて助かるわ。",shape=box,color=blue];
		2895 -> 2898;
	2896 [label="でしょ？",shape=box,color=blue];
		2896 -> 2899;
	2897 [label="Arthurほど勇敢な人がそんな怖がるなんて。",shape=box,color=red];
		2897 -> 2900;
	2898 [label="それでも気にかけてくれるだけで嬉しいから。",shape=box,color=blue];
		2898 -> 2901;
	2899 [label="人前に出て歌わせるのがどれだけ大変だったか考えると特にね…",shape=box,color=blue];
		2899 -> 2902;
	2900 [label="何が原因なの？",shape=box,color=red];
		2900 -> 2903;
	2901 [label="特に、彼が歌うことを辞めたのには、あなたが知るはずもない理由があるのだから。",shape=box,color=blue];
		2901 -> 2904;
		2901 -> 2905;
	2902 [label="…最初は発狂しかけたしね。",shape=box,color=blue];
		2902 -> 2906;
	2903 [label="名前よ。結局のところは。",shape=box,color=blue];
		2903 -> 2907;
	2904 [label="周りの支えが足りなかったから？",shape=box,color=red];
		2904 -> 2908;
	2905 [label="酷い観客が多かったから？",shape=box,color=red];
		2905 -> 2908;
	2906 [label="80年代の祝祭キャロルコンサート。短パンを履いた小さな男の子が「How Bright The Dew Upon That Morn」のソロを歌っている姿を想像してみなさい。",shape=box,color=blue];
		2906 -> 2909;
		2906 -> 2910;
	2907 [label="「Nightingaleって名前なのハハハじゃあ歌ってみてよ」",shape=box,color=blue];
		2907 -> 2911;
	2908 [label="同じ冗談を聞きすぎたから、が正解ね。",shape=box,color=blue];
		2908 -> 2903;
	2909 [label="想像もできない。",shape=box,color=red];
		2909 -> 2912;
	2910 [label="その曲は知らない。",shape=box,color=red];
		2910 -> 2913;
	2911 [label="同じようなバカども、同じ口上、いつもそう。そして今はViktorがそう。",shape=box,color=blue];
		2911 -> 2914;
	2912 [label="彼は真剣に取り組んでいた。何週間も練習して、でも当日になって、閉じこもってしまった。ステージに上がることを拒んでしまったの。",shape=box,color=blue];
		2912 -> 2915;
		2912 -> 2897;
	2913 [label="そう。歌ってあげてもいいけど、どんな音が出てくるか分からないから遠慮しておくわ。",shape=box,color=blue];
		2913 -> 2916;
	2914 [label="+5 Chemistry",color=orange];
		2914 -> 2917;
	2915 [label="どうやって説得したの？",shape=box,color=red];
		2915 -> 2918;
	2916 [label="クソテックロットが。この間もAoiにハッピーバースデーを歌おうとしたら、シュレッダーにかけられたウシガエルみたいな音が出たわ。",shape=box,color=blue];
		2916 -> 2919;
	2917 [label="正直、歌おうと勇気を持ったArthurに誇りを感じるわ。",shape=box,color=blue];
		2917 -> 2920;
	2918 [label="文字通りケツにケリを入れてあげたわ。自慢できる話じゃないけど。必要だった。",shape=box,color=blue];
		2918 -> 2921;
	2919 [label="辛いだろう、歌えないのは。",shape=box,color=red];
		2919 -> 2922;
	2920 [label="Chat ends.",color=orange];
	2921 [label="そもそも、彼は両親やHenshaw先生を喜ばせるために練習していたわけじゃないの。",shape=box,color=blue];
		2921 -> 2923;
	2922 [label="まぁ、大した損失じゃないわ。そもそも歌えないから。",shape=box,color=blue];
		2922 -> 2924;
	2923 [label="好きだから歌っていたの。でもスポットライトがあたった瞬間、凍ってしまった。",shape=box,color=blue];
		2923 -> 2925;
		2923 -> 2900;
	2924 [label="これまでそれっぽかったのは、寝室で当時気になっていたMandy Jellicoeのバンドに入りたくてShag Cannonsの歌詞を叫んでいた時かしら。",shape=box,color=blue];
		2924 -> 2926;
	2925 [label="どれだけ好きだったか思い出す必要があったのかも。",shape=box,color=red];
		2925 -> 2927;
	2926 [label="すると父さんがドアを叩き込んできて、「またその醜いものを聞いたらお前の口を石炭酸で洗ってやる」って脅してきたわ。",shape=box,color=blue];
		2926 -> 2928;
	2927 [label="Arthurは自身のことを忘れられる時が一番幸せなの。かつての彼を忘れて自身でいられる時が。",shape=box,color=blue];
		2927 -> 2929;
	2928 [label="（あなたの時代に「パンク」があるか知らないけど、この場合歌えないほうが必要条件だったりするのよ）",shape=box,color=blue];
		2928 -> 2930;
		2928 -> 2931;
	2929 [label="そのためのビールね。",shape=box,color=blue];
		2929 -> 2932;
	2930 [label="パンクはないけど、Skegならある。",shape=box,color=red];
		2930 -> 2933;
	2931 [label="バンドに何があったの？",shape=box,color=red];
		2931 -> 2934;
	2932 [label="それと、Velimirの存在も大きいわね。彼はArthurが選べるなら理想の父親でしょうから。",shape=box,color=blue];
		2932 -> 2935;
		2932 -> 2936;
	2933 [label="説明もなしに新用語を出すのはナシよ。",shape=box,color=blue];
		2933 -> 2937;
	2934 [label="「地元のパブでお情けの演奏機会」さえ貰えなかったわ。",shape=box,color=blue];
		2934 -> 2938;
	2935 [label="理解はできる。",shape=box,color=red];
		2935 -> 2939;
	2936 [label="VelimirとMinervaは二人の実の両親に似ている部分があると思っていた。",shape=box,color=red];
		2936 -> 2940;
	2937 [label="Skegが何なのか説明しなさい。",shape=box,color=blue];
		2937 -> 2941;
	2938 [label="Mandyが観客に向かって唾を吐くつもりだという噂が広まってね。それで終わり。残念だったわ。",shape=box,color=blue];
		2938 -> 2942;
		2938 -> 2943;
	2939 [label="Arthurはあのクマのぬいぐるみを何ヶ月も連れ回していたわ。そこにVelimirが現れたんだから。まるで運命が二人を引き合わせたみたいに…",shape=box,color=blue];
		2939 -> 2944;
	2940 [label="ええ、そうね。言い争いもまんま実家そのものね。",shape=box,color=blue];
		2940 -> 2945;
	2941 [label="響きだけだとラドストンで怪しい袋に入って売られているモノにしか聞こえないわ。",shape=box,color=blue];
		2941 -> 2946;
		2941 -> 2947;
	2942 [label="唾くらいでビビる？",shape=box,color=red];
		2942 -> 2948;
	2943 [label="唾？　テクノサイト・コーダのパーティーか何か？",shape=box,color=red];
		2943 -> 2949;
	2944 [label="+5 Chemistry",color=orange];
		2944 -> 2950;
	2945 [label="+5 Chemistry",color=orange];
		2945 -> 2951;
	2946 [label="パイプとかを叩きつけて作る音楽みたいなもの。ベントとか。コーパスのヘルメットとか。探し出せるものなら何でもね。",shape=box,color=red];
		2946 -> 2952;
	2947 [label="意味のない雑音さ。ベントキッドだけが好きなやつ。",shape=box,color=red];
		2947 -> 2953;
	2948 [label="+5 Chemistry",color=orange];
		2948 -> 2954;
	2949 [label="そういう時代だったのよ。パンクが本物だった時の。",shape=box,color=blue];
		2949 -> 2955;
	2950 [label="…ごめんなさい。憶測するのは野暮よね。彼が幸せならそれでいいわ。",shape=box,color=blue];
		2950 -> 3311;
	2951 [label="変なところでホームシックになったりするのね？",shape=box,color=blue];
		2951 -> 2956;
	2952 [label="ベントキッドたちが好きなんだ。",shape=box,color=red];
		2952 -> 2957;
	2953 [label="「意味のない雑音」ね。聞き慣れたセリフね。",shape=box,color=blue];
		2953 -> 2958;
	2954 [label="私はそうじゃなかった、断言するわ。",shape=box,color=blue];
		2954 -> 2955;
	2955 [label="…「今の私を見て貰えたらな」って思う時があるの。結構気に入ると思うわ。",shape=box,color=blue];
		2955 -> 2959;
	3311 [label="Chat ends.",color=orange];
	2956 [label="Chat ends.",color=orange];
	2957 [label="+5 Chemistry",color=orange];
		2957 -> 2960;
	2958 [label="誰かの青春時代のサウンドトラックになり得るなら、無意味ではないと思うけど。",shape=box,color=blue];
		2958 -> 2961;
	2959 [label="はぁ、何やっているのかしら、私。想い出に浸って感傷的になって。",shape=box,color=blue];
		2959 -> 2962;
	2960 [label="ふーん。生き残った者たちの音楽みたいね。もし録音する機会があれば聴いてみたいわ。",shape=box,color=blue];
		2960 -> 2963;
	2961 [label="やめとくわ。感傷的になってきちゃった。",shape=box,color=blue];
		2961 -> 2964;
	2962 [label="+5 Chemistry",color=orange];
		2962 -> 2965;
	2963 [label="モールのスピーカーで流すのはよくないかもだけど。",shape=box,color=blue];
		2963 -> 2966;
	2964 [label="Chat ends.",color=orange];
	2965 [label="仕事に戻るわ。聞いてくれてありがとう。",shape=box,color=blue];
		2965 -> 2967;
	2966 [label="Chat ends.",color=orange];
	2967 [label="Chat ends.",color=orange];
}