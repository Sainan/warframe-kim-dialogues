		2468 -> 2466;
	2466 [label="Arthurの悪夢はCallieおばあちゃんの話をしてから見ていないわ。あの悪魔はあなたが祓ってくれたみたい。",shape=box,color=blue];
		2466 -> 2469;
	2469 [label="Check boolean EleanorDating",color=orange];
		2469 -> 2470 [label=true,color=green];
		2469 -> 2471 [label=false,color=brown];
	2470 [label="でも付き合い始めてから、別の事が起こり始めたの。ちょっと気まずいけど。あなたにも話そうと思ったのだけど、いいタイミングがなくて。",shape=box,color=blue];
		2470 -> 2472;
		2470 -> 2473;
		2470 -> 2474;
	2471 [label="でも、また別の夢に悩まされているの。不安を掻き立てるような。",shape=box,color=blue];
		2471 -> 2480;
		2471 -> 2481;
		2471 -> 2482;
	2472 [label="自分の夢を見たの？",shape=box,color=red];
		2472 -> 2475;
	2473 [label="自分たちの夢を見たの？",shape=box,color=red];
		2473 -> 2476;
	2474 [label="気まずい？　何か怖い。",shape=box,color=red];
		2474 -> 2477;
	2480 [label="Eleanorは簡単に不安がらない。",shape=box,color=red];
		2480 -> 2483;
	2481 [label="階段を永遠と転げ落ちる夢？",shape=box,color=red];
		2481 -> 2484;
	2482 [label="何か伝えたいのかも。能力も踏まえて、夢はただの夢ではないかも。",shape=box,color=red];
		2482 -> 2485;
	2475 [label="それは気まずくないわ。違うわ。",shape=box,color=blue];
		2475 -> 2478;
	2476 [label="嗚呼、そうならいいのに。残念ながら、そんな楽しい夢ではないわ。",shape=box,color=blue];
		2476 -> 2478;
	2477 [label="心配しないで。そんなにひどい話じゃないから。ただ…",shape=box,color=blue];
		2477 -> 2478;
	2483 [label="そうね、だからこそ困惑しているの。",shape=box,color=blue];
		2483 -> 2486;
	2484 [label="いや、違うわ。でも面白いわね、みんな一度は見るのよね。",shape=box,color=blue];
		2484 -> 2486;
	2485 [label="まさしくそれを恐れているの。",shape=box,color=blue];
		2485 -> 2486;
	2478 [label="（OK、Eleanor、深呼吸よ、あなたならできる）",shape=box,color=blue];
		2478 -> 2479;
	2486 [label="（OK、Eleanor、深呼吸よ、あなたならできる）",shape=box,color=blue];
