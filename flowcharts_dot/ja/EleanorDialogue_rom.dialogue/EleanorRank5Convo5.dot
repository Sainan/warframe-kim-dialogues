		2490 -> 2494;
	2491 [label="嫉妬？",shape=box,color=red];
		2491 -> 2495;
	2488 [label="冗談でしょ。",shape=box,color=red];
		2488 -> 2492;
	2489 [label="嫉妬？",shape=box,color=red];
		2489 -> 2493;
	2494 [label="嗚呼、そうだったらいいのに。",shape=box,color=blue];
		2494 -> 2496;
	2495 [label="あなたが私を奪い去ったことに対して、ね。",shape=box,color=blue];
		2495 -> 2496;
	2492 [label="嗚呼、そうだったらいいのに。",shape=box,color=blue];
		2492 -> 2497;
	2493 [label="私たちの友情に、ね。",shape=box,color=blue];
		2493 -> 2497;
	2496 [label="虚しい度合いで、アレは私を所有物と思っているの。私はアレの繁殖対象となるはずだった。レガサイトも私をライバル女王と見ているし。",shape=box,color=blue];
		2496 -> 2498;
		2496 -> 2499;
	2497 [label="虚しい度合いで、アレは私を所有物と思っているの。私はアレの繁殖対象となるはずだった。レガサイトも私をライバル女王と見ているし。",shape=box,color=blue];
		2497 -> 2500;
		2497 -> 2501;
	2498 [label="WARFRAMEはそう言う仕組みじゃない。組み込まれた感染体は抑制されていて、休眠状態なんだ。Nidusは例外だけど、でも彼は独自の法則を持っている。",shape=box,color=red];
		2498 -> 2503;
	2499 [label="自分がEleanorを奪ったと、テックロットが思っているって？",shape=box,color=red];
		2499 -> 2504;
	2500 [label="WARFRAMEはそう言う仕組みじゃない。組み込まれた感染体は抑制されていて、休眠状態なんだ。Nidusは例外だけど、でも彼は独自の法則を持っている。",shape=box,color=red];
		2500 -> 2502;
	2501 [label="自分がEleanorをテックロットから遠ざけている、そう思っていると？",shape=box,color=red];
		2501 -> 2505;
	2503 [label="もし私が完全なWARFRAMEなら、テックロットも私をそんな風に見ないでしょう。でも現に、私の細胞も変わりつつあって、テックロットも我が物と思っている。",shape=box,color=blue];
		2503 -> 2506;
	2504 [label="変よね？　捨てられた元カレみたい！",shape=box,color=blue];
		2504 -> 2506;
	2502 [label="もし私が完全なWARFRAMEなら、テックロットも私をそんな風に見ないでしょう。でも現に、私の細胞も変わりつつあって、テックロットも我が物と思っている。",shape=box,color=blue];
		2502 -> 2507;
	2505 [label="そう。私に戻ってきてほしいの。",shape=box,color=blue];
		2505 -> 2507;
	2506 [label="私の故郷では、こう言う事が起こると、近所のスーパーの裏に呼び出されて喧嘩で決めるしかないわ。未来だとどうか分からないけど。",shape=box,color=blue];
		2506 -> 2508;
	2507 [label="「ココガオマエノホントウノカゾクダ」って囁くの。「ワレワレノイチブニフタタビナレ、キリハナサレタシマイヨ。ウケイレルノダ」",shape=box,color=blue];
		2507 -> 2508;
	2508 [label="ちょっとタンマ。なんでテックロットの感情が分かる？",shape=box,color=red];
		2508 -> 2509;
	2509 [label="うぅぅ、ここが気まずいところ。",shape=box,color=blue];
		2509 -> 2510;
	2510 [label="さっき言った夢の話だけど、テックロットが送っているものと確信しているの。",shape=box,color=blue];
		2510 -> 2511;
	2511 [label="アレにどのような意識と知性があるか分からないけど、私の精神と繋がることができるの。普段は粗末で弱い思考しか送らないから、簡単に対処できるのだけど。",shape=box,color=blue];
		2511 -> 2512;
	2512 [label="ほとんどの場合は、頭蓋骨の後ろを必死に引っかいている感じ。例えるなら、トイレに行ってる間ネコがドアを開けようとしているみたいな。",shape=box,color=blue];
		2512 -> 2513;
		2512 -> 2514;
	2513 [label="でも寝ている間は違う、そうだろう？",shape=box,color=red];
		2513 -> 2515;
	2514 [label="話の先が見えてきた。",shape=box,color=red];
		2514 -> 2515;
	2515 [label="そう。守りを下げた状態、私に届く状態。",shape=box,color=blue];
		2515 -> 2516;
	2516 [label="理解できるか分からないけど、ソレは結構原始的なレベルのアタックを仕掛けてくるの。帰ってきてほしいって。今までにないエクスタシーを感じさせてくれると。",shape=box,color=blue];
		2516 -> 2517;
	2517 [label="肉体に嚢胞を植え付け、新たな生命を孕ませると。それが私の望みだと思っているから。",shape=box,color=blue];
		2517 -> 2518;
	2518 [label="Check boolean EleanorDating",color=orange];
		2518 -> 2519 [label=true,color=green];
		2518 -> 2520 [label=true,color=green];
		2518 -> 2521 [label=false,color=brown];
		2518 -> 2522 [label=false,color=brown];
	2519 [label="うわ、もうおしまいだ。それとどうやって対抗しろと？",shape=box,color=red];
		2519 -> 2523;
	2520 [label="Eleanorを奪い返される前に全部燃やし尽くしてやる。",shape=box,color=red];
		2520 -> 2524;
	2521 [label="Eleanorをとらせない。親友だから。",shape=box,color=red];
		2521 -> 2525;
	2522 [label="Eleanorは家族みたいなものだ。そうはさせない。",shape=box,color=red];
		2522 -> 2526;
	2523 [label="+20 Chemistry",color=orange];
		2523 -> 2530;
	2524 [label="いいわね、そういう姿勢があなたをキスまみれにするわ。",shape=box,color=blue];
		2524 -> 2527;
	2525 [label="分かっているわ。多分あっちも。だから怒っているの。力の差は歴然だから。",shape=box,color=blue];
		2525 -> 2528;
	2526 [label="私の支えとなってくれると分かっただけで、安心して眠れるわ。",shape=box,color=blue];
		2526 -> 2529;
	2530 [label="大丈夫よ、ダーリン。孤立した機械の塊が浮かんで化膿した結核の肉塊のために、あなたを見捨てるつもりはないわ。",shape=box,color=blue];
		2530 -> 2531;
	2527 [label="+20 Chemistry",color=orange];
		2527 -> 2532;
	2528 [label="+20 Chemistry",color=orange];
		2528 -> 2533;
	2529 [label="+20 Chemistry",color=orange];
		2529 -> 2534;
	2531 [label="でも…　朝一緒に起きた時、クマが酷くてやつれて見えたら、濃いコーヒーを持ってきて、詳細は聞かないようにしてちょうだい。",shape=box,color=blue];
		2531 -> 2535;
		2531 -> 2536;
	2532 [label="じゃあテックロットが本当に嫉妬しそうなコト、しちゃう？",shape=box,color=blue];
		2532 -> 2538;
	2533 [label="共に立ち向かいましょう。肩を並べて。これまで通り。",shape=box,color=blue];
		2533 -> 2539;
	2534 [label="私たちは家族よ。血と絆。不滅よ。",shape=box,color=blue];
		2534 -> 2540;
