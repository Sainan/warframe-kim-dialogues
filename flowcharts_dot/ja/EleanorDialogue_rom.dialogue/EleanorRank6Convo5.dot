digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"EleanorRank6Convo5 begins." [color=orange];
		"EleanorRank6Convo5 begins." -> j935291965;
	j935291965 [label="いつものように、考えていたのだけど…",shape=box,color=blue];
		j935291965 -> j4175355074;
	j4175355074 [label="このループが終わったら、どう終わろうと、地球はどうなるのかしら？",shape=box,color=blue];
		j4175355074 -> j4105693635;
	j4105693635 [label="あなたにとって2000年は遥か昔の話でしょうけど、なんでもいいからこの惑星がどうなるか教えてくれない？",shape=box,color=blue];
		j4105693635 -> j786062935;
		j4105693635 -> j4094528597;
	j786062935 [label="残念だけど、あまりよくない。",shape=box,color=red];
		j786062935 -> j1067024715;
	j4094528597 [label="話さないほうがいいかも。",shape=box,color=red];
		j4094528597 -> j3493216523;
	j1067024715 [label="自分が知る限り、テックロットは世界的な問題になって、人類は核で解決しようとした。",shape=box,color=red];
		j1067024715 -> j1014492963;
	j3493216523 [label="これから起こることを事前に知っていれば、それを変えようとするかもしれない。そうしたら自分は存在しなくなるかも。",shape=box,color=red];
		j3493216523 -> j3081288358;
	j1014492963 [label="「放射線戦争」の始まりはそこからだ。",shape=box,color=red];
		j1014492963 -> j3677362406;
	j3081288358 [label="わがままかもだけど、存在を続けたいな。",shape=box,color=red];
		j3081288358 -> j4128811300;
	j3677362406 [label="…そしていつか地球はメチャクチャになり、オロキンはそこから逃げ出して移住したいと考える、そうでしょう？",shape=box,color=blue];
		j3677362406 -> j1189602766;
	j4128811300 [label="あら、まるであなたがやってきたことが未来を変えていないとでも？",shape=box,color=blue];
		j4128811300 -> j830327157;
	j1189602766 [label="…そしてZarimanの件が起きて、「あなた」の物語が始まる。",shape=box,color=blue];
		j1189602766 -> j1482205522;
	j830327157 [label="細かい出来事は変わっても、全体的に見てそれほど未来は変わっていない。",shape=box,color=blue];
		j830327157 -> j2943796047;
	j1482205522 [label="全てがこの街から始まると思うと奇妙ね。",shape=box,color=blue];
		j1482205522 -> j1267598142;
		j1482205522 -> j2600386242;
	j2943796047 [label="世界はちゃんと回っているみたいね。",shape=box,color=blue];
		j2943796047 -> j255391171;
	j1267598142 [label="それがこの年が重要な理由なのかもしれない。",shape=box,color=red];
		j1267598142 -> j2561687911;
	j2600386242 [label="そう。ホルバニアからZariman Ten-Zero。そう定められている。",shape=box,color=red];
		j2600386242 -> j3168785223;
	j255391171 [label="ただ粒子が動いているだけじゃなくて、もっと多くのことが起きているのよ。",shape=box,color=blue];
		j255391171 -> j3663364461;
		j255391171 -> j1847317149;
	j2561687911 [label="+5 Chemistry",color=orange];
		j2561687911 -> j1292592614;
	j3168785223 [label="ちょっと待って…",shape=box,color=blue];
		j3168785223 -> j2074422864;
	j3663364461 [label="その考えには賛同できない。世界に考えはない。",shape=box,color=red];
		j3663364461 -> j448613235;
	j1847317149 [label="同意だ。人間の感情がVoidを形作れるなら…",shape=box,color=red];
		j1847317149 -> j690294554;
	j1292592614 [label="一理あるわ。Albrechtの核が起爆してテックロットが消えたら、地球はメチャクチャにならず、移住する必要もなく、Void旅行も無関心のモノもないわけですし。",shape=box,color=blue];
		j1292592614 -> j855368450;
	j2074422864 [label="あなたが乗っていたのがZariman Ten-Zeroなら、1から9はどうしたの？",shape=box,color=blue];
		j2074422864 -> j3146228913;
	j448613235 [label="極端な大か小の話だとそうかもしれない、でもあなたと私がいる世界ではそうではないわ。",shape=box,color=blue];
		j448613235 -> j1004094662;
	j690294554 [label="+5 Chemistry",color=orange];
		j690294554 -> j4030879613;
	j855368450 [label="…Lettieにコーヒーがあるか聞いてくるわ。",shape=box,color=blue];
		j855368450 -> "Chat ends.";
	j3146228913 [label="記憶が正しければ、無人ドローンだったはず。",shape=box,color=red];
		j3146228913 -> j2360264194;
	j1004094662 [label="私たちに存在意義があって、世界の一部であるなら、世界には意味があるはずよ。",shape=box,color=blue];
		j1004094662 -> j2033933950;
	j4030879613 [label="その通りよ。私たちが作り出す意義は、ただの安楽な妄想じゃあないわ。",shape=box,color=blue];
		j4030879613 -> j3216905783;
	"Chat ends." [color=orange];
	j2360264194 [label="それかセファロンが操縦したテラフォーミングポッドか。結構実験していたみたい。",shape=box,color=red];
		j2360264194 -> j438712750;
	j2033933950 [label="+5 Chemistry",color=orange];
		j2033933950 -> j4189812462;
	j3216905783 [label="でもいつだって、これの全てに意味はないと囁く声がある。",shape=box,color=blue];
		j3216905783 -> j2844055499;
	j438712750 [label="「プロジェクト」と呼んでね。",shape=box,color=red];
		j438712750 -> j1135900383;
	j4189812462 [label="私たちの存在は、クォークやスーパーノヴァと同じく事実であり価値がある。どう思おうと、私たちは重要なのよ。",shape=box,color=blue];
		j4189812462 -> "Chat ends.";
	j2844055499 [label="もしかしたら宇宙規模の大決戦は善対悪ではなくて、意味と無意味なのかもしれないわね。",shape=box,color=blue];
		j2844055499 -> "Chat ends.";
	j1135900383 [label="+5 Chemistry",color=orange];
		j1135900383 -> j2869577347;
	j2869577347 [label="確かに「新たな惑星でまたメチャクチャにしよう作戦」よりはマシね。",shape=box,color=blue];
		j2869577347 -> "Chat ends.";
}