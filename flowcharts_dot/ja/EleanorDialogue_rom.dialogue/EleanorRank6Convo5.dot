digraph {
	3068 [label="EleanorRank6Convo5 begins.",color=orange];
		3068 -> 3069;
	3069 [label="いつものように、考えていたのだけど…",shape=box,color=blue];
		3069 -> 3070;
	3070 [label="このループが終わったら、どう終わろうと、地球はどうなるのかしら？",shape=box,color=blue];
		3070 -> 3071;
	3071 [label="あなたにとって2000年は遥か昔の話でしょうけど、なんでもいいからこの惑星がどうなるか教えてくれない？",shape=box,color=blue];
		3071 -> 3072;
		3071 -> 3074;
	3072 [label="残念だけど、あまりよくない。",shape=box,color=red];
		3072 -> 3073;
	3074 [label="話さないほうがいいかも。",shape=box,color=red];
		3074 -> 3076;
	3073 [label="自分が知る限り、テックロットは世界的な問題になって、人類は核で解決しようとした。",shape=box,color=red];
		3073 -> 3075;
	3076 [label="これから起こることを事前に知っていれば、それを変えようとするかもしれない。そうしたら自分は存在しなくなるかも。",shape=box,color=red];
		3076 -> 3078;
	3075 [label="「放射線戦争」の始まりはそこからだ。",shape=box,color=red];
