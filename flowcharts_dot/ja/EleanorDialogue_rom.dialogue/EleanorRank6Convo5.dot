	3078 [label="わがままかもだけど、存在を続けたいな。",shape=box,color=red];
		3078 -> 3080;
	3077 [label="…そしていつか地球はメチャクチャになり、オロキンはそこから逃げ出して移住したいと考える、そうでしょう？",shape=box,color=blue];
		3077 -> 3079;
	3080 [label="あら、まるであなたがやってきたことが未来を変えていないとでも？",shape=box,color=blue];
		3080 -> 3082;
