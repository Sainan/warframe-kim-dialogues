		2296 -> 2300 [label=false,color=brown];
	2301 [label="…まって、本当に出て行ったの？",shape=box,color=blue];
		2301 -> 2302;
	2304 [label="あなたが仲間に加わってくれた日を神々に感謝するわ。",shape=box,color=blue];
		2304 -> 2307;
	2297 [label="付き合っているという事実が、ここにいたい理由としては十分だろう。",shape=box,color=red];
		2297 -> 2303;
	2298 [label="全部言わせる気？　Eleanorがいるからだ。[告白する]",shape=box,color=red];
		2298 -> 2305;
	2302 [label="Chat ends.",color=orange];
	2307 [label="探していたものを見つけられて良かったわ。すべての川が最後には海に辿り着くみたいに。",shape=box,color=blue];
		2307 -> 2313;
	2303 [label="さて、私はどうやってあなたを騙せたのかしら。それとも私はあなたを操っているのかしら。もしかしたら、脳内に何かの暗示をかけたのかも。",shape=box,color=blue];
		2303 -> 2308;
	2305 [label="さて、私はどうやってあなたを騙せたのかしら。それとも私はあなたを操っているのかしら。もしかしたら、脳内に何かの暗示をかけたのかも。それとも、あなたの体内にはテックロットウイルスがあって、私のに惹かれているのかしら。",shape=box,color=blue];
		2305 -> 2306;
	2313 [label="+20 Chemistry",color=orange];
		2313 -> 2312;
	2308 [label="それとも、あなたの体内にはテックロットウイルスがあって、私のに惹かれているのかしら。",shape=box,color=blue];
		2308 -> 2309;
	2306 [label="Eleanorに惹かれているんだ。いろんな理由で。",shape=box,color=red];
		2306 -> 2310;
	2312 [label="家族としては、ひどいものね。でも、絶対に手放したくない。",shape=box,color=blue];
		2312 -> 2314;
	2309 [label="それとも…（深呼吸）私があなたを好きなように、あなたも私が好きなのかも。本当にそんな単純な話なのかしら？",shape=box,color=blue];
		2309 -> 2315;
	2310 [label="Check boolean EleanorConfession",color=orange];
		2310 -> 2311 [label=true,color=green];
		2310 -> 2315 [label=false,color=brown];
	2314 [label="Chat ends.",color=orange];
	2315 [label="取引しましょう。Lettieに会いに行って、簡単な精神鑑定を受けてきて。何が本当に起きているのか判明してきて。そうしたら、この話はお互いなかったことにできるわ。",shape=box,color=blue];
		2315 -> 2316;
		2315 -> 2317;
		2315 -> 2318;
	2311 [label="もうはっきり伝えたと思ったけど。",shape=box,color=red];
		2311 -> 2315;
	2316 [label="精神鑑定は要らない。Eleanorを好きになることは変でも何でもない。もし同じ気持ちじゃないなら、そう言って。",shape=box,color=red];
		2316 -> 2321;
	2317 [label="もし同じ気持ちでないなら、はっきり言ってくれ。",shape=box,color=red];
		2317 -> 2321;
	2318 [label="分かったよ。忘れて。",shape=box,color=red];
		2318 -> 2319;
	2321 [label="同じ気持ちに決まってるでしょ！",shape=box,color=blue];
		2321 -> 2322;
	2319 [label="ね？　簡単だったでしょ。",shape=box,color=blue];
		2319 -> 2320;
	2322 [label="この馬鹿げた人生で出会えたのは最高のことよ！",shape=box,color=blue];
		2322 -> 2323;
	2320 [label="Chat ends.",color=orange];
	2323 [label="それはつまり長くは続かないということで、そう認めるのが早ければ早いほどいい！",shape=box,color=blue];
		2323 -> 2324;
	2324 [label="そういう決まりなの！",shape=box,color=blue];
		2324 -> 2325;
	2325 [label="Check boolean EleanorChristopher1",color=orange];
		2325 -> 2326 [label=true,color=green];
		2325 -> 2327 [label=false,color=brown];
	2326 [label="誰かを失ったことがあるのは知っている。自分もだ。Eleanorだけが抱える悲しみじゃない。",shape=box,color=red];
		2326 -> 2328;
	2327 [label="Eleanor、どこにも行かないよ。ここに、一緒に、この場所にいたいんだ。",shape=box,color=red];
		2327 -> 2330;
	2328 [label="+5 Chemistry",color=orange];
		2328 -> 2329;
	2330 [label="わかったわ。心を決めたのね。",shape=box,color=blue];
		2330 -> 2331;
	2329 [label="そうね。私たちは一人じゃない。そして、一人でいる必要もない。",shape=box,color=blue];
		2329 -> 2331;
	2331 [label="付き合うべきじゃない理由は1ダースぐらい思いつくけど、全部反論してきそうね。嗚呼、あなたを感染させたらどうするの？「免疫がある」、あなたを食べようとしたらどうする？「実質不死身だから」、あなたの頭の中を見たらどうするの？「単に私を頭から追い出すだけ」。",shape=box,color=blue];
		2331 -> 2332;
	2332 [label="なんて素晴らしく、ありえない存在なのかしら。私はもうあなたの虜なのね。",shape=box,color=blue];
		2332 -> 2333;
	2333 [label="ああ、最後にもうひとつ。気付いていると思うけど、私にはちょっと恥ずかしい問題があるの。話しておく必要があるわ。",shape=box,color=blue];
		2333 -> 2334;
		2333 -> 2335;
		2333 -> 2336;
	2334 [label="Eleanorの目が光ってるから夜眠れなくなるとか？",shape=box,color=red];
		2334 -> 2337;
	2335 [label="心を読むこと？",shape=box,color=red];
		2335 -> 2338;
	2336 [label="その舌？",shape=box,color=red];
		2336 -> 2339;
	2337 [label="「あなたが眠ってるのを見るのが好きなの…」",shape=box,color=blue];
		2337 -> 2340;
	2338 [label="それは私以外の人にとって恥ずかしいものね。",shape=box,color=blue];
		2338 -> 2340;
	2339 [label="そうね、ヒップサイズの話ではないわね。",shape=box,color=blue];
		2339 -> 2341;
	2340 [label="違うわ。私の舌の話よ。腫れ物扱いされているものね。",shape=box,color=blue];
		2340 -> 2343;
	2341 [label="+5 Chemistry",color=orange];
		2341 -> 2342;
	2343 [label="正直に答えて。これをどう思う？",shape=box,color=blue];
		2343 -> 2344;
		2343 -> 2345;
		2343 -> 2346;
	2342 [label="そう、舌よ。腫れ物扱いされているものね。",shape=box,color=blue];
		2342 -> 2343;
	2344 [label="気持ち悪いけど、でもEleanorのためなら、我慢するよ。",shape=box,color=red];
