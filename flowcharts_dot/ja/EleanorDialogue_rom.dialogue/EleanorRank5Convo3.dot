	2288 [label="へえ。それはどうも。",shape=box,color=red];
		2288 -> 2292;
	2289 [label="みんなといたいから。",shape=box,color=red];
		2289 -> 2293;
	2290 [label="やるべきことがまだある。",shape=box,color=red];
		2290 -> 2294;
	2291 [label="こっちの事情がある。",shape=box,color=red];
		2291 -> 2295;
	2292 [label="あっ、いえ、違うわ。そういう意味じゃくて。ただ、私の…　言動を考えると私が理由だなんて信じられなくて。",shape=box,color=blue];
		2292 -> 2844;
	2293 [label="…同じこと話しているわよね？",shape=box,color=blue];
		2293 -> 2844;
	2294 [label="でも…　すべきことは皆分かっているわ。感染を封じ込める。あなたも役割を果たしている。ここにわざわざ残る必要はない。なのに…",shape=box,color=blue];
		2294 -> 2844;
	2295 [label="また匂わせてきたわね。あなたに情報を吐かせる方法を考えたくなってしまうわ。",shape=box,color=blue];
		2295 -> 2844;
