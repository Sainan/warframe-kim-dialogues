		2345 -> 2351;
	2346 [label="正直に言うと…？　ちょっとそそられる。",shape=box,color=red];
		2346 -> 2347;
	2348 [label="Check boolean EleanorDating",color=orange];
		2348 -> 2349 [label=true,color=green];
		2348 -> 2350 [label=false,color=brown];
	2351 [label="そう。一件落着ね。",shape=box,color=blue];
		2351 -> 2354;
	2347 [label="それは…　触手舌持ちの人を口説いたのが私が初めてではないってこと？　いえ、答えないで。知るのが怖いから。",shape=box,color=blue];
		2347 -> 2351;
	2349 [label="そう。",shape=box,color=blue];
