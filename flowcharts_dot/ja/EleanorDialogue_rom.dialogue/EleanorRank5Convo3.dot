		2350 -> 2353;
	2354 [label="怖い。落ち着かない。緊張してる。正直に言うと、結構昂ぶってる。これはちょっと先走りすぎかも。",shape=box,color=blue];
		2354 -> 2355;
	2352 [label="率直に言ってくれて助かるわ。",shape=box,color=blue];
		2352 -> 2356;
	2353 [label="今後私に近づきたいなら、自身を火炙りにしてからにしてちょうだい。",shape=box,color=blue];
