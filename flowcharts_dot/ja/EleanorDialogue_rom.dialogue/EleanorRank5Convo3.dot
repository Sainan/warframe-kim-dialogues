		2372 -> 2374;
	2374 [label="今は舞い上がってて気にしていないけど、伝えるべきね。",shape=box,color=blue];
		2374 -> 2375;
	2375 [label="そうね。Arthurのオフィスであなたに飛びかかって、「うっかり」アナウンスのスイッチ入れて、あなたがあえぐのを全部Lettieに聞かせるのもアリかもね。",shape=box,color=blue];
		2375 -> 2376;
	2376 [label="やらないほうがいいわね。人生は十分すぎるくらいトラウマでいっぱいだもの。",shape=box,color=blue];
		2376 -> 2377;
		2376 -> 2378;
