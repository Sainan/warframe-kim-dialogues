		2844 -> 2300 [label=true,color=green];
		2844 -> 2299 [label=true,color=green];
		2844 -> 2296 [label=false,color=brown];
	2300 [label="この手の話はもううんざりだ。自分はここを離れない。それだけ。[閉じる]",shape=box,color=red];
		2300 -> 2301;
	2299 [label="チームがとても大切だから。皆は…　自分が初めて本当に持てた家族なんだ。",shape=box,color=red];
