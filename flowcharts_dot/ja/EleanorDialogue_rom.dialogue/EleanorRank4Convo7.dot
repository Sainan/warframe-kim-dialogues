	1957 [label="昔過ぎて思い出せない。",shape=box,color=red];
		1957 -> 1963;
	1958 [label="優しかった。正しくあろうと努力していた。",shape=box,color=red];
		1958 -> 1965;
	1959 [label="厳しかった。誰が上なのかをはっきり示していた。",shape=box,color=red];
		1959 -> 1967;
	1960 [label="絶望的だった。野生のクブロウに育てられた方がマシだった。",shape=box,color=red];
		1960 -> 1972;
	1962 [label="これは…　話せない。ゴメン。[閉じる]",shape=box,color=red];
		1962 -> 1978;
	1963 [label="ごめんなさい。Zarimanでの記憶が鮮明だったから、両親のことも覚えているのかと思い込んでいたわ。",shape=box,color=blue];
		1963 -> 1964;
	1965 [label="良かったわ。私が言っていいか分からないけど、伝わってくるわ。",shape=box,color=blue];
		1965 -> 1966;
	1967 [label="確かに甘く育てられた感じはないわね。入植者はタフである必要があったんでしょうね。",shape=box,color=blue];
		1967 -> 1970;
	1972 [label="そうなのね。ともあれ、あなたは立派な人になったわ。",shape=box,color=blue];
		1972 -> 1973;
	1978 [label="いいえ、私が悪かったわ。今話すべきことではないわね。",shape=box,color=blue];
		1978 -> 1979;
	1964 [label="どれだけの人生を送ってきたか忘れていたわ。",shape=box,color=blue];
		1964 -> 1968;
	1966 [label="あなたには優しさという温かい炎があるわ。誰がその炎を灯したのか気になっていたの。",shape=box,color=blue];
		1966 -> 1969;
