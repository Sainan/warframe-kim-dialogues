digraph {
	"EleanorRank6Convo2 begins." [color=orange];
		"EleanorRank6Convo2 begins." -> j25152305;
	j25152305 [label="ねえ。相談があるんだけど。",shape=box,color=blue];
		j25152305 -> j3784368025;
	j3784368025 [label="Feindsnightのことを考えてて。仮装なんて何年もやってないけど、Amirのコミックを見ていたら閃いたの。「待って、私ってContessaできるじゃない！　牙とか全部持ってるもの！」って。",shape=box,color=blue];
		j3784368025 -> j2990344205;
	j2990344205 [label="でもそれだとベタすぎるかしら？　Dandy Damageをやるべきかしら？",shape=box,color=blue];
		j2990344205 -> j3961036330;
		j2990344205 -> j2828587474;
		j2990344205 -> j1029918534;
	j3961036330 [label="Dandy Damageって誰？",shape=box,color=red];
		j3961036330 -> j253861640;
	j2828587474 [label="皆を混乱させたいならLotusの格好をするという手がある。",shape=box,color=red];
		j2828587474 -> j2206396699;
	j1029918534 [label="…Fiendsnightが何なのか教えてくれないと。",shape=box,color=red];
		j1029918534 -> j672283311;
	j253861640 [label="あら、まあ。",shape=box,color=blue];
		j253861640 -> j3778366646;
	j2206396699 [label="そんなの無理よ。あなたの頭の中で彼女を見たわ。彼女をちゃんと再現なんてできない。",shape=box,color=blue];
		j2206396699 -> j2375463863;
	j672283311 [label="うーん。あなたが世間知らずの来訪者なことをたまに忘れてしまうわね。",shape=box,color=blue];
		j672283311 -> j2465537302;
	j3778366646 [label="Dandy Damageがいたからこそ、Temple and the Rippersは羽ばたいた。彼はすべての母親にとっての悪夢、すべてのティーンエイジャーが夢見た大災害よ。",shape=box,color=blue];
		j3778366646 -> j2840026556;
	j2375463863 [label="それにあのヘルメット。ヘルメットなの？　それとも彼女の一部？　あれをつけてどうやって見えるのかしら？",shape=box,color=blue];
		j2375463863 -> j3840016811;
	j2465537302 [label="Fiendsnightは、ソルが世界に及ぼす影響が薄らいでいくことを祝う日よ。",shape=box,color=blue];
		j2465537302 -> j2212700417;
	j2840026556 [label="ナナフシのような体格に、無声映画の女王のような風格。アメのような口。ピンストライプに革、そして犬の鎖。骸骨の腰のような頬骨。",shape=box,color=blue];
		j2840026556 -> j2412221583;
		j2840026556 -> j139403688;
	j3840016811 [label="それに、一つの体に彼女は三人いるでしょう。どれか一人なんて選べないわ。",shape=box,color=blue];
		j3840016811 -> j2412221583;
		j3840016811 -> j139403688;
	j2212700417 [label="考えてみればとんでもないお祝いね。なぜ闇の広がりを祝うのか？　なぜ無法と無秩序を喜ぶのか？",shape=box,color=blue];
		j2212700417 -> j380229039;
	j2412221583 [label="コスプレ？　パーティー？　戦場で？　可能なのそれ？",shape=box,color=red];
		j2412221583 -> j2463515695;
	j139403688 [label="FiendsnightってNaberusみたいな感じだね。みんなNaberusで仮装をするのが好きなんだ。",shape=box,color=red];
		j139403688 -> j2463515695;
	j380229039 [label="ある種の予防なのかもね。恐怖するものを少量接種して、己を強くする。それか悪魔の仮面を被って暴れるための口実なのかもね。",shape=box,color=blue];
		j380229039 -> j2412221583;
		j380229039 -> j139403688;
	j2463515695 [label="…バカらしいわよね。子供っぽい、でしょ？",shape=box,color=blue];
		j2463515695 -> j2834133632;
	j2834133632 [label="ああ、何を喚いているんだか。",shape=box,color=blue];
		j2834133632 -> j2872632667;
	j2872632667 [label="仮装なんていらないわよね？　化け物なんだし。これからもずっと。",shape=box,color=blue];
		j2872632667 -> j2436064064;
	j2436064064 [label="Check boolean EleanorDating",color=orange];
		j2436064064 -> j1722325394 [label=true,color=green];
		j2436064064 -> j2610715969 [label=true,color=green];
		j2436064064 -> j261791027 [label=true,color=green];
		j2436064064 -> j2610715969 [label=false,color=brown];
		j2436064064 -> j261791027 [label=false,color=brown];
	j1722325394 [label="Eleanorは自分が大好きな化け物だ。後悔はしていない。",shape=box,color=red];
		j1722325394 -> j3716015572;
	j2610715969 [label="好んで自己嫌悪してるんじゃないかって思えてきた。",shape=box,color=red];
		j2610715969 -> j3543481162;
	j261791027 [label="違う。本当の化け物はEleanorみたいに人のことを気にかけない。",shape=box,color=red];
		j261791027 -> j4268023920;
	j3716015572 [label="+5 Chemistry",color=orange];
		j3716015572 -> j278218590;
	j3543481162 [label="Eleanorが自身をそう見ているなら、Fiendsnightはそれを祝う最高のチャンスじゃないか。",shape=box,color=red];
		j3543481162 -> j1990527544;
		j3543481162 -> j4268023920;
	j4268023920 [label="何になるか怖がる気持ちは理解できる。でもそれは今のEleanorじゃない。",shape=box,color=red];
		j4268023920 -> j1238015809;
	j278218590 [label="ええそうね！　おかしな私。この物語では化け物はハッピーエンドを迎えるのよね。",shape=box,color=blue];
		j278218590 -> j4052265087;
	j1990527544 [label="化け物になりきろう。我が物にしよう。一年に一度の夜、その称号を誇り高く掲げよう。",shape=box,color=red];
		j1990527544 -> j774011265;
	j1238015809 [label="だから仮装しよう。楽しもう。正直ヘックス全員がそうするべきだ。",shape=box,color=red];
		j1238015809 -> j882550821;
	j4052265087 [label="ごめんなさいね。未だにこれがあなたが望んだことだと信じ切れていないの。もう少し説得が必要なのかもね。",shape=box,color=blue];
		j4052265087 -> j1081721847;
	j774011265 [label="ああ、それがヒドイ考えである理由はたくさんあるわ",shape=box,color=blue];
		j774011265 -> j3469519136;
	j882550821 [label="そうさせてもらうわ。そしてありがとう。本当に。 x",shape=box,color=blue];
		j882550821 -> "Chat ends.";
	j1081721847 [label="後でお互いを喰らいつくしましょう xxx",shape=box,color=blue];
		j1081721847 -> "Chat ends.";
	j3469519136 [label="とても。たくさん。",shape=box,color=blue];
		j3469519136 -> j2056553709;
	"Chat ends." [color=orange];
	j2056553709 [label="（今は思いつかないけど、何十個はあるでしょうね）",shape=box,color=blue];
		j2056553709 -> j1731113766;
	j1731113766 [label="…はぁ。",shape=box,color=blue];
		j1731113766 -> j2883501421;
	j2883501421 [label="私のメランコリーをこうも上手く串刺しにするなんてね。ずるいわ。お見事。x",shape=box,color=blue];
		j2883501421 -> "Chat ends.";
}