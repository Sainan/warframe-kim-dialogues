digraph {
	2845 [label="EleanorRank6Convo2 begins.",color=orange];
		2845 -> 2846;
	2846 [label="ねえ。相談があるんだけど。",shape=box,color=blue];
		2846 -> 2847;
	2847 [label="Feindsnightのことを考えてて。仮装なんて何年もやってないけど、Amirのコミックを見ていたら閃いたの。「待って、私ってContessaできるじゃない！　牙とか全部持ってるもの！」って。",shape=box,color=blue];
		2847 -> 2848;
	2848 [label="でもそれだとベタすぎるかしら？　Dandy Damageをやるべきかしら？",shape=box,color=blue];
		2848 -> 2849;
		2848 -> 2850;
		2848 -> 2851;
	2849 [label="Dandy Damageって誰？",shape=box,color=red];
		2849 -> 2852;
	2850 [label="皆を混乱させたいならLotusの格好をするという手がある。",shape=box,color=red];
		2850 -> 2853;
	2851 [label="…Fiendsnightが何なのか教えてくれないと。",shape=box,color=red];
		2851 -> 2854;
	2852 [label="あら、まあ。",shape=box,color=blue];
		2852 -> 2855;
	2853 [label="そんなの無理よ。あなたの頭の中で彼女を見たわ。彼女をちゃんと再現なんてできない。",shape=box,color=blue];
		2853 -> 2856;
	2854 [label="うーん。あなたが世間知らずの来訪者なことをたまに忘れてしまうわね。",shape=box,color=blue];
		2854 -> 2857;
	2855 [label="Dandy Damageがいたからこそ、Temple and the Rippersは羽ばたいた。彼はすべての母親にとっての悪夢、すべてのティーンエイジャーが夢見た大災害よ。",shape=box,color=blue];
		2855 -> 2858;
	2856 [label="それにあのヘルメット。ヘルメットなの？　それとも彼女の一部？　あれをつけてどうやって見えるのかしら？",shape=box,color=blue];
		2856 -> 2859;
	2857 [label="Fiendsnightは、ソルが世界に及ぼす影響が薄らいでいくことを祝う日よ。",shape=box,color=blue];
		2857 -> 2860;
	2858 [label="ナナフシのような体格に、無声映画の女王のような風格。アメのような口。ピンストライプに革、そして犬の鎖。骸骨の腰のような頬骨。",shape=box,color=blue];
		2858 -> 2861;
		2858 -> 2862;
	2859 [label="それに、一つの体に彼女は三人いるでしょう。どれか一人なんて選べないわ。",shape=box,color=blue];
		2859 -> 2861;
		2859 -> 2862;
	2860 [label="考えてみればとんでもないお祝いね。なぜ闇の広がりを祝うのか？　なぜ無法と無秩序を喜ぶのか？",shape=box,color=blue];
		2860 -> 2863;
	2861 [label="コスプレ？　パーティー？　戦場で？　可能なのそれ？",shape=box,color=red];
		2861 -> 2864;
	2862 [label="FiendsnightってNaberusみたいな感じだね。みんなNaberusで仮装をするのが好きなんだ。",shape=box,color=red];
		2862 -> 2864;
	2863 [label="ある種の予防なのかもね。恐怖するものを少量接種して、己を強くする。それか悪魔の仮面を被って暴れるための口実なのかもね。",shape=box,color=blue];
		2863 -> 2861;
		2863 -> 2862;
	2864 [label="…バカらしいわよね。子供っぽい、でしょ？",shape=box,color=blue];
		2864 -> 2865;
	2865 [label="ああ、何を喚いているんだか。",shape=box,color=blue];
		2865 -> 2866;
	2866 [label="仮装なんていらないわよね？　化け物なんだし。これからもずっと。",shape=box,color=blue];
		2866 -> 2867;
	2867 [label="Check boolean EleanorDating",color=orange];
		2867 -> 2868 [label=true,color=green];
		2867 -> 2869 [label=true,color=green];
		2867 -> 2870 [label=true,color=green];
		2867 -> 2869 [label=false,color=brown];
		2867 -> 2870 [label=false,color=brown];
	2868 [label="Eleanorは自分が大好きな化け物だ。後悔はしていない。",shape=box,color=red];
		2868 -> 2871;
	2869 [label="好んで自己嫌悪してるんじゃないかって思えてきた。",shape=box,color=red];
		2869 -> 2872;
	2870 [label="違う。本当の化け物はEleanorみたいに人のことを気にかけない。",shape=box,color=red];
		2870 -> 2873;
	2871 [label="+5 Chemistry",color=orange];
		2871 -> 2874;
	2872 [label="Eleanorが自身をそう見ているなら、Fiendsnightはそれを祝う最高のチャンスじゃないか。",shape=box,color=red];
		2872 -> 2875;
		2872 -> 2873;
	2873 [label="何になるか怖がる気持ちは理解できる。でもそれは今のEleanorじゃない。",shape=box,color=red];
		2873 -> 2876;
	2874 [label="ええそうね！　おかしな私。この物語では化け物はハッピーエンドを迎えるのよね。",shape=box,color=blue];
		2874 -> 2877;
	2875 [label="化け物になりきろう。我が物にしよう。一年に一度の夜、その称号を誇り高く掲げよう。",shape=box,color=red];
		2875 -> 2878;
	2876 [label="だから仮装しよう。楽しもう。正直ヘックス全員がそうするべきだ。",shape=box,color=red];
		2876 -> 2879;
	2877 [label="ごめんなさいね。未だにこれがあなたが望んだことだと信じ切れていないの。もう少し説得が必要なのかもね。",shape=box,color=blue];
		2877 -> 2880;
	2878 [label="ああ、それがヒドイ考えである理由はたくさんあるわ",shape=box,color=blue];
		2878 -> 2881;
	2879 [label="そうさせてもらうわ。そしてありがとう。本当に。 x",shape=box,color=blue];
		2879 -> 2882;
	2880 [label="後でお互いを喰らいつくしましょう xxx",shape=box,color=blue];
		2880 -> 2883;
	2881 [label="とても。たくさん。",shape=box,color=blue];
		2881 -> 2884;
	2882 [label="Chat ends.",color=orange];
	2883 [label="Chat ends.",color=orange];
	2884 [label="（今は思いつかないけど、何十個はあるでしょうね）",shape=box,color=blue];
		2884 -> 2885;
	2885 [label="…はぁ。",shape=box,color=blue];
		2885 -> 2886;
	2886 [label="私のメランコリーをこうも上手く串刺しにするなんてね。ずるいわ。お見事。x",shape=box,color=blue];
		2886 -> 2887;
