	793 [label="じゃあ親切心で、彼に今の発言は伝えないでおくわ。これは忠告よ、今後私の前では彼にもっと敬意を払うように。",shape=box,color=blue];
		793 -> 436;
	794 [label="正直、声作って数時間役を演じるのはいいかもしれないわね。参加するわ。",shape=box,color=blue];
