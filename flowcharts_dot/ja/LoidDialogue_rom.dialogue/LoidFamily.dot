		19 -> 20 [label="MarieFamilySuccess, LyonFamilySuccess, RoatheFamilySuccess",color=purple];
		19 -> 21 [label="false",color=purple];
	20 [label="漂流者。降伏します。Roathe、Marie、そしてLyonが、私を説得しました。",shape=box,color=blue];
		20 -> 22;
	21 [label="Chat ends.",color=orange];
	22 [label="これからしなければならない恐怖を、骨の髄まで感じています。その髄もGomaitruとその家族がこれまでの事情を知った時、怒りから私の手足を引きちぎった際に奪われるかもしれませんが。",shape=box,color=blue];
		22 -> 23;
	23 [label="未だにその名で呼ぶのも違和感があります…　しかし長い時の末、我々は変わり果てました。そして近いうちに、追うように小さな変化が訪れるでしょう。",shape=box,color=blue];
		23 -> 24;
		23 -> 25;
	24 [label="遅すぎるくらいだ。大丈夫だよ。",shape=box,color=red];
		24 -> 26;
	25 [label="Loidならできる。",shape=box,color=red];
		25 -> 26;
	26 [label="ええ、そうですね。事が済んだら、私の贓物がネクロリスクに祝祭用の装飾として使われていないか確認しに来てくれませんか？　ストレスケアと思っていただければ幸いです。",shape=box,color=blue];
		26 -> 27;
	27 [label="Update boolean LoidFamilyComplete",color=orange];
		27 -> 28;
	28 [label="Chat ends.",color=orange];
}