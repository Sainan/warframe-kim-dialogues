		3 -> 4;
	4 [label="ああ、そうでした。まだ初期設定のままでした。Loidです。ご無礼を…　挨拶から始めるべきでしたが、ここサンクタム・アナトミカでは最近、深刻な混乱が起きています。",shape=box,color=blue];
		4 -> 5;
	5 [label="だからこそ、あなたに連絡したのです。あなたの助けが必要なのです。私の時代に、3体のPROTOFRAMEがサンクタムに現れました。しかも、これまで私たちが知らなかったものです。",shape=box,color=blue];
		5 -> 6;
	6 [label="そしてその内一人は…",shape=box,color=blue];
		6 -> 7;
	7 [label="その…",shape=box,color=blue];
		7 -> 8;
	8 [label="オロキンです、漂流者。",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
		8 -> 11;
	9 [label="Lotusは？",shape=box,color=red];
		9 -> 12;
	10 [label="やば…",shape=box,color=red];
		10 -> 13;
	11 [label="なんだって？！",shape=box,color=red];
		11 -> 13;
	12 [label="Lotusとオペレーターは今別の件で手が離せない状態です。それもかなり肉体と精神を酷使して…　現状この事態に対応できるのはあなたしかいないのです。",shape=box,color=blue];
		12 -> 14;
	13 [label="現状この事態に対応できるのはあなたしかいないのです。それにあなたは…　こういった問題の専門家とも言えます。",shape=box,color=blue];
		13 -> 15;
	14 [label="それにあなたは…　こういった問題の専門家とも言えます。",shape=box,color=blue];
		14 -> 15;
	15 [label="彼らをどう説明したらいいか分かりませんが、サンクタム・アナトミカまでお越しいただければ、状況を理解できるでしょう。そして3人の内2人がPOM-2であなたと話すことに同意しました。もう1人は説得に時間が掛かりそうですが。",shape=box,color=blue];
		15 -> 16;
