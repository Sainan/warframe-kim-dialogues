	j835335341 [label="POM2_LAB1？",shape=box,color=red];
		j835335341 -> j1464251702;
	j1589088641 [label="どちらさま…？",shape=box,color=red];
		j1589088641 -> j1464251702;
	j1464251702 [label="ああ、そうでした。まだ初期設定のままでした。Loidです。ご無礼を…　挨拶から始めるべきでしたが、ここサンクタム・アナトミカでは最近、深刻な混乱が起きています。",shape=box,color=blue];
		j1464251702 -> j4293423169;
	j4293423169 [label="だからこそ、あなたに連絡したのです。あなたの助けが必要なのです。私の時代に、3体のPROTOFRAMEがサンクタムに現れました。しかも、これまで私たちが知らなかったものです。",shape=box,color=blue];
		j4293423169 -> j300441828;
	j300441828 [label="そしてその内一人は…",shape=box,color=blue];
		j300441828 -> j871833975;
	j871833975 [label="その…",shape=box,color=blue];
		j871833975 -> j605424008;
	j605424008 [label="オロキンです、漂流者。",shape=box,color=blue];
		j605424008 -> j3335719694;
		j605424008 -> j3115248741;
		j605424008 -> j2892567041;
	j3335719694 [label="Lotusは？",shape=box,color=red];
		j3335719694 -> j3876254115;
	j3115248741 [label="やば…",shape=box,color=red];
		j3115248741 -> j3857518321;
	j2892567041 [label="なんだって？！",shape=box,color=red];
		j2892567041 -> j3857518321;
	j3876254115 [label="Lotusとオペレーターは今別の件で手が離せない状態です。それもかなり肉体と精神を酷使して…　現状この事態に対応できるのはあなたしかいないのです。",shape=box,color=blue];
		j3876254115 -> j1079794037;
	j3857518321 [label="現状この事態に対応できるのはあなたしかいないのです。それにあなたは…　こういった問題の専門家とも言えます。",shape=box,color=blue];
		j3857518321 -> j725523891;
	j1079794037 [label="それにあなたは…　こういった問題の専門家とも言えます。",shape=box,color=blue];
		j1079794037 -> j725523891;
	j725523891 [label="彼らをどう説明したらいいか分かりませんが、サンクタム・アナトミカまでお越しいただければ、状況を理解できるでしょう。そして3人の内2人がPOM-2であなたと話すことに同意しました。もう1人は説得に時間が掛かりそうですが。",shape=box,color=blue];
		j725523891 -> j4195890583;
	j4195890583 [label="あなたが成功することを…　信じています。",shape=box,color=blue];
		j4195890583 -> j3173882;
