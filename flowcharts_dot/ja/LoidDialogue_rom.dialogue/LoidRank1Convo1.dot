	"LoidRank1Convo1 begins." [color=orange];
		"LoidRank1Convo1 begins." -> j376350233;
	j376350233 [label="漂流者。急な連絡申し訳ありません。この装置での連絡は避けたかったのですが、事態は急を要し、他に頼れる者がいません。",shape=box,color=blue];
		j376350233 -> j835335341;
