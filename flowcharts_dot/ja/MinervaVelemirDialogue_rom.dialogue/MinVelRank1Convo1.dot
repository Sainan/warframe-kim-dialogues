digraph {
	0 [label="MinVelRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="MomToxicated: 彼女に何が起きた？　答えなさい。",shape=box,color=blue];
		1 -> 2;
	2 [label="MomToxicated: 真実を言いなさい。他の連中の言う「説明が難しい」だののたわごとはなしよ。",shape=box,color=blue];
		2 -> 3;
		2 -> 4;
		2 -> 5;
		2 -> 6;
	3 [label="笑",shape=box,color=red];
		3 -> 7;
	4 [label="え？",shape=box,color=red];
		4 -> 7;
	5 [label="ええと。",shape=box,color=red];
		5 -> 7;
	6 [label="どちらさま…？",shape=box,color=red];
		6 -> 7;
	7 [label="PapaPolar: そんな態度を取らなくてもいいだろ。「やあ、調子はどう？」から始めたらどうだ。",shape=box,color=blue];
		7 -> 8;
	8 [label="PapaPolar: すまないな。Mは標的が視界に入るとアクセルベタ踏みになる。",shape=box,color=blue];
		8 -> 9;
	9 [label="MomToxicated: 貴方がしゃしゃり出る必要は無い。",shape=box,color=blue];
		9 -> 10;
	10 [label="PapaPolar: そうはしていないが？",shape=box,color=blue];
		10 -> 11;
	11 [label="MomToxicated: ハッ。言ってなさい。ヤルチェスコで出しゃばらなかったみたいにね。",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="MinervaとVelimir、でいいんだね？",shape=box,color=red];
		12 -> 14;
	13 [label="えっと…　一旦話を戻してくれない？　何の話なんだ？",shape=box,color=red];
		13 -> 15;
	14 [label="PapaPolar: ああ、悪いね。俺が誰か当てるのは簡単だったんじゃないかな？　笑",shape=box,color=blue];
		14 -> 16;
	15 [label="PapaPolar: ハッ。すまないな。velimirだ。それとこのMomToxicatedはminerva。",shape=box,color=blue];
		15 -> 17;
	16 [label="PapaPolar: こちらのMomToxicatedはminervaだ。",shape=box,color=blue];
		16 -> 17;
	17 [label="MomToxicated: VELIMIR。この方法を使う気があるならなぜそう-",shape=box,color=blue];
		17 -> 18;
	18 [label="MomToxicated: ああもう！",shape=box,color=blue];
		18 -> 19;
	19 [label="PapaPolar: M、落ち着いて考えるんだ。消去法だ。このシステムに俺たちみたいな化け物が現実的にどれだけいる？",shape=box,color=blue];
		19 -> 20;
		19 -> 21;
		19 -> 22;
	20 [label="時間が経つにつれてどんどん増えていくような気がするけど。",shape=box,color=red];
		20 -> 23;
	21 [label="二人で何が起きているのか整理して、*その後で*話をしに来てくれない？",shape=box,color=red];
		21 -> 24;
	22 [label="本当に全く訳がわからない。",shape=box,color=red];
		22 -> 25;
	23 [label="Update boolean VelimirFamily1",color=orange];
		23 -> 26;
	24 [label="PapaPolar: そうすると長いこと待つことになるだろうな。ハハ。",shape=box,color=blue];
		24 -> 27;
	25 [label="PapaPolar: ハハ、もし君に*訳が分からない*なら、俺たち全員が困るだろうね。ハッ！",shape=box,color=blue];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="PapaPolar: 手短に言おう。Mは知りたいことがあり、君に質問に答えてほしいと思っている。",shape=box,color=blue];
		27 -> 30;
	28 [label="PapaPolar: 俺たちが必要とする答えが君しかないのならな。",shape=box,color=blue];
		28 -> 30;
	29 [label="PapaPolar: そう願うよ！　賑やかなほうがいい。言うだろう、カルトと宗教の違いは人数だけだってね、ハハ。",shape=box,color=blue];
		29 -> 31;
	30 [label="PapaPolar: どうだ。これでいいだろう、M？　君の「良い警官と悪い警官」プランに準じているだろ？",shape=box,color=blue];
		30 -> 32;
	31 [label="PapaPolar: そんな言葉あったっけか？",shape=box,color=blue];
		31 -> 33;
	32 [label="MomToxicated: 天上のソルよ、叫びたくなるわね…",shape=box,color=blue];
		32 -> 34;
		32 -> 35;
		32 -> 36;
	33 [label="PapaPolar: まぁいい。なんとなくわかるだろう。水もあるし、見える限り皆ハッピーだ。それはそうと。",shape=box,color=blue];
		33 -> 27;
	34 [label="どうしてか尋問されているような気がするが？",shape=box,color=red];
		34 -> 37;
	35 [label="ええと。うーん。この会話で「駆け引き」はしないでくれるとうれしいんだけど。",shape=box,color=red];
		35 -> 38;
	36 [label="何について聞きたいんだ？　答えられるなら答えるよ。",shape=box,color=red];
		36 -> 39;
	37 [label="MomToxicated: 口を挟まないで、Velimir。",shape=box,color=blue];
		37 -> 40;
	38 [label="MomToxicated: これに駆け引きなんてないわ。",shape=box,color=blue];
		38 -> 41;
	39 [label="MomToxicated: 協力する態度は認めよう、「漂流者」。",shape=box,color=blue];
		39 -> 42;
	40 [label="PapaPolar: :-X",shape=box,color=blue];
		40 -> 43;
	41 [label="MomToxicated: 質問に答える気はある？　答えは「はい」か「いいえ」。",shape=box,color=blue];
		41 -> 44;
		41 -> 45;
	42 [label="MomToxicated: もしそれが本名ならね。",shape=box,color=blue];
		42 -> 46;
	43 [label="MomToxicated: こういうのに対処するのは…　いえ。何でもない。関係ないわ。",shape=box,color=blue];
		43 -> 41;
	44 [label="いいや、断る。まずは態度を見直したらどうだ。",shape=box,color=red];
		44 -> 47;
	45 [label="わかった、構わない。何を聞きたい？",shape=box,color=red];
		45 -> 39;
	46 [label="PapaPolar: （俺たちが言えることじゃないだろ。）",shape=box,color=blue];
		46 -> 48;
	47 [label="MomToxicated: 間違いね。もう一回考え直す時間はあげましょう。",shape=box,color=blue];
		47 -> 49;
	48 [label="MomToxicated: VELIMIR",shape=box,color=blue];
