		j4170391142 -> j2886508792;
	j2886508792 [label="PapaPolar: おいおい、落ち着くんだ、M。",shape=box,color=blue];
		j2886508792 -> j4268202821;
	j4268202821 [label="PapaPolar: この状況について他の連中からも話を聞いた。彼らの言っていることは一致している。この漂流者が言っていることは正しい。",shape=box,color=blue];
		j4268202821 -> j4074304779;
	j4074304779 [label="PapaPolar: 他の連中より答えがあるわけじゃない。そして当人のせいじゃないんだ。",shape=box,color=blue];
		j4074304779 -> j3086140573;
	j3086140573 [label="PapaPolar: この話が真実でなければ、皆がこんなに突拍子もないデタラメをしゃべり続けない、わかるだろう（笑）",shape=box,color=blue];
		j3086140573 -> j3422175527;
