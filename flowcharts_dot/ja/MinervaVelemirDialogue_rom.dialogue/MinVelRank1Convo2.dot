		j1493406250 -> j72140505;
		j1493406250 -> j378391527;
	j1820235538 [label="彼女に起きた出来事は、巨大な不可知のVoidの神が引き起こした。神に戦いを挑みたい？　どうぞご自由に、それと順番待ちだよ。",shape=box,color=red];
		j1820235538 -> j129412136;
	j72140505 [label="イエスとノーかな？　別に彼女の頭をぶち抜いたわけじゃない、そんなことしていない。機会はあったとしても…　まぁロケットは撃ったけどそれとこれは別だ。",shape=box,color=red];
