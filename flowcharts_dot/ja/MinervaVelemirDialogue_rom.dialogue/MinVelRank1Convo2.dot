		j609650710 -> j1736257441;
	j2225775408 [label="+5 Chemistry",color=orange];
		j2225775408 -> j4166080149;
	j1565755758 [label="PapaPolar: 繰り返しになるが、人が恐れているとこうなる。よく見てみると、多くの人間は小さなクソ野郎みたいにふるまう。それは大体、二つの理由に落ち着く。",shape=box,color=blue];
		j1565755758 -> j3997442383;
	j1736257441 [label="PapaPolar: その通り、君は100%正しい。それは免罪符じゃない。しかし、人間とは混沌としたものだ。そのことを愛することもあるし、それゆえに許すことさえある。",shape=box,color=blue];
		j1736257441 -> j3662079367;
	j4166080149 [label="PapaPolar: まさにその通り。 ",shape=box,color=blue];
		j4166080149 -> j2863566704;
