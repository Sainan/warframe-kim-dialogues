		j126991585 -> j255127855;
	j4048427307 [label="PapaPolar: それでneciの信頼をすぐに勝ち取った。彼女はMに走って行って彼女に腕を回した。それで軍を辞めたんだ。まぁ、正式にはね。それで「コンサルタント」になった。",shape=box,color=blue];
		j4048427307 -> j3174305750;
