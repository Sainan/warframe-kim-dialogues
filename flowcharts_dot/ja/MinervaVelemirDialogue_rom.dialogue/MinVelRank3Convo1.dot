		j2857994879 -> j1809387622;
	j1809387622 [label="PapaPolar: そうしたら突然[検閲済]がバーに入ってきて、そして彼らは本当に大きくて偉容な、信じられないほどドデカい[検閲済]を出してきたんだ",shape=box,color=blue];
