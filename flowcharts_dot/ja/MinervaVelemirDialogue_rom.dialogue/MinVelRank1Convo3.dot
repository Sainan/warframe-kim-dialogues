	"MinVelRank1Convo3 begins." [color=orange];
		"MinVelRank1Convo3 begins." -> j2014551968;
	j2014551968 [label="MomToxicated: 漂流者。話をしても？",shape=box,color=blue];
		j2014551968 -> j484058950;
		j2014551968 -> j1128073668;
		j2014551968 -> j3238639905;
		j2014551968 -> j4053482194;
	j484058950 [label="おはよう、Minerva。もしそれが本名ならだけど。",shape=box,color=red];
		j484058950 -> j3351463445;
	j1128073668 [label="なるほど、「」をつけるのはやめたんだ。",shape=box,color=red];
		j1128073668 -> j979674261;
	j3238639905 [label="今更？",shape=box,color=red];
		j3238639905 -> j979674261;
	j4053482194 [label="どした？",shape=box,color=red];
		j4053482194 -> j4055268827;
	j3351463445 [label="+5 Chemistry",color=orange];
		j3351463445 -> j3154165266;
	j979674261 [label="MomToxicated: いわゆるベッドサイドマナーについて説教されたわ。",shape=box,color=blue];
		j979674261 -> j729455823;
	j4055268827 [label="+5 Chemistry",color=orange];
		j4055268827 -> j3903074120;
	j3154165266 [label="MomToxicated: 信じる気があるかどうかはともかく、そうよ。",shape=box,color=blue];
		j3154165266 -> j473596104;
	j729455823 [label="MomToxicated: 総合的に考えて、不合理だけど。",shape=box,color=blue];
		j729455823 -> j313228220;
	j3903074120 [label="MomToxicated: 早速本題に入ったわね。良いでしょう。",shape=box,color=blue];
		j3903074120 -> j313228220;
	j473596104 [label="MomToxicated: それは本題ではない。",shape=box,color=blue];
		j473596104 -> j313228220;
	j313228220 [label="MomToxicated: 私たちはある問題を解決するためにホルバニアに来た。そして、あなたはその解決に手を貸せる。",shape=box,color=blue];
		j313228220 -> j1843822323;
	j1843822323 [label="MomToxicated: だから、あなたの力が必要…　つまり、私を助けてほしい、ということ。",shape=box,color=blue];
		j1843822323 -> j3785948555;
		j1843822323 -> j2788342902;
		j1843822323 -> j2039622604;
	j3785948555 [label="その解決したい問題って何なんだ？",shape=box,color=red];
		j3785948555 -> j1361485480;
	j2788342902 [label="なぜ手を貸さないといけない？",shape=box,color=red];
		j2788342902 -> j1361485480;
	j2039622604 [label="それで、それとRusalkaはどう関係してる？",shape=box,color=red];
		j2039622604 -> j1361485480;
	j1361485480 [label="MomToxicated: 実にいい質問ね。",shape=box,color=blue];
		j1361485480 -> j1734178443;
	j1734178443 [label="MomToxicated: 私のために力を貸す必要はない。私たちには共通の敵がいる。その「壁の中のモノ」が。",shape=box,color=blue];
		j1734178443 -> j735032789;
	j735032789 [label="MomToxicated: 周知している限り、私たち二人とも、それがどこへ行ったか、その狙い、そしてそもそもなぜRusalkaを狙ったのかに関心がある。",shape=box,color=blue];
		j735032789 -> j1043400695;
	j1043400695 [label="MomToxicated: この現状理解は正しいかしら？",shape=box,color=blue];
		j1043400695 -> j2515938292;
		j1043400695 -> j2240154660;
		j1043400695 -> j1075109832;
	j2515938292 [label="少し話を戻して、なぜRusalkaのことをそんなに気に掛けるのか説明してくれない？",shape=box,color=red];
		j2515938292 -> j4240008809;
	j2240154660 [label="最初の二つについては同意だ。それがなぜRusalkaを狙ったのかは、別にどうでもいい。",shape=box,color=red];
		j2240154660 -> j2130307777;
	j1075109832 [label="ああ。そう。その通りだ。",shape=box,color=red];
		j1075109832 -> j3354430879;
	j4240008809 [label="MomToxicated: 理由は重要ではないわ。",shape=box,color=blue];
		j4240008809 -> j685970226;
	j2130307777 [label="MomToxicated: もし彼女の生死に全く興味がないなら、なぜ彼女を殺さなかった？　その話は聞いているわ。",shape=box,color=blue];
		j2130307777 -> j1677918083;
		j2130307777 -> j126881621;
		j2130307777 -> j2279774659;
	j3354430879 [label="言いたくはないが、壁の中のモノが次の動きを取るまで、待ち続けるしかないだろう。",shape=box,color=red];
		j3354430879 -> j1523282191;
	j685970226 [label="PapaPolar: 重要だろうが。おそらく、彼らはたぶん既に感づいているだろう。俺たちも結構グイグイ行ってるわけだし",shape=box,color=blue];
		j685970226 -> j3576807277;
	j1677918083 [label="何故なら、そうしたら自分が無関心のモノと同じになるからだ。あるいはスカルドラ、それともEntratiみたいに。無意味に人を殺しまわったりはしない。",shape=box,color=red];
		j1677918083 -> j3410852401;
	j126881621 [label="そこに至るまでの決断は、彼女本人が下したものじゃなかったからだ。あの時に殺さなかったからといって、わざわざ救いにいくほど*気に掛けていた*わけじゃない。",shape=box,color=red];
		j126881621 -> j3241838380;
	j2279774659 [label="Entratiの汚れ仕事を引き受ける気はなかったからだ。もし奴が無関心のモノの操り人形を殺したかったら自分でやればいい。",shape=box,color=red];
		j2279774659 -> j3161523105;
	j1523282191 [label="MomToxicated: そしてその理由は何？　何者だか知らないけれど、「それ」を追う手段がないから？　それとも「それ」の本当の狙いがわからないから？",shape=box,color=blue];
		j1523282191 -> j2327337884;
		j1523282191 -> j3480154683;
	j3576807277 [label="PapaPolar: それに、もしかしたら、*もしかすると*、この新しいお友達に少し情報を渡して信頼してもらえれば、もっと手を貸してくれることに前向きになるかもな",shape=box,color=blue];
		j3576807277 -> j2122999143;
	j3410852401 [label="この言い方だと意図的になら人を殺すみたいに聞こえるかもしれない。それもしない。まあ、殺しはするけど。これは違うことなんだ。あんたなら意味はわかるだろう。",shape=box,color=red];
		j3410852401 -> j1717987255;
	j3241838380 [label="自分は彼女を*知らない*。",shape=box,color=red];
		j3241838380 -> j932848164;
	j3161523105 [label="でも疑っていた通り、あの老いぼれは立ち上がれると分かってる人間しか撃たないんだ。",shape=box,color=red];
		j3161523105 -> j2583009299;
	j2327337884 [label="半神もどきに追跡ビーコンを取り付けるのは難しくてね。",shape=box,color=red];
		j2327337884 -> j398857981;
	j3480154683 [label="奴の動機は現時点ではわからない。だが良いものではない。",shape=box,color=red];
		j3480154683 -> j398857981;
	j2122999143 [label="PapaPolar: 本来はそうするべきなんじゃないかな。",shape=box,color=blue];
		j2122999143 -> j2850135003;
	j1717987255 [label="+5 Chemistry",color=orange];
		j1717987255 -> j2619647666;
	j932848164 [label="PapaPolar: こんなやりとりじゃその気にもならないしな。そうだろう、M？",shape=box,color=blue];
		j932848164 -> j1557365422;
	j2583009299 [label="PapaPolar: 妙にずいぶんと具体的な発言だが、まあいい",shape=box,color=blue];
		j2583009299 -> j716139012;
		j2583009299 -> j1412163532;
	j398857981 [label="MomToxicated: つまり、座って待つしかないと言うの。それが…　何かをするのを。頭を出すまで？　モグラ叩きでもする気？！",shape=box,color=blue];
		j398857981 -> j1645251633;
	j2850135003 [label="MomToxicated: それが何の役に立つと？",shape=box,color=blue];
		j2850135003 -> j2107336629;
	j2619647666 [label="PapaPolar: 軍の特殊部元隊員二人と話しているんだ、分かるよ。笑",shape=box,color=blue];
		j2619647666 -> j1513904368;
	j1557365422 [label="MomToxicated: 黙りなさい、Velimir。",shape=box,color=blue];
		j1557365422 -> j4240008809;
	j716139012 [label="気にしないで。何度も死んでる。慣れてるんだ。",shape=box,color=red];
		j716139012 -> j337680810;
	j1412163532 [label="それは大して重要じゃない。",shape=box,color=red];
		j1412163532 -> j3354430879;
		j1412163532 -> j2470457711;
	j1645251633 [label="PapaPolar: 少なくともこの場所にはいい仲間と素敵なバーがあるだろう？",shape=box,color=blue];
		j1645251633 -> j593204586;
	j2107336629 [label="PapaPolar: 友人を作ることで損するわけでもないさ、M。",shape=box,color=blue];
		j2107336629 -> j3451534115;
	j1513904368 [label="PapaPolar: 俺たちが「大義」のためにしなければいけないことは、時々あやふやになる",shape=box,color=blue];
		j1513904368 -> j87679282;
	j337680810 [label="PapaPolar: オーケーオーケー…　分かったよ…　分かった",shape=box,color=blue];
		j337680810 -> j2136971704;
	j2470457711 [label="なぜRusalkaに何が起きたかを知ろうとそんなに必死なんだ？",shape=box,color=red];
		j2470457711 -> j4240008809;
	j593204586 [label="PapaPolar: 音楽も悪くない。arthurという男はいい呑み友達になれそうだ",shape=box,color=blue];
		j593204586 -> j1977934867;
	j3451534115 [label="MomToxicated: 「友人」がいてなんの役に立つと？！　Neciを救うためにどこに行けばいいかわかったらすぐに出発するのよ。",shape=box,color=blue];
		j3451534115 -> j2480538561;
	j87679282 [label="PapaPolar: だからこそ、もし俺たちが違いをもたらせるなら、やるんだ。それがneciを救おうとする理由だ",shape=box,color=blue];
		j87679282 -> j3354430879;
		j87679282 -> j2470457711;
	j2136971704 [label="PapaPolar: なんにせよ…",shape=box,color=blue];
		j2136971704 -> j3354430879;
		j2136971704 -> j2470457711;
	j1977934867 [label="MomToxicated: それで、なに、私たちは何が起きたか分からないまま続けるしかないって？　彼女が無事なのかも？　彼女が本当に彼女でなくなったかもわからないまま？！",shape=box,color=blue];
		j1977934867 -> j643257496;
	j2480538561 [label="PapaPolar: どうだろうか。半神のvoid怪物…　みたいなのの動きを予想するのは難しいみたいだ。そうなんだろう、な？",shape=box,color=blue];
		j2480538561 -> j3480154683;
		j2480538561 -> j2327337884;
	j643257496 [label="MomToxicated: なぜそれで落ち着いて平気でいられるの、Velimir？！",shape=box,color=blue];
		j643257496 -> j1532709359;
	j1532709359 [label="PapaPolar: 平気だとは一度も言っていない、M！　単に座って待つしかない場面があるということを知っているだけだ！",shape=box,color=blue];
		j1532709359 -> j1262787254;
	j1262787254 [label="MomToxicated: Eleanorと話したわ。彼女はNeciの精神に触れたときの感覚を話してくれた。あるいはその残骸に。",shape=box,color=blue];
		j1262787254 -> j2303252636;
	j2303252636 [label="MomToxicated: 私たちが育てた女性の。私たちが自分の子のように愛した女性の。",shape=box,color=blue];
		j2303252636 -> j4212387628;
	j4212387628 [label="MomToxicated: それが一体…",shape=box,color=blue];
		j4212387628 -> j1031832685;
	j1031832685 [label="MomToxicated: なのにあなたはArthurと酒を酌み交わしたいとか抜かす。",shape=box,color=blue];
		j1031832685 -> j210659694;
	j210659694 [label="MomToxicated: Du-te dracu、Velimir。",shape=box,color=blue];
		j210659694 -> j4283297430;
	j4283297430 [label="PapaPolar: はぁ、ログアウトしてしまったか…",shape=box,color=blue];
		j4283297430 -> j2821765309;
		j4283297430 -> j1745557435;
	j2821765309 [label="さっき彼女はなんて…？",shape=box,color=red];
		j2821765309 -> j3115905372;
	j1745557435 [label="さっきのは悪口の類いなんだろうね。",shape=box,color=red];
		j1745557435 -> j1934305235;
	j3115905372 [label="PapaPolar: 海外での任務に何度も配備される楽しみさ。100の違う言語で罵倒される",shape=box,color=blue];
		j3115905372 -> j621885570;
		j3115905372 -> j25969040;
	j1934305235 [label="PapaPolar: ああ。海外での任務に何度も配備される楽しみさ。100の違う言語で罵倒される",shape=box,color=blue];
		j1934305235 -> j621885570;
		j1934305235 -> j25969040;
	j621885570 [label="二人は…　結婚してるのか？",shape=box,color=red];
		j621885570 -> j2180653694;
	j25969040 [label="二人が…　Rusalkaを…　育てた？",shape=box,color=red];
		j25969040 -> j1750974181;
	j2180653694 [label="Boolean MinervaVelimir1 is now true.",color=orange];
		j2180653694 -> j1951232874;
	j1750974181 [label="Boolean MinervaNeci3a is now true.",color=orange];
		j1750974181 -> j3175513152;
	j1951232874 [label="PapaPolar: うーん。ある意味。もう違うがな。書類上は。どこかでは。1982年にはなくなったどこかの国ではね？",shape=box,color=blue];
		j1951232874 -> j308454665;
	j3175513152 [label="PapaPolar: おおむねそうだ。俺たちはここから数か国ほど南にある小さな町にいた。その町は爆破されて粉々になった。建物の中で、真っ赤な髪で怒っている彼女を見つけたんだ。",shape=box,color=blue];
		j3175513152 -> j2378380879;
	j308454665 [label="PapaPolar: それでもカウントされるかね？",shape=box,color=blue];
		j308454665 -> j4123844467;
		j308454665 -> j688238369;
	j2378380879 [label="PapaPolar: それで彼女はスプーンで6回も刺そうとしてきたんだ。ハハハ、カワイイやつだったさ。",shape=box,color=blue];
		j2378380879 -> j2649227125;
	j4123844467 [label="うーん、今も付き合ってるようには見えないね。",shape=box,color=red];
		j4123844467 -> j4175695649;
	j688238369 [label="喧嘩する理由がわかったよ。",shape=box,color=red];
		j688238369 -> j280357022;
	j2649227125 [label="PapaPolar: 彼女は小さなウサギのぬいぐるみを離さず持っていた。Mはそれを命を賭けて守ると彼女に言った。",shape=box,color=blue];
		j2649227125 -> j1306057010;
	j4175695649 [label="PapaPolar: ドウシテワカッタンダ。",shape=box,color=blue];
		j4175695649 -> j280357022;
	j280357022 [label="PapaPolar: neciがスカルドラに加わるために去ったとき…　この関係は今まで通りじゃいられなかった。多分それが決定打になったんだ。",shape=box,color=blue];
		j280357022 -> j2257209487;
	j1306057010 [label="PapaPolar: それでneciの信頼をすぐに勝ち取った。彼女はMに走って行って彼女に腕を回した。それで軍を辞めたんだ。まぁ、正式にはね。それで「コンサルタント」になった。",shape=box,color=blue];
		j1306057010 -> j3937646624;
	j2257209487 [label="PapaPolar: はぁ。",shape=box,color=blue];
		j2257209487 -> j3486678339;
	j3937646624 [label="PapaPolar: だから…　そうだな。俺たちで彼女を育てたようなものだろう。",shape=box,color=blue];
		j3937646624 -> j3486678339;
	j3486678339 [label="PapaPolar: さて、自分が得意なことをやる時だな。",shape=box,color=blue];
		j3486678339 -> j3942252786;
	j3942252786 [label="PapaPolar: 何を間違えたかわかっているふりをして、今度は同じ失敗を繰り返さないふりをする。",shape=box,color=blue];
		j3942252786 -> j2017522426;
	j2017522426 [label="+20 Chemistry",color=orange];
