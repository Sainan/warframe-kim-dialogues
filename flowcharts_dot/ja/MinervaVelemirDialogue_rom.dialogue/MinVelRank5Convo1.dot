		1500 -> 1502;
	1501 [label="PapaPolar: 乗っ取られているようだったか聞きたいなら、彼女は俺たちの娘みたいに喋ってた。何をどう言うべきかわかっていた。",shape=box,color=blue];
		1501 -> 1503;
	1502 [label="MomToxicated: 最初はお仕事の話ね。どう指揮を執っていたこととか。もちろん、彼女は具体的な数字や詳細は教えなかったけど。",shape=box,color=blue];
		1502 -> 1504;
	1503 [label="MomToxicated: でも有能な人質犯は籠の鳥に思い通りに歌わせる方法を知っている。",shape=box,color=blue];
		1503 -> 1505;
	1504 [label="MomToxicated: 私たちはスカルドラじゃないもの。電話の向こう側にとってはただの民間人。だから、彼女が私たちに機密情報を与えているわけはない。",shape=box,color=blue];
		1504 -> 1506;
	1505 [label="MomToxicated: それでも、この「無関心のモノ」がいつどうやって彼女を奪い去ったかについては何の手掛かりにならないわ。",shape=box,color=blue];
		1505 -> 1507;
	1506 [label="PapaPolar: でもあの時の彼女は…　悩まされていた。声からわかるぐらいに。",shape=box,color=blue];
		1506 -> 1508;
		1506 -> 1509;
	1507 [label="MomToxicated: あるいは私たちが彼女と喋ったとき、その体を動かしていたのは誰だったのか。",shape=box,color=blue];
		1507 -> 1510;
	1508 [label="彼女が？　悩む？　信じがたいな。",shape=box,color=red];
		1508 -> 1511;
	1509 [label="何に対して悩んでいたと思う？",shape=box,color=red];
		1509 -> 1512;
	1510 [label="PapaPolar: どうやって神を見つけてその[検閲済]顔を殴るのかは分からないが、[検閲済]してやる",shape=box,color=blue];
		1510 -> 1506;
	1511 [label="MomToxicated: 誰にでも起こりうることよ。特に「逃亡者」を追っているときには。",shape=box,color=blue];
		1511 -> 1513;
	1512 [label="MomToxicated: 「逃亡者」。",shape=box,color=blue];
		1512 -> 1513;
	1513 [label="MomToxicated: Entrati。その時は、ただの地元の麻薬王かレジスタンスのリーダーだと思っていた。",shape=box,color=blue];
		1513 -> 1514;
	1514 [label="PapaPolar: 化け物トースターTVゾンビについての言及も殆どなかったしな。もっと話題になるものだったろうに。",shape=box,color=blue];
		1514 -> 1515;
	1515 [label="MomToxicated: その時点で彼女はすでに腕を失っていたのかしら。こればかりはわからないわね。",shape=box,color=blue];
		1515 -> 1516;
		1515 -> 1517;
	1516 [label="会話はどう終わったの？",shape=box,color=red];
		1516 -> 1518;
	1517 [label="ホルバニアに行くと彼女に伝えたのか？",shape=box,color=red];
		1517 -> 1519;
	1518 [label="MomToxicated: スパイがいつも電話を切る方法よ。お互い嘘をついたの。",shape=box,color=blue];
		1518 -> 1520;
	1519 [label="PapaPolar: 笑　言うわけないだろ。街は封鎖されてたんだ、言ったろ？　潜入は極秘任務だったんだ。",shape=box,color=blue];
		1519 -> 1521;
	1520 [label="MomToxicated: 私たちは、違う場所の任務に向かうと伝えたわ。彼女のいる封鎖された街に派遣される予定なのにね。",shape=box,color=blue];
		1520 -> 1522;
	1521 [label="MomToxicated: そして私たちはスパイが電話を切るときの方法で会話を終えたわ。嘘をついてね。",shape=box,color=blue];
		1521 -> 1520;
	1522 [label="PapaPolar: そしてお互いに最大の嘘をつきあった。",shape=box,color=blue];
		1522 -> 1523;
	1523 [label="PapaPolar: 皆して「心配しないで、大丈夫だから」と言って。",shape=box,color=blue];
		1523 -> 1524;
	1524 [label="MomToxicated: でも、電話を切る前に本当のことを伝えたわ。",shape=box,color=blue];
		1524 -> 1525;
	1525 [label="PapaPolar: ああ。そうだった。",shape=box,color=blue];
		1525 -> 1526;
