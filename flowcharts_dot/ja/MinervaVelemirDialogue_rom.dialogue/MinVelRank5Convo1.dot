	1526 [label="それは？",shape=box,color=red];
		1526 -> 1528;
	1527 [label="それって？",shape=box,color=red];
		1527 -> 1528;
	1528 [label="PapaPolar: 「お前は俺たちのかわいい娘、それだけは何があっても変わらない」",shape=box,color=blue];
		1528 -> 1529;
	1529 [label="MomToxicated: 「どんなに遠くへ行っても、ずっとあなたを愛してるわ」",shape=box,color=blue];
		1529 -> 1530;
