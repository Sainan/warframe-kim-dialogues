	"Chat ends." [color=orange];
	j3726264642 [label="えっと…　話がある。",shape=box,color=red];
		j3726264642 -> j579375382;
	j579375382 [label="MomToxicated: どうしたの？",shape=box,color=blue];
		j579375382 -> j3791454516;
	j3791454516 [label="PapaPolar: 何かあったのかい？",shape=box,color=blue];
		j3791454516 -> j3466511321;
		j3791454516 -> j1184109048;
		j3791454516 -> j2335270198;
	j3466511321 [label="良いニュースと悪いニュースがある。Neciについて。",shape=box,color=red];
		j3466511321 -> j477331149;
	j1184109048 [label="二人とも希望を持ってほしい。Neciについて何か分かった…　けど複雑だ。完結もしていない。",shape=box,color=red];
		j1184109048 -> j429355394;
	j2335270198 [label="…やっぱり、やめておく。[閉じる]",shape=box,color=red];
		j2335270198 -> "Chat ends.";
	j477331149 [label="PapaPolar: 大人のやり方でやりな。悪いニュースからだ。",shape=box,color=blue];
		j477331149 -> j543578011;
	j429355394 [label="+5 Chemistry",color=orange];
		j429355394 -> j2444401020;
	j543578011 [label="MomToxicated: そうね。悪いニュースが最初ね。",shape=box,color=blue];
		j543578011 -> j2732418890;
	j2444401020 [label="MomToxicated: 人生なんてそんなものよ。でも警告は感謝するわ。",shape=box,color=blue];
		j2444401020 -> j3861119529;
	j2732418890 [label="無関心のモノがデュヴィリにたどり着いて…　Neciを連れて行った。",shape=box,color=red];
		j2732418890 -> j2306115118;
	j3861119529 [label="+5 Chemistry",color=orange];
		j3861119529 -> j3813766829;
	j2306115118 [label="PapaPolar: おいおいおい、あのおとぎ話の世界か？",shape=box,color=blue];
		j2306115118 -> j2070289222;
	j3813766829 [label="PapaPolar: 覚悟はするが、少なくても…　死んではいない、のだろ？",shape=box,color=blue];
		j3813766829 -> j2441011330;
	j2070289222 [label="MomToxicated: あなたを殺し続ける子供の独裁者がいるあの世界？",shape=box,color=blue];
		j2070289222 -> j1578032162;
		j2070289222 -> j3194605568;
	j2441011330 [label="わ…　わからない。多分。でも自分が知っていることを話す、どう判断するかは二人次第だ。",shape=box,color=red];
		j2441011330 -> j2732418890;
	j1578032162 [label="彼にとっては一種の生長の瞬間だったのかな？　まぁ、それは置いておいて…",shape=box,color=red];
		j1578032162 -> j1234162955;
	j3194605568 [label="それだ。",shape=box,color=red];
		j3194605568 -> j1234162955;
	j1234162955 [label="Neciは…　王座を奪った。ササヤキ、一言で言えば無関心のモノの軍隊、それらがデュヴィリを侵略して、彼女が権力を握った。",shape=box,color=red];
		j1234162955 -> j2664587814;
	j2664587814 [label="MomToxicated: フフ。彼女らしいわね。",shape=box,color=blue];
		j2664587814 -> j1118674638;
	j1118674638 [label="PapaPolar: でもそれは本当に「Neci」だったのか？　それとも皮を被ったなにかなのか？",shape=box,color=blue];
		j1118674638 -> j2252719613;
		j1118674638 -> j273745721;
	j2252719613 [label="わからない。",shape=box,color=red];
		j2252719613 -> j971882665;
	j273745721 [label="話したかったのはまさにそれだ。",shape=box,color=red];
		j273745721 -> j971882665;
	j971882665 [label="記録を見つけた。最初はバラバラだった。でもまとめてみると…　メッセージがあった。",shape=box,color=red];
		j971882665 -> j3852683277;
	j3852683277 [label="何かピンとこないか知りたいんだ。",shape=box,color=red];
		j3852683277 -> j4158150614;
	j4158150614 [label="MomToxicated: 謎解きと奇妙なメッセージですって？　こっちはその手のプロよ。",shape=box,color=blue];
		j4158150614 -> j1825421987;
	j1825421987 [label="PapaPolar: もしもしこちらスパイ屋です、ってな",shape=box,color=blue];
		j1825421987 -> j417115906;
	j417115906 [label="「ソルとルアが並ぶとき、迷い子は帰り道を見つけるであろう」",shape=box,color=red];
		j417115906 -> j774970622;
	j774970622 [label="PapaPolar: …クソ。M。これって。",shape=box,color=blue];
		j774970622 -> j1692667994;
	j1692667994 [label="MomToxicated: 落ち着いて。あれがNeciの頭の中にいるなら、彼女の記憶を知っていても不思議じゃないわ。",shape=box,color=blue];
		j1692667994 -> j1101488827;
		j1692667994 -> j782381881;
	j1101488827 [label="これはどう言う意味なんだ？",shape=box,color=red];
		j1101488827 -> j2189927084;
	j782381881 [label="片方のメッセージ、なんだろ？",shape=box,color=red];
		j782381881 -> j1397924601;
	j2189927084 [label="PapaPolar: 「空いた交差点で、日食を探せ」",shape=box,color=blue];
		j2189927084 -> j804910025;
	j1397924601 [label="+5 Chemistry",color=orange];
		j1397924601 -> j2846432860;
	j804910025 [label="PapaPolar: Neciを見つけたら伝えてほしいと言った言葉だ",shape=box,color=blue];
		j804910025 -> j2179545688;
	j2846432860 [label="PapaPolar: その通りだ…",shape=box,color=blue];
		j2846432860 -> j1069508399;
	j2179545688 [label="PapaPolar: 合言葉の片方さ。通話の始めに電話の回線、そしてお互いが安全であることを確認するためのものだ",shape=box,color=blue];
		j2179545688 -> j75492477;
	j1069508399 [label="PapaPolar: これは合言葉さ。通話の始めに電話の回線、そしてお互いが安全であることを確認するためのものだ",shape=box,color=blue];
		j1069508399 -> j75492477;
	j75492477 [label="MomToxicated: そしてお互いが…　お互いであることの確認。",shape=box,color=blue];
		j75492477 -> j903454753;
	j903454753 [label="PapaPolar: 「空いた交差点で、日食を探せ」がこちらの言葉。",shape=box,color=blue];
		j903454753 -> j1669906956;
	j1669906956 [label="MomToxicated: そして「ソルとルアが並ぶとき、迷い子は帰り道を見つけるであろう」が回答。",shape=box,color=blue];
		j1669906956 -> j311940000;
	j311940000 [label="MomToxicated: 「Neci」の回答ね。",shape=box,color=blue];
		j311940000 -> j1725875858;
		j311940000 -> j3860251838;
	j1725875858 [label="でもMinervaが言ったように、彼女が彼女である保証はない。無関心のモノには彼女の記憶がある。",shape=box,color=red];
		j1725875858 -> j351059752;
	j3860251838 [label="なぜ無関心のモノがそう言ったか検討もつかない…",shape=box,color=red];
		j3860251838 -> j1085708156;
	j351059752 [label="MomToxicated: でもなぜアレが希望を与えるような言葉を？　それとも単なる煽りなのか。",shape=box,color=blue];
		j351059752 -> j2429438053;
	j1085708156 [label="MomToxicated: 偽りの希望を与えるためじゃない？　こちらを傷つけるために。",shape=box,color=blue];
		j1085708156 -> j2710631945;
	j2429438053 [label="PapaPolar: 煽りになっているのか？",shape=box,color=blue];
		j2429438053 -> j433014791;
	j2710631945 [label="PapaPolar: 本当に偽りか？　これで傷つくか？",shape=box,color=blue];
		j2710631945 -> j433014791;
	j433014791 [label="PapaPolar: 一種の安らぎとしても捉えられる、Neciがどこかで生きていると知れてな？",shape=box,color=blue];
		j433014791 -> j3463793286;
	j3463793286 [label="PapaPolar: どれだけの困難にもかかわらず、どこかでブイブイ言わせているってな？",shape=box,color=blue];
		j3463793286 -> j3314352423;
	j3314352423 [label="PapaPolar: それが俺たちとじゃなくてもな？",shape=box,color=blue];
		j3314352423 -> j3255814600;
	j3255814600 [label="PapaPolar: お調子者の俺には十分さ、そっちはどうか知らないが。",shape=box,color=blue];
		j3255814600 -> j1982183472;
	j1982183472 [label="PapaPolar: 直感だが、彼女の行動は無関心のなんたらにあまり関係ないようにも思える",shape=box,color=blue];
		j1982183472 -> j666113294;
	j666113294 [label="MomToxicated: そうね。彼女がどこかで、何らかの形で生きているなら、苦痛に感じないわ。",shape=box,color=blue];
		j666113294 -> j797706683;
	j797706683 [label="MomToxicated: 彼女を誇りに思うわ。",shape=box,color=blue];
		j797706683 -> j4079898747;
		j797706683 -> j2989308315;
		j797706683 -> j156769105;
	j4079898747 [label="無関心のモノに人質に囚われているとしても？",shape=box,color=red];
		j4079898747 -> j769072326;
	j2989308315 [label="無関心のモノによるトリックだとしても？",shape=box,color=red];
		j2989308315 -> j691099111;
	j156769105 [label="彼女は無関心のモノに協力しているのかもしれない。",shape=box,color=red];
		j156769105 -> j3015259349;
	j769072326 [label="PapaPolar: Neciはヤワじゃないさ",shape=box,color=blue];
		j769072326 -> j76509348;
	j691099111 [label="MomToxicated: なぜそんなことを？　私たちから得られるものなどないでしょうに。",shape=box,color=blue];
		j691099111 -> j226994827;
	j3015259349 [label="MomToxicated: だとすれば彼女は全世界で最も強力な仲間を手に入れたことになるわ。全存在で。彼女はつく側を選んだ。私たちがしたように。",shape=box,color=blue];
		j3015259349 -> j3428418705;
	j76509348 [label="PapaPolar: 「壁の中のモノ」とやらもそれを理解しているはずだ、彼女を選んだのもそれが理由だろう",shape=box,color=blue];
		j76509348 -> j3229592358;
	j226994827 [label="PapaPolar: アレからすれば俺たちは取るに足らない存在だ。ベストな捉え方をするならな",shape=box,color=blue];
		j226994827 -> j2221983874;
	j3428418705 [label="MomToxicated: 願わくば、銃を向けあいたくないわね。でもその時が来たら？　その時に対処するだけ。",shape=box,color=blue];
		j3428418705 -> j4161480529;
	j3229592358 [label="PapaPolar: いや違うな、Neciはきっと大丈夫さ。既に死んでないとすれば、何らかの協定関係にあるか、本当の人質はあっち側かだ（笑）",shape=box,color=blue];
		j3229592358 -> j2221983874;
	j2221983874 [label="MomToxicated: だから、あのメッセージは本物だと信じるわ。Neci本人からのメッセージ。彼女が…　まだ戦っているというメッセージ。",shape=box,color=blue];
		j2221983874 -> j3429775065;
	j4161480529 [label="PapaPolar: Neciなら自分でなんとかするさ。なんせそう育てたからな",shape=box,color=blue];
		j4161480529 -> j2221983874;
	j3429775065 [label="MomToxicated: 彼女なりに、「大丈夫」と伝えているのよ。",shape=box,color=blue];
		j3429775065 -> j1520302991;
	j1520302991 [label="MomToxicated: 「心配しないで」って。",shape=box,color=blue];
		j1520302991 -> j2311637102;
	j2311637102 [label="PapaPolar: ハハ、不可能な要望だな",shape=box,color=blue];
		j2311637102 -> j4132087278;
	j4132087278 [label="MomToxicated: 親である祝福と呪いよ。",shape=box,color=blue];
		j4132087278 -> j3027313524;
	j3027313524 [label="PapaPolar: 子供が欲しいと思ったことはあるか、漂流者？　…いや、答えなくていい。どうせvoidなんちゃらで理解できないだろうし",shape=box,color=blue];
		j3027313524 -> j1143078711;
		j3027313524 -> j775495302;
		j3027313524 -> j2815777535;
	j1143078711 [label="飲みに行こうか？",shape=box,color=red];
		j1143078711 -> j665694732;
	j775495302 [label="そうだね。",shape=box,color=red];
		j775495302 -> j3822794800;
	j2815777535 [label="<RETRO_EMOJI_OHNO>",shape=box,color=red];
		j2815777535 -> j706188412;
	j665694732 [label="+5 Chemistry",color=orange];
		j665694732 -> j2230938235;
	j3822794800 [label="PapaPolar: まぁ確かにハッピーハッピーと言うよりはメランコリックハッピーだが",shape=box,color=blue];
		j3822794800 -> j2134230453;
	j706188412 [label="MomToxicated: 的確な反応ね、同意するわ。フフ、飲みにでも行きましょうか？",shape=box,color=blue];
		j706188412 -> j4225539170;
	j2230938235 [label="MomToxicated: 良い提案ね。",shape=box,color=blue];
		j2230938235 -> j2134230453;
	j2134230453 [label="PapaPolar: 数杯飲んでNeciについてもっと話したいしな",shape=box,color=blue];
		j2134230453 -> j1259366565;
	j4225539170 [label="PapaPolar: イイね",shape=box,color=blue];
		j4225539170 -> j2134230453;
	j1259366565 [label="MomToxicated: あと…　漂流者。ありがとう。本当に。ここまでやってくれて。",shape=box,color=blue];
		j1259366565 -> j2734326143;
	j2734326143 [label="PapaPolar: 本当にそうだ。どう恩を返したらいいかわからない。もし俺たちにできることがあるなら、何でも言ってくれ",shape=box,color=blue];
		j2734326143 -> j3675880023;
	j3675880023 [label="PapaPolar: 君がどう思おうと、俺たちはもう家族当然だ 8-)",shape=box,color=blue];
		j3675880023 -> "Chat ends.";
}