	j4036579891 [label="PapaPolar: 彼女は指揮している人間が自分の子供であるように気に掛けていた。家族だと。一人ひとりにだ。配備二日目の士官生が即席爆弾の解除に失敗して手首を吹き飛ばして、涙を流す人なんて他に見たことがない。",shape=box,color=blue];
