		j4254595469 -> j2110409699;
	j2251625636 [label="MomToxicated: この話をするのにワインがあれば最高なのだけど。",shape=box,color=blue];
		j2251625636 -> j170233341;
	j2110409699 [label="PapaPolar: うお、ポップコーンのバケツを持ってこないと、すぐ戻る。",shape=box,color=blue];
		j2110409699 -> j1056890694;
	j170233341 [label="MomToxicated: どうぞ。続けて。",shape=box,color=blue];
		j170233341 -> j2853462873;
	j1056890694 [label="MomToxicated: もう少し具体的に聞いてくれない？　それだと範囲が広すぎるわ。",shape=box,color=blue];
		j1056890694 -> j539306863;
		j1056890694 -> j3368482057;
	j2853462873 [label="PapaPolar: そいつはデカい質問だな。噛み砕いて話してくれるかな？",shape=box,color=blue];
		j2853462873 -> j3314263870;
		j2853462873 -> j1590541070;
	j539306863 [label="彼女がどうやって軍部の狂信者になったのか興味がある。",shape=box,color=red];
		j539306863 -> j364693989;
	j3368482057 [label="まあ、彼女が…　どうやってああなったのか気になっている。",shape=box,color=red];
		j3368482057 -> j2972111245;
	j3314263870 [label="まあ、彼女が…　どうやってああなったのか気になっている。",shape=box,color=red];
		j3314263870 -> j2607969619;
	j1590541070 [label="彼女がどうやって軍部の狂信者になったのか興味がある。",shape=box,color=red];
		j1590541070 -> j3788015199;
	j364693989 [label="MomToxicated: 狂信者という言葉遣いには頷けないわね。でも確かにそちら側の視点から見て、彼女とどう関わったのかを考えれば、そう言うのも分からないでもないけれど。",shape=box,color=blue];
		j364693989 -> j683493687;
	j2972111245 [label="MomToxicated: 私は彼女が自分自身の才覚を100%発揮できるように育てた。何が言いたいの？",shape=box,color=blue];
		j2972111245 -> j2320134657;
	j2607969619 [label="PapaPolar: 彼女の母親を見てみなよ。",shape=box,color=blue];
		j2607969619 -> j1500474502;
	j3788015199 [label="PapaPolar: おおっと。",shape=box,color=blue];
		j3788015199 -> j2718564879;
	j683493687 [label="MomToxicated: Neciにとっては、スカルドラに加わった頃は、目的のための手段だったと思うの。彼女は周囲の人々を、信仰以上に信じていた。Vodyanoiとは違う。",shape=box,color=blue];
		j683493687 -> j667650734;
	j2320134657 [label="PapaPolar: 何を言いたいのかははっきりしてると思うがね、M",shape=box,color=blue];
		j2320134657 -> j3206498849;
	j1500474502 [label="MomToxicated: コホン。彼女をヘビースモーカーにした原因がよく言うわね。",shape=box,color=blue];
		j1500474502 -> j3575471041;
	j2718564879 [label="PapaPolar: いいか。彼女がそもそもあの…　ソル・ルア崇拝カルトみたいなのにのめり込んでいたかどうかわからない",shape=box,color=blue];
		j2718564879 -> j2490005399;
	j667650734 [label="MomToxicated: Neciは野心家だった。私はそれに発破を掛け、励まし、その炎に薪をくべた。その野心を凍らせて、子供のまま留めておこうとする*誰か*さんと違ってね。",shape=box,color=blue];
		j667650734 -> j3021859752;
	j3206498849 [label="PapaPolar: 服のセンスは明らかに誰かさんの影響だしな。",shape=box,color=blue];
		j3206498849 -> j3758911854;
	j3575471041 [label="PapaPolar: あーはいはい、服のセンスは明らかに誰かさんの影響だしな。",shape=box,color=blue];
		j3575471041 -> j1916525790;
	j2490005399 [label="PapaPolar: 少なくとも他のスカルドラが傾倒するほどにはね。彼女にとっては目的のための手段だったのだろう。",shape=box,color=blue];
		j2490005399 -> j1719140534;
	j3021859752 [label="PapaPolar: 行っていいと言ったのは俺の方だがな？！",shape=box,color=blue];
		j3021859752 -> j1478944570;
	j3758911854 [label="MomToxicated: 面白いこと言うのね。ほんとに。少なくても彼女の喫煙癖は私のせいじゃないわ。",shape=box,color=blue];
		j3758911854 -> j857144753;
	j1916525790 [label="PapaPolar: 彼女が身につけたことは、それが効くから身につけたことで、どこかでは学んでいたさ。それは否定できないだろう。",shape=box,color=blue];
		j1916525790 -> j1787845611;
	j1719140534 [label="PapaPolar: 上に登れるならば、どうやってでも登る意味があると考える人もいる。",shape=box,color=blue];
		j1719140534 -> j2325864126;
	j1478944570 [label="MomToxicated: ええ、そうね。過保護なあなたが彼女の自己主張を唯一許した*たったの一回*が、あなたが私の言うことを聞き入れず、信じずに、彼女が行くことを許した*たったの一回*が、どういう結果になったか見てご覧なさい！",shape=box,color=blue];
		j1478944570 -> j835626767;
	j857144753 [label="MomToxicated: Velimirが下品ながら説明しようとしているのは、女性は、時に事態を切り抜けるのに選択肢が限られている、ということよ。",shape=box,color=blue];
		j857144753 -> j2808947621;
	j1787845611 [label="PapaPolar: つまりだな、軍に居ると…　時に自分の武器を持ち上げる必要があるだろう？",shape=box,color=blue];
		j1787845611 -> j635706702;
	j2325864126 [label="MomToxicated: 彼女には野心があった。あなたはいつもそれを抑えようとしていた。",shape=box,color=blue];
		j2325864126 -> j3357828536;
