	j316887910 [label="PapaPolar: 本当にそうだ。",shape=box,color=blue];
		j316887910 -> j1964235947;
	j4101514414 [label="PapaPolar: そんな彼女は彼の隣に座って、話しかけ、全て大丈夫だと言った。実際は大丈夫じゃなかったが。その士官生は一ヶ月後の襲撃で死んだ。けれど、その励ましでその士官生は未来が明るく虹がかかっていると信じただろう",shape=box,color=blue];
		j4101514414 -> j865419738;
	j350834546 [label="MomToxicated: 彼らは一時間もしない内に領土紛争を解決した。そして二人は友人として去っていった。",shape=box,color=blue];
