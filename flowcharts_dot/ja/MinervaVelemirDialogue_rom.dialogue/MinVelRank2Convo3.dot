	j3249156981 [label="MomToxicated: 微笑んで、Neciは彼らをテーブルに座るよう促した。そして彼らの母語で、流暢に、彼らの間には、外部の世界よりも、沢山の共通点があると言った。そして彼らは兄弟だと。兄弟は時に争うが、決して互いを殺し合うべきではないと。",shape=box,color=blue];
		j3249156981 -> j350834546;
	j1124170830 [label="MomToxicated: どうして？　こちらのほうが楽しいでしょう。",shape=box,color=blue];
		j1124170830 -> j1246700188;
	j2686116965 [label="PapaPolar: 繊細な急所の話はしていない。でもそうであった方がいいと思わせてやる",shape=box,color=blue];
