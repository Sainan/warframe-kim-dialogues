		j4145183984 -> j3734314348;
	j3734314348 [label="MomToxicated: 行ったわ。そしたらルーシ人が蜂の巣つついたみたいに怒って大挙してきたから、食事も終えずに急いで出たんじゃない。",shape=box,color=blue];
		j3734314348 -> j2719180690;
