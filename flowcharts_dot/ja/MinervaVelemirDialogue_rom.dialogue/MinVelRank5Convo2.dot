		j288637689 -> j1600231107;
	j2109695169 [label="MomToxicated: 私たちがシテ・ド・ラ・リュミエールにいたとき、外国代表団の委員に話していたでしょう。",shape=box,color=blue];
		j2109695169 -> j1835947178;
	j1835947178 [label="PapaPolar: ああそうだ！　ハハハ。あの遠征のことを完全に忘れていた。君は首相のワインに毒を盛るのに忙しいと思ってたけど。",shape=box,color=blue];
		j1835947178 -> j1595334240;
