		j2503007650 -> j1264767833 [label=false,color=brown];
	j1245666649 [label="PapaPolar: 彼女はまだ持っているだろうか…　いや、持っていたんだろうか。無関心のモノがスーツケースを持ち運ぶとは思わないが。",shape=box,color=blue];
		j1245666649 -> j1824533953;
	j1264767833 [label="PapaPolar: 全部ゴミ箱行きになっただろうね。無関心のモノは無意味で雑多なガラクタいっぱいのスーツケースを持ち運んだりしないだろうし。",shape=box,color=blue];
		j1264767833 -> j2723961828;
