	j459979086 [label="そう。",shape=box,color=red];
		j459979086 -> j4042651489;
	j4278316699 [label="そっちが言ったんだ、こっちじゃない。",shape=box,color=red];
		j4278316699 -> j4042651489;
	j1794636988 [label="MomToxicated: そして彼女はあなたにライターを買ってあげた。",shape=box,color=blue];
		j1794636988 -> j827005208;
	j2681534370 [label="PapaPolar: 俺がなぜこんなにたくさんの話をしていると思う？",shape=box,color=blue];
		j2681534370 -> j3279729069;
	j4042651489 [label="PapaPolar: 母親似だ、間違いなく。でもあの子には数えきれない喜びもあった。",shape=box,color=blue];
		j4042651489 -> j2681534370;
	j827005208 [label="MomToxicated: 12歳の女の子がカウンターに歩み寄って、ライターをカウンターに叩きつけて、カウンターの後ろの男性を睨みつけるほど面白いことはないわ。",shape=box,color=blue];
		j827005208 -> j303781079;
	j3279729069 [label="PapaPolar: 彼女と一緒にいる時の習慣だった。それを聞くのが好きだった。いつも俺とMがやってることを聞きたがっていた",shape=box,color=blue];
		j3279729069 -> j800624235;
	j303781079 [label="MomToxicated: 更に彼女は真剣な顔して、望んだ通りに刻印を刻むよう要求した。",shape=box,color=blue];
		j303781079 -> j2215975389;
		j303781079 -> j1466509962;
	j800624235 [label="PapaPolar: で俺は彼女にあれとかこれとか話して、武勇伝も話したりした",shape=box,color=blue];
		j800624235 -> j2044355624;
	j2215975389 [label="彼女は子供の頃は笑っていたの？　普通の笑い方で。邪悪な笑い方じゃなくて。",shape=box,color=red];
		j2215975389 -> j2694389851;
	j1466509962 [label="想像できるよ。",shape=box,color=red];
		j1466509962 -> j1412742995;
	j2044355624 [label="PapaPolar: あとは失敗談とか",shape=box,color=blue];
		j2044355624 -> j2208977573;
	j2694389851 [label="PapaPolar: おいおい何言ってんだ？　いつも笑っていたさ！　neciは笑うのが大好きなんだ。",shape=box,color=blue];
		j2694389851 -> j2475542856;
		j2694389851 -> j1507042604;
	j1412742995 [label="PapaPolar: 母親似だ、間違いなく。でもあの子には数えきれない喜びもあった。",shape=box,color=blue];
		j1412742995 -> j2965775918;
	j2208977573 [label="PapaPolar: それで彼女はずーーーっと笑い転げてた",shape=box,color=blue];
		j2208977573 -> j3425148529;
	j1507042604 [label="そうなんだ？　彼女はどんな時笑った？（親父ギャグはもういいから）",shape=box,color=red];
		j1507042604 -> j2681534370;
	j2965775918 [label="PapaPolar: neciは笑うのが大好きなんだ。",shape=box,color=blue];
		j2965775918 -> j1507042604;
		j2965775918 -> j2475542856;
	j3425148529 [label="PapaPolar: 彼女は喜劇悲劇全部の話が本当に好きだった",shape=box,color=blue];
		j3425148529 -> j368471109;
	j368471109 [label="MomToxicated: そして私たちはいつも彼女にちょっとしたオブジェを買って帰ったわ。何でも喜んでくれた。",shape=box,color=blue];
		j368471109 -> j3590715524;
	j3590715524 [label="MomToxicated: けれどそれは彼女にとって物語の一部だった。その記憶の一部。そしてコレクションの一部になった。",shape=box,color=blue];
		j3590715524 -> j587593508;
	j587593508 [label="MomToxicated: 彼女はそこにいなかったかもしれないけれど、そのオブジェはいた。",shape=box,color=blue];
		j587593508 -> j2503007650;
	j2503007650 [label="Check boolean MinVelTogether",color=orange];
