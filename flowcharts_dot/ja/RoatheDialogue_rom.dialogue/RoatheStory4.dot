	j2433246267 [label="ボイスメール：傲慢",shape=box,color=blue];
		j2433246267 -> j109453525;
	j109453525 [label="負けるとは微塵も思わなかった。",shape=box,color=blue];
		j109453525 -> j4045786444;
	j4045786444 [label="センティエントが初めて遠征攻撃を仕掛けた際、我々は懲罰的な反撃を準備していた。",shape=box,color=blue];
		j4045786444 -> j721783645;
	j721783645 [label="攻撃ドローンと銀の装甲をまとった精鋭隊をふんだんに乗せたガレオン船「ギルダーグラスエンチャントラス」が、ケレスの霧から威嚇する翼を広げ現れた。",shape=box,color=blue];
		j721783645 -> j1904517470;
	j1904517470 [label="その外装には霧のように細かい回路が、半透明な装甲の下に繊細なレースを描いていた。",shape=box,color=blue];
		j1904517470 -> j53154446;
	j53154446 [label="その船はあまりに巨大で、ソーラーレールの端をかろうじて通り抜けた。",shape=box,color=blue];
		j53154446 -> j1841386934;
	j1841386934 [label="センティエントたちは、見せびらかすように攻撃を仕掛けた。彼らは歌い、機器類が無効化された。銀の兵士たちは成す術もなく窒息した。",shape=box,color=blue];
		j1841386934 -> j2628715244;
	j2628715244 [label="エンジンを失くしたギルダーグラスエンチャントラスはTauの空で燃え上がり、クルーは焼死し、複雑で高価な花火となった。",shape=box,color=blue];
		j2628715244 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}