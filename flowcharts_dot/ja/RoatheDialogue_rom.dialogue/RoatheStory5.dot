	"Chat ends." [color=orange];
	j3524788841 [label="ボイスメール：発明",shape=box,color=blue];
		j3524788841 -> j1467634988;
	j1467634988 [label="武闘派アルキメデスの展開は、当初は娯楽としてしか捉えられなかった。",shape=box,color=blue];
		j1467634988 -> j3386181347;
	j3386181347 [label="まるで、サーカスの闘技場で犯罪者が処刑されるのを観るように。",shape=box,color=blue];
		j3386181347 -> j2486632508;
	j2486632508 [label="我々は、はるかに劣る敵を倒すための、新しく刺激的な方法を編み出していると錯覚していた。",shape=box,color=blue];
		j2486632508 -> j4156468491;
	j4156468491 [label="どれほど自惚れていたことか。しかし実際には、変幻自在な敵に自分たちが劣っていることを知りながら、必死に革新を続けた。",shape=box,color=blue];
		j4156468491 -> j33074635;
	j33074635 [label="彼らは、膨れ上がった母親を貪り食う子供のように、我々を飲み込んだ。",shape=box,color=blue];
		j33074635 -> j847010328;
	j847010328 [label="干からびて、時のページに押しつぶされた我々が、彼らの進化に追いつけるはずもなかった。",shape=box,color=blue];
		j847010328 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}