		5402 -> 5404 [label=true,color=green];
		5402 -> 5799 [label=false,color=brown];
	5403 [label="Chat ends.",color=orange];
	5404 [label="Check boolean RoatheConsentComplete",color=orange];
		5404 -> 5408 [label=true,color=green];
		5404 -> 5407 [label=false,color=brown];
		5404 -> 5406 [label=false,color=brown];
	5799 [label="Check boolean RoathePolyamorySuccess",color=orange];
		5799 -> 5404 [label=true,color=green];
		5799 -> 5405 [label=false,color=brown];
	5408 [label="Chat ends.",color=orange];
	5407 [label="ねえRoathe。ちょっといい？[複数のパートナーについて同意を得る]",shape=box,color=red];
		5407 -> 5410;
	5406 [label="[閉じる]",shape=box,color=red];
		5406 -> 5409;
	5405 [label="Chat ends.",color=orange];
	5410 [label="ん？　何だ、我が愛よ？",shape=box,color=blue];
		5410 -> 5412;
	5409 [label="Update boolean RoatheConsentComplete",color=orange];
		5409 -> 5411;
	5412 [label="話したいことがある。Roatheの意見を聞きたいんだ。",shape=box,color=red];
		5412 -> 5413;
	5411 [label="Chat ends.",color=orange];
	5413 [label="Roatheに嘘をついているとか、不誠実だと思わせたくないから。",shape=box,color=red];
		5413 -> 5414;
	5414 [label="ほう、面白い。続けろ。",shape=box,color=blue];
		5414 -> 5415;
	5415 [label="納得できない状況にRoatheを置きたくない。もしダメなら、そう言ってほしい。",shape=box,color=red];
		5415 -> 5416;
	5416 [label="自分たちの関係は大切に思っている。本当に。切実に。それだけはわかってほしい。",shape=box,color=red];
		5416 -> 5417;
	5417 [label="待て。お前は遠回しに他にパートナーがいることを伝えたいのか？",shape=box,color=blue];
		5417 -> 5418;
	5418 [label="我を愚か者と捉えるか？　そんなこともう知っておる！",shape=box,color=blue];
		5418 -> 5419;
		5418 -> 5420;
	5419 [label="じゃあ、気にしないんだね？",shape=box,color=red];
		5419 -> 5421;
	5420 [label="そう…　なの？",shape=box,color=red];
		5420 -> 5422;
	5421 [label="サンクタムで笑いこける我の声を聞かせてやりたいくらいだ。漂流者よ、最愛の漂流者よ。我はオロキンだ。気にするわけなかろう。",shape=box,color=blue];
		5421 -> 5423;
	5422 [label="サンクタムで笑いこける我の声を聞かせてやりたいくらいだ。漂流者よ、最愛の漂流者よ。",shape=box,color=blue];
		5422 -> 5424;
	5423 [label="我々の社会や、我々の「関係」に対する見解をどう見ようと構わない。だがオロキンにも愛という感情はあったのだ。",shape=box,color=blue];
		5423 -> 5425;
	5424 [label="確定した時点でもう分かっていた。我の情報網は広いのだ。それに、気にもしない。我はオロキンだ。",shape=box,color=blue];
		5424 -> 5423;
	5425 [label="オロキンほど愛に寛容なものはいなかった。人の心には複数の愛を受け入れられる余地があることを理解していた。",shape=box,color=blue];
		5425 -> 5426;
	5426 [label="心狭い狂信者どもがこの幸せを共有できないのが残念だ。",shape=box,color=blue];
		5426 -> 5427;
	5427 [label="いや、今のは撤回する。それによる混乱を想像できるか？",shape=box,color=blue];
		5427 -> 5428;
	5428 [label="Update boolean RoatheConsentComplete",color=orange];
		5428 -> 5429;
	5429 [label="とにかくだ、その者がお前を幸せにするなら、それを楽しむといい。だが、我と時間を過ごす間は…",shape=box,color=blue];
		5429 -> 5430;
	5430 [label="+5 Chemistry",color=orange];
		5430 -> 5431;
	5431 [label="お前は我一人のものだ。",shape=box,color=blue];
		5431 -> 5432;
	5432 [label="Chat ends.",color=orange];
}