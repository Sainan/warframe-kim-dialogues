	2132 [label="彼女の狂気は、それが明白だったからこそ、人を魅了した。",shape=box,color=blue];
		2132 -> 5636;
	5636 [label="彼女といると、自分がどこに立っているかが明らかになる：大いなる深淵の断崖に。",shape=box,color=blue];
		5636 -> 5635;
	5635 [label="飛び込めと、彼女の瞳は喜びに輝きながら、そう語りかけた。",shape=box,color=blue];
		5635 -> 5637;
	5637 [label="
彼女の狂気を通して、我はオロキンの長く暗い停滞から逃れることができた。",shape=box,color=blue];
		5637 -> 2136;
	2136 [label="我々の感覚は、何世紀も前に麻痺しきっていた。それでも、彼女は彼女なりに、新鮮だった。",shape=box,color=blue];
		2136 -> 5638;
	5638 [label="永久に、絶えない飢えがあった。ある晩、彼女は我を風呂に呼んだ。香水と血が混じり合う水たまりを闊歩し、忠実に直立不動の姿勢を取った。",shape=box,color=blue];
		5638 -> 5639;
	5639 [label="「退屈だ、Roathe。他のオロキンどもを皆殺しにして、支配しよう。」",shape=box,color=blue];
