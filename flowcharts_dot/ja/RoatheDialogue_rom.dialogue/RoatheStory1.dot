	"Chat ends." [color=orange];
	j1706469108 [label="ボイスメール：NITOKH",shape=box,color=blue];
		j1706469108 -> j3846223603;
	j3846223603 [label="彼女の狂気は、それが明白だったからこそ、人を魅了した。",shape=box,color=blue];
		j3846223603 -> j967433052;
	j967433052 [label="彼女といると、自分がどこに立っているかが明らかになる：大いなる深淵の断崖に。",shape=box,color=blue];
		j967433052 -> j2993282765;
	j2993282765 [label="飛び込めと、彼女の瞳は喜びに輝きながら、そう語りかけた。",shape=box,color=blue];
		j2993282765 -> j2734356298;
	j2734356298 [label="\n彼女の狂気を通して、我はオロキンの長く暗い停滞から逃れることができた。",shape=box,color=blue];
		j2734356298 -> j1125947632;
	j1125947632 [label="我々の感覚は、何世紀も前に麻痺しきっていた。それでも、彼女は彼女なりに、新鮮だった。",shape=box,color=blue];
		j1125947632 -> j3259104151;
	j3259104151 [label="永久に、絶えない飢えがあった。ある晩、彼女は我を風呂に呼んだ。香水と血が混じり合う水たまりを闊歩し、忠実に直立不動の姿勢を取った。",shape=box,color=blue];
		j3259104151 -> j2083072767;
	j2083072767 [label="「退屈だ、Roathe。他のオロキンどもを皆殺しにして、支配しよう。」",shape=box,color=blue];
		j2083072767 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}