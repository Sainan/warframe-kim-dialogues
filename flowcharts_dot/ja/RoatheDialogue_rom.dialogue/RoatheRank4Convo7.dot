	j3821076670 [label="Check boolean DrifterRoathe",color=orange];
		j3821076670 -> j478826301 [label=true,color=green];
		j3821076670 -> j3670020332 [label=false,color=brown];
	j1253958299 [label="簒奪者よ、本日を持って貴様のダーク・リフラクトリーでの責務は終わりだ。これ以上記憶を掘り起こす必要はない。",shape=box,color=blue];
		j1253958299 -> j3829396087;
	j3382096854 [label="簒奪者よ、ダーク・リフラクトリーでの我の記憶の奪還はまだ終わっていないようだが、喜ぶがいい。本日を持って我はこれ以上の追求を停止することを宣言する。",shape=box,color=blue];
		j3382096854 -> j3829396087;
	j4125746552 [label="簒奪者よ、貴様はどうやら…　ダーク・リフラクトリーでの責務を始めてもいないようだが、喜ぶがいい。本日を持って我はこれ以上の追求を停止することを宣言する。",shape=box,color=blue];
		j4125746552 -> j2709786759;
	j2821754608 [label="貴様は、これまでの事に対して感謝と謝罪を期待しているかもしれないが、我が記憶の抹消とやり直しを要求し、それによって受けた苦痛を考慮して、借り貸しを「帳消し」にしただけだと捉えている。",shape=box,color=blue];
		j2821754608 -> j2247117260;
		j2821754608 -> j3336831882;
	j3302951996 [label="この追求も、空虚に感じる。結果は貴様だけが知るのだろう。では、見届けるとしよう。",shape=box,color=blue];
		j3302951996 -> j2247117260;
		j3302951996 -> j2525175213;
	j478826301 [label="簒奪者よ、不快かもしれんが一つ要求がある。これを伝えるのは実に心が痛む。少なくとも、貴様が我との関係を望んでいることは承知している。心のどこかに、我を受け入れる場所があれば幸いなのだが…",shape=box,color=blue];
		j478826301 -> j2435314579;
		j478826301 -> j3744422169;
		j478826301 -> j3504184232;
	j3670020332 [label="簒奪者よ、不快かもしれんが一つ要求がある。これを伝えるのは実に心が痛む。だが先に聞きたいことがある…　我々は友なのか？　心のどこかに、我を仲間として受け入れる場所はあるのか？",shape=box,color=blue];
		j3670020332 -> j3990430604;
		j3670020332 -> j2982840298;
		j3670020332 -> j1324835392;
	j3829396087 [label="我の精神の中で架空の鞭打ちをし時間を無駄にする必要はない、そうであろう？（司祭はそれを好むようだが）",shape=box,color=blue];
		j3829396087 -> j1266697751;
	j2709786759 [label="このことは全て忘れてもらって構わない。架空の鞭打ちよりも、他のタスクに時間をわいた方がいい、そうであろう？（司祭はそれを好むようだが）",shape=box,color=blue];
		j2709786759 -> j3077456970;
	j2247117260 [label="一緒に乗り越えよう。",shape=box,color=red];
		j2247117260 -> j3502586957;
	j3336831882 [label="Roatheが頼んだからリセットしたんだ。怒ることも警告された。",shape=box,color=red];
		j3336831882 -> j2377920824;
	j2525175213 [label="確かに、あともうちょっとだ。",shape=box,color=red];
		j2525175213 -> j2263938838;
	j2435314579 [label="Roatheのことは気にかけている。受け入れるかまではまだ分からないけど。",shape=box,color=red];
		j2435314579 -> j4236472613;
	j3744422169 [label="Roatheのことをもっと知って、気が変わった。Roatheは耐え難いと思う。",shape=box,color=red];
		j3744422169 -> j1472231521;
	j3504184232 [label="Roatheは自分にとって大切な人だ。これは本心だ。これが正しいかわからない…　でも、自分はRoatheに恋しているんだと思う。",shape=box,color=red];
		j3504184232 -> j4062606780;
	j3990430604 [label="それ以上と…　感じている。[告白する]",shape=box,color=red];
		j3990430604 -> j2378286931;
	j2982840298 [label="Roatheを友だちと思っている。",shape=box,color=red];
		j2982840298 -> j3554793890;
	j1324835392 [label="正直、Roatheは耐え難い。",shape=box,color=red];
		j1324835392 -> j1003472967;
	j1266697751 [label="むしろ、これ以上進めないことを強く要求する。",shape=box,color=blue];
		j1266697751 -> j3703058924;
