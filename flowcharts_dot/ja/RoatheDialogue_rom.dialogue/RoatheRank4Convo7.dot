		j3077456970 -> j2046334989 [label="false",color=purple];
	j3502586957 [label="もし失敗しても、貴様には解決策があるのだろう？　まあいい、明日は別の日だ。しかし、昨日のように感じるかもしれないな。",shape=box,color=blue];
		j3502586957 -> j298080266;
	j2377920824 [label="そうだな、そうしていただろうな。そして我は正しかったようだ。まあいい、明日は別の日だ。しかし、昨日のように感じるかもしれないな。",shape=box,color=blue];
		j2377920824 -> j298080266;
