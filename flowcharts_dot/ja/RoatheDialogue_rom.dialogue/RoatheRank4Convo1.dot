	j3892859935 [label="Boolean RoatheUsurper is now true.",color=orange];
		j3892859935 -> j1214418154;
	j682189259 [label="いや、悪口にしてはおかしいなと思って。Roatheだって同じことをしようとしたわけだし。",shape=box,color=red];
		j682189259 -> j3050739916;
	j2335339157 [label="なんでその称号で呼ぶのかなって。",shape=box,color=red];
		j2335339157 -> j2313803381;
	j3089152236 [label="ハッ！　そんなわけなかろう！　もし今日までずっと貴様を罵倒していたと思うなら、相当器が大きいのだな。",shape=box,color=blue];
		j3089152236 -> j2389195802;
	j1214418154 [label="そうではないのか？　テンノはOrigin太陽系をオロキンから簒奪した。そして貴様は他人の巣に残されたカッコウのように、自らの世界からこの世界に紛れ込んできた存在だ。",shape=box,color=blue];
		j1214418154 -> j1853637318;
	j3050739916 [label="ハッ！　我が貴様を侮辱していると？　そんなわけなかろう！　もし今日までずっと貴様を罵倒していたと思うなら、相当器が大きいのだな。",shape=box,color=blue];
		j3050739916 -> j1583718725;
	j2313803381 [label="+5 Chemistry",color=orange];
