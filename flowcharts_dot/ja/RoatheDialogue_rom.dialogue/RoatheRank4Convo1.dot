		j2389195802 -> j1294672479 [label=true,color=green];
		j2389195802 -> j2350138364 [label=false,color=brown];
	j1853637318 [label="この二つの点から、我から見て貴様は簒奪者なのだ（執事から聞かされたデュヴィリの件も含めれば、もう一点追加されるかもしれんがな。その話はまた今度だ）。",shape=box,color=blue];
		j1853637318 -> j2866562377;
		j1853637318 -> j1841034262;
	j1583718725 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1583718725 -> j3623661764 [label=true,color=green];
		j1583718725 -> j3991632225 [label=false,color=brown];
	j2613091915 [label="それが一番適した称号だからだ。貴様は我が望んでいた事を成し遂げたのだ。",shape=box,color=blue];
		j2613091915 -> j1045730363;
	j1294672479 [label="特に、貴様には我に対抗できない能力があるのだからな？",shape=box,color=blue];
		j1294672479 -> j4221030778;
	j2350138364 [label="特に、我らの力量の差はそちらに分があるからな。",shape=box,color=blue];
		j2350138364 -> j4221030778;
	j2866562377 [label="つまり…　悪口で言っていると。",shape=box,color=red];
		j2866562377 -> j3050739916;
	j1841034262 [label="つまり、これは称号だと？",shape=box,color=red];
		j1841034262 -> j2313803381;
	j3623661764 [label="特に、貴様には我に対抗できない能力があるのだからな？",shape=box,color=blue];
		j3623661764 -> j1050111579;
	j3991632225 [label="特に、我らの力量の差はそちらに分があるからな。",shape=box,color=blue];
		j3991632225 -> j1050111579;
	j1045730363 [label="この称号は、我のささやかな称賛に過ぎない。確かに我らしい皮肉を交えた呼び名ではあるがな。",shape=box,color=blue];
		j1045730363 -> j719739219;
		j1045730363 -> j2538044217;
		j1045730363 -> j2635949675;
		j1045730363 -> j1019150607;
	j4221030778 [label="簒奪者よ、我は貴様と敵対する気はない。違う。これは侮辱ではない。我と貴様の過去には類似するものが多くあることを気づいてほしい。",shape=box,color=blue];
		j4221030778 -> j3892473664;
	j1050111579 [label="簒奪者よ、我は貴様と敵対する気はない。違う。それが一番適した称号だから、そう呼ぶのだ。貴様は我が望んでいた事を成し遂げた。",shape=box,color=blue];
		j1050111579 -> j1045730363;
	j719739219 [label="オロキンはみんなRoatheみたいな性格しているの？",shape=box,color=red];
