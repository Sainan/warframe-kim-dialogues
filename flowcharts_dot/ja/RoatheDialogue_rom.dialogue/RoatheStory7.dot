	j3979341425 [label="ボイスメール：委託",shape=box,color=blue];
		j3979341425 -> j1861100769;
	j1861100769 [label="聞かされた話では、セブンたちは我を…　Nitokhの慰み者であり妾とみなしていた。",shape=box,color=blue];
		j1861100769 -> j2247933832;
	j2247933832 [label="戦争初期、彼らはNitokhの挑発で我を副摂政大提督に任命したが、本気にはしていなかった。",shape=box,color=blue];
		j2247933832 -> j3789823061;
	j3789823061 [label="次々と勝利の知らせを持ち帰るたびに、彼らの笑い声は瞬く間に厳粛な拍手へと変わった。",shape=box,color=blue];
		j3789823061 -> j535449073;
	j535449073 [label="より優れた者たちの血が、まるで勲章のように我に染みついていた。そして我は秘密裏にNitokhのために武器を蓄えていた。",shape=box,color=blue];
		j535449073 -> j3946842735;
	j3946842735 [label="それは容易なことだった。疑われるにはあまりにも光輝であったから。",shape=box,color=blue];
		j3946842735 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
