	"Chat ends." [color=orange];
	j202709150 [label="ボイスメール：嘘",shape=box,color=blue];
		j202709150 -> j2249071820;
	j2249071820 [label="我は多くの武器を難なく使いこなしていたが、中でも特に優れていたのは「嘘」の使い方だった。",shape=box,color=blue];
		j2249071820 -> j2920051644;
	j2920051644 [label="それを最も頻繁に振りかざしたのは、自軍の兵士たちにだった。義務と規律という嘘を、彼らの骨の髄まで染み込ませた。",shape=box,color=blue];
		j2920051644 -> j1205323504;
	j1205323504 [label="勝利の嘘で彼らを埋め尽くした。彼らへの好意、彼らへの最大の敬意という嘘で彼らを突き刺した。",shape=box,color=blue];
		j1205323504 -> j2894737190;
	j2894737190 [label="しかしその武器は、人知れず、我自身にも向けていた。嗚呼、何と痛い。",shape=box,color=blue];
		j2894737190 -> j1648694156;
	j1648694156 [label="Add 1 to HellStory counter",color=orange];
		j1648694156 -> "Chat ends. Next chat will be RoatheStory16.";
	"Chat ends. Next chat will be RoatheStory16." [color=orange];
}