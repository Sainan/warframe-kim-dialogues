	2269 [label="我は多くの武器を難なく使いこなしていたが、中でも特に優れていたのは「嘘」の使い方だった。",shape=box,color=blue];
		2269 -> 5711;
	5711 [label="それを最も頻繁に振りかざしたのは、自軍の兵士たちにだった。義務と規律という嘘を、彼らの骨の髄まで染み込ませた。",shape=box,color=blue];
		5711 -> 5712;
	5712 [label="勝利の嘘で彼らを埋め尽くした。彼らへの好意、彼らへの最大の敬意という嘘で彼らを突き刺した。",shape=box,color=blue];
		5712 -> 2265;
	2265 [label="しかしその武器は、人知れず、我自身にも向けていた。嗚呼、何と痛い。",shape=box,color=blue];
