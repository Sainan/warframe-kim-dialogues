		j2304643196 -> j3804761313 [label="false",color=purple];
	j195941955 [label="我々は今、怠惰に指をくわえて待っている。簒奪者よ、他にやることが何もないのか、それか我から望むものを全て手に入れたか。どちらなのだ？",shape=box,color=blue];
		j195941955 -> j56300120;
		j195941955 -> j1331101175;
		j195941955 -> j1316005789;
	j617454213 [label="Evaluate expressions on HellStory counter",color=orange];
		j617454213 -> j3475690367 [label="x >= 21",color=purple];
		j617454213 -> "Chat ends." [label="x <= 21",color=purple];
		j617454213 -> "Chat ends." [label="false",color=purple];
	j3340546613 [label="新しい一日が始まり、そこには将来の計画を立てている我がいた…　実に久しいことだ。周りの世界をどう作り変えられるか、我の知識をどう駆使するか、自分自身とは何か、それをどう活かすかをじっくり考えていた。",shape=box,color=blue];
		j3340546613 -> j3984658869;
	j838065285 [label="新しい一日が始まり、そこには将来の計画を立てている我がいた…　実に久しいことだ。これが我にとって何を意味するのか、何を望んでいるのか、そして環境をどう変えていきたいのかをじっくり考えている。",shape=box,color=blue];
		j838065285 -> j2558396776;
	j2315818530 [label="貴様は何を待っているのだ？　我の記憶はまだ鮮明のようだが。この記憶を抹消すると約束したではないか。",shape=box,color=blue];
		j2315818530 -> j2167717184;
		j2315818530 -> j3377823119;
		j2315818530 -> j4159380740;
	j1947397423 [label="決心は付いたか？　我は辛抱強い悪魔だ、だが限度はある。我の記憶を消すのか、それとも我にこのまま苦しめと言うのか？",shape=box,color=blue];
		j1947397423 -> j1229170085;
		j1947397423 -> j906030513;
	j3804761313 [label="我々はここに居座り、ここに留まる。この煉獄に。貴様はここを相当気に入っているようだ。もうここから前進することはないのだから。",shape=box,color=blue];
		j3804761313 -> j2171950327;
	j56300120 [label="なんの話？",shape=box,color=red];
		j56300120 -> j514031051;
	j1331101175 [label="うーん、どっちもどっちも？",shape=box,color=red];
		j1331101175 -> j514031051;
	j1316005789 [label="Roatheに関することじゃない。",shape=box,color=red];
		j1316005789 -> j2423977017;
	j3475690367 [label="愚か者！　一体何をした？！　何故招かれていない洞窟に潜り込む？！",shape=box,color=blue];
		j3475690367 -> j260028772;
	"Chat ends." [color=orange];
	j3984658869 [label="Check boolean RoatheDating",color=orange];
		j3984658869 -> j3043613610 [label=true,color=green];
		j3984658869 -> j1941486557 [label=false,color=brown];
	j2558396776 [label="Check boolean RoatheDating",color=orange];
		j2558396776 -> j1106600817 [label=true,color=green];
		j2558396776 -> j290417139 [label=false,color=brown];
	j2167717184 [label="わかっている。でもちょっと時間がかかるんだ。もう少し待ってほしい。",shape=box,color=red];
		j2167717184 -> j3853173451;
	j3377823119 [label="やっぱりダメだ。ごめん。",shape=box,color=red];
		j3377823119 -> j247526116;
	j4159380740 [label="ちゃんとするよ。あとちょっとだ、心配しないで。",shape=box,color=red];
		j4159380740 -> j3853173451;
	j1229170085 [label="ダメだ。自分にはできない。ごめん。こんなことできない。",shape=box,color=red];
		j1229170085 -> j3305913400;
	j906030513 [label="わかったよ、Roatheの勝ちだ。望み通りにするよ。",shape=box,color=red];
		j906030513 -> j1272124470;
	j2171950327 [label="Check boolean LoidFamilyComplete",color=orange];
		j2171950327 -> j3871057981 [label=true,color=green];
		j2171950327 -> j2066011331 [label=false,color=brown];
	j514031051 [label="我から何か望むのであれば、それを得ることはない。修復を求めるなら、我の記憶を消し去ることだな。",shape=box,color=blue];
		j514031051 -> j1322785341;
	j2423977017 [label="言わずとも、お前はそれを十分に証明した。",shape=box,color=blue];
		j2423977017 -> "Chat ends.";
	j260028772 [label="早急に解決しろ。これは貴様の所為なのだ。我には感じる、獣が、内側からその爪を立て引き裂くのを。",shape=box,color=blue];
		j260028772 -> j1812013867;
	j3043613610 [label="これもお前のおかげだと認めざる得ないな、我が愛よ。感謝しよう。",shape=box,color=blue];
		j3043613610 -> j1749548228;
		j3043613610 -> j2594455195;
	j1941486557 [label="これもお前のおかげだと認めざる得ないな、簒奪者よ。感謝しよう。",shape=box,color=blue];
		j1941486557 -> j94268294;
		j1941486557 -> j2418340415;
	j1106600817 [label="これも主にお前のおかげだと認めざる得ないな、我が愛よ。",shape=box,color=blue];
		j1106600817 -> j288294183;
		j1106600817 -> j3534819147;
	j290417139 [label="これも主にお前のおかげだと認めざる得ないな、簒奪者よ。",shape=box,color=blue];
		j290417139 -> j3215605393;
		j290417139 -> j2898176882;
	j3853173451 [label="ウム。そうか。我は辛抱強い悪魔だが、井戸の水は時が立てば枯渇してしまうぞ。",shape=box,color=blue];
		j3853173451 -> "Chat ends.";
	j247526116 [label="そうか。それがお前の答えか？",shape=box,color=blue];
		j247526116 -> j431793363;
	j3305913400 [label="たとえそれが、この煉獄に永遠に閉じ込められることを意味するとしてもか？　嗚呼、哀れな簒奪者よ…　いいだろう。悪魔にとって、煉獄は地獄よりマシか？",shape=box,color=blue];
		j3305913400 -> j436020557;
	j1272124470 [label="よろしい。そうするといい。この知識を抱え生きることはもうウンザリだ。",shape=box,color=blue];
		j1272124470 -> j378811769;
	j3871057981 [label="だが確かに、貴様にはどうでもいい話なのだな？　我から得られるものは全て得た。この屍には骨髄さえ残らない。",shape=box,color=blue];
		j3871057981 -> j1776100240;
	j2066011331 [label="悲劇的だと思わないか？　エントラティ一家の残党どもは執事がここで悲しみに暮れ、手を握りしめていることを決して知ることはないのだからな。",shape=box,color=blue];
		j2066011331 -> j1776100240;
	j1322785341 [label="事を前進させたいのなら、リセットのみが残された道だ。どうでもいいと感じるなら、我も気にしない。好きにするといい。",shape=box,color=blue];
		j1322785341 -> j1210936049;
	j1812013867 [label="取り除け。この疫病を取り除くのだ。この記憶を我から消し去れ。できるのは知っている。お前の能力でこの苦しみを終わらせろ。今すぐにだ。",shape=box,color=blue];
		j1812013867 -> j872287889;
		j1812013867 -> j3566767927;
		j1812013867 -> j2358943095;
	j1749548228 [label="Roatheがいつまでも尻尾を追いかけ続けるのを見ていられなかった。",shape=box,color=red];
		j1749548228 -> j2504995292;
	j2594455195 [label="どういたしまして。",shape=box,color=red];
		j2594455195 -> j2665556245;
	j94268294 [label="Roatheがいつまでも尻尾を追いかけ続けるのを見ていられなかった。",shape=box,color=red];
