	j567952179 [label="Boolean RoatheWillReset is now true.",color=orange];
		j567952179 -> j2989953447;
	j2585968542 [label="ちなみに、他の交渉も破棄とする。",shape=box,color=blue];
		j2585968542 -> j3854755523;
		j2585968542 -> j2496517844;
	j434820031 [label="執事が恐怖に震えながらあの階段を登る姿を見るのを楽しみにしていたのだが、残念だ。",shape=box,color=blue];
		j434820031 -> j3412920440;
		j434820031 -> j3095018888;
	j2694282609 [label="だがそれは貴様にとって重要なことか？",shape=box,color=blue];
		j2694282609 -> j3180907142;
	j1907395989 [label="そうかもしれない。多分そうなのだろう。だが、他に試す方法はないのだろう？　ならやってみる価値はある。",shape=box,color=blue];
		j1907395989 -> j2709181628;
	j1857425063 [label="もしそうなら、またやり直すだけだ。力の限度はないのだろう？",shape=box,color=blue];
		j1857425063 -> j2709181628;
	j1464526625 [label="おそらくな。あらゆる要素を結びつけ、お前を責めるだろう。だが、お前なら乗り越えられると信じている。",shape=box,color=blue];
		j1464526625 -> j2709181628;
	j1744174116 [label="ウム。だがお前はこの「尻尾」を大分気に入っているようだがな。",shape=box,color=blue];
		j1744174116 -> j2665556245;
	j3382831040 [label="今回は感謝に述べに来ただけだ。長々と語るつもりはない。",shape=box,color=blue];
		j3382831040 -> j4081414586;
	j1965464662 [label="さて、では本題に入るとするか。",shape=box,color=blue];
