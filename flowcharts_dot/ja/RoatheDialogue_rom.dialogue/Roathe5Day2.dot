		"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j2989953447 [label="Boolean RoatheFailStall is now false.",color=orange];
		j2989953447 -> "Chat ends.";
	j3854755523 [label="いかにもオロキンだ。",shape=box,color=red];
		j3854755523 -> j1496062469;
	j2496517844 [label="え、なんで？！",shape=box,color=red];
		j2496517844 -> j3121796175;
	j3412920440 [label="記憶の回収が、Roatheの協力を得るための条件だったはずだ。それが交わした取り引きだ！",shape=box,color=red];
		j3412920440 -> j2570813409;
	j3095018888 [label="え、なんでもう助けてくれないの？",shape=box,color=red];
		j3095018888 -> j2570813409;
	j3180907142 [label="違うな。",shape=box,color=blue];
		j3180907142 -> "Chat ends.";
	j2709181628 [label="多分、我の記憶を改変したと知れば、我は激怒するだろう。ちなみに、それが我の要望だったと伝えるのは避けたほうがいい。",shape=box,color=blue];
		j2709181628 -> j2306890628;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j1466456391 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1466456391 -> j10136980 [label=true,color=green];
		j1466456391 -> j3612803563 [label=false,color=brown];
	j1674818825 [label="Boolean IsDating is now false.",color=orange];
		j1674818825 -> j3867192808;
	j434538128 [label="なら、我から何か望むのであれば、それを得ることはない。修復を求めるなら、我の記憶を消し去ることだな。",shape=box,color=blue];
		j434538128 -> j1322785341;
	j1496062469 [label="自身が出し抜かれたと気付いて、そんな渋い顔をするでない。我は交渉の条件を提示しただけで、我側の立場を明記していなかった。それとも気付かなかっただけか？",shape=box,color=blue];
		j1496062469 -> j349574230;
	j3121796175 [label="我は交渉の条件を提示しただけで、我側の立場を明記していなかった。それとも気付かなかっただけか？",shape=box,color=blue];
		j3121796175 -> j349574230;
	j2570813409 [label="「取り戻した記憶を記録し、折り合いを付けるものが必要だ。いわば臨時の助手みたいなものだ。」",shape=box,color=blue];
		j2570813409 -> j3765784528;
	j2306890628 [label="我はその言葉を嘘と断言し、修復不可能なほどにお前を軽蔑するだろう。",shape=box,color=blue];
		j2306890628 -> j252953329;
		j2306890628 -> j1519554753;
	j10136980 [label="話をする度に、我々が歩む岸辺がお前にとって馴染み深いものなのか、それとも未知なものなのか、考えずにはいられない。同じことを繰り返しているのか、まだ発見が隠されているのか。",shape=box,color=blue];
		j10136980 -> j2855593096;
	j3612803563 [label="お前は契約を履行した。よって、これからの攻撃方法をどう進めるか、計画の最終段階に差し掛かった。",shape=box,color=blue];
		j3612803563 -> j1440369233;
	j3867192808 [label="Boolean RoatheDating is now false.",color=orange];
		j3867192808 -> j1175767248;
	j349574230 [label="我はただ、貴様がその取り決めから何を得るのかを言っただけだ。それを得るために何をしなければならないのか、理由ついては何も言わなかった。貴様はそれに盲目的に同意したのだ。",shape=box,color=blue];
		j349574230 -> j3541343530;
	j3765784528 [label="「記憶の記録」は満たしたが、後者の「折り合いを付ける」という点は失敗に終わった。",shape=box,color=blue];
		j3765784528 -> j1332913257;
	j252953329 [label="やっぱりダメだ。自分はやらない。この状況に一緒に立ち向かわないといけない。話し合うことはできないの？",shape=box,color=red];
		j252953329 -> j3749633207;
	j1519554753 [label="…他に道はないのか？",shape=box,color=red];
		j1519554753 -> j3749633207;
	j2855593096 [label="いずれにせよ、我に教える必要はない。それによって我が読みやすくなるのは避けたい。重要なのは、お前が我の問題を解決してくれたことだ。",shape=box,color=blue];
		j2855593096 -> j2523172166;
	j1440369233 [label="この戦いは三つの戦線で行われる必要がある。この戦争に勝利するには、参加者全員が一致協力しなくてはならない。",shape=box,color=blue];
		j1440369233 -> j4121959500;
		j1440369233 -> j2870909960;
	j1175767248 [label="なら、我から何か望むのであれば、それを得ることはない。修復を求めるなら、我の記憶を消し去ることだな、「最愛の漂流者」よ。",shape=box,color=blue];
		j1175767248 -> j1322785341;
	j3541343530 [label="それはつまり我に「白地式小切手」、あるいは「自由行動権」を明け渡したことになる。",shape=box,color=blue];
		j3541343530 -> j3623418403;
		j3541343530 -> j3803905236;
	j1332913257 [label="これを折り合いが付いた、とは言えんな？",shape=box,color=blue];
		j1332913257 -> j809825113;
	j3749633207 [label="これしか道がないのだ。それに、あの執事を上階へ向かわせたいのだろう？　なら要望通り我の記憶を消すことだ。どうでもいいと感じるなら、好きにするといい。我には関係ない。",shape=box,color=blue];
		j3749633207 -> j3694567759;
	j2523172166 [label="昨夜は久しく快眠だった。「記憶にある限り」と言いたいところだが、あまり適切な冗談ではないな。",shape=box,color=blue];
