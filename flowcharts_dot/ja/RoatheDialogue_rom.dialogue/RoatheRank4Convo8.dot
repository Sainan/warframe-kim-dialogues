digraph {
	3120 [label="RoatheRank4Convo8 begins.",color=orange];
		3120 -> 3121;
		3120 -> 3122;
	3121 [label="Roatheはどんな幼少期を過ごしたの？",shape=box,color=red];
		3121 -> 3123;
	3122 [label="[閉じる]",shape=box,color=red];
		3122 -> 3124;
	3123 [label="ん？　興味深い質問だな。幼少期、か。正直あまり記憶にないな。それらの記憶を記録したスターや像も塵となったか、Endoとなったかのどちかであろう。",shape=box,color=blue];
		3123 -> 3125;
	3124 [label="Chat ends.",color=orange];
	3125 [label="あまりにも昔の話だ、ほんの一部しか思い出せん。それも夢の中で捏造したものなのか、歴史書の内容を自身に当てはめたものなのかも、今となっては分からない。",shape=box,color=blue];
		3125 -> 3126;
	3126 [label="したがって、我が思い出せることの信憑性は極めて低いことを認めよう。何故それを聞く？",shape=box,color=blue];
		3126 -> 3127;
		3126 -> 3128;
		3126 -> 3129;
	3127 [label="捏造された過去でも、それを事実だと自身に言い聞かせている。知る価値はある。",shape=box,color=red];
		3127 -> 3130;
	3128 [label="オロキン貴族としての生い立ちが気になる。",shape=box,color=red];
		3128 -> 3131;
	3129 [label="なにがRoatheを「こうさせた」のか知りたい。",shape=box,color=red];
		3129 -> 3132;
	3130 [label="+5 Chemistry",color=orange];
		3130 -> 3133;
	3131 [label="オロキンの若い偉人たち同様、我は幼くして狂信者たちの言う「全寮制の学校」へ送り込まれた。そこで我は気質や適性について試され、教訓を得た。",shape=box,color=blue];
		3131 -> 3134;
		3131 -> 3135;
	3132 [label="+5 Chemistry",color=orange];
		3132 -> 3136;
	3133 [label="そうだな、自身に言い聞かせる嘘は、時として真実より重要だ。中々鋭い見解だ、簒奪者よ。",shape=box,color=blue];
		3133 -> 3137;
	3134 [label="両親にあっさり送り出されたと？　どのくらい長く？",shape=box,color=red];
		3134 -> 3138;
	3135 [label="そこはどんな場所だった？",shape=box,color=red];
		3135 -> 3139;
	3136 [label="我がどこで「道を踏み外した」かを知りたいと？　なるほど！　面白い試みだ。だが我の幼少期の記憶から求める答えが出てくるとは限らんぞ。",shape=box,color=blue];
		3136 -> 3140;
	3137 [label="Add -1 to Thermostat",color=orange];
		3137 -> 3131;
	3138 [label="幼少期の全期間だ。以来、我を産み出した二人に会うことはなかった。いや、もしかしたら我が首席に選ばれた際の式典で出席していたかもしれんな？",shape=box,color=blue];
		3138 -> 3141;
	3139 [label="それは誰に聞くかによって意見が大きく別れる質問だ。入学当初、年上の男子生徒からイジメを受け、そこの残酷さを文字通り痛感した。",shape=box,color=blue];
		3139 -> 3142;
	3140 [label="Add 1 to Thermostat",color=orange];
		3140 -> 3131;
	3141 [label="我の親として名乗り出たのは、それが初めてだと記憶している。あまり気にかけていなかったが。",shape=box,color=blue];
		3141 -> 3143;
	3142 [label="だが幸い、我は何事においても学習が早い。アルキメデスの分野で卓越した成果を上げたいなら、後進に取り残されないように創造的な技術を駆使するのが最善だと学んだ。",shape=box,color=blue];
		3142 -> 3144;
		3142 -> 3145;
	3143 [label="両親の記憶はあまりない。オロキンの中には子育てに熱心なものもいたが、我の両親はそうでなかった。奴らが熱心だったのは、我を捨て置き自身の人生に復帰することをだった。",shape=box,color=blue];
		3143 -> 3146;
		3143 -> 3147;
	3144 [label="アルキメデスがそれを許したと？",shape=box,color=red];
		3144 -> 3148;
	3145 [label="なんて…　ひどい。",shape=box,color=red];
		3145 -> 3149;
	3146 [label="それによって悪い影響を受けそうだけど。",shape=box,color=red];
		3146 -> 3150;
	3147 [label="ごめんだけど、悲しい話に聞こえる。",shape=box,color=red];
		3147 -> 3150;
	3148 [label="新入生間の揉め事で最悪の事態が発生した場合、クバと召使いの少年を連れてきたのは校長自身だった。",shape=box,color=blue];
		3148 -> 3151;
	3149 [label="伝統とは強力な道具だ、簒奪者よ。多くの良識人を非常識に閉じ込めるための、強力かつ危険な道具だ。",shape=box,color=blue];
		3149 -> 3152;
	3150 [label="違うな。家族との繋がりが薄かったからこそ、多くの時間を学問に費やすことができた。それも周りからは時代遅れで古風とされた軍事戦略を専門にしてな。",shape=box,color=blue];
		3150 -> 3153;
	3151 [label="伝統とは強力な道具だ。多くの良識人を非常識に閉じ込めるための、強力かつ危険な道具だ。",shape=box,color=blue];
		3151 -> 3154;
		3151 -> 3155;
	3152 [label="新入生間の揉め事で最悪の事態が発生した場合、クバと召使いの少年を連れてきたのは校長自身だった。",shape=box,color=blue];
		3152 -> 3154;
		3152 -> 3155;
	3153 [label="それが将来どれほど有益となるか、奴らが知る由もなかった。",shape=box,color=blue];
		3153 -> 3156;
		3153 -> 3157;
	3154 [label="両親はどう思ったの？",shape=box,color=red];
		3154 -> 3143;
	3155 [label="そこで友達はいたの？",shape=box,color=red];
		3155 -> 3158;
	3156 [label="それに価値はあったと思う？",shape=box,color=red];
		3156 -> 3159;
	3157 [label="それでも、孤独な人生を送ってきたようだ。",shape=box,color=red];
		3157 -> 3160;
	3158 [label="いや、我は一人でいることが多かった。恐怖を他人に植え込むことは容易だが、かすかな光で溶けてしまう繊細な氷層であることを学んだ。",shape=box,color=blue];
		3158 -> 3161;
	3159 [label="後の大戦でこの知識がどれほど役立ったか、周りのものは知る由もなかった。だが全体的に見て、この経験の良し悪しは…",shape=box,color=blue];
		3159 -> 3162;
	3160 [label="そうだな。だがそれこそ悪魔の生き方ではないのか？　出世後も、我は狂人将軍の無力な右腕、単なる側室としか見られていなかったからな。",shape=box,color=blue];
		3160 -> 3163;
	3161 [label="よって怪物は闇の中に潜む必要がある。我に危険の香りを漂わせるには、孤独を突き通す必要があった。",shape=box,color=blue];
		3161 -> 3146;
		3161 -> 3147;
	3162 [label="フム、どちらだろうな。",shape=box,color=blue];
		3162 -> 3164;
		3162 -> 3165;
	3163 [label="上からも、下からも、我は歓迎されなかった。同僚と呼べるものもいなかった。",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="Roatheにはやり直すチャンスがある。彼らにはない。",shape=box,color=red];
		3164 -> 3167;
	3165 [label="彼らは死んでいて、Roatheは生きている。だからまぁ、結果オーライということで。",shape=box,color=red];
		3165 -> 3168;
	3166 [label="Update boolean RoatheUnloved2",color=orange];
		3166 -> 3169;
		3166 -> 3170;
	3167 [label="Add 1 to Thermostat",color=orange];
		3167 -> 3171;
	3168 [label="Add -1 to Thermostat",color=orange];
		3168 -> 3171;
	3169 [label="Roatheにはやり直すチャンスがある。彼らにはない。",shape=box,color=red];
		3169 -> 3172;
	3170 [label="まあでも、Roatheにはこの未来をどう生きるか選択権がある。彼らにはないものだ。",shape=box,color=red];
		3170 -> 3173;
	3171 [label="+5 Chemistry",color=orange];
		3171 -> 3174;
	3172 [label="Add 1 to Thermostat",color=orange];
		3172 -> 3171;
	3173 [label="Add -1 to Thermostat",color=orange];
		3173 -> 3171;
	3174 [label="見届けるとしよう。そうするしかないのであろう？",shape=box,color=blue];
		3174 -> 3175;
	3175 [label="Chat ends.",color=orange];
}