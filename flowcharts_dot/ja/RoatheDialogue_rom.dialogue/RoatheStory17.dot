	2284 [label="Chat ends.",color=orange];
	2286 [label="当初、WARFRAMEは正当な兵器というよりも、芸術的な表現であるように思われていた。",shape=box,color=blue];
		2286 -> 2285;
	2285 [label="センティエントを打ち負かすことができず、戦敗は目に見えていた。なら、奇妙で非現実的な戦士たちを創り、彼らに古代の武器を持たせよう。",shape=box,color=blue];
		2285 -> 2282;
	2282 [label="そうすれば我々の敗北は美しく、記憶に残るものとなるだろう。",shape=box,color=blue];
		2282 -> 2283;
	2283 [label="しかし、あらゆる予想に反して、彼らは勝利した。間もなくして、前線からとんでもなくあり得ない英雄譚が伝わってきた。",shape=box,color=blue];
		2283 -> 5715;
	5715 [label="WARFRAMEは天使のように空から降臨し、捕虜を解放し、センティエントの拠点を破壊した。単体でも奇跡であり、集団になれば神のような存在だった。",shape=box,color=blue];
		5715 -> 5716;
	5716 [label="彼らが単なるプロパガンダとみなされたのも無理はない。",shape=box,color=blue];
		5716 -> 2281;
