	j547284080 [label="ボイスメール：WARFRAME",shape=box,color=blue];
		j547284080 -> j3607173613;
	j3607173613 [label="当初、WARFRAMEは正当な兵器というよりも、芸術的な表現であるように思われていた。",shape=box,color=blue];
		j3607173613 -> j1071523625;
	j1071523625 [label="センティエントを打ち負かすことができず、戦敗は目に見えていた。なら、奇妙で非現実的な戦士たちを創り、彼らに古代の武器を持たせよう。",shape=box,color=blue];
		j1071523625 -> j2120246651;
	j2120246651 [label="そうすれば我々の敗北は美しく、記憶に残るものとなるだろう。",shape=box,color=blue];
		j2120246651 -> j2431448302;
	j2431448302 [label="しかし、あらゆる予想に反して、彼らは勝利した。間もなくして、前線からとんでもなくあり得ない英雄譚が伝わってきた。",shape=box,color=blue];
		j2431448302 -> j1097217042;
	j1097217042 [label="WARFRAMEは天使のように空から降臨し、捕虜を解放し、センティエントの拠点を破壊した。単体でも奇跡であり、集団になれば神のような存在だった。",shape=box,color=blue];
		j1097217042 -> j2990864961;
	j2990864961 [label="彼らが単なるプロパガンダとみなされたのも無理はない。",shape=box,color=blue];
		j2990864961 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}