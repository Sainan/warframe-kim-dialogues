	j3043388250 [label="ボイスメール：適応",shape=box,color=blue];
		j3043388250 -> j1692143070;
	j1692143070 [label="センティエントの多くは遭遇ごとに進化を遂げたため、同じ敵に二度遭遇するかどうかは不確定だった。しかし、中にはまるで頂点に達したかのように、一定の形態を保ったままのセンティエントもいた。",shape=box,color=blue];
		j1692143070 -> j3561505521;
	j3561505521 [label="完璧な殺戮者、まるでサメのような冷酷な恐怖をもたらした。狂気の沙汰だった。",shape=box,color=blue];
		j3561505521 -> j2346713803;
	j2346713803 [label="狂気の沙汰だった。カニ型のセンティエント船の対策が済んだと思ったら、ワーム型の船が前線で暴れていた。",shape=box,color=blue];
		j2346713803 -> j2296173788;
	j2296173788 [label="そしてそのワーム型を超える脅威がいつ来るかも分からなかった。",shape=box,color=blue];
		j2296173788 -> j844381538;
	j844381538 [label="我々は後戻りすることしかできなかった。進歩などあり得なかった。古き伝統、歴史を経て受け継がれてきた名誉と規律の道…　それが当然の報いを受ける時が迫っていた。",shape=box,color=blue];
		j844381538 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}