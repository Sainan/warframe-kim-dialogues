	2259 [label="センティエントの多くは遭遇ごとに進化を遂げたため、同じ敵に二度遭遇するかどうかは不確定だった。しかし、中にはまるで頂点に達したかのように、一定の形態を保ったままのセンティエントもいた。",shape=box,color=blue];
		2259 -> 5709;
	5709 [label="完璧な殺戮者、まるでサメのような冷酷な恐怖をもたらした。狂気の沙汰だった。",shape=box,color=blue];
		5709 -> 2256;
	2256 [label="狂気の沙汰だった。カニ型のセンティエント船の対策が済んだと思ったら、ワーム型の船が前線で暴れていた。",shape=box,color=blue];
		2256 -> 2253;
	2253 [label="そしてそのワーム型を超える脅威がいつ来るかも分からなかった。",shape=box,color=blue];
		2253 -> 5710;
	5710 [label="我々は後戻りすることしかできなかった。進歩などあり得なかった。古き伝統、歴史を経て受け継がれてきた名誉と規律の道…　それが当然の報いを受ける時が迫っていた。",shape=box,color=blue];
		5710 -> 2255;
