		j297746943 -> j3755400341;
	j949422865 [label="記憶を消したことは確かに許した。だが、よりによって、何故貴様を？　それが思い出せない。",shape=box,color=blue];
		j949422865 -> j315331461;
		j949422865 -> j3304848223;
	j1792980297 [label="よりによって、何故貴様を？！",shape=box,color=blue];
