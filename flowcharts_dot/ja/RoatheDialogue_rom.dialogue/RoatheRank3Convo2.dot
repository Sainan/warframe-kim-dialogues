	j3755400341 [label="+5 Chemistry",color=orange];
		j3755400341 -> j3290559715;
	j315331461 [label="うん。本当に申し訳ない。",shape=box,color=red];
		j315331461 -> j3260853569;
	j3304848223 [label="達成するべき目標のために頑張っている。",shape=box,color=red];
		j3304848223 -> j2276703163;
	j2107075801 [label="信頼を裏切って申し訳ないと感じている。わざとじゃないんだ。",shape=box,color=red];
		j2107075801 -> j3165785726;
	j973917811 [label="思い残すことがあるとすれば、計画を実行できなかったことだ。どれほどの時間を無駄にしたことか。",shape=box,color=blue];
		j973917811 -> j1389542879;
	j3412444980 [label="実に傑作であったぞ、簒奪者。",shape=box,color=blue];
		j3412444980 -> j1389542879;
	j3290559715 [label="実用的な質問だ。だが多くの「隠し場所」は…　時とともに流れ去ってしまった。",shape=box,color=blue];
		j3290559715 -> j368615435;
	j3260853569 [label="ふん。まあいい、過去の話を蒸し返すこのくだらない会話を続けよう。",shape=box,color=blue];
		j3260853569 -> j1900586464;
	j2276703163 [label="+5 Chemistry",color=orange];
		j2276703163 -> j472589864;
	j3165785726 [label="何も影響しないと過信した行動だったのだろう。まあいい、過去の話を蒸し返すこのくだらない会話を続けよう。",shape=box,color=blue];
		j3165785726 -> j1900586464;
	j1389542879 [label="+5 Chemistry",color=orange];
		j1389542879 -> j3586449440;
	j368615435 [label="それと、多くの隠し場所は我にも秘密だった。計画は複雑を極め、幾重にも重なるものだった。",shape=box,color=blue];
		j368615435 -> j839323318;
	j1900586464 [label="質問に戻ろう。「どうやって執行官たちを倒すつもりだったか」であったな？",shape=box,color=blue];
		j1900586464 -> j612881032;
	j472589864 [label="既に死んだ者たちを何故殺したかったを再び説明することでか？　なんと「実用的」な方法だ。",shape=box,color=blue];
		j472589864 -> j1900586464;
	j3586449440 [label="計画は複雑を極めた。幾重にも重なるものだった。最初の暗殺者が失敗した場合、他の暗殺者を暗殺する暗殺者たちなども用意していた。",shape=box,color=blue];
		j3586449440 -> j3272617777;
	j839323318 [label="最初の暗殺者が失敗した場合、他の暗殺者を暗殺する暗殺者たちなども用意していた。",shape=box,color=blue];
		j839323318 -> j3272617777;
	j612881032 [label="何故それを聞く？",shape=box,color=blue];
		j612881032 -> j1476174182;
		j612881032 -> j3468146768;
		j612881032 -> j297746943;
	j3272617777 [label="複数の建物に仕掛けられた爆弾。盗んだ爆薬が仕掛けられた戦艦や衛星。軌道から外せるソーラーレールなど。",shape=box,color=blue];
		j3272617777 -> j1181720246;
	j1181720246 [label="そして、それら全てが「センティエントによる災害」と見せかけるよう仕込まれていた。執行官と皇帝が始末され次第、Nitokhと我は帝国を非常事態と宣言するつもりだった。",shape=box,color=blue];
		j1181720246 -> j1742364006;
