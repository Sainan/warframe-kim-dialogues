		j2310817378 -> j1792980297 [label=false,color=brown];
	j1476174182 [label="正直、後悔しているか気になる。もし可能なら、計画を変えたかどうかを。",shape=box,color=red];
		j1476174182 -> j1552750898;
	j3468146768 [label="これほど壮大な計画をどうやって練ったのか気になる。きっと傑作だったに違いない。",shape=box,color=red];
		j3468146768 -> j2039027459;
