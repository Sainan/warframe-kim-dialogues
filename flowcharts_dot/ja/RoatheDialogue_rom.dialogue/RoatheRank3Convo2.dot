		j1417056213 -> j2781913152;
	j3312500379 [label="そう想像することでしか、彼女との…　義務的な夜を乗り越えられなかった。すまんな。",shape=box,color=blue];
		j3312500379 -> j480058296;
		j3312500379 -> j1962586595;
	j2079879397 [label="その二つが相反するものと信じているとは、実に可愛らしいな。いつかそのような「知り合い」と夜を過ごす機会があれば体験してみるといい。幻想的だぞ。",shape=box,color=blue];
