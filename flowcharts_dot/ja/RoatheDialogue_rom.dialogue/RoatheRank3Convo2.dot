		j1962586595 -> j118834063;
	j3581451465 [label="ただ、そのような関係を永続的なものにしないことだな。それは双方にとって非常に不健全な結果をもたらす。多くの場合、どちらか一方、あるいは両方が殺人に巻き込まれることになる。",shape=box,color=blue];
