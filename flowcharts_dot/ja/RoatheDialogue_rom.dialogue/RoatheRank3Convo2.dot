		j1680438498 -> j3629688209;
	j2162054373 [label="後悔してもしょうがない。これはRoatheが選んだ道だ。後戻りはできない。前に進むだけだ。",shape=box,color=red];
		j2162054373 -> j2355182071;
	j204047557 [label="自分たちにできるのは、これまでの過ちを埋め合わせること、そこからより鮮明に先を見ることだ。",shape=box,color=red];
		j204047557 -> j850226106;
	j656999613 [label="彼女は偉大なるNitokh、執行官だったからな。",shape=box,color=blue];
		j656999613 -> j2287838287;
	j4208112386 [label="そんなわけなかろう！　もし彼女がある日突然泥酔しエアロックから自身を宇宙へ放り投げていたら、どれだけ気楽であったか。",shape=box,color=blue];
		j4208112386 -> j3504921696;
	j327383727 [label="+5 Chemistry",color=orange];
		j327383727 -> j3282439586;
	j3629688209 [label="するわけなかろう！　オロキンは信じるな、漂流者よ。我含めて、いや、特に我を！　我らを愛するのも、嫌うのも、崇拝するのも、軽蔑するのも自由だ。だが絶対に信用してはならない。",shape=box,color=blue];
