		j1180546275 -> j4137689758;
	j4064602808 [label="違う。我は我だ。我は自分が選んだ道を歩む。自分を責める段階は過ぎている。他人の意見に合わせて自身を変えるつもりはない。",shape=box,color=blue];
		j4064602808 -> j1916563502;
	j2859926202 [label="これは執行官や皇帝の多くにあった特徴だ。自分自身に欠点も罪もないという盲目的な信念だけを抱いていた。我は彼らを軽蔑し、そのような自己中心的な傲慢さには決して加担しないと誓った。",shape=box,color=blue];
		j2859926202 -> j1916563502;
	j1793824987 [label="我は肉体以上の関係を持ったことがない。感情的な伴侶などいなかった。少なくても、お互いに心が通じ合った相手はいなかった。",shape=box,color=blue];
