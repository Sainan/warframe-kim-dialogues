		j1932713100 -> j3806156220 [label=false,color=brown];
	j951309206 [label="もし完全に失敗していたら、我はLexの銃口を覗いていただろう。",shape=box,color=blue];
		j951309206 -> j4157323809;
	j4248339651 [label="そして各道筋には、その後の行動を提示してあった。どのような結果になっても、我が取る行動は決まっていた。多くの場合、大まかな流れは似ていたが、細部は異なっていた。",shape=box,color=blue];
		j4248339651 -> j958901567;
	j4066486157 [label="以前の我はどこまで話した？　今の我は話の全貌を話すほど貴様を信用していない。",shape=box,color=blue];
		j4066486157 -> j3448184986;
		j4066486157 -> j3667945545;
	j3806156220 [label="それは我々の間で行われた、ある複雑な…　大きな交渉が関わっている。",shape=box,color=blue];
