		j4157323809 -> j4163097504;
	j958901567 [label="もし完全に失敗していたら、我はLexの銃口を覗いていただろう。",shape=box,color=blue];
		j958901567 -> j1785969367;
	j3448184986 [label="全部話してもらった。",shape=box,color=red];
		j3448184986 -> j1038221532;
