	j3629196003 [label="ふむ、なるほど。どうやら我の「悪魔的な魅力」で貴様を誘惑できないようだな。",shape=box,color=blue];
		j3629196003 -> j1312778754;
		j3629196003 -> j1180546275;
	j3308758963 [label="過去の行い、過去の失敗、そして後悔を再び味わうことに、一体何の意味があるというのか？　それらを変えることはできん。タイムトラベル能力を持っていたとしても、「してしまったこと」を「やり直そう」とするのは、狂気への道に他ならない。",shape=box,color=blue];
		j3308758963 -> j4064602808;
	j2781913152 [label="しかし、過去の悪行を忘れることもできない。狂人や独裁者、自分自身の欠点は垣間見ずに他人の欠点しか見ない怪物になってしまう危険があるからだ。",shape=box,color=blue];
