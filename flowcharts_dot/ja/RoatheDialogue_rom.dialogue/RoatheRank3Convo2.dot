		j2990861414 -> j3405648828;
	j4163097504 [label="あっさり死を受け入れると？",shape=box,color=red];
		j4163097504 -> j3903322501;
	j1785969367 [label="最もあり得た、中途半端な成功だったとしたら、全ての未決事項を「対処」するための整理が必要だっただろう。当然ながら、我もその未決事項の一つだった。だが、短期的に見てまだ我には価値があることを証明する手順は整っていた。",shape=box,color=blue];
		j1785969367 -> j2416914794;
