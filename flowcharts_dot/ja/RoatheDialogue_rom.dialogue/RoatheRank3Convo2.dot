	"Chat ends." [color=orange];
	j3867734707 [label="何故そんなことを聞く？　何を学ぼうとしているのだ？　隠し兵器の場所を尋ねているわけではないだろう。",shape=box,color=blue];
		j3867734707 -> j3900368877;
	j548339852 [label="何故それを聞く？　過去の自身の記録でも更新するつもりか？　全体主義国家を打倒するためのアドバイスでも求めるか？　惑星をも吹き飛ばすほどの爆薬の隠し場所を知りたいのか？",shape=box,color=blue];
		j548339852 -> j4140255123;
	j3900368877 [label="何故貴様を信用する必要がある？　…何故貴様を信用したのだ？！",shape=box,color=blue];
		j3900368877 -> j2310817378;
