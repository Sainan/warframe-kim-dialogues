	j528010930 [label="するわけなかろう。だが、オロキンとは常に互いに陰謀を企んでいるものだ。",shape=box,color=blue];
		j528010930 -> j1361292365;
	j1361292365 [label="Nitokhは、自身の目的達成に役立つ可能性があるなら、いつでも、躊躇なく、我を殺していただろう。",shape=box,color=blue];
		j1361292365 -> j3592986501;
	j3333470720 [label="一種の挑戦として彼女は楽しんでいただろう。危機という稀な感情。殺意のあるものと寝るスリルを味わっていたのだろう。",shape=box,color=blue];
		j3333470720 -> j773499322;
	j2945241074 [label="オロキン間ではそれほど珍しいことでもない。",shape=box,color=blue];
		j2945241074 -> j773499322;
	j31104764 [label="その通りだ！　まるで聞いたことがあるような素振りだな。だがそれほど意外な展開でもあるまい。彼女もその可能性を承知していた。よく煽ってもいた。",shape=box,color=blue];
		j31104764 -> j1608030648;
		j31104764 -> j3489375412;
	j1117857378 [label="その通りだ！　だがそれほど意外な展開でもあるまい。彼女もその可能性を承知していた。よく煽ってもいた。",shape=box,color=blue];
		j1117857378 -> j1608030648;
		j1117857378 -> j3489375412;
	j394517775 [label="もちろん、我々が対等とは思っていなかった。彼女は執行官、偉大なるNitokhだったからな。だが、我は彼女の下級者たちの中で第一であると認知していた。",shape=box,color=blue];
		j394517775 -> j2287838287;
	j2039736901 [label="可愛らしいな。だがそうだな、ある意味、ビジネスパートナーでもあったな。だがそれだけではなかった。",shape=box,color=blue];
		j2039736901 -> j3735418783;
	j3735418783 [label="戦争の。政治の。陰謀の。寝室のパートナーでもあった。",shape=box,color=blue];
		j3735418783 -> j909755544;
	j3592986501 [label="だが彼女も我が背後で刃を研いでいたことを、隙あらば首を取っていたことを知っていた。",shape=box,color=blue];
		j3592986501 -> j1840743624;
	j773499322 [label="長生きすればするほど、人間は不死のために作られた種ではないと実感する。",shape=box,color=blue];
		j773499322 -> j278015424;
	j2287838287 [label="我はなんて愚かだったのだろう...",shape=box,color=blue];
		j2287838287 -> j1825118331;
		j2287838287 -> j402454339;
		j2287838287 -> j1680438498;
		j2287838287 -> j2162054373;
		j2287838287 -> j204047557;
	j909755544 [label="だがそれも我の記憶違いかもしれぬ。我々の関係を「パートナー」という言葉で表すには強すぎるかもしれないな。",shape=box,color=blue];
		j909755544 -> j656999613;
