	j3504921696 [label="我は彼女を心の奥底から嫌悪していた。彼女の青い皮膚を自分の手でゆっくりと、慎重に、優しく剥ぎ取ることができればどんなに愉快だったことだろう。",shape=box,color=blue];
		j3504921696 -> j4124922859;
		j3504921696 -> j3406326937;
	j3282439586 [label="なんと見当違いな質問だ！　可愛らしいとも思える。だがしかし、確かに彼女に対する愛情は多少なりともあったのかもしれない。今この瞬間までそれを考えることすらなかった。",shape=box,color=blue];
		j3282439586 -> j3584958453;
