	1004 [label="残された名誉にかけて誓う、虚言ではないと！　それに嘘をつく理由などどこにある？　二人の関係の妥当性について、貴様がどう思おうが我には関係ない。",shape=box,color=blue];
		1004 -> 1005;
	1005 [label="貴様が、明らかに理解を超える複雑なものを、安易に単純化してしまうのは、実に残念だ。",shape=box,color=blue];
		1005 -> 1006;
	1006 [label="信じようと信じまいと、彼らは恋に落ちていた。Ballasはあらゆる階級の慣習や伝統を無視して、アルキメデスを…　唯一の恋人として迎え入れた。 ",shape=box,color=blue];
		1006 -> 1007;
	1007 [label="真実の愛があったからこそ、事態が変わった際、奴は狂気の渦へと堕ちていったのだ…",shape=box,color=blue];
		1007 -> 1008;
		1007 -> 1009;
	1008 [label="どうだろうか？　Margulisの死にはBallasが絡んでいる。",shape=box,color=red];
		1008 -> 1010;
	1009 [label="Margulisを処刑したのはBallasだ。",shape=box,color=red];
		1009 -> 1010;
	1010 [label="まず、貴様が知っていることはすべて正しく、奴の行動は完全に奴自身の意志によるものだったと仮定しよう。行動を強制するような政治的策略や脅迫、あるいは舞台裏で行われた陰謀もなかったと。",shape=box,color=blue];
		1010 -> 1011;
	1011 [label="仮定通り、Ballasが外部からの影響なく彼女の処刑を命じたとしても、時すでに遅しだった。奴が感じた裏切りは、奴の心を二つに裂いてしまったのだ。",shape=box,color=blue];
		1011 -> 1012;
	1012 [label="心も、精神も壊れてしまった。",shape=box,color=blue];
		1012 -> 1013;
		1012 -> 1014;
	1013 [label="彼に同情しろと言うなら、絶対に応じない。",shape=box,color=red];
		1013 -> 1015;
	1014 [label="テンノのせいで？　それともテンノが彼女にしたことで？",shape=box,color=red];
		1014 -> 1016;
	1015 [label="そんなものは求めていない！　奴には墓石へゴミを供えることさえ惜しい。墓があればの話だがな。",shape=box,color=blue];
		1015 -> 1017;
	1016 [label="両方とも言えれば、どちらでもないとも言える。Margulis処刑の日、Ballasは狂気に駆り立てられていた。正直、自身が実行したことを完全に理解していなかったとしても、驚きはしない。",shape=box,color=blue];
		1016 -> 1018;
	1017 [label="我が言いたいのは、Ballasが彼女の処刑を命じた日、奴は狂っていたのだ。事後になって、自身が実行したことを完全に理解していなかったとしても、驚きはしない。",shape=box,color=blue];
		1017 -> 1018;
	1018 [label="BallasはMargulisを愛していた。全身全霊で、全てを彼女に捧げていた。彼女のためなら、何でも、全てを犠牲にしただろう。魂も、身体も、帝国も。想像できること全てを。",shape=box,color=blue];
		1018 -> 1019;
	1019 [label="いかなる犠牲も、道徳も惜しまなかった。もし奴に生まれたばかりの赤ん坊を渡して、Margulisがその脳みそを岩にぶちまけたいと願っていると言ったら、言い終わる前に赤ん坊は死んでいただろう。",shape=box,color=blue];
		1019 -> 1020;
	1020 [label="奴はOrigin太陽系を灰と塵に化し、彼女が理想とする世界を創造しただろう…　だがここで悲劇が起きた。",shape=box,color=blue];
		1020 -> 1021;
	1021 [label="Margulisには…　そう、愛しい、心優しいMargulisには…　良心があった。",shape=box,color=blue];
		1021 -> 1022;
	1022 [label="彼女がテンノを、Voidによってトラウマを受けた子供たちを目の前にして…",shape=box,color=blue];
		1022 -> 1023;
	1023 [label="Ballasより大切なものができてしまった。彼女が人生を捧げていいと思える存在ができてしまった。そしてそれは…　Ballasではなかった。",shape=box,color=blue];
		1023 -> 1024;
	1024 [label="彼への愛ではなかった。",shape=box,color=blue];
		1024 -> 1025;
	1025 [label="Ballasもそれに気付いていたのだ、漂流者。Margulisが初めてテンノを目にした時からな。そして彼女の「狂犬」が彼女の光を奪ったことで、思いは定かなものになった。少なくとも、オロキン間ではそう噂されていた。",shape=box,color=blue];
		1025 -> 1026;
	1026 [label="我々オロキンの歓喜を想像できるか？　Ballasの大切な大切なアルキメデスが、Voidに歪められ狂った子供に目を焼かれるとはな？",shape=box,color=blue];
		1026 -> 1027;
	1027 [label="だが今思うと、それより前、Margulisがテンノのために戦ったその瞬間、Ballasの心が粉々に砕け散り、修復することはなかったのだろう。",shape=box,color=blue];
		1027 -> 1028;
	1028 [label="奴が取って代わる存在になってしまったから。",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="もしそうなら、我は奴を哀れに思う。だがその後の出来事はどうだ？　永遠が約束された愛…　それがこんな悲惨な結末を迎えるとは。",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="二人がお互いに微笑み合う様子を貴様にも見せたかった…",shape=box,color=blue];
		1030 -> 1031;
		1030 -> 1032;
	1031 [label="彼らの関係を美化しても、Ballasを許すことはできない。Ballasが犯したすべての罪を。",shape=box,color=red];
		1031 -> 1033;
	1032 [label="彼らの愛が本物だと聞けて嬉しい。彼は当時…　複雑だったんだと。Margulisが弄ばれていなかったと聞けて。",shape=box,color=red];
		1032 -> 1034;
	1033 [label="Add 1 to Thermostat",color=orange];
		1033 -> 1035;
	1034 [label="Add -1 to Thermostat",color=orange];
		1034 -> 1036;
	1035 [label="+10 Chemistry",color=orange];
		1035 -> 1037;
	1036 [label="+10 Chemistry",color=orange];
		1036 -> 1038;
	1037 [label="二人を同等に扱えと言っているのではない、簒奪者。ただ、愛を知る人間が、脅威になることもあると言っているのだ。まあでも…　我々堕落者には関係のない話か…",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="そうだな。あの堕落の王でさえ伴侶を見つけられるなら、我らにも希望があるかもしれんな？　ハッ！",shape=box,color=blue];
		1038 -> 1039;
	1039 [label="Update boolean RoatheMargulis1",color=orange];
		1039 -> 1040;
	1040 [label="今日はもう十分話した。さっさと行くがいい。",shape=box,color=blue];
		1040 -> 1041;
	1041 [label="Chat ends.",color=orange];
}