	"Chat ends." [color=orange];
	j53445817 [label="ボイスメール：罰",shape=box,color=blue];
		j53445817 -> j631152932;
	j631152932 [label="大戦前、この計画を最初に提唱したのは、気難しく、頭でっかちで、辛辣なScarneだった。「巣が燃えているのだから、我々は巣から飛び立たなければならない。」",shape=box,color=blue];
		j631152932 -> j1551280264;
	j1551280264 [label="過剰な搾取と無謀な実験によって、我々は太陽系を再生の望みを絶つほどに汚染してしまった。",shape=box,color=blue];
		j1551280264 -> j2462300804;
	j2462300804 [label="もはや、新たな地平への拡張こそが唯一の選択肢だった。",shape=box,color=blue];
		j2462300804 -> j508132601;
	j508132601 [label="彼もまた、Voidに卑劣な塔を建設した。",shape=box,color=blue];
		j508132601 -> j1719051858;
	j1719051858 [label="センティエントの再来を恐怖するあまり、Voidの海への退却しか考えていなかった。",shape=box,color=blue];
		j1719051858 -> j3812189699;
	j3812189699 [label="センティエントの勇敢さを、我々はなんと軽んじていたことか。",shape=box,color=blue];
		j3812189699 -> j128372344;
	j128372344 [label="彼らは、我々を罰する機会を得るためだけに、Voidの灼熱に耐えたのだから。",shape=box,color=blue];
		j128372344 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}