	2218 [label="大戦前、この計画を最初に提唱したのは、気難しく、頭でっかちで、辛辣なScarneだった。「巣が燃えているのだから、我々は巣から飛び立たなければならない。」",shape=box,color=blue];
		2218 -> 2221;
	2221 [label="過剰な搾取と無謀な実験によって、我々は太陽系を再生の望みを絶つほどに汚染してしまった。",shape=box,color=blue];
		2221 -> 2216;
	2216 [label="もはや、新たな地平への拡張こそが唯一の選択肢だった。",shape=box,color=blue];
		2216 -> 5733;
	5733 [label="彼もまた、Voidに卑劣な塔を建設した。",shape=box,color=blue];
		5733 -> 2222;
	2222 [label="センティエントの再来を恐怖するあまり、Voidの海への退却しか考えていなかった。",shape=box,color=blue];
		2222 -> 5700;
	5700 [label="センティエントの勇敢さを、我々はなんと軽んじていたことか。",shape=box,color=blue];
