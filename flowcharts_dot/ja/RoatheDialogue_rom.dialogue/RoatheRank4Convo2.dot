		j36104292 -> j2707577185 [label="RoatheAlone1",color=purple];
		j36104292 -> j2707577185 [label="RoatheBirdThree",color=purple];
		j36104292 -> j2327670170 [label="false",color=purple];
	j4032654649 [label="その名前は貴様らにとって大切なものだ。",shape=box,color=blue];
		j4032654649 -> j1187618924;
	j3829944225 [label="「楽しい」とは、言い過ぎだぞ、簒奪者。「馴染んできた」の方が正しい。",shape=box,color=blue];
		j3829944225 -> j1328807703;
	j310798182 [label="「楽しい」だと？　これがそれなのか？　我がマゾヒストだったとは、新たな発見だ。あるいは単純に「馴染んできた」の方が正しいのではないか？",shape=box,color=blue];
		j310798182 -> j388752148;
	j2707577185 [label="誰かと話せるのはそれなりに楽しい。確かに貴様らは時折耳障りではあるがな。",shape=box,color=blue];
		j2707577185 -> j1659005936;
	j2327670170 [label="孤独だと？　ふん。貴様らが遠ざけているのは我の戻りつつある正気だけだ。我が「馴染んできた」と思うなら、他に何がそうさせるかわかるか？",shape=box,color=blue];
		j2327670170 -> j1747105886;
	j1187618924 [label="だが宇宙はそう思わん。",shape=box,color=blue];
		j1187618924 -> j1446281080;
	j1328807703 [label="+5 Chemistry",color=orange];
		j1328807703 -> j689414758;
	j388752148 [label="感染体のようにな。",shape=box,color=blue];
		j388752148 -> j689414758;
	j1659005936 [label="+5 Chemistry",color=orange];
		j1659005936 -> j3568750619;
	j1747105886 [label="感染体だ。",shape=box,color=blue];
		j1747105886 -> j689414758;
	j1446281080 [label="我が同族を思う存分真紅に染めるといい。オロキンの黄金を溶かして怪物と呼ぶがいい。我々に向けられる毒舌は当然の報いだ。",shape=box,color=blue];
		j1446281080 -> j246924875;
	j689414758 [label="Boolean RoatheAlone2 is now true.",color=orange];
		j689414758 -> j1654361623;
	j3568750619 [label="馴染んでは…　きている。感染体のようにな。",shape=box,color=blue];
		j3568750619 -> j689414758;
	j246924875 [label="だが我々が罪だけの存在だと一瞬たりとも信じるな。",shape=box,color=blue];
		j246924875 -> j3497155693;
	j1654361623 [label="Check boolean LoidFamilyComplete",color=orange];
		j1654361623 -> j1933300832 [label=true,color=green];
		j1654361623 -> j4105215521 [label=false,color=brown];
	j3497155693 [label="オロキンを絶滅させたいなら、まず上へ登るといい。貴様の憎悪から逃れられない生存者が数名いる。そしてやるなら「Grandmother」から殺すことだな。",shape=box,color=blue];
		j3497155693 -> j6829661;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j4105215521 [label="我が狂気と血に飢えた、おぞましい暴動を起こさない理由は、もう一つある。",shape=box,color=blue];
		j4105215521 -> j2144271362;
	j6829661 [label="彼女はオロキンの全てを見てきたのだからな。",shape=box,color=blue];
		j6829661 -> j155006797;
	j2144271362 [label="あの執事と、上に住むAlbrechtの疎遠の家族間にあるドラマの結末を見れていない。",shape=box,color=blue];
		j2144271362 -> j534986768;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j534986768 [label="取り引きの有無関係なく、この件に我が関わっていることを忘れるな。このサンクタムにAlbrechtが戻ってきた時、奴が最初に目にするものは決まっている。",shape=box,color=blue];
		j534986768 -> j4082172245;
	j4082172245 [label="我だ。",shape=box,color=blue];
		j4082172245 -> j3080764826;
	j3080764826 [label="ただ、奴の愛するものたちの残骸を添えておくかまだ決めていない。",shape=box,color=blue];
