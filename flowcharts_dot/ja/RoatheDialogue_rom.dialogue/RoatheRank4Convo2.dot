	j483057771 [label="Roatheにはその力量がある。この状況に対する嫌悪感は十分示してきたわけだし。",shape=box,color=red];
		j483057771 -> j1540723422;
	j1629755686 [label="「Tauの悪魔」が大人しくしているのが不思議と感じる。いくら取り引きがあるとはいえ。",shape=box,color=red];
		j1629755686 -> j2206556128;
	j4021778174 [label="Roatheはオロキンだ。周りのみんなを憎んでいることは明らかだ。なぜ戸惑う？",shape=box,color=red];
		j4021778174 -> j2224051139;
	j3846056920 [label="「Tauの悪魔」が大人しくしているのが不思議と感じる。なにか取り引きしているわけでもないのに。",shape=box,color=red];
		j3846056920 -> j3657429577;
	j1540723422 [label="+5 Chemistry",color=orange];
		j1540723422 -> j2460138611;
	j2206556128 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2206556128 -> j1319249016 [label=true,color=green];
		j2206556128 -> j630878940 [label=false,color=brown];
	j2224051139 [label="怒りと悪意に満ちたこの会話を続ける前に、少し考えをまとめておこう。",shape=box,color=blue];
		j2224051139 -> j487371336;
	j3657429577 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3657429577 -> j1319249016 [label=true,color=green];
		j3657429577 -> j2279429525 [label=false,color=brown];
	j2460138611 [label="我がこの場所をいとも容易く殺戮現場に変えられると承知していることは喜ばしいことだ。",shape=box,color=blue];
		j2460138611 -> j3929038124;
	j1319249016 [label="それは何故我があれほど話しておきながら、貴様が信頼を裏切ったのか解明できていないからだ、簒奪者よ。",shape=box,color=blue];
		j1319249016 -> j1297965105;
	j630878940 [label="まだやるべきことがあるからだ、簒奪者よ。ここにいる全員を殺してしまったら、我の記憶を取り戻す貴様の協力を得られないであろう？",shape=box,color=blue];
		j630878940 -> j3373904926;
	j487371336 [label="貴様の意見が正しいことを証明しないようにな。",shape=box,color=blue];
		j487371336 -> j4209551409;
	j2279429525 [label="貴様が考えを改めるのを期待しているのかもしれない。もしここにいるもの全員殺してしまったら、その可能性は劇的に下がってしまうであろう？",shape=box,color=blue];
		j2279429525 -> j3373904926;
	j3929038124 [label="だが、そんなことをしても何も達成できないであろう？　戦争から学んだことが一つあるとすれば、殺人は何も達成しないということだ。",shape=box,color=blue];
		j3929038124 -> j374413961;
	j1297965105 [label="もしここにいるもの全員殺してしまったら、解明する可能性は劇的に下がってしまうであろう？　戦争から学んだことが一つあるとすれば、殺人は何も達成しないということだ。",shape=box,color=blue];
		j1297965105 -> j2920604234;
	j3373904926 [label="それに、そんなことをしても何も達成できないであろう？　戦争から学んだことが一つあるとすれば、殺人は何も達成しないということだ。",shape=box,color=blue];
		j3373904926 -> j2920604234;
	j4209551409 [label="貴様のオロキンへの憎しみには同情する。ほとんどのオロキンは他のオロキンを軽蔑していた。我々の罪を、我々の茶番を否定しない。",shape=box,color=blue];
		j4209551409 -> j1018439904;
	j374413961 [label="時折そのような欲求を抱くのは愉快ではあるが。",shape=box,color=blue];
		j374413961 -> j3954422664;
		j374413961 -> j355867453;
		j374413961 -> j1797367582;
	j2920604234 [label="時折そのような欲求を抱くのは愉快ではあるが。",shape=box,color=blue];
		j2920604234 -> j1797367582;
		j2920604234 -> j355867453;
		j2920604234 -> j3954422664;
	j1018439904 [label="ユヴァンの劇場だけでも、オロキン社会の極悪さを証明するのに十分だ。だが貴様はオロキンの民全員を否定しようとしている。貴様もその社会の産物なのだぞ！",shape=box,color=blue];
		j1018439904 -> j4053031753;
	j3954422664 [label="無意味だから、それだけが本当の理由？",shape=box,color=red];
		j3954422664 -> j1622322095;
	j355867453 [label="本当にそれ以外の理由はないの？",shape=box,color=red];
		j355867453 -> j2867383482;
	j1797367582 [label="MaireとLyonも殺さないと？",shape=box,color=red];
		j1797367582 -> j1715625151;
	j4053031753 [label="貴様はあの黄金の壁の中で苦労し、命を落とした全ての心優しい魂について何も知らない。時の流れに消えた、彼らの人生の物語を。",shape=box,color=blue];
		j4053031753 -> j139111812;
	j1622322095 [label="殺しても無駄であろう？　それともそれを願うか？　感心したぞ、簒奪者よ。貴様がこれほど狡猾な怪物だったとは！",shape=box,color=blue];
		j1622322095 -> j3052447659;
		j1622322095 -> j4258854476;
	j2867383482 [label="貴様に冗長な言い回しは似合わん。言いたいことがあるならはっきり言え、簒奪者よ。",shape=box,color=blue];
		j2867383482 -> j3052447659;
		j2867383482 -> j4258854476;
	j1715625151 [label="狂信者どもがいるはずの場所で血溜まりが見つかったら、我はただでは済まされない、そうであろう？",shape=box,color=blue];
		j1715625151 -> j3197595047;
	j139111812 [label="永遠に公演されることない悲劇のために、涙の川が流された。それを貴様が知るはずもない。",shape=box,color=blue];
		j139111812 -> j3465867620;
	j3052447659 [label="みんなといるのが楽しいって認めてもいいんだよ。実用性だけが人の価値じゃないんだ。",shape=box,color=red];
		j3052447659 -> j796436421;
	j4258854476 [label="自分たちをどう思おうと、一緒にいることで孤独を和らげる、そう認めてもいいんだよ。",shape=box,color=red];
		j4258854476 -> j134072315;
	j3197595047 [label="貴様から、執事から、あの子供から…　そしてその「母親」からも責められるだろう。アレは、気がかりだ。その話はまた改めてしよう。",shape=box,color=blue];
		j3197595047 -> j4258854476;
		j3197595047 -> j3052447659;
	j3465867620 [label="あの子供が「Adis」という名を叫ぶのを耳にする。",shape=box,color=blue];
		j3465867620 -> j682127047;
	j796436421 [label="Add 1 to Thermostat counter",color=orange];
		j796436421 -> j3607629830;
	j134072315 [label="Add -1 to Thermostat counter",color=orange];
		j134072315 -> j36104292;
	j682127047 [label="そのAdisも無数の内の一人に過ぎん。",shape=box,color=blue];
		j682127047 -> j4032654649;
	j3607629830 [label="Evaluate expressions",color=orange];
		j3607629830 -> j3829944225 [label="RoatheUnloved2",color=purple];
