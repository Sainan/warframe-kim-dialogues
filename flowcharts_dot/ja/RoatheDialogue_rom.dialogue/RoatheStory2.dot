	j4048320341 [label="ボイスメール：接続",shape=box,color=blue];
		j4048320341 -> j30952353;
	j30952353 [label="センティエントがTauへのソーラーレールを完成させた時、盛大な式典は行われなかった。ただ、動き始めただけ。",shape=box,color=blue];
		j30952353 -> j1208268689;
	j1208268689 [label="もちろん、後から急ごしらえの式典は開催された。華々しい儀式がないなど、オロキンはそれを許さない。",shape=box,color=blue];
		j1208268689 -> j752408722;
	j752408722 [label="誰が最初にTauに足を踏み入れるか、大騒ぎになった。",shape=box,color=blue];
		j752408722 -> j3595136273;
	j3595136273 [label="選ばれたのは執行官Tormisだった。これは、Zariman Ten Zeroの失態に対する執行官Tuvulへの集団的な叱責とも読み取れた。",shape=box,color=blue];
		j3595136273 -> j2545715895;
	j2545715895 [label="Tormisは行き、戻ってきた。新しい星系と定住すべき新しい世界、誇張された思い出を携えて。",shape=box,color=blue];
		j2545715895 -> j2354045363;
	j2354045363 [label="数日のうちに、入植船の小隊が出発し、未開の海岸に足を踏み入れようと熱望していた。",shape=box,color=blue];
		j2354045363 -> j413224368;
	j413224368 [label="センティエントの反逆で気分が背くまでは。",shape=box,color=blue];
		j413224368 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}