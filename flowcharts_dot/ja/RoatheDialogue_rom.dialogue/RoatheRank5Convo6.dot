	j121337408 [label="そうしたとも主張していない。伝えたのは我だ。",shape=box,color=blue];
		j121337408 -> j4131114853;
	j1574954199 [label="これも償いの一環なのだ。いずれにせよ、奴らは真実を知っただろう。ならいっそのこと我の口から伝えた方がマシだ。",shape=box,color=blue];
