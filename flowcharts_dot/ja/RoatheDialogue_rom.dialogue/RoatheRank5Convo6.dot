		j598317519 -> j3087382643 [label="false",color=purple];
	j3916124758 [label="彼も、社会や環境の産物であることがどういうことかを理解しているんだと思う。もしかしたら、Roatheが思っている以上に、Roatheの過去に共感しているのかも。",shape=box,color=red];
		j3916124758 -> j288934599;
	j359868765 [label="二人がどんな形であれ友情を見つけられたことを嬉しく思うよ。たとえそれが停戦だとしても。",shape=box,color=red];
		j359868765 -> j580728726;
