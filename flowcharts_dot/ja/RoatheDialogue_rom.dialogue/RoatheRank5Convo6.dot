		j3042999494 -> j3418401824;
		j3042999494 -> j3775198442;
	j1055690359 [label="奴らは我の悔悟を嘲笑し、「やっとか」「言っただろ」と野次を飛ばしてくると予想していた。しかし、そんなことはなかった。むしろ、ほとんど何も言わなかった。",shape=box,color=blue];
		j1055690359 -> j109582654;
	j1410741841 [label="予想外の展開だった。告白から数日後のある晩、沈黙の中我が一人で本を呼んでいると、奴は我の方に近寄ってきた。",shape=box,color=blue];
		j1410741841 -> j2989999440;
	j3418401824 [label="それで何か変わったことはある？",shape=box,color=red];
