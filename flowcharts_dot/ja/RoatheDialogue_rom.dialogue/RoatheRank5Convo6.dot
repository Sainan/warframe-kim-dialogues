		j1172864870 -> j337120515 [label="false",color=purple];
	j2813753334 [label="Evaluate expressions",color=orange];
		j2813753334 -> j1355884498 [label="RoatheVillain",color=purple];
		j2813753334 -> j1026322583 [label="RoatheRedeemed",color=purple];
		j2813753334 -> j623655596 [label="false",color=purple];
	j1543749362 [label="我がMarieをどう思うかだと？　そうだな、彼女に一晩か二晩我々とベッドを共にしないか聞いてみたいものだ（冗談、冗談だ）。",shape=box,color=blue];
		j1543749362 -> j3848991952;
	j1864944282 [label="我がMarieをどう思うかだと？　そうだな、一晩か二晩お前たちとベッドを共にできないか聞いてみたいものだ（冗談、冗談だ）。",shape=box,color=blue];
		j1864944282 -> j1396771010;
	j1024817979 [label="Albrechtの本質について、よく彼女を説得できたと感心している。まさに「奇跡」だな。ソルやルアなんかより、奴らはお前を崇拝したほうが良さそうだ。",shape=box,color=blue];
		j1024817979 -> j541588575;
	j3728374523 [label="彼女が今も毎日痛みを感じているとは知らなかった。そのような仕草さえ見せなかった。彼女がお前に話すまで、我にそのことを話さなかった。どうやらお前は我々の間の溝を埋めてくれたようだ。",shape=box,color=blue];
		j3728374523 -> j401255877;
	j3205846102 [label="最近まで彼女の生い立ちを知らなかった。彼女がお前に話すまで、我に一度も自身の話をしたことがなかった。どうやらお前は我々の間の溝を埋めてくれたようだ。",shape=box,color=blue];
		j3205846102 -> j3259378745;
	j2087089145 [label="相も変わらずだ。彼女の声をかき消したいという思いから、爪で我の顔を剥がさないよう最善を尽くしている。",shape=box,color=blue];
		j2087089145 -> "Chat ends.";
	j4177158574 [label="不満をぶつける相手ができたことで、少しはマシになった。だが真面目な話、我々の間の緊張はだいぶ緩和された。",shape=box,color=blue];
		j4177158574 -> j163712939;
	j3195299658 [label="「仲良く」しているのは我ではなくお前の方であろう？　ハッ！　下品な冗談を許せ。あまりにも隙だらけだったのでな、つい。",shape=box,color=blue];
		j3195299658 -> j1768022132;
	j3453174259 [label="お前よりかは上手くやっているようだ。どうやったら奴との関係を失敗するのだ？　奴が必要としたのは、話を聞いてくれる相手だったのだ。",shape=box,color=blue];
		j3453174259 -> j1818708416;
	j1649176 [label="我々の間の緊張はだいぶ緩和された。それもお前が奴との親交を深め、奴に自身の悩みについて話す自信を持たせた成果にある。",shape=box,color=blue];
		j1649176 -> j1447134295;
	j3636657706 [label="我々の間の緊張はだいぶ緩和された。それもお前が奴との親交を深め、奴に自身の悩みについて話す自信を持たせた成果にある。",shape=box,color=blue];
		j3636657706 -> j3892919589;
	j337120515 [label="相も変わらずだ。彼の声をかき消したいという思いから、爪で我の顔を剥がさないよう最善を尽くしている。",shape=box,color=blue];
		j337120515 -> "Chat ends.";
	j1355884498 [label="少しずつ、少しずつだが、耐えられるようになってきたと認めよう。多分だが、奴らには愛想つかれてきたのだろう。",shape=box,color=blue];
		j1355884498 -> j1930067147;
	j1026322583 [label="少しずつ、少しずつだが、耐えられるようになってきたと認めよう。最近の啓示が、それに何か関係しているのかもしれんな。",shape=box,color=blue];
		j1026322583 -> j2365767798;
	j623655596 [label="そうだな、PROTOFRAMEとなった我がダーク・リフラクトリーを利用できないとはいえ、一つ疑問に思うことがある…",shape=box,color=blue];
		j623655596 -> j301726070;
	j3848991952 [label="我の挑発が、正直な苛立ちからからかいに変わったことを、彼女は気付いているだろうか？",shape=box,color=blue];
		j3848991952 -> j378456118;
	j1396771010 [label="だが気持ちはわかる。彼女の美貌の話だけではない。あの女はその年では稀な純粋さと思いやりを持っている。",shape=box,color=blue];
		j1396771010 -> j3848991952;
	j541588575 [label="いかんな。このような言葉遣いこそオロキン帝国の台頭を招いたのだ。そのような過ちは二度と犯してはならない。",shape=box,color=blue];
		j541588575 -> j3848991952;
	j401255877 [label="彼女が言うように、我はそのような日々を送ることを理解できない愚か者の一人だと認めよう。",shape=box,color=blue];
		j401255877 -> j3202930814;
	j3259378745 [label="まさか家族によって路上に放り出されるとは…　あのMarieがだぞ？　あれほど思いやりの心を持つMarieがだぞ？！",shape=box,color=blue];
		j3259378745 -> j4286716451;
	j163712939 [label="奴らは…　我の秘密を知る。我が、血清を自ら摂取した事実を。",shape=box,color=blue];
		j163712939 -> j1825989286;
		j163712939 -> j2668238256;
	j1768022132 [label="あの哀れな狂人に立ち向かった勇気を称賛するぞ。奴には心から信頼できる仲間が必要だ。そしてなにより、思いやりが。",shape=box,color=blue];
		j1768022132 -> j1632970879;
	j1818708416 [label="なのにお前は奴を拒絶した。恥を知れ。",shape=box,color=blue];
		j1818708416 -> "Chat ends.";
	j1447134295 [label="奴が、聞こえていた声について話してくれた。とあるテンノの声のことを。そしてその声が聞こえなくなったことを。",shape=box,color=blue];
		j1447134295 -> j1180048185;
	j3892919589 [label="奴の過去について、我は驚くほど無知だった。奴がお前に話すまで、我にそのことを話す気はなかったようだ。",shape=box,color=blue];
		j3892919589 -> j3423280335;
	j1930067147 [label="冗談だ。奴らの我に対する批判を拒絶しようと改めて決意したにもかかわらず、妙に奴らに愛着が湧いてきた。",shape=box,color=blue];
		j1930067147 -> j1072392959;
		j1930067147 -> j3165723679;
	j2365767798 [label="奴らは我の悔悟を嘲笑し、「やっとか」「言っただろ」と野次を飛ばしてくると予想していた。しかし、そんなことはなかった。むしろ、ほとんど何も言わなかった。",shape=box,color=blue];
		j2365767798 -> j1703528386;
	j301726070 [label="…あれを使い溺死できないかと。",shape=box,color=blue];
		j301726070 -> "Chat ends.";
	j378456118 [label="そう願うしかないな。彼女を困らせるのは実に楽しい。彼女が激怒し、母国語で我に怒鳴りつけるのを見るのが、最近の我の趣味だ。",shape=box,color=blue];
		j378456118 -> j2233502819;
	j3202930814 [label="どうしたらあのような平静を保てるのだろうか？　優しさを？　我なら、あの司祭と同じく狂っていただろう。",shape=box,color=blue];
		j3202930814 -> j3848991952;
	j4286716451 [label="Helminthを使って過去へ戻り、彼女の家族を皆殺しにしたいくらいだ。だが彼女はそれを望まないだろう。",shape=box,color=blue];
		j4286716451 -> j2585939938;
	j1825989286 [label="言ってないからね。",shape=box,color=red];
		j1825989286 -> j3860641347;
	j2668238256 [label="どうやって知られたの？",shape=box,color=red];
		j2668238256 -> j3847274109;
	j1632970879 [label="それもあってか、我々の間の緊張はだいぶ緩和された。",shape=box,color=blue];
		j1632970879 -> j163712939;
	j1180048185 [label="それでも、奴は今後も他の声に悩まされるだろう。あの哀れな男は、今後も現実と空想の境界線が曖昧なまま生きていくのだろう。",shape=box,color=blue];
		j1180048185 -> j2171148820;
	j3423280335 [label="Helminthを使って過去へ戻り、奴の両親を殺したいくらいだ。だが奴はそれを望まないだろう。",shape=box,color=blue];
		j3423280335 -> j3078123060;
	j1072392959 [label="Roatheたちはこれからも一緒なんだ。Albrechtがそうさせた。ならせめて楽しまないと。",shape=box,color=red];
		j1072392959 -> j3883754615;
	j3165723679 [label="よかった。彼らはRoatheのことを気に掛けていると思う。",shape=box,color=red];
		j3165723679 -> j4036716711;
	j1703528386 [label="そうしなかったことを、良かったと感じている。傷に塩を塗るような扱いは受けたくない。思いにふけることは十分ある。",shape=box,color=blue];
		j1703528386 -> j1072392959;
		j1703528386 -> j3165723679;
	j2233502819 [label="そして我々の関係が改善した理由はもう一つある。奴らは我の秘密を知る。我が、血清を自ら摂取した事実を。",shape=box,color=blue];
		j2233502819 -> j4017530944;
		j2233502819 -> j1188668177;
	j2585939938 [label="「復讐心に満ちた殺人はソルに許されない行為である」とかなんとか。",shape=box,color=blue];
		j2585939938 -> j3848991952;
	j3860641347 [label="そうしたとも主張していない。伝えたのは我だ。",shape=box,color=blue];
		j3860641347 -> j1806500125;
	j3847274109 [label="伝えたのは我だ。",shape=box,color=blue];
		j3847274109 -> j1806500125;
	j2171148820 [label="そして我々の関係が改善した理由はもう一つある。",shape=box,color=blue];
		j2171148820 -> j163712939;
	j3078123060 [label="「復讐心に満ちた殺人はルアに許されない行為である」とかなんとか。",shape=box,color=blue];
		j3078123060 -> j3672034847;
	j3883754615 [label="その通りだ。同居人を敵に回す必要などない。ガウルで菓子を盗んでいたのもそれが理由だ。",shape=box,color=blue];
		j3883754615 -> j4284744161;
	j4036716711 [label="我のこの態度に反してな。驚きだ。それでも、我々は今こうしてここにいる。",shape=box,color=blue];
		j4036716711 -> j1528989439;
	j4017530944 [label="どうやって知られたの？",shape=box,color=red];
