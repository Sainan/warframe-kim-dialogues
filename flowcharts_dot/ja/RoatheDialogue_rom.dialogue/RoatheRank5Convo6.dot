	j3775198442 [label="Marieはどんな反応したの？",shape=box,color=red];
		j3775198442 -> j3539057803;
	j109582654 [label="特にLyon。奴は過去の決断に向き合うことの難しさを理解しているのだろう。",shape=box,color=blue];
		j109582654 -> j32725969;
	j2989999440 [label="奴は我の隣に座り、Albrechtの血清を摂取して以来自身の信仰に疑問を抱いてきたことを話してくれた。そのことを恥じていて、血清を摂取したことを後悔していたと。",shape=box,color=blue];
		j2989999440 -> j3687421493;
	j3431190335 [label="奴らは我の悔悟を嘲笑し、「やっとか」「言っただろ」と野次を飛ばしてくると予想していた。しかし、そんなことはなかった。むしろ、ほとんど何も言わなかった。",shape=box,color=blue];
		j3431190335 -> j3778727974;
	j3539057803 [label="予想外の展開だった。彼女は何も言わず、ただ…　我を抱きしめた。",shape=box,color=blue];
		j3539057803 -> j598317519;
	j32725969 [label="Check boolean LyonConfession2",color=orange];
		j32725969 -> j3916124758 [label=true,color=green];
		j32725969 -> j359868765 [label=true,color=green];
		j32725969 -> j359868765 [label=false,color=brown];
	j3687421493 [label="そして、できるなら忘れてしまいたいと、そう願っていたと告白した。もしかしたら、我々三人には共通するものがあるのかもしれないな。",shape=box,color=blue];
		j3687421493 -> j1031404147;
		j3687421493 -> j3865683684;
	j3778727974 [label="特にMarie。過去の事を繰り返し掘り返すのは望まれないと、彼女は理解しているのだろう。",shape=box,color=blue];
		j3778727974 -> j3137425038;
