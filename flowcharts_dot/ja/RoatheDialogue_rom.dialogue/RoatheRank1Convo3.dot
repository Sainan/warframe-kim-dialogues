		j1932325373 -> j2510215016;
	j3507088839 [label="何故そのようなことを？",shape=box,color=blue];
		j3507088839 -> j2398834490;
	j744642043 [label="次に、お前はどれだけ無能なのだ？！　あの司祭に一日一回食事と水を与えるだけでも、いずれ奴の愛と崇拝を得られるだろうに。",shape=box,color=blue];
		j744642043 -> j2798273321;
	j1198090626 [label="次に、彼女の前にで足を引きずったり、病気のフリをしたり、瞬きしたり、容姿を褒めたりしてみたか？　彼女を口説くのは難解ではないはずだが。",shape=box,color=blue];
		j1198090626 -> j2885673734;
	j2323192122 [label="疑念が確信へと変わって、2つのことが頭に浮かんだ：",shape=box,color=blue];
		j2323192122 -> j2989170665;
	j3474126181 [label="だがそれはまた別の機会で話すとしよう。今は、我から提案がある。きっと貴様にとって有益となる。",shape=box,color=blue];
		j3474126181 -> j3951614692;
	j4128350284 [label="我の体は引き裂かれ、そして再構成された。問答無用にだ。選択権などなかった。他もこれを体験したのだろうか。",shape=box,color=blue];
		j4128350284 -> j2039013494;
	j1239930943 [label="我は自身の血液を使いHelminthのリバースエンジニアリングを何度も試みた。骨の折れる作業だった。オロキンの道具…　いや、適した道具もないに等しい状態だったからな。病院から盗めたものでさえ…",shape=box,color=blue];
		j1239930943 -> j3718246407;
	j226733704 [label="我が思うようにその力を扱えるなら、何人の心を操っただろうか？",shape=box,color=blue];
