		j3573354293 -> j2340380402;
	j3994313194 [label="+5 Chemistry",color=orange];
		j3994313194 -> j3895062953;
	j2097975307 [label="次に、我の心がここ最近一度ならず二度も侵害されたことを知り、我は激しい怒りと憤りに襲われている。だがその怒りさえも上書きするもう一つの感情がある。それは、完全に理解できていない感情だが…",shape=box,color=blue];
		j2097975307 -> j1315895173;
	j2898117994 [label="詳細はわらかん。強制された変貌の所為で、多くの記憶が失われたからな。",shape=box,color=blue];
		j2898117994 -> j3014123753;
	j1636493210 [label="そう！　まさにそうだ！　自身の血液をサンプルにしてまでだ！　しかも数ヶ月や数年の話ではない！　クソ、Albrechtに会ったらあの馬鹿げて得意げな顔をこの爪で引き裂いて…",shape=box,color=blue];
		j1636493210 -> j2587305331;
	j3910849587 [label="単純に辛抱することが賢明だと思うが…　強引に押し寄せても反発されるだけだ。",shape=box,color=blue];
		j3910849587 -> j482378059;
	j343290671 [label="+5 Chemistry",color=orange];
		j343290671 -> j1105078175;
	j2374798091 [label="次に、我の心がここ最近一度ならず二度も侵害されたことを知り、我は激しい怒りと憤りに襲われている。だがその怒りさえも上書きするもう一つの感情がある。それは、完全に理解できていない感情だが…",shape=box,color=blue];
		j2374798091 -> j3120559508;
	j1127396190 [label="まず、感心したぞ！　奴の愛情を勝ち取るために、我々の記憶を奪い取るとは？！",shape=box,color=blue];
		j1127396190 -> j555310568;
	j2340380402 [label="まず、感心したぞ！　奴の愛情を勝ち取るために、我々の記憶を奪い取るとは？！",shape=box,color=blue];
		j2340380402 -> j1870075877;
	j3895062953 [label="これはこれは！　我の愛情を勝ち取るために、我々の記憶を奪い取るとは？！",shape=box,color=blue];
		j3895062953 -> j817827519;
	j1315895173 [label="裏切りだ。",shape=box,color=blue];
		j1315895173 -> j2711998948;
	j3014123753 [label="だが断片的な記憶はある。黄金の廊下…　聞き慣れた声…　見覚えのない顔…　Albrechtで間違いないが、知る顔ではなかった。",shape=box,color=blue];
		j3014123753 -> j3171815350;
	j2587305331 [label="少し落ち着く。",shape=box,color=blue];
		j2587305331 -> j3949232884;
	j482378059 [label="疑念が確信へと変わって、2つのことが頭に浮かんだ：",shape=box,color=blue];
		j482378059 -> j3343628882;
	j1105078175 [label="フム。なるほど。崇高な試みだな。我自身も幾度と試した手口だ。だが同じく失敗した。",shape=box,color=blue];
		j1105078175 -> j1932325373;
	j3120559508 [label="裏切りだ。",shape=box,color=blue];
		j3120559508 -> j3507088839;
	j555310568 [label="まさにオロキンだ。",shape=box,color=blue];
		j555310568 -> j744642043;
	j1870075877 [label="まさにオロキンだ。",shape=box,color=blue];
		j1870075877 -> j1198090626;
	j817827519 [label="まさにオロキンだ。",shape=box,color=blue];
		j817827519 -> j2323192122;
	j2711998948 [label="何故そのようなことを？",shape=box,color=blue];
		j2711998948 -> j3474126181;
	j3171815350 [label="焼けつくような痛み…　それも経験したことないほどのだ。それまで我は以前の身体で多くの痛みを経験してきた。大戦では爆発で手足を失い、クバがなければ即死していたほどの全焼などもあったが、痛みは知り尽くしていたと過信していた。",shape=box,color=blue];
		j3171815350 -> j4128350284;
	j3949232884 [label="よろしい。続けよう。",shape=box,color=blue];
		j3949232884 -> j1239930943;
	j3343628882 [label="我は思う…　そんな力があったなら、勝ち戦を何度繰り返しただろうか？",shape=box,color=blue];
		j3343628882 -> j226733704;
