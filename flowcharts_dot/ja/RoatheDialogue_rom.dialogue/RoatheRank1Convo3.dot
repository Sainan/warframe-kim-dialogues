	"RoatheRank1Convo3 begins." [color=orange];
		"RoatheRank1Convo3 begins." -> j2478038820;
		"RoatheRank1Convo3 begins." -> j738393015;
	j2478038820 [label="聞いていいかな？　どうやってここにたどり着いたの？　そもそも…　どこから？",shape=box,color=red];
		j2478038820 -> j1782054338;
	j738393015 [label="[閉じる]",shape=box,color=red];
		j738393015 -> "Chat ends.";
	j1782054338 [label="Evaluate expressions on HellStory counter",color=orange];
		j1782054338 -> j1596977963 [label="x >= 21",color=purple];
		j1782054338 -> j4266093746 [label="x < 21",color=purple];
		j1782054338 -> j4266093746 [label="false",color=purple];
	"Chat ends." [color=orange];
	j1596977963 [label="我が簒奪者よ、貴様は既にこの答えを熟知しているのではないのか？　既に我の心を読み解いているのなら、そんな些細なことを問いだして何の意味がある？",shape=box,color=blue];
		j1596977963 -> j4011668186;
	j4266093746 [label="もちろん聞いていいとも！　これは我の秀才を披露する機会であると同時に、知性に欠けて無神経な、極度の臆病者であるAlbrechtの文句を言う好機でもあるからな！",shape=box,color=blue];
		j4266093746 -> j4070589250;
	j4011668186 [label="Check boolean RoatheKnowsReset",color=orange];
		j4011668186 -> j136008640 [label=true,color=green];
		j4011668186 -> j2098046840 [label=false,color=brown];
	j4070589250 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4070589250 -> j595382788 [label="x >= 1",color=purple];
		j4070589250 -> j2382455010 [label="x <= 0",color=purple];
		j4070589250 -> j2382455010 [label="false",color=purple];
	j136008640 [label="貴様はAlbrechtと同等に卑劣だ。他人の記憶を、玩具のように弄びよって！　教えろ。既に答えを知りながら、なぜそのような質問をする？",shape=box,color=blue];
		j136008640 -> j739536131;
		j136008640 -> j550015244;
	j2098046840 [label="教えろ。貴様は既にその答えを知っているのだろう？　我があの狂信者二人を連れて奴らの時代からやってきたことも、それ以上のことも知っているのではないか？",shape=box,color=blue];
		j2098046840 -> j2357887721;
		j2098046840 -> j1594491443;
	j595382788 [label="選んでAlbrechtに飛ばされたわけじゃないみたいだね。",shape=box,color=red];
		j595382788 -> j847177533;
	j2382455010 [label="なるほど。選んで過去に飛んではいないと。",shape=box,color=red];
		j2382455010 -> j847177533;
	j739536131 [label="頑張って皆の助けになろうといたんだけど…　しくじってしまった。だからやり直している。文字通り「天辺」から。",shape=box,color=red];
		j739536131 -> j3448789358;
	j550015244 [label="どう説明すれば…　記憶を消す能力なんて望んでいなかった、でも何とかしようと努力しているんだ。",shape=box,color=red];
		j550015244 -> j540484864;
	j2357887721 [label="いや、しらない。",shape=box,color=red];
		j2357887721 -> j3804935498;
	j1594491443 [label="それは…　うん、知ってた。",shape=box,color=red];
		j1594491443 -> j3709024562;
	j847177533 [label="まったくもって違う。まずオロキンについて1つ教えてやろう。我々は、よく互いに遊戯という体で駆け引きをしてきた。政治、心理戦、性的、様々だ。",shape=box,color=blue];
		j847177533 -> j4185264399;
	j3448789358 [label="+5 Chemistry",color=orange];
		j3448789358 -> j1476644796;
	j540484864 [label="ではその努力が足りていないようだな、永遠の知人よ。その能力を持ちながら何を成し遂げていないと言うのだ？",shape=box,color=blue];
		j540484864 -> j4269406562;
	j3804935498 [label="ハッ！　記憶を盗むだけでなく、不正直とは笑えるな、簒奪者。",shape=box,color=blue];
		j3804935498 -> "Chat ends.";
	j3709024562 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j3709024562 -> j3704220106;
	j4185264399 [label="クバとユヴァンの劇場を用いて、我々はある意味、不老不死だった。それがどれほど退屈か貴様には理解できるか？",shape=box,color=blue];
		j4185264399 -> j567302297;
		j4185264399 -> j763948293;
	j1476644796 [label="Boolean RoatheResetScrewedUp is now true.",color=orange];
		j1476644796 -> j1471581516;
	j4269406562 [label="Check boolean LoidFamilyComplete",color=orange];
		j4269406562 -> j4073738287 [label=true,color=green];
		j4269406562 -> j1117493842 [label=true,color=green];
		j4269406562 -> j2762535944 [label=false,color=brown];
		j4269406562 -> j4073738287 [label=false,color=brown];
		j4269406562 -> j1117493842 [label=false,color=brown];
	j3704220106 [label="なら何故繰り返し質問する？",shape=box,color=blue];
		j3704220106 -> j739536131;
		j3704220106 -> j550015244;
	j567302297 [label="一応、経験はある。",shape=box,color=red];
		j567302297 -> j3472151512;
	j763948293 [label="痛いほどわかるけど、まあいいや、続けて。",shape=box,color=red];
		j763948293 -> j279028027;
	j1471581516 [label="ほう、興味深い…　「しくじった」とは、我とか？　それともLyonかMarieとか？",shape=box,color=blue];
		j1471581516 -> j2168566327;
		j1471581516 -> j4281742602;
		j1471581516 -> j3413083709;
	j4073738287 [label="その、Roatheが血清を受け取ったことの事情を知って…　それを知りながら不快にさせることを言ってしまった。",shape=box,color=red];
		j4073738287 -> j1801736877;
	j1117493842 [label="実は…　3人の1人のことが気になっていて…　しくじった…",shape=box,color=red];
		j1117493842 -> j2493144367;
	j2762535944 [label="みんなに協力してもらってLoidと上にある家族を和解させようとして…　失敗した…",shape=box,color=red];
		j2762535944 -> j1452896904;
	j3472151512 [label="知る限り、貴様のは永遠と死に続ける経験だろう。その方がより面白そうだ。それでも貴様は最終的に何も感じなくなってしまったようだがな。",shape=box,color=blue];
		j3472151512 -> j279028027;
	j279028027 [label="我が言いたいのは、オロキンが互いに楽しむために仕掛ける策略や陰謀は、我にとって日常茶飯事だったということだ。そうして無限と感じた時間を潰すしていたのだ。",shape=box,color=blue];
		j279028027 -> j1717895905;
	j2168566327 [label="Lyon...",shape=box,color=red];
		j2168566327 -> j201238090;
	j4281742602 [label="Marie...",shape=box,color=red];
		j4281742602 -> j3367278776;
	j3413083709 [label="Roatheと…",shape=box,color=red];
		j3413083709 -> j1937316796;
	j1801736877 [label="+5 Chemistry",color=orange];
		j1801736877 -> j112983170;
	j2493144367 [label="+5 Chemistry",color=orange];
		j2493144367 -> j3790313185;
	j1452896904 [label="フム。なるほど。我々は何かしらの交渉をしていて、貴様が期待に応えなかったせいで、目的を達成できなくなったと。",shape=box,color=blue];
		j1452896904 -> j2747584908;
	j1717895905 [label="それでもオロキンには超えてはいけない線があった。暗黙の了解が。詳細は省くが、Albrechtはその了解を全て踏みつぶしたのだ。",shape=box,color=blue];
		j1717895905 -> j1791715386;
	j201238090 [label="誠か？　毎日水を変えて餌付けすれば解決する問題ではないのか？　まあよい…",shape=box,color=blue];
		j201238090 -> j1000050042;
	j3367278776 [label="あの純潔な小動物を説得できなかったと？　その…　なんだ…　将来交渉人のような職に就かないことを悲願するぞ、永遠の知人よ。",shape=box,color=blue];
		j3367278776 -> j3592315154;
	j1937316796 [label="+5 Chemistry",color=orange];
		j1937316796 -> j2706416962;
	j112983170 [label="フム。",shape=box,color=blue];
		j112983170 -> j3277231107;
	j3790313185 [label="ハッ！　なんと愉快な！　興味が湧いた。それで…　誰なのだ？　言ってみるがいい…　恥じる必要はない。もしかしたら…　取り引きができるかもしれんぞ。",shape=box,color=blue];
		j3790313185 -> j819439384;
