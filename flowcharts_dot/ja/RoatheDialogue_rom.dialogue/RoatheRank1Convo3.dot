		j3790313185 -> j3080162720;
	j2747584908 [label="疑念が確信へと変わって、2つのことが頭に浮かんだ：",shape=box,color=blue];
		j2747584908 -> j123640543;
	j1791715386 [label="奴は我を遠い過去…　Origin太陽系の片隅に置き去っていった！　あの「大聖堂」には電気さえ通っていなかったのだぞ！　信じられるか？！",shape=box,color=blue];
		j1791715386 -> j612026350;
	j1000050042 [label="何に困っていたのだ？　手助けがいるなら取り引きも可能だが？",shape=box,color=blue];
		j1000050042 -> j1302134513;
	j3592315154 [label="それで、何に困っていたのだ？　手助けがいるなら…　取り引きも可能だが？",shape=box,color=blue];
		j3592315154 -> j256724246;
	j2706416962 [label="ハッ！　なんと愉快な！　興味が湧いた。それで…　何をしくじったのだ？　言ってみるがいい…　恥じる必要はない。もしかしたら…　取り引きができるかもしれんぞ。",shape=box,color=blue];
