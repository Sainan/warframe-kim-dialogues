	j1990388149 [label="Check boolean RoatheUnloved1",color=orange];
		j1990388149 -> j3220725119 [label=true,color=green];
		j1990388149 -> j1162728654 [label=true,color=green];
		j1990388149 -> j2702616777 [label=true,color=green];
		j1990388149 -> j3220725119 [label=false,color=brown];
		j1990388149 -> j1162728654 [label=false,color=brown];
		j1990388149 -> j513422374 [label=false,color=brown];
	j1775443291 [label="自分がやっていることが小さいと思うなら、勝手にそうするといい。それはRoatheの意見だ。自分のしてきたことは歴史を書き換えた。",shape=box,color=red];
		j1775443291 -> j689926361;
	j328516549 [label="小さい存在じゃなくて、見えない存在になりたいんだ。表舞台で注目を浴びる必要はない。影に隠れる。",shape=box,color=red];
		j328516549 -> j3228325571;
	j3220725119 [label="困っている人々を助けることが、最終的にこの混乱から抜け出す方法だからだ。",shape=box,color=red];
		j3220725119 -> j3115888641;
	j1162728654 [label="やるべきことをやっているだけだ。それ以上でもそれ以下でもない。",shape=box,color=red];
		j1162728654 -> j1554112440;
	j2702616777 [label="以前、本当の愛を知らないと言った。それが周りの世界を変えるほどの力を持つことを、Roatheは知らないんだと思う。",shape=box,color=red];
		j2702616777 -> j1023773574;
	j513422374 [label="恋をしたことはあるか、Roathe？　それか誰かのために世界を消してもいいと強く想ったことは？",shape=box,color=red];
		j513422374 -> j3909820821;
	j689926361 [label="我が言いたいことはそれだ！　なら共に歴史を書き換えようではないか！　こんな場所で皆が手を繋いで歌うよう説得する必要はない！",shape=box,color=blue];
		j689926361 -> j276345895;
		j689926361 -> j4196333299;
		j689926361 -> j2654633393;
	j3228325571 [label="ほう、影の暗殺者になりたいと？　好機を見て行動したいと？　違うな。貴様はただの歯車だ。",shape=box,color=blue];
		j3228325571 -> j3301065279;
	j3115888641 [label="ほう。赤の他人を救い、まるで英雄のように崇拝されたいと？　それか全員を説得して手を繋いで歌わせると？　失礼、Fibonacciの水槽に吐いてくる。",shape=box,color=blue];
		j3115888641 -> j499357990;
		j3115888641 -> j840088185;
	j1554112440 [label="その「やっていること」とは、壮大な暴力の合間に、皆に手を繋いで歌うことを説得することか？　暴力はわかる。それ以外は吐き気がする。",shape=box,color=blue];
		j1554112440 -> j499357990;
		j1554112440 -> j840088185;
	j1023773574 [label="「無関心のモノ」とやらを倒すのに、皆に手を繋いで歌わせる必要があるというなら…　失礼、想像しただけでFibonacciの水槽に吐きそうだ。",shape=box,color=blue];
		j1023773574 -> j2460010909;
		j1023773574 -> j499357990;
		j1023773574 -> j840088185;
	j3909820821 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j3909820821 -> j2447922228;
	j276345895 [label="今は我慢だ。まずは無関心のモノからだ。",shape=box,color=red];
		j276345895 -> j3585002182;
	j4196333299 [label="うーん、事態が収まってから、かな？　でも今は無理だ。",shape=box,color=red];
		j4196333299 -> j1563428367;
	j2654633393 [label="それをRoatheとやるって？　笑わせないで。",shape=box,color=red];
		j2654633393 -> j4075735467;
	j3301065279 [label="貴様は自分が何をしているのか、何故そうするかを理解していない。ただ言われた通りに回るだけだ。自惚れ屋のオロキンの自惚れ屋の手下がまた一人。残念だ。",shape=box,color=blue];
		j3301065279 -> "Chat ends.";
	j499357990 [label="人が不幸でなくなるという考えを、なんでそこまで拒む？　随分個人的に捉えているようだけど。",shape=box,color=red];
		j499357990 -> j3465036152;
	j840088185 [label="自分が言いたいのは、「無関心のモノ」が感情の欠損から生まれるなら、感情を芽生えることで倒せるかもしれないってことだ。",shape=box,color=red];
		j840088185 -> j3090201558;
	j2460010909 [label="Roatheが愛されることはないと信じている？　それとも他人を愛せないの？　それともその機会がなかっただけ？",shape=box,color=red];
		j2460010909 -> j142210682;
	j2447922228 [label="ない。「無関心のモノ」とやらを倒すのに、皆に手を繋いで歌わせる必要があるというなら…　失礼、想像しただけでFibonacciの水槽に吐きそうだ。",shape=box,color=blue];
		j2447922228 -> j2460010909;
		j2447922228 -> j499357990;
		j2447922228 -> j840088185;
	j3585002182 [label="+5 Chemistry",color=orange];
		j3585002182 -> j1563428367;
	j1563428367 [label="わかった、わかった！　時を待つとしよう。この…　馬鹿げたゲームに付き合ってやろう。",shape=box,color=blue];
		j1563428367 -> j446867856;
	j4075735467 [label="Boolean RoatheInsulted is now true.",color=orange];
		j4075735467 -> j1740918017;
	j3465036152 [label="苦難は友を呼ぶから、かもしれないな。あるいは、我々には本当に成すべきことがあるというのに、貴様が時間を無駄にしていることに困惑しているのかもしれない。",shape=box,color=blue];
		j3465036152 -> j4188498105;
	j3090201558 [label="これが貴様の空想の産物だという証拠がまた一つ増えた！　一体どんな神や邪神が「人間の優しさ」に打ち負かされるというのだ！　笑わせる！",shape=box,color=blue];
		j3090201558 -> j3690014376;
