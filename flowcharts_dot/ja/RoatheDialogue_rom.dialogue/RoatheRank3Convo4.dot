		j345976092 -> j440314501;
	j1130807301 [label="聞いたこともないような能力を持つ貴様が、何故他人に固執する？　時をループでき、次元を創造できる貴様が…　他人の関係を修復しようとしている。",shape=box,color=blue];
		j1130807301 -> j440314501;
	j939831122 [label="ただただ驚愕している。理解に苦しむ。何故だ？　本来ならどこかの次元を統治できるはずなのに、何故そうしない？",shape=box,color=blue];
		j939831122 -> j1206584518;
		j939831122 -> j441155928;
		j939831122 -> j2356816850;
	j440314501 [label="ただただ驚愕している。理解に苦しむ。何故だ？　本来ならどこかの次元を統治できるはずなのに、何故そうしない？",shape=box,color=blue];
		j440314501 -> j1822740025;
		j440314501 -> j152952573;
		j440314501 -> j2816860841;
	j1206584518 [label="自分がやっていることに満足している。自分が望む方法で人々を助けている。",shape=box,color=red];
		j1206584518 -> j737537414;
	j441155928 [label="理解できるかわからないけど…　次元の支配者になんてなりたくない。",shape=box,color=red];
		j441155928 -> j30636441;
	j2356816850 [label="そうしたらAlbrechtやオロキンと何も変わらないからだ。自分の理想で世界を書き換えて暴れまわるなんて、そんなことはしたくない。",shape=box,color=red];
		j2356816850 -> j30636441;
	j1822740025 [label="自分がやっていることに満足している。自分が望む方法で人々を助けている。",shape=box,color=red];
		j1822740025 -> j737537414;
	j152952573 [label="理解できるかわからないけど…　次元の支配者になんてなりたくない。",shape=box,color=red];
		j152952573 -> j2191888183;
	j2816860841 [label="そうしたらAlbrechtやオロキンと何も変わらないからだ。自分の理想で世界を書き換えて暴れまわるなんて、そんなことはしたくない。",shape=box,color=red];
