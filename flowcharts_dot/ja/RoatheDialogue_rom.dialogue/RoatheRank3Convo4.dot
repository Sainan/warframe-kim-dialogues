		j2768280751 -> j2768514865 [label=false,color=brown];
	j784781222 [label="貴様はAlbrechtがしてきたことの後始末に熱心のようだ。執事の件もある。",shape=box,color=blue];
		j784781222 -> j2476974658;
	j2768514865 [label="貴様はAlbrechtがしてきたことの後始末に熱心のようだ。",shape=box,color=blue];
		j2768514865 -> j2476974658;
	j2476974658 [label="Check boolean IsDating",color=orange];
		j2476974658 -> j1521469894 [label=true,color=green];
		j2476974658 -> j4126645634 [label=false,color=brown];
	j1521469894 [label="もちろん自身の目的も達成しようとしている。それは称賛し、批判はしない。だが貴様のように驚くほど不器用なものが、これに関して従順だということに我は理解が追いついていない。",shape=box,color=blue];
		j1521469894 -> j1322653955;
		j1521469894 -> j1351386764;
		j1521469894 -> j3634150883;
	j4126645634 [label="貴様のように驚くほど不器用なものが、これに関して従順だということに我は理解が追いついていない。",shape=box,color=blue];
		j4126645634 -> j1322653955;
		j4126645634 -> j1351386764;
		j4126645634 -> j3634150883;
	j1322653955 [label="無関心のモノがOrigin太陽系を、周りのものを滅ぼすのを、自分は見逃せない。",shape=box,color=red];
		j1322653955 -> j3044887687;
	j1351386764 [label="Albrechtに従順であるつもりはない。",shape=box,color=red];
		j1351386764 -> j1105305974;
	j3634150883 [label="自分なりの理由がある。それを教えるつもりはない。",shape=box,color=red];
		j3634150883 -> j2073408241;
	j3044887687 [label="なるほど。「無関心のモノ」を打倒するまでの一時的な奉仕だと。それで、その後はどうするつもりだ？",shape=box,color=blue];
		j3044887687 -> j109032268;
		j3044887687 -> j3789599597;
		j3044887687 -> j3844528871;
		j3044887687 -> j1960508049;
		j3044887687 -> j2378281222;
	j1105305974 [label="本当か？　我からはそう見える。奴が指を鳴らせば、貴様は忠実なクブロウのように足元へ参じる。奴が「Tau」と囁やけばとうに失われたものを必死に掴もうとする。",shape=box,color=blue];
		j1105305974 -> j2169258089;
		j1105305974 -> j2599058703;
	j2073408241 [label="なんて謎めいて、なんて不可解な！　そしてなんてクソまみれな答えだ。奴の忠犬だと認めたくないなら、好きにするといい。",shape=box,color=blue];
		j2073408241 -> j3607682779;
	j109032268 [label="なぜこれを擦る？　何が聞きたいんだ？",shape=box,color=red];
		j109032268 -> j1627850017;
	j3789599597 [label="正直そこまで考えていない。",shape=box,color=red];
		j3789599597 -> j1541339188;
	j3844528871 [label="Albrechtに代償を払わせるつもりだ。彼には償うものがたくさんある。",shape=box,color=red];
		j3844528871 -> j119588894;
	j1960508049 [label="自分が生き残れると想定しての話？",shape=box,color=red];
		j1960508049 -> j1197084688;
	j2378281222 [label="いつものように、必要とされる場所に行くだけ。よく巻き込まれるから。",shape=box,color=red];
		j2378281222 -> j3938977523;
	j2169258089 [label="どうして怒らせようとする？",shape=box,color=red];
		j2169258089 -> j3794686530;
	j2599058703 [label="自分はただ、人々が置かれている悲惨な状況から抜け出すのを助けるために、自分がやらなければならないことをしているだけだ。",shape=box,color=red];
		j2599058703 -> j1335752229;
	j3607682779 [label="我から見れば、奴が指を鳴らせば、貴様は忠実なクブロウのように足元へ参じる。奴が「Tau」と囁やけばとうに失われたものを必死に掴もうとする。",shape=box,color=blue];
		j3607682779 -> j2169258089;
		j3607682779 -> j2599058703;
	j1627850017 [label="+5 Chemistry",color=orange];
		j1627850017 -> j3730721034;
	j1541339188 [label="ほう！　自身が愚かだと認めるか！　清々しい。愚者が己の無知さを露わにするのは都合がいい。操るのに楽だ。",shape=box,color=blue];
		j1541339188 -> j3595193344;
	j119588894 [label="なるほど！　単純に復讐を求めていると！　素晴らしい。凶暴な獣のように、噛まれたら反撃すると。",shape=box,color=blue];
		j119588894 -> j914552314;
	j1197084688 [label="+5 Chemistry",color=orange];
		j1197084688 -> j41268368;
	j3938977523 [label="なるほど。気高さを装った無関心か。自分の居場所も、留まるべき場所も分からず、「正義のため」という仮面を被り、他人の言いなりになっているのか？",shape=box,color=blue];
		j3938977523 -> j3569346324;
	j3794686530 [label="我が知る限り別の現実から来た存在である貴様が、なぜ「セラピスト」の真似事をしているのか理解できないからだ。",shape=box,color=blue];
		j3794686530 -> j3566464486;
	j1335752229 [label="まさしくそれだ！　宇宙と時空を巡ることができる貴様が何故「セラピスト」の真似事などする？　我が知る限り別の現実から来た存在である貴様がだ。",shape=box,color=blue];
		j1335752229 -> j3566464486;
	j3730721034 [label="鋭いな。いいだろう、もっと直接的に、核心に迫ろう。貴様を怒らせて、より正直な返答を引き出そうとした。",shape=box,color=blue];
		j3730721034 -> j730548739;
	j3595193344 [label="貴様はやっとの思いでケイスを捕まえたクブロウのようだ。脚に牙を沈めても、何をすればいいかわかっていない。",shape=box,color=blue];
		j3595193344 -> j2599058703;
		j3595193344 -> j2169258089;
	j914552314 [label="人間の本能の中でも最も古いものだ。それゆえ最も理解しやすい。",shape=box,color=blue];
		j914552314 -> j2599058703;
	j41268368 [label="正当な兵士でなくても、貴様からは熟練の兵士の器が垣間見える。",shape=box,color=blue];
		j41268368 -> j136866374;
	j3569346324 [label="なんと哀れな。",shape=box,color=blue];
		j3569346324 -> j2853803393;
		j3569346324 -> j3143052856;
	j3566464486 [label="我ならデュヴィリに戻って、Voidにある別次元への抜け穴を探し求めるだろう！　可能性を考えてみろ！　手に入れられる世界を！",shape=box,color=blue];
		j3566464486 -> j2940129775;
		j3566464486 -> j1128474863;
	j730548739 [label="だがいいだろう、このまま話を続ける。",shape=box,color=blue];
		j730548739 -> j233461735;
	j136866374 [label="いいだろう。兵士から兵士へ、敬意を表して、もっと直接的に核心に迫ろう。貴様を怒らせて、より正直な返答を引き出そうとした。",shape=box,color=blue];
		j136866374 -> j233461735;
	j2853803393 [label="自分の居場所はある。",shape=box,color=red];
		j2853803393 -> j1014579265;
	j3143052856 [label="わかったように話すな。",shape=box,color=red];
		j3143052856 -> j499580212;
	j2940129775 [label="RoatheはAlbrechtと何も変わらない。彼がタイムトラベルしているからこんな事態になったんだ。それを次元レベルでしたいって？",shape=box,color=red];
		j2940129775 -> j1543527463;
	j1128474863 [label="これだからオロキンは。世界をまるで自分のものと勘違いしている。",shape=box,color=red];
		j1128474863 -> j729146759;
	j233461735 [label="+5 Chemistry",color=orange];
		j233461735 -> j1163903273;
	j1014579265 [label="では教えてみろ！　ホルバニアか？　デュヴィリか？　それとも廃墟と化した地球にある墜落したオービターか？",shape=box,color=blue];
		j1014579265 -> j2599058703;
		j1014579265 -> j2169258089;
	j499580212 [label="ではその居場所とは何か言ってみろ！　ホルバニアか？　デュヴィリか？　それとも廃墟と化した地球にある墜落したオービターか？",shape=box,color=blue];
		j499580212 -> j2599058703;
		j499580212 -> j2169258089;
	j1543527463 [label="当たり前であろう？　オロキンこそ頂点の存在なのだ、違うか？　Albrechtは好き勝手暴れて、貴様はその後始末を進んで行っている！　なら何故我にその権利がない？　何故奴の探求が「正当」であって、我はそうでないのだ？",shape=box,color=blue];
		j1543527463 -> j2973169774;
	j729146759 [label="当たり前であろう？　オロキンこそ頂点の存在なのだ、違うか？　Albrechtは時間を冒涜し、民を未解読の病で感染させた。奴の言う「神」を倒すためだけに。",shape=box,color=blue];
		j729146759 -> j2973169774;
	j1163903273 [label="我が知る限り別の現実から来た存在である貴様が、なぜ「セラピスト」の真似事をしているのか理解できない。",shape=box,color=blue];
		j1163903273 -> j3956801596;
	j2973169774 [label="だが貴様はどうだ！",shape=box,color=blue];
		j2973169774 -> j965779903;
	j3956801596 [label="Check boolean IsDating",color=orange];
		j3956801596 -> j50498019 [label=true,color=green];
		j3956801596 -> j4167510551 [label=false,color=brown];
	j965779903 [label="Check boolean IsDating",color=orange];
		j965779903 -> j345976092 [label=true,color=green];
		j965779903 -> j1130807301 [label=false,color=brown];
	j50498019 [label="聞いたこともないような能力を持つ貴様が、何故他人に固執する？　時をループでき、次元を創造できる貴様が…　他人の関係を修復しようとしている（自身の関係も作ろうとしているみたいだがな）。",shape=box,color=blue];
