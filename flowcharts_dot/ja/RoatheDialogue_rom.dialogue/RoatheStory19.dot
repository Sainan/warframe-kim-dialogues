	5721 [label="常に外交的であり、甘い声で説得する奴は、他の執行官たちの恨みや争いの仲介役を務めていた。",shape=box,color=blue];
		5721 -> 2301;
	2301 [label="滑稽なことに、奴は二つの棘の茂みに挟まれたバラとなっていた。",shape=box,color=blue];
		2301 -> 5734;
	5734 [label="Nitokh率いる好戦派を一方に、Scarne率いる平和派を片方に。",shape=box,color=blue];
		5734 -> 2300;
	2300 [label="Ballasは決断を迫られ、付かなかった側から痛烈な敵意を向けられる状況に陥った。",shape=box,color=blue];
		2300 -> 2305;
	2305 [label="理由は不明だが、奴は和平を選んだ。4対3で、センティエントたちは突如として味方となり、友人となった。",shape=box,color=blue];
		2305 -> 2308;
	2308 [label="「いずれにせよ、奴は考えを変えるだろう」とNitokhは確信していた。そして我は駐屯するダクスの中から不満分子を探し出すため、現地に派遣されていた。",shape=box,color=blue];
