	"Chat ends." [color=orange];
	j3590632601 [label="ボイスメール：仲介",shape=box,color=blue];
		j3590632601 -> j3822605023;
	j3822605023 [label="七人の執行官の中で、Ballasは自身を第一の人物と称していた。",shape=box,color=blue];
		j3822605023 -> j4029546309;
	j4029546309 [label="常に外交的であり、甘い声で説得する奴は、他の執行官たちの恨みや争いの仲介役を務めていた。",shape=box,color=blue];
		j4029546309 -> j2142389806;
	j2142389806 [label="滑稽なことに、奴は二つの棘の茂みに挟まれたバラとなっていた。",shape=box,color=blue];
		j2142389806 -> j3864242989;
	j3864242989 [label="Nitokh率いる好戦派を一方に、Scarne率いる平和派を片方に。",shape=box,color=blue];
		j3864242989 -> j379016307;
	j379016307 [label="Ballasは決断を迫られ、付かなかった側から痛烈な敵意を向けられる状況に陥った。",shape=box,color=blue];
		j379016307 -> j1369305327;
	j1369305327 [label="理由は不明だが、奴は和平を選んだ。4対3で、センティエントたちは突如として味方となり、友人となった。",shape=box,color=blue];
		j1369305327 -> j2345837553;
	j2345837553 [label="「いずれにせよ、奴は考えを変えるだろう」とNitokhは確信していた。そして我は駐屯するダクスの中から不満分子を探し出すため、現地に派遣されていた。",shape=box,color=blue];
		j2345837553 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}