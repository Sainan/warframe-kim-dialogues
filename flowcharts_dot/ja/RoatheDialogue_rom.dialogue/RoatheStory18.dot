	j1803449982 [label="ボイスメール：反逆",shape=box,color=blue];
		j1803449982 -> j3955550488;
	j3955550488 [label="「同盟条約だと？」",shape=box,color=blue];
		j3955550488 -> j2070048787;
	j2070048787 [label="彼女の声は、割れたガラスの軋む音のように響いた。",shape=box,color=blue];
		j2070048787 -> j734337162;
	j734337162 [label="執行官Nitokhは不機嫌だった。彼女は、戦いが次々と続き、オロキンの滅亡という最高潮に終わる、そんな輝かしい発展を期待していたのだ。",shape=box,color=blue];
		j734337162 -> j2392558193;
	j2392558193 [label="その後何を企んでいたかは推測しかできない。隠所から出てきて…　センティエントの信頼を得ることを期待したか。",shape=box,color=blue];
		j2392558193 -> j2571449919;
	j2571449919 [label="それとも焦土と化したOrigin太陽系を手放し、自身の王国を築こうとしたか。",shape=box,color=blue];
		j2571449919 -> j4234136039;
	j4234136039 [label="どちみちにせよ、同盟条約など許されなかった。そこで我々は、それを揺るがす陰謀を掻き立てた。",shape=box,color=blue];
		j4234136039 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}