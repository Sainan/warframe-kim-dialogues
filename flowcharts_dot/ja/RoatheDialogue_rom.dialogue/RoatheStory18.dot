		5717 -> 5718;
	5718 [label="執行官Nitokhは不機嫌だった。彼女は、戦いが次々と続き、オロキンの滅亡という最高潮に終わる、そんな輝かしい発展を期待していたのだ。",shape=box,color=blue];
		5718 -> 5719;
	5719 [label="その後何を企んでいたかは推測しかできない。隠所から出てきて…　センティエントの信頼を得ることを期待したか。",shape=box,color=blue];
		5719 -> 2291;
	2291 [label="それとも焦土と化したOrigin太陽系を手放し、自身の王国を築こうとしたか。",shape=box,color=blue];
		2291 -> 2297;
	2297 [label="どちみちにせよ、同盟条約など許されなかった。そこで我々は、それを揺るがす陰謀を掻き立てた。",shape=box,color=blue];
