	j2570585785 [label="ボイスメール：センティエント",shape=box,color=blue];
		j2570585785 -> j1906522483;
	j1906522483 [label="我々はセンティエントを「彼ら」というより「それ」として捉えていた。",shape=box,color=blue];
		j1906522483 -> j2515542906;
	j2515542906 [label="個々の命など顧みず、血球体のように投げつけられる軍団に対峙した。",shape=box,color=blue];
		j2515542906 -> j210634497;
	j210634497 [label="彼らは、悪意に満ちた塊の中の、広がる細胞のようだった。",shape=box,color=blue];
		j210634497 -> j3199193215;
	j3199193215 [label="我々は、感染体…　全く異なる秩序を持つ集合意識…　との経験によって、偏見を持ってしまったのだろう。",shape=box,color=blue];
		j3199193215 -> j1028673805;
	j1028673805 [label="センティエントたちは進化の使命を与えられており、その進化の終着点となる唯一のモデルが我々だったのだ。",shape=box,color=blue];
		j1028673805 -> j1033095446;
	j1033095446 [label="彼らがOrigin太陽系に戻ってきたのは、オロキンを消滅させるためだけではなく、オロキンに取って代わり、最終的には…　完成させるためだった。",shape=box,color=blue];
		j1033095446 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}