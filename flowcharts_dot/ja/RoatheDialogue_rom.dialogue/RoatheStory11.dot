	j3542637552 [label="ボイスメール：分裂",shape=box,color=blue];
		j3542637552 -> j1103586364;
	j1103586364 [label="最初のセンティエント侵攻と、オロキンの悲惨な反撃の後、不可解な静寂が起きた。",shape=box,color=blue];
		j1103586364 -> j1678580472;
	j1678580472 [label="Tauに取り残された仲間からは連絡がなく、彼らの信号が妨害されているのか、皆殺しにされてしまったのか知る術もなかった。",shape=box,color=blue];
		j1678580472 -> j3543637789;
	j3543637789 [label="そこでいくつかの疑問が芽生えた。戦略家として、我は敵の動向を把握することが求められていた。",shape=box,color=blue];
		j3543637789 -> j2818912346;
	j2818912346 [label="センティエントはTauのソーラーレールターミナルをいつでも破壊できたはずなのに、レールはまだ稼働していた。",shape=box,color=blue];
		j2818912346 -> j2819121056;
	j2819121056 [label="何故なのか？　門を開け放っておくことで、彼らに何の得が？",shape=box,color=blue];
		j2819121056 -> j4036178617;
	j4036178617 [label="彼らは侵略に団結していたのか、それとも平和的共存を望む者がいたのか？",shape=box,color=blue];
		j4036178617 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}