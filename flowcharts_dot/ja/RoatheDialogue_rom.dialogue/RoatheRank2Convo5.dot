	1270 [label="執行官たちと皇帝たちを排除し…　新たな制度が導入されるまで我が臨時執行官として制する計画だった。",shape=box,color=blue];
		1270 -> 1274;
	1267 [label="タイムトラベルとはおかしいものだ。",shape=box,color=blue];
		1267 -> 1271;
	1268 [label="一心不乱にこの時代に戻って…　オロキンは既に滅びていた。もしあの時代に残っていたら他と同様に殺されていただろう。",shape=box,color=blue];
		1268 -> 1272;
	1269 [label="黙れ。",shape=box,color=blue];
		1269 -> 1273;
	1274 [label="どれほどの時間を要するかは検討もつかない、だが大戦後の結末を考えれば悪い案ではなかった。",shape=box,color=blue];
		1274 -> 1258;
		1274 -> 1259;
		1274 -> 1257;
	1271 [label="我が体感した数年の間で、「「現実」では数千年が過ぎていた。帝国は崩壊し、多くのオロキンは殺された。",shape=box,color=blue];
		1271 -> 5775;
	1272 [label="ナーガ太鼓が響いた夜、我もテンノに殺されていただろう。多分、Nitokhをかばって死んでいただろうな。",shape=box,color=blue];
		1272 -> 1275;
	1273 [label="当時は、そうできると信じていた。だが今はもう関係ない話であろう？",shape=box,color=blue];
		1273 -> 1268;
	5775 [label="我が権力を放棄できたかどうかなど、今となっては些細な問題だ。だが当時は、そうできると信じていた。",shape=box,color=blue];
		5775 -> 1272;
	1275 [label="彼女はどのような結末を迎えたのだろうか。残った記録には彼女の名さえ記載されていない…　彼女が起こした恐ろしいことや、殺戮、悲劇全てが…　もはや覚えているのは我だけしかいないのかもしれん。",shape=box,color=blue];
		1275 -> 1276;
	1276 [label="それか、ダーク・リフラクトリーでテンノが何か掘り起こすか。だが今やもう我の問題ではない。",shape=box,color=blue];
		1276 -> 1277;
		1276 -> 1278;
		1276 -> 1279;
	1277 [label="子供の方に怯えているみたいだ。",shape=box,color=red];
		1277 -> 1280;
	1278 [label="Nitokhとはどういう関係だったの？",shape=box,color=red];
		1278 -> 1281;
	1279 [label="オロキンを裏切るつもりだった？",shape=box,color=red];
		1279 -> 1282;
	1280 [label="Voidに歪まされた幼い子供が、かつては兵士で、醜くも美しく作り変えられた感染兵器を遠隔操作し、敵の大隊を殲滅するのを目の当たりにした。",shape=box,color=blue];
		1280 -> 1283;
	1281 [label="全てだ。",shape=box,color=blue];
		1281 -> 1284;
	1282 [label="そうだ、我ら二人ともだ。だがNitokhはいずれ我を裏切ったであろう。そして我はNitokhを。いつものオロキン事情だ。",shape=box,color=blue];
		1282 -> 1285;
	1283 [label="そしてその後我の帝国を滅ぼしたと聞いた。Origin太陽系を統べていた帝国を。Tauを征服するはずの帝国を。",shape=box,color=blue];
		1283 -> 1286;
	1284 [label="あり得る全ての関係性が、我とNitokhだ。",shape=box,color=blue];
		1284 -> 1287;
	1285 [label="誰もが誰かを裏切ろうと陰謀を企んでいる。いつものことだ。",shape=box,color=blue];
		1285 -> 1288;
	1286 [label="たった一晩で。",shape=box,color=blue];
		1286 -> 1289;
	1287 [label="全てと、それ以上。",shape=box,color=blue];
		1287 -> 1290;
	1288 [label="オロキン同士の裏切りは日常茶飯事だった。だが帝国全てを裏切る？　そのような反逆は、ヒスイの光のみならず、セファロンプログラムによる処刑に値する。",shape=box,color=blue];
		1288 -> 1291;
