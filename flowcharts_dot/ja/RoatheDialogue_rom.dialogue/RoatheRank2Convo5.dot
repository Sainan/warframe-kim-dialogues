		1258 -> 1263;
	1259 [label="Roatheが権力を放棄するとは思えない。",shape=box,color=red];
		1259 -> 1264;
	1265 [label="もちろんだ！　初耳のような振る舞いはよせ。どうせもう知っていたことだ。",shape=box,color=blue];
