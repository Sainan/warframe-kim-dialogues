		1226 -> 1229 [label=true,color=green];
		1226 -> 1228 [label=false,color=brown];
	1227 [label="Chat ends.",color=orange];
	1229 [label="過去のRoatheは執行官Nitokhについてどこまで話した？　くっ、思い出そうとするだけで屈辱だ。過去の我が貴様にこれほどの情報を託して…　その会話の記憶を消し去ってしまうとは。",shape=box,color=blue];
		1229 -> 1232;
	1228 [label="Evaluate expressions on HellStory",color=orange];
		1228 -> 1231 [label="x >= 1",color=purple];
		1228 -> 1230 [label="x <= 1",color=purple];
		1228 -> 1230 [label="false",color=purple];
	1232 [label="胸が苦しむ。貴様に全てを、心の奥底までさらけ出したかもしれない…　なのに貴様はそれを…　全て消した。まるで使い捨ての玩具のように。",shape=box,color=blue];
		1232 -> 1234;
	1231 [label="以前執行官Nitokhの話をしたな。彼女との…　やり取りについても。分かってほしいのだが、オロキン帝国全てが悪ではなかったのだ。",shape=box,color=blue];
		1231 -> 1233;
	1230 [label="Chat ends.",color=orange];
	1234 [label="これも因果応報か。それがオロキンが人類にしてきたことだからな。ユヴァンの劇場で…　犠牲を惜しまずに新たな身体を手に入れ、お互いを歪んだ娯楽で苦しめ…",shape=box,color=blue];
		1234 -> 1236;
	1233 [label="それが今では荒廃と堕落だけが記憶に残り、胸が張り裂ける思いだ。確かに、汚職は多くあった。異論はしない。",shape=box,color=blue];
		1233 -> 1235;
	1236 [label="憎かった。その全てを憎んでいた。",shape=box,color=blue];
		1236 -> 1239;
		1236 -> 1240;
		1236 -> 1238;
	1235 [label="だがオロキンからは新たな美学、娯楽、愛情、科学の発展もあった。我々がどれほどのものを成し遂げてきたことか！",shape=box,color=blue];
		1235 -> 1237;
	1239 [label="Roatheを傷つけるつもりはなかった、でも結果そうなってしまって申し訳ない。でもこれでオロキン帝国の犠牲者の気持ちがわかれば、それは貴重な教訓だ。",shape=box,color=red];
		1239 -> 1245;
	1240 [label="Roatheをこんな風に傷つけるつもりはなかった。そしてRoatheがオロキン社会のやり口を謝る必要はない。築いたのはRoatheじゃないし、救おうとしていた。",shape=box,color=red];
		1240 -> 1246;
	1238 [label="[閉じる]",shape=box,color=red];
		1238 -> 1244;
	1237 [label="Nitokhが我を呼び出し、オロキンを皆殺しにすると告げた時…　我は即座に同意した。毒蛇の首を切り落としたいと願った。より穏健な体制に、より穏健な支配者と置き換えたいと願った。",shape=box,color=blue];
		1237 -> 1241;
		1237 -> 1242;
		1237 -> 1243;
	1245 [label="Add 3 to Thermostat",color=orange];
		1245 -> 1250;
	1246 [label="Add -3 to Thermostat",color=orange];
		1246 -> 1251;
	1244 [label="Chat ends.",color=orange];
	1241 [label="つまり、皇帝たちと執行官たちを自分自身に置き換えたかったと。",shape=box,color=red];
		1241 -> 1247;
	1242 [label="その支配者とは？",shape=box,color=red];
		1242 -> 1248;
	1243 [label="[閉じる]",shape=box,color=red];
		1243 -> 1249;
	1250 [label="オロキン帝国全てが悪ではなかった。それが今では荒廃と堕落だけが記憶に残り、胸が張り裂ける思いだ。確かに、汚職は多くあった。異論はしない。",shape=box,color=blue];
		1250 -> 1253;
	1251 [label="他が同じ見解を持っていたなら…　Nitokhがその見解も持っていたなら…",shape=box,color=blue];
		1251 -> 1254;
	1247 [label="もちろんだ！",shape=box,color=blue];
		1247 -> 1252;
	1248 [label="もちろん、我だ。",shape=box,color=blue];
