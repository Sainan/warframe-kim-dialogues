	1253 [label="だがオロキンからは新たな美学、娯楽、愛情、科学の発展もあった。我々がどれほどのものを成し遂げてきたことか！",shape=box,color=blue];
		1253 -> 1256;
	1254 [label="オロキン帝国全てが悪ではなかった。それが今では荒廃と堕落だけが記憶に残り、胸が張り裂ける思いだ。確かに、汚職は多くあった。異論はしない。",shape=box,color=blue];
		1254 -> 1253;
	1252 [label="執行官たちと皇帝たちを排除し…　新たな制度が導入されるまで我が臨時執行官として制する計画だった。",shape=box,color=blue];
		1252 -> 1255;
	1256 [label="Nitokhが我を呼び出し、オロキンを皆殺しにすると告げた時…　我は即座に同意した。毒蛇の首を切り落としたいと願った。より穏健な体制に、より穏健な支配者と置き換えたいと願った。",shape=box,color=blue];
		1256 -> 1260;
