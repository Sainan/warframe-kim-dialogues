	1266 [label="もちろん、我だ。初耳のような振る舞いはよせ。どうせもう知っていたことだ。",shape=box,color=blue];
		1266 -> 1270;
	1262 [label="貴様が「古の大戦」と呼んでいるものだ。我にとっては数年前の出来事で、古でもなんでもないのだが。",shape=box,color=blue];
		1262 -> 1267;
	1263 [label="どうだろうか。だが今はもう関係ない話であろう？　ただ当時は、そうできると信じていた。",shape=box,color=blue];
		1263 -> 1268;
	1264 [label="+5 Chemistry",color=orange];
