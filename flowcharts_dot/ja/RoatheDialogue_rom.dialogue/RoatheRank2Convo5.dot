		1311 -> 1314;
	1312 [label="どうなったかは、貴様は十分知っているであろう！　我とNitokhが執行官たちを陥れる前に、あの廊下でAlbrechtに遭遇した。",shape=box,color=blue];
		1312 -> 1315;
	5777 [label="我とNitokhが執行官たちを陥れる前に、Albrechtにこの姿に変えられた。",shape=box,color=blue];
		5777 -> 1314;
