		1289 -> 1292;
	1290 [label="今はそれだけを伝えておこう。",shape=box,color=blue];
		1290 -> 1293;
	1291 [label="Update boolean RoatheTraitor1",color=orange];
		1291 -> 1294;
		1291 -> 1295;
	1292 [label="執行官たちの殺害だけでも、我々がどれほどの危険を冒していたか、言葉では表せない。ましてやオロキン全員ともなると想像すらできん。",shape=box,color=blue];
		1292 -> 1288;
	1293 [label="Update boolean RoatheExecutor1",color=orange];
		1293 -> 1292;
	1294 [label="どっちの方がたちが悪い？",shape=box,color=red];
		1294 -> 1296;
	1295 [label="そういう策略は普通じゃなかったと？",shape=box,color=red];
		1295 -> 1297;
	1296 [label="断然、Nihilのセファロンプログラムだ。グラスメイカーの作品は…",shape=box,color=blue];
		1296 -> 1298;
	1297 [label="オロキン帝国の存在は、短剣の刃の上で均衡を保っていたのだ、簒奪者よ。帝国は常に破滅の瀬戸際で唸りを上げていた。そんな帝国を支えていたのは、ただ一つだけだった：",shape=box,color=blue];
		1297 -> 1299;
	1298 [label="少なくても鎧や盾を持たないものにとって、ヒスイの光は一瞬で終わる。慈悲のある処刑なのだ。",shape=box,color=blue];
		1298 -> 1300;
	1299 [label="社会規範。",shape=box,color=blue];
		1299 -> 1301;
	1300 [label="セファロン化は、望む場合痛みを伴わない、心の本質も保たれる。だが…　刑罰的に使われた場合…",shape=box,color=blue];
		1300 -> 1302;
	1301 [label="オロキンを殺すなど、常人なら考えもしない！　あり得なかったのだ、漂流者！　想像を超え、下劣とまで言える。",shape=box,color=blue];
		1301 -> 1303;
	1302 [label="オロキンにとって記憶は神聖なものなのだ、漂流者。それが我々の全てだ。顔も、声も、血も、意のままに変えられる。まるで着替えるように。",shape=box,color=blue];
		1302 -> 1304;
	1303 [label="それもあって、実際は容易い行為だった。貴様の片割れがそれをよく知る。",shape=box,color=blue];
		1303 -> 1305;
		1303 -> 1306;
