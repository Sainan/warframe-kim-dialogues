		1313 -> 1316;
	1314 [label="一瞬、黄金の廊下に立っていたと思ったら、次の瞬間、「ガウル」の田舎町で苦痛に叫んでいた。",shape=box,color=blue];
		1314 -> 1317;
	1315 [label="そして血清を手渡し、その後の展開は知っての通りだ！",shape=box,color=blue];
		1315 -> 1316;
	1316 [label="それについてはまだ怒りが収まらない。だが、何故だ？！　何故我は貴様にこれを告白した？！　何故これを貴様が知る？！",shape=box,color=blue];
		1316 -> 1318;
	1317 [label="我が消失した後Nitokhは計画を破棄したのだろう。おそらく、我を反逆の主謀者に仕立て上げ、上手く逃げたのだろう。",shape=box,color=blue];
		1317 -> 1319;
	1318 [label="もういい。もう行く。怒りでこの機械を粉砕する前に。",shape=box,color=blue];
		1318 -> 1320;
	1319 [label="残った記録に我を「臆病者」と残す記載が多いのも納得できる。尻尾を撒いて逃げたと！",shape=box,color=blue];
		1319 -> 1321;
