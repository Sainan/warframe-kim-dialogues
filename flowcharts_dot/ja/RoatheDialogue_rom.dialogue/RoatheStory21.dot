	j3742676948 [label="ボイスメール：忘却",shape=box,color=blue];
		j3742676948 -> j219107396;
	j219107396 [label="臆病者。",shape=box,color=blue];
		j219107396 -> j3135729050;
	j3135729050 [label="そう呼ばれていたのだろう？　この埃まみれの図書室に散らばる歴史書を読んだ。嘘だ。奴らは真実を知らないだけだ。計画を成し遂げる前に、時代から引き離されたことを。",shape=box,color=blue];
		j3135729050 -> j2321625825;
	j2321625825 [label="臆病者。",shape=box,color=blue];
		j2321625825 -> j2001121181;
	j2001121181 [label="思い出した。黄金の広間で、奴は我に近づいてきた。知らない顔だった。だが我々にとって珍しいことでもない。馴染みのある声がした。動きにも見覚えがあった。",shape=box,color=blue];
		j2001121181 -> j3253113139;
	j3253113139 [label="臆病者！",shape=box,color=blue];
		j3253113139 -> j2040099218;
	j2040099218 [label="奴は一つだけ質問した。全てを灰にして、我は許されると信じているかと？",shape=box,color=blue];
		j2040099218 -> j4169056000;
	j4169056000 [label="臆病者！",shape=box,color=blue];
		j4169056000 -> j3990951732;
	j3990951732 [label="あの青白い、差し出された手には…　注射器が一つ。自由と…　新たな機会と…　新たな人生が詰まっていた。",shape=box,color=blue];
		j3990951732 -> j610652799;
	j610652799 [label="我はそれを受け取った。",shape=box,color=blue];
		j610652799 -> j4195321974;
	j4195321974 [label="臆病者！",shape=box,color=blue];
		j4195321974 -> j921430358;
