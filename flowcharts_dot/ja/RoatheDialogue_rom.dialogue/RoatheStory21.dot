		2321 -> 5725;
	5725 [label="そう呼ばれていたのだろう？　この埃まみれの図書室に散らばる歴史書を読んだ。嘘だ。奴らは真実を知らないだけだ。計画を成し遂げる前に、時代から引き離されたことを。",shape=box,color=blue];
		5725 -> 5726;
	5726 [label="臆病者。",shape=box,color=blue];
		5726 -> 5727;
	5727 [label="思い出した。黄金の広間で、奴は我に近づいてきた。知らない顔だった。だが我々にとって珍しいことでもない。馴染みのある声がした。動きにも見覚えがあった。",shape=box,color=blue];
		5727 -> 5728;
	5728 [label="臆病者！",shape=box,color=blue];
		5728 -> 5729;
	5729 [label="奴は一つだけ質問した。全てを灰にして、我は許されると信じているかと？",shape=box,color=blue];
