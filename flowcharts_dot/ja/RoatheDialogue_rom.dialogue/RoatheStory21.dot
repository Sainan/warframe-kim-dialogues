	5730 [label="臆病者！",shape=box,color=blue];
		5730 -> 2320;
	2320 [label="あの青白い、差し出された手には…　注射器が一つ。自由と…　新たな機会と…　新たな人生が詰まっていた。",shape=box,color=blue];
		2320 -> 2324;
