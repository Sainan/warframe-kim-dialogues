digraph {
	2049 [label="RoatheRank3Convo6 begins.",color=orange];
		2049 -> 2052;
		2049 -> 2050;
		2049 -> 2051;
	2052 [label="随分カビアたちと時間を過ごしているみたいだけど、どうして？",shape=box,color=red];
		2052 -> 2055;
	2050 [label="カビアに近づかないでRoathe。不安になる。",shape=box,color=red];
		2050 -> 2053;
	2051 [label="[閉じる]",shape=box,color=red];
		2051 -> 2054;
	2055 [label="ん？　ああ、それは奴らは我が今まで出会った中で最も悲しく哀れな創造物のだと思うからだ。",shape=box,color=blue];
		2055 -> 2057;
	2053 [label="ふむ。なるべく誤解を避けるために、いつもの冗長な表現を避けて、こう言おう：",shape=box,color=blue];
		2053 -> 2056;
	2054 [label="Chat ends.",color=orange];
	2057 [label="実験動物。実験動物だぞ、Albrecht！　動物たちをVoidに投げ込んで、貴様の作った子供騙しの言語で喋り始めたら、執事に始末しろと命じたと？！",shape=box,color=blue];
		2057 -> 2059;
	2056 [label="断る。",shape=box,color=blue];
		2056 -> 2058;
	2059 [label="いつも汚れ仕事は他人任せだ。話が逸れてしまった。何故我が奴らと話をするのか、と聞いていたのだな。特にあの鳥と。理由は単純だ。だがせっかくだ、貴様に推測してもらおう。理解できるか試したい。",shape=box,color=blue];
		2059 -> 2060;
		2059 -> 2061;
		2059 -> 2062;
		2059 -> 2063;
		2059 -> 2064;
	2058 [label="Chat ends.",color=orange];
	2060 [label="彼がRoatheを知らないから。",shape=box,color=red];
		2060 -> 2065;
	2061 [label="Bird 3はみんなが好きだから。",shape=box,color=red];
		2061 -> 2066;
	2062 [label="Roatheが賢いと感じさせてくれる人々に囲まれることを好むから。",shape=box,color=red];
		2062 -> 2067;
	2063 [label="彼が周囲に対して鋭い観察力を持っているから。",shape=box,color=red];
		2063 -> 2068;
	2064 [label="操りやすいから。",shape=box,color=red];
		2064 -> 2069;
	2065 [label="そうだ。ある意味正解だ。我を誰だか知らない。「Tauの悪魔」を知らない。そして何より…　気にしていない。",shape=box,color=blue];
		2065 -> 2070;
	2066 [label="そうだな。奴の愚かとも呼べる純粋さはとても魅力的だ。だが貴様は言葉を和らげ、遠回しに、我を好きになれるものが他にいないと言っているのだな？",shape=box,color=blue];
		2066 -> 2071;
	2067 [label="どれだけ見当違いなことか。どれだけ的外れなことか…　だが、我に対する貴様の意見は、貴様だけのものではない。",shape=box,color=blue];
		2067 -> 2072;
	2068 [label="そうだば。奴の観察力は非常に有益だが、我自身も容易に到達できるものだ。",shape=box,color=blue];
		2068 -> 2073;
	2069 [label="どれだけ見当違いなことか。どれだけ的外れなことか…　だが、我に対する貴様の意見は、貴様だけのものではない。",shape=box,color=blue];
		2069 -> 2074;
	2070 [label="+10 Chemistry",color=orange];
		2070 -> 2075;
	2071 [label="だからあのアホウドリと絡んでいると？　まあいい、おおよそ間違いではない。及第点をくれてやろう。",shape=box,color=blue];
		2071 -> 2075;
	2072 [label="決してな。",shape=box,color=blue];
		2072 -> 2076;
	2073 [label="言葉を和らげ、遠回しに、我があの大きな喋る鳥を我の目的のために利用していると思っているいるのだろう？",shape=box,color=blue];
		2073 -> 2077;
	2074 [label="決してな。",shape=box,color=blue];
		2074 -> 2078;
	2075 [label="奴にとって、我はRoatheではない。オロキンでもない。犯罪者でもない。裏切り者でもない。臆病者でもない。奴といると…　我はありのままでいられる。",shape=box,color=blue];
		2075 -> 2079;
	2076 [label="Update boolean RoatheAlone1",color=orange];
		2076 -> 2080;
	2077 [label="それは誤解だ。だがその意見は貴様だけのものではない。決してな。",shape=box,color=blue];
		2077 -> 2078;
	2078 [label="Update boolean RoatheAlone1",color=orange];
		2078 -> 2081;
	2079 [label="それがどれほど単純で稀な救済であるか、貴様には理解できまい…",shape=box,color=blue];
		2079 -> 2082;
		2079 -> 2083;
		2079 -> 2084;
	2080 [label="+5 Chemistry",color=orange];
		2080 -> 2085;
	2081 [label="+5 Chemistry",color=orange];
		2081 -> 2086;
	2082 [label="全部手放してもいいんだよ。Roatheは変われる。ここでも、今でも。",shape=box,color=red];
		2082 -> 2087;
	2083 [label="相当なプレッシャーなんだろう。どこへ行っても、評判に対する期待に応えるのは。",shape=box,color=red];
		2083 -> 2088;
	2084 [label="いつものRoatheは本当のRoatheじゃないって？",shape=box,color=red];
