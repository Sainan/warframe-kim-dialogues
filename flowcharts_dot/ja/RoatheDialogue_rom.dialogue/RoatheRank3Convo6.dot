		2118 -> 2121 [label="false",color=purple];
	2117 [label="ふむ、それが貴様が奪った記憶なのか、簒奪者よ？　我が愛を告白して、それを貴様が拒んだのか？",shape=box,color=blue];
		2117 -> 2113;
	2116 [label="貴様が我に対してどんな悪い印象を抱いても、それは当然のことだ。そしてその印象を抱くのは貴様だけではない。決してな。",shape=box,color=blue];
		2116 -> 2120;
	2115 [label="Update boolean RoatheAlone1",color=orange];
		2115 -> 2116;
	2119 [label="Chat ends.",color=orange];
	2124 [label="嗚呼、なんという悲劇か…　詳細を知りたいくらいだが、意図せず本を先読みしてしまう気分だ。",shape=box,color=blue];
		2124 -> 2125;
	2123 [label="冗談だ。何故そうしたか、お互い知っているだろう？　我への愛のためではなかった。他への愛のためだ。ふん、気にするな。詩に黄昏れているだけだ。",shape=box,color=blue];
		2123 -> 2125;
	2122 [label="冗談だ。何故そうしたか、お互い知っているだろう？　我への愛のためではなかった。そもそも愛のためではなかった。ふん、気にするな。詩に黄昏れているだけだ。",shape=box,color=blue];
		2122 -> 2125;
	2121 [label="ふん。詩的になっても意味などないか。",shape=box,color=blue];
		2121 -> 2125;
	2120 [label="Chat ends.",color=orange];
	2125 [label="だが貴様の同情や哀れみを求めているわけではない。これは自分で蒔いた種だ。貴様が我に対してどんな悪い印象を抱いても、それは当然のことだ。そしてその印象を抱くのは貴様だけではない。",shape=box,color=blue];
