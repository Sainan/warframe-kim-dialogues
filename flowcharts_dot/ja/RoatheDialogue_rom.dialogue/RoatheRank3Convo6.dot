	2085 [label="Chat ends.",color=orange];
	2086 [label="Chat ends.",color=orange];
	2087 [label="Add 2 to Thermostat",color=orange];
		2087 -> 2090;
	2088 [label="Add -1 to Thermostat",color=orange];
		2088 -> 2091;
	2089 [label="そんな単純ならどれだけ楽なことか。仮面舞踏会のように顔を自由に変えられるなら！　違うな、簒奪者。これが我の本質だ。腐った骨の髄までな。",shape=box,color=blue];
		2089 -> 2092;
	2090 [label="そんな容易なことだったらな、簒奪者よ。魅力的にも聞こえる。それは可能なのか？　もしかしたら…　我のような悲劇の悪魔でも、遅くないのかもしれない。",shape=box,color=blue];
		2090 -> 2093;
	2091 [label="+10 Chemistry",color=orange];
		2091 -> 2094;
	2092 [label="だからといって、我のこれまでの犯罪について無知なものとただ会話するのを楽しまないのはもったいない。",shape=box,color=blue];
		2092 -> 2095;
	2093 [label="+10 Chemistry",color=orange];
		2093 -> 2096;
	2094 [label="疲れてしまうのだ、簒奪者よ。仮面舞踏会のように顔を自由に変えられるならどれだけ楽なことか。だがこれが我の本質だ。腐った骨の髄までな。",shape=box,color=blue];
		2094 -> 2092;
	2095 [label="Update boolean RoatheBirdThree",color=orange];
		2095 -> 2097;
		2095 -> 2098;
	2096 [label="我は仮面を被っているだけではないのか？　それとも骨の髄まで腐っているのか？　わからない。だが確かに、時折自身をさらけ出す機会があるのは嬉しいことだ。",shape=box,color=blue];
		2096 -> 2099;
	2097 [label="失礼かもだけど…　Roatheの人生って孤独なものだったんだね。",shape=box,color=red];
		2097 -> 2100;
	2098 [label="あまり友達がいなかったんだね？",shape=box,color=red];
		2098 -> 2101;
	2099 [label="重荷を一旦下ろし、我の罪を知らないものと時を過ごし、愛らしくも間抜けな巨鳥と語り合うと…　心が安らぐ。久しく感じていなかったものだ。",shape=box,color=blue];
		2099 -> 2102;
	2100 [label="Evaluate expressions",color=orange];
		2100 -> 2106 [label="RoatheUnloved1, RoatheKnowsReset2",color=purple];
		2100 -> 2105 [label="RoatheKnowsReset2",color=purple];
		2100 -> 2104 [label="RoatheUnloved1",color=purple];
		2100 -> 2103 [label="false",color=purple];
	2101 [label="Check boolean RoatheKnowsReset2",color=orange];
		2101 -> 2108 [label=true,color=green];
		2101 -> 2107 [label=false,color=brown];
	2102 [label="貴様の言葉には一理あるのかもしれない。それか自身を誤魔化しているか、束の間の安息なのかもしれない。",shape=box,color=blue];
		2102 -> 2109;
	2106 [label="そうだな。少なくとも、覚えている限りはな。それが貴様が奪った記憶なのか、簒奪者よ？　我が愛を告白して、それを貴様が拒んだのか？",shape=box,color=blue];
		2106 -> 2113;
	2105 [label="それは認めよう。少なくても、覚えている限りはな。聞いて驚くかもしれんが、我は恋をしたことがない。少なくとも相互的なものはな。いや、驚かないかもしれない。なにせ既に話したことかもしれないからな。",shape=box,color=blue];
		2105 -> 2112;
	2104 [label="そうだな。長く、孤独なものだった。だがそれは自分で蒔いた種だ。貴様の同情や哀れみを求めているわけではない。",shape=box,color=blue];
		2104 -> 2111;
	2103 [label="それは認めよう。少なくとも、覚えている限りはな。聞いて驚くかもしれんが、我は恋をしたことがない。だがそれは自分で蒔いた種だ。貴様の同情や哀れみを求めているわけではない。",shape=box,color=blue];
		2103 -> 2110;
	2108 [label="どうだろうか？　もしかしたら、我には多くの友がいて、貴様が記憶を消したことでそれを忘れてしまったのかもしれない。",shape=box,color=blue];
		2108 -> 2114;
	2107 [label="どうだろうか？　もしかしたら、我には多くの友がいて、Albrechtが記憶を消したことでそれを忘れてしまったのかもしれない。",shape=box,color=blue];
		2107 -> 2114;
	2109 [label="Update boolean RoatheBirdThree",color=orange];
		2109 -> 2097;
		2109 -> 2098;
	2113 [label="それとも逆だったか？　貴様は悪魔に惚れてしまったが、我は変わらず冷たく接した。乱心した貴様は、我の心を引き裂いた！",shape=box,color=blue];
		2113 -> 2118;
	2112 [label="Update boolean RoatheUnloved1",color=orange];
		2112 -> 2117;
	2111 [label="Update boolean RoatheAlone1",color=orange];
		2111 -> 2116;
	2110 [label="Update boolean RoatheUnloved1",color=orange];
		2110 -> 2115;
	2114 [label="その結果が今の我だ。",shape=box,color=blue];
		2114 -> 2119;
