	"Chat ends." [color=orange];
	j1525997778 [label="ボイスメール：業火",shape=box,color=blue];
		j1525997778 -> j2329732254;
	j2329732254 [label="非道と過剰は、かつて大いに役立った。そして我はそれらを戦術として用いることを期待されていた。",shape=box,color=blue];
		j2329732254 -> j2987029018;
	j2987029018 [label="先人の時代、我々はいかにして感染体を制御したか？　もちろん、原子の核を引き裂いてだ！",shape=box,color=blue];
		j2987029018 -> j4267331150;
	j4267331150 [label="セブンは、我に核兵器を持って対抗するよう命じた。",shape=box,color=blue];
		j4267331150 -> j3341194151;
	j3341194151 [label="その日、センティエントたちは我々の技術を無効にするだけでなく、乗っ取ることもできると知った。",shape=box,color=blue];
		j3341194151 -> j4118245023;
	j4118245023 [label="我々は爆弾をふんだんに搭載した空襲ドローンの群れを送り出したが、ドローンは意味不明な言葉を発しながら、まるで笑うように空母に戻り起爆した。",shape=box,color=blue];
		j4118245023 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}