digraph {
	5151 [label="RoatheRank5Convo8 begins.",color=orange];
		5151 -> 5152;
	5152 [label="Check boolean RoatheFailNot21",color=orange];
		5152 -> 5154 [label=true,color=green];
		5152 -> 5153 [label=false,color=brown];
	5154 [label="Evaluate expressions on HellStory",color=orange];
		5154 -> 5155 [label="x >= 21",color=purple];
		5154 -> 5156 [label="x <= 21",color=purple];
		5154 -> 5156 [label="false",color=purple];
	5153 [label="Chat ends.",color=orange];
	5155 [label="愚か者！　一体何をした？！　何故招かれていない洞窟に潜り込む？！",shape=box,color=blue];
		5155 -> 5157;
	5156 [label="Chat ends.",color=orange];
	5157 [label="早急に解決しろ。これは貴様の所為なのだ。我には感じる、獣が、内側からその爪を立て引き裂くのを。",shape=box,color=blue];
		5157 -> 5158;
	5158 [label="取り除け。この疫病を取り除くのだ。この記憶を我から消し去れ。できるのは知っている。お前の能力でこの苦しみを終わらせろ。今すぐにだ。",shape=box,color=blue];
		5158 -> 5159;
		5158 -> 5160;
		5158 -> 5161;
	5159 [label="本当にいいの？　でも…　Roatheは頭がいいし、絶対気付くと思うけど。",shape=box,color=red];
		5159 -> 5162;
	5160 [label="血清の記憶は、それは別物扱いだ、Roathe。それには効かない。それはRoatheの精神の奥深くに埋もれている。",shape=box,color=red];
		5160 -> 5163;
	5161 [label="真実から逃げ隠れても無駄だ。ただ振り出しに戻るだけだ。",shape=box,color=red];
		5161 -> 5164;
	5162 [label="おそらくな。あらゆる要素を結びつけ、お前を責めるだろう。だが、お前なら乗り越えられると信じている。",shape=box,color=blue];
		5162 -> 5165;
	5163 [label="そうかもしれない。多分そうなのだろう。だが、他に試す方法はないのだろう？　ならやってみる価値はある。",shape=box,color=blue];
		5163 -> 5165;
	5164 [label="もしそうなら、またやり直すだけだ。力の限度はないのだろう？",shape=box,color=blue];
		5164 -> 5165;
	5165 [label="多分、我の記憶を改変したと知れば、我は激怒するだろう。ちなみに、それが我の要望だったと伝えるのは避けたほうがいい。",shape=box,color=blue];
		5165 -> 5166;
	5166 [label="我はその言葉を嘘と断言し、修復不可能なほどにお前を軽蔑するだろう。",shape=box,color=blue];
		5166 -> 5167;
		5166 -> 5168;
	5167 [label="やっぱりダメだ。自分はやらない。この状況に一緒に立ち向かわないといけない。話し合うことはできないの？",shape=box,color=red];
		5167 -> 5169;
	5168 [label="…他に道はないのか？",shape=box,color=red];
		5168 -> 5169;
	5169 [label="これしか道がないのだ。それに、あの執事を上階へ向かわせたいのだろう？　なら要望通り我の記憶を消すことだ。どうでもいいと感じるなら、好きにするといい。我には関係ない。",shape=box,color=blue];
		5169 -> 5170;
	5170 [label="そして、もちろん、我々の継続的な関係も天秤に掛かっているのだ。",shape=box,color=blue];
		5170 -> 5171;
	5171 [label="お前の答えはなんだ？",shape=box,color=blue];
		5171 -> 5172;
		5171 -> 5173;
	5172 [label="わかった。やるよ…　Roatheの記憶をリセットする。MarieとLyonを巻き込んででも。",shape=box,color=red];
		5172 -> 5174;
	5173 [label="ダメだ。断る。Roatheを説得させる方法を絶対見つける。",shape=box,color=red];
		5173 -> 5175;
	5174 [label="+10 Chemistry",color=orange];
		5174 -> 5176;
	5175 [label="健闘を祈る。",shape=box,color=blue];
		5175 -> 5179;
	5176 [label="よろしい。そうするといい。",shape=box,color=blue];
		5176 -> 5178;
	5179 [label="Update boolean LyonRoatheRepair",color=orange];
		5179 -> 5177;
	5178 [label="Add 1 to Promise",color=orange];
		5178 -> 5180;
	5177 [label="Chat ends.",color=orange];
	5180 [label="Update boolean RoatheWillReset",color=orange];
		5180 -> 5181;
	5181 [label="Chat ends.",color=orange];
}