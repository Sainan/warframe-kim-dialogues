	"Chat ends." [color=orange];
	j1223651887 [label="愚か者！　一体何をした？！　何故招かれていない洞窟に潜り込む？！",shape=box,color=blue];
		j1223651887 -> j3422327596;
	j3422327596 [label="Boolean RoatheFailNot21 is now false.",color=orange];
		j3422327596 -> j3456159233;
	j3456159233 [label="早急に解決しろ。これは貴様の所為なのだ。我には感じる、獣が、内側からその爪を立て引き裂くのを。",shape=box,color=blue];
		j3456159233 -> j2706148515;
	j2706148515 [label="取り除け。この疫病を取り除くのだ。この記憶を我から消し去れ。できるのは知っている。お前の能力でこの苦しみを終わらせろ。今すぐにだ。",shape=box,color=blue];
		j2706148515 -> j441640276;
		j2706148515 -> j56180247;
		j2706148515 -> j1112641947;
	j441640276 [label="本当にいいの？　でも…　Roatheは頭がいいし、絶対気付くと思うけど。",shape=box,color=red];
		j441640276 -> j244122278;
	j56180247 [label="血清の記憶は、それは別物扱いだ、Roathe。それには効かない。それはRoatheの精神の奥深くに埋もれている。",shape=box,color=red];
		j56180247 -> j1116683034;
	j1112641947 [label="真実から逃げ隠れても無駄だ。ただ振り出しに戻るだけだ。",shape=box,color=red];
		j1112641947 -> j4104964352;
	j244122278 [label="おそらくな。あらゆる要素を結びつけ、お前を責めるだろう。だが、お前なら乗り越えられると信じている。",shape=box,color=blue];
		j244122278 -> j2052401440;
	j1116683034 [label="そうかもしれない。多分そうなのだろう。だが、他に試す方法はないのだろう？　ならやってみる価値はある。",shape=box,color=blue];
		j1116683034 -> j2052401440;
	j4104964352 [label="もしそうなら、またやり直すだけだ。力の限度はないのだろう？",shape=box,color=blue];
		j4104964352 -> j2052401440;
	j2052401440 [label="多分、我の記憶を改変したと知れば、我は激怒するだろう。ちなみに、それが我の要望だったと伝えるのは避けたほうがいい。",shape=box,color=blue];
		j2052401440 -> j4026849421;
	j4026849421 [label="我はその言葉を嘘と断言し、修復不可能なほどにお前を軽蔑するだろう。",shape=box,color=blue];
		j4026849421 -> j2590587177;
		j4026849421 -> j2843382493;
	j2590587177 [label="やっぱりダメだ。自分はやらない。この状況に一緒に立ち向かわないといけない。話し合うことはできないの？",shape=box,color=red];
		j2590587177 -> j2790183091;
	j2843382493 [label="…他に道はないのか？",shape=box,color=red];
		j2843382493 -> j2790183091;
	j2790183091 [label="これしか道がないのだ。それに、あの執事を上階へ向かわせたいのだろう？　なら要望通り我の記憶を消すことだ。どうでもいいと感じるなら、好きにするといい。我には関係ない。",shape=box,color=blue];
		j2790183091 -> j644284734;
	j644284734 [label="そして、もちろん、我々の継続的な関係も天秤に掛かっているのだ。",shape=box,color=blue];
		j644284734 -> j2430812903;
	j2430812903 [label="お前の答えはなんだ？",shape=box,color=blue];
		j2430812903 -> j1866963134;
		j2430812903 -> j4019056462;
	j1866963134 [label="わかった。やるよ…　Roatheの記憶をリセットする。MarieとLyonを巻き込んででも。",shape=box,color=red];
		j1866963134 -> j1561809109;
	j4019056462 [label="ダメだ。ごめん。こんなことできない。",shape=box,color=red];
		j4019056462 -> j3866245405;
		j4019056462 -> j1057249429;
	j1561809109 [label="+10 Chemistry",color=orange];
		j1561809109 -> j3540771061;
	j3866245405 [label="話し合おう。",shape=box,color=red];
		j3866245405 -> j2057123613;
	j1057249429 [label="憎んでもいい。でも、まずはこの問題を解決しないと。",shape=box,color=red];
		j1057249429 -> j3561022754;
	j3540771061 [label="よろしい。そうするといい。",shape=box,color=blue];
		j3540771061 -> j4072107213;
	j2057123613 [label="我に「落ち着け」など申すな！　引き裂けそうなこの気持ちを、お前に理解できるのか？！",shape=box,color=blue];
		j2057123613 -> j2483835788;
	j3561022754 [label="興味深いな。そして意外な答えだ。説明しろ。",shape=box,color=blue];
		j3561022754 -> j95615721;
		j3561022754 -> j2467706787;
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j2483835788 [label="まるで自分自身への理解、我の基盤そのものが、忌々しいルアのようにひび割れ、引き裂かれたように感じる！　滲むインクで書き直された気分だ。臆病者が！",shape=box,color=blue];
		j2483835788 -> j2118142259;
	j95615721 [label="自分がそうしたのは、その必要があったからだ。もうこれ以上、逃げ隠れすることはできないから。",shape=box,color=red];
		j95615721 -> j1830055178;
	j2467706787 [label="自分のことをどう思おうと構わない。でも負の螺旋は見てすぐわかる。",shape=box,color=red];
		j2467706787 -> j3415586944;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
	j2118142259 [label="それを「落ち着け」だと？！",shape=box,color=blue];
		j2118142259 -> j1830055178;
	j1830055178 [label="Evaluate expressions",color=orange];
		j1830055178 -> j717652277 [label="RoatheForgivenessShortcut",color=purple];
		j1830055178 -> j268946032 [label="RoatheVillainyShortcut",color=purple];
		j1830055178 -> j2318547072 [label="false",color=purple];
	j3415586944 [label="そうだな、お前はこれに関してちょっとした「エキスパート」なのだな？　続けろ。",shape=box,color=blue];
		j3415586944 -> j1401287304;
		j3415586944 -> j3085325988;
	j717652277 [label="怒っても何も解決しない。Roatheが怒っているのは、自分がしたことに向き合うのを恐れているからだ。今の自分に向き合うことを。",shape=box,color=red];
		j717652277 -> j1682927231;
	j268946032 [label="怒りたいなら、そうするといい。でもその怒りを何か価値あるものに使うべきだ。間違った方向へ向けられているその憎しみを振り払うために使うべきだ。",shape=box,color=red];
		j268946032 -> j2382403904;
	j2318547072 [label="Evaluate expressions on Thermostat counter",color=orange];
		j2318547072 -> j717652277 [label="x >= 5",color=purple];
		j2318547072 -> j268946032 [label="x <= 0",color=purple];
		j2318547072 -> j818420087 [label="x > 0 && x < 5",color=purple];
		j2318547072 -> j818420087 [label="false",color=purple];
	j1401287304 [label="許しを求めたいなら、求めてもいい。でも、それは強く望まないといけない。その道を選ぶのは他の誰でもない、Roathe自身だ。",shape=box,color=red];
		j1401287304 -> j3296961826;
	j3085325988 [label="自身の道を切り開きたいなら、そうするといい。謝る必要はない。でも、その道を選ぶのは他の誰でもない、Roathe自身だ。",shape=box,color=red];
		j3085325988 -> j1172810799;
	j1682927231 [label="Roatheはその怒りで自身を傷つけている。その怒りを使って、今もなおこの世界を破壊し続けている者たちと戦うこともできるはずだ。",shape=box,color=red];
		j1682927231 -> j892784972;
	j2382403904 [label="今のRoatheは自身に怒りを向けている。オロキン帝国から世界を救うために最善を尽くしたにもかかわらず、その世界がRoatheを責めている。怒りをぶつけるのはそっちじゃないか。",shape=box,color=red];
		j2382403904 -> j4150501060;
	j818420087 [label="どう助けてあげたらいいのか、何を言えばいいのか、それを知りたい。まるでRoatheは二つの方向に引っ張られているようだ。どっちの道に進みたいんだ？",shape=box,color=red];
		j818420087 -> j3068593780;
	j3296961826 [label="Roatheは自身の過去によって定義されるんじゃない。未来によって定義されるんだ。そして、ナーガ太鼓の夜に命を落としたオロキンたちと違って、Roatheには未来がある。",shape=box,color=red];
		j3296961826 -> j1733632026;
	j1172810799 [label="Roatheは周りの意見、あるいはRoatheの行いを周りがどう思っているかで定義されるんじゃない。Roatheを定義するのはRoathe自身が何であると信じ、選択するかで決まる。",shape=box,color=red];
		j1172810799 -> j933335592;
	j892784972 [label="その事実が、今唯一Roatheを定義するものだ。Roatheは変われる。周りの世界を変えられる。だから、やってみない？",shape=box,color=red];
		j892784972 -> j623953202;
	j4150501060 [label="Roatheは周りの意見、あるいはRoatheの行いを周りがどう思っているかで定義されるんじゃない。Roatheを定義するのはRoathe自身が何であると信じ、選択するかで決まる。",shape=box,color=red];
		j4150501060 -> j999438222;
	j3068593780 [label="Boolean RoatheFail is now true.",color=orange];
		j3068593780 -> j1150931092;
	j1733632026 [label="その事実が、今唯一Roatheを定義するものだ。Roatheは変われる。周りの世界を変えられる。だから、やってみない？",shape=box,color=red];
		j1733632026 -> j3079301142;
	j933335592 [label="そして単純な話、自分たちが知る限り、Roatheはナーガ太鼓の夜を生き延びた数少ないオロキンの一人だ。自分から見て、あれは戦略的撤退だったんだ。",shape=box,color=red];
		j933335592 -> j448366271;
	j623953202 [label="自身を許して前に進むことを？",shape=box,color=red];
		j623953202 -> j1653118348;
	j999438222 [label="そして単純な話、自分たちが知る限り、Roatheはナーガ太鼓の夜を生き延びた数少ないオロキンの一人だ。自分から見て、あれは戦略的撤退だったんだ。",shape=box,color=red];
		j999438222 -> j3736257281;
	j1150931092 [label="我には分からないのだ、簒奪者よ。それこそが最大の問題だ。",shape=box,color=blue];
		j1150931092 -> j2455819930;
	j3079301142 [label="自身を許して前に進むことを？",shape=box,color=red];
		j3079301142 -> j915835491;
	j448366271 [label="それ以上でも、それ以下でもない。",shape=box,color=red];
		j448366271 -> j3291512742;
	j1653118348 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j1653118348 -> j379211194;
	j3736257281 [label="それ以上でも、それ以下でもない。",shape=box,color=red];
		j3736257281 -> j3370923699;
	j2455819930 [label="我の中には狂暴な獣がいて、我の胸を内側から食い荒らそうとしている。",shape=box,color=blue];
		j2455819930 -> j3111372779;
	j915835491 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j915835491 -> j307608744;
	j3291512742 [label="Boolean RoatheVillain is now true.",color=orange];
		j3291512742 -> j307608744;
	j379211194 [label="+20 Chemistry",color=orange];
		j379211194 -> j568582993;
	j3370923699 [label="Boolean RoatheVillain is now true.",color=orange];
		j3370923699 -> j3923842106;
	j3111372779 [label="そして、どうすればそれを満たせるのか分からないのだ。それが可能なのかも。これらの会話が道を示してくれることを期待していたが、今となってはそれが無駄だったと分かった。",shape=box,color=blue];
		j3111372779 -> j1449789796;
	j307608744 [label="+20 Chemistry",color=orange];
		j307608744 -> j673706811;
	j568582993 [label="自身の過去の行いを許して、未来へ進めと？　フム。",shape=box,color=blue];
		j568582993 -> j1250640094;
	j3923842106 [label="+20 Chemistry",color=orange];
		j3923842106 -> j3284201995;
	j1449789796 [label="しかし解決策がある、そうであろう？　お前にはある能力がある…　我の心の苦しみを解放する力を。",shape=box,color=blue];
		j1449789796 -> j3405095714;
	j673706811 [label="いいだろう。お前の主張を認め、受け入れよう。感謝するぞ、漂流者…　この崖から我を引き戻してくれたことを。",shape=box,color=blue];
		j673706811 -> j3365396397;
	j1250640094 [label="状況の捉え直し方については少々強引と感じるが、我は…　その未来が我にとって何を意味するのか知ってみたい、簒奪者よ。漂流者よ。",shape=box,color=blue];
		j1250640094 -> j901957211;
	j3284201995 [label="戦いから逃げて、戦争に勝つか。フム。",shape=box,color=blue];
		j3284201995 -> j1254566669;
	j3405095714 [label="簒奪者よ。漂流者よ。今こそ懇願する。これしか道はないのだ、わかるであろう？　これはお前にとっても有益なことだ。",shape=box,color=blue];
		j3405095714 -> j2145972360;
	j3365396397 [label="お前が思っている以上に、感謝している。",shape=box,color=blue];
		j3365396397 -> j828498310;
	j901957211 [label="我の人生の、新たな息吹。いいだろう。お前の主張を認め、受け入れよう。感謝するぞ、漂流者…　この崖から我を引き戻してくれたことを。",shape=box,color=blue];
		j901957211 -> j3365396397;
	j1254566669 [label="お前があれを戦略的撤退として捉え直すことは…　少々強引と感じるが、それでも我は…　それに同意するぞ、簒奪者。漂流者。",shape=box,color=blue];
		j1254566669 -> j673706811;
	j2145972360 [label="あの執事にエントラティ一家と和解させたいのなら、我の言う通りにするのだ。絶対に。",shape=box,color=blue];
		j2145972360 -> j202420882;
		j2145972360 -> j2085133963;
	j828498310 [label="我はもう行く。酒に溺れ、遠くを眺めたい気分だ。",shape=box,color=blue];
		j828498310 -> "Chat ends. Next chat will be Roathe5Day2.";
	j202420882 [label="お願いって…？",shape=box,color=red];
		j202420882 -> j1677239541;
	j2085133963 [label="ダメだ。何を聞くかはなんとなくわかる。そして答えはノーだ。",shape=box,color=red];
		j2085133963 -> j4191704479;
	"Chat ends. Next chat will be Roathe5Day2." [color=orange];
	j1677239541 [label="お前にはある能力がある。時を巻き戻す能力が。ループさせる力が。その力には…　PROTOFRAMEの精神に干渉する効果がある。感染体と時間の繋がりによってな。",shape=box,color=blue];
		j1677239541 -> j2499750113;
	j4191704479 [label="お前が友人や恋人と呼ぶPROTOFRAMEたちの心を弄ぶためにその力を一度も使ったことがないと、それが嘘でないと断言できるなら…",shape=box,color=blue];
		j4191704479 -> j2635460152;
	j2499750113 [label="それはつまり、我々と時間の繋がりを意味する。よってお前にお願いがある。いや、懇願する。その力を我に使ってほしい。この感情を、この記憶を奪い去ってほしい。",shape=box,color=blue];
		j2499750113 -> j469603752;
	j2635460152 [label="…ならそういうことにしておこう。しかし、自身の楽しみのため、好奇心のため、あるいは他人とのやり取りで犯した過ちを正すために、一度もその力を駆使しなかったと言えるのか？！",shape=box,color=blue];
		j2635460152 -> j469603752;
	j469603752 [label="我がAlbrechtの血清を自らの意志で摂取したことを忘れないといけない。お願いだ。",shape=box,color=blue];
