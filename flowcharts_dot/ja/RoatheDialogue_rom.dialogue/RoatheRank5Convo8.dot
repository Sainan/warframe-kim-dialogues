digraph {
	"RoatheRank5Convo8 begins." [color=orange];
		"RoatheRank5Convo8 begins." -> j4125803273;
	j4125803273 [label="Check boolean RoatheFailNot21",color=orange];
		j4125803273 -> j1758133089 [label=true,color=green];
		j4125803273 -> "Chat ends." [label=false,color=brown];
	j1758133089 [label="Evaluate expressions on HellStory counter",color=orange];
		j1758133089 -> j1978084141 [label="x >= 21",color=purple];
		j1758133089 -> "Chat ends." [label="x <= 21",color=purple];
		j1758133089 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j1978084141 [label="愚か者！　一体何をした？！　何故招かれていない洞窟に潜り込む？！",shape=box,color=blue];
		j1978084141 -> j3456159233;
	j3456159233 [label="早急に解決しろ。これは貴様の所為なのだ。我には感じる、獣が、内側からその爪を立て引き裂くのを。",shape=box,color=blue];
		j3456159233 -> j2706148515;
	j2706148515 [label="取り除け。この疫病を取り除くのだ。この記憶を我から消し去れ。できるのは知っている。お前の能力でこの苦しみを終わらせろ。今すぐにだ。",shape=box,color=blue];
		j2706148515 -> j441640276;
		j2706148515 -> j56180247;
		j2706148515 -> j1112641947;
	j441640276 [label="本当にいいの？　でも…　Roatheは頭がいいし、絶対気付くと思うけど。",shape=box,color=red];
		j441640276 -> j244122278;
	j56180247 [label="血清の記憶は、それは別物扱いだ、Roathe。それには効かない。それはRoatheの精神の奥深くに埋もれている。",shape=box,color=red];
		j56180247 -> j1116683034;
	j1112641947 [label="真実から逃げ隠れても無駄だ。ただ振り出しに戻るだけだ。",shape=box,color=red];
		j1112641947 -> j4104964352;
	j244122278 [label="おそらくな。あらゆる要素を結びつけ、お前を責めるだろう。だが、お前なら乗り越えられると信じている。",shape=box,color=blue];
		j244122278 -> j2052401440;
	j1116683034 [label="そうかもしれない。多分そうなのだろう。だが、他に試す方法はないのだろう？　ならやってみる価値はある。",shape=box,color=blue];
		j1116683034 -> j2052401440;
	j4104964352 [label="もしそうなら、またやり直すだけだ。力の限度はないのだろう？",shape=box,color=blue];
		j4104964352 -> j2052401440;
	j2052401440 [label="多分、我の記憶を改変したと知れば、我は激怒するだろう。ちなみに、それが我の要望だったと伝えるのは避けたほうがいい。",shape=box,color=blue];
		j2052401440 -> j4026849421;
	j4026849421 [label="我はその言葉を嘘と断言し、修復不可能なほどにお前を軽蔑するだろう。",shape=box,color=blue];
		j4026849421 -> j2590587177;
		j4026849421 -> j2843382493;
	j2590587177 [label="やっぱりダメだ。自分はやらない。この状況に一緒に立ち向かわないといけない。話し合うことはできないの？",shape=box,color=red];
		j2590587177 -> j2790183091;
	j2843382493 [label="…他に道はないのか？",shape=box,color=red];
		j2843382493 -> j2790183091;
	j2790183091 [label="これしか道がないのだ。それに、あの執事を上階へ向かわせたいのだろう？　なら要望通り我の記憶を消すことだ。どうでもいいと感じるなら、好きにするといい。我には関係ない。",shape=box,color=blue];
		j2790183091 -> j644284734;
	j644284734 [label="そして、もちろん、我々の継続的な関係も天秤に掛かっているのだ。",shape=box,color=blue];
		j644284734 -> j2430812903;
	j2430812903 [label="お前の答えはなんだ？",shape=box,color=blue];
		j2430812903 -> j1866963134;
		j2430812903 -> j810746366;
	j1866963134 [label="わかった。やるよ…　Roatheの記憶をリセットする。MarieとLyonを巻き込んででも。",shape=box,color=red];
		j1866963134 -> j1561809109;
	j810746366 [label="ダメだ。断る。Roatheを説得させる方法を絶対見つける。",shape=box,color=red];
		j810746366 -> j2020841795;
	j1561809109 [label="+10 Chemistry",color=orange];
		j1561809109 -> j3540771061;
	j2020841795 [label="健闘を祈る。",shape=box,color=blue];
		j2020841795 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j3540771061 [label="よろしい。そうするといい。",shape=box,color=blue];
		j3540771061 -> j4072107213;
	"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
}