digraph {
	5182 [label="RoatheRepair begins.",color=orange];
		5182 -> 5183;
	5183 [label="Evaluate expressions",color=orange];
		5183 -> 5185 [label="LyonRoatheFailFix, MarieRoatheFailFix",color=purple];
		5183 -> 5184 [label="false",color=purple];
	5185 [label="もういい！　降参だ！　狂信者どもを引かせろ。狂暴なクブロドンよりたちが悪い！　どこへ言っても付いてきよって。眠ることさえできない！",shape=box,color=blue];
		5185 -> 5186;
	5184 [label="Chat ends.",color=orange];
	5186 [label="なんだ？！　何を要求する？！",shape=box,color=blue];
		5186 -> 5188;
		5186 -> 5187;
		5186 -> 5189;
	5188 [label="血清の件についてもう一度話し合う機会が欲しい。もう逃げ回るのはよすんだ。",shape=box,color=red];
		5188 -> 5191;
	5187 [label="Roathe、血清を摂取したことは臆病ではない。結果Roatheだけがオロキンで生き残った。それを受け入れるべきだ。",shape=box,color=red];
		5187 -> 5190;
	5189 [label="Roathe、血清を摂取したことは臆病ではない。これは新しい人生のチャンスなんだ。変わることは可能なんだ。",shape=box,color=red];
		5189 -> 5192;
	5191 [label="Evaluate expressions on Thermostat",color=orange];
		5191 -> 5195 [label="x >= 5",color=purple];
		5191 -> 5194 [label="x <= 0",color=purple];
		5191 -> 5193 [label="x > 0 && x < 5",color=purple];
		5191 -> 5193 [label="false",color=purple];
	5190 [label="Add -5 to Thermostat",color=orange];
		5190 -> 5191;
	5192 [label="Add 5 to Thermostat",color=orange];
		5192 -> 5191;
	5195 [label="Roatheはその怒りで自身を傷つけている。その怒りを使って、今もなおこの世界を破壊し続けている者たちと戦うこともできるはずだ。",shape=box,color=red];
		5195 -> 5198;
	5194 [label="今のRoatheは自身に怒りを向けている。オロキン帝国から世界を救うために最善を尽くしたにもかかわらず、その世界がRoatheを責めている。怒りをぶつけるのはそっちじゃないか。",shape=box,color=red];
		5194 -> 5197;
	5193 [label="それを伝えるためだけにあの狂信者どもを向かわせたと？　そんなことのためにか？　哀れな言い分を聞かせるための、最終手段だと？",shape=box,color=blue];
		5193 -> 5196;
	5198 [label="Roatheは自身の過去によって定義されるんじゃない。未来によって定義されるんだ。そして、ナーガ太鼓の夜に命を落としたオロキンたちと違って、Roatheには未来がある。",shape=box,color=red];
		5198 -> 5201;
	5197 [label="Roatheは周りの意見、あるいはRoatheの行いを周りがどう思っているかで定義されるんじゃない。Roatheを定義するのはRoathe自身が何であると信じ、選択するかで決まる。",shape=box,color=red];
		5197 -> 5200;
	5196 [label="聞く耳持たん。",shape=box,color=blue];
		5196 -> 5199;
	5201 [label="その事実が、今唯一Roatheを定義するものだ。Roatheは変われる。周りの世界を変えられる。だから、やってみない？",shape=box,color=red];
		5201 -> 5204;
	5200 [label="そして単純な話、自分たちが知る限り、Roatheはナーガ太鼓の夜を生き延びた数少ないオロキンの一人だ。自分から見て、あれは戦略的撤退だったんだ。",shape=box,color=red];
		5200 -> 5203;
	5199 [label="貴様の失敗は実に痛々しい。一度ならず二度までも。",shape=box,color=blue];
		5199 -> 5202;
	5204 [label="自身を許して前に進むことを？",shape=box,color=red];
		5204 -> 5207;
	5203 [label="それ以上でも、それ以下でもない。",shape=box,color=red];
		5203 -> 5206;
	5202 [label="政治家にならないことを推薦する。",shape=box,color=blue];
		5202 -> 5205;
	5207 [label="Update boolean RoatheRedeemed",color=orange];
		5207 -> 5209;
	5206 [label="Update boolean RoatheVillain",color=orange];
		5206 -> 5208;
	5205 [label="Chat ends.",color=orange];
	5209 [label="+20 Chemistry",color=orange];
		5209 -> 5211;
	5208 [label="+20 Chemistry",color=orange];
		5208 -> 5210;
	5211 [label="自身の過去の行いを許して、未来へ進めと？　フム。",shape=box,color=blue];
		5211 -> 5213;
	5210 [label="戦いから逃げて、戦争に勝つか。フム。",shape=box,color=blue];
		5210 -> 5212;
	5213 [label="状況の捉え直し方については少々強引と感じるが、我は…　その未来が我にとって何を意味するのか知ってみたい、最愛の漂流者よ。",shape=box,color=blue];
		5213 -> 5215;
	5212 [label="お前があれを戦略的撤退として捉え直すことは…　少々強引と感じるが、それでも我は…　それに同意するぞ、最愛の漂流者よ。",shape=box,color=blue];
		5212 -> 5214;
	5215 [label="我の人生の、新たな息吹。いいだろう。お前の主張を認め、受け入れよう。少々遅れたようだが、結果は良好だ。",shape=box,color=blue];
		5215 -> 5216;
	5214 [label="いいだろう。お前の主張を認め、受け入れよう。少々遅れたようだが、結果は良好だ。",shape=box,color=blue];
		5214 -> 5216;
	5216 [label="お前が思っている以上に、感謝している。",shape=box,color=blue];
		5216 -> 5217;
	5217 [label="Update boolean RoatheFail",color=orange];
		5217 -> 5218;
	5218 [label="Update boolean RoatheFamilyFail",color=orange];
		5218 -> 5793;
	5793 [label="Update boolean RoatheFailStall",color=orange];
		5793 -> 5795;
	5795 [label="Check boolean LoidFamilyComplete",color=orange];
		5795 -> 5796 [label=true,color=green];
		5795 -> 5794 [label=false,color=brown];
	5796 [label="Chat ends.",color=orange];
	5794 [label="さて、戦争の次の戦いに移るとしようか？　標的は執事だ。",shape=box,color=blue];
		5794 -> 5797;
	5797 [label="期待でいっぱいだ。",shape=box,color=blue];
		5797 -> 5798;
	5798 [label="Update boolean RoatheFamilyDelay",color=orange];
		5798 -> 1702;
	1702 [label="Chat ends.",color=orange];
}