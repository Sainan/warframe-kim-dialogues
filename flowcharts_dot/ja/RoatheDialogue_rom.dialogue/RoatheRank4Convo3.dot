digraph {
	2475 [label="RoatheRank4Convo3 begins.",color=orange];
		2475 -> 2476;
	2476 [label="この好奇心を解いてくれ、簒奪者。死闘であの子供を相手に勝てると思うか？",shape=box,color=blue];
		2476 -> 2478;
		2476 -> 2477;
		2476 -> 2479;
	2478 [label="は？　なんで…？",shape=box,color=red];
		2478 -> 2481;
	2477 [label="この会話はなしだ。",shape=box,color=red];
		2477 -> 2480;
	2479 [label="[閉じる]",shape=box,color=red];
		2479 -> 2482;
	2481 [label="なにせ、あの「Lotus」はセンティエントであると同時に、ルアをVoidに閉じ込めた張本人なのだ。そして何より、自身の回路の制御を失いつつある。",shape=box,color=blue];
		2481 -> 2483;
		2481 -> 2484;
		2481 -> 2485;
		2481 -> 2486;
		2481 -> 2487;
	2480 [label="デタラメに聞いているのではない。我は真剣に聞いているのだ。これは有益な会話なのだ。",shape=box,color=blue];
		2480 -> 2481;
	2482 [label="Chat ends.",color=orange];
	2483 [label="彼女は大丈夫だ。わかったように話すな。",shape=box,color=red];
		2483 -> 2488;
	2484 [label="回路の制御？　どういうことだ？",shape=box,color=red];
		2484 -> 2489;
	2485 [label="この話を続ける気はない。Lotusは自分の命の恩人だ。あの子供も何度も救ってきた。今こうしているのは彼女のおかげだ。",shape=box,color=red];
		2485 -> 2490;
	2486 [label="黙って、Roathe。付き合ってられない。[閉じる]",shape=box,color=red];
		2486 -> 2491;
	2487 [label="わかっている、自分も心配している。でも彼女には何度も救われた、彼女を裏切るようなことはできない。彼女を支えないと。",shape=box,color=red];
		2487 -> 2492;
	2488 [label="失礼な！　現実を見ろ！　かつて彼女は崖っぷちに立って、古めかしいポケベルを片手に鼻歌を歌い、何ヶ月もVoidを見つめていたであろう？",shape=box,color=blue];
		2488 -> 2493;
	2489 [label="かつて彼女は崖っぷちに立って、古めかしいポケベルを片手に鼻歌を歌い、何ヶ月もVoidを見つめていたであろう？",shape=box,color=blue];
		2489 -> 2493;
	2490 [label="同情しないわけではない。気持ちは分かる。貴様は彼女に多大な恩義を感じている。彼女を殺せと言っているのではない、彼女の周りへの影響を止めろと言っているのだ。",shape=box,color=blue];
		2490 -> 2489;
	2491 [label="よかろう。だが最悪の事態が起きても、我は助けを提供しないぞ。",shape=box,color=blue];
		2491 -> 2494;
	2492 [label="+5 Chemistry",color=orange];
		2492 -> 2495;
	2493 [label="そして今彼女は…　闇の中で、不気味に立っているだけだと？　子供を記憶の奥底に送り込み…　何がしたいのだ？　Albrechtが指を鳴らし合言葉を言った途端にか？",shape=box,color=blue];
		2493 -> 2496;
	2494 [label="Chat ends.",color=orange];
	2495 [label="同情しないわけではない。気持ちは分かる。貴様は彼女に多大な恩義を感じている。彼女を殺せと言っているのではない、彼女の周りへの影響を止めろと言っているのだ。",shape=box,color=blue];
		2495 -> 2497;
	2496 [label="怪しいとは思わないか？　危険だと？　これは罠だ。彼女は操られている。Albrechtか、貴様の言う「無関心のモノ」によって。彼女は壊れたプログラムだ。プリセプトがイカれかけている。",shape=box,color=blue];
		2496 -> 2498;
	2497 [label="かつて彼女が崖っぷちに立って、古めかしいポケベルを片手に鼻歌を歌い、何ヶ月もVoidを見つめていた時、彼女が飛び降りるのではないかと思わなかったのか？",shape=box,color=blue];
		2497 -> 2493;
	2498 [label="彼女が貴様に危害を加えようとしているとは思わない。ただ利用されているだけだと。しかしその時が来たら、貴様は自身の身を守る必要があるかもしれない。あるいは、奴らを鎮圧する必要が。",shape=box,color=blue];
		2498 -> 2499;
	2499 [label="貴様なら、Lotusが再び問題を起こすのを阻止する必要性を理解していると願うが、あの野生児軍団はどうだろうか。もう一度聞く：",shape=box,color=blue];
		2499 -> 2500;
	2500 [label="最悪の事態が起こり、貴様がテンノたちとLotusと対面する時が来たら、勝てると思うか？",shape=box,color=blue];
		2500 -> 2501;
		2500 -> 2502;
		2500 -> 2503;
	2501 [label="バカバカしい。この会話はなしだ。",shape=box,color=red];
		2501 -> 2504;
	2502 [label="あっちは…　うーん、100人くらい？いる。こっちは一人だ、Roathe。",shape=box,color=red];
		2502 -> 2505;
	2503 [label="どこから始めたらいいんだ…",shape=box,color=red];
		2503 -> 2506;
	2504 [label="どうしてもと言うなら、くだらないゲームだと思えばいい！　理論と推測のゲームだ。",shape=box,color=blue];
		2504 -> 2507;
		2504 -> 2508;
	2505 [label="+5 Chemistry",color=orange];
		2505 -> 2509;
	2506 [label="目の前に「Tauの悪魔」がいて良かったな。我は名の知れた戦略家だ。まずは基本から始めよう：数だ。あまりにも分が悪い。",shape=box,color=blue];
		2506 -> 2510;
	2507 [label="これはゲームなんかじゃない。",shape=box,color=red];
		2507 -> 2511;
	2508 [label="これで最後だ。この話はなしだ。[閉じる]",shape=box,color=red];
		2508 -> 2512;
	2509 [label="素晴らしい。戦場で第一にする分析ができた：数だ。うむ。圧倒的に不利だな。",shape=box,color=blue];
		2509 -> 2510;
	2510 [label="Check boolean IsDating",color=orange];
		2510 -> 2513 [label=true,color=green];
		2510 -> 2514 [label=false,color=brown];
	2511 [label="そう、これはゲームではないのだ。いつか生死を分けるかもしれない。貴様対…　小さい貴様でな。野生児の群れもいるわけだ。",shape=box,color=blue];
		2511 -> 2515;
	2512 [label="Chat ends.",color=orange];
	2513 [label="しかし、もし貴様の「個人的な活動」や、他の時系列のPROTOFRAMEたちをなんらかの方法で召喚できれば、それらの軍資源を活用できるかもしれない。特殊なHelminthを研究し、育成する必要があるが…",shape=box,color=blue];
		2513 -> 2516;
	2514 [label="他の時系列のPROTOFRAMEたちの話は聞いている。なんらかの方法で召喚できれば、活用できるかもしれない。特殊なHelminthを研究し、育成する必要があるが…",shape=box,color=blue];
		2514 -> 2516;
	2515 [label="ちなみに、その野生児の群れは既にその暴力性が証明されている。自分たちの正常性に反するものは、同族であれど残酷に追い出すケースもある。",shape=box,color=blue];
		2515 -> 2517;
		2515 -> 2518;
		2515 -> 2519;
	2516 [label="可能かどうかもわからんが、そうやって我々はここへ参じた。不可能ではないと思うが…",shape=box,color=blue];
		2516 -> 2520;
		2516 -> 2521;
		2516 -> 2522;
	2517 [label="テンノたちが悪だって言いたいの？",shape=box,color=red];
		2517 -> 2523;
	2518 [label="何が言いたい？",shape=box,color=red];
		2518 -> 2524;
	2519 [label="この話は終わりだ。[閉じる]",shape=box,color=red];
		2519 -> 2525;
	2520 [label="地獄へ落ちろ、Roathe。",shape=box,color=red];
		2520 -> 2526;
	2521 [label="彼らをこの混乱に巻き込むつもりはない。",shape=box,color=red];
		2521 -> 2527;
	2522 [label="ここまで考えていたなんて、驚きだ。",shape=box,color=red];
		2522 -> 2528;
	2523 [label="いいや、悪ではない。我は「悪」という概念を信じていない。これまでも、これからも。テンノたちは皆と同様、素晴らしく美しい人間だ。ただの人間。そして、奴らは子供だ。",shape=box,color=blue];
		2523 -> 2529;
	2524 [label="最悪の日が訪れる可能性があって、自身の身を守る必要があるかもしれない。そう言っているのだ。",shape=box,color=blue];
		2524 -> 2530;
	2525 [label="逃げたければ逃げるといい。だが貴様はこれが真実だと理解している。ただ受け入れたくないだけだ。",shape=box,color=blue];
		2525 -> 2531;
	2526 [label="+5 Chemistry",color=orange];
		2526 -> 2532;
	2527 [label="ほう！　ここが混沌として乱れていることを認めるか！　これは大きな進歩だ。せめて意見だけ述べても良いだろうか？",shape=box,color=blue];
		2527 -> 2533;
		2527 -> 2534;
	2528 [label="そして我は貴様がまったく考えていなくて、驚きだ。せめて意見だけ述べても良いだろうか？",shape=box,color=blue];
		2528 -> 2533;
		2528 -> 2534;
	2529 [label="その子供たちは、残虐行為を義務付けられ、何百年もの鍛錬を耐え抜いたオロキン戦士たちを打ちのめしたものたちだ。",shape=box,color=blue];
		2529 -> 2535;
	2530 [label="テンノたちは皆と同様、素晴らしく美しい人間だ。ただの人間。そして、奴らは子供だ。",shape=box,color=blue];
		2530 -> 2529;
	2531 [label="Chat ends.",color=orange];
	2532 [label="既に地獄にいるのだ、簒奪者よ。既にな。",shape=box,color=blue];
		2532 -> 2536;
	2533 [label="わかったよ。話を聞くよ。",shape=box,color=red];
		2533 -> 2537;
	2534 [label="この話は終わりだ。",shape=box,color=red];
		2534 -> 2538;
	2535 [label="ダクスが…　黄金の、エリートダクスが！　テンノとWARFRAMEたちを前に神聖な黄金剣を手放し逃亡する様を見た。",shape=box,color=blue];
		2535 -> 2539;
	2536 [label="Update boolean RoatheNoDate",color=orange];
		2536 -> 2540;
	2537 [label="+5 Chemistry",color=orange];
		2537 -> 2541;
	2538 [label="そうか。",shape=box,color=blue];
		2538 -> 2540;
	2539 [label="感染体というマユは奴らの肉体を守りはしたが、心は守れなかった。奴らの現状は当然のことだ。",shape=box,color=blue];
		2539 -> 2542;
	2540 [label="Chat ends.",color=orange];
	2541 [label="感謝する。我が言いたいのは、最悪の日が訪れる可能性があって、自身の身を守る必要があるかもしれない。それだけだ。",shape=box,color=blue];
		2541 -> 2530;
	2542 [label="Voidに苦しめられ...　親の殺戮を強いられ、あるいは目撃し...　戦争に巻き込まれ…　記憶を奪われ...　何世紀も冷凍睡眠で歴史から消され…",shape=box,color=blue];
		2542 -> 2543;
	2543 [label="奴らの正気が保たれていることは奇跡の他ならないのだ、簒奪者。我は確実性の話をしているのではない。可能性の話をしているのだ。その可能性に備えて計画しろと申しているのだ。",shape=box,color=blue];
		2543 -> 2544;
	2544 [label="備えあれば憂いなしだ。",shape=box,color=blue];
		2544 -> 2545;
		2544 -> 2546;
		2544 -> 2547;
		2544 -> 2548;
	2545 [label="…用心しておく。それで満足か？　でも陰謀を働くつもりはない。",shape=box,color=red];
		2545 -> 2549;
	2546 [label="クソ。少し納得している自分にイライラする。",shape=box,color=red];
		2546 -> 2550;
	2547 [label="自分もテンノと同じくらい苦しんでいたんだけど。",shape=box,color=red];
		2547 -> 2551;
	2548 [label="彼らの信頼を裏切るわけにはいかない。",shape=box,color=red];
		2548 -> 2552;
	2549 [label="+5 Chemistry",color=orange];
		2549 -> 2553;
	2550 [label="+5 Chemistry",color=orange];
		2550 -> 2554;
	2551 [label="そうだな、そしてもしかしたら、我はこの会話を奴らともしているかもしれんな？",shape=box,color=blue];
		2551 -> 2555;
	2552 [label="そうしろとは一言も申していないぞ。",shape=box,color=blue];
		2552 -> 2556;
	2553 [label="もちろんだ！　悪魔が求めるのはそれだけだ。",shape=box,color=blue];
		2553 -> 2557;
	2554 [label="クク。長年の歳月を経て、ようやく正気を取り戻した感覚だ。そのうち慣れる。",shape=box,color=blue];
		2554 -> 2558;
	2555 [label="ゆっくり眠るといい、簒奪者。",shape=box,color=blue];
