	"Chat ends." [color=orange];
	j3430542801 [label="ボイスメール：犠牲",shape=box,color=blue];
		j3430542801 -> j1893926517;
	j1893926517 [label="Traivon。お前が乗るレールジャックをPraghasaの口に投げ込むのを見た。お前とその部下を貪欲に食らうのに気を取られ、Praghasaは我の船が逃げていくのに気づかなかった。",shape=box,color=blue];
		j1893926517 -> j2522850283;
	j2522850283 [label="お前は上官のために命を捧げた。お前の無私さは我の無力さを痛感させた。",shape=box,color=blue];
		j2522850283 -> j1819534831;
	j1819534831 [label="Maryna。お前は我に肉体を捧げた。あの塹壕で、我々は共にクバを飲んだ。手は震え、喉は裂け血が溢れていたが、飲み込めるだけの滴を残しておいた。",shape=box,color=blue];
		j1819534831 -> j3541985483;
	j3541985483 [label="お前の最後の敬礼を覚えている。途絶えるあの瞬間を。それから瞬きをして、お前のものだった目を開けると、泥の中に横たわる、内臓を抜かれた我の死体が見えた。",shape=box,color=blue];
		j3541985483 -> j2747524371;
	j2747524371 [label="Rostig。お前は失敗作のクローンだと、皆が言っていた。でなければ、グリニアが焼かれながらも戦い続ける理由がないと。ネズミでさえより優れた自己保存能力を持っていると。",shape=box,color=blue];
		j2747524371 -> j1652495682;
	j1652495682 [label="違う。お前の「欠陥」こそが、お前を奴らより優れた存在にしたのだ。",shape=box,color=blue];
		j1652495682 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}