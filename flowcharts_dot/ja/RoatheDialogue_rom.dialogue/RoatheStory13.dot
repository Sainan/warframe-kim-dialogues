	j2306186487 [label="ボイスメール：損傷",shape=box,color=blue];
		j2306186487 -> j4180976007;
	j4180976007 [label="損害は甚大だった。",shape=box,color=blue];
		j4180976007 -> j912454100;
	j912454100 [label="他の多くは現実逃避し、データを誤りだと、嘘だと、セファロンの陰謀だと決めつけ拒否した。",shape=box,color=blue];
		j912454100 -> j3735468569;
	j3735468569 [label="オロキンの謀略に溺れ、育ち、飽食していた彼らにとって、真実を拒絶するのは容易だった。",shape=box,color=blue];
		j3735468569 -> j2735503480;
	j2735503480 [label="その瞬間から、彼らは自分たちの安楽のために、幻想の中で生きるようになった。",shape=box,color=blue];
		j2735503480 -> j2879779266;
	j2879779266 [label="「我々は勝利した」「センティエントは撤退した」…そうでないと考える者は反逆者として扱われた。",shape=box,color=blue];
