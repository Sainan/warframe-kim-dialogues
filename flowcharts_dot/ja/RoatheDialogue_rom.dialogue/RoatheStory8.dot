	j1857182777 [label="ボイスメール：尊厳",shape=box,color=blue];
		j1857182777 -> j359882721;
	j359882721 [label="我々が戦争の惨禍をいかに尊大に扱うかを、旗持ちほど端的に表しているものはない。",shape=box,color=blue];
		j359882721 -> j569505616;
	j569505616 [label="彼らはいかなる犠牲を払ってでも守らねばならず…　彼らは疑いなく従わねばならない。",shape=box,color=blue];
		j569505616 -> j1953627328;
	j1953627328 [label="正気な兵士なら決して実行しないような命令を、誰が受けると？　簡単な話、さらに恐ろしい運命が待っていると脅せばいいのだ。",shape=box,color=blue];
		j1953627328 -> j1972777664;
	j1972777664 [label="実に滑稽だ。",shape=box,color=blue];
		j1972777664 -> j312620507;
	j312620507 [label="彼らの負傷した体は他と変わらない、だが我はいつも彼らの姿勢に目を配っていた。",shape=box,color=blue];
		j312620507 -> j2666173891;
	j2666173891 [label="彼が掲げる尊厳とオロキンの黄金、まだら模様の真紅こそが重要だった。",shape=box,color=blue];
		j2666173891 -> j3969794903;
	j3969794903 [label="我は戦場を去る際必ず、それが誇らしく立っていることを確認した。",shape=box,color=blue];
		j3969794903 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}