	j891324921 [label="ボイスメール：オロキン",shape=box,color=blue];
		j891324921 -> j3020512365;
	j3020512365 [label="長きにわたってオロキン帝国には外敵がいなかった。帝国の軍隊は、家と家の戦い、執行官と執行官の戦い、些細な恨みを晴らすためだけに存在していた。",shape=box,color=blue];
		j3020512365 -> j369943764;
	j369943764 [label="センティエントが襲来した時、我々は長らく拒絶されてきた結束を悟った。ダクスは、傲慢な平民やエセ商人ではなく、本物の敵に対して剣を抜いた。",shape=box,color=blue];
		j369943764 -> j884439350;
	j884439350 [label="執行官に権力を委ねられた、名ばかりの支配者である不死の皇帝たちは、埃被った黄金の玉座の上でよろめきながら目を覚ました。",shape=box,color=blue];
		j884439350 -> j323221796;
	j323221796 [label="戦争だ、素晴らしい戦争だ！　ついに帝国に意味が生じた。太陽の死よりも差し迫った絶滅を前に、我々は生を感じた。",shape=box,color=blue];
		j323221796 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}