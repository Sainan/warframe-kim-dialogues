		2149 -> 2150;
	2151 [label="Chat ends.",color=orange];
	2150 [label="長きにわたってオロキン帝国には外敵がいなかった。帝国の軍隊は、家と家の戦い、執行官と執行官の戦い、些細な恨みを晴らすためだけに存在していた。",shape=box,color=blue];
		2150 -> 2153;
	2153 [label="センティエントが襲来した時、我々は長らく拒絶されてきた結束を悟った。ダクスは、傲慢な平民やエセ商人ではなく、本物の敵に対して剣を抜いた。",shape=box,color=blue];
		2153 -> 2154;
	2154 [label="執行官に権力を委ねられた、名ばかりの支配者である不死の皇帝たちは、埃被った黄金の玉座の上でよろめきながら目を覚ました。",shape=box,color=blue];
		2154 -> 5683;
	5683 [label="戦争だ、素晴らしい戦争だ！　ついに帝国に意味が生じた。太陽の死よりも差し迫った絶滅を前に、我々は生を感じた。",shape=box,color=blue];
		5683 -> 2152;
