digraph {
	2564 [label="RoatheRank4Convo4 begins.",color=orange];
		2564 -> 2565;
	2565 [label="簒奪者よ、哲学的な質問がある。結論を急ぐ前に言っておくが、これは我でも、Ballasでも、Albrechtの話でもない。一種の心理テストだ。一緒にどうだ？",shape=box,color=blue];
		2565 -> 2566;
