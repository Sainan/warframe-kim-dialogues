	2574 [label="Chat ends.",color=orange];
	2575 [label="BallasとMargulisの話の後にこれを聞いておいて、Ballasの話じゃないって？",shape=box,color=red];
		2575 -> 2581;
	2578 [label="Albrechtにあれだけのことをされて、「オロキンは許されるのか？」と聞かれて、Albrechtの話じゃないって？",shape=box,color=red];
		2578 -> 2581;
	2579 [label="話に乗るよ。「全ての人は愛されるに値するか？」だって？　明らかに道徳と価値観に関する問題だ。",shape=box,color=red];
		2579 -> 2582;
	2576 [label="恋をしたことがないオロキンがこの質問して、Roatheのことじゃないって？",shape=box,color=red];
		2576 -> 2581;
	2577 [label="執行官の側室で、その彼女を裏切ろうと企んだオロキンがこれを聞いて、Roatheのことじゃないって？",shape=box,color=red];
		2577 -> 2581;
	2580 [label="これが本当に単なる哲学的な質問だと信じろと？",shape=box,color=red];
		2580 -> 2581;
	2581 [label="細かいことにこだわりたくない、些細なことに固執してしまう。「この人はこうして、この人はああした、だからこれが否定される」。それではこのテストを進められない。",shape=box,color=blue];
		2581 -> 2583;
