	2638 [label="+5 Chemistry",color=orange];
		2638 -> 2642;
	2639 [label="+5 Chemistry",color=orange];
		2639 -> 2643;
	2640 [label="まるで狂信者たちみたいな口振りだな。「償い」か。だが真実に近いものを感じる。愛と悪は同時に存在し得ない、そうであろう？　愛と悪は社会に共存し得ない。",shape=box,color=blue];
		2640 -> 2644;
	2641 [label="近いが、満点ではない。間違ってはいないが、もう少し掘り下げようか。悪事を働くものが他人に愛されるというのは、一体何を意味するのだろうか？　それは社会にどのような影響を与えるのだろうか？",shape=box,color=blue];
		2641 -> 2644;
	2642 [label="その通りだ！　この二つの要素は我らの心の中で共存を拒む。BallasとMargulisの話をした時、彼らの愛が本物であったと受け入れるのは困難だった、違うか？",shape=box,color=blue];
		2642 -> 2645;
	2643 [label="その通りだ！　この二つの要素は我らの心の中で共存を拒む。もしBallasとMargulisがかつて、事態が悪化するまで本当に愛し合っていたと伝えたら、その話を信じるか？",shape=box,color=blue];
		2643 -> 2645;
	2644 [label="Check boolean RoatheMargulis1",color=orange];
		2644 -> 2646 [label=true,color=green];
		2644 -> 2647 [label=false,color=brown];
	2645 [label="詳細に触れ、我が課したこのテストのルールに反する前に、それらは我ら二人にとって共通する参照点とだけ伝えておこう。",shape=box,color=blue];
		2645 -> 2648;
	2646 [label="BallasとMargulisの話をした時、彼らの愛が本物であったと受け入れるのは困難だった、違うか？",shape=box,color=blue];
		2646 -> 2645;
	2647 [label="もしBallasとMargulisがかつて、事態が悪化するまで本当に愛し合っていたと伝えたら、その話を信じるか？",shape=box,color=blue];
		2647 -> 2645;
	2648 [label="Ballasが人類史上最も残酷な行いをしたことは間違いない。それでも、奴は愛を知っていた。相互的な愛を。",shape=box,color=blue];
		2648 -> 2649;
	2649 [label="貴様は否定するだろうが、BallasとMargulisは心の奥から互いを愛していたのだ。ただ、結末が酷すぎた。",shape=box,color=blue];
		2649 -> 2650;
	2650 [label="Update boolean RoatheMargulis1",color=orange];
		2650 -> 2651;
	2651 [label="だが我々はその話から奴らの愛を消し去る必要がある。愛など存在しなかったと。現実ではなく、誤りだったと。それは何故か？",shape=box,color=blue];
		2651 -> 2652;
		2651 -> 2653;
		2651 -> 2654;
	2652 [label="わからない。",shape=box,color=red];
		2652 -> 2655;
	2653 [label="愛が人間の究極な感情だから。誰であろうと、愛されることができるなら、それに人間性を与えてしまう。",shape=box,color=red];
		2653 -> 2656;
	2654 [label="悪は己を振り返り、自身を変えようと努力しなければならないから。罰を受ける必要があるから。そして愛し愛されることが究極の報酬だから。",shape=box,color=red];
		2654 -> 2657;
	2655 [label="我の努力をこうも無駄にするか。残念だ。",shape=box,color=blue];
		2655 -> 2658;
