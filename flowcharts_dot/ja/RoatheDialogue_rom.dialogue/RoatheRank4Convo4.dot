		2596 -> 2598;
	2597 [label="我の見解はこうだ：これらの存在が道徳的に追放される理由は、彼らを道徳的に追放する相手がいるからだ。",shape=box,color=blue];
		2597 -> 2599;
	2598 [label="Add -1 to Thermostat",color=orange];
		2598 -> 2600;
		2598 -> 2601;
	2599 [label="他に誰もいない無の中で「悪行」を犯しても、それを悪と判断するものは誰もいない、違うか？",shape=box,color=blue];
		2599 -> 2602;
	2600 [label="だって…",shape=box,color=red];
		2600 -> 2603;
	2601 [label="ごめん。",shape=box,color=red];
		2601 -> 2603;
	2602 [label="蛮人が森を焼き払い、それを聞く人がいなければ、それに音はあるのか？　「善」と「悪」を判断する唯一の基準は、他人によるものだ。",shape=box,color=blue];
		2602 -> 2604;
		2602 -> 2605;
		2602 -> 2606;
	2603 [label="まあいい、出てしまったものは仕方ない。そう、悪魔！　究極の悪！",shape=box,color=blue];
		2603 -> 2597;
	2604 [label="それ自体が悪である行為もあるはずだ。",shape=box,color=red];
		2604 -> 2607;
	2605 [label="つまり、他人なしでは「悪」になれないと？",shape=box,color=red];
		2605 -> 2608;
	2606 [label="それはどうだろうか。",shape=box,color=red];
		2606 -> 2607;
	2607 [label="人間が犯す最も恐ろしい行為は、それを判断するもう一人の人間が必要になる。無の中でなにをしても、非難されることなどない。無人の惑星を破壊しても、それを悪と判断するものがいなければ話はそれで終わりだ。",shape=box,color=blue];
		2607 -> 2609;
	2608 [label="そうだ、考えてみろ。人間が犯す最も恐ろしい行為は、それを判断するもう一人の人間が必要になる。無の中でなにをしても、非難されることなどない。無人の惑星を破壊しても、それを悪と判断するものがいなければ話はそれで終わりだ。",shape=box,color=blue];
		2608 -> 2609;
	2609 [label="社会がそれを非難し「それは禁止事項だ」と言わない限り、その行いが恐ろしいものだとどう理解するのだ？　不可能だ。",shape=box,color=blue];
		2609 -> 2610;
	2610 [label="先程も言ったが、それは社会が人々の行動と比較して判断するために使う尺度に過ぎない。",shape=box,color=blue];
		2610 -> 2611;
		2610 -> 2612;
	2611 [label="仮にそれが正解だとしよう。自分がこれに納得したとしよう。善と悪が…　社会的概念でしかないと。それで？",shape=box,color=red];
		2611 -> 2613;
	2612 [label="社会概念の外でも善と悪は存在すると思う。だってそうだろう、多くの異なる社会が存在して、価値観がこれだけ似通っているんだから。",shape=box,color=red];
		2612 -> 2614;
	2613 [label="Add -1 to Thermostat",color=orange];
		2613 -> 2615;
	2614 [label="Add 1 to Thermostat",color=orange];
		2614 -> 2616;
		2614 -> 2617;
	2615 [label="+5 Chemistry",color=orange];
		2615 -> 2618;
	2616 [label="でもまあ、せっかくだし話を続けよう。",shape=box,color=red];
		2616 -> 2615;
	2617 [label="話はここまでにしよう。うまく終われる自信がない。[閉じる]",shape=box,color=red];
		2617 -> 2619;
	2618 [label="よろしい。「悪」は存在ではなく社会的概念であると定義するなら、大悪党の物語、つまり寓話も全て社会的概念ということだ。",shape=box,color=blue];
		2618 -> 2620;
	2619 [label="好きにしろ。",shape=box,color=blue];
		2619 -> 2621;
	2620 [label="なら、何故これらの寓話では、極悪人は孤独なのだろうか？",shape=box,color=blue];
		2620 -> 2622;
		2620 -> 2623;
		2620 -> 2624;
		2620 -> 2625;
	2621 [label="Chat ends.",color=orange];
	2622 [label="愛することができないから？",shape=box,color=red];
		2622 -> 2626;
	2623 [label="愛を受け入れる心の余地がないから？",shape=box,color=red];
		2623 -> 2627;
	2624 [label="愛されるに値しないから？",shape=box,color=red];
		2624 -> 2628;
	2625 [label="教訓を与えるため？",shape=box,color=red];
		2625 -> 2629;
	2626 [label="そういうケースもあるな。それは非人間的な悪として描かれ、愛を知らない存在とされる。だが何故だ？　あらゆる偉大な寓話は教訓を与えるために存在するのではないのか？",shape=box,color=blue];
		2626 -> 2630;
	2627 [label="そういうケースもあるな。時にそれは強大な悪に心を奪われすぎて、「些細なこと」で自身を卑下する余裕がないように描かれる。だが何故だ？　あらゆる偉大な寓話は教訓を与えるために存在するのではないのか？",shape=box,color=blue];
		2627 -> 2630;
	2628 [label="我の言葉を繰り返しているだけだ、簒奪者よ。「値する」というのは相対的なものだと既に定義された。考えてみろ。あらゆる偉大な寓話は教訓を与えるために存在するのではないのか？",shape=box,color=blue];
		2628 -> 2630;
	2629 [label="+5 Chemistry",color=orange];
		2629 -> 2631;
	2630 [label="もしその強大な悪が平和に、幸せに、素晴らしい愛を持つものとして描かれたら…　それが与える教訓などあるのだろうか？",shape=box,color=blue];
		2630 -> 2632;
		2630 -> 2633;
		2630 -> 2634;
	2631 [label="我の理論と一致するな！　あらゆる偉大な寓話は教訓を与えるために存在するのではないのか？",shape=box,color=blue];
		2631 -> 2630;
	2632 [label="「悪」でありながら愛することもできるなんて…　矛盾に聞こえる。",shape=box,color=red];
		2632 -> 2635;
	2633 [label="「悪行」は愛によって償える、かな？",shape=box,color=red];
		2633 -> 2636;
	2634 [label="「悪行」を犯す人でも、誰かにとって大切な人かもしれない、よって「純粋な悪」ではない、かな？",shape=box,color=red];
		2634 -> 2637;
	2635 [label="Check boolean RoatheMargulis1",color=orange];
