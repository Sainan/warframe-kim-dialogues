		2656 -> 2659;
	2657 [label="Add 2 to Thermostat",color=orange];
		2657 -> 2660;
	2658 [label="Chat ends.",color=orange];
	2659 [label="素晴らしい、簒奪者よ。まさにその通りだ。強大な悪は「対極」であり、同情してはならない。愛し愛されることを許してしまったら、我々が知る世界は崩壊するであろう。",shape=box,color=blue];
		2659 -> 2661;
	2660 [label="素晴らしい、簒奪者よ。まさにその通りだ。強大な悪には罪の代償を払う必要がある。愛し愛されることを許してしまったら、我々が知る世界は崩壊するであろう。",shape=box,color=blue];
		2660 -> 2661;
	2661 [label="Update boolean RoatheUnloved3",color=orange];
