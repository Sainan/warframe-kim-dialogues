	2582 [label="+5 Chemistry",color=orange];
		2582 -> 2585;
	2583 [label="はっきり言うか、黙るかのどっちかにしてくれ。誰のことか教える気がないなら、この話は時間の無駄だ。",shape=box,color=red];
		2583 -> 2586;
	2584 [label="わかったよ。「テスト」に付き合うよ。",shape=box,color=red];
		2584 -> 2587;
	2585 [label="素晴らしい！　このテストから名前を取り除いたほうが好ましい。さもないと細かいことにこだわりすぎて、話が進まなくなるからな。",shape=box,color=blue];
		2585 -> 2588;
	2586 [label="ではユウイギな時間を過ごすといい。",shape=box,color=blue];
		2586 -> 2589;
	2587 [label="よろしい。ではもう一度：「全ての人は愛されるに値するか？」",shape=box,color=blue];
		2587 -> 2590;
	2588 [label="そして、その通りだ。正義のヒーローが愛し愛されることを、誰も疑問に思わない。寓話などでそれが議論されることはないであろう？",shape=box,color=blue];
		2588 -> 2591;
	2589 [label="Update boolean RoatheNoDate",color=orange];
		2589 -> 2592;
	2590 [label="正義のヒーローが愛し愛されることを、誰も疑問に思わない。寓話などでそれが議論されることはないであろう？",shape=box,color=blue];
		2590 -> 2591;
	2591 [label="卑怯者。悪党。怪物。道徳心のない世界の破壊者のみに値する質問だ。",shape=box,color=blue];
		2591 -> 2593;
		2591 -> 2594;
