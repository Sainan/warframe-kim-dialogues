	j1882431958 [label="堂々巡りはもう十分だ。本題に移ろう：いかなる形であれ、「神」の存在を消せると思うか？",shape=box,color=blue];
		j1882431958 -> j4196803035;
	j1350014311 [label="確かに「我々の理解を超えた、恐るべき異様」では、毎回打つのに骨が折れるな。では、本題に移ろうか：",shape=box,color=blue];
		j1350014311 -> j4196803035;
	j1630809935 [label="ソレを何と呼ぼうと、ソレを打ち負かすことはできないと信じ、いずれ飲み込まれることを受け入れるかだ。",shape=box,color=blue];
