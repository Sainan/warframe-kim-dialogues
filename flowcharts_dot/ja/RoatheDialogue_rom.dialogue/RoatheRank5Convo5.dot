	j931402163 [label="「無関心のモノ」について、もう少し考えてみたか？",shape=box,color=blue];
		j931402163 -> j2805089058;
		j931402163 -> j3959951762;
		j931402163 -> j2450156146;
		j931402163 -> j900715504;
	j2805089058 [label="考えてみた。Albrecht EntratiがVoidから解き放ったモノは、太古から存在する形のない神だ。",shape=box,color=red];
		j2805089058 -> j970585975;
	j3959951762 [label="考えてみた。Roatheのクソみたいな意見はもう聞きたくない。",shape=box,color=red];
		j3959951762 -> j4099310853;
	j2450156146 [label="考えてみた。多分Roatheは正しい。アレはAlbrechtが接触するまで存在してなかった。Albrechtは神を求めた…　だからVoidはその概念を模したものを吐き出した。",shape=box,color=red];
		j2450156146 -> j2836638645;
	j900715504 [label="考えてみた。多分アレは、元々神ではなかったけど、今は神の存在だ。AlbrechtがVoidを切り開いた時に存在し始めたんだと思う。",shape=box,color=red];
		j900715504 -> j499780215;
	j970585975 [label="アレは自分たちが何なのか理解していない。",shape=box,color=red];
		j970585975 -> j2198236363;
	j4099310853 [label="Check boolean RoatheDating",color=orange];
		j4099310853 -> j1532679733 [label=true,color=green];
		j4099310853 -> j353002844 [label=false,color=brown];
	j2836638645 [label="そしてそれ以来、自分たちはソレに恐怖を与え続けていた。",shape=box,color=red];
		j2836638645 -> j2596150272;
	j499780215 [label="Rellみたいなものだ。存在していて、存在していない。無関心のモノは神ではなかったけど、今はそうであると定着している。",shape=box,color=red];
		j499780215 -> j3668524097;
	j2198236363 [label="我の言い分をもう一度考えるよう説得できないか？　それともその意見は定着したものなのか？",shape=box,color=blue];
		j2198236363 -> j2086764132;
		j2198236363 -> j3777997673;
	j1532679733 [label="これほど繊細な地雷を抱えていたとはな。狂信者どもの言葉を借りれば、「c'est la vie」か。",shape=box,color=blue];
		j1532679733 -> j650387292;
	j353002844 [label="そうか。狂信者どもの言葉を借りれば、「c'est la vie」か。",shape=box,color=blue];
		j353002844 -> "Chat ends.";
	j2596150272 [label="Boolean DrifterMITWNotGod is now true.",color=orange];
		j2596150272 -> j1220678863;
	j3668524097 [label="お前のような永遠主義理論派は嫌いだ。それで何でも説明しようとしる。アルキメデスは一度理解したと思うと、その考えに固定してしまう。",shape=box,color=blue];
		j3668524097 -> j2261777561;
	j2086764132 [label="話は聞こう。",shape=box,color=red];
		j2086764132 -> j1229621180;
	j3777997673 [label="考えを改める気はない。",shape=box,color=red];
		j3777997673 -> j353002844;
	j650387292 [label="Boolean RoatheNoDate is now true.",color=orange];
		j650387292 -> j776748929;
	j1220678863 [label="+5 Chemistry",color=orange];
		j1220678863 -> j3976618634;
	j2261777561 [label="「オフィスの植物に水をあげるのを忘れたわけじゃない。ただ、並行して別の永遠主義理論を経験しているだけ。」",shape=box,color=blue];
		j2261777561 -> j90764064;
	j1229621180 [label="今日のお前はあまり哲学的ではなさそうだが、試してみよう。",shape=box,color=blue];
		j1229621180 -> j4279022238;
	j776748929 [label="Boolean RoatheDating is now false.",color=orange];
		j776748929 -> j178902881;
	j3976618634 [label="素晴らしい！　ようやく進歩が遂げられた。笛を鳴らせ、鐘を鳴らせ、ついに誰かが正気を取り戻した！",shape=box,color=blue];
		j3976618634 -> j4290145;
	j90764064 [label="叫びたくなる。この惨めな人生の中で、一度くらい何かに真剣に取り組んでみたらどうだ？！",shape=box,color=blue];
		j90764064 -> j574740413;
		j90764064 -> j4199208787;
	j4279022238 [label="他にやることもないのだからな。",shape=box,color=blue];
		j4279022238 -> j795752605;
	j178902881 [label="Boolean IsDating is now false.",color=orange];
		j178902881 -> "Chat ends.";
	j4290145 [label="Check boolean RoatheDating",color=orange];
		j4290145 -> j3201910489 [label=true,color=green];
		j4290145 -> j1187347869 [label=false,color=brown];
	j574740413 [label="自分はただ、アレは元々神じゃなくて、今はそうだと言いたいんだ。",shape=box,color=red];
		j574740413 -> j2871590273;
	j4199208787 [label="もうやめにしよう。",shape=box,color=red];
		j4199208787 -> j3895492302;
	j795752605 [label="振り出しから始めよう。お前にとって「神」とは何か？　それをどう定義する？",shape=box,color=blue];
		j795752605 -> j2482456540;
		j795752605 -> j2012901159;
		j795752605 -> j3883721787;
	j3201910489 [label="だがお前なら考えを改めてくれると信じていたぞ、最愛の漂流者よ。お前の目は確かみたいだ。",shape=box,color=blue];
		j3201910489 -> j136117146;
	j1187347869 [label="だがお前なら考えを改めてくれると信じていたぞ、漂流者よ。なにせ我は説得力に長けているからな。",shape=box,color=blue];
		j1187347869 -> j136117146;
	j2871590273 [label="なるほど。AlbrechtによってVoidから「神」になったと。そしてそその「神」が暴れ回っていると。可愛らしい理論だ。",shape=box,color=blue];
		j2871590273 -> j3146062327;
		j2871590273 -> j101002063;
	j3895492302 [label="そうだな。",shape=box,color=blue];
		j3895492302 -> "Chat ends.";
	j2482456540 [label="至高の存在。絶対的かつ疑いの余地のない権威や力を持つもの。 ",shape=box,color=red];
		j2482456540 -> j2236128706;
	j2012901159 [label="創造する力や、特定の側面で人間の運命を影響する力を持つ、超人的な存在または生き物。",shape=box,color=red];
		j2012901159 -> j1778056731;
	j3883721787 [label="わからない。先に言ってみて。",shape=box,color=red];
		j3883721787 -> j1738663806;
	j136117146 [label="さて、後はどうやって残りの狂人どもを説得するかだな…",shape=box,color=blue];
		j136117146 -> j1099925923;
		j136117146 -> j2980604347;
	j3146062327 [label="その通りだ。",shape=box,color=red];
		j3146062327 -> j3857215393;
	j101002063 [label="そうだ。でもどうやら自分たちは「神」とは何なのか、定義が決まっていないみたいだ。",shape=box,color=red];
		j101002063 -> j3532525622;
	j2236128706 [label="そしてお前は無関心のモノを至高の存在と信じていると？",shape=box,color=blue];
		j2236128706 -> j2493001751;
		j2236128706 -> j3221880725;
	j1778056731 [label="そしてこの無関心のモノは至高の存在か生き物であると？　そしてそれが影響するのは、感情の皆無、無関心、だと？",shape=box,color=blue];
		j1778056731 -> j3221880725;
		j1778056731 -> j2493001751;
	j1738663806 [label="どうやら臆病なのは貴様も同じようだ。まあいい。話を単純化し、本題に移るとしよう：",shape=box,color=blue];
		j1738663806 -> j4196803035;
	j1099925923 [label="理解できないのが、そうして何の得がある？",shape=box,color=red];
		j1099925923 -> j3159383337;
	j2980604347 [label="説得する意味があるの？",shape=box,color=red];
		j2980604347 -> j2339466806;
	j3857215393 [label="なら話を単純化して本題に移ろうか。お前は「神」に死があると信じているか？",shape=box,color=blue];
		j3857215393 -> j554848394;
	j3532525622 [label="そうだな。では、お前は「神」をどう定義する？",shape=box,color=blue];
		j3532525622 -> j3399639064;
		j3532525622 -> j1639144453;
		j3532525622 -> j1549899969;
	j2493001751 [label="確かではない。",shape=box,color=red];
		j2493001751 -> j3614791575;
	j3221880725 [label="そう信じている。",shape=box,color=red];
		j3221880725 -> j3323216182;
	j4196803035 [label="「神」に死はあると思うか？",shape=box,color=blue];
		j4196803035 -> j4003029057;
		j4196803035 -> j4204040853;
		j4196803035 -> j1912828318;
		j4196803035 -> j3927314332;
		j4196803035 -> j516955411;
	j3159383337 [label="得だと？　得しかないであろう！　だが確かに、お前は常に一人で戦ってきた。軍勢の戦い方を知らないのだな。",shape=box,color=blue];
		j3159383337 -> j3587047001;
	j2339466806 [label="意味だと？　なんと可愛らしい。だが確かに、お前は常に一人で戦ってきた。軍勢の戦い方を知らないのだな。",shape=box,color=blue];
		j2339466806 -> j3587047001;
	j554848394 [label="いかなる形であれ、「神」の存在を消せると思うか？",shape=box,color=blue];
		j554848394 -> j4196803035;
	j3399639064 [label="わからない。先に言ってみて。",shape=box,color=red];
		j3399639064 -> j3698485238;
	j1639144453 [label="創造する力や、特定の側面で人間の運命を影響する力を持つ、超人的な存在または生き物。",shape=box,color=red];
		j1639144453 -> j1643981084;
	j1549899969 [label="人類の理解を超えた存在。自分たちとは別の次元に存在するもの。つまり「時分たちのように」存在しないもの。",shape=box,color=red];
		j1549899969 -> j2078624983;
