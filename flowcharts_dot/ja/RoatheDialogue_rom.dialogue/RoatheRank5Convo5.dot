		j295587720 -> j1657696125;
	j4091275697 [label="これまで精一杯の議論を尽くしてきたが、それらが全て無駄になってしまうのではないかと不安になってきた。だから最後にもう一度だけ聞く。どうか我の正気を保ってくれ。",shape=box,color=blue];
		j4091275697 -> j2519524741;
