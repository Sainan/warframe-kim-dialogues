		j3323216182 -> j1373687875 [label=true,color=green];
		j3323216182 -> j2549926984 [label=false,color=brown];
	j4003029057 [label="できれば、元の場所へ送り返したい。",shape=box,color=red];
		j4003029057 -> j3093516836;
	j4204040853 [label="わからないし、誰も知らないと思う。",shape=box,color=red];
		j4204040853 -> j3063452803;
	j1912828318 [label="死ねないと思う。物質の持続性とか、なんとか。",shape=box,color=red];
		j1912828318 -> j1013344683;
	j3927314332 [label="死ねると思う。じゃないと、圧倒されちゃうしね？",shape=box,color=red];
		j3927314332 -> j3624851388;
	j516955411 [label="心からそう願ってる。",shape=box,color=red];
		j516955411 -> j4291166651;
	j3587047001 [label="まず、敵を知ることが鍵だ。ここで一つ質問がある。アレを殺せると思うか？",shape=box,color=blue];
		j3587047001 -> j376834572;
		j3587047001 -> j1748843302;
		j3587047001 -> j3755595423;
	j3698485238 [label="どうやら臆病なのは貴様も同じようだ。まあいい。話を単純化し、本題に移るとしよう：",shape=box,color=blue];
		j3698485238 -> j554848394;
	j1643981084 [label="そしてこの無関心のモノは至高の存在か生き物であると？　そしてそれが影響するのは、感情の皆無、無関心、だと？",shape=box,color=blue];
		j1643981084 -> j3038612733;
		j1643981084 -> j2023073261;
	j2078624983 [label="なるほど、そこが対立点か。いかにも、我らの定義は異なるようだ。「無関心のモノ」が貴様の言うように存在するものという点は、同意するが。",shape=box,color=blue];
		j2078624983 -> j3990847845;
	j1373687875 [label="残念だ。お前はもっと賢いと信じていたのだがな。では次の質問で本題に入るとしよう：",shape=box,color=blue];
		j1373687875 -> j4196803035;
	j2549926984 [label="残念だ。では次の質問で本題に入るとしよう：",shape=box,color=blue];
		j2549926984 -> j4196803035;
	j3093516836 [label="平和主義者が…　何故いつも平和主義者がいるのだ。",shape=box,color=blue];
		j3093516836 -> j291299665;
	j3063452803 [label="したがって、お前はそのささやかな無知から、我々全員が暗闇の中で手探りで進んでいると示唆しているのだな。",shape=box,color=blue];
		j3063452803 -> j2996664506;
	j1013344683 [label="これはまいった。「神」は死ねないと考えているとは！",shape=box,color=blue];
		j1013344683 -> j291299665;
	j3624851388 [label="その理屈で行くと…　お前は「神」がポバーみたいなものだから…　死ねると？",shape=box,color=blue];
		j3624851388 -> j2645284561;
	j4291166651 [label="当たり前のことを言ってどうする。話をよく聞け。集中しろ。",shape=box,color=blue];
		j4291166651 -> j2645284561;
	j376834572 [label="正直、わからない。",shape=box,color=red];
		j376834572 -> j656721644;
	j1748843302 [label="万物のものは殺せる。無関心のモノも例外じゃない。どうにかして殺す。",shape=box,color=red];
		j1748843302 -> j294557042;
	j3755595423 [label="殺せないかもだけど、止められないわけじゃない。",shape=box,color=red];
		j3755595423 -> j2116197110;
	j3038612733 [label="そう信じている。",shape=box,color=red];
		j3038612733 -> j1882431958;
	j2023073261 [label="確かではない。",shape=box,color=red];
		j2023073261 -> j1882431958;
	j3990847845 [label="我々はソレの速記用語に合意していなかったようだ。面白い発見だ。",shape=box,color=blue];
		j3990847845 -> j1350014311;
	j291299665 [label="お前には二つの選択肢しかない。ソレが死ねると信じ、「神」ではないと信じるか、",shape=box,color=blue];
		j291299665 -> j1630809935;
	j2996664506 [label="「神」、つまり「無関心のモノ」が死ねるかどうか誰も分からないまま、なぜ我々はそれに抗おうとしているのだ？",shape=box,color=blue];
		j2996664506 -> j291299665;
	j2645284561 [label="…我は馬鹿と話しているのか？",shape=box,color=blue];
