	j4290874667 [label="Boolean RoatheWeaponSniper is now true.",color=orange];
		j4290874667 -> j1009258265;
		j4290874667 -> j3008476629;
		j4290874667 -> j3339613653;
	j3609398078 [label="Boolean RoatheWeaponPoison is now true.",color=orange];
		j3609398078 -> j1009258265;
		j3609398078 -> j3008476629;
		j3609398078 -> j3339613653;
	j4110631672 [label="事実だからだ。貴様も理解しているであろう。実際、貴様という存在の大半は、いかにして殺しに芸術を見出すかだ！",shape=box,color=blue];
		j4110631672 -> j1999737785;
	j2995208375 [label="ほう？　誠か？　では掘り下げてみようか。",shape=box,color=blue];
		j2995208375 -> j2490298025;
	j3928511048 [label="最近好みに変化があった。そのことで気にかけている。",shape=box,color=blue];
		j3928511048 -> j110542751;
		j3928511048 -> j827949309;
	j1999737785 [label="テンノと、間接的に貴様が操る「フォーカス道」を見てみろ。ダクスの教えもある。何度制限しようと、彼らは通信上での説教と指導を止めなかった。",shape=box,color=blue];
		j1999737785 -> j2837905866;
	j2490298025 [label="一つ、正直に答えてほしい。今嘘をつくのは、我と、特に貴様に酷い仕打ちをすることとなる。では：",shape=box,color=blue];
		j2490298025 -> j981642489;
	j110542751 [label="変わったって、どんな風に？",shape=box,color=red];
		j110542751 -> j3426182628;
	j827949309 [label="Urielの影響で？",shape=box,color=red];
		j827949309 -> j2445090386;
	j2837905866 [label="二度と「我が身は刃」や「我が身は戦いのためにある」などの戯言を聞かずに済むなら、我は幸せものだ、簒奪者よ。",shape=box,color=blue];
		j2837905866 -> j737225034;
	j981642489 [label="自身の好みに合わせて武器やWARFRAMEをカスタマイズしたいと思ったことはあるか？　個性的な色合いや、気分に合わせた外装にこだわりたいと？",shape=box,color=blue];
		j981642489 -> j4175991446;
		j981642489 -> j1524384453;
		j981642489 -> j2980800474;
	j3426182628 [label="かつて我は剣を武器として愛用した。優雅で、素早く、戦場を駆け抜けながら手の届く敵を切り裂くことができた。真紅に染まる銀の刃。それは青い星の下で煌めいていた。",shape=box,color=blue];
		j3426182628 -> j807601781;
	j2445090386 [label="それもあるだろう。あるいは失った記憶が関係しているのかもしれない。他に思い当たる理由がない。",shape=box,color=blue];
		j2445090386 -> j3426182628;
	j737225034 [label="人類は古来より「殺人」を罪と捉えているが、「殺し」を芸術と捉えている。奇妙ではないか？　戦闘で剣を振り敵を倒すということは、時に神聖なものとみなされた。",shape=box,color=blue];
		j737225034 -> j1507147692;
	j4175991446 [label="あるけど…　それと殺人に何の関係が？",shape=box,color=red];
		j4175991446 -> j1912666236;
	j1524384453 [label="ない。一度も。",shape=box,color=red];
		j1524384453 -> j2296638730;
	j2980800474 [label="付き合ってられない。[閉じる]",shape=box,color=red];
		j2980800474 -> j580142726;
	j807601781 [label="だが今はどうだ？　歯についた血を味わいたい。爪の下から血がほとばしるのを感じたい。指を肉と骨に深く食い込ませ、引き裂きたい。",shape=box,color=blue];
		j807601781 -> j793831689;
	j1507147692 [label="なのに路地裏で、尖った金属で人を殺害することは卑怯であり極悪とされる。",shape=box,color=blue];
		j1507147692 -> j3628851518;
	j1912666236 [label="正直なのは良いことだ。さて、先程の証言通り、貴様が冷酷な殺人を好まず、罪のない命を奪うことを拒むと言う体で話を進めよう（先程の発言が嘘である可能性もあるがな。それはそれで愉快な発見になる。だが今はそれを議論する時ではない）。",shape=box,color=blue];
		j1912666236 -> j3146071102;
	j2296638730 [label="ゆっくり、よく考えてみろ。貴様のテンノ同胞たちが、まるで悪夢から生まれた色とりどりのサーカスみたいな外装でここを走り回るのを見た。野生動物が染具にでも落ちたかのような色合いをしたものも。",shape=box,color=blue];
		j2296638730 -> j2224645085;
	j580142726 [label="いいだろう。",shape=box,color=blue];
		j580142726 -> "Chat ends.";
	j793831689 [label="腱が切れ、肉と血の破片と化すのを感じながら、その血漿を深く飲み干したい。甘い果実のように、流れ出る髄を剥がしてやりたい。",shape=box,color=blue];
		j793831689 -> j4016751666;
		j793831689 -> j285770688;
	j3628851518 [label="それに何の違いがあると言うのだ？　「名誉」か？　名誉の有無を決めるのは誰なのだ？　敗者か？　勝者か？　それとも伝統なのか？",shape=box,color=blue];
		j3628851518 -> j1329013668;
		j3628851518 -> j2962881651;
		j3628851518 -> j1185055057;
	j3146071102 [label="貴様が言ったように、これまでの殺しは「強制」されたものだとして、何故殺戮兵器を自分好みの外装に改造することに時間を費やすのだ？",shape=box,color=blue];
		j3146071102 -> j3134578611;
	j2224645085 [label="貴様もそうしようと思ったことがないと？　一度もか？　そう認めたからといって、軽蔑しないと誓おう。",shape=box,color=blue];
		j2224645085 -> j174547921;
		j2224645085 -> j2299713365;
	j4016751666 [label="Roathe？",shape=box,color=red];
		j4016751666 -> j4026719640;
	j285770688 [label="それって…　普通？",shape=box,color=red];
		j285770688 -> j3042454165;
	j1329013668 [label="確かに、境界線は曖昧だ。",shape=box,color=red];
		j1329013668 -> j583031354;
	j2962881651 [label="一方は鍛錬と献身を必要とする。もう一方は…　ただの残虐行為だ。",shape=box,color=red];
		j2962881651 -> j4151656313;
	j1185055057 [label="この会話は終わりだ。[閉じる]",shape=box,color=red];
		j1185055057 -> j580142726;
	j3134578611 [label="死が蔓延する戦場で、何故容姿を気にする？　死体を見分けるためか？　違うな。貴様を見間違えることはない。それは貴様が、殺人を強制されるなら、粋な方法でしたいと感じているからだ。",shape=box,color=blue];
		j3134578611 -> j951948996;
	j174547921 [label="ない。",shape=box,color=red];
		j174547921 -> j580142726;
	j2299713365 [label="わかったよ。ある。どうして？",shape=box,color=red];
		j2299713365 -> j1912666236;
	j4026719640 [label="わかっている！　そのおぞましさを十分理解している。念のため言っておくが、我はそんなことはしない。この場所を焼き尽くすつもりもない。どれだけ魅力的と感じてもな。",shape=box,color=blue];
		j4026719640 -> j3930919352;
	j3042454165 [label="普通ではない！　この場所を丸ごと焼き払うことを魅力的と感じてしまうことも普通ではない！",shape=box,color=blue];
		j3042454165 -> j3930919352;
	j583031354 [label="こうした境界線はすべて恣意的に引かれたものだ。人類がそれに気付けば、どの戦いが重要で、どれがそうでないか合意できる。",shape=box,color=blue];
		j583031354 -> j3194360950;
	j4151656313 [label="いいだろう、その論理を最後まで掘り下げようか。十分な訓練を経て人を殺せば、名誉あるものになると？　我がダクスのように、十分な威厳と事情の中で人を殺せば、それは芸術になると言いたいのか？",shape=box,color=blue];
		j4151656313 -> j2265744858;
	j951948996 [label="そうすることで殺しに楽しさを与えているのではないのか？",shape=box,color=blue];
		j951948996 -> j2539122222;
	j3930919352 [label="きっとUrielの所為なのであろう。確かに、これまで血と破壊の思考を持つことは何度かあったが、これほど破滅的なものではなかった。",shape=box,color=blue];
		j3930919352 -> j298236372;
	j3194360950 [label="殺しに名誉があるかどうか判断するのは、焼死と溺死のどちらが非道かを判断するようなものだ。どちらも悲惨な死に方だ。",shape=box,color=blue];
		j3194360950 -> j493927542;
	j2265744858 [label="それは儀式と宗教の領域に踏み込んでいる。",shape=box,color=blue];
		j2265744858 -> j1621921645;
	j2539122222 [label="誤解しないでほしいが、我は貴様を批判しているわけではない。貴様は自分が置かれた状況で最善を尽くそうとしているだけだ。死と隣り合わせの人生を歩んできたわけだ、今更それに背を向けることもできまい。",shape=box,color=blue];
		j2539122222 -> j3519832555;
	j298236372 [label="これほど…　終末的でも…",shape=box,color=blue];
		j298236372 -> "Chat ends.";
	j493927542 [label="全ての道は墓場へ通じている。些細な事にこだわる必要などあるのだろうか？　より重要な問題を抱えているというのにだ。",shape=box,color=blue];
		j493927542 -> "Chat ends.";
	j1621921645 [label="少なくとも、背中にナイフを突き刺すという安易な殺しには、誠実さがある。そこに信心深さなど何もない。派手さも、過剰な負担もない。ただ、そうするだけ。",shape=box,color=blue];
		j1621921645 -> j938178639;
	j3519832555 [label="武器を捨て去っても、貴様も周りのものも死ぬだけだ。なら、自分の行いに誇りを持ってもいいのではないか？　楽しさを見出して何が悪い？　それ以外どうすると言うのだ？　狂うか？　忘却か？",shape=box,color=blue];
		j3519832555 -> j2997663412;
	j938178639 [label="そこに芸術はないのか？",shape=box,color=blue];
		j938178639 -> "Chat ends.";
	j2997663412 [label="その道を辿り、自ら命を絶ったものを多く知る。だから、望むままに生きるといい、簒奪者よ。これまでも、これからも、人生に振り回されるのだからな。",shape=box,color=blue];
		j2997663412 -> "Chat ends.";
}