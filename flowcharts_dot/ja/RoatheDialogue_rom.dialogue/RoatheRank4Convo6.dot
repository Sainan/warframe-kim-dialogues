		j3285367747 -> j4290874667;
	j1574878754 [label="実に美しい。",shape=box,color=blue];
		j1574878754 -> j2888608214;
	j2164612357 [label="美学的だ。",shape=box,color=blue];
		j2164612357 -> j4290874667;
	j2862955563 [label="これほどの規模の死には…　美しさがある。",shape=box,color=blue];
		j2862955563 -> j3609398078;
	j2888173767 [label="なんと美しい瞬間か。",shape=box,color=blue];
		j2888173767 -> j918012326;
	j1009258265 [label="まるで殺人を芸術みたいに語るね。",shape=box,color=red];
		j1009258265 -> j4110631672;
	j3008476629 [label="殺人を強制されるのは好きじゃない。",shape=box,color=red];
		j3008476629 -> j2995208375;
