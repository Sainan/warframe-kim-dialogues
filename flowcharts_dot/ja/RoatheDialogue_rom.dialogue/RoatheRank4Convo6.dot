digraph {
	"RoatheRank4Convo6 begins." [color=orange];
		"RoatheRank4Convo6 begins." -> j1783378471;
	j1783378471 [label="簒奪者よ、お気に入りの殺し方はなんだ？",shape=box,color=blue];
		j1783378471 -> j837583261;
		j1783378471 -> j1059574753;
		j1783378471 -> j738393015;
	j837583261 [label="はい？",shape=box,color=red];
		j837583261 -> j2085108276;
	j1059574753 [label="死に方を知りたいと？",shape=box,color=red];
		j1059574753 -> j4152144305;
	j738393015 [label="[閉じる]",shape=box,color=red];
		j738393015 -> "Chat ends.";
	j2085108276 [label="最近の我は哲学的な考えに耽っている。単純な好奇心だ。",shape=box,color=blue];
		j2085108276 -> j2189646368;
	j4152144305 [label="ハッ！　そんなわけなかろう。しかし…　貴様と死合うのも悪くないかもしれないな。なに、最近の我は哲学的な考えに耽っているだけだ。単純な好奇心。",shape=box,color=blue];
		j4152144305 -> j2189646368;
	"Chat ends." [color=orange];
	j2189646368 [label="殺した数は、五分と言ったところか。力量は…　フム、測り合いをしてもあまり意味はなさそうだな。",shape=box,color=blue];
		j2189646368 -> j3697971074;
	j3697971074 [label="殺人者同士語り合おうではないか。どの方法を好む？　近接か？　潜伏か？　それとも戦場の混沌を好むか？",shape=box,color=blue];
		j3697971074 -> j42703588;
		j3697971074 -> j2731090500;
		j3697971074 -> j1814607498;
		j3697971074 -> j2607399086;
	j42703588 [label="混沌が好きだ。爆発とか、銃声とか。とにかく大きい音が多いほどいい。",shape=box,color=red];
		j42703588 -> j3055223175;
	j2731090500 [label="ステルスを好む。存在を知られる前に倒すのがいい。寝首を襲えるならそうする。",shape=box,color=red];
		j2731090500 -> j2007074258;
	j1814607498 [label="戦いは嫌いだ。しなくて済むならいいなと思う。",shape=box,color=red];
		j1814607498 -> j3436136151;
	j2607399086 [label="嫌な会話だ。",shape=box,color=red];
		j2607399086 -> j98441073;
	j3055223175 [label="Boolean RoatheSoldier is now true.",color=orange];
		j3055223175 -> j900703992;
	j2007074258 [label="Boolean RoatheAssassin is now true.",color=orange];
		j2007074258 -> j845518123;
	j3436136151 [label="嗚呼、可哀想な簒奪者よ。貴様に我の笑い声を聞かせてやりたいくらいだ…",shape=box,color=blue];
		j3436136151 -> j3185132590;
	j98441073 [label="ならさっさと行くがいい。",shape=box,color=blue];
		j98441073 -> "Chat ends.";
	j900703992 [label="我と同じく、戦場を好む兵士か。貴様の経歴からして、驚きはしない。どこへ行っても血にまみれている。デュヴィリ、ナルメル、ホルバニア…　そして今に至る。",shape=box,color=blue];
		j900703992 -> j974216927;
	j845518123 [label="ほう、暗殺者の類か！　有益でありながら、評価されない存在。有能な召使いのようだ。",shape=box,color=blue];
		j845518123 -> j1795973916;
	j3185132590 [label="哀れで貧しい生き物め。貴様のためにも、嘘をついていることを願う。",shape=box,color=blue];
		j3185132590 -> j2744754154;
	j974216927 [label="他にも数え切れない戦果があるのだろう、あるいは忘れ去ったか。死こそ貴様の芸術であり、世界を死で描く。",shape=box,color=blue];
		j974216927 -> j1228417711;
	j1795973916 [label="仕事を完璧にこなしても、それが注目されることはない。",shape=box,color=blue];
		j1795973916 -> j3908975019;
	j2744754154 [label="+20 Chemistry",color=orange];
		j2744754154 -> j1083006490;
	j1228417711 [label="では好きな芸術道具は？　掘り下げようではないか。",shape=box,color=blue];
		j1228417711 -> j1778558458;
		j1228417711 -> j3104105248;
		j1228417711 -> j3419759116;
		j1228417711 -> j1458493886;
	j3908975019 [label="それで、短剣か？　毒か？　弓矢か？",shape=box,color=blue];
		j3908975019 -> j1620632285;
		j3908975019 -> j1264488169;
		j3908975019 -> j3729196913;
		j3908975019 -> j682619047;
		j3908975019 -> j918655589;
	j1083006490 [label="そうでなければ、我がこれまで聞いた中で最も悲しい話かもしれんな。",shape=box,color=blue];
		j1083006490 -> j2927459171;
	j1778558458 [label="なんでもいいさ。即興は好きだ。",shape=box,color=red];
		j1778558458 -> j1518473629;
	j3104105248 [label="弓矢。優雅で効率的。",shape=box,color=red];
		j3104105248 -> j2306320605;
	j3419759116 [label="刃。近づいて倒すのが好き。",shape=box,color=red];
		j3419759116 -> j4255740335;
	j1458493886 [label="銃。うるさいけど、結果を出す。",shape=box,color=red];
		j1458493886 -> j4180743401;
	j1620632285 [label="なんでもいいさ。即興は好きだ。",shape=box,color=red];
		j1620632285 -> j1263760811;
	j1264488169 [label="弓矢。優雅に、静かに。",shape=box,color=red];
		j1264488169 -> j3949293460;
	j3729196913 [label="スナイパーライフル。一撃必殺。",shape=box,color=red];
		j3729196913 -> j2658544964;
	j682619047 [label="毒。死んだと気付く頃には、自分はもういない。",shape=box,color=red];
		j682619047 -> j2778127242;
	j918655589 [label="ダガー。親密さが好き。",shape=box,color=red];
		j918655589 -> j1893315510;
	j2927459171 [label="Boolean RoatheWeaponNone is now true.",color=orange];
		j2927459171 -> "Chat ends.";
	j1518473629 [label="貴様が衛生兵のベンチで戦場を蹂躙する姿を想像している。曲がったパイプにタイヤを固定し兵士たちをなぎ倒す姿を。",shape=box,color=blue];
		j1518473629 -> j1516534041;
	j2306320605 [label="激戦の中で弓を扱うのは、ごく少数にしか会得できない決意と明晰な精神力が必要だ。もちろん、安定した腕もな。",shape=box,color=blue];
		j2306320605 -> j1052198103;
	j4255740335 [label="あまり我を興奮させるな、簒奪者よ。武器を手に、血しぶきをあげて花びらのように舞う貴様の姿を見てみたいものだ…",shape=box,color=blue];
		j4255740335 -> j1097002747;
	j4180743401 [label="それは発明された瞬間から、あらゆる戦争の主力兵器となってきた。それもそうだ、標的を抹消するのに最適な道具だからな。",shape=box,color=blue];
		j4180743401 -> j113085882;
	j1263760811 [label="貴様が食器や椅子の脚で誰かを暗殺する姿を想像している。カーテンの留め具で誰かの命を奪う姿を。",shape=box,color=blue];
		j1263760811 -> j318433863;
	j3949293460 [label="狩人の道か。原始的だが、シンプルゆえの優美か。最も簡単で古めかしい方法が、時に最も効率的な場面もある。",shape=box,color=blue];
		j3949293460 -> j2544694981;
	j2658544964 [label="我の好みとしては間接的で単調すぎるが、その効率性は否定できない。必要とする冷静さも評価が高い。",shape=box,color=blue];
		j2658544964 -> j1048352183;
	j2778127242 [label="不吉な薬剤師か。特注の毒を調合し、それで標的のグラスを盛ると？　それか刃か弾丸にそれを塗り、かするだけでも致死性を発揮すると？",shape=box,color=blue];
		j2778127242 -> j974260007;
	j1893315510 [label="あまり我を興奮させるな、簒奪者よ。影に潜み、短剣を構え今にでも襲いかかりそうな貴様の姿を想像するだけで…　実に興味深い…",shape=box,color=blue];
		j1893315510 -> j732124939;
	j1516534041 [label="+10 Chemistry",color=orange];
		j1516534041 -> j1231533943;
	j1052198103 [label="それが奏でるかすかな音にもロマンを感じる。矢をつがえる音。弓を張る音。放たれる矢と期待の音…　そして標的を射抜いた時の、甘美なる死。",shape=box,color=blue];
		j1052198103 -> j2953845377;
	j1097002747 [label="触れ合いを求める気持ちは理解できる。敵の命を絶つ時、手足が切り落とされるのを見届けること。目の前で敵の死骸が崩れ落ちるのを見ること。他の誰でもなく、自身の行いと気付く時。",shape=box,color=blue];
		j1097002747 -> j3056326507;
	j113085882 [label="乱雑、派手、高価。だが、殺しに特化している。",shape=box,color=blue];
		j113085882 -> j3402517086;
	j318433863 [label="+10 Chemistry",color=orange];
		j318433863 -> j3969423238;
	j2544694981 [label="それが奏でるかすかな音にもロマンを感じる。矢をつがえる音。弓を張る音。放たれる矢と期待の音…　そして標的を射抜いた時の、甘美なる死。",shape=box,color=blue];
		j2544694981 -> j2254849854;
	j1048352183 [label="戦場の容赦ない喧騒の中、狙撃手は海の潮流のように呼吸を整えなければならない。息を吸い、吐き、そして命を奪う。",shape=box,color=blue];
		j1048352183 -> j524966938;
	j974260007 [label="一人の兵士の切り傷一つで、大隊全体がヘドロと化すのを見届けたことがある。血液から肺へ、そしてまた別の肺へと広がる毒素は、国を滅ぼすこともある。",shape=box,color=blue];
		j974260007 -> j2552777371;
	j732124939 [label="触れ合いを求める気持ちは理解できる。敵の目を見つめ、温もりが体から消えていくにつれて、その瞳が虚ろで暗くなっていくのを見届ける。",shape=box,color=blue];
		j732124939 -> j439525239;
	j1231533943 [label="この想像で貴様の恐ろしさが増すか減るか…　決めかねている。今は「増す」で納得しておこう。いずれにせよ、中々面白い答えだ。",shape=box,color=blue];
		j1231533943 -> j777855750;
