digraph {
	1995 [label="RoatheRank3Convo5 begins.",color=orange];
		1995 -> 1996;
	1996 [label="Albrechtは最初から問題児だった。奴自身と、Void研究の件でな。奴にGerivaineが与えられたのは、家族を築くことで少し落ち着かせようという目論みがあったのだろう。",shape=box,color=blue];
		1996 -> 1997;
	1997 [label="結果、事態を悪化させてしまったようだがな。子供を授かっても、奴は彼らを手足としか見ていなかった。助手としか。",shape=box,color=blue];
		1997 -> 1998;
	1998 [label="使い捨ての存在としか見ていなかった。他と変わらずな。",shape=box,color=blue];
		1998 -> 2001;
		1998 -> 2000;
		1998 -> 1999;
	2001 [label="Gerivaine？",shape=box,color=red];
		2001 -> 2004;
	2000 [label="そんな風には考えていないと思うけど。",shape=box,color=red];
		2000 -> 2003;
	1999 [label="[閉じる]",shape=box,color=red];
		1999 -> 2002;
	2004 [label="時に埋もれてしまった名前か…　Albrecht Entratiの妻だ、簒奪者よ。奴の子供たちの母だ。",shape=box,color=blue];
		2004 -> 2006;
	2003 [label="では訂正しよう。奴はどんな執行官にも劣らない冷酷さで、誰であろうと構わず殺すだろう。もちろん、理由もなしにはしないが。",shape=box,color=blue];
		2003 -> 2005;
	2002 [label="Chat ends.",color=orange];
	2006 [label="Check boolean LoidFamilyComplete",color=orange];
		2006 -> 2009 [label=true,color=green];
		2006 -> 2010 [label=false,color=brown];
	2005 [label="今思えば、Albrechtがオロキン時代においてあれほどまでに危険な存在だったのは、奴の冷淡な性格が絡んでいるのだろう。奴は目的を達成するためなら、どんな犠牲も厭わなかった。",shape=box,color=blue];
		2005 -> 2007;
		2005 -> 2008;
	2009 [label="まただ、またしても貴様は我をからかう。これは既に知っている情報なのだろう、なにせあの執事を家族と再開させたのだからな。",shape=box,color=blue];
		2009 -> 2013;
	2010 [label="そう、我らの上層で、我らの存在を知ることなく生き延びているものたちの母だ。未だにこの事実を滑稽と思うがな。",shape=box,color=blue];
		2010 -> 2005;
	2007 [label="オロキンなら、大切なものを犠牲にすることに抵抗はないだろうと思っていた。互いに非常に冷酷そうだったから。",shape=box,color=red];
		2007 -> 2011;
	2008 [label="どうしてそう思う？",shape=box,color=red];
		2008 -> 2012;
	2013 [label="だがこの件でまた貴様と議論するつもりはない。そんな気分ではない。",shape=box,color=blue];
		2013 -> 2005;
	2011 [label="貴様は自分が何も知らないことについて、憶測で喋る傾向があるな、漂流者よ。",shape=box,color=blue];
		2011 -> 2014;
	2012 [label="+10 Chemistry",color=orange];
		2012 -> 2015;
	2014 [label="それとも、その皮膚には我が見逃した青みがかかっているのか？　貴様はオロキンなのか？　もしそうなら、タイヘンシツレイシマシタ。",shape=box,color=blue];
		2014 -> 2016;
		2014 -> 2017;
	2015 [label="我々オロキンは裏切りと殺し合いばかりだと、そう誤解するものも多い。確かにそういった行いも少なくはなかった。不死の身であると、他にやることがなくなるからな。",shape=box,color=blue];
		2015 -> 2018;
	2016 [label="ごめん。不快にさせるつもりはなかった。あまりオロキン社会のことは覚えていない。自分は外の人間だったから。",shape=box,color=red];
		2016 -> 2019;
	2017 [label="オロキン社会の記憶が間違っていたら謝る。自分はそれをスピーカーから流れる命令口調の音声としか覚えていない。Voidに閉じ込められる前の話だけど…",shape=box,color=red];
		2017 -> 2020;
	2018 [label="だが我々は情熱深い民でもあった。オロキンの芸術は唯一無二だった。それは音楽、演劇、詩にも値することだった。",shape=box,color=blue];
		2018 -> 2021;
	2019 [label="謝罪を受け入れよう。今回はな。ここにいる皆から、こういう無礼な扱いはもう十分受けている。確かに貴様は魅力的だ、だが我は皆のサンドバッグではない。",shape=box,color=blue];
		2019 -> 2022;
	2020 [label="Update boolean RoatheInsulted",color=orange];
		2020 -> 2023;
	2021 [label="そして、心で人を愛した時、オロキンほど愛情を注いだものはいなかった。",shape=box,color=blue];
		2021 -> 2024;
	2022 [label="どこまで話したか？　ああそうだ、我らが無頓着なEntratiの話だったな。",shape=box,color=blue];
		2022 -> 2015;
	2023 [label="これは警告だ。ここにいる皆から、こういう無礼な扱いはもう十分受けている。確かに貴様は魅力的だが、我は皆のサンドバッグではない。",shape=box,color=blue];
		2023 -> 2022;
	2024 [label="Albrechtを除いてな。奴のあらゆる行為が、奴が関わる全ての人々が、まるで奴が大切にしたセリグラスの断片を通して見ているかのようだった。",shape=box,color=blue];
		2024 -> 2025;
	2025 [label="隔離され、孤立し、無関心だった。奴は他の影響を受けなかった。Gerivaineが亡くなり、娘の子育てを強制されてもだ。",shape=box,color=blue];
		2025 -> 2026;
	2026 [label="Check boolean LoidFamilyComplete",color=orange];
		2026 -> 2028 [label=true,color=green];
		2026 -> 2027 [label=false,color=brown];
	2028 [label="本来なら、彼女はAlbrecht以上の功績を残していただろう。もし彼女が感染されずこの衛生に根を張っていなければな。もったいない。",shape=box,color=blue];
		2028 -> 2031;
		2028 -> 2032;
	2027 [label="本来なら、彼女はAlbrecht以上の功績を残していただろう。彼女と家族たちがどうなったのか、それを刮目する日を待ち侘びている。感染の件もあるがな…",shape=box,color=blue];
		2027 -> 2029;
		2027 -> 2030;
	2031 [label="Loidを家族と再開するよう説得できて良かった。",shape=box,color=red];
		2031 -> 2035;
	2032 [label="なんでそうしたか覚えていないだろうけど、Loidを家族と再開するよう説得できて良かった。",shape=box,color=red];
		2032 -> 2036;
	2029 [label="本当にLoidと家族を再開させることが最善なのだろうか…",shape=box,color=red];
		2029 -> 2033;
	2030 [label="もしLoidを家族と再開するよう説得できたら、Roatheはどうするつもり？",shape=box,color=red];
		2030 -> 2034;
	2035 [label="そうらしいな。なのに我はそれを覚えているかのように、奴らを守って、再開の話を呆然と聞いている。それがどれほど気まずいことか理解しているのか？！",shape=box,color=blue];
		2035 -> 2039;
	2036 [label="再開の話を覚えているように振る舞うのがどれほど気まずいか理解しているのか？！　全く記憶にないのだぞ！",shape=box,color=blue];
		2036 -> 2039;
	2033 [label="多分無駄だろうな。ところで、Albrechtの送り先住所は知っているか？",shape=box,color=blue];
		2033 -> 2037;
	2034 [label="どうしようか。奴らの四肢を切り落として液体にでも浸けておこうか。Albrechtの送り先住所は知っているか？",shape=box,color=blue];
		2034 -> 2038;
	2039 [label="まるで祝賀会で誰かが近づいてきて、明らかにこちらを知っているのに、自分はそやつのことをまったく覚えておらず、あたかも知っているかのように会話を続けさせられるようなものだ。",shape=box,color=blue];
		2039 -> 2042;
	2037 [label="知らないけど、なんで？",shape=box,color=red];
		2037 -> 2040;
	2038 [label="え？！",shape=box,color=red];
		2038 -> 2041;
	2042 [label="我をどんな地獄に陥れたか解かっているのか？！　あそこに立っているだけでも惨めだと言うのに、貴様は…！",shape=box,color=blue];
		2042 -> 2044;
	2040 [label="上へ登ったら、家族の四肢を切り落として、瓶詰めにしたそれを奴に一つずつ送り込もうと思ったのだが。",shape=box,color=blue];
		2040 -> 5776;
	2041 [label="+10 Chemistry",color=orange];
		2041 -> 2043;
	2044 [label="ふん。もういい。酒に溺れるとしよう。",shape=box,color=blue];
		2044 -> 2046;
	5776 [label="え？！",shape=box,color=red];
		5776 -> 2041;
	2043 [label="落ち着け！　冗談の通じない奴め。",shape=box,color=blue];
		2043 -> 2045;
	2046 [label="+10 Chemistry",color=orange];
		2046 -> 2048;
	2045 [label="それに、誰が我に代わって送るというのだ？",shape=box,color=blue];
		2045 -> 2047;
	2048 [label="Chat ends.",color=orange];
	2047 [label="Chat ends.",color=orange];
}