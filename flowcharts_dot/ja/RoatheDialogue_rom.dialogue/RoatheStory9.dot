	"Chat ends." [color=orange];
	j3855968983 [label="ボイスメール：指揮官",shape=box,color=blue];
		j3855968983 -> j3732050057;
	j3732050057 [label="思い出した。笑声を上げるオロキンの若者集団。",shape=box,color=blue];
		j3732050057 -> j4282029357;
	j4282029357 [label="綺麗に仕立てられた、指揮官の衣装をまとった貴族たち。",shape=box,color=blue];
		j4282029357 -> j1056306569;
	j1056306569 [label="幼い日を共にしたものが、ダクス、グリニア、反物質セル、自己複製装置、原始的なバイオドローンブレードスパイダー、キャニスター部隊を指揮していた。",shape=box,color=blue];
		j1056306569 -> j135029687;
	j135029687 [label="貪欲な悪魔たちに操られた、黄金の少年少女たち。",shape=box,color=blue];
		j135029687 -> j2036231565;
	j2036231565 [label="その露わな傲慢さには虫唾が走った。酒を飲み、歌い、来るべき時代を誇示していた。",shape=box,color=blue];
		j2036231565 -> j640154535;
	j640154535 [label="いつか名声を博すだろうと。家族を新たな地位へ導くと。",shape=box,color=blue];
		j640154535 -> j3350664925;
	j3350664925 [label="その多くが戦死した。遺体さえも返還されなかった。",shape=box,color=blue];
		j3350664925 -> j2328063987;
	j2328063987 [label="敵に秘密を漏らさぬよう、彼らはクバショックで液状化させられたのだ。",shape=box,color=blue];
		j2328063987 -> j2367676221;
	j2367676221 [label="一世代の希望は油まみれの水たまりと化して、それをグリニアのブーツが踏みつぶした。",shape=box,color=blue];
		j2367676221 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}