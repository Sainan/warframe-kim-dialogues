		2697 -> 2702;
	2698 [label="もちろんだ。オロキンがしたことは極悪非道だ。ユヴァンの劇場の残された記録では、オロキンは子供たちを誘拐して精神を奪ったと書いてある。",shape=box,color=red];
		2698 -> 2703;
	2704 [label="+5 Chemistry",color=orange];
		2704 -> 2709;
	2705 [label="「ユヴァンの劇場の残された記録」か。その記録とはどこにある？　そして何より、その記録は誰によるものだ？",shape=box,color=blue];
		2705 -> 2708;
	2706 [label="どうしてそれを貴様が知る？　ユヴァンの劇場を自身で目撃したと言うのか？",shape=box,color=blue];
		2706 -> 2710;
		2706 -> 2711;
		2706 -> 2712;
	2702 [label="+5 Chemistry",color=orange];
		2702 -> 2707;
	2703 [label="だが貴様はオロキンの歴史と文化を断片的にしか覚えていないと言った。その記録とはどこにある？　そして何より、その記録は誰によるものだ？",shape=box,color=blue];
		2703 -> 2708;
	2709 [label="全ての情報を得るまで判断を保留すると？　なんてことだ、簒奪者よ！　貴様が賢く見える！　なんと稀有なことか！",shape=box,color=blue];
		2709 -> 2713;
	2708 [label="これらの記録は、オロキンのあらゆる側面を可能な限り悲惨で邪悪なものとして描くことを使命とした人々によって残された物語だ。",shape=box,color=blue];
		2708 -> 2714;
	2710 [label="見ていない。",shape=box,color=red];
		2710 -> 2715;
	2711 [label="見た。",shape=box,color=red];
		2711 -> 2716;
	2712 [label="そんなの関係ない。記録は絶対だ。",shape=box,color=red];
		2712 -> 2717;
	2707 [label="全ての情報を得るまで判断を保留すると？　なんてことだ、簒奪者よ！　貴様が賢く見える！　なんと稀有なことか！",shape=box,color=blue];
		2707 -> 2713;
	2713 [label="では、歴史の視点を変えて話そうか。皆が知るユヴァンの劇場の伝説が、どこから生まれたかを考えてみるといい。",shape=box,color=blue];
		2713 -> 2708;
	2714 [label="Origin太陽系の社会そのものを支える大黒柱を全て破壊し完全な混沌を目論むものは、その社会に依存している人々にその混沌を正当化させる理由を与えなければならない。",shape=box,color=blue];
		2714 -> 2718;
	2715 [label="なら貴様は伝聞に頼っているだけだ。これらの話がどこで記録されたか考えてみろ。そして何より、誰による記録なのかを。",shape=box,color=blue];
		2715 -> 2708;
	2716 [label="ハッ！　嘘が下手だな。",shape=box,color=blue];
		2716 -> 2719;
	2717 [label="それは本当か？　これらの話がどこで記録されたか考えてみろ。そして何より、誰による記録なのかを。",shape=box,color=blue];
		2717 -> 2708;
	2718 [label="リレーで暮らす平民の生活を考えてみろ、簒奪者。テンノの苦難から遠く離れた人間。大戦など気にも留めない人たちを。",shape=box,color=blue];
		2718 -> 2720;
	2719 [label="貴様は伝聞に頼っているだけだ。これらの話がどこで記録されたか考えてみろ。そして何より、誰による記録なのかを。",shape=box,color=blue];
		2719 -> 2708;
	2720 [label="オロキン崩壊後、権力の空白によって奴らの生活は地獄へと突き落とされた。説明を捏造するしかなかった。標的を作り、燃やすしかなかった。我々オロキンを闇に潜む怪物に仕立て上げるしかなかった。",shape=box,color=blue];
		2720 -> 2721;
		2720 -> 2722;
	2721 [label="じゃあ、ユヴァンの劇場のために子供たちを誘拐しなかったって？",shape=box,color=red];
		2721 -> 2723;
	2722 [label="じゃあユヴァンの劇場で何が起きたんだ？",shape=box,color=red];
		2722 -> 2724;
	2723 [label="いや、それは事実だ。",shape=box,color=blue];
		2723 -> 2725;
	2724 [label="+5 Chemistry",color=orange];
		2724 -> 2726;
	2725 [label="情報源を検討してほしかっただけだ。",shape=box,color=blue];
		2725 -> 2727;
	2726 [label="ユヴァンの意志に反して誘拐していないと言えば、それは嘘になる。だがそれが真実の全てではない。これは複雑な話であり、白黒がはっきりとしていない。",shape=box,color=blue];
		2726 -> 2728;
	2727 [label="なぜなら、それが真実の全てではないからだ。これは複雑な話であり、白黒がはっきりとしていない。オロキンの世界はグレーだったのだ、簒奪者よ。線引きは容易なものではない。",shape=box,color=blue];
		2727 -> 2729;
	2728 [label="オロキンの世界はグレーだったのだ、簒奪者よ。線引きは容易なものではない。",shape=box,color=blue];
		2728 -> 2729;
	2729 [label="この儀式は恥ずべきものとして始まったわけではない。当初は最高の栄誉とみなされていた。帝国が途切れることなく、揺るぎなく存続するために、自らを捧げること。そうすることで、大義が続けられると。",shape=box,color=blue];
		2729 -> 2730;
	2730 [label="当初のユヴァンは若者ではなかった。余命が自身より長ければ、それで良かった。だが、自らを捧げる者たちが…　どんどん若くなっていった。献身とは恐ろしいものだ。",shape=box,color=blue];
		2730 -> 2731;
	2731 [label="戦争に志願する者たちにも似たような傾向があった。「大義のために戦う」という名目で、書類に年齢を偽る者もいた。後に続く不本意に徴兵された者たちにとって危険な前例となることを知らずに。",shape=box,color=blue];
		2731 -> 2732;
	2732 [label="いつしか、とある執行官がユヴァンの劇場を…　懲罰手段として利用できることに気付いた。それを脅威をとして利用すれば、都市や惑星全体を統制できるかもしれないと。特に、犠牲の徴収を強引に行えばな。",shape=box,color=blue];
		2732 -> 2733;
		2732 -> 2734;
	2733 [label="Roatheはこれをどう思う？",shape=box,color=red];
		2733 -> 2735;
	2734 [label="Roatheは不本意に犠牲になった人を受け入れたことはあるの？",shape=box,color=red];
		2734 -> 2736;
	2735 [label="+5 Chemistry",color=orange];
		2735 -> 2737;
	2736 [label="正直に言おう。ある。我を怪物呼ばわりするのは構わない。だが、何百年にもわたる伝統が社会の基準となってしまうと、それに背を向けるのは困難だ。",shape=box,color=blue];
		2736 -> 2738;
	2737 [label="賛否両論、と言ったところか。ユヴァンの劇場は我も幾度も参加してきた。それを非難するのは偽善だ。何百年にもわたる伝統が社会の基準となってしまうと、それに背を向けるのは困難だ。",shape=box,color=blue];
		2737 -> 2739;
	2738 [label="回顧でも、明瞭な時でも、その非常さは明らかだった。",shape=box,color=blue];
		2738 -> 2740;
	2739 [label="もう一方で、回顧でも、明瞭な時でも、その非常さは明らかだった。",shape=box,color=blue];
		2739 -> 2740;
	2740 [label="+5 Chemistry",color=orange];
		2740 -> 2741;
	2741 [label="簒奪者よ、万物のものは永遠に生きるべきではない。あの劇場こそが何よりな証拠だ。",shape=box,color=blue];
		2741 -> 2742;
	2742 [label="Chat ends.",color=orange];
