		2669 -> 2672;
	2671 [label="当然の意見だな。だが、我々の歴史や文化を記録するものがこれほど失われるとは驚愕だ。帝国崩壊後、我々に対する評判が下がったこともあるだろうが…",shape=box,color=blue];
