		1782 -> 1783 [label="false",color=purple];
	1786 [label="昼も夜も、我を苦しめる。貴様に我の心の奥底にある秘密を全て明かしただけでなく、貴様はその信頼を裏切り、全てを奪い去った。その理由も思い出せないのが腹立たしい…",shape=box,color=blue];
		1786 -> 1793;
	1785 [label="順調に我の記憶を掘り起こしているようだな。Albrechtが血清を強制していなければ、こんなことをしなくて済んだのだがな。",shape=box,color=blue];
		1785 -> 1791;
		1785 -> 1792;
		1785 -> 1790;
	1784 [label="我の記憶を掘り起こすにはディセンディアを進める必要があるが、進捗は芳しくないようだな。我の助けを求めるなら、そちらの責務も果たすよう努力するべきだ。",shape=box,color=blue];
