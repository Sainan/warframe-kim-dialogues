	1796 [label="Update boolean RoatheStrugglebus",color=orange];
		1796 -> 1804;
	1794 [label="確かにそうだ。貴様が何をしようと我には関係ない。ただ、あの執事に階段を上ってもらいたいなら、貴様にはやるべき仕事がある。そう言っているのだ。",shape=box,color=blue];
		1794 -> 1802;
	1795 [label="そうするといい。貴様がどう時間を費やそうと、我には関係ない。ただ、あの執事に階段を上ってもらいたいなら、貴様にはやるべき仕事がある。そう言っているのだ。",shape=box,color=blue];
		1795 -> 1803;
	1807 [label="貴様を信じようと思う気持ちが芽生え始めている。またしてもだ！　貴様の行いを知っておきながらだ。再び裏切ることができると知っておきながら！",shape=box,color=blue];
		1807 -> 1815;
	1805 [label="哀れな簒奪者よ、裏切るようで悪いが我の心に眠る記憶は、血と暴力と失態でいっぱいであろう。",shape=box,color=blue];
		1805 -> 1811;
