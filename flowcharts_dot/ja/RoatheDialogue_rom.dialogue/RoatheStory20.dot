	"Chat ends." [color=orange];
	j2770328671 [label="ボイスメール：服従",shape=box,color=blue];
		j2770328671 -> j1360027434;
	j1360027434 [label="戦場でも寝室でも、我は最初から理解していた。見せかけの服従こそが勝利への道だと。",shape=box,color=blue];
		j1360027434 -> j749994526;
	j749994526 [label="屈服しているのを見れば、敵は必ず突進してくる。だからこそ、簡単に罠を張れる。",shape=box,color=blue];
		j749994526 -> j2946200348;
	j2946200348 [label="「三下」と呼ばれた。「ペット」と。Nitokhは自身が状況を制御していると信じていた。我はなんと巧妙に彼女を操っていたことか。",shape=box,color=blue];
		j2946200348 -> j1041309376;
	j1041309376 [label="血染めのRoathe。部下の肉で肥えた鬼Roathe。命を浪費する者。",shape=box,color=blue];
		j1041309376 -> j4242016740;
	j4242016740 [label="まるで戦うためだけに戦っていたかのように！　そう。オロキン帝国は滅亡しなければならない。",shape=box,color=blue];
		j4242016740 -> j1606403965;
	j1606403965 [label="そのためには戦争が続くしかない。あの黄金の置物7体を倒せるのは、絶対的で取り返しのつかない敗北だけだ。",shape=box,color=blue];
		j1606403965 -> j135666714;
	j135666714 [label="Nitokhでさえ我の本心を知らなかった。彼女は我が新世界を共に統治することを望んでいる、そう信じていた。",shape=box,color=blue];
		j135666714 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}