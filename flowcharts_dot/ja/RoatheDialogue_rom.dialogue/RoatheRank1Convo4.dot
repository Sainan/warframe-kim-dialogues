digraph {
	472 [label="RoatheRank1Convo4 begins.",color=orange];
		472 -> 473;
	473 [label="Check boolean LoidFamilyComplete",color=orange];
		473 -> 474 [label=true,color=green];
		473 -> 475 [label=false,color=brown];
	474 [label="EuleriaとPetrosの現状は、悲劇としか言えん。確かに親しい仲ではなかったが、それでもオロキンの同族だ。もはや残る数も少ないと言うのに。だが、我も用心せねばならんな。今後我が何に成り下がるか検討もつかないのだからな。",shape=box,color=blue];
		474 -> 476;
	475 [label="EuleriaとPetrosが我々の存在に気付いていないことが、実に滑稽だ。我々はまるで足元を徘徊するネズミのようだ。お前もあの子供もよくこれまで秘密を守ってこれたものだ。",shape=box,color=blue];
		475 -> 477;
	476 [label="しかしあの「Grandmother」さえ感染されるとはな（Dagathのような素晴らしい名を手放すのも理解し難い）。",shape=box,color=blue];
		476 -> 478;
		476 -> 479;
	477 [label="Evaluate expressions on HellStory",color=orange];
		477 -> 481 [label="x >= 21",color=purple];
		477 -> 480 [label="x < 21",color=purple];
		477 -> 480 [label="false",color=purple];
	478 [label="Petros？",shape=box,color=red];
		478 -> 482;
	479 [label="子供たちをどう思う？",shape=box,color=red];
		479 -> 483;
	481 [label="しかしあの「Grandmother」さえも感染されるとはな（Dagathのような素晴らしい名を手放すのも理解し難い）。彼女はもっと分別のある者だと思っていたが。",shape=box,color=blue];
		481 -> 486;
	480 [label="しかしあの「Grandmother」さえも感染されるとはな（Dagathのような素晴らしい名を手放すのも理解し難い）。彼女はもっと抜け目がない者だと思っていたが。",shape=box,color=blue];
		480 -> 484;
		480 -> 485;
	482 [label="ん？　そうか。ネクロロイドから聞かされたが、お前かあの子供が介入して、名前を忘れた家族たちに新たな名前を与えたのだったな。お前の言う「Vilcor」のことだ。",shape=box,color=blue];
		482 -> 487;
	483 [label="せがれの方はは気むずかしくて、自己中心的で、正直苛立たしい。いかにもオロキンだ。「Kaelli」…　今はそう呼ばれることを好むそうだが、驚くほど聡明で、耐えられる存在だ。",shape=box,color=blue];
		483 -> 488;
	486 [label="…馬鹿げている。この会話には既視感がある。既に話したことなのだろう。実に不愉快だ。",shape=box,color=blue];
		486 -> 491;
	484 [label="彼らは…　十分な問題を抱えている。",shape=box,color=red];
		484 -> 489;
	485 [label="Petros？",shape=box,color=red];
		485 -> 490;
	487 [label="我は奴を「Petros Vorten」として知っている。誇り高きネクロメカ艦隊の発明者だ。不思議だ、奴が歩んだ時間と、我が歩んだ時間にこうも差があるとは。",shape=box,color=blue];
		487 -> 488;
	488 [label="だがもう知っていることであろう？　我を愚者扱いするか、簒奪者？　ただ昔の話を蒸し返しているだけではないのか？",shape=box,color=blue];
		488 -> 492;
	491 [label="Evaluate expressions",color=orange];
		491 -> 498 [label="RoatheDatingDeal",color=purple];
		491 -> 498 [label="RoatheMarieDatingDeal",color=purple];
		491 -> 498 [label="RoatheLyonDatingDeal",color=purple];
		491 -> 498 [label="RoatheSerumDeal",color=purple];
		491 -> 497 [label="RoatheFamilyDeal",color=purple];
		491 -> 498 [label="RoatheMarieEntratiDeal",color=purple];
		491 -> 498 [label="RoatheLyonConfessionDeal",color=purple];
		491 -> 499 [label="false",color=purple];
	489 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		489 -> 494 [label=true,color=green];
		489 -> 493 [label=false,color=brown];
	490 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		490 -> 496 [label=true,color=green];
		490 -> 495 [label=false,color=brown];
	492 [label="Update boolean RoatheKnowsReset",color=orange];
		492 -> 500;
		492 -> 501;
		492 -> 502;
	498 [label="貴様にとって有益になるであろう、オロキン社会について黄昏るつもりで話そうとも、それを聞きにきたのではないのだろう、漂流者？　貴様には他の企みがある…",shape=box,color=blue];
		498 -> 506;
	497 [label="貴様にとって有益になるであろう、オロキン社会について黄昏るつもりで話そうとも、貴様は既にこの話を聞いているのではないのか？",shape=box,color=blue];
		497 -> 505;
	499 [label="我にこの事実を無視しろと言うのか？　それとも…　何か他に目論んでいることでも？　残酷とも呼べるこの状況から何を得ようとしているのだ…",shape=box,color=blue];
		499 -> 507;
	494 [label="そうだな、ネクロロイドからもそう聞かされている。だがあの子供が介入したことで事態は和らいだようだが。もうお互いを引き裂こうと目論んでいないようだ。",shape=box,color=blue];
		494 -> 504;
	493 [label="そうだな、ネクロロイドからもそう聞かされている。お互いを引き裂こうと熱心のようだ。",shape=box,color=blue];
		493 -> 503;
	496 [label="ん？　そうか。ネクロロイドから聞かされたが、お前かあの子供が介入して、名前を忘れた家族たちに新たな名前を与えたのだったな。お前の言う「Vilcor」を、我は「Petros Vorten」として知っている。誇り高きネクロメカ艦隊の発明者だ。",shape=box,color=blue];
		496 -> 504;
	495 [label="ん？　そうか。我は奴をPetros Vortenとして知っていた。誇り高きネクロメカ艦隊の発明者だ。ネクロロイドが言うには、奴らは名前を忘れたそうだな。今は「Father」だったか？",shape=box,color=blue];
		495 -> 503;
	500 [label="いや、この話は聞いていない。続けて。",shape=box,color=red];
		500 -> 508;
	501 [label="ただ…　Roatheと話したいだけなんだ。",shape=box,color=red];
		501 -> 509;
	502 [label="聞いたことある。でももう一度聞きたい。",shape=box,color=red];
		502 -> 510;
	506 [label="Update boolean RoatheKnowsReset",color=orange];
		506 -> 500;
