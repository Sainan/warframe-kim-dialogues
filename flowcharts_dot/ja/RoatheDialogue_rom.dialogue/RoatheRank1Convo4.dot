		508 -> 516;
	509 [label="Check boolean DrifterRoathe",color=orange];
		509 -> 517 [label=true,color=green];
		509 -> 518 [label=false,color=brown];
	510 [label="我の時間を無駄にしていると認めるのだな。ハッ！　我は一つの武勇伝しか語れない虚ろな老人ではないのだぞ。",shape=box,color=blue];
		510 -> 519;
	515 [label="貴様にとって有益になるであろう、オロキン社会について黄昏るつもりで話そうとも、貴様は既にこの話を聞いているのではないのか？",shape=box,color=blue];
		515 -> 500;
		515 -> 501;
		515 -> 502;
	514 [label="家族の和解が済んでいるのは結構なことだ、初手が終わっていなければ話にならんからな。済ませずに執事を送り込んだら、ミンチ肉になっていただろうな。",shape=box,color=blue];
		514 -> 522;
	513 [label="ところで、我の提案を再考慮したか？　我が大人しくする代わりに、執事と上にいる感染されたオロキンの端くれたちを和解させる手助けをすると。",shape=box,color=blue];
		513 -> 520;
		513 -> 521;
	512 [label="執事を上へ送らせる前に、家族の和解を先に済ませるべきだ。さもないと執事がミンチ肉になるのが目に見える。",shape=box,color=blue];
		512 -> 522;
	511 [label="ところで、我の提案を再考慮したか？　我が大人しくする代わりに、執事と上にいる感染されたオロキンの端くれたちを和解させる手助けをすると。まあ、家族同士の和解を先に済ませるべきだがな…",shape=box,color=blue];
		511 -> 520;
		511 -> 521;
	516 [label="オロキンに語れと申すのだな？　それが何を意味するかも知らずに。1時間以上話し込むことになっても知らんぞ。",shape=box,color=blue];
		516 -> 523;
	517 [label="+5 Chemistry",color=orange];
		517 -> 524;
	518 [label="ほう？　では、何故、そうしたいのだ？",shape=box,color=blue];
		518 -> 528;
		518 -> 527;
		518 -> 525;
		518 -> 526;
	519 [label="以前の会話を思い出せないのが実に腹立たしい！",shape=box,color=blue];
		519 -> 529;
	522 [label="執事とエントラティ一家について一つ理解しておくことがある。それは、どれだけ成り下がろうと、奴らはオロキンだ。あの社会で生まれ育ったことに変わりはない。あの…　欠陥的社会で。",shape=box,color=blue];
		522 -> 532;
	520 [label="答えはノーのままだ、Roathe。今はそれどころじゃない。",shape=box,color=red];
		520 -> 530;
	521 [label="考えを改めた。交渉…　成立だ。",shape=box,color=red];
		521 -> 531;
	523 [label="確かに貴様はあまりオロキンと交流する機会がなかったかもしれないな、漂流者？　あの子供とは別の人生を歩んできた。",shape=box,color=blue];
		523 -> 533;
	524 [label="うむ。そうだったな。お互いその理由も熟知している。だが今は辛抱の時だ。",shape=box,color=blue];
		524 -> 534;
	528 [label="[告白する] 理由は知っているはずだ。",shape=box,color=red];
		528 -> 538;
	527 [label="Roatheに興味がある。",shape=box,color=red];
		527 -> 537;
	525 [label="あまりオロキンと話し合う機会がなかったから。その…　戦っていないオロキンと。興味がある。",shape=box,color=red];
		525 -> 535;
	526 [label="やっぱり忘れて。[閉じる]",shape=box,color=red];
		526 -> 536;
	529 [label="Chat ends.",color=orange];
	532 [label="どれだけ横暴で、重罪を重ねようと、階級や秩序は絶対だった。少なくても軍隊と、一般社会内ではな。アルキメデスはオロキンに従い、オロキンは執行官に従った。そして執行官は皇帝に従った…　形式上ではな。",shape=box,color=blue];
		532 -> 541;
	530 [label="好きにしろ。だがいつまでも我が寛大であると思うな。",shape=box,color=blue];
		530 -> 539;
	531 [label="Update boolean RoatheNoDeal",color=orange];
		531 -> 540;
	533 [label="聞いた話によると、Zariman Ten Zeroの悲劇から分岐しているようだな。",shape=box,color=blue];
		533 -> 542;
		533 -> 543;
		533 -> 544;
	534 [label="その間、「聞きたい」と言うなら、それに応じよう。だが一つ警告しておく。お前はオロキンに語れと申したのだ。",shape=box,color=blue];
		534 -> 545;
	538 [label="+5 Chemistry",color=orange];
		538 -> 549;
	537 [label="+5 Chemistry",color=orange];
		537 -> 548;
	535 [label="敵を知れ、ということか？　それとも摩訶不思議な存在との交流に好奇心が湧いたのか？",shape=box,color=blue];
		535 -> 546;
	536 [label="勝手に泳ぐがいい。先に寄せられたのは貴様の方だ。",shape=box,color=blue];
		536 -> 547;
	541 [label="お前には理解できんかもしれないが、オロキン社会が崩壊したこの時代でも、伝承を重んじるLoidは我の言うことを聞くかもしれん。それに我は…　交渉においての話術に長けているしな。なにせ我は史上最悪と言われた執行官の右腕だったのだから。",shape=box,color=blue];
		541 -> 551;
		541 -> 552;
		541 -> 553;
	539 [label="Chat ends.",color=orange];
	540 [label="Update boolean RoatheDeal",color=orange];
		540 -> 550;
	542 [label="Zariman前もあまりオロキンとは接点がなかった。その後は…　まぁ、聞いた通りだ。",shape=box,color=red];
		542 -> 554;
	543 [label="オロキンとは何度も関わってきた。絶対信用してはいけないと学んだ。",shape=box,color=red];
		543 -> 555;
	544 [label="あいにく、オロキンに対して自分の意見は子供のとあまり変わらない。",shape=box,color=red];
		544 -> 555;
	545 [label="それが何を意味するかも知らずに。1時間以上話し込むことになっても知らんぞ。",shape=box,color=blue];
		545 -> 523;
	549 [label="うむ。そうだな。素直に気持ちを書いてくれることを願っていたのだがな。まあいい…",shape=box,color=blue];
		549 -> 557;
	548 [label="ほう？　フム。ではこの魚をどれだけ長く引っかけられるか見届けるとしよう。",shape=box,color=blue];
		548 -> 534;
	546 [label="+5 Chemistry",color=orange];
		546 -> 556;
	547 [label="Chat ends.",color=orange];
	551 [label="最悪の執行官はBallasだった。",shape=box,color=red];
		551 -> 559;
	552 [label="誰に仕えていたの？",shape=box,color=red];
		552 -> 560;
	553 [label="How so?",shape=box,color=red];
		553 -> 561;
	550 [label="+5 Chemistry",color=orange];
		550 -> 558;
	554 [label="耳にしている。Ballasか。聞いて驚くかもしれないが、奴より非道なオロキンは存在した。",shape=box,color=blue];
		554 -> 562;
		554 -> 563;
	555 [label="無論、当然の意見だ。我もオロキンは救えると信じていた。金のように、溶かして、鋳直して。",shape=box,color=blue];
		555 -> 564;
	557 [label="またの機会に期待するとしよう。こういうのはゆっくり味わうものだ、簒奪者。",shape=box,color=blue];
		557 -> 566;
	556 [label="立派だ。賢明ですらある。もし大戦時センティエントと対談、あわよくば、親交を深められたなら、我もそうしていたであろう。",shape=box,color=blue];
		556 -> 565;
	559 [label="貴様の意見は尊重しよう、これまでの奴とのことを考慮してな。確かにBallasは愚者の中でも頂上にいる存在だった。",shape=box,color=blue];
		559 -> 567;
	560 [label="Evaluate expressions on HellStory",color=orange];
		560 -> 569 [label="x >= 1",color=purple];
		560 -> 568 [label="x <= 1",color=purple];
		560 -> 568 [label="false",color=purple];
	561 [label="お前がBallasと個人的な対峙をしていたことは理解している。奴が黄金のセブンの中で一番極悪と感じるのも納得する。確かにBallasは愚者の中でも頂上にいる存在だった。",shape=box,color=blue];
		561 -> 570;
	558 [label="素晴らしい！　話がわかるようになったのだな。これでようやく前進できる。",shape=box,color=blue];
		558 -> 522;
	562 [label="本当に？",shape=box,color=red];
		562 -> 571;
	563 [label="信じがたい話だ。",shape=box,color=red];
		563 -> 571;
	564 [label="まあ、執行官を除いてだがな。奴らは救いようがなかった。聞いて驚くかもしれないが、Ballasより非道なオロキンは存在した。",shape=box,color=blue];
		564 -> 563;
		564 -> 562;
	566 [label="Update boolean DrifterRoathe",color=orange];
		566 -> 534;
	565 [label="戦場で敵と、かつての仲間に出くわした場合、心理的有利を得られるからな。",shape=box,color=blue];
		565 -> 572;
	567 [label="それに、奴の「ナルメル」についての事情は見届けなかったが、執事とこのPOM-2に残された記録から推測するに、かなりの非道を歩んだそうだ。",shape=box,color=blue];
		567 -> 573;
	569 [label="彼女のことは前にも話しただろう。我々の計画についても。まあいい、その話はまた今度だ。執行官Nitokh。正確には、大摂政執行官Nitokhだな。オロキン帝国軍総司令官。黄金のセブンの中でも最も凶悪で、狂暴だった。",shape=box,color=blue];
		569 -> 574;
	568 [label="執行官Nitokh。正確には、大摂政執行官Nitokhだな。オロキン帝国軍総司令官。黄金のセブンの中でも最も凶悪で、狂暴だった。",shape=box,color=blue];
		568 -> 574;
	570 [label="執事とPOM-2の記録から知った、奴の「ナルメル」戦争も…　かつての執行官基準でもかなりの非道を歩んだみたいだ。",shape=box,color=blue];
		570 -> 573;
	571 [label="奴が聖人だと言っているのではない。確かに大勢よりは冴えていたようだが、些細なことだ、簒奪者。",shape=box,color=blue];
		571 -> 575;
	572 [label="まあ、「聞きたい」と言うなら、それに応じよう。だが一つ警告しておく。お前はオロキンに語れと申したのだ。",shape=box,color=blue];
		572 -> 545;
	573 [label="しかし、どれだけBallasとの経験が酷かったとしても、お前は他の黄金のセブンに関する知識も体験も浅すぎる。",shape=box,color=blue];
		573 -> 574;
	574 [label="黄金のセブン、か。金の何が素晴らしいかわかるか、漂流者？　何度も溶かしてより良いものに作り変えられることだ。",shape=box,color=blue];
		574 -> 576;
	575 [label="Ballasが一番極悪だったか？　貴様にとってはそうであろう。確かにこの時代での奴の悪行はかつての執行官基準でもかなりの非道を歩んでいた。",shape=box,color=blue];
		575 -> 577;
	576 [label="我は…　ある意味今でも…　オロキンは救えると信じていた。帝国を変えられると。だが執行官たちはどうだ？　あり得ない話だ。奴らは止めるべき存在だった。奴らは皆、人類が生み出した最悪の存在だ。",shape=box,color=blue];
		576 -> 578;
	577 [label="だが…　広がった血の海と、捨てられた子供の玩具のように無残に解体された死体の山を目の前にして、お前はどう思うかな…",shape=box,color=blue];
		577 -> 579;
	578 [label="これは他ならぬ我の発言だ、簒奪者。Tauの悪魔が保証しよう、Ballasはセブンの中でも最悪ではなかったと。",shape=box,color=blue];
		578 -> 580;
	579 [label="Nitokhが一切の躊躇もなく破壊をもたらす様子を目にしていたら... ",shape=box,color=blue];
		579 -> 581;
	580 [label="Check boolean RoatheUsurper",color=orange];
		580 -> 583 [label=true,color=green];
		580 -> 584 [label=true,color=green];
		580 -> 582 [label=false,color=brown];
		580 -> 583 [label=false,color=brown];
		580 -> 584 [label=false,color=brown];
	581 [label="だがこの恐慌は実際に目撃しなければ実感しにくいものだ。あの悲劇は数では理解できない。我が目撃したことを長々と語ってもいいが、結局のところ、貴様にとっては単なる物語でしかない。",shape=box,color=blue];
		581 -> 585;
	583 [label="信じがたい話だ。",shape=box,color=red];
		583 -> 587;
	584 [label="本当に？",shape=box,color=red];
		584 -> 587;
	582 [label="なんで自分のことを「簒奪者」って呼ぶの？",shape=box,color=red];
		582 -> 586;
	585 [label="お前にとってBallasは常に、忘れられない存在であり、極悪人なのだろう。当然であろう。",shape=box,color=blue];
		585 -> 588;
	587 [label="広がった血の海と、捨てられた子供の玩具のように無残に解体された死体の山を目の前にして、お前はどう思うかな…",shape=box,color=blue];
		587 -> 579;
	586 [label="そうではないのか？　テンノはOrigin太陽系をオロキンから簒奪した。そして貴様は他人の巣に残されたカッコウのように、自らの世界からこの世界に紛れ込んできた存在だ。",shape=box,color=blue];
		586 -> 589;
	588 [label="だが、奴についてお前が知らないことは山ほどある。確かにあの愚か者については、多くのことが語られている。それと同程度、語られていない話もある。",shape=box,color=blue];
		588 -> 590;
		588 -> 591;
	589 [label="この二つの点から、我から見てお前は簒奪者なのだ（執事から聞かされたデュヴィリの件も含めれば、もう一点追加されるかもしれんがな。その話はまた今度だ）。",shape=box,color=blue];
		589 -> 592;
	590 [label="たとえば？",shape=box,color=red];
		590 -> 593;
	591 [label="Ballasの話は聞きたくない。",shape=box,color=red];
		591 -> 594;
