		"HexRankUpTo1 begins." -> j3088875992;
	j3088875992 [label="Broadsword: 俺たちはここに閉じ込められているんだ。わかるだろう？　ちゃんと片付けくらいしろ。フードコートは外の道路より汚い。ここは動物園か？",shape=box,color=blue];
