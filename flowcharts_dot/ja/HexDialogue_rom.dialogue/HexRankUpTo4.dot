	j1300411339 [label="Broadsword: だがどうやって？",shape=box,color=blue];
		j1300411339 -> j1974731743;
	j1974731743 [label="Salem: Arthur、それは簡単な質問よ。もっと難題なのは「何故？」よ",shape=box,color=blue];
