		j410987507 -> j667596142;
	j667596142 [label="Broadsword: 俺たちはこの年を、この場所を、この時間をものにしたんだ。決して手放してはならない。ここにいる人々とお互いを守り合って行こう。",shape=box,color=blue];
		j667596142 -> j3874197122;
	j3874197122 [label="xX GLIMMER Xx: そう、頑張っていきましょ！　楽しみなこと、思い出、全部。私たちじゃなく、他の人も救っていきましょ。",shape=box,color=blue];
