	4379 [label="Chat ends.",color=orange];
	4380 [label="フフフ…　もちろんできてるさ",shape=box,color=blue];
		4380 -> 4382;
	4381 [label="そうだね、彼はかなりチャーミングだ",shape=box,color=blue];
		4381 -> 4382;
	4382 [label="じゃあ行くよ",shape=box,color=blue];
		4382 -> 4383;
	4383 [label="「あなたは自由になったZabirと共に電気研究室の真ん中に立っています。彼はあなたを見て、『時間が惜しい、ついてきて』と言います。」",shape=box,color=blue];
		4383 -> 4384;
	4384 [label="「彼は廊下を次々と進みます。この小惑星の警備員全員とその動きを、我が物のように熟知しているようです。」",shape=box,color=blue];
		4384 -> 4385;
		4384 -> 4386;
		4384 -> 4387;
	4385 [label="Zabirにネズミについて聞く。",shape=box,color=red];
		4385 -> 4388;
	4386 [label="彼も囚人なのか？",shape=box,color=red];
		4386 -> 4389;
	4387 [label="どこに連れていかれている？",shape=box,color=red];
		4387 -> 4390;
	4388 [label="「Zabirは衝撃を受けた。『ネズミたちが君を見つけたのか？　すごいな。うまくいった。これを見て。』Zabirは精巧に刻印された金の笛を掲げた。『ネズミの女王からもらったんだ。彼女を見つけないと。』」",shape=box,color=blue];
		4388 -> 4391;
	4389 [label="「あなたはZabirにどうやってここにたどり着いたか聞くが、『時間がない』『まずはここから出ないと』とだけ答える。」",shape=box,color=blue];
		4389 -> 4385;
		4389 -> 4387;
	4390 [label="「Zabirは振り返り、『格納庫に向かう。船を盗んでここからできるだけ遠くへ逃げるんだ。でもまずネズミの女王を探さないと』と言った。」",shape=box,color=blue];
		4390 -> 4391;
	4391 [label="ネズミの女王？！",shape=box,color=red];
		4391 -> 4392;
	4392 [label="「『彼女からこの笛をもらった。ネズミたちはそれに従うんだ。彼女は僕の友達なんだ。いつも優しいわけじゃないけど、気遣ってくれるんだ。』」",shape=box,color=blue];
		4392 -> 4393;
		4392 -> 4394;
	4393 [label="Lettieにこの部分見せた？",shape=box,color=red];
		4393 -> 4395;
	4394 [label="彼女もなんか聞き覚えがあるな。",shape=box,color=red];
		4394 -> 4396;
	4395 [label="そんなリスクは負わないよ",shape=box,color=blue];
		4395 -> 4397;
	4396 [label="これはフィクションであり、実在の物とは一切関係ありません",shape=box,color=blue];
		4396 -> 4397;
	4397 [label="「Zabirの案内もあって、小惑星の通路を難なく進む。彼のおかげで警備員や監視カメラを回避しているようだ。」",shape=box,color=blue];
		4397 -> 4398;
	4398 [label="「やがて大きな扉に着く。Zabirは身を低くするよう合図する。二人はしゃがみこみ、船の格納庫に忍び込む。」",shape=box,color=blue];
		4398 -> 4399;
	4399 [label="「あなたは柱の影に隠れる。近くからグリニアの警備員の足音が聞こえます。」",shape=box,color=blue];
		4399 -> 4400;
	4400 [label="「どうしますか？」",shape=box,color=blue];
		4400 -> 4401;
		4400 -> 4402;
	4401 [label="警備員を攻撃する。",shape=box,color=red];
		4401 -> 4403;
	4402 [label="辺りを見る。",shape=box,color=red];
		4402 -> 4404;
	4403 [label="「自己防衛の念も先見の明も一切なく、あなたは開けた場所に飛び出した。反対側にいた警備員の一団が銃撃を始めた。あなたは銃弾の弾幕に真っ向から突進し、即死した。Zabirは、あなたの無分別な行動に首を振った。」",shape=box,color=blue];
		4403 -> 4405;
	4404 [label="「あなたは角を覗いて周囲を調査します。」",shape=box,color=blue];
		4404 -> 4406;
	4405 [label="もう一回やる？　今度は即死しないよう頑張ってね",shape=box,color=blue];
		4405 -> 4407;
		4405 -> 4408;
	4406 [label="「格納庫の中央にはレールジャックが駐機している。レールジャックへのランプは警備員によって守られている。格納庫の片側では、12人のグリニアが騒々しいサイコロゲームに熱中している。あなたから数メートル離れた場所には、コントロールパネルのある机がある。」",shape=box,color=blue];
		4406 -> 4409;
	4407 [label="やろう。",shape=box,color=red];
		4407 -> 4410;
	4408 [label="今日はここまでにしよう。[閉じる]",shape=box,color=red];
		4408 -> 4411;
	4409 [label="「『脱出するには、まず格納庫のドアを開かないと。』とZabirがささやく。」",shape=box,color=blue];
		4409 -> 4412;
	4410 [label="「どうしますか？」",shape=box,color=blue];
		4410 -> 4413;
		4410 -> 4402;
	4411 [label="Chat ends.",color=orange];
	4412 [label="「Zabirがあなたを見つめる『何かいいアイデアはあるか？』」",shape=box,color=blue];
		4412 -> 4414;
		4412 -> 4412;
