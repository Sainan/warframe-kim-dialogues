	4431 [label="あ、zabirか",shape=box,color=blue];
		4431 -> 4436;
	4437 [label="「警備員たちはネズミたちに翻弄されています。どうしますか？」",shape=box,color=blue];
		4437 -> 4441;
		4437 -> 4442;
	4434 [label="どうせ戻ってくるさ",shape=box,color=blue];
