		j256735146 -> j1087431613;
	j3773217039 [label="もう一回やる？　今度はzabir殺さないでよね",shape=box,color=blue];
		j3773217039 -> j2791789137;
		j3773217039 -> j3087729958;
	j757609698 [label="「あなたは好機を感じ、レールジャックに向かって走ります。」",shape=box,color=blue];
		j757609698 -> j4059767944;
	j978344935 [label="「Zabirがあなたに、格納庫の扉を開けるように合図しています。」",shape=box,color=blue];
		j978344935 -> j833147232;
	j1087431613 [label="Check boolean RampGuardZapped",color=orange];
		j1087431613 -> j757609698 [label=true,color=green];
