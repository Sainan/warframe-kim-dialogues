		4421 -> 4425;
	4424 [label="レールジャックへダッシュする。",shape=box,color=red];
		4424 -> 4428;
	4422 [label="Zabirに警備員を襲わせる。",shape=box,color=red];
		4422 -> 4426;
	4427 [label="「Zabirは笛を手に取り、長い一音を吹いた。聞こえるのは息の音だけ。座って待つが、何も起こらない。Zabirは肩をすくめた。」",shape=box,color=blue];
		4427 -> 4432;
	4425 [label="「ダッシュでコントロールパネルへ辿り着いたが、用心深い警備員に気づかれてしまった。降伏しようと手を挙げようとするが、意地悪なグリニアたちに撃たれてしまう。」",shape=box,color=blue];
		4425 -> 4429;
		4425 -> 4430;
	4428 [label="「あなたは船に向かって走り出そうとしましたが、警備員に発見され、発砲されました。あなたの一日、そして人生は、悲惨な終わりを迎えました。」",shape=box,color=blue];
		4428 -> 4429;
		4428 -> 4433;
	4426 [label="僕を危険にさらすなんて…",shape=box,color=blue];
		4426 -> 4431;
	4432 [label="「その時、何かが砕けるような音が聞こえた。まるで何かを嚙み切るような。突然、格納庫の周りの通気口からネズミが飛び出してきた。グリニアの警備員たちは子供のように悲鳴を上げて発砲した。銃弾が四方八方に飛び散る。」",shape=box,color=blue];
		4432 -> 4437;
	4429 [label="ちょっと休憩。[閉じる]",shape=box,color=red];
		4429 -> 4434;
	4430 [label="もう一回。",shape=box,color=red];
		4430 -> 4435;
