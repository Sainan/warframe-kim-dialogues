		4458 -> 4461;
	4462 [label="「あなたは船の電源を入れ、ランプを上げて扉を閉めようとした時、Zabirが叫びます『待って！　彼らを置いて行けない！』」",shape=box,color=blue];
		4462 -> 4463;
