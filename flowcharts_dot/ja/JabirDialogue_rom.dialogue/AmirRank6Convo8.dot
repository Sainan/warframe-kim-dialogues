		4464 -> 4466;
	4465 [label="「Zabirは笛を取り出して吹く。」",shape=box,color=blue];
		4465 -> 4467;
	4466 [label="「『却下！』Zabirは言う。」",shape=box,color=blue];
		4466 -> 4465;
	4467 [label="「数秒後、数十匹のネズミが船に流れ込んできます。Zabirはあなたを見て、『行け！』と叫びます。」",shape=box,color=blue];
		4467 -> 4468;
	4468 [label="「船が離陸する。グリニアたちは砲撃するが、その弾丸は格納庫から出てきた強大なレールジャックに跳ね返される。」",shape=box,color=blue];
		4468 -> 4469;
	4469 [label="「ネズミたちがブリッジの周りを走り回る中、広大な宇宙を見渡し、あなたは自信満々に『レールドライブ、エンゲージ！』と叫ぶ。そしてレールジャックは閃光のように彼方へと飛び立って行きました。」",shape=box,color=blue];
