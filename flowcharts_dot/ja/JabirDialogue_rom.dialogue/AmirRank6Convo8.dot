		4441 -> 4444;
	4442 [label="コントロールパネルへの扉を開く。",shape=box,color=red];
		4442 -> 4445;
	4439 [label="Chat ends.",color=orange];
	4440 [label="「あなたは警備員を指差しながら『Zabir、やっちゃえ！』と叫びます。」",shape=box,color=blue];
		4440 -> 4443;
	4444 [label="「Zabirは警備員に駆け寄り、電撃を浴びせる。警備員はぐったりと倒れる。」",shape=box,color=blue];
		4444 -> 4447;
	4445 [label="「あなたはコントロールパネルがある机まで忍び寄り、身を潜めながらコンソールを操作しようとします。そして、なんとかして扉を開くことに成功しました。」",shape=box,color=blue];
		4445 -> 4448;
	4443 [label="「Zabirは良識に反して勇敢に突入する。彼でさえ、気づかれずに突入できるほど速くはなかった。警備員は発砲し、Zabirは悲劇的な死を迎えます。」",shape=box,color=blue];
		4443 -> 4446;
