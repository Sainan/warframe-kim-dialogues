	j2791789137 [label="Amirを殺さないよう頑張る。",shape=box,color=red];
		j2791789137 -> j769413847;
	j3087729958 [label="今日はここまでかな。[閉じる]",shape=box,color=red];
		j3087729958 -> j4137660855;
	j4059767944 [label="「あなたはZabirを見て、『これ操縦できるの？』と聞くと、Zabirは『知らないけど、君なら知っているはず』と返します。」",shape=box,color=blue];
		j4059767944 -> j3534014882;
	j2118451315 [label="「Zabirはランプの警備員を指差す。」",shape=box,color=blue];
		j2118451315 -> j2128718304;
	j769413847 [label="Boolean KeepZabirAlive is now true.",color=orange];
		j769413847 -> j774369477;
	j4137660855 [label="死に損だよ…",shape=box,color=blue];
		j4137660855 -> "Chat ends.";
	j3534014882 [label="「あなたは船の電源を入れ、ランプを上げて扉を閉めようとした時、Zabirが叫びます『待って！　彼らを置いて行けない！』」",shape=box,color=blue];
		j3534014882 -> j4207544089;
		j3534014882 -> j1195085785;
	j4207544089 [label="確かに、彼らを置いていけない。",shape=box,color=red];
		j4207544089 -> j2229550015;
	j1195085785 [label="嫌だ。置いていこう。",shape=box,color=red];
		j1195085785 -> j1935230877;
	j2229550015 [label="「Zabirは笛を取り出して吹く。」",shape=box,color=blue];
		j2229550015 -> j482064352;
	j1935230877 [label="「『却下！』Zabirは言う。」",shape=box,color=blue];
		j1935230877 -> j2229550015;
	j482064352 [label="「数秒後、数十匹のネズミが船に流れ込んできます。Zabirはあなたを見て、『行け！』と叫びます。」",shape=box,color=blue];
		j482064352 -> j3584830813;
	j3584830813 [label="「船が離陸する。グリニアたちは砲撃するが、その弾丸は格納庫から出てきた強大なレールジャックに跳ね返される。」",shape=box,color=blue];
		j3584830813 -> j3919409767;
	j3919409767 [label="「ネズミたちがブリッジの周りを走り回る中、広大な宇宙を見渡し、あなたは自信満々に『レールドライブ、エンゲージ！』と叫ぶ。そしてレールジャックは閃光のように彼方へと飛び立って行きました。」",shape=box,color=blue];
		j3919409767 -> j2111344052;
