		j2662935952 -> j2358460637 [label=false,color=brown];
	j2358460637 [label="ネズミ笛を使う。",shape=box,color=red];
		j2358460637 -> j3106423515;
	j2812808620 [label="コントロールパネルを使う。",shape=box,color=red];
		j2812808620 -> j3353930943;
	j3616314971 [label="レールジャックへダッシュする。",shape=box,color=red];
		j3616314971 -> j750914720;
	j1383917193 [label="Zabirに警備員を襲わせる。",shape=box,color=red];
		j1383917193 -> j1673661472;
	j3106423515 [label="「Zabirは笛を手に取り、長い一音を吹いた。聞こえるのは息の音だけ。座って待つが、何も起こらない。Zabirは肩をすくめた。」",shape=box,color=blue];
		j3106423515 -> j3680899627;
	j3353930943 [label="「ダッシュでコントロールパネルへ辿り着いたが、用心深い警備員に気づかれてしまった。降伏しようと手を挙げようとするが、意地悪なグリニアたちに撃たれてしまう。」",shape=box,color=blue];
		j3353930943 -> j4219744285;
		j3353930943 -> j1122715778;
	j750914720 [label="「あなたは船に向かって走り出そうとしましたが、警備員に発見され、発砲されました。あなたの一日、そして人生は、悲惨な終わりを迎えました。」",shape=box,color=blue];
		j750914720 -> j4219744285;
		j750914720 -> j1938692145;
	j1673661472 [label="僕を危険にさらすなんて…",shape=box,color=blue];
		j1673661472 -> j2391698442;
	j3680899627 [label="「その時、何かが砕けるような音が聞こえた。まるで何かを嚙み切るような。突然、格納庫の周りの通気口からネズミが飛び出してきた。グリニアの警備員たちは子供のように悲鳴を上げて発砲した。銃弾が四方八方に飛び散る。」",shape=box,color=blue];
		j3680899627 -> j1471867095;
	j4219744285 [label="ちょっと休憩。[閉じる]",shape=box,color=red];
		j4219744285 -> j2694179389;
	j1122715778 [label="もう一回。",shape=box,color=red];
		j1122715778 -> j318932394;
	j1938692145 [label="もう一回！",shape=box,color=red];
		j1938692145 -> j1595881847;
	j2391698442 [label="あ、zabirか",shape=box,color=blue];
		j2391698442 -> j3733778090;
	j1471867095 [label="「警備員たちはネズミたちに翻弄されています。どうしますか？」",shape=box,color=blue];
		j1471867095 -> j2128718304;
		j1471867095 -> j833147232;
	j2694179389 [label="どうせ戻ってくるさ",shape=box,color=blue];
		j2694179389 -> "Chat ends.";
	j318932394 [label="Boolean OneMoreTime is now true.",color=orange];
		j318932394 -> j774369477;
	j1595881847 [label="Boolean Again is now true.",color=orange];
		j1595881847 -> j774369477;
	j3733778090 [label="わかったよ",shape=box,color=blue];
		j3733778090 -> j326344541;
	j2128718304 [label="Zabirで警備員にビリっと！",shape=box,color=red];
		j2128718304 -> j4230742276;
	j833147232 [label="コントロールパネルへの扉を開く。",shape=box,color=red];
		j833147232 -> j1181800517;
	j326344541 [label="「あなたは警備員を指差しながら『Zabir、やっちゃえ！』と叫びます。」",shape=box,color=blue];
		j326344541 -> j2520806919;
	j4230742276 [label="「Zabirは警備員に駆け寄り、電撃を浴びせる。警備員はぐったりと倒れる。」",shape=box,color=blue];
		j4230742276 -> j3028613594;
	j1181800517 [label="「あなたはコントロールパネルがある机まで忍び寄り、身を潜めながらコンソールを操作しようとします。そして、なんとかして扉を開くことに成功しました。」",shape=box,color=blue];
		j1181800517 -> j2262742651;
	j2520806919 [label="「Zabirは良識に反して勇敢に突入する。彼でさえ、気づかれずに突入できるほど速くはなかった。警備員は発砲し、Zabirは悲劇的な死を迎えます。」",shape=box,color=blue];
		j2520806919 -> j2824842376;
	j3028613594 [label="Boolean RampGuardZapped is now true.",color=orange];
		j3028613594 -> j1915017362;
	j2262742651 [label="「ネズミに気を取られて、警備員たちは気づかない。」",shape=box,color=blue];
		j2262742651 -> j256735146;
	j2824842376 [label="ゲームオーバーだよ",shape=box,color=blue];
		j2824842376 -> j3773217039;
