	4455 [label="「あなたは好機を感じ、レールジャックに向かって走ります。」",shape=box,color=blue];
		4455 -> 4459;
	4454 [label="「Zabirがあなたに、格納庫の扉を開けるように合図しています。」",shape=box,color=blue];
