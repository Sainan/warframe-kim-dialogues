	j2160284755 [label="+5 Chemistry",color=orange];
		j2160284755 -> j3651736326;
	j2206506475 [label="+5 Chemistry",color=orange];
		j2206506475 -> j482947175;
	j3651736326 [label="フフフ…　もちろんできてるさ",shape=box,color=blue];
		j3651736326 -> j314267353;
	j482947175 [label="そうだね、彼はかなりチャーミングだ",shape=box,color=blue];
		j482947175 -> j314267353;
	j314267353 [label="じゃあ行くよ",shape=box,color=blue];
		j314267353 -> j3516406515;
	j3516406515 [label="「あなたは自由になったZabirと共に電気研究室の真ん中に立っています。彼はあなたを見て、『時間が惜しい、ついてきて』と言います。」",shape=box,color=blue];
		j3516406515 -> j3403120895;
	j3403120895 [label="「彼は廊下を次々と進みます。この小惑星の警備員全員とその動きを、我が物のように熟知しているようです。」",shape=box,color=blue];
		j3403120895 -> j115735331;
		j3403120895 -> j478176641;
		j3403120895 -> j2463372542;
	j115735331 [label="Zabirにネズミについて聞く。",shape=box,color=red];
		j115735331 -> j605661726;
	j478176641 [label="彼も囚人なのか？",shape=box,color=red];
		j478176641 -> j239243792;
	j2463372542 [label="どこに連れていかれている？",shape=box,color=red];
		j2463372542 -> j1542372991;
	j605661726 [label="「Zabirは衝撃を受けた。『ネズミたちが君を見つけたのか？　すごいな。うまくいった。これを見て。』Zabirは精巧に刻印された金の笛を掲げた。『ネズミの女王からもらったんだ。彼女を見つけないと。』」",shape=box,color=blue];
		j605661726 -> j3794844278;
	j239243792 [label="「あなたはZabirにどうやってここにたどり着いたか聞くが、『時間がない』『まずはここから出ないと』とだけ答える。」",shape=box,color=blue];
		j239243792 -> j115735331;
		j239243792 -> j2463372542;
	j1542372991 [label="「Zabirは振り返り、『格納庫に向かう。船を盗んでここからできるだけ遠くへ逃げるんだ。でもまずネズミの女王を探さないと』と言った。」",shape=box,color=blue];
		j1542372991 -> j3794844278;
	j3794844278 [label="ネズミの女王？！",shape=box,color=red];
		j3794844278 -> j477975119;
	j477975119 [label="「『彼女からこの笛をもらった。ネズミたちはそれに従うんだ。彼女は僕の友達なんだ。いつも優しいわけじゃないけど、気遣ってくれるんだ。』」",shape=box,color=blue];
		j477975119 -> j703868776;
		j477975119 -> j395558723;
	j703868776 [label="Lettieにこの部分見せた？",shape=box,color=red];
		j703868776 -> j2748765310;
	j395558723 [label="彼女もなんか聞き覚えがあるな。",shape=box,color=red];
		j395558723 -> j1627772960;
	j2748765310 [label="そんなリスクは負わないよ",shape=box,color=blue];
		j2748765310 -> j119959139;
	j1627772960 [label="これはフィクションであり、実在の物とは一切関係ありません",shape=box,color=blue];
		j1627772960 -> j119959139;
	j119959139 [label="「Zabirの案内もあって、小惑星の通路を難なく進む。彼のおかげで警備員や監視カメラを回避しているようだ。」",shape=box,color=blue];
		j119959139 -> j3761777403;
	j3761777403 [label="「やがて大きな扉に着く。Zabirは身を低くするよう合図する。二人はしゃがみこみ、船の格納庫に忍び込む。」",shape=box,color=blue];
		j3761777403 -> j480510546;
	j480510546 [label="「あなたは柱の影に隠れる。近くからグリニアの警備員の足音が聞こえます。」",shape=box,color=blue];
		j480510546 -> j2153326603;
	j2153326603 [label="「どうしますか？」",shape=box,color=blue];
		j2153326603 -> j2799775957;
		j2153326603 -> j3193020460;
	j2799775957 [label="警備員を攻撃する。",shape=box,color=red];
		j2799775957 -> j1959719402;
	j3193020460 [label="辺りを見る。",shape=box,color=red];
		j3193020460 -> j3662401835;
	j1959719402 [label="「自己防衛の念も先見の明も一切なく、あなたは開けた場所に飛び出した。反対側にいた警備員の一団が銃撃を始めた。あなたは銃弾の弾幕に真っ向から突進し、即死した。Zabirは、あなたの無分別な行動に首を振った。」",shape=box,color=blue];
		j1959719402 -> j505647947;
	j3662401835 [label="「あなたは角を覗いて周囲を調査します。」",shape=box,color=blue];
		j3662401835 -> j916774825;
	j505647947 [label="もう一回やる？　今度は即死しないよう頑張ってね",shape=box,color=blue];
		j505647947 -> j2216247071;
		j505647947 -> j1332219839;
	j916774825 [label="「格納庫の中央にはレールジャックが駐機している。レールジャックへのランプは警備員によって守られている。格納庫の片側では、12人のグリニアが騒々しいサイコロゲームに熱中している。あなたから数メートル離れた場所には、コントロールパネルのある机がある。」",shape=box,color=blue];
		j916774825 -> j266789756;
	j2216247071 [label="やろう。",shape=box,color=red];
		j2216247071 -> j1117798340;
	j1332219839 [label="今日はここまでにしよう。[閉じる]",shape=box,color=red];
		j1332219839 -> "Chat ends.";
	j266789756 [label="「『脱出するには、まず格納庫のドアを開かないと。』とZabirがささやく。」",shape=box,color=blue];
		j266789756 -> j1428108681;
	j1117798340 [label="「どうしますか？」",shape=box,color=blue];
		j1117798340 -> j613686069;
		j1117798340 -> j3193020460;
	j1428108681 [label="「Zabirがあなたを見つめる『何かいいアイデアはあるか？』」",shape=box,color=blue];
		j1428108681 -> j774369477;
		j1428108681 -> j1428108681;
