	j2097184299 [label="はいはい",shape=box,color=blue];
		j2097184299 -> j1313968993;
	j3236445547 [label="「あなたは独房の中で、たった今殺したグリニアの死体のそばに立っています。『Lotusは決して見つけられないだろう。』彼の最期の言葉が頭から離れない。」",shape=box,color=blue];
