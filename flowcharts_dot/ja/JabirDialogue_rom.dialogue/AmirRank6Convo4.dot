		4125 -> 4129;
	4126 [label="「あなたは再び看守の遺体を調べたが、価値あるものは見つからなかった。カビの生えたビスケットを食べようか検討したが、においを嗅いだあと素早くその考えをやめた。」",shape=box,color=blue];
		4126 -> 4130;
	4127 [label="「あなたは看守の死体を探って、何か使えるものはないか調べる。火打ち石とカビの生えたビスケットしか見つからない。あなたは火打ち石を取りました。」",shape=box,color=blue];
