		j221085784 -> j450092776 [label=true,color=green];
		j221085784 -> j2165973747 [label=false,color=brown];
	j256418465 [label="「あなたは慎重に牢獄から抜け出す。右手に大きな扉、出口がある。わずかに開いているようだ。向こう側では他のグリニア看守たちがうろつく音が聞こえる。左手にはダンジョンへの通路が続いているが、暗すぎて見えない。」",shape=box,color=blue];
		j256418465 -> j1405298677;
	j1982633249 [label="わかったよ",shape=box,color=blue];
		j1982633249 -> j1271397134;
	j450092776 [label="「あなたは再び看守の遺体を調べたが、価値あるものは見つからなかった。カビの生えたビスケットを食べようか検討したが、においを嗅いだあと素早くその考えをやめた。」",shape=box,color=blue];
		j450092776 -> j3451620922;
	j2165973747 [label="「あなたは看守の死体を探って、何か使えるものはないか調べる。火打ち石とカビの生えたビスケットしか見つからない。あなたは火打ち石を取りました。」",shape=box,color=blue];
		j2165973747 -> j2803941373;
	j1405298677 [label="Check boolean TorchTaken",color=orange];
		j1405298677 -> j1650004386 [label=true,color=green];
		j1405298677 -> j1248868316 [label=false,color=brown];
	j1271397134 [label="「あなたは扉を閉め助けを待つが、助けは来ない。代わりに他の看守がやって来て、彼らの友人を殺したことに激怒し、あなたが無残で無意味な死を迎えるまで、あらゆる拷問を受けることになる。」",shape=box,color=blue];
