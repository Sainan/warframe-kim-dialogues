		4218 -> 4220;
	4219 [label="このパートLettieに見せた？",shape=box,color=red];
		4219 -> 4221;
	4220 [label="「ネズミたちがあなたを取り囲む。あなたは立ち上がり、戦闘態勢に入るが、ネズミたちは襲ってこない。代わりに、一番大きなネズミがあなたに首をかしげる。そのネズミがネックレスをしていることに気づく。銀の鎖が外れ、地面に落ちる。まるでネズミが「これは君のだ」と言っているかのようだった。」",shape=box,color=blue];
		4220 -> 4222;
