	j3993320147 [label="「ネズミたちがあなたを取り囲む。あなたは立ち上がり、戦闘態勢に入るが、ネズミたちは襲ってこない。代わりに、一番大きなネズミがあなたに首をかしげる。そのネズミがネックレスをしていることに気づく。銀の鎖が外れ、地面に落ちる。まるでネズミが「これは君のだ」と言っているかのようだった。」",shape=box,color=blue];
		j3993320147 -> j1198565989;
		j3993320147 -> j3513993768;
	j1541345670 [label="見せてないし、そうするつもりもない",shape=box,color=blue];
		j1541345670 -> j1088447856;
	j1198565989 [label="ネックレスを拾う。",shape=box,color=red];
		j1198565989 -> j2526286742;
	j3513993768 [label="誰からネックレスを貰ったかを聞いてみる？",shape=box,color=red];
		j3513993768 -> j2519322983;
	j1088447856 [label="ネズミたちが近づいてるよ、どうするの？",shape=box,color=blue];
		j1088447856 -> j1086865910;
		j1088447856 -> j2664455764;
	j2526286742 [label="「あなたはネックレスを拾いました。鎖には鍵がついています。」",shape=box,color=blue];
		j2526286742 -> j3052216648;
	j2519322983 [label="「ネズミは言葉を発しなかった。ネズミはネズミなのだから。」",shape=box,color=blue];
		j2519322983 -> j3052216648;
	j3052216648 [label="「ネズミたちは背を向け逃げ去る。この鍵を渡した者は、あなたがここにいることを知っていた。そんな力を持つのはただ一人…　Lotusだけだ。」 ",shape=box,color=blue];
		j3052216648 -> j3806786543;
	j3806786543 [label="鍵？　これで扉を開ける？",shape=box,color=red];
		j3806786543 -> j147331556;
	j147331556 [label="「鍵を扉の錠に差し込むと、扉が開きます。向こう側から差し込む明るい光が目に飛び込んできて、あなたは急な光で目を細めます。そして目の前には信じられない光景がありました…」",shape=box,color=blue];
		j147331556 -> j3839144068;
	j3839144068 [label="そして…",shape=box,color=blue];
