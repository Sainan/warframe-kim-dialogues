		4224 -> 4217;
		4224 -> 4218;
	4225 [label="「あなたはネックレスを拾いました。鎖には鍵がついています。」",shape=box,color=blue];
		4225 -> 4227;
	4226 [label="「ネズミは言葉を発しなかった。ネズミはネズミなのだから。」",shape=box,color=blue];
		4226 -> 4227;
	4227 [label="「ネズミたちは背を向け逃げ去る。この鍵を渡した者は、あなたがここにいることを知っていた。そんな力を持つのはただ一人…　Lotusだけだ。」 ",shape=box,color=blue];
		4227 -> 4228;
