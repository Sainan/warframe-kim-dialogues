		j3086425361 -> j2254087653 [label="AmirRPGAll",color=purple];
		j3086425361 -> j2254087653 [label="AmirDungeonEscaped",color=purple];
		j3086425361 -> j3645922073 [label="false",color=purple];
	j2254087653 [label="でもマジメな話…　僕は君を信じている。僕にとって君は大切で、本当のことを言ってくれてありがたいと思う。もし嘘ついたり隠してたら、多分ダメだった。",shape=box,color=blue];
		j2254087653 -> j2968870664;
	j3645922073 [label="でもマジメな話…　僕はOKだよ。君を信じている。本当のことを言ってくれてありがとう。もし嘘ついたり隠してたら、多分ダメだった。",shape=box,color=blue];
		j3645922073 -> j2968870664;
	j2968870664 [label="だから…　いいよ。うん、みんながそれでいいなら。",shape=box,color=blue];
