	j3316821453 [label="Boolean AmirConsentComplete is now true.",color=orange];
		j3316821453 -> "Chat ends.";
	j127312823 [label="話したいことがあって、行き過ぎる前にAmirの意見を聞きたいんだ。",shape=box,color=red];
		j127312823 -> j3292386411;
	j3292386411 [label="こう言った話はしたかとがなかったから。Amirに嘘をついているとか、不誠実だと思わせたくないから。",shape=box,color=red];
		j3292386411 -> j455083866;
	j455083866 [label="えええeeeeどどｄしたのだれかｋろしちゃったのｓんじゃったのそれともそれよりもっとｙばいのそうなんだそうなんでしょもｓかしてあのぎたーとつきあいはｊめちゃったのうわわわ",shape=box,color=blue];
		j455083866 -> j3475491117;
		j455083866 -> j3318739689;
	j3475491117 [label="理解しにくいかもだけど、Amirへの気持ちが薄れたわけじゃない。",shape=box,color=red];
		j3475491117 -> j916192254;
	j3318739689 [label="ギターとじゃないけど…　その、理解しにくいかもだけど、Amirへの気持ちが薄れたわけじゃない。",shape=box,color=red];
		j3318739689 -> j3332401095;
	j916192254 [label="ごめんまだｋみがぎたーとつきあってるｋもっていうそうぞうであたまｐんくしそうだびーびーさいきどうします",shape=box,color=blue];
		j916192254 -> j4132615073;
	j3332401095 [label="+5 Chemistry",color=orange];
		j3332401095 -> j916192254;
	j4132615073 [label="ハイ復帰！　で、何の話？",shape=box,color=blue];
		j4132615073 -> j1252572040;
	j1252572040 [label="どこか…　それともいつか？に他に好きな人ができたって？　ヘックスの…　一人じゃないよね？　…うわわわ考えたくもない",shape=box,color=blue];
		j1252572040 -> j1075255075;
	j1075255075 [label="いとこのlaylaと付き合うみたいだキモキモキモキモキモ",shape=box,color=blue];
		j1075255075 -> j2416102927;
		j1075255075 -> j2144191420;
	j2416102927 [label="ヘックスの一人じゃない。ギターでも。いとこでも。",shape=box,color=red];
		j2416102927 -> j1266552701;
	j2144191420 [label="いとこがいるとは初耳だ。",shape=box,color=red];
		j2144191420 -> j2872982621;
	j1266552701 [label="他に好きな人がいるってコト！？？！？！",shape=box,color=blue];
		j1266552701 -> j3583469403;
	j2872982621 [label="そだねあまり僕の家族の話をしていないしね…　じゃなくて！　他に好きな人がいるってどういうこと！？？！？！",shape=box,color=blue];
		j2872982621 -> j3583469403;
	j3583469403 [label="それをAmirがよしとしないのはわかっている。だからと言ってAmirへの気持ちが薄れたわけじゃない。",shape=box,color=red];
		j3583469403 -> j4020094139;
	j4020094139 [label="その人はこの時代の人じゃないし、紹介さえできるかわからない。でも…　大切な人なんだ。そしてAmirも大切に思っている。",shape=box,color=red];
		j4020094139 -> j3674875446;
	j3674875446 [label="分かりづらいかもだけど、納得できないなら自分はそれを受け入れる。ただ自分がAmirに嘘をついていたり、何か隠していると思われたくないんだ。",shape=box,color=red];
		j3674875446 -> j998686362;
	j998686362 [label="fffffffffffffffffffffffffffffffffffffffffffffffnhghhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhijejilmmmmmmmmmmmmmmmmmmmmkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk",shape=box,color=blue];
		j998686362 -> j1730757076;
	j1730757076 [label="（今の僕の悲鳴ね）",shape=box,color=blue];
		j1730757076 -> j1232442422;
	j1232442422 [label="君は僕にとって大切な人だ。ほんとにほんとに大切だ。君を失いたくない。もしその人を大切に思うなら…　僕にとっても大切だ。",shape=box,color=blue];
		j1232442422 -> j1456435327;
	j1456435327 [label="ただ会えないのが残念だなー 笑笑 君ばっかり楽しんでずるいぞ。1999年から出られればいいのに",shape=box,color=blue];
		j1456435327 -> j1488768060;
	j1488768060 [label="+20 Chemistry",color=orange];
		j1488768060 -> j1731647774;
	j1731647774 [label="ダッサーーーーーーーー",shape=box,color=blue];
		j1731647774 -> j3086425361;
	j3086425361 [label="Evaluate expressions",color=orange];
		j3086425361 -> j2254087653 [label="AmirCephalon4",color=purple];
