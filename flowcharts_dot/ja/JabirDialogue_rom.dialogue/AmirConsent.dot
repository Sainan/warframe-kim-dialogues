		j1523595541 -> j127312823;
	j3316821453 [label="Boolean AmirConsentComplete is now true.",color=orange];
		j3316821453 -> "Chat ends.";
	j127312823 [label="話したいことがあって、行き過ぎる前にAmirの意見を聞きたいんだ。",shape=box,color=red];
		j127312823 -> j3292386411;
	j3292386411 [label="こう言った話はしたかとがなかったから。Amirに嘘をついているとか、不誠実だと思わせたくないから。",shape=box,color=red];
		j3292386411 -> j455083866;
	j455083866 [label="えええeeeeどどｄしたのだれかｋろしちゃったのｓんじゃったのそれともそれよりもっとｙばいのそうなんだそうなんでしょもｓかしてあのぎたーとつきあいはｊめちゃったのうわわわ",shape=box,color=blue];
		j455083866 -> j3475491117;
		j455083866 -> j3318739689;
	j3475491117 [label="理解しにくいかもだけど、Amirへの気持ちが薄れたわけじゃない。",shape=box,color=red];
		j3475491117 -> j916192254;
	j3318739689 [label="ギターとじゃないけど…　その、理解しにくいかもだけど、Amirへの気持ちが薄れたわけじゃない。",shape=box,color=red];
		j3318739689 -> j3332401095;
	j916192254 [label="ごめんまだｋみがぎたーとつきあってるｋもっていうそうぞうであたまｐんくしそうだびーびーさいきどうします",shape=box,color=blue];
		j916192254 -> j4132615073;
	j3332401095 [label="+5 Chemistry",color=orange];
		j3332401095 -> j916192254;
	j4132615073 [label="ハイ復帰！　で、何の話？",shape=box,color=blue];
		j4132615073 -> j1252572040;
	j1252572040 [label="どこか…　それともいつか？に他に好きな人ができたって？　ヘックスの…　一人じゃないよね？　…うわわわ考えたくもない",shape=box,color=blue];
		j1252572040 -> j1075255075;
	j1075255075 [label="いとこのlaylaと付き合うみたいだキモキモキモキモキモ",shape=box,color=blue];
		j1075255075 -> j4147124856;
		j1075255075 -> j1425756002;
	j4147124856 [label="ヘックスの一人じゃない。ギターでも。いとこでも。",shape=box,color=red];
		j4147124856 -> j4173195085;
	j1425756002 [label="いとこがいるとは初耳だ。",shape=box,color=red];
		j1425756002 -> j3327395973;
	j4173195085 [label="他に好きな人がいるってコト！？？！？！",shape=box,color=blue];
		j4173195085 -> j2170169713;
	j3327395973 [label="そだねあまり僕の家族の話をしていないしね…　じゃなくて！　他に好きな人がいるってどういうこと！？？！？！",shape=box,color=blue];
		j3327395973 -> j2170169713;
	j2170169713 [label="それをAmirがよしとしないのはわかっている。だからと言ってAmirへの気持ちが薄れたわけじゃない。",shape=box,color=red];
		j2170169713 -> j3047949025;
	j3047949025 [label="その人はこの時代の人じゃないし、紹介さえできるかわからない。でも…　大切な人なんだ。そしてAmirも大切に思っている。",shape=box,color=red];
		j3047949025 -> j2873135163;
	j2873135163 [label="分かりづらいかもだけど、納得できないなら自分はそれを受け入れる。ただ自分がAmirに嘘をついていたり、何か隠していると思われたくないんだ。",shape=box,color=red];
		j2873135163 -> j1861801907;
	j1861801907 [label="fffffffffffffffffffffffffffffffffffffffffffffffnhghhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhijejilmmmmmmmmmmmmmmmmmmmmkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk",shape=box,color=blue];
		j1861801907 -> j3166431993;
	j3166431993 [label="（今の僕の悲鳴ね）",shape=box,color=blue];
		j3166431993 -> j3359422771;
	j3359422771 [label="僕にとって君はとても大切な存在なんだ。本当に、とても。だから、失いたくない。なんていうか。確かかどうか？　うん。確か。信頼しているんだ。そして、大切なもの。明らかに。だから…　うん、そういうこと。",shape=box,color=blue];
		j3359422771 -> j3736961515;
	j3736961515 [label="これって変だよね、でもなんで君だけ楽しんでんの？　なんで僕はここに閉じ込められてるの？",shape=box,color=blue];
		j3736961515 -> j1488768060;
	j1488768060 [label="+20 Chemistry",color=orange];
		j1488768060 -> j1731647774;
	j1731647774 [label="ダッサーーーーーーーー",shape=box,color=blue];
		j1731647774 -> j3086425361;
	j3086425361 [label="Evaluate expressions",color=orange];
		j3086425361 -> j2254087653 [label="AmirCephalon4",color=purple];
		j3086425361 -> j2254087653 [label="AmirNightmare3",color=purple];
		j3086425361 -> j2254087653 [label="AmirRPGAll",color=purple];
		j3086425361 -> j2254087653 [label="AmirDungeonEscaped",color=purple];
		j3086425361 -> j3645922073 [label="false",color=purple];
	j2254087653 [label="でもマジメな話…　僕は君を信じている。僕にとって君は大切で、本当のことを言ってくれてありがたいと思う。もし嘘ついたり隠してたら、多分ダメだった。",shape=box,color=blue];
		j2254087653 -> j2968870664;
	j3645922073 [label="でもマジメな話…　僕はOKだよ。君を信じている。本当のことを言ってくれてありがとう。もし嘘ついたり隠してたら、多分ダメだった。",shape=box,color=blue];
		j3645922073 -> j2968870664;
	j2968870664 [label="だから…　いいよ。うん、みんながそれでいいなら。",shape=box,color=blue];
		j2968870664 -> j3316821453;
