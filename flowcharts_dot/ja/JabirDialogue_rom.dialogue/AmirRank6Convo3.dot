		j553765467 -> j1410432909;
	j2305913960 [label="「グリニアが突進してくる。横に飛び移り、金属片をグリニアの革のような首に突き刺す。」",shape=box,color=blue];
		j2305913960 -> j3845077837;
	j3194084273 [label="「あなたは渾身の一撃でグリニアの顎に思いパンチを当てました。」",shape=box,color=blue];
		j3194084273 -> j2369043334;
	j1897585727 [label="「あなたは独房を横切って汚物の入ったバケツを掴み、グリニアに投げつけます。」",shape=box,color=blue];
