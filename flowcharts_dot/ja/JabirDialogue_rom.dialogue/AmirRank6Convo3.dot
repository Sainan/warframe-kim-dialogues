	j1208434281 [label="ゲームなんだから…　ノリに合わせて",shape=box,color=blue];
		j1208434281 -> j669329449;
	j2153966529 [label="「看守は激怒しました。腰から鍵を抜き取り、独房の扉を開けて押し入ってきました。本能的に武器に手を伸ばそうとしても、そこに武器はありませんでした。独房に囚われている身だから、当然、武器は没収されていました。」",shape=box,color=blue];
