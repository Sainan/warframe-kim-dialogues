	j1245787429 [label="「どうしますか？」",shape=box,color=blue];
		j1245787429 -> j3670113740;
	j3009918101 [label="「この時点で、看守が吐き出した唾液のせいで床は滑りやすくなっている。別の選択肢を選んでください。」",shape=box,color=blue];
		j3009918101 -> j1017284275;
	j623911772 [label="「看守は動じず、カァーっと声をあげてあなたの独房に唾を飛ばし、元の椅子へ戻りました。数分もしない内に、再びいびきが地下牢に響き渡った。」",shape=box,color=blue];
		j623911772 -> j1913354273;
	j2354802709 [label="なに、オーガとかのほうがよかった？",shape=box,color=blue];
		j2354802709 -> j3205872976;
	j1984014991 [label="「少しの試行錯誤の後、最後のタンブラーを所定の位置に動かしました。すると、構造が大きな音を立てて転倒しました。」",shape=box,color=blue];
		j1984014991 -> j676174051;
