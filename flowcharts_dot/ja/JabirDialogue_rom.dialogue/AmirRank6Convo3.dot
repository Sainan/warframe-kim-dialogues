	j602036379 [label="「心の奥底で小さな声が聞こえます。『おい、バカ、これが最後のチャンスだ。どうやってここに来たか思い出せないって言ってるだろ。ふざけるのはやめろ』」",shape=box,color=blue];
		j602036379 -> j3102354868;
	j204018935 [label="「まるで何十年もそこにあったかのように乾いている。持ち上げると、足かせが地面に落ちてバラバラに砕けた。破片の中にはギザギザの金属片も混じっているようだ。」",shape=box,color=blue];
		j204018935 -> j2036711104;
		j204018935 -> j1809909257;
		j204018935 -> j1090164715;
	j1699284826 [label="「騒音で看守が目を覚ましました。うめき声と共に彼は立ち上がり、ゆっくりと視界に入ってきます。」",shape=box,color=blue];
		j1699284826 -> j2974243128;
	j3213031438 [label="「バケツは何度見ても汚いです。」",shape=box,color=blue];
		j3213031438 -> j3392149240;
	j543702964 [label="「バケツから漂う悪臭からして、それが何に使われているかすぐに分かります。」",shape=box,color=blue];
		j543702964 -> j4187704110;
	j2184219944 [label="はぁ、もうやめだ",shape=box,color=blue];
		j2184219944 -> j112368292;
	j233540360 [label="「古代の神はあなたのおふざけにうんざりです。あなたは雷に打たれ、死にました。終わり。」",shape=box,color=blue];
