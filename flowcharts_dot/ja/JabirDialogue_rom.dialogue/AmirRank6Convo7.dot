	j3092555522 [label="Boolean WireCutters is now true.",color=orange];
		j3092555522 -> j3252417730;
	j4173574978 [label="「重々しいバールを手に取ると、それは頑丈な道具だった。男のくぐもった叫び声はますます激しさを増している。」",shape=box,color=blue];
		j4173574978 -> j1966151126;
		j4173574978 -> j323153087;
		j4173574978 -> j3019792238;
	j1203616145 [label="腱鞘炎になる前にちょっとタイム",shape=box,color=blue];
		j1203616145 -> j4211640407;
	j3136528501 [label="Check boolean PanelSmashed",color=orange];
		j3136528501 -> j957539990 [label=true,color=green];
		j3136528501 -> j3349077254 [label=false,color=brown];
	j3252417730 [label="「ワイヤーカッターは工業用の強度があり、ほぼ何でも切断できそうです。」",shape=box,color=blue];
		j3252417730 -> j1389288499;
	j1966151126 [label="「バールを使ってコントロールパネルを破壊する。」",shape=box,color=red];
		j1966151126 -> j1110728012;
	j323153087 [label="バールをタービンに投げ込む。",shape=box,color=red];
		j323153087 -> j295021389;
	j3019792238 [label="他を見てみる。",shape=box,color=red];
		j3019792238 -> j1571667540;
	j4211640407 [label="僕をからかっているのか、本当に下手なのかわからないけど",shape=box,color=blue];
		j4211640407 -> j1190994825;
	j957539990 [label="「それにあまり触れないほうがいいでしょう。」",shape=box,color=blue];
		j957539990 -> j375231712;
		j957539990 -> j1241948828;
	j3349077254 [label="「あなたはコントロールパネルを使おうとしましたが、ハッキングできないセキュリティプロトコルでロックされていました。手動で操作する必要がありそうです。」",shape=box,color=blue];
		j3349077254 -> j375231712;
		j3349077254 -> j1241948828;
	j1389288499 [label="ワイヤーを切断する。",shape=box,color=red];
		j1389288499 -> j995680227;
	j1110728012 [label="Boolean ControlPanel is now true.",color=orange];
		j1110728012 -> j572503223;
	j295021389 [label="「あなたは力強くバールをタービンに投げ込む。ギアとピストンが軋む重々しい騒音が部屋中に響き渡り、タービンの回転がゆっくりと減速していく。」",shape=box,color=blue];
		j295021389 -> j1137277930;
	j1190994825 [label="先にスキップしようか",shape=box,color=blue];
		j1190994825 -> j2908235504;
	j995680227 [label="Check boolean TurbineStopped",color=orange];
		j995680227 -> j795368658 [label=true,color=green];
		j995680227 -> j3897315595 [label=false,color=brown];
	j572503223 [label="Check boolean PanelSmashed",color=orange];
		j572503223 -> j2476175479 [label=true,color=green];
		j572503223 -> j883263378 [label=false,color=brown];
	j1137277930 [label="「男は苦痛から解放され崩れ落ちた。『ここから出してくれ。』」",shape=box,color=blue];
		j1137277930 -> j3672493276;
	j2908235504 [label="えー",shape=box,color=blue];
		j2908235504 -> j2986278575;
	j795368658 [label="「ワイヤーカッターは男性に繋がれたケーブルを素早く切断した。両腕が自由になった男は、即座に拘束具を外した。」",shape=box,color=blue];
		j795368658 -> j1324572075;
	j3897315595 [label="「アーク放電している電線にワイヤーカッターの刃を当てると、あなたはすぐに後悔する。電流がワイヤーカッターを通って体内に流れ込み、あなたは吹き飛ばされる。」",shape=box,color=blue];
		j3897315595 -> j882742873;
	j2476175479 [label="「あなたはやめた方がいいと直感する。」",shape=box,color=blue];
		j2476175479 -> j3019792238;
		j2476175479 -> j323153087;
	j883263378 [label="「コントロールパネルを壊すと、囚われた男が更に大きな叫び声をあげる。どうやら彼にもダメージが入ったようです。」",shape=box,color=blue];
		j883263378 -> j1502386489;
	j3672493276 [label="Boolean TurbineStopped is now true.",color=orange];
		j3672493276 -> j1389288499;
	j2986278575 [label="コホン！",shape=box,color=blue];
		j2986278575 -> j1610026724;
	j1324572075 [label="「男は丸いサングラスを外して、救世主をじっと見つめる。」",shape=box,color=blue];
		j1324572075 -> j3499241272;
	j882742873 [label="「意識を取り戻すとあなたは床に転げ落ちていました。男性はまだ叫んでおり、あなたの髪は逆立っていました。」",shape=box,color=blue];
		j882742873 -> j970257374;
	j1502386489 [label="Boolean PanelSmashed is now true.",color=orange];
		j1502386489 -> j3019792238;
		j1502386489 -> j323153087;
	j1610026724 [label="「奇跡的に、どういうわけか、タービンは男の圧倒的な力によって爆発した！」",shape=box,color=blue];
		j1610026724 -> j1050195267;
	j3499241272 [label="Check boolean AmirDating",color=orange];
		j3499241272 -> j4214743431 [label=true,color=green];
		j3499241272 -> j3318333232 [label=false,color=brown];
