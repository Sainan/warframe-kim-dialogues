		j970257374 -> j1571667540;
	j1050195267 [label="「男は丸い眼鏡を外して、救世主をじっと見つめる。」",shape=box,color=blue];
		j1050195267 -> j2104209079;
	j4214743431 [label="「彼の視線は鋭く、魅力的である。」",shape=box,color=blue];
		j4214743431 -> j2438008098;
	j3318333232 [label="丸い眼鏡、ね。名前は？",shape=box,color=red];
		j3318333232 -> j2300785450;
	j2104209079 [label="あーじゃなくて",shape=box,color=blue];
		j2104209079 -> j2932061492;
	j2438008098 [label="「あなたは彼の力強い手、豊かな前腕、そして細い脚に目が引き寄せられる。『なんてすごいスピードスターなんだ』とあなたは思います。」",shape=box,color=blue];
		j2438008098 -> j2609793216;
	j2300785450 [label="「『名はZabirだ。』彼は自信満々に言った。」",shape=box,color=blue];
		j2300785450 -> j683013340;
	j2932061492 [label="「男は丸い眼鏡を外して、自分を助けようとしていた人物をじっと見つめた。」",shape=box,color=blue];
		j2932061492 -> j3499241272;
	j2609793216 [label="はいはい。それでこのハンサムさんの名前は？",shape=box,color=red];
		j2609793216 -> j2300785450;
	j683013340 [label="聞き覚えのある名前だ。何されていたの？",shape=box,color=red];
		j683013340 -> j3433061817;
	j3433061817 [label="「『エネルギーを採取されていたんだ。気づいているかもだけど、電気を操ることができるんだ。』とZabirは言う。」",shape=box,color=blue];
		j3433061817 -> j1302777087;
	j1302777087 [label="そう、じゃあZabir、Lotusを救う方法を教えて。",shape=box,color=red];
		j1302777087 -> j2496444313;
	j2496444313 [label="「Zabirは驚きを隠せないようです。『Lotusを救う？　僕をここに拘束したのは彼女だ！　この小惑星から脱出しないと！』」",shape=box,color=blue];
		j2496444313 -> j2117155583;
		j2496444313 -> j2402046297;
	j2117155583 [label="は？",shape=box,color=red];
