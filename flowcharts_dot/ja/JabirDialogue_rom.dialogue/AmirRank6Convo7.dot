	4264 [label="Chat ends. Next chat will be AmirRank6Convo3.",color=orange];
	4263 [label="Chat ends. Next chat will be AmirRank6Convo2.",color=orange];
	4267 [label="Chat ends.",color=orange];
	4268 [label="「扉の先には大きな業務用エレベーターがある。『これは普通のダンジョンじゃない』と直感する。」",shape=box,color=blue];
		4268 -> 4269;
		4268 -> 4270;
	4269 [label="ダンジョンへ戻る。",shape=box,color=red];
		4269 -> 4271;
	4270 [label="エレベーターに乗る。",shape=box,color=red];
		4270 -> 4272;
	4271 [label="「振り返りダンジョンを眺め、『戻るのは愚かだ』と考えます。」",shape=box,color=blue];
		4271 -> 4273;
	4272 [label="「エレベーターで上へ進む。開いた檻越しに、ダンジョンの石壁がどんどん未来的なものに置き換わっていくのが見える。『自分はどこにいるんだ？』と、また自問する。」",shape=box,color=blue];
		4272 -> 4274;
	4273 [label="ハハ…　わかったよ、エレベーターに乗る。",shape=box,color=red];
		4273 -> 4272;
	4274 [label="「エレベーターを降りると、ゴボゴボと音を立てる機械と巨大なチューブが並ぶホールが広がる。ここは何かの研究室だろうか？」",shape=box,color=blue];
		4274 -> 4275;
	4275 [label="「ホールの奥の部屋から、男性が苦痛に叫ぶ声が聞こえます。」",shape=box,color=blue];
		4275 -> 4276;
		4275 -> 4277;
	4276 [label="無視して出口を探す。",shape=box,color=red];
		4276 -> 4278;
	4277 [label="叫び声の方へ向かう。",shape=box,color=red];
		4277 -> 4279;
	4278 [label="「あなたは使えそうなものを求めホール内を探索しますが、響く叫び声があなたの気を散らします。あなたは男の声に惹かれ、助けざるを得なくなります。」",shape=box,color=blue];
		4278 -> 4279;
	4279 [label="「あなたは叫び声を追ってホールを歩き進める。大きな機械室に入ると、そこに男がいます。機械に縛り付けられた、なかなか魅力的な男です。彼の指からは電撃が飛び出し、巨大なタービンに電力を供給しています。」",shape=box,color=blue];
		4279 -> 4280;
		4279 -> 4281;
	4280 [label="「どしたの？」と聞く。",shape=box,color=red];
		4280 -> 4282;
	4281 [label="男を観察する。",shape=box,color=red];
		4281 -> 4282;
	4282 [label="「男は高い台に縛り付けられ、両腕を広げている。指先にはプローブが取り付けられており、それらが絡み合って太いケーブルとなり、巨大なタービンへと繋がっている。彼の手からは電流が弧となって舞い上がっている。」",shape=box,color=blue];
		4282 -> 4283;
	4283 [label="「叫び声の合間に、男は苦しみながら『タービンを...　止めろ！』と叫んだ。」",shape=box,color=blue];
		4283 -> 4284;
	4284 [label="部屋を調べる。",shape=box,color=red];
		4284 -> 4285;
	4285 [label="「何か役に立つものはないかと部屋を見回すと、工具が置かれた作業台が目に入る。バール、巨大なワイヤーカッター、そしてコントロールパネルがあるようだ。」",shape=box,color=blue];
