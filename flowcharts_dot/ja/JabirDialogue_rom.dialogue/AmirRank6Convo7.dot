	4318 [label="えー",shape=box,color=blue];
		4318 -> 4324;
	4319 [label="「ワイヤーカッターは男性に繋がれたケーブルを素早く切断した。両腕が自由になった男は、即座に拘束具を外した。」",shape=box,color=blue];
		4319 -> 4325;
	4320 [label="「アーク放電している電線にワイヤーカッターの刃を当てると、あなたはすぐに後悔する。電流がワイヤーカッターを通って体内に流れ込み、あなたは吹き飛ばされる。」",shape=box,color=blue];
		4320 -> 4326;
