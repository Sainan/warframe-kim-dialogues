	j772525098 [label="本当はやりたいくせに",shape=box,color=blue];
		j772525098 -> "Chat ends.";
	j1135833286 [label="「驚くほど親切な特大ネズミの集団から渡された鍵を回しながら、あなたは扉の向こうにあるものが背後に広がるダンジョンよりも良いものであることを祈る。」",shape=box,color=blue];
		j1135833286 -> j409999772;
	"Chat ends. Next chat will be AmirRank6Convo3." [color=orange];
	"Chat ends. Next chat will be AmirRank6Convo2." [color=orange];
	j409999772 [label="「扉の先には大きな業務用エレベーターがある。『これは普通のダンジョンじゃない』と直感する。」",shape=box,color=blue];
		j409999772 -> j3213736082;
		j409999772 -> j2612682345;
	j3213736082 [label="ダンジョンへ戻る。",shape=box,color=red];
		j3213736082 -> j2319867713;
	j2612682345 [label="エレベーターに乗る。",shape=box,color=red];
		j2612682345 -> j4010243050;
	j2319867713 [label="「振り返りダンジョンを眺め、『戻るのは愚かだ』と考えます。」",shape=box,color=blue];
		j2319867713 -> j4254104482;
	j4010243050 [label="「エレベーターで上へ進む。開いた檻越しに、ダンジョンの石壁がどんどん未来的なものに置き換わっていくのが見える。『自分はどこにいるんだ？』と、また自問する。」",shape=box,color=blue];
		j4010243050 -> j3376419591;
	j4254104482 [label="ハハ…　わかったよ、エレベーターに乗る。",shape=box,color=red];
		j4254104482 -> j4010243050;
	j3376419591 [label="「エレベーターを降りると、ゴボゴボと音を立てる機械と巨大なチューブが並ぶホールが広がる。ここは何かの研究室だろうか？」",shape=box,color=blue];
		j3376419591 -> j3230361716;
	j3230361716 [label="「ホールの奥の部屋から、男性が苦痛に叫ぶ声が聞こえます。」",shape=box,color=blue];
		j3230361716 -> j2428515432;
		j3230361716 -> j3291255751;
	j2428515432 [label="無視して出口を探す。",shape=box,color=red];
		j2428515432 -> j2698857635;
	j3291255751 [label="叫び声の方へ向かう。",shape=box,color=red];
		j3291255751 -> j574486337;
	j2698857635 [label="「あなたは使えそうなものを求めホール内を探索しますが、響く叫び声があなたの気を散らします。あなたは男の声に惹かれ、助けざるを得なくなります。」",shape=box,color=blue];
		j2698857635 -> j574486337;
	j574486337 [label="「あなたは叫び声を追ってホールを歩き進める。大きな機械室に入ると、そこに男がいます。機械に縛り付けられた、なかなか魅力的な男です。彼の指からは電撃が飛び出し、巨大なタービンに電力を供給しています。」",shape=box,color=blue];
		j574486337 -> j1960484371;
		j574486337 -> j1149970709;
	j1960484371 [label="「どしたの？」と聞く。",shape=box,color=red];
		j1960484371 -> j3786072470;
	j1149970709 [label="男を観察する。",shape=box,color=red];
		j1149970709 -> j3786072470;
	j3786072470 [label="「男は高い台に縛り付けられ、両腕を広げている。指先にはプローブが取り付けられており、それらが絡み合って太いケーブルとなり、巨大なタービンへと繋がっている。彼の手からは電流が弧となって舞い上がっている。」",shape=box,color=blue];
		j3786072470 -> j173023448;
	j173023448 [label="「叫び声の合間に、男は苦しみながら『タービンを...　止めろ！』と叫んだ。」",shape=box,color=blue];
		j173023448 -> j925866963;
	j925866963 [label="部屋を調べる。",shape=box,color=red];
		j925866963 -> j3628387402;
	j3628387402 [label="「何か役に立つものはないかと部屋を見回すと、工具が置かれた作業台が目に入る。バール、巨大なワイヤーカッター、そしてコントロールパネルがあるようだ。」",shape=box,color=blue];
		j3628387402 -> j1571667540;
	j1571667540 [label="Check boolean WhatLoop",color=orange];
		j1571667540 -> j4289283942 [label=true,color=green];
		j1571667540 -> j473369389 [label=false,color=brown];
