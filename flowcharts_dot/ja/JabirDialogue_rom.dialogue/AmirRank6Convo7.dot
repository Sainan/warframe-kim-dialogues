	4336 [label="「『名はZabirだ。』彼は自信満々に言った。」",shape=box,color=blue];
		4336 -> 4339;
	4337 [label="「男は丸い眼鏡を外して、自分を助けようとしていた人物をじっと見つめた。」",shape=box,color=blue];
		4337 -> 4329;
