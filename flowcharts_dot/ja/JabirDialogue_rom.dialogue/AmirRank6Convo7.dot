		4265 -> 4267;
	4266 [label="「驚くほど親切な特大ネズミの集団から渡された鍵を回しながら、あなたは扉の向こうにあるものが背後に広がるダンジョンよりも良いものであることを祈る。」",shape=box,color=blue];
