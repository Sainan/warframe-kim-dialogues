		j3254499623 -> j3150279124;
	j2541919376 [label="こういう兵器は使うと確信しない限り作らないものなんだ。",shape=box,color=blue];
		j2541919376 -> j1447436646;
	j1425468464 [label="<RETRO_EMOJI_SHRUG>",shape=box,color=red];
		j1425468464 -> j295228691;
	j1951564108 [label="こっちが知りたいくらいだ。",shape=box,color=red];
		j1951564108 -> j295228691;
	j715253389 [label="「不要」と思われるのはつらいから。",shape=box,color=red];
		j715253389 -> j2194803445;
	j3150279124 [label="その、なんて言うか…　彼に見捨てられたくないのかなって。",shape=box,color=red];
