	j2604744320 [label="そうかもしれない。",shape=box,color=red];
		j2604744320 -> j706744822;
	j1180635106 [label="それって希望的観測なのでは？",shape=box,color=red];
		j1180635106 -> j3254499623;
	j3460164379 [label="俺たちを作るのにかけた労力を考えてみろ。しかも6人で済ませなかったこともな…",shape=box,color=blue];
		j3460164379 -> j2541919376;
	j706744822 [label="お前はどう思う？　あいつは一体何を待っているんだ？",shape=box,color=blue];
