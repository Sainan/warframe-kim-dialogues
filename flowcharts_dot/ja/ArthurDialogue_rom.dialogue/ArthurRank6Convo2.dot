		j2613732724 -> j3582953890 [label=false,color=brown];
	j727771476 [label="俺がお前をこれほど敬愛する理由の一つでもあるがな。;)",shape=box,color=blue];
		j727771476 -> j3582953890;
	j2598441721 [label="まあそれのおかげでお前のわがままを我慢できているわけだがな。 ;)",shape=box,color=blue];
		j2598441721 -> j1151398885;
	j174917554 [label="Kayaには感謝するべきかもな、おかげで安心できる。 :)",shape=box,color=blue];
		j174917554 -> j1151398885;
		j174917554 -> j3582953890;
	j1151398885 [label="絵文字だ！ :D",shape=box,color=red];
		j1151398885 -> j3336716373;
	j3582953890 [label="悲しいこと言わないでよ。",shape=box,color=red];
		j3582953890 -> j3262261074;
	j3336716373 [label="へいへい。あまり慣れるなよ。まだしっくりきていないんだ。",shape=box,color=blue];
		j3336716373 -> j3637620225;
	j3262261074 [label="知っての通りの俺だ。外はカリカリ、中はフニャフニャ。いつもAmirとVelimirが話しているお菓子の湿気たやつみたいにな。",shape=box,color=blue];
		j3262261074 -> j1808662133;
	j3637620225 [label="それでも、嬉しいよ。",shape=box,color=red];
		j3637620225 -> j356250474;
	j1808662133 [label="ツイビーズだっけか？",shape=box,color=blue];
		j1808662133 -> j356250474;
	j356250474 [label="とにかく。話を戻そう。多分Entratiには俺たちにより大きな目的があるんだと、不安になる時がある。",shape=box,color=blue];
		j356250474 -> j1723572167;
		j356250474 -> j2604744320;
		j356250474 -> j1180635106;
	j1723572167 [label="どうしてそう思う？",shape=box,color=red];
