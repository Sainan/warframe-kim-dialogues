		j1447436646 -> j3323327385;
		j1447436646 -> j734989938;
	j295228691 [label="もしかしたら軍隊が必要なのかも？　あるいは無関心のモノを倒せる特異点が。要素が多すぎる。",shape=box,color=red];
		j295228691 -> j3084905545;
	j2194803445 [label="そうかよ…",shape=box,color=blue];
		j2194803445 -> "Chat ends.";
	j1521343060 [label="彼がここに来た理由、彼がArthurにしたこと、それにまだ意義があると、失敗していないと思いたいのかなって。",shape=box,color=red];
		j1521343060 -> j2599802286;
		j1521343060 -> j3308811835;
	j761683051 [label="なら自分らにできるのはその時のために備えることだけ。",shape=box,color=red];
		j761683051 -> j2821550286;
	j3323327385 [label="そうかもしれない。でもEntratiは緊急時の対応策を用意しておくタイプの人だとも思う。",shape=box,color=red];
		j3323327385 -> j3525767778;
	j734989938 [label="どうだろうか。MinervaとVelimirから…　「冷戦」？について聞いたけど。沢山の兵器を作って使わないケースもあるみたいだ。",shape=box,color=red];
		j734989938 -> j2839089757;
	j3084905545 [label="俺たちは銃に装填された弾薬なのかもな。使われるために作られ、終わったら捨てられる存在なのかもしれない。",shape=box,color=blue];
		j3084905545 -> j2477020166;
