		"ArthurRank6Convo2 begins." -> j2509988985;
	j2509988985 [label="ふと思ったんだが。あとどれくらいいるんだろうな？",shape=box,color=blue];
		j2509988985 -> j3518161378;
		j2509988985 -> j3910887708;
	j3518161378 [label="1999年に？　それとも全体的に？",shape=box,color=red];
		j3518161378 -> j937624230;
	j3910887708 [label="何が？",shape=box,color=red];
		j3910887708 -> j3806157892;
	j937624230 [label="両方だな。ここ、現在、過去…　そして未来に。",shape=box,color=blue];
		j937624230 -> j2622937366;
	j3806157892 [label="Protoframeのことだ。ここか、どこか。いつか、かもな。",shape=box,color=blue];
		j3806157892 -> j2622937366;
	j2622937366 [label="Entratiは目的を持って俺たちを作り上げた。俺たち6人に留まるはずもない。",shape=box,color=blue];
		j2622937366 -> j614550585;
		j2622937366 -> j790301326;
	j614550585 [label="最初は、Helminth経由でWARFRAMEを送れなかった場合の「スペア」として用意されたものだと思った。けど今はどうだろうか。",shape=box,color=red];
		j614550585 -> j2041486722;
	j790301326 [label="Entratiの真の目的を知れればいいのに。あるいはProtoframeを作り続ける動機が知れれば。",shape=box,color=red];
		j790301326 -> j612416056;
	j2041486722 [label="6人しかいなかった時はそれに納得していた。",shape=box,color=blue];
		j2041486722 -> j612416056;
	j612416056 [label="あいつが本当に無関心のモノを止めるために作ったと信じているのか？",shape=box,color=blue];
		j612416056 -> j135527305;
	j135527305 [label="本当に信用できるのか？",shape=box,color=blue];
		j135527305 -> j1710108765;
		j135527305 -> j1668447628;
		j135527305 -> j901031088;
	j1710108765 [label="正直、わからない。信用できるようで、できない。皮肉なもんだ。",shape=box,color=red];
		j1710108765 -> j1326774648;
	j1668447628 [label="できない。彼のやり方を信じられないように、動機も信じられない。",shape=box,color=red];
		j1668447628 -> j2935008492;
		j1668447628 -> j620337304;
	j901031088 [label="そうだな。彼のやり方には賛同できないことが多い。それでも、確かにアレを止めようとしている。",shape=box,color=red];
		j901031088 -> j620337304;
		j901031088 -> j2935008492;
	j1326774648 [label="+5 Chemistry",color=orange];
		j1326774648 -> j3309161764;
	j2935008492 [label="彼は可能なら、魔人をランプに戻そうとしている。どれだけ厄介なプロセスであっても。",shape=box,color=red];
		j2935008492 -> j1304137921;
	j620337304 [label="でもこちらに選択権はない、そうだろ？　自分とあの子供ができるのは彼を追跡して後始末するだけ。",shape=box,color=red];
		j620337304 -> j3059144297;
		j620337304 -> j3063179749;
	j3309161764 [label="ハハ。",shape=box,color=blue];
		j3309161764 -> j2935008492;
		j3309161764 -> j620337304;
	j1304137921 [label="それで俺たちは学校の清掃員ってか、あいつが汚したものを綺麗にして。なんてこったい。",shape=box,color=blue];
		j1304137921 -> j3059144297;
		j1304137921 -> j3063179749;
	j3059144297 [label="Kayaも彼女なりのタイムトラベルを解読したみたいだし、こっちも行ったり来たりが楽になるかも。",shape=box,color=red];
		j3059144297 -> j396670506;
	j3063179749 [label="でも自分はここに残るから、あとは子供任せだな。",shape=box,color=red];
		j3063179749 -> j161265069;
	j396670506 [label="あのガキは気に食わないこともあるが、成果は認める。",shape=box,color=blue];
		j396670506 -> j105777345;
	j161265069 [label="Check boolean ArthurDating",color=orange];
		j161265069 -> j1709660902 [label=true,color=green];
		j161265069 -> j3556113126 [label=false,color=brown];
	j105777345 [label="お前が出ていく時…　帰ってくるかもと思えて嬉しいかもな :/",shape=box,color=blue];
		j105777345 -> j2613732724;
	j1709660902 [label="どうだろうか。お前のことはよく知っている。面倒事に突っ込まない方が難しそうだ。",shape=box,color=blue];
		j1709660902 -> j727771476;
	j3556113126 [label="どうだろうか。お前のことはよく知っている、漂流者。面倒事に突っ込まない方が難しそうだ。",shape=box,color=blue];
		j3556113126 -> j2598441721;
