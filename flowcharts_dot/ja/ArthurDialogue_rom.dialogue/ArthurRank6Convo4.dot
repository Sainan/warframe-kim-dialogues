digraph {
	3433 [label="ArthurRank6Convo4 begins.",color=orange];
		3433 -> 3434;
	3434 [label="変な質問かもしれないが、宇宙にはオモチャはあるのか？",shape=box,color=blue];
		3434 -> 3435;
		3434 -> 3436;
	3435 [label="子供の玩具的な？　もちろんあるさ。",shape=box,color=red];
		3435 -> 3437;
	3436 [label="オモチャって…　どんな？",shape=box,color=red];
		3436 -> 3438;
	3437 [label="へぇ。そうかい？",shape=box,color=blue];
		3437 -> 3439;
	3438 [label="おい！　そういうのじゃない！　分かってるだろ！",shape=box,color=blue];
		3438 -> 3440;
	3439 [label="何千か何万年先の未来でも",shape=box,color=blue];
		3439 -> 3441;
	3440 [label="子供の玩具のことだ。人形とか、アクションフィギュアとか。そういうのだ。",shape=box,color=blue];
		3440 -> 3442;
		3440 -> 3448;
	3441 [label="子供たちが人形やフィギュアを使ってごっこ遊びをしている想像がつかないな。",shape=box,color=blue];
		3441 -> 3444;
		3441 -> 3445;
		3441 -> 3446;
	3442 [label="からかっただけだよ :P",shape=box,color=red];
		3442 -> 3447;
	3448 [label="ちなみに、ない。[閉じる]",shape=box,color=red];
		3448 -> 3452;
	3444 [label="急にどうしたの？",shape=box,color=red];
		3444 -> 3449;
	3445 [label="Arthurは何を遊んで育ったの？",shape=box,color=red];
		3445 -> 3450;
	3446 [label="ごっこ遊びとは呼ばなかったけど、オモチャはあったよ。",shape=box,color=red];
		3446 -> 3451;
	3447 [label="もちろん、あるさ。",shape=box,color=red];
		3447 -> 3437;
	3452 [label="Chat ends.",color=orange];
	3449 [label="この間Amirがアーケードゲームを遊んでいるのを見ていたんだ。",shape=box,color=blue];
		3449 -> 3453;
	3450 [label="俺たちの文化がどれだけ違えど、子供たちがただオモチャで遊んで楽しめるというのは…　安心できる。",shape=box,color=blue];
		3450 -> 3454;
	3451 [label="どんなのだ？",shape=box,color=blue];
		3451 -> 3455;
		3451 -> 3456;
	3453 [label="それでふと考えてしまったんだ。またあんな風に楽しめたらなってな。",shape=box,color=blue];
		3453 -> 3457;
	3454 [label="昔アクションフィギュアを持っていた。アクション・アンガス。兵隊のオモチャだ、不思議でもないだろ。",shape=box,color=blue];
		3454 -> 3458;
	3455 [label="フィギュアやぬいぐるみ、ブロックとか。いかにも子供が遊ぶやつ。",shape=box,color=red];
		3455 -> 3450;
	3456 [label="あれは…　まぁ一種の人形かな。ダクスの子供のやつ、持っていた絵本から名前を取って。Dominus Thraxって言うんだけど。",shape=box,color=red];
		3456 -> 3459;
	3457 [label="俺はAoiやAmir、今じゃKayaが「子供っぽい」遊びに面白さを見出すことを軽蔑したりしない。気にしたこともなかった。",shape=box,color=blue];
		3457 -> 3460;
	3458 [label="とある祝祭で、年上の子供たちが俺のアクション・アンガスと他のオモチャを奪って、そして…",shape=box,color=blue];
		3458 -> 3461;
	3459 [label="あ…　そうだよな。すまん、嫌な事を思い出させた。",shape=box,color=blue];
		3459 -> 3462;
		3459 -> 3463;
	3460 [label="でも、俺も同じように楽しめる感情は…　当の昔にこわばって死んでしまったんじゃないかと不安なんだ。",shape=box,color=blue];
		3460 -> 3464;
	3461 [label="長い話だ。要約すると俺は「人形ごっこするような歳じゃない」だったらしい。オモチャで遊んだのはそれが最後だ。",shape=box,color=blue];
		3461 -> 3465;
	3462 [label="あまり気乗りしない話題だね。",shape=box,color=red];
		3462 -> 3466;
	3463 [label="平気だよ。Arthurのせいじゃない。",shape=box,color=red];
		3463 -> 3467;
	3464 [label="悲しい話だよな？　子供たちには何かを愛せと言っておきながら、「大人」になったらそれを手放せと言うんだからな。",shape=box,color=blue];
		3464 -> 3468;
		3464 -> 3469;
	3465 [label="この間、Amirがいつものようにゲームを遊んでいるのを眺めていた。あいつがゲームにどれだけ執着しているかは明らかだ。どれだけの幸福をもたらすか。それを見て俺は…　嫉妬した。",shape=box,color=blue];
		3465 -> 3464;
	3466 [label="とんだ大バカ野郎だ、俺は。",shape=box,color=blue];
		3466 -> 3470;
	3467 [label="普通の子供が遊ぶようなオモチャは一通りあったよ。ブロックとか、ぬいぐるみとか、フィギュアとか、人形とか。",shape=box,color=red];
		3467 -> 3471;
	3468 [label="そうだろうか。皆大人になる時が来る。空想で自分を隠すことはできない。自分は苦い経験からそれを学んだ。",shape=box,color=red];
		3468 -> 3472;
	3469 [label="人生は醜くて、苦しくて、短いこともある。だから楽しさや笑い、愛で満たすべきだ。",shape=box,color=red];
		3469 -> 3473;
	3470 [label="Chat ends.",color=orange];
	3471 [label="自分のは…　Voidなんちゃらでちょっと問題になっただけだから。",shape=box,color=red];
		3471 -> 3450;
	3472 [label="一理ある。現実逃避になるとそれは問題になる。でもそう言っているんじゃない。",shape=box,color=blue];
		3472 -> 3474;
	3473 [label="そうだな。そしてそれは俺たちがどんな状況にいようと、共に前進していく中で、忘れらないことであることを願う。",shape=box,color=blue];
		3473 -> 3474;
	3474 [label="この間なんか、Eleanor、Velimir、Aoi、AmirがFlareとLizzieとかくれんぼしているのを見かけた（Quincyはスコープで壁の向こうを見て不正をしたから一緒に遊べないらしい）",shape=box,color=blue];
		3474 -> 3475;
	3475 [label="俺に気づいた連中は、俺が皆が遊んでいるのを見て怒るんじゃないかと心配していた。",shape=box,color=blue];
		3475 -> 3476;
	3476 [label="正直俺は、呼ばれなかったことに腹立っていた。でも俺は眉間にシワを寄せて、皆が仕事していないことに怒っているフリをした。",shape=box,color=blue];
		3476 -> 3477;
	3477 [label="Amirにはゲームがある。AoiにOn-lyneが。大人であることを押し付けられたKayaでさえ、スタンプとジニモンがある。",shape=box,color=blue];
		3477 -> 3478;
		3477 -> 3479;
	3478 [label="結局何が言いたいの？",shape=box,color=red];
		3478 -> 3480;
	3479 [label="努力すれば取り戻せるんじゃないかな。オモチャとかゲームに喜びを見出す心を。",shape=box,color=red];
		3479 -> 3481;
	3480 [label="正直、わからない。ただ、長らく感じていなかった何かを恋しく思っているのかもしれない。",shape=box,color=blue];
		3480 -> 3482;
	3481 [label="笑われるのが目に見える。でもきっとその恥ずかしさが俺を留めているんだろうな。",shape=box,color=blue];
		3481 -> 3483;
	3482 [label="取り戻せるのかもわからない。それかもう手遅れなのかもな。でもこれだけ時間があれば、なんでもアリだ。",shape=box,color=blue];
		3482 -> 3484;
	3483 [label="一時的な羞恥心を抑えられたとしても、取り戻せるかどうかは分からない。でもこのループする世界なら、なんでもアリなのかもな。",shape=box,color=blue];
		3483 -> 3485;
	3484 [label="Chat ends.",color=orange];
	3485 [label="Chat ends.",color=orange];
}