		3374 -> 3377;
	3375 [label="興味深いものだった、1999年が何回ループしたかとかな。",shape=box,color=blue];
		3375 -> 3378;
	3376 [label="共に苦労したことのない人たちと話せるというのは、新鮮な気持ちだと言いたいんだ。",shape=box,color=blue];
		3376 -> 3379;
	3377 [label="ヘックスは俺の家族だ。チームだ。分かっているだろ。",shape=box,color=blue];
		3377 -> 3376;
	3378 [label="俺が何度この一年の出来事を忘れたかもしれないか。彼女が…　時の外に存在しているとか？　そして俺たちはそうでないとか。",shape=box,color=blue];
		3378 -> 3380;
	3379 [label="あまり共感できないかもだが。俺はあいつらを知っている、信頼している、だが共に苦難を乗り越えたわけじゃない。",shape=box,color=blue];
		3379 -> 3381;
	3380 [label="先に言っておくが、知りたくはない。俺には知る権利がない。",shape=box,color=blue];
		3380 -> 3382;
	3381 [label="だからそういう奴らと飲み交わすのが楽なんだ。",shape=box,color=blue];
		3381 -> 3383;
		3381 -> 3384;
		3381 -> 3385;
	3382 [label="まぁでも、もしそうしていたなら…　安心しろ。責めたりはしない。",shape=box,color=blue];
