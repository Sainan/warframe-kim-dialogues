		3384 -> 3388;
	3385 [label="彼らの中に年上で軍経験のある人たちがいるのも助かる。",shape=box,color=red];
		3385 -> 3389;
	3386 [label="俺たちが置かれているこの状況は、普通じゃない。俺たち…　人間は、これに対処できるよう作られていない。",shape=box,color=blue];
		3386 -> 3390;
	3387 [label="そうだな。",shape=box,color=blue];
		3387 -> 3391;
	3388 [label="あまり…　重さを感じない。過去がない。Amir風に言うなら重荷に感じない。",shape=box,color=blue];
		3388 -> 3391;
	3389 [label="まったくだ。最初リバタチア人が来た時はどうなるかと思ったが。今は来てくれてありがたいと感じている。",shape=box,color=blue];
		3389 -> 3391;
	3390 [label="これにガイドブックなんてない。お前がどんな選択をしようと、ちゃんとした理由があったと信じている。",shape=box,color=blue];
