		3398 -> 3401;
	3400 [label="お前が来るまでは、そんなこと許せなかっただろう。お前を失うのが怖すぎるから。これを失うのが。",shape=box,color=blue];
		3400 -> 3402;
	3399 [label="お前が来るまでは、そんなこと許せなかっただろう。俺の一部を失うのが怖すぎるから。",shape=box,color=blue];
		3399 -> 3402;
	3401 [label="そしてこの…　ループする時間軸についてだ。これまで何度1999年を繰り返して、それを覚えていないか。",shape=box,color=blue];
		3401 -> 3403;
		3401 -> 3404;
		3401 -> 3405;
	3402 [label="海でいかだにしがみつくように、俺もしがみついていただろう。でももしかしたらこのループを何度も見ていて…　それかお前が要素なのか、わからない。",shape=box,color=blue];
