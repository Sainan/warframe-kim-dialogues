digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo9 begins." [color=orange];
		"ArthurRank6Convo9 begins." -> j1992812129;
	j1992812129 [label="あまり気に食わないな…　Eleanorが集めているあの感染銃たちは。",shape=box,color=blue];
		j1992812129 -> j1753267148;
		j1992812129 -> j4123588695;
	j1753267148 [label="なんで？",shape=box,color=red];
		j1753267148 -> j2737844578;
	j4123588695 [label="少なくとも喋りはしない。",shape=box,color=red];
		j4123588695 -> j2591235616;
	j2737844578 [label="Eleanorがアレと話せるかもしれないという事実以外でか？",shape=box,color=blue];
		j2737844578 -> j1163348232;
	j2591235616 [label="*俺たち*にはな。*Eleanor*と話していないかどうかは確信が持てん。",shape=box,color=blue];
		j2591235616 -> j1163348232;
	j1163348232 [label="ギターに話しかけているのは確かだ。それについて必要以上に考えたくはない。",shape=box,color=blue];
		j1163348232 -> j1217245331;
	j1217245331 [label="だが警戒すべきなのだろうか、アレが…　拡散することに？　増殖してるみたいだしな。",shape=box,color=blue];
		j1217245331 -> j38640653;
	j38640653 [label="理解に苦しんでいる。あと、弾薬がどこから来てるのかも深く考えたくない。そもそも何で構成されてるのかもな。",shape=box,color=blue];
		j38640653 -> j4174068301;
		j38640653 -> j3250309725;
	j4174068301 [label="少なくともこの感染体の何かは味方でしょ？",shape=box,color=red];
		j4174068301 -> j3197795676;
	j3250309725 [label="それなら普通の銃の方がいいかもね。",shape=box,color=red];
		j3250309725 -> j1722089412;
	j3197795676 [label="まぁ。*今*のところはな。",shape=box,color=blue];
		j3197795676 -> j17135340;
	j1722089412 [label="そうさせてもらう。",shape=box,color=blue];
		j1722089412 -> j17135340;
	j17135340 [label="少なくとも、拳銃で自分の足に穴開けたら俺のヘマだって分かる。",shape=box,color=blue];
		j17135340 -> j1673938961;
	j1673938961 [label="銃が忠誠を考え直したからでも、真夜中に空腹に襲われたからでもないからな。",shape=box,color=blue];
		j1673938961 -> "Chat ends.";
	"Chat ends." [color=orange];
}