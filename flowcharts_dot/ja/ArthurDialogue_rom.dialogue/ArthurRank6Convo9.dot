digraph {
	3555 [label="ArthurRank6Convo9 begins.",color=orange];
		3555 -> 3556;
	3556 [label="あまり気に食わないな…　Eleanorが集めているあの感染銃たちは。",shape=box,color=blue];
		3556 -> 3557;
		3556 -> 3558;
	3557 [label="なんで？",shape=box,color=red];
		3557 -> 3559;
	3558 [label="少なくとも喋りはしない。",shape=box,color=red];
		3558 -> 3560;
	3559 [label="Eleanorがアレと話せるかもしれないという事実以外でか？",shape=box,color=blue];
		3559 -> 3561;
	3560 [label="*俺たち*にはな。*Eleanor*と話していないかどうかは確信が持てん。",shape=box,color=blue];
		3560 -> 3561;
	3561 [label="ギターに話しかけているのは確かだ。それについて必要以上に考えたくはない。",shape=box,color=blue];
		3561 -> 3562;
	3562 [label="だが警戒すべきなのだろうか、アレが…　拡散することに？　増殖してるみたいだしな。",shape=box,color=blue];
		3562 -> 3563;
	3563 [label="理解に苦しんでいる。あと、弾薬がどこから来てるのかも深く考えたくない。そもそも何で構成されてるのかもな。",shape=box,color=blue];
		3563 -> 3564;
		3563 -> 3565;
	3564 [label="少なくともこの感染体の何かは味方でしょ？",shape=box,color=red];
		3564 -> 3566;
	3565 [label="それなら普通の銃の方がいいかもね。",shape=box,color=red];
		3565 -> 3567;
	3566 [label="まぁ。*今*のところはな。",shape=box,color=blue];
		3566 -> 3568;
	3567 [label="そうさせてもらう。",shape=box,color=blue];
		3567 -> 3568;
	3568 [label="少なくとも、拳銃で自分の足に穴開けたら俺のヘマだって分かる。",shape=box,color=blue];
		3568 -> 3569;
	3569 [label="銃が忠誠を考え直したからでも、真夜中に空腹に襲われたからでもないからな。",shape=box,color=blue];
		3569 -> 3570;
	3570 [label="Chat ends.",color=orange];
}