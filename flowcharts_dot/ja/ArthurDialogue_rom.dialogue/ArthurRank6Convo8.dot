		j4019178423 -> j2530751135;
		j4019178423 -> j434265518;
	j2530751135 [label="無知で彼が傷つくコトも*ありえる*よね？<RETRO_EMOJI_COOLARMSUP>",shape=box,color=red];
		j2530751135 -> j3355903746;
	j434265518 [label="（笑）そんなの考えもしなかった。",shape=box,color=red];
		j434265518 -> j3122317345;
	j3355903746 [label="その通りだ。もちろん伝えるつもりはない。",shape=box,color=blue];
		j3355903746 -> j7236166;
	j3122317345 [label="種明かしをするつもりもない。ただ、奴の中で何が想定されてるのか想像もできん。",shape=box,color=blue];
		j3122317345 -> j7236166;
	j7236166 [label="俺たちの周りでハラハラするのもムリはない。ハッ！　可哀そうにも思える。",shape=box,color=blue];
		j7236166 -> j3166292603;
