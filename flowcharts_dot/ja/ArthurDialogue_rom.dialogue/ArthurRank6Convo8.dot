	j2849756334 [label="お？　何が？",shape=box,color=red];
		j2849756334 -> j3659706829;
	j3659706829 [label="Vodyanoiは転移の仕組みについて何も知らない。",shape=box,color=blue];
		j3659706829 -> j3892420765;
	j3892420765 [label="お前はケント・クラークとスーパーガイみたいなもので、奴は複数のWarframeを同時に見たことがない。",shape=box,color=blue];
		j3892420765 -> j4019178423;
