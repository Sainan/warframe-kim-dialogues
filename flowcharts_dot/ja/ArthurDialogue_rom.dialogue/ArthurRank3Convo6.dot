	1216 [label="へっ。",shape=box,color=blue];
		1216 -> 1218;
	1219 [label="隠れ場所が欲しかったせいか、デュヴィリで偶然、子供の頃の寝室を召喚しちゃったんだ。",shape=box,color=red];
		1219 -> 1227;
	1220 [label="ある時、Lodunに首を刎ねられたら頭が超飛んで木に引っかかったんだ！",shape=box,color=red];
		1220 -> 1226;
	1221 [label="ケイスの正しい乗り方を覚えるために687回もループしたんだ。",shape=box,color=red];
		1221 -> 1225;
	1222 [label="いや、自分はパス。けどセバスチャンについて教えてくれてありがと。",shape=box,color=red];
		1222 -> 1223;
	1227 [label="そこから脱出する方法を見つけるまでに、どれだけ寝室を召喚したか分からないくらいだ。",shape=box,color=red];
