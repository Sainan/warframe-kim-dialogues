digraph {
	1188 [label="ArthurRank3Convo6 begins.",color=orange];
		1188 -> 1189;
	1189 [label="秘密の人質交換をしようぜ。",shape=box,color=blue];
		1189 -> 1190;
		1189 -> 1191;
	1190 [label="何それ？（笑）",shape=box,color=red];
		1190 -> 1192;
	1191 [label="過去って奇妙な所だなぁ。",shape=box,color=red];
		1191 -> 1192;
	1192 [label="へへ。んでだ。これは俺がブリタニア軍にいた頃やってたゲームなんだ。",shape=box,color=blue];
		1192 -> 1193;
	1193 [label="そっちが恥ずかしい秘密を話して、そしてこっちが自分の分を話すんだよ。",shape=box,color=blue];
		1193 -> 1194;
	1194 [label="お互いが相手の秘密を人質にするんだ。",shape=box,color=blue];
		1194 -> 1195;
	1195 [label="秘密の人質。「信頼の証」だ。まず俺から話そう。",shape=box,color=blue];
		1195 -> 1196;
		1195 -> 1197;
		1195 -> 1198;
	1196 [label="普通ならアスレチックで協力プレイでもすればいいと思うけど…　まぁ了解。",shape=box,color=red];
		1196 -> 1202;
	1197 [label="はいはい。付き合うよ。",shape=box,color=red];
		1197 -> 1202;
	1198 [label="やだね。やらないよ。",shape=box,color=red];
		1198 -> 1199;
	1202 [label="まずは俺からだ。セバスチャンって名前のテディベアを持っている。",shape=box,color=blue];
		1202 -> 1203;
	1199 [label="好きにしろ。",shape=box,color=blue];
		1199 -> 1200;
	1203 [label="夜中に抱き着いているんだと勘違いされる前に言っておくが、していないぞ。",shape=box,color=blue];
		1203 -> 1204;
	1200 [label="Chat ends.",color=orange];
	1204 [label="何年も前、任務中に爆撃された住宅街で見つけたんだ。",shape=box,color=blue];
		1204 -> 1205;
	1205 [label="アイツは棚に飾っている。それで話し相手が誰もいない時はな？",shape=box,color=blue];
		1205 -> 1206;
	1206 [label="アイツに話しかけるんだ。薄汚いご老体にな。俺の頭をマトモに保ってくれる。",shape=box,color=blue];
		1206 -> 1201;
		1206 -> 1207;
		1206 -> 1208;
	1201 [label="マジでウケる！",shape=box,color=red];
		1201 -> 1214;
	1207 [label="それは…　超絶かわいいね。",shape=box,color=red];
		1207 -> 1211;
	1208 [label="自分もいつかセバスチャンを抱きしめていい？",shape=box,color=red];
		1208 -> 1210;
	1214 [label="そうかそうか。",shape=box,color=blue];
		1214 -> 1213;
	1211 [label="可愛すぎて死にそう。",shape=box,color=red];
		1211 -> 1212;
	1210 [label="+20 Chemistry",color=orange];
		1210 -> 1209;
	1213 [label="めっちゃ笑いすぎて漏らしそう（笑）",shape=box,color=red];
		1213 -> 1215;
	1212 [label="ビックリでいっぱいだ、Arthurは。",shape=box,color=red];
		1212 -> 1217;
	1209 [label="断る理由がないな。",shape=box,color=blue];
		1209 -> 1218;
