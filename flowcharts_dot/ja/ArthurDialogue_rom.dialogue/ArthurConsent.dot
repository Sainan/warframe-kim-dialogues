	3612 [label="Chat ends.",color=orange];
	3613 [label="Arthur、話せる？[複数のパートナーについて同意を得る]",shape=box,color=red];
		3613 -> 3615;
	3611 [label="[閉じる]",shape=box,color=red];
		3611 -> 3614;
	3610 [label="Chat ends.",color=orange];
	3615 [label="もちろんだ。どうした？",shape=box,color=blue];
		3615 -> 3617;
	3614 [label="Update boolean ArthurConsentComplete",color=orange];
		3614 -> 3616;
	3617 [label="いや、その。不快にさせなければいいけど、話さないといけないことがある。",shape=box,color=red];
		3617 -> 3618;
	3616 [label="Chat ends.",color=orange];
	3618 [label="納得できない状況にArthurを置きたくない。こう言った話はしたことがないから。もしダメなら、そう言ってほしい。",shape=box,color=red];
		3618 -> 3619;
	3619 [label="自分たちの関係は大切に思っている。本当に。切実に。それだけはわかってほしい。",shape=box,color=red];
		3619 -> 3620;
	3620 [label="なるほど。話の先が見えてきた。他に好きな人ができたのか？",shape=box,color=blue];
		3620 -> 3621;
		3620 -> 3622;
	3621 [label="そう。理解しにくいかもだけど、Arthurへの気持ちが薄れたわけじゃない。",shape=box,color=red];
		3621 -> 3623;
	3622 [label="そう。そして、関係をここで終わりにしよう。[別れる]",shape=box,color=red];
		3622 -> 3624;
	3623 [label="何年も軍に所属していた俺が、色んな人間関係を見てこなかったと思うか？",shape=box,color=blue];
		3623 -> 3625;
	3624 [label="それをお前が望むなら…",shape=box,color=blue];
		3624 -> 3626;
	3625 [label="死と直面する機会が多いと、人生で何が大切でそうでないか知るようになる。",shape=box,color=blue];
		3625 -> 3627;
	3626 [label="Update boolean IsDating",color=orange];
		3626 -> 3628;
	3627 [label="ライン引きで迷うことはない。俺はお前を支える。",shape=box,color=blue];
		3627 -> 3629;
	3628 [label="Update boolean ArthurDating",color=orange];
		3628 -> 3630;
	3629 [label="俺にとってお前は大切な存在だ。お前が彼らを大切と思うなら、俺にとっても大切だ。",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="Chat ends.",color=orange];
	3631 [label="ただ、その。ヘックスメンバーとの二股はよしてくれ。「家族内」でこう言ったことは、ごめんだ。",shape=box,color=blue];
		3631 -> 3632;
	3632 [label="考えるだけでも恐ろしい。",shape=box,color=blue];
		3632 -> 3634;
		3632 -> 3633;
	3634 [label="笑。約束する。",shape=box,color=red];
		3634 -> 3636;
	3633 [label="きっとArthurも気に入ると思う。",shape=box,color=red];
		3633 -> 3635;
	3636 [label="ありがとう。いつか会えるといいな。他意は…　なしでな。",shape=box,color=blue];
		3636 -> 3637;
	3635 [label="いつか会えるといいな。他意は…　なしでな。",shape=box,color=blue];
		3635 -> 3637;
	3637 [label="+20 Chemistry",color=orange];
		3637 -> 3638;
	3638 [label="ただ無事でいてくれ、ハニー。",shape=box,color=blue];
		3638 -> 3639;
	3639 [label="Update boolean ArthurConsentComplete",color=orange];
		3639 -> 3640;
