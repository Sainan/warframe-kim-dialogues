	j972778441 [label="Check boolean ArthurPolyamorySuccess",color=orange];
		j972778441 -> j1569221931 [label=true,color=green];
		j972778441 -> "Chat ends." [label=false,color=brown];
	j2726238991 [label="Arthur、話せる？[複数のパートナーについて同意を得る]",shape=box,color=red];
		j2726238991 -> j2165356787;
	j2423991248 [label="[閉じる]",shape=box,color=red];
		j2423991248 -> j3652224286;
	j2165356787 [label="もちろんだ。どうした？",shape=box,color=blue];
		j2165356787 -> j1110443832;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j1110443832 [label="いや、その。不快にさせなければいいけど、話さないといけないことがある。",shape=box,color=red];
		j1110443832 -> j525525278;
	j525525278 [label="納得できない状況にArthurを置きたくない。こう言った話はしたことがないから。もしダメなら、そう言ってほしい。",shape=box,color=red];
		j525525278 -> j2191316589;
	j2191316589 [label="自分たちの関係は大切に思っている。本当に。切実に。それだけはわかってほしい。",shape=box,color=red];
		j2191316589 -> j193019274;
	j193019274 [label="なるほど。話の先が見えてきた。他に好きな人ができたのか？",shape=box,color=blue];
		j193019274 -> j1930428349;
		j193019274 -> j3718659717;
	j1930428349 [label="そう。理解しにくいかもだけど、Arthurへの気持ちが薄れたわけじゃない。",shape=box,color=red];
		j1930428349 -> j1910348418;
	j3718659717 [label="そう。そして、関係をここで終わりにしよう。[別れる]",shape=box,color=red];
		j3718659717 -> j1438197897;
	j1910348418 [label="何年も軍に所属していた俺が、色んな人間関係を見てこなかったと思うか？",shape=box,color=blue];
		j1910348418 -> j3501616797;
	j1438197897 [label="それをお前が望むなら…",shape=box,color=blue];
		j1438197897 -> j3701883258;
	j3501616797 [label="死と直面する機会が多いと、人生で何が大切でそうでないか知るようになる。",shape=box,color=blue];
		j3501616797 -> j3920211981;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j3920211981 [label="ライン引きで迷うことはない。俺はお前を支える。",shape=box,color=blue];
		j3920211981 -> j2301563576;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j2301563576 [label="俺にとってお前は大切な存在だ。お前が彼らを大切と思うなら、俺にとっても大切だ。",shape=box,color=blue];
		j2301563576 -> j3668205960;
	j3668205960 [label="ただ、その。ヘックスメンバーとの二股はよしてくれ。「家族内」でこう言ったことは、ごめんだ。",shape=box,color=blue];
		j3668205960 -> j4255460767;
	j4255460767 [label="考えるだけでも恐ろしい。",shape=box,color=blue];
		j4255460767 -> j382770295;
		j4255460767 -> j1651059075;
	j382770295 [label="笑。約束する。",shape=box,color=red];
		j382770295 -> j265608075;
	j1651059075 [label="きっとArthurも気に入ると思う。",shape=box,color=red];
		j1651059075 -> j1692496816;
	j265608075 [label="ありがとう。いつか会えるといいな。他意は…　なしでな。",shape=box,color=blue];
		j265608075 -> j2155278510;
	j1692496816 [label="いつか会えるといいな。他意は…　なしでな。",shape=box,color=blue];
		j1692496816 -> j2155278510;
	j2155278510 [label="+20 Chemistry",color=orange];
		j2155278510 -> j1128460047;
	j1128460047 [label="ただ無事でいてくれ、ハニー。",shape=box,color=blue];
		j1128460047 -> j3652224286;
}