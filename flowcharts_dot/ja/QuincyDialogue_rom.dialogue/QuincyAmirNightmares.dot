	1896 [label="彼はどう反応した…？",shape=box,color=red];
		1896 -> 1916;
	1930 [label="高揚させる…　話だね。",shape=box,color=red];
		1930 -> 1916;
	1916 [label="話してすぐは、長い時間何も言わなかった。オレたちはただジッと座っていた",shape=box,color=blue];
		1916 -> 1927;
	1927 [label="それでアイツは…　最近見る悪夢の話をした",shape=box,color=blue];
		1927 -> 1894;
	1894 [label="それと兵士じゃないから場違いと感じていたことも",shape=box,color=blue];
		1894 -> 1890;
	1890 [label="オレはアイツに昔よく見た悪夢の話をした。ガキの頃見た悪夢だ",shape=box,color=blue];
		1890 -> 1891;
	1891 [label="そしてアイツに、これまで酷い扱いをしてきたことを詫びた",shape=box,color=blue];
		1891 -> 1895;
	1895 [label="ここには他の奴ら同様、アイツの居場所があると。アイツにはアイツなりの振る舞い方があるように、オレにはオレなりの振る舞い方があると。それがオレたちだって",shape=box,color=blue];
