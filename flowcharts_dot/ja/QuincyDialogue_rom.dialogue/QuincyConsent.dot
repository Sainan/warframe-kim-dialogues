	j1109221573 [label="話したいことがある。Quincyの意見を聞きたいんだ。",shape=box,color=red];
		j1109221573 -> j2383123628;
	j2383123628 [label="Quincyに嘘をついているとか、不誠実だと思わせたくないから。",shape=box,color=red];
		j2383123628 -> j1461284036;
	j1461284036 [label="笑笑 なにやらかしたんだよ",shape=box,color=blue];
		j1461284036 -> j806349439;
	j806349439 [label="オウサマでも殺しちまったか？",shape=box,color=blue];
		j806349439 -> j1500772393;
	j1500772393 [label="いやいやいや、Arthurは生きてるよ。不快にさせなければいいけど、話さないといけないことがある。",shape=box,color=red];
		j1500772393 -> j3089482229;
	j3089482229 [label="納得できない状況にQuincyを置きたくない。もしダメなら、そう言ってほしい。",shape=box,color=red];
		j3089482229 -> j1493809736;
	j1493809736 [label="自分たちの関係は大切に思っている。本当に。切実に。それだけはわかってほしい。",shape=box,color=red];
		j1493809736 -> j1148984836;
	j1148984836 [label="Check boolean QuincyForgiven",color=orange];
		j1148984836 -> j92438924 [label=true,color=green];
		j1148984836 -> j27601584 [label=false,color=brown];
	j92438924 [label="おいおいおいベイビー、別のシマで恋人ができたってか？",shape=box,color=blue];
		j92438924 -> j3431647892;
	j27601584 [label="おいおいおいベイビー、別のシマでヨロシクやっているってか？",shape=box,color=blue];
		j27601584 -> j3747353812;
	j3431647892 [label="行き過ぎる前にQuincyの許しがほしくて話にきた。がっかりさせたくないし、こう言った話はしたことがないから。",shape=box,color=red];
		j3431647892 -> j3932137077;
	j3747353812 [label="行き過ぎる前にQuincyの許しがほしくて話にきた。がっかりさせたくないし、こう言った話はしたことがないから。",shape=box,color=red];
		j3747353812 -> j3843269468;
	j3932137077 [label="誰ががっかりするって？　ピンク髪に頼んで相乗りできないか考えてたんだ",shape=box,color=blue];
		j3932137077 -> j291580949;
	j3843269468 [label="イヤイヤ、やり手なのはリスペクトできるぜ",shape=box,color=blue];
		j3843269468 -> j2586423203;
	j291580949 [label="でもマジな話、わかるぜ。マジで。一つの愛からまた別の愛へ、オマエにはそれができるデカいハートがあるってことだ、恥ずかしいことじゃない",shape=box,color=blue];
		j291580949 -> j452349548;
	j2586423203 [label="でもマジな話、わかるぜ。マジで。一本の木から別の木へ、オマエにはそれができるデカいハートがあるってことだ、恥ずかしいことじゃない",shape=box,color=blue];
		j2586423203 -> j3674659025;
	j452349548 [label="+20 Chemistry",color=orange];
		j452349548 -> j167224602;
	j3674659025 [label="+20 Chemistry",color=orange];
		j3674659025 -> j2755854223;
	j167224602 [label="オレたちがまだ一緒にいられるって言うなら信じるぜ",shape=box,color=blue];
		j167224602 -> j873726553;
	j2755854223 [label="オレたちがまだヨロシクできるって言うなら信じるぜ",shape=box,color=blue];
		j2755854223 -> j873726553;
	j873726553 [label="ただ他のヘックスやラウンドテーブルを変な目で見るんじゃねぇぞ",shape=box,color=blue];
		j873726553 -> j1438698513;
	j1438698513 [label="特にヘックスはなしだ、マジでイカレちまう",shape=box,color=blue];
