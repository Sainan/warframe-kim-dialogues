		3976 -> 3977;
	3977 [label="いやいやいや、Arthurは生きてるよ。不快にさせなければいいけど、話さないといけないことがある。",shape=box,color=red];
		3977 -> 3978;
	3978 [label="納得できない状況にQuincyを置きたくない。もしダメなら、そう言ってほしい。",shape=box,color=red];
