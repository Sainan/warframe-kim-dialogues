		2342 -> 2346;
		2342 -> 2345;
	2346 [label="Vala Glariosという女性がいる。元々は部下の一人に過ぎなかった。彼女は復讐に飢え戦いを挑んできたが、船もろとも沈んでいった。",shape=box,color=red];
		2346 -> 2347;
	2345 [label="彼にはシスターと呼ぶ近衛隊がいる。彼女らを誇りに思っているようだ。家族だと思っている。",shape=box,color=red];
		2345 -> 2349;
	2347 [label="ParvosはVoidにポケットのような空間を…　これは長くなるから飛ばすけど、彼は彼女の命を救った。彼女を評価しているんだと思う。大切にしている。シスターだと。",shape=box,color=red];
		2347 -> 2348;
	2349 [label="正直、ちょっとカルトっぽい。でもそれもそうか。それがお金の力だから。",shape=box,color=red];
