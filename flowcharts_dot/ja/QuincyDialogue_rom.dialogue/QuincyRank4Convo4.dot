		2357 -> 2359;
	2358 [label="彼は自身に価値のある人だけを周りに置いている。負荷となった途端解雇するだろう。",shape=box,color=red];
		2358 -> 2361;
	2355 [label="だからと言って、彼が冷酷で嫌な奴ではないわけじゃない。自分は彼を信用していないし、支持するやつらと対面することも多い。",shape=box,color=red];
		2355 -> 2361;
