		2354 -> 2357;
		2354 -> 2358;
		2354 -> 2355;
		2354 -> 2356;
	2361 [label="ソイツが英雄だって言ってるんじゃねえ、そんなもんこの世界に存在しねえ。オレが言いたいのは、ソイツには幸せになる手段と、大切なものを守る力があるってコトだ",shape=box,color=blue];
