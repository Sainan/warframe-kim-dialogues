	2348 [label="そして彼女もParvosを家族と認識している。",shape=box,color=red];
		2348 -> 2353;
	2351 [label="カネがあれば忠誠も買える。金のカルトより古いもんはないしな",shape=box,color=blue];
		2351 -> 2350;
		2351 -> 2352;
	2353 [label="純粋な悪や純粋な善なんてねえんだ。ソイツは誰が本当の家族かワカってるようだな。",shape=box,color=blue];
		2353 -> 2354;
	2350 [label="Quincyがあいつに似すぎていて嫌だな。人生お金が全てじゃないのに。",shape=box,color=red];
		2350 -> 2361;
	2352 [label="二人は気が合うと思う。怖いくらいに。",shape=box,color=red];
