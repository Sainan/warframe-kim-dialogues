		j532668892 -> j1865320345;
	j1865320345 [label="ดังนั้นเลยส่งรูปเปลือยของตัวเองที่ลูอายังต้องเขินอาย เพราะคิดว่าตัวเองรู้สึกเชื่อมโยงกับใครบางคนที่พบในอินเทอร์เน็ต และสามารถไว้ใจแฟนทางออนไลน์ได้ ",shape=box,color=blue];
		j1865320345 -> j2858873022;
	j2858873022 [label="และในวันรุ่งขึ้น ภาพนั้นก็ปรากฏอยู่ทุกที่ ทุกคนในมหาวิทยาลัยได้เห็น แชร์ ส่งให้อาจารย์ ทั่วทั้งอินเทอร์เน็ต ทั่วประเทศที่ไม่เคยรู้เลยว่ามีอยู่ด้วยซ้ำ",shape=box,color=blue];
		j2858873022 -> j2278716469;
	j2278716469 [label="หนูอาจจะเป็นคนที่ฉลาดที่สุดในก้อนหินแห่งนี้แต่ทุกคนจะจำหนูได้แค่รูปนั่น",shape=box,color=blue];
		j2278716469 -> j1916201448;
	j1916201448 [label="เพราะอย่างนั้นเมื่อหนูบอกว่าจะออกไปจากที่นี่ ก็หมายความอย่างนั้นจริง ๆ ก็รู้แหละว่าภาพนั้นไม่มีความหมายอะไร อนาคตต้องก้าวต่อไป ผู้คนต่างก็จะมีความสุข",shape=box,color=blue];
		j1916201448 -> j1775749569;
	j1775749569 [label="แต่สำหรับหนูแล้ว มันทำลายชีวิตหนู หนูอยากใช้ชีวิตในอนาคตที่ไม่มีอินเทอร์เน็ต อยากพิสูจน์ว่าสามารถก้าวไปข้างหน้าจากเรื่องนี้ได้ การย้อนเวลากลับไปจะพิสูจน์ได้ว่าคนเหล่านั้นพูดถูกและหนูไม่สามารถก้าวข้ามไปได้",shape=box,color=blue];
		j1775749569 -> j1476409354;
