		541 -> 542;
	542 [label="คุณอยากรู้ว่ามันเป็นยังไงใช่ไหม? อินเทอร์เน็ตเข้ามาและสัญญาอะไรกับเราไว้มากมาย",shape=box,color=blue];
		542 -> 543;
	543 [label="คุณคือหนู เด็กอายุ 18 เริ่มท่องออนไลน์ และเริ่มแชตกับเพื่อนใหม่ทุกที่!",shape=box,color=blue];
		543 -> 544;
	544 [label="และสำหรับคนที่เรียกว่า 'สาวฉลาด' อย่างหนู กลับทำสิ่งที่โง่เขลาที่สุดเท่าที่เคยมีมาบนอินเทอร์เน็ต ",shape=box,color=blue];
		544 -> 545;
	545 [label="คือการไว้ใจคนที่อยู่ฝั่งตรงข้าม ",shape=box,color=blue];
		545 -> 546;
	546 [label="และมองดูเทคโนโลยีใหม่ทั้งหมดนี้และลืมไปว่ามนุษย์ก็ยังคงเป็นมนุษย์ ",shape=box,color=blue];
		546 -> 547;
	547 [label="ดังนั้นเลยส่งรูปเปลือยของตัวเองที่ลูอายังต้องเขินอาย เพราะคิดว่าตัวเองรู้สึกเชื่อมโยงกับใครบางคนที่พบในอินเทอร์เน็ต และสามารถไว้ใจแฟนทางออนไลน์ได้ ",shape=box,color=blue];
		547 -> 548;
	548 [label="และในวันรุ่งขึ้น ภาพนั้นก็ปรากฏอยู่ทุกที่ ทุกคนในมหาวิทยาลัยได้เห็น แชร์ ส่งให้อาจารย์ ทั่วทั้งอินเทอร์เน็ต ทั่วประเทศที่ไม่เคยรู้เลยว่ามีอยู่ด้วยซ้ำ",shape=box,color=blue];
		548 -> 549;
	549 [label="หนูอาจจะเป็นคนที่ฉลาดที่สุดในก้อนหินแห่งนี้แต่ทุกคนจะจำหนูได้แค่รูปนั่น",shape=box,color=blue];
		549 -> 550;
	550 [label="เพราะอย่างนั้นเมื่อหนูบอกว่าจะออกไปจากที่นี่ ก็หมายความอย่างนั้นจริง ๆ ก็รู้แหละว่าภาพนั้นไม่มีความหมายอะไร อนาคตต้องก้าวต่อไป ผู้คนต่างก็จะมีความสุข",shape=box,color=blue];
		550 -> 551;
	551 [label="แต่สำหรับหนูแล้ว มันทำลายชีวิตหนู หนูอยากใช้ชีวิตในอนาคตที่ไม่มีอินเทอร์เน็ต อยากพิสูจน์ว่าสามารถก้าวไปข้างหน้าจากเรื่องนี้ได้ การย้อนเวลากลับไปจะพิสูจน์ได้ว่าคนเหล่านั้นพูดถูกและหนูไม่สามารถก้าวข้ามไปได้",shape=box,color=blue];
		551 -> 552;
	552 [label="เพราะงั้นรอก่อนนะ แล้วจะได้เห็นหนูในที่ที่คุณจากมา ",shape=box,color=blue];
		552 -> 553;
	553 [label="และเราสามารถมองโลกและหัวเราะได้ว่าการตัดสินใจนี้ไม่ได้ทำลายหนู แต่มันทำให้ฉลาดขึ้น ฉลาดพอที่จะออกจากโลกนี้ไปได้",shape=box,color=blue];
		553 -> 554;
	554 [label="+20 Chemistry",color=orange];
