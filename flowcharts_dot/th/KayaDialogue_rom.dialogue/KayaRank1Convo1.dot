digraph {
	0 [label="KayaRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="สวัสดี ทุกคนเดินทางข้ามเวลาได้หรือเปล่า หรือมีแค่คุณ",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="อืม สวัสดีด้วยละกัน ฟังนะ ยัยหนู เรื่องนี้มันไม่ได้ง่ายขนาดนั้น",shape=box,color=red];
		2 -> 4;
	3 [label="ว่าไง Kaya เป็นไงบ้างวันนี้?",shape=box,color=red];
		3 -> 5;
	4 [label="หนูไม่ใช่เด็กนะ อายุ 19 แล้ว",shape=box,color=blue];
		4 -> 6;
		4 -> 7;
	5 [label="อือ ",shape=box,color=blue];
		5 -> 8;
	6 [label="ก็ใช่ แต่ในกลุ่มนี้ก็เป็นคนที่เด็กที่สุดอยู่ดีนะ ยัยหนู",shape=box,color=red];
		6 -> 9;
	7 [label="อือ อือ อย่ารีบร้อนถามเรื่องการเดินทางข้ามเวลานักเลย มัน... ซับซ้อนน่ะ",shape=box,color=red];
		7 -> 10;
	8 [label="งั้นก็แค่คุณคนเดียว หรือยังมีคนอื่นอีก? แล้วในอนาคตมีสอนเรื่องนี้ในโรงเรียนหรือเปล่า?",shape=box,color=blue];
		8 -> 11;
	9 [label="เฮ้อ เด็กสุดก็จริง แต่ก็เป็นคนที่ตั้งใจจะหาคำตอบมากที่สุดเหมือนกัน และพยายามจะตามทุกเรื่องให้ทัน ตกลงแล้วเรื่องเดินทางข้ามเวลาน่ะ มันทำยังไง? ใครทำได้บ้าง?",shape=box,color=blue];
		9 -> 12;
	10 [label="โอ๊ย มันซับซ้อนยังไงล่ะ สูตรเหรอ หรือเคมีและองค์ประกอบอะตอม บอกมาสิเดี๋ยวจัดการเอง แค่ให้คำชี้แนะมาก็พอ",shape=box,color=blue];
		10 -> 13;
		10 -> 14;
	11 [label="สมมติว่ามีแค่ข้าคนเดียวละกัน จะได้ไม่ซับซ้อน",shape=box,color=red];
		11 -> 15;
	12 [label="แล้วทำไมต้องเป็นคุณ มีแผนอะไรบ้างหรือเปล่า? ",shape=box,color=blue];
		12 -> 16;
	13 [label="ไม่รู้จะอธิบายยังไงให้ฟังเหมือนกัน แต่มันไม่ได้เป็นแค่เรื่องของวิทยาศาสตร์ หรือถ้าใช่ ก็คงเป็นวิทยาศาสตร์ที่ Entrati เท่านั้นที่เข้าใจ",shape=box,color=red];
		13 -> 17;
	14 [label="นี่คือคำชี้แนะ: หยุด [จบ]",shape=box,color=red];
		14 -> 1022;
	15 [label="ส่วนเรื่องสอนในโรงเรียน ถ้ามีจริง ๆ ก็น่าจะไม่ได้เข้าเรียน แต่ก็อาจจะมีก็ได้นะ ",shape=box,color=red];
		15 -> 18;
	16 [label="ถ้าไม่มี งั้นช่วยแนะนำหน่อยสิว่าจะหาข้อมูลทางวิทยาศาสตร์เกี่ยวกับพลังของคุณได้จากที่ไหน",shape=box,color=blue];
		16 -> 19;
	17 [label="อ๊าก ไอ้หมอนั่น น่าจะถามให้เยอะกว่านี้ เอาเถอะ อย่างน้อยถ้ามันเป็นวิทยาศาสตร์ ก็หมายความว่าคงทำขึ้นมาใหม่ได้ และในเมื่อคุณเดินทางไปมาได้ หนูก็หาทางทำได้เหมือนกัน บาย",shape=box,color=blue];
		17 -> 20;
	1022 [label="+20 Chemistry",color=orange];
