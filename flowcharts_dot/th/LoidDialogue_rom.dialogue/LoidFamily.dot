	21 [label="Chat ends.",color=orange];
	22 [label="ข้าหวาดกลัวสิ่งที่ข้าต้องทำลงไปถึงกระดูก แท้จริงแล้ว นั่นอาจเป็นสิ่งที่ถูกพรากไป เมื่อข้าถูกฉีกเป็นชิ้นเล็กชิ้นน้อยด้วยความโกรธเกรี้ยว หาก Gomaitru และครอบครัวของนางค้นพบว่ามีอะไรเกิดขึ้นที่ใต้เท้าของพวกเขามาตลอด",shape=box,color=blue];
		22 -> 23;
	23 [label="แปลกจริง ๆ ที่เรียกนางด้วยชื่อนั้นในตอนนี้ แต่ระหว่างเรามีหลายสิ่งเปลี่ยนไปมาก และอีกไม่นานก็จะเปลี่ยนไปอีกมากมายเช่นกัน",shape=box,color=blue];
		23 -> 24;
		23 -> 25;
