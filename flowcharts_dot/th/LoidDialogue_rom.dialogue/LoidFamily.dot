		24 -> 26;
	25 [label="เจ้าทำเรื่องนี้ได้",shape=box,color=red];
		25 -> 26;
	26 [label="อืม ได้โปรดช่วยมาดูให้แน่ใจด้วยเถอะนะว่าเครื่องในของข้าไม่ได้ถูกเอาไปทำเป็นของตกแต่งเทศกาลในเนคราลิสก์ ข้าเกรงว่าเมื่อทุกอย่างเรียบร้อยแล้ว ข้าอาจต้องการความมั่นใจสักหน่อย",shape=box,color=blue];
		26 -> 27;
