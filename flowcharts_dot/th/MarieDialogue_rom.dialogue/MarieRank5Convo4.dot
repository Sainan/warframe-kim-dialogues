	j3750573947 [label="Merci, merci, merci !",shape=box,color=blue];
		j3750573947 -> j171133207;
	j3208239704 [label="Well ! When the time comes, I will be ready and waiting ! Until then, merci, mon cœur.",shape=box,color=blue];
		j3208239704 -> j3569999725;
	j549463413 [label="Well ! When the time comes, I will be ready and waiting ! Until then, merci.",shape=box,color=blue];
		j549463413 -> j3569999725;
	j2545548783 [label="I would never imply that since the devil seems to favor you, that perhaps he will listen to you where all others he seems to ignore.",shape=box,color=blue];
		j2545548783 -> j2712407306;
	j4102734153 [label="I am simply happy that you are happy. And if the devil has somewhere to spend his... efforts... all the better, non ?",shape=box,color=blue];
		j4102734153 -> j2630814230;
	j842909493 [label="Everyone in his life has tried to make him out to be some kind of monster. I suppose I'm the first person who hasn't.",shape=box,color=red];
		j842909493 -> j1881593101;
	j836580243 [label="There's a lot about him that he just doesn't know how to show. It's not armor, per se - but he doesn't trust people not to hurt him.",shape=box,color=red];
		j836580243 -> j1603881267;
	j474805922 [label="He's... had some real heartbreak in his many years. It's scabbed over with thorns, that's all.",shape=box,color=red];
		j474805922 -> j688488160;
	j1162327759 [label="I guess I can understand the amount of years he's lived. I've seen the same amount of death he has.",shape=box,color=red];
		j1162327759 -> j2047602151;
	j919081835 [label="He's only ever tried to do what was right. Maybe in the wrong way, sure - but he was trying to save the Origin System from the Orokin.",shape=box,color=red];
		j919081835 -> j2660064596;
	j2342335592 [label="I enjoy his wry sense of humor. He's clever, when you get past his ego.",shape=box,color=red];
		j2342335592 -> j2618000579;
	j171133207 [label="Well ! When the time comes, I will be ready and waiting ! Until then !",shape=box,color=blue];
		j171133207 -> j3569999725;
	j2712407306 [label="And never during private moments. Non. Jamais.",shape=box,color=blue];
		j2712407306 -> j530762186;
		j2712407306 -> j1276527345;
	j2630814230 [label="Even more so for us all if you serve as a bit of un ange upon his shoulder to temper him.",shape=box,color=blue];
		j2630814230 -> j2048943751;
		j2630814230 -> j653882434;
	j1881593101 [label="And I suppose I am atop that list of late, non ? I suppose I should... consider his reasons, for why he is the way he is. Condemnation saves no souls.",shape=box,color=blue];
		j1881593101 -> j3863628794;
	j1603881267 [label="There is always a pain we hide from those around us. Something we seek to shelter, for fear others will wield it. I suppose I should strive to be kinder to him, if what you say is true.",shape=box,color=blue];
		j1603881267 -> j3863628794;
	j688488160 [label="I cannot imagine the amount of love and loss one must suffer in all those years. It seems so unreal, even given all that I have seen.",shape=box,color=blue];
		j688488160 -> j1781329024;
	j2047602151 [label="Sometimes I forget, when I speak to him, how many centuries he has lived. It seems so unreal, even given all that I have seen.",shape=box,color=blue];
		j2047602151 -> j3613440902;
	j2660064596 [label="There are always... nuances, oui ? Always reasons for acting one way or another. I suppose I should strive to be kinder to him, if what you say is true.",shape=box,color=blue];
		j2660064596 -> j3863628794;
	j2618000579 [label="No one has ever denied the devil his wit.",shape=box,color=blue];
		j2618000579 -> j2141095481;
	j530762186 [label="ประหลาดใจนะเนี่ย ประทับใจมากเลย ",shape=box,color=red];
		j530762186 -> j1095943688;
	j1276527345 [label="I never knew you had this side to you.",shape=box,color=red];
		j1276527345 -> j1095943688;
	j2048943751 [label="ไม่รับปากนะ",shape=box,color=red];
		j2048943751 -> j1001129056;
	j653882434 [label="Who says I'm trying to temper him?",shape=box,color=red];
		j653882434 -> j1632492114;
	j3863628794 [label="+10 Chemistry",color=orange];
		j3863628794 -> j109003483;
	j1781329024 [label="Oui, what damage could that cause a soul ? I see why you would wish to find another who understood. And he, you.",shape=box,color=blue];
		j1781329024 -> j3863628794;
	j3613440902 [label="To have lived so long, to have seen so much death - to have paid so much of it yourself ?",shape=box,color=blue];
		j3613440902 -> j1781329024;
	j2141095481 [label="+5 Chemistry",color=orange];
		j2141095481 -> j109003483;
	j1001129056 [label="Add 1 to Thermostat counter",color=orange];
		j1001129056 -> j2945128303;
	j1632492114 [label="Add -1 to Thermostat counter",color=orange];
		j1632492114 -> j499605529;
	j109003483 [label="I am simply glad the devil has someone to speak with who might seek to temper him. Un ange upon his shoulder.",shape=box,color=blue];
		j109003483 -> j653882434;
		j109003483 -> j2048943751;
	j2945128303 [label="+10 Chemistry",color=orange];
		j2945128303 -> j2617418891;
	j499605529 [label="+10 Chemistry",color=orange];
		j499605529 -> j1524002402;
	j2617418891 [label="Oui, I fear there is a wickedness in him that cannot truly be cured. He enjoys it too much.",shape=box,color=blue];
		j2617418891 -> j104956296;
	j1524002402 [label="Perhaps you are right... what is un ange without son diable ? He reminds us all of what we should strive to avoid.",shape=box,color=blue];
		j1524002402 -> j104956296;
	j104956296 [label="Well ! If and when you convince the devil to aid us in our mission, I will be ready and waiting ! Until then !",shape=box,color=blue];
		j104956296 -> j3569999725;
