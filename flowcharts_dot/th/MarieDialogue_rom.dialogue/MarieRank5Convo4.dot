		j261556305 -> j500245191;
	j2110462445 [label="เราอาจต้องขอความช่วยเหลือจาก Roathe เพื่อโน้มน้าวให้ Loid ยอมคุยกับครอบครัว Entrati คิดว่าเขาคงไม่ยอมทำถ้าไม่มีการรับประกันว่าครอบครัวและตัวเขาเองจะได้รับการคุ้มครอง",shape=box,color=red];
		j2110462445 -> j3294542720;
	j1392205266 [label="ฉันเชื่อว่าคุณอาจพูดถูก ปีศาจอาจเป็นชิ้นส่วนที่หายไปที่เราต้องการ โอ้ย แค่พิมพ์อะไรแบบนี้ออกมาก็ทำให้ฉันเจ็บปวดแล้ว ! ",shape=box,color=blue];
		j1392205266 -> j409794056;
	j1088253059 [label="ยังคิดอะไรดี ๆ ที่ไม่เกี่ยวข้องกับการขอความช่วยเหลือจากแหล่งข้อมูลที่แย่ ๆ ไม่ออกเลย แหล่งที่อาจทำให้เราเดือดร้อนในภายหลัง ที่มีนามว่า Roathe",shape=box,color=red];
		j1088253059 -> j3595648359;
