		1673 -> 1666;
	1674 [label="และแม้คนอื่น ๆ จะด่วนโทษเขาสำหรับความเจ็บปวดที่เกิดขึ้น แต่ฉันไม่อยากเห็นเราแตกแยกและต้องทนทุกข์ทรมาน",shape=box,color=blue];
		1674 -> 1685;
	1676 [label="ฉันแซวเล่นนะ แค่แซวเล่น ! ฉันนึกไม่ออกเลยว่าคุณยุ่งมากแค่ไหน และมีกี่สถานที่ กี่ช่วงเวลา ที่คุณต้องไปช่วย",shape=box,color=blue];
		1676 -> 1678;
	1677 [label="ฉันแซวเล่นนะ แค่แซวเล่น ! ฉันนึกไม่ออกเลยว่าพวกเขาต้องผ่านอะไรมาบ้าง และมันยากแค่ไหนที่คุณต้องไปช่วยคลี่คลายปัญหาให้",shape=box,color=blue];
		1677 -> 1678;
	1678 [label="I simply worry that without their issues mended, we could never hope to be welcome at their table. The greater problem remains unsolved -",shape=box,color=blue];
		1678 -> 1637;
	1679 [label="คอยดูแลสถานที่แห่งนี้และหัวใจที่สูบฉีดพลังงานแห่งวอยด์เข้าสู่ระบบออริจิน ทำให้พวกเราทุกคน... สามารถใช้งานได้จริงนับตั้งแต่ที่ Entrati จากไป",shape=box,color=red];
		1679 -> 1687;
	2938 [label="I don't know as there's much of a market for Entrati's chairs...",shape=box,color=red];
		2938 -> 2942;
	2939 [label="Wouldn't we flood the market eventually? We'd have to sell them for pretty cheap...",shape=box,color=red];
		2939 -> 2942;
	2940 [label="เยี่ยมจริง ๆ มองไม่เห็นปัญหาอะไรเกี่ยวกับเรื่องนี้เลย",shape=box,color=red];
		2940 -> 2941;
	1680 [label="And while I understand the two topics are inexorably linked, I would ask you to keep it productive this day, oui ?",shape=box,color=blue];
		1680 -> 1688;
	1681 [label="นี่คุณกำลังหลอกลวงอะไรอยู่ หมาป่า หรือว่า Marie ตัวน้อยเป็นแค่ un jeu สำหรับคุณเท่านั้น",shape=box,color=blue];
		1681 -> 1689;
