		j2693966555 -> j2435704055;
	j2737532813 [label="ฉันรู้ว่าคุณอยู่ข้างฉันในสงครามเพื่อวิญญาณของ le Cardinal และขอขอบคุณชั่วนิรันดร์",shape=box,color=blue];
		j2737532813 -> j3051987037;
	j783367863 [label="ฉันรู้ว่าคุณกำลังยั้งใจไม่ให้ด่วนตัดสินเขา ซึ่งฉันรู้สึกขอบคุณอย่างยิ่ง",shape=box,color=blue];
		j783367863 -> j3051987037;
	j3051987037 [label="แม้คนอื่น ๆ จะด่วนโทษเขา แต่ฉันก็ไม่ต้องการเห็นเราแตกแยกและสูญเสียเลือดเนื้อ ในเมื่อเราสามารถเป็นหนึ่งเดียวกันได้",shape=box,color=blue];
		j3051987037 -> j496095902;
	j3827511004 [label="Oui แต่ฉันกำลังเรียนรู้ เช่นเดียวกับ M'sieur Tagfer ว่าบางทีทุกสถานการณ์ไม่ได้อยู่ในระดับเดียวกัน",shape=box,color=blue];
		j3827511004 -> j3705491200;
	j2463611103 [label="และฉันกำลังเรียนรู้ว่าทุกคนไม่ได้เจอสถานการณ์ในระดับเดียวกันอย่างที่คุณ \"กรุณา\" ชี้ให้ฉันทราบ non ?",shape=box,color=blue];
		j2463611103 -> j2435704055;
	j670324187 [label="Oui ใช่แล้ว ! ถึงแม้ว่าฉันจะไม่ตำหนิ le Cardinal ที่จากไป เพราะงานของเขาเป็น sacro-saint -",shape=box,color=blue];
		j670324187 -> j3051987037;
	j1050481209 [label="และฉันรู้ว่าคุณคิดว่า le Cardinal เป็น monstre ที่น่ากลัวที่ทำให้เกิดบาดแผลเช่นนี้",shape=box,color=blue];
		j1050481209 -> j2435704055;
	j2264519036 [label="และแม้คนอื่น ๆ จะด่วนโทษเขาสำหรับความเจ็บปวดที่เกิดขึ้น แต่ฉันไม่อยากเห็นเราแตกแยกและต้องทนทุกข์ทรมาน",shape=box,color=blue];
		j2264519036 -> j496095902;
	j1550999612 [label="ฉันแซวเล่นนะ แค่แซวเล่น ! ฉันนึกไม่ออกเลยว่าคุณยุ่งมากแค่ไหน และมีกี่สถานที่ กี่ช่วงเวลา ที่คุณต้องไปช่วย",shape=box,color=blue];
		j1550999612 -> j2306533703;
	j4018344331 [label="ฉันแซวเล่นนะ แค่แซวเล่น ! ฉันนึกไม่ออกเลยว่าพวกเขาต้องผ่านอะไรมาบ้าง และมันยากแค่ไหนที่คุณต้องไปช่วยคลี่คลายปัญหาให้",shape=box,color=blue];
		j4018344331 -> j2306533703;
	j2306533703 [label="I simply worry that without their issues mended, we could never hope to be welcome at their table. The greater problem remains unsolved -",shape=box,color=blue];
		j2306533703 -> j1553942120;
	j1186855991 [label="คอยดูแลสถานที่แห่งนี้และหัวใจที่สูบฉีดพลังงานแห่งวอยด์เข้าสู่ระบบออริจิน ทำให้พวกเราทุกคน... สามารถใช้งานได้จริงนับตั้งแต่ที่ Entrati จากไป",shape=box,color=red];
		j1186855991 -> j3987918241;
	j2158233649 [label="I don't know as there's much of a market for Entrati's chairs...",shape=box,color=red];
		j2158233649 -> j1236140688;
	j2086636113 [label="Wouldn't we flood the market eventually? We'd have to sell them for pretty cheap...",shape=box,color=red];
		j2086636113 -> j1236140688;
	j3381460573 [label="เยี่ยมจริง ๆ มองไม่เห็นปัญหาอะไรเกี่ยวกับเรื่องนี้เลย",shape=box,color=red];
		j3381460573 -> j3580658692;
	j2435704055 [label="And while I understand the two topics are inexorably linked, I would ask you to keep it productive this day, oui ?",shape=box,color=blue];
		j2435704055 -> j1569583015;
	j2866878358 [label="นี่คุณกำลังหลอกลวงอะไรอยู่ หมาป่า หรือว่า Marie ตัวน้อยเป็นแค่ un jeu สำหรับคุณเท่านั้น",shape=box,color=blue];
		j2866878358 -> j2006400328;
		j2866878358 -> j4246140194;
