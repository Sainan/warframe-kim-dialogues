	1661 [label="ฉันเข้าใจว่าคุณอาจไม่อยากพูดถึงการแก้ไขความขัดแย้งโดยไม่หาโอกาสที่จะชี้เป้าไปที่คนที่คุณรู้สึกว่าต้องเป็นคนรับผิดชอบ",shape=box,color=blue];
		1661 -> 1680;
	1657 [label="Oui ! อย่างที่คุณมักจะเตือนฉันอยู่เสมอ คุณเชื่อว่าเขาเป็น un monstre ! ในใจมีแต่ความเคียดแค้นและความว่างเปล่า !",shape=box,color=blue];
