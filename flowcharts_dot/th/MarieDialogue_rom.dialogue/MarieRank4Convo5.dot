		j3705491200 -> j556265827;
	j556265827 [label="ฉันไม่เห็นด้วยกับการตำหนิ le Cardinal เช่นกัน แต่ก็ไม่ต้องการเห็นเราแตกแยกและสูญเสียกันในเมื่อเราสามารถเป็นหนึ่งเดียวกันได้",shape=box,color=blue];
