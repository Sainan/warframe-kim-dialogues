		1667 -> 1666;
	1666 [label="แม้คนอื่น ๆ จะด่วนโทษเขา แต่ฉันก็ไม่ต้องการเห็นเราแตกแยกและสูญเสียเลือดเนื้อ ในเมื่อเราสามารถเป็นหนึ่งเดียวกันได้",shape=box,color=blue];
		1666 -> 1685;
	1675 [label="Oui แต่ฉันกำลังเรียนรู้ เช่นเดียวกับ M'sieur Tagfer ว่าบางทีทุกสถานการณ์ไม่ได้อยู่ในระดับเดียวกัน",shape=box,color=blue];
		1675 -> 1686;
	1669 [label="และฉันกำลังเรียนรู้ว่าทุกคนไม่ได้เจอสถานการณ์ในระดับเดียวกันอย่างที่คุณ \"กรุณา\" ชี้ให้ฉันทราบ non ?",shape=box,color=blue];
		1669 -> 1680;
	1670 [label="Oui ใช่แล้ว ! ถึงแม้ว่าฉันจะไม่ตำหนิ le Cardinal ที่จากไป เพราะงานของเขาเป็น sacro-saint -",shape=box,color=blue];
