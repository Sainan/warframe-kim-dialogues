		j1687201062 -> j3705491200;
	j2932310673 [label="อย่ามาพูดเรื่องสะเก็ดแผลกับฉันนะ หมาป่า หลังจากคุยกันเรื่อง le Cardinal คราวก่อน ฉันยังเลียแผลตัวเองอยู่เลย",shape=box,color=blue];
		j2932310673 -> j2435704055;
	j815215561 [label="Oui แต่อย่างที่คุณพูดไปแล้วว่า เราทุกคนต้องหยุดโทษกันเองเกี่ยวกับบาดแผลที่ทำให้เราทุกข์ทน",shape=box,color=blue];
		j815215561 -> j556265827;
