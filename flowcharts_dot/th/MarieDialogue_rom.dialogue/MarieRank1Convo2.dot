		64 -> 67;
	65 [label="โห ! ดริฟเตอร์ เขาเป็นคนที่เรียนรู้เร็วที่สุดเท่าที่ฉันเคยเจอเลยนะ ถ้าเป็นฉันน่ะ คงไม่กล้าท้าแข่งไขปริศนากับเขาโดยมีเงินเดิมพันแน่ ๆ",shape=box,color=blue];
		65 -> 67;
	66 [label="Non เขาค่อนข้างปรับตัวเข้ากับสิ่งใหม่ ๆ ได้ดีทีเดียว ฉันมั่นใจว่าอีกไม่นานเขาจะต้องไปศึกษา machines ambulantes ที่เดินย่ำไปมาอยู่ข้างล่างนั่นแล้วก็คงคิดสร้างแบบของตัวเองขึ้นมาแน่นอน",shape=box,color=blue];
		66 -> 67;
	67 [label="เขาแค่ยังไม่รู้จักคุณดีเท่านั้นเอง Lyon... เข้าสังคมไม่เก่งน่ะ เขาไม่ได้ขุ่นเคืองอะไรคุณหรอก",shape=box,color=blue];
		67 -> 68;
