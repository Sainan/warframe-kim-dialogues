	1376 [label="I cannot help but see, now, a minuscule copie who is so very alone... and a wolf who runs with a pack.",shape=box,color=blue];
		1376 -> 1383;
	1377 [label="It's hard, when you're raised to think that's your only purpose, your only existence, to break out of that mold. Purpose gives people comfort.",shape=box,color=red];
		1377 -> 1384;
	1378 [label="I think they would. There's a few of them who I've met who have proven to me that there's more to the Grineer than just war and death.",shape=box,color=red];
