		1391 -> 1398;
	1392 [label="Oui, you are correct. So many seek the faith in hopes it will give them just that - purpose. A direction.",shape=box,color=blue];
		1392 -> 1399;
	1393 [label="(So that is how it is spelled, merci !) That gives me such happiness to know. That even a race that was taught that is their only purpose, can find another.",shape=box,color=blue];
		1393 -> 1400;
	1386 [label="Now that is the spirit ! Even a devil deserves a bit of pastry now and then, I suppose.",shape=box,color=blue];
