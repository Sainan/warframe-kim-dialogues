	1286 [label="Chat ends.",color=orange];
	1292 [label="What do you mean?",shape=box,color=red];
		1292 -> 1301;
	1293 [label="I was in your shoes, once.",shape=box,color=red];
		1293 -> 1302;
	1288 [label="It's... just... hard to explain.",shape=box,color=red];
		1288 -> 1297;
	1289 [label="Too much to worry about. Too little time.",shape=box,color=red];
		1289 -> 1298;
	1290 [label="A friend of mine once described it as \"spiders.\" They creep in now and again.",shape=box,color=red];
		1290 -> 1299;
	1291 [label="Sometimes, everything... just gets to me. But I'll be okay.",shape=box,color=red];
