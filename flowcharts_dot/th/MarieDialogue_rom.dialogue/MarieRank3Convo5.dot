	3949 [label="ข้าพูดจริง ๆ นะ ขอโทษด้วยถ้าทำให้ไม่สบายใจ",shape=box,color=red];
		3949 -> 3951;
	3950 [label="ขอโทษนะ แค่ล้อเล่นน่ะ",shape=box,color=red];
		3950 -> 3951;
	1301 [label="I am une Sœur de Sol. I am not meant to be... fighting. Killing. The Murmure are not alive, or so the Cavia tell me - but what of the others that I face ?",shape=box,color=blue];
		1301 -> 1310;
	1302 [label="+5 Chemistry",color=orange];
		1302 -> 1311;
	1297 [label="Then I shall not pry. I know it is hard to put things into words, sometimes.",shape=box,color=blue];
		1297 -> 1306;
	1298 [label="There was a Sister at the Cathédrale much like this. She would fuss and fuss and fuss. I found her once polishing silver at three in the morning.",shape=box,color=blue];
		1298 -> 1307;
	1299 [label="Ah, oui. I think I know of what you speak. A kind of... cloud, that moves over the sun.",shape=box,color=blue];
		1299 -> 1308;
	1300 [label="Like a cup that fills with water, one drop at a time, non ?",shape=box,color=blue];
		1300 -> 1309;
	1303 [label="You did not need to tell me such a mensonge to know me.",shape=box,color=blue];
		1303 -> 1312;
	1304 [label="Je ne comprends pas votre humour. Perhaps in the future, \"funny\" is different ?",shape=box,color=blue];
		1304 -> 1313;
	1305 [label="I do not know what instinct drove you to tell me such a mensonge. ",shape=box,color=blue];
		1305 -> 1314;
	3951 [label="Bon, où en étais-je ?",shape=box,color=blue];
		3951 -> 1278;
	1310 [label="To fight in the name of Sol... is this to be my way ? Am I to be a killer in his name ? Moi, petite Marie ?",shape=box,color=blue];
		1310 -> 1319;
		1310 -> 1320;
	1311 [label="I know you are using une métaphore, but I am howling in laughter ! I do not think you could be in my shoes now if you tried !",shape=box,color=blue];
		1311 -> 1321;
	1306 [label="There are so many ways our days and our minds can go awry. It can find dark holes for us to become mired in, non ?",shape=box,color=blue];
		1306 -> 1315;
	1307 [label="I asked her why she was doing it, and she said she could not sleep, for she fretted too much.",shape=box,color=blue];
		1307 -> 1316;
	1308 [label="We have a word for this, ennui. A weariness and a discontent that makes all seem... pointless.",shape=box,color=blue];
		1308 -> 1317;
	1309 [label="It will become full and spill. Perhaps even tip its contents. And it all seems like une catastrophe. ",shape=box,color=blue];
		1309 -> 1318;
	1312 [label="A soul is more than the faith they wear. I am une Sœur de Sol, but I would hope you see more than that in me, non ?",shape=box,color=blue];
		1312 -> 1322;
	1313 [label="To me, it is not.",shape=box,color=blue];
		1313 -> 1323;
	1314 [label="I can only hope it was benign, and not a cruel joke at my expense. So, I shall choose to follow in the example of Sol -",shape=box,color=blue];
		1314 -> 1324;
	1319 [label="I wasn't trained to be a soldier. Not like the kid. Neither were you.",shape=box,color=red];
		1319 -> 1328;
	1320 [label="I wasn't... always like this. Always a fighter. I had to learn the hard way.",shape=box,color=red];
		1320 -> 1329;
	1321 [label="The image of it that is in my head will give me the fits. Before I cannot breathe, tell me - what are you referencing ?",shape=box,color=blue];
		1321 -> 1319;
		1321 -> 1320;
	1315 [label="We can only strive to be kind and patient with ourselves when it does.",shape=box,color=blue];
		1315 -> 1325;
	1316 [label="Each time I would find her in such a way, I would ask if she wanted companie. Sometimes she said yes, sometimes she said no.",shape=box,color=blue];
		1316 -> 1306;
	1317 [label="Or perhaps yours is a desire to hide, to weep, it is more like despair, I cannot say.",shape=box,color=blue];
		1317 -> 1335;
	1318 [label="You clean the mess, you right the cup... and it starts over again, oui ?",shape=box,color=blue];
		1318 -> 1327;
	1322 [label="There are as many topics that we could choose as there are stars in the sky !",shape=box,color=blue];
		1322 -> 1330;
		1322 -> 1331;
	1323 [label="Update boolean DrifterFaithSol",color=orange];
		1323 -> 1332;
	1324 [label="- whose faith I follow, whether or not you do, and forgive you. If you were like Lyon, I would tell you ten lashes was your payment.",shape=box,color=blue];
		1324 -> 1333;
	1328 [label="Oui ! The minuscule copie and their triste story... it makes me want to weep to think of it. To be turned into a machine of war by those they thought were famille ?",shape=box,color=blue];
		1328 -> 1337;
	1329 [label="Oui ! So I have heard, you suffered much to learn to fight as you do now. Death is a cruel tutor, I cannot imagine...",shape=box,color=blue];
		1329 -> 1337;
	1325 [label="I do not know if these words will matter to you. Or if they are only so many glowing dots upon a whirring piece of machinerie.",shape=box,color=blue];
		1325 -> 1334;
	1335 [label="I do not know this friend of yours, but I think - how good it is that they have you.",shape=box,color=blue];
		1335 -> 1306;
	1327 [label="There was a Father at the Chapel with a temperament much like yours, I think. He could withstand it all - until he could not.",shape=box,color=blue];
		1327 -> 1336;
	1330 [label="I'm sorry. It was a silly thing to do.",shape=box,color=red];
		1330 -> 1338;
	1331 [label="Do you forgive me, then?",shape=box,color=red];
		1331 -> 1339;
	1332 [label="Update boolean MarieNoDate",color=orange];
		1332 -> 1340;
	1333 [label="Update boolean DrifterFaithSol",color=orange];
		1333 -> 1341;
	1337 [label="Non. I would rather be as I am now. I chose to take le Cardinal's hand, the sérum he offered.",shape=box,color=blue];
		1337 -> 1343;
	1334 [label="Indeed, when you consider the reality of the thing, when I write these words, it could very well be days or many years since I have set them down, depending on when you are.",shape=box,color=blue];
		1334 -> 1342;
	1336 [label="When he became overwhelmed, and it all seemed a mess, I would ask if he wanted my companie. Des fois, oui, des fois, non.",shape=box,color=blue];
		1336 -> 1306;
	1338 [label="Update boolean DrifterFaithSol",color=orange];
		1338 -> 1344;
	1339 [label="Update boolean DrifterFaithSol",color=orange];
		1339 -> 1345;
	1340 [label="Chat ends.",color=orange];
	1341 [label="We are all just blind things, trying to find our way through this world.",shape=box,color=blue];
		1341 -> 1346;
	1343 [label="But you know the sadness that plagues me, the uncertainty. To not be born, or raised, into this life of war.",shape=box,color=blue];
		1343 -> 1348;
		1343 -> 1349;
	1342 [label="All that is to say, I understand it may feel hollow when I write that you are not alone.",shape=box,color=blue];
		1342 -> 1347;
	1344 [label="+10 Chemistry",color=orange];
		1344 -> 1350;
	1345 [label="+5 Chemistry",color=orange];
		1345 -> 1351;
	1346 [label="But I asked how you were. And the question still stands, petit mensonge ou non.",shape=box,color=blue];
		1346 -> 1352;
		1346 -> 1353;
		1346 -> 1354;
	1348 [label="Sometimes, I think about how much I had to discover on my own, and I get a little envious of the kid for the real training they had.",shape=box,color=red];
		1348 -> 1356;
	1349 [label="I think there's no \"good\" way to wind up in a life of war. To be born, or raised, or to choose it. In the end, it's about who you are and what you do with it.",shape=box,color=red];
		1349 -> 1357;
	1347 [label="Though those around you may seem distant or digital or sitting patiently for you to say hello.",shape=box,color=blue];
		1347 -> 1355;
	1350 [label="Oui, and if you were like Lyon, I would tell you ten lashes was your payment ! But you are not. And you are forgiven.",shape=box,color=blue];
