	1363 [label="Hah ! Oui, so it is. Très bien, I am glad to hear it.",shape=box,color=blue];
		1363 -> 1367;
	1365 [label="Oui, but then you would not be the rakish wolf we know and love, would you ? I think Sol put you right where you needed to be.",shape=box,color=blue];
		1365 -> 1369;
	1366 [label="Oui, I agree completely. No one is born for war. Well, save these \"Grin-ire\" I am told of, and even then...",shape=box,color=blue];
		1366 -> 1370;
	1364 [label="Des pâtisseries !",shape=box,color=blue];
		1364 -> 1368;
	1367 [label="Ah ! Luncheon is served. I must go. Until later, wolf. I am very glad we spoke.",shape=box,color=blue];
		1367 -> 1371;
	1369 [label="But I know what you mean. You see the structure and guidance your other was given, and you cannot help but wish you had the same. Especially when you were so very alone.",shape=box,color=blue];
		1369 -> 1376;
	1370 [label="I wonder if they would not pick another road if given a real choice to do so ?",shape=box,color=blue];
