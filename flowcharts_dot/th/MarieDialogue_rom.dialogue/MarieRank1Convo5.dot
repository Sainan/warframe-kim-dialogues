digraph {
	3964 [label="MarieRank1Convo5 begins.",color=orange];
		3964 -> 3965;
	3965 [label="Bonjour, bonjour ! คุณคงเป็นดริฟเตอร์สินะ oui ? Monsieur Loid เล่าเรื่องของคุณให้ฟังเยอะมาก ฉันดีใจมากที่ได้ \"พบ\" คุณในนี้...",shape=box,color=blue];
		3965 -> 3966;
	3966 [label="Appareil cliquetant แต่ก็ถือว่าฉลาดนะ !",shape=box,color=blue];
		3966 -> 3967;
	3967 [label="ฉันชื่อ Sœur Marie Leroux แต่เรียกฉันว่า Marie ก็ได้ ฉันเพิ่งมาที่นี่กับพี่ชายทางจิตวิญญาณนามว่า Father Lyon Allard และ... เอ่อ ฉันคิดว่า Monsieur Loid คงเตือนคุณเรื่องปีศาจแล้วสินะ n'est-ce pas ?",shape=box,color=blue];
		3967 -> 3968;
		3967 -> 3969;
		3967 -> 3970;
	3968 [label="ยินดีที่ได้รู้จัก แล้วก็อย่าเข้าใจผิดนะ คือว่า เรายินดีต้อนรับคุณ แต่... คุณมาทำอะไรที่นี่เหรอ",shape=box,color=red];
		3968 -> 3972;
	3969 [label="ปีศาจ? หมายถึง Orokin น่ะเหรอ",shape=box,color=red];
		3969 -> 3974;
	3970 [label="[จบ]",shape=box,color=red];
		3970 -> 3971;
	3972 [label="+5 Chemistry",color=orange];
		3972 -> 3973;
	3974 [label="Oui, เราได้รับความไว้วางใจจาก le Cardinal ที่ฝาก ce monstre irritant à la peau bleue ไว้กับเรา ฉันคิดว่าคุณรู้จักเขาในชื่อ Albrecht Entrati ? เขาเป็นเหตุผลที่เรามาอยู่ที่นี่ แต่นั่นเป็นเรื่องยาวมาก j'en ai bien peur",shape=box,color=blue];
		3974 -> 3975;
		3974 -> 3976;
	3971 [label="Chat ends.",color=orange];
	3973 [label="Merci ! ที่มาที่ไปว่าทำไมเราถึงมาที่นี่มันยาวมากเลยนะ j'en ai bien peur เราถูกส่งมาที่นี่โดย le Cardinal ฉันคิดว่าคุณรู้จักเขาในชื่อ Albrecht Entrati ? เขามอบความไว้วางใจให้เราคอยดู irritant monstrueux ผิวสีฟ้านั่น",shape=box,color=blue];
		3973 -> 3975;
		3973 -> 3976;
	3975 [label="เดี๋ยวข้าจะลองดูว่าทำอะไรได้บ้างนะ",shape=box,color=red];
		3975 -> 3980;
	3976 [label="\"ได้รับความไว้วางใจ?\"",shape=box,color=red];
		3976 -> 3977;
	3980 [label="+5 Chemistry",color=orange];
		3980 -> 3981;
	3977 [label="เราต้องทำทุกวิถีทางเพื่อชี้นำทางจิตวิญญาณของเขาให้ดีที่สุดเท่าที่จะทำได้ Et si ce n'est pas le cas ? อย่างน้อยที่สุดเราต้องมั่นใจว่าเขาจะไม่ก่ออันตรายใด ๆ อีกต่อไป",shape=box,color=blue];
		3977 -> 3978;
		3977 -> 3979;
	3981 [label="คุณเป็นเหมือนที่ Monsieur Loid กับ Cavia บรรยายไว้เลย ! ฉันคิดว่าเราคงเป็นเพื่อนที่ดีต่อกันได้แน่ ๆ",shape=box,color=blue];
		3981 -> 3983;
	3978 [label="ข้ายินดีที่จะช่วยนะ",shape=box,color=red];
		3978 -> 3980;
	3979 [label="เขาคือ Orokin วิธีเดียวที่เจ้าจะทำได้คือยิงกระสุนเข้าตรงกลางระหว่างดวงตา",shape=box,color=red];
		3979 -> 3982;
	3983 [label="โอ้ ! ฉันต้องไปแล้ว ขอตัวนะ หวังว่าเราจะได้คุยกันอีกเร็ว ๆ นี้ ! À la revoyure !",shape=box,color=blue];
		3983 -> 3984;
	3982 [label="คุณฟังดูเหมือน Lyon เลย แต่ฉันจะไม่หมดหวังหรอก ยังไม่ใช่ตอนนี้",shape=box,color=blue];
		3982 -> 3983;
	3984 [label="Chat ends.",color=orange];
}