digraph {
	"MarieRank1Convo5 begins." [color=orange];
		"MarieRank1Convo5 begins." -> j121384082;
	j121384082 [label="Bonjour, bonjour ! คุณคงเป็นดริฟเตอร์สินะ oui ? Monsieur Loid เล่าเรื่องของคุณให้ฟังเยอะมาก ฉันดีใจมากที่ได้ \"พบ\" คุณในนี้...",shape=box,color=blue];
		j121384082 -> j262366263;
	j262366263 [label="Appareil cliquetant แต่ก็ถือว่าฉลาดนะ !",shape=box,color=blue];
		j262366263 -> j3041916924;
	j3041916924 [label="ฉันชื่อ Sœur Marie Leroux แต่เรียกฉันว่า Marie ก็ได้ ฉันเพิ่งมาที่นี่กับพี่ชายทางจิตวิญญาณนามว่า Father Lyon Allard และ... เอ่อ ฉันคิดว่า Monsieur Loid คงเตือนคุณเรื่องปีศาจแล้วสินะ n'est-ce pas ?",shape=box,color=blue];
		j3041916924 -> j1914429882;
		j3041916924 -> j2823109226;
		j3041916924 -> j1610572375;
	j1914429882 [label="ยินดีที่ได้รู้จัก แล้วก็อย่าเข้าใจผิดนะ คือว่า เรายินดีต้อนรับคุณ แต่... คุณมาทำอะไรที่นี่เหรอ",shape=box,color=red];
		j1914429882 -> j194414751;
	j2823109226 [label="ปีศาจ? หมายถึง Orokin น่ะเหรอ",shape=box,color=red];
		j2823109226 -> j4277154470;
	j1610572375 [label="[จบ]",shape=box,color=red];
		j1610572375 -> "Chat ends.";
	j194414751 [label="+5 Chemistry",color=orange];
		j194414751 -> j3448024841;
	j4277154470 [label="Oui, เราได้รับความไว้วางใจจาก le Cardinal ที่ฝาก ce monstre irritant à la peau bleue ไว้กับเรา ฉันคิดว่าคุณรู้จักเขาในชื่อ Albrecht Entrati ? เขาเป็นเหตุผลที่เรามาอยู่ที่นี่ แต่นั่นเป็นเรื่องยาวมาก j'en ai bien peur",shape=box,color=blue];
		j4277154470 -> j1532276754;
		j4277154470 -> j1480847586;
	"Chat ends." [color=orange];
	j3448024841 [label="Merci ! ที่มาที่ไปว่าทำไมเราถึงมาที่นี่มันยาวมากเลยนะ j'en ai bien peur เราถูกส่งมาที่นี่โดย le Cardinal ฉันคิดว่าคุณรู้จักเขาในชื่อ Albrecht Entrati ? เขามอบความไว้วางใจให้เราคอยดู monstre irritant ผิวสีน้ำเงินนั่น",shape=box,color=blue];
		j3448024841 -> j1532276754;
		j3448024841 -> j1480847586;
	j1532276754 [label="เดี๋ยวข้าจะลองดูว่าทำอะไรได้บ้างนะ",shape=box,color=red];
		j1532276754 -> j542240873;
	j1480847586 [label="\"ได้รับความไว้วางใจ?\"",shape=box,color=red];
		j1480847586 -> j1521171271;
	j542240873 [label="+5 Chemistry",color=orange];
		j542240873 -> j3663611052;
	j1521171271 [label="เราต้องทำทุกวิถีทางเพื่อชี้นำทางจิตวิญญาณของเขาให้ดีที่สุดเท่าที่จะทำได้ Et si ce n'est pas le cas ? อย่างน้อยที่สุดเราต้องมั่นใจว่าเขาจะไม่ก่ออันตรายใด ๆ อีกต่อไป",shape=box,color=blue];
		j1521171271 -> j1690219723;
		j1521171271 -> j3840376547;
	j3663611052 [label="คุณเป็นเหมือนที่ Monsieur Loid กับ Cavia บรรยายไว้เลย ! ฉันคิดว่าเราคงเป็นเพื่อนที่ดีต่อกันได้แน่ ๆ",shape=box,color=blue];
		j3663611052 -> j356487337;
	j1690219723 [label="ข้ายินดีที่จะช่วยนะ",shape=box,color=red];
		j1690219723 -> j542240873;
	j3840376547 [label="เขาคือ Orokin วิธีเดียวที่เจ้าจะทำได้คือยิงกระสุนเข้าตรงกลางระหว่างดวงตา",shape=box,color=red];
		j3840376547 -> j1735195233;
	j356487337 [label="โอ้ ! ฉันต้องไปแล้ว ขอตัวนะ หวังว่าเราจะได้คุยกันอีกเร็ว ๆ นี้ ! À la revoyure !",shape=box,color=blue];
		j356487337 -> "Chat ends.";
	j1735195233 [label="คุณฟังดูเหมือน Lyon เลย แต่ฉันจะไม่หมดหวังหรอก ยังไม่ใช่ตอนนี้",shape=box,color=blue];
		j1735195233 -> j356487337;
}