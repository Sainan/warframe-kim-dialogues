		j499648645 -> j4278153021;
	j4113975982 [label="Oui คุณพูดถูกแล้ว เป็นอย่างนั้นจริง ๆ โลกนี้เต็มไปด้วยเรื่องราวมากมายนับไม่ถ้วนเช่นเดียวกับเรื่องของ Monsieur Otak และยังมีอีกหลายเรื่องที่เลวร้ายกว่านั้นมาก ฉันไม่ควรเสียใจกับเรื่องแบบนี้เลย ",shape=box,color=blue];
		j4113975982 -> j2285031048;
	j2616391841 [label="Merci. Well, I no longer wish to be. I am going to go do something more cheerful ! I think M'sieur Fibonacci's tank is due for a dusting.",shape=box,color=blue];
		j2616391841 -> j2425134241;
	j1721468518 [label="You're not being silly at all. I feel the same way.",shape=box,color=red];
		j1721468518 -> j2235898819;
	j4278153021 [label="It's the very least I can do for you.",shape=box,color=red];
		j4278153021 -> j2235898819;
