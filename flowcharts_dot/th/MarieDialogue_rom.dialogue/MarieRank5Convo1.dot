		j3925953987 -> j3565911761;
	j2860257755 [label="Boolean MarieEntratiMonster2 is now false.",color=orange];
		j2860257755 -> j3526847328;
	j748561079 [label="And you have decided to deceive me to get into my good graces... je vois.",shape=box,color=blue];
		j748561079 -> j128450754;
		j748561079 -> j1581049149;
	j1837066232 [label="Boolean MarieEntratiFan2 is now false.",color=orange];
		j1837066232 -> j4011513176;
	j2805287818 [label="[Confess feelings.] I care about you. More than I've let on.",shape=box,color=red];
		j2805287818 -> j3544426853;
	j3695458206 [label="I believe anything is necessary in this war. We're trying to save the universe against the Indifference, after all, aren't we?",shape=box,color=red];
		j3695458206 -> j1035308381;
	j4179269970 [label="I believe in Entrati. Honestly. I think he has a plan to solve this, and all this has been for the ultimate good.",shape=box,color=red];
		j4179269970 -> j1889145551;
	j3784890332 [label="But his fall from faith is not the doing of le Cardinal. The crack in the foundations were there. More pressure was simply added, oui ?",shape=box,color=blue];
		j3784890332 -> j4181489293;
	j4058150249 [label="Boolean MarieWarning is now true.",color=orange];
		j4058150249 -> j4009221558;
	j257754078 [label="I am well aware le Cardinal is both Lua and Sol - light and dark - good and evil. He is neither, and both, and capable of kindness and cruelty.",shape=box,color=blue];
		j257754078 -> j733647819;
		j257754078 -> j3685690691;
	j1384331669 [label="This is why the others get upset when you talk about him. You gloss over everything he's done that's hurt them and pretend it hasn't happened like idiots.",shape=box,color=red];
		j1384331669 -> j839847494;
	j38197827 [label="Marie, stop. You need to accept that he's not doing this all purely because he's a good man. He's not. He's more complicated than that.",shape=box,color=red];
