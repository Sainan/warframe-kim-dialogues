	j924576668 [label="I... that is not what I meant. This is not a holy war, this is something entirely...",shape=box,color=blue];
		j924576668 -> j1440965731;
	j4098688192 [label="Oui ! Précisément. And I am certain everyone will come around in time. I am simply glad to have a friend in this matter with me.",shape=box,color=blue];
		j4098688192 -> j300343042;
	j2273535852 [label="Trust me, no you're not. Countless people have lost their lives to this. And I can rattle off a list of names of people who have had their lives ruined because of him. But no one's forgotten about the Indifference.",shape=box,color=red];
		j2273535852 -> j4026596985;
	j3821279683 [label="I am sure if I were to meet her, I would know about it before long ! Everyone here is so quick to tell me about all their suffering at his hands ! No wonder le Cardinal does not return. I would not spend a single moment here if I were him -",shape=box,color=blue];
		j3821279683 -> j780992367;
	j3040676169 [label="I do not think it would drive him away ! Do you think le Cardinal would return to this nest of vipères ?! Non ! I would not spend a single moment here if I were him - ",shape=box,color=blue];
		j3040676169 -> j780992367;
