		j4288371264 -> j1194590355 [label="false",color=purple];
	j3142094137 [label="Evaluate expressions",color=orange];
		j3142094137 -> j981006002 [label="MarieEntratiMonster1",color=purple];
		j3142094137 -> j981006002 [label="MarieEntratiMonster2",color=purple];
		j3142094137 -> j282361841 [label="MarieEntratiFan1",color=purple];
		j3142094137 -> j282361841 [label="MarieEntratiFan2",color=purple];
		j3142094137 -> j362718714 [label="false",color=purple];
	j2325622337 [label="And is that what you suggest we do ? Outcast le Cardinal ? I would argue that seems to be what he has done to himself, non ?",shape=box,color=blue];
		j2325622337 -> j4201352038;
		j2325622337 -> j134937786;
	j2739885369 [label="I think Lyon suffers from many ailments, much of which owing to doubt in himself and his own mind. Le Cardinal seems to have... only quickened matters.",shape=box,color=blue];
		j2739885369 -> j2554379994;
		j2739885369 -> j134937786;
	j2506713978 [label="What would you have me do ? Burn an effigy of le Cardinal and denounce him ? Condemn him to the Void, wish him harm like M'sieur Tagfer ?",shape=box,color=blue];
		j2506713978 -> j4201352038;
		j2506713978 -> j134937786;
	j3937526700 [label="That's the issue, Marie. What you're asking of other people. Not what they're asking of you. Or of Entrati.",shape=box,color=red];
		j3937526700 -> j3892294558;
	j134937786 [label="Entrati leaves hurt people wherever he goes. All I'm trying to do is help those people put everything back together. I don't care much about \"good\" or \"evil\" in his case.",shape=box,color=red];
		j134937786 -> j2224225171;
	j2439511291 [label="Oui, and you are so consistent in your hatred for him ! Has nothing I have said done to soften you le Cardinal in turn ?",shape=box,color=blue];
		j2439511291 -> j1346084680;
	j755804628 [label="Were you not speaking to me of how you favored Entrati, same as I, not but moments ago ? What has now changed your mind ?",shape=box,color=blue];
		j755804628 -> j3206731386;
		j755804628 -> j2313314925;
		j755804628 -> j1167307417;
		j755804628 -> j1547477134;
	j1194590355 [label="Oui, and you seem to think Entrati such a monstre ! You are so quick to dismiss his kindness in turn !",shape=box,color=blue];
		j1194590355 -> j1346084680;
	j981006002 [label="Were you not speaking to me of Entrati's monstruosité just moments prior ? What has now changed your mind ?",shape=box,color=blue];
		j981006002 -> j3206731386;
		j981006002 -> j2313314925;
		j981006002 -> j1167307417;
		j981006002 -> j1547477134;
	j282361841 [label="Merci, and you have been my stalwart companion on this crusade ! I fear that we are alone in such regard - even Monsieur Loid harbors such resentment...",shape=box,color=blue];
		j282361841 -> j3517259439;
	j362718714 [label="Merci, and how glad I am to hear it ! I fear that we are alone in such regard - even Monsieur Loid harbors such resentment...",shape=box,color=blue];
		j362718714 -> j3517259439;
	j4201352038 [label="I think the issue is more what you're asking of others, not what they're asking of you. Or Entrati.",shape=box,color=red];
		j4201352038 -> j3892294558;
	j2554379994 [label="And it doesn't bother you?",shape=box,color=red];
		j2554379994 -> j2159116448;
	j3892294558 [label="And what is it that I am asking of others that is so grotesque ? To accept forgiveness into their hearts ?",shape=box,color=blue];
		j3892294558 -> j2669624490;
		j3892294558 -> j3807987740;
	j2224225171 [label="Noble, if tiresome, to travel through time and space, aiding his mécontents, non ? Surely you must resent him for this...",shape=box,color=blue];
		j2224225171 -> j3623460974;
		j2224225171 -> j2158471681;
	j1346084680 [label="This conversation was a mistake...",shape=box,color=blue];
		j1346084680 -> j2951875579;
		j1346084680 -> j3468863412;
	j3206731386 [label="I honestly have been struggling to navigate this topic with you. Painfully so. I personally think he's... neither good nor bad. But a mix.",shape=box,color=red];
		j3206731386 -> j670931099;
	j2313314925 [label="I've changed my mind. I'm on his side. And yours. You convinced me.",shape=box,color=red];
		j2313314925 -> j1377988471;
	j1167307417 [label="[Confess feelings.] I've just been trying to do my best to... get on your good side, I'm afraid. I have feelings for you. More than I let on.",shape=box,color=red];
		j1167307417 -> j1120832342;
	j1547477134 [label="I've changed my mind and decided he's a monster. Once and for all.",shape=box,color=red];
		j1547477134 -> j2760909480;
	j3517259439 [label="Together, perhaps we can stand guard against those who would besmirch his good deeds, oui ? But I wonder, against all that surrounds you... why take my side ?",shape=box,color=blue];
		j3517259439 -> j3256638996;
	j2159116448 [label="Check boolean LyonDating",color=orange];
		j2159116448 -> j830748262 [label=true,color=green];
		j2159116448 -> j1621414413 [label=false,color=brown];
	j2669624490 [label="You've put Entrati on a pedestal, Marie. And you're asking others to do the same thing like idiots.",shape=box,color=red];
		j2669624490 -> j839847494;
	j3807987740 [label="I think you're asking them to do more than to just forgive Entrati. I think you're asking them to pretend nothing he did was ever wrong at all.",shape=box,color=red];
		j3807987740 -> j4009221558;
	j3623460974 [label="Sure. But I also have him to \"thank\" for some of the most important relationships and friendships I've ever made.",shape=box,color=red];
		j3623460974 -> j4181489293;
	j2158471681 [label="No, not really. He needs me to do it, so I'll do it. I'll judge him when all is said and done.",shape=box,color=red];
		j2158471681 -> j4181489293;
	j2951875579 [label="Wait, Marie. Please. Let me explain.",shape=box,color=red];
		j2951875579 -> j3443320110;
		j2951875579 -> j3805268008;
		j2951875579 -> j3711624884;
		j2951875579 -> j1648061871;
