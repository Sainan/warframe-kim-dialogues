		j709500590 -> j3650350541 [label="MarieEntrati3",color=purple];
		j709500590 -> j3472855037 [label="false",color=purple];
	j2560399282 [label="I have been thinking over what you said about le Cardinal. That his actions are... a \"mix\" of benign and foul.",shape=box,color=blue];
		j2560399282 -> j3014736862;
	j1193997864 [label="I have been thinking over your words about le Cardinal. That his actions have brought pain to Lyon.",shape=box,color=blue];
		j1193997864 -> j3014736862;
	j3415888806 [label="I have been thinking more on our conversation regarding M'sieur Tagfer, and your convincing arguments for why he despises le Cardinal so.",shape=box,color=blue];
		j3415888806 -> j3014736862;
	j3032308247 [label="I have been thinking more on my argument with M'sieur Tagfer, and his reasons for despising le Cardinal so.",shape=box,color=blue];
		j3032308247 -> j3014736862;
	j3650350541 [label="I have been thinking more on my argument with M'sieur Tagfer. And our argument about that argument.",shape=box,color=blue];
		j3650350541 -> j3014736862;
	j3472855037 [label="I feel a great much has been left unsaid regarding le Cardinal. The others seem to walk on eggshells around me, afraid to speak of him.",shape=box,color=blue];
		j3472855037 -> j3014736862;
	j3014736862 [label="I know others wish to paint him a cur, a madman, a traitor. But he was not those things to me.",shape=box,color=blue];
		j3014736862 -> j2718976672;
	j2718976672 [label="Check boolean MarieBackstory1",color=orange];
		j2718976672 -> j1931450226 [label=true,color=green];
		j2718976672 -> j3760926098 [label=false,color=brown];
	j1931450226 [label="Perhaps it is because I am so accustomed to being abandoned. ",shape=box,color=blue];
		j1931450226 -> j2425369306;
	j3760926098 [label="I was abandoned by my family, left on the streets when I was a child, due to being... abnormal. Broken. Unfit for high society.",shape=box,color=blue];
		j3760926098 -> j2425369306;
	j2425369306 [label="Perhaps it is because I never had a father to speak of, that I am so willing to forgive him for his absence.",shape=box,color=blue];
		j2425369306 -> j4106479212;
	j4106479212 [label="Evaluate expressions",color=orange];
		j4106479212 -> j968364583 [label="MarieEntrati4a",color=purple];
		j4106479212 -> j1224158289 [label="MarieEntrati4b",color=purple];
		j4106479212 -> j2985088239 [label="MarieEntrati3a",color=purple];
		j4106479212 -> j2889393224 [label="MarieEntrati3b",color=purple];
		j4106479212 -> j1187855489 [label="MarieEntrati3",color=purple];
		j4106479212 -> j2453438200 [label="false",color=purple];
	j968364583 [label="But the fact remains that I do forgive him. For I see more value in his good deeds than harm in his foul ones.",shape=box,color=blue];
		j968364583 -> j2039433942;
		j968364583 -> j3560548713;
		j968364583 -> j1688276009;
		j968364583 -> j4254541553;
		j968364583 -> j3225400760;
	j1224158289 [label="I pray that Lyon is strong and survives the crisis of faith he suffers, but I do not believe it to be entirely a fault of le Cardinal's making.",shape=box,color=blue];
		j1224158289 -> j2039433942;
		j1224158289 -> j3560548713;
		j1224158289 -> j1688276009;
		j1224158289 -> j3428741264;
		j1224158289 -> j1279348108;
	j2985088239 [label="So while I appreciate your convincing arguments regarding M'sieur Tagfer and those who have been harmed by him... I still see more value in his good deeds than harm in his foul ones.",shape=box,color=blue];
		j2985088239 -> j2039433942;
		j2985088239 -> j3560548713;
		j2985088239 -> j1688276009;
		j2985088239 -> j1755455395;
		j2985088239 -> j379386513;
	j2889393224 [label="So while I appreciate M'sieur Tagfer's ire, and can sympathize with his points, he must find the space in his own heart to forgive le Cardinal. For I see more value in le Cardinal's good deeds than harm in his foul ones.",shape=box,color=blue];
		j2889393224 -> j2039433942;
		j2889393224 -> j3560548713;
		j2889393224 -> j1688276009;
		j2889393224 -> j2503243659;
		j2889393224 -> j2794136629;
	j1187855489 [label="So while I appreciate everyone's histories with le Cardinal, especially M'Sieur Tagfer, I still more value in his good deeds than harm in his foul ones.",shape=box,color=blue];
		j1187855489 -> j2039433942;
		j1187855489 -> j3560548713;
		j1187855489 -> j1688276009;
		j1187855489 -> j3318175265;
	j2453438200 [label="So while I appreciate everyone's histories with le Cardinal, I still more value in his good deeds than harm in his foul ones.",shape=box,color=blue];
		j2453438200 -> j2039433942;
		j2453438200 -> j3560548713;
		j2453438200 -> j1688276009;
	j2039433942 [label="I don't fault you for appreciating the good he's done in your life, the same way I don't fault other people for resenting the harm he's causing in theirs.",shape=box,color=red];
		j2039433942 -> j1506979406;
	j3560548713 [label="I don't know. I think his actions have led to a lot more harm than good. I wish you could see that.",shape=box,color=red];
		j3560548713 -> j4288371264;
	j1688276009 [label="I'm siding with you, Marie. I can't fault Entrati for any of what he's done. He's fighting the Indifference.",shape=box,color=red];
		j1688276009 -> j3142094137;
	j4254541553 [label="You're right to forgive Entrati. I wish more of the others would follow your lead.",shape=box,color=red];
		j4254541553 -> j3142094137;
	j3225400760 [label="I'll never fault someone for forgiveness. But you can forgive someone while understanding you have to protect yourself and others from them.",shape=box,color=red];
		j3225400760 -> j2325622337;
	j3428741264 [label="You think Lyon's suffering is his own fault?",shape=box,color=red];
		j3428741264 -> j2739885369;
	j1279348108 [label="Lyon is suffering far more than a crisis of faith, Marie. And a lot of that has to do with Entrati.",shape=box,color=red];
		j1279348108 -> j4288371264;
	j1755455395 [label="Did nothing I said even slightly work to even the scales?",shape=box,color=red];
		j1755455395 -> j2506713978;
	j379386513 [label="How can you look at everything Entrati has done and still see more good than harm?",shape=box,color=red];
		j379386513 -> j4288371264;
	j2503243659 [label="I think you're downplaying the seriousness of what the Cavia and Tagfer suffered.",shape=box,color=red];
		j2503243659 -> j4288371264;
	j2794136629 [label="Forgiveness is important. But so is acknowledging that Entrati might be more complicated than you're willing to accept.",shape=box,color=red];
		j2794136629 -> j2506713978;
	j3318175265 [label="I still don't think you understand what Tagfer and the Cavia suffered. It's worse than what you went through.",shape=box,color=red];
		j3318175265 -> j4288371264;
	j1506979406 [label="But do you see how the two are not of equal value ? Resentment and veneration ? I wish for the others to give up their malicious grudges.",shape=box,color=blue];
		j1506979406 -> j3937526700;
		j1506979406 -> j134937786;
	j4288371264 [label="Evaluate expressions",color=orange];
		j4288371264 -> j2439511291 [label="MarieEntratiMonster1",color=purple];
		j4288371264 -> j2439511291 [label="MarieEntratiMonster2",color=purple];
