		j1120832342 -> j748561079;
	j2760909480 [label="Boolean MarieEntratiFan1 is now false.",color=orange];
		j2760909480 -> j1837066232;
	j3256638996 [label="Not that I am complaining, mind !",shape=box,color=blue];
		j3256638996 -> j2805287818;
		j3256638996 -> j3695458206;
		j3256638996 -> j4179269970;
	j830748262 [label="I know he has found a place inside your heart, and for this I am so truly grateful - perhaps I can finally stop worrying about him, and all this fighting will soon be moot -",shape=box,color=blue];
		j830748262 -> j1621414413;
	j1621414413 [label="But of course it bothers me. He is the brother of my soul ! My Lyon is the dearest thing in this world to me, and to see him in pain brings an ache in my chest as if his agonie is my own.",shape=box,color=blue];
		j1621414413 -> j3784890332;
	j839847494 [label="Watch your words, Drifter.",shape=box,color=blue];
		j839847494 -> j4058150249;
	j4009221558 [label="Je ne suis pas naïve, do not speak to me as if I am such !",shape=box,color=blue];
		j4009221558 -> j257754078;
	j4181489293 [label="Perhaps he is only lancing a poison so that the body can heal, and this is all merely a necessary cruelty.",shape=box,color=blue];
		j4181489293 -> j1384331669;
		j4181489293 -> j38197827;
	j3443320110 [label="[Confess feelings.] I care about you. More than I've let on. And I... I'm sorry I've been harsh, but I can't let him hurt you. Not like he's hurt so many others.",shape=box,color=red];
		j3443320110 -> j2676584549;
	j3805268008 [label="I have watched Entrati do nothing but burn everyone he cares about. Everyone he has supposedly loved. I don't want to see him do the same to you...",shape=box,color=red];
		j3805268008 -> j3016332739;
	j3711624884 [label="I'm not the best at expressing myself, and for that I'm sorry. But he's... I'm afraid he's using you, and using your kindness to manipulate you. That's all.",shape=box,color=red];
		j3711624884 -> j3703905176;
	j1648061871 [label="You may see Entrati as a savior, but I see him as an old, frightened man scrambling for answers. Maybe the answer is somewhere in between.",shape=box,color=red];
		j1648061871 -> j839847494;
	j323994022 [label="Oui. It seems so.",shape=box,color=blue];
		j323994022 -> j3051126039;
