	j1826678430 [label="Add -10 to Family counter",color=orange];
		j1826678430 -> j4098688192;
	j2163747111 [label="It seems I am the only one who remembers what is at stake here !",shape=box,color=blue];
		j2163747111 -> j2273535852;
		j2163747111 -> j2109556813;
	j1823586972 [label="You're making assumptions, now. You don't know that. You've never met her, and you have no idea what she's been through. Or what she's had to endure.",shape=box,color=red];
		j1823586972 -> j3821279683;
	j2109556813 [label="And do you think that will make him love you more, if you do? Do you think that'll make him come back to you, if you're the one who stays loyal to him?",shape=box,color=red];
		j2109556813 -> j3040676169;
	j2025010587 [label="I - I cannot. I cannot continue. Forgive me. We will talk again of this tomorrow, I must gather my thoughts.",shape=box,color=blue];
