		j3544426853 -> j1254319071;
	j1035308381 [label="Oui ! Precisely ! Finally, someone who sees sense. It breaks my heart that innocents must be harmed in this war, but all is at stake. ",shape=box,color=blue];
		j1035308381 -> j685143775;
	j1889145551 [label="Boolean MarieWillDate is now true.",color=orange];
		j1889145551 -> j411306976;
	j733647819 [label="Marie, he isn't a god. He's just a man. He's just as arrogant and just as dangerous as Roathe. He comes from the same society and suffers all the same problems.",shape=box,color=red];
		j733647819 -> j3046530884;
