	2841 [label="Oui, it is. Par exemple -",shape=box,color=blue];
		2841 -> 2850;
	2842 [label="But it is like you said, non ? All inconveniences like mine come with a secret power. We must simply find them.",shape=box,color=blue];
		2842 -> 2851;
	2843 [label="Oui, it is. I sometimes would sit there and stare at a book on the top row of a case and think how unjust it was that I could not reach it.",shape=box,color=blue];
		2843 -> 2852;
	2844 [label="I was dusting all the chandeliers the other day in the Sanctum. Monsieur Loid begged me to stop.",shape=box,color=blue];
		2844 -> 2853;
	2848 [label="It is a hard thing to explain, but I will try. Mes pieds, oui ? My feet. The sérum has changed me, given me flight -",shape=box,color=blue];
		2848 -> 2858;
	2849 [label="Par les Luminaires, I am so very sorry. You understand then, what it is like, oui ?",shape=box,color=blue];
		2849 -> 2859;
	2854 [label="Oui ! Oh, I was dusting all the chandeliers the other day in the Sanctum. Monsieur Loid begged me to stop.",shape=box,color=blue];
