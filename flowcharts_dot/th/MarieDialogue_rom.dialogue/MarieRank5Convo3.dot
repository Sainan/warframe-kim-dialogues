		2819 -> 2826;
	2816 [label="Oui, I am afraid. The mind is a truly marvelous thing. I think it is fascinating that they must always hurt, all the time, and yet I have learned to simply ignore them.",shape=box,color=blue];
		2816 -> 2822;
		2816 -> 2823;
		2816 -> 2824;
