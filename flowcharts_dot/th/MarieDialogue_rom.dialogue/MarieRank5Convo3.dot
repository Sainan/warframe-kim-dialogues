	2868 [label="But I still feel them, those twisted things that threatened to consume me, threatened to crush all hope and joie from my soul.",shape=box,color=blue];
		2868 -> 2876;
	2872 [label="Ah, it just brings me happiness to know that someone here understands what it is like. It is so rare. This silent, unseen plague we suffer.",shape=box,color=blue];
