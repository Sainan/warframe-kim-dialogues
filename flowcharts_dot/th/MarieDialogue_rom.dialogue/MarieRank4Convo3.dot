		j854455074 -> j3744084083;
	j3744084083 [label="มันยากที่จะอธิบาย แต่จะพยายามนะ Mes pieds, oui ? เท้าฉันน่ะ sérum เปลี่ยนฉัน ทำให้ฉันบินได้ -",shape=box,color=blue];
		j3744084083 -> j1497650710;
	j1057700526 [label="Par les Luminaires ขอโทษนะ ถ้าอย่างนั้นคุณคงเข้าใจใช่ไหมว่ามันเป็นยังไง oui ?",shape=box,color=blue];
		j1057700526 -> j257811082;
	j1497650710 [label="แต่ฉันยังคงรู้สึกถึงมันอยู่ สิ่งบิดเบี้ยวที่คุกคามจะกลืนกินฉัน คุกคามที่จะทำลายความหวังและความสุขทั้งหมดออกไปจากจิตวิญญาณของฉัน",shape=box,color=blue];
		j1497650710 -> j2308095015;
	j257811082 [label="การที่ร่างกายทรยศคุณ ฉุดรั้งจิตใจคุณ แม้แต่ตอนนี้ก็ยังแปลกเหลือเกิน sérum เปลี่ยนฉัน ทำให้ฉันบินได้ -",shape=box,color=blue];
		j257811082 -> j1497650710;
