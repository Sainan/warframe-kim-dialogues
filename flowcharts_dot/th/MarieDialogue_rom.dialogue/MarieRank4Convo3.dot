		j4280876526 -> j1754665685;
	j1754665685 [label="มันมีจุดประสงค์อะไรกันแน่ อ้อ แต่แล้วเมื่อยามเช้ามาถึง ฉันก็ได้แต่หัวเราะและบอกตัวเองว่า \"เงียบเถอะ Marie เธอโชคดีจริง ๆ มองดูทุกสิ่งที่เธอมี ทุกสิ่งที่เธอทำได้สิ\"",shape=box,color=blue];
		j1754665685 -> j3331439256;
	j3331439256 [label="ที่ Cathédrale มีคนพูดว่า \"เธออ่านออกเขียนได้ กินอิ่ม นอนหลับ เคลื่อนไหวได้ดีพอสมควร มีดวงตาไว้มองและมีลิ้นไว้พูด มีมือไว้เขียน รวมถึงมีคนคอยดูแล\" แถมตอนนี้ ฉันก็บินได้อีกด้วย ! ฉันสามารถปกป้องอนาคตจากวอยด์ จาก l'Indifférence ได้แล้ว !",shape=box,color=blue];
		j3331439256 -> j4286541790;
