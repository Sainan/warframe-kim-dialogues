	22 [label="ข้าคิดว่ามันก็พอ ๆ กันนั่นแหละ อาวุธอาจจะแตกต่างกัน ส่วนผู้คนอาจจะยังไม่รู้ว่ากำลังเผชิญหน้ากับอะไรอยู่ แต่ยังไงซะ สงครามก็คือสงคราม และความตายก็คือความตาย",shape=box,color=red];
		22 -> 26;
	23 [label="ข้าว่ายุคนี้อันตรายน้อยกว่านะ เรามีเครื่องมือรับมือกับความท้าทายที่เราเจอได้ดีกว่าตั้งเยอะ พวกนั้นน่ะเพิ่งจะเริ่มต้นเอง",shape=box,color=red];
		23 -> 27;
	24 [label="ข้าคิดว่ายุคนี้อันตรายกว่ามากนะ แม้ศัตรูจะยังเป็นพวก Infested เหมือนเดิม แต่ในยุคนั้นพวกเขายังต้องใช้อาวุธโบราณ ๆ ต่อสู้กันอยู่เลย",shape=box,color=red];
		24 -> 27;
	25 [label="ขอบอกตามตรงว่าข้าดีใจที่เห็นเจ้าสนุกนะ การปรับตัวให้เข้ากับทุกอย่างพร้อมกันไม่ใช่เรื่องง่ายเลย",shape=box,color=red];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
