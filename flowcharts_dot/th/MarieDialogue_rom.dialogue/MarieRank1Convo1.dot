digraph {
	0 [label="MarieRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="Bonjour, bonjour, ดริฟเตอร์ ! เช้านี้สบายดีไหม หรือนี่เป็นตอนเย็น ไม่รู้จริง ๆ ว่าตอนนี้กี่โมงแล้ว",shape=box,color=blue];
		1 -> 2;
	2 [label="ฉันมั่นใจว่ามีของชิ้นหนึ่งในบรรดา bibelots ที่ Monsieur Loid เก็บไว้มีนาฬิกาอยู่แน่ ๆ แต่ไม่ว่าอย่างไรก็ไม่อาจบอกได้จริง ๆ ว่าเป็นนาฬิกาแบบไหนกันแน่",shape=box,color=blue];
		2 -> 3;
	3 [label="ฉันไม่กล้าแตะต้องอุปกรณ์ใด ๆ ในสถานศักดิ์สิทธิ์แปลก ๆ แห่งนี้เลย เพราะถ้าเผลอไปแตะเข้า อาจมีโอกาสสุ่มเสี่ยงที่จะพุ่งออกไปสู่ช่วงเวลาอันไกลโพ้น พอ ๆ กับการเดินไปอุ่นชาสักถ้วย",shape=box,color=blue];
		3 -> 5;
		3 -> 6;
		3 -> 4;
	5 [label="ทางที่ดีอย่าไปกดปุ่มอะไรที่ยังไม่แน่ใจจะดีกว่านะ ",shape=box,color=red];
		5 -> 8;
	6 [label="ข้าแน่ใจว่าคงจะไม่เป็นอะไรหรอก",shape=box,color=red];
		6 -> 9;
	4 [label="[จบ]",shape=box,color=red];
		4 -> 7;
	8 [label="เป็นคำแนะนำที่ดีมากเลย ได้ยินมาจาก Monsieur Loid ว่าคุณเคยได้ aventure temporelle ส่วนตัวด้วย สงสัยจังเลยว่า -",shape=box,color=blue];
		8 -> 10;
	9 [label="C'est très gentil de votre part แต่... คุณไม่ได้เป็นคนที่โดนโยนเข้าไปใน... อ่า อืม นั่นแหละ !",shape=box,color=blue];
		9 -> 11;
	7 [label="Chat ends.",color=orange];
	10 [label="มันอันตรายเท่าแบบนี้ไหม ?",shape=box,color=blue];
		10 -> 12;
		10 -> 13;
	11 [label="ก็น่าจะรู้ดีนี่นา ขอถามหน่อยเถอะ การผจญภัยส่วนตัวของคุณน่ะมันอันตรายเท่าแบบนี้เลยหรือเปล่า",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="หมายถึงช่วงเวลา หรือเฉพาะช่วงที่ข้าอยู่ที่นั่นล่ะ",shape=box,color=red];
		12 -> 14;
	13 [label="มันแตกต่างออกไป แต่สัญญาว่าเจ้าจะปลอดภัยที่นี่",shape=box,color=red];
		13 -> 15;
	14 [label="+10 Chemistry",color=orange];
		14 -> 16;
	15 [label="ฉันซาบซึ้งใจจริง ๆ ที่คุณเชื่อมั่นอย่างแรงกล้าเช่นนั้น แต่อาจไม่ค่อยเห็นด้วยนัก โดยเฉพาะเมื่อฉันยังมีปัญหาในการแยกแยะเวลาอยู่เลย",shape=box,color=blue];
		15 -> 17;
	16 [label="การแยกแยะความแตกต่างเป็นเรื่องที่ดี ฉันอดสงสัยไม่ได้เลยว่าประสบการณ์ในอดีตของคุณนั้น \"ปกติ\" ตามมาตรฐานโดยรวมหรือไม่ แต่จากที่สังเกตดู คาดว่าจะไม่",shape=box,color=blue];
		16 -> 18;
	17 [label="ปกติแล้วก็น่าจะมีอยู่อันหนึ่งตรงมุมของ... “หน้าจอ” นี่สิ แต่มันกลับไม่มีเลย ! Mauvaise qualité ถ้าถามฉันนะ",shape=box,color=blue];
		17 -> 19;
	18 [label="ฉันหมายถึง “ช่วงเวลา” นั่นแหละ ขออนุญาตเรียบเรียงถ้อยคำใหม่ -",shape=box,color=blue];
		18 -> 20;
	19 [label="อย่างไรก็ตาม ดูเหมือนเราจะออกนอกเรื่องไปไกลแล้ว !",shape=box,color=blue];
		19 -> 20;
	20 [label="ยุค “อดีต” ที่คุณเคยไปซึ่งอยู่ใกล้กับ “อดีตอันไกลโพ้น” ที่ฉันจากมานั้น มีอันตรายมากกว่าหรือน้อยกว่ายุคปัจจุบันที่เราอยู่ตอนนี้กันแน่ ?",shape=box,color=blue];
		20 -> 21;
	21 [label="(โอ้พระเจ้า ! ฉันชอบเรื่องนี้เหลือเกิน ต้องยอมรับเลยว่ามันน่าสนใจกว่าการปัดฝุ่นเครื่องใช้ในพิธีศีลมหาสนิทเสียอีก)",shape=box,color=blue];
		21 -> 22;
