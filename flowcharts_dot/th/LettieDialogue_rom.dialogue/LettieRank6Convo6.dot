digraph {
	"LettieRank6Convo6 begins." [color=orange];
		"LettieRank6Convo6 begins." -> j2656309250;
	j2656309250 [label="Entrati เกือบชดเชยความผิดได้บ้าง\nด้วยการส่ง Minerva มาให้เรา\nแค่ *เกือบ* นะ",shape=box,color=blue];
		j2656309250 -> j3620890037;
		j2656309250 -> j4138131255;
	j3620890037 [label="ควรต้องกังวลหรือเปล่า",shape=box,color=red];
		j3620890037 -> j2918585497;
	j4138131255 [label="คิดว่าเจ้าทั้งสองคนคงจะเข้ากันได้ดีนะ ฮ่าๆ",shape=box,color=red];
		j4138131255 -> j710046041;
	j2918585497 [label="Jajaja ไม่\nแต่การมีเพื่อนมาเพิ่มก็ดีเหมือนกันนะ\nโดยเฉพาะยัยคนนั้นที่ดูแลตัวเองได้\nดีจังที่อย่างน้อยก็มีสักคนที่ไม่ต้องห่วงว่าจะต้องตามไปเก็บซากตามพื้นหรือเปล่า",shape=box,color=blue];
		j2918585497 -> j2828163945;
	j710046041 [label="JAJAJAJA\nหมายความว่าไงเนี่ย?!\nการมีเพื่อนมาเพิ่มก็ดีเหมือนกันนะ\nโดยเฉพาะยัยคนนั้นที่ดูแลตัวเองได้\nดีจังที่อย่างน้อยก็มีสักคนที่ไม่ต้องห่วงว่าจะต้องตามไปเก็บซากตามพื้นหรือเปล่า",shape=box,color=blue];
		j710046041 -> j2828163945;
	j2828163945 [label="แถม Velimir ก็ยังทำให้ยิ้มได้ตลอดเลย\nน่าชื่นชมนะคนที่รู้จักตัวเองดีแบบนั้น\nAlguien auténtico y fiel a sí mismo, ¿sí?\nวันก่อนเขายังยอมให้ Aoi ทาเล็บเท้าให้ด้วยนะ jajajaja\nและยังคุยเรื่องรถเครื่องแรงแบบคลาสสิกของชาว Libertatia ด้วย\nไม่สนห่าเหวอะไรทั้งนั้น",shape=box,color=blue];
		j2828163945 -> j2793387706;
	j2793387706 [label="ไม่รู้หรอกนะว่าจะมีใครมาเพิ่มอีกหรือเปล่า\nแต่นี่เป็นครั้งแรกในรอบหลายปีเลย\nที่แอบหวังอยากให้มี",shape=box,color=blue];
		j2793387706 -> "Chat ends.";
	"Chat ends." [color=orange];
}