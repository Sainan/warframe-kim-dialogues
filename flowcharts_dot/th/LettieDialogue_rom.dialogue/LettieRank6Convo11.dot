		j3383250927 -> j3327808048;
	j3327808048 [label="หนูมีอายุสั้นเมื่อเทียบกับคน\nคนก็มีอายุสั้นเมื่อเทียบกับต้นไม้\nต้นไม้เองก็มีอายุสั้นเมื่อเทียบกับพระเจ้า",shape=box,color=blue];
		j3327808048 -> j1128216350;
	j1128216350 [label="แมลงก็มีอายุสั้นกว่าเมื่อเทียบกับหนู\nทุกอย่างมันสัมพันธ์กันทั้งนั้น\nแล้วพวกเราก็วนลูปไปเรื่อย ๆ เลยจริงไหม jajaja",shape=box,color=blue];
		j1128216350 -> j661767076;
