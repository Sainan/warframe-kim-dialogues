		j3702107533 -> "Chat ends.";
	j4014956066 [label="พอดีมีเรื่องอยากคุยด้วยหน่อยและอยากถามให้แน่ใจว่าเจ้าจะโอเคกับเรื่องนั้น",shape=box,color=red];
		j4014956066 -> j2816229894;
	j2816229894 [label="ที่สำคัญคือไม่อยากให้รู้สึกว่าข้ากำลังโกหกหรือไม่ซื่อสัตย์",shape=box,color=red];
		j2816229894 -> j1629998941;
		j2816229894 -> j1596334276;
		j2816229894 -> j1046671893;
	j1629998941 [label="อย่าทำร้ายกันนะ",shape=box,color=red];
		j1629998941 -> j297665630;
	j1596334276 [label="อย่าโกรธนะ",shape=box,color=red];
		j1596334276 -> j19421800;
	j1046671893 [label="หวังว่าจะเข้าใจนะ",shape=box,color=red];
		j1046671893 -> j3382173649;
	j297665630 [label="Jajajajaj\nเราคุยกันเรื่องนี้แล้วนี่\nฉันจะทำให้เธอเจ็บในแบบที่เธอชอบเท่านั้น\nแล้วนี่กำลังพูดถึงเรื่องอะไรอยู่",shape=box,color=blue];
		j297665630 -> j4133630261;
	j19421800 [label="¿Sí?\nแล้วจะโกรธเรื่องอะไรล่ะ",shape=box,color=blue];
		j19421800 -> j4133630261;
	j3382173649 [label="¿Sí?\nแล้วจะให้เข้าใจเรื่องอะไรล่ะ",shape=box,color=blue];
		j3382173649 -> j4133630261;
	j4133630261 [label="ไม่อยากให้เจ้ารู้สึกเหมือนตกอยู่ในสถานการณ์ที่ไม่โอเค เราไม่เคยคุยกันเรื่องนี้มาก่อน ดังนั้นถ้าจะปฏิเสธก็ไม่เป็นไรนะ",shape=box,color=red];
		j4133630261 -> j849207876;
	j849207876 [label="สิ่งที่เรามีนั้นสำคัญ สำคัญมากจริง ๆ และมันเป็นของจริง โปรดอย่าสงสัยในเรื่องนี้เลย",shape=box,color=red];
		j849207876 -> j3080989151;
	j3080989151 [label="Aah, entiendo...\nปกติก็ไม่ได้อยากจะก้าวก่ายหรอกนะ\nแค่อยากรู้เฉย ๆ\nเป็นห่วงคนพวกนั้นขนาดนั้นเลยเหรอ solecito?\n¿Quiénes son?\nนี่เป็นห่วงพวกเขาจริง ๆ ใช่ไหม",shape=box,color=blue];
		j3080989151 -> j1123535849;
		j3080989151 -> j3288332735;
	j1123535849 [label="สนใจเขา แต่ก็ใส่ใจเจ้ามากเช่นกัน",shape=box,color=red];
		j1123535849 -> j1234872763;
	j3288332735 [label="คิดอยู่แล้วว่าเจ้าคงพอจะเดาออกได้ทันที",shape=box,color=red];
		j3288332735 -> j699336106;
	j1234872763 [label="Ay, sí\nจะโทษเธอได้ยังไง ในเมื่อเธอผ่านโลกมาเยอะ\nเดินทางมาโชกโชนขนาดนั้น\nแค่อย่ามาชวนไปร่วมด้วยก็พอ\nไม่ได้ขัดข้องอะไรหรอก",shape=box,color=blue];
		j1234872763 -> j4259330280;
	j699336106 [label="ฉันโกงน่ะ\nEleanor เตือนฉันแล้ว\nJajaja ยัยนั่นขี้นินทาจะตาย",shape=box,color=blue];
		j699336106 -> j3132825978;
	j4259330280 [label="แต่คงไม่ใช่คนใน hex นะ\nMi familia no, ¿por favor?\nไม่งั้นฉันคงต้องไปหาอะไรมาขัดตัวเองทั้งอาทิตย์แน่",shape=box,color=blue];
		j4259330280 -> j3443616464;
	j3132825978 [label="จะโทษเธอได้ยังไง ในเมื่อเธอผ่านโลกมาเยอะ\nเดินทางมาโชกโชนขนาดนั้น\nแค่อย่ามาชวนไปร่วมด้วยก็พอ\nไม่ได้ขัดข้องอะไรหรอก",shape=box,color=blue];
		j3132825978 -> j4259330280;
	j3443616464 [label="+20 Chemistry",color=orange];
		j3443616464 -> j2712684299;
	j2712684299 [label="เธอเป็นคนสำคัญของฉันนะ solecito\nแล้วถ้าเขาทำให้เธอมีความสุข\nงั้นเราก็คงเหมือนกัน\nง่าย ๆ แค่นั้นเอง",shape=box,color=blue];
		j2712684299 -> j1786723434;
	j1786723434 [label="อ้อ\nและลองหาทางพาเขามาที่นี่ในสักวันนะ\nฉันอยากเจอ",shape=box,color=blue];
		j1786723434 -> j88962967;
