		j2032426993 -> j94966192;
	j3402416011 [label="Jajajajaj\nเราคุยกันเรื่องนี้แล้วนี่\nฉันจะทำให้เธอเจ็บในแบบที่เธอชอบเท่านั้น\nแล้วนี่กำลังพูดถึงเรื่องอะไรอยู่",shape=box,color=blue];
		j3402416011 -> j2994007496;
	j540690497 [label="¿Sí?\nแล้วจะโกรธเรื่องอะไรล่ะ",shape=box,color=blue];
		j540690497 -> j2994007496;
	j94966192 [label="¿Sí?\nแล้วจะให้เข้าใจเรื่องอะไรล่ะ",shape=box,color=blue];
		j94966192 -> j2994007496;
	j2994007496 [label="ไม่อยากให้เจ้ารู้สึกเหมือนตกอยู่ในสถานการณ์ที่ไม่โอเค เราไม่เคยคุยกันเรื่องนี้มาก่อน ดังนั้นถ้าจะปฏิเสธก็ไม่เป็นไรนะ",shape=box,color=red];
		j2994007496 -> j126897240;
	j126897240 [label="สิ่งที่เรามีนั้นสำคัญ สำคัญมากจริง ๆ และมันเป็นของจริง โปรดอย่าสงสัยในเรื่องนี้เลย",shape=box,color=red];
		j126897240 -> j2354242478;
	j2354242478 [label="Aah, entiendo...\nแค่อยากรู้ว่า\nเธอสนใจเขาจริง ๆ เหรอ solecito?\n¿Quiénes son?",shape=box,color=blue];
		j2354242478 -> j3681806801;
		j2354242478 -> j2887113897;
	j3681806801 [label="สนใจเขา แต่ก็ใส่ใจเจ้ามากเช่นกัน",shape=box,color=red];
		j3681806801 -> j175846455;
	j2887113897 [label="คิดอยู่แล้วว่าเจ้าคงพอจะเดาออกได้ทันที",shape=box,color=red];
		j2887113897 -> j1153921084;
	j175846455 [label="Ay, sí\nโทษเธอไม่ได้หรอก ในเมื่อเธอเห็นอะไรมามากมาย\nเดินทางมามากมาย\nก็โอเคนะ",shape=box,color=blue];
		j175846455 -> j4259330280;
	j1153921084 [label="ฉันโกงน่ะ\nEleanor เตือนฉันแล้ว\nJajaja ยัยนั่นขี้นินทาจะตาย",shape=box,color=blue];
		j1153921084 -> j13589328;
	j4259330280 [label="แต่คงไม่ใช่คนใน hex นะ\nMi familia no, ¿por favor?\nไม่งั้นฉันคงต้องไปหาอะไรมาขัดตัวเองทั้งอาทิตย์แน่",shape=box,color=blue];
