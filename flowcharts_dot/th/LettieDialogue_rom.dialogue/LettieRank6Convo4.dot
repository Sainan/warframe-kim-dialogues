	j933622866 [label="Eh, así así\nก็แค่วันห่วย ๆ อีกวัน\nเดี๋ยวมันก็ผ่านไป เหมือนทุกครั้งนั่นแหละ",shape=box,color=blue];
		j933622866 -> j407773527;
		j933622866 -> j668531054;
	j407773527 [label=":( เสียใจด้วยนะที่ได้ยินแบบนั้น",shape=box,color=red];
		j407773527 -> j1594443089;
	j668531054 [label="เกิดอะไรขึ้นเหรอ?",shape=box,color=red];
		j668531054 -> j1746468427;
	j1594443089 [label="Sólo las arañas\nกลับมาอีกแล้ว \nแต่เดี๋ยวพวกมันก็คงหายไปเอง",shape=box,color=blue];
		j1594443089 -> j608955629;
	j1746468427 [label="ไม่มีอะไรใหม่หรอก\nSólo las arañas\nกลับมาอีกแล้ว \nแต่เดี๋ยวพวกมันก็คงหายไปเอง",shape=box,color=blue];
		j1746468427 -> j608955629;
	j608955629 [label="บางครั้งก็หวังนะว่า\nอยากให้มันง่ายเหมือนเป็นแค่ปัญหา \nจะได้จัดการมันได้ ¿sí?\nพูดออกมา แล้วทุบให้กระจุยไปเลย jajaja",shape=box,color=blue];
		j608955629 -> j2653723130;
	j2653723130 [label="ปัญหาน่ะ มันแก้ได้\nปัญหามันมีคำตอบเสมอ\nLos sentimientos no se arreglan\nเชื่อเถอะ เพราะเคยลองพยายามมาแล้ว",shape=box,color=blue];
		j2653723130 -> j2703573661;
		j2653723130 -> j4040885891;
	j2703573661 [label="แต่ยังมีเรื่องอื่นอีกมากมายที่ทำให้มีความสุขได้นี่นา",shape=box,color=red];
		j2703573661 -> j2526732845;
	j4040885891 [label="ข้าเจอมากับตัวตอนที่อยู่ Duviri เลยว่าบางครั้งการพยายาม \"ซ่อมความรู้สึก\" เป็นทางเลือกที่แย่ที่สุดแล้ว",shape=box,color=red];
		j4040885891 -> j3175984145;
	j2526732845 [label="Ay, sí ก็ใช่\nฉันรู้นั่นแหละว่ามี\nแต่บางครั้งก็หวังนะว่า\nคนอื่นจะเข้าใจว่าส่วนนั้นที่ซ่อนอยู่ในใจ\nมันคงไม่ยอมให้ความสุขเข้าไปง่าย ๆ",shape=box,color=blue];
		j2526732845 -> j515918218;
	j3175984145 [label="Síí...\nแม้บางครั้งมันจะล่อตาล่อใจอยู่บ้างก็ตาม jajaja\nแค่หวังว่ามันหายไป\nแต่จำที่เคยบอกได้นะว่าเกิดอะไรขึ้น\nเมื่อทุกอย่างด้านชาไปหมด",shape=box,color=blue];
		j3175984145 -> j1381825807;
	j515918218 [label="เคยหวังนะว่าจะเปลี่ยนตัวเองได้\nแต่เราก็เป็นในแบบที่เราเป็นนั่นแหละ\nและเลิกโทษตัวเองที่เป็นแบบนั้น\nไปนานแล้ว",shape=box,color=blue];
		j515918218 -> "Chat ends.";
	j1381825807 [label="ไม่เคยคิดอยากให้ใครต้องเจออะไรแบบนั้นหรอกนะ\nอ้อ ยกเว้นไอ้ Albrecht ไว้คนนึงละกัน\nPinche güey\nแต่ใจมันก็เย็นชาเกินพออยู่แล้ว",shape=box,color=blue];
		j1381825807 -> j3721672694;
		j1381825807 -> j3175563923;
	j3721672694 [label="เราจะทำยังไงให้เจ้าเลิกคิดเรื่องพวกนั้นได้ หรือว่าอยากอยู่บ้านเฉย ๆ มากกว่าล่ะ?",shape=box,color=red];
		j3721672694 -> j1870824820;
	j3175563923 [label="เราทำได้แค่หวังว่าเขาจะวางแผนระยะยาวไว้อยู่แล้ว",shape=box,color=red];
		j3175563923 -> j3578204879;
	j1870824820 [label="เออ ดีแฮะคำถามนี้\nพูดตามตรงก็ไม่รู้เหมือนกัน\nอยู่บ้านเฉย ๆ ก็ดี \nหรือจะออกไปฆ่าอะไรสักอย่างดี\n¿Te quedas?, ¿o vamos a matar cosas? \nเลือกอะไรดี...",shape=box,color=blue];
