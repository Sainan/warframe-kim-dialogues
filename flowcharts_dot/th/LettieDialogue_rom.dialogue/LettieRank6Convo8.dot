		j2035642032 -> j898058737;
	j1580888776 [label="เราต้องทำให้มันรู้สึกบ้างว่าจะเป็นยังไงเมื่อต้องกลายเป็นคนที่กลัวเสียเองและทั้งโลกหันมาต่อต้าน\nทุกคนพากันหัวเราะเยาะ\nพากันล้อเลียนมัน",shape=box,color=blue];
		j1580888776 -> j3830935259;
	j898058737 [label="ใครบอกว่านั่นคือแผนกัน\nคนแบบนี้น่ะ\nเป็นแค่ไอ้พวกขี้ขลาดทั้งนั้นแหละ ดีแต่แอบพ่นคำพูดแย่ ๆ อยู่ในที่ที่คิดว่าตัวเองปลอดภัย",shape=box,color=blue];
		j898058737 -> j1580888776;
	j3830935259 [label="รู้หรือเปล่าว่ามันเป็นยังไงที่ต้องโตมาในร่างกายแบบนี้?\nน้ำเสียงแบบนี้?\nแต่งตัวแบบนี้?\nแล้วต้องอยู่ท่ามกลางเด็ก ๆ ในฐานทัพทหารที่ไม่มีใครเหมือนเราเลย",shape=box,color=blue];
		j3830935259 -> j4257332396;
	j4257332396 [label="กลับบ้านทีไร ก็บอบช้ำทุกที เพราะดันไม่ยอมใคร\nMi mamá ก็ได้แต่บ่น บอกให้รู้จักยอม ๆ ซะบ้าง\n¿Quedarme callada?\nไม่มีทางซะหรอก",shape=box,color=blue];
		j4257332396 -> j580547789;
