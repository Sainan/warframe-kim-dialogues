		j3304750065 -> j1238970639;
	j1238970639 [label="ไม่รู้ว่าต้องทำอย่างไร\nไม่รู้ว่าจะทำได้หรือเปล่า\nแต่เธอทำลายกฎแห่งกาลเวลาและอวกาศนั่น",shape=box,color=blue];
