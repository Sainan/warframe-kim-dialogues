	j115197634 [label="มีอะไรที่เจ้าพอจะช่วยนางได้บ้างหรือเปล่า",shape=box,color=red];
		j115197634 -> j2020011693;
	j699183482 [label="JAJAJA ต้องจำไว้แล้วว่าห้ามตั้งเธอเป็นเบอร์ติดต่อฉุกเฉินเด็ดขาด\nSííí ยัยเด็กนี่หายไปยืดเส้นยืดสาย แต่ก็กลับมาแล้ว\nเพราะไอ้การวิจัยอาร์คิ-อะไรนั่นแหละ\nแต่คิดว่า... น่าจะเพราะพวกเราด้วย",shape=box,color=blue];
		j699183482 -> j3114904969;
	j432930448 [label="Sííí ไอ้การวิจัยอาร์คิ-อะไรนั่นแหละ\nแต่คิดว่า... น่าจะเพราะพวกเราด้วย",shape=box,color=blue];
		j432930448 -> j3114904969;
	j2020011693 [label="บางทีมันก็แค่ต้องใช้เวลา\nแต่ก็จะพยายามช่วยถ้าทำได้\nลูอารู้ดีว่ายัยเด็กนั่นก็ชอบเรื่องวิทยาศาสตร์การแพทย์มากขนาดไหน jajaja\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j2020011693 -> j2227748246;
	j3114904969 [label="มีหล่อนอยู่ใกล้ ๆ ด้วยก็ดีนะ\nคิดว่ายัยเด็กนั่นก็คงรู้ตัวนั่นแหละ\nเพราะเห็นชอบมาช่วยในการผ่าตัดด้วย แต่...\nElla siempre hace preguntas espeluznantes",shape=box,color=blue];
		j3114904969 -> j1223842750;
	j2227748246 [label="ช่วยไม่ได้ที่หล่อนดันเทเลพอร์ตได้\nสนุกดีนะเวลาที่เห็นยัยเด็กนั่นทำ Amir สะดุ้งโหยง\nไอ้ลมกรดบ้านั่นสมควรโดนบ้าง ทำกับพวกเรามามากพอแล้ว JAJAJAJA",shape=box,color=blue];
		j2227748246 -> "Chat ends.";
	j1223842750 [label="ช่วยไม่ได้ที่หล่อนดันเทเลพอร์ตได้\nสนุกดีนะเวลาที่เห็นยัยเด็กนั่นทำ Amir สะดุ้งโหยง\nไอ้ลมกรดบ้านั่นสมควรโดนบ้าง ทำกับพวกเรามามากพอแล้ว JAJAJAJA\nหวังว่าหล่อนจะไม่หายไปไหนตลอดกาลนะ",shape=box,color=blue];
		j1223842750 -> "Chat ends.";
