	j3888364022 [label="คงโทษยัยเด็กนั่นไม่ได้หรอกที่อยากหนีไปให้ไกล\nเพราะถ้าเราทำได้ ก็คงอยากทำเหมือนกัน\nแต่\nสังเกตเห็นว่าหล่อนไม่ได้หายไปไหนเลยนี่",shape=box,color=blue];
		j3888364022 -> j4106159365;
		j3888364022 -> j2379347384;
	j2178339263 [label="คงโทษยัยเด็กนั่นไม่ได้หรอกที่อยากหนีไปให้ไกล\nเพราะถ้าเราทำได้ ก็คงอยากทำเหมือนกัน\nแต่พอหล่อนโตขึ้น ความรู้สึกนั้นจะจางหายไปเอง",shape=box,color=blue];
