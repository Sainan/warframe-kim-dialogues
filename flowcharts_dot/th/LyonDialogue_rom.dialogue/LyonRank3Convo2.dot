digraph {
	"LyonRank3Convo2 begins." [color=orange];
		"LyonRank3Convo2 begins." -> j1185117268;
	j1185117268 [label="If I may, I wish to tell you a story of a stray alley cat who used to come by the back of the church.",shape=box,color=blue];
		j1185117268 -> j2865151818;
		j1185117268 -> j4104302508;
		j1185117268 -> j3426972941;
	j2865151818 [label="Go on.",shape=box,color=red];
		j2865151818 -> j3150568527;
	j4104302508 [label="Why?",shape=box,color=red];
		j4104302508 -> j3732133698;
	j3426972941 [label="[Ignore.]",shape=box,color=red];
		j3426972941 -> "Chat ends.";
	j3150568527 [label="Thank you.",shape=box,color=blue];
		j3150568527 -> j133770859;
	j3732133698 [label="I fear it would take more effort to explain than it would be worth.",shape=box,color=blue];
		j3732133698 -> j3935677924;
	"Chat ends." [color=orange];
	j133770859 [label="Though I suspect that this tale is not unique to this scruffy old tom, and my interactions with him seemingly noteworthy, it bears telling all the same.",shape=box,color=blue];
		j133770859 -> j909324121;
	j3935677924 [label="Never mind.",shape=box,color=blue];
		j3935677924 -> "Chat ends.";
	j909324121 [label="Every day he would come by to beg scraps and whatever meagre affections he could have from me or the other brothers and sisters who doted upon him.",shape=box,color=blue];
		j909324121 -> j1970721374;
	j1970721374 [label="He was a ragged thing, with a limp in his leg and missing part of an ear. ",shape=box,color=blue];
		j1970721374 -> j1664823987;
	j1664823987 [label="When he did not come by for a few days, Marie was quite beside herself with worry. But what is one to do for an old alley tom who has met their end, save to issue up a prayer to Lua?",shape=box,color=blue];
		j1664823987 -> j3437213928;
	j3437213928 [label="Boolean LyonStray is now true.",color=orange];
		j3437213928 -> j3127067167;
		j3437213928 -> j3073262707;
		j3437213928 -> j419094516;
	j3127067167 [label="[Let him continue.]",shape=box,color=red];
		j3127067167 -> j2374246492;
	j3073262707 [label="Is that allowed in your religion? Praying for animals, I mean.",shape=box,color=red];
		j3073262707 -> j2687220498;
	j419094516 [label="You would pray for the soul of a departed alley cat?",shape=box,color=red];
		j419094516 -> j928876576;
	j2374246492 [label="Regardless, imagine my surprise when I was fetching bread from the market and I saw the old tom sitting next to the owner of the stand.",shape=box,color=blue];
		j2374246492 -> j2729301513;
	j2687220498 [label="+10 Chemistry",color=orange];
		j2687220498 -> j3958512162;
	j928876576 [label="Of course. Some of the purest, brightest souls I have encountered were encased in the flesh of a beast. It is not for me to judge how the Luminaries have set them upon their paths.",shape=box,color=blue];
		j928876576 -> j1462008974;
	j2729301513 [label="He greeted me with a raspy meow, as he always did, and hopped down to rub against my leg.",shape=box,color=blue];
		j2729301513 -> j614594485;
	j3958512162 [label="A good question. In some sects, no. It would be seen as heresy. But in ours, yes. We recognize that animals have souls.",shape=box,color=blue];
		j3958512162 -> j1462008974;
	j1462008974 [label="Saint Elizabeth the Wise was known for her charity toward animals, though many traditions to do not recognize the Saints as apostles of the Luminaries.",shape=box,color=blue];
		j1462008974 -> j2598847732;
	j614594485 [label="And I would note, Drifter, that he did so without a limp.",shape=box,color=blue];
		j614594485 -> j70856091;
	j2598847732 [label="I find myself wondering if any influence of our order survived this long... but it was hardly the point of the conversation.",shape=box,color=blue];
		j2598847732 -> j1048712370;
	j70856091 [label="\"Ah, one of Old Devereaux's fools, I see.\" The man laughed as he bagged up my bread.",shape=box,color=blue];
		j70856091 -> j1662004688;
	j1048712370 [label="Boolean LyonLecture1 is now true.",color=orange];
		j1048712370 -> j2374246492;
	j1662004688 [label="It turns out the old cat was playing us, and several others, in the neighborhood. He was not starving, of failing health, or neglected in any way.",shape=box,color=blue];
		j1662004688 -> j4044921134;
	j4044921134 [label="Indeed, if the man's words were to be believed, he was quite a murderous fiend in regards to the local population of birds.",shape=box,color=blue];
		j4044921134 -> j4204599228;
		j4044921134 -> j3979550009;
		j4044921134 -> j670281304;
	j4204599228 [label="Did you stop feeding Old Devereaux when he came around?",shape=box,color=red];
		j4204599228 -> j1012991985;
	j3979550009 [label="Are you trying to warn me about Roathe?",shape=box,color=red];
		j3979550009 -> j1983102731;
	j670281304 [label="Are you the alley cat in this story?",shape=box,color=red];
		j670281304 -> j1859073496;
	j1012991985 [label="+10 Chemistry",color=orange];
		j1012991985 -> j1149487082;
	j1983102731 [label="There are a great many things to warn you about the devil \"Cardinal Dimanche\" put upon our doorstep. Perhaps this is one of them. Perhaps it is not.",shape=box,color=blue];
		j1983102731 -> j1493663410;
	j1859073496 [label="The Luminaries know I have certainly been worn at the edges as of late. But is this meant to stand as a warning about myself? Perhaps. Perhaps it is not.",shape=box,color=blue];
		j1859073496 -> j1493663410;
	j1149487082 [label="No, we did not. In fact, Marie greeted him with all the more affection for it, teasing him for being \"her little imp.\"",shape=box,color=blue];
		j1149487082 -> j2434333902;
	j1493663410 [label="It is simply a story to say that sometimes, when a creature seems to be in need -",shape=box,color=blue];
		j1493663410 -> j2421616447;
	j2434333902 [label="But we no longer fretted over him. We knew that Old Devereaux could quite adequately care for himself. He did not need us.",shape=box,color=blue];
		j2434333902 -> j535878670;
		j2434333902 -> j350989924;
	j2421616447 [label="+15 Chemistry",color=orange];
		j2421616447 -> j1336326654;
	j535878670 [label="What happened to Old Devereaux, do you know?",shape=box,color=red];
		j535878670 -> j2555952630;
	j350989924 [label="What do you think drove Old Devereaux to visit you, if it wasn't need?",shape=box,color=red];
		j350989924 -> j3104905189;
	j1336326654 [label="- check to see how sharp its claws may be.",shape=box,color=blue];
		j1336326654 -> "Chat ends.";
	j2555952630 [label="His next disappearance, two years later, turned permanent.",shape=box,color=blue];
		j2555952630 -> j1961802150;
		j2555952630 -> j2767263663;
	j3104905189 [label="The cynical answer I would supply you with would be \"greed.\" For if one could have one feast, why not two? Why not ten?",shape=box,color=blue];
		j3104905189 -> j2746535011;
		j3104905189 -> j1921732882;
	j1961802150 [label="Did you pray for him?",shape=box,color=red];
		j1961802150 -> j3313989738;
	j2767263663 [label="I hope he left this world comfortable and loved.",shape=box,color=red];
		j2767263663 -> j3091392009;
	j2746535011 [label="What would be the non-cynical answer?",shape=box,color=red];
		j2746535011 -> j150504645;
	j1921732882 [label="Does that remain the same if he was only seeking affection?",shape=box,color=red];
		j1921732882 -> j1380723803;
	j3313989738 [label="I lit a candle for him the night I learned of his death and prayed to Lua to guide his soul to... wherever she would guide a little imp like him.",shape=box,color=blue];
		j3313989738 -> j1188447860;
	j3091392009 [label="May I ask why?",shape=box,color=blue];
		j3091392009 -> j3813959388;
		j3091392009 -> j1699151276;
	j150504645 [label="+10 Chemistry",color=orange];
		j150504645 -> j3785477759;
	j1380723803 [label="An avaricious desire for affection is still gluttony, though it is not a hunger fed by meat and wine. And to seek it in such false pretenses?",shape=box,color=blue];
		j1380723803 -> j4134522493;
		j1380723803 -> j3380549571;
	j1188447860 [label="And thanked Old Devereaux for all the joy he brought Marie in exchange for all those coveted bits of chicken gristle and head scratches.",shape=box,color=blue];
		j1188447860 -> j157673442;
	j3813959388 [label="He was an animal. He was just searching for fulfillment - food, shelter, love - he wasn't inspired by the same motivations as people. He wasn't \"lying,\" he was hunting with a different set of tools.",shape=box,color=red];
		j3813959388 -> j1414826405;
	j1699151276 [label="I have seen a lot of violence, Lyon. A lot of it I have caused. I have come to hope that everyone, no matter who they are or what they've done, can have a peaceful death surrounded by those who love them.",shape=box,color=red];
		j1699151276 -> j828390386;
	j3785477759 [label="I found myself oddly... respecting the cat, for the place it had found itself in the world.",shape=box,color=blue];
		j3785477759 -> j382433235;
	j4134522493 [label="He was a cat, Lyon. He hardly knew what he was doing.",shape=box,color=red];
		j4134522493 -> j1930645756;
	j3380549571 [label="We are still speaking about a cat, yes?",shape=box,color=red];
		j3380549571 -> j2485813266;
	j157673442 [label="Thank you. I will not hinder you in your day any longer.",shape=box,color=blue];
		j157673442 -> j944546954;
	j1414826405 [label="He wasn't denying others anything by making you all his \"fools.\" If anything... you all seem to have been enriched by his visits.",shape=box,color=red];
		j1414826405 -> j4142512107;
	j828390386 [label="Fascinating. I would expect you to despise your enemies. But that is my own folly - to assume I know how anyone in this day and age would comport themselves.",shape=box,color=blue];
		j828390386 -> j984915553;
	j382433235 [label="Here was a creature who had learned to use its condition - its appearance, its age, its scars - as a weapon against \"the fools\" around him who did not see through his ruse.",shape=box,color=blue];
		j382433235 -> j382264891;
	j1930645756 [label="He knew well enough to feign a limp. ",shape=box,color=blue];
		j1930645756 -> j150504645;
	j2485813266 [label="Infer from this conversation whatever you wish, Drifter.",shape=box,color=blue];
		j2485813266 -> j150504645;
	j944546954 [label="-F. Lyon Allard",shape=box,color=blue];
		j944546954 -> "Chat ends.";
	j4142512107 [label="Add -1 to Thermostat counter",color=orange];
		j4142512107 -> j3853206177;
	j984915553 [label="Add 1 to Thermostat counter",color=orange];
		j984915553 -> j507060350;
	j382264891 [label="An imp in matted fur, he truly was. Yet I found myself petting him all the same when he came 'round to visit.",shape=box,color=blue];
		j382264891 -> j2153812812;
	j3853206177 [label="Yes. I suppose we were. And we were not experiencing a shortage of bits of chicken gristle and scratches.",shape=box,color=blue];
		j3853206177 -> j1162557709;
	j507060350 [label="Let alone someone with your particularly fascinating upbringing. ",shape=box,color=blue];
		j507060350 -> j1251440446;
	j2153812812 [label="And equally heartbroken when, two years later, his next disappearance was permanent.",shape=box,color=blue];
		j2153812812 -> j1961802150;
		j2153812812 -> j2767263663;
	j1162557709 [label="Perhaps that is why I lit a candle for him and prayed to Lua to take his soul and guide it to... wherever she would take a little imp like him.",shape=box,color=blue];
		j1162557709 -> j742294221;
	j1251440446 [label="+5 Chemistry",color=orange];
		j1251440446 -> j2306704805;
	j742294221 [label="+5 Chemistry",color=orange];
		j742294221 -> j2620086161;
	j2306704805 [label="Thank you. I will not hinder you in your day any longer. This has been a most interesting conversation. Until we speak again.",shape=box,color=blue];
		j2306704805 -> j944546954;
	j2620086161 [label="And why I thanked Old Devereaux in my prayers that night for all the joy he had brought Marie.",shape=box,color=blue];
		j2620086161 -> j95436330;
	j95436330 [label="Perhaps his little villainy was of some good in a roundabout manner.",shape=box,color=blue];
		j95436330 -> j2306704805;
}