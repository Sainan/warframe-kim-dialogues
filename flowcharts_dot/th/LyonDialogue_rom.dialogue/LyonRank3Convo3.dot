digraph {
	"LyonRank3Convo3 begins." [color=orange];
		"LyonRank3Convo3 begins." -> j1202015404;
	j1202015404 [label="I was assisting M. Loid in his library, replacing books upon the shelves, though he insisted that those bizarre flying... contraptions could do the deed instead -",shape=box,color=blue];
		j1202015404 -> j3640536022;
	j3640536022 [label="And I came across a curious volume detailing children's tales, set in a fictional world penned by one Euleria Entrati.",shape=box,color=blue];
		j3640536022 -> j670399414;
	j670399414 [label="Noticing that the author shared the last name with the true name of our \"Cardinal Dimanche,\" I immediately set the copy aside for myself.",shape=box,color=blue];
		j670399414 -> j2148255184;
		j670399414 -> j3535464302;
		j670399414 -> j3426972941;
	j2148255184 [label="I believe I know which book you're referencing...",shape=box,color=red];
		j2148255184 -> j3247205057;
	j3535464302 [label="Can we skip the preamble, please? Ask me what you want to know.",shape=box,color=red];
		j3535464302 -> j1015593024;
	j3426972941 [label="[Ignore.]",shape=box,color=red];
		j3426972941 -> "Chat ends.";
	j3247205057 [label="+5 Chemistry",color=orange];
		j3247205057 -> j1270976786;
	j1015593024 [label="Boolean LyonMITW1 is now true.",color=orange];
		j1015593024 -> j218757097;
	"Chat ends." [color=orange];
	j1270976786 [label="I would suspect - judging by the horrified look that M. Loid gave me, and his insistence that I replace the book immediately, \"lest I upset you,\" that you do know something of it, yes.",shape=box,color=blue];
		j1270976786 -> j1804685395;
	j218757097 [label="คำถามของผมเกี่ยวข้องกับธรรมชาติของ \"การทำให้แนวคิดกลายเป็นรูปธรรม\" หลังจากอ่านแล้ว มันอธิบายได้ว่าหนังสือเล่มนี้มีจุดประสงค์เพื่อสอนให้เด็ก ๆ ป้องกันไม่ให้อารมณ์ของตนโต้ตอบกับวอยด์",shape=box,color=blue];
		j218757097 -> j3136078024;
		j218757097 -> j2343630211;
	j1804685395 [label="\"The Tales of Duviri.\" While I received quite a... exhausted and longsuffering explanation from M. Loid regarding what you endured, there is one particular matter over which I would enquire.",shape=box,color=blue];
		j1804685395 -> j2900947243;
	j3136078024 [label="For what little good it did. Especially in my case.",shape=box,color=red];
		j3136078024 -> j2975756384;
	j2343630211 [label="Strong emotions interacting with the Void can cause... serious problems.",shape=box,color=red];
		j2343630211 -> j1705187617;
	j2900947243 [label="If, of course, it is not too troubling to do so?",shape=box,color=blue];
		j2900947243 -> j3904735226;
		j2900947243 -> j389775684;
	j2975756384 [label="How much of our lives has been prescribed to us by others as fact, only to be proven useless when tested?",shape=box,color=blue];
		j2975756384 -> j351888391;
	j1705187617 [label="So it seems. I have met the Cavia. I have been told of Void Angels. I have seen the Murmur first-hand. ",shape=box,color=blue];
		j1705187617 -> j3305854426;
	j3904735226 [label="No. Go ahead.",shape=box,color=red];
		j3904735226 -> j1015593024;
	j389775684 [label="It depends entirely upon the specifics, I suppose. I have no clue what you are about to ask me.",shape=box,color=red];
		j389775684 -> j381620447;
	j351888391 [label="Boolean LyonFaith1 is now true.",color=orange];
		j351888391 -> j3216115895;
	j3305854426 [label="And such is the nature of my curiosity. I have come to wonder this \"aloud\" to see if you might be able to expound upon it. When the Void is given form, what wanders from it - is it \"real?\"",shape=box,color=blue];
		j3305854426 -> j3890655304;
		j3305854426 -> j392679586;
		j3305854426 -> j1171305879;
	j381620447 [label="+5 Chemistry",color=orange];
		j381620447 -> j2135206208;
	j3216115895 [label="I often find myself wondering why fill the heads of others with such useless lies? Is it power they seek? Influence? Or do you think they honestly believe their own words, and are ignorant to their own untruths?",shape=box,color=blue];
		j3216115895 -> j3956619431;
		j3216115895 -> j3138726114;
	j3890655304 [label="No, I think everything created by the Void is simply... temporary. A fragment of whoever or whatever created it. A ghost of a memory.",shape=box,color=red];
		j3890655304 -> j3349633455;
	j392679586 [label="I believe so, yes. Like a painting made by an artist, it might have come out of someone's mind, but it's real once it's made.",shape=box,color=red];
		j392679586 -> j1222755231;
	j1171305879 [label="That depends entirely upon your definition of \"real.\"",shape=box,color=red];
		j1171305879 -> j3892248048;
	j2135206208 [label="Yes, forgive me. I am not skilled at simply... conversing in a direct manner. Especially in such a strange method as this. But I will endeavor to do so now.",shape=box,color=blue];
		j2135206208 -> j1015593024;
	j3956619431 [label="In this instance, I think Euleria Entrati meant what she wrote to be useful. It simply did not help me when I needed it.",shape=box,color=red];
		j3956619431 -> j1272577992;
	j3138726114 [label="I don't know. Which lies were your head filled with, Lyon?",shape=box,color=red];
		j3138726114 -> j3897817206;
	j3349633455 [label="Then are the effects caused by such elements of the Void not \"real?\"",shape=box,color=blue];
		j3349633455 -> j2208938527;
	j1222755231 [label="But the analogy you use is not quite accurate, is it? Matter retrieved from the Void returns to the Void, does it not?",shape=box,color=blue];
		j1222755231 -> j382270609;
	j3892248048 [label="+5 Chemistry",color=orange];
		j3892248048 -> j3814480505;
	j1272577992 [label="In her defense, my Void exposure was far more prolonged than for what she was intending the book be used as a guide.",shape=box,color=red];
		j1272577992 -> j3556833726;
	j3897817206 [label="None that I have come to you to discuss.",shape=box,color=blue];
		j3897817206 -> "Chat ends.";
	j2208938527 [label="Many a memory has driven a man to the bottle or inspired them to take their own lives. Are those memories not \"real?\"",shape=box,color=blue];
		j2208938527 -> j2719874875;
	j382270609 [label="Very well, a thought, then. A poem or a song exists even if it isn't written down.",shape=box,color=red];
		j382270609 -> j2178358404;
	j3814480505 [label="Might you elaborate?",shape=box,color=blue];
		j3814480505 -> j2663073835;
	j3556833726 [label="+5 Chemistry",color=orange];
		j3556833726 -> j4024526681;
	j2719874875 [label="But those were internal forces that the man let work on him, is my point. Not external ones.",shape=box,color=red];
		j2719874875 -> j4068116549;
	j2178358404 [label="But if it is forgotten it ceases to be. A story lost to time is lost forever.",shape=box,color=blue];
		j2178358404 -> j2843457723;
	j2663073835 [label="How do you measure \"realness?\"",shape=box,color=red];
		j2663073835 -> j832842007;
		j2663073835 -> j2570962539;
		j2663073835 -> j1416030017;
	j4024526681 [label="Hapless ignorance is the best for which any of us may hope might cause the malignancy of others.",shape=box,color=blue];
		j4024526681 -> j1524084812;
	j4068116549 [label="But what is the difference, is my question? If the end result is the same, does it matter?",shape=box,color=blue];
		j4068116549 -> j3407322979;
		j4068116549 -> j603554518;
		j4068116549 -> j1490912185;
	j2843457723 [label="A revolution struck from the minds of those who wield it is a dull sword indeed.",shape=box,color=blue];
		j2843457723 -> j3407322979;
		j2843457723 -> j603554518;
		j2843457723 -> j1490912185;
	j832842007 [label="By physical permanence? Weight and mass? What has come from the Void is only temporarily here.",shape=box,color=red];
		j832842007 -> j1022621427;
	j2570962539 [label="By its effect on events? What has come from the Void has changed the path of history.",shape=box,color=red];
		j2570962539 -> j3591105361;
	j1416030017 [label="By its effect on others? Influence from \"things\" that have come from the Void certainly has done that.",shape=box,color=red];
		j1416030017 -> j3763975855;
	j1524084812 [label="My curiosity, however, is not regarding the book nor its usefulness. Forgive me for waxing poetic for a moment.",shape=box,color=blue];
		j1524084812 -> j46320194;
	j3407322979 [label="You aren't asking if they're \"real,\" you're asking if they're \"valid.\" If they should be dismissed or not.",shape=box,color=red];
		j3407322979 -> j2291912808;
	j603554518 [label="I would also ask whether or not your Luminaries are \"real\" simply because you cannot shake the hands of Sol or Lua.",shape=box,color=red];
		j603554518 -> j2136410304;
	j1490912185 [label="You're asking, in a roundabout way, if all \"things\" from the Void are only here because we've willed them into existence.",shape=box,color=red];
		j1490912185 -> j3261054396;
	j1022621427 [label="What comes from the Void must return to it, is what you are saying? But is not the Void, by definition, comprised of nothing?",shape=box,color=blue];
		j1022621427 -> j2185336068;
	j3591105361 [label="A valid point. Is a revolution not \"real\" simply because you cannot put it in a basket and weigh it?",shape=box,color=blue];
		j3591105361 -> j3763975855;
	j3763975855 [label="It certainly cost many souls their heads. They would argue very much to its validity. However, consider this:",shape=box,color=blue];
		j3763975855 -> j2023832531;
	j46320194 [label="I have come to wonder this \"aloud\" to see if you might be able to expound upon it. When the Void is given form, what wanders from it - is it \"real?\"",shape=box,color=blue];
		j46320194 -> j3890655304;
		j46320194 -> j1171305879;
		j46320194 -> j392679586;
	j2291912808 [label="+5 Chemistry",color=orange];
		j2291912808 -> j3014564611;
	j2136410304 [label="We are not discussing the Luminaries. We are discussing the Void.",shape=box,color=blue];
		j2136410304 -> j2775141729;
		j2136410304 -> j3825560540;
		j2136410304 -> j2101027399;
		j2136410304 -> j2146744671;
	j3261054396 [label="+5 Chemistry",color=orange];
		j3261054396 -> j3534277142;
	j2185336068 [label="I suppose? The parts of the Void that I have interacted with tends to already be imprinted upon. We have already given it some kind of shape or form. Or we have blurred the line too far between realities.",shape=box,color=red];
		j2185336068 -> j3824224429;
		j2185336068 -> j3465311879;
	j2023832531 [label="A revolution is only given validity due to its existence in the minds of those who wield it.",shape=box,color=blue];
		j2023832531 -> j4003424677;
	j3014564611 [label="Yes, I suppose you could phrase it that way. Should we ignore the ghosts that haunt our halls, or if, by paying them any heed at all, we are reinforcing them?",shape=box,color=blue];
		j3014564611 -> j2775141729;
		j3014564611 -> j3825560540;
		j3014564611 -> j2101027399;
		j3014564611 -> j2146744671;
	j2775141729 [label="I believe that the challenges we face right now are dangerous. Extremely dangerous. And we should treat them as such.",shape=box,color=red];
		j2775141729 -> j3426919777;
	j3825560540 [label="Ghosts are real enough to cause us pain. But they can't be treated with a bullet. At least not one that I've found.",shape=box,color=red];
		j3825560540 -> j3435396988;
	j2101027399 [label="What's this all about, Lyon? Really?",shape=box,color=red];
		j2101027399 -> j3140047228;
	j2146744671 [label="I... honestly don't know, Lyon. And I wish I did.",shape=box,color=red];
		j2146744671 -> j1069065912;
	j3534277142 [label="Yes, I suppose you could phrase it that way. How are we to be certain that we have not... made manifest our own devils?",shape=box,color=blue];
		j3534277142 -> j2775141729;
		j3534277142 -> j3825560540;
		j3534277142 -> j2101027399;
		j3534277142 -> j2146744671;
	j3824224429 [label="Whole structures, indeed Lua itself have been placed into the Void and retrieved. So it does not consume matter by simply existing within it.",shape=box,color=red];
		j3824224429 -> j2026072007;
	j3465311879 [label="What you're implying is the existence of a \"deeper\" Void where nothing can exist, and I honestly cannot speak to that.",shape=box,color=red];
		j3465311879 -> j4140085081;
	j4003424677 [label="If it were to be struck from the thoughts of all those around, it would cease to exist, would it not?",shape=box,color=blue];
		j4003424677 -> j603554518;
		j4003424677 -> j3407322979;
		j4003424677 -> j1490912185;
	j3426919777 [label="Boolean LyonReal1 is now true.",color=orange];
		j3426919777 -> j190672870;
	j3435396988 [label="Boolean LyonFake1 is now true.",color=orange];
		j3435396988 -> j3033813077;
	j3140047228 [label="Boolean LyonFaith1 is now true.",color=orange];
		j3140047228 -> j3657063545;
	j1069065912 [label="Your honesty to admit that which you do not know is refreshing. Would that more of humanity had such a gift.",shape=box,color=blue];
		j1069065912 -> j2507318774;
	j2026072007 [label="I do not care about matter placed into the Void and retrieved. I care about what has been invented from the Void out of whole cloth.",shape=box,color=blue];
		j2026072007 -> j3407322979;
		j2026072007 -> j603554518;
		j2026072007 -> j1490912185;
	j4140085081 [label="I appreciate the candor. I suppose I am less interested in what cannot exist, and what now does.",shape=box,color=blue];
		j4140085081 -> j3407322979;
		j4140085081 -> j603554518;
		j4140085081 -> j1490912185;
	j190672870 [label="Yes, I suppose you would know what can be struck down from the Void by force and what cannot...",shape=box,color=blue];
		j190672870 -> j2985153768;
	j3033813077 [label="Perhaps that is why so many turn to excess... to staunch a bleeding wound, unseen but aching. Curable. But by strength of soul, not armaments.",shape=box,color=blue];
		j3033813077 -> j2985153768;
	j3657063545 [label="I have clearly gone about this all wrong. We will discuss this another time. Forgive my intrusion.",shape=box,color=blue];
		j3657063545 -> j944546954;
	j2507318774 [label="Regardless, I find my thoughts on the matter still entirely unsettled.",shape=box,color=blue];
		j2507318774 -> j3657063545;
	j2985153768 [label="Though I find myself, as always, in doubt. Forgive my intrusion. Thank you for your time, Drifter.",shape=box,color=blue];
		j2985153768 -> j944546954;
	j944546954 [label="-F. Lyon Allard",shape=box,color=blue];
		j944546954 -> "Chat ends.";
}