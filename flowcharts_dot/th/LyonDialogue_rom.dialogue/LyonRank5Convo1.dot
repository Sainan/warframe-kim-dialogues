		1429 -> 1435;
	1430 [label="Good. I am glad you have snapped out of your own momentary insanity. It must be contagious after all. Perhaps we take an intermission from this device, as I fear it has begun to rot your brain.",shape=box,color=blue];
		1430 -> 1436;
