		1415 -> 1421;
	1416 [label="I am all right to continue, thank you. It has passed, as they always do. These... visions of mine are like clouds that pass over Lua. They can be total in their darkness, but they are often brief.",shape=box,color=blue];
		1416 -> 1422;
