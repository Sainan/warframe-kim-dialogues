		1364 -> 1366;
	1365 [label="please make it stop",shape=box,color=blue];
		1365 -> 1367;
	1366 [label="Sometimes I wonder if it would not be better to become one of those truly empty-eyed Harrows I see in my mind's eye, stretching as far as my nightmares will allow.",shape=box,color=blue];
