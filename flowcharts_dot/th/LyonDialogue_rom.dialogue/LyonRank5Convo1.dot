	1351 [label="I know. And I have been egregiously avoiding the topic. His name alone",shape=box,color=blue];
		1351 -> 1354;
	1352 [label="I know I have been egregiously avoiding the topic, and I apologize. But it is liable to send me into a vision from which I am not sure I may recover easiliy.",shape=box,color=blue];
		1352 -> 1355;
	1353 [label="I assure you, we will. I know I have been egregiously avoiding the topic, and I apologize. But it is liable to send me into a vision from which I am not sure I may recover easiliy.",shape=box,color=blue];
		1353 -> 1355;
	1354 [label="it threatens to",shape=box,color=blue];
		1354 -> 1356;
	1355 [label="I do not wish to once more have to cut this conversation short because I am unable to continue due to my own infirmities.",shape=box,color=blue];
		1355 -> 1357;
		1355 -> 1358;
		1355 -> 1359;
	1356 [label="it brings images of a man in chains",shape=box,color=blue];
		1356 -> 1360;
	1357 [label="I don't think I would call anyone who has had to endure what you have \"infirm,\" Lyon.",shape=box,color=red];
		1357 -> 1361;
	1358 [label="Infirm is a terrible way to say \"cursed with visions he didn't ask for.\" But suit yourself.",shape=box,color=red];
