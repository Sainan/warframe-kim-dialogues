	1409 [label="Which I know is not entirely uncommon for me, however, I feel as though I should reply to this in some",shape=box,color=blue];
		1409 -> 1415;
	1410 [label="Do you want to stop here? Or can you continue? I understand either way.",shape=box,color=red];
		1410 -> 1416;
	1412 [label="It's all right. I'm here for you. Are you going to be okay?",shape=box,color=red];
		1412 -> 1418;
