		1405 -> 1411 [label="false",color=purple];
		1405 -> 1412 [label="false",color=purple];
	1406 [label="But it... is... not who I am. And it is not who I shall ever be. I am to remain as this... broken bulwark, this shattered shield...",shape=box,color=blue];
		1406 -> 1413;
