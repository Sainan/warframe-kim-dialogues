	1398 [label="Chat ends.",color=orange];
	1399 [label="I must beg your forgiveness. There are moments where my lucidity fails me, and I despise when others witness them.",shape=box,color=blue];
		1399 -> 1405;
	1400 [label="It would be so easy to surrender. To give up. To lay my agony at the altar of suffering and say no more.",shape=box,color=blue];
		1400 -> 1406;
	1401 [label="It would be so easy to surrender. To give up. To lay my agony at the altar of suffering and say no more. Or to do far worse - to do that which many have worried I might with a blade in the great dark of the night.",shape=box,color=blue];
		1401 -> 1406;
	1403 [label="There is... merely one issue, Drifter. How might I take your words as truth when I know you have spun falsehoods before?",shape=box,color=blue];
