	1359 [label="You know what you're capable of, so I'll follow your lead.",shape=box,color=red];
		1359 -> 1362;
	1360 [label="cast in blood",shape=box,color=blue];
		1360 -> 1363;
	1361 [label="I appreciate the sentiment. But I know I am but a shattered stained glass window on the best of days. I stand here wondering where many of the pieces have gone.",shape=box,color=blue];
		1361 -> 1364;
	1362 [label="Thank you. I marvel at your patience. I know I am but a shattered stained glass window on the best of days. I stand here wondering where many of the pieces have gone.",shape=box,color=blue];
		1362 -> 1364;
	1363 [label="hewn of sinew and flesh",shape=box,color=blue];
		1363 -> 1365;
