	edge [fontname="Roboto Condensed"];

	"LyonRank4Convo3 begins." [color=orange];
		"LyonRank4Convo3 begins." -> j2131917026;
		"LyonRank4Convo3 begins." -> j2832054751;
		"LyonRank4Convo3 begins." -> j1610572375;
	j2131917026 [label="How are you getting along with the Cavia?",shape=box,color=red];
		j2131917026 -> j2815237460;
	j2832054751 [label="What do you think of Loid?",shape=box,color=red];
		j2832054751 -> j2686325985;
	j1610572375 [label="[จบ]",shape=box,color=red];
		j1610572375 -> "Chat ends.";
	j2815237460 [label="I very much delight in listening to their banter, though as you can imagine, I do not myself partake. I have little to add to their discourse.",shape=box,color=blue];
		j2815237460 -> j1859962241;
	j2686325985 [label="I find him most agreeable. Indeed, of my new... cohorts, he is the one I find the one I am drawn to the company of the most.",shape=box,color=blue];
		j2686325985 -> j1136710627;
	"Chat ends." [color=orange];
	j1859962241 [label="It concerns me though, when I find Roathe standing and conversing with Bird 3 at length. I do not know what he means to accomplish by doing so.",shape=box,color=blue];
		j1859962241 -> j2507757158;
	j1136710627 [label="Though that likely comes as a surprise to absolutely no one, I suppose. We are of a very similar demeanor at first glance.",shape=box,color=blue];
		j1136710627 -> j1768421264;
	j2507757158 [label="Boolean LyonRoatheCavia1 is now true.",color=orange];
		j2507757158 -> j1804764460;
		j2507757158 -> j3434016574;
	j1768421264 [label="It is the young Operator that I find more strange... and the one they call the Lotus. And how we are kept at arms length from them.",shape=box,color=blue];
		j1768421264 -> j2338329353;
	j1804764460 [label="Hm. I'll ask him about that.",shape=box,color=red];
		j1804764460 -> j1894655326;
	j3434016574 [label="Why do you think he's after something?",shape=box,color=red];
		j3434016574 -> j2058777980;
	j2338329353 [label="We are allowed to interact, of course. But not like this. Not here. Why is that?",shape=box,color=blue];
		j2338329353 -> j1956277612;
		j2338329353 -> j3029903371;
	j1894655326 [label="Perhaps that is wise. I would hate to see him manipulate those creatures into being objects of use more than they already have.",shape=box,color=blue];
		j1894655326 -> j1768421264;
	j2058777980 [label="Roathe always has a motive in mind when he is conversing with anyone. I would hate to see him manipulate those creatures into being objects of use any more than they already have.",shape=box,color=blue];
		j2058777980 -> j615159927;
	j1956277612 [label="The kid... has their own nonsense they're going through. We can't ask even more of them. It isn't right.",shape=box,color=red];
		j1956277612 -> j4084656338;
	j3029903371 [label="I... guess it's because I have \"previous experience\" with protoframes?",shape=box,color=red];
		j3029903371 -> j3260070664;
	j615159927 [label="It may be worth investigating, if you have the time. Though that is entirely your prerogative.",shape=box,color=blue];
		j615159927 -> j1768421264;
	j4084656338 [label="Yes. I have heard whispers of what they have been forced to endure. Tales of war and... broken friendship, torn asunder.",shape=box,color=blue];
		j4084656338 -> j1348530898;
	j3260070664 [label="Check boolean IsDating",color=orange];
		j3260070664 -> j812455016 [label=true,color=green];
		j3260070664 -> j2619061323 [label=false,color=brown];
	j1348530898 [label="It is heartbreaking to me, what is destroyed in the act of war. Stranger to me still, what can be created by it.",shape=box,color=blue];
		j1348530898 -> j2619061323;
	j812455016 [label="Hm. Is that what they call it now? \"Previous experience?\" How remarkably tasteful. While Entrati seems to have made quite the mess of things, I am glad you have... found a way to entertain yourself.",shape=box,color=blue];
		j812455016 -> j3934816614;
		j812455016 -> j1990854216;
		j812455016 -> j170113210;
	j2619061323 [label="M. Loid has told me of your \"misadventure\" in the Höllvania of your past, our future. Entrati certainly has made quite the mess of things.",shape=box,color=blue];
		j2619061323 -> j2606738428;
		j2619061323 -> j2848312654;
	j3934816614 [label="Did I do something wrong, here?",shape=box,color=red];
		j3934816614 -> j3487893497;
	j1990854216 [label="Careful, or else I might think you're wondering if the grass isn't a bit greener on the other side of the fence, Priest.",shape=box,color=red];
		j1990854216 -> j619519124;
	j170113210 [label="You make it sound like it's just a fling, Lyon. Please don't insult me like that.",shape=box,color=red];
		j170113210 -> j1331458418;
	j2606738428 [label="It could have gone far worse, believe me.",shape=box,color=red];
		j2606738428 -> j109464090;
	j2848312654 [label="They're good friends of mine, those protoframes. They've become like family to me.",shape=box,color=red];
		j2848312654 -> j4080788059;
	j3487893497 [label="Check boolean LyonFirstFlirt",color=orange];
		j3487893497 -> j1276016647 [label=true,color=green];
		j3487893497 -> j4288419985 [label=false,color=brown];
	j619519124 [label="Check boolean LyonFirstFlirt",color=orange];
		j619519124 -> j1276016647 [label=true,color=green];
		j619519124 -> j1862834215 [label=false,color=brown];
	j1331458418 [label="Check boolean LyonFirstFlirt",color=orange];
		j1331458418 -> j1276016647 [label=true,color=green];
		j1331458418 -> j613489405 [label=false,color=brown];
	j109464090 [label="And I am certain this was all by Entrati's grand and masterful plan. To entrust the fate of the future to you and a band of misfits.",shape=box,color=blue];
		j109464090 -> j207313587;
	j4080788059 [label="My grandparents met during the Gaullique Revolution. War and death have always been partners that lead to a dance of camaraderie in the strangest of ways.",shape=box,color=blue];
		j4080788059 -> j3628502303;
	j1276016647 [label="Forgive me. It just seems to me that last we discussed matters, you... ",shape=box,color=blue];
		j1276016647 -> j3221870280;
	j4288419985 [label="Forgive me. I do not know your heart nor the hearts of others. What you do in your own time with others is purely your business.",shape=box,color=blue];
		j4288419985 -> j3296066148;
		j4288419985 -> j2576717080;
	j1862834215 [label="Forgive me. No, you are right. I do not mean to sound jealous or as though I fashion myself some kind of provocateur. What you do in your own time with others is purely your own business.",shape=box,color=blue];
		j1862834215 -> j3296066148;
		j1862834215 -> j2576717080;
	j613489405 [label="Of course. Forgive me. I do not know your heart nor the hearts of others. What you do in your own time with others is purely your business.",shape=box,color=blue];
		j613489405 -> j3296066148;
		j613489405 -> j2576717080;
	j207313587 [label="I... Drifter - I know I am not the most... affable of individuals you are forced to interact with, and for that I continue to apologize.",shape=box,color=blue];
		j207313587 -> j3174591953;
	j3628502303 [label="Boolean LyonBackstory2 is now true.",color=orange];
		j3628502303 -> j941936871;
		j3628502303 -> j2774038524;
	j3221870280 [label="Never mind... I should not be surprised when hearts are fickle and quicksilvered. Particularly so when I am involved.",shape=box,color=blue];
		j3221870280 -> j1110476878;
		j3221870280 -> j3234713569;
	j3296066148 [label="I went through... a lot with them. It tends to bring people together.",shape=box,color=red];
		j3296066148 -> j2431361423;
	j2576717080 [label="[Confess Feelings.] Honestly, I've been trying to figure out how to bring this topic up with you at some point, anyway.",shape=box,color=red];
		j2576717080 -> j1976399736;
	j3174591953 [label="It is simply the way that I am, and I know not how to change. Indeed, I do not think I am capable of undoing the damage to my soul that has been rendered unto me by the damned that have come to haunt me.",shape=box,color=blue];
		j3174591953 -> j2465489151;
	j941936871 [label="That really does seem to be the case, everywhere throughout history.",shape=box,color=red];
		j941936871 -> j2148296869;
	j2774038524 [label="I'd love to know more about your family.",shape=box,color=red];
		j2774038524 -> j881896397;
	j1110476878 [label="Wait. You're getting the wrong idea. I didn't mislead you. Things are just - well, complicated.",shape=box,color=red];
		j1110476878 -> j1534244641;
	j3234713569 [label="I figured you weren't interested in me.",shape=box,color=red];
		j3234713569 -> j933019653;
	j2431361423 [label="My grandparents met during the Gaullique Revolution. War and death have always been partners in a dance that leads to passion and love in the strangest of ways.",shape=box,color=blue];
		j2431361423 -> j3628502303;
	j1976399736 [label="And now I am deeply nervous... Dare I ask why?",shape=box,color=blue];
		j1976399736 -> j1846815434;
		j1976399736 -> j3048096267;
	j2465489151 [label="What lurks beneath this surface of fracturing glass is...",shape=box,color=blue];
		j2465489151 -> j3999750866;
		j2465489151 -> j3541159129;
	j2148296869 [label="Indeed. I suppose I should not resent any positives that should come from the darkness and destructions of war.",shape=box,color=blue];
		j2148296869 -> j2436118094;
		j2148296869 -> j2333015591;
	j881896397 [label="It is not a tale I enjoy telling. To anyone. So you will forgive me if I am not overeager to share it. Perhaps another time.",shape=box,color=blue];
		j881896397 -> j2145969819;
		j881896397 -> j684681808;
	j1534244641 [label="Please continue.",shape=box,color=blue];
		j1534244641 -> j1846815434;
		j1534244641 -> j3048096267;
	j933019653 [label="With all do respect, I do not know you. And with all the rest that I have heaped upon me, a romantic endeavor with a stranger is hardly my first priority.",shape=box,color=blue];
		j933019653 -> j2729356264;
	j1846815434 [label="I - we'll try this again another time, I'm sorry. ",shape=box,color=red];
		j1846815434 -> j535564962;
	j3048096267 [label="I'm not sure if it's easy for you to wrap your head around, or if this sounds insane to you, but - for me, I... can feel this strongly for more than one person at the same time.",shape=box,color=red];
		j3048096267 -> j3669069499;
	j3999750866 [label="It's all right, Lyon. We'll get there. I'm in no rush, believe me.",shape=box,color=red];
		j3999750866 -> j1799933741;
	j3541159129 [label="Is what?",shape=box,color=red];
		j3541159129 -> j141097739;
	j2436118094 [label="What do you mean?",shape=box,color=red];
		j2436118094 -> j1014980219;
	j2333015591 [label="You resent it?",shape=box,color=red];
		j2333015591 -> j530731333;
	j2145969819 [label="I'll be here.",shape=box,color=red];
		j2145969819 -> j762149407;
	j684681808 [label="Of course. Whenever you're ready, Lyon.",shape=box,color=red];
		j684681808 -> j1315131922;
	j2729356264 [label="I am certain there are others who would find respite in the eager arms of another in instances such as this, but I am not one of those lucky souls.",shape=box,color=blue];
		j2729356264 -> j3570341211;
	j535564962 [label="+20 Chemistry",color=orange];
		j535564962 -> j3087041031;
	j3669069499 [label="I have feelings for you. But I also have feelings for them. And for me, both are true.",shape=box,color=red];
		j3669069499 -> j2563163368;
	j1799933741 [label="+20 Chemistry",color=orange];
		j1799933741 -> j3347995413;
	j141097739 [label="+10 Chemistry",color=orange];
		j141097739 -> j2477754117;
	j1014980219 [label="Forgive me. It is not a tale I enjoy telling. To anyone. So you will forgive me if I am not overeager to share it. Perhaps another time.",shape=box,color=blue];
		j1014980219 -> j2145969819;
		j1014980219 -> j684681808;
	j530731333 [label="Not the existence of love - perhaps the absence of it in my own family life. Forgive me. It is not a tale I enjoy telling. To anyone. So you will forgive me if I am not overeager to share it. Perhaps another time.",shape=box,color=blue];
		j530731333 -> j2145969819;
		j530731333 -> j684681808;
	j762149407 [label="+15 Chemistry",color=orange];
		j762149407 -> j3690730491;
	j1315131922 [label="+20 Chemistry",color=orange];
		j1315131922 -> j2612467036;
	j3570341211 [label="Kindly seek out one of them, perhaps, instead. Good day.",shape=box,color=blue];
		j3570341211 -> j944546954;
	j3087041031 [label="Very well. We may speak of this another time, if you so choose. Until then, I shall return to my duties for the day.",shape=box,color=blue];
		j3087041031 -> j944546954;
	j2563163368 [label="Such a concept is not as foreign to my heart as you might think it. Indeed it is not the notion of it that gives me pause as it is the parties involved - no offence.",shape=box,color=blue];
		j2563163368 -> j1071299440;
	j3347995413 [label="Boolean LyonVisions3 is now true.",color=orange];
		j3347995413 -> j1206054403;
	j2477754117 [label="It is too much for most to endure. And I thank you for continuing to attempt to do so. That is all.",shape=box,color=blue];
		j2477754117 -> j944546954;
	j3690730491 [label="I am coming to that inevitable conclusion, yes. Good day.",shape=box,color=blue];
		j3690730491 -> j944546954;
	j2612467036 [label="Thank you. Until we speak again, I wish you good day.",shape=box,color=blue];
		j2612467036 -> j944546954;
	j944546954 [label="-F. Lyon Allard",shape=box,color=blue];
		j944546954 -> "Chat ends.";
	j1071299440 [label="And perhaps how close to our new \"home\" your arrow seeks to fly.",shape=box,color=blue];
		j1071299440 -> j3462245676;
		j1071299440 -> j3256823662;
	j1206054403 [label="Thank you...",shape=box,color=blue];
		j1206054403 -> j944546954;
	j3462245676 [label="I wasn't saying \"now,\" to be fair. Just explaining myself.",shape=box,color=red];
		j3462245676 -> j2249866455;
	j3256823662 [label="So... what you're saying is... there's a chance?",shape=box,color=red];
		j3256823662 -> j756418322;
	j2249866455 [label="+20 Chemistry",color=orange];
		j2249866455 -> j1077960197;
	j756418322 [label="+20 Chemistry",color=orange];
		j756418322 -> j1701146877;
	j1077960197 [label="Yes, well... If I have decided I do not loathe you by the time we reach that point, perhaps we will reopen this discussion then.",shape=box,color=blue];
		j1077960197 -> j3534328857;
	j1701146877 [label="Yes... perhaps. If I have decided I do not loathe you by the time we reach that point. And that truly remains to be seen, Drifter.",shape=box,color=blue];
		j1701146877 -> j3534328857;
	j3534328857 [label="Until then, I must resume my duties for the day. I appreciate this... interesting conversation. I think.",shape=box,color=blue];
		j3534328857 -> j3153492002;
