	j1867130223 [label="บันทึก: ความโหดร้ายและการทำเกินขอบเขตเคยเป็นประโยชน์กับเราอย่างยิ่งในอดีต ข้าถูกคาดหวังให้นำสิ่งนี้มาใช้เป็นกลยุทธ์ในสงคราม",shape=box,color=blue];
