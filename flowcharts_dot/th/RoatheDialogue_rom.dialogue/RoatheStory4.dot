		j3942748906 -> j2062535712;
	j2062535712 [label="หลังจากที่พวก Sentient โจมตีครั้งแรก เราได้เตรียมโต้กลับเพื่อลงโทษ",shape=box,color=blue];
		j2062535712 -> j3075115117;
	j3075115117 [label="แม่มดกิลเดอร์กลาสทะยานขึ้นจากหมอกซีรีสด้วยปีกอันทรงพลัง เรือแกลเลียนบรรทุกโดรนและ Myrmidon หุ้มเกราะสีเงินไว้มากมาย",shape=box,color=blue];
		j3075115117 -> j2983007872;
	j2983007872 [label="มีวงจรไฟฟ้างดงามราวกับหมอกก่อตัวเป็นลูกไม้อันประณีตใต้แผ่นโลหะโปร่งแสง ",shape=box,color=blue];
		j2983007872 -> j831882370;
	j831882370 [label="กว้างใหญ่ไพศาลจนแทบจะข้ามขอบของโซลาร์เรลไปด้วยซ้ำ",shape=box,color=blue];
		j831882370 -> j3375901702;
	j3375901702 [label="เหล่า Sentient ต้องการให้เราเห็นผลที่จะเกิดขึ้น พวกมันร้องเพลง และทำให้เทคโนโลยีของเราล้มเหลว นักรบของเราดิ้นพล่านและหายใจไม่ออกภายในชุดเกราะที่เปล่งประกาย",shape=box,color=blue];
		j3375901702 -> j3369539894;
	j3369539894 [label="สมุนของแม่มดกิลเดอร์กลาสถูกเผาจนตายขณะที่นางพุ่งทะยานขึ้นสู่ท้องฟ้าของ Tau โดยไม่มีเครื่องยนต์ ราวกับดอกไม้ไฟที่จุดซ้อนกันและมีราคาแพงที่ต้องจ่าย",shape=box,color=blue];
		j3369539894 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
