		j1936271446 -> j3745338377;
	j3745338377 [label="เพื่อนสมัยเด็กที่บัดนี้รับหน้าที่ดูแลกองทัพของ Dax ของ Grineer เซลล์สสารที่ไม่สำคัญ เซลล์มะเร็งที่จำลองตัวเองได้ แมงมุมดาบไบโอโดรนยุคดึกดำบรรพ์ และถังบรรจุทหารเทคโนโลยีต่ำ",shape=box,color=blue];
		j3745338377 -> j3922816317;
	j3922816317 [label="เด็กชายหญิงร่างทองคำอร่ามพร้อมปีศาจร้ายที่พร้อมจะตามล่า",shape=box,color=blue];
		j3922816317 -> j2637454760;
	j2637454760 [label="ความเย่อหยิ่งของพวกมันหลั่งไหลเข้ามาในใจข้าราวกับเหงื่อที่แสบร้อน พวกมันดื่มและพากันร้องเพลง อวดอ้างถึงอนาคตที่กำลังจะมาถึง",shape=box,color=blue];
		j2637454760 -> j1005730826;
	j1005730826 [label="บอกว่าจะสร้างชื่อเสียงให้ตนเอง เลี้ยงดูครอบครัวให้สูงส่งด้วยเกียรติ",shape=box,color=blue];
		j1005730826 -> j577682216;
	j577682216 [label="แต่พวกมันมากมายต่างก็ต้องล้มตาย แม้แต่ร่างกายก็ยังไม่ได้คืน",shape=box,color=blue];
		j577682216 -> j1197453335;
	j1197453335 [label="เพื่อป้องกันไม่ให้ศัตรูล่วงรู้ความลับของเรา พวกมันโดนคูวาเขย่าจนกลายเป็นของเหลวเมื่อตายลง",shape=box,color=blue];
