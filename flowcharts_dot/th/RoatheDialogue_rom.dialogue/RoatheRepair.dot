		j144021955 -> j1237362900;
	j3189162783 [label="นั่นคือเหตุผลที่เจ้าชวนให้พวกนั้นมารบกวนข้าทั้งวันทั้งคืนใช่ไหม เพื่อเรื่องนั้นเหรอ? นี่เป็นความพยายามครั้งสุดท้ายที่จะทำให้ข้าฟังข้อโต้แย้งที่น่าสมเพชใช่ไหม?",shape=box,color=blue];
