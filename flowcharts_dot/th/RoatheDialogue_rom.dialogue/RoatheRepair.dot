digraph {
	5182 [label="RoatheRepair begins.",color=orange];
		5182 -> 5183;
	5183 [label="Evaluate expressions",color=orange];
		5183 -> 5185 [label="LyonRoatheFailFix, MarieRoatheFailFix",color=purple];
		5183 -> 5184 [label="false",color=purple];
	5185 [label="Enough! Enough. I relent! Call off your attack zealots. They are worse than rabid kubrodons! Blasted creatures follow me everywhere I go. I cannot even get any sleep!",shape=box,color=blue];
		5185 -> 5186;
	5184 [label="Chat ends.",color=orange];
	5186 [label="What?! What is it you want?!",shape=box,color=blue];
		5186 -> 5188;
		5186 -> 5187;
		5186 -> 5189;
	5188 [label="Another chance to talk to you about your taking the serum. Roathe, it's time to stop running. ",shape=box,color=red];
		5188 -> 5191;
	5187 [label="Roathe. Taking the serum doesn't make you a coward. It makes you the only Orokin still standing. Embrace it.",shape=box,color=red];
		5187 -> 5190;
	5189 [label="Roathe. Taking the serum doesn't make you a coward. It's given you another chance at live. To make a real difference.",shape=box,color=red];
		5189 -> 5192;
	5191 [label="Evaluate expressions on Thermostat",color=orange];
		5191 -> 5195 [label="x >= 5",color=purple];
		5191 -> 5194 [label="x <= 0",color=purple];
		5191 -> 5193 [label="x > 0 && x < 5",color=purple];
		5191 -> 5193 [label="false",color=purple];
	5190 [label="Add -5 to Thermostat",color=orange];
		5190 -> 5191;
	5192 [label="Add 5 to Thermostat",color=orange];
		5192 -> 5191;
	5195 [label="You're letting that anger tear you up inside. You could be using it to help you fight the people who are still destroying this world today. Here. Now.",shape=box,color=red];
		5195 -> 5198;
	5194 [label="You're pointing it at yourself. You should be pointing it at the world that is blaming you for doing the best you could to save it from the Orokin Empire.",shape=box,color=red];
		5194 -> 5197;
	5193 [label="That is why you convinced them to bother me day and night? For that? One last ditch effort to convince me to listen to your pathetic argument?",shape=box,color=blue];
		5193 -> 5196;
	5198 [label="You are not defined by your past, Roathe. You are defined by your future. And you still have a future to spend, unlike all the Orokin who died at the Night of the Naga Drums.",shape=box,color=red];
		5198 -> 5201;
	5197 [label="You are not defined by the opinions of those around you. Or what they think of your actions. You are defined only by what you believe of yourself and your choices.",shape=box,color=red];
		5197 -> 5200;
	5196 [label="No.",shape=box,color=blue];
		5196 -> 5199;
	5201 [label="That is the only thing that defines you, now. You can change. And you can change the world around you. I guess my only question is, will you at least try?",shape=box,color=red];
		5201 -> 5204;
	5200 [label="And the simple fact of the matter is? You are one of the very few Orokin we know that survived the Night of the Naga drums. From my point of view? It was a strategic retreat.",shape=box,color=red];
		5200 -> 5203;
	5199 [label="Your failure is pathetic. Not once over but twice, now.",shape=box,color=blue];
		5199 -> 5202;
	5204 [label="Try to forgive yourself and move forward?",shape=box,color=red];
		5204 -> 5207;
	5203 [label="Nothing more. Nothing less.",shape=box,color=red];
		5203 -> 5206;
	5202 [label="I do not recommend running for public office.",shape=box,color=blue];
		5202 -> 5205;
	5207 [label="Update boolean RoatheRedeemed",color=orange];
		5207 -> 5209;
	5206 [label="Update boolean RoatheVillain",color=orange];
		5206 -> 5208;
	5205 [label="Chat ends.",color=orange];
	5209 [label="+20 Chemistry",color=orange];
		5209 -> 5211;
	5208 [label="+20 Chemistry",color=orange];
		5208 -> 5210;
	5211 [label="Forgive myself for what I have done? And move forward into the future? Hm.",shape=box,color=blue];
		5211 -> 5213;
	5210 [label="A retreat to win the war. Hm. ",shape=box,color=blue];
		5210 -> 5212;
	5213 [label="While I am slightly dubious of your reframing of the situation, I am... too tempted by this new future an what it might mean for me to resist it, Drifter dear.",shape=box,color=blue];
		5213 -> 5215;
	5212 [label="While I am... slightly dubious of your reframing of your events as a tactical retreat, I admit I am... in favor of it, all the same, Drifter dear.",shape=box,color=blue];
		5212 -> 5214;
	5215 [label="This \"new lease\" on my life. Very well. I concede and accept your argument. Late as it may be, it has... been effective, all the same.",shape=box,color=blue];
		5215 -> 5216;
	5214 [label="Very well. I concede and accept your argument. Late as it may be, it has... been effective, all the same.",shape=box,color=blue];
		5214 -> 5216;
	5216 [label="I appreciate it. More than you might know.",shape=box,color=blue];
		5216 -> 5217;
	5217 [label="Update boolean RoatheFail",color=orange];
		5217 -> 5218;
	5218 [label="Update boolean RoatheFamilyFail",color=orange];
		5218 -> 5793;
	5793 [label="Update boolean RoatheFailStall",color=orange];
		5793 -> 5795;
	5795 [label="Check boolean LoidFamilyComplete",color=orange];
		5795 -> 5796 [label=true,color=green];
		5795 -> 5794 [label=false,color=brown];
	5796 [label="Chat ends.",color=orange];
	5794 [label="ตอนนี้ ข้าเชื่อว่าเราคงก้าวไปสู่การต่อสู้ครั้งต่อไปในสงครามแล้วใช่ไหม พ่อบ้าน",shape=box,color=blue];
		5794 -> 5797;
	5797 [label="ข้าแทบรอไม่ไหวแล้ว",shape=box,color=blue];
		5797 -> 5798;
	5798 [label="Update boolean RoatheFamilyDelay",color=orange];
		5798 -> 1702;
	1702 [label="Chat ends.",color=orange];
}