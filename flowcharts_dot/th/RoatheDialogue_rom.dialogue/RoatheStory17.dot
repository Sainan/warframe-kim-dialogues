		j3221776206 -> j3039314391;
	j3039314391 [label="แต่สิ่งที่เหนือความคาดหมาย คือ พวกมันกลับเอาชนะได้ จากนั้นไม่นาน เรื่องราวความกล้าหาญที่ไม่น่าเชื่ออย่างน่าเหลือเชื่อก็ถูกถ่ายทอดออกมาจากแนวหน้า",shape=box,color=blue];
		j3039314391 -> j287687826;
	j287687826 [label="Warframe ปรากฏตัวขึ้นจากฟากฟ้า ราวกับเทวดา เพื่อปลดปล่อยเชลยศึก และทำลายล้างป้อมปราการของ Sentient แม้อยู่เพียงลำพังก็ยังสร้างปาฏิหาริย์ แต่เมื่ออยู่รวมกันเป็นกลุ่ม มันเหมือนเป็นเทพเจ้าเลย",shape=box,color=blue];
