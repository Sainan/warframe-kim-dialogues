		j3799321104 -> j68046349;
	j68046349 [label="สงครามที่เกิดขึ้นแทบไม่มีทางเอาชนะ ส่วนพวก Sentient ก็ดูแล้วจะไม่มีทางปราบได้เลย ดังนั้น เราจึงสร้างนักรบประหลาดและเหนือจริงขึ้นมา พร้อมติดอาวุธโบราณให้มัน",shape=box,color=blue];
