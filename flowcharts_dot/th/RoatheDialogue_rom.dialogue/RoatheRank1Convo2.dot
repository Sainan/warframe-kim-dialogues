	155 [label="ในวอยด์ไม่มีสิ่งใดทั้งนั้น มันถึงได้ถูกเรียกว่าความว่างเปล่าอย่างไรล่ะ ",shape=box,color=blue];
		155 -> 160;
		155 -> 161;
	151 [label="ข้าจะถือเสียว่าเจ้าไม่ใช่พวกคลั่งศรัทธาน้ำลายฟูมปากที่เอาแต่ยึดติดกับความโกรธ ความสยดสยอง หรือความวิตกกังวล และเมื่อยึดสมมติฐานนี้ไว้ ข้าก็จะขอเดินหน้าต่อไปยังเหตุผลข้อที่สอง ที่ข้าประสงค์จะยกขึ้นมาเพื่อลอกคราบสถานะความเป็นพระเจ้าของสิ่งที่พวกเจ้าเรียกว่า “ความเฉยเมย\":",shape=box,color=blue];
