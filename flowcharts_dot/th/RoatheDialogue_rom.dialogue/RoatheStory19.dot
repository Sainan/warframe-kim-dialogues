		j2302914471 -> j3650310231;
	j3650310231 [label="บันทึก: ในบรรดาผู้บริหารทั้งเจ็ด Ballas วางตนเป็นอันดับหนึ่งเหนือคนอื่น ๆ ",shape=box,color=blue];
		j3650310231 -> j3920945292;
	j3920945292 [label="เขาเป็นนักการทูตและนักเกลี้ยกล่อมเสียงหวาน ที่มักจะแก้ไขความคับข้องใจและความขัดแย้งของคนอื่น ๆ ได้เสมอ",shape=box,color=blue];
		j3920945292 -> j3302632444;
	j3302632444 [label="ข้ายินดีอย่างที่สุดที่พบว่าบัดนี้เขากลายเป็นกุหลาบที่ติดอยู่ท่ามกลางพุ่มหนามสองพุ่ม ",shape=box,color=blue];
		j3302632444 -> j12903153;
	j12903153 [label="ข้างหนึ่งคือ ฝ่ายผู้กระหายสงครามที่นำโดย Nitokh อีกข้างคือ ฝ่ายสันตินิยมภายใต้การนำของ Scarne",shape=box,color=blue];
		j12903153 -> j3180559033;
	j3180559033 [label="ซึ่ง Ballas จำเป็นต้องตัดสินใจและอาจสร้างความเกลียดชังอย่างรุนแรงจากฝ่ายใดก็ตามที่เขาไม่ได้เข้าข้าง",shape=box,color=blue];
		j3180559033 -> j1106493731;
	j1106493731 [label="และเพราะเหตุผลที่ไม่อาจคาดเดาได้ เขาได้เลือกสันติภาพ ด้วยเสียงสี่ต่อสาม ดังนั้น Sentient ผู้หิวโหยจึงกลายเป็นพันธมิตรและมิตรสหายในทันที",shape=box,color=blue];
		j1106493731 -> j1978538237;
	j1978538237 [label="\"ไม่ทางใดก็ทางหนึ่ง เขาจะกลับคืนมา\" Nitokh ให้สัญญา ขณะที่ข้าถูกส่งไปตามหาผู้ไม่พอใจในหมู่ทหาร Dax ที่ออกไปรักษาการณ์",shape=box,color=blue];
		j1978538237 -> j921430358;
