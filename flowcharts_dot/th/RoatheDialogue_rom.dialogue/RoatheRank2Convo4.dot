		1145 -> 1153;
	1146 [label="มนุษยชาตินั้นแท้จริงแล้วไม่มีอะไรเลย ถ้าไม่พูดถึงความคิดสร้างสรรค์ในการคิดค้นรูปแบบความทรมานใหม่ ๆ มายัดเยียดให้ตัวเองแล้ว จริงไหมล่ะ ตัวเจ้าเองก็เคยเห็นความโหดร้ายในรูปแบบต่าง ๆ มากมาย ซึ่งข้ามั่นใจว่าไม่มีใครแทบจะจินตนาการได้เลยว่าเป็นไปได้ในยุคของพวกผู้คลั่งศรัทธาอันเป็นที่รักของเรา",shape=box,color=blue];
		1146 -> 1154;
	1147 [label="อ้อ พอเข้าใกล้ความจริงมาก ๆ เข้า ก็รีบปัดมันทิ้งอย่างไว เจ้าคงคิดว่ามัน “น่าดึงดูด” กว่าถ้าจะเชื่อว่ามันเป็นแค่สิ่งที่จิตปรุงแต่งขึ้นมาเอง เพราะถ้าเป็นแบบนั้นจริง ๆ ก็จะปฏิเสธได้ง่ายกว่าใช่ไหม แต่เปล่าเลย ข้ากลับเห็นว่าการต้องเผชิญหน้ากับสิ่งที่เราสร้างขึ้นเองนั้น อันตรายยิ่งกว่าการเผชิญหน้ากับเทพเจ้าเสียอีก",shape=box,color=blue];
		1147 -> 1155;
