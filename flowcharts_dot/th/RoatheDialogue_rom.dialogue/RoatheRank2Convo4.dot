		1142 -> 1150;
	5772 [label="เยี่ยมยอดไปเลย ข้าก็ดีใจอยู่เหมือนกันนะ ที่ตัวตนในอดีตของข้าช่างพูดจาน่าเชื่อถือได้ถึงเพียงนั้น และข้าก็ได้แต่หวังว่าเจ้าจะพูดกับข้าอย่างตรงไปตรงมา ไม่ใช่โกหกเพื่อจะให้ข้า “หุบปาก” เงียบไปเท่านั้น แต่ถึงอย่างไรเสีย… ข้าก็ไม่มีทางเลือกอื่น นอกจากต้องเชื่อเจ้า",shape=box,color=blue];
		5772 -> 5773;
	1143 [label="เพียงแต่ตอนนี้ เพราะอิทธิพลของวอยด์ พวกเจ้าดันป้อนความกลัวกับพลังให้มันมากเกินไป จนมันจับตัวรวมกันราวกับวงจรป้อนกลับ แล้วก็กลายเป็น… ไอ้สิ่งนี้ไงเล่า ไอ้ชายผู้อยู่ในกำแพงนี่",shape=box,color=blue];
