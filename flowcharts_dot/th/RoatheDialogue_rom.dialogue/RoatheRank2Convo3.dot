		1086 -> 1088;
	1087 [label="นั่นนับเป็นการตื่นรู้ครั้งใหญ่ในชีวิตก็ว่าได้ ข้าปีนขึ้นไปยืนบนเสาหินข้างรูปปั้นการ์กอยล์ที่ดูน่าเกลียดน่ากลัว แล้วก็กางแขนออกสุดแขน จากนั้น... ก็หัวเราะออกมา หัวเราะเยาะพายุที่โหมกระหน่ำนั้น",shape=box,color=blue];
		1087 -> 1089;
	1088 [label="เพราะทันใดนั้นข้าก็รู้แล้วว่าข้าไม่ได้กลัวสิ่งที่จะเกิดขึ้นหลังความตาย ดริฟเตอร์ ข้าแค่ยังไม่อยากให้ชีวิตของข้าจบลง ข้ายังอยากใช้ชีวิตต่อ",shape=box,color=blue];
		1088 -> 1089;
	1089 [label="ทั้ง ๆ ที่มีเรื่องมากมาย ทั้ง ๆ ที่ Tau ถูกทิ้งร้าง ทั้งที่ข้ารู้ว่าจักรวรรดิ Orokin จะต้องล่มสลายอย่างหลีกเลี่ยงไม่ได้แล้ว ทั้งที่ร่างกายข้าถูกบิดเบือนให้กลายเป็น... สภาพที่ย่ำแย่นี้ ทั้งที่ข้าถูกส่งไปอดีตแล้วถูกละทิ้งให้ดิ้นรนเอาตัวรอดเอง",shape=box,color=blue];
		1089 -> 1090;
