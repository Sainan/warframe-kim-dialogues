		1076 -> 1080;
	1077 [label="มันเป็นเช่นนั้นจริง ๆ! ข้าบรรยายไม่ถูกเลยว่าการได้สัมผัสพลังดิบเช่นนั้นมันเป็นเช่นไร ไม่สิ มันมากกว่านั้น มันคือพลังที่แท้จริงเลย ตอนที่ข้าเงยหน้ามองเมฆดำหมุนวนเหนือหัว พร้อมสายฟ้าที่ฟาดลงมาอย่างดุเดือด ข้าเห็นเลยว่านั่นแหละคือสิ่งที่บรรพชนของข้าพยายามจะควบคุมมาโดยตลอด",shape=box,color=blue];
		1077 -> 1076;
	1078 [label="แต่การได้สัมผัสพลังดิบแบบนั้นน่ะเหรอ? ไม่สิ มันมากกว่านั้น มันคือพลังที่แท้จริงเลย ตอนที่ข้าเงยหน้ามองเมฆดำหมุนวนเหนือหัว พร้อมสายฟ้าที่ฟาดลงมาอย่างดุเดือด ข้าเห็นเลยว่านั่นแหละคือสิ่งที่บรรพชนของข้าพยายามจะควบคุมมาโดยตลอด",shape=box,color=blue];
