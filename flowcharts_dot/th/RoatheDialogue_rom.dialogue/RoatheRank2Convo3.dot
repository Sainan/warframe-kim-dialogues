digraph {
	1042 [label="RoatheRank2Convo3 begins.",color=orange];
		1042 -> 1043;
	1043 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1043 -> 1044 [label=true,color=green];
		1043 -> 1045 [label=false,color=brown];
	1044 [label="Check boolean RoatheKnowsReset2",color=orange];
		1044 -> 1046 [label=true,color=green];
		1044 -> 1047 [label=false,color=brown];
	1045 [label="Chat ends.",color=orange];
	1046 [label="I know you've likely heard this before, and I find today I do not care - I do not have the patience.",shape=box,color=blue];
		1046 -> 1047;
	1047 [label="I think what caused the fall of the Orokin Empire was too many layers of glass.",shape=box,color=blue];
		1047 -> 1048;
		1047 -> 1049;
		1047 -> 1050;
	1048 [label="How so?",shape=box,color=red];
		1048 -> 1051;
	1049 [label="Too impersonal?",shape=box,color=red];
		1049 -> 1052;
	1050 [label="[จบ]",shape=box,color=red];
		1050 -> 1053;
	1051 [label="Imagine a society built upon the knowledge that you are, for all intents and purposes, forever safe. Protected. Even from the great spectre of death.",shape=box,color=blue];
		1051 -> 1054;
	1052 [label="+5 Chemistry",color=orange];
		1052 -> 1055;
	1053 [label="Chat ends.",color=orange];
	1054 [label="Where nothing can harm you.",shape=box,color=blue];
		1054 -> 1056;
	1055 [label="Precisely. Too removed from the danger and reality of the thing.",shape=box,color=blue];
		1055 -> 1051;
	1056 [label="It leads to a kind of tedium that begins to invent its own danger, Usurper. Politics. Court intrigue. Suddenly we were concocting masterful new ways to endanger ourselves, since we had replaced the old.",shape=box,color=blue];
		1056 -> 1057;
		1056 -> 1058;
	1057 [label="What brings this up?",shape=box,color=red];
		1057 -> 1059;
	1058 [label="Which is worse? Being shot at, or having to watch your back?",shape=box,color=red];
		1058 -> 1060;
	1059 [label="There were precious few interesting or pleasant parts about my... forced sojourn to \"Gaule.\" The food being one of them. The second, however... were the storms.",shape=box,color=blue];
		1059 -> 1061;
	1060 [label="Ha! I am not certain I have a preference, being fully schooled in the art of both, I'm afraid. Which do you?",shape=box,color=blue];
		1060 -> 1062;
		1060 -> 1063;
	1061 [label="Thunderstorms the likes of which I had never witnessed in all my years as an Orokin. They shook the very earth, rattled the windows in their wooden panes. I could hear them even down in the dusty crypt where they kept us.",shape=box,color=blue];
		1061 -> 1064;
	1062 [label="I like to know who my enemies are, clean and simple. Let them come at me guns blazing.",shape=box,color=red];
		1062 -> 1065;
	1063 [label="Being shot at. I prefer being able to pull strings to get the job done. I can take my time.",shape=box,color=red];
		1063 -> 1066;
	1064 [label="When they would roll through the city, I would climb up into the bell tower to get as close as I possibly could. I wished to feel the electricity in the air - the  pelting rain on my skin.",shape=box,color=blue];
		1064 -> 1067;
		1064 -> 1068;
		1064 -> 1069;
	1065 [label="Add 1 to Thermostat",color=orange];
		1065 -> 1070;
	1066 [label="Add -1 to Thermostat",color=orange];
		1066 -> 1071;
	1067 [label="Wasn't that a bit dangerous?",shape=box,color=red];
		1067 -> 1072;
	1068 [label="That sounds amazing.",shape=box,color=red];
		1068 -> 1073;
	1069 [label="How did Marie and Lyon feel about you sneaking off?",shape=box,color=red];
		1069 -> 1074;
	1070 [label="I see your point, and I have to agree there is a certain simplicity to be enjoyed in that. Hard to mistake an enemy for anything else when they have a gun pointed at your face.",shape=box,color=blue];
		1070 -> 1075;
	1071 [label="Mm, delicious, isn't it? A careful plan, artfully laid out, coming to fruition? Watching all the pieces fall into place... it is very much fun.",shape=box,color=blue];
		1071 -> 1075;
	1072 [label="Which was precisely the point of the endeavor! I cannot describe what it was like to feel such raw power. No, it was more than that; it was real power. I gazed up into those swirling, darkened clouds flashing with furious bolts of lightning and I saw what my ancestors had so desperately sought to harness.",shape=box,color=blue];
		1072 -> 1076;
	1073 [label="+5 Chemistry",color=orange];
		1073 -> 1077;
	1074 [label="You write those words as though I spared it even the briefest of thoughts. They did not follow me, if that is what you are asking. The Priest little cared if I killed myself by bolt of lightning, I am sure. As for Marie? She was likely too busy worshipping her false idols. Sol or Albrecht, take your pick.",shape=box,color=blue];
		1074 -> 1078;
	1075 [label="+5 Chemistry",color=orange];
		1075 -> 1079;
	1076 [label="Moreover, I knew my presence there could also kill me, and that there would be no Kuva nearby to revive me. Further still, that the sacred Kuva would not work on my warped and twisted form. ",shape=box,color=blue];
		1076 -> 1080;
	1077 [label="It was! I cannot describe what it was like to feel such raw power. No, it was more than that; it was real power. I gazed up into those swirling, darkened clouds flashing with furious bolts of lightning and I saw what my ancestors had so desperately sought to harness.",shape=box,color=blue];
		1077 -> 1076;
	1078 [label="But to feel such raw power? No, it was more than that; it was real power. I gazed up into those swirling, darkened clouds flashing with furious bolts of lightning and I saw what my ancestors had so desperately sought to harness.",shape=box,color=blue];
		1078 -> 1076;
	1079 [label="I find, however, like all things in life, moderation and a mix of both is where the answer to success lies. To become to glutted on one risks abandoning the other.",shape=box,color=blue];
		1079 -> 1081;
	1080 [label="It terrified me. I felt fear, Drifter. Fear. For the first time in... centuries, perhaps?",shape=box,color=blue];
		1080 -> 1082;
		1080 -> 1083;
	1081 [label="That is how we create creatures such as Ballas and Nitokh I am afraid. The Manipulator and the Blood Queen. Bah.",shape=box,color=blue];
		1081 -> 1084;
	1082 [label="You're afraid to die?",shape=box,color=red];
		1082 -> 1085;
	1083 [label="What did you do?",shape=box,color=red];
		1083 -> 1086;
	1084 [label="But I came here to speak about storms.",shape=box,color=blue];
		1084 -> 1059;
	1085 [label="Yes, it seems so! Quite keenly, I might add. And this was a discovery to me in that moment. I do not fear what comes after death, Drifter. I simply do not yet wish for my life to end. I am not done living it.",shape=box,color=blue];
		1085 -> 1087;
	1086 [label="I climbed atop the stone baluster beside the gnarled gargoyle and held my arms out wide at my sides, and... I laughed. I laughed into the storm.",shape=box,color=blue];
		1086 -> 1088;
	1087 [label="Which was a revelation in and of itself. I climbed atop the stone baluster beside the gnarled gargoyle and held my arms out wide at my sides, and... I laughed. I laughed into the storm.",shape=box,color=blue];
		1087 -> 1089;
	1088 [label="For I suddenly knew that I do not fear what comes after death, Drifter. I simply do not yet wish for my life to end. I am not done living it.",shape=box,color=blue];
		1088 -> 1089;
	1089 [label="Despite it all. Despite the desolation of Tau. Despite the destruction of the Orokin Empire I knew was now inevitable. Despite the perversion of my body into... this mess. Despite being thrown into the past and abandoned to my own devices.",shape=box,color=blue];
		1089 -> 1090;
	1090 [label="I knew I would find a way back here. To this time. To this place. To where Albrecht had left all his most precious things.",shape=box,color=blue];
		1090 -> 1091;
	1091 [label="+5 Chemistry",color=orange];
		1091 -> 1092;
	1092 [label="Because I am not done living my life. But by the Void, I am going to ensure he is done living his.",shape=box,color=blue];
		1092 -> 1093;
	1093 [label="Update boolean RoatheEntrati1",color=orange];
		1093 -> 1094;
	1094 [label="Chat ends.",color=orange];
}