		1055 -> 1051;
	1056 [label="มันก็ก่อให้เกิดความเบื่อหน่ายรูปแบบหนึ่งที่ถึงขั้นต้องสร้างภัยใหม่ขึ้นมาเอง ผู้แย่งชิงเอ๋ย การเมืองเอย การวางแผนร้ายในศาลเอย และอยู่ดี ๆ เราก็เริ่มคิดค้นวิธีสุดพิสดารเพื่อทำให้ตัวเองตกอยู่ในอันตราย เพราะวิธีเดิม ๆ มันใช้ไม่ได้เสียแล้ว",shape=box,color=blue];
