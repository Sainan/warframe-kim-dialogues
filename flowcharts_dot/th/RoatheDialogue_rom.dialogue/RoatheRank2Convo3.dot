		1070 -> 1075;
	1071 [label="อืม มันช่างหอมหวานเหลือเกินว่าไหม แผนที่ถูกจัดวางไว้อย่างละเอียดและปราณีตกำลังจะสำเร็จผล การได้เฝ้าดูทุกอย่างเข้าที่เข้าทาง... มันสนุกจริง ๆ",shape=box,color=blue];
		1071 -> 1075;
	1072 [label="ซึ่งนั่นแหละคือเจตจำนงของการกระทำนั้นอย่างแท้จริง! ข้าบรรยายไม่ถูกเลยว่าการได้สัมผัสพลังดิบเช่นนั้นมันเป็นเช่นไร ไม่สิ มันมากกว่านั้น มันคือพลังที่แท้จริงเลย ตอนที่ข้าเงยหน้ามองเมฆดำหมุนวนเหนือหัว พร้อมสายฟ้าที่ฟาดลงมาอย่างดุเดือด ข้าเห็นเลยว่านั่นแหละคือสิ่งที่บรรพชนของข้าพยายามจะควบคุมมาโดยตลอด",shape=box,color=blue];
		1072 -> 1076;
	1073 [label="+5 Chemistry",color=orange];
