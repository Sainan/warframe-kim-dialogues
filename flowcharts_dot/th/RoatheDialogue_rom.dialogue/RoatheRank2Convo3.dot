		1084 -> 1059;
	1085 [label="ใช่ ดูท่าว่าจะเป็นเช่นนั้น แถมยังชัดเจนเสียด้วย ข้าต้องพูดอย่างนั้นเลย และนั่นเองคือสิ่งที่ข้าเพิ่งตระหนักได้ในตอนนั้น ข้าไม่ได้กลัวสิ่งที่จะเกิดขึ้นหลังความตาย ดริฟเตอร์ ข้าแค่ยังไม่ปรารถนาให้ชีวิตของข้าสิ้นสุดลง ข้ายังอยากใช้ชีวิตต่อ",shape=box,color=blue];
		1085 -> 1087;
