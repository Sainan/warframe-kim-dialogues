	j692212396 [label="บันทึก: คนขี้ขลาด",shape=box,color=blue];
		j692212396 -> j466819471;
	j466819471 [label="นั่นแหละที่พวกมันเรียกข้า ข้าได้อ่านหนังสือประวัติศาสตร์ที่กระจายอยู่ทั่วห้องโถงที่มีแต่ฝุ่นจับนั่นแล้ว มีแต่เรื่องโกหก พวกมันไม่รู้ความจริงหรอก ว่าข้าถูกพรากจากกาลเวลาไปก่อนที่จะทำงานสำเร็จ",shape=box,color=blue];
		j466819471 -> j694515681;
	j694515681 [label="เจ้าคนขี้ขลาด",shape=box,color=blue];
		j694515681 -> j2803702549;
	j2803702549 [label="ข้าจำได้แล้ว เขาเข้ามาหาข้า ในห้องโถงทองคำ สวมใบหน้าที่ข้าไม่รู้จัก แต่นั่นไม่ใช่เรื่องแปลกเลยสำหรับพวกเรา ข้ารู้จักน้ำเสียงนั่น และรู้วิธีที่เขาเคลื่อนไหว",shape=box,color=blue];
		j2803702549 -> j526591327;
	j526591327 [label="เจ้าคนขี้ขลาด!",shape=box,color=blue];
		j526591327 -> j595548134;
