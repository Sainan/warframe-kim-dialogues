	j2739310561 [label="บันทึก: ไม่มีอะไรจะบรรยายถึงความโอหังที่เราเหล่าสัตว์โลกปฏิบัติต่อการสังหารหมู่ในสงครามได้กระชับเท่ากับเหล่าผู้ถือธง",shape=box,color=blue];
		j2739310561 -> j2024169562;
