		j2024169562 -> j3417762366;
	j3417762366 [label="และขอเสริมว่า นั่นอาจเป็นผู้ที่ถูกข่มขู่ให้ปฏิบัติตามคำสั่งที่ไม่มีทหารสติดีคนใดจะทำตาม มิฉะนั้นจะต้องประสบชะตากรรมอันเลวร้ายยิ่งกว่านี้ ",shape=box,color=blue];
		j3417762366 -> j2507877739;
