		j2507877739 -> j1061437469;
	j1061437469 [label="แต่สายตาของข้ามักจับจ้องไปที่รูปร่างของพวกมัน แม้ว่าร่างกายที่บิดเบี้ยวนั่นจะไม่ต่างจากคนอื่น ๆ เลย ",shape=box,color=blue];
		j1061437469 -> j395866935;
