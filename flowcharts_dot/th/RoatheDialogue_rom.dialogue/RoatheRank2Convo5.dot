		j1171875064 -> j3385966730;
	j2249901827 [label="เคยพูดถึงผู้บริหาร Nitokh ให้ฟังก่อนแล้วนี่ รวมถึง… เรื่องที่ข้าเคยไปพัวพันกับนาง ต้องพยายามทำความเข้าใจก่อนนะว่า จักรวรรดิ Orokin ไม่ได้เลวทรามไปเสียทั้งหมด",shape=box,color=blue];
		j2249901827 -> j12841350;
