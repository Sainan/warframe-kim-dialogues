	j1676999758 [label="ข้อความเสียง: การเสียสละ",shape=box,color=blue];
		j1676999758 -> j4238652197;
	j4238652197 [label="บันทึก: Traivon ข้าเห็นเจ้าขว้าง Railjack ใส่ปากของ Praghasa ทำให้มันไขว้เขว กินเจ้าและคนของเจ้าอย่างตะกละตะกลาม มันไม่ทันสังเกตเห็นเรือของข้าที่แล่นออกไป",shape=box,color=blue];
		j4238652197 -> j3030144707;
	j3030144707 [label="เจ้าสละชีวิตเพื่อผู้บังคับบัญชา ข้ารู้สึกถึงความเสียสละของเจ้าราวกับถูกตบหน้า",shape=box,color=blue];
		j3030144707 -> j2905618955;
	j2905618955 [label="Maryna เจ้ามอบร่างกายให้ข้า เราดื่มคูวาด้วยกันในสนามเพลาะนั้น มือข้าสั่นและคอที่เป็นแผลยาวลึกทำให้มันไหลออกมา แต่ข้าก็เก็บคูวามากพอให้ดื่มได้",shape=box,color=blue];
		j2905618955 -> j111366179;
	j111366179 [label="ข้าจำที่เจ้าคำนับเป็นครั้งสุดท้ายได้ ก่อนที่จะเลือนหายไป จากนั้นข้าก็ลืมตาอยู่ในร่างที่เคยเป็นของเจ้า และเห็นซากศพของข้าถูกควักไส้ตายอยู่ในโคลน",shape=box,color=blue];
		j111366179 -> j1973886545;
	j1973886545 [label="Rostig มีคนบอกว่ามีบางอย่างผิดปกติในกระบวนการโคลนนิ่ง มีอะไรอีกที่ทำให้ Grineer ยืนอยู่ที่ป้อมปืนของตนในขณะที่ถูกเผาทั้งเป็นได้ แม้แต่หนูยังรู้จักการเอาตัวรอดเลย",shape=box,color=blue];
		j1973886545 -> j3653394558;
	j3653394558 [label="แต่ไม่หรอก \"ความบกพร่อง\" ของเจ้าทำให้เจ้าเหนือกว่าพวกมัน",shape=box,color=blue];
		j3653394558 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
