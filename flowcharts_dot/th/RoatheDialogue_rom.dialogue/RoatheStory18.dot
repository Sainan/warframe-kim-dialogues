	j1317810717 [label="บันทึก: “สันติภาพ?”",shape=box,color=blue];
		j1317810717 -> j609806704;
	j609806704 [label="เสียงที่ไม่พอใจของผู้บริหาร Nitokh ดังกึกก้องราวกับเศษแก้วแตกอยู่ในหูข้า",shape=box,color=blue];
		j609806704 -> j3985243314;
	j3985243314 [label="นางคาดหวังการยกระดับอันรุ่งโรจน์ การต่อสู้ครั้งแล้วครั้งเล่า และจบลงด้วยการล่มสลายของ Orokin ที่จะสร้างความสุขสำราญอย่างที่สุด",shape=box,color=blue];
		j3985243314 -> j1305813707;
	j1305813707 [label="หลังจากนั้นนางจะออกมาจากที่ซ่อน และ… ที่เหลือก็ได้แต่คาดเดา บางทีนางอาจคาดหวังว่าจะได้รับความไว้วางใจจาก Sentient",shape=box,color=blue];
		j1305813707 -> j351045352;
	j351045352 [label="หรือบางทีอาจคิดว่าพวกมันจะละทิ้งซากที่ไหม้เกรียมและแปดเปื้อนของระบบออริจิน และปล่อยให้นางสร้างอาณาจักรใหม่",shape=box,color=blue];
		j351045352 -> j351310968;
	j351310968 [label="ไม่ว่าอย่างไร สันติภาพไม่ใช่สิ่งที่อาจยอมรับได้ ดังนั้นเราจึงเริ่มทำลายมัน",shape=box,color=blue];
		j351310968 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
