	"Chat ends." [color=orange];
	j904108357 [label="You fool! What have you done?! Why, why go and delve into caverns where you are not welcome?!",shape=box,color=blue];
		j904108357 -> j4158844579;
	j4158844579 [label="I demand you fix this. This is your fault. I can feel it, clawing at me, tearing at me. Like some great beast.",shape=box,color=blue];
		j4158844579 -> j1963923291;
	j1963923291 [label="Rid me of this. Rid me of this plague. Clear my mind of these memories. I know you can. Use this gift that you have and end it all. Now.",shape=box,color=blue];
		j1963923291 -> j309475164;
		j1963923291 -> j4168892528;
		j1963923291 -> j3899057325;
	j309475164 [label="Are you sure? But... you're smart, I get the feeling you'll figure something is up.",shape=box,color=red];
		j309475164 -> j3919124641;
	j4168892528 [label="Those are a different kind of memory, Roathe. It won't work on them. They are buried deeper in your psyche.",shape=box,color=red];
		j4168892528 -> j2444040588;
	j3899057325 [label="Running and hiding from the truth won't work. We'll just wind up right back where we started. ",shape=box,color=red];
		j3899057325 -> j232093781;
	j3919124641 [label="Very likely. I will put two and two together and blame you for doing something I did not ask you to do. I am sure you will weather the storm.",shape=box,color=blue];
		j3919124641 -> j209895258;
	j2444040588 [label="That may be. You are very likely right. But I do not have any other options to try, now do I? It is worth the attempt.",shape=box,color=blue];
		j2444040588 -> j209895258;
	j232093781 [label="And if that is the case, then you can simply do the deed again. It is like you have an inexhaustible gift, isn't it?",shape=box,color=blue];
		j232093781 -> j209895258;
	j209895258 [label="I am certain I will be hideously angry at you once I realize you have altered my memories, of course. And I recommend not telling me it was by my request, darling.",shape=box,color=blue];
		j209895258 -> j3955635686;
	j3955635686 [label="I will simply claim you are lying, and it will likely damage my opinion of you beyond repair.",shape=box,color=blue];
		j3955635686 -> j2558182393;
		j3955635686 -> j1527171636;
	j2558182393 [label="No. I can't do this. I won't do this. We have to face down this situation together. Can't we just talk about this?",shape=box,color=red];
		j2558182393 -> j1861214590;
	j1527171636 [label="I... there's really no other way?",shape=box,color=red];
		j1527171636 -> j1861214590;
	j1861214590 [label="No. If you want the butler to go upstairs? You wipe my mind of all of this nonsense as I have asked. If you do not care? Then do as you wish. It matters not to me.",shape=box,color=blue];
		j1861214590 -> j1146256579;
	j1146256579 [label="That, and, well, of course, our personal friendship is the only leverage I own in this situation. It is that simple.",shape=box,color=blue];
		j1146256579 -> j2786721293;
	j2786721293 [label="What say you?",shape=box,color=blue];
		j2786721293 -> j172269280;
		j2786721293 -> j217903911;
	j172269280 [label="Okay. I'll... I'll do it. I'll wipe your mind. Even if it'll take Marie and Lyon's with it.",shape=box,color=red];
		j172269280 -> j2494914914;
	j217903911 [label="No. I refuse. I'll find another way to convince you to move forward.",shape=box,color=red];
		j217903911 -> j3664603753;
	j2494914914 [label="+10 Chemistry",color=orange];
		j2494914914 -> j543348969;
	j3664603753 [label="I wish you the best of luck.",shape=box,color=blue];
		j3664603753 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j543348969 [label="Good. Get to it. ",shape=box,color=blue];
		j543348969 -> j4072107213;
	"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
