		j835546464 -> j1645590908;
	j1645590908 [label="บันทึก: ระหว่างที่เผชิญหน้ากันพวก Sentient จำนวนมากมีวิวัฒนาการ ดังนั้นเราไม่มีทางแน่ใจได้เลยว่าจะได้เผชิญหน้ากับศัตรูเดิมซ้ำสองครั้ง แต่บางตัวก็ยังคงสภาพเดิม ราวกับว่าเคยไปถึงจุดสูงสุดเมื่อนานมาแล้ว",shape=box,color=blue];
		j1645590908 -> j454390186;
	j454390186 [label="เป็นนักฆ่าที่สมบูรณ์แบบ พวกมันเย็นชาอย่างน่ากลัวเช่นเดียวกับฉลาม",shape=box,color=blue];
		j454390186 -> j3871535768;
	j3871535768 [label="คือความบ้าคลั่ง ข้าจะวางกลยุทธ์รับมือกับพฤติกรรมของเรือ Sentient ได้อย่างไร ในเมื่อกลยุทธ์ที่ข้าวางไว้ไม่มีทางสมบูรณ์แบบไปกว่าเรือปูที่กลายเป็นเรือหนอน",shape=box,color=blue];
		j3871535768 -> j843885777;
	j843885777 [label="และอีกไม่นานเรือหนอนเหล่านั้นจะกลายเป็นสัตว์ประหลาดตัวใหม่",shape=box,color=blue];
		j843885777 -> j3021203049;
	j3021203049 [label="สิ่งที่เราทำได้คือถอยหลัง ความก้าวหน้าเป็นสิ่งเลวร้าย ส่วนประเพณีเก่าแก่ เส้นทางแห่งเกียรติยศและระเบียบวินัยที่ศักดิ์สิทธิ์ตามกาลเวลา ล้วนเป็นสิ่งที่ควรได้รับความเคารพ",shape=box,color=blue];
