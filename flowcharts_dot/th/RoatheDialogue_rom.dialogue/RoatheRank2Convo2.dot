		1036 -> 1038;
	1037 [label="ข้าไม่ได้พยายามจะเอาสองคนนี้มาเทียบกันสักหน่อย ผู้แย่งชิง ข้าแค่จะบอกว่า คนคนหนึ่งน่ะ อาจเป็นทั้งคนรักและในเวลาเดียวกันก็ยังสามารถทำเรื่องเลวร้ายเกินรับไหวได้ เอาเถอะ… ดูแล้วพวกโง่เขลาเสื่อมทรามอย่างเราคงไม่เหลือความหวังอะไรหรอก…",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="ก็จริง บางครั้งมันทำให้ข้ารู้สึกใจสงบขึ้นมานิดหน่อย เมื่อคิดว่าแม้แต่เจ้าแห่งความเสื่อมทรามนั่นยังหาคู่ของตัวเองเจอ แบบนั้นพวกเราที่เหลือก็คงยังมีความหวังอยู่บ้าง ใช่ไหม ฮ่า!",shape=box,color=blue];
