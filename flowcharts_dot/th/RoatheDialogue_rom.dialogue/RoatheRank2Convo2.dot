	958 [label="+10 Chemistry",color=orange];
		958 -> 968;
	959 [label="Either you are attempting to appeal to my ego, which I commend you for, or you are simply extremely uninspired with your day. Which, as someone who has also enjoyed countless cycles of life, I nearly sympathize with.",shape=box,color=blue];
		959 -> 969;
	960 [label="Fascinating. You are either lying, or I still have stones you have yet left unturned. Which may be the reason you are here once more rereading fields already ploughed.",shape=box,color=blue];
		960 -> 970;
	961 [label="Mm, little by little, you are nearly convincing me to forgive you for this mess you've made.",shape=box,color=blue];
		961 -> 971;
	965 [label="Long before the Zariman Ten Zero launched, and the Tenno were even a blip on the proverbial screen, Margulis the Archimedean and Ballas met during the opening of a new domed conservatory.",shape=box,color=blue];
		965 -> 975;
	973 [label="As far as I've been told - and she's not exactly entirely reliable, so take this with a grain of salt - the strains of Infestation for each of the batches of Protoframes can be influenced individually.",shape=box,color=red];
		973 -> 981;
	974 [label="I... see.",shape=box,color=blue];
		974 -> 982;
	972 [label="Chat ends.",color=orange];
	966 [label="As each one sort of lives inside its own \"continuity\" or time. All the Infestation strains are connected, but they sort of live in... nodules. It's all very complicated.",shape=box,color=red];
		966 -> 976;
	967 [label="The universe has certainly become stranger since I left it...",shape=box,color=blue];
		967 -> 977;
		967 -> 978;
	968 [label="Then I shall not tire you by recounting the saga yet again, and I shall leave you to find other amusements with the rest of your day.",shape=box,color=blue];
		968 -> 979;
	969 [label="Were I not the subject of your amusement.",shape=box,color=blue];
		969 -> 970;
	970 [label="But? Regardless... ",shape=box,color=blue];
		970 -> 980;
	971 [label="Update boolean RoatheResetForgiven",color=orange];
		971 -> 970;
	975 [label="Ballas was there for the sake of ceremony - we do love our pomp and circumstance, of course - and Margulis was desperately attempting not to be noticed.",shape=box,color=blue];
		975 -> 983;
	981 [label="As each one sort of lives inside its own \"continuity\" or time. All the Infestation strains are connected, but they sort of live in... nodules. It's all very complicated.",shape=box,color=red];
		981 -> 987;
	982 [label="The universe has certainly become stranger since I left it...",shape=box,color=blue];
		982 -> 988;
		982 -> 989;
	976 [label="So because I can loop time, I can loop Infestation \"Batches\" in a limited way.",shape=box,color=red];
		976 -> 984;
	977 [label="You have no idea.",shape=box,color=red];
		977 -> 985;
	978 [label="She rather takes the cake. Well... never mind.",shape=box,color=red];
		978 -> 985;
	979 [label="Update boolean RoatheMargulis1",color=orange];
		979 -> 986;
	980 [label="Ballas and Margulis.",shape=box,color=blue];
		980 -> 965;
	983 [label="Something you must understand, my Usurper, is that Ballas had no reason to associate with her. No reason at all, unless his infatuation were genuine.",shape=box,color=blue];
		983 -> 990;
	987 [label="So because I can loop time, I can loop Infestation \"Batches\" in a limited way.",shape=box,color=red];
		987 -> 993;
	988 [label="You have no idea.",shape=box,color=red];
		988 -> 994;
	989 [label="She rather takes the cake. Well... never mind.",shape=box,color=red];
		989 -> 994;
	984 [label="And \"she\" is?",shape=box,color=blue];
		984 -> 991;
		984 -> 992;
	985 [label="ข้าเองก็อยากสั่งสอนเจ้าที่ทำทุกอย่างเพื่อให้ได้ในสิ่งที่ตัวเองต้องการ แต่พอมานึกดูแล้วพวก Orokin ขึ้นชื่อว่าทำเรื่องเลวร้ายกว่านี้มาก แถมยังสรรหาวิธีที่เกินกว่าจินตนาการด้วยซ้ำ",shape=box,color=blue];
		985 -> 931;
	986 [label="Chat ends.",color=orange];
	990 [label="It was not just lust, for he could have whomever he wished - and did, quite often. If he wanted her, he could have simply had her and been done with her.",shape=box,color=blue];
		990 -> 995;
	993 [label="And \"she\" is?",shape=box,color=blue];
		993 -> 996;
		993 -> 997;
	994 [label="Regardless. All this, in the name of \"love?\"",shape=box,color=blue];
		994 -> 998;
	991 [label="Lizzie. She'd love you.",shape=box,color=red];
		991 -> 957;
	992 [label="A talking guitar.",shape=box,color=red];
		992 -> 957;
	995 [label="He was an Executor. One of the most powerful of the Seven, in fact. He could have summoned her to his bedchambers and she would have been there without a second thought.",shape=box,color=blue];
		995 -> 999;
	996 [label="Lizzie. She'd love you.",shape=box,color=red];
		996 -> 974;
	997 [label="A talking guitar.",shape=box,color=red];
		997 -> 974;
	998 [label="ข้าเองก็อยากสั่งสอนเจ้ากับสิ่งที่ทำลงไปแล้วยังกล้าเรียกว่า \"ความรัก\" แต่พอมานึกดูแล้วพวก Orokin ขึ้นชื่อว่าทำเรื่องเลวร้ายกว่านี้มาก แถมยังสรรหาวิธีที่เกินกว่าจินตนาการด้วยซ้ำ",shape=box,color=blue];
		998 -> 931;
	999 [label="But that is not what he did. Ballas took one look at her that evening, and... he was stricken, Drifter. Positively and absolutely beside himself.",shape=box,color=blue];
		999 -> 1000;
	1000 [label="I had never seen anything like it. It was as though no one else in the room even existed, save for Margulis. He seemed even... somehow too shy to speak to her. Him! Ballas!",shape=box,color=blue];
		1000 -> 1001;
		1000 -> 1002;
	1001 [label="Really?",shape=box,color=red];
		1001 -> 1003;
	1002 [label="You're making this up.",shape=box,color=red];
		1002 -> 1004;
	1003 [label="I swear on whatever remains of my honor! And what reason would I have to lie? What do I care of your opinion of the validity of their relationship?",shape=box,color=blue];
		1003 -> 1005;
	1004 [label="I swear on whatever remains of my honor I am not! And what reason would I have to lie? What do I care of your opinion of the validity of their relationship?",shape=box,color=blue];
		1004 -> 1005;
	1005 [label="It simply saddens me that you lot would so quickly simplify something that is decidedly far more complicated than you would have it.",shape=box,color=blue];
		1005 -> 1006;
	1006 [label="They were in love, whether you wish to believe it or not. Ballas eshewed all class rules and tradition to take as his lover - and his sole romantic companion - an Archimedean. ",shape=box,color=blue];
		1006 -> 1007;
	1007 [label="Only true love could have sent a man so spectacularly mad as it sent him, when it all went so very wrong...",shape=box,color=blue];
		1007 -> 1008;
		1007 -> 1009;
	1008 [label="How do you figure? Wasn't he responsible for her death?",shape=box,color=red];
		1008 -> 1010;
	1009 [label="Ballas was the one who had her executed.",shape=box,color=red];
		1009 -> 1010;
	1010 [label="First, let us assume all you know is correct, and that his actions there were purely of his own accord. Let us assume that there were no other political maneuverings or blackmail or anything else being done behind the scenes that may have forced his hand.",shape=box,color=blue];
		1010 -> 1011;
	1011 [label="Even if that were to be the case, and Ballas called for her execution entirely without influence, consider that it was already too late. The betrayal he felt had already cleaved him in two.",shape=box,color=blue];
		1011 -> 1012;
	1012 [label="His heart and his mind was already broken.",shape=box,color=blue];
		1012 -> 1013;
		1012 -> 1014;
	1013 [label="I am not going to start feeling bad for him, if that's what you're asking me to do.",shape=box,color=red];
		1013 -> 1015;
	1014 [label="Because of the Tenno? Or because of what they did to her?",shape=box,color=red];
		1014 -> 1016;
	1015 [label="I am not asking you to have anything of the sort! Ballas deserves anything but whatever piss you can spare to spend on wherever you buried his corpse - if he even has a grave.",shape=box,color=blue];
		1015 -> 1017;
	1016 [label="In a way, both. And in a way, neither. He was driven to madness that day, when he called for her execution. In fact, I would not be surprised if some part of him did not entirely recall doing the deed.",shape=box,color=blue];
		1016 -> 1018;
	1017 [label="I am merely stating that on the day he called for her execution, he was a madman. I would not be surprised if some part of him did not entirely recall doing the deed, after the fact.",shape=box,color=blue];
		1017 -> 1018;
	1018 [label="Ballas loved Margulis. With his whole person, completely - entirely devoted to her. He would have sacrificed anything and everything for her. His soul, his body, the Orokin Empire. Anything you could possibly dream of.",shape=box,color=blue];
		1018 -> 1019;
	1019 [label="No cost was too great. No morals worth sacrificing. If you had handed him a newborn babe and told him Margulis wished its brains dashed out upon the rocks, it would be dead before you finished your sentence.",shape=box,color=blue];
		1019 -> 1020;
	1020 [label="He would have burned the Origin System to ashes and rebuilt it in her image, Usurper... but herein lies the tragedy.",shape=box,color=blue];
		1020 -> 1021;
	1021 [label="Margulis? Aah, Margulis. Dear, sweet, darling Margulis... she still had a conscience.",shape=box,color=blue];
		1021 -> 1022;
	1022 [label="And when she saw the poor Tenno, the poor, Void-torn children... ",shape=box,color=blue];
		1022 -> 1023;
	1023 [label="Something in her life was more important than Ballas. Something in her life was worth sacrificing her life for... that was not him.",shape=box,color=blue];
		1023 -> 1024;
	1024 [label="That was not her love for him.",shape=box,color=blue];
		1024 -> 1025;
	1025 [label="And he knew this, my sweet Drifter. He knew this from the moment she laid her eyes on them. And it was driven home when her \"mad animals\" ensured they were the last she ever saw. Or at least that was what the rumors were amongst us Orokin.",shape=box,color=blue];
		1025 -> 1026;
	1026 [label="Can you imagine the joy amongst the Orokin? Seeing Ballas' precious Archimedean's Void-torn, rabid brats burn out her eyes?",shape=box,color=blue];
		1026 -> 1027;
	1027 [label="But I think, it was before then, at the precise moment Margulis fought to save the Tenno that Ballas's heart shattered into a thousand pieces, and never recovered.",shape=box,color=blue];
		1027 -> 1028;
	1028 [label="เพราะเขารู้ว่าตัวเองโดนใครเข้ามาแทนที่ในหัวใจของนางแล้ว",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="ข้าคิดว่าคงเพราะเหตุนั้น จึงอดสงสารเขาไม่ได้ แต่สิ่งที่ตามมาหลังจากนั้น กลายเป็นเรื่องรักระดับตำนาน… ที่จบลงด้วยโศกนาฏกรรมที่แตกสลายไปแบบนั้น ",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="ข้าอยากให้เจ้าได้เห็นในตอนที่พวกเขายิ้มให้กันจริง ๆ…",shape=box,color=blue];
		1030 -> 1031;
		1030 -> 1032;
	1031 [label="เจ้าจะทำให้ความสัมพันธ์ของพวกเขาดูสวยหรูแค่ไหนก็ได้ แต่นั่นไม่ได้ลบล้างความเป็นตัวเขา Ballas ไม่มีวันได้รับการให้อภัยสำหรับทุกสิ่งที่เขาทำลงไป",shape=box,color=red];
		1031 -> 1033;
	1032 [label="ข้าดีใจที่ความรักของพวกเขาเป็นของจริง ที่เมื่อก่อนเขาเองก็… ซับซ้อนกว่านี้ แล้วก็ที่ Margulis ไม่ได้เป็นแค่คนที่ถูกเขาหลอกใช้มาตลอด",shape=box,color=red];
		1032 -> 1034;
