		1016 -> 1018;
	1017 [label="ข้าแค่จะบอกว่า ในวันที่เขาเอ่ยปากสั่งประหารนางนั้น เขาไม่ต่างอะไรจากคนเสียสติแล้ว ข้าคงไม่แปลกใจเลย หากเสี้ยวหนึ่งของตัวเขาจะจดจำไม่ได้ด้วยซ้ำว่าตนเองได้กระทำการนั้นลงไป",shape=box,color=blue];
		1017 -> 1018;
	1018 [label="Ballas รัก Margulis อย่างสุดหัวใจ เขาทุ่มเททั้งกายใจให้นาง อุทิศทุกอย่างให้นางผู้เดียว เขายอมสละได้ทุกสิ่งเพื่อนาง ทั้งวิญญาณ ร่างกาย ไปจนถึงจักรวรรดิ Orokin ทุกสิ่งที่สามารถจินตนาการได้",shape=box,color=blue];
		1018 -> 1019;
