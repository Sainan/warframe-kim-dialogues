		j2587428783 -> j2065648446;
	j2065648446 [label="คนเราย่อมรู้เสมอว่าตัวเองยืนอยู่ตรงไหนกับนาง ก็ตรงหน้าผาแห่งห้วงเหวใหญ่ไง",shape=box,color=blue];
		j2065648446 -> j2987071833;
	j2987071833 [label="จงกระโดดเข้ามาเถิด ดวงตาของนางพูดกับข้า เปล่งประกายด้วยความสุขจากมุกตลกขบขันแห่งจักรวาลอันมหึมา",shape=box,color=blue];
		j2987071833 -> j228565102;
	j228565102 [label="ผ่านภาพหลอนที่วิปลาสของนาง ที่ข้าสามารถปลีกหนีออกจากความเหนื่อยหน่ายและหดหู่ของการดำรงอยู่มาอย่างยาวนานของ Orokin ได้",shape=box,color=blue];
		j228565102 -> j372500700;
	j372500700 [label="ประสาทสัมผัสทั้งหมดของเราถูกทำให้ชาไปหลายศตวรรษแล้ว แต่นางก็ยังคงสดชื่นในแบบของตัวเอง",shape=box,color=blue];
		j372500700 -> j33042963;
	j33042963 [label="หิวโหยความนิรันดร์อย่างไร้ขีดจำกัด เย็นวันหนึ่ง นางเรียกข้าไปอาบน้ำให้ ข้าก้าวข้ามแอ่งน้ำที่ผสมกลิ่นน้ำหอมกับเลือด และยืนตรงอย่างเชื่อฟัง",shape=box,color=blue];
		j33042963 -> j2482115421;
	j2482115421 [label="\"ข้าเบื่อแล้ว Roathe ฆ่า Orokin คนอื่น ๆ ให้หมด แล้วยึดครองอำนาจซะ\"",shape=box,color=blue];
		j2482115421 -> j921430358;
