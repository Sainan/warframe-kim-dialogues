	j4238768588 [label="VM: SUBMISSION",shape=box,color=blue];
		j4238768588 -> j3916648897;
	j3916648897 [label="บันทึก: ข้าเข้าใจตั้งแต่แรกเริ่ม ทั้งในสนามรบและในห้องนอนว่า เส้นทางสู่ชัยชนะนั้นต้องทำให้ดูเหมือนว่าจะยอมจำนน",shape=box,color=blue];
		j3916648897 -> j2603819526;
	j2603819526 [label="ในที่ที่ศัตรูเห็นว่าเรายอมศิโรราบ ที่ที่เรามั่นใจว่าเมื่อเขาผลัก เราจะล้มเขาได้อย่างง่ายดาย",shape=box,color=blue];
		j2603819526 -> j251174390;
	j251174390 [label="ทุกคนต่างเรียกข้าว่า \"ลูกสมุน\" หรือไม่ก็ \"สุนัขเลี้ยง\" Nitokh คิดว่าตัวเองควบคุมได้ แต่ข้านำทางนางอย่างแนบเนียน ",shape=box,color=blue];
		j251174390 -> j4081108645;
	j4081108645 [label="Roathe ผู้มือเปื้อนเลือด Roathe ยักษ์ที่อ้วนพีบนร่างของลูกน้อง ใช้ชีวิตสุรุ่ยสุร่าย",shape=box,color=blue];
		j4081108645 -> j2707266041;
	j2707266041 [label="ราวกับว่าข้าต่อสู้เพียงเพื่อชัยชนะ! ไม่หรอก จักรวรรดิ Orokin ต้องล่มสลาย",shape=box,color=blue];
		j2707266041 -> j3515166703;
	j3515166703 [label="และเพื่อจะทำให้เป็นเช่นนั้น สงครามต้องดำเนินต่อไป มีเพียงความพ่ายแพ้อย่างเด็ดขาดและลบล้างไม่ได้เท่านั้นที่จะโค่นล้มการ์กอยล์สีทองทั้งเจ็ดตนได้",shape=box,color=blue];
		j3515166703 -> j2624666201;
	j2624666201 [label="แม้แต่ Nitokh ก็ยังไม่รู้หัวใจที่แท้จริงของข้า นางคิดว่าข้าปรารถนาที่จะปกครองเคียงข้างนาง",shape=box,color=blue];
		j2624666201 -> j921430358;
