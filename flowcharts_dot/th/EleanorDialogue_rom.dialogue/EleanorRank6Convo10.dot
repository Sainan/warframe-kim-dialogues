digraph {
	"EleanorRank6Convo10 begins." [color=orange];
		"EleanorRank6Convo10 begins." -> j4267819647;
	j4267819647 [label="คือกำลังคิดอยู่ว่า ในช่วงปลายเดือนธันวาคมชีวิตก็จะวนไปเหมือนเช่นทุกปี และถึงแม้จะรู้สึกเหมือนขึ้นปีใหม่ แต่ก็ไม่ใช่แบบนั้นจริง ๆ",shape=box,color=blue];
		j4267819647 -> j1205201666;
	j1205201666 [label="และแม้จะรู้ว่าเหตุการณ์นี้เคยเกิดขึ้นมาหลายครั้งแล้ว แต่จริง ๆ แล้วไม่รู้อะไรเลย เพราะเราอาจจะจำไม่ได้ก็ได้",shape=box,color=blue];
		j1205201666 -> j1495349398;
	j1495349398 [label="แล้วจะเกิดอะไรขึ้นหากเราจำได้ว่าวงจรชีวิตรอบแรกที่จริงนั้นวนมารอบที่หนึ่งหมื่นห้าพันสี่สิบสองแล้ว",shape=box,color=blue];
		j1495349398 -> j2548137139;
	j2548137139 [label="แล้วก็มานั่งคิดอีกว่า เอาละ ช่างมันเถอะ ออกไปทำอะไรบ้า ๆ ตามใจตัวเองดีกว่า เพราะถึงยังไงก็สามารถต่อยพื้นอีกครั้งแล้วรีเซ็ตทุกอย่างได้เสมอ",shape=box,color=blue];
		j2548137139 -> j3809765186;
	j3809765186 [label="แต่แล้วก็คิดว่าไม่ เดี๋ยวนะ ถ้าครั้งนี้เราติดอยู่จริง ๆ ล่ะ แล้วเราจะไปต่อจากปี 1999 ถึง 2000 ได้ยังไง",shape=box,color=blue];
		j3809765186 -> j1980734710;
	j1980734710 [label="ไม่อยากทำให้ตัวเองกลายเป็นคนโง่ในรอบที่อาจเป็นรอบสุดท้ายในปี 1999 ที่เป็นจุดเปลี่ยนสำคัญหรอก เพราะคงไม่มีวันแก้ไขอะไรได้",shape=box,color=blue];
		j1980734710 -> j3350591161;
	j3350591161 [label="หากจะใช้การเปรียบเทียบแบบเก่าที่น่าเบื่อก็ต้องบอกว่า สักวันจะเป็นครีษมายันและไม่ใช่แค่ฤดูหนาวที่ไม่มีวันสิ้นสุด",shape=box,color=blue];
		j3350591161 -> j420725480;
