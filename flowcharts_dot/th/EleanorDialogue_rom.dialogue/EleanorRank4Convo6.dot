digraph {
	1906 [label="EleanorRank4Convo6 begins.",color=orange];
		1906 -> 1907;
		1906 -> 1908;
	1907 [label="แล้ว… ทำไมถึงเป็นคริสตัลล่ะ?",shape=box,color=red];
		1907 -> 1909;
	1908 [label="คือ เจ้ากับ Quincy เคยแบบ... นั้นน่ะ เคยไหม?",shape=box,color=red];
		1908 -> 1910;
	1909 [label="โอ้ ฉันชอบของแบบนี้มาตลอดเลย ตอนเด็ก ๆ พ่อพาเราไปที่พิพิธภัณฑ์นวัตกรรมใน Ludston แล้ว Arthur กับฉันได้ชุดปลูกคริสตัลมา ชุดของ Arthur แย่มาก ออกมาเป็นก้อน ๆ เหมือนกรวดเล็ก ๆ เขาเลยทิ้งมันไป แต่ของฉันเป็นเพชรสีน้ำเงินสวยงาม ตั้งแต่วันนั้นเป็นต้นมาก็รู้สึกราวกับว่ามีคริสตัลอยู่ข้างตัว",shape=box,color=blue];
		1909 -> 1912;
	1910 [label="โอเค วันนี้รู้สึกใจดี เพราะงั้นจะเล่าเรื่องนี้ให้ฟังฟรี ๆ ก็ได้",shape=box,color=blue];
		1910 -> 1911;
	1912 [label="มันเป็นแค่ของตกแต่งใช่ไหม",shape=box,color=red];
		1912 -> 1916;
	1911 [label="เราไม่เคยเลย แม้แต่นิดเดียว",shape=box,color=blue];
		1911 -> 1913;
	1916 [label="เอ่อ ไม่",shape=box,color=blue];
		1916 -> 1917;
	1913 [label="ฉันอดคิดไม่ได้ว่าตำแหน่งที่ Quincy ชอบจะเป็นตำแหน่งที่ \"คู่ขาอยู่ข้างบนถือกระจก เพื่อที่เขาจะได้จินตนาการว่ากำลังมีเซ็กส์กับตัวเอง\"",shape=box,color=blue];
		1913 -> 1914;
	1917 [label="ฉันรู้ว่ามีการเขียนเรื่องไร้สาระเกี่ยวกับคริสตัลมากมาย แต่ยังไงก็ไม่เชื่อว่าคริสตัลจะช่วยชำระล้างออร่าหรือทำให้จักระสว่างขึ้นได้หรอก",shape=box,color=blue];
		1917 -> 1918;
	1914 [label="เพราะงั้นไม่เป็นไร ขอบคุณ ฉันพอใจที่จะชื่นชมจากที่ไกล ๆ",shape=box,color=blue];
		1914 -> 1915;
	1918 [label="แต่พวกมันมีตัวตน",shape=box,color=blue];
		1918 -> 1919;
	1915 [label="Chat ends.",color=orange];
	1919 [label="ขอโทษนะที่ฟังดูเหมือนคนบ้าเลย",shape=box,color=blue];
		1919 -> 1920;
		1919 -> 1921;
		1919 -> 1922;
	1920 [label="ดีใจที่เจ้าพูดแบบนั้นเอง ไม่ใช่ข้า เพราะมันก็เป็นแค่หินแฟนซี",shape=box,color=red];
		1920 -> 1923;
	1921 [label="ข้ามีเพื่อนที่เป็น Cephalon ซึ่งเป็นสิ่งมีชีวิตอัจฉริยะในรูปของลูกบาศก์แก้ว ทำไมถึงคิดว่าข้าจะหัวเราะเยาะที่คิดว่าคริสตัลมีตัวตนอยู่ล่ะ",shape=box,color=red];
		1921 -> 1924;
	1922 [label="ข้าใช้เวลาอย่างมากในการขุดคริสตัลออกจากพื้นดินจนไม่มีเวลาให้ความสำคัญในระดับที่ลึกกว่านั้น เจ้าคงประหลาดใจถ้ารู้ว่ามี Warframe มากมายถูกสร้างขึ้นจากคริสตัลชนิดเดียวกันหรือหลายชนิด",shape=box,color=red];
		1922 -> 1925;
	1923 [label="โอ้ บางทีแกก็น่ารำคาญนะ",shape=box,color=blue];
		1923 -> 1926;
