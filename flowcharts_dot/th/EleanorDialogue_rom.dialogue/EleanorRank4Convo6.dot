		1933 -> 1941;
	1928 [label="Chat ends.",color=orange];
	1934 [label="ที่บอกว่า \"พบมันได้ในวอยด์เท่านั้น\" เหมือนกับว่ามีคนเข้า ๆ ออก ๆ จากวอยด์ตลอดเวลา ตอนแรกคิดว่ามันเป็นมิติประหลาด ไม่ใช่รีสอร์ทริมทะเลเสียอีก",shape=box,color=blue];
		1934 -> 1937;
	1944 [label="+10 Chemistry",color=orange];
