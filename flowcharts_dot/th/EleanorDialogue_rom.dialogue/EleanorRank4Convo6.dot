		1937 -> 1951;
	1935 [label="นั่นชื่อของหล่อนเหรอ เหมือนจะเห็นอยู่ในจิตใจของเธอนะ",shape=box,color=blue];
		1935 -> 1938;
	1936 [label="ช่างงดงามและน่าเศร้าเหลือเกิน จะเป็นยังไงนะ หากต้องกลายมาเป็นอนุสรณ์ให้กับความรักของตัวเอง",shape=box,color=blue];
		1936 -> 1939;
	1951 [label="+20 Chemistry",color=orange];
		1951 -> 1946;
	1938 [label="เป็นหญิงผลึกใสที่น่ารัก คิดว่าหล่อนกับฉันคงนับเป็นญาติกันแล้ว นับว่าเป็นเรื่องที่น่ายินดี",shape=box,color=blue];
		1938 -> 1943;
	1939 [label="หวังว่าคงไม่มีใครทุบมันออกเป็นชิ้นเล็กชิ้นน้อยเพื่อเก็บไว้เป็นที่ระลึกหรอกนะ ถ้าเป็นในยุคนี้มีคนทำแน่นอน",shape=box,color=blue];
		1939 -> 1940;
	1946 [label="มีเรื่องคล้าย ๆ กันเลย มีบังเกอร์รักษาความปลอดภัยชั้นยอดอยู่ใต้ Ludston และ Mancunia เผื่อถ้าเกิดสงครามรังสีขึ้นมา พวกผู้มีอำนาจและพวกคนใหญ่คนโตจะได้ซ่อนตัวอยู่ในที่พักอันหรูหราและจิบมิโมซ่า ในขณะที่พวกเราที่เหลือถูกเผาจนเป็นเถ้าถ่านอยู่ข้างบน",shape=box,color=blue];
		1946 -> 1947;
	1943 [label="ยินดีต้อนรับสู่ครอบครัวสินะ",shape=box,color=red];
		1943 -> 1945;
	1940 [label="มีคนพยายามทำเหมือนกัน แต่เราช่วยทำให้คริสตัลปลอดภัย นั่นเป็นสิ่งที่เราพอจะทำได้",shape=box,color=red];
		1940 -> 1942;
	1947 [label="“เรื่องเดิม ๆ” เธอกล่าวพลางถอนหายใจ",shape=box,color=blue];
		1947 -> 1948;
	1945 [label="Chat ends.",color=orange];
	1942 [label="Chat ends.",color=orange];
	1948 [label="ตลกดีนะ ตอนที่เริ่มโตขึ้นตอนนั้นทุกคนกลัวสงครามรังสีมาก ยังจำรายการวิทยุกระจายเสียงสาธารณะที่เคยออกอากาศได้อยู่เลย คำแนะนำที่เศร้าสร้อยเกี่ยวกับวิธีการกักตุนเสบียง วิธีเตรียมห้องหลบภัย และวิธีที่ต้องฝังศพญาติที่เสียชีวิตแม้ว่าจะไม่ต้องการก็ตาม",shape=box,color=blue];
		1948 -> 1949;
	1949 [label="ตอนที่เห็นเครื่องปฏิกรณ์ระเบิดในจิตใจเธอน่ะ มันทำให้นึกถึงฝันร้ายเหล่านั้นอีกครั้ง รู้เลยว่าเราต้องหยุดมัน ไม่ว่าจะต้องทำยังไงก็จะทำให้คนอื่นเชื่อเธอให้ได้",shape=box,color=blue];
		1949 -> 1950;
	1950 [label="ไม่ใช่สงครามรังสีที่กำลังรอโลกใบนี้อยู่หรอกใช่ไหม แต่มันคือ Techrot ต่างหาก ไม่ทางใดก็ทางหนึ่ง วังวนนี้จะทำงานไปเอง และเมื่อเป็นเช่นนั้น โลกที่เหลือก็จะติดเชื้อไปด้วย",shape=box,color=blue];
		1950 -> 1952;
	1952 [label="Chat ends.",color=orange];
