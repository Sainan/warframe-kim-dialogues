	1930 [label="เล่าให้ฟังหน่อยสินักเดินทางผู้ชาญฉลาด ถึงคริสตัลในยุคนั้น",shape=box,color=blue];
		1930 -> 1932;
	1927 [label="ออกไปให้พ้น ทิ้งให้ฉันอยู่กับก้อนหินแฟนซีเถอะ",shape=box,color=blue];
		1927 -> 1928;
	1931 [label="อาร์กอน พบมันได้ในวอยด์เท่านั้น และจะสลายตัวเมื่อนำมันออกมา",shape=box,color=red];
		1931 -> 1934;
