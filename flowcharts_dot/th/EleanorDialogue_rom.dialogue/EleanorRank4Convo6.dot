		1924 -> 1929;
	1925 [label="อึ้งและทึ่งมาก!",shape=box,color=blue];
		1925 -> 1930;
	1926 [label="ฉันเคยคิดว่าคนอย่างเธอจะสามารถยกระดับมุมมองในการมองวัตถุให้เหนือกว่านั้นเสียอีก",shape=box,color=blue];
		1926 -> 1927;
	1929 [label="ฉันคิดว่าเธอมีคริสตัลที่ฉันได้แต่ฝันถึงเท่านั้น",shape=box,color=blue];
		1929 -> 1931;
		1929 -> 1932;
