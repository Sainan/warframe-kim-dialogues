		1812 -> 1817;
	1815 [label="ขอโทษจริง ๆ นะ จากนี้ไปฉันจะพยายามควบคุมความอยากรู้อยากของตัวเองให้ได้",shape=box,color=blue];
		1815 -> 1816;
	1817 [label="ในยุคสมัยของข้า มันก็ไม่ได้เปลี่ยนไปเลย เทวดาถูกกำหนดให้เป็นสิ่งมีชีวิตที่มีปีกและเปล่งประกายจากเรื่องเล่าเก่า ๆ ที่คอยช่วยเหลือมนุษย์ที่ดี แต่ที่กำลังพูดถึงคือเทวทูตแห่งวอยด์ พวกมันเป็นสัตว์ร้ายอีกประเภทหนึ่ง",shape=box,color=red];
