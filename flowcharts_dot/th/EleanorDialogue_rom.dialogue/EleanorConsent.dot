	j862741861 [label="สิ่งเดียวที่น่ารำคาญเกี่ยวกับเรื่องนี้คือฉันพบความคิดเกี่ยวกับเขาในหัวของเธอก่อน",shape=box,color=blue];
		j862741861 -> j2857314769;
	j2857314769 [label="ไม่ใช่ไม่รู้ว่ายังไงเธอก็คงมาขออนุญาตอย่างสุภาพหรอกนะ สวัสดี",shape=box,color=blue];
		j2857314769 -> j2188035968;
	j2188035968 [label="คำตอบคือ \"ได้อยู่แล้ว\" อย่างงอน ๆ พร้อมเอามือกอดอดระหว่างที่นั่งอยู่ตรงนี้พยายามไม่คิดถึงเธอที่กำลังสนุกอยู่กับสิ่งสวยงามที่ฉันเห็นแวบ ๆ ในจินตนาการของเธอ",shape=box,color=blue];
		j2188035968 -> j2129603776;
	j2129603776 [label="ตอนนี้มันกลายเป็นเพียงจินตนาการของฉันเอง เพราะดันติดอยู่ที่นี่ในช่วงเวลาและสถานที่นี้ ขอบคุณมากจริง ๆ!",shape=box,color=blue];
		j2129603776 -> j2583339092;
	j2583339092 [label="ขอโทษนะ อันที่จริงก็ตั้งใจมาขอความยินยอมจริง ๆ นั่นแหละ เพราะรู้ว่าเราไม่เคยคุยกันเรื่องนี้มาก่อน และอยากถามให้มั่นใจว่าทุกอย่างจะโอเค",shape=box,color=red];
		j2583339092 -> j3476587942;
	j3476587942 [label="แน่นอนอยู่แล้ว! ฉันมองเห็นมันในความคิดของเธอ และถ้าเธอเชื่อใจเขา ฉันก็จะเชื่อเช่นกัน",shape=box,color=blue];
		j3476587942 -> j1590026859;
