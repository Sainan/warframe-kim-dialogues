	1780 [label="ไม่ค่อยแน่ใจแล้วว่าควรเล่าเรื่องอะไรให้ฟังบ้าง",shape=box,color=blue];
		1780 -> 1781;
	1783 [label="ทั้งคู่ต่างก็เป็นคนโรแมนติก เพียงแต่เป็นคนละประเภทกัน Arthur อยากได้กระท่อมที่มีดอกกุหลาบอยู่รอบประตู เขาอ้างว่าไม่ได้อยากได้ แต่จริง ๆ แล้วอยากได้",shape=box,color=blue];
		1783 -> 1784;
	1792 [label="Chat ends.",color=orange];
	1781 [label="Chat ends.",color=orange];
	1784 [label="พระเจ้า เขาเคยพูดเรื่องการเป็นเจ้าของผับด้วยซ้ำ มองเห็นได้เลยว่าเขากับลูกค้าประจำกลุ่มเล็ก ๆ คงจะนั่งดื่มเบียร์ ย่างอาหารกันวันอาทิตย์ที่ได้มาอย่างยากลำบาก",shape=box,color=blue];
		1784 -> 1785;
	1785 [label="คิดว่า Aoi จะหาที่ในฝันแบบนั้นได้ไหม คิดไม่ออกเลย หล่อนจะต้องกล้าลงมือทำสิ่งใหม่ ๆ",shape=box,color=blue];
		1785 -> 1787;
	1787 [label="Chat ends.",color=orange];
}