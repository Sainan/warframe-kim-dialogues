		1985 -> 1987;
	1986 [label="พ่อเป็นอดีตทหาร ร่าเริง มีตาเหี่ยว ๆ พูดจาเหมือนผู้ประกาศข่าว ภายในใจแตกสลาย แบบว่าถ้าเราอุ้มขึ้นมาเขย่า พ่อก็จะสั่นเหมือนถุงกรวด อารมณ์เสียง่ายอย่างน่าประหลาด ฉันเคยพูดความคิดเห็นที่คิดว่าไม่รุนแรงออกไป แต่ต่อมาก็ได้ยินพ่อร้องไห้ในห้องน้ำ",shape=box,color=blue];
