		1987 -> 1989;
	1988 [label="แม่มีฐานะร่ำรวยกว่า นั่นหมายความว่าแม่มีอิสระที่จะทำอะไรก็ได้ แม่ไม่ชอบไปปาร์ตี้ ไม่ดื่มไวน์ ไม่เล่นยา และเที่ยวเล่นในแฟลต Ludston นานเป็นสัปดาห์ นั่นเป็นสิ่งที่ป้า Janice ชอบทำมากกว่า ส่วนแม่ชอบดอกไม้ ปั้นเครื่องดินเผาตัวเม่น น้ำหอม และทุกอย่างที่ดูดี",shape=box,color=blue];
