digraph {
	7 [label="HexRankUpTo4 begins.",color=orange];
		7 -> 119;
	119 [label="H16h V0l7463: 這像是一個續集嗎？我是《阿米爾 2：尋找更多阿米爾》嗎？！《阿米爾 1》怎麼了？！",shape=box,color=blue];
		119 -> 120;
	120 [label="Salem: 我的漂泊者。",shape=box,color=blue];
		120 -> 121;
	121 [label="Belladonna ~{@: 這裡甚至感覺更明亮了
日尊真的很滿意",shape=box,color=blue];
		121 -> 122;
	122 [label="Soldja1Shot1kil: 這就叫風格。懂。",shape=box,color=blue];
		122 -> 123;
	123 [label="xX GLIMMER Xx: <RETRO_EMOJI_GIVELOVE>",shape=box,color=blue];
		123 -> 124;
	124 [label="Broadsword: 哦，我的日君。你到底做了什麼？",shape=box,color=blue];
		124 -> 125;
		124 -> 126;
	125 [label="只是做了感覺對的事。",shape=box,color=red];
		125 -> 200;
	126 [label="我唯一知道怎麼做的事。",shape=box,color=red];
		126 -> 201;
	200 [label="Update boolean HexWhatFeltRight",color=orange];
		200 -> 127;
	201 [label="Update boolean HexWhatIKnow",color=orange];
		201 -> 127;
	127 [label="H16h V0l7463: 但我是誰？你又是誰？發生什麼事了",shape=box,color=blue];
		127 -> 128;
	128 [label="Soldja1Shot1kil: 喂，冷靜點。我們還是我們。兄弟，看一下，那個小無人機還在不眠不休地清理我們的垃圾",shape=box,color=blue];
		128 -> 129;
	129 [label="Salem: 就像我們親愛的漂泊者一樣付出那麼多。清掉一大堆垃圾。",shape=box,color=blue];
		129 -> 130;
	130 [label="xX GLIMMER Xx: 我看起來更像是，你重製了我們的歌曲，對嗎？",shape=box,color=blue];
		130 -> 131;
		130 -> 132;
		130 -> 133;
	131 [label="把這想成最佳的防禦玩法。",shape=box,color=red];
		131 -> 202;
	132 [label="把這想成人生再造。",shape=box,color=red];
		132 -> 203;
	133 [label="我用我們的方式去做了。",shape=box,color=red];
		133 -> 204;
	202 [label="Update boolean HexDefensivePlay",color=orange];
		202 -> 134;
	203 [label="Update boolean HexRebrand",color=orange];
		203 -> 134;
	204 [label="Update boolean HexOurWay",color=orange];
		204 -> 134;
	134 [label="Broadsword: 但怎麼會？",shape=box,color=blue];
		134 -> 135;
	135 [label="Salem: 老弟，那是簡單的問題，較難的問題是為什麼？",shape=box,color=blue];
		135 -> 136;
		135 -> 137;
		135 -> 138;
	136 [label="因為我們是個團隊。",shape=box,color=red];
		136 -> 205;
	137 [label="你沒發現我們是個團隊嗎？",shape=box,color=red];
		137 -> 206;
	138 [label="一個人的是沒有未來的。",shape=box,color=red];
		138 -> 207;
	205 [label="Update boolean HexWereATeam",color=orange];
		205 -> 139;
	206 [label="Update boolean HexSeeWereATeam",color=orange];
		206 -> 139;
	207 [label="Update boolean HexNoFutureAlone",color=orange];
		207 -> 139;
	139 [label="xX GLIMMER Xx: 我們是個團隊，太棒了！<RETRO_EMOJI_THUMBSUP>",shape=box,color=blue];
		139 -> 140;
	140 [label="Soldja1Shot1kil: 但使命是什麼，夥計？",shape=box,color=blue];
		140 -> 141;
	141 [label="H16h V0l7463: 也許使命就是拯救霍爾瓦尼亞！而且我們還可以收集非玩家角色！",shape=box,color=blue];
		141 -> 142;
	142 [label="Belladonna ~{@: 噢，我的白月，救救我
你的意思是人們，阿米爾",shape=box,color=blue];
		142 -> 143;
		142 -> 144;
		142 -> 145;
	143 [label="如果這是一場遊戲，我只重置了其中的物件。",shape=box,color=red];
		143 -> 150;
	144 [label="無論這是什麼遊戲，我只是在其中採取了行動。",shape=box,color=red];
		144 -> 209;
	145 [label="源拓氏總是領先我們一步。",shape=box,color=red];
		145 -> 210;
	150 [label="Soldja1Shot1kil: 不是耶，夥計。聽起來好像你改變了遊戲規則。這我向你致敬",shape=box,color=blue];
		150 -> 208;
	209 [label="Update boolean HexWhatGameIsThis",color=orange];
		209 -> 146;
	210 [label="Update boolean HexEntratiAhead",color=orange];
		210 -> 146;
	208 [label="Update boolean HexResetPieces",color=orange];
		208 -> 146;
	146 [label="Broadsword: 誰有共同參與的，我想我們把這一年，這地方，這時間，變成我們獨有的了。我們永遠不要放棄，永遠保護人們還有彼此。",shape=box,color=blue];
		146 -> 147;
	147 [label="xX GLIMMER Xx: 是的，我們去做出改變！很多值得期待的美好事物比如，創造回憶等等。我們去拯救別人，不只是我們自己。",shape=box,color=blue];
		147 -> 148;
	148 [label="Salem: 我們是開始，不是結束。",shape=box,color=blue];
		148 -> 149;
	149 [label="Belladonna ~{@: 巫婆，就這次
我同意。",shape=box,color=blue];
		149 -> 38;
	38 [label="{\"Id\":38,\"Incoming\":[149],\"Outgoing\":[8],\"GraphPos\":[9318,-2019],\"CompletionType\":3,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/AoiDialogue_rom.dialogue\",\"Tag\":\"\",\"Value\":30},{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/ArthurDialogue_rom.dialogue\",\"Tag\":\"\",\"Value\":30},{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/EleanorDialogue_rom.dialogue\",\"Tag\":\"\",\"Value\":30},{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/JabirDialogue_rom.dialogue\",\"Tag\":\"\",\"Value\":30},{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/LettieDialogue_rom.dialogue\",\"Tag\":\"\",\"Value\":30},{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/QuincyDialogue_rom.dialogue\",\"Tag\":\"\",\"Value\":30}]}",color=orange];
		38 -> 8;
	8 [label="Chat ends.",color=orange];
