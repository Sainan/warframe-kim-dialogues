		j960295801 -> j2141929660;
	j1620795456 [label="Boolean HexSongC is now true.",color=orange];
		j1620795456 -> j2141929660;
	j2141929660 [label="Salem: 嗯，不錯的選擇。",shape=box,color=blue];
		j2141929660 -> j2146869277;
	j2146869277 [label="Soldja1Shot1kil: 回到主要問題，我們準備打開大門了嗎？我可以做到態度友善，大致上",shape=box,color=blue];
		j2146869277 -> j1210863146;
	j1210863146 [label="Belladonna ~{@: 別閒聊了
動手！我們動起來
迫不及待想和別人討論亞瑟的戰鬥姿態以外的話題了",shape=box,color=blue];
		j1210863146 -> j3524754191;
	j3524754191 [label="Salem: 哦，莉蒂，我們都知道你可以帶他走。",shape=box,color=blue];
		j3524754191 -> j91588480;
	j91588480 [label="xX GLIMMER Xx: 莉蒂，你是認真的嗎？你聽起來真的好興奮！<RETRO_EMOJI_JOY>",shape=box,color=blue];
		j91588480 -> j356439489;
	j356439489 [label="Broadsword: 好的，我要開放商場了。不會有回頭路。不再三心二意。記得，有個可以安身立命的地方對人民來說意義非凡。但我們可以做得更好。讓我們再次開心玩樂。",shape=box,color=blue];
		j356439489 -> j3589930060;
