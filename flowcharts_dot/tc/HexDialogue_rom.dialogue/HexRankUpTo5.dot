		159 -> 160;
	160 [label="xX GLIMMER Xx: 呃，好噁喔，阿米爾。",shape=box,color=blue];
		160 -> 161;
	161 [label="xX GLIMMER Xx: 但──人變多了！也許我們應該用個播放清單來歡迎他們？我們應該放什麼歌好呢？",shape=box,color=blue];
