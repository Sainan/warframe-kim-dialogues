		179 -> 68;
	68 [label="xX GLIMMER Xx: 也許下次你可以跟我一起吃？歡迎大家跟我一起共進午餐……我還以為大家想要他們自己的獨處時間……",shape=box,color=blue];
		68 -> 69;
	69 [label="H16h V0l7463: 我很愛吃，我可以陪大家吃，給阿米爾來六片披薩！笑死我了",shape=box,color=blue];
		69 -> 70;
	70 [label="Soldja1Shot1kil: 好吧，既然亞瑟都說我們有充足的食物了，當然要餵飽你這個正在長大的小男孩了",shape=box,color=blue];
		70 -> 71;
	71 [label="H16h V0l7463: 嘿，我想我其實長得比你還高，所以為什麼還要那樣說？這樣我就會長得更大了！哈！",shape=box,color=blue];
		71 -> 72;
