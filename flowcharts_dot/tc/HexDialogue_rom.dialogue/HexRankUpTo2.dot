	57 [label="Soldja1Shot1kil: 阿莉，但妳自己都加四張嘴了，不是嗎？你的老鼠那些",shape=box,color=blue];
		57 -> 58;
	58 [label="H16h V0l7463: 這個嘛，嚴格來說應該是五張嘴才對，因為還有一隻想吃那些老鼠的巨貓……",shape=box,color=blue];
