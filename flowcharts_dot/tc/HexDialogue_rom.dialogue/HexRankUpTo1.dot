		"HexRankUpTo1 begins." -> j2490411978;
	j2490411978 [label="Broadsword: 我們困在這裡了，懂嗎？自己的垃圾自己收拾，這個美食廣場比外面的街道還髒亂。這裡可不是什麼動物園餒。",shape=box,color=blue];
		j2490411978 -> j3191433849;
