	189 [label="Update boolean HexJoinLunch",color=orange];
		189 -> 90;
	190 [label="Update boolean HexAllLunch",color=orange];
		190 -> 90;
	90 [label="Soldja1Shot1kil: 讓我說完，如果有個男人餓了，但美食廣場那個裹著糖衣的企業廣告一直對我們耳朵疲勞轟炸。想說如果我射爆那個喋喋不休地播放廣告的設備，誰會有意見嗎？",shape=box,color=blue];
		90 -> 91;
	91 [label="xX GLIMMER Xx: 哦哦，讓我砸了它們。我會小心不傷到齊克的！ <RETRO_EMOJI_PUMPEDUP> ",shape=box,color=blue];
		91 -> 92;
	92 [label="Belladonna ~{@: 誒，不要！
我告訴過你我們可能需要把牆外的病患安置在那裡
不能有彈片、不能有碎片
我需要乾淨的空間",shape=box,color=blue];
		92 -> 93;
	93 [label="Salem: 等等，親愛的莉蒂。難道沒人發現嗎？",shape=box,color=blue];
		93 -> 94;
	94 [label="Broadsword: 愛琳，發現什麼？",shape=box,color=blue];
		94 -> 95;
	95 [label="Salem: 在外面包圍商場牆壁的並不是病患，而是好奇的公民，他們似乎覺得這裡……比較安全。",shape=box,color=blue];
		95 -> 96;
	96 [label="H16h V0l7463: 等等等。你的意思是我們……真的有在改善這個地方？",shape=box,color=blue];
		96 -> 97;
		96 -> 98;
		96 -> 99;
	97 [label="當然，我們有。",shape=box,color=red];
		97 -> 191;
	98 [label="我們有。",shape=box,color=red];
		98 -> 192;
	99 [label="我會這麼認為。",shape=box,color=red];
		99 -> 193;
	191 [label="Update boolean HexMakeADiffSure",color=orange];
		191 -> 100;
	192 [label="Update boolean HexMakeADiff",color=orange];
		192 -> 100;
	193 [label="Update boolean HexMakeADiffHope",color=orange];
		193 -> 100;
	100 [label="Broadsword: 我們並不是個壞團──",shape=box,color=blue];
		100 -> 101;
	101 [label="H16h V0l7463: 他打算用那個字眼了",shape=box,color=blue];
		101 -> 102;
	102 [label="Broadsword: ……團隊。",shape=box,color=blue];
		102 -> 103;
	103 [label="Soldja1Shot1kil: 更多張嘴要餵……即使陛下認為我們可以吃飽過好，這不是個好主意",shape=box,color=blue];
		103 -> 104;
	104 [label="Salem: 我可以打發他們。只需要一個念頭……",shape=box,color=blue];
		104 -> 105;
	105 [label="xX GLIMMER Xx: 我不禁覺得……即使我們全力以赴，為什麼我們要給人們一種我們可以拯救他們的錯覺？這對任何一方來說都不會有好結果。",shape=box,color=blue];
		105 -> 106;
		105 -> 107;
		105 -> 108;
	106 [label="如果這不是錯覺呢？",shape=box,color=red];
		106 -> 194;
	107 [label="也許這才是一切真正的意義所在。知道我們可以做出改變。",shape=box,color=red];
		107 -> 195;
	108 [label="現在這裡越多人感受到希望會越好。",shape=box,color=red];
		108 -> 196;
	194 [label="Update boolean HexGiveComfort",color=orange];
		194 -> 109;
	195 [label="Update boolean HexGiveAssurance",color=orange];
		195 -> 109;
	196 [label="Update boolean HexGiveHope",color=orange];
		196 -> 109;
	109 [label="H16h V0l7463: 嗯，不想潑冷水，但我覺得我們這樣是在邀請更多人參加這場失望派對。",shape=box,color=blue];
		109 -> 110;
	110 [label="Salem: 但我們難道就不該讓命運的天秤傾斜另一端嗎？只需要對天秤微微撥動就會發生有趣的事了。",shape=box,color=blue];
		110 -> 111;
	111 [label="Belladonna ~{@: 當然，那我就得負責看護那些流鼻涕和截肢的病患嗎？
我阿姨常說「空腹時不做大決定」
我們約在美食廣場來討論怎麼辦",shape=box,color=blue];
		111 -> 112;
	112 [label="xX GLIMMER Xx: <RETRO_EMOJI_HAPPY2> 哦！團隊聚餐！",shape=box,color=blue];
