	113 [label="Broadsword: 團隊聚餐。",shape=box,color=blue];
		113 -> 114;
	114 [label="Soldja1Shot1kil: 本人會到場。還有大家不必客氣，幫你們開啟了這個討論",shape=box,color=blue];
		114 -> 115;
		114 -> 116;
		114 -> 117;
	115 [label="我很高興我們大家有在一起共事。",shape=box,color=red];
