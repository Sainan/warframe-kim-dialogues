digraph {
	4 [label="HexRankUpTo3 begins.",color=orange];
		4 -> 85;
	85 [label="Soldja1Shot1kil: 話說，如果有個男人餓了……",shape=box,color=blue];
		85 -> 86;
	86 [label="H16h V0l7463: 哈！崑西餓了。我小時候有那樣的圖版遊戲，我打賭我可以──",shape=box,color=blue];
		86 -> 87;
		86 -> 88;
		86 -> 89;
	87 [label="團隊聚餐嗎？",shape=box,color=red];
		87 -> 188;
	88 [label="隨時歡迎陪我一起吃。",shape=box,color=red];
		88 -> 189;
	89 [label="這個美食廣場很大，過來一起吃。",shape=box,color=red];
		89 -> 190;
	188 [label="Update boolean HexTeamLunch",color=orange];
