	"Chat ends. Next chat will be FlareRank3Convo1." [color=orange];
	j2309385012 [label="愛我們嗎……？",shape=box,color=blue];
		j2309385012 -> j3977116554;
		j2309385012 -> j2666816001;
		j2309385012 -> j518451757;
	j3977116554 [label="不，感染者只是必要之惡，僅此而已。",shape=box,color=red];
		j3977116554 -> j1323020718;
	j2666816001 [label="是的。感染者已經成為我所有 Warframe 的一部分。所以……我想是的。",shape=box,color=red];
		j2666816001 -> j2632969715;
	j518451757 [label="或許。感染者是我生命中的一部分，但我還無法確定它是否值得信任。",shape=box,color=red];
		j518451757 -> j1358025037;
	j1323020718 [label="是這樣嗎……？",shape=box,color=blue];
		j1323020718 -> j3805919572;
	j2632969715 [label="不錯嘛……聽到這話，我們可是很高興的，小糖糖",shape=box,color=blue];
		j2632969715 -> j1184298219;
	j1358025037 [label="愚蠢的惡魔，竟然把信任和愛混為一談。",shape=box,color=blue];
		j1358025037 -> j848477420;
	j3805919572 [label="Invoke /Lotus/Scripts/1999/HexSyndicateDialog.lua:SetupJumpScare",color=orange];
		j3805919572 -> j1788160204;
	j1184298219 [label="我們愛你。我們希望你知道。世世代代以來，我們都在注視著你，守護著你……",shape=box,color=blue];
		j1184298219 -> j4172630002;
		j1184298219 -> j1330091858;
	j848477420 [label="我們暫且接受這個答案……但總有一天，我們會再問你的，小糖糖",shape=box,color=blue];
		j848477420 -> j1184298219;
	j1788160204 [label="Boolean FlareJumpScare is now true.",color=orange];
		j1788160204 -> j3271057574;
	j4172630002 [label="怎麼了？",shape=box,color=red];
		j4172630002 -> j3344475654;
	j1330091858 [label="你認真？那些科腐者和 Infested 天天想弄死我，他們可不是這麼說的。",shape=box,color=red];
		j1330091858 -> j3590270618;
	j3344475654 [label="我們為你流血。為你犧牲。為你獻上養分。這樣，這位惡魔滿意了嗎？",shape=box,color=blue];
		j3344475654 -> j2766858465;
		j3344475654 -> j1708685554;
	j3590270618 [label="你生病的時候，你的白血球不是會反過來攻擊你自己嗎？！",shape=box,color=blue];
		j3590270618 -> j3003303941;
	j2766858465 [label="當我以為事情已經夠詭異的時候……",shape=box,color=red];
		j2766858465 -> j3533751941;
	j1708685554 [label="你是 Helminth？！",shape=box,color=red];
		j1708685554 -> j1519551027;
	j3003303941 [label="我們無數，我們亦無盡。我們貫穿時間。我們即萬物。寬恕我們我們未曾察覺的微聲。",shape=box,color=blue];
		j3003303941 -> j3344475654;
	j3533751941 [label="嘿嘿嘿……可悲的惡魔……用偷來的指尖和 Infested 玩具拼湊而來的……",shape=box,color=blue];
		j3533751941 -> j890511285;
	j1519551027 [label="我們皆萬物而我們亦為一",shape=box,color=blue];
		j1519551027 -> j2994600530;
	j890511285 [label="曾經孤寂，孤寂不再",shape=box,color=blue];
		j890511285 -> j1944186961;
	j2994600530 [label="但別恐懼",shape=box,color=blue];
		j2994600530 -> j1450615299;
	j1944186961 [label="我們為你感到喜悅",shape=box,color=blue];
		j1944186961 -> j2292687131;
	j1450615299 [label="我們。愛。你。始終如一",shape=box,color=blue];
		j1450615299 -> j2292687131;
	j2292687131 [label="這就是我們向你懇求的理由……不……我們是在哀求……",shape=box,color=blue];
		j2292687131 -> j33588298;
	j33588298 [label="這傢伙是我們的",shape=box,color=blue];
		j33588298 -> j2591173397;
	j2591173397 [label="讓我們帶走他們……",shape=box,color=blue];
		j2591173397 -> j1704814884;
	j1704814884 [label="求求你，好不好……？",shape=box,color=blue];
		j1704814884 -> j2214311502;
		j1704814884 -> j2207125436;
		j1704814884 -> j2362142004;
	j2214311502 [label="你所說的「帶走」是什麼意思？就像瘋狂吞噬其他 Warframe 一樣嗎？",shape=box,color=red];
		j2214311502 -> j3707229033;
	j2207125436 [label="如果他們不願意，那就沒門。",shape=box,color=red];
		j2207125436 -> j2396295314;
	j2362142004 [label="我……不行。很抱歉，我不能讓你「帶走」弗烈爾。",shape=box,color=red];
		j2362142004 -> j2049935900;
	j3707229033 [label="不行！！當然不能！！！我們不可能對他們做出這種事，特別是在 博士以那種方式對待過他們之後",shape=box,color=blue];
		j3707229033 -> j2634319007;
	j2396295314 [label="那你必須說服他們，讓他們相信我們並無惡意！！",shape=box,color=blue];
		j2396295314 -> j2855652007;
		j2396295314 -> j3617585271;
	j2049935900 [label="不行！他們是我們的！你不能讓他們把我們噤聲！！！",shape=box,color=blue];
		j2049935900 -> j3805919572;
	j2634319007 [label="但我們同樣不願離開他們！！！",shape=box,color=blue];
		j2634319007 -> j1592813535;
	j2855652007 [label="你該不會是打算讓他們像其他 Warframe 那樣瘋掉吧……",shape=box,color=red];
		j2855652007 -> j1049847234;
	j3617585271 [label="我不清楚……但吞噬他們的靈魂聽起來不是什麼好事。",shape=box,color=red];
		j3617585271 -> j2281865182;
	j1592813535 [label="不要讓他們把我們噤聲！！",shape=box,color=blue];
		j1592813535 -> j1735473864;
