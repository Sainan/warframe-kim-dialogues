		j1998580100 -> j2517669187;
	j1194199747 [label="+5 Chemistry",color=orange];
		j1194199747 -> j2167810092;
	j3636561706 [label="我突然冒出來，然後還把別人的事攪得亂七八糟，對吧？",shape=box,color=blue];
		j3636561706 -> j3451175025;
		j3636561706 -> j798151202;
	j3501201848 [label="我等不及要把它們都寫進我的音樂中",shape=box,color=blue];
		j3501201848 -> j3717043132;
	j3548292951 [label="有天某個鬼祟的小傢伙打電話來，拚命撐場面擺出一副了不起的樣子，好像非得證明點什麼似的",shape=box,color=blue];
		j3548292951 -> j320327940;
	j2517669187 [label="它就像一直待在角落，死死地盯著我，沒停過",shape=box,color=blue];
		j2517669187 -> j4159113524;
	j2167810092 [label="啊，抱歉，我不是這個意思——只是覺得自己像個沒受邀卻硬闖進派對的傢伙",shape=box,color=blue];
		j2167810092 -> j3636561706;
	j3451175025 [label="看看周圍吧，霍爾瓦尼亞在你出現前就已經是一團糟了。",shape=box,color=red];
		j3451175025 -> j4194834058;
	j798151202 [label="磚頭可沒自己要求被扔出去的，對吧？",shape=box,color=red];
		j798151202 -> j3332982139;
	j3717043132 [label="不知道我能不能教他們玩樂器……",shape=box,color=blue];
		j3717043132 -> j619938223;
	j320327940 [label="他一直在跟我們吹噓自己有多重要，又說這座城市正在「墮落」和「失去信仰」，還說我們應該「幫助他完成他的偉大事業，讓城市回到正軌」",shape=box,color=blue];
		j320327940 -> j3338387550;
	j4159113524 [label="無眼無瞼，卻總是在盯著你，空洞、*飢渴著*",shape=box,color=blue];
		j4159113524 -> j721120776;
	j4194834058 [label="嗯，確實。畢竟破碎了的東西又怎麼能再被打碎一次呢",shape=box,color=blue];
		j4194834058 -> j1604400847;
	j3332982139 [label="不是啦，但它確實把自己變成挺趁手的鈍器，對吧？",shape=box,color=blue];
