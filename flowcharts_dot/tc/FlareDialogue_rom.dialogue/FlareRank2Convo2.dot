		536 -> 538;
	537 [label="站在舞台上，那個新我感覺就像……活了過來，真真正正地活著，比以往任何時候都更貼近最真實的自己。那種感覺太美妙了，像是徹底解放了一樣。我感覺自己在飛翔",shape=box,color=blue];
		537 -> 539;
	538 [label="什麼？",shape=box,color=blue];
		538 -> 540;
	539 [label="我們在霍爾瓦尼亞舉辦了一場所有人都絕不會忘記的演出。那個混蛋想讓我們給他們希望？信念？我們做到了，我們讓他們相信自己",shape=box,color=blue];
		539 -> 541;
	540 [label="別管那個了，繼續。",shape=box,color=red];
