		j1102968054 -> j4209175865;
		j1102968054 -> j3539549768;
	j1901433257 [label="我控制不到",shape=box,color=blue];
		j1901433257 -> j1056636723;
	j3160540952 [label="這些怪物難道沒聽說過有*三明治*這種東西嗎？！",shape=box,color=blue];
		j3160540952 -> j1289783194;
	j4209175865 [label="噢。",shape=box,color=red];
		j4209175865 -> j1363683826;
	j3539549768 [label="你被科腐感染了？",shape=box,color=red];
		j3539549768 -> j1363683826;
	j1056636723 [label="事情是這樣發生的，當她——",shape=box,color=blue];
		j1056636723 -> j3332311958;
	j1289783194 [label="*而且*她還一直*纏著*我要我餵她各種奇奇怪怪的東西，像是——",shape=box,color=blue];
		j1289783194 -> j1193962601;
	j1363683826 [label="0/5 顆星，絕不推薦，再也不想來。當我癱在巡演巴士上時，突然有人來敲門",shape=box,color=blue];
		j1363683826 -> j2289430064;
