		j2036220992 -> j22270874;
	j1276722824 [label="叮叮叮。",shape=box,color=blue];
		j1276722824 -> j290833166;
	j290833166 [label="呿，你也知道劇本的套路了。神秘的奇蹟療法？還說什麼會讓我成為前所未見世界級的藝人……",shape=box,color=blue];
		j290833166 -> j1387201720;
	j22270874 [label="不，太空旅者……那是莉慈……",shape=box,color=blue];
		j22270874 -> j215965356;
	j1387201720 [label="諸如此類，諸如此類。",shape=box,color=blue];
		j1387201720 -> j4157059729;
	j215965356 [label="她是我的吉他……",shape=box,color=blue];
		j215965356 -> j3967982912;
	j4157059729 [label="那個小雜碎想要一場演唱會？好啊，他如願以償了。我的舞台形象本來就……挺瘋的",shape=box,color=blue];
		j4157059729 -> j3189823622;
	j3967982912 [label="而且……她想要徹底吞噬我靈魂中殘存的部分……",shape=box,color=blue];
