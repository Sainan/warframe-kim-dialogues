		457 -> 461;
	462 [label="我不知道，真的不知道……但如果我們有這樣做的話，事情也許……真的會發生。所以最好別提",shape=box,color=blue];
		462 -> 466;
		462 -> 467;
	463 [label="就像一塊磚頭砸穿了別人溫室的屋頂一樣",shape=box,color=blue];
