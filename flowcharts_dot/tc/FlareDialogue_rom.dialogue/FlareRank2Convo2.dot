	548 [label="那個雜碎打算搞一場屬於他的表演，不管用的是什麼手段。但這次？不再是演唱會了",shape=box,color=blue];
		548 -> 550;
	549 [label="我根本無法阻止他們，他們人數太多了，我一個人根本無力應對。但你……我看你宛如砍瓜切菜一般對付他們……",shape=box,color=blue];
