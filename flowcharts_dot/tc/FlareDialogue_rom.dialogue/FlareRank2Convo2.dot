	483 [label="他還真以為自己知道在跟誰說話。最好笑的部分？他還自稱是個*粉絲*",shape=box,color=blue];
		483 -> 488;
	489 [label="它在等待，等我眨眼，等我瞥一眼，等我稍微放鬆警戒，然後就會襲擊",shape=box,color=blue];
		489 -> 497;
	490 [label="可我還是不禁覺得，我只是讓事情變得越來越糟，而不是變好",shape=box,color=blue];
		490 -> 498;
	491 [label="但我懂你的意思",shape=box,color=blue];
		491 -> 499;
	492 [label="我可有確實的情報顯示亞瑟會唱歌。",shape=box,color=red];
		492 -> 500;
	493 [label="我敢肯定，葵會*毫不猶豫*地加入你。",shape=box,color=red];
		493 -> 501;
	495 [label="虛空老天啊，我腦補了一下他們湊成一支樂隊的場景，真的快笑死。",shape=box,color=red];
		495 -> 501;
	494 [label="我……衷心祝你好運。",shape=box,color=red];
		494 -> 502;
	488 [label="這世界上最糟糕的事，莫過於看著那些蠢貨曲解你的話來達成他們的目的",shape=box,color=blue];
		488 -> 496;
	497 [label="就像鯊魚嗅到水中的血腥味……",shape=box,color=blue];
		497 -> 504;
		497 -> 505;
	498 [label="都是因為我讓自己成了源拓氏的工具。我想獲得力量，我想讓那個混帳明白他無法殺死音樂",shape=box,color=blue];
		498 -> 506;
	499 [label="我確實被利用了，但我自己也默許了。我滿腦子都是怒火，我要讓那個混蛋知道，音樂不死",shape=box,color=blue];
		499 -> 506;
	500 [label="他完全沒有當伴音的氣質，但鬼才知道會不會是個例外",shape=box,color=blue];
		500 -> 502;
	501 [label="畫面也太可愛了吧",shape=box,color=blue];
		501 -> 502;
	502 [label="只是白日夢罷了……",shape=box,color=blue];
		502 -> 507;
	496 [label="所以，我們毫不猶豫就答應了，主要是為了讓那個小雜碎抓狂，讓他明白自己其實根本沒什麼了不起",shape=box,color=blue];
		496 -> 503;
	504 [label="慢著，冷靜點，你到底在說些什麼？",shape=box,color=red];
		504 -> 509;
	505 [label="好吧，弗烈爾，你有點嚇到我了。",shape=box,color=red];
