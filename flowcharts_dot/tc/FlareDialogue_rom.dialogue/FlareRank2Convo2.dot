		468 -> 474;
	469 [label="哈哈哈。這是什麼意思？",shape=box,color=red];
		469 -> 475;
	470 [label="我可以閒著沒事盯著他們看好幾天。反正，也沒別的事情可做。哈哈。",shape=box,color=blue];
		470 -> 476;
