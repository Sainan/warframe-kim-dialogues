	j3189823622 [label="我一直都是開足馬力，把音量推到最大",shape=box,color=blue];
		j3189823622 -> j38302740;
	"Chat ends. Next chat will be FlareRank2Convo3." [color=orange];
	j38302740 [label="可是現在？此時此刻？我感覺就像飆上雲端，靠著某種我聽都*沒聽過的*燃料推動著",shape=box,color=blue];
		j38302740 -> j2926662879;
		j38302740 -> j1143001555;
	j2926662879 [label="然後呢？",shape=box,color=red];
		j2926662879 -> j3472660417;
	j1143001555 [label="虛空可是劑猛藥啊。",shape=box,color=red];
		j1143001555 -> j2741569630;
	j3472660417 [label="站在舞台上，那個新我感覺就像……活了過來，真真正正地活著，比以往任何時候都更貼近最真實的自己。那種感覺太美妙了，像是徹底解放了一樣。我感覺自己在飛翔",shape=box,color=blue];
		j3472660417 -> j2483305833;
	j2741569630 [label="什麼？",shape=box,color=blue];
		j2741569630 -> j3108702926;
	j2483305833 [label="我們在霍爾瓦尼亞舉辦了一場所有人都絕不會忘記的演出。那個混蛋想讓我們給他們希望？信念？我們做到了，我們讓他們相信自己",shape=box,color=blue];
		j2483305833 -> j3207309858;
	j3108702926 [label="別管那個了，繼續。",shape=box,color=red];
		j3108702926 -> j3472660417;
	j3207309858 [label="然後我們就看到他們在掀翻清剿隊的卡車，還在推倒雕像，哈哈哈",shape=box,color=blue];
		j3207309858 -> j3983859811;
	j3983859811 [label="那小混蛋氣得跳腳……",shape=box,color=blue];
		j3983859811 -> j2449670289;
	j2449670289 [label="早該料到這種事不可能沒代價……",shape=box,color=blue];
		j2449670289 -> j249686592;
	j249686592 [label="嗯……他們……",shape=box,color=blue];
		j249686592 -> j4135773728;
		j249686592 -> j3484278943;
	j4135773728 [label="我聽說了。",shape=box,color=red];
		j4135773728 -> j1826230423;
	j3484278943 [label="出了什麼事……？",shape=box,color=red];
		j3484278943 -> j306061032;
	j1826230423 [label="嗯。",shape=box,color=blue];
		j1826230423 -> j1548427449;
	j306061032 [label="那個雜碎打算搞一場屬於他的表演，不管用的是什麼手段。但這次？不再是演唱會了",shape=box,color=blue];
		j306061032 -> j4272459781;
	j1548427449 [label="我根本無法阻止他們，他們人數太多了，我一個人根本無力應對。但你……我看你宛如砍瓜切菜一般對付他們……",shape=box,color=blue];
		j1548427449 -> j4186550147;
	j4272459781 [label="這種戲碼還真是一生一次……",shape=box,color=blue];
		j4272459781 -> j1548427449;
	j4186550147 [label="我這副模樣活像隻剛出生的長頸鹿，還在摸索怎麼控制自己的腿",shape=box,color=blue];
		j4186550147 -> j4280386729;
	j4280386729 [label="我什麼都做不了……只能眼睜睜看著他們死去……",shape=box,color=blue];
		j4280386729 -> j63597382;
	j63597382 [label="那個混蛋還在全國電視台直播這一切……",shape=box,color=blue];
		j63597382 -> j3481278809;
	j3481278809 [label="他還得意洋洋地吹噓著這收視率，像這有什麼值得驕傲似的……",shape=box,color=blue];
		j3481278809 -> j194728520;
	j194728520 [label="看來她會這樣做也不奇怪……",shape=box,color=blue];
		j194728520 -> j1387958894;
	j1387958894 [label="吞噬所有的仇恨、哀傷和怒火",shape=box,color=blue];
