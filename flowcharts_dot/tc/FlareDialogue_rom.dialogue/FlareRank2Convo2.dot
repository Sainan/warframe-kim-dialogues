		j619938223 -> j4168947428 [label=false,color=brown];
		j619938223 -> j710778043 [label=false,color=brown];
	j3338387550 [label="他還真以為自己知道在跟誰說話。最好笑的部分？他還自稱是個*粉絲*",shape=box,color=blue];
		j3338387550 -> j2700245633;
	j721120776 [label="它在等待，等我眨眼，等我瞥一眼，等我稍微放鬆警戒，然後就會襲擊",shape=box,color=blue];
		j721120776 -> j1837342385;
	j1604400847 [label="可我還是不禁覺得，我只是讓事情變得越來越糟，而不是變好",shape=box,color=blue];
		j1604400847 -> j2345843603;
	j2692019982 [label="但我懂你的意思",shape=box,color=blue];
		j2692019982 -> j2518545178;
	j3500735835 [label="我可有確實的情報顯示亞瑟會唱歌。",shape=box,color=red];
		j3500735835 -> j126304524;
	j2233409429 [label="我敢肯定，葵會*毫不猶豫*地加入你。",shape=box,color=red];
		j2233409429 -> j2201636134;
	j710778043 [label="虛空老天啊，我腦補了一下他們湊成一支樂隊的場景，真的快笑死。",shape=box,color=red];
		j710778043 -> j2201636134;
	j4168947428 [label="我……衷心祝你好運。",shape=box,color=red];
		j4168947428 -> j2303212501;
	j2700245633 [label="這世界上最糟糕的事，莫過於看著那些蠢貨曲解你的話來達成他們的目的",shape=box,color=blue];
		j2700245633 -> j3668191840;
	j1837342385 [label="就像鯊魚嗅到水中的血腥味……",shape=box,color=blue];
		j1837342385 -> j2102780743;
		j1837342385 -> j2808445544;
	j2345843603 [label="都是因為我讓自己成了源拓氏的工具。我想獲得力量，我想讓那個混帳明白他無法殺死音樂",shape=box,color=blue];
		j2345843603 -> j1027785013;
	j2518545178 [label="我確實被利用了，但我自己也默許了。我滿腦子都是怒火，我要讓那個混蛋知道，音樂不死",shape=box,color=blue];
		j2518545178 -> j1027785013;
	j126304524 [label="他完全沒有當伴音的氣質，但鬼才知道會不會是個例外",shape=box,color=blue];
		j126304524 -> j2303212501;
	j2201636134 [label="畫面也太可愛了吧",shape=box,color=blue];
		j2201636134 -> j2303212501;
	j2303212501 [label="只是白日夢罷了……",shape=box,color=blue];
		j2303212501 -> j2771027800;
	j3668191840 [label="所以，我們毫不猶豫就答應了，主要是為了讓那個小雜碎抓狂，讓他明白自己其實根本沒什麼了不起",shape=box,color=blue];
		j3668191840 -> j638995766;
	j2102780743 [label="慢著，冷靜點，你到底在說些什麼？",shape=box,color=red];
		j2102780743 -> j1361766884;
	j2808445544 [label="好吧，弗烈爾，你有點嚇到我了。",shape=box,color=red];
		j2808445544 -> j397749695;
	j1027785013 [label="但是……容我回答你的問題，我……慢慢習慣了",shape=box,color=blue];
		j1027785013 -> j2176914359;
	j2771027800 [label="我現在還是二重唱……但如果她如願，我很快就會變成獨唱了……",shape=box,color=blue];
		j2771027800 -> j435276984;
		j2771027800 -> j2808445544;
	j638995766 [label="早知道就該相信那些八卦雜誌寫的關於那場詭異瘟疫的事了",shape=box,color=blue];
		j638995766 -> j1102968054;
	j1361766884 [label="我很抱歉……",shape=box,color=blue];
		j1361766884 -> j1901433257;
	j397749695 [label="你不是唯一有被嚇倒的",shape=box,color=blue];
		j397749695 -> j1361766884;
	j2176914359 [label="老實說，就算從此不再吃披薩，我也覺得人生無憾了",shape=box,color=blue];
		j2176914359 -> j3160540952;
	j435276984 [label="我該就這樣一直無視它嗎？",shape=box,color=red];
