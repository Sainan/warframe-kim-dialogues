	473 [label="我*不想*這麼做，但是我不知道還能怎麼做，旅行者。 ",shape=box,color=blue];
		473 -> 478;
	474 [label="+5 Chemistry",color=orange];
		474 -> 479;
	475 [label="我突然冒出來，然後還把別人的事攪得亂七八糟，對吧？",shape=box,color=blue];
		475 -> 480;
		475 -> 481;
	476 [label="我等不及要把它們都寫進我的音樂中",shape=box,color=blue];
		476 -> 482;
	471 [label="有天某個鬼祟的小傢伙打電話來，拚命撐場面擺出一副了不起的樣子，好像非得證明點什麼似的",shape=box,color=blue];
		471 -> 477;
	478 [label="它就像一直待在角落，死死地盯著我，沒停過",shape=box,color=blue];
		478 -> 484;
	479 [label="啊，抱歉，我不是這個意思——只是覺得自己像個沒受邀卻硬闖進派對的傢伙",shape=box,color=blue];
		479 -> 475;
	480 [label="看看周圍吧，霍爾瓦尼亞在你出現前就已經是一團糟了。",shape=box,color=red];
		480 -> 485;
	481 [label="磚頭可沒自己要求被扔出去的，對吧？",shape=box,color=red];
		481 -> 486;
	482 [label="不知道我能不能教他們玩樂器……",shape=box,color=blue];
		482 -> 487;
	477 [label="他一直在跟我們吹噓自己有多重要，又說這座城市正在「墮落」和「失去信仰」，還說我們應該「幫助他完成他的偉大事業，讓城市回到正軌」",shape=box,color=blue];
		477 -> 483;
	484 [label="無眼無瞼，卻總是在盯著你，空洞、*飢渴著*",shape=box,color=blue];
		484 -> 489;
