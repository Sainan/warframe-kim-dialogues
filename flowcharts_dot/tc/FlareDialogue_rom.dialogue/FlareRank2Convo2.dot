		j1296696802 -> j2981769817;
	j460337622 [label="你一開始是怎麼捲入這場爛攤子的？",shape=box,color=red];
		j460337622 -> j2237729055;
	j2162394050 [label="我不知道，真的不知道……但如果我們有這樣做的話，事情也許……真的會發生。所以最好別提",shape=box,color=blue];
