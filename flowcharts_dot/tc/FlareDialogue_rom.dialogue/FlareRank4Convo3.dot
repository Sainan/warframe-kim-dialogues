	j4082731691 [label="什麼意思？",shape=box,color=red];
		j4082731691 -> j1559172558;
	j3289036967 [label="嘿，弗烈爾。",shape=box,color=red];
		j3289036967 -> j2476638869;
	j1559172558 [label="不好意思，今天有點憂鬱。我一早醒來，就湧起一種好久不曾感受過的心情",shape=box,color=blue];
		j1559172558 -> j184692820;
	j2476638869 [label="嘿。",shape=box,color=blue];
		j2476638869 -> j1559172558;
	j184692820 [label="我搞不清楚是樂隊的死讓我如此痛苦……還是因為*她*的這件事或者什麼的……",shape=box,color=blue];
		j184692820 -> j324177621;
	j324177621 [label="Check boolean FlareLizzieEnemy",color=orange];
		j324177621 -> j2044913128 [label=true,color=green];
		j324177621 -> j240275519 [label=false,color=brown];
		j324177621 -> j301372479 [label=false,color=brown];
		j324177621 -> j2017332321 [label=false,color=brown];
	j2044913128 [label="關於莉慈……我覺得我可能*真的*把她惹火了。 :|",shape=box,color=red];
		j2044913128 -> j2980548461;
	j240275519 [label="哎呀，一路走來誰不滿身傷痕？你並不孤單。",shape=box,color=red];
		j240275519 -> j4001675314;
	j301372479 [label="你現在狀態有點混亂是很正常的，沒關係。",shape=box,color=red];
		j301372479 -> j2522531520;
	j2017332321 [label="如果你想要找人聊聊的話，我在這裡。",shape=box,color=red];
		j2017332321 -> j1537216579;
	j2980548461 [label="我懂……相信我，我真的懂",shape=box,color=blue];
		j2980548461 -> j3402290263;
	j4001675314 [label="+5 Chemistry",color=orange];
		j4001675314 -> j1645356398;
	j2522531520 [label="大概吧，但誰不是呢？",shape=box,color=blue];
		j2522531520 -> j1113460886;
	j1537216579 [label="+5 Chemistry",color=orange];
		j1537216579 -> j2240624550;
	j3402290263 [label="從那時候開始她就沒停過對我發火",shape=box,color=blue];
		j3402290263 -> j975435183;
	j1645356398 [label="呵呵，看看我們這支雜牌軍……",shape=box,color=blue];
		j1645356398 -> j1599847322;
	j1113460886 [label="說到底，應該沒幾個人會像我這樣，整天跟個專吃靈魂的怪物糾纏吧",shape=box,color=blue];
		j1113460886 -> j975435183;
	j2240624550 [label="謝謝",shape=box,color=blue];
		j2240624550 -> j975435183;
	j975435183 [label="我今天起床時，那股熟悉的恐懼又回來了……那種自年少以來就不曾有過的恐懼",shape=box,color=blue];
		j975435183 -> j1762953721;
	j1599847322 [label="說真的，這個名字其實蠻適合當樂隊名的",shape=box,color=blue];
		j1599847322 -> j786305117;
	j1762953721 [label="不是那種「哦，太棒了，今天我死定了」的恐懼",shape=box,color=blue];
		j1762953721 -> j3099815421;
	j786305117 [label="我扯遠了",shape=box,color=blue];
		j786305117 -> j975435183;
	j3099815421 [label="更不是你每天見怪不怪的那種麻煩，說起來都覺得自己有點無病呻吟",shape=box,color=blue];
		j3099815421 -> j1381112441;
	j1381112441 [label="但是……我甚至不知道你是否能理解……",shape=box,color=blue];
		j1381112441 -> j1232489534;
	j1232489534 [label="但有時候，我一睜開眼，就覺得我自己已經不再知道世界對我有什麼期待了……",shape=box,color=blue];
		j1232489534 -> j1351427326;
	j1351427326 [label="無論我成為什麼，都不夠好。無論我有多努力，都無法符合標準",shape=box,color=blue];
		j1351427326 -> j2034460064;
	j2034460064 [label="我人生的每一天，無論我走到哪裡，世界都沒有停止向我灌輸我*該*成怎樣的人",shape=box,color=blue];
		j2034460064 -> j1616329489;
	j1616329489 [label="前幾天，我看到一個健身達人走在街上",shape=box,color=blue];
		j1616329489 -> j3031409604;
	j3031409604 [label="無可挑剔的身材，穿著一身完美剪裁的衣服與緊身背心。那屁股緊得像是能把一枚金幣彈回來，還會找零那種",shape=box,color=blue];
		j3031409604 -> j1012889685;
	j1012889685 [label="他們渾身上下都散發著優雅、地位、自信與財富。他們的手錶可能比我一整年的薪水還要貴",shape=box,color=blue];
		j1012889685 -> j3314796173;
	j3314796173 [label="太尊在上，我是那麼渴望擁有它們，多麼渴望成為他們……",shape=box,color=blue];
		j3314796173 -> j3761556862;
	j3761556862 [label="我說的就是這個意思",shape=box,color=blue];
		j3761556862 -> j4017348511;
	j4017348511 [label="「要有這種外表」「要有這種舉止」「要有這種感受」「必須成為這樣的人」——否則，你就毫無價值",shape=box,color=blue];
		j4017348511 -> j856073647;
	j856073647 [label="迎合世界的期望，明明感覺這樣錯得離譜。但即使沒這種感覺？那又有什麼意義……我知道自己註定會失敗……但若什麼都不做呢？……月尊啊，這份孤獨像座無形的巨石，壓得我有時候連起床的力氣都沒有",shape=box,color=blue];
		j856073647 -> j817384396;
	j817384396 [label="對不起……",shape=box,color=blue];
		j817384396 -> j2009392684;
	j2009392684 [label="這對你來說大概全都是胡言亂語吧",shape=box,color=blue];
		j2009392684 -> j2886766133;
	j2886766133 [label="我是說，看看我們——看看*我*，親愛的——我們簡直是兩個世界的人……",shape=box,color=blue];
		j2886766133 -> j3053379404;
		j2886766133 -> j2271974288;
		j2886766133 -> j1774070954;
		j2886766133 -> j908151491;
	j3053379404 [label="其實不完全是。",shape=box,color=red];
		j3053379404 -> j1948288851;
	j2271974288 [label="我能同理，但無法真正感同身受……",shape=box,color=red];
		j2271974288 -> j997568037;
	j1774070954 [label="我覺得……不管因為什麼，我們都曾經歷過類似的感受，只是程度不同而已",shape=box,color=red];
		j1774070954 -> j2133922543;
	j908151491 [label="不，我完全能理解。相信我。",shape=box,color=red];
		j908151491 -> j2133922543;
	j1948288851 [label="這倒也是",shape=box,color=blue];
		j1948288851 -> j46747866;
