	j1992381639 [label="我也說不上來為什麼這玩意兒會讓我如此害怕",shape=box,color=blue];
		j1992381639 -> j1148947073;
	j1148947073 [label="這類荒唐事我不是沒見過……只是，這次荒唐得有點過頭了",shape=box,color=blue];
