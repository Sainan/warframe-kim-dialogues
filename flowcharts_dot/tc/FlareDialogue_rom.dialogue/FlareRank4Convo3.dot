		j3310042363 -> j2032793094;
	j1289715486 [label="抱歉，抱歉，這是個爛笑話。亞瑟總是提醒我黑色幽默只能用在合適的時機。",shape=box,color=red];
		j1289715486 -> j4033589812;
	j4272725751 [label="我以前總覺得，所有音樂家都寧願在巔峰時死去，而不是等到才華枯竭、聲名衰退時",shape=box,color=blue];
		j4272725751 -> j3371660354;
	j2032793094 [label="當然",shape=box,color=blue];
		j2032793094 -> j3968996345;
	j4033589812 [label="幾百年來的孤寂與一次又一次的處決，讓我的「諷刺閥門」徹底壞掉了，正如葵說的那樣。畢竟，這是我唯一能夠用來反抗的東西。",shape=box,color=red];
		j4033589812 -> j3519852708;
	j3371660354 [label="我還以為那是我的宿命，某種說不清的安排。媽的，我錯透了。",shape=box,color=blue];
		j3371660354 -> j2948837568;
	j3519852708 [label="所以，我完全不知道該怎麼讓它停下來，當——",shape=box,color=red];
		j3519852708 -> j1799230450;
	j2948837568 [label="但……我想我確實一直想成為某個更偉大事物的一部分，畢竟，我總覺得自己不屬於任何地方。你是說，她正是在針對我這點嗎？",shape=box,color=blue];
		j2948837568 -> j1397854697;
		j2948837568 -> j3861879403;
	j1799230450 [label="別再打字了",shape=box,color=blue];
		j1799230450 -> j1797079851;
	j1397854697 [label="我想是的，而且是最可怕的那種方式。",shape=box,color=red];
		j1397854697 -> j1928868798;
	j3861879403 [label="她是你的一部分。她能感受到那份痛苦，那份渴望。我覺得她正在試圖「修補」它。",shape=box,color=red];
		j3861879403 -> j1928868798;
