		1276 -> 1280 [label=false,color=brown];
	1278 [label="關於莉慈……我覺得我可能*真的*把她惹火了。 :|",shape=box,color=red];
		1278 -> 1282;
	1277 [label="哎呀，一路走來誰不滿身傷痕？你並不孤單。",shape=box,color=red];
		1277 -> 1281;
	1279 [label="你現在狀態有點混亂是很正常的，沒關係。",shape=box,color=red];
