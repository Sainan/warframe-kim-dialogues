		j3584494245 -> j2127465569;
	j2006708735 [label="使你成為宇宙整體的一環。",shape=box,color=red];
		j2006708735 -> j3684732055;
	j751426403 [label="你置身於熙熙攘攘的商場，身邊圍繞著人群，你並不孤單，你可以結交朋友。",shape=box,color=red];
		j751426403 -> j2588408437;
