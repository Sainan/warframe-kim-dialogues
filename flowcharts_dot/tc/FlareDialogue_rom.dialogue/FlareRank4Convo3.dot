	1280 [label="如果你想要找人聊聊的話，我在這裡。",shape=box,color=red];
		1280 -> 1284;
	1282 [label="我懂……相信我，我真的懂",shape=box,color=blue];
		1282 -> 1286;
	1281 [label="+5 Chemistry",color=orange];
		1281 -> 1285;
