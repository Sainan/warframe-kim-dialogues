	1285 [label="呵呵，看看我們這支雜牌軍……",shape=box,color=blue];
		1285 -> 1289;
	1287 [label="說到底，應該沒幾個人會像我這樣，整天跟個專吃靈魂的怪物糾纏吧",shape=box,color=blue];
		1287 -> 1290;
	1288 [label="謝謝",shape=box,color=blue];
		1288 -> 1290;
	1290 [label="我今天起床時，那股熟悉的恐懼又回來了……那種自年少以來就不曾有過的恐懼",shape=box,color=blue];
		1290 -> 1292;
	1289 [label="說真的，這個名字其實蠻適合當樂隊名的",shape=box,color=blue];
		1289 -> 1291;
	1292 [label="不是那種「哦，太棒了，今天我死定了」的恐懼",shape=box,color=blue];
		1292 -> 1293;
	1291 [label="我扯遠了",shape=box,color=blue];
		1291 -> 1290;
	1293 [label="更不是你每天見怪不怪的那種麻煩，說起來都覺得自己有點無病呻吟",shape=box,color=blue];
		1293 -> 1294;
	1294 [label="但是……我甚至不知道你是否能理解……",shape=box,color=blue];
		1294 -> 1295;
	1295 [label="但有時候，我一睜開眼，就覺得我自己已經不再知道世界對我有什麼期待了……",shape=box,color=blue];
		1295 -> 1296;
	1296 [label="無論我成為什麼，都不夠好。無論我有多努力，都無法符合標準",shape=box,color=blue];
		1296 -> 1297;
	1297 [label="我人生的每一天，無論我走到哪裡，世界都沒有停止向我灌輸我*該*成怎樣的人",shape=box,color=blue];
		1297 -> 1298;
	1298 [label="前幾天，我看到一個健身達人走在街上",shape=box,color=blue];
		1298 -> 1299;
	1299 [label="無可挑剔的身材，穿著一身完美剪裁的衣服與緊身背心。那屁股緊得像是能把一枚金幣彈回來，還會找零那種",shape=box,color=blue];
		1299 -> 1300;
	1300 [label="他們渾身上下都散發著優雅、地位、自信與財富。他們的手錶可能比我一整年的薪水還要貴",shape=box,color=blue];
		1300 -> 1301;
	1301 [label="太尊在上，我是那麼渴望擁有它們，多麼渴望成為他們……",shape=box,color=blue];
		1301 -> 1302;
	1302 [label="我說的就是這個意思",shape=box,color=blue];
		1302 -> 1303;
	1303 [label="「要有這種外表」「要有這種舉止」「要有這種感受」「必須成為這樣的人」——否則，你就毫無價值",shape=box,color=blue];
		1303 -> 1304;
	1304 [label="迎合世界的期望，明明感覺這樣錯得離譜。但即使沒這種感覺？那又有什麼意義……我知道自己註定會失敗……但若什麼都不做呢？……月尊啊，這份孤獨像座無形的巨石，壓得我有時候連起床的力氣都沒有",shape=box,color=blue];
		1304 -> 1305;
	1305 [label="對不起……",shape=box,color=blue];
		1305 -> 1306;
	1306 [label="這對你來說大概全都是胡言亂語吧",shape=box,color=blue];
		1306 -> 1307;
	1307 [label="我是說，看看我們——看看*我*，親愛的——我們簡直是兩個世界的人……",shape=box,color=blue];
