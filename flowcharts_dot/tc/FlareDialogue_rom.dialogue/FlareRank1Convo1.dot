digraph {
	"FlareRank1Convo1 begins." [color=orange];
		"FlareRank1Convo1 begins." -> j3993105092;
	j3993105092 [label="嘿，太空旅者",shape=box,color=blue];
		j3993105092 -> j3733279965;
		j3993105092 -> j497869996;
	j3733279965 [label="噢，嗨。弗烈爾，是嗎？",shape=box,color=red];
		j3733279965 -> j4165428687;
	j497869996 [label="嘿。怎麼樣？",shape=box,color=red];
		j497869996 -> j1729952140;
	j4165428687 [label="你就是其他實驗品跟我提過的那個人，對吧？",shape=box,color=blue];
		j4165428687 -> j2276261959;
		j4165428687 -> j3627994992;
	j1729952140 [label="閒著沒事，我正好有些問題想問你，不知道你是否有空",shape=box,color=blue];
		j1729952140 -> j3802942135;
		j1729952140 -> j2408825621;
		j1729952140 -> j1329149933;
	j2276261959 [label="我很難想像這裡會有兩個我。不過，說來話長。總之情況就是這樣。",shape=box,color=red];
		j2276261959 -> j3307764075;
	j3627994992 [label="這得看他們說了什麼。不過大概是吧。",shape=box,color=red];
		j3627994992 -> j251532324;
	j3802942135 [label="閒著沒事，所以你選擇來動物園敲玻璃找點樂子。挺不錯的嘛。",shape=box,color=red];
		j3802942135 -> j2803405116;
	j2408825621 [label="哎喲，居然無聊到來找我，這讓我覺得有點榮幸啊，哈哈。",shape=box,color=red];
		j2408825621 -> j3535717414;
	j1329149933 [label="想問什麼就問吧，我就在這裡。",shape=box,color=red];
		j1329149933 -> j1653300807;
	j3307764075 [label="好，他們已經跟我說過大致情況了。",shape=box,color=blue];
		j3307764075 -> j3457559437;
	j251532324 [label="好吧……",shape=box,color=blue];
		j251532324 -> j1871992056;
		j251532324 -> j3167173291;
	j2803405116 [label="+5 Chemistry",color=orange];
		j2803405116 -> j906614336;
	j3535717414 [label="哎呀，抱歉，剛才表達得不太對。",shape=box,color=blue];
		j3535717414 -> j302065988;
	j1653300807 [label="太好了",shape=box,color=blue];
		j1653300807 -> j302065988;
	j3457559437 [label="阿米爾……說得挺詳細，而且速度還挺快的。",shape=box,color=blue];
		j3457559437 -> j39294564;
	j1871992056 [label="你是來動物園敲玻璃找樂子的嗎？",shape=box,color=red];
		j1871992056 -> j657328373;
	j3167173291 [label="有什麼我可以幫你的？",shape=box,color=red];
		j3167173291 -> j302065988;
	j906614336 [label="哦，日尊啊，當然不是這樣！抱歉讓你有這種感覺。不過話說回來，你說得沒錯，我們原型 Warframe 也不是這座城裡唯一的實驗品，對吧？ ",shape=box,color=blue];
		j906614336 -> j2160361372;
		j906614336 -> j2667848447;
		j906614336 -> j3666501759;
	j302065988 [label="感染者。腐爛。毒害我血液的這些東西。你知道的一切我全都要知道",shape=box,color=blue];
		j302065988 -> j4003812746;
	j39294564 [label="真的……很快……",shape=box,color=blue];
		j39294564 -> j2850897917;
	j657328373 [label="+5 Chemistry",color=orange];
		j657328373 -> j906614336;
	j2160361372 [label="還能更糟。",shape=box,color=red];
		j2160361372 -> j3667971633;
	j2667848447 [label="時間久了，我猜你也只能學著去適應它吧。",shape=box,color=red];
		j2667848447 -> j541534191;
	j3666501759 [label="不。",shape=box,color=red];
		j3666501759 -> j300084712;
	j4003812746 [label="請從頭開始說。如果可以的話，*現在*就開始說。請。",shape=box,color=blue];
		j4003812746 -> j2988955069;
	j2850897917 [label="Check boolean QuincySpaceTrauma",color=orange];
		j2850897917 -> j627874143 [label=true,color=green];
		j2850897917 -> j1075270409 [label=false,color=brown];
	j3667971633 [label="我倒是*很想*知道，你到底覺得還有什麼會比這種情況更糟？",shape=box,color=blue];
		j3667971633 -> j606155762;
	j541534191 [label="其實，這正是我想跟你談的事……",shape=box,color=blue];
		j541534191 -> j302065988;
	j300084712 [label="那麼，請說吧",shape=box,color=blue];
		j300084712 -> j2840014149;
	j2988955069 [label="Boolean FlareInfestation1 is now true.",color=orange];
		j2988955069 -> j1263090295;
		j2988955069 -> j3112907892;
		j2988955069 -> j2787626041;
	j627874143 [label="我記得，好像還有一個人提到了什麼「太空創傷」的事？",shape=box,color=blue];
		j627874143 -> j1075270409;
		j627874143 -> j4202464662;
	j1075270409 [label="笑死，至少不用再多費口舌鋪陳了。",shape=box,color=red];
		j1075270409 -> j1871992056;
		j1075270409 -> j3167173291;
	j606155762 [label="請指教我一下。",shape=box,color=blue];
		j606155762 -> j2375739782;
	j2840014149 [label="他去哪了？源拓氏？其他人都說他們不知道，還說連你也不知道",shape=box,color=blue];
		j2840014149 -> j389334458;
	j1263090295 [label="要我喜歡你這種態度？我要想想。",shape=box,color=red];
		j1263090295 -> j2421555428;
	j3112907892 [label="呃……這可不是一時半刻能解釋清楚的，而且你可能也得不到你想要的答案。",shape=box,color=red];
		j3112907892 -> j1292061023;
	j2787626041 [label="哇，等等，先緩一緩。你還好嗎？",shape=box,color=red];
		j2787626041 -> j1928097747;
	j4202464662 [label="沒錯，那肯定是崑西。",shape=box,color=red];
		j4202464662 -> j1871992056;
		j4202464662 -> j3167173291;
	j2375739782 [label="從我的角度來看，我體內的毒素正在逐漸奪走我的理智，還腐蝕著我的身體",shape=box,color=blue];
		j2375739782 -> j2226937700;
	j389334458 [label="我才不信這一套",shape=box,color=blue];
		j389334458 -> j3403153929;
	j2421555428 [label="我……抱歉，這不是我平常的行事風格。但現在的情況……我真的很難去形容",shape=box,color=blue];
		j2421555428 -> j1821276298;
	j1292061023 [label="親愛的太空旅者，這不是因為我想要答案，而是我必須知道答案",shape=box,color=blue];
		j1292061023 -> j3889920809;
	j1928097747 [label="我根本無法用言語形容我現在有多糟糕",shape=box,color=blue];
		j1928097747 -> j1821276298;
	j2226937700 [label="唯一能給我答案的人——唯一能解釋一切、或幫我擺脫她的人——已經不在了",shape=box,color=blue];
		j2226937700 -> j1702964281;
	j3403153929 [label="所以，如果你不介意的話，請告訴我你所知道的關於他的所有事情",shape=box,color=blue];
		j3403153929 -> j3559104995;
	j1821276298 [label="順帶一提，把情感轉化為文字可是我的專長啊",shape=box,color=blue];
		j1821276298 -> j2898773714;
	j3889920809 [label="我沒辦法清楚地描述為何我的情況與其他人完全不同，以及為何我非得立刻擺脫她不可",shape=box,color=blue];
		j3889920809 -> j596885018;
		j3889920809 -> j4158989766;
		j3889920809 -> j1267441872;
		j3889920809 -> j3003697045;
	j1702964281 [label="Boolean FlareInfestation1 is now true.",color=orange];
		j1702964281 -> j2440901421;
		j1702964281 -> j1263090295;
		j1702964281 -> j3112907892;
		j1702964281 -> j2787626041;
	j3559104995 [label="從頭開始說吧",shape=box,color=blue];
		j3559104995 -> j1263090295;
		j3559104995 -> j2787626041;
		j3559104995 -> j3112907892;
	j2898773714 [label="直接說吧，我搞砸了，我打了這針詭異的藥劑",shape=box,color=blue];
		j2898773714 -> j3919650795;
	j596885018 [label="她？",shape=box,color=red];
		j596885018 -> j3059803981;
	j4158989766 [label="你現在經歷的事情，六煞幫也經歷過，你並不孤單。",shape=box,color=red];
		j4158989766 -> j1034233815;
	j1267441872 [label="我明白你的處境，我可以幫助你。",shape=box,color=red];
		j1267441872 -> j3134581690;
	j3003697045 [label="我知道這經歷有多恐怖——變成原型 Warframe，以及霍爾瓦尼亞現在的局勢——",shape=box,color=red];
		j3003697045 -> j1942350236;
	j2440901421 [label="我的意思是，被當成怪物算不上最糟的事，世界上還有更可怕的事。唉。",shape=box,color=red];
		j2440901421 -> j750968125;
	j3919650795 [label="我不知道你想要什麼，有什麼代價，或我需要付出什麼——但我必須*現在*就擺脫她",shape=box,color=blue];
		j3919650795 -> j596885018;
		j3919650795 -> j4158989766;
		j3919650795 -> j1267441872;
		j3919650795 -> j3003697045;
	j3059803981 [label="你說的「她」是指誰？",shape=box,color=red];
		j3059803981 -> j3048826381;
	j1034233815 [label="不，不，我完全不覺得這是同一回事。我開始覺得你根本不理解……而這才是最讓我害怕的地方",shape=box,color=blue];
		j1034233815 -> j2787808928;
		j1034233815 -> j4289281230;
		j1034233815 -> j976296911;
	j3134581690 [label="問題就在這裡，我覺得你根本沒理解……而*這*才是最讓我害怕的事",shape=box,color=blue];
		j3134581690 -> j4289281230;
		j3134581690 -> j2787808928;
		j3134581690 -> j976296911;
	j1942350236 [label="問題就在這裡，我覺得你根本沒理解……而*這*才是最讓我害怕的事",shape=box,color=blue];
		j1942350236 -> j4289281230;
		j1942350236 -> j976296911;
		j1942350236 -> j2787808928;
	j750968125 [label="+5 Chemistry",color=orange];
		j750968125 -> j1979219259;
	j3048826381 [label="Boolean FlareLizzie1 is now true.",color=orange];
		j3048826381 -> j3081215627;
	j2787808928 [label="你會沒事的。我保證。",shape=box,color=red];
		j2787808928 -> j4125086212;
	j4289281230 [label="隨你吧。等你想聊的時候，我會在這裡。",shape=box,color=red];
		j4289281230 -> j2206140283;
	j976296911 [label="那就幫我弄明白吧，弗烈爾。告訴我，究竟是怎麼回事？",shape=box,color=red];
		j976296911 -> j3587704470;
	j1979219259 [label="雖然我……很感激你的看法，但它已經遠遠超出了社會規範，甚至是完全不同的東西了",shape=box,color=blue];
		j1979219259 -> j63849910;
	j3081215627 [label="弗烈爾？",shape=box,color=red];
		j3081215627 -> j2206140283;
	j4125086212 [label="我真希望我能相信你",shape=box,color=blue];
		j4125086212 -> j2206140283;
	j2206140283 [label="+20 Chemistry",color=orange];
		j2206140283 -> "Initiate conversation HexFlareConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue";
	j3587704470 [label="對不起，但我……真的做不到……",shape=box,color=blue];
		j3587704470 -> j3381556327;
	j63849910 [label="將感受化為言語——這可是我的專業，但我竟然無法用語言去表達",shape=box,color=blue];
		j63849910 -> j2898773714;
