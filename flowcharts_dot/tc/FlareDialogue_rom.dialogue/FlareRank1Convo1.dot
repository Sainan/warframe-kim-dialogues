digraph {
	0 [label="FlareRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="嘿，太空旅者",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="噢，嗨。弗烈爾，是嗎？",shape=box,color=red];
		2 -> 4;
	3 [label="嘿。怎麼樣？",shape=box,color=red];
		3 -> 5;
	4 [label="你就是其他實驗品跟我提過的那個人，對吧？",shape=box,color=blue];
		4 -> 6;
		4 -> 7;
	5 [label="閒著沒事，我正好有些問題想問你，不知道你是否有空",shape=box,color=blue];
		5 -> 8;
		5 -> 9;
		5 -> 10;
	6 [label="我很難想像這裡會有兩個我。不過，說來話長。總之情況就是這樣。",shape=box,color=red];
		6 -> 11;
	7 [label="這得看他們說了什麼。不過大概是吧。",shape=box,color=red];
		7 -> 12;
	8 [label="閒著沒事，所以你選擇來動物園敲玻璃找點樂子。挺不錯的嘛。",shape=box,color=red];
		8 -> 13;
	9 [label="哎喲，居然無聊到來找我，這讓我覺得有點榮幸啊，哈哈。",shape=box,color=red];
		9 -> 14;
	10 [label="想問什麼就問吧，我就在這裡。",shape=box,color=red];
		10 -> 15;
	11 [label="好，他們已經跟我說過大致情況了。",shape=box,color=blue];
		11 -> 16;
	12 [label="好吧……",shape=box,color=blue];
		12 -> 17;
		12 -> 18;
	13 [label="+5 Chemistry",color=orange];
		13 -> 19;
	14 [label="哎呀，抱歉，剛才表達得不太對。",shape=box,color=blue];
		14 -> 20;
	15 [label="太好了",shape=box,color=blue];
		15 -> 20;
	16 [label="阿米爾……說得挺詳細，而且速度還挺快的。",shape=box,color=blue];
		16 -> 21;
	17 [label="你是來動物園敲玻璃找樂子的嗎？",shape=box,color=red];
		17 -> 22;
	18 [label="有什麼我可以幫你的？",shape=box,color=red];
		18 -> 20;
	19 [label="哦，日尊啊，當然不是這樣！抱歉讓你有這種感覺。不過話說回來，你說得沒錯，我們原型 Warframe 也不是這座城裡唯一的實驗品，對吧？ ",shape=box,color=blue];
		19 -> 23;
		19 -> 24;
		19 -> 25;
	20 [label="感染者。腐爛。毒害我血液的這些東西。你知道的一切我全都要知道",shape=box,color=blue];
		20 -> 26;
	21 [label="真的……很快……",shape=box,color=blue];
		21 -> 27;
	22 [label="+5 Chemistry",color=orange];
		22 -> 28;
	23 [label="還能更糟。",shape=box,color=red];
		23 -> 29;
	24 [label="時間久了，我猜你也只能學著去適應它吧。",shape=box,color=red];
		24 -> 30;
	25 [label="不。",shape=box,color=red];
		25 -> 31;
	26 [label="請從頭開始說。如果可以的話，*現在*就開始說。請。",shape=box,color=blue];
		26 -> 32;
	27 [label="Check boolean QuincySpaceTrauma",color=orange];
		27 -> 34 [label=true,color=green];
		27 -> 33 [label=false,color=brown];
	28 [label="哦，日尊啊，當然不是這樣！抱歉讓你有這種感覺。不過話說回來，你說得沒錯，我們原型 Warframe 也不是這座城裡唯一的實驗品，對吧？ ",shape=box,color=blue];
		28 -> 23;
		28 -> 24;
		28 -> 25;
	29 [label="我倒是*很想*知道，你到底覺得還有什麼會比這種情況更糟？",shape=box,color=blue];
		29 -> 35;
	30 [label="其實，這正是我想跟你談的事……",shape=box,color=blue];
		30 -> 20;
	31 [label="那麼，請說吧",shape=box,color=blue];
		31 -> 36;
	32 [label="Update boolean FlareInfestation1",color=orange];
		32 -> 37;
		32 -> 38;
		32 -> 39;
	34 [label="我記得，好像還有一個人提到了什麼「太空創傷」的事？",shape=box,color=blue];
		34 -> 33;
		34 -> 40;
	33 [label="笑死，至少不用再多費口舌鋪陳了。",shape=box,color=red];
		33 -> 17;
		33 -> 18;
	35 [label="請指教我一下。",shape=box,color=blue];
		35 -> 41;
	36 [label="他去哪了？源拓氏？其他人都說他們不知道，還說連你也不知道",shape=box,color=blue];
		36 -> 42;
	37 [label="要我喜歡你這種態度？我要想想。",shape=box,color=red];
		37 -> 43;
	38 [label="呃……這可不是一時半刻能解釋清楚的，而且你可能也得不到你想要的答案。",shape=box,color=red];
		38 -> 44;
	39 [label="哇，等等，先緩一緩。你還好嗎？",shape=box,color=red];
		39 -> 45;
	40 [label="沒錯，那肯定是崑西。",shape=box,color=red];
		40 -> 17;
		40 -> 18;
	41 [label="從我的角度來看，我體內的毒素正在逐漸奪走我的理智，還腐蝕著我的身體",shape=box,color=blue];
		41 -> 46;
	42 [label="我才不信這一套",shape=box,color=blue];
		42 -> 47;
	43 [label="我……抱歉，這不是我平常的行事風格。但現在的情況……我真的很難去形容",shape=box,color=blue];
		43 -> 48;
	44 [label="親愛的太空旅者，這不是因為我想要答案，而是我必須知道答案",shape=box,color=blue];
		44 -> 49;
	45 [label="我根本無法用言語形容我現在有多糟糕",shape=box,color=blue];
		45 -> 48;
	46 [label="唯一能給我答案的人——唯一能解釋一切、或幫我擺脫她的人——已經不在了",shape=box,color=blue];
		46 -> 50;
	47 [label="所以，如果你不介意的話，請告訴我你所知道的關於他的所有事情",shape=box,color=blue];
		47 -> 51;
	48 [label="順帶一提，把情感轉化為文字可是我的專長啊",shape=box,color=blue];
		48 -> 52;
	49 [label="我沒辦法清楚地描述為何我的情況與其他人完全不同，以及為何我非得立刻擺脫她不可",shape=box,color=blue];
		49 -> 53;
		49 -> 54;
		49 -> 55;
		49 -> 56;
	50 [label="Update boolean FlareInfestation1",color=orange];
		50 -> 57;
