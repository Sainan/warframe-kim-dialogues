	53 [label="她？",shape=box,color=red];
		53 -> 59;
	54 [label="你現在經歷的事情，六煞幫也經歷過，你並不孤單。",shape=box,color=red];
		54 -> 60;
	55 [label="我明白你的處境，我可以幫助你。",shape=box,color=red];
		55 -> 61;
	56 [label="我知道這經歷有多恐怖——變成原型 Warframe，以及霍爾瓦尼亞現在的局勢——",shape=box,color=red];
		56 -> 62;
	57 [label="我的意思是，被當成怪物算不上最糟的事，世界上還有更可怕的事。唉。",shape=box,color=red];
		57 -> 63;
	58 [label="我不知道你想要什麼，有什麼代價，或我需要付出什麼——但我必須*現在*就擺脫她",shape=box,color=blue];
		58 -> 53;
		58 -> 54;
		58 -> 55;
		58 -> 56;
	59 [label="你說的「她」是指誰？",shape=box,color=red];
		59 -> 64;
	60 [label="不，不，我完全不覺得這是同一回事。我開始覺得你根本不理解……而這才是最讓我害怕的地方",shape=box,color=blue];
		60 -> 65;
		60 -> 66;
