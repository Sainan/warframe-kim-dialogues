digraph {
	1084 [label="FlareRank4Convo1 begins.",color=orange];
		1084 -> 1085;
	1085 [label="我今天一直在思考……我現在所處的這個荒謬情境……",shape=box,color=blue];
		1085 -> 1086;
	1086 [label="以及接下來最好的選擇",shape=box,color=blue];
		1086 -> 1087;
	1087 [label="或者說……根本沒有",shape=box,color=blue];
		1087 -> 1088;
	1088 [label="我想到了一個辦法。",shape=box,color=blue];
		1088 -> 1089;
		1088 -> 1090;
	1089 [label="呃喔。",shape=box,color=red];
		1089 -> 1091;
	1090 [label="什麼？",shape=box,color=red];
		1090 -> 1092;
	1091 [label="不，不，聽我說完",shape=box,color=blue];
		1091 -> 1093;
	1092 [label="所以",shape=box,color=blue];
		1092 -> 1093;
	1093 [label="莉慈說她來自「萬事萬物，於無時無刻」，也就是……",shape=box,color=blue];
		1093 -> 1094;
	1094 [label="就算把她扔到遙不可及的未來，她也會自己爬回來",shape=box,color=blue];
		1094 -> 1095;
	1095 [label="對吧？",shape=box,color=blue];
		1095 -> 1096;
		1095 -> 1097;
	1096 [label="看起來有可能？",shape=box,color=red];
		1096 -> 1098;
	1097 [label="不知道。",shape=box,color=red];
		1097 -> 1099;
	1098 [label="很棒",shape=box,color=blue];
		1098 -> 1100;
	1099 [label="我們姑且這麼假設吧。",shape=box,color=blue];
		1099 -> 1100;
	1100 [label="根據我從其他迷人怪那裡得來的信息……",shape=box,color=blue];
		1100 -> 1101;
	1101 [label="有一個地方*沒有*感染者",shape=box,color=blue];
		1101 -> 1102;
	1102 [label="也許我們可以把她囚禁在某個她永遠*無法*返回的地方……",shape=box,color=blue];
		1102 -> 1103;
		1102 -> 1104;
	1103 [label="弗烈爾，我真的、真的不喜歡你這個想法……你到底在說什麼？",shape=box,color=red];
		1103 -> 1105;
	1104 [label="如果你的意思是把她扔進虛空……那就免談。",shape=box,color=red];
		1104 -> 1106;
	1105 [label="我指的不是虛空",shape=box,color=blue];
		1105 -> 1107;
	1106 [label="我無法確定感染者在虛空中會受到怎樣的影響，但我不打算讓事情變得更糟。",shape=box,color=red];
		1106 -> 1105;
	1107 [label="我說的是渡域",shape=box,color=blue];
		1107 -> 1108;
		1107 -> 1109;
		1107 -> 1110;
	1108 [label="嗯，這樣的話，倒是能讓戰魁長點教訓……",shape=box,color=red];
		1108 -> 1111;
	1109 [label="你說什麼？！不！這絕對不可能！",shape=box,color=red];
		1109 -> 1111;
	1110 [label="等等，你是怎麼會知道渡域的？！",shape=box,color=red];
		1110 -> 1112;
	1111 [label="在它對你做過的那些事之後，你該不會還有義務去幫它了吧",shape=box,color=blue];
		1111 -> 1113;
		1111 -> 1114;
		1111 -> 1115;
	1112 [label="別忘了，我是能夠跟其他原型 Warframe 溝通的",shape=box,color=blue];
		1112 -> 1116;
	1113 [label="你憑什麼說我會眼睜睜看著它變成地獄？",shape=box,color=red];
		1113 -> 1117;
		1113 -> 1118;
		1113 -> 1119;
	1114 [label="可能吧，也可能不是。",shape=box,color=red];
		1114 -> 1117;
		1114 -> 1118;
		1114 -> 1119;
	1115 [label="你太低估這件事了。渡域不只是個「地方」，它過去不是，*現在*也不是。",shape=box,color=red];
		1115 -> 1117;
		1115 -> 1118;
		1115 -> 1119;
	1116 [label="我已經從他們那裡聽說過你曾經在那個詭異的世界生活過的事了",shape=box,color=blue];
		1116 -> 1111;
	1117 [label="你從來沒去過那裡。你沒有在那裡度過數百個世紀。更不曾在那裡經歷過生與死。",shape=box,color=red];
		1117 -> 1120;
		1117 -> 1121;
		1117 -> 1122;
	1118 [label="我就直說吧，弗烈爾？那個地方……既是我的倒影，也是那本故事書的延伸。",shape=box,color=red];
		1118 -> 1120;
		1118 -> 1121;
		1118 -> 1122;
	1119 [label="儘管我對它的感受遠遠稱不上……美好……但我不可能把感染者扔進去然後拍拍屁股走人。",shape=box,color=red];
		1119 -> 1120;
		1119 -> 1122;
		1119 -> 1121;
	1120 [label="雖然我有時候真的很想回去痛扁那裡的某些人……但那裡可不是我的垃圾場。",shape=box,color=red];
		1120 -> 1123;
	1121 [label="不論我願不願意……我還是，愚蠢地，需要對那個地方負責。",shape=box,color=red];
		1121 -> 1124;
	1122 [label="我在那裡有多少痛苦的回憶，就同樣有多少美好的回憶。",shape=box,color=red];
		1122 -> 1125;
	1123 [label="而它同樣不是你的垃圾場。",shape=box,color=red];
		1123 -> 1126;
		1123 -> 1127;
		1123 -> 1128;
	1124 [label="所以當它受到威脅時，我就得挺身而出。",shape=box,color=red];
		1124 -> 1128;
		1124 -> 1127;
		1124 -> 1126;
	1125 [label="只是因為我想擺脫它，並不代表我想讓它遭受痛苦。",shape=box,color=red];
		1125 -> 1128;
		1125 -> 1126;
		1125 -> 1127;
	1126 [label="你要我做的事，是讓更多人受苦。",shape=box,color=red];
		1126 -> 1129;
	1127 [label="弗烈爾，想想你到底在想讓我做什麼。",shape=box,color=red];
		1127 -> 1130;
	1128 [label="你確定要讓另一個世界陷入危險？",shape=box,color=red];
		1128 -> 1131;
	1129 [label="+5 Chemistry",color=orange];
		1129 -> 1132;
	1130 [label="那麼，請你*務必*想出另一個替代方案，拜託。",shape=box,color=blue];
		1130 -> 1133;
	1131 [label="我——但渡域不是*真正的*地方啊",shape=box,color=blue];
		1131 -> 1134;
		1131 -> 1135;
	1132 [label="我——但他們不是*真正的*人啊",shape=box,color=blue];
		1132 -> 1136;
	1133 [label="因為我覺得你沒有其它更好的辦法",shape=box,color=blue];
		1133 -> 1137;
	1134 [label="好吧。如果你認真去談判……而她真的欺騙我們，那我會考慮把她關進渡域。",shape=box,color=red];
		1134 -> 1142;
	1135 [label="我們又有什麼資格去決定什麼是真實，什麼不是？",shape=box,color=red];
		1135 -> 1139;
	1136 [label="不，不，我已經聽見她的聲音在我腦海裡回響了",shape=box,color=blue];
		1136 -> 1140;
	1137 [label="Update boolean FlareWar4",color=orange];
		1137 -> 1141;
	1142 [label="Update boolean FlareWar4b",color=orange];
		1142 -> 1146;
	1139 [label="我……好吧……有道理。",shape=box,color=blue];
		1139 -> 1143;
	1140 [label="到頭來，又是什麼讓一個變得真實？我們又憑什麼下定論？",shape=box,color=blue];
		1140 -> 1144;
	1141 [label="+20 Chemistry",color=orange];
		1141 -> 1145;
	1146 [label="+5 Chemistry",color=orange];
		1146 -> 1149;
	1143 [label="+5 Chemistry",color=orange];
		1143 -> 1147;
	1144 [label="你的漠然顯然就認為我們無關緊要。",shape=box,color=blue];
		1144 -> 1148;
	1145 [label="Chat ends. Next chat will be FlareRank4Convo2.",color=orange];
	1149 [label="謝謝你，太空旅人。謝謝你，祝你好運",shape=box,color=blue];
		1149 -> 1151;
	1147 [label="你的漠然顯然就認為我們無關緊要。",shape=box,color=blue];
		1147 -> 1148;
	1148 [label="該死。*該死。*他媽的該死。漂泊者，我……我真的沒有其它辦法了，我快崩潰了，求你……我不知道還能怎麼*做*……",shape=box,color=blue];
		1148 -> 1138;
