digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"FlareRank4Convo1 begins." [color=orange];
		"FlareRank4Convo1 begins." -> j388896962;
	j388896962 [label="我今天一直在思考……我現在所處的這個荒謬情境……",shape=box,color=blue];
		j388896962 -> j964829067;
	j964829067 [label="以及接下來最好的選擇",shape=box,color=blue];
		j964829067 -> j1206697929;
	j1206697929 [label="或者說……根本沒有",shape=box,color=blue];
		j1206697929 -> j2790314428;
	j2790314428 [label="我想到了一個辦法。",shape=box,color=blue];
		j2790314428 -> j3384012040;
		j2790314428 -> j3588144964;
	j3384012040 [label="呃喔。",shape=box,color=red];
		j3384012040 -> j2221277228;
	j3588144964 [label="什麼？",shape=box,color=red];
		j3588144964 -> j391973156;
	j2221277228 [label="不，不，聽我說完",shape=box,color=blue];
		j2221277228 -> j2978103232;
	j391973156 [label="所以",shape=box,color=blue];
		j391973156 -> j2978103232;
	j2978103232 [label="莉慈說她來自「萬事萬物，於無時無刻」，也就是……",shape=box,color=blue];
		j2978103232 -> j3616503266;
	j3616503266 [label="就算把她扔到遙不可及的未來，她也會自己爬回來",shape=box,color=blue];
		j3616503266 -> j3247991823;
	j3247991823 [label="對吧？",shape=box,color=blue];
		j3247991823 -> j3164601002;
		j3247991823 -> j4076450429;
	j3164601002 [label="看起來有可能？",shape=box,color=red];
		j3164601002 -> j3270261923;
	j4076450429 [label="不知道。",shape=box,color=red];
		j4076450429 -> j2204813881;
	j3270261923 [label="很棒",shape=box,color=blue];
		j3270261923 -> j786227587;
	j2204813881 [label="我們姑且這麼假設吧。",shape=box,color=blue];
		j2204813881 -> j786227587;
	j786227587 [label="根據我從其他迷人怪那裡得來的信息……",shape=box,color=blue];
		j786227587 -> j1395657682;
	j1395657682 [label="有一個地方*沒有*感染者",shape=box,color=blue];
		j1395657682 -> j2400669383;
	j2400669383 [label="也許我們可以把她囚禁在某個她永遠*無法*返回的地方……",shape=box,color=blue];
		j2400669383 -> j1291727774;
		j2400669383 -> j453559085;
	j1291727774 [label="弗烈爾，我真的、真的不喜歡你這個想法……你到底在說什麼？",shape=box,color=red];
		j1291727774 -> j229146502;
	j453559085 [label="如果你的意思是把她扔進虛空……那就免談。",shape=box,color=red];
		j453559085 -> j42648588;
	j229146502 [label="我指的不是虛空",shape=box,color=blue];
		j229146502 -> j1256440304;
	j42648588 [label="我無法確定感染者在虛空中會受到怎樣的影響，但我不打算讓事情變得更糟。",shape=box,color=red];
		j42648588 -> j229146502;
	j1256440304 [label="我說的是渡域",shape=box,color=blue];
		j1256440304 -> j2735936081;
		j1256440304 -> j2814777055;
		j1256440304 -> j1172609444;
	j2735936081 [label="嗯，這樣的話，倒是能讓戰魁長點教訓……",shape=box,color=red];
		j2735936081 -> j1847170317;
	j2814777055 [label="你說什麼？！不！這絕對不可能！",shape=box,color=red];
		j2814777055 -> j1847170317;
	j1172609444 [label="等等，你是怎麼會知道渡域的？！",shape=box,color=red];
		j1172609444 -> j3566569378;
	j1847170317 [label="在它對你做過的那些事之後，你該不會還有義務去幫它了吧",shape=box,color=blue];
		j1847170317 -> j4222322107;
		j1847170317 -> j668370299;
		j1847170317 -> j2398132081;
	j3566569378 [label="別忘了，我是能夠跟其他原型 Warframe 溝通的",shape=box,color=blue];
		j3566569378 -> j1238139378;
	j4222322107 [label="你憑什麼說我會眼睜睜看著它變成地獄？",shape=box,color=red];
		j4222322107 -> j4072406636;
		j4222322107 -> j1714663314;
		j4222322107 -> j1352898859;
	j668370299 [label="可能吧，也可能不是。",shape=box,color=red];
		j668370299 -> j4072406636;
		j668370299 -> j1714663314;
		j668370299 -> j1352898859;
	j2398132081 [label="你太低估這件事了。渡域不只是個「地方」，它過去不是，*現在*也不是。",shape=box,color=red];
		j2398132081 -> j4072406636;
		j2398132081 -> j1714663314;
		j2398132081 -> j1352898859;
	j1238139378 [label="我已經從他們那裡聽說過你曾經在那個詭異的世界生活過的事了",shape=box,color=blue];
		j1238139378 -> j1847170317;
	j4072406636 [label="你從來沒去過那裡。你沒有在那裡度過數百個世紀。更不曾在那裡經歷過生與死。",shape=box,color=red];
		j4072406636 -> j3615737304;
		j4072406636 -> j1788419878;
		j4072406636 -> j677472841;
	j1714663314 [label="我就直說吧，弗烈爾？那個地方……既是我的倒影，也是那本故事書的延伸。",shape=box,color=red];
		j1714663314 -> j3615737304;
		j1714663314 -> j1788419878;
		j1714663314 -> j677472841;
	j1352898859 [label="儘管我對它的感受遠遠稱不上……美好……但我不可能把感染者扔進去然後拍拍屁股走人。",shape=box,color=red];
		j1352898859 -> j3615737304;
		j1352898859 -> j677472841;
		j1352898859 -> j1788419878;
	j3615737304 [label="雖然我有時候真的很想回去痛扁那裡的某些人……但那裡可不是我的垃圾場。",shape=box,color=red];
		j3615737304 -> j1002408536;
	j1788419878 [label="不論我願不願意……我還是，愚蠢地，需要對那個地方負責。",shape=box,color=red];
		j1788419878 -> j3175298820;
	j677472841 [label="我在那裡有多少痛苦的回憶，就同樣有多少美好的回憶。",shape=box,color=red];
		j677472841 -> j2253170143;
	j1002408536 [label="而它同樣不是你的垃圾場。",shape=box,color=red];
		j1002408536 -> j2910594820;
		j1002408536 -> j614374470;
		j1002408536 -> j2351028786;
	j3175298820 [label="所以當它受到威脅時，我就得挺身而出。",shape=box,color=red];
		j3175298820 -> j2351028786;
		j3175298820 -> j614374470;
		j3175298820 -> j2910594820;
	j2253170143 [label="只是因為我想擺脫它，並不代表我想讓它遭受痛苦。",shape=box,color=red];
		j2253170143 -> j2351028786;
		j2253170143 -> j2910594820;
		j2253170143 -> j614374470;
	j2910594820 [label="你要我做的事，是讓更多人受苦。",shape=box,color=red];
		j2910594820 -> j1392289708;
	j614374470 [label="弗烈爾，想想你到底在想讓我做什麼。",shape=box,color=red];
		j614374470 -> j3640371041;
	j2351028786 [label="你確定要讓另一個世界陷入危險？",shape=box,color=red];
		j2351028786 -> j1176433779;
	j1392289708 [label="+5 Chemistry",color=orange];
		j1392289708 -> j3861723124;
	j3640371041 [label="那麼，請你*務必*想出另一個替代方案，拜託。",shape=box,color=blue];
		j3640371041 -> j3221969181;
	j1176433779 [label="我——但渡域不是*真正的*地方啊",shape=box,color=blue];
		j1176433779 -> j3567077029;
		j1176433779 -> j698874409;
	j3861723124 [label="我——但他們不是*真正的*人啊",shape=box,color=blue];
		j3861723124 -> j2925836616;
	j3221969181 [label="因為我覺得你沒有其它更好的辦法",shape=box,color=blue];
		j3221969181 -> j2990166568;
	j3567077029 [label="好吧。如果你認真去談判……而她真的欺騙我們，那我會考慮把她關進渡域。",shape=box,color=red];
		j3567077029 -> j1112011390;
	j698874409 [label="我們又有什麼資格去決定什麼是真實，什麼不是？",shape=box,color=red];
		j698874409 -> j2034677219;
	j2925836616 [label="不，不，我已經聽見她的聲音在我腦海裡回響了",shape=box,color=blue];
		j2925836616 -> j1712458839;
	j2990166568 [label="Boolean FlareWar4 is now true.",color=orange];
		j2990166568 -> j517075388;
	j1112011390 [label="Boolean FlareWar4b is now true.",color=orange];
		j1112011390 -> j2388342810;
	j2034677219 [label="我……好吧……有道理。",shape=box,color=blue];
		j2034677219 -> j2565149729;
	j1712458839 [label="到頭來，又是什麼讓一個變得真實？我們又憑什麼下定論？",shape=box,color=blue];
		j1712458839 -> j1699734302;
	j517075388 [label="+20 Chemistry",color=orange];
		j517075388 -> "Chat ends. Next chat will be FlareRank4Convo2.";
	j2388342810 [label="+5 Chemistry",color=orange];
		j2388342810 -> j4180987422;
	j2565149729 [label="+5 Chemistry",color=orange];
		j2565149729 -> j1699734302;
	j1699734302 [label="你的漠然顯然就認為我們無關緊要。",shape=box,color=blue];
		j1699734302 -> j326013439;
	"Chat ends. Next chat will be FlareRank4Convo2." [color=orange];
	j4180987422 [label="謝謝你，太空旅人。謝謝你，祝你好運",shape=box,color=blue];
		j4180987422 -> j517075388;
	j326013439 [label="該死。*該死。*他媽的該死。漂泊者，我……我真的沒有其它辦法了，我快崩潰了，求你……我不知道還能怎麼*做*……",shape=box,color=blue];
		j326013439 -> j3567077029;
		j326013439 -> j994697409;
	j994697409 [label="也許我該……試著和莉慈好好聊聊。",shape=box,color=red];
		j994697409 -> j1878212652;
	j1878212652 [label="Boolean FlarePeace4 is now true.",color=orange];
		j1878212652 -> j2388342810;
}