		654 -> 658 [label=false,color=brown];
	655 [label="你沒事吧？認真的？",shape=box,color=red];
		655 -> 659;
	656 [label="她簡直把我*嚇到屁滾尿流*。",shape=box,color=red];
		656 -> 660;
	657 [label="沒事的，我猜這……應該挺複雜的吧。",shape=box,color=red];
		657 -> 661;
	658 [label="我怎麼知道這是不是真的？",shape=box,color=red];
		658 -> 662;
	659 [label="不，我一點都不好",shape=box,color=blue];
		659 -> 663;
	660 [label="+5 Chemistry",color=orange];
		660 -> 664;
	661 [label="+5 Chemistry",color=orange];
		661 -> 665;
	662 [label="你確定不了，這點我很抱歉。說實話，每天早上醒來時我都不確定自己還是不是自己……如果這樣說能讓你好受點的話",shape=box,color=blue];
		662 -> 663;
	663 [label="你有過這種經歷嗎？每天早晨醒來，都不知道自己今天還能否撐得住。",shape=box,color=blue];
		663 -> 666;
	664 [label="哈啊，對啊……歡迎加入互助小組",shape=box,color=blue];
		664 -> 667;
	665 [label="我……委婉來說……",shape=box,color=blue];
		665 -> 663;
	666 [label="又或者，我今天能不能熬過去？還是說，我又得把自己鎖在房間裡，鎖上門，然後讓所有人滾開",shape=box,color=blue];
		666 -> 668;
	667 [label="要是她只是單純嚇人就好了，那樣我還能應付。像什麼那種釘頭之類的恐怖電影裡的怪物那樣來糾纏我……",shape=box,color=blue];
		667 -> 669;
	668 [label="把自己縮回殼裡，藏起來，免得他們看到我這一面",shape=box,color=blue];
		668 -> 670;
	669 [label="一身黑色皮革、鎖鏈、乳環，加上浮誇的出場方式，這些我都能接受。但是",shape=box,color=blue];
		669 -> 663;
	670 [label="我害怕它會做什麼事",shape=box,color=blue];
		670 -> 671;
	671 [label="你能想像嗎……每天睜開眼第一件事要去考慮的就是今天的我自己到底是哪個版本？",shape=box,color=blue];
		671 -> 672;
		671 -> 673;
		671 -> 674;
	672 [label="不太。",shape=box,color=red];
		672 -> 675;
	673 [label="我完全明白。",shape=box,color=red];
		673 -> 676;
		673 -> 677;
		673 -> 678;
	674 [label="我不能說我完全理解，但我能體會……",shape=box,color=red];
		674 -> 679;
	675 [label="真讓人羨慕。",shape=box,color=blue];
		675 -> 680;
	676 [label="我連自己都不知道該怎麼形容。但我真的懂，相信我。",shape=box,color=red];
		676 -> 681;
	677 [label="有時候，我一醒來就覺得自己好像活在別人的皮囊裡。我與外在的自己格格不入，這一切就像一場謊言。",shape=box,color=red];
		677 -> 682;
	678 [label="有些日子，我一醒來就痛苦不堪，只想鑽進一個洞裡，把這一天徹底抹去，等明天再試一次。但我知道，這種痛苦終究還是會回來。",shape=box,color=red];
		678 -> 683;
	679 [label="Update boolean FlarePainEmpathy",color=orange];
		679 -> 684;
	680 [label="Update boolean FlarePainNone",color=orange];
		680 -> 685;
	681 [label="我相信你，漂泊者。每個人都有自己的旅程，而你的旅途漫長且……與眾不同",shape=box,color=blue];
		681 -> 686;
	682 [label="你可真是說到點子上了，漂泊者。在莉慈進入我的生活之前，我早就感覺自己像是兩個人擠在同一具軀殼裡",shape=box,color=blue];
		682 -> 687;
	683 [label="慢性疼痛……你的身體開始背叛你。我有個朋友因為這種痛苦，不得不放棄與樂隊四處巡演",shape=box,color=blue];
		683 -> 688;
		683 -> 689;
	684 [label="還有……我真的很抱歉，我當初跟你說話的態度簡直爛透了。我……我只是完全被恐懼吞噬了",shape=box,color=blue];
		684 -> 690;
	685 [label="聽著……我真的很抱歉，我當初跟你說話的態度簡直爛透了。我……我只是完全被恐懼吞噬了",shape=box,color=blue];
		685 -> 690;
	686 [label="你的痛苦只有你才能真正理解，我無法裝作自己能夠體會",shape=box,color=blue];
		686 -> 691;
	687 [label="試著去愛上這個謊言，用歌聲將它化成真實，這是我這輩子學過最困難的事之一",shape=box,color=blue];
		687 -> 692;
	688 [label="不，不是這樣的。",shape=box,color=red];
		688 -> 679;
	689 [label="是的，就是這樣。",shape=box,color=red];
		689 -> 693;
	690 [label="我只是……一開始，我的樂隊不是因為科腐者而毀掉的，而是因為那個混帳。現在我還得面對她，還有她那些針對我的計畫",shape=box,color=blue];
		690 -> 694;
	691 [label="Update boolean FlarePainUnique",color=orange];
		691 -> 684;
	692 [label="這或許是我們一輩子都學不完的課題",shape=box,color=blue];
		692 -> 695;
	693 [label="Update boolean FlarePainChronic",color=orange];
		693 -> 684;
	694 [label="既然我的……秘密已經曝光了，就這麼說吧，我想重新開始。你好，我是弗烈爾。我真的很需要你的幫忙，擺脫那個想要毀掉我的東西",shape=box,color=blue];
		694 -> 696;
		694 -> 697;
	695 [label="Update boolean FlarePainStranger",color=orange];
		695 -> 684;
	696 [label="能和我說說這一起是如何開始嗎？你一開始是怎麼和莉慈扯上關係的？",shape=box,color=red];
		696 -> 698;
	697 [label="你為什麼會覺得莉慈想要毀掉你？",shape=box,color=red];
		697 -> 699;
	698 [label="這一切發生在那個混蛋公開處決了我的樂隊成員之後",shape=box,color=blue];
		698 -> 700;
	699 [label="因為我能聽見她，的低語盤旋在我腦海的邊緣，無休止地撕扯著我",shape=box,color=blue];
		699 -> 701;
	700 [label="在每一個頻道上，他都在稱呼我們是人民的「公敵」。他憑什麼？！",shape=box,color=blue];
		700 -> 702;
	701 [label="「你們屬於我，永遠都屬於我」",shape=box,color=blue];
		701 -> 703;
	702 [label="他竟然*敢*試著把我們滅口？！我當然不會允許……我已經走投無路，所以我讓憤怒——那股暴怒支配了我",shape=box,color=blue];
		702 -> 704;
	703 [label="「讓我進去」",shape=box,color=blue];
		703 -> 705;
	704 [label="我做了唯一我知道該怎麼做的事，這是我這一生唯一擅長的事情",shape=box,color=blue];
		704 -> 706;
	705 [label="「我們可以合而為一，我們可以化為一體」",shape=box,color=blue];
		705 -> 707;
	706 [label="我緊握吉他，以我的旋律回應他的聲音",shape=box,color=blue];
		706 -> 708;
	707 [label="漂泊者，這聽起來你覺得像什麼？在我聽來，這就像一個想把我吞掉的惡魔",shape=box,color=blue];
		707 -> 709;
		707 -> 710;
		707 -> 711;
	708 [label="那音樂就在我體內瘋狂咆哮，拼命想要掙脫一切束縛",shape=box,color=blue];
		708 -> 712;
	709 [label="我不怪你，我也不覺得她……是什麼善類。",shape=box,color=red];
		709 -> 713;
	710 [label="為什麼不直接把她扔下橋？",shape=box,color=red];
		710 -> 714;
	711 [label="也許吧？又或者你對抗的……其實只是一種共生體？",shape=box,color=red];
		711 -> 715;
	712 [label="這種感覺是我這輩子從未經歷過的",shape=box,color=blue];
		712 -> 716;
	713 [label="+5 Chemistry",color=orange];
		713 -> 717;
	714 [label="哎呀，感謝你！要是沒有你那絕對無瑕的天才見解，我該怎麼辦啊？！",shape=box,color=blue];
		714 -> 718;
	715 [label="共生？你真的覺得我能接受跟一個總是喊著「合而為一」還想把我吞掉的東西和平共存？！",shape=box,color=blue];
		715 -> 719;
