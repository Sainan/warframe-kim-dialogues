	j3233785555 [label="+5 Chemistry",color=orange];
		j3233785555 -> j3318436602;
	j4173924039 [label="哎呀，感謝你！要是沒有你那絕對無瑕的天才見解，我該怎麼辦啊？！",shape=box,color=blue];
		j4173924039 -> j3469863387;
	j4024955727 [label="共生？你真的覺得我能接受跟一個總是喊著「合而為一」還想把我吞掉的東西和平共存？！",shape=box,color=blue];
		j4024955727 -> j2516797098;
	j2164369235 [label="我走上舞台，把所有的痛苦、怒火，還有失去摯友那股撕心裂肺的絕望全部釋放。我彈奏到指尖出血……",shape=box,color=blue];
		j2164369235 -> j1382207173;
	j3318436602 [label="*謝謝你。*拜託，我們得設法讓她從此徹底消失……永永遠遠\n",shape=box,color=blue];
		j3318436602 -> j653199982;
