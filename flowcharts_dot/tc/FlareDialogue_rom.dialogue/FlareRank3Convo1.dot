		j2564159568 -> j173098023 [label=false,color=brown];
		j2564159568 -> j2883168916 [label=false,color=brown];
	j4155890780 [label="你沒事吧？認真的？",shape=box,color=red];
		j4155890780 -> j3369947852;
	j857999123 [label="她簡直把我*嚇到屁滾尿流*。",shape=box,color=red];
		j857999123 -> j1635995894;
	j173098023 [label="沒事的，我猜這……應該挺複雜的吧。",shape=box,color=red];
		j173098023 -> j2228711130;
	j2883168916 [label="我怎麼知道這是不是真的？",shape=box,color=red];
		j2883168916 -> j952707430;
	j3369947852 [label="不，我一點都不好",shape=box,color=blue];
		j3369947852 -> j3200269741;
	j1635995894 [label="+5 Chemistry",color=orange];
		j1635995894 -> j1933198139;
	j2228711130 [label="+5 Chemistry",color=orange];
		j2228711130 -> j175179830;
	j952707430 [label="你確定不了，這點我很抱歉。說實話，每天早上醒來時我都不確定自己還是不是自己……如果這樣說能讓你好受點的話",shape=box,color=blue];
		j952707430 -> j3200269741;
	j3200269741 [label="你有過這種經歷嗎？每天早晨醒來，都不知道自己今天還能否撐得住。",shape=box,color=blue];
		j3200269741 -> j3671603924;
	j1933198139 [label="哈啊，對啊……歡迎加入互助小組",shape=box,color=blue];
		j1933198139 -> j3244645935;
	j175179830 [label="我……委婉來說……",shape=box,color=blue];
		j175179830 -> j3200269741;
	j3671603924 [label="又或者，我今天能不能熬過去？還是說，我又得把自己鎖在房間裡，鎖上門，然後讓所有人滾開",shape=box,color=blue];
		j3671603924 -> j4249354394;
	j3244645935 [label="要是她只是單純嚇人就好了，那樣我還能應付。像什麼那種釘頭之類的恐怖電影裡的怪物那樣來糾纏我……",shape=box,color=blue];
		j3244645935 -> j3149435887;
	j4249354394 [label="把自己縮回殼裡，藏起來，免得他們看到我這一面",shape=box,color=blue];
		j4249354394 -> j3582507832;
	j3149435887 [label="一身黑色皮革、鎖鏈、乳環，加上浮誇的出場方式，這些我都能接受。但是",shape=box,color=blue];
		j3149435887 -> j3200269741;
	j3582507832 [label="我害怕它會做什麼事",shape=box,color=blue];
		j3582507832 -> j489870293;
	j489870293 [label="你能想像嗎……每天睜開眼第一件事要去考慮的就是今天的我自己到底是哪個版本？",shape=box,color=blue];
		j489870293 -> j2987547376;
		j489870293 -> j479298438;
		j489870293 -> j1642636046;
	j2987547376 [label="不太。",shape=box,color=red];
		j2987547376 -> j928013726;
	j479298438 [label="我完全明白。",shape=box,color=red];
		j479298438 -> j4167605450;
		j479298438 -> j4162721128;
		j479298438 -> j3560496656;
	j1642636046 [label="我不能說我完全理解，但我能體會……",shape=box,color=red];
		j1642636046 -> j2684810731;
	j928013726 [label="真讓人羨慕。",shape=box,color=blue];
		j928013726 -> j225002104;
	j4167605450 [label="我連自己都不知道該怎麼形容。但我真的懂，相信我。",shape=box,color=red];
		j4167605450 -> j1444782731;
	j4162721128 [label="有時候，我一醒來就覺得自己好像活在別人的皮囊裡。我與外在的自己格格不入，這一切就像一場謊言。",shape=box,color=red];
		j4162721128 -> j532930157;
	j3560496656 [label="有些日子，我一醒來就痛苦不堪，只想鑽進一個洞裡，把這一天徹底抹去，等明天再試一次。但我知道，這種痛苦終究還是會回來。",shape=box,color=red];
		j3560496656 -> j1295914440;
	j2684810731 [label="Boolean FlarePainEmpathy is now true.",color=orange];
		j2684810731 -> j374416187;
	j225002104 [label="Boolean FlarePainNone is now true.",color=orange];
		j225002104 -> j640043722;
	j1444782731 [label="我相信你，漂泊者。每個人都有自己的旅程，而你的旅途漫長且……與眾不同",shape=box,color=blue];
		j1444782731 -> j3068840152;
	j532930157 [label="你可真是說到點子上了，漂泊者。在莉慈進入我的生活之前，我早就感覺自己像是兩個人擠在同一具軀殼裡",shape=box,color=blue];
		j532930157 -> j523319761;
	j1295914440 [label="慢性疼痛……你的身體開始背叛你。我有個朋友因為這種痛苦，不得不放棄與樂隊四處巡演",shape=box,color=blue];
		j1295914440 -> j3740237371;
		j1295914440 -> j1460908684;
	j374416187 [label="還有……我真的很抱歉，我當初跟你說話的態度簡直爛透了。我……我只是完全被恐懼吞噬了",shape=box,color=blue];
		j374416187 -> j869704901;
	j640043722 [label="聽著……我真的很抱歉，我當初跟你說話的態度簡直爛透了。我……我只是完全被恐懼吞噬了",shape=box,color=blue];
		j640043722 -> j869704901;
	j3068840152 [label="你的痛苦只有你才能真正理解，我無法裝作自己能夠體會",shape=box,color=blue];
		j3068840152 -> j1798929213;
	j523319761 [label="試著去愛上這個謊言，用歌聲將它化成真實，這是我這輩子學過最困難的事之一",shape=box,color=blue];
		j523319761 -> j2647514221;
	j3740237371 [label="不，不是這樣的。",shape=box,color=red];
		j3740237371 -> j2684810731;
	j1460908684 [label="是的，就是這樣。",shape=box,color=red];
		j1460908684 -> j2728341335;
	j869704901 [label="我只是……一開始，我的樂隊不是因為科腐者而毀掉的，而是因為那個混帳。現在我還得面對她，還有她那些針對我的計畫",shape=box,color=blue];
		j869704901 -> j3024611716;
	j1798929213 [label="Boolean FlarePainUnique is now true.",color=orange];
		j1798929213 -> j374416187;
	j2647514221 [label="這或許是我們一輩子都學不完的課題",shape=box,color=blue];
		j2647514221 -> j3183781025;
	j2728341335 [label="Boolean FlarePainChronic is now true.",color=orange];
		j2728341335 -> j374416187;
	j3024611716 [label="既然我的……秘密已經曝光了，就這麼說吧，我想重新開始。你好，我是弗烈爾。我真的很需要你的幫忙，擺脫那個想要毀掉我的東西",shape=box,color=blue];
		j3024611716 -> j3871045345;
		j3024611716 -> j2655038366;
	j3183781025 [label="Boolean FlarePainStranger is now true.",color=orange];
		j3183781025 -> j374416187;
	j3871045345 [label="能和我說說這一起是如何開始嗎？你一開始是怎麼和莉慈扯上關係的？",shape=box,color=red];
		j3871045345 -> j2262432306;
	j2655038366 [label="你為什麼會覺得莉慈想要毀掉你？",shape=box,color=red];
		j2655038366 -> j4122758534;
	j2262432306 [label="這一切發生在那個混蛋公開處決了我的樂隊成員之後",shape=box,color=blue];
		j2262432306 -> j3395704223;
	j4122758534 [label="因為我能聽見她，的低語盤旋在我腦海的邊緣，無休止地撕扯著我",shape=box,color=blue];
		j4122758534 -> j183136295;
	j3395704223 [label="在每一個頻道上，他都在稱呼我們是人民的「公敵」。他憑什麼？！",shape=box,color=blue];
		j3395704223 -> j3891157446;
	j183136295 [label="「你們屬於我，永遠都屬於我」",shape=box,color=blue];
		j183136295 -> j2400698948;
	j3891157446 [label="他竟然*敢*試著把我們滅口？！我當然不會允許……我已經走投無路，所以我讓憤怒——那股暴怒支配了我",shape=box,color=blue];
		j3891157446 -> j2246690448;
	j2400698948 [label="「讓我進去」",shape=box,color=blue];
		j2400698948 -> j3634130862;
	j2246690448 [label="我做了唯一我知道該怎麼做的事，這是我這一生唯一擅長的事情",shape=box,color=blue];
		j2246690448 -> j1069206987;
	j3634130862 [label="「我們可以合而為一，我們可以化為一體」",shape=box,color=blue];
		j3634130862 -> j2686800917;
	j1069206987 [label="我緊握吉他，以我的旋律回應他的聲音",shape=box,color=blue];
		j1069206987 -> j2721521288;
	j2686800917 [label="漂泊者，這聽起來你覺得像什麼？在我聽來，這就像一個想把我吞掉的惡魔",shape=box,color=blue];
		j2686800917 -> j1906844903;
		j2686800917 -> j2360082574;
		j2686800917 -> j1620865683;
	j2721521288 [label="那音樂就在我體內瘋狂咆哮，拼命想要掙脫一切束縛",shape=box,color=blue];
		j2721521288 -> j2569024723;
	j1906844903 [label="我不怪你，我也不覺得她……是什麼善類。",shape=box,color=red];
		j1906844903 -> j3233785555;
	j2360082574 [label="為什麼不直接把她扔下橋？",shape=box,color=red];
		j2360082574 -> j4173924039;
