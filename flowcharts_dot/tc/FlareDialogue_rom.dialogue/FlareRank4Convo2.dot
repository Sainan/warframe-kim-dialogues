		1232 -> 1237;
	1233 [label="那就別再提什麼「吞噬他們的意識」這一套了。",shape=box,color=red];
		1233 -> 1238;
	1234 [label="你一直在搞砸這一切，根本沒讓他們看到這一點。",shape=box,color=red];
		1234 -> 1238;
	1235 [label="對你而言，「共享」或許是理所當然的，但對我們來說，那看起來更像是「毀滅」。你必須試著理解這一點。我知道要「低調」並不容易，但請試著去做。還記得愛琳娜和莉蒂的下場嗎？",shape=box,color=red];
		1235 -> 1239;
	1236 [label="你要試著理解弗烈爾的感受。他們害怕極了。他們已經什麼都沒有了，而現在，他們害怕連最後僅存的一樣東西——他們自己——都會被奪走。",shape=box,color=red];
