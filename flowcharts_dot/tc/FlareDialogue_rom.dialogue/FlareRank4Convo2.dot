	1216 [label="我們不擅長低調",shape=box,color=blue];
		1216 -> 1218;
	1217 [label="第二個，只剩一具燒焦了的外殼",shape=box,color=blue];
		1217 -> 1219;
	1218 [label="這就是為什麼我們不常與惡魔交談",shape=box,color=blue];
		1218 -> 1220;
		1218 -> 1221;
	1219 [label="第三個，被遺棄，骨骼斷裂，如同被狠心的母鳥踢出巢穴的小鳥",shape=box,color=blue];
		1219 -> 1222;
	1220 [label="我認為所謂的「共享」對弗烈爾來說還不足夠。",shape=box,color=red];
		1220 -> 1223;
