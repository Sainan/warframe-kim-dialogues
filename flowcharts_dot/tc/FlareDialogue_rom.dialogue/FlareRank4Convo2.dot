		1173 -> 1172 [label=false,color=brown];
	1174 [label="為什麼",shape=box,color=blue];
		1174 -> 1180;
	1175 [label="弗烈爾擔心，一旦他們接受了你，你就會吞噬他們的意識。他們將不再是原本的「他們」。",shape=box,color=red];
		1175 -> 1181;
	1176 [label="你能詳細告訴我，當你得到你想要的東西之後，你會如何改變他們嗎？請用……比較普通、沒有恐怖元素的表達方式來說明……",shape=box,color=red];
		1176 -> 1182;
