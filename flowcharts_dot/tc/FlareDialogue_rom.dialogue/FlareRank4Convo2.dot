		1228 -> 1231;
	1229 [label="我們……無所不在……而沒有我們，你又會是什麼呢，TENNO……？",shape=box,color=blue];
		1229 -> 1232;
	1230 [label="可我們是他們的朋友，不是敵人……",shape=box,color=blue];
		1230 -> 1233;
