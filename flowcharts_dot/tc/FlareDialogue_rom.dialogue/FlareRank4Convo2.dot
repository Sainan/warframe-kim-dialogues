		j924355926 -> j3404810967;
	j172455710 [label="對你而言，「共享」或許是理所當然的，但對我們來說，那看起來更像是「毀滅」。你必須試著理解這一點。我知道要「低調」並不容易，但請試著去做。還記得愛琳娜和莉蒂的下場嗎？",shape=box,color=red];
