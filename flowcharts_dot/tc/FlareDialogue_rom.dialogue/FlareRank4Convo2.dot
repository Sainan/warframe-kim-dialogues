	1202 [label="你真的以為……事情會這麼……簡單嗎……？",shape=box,color=blue];
		1202 -> 1206;
	1203 [label="我開始明白為什麼弗烈爾會認為你要吞噬他們了，莉慈。",shape=box,color=red];
		1203 -> 1207;
	1205 [label="這就是你對「沒有恐怖元素」的理解嗎？",shape=box,color=red];
		1205 -> 1209;
