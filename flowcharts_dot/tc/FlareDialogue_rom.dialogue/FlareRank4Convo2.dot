	1156 [label="行吧，我們來看看能不能找到某種和平的方式……",shape=box,color=red];
		1156 -> 1159;
	1157 [label="弗烈爾，你在嗎？",shape=box,color=red];
		1157 -> 1160;
	1158 [label="我必須跟莉慈談談。",shape=box,color=red];
