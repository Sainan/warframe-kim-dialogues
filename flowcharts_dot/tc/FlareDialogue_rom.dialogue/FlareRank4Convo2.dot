		1178 -> 1183;
	1179 [label="我想過你的建議，把她困在渡域……或許這真的是個可行的方法。",shape=box,color=red];
		1179 -> 1184;
	1180 [label="既欲驅吾等遠離，何以妄求吾等垂聽？！",shape=box,color=blue];
