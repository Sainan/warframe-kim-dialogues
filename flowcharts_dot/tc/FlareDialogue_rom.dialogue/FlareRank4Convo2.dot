	1181 [label="他們是他們可有任何特別之處？",shape=box,color=blue];
		1181 -> 1187;
	1182 [label="Update boolean FlareNonCosmic",color=orange];
		1182 -> 1188;
	1183 [label="我願意付出一",shape=box,color=blue];
		1183 -> 1189;
	1184 [label="直接把她扔進 Kullervo 的牢房，讓那傢伙陪著她。",shape=box,color=red];
		1184 -> 1183;
	1185 [label="冷靜點！我只是想把弗烈爾暫時支開，我想跟你談談，看看能不能讓你們和平共處。",shape=box,color=red];
		1185 -> 1190;
	1186 [label="因為你錯了！他們只想擺脫你！所以無論是殺了你，還是把你扔進虛空，或者用任何可能的方法，我都會去做，任何手段我也並不在乎。",shape=box,color=red];
		1186 -> 1191;
	1187 [label="他們只是空殼，沒有我們，他們不過是一具上了釉的瓷偶",shape=box,color=blue];
		1187 -> 1192;
	1188 [label="我們會盡力的…… ;)",shape=box,color=blue];
		1188 -> 1187;
	1189 [label="  ",shape=box,color=blue];
		1189 -> 1193;
	1190 [label="嗯……方法可疑，但我們姑且聽聽……請繼續",shape=box,color=blue];
		1190 -> 1176;
		1190 -> 1175;
	1191 [label="我非常、*非常*擅長殺死那些殺不死的東西。相信我。",shape=box,color=red];
		1191 -> 1194;
	1192 [label="我們將以歌聲填滿他們，以偉大、以他們一生都在尋找的答案來填滿他們的生命",shape=box,color=blue];
		1192 -> 1195;
