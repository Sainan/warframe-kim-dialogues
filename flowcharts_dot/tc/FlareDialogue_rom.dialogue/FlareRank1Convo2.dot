	149 [label="無論好壞",shape=box,color=blue];
		149 -> 153;
	150 [label="我會試著不去憎恨他們，但如果另一個選擇是完全麻木沒有感覺，那反而更糟，對吧？",shape=box,color=blue];
		150 -> 154;
	151 [label="世事無常，世界上經歷悲劇的我不是第一個，我也不是最後一個",shape=box,color=blue];
		151 -> 155;
	152 [label="不，我懂了。卡婭——啊，抱歉，她比較喜歡別人叫她 Nova，——她有解釋給我聽。時間旅行確實不好理解",shape=box,color=blue];
		152 -> 156;
	153 [label="不過……趁我們還在談論我的……轉變時，我突然想到一個問題。",shape=box,color=blue];
		153 -> 157;
	154 [label="你明白嗎？有些事如果我們不經歷，後果可能會更嚴重。",shape=box,color=blue];
		154 -> 158;
		154 -> 159;
	155 [label="看看四周，每個人都曾失去過重要的人。愛與哀傷才真正定義了我們是誰。",shape=box,color=blue];
		155 -> 160;
	156 [label="而且……世事無常，世界上經歷悲劇的我不是第一個，我也不是最後一個",shape=box,color=blue];
		156 -> 161;
	157 [label="Update boolean FlareInfestation2",color=orange];
		157 -> 162;
	158 [label="如果能避免毫無意義的殺戮，我當然樂意，但，是的。",shape=box,color=red];
		158 -> 163;
	159 [label="的確。",shape=box,color=red];
		159 -> 163;
	160 [label="你明白嗎？有些事如果我們不經歷，後果可能會更嚴重。",shape=box,color=blue];
		160 -> 158;
		160 -> 159;
	161 [label="但還是謝謝你。我很感激你願意嘗試，這對我來說真的很重要。",shape=box,color=blue];
		161 -> 153;
	162 [label="這種感染……當源拓氏將菌株注入某人體內……究竟有多少影響是由菌株本身來決定的……？",shape=box,color=blue];
		162 -> 164;
	163 [label="嘿，被你說中了。",shape=box,color=blue];
		163 -> 153;
	164 [label="被注射者自身又對情況有多少影響呢……？",shape=box,color=blue];
		164 -> 165;
	165 [label="先天的影響有多大？後天的因素又有多少……？",shape=box,color=blue];
		165 -> 166;
		165 -> 167;
	166 [label="Warframe 和原型 Warframe 之間似乎情況並不相同。",shape=box,color=red];
		166 -> 168;
