		172 -> 174;
		172 -> 175;
	173 [label="我覺得 Warframe 會吞噬幾乎全部的人格，只是偶爾會遺漏一些零散部份。但源拓氏用來創造原型 Warframe 的菌株，正是來自這些 Warframe。",shape=box,color=red];
		173 -> 176;
	174 [label="好吧……",shape=box,color=red];
		174 -> 173;
	175 [label="不，弗烈爾，一定有事不對勁，告訴我吧！為什麼我要快？「以防」什麼？",shape=box,color=red];
		175 -> 177;
	176 [label="所以你同時融合了自己的人格，還有那些菌株所來自的原本 Warframe。",shape=box,color=red];
		176 -> 178;
