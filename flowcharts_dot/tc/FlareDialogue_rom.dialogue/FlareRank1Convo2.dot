		93 -> 99 [label=false,color=brown];
	94 [label="沒問題。那我能問問你來霍爾瓦尼亞的原因嗎？",shape=box,color=red];
		94 -> 97;
	95 [label="好吧，但是……你說過「她」會殺了你，這可不是鬧著玩的。「她」到底是誰？",shape=box,color=red];
		95 -> 98;
	99 [label="沒錯，但你當時看起來真的很不安。我不覺得這是能隨便放下不談的事……到底是怎麼回事？",shape=box,color=red];
		99 -> 98;
	97 [label="Update boolean FlareBackstory1",color=orange];
		97 -> 100;
	98 [label="我早就警告過你……我已經說過了……這不是我的錯……這根本不是我的錯！你明白嗎？！可惡……可惡！",shape=box,color=blue];
		98 -> 101;
	100 [label="有天某個鬼祟的小傢伙打電話來，拚命撐場面擺出一副了不起的樣子，好像非得證明點什麼似的",shape=box,color=blue];
		100 -> 102;
	101 [label="Update boolean FlareLizzie2",color=orange];
		101 -> 103;
	102 [label="他一直在跟我們吹噓自己有多重要，又說這座城市正在「墮落」和「失去信仰」，還說我們應該「幫助他完成他的偉大事業，讓城市回到正軌」",shape=box,color=blue];
		102 -> 104;
	103 [label="+20 Chemistry",color=orange];
		103 -> 105;
	104 [label="他還真以為自己知道在跟誰說話。最好笑的部分？他還自稱是個*粉絲*",shape=box,color=blue];
		104 -> 106;
	105 [label="Chat ends. Next chat will be FlareRank1Convo3.",color=orange];
	106 [label="這世界上最糟糕的事，莫過於看著那些蠢貨曲解你的話來達成他們的目的",shape=box,color=blue];
		106 -> 107;
	107 [label="所以，我們毫不猶豫就答應了，主要是為了讓那個小雜碎抓狂，讓他明白自己其實根本沒什麼了不起",shape=box,color=blue];
		107 -> 108;
	108 [label="早知道就該相信那些八卦雜誌寫的關於那場詭異瘟疫的事了",shape=box,color=blue];
		108 -> 109;
	109 [label="那簡直夠嗆",shape=box,color=blue];
		109 -> 110;
		109 -> 111;
	110 [label="噢。",shape=box,color=red];
		110 -> 112;
	111 [label="你被科腐感染了？",shape=box,color=red];
		111 -> 112;
	112 [label="0/5 顆星，絕不推薦，再也不想來。當我癱在巡演巴士上時，突然有人來敲門",shape=box,color=blue];
		112 -> 113;
		112 -> 114;
	113 [label="源拓氏？",shape=box,color=red];
		113 -> 115;
	114 [label="讓我猜。",shape=box,color=red];
		114 -> 116;
	115 [label="叮叮叮。",shape=box,color=blue];
		115 -> 116;
	116 [label="呿，你也知道劇本的套路了。神秘的奇蹟療法？還說什麼會讓我成為前所未見世界級的藝人……",shape=box,color=blue];
		116 -> 117;
	117 [label="之類的，之類的，反正你懂的。",shape=box,color=blue];
		117 -> 118;
	118 [label="那個小雜碎想要一場演唱會？好啊，他如願以償了。我的舞台形象本來就……挺瘋的",shape=box,color=blue];
		118 -> 119;
	119 [label="我一直都是開足馬力，把音量推到最大",shape=box,color=blue];
		119 -> 120;
	120 [label="可是現在？此時此刻？我感覺就像飆上雲端，靠著某種我聽都*沒聽過的*燃料推動著",shape=box,color=blue];
		120 -> 121;
		120 -> 122;
	121 [label="然後呢？",shape=box,color=red];
		121 -> 123;
	122 [label="虛空可是劑猛藥啊。",shape=box,color=red];
		122 -> 124;
	123 [label="站在舞台上，那個新我感覺就像……活了過來，真真正正地活著，比以往任何時候都更貼近最真實的自己。那種感覺太美妙了，像是徹底解放了一樣。我感覺自己在飛翔",shape=box,color=blue];
		123 -> 125;
	124 [label="什麼？",shape=box,color=blue];
		124 -> 126;
	125 [label="我們在霍爾瓦尼亞舉辦了一場所有人都絕不會忘記的演出。那個混蛋想讓我們給他們希望？信念？我們做到了，我們讓他們相信自己",shape=box,color=blue];
		125 -> 127;
	126 [label="別管那個了，繼續。",shape=box,color=red];
		126 -> 123;
	127 [label="然後我們就看到他們在掀翻清剿隊的卡車，還在推倒雕像，哈哈哈",shape=box,color=blue];
		127 -> 128;
	128 [label="那小混蛋氣得跳腳……",shape=box,color=blue];
		128 -> 129;
	129 [label="早該料到這種事不可能沒代價……",shape=box,color=blue];
		129 -> 130;
	130 [label="嗯……他們……",shape=box,color=blue];
		130 -> 131;
		130 -> 132;
	131 [label="我聽說了。",shape=box,color=red];
		131 -> 133;
	132 [label="出了什麼事……？",shape=box,color=red];
		132 -> 134;
	133 [label="嗯。",shape=box,color=blue];
		133 -> 135;
	134 [label="那個雜碎打算搞一場屬於他的表演，不管用的是什麼手段。但這次？不再是演唱會了",shape=box,color=blue];
		134 -> 136;
	135 [label="我根本無法阻止他們，他們人數太多了，我一個人根本無力應對。但你……我看你宛如砍瓜切菜一般對付他們……",shape=box,color=blue];
		135 -> 137;
	136 [label="這種戲碼還真是一生一次……",shape=box,color=blue];
		136 -> 135;
	137 [label="我這副模樣活像隻剛出生的長頸鹿，還在摸索怎麼控制自己的腿",shape=box,color=blue];
		137 -> 138;
	138 [label="我什麼都做不了……只能眼睜睜看著他們死去……",shape=box,color=blue];
		138 -> 139;
	139 [label="那個混蛋還在全國電視台直播這一切……",shape=box,color=blue];
		139 -> 140;
	140 [label="他還得意洋洋地吹噓著這收視率，像這有什麼值得驕傲似的……",shape=box,color=blue];
		140 -> 141;
		140 -> 142;
