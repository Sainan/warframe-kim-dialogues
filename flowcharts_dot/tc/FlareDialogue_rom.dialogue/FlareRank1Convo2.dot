	87 [label="關於昨天的事……",shape=box,color=red];
		87 -> 90;
	88 [label="弗烈爾？你在嗎？",shape=box,color=red];
		88 -> 91;
	89 [label="我們能談談嗎？",shape=box,color=red];
		89 -> 92;
	90 [label="嘿，我昨天心情不太好，你應該能理解吧？換個話題吧，求求你",shape=box,color=blue];
		90 -> 93;
	91 [label="嗯。但如果你是想說昨天的事，能換個話題嗎？我昨天心情很差，不太想繼續聊那件事",shape=box,color=blue];
		91 -> 93;
	92 [label="當然。但如果是關於昨天的事，能換個話題嗎？我昨天心情很差，不太想繼續聊那件事",shape=box,color=blue];
		92 -> 93;
