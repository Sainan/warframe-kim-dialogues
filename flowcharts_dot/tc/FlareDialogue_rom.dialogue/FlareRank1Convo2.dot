	"FlareRank1Convo2 begins." [color=orange];
		"FlareRank1Convo2 begins." -> j3507189914;
		"FlareRank1Convo2 begins." -> j289551952;
		"FlareRank1Convo2 begins." -> j1477206743;
	j3507189914 [label="關於昨天的事……",shape=box,color=red];
		j3507189914 -> j4169393981;
	j289551952 [label="弗烈爾？你在嗎？",shape=box,color=red];
		j289551952 -> j566357247;
	j1477206743 [label="我們能談談嗎？",shape=box,color=red];
		j1477206743 -> j2321012978;
	j4169393981 [label="嘿，我昨天心情不太好，你應該能理解吧？換個話題吧，求求你",shape=box,color=blue];
		j4169393981 -> j3085447498;
	j566357247 [label="嗯。但如果你是想說昨天的事，能換個話題嗎？我昨天心情很差，不太想繼續聊那件事",shape=box,color=blue];
		j566357247 -> j3085447498;
	j2321012978 [label="當然。但如果是關於昨天的事，能換個話題嗎？我昨天心情很差，不太想繼續聊那件事",shape=box,color=blue];
		j2321012978 -> j3085447498;
	j3085447498 [label="Check boolean FlareLizzie1",color=orange];
		j3085447498 -> j3336985565 [label=true,color=green];
		j3085447498 -> j92156180 [label=true,color=green];
		j3085447498 -> j3336985565 [label=false,color=brown];
		j3085447498 -> j4221006352 [label=false,color=brown];
	j3336985565 [label="沒問題。那我能問問你來霍爾瓦尼亞的原因嗎？",shape=box,color=red];
		j3336985565 -> j2007582547;
	j92156180 [label="好吧，但是……你說過「她」會殺了你，這可不是鬧著玩的。「她」到底是誰？",shape=box,color=red];
		j92156180 -> j3440210227;
	j4221006352 [label="沒錯，但你當時看起來真的很不安。我不覺得這是能隨便放下不談的事……到底是怎麼回事？",shape=box,color=red];
		j4221006352 -> j3440210227;
	j2007582547 [label="Boolean FlareBackstory1 is now true.",color=orange];
		j2007582547 -> j117431223;
	j3440210227 [label="我早就警告過你……我已經說過了……這不是我的錯……這根本不是我的錯！你明白嗎？！可惡……可惡！",shape=box,color=blue];
		j3440210227 -> j145207193;
	j117431223 [label="有天某個鬼祟的小傢伙打電話來，拚命撐場面擺出一副了不起的樣子，好像非得證明點什麼似的",shape=box,color=blue];
		j117431223 -> j734351460;
	j145207193 [label="Boolean FlareLizzie2 is now true.",color=orange];
		j145207193 -> j261191027;
	j734351460 [label="他一直在跟我們吹噓自己有多重要，又說這座城市正在「墮落」和「失去信仰」，還說我們應該「幫助他完成他的偉大事業，讓城市回到正軌」",shape=box,color=blue];
		j734351460 -> j4192712617;
	j261191027 [label="+20 Chemistry",color=orange];
		j261191027 -> "Chat ends. Next chat will be FlareRank1Convo3.";
	j4192712617 [label="他還真以為自己知道在跟誰說話。最好笑的部分？他還自稱是個*粉絲*",shape=box,color=blue];
		j4192712617 -> j2970884796;
	"Chat ends. Next chat will be FlareRank1Convo3." [color=orange];
	j2970884796 [label="這世界上最糟糕的事，莫過於看著那些蠢貨曲解你的話來達成他們的目的",shape=box,color=blue];
		j2970884796 -> j2219168964;
	j2219168964 [label="所以，我們毫不猶豫就答應了，主要是為了讓那個小雜碎抓狂，讓他明白自己其實根本沒什麼了不起",shape=box,color=blue];
		j2219168964 -> j1071831224;
	j1071831224 [label="早知道就該相信那些八卦雜誌寫的關於那場詭異瘟疫的事了",shape=box,color=blue];
		j1071831224 -> j1960442417;
	j1960442417 [label="那簡直夠嗆",shape=box,color=blue];
		j1960442417 -> j2104821128;
		j1960442417 -> j2842253847;
	j2104821128 [label="噢。",shape=box,color=red];
		j2104821128 -> j1882755276;
	j2842253847 [label="你被科腐感染了？",shape=box,color=red];
		j2842253847 -> j1882755276;
	j1882755276 [label="0/5 顆星，絕不推薦，再也不想來。當我癱在巡演巴士上時，突然有人來敲門",shape=box,color=blue];
		j1882755276 -> j2234071184;
		j1882755276 -> j66818210;
	j2234071184 [label="源拓氏？",shape=box,color=red];
		j2234071184 -> j3813754625;
	j66818210 [label="讓我猜。",shape=box,color=red];
		j66818210 -> j1950854502;
	j3813754625 [label="叮叮叮。",shape=box,color=blue];
		j3813754625 -> j1950854502;
	j1950854502 [label="呿，你也知道劇本的套路了。神秘的奇蹟療法？還說什麼會讓我成為前所未見世界級的藝人……",shape=box,color=blue];
		j1950854502 -> j3051261022;
	j3051261022 [label="之類的，之類的，反正你懂的。",shape=box,color=blue];
		j3051261022 -> j133836831;
	j133836831 [label="那個小雜碎想要一場演唱會？好啊，他如願以償了。我的舞台形象本來就……挺瘋的",shape=box,color=blue];
		j133836831 -> j2181855095;
	j2181855095 [label="我一直都是開足馬力，把音量推到最大",shape=box,color=blue];
		j2181855095 -> j703014375;
	j703014375 [label="可是現在？此時此刻？我感覺就像飆上雲端，靠著某種我聽都*沒聽過的*燃料推動著",shape=box,color=blue];
		j703014375 -> j2219583055;
		j703014375 -> j3669136788;
	j2219583055 [label="然後呢？",shape=box,color=red];
		j2219583055 -> j910551326;
	j3669136788 [label="虛空可是劑猛藥啊。",shape=box,color=red];
		j3669136788 -> j1597400300;
	j910551326 [label="站在舞台上，那個新我感覺就像……活了過來，真真正正地活著，比以往任何時候都更貼近最真實的自己。那種感覺太美妙了，像是徹底解放了一樣。我感覺自己在飛翔",shape=box,color=blue];
		j910551326 -> j2449884564;
	j1597400300 [label="什麼？",shape=box,color=blue];
		j1597400300 -> j695097278;
	j2449884564 [label="我們在霍爾瓦尼亞舉辦了一場所有人都絕不會忘記的演出。那個混蛋想讓我們給他們希望？信念？我們做到了，我們讓他們相信自己",shape=box,color=blue];
		j2449884564 -> j1029167170;
	j695097278 [label="別管那個了，繼續。",shape=box,color=red];
		j695097278 -> j910551326;
	j1029167170 [label="然後我們就看到他們在掀翻清剿隊的卡車，還在推倒雕像，哈哈哈",shape=box,color=blue];
		j1029167170 -> j2412035396;
	j2412035396 [label="那小混蛋氣得跳腳……",shape=box,color=blue];
		j2412035396 -> j439042788;
	j439042788 [label="早該料到這種事不可能沒代價……",shape=box,color=blue];
		j439042788 -> j40079481;
	j40079481 [label="嗯……他們……",shape=box,color=blue];
		j40079481 -> j1047080099;
		j40079481 -> j1504415214;
	j1047080099 [label="我聽說了。",shape=box,color=red];
		j1047080099 -> j3648683742;
	j1504415214 [label="出了什麼事……？",shape=box,color=red];
		j1504415214 -> j1619188024;
	j3648683742 [label="嗯。",shape=box,color=blue];
		j3648683742 -> j554910432;
	j1619188024 [label="那個雜碎打算搞一場屬於他的表演，不管用的是什麼手段。但這次？不再是演唱會了",shape=box,color=blue];
		j1619188024 -> j2463634480;
	j554910432 [label="我根本無法阻止他們，他們人數太多了，我一個人根本無力應對。但你……我看你宛如砍瓜切菜一般對付他們……",shape=box,color=blue];
		j554910432 -> j1672161975;
	j2463634480 [label="這種戲碼還真是一生一次……",shape=box,color=blue];
		j2463634480 -> j554910432;
	j1672161975 [label="我這副模樣活像隻剛出生的長頸鹿，還在摸索怎麼控制自己的腿",shape=box,color=blue];
		j1672161975 -> j1553587384;
	j1553587384 [label="我什麼都做不了……只能眼睜睜看著他們死去……",shape=box,color=blue];
		j1553587384 -> j3661772245;
	j3661772245 [label="那個混蛋還在全國電視台直播這一切……",shape=box,color=blue];
		j3661772245 -> j2069644684;
	j2069644684 [label="他還得意洋洋地吹噓著這收視率，像這有什麼值得驕傲似的……",shape=box,color=blue];
		j2069644684 -> j1483273324;
		j2069644684 -> j1280387613;
		j2069644684 -> j2085800286;
		j2069644684 -> j1441720598;
	j1483273324 [label="那之後你怎麼做？",shape=box,color=red];
		j1483273324 -> j1038177767;
	j1280387613 [label="我痛恨這世上竟然會有這種人。",shape=box,color=red];
		j1280387613 -> j950712427;
	j2085800286 [label="我真的、真的很抱歉，弗烈爾……",shape=box,color=red];
		j2085800286 -> j4184662488;
	j1441720598 [label="我真希望我能做些什麼來改變這一切，但……",shape=box,color=red];
		j1441720598 -> j124174946;
	j1038177767 [label="算是把火氣發洩掉一些了",shape=box,color=blue];
		j1038177767 -> j3949715084;
	j950712427 [label="不能讓自己被仇恨吞噬。即使身為士兵，每天都得殺戮，也不能——",shape=box,color=blue];
		j950712427 -> j3448265332;
	j4184662488 [label="+5 Chemistry",color=orange];
		j4184662488 -> j576662258;
	j124174946 [label="+5 Chemistry",color=orange];
		j124174946 -> j572037866;
	j3949715084 [label="無論好壞",shape=box,color=blue];
		j3949715084 -> j2964244061;
	j3448265332 [label="我會試著不去憎恨他們，但如果另一個選擇是完全麻木沒有感覺，那反而更糟，對吧？",shape=box,color=blue];
		j3448265332 -> j1177543499;
	j576662258 [label="世事無常，世界上經歷悲劇的我不是第一個，我也不是最後一個",shape=box,color=blue];
		j576662258 -> j716347977;
	j572037866 [label="不，我懂了。卡婭——啊，抱歉，她比較喜歡別人叫她 Nova，——她有解釋給我聽。時間旅行確實不好理解",shape=box,color=blue];
		j572037866 -> j3565047931;
	j2964244061 [label="不過……趁我們還在談論我的……轉變時，我突然想到一個問題。",shape=box,color=blue];
		j2964244061 -> j375934178;
	j1177543499 [label="你明白嗎？有些事如果我們不經歷，後果可能會更嚴重。",shape=box,color=blue];
		j1177543499 -> j1522322064;
		j1177543499 -> j1565296769;
	j716347977 [label="看看四周，每個人都曾失去過重要的人。愛與哀傷才真正定義了我們是誰。",shape=box,color=blue];
		j716347977 -> j1177543499;
	j3565047931 [label="而且……世事無常，世界上經歷悲劇的我不是第一個，我也不是最後一個",shape=box,color=blue];
		j3565047931 -> j2420564506;
	j375934178 [label="Boolean FlareInfestation2 is now true.",color=orange];
		j375934178 -> j3509223206;
	j1522322064 [label="如果能避免毫無意義的殺戮，我當然樂意，但，是的。",shape=box,color=red];
		j1522322064 -> j4000246776;
	j1565296769 [label="的確。",shape=box,color=red];
		j1565296769 -> j4000246776;
	j2420564506 [label="但還是謝謝你。我很感激你願意嘗試，這對我來說真的很重要。",shape=box,color=blue];
		j2420564506 -> j2964244061;
	j3509223206 [label="這種感染……當源拓氏將菌株注入某人體內……究竟有多少影響是由菌株本身來決定的……？",shape=box,color=blue];
		j3509223206 -> j514261164;
	j4000246776 [label="嘿，被你說中了。",shape=box,color=blue];
		j4000246776 -> j2964244061;
	j514261164 [label="被注射者自身又對情況有多少影響呢……？",shape=box,color=blue];
		j514261164 -> j2902571500;
	j2902571500 [label="先天的影響有多大？後天的因素又有多少……？",shape=box,color=blue];
		j2902571500 -> j1355949540;
		j2902571500 -> j840088921;
	j1355949540 [label="Warframe 和原型 Warframe 之間似乎情況並不相同。",shape=box,color=red];
		j1355949540 -> j793794455;
	j840088921 [label="老實說，我不知道。我只能猜測。",shape=box,color=red];
		j840088921 -> j4121628804;
	j793794455 [label="就算你是胡編的，但這已經是我唯一的選擇了。但拜託快一點……以防",shape=box,color=blue];
		j793794455 -> j669675578;
	j4121628804 [label="拜託，猜測也總比什麼都沒有好。但拜託快一點……以防……",shape=box,color=blue];
		j4121628804 -> j2860278103;
		j4121628804 -> j669675578;
	j669675578 [label="「以防」什麼？",shape=box,color=red];
		j669675578 -> j56927204;
	j2860278103 [label="……好吧。",shape=box,color=red];
		j2860278103 -> j1068295637;
	j56927204 [label="沒有什麼。求求你了，請把你剛才說的話解釋清楚",shape=box,color=blue];
		j56927204 -> j1554226358;
		j56927204 -> j1382607783;
	j1068295637 [label="我覺得 Warframe 會吞噬幾乎全部的人格，只是偶爾會遺漏一些零散部份。但源拓氏用來創造原型 Warframe 的菌株，正是來自這些 Warframe。",shape=box,color=red];
		j1068295637 -> j1970280713;
	j1554226358 [label="好吧……",shape=box,color=red];
		j1554226358 -> j1068295637;
	j1382607783 [label="不，弗烈爾，一定有事不對勁，告訴我吧！為什麼我要快？「以防」什麼？",shape=box,color=red];
		j1382607783 -> j3005690246;
	j1970280713 [label="所以你同時融合了自己的人格，還有那些菌株所來自的原本 Warframe。",shape=box,color=red];
		j1970280713 -> j2307214729;
	j3005690246 [label="這不是我的錯……這根本不是我的錯！你明白嗎？！可惡……可惡！",shape=box,color=blue];
		j3005690246 -> j1253797845;
	j2307214729 [label="也就是說……她不是我。哦，感謝太尊啊，真的太好了！你完全不知道這個消息有多讓我安心",shape=box,color=blue];
		j2307214729 -> j3292288683;
	j1253797845 [label="Check boolean FlareLizzie1",color=orange];
		j1253797845 -> j145207193 [label=true,color=green];
		j1253797845 -> j2551528817 [label=false,color=brown];
	j3292288683 [label="Check boolean FlareLizzie1",color=orange];
		j3292288683 -> j478737249 [label=true,color=green];
		j3292288683 -> j3787589031 [label=false,color=brown];
	j2551528817 [label="Boolean FlareLizzie1 is now true.",color=orange];
		j2551528817 -> j261191027;
	j478737249 [label="你又提到「她」了，「她」到底是誰啊？",shape=box,color=red];
		j478737249 -> j3688629284;
	j3787589031 [label="等等，什麼？她？「她」是誰？",shape=box,color=red];
		j3787589031 -> j1942003079;
	j3688629284 [label="這是我們需要解決的一個問題……而且，我很抱歉，因為接下來會發生的事對你來說可能會很糟糕",shape=box,color=blue];
		j3688629284 -> j145207193;
	j1942003079 [label="抱歉，我現在無法再說下去了",shape=box,color=blue];
		j1942003079 -> j2551528817;
}