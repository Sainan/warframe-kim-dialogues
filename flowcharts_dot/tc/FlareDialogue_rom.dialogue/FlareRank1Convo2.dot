	141 [label="那之後你怎麼做？",shape=box,color=red];
		141 -> 145;
	142 [label="我痛恨這世上竟然會有這種人。",shape=box,color=red];
		142 -> 146;
	143 [label="我真的、真的很抱歉，弗烈爾……",shape=box,color=red];
