		167 -> 169;
	168 [label="就算你是胡編的，但這已經是我唯一的選擇了。但拜託快一點……以防",shape=box,color=blue];
		168 -> 170;
	169 [label="拜託，猜測也總比什麼都沒有好。但拜託快一點……以防……",shape=box,color=blue];
