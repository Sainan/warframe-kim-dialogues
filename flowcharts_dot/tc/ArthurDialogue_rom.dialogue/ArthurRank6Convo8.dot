		3543 -> 3545;
	3544 [label="哦？是什麼？",shape=box,color=red];
		3544 -> 3545;
	3545 [label="伏地諾完全不知道傳識怎麼運作。",shape=box,color=blue];
		3545 -> 3546;
	3546 [label="你就像肯特・克拉克和超漢一樣，他從來沒有見過你的兩個 warframe 出現在同個地方。",shape=box,color=blue];
		3546 -> 3547;
	3547 [label="在他腦海裡，有一群……精神錯亂的超級士兵在和六煞幫到處亂跑！",shape=box,color=blue];
		3547 -> 3548;
		3547 -> 3549;
	3548 [label="他不知道的事倒是可以傷害他，對吧？<RETRO_EMOJI_COOLARMSUP>",shape=box,color=red];
		3548 -> 3550;
	3549 [label="哈哈！我從來沒想過這點。",shape=box,color=red];
		3549 -> 3551;
	3550 [label="確實。我不打算去當那個糾正他的人。",shape=box,color=blue];
		3550 -> 3552;
	3551 [label="我不打算去當那個糾正他的人。但我難以想像他自以為發生什麼事。",shape=box,color=blue];
		3551 -> 3552;
	3552 [label="難怪他會對我們有這麼多猜疑。哈！差點就要為這可憐的小混蛋感到難過了。",shape=box,color=blue];
		3552 -> 3553;
	3553 [label="差點。",shape=box,color=blue];
		3553 -> 3554;
