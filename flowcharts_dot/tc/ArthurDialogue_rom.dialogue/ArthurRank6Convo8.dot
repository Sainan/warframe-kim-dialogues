digraph {
	3541 [label="ArthurRank6Convo8 begins.",color=orange];
		3541 -> 3542;
	3542 [label="你知道嗎，今天早上我突然意識到一件事，害我笑得停不下來。",shape=box,color=blue];
		3542 -> 3543;
		3542 -> 3544;
