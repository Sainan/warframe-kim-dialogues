digraph {
	"ArthurRank6Convo8 begins." [color=orange];
		"ArthurRank6Convo8 begins." -> j1436724982;
	j1436724982 [label="你知道嗎，今天早上我突然意識到一件事，害我笑得停不下來。",shape=box,color=blue];
		j1436724982 -> j1916436779;
		j1436724982 -> j2850483214;
	j1916436779 [label="請說。",shape=box,color=red];
		j1916436779 -> j3324738391;
	j2850483214 [label="哦？是什麼？",shape=box,color=red];
		j2850483214 -> j3324738391;
	j3324738391 [label="伏地諾完全不知道傳識怎麼運作。",shape=box,color=blue];
		j3324738391 -> j1549895340;
	j1549895340 [label="你就像肯特・克拉克和超漢一樣，他從來沒有見過你的兩個 warframe 出現在同個地方。",shape=box,color=blue];
		j1549895340 -> j1583649284;
	j1583649284 [label="在他腦海裡，有一群……精神錯亂的超級士兵在和六煞幫到處亂跑！",shape=box,color=blue];
		j1583649284 -> j3762081982;
		j1583649284 -> j1530153515;
	j3762081982 [label="他不知道的事倒是可以傷害他，對吧？<RETRO_EMOJI_COOLARMSUP>",shape=box,color=red];
		j3762081982 -> j3836601861;
	j1530153515 [label="哈哈！我從來沒想過這點。",shape=box,color=red];
		j1530153515 -> j3098093089;
	j3836601861 [label="確實。我不打算去當那個糾正他的人。",shape=box,color=blue];
		j3836601861 -> j888589681;
	j3098093089 [label="我不打算去當那個糾正他的人。但我難以想像他自以為發生什麼事。",shape=box,color=blue];
		j3098093089 -> j888589681;
	j888589681 [label="難怪他會對我們有這麼多猜疑。哈！差點就要為這可憐的小混蛋感到難過了。",shape=box,color=blue];
		j888589681 -> j2316627644;
	j2316627644 [label="差點。",shape=box,color=blue];
		j2316627644 -> "Chat ends.";
	"Chat ends." [color=orange];
}