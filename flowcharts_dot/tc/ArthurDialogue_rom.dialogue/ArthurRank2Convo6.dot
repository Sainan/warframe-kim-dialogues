	2979 [label="怎麼說？",shape=box,color=blue];
		2979 -> 2980;
		2979 -> 2981;
	2975 [label="抱歉，我在戰區裡有更重要的事情要做。",shape=box,color=blue];
		2975 -> 2976;
	2978 [label="Chat ends.",color=orange];
	2980 [label="有時候他會認為自己格格不入。我在想玩一場「團體遊戲」應該更能讓他感到自己是團隊的一份子。",shape=box,color=red];
		2980 -> 2984;
	2981 [label="我想對他的興趣感興趣可以讓他感到不那麼像外人。而大家是在乎他的。",shape=box,color=red];
		2981 -> 2982;
	2976 [label="Chat ends.",color=orange];
	2984 [label="嗯。",shape=box,color=blue];
		2984 -> 2995;
	2982 [label="我們大家都有自己的愛好。不了，包歉。",shape=box,color=blue];
