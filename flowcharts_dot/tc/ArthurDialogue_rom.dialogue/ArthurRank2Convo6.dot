	2961 [label="我想他已經問過你了嗎？",shape=box,color=red];
		2961 -> 2965;
	2962 [label="他跟我介紹了這個遊戲，我說我會問其他人，看他們想不想一起玩。",shape=box,color=red];
		2962 -> 2966;
	2963 [label="他跟我介紹了這個他想跟大家一起玩的遊戲。好像叫《寓言與先驅》。",shape=box,color=red];
		2963 -> 2969;
	2964 [label="他想玩一款很白癡的遊戲，我說我會問大家看要不要一起玩。",shape=box,color=red];
		2964 -> 2970;
	2965 [label="是的，早在你問我之前，我已經拒絕他了。",shape=box,color=blue];
		2965 -> 2967;
	2966 [label="抱歉，不了。在戰區裡有更值得忙的事。",shape=box,color=blue];
		2966 -> 2968;
	2969 [label="他又開始揪了喔？我還以為崑西把遊戲棋子拿去當靶練習後阿米爾就放棄了。",shape=box,color=blue];
		2969 -> 2971;
		2969 -> 2972;
	2970 [label="別跟我說又是那個《青蛙與蠢事》的玩意兒嗎？",shape=box,color=blue];
		2970 -> 2973;
		2970 -> 2974;
	2967 [label="Chat ends.",color=orange];
	2968 [label="Chat ends.",color=orange];
	2971 [label="我想我們大家都可以放鬆一下，不覺得嗎？",shape=box,color=red];
		2971 -> 2977;
	2972 [label="我覺得如果我們玩的話對他來說意義很重大。",shape=box,color=red];
		2972 -> 2979;
	2973 [label="笑死。《寓言與先驅》，是的。",shape=box,color=red];
		2973 -> 2975;
	2974 [label="是啊，我只是想讓他開心才問的。",shape=box,color=red];
		2974 -> 2975;
	2977 [label="我們大家都有自己放空的方式。抱歉。不了。",shape=box,color=blue];
