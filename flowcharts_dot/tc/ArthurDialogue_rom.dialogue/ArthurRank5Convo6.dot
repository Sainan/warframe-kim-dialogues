	2520 [label="Check boolean ArthurChristopherTold",color=orange];
		2520 -> 2521 [label=true,color=green];
		2520 -> 2522 [label=false,color=brown];
	2497 [label="愛琳娜已經告訴了我她那一半克里斯多福的故事。",shape=box,color=red];
		2497 -> 2502;
	2499 [label="他叫克里斯多福。他總是為附近需要幫助的孩子們挺身而出。",shape=box,color=blue];
		2499 -> 2500;
	2506 [label="我告訴過你我是如何得到它的。源拓氏博士用它刺穿了我。是在他把我變成這樣不久後……",shape=box,color=blue];
		2506 -> 2517;
	2496 [label="我是在源拓氏博士用它刺穿我後得到的。是在他把我變成這樣不久後……",shape=box,color=blue];
		2496 -> 2507;
	2521 [label="是克里斯多福買給我的……作為加入赤血守望的禮物。",shape=box,color=blue];
		2521 -> 2523;
	2522 [label="很久以前，我曾經有個……老朋友。",shape=box,color=blue];
		2522 -> 2524;
	2502 [label="Check boolean EleanorDating",color=orange];
		2502 -> 2503 [label=true,color=green];
		2502 -> 2504 [label=false,color=brown];
	2500 [label="他更壯碩、更結實──更機靈。要不是他一直都那麼友善的話，你早就想一腳把他踹出去給卡車撞了。",shape=box,color=blue];
		2500 -> 2501;
