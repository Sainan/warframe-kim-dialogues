	2471 [label="但說句公道話，我也一直在對你做同樣的事，關於那些造就了我的經歷──渡域還有其它點點滴滴……",shape=box,color=red];
		2471 -> 2474;
	2472 [label="談論自己陰暗的過去對任何人來說都不容易也什麼有趣的事。",shape=box,color=red];
		2472 -> 2474;
	2473 [label="是啊。是時候當個男子漢了，牛仔。",shape=box,color=red];
		2473 -> 2475;
	2474 [label="好吧，重點是，你一直待在這裡想從我口中得知完整的故事──",shape=box,color=blue];
