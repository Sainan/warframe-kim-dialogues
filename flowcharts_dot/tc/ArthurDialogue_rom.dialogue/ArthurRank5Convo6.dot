		2571 -> 2574 [label=false,color=brown];
	2556 [label="Update boolean ArthurChristopherTold",color=orange];
		2556 -> 2490;
	2572 [label="我……是啊。但，那好……沉重。要和我去喝一杯嗎？然後我們找個安靜的地方來當面聊，要嗎？",shape=box,color=red];
		2572 -> 2576;
	2573 [label="是的，我倆都失去了一些東西。但看看我們找到了什麼。朋友、家人。彼此。",shape=box,color=red];
		2573 -> 2578;
	2574 [label="你失去了……一個傢伙？這一切都是因為一個傢伙？我還以為是有多戲劇性的故事。",shape=box,color=red];
		2574 -> 2582;
	2576 [label="+20 Chemistry",color=orange];
