	2476 [label="Chat ends.",color=orange];
	2479 [label="我是怎麼來到這裡的，我是怎麼變成現在這樣的，",shape=box,color=blue];
		2479 -> 2478;
	2478 [label="Check boolean ArthurSkana",color=orange];
