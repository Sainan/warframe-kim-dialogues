		2570 -> 2571;
	2554 [label="亞瑟，我很抱歉……",shape=box,color=red];
		2554 -> 2556;
	2555 [label="戰爭中沒有人是贏家。沒有人。",shape=box,color=red];
		2555 -> 2556;
