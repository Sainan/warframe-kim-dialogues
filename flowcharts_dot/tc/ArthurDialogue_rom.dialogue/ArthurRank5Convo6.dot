		2507 -> 2511 [label=false,color=brown];
	2523 [label="他打算在我到達那裡的當晚親手送給我的。",shape=box,color=blue];
		2523 -> 2525;
	2524 [label="Check boolean EleanorChristopherTold",color=orange];
		2524 -> 2526 [label=true,color=green];
		2524 -> 2527 [label=false,color=brown];
	2503 [label="我……非常感謝你一直待在她身邊陪著她。感謝你成為那個終於可以幫助她度過那天失去重要的人的傷痛。",shape=box,color=blue];
		2503 -> 2498;
	2504 [label="那天，她失去的比我……多更多。",shape=box,color=blue];
		2504 -> 2505;
	2501 [label="總而言之，在成長的過程中，我很想成為像他那樣的人。不管怎麼樣都要追隨他的腳步。",shape=box,color=blue];
		2501 -> 2540;
	2518 [label="但當你問我頭巾的事的時候我迴避了問題。",shape=box,color=blue];
		2518 -> 2520;
	2519 [label="但對我來說重要的不是那把劍，而是那條頭巾。",shape=box,color=blue];
		2519 -> 2520;
	2508 [label="變成了粗獷、帥氣、性感的超級英雄？",shape=box,color=red];
		2508 -> 2512;
	2509 [label="變成了烤箱？ : P",shape=box,color=red];
		2509 -> 2513;
	2510 [label="這叫「warframe」。",shape=box,color=red];
		2510 -> 2514;
	2511 [label="變成了你。你就是你。內在的你，那才是真正的你。",shape=box,color=red];
		2511 -> 2515;
	2525 [label="結果等待我的是它……而不是他。",shape=box,color=blue];
		2525 -> 2528;
		2525 -> 2529;
	2526 [label="是克里斯多福嗎？愛琳娜告訴了我一些他的事。",shape=box,color=red];
		2526 -> 2533;
	2527 [label="它本來是要當作一份禮物的。他沒有辦法親手送給我了。",shape=box,color=blue];
		2527 -> 2530;
		2527 -> 2531;
	2498 [label="她講得好像你倆都失去了某個特別的人。",shape=box,color=red];
		2498 -> 2534;
	2505 [label="但這聽起來好像你倆都失去了某個對你們很重要的人。",shape=box,color=red];
		2505 -> 2534;
	2540 [label="我很幸運能夠稱我的偶像為我最好的朋友。",shape=box,color=blue];
		2540 -> 2541;
	2512 [label="呵，謝啦。",shape=box,color=blue];
		2512 -> 2516;
	2513 [label="呵呵。",shape=box,color=blue];
		2513 -> 2516;
	2514 [label="我……永遠不會適應這個叫法。",shape=box,color=blue];
		2514 -> 2516;
	2515 [label="謝謝。我必須記住這點。",shape=box,color=blue];
		2515 -> 2516;
	2528 [label="亞瑟，他遭遇到的事不是你的錯。",shape=box,color=red];
		2528 -> 2532;
	2529 [label="哎呀……我很抱歉。",shape=box,color=red];
		2529 -> 2533;
	2533 [label="戰爭會帶走我們最優秀的人。",shape=box,color=blue];
		2533 -> 2557;
	2530 [label="發生什麼事？",shape=box,color=red];
		2530 -> 2533;
	2531 [label="我深感遺憾。",shape=box,color=red];
		2531 -> 2533;
	2534 [label="他是我的一個好朋友，而且我一直像大哥一樣敬重和敬慕他。",shape=box,color=blue];
		2534 -> 2535;
	2541 [label="所以當他一到法定年齡就加入國王陛下的軍隊服役時，我迫不及待地期盼著自己能夠快點長大去做同樣的事。",shape=box,color=blue];
		2541 -> 2542;
	2516 [label="好吧，這就是我如何得到這把劍的。",shape=box,color=blue];
		2516 -> 2519;
	2532 [label="我知道。但我的職責是繼續前行。",shape=box,color=blue];
		2532 -> 2533;
	2557 [label="Check boolean EleanorDating",color=orange];
		2557 -> 2559 [label=true,color=green];
		2557 -> 2558 [label=false,color=brown];
	2535 [label="克里斯多福代表了我在這個世界上想要成為的一切──高尚、英勇和無私。",shape=box,color=blue];
		2535 -> 2536;
	2542 [label="事實上，別管他有……",shape=box,color=blue];
		2542 -> 2543;
	2559 [label="謝謝你一直待在她身邊陪著她，幫助她療傷。",shape=box,color=blue];
