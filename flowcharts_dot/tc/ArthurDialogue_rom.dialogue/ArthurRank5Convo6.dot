		2483 -> 2484;
	2484 [label="其實，啤酒可能會好一點。",shape=box,color=blue];
		2484 -> 2485;
	2485 [label="我會盡量讓這個故事簡短。日尊知道我已經沒有必要再去回想這種鳥事了。",shape=box,color=blue];
		2485 -> 2486;
