		2558 -> 2561 [label=false,color=brown];
	2536 [label="他更壯碩、更結實──更機靈。要不是他一直都那麼友善的話，你早就想一腳把他踹出去給卡車撞了。",shape=box,color=blue];
		2536 -> 2537;
	2543 [label="聽著，漂泊者……這部分的故事不該由我來講。這是愛琳娜的故事。但我只能說這麼多。當克里斯多福前去參戰時，",shape=box,color=blue];
		2543 -> 2544;
	2561 [label="但有時候，陳年的老鬼魂是很受待見的。",shape=box,color=blue];
		2561 -> 2562;
	2560 [label="你待在這裡陪著我，有助我治癒很多過去的舊傷痛。",shape=box,color=blue];
		2560 -> 2561;
	2537 [label="所以當他一到法定年齡就加入國王陛下的軍隊服役時，我迫不及待地期盼著自己能夠快點長大去做同樣的事。",shape=box,color=blue];
		2537 -> 2538;
	2544 [label="我不是唯一一個失落地看著他離開的人。",shape=box,color=blue];
		2544 -> 2545;
		2544 -> 2546;
	2562 [label="他們提醒著我們為什麼我們還在這裡。我們以前是誰。",shape=box,color=blue];
		2562 -> 2563;
	2538 [label="想像一下可憐的愛琳娜，不得不目送她的未婚夫和她的孿生弟弟去前去參戰。",shape=box,color=blue];
		2538 -> 2539;
	2545 [label="他對你來說一定很重要。",shape=box,color=red];
		2545 -> 2547;
	2546 [label="接下來發生了什麼事？",shape=box,color=red];
		2546 -> 2549;
	2563 [label="我們失去了誰。",shape=box,color=blue];
		2563 -> 2564;
	2539 [label="她從來就不信任權威。但在我們兩個發生那些事之後，她再也不會了。",shape=box,color=blue];
		2539 -> 2775;
		2539 -> 2776;
	2547 [label="他是。",shape=box,color=blue];
		2547 -> 2548;
	2549 [label="克里斯多福在幕後動用了關係。把我安插到跟他同一個團裡，也就是第三營隊──赤血守望。",shape=box,color=blue];
		2549 -> 2550;
	2564 [label="還有我們仍在為誰而戰。",shape=box,color=blue];
		2564 -> 2565;
		2564 -> 2566;
	2775 [label="這也不能怪她。",shape=box,color=red];
		2775 -> 2549;
	2776 [label="確實。",shape=box,color=red];
		2776 -> 2549;
	2548 [label="非常重要。",shape=box,color=blue];
		2548 -> 2549;
	2550 [label="但在我抵達那裡的前一週……發生了一件事。路邊炸彈。",shape=box,color=blue];
		2550 -> 2551;
	2565 [label="我……從來就不用真正為了誰而戰。直到最近。這是他們叫我「漂泊者」的其中一個原因。",shape=box,color=red];
		2565 -> 2567;
	2566 [label="我的虛幻啤酒都被我喝光了。現在我有點想喝一瓶真的。",shape=box,color=red];
		2566 -> 2568;
	2551 [label="而像眾多優秀的男士和女士一樣，像眾多優良的士兵一樣，",shape=box,color=blue];
		2551 -> 2552;
	2567 [label="我說不出來我倆誰的遭遇更糟糕。兩個都糟還是都不糟。",shape=box,color=blue];
		2567 -> 2569;
	2568 [label="但你的遭遇也沒有比我的好多少，對吧？",shape=box,color=blue];
		2568 -> 2569;
	2552 [label="他成為了又另一個在別人名單上的數字。",shape=box,color=blue];
		2552 -> 2553;
	2569 [label="我們都是戰爭下的造物，只是以不同方式。我倆在生命中都失去了許多。",shape=box,color=blue];
		2569 -> 2570;
	2553 [label="但我仍然是個天真的傻瓜。我笨到急切地想要承接他遺留下來的責任……",shape=box,color=blue];
		2553 -> 2554;
		2553 -> 2555;
