digraph {
	2929 [label="ArthurAmirHack begins.",color=orange];
		2929 -> 2930;
	2930 [label="嘿……亞瑟……怎麼樣？",shape=box,color=red];
		2930 -> 2927;
	2927 [label="br00dsw0rd: 嗯？哦，很好啊。你呢？",shape=box,color=blue];
		2927 -> 2931;
		2927 -> 2932;
		2927 -> 2933;
	2931 [label="很好……所以……有什麼新鮮事嗎？",shape=box,color=red];
		2931 -> 2928;
	2932 [label="天氣好像很不錯，對吧？",shape=box,color=red];
		2932 -> 2934;
	2933 [label="那個當地的球隊怎麼樣了？",shape=box,color=red];
		2933 -> 2935;
	2928 [label="br00dsw0rd: 夥計，我們一個小時前才剛聊過，關於──",shape=box,color=blue];
		2928 -> 2936;
	2934 [label="br00dsw0rd: 這樣很無聊欸，每次都同個──",shape=box,color=blue];
		2934 -> 2936;
	2935 [label="br00dsw0rd: 什麼當地球──",shape=box,color=blue];
		2935 -> 2936;
	2936 [label="br00dsw0rd: 發生什麼事？你有點怪。",shape=box,color=blue];
		2936 -> 2937;
		2936 -> 2938;
	2937 [label="……沒發生什麼事。",shape=box,color=red];
		2937 -> 2939;
	2938 [label="阿米爾又在無聊了。看看你的暱稱。",shape=box,color=red];
		2938 -> 2941;
	2939 [label="br00dsw0rd: 我不相信你，我──",shape=box,color=blue];
		2939 -> 2940;
	2941 [label="br00dsw0rd: 他把它從寶劍改成悶劍了？！",shape=box,color=blue];
		2941 -> 2942;
	2940 [label="br00dsw0rd: 等一下。",shape=box,color=blue];
		2940 -> 2941;
	2942 [label="br00dsw0rd: 我一點都不會悶啊！",shape=box,color=blue];
		2942 -> 2943;
		2942 -> 2944;
		2942 -> 2945;
	2943 [label="(´･_･`) 夥計，那圖示好像不是這麼一回事說。",shape=box,color=red];
		2943 -> 2946;
	2944 [label="少來，你明明就會。",shape=box,color=red];
		2944 -> 2947;
	2945 [label="呵呵，他只是在開你玩笑。你知道他很仰慕你的。哈哈",shape=box,color=red];
		2945 -> 2947;
	2946 [label="br00dsw0rd: ……好吧。好吧。可能有一點吧。",shape=box,color=blue];
		2946 -> 2948;
	2947 [label="br00dsw0rd: 唉。",shape=box,color=blue];
		2947 -> 2948;
	2948 [label="br00dsw0rd: 就……叫他把它給改回去，好嗎？在其他人注意到之前。",shape=box,color=blue];
		2948 -> 2950;
	2950 [label="+20 Chemistry",color=orange];
		2950 -> 2949;
	2949 [label="br00dsw0rd: 那小子是遊手好閒的最佳典範……我們得幫他找更多有趣的愛好……",shape=box,color=blue];
		2949 -> 241;
	241 [label="{\"Id\":241,\"Incoming\":[2949],\"Outgoing\":[2951],\"GraphPos\":[-26707,51022],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/JabirDialogue_rom.dialogue\",\"Tag\":\"AmirHack2\",\"Value\":0}]}",color=orange];
