digraph {
	3518 [label="ArthurRank6Convo6 begins.",color=orange];
		3518 -> 3519;
		3518 -> 3520;
	3519 [label="怎麼樣，亞？",shape=box,color=red];
		3519 -> 3521;
	3520 [label="最近還好嗎？",shape=box,color=red];
		3520 -> 3521;
	3521 [label="葵磁化了我的鑰匙，然後把它們附著在商場主中庭天花板的工字樑上。",shape=box,color=blue];
		3521 -> 3522;
	3522 [label="你不會正巧有任何會飛行的 warframe，有嗎？",shape=box,color=blue];
		3522 -> 3523;
		3522 -> 3524;
	3523 [label="嗯，沒有，抱歉。你得靠自己了。",shape=box,color=red];
		3523 -> 3525;
	3524 [label="哈哈。有的。我馬上過來。",shape=box,color=red];
		3524 -> 3526;
	3525 [label="唉。好吧，我自己想辦法。不管怎樣還是謝了。",shape=box,color=blue];
		3525 -> 3527;
	3526 [label="太棒了。 我對它們投擲標槍已經投到很煩了。",shape=box,color=blue];
		3526 -> 3528;
