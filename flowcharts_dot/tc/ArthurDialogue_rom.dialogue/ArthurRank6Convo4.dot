digraph {
	3433 [label="ArthurRank6Convo4 begins.",color=orange];
		3433 -> 3434;
	3434 [label="問個奇怪的問題。太空有玩具嗎？",shape=box,color=blue];
		3434 -> 3435;
		3434 -> 3436;
	3435 [label="像兒童玩具嗎？當然有。",shape=box,color=red];
		3435 -> 3437;
	3436 [label="哪一種……玩具？",shape=box,color=red];
		3436 -> 3438;
	3437 [label="呵。真的嗎？",shape=box,color=blue];
		3437 -> 3439;
	3438 [label="噢，日尊。我不是指那種玩具，你明明就知道！",shape=box,color=blue];
		3438 -> 3440;
	3439 [label="很難想像在好幾千年後的未來，",shape=box,color=blue];
		3439 -> 3441;
	3440 [label="我指的是兒童玩具。娃娃。可動人偶。這類東西。",shape=box,color=blue];
		3440 -> 3442;
		3440 -> 3448;
	3441 [label="孩子們還是會圍坐在一起，用小人重現故事，玩著「強盜」或「拯救公主」的小遊戲。",shape=box,color=blue];
		3441 -> 3444;
		3441 -> 3445;
		3441 -> 3446;
	3442 [label="就是想鬧一下你而已。 : P",shape=box,color=red];
		3442 -> 3447;
	3448 [label="不，我們沒有。[結束]",shape=box,color=red];
		3448 -> 3452;
	3444 [label="怎麼會問起這個？",shape=box,color=red];
		3444 -> 3449;
	3445 [label="那你小時候都玩些什麼？",shape=box,color=red];
		3445 -> 3450;
	3446 [label="我們玩的遊戲有不同的名稱，但我確實有玩具。",shape=box,color=red];
		3446 -> 3451;
	3447 [label="有啊，我們當然有。",shape=box,color=red];
		3447 -> 3437;
	3452 [label="Chat ends.",color=orange];
	3449 [label="我其實在觀看阿米爾在玩他的其中一個街機遊戲。",shape=box,color=blue];
		3449 -> 3453;
	3450 [label="儘管我們的文化之間有諸多不同，孩子們還是一樣會……坐下來玩玩具，想到這點真的很令人欣慰。",shape=box,color=blue];
		3450 -> 3454;
	3451 [label="像是？",shape=box,color=blue];
		3451 -> 3455;
		3451 -> 3456;
	3453 [label="然後我在想，我願意付出一切來在生命中再次體驗那種歡樂。",shape=box,color=blue];
		3453 -> 3457;
	3454 [label="我曾經有個可動人偶。動作安格斯。完全不意外，他是個士兵。",shape=box,color=blue];
		3454 -> 3458;
	3455 [label="各種各樣的小雕像，還有毛絨動物，和積木。典型的兒童玩具。",shape=box,color=red];
		3455 -> 3450;
	3456 [label="我有這麼一個算是禁衛小孩的小雕像，我將它取名為我的一本故事書裡的角色──至尊戰魁。",shape=box,color=red];
		3456 -> 3459;
	3457 [label="我從來就沒有因為葵或阿米爾，甚或現在的卡婭在「幼稚」的事物中找到樂趣而看不起他們。這種事從未困擾過我。",shape=box,color=blue];
		3457 -> 3460;
	3458 [label="在一次冬至慶典，一群大男孩從我這裡偷走了它，還有我的許多其他玩具，然後，嗯……",shape=box,color=blue];
		3458 -> 3461;
	3459 [label="哦，該死。我本該更明智。我很抱歉提起這件事。",shape=box,color=blue];
		3459 -> 3462;
		3459 -> 3463;
	3460 [label="但有時候，我擔心內心裡能夠感受那種喜悅的那部分早已萎縮枯死。",shape=box,color=blue];
		3460 -> 3464;
	3461 [label="故事很長。簡單來說，他們說我「年紀不小了」，不再適合玩洋娃娃。那是我最後一次玩玩具。",shape=box,color=blue];
		3461 -> 3465;
	3462 [label="不，確實不是我最談論的話題。",shape=box,color=red];
		3462 -> 3466;
	3463 [label="沒關係。這不是你的錯。",shape=box,color=red];
		3463 -> 3467;
	3464 [label="有點悲哀，不是嗎？我們告訴孩子們要熱愛某些東西，然後當他們「成熟」時，我們又告訴他們要放棄。",shape=box,color=blue];
		3464 -> 3468;
		3464 -> 3469;
	3465 [label="前幾天，我在看阿米爾玩他的其中一個遊戲。他很顯然對它非常著迷。它給他帶來多少歡樂。而這讓我有點嫉妒，因為我的生活中沒有這種東西。",shape=box,color=blue];
		3465 -> 3464;
	3466 [label="現在我覺得自己像極了傻瓜。",shape=box,color=blue];
		3466 -> 3470;
	3467 [label="我想我們有你想得到的所有普通玩具。積木，毛絨動物，小雕像，洋娃娃。",shape=box,color=red];
		3467 -> 3471;
	3468 [label="我不知道欸。總有一天我們都得長大。我們不能躲藏在虚幻之中。我經歷過切身之痛才學會這一點。",shape=box,color=red];
		3468 -> 3472;
	3469 [label="我覺得人生有可能是苦短且醜陋的。而我們應該盡可能用歡樂、笑聲，和愛來充實它。",shape=box,color=red];
		3469 -> 3473;
	3470 [label="Chat ends.",color=orange];
	3471 [label="我的玩具只是因為整個……虛空的問題而變得更加複雜。",shape=box,color=red];
		3471 -> 3450;
	3472 [label="你說得有道理。我想當它成為取代現實的替代品時，就會有問題。我沒在建議那樣做。",shape=box,color=blue];
		3472 -> 3474;
	3473 [label="你說得對。而我希望我們在面對無論這是什麼的情況……一起向前行時，我們會記得這一點。",shape=box,color=blue];
		3473 -> 3474;
	3474 [label="我發現愛琳娜、韋利米爾、葵和阿米爾在跟弗烈爾和莉慈玩捉迷藏。 崑西說他不能玩，因為這混蛋被抓到作弊，用他的瞄準鏡看穿牆壁。",shape=box,color=blue];
		3474 -> 3475;
	3475 [label="他們都看著我，擔心我會不高興，因為我抓到他們該做正事時反而在打混。",shape=box,color=blue];
		3475 -> 3476;
	3476 [label="呵呵，讓我失望的反而更是因為沒被邀請。但我又不得不擺出嚴肅的領導表情，假裝我對崗位沒人駐守而感到不滿，等等的。",shape=box,color=blue];
		3476 -> 3477;
	3477 [label="但阿米爾有他的遊戲。葵有她的線上男孩。甚至是卡婭也都有她的貼紙和她的吉你夢，儘管世界過早地強加成人責任於她身上。",shape=box,color=blue];
		3477 -> 3478;
		3477 -> 3479;
	3478 [label="你想表達的觀點是什麼？",shape=box,color=red];
		3478 -> 3480;
	3479 [label="我想如果你願意嘗試的話，這是你可以找回的東西。我指的是在玩具和遊戲中找回樂趣。",shape=box,color=red];
		3479 -> 3481;
	3480 [label="老實說？我甚至都不確定。只是覺得缺少了某個很久以前就已經從生活中消失的東西。",shape=box,color=blue];
		3480 -> 3482;
	3481 [label="我現在就能聽到笑聲了。但我想讓我止步不前的就是因為那個原因，對吧？因為尷尬。",shape=box,color=blue];
		3481 -> 3483;
	3482 [label="我不確定我是否能找回它。或者它是否已經太遙遠。但誰又說得準。或許隨著時間，一切變有可能。",shape=box,color=blue];
		3482 -> 3484;
	3483 [label="即使我能夠克服短暫的羞恥，我不確定能不能找回它。但誰又說得準。循環夠多次，或許一切變有可能。",shape=box,color=blue];
		3483 -> 3485;
	3484 [label="Chat ends.",color=orange];
	3485 [label="Chat ends.",color=orange];
}