digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo4 begins." [color=orange];
		"ArthurRank6Convo4 begins." -> j3332397977;
	j3332397977 [label="問個奇怪的問題。太空有玩具嗎？",shape=box,color=blue];
		j3332397977 -> j1096907828;
		j3332397977 -> j2694412324;
	j1096907828 [label="像兒童玩具嗎？當然有。",shape=box,color=red];
		j1096907828 -> j2773528808;
	j2694412324 [label="哪一種……玩具？",shape=box,color=red];
		j2694412324 -> j501249644;
	j2773528808 [label="呵。真的嗎？",shape=box,color=blue];
		j2773528808 -> j2988735896;
	j501249644 [label="噢，日尊。我不是指那種玩具，你明明就知道！",shape=box,color=blue];
		j501249644 -> j3821753827;
	j2988735896 [label="很難想像在好幾千年後的未來，",shape=box,color=blue];
		j2988735896 -> j1065329431;
	j3821753827 [label="我指的是兒童玩具。娃娃。可動人偶。這類東西。",shape=box,color=blue];
		j3821753827 -> j1921907576;
		j3821753827 -> j2883071647;
	j1065329431 [label="孩子們還是會圍坐在一起，用小人重現故事，玩著「強盜」或「拯救公主」的小遊戲。",shape=box,color=blue];
		j1065329431 -> j3888726132;
		j1065329431 -> j1481099304;
		j1065329431 -> j2086035015;
	j1921907576 [label="就是想鬧一下你而已。 : P",shape=box,color=red];
		j1921907576 -> j1848088096;
	j2883071647 [label="不，我們沒有。[結束]",shape=box,color=red];
		j2883071647 -> "Chat ends.";
	j3888726132 [label="怎麼會問起這個？",shape=box,color=red];
		j3888726132 -> j2680355406;
	j1481099304 [label="那你小時候都玩些什麼？",shape=box,color=red];
		j1481099304 -> j2215924950;
	j2086035015 [label="我們玩的遊戲有不同的名稱，但我確實有玩具。",shape=box,color=red];
		j2086035015 -> j3054175453;
	j1848088096 [label="有啊，我們當然有。",shape=box,color=red];
		j1848088096 -> j2773528808;
	"Chat ends." [color=orange];
	j2680355406 [label="我其實在觀看阿米爾在玩他的其中一個街機遊戲。",shape=box,color=blue];
		j2680355406 -> j1719417592;
	j2215924950 [label="儘管我們的文化之間有諸多不同，孩子們還是一樣會……坐下來玩玩具，想到這點真的很令人欣慰。",shape=box,color=blue];
		j2215924950 -> j4265225867;
	j3054175453 [label="像是？",shape=box,color=blue];
		j3054175453 -> j2163013818;
		j3054175453 -> j288157074;
	j1719417592 [label="然後我在想，我願意付出一切來在生命中再次體驗那種歡樂。",shape=box,color=blue];
		j1719417592 -> j3751688548;
	j4265225867 [label="我曾經有個可動人偶。動作安格斯。完全不意外，他是個士兵。",shape=box,color=blue];
		j4265225867 -> j889794808;
	j2163013818 [label="各種各樣的小雕像，還有毛絨動物，和積木。典型的兒童玩具。",shape=box,color=red];
		j2163013818 -> j2215924950;
	j288157074 [label="我有這麼一個算是禁衛小孩的小雕像，我將它取名為我的一本故事書裡的角色──至尊戰魁。",shape=box,color=red];
		j288157074 -> j505535616;
	j3751688548 [label="我從來就沒有因為葵或阿米爾，甚或現在的卡婭在「幼稚」的事物中找到樂趣而看不起他們。這種事從未困擾過我。",shape=box,color=blue];
		j3751688548 -> j1673490160;
	j889794808 [label="在一次冬至慶典，一群大男孩從我這裡偷走了它，還有我的許多其他玩具，然後，嗯……",shape=box,color=blue];
		j889794808 -> j207685567;
	j505535616 [label="哦，該死。我本該更明智。我很抱歉提起這件事。",shape=box,color=blue];
		j505535616 -> j401987286;
		j505535616 -> j268590533;
	j1673490160 [label="但有時候，我擔心內心裡能夠感受那種喜悅的那部分早已萎縮枯死。",shape=box,color=blue];
		j1673490160 -> j3474331787;
	j207685567 [label="故事很長。簡單來說，他們說我「年紀不小了」，不再適合玩洋娃娃。那是我最後一次玩玩具。",shape=box,color=blue];
		j207685567 -> j3398981992;
	j401987286 [label="不，確實不是我最談論的話題。",shape=box,color=red];
		j401987286 -> j1151641095;
	j268590533 [label="沒關係。這不是你的錯。",shape=box,color=red];
		j268590533 -> j3330360989;
	j3474331787 [label="有點悲哀，不是嗎？我們告訴孩子們要熱愛某些東西，然後當他們「成熟」時，我們又告訴他們要放棄。",shape=box,color=blue];
		j3474331787 -> j318536369;
		j3474331787 -> j2496347819;
	j3398981992 [label="前幾天，我在看阿米爾玩他的其中一個遊戲。他很顯然對它非常著迷。它給他帶來多少歡樂。而這讓我有點嫉妒，因為我的生活中沒有這種東西。",shape=box,color=blue];
		j3398981992 -> j3474331787;
	j1151641095 [label="現在我覺得自己像極了傻瓜。",shape=box,color=blue];
		j1151641095 -> "Chat ends.";
	j3330360989 [label="我想我們有你想得到的所有普通玩具。積木，毛絨動物，小雕像，洋娃娃。",shape=box,color=red];
		j3330360989 -> j3710851779;
	j318536369 [label="我不知道欸。總有一天我們都得長大。我們不能躲藏在虚幻之中。我經歷過切身之痛才學會這一點。",shape=box,color=red];
		j318536369 -> j2339111676;
	j2496347819 [label="我覺得人生有可能是苦短且醜陋的。而我們應該盡可能用歡樂、笑聲，和愛來充實它。",shape=box,color=red];
		j2496347819 -> j2687762505;
	j3710851779 [label="我的玩具只是因為整個……虛空的問題而變得更加複雜。",shape=box,color=red];
		j3710851779 -> j2215924950;
	j2339111676 [label="你說得有道理。我想當它成為取代現實的替代品時，就會有問題。我沒在建議那樣做。",shape=box,color=blue];
		j2339111676 -> j350212593;
	j2687762505 [label="你說得對。而我希望我們在面對無論這是什麼的情況……一起向前行時，我們會記得這一點。",shape=box,color=blue];
		j2687762505 -> j350212593;
	j350212593 [label="我發現愛琳娜、韋利米爾、葵和阿米爾在跟弗烈爾和莉慈玩捉迷藏。 崑西說他不能玩，因為這混蛋被抓到作弊，用他的瞄準鏡看穿牆壁。",shape=box,color=blue];
		j350212593 -> j787684958;
	j787684958 [label="他們都看著我，擔心我會不高興，因為我抓到他們該做正事時反而在打混。",shape=box,color=blue];
		j787684958 -> j234518012;
	j234518012 [label="呵呵，讓我失望的反而更是因為沒被邀請。但我又不得不擺出嚴肅的領導表情，假裝我對崗位沒人駐守而感到不滿，等等的。",shape=box,color=blue];
		j234518012 -> j3520691042;
	j3520691042 [label="但阿米爾有他的遊戲。葵有她的線上男孩。甚至是卡婭也都有她的貼紙和她的吉你夢，儘管世界過早地強加成人責任於她身上。",shape=box,color=blue];
		j3520691042 -> j1131930364;
		j3520691042 -> j3420811399;
	j1131930364 [label="你想表達的觀點是什麼？",shape=box,color=red];
		j1131930364 -> j3670213999;
	j3420811399 [label="我想如果你願意嘗試的話，這是你可以找回的東西。我指的是在玩具和遊戲中找回樂趣。",shape=box,color=red];
		j3420811399 -> j666126413;
	j3670213999 [label="老實說？我甚至都不確定。只是覺得缺少了某個很久以前就已經從生活中消失的東西。",shape=box,color=blue];
		j3670213999 -> j451346233;
	j666126413 [label="我現在就能聽到笑聲了。但我想讓我止步不前的就是因為那個原因，對吧？因為尷尬。",shape=box,color=blue];
		j666126413 -> j2070235775;
	j451346233 [label="我不確定我是否能找回它。或者它是否已經太遙遠。但誰又說得準。或許隨著時間，一切變有可能。",shape=box,color=blue];
		j451346233 -> "Chat ends.";
	j2070235775 [label="即使我能夠克服短暫的羞恥，我不確定能不能找回它。但誰又說得準。循環夠多次，或許一切變有可能。",shape=box,color=blue];
		j2070235775 -> "Chat ends.";
}