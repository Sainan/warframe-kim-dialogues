digraph {
	3360 [label="ArthurRank6Convo3 begins.",color=orange];
		3360 -> 3361;
	3361 [label="我前幾天與那把吉他進行了一場對話。",shape=box,color=blue];
		3361 -> 3362;
		3361 -> 3363;
	3362 [label="對我來說，我不會很上頭就是了。",shape=box,color=red];
		3362 -> 3364;
	3363 [label="莉慈嗎？所以談得怎麼樣？",shape=box,color=red];
		3363 -> 3365;
	3364 [label="老實說，我還蠻喜歡她的。一旦你能夠……見怪……不怪吧？",shape=box,color=blue];
		3364 -> 3366;
	3365 [label="比我想像中要好。我還蠻喜歡她的。",shape=box,color=blue];
		3365 -> 3366;
	3366 [label="再說，",shape=box,color=blue];
		3366 -> 3367;
	3367 [label="既然她和愛琳娜似乎總是笑著那些只有她們聽得到的笑話。",shape=box,color=blue];
		3367 -> 3368;
	3368 [label="我想我應該去正式介紹一下自己。",shape=box,color=blue];
		3368 -> 3369;
	3369 [label="她有很多有用的見解。弗烈爾也很可愛。老實說，酒吧裡的那群像一股新鮮空氣。",shape=box,color=blue];
		3369 -> 3370;
	3370 [label="嗯。只是打個比方。",shape=box,color=blue];
		3370 -> 3371;
		3370 -> 3372;
		3370 -> 3373;
	3371 [label="已經厭倦了六煞幫了嗎？",shape=box,color=red];
		3371 -> 3374;
	3372 [label="她有哪些高見？",shape=box,color=red];
		3372 -> 3375;
	3373 [label="我很高興你有在交朋友。哈哈。",shape=box,color=red];
		3373 -> 3376;
	3374 [label="什麼？不！當然不是。",shape=box,color=blue];
		3374 -> 3377;
	3375 [label="關於這一年循環了多少次的精彩見解。",shape=box,color=blue];
		3375 -> 3378;
	3376 [label="我想能夠跟一些沒有共同經歷太多事的人一起聊天的感覺很好。",shape=box,color=blue];
		3376 -> 3379;
	3377 [label="六煞幫是我的家人。我的團隊。這你知道的。",shape=box,color=blue];
		3377 -> 3376;
	3378 [label="關於我有多少次可能忘了又或沒忘掉過去的歲月。關於她是如何……活在時間之外，而我們卻不是。",shape=box,color=blue];
		3378 -> 3380;
	3379 [label="我不確定這樣解釋清不清楚。我認識他們，我信任他們，我只是沒有和他們一起經歷過大風大浪。",shape=box,color=blue];
		3379 -> 3381;
	3380 [label="而你開口說什麼之前，不。我不想知道，也沒有權利知道。",shape=box,color=blue];
		3380 -> 3382;
	3381 [label="所以有時候只是坐下來和他們喝一杯會更放鬆一些。",shape=box,color=blue];
		3381 -> 3383;
		3381 -> 3384;
		3381 -> 3385;
	3382 [label="我想我要說的只是，無論你有或沒有這麼做，都沒關係。我不會因此而怪你。",shape=box,color=blue];
		3382 -> 3386;
	3383 [label="我從來都沒有那種選擇。",shape=box,color=red];
		3383 -> 3387;
	3384 [label="是的。這我懂。",shape=box,color=red];
		3384 -> 3388;
	3385 [label="他們中有些人較年長而且還有軍事經驗，這樣也有幫助。",shape=box,color=red];
		3385 -> 3389;
	3386 [label="我們現在的處境？一點都不正常。我們本來就不適應這種情況，而我指的是人類。",shape=box,color=blue];
		3386 -> 3390;
	3387 [label="我想沒有。",shape=box,color=blue];
		3387 -> 3391;
	3388 [label="沒有那麼重的……負擔。沒有那麼多的往事。阿米爾稱它為包袱。",shape=box,color=blue];
		3388 -> 3391;
	3389 [label="日君保佑。確實。一開始還不確定怎麼看待這些自由國的人。但現在，很高興有他們在這裡。",shape=box,color=blue];
		3389 -> 3391;
	3390 [label="這種事沒有應對指南。無論你選擇怎麼做，我相信你有充分的理由那麼做。",shape=box,color=blue];
		3390 -> 3392;
	3391 [label="但這一切讓我想到。",shape=box,color=blue];
		3391 -> 3393;
		3391 -> 3394;
	3392 [label="Check boolean ArthurDating",color=orange];
		3392 -> 3396 [label=true,color=green];
		3392 -> 3395 [label=false,color=brown];
	3393 [label="呃哦。",shape=box,color=red];
		3393 -> 3397;
	3394 [label="關於什麼？",shape=box,color=red];
		3394 -> 3398;
	3396 [label="我愛你。即使我忘了這件事，即使你選擇走另一條路，那都沒關係。",shape=box,color=blue];
		3396 -> 3400;
	3395 [label="我把生命托付給你。沒有什麼能改變這一點。即使我只是暫時忘記而已。",shape=box,color=blue];
		3395 -> 3399;
	3397 [label="呵。聽我說。但，這是關於你的說。",shape=box,color=blue];
		3397 -> 3401;
	3398 [label="你。",shape=box,color=blue];
		3398 -> 3401;
	3400 [label="在你來到這裡之前，我想我會無法接受這種事。我會非常害怕失去你。失去這一切。",shape=box,color=blue];
		3400 -> 3402;
	3399 [label="在你來到這裡之前，我想我會無法接受這種事。我會非常害怕失去一部分的自己。",shape=box,color=blue];
		3399 -> 3402;
	3401 [label="還有這整個……循環的時間線。這讓我想到有多少個 1999 年我都可能已經不記得了。",shape=box,color=blue];
		3401 -> 3403;
		3401 -> 3404;
		3401 -> 3405;
	3402 [label="我會像個絕望的人緊抓著海上的木筏那樣緊抓著它。但也許現在我已經歷這個循環夠多次了，或許……只是因為你，我也不知道。",shape=box,color=blue];
		3402 -> 3406;
	3403 [label="我發誓，無論那把吉他告訴你什麼都是造謠。",shape=box,color=red];
		3403 -> 3407;
	3404 [label="我有麻煩了嗎？",shape=box,color=red];
		3404 -> 3407;
	3405 [label="亞瑟，我……覺得我們不應該談論這個。",shape=box,color=red];
		3405 -> 3407;
	3406 [label="你現在給我的這份幸福， 這份平靜，它這一刻的價值遠超出它永續與否。",shape=box,color=blue];
		3406 -> 3408;
	3407 [label="等一下，好嗎？你知道我打字比你慢。",shape=box,color=blue];
		3407 -> 3409;
	3408 [label="作為一名士兵，生活教會你的一件事就是，世間萬物轉瞬即逝。",shape=box,color=blue];
		3408 -> 3410;
	3409 [label="我想說的是：",shape=box,color=blue];
		3409 -> 3411;
	3410 [label="上一秒還在，下一秒就不見了。我想我已經完全接受這個事實了。",shape=box,color=blue];
		3410 -> 3412;
	3411 [label="無論你是否讓我，或六煞幫的其他成員，忘掉我們過去的互動？都沒關係。",shape=box,color=blue];
		3411 -> 3413;
	3412 [label="所以，不管我們一起度過的時光會不會因為你捶個地板就此結速，而我忘掉這一切，",shape=box,color=blue];
		3412 -> 3414;
	3413 [label="我都不會怪你。",shape=box,color=blue];
		3413 -> 3386;
	3414 [label="還是因為某天你不小心被漠然抓走，",shape=box,color=blue];
		3414 -> 3415;
	3415 [label="我都會好好享受我所擁有的這一刻。就在此時此地。因為這就是我所擁有的。",shape=box,color=blue];
		3415 -> 3416;
	3416 [label="這也是我可以確信的事。",shape=box,color=blue];
		3416 -> 3417;
		3416 -> 3418;
		3416 -> 3419;
	3417 [label="別介意。主要是因為我每次想約你姊總是會失敗。: P",shape=box,color=red];
		3417 -> 3420;
	3418 [label="亞瑟，謝謝……這重要到遠超出我用言語所能表達的。",shape=box,color=red];
		3418 -> 3421;
	3419 [label="有時候，我希望自己也能像你那樣保持平常心。<3",shape=box,color=red];
		3419 -> 3422;
	3420 [label="呵呵。好吧，還好你有神奇的超能力，能把你亂噴的廢話吞回去，是吧？",shape=box,color=blue];
		3420 -> 3423;
	3421 [label="我時不時也會試著輕鬆看待，說出一些有意義的東西。",shape=box,color=blue];
		3421 -> 3424;
	3422 [label="這更多是因為我知道，除了嘴硬之外，我實際上別無選擇。這正是不列坦人的處世之道。",shape=box,color=blue];
		3422 -> 3425;
	3423 [label="我們其他人也只能學習怎溝通了。不過，想問一下。",shape=box,color=blue];
		3423 -> 3426;
	3424 [label="好吧，我想是時候喝一杯了。要嗎？",shape=box,color=blue];
		3424 -> 3427;
		3424 -> 3428;
	3425 [label="就像老話一句，「保持鎮定，繼續前進」。",shape=box,color=blue];
		3425 -> 3424;
	3426 [label="每次重置，她的標準會不會越降越低？",shape=box,color=blue];
		3426 -> 3429;
	3427 [label="晚點再說。",shape=box,color=red];
		3427 -> 3430;
	3428 [label="那裡見。 : )",shape=box,color=red];
		3428 -> 3431;
	3429 [label="Chat ends.",color=orange];
	3430 [label="隨便你。",shape=box,color=blue];
		3430 -> 3432;
	3431 [label="Chat ends.",color=orange];
	3432 [label="Chat ends.",color=orange];
}