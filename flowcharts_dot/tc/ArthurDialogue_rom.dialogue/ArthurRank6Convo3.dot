digraph {
	"ArthurRank6Convo3 begins." [color=orange];
		"ArthurRank6Convo3 begins." -> j3260601706;
	j3260601706 [label="我前幾天與那把吉他進行了一場對話。",shape=box,color=blue];
		j3260601706 -> j3920492495;
		j3260601706 -> j1620724596;
	j3920492495 [label="對我來說，我不會很上頭就是了。",shape=box,color=red];
		j3920492495 -> j2633988469;
	j1620724596 [label="莉慈嗎？所以談得怎麼樣？",shape=box,color=red];
		j1620724596 -> j2794351230;
	j2633988469 [label="老實說，我還蠻喜歡她的。一旦你能夠……見怪……不怪吧？",shape=box,color=blue];
		j2633988469 -> j4116431854;
	j2794351230 [label="比我想像中要好。我還蠻喜歡她的。",shape=box,color=blue];
		j2794351230 -> j4116431854;
	j4116431854 [label="再說，",shape=box,color=blue];
		j4116431854 -> j3557209718;
	j3557209718 [label="既然她和愛琳娜似乎總是笑著那些只有她們聽得到的笑話。",shape=box,color=blue];
		j3557209718 -> j3050917837;
	j3050917837 [label="我想我應該去正式介紹一下自己。",shape=box,color=blue];
		j3050917837 -> j2082634813;
	j2082634813 [label="她有很多有用的見解。弗烈爾也很可愛。老實說，酒吧裡的那群像一股新鮮空氣。",shape=box,color=blue];
		j2082634813 -> j3113012338;
	j3113012338 [label="嗯。只是打個比方。",shape=box,color=blue];
		j3113012338 -> j1620487949;
		j3113012338 -> j4022662738;
		j3113012338 -> j947203395;
	j1620487949 [label="已經厭倦了六煞幫了嗎？",shape=box,color=red];
		j1620487949 -> j708934850;
	j4022662738 [label="她有哪些高見？",shape=box,color=red];
		j4022662738 -> j244451312;
	j947203395 [label="我很高興你有在交朋友。哈哈。",shape=box,color=red];
		j947203395 -> j3505319287;
	j708934850 [label="什麼？不！當然不是。",shape=box,color=blue];
		j708934850 -> j256704111;
	j244451312 [label="關於這一年循環了多少次的精彩見解。",shape=box,color=blue];
		j244451312 -> j845003044;
	j3505319287 [label="我想能夠跟一些沒有共同經歷太多事的人一起聊天的感覺很好。",shape=box,color=blue];
		j3505319287 -> j119248967;
	j256704111 [label="六煞幫是我的家人。我的團隊。這你知道的。",shape=box,color=blue];
		j256704111 -> j3505319287;
	j845003044 [label="關於我有多少次可能忘了又或沒忘掉過去的歲月。關於她是如何……活在時間之外，而我們卻不是。",shape=box,color=blue];
		j845003044 -> j1850804880;
	j119248967 [label="我不確定這樣解釋清不清楚。我認識他們，我信任他們，我只是沒有和他們一起經歷過大風大浪。",shape=box,color=blue];
		j119248967 -> j1732561111;
	j1850804880 [label="而你開口說什麼之前，不。我不想知道，也沒有權利知道。",shape=box,color=blue];
		j1850804880 -> j3826297717;
	j1732561111 [label="所以有時候只是坐下來和他們喝一杯會更放鬆一些。",shape=box,color=blue];
		j1732561111 -> j3922781018;
		j1732561111 -> j3678060857;
		j1732561111 -> j4142541846;
	j3826297717 [label="我想我要說的只是，無論你有或沒有這麼做，都沒關係。我不會因此而怪你。",shape=box,color=blue];
		j3826297717 -> j3311961644;
	j3922781018 [label="我從來都沒有那種選擇。",shape=box,color=red];
		j3922781018 -> j1470703113;
	j3678060857 [label="是的。這我懂。",shape=box,color=red];
		j3678060857 -> j3702560463;
	j4142541846 [label="他們中有些人較年長而且還有軍事經驗，這樣也有幫助。",shape=box,color=red];
		j4142541846 -> j2468677470;
	j3311961644 [label="我們現在的處境？一點都不正常。我們本來就不適應這種情況，而我指的是人類。",shape=box,color=blue];
		j3311961644 -> j3407641172;
	j1470703113 [label="我想沒有。",shape=box,color=blue];
		j1470703113 -> j3859146994;
	j3702560463 [label="沒有那麼重的……負擔。沒有那麼多的往事。阿米爾稱它為包袱。",shape=box,color=blue];
		j3702560463 -> j3859146994;
	j2468677470 [label="日君保佑。確實。一開始還不確定怎麼看待這些自由國的人。但現在，很高興有他們在這裡。",shape=box,color=blue];
		j2468677470 -> j3859146994;
	j3407641172 [label="這種事沒有應對指南。無論你選擇怎麼做，我相信你有充分的理由那麼做。",shape=box,color=blue];
		j3407641172 -> j2674809731;
	j3859146994 [label="但這一切讓我想到。",shape=box,color=blue];
		j3859146994 -> j2763639070;
		j3859146994 -> j2744187486;
	j2674809731 [label="Check boolean ArthurDating",color=orange];
		j2674809731 -> j1716306896 [label=true,color=green];
		j2674809731 -> j2537232666 [label=false,color=brown];
	j2763639070 [label="呃哦。",shape=box,color=red];
		j2763639070 -> j2476938551;
	j2744187486 [label="關於什麼？",shape=box,color=red];
		j2744187486 -> j3906294502;
	j1716306896 [label="我愛你。即使我忘了這件事，即使你選擇走另一條路，那都沒關係。",shape=box,color=blue];
		j1716306896 -> j2747495457;
	j2537232666 [label="我把生命托付給你。沒有什麼能改變這一點。即使我只是暫時忘記而已。",shape=box,color=blue];
		j2537232666 -> j1329019210;
	j2476938551 [label="呵。聽我說。但，這是關於你的說。",shape=box,color=blue];
		j2476938551 -> j1078610458;
	j3906294502 [label="你。",shape=box,color=blue];
		j3906294502 -> j1078610458;
	j2747495457 [label="在你來到這裡之前，我想我會無法接受這種事。我會非常害怕失去你。失去這一切。",shape=box,color=blue];
		j2747495457 -> j2161296295;
	j1329019210 [label="在你來到這裡之前，我想我會無法接受這種事。我會非常害怕失去一部分的自己。",shape=box,color=blue];
		j1329019210 -> j2161296295;
	j1078610458 [label="還有這整個……循環的時間線。這讓我想到有多少個 1999 年我都可能已經不記得了。",shape=box,color=blue];
		j1078610458 -> j98622599;
		j1078610458 -> j1734141888;
		j1078610458 -> j4063355723;
	j2161296295 [label="我會像個絕望的人緊抓著海上的木筏那樣緊抓著它。但也許現在我已經歷這個循環夠多次了，或許……只是因為你，我也不知道。",shape=box,color=blue];
		j2161296295 -> j2872882283;
	j98622599 [label="我發誓，無論那把吉他告訴你什麼都是造謠。",shape=box,color=red];
		j98622599 -> j2128935274;
	j1734141888 [label="我有麻煩了嗎？",shape=box,color=red];
		j1734141888 -> j2128935274;
	j4063355723 [label="亞瑟，我……覺得我們不應該談論這個。",shape=box,color=red];
		j4063355723 -> j2128935274;
	j2872882283 [label="你現在給我的這份幸福， 這份平靜，它這一刻的價值遠超出它永續與否。",shape=box,color=blue];
		j2872882283 -> j2806588220;
	j2128935274 [label="等一下，好嗎？你知道我打字比你慢。",shape=box,color=blue];
		j2128935274 -> j2291726162;
	j2806588220 [label="作為一名士兵，生活教會你的一件事就是，世間萬物轉瞬即逝。",shape=box,color=blue];
		j2806588220 -> j3358308204;
	j2291726162 [label="我想說的是：",shape=box,color=blue];
		j2291726162 -> j3625131293;
	j3358308204 [label="上一秒還在，下一秒就不見了。我想我已經完全接受這個事實了。",shape=box,color=blue];
		j3358308204 -> j1980762076;
	j3625131293 [label="無論你是否讓我，或六煞幫的其他成員，忘掉我們過去的互動？都沒關係。",shape=box,color=blue];
		j3625131293 -> j3919800341;
	j1980762076 [label="所以，不管我們一起度過的時光會不會因為你捶個地板就此結速，而我忘掉這一切，",shape=box,color=blue];
		j1980762076 -> j2051250471;
	j3919800341 [label="我都不會怪你。",shape=box,color=blue];
		j3919800341 -> j3311961644;
	j2051250471 [label="還是因為某天你不小心被漠然抓走，",shape=box,color=blue];
		j2051250471 -> j816222977;
	j816222977 [label="我都會好好享受我所擁有的這一刻。就在此時此地。因為這就是我所擁有的。",shape=box,color=blue];
		j816222977 -> j893153594;
	j893153594 [label="這也是我可以確信的事。",shape=box,color=blue];
		j893153594 -> j3508296577;
		j893153594 -> j4155759986;
		j893153594 -> j3965675053;
	j3508296577 [label="別介意。主要是因為我每次想約你姊總是會失敗。: P",shape=box,color=red];
		j3508296577 -> j2949352887;
	j4155759986 [label="亞瑟，謝謝……這重要到遠超出我用言語所能表達的。",shape=box,color=red];
		j4155759986 -> j1692298579;
	j3965675053 [label="有時候，我希望自己也能像你那樣保持平常心。<3",shape=box,color=red];
		j3965675053 -> j458078499;
	j2949352887 [label="呵呵。好吧，還好你有神奇的超能力，能把你亂噴的廢話吞回去，是吧？",shape=box,color=blue];
		j2949352887 -> j48821083;
	j1692298579 [label="我時不時也會試著輕鬆看待，說出一些有意義的東西。",shape=box,color=blue];
		j1692298579 -> j2704144930;
	j458078499 [label="這更多是因為我知道，除了嘴硬之外，我實際上別無選擇。這正是不列坦人的處世之道。",shape=box,color=blue];
		j458078499 -> j146103532;
	j48821083 [label="我們其他人也只能學習怎溝通了。不過，想問一下。",shape=box,color=blue];
		j48821083 -> j2976180132;
	j2704144930 [label="好吧，我想是時候喝一杯了。要嗎？",shape=box,color=blue];
		j2704144930 -> j1520854699;
		j2704144930 -> j2827041182;
	j146103532 [label="就像老話一句，「保持鎮定，繼續前進」。",shape=box,color=blue];
		j146103532 -> j2704144930;
	j2976180132 [label="每次重置，她的標準會不會越降越低？",shape=box,color=blue];
		j2976180132 -> "Chat ends.";
	j1520854699 [label="晚點再說。",shape=box,color=red];
		j1520854699 -> j778803616;
	j2827041182 [label="那裡見。 : )",shape=box,color=red];
		j2827041182 -> "Chat ends.";
	"Chat ends." [color=orange];
	j778803616 [label="隨便你。",shape=box,color=blue];
		j778803616 -> "Chat ends.";
}