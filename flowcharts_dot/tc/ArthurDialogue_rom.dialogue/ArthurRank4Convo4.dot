	1524 [label="我已經開始後悔了……",shape=box,color=blue];
		1524 -> 1530;
	1532 [label="你已經對我夠有耐心了。如果你還想知道我為什麼離開不列坦軍隊的故事……到現在為止我可能都已經欠你兩次了。",shape=box,color=blue];
		1532 -> 1533;
