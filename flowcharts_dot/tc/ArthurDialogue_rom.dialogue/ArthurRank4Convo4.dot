	1526 [label="怎麼樣，詹姆斯？",shape=box,color=red];
		1526 -> 1524;
	1530 [label="就是忍不住，對不起。 : P 你說什麼？",shape=box,color=red];
		1530 -> 1531;
	1533 [label="如果你確定的話。",shape=box,color=red];
		1533 -> 1537;
	1534 [label="我洗耳恭聽。",shape=box,color=red];
		1534 -> 1538;
	1535 [label="不了，謝啦。",shape=box,color=red];
		1535 -> 1536;
	1531 [label="呵。",shape=box,color=blue];
		1531 -> 1532;
	1537 [label="我確定。",shape=box,color=blue];
		1537 -> 1538;
	1538 [label="每個人參軍都有不同原因。對我來說，我加入是為了……榮譽。為了使命。",shape=box,color=blue];
		1538 -> 1539;
	1536 [label="Chat ends.",color=orange];
	1539 [label="我想成為一名英雄，像個該死的笨蛋那樣。",shape=box,color=blue];
		1539 -> 1540;
	1540 [label="重點是，我對身為一名軍人所代表的意義，抱持著宏偉的理想進去的。",shape=box,color=blue];
		1540 -> 1541;
	1541 [label="為保護王子和王國。",shape=box,color=blue];
		1541 -> 1542;
	1542 [label="但我發現這其實天大的謊言。",shape=box,color=blue];
		1542 -> 1543;
		1542 -> 1544;
		1542 -> 1545;
	1543 [label="發生什麼事？",shape=box,color=red];
		1543 -> 1547;
	1544 [label="哦？",shape=box,color=red];
		1544 -> 1547;
	1545 [label="我得走了。[結束]",shape=box,color=red];
		1545 -> 1546;
	1547 [label="身為一名軍人你的職責不是思考，而是聽從命令。",shape=box,color=blue];
		1547 -> 1548;
	1546 [label="Chat ends.",color=orange];
	1548 [label="無論如何。",shape=box,color=blue];
		1548 -> 1549;
	1549 [label="所以，當我被派到敵軍的防線後並被告知要殺死所有「潛在的敵方戰鬥人員」的時候，",shape=box,color=blue];
		1549 -> 1550;
	1550 [label="我做了一名優良士兵該做的事。我聽從了命令。",shape=box,color=blue];
		1550 -> 1551;
		1550 -> 1552;
	1551 [label="我想我可以看到這會怎麼樣發展了……",shape=box,color=red];
		1551 -> 1553;
	1552 [label="噢不……",shape=box,color=red];
		1552 -> 1554;
	1553 [label="這不需要一個天才也知道。",shape=box,color=blue];
		1553 -> 1555;
	1554 [label="是啊。",shape=box,color=blue];
		1554 -> 1555;
	1555 [label="我不知道那天我們奪走了多少條無辜的生命。",shape=box,color=blue];
		1555 -> 1556;
	1556 [label="但實在是太多了。",shape=box,color=blue];
		1556 -> 1557;
	1557 [label="當我到處詢問我們為什麼要屠殺無辜的人時，上面的高官用懲戒免職來威脅我。",shape=box,color=blue];
		1557 -> 1558;
	1558 [label="閉上你的嘴。做好你的事。發射你的槍。就像一名好士兵好好地殺戮。",shape=box,color=blue];
		1558 -> 1559;
	1559 [label="別、問、問題。",shape=box,color=blue];
		1559 -> 1560;
	1560 [label="他們說得對。我不應該一直問問題。我不擅於追根究底。",shape=box,color=blue];
		1560 -> 1561;
		1560 -> 1562;
	1561 [label="但──",shape=box,color=red];
		1561 -> 1563;
	1562 [label="亞瑟……",shape=box,color=red];
		1562 -> 1563;
	1563 [label="不，等一下讓我說完。我不擅長探究謎團背後的真相。但你知道誰在這方面很內行嗎？",shape=box,color=blue];
		1563 -> 1564;
	1564 [label="還有誰當過記者？而且當時還跟各大報社都有往來。",shape=box,color=blue];
		1564 -> 3144;
	3144 [label="是愛琳娜。",shape=box,color=blue];
		3144 -> 1565;
	1565 [label="所以這檔事很簡單。讓我提前退休否則讓整件事炸開鍋。我沒有重要到讓他們在乎。在這之後他們也沒有麻煩我並讓我離開了。",shape=box,color=blue];
		1565 -> 1566;
	1566 [label="Update boolean ArthurSoldierTold",color=orange];
		1566 -> 1567;
		1566 -> 1568;
	1567 [label="所以你後來就加入了危應部隊？",shape=box,color=red];
