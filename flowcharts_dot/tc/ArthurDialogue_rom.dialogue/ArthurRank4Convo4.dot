		1572 -> 1577;
	1573 [label="哦，那我們可以買一個熱水浴缸了！",shape=box,color=red];
		1573 -> 1578;
	1574 [label="我就……做不到。其餘的六煞幫成員也同樣做不到。也因此──我們走到了這一步。",shape=box,color=blue];
