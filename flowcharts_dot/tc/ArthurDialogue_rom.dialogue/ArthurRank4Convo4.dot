	1568 [label="發生的事不是你的錯。",shape=box,color=red];
		1568 -> 1570;
	1569 [label="是的，並又天真地掉入了完全相同的陷阱中。我相信領導長官們會關心保護平民。",shape=box,color=blue];
		1569 -> 1571;
	1570 [label="如果愛琳娜每次對我說這句話，我都可以得到一塊英鎊的話……",shape=box,color=blue];
		1570 -> 1572;
		1570 -> 1573;
	1571 [label="殺掉所有可能被感染的無辜平民，無論真假與否。",shape=box,color=blue];
