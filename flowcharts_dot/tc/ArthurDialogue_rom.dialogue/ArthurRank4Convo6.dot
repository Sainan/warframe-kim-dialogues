	3002 [label="Chat ends.",color=orange];
	3003 [label="亞瑟，關於那個《寓言與先驅》的遊戲，如果你一起玩的話，這對我和阿米爾來說意義會很重大。",shape=box,color=red];
		3003 -> 3009;
	3004 [label="嘿，亞瑟，我知道你已經拒絕玩《寓言與先驅》這款遊戲了，但我認為它會很有趣。",shape=box,color=red];
		3004 -> 3010;
	3005 [label="嘿，你想不想跟我和阿米爾一起玩《寓言與先驅》？我認為它會很有趣。",shape=box,color=red];
		3005 -> 3010;
	3006 [label="嘿，亞瑟。阿米爾正在籌劃一場《寓言與先驅》的遊戲，如果你加入的話，對我們倆個來說意義會很重大。",shape=box,color=red];
		3006 -> 3009;
	3009 [label="真的嗎？為什麼會這樣？",shape=box,color=blue];
		3009 -> 3007;
		3009 -> 3008;
	3010 [label="我們對「樂趣」的定義大不相同。抱歉，不了。",shape=box,color=blue];
		3010 -> 3012;
	3007 [label="我認為這會很有趣，而且這對大家來說會是個良好的關係培養經驗。",shape=box,color=red];
		3007 -> 3010;
	3008 [label="他覺得自己格格不入，不是什麼軍事人員，又是書呆子，有點像外行人。如果我們都坐下來陪他一起玩他其中一款遊戲的話，這對他來說意義很重大。",shape=box,color=red];
		3008 -> 3017;
	3012 [label="但孩子們，玩得開心。",shape=box,color=blue];
		3012 -> 3013;
	3017 [label="+20 Chemistry",color=orange];
		3017 -> 3011;
	3013 [label="Chat ends.",color=orange];
	3011 [label="嗯……也對。好吧，我會玩。算我一個。",shape=box,color=blue];
		3011 -> 3014;
	3014 [label="至少玩一晚，看看怎麼樣。",shape=box,color=blue];
