	j972778441 [label="Check boolean ArthurPolyamorySuccess",color=orange];
		j972778441 -> j1569221931 [label=true,color=green];
		j972778441 -> "Chat ends." [label=false,color=brown];
	j471697750 [label="亞瑟，我們能談談嗎？[徵求同意發展多重伴侶關係]",shape=box,color=red];
		j471697750 -> j1978853851;
	j3406405025 [label="[結束]",shape=box,color=red];
		j3406405025 -> j3652224286;
	j1978853851 [label="隨時都可以。發生什麼事嗎？",shape=box,color=blue];
		j1978853851 -> j2363968445;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j2363968445 [label="不，沒什麼。我只是想跟你談件事，希望不會讓你感到不舒服。",shape=box,color=red];
		j2363968445 -> j949986741;
	j949986741 [label="我不願讓你置身你不願待的處境。我知道這不是我們之前討論過的事。所以如果你不想的話，那也沒關係。我希望你明白這點。",shape=box,color=red];
		j949986741 -> j3116418005;
	j3116418005 [label="我們之間的關係對我來說很重要，非常重要，而且它是真實的。我不希望你懷疑這點。",shape=box,color=red];
		j3116418005 -> j2374053045;
	j2374053045 [label="啊。我已經看到這個話題的走向了。你對別人也有感覺了？",shape=box,color=blue];
		j2374053045 -> j2327236010;
		j2374053045 -> j2439405472;
	j2327236010 [label="是的。而我知道這可能很難理解，但這並不意味著我對你的感情有變少。",shape=box,color=red];
		j2327236010 -> j3675705274;
	j2439405472 [label="是的。但現在想想，我覺得我們應該在這裡結束這段關係比較好。[分手]",shape=box,color=red];
		j2439405472 -> j2819313111;
	j3675705274 [label="親愛的，你以為我在軍隊裡待了這麼多年，人與人之間的各種關係我會沒見過嗎？",shape=box,color=blue];
		j3675705274 -> j1622682140;
	j2819313111 [label="如果你真的想要那樣，那就……",shape=box,color=blue];
		j2819313111 -> j3701883258;
	j1622682140 [label="當你人生中多次與死神擦身而過，你就會學會珍惜生命中什麼重要什麼不重要。",shape=box,color=blue];
		j1622682140 -> j3284132143;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j3284132143 [label="你不會再糾結於那些世俗的眉眉角角。這我完全理解。",shape=box,color=blue];
		j3284132143 -> j194289391;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j194289391 [label="事實上，你對我很重要。而如果他們對你很重要，那麼他們對我也很重要。",shape=box,color=blue];
		j194289391 -> j3510429058;
	j3510429058 [label="只是不要……不要是六煞成員，好嗎？這麼說好了，如果牽扯到「家」務事，那我想我可能就接受不了了。",shape=box,color=blue];
		j3510429058 -> j634705310;
	j634705310 [label="光是想到這個就會讓我做噩夢。",shape=box,color=blue];
		j634705310 -> j978395189;
		j634705310 -> j657390965;
	j978395189 [label="哈哈。我答應你。",shape=box,color=red];
		j978395189 -> j1714604131;
	j657390965 [label="無論如何，我真心覺得你會喜歡他們。",shape=box,color=red];
		j657390965 -> j480633525;
	j1714604131 [label="謝謝。我希望有天能見到他們。當然，出於……個人理由。",shape=box,color=blue];
		j1714604131 -> j3917989096;
	j480633525 [label="我希望有天能見到他們。當然，出於……個人理由。",shape=box,color=blue];
		j480633525 -> j3917989096;
	j3917989096 [label="+20 Chemistry",color=orange];
		j3917989096 -> j1777200721;
	j1777200721 [label="親愛的，在外面照顧好自己。",shape=box,color=blue];
		j1777200721 -> j3652224286;
}