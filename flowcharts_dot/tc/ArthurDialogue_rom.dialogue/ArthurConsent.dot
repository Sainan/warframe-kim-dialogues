		j972778441 -> "Chat ends." [label=false,color=brown];
	j1433647147 [label="亞瑟，我們能談談嗎？[徵求同意發展多重伴侶關係]",shape=box,color=red];
		j1433647147 -> j669560582;
	j3406405025 [label="[結束]",shape=box,color=red];
		j3406405025 -> j3652224286;
	j669560582 [label="隨時都可以。發生什麼事嗎？",shape=box,color=blue];
		j669560582 -> j1419643626;
	j3652224286 [label="Boolean ArthurConsentComplete is now true.",color=orange];
		j3652224286 -> "Chat ends.";
	j1419643626 [label="不，沒什麼。我只是想跟你談件事，希望不會讓你感到不舒服。",shape=box,color=red];
		j1419643626 -> j2961361062;
	j2961361062 [label="我不願讓你置身你不願待的處境。我知道這不是我們之前討論過的事。所以如果你不想的話，那也沒關係。我希望你明白這點。",shape=box,color=red];
		j2961361062 -> j1894689507;
	j1894689507 [label="我們之間的關係對我來說很重要，非常重要，而且它是真實的。我不希望你懷疑這點。",shape=box,color=red];
		j1894689507 -> j390329889;
	j390329889 [label="啊。我已經看到這個話題的走向了。我想，你對……別人也有感覺了？",shape=box,color=blue];
		j390329889 -> j1679460339;
		j390329889 -> j2439405472;
	j1679460339 [label="是的。而我知道這可能很難理解，但這並不意味著我對你的感情有變少。",shape=box,color=red];
		j1679460339 -> j438687911;
	j2439405472 [label="是的。但現在想想，我覺得我們應該在這裡結束這段關係比較好。[分手]",shape=box,color=red];
		j2439405472 -> j2819313111;
	j438687911 [label="親愛的，你以為我在軍隊裡待了這麼多年，人與人之間的各種關係我會沒見過嗎？",shape=box,color=blue];
		j438687911 -> j868487587;
	j2819313111 [label="如果你真的想要那樣，那就……",shape=box,color=blue];
		j2819313111 -> j3701883258;
	j868487587 [label="當你人生中多次與死神擦身而過，你就會學會珍惜生命中什麼重要什麼不重要。",shape=box,color=blue];
		j868487587 -> j2614425972;
	j3701883258 [label="Boolean IsDating is now false.",color=orange];
		j3701883258 -> j913620630;
	j2614425972 [label="我不知道這事會怎麼發展。但你對我很重要，我願意嘗試。",shape=box,color=blue];
		j2614425972 -> j3876434672;
	j913620630 [label="Boolean ArthurDating is now false.",color=orange];
		j913620630 -> "Chat ends.";
	j3876434672 [label="我在乎你。如果你在乎他們，那我也在乎他們。",shape=box,color=blue];
		j3876434672 -> j1077393830;
	j1077393830 [label="只是，不要──不要在商場裡面。好嗎？",shape=box,color=blue];
		j1077393830 -> j150312095;
	j150312095 [label="事情已經夠亂了。",shape=box,color=blue];
		j150312095 -> j978395189;
		j150312095 -> j657390965;
	j978395189 [label="哈哈。我答應你。",shape=box,color=red];
		j978395189 -> j1714604131;
	j657390965 [label="無論如何，我真心覺得你會喜歡他們。",shape=box,color=red];
		j657390965 -> j480633525;
	j1714604131 [label="謝謝。我希望有天能見到他們。當然，出於……個人理由。",shape=box,color=blue];
		j1714604131 -> j3917989096;
	j480633525 [label="我希望有天能見到他們。當然，出於……個人理由。",shape=box,color=blue];
		j480633525 -> j3917989096;
