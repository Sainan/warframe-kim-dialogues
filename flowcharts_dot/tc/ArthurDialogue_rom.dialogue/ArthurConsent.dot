		3641 -> 3609 [label=true,color=green];
		3641 -> 3610 [label=false,color=brown];
	3612 [label="Chat ends.",color=orange];
	3613 [label="亞瑟，我們能談談嗎？[徵求同意發展多重伴侶關係]",shape=box,color=red];
		3613 -> 3615;
	3611 [label="[結束]",shape=box,color=red];
		3611 -> 3614;
	3610 [label="Chat ends.",color=orange];
	3615 [label="隨時都可以。發生什麼事嗎？",shape=box,color=blue];
		3615 -> 3617;
	3614 [label="Update boolean ArthurConsentComplete",color=orange];
		3614 -> 3616;
	3617 [label="不，沒什麼。我只是想跟你談件事，希望不會讓你感到不舒服。",shape=box,color=red];
		3617 -> 3618;
	3616 [label="Chat ends.",color=orange];
	3618 [label="我不願讓你置身你不願待的處境。我知道這不是我們之前討論過的事。所以如果你不想的話，那也沒關係。我希望你明白這點。",shape=box,color=red];
		3618 -> 3619;
	3619 [label="我們之間的關係對我來說很重要，非常重要，而且它是真實的。我不希望你懷疑這點。",shape=box,color=red];
		3619 -> 3620;
	3620 [label="啊。我已經看到這個話題的走向了。你對別人也有感覺了？",shape=box,color=blue];
		3620 -> 3621;
		3620 -> 3622;
	3621 [label="是的。而我知道這可能很難理解，但這並不意味著我對你的感情有變少。",shape=box,color=red];
		3621 -> 3623;
	3622 [label="是的。但現在想想，我覺得我們應該在這裡結束這段關係比較好。[分手]",shape=box,color=red];
		3622 -> 3624;
	3623 [label="親愛的，你以為我在軍隊裡待了這麼多年，人與人之間的各種關係我會沒見過嗎？",shape=box,color=blue];
		3623 -> 3625;
	3624 [label="如果你真的想要那樣，那就……",shape=box,color=blue];
		3624 -> 3626;
	3625 [label="當你人生中多次與死神擦身而過，你就會學會珍惜生命中什麼重要什麼不重要。",shape=box,color=blue];
		3625 -> 3627;
	3626 [label="Update boolean IsDating",color=orange];
		3626 -> 3628;
	3627 [label="你不會再糾結於那些世俗的眉眉角角。這我完全理解。",shape=box,color=blue];
		3627 -> 3629;
	3628 [label="Update boolean ArthurDating",color=orange];
		3628 -> 3630;
	3629 [label="事實上，你對我很重要。而如果他們對你很重要，那麼他們對我也很重要。",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="Chat ends.",color=orange];
	3631 [label="只是不要……不要是六煞成員，好嗎？這麼說好了，如果牽扯到「家」務事，那我想我可能就接受不了了。",shape=box,color=blue];
		3631 -> 3632;
	3632 [label="光是想到這個就會讓我做噩夢。",shape=box,color=blue];
		3632 -> 3634;
		3632 -> 3633;
	3634 [label="哈哈。我答應你。",shape=box,color=red];
		3634 -> 3636;
	3633 [label="無論如何，我真心覺得你會喜歡他們。",shape=box,color=red];
		3633 -> 3635;
	3636 [label="謝謝。我希望有天能見到他們。當然，出於……個人理由。",shape=box,color=blue];
		3636 -> 3637;
	3635 [label="我希望有天能見到他們。當然，出於……個人理由。",shape=box,color=blue];
		3635 -> 3637;
	3637 [label="+20 Chemistry",color=orange];
		3637 -> 3638;
	3638 [label="親愛的，在外面照顧好自己。",shape=box,color=blue];
		3638 -> 3639;
	3639 [label="Update boolean ArthurConsentComplete",color=orange];
		3639 -> 3640;
	3640 [label="Chat ends.",color=orange];
}