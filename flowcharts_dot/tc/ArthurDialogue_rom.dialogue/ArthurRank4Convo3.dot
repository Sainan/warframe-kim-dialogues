		1445 -> 1450;
	1446 [label="什麼？為什麼？",shape=box,color=blue];
		1446 -> 1451;
	1447 [label="是另一個 Tenno 嗎？",shape=box,color=blue];
		1447 -> 1452;
	1448 [label="對什麼生氣？",shape=box,color=blue];
		1448 -> 1453;
	1449 [label="悲傷是一種毒藥",shape=box,color=blue];
		1449 -> 1454;
	1450 [label="我不是在侮辱你，這只是個事實。",shape=box,color=red];
		1450 -> 1455;
	1451 [label="因為裝出來的快樂比任何其它東西都要來得好。",shape=box,color=red];
		1451 -> 1456;
	1452 [label="該死的，甚至是我們死去的父母。任何人。除了我以外的任何人。",shape=box,color=red];
		1452 -> 1457;
	1453 [label="不是什麼。是誰。",shape=box,color=red];
		1453 -> 1458;
	1454 [label="的確。它會侵蝕你、分解你。讓你殘破不堪。",shape=box,color=red];
		1454 -> 1459;
	1455 [label="這東西很恐怖。",shape=box,color=red];
		1455 -> 1460;
	1456 [label="因為如果我失去那個笑容，那麼其它一切都會悄悄爬進來。",shape=box,color=red];
		1456 -> 1461;
	1457 [label="因為那樣我就不用去忍受那種痛苦，那種孤獨了。",shape=box,color=red];
		1457 -> 1462;
	1458 [label="對那些沒有被拋棄的人感到憤怒。對我的父母感到憤怒。對 Orokin 感到憤怒。",shape=box,color=red];
		1458 -> 1463;
	1459 [label="它奪走了世界上的所有色彩。但它也是……安全的。單純的。輕鬆的。",shape=box,color=red];
		1459 -> 1464;
	1460 [label="而且恐懼會滲入其他一切事物之中並讓你開始猛烈抨擊。",shape=box,color=red];
		1460 -> 1465;
	1461 [label="那種痛苦。那份孤獨。",shape=box,color=red];
		1461 -> 1466;
	1462 [label="我永遠被困住的事實。",shape=box,color=red];
		1462 -> 1467;
	1463 [label="對所有人感到憤怒，這也無所謂。對所有人感到憤怒因為這就是、他們的、錯。",shape=box,color=red];
		1463 -> 1468;
	1464 [label="像一條溫暖舒適的毛毯，早已變冷。",shape=box,color=red];
		1464 -> 1469;
	1465 [label="它會轉變成痛苦。轉變成煎熬。然後再轉變成孤獨。",shape=box,color=red];
		1465 -> 1470;
	1466 [label="那快樂只是虛偽的表象。",shape=box,color=red];
		1466 -> 1471;
	1467 [label="我想成為其他人，去其他地方。非常想。",shape=box,color=red];
		1467 -> 1472;
	1468 [label="而最重要的是，我對自己感到憤怒。",shape=box,color=red];
