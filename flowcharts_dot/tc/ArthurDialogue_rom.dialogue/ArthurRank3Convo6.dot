digraph {
	1188 [label="ArthurRank3Convo6 begins.",color=orange];
		1188 -> 1189;
	1189 [label="我們來交換不為人知的秘密。",shape=box,color=blue];
		1189 -> 1190;
		1189 -> 1191;
	1190 [label="哈哈，什麼？",shape=box,color=red];
		1190 -> 1192;
	1191 [label="過去很怪異。",shape=box,color=red];
		1191 -> 1192;
	1192 [label="呵。嗯，這是一個我在不列坦軍隊服役時會玩的遊戲。",shape=box,color=blue];
		1192 -> 1193;
	1193 [label="你告訴我一個關於你自己的尷尬事實，而我也告訴你一個關於我自己的。",shape=box,color=blue];
		1193 -> 1194;
	1194 [label="我們以此綁架彼此的秘密。",shape=box,color=blue];
		1194 -> 1195;
	1195 [label="綁架事實。它是一個「信任練習」。我甚至可以先開頭。",shape=box,color=blue];
		1195 -> 1196;
		1195 -> 1197;
		1195 -> 1198;
	1196 [label="一般情況下，我想你應該是要去參架繩索課程……但好吧。",shape=box,color=red];
		1196 -> 1202;
	1197 [label="當然，沒問題。",shape=box,color=red];
		1197 -> 1202;
	1198 [label="不用，我沒要玩。",shape=box,color=red];
		1198 -> 1199;
	1202 [label="這是我的：我有一個名叫塞巴斯蒂安的泰迪熊。",shape=box,color=blue];
		1202 -> 1203;
	1199 [label="隨便你。",shape=box,color=blue];
		1199 -> 1200;
	1203 [label="等等，在你腦海裡冒出我晚上會和他依偎睡覺的想法之前，告訴你我沒有。",shape=box,color=blue];
		1203 -> 1204;
	1200 [label="Chat ends.",color=orange];
	1204 [label="好幾年前我在一次任務中找到他，在一間炸毀的住宅區裡。",shape=box,color=blue];
		1204 -> 1205;
	1205 [label="我把他放在架子上。而當我沒有其他人可以說話的時候呢？",shape=box,color=blue];
		1205 -> 1206;
	1206 [label="我會和他說話。暴躁的老傢伙。避免我瘋掉。",shape=box,color=blue];
		1206 -> 1201;
		1206 -> 1207;
		1206 -> 1208;
	1201 [label="笑到在地上打滾",shape=box,color=red];
		1201 -> 1214;
	1207 [label="那真是……可愛得令人心疼。",shape=box,color=red];
		1207 -> 1211;
	1208 [label="下次可以讓我抱一下塞巴斯蒂安嗎？",shape=box,color=red];
		1208 -> 1210;
	1214 [label="是啊，是啊。",shape=box,color=blue];
		1214 -> 1213;
	1211 [label="我想我剛剛有小小難過一下下。",shape=box,color=red];
		1211 -> 1212;
	1210 [label="+20 Chemistry",color=orange];
		1210 -> 1209;
	1213 [label="我快尿出來了，簡直快笑死我了！哈哈",shape=box,color=red];
		1213 -> 1215;
	1212 [label="你總是充滿驚喜，亞瑟。",shape=box,color=red];
		1212 -> 1217;
	1209 [label="不見得不行。",shape=box,color=blue];
		1209 -> 1218;
	1215 [label="是啊，我懂。",shape=box,color=blue];
		1215 -> 1218;
	1217 [label="+20 Chemistry",color=orange];
		1217 -> 1216;
	1218 [label="換你了。",shape=box,color=blue];
		1218 -> 1219;
		1218 -> 1220;
		1218 -> 1221;
		1218 -> 1222;
	1216 [label="呵。",shape=box,color=blue];
		1216 -> 1218;
	1219 [label="在渡域的時候，我總是不小心召喚我兒時的臥室，因為我想找個地方躲起來。",shape=box,color=red];
		1219 -> 1227;
	1220 [label="有一次，當我被 Lodun 斬首時，我的頭顱被大力甩出去卡在樹上！",shape=box,color=red];
		1220 -> 1226;
	1221 [label="我花了六百八十個循環才學會如何騎乘凱駿。",shape=box,color=red];
		1221 -> 1225;
	1222 [label="不，我就不分享了。但是謝謝你告訴我關於塞巴斯蒂安的事。",shape=box,color=red];
		1222 -> 1223;
	1227 [label="當我想到如何逃離那裡的時候，我已經忘了我召喚過多少間臥室了。",shape=box,color=red];
		1227 -> 1228;
	1226 [label="你有辦法知道頭被砍掉後還可以活多久嗎？因為我知道喔。笑死",shape=box,color=red];
		1226 -> 1228;
	1225 [label="我開始清點我斷掉的骨頭。我想我還保留著這個清單。",shape=box,color=red];
		1225 -> 1228;
	1223 [label="早該知道。",shape=box,color=blue];
		1223 -> 1224;
	1228 [label="我的白日啊……我想你誤解這個題目了，老兄。",shape=box,color=blue];
		1228 -> 1229;
	1224 [label="Chat ends.",color=orange];
	1229 [label="但是，呃，還是謝謝你肯嘗試。",shape=box,color=blue];
		1229 -> 978;
	978 [label="Chat ends.",color=orange];
}