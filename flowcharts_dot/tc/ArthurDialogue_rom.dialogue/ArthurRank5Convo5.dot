	2396 [label="也許我內心深處想，如果我忘了渡域真的全都是我的錯",shape=box,color=red];
		2396 -> 2398;
	2397 [label="也許我內心深處想，如果我忘了一切",shape=box,color=red];
		2397 -> 2398;
	2399 [label="要不是因為 Lotus 和 Teshin……",shape=box,color=red];
		2399 -> 2400;
	2400 [label="我可能還被困在那裡。一個空殼。一個鬼魂。漸漸被遺忘和慢慢在忘記。",shape=box,color=red];
		2400 -> 2401;
	2401 [label="Check boolean ArthurApathy",color=orange];
		2401 -> 2402 [label=true,color=green];
		2401 -> 2403 [label=false,color=brown];
	2402 [label="所以，是的。你可以跟我爭論不休。",shape=box,color=red];
		2402 -> 2404;
	2403 [label="所以當我說「冷漠比一切都更糟糕」時，這就是我的意思。",shape=box,color=red];
		2403 -> 2405;
	2404 [label="但那就是為什麼冷漠更糟糕。",shape=box,color=red];
		2404 -> 2405;
	2405 [label="也就是我為什麼永遠不會放棄與它對抗。",shape=box,color=red];
		2405 -> 2406;
	2406 [label="而且你知道真正奇怪的是什麼嗎？我會回到那裡。我每次都會回去。",shape=box,color=red];
		2406 -> 2407;
		2406 -> 2408;
		2406 -> 2410;
		2406 -> 2411;
	2407 [label="因為我覺得我要對那裡的人負責。他們……他們之所以存在都是因為我。",shape=box,color=red];
		2407 -> 2412;
		2407 -> 2413;
	2408 [label="儘管它壞掉了，儘管它聽起來很混亂，它是我所知道的唯一真正的家。",shape=box,color=red];
		2408 -> 2412;
		2408 -> 2413;
	2410 [label="砸毀一個你知道會不斷重置的地方最能宣洩你的憤怒了。",shape=box,color=red];
		2410 -> 2413;
		2410 -> 2412;
	2411 [label="現在知道可以離開那裡……讓我再次覺得那裡……好有趣。我再次能夠從中找到快樂了。事情就是這麼曲折離奇。",shape=box,color=red];
		2411 -> 2412;
		2411 -> 2413;
	2412 [label="就這樣。這就是故事。",shape=box,color=red];
		2412 -> 2414;
	2413 [label="嗒噠。講完了。",shape=box,color=red];
		2413 -> 2414;
	2414 [label="……",shape=box,color=red];
		2414 -> 2415;
	2415 [label="你在嗎？",shape=box,color=red];
		2415 -> 2416;
	2416 [label="Check boolean ArthurDating",color=orange];
		2416 -> 2417 [label=true,color=green];
		2416 -> 2418 [label=false,color=brown];
	2417 [label="親愛的，我在這裡。",shape=box,color=blue];
		2417 -> 2419;
	2418 [label="我在這裡。",shape=box,color=blue];
		2418 -> 2419;
	2419 [label="白日在上……我在這裡。",shape=box,color=blue];
		2419 -> 2420;
		2419 -> 2421;
	2420 [label="呃，我想我快哭了。",shape=box,color=red];
		2420 -> 2422;
	2421 [label="這些就是你想聽的嗎？現在有開心了嗎？",shape=box,color=red];
		2421 -> 2423;
	2422 [label="如果我說只有你一個人想哭的話，那我就是在說謊。",shape=box,color=blue];
		2422 -> 2427;
	2423 [label="不，我一點都不開心。",shape=box,color=blue];
		2423 -> 2424;
	2427 [label="我……我不知道你因為自己的經歷而自責。",shape=box,color=blue];
		2427 -> 2428;
		2427 -> 2429;
	2424 [label="Check boolean ArthurDating",color=orange];
		2424 -> 2425 [label=true,color=green];
		2424 -> 2426 [label=false,color=brown];
	2428 [label="我怎麼不會呢？我確實是使用我的情感打造出那個地方的。",shape=box,color=red];
		2428 -> 2431;
	2429 [label="嗯，是啊。我們每個人都有自己的煩惱要處理。",shape=box,color=red];
		2429 -> 2430;
	2425 [label="我好傷心，親愛的。",shape=box,color=blue];
		2425 -> 2427;
	2426 [label="我好傷心。",shape=box,color=blue];
		2426 -> 2427;
	2431 [label="你是一名孩子，被迫尋找自己的父母。",shape=box,color=blue];
		2431 -> 2432;
	2430 [label="不。別這樣。別忽視這點。",shape=box,color=blue];
		2430 -> 2431;
	2432 [label="然後被遺留下來，獨自一人，面對虛空。",shape=box,color=blue];
		2432 -> 2433;
	2433 [label="我敢打賭，大多數成年人──包括我自己──都會像紙牌屋一樣倒塌……",shape=box,color=blue];
		2433 -> 2434;
	2434 [label="如果我們必須經歷你所經歷的事情。",shape=box,color=blue];
		2434 -> 2435;
	2435 [label="你已經竭盡所能做到最好了。你活了下來。",shape=box,color=blue];
		2435 -> 2436;
	2436 [label="而且你看看你成為了什麼樣的人。",shape=box,color=blue];
		2436 -> 2437;
	2437 [label="始源星系救世主──還是什麼的。",shape=box,color=blue];
		2437 -> 2438;
	2438 [label="Check boolean ArthurDating",color=orange];
		2438 -> 2439 [label=true,color=green];
		2438 -> 2440 [label=false,color=brown];
	2439 [label="也是這個世界上我最喜歡的人。",shape=box,color=blue];
		2439 -> 2441;
	2440 [label="也是我最親愛的朋友之一。",shape=box,color=blue];
		2440 -> 2442;
	2441 [label="所以，現在你不會……小看我了，對吧？",shape=box,color=red];
		2441 -> 2443;
	2442 [label="你又要讓我哭了。",shape=box,color=red];
		2442 -> 2444;
	2443 [label="相反。",shape=box,color=blue];
		2443 -> 2445;
	2444 [label="嗯，好吧……",shape=box,color=blue];
		2444 -> 2446;
	2445 [label="完全相反。",shape=box,color=blue];
		2445 -> 2447;
	2446 [label="有時候這對你有好處。",shape=box,color=blue];
		2446 -> 2448;
	2447 [label="我發誓。",shape=box,color=blue];
		2447 -> 2449;
	2448 [label="至少莉蒂是這麼告訴我的。",shape=box,color=blue];
		2448 -> 2449;
	2449 [label="Check boolean ArthurDating",color=orange];
		2449 -> 2450 [label=true,color=green];
		2449 -> 2451 [label=false,color=brown];
	2450 [label="謝謝。它對我的意義……超出了你的想像。",shape=box,color=red];
