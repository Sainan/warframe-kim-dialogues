	3296 [label="同意。",shape=box,color=blue];
		3296 -> 3304;
	3297 [label="部分的我希望我們有更多同類在外頭。但到時如果他們來到這裡的話，我們可能會需要更大的商場。",shape=box,color=blue];
		3297 -> 3305;
