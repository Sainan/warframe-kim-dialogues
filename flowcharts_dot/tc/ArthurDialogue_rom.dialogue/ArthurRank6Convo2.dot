digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo2 begins." [color=orange];
		"ArthurRank6Convo2 begins." -> j3399922419;
	j3399922419 [label="我在想。你覺得還有多少個像我們這樣的在外頭？",shape=box,color=blue];
		j3399922419 -> j368672307;
		j3399922419 -> j3752858775;
	j368672307 [label="你是說 1999 年這裡，還是更廣泛的層面上？",shape=box,color=red];
		j368672307 -> j1558813478;
	j3752858775 [label="「我們」，指的是？",shape=box,color=red];
		j3752858775 -> j3401019407;
	j1558813478 [label="都有吧，我想。這裡、現在、過去、未來。",shape=box,color=blue];
		j1558813478 -> j247731888;
	j3401019407 [label="原型 Warframe。無論是這裡或哪裡。又或是無論哪時，我在想。",shape=box,color=blue];
		j3401019407 -> j247731888;
	j247731888 [label="源拓氏製造我們是有目的的。多種目的。顯然，這已經超過不止我們六個了。",shape=box,color=blue];
		j247731888 -> j921133688;
		j247731888 -> j2774392264;
	j921133688 [label="起初，我還以為他是在幫我製造「備用」Warframe，以防我的 Warframe 沒能通過 Helminth。現在，我就不太確定了。",shape=box,color=red];
		j921133688 -> j2968663370;
	j2774392264 [label="我只是希望知道他打算做什麼。或是他製造更多原型 Warframe 背後的真正動機是什麼。",shape=box,color=red];
		j2774392264 -> j3106894691;
	j2968663370 [label="當只有我們六個時這還說得通。",shape=box,color=blue];
		j2968663370 -> j3106894691;
	j3106894691 [label="你真的相信他真正的動機是為了阻止漠然嗎？",shape=box,color=blue];
		j3106894691 -> j4286395159;
	j4286395159 [label="我們真的可以信任他嗎？",shape=box,color=blue];
		j4286395159 -> j783107161;
		j4286395159 -> j1793188948;
		j4286395159 -> j3046111626;
	j783107161 [label="老實說，我不知道。我完全不信任他也不相信我能夠重摔他。沒有 Warframe 的話，我的摔技根本超爛。",shape=box,color=red];
		j783107161 -> j368529741;
	j1793188948 [label="不行。我們無法相信他的動機也無法相信他的做法。",shape=box,color=red];
		j1793188948 -> j3662345040;
		j1793188948 -> j2018942287;
	j3046111626 [label="可以。雖然說我並不總是認同他的做法。但可以的。他想要阻止那個東西。",shape=box,color=red];
		j3046111626 -> j2018942287;
		j3046111626 -> j3662345040;
	j368529741 [label="+5 Chemistry",color=orange];
		j368529741 -> j322065328;
	j3662345040 [label="他在試圖讓已發生的事彷彿未曾發生過──如果這方法行得通的話。而這是個混亂的過程。",shape=box,color=red];
		j3662345040 -> j565596361;
	j2018942287 [label="但我們還有其它選擇嗎？我和那孩子能做的就是跟在他身後，收拾他留下的爛攤子。",shape=box,color=red];
		j2018942287 -> j4227026064;
		j2018942287 -> j3573398905;
	j322065328 [label="呵。",shape=box,color=blue];
		j322065328 -> j3662345040;
		j322065328 -> j2018942287;
	j565596361 [label="而我們就是學校的工友了，幫他收拾爛攤子。真棒。",shape=box,color=blue];
		j565596361 -> j4227026064;
		j565596361 -> j3573398905;
	j4227026064 [label="現在卡婭對時間旅行有了自己的看法，我來回穿越可能會變得更容易了。",shape=box,color=red];
		j4227026064 -> j2280202670;
	j3573398905 [label="但我會待在這裡，所以現在就看那孩子要怎麼樣了。",shape=box,color=red];
		j3573398905 -> j161265069;
	j2280202670 [label="那孩子有時確實很煩，但我還是很感激這點。",shape=box,color=blue];
		j2280202670 -> j335273273;
	j161265069 [label="Check boolean ArthurDating",color=orange];
		j161265069 -> j165747911 [label=true,color=green];
		j161265069 -> j404111931 [label=false,color=brown];
	j335273273 [label="這種感覺很棒，知道你去了趟商店……知道你可能會回來…… : /",shape=box,color=blue];
		j335273273 -> j2613732724;
	j165747911 [label="呃。我們就再看囉。親愛的，我太了解你了。而我知道你不清楚什麼時候該保持低調。",shape=box,color=blue];
		j165747911 -> j3478430943;
	j404111931 [label="呃。我們就再看囉。漂泊者，我太了解你了。而我知道你不清楚什麼時候該保持低調。",shape=box,color=blue];
		j404111931 -> j2670481489;
	j2613732724 [label="Check boolean ArthurDating",color=orange];
		j2613732724 -> j758501858 [label=true,color=green];
		j2613732724 -> j3703651009 [label=false,color=brown];
		j2613732724 -> j264562465 [label=false,color=brown];
	j3478430943 [label="這是我愛慕你的理由之一。 ; )",shape=box,color=blue];
		j3478430943 -> j264562465;
	j2670481489 [label="這是我讓你待在身邊還得忍受你的理由之一。 ; )",shape=box,color=blue];
		j2670481489 -> j3703651009;
	j758501858 [label="我欠她不少，她似乎讓我多少能夠安心。 : )",shape=box,color=blue];
		j758501858 -> j3703651009;
		j758501858 -> j264562465;
	j3703651009 [label="表情符號！: D",shape=box,color=red];
		j3703651009 -> j1860438205;
	j264562465 [label="別對我這麼肉麻了。",shape=box,color=red];
		j264562465 -> j2917878260;
	j1860438205 [label="是啊。別太習慣。感覺還是很奇怪。",shape=box,color=blue];
		j1860438205 -> j2745970662;
	j2917878260 [label="嗯，你懂我的。外酥內軟。就像阿米爾和韋利米爾一直推薦的那些惡心糕點的走味版本。",shape=box,color=blue];
		j2917878260 -> j4034900296;
	j2745970662 [label="嗯，還真讓我感到驚訝呢。",shape=box,color=red];
		j2745970662 -> j3546719533;
	j4034900296 [label="好像叫什麼甜貝的吧？",shape=box,color=blue];
		j4034900296 -> j3546719533;
	j3546719533 [label="反正。回到正題。有時我會感到很沉重，覺得源拓氏對我們所有人都有更大的意圖。",shape=box,color=blue];
		j3546719533 -> j3946064759;
		j3546719533 -> j1068936383;
		j3546719533 -> j1459822837;
	j3946064759 [label="你為什麼這麼說？",shape=box,color=red];
		j3946064759 -> j2799082434;
	j1068936383 [label="嗯，你可能是對的。",shape=box,color=red];
		j1068936383 -> j2938492504;
	j1459822837 [label="有沒有可能只是一廂情願？",shape=box,color=red];
		j1459822837 -> j3355964789;
	j2799082434 [label="他為了創造我們要付出的心力。而事實上，遠不止我們六個……",shape=box,color=blue];
		j2799082434 -> j609531274;
	j2938492504 [label="不然你以為呢？而且他是在等什麼？",shape=box,color=blue];
		j2938492504 -> j4163118544;
		j2938492504 -> j247335765;
	j3355964789 [label="你是什麼意思？",shape=box,color=blue];
		j3355964789 -> j2800638441;
		j3355964789 -> j1277550509;
	j609531274 [label="夥計，除非你真的打算使用這些武器，否則你壓根就不會去打造他們。",shape=box,color=blue];
		j609531274 -> j542693437;
	j4163118544 [label="<RETRO_EMOJI_SHRUG>",shape=box,color=red];
		j4163118544 -> j3464705725;
	j247335765 [label="我希望我知道這兩個面向的答案。",shape=box,color=red];
		j247335765 -> j3464705725;
	j2800638441 [label="有時候，很難想像自己不再「重要」。",shape=box,color=red];
		j2800638441 -> j2181914517;
	j1277550509 [label="嗯，我想說的是……或許你只是不想覺得自己被利用完就遭他拋棄。",shape=box,color=red];
		j1277550509 -> j753414220;
	j542693437 [label="除非你知道即將會發生一場戰爭。",shape=box,color=blue];
		j542693437 -> j4057245393;
		j542693437 -> j224886121;
		j542693437 -> j2608269558;
	j3464705725 [label="也許他需要一支軍隊？也許他在試圖尋找他認為可以擊敗漠然的那「唯一東西」。也許因為很多種原因。",shape=box,color=red];
		j3464705725 -> j2864700605;
	j2181914517 [label="也是……",shape=box,color=blue];
		j2181914517 -> "Chat ends.";
	j753414220 [label="無論他來這裡的目的是什麼，無論他對你做了什麼，都還是重要的。還是有原因的。這一切都沒有失敗。",shape=box,color=red];
		j753414220 -> j1859461760;
		j753414220 -> j265469014;
	j4057245393 [label="如果發生這種事的話，那我們能做的就是做好準備了。",shape=box,color=red];
		j4057245393 -> j4281255532;
	j224886121 [label="這有可能。但源拓氏似乎也是那種會有應變計畫的人。",shape=box,color=red];
		j224886121 -> j2775960815;
	j2608269558 [label="我不知道。米娜瓦和韋利米爾有跟我講關於……「冷戰」的事。聽起來人們製造了很多瘋狂的武器但從未使用過它們。",shape=box,color=red];
		j2608269558 -> j4061597242;
	j2864700605 [label="不禁覺得我們就像子彈。註定被用掉。被發射。最後被丟棄。",shape=box,color=blue];
		j2864700605 -> j1279358328;
		j2864700605 -> j868074313;
	"Chat ends." [color=orange];
	j1859461760 [label="而明確地說，你還是很重要。",shape=box,color=red];
		j1859461760 -> j66398933;
		j1859461760 -> j2595364751;
		j1859461760 -> j2495336559;
	j265469014 [label="而明確地說，你對我還是很重要。",shape=box,color=red];
		j265469014 -> j66398933;
		j265469014 -> j2595364751;
		j265469014 -> j2495336559;
	j4281255532 [label="+5 Chemistry",color=orange];
		j4281255532 -> j3219163515;
	j2775960815 [label="也許吧。",shape=box,color=blue];
		j2775960815 -> j1917153686;
	j4061597242 [label="反駁有理。但那是國與國之間的問題，涉及外交。參雜變數。",shape=box,color=blue];
		j4061597242 -> j4113035324;
	j1279358328 [label="我希望我能夠回答你。但我會盡我所能阻止這種情況發生。",shape=box,color=red];
		j1279358328 -> j1048037252;
	j868074313 [label="你不認為自己已經完成使命了嗎？",shape=box,color=red];
		j868074313 -> j4286496445;
	j66398933 [label="但想到你的故事到這裡就結束了，這一切結束時卻無法參與其中，那簡直糟透了。",shape=box,color=red];
		j66398933 -> j113426602;
	j2595364751 [label="但也許想到你被個亞瑟 2.0 取代了就覺得很痛苦。",shape=box,color=red];
		j2595364751 -> j996476889;
	j2495336559 [label="但也許你只是希望自己的犧牲在更宏觀的層面上來說還是很重要。",shape=box,color=red];
		j2495336559 -> j1254596948;
	j3219163515 [label="同意。",shape=box,color=blue];
		j3219163515 -> j1234428523;
	j1917153686 [label="部分的我希望我們有更多同類在外頭。但到時如果他們來到這裡的話，我們可能會需要更大的商場。",shape=box,color=blue];
		j1917153686 -> "Chat ends.";
	j4113035324 [label="這是神與一名自認為神的人之間的問題。",shape=box,color=blue];
		j4113035324 -> j3380148565;
	j1048037252 [label="我知道你會。還有我們會一起面對那一天，這我有信心。",shape=box,color=blue];
		j1048037252 -> j2397353713;
	j4286496445 [label="不。夥計，除非你真的打算使用這些武器，否則你壓根就不會去打造他們。",shape=box,color=blue];
		j4286496445 -> j2711306759;
		j4286496445 -> j224886121;
		j4286496445 -> j4057245393;
	j113426602 [label="這或許是部分的原因。如果是因為漠然我變成這樣，而且我還得經歷這一切的話，",shape=box,color=blue];
		j113426602 -> j2002382157;
	j996476889 [label="夥計，我已經準備好要隱退了，都還可以被捲入這檔破事。完全沒這回事。",shape=box,color=blue];
		j996476889 -> j1195662717;
	j1254596948 [label="或許是。或許不是。但人生中有多少人的犧牲是毫無意義的？絕大部分。",shape=box,color=blue];
		j1254596948 -> j274709090;
	j1234428523 [label="也希望如果我們有更多同類來到這裡，到時我們不會需要更大的商場。",shape=box,color=blue];
		j1234428523 -> "Chat ends.";
	j3380148565 [label="我把賭注壓在不可避免的衝突上。我不認為他們的自尊能夠允許其它可能性。",shape=box,color=blue];
		j3380148565 -> j630753606;
		j3380148565 -> j886015864;
	j2397353713 [label="+5 Chemistry",color=orange];
		j2397353713 -> j1648722223;
	j2711306759 [label="我不知道。米娜瓦和韋利米爾有跟我講關於……「冷戰」的事。聽起來人們製造了很多瘋狂的武器但從未使用過它們。",shape=box,color=red];
		j2711306759 -> j609073488;
	j2002382157 [label="我想要親手了結它。",shape=box,color=blue];
		j2002382157 -> j1453368405;
