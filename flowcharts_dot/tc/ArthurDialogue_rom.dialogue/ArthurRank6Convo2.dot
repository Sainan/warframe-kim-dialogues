digraph {
	3229 [label="ArthurRank6Convo2 begins.",color=orange];
		3229 -> 3230;
	3230 [label="我在想。你覺得還有多少個像我們這樣的在外頭？",shape=box,color=blue];
		3230 -> 3231;
		3230 -> 3232;
	3231 [label="你是說 1999 年這裡，還是更廣泛的層面上？",shape=box,color=red];
		3231 -> 3233;
	3232 [label="「我們」，指的是？",shape=box,color=red];
		3232 -> 3234;
	3233 [label="都有吧，我想。這裡、現在、過去、未來。",shape=box,color=blue];
		3233 -> 3235;
	3234 [label="原型 Warframe。無論是這裡或哪裡。又或是無論哪時，我在想。",shape=box,color=blue];
		3234 -> 3235;
	3235 [label="源拓氏製造我們是有目的的。多種目的。顯然，這已經超過不止我們六個了。",shape=box,color=blue];
		3235 -> 3236;
		3235 -> 3237;
	3236 [label="起初，我還以為他是在幫我製造「備用」Warframe，以防我的 Warframe 沒能通過 Helminth。現在，我就不太確定了。",shape=box,color=red];
		3236 -> 3238;
	3237 [label="我只是希望知道他打算做什麼。或是他製造更多原型 Warframe 背後的真正動機是什麼。",shape=box,color=red];
		3237 -> 3239;
	3238 [label="當只有我們六個時這還說得通。",shape=box,color=blue];
		3238 -> 3239;
	3239 [label="你真的相信他真正的動機是為了阻止漠然嗎？",shape=box,color=blue];
		3239 -> 3240;
	3240 [label="我們真的可以信任他嗎？",shape=box,color=blue];
		3240 -> 3241;
		3240 -> 3242;
		3240 -> 3243;
	3241 [label="老實說，我不知道。我完全不信任他也不相信我能夠重摔他。沒有 Warframe 的話，我的摔技根本超爛。",shape=box,color=red];
		3241 -> 3244;
	3242 [label="不行。我們無法相信他的動機也無法相信他的做法。",shape=box,color=red];
		3242 -> 3245;
		3242 -> 3246;
	3243 [label="可以。雖然說我並不總是認同他的做法。但可以的。他想要阻止那個東西。",shape=box,color=red];
		3243 -> 3246;
		3243 -> 3245;
	3244 [label="+5 Chemistry",color=orange];
		3244 -> 3247;
	3245 [label="他在試圖讓已發生的事彷彿未曾發生過──如果這方法行得通的話。而這是個混亂的過程。",shape=box,color=red];
		3245 -> 3248;
	3246 [label="但我們還有其它選擇嗎？我和那孩子能做的就是跟在他身後，收拾他留下的爛攤子。",shape=box,color=red];
		3246 -> 3249;
		3246 -> 3250;
	3247 [label="呵。",shape=box,color=blue];
		3247 -> 3245;
		3247 -> 3246;
	3248 [label="而我們就是學校的工友了，幫他收拾爛攤子。真棒。",shape=box,color=blue];
		3248 -> 3249;
		3248 -> 3250;
	3249 [label="現在卡婭對時間旅行有了自己的看法，我來回穿越可能會變得更容易了。",shape=box,color=red];
		3249 -> 3251;
	3250 [label="但我會待在這裡，所以現在就看那孩子要怎麼樣了。",shape=box,color=red];
		3250 -> 3254;
	3251 [label="那孩子有時確實很煩，但我還是很感激這點。",shape=box,color=blue];
		3251 -> 3253;
	3254 [label="Check boolean ArthurDating",color=orange];
		3254 -> 3603 [label=true,color=green];
		3254 -> 3252 [label=false,color=brown];
	3253 [label="這種感覺很棒，知道你去了趟商店……知道你可能會回來…… : /",shape=box,color=blue];
		3253 -> 3255;
	3603 [label="呃。我們就再看囉。親愛的，我太了解你了。而我知道你不清楚什麼時候該保持低調。",shape=box,color=blue];
		3603 -> 3257;
	3252 [label="呃。我們就再看囉。漂泊者，我太了解你了。而我知道你不清楚什麼時候該保持低調。",shape=box,color=blue];
		3252 -> 3256;
	3255 [label="Check boolean ArthurDating",color=orange];
		3255 -> 3260 [label=true,color=green];
		3255 -> 3258 [label=false,color=brown];
		3255 -> 3259 [label=false,color=brown];
	3257 [label="這是我愛慕你的理由之一。 ; )",shape=box,color=blue];
		3257 -> 3259;
	3256 [label="這是我讓你待在身邊還得忍受你的理由之一。 ; )",shape=box,color=blue];
		3256 -> 3258;
	3260 [label="我欠她不少，她似乎讓我多少能夠安心。 : )",shape=box,color=blue];
		3260 -> 3258;
		3260 -> 3259;
	3258 [label="表情符號！: D",shape=box,color=red];
		3258 -> 3261;
	3259 [label="別對我這麼肉麻了。",shape=box,color=red];
		3259 -> 3262;
	3261 [label="是啊。別太習慣。感覺還是很奇怪。",shape=box,color=blue];
		3261 -> 3263;
	3262 [label="嗯，你懂我的。外酥內軟。就像阿米爾和韋利米爾一直推薦的那些惡心糕點的走味版本。",shape=box,color=blue];
		3262 -> 3264;
	3263 [label="嗯，還真讓我感到驚訝呢。",shape=box,color=red];
		3263 -> 3265;
	3264 [label="好像叫什麼甜貝的吧？",shape=box,color=blue];
		3264 -> 3265;
	3265 [label="反正。回到正題。有時我會感到很沉重，覺得源拓氏對我們所有人都有更大的意圖。",shape=box,color=blue];
		3265 -> 3266;
		3265 -> 3267;
		3265 -> 3268;
	3266 [label="你為什麼這麼說？",shape=box,color=red];
		3266 -> 3269;
	3267 [label="嗯，你可能是對的。",shape=box,color=red];
		3267 -> 3270;
	3268 [label="有沒有可能只是一廂情願？",shape=box,color=red];
		3268 -> 3271;
	3269 [label="他為了創造我們要付出的心力。而事實上，遠不止我們六個……",shape=box,color=blue];
		3269 -> 3272;
	3270 [label="不然你以為呢？而且他是在等什麼？",shape=box,color=blue];
		3270 -> 3273;
		3270 -> 3274;
	3271 [label="你是什麼意思？",shape=box,color=blue];
		3271 -> 3275;
		3271 -> 3276;
	3272 [label="夥計，除非你真的打算使用這些武器，否則你壓根就不會去打造他們。",shape=box,color=blue];
		3272 -> 3277;
	3273 [label="<RETRO_EMOJI_SHRUG>",shape=box,color=red];
		3273 -> 3278;
	3274 [label="我希望我知道這兩個面向的答案。",shape=box,color=red];
		3274 -> 3278;
	3275 [label="有時候，很難想像自己不再「重要」。",shape=box,color=red];
		3275 -> 3279;
	3276 [label="嗯，我想說的是……或許你只是不想覺得自己被利用完就遭他拋棄。",shape=box,color=red];
		3276 -> 3280;
	3277 [label="除非你知道即將會發生一場戰爭。",shape=box,color=blue];
		3277 -> 3281;
		3277 -> 3282;
		3277 -> 3283;
	3278 [label="也許他需要一支軍隊？也許他在試圖尋找他認為可以擊敗漠然的那「唯一東西」。也許因為很多種原因。",shape=box,color=red];
		3278 -> 3284;
	3279 [label="也是……",shape=box,color=blue];
		3279 -> 3285;
	3280 [label="無論他來這裡的目的是什麼，無論他對你做了什麼，都還是重要的。還是有原因的。這一切都沒有失敗。",shape=box,color=red];
		3280 -> 3286;
		3280 -> 3287;
	3281 [label="如果發生這種事的話，那我們能做的就是做好準備了。",shape=box,color=red];
		3281 -> 3288;
	3282 [label="這有可能。但源拓氏似乎也是那種會有應變計畫的人。",shape=box,color=red];
		3282 -> 3289;
	3283 [label="我不知道。米娜瓦和韋利米爾有跟我講關於……「冷戰」的事。聽起來人們製造了很多瘋狂的武器但從未使用過它們。",shape=box,color=red];
		3283 -> 3290;
	3284 [label="不禁覺得我們就像子彈。註定被用掉。被發射。最後被丟棄。",shape=box,color=blue];
		3284 -> 3291;
		3284 -> 3292;
	3285 [label="Chat ends.",color=orange];
	3286 [label="而明確地說，你還是很重要。",shape=box,color=red];
