		3290 -> 3298;
	3291 [label="我希望我能夠回答你。但我會盡我所能阻止這種情況發生。",shape=box,color=red];
		3291 -> 3299;
	3292 [label="你不認為自己已經完成使命了嗎？",shape=box,color=red];
		3292 -> 3300;
