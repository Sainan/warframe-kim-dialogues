digraph {
	3571 [label="ArthurRank6Convo10 begins.",color=orange];
		3571 -> 3572;
		3571 -> 3573;
	3572 [label="嘿，亞瑟。最近怎麼樣？",shape=box,color=red];
		3572 -> 3574;
	3573 [label="今天要幹嘛？",shape=box,color=red];
		3573 -> 3575;
	3574 [label="我做了個愚蠢的決定，跟阿米爾比《奧利的終極賽道》。",shape=box,color=blue];
		3574 -> 3576;
	3575 [label="崑西和我差不多要出發一起去偵察了。是他的主意，不是我的。",shape=box,color=blue];
		3575 -> 3577;
	3576 [label="而現在我非常惱火，因為他一直打破我的最高得分。",shape=box,color=blue];
		3576 -> 3578;
	3577 [label="我們的關係很奇怪。我們不怎麼說話。",shape=box,color=blue];
		3577 -> 3579;
	3578 [label="……我在過去的兩天花了二十六個小時在玩這個遊戲。",shape=box,color=blue];
		3578 -> 3580;
	3579 [label="但我們都知道，如果情況危急，我們都會為對方犧牲。",shape=box,color=blue];
		3579 -> 3581;
	3580 [label="如果我再接近那鬼東西的話，就請莉蒂給我施打鎮靜劑。",shape=box,color=blue];
		3580 -> 3582;
	3581 [label="我猜有時候，這就是家人意義所在，「對吧」？",shape=box,color=blue];
		3581 -> 3583;
	3582 [label="Chat ends.",color=orange];
	3583 [label="Chat ends.",color=orange];
}