	"ArthurRank6Convo10 begins." [color=orange];
		"ArthurRank6Convo10 begins." -> j890527556;
		"ArthurRank6Convo10 begins." -> j1746509788;
	j890527556 [label="嘿，亞瑟。最近怎麼樣？",shape=box,color=red];
		j890527556 -> j2718476805;
	j1746509788 [label="今天要幹嘛？",shape=box,color=red];
		j1746509788 -> j647802008;
	j2718476805 [label="我做了個愚蠢的決定，跟阿米爾比《奧利的終極賽道》。",shape=box,color=blue];
		j2718476805 -> j2571134;
	j647802008 [label="崑西和我差不多要出發一起去偵察了。是他的主意，不是我的。",shape=box,color=blue];
		j647802008 -> j272199648;
	j2571134 [label="而現在我非常惱火，因為他一直打破我的最高得分。",shape=box,color=blue];
		j2571134 -> j1175161170;
	j272199648 [label="我們的關係很奇怪。我們不怎麼說話。",shape=box,color=blue];
		j272199648 -> j1633452932;
	j1175161170 [label="……我在過去的兩天花了二十六個小時在玩這個遊戲。",shape=box,color=blue];
		j1175161170 -> j3430004906;
	j1633452932 [label="但我們都知道，如果情況危急，我們都會為對方犧牲。",shape=box,color=blue];
		j1633452932 -> j412027746;
	j3430004906 [label="如果我再接近那鬼東西的話，就請莉蒂給我施打鎮靜劑。",shape=box,color=blue];
		j3430004906 -> "Chat ends.";
	j412027746 [label="我猜有時候，這就是家人意義所在，「對吧」？",shape=box,color=blue];
		j412027746 -> "Chat ends.";
	"Chat ends." [color=orange];
}