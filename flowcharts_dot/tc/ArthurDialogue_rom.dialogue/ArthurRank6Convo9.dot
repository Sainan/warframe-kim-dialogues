digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"ArthurRank6Convo9 begins." [color=orange];
		"ArthurRank6Convo9 begins." -> j4010144566;
	j4010144566 [label="我對於愛琳娜收集的這些……感染槍枝感到匪夷所思。",shape=box,color=blue];
		j4010144566 -> j50135687;
		j4010144566 -> j395656633;
	j50135687 [label="怎麼說？",shape=box,color=red];
		j50135687 -> j2631160891;
	j395656633 [label="至少它們不會說話。",shape=box,color=red];
		j395656633 -> j1107674339;
	j2631160891 [label="除了我認為她能與它們對話這件事以外",shape=box,color=blue];
		j2631160891 -> j1864405759;
	j1107674339 [label="至少對我們是不會說。我不太確定它們是不是也不會對她說。",shape=box,color=blue];
		j1107674339 -> j1864405759;
	j1864405759 [label="我知道它們會和那把吉他說話。如沒必要的話，我還真的不想去多想這件事。",shape=box,color=blue];
		j1864405759 -> j975731400;
	j975731400 [label="但我們應該擔心它們……擴編嗎？它們確實似乎在增殖。",shape=box,color=blue];
		j975731400 -> j3478998533;
	j3478998533 [label="這我就不明白了。我也不想去多想它們的彈藥來自哪裡。或者首先它到底是由什麼構成的。",shape=box,color=blue];
		j3478998533 -> j2231088854;
		j3478998533 -> j715716867;
	j2231088854 [label="至少這些感染者東西是站在我們這邊的，對吧？",shape=box,color=red];
		j2231088854 -> j3109789174;
	j715716867 [label="那你或許就繼續使用普通槍枝吧。",shape=box,color=red];
		j715716867 -> j1664891080;
	j3109789174 [label="當然。至少現在是這樣。",shape=box,color=blue];
		j3109789174 -> j2237516425;
	j1664891080 [label="我想我會這麼做。",shape=box,color=blue];
		j1664891080 -> j2237516425;
	j2237516425 [label="至少如果我的次要武器在我腳上轟出一個破洞，我會知道是我這個白癡的錯。",shape=box,color=blue];
		j2237516425 -> j876412476;
	j876412476 [label="而不是因為我的槍決定重新考慮它的忠誠度或者半夜突然想吃東西。",shape=box,color=blue];
		j876412476 -> "Chat ends.";
	"Chat ends." [color=orange];
}