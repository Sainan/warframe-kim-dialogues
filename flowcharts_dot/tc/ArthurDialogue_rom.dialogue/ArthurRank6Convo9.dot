digraph {
	3555 [label="ArthurRank6Convo9 begins.",color=orange];
		3555 -> 3556;
	3556 [label="我對於愛琳娜收集的這些……感染槍枝感到匪夷所思。",shape=box,color=blue];
		3556 -> 3557;
		3556 -> 3558;
	3557 [label="怎麼說？",shape=box,color=red];
		3557 -> 3559;
	3558 [label="至少它們不會說話。",shape=box,color=red];
		3558 -> 3560;
	3559 [label="除了我認為她能與它們對話這件事以外",shape=box,color=blue];
		3559 -> 3561;
	3560 [label="至少對我們是不會說。我不太確定它們是不是也不會對她說。",shape=box,color=blue];
		3560 -> 3561;
	3561 [label="我知道它們會和那把吉他說話。如沒必要的話，我還真的不想去多想這件事。",shape=box,color=blue];
		3561 -> 3562;
	3562 [label="但我們應該擔心它們……擴編嗎？它們確實似乎在增殖。",shape=box,color=blue];
		3562 -> 3563;
	3563 [label="這我就不明白了。我也不想去多想它們的彈藥來自哪裡。或者首先它到底是由什麼構成的。",shape=box,color=blue];
		3563 -> 3564;
		3563 -> 3565;
	3564 [label="至少這些感染者東西是站在我們這邊的，對吧？",shape=box,color=red];
		3564 -> 3566;
	3565 [label="那你或許就繼續使用普通槍枝吧。",shape=box,color=red];
		3565 -> 3567;
	3566 [label="當然。至少現在是這樣。",shape=box,color=blue];
		3566 -> 3568;
	3567 [label="我想我會這麼做。",shape=box,color=blue];
		3567 -> 3568;
	3568 [label="至少如果我的次要武器在我腳上轟出一個破洞，我會知道是我這個白癡的錯。",shape=box,color=blue];
		3568 -> 3569;
	3569 [label="而不是因為我的槍決定重新考慮它的忠誠度或者半夜突然想吃東西。",shape=box,color=blue];
		3569 -> 3570;
	3570 [label="Chat ends.",color=orange];
}