	851 [label="Update boolean VelimirEntrati",color=orange];
		851 -> 856;
	848 [label="很難說哪個會更糟糕。",shape=box,color=red];
		848 -> 853;
	849 [label="不知道。不過源拓氏確實在過去曾對動物進行過實驗。",shape=box,color=red];
		849 -> 854;
	852 [label="PapaPolar: 搞砸了這一切",shape=box,color=blue];
		852 -> 857;
	855 [label="PapaPolar: 是的，我在 1998 年初來到這個混亂的境地，所以比你來得早。妮熙拒絕見我們。我們甚至根本無法接近她",shape=box,color=blue];
		855 -> 858;
	856 [label="PapaPolar: 我在 1998 年初來到這個混亂的境地，所以比你來得早。妮熙拒絕見我們。我們甚至根本無法接近她",shape=box,color=blue];
		856 -> 858;
	853 [label="PapaPolar: 對吧？被吃掉還是當實驗動物。呃。我想我寧願被吃掉而不是被折磨。一個是自然的。另一個則是。噁心。",shape=box,color=blue];
		853 -> 841;
	854 [label="PapaPolar: 我想我寧願被吃掉而不是被折磨。一個是自然的。另一個則是。噁心。",shape=box,color=blue];
		854 -> 841;
	857 [label="MomToxicated: 韋，我過去接你。現在你應該停止打字了。",shape=box,color=blue];
		857 -> 859;
	858 [label="Check boolean MinervaNeciArm",color=orange];
		858 -> 860 [label=true,color=green];
		858 -> 861 [label=false,color=brown];
	859 [label="PapaPolar: 不知道怎麼告訴她",shape=box,color=blue];
		859 -> 862;
	860 [label="PapaPolar: 這就是為什麼我們不知道她失去了手臂。甚至都沒看到任何影像有證明這種情況。我猜她當時並不想讓任何人知道這件事吧？不知道欸。",shape=box,color=blue];
		860 -> 863;
	861 [label="Check boolean VelimirNeciArm",color=orange];
		861 -> 860 [label=true,color=green];
		861 -> 864 [label=false,color=brown];
	862 [label="PapaPolar: 或是我該不該告訴她",shape=box,color=blue];
		862 -> 865;
		862 -> 866;
	863 [label="PapaPolar: 也許直到那東西佔據她，她才開始讓大家看到。只是揣測。總之。",shape=box,color=blue];
		863 -> 864;
	864 [label="PapaPolar: 整座城市已經處於封鎖狀態。我們之所以能進入，是因為我們有足夠的假證件，並且有進出這類情況的經驗，知道怎麼給對的人對的好處",shape=box,color=blue];
		864 -> 867;
	865 [label="你現在應該去躺下了。",shape=box,color=red];
		865 -> 868;
	866 [label="告訴她什麼？",shape=box,color=red];
		866 -> 868;
	867 [label="PapaPolar: 我們以企業銷售代表的身份潛入，說要修復線上數位銷售的供應鏈。世界可能正在滅亡，但人們還是會想要他們的免運費",shape=box,color=blue];
		867 -> 869;
	868 [label="PapaPolar: 該死，憤怒的美女來了，她非常生氣",shape=box,color=blue];
		868 -> 870;
	869 [label="PapaPolar: 這之後，米和我收到一個集裝箱，裡面裝滿了你想像得到的最隨機的物品，一大筆賄賂金，還有重型武器。在辦公室裡的一個辦公日。",shape=box,color=blue];
		869 -> 871;
	870 [label="PapaPolar: 我得走",shape=box,color=blue];
		870 -> 872;
	871 [label="PapaPolar: 猜猜看誰來敲我們的門，給我們提供妮熙的線索？某個讓米非常緊張的陌生博士。",shape=box,color=blue];
		871 -> 873;
	872 [label="Update boolean VelimirDrunk",color=orange];
		872 -> 874;
	873 [label="MomToxicated: 我對這類事情有敏銳的直覺。",shape=box,color=blue];
		873 -> 875;
	874 [label="+20 Chemistry",color=orange];
		874 -> 876;
	875 [label="PapaPolar: 但猜猜看我們在尋找妮熙時還找到了什麼？嚴重的龜甲綜合病症。",shape=box,color=blue];
		875 -> 877;
		875 -> 878;
	876 [label="Chat ends. Next chat will be MinVelRank4Convo1.",color=orange];
	877 [label="什麼症？",shape=box,color=red];
		877 -> 879;
	878 [label="而源拓氏剛好有治療它的注射劑。",shape=box,color=red];
		878 -> 880;
	879 [label="MomToxicated: 是科腐症狀，親愛的。",shape=box,color=blue];
		879 -> 881;
	880 [label="PapaPolar: 是滴。但他告訴我們這會對我們造成什麼樣的影響。我們知道，清楚知道，自己會變成什麼樣子。",shape=box,color=blue];
		880 -> 882;
	881 [label="MomToxicated: 但我必須承認，源拓氏對待我們比起目前為止我們遇到的許多其他原型 Warframe 還要好。",shape=box,color=blue];
		881 -> 883;
	882 [label="PapaPolar: 他沒告訴我們的是，一個該死的虛空怪物已經帶走了我們的小女孩",shape=box,color=blue];
		882 -> 884;
	883 [label="MomToxicated: 他非常直白地告訴我們，科腐會對我們造成什麼樣的影響。他還為我們提供治療方面的選擇。",shape=box,color=blue];
		883 -> 882;
	884 [label="MomToxicated: 沒有，他非常巧妙地省略了那一部分。而當我們從我們的……治療……中恢復過來時，你已經抵達霍爾瓦尼亞了。",shape=box,color=blue];
		884 -> 885;
