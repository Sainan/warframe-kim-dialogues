	803 [label="PapaPolar: 非常確定復仇是一道燒烤佳餚",shape=box,color=blue];
		803 -> 806;
	805 [label="PapaPolar: 這樣啊。好吧。",shape=box,color=blue];
		805 -> 809;
	804 [label="PapaPolar: 嘿，猜猜看。猜猜我今天學到了什麼",shape=box,color=blue];
		804 -> 807;
		804 -> 808;
	806 [label="PapaPolar: 天哪，完了這樣太壞了，要下地獄了",shape=box,color=blue];
		806 -> 810;
	809 [label="PapaPolar: 那是個選擇喔，蛤？",shape=box,color=blue];
