		807 -> 811;
	808 [label="呃哦。",shape=box,color=red];
		808 -> 811;
	810 [label="PapaPolar: 而且是從我嘴巴裡說出來的。我曾經在生鏽輪蓋上吃過已經過期三週的發臭馴鹿肉。（順便帶一題，加點辣醬味道就沒那麼糟了）",shape=box,color=blue];
		810 -> 813;
	812 [label="PapaPolar: 也許科腐燒烤並不是個好主意",shape=box,color=blue];
		812 -> 817;
	811 [label="PapaPolar: 我能喝贏亞瑟了，笑死",shape=box,color=blue];
		811 -> 814;
		811 -> 815;
		811 -> 816;
	813 [label="PapaPolar: 但是啊，可憐的亞瑟。真替那個不列坦小混蛋感到難過，哈哈",shape=box,color=blue];
		813 -> 818;
	817 [label="PapaPolar: 而且是從我嘴巴裡說出來的。我曾經在生鏽輪蓋上吃過已經過期三週的發臭馴鹿肉。（順便帶一題，加點辣醬味道就沒那麼糟了）",shape=box,color=blue];
		817 -> 821;
		817 -> 822;
	814 [label="你真的確定？",shape=box,color=red];
		814 -> 819;
	815 [label="是喔。",shape=box,color=red];
		815 -> 820;
	816 [label="你不是可以嗎？",shape=box,color=red];
		816 -> 819;
	818 [label="PapaPolar: 嘿，也許炸過會更好吃。所有炸過和插在竹籤上的東西都更好吃。",shape=box,color=blue];
		818 -> 823;
	821 [label="我不知道為什麼我總是上這種當……我真的不知道……",shape=box,color=red];
		821 -> 818;
	822 [label="我投降了。我只。我投降。",shape=box,color=red];
		822 -> 818;
	819 [label="PapaPolar: 哼，當然了，因為我坐在這裡打字，而他躺在酒吧地板上",shape=box,color=blue];
		819 -> 824;
	820 [label="PapaPolar: 笨笨的不列坦人想開始講戰爭故事，然後他想開始喝「一口烈酒」，然後",shape=box,color=blue];
		820 -> 825;
	823 [label="PapaPolar: 那又是另一種自由國美食，你知道嗎。把食物塞進其他食物裡油炸，通常塗上奶油，插在竹籤上",shape=box,color=blue];
		823 -> 826;
		823 -> 827;
	824 [label="PapaPolar: 所以我說我贏了",shape=box,color=blue];
		824 -> 820;
	825 [label="PapaPolar: 然後他開始變得感傷之類的",shape=box,color=blue];
		825 -> 828;
	826 [label="你請慢用。但我想我會蜷縮在黑暗的地方後悔我的決定。",shape=box,color=red];
		826 -> 829;
	827 [label="不。不。我不餓。我真的不餓。",shape=box,color=red];
		827 -> 830;
	828 [label="PapaPolar: 但他好渺小",shape=box,color=blue];
		828 -> 831;
	829 [label="PapaPolar: 這樣你才知道那是一場好的派對！",shape=box,color=blue];
		829 -> 832;
	830 [label="PapaPolar: 好吧，哈哈",shape=box,color=blue];
		830 -> 832;
	831 [label="PapaPolar: 看看他，他真得好渺小，哈哈哈哈",shape=box,color=blue];
		831 -> 833;
	832 [label="Check boolean FlareLizzieIntroComplete",color=orange];
		832 -> 835 [label=true,color=green];
		832 -> 834 [label=false,color=brown];
	833 [label="MomToxicated: 夠了，韋利米爾。我帶你上床睡一覺，醒一下酒。",shape=box,color=blue];
		833 -> 836;
	835 [label="PapaPolar: 至少我不需要擔心剩菜。莉慈似乎很喜歡……雖然我替弗烈爾感到難過，明早起床他肯定會很難受。",shape=box,color=blue];
		835 -> 838;
	834 [label="PapaPolar: 不知道我要怎麼處理所有這些剩菜。不想看到它對這附近的浣熊造成什麼影響。",shape=box,color=blue];
		834 -> 837;
	836 [label="PapaPolar: 哦，嗨，米娜瓦",shape=box,color=blue];
		836 -> 839;
	838 [label="PapaPolar: 源拓氏確實對那個進行了大改造。雖然聽起來，事情並沒有完全按照計劃進行。",shape=box,color=blue];
		838 -> 841;
	837 [label="PapaPolar: 這地方有浣熊嗎？",shape=box,color=blue];
		837 -> 840;
	839 [label="PapaPolar: 嘿，漂流者，我們有告訴過你我們結婚了嗎",shape=box,color=blue];
		839 -> 842;
		839 -> 843;
	841 [label="PapaPolar: 我聽到越多關於源拓氏的事情，總體來說，就越覺得他待米和我非常不薄。",shape=box,color=blue];
		841 -> 845;
		841 -> 846;
	840 [label="PapaPolar: ……這地方有野生動物嗎？",shape=box,color=blue];
