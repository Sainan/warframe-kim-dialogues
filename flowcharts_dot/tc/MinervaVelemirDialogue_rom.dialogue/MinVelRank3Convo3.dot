	842 [label="我猜到了。",shape=box,color=red];
		842 -> 847;
	843 [label="是的。我知道。",shape=box,color=red];
		843 -> 847;
	845 [label="是關於你們怎麼成為原型 Warframe 的事嗎？",shape=box,color=red];
		845 -> 850;
	846 [label="怎麼說？",shape=box,color=red];
		846 -> 851;
	844 [label="PapaPolar: 你認為那是源拓氏做的？還是科腐者？",shape=box,color=blue];
		844 -> 848;
		844 -> 849;
	847 [label="PapaPolar: ……是曾經結過婚，在我搞砸了這一切的更久之前",shape=box,color=blue];
		847 -> 852;
	850 [label="Update boolean VelimirEntrati",color=orange];
