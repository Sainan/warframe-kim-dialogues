		911 -> 914;
	912 [label="PapaPolar: 哼，當然了，因為我坐在這裡打字，而他躺在酒吧地板上",shape=box,color=blue];
		912 -> 915;
	913 [label="PapaPolar: 笨笨的不列坦人想開始講戰爭故事，然後他想開始喝「一口烈酒」，然後",shape=box,color=blue];
