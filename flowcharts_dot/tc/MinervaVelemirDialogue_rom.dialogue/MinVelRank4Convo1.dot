	940 [label="PapaPolar: 是嗎？",shape=box,color=blue];
		940 -> 943;
	941 [label="PapaPolar: 不，不。不是妳的錯。我們已經討論過這個話題很多次了，妳沒必要再經歷一次。",shape=box,color=blue];
		941 -> 944;
	942 [label="MomToxicated: 韋，我過去接你。現在你應該停止打字了。",shape=box,color=blue];
		942 -> 945;
	943 [label="PapaPolar: 抱歉。那是宿醉在亂講話。有時候，我想我只是希望妳依然會嘲笑我的滑稽行為。",shape=box,color=blue];
		943 -> 938;
	944 [label="PapaPolar: 我得出去散步，舒緩一下頭痛。或者吃點油膩食物。或者嘔吐。或全部三個都做。還沒決定做什麼或按什麼順序。",shape=box,color=blue];
