		927 -> 930;
	928 [label="PapaPolar: 嗯，我想一下 :-B",shape=box,color=blue];
		928 -> 931;
	929 [label="PapaPolar: 嘿，漂流者，我們有告訴過你我們結婚了嗎",shape=box,color=blue];
		929 -> 932;
		929 -> 933;
	930 [label="PapaPolar: 嘿，我們都玩得很開心。沒人受傷。那男孩有機會就該放鬆一下。",shape=box,color=blue];
		930 -> 934;
	931 [label="MomToxicated: 唉。韋利米爾，那已經是很久以前的事了。",shape=box,color=blue];
		931 -> 935;
	932 [label="我猜到了。",shape=box,color=red];
		932 -> 936;
	933 [label="是的。我知道。",shape=box,color=red];
		933 -> 936;
	934 [label="PapaPolar: 能和一個不會因為我而感到尷尬的人一起相處真好。",shape=box,color=blue];
		934 -> 937;
	935 [label="PapaPolar: 對我來說感覺沒那麼久遠。但我想這就是問題所在。",shape=box,color=blue];
		935 -> 938;
	936 [label="PapaPolar: ……是曾經結過婚，在我搞砸了這一切的更久之前",shape=box,color=blue];
		936 -> 939;
	937 [label="MomToxicated: 這話沒有必要。",shape=box,color=blue];
		937 -> 940;
	938 [label="MomToxicated: 韋。聽著，我……",shape=box,color=blue];
