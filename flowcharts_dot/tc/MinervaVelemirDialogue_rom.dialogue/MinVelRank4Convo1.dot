		916 -> 918;
	917 [label="MomToxicated: 對我們這些在可聽見範圍內的人來說不太棒。",shape=box,color=blue];
		917 -> 919;
	918 [label="PapaPolar: 但他好渺小",shape=box,color=blue];
		918 -> 920;
	919 [label="PapaPolar: 哦，拜託，免費的表演欸！如果我模糊的記憶沒記錯的話，那個不列坦小男孩表現得還不錯",shape=box,color=blue];
		919 -> 921;
	920 [label="PapaPolar: 看看他，他真得好渺小，哈哈哈哈",shape=box,color=blue];
		920 -> 922;
	921 [label="PapaPolar: 而且我有良好的權威可以證明我自己就有一副不錯的歌喉。",shape=box,color=blue];
		921 -> 923;
		921 -> 924;
		921 -> 925;
	922 [label="MomToxicated: 夠了，韋利米爾。我帶你上床睡一覺，醒一下酒。",shape=box,color=blue];
		922 -> 926;
	923 [label="我很慶幸我錯過了，我不知道我的耳膜能不能承受得了。",shape=box,color=red];
		923 -> 927;
	924 [label="哦，是嗎？誰告訴你的？",shape=box,color=red];
