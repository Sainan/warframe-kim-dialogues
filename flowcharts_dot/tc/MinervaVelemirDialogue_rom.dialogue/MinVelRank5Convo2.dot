		j740321725 -> j1180722454;
	j3807092672 [label="MomToxicated: 之前我們在光之城的時候，你跟外國代表團委員會說了這個笑話。",shape=box,color=blue];
		j3807092672 -> j571324564;
	j571324564 [label="PapaPolar: 哦對！哈哈哈。我完全忘了那次旅行。我還以為妳忙著在總理的酒裡下毒呢。",shape=box,color=blue];
		j571324564 -> j2358831311;
	j2358831311 [label="MomToxicated: 當時我很忙，但不代表我沒在聽。本來是你要幫我掩護的，結果我笑了出來，整件事差點穿幫。",shape=box,color=blue];
		j2358831311 -> j3960822361;
	j3960822361 [label="PapaPolar: 啊啊啊",shape=box,color=blue];
		j3960822361 -> j430981398;
	j430981398 [label="PapaPolar: 如果我沒記錯的話，我們之後還去那個地方品嚐了很讚的蝸牛料理，對吧？",shape=box,color=blue];
		j430981398 -> j2892590028;
	j2892590028 [label="MomToxicated: 對啊，那時俄人像群蜜蜂氣沖沖地出現，我們不得不趕緊閃人。",shape=box,color=blue];
		j2892590028 -> j4122295921;
	j4122295921 [label="MomToxicated: 根本來不及把酒喝完。",shape=box,color=blue];
		j4122295921 -> j2588791316;
	j2588791316 [label="PapaPolar: 嗯，喜歡挑戰命運極限的不列坦先生和他的朋友們釀造了一批新的私釀酒",shape=box,color=blue];
		j2588791316 -> j3432953880;
	j3432953880 [label="PapaPolar: 雖然不是那種價值是我一年薪水的紅酒，但是呢，想要繼續我們上次沒完成的事嗎？",shape=box,color=blue];
