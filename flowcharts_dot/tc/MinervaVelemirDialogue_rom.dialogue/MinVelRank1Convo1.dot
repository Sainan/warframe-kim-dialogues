digraph {
	0 [label="MinVelRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="MomToxicated: 她發生了什麼事？我需要答案。",shape=box,color=blue];
		1 -> 2;
	2 [label="MomToxicated: 真正的答案。而不是其他人給我的那種「很難解釋」的廢話。",shape=box,color=blue];
		2 -> 3;
		2 -> 4;
		2 -> 5;
		2 -> 6;
	3 [label="呵。",shape=box,color=red];
		3 -> 7;
	4 [label="嗨？",shape=box,color=red];
		4 -> 7;
	5 [label="額。",shape=box,color=red];
		5 -> 7;
	6 [label="妳哪位……？",shape=box,color=red];
		6 -> 7;
	7 [label="PapaPolar: 沒必要這樣。先從「嗨，你好嗎？」開頭。",shape=box,color=blue];
		7 -> 8;
	8 [label="PapaPolar: 抱歉了，夥計。當米女鎖定目標時，她就會全力追擊了。",shape=box,color=blue];
		8 -> 9;
	9 [label="MomToxicated: 我也不需要你來插嘴。",shape=box,color=blue];
		9 -> 10;
	10 [label="PapaPolar: 我沒有啊？",shape=box,color=blue];
		10 -> 11;
	11 [label="MomToxicated: 呵。是啊。沒錯。好像你在亞爾切斯科沒有插嘴一樣。",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="我猜這是米娜瓦和韋利米爾，對吧？",shape=box,color=red];
		12 -> 14;
	13 [label="好吧……我們能從頭說起嗎？到底發生什麼事？",shape=box,color=red];
		13 -> 15;
	14 [label="PapaPolar: 是的。抱歉。嗨。我可能是最容易猜到的那個，對吧？哈哈",shape=box,color=blue];
		14 -> 16;
	15 [label="PapaPolar: 哈！抱歉，夥計。我是韋利米爾。而這裡的「MomToxicated」是米娜瓦。",shape=box,color=blue];
		15 -> 17;
	16 [label="PapaPolar: 這裡的「MomToxicated」是米娜瓦。",shape=box,color=blue];
		16 -> 17;
	17 [label="MomToxicated: 韋利米爾，使用這個線人的意義是什麼，如果你只是──",shape=box,color=blue];
		17 -> 18;
	18 [label="MomToxicated: 該死。",shape=box,color=blue];
		18 -> 19;
	19 [label="PapaPolar: 米，冷靜點。運用排除法。我們這種怪咖在這個星系裡能有多少個？",shape=box,color=blue];
		19 -> 20;
		19 -> 21;
		19 -> 22;
	20 [label="我覺得隨著時間，只會越來越多。",shape=box,color=red];
		20 -> 23;
	21 [label="你們倆能先解決你們之間的問題，然後再來跟我談嗎？",shape=box,color=red];
		21 -> 24;
	22 [label="我真的好困惑。",shape=box,color=red];
		22 -> 25;
	23 [label="Update boolean VelimirFamily1",color=orange];
		23 -> 26;
	24 [label="PapaPolar: 恐怕你會等很久喔，夥計。哈。",shape=box,color=blue];
		24 -> 27;
	25 [label="PapaPolar: 嗯，如果你都感到困惑，那我們就都完蛋了。哈！",shape=box,color=blue];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="PapaPolar: 簡單來說就是。米在這裡有些問題她想知道答案，並且希望你能夠回答。",shape=box,color=blue];
		27 -> 30;
	28 [label="PapaPolar: 畢竟我們來這裡就是為了向你尋求答案。",shape=box,color=blue];
		28 -> 30;
	29 [label="PapaPolar: 我倒是希望如此！我想說越多越歡樂。就像那句老話，邪教和宗教之間的唯一區別就是人數，哈哈。",shape=box,color=blue];
		29 -> 31;
	30 [label="PapaPolar: 這樣，有好點嗎，米？這有更符合妳的「白臉／黑臉」策略嗎？",shape=box,color=blue];
		30 -> 32;
	31 [label="PapaPolar: 有這種俗語嗎？ ",shape=box,color=blue];
		31 -> 33;
	32 [label="MomToxicated: 日尊在上，我快要抓狂了……",shape=box,color=blue];
		32 -> 34;
		32 -> 35;
		32 -> 36;
	33 [label="PapaPolar: 我不知道。你懂我的意思。對我來說，水很棒，大家都跳進來！好吧，總之迴歸正題。",shape=box,color=blue];
		33 -> 27;
	34 [label="為什麼我感覺自己好像被審問？",shape=box,color=red];
		34 -> 37;
	35 [label="好吧。呃。我會希望妳在跟我對話的同時，別在那邊耍什麼把戲。",shape=box,color=red];
		35 -> 38;
	36 [label="妳有什麼問題？如果我能幫的話我會盡量幫。",shape=box,color=red];
		36 -> 39;
	37 [label="MomToxicated: 住嘴，韋利米爾。",shape=box,color=blue];
		37 -> 40;
	38 [label="MomToxicated: 這根本不是什麼把戲。",shape=box,color=blue];
		38 -> 41;
	39 [label="MomToxicated: 已經留意到你願意配合，「漂泊者」。",shape=box,color=blue];
		39 -> 42;
	40 [label="PapaPolar: :-X",shape=box,color=blue];
		40 -> 43;
	41 [label="MomToxicated: 你會回答我的問題嗎？會或不會？",shape=box,color=blue];
		41 -> 44;
		41 -> 45;
	42 [label="MomToxicated: 如果那是你的真名的話。",shape=box,color=blue];
		42 -> 46;
	43 [label="MomToxicated: 好像在應付──算了。算了。沒關係。",shape=box,color=blue];
		43 -> 41;
	44 [label="不，抱歉。女士，我不喜歡妳的態度。",shape=box,color=red];
		44 -> 47;
	45 [label="好的，沒問題。想知道什麼？",shape=box,color=red];
		45 -> 39;
	46 [label="PapaPolar: （我認為我們沒資格評判。）",shape=box,color=blue];
		46 -> 48;
	47 [label="MomToxicated: 這是個錯誤。我給你一點時間仔細想過並重新考慮。",shape=box,color=blue];
		47 -> 49;
	48 [label="MomToxicated: 韋利米爾",shape=box,color=blue];
