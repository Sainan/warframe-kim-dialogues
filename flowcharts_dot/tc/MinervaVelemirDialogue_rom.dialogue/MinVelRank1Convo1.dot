		j2591346778 -> j2281989038;
	j2281989038 [label="MomToxicated: 韋利米爾，使用這個線人的意義是什麼，如果你只是──",shape=box,color=blue];
		j2281989038 -> j180771411;
	j180771411 [label="MomToxicated: 該死。",shape=box,color=blue];
		j180771411 -> j2114281075;
