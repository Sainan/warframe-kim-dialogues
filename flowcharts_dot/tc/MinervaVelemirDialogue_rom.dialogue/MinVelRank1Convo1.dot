		j3924021679 -> j897805240;
	j1013157056 [label="PapaPolar: 是的。抱歉。嗨。我可能是最容易猜到的那個，對吧？哈哈",shape=box,color=blue];
		j1013157056 -> j2591346778;
	j897805240 [label="PapaPolar: 哈！抱歉，夥計。我是韋利米爾。而這裡的「MomToxicated」是米娜瓦。",shape=box,color=blue];
		j897805240 -> j2281989038;
