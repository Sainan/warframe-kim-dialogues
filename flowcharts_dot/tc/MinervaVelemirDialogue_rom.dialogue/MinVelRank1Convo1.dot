		j1791671709 -> j62562102;
		j1791671709 -> j125140726;
	j1521089352 [label="PapaPolar: 我不知道。你懂我的意思。對我來說，水很棒，大家都跳進來！好吧，總之迴歸正題。",shape=box,color=blue];
