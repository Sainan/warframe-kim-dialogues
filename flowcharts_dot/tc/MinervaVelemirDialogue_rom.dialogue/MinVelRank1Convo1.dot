		j3460387412 -> j2282240578;
	j1771825431 [label="PapaPolar: 我倒是希望如此！我想說越多越歡樂。就像那句老話，邪教和宗教之間的唯一區別就是人數，哈哈。",shape=box,color=blue];
		j1771825431 -> j1906390296;
