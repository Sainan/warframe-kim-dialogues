		246 -> 247;
		246 -> 248;
	247 [label="她說什麼……？",shape=box,color=red];
		247 -> 249;
	248 [label="猜那是粗話。",shape=box,color=red];
		248 -> 250;
	249 [label="PapaPolar: 這就是多次派駐海外行動的樂趣。被用一百種不同語言咒罵",shape=box,color=blue];
		249 -> 251;
		249 -> 252;
	250 [label="PapaPolar: 是的。這就是多次派駐海外行動的樂趣。被用一百種不同語言咒罵",shape=box,color=blue];
		250 -> 251;
