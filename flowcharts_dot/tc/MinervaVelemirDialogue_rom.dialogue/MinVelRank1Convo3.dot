		j1823720778 -> j1339164677;
	j1339164677 [label="MomToxicated: 你不用為了幫我而幫我。我們有個共同敵人。這個「牆中人」。",shape=box,color=blue];
		j1339164677 -> j2591126575;
	j2591126575 [label="MomToxicated: 據我所知，我們都想知道他去了哪裡、追尋什麼，還有為什麼他一開始就盯上露莎卡。",shape=box,color=blue];
		j2591126575 -> j1772185625;
