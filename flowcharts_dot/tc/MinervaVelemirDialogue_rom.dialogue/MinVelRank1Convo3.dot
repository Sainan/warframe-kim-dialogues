	254 [label="Update boolean MinervaNeci3a",color=orange];
		254 -> 256;
	255 [label="PapaPolar: 唔。算是吧。現在已經不再是了。只停留在書面上。在某個國家的某個地方。自大約 1982 年就不存在的國家。",shape=box,color=blue];
		255 -> 257;
	256 [label="PapaPolar: 可以這麼說。我們當時派駐在海外，在南部離這裡好幾個國家的一個小鎮上。那地方被炸得粉碎。在一棟建築裡發現了她，一頭紅髮，非常憤怒。",shape=box,color=blue];
		256 -> 258;
	257 [label="PapaPolar: 這樣還算數嗎？",shape=box,color=blue];
		257 -> 259;
		257 -> 260;
	258 [label="PapaPolar: 她試圖用湯匙刺我六次，哈哈哈哈，是你見過的最可愛的小東西了。",shape=box,color=blue];
		258 -> 261;
	259 [label="是啊，看起來你倆已經沒有在一起了。",shape=box,color=red];
		259 -> 262;
	260 [label="我想這就解釋了你們爭吵的原因。",shape=box,color=red];
		260 -> 263;
	261 [label="PapaPolar: 她緊緊抱著一個小兔子絨毛玩具。米告訴她會用生命保護它並確保它的安全。",shape=box,color=blue];
		261 -> 264;
	262 [label="PapaPolar: 是什麼露了餡？",shape=box,color=blue];
		262 -> 263;
	263 [label="PapaPolar: 當妮熙離開去加入清剿隊時……我們之間的關係就不再一樣了。我想，那是壓死駱駝的最後一根稻草。",shape=box,color=blue];
		263 -> 265;
	264 [label="PapaPolar: 這樣很快就贏得了妮熙的信任。她直接跑向米身邊並張開雙臂抱住她。之後我們就退出了軍隊。嗯，正式地，成為了「顧問」。",shape=box,color=blue];
		264 -> 266;
	265 [label="PapaPolar: 唉。",shape=box,color=blue];
		265 -> 267;
	266 [label="PapaPolar: 所以……是的。你可以說是我們撫養了她。",shape=box,color=blue];
		266 -> 267;
