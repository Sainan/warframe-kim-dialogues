		183 -> 186;
	184 [label="嗯？",shape=box,color=red];
		184 -> 187;
	185 [label="+5 Chemistry",color=orange];
		185 -> 188;
	186 [label="MomToxicated: 有人對我所謂待人處事的態度進行了說教。",shape=box,color=blue];
		186 -> 189;
	187 [label="+5 Chemistry",color=orange];
		187 -> 190;
	188 [label="MomToxicated: 信不信由你，但那確實是。",shape=box,color=blue];
		188 -> 191;
	189 [label="MomToxicated: 綜觀來說，實在失禮。",shape=box,color=blue];
		189 -> 192;
	190 [label="MomToxicated: 直奔主題。很好。",shape=box,color=blue];
		190 -> 192;
	191 [label="MomToxicated: 但那不是重點。",shape=box,color=blue];
		191 -> 192;
	192 [label="MomToxicated: 我們來到霍爾瓦尼亞有個問題需要解決。而你能幫我解決那個問題。",shape=box,color=blue];
		192 -> 193;
	193 [label="MomToxicated: 所以我需要你──而這是我在請求你──來幫助我。",shape=box,color=blue];
		193 -> 194;
		193 -> 195;
		193 -> 196;
	194 [label="我應該解決的是什麼問題？",shape=box,color=red];
		194 -> 197;
	195 [label="我為什麼要幫妳？",shape=box,color=red];
		195 -> 197;
	196 [label="而這和露莎卡有什麼關係？",shape=box,color=red];
		196 -> 197;
	197 [label="MomToxicated: 那是個非常好的問題。",shape=box,color=blue];
		197 -> 198;
	198 [label="MomToxicated: 你不用為了幫我而幫我。我們有個共同敵人。這個「牆中人」。",shape=box,color=blue];
		198 -> 199;
	199 [label="MomToxicated: 據我所知，我們都想知道他去了哪裡、追尋什麼，還有為什麼他一開始就盯上露莎卡。",shape=box,color=blue];
		199 -> 200;
	200 [label="MomToxicated: 我這樣評估正確嗎？",shape=box,color=blue];
		200 -> 201;
		200 -> 202;
		200 -> 203;
	201 [label="妳可不可以先倒退回去，花個一分鐘來向我解釋為什麼妳這麼在乎露莎卡嗎？",shape=box,color=red];
		201 -> 204;
	202 [label="對於前兩點，是的。我其實並不真的在乎他為什麼會找露莎卡。",shape=box,color=red];
		202 -> 205;
	203 [label="當然。是的。那是正確的。",shape=box,color=red];
		203 -> 206;
	204 [label="MomToxicated: 原因並不重要。",shape=box,color=blue];
		204 -> 207;
	205 [label="MomToxicated: 如果你一點都不關心她的安危的話，那你為什麼要像我們知道的那樣饒了她的性命？我們已經聽說過了。",shape=box,color=blue];
		205 -> 208;
		205 -> 209;
		205 -> 210;
	206 [label="我不得不告訴妳，但牆中人採取他的下一步行動之前，我們大概只能等了。",shape=box,color=red];
		206 -> 211;
	207 [label="PapaPolar: 但它確實重要。而且反正他們大概已經發現了。畢竟我們並沒有很低調",shape=box,color=blue];
		207 -> 212;
	208 [label="因為那樣我就和漠然、清剿隊、或源拓氏沒什麼兩樣了。我不會到處毫無意義地殺人。",shape=box,color=red];
		208 -> 213;
	209 [label="因為做出那些選擇並讓她走到這步境地的並不是真正的她。就因為我當下不會為了這些事而殺她，並不代表我夠關心她，願意不惜一切去救她。",shape=box,color=red];
		209 -> 214;
	210 [label="因為我沒有打算替源拓氏做他的骯髒勾當。如果他想殺掉漠然的新傀儡，他可以親自動手。",shape=box,color=red];
		210 -> 215;
	211 [label="MomToxicated: 而這是為什麼？你沒有辦法追蹤他嗎？它？不管它是什麼？還是你不知道它真正的目的是什麼？",shape=box,color=blue];
		211 -> 216;
		211 -> 217;
	212 [label="PapaPolar: 而且也許，就只是也許，如果妳信任我們這個新的小夥伴並和他分享一點訊息，搞不好他們會更願意幫助我們",shape=box,color=blue];
		212 -> 218;
	213 [label="這意味著我會故意殺人。我不會這樣。我的意思是。我確實會殺人。但那不一樣。妳知道我的意思。",shape=box,color=red];
		213 -> 219;
	214 [label="我並不認識她。",shape=box,color=red];
		214 -> 220;
	215 [label="但就像我所猜想的，那個老混蛋只喜歡射殺那些他知道會重新活過來的人。",shape=box,color=red];
		215 -> 221;
	216 [label="不行，沒辦法在一個神或半神的實體貼上追蹤信標。",shape=box,color=red];
		216 -> 222;
	217 [label="是的，目前對我們來說他的動機不明。但肯定不是什麼好事。",shape=box,color=red];
		217 -> 222;
	218 [label="PapaPolar: 有時候人們差不多就是這樣運作的。",shape=box,color=blue];
		218 -> 223;
	219 [label="+5 Chemistry",color=orange];
		219 -> 224;
	220 [label="PapaPolar: 我們也並沒有給你一個理由去關心。不是嗎，米？",shape=box,color=blue];
		220 -> 225;
	221 [label="PapaPolar: 一個非常奇怪的具體陳述，但好吧",shape=box,color=blue];
		221 -> 226;
		221 -> 227;
	222 [label="MomToxicated: 所以你是建議我們坐著。等著。等它……怎麼？探出頭來嗎？然後我們再來玩一輪打鼬鼠遊戲？！",shape=box,color=blue];
		222 -> 228;
	223 [label="MomToxicated: 這樣做有什麼好處？",shape=box,color=blue];
		223 -> 229;
	224 [label="PapaPolar: 你正在和一對前軍事特種部隊的士兵交談，我們懂。哈哈",shape=box,color=blue];
		224 -> 230;
	225 [label="MomToxicated: 閉嘴，韋利米爾。",shape=box,color=blue];
		225 -> 204;
	226 [label="沒關係。我死過很多次。我已經習慣了。",shape=box,color=red];
		226 -> 231;
	227 [label="這並不重要。",shape=box,color=red];
		227 -> 206;
		227 -> 232;
	228 [label="PapaPolar: 至少這個地方有好的夥伴和不錯的酒吧？",shape=box,color=blue];
		228 -> 233;
	229 [label="PapaPolar: 米，在這個世界上多交朋友不會有壞處。",shape=box,color=blue];
		229 -> 234;
	230 [label="PapaPolar: 有時候，為了「大局」我們必須做的事情會變得模糊不清",shape=box,color=blue];
		230 -> 235;
	231 [label="PapaPolar: 好吧好吧……當然，小夥伴……當然……",shape=box,color=blue];
		231 -> 236;
	232 [label="為什麼你這麼想知道露莎卡到底發生了什麼事？",shape=box,color=red];
		232 -> 204;
	233 [label="PapaPolar: 音樂挺棒的。那個叫亞瑟的傢伙看起來像是我的酒友類型",shape=box,color=blue];
		233 -> 237;
	234 [label="MomToxicated: 我們需要「朋友」幹嘛？！一旦我們知道要去哪裡救妮熙，我們馬上就會離開這裡了。",shape=box,color=blue];
		234 -> 238;
	235 [label="PapaPolar: 這就是為什麼，當我們能做些有意義的事情的時候，我們就會去做。這就是為什麼我們在這裡想辦法救妮熙",shape=box,color=blue];
		235 -> 206;
		235 -> 232;
	236 [label="PapaPolar: 不管怎樣……",shape=box,color=blue];
		236 -> 206;
		236 -> 232;
	237 [label="MomToxicated: 然後呢，怎麼樣，我們就這樣繼續過日子不知道她到底發生了什麼事？！或者她是不是平安無事？！或者她還是不是真的她？！",shape=box,color=blue];
		237 -> 239;
	238 [label="PapaPolar: 不知道欸。似乎很難預料這個半神虛空怪物……東西的動向。我說得對吧，小夥伴？",shape=box,color=blue];
		238 -> 217;
		238 -> 216;
	239 [label="MomToxicated: 韋利米爾，你怎麼能坐在那裡對這事不以為意？！",shape=box,color=blue];
		239 -> 240;
	240 [label="PapaPolar: 米，我從沒說過我接受這種結果！我只是明白我們什麼時候該坐下來耐心等待時機！",shape=box,color=blue];
		240 -> 241;
	241 [label="MomToxicated: 我和愛琳娜談過了。她告訴了我當她感應妮熙的心靈，或是其殘存部分時的感受。",shape=box,color=blue];
		241 -> 242;
	242 [label="MomToxicated: 我們撫養長大的女人。我們視如己出的女人。",shape=box,color=blue];
		242 -> 243;
	243 [label="MomToxicated: 誰知道她到底發──",shape=box,color=blue];
		243 -> 244;
	244 [label="MomToxicated: 而你卻只想談論與亞瑟喝的事。",shape=box,color=blue];
		244 -> 245;
	245 [label="MomToxicated: （羅馬尼亞語）去你的，韋利米爾。",shape=box,color=blue];
		245 -> 246;
