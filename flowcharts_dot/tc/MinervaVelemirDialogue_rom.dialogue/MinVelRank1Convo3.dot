digraph {
	179 [label="MinVelRank1Convo3 begins.",color=orange];
		179 -> 180;
	180 [label="MomToxicated: 漂泊者。我們可以談談嗎？",shape=box,color=blue];
		180 -> 181;
		180 -> 182;
		180 -> 183;
		180 -> 184;
	181 [label="早安，米娜瓦。如果那是妳的真名的話。",shape=box,color=red];
		181 -> 185;
	182 [label="我看我們已經去掉那些「引號」了。",shape=box,color=red];
		182 -> 186;
