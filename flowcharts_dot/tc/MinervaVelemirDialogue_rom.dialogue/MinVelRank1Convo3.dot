		j1772185625 -> j3501075586;
		j1772185625 -> j492557193;
	j2436752327 [label="妳可不可以先倒退回去，花個一分鐘來向我解釋為什麼妳這麼在乎露莎卡嗎？",shape=box,color=red];
		j2436752327 -> j3810063928;
	j3501075586 [label="對於前兩點，是的。我其實並不真的在乎他為什麼會找露莎卡。",shape=box,color=red];
