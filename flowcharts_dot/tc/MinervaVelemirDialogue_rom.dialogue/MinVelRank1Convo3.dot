		j1618790614 -> j2425605201;
	j3153535505 [label="我不得不告訴妳，但牆中人採取他的下一步行動之前，我們大概只能等了。",shape=box,color=red];
		j3153535505 -> j81702152;
	j983293639 [label="PapaPolar: 但它確實重要。而且反正他們大概已經發現了。畢竟我們並沒有很低調",shape=box,color=blue];
		j983293639 -> j1298707308;
	j1138184843 [label="因為那樣我就和漠然、清剿隊、或源拓氏沒什麼兩樣了。我不會到處毫無意義地殺人。",shape=box,color=red];
		j1138184843 -> j603681636;
	j45120361 [label="因為做出那些選擇並讓她走到這步境地的並不是真正的她。就因為我當下不會為了這些事而殺她，並不代表我夠關心她，願意不惜一切去救她。",shape=box,color=red];
		j45120361 -> j3637259076;
	j2425605201 [label="因為我沒有打算替源拓氏做他的骯髒勾當。如果他想殺掉漠然的新傀儡，他可以親自動手。",shape=box,color=red];
		j2425605201 -> j2236137316;
	j81702152 [label="MomToxicated: 而這是為什麼？你沒有辦法追蹤他嗎？它？不管它是什麼？還是你不知道它真正的目的是什麼？",shape=box,color=blue];
		j81702152 -> j4081737104;
		j81702152 -> j3773142058;
	j1298707308 [label="PapaPolar: 而且也許，就只是也許，如果妳信任我們這個新的小夥伴並和他分享一點訊息，搞不好他們會更願意幫助我們",shape=box,color=blue];
		j1298707308 -> j2756078397;
	j603681636 [label="這意味著我會故意殺人。我不會這樣。我的意思是。我確實會殺人。但那不一樣。妳知道我的意思。",shape=box,color=red];
		j603681636 -> j4181084486;
	j3637259076 [label="我並不認識她。",shape=box,color=red];
		j3637259076 -> j493730943;
