		1695 -> 1698;
	1696 [label="PapaPolar: 所以他們在放置攝影設備的時候時非常的小心。 ",shape=box,color=blue];
		1696 -> 1699;
	1697 [label="PapaPolar: 無論我做什麼事，我爸從來沒同意過。我不想這樣對待她，我想讓她自己做選擇。",shape=box,color=blue];
