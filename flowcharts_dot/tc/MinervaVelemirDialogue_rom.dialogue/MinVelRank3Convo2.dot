		719 -> 722;
	720 [label="PapaPolar: 這就是軍人之歌。我從這群快樂的小怪胎團隊的其他成員那裡所收集到的情資來看，你和我們一樣被捲入了源拓氏製造的混亂。",shape=box,color=blue];
		720 -> 723;
	721 [label="PapaPolar: 哈哈，聽起來是這樣，如果我從我們這群快樂的小怪胎團隊聽到的瘋狂故事有一半是真實的話。",shape=box,color=blue];
		721 -> 724;
