		737 -> 742;
	738 [label="PapaPolar: 給你做些真正的自由國燒烤，讓你品嘗一下什麼才叫做真正的食物。……不知道我們要去哪裡弄頭牛來做牛胸肉，但我們到時候再想辦法，笑死",shape=box,color=blue];
		738 -> 743;
	739 [label="PapaPolar: 我在 1998 年初來到這個混亂的境地，所以比你來得早。妮熙拒絕見我們。我們甚至根本無法接近她",shape=box,color=blue];
		739 -> 744;
