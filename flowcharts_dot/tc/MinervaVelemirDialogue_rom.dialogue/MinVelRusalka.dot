	1888 [label="MomToxicated: 我同意。壞消息總是優先。",shape=box,color=blue];
		1888 -> 1892;
	1887 [label="MomToxicated: 人生大小事本是如此。但還是謝謝你的提醒。",shape=box,color=blue];
		1887 -> 1889;
	1892 [label="所以。漠然去了渡域。而它……把妮熙一起帶到那裡了。",shape=box,color=red];
		1892 -> 1893;
	1889 [label="+5 Chemistry",color=orange];
		1889 -> 1890;
	1893 [label="PapaPolar: 等等。等一下。故事書次元那裡？",shape=box,color=blue];
		1893 -> 1894;
	1890 [label="PapaPolar: 做好心理建設了，但至少這聽起來她……似乎沒死，對吧？",shape=box,color=blue];
		1890 -> 1891;
	1894 [label="MomToxicated: 就是那個一直反覆殺你的獨裁小孩那裡？",shape=box,color=blue];
		1894 -> 1895;
		1894 -> 1896;
	1891 [label="我不……確定。我不這麼認為。但讓我告訴你們我所知道的，然後你倆再自行定奪。",shape=box,color=red];
		1891 -> 1892;
	1895 [label="結果這對他來說是個成長的過程。但這不是重點。反正──",shape=box,color=red];
		1895 -> 1897;
	1896 [label="就是那個。",shape=box,color=red];
		1896 -> 1897;
	1897 [label="妮熙……篡奪了王位。漠然的「軍隊」，暫且就這麼形容，喃喃者，入侵了，而她掌權了。",shape=box,color=red];
		1897 -> 1898;
