		1910 -> 1912;
	1911 [label="PapaPolar: 「在空曠的十字路口，尋找日蝕」。",shape=box,color=blue];
		1911 -> 1914;
	1912 [label="+5 Chemistry",color=orange];
		1912 -> 1915;
	1914 [label="PapaPolar: 如果你有再見到們的小女孩，這是我讓你轉告她的話。",shape=box,color=blue];
		1914 -> 1913;
	1915 [label="PapaPolar: 沒錯……",shape=box,color=blue];
		1915 -> 1916;
	1913 [label="PapaPolar: 這是我們之間設的通關密語的另一半。每次通話開始前我們都會透過它來確認我們在使用安全線路，確認一切都安全",shape=box,color=blue];
		1913 -> 1917;
	1916 [label="PapaPolar: 我們之間有設通關密語。每次通話開始前我們都會透過它來確認我們在使用安全線路，確認一切都安全",shape=box,color=blue];
		1916 -> 1917;
	1917 [label="MomToxicated: 驗明我們彼此的真實……身份。",shape=box,color=blue];
		1917 -> 1918;
