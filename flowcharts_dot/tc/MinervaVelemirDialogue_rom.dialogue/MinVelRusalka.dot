	1926 [label="PapaPolar: 但這虛假嗎？這有很痛苦嗎？",shape=box,color=blue];
		1926 -> 1927;
	1927 [label="PapaPolar: 還是某方面來說它讓我們感到慰藉，知道我們的小女孩在外面某個地方仍然還活著？",shape=box,color=blue];
		1927 -> 1928;
	1928 [label="PapaPolar: 儘管面對重重困難，她仍然在大戰四方敗敵無數？",shape=box,color=blue];
