	1900 [label="我不知道。",shape=box,color=red];
		1900 -> 1902;
	1901 [label="這就是我想和你們談的事。",shape=box,color=red];
		1901 -> 1902;
	1902 [label="我找到這些記錄。它們一開始很零散。但當我把它們全部拼湊在一起時，我……得到了這則訊息。",shape=box,color=red];
		1902 -> 1903;
	1903 [label="我很好奇你們是否能解讀它。",shape=box,color=red];
		1903 -> 1904;
	1904 [label="MomToxicated: 是謎語和奇怪的訊息嗎？你用對語言跟我們對話了。",shape=box,color=blue];
		1904 -> 1905;
	1905 [label="PapaPolar: 1-800-間諜-事務，你來對地方了",shape=box,color=blue];
		1905 -> 1906;
	1906 [label="「當太陽與太陰連成一線時，迷失者將找到回家的路」。",shape=box,color=red];
		1906 -> 1907;
	1907 [label="PapaPolar: ……糟糕。米。完了。",shape=box,color=blue];
		1907 -> 1908;
	1908 [label="MomToxicated: 別上當。如果那東西佔據了她的頭腦，它就會知道她所知道的一切。",shape=box,color=blue];
		1908 -> 1909;
		1908 -> 1910;
	1909 [label="什麼？這是什麼意思？",shape=box,color=red];
