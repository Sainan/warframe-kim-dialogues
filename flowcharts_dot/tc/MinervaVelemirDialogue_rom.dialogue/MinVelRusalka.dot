	j637336707 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:CheckDuviriMitwCollectibles",color=orange];
		j637336707 -> j1712909408 [label=true,color=green];
		j637336707 -> "Chat ends." [label=false,color=brown];
	"Chat ends." [color=orange];
	j1712909408 [label="嘿……伙計們？",shape=box,color=red];
		j1712909408 -> j2707991347;
	j2707991347 [label="MomToxicated: 什麼事？",shape=box,color=blue];
		j2707991347 -> j20663787;
	j20663787 [label="PapaPolar: 小夥伴，怎麼了？",shape=box,color=blue];
		j20663787 -> j847521363;
		j20663787 -> j1234229088;
		j20663787 -> j855346844;
	j847521363 [label="我有好消息也有壞消息。是關於妮熙的。",shape=box,color=red];
		j847521363 -> j218795696;
	j1234229088 [label="我需要你倆別期望太高。我有關於妮熙的消息，但它……好壞參半。並且還沒辦法定論。",shape=box,color=red];
		j1234229088 -> j3374281599;
	j855346844 [label="呃……老實說，還是算了。[結束]",shape=box,color=red];
		j855346844 -> "Chat ends.";
	j218795696 [label="PapaPolar: 用成年人的方式。壞消息先說。",shape=box,color=blue];
		j218795696 -> j3110921946;
	j3374281599 [label="+5 Chemistry",color=orange];
		j3374281599 -> j2270301572;
	j3110921946 [label="MomToxicated: 我同意。壞消息總是優先。",shape=box,color=blue];
		j3110921946 -> j2049000543;
	j2270301572 [label="MomToxicated: 人生大小事本是如此。但還是謝謝你的提醒。",shape=box,color=blue];
		j2270301572 -> j1918345538;
	j2049000543 [label="所以。漠然去了渡域。而它……把妮熙一起帶到那裡了。",shape=box,color=red];
		j2049000543 -> j980704511;
	j1918345538 [label="+5 Chemistry",color=orange];
		j1918345538 -> j2306062810;
	j980704511 [label="PapaPolar: 等等。等一下。故事書次元那裡？",shape=box,color=blue];
		j980704511 -> j1282624949;
	j2306062810 [label="PapaPolar: 做好心理建設了，但至少這聽起來她……似乎沒死，對吧？",shape=box,color=blue];
		j2306062810 -> j2944482183;
	j1282624949 [label="MomToxicated: 就是那個一直反覆殺你的獨裁小孩那裡？",shape=box,color=blue];
		j1282624949 -> j1558458751;
		j1282624949 -> j3871912650;
	j2944482183 [label="我不……確定。我不這麼認為。但讓我告訴你們我所知道的，然後你倆再自行定奪。",shape=box,color=red];
		j2944482183 -> j2049000543;
	j1558458751 [label="結果這對他來說是個成長的過程。但這不是重點。反正──",shape=box,color=red];
		j1558458751 -> j1154647994;
	j3871912650 [label="就是那個。",shape=box,color=red];
		j3871912650 -> j1154647994;
	j1154647994 [label="妮熙……篡奪了王位。漠然的「軍隊」，暫且就這麼形容，喃喃者，入侵了，而她掌權了。",shape=box,color=red];
		j1154647994 -> j1905361995;
	j1905361995 [label="MomToxicated: 呵。那才是我的小女孩。",shape=box,color=blue];
		j1905361995 -> j4012837484;
	j4012837484 [label="PapaPolar: 但那真的是她嗎？還是那個東西在冒充她？",shape=box,color=blue];
		j4012837484 -> j1141188527;
		j4012837484 -> j3799515981;
	j1141188527 [label="我不知道。",shape=box,color=red];
		j1141188527 -> j2491354646;
	j3799515981 [label="這就是我想和你們談的事。",shape=box,color=red];
		j3799515981 -> j2491354646;
	j2491354646 [label="我找到這些記錄。它們一開始很零散。但當我把它們全部拼湊在一起時，我……得到了這則訊息。",shape=box,color=red];
		j2491354646 -> j2171365702;
	j2171365702 [label="我很好奇你們是否能解讀它。",shape=box,color=red];
		j2171365702 -> j1626392331;
	j1626392331 [label="MomToxicated: 是謎語和奇怪的訊息嗎？你用對語言跟我們對話了。",shape=box,color=blue];
		j1626392331 -> j1540641324;
	j1540641324 [label="PapaPolar: 1-800-間諜-事務，你來對地方了",shape=box,color=blue];
		j1540641324 -> j1671643977;
	j1671643977 [label="「當太陽與太陰連成一線時，迷失者將找到回家的路」。",shape=box,color=red];
		j1671643977 -> j1801295389;
	j1801295389 [label="PapaPolar: ……糟糕。米。完了。",shape=box,color=blue];
		j1801295389 -> j3123909367;
	j3123909367 [label="MomToxicated: 別上當。如果那東西佔據了她的頭腦，它就會知道她所知道的一切。",shape=box,color=blue];
		j3123909367 -> j1522810758;
		j3123909367 -> j3200571177;
	j1522810758 [label="什麼？這是什麼意思？",shape=box,color=red];
		j1522810758 -> j4212245994;
	j3200571177 [label="那是密語的另一段，對嗎？",shape=box,color=red];
		j3200571177 -> j2705301183;
	j4212245994 [label="PapaPolar: 「在空曠的十字路口，尋找日蝕」。",shape=box,color=blue];
		j4212245994 -> j4204207024;
	j2705301183 [label="+5 Chemistry",color=orange];
		j2705301183 -> j1929703721;
	j4204207024 [label="PapaPolar: 如果你有再見到們的小女孩，這是我讓你轉告她的話。",shape=box,color=blue];
		j4204207024 -> j1358105905;
	j1929703721 [label="PapaPolar: 沒錯……",shape=box,color=blue];
		j1929703721 -> j227423131;
	j1358105905 [label="PapaPolar: 這是我們之間設的通關密語的另一半。每次通話開始前我們都會透過它來確認我們在使用安全線路，確認一切都安全",shape=box,color=blue];
		j1358105905 -> j4149376783;
	j227423131 [label="PapaPolar: 我們之間有設通關密語。每次通話開始前我們都會透過它來確認我們在使用安全線路，確認一切都安全",shape=box,color=blue];
		j227423131 -> j4149376783;
	j4149376783 [label="MomToxicated: 驗明我們彼此的真實……身份。",shape=box,color=blue];
		j4149376783 -> j4277493612;
	j4277493612 [label="PapaPolar: 「在空曠的十字路口，尋找日蝕」，我們是使用這段密語部分。",shape=box,color=blue];
		j4277493612 -> j2538566017;
	j2538566017 [label="MomToxicated: 「當太陽與太陰連成一線時，迷失者將找到回家的路」是對應的另一部分。",shape=box,color=blue];
		j2538566017 -> j3276369207;
	j3276369207 [label="MomToxicated: 這是她使用的那段。",shape=box,color=blue];
		j3276369207 -> j792187959;
		j3276369207 -> j3846167472;
	j792187959 [label="米娜瓦，但就像妳說的，我們不能確定那就是她。漠然知道她所知道的一切。",shape=box,color=red];
		j792187959 -> j1357999697;
	j3846167472 [label="我不知道漠然為什麼要告訴你們這些……",shape=box,color=red];
		j3846167472 -> j2718268431;
	j1357999697 [label="MomToxicated: 但為什麼那東西會想讓我們覺得有希望呢？除非它只是想傷害我們。",shape=box,color=blue];
		j1357999697 -> j3484432111;
	j2718268431 [label="MomToxicated: 或許想透過虛假的希望來對我們造成痛苦？",shape=box,color=blue];
		j2718268431 -> j1121540046;
	j3484432111 [label="PapaPolar: 這有很痛苦嗎？",shape=box,color=blue];
		j3484432111 -> j2100610307;
	j1121540046 [label="PapaPolar: 但這虛假嗎？這有很痛苦嗎？",shape=box,color=blue];
		j1121540046 -> j2100610307;
	j2100610307 [label="PapaPolar: 還是某方面來說它讓我們感到慰藉，知道我們的小女孩在外面某個地方仍然還活著？",shape=box,color=blue];
		j2100610307 -> j1088988043;
	j1088988043 [label="PapaPolar: 儘管面對重重困難，她仍然在大戰四方敗敵無數？",shape=box,color=blue];
		j1088988043 -> j2350598935;
	j2350598935 [label="PapaPolar: 即使我們不在她身邊？",shape=box,color=blue];
		j2350598935 -> j1392001644;
	j1392001644 [label="PapaPolar: 我不知道你是怎麼想的，但這簡直暖了我這顆大笨心。",shape=box,color=blue];
		j1392001644 -> j1693858935;
	j1693858935 [label="PapaPolar: 而我覺得這不是那所謂的漠然有辦法做到的事",shape=box,color=blue];
		j1693858935 -> j3161263650;
	j3161263650 [label="MomToxicated: 你說得非常對。聽到那段密語，想到她甚至有可能還在外頭，一點都不痛苦。",shape=box,color=blue];
		j3161263650 -> j4222545803;
	j4222545803 [label="MomToxicated: 我為她感到驕傲。",shape=box,color=blue];
		j4222545803 -> j3092323932;
		j4222545803 -> j789940309;
		j4222545803 -> j1213832048;
	j3092323932 [label="即使她仍被漠然挾持著？",shape=box,color=red];
		j3092323932 -> j469258460;
	j789940309 [label="即使這是漠然的詭計？",shape=box,color=red];
		j789940309 -> j1483555814;
	j1213832048 [label="她有可能心甘情願地與漠然合作。",shape=box,color=red];
		j1213832048 -> j3960070091;
	j469258460 [label="PapaPolar: 她就像拿來固定巨大鈦板金用的框架釘一樣強悍",shape=box,color=blue];
		j469258460 -> j4043281921;
	j1483555814 [label="MomToxicated: 為什麼？為了什麼？他想從我倆身上得到什麼？",shape=box,color=blue];
		j1483555814 -> j430665542;
	j3960070091 [label="MomToxicated: 那麼這樣她就擁有宇宙中存在的最強大盟友之一了。她選邊了。我們也一樣。",shape=box,color=blue];
		j3960070091 -> j2552211840;
	j4043281921 [label="PapaPolar: 而我敢打賭你的「牆中人」清楚這點，這就是為什麼他一開始會擄走她了",shape=box,color=blue];
		j4043281921 -> j2712994661;
	j430665542 [label="PapaPolar: 我們對那東西來說只是小蝦米。這我已經盡量用最不貶低的方式說了",shape=box,color=blue];
		j430665542 -> j3749130610;
	j2552211840 [label="MomToxicated: 希望我們永遠不會走到互相用槍口指著對方的地步。而要是真的發生了，到時我們就再來處理。",shape=box,color=blue];
		j2552211840 -> j2644195148;
	j2712994661 [label="PapaPolar: 不，她會沒事的。要麼她早就離開了，要麼他們達成了共識，要麼她反過來挾持了他。哈哈",shape=box,color=blue];
		j2712994661 -> j3749130610;
	j3749130610 [label="MomToxicated: 不，我認為那訊息是真的。而且我認為它是來自我們的小女孩。她想告訴我們……她還在外面。",shape=box,color=blue];
		j3749130610 -> j823557793;
	j2644195148 [label="PapaPolar: 不過，她能照顧好自己。我們就是這樣教育她的",shape=box,color=blue];
		j2644195148 -> j3749130610;
	j823557793 [label="MomToxicated: 她用自己的方式告訴我們，她「沒事」。",shape=box,color=blue];
		j823557793 -> j1627157637;
	j1627157637 [label="MomToxicated: 而且我們可以不用再擔心她。",shape=box,color=blue];
		j1627157637 -> j572729159;
	j572729159 [label="PapaPolar: 呵呵，好像我們真的做得到一樣",shape=box,color=blue];
		j572729159 -> j3086237133;
	j3086237133 [label="MomToxicated: 這是身為父母的詛咒與幸福。",shape=box,color=blue];
		j3086237133 -> j3199468697;
	j3199468697 [label="PapaPolar: 漂泊者，你有想過要孩子嗎？呃，還是算了不用回答。可能會回些我根本不想知道的虛空廢話。",shape=box,color=blue];
		j3199468697 -> j3368499789;
		j3199468697 -> j1698278818;
		j3199468697 -> j3147564306;
	j3368499789 [label="喝一杯嗎？喝一杯。",shape=box,color=red];
		j3368499789 -> j199992586;
	j1698278818 [label="好主意。",shape=box,color=red];
		j1698278818 -> j3206521616;
	j3147564306 [label="<RETRO_EMOJI_OHNO>",shape=box,color=red];
		j3147564306 -> j2319375352;
	j199992586 [label="+5 Chemistry",color=orange];
		j199992586 -> j1692411063;
	j3206521616 [label="PapaPolar: 好吧，雖然這不是歡笑而是苦笑，但……",shape=box,color=blue];
		j3206521616 -> j4058754949;
	j2319375352 [label="MomToxicated: 我同意，這是個合理的回應。呵呵。我仨去喝一杯怎麼樣？",shape=box,color=blue];
		j2319375352 -> j670626122;
	j1692411063 [label="MomToxicated: 現在你真的會說我們的語言了。",shape=box,color=blue];
		j1692411063 -> j4058754949;
	j4058754949 [label="PapaPolar: 我想去喝個幾杯，講些關於我們小女孩有趣的故事",shape=box,color=blue];
		j4058754949 -> j1713100426;
	j670626122 [label="PapaPolar: 妳這就說對了",shape=box,color=blue];
		j670626122 -> j4058754949;
	j1713100426 [label="MomToxicated: 還有……漂泊者，再次感謝你。感謝你所做的一切。",shape=box,color=blue];
		j1713100426 -> j3792876044;
	j3792876044 [label="PapaPolar: 是啊。小夥伴，說真的，我不知道我們怎麼樣才能報答你。但如果有機會的話，我們義不容辭。",shape=box,color=blue];
		j3792876044 -> j1472950488;
	j1472950488 [label="PapaPolar: 現在你就是家人了，管你想不想。8-)",shape=box,color=blue];
		j1472950488 -> "Chat ends.";
}