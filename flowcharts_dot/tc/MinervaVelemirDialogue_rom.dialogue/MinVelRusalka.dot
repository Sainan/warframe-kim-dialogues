		1918 -> 1919;
	1919 [label="MomToxicated: 「當太陽與太陰連成一線時，迷失者將找到回家的路」是對應的另一部分。",shape=box,color=blue];
		1919 -> 1920;
	1920 [label="MomToxicated: 這是她使用的那段。",shape=box,color=blue];
		1920 -> 1921;
		1920 -> 1922;
	1921 [label="米娜瓦，但就像妳說的，我們不能確定那就是她。漠然知道她所知道的一切。",shape=box,color=red];
		1921 -> 1923;
	1922 [label="我不知道漠然為什麼要告訴你們這些……",shape=box,color=red];
		1922 -> 1924;
	1923 [label="MomToxicated: 但為什麼那東西會想讓我們覺得有希望呢？除非它只是想傷害我們。",shape=box,color=blue];
		1923 -> 1925;
	1924 [label="MomToxicated: 或許想透過虛假的希望來對我們造成痛苦？",shape=box,color=blue];
