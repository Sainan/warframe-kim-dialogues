		1930 -> 1931;
	1931 [label="PapaPolar: 而我覺得這不是那所謂的漠然有辦法做到的事",shape=box,color=blue];
		1931 -> 1932;
	1932 [label="MomToxicated: 你說得非常對。聽到那段密語，想到她甚至有可能還在外頭，一點都不痛苦。",shape=box,color=blue];
		1932 -> 1933;
