		1936 -> 1939;
	1937 [label="PapaPolar: 她就像拿來固定巨大鈦板金用的框架釘一樣強悍",shape=box,color=blue];
		1937 -> 1940;
	1938 [label="MomToxicated: 為什麼？為了什麼？他想從我倆身上得到什麼？",shape=box,color=blue];
		1938 -> 1942;
	1939 [label="MomToxicated: 那麼這樣她就擁有宇宙中存在的最強大盟友之一了。她選邊了。我們也一樣。",shape=box,color=blue];
		1939 -> 1943;
	1940 [label="PapaPolar: 而我敢打賭你的「牆中人」清楚這點，這就是為什麼他一開始會擄走她了",shape=box,color=blue];
		1940 -> 1941;
	1942 [label="PapaPolar: 我們對那東西來說只是小蝦米。這我已經盡量用最不貶低的方式說了",shape=box,color=blue];
		1942 -> 1945;
	1943 [label="MomToxicated: 希望我們永遠不會走到互相用槍口指著對方的地步。而要是真的發生了，到時我們就再來處理。",shape=box,color=blue];
		1943 -> 1944;
	1941 [label="PapaPolar: 不，她會沒事的。要麼她早就離開了，要麼他們達成了共識，要麼她反過來挾持了他。哈哈",shape=box,color=blue];
		1941 -> 1945;
	1945 [label="MomToxicated: 不，我認為那訊息是真的。而且我認為它是來自我們的小女孩。她想告訴我們……她還在外面。",shape=box,color=blue];
		1945 -> 1946;
	1944 [label="PapaPolar: 不過，她能照顧好自己。我們就是這樣教育她的",shape=box,color=blue];
		1944 -> 1945;
	1946 [label="MomToxicated: 她用自己的方式告訴我們，她「沒事」。",shape=box,color=blue];
		1946 -> 1947;
	1947 [label="MomToxicated: 而且我們可以不用再擔心她。",shape=box,color=blue];
		1947 -> 1948;
