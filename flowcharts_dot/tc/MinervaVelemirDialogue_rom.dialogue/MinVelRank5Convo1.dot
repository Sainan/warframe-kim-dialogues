	j3884442781 [label="PapaPolar: 我們最後一次跟她通話是透過安全線路。 ",shape=box,color=blue];
		j3884442781 -> j1561941839;
	j1561941839 [label="PapaPolar: 她那隻怪相的小鼬鼠可能正在偷聽",shape=box,color=blue];
		j1561941839 -> j1177712553;
	j1177712553 [label="PapaPolar: 那時我們*名義*上來說仍然在一起，但關係卻迅速惡化……",shape=box,color=blue];
		j1177712553 -> j1356977848;
	j1356977848 [label="MomToxicated: 我敢打賭她早知道。她聽得到。即使我們當時還不知道。",shape=box,color=blue];
		j1356977848 -> j1232516764;
		j1356977848 -> j3313626096;
	j1232516764 [label="你能分辨出她是不是……你知道。 「他」 呢？",shape=box,color=red];
		j1232516764 -> j1740559612;
	j3313626096 [label="你們三個那時候在聊什麼？",shape=box,color=red];
		j3313626096 -> j822610014;
	j1740559612 [label="PapaPolar: 如果你想問的是這個的話，她聽起來就像我們的小女孩。知道該說什麼以及怎麼說。",shape=box,color=blue];
		j1740559612 -> j1772914331;
	j822610014 [label="MomToxicated: 最初由一門生意開始。看她怎樣掌控。當然她不能給我們任何確切的數字或細節。",shape=box,color=blue];
		j822610014 -> j231271044;
	j1772914331 [label="MomToxicated: 但是所有出色的人質劫持者都知道如何讓被俘虜的鳥按照命令唱歌。",shape=box,color=blue];
		j1772914331 -> j3821473669;
	j231271044 [label="MomToxicated: 我們不是清剿隊。對於電話另一頭的人來說，他們只不過是平民罷了。所以她不可能提供我們機密情報。",shape=box,color=blue];
		j231271044 -> j1709981535;
	j3821473669 [label="MomToxicated: 這並不代表這種「漠然」什麼時候，又是怎樣帶走了她。",shape=box,color=blue];
		j3821473669 -> j952400842;
	j1709981535 [label="PapaPolar: 但她聽起來……很緊張。你可以聽得出來。",shape=box,color=blue];
		j1709981535 -> j3804862636;
		j1709981535 -> j3888961900;
	j952400842 [label="MomToxicated: 或是那天我們跟她對話時是誰在掌控她的身體。",shape=box,color=blue];
		j952400842 -> j3281824610;
