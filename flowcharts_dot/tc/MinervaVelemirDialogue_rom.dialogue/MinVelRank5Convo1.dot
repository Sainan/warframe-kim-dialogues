	1495 [label="Chat ends. Next chat will be MinVelRank5Convo2.",color=orange];
	1496 [label="PapaPolar: 她那隻怪相的小鼬鼠可能正在偷聽",shape=box,color=blue];
		1496 -> 1497;
	1497 [label="PapaPolar: 那時我們*名義*上來說仍然在一起，但關係卻迅速惡化……",shape=box,color=blue];
		1497 -> 1498;
	1498 [label="MomToxicated: 我敢打賭她早知道。她聽得到。即使我們當時還不知道。",shape=box,color=blue];
		1498 -> 1499;
		1498 -> 1500;
	1499 [label="你能分辨出她是不是……你知道。 「他」 呢？",shape=box,color=red];
		1499 -> 1501;
	1500 [label="你們三個那時候在聊什麼？",shape=box,color=red];
		1500 -> 1502;
	1501 [label="PapaPolar: 如果你想問的是這個的話，她聽起來就像我們的小女孩。知道該說什麼以及怎麼說。",shape=box,color=blue];
		1501 -> 1503;
	1502 [label="MomToxicated: 最初由一門生意開始。看她怎樣掌控。當然她不能給我們任何確切的數字或細節。",shape=box,color=blue];
		1502 -> 1504;
	1503 [label="MomToxicated: 但是所有出色的人質劫持者都知道如何讓被俘虜的鳥按照命令唱歌。",shape=box,color=blue];
		1503 -> 1505;
	1504 [label="MomToxicated: 我們不是清剿隊。對於電話另一頭的人來說，他們只不過是平民罷了。所以她不可能提供我們機密情報。",shape=box,color=blue];
		1504 -> 1506;
	1505 [label="MomToxicated: 這並不代表這種「漠然」什麼時候，又是怎樣帶走了她。",shape=box,color=blue];
		1505 -> 1507;
	1506 [label="PapaPolar: 但她聽起來……很緊張。你可以聽得出來。",shape=box,color=blue];
		1506 -> 1508;
		1506 -> 1509;
	1507 [label="MomToxicated: 或是那天我們跟她對話時是誰在掌控她的身體。",shape=box,color=blue];
		1507 -> 1510;
	1508 [label="她？有壓力？很難想像。",shape=box,color=red];
		1508 -> 1511;
	1509 [label="關於什麼有壓力？",shape=box,color=red];
		1509 -> 1512;
	1510 [label="PapaPolar: 我不知道如何找到一個神然後打祂一拳在[已刪改]]臉上但我會[已刪改]]試試",shape=box,color=blue];
		1510 -> 1506;
	1511 [label="MomToxicated: 嘻。即使最出色的人也會發生這種情況。特別是當你追捕「逃犯」的時候。",shape=box,color=blue];
		1511 -> 1513;
	1512 [label="MomToxicated: 一個「逃犯」。",shape=box,color=blue];
		1512 -> 1513;
	1513 [label="MomToxicated: 源拓氏。當時，我以為這「不過是」當地的一個毒梟或反抗力量的領袖。",shape=box,color=blue];
		1513 -> 1514;
	1514 [label="PapaPolar: 甚至幾乎沒有提過該死的烤麵包機電視殭屍怪物的事。你可能會以為這種情況值得一提。",shape=box,color=blue];
		1514 -> 1515;
	1515 [label="MomToxicated: 我不曉得當時她是否已經少了隻手臂。大概也沒辦法知道了。",shape=box,color=blue];
		1515 -> 1516;
		1515 -> 1517;
	1516 [label="你們是怎樣結束的？",shape=box,color=red];
		1516 -> 1518;
	1517 [label="你告訴她你要來霍爾瓦尼亞嗎？",shape=box,color=red];
		1517 -> 1519;
	1518 [label="MomToxicated: 間諜總是以這種方式結束通話。透過互相說謊。",shape=box,color=blue];
		1518 -> 1520;
	1519 [label="PapaPolar: 哈哈，當然沒有。城市當時處於封鎖狀態，還記得嗎？完全的秘密行動，我們偷偷潛入。",shape=box,color=blue];
		1519 -> 1521;
	1520 [label="MomToxicated: 當時我們在計劃要部署到她所處的封鎖城市中，所以跟她說我們要去別的地方執行任務。",shape=box,color=blue];
		1520 -> 1522;
	1521 [label="MomToxicated: 我們按照間諜常用的方式結束通話，也就是說謊。",shape=box,color=blue];
		1521 -> 1520;
	1522 [label="PapaPolar: 然後我們對彼此撒了最大的謊。",shape=box,color=blue];
		1522 -> 1523;
	1523 [label="PapaPolar: 我們說「別擔心，我們會沒事的。」",shape=box,color=blue];
		1523 -> 1524;
	1524 [label="MomToxicated: 至少在掛斷前我們跟她說了最後一句實話。",shape=box,color=blue];
		1524 -> 1525;
	1525 [label="PapaPolar: 嗯。是啊。",shape=box,color=blue];
		1525 -> 1526;
		1525 -> 1527;
	1526 [label="噢?",shape=box,color=red];
		1526 -> 1528;
	1527 [label="是什麼？",shape=box,color=red];
		1527 -> 1528;
	1528 [label="PapaPolar: 「你是我們的寶貝女兒。沒有事情會改變這一點。」",shape=box,color=blue];
		1528 -> 1529;
	1529 [label="MomToxicated: 「無論你走得多遠，我們都會永遠愛你。」",shape=box,color=blue];
		1529 -> 1530;
