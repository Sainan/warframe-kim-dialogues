		j3281824610 -> j1709981535;
	j330435486 [label="MomToxicated: 嘻。即使最出色的人也會發生這種情況。特別是當你追捕「逃犯」的時候。",shape=box,color=blue];
		j330435486 -> j1475006539;
	j4042968769 [label="MomToxicated: 一個「逃犯」。",shape=box,color=blue];
		j4042968769 -> j1475006539;
	j1475006539 [label="MomToxicated: 源拓氏。當時，我以為這「不過是」當地的一個毒梟或反抗力量的領袖。",shape=box,color=blue];
		j1475006539 -> j3162416730;
	j3162416730 [label="PapaPolar: barely even mentioned the freakin' monster toaster tv zombies. you'd think that would've come up more.",shape=box,color=blue];
		j3162416730 -> j99878159;
	j99878159 [label="MomToxicated: I wonder if she had lost her arm yet at that point. No way to know, I suppose.",shape=box,color=blue];
