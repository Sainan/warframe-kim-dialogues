	4250 [label="Update boolean AoiConsentComplete",color=orange];
		4250 -> 4252;
	4253 [label="我想和你說件事，我想確認你的想法。",shape=box,color=red];
		4253 -> 4254;
	4252 [label="Chat ends.",color=orange];
	4254 [label="對我來說更重要的是，希望你不會覺得我在騙你或以任何方式對你不忠。",shape=box,color=red];
		4254 -> 4255;
	4255 [label="<RETRO_EMOJI_OHNO>",shape=box,color=blue];
		4255 -> 4256;
	4256 [label="是我做了什麼嗎？",shape=box,color=blue];
		4256 -> 4257;
	4257 [label="沒什麼！沒事。我只是想跟你談件事，希望不會讓你感到不舒服。",shape=box,color=red];
		4257 -> 4258;
	4258 [label="我不願讓你置身你不願待的處境。我知道這不是我們之前討論過的事。所以如果你不想的話，那也沒關係。我希望你明白這點。",shape=box,color=red];
		4258 -> 4259;
	4259 [label="我們之間的關係對我來說很重要，非常重要，而且它是真實的。我不希望你懷疑這點。",shape=box,color=red];
		4259 -> 4260;
	4260 [label="哦──",shape=box,color=blue];
		4260 -> 4261;
	4261 [label="(っᵔ◡ᵔ)っ(˶ᵔ ᵕ ᵔ˶)",shape=box,color=blue];
		4261 -> 4262;
	4262 [label="我知道了，呵呵",shape=box,color=blue];
		4262 -> 4263;
	4263 [label="<RETRO_EMOJI_WINK>",shape=box,color=blue];
		4263 -> 4265;
		4263 -> 4264;
	4265 [label="真的嗎？",shape=box,color=red];
		4265 -> 4266;
	4264 [label="蛤……？",shape=box,color=red];
		4264 -> 4266;
	4266 [label="嗯哼！",shape=box,color=blue];
		4266 -> 4267;
	4267 [label="我想，我只是想知道我有沒有機會認識他們吧？",shape=box,color=blue];
		4267 -> 4268;
	4268 [label="哦……該不會是……不會是六煞成員之一吧？還是圓桌成員之一？那樣可能會有點……尬",shape=box,color=blue];
		4268 -> 4269;
	4269 [label="不，你並不認識他們。而且很遺憾我不知道能不能介紹你們認識。他們不是來自這個時代。",shape=box,color=red];
		4269 -> 4270;
	4270 [label="可惡！那你得答應幫我把我的份也玩回來，哈哈",shape=box,color=blue];
		4270 -> 4271;
	4271 [label="但你跟他們在一起快樂嗎？",shape=box,color=blue];
		4271 -> 4272;
	4272 [label="他們確實讓我很開心。而我對你的關心並沒有變少。你們倆對我都很重要。",shape=box,color=red];
		4272 -> 4273;
