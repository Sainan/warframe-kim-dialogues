		j3703546507 -> j4099881801;
	j379056631 [label="Boolean AoiConsentComplete is now true.",color=orange];
		j379056631 -> "Chat ends.";
	j4099881801 [label="我想和你說件事，我想確認你的想法。",shape=box,color=red];
		j4099881801 -> j2665588856;
	j2665588856 [label="對我來說更重要的是，希望你不會覺得我在騙你或以任何方式對你不忠。",shape=box,color=red];
		j2665588856 -> j3708409664;
	j3708409664 [label="<RETRO_EMOJI_OHNO>",shape=box,color=blue];
		j3708409664 -> j1504584729;
	j1504584729 [label="是我做了什麼嗎？",shape=box,color=blue];
		j1504584729 -> j1414160410;
	j1414160410 [label="沒什麼！沒事。我只是想跟你談件事，希望不會讓你感到不舒服。",shape=box,color=red];
		j1414160410 -> j1804476594;
	j1804476594 [label="我不願讓你置身你不願待的處境。我知道這不是我們之前討論過的事。所以如果你不想的話，那也沒關係。我希望你明白這點。",shape=box,color=red];
		j1804476594 -> j807759944;
	j807759944 [label="我們之間的關係對我來說很重要，非常重要，而且它是真實的。我不希望你懷疑這點。",shape=box,color=red];
		j807759944 -> j3045039815;
	j3045039815 [label="哦──",shape=box,color=blue];
		j3045039815 -> j4131805150;
	j4131805150 [label="(っᵔ◡ᵔ)っ(˶ᵔ ᵕ ᵔ˶)",shape=box,color=blue];
		j4131805150 -> j3379510555;
	j3379510555 [label="我知道了，呵呵",shape=box,color=blue];
		j3379510555 -> j2062834982;
	j2062834982 [label="<RETRO_EMOJI_WINK>",shape=box,color=blue];
		j2062834982 -> j1657382428;
		j2062834982 -> j2375499133;
	j1657382428 [label="真的嗎？",shape=box,color=red];
		j1657382428 -> j167608459;
	j2375499133 [label="蛤……？",shape=box,color=red];
		j2375499133 -> j167608459;
	j167608459 [label="嗯哼！",shape=box,color=blue];
		j167608459 -> j2316664699;
	j2316664699 [label="我想，我只是想知道我有沒有機會認識他們吧？",shape=box,color=blue];
		j2316664699 -> j2925785073;
	j2925785073 [label="哦……該不會是……不會是六煞成員之一吧？還是圓桌成員之一？那樣可能會有點……尬",shape=box,color=blue];
		j2925785073 -> j1694687182;
	j1694687182 [label="不，你並不認識他們。而且很遺憾我不知道能不能介紹你們認識。他們不是來自這個時代。",shape=box,color=red];
		j1694687182 -> j2595736462;
	j2595736462 [label="可惡！那你得答應幫我把我的份也玩回來，哈哈",shape=box,color=blue];
		j2595736462 -> j2172653441;
	j2172653441 [label="但你跟他們在一起快樂嗎？",shape=box,color=blue];
		j2172653441 -> j47702239;
	j47702239 [label="他們確實讓我很開心。而我對你的關心並沒有變少。你們倆對我都很重要。",shape=box,color=red];
		j47702239 -> j4169829125;
	j4169829125 [label="+20 Chemistry",color=orange];
		j4169829125 -> j2286329543;
	j2286329543 [label="<RETRO_EMOJI_THUMBSUP>",shape=box,color=blue];
		j2286329543 -> j148378784;
	j148378784 [label="那我就沒什麼好在意的了！",shape=box,color=blue];
		j148378784 -> j1280646277;
	j1280646277 [label="只要大家都有共識，而且每個人都玩得滿意，那我就滿足了。",shape=box,color=blue];
		j1280646277 -> j379056631;
}