		4273 -> 4274;
	4274 [label="<RETRO_EMOJI_THUMBSUP>",shape=box,color=blue];
		4274 -> 4275;
	4275 [label="那我就沒什麼好在意的了！",shape=box,color=blue];
		4275 -> 4276;
	4276 [label="只要大家都有共識，而且每個人都玩得滿意，那我就滿足了。",shape=box,color=blue];
