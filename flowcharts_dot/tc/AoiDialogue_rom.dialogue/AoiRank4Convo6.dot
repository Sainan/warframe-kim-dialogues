	2885 [label="我們以後都不用再次談論他了。",shape=box,color=red];
		2885 -> 2887;
	2886 [label="你知道，當葵開始用句號而不用表情符號時，你就知道事情很嚴重了。",shape=box,color=red];
		2886 -> 2888;
	2887 [label="不，沒關係……",shape=box,color=blue];
		2887 -> 2889;
	2888 [label="哈哈，你真的太了解我了，這有點嚇人",shape=box,color=blue];
		2888 -> 2889;
	2889 [label="說真的，每次我想到那個博士，我都會想起我第一次在亞瑟眼中看到恐懼的樣子",shape=box,color=blue];
		2889 -> 2890;
	2890 [label="我想起阿米爾完全陷入恐慌，愛琳娜無法說話，崑西硬起了心腸，而莉蒂則因為過於崩潰而無法繼續拯救她周圍的人",shape=box,color=blue];
		2890 -> 2891;
