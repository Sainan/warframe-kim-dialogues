digraph {
	2825 [label="AoiRank4Convo6 begins.",color=orange];
		2825 -> 2826;
	2826 [label="你跟我講過這麼多關於 Orokin 的糟糕故事……有沒有人背棄過他們的生活方式？",shape=box,color=blue];
		2826 -> 2827;
		2826 -> 2828;
	2827 [label="信不信由你，阿爾布雷希特．源拓氏博士。",shape=box,color=red];
		2827 -> 2829;
	2828 [label="大多數人都死了。但阿爾布雷希特．源拓氏以他自己的方式做到了。",shape=box,color=red];
		2828 -> 2830;
	2829 [label="噁心。",shape=box,color=blue];
		2829 -> 2831;
	2830 [label="呃，那傢伙。總是從死亡的魔爪中溜走。",shape=box,color=blue];
		2830 -> 2831;
	2831 [label="我還以為會是某個……更酷的人。",shape=box,color=blue];
		2831 -> 2835;
		2831 -> 2834;
	2835 [label="不好意思讓你失望了。他就是你問的那個人。他拒絕了赤毒，一種能讓他永生的東西。他也沒追求那些時髦的長臂，通通都沒要。",shape=box,color=red];
		2835 -> 2833;
	2834 [label="嗯……我再想想有沒有更酷的 Orokin，給我點時間。",shape=box,color=red];
		2834 -> 2832;
	2833 [label="我敢肯定，他只是追逐對自己最有利的東西。",shape=box,color=blue];
		2833 -> 2836;
		2833 -> 2837;
	2832 [label="嗯，那個人肯定就是你了，我猜 ^_^",shape=box,color=blue];
		2832 -> 2836;
		2832 -> 2837;
		2832 -> 2838;
	2836 [label="你曾經尊重過源拓氏嗎？",shape=box,color=red];
		2836 -> 2839;
	2837 [label="你對源拓氏的真正看法是什麼？撇開那個「不酷」的評價。",shape=box,color=red];
		2837 -> 2840;
	2838 [label="哈，我不是 Orokin。我只是來自他們的帝國，非常不一樣。",shape=box,color=red];
		2838 -> 2841;
	2839 [label="嗯，現在開始拋出大問題了，對吧？我想你確實贏得了這個資格。",shape=box,color=blue];
		2839 -> 2843;
	2840 [label="我對這傢伙已經沒有什麼尊重可失了 ^_^",shape=box,color=blue];
		2840 -> 2843;
	2841 [label="哦哦……這讓人很困惑",shape=box,color=blue];
		2841 -> 2842;
	2843 [label="像他這樣的人，只有在對自己有利的時候才會裝出一副迷人的樣子",shape=box,color=blue];
		2843 -> 2844;
		2843 -> 2845;
	2842 [label="我真的很不喜歡源拓氏。像他這樣的人，只有在對自己有利的時候才會裝出一副迷人的樣子",shape=box,color=blue];
		2842 -> 2844;
		2842 -> 2845;
	2844 [label="你覺得他真正追求的是什麼？",shape=box,color=red];
		2844 -> 2846;
	2845 [label="所以你曾經覺得他有魅力？",shape=box,color=red];
		2845 -> 2847;
	2846 [label="控制。徹底的支配。",shape=box,color=blue];
		2846 -> 2848;
	2847 [label="我不會說得那麼誇張，更像是我曾經對是否應該要尊重他持開放態度。",shape=box,color=blue];
		2847 -> 2849;
	2848 [label="也不是那種有趣的、像流行歌手開世界巡迴演唱會那樣的感覺。",shape=box,color=blue];
		2848 -> 2850;
	2849 [label="但他把這一切都丟掉了。",shape=box,color=blue];
		2849 -> 2850;
	2850 [label="他會吞噬他接觸到的一切。即使吞掉了整個宇宙對他來說也不足夠。",shape=box,color=blue];
		2850 -> 2851;
		2850 -> 2852;
		2850 -> 2853;
	2851 [label="你很早就知道了？你是六煞幫裡最有直覺的人。如果有人會有這種直覺，那肯定就是你。",shape=box,color=red];
		2851 -> 2854;
	2852 [label="我傾向於同意你的看法。",shape=box,color=red];
		2852 -> 2854;
	2853 [label="我不知道，宇宙很大呢 :P",shape=box,color=red];
		2853 -> 2856;
	2854 [label="+5 Chemistry",color=orange];
		2854 -> 2855;
	2856 [label="但他仍然會去嘗試，這就是問題所在",shape=box,color=blue];
		2856 -> 2857;
	2855 [label="感謝您。 ^_^",shape=box,color=blue];
		2855 -> 2857;
	2857 [label="不是一開始就察覺，但很早就覺得，每次他表現得很友好的時候，我心裡就有一種不安的感覺，好像有壞事要發生",shape=box,color=blue];
		2857 -> 2858;
	2858 [label="那時候，雖然我說不出為什麼，但總覺得不管發生什麼壞事，他一定脫不了關係。",shape=box,color=blue];
		2858 -> 2859;
	2859 [label="可是當他把周圍所有人都欺騙了之後，你又能怎麼辦呢？",shape=box,color=blue];
		2859 -> 2860;
		2859 -> 2861;
	2860 [label="你覺得他真的騙住所有人了嗎？",shape=box,color=red];
		2860 -> 2862;
	2861 [label="我猜只能等他們自己看清。",shape=box,color=red];
		2861 -> 2863;
	2862 [label="嗯，也許沒有",shape=box,color=blue];
		2862 -> 2864;
	2863 [label="是啊",shape=box,color=blue];
		2863 -> 2865;
	2864 [label="更像是大家都太害怕去挑戰他",shape=box,color=blue];
		2864 -> 2866;
	2865 [label="這更像是我的詛咒，本能地想和氣相處",shape=box,color=blue];
		2865 -> 2867;
	2866 [label="這讓我非常煩躁。",shape=box,color=blue];
		2866 -> 2868;
		2866 -> 2869;
	2867 [label="也許如果我早點說點什麼，就會有更多人更早看穿他。",shape=box,color=blue];
		2867 -> 2868;
		2867 -> 2869;
	2868 [label="如果能讓你稍微好受點的話，他在我來的地方也是這樣。",shape=box,color=red];
		2868 -> 2870;
	2869 [label="你不是唯一有這種感覺的人。他在每個人身上都留下了痕跡。",shape=box,color=red];
		2869 -> 2871;
	2870 [label="這算是……苦樂參半吧。",shape=box,color=blue];
		2870 -> 2872;
		2870 -> 2873;
	2871 [label="唉，連未來都無法逃過那傢伙的毒手。",shape=box,color=blue];
		2871 -> 2872;
		2871 -> 2873;
	2872 [label="他留下了一個女兒，她還在試圖修復他破壞的一切。即使她很憤怒，但我覺得她還是忍不住去相信他。",shape=box,color=red];
		2872 -> 2874;
	2873 [label="是啊。他留下了他的愛人來修復他對無數人……還有動物造成的傷害。",shape=box,color=red];
		2873 -> 2874;
	2874 [label="這就是他，他就是這樣的人。",shape=box,color=blue];
		2874 -> 2875;
	2875 [label="他是我所知道的唯一一個充滿虛無的存在。",shape=box,color=blue];
		2875 -> 2876;
	2876 [label="當他找到自己想要的東西時，他就會將它掠奪殆盡，用完之後就毫不留情地拋棄。還總是以最冷酷無情、最自私自利的方式。",shape=box,color=blue];
		2876 -> 2877;
		2876 -> 2879;
		2876 -> 2882;
	2877 [label="是啊……「不酷」這個詞開始聽起來都太輕描淡寫了。",shape=box,color=red];
		2877 -> 2883;
	2879 [label="天啊，別客氣啊，繼續說。",shape=box,color=red];
		2879 -> 2880;
	2882 [label="我懷疑就算是那些喜歡他的人也無法否認這一點。",shape=box,color=red];
		2882 -> 2881;
	2883 [label="+5 Chemistry",color=orange];
		2883 -> 2878;
	2880 [label="我無法否認，每次想到這件事我都會變得很激動……",shape=box,color=blue];
		2880 -> 2884;
		2880 -> 2885;
		2880 -> 2886;
	2881 [label="請替我向未來被他傷害過的人問好。",shape=box,color=blue];
		2881 -> 2884;
		2881 -> 2885;
		2881 -> 2886;
	2878 [label="哈哈，我從沒見過比他更不酷的人！",shape=box,color=blue];
		2878 -> 2884;
		2878 -> 2885;
		2878 -> 2886;
	2884 [label="抱歉，如果我讓你想起了一些不好的回憶。",shape=box,color=red];
