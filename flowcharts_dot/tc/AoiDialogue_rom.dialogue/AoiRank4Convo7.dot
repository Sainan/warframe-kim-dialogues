digraph {
	2911 [label="AoiRank4Convo7 begins.",color=orange];
		2911 -> 2912;
	2912 [label="Check boolean AoiVoidTongue",color=orange];
		2912 -> 2914 [label=true,color=green];
		2912 -> 2913 [label=false,color=brown];
	2914 [label="所以，我想我知道了！",shape=box,color=blue];
		2914 -> 2917;
		2914 -> 2918;
	2913 [label="Check boolean AoiPianoLesson",color=orange];
		2913 -> 2915 [label=true,color=green];
		2913 -> 2916 [label=false,color=brown];
	2917 [label="<RETRO_EMOJI_WUT>",shape=box,color=red];
		2917 -> 2919;
	2918 [label="你有什麼？",shape=box,color=red];
		2918 -> 2920;
	2915 [label="咳咳！準備好上鋼琴課了嗎？",shape=box,color=blue];
		2915 -> 2921;
		2915 -> 2922;
	2916 [label="我可以介紹你認識一位朋友嗎？他叫「鋼琴先生」。",shape=box,color=blue];
		2916 -> 2921;
		2916 -> 2922;
	2919 [label="+5 Chemistry",color=orange];
		2919 -> 2924;
	2920 [label="一種彈鋼琴，或者說演奏任何音樂而不用總是想到「虛空之語」的方法",shape=box,color=blue];
		2920 -> 2926;
	2921 [label="我要報名。",shape=box,color=red];
		2921 -> 2927;
	2922 [label="不是現在。 [結束]",shape=box,color=red];
		2922 -> 2923;
	2924 [label="<RETRO_EMOJI_JOY>",shape=box,color=blue];
		2924 -> 2925;
	2926 [label="或者說，也許我有點想得太多了。話說回來，「虛空語」是什麼？",shape=box,color=blue];
		2926 -> 2929;
		2926 -> 2930;
		2926 -> 2931;
	2927 [label="讓我們先從這裡開始吧：為什麼是音樂？為什麼是鋼琴？",shape=box,color=blue];
		2927 -> 2928;
	2923 [label="Chat ends.",color=orange];
	2925 [label="我有一種彈鋼琴，或者說演奏任何音樂而不用總是想到「虛空語」的方法",shape=box,color=blue];
		2925 -> 2926;
	2929 [label="這個問題並不容易回答。那些是來自虛空的聲音、詞語、低語。更像是一種詛咒。一種向能聽到它的耳朵傳遞某些信息的方式。",shape=box,color=red];
		2929 -> 2948;
	2930 [label="那是我再也不想聽到的東西。",shape=box,color=red];
		2930 -> 2949;
	2931 [label="我想，這就是引發這一切的語言。它的表達方式。",shape=box,color=red];
		2931 -> 2953;
	2928 [label="這樣開始鋼琴課比較簡單，因為，呃，我找不到鋼琴。所以我們還是先從理論開始吧。",shape=box,color=blue];
		2928 -> 2934;
		2928 -> 2932;
		2928 -> 2933;
	2948 [label="什麼？<RETRO_EMOJI_OHNO>",shape=box,color=blue];
		2948 -> 2954;
	2949 [label="像是一首垃圾歌嗎？",shape=box,color=blue];
		2949 -> 2950;
		2949 -> 2951;
	2953 [label="是某種像歌唱的語言嗎？",shape=box,color=blue];
		2953 -> 2955;
		2953 -> 2956;
	2934 [label="好吧，那我們還是先專注於理論吧。",shape=box,color=red];
		2934 -> 2935;
	2932 [label="你有多努力去找過鋼琴？",shape=box,color=red];
		2932 -> 2938;
	2933 [label="我們在哪裡能找到鋼琴？",shape=box,color=red];
		2933 -> 2939;
	2954 [label="好吧，現在我真的得為你找些音樂了。想想，用你自己的歌曲去蓋過這個「虛空語」，不好嗎？",shape=box,color=blue];
		2954 -> 2955;
		2954 -> 2956;
	2950 [label="就說到這裡吧。 [結束]",shape=box,color=red];
		2950 -> 2952;
	2951 [label="算是吧，我猜。",shape=box,color=red];
		2951 -> 2953;
	2955 [label="我不太懂得該如何去形容它。但它很強大。",shape=box,color=red];
		2955 -> 2957;
	2956 [label="那不是你想聽的東西。它是造成這一切的原因之一。",shape=box,color=red];
		2956 -> 2960;
	2935 [label="耶！讓我好好跟你說一下，音樂在這裡一直都超重要。以前，男孩女孩們會坐在鋼琴前創作，而不是對著電視發呆。",shape=box,color=blue];
		2935 -> 2936;
	2938 [label="嗯，有點難吧？我不是很確定在那片荒廢的公寓裡能找到什麼……",shape=box,color=blue];
		2938 -> 2940;
	2939 [label="嗯，它們又大又難藏起來……我懷疑維克多和清剿隊會演奏。",shape=box,color=blue];
		2939 -> 2940;
	2952 [label="Chat ends.",color=orange];
	2957 [label="它的力量足以改變生命。我認識的一些動物，應該說是我的朋友——參研者。牠們接觸了虛空後，學會了說話。就像某種詭異的魔法一樣。",shape=box,color=red];
		2957 -> 2959;
	2960 [label="這是造成這麼多痛苦的原因。",shape=box,color=red];
		2960 -> 2961;
		2960 -> 2962;
	2936 [label="彈奏……寫作……其實歌曲就像是透過音樂進行溝通。甚至不需要歌詞！",shape=box,color=blue];
		2936 -> 2937;
	2940 [label="唉，清剿隊。他們多半已經把那些樂器全毀了吧。這種地方，他們怎麼會讓像樂器這種充滿希望的東西存在呢？",shape=box,color=blue];
		2940 -> 2941;
	2959 [label="而現在當牠們開口說話時，一開始就充滿著絕望，充滿著錯誤。虛空語最初只讓這些生物感受到一件事：絕望。",shape=box,color=red];
		2959 -> 2958;
	2961 [label="我聽不下去。",shape=box,color=red];
		2961 -> 2963;
	2962 [label="但即便這樣，我還是覺得我會說這種語言。",shape=box,color=red];
		2962 -> 2963;
	2937 [label="但想像一下——為我們的世界去創造一些能讓人哭泣、跳舞、歌唱的東西？對我來說它簡直就像魔法一樣。",shape=box,color=blue];
		2937 -> 2942;
		2937 -> 2943;
	2941 [label="但等等，我問你，如果未來還有音樂，也許代表未來還有希望。所以……",shape=box,color=blue];
		2941 -> 2945;
	2958 [label="別說我蠢，但你有試著為牠們彈奏音樂嗎？為你的那些朋友？也許即使只有一秒也會有幫助？",shape=box,color=blue];
		2958 -> 2965;
	2963 [label="這讓我害怕。它就像一首我想抹去的詛咒之歌。一個應該消失的魔法詛咒。",shape=box,color=red];
		2963 -> 2964;
	2942 [label="魔法？我不這麼認為。不過有一首好歌我確實挺喜歡。",shape=box,color=red];
		2942 -> 2946;
	2943 [label="音樂是我生命經歷中的一部分。歌曲承載著回憶，我懂得那種感覺。",shape=box,color=red];
		2943 -> 2944;
	2945 [label="請向我介紹一首歌吧。",shape=box,color=blue];
		2945 -> 2974;
		2945 -> 2975;
		2945 -> 2976;
	2965 [label="難道你不覺得音樂可以突破重重障礙，成為所有人、所有事的希望嗎？如果虛空語是「魔法」，那麼音樂也是一種魔法。",shape=box,color=blue];
		2965 -> 2967;
		2965 -> 2966;
	2964 [label="沒事的，沒事的。我懂了。音樂有時也會讓人感到絕望。",shape=box,color=blue];
		2964 -> 2965;
	2946 [label="也許有一天你會相信我的話。",shape=box,color=blue];
		2946 -> 2947;
	2944 [label="+10 Chemistry",color=orange];
		2944 -> 2945;
	2974 [label="音樂能夠刻畫記憶。《來自 Juran 的微笑》是一首我在一個失去一切的人的腦海和回憶中聽到的歌。",shape=box,color=red];
		2974 -> 2977;
	2975 [label="音樂也可以是希望。知道我們應該要《共舉時艱》是有道理的，對吧？",shape=box,color=red];
		2975 -> 2978;
	2976 [label="葵，音樂也可能是邪惡的。我試圖拯救的那些人，他們被歌聲詛咒了。他們唱著《為那爾邁》。",shape=box,color=red];
		2976 -> 2979;
	2967 [label="那麼，你願意為我彈奏一首歌嗎？",shape=box,color=red];
		2967 -> 2968;
	2966 [label="也許你聽太多歌了吧。",shape=box,color=red];
		2966 -> 2969;
	2947 [label="Chat ends.",color=orange];
	2977 [label="想像一下，一切都被奪走了——你的家庭、生命，甚至你自我的意識。",shape=box,color=red];
		2977 -> 2980;
	2978 [label="通過歌曲找到快樂、意義以及共享的經歷。",shape=box,color=red];
		2978 -> 2981;
	2979 [label="你不知道看到這一切是什麼感覺。",shape=box,color=red];
		2979 -> 2982;
	2968 [label="+10 Chemistry",color=orange];
		2968 -> 2971;
	2969 [label="好吧，這只是你的意見。謝謝你聽我說。",shape=box,color=blue];
		2969 -> 2970;
	2980 [label="而一首歌，僅僅一首歌，就可能是幫助你找到自我的基礎。",shape=box,color=red];
		2980 -> 2983;
	2981 [label="這很有趣，也充滿希望。我們中很多人都無法選擇自己的生活環境。",shape=box,color=red];
		2981 -> 2984;
	2982 [label="日尊啊！我很抱歉，請告訴我更多關於它的事。",shape=box,color=blue];
		2982 -> 2985;
	2971 [label="當然！！！！",shape=box,color=blue];
		2971 -> 2972;
	2970 [label="Chat ends.",color=orange];
	2983 [label="我喜歡想像，如果我迷失了自我，音樂會是幫助我找到方向的一種方式。",shape=box,color=red];
		2983 -> 2987;
	2984 [label="但我們仍然可以選擇一起歌唱，無論如何，無關其他。只是歌唱。",shape=box,color=red];
		2984 -> 2989;
	2985 [label="在這裡告訴你這件事總覺得有點怪，我多希望能用歌聲告訴你。不過，如果我能說點什麼關於它的話，那就是邪惡……",shape=box,color=red];
		2985 -> 2986;
	2972 [label="Update boolean AoiPlaySong",color=orange];
		2972 -> 2973;
	2987 [label="你在說的那些……",shape=box,color=blue];
		2987 -> 2988;
	2989 [label="音樂是很強大的。",shape=box,color=blue];
		2989 -> 2990;
	2986 [label="邪惡總是想破壞美好的東西。我親眼見過它發生在音樂之上。沒有人應該為邪惡讚頌。",shape=box,color=red];
		2986 -> 2989;
	2973 [label="Chat ends.",color=orange];
	2988 [label="感覺就像是，嗯，我的感受一樣。這感覺像是宇宙的法則。",shape=box,color=blue];
		2988 -> 2989;
	2990 [label="這有點尷尬，但我有一個類似的故事。雖然沒有那麼沉重，但……也許你會明白。",shape=box,color=blue];
		2990 -> 2991;
	2991 [label="在我小的時候，就像個「小小葵」，我想和每個人做朋友。",shape=box,color=blue];
		2991 -> 2992;
		2991 -> 2993;
	2992 [label="聽起來像是我認識的葵。",shape=box,color=red];
		2992 -> 2994;
	2993 [label="真的嗎？葵竟然會和人友好相處？",shape=box,color=red];
		2993 -> 2996;
	2994 [label="+10 Chemistry",color=orange];
		2994 -> 2995;
	2996 [label="我就忽略這句了！",shape=box,color=blue];
		2996 -> 2997;
	2995 [label="<RETRO_EMOJI_PUMPEDUP>",shape=box,color=blue];
		2995 -> 2997;
	2997 [label="但有一個孩子，總是被霸凌者盯上。總是。",shape=box,color=blue];
		2997 -> 2998;
	2998 [label="他們會唱一些針對那個孩子的惡意歌曲。糟糕、惡毒的歌。",shape=box,color=blue];
		2998 -> 2999;
	2999 [label="當我看到音樂被用來傷害別人時，作為孩子的我內心受到了很大的打擊。我不明白為什麼。",shape=box,color=blue];
		2999 -> 3000;
	3000 [label="我至今還不太明白。但我那時就知道，我可以不用揮拳也能反擊，即使這意味著讓自己出醜。",shape=box,color=blue];
		3000 -> 3001;
		3000 -> 3002;
	3001 [label="你做了什麼？",shape=box,color=red];
		3001 -> 3003;
	3002 [label="你讓自己出醜了嗎？",shape=box,color=red];
		3002 -> 3003;
	3003 [label="我唱得比那些霸凌者更大聲。那是一首愚蠢的歌，我甚至不記得它是怎麼唱的了。",shape=box,color=blue];
		3003 -> 3004;
	3004 [label="但它奏效了。",shape=box,color=blue];
		3004 -> 3005;
	3005 [label="然後當他們試圖霸凌我時，他們會朝我扔 CD，但你猜怎麼著？",shape=box,color=blue];
		3005 -> 3009;
		3005 -> 3006;
	3009 [label="那些 CD 是金屬做的嗎？",shape=box,color=red];
		3009 -> 3007;
	3006 [label="你把他們打倒了嗎？",shape=box,color=red];
		3006 -> 3007;
	3007 [label="哈哈，不是！我拿到了免費的音樂！小葵贏得勝利！",shape=box,color=blue];
		3007 -> 3008;
	3008 [label="我希望讓你知道，也希望在場的所有人知道，我會為你們唱得更加大聲。",shape=box,color=blue];
		3008 -> 3010;
	3010 [label="當然。",shape=box,color=blue];
		3010 -> 3011;
	3011 [label="Chat ends.",color=orange];
}