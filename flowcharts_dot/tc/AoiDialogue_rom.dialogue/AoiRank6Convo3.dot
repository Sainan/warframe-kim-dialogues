digraph {
	3899 [label="AoiRank6Convo3 begins.",color=orange];
		3899 -> 3900;
	3900 [label="問個問題",shape=box,color=blue];
		3900 -> 3901;
	3901 [label="你有一艘太空船",shape=box,color=blue];
		3901 -> 3902;
		3901 -> 3903;
		3901 -> 3904;
	3902 [label="然後呢？",shape=box,color=red];
		3902 -> 3905;
	3903 [label="我其實有好幾艘。",shape=box,color=red];
		3903 -> 3906;
	3904 [label="我有啊。 : )",shape=box,color=red];
		3904 -> 3905;
	3905 [label="它是怎麼在行星之間穿梭的？",shape=box,color=blue];
		3905 -> 3907;
	3906 [label="<RETRO_EMOJI_PASSGLASSES>",shape=box,color=blue];
		3906 -> 3908;
		3906 -> 3909;
	3907 [label="你有……超級火箭嗎？蟲洞？你是怎麼跨越這麼遠的距離？",shape=box,color=blue];
		3907 -> 3910;
	3908 [label="<RETRO_EMOJI_YUM>",shape=box,color=red];
		3908 -> 3911;
	3909 [label="<RETRO_EMOJI_SUNGLASSES>",shape=box,color=red];
		3909 -> 3912;
	3910 [label="還是有太陽帆？我父母一直在想辦法做這件事",shape=box,color=blue];
		3910 -> 3913;
		3910 -> 3914;
	3911 [label="<RETRO_EMOJI_STARE>",shape=box,color=blue];
		3911 -> 3915;
	3912 [label="+5 Chemistry",color=orange];
		3912 -> 3916;
	3913 [label="你不會喜歡那個答案。Orokin 打造出解決方法。",shape=box,color=red];
		3913 -> 3917;
	3914 [label="這個嘛，要看情況。你是指我的「大船」還是我的「小船」？",shape=box,color=red];
		3914 -> 3918;
	3915 [label="所以……",shape=box,color=blue];
		3915 -> 3919;
	3916 [label="哈哈 ^_^ 可是",shape=box,color=blue];
		3916 -> 3919;
	3917 [label="<RETRO_EMOJI_ANNOYED1>",shape=box,color=blue];
		3917 -> 3920;
	3918 [label="+5 Chemistry",color=orange];
		3918 -> 3921;
	3919 [label="它們怎麼在行星之間移動？",shape=box,color=blue];
		3919 -> 3907;
	3920 [label="嗯……我想沒有哪個社會是徹底敗壞的",shape=box,color=blue];
		3920 -> 3922;
	3921 [label="<RETRO_EMOJI_WHOA>",shape=box,color=blue];
		3921 -> 3923;
	3922 [label="是怎麼辦到的？",shape=box,color=blue];
		3922 -> 3924;
	3923 [label="兩種都是！先從大船開始！",shape=box,color=blue];
		3923 -> 3925;
	3924 [label="嗯，這取決於大船還是小船，但它們都利用虛空來跨越遙遠距離。它們都橫越虛空。",shape=box,color=red];
		3924 -> 3926;
	3925 [label="嗯，那是我的銳捷號。其中搭載了漠然的一根斷指複製品，也就是所謂的聖物驅動。",shape=box,color=red];
		3925 -> 3927;
	3926 [label="那艘叫銳捷號的大船，利用一種叫聖物驅動的東西，其中搭載了漠然的一根斷指複製品。",shape=box,color=red];
		3926 -> 3928;
	3927 [label="它利用那個裝置來進入虛空，跨越行星之間的遙遠距離。這樣就穿越虛空了。",shape=box,color=red];
		3927 -> 3928;
	3928 [label="<RETRO_EMOJI_OHNO>",shape=box,color=blue];
		3928 -> 3929;
	3929 [label="不好意思",shape=box,color=blue];
		3929 -> 3930;
	3930 [label="什麼",shape=box,color=blue];
		3930 -> 3931;
		3930 -> 3932;
	3931 [label="太懶解釋：阿爾布雷希特進入虛空，慌了，最後偷走了漠然的斷指。",shape=box,color=red];
		3931 -> 3933;
	3932 [label="嗯。好吧。所以。阿爾布雷希特……是第一個「發現」怎麼進入虛空的人。",shape=box,color=red];
		3932 -> 3934;
	3933 [label="首先，什麼是……太懶解釋：？",shape=box,color=blue];
		3933 -> 3935;
	3934 [label="那東西類似個潛水鐘。用一種叫做色璃的東西製成。他就這樣撐開了界域之間的薄膜。",shape=box,color=red];
		3934 -> 3936;
	3935 [label="太長懶得解釋的縮寫。崑西教我的。",shape=box,color=red];
		3935 -> 3937;
	3936 [label="輕描淡寫地說，事情……出了問題。他慌了，失衡了，那東西傾倒了，撞到了薄膜的銳利邊緣。",shape=box,color=red];
		3936 -> 3938;
	3937 [label="蛤……",shape=box,color=blue];
		3937 -> 3939;
	3938 [label="色璃艙鐘碎了，他掉進了虛空。",shape=box,color=red];
		3938 -> 3940;
	3939 [label="其次",shape=box,color=blue];
		3939 -> 3941;
	3940 [label="當他醒來時，他回到了自己的實驗室，只是那不是他的實驗室。他凝視著自己。只是那不是他自己。而且「他」用了一個只有他母親才知道的名字來自稱。",shape=box,color=red];
		3940 -> 3942;
	3941 [label="你有那個「人」的手指？！",shape=box,color=blue];
		3941 -> 3943;
	3942 [label="於是，阿爾布雷希特趕緊逃命。他被色璃碎片刮傷了，就用自己的鮮血寫給他女兒，要她關閉他身後的薄膜──",shape=box,color=red];
		3942 -> 3944;
	3943 [label="而且你利用斷指來驅動你的銳捷號？！",shape=box,color=blue];
		3943 -> 3945;
	3944 [label="──因為他可以感覺到那個「人」正想要伸手抓他。",shape=box,color=red];
		3944 -> 3946;
	3945 [label="<RETRO_EMOJI_HORRIFIED>",shape=box,color=blue];
		3945 -> 3947;
	3946 [label="她照做了。而當薄膜關上時，嗯……那個「人」的手指被截斷，掉在了地板上。",shape=box,color=red];
		3946 -> 3948;
	3947 [label="難怪那個「人」會抓狂！",shape=box,color=blue];
		3947 -> 3949;
		3947 -> 3950;
	3948 [label="……哇哦……",shape=box,color=blue];
		3948 -> 3951;
	3949 [label="斷指能夠驅動的遠不止銳捷號，這就是問題所在……",shape=box,color=red];
		3949 -> 3952;
	3950 [label="大概吧。",shape=box,color=red];
		3950 -> 3953;
	3951 [label="首先：不可思議的故事……",shape=box,color=blue];
		3951 -> 3954;
	3952 [label="哦……",shape=box,color=blue];
		3952 -> 3955;
		3952 -> 3956;
	3953 [label="難道你就不能把斷指還回去嗎？！",shape=box,color=blue];
		3953 -> 3955;
		3953 -> 3956;
	3954 [label="其次",shape=box,color=blue];
		3954 -> 3941;
	3955 [label="我……不知道斷指在哪裡。",shape=box,color=red];
		3955 -> 3957;
	3956 [label="我不知道這是不是個好主意？",shape=box,color=red];
		3956 -> 3957;
	3957 [label="但斷指被偷走了……",shape=box,color=blue];
		3957 -> 3958;
		3957 -> 3959;
	3958 [label="即使我們知道斷指在哪裡，我都不知道我們究竟應不應該把斷指還回去。",shape=box,color=red];
		3958 -> 3960;
	3959 [label="我知道。這也令我感到不安。",shape=box,color=red];
		3959 -> 3961;
	3960 [label="你是什麼意思？",shape=box,color=blue];
		3960 -> 3962;
		3960 -> 3963;
	3961 [label="但不幸的是，傷害已經造成了。阿爾布雷希特拿走了斷指。現在已經沒有回頭路了。",shape=box,color=red];
		3961 -> 3960;
	3962 [label="是關於「Khra 的縷流」。這件事超複雜。不知道欸，好像要……",shape=box,color=red];
		3962 -> 3964;
	3963 [label="我不知道把斷指還回去有沒有用。我不認為這樣能夠改變那個「人」的想法。",shape=box,color=red];
		3963 -> 3965;
	3964 [label="把那東西束縛在這裡，讓它困在我們的管控範圍內。我們有它的斷指，所以它只能按照我們定下的規則行事。",shape=box,color=red];
		3964 -> 3966;
	3965 [label="我覺得傷害已經造成了。",shape=box,color=red];
		3965 -> 3966;
	3966 [label="……聽起來就令人感到不安",shape=box,color=blue];
		3966 -> 3967;
	3967 [label="太空旅行本該是……有趣、酷炫、充滿……探索，以及認識新物種",shape=box,color=blue];
		3967 -> 3968;
	3968 [label="勇闖未知領域什麼的，阿米爾的某個影集裡有篇完整的演講",shape=box,color=blue];
		3968 -> 3969;
	3969 [label="但這本來應該是關於……人性、同理心、學習和冒險",shape=box,color=blue];
		3969 -> 3970;
	3970 [label="而不是像……這樣",shape=box,color=blue];
		3970 -> 3971;
		3970 -> 3972;
	3971 [label="我想，這很難說。時間自有分曉。",shape=box,color=red];
		3971 -> 3973;
	3972 [label="有時候我不禁想，這不就是源拓氏在做的事嗎？把我送回這裡。遇見你們所有人。",shape=box,color=red];
		3972 -> 3974;
	3973 [label="<RETRO_EMOJI_GIVELOVE>",shape=box,color=blue];
		3973 -> 3975;
	3974 [label="或者送往別處，去幫助……救助人們。",shape=box,color=red];
		3974 -> 3976;
	3975 [label="是的，無論如何，時間都會作答",shape=box,color=blue];
		3975 -> 3977;
	3976 [label="即使是為了收拾他留下的爛攤子，從某種意義上來說，這也正是為了把那份情感帶來給宇宙。也就是你所謂的那個同理心。",shape=box,color=red];
		3976 -> 3978;
	3977 [label="那麼，接下來你想聽有關星際航道的事嗎？",shape=box,color=red];
		3977 -> 3979;
	3978 [label="但我只能希望，這一切就是最終的意義所在。而我可不想當那個拿著拖把水桶追著瘋子到處跑的人。",shape=box,color=red];
		3978 -> 3980;
	3979 [label="哈哈，不了",shape=box,color=blue];
		3979 -> 3981;
	3980 [label="+5 Chemistry",color=orange];
		3980 -> 3982;
	3981 [label="Chat ends.",color=orange];
	3982 [label="好吧，如果那是你要做的事，我會陪你一起做！",shape=box,color=blue];
		3982 -> 3983;
	3983 [label="<RETRO_EMOJI_TWOHUGS>",shape=box,color=blue];
		3983 -> 3984;
	3984 [label="我們是擦屁雙寶，哈哈",shape=box,color=blue];
		3984 -> 3985;
	3985 [label="但……我希望你是對的。我希望最終，這是為了重建我們失去的一切",shape=box,color=blue];
		3985 -> 3986;
	3986 [label="不然，又有什麼意義呢？",shape=box,color=blue];
		3986 -> 3977;
}