digraph {
	"AoiRank6Convo3 begins." [color=orange];
		"AoiRank6Convo3 begins." -> j207738993;
	j207738993 [label="問個問題",shape=box,color=blue];
		j207738993 -> j3946965972;
	j3946965972 [label="你有一艘太空船",shape=box,color=blue];
		j3946965972 -> j2687309686;
		j3946965972 -> j2637263696;
		j3946965972 -> j2449205440;
	j2687309686 [label="然後呢？",shape=box,color=red];
		j2687309686 -> j2978168879;
	j2637263696 [label="我其實有好幾艘。",shape=box,color=red];
		j2637263696 -> j3022734469;
	j2449205440 [label="我有啊。 : )",shape=box,color=red];
		j2449205440 -> j2978168879;
	j2978168879 [label="它是怎麼在行星之間穿梭的？",shape=box,color=blue];
		j2978168879 -> j2779074299;
	j3022734469 [label="<RETRO_EMOJI_PASSGLASSES>",shape=box,color=blue];
		j3022734469 -> j2257788373;
		j3022734469 -> j3896061255;
	j2779074299 [label="你有……超級火箭嗎？蟲洞？你是怎麼跨越這麼遠的距離？",shape=box,color=blue];
		j2779074299 -> j2692287639;
	j2257788373 [label="<RETRO_EMOJI_YUM>",shape=box,color=red];
		j2257788373 -> j4243337604;
	j3896061255 [label="<RETRO_EMOJI_SUNGLASSES>",shape=box,color=red];
		j3896061255 -> j1304447229;
	j2692287639 [label="還是有太陽帆？我父母一直在想辦法做這件事",shape=box,color=blue];
		j2692287639 -> j2846805873;
		j2692287639 -> j255472062;
	j4243337604 [label="<RETRO_EMOJI_STARE>",shape=box,color=blue];
		j4243337604 -> j1993040673;
	j1304447229 [label="+5 Chemistry",color=orange];
		j1304447229 -> j1579722241;
	j2846805873 [label="你不會喜歡那個答案。Orokin 打造出解決方法。",shape=box,color=red];
		j2846805873 -> j2543068321;
	j255472062 [label="這個嘛，要看情況。你是指我的「大船」還是我的「小船」？",shape=box,color=red];
		j255472062 -> j120979519;
	j1993040673 [label="所以……",shape=box,color=blue];
		j1993040673 -> j2209099311;
	j1579722241 [label="哈哈 ^_^ 可是",shape=box,color=blue];
		j1579722241 -> j2209099311;
	j2543068321 [label="<RETRO_EMOJI_ANNOYED1>",shape=box,color=blue];
		j2543068321 -> j2666438026;
	j120979519 [label="+5 Chemistry",color=orange];
		j120979519 -> j3637655900;
	j2209099311 [label="它們怎麼在行星之間移動？",shape=box,color=blue];
		j2209099311 -> j2779074299;
	j2666438026 [label="嗯……我想沒有哪個社會是徹底敗壞的",shape=box,color=blue];
		j2666438026 -> j3881392982;
	j3637655900 [label="<RETRO_EMOJI_WHOA>",shape=box,color=blue];
		j3637655900 -> j687060962;
	j3881392982 [label="是怎麼辦到的？",shape=box,color=blue];
		j3881392982 -> j2115808384;
	j687060962 [label="兩種都是！先從大船開始！",shape=box,color=blue];
		j687060962 -> j1074657672;
	j2115808384 [label="嗯，這取決於大船還是小船，但它們都利用虛空來跨越遙遠距離。它們都橫越虛空。",shape=box,color=red];
		j2115808384 -> j374259630;
	j1074657672 [label="嗯，那是我的銳捷號。其中搭載了漠然的一根斷指複製品，也就是所謂的聖物驅動。",shape=box,color=red];
		j1074657672 -> j4092820625;
	j374259630 [label="那艘叫銳捷號的大船，利用一種叫聖物驅動的東西，其中搭載了漠然的一根斷指複製品。",shape=box,color=red];
		j374259630 -> j3373172411;
	j4092820625 [label="它利用那個裝置來進入虛空，跨越行星之間的遙遠距離。這樣就穿越虛空了。",shape=box,color=red];
		j4092820625 -> j3373172411;
	j3373172411 [label="<RETRO_EMOJI_OHNO>",shape=box,color=blue];
		j3373172411 -> j4048394470;
	j4048394470 [label="不好意思",shape=box,color=blue];
		j4048394470 -> j174112199;
	j174112199 [label="什麼",shape=box,color=blue];
		j174112199 -> j1700591155;
		j174112199 -> j2084535892;
	j1700591155 [label="太懶解釋：阿爾布雷希特進入虛空，慌了，最後偷走了漠然的斷指。",shape=box,color=red];
		j1700591155 -> j2612904951;
	j2084535892 [label="嗯。好吧。所以。阿爾布雷希特……是第一個「發現」怎麼進入虛空的人。",shape=box,color=red];
		j2084535892 -> j819797317;
	j2612904951 [label="首先，什麼是……太懶解釋：？",shape=box,color=blue];
		j2612904951 -> j2443918647;
	j819797317 [label="那東西類似個潛水鐘。用一種叫做色璃的東西製成。他就這樣撐開了界域之間的薄膜。",shape=box,color=red];
		j819797317 -> j3503142494;
	j2443918647 [label="太長懶得解釋的縮寫。崑西教我的。",shape=box,color=red];
		j2443918647 -> j3519260958;
	j3503142494 [label="輕描淡寫地說，事情……出了問題。他慌了，失衡了，那東西傾倒了，撞到了薄膜的銳利邊緣。",shape=box,color=red];
		j3503142494 -> j747372261;
	j3519260958 [label="蛤……",shape=box,color=blue];
		j3519260958 -> j3447897396;
	j747372261 [label="色璃艙鐘碎了，他掉進了虛空。",shape=box,color=red];
		j747372261 -> j2473185500;
	j3447897396 [label="其次",shape=box,color=blue];
		j3447897396 -> j659006298;
	j2473185500 [label="當他醒來時，他回到了自己的實驗室，只是那不是他的實驗室。他凝視著自己。只是那不是他自己。而且「他」用了一個只有他母親才知道的名字來自稱。",shape=box,color=red];
		j2473185500 -> j2554353643;
	j659006298 [label="你有那個「人」的手指？！",shape=box,color=blue];
		j659006298 -> j3077046628;
	j2554353643 [label="於是，阿爾布雷希特趕緊逃命。他被色璃碎片刮傷了，就用自己的鮮血寫給他女兒，要她關閉他身後的薄膜──",shape=box,color=red];
		j2554353643 -> j2560495737;
	j3077046628 [label="而且你利用斷指來驅動你的銳捷號？！",shape=box,color=blue];
		j3077046628 -> j2515682907;
	j2560495737 [label="──因為他可以感覺到那個「人」正想要伸手抓他。",shape=box,color=red];
		j2560495737 -> j2158974137;
	j2515682907 [label="<RETRO_EMOJI_HORRIFIED>",shape=box,color=blue];
		j2515682907 -> j1998664974;
	j2158974137 [label="她照做了。而當薄膜關上時，嗯……那個「人」的手指被截斷，掉在了地板上。",shape=box,color=red];
		j2158974137 -> j2717159823;
	j1998664974 [label="難怪那個「人」會抓狂！",shape=box,color=blue];
		j1998664974 -> j4121989734;
		j1998664974 -> j4222725939;
	j2717159823 [label="……哇哦……",shape=box,color=blue];
		j2717159823 -> j3550277783;
	j4121989734 [label="斷指能夠驅動的遠不止銳捷號，這就是問題所在……",shape=box,color=red];
		j4121989734 -> j1194954568;
	j4222725939 [label="大概吧。",shape=box,color=red];
		j4222725939 -> j1061810357;
	j3550277783 [label="首先：不可思議的故事……",shape=box,color=blue];
		j3550277783 -> j3447897396;
	j1194954568 [label="哦……",shape=box,color=blue];
		j1194954568 -> j1061810357;
	j1061810357 [label="難道你就不能把斷指還回去嗎？！",shape=box,color=blue];
		j1061810357 -> j3974292567;
		j1061810357 -> j3689541924;
	j3974292567 [label="我……不知道斷指在哪裡。",shape=box,color=red];
		j3974292567 -> j1344511873;
	j3689541924 [label="我不知道這是不是個好主意？",shape=box,color=red];
		j3689541924 -> j1344511873;
	j1344511873 [label="但斷指被偷走了……",shape=box,color=blue];
		j1344511873 -> j1663632300;
		j1344511873 -> j3137382499;
	j1663632300 [label="即使我們知道斷指在哪裡，我都不知道我們究竟應不應該把斷指還回去。",shape=box,color=red];
		j1663632300 -> j326453670;
	j3137382499 [label="我知道。這也令我感到不安。",shape=box,color=red];
		j3137382499 -> j1772120096;
	j326453670 [label="你是什麼意思？",shape=box,color=blue];
		j326453670 -> j2737326354;
		j326453670 -> j2072434377;
	j1772120096 [label="但不幸的是，傷害已經造成了。阿爾布雷希特拿走了斷指。現在已經沒有回頭路了。",shape=box,color=red];
		j1772120096 -> j326453670;
	j2737326354 [label="是關於「Khra 的縷流」。這件事超複雜。不知道欸，好像要……",shape=box,color=red];
		j2737326354 -> j1172457320;
	j2072434377 [label="我不知道把斷指還回去有沒有用。我不認為這樣能夠改變那個「人」的想法。",shape=box,color=red];
		j2072434377 -> j1334822853;
	j1172457320 [label="把那東西束縛在這裡，讓它困在我們的管控範圍內。我們有它的斷指，所以它只能按照我們定下的規則行事。",shape=box,color=red];
		j1172457320 -> j2428840710;
	j1334822853 [label="我覺得傷害已經造成了。",shape=box,color=red];
		j1334822853 -> j2428840710;
	j2428840710 [label="……聽起來就令人感到不安",shape=box,color=blue];
		j2428840710 -> j1286571561;
	j1286571561 [label="太空旅行本該是……有趣、酷炫、充滿……探索，以及認識新物種",shape=box,color=blue];
		j1286571561 -> j3337109821;
	j3337109821 [label="勇闖未知領域什麼的，阿米爾的某個影集裡有篇完整的演講",shape=box,color=blue];
		j3337109821 -> j2474396198;
	j2474396198 [label="但這本來應該是關於……人性、同理心、學習和冒險",shape=box,color=blue];
		j2474396198 -> j3897083052;
	j3897083052 [label="而不是像……這樣",shape=box,color=blue];
		j3897083052 -> j1292224430;
		j3897083052 -> j3593748119;
	j1292224430 [label="我想，這很難說。時間自有分曉。",shape=box,color=red];
		j1292224430 -> j65256125;
	j3593748119 [label="有時候我不禁想，這不就是源拓氏在做的事嗎？把我送回這裡。遇見你們所有人。",shape=box,color=red];
		j3593748119 -> j67571618;
	j65256125 [label="<RETRO_EMOJI_GIVELOVE>",shape=box,color=blue];
		j65256125 -> j1040405168;
	j67571618 [label="或者送往別處，去幫助……救助人們。",shape=box,color=red];
		j67571618 -> j1783203611;
	j1040405168 [label="是的，無論如何，時間都會作答",shape=box,color=blue];
		j1040405168 -> j1944233028;
	j1783203611 [label="即使是為了收拾他留下的爛攤子，從某種意義上來說，這也正是為了把那份情感帶來給宇宙。也就是你所謂的那個同理心。",shape=box,color=red];
		j1783203611 -> j1071706895;
	j1944233028 [label="那麼，接下來你想聽有關星際航道的事嗎？",shape=box,color=red];
		j1944233028 -> j1189716771;
	j1071706895 [label="但我只能希望，這一切就是最終的意義所在。而我可不想當那個拿著拖把水桶追著瘋子到處跑的人。",shape=box,color=red];
		j1071706895 -> j680755029;
	j1189716771 [label="哈哈，不了",shape=box,color=blue];
		j1189716771 -> "Chat ends.";
	j680755029 [label="+5 Chemistry",color=orange];
		j680755029 -> j1413474232;
	"Chat ends." [color=orange];
	j1413474232 [label="好吧，如果那是你要做的事，我會陪你一起做！",shape=box,color=blue];
		j1413474232 -> j4248426732;
	j4248426732 [label="<RETRO_EMOJI_TWOHUGS>",shape=box,color=blue];
		j4248426732 -> j2987471579;
	j2987471579 [label="我們是擦屁雙寶，哈哈",shape=box,color=blue];
		j2987471579 -> j1913218236;
	j1913218236 [label="但……我希望你是對的。我希望最終，這是為了重建我們失去的一切",shape=box,color=blue];
		j1913218236 -> j1690988949;
	j1690988949 [label="不然，又有什麼意義呢？",shape=box,color=blue];
		j1690988949 -> j1944233028;
}