digraph {
	3372 [label="AoiRank5Convo3 begins.",color=orange];
		3372 -> 3373;
		3372 -> 3374;
	3373 [label="你一定是六煞幫裡最強的英雄了。我的意思是，考慮到這裡每個人身上都有部分金屬化了，這裡絕對沒有人能招惹你。",shape=box,color=red];
		3373 -> 3375;
	3374 [label="我一直在想，在整個團隊中，你總是本能地去關心他人，這讓你成為我們當中最像英雄的人。",shape=box,color=red];
		3374 -> 3376;
	3375 [label="哈哈",shape=box,color=blue];
		3375 -> 3378;
	3376 [label="+5 Chemistry",color=orange];
		3376 -> 3377;
	3378 [label="你聽起來真像阿米爾",shape=box,color=blue];
		3378 -> 3380;
		3378 -> 3379;
		3378 -> 3381;
		3378 -> 3382;
	3377 [label="<3",shape=box,color=blue];
		3377 -> 3378;
	3380 [label="這是我人生中第一次聽到這種話。",shape=box,color=red];
		3380 -> 3383;
	3379 [label="謝謝你的讚美。為什麼這麼說？",shape=box,color=red];
		3379 -> 3384;
	3381 [label="真的嗎？為什麼會這麼覺得？",shape=box,color=red];
		3381 -> 3386;
	3382 [label="這是一種讚美嗎？",shape=box,color=red];
		3382 -> 3385;
	3383 [label="真的嗎？但你們兩個真的很像 ;)",shape=box,color=blue];
		3383 -> 3386;
	3384 [label="+5 Chemistry",color=orange];
		3384 -> 3386;
	3386 [label="只是當阿米爾剛加入六煞幫時，他總是開玩笑說我是超級英雄",shape=box,color=blue];
		3386 -> 3387;
	3385 [label="當然是啦！",shape=box,color=blue];
		3385 -> 3386;
	3387 [label="……而他是我的助手",shape=box,color=blue];
		3387 -> 3388;
	3388 [label="那真的很可愛但又有點讓人難過",shape=box,color=blue];
		3388 -> 3390;
		3388 -> 3389;
		3388 -> 3391;
	3390 [label="這挺讓人驚訝的，因為阿米爾看起來總是那麼自信。",shape=box,color=red];
		3390 -> 3392;
	3389 [label="助手，嗯？這可不像我認識的阿米爾。是不是有什麼改變了？",shape=box,color=red];
		3389 -> 3392;
	3391 [label="難過？我以為你們兩個很親近。",shape=box,color=red];
		3391 -> 3393;
	3392 [label="這需要時間。阿米爾剛加入的時候完全沒有軍事經驗，所以戰鬥對他來說太困難了",shape=box,color=blue];
		3392 -> 3394;
	3393 [label="哦，我們當然親近啦！阿米爾是我最好的朋友。我最喜歡的回憶就是我們一起在街機廳玩遊戲、聽線上男孩的歌",shape=box,color=blue];
		3393 -> 3395;
	3394 [label="他只是需要去明白成為英雄並不全是關於戰鬥的",shape=box,color=blue];
		3394 -> 3396;
	3395 [label="但關於「助手」這件事？我能感覺到他覺得……自己很渺小。",shape=box,color=blue];
		3395 -> 3396;
	3396 [label="我一直知道，像他這麼厲害的駭客完全可以以自己的方式成為英雄。",shape=box,color=blue];
		3396 -> 3399;
		3396 -> 3397;
	3399 [label="那對他來說有什麼改變了？他現在看起來一點也不像任何人的助手了。",shape=box,color=red];
		3399 -> 3398;
	3397 [label="而你在幫助他明白這一點上起了很大作用，不是嗎？",shape=box,color=red];
		3397 -> 3398;
	3398 [label="我不能把所有功勞都歸給自己，但我確實在他嘗試突破自己時陪著他。",shape=box,color=blue];
		3398 -> 3400;
	3400 [label="有一天，我看到了一位線上男孩粉絲的瘋狂廣播，她拼湊出關於主打曲音樂（也就是線上男孩所屬的唱片公司）的可疑細節",shape=box,color=blue];
		3400 -> 3402;
	3402 [label="她幾乎是在哀求有人能幫助他們，而阿米爾毫不猶豫地站了出來",shape=box,color=blue];
		3402 -> 3401;
		3402 -> 3403;
		3402 -> 3404;
	3401 [label="阿米爾是怎麼捲進這種事的？",shape=box,color=red];
		3401 -> 3405;
	3403 [label="阿米爾？我本來以為你會是那個跑去救線上男孩的人。",shape=box,color=red];
		3403 -> 3406;
	3404 [label="這聽起來就像傳說中的葵－阿米爾組合啊！",shape=box,color=red];
		3404 -> 3407;
	3405 [label="我是給他看了那個廣播，剩下的都是阿米爾搞定的！",shape=box,color=blue];
		3405 -> 3409;
	3406 [label="嗯，其實這是一場團隊合作。你可以說我是他的助手 ^_^",shape=box,color=blue];
		3406 -> 3409;
	3407 [label="+5 Chemistry",color=orange];
		3407 -> 3408;
	3409 [label="他駭進了他們經理人的郵件，揭露了一堆和清剿隊交易的爛攤子。他們一直在複製樂隊並讓他們陷入危險，而這一切都被管理層掩蓋了",shape=box,color=blue];
		3409 -> 3410;
	3408 [label="超級粉絲和超級駭客聯手？當然沒有什麼能夠阻止我們！",shape=box,color=blue];
		3408 -> 3409;
	3410 [label="噁心！",shape=box,color=blue];
		3410 -> 3411;
	3411 [label="如果沒有阿米爾的技能，這一切都不會曝光",shape=box,color=blue];
		3411 -> 3412;
		3411 -> 3413;
	3412 [label="哇，太難以置信了。阿米爾真的揭露了這一切嗎？",shape=box,color=red];
		3412 -> 3414;
	3413 [label="你知道嗎，如果知識就是力量，那駭客的力量真的很強大。",shape=box,color=red];
		3413 -> 3414;
	3414 [label="當然啦！整個過程完全讓他意識到他不只是個助手，他也是一個英雄，有他自己的價值 ^_^",shape=box,color=blue];
		3414 -> 3416;
		3414 -> 3415;
	3416 [label="而且你們現在還可以一起去街機廳玩",shape=box,color=red];
		3416 -> 3417;
	3415 [label="好像這一點從來就沒什麼疑問似的。",shape=box,color=red];
		3415 -> 3418;
	3417 [label="兩個英雄都要放鬆一下嘛！",shape=box,color=blue];
		3417 -> 3419;
	3418 [label="對吧？",shape=box,color=blue];
		3418 -> 3419;
	3419 [label="你知道的，你也是個英雄 <3",shape=box,color=blue];
		3419 -> 3421;
		3419 -> 3420;
		3419 -> 3422;
	3421 [label="這句話由你說出來，這對我意義重大。",shape=box,color=red];
		3421 -> 3423;
	3420 [label="聽到這句話讓我感覺特別好。",shape=box,color=red];
		3420 -> 3424;
	3422 [label="你這個迷人鬼。",shape=box,color=red];
