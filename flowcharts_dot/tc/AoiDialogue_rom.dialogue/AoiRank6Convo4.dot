	4005 [label="外加在她身上發生的一切事",shape=box,color=blue];
		4005 -> 4007;
	4006 [label="它就像一場夢。有時候我還會做關於它的噩夢，你知道嗎？但每當我醒來時，一切又都會消失，而且每個人都還在這裡",shape=box,color=blue];
