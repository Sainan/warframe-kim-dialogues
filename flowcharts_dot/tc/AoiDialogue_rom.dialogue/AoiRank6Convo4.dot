		4008 -> 4010;
	4009 [label="如果她不想喜歡我，那樣才完全沒毛病，哈哈",shape=box,color=blue];
		4009 -> 4011;
	4010 [label="我還在危應部隊時失去了很多朋友……真的非常多。但當你參戰時就該知道這種事必然發生",shape=box,color=blue];
		4010 -> 4012;
