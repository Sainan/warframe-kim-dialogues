	4002 [label="<RETRO_EMOJI_TWOHUGS>",shape=box,color=blue];
		4002 -> 4004;
	4003 [label="我在那個年齡根本不知道自己是誰。完全沒頭緒。完全迷失。做的就只是試著成為我以為別人希望我成為的那種人",shape=box,color=blue];
