	j1185443153 [label="好的，沒問題。回頭見。",shape=box,color=blue];
		j1185443153 -> "Chat ends.";
	j1619647296 [label="好的，沒問題。",shape=box,color=blue];
		j1619647296 -> j93530622;
	j1760146713 [label="你知道我的故事的開頭，但有部分我沒告訴你。",shape=box,color=blue];
		j1760146713 -> j3259701890;
	j2432268382 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j2432268382 -> j1777168819;
	j177973906 [label="雖然這樣會傷害他，但這也是他的一部分。而如果你帶著憤怒並且很嚴厲地接近他，他甚至會躲開你的觸碰。",shape=box,color=blue];
		j177973906 -> j3435845501;
	j3259701890 [label="我告訴過你，我小時候在街頭乞討。而我做得還不錯，也交了很多朋友。",shape=box,color=blue];
		j3259701890 -> j3942536381;
	j1777168819 [label="我誕生於富裕家庭，這可能會讓你驚訝。資產階級，和 Orokin 階層相去不遠。",shape=box,color=blue];
		j1777168819 -> j3408662588;
	j3435845501 [label="你得贏得流浪狗的信任。讓牠自己來找你，對不？這麼說有道理嗎？",shape=box,color=blue];
		j3435845501 -> j3966871378;
		j3435845501 -> j4256670912;
		j3435845501 -> j3835682005;
	j3942536381 [label="其中一個是名叫雨果的大男孩。",shape=box,color=blue];
		j3942536381 -> j476120736;
	j3408662588 [label="然而，我一出生就是這樣……畸形，雙腳扭曲不聽使喚？哦，我母親無法接受。",shape=box,color=blue];
		j3408662588 -> j187284800;
	j3966871378 [label="其實，有的。謝謝。",shape=box,color=red];
		j3966871378 -> j3884747102;
	j4256670912 [label="超出我的預期，謝謝。",shape=box,color=red];
		j4256670912 -> j309608913;
	j3835682005 [label="沒有。但至少有試，謝謝。",shape=box,color=red];
		j3835682005 -> j1373468495;
	j476120736 [label="他有點算是我們那群的孩子王。他總是確保沒人敢欺負我而且什麼都不缺。",shape=box,color=blue];
		j476120736 -> j103651658;
	j187284800 [label="有形象必須維護，對吧？有水準必須保持。",shape=box,color=blue];
		j187284800 -> j919823525;
	j3884747102 [label="好的！我還怕我的比喻又扯遠了。",shape=box,color=blue];
		j3884747102 -> j1645949330;
	j309608913 [label="Marie 和她的比喻。嗯，好吧。",shape=box,color=blue];
		j309608913 -> j1645949330;
	j1373468495 [label="哎呀，我就知道我的比喻又扯遠了。",shape=box,color=blue];
		j1373468495 -> j1645949330;
	j103651658 [label="他甚至還用我們撿來的木頭幫我做了腋杖，你們可能叫它……呃……拐杖吧？我可以用它來拖著自己走動。",shape=box,color=blue];
		j103651658 -> j1786588528;
	j919823525 [label="那麼，該拿可憐的畸形瑪麗怎麼辦？於是我就被帶到了光之城，在那裡我肯定會死在街頭……",shape=box,color=blue];
		j919823525 -> j2326854285;
	j1645949330 [label="嗯。我突然想到，或許把里昂比作流浪狗不是最恰當的比喻……",shape=box,color=blue];
		j1645949330 -> j1514171162;
	j1786588528 [label="有天早上，我們去叫他起床，結果發現他──",shape=box,color=blue];
		j1786588528 -> j3537400306;
	j2326854285 [label="然後被遺棄，自生自滅。",shape=box,color=blue];
		j2326854285 -> j2372290559;
		j2326854285 -> j3070180742;
	j1514171162 [label="或許，不要告訴他我有這麼做過，好嗎……？",shape=box,color=blue];
		j1514171162 -> j1672678032;
	j3537400306 [label="我……我就不說細節了……我相信你也能猜到。",shape=box,color=blue];
		j3537400306 -> j1429460539;
	j2372290559 [label="你當時幾歲？",shape=box,color=red];
		j2372290559 -> j473199957;
	j3070180742 [label="你的家人拋棄你，任你自生自滅？",shape=box,color=red];
		j3070180742 -> j1763356579;
	j1672678032 [label="Boolean LyonStrayDog is now true.",color=orange];
		j1672678032 -> j782300043;
		j1672678032 -> j3667802752;
	j1429460539 [label="但他給我們留了張紙條。字跡潦草得幾乎看不清。在其他孩子中唯有他認識字，而我得讀給其他人聽。",shape=box,color=blue];
		j1429460539 -> j3627417405;
	j473199957 [label="六歲？還是七歲？在他們眼裡，已經花了多年在盡力矯正我。請家庭教師教我行走，穿戴肢架，特製鞋具。",shape=box,color=blue];
		j473199957 -> j2787532270;
	j1763356579 [label="在他們眼裡，已經花了多年在盡力矯正我。請家庭教師教我行走，穿戴肢架，特製鞋具。",shape=box,color=blue];
		j1763356579 -> j2787532270;
	j782300043 [label="我覺得很可愛，他肯定也會這麼覺得。",shape=box,color=red];
		j782300043 -> j1787867479;
	j3667802752 [label="我會幫你保守秘密。",shape=box,color=red];
		j3667802752 -> j3402321672;
	j3627417405 [label="我至今仍記得自己當時讀到哽咽。但我必須堅強。因為即使在那時，我就知道自己對他人有責任。",shape=box,color=blue];
		j3627417405 -> j376669374;
	j2787532270 [label="他們厭倦了這種負擔。於是，連數字和字母幾乎都不會讀寫的我，發現自己淪落街頭。",shape=box,color=blue];
		j2787532270 -> j1697148888;
		j2787532270 -> j139718919;
	j1787867479 [label="（法語）真是可怕的人！我希望你的椅子塌掉，讓你渾身插滿刺！",shape=box,color=blue];
		j1787867479 -> "Chat ends.";
	j3402321672 [label="謝謝！真是鬆了口氣……",shape=box,color=blue];
		j3402321672 -> "Chat ends.";
	j376669374 [label="他們對我說，雨果在我們眼裡總是看起來很開心。非常開朗。總是帶著歡笑和嘲諷面對生活。",shape=box,color=blue];
		j376669374 -> j1711069871;
	j1697148888 [label="好可怕喔。",shape=box,color=red];
		j1697148888 -> j714426695;
	j139718919 [label="你是怎麼活下來的？",shape=box,color=red];
		j139718919 -> j714426695;
	j1711069871 [label="即使我們遭到驅趕，或他因為偷竊或遊蕩而被棍棒毆打，這些似乎都絲毫影響不了他。",shape=box,color=blue];
		j1711069871 -> j3011042107;
	j714426695 [label="Check boolean MarieSecretPower",color=orange];
		j714426695 -> j2796200203 [label=true,color=green];
		j714426695 -> j2450969896 [label=false,color=brown];
	j3011042107 [label="但我們永遠無法知道他人心中的痛到底有多痛。而在那封信裡，我知道他和太陰一起哭泣了。",shape=box,color=blue];
		j3011042107 -> j2728033629;
	j2796200203 [label="就像你說的，所有的不便都蘊含神秘力量，對不？",shape=box,color=blue];
		j2796200203 -> j2450969896;
	j2450969896 [label="在母親眼中，讓我不受待見的缺陷，反而讓我在街頭的孩子眼中頗受歡迎。",shape=box,color=blue];
		j2450969896 -> j1097392896;
	j2728033629 [label="但他現在在她身邊安息了。有段時間，我怨恨他離開，因為其他人都指望我給出指引。而我怨恨他拋下我。",shape=box,color=blue];
		j2728033629 -> j261165061;
	j1097392896 [label="還有什麼比一個沒有雙腳的孩子更可憐的呢，對吧？我光是伸手乞討一天，就能賺得比他們一週偷搶來的還多。",shape=box,color=blue];
		j1097392896 -> j4056732786;
	j261165061 [label="但隨著時間的推移，我逐漸明白了其中的真相。",shape=box,color=blue];
		j261165061 -> j3800539930;
	j4056732786 [label="而我向來樂於分享。所以我有很多朋友會照顧和保護我。其中一個是名叫雨果的大男孩。",shape=box,color=blue];
		j4056732786 -> j476120736;
	j3800539930 [label="我們只能原諒身為人的自己。原諒他們離去所帶來的痛苦從而放過自己。",shape=box,color=blue];
		j3800539930 -> j2509287699;
	j2509287699 [label="我們會感到痛苦是因為他們不在了，而且想到我們沒能為他們做更多來幫助他們。",shape=box,color=blue];
		j2509287699 -> j2520361282;
	j2520361282 [label="他人背負的重擔，我們永遠都無法感同身受。",shape=box,color=blue];
		j2520361282 -> j3856048667;
	j3856048667 [label="而這是個天大的悲劇。但這正是身為人的意義所在。",shape=box,color=blue];
		j3856048667 -> j3859237120;
	j3859237120 [label="我不知道這個故事有沒有幫到你。但我只能祈禱它有用。我得走了，Loid 先生在找。",shape=box,color=blue];
		j3859237120 -> j3496991265;
		j3859237120 -> j2441136841;
	j3496991265 [label="瑪麗，謝謝。",shape=box,color=red];
