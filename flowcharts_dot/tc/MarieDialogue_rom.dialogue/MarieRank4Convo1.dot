	j3681694583 [label="[停止所有關於自殘的對話。你不會因此失去與任何角色的曖昧點數]",shape=box,color=red];
		j3681694583 -> j740167158;
	j485073357 [label="老實說，我都不知道自己更希望他的那些幻象是真是假。",shape=box,color=red];
		j485073357 -> j1308050648;
	j2048603133 [label="他提到的那些可怕景象。那些描述……",shape=box,color=red];
		j2048603133 -> j1308050648;
	j2360059043 [label="他哪天會把自己傷到再也無法挽回？",shape=box,color=red];
		j2360059043 -> j445676360;
	j3623963352 [label="你在他身邊會不會覺得不安全？擔心他在無意識中傷害到你？",shape=box,color=red];
		j3623963352 -> j81422066;
	j740167158 [label="Boolean LyonPainOff is now true.",color=orange];
		j740167158 -> j90421610;
	j1308050648 [label="+5 Chemistry",color=orange];
		j1308050648 -> j1299832870;
	j445676360 [label="唉……這是個很不舒服的話題，對吧？抱歉，但我不太知道該如何開口，不想把自己的思緒打結。",shape=box,color=blue];
		j445676360 -> j750082194;
	j81422066 [label="我相信里昂寧可犧牲自己也不會傷害我。我對諸神與惡魔都有信心──",shape=box,color=blue];
		j81422066 -> j4211675344;
	j90421610 [label="+20 Chemistry",color=orange];
		j90421610 -> j997035463;
	j1299832870 [label="那些填滿他腦海的噩夢……太陰引領他走在一條艱難的道路上，對吧？",shape=box,color=blue];
		j1299832870 -> j1959575691;
	j750082194 [label="但我會盡力回答。我想你是出於對他的關心才問的嗎？",shape=box,color=blue];
		j750082194 -> j59539303;
		j750082194 -> j1029239450;
	j4211675344 [label="──就算是你們的「漠然」也騙不了他對我動手。",shape=box,color=blue];
		j4211675344 -> j2981050600;
	j997035463 [label="[這將繞過所有圍繞自殘的對話]",shape=box,color=blue];
		j997035463 -> "Chat ends.";
	j1959575691 [label="這件事恐怕真的難以啟齒，因為我知道這本來就不應該發生，對吧？",shape=box,color=blue];
		j1959575691 -> j312510062;
	j59539303 [label="他被注射的血清來自那個原型 Warframe，眾所周知會……反正……",shape=box,color=red];
		j59539303 -> j3088025211;
		j59539303 -> j1908087542;
		j59539303 -> j2975827316;
	j1029239450 [label="光看他就很明顯了……無意冒犯。反正這也不難猜。",shape=box,color=red];
		j1029239450 -> j3088025211;
		j1029239450 -> j1908087542;
		j1029239450 -> j2975827316;
	j2981050600 [label="我更可能害怕一隻蝴蝶會把我整個吞掉，也不會害怕我靈魂的弟兄。",shape=box,color=blue];
		j2981050600 -> j1959575691;
	j312510062 [label="我想阻止他。保護他免於這樣傷害自己的念頭。",shape=box,color=blue];
		j312510062 -> j621918793;
	j3088025211 [label="我只是擔心他有哪天會太極端。",shape=box,color=red];
		j3088025211 -> j1959575691;
	j1908087542 [label="我們需要他身心健全。",shape=box,color=red];
		j1908087542 -> j1848118361;
	j2975827316 [label="我可不想操那個心，還得去幫他收屍。",shape=box,color=red];
		j2975827316 -> j1944486271;
	j621918793 [label="如果說我有哪件事對里昂絕對信任，那就是當他被需要的時候，他永遠都會出現。",shape=box,color=blue];
		j621918793 -> j3398424583;
	j1848118361 [label="你這種話只有惡魔才會講。難道你只會無情地需要一雙能幹的助手嗎？",shape=box,color=blue];
		j1848118361 -> j21527724;
		j1848118361 -> j502281136;
	j1944486271 [label="（法語）噁心。",shape=box,color=blue];
		j1944486271 -> j1508231473;
	j3398424583 [label="他是偉大的守護者，太陰的神聖護盾……黑夜中的閃耀之光。",shape=box,color=blue];
		j3398424583 -> j378923434;
	j21527724 [label="不，我真的很在乎他。只是擔心當我們需要他的時候，他卻不在了。",shape=box,color=red];
		j21527724 -> j621918793;
	j502281136 [label="我只是想知道我能不能指望他，還是說他已經徹底崩潰了。",shape=box,color=red];
		j502281136 -> j15103588;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j378923434 [label="他對自己施加痛苦……是為了聽見自己的思緒。感受自己的身體。",shape=box,color=blue];
		j378923434 -> j336404340;
	j15103588 [label="我很好奇，你倒下需要幫助的時候，誰會來幫你。",shape=box,color=blue];
		j15103588 -> j3075866290;
	j336404340 [label="因為天空繁星密布，每顆都在對他低語，而他就像月尊一樣，會迷失於其中。",shape=box,color=blue];
		j336404340 -> j499317513;
	j3075866290 [label="還是你認為那些日子已經過去了，而從今以後你已經免於責難了？",shape=box,color=blue];
		j3075866290 -> j1944486271;
	j499317513 [label="而如月相，他也有他的陰晴圓缺。他會被虛空吞噬，然後又閃耀得如此明亮，讓我們都能在黑暗中無懼前行。",shape=box,color=blue];
		j499317513 -> j2914088960;
	j2914088960 [label="但就像所有的祝福一樣，都伴隨著詛咒。我說得有道理嗎？我怕我只是在胡言亂語。",shape=box,color=blue];
		j2914088960 -> j1420456464;
		j2914088960 -> j3777775496;
		j2914088960 -> j1217824627;
		j2914088960 -> j1854171394;
		j2914088960 -> j2834007944;
	j1420456464 [label="我完全理解。而且我……想向你坦白件事。[向瑪麗坦白對里昂的感情]",shape=box,color=red];
		j1420456464 -> j1560328748;
	j3777775496 [label="我明白你的意思，但我不容許他傷害自己。他該停手了。",shape=box,color=red];
		j3777775496 -> j1272637462;
	j1217824627 [label="[警告：涉及輕生話題] 我曾經失去過一個人，就是選擇自殘而輕生。我無法……我絕不容許。",shape=box,color=red];
		j1217824627 -> j1864053906;
	j1854171394 [label="一定還有其他辦法。",shape=box,color=red];
		j1854171394 -> j521646029;
	j2834007944 [label="你說得很有道理。我只是……希望能幫到他。",shape=box,color=red];
		j2834007944 -> j521646029;
	j1560328748 [label="Boolean DrifterLyon is now true.",color=orange];
		j1560328748 -> j1205793309;
	j1272637462 [label="Boolean DrifterHarmStop is now true.",color=orange];
		j1272637462 -> j3790941523;
	j1864053906 [label="Boolean DrifterHarmLoss is now true.",color=orange];
		j1864053906 -> j3538001623;
	j521646029 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j521646029 -> j2936665375;
	j1205793309 [label="恐怕他已……擄獲我心，得知他痛苦讓我心碎。",shape=box,color=red];
		j1205793309 -> j3440663143;
	j3790941523 [label="他感受到的痛苦遠比他施加於自身肉體上的還深。現在他對自己做的事並不會讓他再次倒下。",shape=box,color=blue];
		j3790941523 -> j476567753;
	j3538001623 [label="哦！我不知道，我真的非常抱歉……我現在能對你說的那些客套的安慰和祈禱什麼的，肯定都會顯得空洞──",shape=box,color=blue];
		j3538001623 -> j2507132608;
	j2936665375 [label="+20 Chemistry",color=orange];
		j2936665375 -> j4117404013;
	j3440663143 [label="+20 Chemistry",color=orange];
		j3440663143 -> j2874581061;
	j476567753 [label="這有助他清醒頭腦和穩定靈魂。而且現在，作為原型 Warframe，部分是這個……Harrow，就像我部分是 Wisp 一樣，這樣殺不死他，對吧？",shape=box,color=blue];
		j476567753 -> j2662641969;
		j476567753 -> j2750266206;
	j2507132608 [label="──因為一個你幾乎不認識的人能給你什麼慰問，充當那齣悲劇的良藥？",shape=box,color=blue];
		j2507132608 -> j1789181994;
	j4117404013 [label="正因如此，我更是欣賞你。但幫助的形式可以有很多種，對不？",shape=box,color=blue];
		j4117404013 -> j876777943;
	j2874581061 [label="噢！我剛才像看到老鼠一樣尖叫，嚇到 Loid 先生了！抱歉！",shape=box,color=blue];
		j2874581061 -> j270615114;
	j2662641969 [label="不，這是殺不死他。但這樣做還是不對。",shape=box,color=red];
		j2662641969 -> j2141402356;
	j2750266206 [label="我想我理解你的觀點。",shape=box,color=red];
		j2750266206 -> j2049020828;
	j1789181994 [label="你失去的那位……他們和你很親近嗎？",shape=box,color=blue];
		j1789181994 -> j2791226630;
		j1789181994 -> j1631814446;
	j876777943 [label="幫助雛鳥反而可能會害死牠。幫助燭火反而可能會因為過度熱情而熄滅了它。",shape=box,color=blue];
		j876777943 -> j3756004080;
	j270615114 [label="噢，這真是個好消息！",shape=box,color=blue];
		j270615114 -> j2132785232;
		j270615114 -> j4149488174;
	j2141402356 [label="我發現當他需要我的時候陪在他身邊……傾聽他，在他哭泣時擁抱他；",shape=box,color=blue];
		j2141402356 -> j664797879;
	j2049020828 [label="+10 Chemistry",color=orange];
		j2049020828 -> j3756004080;
	j2791226630 [label="非常親近。",shape=box,color=red];
		j2791226630 -> j1953546341;
	j1631814446 [label="不太親近。",shape=box,color=red];
		j1631814446 -> j1352090101;
	j3756004080 [label="我發現當他需要我的時候陪在他身邊……傾聽他，在他哭泣時，只是靜靜坐在他一旁；",shape=box,color=blue];
		j3756004080 -> j3498977801;
	j2132785232 [label="真的嗎？我不知道你會怎麼想。",shape=box,color=red];
		j2132785232 -> j3591936591;
	j4149488174 [label="我只是想知道他能否忍受我在他身邊……",shape=box,color=red];
		j4149488174 -> j1229111522;
	j664797879 [label="比起告訴他什麼該做什麼不該做反而更有用。",shape=box,color=blue];
		j664797879 -> j4006419760;
	j1953546341 [label="這就是為什麼你想確保里昂不會遭遇同樣的命運嗎？還是只是這話題本身讓你難受？",shape=box,color=blue];
		j1953546341 -> j1595914580;
		j1953546341 -> j632178959;
	j1352090101 [label="即便如此，看著你身邊親近的人身陷困境無法自拔，那麼解脫的方式就只剩下唯一這條了……",shape=box,color=blue];
		j1352090101 -> j1953546341;
	j3498977801 [label="比起告訴他什麼該做什麼不該做反而更有用。",shape=box,color=blue];
		j3498977801 -> j3485751163;
		j3498977801 -> j1541722114;
		j3498977801 -> j1652619545;
	j3591936591 [label="哦，我好開心。真是太高興了！你根本不知道里昂有多需要愛了！",shape=box,color=blue];
		j3591936591 -> j1277475121;
	j1229111522 [label="啊，就像對著大理石雕像說話，對不？我懂你的感受。我經常講了二十分鐘的故事才發現他根本沒在聽。",shape=box,color=blue];
		j1229111522 -> j1768486069;
	j4006419760 [label="你得學會察言觀色，對不？他溝通的方式是透過講故事。透過寓言。如果他沉默，就聆聽他的行動。",shape=box,color=blue];
		j4006419760 -> j1022628371;
	j1595914580 [label="拜託，我……想要避開這個話題。我聊不下去。",shape=box,color=red];
		j1595914580 -> j2093359840;
	j632178959 [label="我需要確保里昂不會遭受痛苦……",shape=box,color=red];
		j632178959 -> j3160146537;
	j3485751163 [label="我會盡量採納你的建議。只是不知道該怎麼和他溝通。",shape=box,color=red];
		j3485751163 -> j2627552285;
	j1541722114 [label="我盡力而為，我只是……希望自己能做得更多。",shape=box,color=red];
		j1541722114 -> j982319568;
	j1652619545 [label="他只是有時候讓人……很煩。",shape=box,color=red];
		j1652619545 -> j2627552285;
	j1277475121 [label="啊，或許你真的知道。如你所見，儘管他表面上看起來不是這麼回事，但內心卻承受著巨大痛苦……",shape=box,color=blue];
		j1277475121 -> j1192565609;
	j1768486069 [label="又迷失在自己腦海中的迷宮裡，或是在注意房間裡的其他靈體。",shape=box,color=blue];
		j1768486069 -> j2397478732;
	j1022628371 [label="對他耐心一點，溫柔一點，還有算我拜託你了，千萬不要傷害他，好嗎？",shape=box,color=blue];
		j1022628371 -> j1585032876;
		j1022628371 -> j1812449605;
	j2093359840 [label="Boolean LyonPainOff is now true.",color=orange];
		j2093359840 -> j1948929161;
	j3160146537 [label="Boolean LyonPainResolved is now true.",color=orange];
		j3160146537 -> j1948929161;
	j2627552285 [label="啊，就像對著大理石雕像說話，對不？我懂你的感受。我經常講了二十分鐘的故事才發現他根本沒在聽。",shape=box,color=blue];
		j2627552285 -> j544495323;
	j982319568 [label="是的，我了解。但有時候，我們能做的實在有限。只能在別人需要我們的時候，以他們想要的方式陪伴他們。",shape=box,color=blue];
		j982319568 -> j218728928;
	j1192565609 [label="對他耐心一點，溫柔一點，還有算我拜託你了，千萬不要傷害他，好嗎？",shape=box,color=blue];
		j1192565609 -> j589152097;
	j2397478732 [label="你得學會察言觀色，對不？他溝通的方式是透過講故事。透過寓言。如果他沉默，就聆聽他的行動。",shape=box,color=blue];
		j2397478732 -> j1192565609;
	j1585032876 [label="我還是認為這樣不妥。",shape=box,color=red];
		j1585032876 -> j4226909087;
	j1812449605 [label="我盡力而為。",shape=box,color=red];
		j1812449605 -> j4033775464;
	j1948929161 [label="當然……我能給你講個故事嗎？是關於我認識的一個人，他也遭遇同樣的事，還是說你更傾向回去各自忙？",shape=box,color=blue];
		j1948929161 -> j169423540;
		j1948929161 -> j2045907593;
		j1948929161 -> j83471350;
	j544495323 [label="又迷失在自己腦海中的迷宮裡，或是在注意房間裡的其他靈體。",shape=box,color=blue];
		j544495323 -> j1155051217;
	j218728928 [label="做更多只會壓垮他們或把他們推開。",shape=box,color=blue];
		j218728928 -> j2029282780;
	j589152097 [label="我只要求這些。噢，我真是太開心了！我一定要促成你們這對新人！",shape=box,color=blue];
		j589152097 -> j2562134552;
		j589152097 -> j3220059828;
		j589152097 -> j4056412805;
	j4226909087 [label="那就跟他說你的擔憂。他會聽的。他不是小孩子。",shape=box,color=blue];
		j4226909087 -> j93530622;
	j4033775464 [label="+20 Chemistry",color=orange];
		j4033775464 -> j3248935776;
	j169423540 [label="我們就聊到這裡吧。",shape=box,color=red];
		j169423540 -> j869483003;
	j2045907593 [label="我們能回到里昂的話題上嗎？",shape=box,color=red];
		j2045907593 -> j1695793146;
	j83471350 [label="我……想聽關於他的事。",shape=box,color=red];
		j83471350 -> j2767069790;
	j1155051217 [label="你得學會察言觀色，對不？他溝通的方式是透過講故事。透過寓言。如果他沉默，就聆聽他的行動。",shape=box,color=blue];
		j1155051217 -> j2029282780;
	j2029282780 [label="但你在乎他，你希望幫助他，而我相信他也明白這點。啊！就是這樣。他就像隻流浪狗，腿上有道傷疤。傷口雖癒合了，但癒合得不好。所以還是會痛，也會癢。",shape=box,color=blue];
		j2029282780 -> j3444295959;
	j2562134552 [label="等一下，我沒有要你多管閒事！",shape=box,color=red];
		j2562134552 -> j1690528101;
	j3220059828 [label="我該擔心嗎？",shape=box,color=red];
		j3220059828 -> j1690528101;
	j4056412805 [label="我用得上你的幫助。",shape=box,color=red];
		j4056412805 -> j1873388122;
	j93530622 [label="他就像隻流浪狗，腿上有道傷疤。傷口雖癒合了，但癒合得不好。所以還是會痛，也會癢。",shape=box,color=blue];
		j93530622 -> j3444295959;
	j3248935776 [label="謝謝。我只能要求這樣了。回頭見。",shape=box,color=blue];
		j3248935776 -> "Chat ends.";
