		j2767069790 -> j2432268382 [label=false,color=brown];
	j3444295959 [label="牠會去啃咬那條腿，雖然這會讓傷口裂開並帶來疼痛，但也會帶來解脫。",shape=box,color=blue];
		j3444295959 -> j177973906;
	j1690528101 [label="哈！現在說這個太遲了。瑪麗先去忙了！（法語）空氣中瀰漫著愛意！",shape=box,color=blue];
		j1690528101 -> "Chat ends.";
	j1873388122 [label="是的！就算你想阻止我也阻止不了。瑪麗先去忙了！",shape=box,color=blue];
