	2090 [label="他甚至還用我們撿來的木頭幫我做了腋杖，你們可能叫它……呃……拐杖吧？我可以用它來拖著自己走動。",shape=box,color=blue];
		2090 -> 2093;
	2091 [label="那麼，該拿可憐的畸形瑪麗怎麼辦？於是我就被帶到了光之城，在那裡我肯定會死在街頭……",shape=box,color=blue];
		2091 -> 2094;
	2092 [label="嗯。我突然想到，或許把里昂比作流浪狗不是最恰當的比喻……",shape=box,color=blue];
		2092 -> 2095;
	2093 [label="有天早上，我們去叫他起床，結果發現他──",shape=box,color=blue];
		2093 -> 2096;
	2094 [label="然後被遺棄，自生自滅。",shape=box,color=blue];
		2094 -> 2097;
		2094 -> 2098;
	2095 [label="或許，不要告訴他我有這麼做過，好嗎……？",shape=box,color=blue];
		2095 -> 2099;
	2096 [label="我……我就不說細節了……我相信你也能猜到。",shape=box,color=blue];
		2096 -> 2100;
	2097 [label="你當時幾歲？",shape=box,color=red];
		2097 -> 2101;
	2098 [label="你的家人拋棄你，任你自生自滅？",shape=box,color=red];
		2098 -> 2102;
	2099 [label="Update boolean LyonStrayDog",color=orange];
		2099 -> 2103;
		2099 -> 2104;
	2100 [label="但他給我們留了張紙條。字跡潦草得幾乎看不清。在其他孩子中唯有他認識字，而我得讀給其他人聽。",shape=box,color=blue];
		2100 -> 2105;
	2101 [label="六歲？還是七歲？在他們眼裡，已經花了多年在盡力矯正我。請家庭教師教我行走，穿戴肢架，特製鞋具。",shape=box,color=blue];
		2101 -> 2106;
	2102 [label="在他們眼裡，已經花了多年在盡力矯正我。請家庭教師教我行走，穿戴肢架，特製鞋具。",shape=box,color=blue];
		2102 -> 2106;
	2103 [label="我覺得很可愛，他肯定也會這麼覺得。",shape=box,color=red];
		2103 -> 2107;
	2104 [label="我會幫你保守秘密。",shape=box,color=red];
		2104 -> 2108;
	2105 [label="我至今仍記得自己當時讀到哽咽。但我必須堅強。因為即使在那時，我就知道自己對他人有責任。",shape=box,color=blue];
		2105 -> 2109;
	2106 [label="他們厭倦了這種負擔。於是，連數字和字母幾乎都不會讀寫的我，發現自己淪落街頭。",shape=box,color=blue];
		2106 -> 2110;
		2106 -> 2111;
	2107 [label="（法語）真是可怕的人！我希望你的椅子塌掉，讓你渾身插滿刺！",shape=box,color=blue];
		2107 -> 2112;
	2108 [label="謝謝！真是鬆了口氣……",shape=box,color=blue];
		2108 -> 2113;
	2109 [label="他們對我說，雨果在我們眼裡總是看起來很開心。非常開朗。總是帶著歡笑和嘲諷面對生活。",shape=box,color=blue];
		2109 -> 2114;
	2110 [label="好可怕喔。",shape=box,color=red];
		2110 -> 2115;
	2111 [label="你是怎麼活下來的？",shape=box,color=red];
		2111 -> 2115;
	2112 [label="Chat ends.",color=orange];
	2113 [label="Chat ends.",color=orange];
	2114 [label="即使我們遭到驅趕，或他因為偷竊或遊蕩而被棍棒毆打，這些似乎都絲毫影響不了他。",shape=box,color=blue];
		2114 -> 2116;
	2115 [label="Check boolean MarieSecretPower",color=orange];
		2115 -> 2117 [label=true,color=green];
		2115 -> 2118 [label=false,color=brown];
	2116 [label="但我們永遠無法知道他人心中的痛到底有多痛。而在那封信裡，我知道他和太陰一起哭泣了。",shape=box,color=blue];
		2116 -> 2119;
	2117 [label="就像你說的，所有的不便都蘊含神秘力量，對不？",shape=box,color=blue];
		2117 -> 2118;
	2118 [label="在母親眼中，讓我不受待見的缺陷，反而讓我在街頭的孩子眼中頗受歡迎。",shape=box,color=blue];
		2118 -> 2120;
	2119 [label="但他現在在她身邊安息了。有段時間，我怨恨他離開，因為其他人都指望我給出指引。而我怨恨他拋下我。",shape=box,color=blue];
		2119 -> 2121;
	2120 [label="還有什麼比一個沒有雙腳的孩子更可憐的呢，對吧？我光是伸手乞討一天，就能賺得比他們一週偷搶來的還多。",shape=box,color=blue];
		2120 -> 2122;
	2121 [label="但隨著時間的推移，我逐漸明白了其中的真相。",shape=box,color=blue];
		2121 -> 2123;
	2122 [label="而我向來樂於分享。所以我有很多朋友會照顧和保護我。其中一個是名叫雨果的大男孩。",shape=box,color=blue];
		2122 -> 2085;
	2123 [label="我們只能原諒身為人的自己。原諒他們離去所帶來的痛苦從而放過自己。",shape=box,color=blue];
		2123 -> 2124;
	2124 [label="我們會感到痛苦是因為他們不在了，而且想到我們沒能為他們做更多來幫助他們。",shape=box,color=blue];
		2124 -> 2125;
	2125 [label="他人背負的重擔，我們永遠都無法感同身受。",shape=box,color=blue];
		2125 -> 2126;
	2126 [label="而這是個天大的悲劇。但這正是身為人的意義所在。",shape=box,color=blue];
		2126 -> 2127;
	2127 [label="我不知道這個故事有沒有幫到你。但我只能祈禱它有用。我得走了，Loid 先生在找。",shape=box,color=blue];
		2127 -> 2128;
		2127 -> 2129;
	2128 [label="瑪麗，謝謝。",shape=box,color=red];
		2128 -> 2130;
	2129 [label="[保持沉默]",shape=box,color=red];
		2129 -> 2131;
	2130 [label="+20 Chemistry",color=orange];
		2130 -> 2132;
	2131 [label="+20 Chemistry",color=orange];
		2131 -> 2133;
	2132 [label="不客氣。回頭見。",shape=box,color=blue];
		2132 -> 2134;
	2133 [label="（法語）再見。",shape=box,color=blue];
		2133 -> 2135;
	2134 [label="Chat ends.",color=orange];
	2135 [label="Chat ends.",color=orange];
}