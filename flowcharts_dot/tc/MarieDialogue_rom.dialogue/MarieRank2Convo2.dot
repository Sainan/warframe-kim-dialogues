		429 -> 434;
	430 [label="我理解你與他的經歷和我的不同。但你也必須明白，對我來說，他只表現出善良和關懷。",shape=box,color=blue];
		430 -> 435;
	428 [label="我的感覺和第一天看著他在講壇上向我們的教區居民傳道時一樣。能夠在他身邊便是福分。",shape=box,color=blue];
