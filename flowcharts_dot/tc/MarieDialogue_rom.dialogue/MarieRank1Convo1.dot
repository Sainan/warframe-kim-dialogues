digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo1 begins." [color=orange];
		"MarieRank1Convo1 begins." -> j1754249294;
	j1754249294 [label="你好，漂泊者，你好！你今天過得怎麼樣？或是說今晚。我真的不知道這個地方現在是什麼時間。",shape=box,color=blue];
		j1754249294 -> j1786800782;
	j1786800782 [label="我確信 Loid 先生保存的這些小玩意中有一個是時鐘，但我就是無法確定是哪一個。",shape=box,color=blue];
		j1786800782 -> j3825932114;
	j3825932114 [label="我害怕觸碰這間奇怪聖堂裡的任何設備。我完全相信，我既有可能把自己甩入某個遙遠的時空，也有可能只是在熱一杯茶。",shape=box,color=blue];
		j3825932114 -> j175489722;
		j3825932114 -> j3536322083;
		j3825932114 -> j1350559949;
	j175489722 [label="最好不要亂按任何你不確定的按鈕，不要。",shape=box,color=red];
		j175489722 -> j37986847;
	j3536322083 [label="我相信你會沒事的。",shape=box,color=red];
		j3536322083 -> j1878374273;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j37986847 [label="確實是非常好的建議。我從 Loid 先生那裡聽說你也有自己的時空冒險。我好奇──",shape=box,color=blue];
		j37986847 -> j3255574542;
	j1878374273 [label="真是太貼心了，但……你不是那個被拋入另一個……啊。對了。是的！",shape=box,color=blue];
		j1878374273 -> j506811452;
	"Chat ends." [color=orange];
	j3255574542 [label="有像這次一樣危險嗎？",shape=box,color=blue];
		j3255574542 -> j3313738178;
		j3255574542 -> j583419429;
	j506811452 [label="你應該會知道，對吧？抱歉。你的個人冒險有這次危險嗎？",shape=box,color=blue];
		j506811452 -> j3313738178;
		j506811452 -> j583419429;
	j3313738178 [label="那個時代？還是我待在那裡的經歷？",shape=box,color=red];
		j3313738178 -> j234317763;
	j583419429 [label="雖然情況有所不同，但我保證你在這裡很安全。",shape=box,color=red];
		j583419429 -> j2888669763;
	j234317763 [label="+10 Chemistry",color=orange];
		j234317763 -> j142203832;
	j2888669763 [label="我非常感謝你這番鼓舞人心的信任，但我並不完全認同。尤其是當我連時間都難以分辨的時候。",shape=box,color=blue];
		j2888669763 -> j1994130127;
	j142203832 [label="做出區分來很好。我完全不質疑你過去的經歷，按照總體標準來說，它並不「正常」。但就從敘述來看，我當然希望它並不是這樣。",shape=box,color=blue];
		j142203832 -> j1165254768;
	j1994130127 [label="人們會期望在這個……「螢幕」的角落有個時鐘，但並沒有！要我說的話，品質堪慮。",shape=box,color=blue];
		j1994130127 -> j2441201940;
	j1165254768 [label="我指的是那個「時代」本身。讓我調整措辭──",shape=box,color=blue];
		j1165254768 -> j3557637874;
	j2441201940 [label="不管怎樣，我們已經偏離我的問題太遠了！",shape=box,color=blue];
		j2441201940 -> j3557637874;
	j3557637874 [label="你前往的那個「過去」時代，確實離我所來自的「更遙遠的過去」更近，那它比我們目前所處的這個時代更危險，還是較不危險？",shape=box,color=blue];
		j3557637874 -> j1145181958;
	j1145181958 [label="天啊！我必須說我很喜歡聊這種話題，這比起擦拭聖餐器皿有趣多了。",shape=box,color=blue];
		j1145181958 -> j3523317331;
		j1145181958 -> j1927467666;
		j1145181958 -> j1524349409;
		j1145181958 -> j1871728735;
	j3523317331 [label="我認為都差不多。武器不同，他們可能還不知道自己面對的是什麼，但戰爭就是戰爭而死亡就是死亡。",shape=box,color=red];
		j3523317331 -> j4087811507;
	j1927467666 [label="我認為這次沒那麼危險。我們更有能力來應對我們面臨到的挑戰。他們才剛開始。",shape=box,color=red];
		j1927467666 -> j1796269600;
	j1524349409 [label="我認為這次更危險。雖然我們同樣面對的是感染者，但他們當時使用的武器卻遠比現在簡陋得多。",shape=box,color=red];
		j1524349409 -> j1796269600;
	j1871728735 [label="老實說，我很高興你能樂在其中。一下子要適應這麼多可能會很困難。",shape=box,color=red];
		j1871728735 -> j2600580675;
	j4087811507 [label="+5 Chemistry",color=orange];
		j4087811507 -> j4149281627;
	j1796269600 [label="你或許是對的。我會好好考慮。謝謝。",shape=box,color=blue];
		j1796269600 -> "Chat ends.";
	j2600580675 [label="+5 Chemistry",color=orange];
		j2600580675 -> j3349132222;
	j4149281627 [label="就像所有事物一樣，我想這是相對的，對不？現在追殺我們的掠食者與過去獵殺我們的一樣致命。牠只是把牙磨得更尖而已。",shape=box,color=blue];
		j4149281627 -> j1159377298;
		j4149281627 -> j1222981542;
	j3349132222 [label="我由日曜主教──你們的阿爾布雷希特．源拓氏──為此行做好準備。與我親愛的里昂不同的是，我把他的話當作事實。也與里昂不同的是，我把這趟看作是我們的偉大冒險，而非負擔。",shape=box,color=blue];
		j3349132222 -> j3690679795;
	j1159377298 [label="除非你是 Orokin，找到了避免死亡的方法……理論上是這樣，即使實際上並非如此。",shape=box,color=red];
		j1159377298 -> j2220292290;
	j1222981542 [label="我也很高興你能很好地適應未來。",shape=box,color=red];
		j1222981542 -> j2595627671;
	j3690679795 [label="侍奉聖光會未必等同受難。在這點上，我們向來意見相左。",shape=box,color=blue];
		j3690679795 -> j1407279598;
	j2220292290 [label="而且我相信那個惡魔是個完美的例子，說明為什麼死亡是太陰賜予我們最棒的禮物。",shape=box,color=blue];
		j2220292290 -> j339702217;
	j2595627671 [label="+5 Chemistry",color=orange];
		j2595627671 -> j2578294658;
	j1407279598 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j1407279598 -> j932871959;
	j339702217 [label="Boolean MarieRoathe1 is now true.",color=orange];
		j339702217 -> j1229191053;
	j2578294658 [label="我由日曜主教──你們的阿爾布雷希特．源拓氏──為此行做好準備。與我親愛的里昂不同的是，我把他的話當作事實。也與里昂不同的是，我把這趟看作是我們的偉大冒險，而非負擔。",shape=box,color=blue];
		j2578294658 -> j298324963;
	j932871959 [label="還有，傻瓜，別迴避我的問題！你認為哪個更危險？",shape=box,color=blue];
		j932871959 -> j2355919269;
		j932871959 -> j2923677811;
		j932871959 -> j3949072630;
	j1229191053 [label="哦！那是我認得的鐘聲，儘管我仍然無法確定這該死的東西在哪裡。無論如何，恐怕我得走了。真是太愉快了。期待下次「再見」！諸神保佑！",shape=box,color=blue];
		j1229191053 -> "Chat ends.";
	j298324963 [label="侍奉聖光會未必等同受難。在這點上，我們向來意見相左。",shape=box,color=blue];
		j298324963 -> j2322328156;
	j2355919269 [label="我相信這次更致命。我們有多少難以想像的威脅想要殺死我們？",shape=box,color=red];
		j2355919269 -> j1796269600;
	j2923677811 [label="我相信這次沒那麼危險。他們只是在發掘新的方式來互相殺戮。我們的方式或許只是看起來比較刺激一些。",shape=box,color=red];
		j2923677811 -> j1796269600;
	j3949072630 [label="我相信都差不多。最終死亡即是死亡，不是嗎？",shape=box,color=red];
		j3949072630 -> j3910588351;
	j2322328156 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j2322328156 -> j1229191053;
	j3910588351 [label="+5 Chemistry",color=orange];
		j3910588351 -> j2868902796;
	j2868902796 [label="就像所有事物一樣，我想這是相對的，不是嗎？現在追殺我們的掠食者與過去獵殺我們的一樣致命。牠只是把牙磨得更尖而已。",shape=box,color=blue];
		j2868902796 -> j2275698356;
		j2868902796 -> j1159377298;
	j2275698356 [label="作為一個試圖抵禦狼群的人，我經常因此感到疲憊。",shape=box,color=red];
		j2275698356 -> j2647470927;
	j2647470927 [label="我親愛的漂泊者，我認為你更有可能跑去加入狼群，而不是坐著防範牠們。而我確實把這當作是讚美。",shape=box,color=blue];
		j2647470927 -> j1229191053;
}