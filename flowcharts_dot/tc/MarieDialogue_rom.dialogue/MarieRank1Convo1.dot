digraph {
	0 [label="MarieRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="你好，漂泊者，你好！你今天過得怎麼樣？或是說今晚。我真的不知道這個地方現在是什麼時間。",shape=box,color=blue];
		1 -> 2;
	2 [label="我確信 Loid 先生保存的這些小玩意中有一個是時鐘，但我就是無法確定是哪一個。",shape=box,color=blue];
		2 -> 3;
	3 [label="我害怕觸碰這間奇怪聖堂裡的任何設備。我完全相信，我既有可能把自己甩入某個遙遠的時空，也有可能只是在熱一杯茶。",shape=box,color=blue];
		3 -> 5;
		3 -> 6;
		3 -> 4;
	5 [label="最好不要亂按任何你不確定的按鈕，不要。",shape=box,color=red];
		5 -> 8;
	6 [label="我相信你會沒事的。",shape=box,color=red];
		6 -> 9;
	4 [label="[結束]",shape=box,color=red];
		4 -> 7;
	8 [label="確實是非常好的建議。我從 Loid 先生那裡聽說你也有自己的時空冒險。我好奇──",shape=box,color=blue];
		8 -> 10;
	9 [label="真是太貼心了，但……你不是那個被拋入另一個……啊。對了。是的！",shape=box,color=blue];
		9 -> 11;
	7 [label="Chat ends.",color=orange];
	10 [label="有像這次一樣危險嗎？",shape=box,color=blue];
		10 -> 12;
		10 -> 13;
	11 [label="你應該會知道，對吧？抱歉。你的個人冒險有這次危險嗎？",shape=box,color=blue];
		11 -> 12;
		11 -> 13;
	12 [label="那個時代？還是我待在那裡的經歷？",shape=box,color=red];
		12 -> 14;
	13 [label="雖然情況有所不同，但我保證你在這裡很安全。",shape=box,color=red];
		13 -> 15;
	14 [label="+10 Chemistry",color=orange];
		14 -> 16;
	15 [label="我非常感謝你這番鼓舞人心的信任，但我並不完全認同。尤其是當我連時間都難以分辨的時候。",shape=box,color=blue];
		15 -> 17;
	16 [label="做出區分來很好。我完全不質疑你過去的經歷，按照總體標準來說，它並不「正常」。但就從敘述來看，我當然希望它並不是這樣。",shape=box,color=blue];
		16 -> 18;
	17 [label="人們會期望在這個……「螢幕」的角落有個時鐘，但並沒有！要我說的話，品質堪慮。",shape=box,color=blue];
		17 -> 19;
	18 [label="我指的是那個「時代」本身。讓我調整措辭──",shape=box,color=blue];
		18 -> 20;
	19 [label="不管怎樣，我們已經偏離我的問題太遠了！",shape=box,color=blue];
		19 -> 20;
	20 [label="你前往的那個「過去」時代，確實離我所來自的「更遙遠的過去」更近，那它比我們目前所處的這個時代更危險，還是較不危險？",shape=box,color=blue];
		20 -> 21;
	21 [label="天啊！我必須說我很喜歡聊這種話題，這比起擦拭聖餐器皿有趣多了。",shape=box,color=blue];
		21 -> 22;
		21 -> 23;
		21 -> 24;
		21 -> 25;
	22 [label="我認為都差不多。武器不同，他們可能還不知道自己面對的是什麼，但戰爭就是戰爭而死亡就是死亡。",shape=box,color=red];
		22 -> 26;
	23 [label="我認為這次沒那麼危險。我們更有能力來應對我們面臨到的挑戰。他們才剛開始。",shape=box,color=red];
		23 -> 27;
	24 [label="我認為這次更危險。雖然我們同樣面對的是感染者，但他們當時使用的武器卻遠比現在簡陋得多。",shape=box,color=red];
		24 -> 27;
	25 [label="老實說，我很高興你能樂在其中。一下子要適應這麼多可能會很困難。",shape=box,color=red];
		25 -> 28;
	26 [label="+5 Chemistry",color=orange];
		26 -> 29;
	27 [label="你或許是對的。我會好好考慮。謝謝。",shape=box,color=blue];
		27 -> 30;
	28 [label="+5 Chemistry",color=orange];
		28 -> 31;
	29 [label="就像所有事物一樣，我想這是相對的，對不？現在追殺我們的掠食者與過去獵殺我們的一樣致命。牠只是把牙磨得更尖而已。",shape=box,color=blue];
		29 -> 32;
		29 -> 33;
	30 [label="Chat ends.",color=orange];
	31 [label="我由日曜主教──你們的阿爾布雷希特．源拓氏──為此行做好準備。與我親愛的里昂不同的是，我把他的話當作事實。也與里昂不同的是，我把這趟看作是我們的偉大冒險，而非負擔。",shape=box,color=blue];
		31 -> 34;
	32 [label="除非你是 Orokin，找到了避免死亡的方法……理論上是這樣，即使實際上並非如此。",shape=box,color=red];
		32 -> 35;
	33 [label="我也很高興你能很好地適應未來。",shape=box,color=red];
		33 -> 36;
	34 [label="侍奉聖光會未必等同受難。在這點上，我們向來意見相左。",shape=box,color=blue];
		34 -> 37;
	35 [label="而且我相信那個惡魔是個完美的例子，說明為什麼死亡是太陰賜予我們最棒的禮物。",shape=box,color=blue];
		35 -> 38;
	36 [label="+5 Chemistry",color=orange];
		36 -> 39;
	37 [label="Update boolean MarieLyonSuffering1",color=orange];
		37 -> 40;
	38 [label="Update boolean MarieRoathe1",color=orange];
		38 -> 41;
	39 [label="我由日曜主教──你們的阿爾布雷希特．源拓氏──為此行做好準備。與我親愛的里昂不同的是，我把他的話當作事實。也與里昂不同的是，我把這趟看作是我們的偉大冒險，而非負擔。",shape=box,color=blue];
		39 -> 42;
	40 [label="還有，傻瓜，別迴避我的問題！你認為哪個更危險？",shape=box,color=blue];
		40 -> 43;
		40 -> 44;
		40 -> 45;
	41 [label="哦！那是我認得的鐘聲，儘管我仍然無法確定這該死的東西在哪裡。無論如何，恐怕我得走了。真是太愉快了。期待下次「再見」！諸神保佑！",shape=box,color=blue];
		41 -> 46;
	42 [label="侍奉聖光會未必等同受難。在這點上，我們向來意見相左。",shape=box,color=blue];
		42 -> 47;
	43 [label="我相信這次更致命。我們有多少難以想像的威脅想要殺死我們？",shape=box,color=red];
		43 -> 48;
	44 [label="我相信這次沒那麼危險。他們只是在發掘新的方式來互相殺戮。我們的方式或許只是看起來比較刺激一些。",shape=box,color=red];
		44 -> 48;
	45 [label="我相信都差不多。最終死亡即是死亡，不是嗎？",shape=box,color=red];
		45 -> 49;
	46 [label="Chat ends.",color=orange];
	47 [label="Update boolean MarieLyonSuffering1",color=orange];
		47 -> 41;
	48 [label="你或許是對的。我會好好考慮。謝謝。",shape=box,color=blue];
		48 -> 50;
	49 [label="+5 Chemistry",color=orange];
		49 -> 51;
	50 [label="Chat ends.",color=orange];
	51 [label="就像所有事物一樣，我想這是相對的，不是嗎？現在追殺我們的掠食者與過去獵殺我們的一樣致命。牠只是把牙磨得更尖而已。",shape=box,color=blue];
		51 -> 52;
		51 -> 53;
	52 [label="作為一個試圖抵禦狼群的人，我經常因此感到疲憊。",shape=box,color=red];
		52 -> 54;
	53 [label="除非你是 Orokin，找到了避免死亡的方法……理論上是這樣，即使實際上並非如此。",shape=box,color=red];
		53 -> 55;
	54 [label="我親愛的漂泊者，我認為你更有可能跑去加入狼群，而不是坐著防範牠們。而我確實把這當作是讚美。",shape=box,color=blue];
		54 -> 41;
	55 [label="而且我相信那個惡魔是個完美的例子，說明為什麼死亡是太陰賜予我們最棒的禮物。",shape=box,color=blue];
		55 -> 56;
	56 [label="Update boolean MarieRoathe1",color=orange];
		56 -> 41;
}