	edge [fontname="Roboto Condensed"];

	"MarieRank3Convo6 begins." [color=orange];
		"MarieRank3Convo6 begins." -> j2251434967;
	j2251434967 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j2251434967 -> j3559411239;
	j3559411239 [label="漂泊者，我必須問你一個問題，而且我必須懇求你不要因此評判我。",shape=box,color=blue];
		j3559411239 -> j2696916941;
		j3559411239 -> j352616109;
		j3559411239 -> j1350559949;
	j2696916941 [label="你被捲入了一個離奇的處境。我當然不會評判你。",shape=box,color=red];
		j2696916941 -> j1088238495;
	j352616109 [label="我會盡我所能。",shape=box,color=red];
		j352616109 -> j974475237;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j1088238495 [label="你人真好，在不了解我或我要對你說什麼之前就對我那麼友善。",shape=box,color=blue];
		j1088238495 -> j2631672196;
	j974475237 [label="+10 Chemistry",color=orange];
		j974475237 -> j783395525;
	"Chat ends." [color=orange];
	j2631672196 [label="但是⋯⋯費波那契那隻會說話的大頭魚也會讓你很頭痛嗎？",shape=box,color=blue];
		j2631672196 -> j883663933;
		j2631672196 -> j2417529114;
		j2631672196 -> j380005459;
	j783395525 [label="對此我感激不盡，謝謝。",shape=box,color=blue];
		j783395525 -> j2631672196;
	j883663933 [label="會。絕對會。謝天謝地。",shape=box,color=red];
		j883663933 -> j594820309;
	j2417529114 [label="你居然會對費波那契感到煩躁，這實在太可愛了。",shape=box,color=red];
		j2417529114 -> j2559340639;
	j380005459 [label="不會，其實我很喜歡他。",shape=box,color=red];
		j380005459 -> j655223132;
	j594820309 [label="那麼還好這不是我個人問題。但必須說清楚，我無意冒犯他。如果連我都因為處境而覺得難受，想必他也在盡力忍受著自己的處境。",shape=box,color=blue];
		j594820309 -> j2063696553;
	j2559340639 [label="哦？怎麼說？我想我應該高興才對，但我就是不明白為什麼。我的頭痛肯定沒那麼迷人。",shape=box,color=blue];
		j2559340639 -> j4143350862;
		j2559340639 -> j2614028443;
	j655223132 [label="那麼我只能懇求你的原諒，我無意冒犯他。如果連我都因為處境而覺得難受，想必他也在盡力忍受著自己的處境。",shape=box,color=blue];
		j655223132 -> j2193691984;
	j2063696553 [label="只是當我長時間承受他採取的那套做法時，會讓我不太舒服，僅此而已。",shape=box,color=blue];
		j2063696553 -> j3338824970;
	j4143350862 [label="我大部分時間都在為生存而戰。像這樣的人間溫暖⋯⋯正是我活著的意義所在。",shape=box,color=red];
		j4143350862 -> j2403581093;
	j2614028443 [label="我想我偶爾必須退後一步，反思這一切的荒謬性。一個諾格和一名太陽的女祭司⋯⋯",shape=box,color=red];
		j2614028443 -> j3074537781;
	j2193691984 [label="只是當我長時間承受他採取的那套做法時，會讓我不太舒服，僅此而已。",shape=box,color=blue];
		j2193691984 -> j3338824970;
	j3338824970 [label="唉。我根本不該抱怨。我今晚必須給里昂送晚餐，他又因嚴重偏頭風而臥床不起了。",shape=box,color=blue];
		j3338824970 -> j528801009;
		j3338824970 -> j1071730637;
	j2403581093 [label="+5 Chemistry",color=orange];
		j2403581093 -> j3699271771;
	j3074537781 [label="+5 Chemistry",color=orange];
		j3074537781 -> j3221969553;
	j528801009 [label="他經常這樣嗎？",shape=box,color=red];
		j528801009 -> j4230388727;
	j1071730637 [label="抱歉⋯⋯什麼？",shape=box,color=red];
		j1071730637 -> j474778035;
	j3699271771 [label="漂泊者，永遠不要迷失那個自己。永遠不要放棄內心追尋生命火花的自己。",shape=box,color=blue];
		j3699271771 -> j2871410555;
	j3221969553 [label="天啊，你這麼一說，也難怪。這聽起來確實像那些幼稚的笑話，不是嗎？",shape=box,color=blue];
		j3221969553 -> j1586759032;
	j4230388727 [label="嗯嗯。好像每隔幾週一次？每兩個月一次？我見過他最久沒發作的一次，大概是六個月。",shape=box,color=blue];
		j4230388727 -> j547018639;
	j474778035 [label="哦！天啊。嗯。想像一下頭痛，但更加嚴重。我聽說有些人稱它為膽汁性頭痛。這種頭痛在女性中更為常見。",shape=box,color=blue];
		j474778035 -> j889198036;
		j474778035 -> j828624134;
	j2871410555 [label="這個世界急於轉變成一個黑暗而嚴苛的地方。隨時準備在每個轉角對我們施加苦難。",shape=box,color=blue];
		j2871410555 -> j919076762;
	j1586759032 [label="一位修女、一位神父和一個來自未來的惡魔被送到過去⋯⋯然後又到未來⋯⋯遇見一條魚、一頭鹿形生物、一隻巨鳥和一個管家⋯⋯",shape=box,color=blue];
		j1586759032 -> j2848207338;
	j547018639 [label="Check boolean Megrim",color=orange];
		j547018639 -> j3992394870 [label=true,color=green];
		j547018639 -> j3293221128 [label=true,color=green];
		j547018639 -> j4089243413 [label=true,color=green];
		j547018639 -> j3992394870 [label=false,color=brown];
		j547018639 -> j3293221128 [label=false,color=brown];
		j547018639 -> j30358164 [label=false,color=brown];
	j889198036 [label="我想我們現在都稱它們為「偏頭痛」了。",shape=box,color=red];
		j889198036 -> j1846392103;
	j828624134 [label="哦。叫偏頭風喔。謝謝。",shape=box,color=red];
		j828624134 -> j2635089366;
	j919076762 [label="我們必須尋找任何光明和輕鬆的事物，即使顯得孩子氣也無妨。",shape=box,color=blue];
		j919076762 -> j3112155615;
	j2848207338 [label="這確實很有趣，你說得很對！",shape=box,color=blue];
		j2848207338 -> j2914503608;
	j3992394870 [label="我想知道是什麼原因導致的。",shape=box,color=red];
		j3992394870 -> j2275647575;
	j3293221128 [label="聽起來好可怕⋯⋯",shape=box,color=red];
		j3293221128 -> j3475654068;
	j4089243413 [label="我也會偏頭風。真的很可怕。",shape=box,color=red];
		j4089243413 -> j1029014593;
	j30358164 [label="我也會有那種頭痛。真的很可怕。",shape=box,color=red];
		j30358164 -> j1029014593;
	j1846392103 [label="我好期待我們還會發現哪些奇妙的歷史特殊用語！真令人興奮。我確實喜歡學習新事物。「偏頭風」和「偏頭痛」，看來兩者之間的演變相去不遠。",shape=box,color=blue];
		j1846392103 -> j2696115353;
	j2635089366 [label="Boolean Megrim is now true.",color=orange];
		j2635089366 -> j62493988;
	j3112155615 [label="要是里昂也能以同樣的方式看待就好了。",shape=box,color=blue];
		j3112155615 -> j943143357;
	j2914503608 [label="要是我親愛的里昂也能以同樣的方式看到事情光明的一面就好了。",shape=box,color=blue];
		j2914503608 -> j943143357;
	j2275647575 [label="他有自己的想法。",shape=box,color=blue];
		j2275647575 -> j1377411452;
	j3475654068 [label="如果你想表達同情，我相信他會接受。而且他會感激有人陪伴，儘管看起來可能不是這麼一回事。",shape=box,color=blue];
		j3475654068 -> j2790877963;
	j1029014593 [label="你也會嗎？你應該告訴里昂。要讓他知道其他人也同樣會承受這種苦難。",shape=box,color=blue];
		j1029014593 -> j2130432245;
	j2696115353 [label="Boolean Migraine is now true.",color=orange];
		j2696115353 -> j62493988;
	j62493988 [label="不管叫什麼名字，里昂現在正因為偏頭痛而臥床不起，而且會持續到早上。這個可憐人除了模糊的影像什麼都看不到，雙手雙腳也失去了知覺。他告訴我疼痛難耐。",shape=box,color=blue];
		j62493988 -> j547018639;
	j943143357 [label="Boolean MarieLyonSuffering1 is now true.",color=orange];
		j943143357 -> j3131272184;
	j1377411452 [label="雖然更準確地來說，他之前有過自己的想法，直到最近……",shape=box,color=blue];
		j1377411452 -> j2354753400;
	j2790877963 [label="漂泊者，雖然他的態度可能會讓你卻步，但我懇求你要堅持。在那看似堅毅冷酷的外表下，埋藏著一個極度需要幫助的人。",shape=box,color=blue];
		j2790877963 -> j3206587870;
		j2790877963 -> j1254806946;
		j2790877963 -> j1492485555;
	j2130432245 [label="+5 Chemistry",color=orange];
		j2130432245 -> j247210914;
	j3131272184 [label="啊，說到這個。我真不該抱怨頭痛。我今晚必須給里昂送晚餐，他又因嚴重偏頭風而臥床不起了。",shape=box,color=blue];
		j3131272184 -> j1071730637;
		j3131272184 -> j528801009;
	j2354753400 [label="Boolean MarieLyonFaith1 is now true.",color=orange];
		j2354753400 -> j2790877963;
	j3206587870 [label="我可以非常固執。別擔心。",shape=box,color=red];
		j3206587870 -> j475274006;
	j1254806946 [label="我已經有一個牆中人了⋯⋯再多一個又怎麼樣？",shape=box,color=red];
		j1254806946 -> j1648303168;
	j1492485555 [label="他是成年人。如果他想說話，他自然會說。",shape=box,color=red];
		j1492485555 -> j3023100241;
	j247210914 [label="聖光知道，否則他會心甘情願地獨自承受苦難⋯⋯",shape=box,color=blue];
		j247210914 -> j464590755;
	j475274006 [label="+5 Chemistry",color=orange];
		j475274006 -> j1152719825;
	j1648303168 [label="你可以和我開這種玩笑，但不要對他說這種話。你的這個漠然對他來說是個敏感的話題。",shape=box,color=blue];
		j1648303168 -> j1743582344;
	j3023100241 [label="他是成年人，沒錯。他是個男人，也沒錯。而且我相信他也想說。但我質問你的是，他能否說出口。",shape=box,color=blue];
		j3023100241 -> j148714353;
	j464590755 [label="Boolean MarieLyonSuffering2 is now true.",color=orange];
		j464590755 -> j2790877963;
	j1152719825 [label="和他互動，恐怕你會需要這份固執。漂泊者，謝謝。他是我最親愛的朋友，對我來說就像兄長。看到他如此痛苦讓我心碎。",shape=box,color=blue];
		j1152719825 -> j1134192481;
	j1743582344 [label="多點恆心、耐心，和善心。漂泊者，他對我來說就像兄長，我最親愛的朋友。看到他如此痛苦讓我心碎。",shape=box,color=blue];
		j1743582344 -> j1134192481;
	j148714353 [label="並非人人都有同樣天賦，也並非人人覺得自己配得這些東西。他飽受苦痛，並且認定這就是他命中註定的宿命。",shape=box,color=blue];
		j148714353 -> j223618051;
	j1134192481 [label="我們很快會再聊。承蒙太陽的恩典。",shape=box,color=blue];
		j1134192481 -> "Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j223618051 [label="對我來說他就像兄長，也是我最親愛的朋友。而我為他心碎。所以我只能請求你⋯⋯如果你能做到的話，多點善心和耐心。",shape=box,color=blue];
		j223618051 -> j1134192481;
	"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonHeadaches in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
