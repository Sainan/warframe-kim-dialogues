digraph {
	1418 [label="MarieRank3Convo6 begins.",color=orange];
		1418 -> 3740;
	3740 [label="Update boolean MarieLyonAvailable",color=orange];
		3740 -> 1419;
	1419 [label="漂泊者，我必須問你一個問題，而且我必須懇求你不要因此評判我。",shape=box,color=blue];
		1419 -> 1420;
		1419 -> 1421;
		1419 -> 1422;
	1420 [label="你被捲入了一個離奇的處境。我當然不會評判你。",shape=box,color=red];
		1420 -> 1423;
	1421 [label="我會盡我所能。",shape=box,color=red];
		1421 -> 1424;
	1422 [label="[結束]",shape=box,color=red];
		1422 -> 1425;
	1423 [label="你人真好，在不了解我或我要對你說什麼之前就對我那麼友善。",shape=box,color=blue];
		1423 -> 1426;
	1424 [label="+10 Chemistry",color=orange];
		1424 -> 1427;
	1425 [label="Chat ends.",color=orange];
	1426 [label="但是⋯⋯費波那契那隻會說話的大頭魚也會讓你很頭痛嗎？",shape=box,color=blue];
		1426 -> 1428;
		1426 -> 1429;
		1426 -> 1430;
	1427 [label="對此我感激不盡，謝謝。",shape=box,color=blue];
		1427 -> 1426;
	1428 [label="會。絕對會。謝天謝地。",shape=box,color=red];
		1428 -> 1431;
	1429 [label="你居然會對費波那契感到煩躁，這實在太可愛了。",shape=box,color=red];
		1429 -> 1432;
	1430 [label="不會，其實我很喜歡他。",shape=box,color=red];
		1430 -> 1433;
	1431 [label="那麼還好這不是我個人問題。但必須說清楚，我無意冒犯他。如果連我都因為處境而覺得難受，想必他也在盡力忍受著自己的處境。",shape=box,color=blue];
		1431 -> 1434;
	1432 [label="哦？怎麼說？我想我應該高興才對，但我就是不明白為什麼。我的頭痛肯定沒那麼迷人。",shape=box,color=blue];
		1432 -> 1435;
		1432 -> 1436;
	1433 [label="那麼我只能懇求你的原諒，我無意冒犯他。如果連我都因為處境而覺得難受，想必他也在盡力忍受著自己的處境。",shape=box,color=blue];
		1433 -> 1437;
	1434 [label="只是當我長時間承受他採取的那套做法時，會讓我不太舒服，僅此而已。",shape=box,color=blue];
		1434 -> 1438;
	1435 [label="我大部分時間都在為生存而戰。像這樣的人間溫暖⋯⋯正是我活著的意義所在。",shape=box,color=red];
		1435 -> 1439;
	1436 [label="我想我偶爾必須退後一步，反思這一切的荒謬性。一個諾格和一名太陽的女祭司⋯⋯",shape=box,color=red];
		1436 -> 1440;
	1437 [label="只是當我長時間承受他採取的那套做法時，會讓我不太舒服，僅此而已。",shape=box,color=blue];
		1437 -> 1441;
	1438 [label="唉。我根本不該抱怨。我今晚必須給里昂送晚餐，他又因嚴重偏頭風而臥床不起了。",shape=box,color=blue];
		1438 -> 1442;
		1438 -> 1443;
	1439 [label="+5 Chemistry",color=orange];
		1439 -> 1444;
	1440 [label="+5 Chemistry",color=orange];
		1440 -> 1445;
	1441 [label="唉。我根本不該抱怨。我今晚必須給里昂送晚餐，他又因嚴重偏頭風而臥床不起了。",shape=box,color=blue];
		1441 -> 1442;
		1441 -> 1443;
	1442 [label="他經常這樣嗎？",shape=box,color=red];
		1442 -> 1446;
	1443 [label="抱歉⋯⋯什麼？",shape=box,color=red];
		1443 -> 1447;
	1444 [label="漂泊者，永遠不要迷失那個自己。永遠不要放棄內心追尋生命火花的自己。",shape=box,color=blue];
		1444 -> 1448;
	1445 [label="天啊，你這麼一說，也難怪。這聽起來確實像那些幼稚的笑話，不是嗎？",shape=box,color=blue];
		1445 -> 1449;
	1446 [label="嗯嗯。好像每隔幾週一次？每兩個月一次？我見過他最久沒發作的一次，大概是六個月。",shape=box,color=blue];
		1446 -> 1450;
	1447 [label="哦！天啊。嗯。想像一下頭痛，但更加嚴重。我聽說有些人稱它為膽汁性頭痛。這種頭痛在女性中更為常見。",shape=box,color=blue];
		1447 -> 1451;
		1447 -> 1452;
	1448 [label="這個世界急於轉變成一個黑暗而嚴苛的地方。隨時準備在每個轉角對我們施加苦難。",shape=box,color=blue];
		1448 -> 1453;
	1449 [label="一位修女、一位神父和一個來自未來的惡魔被送到過去⋯⋯然後又到未來⋯⋯遇見一條魚、一頭鹿形生物、一隻巨鳥和一個管家⋯⋯",shape=box,color=blue];
		1449 -> 1454;
	1450 [label="Check boolean Megrim",color=orange];
		1450 -> 1455 [label=true,color=green];
		1450 -> 1456 [label=true,color=green];
		1450 -> 1458 [label=true,color=green];
		1450 -> 1455 [label=false,color=brown];
		1450 -> 1456 [label=false,color=brown];
		1450 -> 1457 [label=false,color=brown];
	1451 [label="我想我們現在都稱它們為「偏頭痛」了。",shape=box,color=red];
		1451 -> 1459;
	1452 [label="哦。叫偏頭風喔。謝謝。",shape=box,color=red];
		1452 -> 1460;
	1453 [label="我們必須尋找任何光明和輕鬆的事物，即使顯得孩子氣也無妨。",shape=box,color=blue];
		1453 -> 1461;
	1454 [label="這確實很有趣，你說得很對！",shape=box,color=blue];
		1454 -> 1462;
	1455 [label="我想知道是什麼原因導致的。",shape=box,color=red];
		1455 -> 1463;
	1456 [label="聽起來好可怕⋯⋯",shape=box,color=red];
		1456 -> 1464;
	1458 [label="我也會偏頭風。真的很可怕。",shape=box,color=red];
		1458 -> 1465;
	1457 [label="我也會有那種頭痛。真的很可怕。",shape=box,color=red];
		1457 -> 1465;
	1459 [label="我好期待我們還會發現哪些奇妙的歷史特殊用語！真令人興奮。我確實喜歡學習新事物。「偏頭風」和「偏頭痛」，看來兩者之間的演變相去不遠。",shape=box,color=blue];
		1459 -> 1466;
	1460 [label="Update boolean Megrim",color=orange];
		1460 -> 1467;
	1461 [label="要是里昂也能以同樣的方式看待就好了。",shape=box,color=blue];
		1461 -> 1468;
	1462 [label="要是我親愛的里昂也能以同樣的方式看到事情光明的一面就好了。",shape=box,color=blue];
		1462 -> 1468;
	1463 [label="他有自己的想法。",shape=box,color=blue];
		1463 -> 1469;
	1464 [label="如果你想表達同情，我相信他會接受。而且他會感激有人陪伴，儘管看起來可能不是這麼一回事。",shape=box,color=blue];
		1464 -> 1470;
	1465 [label="你也會嗎？你應該告訴里昂。要讓他知道其他人也同樣會承受這種苦難。",shape=box,color=blue];
		1465 -> 1471;
	1466 [label="Update boolean Migraine",color=orange];
		1466 -> 1467;
	1467 [label="不管叫什麼名字，里昂現在正因為偏頭痛而臥床不起，而且會持續到早上。這個可憐人除了模糊的影像什麼都看不到，雙手雙腳也失去了知覺。他告訴我疼痛難耐。",shape=box,color=blue];
		1467 -> 1450;
	1468 [label="Update boolean MarieLyonSuffering1",color=orange];
		1468 -> 1472;
	1469 [label="雖然更準確地來說，他之前有過自己的想法，直到最近……",shape=box,color=blue];
		1469 -> 1473;
	1470 [label="漂泊者，雖然他的態度可能會讓你卻步，但我懇求你要堅持。在那看似堅毅冷酷的外表下，埋藏著一個極度需要幫助的人。",shape=box,color=blue];
		1470 -> 1474;
		1470 -> 1475;
		1470 -> 1476;
	1471 [label="+5 Chemistry",color=orange];
		1471 -> 1477;
	1472 [label="啊，說到這個。我真不該抱怨頭痛。我今晚必須給里昂送晚餐，他又因嚴重偏頭風而臥床不起了。",shape=box,color=blue];
		1472 -> 1443;
		1472 -> 1442;
	1473 [label="Update boolean MarieLyonFaith1",color=orange];
		1473 -> 1470;
	1474 [label="我可以非常固執。別擔心。",shape=box,color=red];
		1474 -> 1478;
	1475 [label="我已經有一個牆中人了⋯⋯再多一個又怎麼樣？",shape=box,color=red];
		1475 -> 1479;
	1476 [label="他是成年人。如果他想說話，他自然會說。",shape=box,color=red];
		1476 -> 1480;
	1477 [label="聖光知道，否則他會心甘情願地獨自承受苦難⋯⋯",shape=box,color=blue];
		1477 -> 1481;
	1478 [label="+5 Chemistry",color=orange];
		1478 -> 1482;
	1479 [label="你可以和我開這種玩笑，但不要對他說這種話。你的這個漠然對他來說是個敏感的話題。",shape=box,color=blue];
		1479 -> 1483;
	1480 [label="他是成年人，沒錯。他是個男人，也沒錯。而且我相信他也想說。但我質問你的是，他能否說出口。",shape=box,color=blue];
		1480 -> 1484;
	1481 [label="Update boolean MarieLyonSuffering2",color=orange];
		1481 -> 1470;
	1482 [label="和他互動，恐怕你會需要這份固執。漂泊者，謝謝。他是我最親愛的朋友，對我來說就像兄長。看到他如此痛苦讓我心碎。",shape=box,color=blue];
		1482 -> 1485;
	1483 [label="多點恆心、耐心，和善心。漂泊者，他對我來說就像兄長，我最親愛的朋友。看到他如此痛苦讓我心碎。",shape=box,color=blue];
		1483 -> 1485;
	1484 [label="並非人人都有同樣天賦，也並非人人覺得自己配得這些東西。他飽受苦痛，並且認定這就是他命中註定的宿命。",shape=box,color=blue];
		1484 -> 1486;
	1485 [label="我們很快會再聊。承蒙太陽的恩典。",shape=box,color=blue];
		1485 -> 3734;
	1486 [label="對我來說他就像兄長，也是我最親愛的朋友。而我為他心碎。所以我只能請求你⋯⋯如果你能做到的話，多點善心和耐心。",shape=box,color=blue];
		1486 -> 1485;
	3734 [label="{\"Id\":3734,\"Incoming\":[1485],\"Outgoing\":[1487],\"GraphPos\":[12826,24521],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue\",\"Tag\":\"LyonHeadaches\",\"Value\":0}]}",color=orange];
		3734 -> 1487;
	1487 [label="Chat ends.",color=orange];
