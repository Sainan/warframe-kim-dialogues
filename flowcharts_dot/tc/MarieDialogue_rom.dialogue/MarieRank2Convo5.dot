digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank2Convo5 begins." [color=orange];
		"MarieRank2Convo5 begins." -> j1631090094;
	j1631090094 [label="Evaluate expressions",color=orange];
		j1631090094 -> j1024839119 [label="MarieOtak1",color=purple];
		j1631090094 -> j3729588887 [label="MarieFamily1",color=purple];
		j1631090094 -> j3462200224 [label="false",color=purple];
	j1024839119 [label="我一直在思考你曾經告訴我關於 Otak 先生的事。",shape=box,color=blue];
		j1024839119 -> j378531893;
	j3729588887 [label="我一直在思考你曾經告訴我關於主教一家的事。",shape=box,color=blue];
		j3729588887 -> j2833782418;
	j3462200224 [label="我又回來了，想問個關於「亡骸精靈」先生的問題，可以嗎？",shape=box,color=blue];
		j3462200224 -> j4133066389;
		j3462200224 -> j1350559949;
	j378531893 [label="我在想，或許它與我自身的某段經歷相似。如果你有空的話，我可以說給你聽嗎？",shape=box,color=blue];
		j378531893 -> j409036870;
		j378531893 -> j1350559949;
	j2833782418 [label="我在想，你能否告訴我關於 Otak 的故事？就是那張在亡骸精靈後腦勺上、帶著孩童般面容的臉。",shape=box,color=blue];
		j2833782418 -> j86641600;
		j2833782418 -> j3424687231;
	j4133066389 [label="當然可以，什麼問題？",shape=box,color=red];
		j4133066389 -> j409314503;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j409036870 [label="請說。",shape=box,color=red];
		j409036870 -> j1691643427;
	j86641600 [label="當然可以。",shape=box,color=red];
		j86641600 -> j3152383750;
	j3424687231 [label="也許，晚點吧。[結束]",shape=box,color=red];
		j3424687231 -> "Chat ends.";
	j409314503 [label="我很好奇為什麼他的後腦勺還有另一張臉，看似孩子的塗鴉。",shape=box,color=blue];
		j409314503 -> j3068277444;
	"Chat ends." [color=orange];
	j1691643427 [label="大教堂裡曾有位修女，名叫則濟利亞，她曾迷失於自己過往的心魔之中。",shape=box,color=blue];
		j1691643427 -> j2243028346;
	j3152383750 [label="據傳他是個天才，也是開發利用氬結晶體的幕後主腦。",shape=box,color=red];
		j3152383750 -> j2244655296;
	j3068277444 [label="我詢問過亡骸精靈先生和 Loid 先生，但他們都不願談論此事，只告訴了我一個名字──Otak。而他們說出這個名字時，帶著極大悲傷。",shape=box,color=blue];
		j3068277444 -> j2059888608;
	j2243028346 [label="她過去常站在大廳的巨鐘前，宣稱現在是下午兩點，但其實她根本不知道當時幾點。",shape=box,color=blue];
		j2243028346 -> j285375547;
	j2244655296 [label="這些結晶獲取自虛空──它們是我們能夠製造許多強大 warframe 和武器的原因。",shape=box,color=red];
		j2244655296 -> j2440223903;
	j2059888608 [label="所以我來找你說話，希望你能協助我。",shape=box,color=blue];
		j2059888608 -> j3550620090;
		j2059888608 -> j1276120234;
	j285375547 [label="我們常發現走廊上的畫作全被反轉，而她說那些畫在對她低語著可怕的陰謀。",shape=box,color=blue];
		j285375547 -> j1460761700;
	j2440223903 [label="他專攻晶體學。而他的作品歸檔於這裡的實驗室。",shape=box,color=red];
		j2440223903 -> j2147600090;
	j3550620090 [label="你想知道 Otak 的事嗎？還是想知道為什麼你無法和他對話？",shape=box,color=red];
		j3550620090 -> j995901156;
	j1276120234 [label="Otak 的事一言難盡……",shape=box,color=red];
		j1276120234 -> j2100059297;
	j1460761700 [label="我們後來才知道，她其實只是聽見隔壁房間的對話，誤以為是畫作在對她說話……",shape=box,color=blue];
		j1460761700 -> j28516456;
	j2147600090 [label="出於某種原因，我不知道為什麼，他被轉變成中樞，並獲得了自己的亡骸精靈外殼。",shape=box,color=red];
		j2147600090 -> j2709694061;
	j995901156 [label="我相信隨著時間這兩者我都想知道，但由你來決定從哪個開始。畢竟，我不知道哪個更重要。",shape=box,color=blue];
		j995901156 -> j2100059297;
	j2100059297 [label="Check boolean LoidFamilyComplete",color=orange];
		j2100059297 -> j519729354 [label=true,color=green];
		j2100059297 -> j519729354 [label=false,color=brown];
		j2100059297 -> j2264753409 [label=false,color=brown];
	j28516456 [label="有一次，她把休息室裡的所有坐墊都誤當成孩子，還為他們舉辦了下午茶會……",shape=box,color=blue];
		j28516456 -> j2159027468;
	j2709694061 [label="並非所有中樞都是作為懲罰而製造的。但火衛二上的事……變得很糟，他受到了嚴重的損壞。",shape=box,color=red];
		j2709694061 -> j1859239435;
	j519729354 [label="Otak 曾經是名哲士、Orokin 科學家，也是學者。發生在他身上的事算不上什麼愉快的故事。",shape=box,color=red];
		j519729354 -> j3422562947;
	j2264753409 [label="嗯……簡而言之，原拓氏的部分家人在樓上，他們並不……清楚我們在這裡。",shape=box,color=red];
		j2264753409 -> j3422995503;
	j2159027468 [label="當我走進那間房裡時，她抬頭看著我說道：「哦，奧黛特姊妹，你來了！孤兒院的孩子們也來了，要不要一起喝茶？」",shape=box,color=blue];
		j2159027468 -> j2344474557;
		j2159027468 -> j1762023783;
	j1859239435 [label="+5 Chemistry",color=orange];
		j1859239435 -> j2314329103;
	j3422562947 [label="Boolean MarieOtak1 is now true.",color=orange];
		j3422562947 -> j2531423876;
	j3422995503 [label="Boolean MarieFamily1 is now true.",color=orange];
		j3422995503 -> j3743983780;
	j2344474557 [label="你怎麼做？",shape=box,color=red];
		j2344474557 -> j2484732628;
	j1762023783 [label="奧黛特修女是誰？",shape=box,color=red];
		j1762023783 -> j2268766721;
	j2314329103 [label="（法語）可憐東西……",shape=box,color=blue];
		j2314329103 -> j4202257343;
	j2531423876 [label="以聖光會之名……請繼續。",shape=box,color=blue];
		j2531423876 -> j3152383750;
	j3743983780 [label="以聖光會之名……你是說我們在這裡的存在是個秘密？！難道這就是為什麼我們不被允許離開這個地方嗎？！但是為什麼呢？！",shape=box,color=blue];
		j3743983780 -> j2510587514;
	j2484732628 [label="我把輪椅推到桌邊的空位上，與她和那些坐墊一起喝茶，不然我還能怎麼辦？",shape=box,color=blue];
		j2484732628 -> j909130666;
	j2268766721 [label="很遺憾地說，奧黛特修女早在三十年前便已去世。",shape=box,color=blue];
		j2268766721 -> j1469086411;
	j4202257343 [label="於是，他被轉移到主要的亡骸精靈──唯一剩下的亡骸精靈──並且……該怎麼說呢？這很難解釋。",shape=box,color=red];
		j4202257343 -> j1411456069;
		j4202257343 -> j564023693;
		j4202257343 -> j884312732;
	j2510587514 [label="他的女兒，被稱為母親的尤拉瑞亞，還有她的家人，一直以來都在照看著火衛二。",shape=box,color=red];
		j2510587514 -> j3558323187;
	j909130666 [label="我們一邊笑，一邊聽她講述過去的故事，那些她從未對任何人提起過的往事，至少我所知是如此。",shape=box,color=blue];
		j909130666 -> j2666693324;
	j1469086411 [label="我把輪椅推到桌邊的空位上，與她和那些坐墊一起喝茶。",shape=box,color=blue];
		j1469086411 -> j909130666;
	j1411456069 [label="老實說，我只希望我們能修好他。把真正的 Otak 帶回來。",shape=box,color=red];
		j1411456069 -> j1691643427;
	j564023693 [label="他有辦法逗我笑。他很有趣，但這背後卻掩飾著一些悲慘和破碎的東西。",shape=box,color=red];
		j564023693 -> j1691643427;
	j884312732 [label="可惜的是，他無法被修復。而且我覺得他讓人很頭疼。",shape=box,color=red];
		j884312732 -> j1691643427;
	j3558323187 [label="自從原拓氏離開後就一直看守著這個地方，還有將虛空能量泵入始源星系的那顆心臟，讓我們所有人……實際上都得以保持可用。",shape=box,color=red];
		j3558323187 -> j3382079857;
	j2666693324 [label="她的眼睛時而明亮，時而黯淡，彷彿洋娃娃的眼神一般……",shape=box,color=blue];
		j2666693324 -> j2903807149;
		j2666693324 -> j3598197470;
		j2666693324 -> j59374246;
		j2666693324 -> j133316218;
	j3382079857 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3382079857 -> j2620711986 [label=true,color=green];
		j3382079857 -> j1980571544 [label=false,color=brown];
	j2903807149 [label="為什麼你要陪她坐？",shape=box,color=red];
		j2903807149 -> j4099724027;
	j3598197470 [label="則濟利亞修女後來怎麼樣了？",shape=box,color=red];
		j3598197470 -> j3866987372;
	j59374246 [label="我希望你的陪伴對她而言多少有點意義。",shape=box,color=red];
		j59374246 -> j1866094546;
	j133316218 [label="你真好心，陪她坐。",shape=box,color=red];
		j133316218 -> j1173001392;
	j2620711986 [label="她已經接受了他離去的事實，他們也已彼此和解，但這些都來之不易。",shape=box,color=red];
		j2620711986 -> j2623246430;
	j1980571544 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j1980571544 -> j2620711986 [label=true,color=green];
		j1980571544 -> j1696240432 [label=false,color=brown];
	j4099724027 [label="+15 Chemistry",color=orange];
		j4099724027 -> j1096719650;
	j3866987372 [label="就和所有處於她那種狀況的人一樣，像陽光下的畫作，逐漸褪色，直至消逝。",shape=box,color=blue];
		j3866987372 -> j1559618178;
	j1866094546 [label="+10 Chemistry",color=orange];
		j1866094546 -> j1419456933;
	j1173001392 [label="+5 Chemistry",color=orange];
		j1173001392 -> j1214743712;
	j2623246430 [label="知道他還在外面肆無忌憚，也再沒有和她說過一句話，甚至都沒有寄過一封信……",shape=box,color=red];
		j2623246430 -> j543863436;
	j1696240432 [label="她還沒有接受他離去的事實，他們彼此針鋒相對。",shape=box,color=red];
		j1696240432 -> j3848642807;
	j1096719650 [label="這是一個明智的問題。非常明智的問題。我想有許多原因促使我這麼做。我更願意相信是善意促使我走向她的桌前。",shape=box,color=blue];
		j1096719650 -> j227138010;
	j1559618178 [label="在這之後她便離開了我們，我們為她舉行了燭光追思會。我希望她最後能記得那些真正善待她的人。",shape=box,color=blue];
		j1559618178 -> j3435286450;
	j1419456933 [label="我願意相信在她內心深處她確實是這麼認為的。",shape=box,color=blue];
		j1419456933 -> j3435286450;
	j1214743712 [label="不過，那真的是善意嗎？還是內疚促使我這麼做？啊，但你這樣說本身也是種善意就是了。",shape=box,color=blue];
		j1214743712 -> j3435286450;
	j543863436 [label="我無法想像這對她，或對他們來說會有多痛苦。",shape=box,color=red];
		j543863436 -> j797205068;
	j3848642807 [label="知道他還在外面肆無忌憚，也再沒有和她說過一句話，甚至都沒有寄過一封信……",shape=box,color=red];
		j3848642807 -> j3392167078;
	j227138010 [label="但我想，或許是出於內疚。如果我不這麼做，我就是在忽視她。就像人們可能會忽視一個孩子那樣。",shape=box,color=blue];
		j227138010 -> j3435286450;
	j3435286450 [label="我願意相信你們的 Otak 知道誰對他友善且有耐心。不過，話說回來，他其實並不真實存在，對吧？",shape=box,color=blue];
		j3435286450 -> j337998149;
	j797205068 [label="雖然我能夠理解為了保護他們免受主教因迫不得已的離別而造成的痛苦，這個決定背後的道理……",shape=box,color=blue];
		j797205068 -> j3461223001;
	j3392167078 [label="這將摧毀他們之間或許還存在的一絲和解的機會。",shape=box,color=red];
		j3392167078 -> j42024467;
	j337998149 [label="我說的是一件非常精密的擬人科技產品，不是嗎？一台複雜許多倍的留聲機。就像亡骸精靈一樣，可他並沒有靈魂。",shape=box,color=blue];
		j337998149 -> j2247601860;
		j337998149 -> j356590618;
		j337998149 -> j4016497506;
		j337998149 -> j507125957;
		j337998149 -> j31977603;
	j3461223001 [label="我確實認為不必這麼殘忍，你不覺得嗎？他們可能以為他已經死了。或者更糟！而我們，住在這裡，卻像下水道的老鼠？",shape=box,color=blue];
		j3461223001 -> j70884999;
		j3461223001 -> j1836542107;
	j42024467 [label="+10 Chemistry",color=orange];
		j42024467 -> j1570943886;
	j2247601860 [label="亡骸精靈也許沒有靈魂，但他很獨特。其他中樞，像 Otak，則是有靈魂。他們在被製造的過程中被損毀了。",shape=box,color=red];
		j2247601860 -> j86282249;
	j356590618 [label="你說得對。那麼你希望我怎麼做？",shape=box,color=red];
		j356590618 -> j2288846643;
	j4016497506 [label="你說得對。他們沒有靈魂。但這並不代表我們可以隨意對他們苛刻。",shape=box,color=red];
		j4016497506 -> j1795230154;
	j507125957 [label="我不知道你說的對與否。但他們依然能思考和感受，而我們不能把他們當成物品來對待。",shape=box,color=red];
		j507125957 -> j3927976390;
	j31977603 [label="亡骸精靈有靈魂。所有中樞都有。",shape=box,color=red];
		j31977603 -> j335862920;
	j70884999 [label="這事真的不是由我說了算。",shape=box,color=red];
		j70884999 -> j2224759517;
	j1836542107 [label="我其實有個朋友很喜歡老鼠。我覺得牠們很可愛。",shape=box,color=red];
		j1836542107 -> j1106954508;
	j1570943886 [label="是的……我明白這個道理。那麼，如果可以的話，我會想辦法修補他們的家庭關係，對不？這似乎是我們所有人離開這個地方的唯一希望。",shape=box,color=blue];
		j1570943886 -> j3939331511;
	j86282249 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j86282249 -> j217711679;
	j2288846643 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j2288846643 -> j2543360068;
	j1795230154 [label="Boolean MarieCephalonNoSoul is now true.",color=orange];
		j1795230154 -> j3166714109;
	j3927976390 [label="Boolean MarieCephalonUnsure is now true.",color=orange];
		j3927976390 -> j369559007;
	j335862920 [label="Boolean MarieCephalonSoul is now true.",color=orange];
		j335862920 -> j2662452834;
	j2224759517 [label="我知道。公開自己的存在，是 Loid 先生及其他所有人的決定。",shape=box,color=blue];
		j2224759517 -> j4266855818;
	j1106954508 [label="+15 Chemistry",color=orange];
		j1106954508 -> j1210861858;
	j3939331511 [label="免得我們餘生都被困在這裡，像下水道的老鼠一樣。",shape=box,color=blue];
		j3939331511 -> j652164697;
		j3939331511 -> j2387978134;
	j217711679 [label="+5 Chemistry",color=orange];
		j217711679 -> j4243966424;
	j2543360068 [label="哦，不要以為我是要你對他們殘忍！不是的！要珍惜他們，因為他們很珍貴，而且他們會變成這樣並非出於自己的過錯！",shape=box,color=blue];
		j2543360068 -> j1577797702;
	j3166714109 [label="+5 Chemistry",color=orange];
		j3166714109 -> j2543360068;
	j369559007 [label="+5 Chemistry",color=orange];
		j369559007 -> j1220895375;
	j2662452834 [label="+5 Chemistry",color=orange];
		j2662452834 -> j961674433;
	j4266855818 [label="我認為讓我們留在這裡的是罪惡感，並非高尚情操。",shape=box,color=blue];
		j4266855818 -> j3677307895;
	j1210861858 [label="而我很想有天能見到他們，但這並不是我想表達的重點，傻狼。",shape=box,color=blue];
		j1210861858 -> j4266855818;
	j652164697 [label="是我疏忽了。你說得對。我這就著手處理。",shape=box,color=red];
		j652164697 -> j2636277849;
	j2387978134 [label="我其實有個朋友很喜歡老鼠。我覺得牠們很可愛。",shape=box,color=red];
		j2387978134 -> j691850254;
	j4243966424 [label="這更加證明了惡魔和他的同類理應受到譴責。但是，或許你對 Otak 和他的同類的看法是正確的，又或許相信這點能帶給你平靜。",shape=box,color=blue];
		j4243966424 -> j1448667119;
	j1577797702 [label="我只為 Orokin 惡魔留下的殘破軀體而感到痛心。他們不是神，而是吞噬一切的掠食者。只要看一下與我們同行的那位就是最佳證明了。",shape=box,color=blue];
		j1577797702 -> j782940334;
	j1220895375 [label="或許你說得對，但我不認為 Orokin 惡魔會比我們更了解靈魂的運作。他們並非偉大的神祇。",shape=box,color=blue];
		j1220895375 -> j2716516724;
	j961674433 [label="或許你說得對，又或許相信這點能帶給你平靜。",shape=box,color=blue];
		j961674433 -> j782940334;
	j3677307895 [label="我們隱藏了某種重大而可怕的罪行。",shape=box,color=blue];
		j3677307895 -> j259078598;
	j2636277849 [label="+5 Chemistry",color=orange];
