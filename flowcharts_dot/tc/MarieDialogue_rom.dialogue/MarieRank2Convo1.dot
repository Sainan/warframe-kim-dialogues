digraph {
	"MarieRank2Convo1 begins." [color=orange];
		"MarieRank2Convo1 begins." -> j1875763744;
	j1875763744 [label="我希望你不會覺得我問這個問題很無禮，但我實在很好奇。你有信仰嗎？比如聖光會或其他。",shape=box,color=blue];
		j1875763744 -> j409212200;
		j1875763744 -> j2399935428;
		j1875763744 -> j1350559949;
	j409212200 [label="如果我說我對你更感興趣呢？這樣會是褻瀆嗎？",shape=box,color=red];
		j409212200 -> j1932787950;
	j2399935428 [label="不，一點也不無禮。",shape=box,color=red];
		j2399935428 -> j924088536;
		j2399935428 -> j3598223390;
		j2399935428 -> j1479148143;
		j2399935428 -> j1384802593;
		j2399935428 -> j3741028481;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j1932787950 [label="Boolean DrifterMarie is now true.",color=orange];
		j1932787950 -> j437086694;
	j924088536 [label="這有點……複雜。我相信有某種存在，但我並沒有一個具名的信仰。",shape=box,color=red];
		j924088536 -> j3011534677;
	j3598223390 [label="是，我有。我有自己信奉的信仰，雖然你有可能沒聽說過。",shape=box,color=red];
		j3598223390 -> j2574930449;
	j1479148143 [label="我和你一樣信奉聖光會。",shape=box,color=red];
		j1479148143 -> j3563758256;
	j1384802593 [label="不，我沒有。我不信奉神祇。只信奉我們尚未理解的科學。",shape=box,color=red];
		j1384802593 -> j4085176392;
	j3741028481 [label="老實說，我不知道。我覺得這個世界太複雜了，我無法給出答案。",shape=box,color=red];
		j3741028481 -> j780931168;
	"Chat ends." [color=orange];
	j437086694 [label="啊，是嗎？這是怎麼回事？真大膽，我必須說我很驚訝！我沒料到……",shape=box,color=blue];
		j437086694 -> j1417775699;
	j3011534677 [label="Boolean DrifterFaithPersonal is now true.",color=orange];
		j3011534677 -> j1409627958;
	j2574930449 [label="+5 Chemistry",color=orange];
		j2574930449 -> j1701007651;
	j3563758256 [label="+5 Chemistry",color=orange];
		j3563758256 -> j359019649;
	j4085176392 [label="+5 Chemistry",color=orange];
		j4085176392 -> j3920119925;
	j780931168 [label="Boolean DrifterFaithAgnostic is now true.",color=orange];
		j780931168 -> j3812325845;
	j1417775699 [label="但你是在試圖讓我分心！雖然我不反對，但現在談這些還言之過早呢，對不對？",shape=box,color=blue];
		j1417775699 -> j3269057220;
	j1409627958 [label="+5 Chemistry",color=orange];
		j1409627958 -> j3787134980;
	j1701007651 [label="任何名義下的信仰，我都能發掘其中之美。告訴我，它是新的還是舊的？我能認得出來嗎？",shape=box,color=blue];
		j1701007651 -> j1172240043;
		j1701007651 -> j1983143238;
	j359019649 [label="你也是喔！哦，這真是太神奇了！想到在如此遙遠的未來仍有人持守著這份信仰，這讓我心中充滿喜悅。我感到無比欣喜。雖然我想你過去的經歷可能與此有關，對嗎？啊，無所謂了。",shape=box,color=blue];
		j359019649 -> j3775183954;
	j3920119925 [label="我尊重你的回答。但我必須問，你怎能這麼篤定？那本身不也是種信仰嗎？而你所謂的「漠然」，若不是神，那又是什麼？",shape=box,color=blue];
		j3920119925 -> j1093439528;
		j3920119925 -> j4203625254;
		j3920119925 -> j29769007;
	j3812325845 [label="+10 Chemistry",color=orange];
		j3812325845 -> j1671445187;
	j3269057220 [label="拜託，如果你不介意的話，我……還是想要得到我問題的答案。雖然現在你讓我臉紅了！",shape=box,color=blue];
		j3269057220 -> j924088536;
		j3269057220 -> j3598223390;
		j3269057220 -> j1479148143;
		j3269057220 -> j1384802593;
		j3269057220 -> j3741028481;
	j3787134980 [label="啊，好的。你是個漂流者，名字就說明了這點。你見識過許多文化、許多信仰、許多世界。這樣很有靈性，對不？像收集貝殼般把它們一一集起來。",shape=box,color=blue];
		j3787134980 -> j2540887971;
		j3787134980 -> j912459673;
	j1172240043 [label="不，我認為你會完全認不出來。",shape=box,color=red];
		j1172240043 -> j1571365589;
	j1983143238 [label="你可能認得出其中一部分。但其他部分對你來說可能完全陌生。",shape=box,color=red];
		j1983143238 -> j3892642435;
	j3775183954 [label="我好奇，你虔誠地信奉其中一個呢，還是你在兩者之間尋求平衡？",shape=box,color=blue];
		j3775183954 -> j4149621340;
		j3775183954 -> j988811230;
		j3775183954 -> j676767226;
	j1093439528 [label="我無法確定自己是否完全正確，這無人能辦到。但我個人依然不信奉神祇。",shape=box,color=red];
		j1093439528 -> j4227961832;
	j4203625254 [label="我認為宗教的存在是為了填補人們生命中因恐懼死亡和未知而留下的空缺。",shape=box,color=red];
		j4203625254 -> j2399420514;
	j29769007 [label="我不知道「漠然」是什麼，但它不是神。我們只需要找出真相。",shape=box,color=red];
		j29769007 -> j963549376;
	j1671445187 [label="啊，這或許是最明智的答案！因為我們這些平凡人──如果我們還能以此自稱的話──憑什麼能臆測諸神之意旨？",shape=box,color=blue];
		j1671445187 -> j2621871647;
	j2540887971 [label="我認為還有某種更古老、更真實、更深層的東西，與我們所有人都相連結，就像某種連結組織。",shape=box,color=red];
		j2540887971 -> j2565456735;
	j912459673 [label="沒錯。我在所有信仰中都能看見其中之美，我不認為誰對誰錯。",shape=box,color=red];
		j912459673 -> j2565456735;
	j1571365589 [label="Boolean DrifterFaithYesForeign is now true.",color=orange];
		j1571365589 -> j1199863745;
	j3892642435 [label="Boolean DrifterFaithYesSimilar is now true.",color=orange];
		j3892642435 -> j2577169923;
	j4149621340 [label="我發現自己更傾向於太陽。",shape=box,color=red];
		j4149621340 -> j2867063714;
	j988811230 [label="我發現自己更傾向於太陰。",shape=box,color=red];
		j988811230 -> j3158550785;
	j676767226 [label="我尋求平衡。我認為那是萬物的自然法則。",shape=box,color=red];
		j676767226 -> j551843679;
	j4227961832 [label="Boolean DrifterFaithNoMaybe is now true.",color=orange];
		j4227961832 -> j2549234349;
	j2399420514 [label="Boolean DrifterFaithNoFear is now true.",color=orange];
		j2399420514 -> j2681186994;
	j963549376 [label="Boolean DrifterFaithNoMITW is now true.",color=orange];
		j963549376 -> j2332858144;
	j2621871647 [label="我時常坐在我的大教堂聖殿裡，愉快地與單純前來學習的陌生人交談。",shape=box,color=blue];
		j2621871647 -> j2196501530;
	j2565456735 [label="+5 Chemistry",color=orange];
		j2565456735 -> j3968718614;
	j1199863745 [label="+5 Chemistry",color=orange];
		j1199863745 -> j1705887543;
	j2577169923 [label="+5 Chemistry",color=orange];
		j2577169923 -> j3700279544;
	j2867063714 [label="Boolean DrifterFaithSol is now true.",color=orange];
		j2867063714 -> j1785246018;
	j3158550785 [label="Boolean DrifterFaithLua is now true.",color=orange];
		j3158550785 -> j949044412;
	j551843679 [label="Boolean DrifterFaithBalance is now true.",color=orange];
		j551843679 -> j3127201283;
	j2549234349 [label="是的，我明白了……你或許需要自己的「實證」才能確定。你生命中沒遇過任何讓你產生那種情感的事，就像我們感受到的信仰和熱忱那樣。",shape=box,color=blue];
		j2549234349 -> j2936120805;
		j2549234349 -> j4194897529;
	j2681186994 [label="是的，這是真的──確實如此。信仰為許多靈魂解答了許多問題。難道你不害怕死後會發生什麼嗎？",shape=box,color=blue];
		j2681186994 -> j380350995;
		j2681186994 -> j377299749;
	j2332858144 [label="這真是太神奇了……現在已有兩位說過同樣的話了……惡魔也輕聲細語地這麼說過。",shape=box,color=blue];
		j2332858144 -> j1778065128;
	j2196501530 [label="他們對我們的信仰無比好奇，卻不願說「是的，這就是真理」。我只希望與他們分享一部分喜悅好讓他們帶回去。",shape=box,color=blue];
		j2196501530 -> j3716251160;
		j2196501530 -> j2565518220;
	j3968718614 [label="我理解，而且很美妙。我時常在想，聖光會有沒有戴上其他面孔，冠上其他名字，接見世人。",shape=box,color=blue];
		j3968718614 -> j1568785333;
	j1705887543 [label="哦，這真是太神奇了！我好希望有一天能夠了解你的信仰。聽聽你的儀式。",shape=box,color=blue];
		j1705887543 -> j909477328;
		j1705887543 -> j1622531873;
	j3700279544 [label="哦，這真是太神奇了！我好希望有一天能聽聽它為何既如此相似又如此不同。",shape=box,color=blue];
		j3700279544 -> j909477328;
		j3700279544 -> j1622531873;
	j1785246018 [label="+10 Chemistry",color=orange];
		j1785246018 -> j3710823582;
	j949044412 [label="+5 Chemistry",color=orange];
		j949044412 -> j3901717426;
	j3127201283 [label="+5 Chemistry",color=orange];
		j3127201283 -> j3370717949;
	j2936120805 [label="不，我只是不信。",shape=box,color=red];
		j2936120805 -> j1763745893;
	j4194897529 [label="沒錯。我從未……「感受」過信仰，或者需要過它。",shape=box,color=red];
		j4194897529 -> j1362593261;
	j380350995 [label="每個人都會死。害怕死亡是愚蠢的。死亡終將找上我們所有人。又或至少……本該如此。",shape=box,color=red];
		j380350995 -> j1304579041;
	j377299749 [label="我已經死過夠多次了。我並不害怕死亡之後。我對它充滿期待。",shape=box,color=red];
		j377299749 -> j238981216;
	j1778065128 [label="+5 Chemistry",color=orange];
		j1778065128 -> j3191687947;
	j3716251160 [label="我有點驚訝你對不信奉你信仰的人抱持著開放的態度。",shape=box,color=red];
		j3716251160 -> j1225607486;
	j2565518220 [label="正是如此。我不想說哪個「對」哪個「錯」。",shape=box,color=red];
		j2565518220 -> j2271876562;
	j1568785333 [label="據傳，他們會改變形態以取悅其他教派的信眾。但那是我的信仰，不是你的。",shape=box,color=blue];
		j1568785333 -> j60331163;
	j909477328 [label="我很樂意。",shape=box,color=red];
		j909477328 -> j3723776537;
	j1622531873 [label="我感到驚訝你對其他宗教抱持著開放的態度。",shape=box,color=red];
		j1622531873 -> j3850627846;
	j3710823582 [label="一個與我心意相通的漂流者！你讓我臉上掛滿笑容。我希望你不是為了讓我開心而這麼說。",shape=box,color=blue];
		j3710823582 -> j165610067;
	j3901717426 [label="啊，漂流者就像我親愛的里昂一樣，行走於黑夜之下。當他準備好時，你應該跟他談談他黑夜女神的行事之道，他肯定會欣喜若狂。",shape=box,color=blue];
		j3901717426 -> j165610067;
	j3370717949 [label="平衡而不動搖。在人生旅途，清楚何時日升月落，但永不陷入疑惑的泥沼。",shape=box,color=blue];
		j3370717949 -> j2317527213;
	j1763745893 [label="+5 Chemistry",color=orange];
		j1763745893 -> j1888027749;
	j1362593261 [label="+5 Chemistry",color=orange];
		j1362593261 -> j1612234078;
	j1304579041 [label="+5 Chemistry",color=orange];
		j1304579041 -> j3681975857;
	j238981216 [label="+5 Chemistry",color=orange];
		j238981216 -> j3575048821;
	j3191687947 [label="以任何形式信任那惡魔都會讓我難以心安，但在這件事上，或許你應該找他談談。只是要小心。惡魔會玩危險的遊戲。",shape=box,color=blue];
		j3191687947 -> j3443510704;
		j3191687947 -> j2604191238;
	j1225607486 [label="我想這或許會讓人感到驚訝，發現身穿聖袍之人並不會嚴格要求他人。我發現向那些不尋求慰藉的人傳道並不太得人心。",shape=box,color=blue];
		j1225607486 -> j2476513638;
	j2271876562 [label="+5 Chemistry",color=orange];
		j2271876562 -> j2373238246;
	j60331163 [label="我只希望你的信仰能帶給你平靜。",shape=box,color=blue];
		j60331163 -> j3850248115;
		j60331163 -> j240258658;
		j60331163 -> j4100622519;
	j3723776537 [label="哦，真是太好了！我非常喜歡學習。我時常在想，聖光會有沒有戴上其他面孔，冠上其他名字，接見世人。",shape=box,color=blue];
		j3723776537 -> j2792745871;
	j3850627846 [label="我想這或許會讓人感到驚訝，發現身穿聖袍之人並不會嚴格要求他人。我發現向那些不尋求慰藉的人傳道並不太得人心。",shape=box,color=blue];
		j3850627846 -> j3694129750;
	j165610067 [label="我只想知道，我們的信仰能為你帶來平靜嗎？",shape=box,color=blue];
		j165610067 -> j3850248115;
		j165610067 -> j240258658;
		j165610067 -> j4100622519;
	j2317527213 [label="那是稀有的天賦……我希望你能善用它。我擔心在十字路口徘徊太久，反而被紛爭吞噬。",shape=box,color=blue];
		j2317527213 -> j560756778;
	j1888027749 [label="那麼，這應該是比較單純的生活。不受諸神和教會的規則約束。我承認我有點嫉妒。",shape=box,color=blue];
		j1888027749 -> j3482643132;
	j1612234078 [label="漂流者，那我很羨慕你！活了大把世紀，都不必認識諸神。",shape=box,color=blue];
		j1612234078 -> j3482643132;
	j3681975857 [label="你聽起來像是太陰的信徒，我這麼說並無冒犯之意。是的，那個老婆婆終將會找上我們所有人，流下她的銀色淚水。但你的話讓我在想……",shape=box,color=blue];
		j3681975857 -> j2381986093;
	j3575048821 [label="是的，這讓我不禁好奇。我看著你、孩子、惡魔、甚至 Loid 先生，或主教……你們都跨越了多少世紀。",shape=box,color=blue];
		j3575048821 -> j1787288142;
	j3443510704 [label="什麼樣的危險遊戲？",shape=box,color=red];
		j3443510704 -> j1355545777;
	j2604191238 [label="他也不認為牆中人是真的？",shape=box,color=red];
		j2604191238 -> j1419122523;
	j2476513638 [label="+5 Chemistry",color=orange];
		j2476513638 -> j2505733748;
	j2373238246 [label="我為你對他人信仰的態度所展現的智慧與善意而感到欣慰。",shape=box,color=blue];
		j2373238246 -> j2828719604;
	j3850248115 [label="沒有。",shape=box,color=red];
		j3850248115 -> j1212824306;
	j240258658 [label="老實說，我不會對這件事想太多。",shape=box,color=red];
		j240258658 -> j1486833808;
	j4100622519 [label="有的。",shape=box,color=red];
		j4100622519 -> j823883828;
	j2792745871 [label="據傳，他們會改變形態以取悅其他教派的信眾。但那是我的信仰，不是你的。我不會向那些不尋求慰藉的人傳道。我發現這麼做並不太得人心。",shape=box,color=blue];
		j2792745871 -> j3694129750;
	j3694129750 [label="不，我的信仰是我的，而你的信仰是你自己的。我只希望這能為你帶來平靜。",shape=box,color=blue];
		j3694129750 -> j3850248115;
		j3694129750 -> j240258658;
		j3694129750 -> j4100622519;
	j560756778 [label="最終，所有人都必須選擇一條道路來行走。然而十字路口是我們所有人的起點，而平衡是所有結構的基礎。",shape=box,color=blue];
		j560756778 -> j1694030817;
	j3482643132 [label="但，我想知道……這種無信仰，能為你帶來平靜嗎？",shape=box,color=blue];
		j3482643132 -> j3850248115;
		j3482643132 -> j240258658;
		j3482643132 -> j4100622519;
	j2381986093 [label="當你說「它會」找上你們所有人時，你指的是誰？我看著你、孩子、惡魔、甚至 Loid 先生，或主教……你們都跨越了多少世紀。",shape=box,color=blue];
		j2381986093 -> j1787288142;
	j1787288142 [label="我不禁思索，我們還要經歷多少個世紀，太陰才會找上我們。我也想知道，當那天來臨，我會多麼熱切地奔向她。但那是我的信仰，不是你的。",shape=box,color=blue];
		j1787288142 -> j3482643132;
	j1355545777 [label="這我還不知道。他像個稱職的惡魔，把自己的陰謀都藏於心底。但他不信奉任何神祇。除了，或許，他自己吧。",shape=box,color=blue];
		j1355545777 -> j3482643132;
	j1419122523 [label="不，他不這麼認為。他跟你很像，不信奉任何神祇。除了，或許，他自己吧。",shape=box,color=blue];
		j1419122523 -> j3482643132;
	j2505733748 [label="不，任何抱著開放心態前來的人都會被開放的雙臂歡迎。",shape=box,color=blue];
		j2505733748 -> j2828719604;
	j2828719604 [label="我只想知道，這能為你帶來平靜嗎？",shape=box,color=blue];
		j2828719604 -> j3850248115;
		j2828719604 -> j240258658;
		j2828719604 -> j4100622519;
	j1212824306 [label="Boolean DrifterFaithNoPeace is now true.",color=orange];
		j1212824306 -> j3556826811;
	j1486833808 [label="+10 Chemistry",color=orange];
		j1486833808 -> j2509251871;
	j823883828 [label="+10 Chemistry",color=orange];
		j823883828 -> j3789774855;
	j1694030817 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j1694030817 -> j3795853547;
	j3556826811 [label="+10 Chemistry",color=orange];
		j3556826811 -> j2571725627;
	j2509251871 [label="我好嫉妒！嫉妒就快吞噬我了。如果你願意的話，我會……很想再與你談論這個話題。我不想傳道或打探。更不想讓你感到困擾。",shape=box,color=blue];
