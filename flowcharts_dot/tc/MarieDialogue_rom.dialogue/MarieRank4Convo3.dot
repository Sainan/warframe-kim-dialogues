digraph {
	"MarieRank4Convo3 begins." [color=orange];
		"MarieRank4Convo3 begins." -> j2258580009;
		"MarieRank4Convo3 begins." -> j1350559949;
	j2258580009 [label="瑪麗，你今天過得怎麼樣？",shape=box,color=red];
		j2258580009 -> j551046363;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j551046363 [label="我不太好。你最好還是明天再來找我聊。我今天大概也說不出什麼好話。",shape=box,color=blue];
		j551046363 -> j2552769502;
		j551046363 -> j1909848076;
		j551046363 -> j3172571445;
	"Chat ends." [color=orange];
	j2552769502 [label="如果你想的話，我可以離開；但如果你想聊，我很樂意傾聽。",shape=box,color=red];
		j2552769502 -> j282192949;
	j1909848076 [label="好的，我明白。",shape=box,color=red];
		j1909848076 -> "Chat ends.";
	j3172571445 [label="我可以問一下發生什麼事嗎……？",shape=box,color=red];
		j3172571445 -> j282192949;
	j282192949 [label="謝謝關心，但這是個老問題……不值得讓你煩心。我會沒事的。",shape=box,color=blue];
		j282192949 -> j3096270068;
	j3096270068 [label="Boolean MarieChronicPain is now true.",color=orange];
		j3096270068 -> j350897449;
		j3096270068 -> j1909063986;
		j3096270068 -> j1801094928;
	j350897449 [label="如果你確定的話。但如果你想聊的話，我在這裡。",shape=box,color=red];
		j350897449 -> j4009352301;
	j1909063986 [label="我……知道那是什麼感覺。在我開始「循環」之前，我在渡域受了重傷。傷口雖然全癒了，但仍然時不時地痛得要命。每當痛起來，我都盡量掩飾自己的痛苦。",shape=box,color=red];
		j1909063986 -> j558170425;
	j1801094928 [label="長期存在的舊患有時跟新痛一樣麻煩。只因為它們反覆出現、一直伴隨我們，並不代表它們不值得被談起。",shape=box,color=red];
		j1801094928 -> j2741851448;
	j4009352301 [label="你真是太善良了，而且……好吧。我又在當固執的小瑪麗了。",shape=box,color=blue];
		j4009352301 -> j449661030;
	j558170425 [label="Boolean DrifterChronicPain is now true.",color=orange];
		j558170425 -> j2113650433;
	j2741851448 [label="是的，你說得對。我又在當固執的小瑪麗了。",shape=box,color=blue];
		j2741851448 -> j449661030;
	j449661030 [label="這事很難解釋，但我試試。我的腳，對不？我的腳。血清改變了我，賦予了我飄浮的能力──",shape=box,color=blue];
		j449661030 -> j3652487400;
	j2113650433 [label="聖光在上，我真的很抱歉。那你就明白那是什麼感覺了，對吧？",shape=box,color=blue];
		j2113650433 -> j859876169;
	j3652487400 [label="但我仍然感覺得到它們，那些扭曲的東西曾威脅要吞噬我，威脅要粉碎我靈魂中所有的希望與喜悅。",shape=box,color=blue];
		j3652487400 -> j1303147238;
	j859876169 [label="擁有一個不聽話、拖累靈魂的身體。即使是現在，這依然感覺很奇怪。血清改變了我，賦予了我漂浮的能力──",shape=box,color=blue];
		j859876169 -> j3652487400;
	j1303147238 [label="它們總是讓我感到很痛。總是如此。即使現在，當我坐在這裡，如果我想到它們，我就會感到疼痛。但這種痛並不總是強烈到引起我注意。",shape=box,color=blue];
		j1303147238 -> j1762825038;
	j1762825038 [label="然而現在，它們仍然會在夜裡痛醒我。而我會想，太陽啊，為什麼？為什麼我還要感受這種……無盡的折磨？",shape=box,color=blue];
		j1762825038 -> j1177448878;
	j1177448878 [label="這有什麼意義呢？啊，但到了早晨，我就會笑著對自己說：「安靜點，瑪麗，你是受到祝福的。看看你擁有的一切，看看你能做的一切」。",shape=box,color=blue];
		j1177448878 -> j2599704914;
	j2599704914 [label="在大教堂裡的時候是這樣，「你能讀，你能寫，你能吃，你能睡。你能四處走動。你有眼睛看，有舌頭說話。有手可以寫字。有關心你的人」。而現在，我甚至能飄浮了！我能保護未來免受虛空本身的侵害。免受漠然的侵害！",shape=box,color=blue];
		j2599704914 -> j618299630;
	j618299630 [label="我對自己說，「哭吧，傻女孩，這種持續的痛苦會讓你更堅強地面對即將到來的一切」。然後日子一天天過去，隔天來臨時又會不覺得那麼糟糕了。",shape=box,color=blue];
		j618299630 -> j830269311;
	j830269311 [label="Check boolean DrifterChronicPain",color=orange];
		j830269311 -> j980891655 [label=true,color=green];
		j830269311 -> j3006769045 [label=true,color=green];
		j830269311 -> j3121117038 [label=false,color=brown];
		j830269311 -> j3223035024 [label=false,color=brown];
	j980891655 [label="如果說這件事帶給了我們什麼，我想那就是忍痛能力吧。",shape=box,color=red];
		j980891655 -> j197266804;
	j3006769045 [label="但有時候……我醒來時會覺得這天是我崩潰的那一天。",shape=box,color=red];
		j3006769045 -> j197266804;
	j3121117038 [label="那種痛……真的是永無止盡的嗎？我真的好抱歉，瑪麗……",shape=box,color=red];
		j3121117038 -> j3624956693;
	j3223035024 [label="而且沒有藥物？沒有治療方法？",shape=box,color=red];
		j3223035024 -> j3559915034;
	j197266804 [label="有位教友曾經問我，「你一直都感到很痛苦嗎？」我回答，「先生，是的。我一直都感到很痛苦」。他驚訝的表情中混雜著恐懼。",shape=box,color=blue];
		j197266804 -> j712314896;
	j3624956693 [label="過去我有時會坐下來想，如果我沒有遭受那麼多磨難，我能做多少事，對不？如果我不是這樣……被困在一個處處都在阻礙我的肉體牢籠裡就好了。",shape=box,color=blue];
		j3624956693 -> j827772126;
	j3559915034 [label="我多麼希望有。但就沒有，什麼都沒有。在我的時代沒有，在這個時代恐怕更不會有。",shape=box,color=blue];
		j3559915034 -> j1505849059;
	j712314896 [label="他接著問，「那你如何繼續下去？」而我記得我微笑著回答他，「先生，我還有別的選擇嗎……？」",shape=box,color=blue];
		j712314896 -> j4198576637;
		j712314896 -> j2477211323;
	j827772126 [label="這讓我好憤怒！我好嫉妒那些生下來身體就不會背叛他們的人。但到頭來這對我們到底有什麼好處？除了讓我們的生活更加痛苦。",shape=box,color=blue];
		j827772126 -> j1383242893;
	j1505849059 [label="有些病痛是超越人類、科學和信仰所能治癒的。",shape=box,color=blue];
		j1505849059 -> j3624956693;
	j4198576637 [label="那同樣的對話我經歷過無數次……",shape=box,color=red];
		j4198576637 -> j3624956693;
	j2477211323 [label="沒錯。我很抱歉。",shape=box,color=red];
		j2477211323 -> j2584282810;
	j1383242893 [label="沒有好處。我就是我，而我將堅持下去。",shape=box,color=blue];
		j1383242893 -> j2980398560;
	j2584282810 [label="不，我只是因為你曾經也經歷過如此相似的折磨而感到抱歉。",shape=box,color=blue];
		j2584282810 -> j3624956693;
	j2980398560 [label="Check boolean DrifterChronicPain",color=orange];
		j2980398560 -> j3198092300 [label=true,color=green];
		j2980398560 -> j2090308637 [label=false,color=brown];
	j3198092300 [label="而你也會。你也將堅持下去。對此，我有信心。",shape=box,color=blue];
		j3198092300 -> j2090308637;
	j2090308637 [label="+20 Chemistry",color=orange];
		j2090308637 -> j3488270520;
	j3488270520 [label="我無法用言語表達這次對話對我有多重要。所以漂泊者，除了想對你說聲感謝以外……",shape=box,color=blue];
		j3488270520 -> j2170765995;
	j2170765995 [label="（法語）還是感謝。",shape=box,color=blue];
		j2170765995 -> "Chat ends.";
}