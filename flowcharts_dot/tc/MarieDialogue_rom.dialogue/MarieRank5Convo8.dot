		"MarieRank5Convo8 begins." -> j1350559949;
	j1674189153 [label="你和「那個惡魔」之間最近處得怎麼樣？",shape=box,color=red];
		j1674189153 -> j520518461;
	j2625642544 [label="[表白心意] 瑪麗，我們能聊聊嗎？",shape=box,color=red];
		j2625642544 -> j3125210104;
	j1350559949 [label="[結束]",shape=box,color=red];
