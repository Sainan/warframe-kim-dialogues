	j520518461 [label="Evaluate expressions",color=orange];
		j520518461 -> j3626370986 [label="RoatheFamilyDelay",color=purple];
		j520518461 -> j1393856700 [label="RoatheDating",color=purple];
		j520518461 -> j3393291753 [label="RoatheRedeemed",color=purple];
		j520518461 -> j3973665636 [label="RoatheVillain",color=purple];
		j520518461 -> j2660493779 [label="false",color=purple];
	j3125210104 [label="（法語）好的，什麼事？",shape=box,color=blue];
		j3125210104 -> j4058777810;
	"Chat ends." [color=orange];
	j3626370986 [label="恐怕我現在必須稱他為「我們的」惡魔了，對不？因為他短時間內不會離開了。哈！",shape=box,color=blue];
		j3626370986 -> j1889446184;
	j1393856700 [label="我覺得我才應該問你這個問題，對不？你現在可是在跟他廝混呢！",shape=box,color=blue];
		j1393856700 -> j3729082700;
	j3393291753 [label="我不知道你是怎麼做到的。但他已經告訴我們他服用血清的真相了。",shape=box,color=blue];
		j3393291753 -> j1993350416;
	j3973665636 [label="我不知道你是怎麼做到的。但他已經告訴我們他服用血清的真相了。",shape=box,color=blue];
	j2660493779 [label="我擔心他。我覺得他傷害自己的程度遠比他表現出來的還深，是不是？",shape=box,color=blue];
		j2660493779 -> j1427549799;
	j4058777810 [label="如果這感覺很突兀我很抱歉，但我之前一直不知道該怎麼告訴你。",shape=box,color=red];
		j4058777810 -> j279741752;
	j1889446184 [label="你在說服他幫助 Loid 先生這件事上做得很好。我原本不認為這能做到。",shape=box,color=blue];
		j1889446184 -> j761094073;
	j3729082700 [label="我在抵抗想問你各種八卦的誘惑。",shape=box,color=blue];
		j3729082700 -> j761094073;
	j1993350416 [label="噢，日君啊，這讓我好心碎。他說這些的時候聲音沒有顫抖。但我彷彿在他眼中看到了。",shape=box,color=blue];
		j1993350416 -> j761094073;
	j1427549799 [label="這讓我好心碎。我希望他的心不會某天在胸裡碎掉。我不知道他能否承受得住。我不知道我們任何人能否承受得住。",shape=box,color=blue];
		j1427549799 -> "Chat ends.";
	j279741752 [label="我愛慕你。我真的非常愛慕你。",shape=box,color=red];
		j279741752 -> j3802285279;
	j761094073 [label="他身上出現了變化。雖然很細微，但確實存在。",shape=box,color=blue];
		j761094073 -> j615837688;
	j3802285279 [label="嗯，我在想……你是否願意，嗯……成為一對情侶？",shape=box,color=red];
		j3802285279 -> j2298753926;
	j615837688 [label="+5 Chemistry",color=orange];
		j615837688 -> j1767881100;
	j2298753926 [label="Evaluate expressions",color=orange];
		j2298753926 -> j521031509 [label="MarieNoDate",color=purple];
		j2298753926 -> j3695442650 [label="MarieWillDate",color=purple];
		j2298753926 -> j521031509 [label="false",color=purple];
	j1767881100 [label="我知道這要歸功於你。",shape=box,color=blue];
		j1767881100 -> j1590214448;
	j521031509 [label="哦！哦，漂泊者。我不知道該怎麼說這個，所以我就直說了。",shape=box,color=blue];
		j521031509 -> j500884510;
	j3695442650 [label="哦，我也有同感！但我不知道該怎麼回應這份心意，我不敢打出這些字！我就連想這種事都會覺得自己好愚蠢！",shape=box,color=blue];
		j3695442650 -> j1441815344;
	j1590214448 [label="我不知道他會不會欣然接受，但他永遠都會有這份友誼。",shape=box,color=blue];
		j1590214448 -> j3258545818;
	j500884510 [label="（法語）不。",shape=box,color=blue];
		j500884510 -> "Chat ends.";
	j1441815344 [label="啊！你讓我好開心！",shape=box,color=blue];
		j1441815344 -> j3168124912;
	j3258545818 [label="不過我想我永遠不會厭倦對他大吼大叫！",shape=box,color=blue];
		j3258545818 -> j2819289812;
		j3258545818 -> j2715134875;
	j3168124912 [label="如果你是在提出一個更……正式的求愛方式，那好！好呀！我願意。",shape=box,color=blue];
		j3168124912 -> j406267537;
		j3168124912 -> j2668081015;
	j2819289812 [label="反正，我覺得他就是喜歡逗弄你。",shape=box,color=red];
		j2819289812 -> j919110004;
	j2715134875 [label="我很高興你們倆找到了某種相處之道。",shape=box,color=red];
		j2715134875 -> j1078535691;
	j406267537 [label="絕對不是在求婚，至少還沒有。",shape=box,color=red];
		j406267537 -> j558720802;
	j2668081015 [label="事情確實有些變化。我不會說它們變得更「正式」，但我絕對很樂意……跟你一起體驗。",shape=box,color=red];
		j2668081015 -> j3930386478;
	j919110004 [label="就像隻大流浪貓一樣。我已經習慣他了。",shape=box,color=blue];
		j919110004 -> j2038748595;
	j1078535691 [label="對！我也是。他每天都變得沒那麼令人難以忍受了。",shape=box,color=blue];
		j1078535691 -> j919110004;
	j558720802 [label="現在換我來逗你了，別擔心。但不管怎麼說，我真的很開心！也很期待去學習這些新的……浪漫習俗。",shape=box,color=blue];
		j558720802 -> j252610036;
	j3930386478 [label="哈！我就知道你想使壞。好吧。我很期待。",shape=box,color=blue];
		j3930386478 -> j252610036;
	j2038748595 [label="我想如果他離開了我會很難過。",shape=box,color=blue];
		j2038748595 -> "Chat ends.";
	j252610036 [label="+10 Chemistry",color=orange];
		j252610036 -> j2601885739;
	j2601885739 [label="在那之前？再見，我的心。",shape=box,color=blue];
		j2601885739 -> j1559150062;
	j1559150062 [label="Boolean MarieDating is now true.",color=orange];
		j1559150062 -> j264962945;
