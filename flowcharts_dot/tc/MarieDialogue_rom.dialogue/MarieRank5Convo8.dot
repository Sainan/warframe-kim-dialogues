	3772 [label="Chat ends.",color=orange];
	3779 [label="恐怕我現在必須稱他為「我們的」惡魔了，對不？因為他短時間內不會離開了。哈！",shape=box,color=blue];
		3779 -> 3784;
	3775 [label="我覺得我才應該問你這個問題，對不？你現在可是在跟他廝混呢！",shape=box,color=blue];
		3775 -> 3781;
	3776 [label="我不知道你是怎麼做到的。但他已經告訴我們他服用血清的真相了。",shape=box,color=blue];
		3776 -> 3782;
	3777 [label="我不知道你是怎麼做到的。但他已經告訴我們他服用血清的真相了。",shape=box,color=blue];
	3778 [label="我擔心他。我覺得他傷害自己的程度遠比他表現出來的還深，是不是？",shape=box,color=blue];
		3778 -> 3783;
	3774 [label="如果這感覺很突兀我很抱歉，但我之前一直不知道該怎麼告訴你。",shape=box,color=red];
		3774 -> 3780;
	3784 [label="你在說服他幫助 Loid 先生這件事上做得很好。我原本不認為這能做到。",shape=box,color=blue];
		3784 -> 3786;
	3781 [label="我在抵抗想問你各種八卦的誘惑。",shape=box,color=blue];
		3781 -> 3786;
	3782 [label="噢，日君啊，這讓我好心碎。他說這些的時候聲音沒有顫抖。但我彷彿在他眼中看到了。",shape=box,color=blue];
		3782 -> 3786;
	3783 [label="這讓我好心碎。我希望他的心不會某天在胸裡碎掉。我不知道他能否承受得住。我不知道我們任何人能否承受得住。",shape=box,color=blue];
		3783 -> 3787;
	3780 [label="我愛慕你。我真的非常愛慕你。",shape=box,color=red];
		3780 -> 3785;
	3786 [label="他身上出現了變化。雖然很細微，但確實存在。",shape=box,color=blue];
		3786 -> 3789;
	3787 [label="Chat ends.",color=orange];
	3785 [label="嗯，我在想……你是否願意，嗯……成為一對情侶？",shape=box,color=red];
		3785 -> 3788;
	3789 [label="+5 Chemistry",color=orange];
		3789 -> 3792;
	3788 [label="Evaluate expressions",color=orange];
		3788 -> 3790 [label="MarieNoDate",color=purple];
		3788 -> 3791 [label="MarieWillDate",color=purple];
		3788 -> 3790 [label="false",color=purple];
	3792 [label="我知道這要歸功於你。",shape=box,color=blue];
		3792 -> 3795;
	3790 [label="哦！哦，漂泊者。我不知道該怎麼說這個，所以我就直說了。",shape=box,color=blue];
		3790 -> 3793;
	3791 [label="哦，我也有同感！但我不知道該怎麼回應這份心意，我不敢打出這些字！我就連想這種事都會覺得自己好愚蠢！",shape=box,color=blue];
		3791 -> 3794;
	3795 [label="我不知道他會不會欣然接受，但他永遠都會有這份友誼。",shape=box,color=blue];
		3795 -> 3798;
	3793 [label="（法語）不。",shape=box,color=blue];
		3793 -> 3796;
	3794 [label="啊！你讓我好開心！",shape=box,color=blue];
		3794 -> 3797;
	3798 [label="不過我想我永遠不會厭倦對他大吼大叫！",shape=box,color=blue];
		3798 -> 3801;
		3798 -> 3802;
	3796 [label="Chat ends.",color=orange];
	3797 [label="如果你是在提出一個更……正式的求愛方式，那好！好呀！我願意。",shape=box,color=blue];
		3797 -> 3799;
		3797 -> 3800;
	3801 [label="反正，我覺得他就是喜歡逗弄你。",shape=box,color=red];
		3801 -> 3805;
	3802 [label="我很高興你們倆找到了某種相處之道。",shape=box,color=red];
		3802 -> 3806;
	3799 [label="絕對不是在求婚，至少還沒有。",shape=box,color=red];
		3799 -> 3803;
	3800 [label="事情確實有些變化。我不會說它們變得更「正式」，但我絕對很樂意……跟你一起體驗。",shape=box,color=red];
		3800 -> 3804;
	3805 [label="就像隻大流浪貓一樣。我已經習慣他了。",shape=box,color=blue];
		3805 -> 3808;
	3806 [label="對！我也是。他每天都變得沒那麼令人難以忍受了。",shape=box,color=blue];
		3806 -> 3805;
	3803 [label="現在換我來逗你了，別擔心。但不管怎麼說，我真的很開心！也很期待去學習這些新的……浪漫習俗。",shape=box,color=blue];
		3803 -> 3807;
	3804 [label="哈！我就知道你想使壞。好吧。我很期待。",shape=box,color=blue];
