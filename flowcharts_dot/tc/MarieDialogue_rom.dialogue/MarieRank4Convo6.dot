		1761 -> 1764 [label=false,color=brown];
	1762 [label="他是個成年人了。他可以決定什麼時候想談。",shape=box,color=red];
		1762 -> 1766;
	1763 [label="看到他經歷這種痛苦讓我心碎。我不知道該如何幫助他。",shape=box,color=red];
		1763 -> 1767;
	1764 [label="[結束]",shape=box,color=red];
		1764 -> 1768;
	1765 [label="我不知道該如何幫助他。",shape=box,color=red];
		1765 -> 1769;
	1766 [label="當你被困在你創造的世界裡，陷入無盡的死亡循環時，你有得到幫助來逃脫嗎？",shape=box,color=blue];
		1766 -> 1770;
		1766 -> 1771;
	1767 [label="是的，看到他受苦讓人很心痛……尤其是現在知道你已經在心中為他空出了位置。",shape=box,color=blue];
		1767 -> 1769;
	1768 [label="Chat ends.",color=orange];
	1769 [label="這是件難事，很難預測他的界限在哪裡。那些界限通常每天都在變化。",shape=box,color=blue];
		1769 -> 1772;
	1770 [label="如果我不想被幫助，他們的幫助就毫無意義了。",shape=box,color=red];
		1770 -> 1773;
		1770 -> 1774;
	1771 [label="有的，來自朋友們。",shape=box,color=red];
		1771 -> 1773;
		1771 -> 1774;
	1772 [label="我見過他與諸神堆在他肩上的苦難掙扎。我知道什麼時候該在他身邊保持沉默，或者什麼時候該成為他可以揮拳擊打的那道牆。",shape=box,color=blue];
		1772 -> 1775;
	1773 [label="我不認為里昂想要我的幫助。",shape=box,color=red];
		1773 -> 1776;
	1774 [label="我試著陪在他身邊，但他不為所動。",shape=box,color=red];
		1774 -> 1777;
	1775 [label="但是，這個？這個地方、惡魔的話語、主教造成的不確定性……這些都給他帶來了痛苦，我祈禱他能從中恢復過來。",shape=box,color=blue];
		1775 -> 1778;
		1775 -> 1779;
	1776 [label="那我想……除了保持耐心以外，也沒什麼可做的了，對不？",shape=box,color=blue];
		1776 -> 1780;
	1777 [label="他對我也一樣不為所動，所以我才過來和你討論這件事。我一直都能安慰他──",shape=box,color=blue];
		1777 -> 1781;
	1778 [label="所以你承認源拓氏傷害了里昂嗎？那你對此有何感想？",shape=box,color=red];
		1778 -> 1782;
	1779 [label="我覺得他正處於崩潰邊緣。我要怎麼把他拉回來？",shape=box,color=red];
		1779 -> 1783;
	1780 [label="謝謝。很抱歉浪費你的時間。",shape=box,color=blue];
		1780 -> 1784;
	1781 [label="我發現自己對他的憤怒、他的絕望感到錯愕……他以前從未有過的方式迴避我的陪伴。",shape=box,color=blue];
		1781 -> 1785;
	1782 [label="不太好……但我怎麼能在弟兄的愛和主教的崇敬之間做選擇？我又怎麼能在我家人之間做選擇？",shape=box,color=blue];
		1782 -> 1786;
		1782 -> 1787;
		1782 -> 1788;
		1782 -> 3961;
	1783 [label="我不知道，所以我才過來和你討論這件事。我一直都能安慰他──",shape=box,color=blue];
		1783 -> 1781;
	1784 [label="Chat ends.",color=orange];
	1785 [label="是什麼讓他如此困擾？你可知道原因？",shape=box,color=blue];
		1785 -> 1789;
	1786 [label="瑪麗，你不必做選擇。人們在我們生命中存在的方式可以很複雜。",shape=box,color=red];
		1786 -> 1790;
	1787 [label="我會選擇仍在這裡的家人。而不是拋棄你的那個。",shape=box,color=red];
		1787 -> 1791;
	1788 [label="我相信源拓氏也不想給里昂造成這種痛苦。",shape=box,color=red];
		1788 -> 1792;
	3961 [label="你可以選擇一個新的家庭。比如我。還有你身邊那些關心你的人，沒有源拓氏也行。",shape=box,color=red];
		3961 -> 3962;
	1789 [label="Evaluate expressions",color=orange];
		1789 -> 1793 [label="DrifterFaithNoMITW",color=purple];
