	j2249036439 [label="漂泊者？你有空嗎？我必須跟你談談關於里昂的事……",shape=box,color=blue];
		j2249036439 -> j1531216646;
	"Chat ends." [color=orange];
	j1531216646 [label="Check boolean DrifterLyon",color=orange];
		j1531216646 -> j1860291902 [label=true,color=green];
		j1531216646 -> j1109401715 [label=true,color=green];
		j1531216646 -> j1350559949 [label=true,color=green];
		j1531216646 -> j1860291902 [label=false,color=brown];
		j1531216646 -> j3470692310 [label=false,color=brown];
		j1531216646 -> j1350559949 [label=false,color=brown];
	j1860291902 [label="他是個成年人了。他可以決定什麼時候想談。",shape=box,color=red];
		j1860291902 -> j2222605045;
	j1109401715 [label="看到他經歷這種痛苦讓我心碎。我不知道該如何幫助他。",shape=box,color=red];
		j1109401715 -> j1117549374;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j3470692310 [label="我不知道該如何幫助他。",shape=box,color=red];
		j3470692310 -> j875746867;
	j2222605045 [label="當你被困在你創造的世界裡，陷入無盡的死亡循環時，你有得到幫助來逃脫嗎？",shape=box,color=blue];
		j2222605045 -> j3011075854;
		j2222605045 -> j2078917189;
	j1117549374 [label="是的，看到他受苦讓人很心痛……尤其是現在知道你已經在心中為他空出了位置。",shape=box,color=blue];
		j1117549374 -> j875746867;
	j875746867 [label="這是件難事，很難預測他的界限在哪裡。那些界限通常每天都在變化。",shape=box,color=blue];
		j875746867 -> j3905840285;
	j3011075854 [label="如果我不想被幫助，他們的幫助就毫無意義了。",shape=box,color=red];
		j3011075854 -> j1533302346;
		j3011075854 -> j151412831;
	j2078917189 [label="有的，來自朋友們。",shape=box,color=red];
		j2078917189 -> j1533302346;
		j2078917189 -> j151412831;
	j3905840285 [label="我見過他與諸神堆在他肩上的苦難掙扎。我知道什麼時候該在他身邊保持沉默，或者什麼時候該成為他可以揮拳擊打的那道牆。",shape=box,color=blue];
		j3905840285 -> j2200336438;
	j1533302346 [label="我不認為里昂想要我的幫助。",shape=box,color=red];
		j1533302346 -> j3838988150;
	j151412831 [label="我試著陪在他身邊，但他不為所動。",shape=box,color=red];
		j151412831 -> j3050489946;
	j2200336438 [label="但是，這個？這個地方、惡魔的話語、主教造成的不確定性……這些都給他帶來了痛苦，我祈禱他能從中恢復過來。",shape=box,color=blue];
		j2200336438 -> j3130573794;
		j2200336438 -> j1994726192;
	j3838988150 [label="那我想……除了保持耐心以外，也沒什麼可做的了，對不？",shape=box,color=blue];
		j3838988150 -> j1116672978;
	j3050489946 [label="他對我也一樣不為所動，所以我才過來和你討論這件事。我一直都能安慰他──",shape=box,color=blue];
		j3050489946 -> j3701700498;
	j3130573794 [label="所以你承認源拓氏傷害了里昂嗎？那你對此有何感想？",shape=box,color=red];
		j3130573794 -> j663906936;
	j1994726192 [label="我覺得他正處於崩潰邊緣。我要怎麼把他拉回來？",shape=box,color=red];
		j1994726192 -> j3669229462;
	j1116672978 [label="謝謝。很抱歉浪費你的時間。",shape=box,color=blue];
		j1116672978 -> "Chat ends.";
	j3701700498 [label="我發現自己對他的憤怒、他的絕望感到錯愕……他以前從未有過的方式迴避我的陪伴。",shape=box,color=blue];
		j3701700498 -> j3613341129;
	j663906936 [label="不太好……但我怎麼能在弟兄的愛和主教的崇敬之間做選擇？我又怎麼能在我家人之間做選擇？",shape=box,color=blue];
		j663906936 -> j2801038497;
		j663906936 -> j1819429418;
		j663906936 -> j3203945346;
		j663906936 -> j110466646;
	j3669229462 [label="我不知道，所以我才過來和你討論這件事。我一直都能安慰他──",shape=box,color=blue];
		j3669229462 -> j3701700498;
	j3613341129 [label="是什麼讓他如此困擾？你可知道原因？",shape=box,color=blue];
		j3613341129 -> j2411453274;
	j2801038497 [label="瑪麗，你不必做選擇。人們在我們生命中存在的方式可以很複雜。",shape=box,color=red];
		j2801038497 -> j1650375222;
	j1819429418 [label="我會選擇仍在這裡的家人。而不是拋棄你的那個。",shape=box,color=red];
		j1819429418 -> j1790100609;
	j3203945346 [label="我相信源拓氏也不想給里昂造成這種痛苦。",shape=box,color=red];
		j3203945346 -> j2275681794;
	j110466646 [label="你可以選擇一個新的家庭。比如我。還有你身邊那些關心你的人，沒有源拓氏也行。",shape=box,color=red];
		j110466646 -> j3104969389;
	j2411453274 [label="Evaluate expressions",color=orange];
		j2411453274 -> j3511191157 [label="DrifterFaithNoMITW",color=purple];
		j2411453274 -> j3793841110 [label="DrifterFaithNoMITW",color=purple];
		j2411453274 -> j2371407426 [label="LyonRell3",color=purple];
		j2411453274 -> j3793841110 [label="LyonRell3",color=purple];
		j2411453274 -> j1578212185 [label="LyonRoathe3",color=purple];
		j2411453274 -> j3793841110 [label="LyonRoathe3",color=purple];
		j2411453274 -> j421531637 [label="LyonEntrati3",color=purple];
		j2411453274 -> j3793841110 [label="LyonEntrati3",color=purple];
		j2411453274 -> j3793841110 [label="LyonRell1",color=purple];
		j2411453274 -> j255517251 [label="false",color=purple];
	j1650375222 [label="這就是像源拓氏這樣的人的問題。他們不只代表「善」或「惡」的勢力，而是善惡的混合體。",shape=box,color=red];
		j1650375222 -> j1296466287;
	j1790100609 [label="我們別把主教的事帶入這次對話，好嗎？我擔心我的靈魂弟兄。",shape=box,color=blue];
		j1790100609 -> j3701700498;
	j2275681794 [label="我也不認為他想，但事實就是如此，對吧？但我感謝你有這個心意。話雖如此……",shape=box,color=blue];
		j2275681794 -> j1790100609;
	j3104969389 [label="Boolean DrifterMarie is now true.",color=orange];
		j3104969389 -> j2309530753;
	j3511191157 [label="里昂正試圖接受漠然並非真神的這個事實。",shape=box,color=red];
		j3511191157 -> j3143832587;
	j3793841110 [label="我不認為這只是單一事件造成的。我認為這是夾雜在許多事情之間導致的結果。",shape=box,color=red];
		j3793841110 -> j4038529312;
	j2371407426 [label="里昂一直聽到其中一名 Tenno 的聲音，一個名叫 Rell 的孩子。而 Rell……已經不在了。我覺得他很難去接受這件事。",shape=box,color=red];
		j2371407426 -> j2057368187;
	j1578212185 [label="羅瑟一直在他耳邊低語關於牆中人的謊言。",shape=box,color=red];
		j1578212185 -> j1351734739;
	j421531637 [label="我並不認為讓源拓氏在他耳邊低語，告訴他他所信奉的諸神的聲音實際上來自虛空，對他的情況會有什麼幫助。",shape=box,color=red];
		j421531637 -> j191351154;
	j255517251 [label="老實說，我不知道。",shape=box,color=red];
		j255517251 -> j1991997598;
	j1296466287 [label="我們別把主教的事帶入這次對話，好嗎？我擔心我的靈魂弟兄。但……我知道你說的……越來越明顯是真的。",shape=box,color=blue];
		j1296466287 -> j271915085;
	j2309530753 [label="漂泊狼，別以為我沒看出來你做了什麼，把自己偷偷排在第一順位。",shape=box,color=blue];
		j2309530753 -> j1296466287;
	j3143832587 [label="如果你以這種方式和他溝通，你在這些事上也沒有幫到忙。即使一個人的話是真的，也必須小心如何傳達。",shape=box,color=blue];
		j3143832587 -> j477301674;
	j4038529312 [label="是的，他一直是許多人在風暴中的避風港……而現在他自己卻身陷風暴之中。",shape=box,color=blue];
		j4038529312 -> j2925785472;
	j2057368187 [label="我聽他說過那個名字，Rell，而得知那孩子的命運讓我心碎。",shape=box,color=blue];
		j2057368187 -> j2740314830;
	j1351734739 [label="那個惡魔在他漫長的一生中造成的悲哀比許多人都還多！但我不認為這是他痛苦的唯一原因，對不？",shape=box,color=blue];
		j1351734739 -> j2552344963;
	j191351154 [label="拜託，不要再提主教的事了。我不否認他的話加劇了里昂的痛苦，但這不可能是唯一的原因。",shape=box,color=blue];
		j191351154 -> j2636190005;
	j1991997598 [label="那我想……我們能做的就是保持耐心，希望我們能發現困擾他的是什麼。",shape=box,color=blue];
		j1991997598 -> j4015683280;
	j271915085 [label="Boolean MarieEntrati4a is now true.",color=orange];
		j271915085 -> j3701700498;
	j477301674 [label="手術最不該用斧頭來做。這裡可不是不列坦海軍。",shape=box,color=blue];
		j477301674 -> j3747968191;
	j2925785472 [label="被四面八方撕扯，不知道該往何處走……",shape=box,color=blue];
		j2925785472 -> j2379938301;
		j2925785472 -> j742158069;
	j2740314830 [label="但我不認為這是他痛苦的唯一原因。里昂追隨月尊的道路。而死亡與他結伴同行。",shape=box,color=blue];
		j2740314830 -> j3747968191;
	j2552344963 [label="這加劇了他的不安……但他把惡魔的話如此看重，我的里昂應該更明智才對。我認為現在有許多事情都壓在他身上。",shape=box,color=blue];
		j2552344963 -> j2500831947;
		j2552344963 -> j966439027;
	j2636190005 [label="Boolean MarieEntrati4b is now true.",color=orange];
		j2636190005 -> j3967971145;
	j4015683280 [label="+15 Chemistry",color=orange];
		j4015683280 -> j2367047585;
	j3747968191 [label="不，我認為現在有許多事情都壓在他身上。",shape=box,color=blue];
		j3747968191 -> j2500831947;
		j3747968191 -> j966439027;
	j2379938301 [label="那我們要成為他的避風港。一個他知道不會傷害他的地方。",shape=box,color=red];
		j2379938301 -> j222212104;
	j742158069 [label="我們需要為他指引回到安全的地方。成為黑暗中的亮光。",shape=box,color=red];
		j742158069 -> j3638154389;
	j2500831947 [label="那我想……我們需要為他指引回到安全的地方。成為黑暗中的亮光。",shape=box,color=red];
		j2500831947 -> j3638154389;
	j966439027 [label="那我想……我們只需要成為他的避風港。一個他知道不會傷害他的地方。",shape=box,color=red];
		j966439027 -> j3581485819;
	j3967971145 [label="他沒有把主教的話看得太重，以至於被它推入如此的黑暗深淵。我認為現在有許多事情都壓在他身上。",shape=box,color=blue];
		j3967971145 -> j966439027;
		j3967971145 -> j2500831947;
	j2367047585 [label="謝謝。我知道你在盡力。對此，我心存感激。",shape=box,color=blue];
		j2367047585 -> "Chat ends.";
	j222212104 [label="+10 Chemistry",color=orange];
		j222212104 -> j2941542688;
	j3638154389 [label="你要如何幫助一個聽不到你呼喚、看不到你的光的人？不，月尊已經將他籠罩在這黑暗之中了。",shape=box,color=blue];
		j3638154389 -> j135108618;
	j3581485819 [label="+5 Chemistry",color=orange];
		j3581485819 -> j2941542688;
	j2941542688 [label="是的，我想你說得對。當他對一切都失去希望時，我們必須成為那些他可以求助的人。",shape=box,color=blue];
		j2941542688 -> j1545169275;
	j135108618 [label="我認為即使太陽的光也無法穿透這層面紗。",shape=box,color=blue];
		j135108618 -> j1545169275;
	j1545169275 [label="當他的信仰有可能動搖時，我們必須成為他腳下的土地。",shape=box,color=blue];
		j1545169275 -> j3744981380;
	j3744981380 [label="如果所有看不見的聲音已經從友善的幽靈變成暗中困擾他的惡魔──",shape=box,color=blue];
		j3744981380 -> j1197161228;
	j1197161228 [label="我們更要讓自己變得更加真實，對不？",shape=box,color=blue];
		j1197161228 -> j153207674;
		j1197161228 -> j3892794582;
	j153207674 [label="我會繼續努力。",shape=box,color=red];
		j153207674 -> j3241111803;
	j3892794582 [label="我只希望這樣不會讓他崩潰。",shape=box,color=red];
		j3892794582 -> j2618304347;
	j3241111803 [label="+10 Chemistry",color=orange];
		j3241111803 -> j1696196127;
	j2618304347 [label="+5 Chemistry",color=orange];
		j2618304347 -> j4231523321;
	j1696196127 [label="最終，我們能做的就只有這樣了。",shape=box,color=blue];
		j1696196127 -> j4154464763;
	j4231523321 [label="是的……我也希望。但我們能做的就是站在他身邊祈禱了，對不？",shape=box,color=blue];
		j4231523321 -> j750809182;
	j4154464763 [label="盡人事、聽天命。",shape=box,color=blue];
		j4154464763 -> j3213298109;
	j750809182 [label="並希望一切都還來得及。",shape=box,color=blue];
		j750809182 -> j3213298109;
	j3213298109 [label="謝謝……我必須走了。如果這次對話沒有什麼用處的話，很抱歉。當我束手無策時，我就會感到焦慮。",shape=box,color=blue];
		j3213298109 -> j1007536054;
		j3213298109 -> j1556583434;
	j1007536054 [label="我也一樣。但有時候，草率行動不會是正確的選擇。",shape=box,color=red];
		j1007536054 -> j1380718947;
	j1556583434 [label="我相信他會沒事的。",shape=box,color=red];
		j1556583434 -> j1380718947;
	j1380718947 [label="我祈禱你是對的。我不知道沒有他我該怎麼辦。",shape=box,color=blue];
