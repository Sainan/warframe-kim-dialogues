		1789 -> 1795 [label="LyonRell1",color=purple];
		1789 -> 1796 [label="false",color=purple];
	1790 [label="這就是像源拓氏這樣的人的問題。他們不只代表「善」或「惡」的勢力，而是善惡的混合體。",shape=box,color=red];
		1790 -> 1799;
	1791 [label="我們別把主教的事帶入這次對話，好嗎？我擔心我的靈魂弟兄。",shape=box,color=blue];
		1791 -> 1781;
	1792 [label="我也不認為他想，但事實就是如此，對吧？但我感謝你有這個心意。話雖如此……",shape=box,color=blue];
		1792 -> 1791;
	3962 [label="Update boolean DrifterMarie",color=orange];
		3962 -> 3963;
	1793 [label="里昂正試圖接受漠然並非真神的這個事實。",shape=box,color=red];
		1793 -> 1800;
	1795 [label="我不認為這只是單一事件造成的。我認為這是夾雜在許多事情之間導致的結果。",shape=box,color=red];
		1795 -> 1802;
	1797 [label="里昂一直聽到其中一名 Tenno 的聲音，一個名叫 Rell 的孩子。而 Rell……已經不在了。我覺得他很難去接受這件事。",shape=box,color=red];
		1797 -> 1804;
	1798 [label="羅瑟一直在他耳邊低語關於牆中人的謊言。",shape=box,color=red];
		1798 -> 1805;
	1794 [label="我並不認為讓源拓氏在他耳邊低語，告訴他他所信奉的諸神的聲音實際上來自虛空，對他的情況會有什麼幫助。",shape=box,color=red];
		1794 -> 1801;
	1796 [label="老實說，我不知道。",shape=box,color=red];
		1796 -> 1803;
	1799 [label="我們別把主教的事帶入這次對話，好嗎？我擔心我的靈魂弟兄。但……我知道你說的……越來越明顯是真的。",shape=box,color=blue];
		1799 -> 1806;
	3963 [label="漂泊狼，別以為我沒看出來你做了什麼，把自己偷偷排在第一順位。",shape=box,color=blue];
		3963 -> 1799;
	1800 [label="如果你以這種方式和他溝通，你在這些事上也沒有幫到忙。即使一個人的話是真的，也必須小心如何傳達。",shape=box,color=blue];
		1800 -> 1807;
	1802 [label="是的，他一直是許多人在風暴中的避風港……而現在他自己卻身陷風暴之中。",shape=box,color=blue];
		1802 -> 1809;
	1804 [label="我聽他說過那個名字，Rell，而得知那孩子的命運讓我心碎。",shape=box,color=blue];
		1804 -> 1811;
	1805 [label="那個惡魔在他漫長的一生中造成的悲哀比許多人都還多！但我不認為這是他痛苦的唯一原因，對不？",shape=box,color=blue];
		1805 -> 1812;
	1801 [label="拜託，不要再提主教的事了。我不否認他的話加劇了里昂的痛苦，但這不可能是唯一的原因。",shape=box,color=blue];
		1801 -> 1808;
	1803 [label="那我想……我們能做的就是保持耐心，希望我們能發現困擾他的是什麼。",shape=box,color=blue];
		1803 -> 1810;
	1806 [label="Update boolean MarieEntrati4a",color=orange];
		1806 -> 1781;
	1807 [label="手術最不該用斧頭來做。這裡可不是不列坦海軍。",shape=box,color=blue];
		1807 -> 1813;
	1809 [label="被四面八方撕扯，不知道該往何處走……",shape=box,color=blue];
		1809 -> 1815;
		1809 -> 1816;
	1811 [label="但我不認為這是他痛苦的唯一原因。里昂追隨月尊的道路。而死亡與他結伴同行。",shape=box,color=blue];
		1811 -> 1813;
	1812 [label="這加劇了他的不安……但他把惡魔的話如此看重，我的里昂應該更明智才對。我認為現在有許多事情都壓在他身上。",shape=box,color=blue];
		1812 -> 1818;
		1812 -> 1819;
	1808 [label="Update boolean MarieEntrati4b",color=orange];
		1808 -> 1814;
	1810 [label="+15 Chemistry",color=orange];
		1810 -> 1817;
	1813 [label="不，我認為現在有許多事情都壓在他身上。",shape=box,color=blue];
		1813 -> 1818;
		1813 -> 1819;
	1815 [label="那我們要成為他的避風港。一個他知道不會傷害他的地方。",shape=box,color=red];
		1815 -> 1820;
	1816 [label="我們需要為他指引回到安全的地方。成為黑暗中的亮光。",shape=box,color=red];
		1816 -> 1821;
	1818 [label="那我想……我們需要為他指引回到安全的地方。成為黑暗中的亮光。",shape=box,color=red];
		1818 -> 1821;
	1819 [label="那我想……我們只需要成為他的避風港。一個他知道不會傷害他的地方。",shape=box,color=red];
		1819 -> 1823;
	1814 [label="他沒有把主教的話看得太重，以至於被它推入如此的黑暗深淵。我認為現在有許多事情都壓在他身上。",shape=box,color=blue];
		1814 -> 1819;
		1814 -> 1818;
	1817 [label="謝謝。我知道你在盡力。對此，我心存感激。",shape=box,color=blue];
		1817 -> 1822;
	1820 [label="+10 Chemistry",color=orange];
		1820 -> 1824;
	1821 [label="你要如何幫助一個聽不到你呼喚、看不到你的光的人？不，月尊已經將他籠罩在這黑暗之中了。",shape=box,color=blue];
		1821 -> 1825;
	1823 [label="+5 Chemistry",color=orange];
		1823 -> 1824;
	1822 [label="Chat ends.",color=orange];
	1824 [label="是的，我想你說得對。當他對一切都失去希望時，我們必須成為那些他可以求助的人。",shape=box,color=blue];
		1824 -> 1826;
	1825 [label="我認為即使太陽的光也無法穿透這層面紗。",shape=box,color=blue];
		1825 -> 1826;
	1826 [label="當他的信仰有可能動搖時，我們必須成為他腳下的土地。",shape=box,color=blue];
		1826 -> 1827;
	1827 [label="如果所有看不見的聲音已經從友善的幽靈變成暗中困擾他的惡魔──",shape=box,color=blue];
		1827 -> 1828;
	1828 [label="我們更要讓自己變得更加真實，對不？",shape=box,color=blue];
		1828 -> 1829;
		1828 -> 1830;
	1829 [label="我會繼續努力。",shape=box,color=red];
		1829 -> 1831;
	1830 [label="我只希望這樣不會讓他崩潰。",shape=box,color=red];
		1830 -> 1832;
	1831 [label="+10 Chemistry",color=orange];
		1831 -> 1833;
	1832 [label="+5 Chemistry",color=orange];
		1832 -> 1834;
	1833 [label="最終，我們能做的就只有這樣了。",shape=box,color=blue];
		1833 -> 1835;
	1834 [label="是的……我也希望。但我們能做的就是站在他身邊祈禱了，對不？",shape=box,color=blue];
		1834 -> 1836;
	1835 [label="盡人事、聽天命。",shape=box,color=blue];
		1835 -> 1837;
	1836 [label="並希望一切都還來得及。",shape=box,color=blue];
		1836 -> 1837;
	1837 [label="謝謝……我必須走了。如果這次對話沒有什麼用處的話，很抱歉。當我束手無策時，我就會感到焦慮。",shape=box,color=blue];
		1837 -> 1838;
		1837 -> 1839;
	1838 [label="我也一樣。但有時候，草率行動不會是正確的選擇。",shape=box,color=red];
		1838 -> 1840;
	1839 [label="我相信他會沒事的。",shape=box,color=red];
		1839 -> 1840;
	1840 [label="我祈禱你是對的。我不知道沒有他我該怎麼辦。",shape=box,color=blue];
