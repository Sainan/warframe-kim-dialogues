		1843 -> 1844 [label="x >= 0",color=purple];
		1843 -> 1845 [label="x <= 0",color=purple];
		1843 -> 1845 [label="false",color=purple];
	1844 [label="漂泊者，不好意思……你真的認為幫助惡魔是明智之舉嗎？",shape=box,color=blue];
		1844 -> 1846;
	1845 [label="Chat ends.",color=orange];
	1846 [label="我不想拒絕那些尋求救贖或救助的人，但……我認為這兩者都不是惡魔真正想要的。",shape=box,color=blue];
		1846 -> 1847;
		1846 -> 1848;
		1846 -> 1849;
		1846 -> 1850;
	1847 [label="那你認為他真正想要什麼？",shape=box,color=red];
		1847 -> 1851;
	1848 [label="我知道你們兩個相處不好，對此我很抱歉。但我不能就這樣把他趕出去。",shape=box,color=red];
		1848 -> 1852;
	1849 [label="其實，關於 Orokin 的一切，羅瑟已經忘了很多，比我們永遠能知道的還要多。我們需要他。",shape=box,color=red];
		1849 -> 1853;
	1850 [label="[結束]",shape=box,color=red];
		1850 -> 1854;
	1851 [label="他很有野性。當你提供食物和溫暖住所時，他可能會靠近，但當你對他不再有用時，這一切便會消失。",shape=box,color=blue];
		1851 -> 1855;
	1852 [label="Add 1 to Thermostat",color=orange];
		1852 -> 1856;
	1853 [label="Add -1 to Thermostat",color=orange];
		1853 -> 1851;
	1854 [label="Chat ends.",color=orange];
	1855 [label="他想從你和我們這裡得到什麼。",shape=box,color=blue];
		1855 -> 1857;
	1856 [label="不，我也不是建議你這麼做。只是他……不值得信任。現在不值得，永遠都不值得。",shape=box,color=blue];
		1856 -> 1851;
	1857 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		1857 -> 1859 [label="x > 5",color=purple];
		1857 -> 1858 [label="x <= 5",color=purple];
