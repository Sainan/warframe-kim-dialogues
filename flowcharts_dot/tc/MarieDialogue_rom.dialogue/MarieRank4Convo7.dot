digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank4Convo7 begins." [color=orange];
		"MarieRank4Convo7 begins." -> j2946575423;
	j2946575423 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j2946575423 -> j3255816954;
	j3255816954 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j3255816954 -> j172757053 [label="x >= 0",color=purple];
		j3255816954 -> "Chat ends." [label="x <= 0",color=purple];
		j3255816954 -> "Chat ends." [label="false",color=purple];
	j172757053 [label="漂泊者，不好意思……你真的認為幫助惡魔是明智之舉嗎？",shape=box,color=blue];
		j172757053 -> j1611099622;
	"Chat ends." [color=orange];
	j1611099622 [label="我不想拒絕那些尋求救贖或救助的人，但……我認為這兩者都不是惡魔真正想要的。",shape=box,color=blue];
		j1611099622 -> j1024195111;
		j1611099622 -> j34595329;
		j1611099622 -> j1240263526;
		j1611099622 -> j1350559949;
	j1024195111 [label="那你認為他真正想要什麼？",shape=box,color=red];
		j1024195111 -> j1304348326;
	j34595329 [label="我知道你們兩個相處不好，對此我很抱歉。但我不能就這樣把他趕出去。",shape=box,color=red];
		j34595329 -> j3027752301;
	j1240263526 [label="其實，關於 Orokin 的一切，羅瑟已經忘了很多，比我們永遠能知道的還要多。我們需要他。",shape=box,color=red];
		j1240263526 -> j2034309669;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j1304348326 [label="他很有野性。當你提供食物和溫暖住所時，他可能會靠近，但當你對他不再有用時，這一切便會消失。",shape=box,color=blue];
		j1304348326 -> j2323611290;
	j3027752301 [label="Add 1 to Thermostat counter",color=orange];
		j3027752301 -> j4062790983;
	j2034309669 [label="Add -1 to Thermostat counter",color=orange];
		j2034309669 -> j1304348326;
	j2323611290 [label="他想從你和我們這裡得到什麼。",shape=box,color=blue];
		j2323611290 -> j863296879;
	j4062790983 [label="不，我也不是建議你這麼做。只是他……不值得信任。現在不值得，永遠都不值得。",shape=box,color=blue];
		j4062790983 -> j1304348326;
	j863296879 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j863296879 -> j4093421340 [label="x > 5",color=purple];
		j863296879 -> j218491644 [label="x <= 5",color=purple];
		j863296879 -> j218491644 [label="false",color=purple];
	j4093421340 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4093421340 -> j1563892851 [label="x >= 21",color=purple];
		j4093421340 -> j3789982112 [label="x < 21",color=purple];
		j4093421340 -> j3789982112 [label="false",color=purple];
	j218491644 [label="他失去的那些記憶，那些過去在桃源的可怕經歷……我擔心它們預示著什麼。",shape=box,color=blue];
		j218491644 -> j2524410769;
		j218491644 -> j1758341666;
	j1563892851 [label="我知道你以為我們已經揭開了他破碎的心靈裡的一切。",shape=box,color=blue];
		j1563892851 -> j1947121348;
		j1563892851 -> j1758341666;
	j3789982112 [label="我們了解得越多，越深入探究他破碎的心靈，我就感到越不安。危險也變得越清晰。",shape=box,color=blue];
		j3789982112 -> j1758341666;
		j3789982112 -> j2524410769;
	j2524410769 [label="我不認為他一旦恢復記憶就會不見人影。這件事沒有那麼簡單。",shape=box,color=red];
		j2524410769 -> j1882815273;
	j1758341666 [label="他可能還在尋找更多。不是從他的記憶裡，而是從我們這裡。",shape=box,color=red];
		j1758341666 -> j1619289017;
	j1947121348 [label="當他說這就是我們能發現的全部時，我相信他。而如果真是這樣，那他為什麼還在這裡？",shape=box,color=red];
		j1947121348 -> j1882815273;
	j1882815273 [label="我承認我更擔心他打算利用這些知識做什麼，而不是知識本身。",shape=box,color=blue];
		j1882815273 -> j2593505426;
	j1619289017 [label="是的！這正是我擔心的。但究竟是什麼？我們現在對他有什麼用處？",shape=box,color=blue];
		j1619289017 -> j2593505426;
	j2593505426 [label="無論他打算如何運用他的新生命，我擔心他打算把我們牽扯進來。我只是希望我們不要因為希望他無害而盲目行事。",shape=box,color=blue];
		j2593505426 -> j2920565;
		j2593505426 -> j3359204197;
		j2593505426 -> j320367941;
	j2920565 [label="我同意你的看法。我不信任他。",shape=box,color=red];
		j2920565 -> j1984196563;
	j3359204197 [label="他強大且博學。他是我更希望站在我這邊的人。",shape=box,color=red];
		j3359204197 -> j1128555387;
	j320367941 [label="想著他會不會背叛我們沒有任何好處；他還沒有。而且我不會因為尚未犯下的罪而判一個人有罪。",shape=box,color=red];
		j320367941 -> j1770838406;
	j1984196563 [label="+20 Chemistry",color=orange];
		j1984196563 -> j1982708740;
	j1128555387 [label="Add -1 to Thermostat counter",color=orange];
		j1128555387 -> j3564505773;
	j1770838406 [label="Add 1 to Thermostat counter",color=orange];
		j1770838406 -> j1515307420;
	j1982708740 [label="太好了！至少我知道還有其他雙眼睛在盯著那個惡魔，我會安心一些。這也許能幫我入睡。謝謝。",shape=box,color=blue];
		j1982708740 -> j3984234322;
	j3564505773 [label="是的，但我想知道那樣的結最終的真正代價是什麼。你可能不會為付出的代價而感到高興。",shape=box,color=blue];
		j3564505773 -> j3841709388;
	j1515307420 [label="是的……我想你說得對。我們不能草木皆兵。我們必須與所有希望看到漠然被擊敗的人肩並肩作戰。",shape=box,color=blue];
		j1515307420 -> j808986917;
	j3984234322 [label="Boolean MarieRoatheNoTrust is now true.",color=orange];
		j3984234322 -> "Chat ends.";
	j3841709388 [label="我只想勸你要小心……他是個披著紳士外衣的怪物。拜託要小心他，好嗎？",shape=box,color=blue];
		j3841709388 -> j692516802;
		j3841709388 -> j1057414721;
	j808986917 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j808986917 -> j3103614027 [label=true,color=green];
		j808986917 -> j3170044436 [label=false,color=brown];
	j692516802 [label="我覺得你對他有點不公平。",shape=box,color=red];
		j692516802 -> j1334244598;
	j1057414721 [label="我會小心的。我保證。",shape=box,color=red];
		j1057414721 -> j3103615950;
	j3103614027 [label="即使你相信背後的力量不是源於神而是源於我們自己的心靈，它仍然是個威脅。",shape=box,color=blue];
		j3103614027 -> j3841709388;
	j3170044436 [label="即使他相信背後的力量不是源於神祇而是源於我們自己的心靈，它仍然是個威脅。",shape=box,color=blue];
		j3170044436 -> j3841709388;
	j1334244598 [label="Add -1 to Thermostat counter",color=orange];
		j1334244598 -> j1558160392;
	j3103615950 [label="+20 Chemistry",color=orange];
		j3103615950 -> j708965419;
	j1558160392 [label="會嗎？怎麼說？我沒有殘忍的意思，我真的很好奇。",shape=box,color=blue];
		j1558160392 -> j1175228245;
		j1558160392 -> j687455948;
		j1558160392 -> j4224989394;
		j1558160392 -> j1815271358;
	j708965419 [label="謝謝。我只能要求這樣了。",shape=box,color=blue];
		j708965419 -> "Chat ends.";
	j1175228245 [label="他在不同的社會、不同的時代長大，有著不同的期望。我們可能不喜歡，但他就是他。",shape=box,color=red];
		j1175228245 -> j265337221;
	j687455948 [label="你和里昂是自願接受源拓氏的原型 Warframe 血清的。他不是。你能想像那是什麼感覺嗎？",shape=box,color=red];
		j687455948 -> j816303589;
		j687455948 -> j2049917822;
		j687455948 -> j265337221;
	j4224989394 [label="他經歷了幾個世紀的生活，做著他認為必要的事。我們只是對什麼是必要的事有著不同看法。",shape=box,color=red];
		j4224989394 -> j816303589;
		j4224989394 -> j1774310568;
	j1815271358 [label="我認為他的很多……舉止可能才是讓你反感的原因。而不是他的行為。",shape=box,color=red];
		j1815271358 -> j1774310568;
		j1815271358 -> j816303589;
	j265337221 [label="他既是高階軍官又是社交名流。而這兩種身份有時都需要他做出見不得光的決策。",shape=box,color=red];
		j265337221 -> j681163897;
	j816303589 [label="我認為一個人可以做出我們認知裡的「錯」事，但卻是出於好意。",shape=box,color=red];
		j816303589 -> j983151865;
	j2049917822 [label="他所做的一切都是為了拯救 Orokin 帝國，而他得到的回報就是違背意願被扔進這個爛攤子。",shape=box,color=red];
		j2049917822 -> j681163897;
	j1774310568 [label="我認為他惹你不高興是因為他為自己所做的事感到自豪。",shape=box,color=red];
		j1774310568 -> j3660010325;
	j681163897 [label="Check boolean MarieGrineer",color=orange];
		j681163897 -> j2570146616 [label=true,color=green];
		j681163897 -> j1998037148 [label=false,color=brown];
	j983151865 [label="你可能把他當作惡魔，但在他心中，事實恰恰相反。",shape=box,color=red];
		j983151865 -> j681163897;
	j3660010325 [label="是的，我不喜歡那些以死亡為樂的人。我發現他那種對流血的渴望令我不安。而你覺得這並不會令你不安，同樣令我震驚。",shape=box,color=blue];
		j3660010325 -> j1360003639;
	j2570146616 [label="我認為那些指揮你對抗的「Corpus」或「Grineer」的人也會這麼說。他們不認為自己有錯。",shape=box,color=blue];
		j2570146616 -> j3146074462;
	j1998037148 [label="我認為那些指揮你對抗的「Corpus」或「Grin-ire」的人也會這麼說。他們不認為自己有錯。",shape=box,color=blue];
		j1998037148 -> j3146074462;
	j1360003639 [label="人們太容易用「為了大義必須犧牲」來為暴力開脫，拒絕正視暴力的恐怖，還說「為了重要的事，這些都算不了什麼」。",shape=box,color=blue];
		j1360003639 -> j678067023;
	j3146074462 [label="他們相信自己的行為是正義的、善良的、必要的。你如何寬恕一個惡魔而不寬恕另一個呢？",shape=box,color=blue];
		j3146074462 -> j1439639713;
		j3146074462 -> j3453438792;
		j3146074462 -> j638482035;
		j3146074462 -> j3814834431;
	j678067023 [label="為行為本身感到自豪……對我來說太過分了。當我必須奪取生命時我不會感到高興，但他會。所以在這方面？我們非常不同。",shape=box,color=blue];
		j678067023 -> j4184487242;
	j1439639713 [label="當他們做出我不認同的事情時，我會試著阻止他們。但……當我需要時，我會與他們並肩作戰。",shape=box,color=red];
		j1439639713 -> j2579813684;
	j3453438792 [label="我不認為那些群體可以被定義為「善」或「惡」。只有他們選擇採取的行動才可被這麼定義。",shape=box,color=red];
		j3453438792 -> j2163968252;
	j638482035 [label="我無權宣稱某些行為是「善」或「惡」。我所做的一切都是為了保護需要保護的人。",shape=box,color=red];
		j638482035 -> j2579813684;
	j3814834431 [label="你是在要求我用評判個人的標準來評判整個群體。",shape=box,color=red];
		j3814834431 -> j2163968252;
	j4184487242 [label="如果惡魔決定用他那把尾刀插進你的肋骨，我只能祈禱一切都還來得及。我不希望你臨終前的想法是「瑪麗早就警告過我了」。",shape=box,color=blue];
		j4184487242 -> j1040793656;
		j4184487242 -> j3802633905;
	j2579813684 [label="那你認為惡魔不是威脅嗎？他對周圍的人不危險嗎？他可能造成巨大傷害。",shape=box,color=blue];
		j2579813684 -> j377358916;
		j2579813684 -> j3386306101;
	j2163968252 [label="那他犯下的那些可怕行為呢？所有的死亡和屠殺。在你看來，這些是正當的行為嗎？",shape=box,color=blue];
		j2163968252 -> j3386306101;
	j1040793656 [label="他不會的。如果他膽敢嘗試，我會阻止他。",shape=box,color=red];
		j1040793656 -> j527459576;
	j3802633905 [label="我保證那些不會是我臨終前的想法。",shape=box,color=red];
		j3802633905 -> j1347251050;
	j377358916 [label="如果他背叛我們的時候到來，我會採取行動。在那之前，他證明自己只是個盟友。雖然說……這有點戲劇化。",shape=box,color=red];
		j377358916 -> j3802741102;
	j3386306101 [label="我不認為他的危險特質是個問題。他是個武器。而武器可以用來殺戮或保護。",shape=box,color=red];
		j3386306101 -> j3354902898;
	j527459576 [label="我欣賞你的自信，即使我為你信任他而感到惋惜。所以，我想我會反過來對你有信心。",shape=box,color=blue];
		j527459576 -> j2133351245;
	j1347251050 [label="我相信你說這些話的意思不是我希望的那樣，但我不會過度解讀。",shape=box,color=blue];
		j1347251050 -> j2133351245;
	j3802741102 [label="Add 1 to Thermostat counter",color=orange];
		j3802741102 -> j4184487242;
	j3354902898 [label="Add -1 to Thermostat counter",color=orange];
		j3354902898 -> j4184487242;
	j2133351245 [label="我必須走了。但我再次懇求你——務必小心。即便不是為了你，也為了我，好嗎？",shape=box,color=blue];
		j2133351245 -> j367054140;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
}