	1859 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		1859 -> 1863 [label="x >= 21",color=purple];
		1859 -> 1862 [label="x < 21",color=purple];
		1859 -> 1862 [label="false",color=purple];
	1858 [label="他失去的那些記憶，那些過去在 Tau 的可怕經歷……我擔心它們預示著什麼。",shape=box,color=blue];
		1858 -> 1860;
		1858 -> 1861;
	1863 [label="我知道你以為我們已經揭開了他破碎的心靈裡的一切。",shape=box,color=blue];
		1863 -> 1866;
		1863 -> 1861;
	1862 [label="我們了解得越多，越深入探究他破碎的心靈，我就感到越不安。危險也變得越清晰。",shape=box,color=blue];
		1862 -> 1861;
		1862 -> 1860;
	1860 [label="我不認為他一旦恢復記憶就會不見人影。這件事沒有那麼簡單。",shape=box,color=red];
		1860 -> 1864;
	1861 [label="他可能還在尋找更多。不是從他的記憶裡，而是從我們這裡。",shape=box,color=red];
		1861 -> 1865;
	1866 [label="當他說這就是我們能發現的全部時，我相信他。而如果真是這樣，那他為什麼還在這裡？",shape=box,color=red];
		1866 -> 1864;
	1864 [label="我承認我更擔心他打算利用這些知識做什麼，而不是知識本身。",shape=box,color=blue];
		1864 -> 1867;
	1865 [label="是的！這正是我擔心的。但究竟是什麼？我們現在對他有什麼用處？",shape=box,color=blue];
		1865 -> 1867;
	1867 [label="無論他打算如何運用他的新生命，我擔心他打算把我們牽扯進來。我只是希望我們不要因為希望他無害而盲目行事。",shape=box,color=blue];
		1867 -> 1868;
		1867 -> 1869;
		1867 -> 1870;
	1868 [label="我同意你的看法。我不信任他。",shape=box,color=red];
		1868 -> 1871;
	1869 [label="他強大且博學。他是我更希望站在我這邊的人。",shape=box,color=red];
		1869 -> 1872;
	1870 [label="想著他會不會背叛我們沒有任何好處；他還沒有。而且我不會因為尚未犯下的罪而判一個人有罪。",shape=box,color=red];
		1870 -> 1873;
	1871 [label="+20 Chemistry",color=orange];
		1871 -> 1874;
	1872 [label="Add -1 to Thermostat",color=orange];
		1872 -> 1875;
	1873 [label="Add 1 to Thermostat",color=orange];
		1873 -> 1876;
	1874 [label="太好了！至少我知道還有其他雙眼睛在盯著那個惡魔，我會安心一些。這也許能幫我入睡。謝謝。",shape=box,color=blue];
		1874 -> 1877;
	1875 [label="是的，但我想知道那樣的結最終的真正代價是什麼。你可能不會為付出的代價而感到高興。",shape=box,color=blue];
		1875 -> 1878;
	1876 [label="是的……我想你說得對。我們不能草木皆兵。我們必須與所有希望看到漠然被擊敗的人肩並肩作戰。",shape=box,color=blue];
		1876 -> 1879;
	1877 [label="Update boolean MarieRoatheNoTrust",color=orange];
		1877 -> 1880;
	1878 [label="我只想勸你要小心……他是個披著紳士外衣的怪物。拜託要小心他，好嗎？",shape=box,color=blue];
		1878 -> 1881;
		1878 -> 1882;
	1879 [label="Check boolean DrifterFaithNoMITW",color=orange];
		1879 -> 1883 [label=true,color=green];
		1879 -> 1884 [label=false,color=brown];
	1880 [label="Chat ends.",color=orange];
	1881 [label="我覺得你對他有點不公平。",shape=box,color=red];
		1881 -> 1885;
	1882 [label="我會小心的。我保證。",shape=box,color=red];
		1882 -> 1886;
	1883 [label="即使你相信背後的力量不是源於神而是源於我們自己的心靈，它仍然是個威脅。",shape=box,color=blue];
		1883 -> 1878;
	1884 [label="即使他相信背後的力量不是源於神祇而是源於我們自己的心靈，它仍然是個威脅。",shape=box,color=blue];
		1884 -> 1878;
	1885 [label="Add -1 to Thermostat",color=orange];
		1885 -> 1887;
	1886 [label="+20 Chemistry",color=orange];
		1886 -> 1888;
	1887 [label="會嗎？怎麼說？我沒有殘忍的意思，我真的很好奇。",shape=box,color=blue];
		1887 -> 1889;
		1887 -> 1890;
		1887 -> 1891;
		1887 -> 1892;
	1888 [label="謝謝。我只能要求這樣了。",shape=box,color=blue];
		1888 -> 1893;
	1889 [label="他在不同的社會、不同的時代長大，有著不同的期望。我們可能不喜歡，但他就是他。",shape=box,color=red];
		1889 -> 1894;
	1890 [label="你和里昂是自願接受源拓氏的原型 Warframe 血清的。他不是。你能想像那是什麼感覺嗎？",shape=box,color=red];
		1890 -> 1895;
		1890 -> 1896;
		1890 -> 1894;
	1891 [label="他經歷了幾個世紀的生活，做著他認為必要的事。我們只是對什麼是必要的事有著不同看法。",shape=box,color=red];
		1891 -> 1895;
		1891 -> 1897;
	1892 [label="我認為他的很多……舉止可能才是讓你反感的原因。而不是他的行為。",shape=box,color=red];
		1892 -> 1897;
		1892 -> 1895;
	1893 [label="Chat ends.",color=orange];
	1894 [label="他既是高階軍官又是社交名流。而這兩種身份有時都需要他做出見不得光的決策。",shape=box,color=red];
		1894 -> 1898;
	1895 [label="我認為一個人可以做出我們認知裡的「錯」事，但卻是出於好意。",shape=box,color=red];
		1895 -> 1899;
	1896 [label="他所做的一切都是為了拯救 Orokin 帝國，而他得到的回報就是違背意願被扔進這個爛攤子。",shape=box,color=red];
		1896 -> 1898;
	1897 [label="我認為他惹你不高興是因為他為自己所做的事感到自豪。",shape=box,color=red];
		1897 -> 1900;
	1898 [label="Check boolean MarieGrineer",color=orange];
		1898 -> 1902 [label=true,color=green];
		1898 -> 1901 [label=false,color=brown];
	1899 [label="你可能把他當作惡魔，但在他心中，事實恰恰相反。",shape=box,color=red];
		1899 -> 1898;
	1900 [label="是的，我不喜歡那些以死亡為樂的人。我發現他那種對流血的渴望令我不安。而你覺得這並不會令你不安，同樣令我震驚。",shape=box,color=blue];
		1900 -> 1903;
	1902 [label="我認為那些指揮你對抗的「Corpus」或「Grineer」的人也會這麼說。他們不認為自己有錯。",shape=box,color=blue];
		1902 -> 1904;
	1901 [label="我認為那些指揮你對抗的「Corpus」或「Grin-ire」的人也會這麼說。他們不認為自己有錯。",shape=box,color=blue];
		1901 -> 1904;
	1903 [label="人們太容易用「為了大義必須犧牲」來為暴力開脫，拒絕正視暴力的恐怖，還說「為了重要的事，這些都算不了什麼」。",shape=box,color=blue];
		1903 -> 1905;
	1904 [label="他們相信自己的行為是正義的、善良的、必要的。你如何寬恕一個惡魔而不寬恕另一個呢？",shape=box,color=blue];
		1904 -> 1906;
		1904 -> 1907;
		1904 -> 1908;
		1904 -> 1909;
	1905 [label="為行為本身感到自豪……對我來說太過分了。當我必須奪取生命時我不會感到高興，但他會。所以在這方面？我們非常不同。",shape=box,color=blue];
		1905 -> 1910;
	1906 [label="當他們做出我不認同的事情時，我會試著阻止他們。但……當我需要時，我會與他們並肩作戰。",shape=box,color=red];
		1906 -> 1911;
	1907 [label="我不認為那些群體可以被定義為「善」或「惡」。只有他們選擇採取的行動才可被這麼定義。",shape=box,color=red];
		1907 -> 1912;
	1908 [label="我無權宣稱某些行為是「善」或「惡」。我所做的一切都是為了保護需要保護的人。",shape=box,color=red];
		1908 -> 1911;
	1909 [label="你是在要求我用評判個人的標準來評判整個群體。",shape=box,color=red];
		1909 -> 1912;
	1910 [label="如果惡魔決定用他那把尾刀插進你的肋骨，我只能祈禱一切都還來得及。我不希望你臨終前的想法是「瑪麗早就警告過我了」。",shape=box,color=blue];
		1910 -> 1913;
		1910 -> 1914;
	1911 [label="那你認為惡魔不是威脅嗎？他對周圍的人不危險嗎？他可能造成巨大傷害。",shape=box,color=blue];
		1911 -> 1915;
		1911 -> 1916;
	1912 [label="那他犯下的那些可怕行為呢？所有的死亡和屠殺。在你看來，這些是正當的行為嗎？",shape=box,color=blue];
		1912 -> 1916;
	1913 [label="他不會的。如果他膽敢嘗試，我會阻止他。",shape=box,color=red];
		1913 -> 1917;
	1914 [label="我保證那些不會是我臨終前的想法。",shape=box,color=red];
		1914 -> 1918;
	1915 [label="如果他背叛我們的時候到來，我會採取行動。在那之前，他證明自己只是個盟友。雖然說……這有點戲劇化。",shape=box,color=red];
		1915 -> 1919;
	1916 [label="我不認為他的危險特質是個問題。他是個武器。而武器可以用來殺戮或保護。",shape=box,color=red];
		1916 -> 1920;
	1917 [label="我欣賞你的自信，即使我為你信任他而感到惋惜。所以，我想我會反過來對你有信心。",shape=box,color=blue];
		1917 -> 1921;
	1918 [label="我相信你說這些話的意思不是我希望的那樣，但我不會過度解讀。",shape=box,color=blue];
		1918 -> 1921;
	1919 [label="Add 1 to Thermostat",color=orange];
		1919 -> 1910;
	1920 [label="Add -1 to Thermostat",color=orange];
		1920 -> 1910;
	1921 [label="我必須走了。但我再次懇求你——務必小心。即便不是為了你，也為了我，好嗎？",shape=box,color=blue];
		1921 -> 1922;
	1922 [label="+20 Chemistry",color=orange];
		1922 -> 1923;
