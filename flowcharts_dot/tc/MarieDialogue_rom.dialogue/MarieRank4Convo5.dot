		1651 -> 1672 [label="MarieEntratiFan2",color=purple];
		1651 -> 1673 [label="MarieEntratiNeutral",color=purple];
		1651 -> 1674 [label="false",color=purple];
	1652 [label="那你到底被什麼事情分心？還有什麼比坐下來整理那些不滿者的抱怨更重要？",shape=box,color=blue];
		1652 -> 1676;
	1653 [label="坐下來整理那些不滿者的抱怨有什麼困難的？",shape=box,color=blue];
		1653 -> 1677;
	1654 [label="哦，太好了！",shape=box,color=blue];
		1654 -> 1678;
	1655 [label="Chat ends.",color=orange];
	1656 [label="他的女兒，被稱為母親的尤拉瑞亞，還有她的家人，一直以來都在照看著火衛二。",shape=box,color=red];
		1656 -> 1679;
	2937 [label="我們可以直接移動所有家具，讓它們全部更換，然後這樣……一直重複。這樣我們就可以全部賣掉，然後從這些奇怪的家具中獲利！",shape=box,color=blue];
		2937 -> 2938;
		2937 -> 2939;
		2937 -> 2940;
	1658 [label="我很清楚我們對主教的意見仍有尚未解決的分歧。我在試圖讓這次對話保持文明。",shape=box,color=blue];
		1658 -> 1680;
	1661 [label="我理解你可能想在討論修補裂痕時，抓住機會指責那些你認為該負責的人。",shape=box,color=blue];
		1661 -> 1680;
	1657 [label="是的！正如你經常提醒我的那樣，你認為他是個怪物！他的心中只有怨恨和空虛！",shape=box,color=blue];
		1657 -> 1680;
	1659 [label="我以為你在這場爭奪主教靈魂的戰爭中站在我這邊。",shape=box,color=blue];
		1659 -> 1681;
	1660 [label="我以為你還沒準備好對主教下定論？還是現在這點已經改變了？",shape=box,color=blue];
		1660 -> 1682;
		1660 -> 1683;
	1668 [label="是的。關於這點，我正在和汰廢先生學習……",shape=box,color=blue];
		1668 -> 1686;
	1662 [label="漂泊狼，不要跟我提什麼結痂的傷口了。上次討論主教的話題時留下的傷口我都還在舔舐呢。",shape=box,color=blue];
		1662 -> 1680;
	1663 [label="是的，但你之前說過，我們都必須停止為我們承受的這些傷口責怪彼此。",shape=box,color=blue];
		1663 -> 1684;
	1664 [label="我知道你認為主教是某種可怕的怪物，因為他造成了這些傷口。",shape=box,color=blue];
		1664 -> 1680;
	1665 [label="我知道你在這場爭奪主教靈魂的戰爭中站在我這邊，這我永遠感恩。",shape=box,color=blue];
		1665 -> 1666;
	1667 [label="我知道你對他保留判斷，對此我非常感激。",shape=box,color=blue];
		1667 -> 1666;
	1666 [label="而雖然我知道其他人急著責怪他，但我不想看到我們在本可以團結時，卻分裂和流血。",shape=box,color=blue];
		1666 -> 1685;
	1675 [label="是的，如我在汰廢先生身上了解到的一樣，或許所有人的遭遇都不盡相同。",shape=box,color=blue];
		1675 -> 1686;
	1669 [label="而我了解到所有人的遭遇都不盡相同，就像你那麼「好心」地向我指出那樣，對不？",shape=box,color=blue];
		1669 -> 1680;
	1670 [label="是的，沒錯！雖然我不責怪主教離開，因為他的工作是神聖的──",shape=box,color=blue];
		1670 -> 1666;
	1671 [label="而我知道你認為主教是某種可怕的怪物，因為他造成了這些傷口。",shape=box,color=blue];
		1671 -> 1680;
	1672 [label="我知道你在這場爭奪主教靈魂的戰爭中站在我這邊，這我永遠感恩。",shape=box,color=blue];
		1672 -> 1666;
	1673 [label="我知道你對他保留判斷，對此我非常感激。",shape=box,color=blue];
		1673 -> 1666;
	1674 [label="而雖然其他人急著責怪他造成他們的痛苦，但我只是不想看到我們分裂和受苦。",shape=box,color=blue];
		1674 -> 1685;
	1676 [label="我開玩笑的！我無法想像你有多忙，你在所有地方的所有時候都被需要。",shape=box,color=blue];
		1676 -> 1678;
	1677 [label="我開玩笑的！我無法想像他們經歷了什麼。而對你來說，解開這一切又有多困難。",shape=box,color=blue];
		1677 -> 1678;
	1678 [label="我只是擔心，如果他們的問題不解決，我們就永遠都無法被他們接納。而且仍有更大的問題未解決。",shape=box,color=blue];
		1678 -> 1637;
	1679 [label="自從原拓氏離開後就一直看守著這個地方，還有將虛空能量泵入始源星系的那顆心臟，讓我們所有人……實際上都得以保持可用。",shape=box,color=red];
		1679 -> 1687;
	2938 [label="我不知道源拓氏的椅子在外面有多大市場……",shape=box,color=red];
		2938 -> 2942;
	2939 [label="這樣最終不會讓市場飽和嗎？我們得賣得更便宜……",shape=box,color=red];
		2939 -> 2942;
	2940 [label="太棒了。我看不出這有什麼問題。",shape=box,color=red];
		2940 -> 2941;
	1680 [label="雖然我明白這兩個話題之間存在密切關聯，但我想請你在今天的對話中保持建設性，好嗎？",shape=box,color=blue];
		1680 -> 1688;
	1681 [label="漂泊狼，這又是你的什麼騙局？還是你在耍小瑪麗？",shape=box,color=blue];
		1681 -> 1689;
		1681 -> 1683;
	1682 [label="我還沒準備好對他行為的必要性下定論。但他冷酷無情的本性毋庸置疑。",shape=box,color=red];
		1682 -> 1680;
	1683 [label="我厭倦假裝了，我很抱歉。",shape=box,color=red];
		1683 -> 1690;
	1686 [label="我們都必須停止為我們承受的這些傷口責怪彼此。",shape=box,color=blue];
		1686 -> 1684;
	1684 [label="我也不同意責怪主教，但我不想看到我們在本可以團結時，卻分裂和流血。",shape=box,color=blue];
		1684 -> 1691;
		1684 -> 1692;
	1685 [label="無論最終是誰的錯，我們都必須停止為我們承受的這些傷口責怪彼此。",shape=box,color=blue];
		1685 -> 1691;
		1685 -> 1692;
	1687 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1687 -> 1693 [label=true,color=green];
		1687 -> 1694 [label=false,color=brown];
	2942 [label="噗！我還是覺得這個實驗值得一試。或許我們可以用大量書櫃把惡魔圍困起來！",shape=box,color=blue];
		2942 -> 2943;
	2941 [label="我會盡職地無視你的諷刺，因為我覺得這個實驗值得一試。或許我們可以用大量書櫃把惡魔圍困起來！",shape=box,color=blue];
		2941 -> 2943;
	1688 [label="我想要幫助我們所有人度過身處的這個……奇怪的共存，而不是爭論。",shape=box,color=blue];
		1688 -> 1686;
	1689 [label="不，這其實不是什麼騙局……但源拓氏不值得信任，而我不知道還能怎麼說服你，只能假裝站在你這邊。",shape=box,color=red];
		1689 -> 1695;
	1690 [label="是嗎？好吧，那我很高興地告訴你，你不需要再裝了。",shape=box,color=blue];
		1690 -> 1696;
	1691 [label="在一起，所有人團結一致，我們組成……一個奇怪的家庭。但無論如何，依然是個家庭。",shape=box,color=red];
		1691 -> 1697;
	1692 [label="我們團結在一起會比各自分開更強大。",shape=box,color=red];
		1692 -> 1698;
		1692 -> 1699;
	1693 [label="她已經接受了他離去的事實，他們也已彼此和解，但這些都來之不易。",shape=box,color=red];
		1693 -> 1700;
	1694 [label="她還沒有接受他離去的事實，他們彼此針鋒相對。",shape=box,color=red];
		1694 -> 1701;
	2943 [label="+20 Chemistry",color=orange];
		2943 -> 2944;
	1695 [label="是嗎？好吧，那我很高興地告訴你，你失敗了。",shape=box,color=blue];
		1695 -> 1696;
	1696 [label="Update boolean MarieEntratiFan1",color=orange];
		1696 -> 1702;
	1697 [label="Add +1 to Family",color=orange];
		1697 -> 1698;
		1697 -> 1699;
	1698 [label="而當我們在受苦的時候，有時我們真正擁有的就只有彼此。要麼是我們因緣相遇，要麼是我們主動認識。",shape=box,color=red];
		1698 -> 1703;
	1699 [label="我不知道從長遠來看，這是好事還是壞事。但這種……煉獄，也不是好事。",shape=box,color=red];
		1699 -> 1704;
	1700 [label="知道他還在外面肆無忌憚，也再沒有和她說過一句話，甚至都沒有寄過一封信……",shape=box,color=red];
		1700 -> 1705;
	1701 [label="知道他還在外面肆無忌憚，也再沒有和她說過一句話，甚至都沒有寄過一封信……",shape=box,color=red];
		1701 -> 1706;
	2944 [label="（法語）還有很多事要忙！再見！",shape=box,color=blue];
		2944 -> 2929;
	1702 [label="Update boolean MarieEntratiFan2",color=orange];
		1702 -> 1707;
	1703 [label="Add +1 to Family",color=orange];
		1703 -> 1704;
	1704 [label="是的，我同意。但我無法成為我們之間的橋梁。我不知道該怎麼做！對樓上的人來說，我是個陌生人……",shape=box,color=blue];
		1704 -> 1708;
		1704 -> 1709;
	1705 [label="我無法想像這對她，或對他們來說會有多痛苦。",shape=box,color=red];
		1705 -> 1710;
	1706 [label="這將摧毀他們之間或許還存在的一絲和解的機會。",shape=box,color=red];
		1706 -> 1711;
	2929 [label="Chat ends.",color=orange];
	1707 [label="Update boolean MarieNoDate",color=orange];
		1707 -> 1712;
	1708 [label="Loid 認識源拓氏家族。他應該會去。然而要說服他……倒是另一回事。",shape=box,color=red];
		1708 -> 1713;
	1709 [label="也許，羅瑟會去？他是 Orokin，他認識他們所有人。",shape=box,color=red];
		1709 -> 1714;
	1710 [label="雖然我能夠理解為了保護他們免受主教因迫不得已的離別而造成的痛苦，這個決定背後的道理……",shape=box,color=blue];
		1710 -> 1715;
	1711 [label="是的……我明白這個道理。那麼，如果可以的話，我會想辦法修補他們的家庭關係，對不？這似乎是我們所有人離開這個地方的唯一希望。",shape=box,color=blue];
		1711 -> 1716;
	1712 [label="Chat ends.",color=orange];
	1713 [label="+5 Chemistry",color=orange];
		1713 -> 1717;
	1714 [label="不，不要惡魔，除了惡魔以外誰都行。但你說到重點了。自然而然應該是 Loid 先生，對不？",shape=box,color=blue];
		1714 -> 1718;
	1715 [label="我確實認為不必這麼殘忍，你不覺得嗎？他們可能以為他已經死了。或者更糟！而我們，住在這裡，卻像下水道的老鼠？",shape=box,color=blue];
		1715 -> 1719;
		1715 -> 1720;
		1715 -> 1721;
	1716 [label="免得我們餘生都被困在這裡，像下水道的老鼠一樣。",shape=box,color=blue];
		1716 -> 1722;
		1716 -> 1723;
	1717 [label="嗯，好的！那就這樣定了！但我們要怎麼說服他？他的立場一向很堅定，對不？",shape=box,color=blue];
		1717 -> 1724;
		1717 -> 1725;
	1718 [label="但我們要怎麼說服他？他的立場一向很堅定，對不？",shape=box,color=blue];
		1718 -> 1725;
		1718 -> 1724;
	1719 [label="我其實有個朋友很喜歡老鼠。我覺得牠們很可愛。",shape=box,color=red];
		1719 -> 1726;
	1720 [label="這事真的不是由我說了算。",shape=box,color=red];
		1720 -> 1727;
	1721 [label="你會建議我怎麼做？",shape=box,color=red];
		1721 -> 1728;
	1722 [label="我其實有個朋友很喜歡老鼠。我覺得牠們很可愛。",shape=box,color=red];
		1722 -> 1729;
	1723 [label="是我疏忽了。你說得對。我這就著手處理。",shape=box,color=red];
		1723 -> 1730;
	1724 [label="你認為你或里昂能說服他嗎？",shape=box,color=red];
		1724 -> 1731;
	1725 [label="瑪麗，你可能不會喜歡我的答案……",shape=box,color=red];
		1725 -> 1732;
	1726 [label="而我很想有天能見到他們，但這並不是我想表達的重點，傻狼。",shape=box,color=blue];
		1726 -> 1728;
	1727 [label="我知道。公開自己的存在，是 Loid 先生及其他所有人的決定。",shape=box,color=blue];
		1727 -> 1728;
	1728 [label="我認為讓我們留在這裡的是罪惡感，並非高尚情操。",shape=box,color=blue];
		1728 -> 1733;
	1729 [label="而我很想有天能見到他們，但這並不是我想表達的重點，傻狼。",shape=box,color=blue];
		1729 -> 1728;
	1730 [label="謝謝。我不知道你是否會成功，但有時候，我們只能盡力嘗試了。",shape=box,color=blue];
		1730 -> 1728;
	1731 [label="他很喜歡我們，他善良又溫柔。但我們對他來說是陌生人、新來的人。",shape=box,color=blue];
		1731 -> 1734;
	1732 [label="（法語）哦，真的嗎？",shape=box,color=blue];
		1732 -> 1735;
	1733 [label="我們隱藏了某種重大而可怕的罪行。",shape=box,color=blue];
		1733 -> 1736;
	1734 [label="我再想想。你也一樣！一定能找到解決的辦法，日尊已經引導我們走到這一步了！",shape=box,color=blue];
		1734 -> 1737;
	1735 [label="Loid 可能會聽羅瑟的話。他是 Orokin，他們之間有共同歷史，也許在這種情況下派得上用場。",shape=box,color=red];
		1735 -> 1738;
	1736 [label="而正是那個罪惡必須得到寬恕，又或許被證明並非真的。",shape=box,color=blue];
		1736 -> 1739;
		1736 -> 1740;
	1737 [label="+15 Chemistry",color=orange];
		1737 -> 1741;
	1738 [label="不！他是個騙子，他是個操縱者，他只會為了換取巨大利益才會這麼做！",shape=box,color=blue];
		1738 -> 1742;
	1739 [label="樓上的情況……即使在最好的日子裡也十分脆弱。我不想讓他們不高興。",shape=box,color=red];
		1739 -> 1743;
	1740 [label="我們必須小心行事。恐怕一半人會把另一半人視為「另一個家族」。",shape=box,color=red];
		1740 -> 1744;
	1741 [label="我知道我們一定會找到方法說服 Loid 先生走上那些樓梯的。",shape=box,color=blue];
		1741 -> 1745;
	1742 [label="我知道我們一定會找到另一種方法說服 Loid 先生走上那些樓梯的。",shape=box,color=blue];
		1742 -> 1746;
	1743 [label="你會對靈魂的韌性感到很驚訝。而現在圍繞在我身邊的那些人，年紀都非常大了，如此飽經歲月淬煉。",shape=box,color=blue];
		1743 -> 1747;
	1744 [label="Add +1 to Family",color=orange];
		1744 -> 1748;
	1745 [label="我得走了。有很多事要想，有很多事要忙。再見。",shape=box,color=blue];
		1745 -> 1749;
	1746 [label="我得走了。有很多事要想，有很多事要忙。再見。",shape=box,color=blue];
		1746 -> 1750;
	1747 [label="你已經讓他們驚訝過很多次了。這次就讓他們驚訝你一次吧。",shape=box,color=blue];
