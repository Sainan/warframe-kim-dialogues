		1629 -> 1632 [label="false",color=purple];
	2930 [label="漂泊者！我一直在盤算。",shape=box,color=blue];
		2930 -> 2931;
		2930 -> 2932;
	1630 [label="漂泊者！我一直在籌劃、思考你說過關於我們樓上那家人的事。還有他們可能會如何把我們視為不速之客。",shape=box,color=blue];
		1630 -> 1633;
	1631 [label="漂泊者！我一直在思考你說過關於我們樓上那家人的事。我為他們感到心碎……",shape=box,color=blue];
		1631 -> 1634;
	1632 [label="為什麼我們不能上樓？為什麼我們不能和那些稱主教為家人的人交談？",shape=box,color=blue];
		1632 -> 1635;
		1632 -> 1636;
	2931 [label="我應該害怕嗎？",shape=box,color=red];
		2931 -> 2934;
	2932 [label="[結束]",shape=box,color=red];
		2932 -> 2933;
	1633 [label="視為競爭的「另一個家庭」，對不？這讓我非常困擾。",shape=box,color=blue];
		1633 -> 1634;
	1634 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1634 -> 1637 [label=true,color=green];
		1634 -> 1638 [label=false,color=brown];
	1635 [label="嗯……簡而言之，原拓氏的部分家人在樓上，他們並不……清楚我們在這裡。",shape=box,color=red];
		1635 -> 1639;
	1636 [label="[結束]",shape=box,color=red];
		1636 -> 1640;
	2934 [label="嗯！那些會飛的小機器人。亡骸……亡骸……你都叫它們什麼來著？",shape=box,color=blue];
		2934 -> 2935;
	2933 [label="Chat ends.",color=orange];
	1637 [label="我們並不與他們爭奪主教的寵愛，我們要怎麼讓他們看清這點？",shape=box,color=blue];
		1637 -> 1641;
		1637 -> 1642;
		1637 -> 1643;
	1638 [label="你修補他們內部紛爭的工作進展得如何？",shape=box,color=blue];
		1638 -> 1644;
		1638 -> 1645;
		1638 -> 1646;
		1638 -> 1647;
	1639 [label="Update boolean MarieFamily1",color=orange];
		1639 -> 1648;
	1640 [label="Chat ends.",color=orange];
	2935 [label="亡骸微靈？",shape=box,color=red];
		2935 -> 2936;
	1641 [label="你說得對。你無法爭奪一個人根本不願付出的東西。",shape=box,color=red];
		1641 -> 1649;
	1642 [label="揭開結痂的傷口很危險。你可能會清除感染……或者你也可能會在過程中流血而亡。",shape=box,color=red];
		1642 -> 1650;
	1643 [label="你、我們，和所有人都有個共同點。在某個時候，我們都被源拓氏拋棄過。",shape=box,color=red];
		1643 -> 1651;
	1644 [label="老實說？我分心了。",shape=box,color=red];
		1644 -> 1652;
	1645 [label="還可以更好。",shape=box,color=red];
		1645 -> 1653;
	1646 [label="我正在取得進展。",shape=box,color=red];
		1646 -> 1654;
	1647 [label="[結束]",shape=box,color=red];
		1647 -> 1655;
	1648 [label="以聖光會之名……你是說我們在這裡的存在是個秘密？！難道這就是為什麼我們不被允許離開這個地方嗎？！但是為什麼呢？！",shape=box,color=blue];
		1648 -> 1656;
	2936 [label="對！哈！它們非常執著於更換家具，對不？但我發現如果你移動東西……它們也會跟著做同樣的事。",shape=box,color=blue];
		2936 -> 2937;
	1649 [label="Evaluate expressions",color=orange];
