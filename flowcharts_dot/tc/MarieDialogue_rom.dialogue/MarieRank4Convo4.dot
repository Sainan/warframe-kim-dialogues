		2287 -> 2289 [label=false,color=brown];
	2288 [label="瑪麗？我們能談談嗎？",shape=box,color=red];
		2288 -> 2292;
	2290 [label="羅瑟告訴我……你和汰廢爭執的事。我們能談談嗎？",shape=box,color=red];
		2290 -> 2293;
	2291 [label="[結束]",shape=box,color=red];
		2291 -> 2294;
	2289 [label="Chat ends.",color=orange];
	2292 [label="可以，雖然我覺得我知道這是關於什麼……我的態度確實不好。是誰告訴你的？",shape=box,color=blue];
		2292 -> 2295;
		2292 -> 2296;
		2292 -> 2297;
	2293 [label="（法語）當然，又是那個死八卦魔大嘴巴把一切都告訴了你！他只想看我出醜！",shape=box,color=blue];
		2293 -> 2298;
	2294 [label="Chat ends.",color=orange];
	2295 [label="這不重要。",shape=box,color=red];
		2295 -> 2299;
	2296 [label="Loid。",shape=box,color=red];
		2296 -> 2300;
	2297 [label="羅瑟。",shape=box,color=red];
		2297 -> 2293;
	2298 [label="（法語）如果我可以隨心所欲，我會把他最愛用來惹惱別人的那把尾刀塞進只有月尊才看得見的地方！",shape=box,color=blue];
		2298 -> 2301;
	2299 [label="我想這很重要，但我想你是為了顧及我的心情。所以……我就不會再追問了。",shape=box,color=blue];
		2299 -> 2302;
	2300 [label="我想你是為了顧及我的心情在說謊，所以……我就不會再追問了。",shape=box,color=blue];
		2300 -> 2302;
	2301 [label="很抱歉。那樣有點……不得體。身為一名太陽修女，我不該這樣情緒失控或口出惡言。",shape=box,color=blue];
		2301 -> 2303;
	2302 [label="+5 Chemistry",color=orange];
		2302 -> 2304;
	2303 [label="+5 Chemistry",color=orange];
		2303 -> 2305;
	2304 [label="我希望在這場對話中保留我僅存的一點尊嚴。",shape=box,color=blue];
		2304 -> 2306;
	2305 [label="我的怒氣並非針對你。而且我一直很感激你的誠實。",shape=box,color=blue];
		2305 -> 2307;
	2306 [label="如果你是來跟我談論我和汰廢先生的爭執，我不會否認這事確實發生過。",shape=box,color=blue];
		2306 -> 2307;
	2307 [label="我猜那個惡魔已經告訴你爭執的原因了？",shape=box,color=blue];
		2307 -> 2308;
	2308 [label="Evaluate expressions",color=orange];
		2308 -> 2310 [label="MarieTagferFight2a",color=purple];
		2308 -> 2311 [label="MarieTagferFight2a",color=purple];
		2308 -> 2309 [label="MarieTagferFight2b",color=purple];
		2308 -> 2310 [label="MarieTagferFight2b",color=purple];
		2308 -> 2310 [label="false",color=purple];
		2308 -> 2312 [label="false",color=purple];
	2310 [label="他不需要告訴我，我也能猜到。是關於源拓氏。",shape=box,color=red];
		2310 -> 2314;
	2311 [label="他有。不過比起任何其他事，他似乎更擔心你。",shape=box,color=red];
		2311 -> 2315;
	2309 [label="他有。他擔心這件事，因為我覺得他很同情參研者的遭遇。",shape=box,color=red];
		2309 -> 2313;
	2312 [label="老實說，沒有。他只說我應該關心你一下。",shape=box,color=red];
		2312 -> 2316;
	2314 [label="是的。我和汰廢先生爭論的是關於主教的話題。",shape=box,color=blue];
		2314 -> 2318;
		2314 -> 2319;
	2315 [label="我不明白那個惡魔為什麼要讓你相信這種事。或者這對他有什麼好處。",shape=box,color=blue];
		2315 -> 2320;
	2313 [label="那個惡魔看到三隻受傷的動物，就知道他可以輕易施展魅力來讓牠們圍著他轉。",shape=box,color=blue];
		2313 -> 2317;
	2316 [label="我不明白那個惡魔為什麼要讓你做這種事。或者他認為這能幫他達成什麼目的。",shape=box,color=blue];
		2316 -> 2321;
	2318 [label="汰廢確實不太擁護源拓氏，不是。",shape=box,color=red];
		2318 -> 2323;
	2319 [label="我猜那場爭執很激烈。",shape=box,color=red];
		2319 -> 2324;
	2320 [label="那個惡魔對我的所有看似善意的行為，都是為了達成他的目的——讓我背叛主教。我知道的。",shape=box,color=blue];
		2320 -> 2322;
	2317 [label="他這麼做是為了讓局勢對我不利。他想腐化我，讓我背叛主教。想看到我背棄他。這我心知肚明。",shape=box,color=blue];
		2317 -> 2322;
	2321 [label="但……這不是你上來討論的事。爭執是關於主教的事。",shape=box,color=blue];
		2321 -> 2318;
		2321 -> 2319;
	2323 [label="這就是我不明白的地方！看看他們得到了什麼！",shape=box,color=blue];
		2323 -> 2325;
		2323 -> 2326;
	2324 [label="是的！他罵我白癡、叫我幼稚。",shape=box,color=blue];
		2324 -> 2327;
		2324 -> 2325;
	2322 [label="我和汰廢先生爭論的就是關於主教的話題。",shape=box,color=blue];
		2322 -> 2318;
		2322 -> 2319;
	2325 [label="拜託，請從頭說起。這場爭執到底是怎麼開始的？",shape=box,color=red];
		2325 -> 2328;
	2326 [label="我開始能夠理解為什麼會發生這場爭執了。",shape=box,color=red];
		2326 -> 2328;
	2327 [label="他真的罵你白癡、叫你幼稚嗎？",shape=box,color=red];
		2327 -> 2329;
	2328 [label="是的。我提到了主教，我甚至都不記得是關於什麼事了。",shape=box,color=blue];
		2328 -> 2330;
	2329 [label="或許，更糟。",shape=box,color=blue];
		2329 -> 2331;
	2330 [label="汰廢先生翻了個白眼，嗤之以鼻。我請他解釋他嘲笑的原因。",shape=box,color=blue];
		2330 -> 2332;
	2331 [label="「瑪麗，你只是個剛出生的幼崽！天真無邪。一輩子都依賴別人。蜷縮在你那盲目信仰的小窩裡！」",shape=box,color=blue];
		2331 -> 2333;
	2332 [label="「阿爾布雷希特是個骯髒的臭騙子！」",shape=box,color=blue];
		2332 -> 2334;
	2333 [label="「靠著你的長輩嚼碎吐進你那張天真又張大的嘴裡的東西活著！」",shape=box,color=blue];
		2333 -> 2335;
	2334 [label="而我回答道，「看看你們得到的恩賜——思考的恩賜、語言的恩賜、自我的恩賜！」",shape=box,color=blue];
		2334 -> 2336;
	2335 [label="Update boolean MarieEntrati3",color=orange];
		2335 -> 2337;
		2335 -> 2338;
		2335 -> 2339;
	2336 [label="「你們應該感激主教賜予你們的一切祝福。」",shape=box,color=blue];
		2336 -> 2340;
		2336 -> 2341;
	2337 [label="汰廢只知道他自己的故事。源拓氏真正的動機或想法並沒有……被清楚解釋過。",shape=box,color=red];
		2337 -> 2342;
	2338 [label="我知道你對「依賴」別人的感受，我很抱歉他對你說了那些話。",shape=box,color=red];
		2338 -> 2343;
	2339 [label="汰廢有充分理由這麼想。",shape=box,color=red];
		2339 -> 2344;
	2340 [label="然後他怎麼回應？",shape=box,color=red];
		2340 -> 2331;
	2341 [label="哦，不……",shape=box,color=red];
		2341 -> 2331;
	2342 [label="+5 Chemistry",color=orange];
		2342 -> 2345;
	2343 [label="+5 Chemistry",color=orange];
		2343 -> 2346;
	2344 [label="Evaluate expressions",color=orange];
		2344 -> 2347 [label="MarieEntratiFamily",color=purple];
		2344 -> 2348 [label="MarieEntratiMonster1",color=purple];
		2344 -> 2348 [label="MarieEntratiMonster2",color=purple];
		2344 -> 2349 [label="MarieEntratiFan1",color=purple];
		2344 -> 2349 [label="MarieEntratiFan2",color=purple];
		2344 -> 2351 [label="MarieEntratiNeutral",color=purple];
		2344 -> 2350 [label="false",color=purple];
	2345 [label="就算是這樣，他也還是沒有權利這樣說話！我不知道他是否明白他的話傷我多深。而且——",shape=box,color=blue];
		2345 -> 2344;
	2346 [label="謝謝，我不知道他是否知道他話語如利刃傷我多深。",shape=box,color=blue];
		2346 -> 2352;
		2346 -> 2353;
		2346 -> 2354;
	2347 [label="如果這就是主教回來時可以期待受到的歡迎，難怪他根本不想回來！",shape=box,color=blue];
		2347 -> 2355;
		2347 -> 2356;
	2348 [label="而我確信你在這件事上站在汰廢先生那邊，對不？你也像那隻野獸一樣認為主教是個惡魔。",shape=box,color=blue];
		2348 -> 2357;
		2348 -> 2358;
	2349 [label="我很驚訝，我還以為你站在我這邊！剛才你不是還在跟我一起擁護主教的理念嗎？",shape=box,color=blue];
		2349 -> 2359;
	2351 [label="就像你之前說的，這又有什麼關係？我們只需要效忠於他的使命，事後再來評判他。這場爭執毫無意義，對不？",shape=box,color=blue];
		2351 -> 2361;
		2351 -> 2362;
	2350 [label="我知道他們是由虛空透過主教之手創造的。我們所有人都從主教那裡得到了恩賜，若以破碎的心看待，那即是詛咒！",shape=box,color=blue];
		2350 -> 2360;
	2352 [label="那你又知道你的話傷他有多深嗎？你清楚知道他們的故事嗎？",shape=box,color=red];
		2352 -> 2350;
	2353 [label="而你說的話也同樣傷他很深。",shape=box,color=red];
		2353 -> 2363;
	2354 [label="老實說，我站在你這邊，但瑪麗……我們必須試著維持和平。",shape=box,color=red];
		2354 -> 2364;
		2354 -> 2365;
	2355 [label="瑪麗，拜託一下。我不是要吵架。我只是想讓你明白他們經歷了什麼。",shape=box,color=red];
		2355 -> 2366;
	2356 [label="如果源拓氏願意留下來幫忙收拾他自己造成的爛攤子，他在這世界上可能會有更多朋友。",shape=box,color=red];
		2356 -> 2367;
	2357 [label="瑪麗，拜託一下。我不是要吵架。我只是想讓你明白他們經歷了什麼。",shape=box,color=red];
		2357 -> 2366;
	2358 [label="是的，我就站在他那邊。因為你不願講道理。你得明白「主教」並非表面上看起來那樣。",shape=box,color=red];
		2358 -> 2366;
	2359 [label="這是你精心策劃的騙局嗎？難道你一直在耍小瑪麗？",shape=box,color=blue];
		2359 -> 2368;
		2359 -> 2369;
	2361 [label="等我們爭論完這一切之後，發現沒有人站在我們這邊，那就有關係了。他們經歷了許多。",shape=box,color=red];
		2361 -> 2366;
	2362 [label="我相信他會忘記這件事的。我相信你也會。",shape=box,color=red];
		2362 -> 2371;
	2360 [label="我們所有人都被他拋棄過！告訴我，他們受到的委屈到底有多特別，讓我必須忍受這樣的仇恨？！",shape=box,color=blue];
		2360 -> 2370;
	2363 [label="是嗎？！那麼告訴我為什麼！",shape=box,color=blue];
		2363 -> 2350;
	2364 [label="參研者經歷過的事……很不容易。",shape=box,color=red];
		2364 -> 2350;
	2365 [label="他們是動物，即使被賦予智慧，他們依然是動物。他們的能力有限。",shape=box,color=red];
		2365 -> 2372;
	2366 [label="是嗎？那就扮演太陽的聖光，驅散黑暗！開導愚昧的小瑪麗！",shape=box,color=blue];
		2366 -> 2350;
	2367 [label="嗯！對呀，他正在試圖拯救已知宇宙免於虛空之神的威脅，難道這樣還不夠嗎？！",shape=box,color=blue];
		2367 -> 2373;
	2368 [label="不，我沒有騙你。我站在你這邊。我只是說他們的處境……很艱難。",shape=box,color=red];
		2368 -> 2366;
	2369 [label="不，這其實不是什麼騙局……源拓氏不值得信任，而我不知道還能怎麼說服你，只能假裝站在你這邊。",shape=box,color=red];
		2369 -> 2374;
	2371 [label="不行！你開啟了這場對話，所以你要繼續下去。給我解釋清楚！",shape=box,color=blue];
		2371 -> 2350;
	2370 [label="Evaluate expressions",color=orange];
		2370 -> 2375 [label="MarieFamily2",color=purple];
		2370 -> 2377 [label="MarieFamily2",color=purple];
		2370 -> 2375 [label="MarieBackstory1",color=purple];
		2370 -> 2378 [label="MarieBackstory1",color=purple];
		2370 -> 2375 [label="MarieInfestation",color=purple];
		2370 -> 2379 [label="MarieInfestation",color=purple];
		2370 -> 2375 [label="MarieLyonSuffering2",color=purple];
		2370 -> 2376 [label="MarieLyonSuffering2",color=purple];
		2370 -> 2375 [label="MarrieLyonSuffering3",color=purple];
		2370 -> 2375 [label="false",color=purple];
	2372 [label="如果你是想讓我同情他們，反而把憤怒轉向你，我突然很想這麼做。",shape=box,color=blue];
		2372 -> 2380;
	2373 [label="或許在我們所有人都情緒失控之前，最好還是在這裡結束對話。",shape=box,color=blue];
		2373 -> 2381;
	2374 [label="是嗎？好吧，那我很高興地告訴你，你失敗了。",shape=box,color=blue];
		2374 -> 2382;
	2375 [label="參研者是實驗意外衍生的產物。原本不該存在的實驗動物。虛空賦予了他們智慧。",shape=box,color=red];
		2375 -> 2383;
	2377 [label="你自己說過，「沒有名字簡直殘忍至極。」源拓氏從來就懶得給他們取名字，對他來說他們根本一無是處。",shape=box,color=red];
		2377 -> 2385;
	2378 [label="你告訴過我你在街頭長大的故事。你的家人把你趕出去，因為你對他們來說並不夠優秀。",shape=box,color=red];
		2378 -> 2386;
	2379 [label="想想看，如果你只是在違背意願的情況下被變成原型 Warframe 隨後被拋棄，你會有什麼感受？",shape=box,color=red];
		2379 -> 2387;
	2376 [label="想像一下，如果源拓氏突然闖進來，把里昂變成原型 Warframe，然後拋棄他，你會有什麼感受？",shape=box,color=red];
		2376 -> 2384;
	2380 [label="或許在我們所有人都情緒失控之前，最好還是在這裡結束對話。",shape=box,color=blue];
		2380 -> 2388;
	2381 [label="Chat ends.",color=orange];
	2382 [label="Update boolean MarieEntratiFan1",color=orange];
		2382 -> 2389;
	2383 [label="而當源拓氏看到他所做的一切並且意識到他創造了什麼──這些可憐的動物，說著虛空語，因暴露於虛空而病倒。",shape=box,color=red];
		2383 -> 2390;
	2385 [label="對他來說，他們只是東西。使用完就可以丟棄的東西。「汰廢」的意思是「汰棄報廢」。",shape=box,color=red];
		2385 -> 2392;
	2386 [label="你的家人認為你一無是處。",shape=box,color=red];
		2386 -> 2393;
	2387 [label="想像一下，血液裡帶著 Infestation 感染體，痛苦不堪，卻沒有人在乎，那會是什麼感覺？",shape=box,color=red];
		2387 -> 2394;
	2384 [label="像廉價科學實驗品一樣利用他，然後撒手不管？你們所有人在轉變前後都有彼此依靠。參研者可沒有。",shape=box,color=red];
		2384 -> 2391;
	2388 [label="Chat ends.",color=orange];
	2389 [label="Update boolean MarieEntratiFan2",color=orange];
		2389 -> 2395;
	2390 [label="他根本不在乎。",shape=box,color=red];
		2390 -> 2396;
	2392 [label="鳥三是隻用數字當名字的鳥。費波那契是自己給自己取的名字。",shape=box,color=red];
		2392 -> 2397;
	2393 [label="對源拓氏來說，參研者便是如此。用完即丟的實驗動物。「汰廢」的意思是「汰棄報廢」。",shape=box,color=red];
		2393 -> 2392;
	2394 [label="這樣你的痛苦是否還重要呢？參研者對源拓氏來說曾經是——不，現在仍是一無是處。用完即丟的實驗動物。「汰廢」的意思是「汰棄報廢」。",shape=box,color=red];
		2394 -> 2392;
	2391 [label="對源拓氏來說，參研者只是用完即丟的實驗動物。一無是處。「汰廢」的意思是「汰棄報廢」。",shape=box,color=red];
		2391 -> 2392;
	2395 [label="Update boolean MarieNoDate",color=orange];
		2395 -> 2398;
	2396 [label="對源拓氏來說，參研者便是如此。用完即丟。「汰廢」的意思是「汰棄報廢」。",shape=box,color=red];
		2396 -> 2399;
	2397 [label="他們被用於虛空實驗。是眾多死掉實驗動物中的倖存者。原本不該存在。",shape=box,color=red];
		2397 -> 2400;
	2398 [label="Chat ends.",color=orange];
	2399 [label="他是同類中最後一隻。待汰棄報廢。唯一剩下的另一隻，他的伴侶──慜，死於實驗中。",shape=box,color=red];
		2399 -> 2401;
	2400 [label="他們還活著只是因為 Loid。他保存了他們，因為他不忍心「按照源拓氏的指示」對他們實施安樂死。",shape=box,color=red];
		2400 -> 2402;
	2401 [label="而瑪麗，這就是他生氣的原因。這就是他為什麼恨源拓氏。也是他為什麼可能會永遠恨下去的原因。",shape=box,color=red];
		2401 -> 2403;
	2402 [label="哦，還有汰廢。他是同類中最後一隻。他的伴侶慜，唯一剩下的另一隻，死於實驗中。",shape=box,color=red];
		2402 -> 2404;
	2403 [label="Update boolean MarieEntrati3b",color=orange];
		2403 -> 2405;
		2403 -> 2406;
	2404 [label="而瑪麗，這就是他生氣的原因。這就是他為什麼恨源拓氏。也是他為什麼可能會永遠恨下去的原因。",shape=box,color=red];
		2404 -> 2407;
	2405 [label="我知道你相信他在做他認為該做的事。我也知道你相信寬恕。我也相信。但你得理解，為什麼有些人做不到。至少現在還不行。",shape=box,color=red];
		2405 -> 2408;
