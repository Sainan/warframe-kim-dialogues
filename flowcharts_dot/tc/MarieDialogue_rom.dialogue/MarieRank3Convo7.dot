		1513 -> 1519;
	1514 [label="我能否冒昧地問一句？",shape=box,color=red];
		1514 -> 1520;
	1515 [label="這樣總結相當精準。",shape=box,color=red];
		1515 -> 1521;
	1516 [label="老實說，我希望人們看到的我不只是那樣。",shape=box,color=red];
		1516 -> 1522;
	1517 [label="而我也很欣賞你有這個心。他很堅強，能承受加諸於他身上的一切。但一切重擔大家一起扛總是輕鬆一些。",shape=box,color=blue];
		1517 -> 1523;
		1517 -> 1524;
