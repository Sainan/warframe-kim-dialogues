		j1350559949 -> "Chat ends.";
	j4079269690 [label="我親愛的里昂在大教座堂早已久居多年，後來院長嬤嬤收留了我，我便加入了聖光會，成為了一名修女。我很高興你和他現在有在對話了！",shape=box,color=blue];
		j4079269690 -> j912328360;
		j4079269690 -> j3453198793;
	j2837675160 [label="在我們繼續之前，我想請你先澄清一下那個問題。而且我還要請你溫柔一點，並小心提醒你，他是我的靈魂弟兄。",shape=box,color=blue];
		j2837675160 -> j2068965815;
