		1512 -> 1518;
	1509 [label="我親愛的里昂在大教座堂早已久居多年，後來院長嬤嬤收留了我，我便加入了聖光會，成為了一名修女。",shape=box,color=blue];
		1509 -> 1513;
		1509 -> 1514;
	1510 [label="嗯，我想你一定是，一個能穿越時空、循環時間、憑空創造世界的生物！你有點像魔術師，對不？",shape=box,color=blue];
		1510 -> 1515;
		1510 -> 1516;
	1511 [label="+5 Chemistry",color=orange];
		1511 -> 1517;
	1518 [label="我想這就是為什麼里昂和我這麼快就成為了家人。我們都從未用憐憫的眼光互看彼此。",shape=box,color=blue];
		1518 -> 1525;
