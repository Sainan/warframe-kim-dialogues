		j1223541909 -> j1835711456;
	j2308659714 [label="大家都說你是隻狼，但你對我卻這麼有禮貌！看到這點真是太窩心了。我想我知道你想問什麼。為什麼我會淪落街頭？",shape=box,color=blue];
