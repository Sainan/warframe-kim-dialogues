		j304686532 -> j2294118589;
	j242440442 [label="大家都說你是隻狼，但你對我卻這麼有禮貌！看到這點真是太窩心了。我想我知道你想問什麼。為什麼我會淪落街頭？",shape=box,color=blue];
		j242440442 -> j3839043118;
	j2779369284 [label="我想，總有一天，有人會寫一本關於你的故事書。光想就覺得這想法太美好了。或許我會來寫。不過我會用高勒語來寫！想像一下！",shape=box,color=blue];
		j2779369284 -> j2056275988;
	j697338078 [label="那你就真的能夠理解了。我不只是瑪麗修女，那個沒有雙腳卻被賦予飄浮能力的可憐女孩。而里昂也不只是一個默默承受重擔的悲劇神父。",shape=box,color=blue];
		j697338078 -> j2488044124;
	j2611991267 [label="+10 Chemistry",color=orange];
		j2611991267 -> j344424209;
	j1843813990 [label="我已經有點習慣自己是「當地奇觀」了，我知道你們倆的感受。不，事情不是這樣的。",shape=box,color=red];
		j1843813990 -> j3896250716;
	j1941770633 [label="不，我只是好奇。而且老實說，我有點擔心他。我覺得他隱忍著很多痛苦。",shape=box,color=red];
		j1941770633 -> j2867701167;
	j2294118589 [label="你可以想像，在我那個時代的光之城，像我這樣雙腿無法工作的人，能找的工作或去處並不多。",shape=box,color=blue];
		j2294118589 -> j3217070047;
	j2056275988 [label="或許別想像這種事，它可能會成真。哈！趁著這個美好的氛圍，恐怕我得向你告別了。喃喃者永不止息！",shape=box,color=blue];
		j2056275988 -> "Chat ends.";
	j2488044124 [label="記住這點，我想，我們就能成為好朋友。趁著這個美好的氛圍，恐怕我得向你告別了。喃喃者永不止息！",shape=box,color=blue];
		j2488044124 -> "Chat ends.";
	j344424209 [label="要有耐心。他……一開始不太會敞開心扉。但在適當的時候，他就會來找你了。如果你真心待他，他會知道。但現在，恐怕我得向你告別了。",shape=box,color=blue];
		j344424209 -> "Chat ends.";
	j3896250716 [label="嗯，我想你一定是，一個能穿越時空、循環時間、憑空創造世界的生物！你有點像魔術師，對不？",shape=box,color=blue];
