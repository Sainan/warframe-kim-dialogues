		j3896250716 -> j4109851678;
	j2867701167 [label="+15 Chemistry",color=orange];
		j2867701167 -> j739763444;
	j3217070047 [label="我想這就是為什麼里昂和我這麼快就成為了家人。我們都從未用憐憫的眼光互看彼此。",shape=box,color=blue];
		j3217070047 -> j3660378766;
		j3217070047 -> j637193718;
	j739763444 [label="你說得對，他確實如此。但他覺得有必要這麼做，以保護他周遭的人。當他覺得你不再需要這種保護的時候，他便會告訴你他的煩惱。要有耐心。時機對了他自然會告訴你。",shape=box,color=blue];
		j739763444 -> j3489336162;
	j3660378766 [label="我希望他很快就能自在地跟我說話了。",shape=box,color=red];
		j3660378766 -> j2611991267;
	j637193718 [label="我很高興你們倆找到了彼此。我們每個人都不只是乍看之下的表象。",shape=box,color=red];
		j637193718 -> j507786944;
	j3489336162 [label="唉。恐怕我得向你告別了。喃喃者永不止息！",shape=box,color=blue];
