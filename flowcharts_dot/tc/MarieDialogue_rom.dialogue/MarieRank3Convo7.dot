	j3453198793 [label="我能否冒昧地問一句？",shape=box,color=red];
		j3453198793 -> j37023310;
	j2068965815 [label="如果這個話題讓你困擾，我們可以聊點別的。",shape=box,color=red];
		j2068965815 -> j1951281478;
	j1620014121 [label="我一點都不想讓你難過。我只是擔心他。他看起來很堅忍，但我感覺他其實很痛苦。",shape=box,color=red];
		j1620014121 -> j3287851741;
