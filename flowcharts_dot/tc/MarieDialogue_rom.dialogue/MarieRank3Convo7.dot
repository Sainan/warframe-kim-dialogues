		1489 -> 1492;
	1494 [label="我親愛的里昂在大教座堂早已久居多年，後來院長嬤嬤收留了我，我便加入了聖光會，成為了一名修女。我很高興你和他現在有在對話了！",shape=box,color=blue];
		1494 -> 1497;
		1494 -> 1498;
	1493 [label="在我們繼續之前，我想請你先澄清一下那個問題。而且我還要請你溫柔一點，並小心提醒你，他是我的靈魂弟兄。",shape=box,color=blue];
		1493 -> 1495;
		1493 -> 1496;
