		j37023310 -> j2308659714;
	j1951281478 [label="不，沒關係。我只是習慣了好奇的圍觀群眾偷偷摸摸走過來，像他是什麼馬戲團的怪物一樣敲打他籠子的欄杆。",shape=box,color=blue];
