		1523 -> 1530;
	1524 [label="如果可以的話，我想幫助他。你有什麼建議嗎？",shape=box,color=red];
		1524 -> 1530;
	1531 [label="我希望你來這裡不是為了做這種事。",shape=box,color=blue];
