		1499 -> 1505;
	1500 [label="+5 Chemistry",color=orange];
		1500 -> 1506;
	1507 [label="Update boolean MarieBeggar1",color=orange];
		1507 -> 1512;
	1508 [label="大家都說你是隻狼，但你對我卻這麼有禮貌！看到這點真是太窩心了。我想我知道你想問什麼。為什麼我會淪落街頭？",shape=box,color=blue];
		1508 -> 1501;
	1503 [label="你們倆是怎麼認識的？",shape=box,color=red];
		1503 -> 1509;
	1504 [label="我已經有點習慣自己是「當地奇觀」了，我理解你為什麼會有防備心。",shape=box,color=red];
		1504 -> 1510;
	1505 [label="沒關係。我只是擔心他。",shape=box,color=red];
		1505 -> 1511;
	1506 [label="我……為我的無禮道歉。我只是習慣了好奇的圍觀群眾偷偷摸摸走過來，像他是什麼馬戲團的怪物一樣敲打他籠子的欄杆。",shape=box,color=blue];
		1506 -> 1504;
		1506 -> 1505;
