		1498 -> 1502;
	1495 [label="如果這個話題讓你困擾，我們可以聊點別的。",shape=box,color=red];
		1495 -> 1499;
	1496 [label="我一點都不想讓你難過。我只是擔心他。他看起來很堅忍，但我感覺他其實很痛苦。",shape=box,color=red];
		1496 -> 1500;
	1501 [label="早在多年前，當我還只是個小女孩的時候，就被我的家人拋棄在街頭了。我當了很多年乞丐，想盡辦法活下去。",shape=box,color=blue];
		1501 -> 1507;
	1502 [label="+5 Chemistry",color=orange];
		1502 -> 1508;
	1499 [label="不，沒關係。我只是習慣了好奇的圍觀群眾偷偷摸摸走過來，像他是什麼馬戲團的怪物一樣敲打他籠子的欄杆。",shape=box,color=blue];
		1499 -> 1503;
