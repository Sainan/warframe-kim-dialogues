		j747722288 -> j1353163153;
	j3691511940 [label="這樣總結相當精準。",shape=box,color=red];
		j3691511940 -> j1529676482;
	j4109851678 [label="老實說，我希望人們看到的我不只是那樣。",shape=box,color=red];
		j4109851678 -> j507786944;
	j2029600909 [label="而我也很欣賞你有這個心。他很堅強，能承受加諸於他身上的一切。但一切重擔大家一起扛總是輕鬆一些。",shape=box,color=blue];
		j2029600909 -> j2133132117;
		j2029600909 -> j1833395848;
