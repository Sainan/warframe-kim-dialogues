digraph {
	"MarieRank1Convo5 begins." [color=orange];
		"MarieRank1Convo5 begins." -> j1901728968;
	j1901728968 [label="你好！你一定就是漂泊者了，對吧？Loid 先生跟我說了好多關於你的事。我非常高興能在這個……",shape=box,color=blue];
		j1901728968 -> j1426412165;
	j1426412165 [label="會發出喀噠聲的裝置上「見到」你，儘管它很聰明！",shape=box,color=blue];
		j1426412165 -> j2147420864;
	j2147420864 [label="我是瑪麗・勒魯修女，但你可以叫我瑪麗。我最近和我的靈魂弟兄里昂・阿拉德神父一起來到這裡，還有……嗯，我想 Loid 先生可能已經警告過你那個惡魔了，對不對？",shape=box,color=blue];
		j2147420864 -> j2970866171;
		j2147420864 -> j485030182;
		j2147420864 -> j242691715;
	j2970866171 [label="很高興認識你。別誤會我的意思，這裡歡迎你們，但是……你們來這裡幹嘛？",shape=box,color=red];
		j2970866171 -> j1826939398;
	j485030182 [label="惡魔？你是指那個 Orokin 人？",shape=box,color=red];
		j485030182 -> j2702220262;
	j242691715 [label="[End.]",shape=box,color=red];
		j242691715 -> "Chat ends.";
	j1826939398 [label="+5 Chemistry",color=orange];
		j1826939398 -> j3420054647;
	j2702220262 [label="是的，就是主教託付給我們的那個藍皮膚的討厭鬼。我相信你認識他，叫阿爾布雷希特．源拓氏？他就是我們來這裡的原因。但那恐怕是個很長的故事。",shape=box,color=blue];
		j2702220262 -> j1429431583;
		j2702220262 -> j2407616458;
	"Chat ends." [color=orange];
	j3420054647 [label="謝謝！我們為什麼、怎麼來到這裡，這恐怕是個很長的故事。我們是主教派來的。我相信你認識他，叫阿爾布雷希特．源拓氏？他把那個藍皮膚的討厭鬼託付給我們。",shape=box,color=blue];
		j3420054647 -> j1429431583;
		j3420054647 -> j2407616458;
	j1429431583 [label="我會盡力幫忙。",shape=box,color=red];
		j1429431583 -> j1139979896;
	j2407616458 [label="「託付」？",shape=box,color=red];
		j2407616458 -> j3043714442;
	j1139979896 [label="+5 Chemistry",color=orange];
		j1139979896 -> j3200544477;
	j3043714442 [label="如果可能的話，我們要盡可能引導他的靈魂。如果不可能的話，那我們至少必須確保他不再造成任何傷害。",shape=box,color=blue];
		j3043714442 -> j2056790193;
		j3043714442 -> j379164448;
	j3200544477 [label="你就像 Loid 先生和參研者描述的那樣！我想我們注定會成為好朋友。",shape=box,color=blue];
		j3200544477 -> j2815585108;
	j2056790193 [label="我願意幫你們嘗試。",shape=box,color=red];
		j2056790193 -> j1139979896;
	j379164448 [label="他是 Orokin。你們能做到這點的唯一方法就是在他眉心開一槍。",shape=box,color=red];
		j379164448 -> j969142375;
	j2815585108 [label="啊！原諒我，我得走了。我希望我們很快能再次交談！再見！",shape=box,color=blue];
		j2815585108 -> "Chat ends.";
	j969142375 [label="你聽起來像里昂。我不會放棄希望。至少還不會。",shape=box,color=blue];
		j969142375 -> j2815585108;
}