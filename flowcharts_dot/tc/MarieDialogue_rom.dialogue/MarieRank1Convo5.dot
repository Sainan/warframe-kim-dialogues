digraph {
	3964 [label="MarieRank1Convo5 begins.",color=orange];
		3964 -> 3965;
	3965 [label="你好！你一定就是漂泊者了，對吧？Loid 先生跟我說了好多關於你的事。我非常高興能在這個……",shape=box,color=blue];
		3965 -> 3966;
	3966 [label="會發出喀噠聲的裝置上「見到」你，儘管它很聰明！",shape=box,color=blue];
		3966 -> 3967;
	3967 [label="我是瑪麗・勒魯修女，但你可以叫我瑪麗。我最近和我的靈魂弟兄里昂・阿拉德神父一起來到這裡，還有……嗯，我想 Loid 先生可能已經警告過你那個惡魔了，對不對？",shape=box,color=blue];
		3967 -> 3968;
		3967 -> 3969;
		3967 -> 3970;
	3968 [label="很高興認識你。別誤會我的意思，這裡歡迎你們，但是……你們來這裡幹嘛？",shape=box,color=red];
		3968 -> 3972;
	3969 [label="惡魔？你是指那個 Orokin 人？",shape=box,color=red];
		3969 -> 3974;
	3970 [label="[End.]",shape=box,color=red];
		3970 -> 3971;
	3972 [label="+5 Chemistry",color=orange];
		3972 -> 3973;
	3974 [label="是的，就是主教託付給我們的那個藍皮膚的討厭鬼。我相信你認識他，叫阿爾布雷希特．源拓氏？他就是我們來這裡的原因。但那恐怕是個很長的故事。",shape=box,color=blue];
		3974 -> 3975;
		3974 -> 3976;
	3971 [label="Chat ends.",color=orange];
	3973 [label="Merci ! The what and the how of our being here is a very long story, j'en ai bien peur. We were sent here by le Cardinal. I believe you know him as Albrecht Entrati ? He entrusted us with that blue-skinned monstre irritant.",shape=box,color=blue];
		3973 -> 3975;
		3973 -> 3976;
	3975 [label="我會盡力幫忙。",shape=box,color=red];
		3975 -> 3980;
	3976 [label="「託付」？",shape=box,color=red];
		3976 -> 3977;
	3980 [label="+5 Chemistry",color=orange];
		3980 -> 3981;
	3977 [label="如果可能的話，我們要盡可能引導他的靈魂。如果不可能的話，那我們至少必須確保他不再造成任何傷害。",shape=box,color=blue];
		3977 -> 3978;
		3977 -> 3979;
	3981 [label="你就像 Loid 先生和參研者描述的那樣！我想我們注定會成為好朋友。",shape=box,color=blue];
		3981 -> 3983;
	3978 [label="我願意幫你們嘗試。",shape=box,color=red];
		3978 -> 3980;
	3979 [label="他是 Orokin。你們能做到這點的唯一方法就是在他眉心開一槍。",shape=box,color=red];
		3979 -> 3982;
	3983 [label="啊！原諒我，我得走了。我希望我們很快能再次交談！再見！",shape=box,color=blue];
		3983 -> 3984;
	3982 [label="你聽起來像里昂。我不會放棄希望。至少還不會。",shape=box,color=blue];
		3982 -> 3983;
	3984 [label="Chat ends.",color=orange];
}