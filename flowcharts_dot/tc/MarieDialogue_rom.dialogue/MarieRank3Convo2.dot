digraph {
	1015 [label="MarieRank3Convo2 begins.",color=orange];
		1015 -> 3736;
	3736 [label="Update boolean MarieLyonAvailable",color=orange];
		3736 -> 2923;
	2923 [label="Check boolean LoidFamilyComplete",color=orange];
		2923 -> 2924 [label=true,color=green];
		2923 -> 1016 [label=false,color=brown];
	2924 [label="希望你不會覺得我心態不堅定……但我有時會有種最奇怪的感覺，好像這些事我以前就做過了。",shape=box,color=blue];
		2924 -> 2925;
	1016 [label="Check boolean MarieFamily1",color=orange];
		1016 -> 1017 [label=true,color=green];
		1016 -> 1018 [label=false,color=brown];
	2925 [label="進行過這些對話……遇見過這些人……雖然這是不可能的，對不？",shape=box,color=blue];
		2925 -> 2926;
	1017 [label="你能告訴我更多關於主教大人家族的事嗎？我對他的過去非常著迷。",shape=box,color=blue];
		1017 -> 1020;
		1017 -> 1021;
		1017 -> 1019;
	1018 [label="你能告訴我關於主教大人家族的事嗎？我對他的過去非常著迷。",shape=box,color=blue];
		1018 -> 1020;
		1018 -> 1021;
		1018 -> 1019;
	2926 [label="+20 Chemistry",color=orange];
		2926 -> 2927;
	1020 [label="我會告訴你我所知道的一切，但恐怕我知道的沒有你想像的那麼多。",shape=box,color=red];
		1020 -> 1023;
	1021 [label="喔。當然，但是……找 Loid 談論這個不是更合適嗎？",shape=box,color=red];
		1021 -> 1024;
	1019 [label="[結束]",shape=box,color=red];
		1019 -> 1022;
	2927 [label="我們稱之為既視感。肯定是因為血清和時間旅行的緣故。這就是人生！",shape=box,color=blue];
		2927 -> 2928;
	1023 [label="無論你能告訴我什麼，我都會珍惜。我保證！",shape=box,color=blue];
		1023 -> 1025;
	1024 [label="談論主教……似乎會讓 Loid 先生感到相當痛苦。我不想太常這樣做。",shape=box,color=blue];
		1024 -> 1025;
	1022 [label="Chat ends.",color=orange];
	2928 [label="Chat ends.",color=orange];
	1025 [label="尤其我是帶著某種喜悅這樣做，似乎其他人都不會。",shape=box,color=blue];
		1025 -> 1026;
		1025 -> 1027;
	1026 [label="你想知道誰的事？",shape=box,color=red];
		1026 -> 1028;
	1027 [label="嗯，樓上有母親、父親、兒子、女兒和祖母。",shape=box,color=red];
		1027 -> 1028;
	1028 [label="先挑一個講，可以嗎？每次我問，惡魔都會嘲笑我，彷彿這是他個人的笑話。先從祖母開始吧。",shape=box,color=blue];
		1028 -> 1029;
	1029 [label="她不是主教的妻子，對不？",shape=box,color=blue];
		1029 -> 1030;
	1030 [label="不是，那個是父親的老母親。母親的婆婆。",shape=box,color=red];
		1030 -> 1031;
	1031 [label="我……明白了。那……為什麼他們都不用自己的名字？那樣不是更好嗎？",shape=box,color=blue];
		1031 -> 1032;
		1031 -> 1033;
	1032 [label="你想聽完整的故事嗎？",shape=box,color=red];
		1032 -> 1034;
	1033 [label="我就簡單給你講一下吧。",shape=box,color=red];
		1033 -> 1035;
	1034 [label="是的！我暫時也不需要去別的地方。",shape=box,color=blue];
		1034 -> 1036;
	1035 [label="樓上的家族在 Orokin 帝國崩塌時，被困在了這裡。兒子，也就是源拓氏的孫子，將感染者放進來了。",shape=box,color=red];
		1035 -> 1037;
	1036 [label="好吧，我們在一個叫火衛二的衛星上。很久以前，為了擊退 Sentient，這裡引爆了一顆生物炸彈。",shape=box,color=red];
		1036 -> 1038;
	1037 [label="哦，日尊啊！是故意的嗎？",shape=box,color=blue];
		1037 -> 1039;
	1038 [label="很久以前與 Orokin 交戰的 Sentient 嗎？我們在憶夢池與惡魔一起看到的那些，對吧？",shape=box,color=blue];
		1038 -> 1040;
	1039 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1039 -> 1041 [label=true,color=green];
		1039 -> 1042 [label=true,color=green];
		1039 -> 1042 [label=false,color=brown];
		1039 -> 1043 [label=false,color=brown];
	1040 [label="是的。Orokin 試圖利用感染者來對抗 Sentient。但火衛二被攻陷了。於是他們把自己鎖在了我們樓上的亡骸殿裡尋求庇護。",shape=box,color=red];
		1040 -> 1044;
	1041 [label="不，我認為那是場意外。我覺得他是出於好意。",shape=box,color=red];
		1041 -> 1045;
	1042 [label="我還不知道真相，但在了解更多之前，我會保留意見。",shape=box,color=red];
		1042 -> 1045;
	1043 [label="我還不知道真相，但他很傲慢，這點我可以肯定。",shape=box,color=red];
		1043 -> 1046;
	1044 [label="然而，兒子，也就是源拓氏的孫子，一心想要保存和研究那些被感染的動物。",shape=box,color=red];
		1044 -> 1047;
	1045 [label="+10 Chemistry",color=orange];
		1045 -> 1048;
	1046 [label="真可惜。希望這不是真的，為了他和我們。請繼續。",shape=box,color=blue];
		1046 -> 1049;
	1047 [label="哦，天啊……他本意是好的嗎？",shape=box,color=blue];
		1047 -> 1076;
	1048 [label="你人真好。請繼續。",shape=box,color=blue];
		1048 -> 1049;
	1049 [label="嗯，他們困在亡骸殿裡，深陷悲痛，而且 Orokin 帝國也沒有前來解救他們，現在感染者還滲透進來……",shape=box,color=red];
		1049 -> 1053;
	1076 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1076 -> 1051 [label=true,color=green];
		1076 -> 1052 [label=true,color=green];
		1076 -> 1055 [label=true,color=green];
		1076 -> 1051 [label=false,color=brown];
		1076 -> 1052 [label=false,color=brown];
		1076 -> 1054 [label=false,color=brown];
	1053 [label="他們反目成仇。將彼此徹底撕碎。而感染體則完成了剩下的部分。連他們的名字都被奪走了。",shape=box,color=red];
		1053 -> 1058;
	1051 [label="是的，我相信他的立意良善。我認為他真的關心那些生物。",shape=box,color=red];
		1051 -> 1056;
	1052 [label="遺憾的是，這已經無關緊要，大錯已鑄成。",shape=box,color=red];
		1052 -> 1057;
	1055 [label="不，是傲慢驅使了他。即使他聲稱那是場意外。",shape=box,color=red];
		1055 -> 1059;
	1054 [label="我還不知道真相，但他很傲慢，這點我可以肯定。",shape=box,color=red];
		1054 -> 1059;
	1058 [label="沒有名字簡直殘忍至極……",shape=box,color=blue];
		1058 -> 1062;
	1056 [label="+10 Chemistry",color=orange];
		1056 -> 1060;
	1057 [label="+5 Chemistry",color=orange];
		1057 -> 1061;
	1059 [label="真可惜。希望這不是真的，為了他和我們。請繼續。",shape=box,color=blue];
		1059 -> 1049;
	1062 [label="Update boolean MarieFamily2",color=orange];
		1062 -> 1066;
		1062 -> 1067;
		1062 -> 1068;
	1060 [label="我在想他會如何看待參研者……真可惜他無法見到他們……",shape=box,color=blue];
		1060 -> 1063;
		1060 -> 1064;
	1061 [label="如果只重視個人意圖純潔與否，那麼這個世界會是個美好的地方，對不？這就是人生。",shape=box,color=blue];
		1061 -> 1065;
	1066 [label="除非你像祖母一樣給出去了。",shape=box,color=red];
		1066 -> 1071;
	1067 [label="老實說也沒那麼糟，習慣就好。",shape=box,color=red];
		1067 -> 1072;
	1068 [label="動物沒有名字，而牠們看起來也很快樂。我們給牠們取名只是為了我們自己。",shape=box,color=red];
		1068 -> 1073;
	1063 [label="這個想法讓我覺得好笑。但我認為這並不明智。",shape=box,color=red];
		1063 -> 1069;
	1064 [label="我希望會有這麼一天。我真心希望。",shape=box,color=red];
		1064 -> 1070;
	1065 [label="（法語）然後呢？",shape=box,color=blue];
		1065 -> 1049;
	1071 [label="+5 Chemistry",color=orange];
		1071 -> 1077;
	1072 [label="啊！太可怕了！哦，我不是故意的！這下尷尬了！抱歉，請原諒我，我不是故意的。哦，我真傻！",shape=box,color=blue];
		1072 -> 1078;
		1072 -> 1079;
	1073 [label="+5 Chemistry",color=orange];
		1073 -> 1080;
	1069 [label="而這是為什麼？",shape=box,color=blue];
		1069 -> 1074;
		1069 -> 1075;
	1070 [label="Add 1 to Family",color=orange];
		1070 -> 1050;
	1077 [label="她聽起來像是我會很想認識的一位女士……",shape=box,color=blue];
		1077 -> 1085;
	1078 [label="你打算怎麼補償我？",shape=box,color=red];
		1078 -> 1086;
	1079 [label="沒關係，我只是開玩笑。我沒有生氣。",shape=box,color=red];
		1079 -> 1087;
	1080 [label="確實如此！我從未這樣想過。而且你可以選擇自己的名字。從某種意義上來說，這是多麼地自由啊。",shape=box,color=blue];
		1080 -> 1085;
	1074 [label="恐怕一半人會把另一半人視為「另一個家族」。",shape=box,color=red];
		1074 -> 1081;
	1075 [label="樓上的情況……即使在最好的日子裡也十分脆弱。我不想讓他們不高興。",shape=box,color=red];
		1075 -> 1082;
	1050 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		1050 -> 1083 [label=true,color=green];
		1050 -> 1084 [label=false,color=brown];
	1085 [label="這真是一場美妙的對話，但恐怕輪到我去準備午餐了。Loid 先生正在教我如何按照他的方式正確地奉茶！",shape=box,color=blue];
		1085 -> 1094;
	1086 [label="現在你說的話跟惡魔一樣糟了。不，我絕不會上你的當。",shape=box,color=blue];
		1086 -> 1095;
	1087 [label="+5 Chemistry",color=orange];
		1087 -> 1096;
	1081 [label="Add 1 to Family",color=orange];
		1081 -> 1088;
	1082 [label="你會對靈魂的韌性感到很驚訝。而現在圍繞在我身邊的那些人，年紀都非常大了，如此飽經歲月淬煉。",shape=box,color=blue];
		1082 -> 1089;
	1083 [label="這是可以做到的。也許比你想的更容易。我們只需要想一下怎麼做就好。",shape=box,color=blue];
		1083 -> 1090;
		1083 -> 1091;
	1084 [label="是嗎？你或那小子與樓上家族的工作進展得如何？",shape=box,color=blue];
		1084 -> 1092;
		1084 -> 1093;
	1094 [label="Chat ends.",color=orange];
	1095 [label="Chat ends.",color=orange];
	1096 [label="哦，讚美日尊！但這確實衍生出一個問題……你知道你這個綽號「漂泊者」是怎麼來的嗎？",shape=box,color=blue];
		1096 -> 1099;
		1096 -> 1100;
	1088 [label="+5 Chemistry",color=orange];
		1088 -> 1097;
	1089 [label="+5 Chemistry",color=orange];
		1089 -> 1098;
	1090 [label="我們必須小心行事。恐怕一半人會把另一半人視為「另一個家族」。",shape=box,color=red];
		1090 -> 1081;
	1091 [label="樓上的情況……即使在最好的日子裡也十分脆弱。我不想讓他們不高興。",shape=box,color=red];
		1091 -> 1082;
	1092 [label="慢慢地。細心地。恐怕一半人會把另一半人視為「另一個家族」。",shape=box,color=red];
		1092 -> 1081;
	1093 [label="樓上的情況……即使在最好的日子裡也十分脆弱。我不想讓他們不高興。",shape=box,color=red];
		1093 -> 1082;
	1099 [label="我希望那是我自己取的。",shape=box,color=red];
		1099 -> 1103;
	1100 [label="老實說，我不記得了。",shape=box,color=red];
		1100 -> 1104;
	1097 [label="哦……感謝日君，我想你可能找到答案了！",shape=box,color=blue];
		1097 -> 1101;
	1098 [label="你已經讓他們驚訝過很多次了。這次就讓他們驚訝你一次吧。",shape=box,color=blue];
		1098 -> 1102;
	1103 [label="那該有多自由啊！可以選擇自己的名字。在大教堂裡，我連自己的衣服都不能挑。哈！",shape=box,color=blue];
		1103 -> 1085;
	1104 [label="你充滿神秘感！",shape=box,color=blue];
		1104 -> 1085;
	1101 [label="Update boolean MarieFamilyOther",color=orange];
		1101 -> 1105;
	1102 [label="但拜託，請繼續講你的故事。你的小狼瑪麗在正式狩獵之前，必須先了解她的獵物，對不？",shape=box,color=blue];
		1102 -> 1106;
		1102 -> 1107;
		1102 -> 3914;
	1105 [label="我興奮不已，我坐在這裡，在椅子上扭來扭去！",shape=box,color=blue];
		1105 -> 1102;
	1106 [label="我說到哪裡了？",shape=box,color=red];
		1106 -> 1108;
	1107 [label="你這樣有點壞壞喔，是不是？",shape=box,color=red];
		1107 -> 1109;
	3914 [label="或許我希望你能來狩獵我……",shape=box,color=red];
		3914 -> 3915;
	1108 [label="兒子跟那些感染動物走太近了。",shape=box,color=blue];
		1108 -> 1049;
	1109 [label="也許吧！但以行善之名行點壞事又何妨呢？",shape=box,color=blue];
		1109 -> 1110;
		1109 -> 1111;
	3915 [label="Update boolean DrifterMarie",color=orange];
		3915 -> 3913;
	1110 [label="好吧……反正，回到故事本身。",shape=box,color=red];
		1110 -> 1049;
	1111 [label="別誤會。我就喜歡這樣。",shape=box,color=red];
		1111 -> 1112;
	3913 [label="我會被你給害死！我剛才發出了明顯的尖叫聲，Loid 先生問我是不是還好。我不得不撒謊說我看到一隻老鼠，結果他告訴我這個時代沒有老鼠！",shape=box,color=blue];
		3913 -> 3916;
	1112 [label="哈！我就知道。好了，別鬧了，繼續講你的故事。兒子跟那些感染動物走太近，對吧？",shape=box,color=blue];
		1112 -> 1049;
	3916 [label="+5 Chemistry",color=orange];
		3916 -> 3917;
	3917 [label="（法語）真壞，你太可惡了！我恨你，你現在讓我臉紅了！",shape=box,color=blue];
		3917 -> 3918;
		3917 -> 3919;
	3918 [label="你在生我的氣嗎？",shape=box,color=red];
		3918 -> 3920;
	3919 [label="好吧……總之,回到故事上。",shape=box,color=red];
		3919 -> 1049;
	3920 [label="不是！繼續你的故事就好！",shape=box,color=blue];
		3920 -> 1049;
}