digraph {
	"MarieRank3Convo2 begins." [color=orange];
		"MarieRank3Convo2 begins." -> j3102612293;
	j3102612293 [label="Boolean MarieLyonAvailable is now true.",color=orange];
		j3102612293 -> j369807617;
	j369807617 [label="Check boolean LoidFamilyComplete",color=orange];
		j369807617 -> j2695109125 [label=true,color=green];
		j369807617 -> j1668831657 [label=false,color=brown];
	j2695109125 [label="希望你不會覺得我心態不堅定……但我有時會有種最奇怪的感覺，好像這些事我以前就做過了。",shape=box,color=blue];
		j2695109125 -> j3066023252;
	j1668831657 [label="Check boolean MarieFamily1",color=orange];
		j1668831657 -> j2342452229 [label=true,color=green];
		j1668831657 -> j3084624078 [label=false,color=brown];
	j3066023252 [label="進行過這些對話……遇見過這些人……雖然這是不可能的，對不？",shape=box,color=blue];
		j3066023252 -> j4192840997;
	j2342452229 [label="你能告訴我更多關於主教大人家族的事嗎？我對他的過去非常著迷。",shape=box,color=blue];
		j2342452229 -> j3702094050;
		j2342452229 -> j3844629190;
		j2342452229 -> j1350559949;
	j3084624078 [label="你能告訴我關於主教大人家族的事嗎？我對他的過去非常著迷。",shape=box,color=blue];
		j3084624078 -> j3702094050;
		j3084624078 -> j3844629190;
		j3084624078 -> j1350559949;
	j4192840997 [label="+20 Chemistry",color=orange];
		j4192840997 -> j2170441098;
	j3702094050 [label="我會告訴你我所知道的一切，但恐怕我知道的沒有你想像的那麼多。",shape=box,color=red];
		j3702094050 -> j3311359314;
	j3844629190 [label="喔。當然，但是……找 Loid 談論這個不是更合適嗎？",shape=box,color=red];
		j3844629190 -> j1701016879;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j2170441098 [label="我們稱之為既視感。肯定是因為血清和時間旅行的緣故。這就是人生！",shape=box,color=blue];
		j2170441098 -> "Chat ends.";
	j3311359314 [label="無論你能告訴我什麼，我都會珍惜。我保證！",shape=box,color=blue];
		j3311359314 -> j2324122042;
	j1701016879 [label="談論主教……似乎會讓 Loid 先生感到相當痛苦。我不想太常這樣做。",shape=box,color=blue];
		j1701016879 -> j2324122042;
	"Chat ends." [color=orange];
	j2324122042 [label="尤其我是帶著某種喜悅這樣做，似乎其他人都不會。",shape=box,color=blue];
		j2324122042 -> j944986354;
		j2324122042 -> j3389086140;
	j944986354 [label="你想知道誰的事？",shape=box,color=red];
		j944986354 -> j1395882521;
	j3389086140 [label="嗯，樓上有母親、父親、兒子、女兒和祖母。",shape=box,color=red];
		j3389086140 -> j1395882521;
	j1395882521 [label="先挑一個講，可以嗎？每次我問，惡魔都會嘲笑我，彷彿這是他個人的笑話。先從祖母開始吧。",shape=box,color=blue];
		j1395882521 -> j3835064035;
	j3835064035 [label="她不是主教的妻子，對不？",shape=box,color=blue];
		j3835064035 -> j3862046481;
	j3862046481 [label="不是，那個是父親的老母親。母親的婆婆。",shape=box,color=red];
		j3862046481 -> j1539490558;
	j1539490558 [label="我……明白了。那……為什麼他們都不用自己的名字？那樣不是更好嗎？",shape=box,color=blue];
		j1539490558 -> j1139700338;
		j1539490558 -> j969926690;
	j1139700338 [label="你想聽完整的故事嗎？",shape=box,color=red];
		j1139700338 -> j1791273376;
	j969926690 [label="我就簡單給你講一下吧。",shape=box,color=red];
		j969926690 -> j3868262860;
	j1791273376 [label="是的！我暫時也不需要去別的地方。",shape=box,color=blue];
		j1791273376 -> j2725806499;
	j3868262860 [label="樓上的家族在 Orokin 帝國崩塌時，被困在了這裡。兒子，也就是源拓氏的孫子，將感染者放進來了。",shape=box,color=red];
		j3868262860 -> j3775514369;
	j2725806499 [label="好吧，我們在一個叫火衛二的衛星上。很久以前，為了擊退 Sentient，這裡引爆了一顆生物炸彈。",shape=box,color=red];
		j2725806499 -> j1374149639;
	j3775514369 [label="哦，日尊啊！是故意的嗎？",shape=box,color=blue];
		j3775514369 -> j2753523360;
	j1374149639 [label="很久以前與 Orokin 交戰的 Sentient 嗎？我們在憶夢池與惡魔一起看到的那些，對吧？",shape=box,color=blue];
		j1374149639 -> j4002188262;
	j2753523360 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j2753523360 -> j4116484623 [label=true,color=green];
		j2753523360 -> j123404285 [label=true,color=green];
		j2753523360 -> j123404285 [label=false,color=brown];
		j2753523360 -> j3995511353 [label=false,color=brown];
	j4002188262 [label="是的。Orokin 試圖利用感染者來對抗 Sentient。但火衛二被攻陷了。於是他們把自己鎖在了我們樓上的亡骸殿裡尋求庇護。",shape=box,color=red];
		j4002188262 -> j1621080794;
	j4116484623 [label="不，我認為那是場意外。我覺得他是出於好意。",shape=box,color=red];
		j4116484623 -> j2628341609;
	j123404285 [label="我還不知道真相，但在了解更多之前，我會保留意見。",shape=box,color=red];
		j123404285 -> j2628341609;
	j3995511353 [label="我還不知道真相，但他很傲慢，這點我可以肯定。",shape=box,color=red];
		j3995511353 -> j1688022678;
	j1621080794 [label="然而，兒子，也就是源拓氏的孫子，一心想要保存和研究那些被感染的動物。",shape=box,color=red];
		j1621080794 -> j1708537772;
	j2628341609 [label="+10 Chemistry",color=orange];
		j2628341609 -> j474586277;
	j1688022678 [label="真可惜。希望這不是真的，為了他和我們。請繼續。",shape=box,color=blue];
		j1688022678 -> j3568650751;
	j1708537772 [label="哦，天啊……他本意是好的嗎？",shape=box,color=blue];
		j1708537772 -> j2755410679;
	j474586277 [label="你人真好。請繼續。",shape=box,color=blue];
		j474586277 -> j3568650751;
	j3568650751 [label="嗯，他們困在亡骸殿裡，深陷悲痛，而且 Orokin 帝國也沒有前來解救他們，現在感染者還滲透進來……",shape=box,color=red];
		j3568650751 -> j4048072343;
	j2755410679 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j2755410679 -> j330870547 [label=true,color=green];
		j2755410679 -> j2810933481 [label=true,color=green];
		j2755410679 -> j1934513458 [label=true,color=green];
		j2755410679 -> j330870547 [label=false,color=brown];
		j2755410679 -> j2810933481 [label=false,color=brown];
		j2755410679 -> j719266953 [label=false,color=brown];
	j4048072343 [label="他們反目成仇。將彼此徹底撕碎。而感染體則完成了剩下的部分。連他們的名字都被奪走了。",shape=box,color=red];
		j4048072343 -> j2315306509;
	j330870547 [label="是的，我相信他的立意良善。我認為他真的關心那些生物。",shape=box,color=red];
		j330870547 -> j4171813;
	j2810933481 [label="遺憾的是，這已經無關緊要，大錯已鑄成。",shape=box,color=red];
		j2810933481 -> j2922262453;
	j1934513458 [label="不，是傲慢驅使了他。即使他聲稱那是場意外。",shape=box,color=red];
		j1934513458 -> j1688022678;
	j719266953 [label="我還不知道真相，但他很傲慢，這點我可以肯定。",shape=box,color=red];
		j719266953 -> j1688022678;
	j2315306509 [label="沒有名字簡直殘忍至極……",shape=box,color=blue];
		j2315306509 -> j482800561;
	j4171813 [label="+10 Chemistry",color=orange];
		j4171813 -> j2867707790;
	j2922262453 [label="+5 Chemistry",color=orange];
		j2922262453 -> j731007238;
	j482800561 [label="Boolean MarieFamily2 is now true.",color=orange];
		j482800561 -> j2962260291;
		j482800561 -> j1438700296;
		j482800561 -> j227802417;
	j2867707790 [label="我在想他會如何看待參研者……真可惜他無法見到他們……",shape=box,color=blue];
		j2867707790 -> j3747052151;
		j2867707790 -> j849505974;
	j731007238 [label="如果只重視個人意圖純潔與否，那麼這個世界會是個美好的地方，對不？這就是人生。",shape=box,color=blue];
		j731007238 -> j3988597389;
	j2962260291 [label="除非你像祖母一樣給出去了。",shape=box,color=red];
		j2962260291 -> j3427506692;
	j1438700296 [label="老實說也沒那麼糟，習慣就好。",shape=box,color=red];
		j1438700296 -> j3118756119;
	j227802417 [label="動物沒有名字，而牠們看起來也很快樂。我們給牠們取名只是為了我們自己。",shape=box,color=red];
		j227802417 -> j524474117;
	j3747052151 [label="這個想法讓我覺得好笑。但我認為這並不明智。",shape=box,color=red];
		j3747052151 -> j550704115;
	j849505974 [label="我希望會有這麼一天。我真心希望。",shape=box,color=red];
		j849505974 -> j3948333923;
	j3988597389 [label="（法語）然後呢？",shape=box,color=blue];
		j3988597389 -> j3568650751;
	j3427506692 [label="+5 Chemistry",color=orange];
		j3427506692 -> j3605528246;
	j3118756119 [label="啊！太可怕了！哦，我不是故意的！這下尷尬了！抱歉，請原諒我，我不是故意的。哦，我真傻！",shape=box,color=blue];
		j3118756119 -> j630162159;
		j3118756119 -> j384860791;
	j524474117 [label="+5 Chemistry",color=orange];
		j524474117 -> j2008375655;
	j550704115 [label="而這是為什麼？",shape=box,color=blue];
		j550704115 -> j862904321;
		j550704115 -> j555378906;
	j3948333923 [label="Add 1 to Family counter",color=orange];
		j3948333923 -> j1827137725;
	j3605528246 [label="她聽起來像是我會很想認識的一位女士……",shape=box,color=blue];
		j3605528246 -> j4153622759;
	j630162159 [label="你打算怎麼補償我？",shape=box,color=red];
		j630162159 -> j2876173054;
	j384860791 [label="沒關係，我只是開玩笑。我沒有生氣。",shape=box,color=red];
		j384860791 -> j707281633;
	j2008375655 [label="確實如此！我從未這樣想過。而且你可以選擇自己的名字。從某種意義上來說，這是多麼地自由啊。",shape=box,color=blue];
		j2008375655 -> j4153622759;
	j862904321 [label="恐怕一半人會把另一半人視為「另一個家族」。",shape=box,color=red];
		j862904321 -> j4232166134;
	j555378906 [label="樓上的情況……即使在最好的日子裡也十分脆弱。我不想讓他們不高興。",shape=box,color=red];
		j555378906 -> j2314352662;
	j1827137725 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j1827137725 -> j1205561046 [label=true,color=green];
		j1827137725 -> j1379876639 [label=false,color=brown];
	j4153622759 [label="這真是一場美妙的對話，但恐怕輪到我去準備午餐了。Loid 先生正在教我如何按照他的方式正確地奉茶！",shape=box,color=blue];
		j4153622759 -> "Chat ends.";
	j2876173054 [label="現在你說的話跟惡魔一樣糟了。不，我絕不會上你的當。",shape=box,color=blue];
		j2876173054 -> "Chat ends.";
	j707281633 [label="+5 Chemistry",color=orange];
		j707281633 -> j1411564856;
	j4232166134 [label="Add 1 to Family counter",color=orange];
		j4232166134 -> j3828331977;
	j2314352662 [label="你會對靈魂的韌性感到很驚訝。而現在圍繞在我身邊的那些人，年紀都非常大了，如此飽經歲月淬煉。",shape=box,color=blue];
		j2314352662 -> j3895574301;
	j1205561046 [label="這是可以做到的。也許比你想的更容易。我們只需要想一下怎麼做就好。",shape=box,color=blue];
		j1205561046 -> j1383968868;
		j1205561046 -> j555378906;
	j1379876639 [label="是嗎？你或那小子與樓上家族的工作進展得如何？",shape=box,color=blue];
		j1379876639 -> j886384433;
		j1379876639 -> j555378906;
	j1411564856 [label="哦，讚美日尊！但這確實衍生出一個問題……你知道你這個綽號「漂泊者」是怎麼來的嗎？",shape=box,color=blue];
		j1411564856 -> j2163120699;
		j1411564856 -> j3428615611;
	j3828331977 [label="+5 Chemistry",color=orange];
		j3828331977 -> j42155368;
	j3895574301 [label="+5 Chemistry",color=orange];
		j3895574301 -> j204555972;
	j1383968868 [label="我們必須小心行事。恐怕一半人會把另一半人視為「另一個家族」。",shape=box,color=red];
		j1383968868 -> j4232166134;
	j886384433 [label="慢慢地。細心地。恐怕一半人會把另一半人視為「另一個家族」。",shape=box,color=red];
		j886384433 -> j4232166134;
	j2163120699 [label="我希望那是我自己取的。",shape=box,color=red];
		j2163120699 -> j103096184;
	j3428615611 [label="老實說，我不記得了。",shape=box,color=red];
		j3428615611 -> j1017983376;
	j42155368 [label="哦……感謝日君，我想你可能找到答案了！",shape=box,color=blue];
		j42155368 -> j4169678502;
	j204555972 [label="你已經讓他們驚訝過很多次了。這次就讓他們驚訝你一次吧。",shape=box,color=blue];
		j204555972 -> j3893778601;
	j103096184 [label="那該有多自由啊！可以選擇自己的名字。在大教堂裡，我連自己的衣服都不能挑。哈！",shape=box,color=blue];
		j103096184 -> j4153622759;
	j1017983376 [label="你充滿神秘感！",shape=box,color=blue];
		j1017983376 -> j4153622759;
	j4169678502 [label="Boolean MarieFamilyOther is now true.",color=orange];
		j4169678502 -> j1599207475;
	j3893778601 [label="但拜託，請繼續講你的故事。你的小狼瑪麗在正式狩獵之前，必須先了解她的獵物，對不？",shape=box,color=blue];
		j3893778601 -> j851594001;
		j3893778601 -> j1224364939;
		j3893778601 -> j1499936029;
	j1599207475 [label="我興奮不已，我坐在這裡，在椅子上扭來扭去！",shape=box,color=blue];
		j1599207475 -> j3893778601;
	j851594001 [label="我說到哪裡了？",shape=box,color=red];
		j851594001 -> j3967029601;
	j1224364939 [label="你這樣有點壞壞喔，是不是？",shape=box,color=red];
		j1224364939 -> j1891182417;
	j1499936029 [label="或許我希望你能來狩獵我……",shape=box,color=red];
		j1499936029 -> j74629841;
	j3967029601 [label="兒子跟那些感染動物走太近了。",shape=box,color=blue];
		j3967029601 -> j3568650751;
	j1891182417 [label="也許吧！但以行善之名行點壞事又何妨呢？",shape=box,color=blue];
		j1891182417 -> j117151551;
		j1891182417 -> j2411308683;
	j74629841 [label="Boolean DrifterMarie is now true.",color=orange];
		j74629841 -> j1838252514;
	j117151551 [label="好吧……反正，回到故事本身。",shape=box,color=red];
		j117151551 -> j3568650751;
	j2411308683 [label="別誤會。我就喜歡這樣。",shape=box,color=red];
		j2411308683 -> j4225737864;
	j1838252514 [label="我會被你給害死！我剛才發出了明顯的尖叫聲，Loid 先生問我是不是還好。我不得不撒謊說我看到一隻老鼠，結果他告訴我這個時代沒有老鼠！",shape=box,color=blue];
		j1838252514 -> j978475042;
	j4225737864 [label="哈！我就知道。好了，別鬧了，繼續講你的故事。兒子跟那些感染動物走太近，對吧？",shape=box,color=blue];
		j4225737864 -> j3568650751;
	j978475042 [label="+5 Chemistry",color=orange];
		j978475042 -> j3071545125;
	j3071545125 [label="（法語）真壞，你太可惡了！我恨你，你現在讓我臉紅了！",shape=box,color=blue];
		j3071545125 -> j3515244886;
		j3071545125 -> j1242609859;
	j3515244886 [label="你在生我的氣嗎？",shape=box,color=red];
		j3515244886 -> j4160969382;
	j1242609859 [label="好吧……總之,回到故事上。",shape=box,color=red];
		j1242609859 -> j3568650751;
	j4160969382 [label="不是！繼續你的故事就好！",shape=box,color=blue];
		j4160969382 -> j3568650751;
}