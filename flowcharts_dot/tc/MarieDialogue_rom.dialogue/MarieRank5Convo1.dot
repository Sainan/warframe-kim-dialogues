	2562 [label="（法語）閉嘴！",shape=box,color=blue];
		2562 -> 2571;
	2563 [label="我……我不是那個意思。這不是聖戰，這完全是……",shape=box,color=blue];
		2563 -> 2572;
	2564 [label="是的！確實如此。而且我相信每個人最終都會想通的。我只是很高興在這件事上有個朋友陪伴我。",shape=box,color=blue];
		2564 -> 2573;
	2565 [label="相信我，你不是。無數人為此失去性命。我可以列舉一長串因他而人生盡毀的人。但沒有人會忘記漠然。",shape=box,color=red];
		2565 -> 2574;
	2566 [label="如果我見到她，我確定很快就會知道了！這裡每個人都如此急於告訴我他們在他手下遭受的所有痛苦！難怪主教不回來。如果我是他，我一刻都不會想待在這裡──",shape=box,color=blue];
		2566 -> 2575;
	2567 [label="我反而認為這樣更不會把他給嚇跑！你認為主教會回到這個毒蛇窩嗎？！不！如果我是他，我一刻都不會想待在這裡──",shape=box,color=blue];
		2567 -> 2575;
	2569 [label="+20 Chemistry",color=orange];
		2569 -> 2577;
