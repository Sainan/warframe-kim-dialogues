digraph {
	2427 [label="MarieRank5Convo1 begins.",color=orange];
		2427 -> 2428;
	2428 [label="我們能談談嗎？",shape=box,color=blue];
		2428 -> 2429;
	2429 [label="Evaluate expressions",color=orange];
		2429 -> 2430 [label="MarieEntrati4a",color=purple];
		2429 -> 2431 [label="MarieEntrati4b",color=purple];
		2429 -> 2432 [label="MarieEntrati3a",color=purple];
		2429 -> 2433 [label="MarieEntrati3b",color=purple];
		2429 -> 2434 [label="MarieEntrati3",color=purple];
		2429 -> 2435 [label="false",color=purple];
	2430 [label="我一直在思考你說的關於主教的話。他的行為是……善惡「混合」的。",shape=box,color=blue];
		2430 -> 2436;
	2431 [label="我一直在思考你關於主教的話。他的行為給里昂帶來了痛苦。",shape=box,color=blue];
		2431 -> 2436;
	2432 [label="我一直在思考我們關於汰廢先生的對話，以及你對他為何如此憎恨主教而提出的具有說服力的論點。",shape=box,color=blue];
		2432 -> 2436;
	2433 [label="我一直在思考我和汰廢先生的爭執，以及他如此憎恨主教的原因。",shape=box,color=blue];
		2433 -> 2436;
	2434 [label="我一直在思考我和汰廢先生的爭執。還有我們關於那場爭執的爭執。",shape=box,color=blue];
		2434 -> 2436;
	2435 [label="我覺得關於主教還有很多事大家都閉口不談。其他人似乎在我周圍如履薄冰，害怕談論他。",shape=box,color=blue];
		2435 -> 2436;
	2436 [label="我知道其他人想把他描繪成惡棍、瘋子、叛徒。但對我來說他不是那類人。",shape=box,color=blue];
		2436 -> 2437;
	2437 [label="Check boolean MarieBackstory1",color=orange];
		2437 -> 2439 [label=true,color=green];
		2437 -> 2438 [label=false,color=brown];
	2439 [label="或許是因為我太習慣被拋棄了。",shape=box,color=blue];
		2439 -> 2440;
	2438 [label="我在年幼時就被家人拋棄，流落街頭，只因我被視為……異常。破碎。不配屬於所謂的上流社會。",shape=box,color=blue];
		2438 -> 2440;
	2440 [label="或許是因為我生命裡從未有過父親，所以對於他的缺席，我能如此輕易地原諒。",shape=box,color=blue];
		2440 -> 2441;
	2441 [label="Evaluate expressions",color=orange];
		2441 -> 2442 [label="MarieEntrati4a",color=purple];
		2441 -> 2443 [label="MarieEntrati4b",color=purple];
		2441 -> 2444 [label="MarieEntrati3a",color=purple];
		2441 -> 2445 [label="MarieEntrati3b",color=purple];
		2441 -> 2446 [label="MarieEntrati3",color=purple];
		2441 -> 2447 [label="false",color=purple];
	2442 [label="但事實仍然是我確實原諒了他。因為我在他的善行中看到的價值多過他的惡行所造成的傷害。",shape=box,color=blue];
		2442 -> 2448;
		2442 -> 2449;
		2442 -> 2450;
		2442 -> 2451;
		2442 -> 2452;
	2443 [label="我祈禱里昂堅強並度過他遭受的信仰危機，但我不相信這完全是主教造成的錯。",shape=box,color=blue];
		2443 -> 2448;
		2443 -> 2449;
		2443 -> 2450;
		2443 -> 2453;
		2443 -> 2454;
	2444 [label="所以雖然我感謝你提出關於汰廢先生和那些被他傷害的人的具有說服力的論點……我仍然在他的善行中看到的價值多過他的惡行所造成的傷害。",shape=box,color=blue];
		2444 -> 2448;
		2444 -> 2449;
		2444 -> 2450;
		2444 -> 2455;
		2444 -> 2456;
	2445 [label="所以雖然我理解汰廢先生的憤怒，也能同情他的觀點，但他必須在自己心中找到寬恕主教的空間。因為我在主教的善行中看到的價值多過他的惡行所造成的傷害。",shape=box,color=blue];
		2445 -> 2448;
		2445 -> 2449;
		2445 -> 2450;
		2445 -> 2457;
		2445 -> 2458;
	2446 [label="所以雖然我理解每個人與主教的歷史，尤其是汰廢先生，我仍然在他的善行中看到更多價值，而不是他的惡行所造成的傷害。",shape=box,color=blue];
		2446 -> 2448;
		2446 -> 2449;
		2446 -> 2450;
		2446 -> 2459;
	2447 [label="所以雖然我理解每個人與主教的歷史，我仍然在他的善行中看到更多價值，而不是他的惡行所造成的傷害。",shape=box,color=blue];
		2447 -> 2448;
		2447 -> 2449;
		2447 -> 2450;
	2448 [label="我不會責怪你珍惜他在你生命中做過的好事，就像我不會責怪其他人憎恨他在他們生命中造成的傷害一樣。",shape=box,color=red];
		2448 -> 2460;
	2449 [label="我不知道。我認為他的行為造成的傷害遠大於好處。我希望你能明白這點。",shape=box,color=red];
		2449 -> 2461;
	2450 [label="瑪麗，我站在你這邊。我無法責怪源拓氏所做的任何事。他正在對抗漠然。",shape=box,color=red];
		2450 -> 2462;
	2451 [label="你寬恕源拓氏是對的。我希望更多人能效法你的做法。",shape=box,color=red];
		2451 -> 2462;
	2452 [label="我從不會責怪選擇原諒的人。但原諒一個人時，也要明白你仍需保護自己與他人，免受其害。",shape=box,color=red];
		2452 -> 2463;
	2453 [label="你認為里昂的痛苦是他自己的錯？",shape=box,color=red];
		2453 -> 2464;
	2454 [label="瑪麗，里昂遭受的痛苦遠不止信仰危機。而這很大程度與源拓氏有關。",shape=box,color=red];
		2454 -> 2461;
	2455 [label="我說的那些話，就一點也沒能改變你的看法嗎？",shape=box,color=red];
		2455 -> 2465;
	2456 [label="你怎麼能看著源拓氏做的一切，仍然覺得好處多過壞處？",shape=box,color=red];
		2456 -> 2461;
	2457 [label="我覺得你低估了參研者和汰廢所承受苦難的嚴重程度。",shape=box,color=red];
		2457 -> 2461;
	2458 [label="寬恕固然重要，但承認源拓氏或許比你願意接受的更為複雜，也同樣重要。",shape=box,color=red];
		2458 -> 2465;
	2459 [label="我仍然不覺得你真正理解汰廢和參研者所承受的一切，那比你經歷的還要更糟。",shape=box,color=red];
		2459 -> 2461;
	2460 [label="但你難道不覺得，怨恨與崇敬這兩者本就不是同等的嗎？我只是希望其他人能放下那惡意的怨懟。",shape=box,color=blue];
		2460 -> 2466;
		2460 -> 2467;
	2461 [label="Evaluate expressions",color=orange];
		2461 -> 2469 [label="MarieEntratiMonster1",color=purple];
		2461 -> 2469 [label="MarieEntratiMonster2",color=purple];
		2461 -> 2468 [label="MarieEntratiFan1",color=purple];
		2461 -> 2468 [label="MarieEntratiFan2",color=purple];
		2461 -> 2470 [label="false",color=purple];
	2462 [label="Evaluate expressions",color=orange];
		2462 -> 2473 [label="MarieEntratiMonster1",color=purple];
		2462 -> 2473 [label="MarieEntratiMonster2",color=purple];
		2462 -> 2471 [label="MarieEntratiFan1",color=purple];
		2462 -> 2471 [label="MarieEntratiFan2",color=purple];
		2462 -> 2472 [label="false",color=purple];
	2463 [label="那你是要我們怎麼做？把主教逐出去嗎？在我看來，他似乎早已先把自己逐出了，不是嗎？",shape=box,color=blue];
		2463 -> 2474;
		2463 -> 2467;
	2464 [label="我認為里昂承受著許多折磨，多半源於他對自己、對自身心靈的懷疑。而主教似乎只是……讓一切更快惡化了。",shape=box,color=blue];
		2464 -> 2475;
		2464 -> 2467;
	2465 [label="那你要我做什麼？燒掉主教的肖像並譴責他？把他打入虛空，像汰廢先生那樣咒他受苦嗎？",shape=box,color=blue];
		2465 -> 2474;
		2465 -> 2467;
	2466 [label="瑪麗，問題就在這裡。是你在要求別人，而不是他們在要求你，或要求源拓氏。",shape=box,color=red];
		2466 -> 2476;
	2467 [label="源拓氏無論走到哪裡，都會留下受傷的人。我所做的，只是盡力替那些人把破碎的一切重新拼湊起來。至於他在這裡所謂的「善」或「惡」，我並不太在乎。",shape=box,color=red];
		2467 -> 2477;
	2469 [label="是的，而你對他的仇恨始終如一！難道我說的那些話，沒有讓你對主教的態度稍微軟化一點嗎？",shape=box,color=blue];
		2469 -> 2482;
	2468 [label="你剛才不是還在跟我說你像我一樣支持源拓氏嗎？現在是什麼改變了你的想法？",shape=box,color=blue];
		2468 -> 2478;
		2468 -> 2479;
		2468 -> 2480;
		2468 -> 2481;
	2470 [label="是的，而你似乎認為源拓氏是個怪物！你同樣如此迅速地否定他的善意！",shape=box,color=blue];
		2470 -> 2482;
	2473 [label="你剛才不是還在跟我說源拓氏有多可怕嗎？現在是什麼改變了你的想法？",shape=box,color=blue];
		2473 -> 2478;
		2473 -> 2479;
		2473 -> 2480;
		2473 -> 2481;
	2471 [label="謝謝，你一直是我在這場征戰中的堅定夥伴！我擔心在這件事上我們是孤獨的，甚至 Loid 先生都懷著那樣的怨懟……",shape=box,color=blue];
		2471 -> 2483;
	2472 [label="謝謝，我真的很高興聽到這句話！我擔心在這件事上我們是孤獨的，甚至 Loid 先生都懷著那樣的怨懟……",shape=box,color=blue];
		2472 -> 2483;
	2474 [label="我認為問題更多在於，你要求別人做什麼，而不是他們對你或對源拓氏有所要求。",shape=box,color=red];
		2474 -> 2476;
	2475 [label="而這不會困擾你嗎？",shape=box,color=red];
		2475 -> 2484;
	2476 [label="而我要求別人做的，到底有什麼如此不堪？不過是希望他們能在心裡接受寬恕而已嗎？",shape=box,color=blue];
		2476 -> 2485;
		2476 -> 2486;
	2477 [label="穿梭時空去幫助那些對他不滿的人固然高尚，但也確實累人，對不？你肯定會為此怨恨他……",shape=box,color=blue];
		2477 -> 2487;
		2477 -> 2488;
	2482 [label="這次對話真是個錯誤……",shape=box,color=blue];
		2482 -> 2493;
		2482 -> 2494;
	2478 [label="老實說，我一直很努力和你探討這個話題。真的非常痛苦。我個人認為他……既不善也不惡。而是兩者兼具。",shape=box,color=red];
		2478 -> 2489;
	2479 [label="我改變主意了。我站在他和你這邊。你說服我了。",shape=box,color=red];
		2479 -> 2490;
	2480 [label="[表白心意] 恐怕是我一直在努力……博取你的好感。我對你有感覺。遠比我表現出來的還要多。",shape=box,color=red];
		2480 -> 2491;
	2481 [label="我改變主意了，從此徹底認定他就是個怪物。",shape=box,color=red];
		2481 -> 2492;
	2483 [label="也許我們可以一起守護他的善行，對抗那些會詆毀它的人，對吧？但我很好奇，面對你周圍的一切……為什麼會選擇站在我這邊？",shape=box,color=blue];
		2483 -> 2495;
	2484 [label="Check boolean LyonDating",color=orange];
		2484 -> 2496 [label=true,color=green];
		2484 -> 2497 [label=false,color=brown];
	2485 [label="瑪麗，你把源拓氏拱上神壇了。而你在要求其他人也像白痴一樣這麼做。",shape=box,color=red];
		2485 -> 2498;
	2486 [label="我認為你要求他們做的不只是寬恕源拓氏。我認為你要求他們假裝他的所作所為從來都沒錯。",shape=box,color=red];
		2486 -> 2499;
	2487 [label="當然。但我也要「感謝」他讓我擁有了一些最重要的關係和友誼。",shape=box,color=red];
		2487 -> 2500;
	2488 [label="不，不是那樣。他需要我去做，我就會去做。等一切塵埃落定之後，我再來評判他。",shape=box,color=red];
		2488 -> 2500;
	2493 [label="瑪麗，等一下。拜託。讓我解釋。",shape=box,color=red];
		2493 -> 2505;
		2493 -> 2506;
		2493 -> 2507;
		2493 -> 2508;
	2494 [label="我已經說得夠清楚了，我對源拓氏的立場就是如此。抱歉，有些事我們的看法恐怕無法一致。",shape=box,color=red];
		2494 -> 2509;
	2489 [label="Update boolean MarieEntratiMonster1",color=orange];
		2489 -> 2501;
	2490 [label="Update boolean MarieEntratiMonster1",color=orange];
		2490 -> 2502;
	2491 [label="Update boolean DrifterMarieWhoops",color=orange];
		2491 -> 2503;
	2492 [label="Update boolean MarieEntratiFan1",color=orange];
		2492 -> 2504;
	2495 [label="當然，我並不是在抱怨！",shape=box,color=blue];
		2495 -> 2510;
		2495 -> 2511;
		2495 -> 2512;
	2496 [label="我知道他在你心中找到了位置，對此我非常感激，或許我終於可以不用再擔心他了，所有這些爭執很快就會變得毫無意義──",shape=box,color=blue];
		2496 -> 2497;
	2497 [label="但是，這件事當然困擾著我。他是我的靈魂弟兄！我的里昂是這個世界上對我最珍貴的人，看到他痛苦讓我胸口疼痛，彷彿他的痛苦就是我的。",shape=box,color=blue];
		2497 -> 2513;
	2498 [label="漂泊者，注意你的言詞。",shape=box,color=blue];
		2498 -> 2514;
	2499 [label="我不天真，別把我當成那樣！",shape=box,color=blue];
		2499 -> 2515;
	2500 [label="或許他只是在刺破毒瘡，好讓身體得以癒合，而這一切不過是必要的殘酷。",shape=box,color=blue];
		2500 -> 2516;
		2500 -> 2517;
	2505 [label="[表白心意] 我在乎你。遠比我表現出來的還要多。而且我……我很抱歉我的語氣一直過於苛刻，但我不能讓他像傷害那麼多人一樣傷害你。",shape=box,color=red];
		2505 -> 2523;
	2506 [label="我親眼看著源拓氏一再毀掉他所在乎的每一個人，每個他聲稱愛過的人。我不想看到他對你也那樣做……",shape=box,color=red];
		2506 -> 2524;
	2507 [label="我不太擅長表達自己，對此我很抱歉。但他……我擔心他在利用你，利用你的善良來操縱你。就這樣。",shape=box,color=red];
		2507 -> 2525;
	2508 [label="你也許把源拓氏視為救世主，但在我眼中，他只是個徬徨無助、苦苦尋找答案的老人。也許真相就在這兩者之間。",shape=box,color=red];
		2508 -> 2498;
	2509 [label="是的。似乎是這樣。",shape=box,color=blue];
		2509 -> 2526;
	2501 [label="Update boolean MarieEntratiMonster2",color=orange];
		2501 -> 2518;
	2502 [label="Update boolean MarieEntratiMonster2",color=orange];
		2502 -> 2519;
	2503 [label="而你決定欺騙我來博取我的好感……我明白了。",shape=box,color=blue];
		2503 -> 2520;
		2503 -> 2521;
	2504 [label="Update boolean MarieEntratiFan2",color=orange];
		2504 -> 2522;
	2510 [label="[表白心意] 我在乎你。遠比我表現出來的還要多。",shape=box,color=red];
		2510 -> 2527;
	2511 [label="我相信在這場戰爭中，凡事都是必要的。畢竟我們正在試圖拯救宇宙對抗漠然，不是嗎？",shape=box,color=red];
		2511 -> 2528;
	2512 [label="老實說，我相信源拓氏。我認為他有計劃解決這個問題，而最終這一切都是為了的最好結果。",shape=box,color=red];
		2512 -> 2529;
	2513 [label="但他信仰的崩塌不是主教造成的。根基上的裂縫早已存在。只不過是雪上加霜罷了，對不？",shape=box,color=blue];
		2513 -> 2500;
	2514 [label="Update boolean MarieWarning",color=orange];
		2514 -> 2499;
	2515 [label="我很清楚主教既是太陰又是太陽、光與暗、善與惡。他兩者都不是，又兩者都是，既能仁慈也能殘忍。",shape=box,color=blue];
		2515 -> 2530;
		2515 -> 2531;
	2516 [label="這就是為什麼當你談起他時其他人會不高興。你掩飾他做過傷害他們的一切，並像白痴一樣假裝什麼都沒發生。",shape=box,color=red];
		2516 -> 2498;
	2517 [label="瑪麗，夠了。你需要接受他做這一切並不純粹是因為他是好人。他不是。他比那更複雜。",shape=box,color=red];
		2517 -> 2499;
	2523 [label="Update boolean DrifterMarie",color=orange];
		2523 -> 2536;
	2524 [label="漂泊者，注意你的言詞。",shape=box,color=blue];
		2524 -> 2537;
	2525 [label="我不需要被這樣保護！我不是天真的小孩！",shape=box,color=blue];
		2525 -> 2538;
	2526 [label="Update boolean MarieEntrati5g",color=orange];
		2526 -> 2539;
	2518 [label="Update boolean MarieEntratiFan1",color=orange];
		2518 -> 2532;
	2519 [label="Update boolean MarieEntratiFan2",color=orange];
		2519 -> 2533;
	2520 [label="嗯，當你這麼說的時候……",shape=box,color=red];
		2520 -> 2534;
	2521 [label="只是部分。",shape=box,color=red];
		2521 -> 2534;
	2522 [label="Update boolean MarieEntratiMonster2",color=orange];
		2522 -> 2535;
	2527 [label="Update boolean DrifterMarieWhoops",color=orange];
		2527 -> 2540;
	2528 [label="是的！沒錯！終於有人能看清楚了。無辜者必須在這場戰爭中受到傷害，這讓我心碎，但一切都岌岌可危。",shape=box,color=blue];
		2528 -> 2541;
	2529 [label="Update boolean MarieWillDate",color=orange];
		2529 -> 2542;
	2530 [label="瑪麗，他不是神。他只是個人。他和羅瑟一樣傲慢、一樣危險。他們來自同個社會，都有同樣的問題。",shape=box,color=red];
		2530 -> 2543;
	2531 [label="我知道他對你很好。我知道他對你的態度可能和對許多人不同。也許他甚至把你當女兒對待……但請綜觀全局。",shape=box,color=red];
		2531 -> 2544;
	2536 [label="我──我不知道該如何處理這個消息，考慮到……考慮到我們目前的對話。我被……這讓我相當驚訝。",shape=box,color=blue];
		2536 -> 2549;
	2537 [label="Update boolean MarieWarning",color=orange];
		2537 -> 2525;
	2538 [label="我很清楚主教既是太陰又是太陽、光與暗、善與惡。他兩者都不是，又兩者都是，既能仁慈也能殘忍。",shape=box,color=blue];
		2538 -> 2531;
		2538 -> 2530;
	2539 [label="Chat ends. Next chat will be MarieEntratiDay2.",color=orange];
	2532 [label="Update boolean MarieEntratiFan2",color=orange];
		2532 -> 2545;
	2533 [label="是嗎？我……抱有希望，但並不信服。漂泊者，你更應該謹慎言行……",shape=box,color=blue];
		2533 -> 2546;
	2534 [label="Update boolean MarieNoDate",color=orange];
		2534 -> 2547;
	2535 [label="是嗎？你是把我當小孩還是傻瓜？漂泊者，你更應該謹慎言行……",shape=box,color=blue];
		2535 -> 2548;
	2540 [label="而你選擇站在主教那邊是為了博取我的好感……我明白了。",shape=box,color=blue];
		2540 -> 2550;
		2540 -> 2551;
	2541 [label="而在戰爭中，無辜的生命會被犧牲。這很悲哀，但卻也是事實，對不？",shape=box,color=blue];
		2541 -> 2552;
		2541 -> 2553;
	2542 [label="Update boolean MarieFamilyFail",color=orange];
		2542 -> 2554;
	2543 [label="他是召喚──甚或創造──了一位神的人！而現在他是唯一能阻止衪毀滅我們宇宙的人！",shape=box,color=blue];
		2543 -> 2555;
	2544 [label="你以為我不知道我不是他拋棄的唯一「女兒」嗎？！我只是唯一一個懂得寬恕的人！",shape=box,color=blue];
		2544 -> 2556;
		2544 -> 2557;
	2549 [label="你現在真的打算談這件事？！像這樣？！在這裡？！真的嗎？！",shape=box,color=blue];
		2549 -> 2560;
	2545 [label="是嗎？我會……原諒你這個謊言，但請你小心了。漂泊者，你更應該謹慎言行……",shape=box,color=blue];
		2545 -> 2558;
