	2577 [label="Update boolean MarieEntrati5f",color=orange];
		2577 -> 2584;
	2576 [label="我很清楚主教既是太陰又是太陽、光與暗、善與惡。他兩者都不是，又兩者都是，既能仁慈也能殘忍。",shape=box,color=blue];
