	2548 [label="Update boolean MarieWarning",color=orange];
		2548 -> 2482;
	2550 [label="嗯，當你這麼說的時候……",shape=box,color=red];
		2550 -> 2561;
	2551 [label="只是部分。我確實真心相信源拓氏。",shape=box,color=red];
		2551 -> 2561;
	2552 [label="沒錯。羅瑟為你感到無比驕傲。",shape=box,color=red];
		2552 -> 2562;
	2553 [label="有多少聖戰是以太陽之名發動的？再多一場又何妨，對吧？",shape=box,color=red];
		2553 -> 2563;
	2554 [label="Add -10 to Family",color=orange];
		2554 -> 2564;
	2555 [label="看來我是唯一記得這裡面臨什麼危機的人！",shape=box,color=blue];
		2555 -> 2565;
		2555 -> 2557;
	2556 [label="你現在在妄下定論了。你不知道是不是這樣。你又沒見過她，也不知道她經歷過什麼。或者她不得不忍受什麼。",shape=box,color=red];
		2556 -> 2566;
	2557 [label="你認為如果你這麼做會讓他更愛你嗎？你認為如果你是唯一對他忠誠的人會讓他回到你身邊嗎？",shape=box,color=red];
		2557 -> 2567;
	2560 [label="我──我做不到。我無法繼續。請原諒我。我們明天再談這件事，我必須整理思緒。",shape=box,color=blue];
		2560 -> 2569;
