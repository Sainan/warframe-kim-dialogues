	j1584752320 [label="老實說，我只希望我們能修好他。把真正的 Otak 帶回來。",shape=box,color=red];
		j1584752320 -> j3876331526;
	j3833261006 [label="他有辦法逗我笑。他很有趣，但這背後卻掩飾著一些悲慘和破碎的東西。",shape=box,color=red];
		j3833261006 -> j1440113209;
	j3371499497 [label="可惜的是，他無法被修復。而且我覺得他讓人很頭疼。",shape=box,color=red];
		j3371499497 -> j3795686867;
	j3605604664 [label="你說得對。我希望我們能做點什麼。",shape=box,color=red];
