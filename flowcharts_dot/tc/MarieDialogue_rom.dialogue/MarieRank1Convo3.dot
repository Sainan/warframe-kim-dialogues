digraph {
	"MarieRank1Convo3 begins." [color=orange];
		"MarieRank1Convo3 begins." -> j4034769489;
	j4034769489 [label="有個會飛的骷髏頭！那到底是什麼東西？！有個會說話會飛的骷髏頭，而大家都好像什麼事都沒發生一樣地繼續生活著，我需要有人來承認他們整個存在的怪異之處。",shape=box,color=blue];
		j4034769489 -> j3776389222;
		j4034769489 -> j4180652906;
		j4034769489 -> j1350559949;
	j3776389222 [label="那只是亡骸精靈。好吧，一個亡骸精靈。這有點複雜。",shape=box,color=red];
		j3776389222 -> j2049361529;
	j4180652906 [label="那是亡骸精靈。他是中樞，他不會傷害你。",shape=box,color=red];
		j4180652906 -> j600854912;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j2049361529 [label="請問，這是個名字還是個物體？",shape=box,color=blue];
		j2049361529 -> j1895672322;
		j2049361529 -> j823711336;
	j600854912 [label="我不認為他是個威脅！他沒有讓我感到害怕。",shape=box,color=blue];
		j600854912 -> j746566009;
	"Chat ends." [color=orange];
	j1895672322 [label="我......不太清楚。",shape=box,color=red];
		j1895672322 -> j3343506959;
	j823711336 [label="是的。",shape=box,color=red];
		j823711336 -> j4216110368;
	j746566009 [label="確實，我覺得他魅力十足，雖然在談話中略顯固執。這方面與他的活體原型差異不大。但考慮到我最喜歡的旅伴的個性，你可以察覺這對我並不會造成太大困擾。",shape=box,color=blue];
		j746566009 -> j3803607233;
	j3343506959 [label="首先，這些「亡骸精靈」是誰的設計？亡骸精靈既是個名字，又或許是個稱號？",shape=box,color=blue];
		j3343506959 -> j4220025960;
		j3343506959 -> j1650068866;
	j4216110368 [label="我……不太了解。而 Loid 又和這有什麼關係？",shape=box,color=blue];
		j4216110368 -> j3343506959;
	j3803607233 [label="不，我向你保證，你可能覺得他的面目很古怪，但這並不是我目前所關心的問題。",shape=box,color=blue];
		j3803607233 -> j531329424;
		j3803607233 -> j1049501930;
	j4220025960 [label="你的日曜主教──原拓氏。",shape=box,color=red];
		j4220025960 -> j3256720735;
	j1650068866 [label="原拓氏製造了那個。但 Orokin 發明了中樞這個概念。",shape=box,color=red];
		j1650068866 -> j3256720735;
	j531329424 [label="我感到驚訝那個骷髏頭沒有讓你反感。",shape=box,color=red];
		j531329424 -> j2504086240;
	j1049501930 [label="我承認，不夠了解他的話，一定會覺得他很怪。但具體是什麼困擾你？",shape=box,color=red];
		j1049501930 -> j3056541081;
	j3256720735 [label="不好意思，你的意思是說主教按照自己夥伴的樣貌而製造了一個會飛的骷髏頭僕人複製品，並如此命名他們嗎？",shape=box,color=blue];
		j3256720735 -> j4169381246;
	j2504086240 [label="你不是很了解我，而這不是你的錯。我一生大部分時間都在照料逝者及他們的安息之地。",shape=box,color=blue];
		j2504086240 -> j301790406;
	j3056541081 [label="我很好奇為什麼他的後腦勺還有另一張臉，看似孩子的塗鴉。",shape=box,color=blue];
		j3056541081 -> j1395989117;
	j4169381246 [label="那麼，為什麼這些亡骸精靈為數不多呢？",shape=box,color=blue];
		j4169381246 -> j1696222384;
		j4169381246 -> j1044735380;
		j4169381246 -> j2364195874;
	j301790406 [label="確實，我一生大部分時間都與他們相伴。他們很樂意傾聽我一天的煩惱。",shape=box,color=blue];
		j301790406 -> j4063127048;
	j1395989117 [label="我詢問過亡骸精靈先生和 Loid 先生，但他們都不願談論此事，只告訴了我一個名字──Otak。而他們說出這個名字時，帶著極大悲傷。",shape=box,color=blue];
		j1395989117 -> j541439798;
	j1696222384 [label="也許他意識到把自己的愛人做成數位副本是件多麼可怕的事。",shape=box,color=red];
		j1696222384 -> j1789479869;
	j1044735380 [label="也許他本來打算就只製作這一個。",shape=box,color=red];
		j1044735380 -> j3216780632;
	j2364195874 [label="我不確定。也許他一直沒空製作更多？",shape=box,color=red];
		j2364195874 -> j2393187183;
	j4063127048 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j4063127048 -> j2411937851;
		j4063127048 -> j1747418055;
	j541439798 [label="所以我來找你說話，希望你能協助我。",shape=box,color=blue];
		j541439798 -> j2560199229;
		j541439798 -> j3393882401;
	j1789479869 [label="又或者，出於對他的愛與尊重，他認為沒有 Loid 先生的話，這間古怪的實驗室將無法繼續運作。",shape=box,color=blue];
		j1789479869 -> j3528768512;
		j1789479869 -> j1462003428;
	j3216780632 [label="+5 Chemistry",color=orange];
		j3216780632 -> j3471691690;
	j2393187183 [label="想像一下，一群會飛的骷髏頭，全都毫不費勁且效率極高！",shape=box,color=blue];
		j2393187183 -> j1462003428;
		j2393187183 -> j4092249415;
	j2411937851 [label="你喜歡照看墓地嗎？",shape=box,color=red];
		j2411937851 -> j3305875575;
	j1747418055 [label="他們有回應過嗎？",shape=box,color=red];
		j1747418055 -> j3069699917;
	j2560199229 [label="你想知道 Otak 的事嗎？還是想知道為什麼你無法和他對話？",shape=box,color=red];
		j2560199229 -> j646845768;
	j3393882401 [label="Otak 的事一言難盡……",shape=box,color=red];
		j3393882401 -> j3287217001;
	j3528768512 [label="我會說這是一種奇怪的方式來表現愛意，但我也不好說什麼。",shape=box,color=red];
		j3528768512 -> j3616352594;
	j1462003428 [label="老實說，我不介意有個亡骸精靈在我家飛來飛去。",shape=box,color=red];
		j1462003428 -> j3383541259;
	j3471691690 [label="在某種程度上，這既悲劇又美麗，對不？出於對他的愛與尊重，他認為沒有 Loid 先生的話，這間古怪的實驗室將無法繼續運作。",shape=box,color=blue];
		j3471691690 -> j1184708140;
		j3471691690 -> j3528768512;
	j4092249415 [label="老實說，我很慶幸只有他一個。我不認為世界已經準備好接受更多。",shape=box,color=red];
		j4092249415 -> j977235319;
	j3305875575 [label="哦，是的，還有陵墓和墓穴喔。但我得承認我確實更喜歡戶外空間，儘管對我的椅子來說有點難以通行。我想不會比樓梯還不方便吧。",shape=box,color=blue];
		j3305875575 -> j2427967412;
	j3069699917 [label="哈！不，還好沒有。直到你那個面目陰森的「亡骸精靈」回應我之前都沒有。如果與逝者對話是聖光會賜予的其中一項天賦，那我就不清楚了。",shape=box,color=blue];
		j3069699917 -> j150993297;
	j646845768 [label="我相信隨著時間這兩者我都想知道，但由你來決定從哪個開始。畢竟，我不知道哪個更重要。",shape=box,color=blue];
		j646845768 -> j3287217001;
	j3287217001 [label="Check boolean LoidFamilyComplete",color=orange];
		j3287217001 -> j21505132 [label=true,color=green];
		j3287217001 -> j21505132 [label=false,color=brown];
		j3287217001 -> j544569733 [label=false,color=brown];
	j3616352594 [label="現在反而讓我好奇了，但那似乎是下次的故事了。話雖如此……",shape=box,color=blue];
		j3616352594 -> j3056541081;
	j3383541259 [label="那麼我非常確定你很有可能需要陪伴或條理，或兩者皆是。但那又是另一個話題了。",shape=box,color=blue];
		j3383541259 -> j3056541081;
	j1184708140 [label="我認為這更多是為了確保這個地方不會四分五裂，而不是其他原因。",shape=box,color=red];
		j1184708140 -> j4010032535;
	j977235319 [label="確實！我也是這麼認為。這讓我想到下一個問題。",shape=box,color=blue];
		j977235319 -> j3056541081;
	j2427967412 [label="Boolean MarieSerum1 is now true.",color=orange];
		j2427967412 -> j944122211;
		j2427967412 -> j109141207;
	j150993297 [label="不，能夠聽到靈魂和聲音更是我親愛的里昂的範疇而非我。不過從亡骸精靈先生後腦勺上的孩子塗鴉來判斷，我不禁好奇他是否也被鬼魂纏身了。",shape=box,color=blue];
		j150993297 -> j1628755248;
	j21505132 [label="Otak 曾經是名哲士、Orokin 科學家，也是學者。發生在他身上的事算不上什麼愉快的故事。",shape=box,color=red];
		j21505132 -> j2670271808;
	j544569733 [label="嗯……簡而言之，原拓氏的部分家人在樓上，他們並不……清楚我們在這裡。",shape=box,color=red];
		j544569733 -> j1036336320;
	j4010032535 [label="而你很有可能是對的。這個會飛的並合體似乎缺少了真正的 Loid 先生的大部分存在理由和微妙之處。話雖如此……",shape=box,color=blue];
		j4010032535 -> j3056541081;
	j944122211 [label="我不知道這樣問是否恰當，你的雙腳是否因血清而改變……",shape=box,color=red];
		j944122211 -> j3932861963;
	j109141207 [label="你的椅子？",shape=box,color=red];
		j109141207 -> j329804449;
	j1628755248 [label="其實這就是我來這裡找你說話的原因，如果你不介意的話。",shape=box,color=blue];
		j1628755248 -> j1395989117;
	j2670271808 [label="Boolean MarieOtak1 is now true.",color=orange];
		j2670271808 -> j927294369;
	j1036336320 [label="Boolean MarieFamily1 is now true.",color=orange];
		j1036336320 -> j467045264;
	j3932861963 [label="+10 Chemistry",color=orange];
		j3932861963 -> j3137547341;
	j329804449 [label="我不知道你會怎麼叫它？輪椅，又……或是一個我非常不喜歡的名詞──殘障人士扶手椅。",shape=box,color=blue];
		j329804449 -> j2958311319;
	j927294369 [label="以聖光會之名……請繼續。",shape=box,color=blue];
		j927294369 -> j382087328;
	j467045264 [label="以聖光會之名……你是說我們在這裡的存在是個秘密？！難道這就是為什麼我們不被允許離開這個地方嗎？！但是為什麼呢？！",shape=box,color=blue];
		j467045264 -> j3196286390;
	j3137547341 [label="哦！哦，你這可憐東西。想像一下你坐在那裡，在想我的雙腳是不是被日曜主教奪走了！不──完全不是這麼一回事。",shape=box,color=blue];
		j3137547341 -> j657893843;
	j2958311319 [label="就像我們現在坐在上面進行交流的這些可愛的小裝置。但兩側有輪子，方便移動。你可以說是一把有輪子的椅子。",shape=box,color=blue];
		j2958311319 -> j2066945356;
		j2958311319 -> j787097504;
	j382087328 [label="據傳他是個天才，也是開發利用氬結晶體的幕後主腦。",shape=box,color=red];
		j382087328 -> j207166478;
	j3196286390 [label="他的女兒，被稱為母親的尤拉瑞亞，還有她的家人，一直以來都在照看著火衛二。",shape=box,color=red];
		j3196286390 -> j3785579062;
	j657893843 [label="太陽認為很妥當，在我的人生中安排了這個不便，讓我生下來就無法正常控制的雙腳，讓我無法行走。",shape=box,color=blue];
		j657893843 -> j3077383767;
	j2066945356 [label="你在成為原型 warframe 之前是個殘障人士嗎？",shape=box,color=red];
		j2066945356 -> j1198079998;
	j787097504 [label="不管你信不信，我們叫它輪椅。",shape=box,color=red];
		j787097504 -> j1497672988;
	j207166478 [label="這些結晶獲取自虛空──它們是我們能夠製造許多強大 warframe 和武器的原因。",shape=box,color=red];
		j207166478 -> j1688149201;
	j3785579062 [label="自從原拓氏離開後就一直看守著這個地方，還有將虛空能量泵入始源星系的那顆心臟，讓我們所有人……實際上都得以保持可用。",shape=box,color=red];
		j3785579062 -> j3032412102;
	j3077383767 [label="但這只是一種不便而已。",shape=box,color=blue];
		j3077383767 -> j1516582187;
	j1198079998 [label="不。我根本不是。",shape=box,color=blue];
		j1198079998 -> j3350176257;
	j1497672988 [label="哈！哦，我坐在這裡笑自己蠢。是的，我想你會叫它輪椅，因為它是有輪子的椅子。我真笨。",shape=box,color=blue];
		j1497672988 -> j1516582187;
	j1688149201 [label="他專攻晶體學。而他的作品歸檔於這裡的實驗室。",shape=box,color=red];
		j1688149201 -> j3722680733;
	j3032412102 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3032412102 -> j2781793484 [label=true,color=green];
		j3032412102 -> j2362593335 [label=false,color=brown];
	j1516582187 [label="不過，我並不懷念不得不推著自己到處走的日子。我想里昂應該也一樣。飛翔是多麼自由啊！",shape=box,color=blue];
		j1516582187 -> j1878370264;
		j1516582187 -> j1392728138;
		j1516582187 -> j1371517152;
	j3350176257 [label="Boolean MarieInvalid is now true.",color=orange];
		j3350176257 -> "Chat ends.";
	j3722680733 [label="出於某種原因，我不知道為什麼，他被轉變成中樞，並獲得了自己的亡骸精靈外殼。",shape=box,color=red];
		j3722680733 -> j610323323;
	j2781793484 [label="她已經接受了他離去的事實，他們也已彼此和解，但這些都來之不易。",shape=box,color=red];
		j2781793484 -> j1369933560;
	j2362593335 [label="Check boolean MarieSyndicateMaxRank",color=orange];
		j2362593335 -> j2781793484 [label=true,color=green];
		j2362593335 -> j679177541 [label=false,color=brown];
	j1878370264 [label="我試著將殘疾視為改變我們的事物。它們在某些方面限制了我們，沒錯，但它們也能賦予我們他人所不具備的能力。",shape=box,color=red];
		j1878370264 -> j2257704044;
	j1392728138 [label="你從來沒有認為你的狀況是個問題嗎？",shape=box,color=red];
		j1392728138 -> j907042400;
	j1371517152 [label="你知道原型 warframe 的血清會對你造成這樣的影響嗎？",shape=box,color=red];
		j1371517152 -> j3161646469;
	j610323323 [label="並非所有中樞都是作為懲罰而製造的。但火衛二上的事……變得很糟，他受到了嚴重的損壞。",shape=box,color=red];
		j610323323 -> j2883722284;
	j1369933560 [label="知道他還在外面肆無忌憚，也再沒有和她說過一句話，甚至都沒有寄過一封信……",shape=box,color=red];
		j1369933560 -> j2483942553;
	j679177541 [label="她還沒有接受他離去的事實，他們彼此針鋒相對。",shape=box,color=red];
		j679177541 -> j1754938433;
	j2257704044 [label="+5 Chemistry",color=orange];
		j2257704044 -> j587705447;
	j907042400 [label="我從來不覺得哀嘆這件事會有什麼意義。我當然很享受能夠不需要幫助就能從高架子上拿東西的能力，這我可以告訴你。",shape=box,color=blue];
		j907042400 -> j2294581934;
	j3161646469 [label="是的，主教告訴了里昂和我，服用改變我們形態的血清會帶來什麼效果。我們知道它會有什麼效果。",shape=box,color=blue];
		j3161646469 -> j3851887089;
	j2883722284 [label="+5 Chemistry",color=orange];
		j2883722284 -> j1647684550;
	j2483942553 [label="我無法想像這對她，或對他們來說會有多痛苦。",shape=box,color=red];
		j2483942553 -> j2971603756;
	j1754938433 [label="知道他還在外面肆無忌憚，也再沒有和她說過一句話，甚至都沒有寄過一封信……",shape=box,color=red];
		j1754938433 -> j996946607;
	j587705447 [label="Boolean MarieSecretPower is now true.",color=orange];
		j587705447 -> j1768534947;
	j2294581934 [label="既然已成事實，那就只能這樣了。當我身邊那麼多人承受著更大的痛苦，有那麼多人更需要幫助時。我無法向太陽祈求奇蹟。聖光會已經給我太多了。",shape=box,color=blue];
		j2294581934 -> j3464177266;
	j3851887089 [label="然而就像所有事情一樣，我欣然接受了我的，而里昂也接受了他的……哦，我擔心我好像在打他的小報告，我不應該這樣做。",shape=box,color=blue];
		j3851887089 -> j3174508640;
		j3851887089 -> j3521440609;
	j1647684550 [label="（法語）可憐東西……",shape=box,color=blue];
		j1647684550 -> j2973794550;
	j2971603756 [label="雖然我能夠理解為了保護他們免受主教因迫不得已的離別而造成的痛苦，這個決定背後的道理……",shape=box,color=blue];
		j2971603756 -> j1972751371;
	j996946607 [label="這將摧毀他們之間或許還存在的一絲和解的機會。",shape=box,color=red];
		j996946607 -> j3027960518;
	j1768534947 [label="是的！你明白了。我從另一個角度認識世界。我的手臂更強壯。我更有耐心。我知道享受當下的意義。",shape=box,color=blue];
		j1768534947 -> j2868892236;
	j3464177266 [label="我必須走了。謝謝你這次美好的消遣。",shape=box,color=blue];
		j3464177266 -> "Chat ends.";
	j3174508640 [label="沒關係。不用告訴我任何你不願意分享的事情。",shape=box,color=red];
		j3174508640 -> j371747613;
	j3521440609 [label="請繼續。我很難與他溝通。",shape=box,color=red];
		j3521440609 -> j2347518809;
	j2973794550 [label="於是，他被轉移到主要的亡骸精靈──唯一剩下的亡骸精靈──並且……該怎麼說呢？這很難解釋。",shape=box,color=red];
		j2973794550 -> j1584752320;
		j2973794550 -> j3833261006;
		j2973794550 -> j3371499497;
	j1972751371 [label="我確實認為不必這麼殘忍，你不覺得嗎？他們可能以為他已經死了。或者更糟！而我們，住在這裡，卻像下水道的老鼠？",shape=box,color=blue];
		j1972751371 -> j3605604664;
		j1972751371 -> j70884999;
		j1972751371 -> j568502847;
	j3027960518 [label="+10 Chemistry",color=orange];
		j3027960518 -> j3500096572;
	j2868892236 [label="當我抵達目的地時，我會沉浸在它的優雅之中。我不會像一隻長著無數小腿的甲蟲那樣匆忙亂竄。",shape=box,color=blue];
