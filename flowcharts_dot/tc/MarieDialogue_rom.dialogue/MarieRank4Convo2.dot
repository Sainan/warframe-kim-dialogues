		j4079773120 -> j700719495;
		j4079773120 -> j2392018251;
		j4079773120 -> j3236095288;
	j2357317983 [label="你告訴過我你有信仰，雖然和我的不同，但同樣都是信仰。那你又為什麼信奉？",shape=box,color=blue];
		j2357317983 -> j3121287659;
		j2357317983 -> j3995583064;
		j2357317983 -> j700719495;
		j2357317983 -> j2392018251;
		j2357317983 -> j3236095288;
	j3906674745 [label="我知道你說過你的信仰對你來說很私人，就像你自己編造的故事，但它同樣都是信仰。那你又為什麼信奉？",shape=box,color=blue];
		j3906674745 -> j3121287659;
		j3906674745 -> j3995583064;
		j3906674745 -> j700719495;
		j3906674745 -> j2392018251;
		j3906674745 -> j3236095288;
	j1217078127 [label="那你又為什麼？",shape=box,color=blue];
		j1217078127 -> j3121287659;
		j1217078127 -> j3995583064;
		j1217078127 -> j700719495;
		j1217078127 -> j2392018251;
		j1217078127 -> j3236095288;
	j3705798781 [label="關於太陰，我也可以問你同樣的問題，對不？那你又為什麼信奉？",shape=box,color=blue];
		j3705798781 -> j3121287659;
		j3705798781 -> j700719495;
		j3705798781 -> j2392018251;
		j3705798781 -> j3236095288;
		j3705798781 -> j3995583064;
	j2668057462 [label="為什麼特別是太陽？而不是太陰或者你所堅持的平衡？這是個很好的問題。你為什麼信奉？",shape=box,color=blue];
		j2668057462 -> j3121287659;
		j2668057462 -> j3995583064;
		j2668057462 -> j700719495;
		j2668057462 -> j2392018251;
		j2668057462 -> j3236095288;
	j1394563428 [label="你想知道是什麼讓我這麼確信？而你卻說我們無法知曉宇宙？",shape=box,color=blue];
		j1394563428 -> j3884734110;
	j1936242323 [label="是的，我能理解為什麼沒有信仰的人可能會覺得這很奇怪。",shape=box,color=blue];
		j1936242323 -> j926871607;
	j2946836681 [label="你想知道是什麼讓我這麼確信？",shape=box,color=blue];
		j2946836681 -> j3884734110;
	j3953269951 [label="你知道這意味著什麼嗎？！",shape=box,color=blue];
		j3953269951 -> j665120586;
		j3953269951 -> j1725213007;
	j313194450 [label="是的！我不喜歡切花。如果你想送我禮物，我祈禱那不會是花瓶裡的玫瑰。",shape=box,color=blue];
		j313194450 -> j4206639739;
		j313194450 -> j2102548667;
	j884317512 [label="（法語）對你嗎？當然可以。",shape=box,color=blue];
		j884317512 -> j2740711818;
		j884317512 -> j1350559949;
	j3121287659 [label="我……我想我只是覺得有義務這麼做。",shape=box,color=red];
		j3121287659 -> j3222404579;
	j3995583064 [label="我之前回你那個答案時，其實沒有說實話。",shape=box,color=red];
		j3995583064 -> j78617650;
	j700719495 [label="我經歷過一件事。它改變了我的人生。",shape=box,color=red];
		j700719495 -> j1436360331;
	j2392018251 [label="沒有發生什麼事，這只是我一直有的感覺。它指引著我。",shape=box,color=red];
		j2392018251 -> j3791064314;
	j3236095288 [label="我想信。於是，我就信了。",shape=box,color=red];
		j3236095288 -> j3080931226;
	j3884734110 [label="漂泊狼，我怕我的答案可能會讓你失望。沒有什麼偉大的奇蹟。也沒有從天空照射在我身上的光芒。",shape=box,color=blue];
		j3884734110 -> j1732528025;
	j926871607 [label="「為什麼這個理智的年輕女子會相信我認為不真實的東西，這看起來很傻」，對不？",shape=box,color=blue];
		j926871607 -> j3313281920;
		j926871607 -> j2346448625;
	j665120586 [label="不知道。",shape=box,color=red];
		j665120586 -> j2361873247;
	j1725213007 [label="我該擔心嗎？",shape=box,color=red];
		j1725213007 -> j930205197;
	j4206639739 [label="你怎麼猜到我要問的就是這個？太神奇了。",shape=box,color=red];
		j4206639739 -> j3005196824;
	j2102548667 [label="那……不是我要問的，但我會記住的，謝謝！",shape=box,color=red];
		j2102548667 -> j2233361358;
	j2740711818 [label="你為什麼信奉太陽？",shape=box,color=red];
		j2740711818 -> j2563733639;
	j3222404579 [label="Check boolean DrifterFaithNoPeace",color=orange];
		j3222404579 -> j2797541954 [label=true,color=green];
		j3222404579 -> j788498394 [label=false,color=brown];
	j78617650 [label="是嗎？我很好奇，你為什麼要說謊？",shape=box,color=blue];
		j78617650 -> j534084332;
		j78617650 -> j414761943;
	j1436360331 [label="那我嫉妒了！大多數人都沒有這麼幸運，能指出一個如此堅實的事件，對吧？",shape=box,color=blue];
		j1436360331 -> j216955423;
	j3791064314 [label="啊，那我們的答案是一樣的。我從未見證過奇蹟，除了或許主教來到大教堂的那次。",shape=box,color=blue];
		j3791064314 -> j1689226150;
	j3080931226 [label="Check boolean DrifterFaithNoPeace",color=orange];
		j3080931226 -> j1469867020 [label=true,color=green];
		j3080931226 -> j390330743 [label=false,color=brown];
	j1732528025 [label="都沒有，我一直都只是覺得生命中有個存在一直在那裡指引我。一個在我走到十字路口時微笑並指路的恩人，僅此而已。",shape=box,color=blue];
		j1732528025 -> j1503452839;
		j1732528025 -> j2869031567;
	j3313281920 [label="老實說？是的，有點。只是我不會那樣說而已。",shape=box,color=red];
		j3313281920 -> j586986515;
	j2346448625 [label="我只是更想知道是不是有個事件，或者……某個時刻導致的。",shape=box,color=red];
		j2346448625 -> j3884734110;
	j2361873247 [label="我也不知道！但現在可能性無窮無盡了！",shape=box,color=blue];
		j2361873247 -> j1607430007;
	j930205197 [label="或許吧！因為現在出現無限種可能了！",shape=box,color=blue];
		j930205197 -> j1607430007;
	j3005196824 [label="因為那個惡魔告訴我你要問這個。",shape=box,color=blue];
		j3005196824 -> j3963249141;
	j2233361358 [label="哦！哦，原諒我！對不起。你想問什麼？現在我羞愧死了……",shape=box,color=blue];
		j2233361358 -> j2740711818;
		j2233361358 -> j1350559949;
	j2797541954 [label="而你說它並沒有給你帶來多少平靜……這讓我心碎。",shape=box,color=blue];
		j2797541954 -> j788498394;
	j788498394 [label="我不會告訴你該做什麼。我也不會告訴你該走哪條道路。",shape=box,color=blue];
		j788498394 -> j2611062789;
	j534084332 [label="坦白說，我不確定。那是一時衝動。",shape=box,color=red];
		j534084332 -> j3678860442;
	j414761943 [label="我以為這也許是更了解你的一種方式……",shape=box,color=red];
		j414761943 -> j719270207;
	j216955423 [label="但你的問題是關於我為什麼信奉，而我卻很失禮地把話題反過來問你了，我道歉。",shape=box,color=blue];
		j216955423 -> j3884734110;
	j1689226150 [label="即便如此，那也是人類的行為和科學的產物，不是聖光者的所作所為，對不？這個給了我漂浮天賦的血清──",shape=box,color=blue];
		j1689226150 -> j269755090;
	j1469867020 [label="但你說它並沒有給你帶來多少平靜，是嗎？這讓我心碎……",shape=box,color=blue];
		j1469867020 -> j2511955454;
	j390330743 [label="我覺得你的信仰也許是所有人中最堅強的，對不？",shape=box,color=blue];
		j390330743 -> j734160588;
	j1503452839 [label="你不會稱源拓氏的血清為奇蹟嗎？",shape=box,color=red];
		j1503452839 -> j1689226150;
	j2869031567 [label="連里昂的聲音都不算嗎？或漠然呢？",shape=box,color=red];
		j2869031567 -> j3517745382;
	j586986515 [label="哦，覺得相信聖光者的我很傻，這已經是你對異教者能有的最禮貌的看法了。",shape=box,color=blue];
		j586986515 -> j2982138750;
	j1607430007 [label="惡魔要非常害怕！邪祟，當心了！聖光將從天而降懲治你！",shape=box,color=blue];
		j1607430007 -> j2398981472;
	j3963249141 [label="不、不、不……你不是要問我那個吧？啊！我要逼他吞下其中一本書！",shape=box,color=blue];
		j3963249141 -> j3138183519;
	j2611062789 [label="因為在你身處的這場虛空風暴中，我只是個簡陋的避難所。",shape=box,color=blue];
		j2611062789 -> j2344874155;
	j3678860442 [label="我不知道是什麼本能驅使你告訴我這些事。但我很高興你現在說出了真相。",shape=box,color=blue];
		j3678860442 -> j55993945;
	j719270207 [label="哦……你不需要對我說這些謊話才能更了解我。",shape=box,color=blue];
		j719270207 -> j55993945;
	j269755090 [label="那是一個人的產物。但我相信是太陽指引我們的道路匯聚為一。",shape=box,color=blue];
		j269755090 -> j1479262253;
	j2511955454 [label="在我聽來，你就像在森林中徘徊，拼命尋找一條你希望存在的小徑。",shape=box,color=blue];
		j2511955454 -> j2881059323;
	j734160588 [label="只靠心中的希望在森林小徑上前行，讓它為你指引方向。",shape=box,color=blue];
		j734160588 -> j3210987095;
	j3517745382 [label="有可能是，我不知道。或許惡魔是對的，這一切都是我們尚未理解的科學產物。兩者並不互斥，對不？",shape=box,color=blue];
		j3517745382 -> j1479262253;
	j2982138750 [label="這一點都不冒犯我，我一直都很感激你的誠實。",shape=box,color=blue];
		j2982138750 -> j3884734110;
	j2398981472 [label="+20 Chemistry",color=orange];
		j2398981472 -> j745501734;
	j3138183519 [label="你想問什麼？現在我羞愧死了……",shape=box,color=blue];
		j3138183519 -> j2740711818;
		j3138183519 -> j1350559949;
	j2344874155 [label="但我想知道你是否發現自己正站在十字路口，也許你會想思考該往哪個方向行走，對不？",shape=box,color=blue];
		j2344874155 -> j3834252741;
	j55993945 [label="一個靈魂不只是他們信奉的信仰。我是太陽修女，但我希望你看到的不只是這點，對不？",shape=box,color=blue];
		j55993945 -> j500121772;
	j1479262253 [label="這就是我信奉的原因。當我抵達最不確定的時刻時，我感覺太陽與我同在。我閉上眼睛，他就在那裡，指引我。",shape=box,color=blue];
		j1479262253 -> j3682787866;
		j1479262253 -> j3138462521;
		j1479262253 -> j1360189767;
	j2881059323 [label="我不知道你是否會找到它，但我祈禱你會。因為你將發現的會是一個奇蹟。",shape=box,color=blue];
		j2881059323 -> j216955423;
	j3210987095 [label="真美……",shape=box,color=blue];
		j3210987095 -> j216955423;
	j745501734 [label="聖母白日，祢今天賜福於祢的女兒了！哈哈！！",shape=box,color=blue];
		j745501734 -> "Chat ends.";
	j3834252741 [label="義務不是信奉的理由。它最好的情況只會滋生懷疑，最壞的情況則會產生虛無的鄙夷。",shape=box,color=blue];
		j3834252741 -> j2965929202;
	j500121772 [label="我們可以選擇談論的話題多如天上繁星！",shape=box,color=blue];
		j500121772 -> j2649800619;
		j500121772 -> j568137738;
	j3682787866 [label="太美妙了。",shape=box,color=red];
		j3682787866 -> j3902554023;
	j3138462521 [label="他有沒有未能給你指引的時候？",shape=box,color=red];
		j3138462521 -> j2041141801;
	j1360189767 [label="我希望我也有那種指引……",shape=box,color=red];
		j1360189767 -> j2231374972;
	j2965929202 [label="信仰應當是撫慰心靈的良藥。不是拐杖，也不是藉口。",shape=box,color=blue];
		j2965929202 -> j818002267;
	j2649800619 [label="那你會原諒我嗎？",shape=box,color=red];
		j2649800619 -> j3692609495;
	j568137738 [label="對不起。這是個愚蠢的行為。",shape=box,color=red];
		j568137738 -> j759220008;
	j3902554023 [label="是的，我知道自己很幸運。而且這是一種很容易就想強加給他人的平靜，無論他們是否願意接受。",shape=box,color=blue];
		j3902554023 -> j1188620543;
	j2041141801 [label="有的，很多次。在那些時刻，我會反思原因。或許我本來就該自己找出路，對不？又或者我終究只是個瘋子，哈！我們並不一定總是都會知道答案。",shape=box,color=blue];
		j2041141801 -> j1188620543;
	j2231374972 [label="是的，我祈禱你有一天能擁有它。但這不是能被給予或教導的東西，而是必須被找到的。",shape=box,color=blue];
		j2231374972 -> j1421778749;
	j818002267 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j818002267 -> j216955423;
	j3692609495 [label="是的，我原諒你。如果你像里昂那樣，我會告訴你，十鞭就是你該付的代價。",shape=box,color=blue];
		j3692609495 -> j936506166;
	j759220008 [label="是的，如果你像里昂那樣，我會告訴你，十鞭就是你該付的代價！但你不是。而且你已被寬恕。",shape=box,color=blue];
		j759220008 -> j936506166;
	j1188620543 [label="但只要我的信仰不傷害任何人，我認為持有這些信仰並無害處，對吧？",shape=box,color=blue];
		j1188620543 -> j2257964763;
