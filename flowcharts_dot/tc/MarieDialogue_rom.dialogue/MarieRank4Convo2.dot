	j4213562297 [label="+5 Chemistry",color=orange];
		j4213562297 -> j884317512;
	j4079773120 [label="你告訴過我你信奉與我相似的信仰，對不？那你又為什麼信奉？",shape=box,color=blue];
		j4079773120 -> j3121287659;
