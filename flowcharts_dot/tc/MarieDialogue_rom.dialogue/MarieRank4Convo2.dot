	2144 [label="+5 Chemistry",color=orange];
		2144 -> 2149;
	2152 [label="你告訴過我你信奉與我相似的信仰，對不？那你又為什麼信奉？",shape=box,color=blue];
		2152 -> 2162;
		2152 -> 2163;
		2152 -> 2164;
		2152 -> 2165;
		2152 -> 2166;
	2153 [label="你告訴過我你有信仰，雖然和我的不同，但同樣都是信仰。那你又為什麼信奉？",shape=box,color=blue];
		2153 -> 2162;
		2153 -> 2163;
		2153 -> 2164;
		2153 -> 2165;
		2153 -> 2166;
	2154 [label="我知道你說過你的信仰對你來說很私人，就像你自己編造的故事，但它同樣都是信仰。那你又為什麼信奉？",shape=box,color=blue];
		2154 -> 2162;
		2154 -> 2163;
		2154 -> 2164;
		2154 -> 2165;
		2154 -> 2166;
	2150 [label="那你又為什麼？",shape=box,color=blue];
		2150 -> 2162;
		2150 -> 2163;
		2150 -> 2164;
		2150 -> 2165;
		2150 -> 2166;
	2151 [label="關於太陰，我也可以問你同樣的問題，對不？那你又為什麼信奉？",shape=box,color=blue];
		2151 -> 2162;
		2151 -> 2164;
		2151 -> 2165;
		2151 -> 2166;
		2151 -> 2163;
	2155 [label="為什麼特別是太陽？而不是太陰或者你所堅持的平衡？這是個很好的問題。你為什麼信奉？",shape=box,color=blue];
		2155 -> 2162;
		2155 -> 2163;
		2155 -> 2164;
		2155 -> 2165;
		2155 -> 2166;
	2157 [label="你想知道是什麼讓我這麼確信？而你卻說我們無法知曉宇宙？",shape=box,color=blue];
		2157 -> 2168;
	2156 [label="是的，我能理解為什麼沒有信仰的人可能會覺得這很奇怪。",shape=box,color=blue];
		2156 -> 2167;
	2158 [label="你想知道是什麼讓我這麼確信？",shape=box,color=blue];
		2158 -> 2168;
	2159 [label="你知道這意味著什麼嗎？！",shape=box,color=blue];
		2159 -> 2169;
		2159 -> 2170;
	3954 [label="是的！我不喜歡切花。如果你想送我禮物，我祈禱那不會是花瓶裡的玫瑰。",shape=box,color=blue];
		3954 -> 3955;
		3954 -> 3956;
	2149 [label="（法語）對你嗎？當然可以。",shape=box,color=blue];
		2149 -> 2160;
		2149 -> 2161;
	2162 [label="我……我想我只是覺得有義務這麼做。",shape=box,color=red];
		2162 -> 2172;
	2163 [label="我之前回你那個答案時，其實沒有說實話。",shape=box,color=red];
		2163 -> 2173;
	2164 [label="我經歷過一件事。它改變了我的人生。",shape=box,color=red];
		2164 -> 2174;
	2165 [label="沒有發生什麼事，這只是我一直有的感覺。它指引著我。",shape=box,color=red];
		2165 -> 2175;
	2166 [label="我想信。於是，我就信了。",shape=box,color=red];
		2166 -> 2176;
	2168 [label="漂泊狼，我怕我的答案可能會讓你失望。沒有什麼偉大的奇蹟。也沒有從天空照射在我身上的光芒。",shape=box,color=blue];
		2168 -> 2179;
	2167 [label="「為什麼這個理智的年輕女子會相信我認為不真實的東西，這看起來很傻」，對不？",shape=box,color=blue];
		2167 -> 2177;
		2167 -> 2178;
	2169 [label="不知道。",shape=box,color=red];
		2169 -> 2180;
	2170 [label="我該擔心嗎？",shape=box,color=red];
		2170 -> 2181;
	3955 [label="你怎麼猜到我要問的就是這個？太神奇了。",shape=box,color=red];
		3955 -> 3957;
	3956 [label="那……不是我要問的，但我會記住的，謝謝！",shape=box,color=red];
