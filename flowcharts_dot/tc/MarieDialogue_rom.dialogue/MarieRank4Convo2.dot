	2172 [label="Check boolean DrifterFaithNoPeace",color=orange];
		2172 -> 2182 [label=true,color=green];
		2172 -> 2183 [label=false,color=brown];
	2173 [label="是嗎？我很好奇，你為什麼要說謊？",shape=box,color=blue];
		2173 -> 2184;
		2173 -> 2185;
	2174 [label="那我嫉妒了！大多數人都沒有這麼幸運，能指出一個如此堅實的事件，對吧？",shape=box,color=blue];
		2174 -> 2186;
	2175 [label="啊，那我們的答案是一樣的。我從未見證過奇蹟，除了或許主教來到大教堂的那次。",shape=box,color=blue];
		2175 -> 2187;
	2176 [label="Check boolean DrifterFaithNoPeace",color=orange];
		2176 -> 2188 [label=true,color=green];
		2176 -> 2189 [label=false,color=brown];
	2179 [label="都沒有，我一直都只是覺得生命中有個存在一直在那裡指引我。一個在我走到十字路口時微笑並指路的恩人，僅此而已。",shape=box,color=blue];
		2179 -> 2191;
		2179 -> 2192;
	2177 [label="老實說？是的，有點。只是我不會那樣說而已。",shape=box,color=red];
		2177 -> 2190;
	2178 [label="我只是更想知道是不是有個事件，或者……某個時刻導致的。",shape=box,color=red];
		2178 -> 2168;
	2180 [label="我也不知道！但現在可能性無窮無盡了！",shape=box,color=blue];
		2180 -> 2193;
	2181 [label="或許吧！因為現在出現無限種可能了！",shape=box,color=blue];
		2181 -> 2193;
	3957 [label="因為那個惡魔告訴我你要問這個。",shape=box,color=blue];
		3957 -> 3959;
	3958 [label="哦！哦，原諒我！對不起。你想問什麼？現在我羞愧死了……",shape=box,color=blue];
		3958 -> 2160;
		3958 -> 2161;
	2171 [label="Chat ends.",color=orange];
	2182 [label="而你說它並沒有給你帶來多少平靜……這讓我心碎。",shape=box,color=blue];
		2182 -> 2183;
	2183 [label="我不會告訴你該做什麼。我也不會告訴你該走哪條道路。",shape=box,color=blue];
		2183 -> 2194;
	2184 [label="坦白說，我不確定。那是一時衝動。",shape=box,color=red];
		2184 -> 2195;
	2185 [label="我以為這也許是更了解你的一種方式……",shape=box,color=red];
		2185 -> 2196;
	2186 [label="但你的問題是關於我為什麼信奉，而我卻很失禮地把話題反過來問你了，我道歉。",shape=box,color=blue];
		2186 -> 2168;
	2187 [label="即便如此，那也是人類的行為和科學的產物，不是聖光者的所作所為，對不？這個給了我漂浮天賦的血清──",shape=box,color=blue];
		2187 -> 2197;
	2188 [label="但你說它並沒有給你帶來多少平靜，是嗎？這讓我心碎……",shape=box,color=blue];
		2188 -> 2198;
	2189 [label="我覺得你的信仰也許是所有人中最堅強的，對不？",shape=box,color=blue];
		2189 -> 2199;
	2191 [label="你不會稱源拓氏的血清為奇蹟嗎？",shape=box,color=red];
		2191 -> 2187;
	2192 [label="連里昂的聲音都不算嗎？或漠然呢？",shape=box,color=red];
		2192 -> 2201;
	2190 [label="哦，覺得相信聖光者的我很傻，這已經是你對異教者能有的最禮貌的看法了。",shape=box,color=blue];
		2190 -> 2200;
	2193 [label="惡魔要非常害怕！邪祟，當心了！聖光將從天而降懲治你！",shape=box,color=blue];
		2193 -> 2202;
	3959 [label="不、不、不……你不是要問我那個吧？啊！我要逼他吞下其中一本書！",shape=box,color=blue];
		3959 -> 3960;
	2194 [label="因為在你身處的這場虛空風暴中，我只是個簡陋的避難所。",shape=box,color=blue];
		2194 -> 2203;
	2195 [label="我不知道是什麼本能驅使你告訴我這些事。但我很高興你現在說出了真相。",shape=box,color=blue];
		2195 -> 2204;
	2196 [label="哦……你不需要對我說這些謊話才能更了解我。",shape=box,color=blue];
		2196 -> 2204;
	2197 [label="那是一個人的產物。但我相信是太陽指引我們的道路匯聚為一。",shape=box,color=blue];
		2197 -> 2205;
	2198 [label="在我聽來，你就像在森林中徘徊，拼命尋找一條你希望存在的小徑。",shape=box,color=blue];
		2198 -> 2206;
	2199 [label="只靠心中的希望在森林小徑上前行，讓它為你指引方向。",shape=box,color=blue];
		2199 -> 2207;
	2201 [label="有可能是，我不知道。或許惡魔是對的，這一切都是我們尚未理解的科學產物。兩者並不互斥，對不？",shape=box,color=blue];
		2201 -> 2205;
	2200 [label="這一點都不冒犯我，我一直都很感激你的誠實。",shape=box,color=blue];
		2200 -> 2168;
	2202 [label="+20 Chemistry",color=orange];
		2202 -> 2208;
	3960 [label="你想問什麼？現在我羞愧死了……",shape=box,color=blue];
		3960 -> 2160;
		3960 -> 2161;
	2203 [label="但我想知道你是否發現自己正站在十字路口，也許你會想思考該往哪個方向行走，對不？",shape=box,color=blue];
		2203 -> 2209;
	2204 [label="一個靈魂不只是他們信奉的信仰。我是太陽修女，但我希望你看到的不只是這點，對不？",shape=box,color=blue];
		2204 -> 2210;
	2205 [label="這就是我信奉的原因。當我抵達最不確定的時刻時，我感覺太陽與我同在。我閉上眼睛，他就在那裡，指引我。",shape=box,color=blue];
		2205 -> 2211;
		2205 -> 2212;
		2205 -> 2213;
	2206 [label="我不知道你是否會找到它，但我祈禱你會。因為你將發現的會是一個奇蹟。",shape=box,color=blue];
		2206 -> 2186;
	2207 [label="真美……",shape=box,color=blue];
		2207 -> 2186;
	2208 [label="聖母白日，祢今天賜福於祢的女兒了！哈哈！！",shape=box,color=blue];
		2208 -> 2214;
	2209 [label="義務不是信奉的理由。它最好的情況只會滋生懷疑，最壞的情況則會產生虛無的鄙夷。",shape=box,color=blue];
		2209 -> 2215;
	2210 [label="我們可以選擇談論的話題多如天上繁星！",shape=box,color=blue];
		2210 -> 2216;
		2210 -> 2217;
	2211 [label="太美妙了。",shape=box,color=red];
		2211 -> 2218;
	2212 [label="他有沒有未能給你指引的時候？",shape=box,color=red];
		2212 -> 2219;
	2213 [label="我希望我也有那種指引……",shape=box,color=red];
		2213 -> 2220;
	2214 [label="Chat ends.",color=orange];
	2215 [label="信仰應當是撫慰心靈的良藥。不是拐杖，也不是藉口。",shape=box,color=blue];
		2215 -> 2221;
	2216 [label="那你會原諒我嗎？",shape=box,color=red];
		2216 -> 2222;
	2217 [label="對不起。這是個愚蠢的行為。",shape=box,color=red];
		2217 -> 2223;
	2218 [label="是的，我知道自己很幸運。而且這是一種很容易就想強加給他人的平靜，無論他們是否願意接受。",shape=box,color=blue];
		2218 -> 2224;
	2219 [label="有的，很多次。在那些時刻，我會反思原因。或許我本來就該自己找出路，對不？又或者我終究只是個瘋子，哈！我們並不一定總是都會知道答案。",shape=box,color=blue];
		2219 -> 2224;
	2220 [label="是的，我祈禱你有一天能擁有它。但這不是能被給予或教導的東西，而是必須被找到的。",shape=box,color=blue];
		2220 -> 2225;
	2221 [label="Update boolean DrifterCrossroads",color=orange];
		2221 -> 2186;
	2222 [label="是的，我原諒你。如果你像里昂那樣，我會告訴你，十鞭就是你該付的代價。",shape=box,color=blue];
		2222 -> 2226;
	2223 [label="是的，如果你像里昂那樣，我會告訴你，十鞭就是你該付的代價！但你不是。而且你已被寬恕。",shape=box,color=blue];
		2223 -> 2226;
	2224 [label="但只要我的信仰不傷害任何人，我認為持有這些信仰並無害處，對吧？",shape=box,color=blue];
		2224 -> 2227;
