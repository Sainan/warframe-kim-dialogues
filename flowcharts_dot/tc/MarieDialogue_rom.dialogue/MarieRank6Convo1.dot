	3304 [label="而我心想，那種影響他人的力量就是漠然想要摧毀和吞噬的嗎？",shape=box,color=blue];
		3304 -> 3321;
	3309 [label="你給我的靈魂弟兄帶來了如此的平靜。你說服了他我們有真正的敵人要對抗，並給予了他希望。",shape=box,color=blue];
		3309 -> 3329;
	3310 [label="你給我的靈魂弟兄帶來了他前所未有的慰藉和某種平靜。我想你的陪伴對他的意義他難以言表。",shape=box,color=blue];
		3310 -> 3329;
	3311 [label="雖然我們可能永遠不會知道漠然到底是什麼，但我們知道那不重要。我們必須面對它所帶來的挑戰，這是真實存在的。",shape=box,color=blue];
		3311 -> 3329;
	3312 [label="我原本不認為我們的惡魔能被說服去幫助 Loid 先生和主教家人重修舊好。我知道他的理由……或許有些可疑，而且我依然無法完全信任他。",shape=box,color=blue];
		3312 -> 3330;
	3313 [label="我原本不認為我們的惡魔能意識到他的錯誤。不認為他會對他所剝奪的無辜性命感到任何悔恨。你證明我錯了。",shape=box,color=blue];
		3313 -> 3331;
	3314 [label="無論你用什麼鎖鏈拴住我們的惡魔，它們都在束縛著他。他似乎比以前更……溫和了。而這要歸功於你。",shape=box,color=blue];
		3314 -> 3331;
	3315 [label="我們幫他找回的那些記憶似乎讓他變得溫和了。或許記起所有他失去的人的傷痛，提醒著他那些他仍可能會失去的人。",shape=box,color=blue];
		3315 -> 3331;
	3316 [label="或許是他對你的好感讓他變得溫和，我不知道。無論什麼原因，我知道這要歸功於你。",shape=box,color=blue];
		3316 -> 3331;
	3308 [label="我對你沒有任何惡意，而對你們倆只感到喜悅，好嗎？",shape=box,color=blue];
		3308 -> 3327;
		3308 -> 3328;
