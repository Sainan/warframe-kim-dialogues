	j3666990584 [label="而我心想，那種影響他人的力量就是漠然想要摧毀和吞噬的嗎？",shape=box,color=blue];
		j3666990584 -> j56744333;
	j2618163562 [label="你給我的靈魂弟兄帶來了如此的平靜。你說服了他我們有真正的敵人要對抗，並給予了他希望。",shape=box,color=blue];
		j2618163562 -> j966700197;
	j353897416 [label="你給我的靈魂弟兄帶來了他前所未有的慰藉和某種平靜。我想你的陪伴對他的意義他難以言表。",shape=box,color=blue];
		j353897416 -> j966700197;
	j3337694820 [label="雖然我們可能永遠不會知道漠然到底是什麼，但我們知道那不重要。我們必須面對它所帶來的挑戰，這是真實存在的。",shape=box,color=blue];
		j3337694820 -> j966700197;
	j3110163797 [label="我原本不認為我們的惡魔能被說服去幫助 Loid 先生和主教家人重修舊好。我知道他的理由……或許有些可疑，而且我依然無法完全信任他。",shape=box,color=blue];
		j3110163797 -> j2119387210;
	j346173042 [label="我原本不認為我們的惡魔能意識到他的錯誤。不認為他會對他所剝奪的無辜性命感到任何悔恨。你證明我錯了。",shape=box,color=blue];
		j346173042 -> j1612852331;
	j1874343042 [label="無論你用什麼鎖鏈拴住我們的惡魔，它們都在束縛著他。他似乎比以前更……溫和了。而這要歸功於你。",shape=box,color=blue];
		j1874343042 -> j1612852331;
	j4271212175 [label="我們幫他找回的那些記憶似乎讓他變得溫和了。或許記起所有他失去的人的傷痛，提醒著他那些他仍可能會失去的人。",shape=box,color=blue];
		j4271212175 -> j1612852331;
	j1425049570 [label="或許是他對你的好感讓他變得溫和，我不知道。無論什麼原因，我知道這要歸功於你。",shape=box,color=blue];
		j1425049570 -> j1612852331;
	j1330043756 [label="我對你沒有任何惡意，而對你們倆只感到喜悅，好嗎？",shape=box,color=blue];
		j1330043756 -> j2315808733;
		j1330043756 -> j2422856562;
	j2058195855 [label="情況發生變化，而且……我必須對他們保持忠誠，我很抱歉。",shape=box,color=red];
		j2058195855 -> j1049123814;
	j4072438908 [label="我知道，這可能難以置信，甚或難以接受。但我……愛你。而我也愛他們。我愛你們一樣多。",shape=box,color=red];
