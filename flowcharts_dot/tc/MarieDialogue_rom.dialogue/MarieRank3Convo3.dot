		j971302504 -> j1350559949 [label=false,color=brown];
	j4047149940 [label="你能跟我多說一點源拓氏到來之前，住在大教堂裡的生活是什麼樣子的嗎？",shape=box,color=red];
		j4047149940 -> j3986712317;
	j4289485463 [label="瑪麗，你在哪裡長大的？",shape=box,color=red];
		j4289485463 -> j3891595945;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j420019894 [label="源拓氏出現之前，你在大教堂的生活是什麼樣子的？",shape=box,color=red];
		j420019894 -> j3646957519;
	j3986712317 [label="我想，其實就是孤單吧。我有里昂陪著我，但你也知道他有時候是什麼樣子的。哦！我很高興你和他現在有在對話了！",shape=box,color=blue];
		j3986712317 -> j1771312959;
	j3891595945 [label="Boolean MarieBackstory1 is now true.",color=orange];
		j3891595945 -> j3928013634;
	"Chat ends." [color=orange];
	j3646957519 [label="哦，我不知道這會不會讓你覺得很無聊，但既然你這麼好奇，我還是告訴你吧。",shape=box,color=blue];
		j3646957519 -> j1145716975;
	j1771312959 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j1771312959 -> j876454817;
	j3928013634 [label="我還以為從語言就能看得出來了，但後來我才想起你不是來自我所知道的那個世界，哈！",shape=box,color=blue];
		j3928013634 -> j2719013786;
	j1145716975 [label="我的時間都花在履行身為太陽修女的聖職上。擦拭聖餐器皿，為教友擺放祈願物和還願物等。",shape=box,color=blue];
		j1145716975 -> j462113072;
	j876454817 [label="但那不是我花那麼多時間與逝者說話的原因。",shape=box,color=blue];
		j876454817 -> j3048556348;
	j2719013786 [label="我來自高盧國的首都──光之城。從地圖上看，在世界的格局中，它離霍爾瓦尼亞並不算太遠。",shape=box,color=blue];
		j2719013786 -> j2363761783;
	j462113072 [label="照看地下墓穴和墓園。那是我心儀的工作。",shape=box,color=blue];
		j462113072 -> j2283120405;
		j462113072 -> j2859037683;
	j3048556348 [label="Boolean MarieGraveyard2 is now true.",color=orange];
		j3048556348 -> j914717119;
	j2363761783 [label="我在想我的大教堂在 1999 年還屹立著嗎？有意思！",shape=box,color=blue];
		j2363761783 -> j1430103135;
		j2363761783 -> j525001443;
	j2283120405 [label="為什麼那是你心儀的工作？",shape=box,color=red];
		j2283120405 -> j4083784486;
	j2859037683 [label="不好意思，最後那部分沒聽明白。",shape=box,color=red];
		j2859037683 -> j2030135099;
	j914717119 [label="那種地方有一種美，一種寧靜。如此安靜和安寧。",shape=box,color=blue];
		j914717119 -> j4165721531;
	j1430103135 [label="你真的很喜歡離題，對吧？",shape=box,color=red];
		j1430103135 -> j3840891801;
	j525001443 [label="我大概可以問一下我的兩個朋友，他們去過不少地方。我記得他們甚至有提到去過那座城市。",shape=box,color=red];
		j525001443 -> j3513941261;
	j4083784486 [label="我很享受和那些安息的人說話。他們會傾聽我的煩惱，不帶一絲評判。",shape=box,color=blue];
		j4083784486 -> j1996944496;
	j2030135099 [label="我的職責是照料大教堂裡的逝者。我會拂去地下墓穴地板上的灰塵，除去墓園草皮上的雜草。",shape=box,color=blue];
		j2030135099 -> j4083784486;
	j4165721531 [label="我想我喜歡告訴他們我的煩惱和其他人的事情，是因為他們已經無憂無慮了，對吧？",shape=box,color=blue];
		j4165721531 -> j2478339312;
	j3840891801 [label="+5 Chemistry",color=orange];
		j3840891801 -> j786247053;
	j3513941261 [label="+5 Chemistry",color=orange];
		j3513941261 -> j621315594;
	j1996944496 [label="嗯，他們隻字不回，但這正合我意！我寧願他們保持沉默。",shape=box,color=blue];
		j1996944496 -> j723607527;
	j2478339312 [label="對他們來說，現在似乎一切都已經不再重要，而這讓我感到心安。",shape=box,color=blue];
		j2478339312 -> j634469982;
		j2478339312 -> j3224226978;
		j2478339312 -> j328383235;
	j786247053 [label="你也注意到了，對吧？里昂總是取笑我，說我是陽光下的一粒塵埃，隨風飄蕩。我很高興你和他現在有在對話了！",shape=box,color=blue];
		j786247053 -> j277719359;
	j621315594 [label="哦，還是別麻煩他們了，這只是個愚蠢的念頭。我不知道如果它不在了我會有多難過。",shape=box,color=blue];
		j621315594 -> j277719359;
	j723607527 [label="+5 Chemistry",color=orange];
		j723607527 -> j3956285434;
	j634469982 [label="我不知道，我……害怕真的死去，我從來就不喜歡面對死亡。",shape=box,color=red];
		j634469982 -> j2959392431;
	j3224226978 [label="我從來沒有那樣想過。",shape=box,color=red];
		j3224226978 -> j3399183846;
	j328383235 [label="我也在墓地和墓園裡找到過同樣的平靜。我完全理解。",shape=box,color=red];
		j328383235 -> j3988070531;
	j277719359 [label="我就是好奇，好嗎？我想認識世間萬物，所有存在的一切。我想這就是為什麼主教和我注定要相遇。",shape=box,color=blue];
		j277719359 -> j2926778624;
	j3956285434 [label="你能想像如果他們會說話會怎麼樣嗎？那他們就會像你那個呱噪的亡骸精靈骷髏頭了，哈！",shape=box,color=blue];
		j3956285434 -> j1615464771;
		j3956285434 -> j838914883;
	j2959392431 [label="我知道，我才是病態小瑪麗！我就是怪。但各有所好，對不？",shape=box,color=blue];
		j2959392431 -> j2188862885;
	j3399183846 [label="不是只有你這麼想。我們都不太喜歡花太多時間去思考死後會發生什麼事。除非死到臨頭。",shape=box,color=blue];
		j3399183846 -> j3590979352;
	j3988070531 [label="我很高興你理解！",shape=box,color=blue];
		j3988070531 -> j3590979352;
	j2926778624 [label="（法語）我說到哪裡了？啊！對。我的故事。",shape=box,color=blue];
		j2926778624 -> j1461805427;
	j1615464771 [label="考慮到你坐輪椅，那應該不是最輕鬆的工作。",shape=box,color=red];
		j1615464771 -> j2606745658;
	j838914883 [label="你沒有其他朋友可以聊天嗎？",shape=box,color=red];
		j838914883 -> j389870709;
	j2188862885 [label="總得有人照顧他們。而我非常樂意。",shape=box,color=blue];
		j2188862885 -> j3590979352;
	j3590979352 [label="里昂開玩笑說我離地面更近，所以才會一直想墳墓的事。",shape=box,color=blue];
		j3590979352 -> j2501397066;
	j1461805427 [label="我誕生於富裕家庭，這可能會讓你驚訝。資產階級，和 Orokin 階層相去不遠。",shape=box,color=blue];
		j1461805427 -> j1566151058;
	j2606745658 [label="不，確實不容易。但每次要上下地下墓穴時，里昂都幫我上下樓梯，剩下的事我還能自行慢慢處理。",shape=box,color=blue];
		j2606745658 -> j1536153471;
	j389870709 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j389870709 -> j487348309;
	j2501397066 [label="我問他是不是腦袋空空的，所以才會住滿鬼魂。",shape=box,color=blue];
		j2501397066 -> j1393367418;
	j1566151058 [label="然而，我一出生就是這樣……畸形，雙腳扭曲不聽使喚？哦，我母親無法接受。",shape=box,color=blue];
		j1566151058 -> j2181177934;
	j1536153471 [label="只要夠固執就能做到的事情可多了，對吧？",shape=box,color=blue];
		j1536153471 -> j1018922959;
	j487348309 [label="當然，我有里昂陪著我。但你也看得出來，有些日子我們相處得並不怎麼樣。",shape=box,color=blue];
		j487348309 -> j3048556348;
	j1393367418 [label="然後他就會威脅要把我推下山坡，而我就會威脅在他的長袍裡塞滿蕁麻。",shape=box,color=blue];
		j1393367418 -> j1109393481;
	j2181177934 [label="有形象必須維護，對吧？有水準必須保持。",shape=box,color=blue];
		j2181177934 -> j1449131503;
	j1018922959 [label="好吧。是固執外加上半身體力，哈！",shape=box,color=blue];
		j1018922959 -> j1189037600;
	j1109393481 [label="（法語）家人。",shape=box,color=blue];
		j1109393481 -> j702837383;
		j1109393481 -> j1502039817;
		j1109393481 -> j2479282747;
		j1109393481 -> j934671936;
	j1449131503 [label="那麼，該拿可憐的畸形瑪麗怎麼辦？於是我就被帶到了光之城，在那裡我肯定會死在街頭……",shape=box,color=blue];
		j1449131503 -> j1753237436;
	j1189037600 [label="Boolean MarieGraveyard1 is now true.",color=orange];
		j1189037600 -> j3048556348;
	j702837383 [label="我很抱歉源拓氏打亂了你原有的生活。",shape=box,color=red];
		j702837383 -> j642959877;
	j1502039817 [label="我真高興你們倆有彼此。",shape=box,color=red];
		j1502039817 -> j1666015481;
	j2479282747 [label="你們倆讓我樂開懷。",shape=box,color=red];
		j2479282747 -> j2480727987;
	j934671936 [label="所以你和他……從來沒有交往過嗎？",shape=box,color=red];
		j934671936 -> j2889704226;
	j1753237436 [label="然後被遺棄，自生自滅。",shape=box,color=blue];
		j1753237436 -> j3685487165;
		j1753237436 -> j2940329215;
	j642959877 [label="+10 Chemistry",color=orange];
		j642959877 -> j1922665460;
	j1666015481 [label="+20 Chemistry",color=orange];
		j1666015481 -> j281613469;
	j2480727987 [label="+20 Chemistry",color=orange];
		j2480727987 -> j4037102086;
	j2889704226 [label="哦，日尊！沒有！除了血緣之外，他在各方面都像我弟兄。光是這個念頭就讓我完全反感！",shape=box,color=blue];
		j2889704226 -> j4243758252;
		j2889704226 -> j1780618296;
	j3685487165 [label="你的家人拋棄你，任你自生自滅？",shape=box,color=red];
		j3685487165 -> j4165596789;
	j2940329215 [label="你當時幾歲？",shape=box,color=red];
		j2940329215 -> j1635168558;
	j1922665460 [label="源拓氏沒有打亂任何事。里昂和我一如既往地堅強。只是情況有變，對不？",shape=box,color=blue];
		j1922665460 -> j1091763881;
	j281613469 [label="沒有他，我哪裡也去不了。除了或許山下吧。呵！",shape=box,color=blue];
		j281613469 -> j1943599420;
	j4037102086 [label="他會用最奇怪的方式逗我笑。但我發現，漂泊狼，你也一樣。我發現自己在這裡越來越快樂了。",shape=box,color=blue];
		j4037102086 -> j561728069;
	j4243758252 [label="我只是好奇。",shape=box,color=red];
		j4243758252 -> j3385888755;
	j1780618296 [label="我承認，我有點鬆了口氣。",shape=box,color=red];
		j1780618296 -> j1335227973;
	j4165596789 [label="在他們眼裡，已經花了多年在盡力矯正我。請家庭教師教我行走，穿戴肢架，特製鞋具。",shape=box,color=blue];
		j4165596789 -> j9222;
	j1635168558 [label="六歲？還是七歲？在他們眼裡，已經花了多年在盡力矯正我。請家庭教師教我行走，穿戴肢架，特製鞋具。",shape=box,color=blue];
		j1635168558 -> j9222;
	j1091763881 [label="太陰永遠都在變化。即使是太陽，儘管恆定不變，也會在軌道中受到影響。",shape=box,color=blue];
		j1091763881 -> j1740025217;
	j1943599420 [label="他真的是我的靈魂弟兄。我發現自己在這裡越來越快樂了。",shape=box,color=blue];
		j1943599420 -> j561728069;
	j561728069 [label="我只希望他很快也能發現這點……但惡魔會用他的耳語和謊言纏擾他。",shape=box,color=blue];
		j561728069 -> j3711844672;
	j3385888755 [label="+10 Chemistry",color=orange];
		j3385888755 -> j1930259134;
	j1335227973 [label="Check boolean DrifterMarie",color=orange];
		j1335227973 -> j989989826 [label=true,color=green];
		j1335227973 -> j2581632117 [label=false,color=brown];
	j9222 [label="他們厭倦了這種負擔。於是，連數字和字母幾乎都不會讀寫的我，發現自己淪落街頭。",shape=box,color=blue];
		j9222 -> j1093018850;
		j9222 -> j3577432745;
	j1740025217 [label="漂泊狼，我們不能固守成規，否則就會被它們打垮。再說，我發現自己在這裡越來越快樂了。",shape=box,color=blue];
		j1740025217 -> j561728069;
	j3711844672 [label="呸！一說起他，他就打來。我得走了。",shape=box,color=blue];
		j3711844672 -> "Chat ends.";
	j1930259134 [label="Check boolean DrifterMarie",color=orange];
		j1930259134 -> j2844467140 [label=true,color=green];
		j1930259134 -> j3455631827 [label=false,color=brown];
	j989989826 [label="是的，你已經表明你的意圖了。我必須警告你，我不會拋棄他。我認識里昂的時間比認識你還久。",shape=box,color=blue];
		j989989826 -> j3455631827;
	j2581632117 [label="是嗎？那你想……狩獵我們哪一個？",shape=box,color=blue];
		j2581632117 -> j2204711175;
		j2581632117 -> j4046916442;
	j1093018850 [label="你是怎麼活下來的？",shape=box,color=red];
		j1093018850 -> j251854413;
	j3577432745 [label="好可怕喔。",shape=box,color=red];
		j3577432745 -> j251854413;
	j2844467140 [label="是喔。只是「好奇」。你騙不了我。我必須警告你，我不會拋棄他。我認識里昂的時間比認識你還久。",shape=box,color=blue];
		j2844467140 -> j3455631827;
	j3455631827 [label="+20 Chemistry",color=orange];
		j3455631827 -> j2405216292;
	j2204711175 [label="你。",shape=box,color=red];
		j2204711175 -> j3897711067;
	j4046916442 [label="里昂。",shape=box,color=red];
		j4046916442 -> j2016385720;
	j251854413 [label="Check boolean MarieSecretPower",color=orange];
		j251854413 -> j2240288736 [label=true,color=green];
		j251854413 -> j3756103204 [label=false,color=brown];
	j2405216292 [label="沒有他，我哪裡也去不了。除了或許山下吧。呵！",shape=box,color=blue];
		j2405216292 -> j1224038483;
	j3897711067 [label="Boolean DrifterMarie is now true.",color=orange];
		j3897711067 -> j2878405920;
	j2016385720 [label="真的嗎？！",shape=box,color=blue];
		j2016385720 -> j3023289667;
	j2240288736 [label="就像你說的，所有的不便都蘊含神秘力量，對不？",shape=box,color=blue];
		j2240288736 -> j3756103204;
	j3756103204 [label="在母親眼中，讓我不受待見的缺陷，反而讓我在街頭的孩子眼中頗受歡迎。",shape=box,color=blue];
		j3756103204 -> j3688947227;
	j1224038483 [label="不過，漂泊狼，你讓我很著迷。我發現自己在這裡越來越快樂了。",shape=box,color=blue];
		j1224038483 -> j561728069;
	j2878405920 [label="+10 Chemistry",color=orange];
		j2878405920 -> j730805740;
	j3023289667 [label="+10 Chemistry",color=orange];
		j3023289667 -> j1400046792;
	j3688947227 [label="還有什麼比一個沒有雙腳的孩子更可憐的呢，對吧？我光是伸手乞討一天，就能賺得比他們一週偷搶來的還多。",shape=box,color=blue];
		j3688947227 -> j552225967;
	j730805740 [label="哦！以太陽之名。我必須承認，你讓我措手不及。現在我坐在這裡臉紅，把臉藏起來不讓 Loid 先生看見……",shape=box,color=blue];
		j730805740 -> j2625466007;
	j1400046792 [label="你不知道這讓我多麼開心，但請你好好想想你說過的話。",shape=box,color=blue];
		j1400046792 -> j1756177483;
	j552225967 [label="就因為這樣，我才會在街上被一位太陽修女發現。她們願意收留我。",shape=box,color=blue];
		j552225967 -> j4210091318;
		j552225967 -> j4105874920;
	j2625466007 [label="我必須警告你，我不會拋棄他。我認識里昂的時間比認識你還久。",shape=box,color=blue];
		j2625466007 -> j1900949899;
	j1756177483 [label="Boolean DrifterLyon is now true.",color=orange];
		j1756177483 -> j3525811469;
	j4210091318 [label="那其他孩子呢？",shape=box,color=red];
		j4210091318 -> j3171949210;
	j4105874920 [label="顯然，你答應了。",shape=box,color=red];
		j4105874920 -> j1187321452;
	j1900949899 [label="+10 Chemistry",color=orange];
		j1900949899 -> j561728069;
	j3525811469 [label="里昂是我的弟兄。我愛他的程度超乎你的想像，但他是個飽受折磨的人。在你追求他之前，請謹言慎行，好嗎？",shape=box,color=blue];
		j3525811469 -> j709154981;
	j3171949210 [label="+5 Chemistry",color=orange];
		j3171949210 -> j1795430954;
	j1187321452 [label="對啊，我還能怎麼辦？我遲早會病倒。即使作為一個孩子，我也知道這一點。",shape=box,color=blue];
		j1187321452 -> j3629669621;
		j1187321452 -> j1999222140;
	j709154981 [label="我想，我們很快會再談這件事。別誤會我的意思，我是在鼓勵你！我只是想讓你想清楚。",shape=box,color=blue];
		j709154981 -> j1900949899;
	j1795430954 [label="你的心地真善良。顯然，她們不可能收留所有人……但我從未忘記我的朋友。",shape=box,color=blue];
		j1795430954 -> j1852700595;
	j3629669621 [label="那些修女們怎麼樣？",shape=box,color=red];
		j3629669621 -> j478721486;
	j1999222140 [label="你是怎麼適應大教堂裡的生活的？",shape=box,color=red];
		j1999222140 -> j1186418870;
	j1852700595 [label="我每週都會帶著薪水回來，還有從廚房或其他人那裡收集到的剩飯剩菜。",shape=box,color=blue];
		j1852700595 -> j13655323;
	j478721486 [label="姊妹們對我很好！不過我知道，你一定會好奇為什麼，對不？",shape=box,color=blue];
		j478721486 -> j2104766140;
	j1186418870 [label="我真的很喜歡那裡！雖然我知道，你大概會納悶為什麼，對不？",shape=box,color=blue];
		j1186418870 -> j2104766140;
	j13655323 [label="只要我的朋友還在，我都盡我所能地照顧他們。許多朋友死於天花或肺結核……",shape=box,color=blue];
		j13655323 -> j2685171750;
	j2104766140 [label="一日有三餐，溫暖的床鋪，頭上有屋頂。我不必再擔心被打、被搶，或遭遇更可怕的事。",shape=box,color=blue];
		j2104766140 -> j858607305;
	j2685171750 [label="有幾個搬走了，有些死於鬥毆或暴力。大多數找到了正當工作，成家立業並養育子女。",shape=box,color=blue];
		j2685171750 -> j2330319490;
	j858607305 [label="我接受了正規的教育。被教導太陽與太陰的福音。被告誡要在信仰中尋找自己的道路。若果我願意，其實隨時都能離開。",shape=box,color=blue];
		j858607305 -> j1089556042;
	j2330319490 [label="有些甚至還會過來大教堂看我。這讓我很暖心。",shape=box,color=blue];
		j2330319490 -> j1089556042;
	j1089556042 [label="很長一段時間，我都感到內疚，因為只有我被收留，而其他人仍在街頭流浪。有些日子，我至今仍感到如此。",shape=box,color=blue];
		j1089556042 -> j1261731481;
		j1089556042 -> j687919507;
	j1261731481 [label="當我想起所有人在我身邊死去，而我卻是活下來的那個，我也感同身受。但我們不能這樣苛責自己。我們必須持續奮鬥，在力所能及時改善現狀。",shape=box,color=red];
		j1261731481 -> j2601369253;
	j687919507 [label="你已經盡你所能，用你得來的去幫助他人。別人曾經把你托舉起來，而現在你有了這個機會，也在試著把別人托舉起來。",shape=box,color=red];
		j687919507 -> j3405448049;
	j2601369253 [label="難道這一切永遠都會是這樣了嗎？一場奮鬥，一場奮戰？對抗試圖淹沒我們的浪潮？",shape=box,color=blue];
		j2601369253 -> j1162783890;
	j3405448049 [label="Add 1 to Thermostat counter",color=orange];
		j3405448049 -> j511494795;
	j1162783890 [label="Add -1 to Thermostat counter",color=orange];
		j1162783890 -> j2566810491;
	j511494795 [label="+10 Chemistry",color=orange];
		j511494795 -> j3432222134;
	j2566810491 [label="+10 Chemistry",color=orange];
		j2566810491 -> j647082830;
	j3432222134 [label="是的，正是如此。我曾被托上木筏，如今我也必須為他人做同樣的事。",shape=box,color=blue];
		j3432222134 -> j897765387;
	j647082830 [label="但我明白你的意思。歸根究底，你是說不要放棄。你說我被賜予這些恩澤，是為了讓我成為保護他人的盾牌。",shape=box,color=blue];
		j647082830 -> j897765387;
	j897765387 [label="謝謝。但現在我得走了。",shape=box,color=blue];
		j897765387 -> "Chat ends.";
}