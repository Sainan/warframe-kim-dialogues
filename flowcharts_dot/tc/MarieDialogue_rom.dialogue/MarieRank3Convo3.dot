		1114 -> 1118 [label=false,color=brown];
	1115 [label="你能跟我多說一點源拓氏到來之前，住在大教堂裡的生活是什麼樣子的嗎？",shape=box,color=red];
		1115 -> 1119;
	1117 [label="瑪麗，你在哪裡長大的？",shape=box,color=red];
		1117 -> 2425;
	1118 [label="[結束]",shape=box,color=red];
		1118 -> 1122;
	1116 [label="源拓氏出現之前，你在大教堂的生活是什麼樣子的？",shape=box,color=red];
		1116 -> 1120;
	1119 [label="我想，其實就是孤單吧。我有里昂陪著我，但你也知道他有時候是什麼樣子的。哦！我很高興你和他現在有在對話了！",shape=box,color=blue];
		1119 -> 1123;
	2425 [label="Update boolean MarieBackstory1",color=orange];
		2425 -> 1121;
	1122 [label="Chat ends.",color=orange];
	1120 [label="哦，我不知道這會不會讓你覺得很無聊，但既然你這麼好奇，我還是告訴你吧。",shape=box,color=blue];
		1120 -> 1124;
	1123 [label="Update boolean MarieGraveyard2",color=orange];
		1123 -> 1126;
	1121 [label="我還以為從語言就能看得出來了，但後來我才想起你不是來自我所知道的那個世界，哈！",shape=box,color=blue];
		1121 -> 1125;
	1124 [label="我的時間都花在履行身為太陽修女的聖職上。擦拭聖餐器皿，為教友擺放祈願物和還願物等。",shape=box,color=blue];
		1124 -> 1127;
	1126 [label="但那不是我花那麼多時間與逝者說話的原因。",shape=box,color=blue];
		1126 -> 1129;
	1125 [label="我來自高盧國的首都──光之城。從地圖上看，在世界的格局中，它離霍爾瓦尼亞並不算太遠。",shape=box,color=blue];
		1125 -> 1128;
	1127 [label="照看地下墓穴和墓園。那是我心儀的工作。",shape=box,color=blue];
		1127 -> 1130;
		1127 -> 1131;
	1129 [label="Update boolean MarieGraveyard2",color=orange];
		1129 -> 1134;
	1128 [label="我在想我的大教堂在 1999 年還屹立著嗎？有意思！",shape=box,color=blue];
		1128 -> 1132;
		1128 -> 1133;
	1130 [label="為什麼那是你心儀的工作？",shape=box,color=red];
		1130 -> 1135;
	1131 [label="不好意思，最後那部分沒聽明白。",shape=box,color=red];
		1131 -> 1136;
	1134 [label="那種地方有一種美，一種寧靜。如此安靜和安寧。",shape=box,color=blue];
		1134 -> 1139;
	1132 [label="你真的很喜歡離題，對吧？",shape=box,color=red];
		1132 -> 1137;
	1133 [label="我大概可以問一下我的兩個朋友，他們去過不少地方。我記得他們甚至有提到去過那座城市。",shape=box,color=red];
		1133 -> 1138;
	1135 [label="我很享受和那些安息的人說話。他們會傾聽我的煩惱，不帶一絲評判。",shape=box,color=blue];
		1135 -> 1140;
	1136 [label="我的職責是照料大教堂裡的逝者。我會拂去地下墓穴地板上的灰塵，除去墓園草皮上的雜草。",shape=box,color=blue];
		1136 -> 1135;
	1139 [label="我想我喜歡告訴他們我的煩惱和其他人的事情，是因為他們已經無憂無慮了，對吧？",shape=box,color=blue];
		1139 -> 1143;
	1137 [label="+5 Chemistry",color=orange];
		1137 -> 1141;
	1138 [label="+5 Chemistry",color=orange];
		1138 -> 1142;
	1140 [label="嗯，他們隻字不回，但這正合我意！我寧願他們保持沉默。",shape=box,color=blue];
		1140 -> 1144;
	1143 [label="對他們來說，現在似乎一切都已經不再重要，而這讓我感到心安。",shape=box,color=blue];
		1143 -> 1146;
		1143 -> 1147;
		1143 -> 1148;
	1141 [label="你也注意到了，對吧？里昂總是取笑我，說我是陽光下的一粒塵埃，隨風飄蕩。我很高興你和他現在有在對話了！",shape=box,color=blue];
		1141 -> 1145;
	1142 [label="哦，還是別麻煩他們了，這只是個愚蠢的念頭。我不知道如果它不在了我會有多難過。",shape=box,color=blue];
		1142 -> 1145;
	1144 [label="+5 Chemistry",color=orange];
		1144 -> 1149;
	1146 [label="我不知道，我……害怕真的死去，我從來就不喜歡面對死亡。",shape=box,color=red];
		1146 -> 1151;
	1147 [label="我從來沒有那樣想過。",shape=box,color=red];
		1147 -> 1152;
	1148 [label="我也在墓地和墓園裡找到過同樣的平靜。我完全理解。",shape=box,color=red];
		1148 -> 1153;
	1145 [label="我就是好奇，好嗎？我想認識世間萬物，所有存在的一切。我想這就是為什麼主教和我注定要相遇。",shape=box,color=blue];
		1145 -> 1150;
	1149 [label="你能想像如果他們會說話會怎麼樣嗎？那他們就會像你那個呱噪的亡骸精靈骷髏頭了，哈！",shape=box,color=blue];
		1149 -> 1154;
		1149 -> 1155;
	1151 [label="我知道，我才是病態小瑪麗！我就是怪。但各有所好，對不？",shape=box,color=blue];
		1151 -> 1157;
	1152 [label="不是只有你這麼想。我們都不太喜歡花太多時間去思考死後會發生什麼事。除非死到臨頭。",shape=box,color=blue];
		1152 -> 1158;
	1153 [label="我很高興你理解！",shape=box,color=blue];
		1153 -> 1158;
	1150 [label="（法語）我說到哪裡了？啊！對。我的故事。",shape=box,color=blue];
		1150 -> 1156;
	1154 [label="考慮到你坐輪椅，那應該不是最輕鬆的工作。",shape=box,color=red];
		1154 -> 1159;
	1155 [label="你沒有其他朋友可以聊天嗎？",shape=box,color=red];
		1155 -> 1160;
	1157 [label="總得有人照顧他們。而我非常樂意。",shape=box,color=blue];
		1157 -> 1158;
	1158 [label="里昂開玩笑說我離地面更近，所以才會一直想墳墓的事。",shape=box,color=blue];
		1158 -> 1162;
	1156 [label="我誕生於富裕家庭，這可能會讓你驚訝。資產階級，和 Orokin 階層相去不遠。",shape=box,color=blue];
		1156 -> 1161;
	1159 [label="不，確實不容易。但每次要上下地下墓穴時，里昂都幫我上下樓梯，剩下的事我還能自行慢慢處理。",shape=box,color=blue];
		1159 -> 1163;
	1160 [label="Update boolean MarieGraveyard1",color=orange];
		1160 -> 1164;
	1162 [label="我問他是不是腦袋空空的，所以才會住滿鬼魂。",shape=box,color=blue];
		1162 -> 1166;
	1161 [label="然而，我一出生就是這樣……畸形，雙腳扭曲不聽使喚？哦，我母親無法接受。",shape=box,color=blue];
		1161 -> 1165;
	1163 [label="只要夠固執就能做到的事情可多了，對吧？",shape=box,color=blue];
		1163 -> 1167;
	1164 [label="當然，我有里昂陪著我。但你也看得出來，有些日子我們相處得並不怎麼樣。",shape=box,color=blue];
		1164 -> 1129;
	1166 [label="然後他就會威脅要把我推下山坡，而我就會威脅在他的長袍裡塞滿蕁麻。",shape=box,color=blue];
		1166 -> 1169;
	1165 [label="有形象必須維護，對吧？有水準必須保持。",shape=box,color=blue];
		1165 -> 1168;
	1167 [label="好吧。是固執外加上半身體力，哈！",shape=box,color=blue];
		1167 -> 1170;
	1169 [label="（法語）家人。",shape=box,color=blue];
		1169 -> 1172;
		1169 -> 1173;
		1169 -> 1174;
		1169 -> 3921;
	1168 [label="那麼，該拿可憐的畸形瑪麗怎麼辦？於是我就被帶到了光之城，在那裡我肯定會死在街頭……",shape=box,color=blue];
		1168 -> 1171;
	1170 [label="Update boolean MarieGraveyard1",color=orange];
		1170 -> 1129;
	1172 [label="我很抱歉源拓氏打亂了你原有的生活。",shape=box,color=red];
		1172 -> 1177;
	1173 [label="我真高興你們倆有彼此。",shape=box,color=red];
		1173 -> 1178;
	1174 [label="你們倆讓我樂開懷。",shape=box,color=red];
		1174 -> 1179;
	3921 [label="所以你和他……從來沒有交往過嗎？",shape=box,color=red];
		3921 -> 3922;
	1171 [label="然後被遺棄，自生自滅。",shape=box,color=blue];
		1171 -> 1175;
		1171 -> 1176;
	1177 [label="+10 Chemistry",color=orange];
		1177 -> 1182;
	1178 [label="+20 Chemistry",color=orange];
		1178 -> 1183;
	1179 [label="+20 Chemistry",color=orange];
		1179 -> 1184;
	3922 [label="哦，日尊！沒有！除了血緣之外，他在各方面都像我弟兄。光是這個念頭就讓我完全反感！",shape=box,color=blue];
		3922 -> 3923;
		3922 -> 3924;
	1175 [label="你的家人拋棄你，任你自生自滅？",shape=box,color=red];
		1175 -> 1180;
	1176 [label="你當時幾歲？",shape=box,color=red];
		1176 -> 1181;
	1182 [label="源拓氏沒有打亂任何事。里昂和我一如既往地堅強。只是情況有變，對不？",shape=box,color=blue];
		1182 -> 1186;
	1183 [label="沒有他，我哪裡也去不了。除了或許山下吧。呵！",shape=box,color=blue];
		1183 -> 1187;
	1184 [label="他會用最奇怪的方式逗我笑。但我發現，漂泊狼，你也一樣。我發現自己在這裡越來越快樂了。",shape=box,color=blue];
		1184 -> 1188;
	3923 [label="我只是好奇。",shape=box,color=red];
		3923 -> 3925;
	3924 [label="我承認，我有點鬆了口氣。",shape=box,color=red];
		3924 -> 3931;
	1180 [label="在他們眼裡，已經花了多年在盡力矯正我。請家庭教師教我行走，穿戴肢架，特製鞋具。",shape=box,color=blue];
		1180 -> 1185;
	1181 [label="六歲？還是七歲？在他們眼裡，已經花了多年在盡力矯正我。請家庭教師教我行走，穿戴肢架，特製鞋具。",shape=box,color=blue];
		1181 -> 1185;
	1186 [label="太陰永遠都在變化。即使是太陽，儘管恆定不變，也會在軌道中受到影響。",shape=box,color=blue];
		1186 -> 1191;
	1187 [label="他真的是我的靈魂弟兄。我發現自己在這裡越來越快樂了。",shape=box,color=blue];
		1187 -> 1188;
	1188 [label="我只希望他很快也能發現這點……但惡魔會用他的耳語和謊言纏擾他。",shape=box,color=blue];
		1188 -> 1192;
	3925 [label="+10 Chemistry",color=orange];
		3925 -> 3926;
	3931 [label="Check boolean DrifterMarie",color=orange];
		3931 -> 3932 [label=true,color=green];
		3931 -> 3933 [label=false,color=brown];
	1185 [label="他們厭倦了這種負擔。於是，連數字和字母幾乎都不會讀寫的我，發現自己淪落街頭。",shape=box,color=blue];
		1185 -> 1189;
		1185 -> 1190;
	1191 [label="漂泊狼，我們不能固守成規，否則就會被它們打垮。再說，我發現自己在這裡越來越快樂了。",shape=box,color=blue];
		1191 -> 1188;
	1192 [label="呸！一說起他，他就打來。我得走了。",shape=box,color=blue];
		1192 -> 1194;
	3926 [label="Check boolean DrifterMarie",color=orange];
		3926 -> 3927 [label=true,color=green];
		3926 -> 3928 [label=false,color=brown];
	3932 [label="是的，你已經表明你的意圖了。我必須警告你，我不會拋棄他。我認識里昂的時間比認識你還久。",shape=box,color=blue];
		3932 -> 3928;
	3933 [label="是嗎？那你想……狩獵我們哪一個？",shape=box,color=blue];
		3933 -> 3934;
		3933 -> 3935;
	1189 [label="你是怎麼活下來的？",shape=box,color=red];
		1189 -> 1193;
	1190 [label="好可怕喔。",shape=box,color=red];
		1190 -> 1193;
	1194 [label="Chat ends.",color=orange];
	3927 [label="是喔。只是「好奇」。你騙不了我。我必須警告你，我不會拋棄他。我認識里昂的時間比認識你還久。",shape=box,color=blue];
		3927 -> 3928;
	3928 [label="+20 Chemistry",color=orange];
		3928 -> 3929;
	3934 [label="你。",shape=box,color=red];
		3934 -> 3936;
	3935 [label="里昂。",shape=box,color=red];
		3935 -> 3941;
	1193 [label="Check boolean MarieSecretPower",color=orange];
		1193 -> 1196 [label=true,color=green];
		1193 -> 1195 [label=false,color=brown];
	3929 [label="沒有他，我哪裡也去不了。除了或許山下吧。呵！",shape=box,color=blue];
		3929 -> 3930;
	3936 [label="Update boolean DrifterMarie",color=orange];
		3936 -> 3937;
	3941 [label="真的嗎？！",shape=box,color=blue];
		3941 -> 3942;
	1196 [label="就像你說的，所有的不便都蘊含神秘力量，對不？",shape=box,color=blue];
		1196 -> 1195;
	1195 [label="在母親眼中，讓我不受待見的缺陷，反而讓我在街頭的孩子眼中頗受歡迎。",shape=box,color=blue];
		1195 -> 1197;
	3930 [label="不過，漂泊狼，你讓我很著迷。我發現自己在這裡越來越快樂了。",shape=box,color=blue];
		3930 -> 1188;
	3937 [label="+10 Chemistry",color=orange];
		3937 -> 3938;
	3942 [label="+10 Chemistry",color=orange];
		3942 -> 3943;
	1197 [label="還有什麼比一個沒有雙腳的孩子更可憐的呢，對吧？我光是伸手乞討一天，就能賺得比他們一週偷搶來的還多。",shape=box,color=blue];
		1197 -> 1198;
	3938 [label="哦！以太陽之名。我必須承認，你讓我措手不及。現在我坐在這裡臉紅，把臉藏起來不讓 Loid 先生看見……",shape=box,color=blue];
		3938 -> 3939;
	3943 [label="你不知道這讓我多麼開心，但請你好好想想你說過的話。",shape=box,color=blue];
		3943 -> 3944;
	1198 [label="就因為這樣，我才會在街上被一位太陽修女發現。她們願意收留我。",shape=box,color=blue];
		1198 -> 1199;
		1198 -> 1200;
	3939 [label="我必須警告你，我不會拋棄他。我認識里昂的時間比認識你還久。",shape=box,color=blue];
		3939 -> 3940;
	3944 [label="Update boolean DrifterLyon",color=orange];
		3944 -> 3945;
	1199 [label="那其他孩子呢？",shape=box,color=red];
		1199 -> 1201;
	1200 [label="顯然，你答應了。",shape=box,color=red];
		1200 -> 1202;
	3940 [label="+10 Chemistry",color=orange];
		3940 -> 1188;
	3945 [label="里昂是我的弟兄。我愛他的程度超乎你的想像，但他是個飽受折磨的人。在你追求他之前，請謹言慎行，好嗎？",shape=box,color=blue];
		3945 -> 3946;
	1201 [label="+5 Chemistry",color=orange];
		1201 -> 1203;
	1202 [label="對啊，我還能怎麼辦？我遲早會病倒。即使作為一個孩子，我也知道這一點。",shape=box,color=blue];
		1202 -> 1204;
		1202 -> 1205;
	3946 [label="我想，我們很快會再談這件事。別誤會我的意思，我是在鼓勵你！我只是想讓你想清楚。",shape=box,color=blue];
		3946 -> 3940;
	1203 [label="你的心地真善良。顯然，她們不可能收留所有人……但我從未忘記我的朋友。",shape=box,color=blue];
		1203 -> 1206;
	1204 [label="那些修女們怎麼樣？",shape=box,color=red];
		1204 -> 1207;
	1205 [label="你是怎麼適應大教堂裡的生活的？",shape=box,color=red];
		1205 -> 1208;
	1206 [label="我每週都會帶著薪水回來，還有從廚房或其他人那裡收集到的剩飯剩菜。",shape=box,color=blue];
		1206 -> 1209;
	1207 [label="姊妹們對我很好！不過我知道，你一定會好奇為什麼，對不？",shape=box,color=blue];
		1207 -> 1210;
	1208 [label="我真的很喜歡那裡！雖然我知道，你大概會納悶為什麼，對不？",shape=box,color=blue];
		1208 -> 1210;
	1209 [label="只要我的朋友還在，我都盡我所能地照顧他們。許多朋友死於天花或肺結核……",shape=box,color=blue];
		1209 -> 1211;
	1210 [label="一日有三餐，溫暖的床鋪，頭上有屋頂。我不必再擔心被打、被搶，或遭遇更可怕的事。",shape=box,color=blue];
		1210 -> 1212;
	1211 [label="有幾個搬走了，有些死於鬥毆或暴力。大多數找到了正當工作，成家立業並養育子女。",shape=box,color=blue];
		1211 -> 1213;
	1212 [label="我接受了正規的教育。被教導太陽與太陰的福音。被告誡要在信仰中尋找自己的道路。若果我願意，其實隨時都能離開。",shape=box,color=blue];
		1212 -> 1214;
	1213 [label="有些甚至還會過來大教堂看我。這讓我很暖心。",shape=box,color=blue];
		1213 -> 1214;
	1214 [label="很長一段時間，我都感到內疚，因為只有我被收留，而其他人仍在街頭流浪。有些日子，我至今仍感到如此。",shape=box,color=blue];
		1214 -> 1215;
		1214 -> 1216;
	1215 [label="當我想起所有人在我身邊死去，而我卻是活下來的那個，我也感同身受。但我們不能這樣苛責自己。我們必須持續奮鬥，在力所能及時改善現狀。",shape=box,color=red];
		1215 -> 1217;
	1216 [label="你已經盡你所能，用你得來的去幫助他人。別人曾經把你托舉起來，而現在你有了這個機會，也在試著把別人托舉起來。",shape=box,color=red];
		1216 -> 1218;
	1217 [label="難道這一切永遠都會是這樣了嗎？一場奮鬥，一場奮戰？對抗試圖淹沒我們的浪潮？",shape=box,color=blue];
		1217 -> 1219;
	1218 [label="Add 1 to Thermostat",color=orange];
		1218 -> 1220;
	1219 [label="Add -1 to Thermostat",color=orange];
		1219 -> 1221;
	1220 [label="+10 Chemistry",color=orange];
		1220 -> 1222;
	1221 [label="+10 Chemistry",color=orange];
