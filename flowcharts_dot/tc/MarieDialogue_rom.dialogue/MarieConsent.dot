	3577 [label="Chat ends.",color=orange];
	3578 [label="我的心肝，我們能聊聊嗎？只要一下子就好。",shape=box,color=blue];
		3578 -> 3580;
		3578 -> 3579;
	3576 [label="Chat ends.",color=orange];
	3580 [label="嗨，當然。怎麼了？",shape=box,color=red];
		3580 -> 3582;
	3579 [label="[結束]",shape=box,color=red];
		3579 -> 3581;
	3582 [label="我只是想說……我知道你的心也屬於另一個人。雖然我不認識他們，但我的心為此感到欣喜。",shape=box,color=blue];
		3582 -> 3584;
	3581 [label="Update boolean MarieConsentComplete",color=orange];
		3581 -> 3583;
	3584 [label="我信任你，如果他們在你靈魂中佔有一席之地，那麼我很樂意與他們分享。",shape=box,color=blue];
		3584 -> 3585;
	3583 [label="Chat ends.",color=orange];
	3585 [label="我只是希望有一天我能有機會見到他們，好嗎？我愛人的愛人，因此也必定是我的愛人……",shape=box,color=blue];
		3585 -> 3586;
	3586 [label="也就是說，如果你認為他們會有這種意願的話。",shape=box,color=blue];
		3586 -> 3587;
		3586 -> 3588;
		3586 -> 3589;
	3587 [label="老實說，你可能不是他們喜歡的類型。",shape=box,color=red];
		3587 -> 3590;
	3588 [label="瑪麗，他們會愛慕你的。就像我一樣。",shape=box,color=red];
		3588 -> 3591;
	3589 [label="我真的不認為他們能抵擋得住。",shape=box,color=red];
		3589 -> 3591;
	3590 [label="噗！我狼，你真的好壞。讓我做我的美夢吧。在那之前，我想我會在能擁有你的時候擁有你！",shape=box,color=blue];
		3590 -> 3592;
	3591 [label="在那之前，我會在能擁有你的時候擁有你。而我會很樂意與那些像我一樣開始在乎你的人分享你。",shape=box,color=blue];
		3591 -> 3592;
	3592 [label="畢竟，當你四處遊蕩享樂時，總要有人站崗對抗低語！",shape=box,color=blue];
		3592 -> 3593;
	3593 [label="說到這裡，有事要忙。再見！",shape=box,color=blue];
		3593 -> 3594;
	3594 [label="Update boolean MarieConsentComplete",color=orange];
		3594 -> 3595;
	3595 [label="Chat ends.",color=orange];
