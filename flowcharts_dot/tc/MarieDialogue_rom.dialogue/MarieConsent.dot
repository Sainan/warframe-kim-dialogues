	"Chat ends." [color=orange];
	j1985950621 [label="Check boolean MarieConsentComplete",color=orange];
		j1985950621 -> "Chat ends." [label=true,color=green];
		j1985950621 -> j4255221804 [label=false,color=brown];
	j1134465740 [label="Check boolean MariePolyamorySuccess",color=orange];
		j1134465740 -> j1985950621 [label=true,color=green];
		j1134465740 -> "Chat ends." [label=false,color=brown];
	j4255221804 [label="我的心肝，我們能聊聊嗎？只要一下子就好。",shape=box,color=blue];
		j4255221804 -> j2803652908;
		j4255221804 -> j3684282441;
	j2803652908 [label="嗨，當然。怎麼了？",shape=box,color=red];
		j2803652908 -> j3680799717;
	j3684282441 [label="[結束]",shape=box,color=red];
		j3684282441 -> j952339130;
	j3680799717 [label="我只是想說……我知道你的心也屬於另一個人。雖然我不認識他們，但我的心為此感到欣喜。",shape=box,color=blue];
		j3680799717 -> j1666784856;
	j952339130 [label="Boolean MarieConsentComplete is now true.",color=orange];
		j952339130 -> "Chat ends.";
	j1666784856 [label="我信任你，如果他們在你靈魂中佔有一席之地，那麼我很樂意與他們分享。",shape=box,color=blue];
		j1666784856 -> j3169293625;
	j3169293625 [label="我只是希望有一天我能有機會見到他們，好嗎？我愛人的愛人，因此也必定是我的愛人……",shape=box,color=blue];
		j3169293625 -> j919451043;
	j919451043 [label="也就是說，如果你認為他們會有這種意願的話。",shape=box,color=blue];
		j919451043 -> j905287359;
		j919451043 -> j942092101;
		j919451043 -> j159843214;
	j905287359 [label="老實說，你可能不是他們喜歡的類型。",shape=box,color=red];
		j905287359 -> j3352006641;
	j942092101 [label="瑪麗，他們會愛慕你的。就像我一樣。",shape=box,color=red];
		j942092101 -> j1955809094;
	j159843214 [label="我真的不認為他們能抵擋得住。",shape=box,color=red];
		j159843214 -> j1955809094;
	j3352006641 [label="噗！我狼，你真的好壞。讓我做我的美夢吧。在那之前，我想我會在能擁有你的時候擁有你！",shape=box,color=blue];
		j3352006641 -> j1985137171;
	j1955809094 [label="在那之前，我會在能擁有你的時候擁有你。而我會很樂意與那些像我一樣開始在乎你的人分享你。",shape=box,color=blue];
		j1955809094 -> j1985137171;
	j1985137171 [label="畢竟，當你四處遊蕩享樂時，總要有人站崗對抗低語！",shape=box,color=blue];
		j1985137171 -> j1305998008;
	j1305998008 [label="說到這裡，有事要忙。再見！",shape=box,color=blue];
		j1305998008 -> j952339130;
}