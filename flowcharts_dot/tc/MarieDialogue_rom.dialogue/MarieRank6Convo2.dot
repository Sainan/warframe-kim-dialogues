		3547 -> 3550 [label="RoatheMariePastry1",color=purple];
		3547 -> 3551 [label="RoatheMariePastry1",color=purple];
		3547 -> 3548 [label="false",color=purple];
		3547 -> 3549 [label="false",color=purple];
		3547 -> 3551 [label="false",color=purple];
	3548 [label="沒關係。你有充分的理由感到難過。",shape=box,color=red];
		3548 -> 3552;
	3549 [label="我能做什麼來讓你開心起來嗎？比如，我們可以去折磨羅瑟。",shape=box,color=red];
		3549 -> 3553;
	3550 [label="有什麼我能做的讓你開心起來嗎？也許我們可以去偷些糕點？",shape=box,color=red];
		3550 -> 3554;
	3551 [label="瑪麗，有時候神明是很殘忍的。這就是人生。",shape=box,color=red];
		3551 -> 3555;
	3552 [label="+20 Chemistry",color=orange];
		3552 -> 3556;
	3553 [label="+15 Chemistry",color=orange];
		3553 -> 3557;
	3554 [label="+20 Chemistry",color=orange];
		3554 -> 3557;
	3555 [label="+5 Chemistry",color=orange];
		3555 -> 3558;
	3556 [label="謝謝。好吧，我不想再感到鬱悶了。我要去做些更開心的事！我想費波那契先生的魚缸該清理了。",shape=box,color=blue];
		3556 -> 3559;
	3557 [label="哈！謝謝。這肯定能止住我這些愚蠢的眼淚。你確實知道怎麼哄傻裡傻氣的小瑪麗開心，對不？",shape=box,color=blue];
		3557 -> 3560;
		3557 -> 3561;
	3558 [label="對。你說得對。衪們是殘酷的。世界上充滿了像 Otak 先生這樣的故事，而且有許多比他的還要悲慘。我不應該為一個故事哭泣。",shape=box,color=blue];
		3558 -> 3562;
	3559 [label="Check boolean MarieDating",color=orange];
		3559 -> 3563 [label=true,color=green];
		3559 -> 3564 [label=false,color=brown];
	3560 [label="這是我最起碼能為你做的事。",shape=box,color=red];
		3560 -> 3565;
	3561 [label="你一點也不愚蠢。我有同樣的感受。",shape=box,color=red];
		3561 -> 3565;
	3562 [label="然而我卻坐在這裡，正在做這件事。謝謝你提醒我自己有多愚蠢。哼！傻裡傻氣的小瑪麗。好吧……我想費波那契先生的魚缸該清理了。",shape=box,color=blue];
