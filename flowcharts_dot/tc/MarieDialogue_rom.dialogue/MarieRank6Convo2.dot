	3483 [label="狼！我狼！我見到 Otak 了！我終於見到他了！",shape=box,color=blue];
		3483 -> 3487;
		3483 -> 3488;
	3484 [label="我見到 Otak 了！我終於見到他了！",shape=box,color=blue];
		3484 -> 3487;
		3484 -> 3488;
	3485 [label="狼！我狼！亡骸精靈先生後腦勺上的那張臉！我終於見到他了！",shape=box,color=blue];
		3485 -> 3489;
		3485 -> 3490;
		3485 -> 3491;
	3486 [label="亡骸精靈先生後腦勺上的那張臉！我終於見到他了！",shape=box,color=blue];
		3486 -> 3489;
		3486 -> 3490;
		3486 -> 3491;
	3487 [label="你喜歡和他聊天嗎？",shape=box,color=red];
		3487 -> 3492;
	3488 [label="你們的對話進行得怎樣？",shape=box,color=red];
		3488 -> 3493;
	3489 [label="可憐的 Otak……進行得怎樣？",shape=box,color=red];
		3489 -> 3494;
	3490 [label="我很高興你們終於見面了。Otak 有點難以解釋。",shape=box,color=red];
		3490 -> 3495;
	3491 [label="你見到 Otak 了？天啊……進行得怎樣？",shape=box,color=red];
		3491 -> 3496;
	3492 [label="我喜歡。但或許我當下有點想哭。因為他在同一次對話中向我介紹了自己三次，彷彿我們素未謀面。",shape=box,color=blue];
		3492 -> 3497;
	3493 [label="他……在同一次對話中向我介紹了自己三次，彷彿我們素未謀面。",shape=box,color=blue];
		3493 -> 3497;
	3494 [label="我覺得他既可愛又迷人！但在幽默感的掩飾下，我感受到了巨大的心碎。",shape=box,color=blue];
		3494 -> 3498;
	3495 [label="是的，我想也是。畫在自動機械背後的孩童塗鴉。我覺得他既可愛又迷人！",shape=box,color=blue];
		3495 -> 3499;
	3496 [label="為什麼你聽起來對我見到他並不高興？",shape=box,color=blue];
		3496 -> 3500;
		3496 -> 3501;
		3496 -> 3502;
	3497 [label="他用和之前一樣堅定、愉快的方式跟我打招呼。但他知道我是太陽修女！",shape=box,color=blue];
		3497 -> 3503;
	3498 [label="你能告訴我可憐的 Otak 先生的故事嗎？",shape=box,color=blue];
		3498 -> 3504;
	3499 [label="但在幽默感的掩飾下，卻隱藏著巨大的心碎。",shape=box,color=blue];
		3499 -> 3498;
	3500 [label="他有時候會惹我心煩，就這樣。",shape=box,color=red];
		3500 -> 3505;
	3501 [label="我不是故意的。他對某些人來說可能只是有點……令人不快。",shape=box,color=red];
		3501 -> 3506;
	3502 [label="抱歉。他有時候會惹人心煩。這不是他的錯。",shape=box,color=red];
		3502 -> 3506;
	3503 [label="確實，他對聖光者很了解！我們詳細討論了他所謂在「Orokin 帝國之前的時代」的「古老宗教」。",shape=box,color=blue];
		3503 -> 3507;
	3504 [label="Otak 曾經是名哲士、Orokin 科學家，也是學者。發生在他身上的事算不上什麼愉快的故事。",shape=box,color=red];
		3504 -> 3508;
	3505 [label="我希望你能對一個明顯虛弱的人更加友善。畢竟，我們都是靠著日尊的恩典，才能走到今天。",shape=box,color=blue];
		3505 -> 3509;
	3506 [label="我希望他們能對他表現出善意和耐心。但靠著日尊的恩典，我們才能走到今天。",shape=box,color=blue];
		3506 -> 3509;
	3507 [label="雖然他說那些知識現在大多遺失了，深藏在檔案庫中，而且絕對禁止查閱。他要我發誓保密。",shape=box,color=blue];
		3507 -> 3510;
	3508 [label="據傳他是個天才，也是開發利用氬結晶體的幕後主腦。",shape=box,color=red];
		3508 -> 3511;
	3509 [label="這樣的命運可能等待著我們任何人。甚至是你。",shape=box,color=blue];
		3509 -> 3512;
		3509 -> 3513;
	3510 [label="他告訴我，他非常擔心執行者 Ballas——無論他是誰——可能會發現我這個異端教派，然後處決我。",shape=box,color=blue];
		3510 -> 3514;
		3510 -> 3515;
	3511 [label="這些結晶獲取自虛空──它們是我們能夠製造許多強大 warframe 和武器的原因。",shape=box,color=red];
		3511 -> 3516;
	3512 [label="你說得對，抱歉。我不是那個意思。",shape=box,color=red];
		3512 -> 3498;
	3513 [label="我只是沒有時間花在他身上，抱歉。",shape=box,color=red];
		3513 -> 3517;
	3514 [label="Ballas 已經死了……繼續講。",shape=box,color=red];
		3514 -> 3518;
	3515 [label="這種事……不會發生。繼續說。",shape=box,color=red];
		3515 -> 3518;
	3516 [label="他專攻晶體學。而他的作品歸檔於這裡的實驗室。",shape=box,color=red];
		3516 -> 3519;
	3517 [label="那我很抱歉浪費了你更多時間。",shape=box,color=blue];
		3517 -> 3520;
	3518 [label="+5 Chemistry",color=orange];
		3518 -> 3521;
	3519 [label="出於某種原因，我不知道為什麼，他被轉變成中樞，並獲得了自己的亡骸精靈外殼。",shape=box,color=red];
		3519 -> 3522;
	3520 [label="Update boolean MarieOtakComplete",color=orange];
		3520 -> 3523;
	3521 [label="我當下也是這麼認為……嗯，他問我來自哪裡，當我告訴他時，他笑了，說「不，絕不可能！這我應該知道，因為我是──」",shape=box,color=blue];
		3521 -> 3524;
	3522 [label="並非所有中樞都是作為懲罰而製造的。但火衛二上的事……變得很糟，他受到了嚴重的損壞。",shape=box,color=red];
		3522 -> 3525;
	3523 [label="Chat ends.",color=orange];
	3524 [label="然後他……又再次向我介紹了自己。還問我是不是帶著礦物樣本從平野過來的……",shape=box,color=blue];
		3524 -> 3526;
		3524 -> 3527;
	3525 [label="（法語）可憐東西……",shape=box,color=blue];
		3525 -> 3528;
	3526 [label="是啊……那就是 Otak。",shape=box,color=red];
		3526 -> 3529;
	3527 [label="哦，瑪麗。我很抱歉……",shape=box,color=red];
		3527 -> 3529;
	3528 [label="Update boolean MarieOtak1",color=orange];
		3528 -> 3487;
		3528 -> 3488;
	3529 [label="一想到無法為他做任何事，我的心就碎成千萬片。",shape=box,color=blue];
		3529 -> 3530;
