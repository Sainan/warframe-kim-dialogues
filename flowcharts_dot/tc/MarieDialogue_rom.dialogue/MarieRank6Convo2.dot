		3530 -> 3533 [label="MarieCephalonUnsure",color=purple];
		3530 -> 3534 [label="false",color=purple];
	3531 [label="哦，聖光者啊，你們給他製造了什麼樣的地獄，把他的靈魂囚禁在那個由科學和閃光組成的牢籠裡？",shape=box,color=blue];
		3531 -> 3535;
	3532 [label="我只能向聖光者祈禱，希望你是對的，那個外殼裡剩下的只是……只是科學和閃光。",shape=box,color=blue];
		3532 -> 3536;
	3533 [label="我知道你不確定中樞是否包含靈魂，但我只能向聖光者祈禱……希望可憐的 Otak 不會受苦。",shape=box,color=blue];
		3533 -> 3537;
	3534 [label="我只能向聖光者祈禱，希望那個外殼裡剩下的只是……只是科學和閃光。",shape=box,color=blue];
		3534 -> 3538;
	3535 [label="為什麼讓他留在那裡，破碎地等待著被允許死去才得以安寧？我只能祈禱……如果那裡有某種存在──",shape=box,color=blue];
		3535 -> 3539;
	3536 [label="而且沒有靈魂被困在那個破碎的東西裡，等待著被允許死去才得以安寧。",shape=box,color=blue];
		3536 -> 3540;
	3537 [label="沒有靈魂被困在那個破碎的東西裡，等待著被允許死去才得以安寧。",shape=box,color=blue];
		3537 -> 3541;
	3538 [label="而且沒有靈魂被困在那個破碎的東西裡，等待著被允許死去才得以安寧。",shape=box,color=blue];
		3538 -> 3541;
	3539 [label="是因為他自願留下來進行某種孤獨的守望……",shape=box,color=blue];
		3539 -> 3542;
	3540 [label="因為如果你錯了，而有個靈魂違背自己的意願留在那個牢籠裡呢？",shape=box,color=blue];
		3540 -> 3543;
	3541 [label="或者如果那裡有某種存在，那是因為他自願留下來進行某種孤獨的守望。",shape=box,color=blue];
		3541 -> 3544;
	3542 [label="否則持相反觀點，豈不足以讓人質疑諸神的仁慈，對不？",shape=box,color=blue];
		3542 -> 3545;
	3543 [label="豈不足以讓人質疑神明的仁慈，對不？",shape=box,color=blue];
		3543 -> 3545;
	3544 [label="否則持相反觀點，豈不足以讓人質疑諸神的仁慈，對不？",shape=box,color=blue];
		3544 -> 3545;
	3545 [label="那我又該怎麼辦呢？",shape=box,color=blue];
		3545 -> 3546;
	3546 [label="請原諒我，我今天……我今天心情好鬱悶。",shape=box,color=blue];
		3546 -> 3547;
	3547 [label="Evaluate expressions",color=orange];
		3547 -> 3548 [label="MarieRoathePastry1",color=purple];
		3547 -> 3549 [label="MarieRoathePastry1",color=purple];
		3547 -> 3550 [label="MarieRoathePastry1",color=purple];
		3547 -> 3551 [label="MarieRoathePastry1",color=purple];
