	j3979133402 [label="Check boolean MarieDating",color=orange];
		j3979133402 -> j3724017371 [label=true,color=green];
		j3979133402 -> j2318697072 [label=false,color=brown];
	j3262364753 [label="狼！我狼！我見到 Otak 了！我終於見到他了！",shape=box,color=blue];
		j3262364753 -> j3558564184;
		j3262364753 -> j3144079053;
	j3800151577 [label="我見到 Otak 了！我終於見到他了！",shape=box,color=blue];
		j3800151577 -> j3558564184;
		j3800151577 -> j3144079053;
	j3724017371 [label="狼！我狼！亡骸精靈先生後腦勺上的那張臉！我終於見到他了！",shape=box,color=blue];
		j3724017371 -> j2865711227;
		j3724017371 -> j847295685;
		j3724017371 -> j2372549612;
	j2318697072 [label="亡骸精靈先生後腦勺上的那張臉！我終於見到他了！",shape=box,color=blue];
		j2318697072 -> j2865711227;
		j2318697072 -> j847295685;
		j2318697072 -> j2372549612;
	j3558564184 [label="你喜歡和他聊天嗎？",shape=box,color=red];
		j3558564184 -> j3324543135;
	j3144079053 [label="你們的對話進行得怎樣？",shape=box,color=red];
		j3144079053 -> j4134820789;
	j2865711227 [label="可憐的 Otak……進行得怎樣？",shape=box,color=red];
		j2865711227 -> j2556227828;
	j847295685 [label="我很高興你們終於見面了。Otak 有點難以解釋。",shape=box,color=red];
		j847295685 -> j2380579314;
	j2372549612 [label="你見到 Otak 了？天啊……進行得怎樣？",shape=box,color=red];
		j2372549612 -> j3298387448;
	j3324543135 [label="我喜歡。但或許我當下有點想哭。因為他在同一次對話中向我介紹了自己三次，彷彿我們素未謀面。",shape=box,color=blue];
		j3324543135 -> j376177086;
	j4134820789 [label="他……在同一次對話中向我介紹了自己三次，彷彿我們素未謀面。",shape=box,color=blue];
		j4134820789 -> j376177086;
	j2556227828 [label="我覺得他既可愛又迷人！但在幽默感的掩飾下，我感受到了巨大的心碎。",shape=box,color=blue];
		j2556227828 -> j1238471453;
	j2380579314 [label="是的，我想也是。畫在自動機械背後的孩童塗鴉。我覺得他既可愛又迷人！",shape=box,color=blue];
		j2380579314 -> j885947482;
	j3298387448 [label="為什麼你聽起來對我見到他並不高興？",shape=box,color=blue];
		j3298387448 -> j1323848615;
		j3298387448 -> j264492822;
		j3298387448 -> j2911133095;
	j376177086 [label="他用和之前一樣堅定、愉快的方式跟我打招呼。但他知道我是太陽修女！",shape=box,color=blue];
		j376177086 -> j1954472916;
	j1238471453 [label="你能告訴我可憐的 Otak 先生的故事嗎？",shape=box,color=blue];
		j1238471453 -> j745599863;
	j885947482 [label="但在幽默感的掩飾下，卻隱藏著巨大的心碎。",shape=box,color=blue];
		j885947482 -> j1238471453;
	j1323848615 [label="他有時候會惹我心煩，就這樣。",shape=box,color=red];
		j1323848615 -> j2783639596;
	j264492822 [label="我不是故意的。他對某些人來說可能只是有點……令人不快。",shape=box,color=red];
		j264492822 -> j979730125;
	j2911133095 [label="抱歉。他有時候會惹人心煩。這不是他的錯。",shape=box,color=red];
		j2911133095 -> j979730125;
	j1954472916 [label="確實，他對聖光者很了解！我們詳細討論了他所謂在「Orokin 帝國之前的時代」的「古老宗教」。",shape=box,color=blue];
		j1954472916 -> j3278513683;
	j745599863 [label="Otak 曾經是名哲士、Orokin 科學家，也是學者。發生在他身上的事算不上什麼愉快的故事。",shape=box,color=red];
		j745599863 -> j1824852904;
	j2783639596 [label="我希望你能對一個明顯虛弱的人更加友善。畢竟，我們都是靠著日尊的恩典，才能走到今天。",shape=box,color=blue];
		j2783639596 -> j1793176456;
	j979730125 [label="我希望他們能對他表現出善意和耐心。但靠著日尊的恩典，我們才能走到今天。",shape=box,color=blue];
		j979730125 -> j1793176456;
	j3278513683 [label="雖然他說那些知識現在大多遺失了，深藏在檔案庫中，而且絕對禁止查閱。他要我發誓保密。",shape=box,color=blue];
		j3278513683 -> j2291834763;
	j1824852904 [label="據傳他是個天才，也是開發利用氬結晶體的幕後主腦。",shape=box,color=red];
		j1824852904 -> j1629727266;
	j1793176456 [label="這樣的命運可能等待著我們任何人。甚至是你。",shape=box,color=blue];
		j1793176456 -> j4004500316;
		j1793176456 -> j3670582447;
	j2291834763 [label="他告訴我，他非常擔心執行者 Ballas——無論他是誰——可能會發現我這個異端教派，然後處決我。",shape=box,color=blue];
		j2291834763 -> j1010452946;
		j2291834763 -> j2746899912;
	j1629727266 [label="這些結晶獲取自虛空──它們是我們能夠製造許多強大 warframe 和武器的原因。",shape=box,color=red];
		j1629727266 -> j2635963878;
	j4004500316 [label="你說得對，抱歉。我不是那個意思。",shape=box,color=red];
		j4004500316 -> j1238471453;
	j3670582447 [label="我只是沒有時間花在他身上，抱歉。",shape=box,color=red];
		j3670582447 -> j4293978803;
	j1010452946 [label="Ballas 已經死了……繼續講。",shape=box,color=red];
		j1010452946 -> j4126679566;
	j2746899912 [label="這種事……不會發生。繼續說。",shape=box,color=red];
		j2746899912 -> j4126679566;
	j2635963878 [label="他專攻晶體學。而他的作品歸檔於這裡的實驗室。",shape=box,color=red];
		j2635963878 -> j1409300391;
	j4293978803 [label="那我很抱歉浪費了你更多時間。",shape=box,color=blue];
		j4293978803 -> j3007723528;
	j4126679566 [label="+5 Chemistry",color=orange];
		j4126679566 -> j2396355144;
	j1409300391 [label="出於某種原因，我不知道為什麼，他被轉變成中樞，並獲得了自己的亡骸精靈外殼。",shape=box,color=red];
		j1409300391 -> j1989976150;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j2396355144 [label="我當下也是這麼認為……嗯，他問我來自哪裡，當我告訴他時，他笑了，說「不，絕不可能！這我應該知道，因為我是──」",shape=box,color=blue];
		j2396355144 -> j3416685004;
	j1989976150 [label="並非所有中樞都是作為懲罰而製造的。但火衛二上的事……變得很糟，他受到了嚴重的損壞。",shape=box,color=red];
		j1989976150 -> j414098784;
	j3416685004 [label="然後他……又再次向我介紹了自己。還問我是不是帶著礦物樣本從平野過來的……",shape=box,color=blue];
		j3416685004 -> j1919261513;
		j3416685004 -> j527824976;
	j414098784 [label="（法語）可憐東西……",shape=box,color=blue];
		j414098784 -> j253530729;
	j1919261513 [label="是啊……那就是 Otak。",shape=box,color=red];
		j1919261513 -> j4035111820;
	j527824976 [label="哦，瑪麗。我很抱歉……",shape=box,color=red];
		j527824976 -> j4035111820;
	j253530729 [label="Boolean MarieOtak1 is now true.",color=orange];
		j253530729 -> j3558564184;
		j253530729 -> j3144079053;
	j4035111820 [label="一想到無法為他做任何事，我的心就碎成千萬片。",shape=box,color=blue];
		j4035111820 -> j457335464;
	j457335464 [label="Evaluate expressions",color=orange];
		j457335464 -> j2811943158 [label="MarieCephalonSoul",color=purple];
		j457335464 -> j2313387667 [label="MarieCephalonNoSoul",color=purple];
		j457335464 -> j167873531 [label="MarieCephalonUnsure",color=purple];
		j457335464 -> j1540424614 [label="false",color=purple];
	j2811943158 [label="哦，聖光者啊，你們給他製造了什麼樣的地獄，把他的靈魂囚禁在那個由科學和閃光組成的牢籠裡？",shape=box,color=blue];
		j2811943158 -> j2553988879;
	j2313387667 [label="我只能向聖光者祈禱，希望你是對的，那個外殼裡剩下的只是……只是科學和閃光。",shape=box,color=blue];
		j2313387667 -> j24893203;
	j167873531 [label="我知道你不確定中樞是否包含靈魂，但我只能向聖光者祈禱……希望可憐的 Otak 不會受苦。",shape=box,color=blue];
		j167873531 -> j1949670499;
	j1540424614 [label="我只能向聖光者祈禱，希望那個外殼裡剩下的只是……只是科學和閃光。",shape=box,color=blue];
		j1540424614 -> j1038510891;
	j2553988879 [label="為什麼讓他留在那裡，破碎地等待著被允許死去才得以安寧？我只能祈禱……如果那裡有某種存在──",shape=box,color=blue];
		j2553988879 -> j3024329892;
	j24893203 [label="而且沒有靈魂被困在那個破碎的東西裡，等待著被允許死去才得以安寧。",shape=box,color=blue];
		j24893203 -> j180963982;
	j1949670499 [label="沒有靈魂被困在那個破碎的東西裡，等待著被允許死去才得以安寧。",shape=box,color=blue];
		j1949670499 -> j1622835098;
	j1038510891 [label="而且沒有靈魂被困在那個破碎的東西裡，等待著被允許死去才得以安寧。",shape=box,color=blue];
		j1038510891 -> j1622835098;
	j3024329892 [label="是因為他自願留下來進行某種孤獨的守望……",shape=box,color=blue];
		j3024329892 -> j38809109;
	j180963982 [label="因為如果你錯了，而有個靈魂違背自己的意願留在那個牢籠裡呢？",shape=box,color=blue];
		j180963982 -> j1144911544;
	j1622835098 [label="或者如果那裡有某種存在，那是因為他自願留下來進行某種孤獨的守望。",shape=box,color=blue];
		j1622835098 -> j38809109;
	j38809109 [label="否則持相反觀點，豈不足以讓人質疑諸神的仁慈，對不？",shape=box,color=blue];
		j38809109 -> j74663335;
	j1144911544 [label="豈不足以讓人質疑神明的仁慈，對不？",shape=box,color=blue];
		j1144911544 -> j74663335;
	j74663335 [label="那我又該怎麼辦呢？",shape=box,color=blue];
		j74663335 -> j1874114260;
	j1874114260 [label="請原諒我，我今天……我今天心情好鬱悶。",shape=box,color=blue];
		j1874114260 -> j3251038745;
	j3251038745 [label="Evaluate expressions",color=orange];
		j3251038745 -> j554811240 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j666491635 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j721203646 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j2653275698 [label="MarieRoathePastry1",color=purple];
		j3251038745 -> j554811240 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j666491635 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j721203646 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j2653275698 [label="RoatheMariePastry1",color=purple];
		j3251038745 -> j554811240 [label="false",color=purple];
		j3251038745 -> j666491635 [label="false",color=purple];
		j3251038745 -> j2653275698 [label="false",color=purple];
	j554811240 [label="沒關係。你有充分的理由感到難過。",shape=box,color=red];
		j554811240 -> j3055691334;
	j666491635 [label="我能做什麼來讓你開心起來嗎？比如，我們可以去折磨羅瑟。",shape=box,color=red];
		j666491635 -> j2317504819;
	j721203646 [label="有什麼我能做的讓你開心起來嗎？也許我們可以去偷些糕點？",shape=box,color=red];
		j721203646 -> j515377539;
	j2653275698 [label="瑪麗，有時候神明是很殘忍的。這就是人生。",shape=box,color=red];
		j2653275698 -> j1093755808;
	j3055691334 [label="+20 Chemistry",color=orange];
		j3055691334 -> j1940705718;
	j2317504819 [label="+15 Chemistry",color=orange];
		j2317504819 -> j841409576;
	j515377539 [label="+20 Chemistry",color=orange];
		j515377539 -> j841409576;
	j1093755808 [label="+5 Chemistry",color=orange];
		j1093755808 -> j2900577834;
	j1940705718 [label="謝謝。好吧，我不想再感到鬱悶了。我要去做些更開心的事！我想費波那契先生的魚缸該清理了。",shape=box,color=blue];
		j1940705718 -> j2486340526;
	j841409576 [label="哈！謝謝。這肯定能止住我這些愚蠢的眼淚。你確實知道怎麼哄傻裡傻氣的小瑪麗開心，對不？",shape=box,color=blue];
		j841409576 -> j2689543649;
		j841409576 -> j2033571855;
	j2900577834 [label="對。你說得對。衪們是殘酷的。世界上充滿了像 Otak 先生這樣的故事，而且有許多比他的還要悲慘。我不應該為一個故事哭泣。",shape=box,color=blue];
		j2900577834 -> j2960690477;
	j2486340526 [label="Check boolean MarieDating",color=orange];
		j2486340526 -> j3563405424 [label=true,color=green];
		j2486340526 -> j2543568153 [label=false,color=brown];
	j2689543649 [label="這是我最起碼能為你做的事。",shape=box,color=red];
		j2689543649 -> j1350233930;
	j2033571855 [label="你一點也不愚蠢。我有同樣的感受。",shape=box,color=red];
		j2033571855 -> j1350233930;
	j2960690477 [label="然而我卻坐在這裡，正在做這件事。謝謝你提醒我自己有多愚蠢。哼！傻裡傻氣的小瑪麗。好吧……我想費波那契先生的魚缸該清理了。",shape=box,color=blue];
		j2960690477 -> j2486340526;
	j3563405424 [label="（法語）我狼，再見。",shape=box,color=blue];
		j3563405424 -> j3007723528;
	j2543568153 [label="（法語）再見！",shape=box,color=blue];
		j2543568153 -> j3007723528;
	j1350233930 [label="+5 Chemistry",color=orange];
		j1350233930 -> j4058209286;
	j4058209286 [label="Check boolean MarieDating",color=orange];
		j4058209286 -> j3997763514 [label=true,color=green];
		j4058209286 -> j3332037628 [label=false,color=brown];
	j3997763514 [label="我狼，謝謝。那我們就去搗亂吧。",shape=box,color=blue];
		j3997763514 -> j3007723528;
	j3332037628 [label="謝謝。那我們就去搗亂吧。",shape=box,color=blue];
