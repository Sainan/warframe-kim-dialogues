		j70687620 -> j1024209488 [label=false,color=brown];
	j322587642 [label="+5 Chemistry",color=orange];
		j322587642 -> j3696918555;
	j2787021459 [label="哦！抱歉，我不是那個意思！只是他似乎偏愛你，所以雖然他會忽視所有其他人，但他也許會聽你說話。",shape=box,color=blue];
		j2787021459 -> j1851504094;
	j3649623407 [label="是嗎？你是什麼意思？",shape=box,color=blue];
		j3649623407 -> j1155893159;
	j3871024669 [label="是的，他似乎確實偏愛你。也許是因為你們共享同個時空，而我們沒有。不然還能是為什麼？",shape=box,color=blue];
		j3871024669 -> j1155893159;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
