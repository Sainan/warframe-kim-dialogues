		j3639515879 -> j2787021459;
	j3309485027 [label="他有時候會這樣，但我覺得那很大程度只是做做樣子。",shape=box,color=red];
		j3309485027 -> j3649623407;
	j607374714 [label="說來奇怪，但我其實有點喜歡這樣。我們相處得很好。",shape=box,color=red];
