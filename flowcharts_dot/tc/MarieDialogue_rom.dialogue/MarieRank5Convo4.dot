		j1155893159 -> j4294672603 [label="RoatheTraitor2",color=purple];
		j1155893159 -> j1948648289 [label="RoatheExecutor2",color=purple];
		j1155893159 -> j464894770 [label="false",color=purple];
	j2289369472 [label="（法語）我的心肝，謝謝！",shape=box,color=blue];
		j2289369472 -> j3538661568;
	j2173451968 [label="（法語）謝謝！",shape=box,color=blue];
		j2173451968 -> j3538661568;
	j4124454875 [label="好吧！等你的好消息，在那之前我會準備好等你！我的心肝，謝謝。",shape=box,color=blue];
		j4124454875 -> j3569999725;
	j1318929485 [label="好吧！等你的好消息，在那之前我會準備好等你！謝謝。",shape=box,color=blue];
		j1318929485 -> j3569999725;
	j1786560291 [label="我絕不會暗示說因為那個惡魔似乎偏愛你，所以也許他會聽你的，而對所有其他人他似乎都會忽視。",shape=box,color=blue];
		j1786560291 -> j3970331938;
	j1434217078 [label="我只看你很高興就很快樂了。而且如果那個惡魔有地方可以發洩他的……精力……那就更好了，對不？",shape=box,color=blue];
		j1434217078 -> j2067537294;
	j3218064092 [label="他生命中的每個人都試圖把他塑造成某種怪物。我想我是第一個沒有這麼做的人。",shape=box,color=red];
		j3218064092 -> j1412580973;
	j2113534578 [label="他有很多面向不知道該如何展現。那不完全是在武裝自己，但他不相信人們不會傷害他。",shape=box,color=red];
		j2113534578 -> j1745821746;
	j367324311 [label="他……在漫長的歲月中經歷過真正的心碎。那只是結痂後長出了荊棘，僅此而已。",shape=box,color=red];
		j367324311 -> j381004010;
	j4294672603 [label="我想我能理解他活過的歲月。我見過跟他一樣多的死亡。",shape=box,color=red];
		j4294672603 -> j3654919416;
	j1948648289 [label="他只是一直試圖做正確的事。沒錯也許用錯了方式，但他是在試圖拯救始源星系免於 Orokin 統治。",shape=box,color=red];
		j1948648289 -> j2571819960;
	j464894770 [label="我喜歡他那種諷刺的幽默感。當你看穿他的自負之後，他其實很聰明。",shape=box,color=red];
		j464894770 -> j1315508531;
	j3538661568 [label="好吧！等你的好消息，在那之前我會準備好等你！",shape=box,color=blue];
		j3538661568 -> j3569999725;
	j3970331938 [label="而且絕不會在私密時刻。不。絕不。",shape=box,color=blue];
		j3970331938 -> j1281035180;
		j3970331938 -> j3862525223;
	j2067537294 [label="如果你能成為他肩上的小天使來約束他，對我們所有人來說就更好了。",shape=box,color=blue];
		j2067537294 -> j435250180;
		j2067537294 -> j313274415;
	j1412580973 [label="而我想我最近在那份名單的第一順位了，對不？我想我應該……考慮他的理由，為什麼他會是這個樣子。譴責救不了任何靈魂。",shape=box,color=blue];
		j1412580973 -> j3035444640;
	j1745821746 [label="我們總是向周圍的人隱藏著某種痛苦。某些我們想要庇護的東西，因為害怕別人會利用它。如果你說的是真的，我想我應該努力對他更友善一些。",shape=box,color=blue];
		j1745821746 -> j3035444640;
	j381004010 [label="我無法想像一個人在那麼多年裡必須承受多少愛與失去。即使我親眼見證，這一切似乎還是難以置信。",shape=box,color=blue];
		j381004010 -> j3970938677;
	j3654919416 [label="有時候當我跟他說話時，我會忘記他已經活了多少個世紀。即使我親眼見證，這一切似乎還是難以置信。",shape=box,color=blue];
		j3654919416 -> j3651069413;
	j2571819960 [label="總是有……細微差別的，對吧？總是有這樣或那樣做的理由。如果你說的是真的，我想我應該努力對他更友善一些。",shape=box,color=blue];
		j2571819960 -> j3035444640;
	j1315508531 [label="從來沒有人說過那個惡魔不機智。",shape=box,color=blue];
		j1315508531 -> j1852122832;
	j1281035180 [label="你讓我驚訝。我實在佩服。",shape=box,color=red];
		j1281035180 -> j1851504094;
	j3862525223 [label="我從不知道你還有這一面。",shape=box,color=red];
		j3862525223 -> j1851504094;
	j435250180 [label="我不能做出任何承諾。",shape=box,color=red];
		j435250180 -> j1572949817;
	j313274415 [label="誰說我在試圖約束他？",shape=box,color=red];
		j313274415 -> j3054918563;
	j3035444640 [label="+10 Chemistry",color=orange];
		j3035444640 -> j3375235701;
	j3970938677 [label="對呀，那會對靈魂造成什麼樣的傷害？我明白為什麼你會想找另一個能理解你的人。而他，也理解你。",shape=box,color=blue];
		j3970938677 -> j3035444640;
	j3651069413 [label="活了這麼久，見過這麼多死亡，而且其中許多還是自己親手造成的。",shape=box,color=blue];
		j3651069413 -> j3970938677;
	j1852122832 [label="+5 Chemistry",color=orange];
		j1852122832 -> j3375235701;
	j1572949817 [label="Add 1 to Thermostat counter",color=orange];
		j1572949817 -> j3692656257;
	j3054918563 [label="Add -1 to Thermostat counter",color=orange];
		j3054918563 -> j1446009152;
	j3375235701 [label="我只是很高興那個惡魔有人可以說話，而那個人會試圖約束他。他肩上的那個小天使。",shape=box,color=blue];
		j3375235701 -> j313274415;
		j3375235701 -> j435250180;
	j3692656257 [label="+10 Chemistry",color=orange];
		j3692656257 -> j3852822570;
	j1446009152 [label="+10 Chemistry",color=orange];
		j1446009152 -> j535807257;
	j3852822570 [label="是的，我擔心他身上有一種無法真正被治癒的邪惡。他太享受那種感覺了。",shape=box,color=blue];
		j3852822570 -> j1429175601;
	j535807257 [label="也許你是對的……沒有惡魔的天使算什麼天使？他提醒我們所有人應該努力避免什麼。",shape=box,color=blue];
		j535807257 -> j1429175601;
	j1429175601 [label="好吧！如果哪天你說服那個惡魔在我們的任務中幫助我們，在那之前我會準備好等你！",shape=box,color=blue];
		j1429175601 -> j3569999725;
}