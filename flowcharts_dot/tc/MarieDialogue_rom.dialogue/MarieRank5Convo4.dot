		2974 -> 2981;
	2980 [label="但我覺得我們需要……某種後盾，對不？你有什麼想法嗎？",shape=box,color=blue];
		2980 -> 2984;
		2980 -> 2983;
	2982 [label="但我想……我想──啊，願日尊原諒我，可能還是需要那個惡魔的協助。否則我認為 Loid 先生不會聽我們的。",shape=box,color=blue];
		2982 -> 2986;
	2983 [label="我想我們可能需要羅瑟的幫助，才能說服 Loid 去和源拓氏家族談談。否則我不認為他會答應，除非有人能保證家族和他本人都會受到保護。",shape=box,color=red];
		2983 -> 2987;
	2981 [label="我認為你或許說得對。那個惡魔可能就是我們需要的那塊拼圖。啊，連打出這些字都讓我覺得好痛苦！",shape=box,color=blue];
		2981 -> 2985;
	2984 [label="我真的沒什麼好主意，除非向可怕的來源求助。那些可能會讓我們日後陷入大麻煩的來源。也就是羅瑟。",shape=box,color=red];
		2984 -> 2988;
