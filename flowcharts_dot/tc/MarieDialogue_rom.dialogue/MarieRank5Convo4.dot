		3053 -> 3065;
	3052 [label="（法語）謝謝！",shape=box,color=blue];
		3052 -> 3065;
	3054 [label="好吧！等你的好消息，在那之前我會準備好等你！我的心肝，謝謝。",shape=box,color=blue];
		3054 -> 3066;
	3055 [label="好吧！等你的好消息，在那之前我會準備好等你！謝謝。",shape=box,color=blue];
		3055 -> 3066;
	3049 [label="我絕不會暗示說因為那個惡魔似乎偏愛你，所以也許他會聽你的，而對所有其他人他似乎都會忽視。",shape=box,color=blue];
		3049 -> 3062;
	3050 [label="我只看你很高興就很快樂了。而且如果那個惡魔有地方可以發洩他的……精力……那就更好了，對不？",shape=box,color=blue];
		3050 -> 3063;
	3045 [label="他生命中的每個人都試圖把他塑造成某種怪物。我想我是第一個沒有這麼做的人。",shape=box,color=red];
		3045 -> 3058;
	3044 [label="他有很多面向不知道該如何展現。那不完全是在武裝自己，但他不相信人們不會傷害他。",shape=box,color=red];
		3044 -> 3057;
	3047 [label="他……在漫長的歲月中經歷過真正的心碎。那只是結痂後長出了荊棘，僅此而已。",shape=box,color=red];
		3047 -> 3060;
	3048 [label="我想我能理解他活過的歲月。我見過跟他一樣多的死亡。",shape=box,color=red];
		3048 -> 3061;
	3043 [label="他只是一直試圖做正確的事。沒錯也許用錯了方式，但他是在試圖拯救始源星系免於 Orokin 統治。",shape=box,color=red];
		3043 -> 3056;
	3046 [label="我喜歡他那種諷刺的幽默感。當你看穿他的自負之後，他其實很聰明。",shape=box,color=red];
		3046 -> 3059;
	3064 [label="Chat ends.",color=orange];
	3065 [label="好吧！等你的好消息，在那之前我會準備好等你！",shape=box,color=blue];
		3065 -> 3075;
	3066 [label="Update boolean MarieFamilySuccess",color=orange];
		3066 -> 3076;
	3062 [label="而且絕不會在私密時刻。不。絕不。",shape=box,color=blue];
		3062 -> 3071;
		3062 -> 3072;
	3063 [label="如果你能成為他肩上的小天使來約束他，對我們所有人來說就更好了。",shape=box,color=blue];
		3063 -> 3073;
		3063 -> 3074;
	3058 [label="而我想我最近在那份名單的第一順位了，對不？我想我應該……考慮他的理由，為什麼他會是這個樣子。譴責救不了任何靈魂。",shape=box,color=blue];
		3058 -> 3067;
	3057 [label="我們總是向周圍的人隱藏著某種痛苦。某些我們想要庇護的東西，因為害怕別人會利用它。如果你說的是真的，我想我應該努力對他更友善一些。",shape=box,color=blue];
		3057 -> 3067;
	3060 [label="我無法想像一個人在那麼多年裡必須承受多少愛與失去。即使我親眼見證，這一切似乎還是難以置信。",shape=box,color=blue];
		3060 -> 3069;
	3061 [label="有時候當我跟他說話時，我會忘記他已經活了多少個世紀。即使我親眼見證，這一切似乎還是難以置信。",shape=box,color=blue];
		3061 -> 3070;
	3056 [label="總是有……細微差別的，對吧？總是有這樣或那樣做的理由。如果你說的是真的，我想我應該努力對他更友善一些。",shape=box,color=blue];
		3056 -> 3067;
	3059 [label="從來沒有人說過那個惡魔不機智。",shape=box,color=blue];
