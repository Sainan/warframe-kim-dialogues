		j409794056 -> j246318418 [label="false",color=purple];
	j4189472955 [label="你真的這麼確定嗎？如果我都能放下與那個惡魔的分歧，那你當然也可以，對不？",shape=box,color=blue];
		j4189472955 -> j2454775850;
		j4189472955 -> j3477825936;
	j173411859 [label="你說得對。我本來就沒想到你會同意，所以我不敢開口問。",shape=box,color=red];
		j173411859 -> j409794056;
	j2063042316 [label="不，一定還有別的辦法。我拒絕在這件事上向他求助。",shape=box,color=red];
		j2063042316 -> j4189472955;
	j3511230733 [label="他會在這方面給予我們幫助嗎？",shape=box,color=blue];
		j3511230733 -> j1221608490;
	j2037046302 [label="他會在這方面給予我們幫助嗎？",shape=box,color=blue];
		j2037046302 -> j2398446776;
	j331177512 [label="他會在這方面給予我們幫助嗎？",shape=box,color=blue];
		j331177512 -> j2524698815;
	j246318418 [label="但你覺得你能說服他幫助我們嗎？",shape=box,color=blue];
		j246318418 -> j1299359615;
		j246318418 -> j139326891;
	j2454775850 [label="好吧。如果你沒問題，我也沒問題。",shape=box,color=red];
		j2454775850 -> j1615325011;
	j3477825936 [label="不，我很抱歉。",shape=box,color=red];
		j3477825936 -> j931045688;
	j1221608490 [label="不，很可惜……我想，找他幫忙的這條路是條死路。你覺得還有別的辦法嗎？",shape=box,color=red];
		j1221608490 -> j3948789867;
	j2398446776 [label="他會的。我已經說服他幫忙讓他們團圓，而且你不會相信，目的是讓他能幫忙保護源拓氏的家人。畢竟他們是 Orokin 真正僅存的遺族。",shape=box,color=red];
		j2398446776 -> j3524664145;
	j2524698815 [label="他會的。我已經說服他幫忙讓他們團圓，而且你不會對此感到意外，主要是為了在阿爾布雷希特不在時激怒他。",shape=box,color=red];
		j2524698815 -> j722584157;
	j1299359615 [label="我還在想辦法，但我想我可以。",shape=box,color=red];
		j1299359615 -> j961489522;
	j139326891 [label="還沒定下來。他……嗯，你知道他是什麼德性。",shape=box,color=red];
		j139326891 -> j3827853471;
	j1615325011 [label="是的，我不必喜歡這件事，但我想這是我們必須吞下的苦藥。",shape=box,color=blue];
		j1615325011 -> j409794056;
	j931045688 [label="+20 Chemistry",color=orange];
		j931045688 -> j516500004;
	j3948789867 [label="哦！那真是……太可惜了。我不知道也不這麼認為……你能想到用另一種方式接觸那個惡魔嗎？或是再試一次的辦法？",shape=box,color=blue];
		j3948789867 -> j2803745555;
	j3524664145 [label="他正在幫助保護那個違背他意願將他變成原型 Warframe、還把他丟到過去、奪走他記憶的男人的家人……",shape=box,color=blue];
