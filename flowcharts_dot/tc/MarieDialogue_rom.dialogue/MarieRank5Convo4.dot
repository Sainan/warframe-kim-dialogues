		j1150256469 -> j1736610626;
	j1128651182 [label="我想你有一種特殊的方式能說服他，而所有人在這方面都失敗了，對不？",shape=box,color=blue];
		j1128651182 -> j3219525913;
		j1128651182 -> j3639515879;
	j2049606104 [label="祝你好運。那個惡魔即使在最好的時候也很固執。有時候，我覺得他就是喜歡唱反調！",shape=box,color=blue];
		j2049606104 -> j3309485027;
		j2049606104 -> j607374714;
	j3303575671 [label="是的，我知道。但我想你有一種特殊的方式能說服他，而所有人在這方面都失敗了，對不？",shape=box,color=blue];
		j3303575671 -> j3219525913;
		j3303575671 -> j3639515879;
	j3378807666 [label="是的，我當然知道。那個惡魔即使在最好的時候也很固執。有時候，我覺得他就是喜歡唱反調！",shape=box,color=blue];
