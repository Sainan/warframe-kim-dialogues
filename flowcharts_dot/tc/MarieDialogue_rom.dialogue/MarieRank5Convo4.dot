	j814749900 [label="你好，我的心肝！我想過了……我真的很不願承認這點。說這話讓我一點也不高興。",shape=box,color=blue];
		j814749900 -> j3121987632;
	j883903932 [label="你好！我想過了……我真的很不願承認這點。說這話讓我一點也不高興。",shape=box,color=blue];
