	j885066861 [label="你好，我想過了……我真的很不願承認這點。說這話讓我一點也不高興。",shape=box,color=blue];
		j885066861 -> j4155483872;
	j885345063 [label="但我覺得我們需要……某種後盾，對不？你有什麼想法嗎？",shape=box,color=blue];
		j885345063 -> j2561403576;
		j885345063 -> j1322239475;
	j3121987632 [label="但我想……我想──啊，願日尊原諒我，可能還是需要那個惡魔的協助。否則我認為 Loid 先生不會聽我們的。",shape=box,color=blue];
		j3121987632 -> j268812199;
	j1322239475 [label="我想我們可能需要羅瑟的幫助，才能說服 Loid 去和源拓氏家族談談。否則我不認為他會答應，除非有人能保證家族和他本人都會受到保護。",shape=box,color=red];
		j1322239475 -> j1619872521;
	j4155483872 [label="我認為你或許說得對。那個惡魔可能就是我們需要的那塊拼圖。啊，連打出這些字都讓我覺得好痛苦！",shape=box,color=blue];
		j4155483872 -> j409794056;
	j2561403576 [label="我真的沒什麼好主意，除非向可怕的來源求助。那些可能會讓我們日後陷入大麻煩的來源。也就是羅瑟。",shape=box,color=red];
		j2561403576 -> j4189472955;
	j268812199 [label="那個惡魔很強大，而且在事情出錯時，也能提供某種力量上的保證，對不？",shape=box,color=blue];
		j268812199 -> j173411859;
		j268812199 -> j2063042316;
	j1619872521 [label="我……不願承認，但我想你可能是對的……願日尊原諒我。",shape=box,color=blue];
		j1619872521 -> j409794056;
