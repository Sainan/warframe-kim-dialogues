		2999 -> 3006;
	3000 [label="他會的。我已經說服他幫忙讓他們團圓，而且你不會相信，目的是讓他能幫忙保護源拓氏的家人。畢竟他們是 Orokin 真正僅存的遺族。",shape=box,color=red];
		3000 -> 3007;
	3001 [label="他會的。我已經說服他幫忙讓他們團圓，而且你不會對此感到意外，主要是為了在阿爾布雷希特不在時激怒他。",shape=box,color=red];
