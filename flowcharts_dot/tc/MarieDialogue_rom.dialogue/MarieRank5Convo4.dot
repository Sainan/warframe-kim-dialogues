		j374072022 -> j885066861 [label=false,color=brown];
	j1175247396 [label="還有我們必須如何打破這個僵局。我們被困在這煉獄中的狀況不該繼續下去。這似乎是毫無必要的痛苦。",shape=box,color=blue];
