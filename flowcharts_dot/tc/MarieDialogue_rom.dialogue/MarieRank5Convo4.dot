		j3662806792 -> j3487613436;
	j3039566547 [label="我一直在想怎麼說服 Loid 走上那些階梯，終於去找家族談談，然後……我有個主意，但我覺得你不會喜歡。",shape=box,color=red];
		j3039566547 -> j668862974;
	j593546078 [label="瑪麗，你還願意……試著說服 Loid 去跟「樓上的鄰居」談談嗎？我知道上次那話題結束得有點尷尬。",shape=box,color=red];
		j593546078 -> j374072022;
	j3744704378 [label="關於讓 Loid 和源拓氏家族對話這件事，我在想……你有沒有重新考慮過讓羅瑟參與？",shape=box,color=red];
