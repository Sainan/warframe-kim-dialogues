		j1699329495 -> j1687480633;
	j1485356027 [label="你和那小子已經和他的家人相處得很好了……嗯，現在你讓我開始盤算了！",shape=box,color=blue];
		j1485356027 -> j2056268357;
	j19127234 [label="Check boolean MarieSyndicateMaxRank",color=orange];
