	j1591510439 [label="Evaluate expressions",color=orange];
		j1591510439 -> j3952036523 [label="DrifterFaithSol",color=purple];
		j1591510439 -> j2457351917 [label="DrifterFaithLua",color=purple];
		j1591510439 -> j1509812203 [label="DrifterFaithBalance",color=purple];
		j1591510439 -> j1745253331 [label="false",color=purple];
	j3097609957 [label="我只被告知感染者的事，我對其了解甚少……但我相信你。而如果我感受到的是真的，而我也祈禱確實如此，我不認為她被困住。",shape=box,color=blue];
		j3097609957 -> j1912495923;
	j1215683272 [label="你這麼說真的很貼心。如果我感受到的是真的，而我也祈禱這事確實如此，那麼是的，我認為你說得對。我不認為她被困住。",shape=box,color=blue];
		j1215683272 -> j1912495923;
	j2937758356 [label="如果我感受到的是真的，而我也祈禱確實如此，那麼不是，我不認為她被困住。",shape=box,color=blue];
		j2937758356 -> j1912495923;
	j3302135572 [label="如果我感受到的是真的，而我也祈禱確實如此，那麼是的，你說得對。他們自願留下來幫助我們。我不認為她被困住。",shape=box,color=blue];
		j3302135572 -> j1912495923;
	j2592180308 [label="是的，我蒙主教賜福……但我知道我對他的愛近乎獨一無二，因為這份愛不被悲傷、仇恨，或怨懟所玷污。",shape=box,color=blue];
		j2592180308 -> j1010531961;
	j3614774675 [label="我知道你認為他是某種可怕的怪物。但我必須問，是什麼讓你如此不信任他？",shape=box,color=blue];
		j3614774675 -> j1770364534;
		j3614774675 -> j3731594734;
		j3614774675 -> j2941557386;
	j2138671857 [label="我以為你相信他？為什麼突然改變心意？你就這麼善變嗎？",shape=box,color=blue];
		j2138671857 -> j1863868572;
		j2138671857 -> j2333125237;
	j3732027896 [label="你為什麼如此不信任他？",shape=box,color=blue];
		j3732027896 -> j1770364534;
		j3732027896 -> j2941557386;
		j3732027896 -> j3731594734;
	j1453932685 [label="是的，你這麼快就改變主意了？你在說謊。為了什麼目的，我不知道。而我也不想知道。",shape=box,color=blue];
		j1453932685 -> j1508231473;
	j955754529 [label="+5 Chemistry",color=orange];
		j955754529 -> j514813458;
	j1571186868 [label="Boolean MarieEntratiFan1 is now true.",color=orange];
		j1571186868 -> j514813458;
	j3952036523 [label="對於我們這些追隨太陽之道的人來說，我們必須永遠成為那道光，為那些站在十字路口迷路的人指引方向，對不？",shape=box,color=blue];
		j3952036523 -> j2305277301;
	j2457351917 [label="你是太陰的追隨者，你應該知道我們教導有些人必須獨自行走於暗影之中，對吧？",shape=box,color=blue];
		j2457351917 -> j2305277301;
	j1509812203 [label="你是聖光會的追隨者，你應該知道我們教導有些人必須獨自行走於未知的道路，對吧？",shape=box,color=blue];
		j1509812203 -> j2305277301;
	j1745253331 [label="在我的信仰中，我們知道那些行走於人生道路上的人，會發現自己來到太陰與太陽交會的十字路口。",shape=box,color=blue];
		j1745253331 -> j2305277301;
	j1912495923 [label="從她身上，我只感受到太陽的微笑帶來的溫暖。我認為主教的選擇是明智的。我很榮幸能在血脈中承載著她。",shape=box,color=blue];
		j1912495923 -> j4290090925;
		j1912495923 -> j360419794;
		j1912495923 -> j602975027;
		j1912495923 -> j2662177919;
	j1010531961 [label="我原諒他離開我們。我不認為其他人做得到……",shape=box,color=blue];
		j1010531961 -> j316785011;
		j1010531961 -> j1828082155;
		j1010531961 -> j1770364534;
		j1010531961 -> j2941557386;
	j1770364534 [label="他……來過渡域。很久以前……",shape=box,color=red];
		j1770364534 -> j571216162;
	j3731594734 [label="嗯，首先，他朝我胸口開了一槍，然後把我丟在那裡等死。",shape=box,color=red];
		j3731594734 -> j1207369753;
	j2941557386 [label="他凡走過必留下痛苦、死亡和遺棄。",shape=box,color=red];
		j2941557386 -> j1591510439;
	j1863868572 [label="我從未信任過他，我只是不想把你給嚇跑。",shape=box,color=red];
		j1863868572 -> j3248296313;
	j2333125237 [label="我之前不是故意說謊，我只是不知道該如何談論這個話題。你顯然很崇拜他……",shape=box,color=red];
		j2333125237 -> j295793828;
	j1508231473 [label="Boolean MarieNoDate is now true.",color=orange];
		j1508231473 -> "Chat ends.";
	j514813458 [label="是的，我們必須堅強！勇敢對抗黑暗，直至永遠！",shape=box,color=blue];
		j514813458 -> j3208964242;
	j2305277301 [label="Boolean DrifterCrossroads is now true.",color=orange];
		j2305277301 -> j3497613620;
	j316785011 [label="你說得對，他傷害並拋棄過很多人。而我認為他覺得自己不得不這麼做。",shape=box,color=red];
		j316785011 -> j2125045789;
	j1828082155 [label="當一個對你非常重要而且你深愛並依賴的人離開時，那真的很難受。尤其是當你不知道他為什麼離開，或是他再也不回來了。",shape=box,color=red];
		j1828082155 -> j4106987184;
	j571216162 [label="哦，日尊啊！你創造的那個世界，是從他女兒寫的書中召喚出來的，是嗎？Loid 先生提到過……主教也在那裡嗎？為什麼？",shape=box,color=blue];
		j571216162 -> j2210950190;
		j571216162 -> j3125165133;
		j571216162 -> j2194927906;
	j1207369753 [label="然而，你還活著！你還活著，不是嗎？而且生龍活虎？還活得很精彩，如果 Loid 先生講的那些關於你在過去的未來的冒險故事可信的話。",shape=box,color=blue];
		j1207369753 -> j4231093281;
	j3248296313 [label="（法語）啊，我懂了！我是個白癡，對吧？！我只是個來自遙遠過去，無法獨立思考的小殘疾。最好像對待林中小鹿那樣接近她，以免嚇跑她！",shape=box,color=blue];
		j3248296313 -> j2694148943;
	j295793828 [label="啊，是的……是我讓你不願說實話了，對吧？",shape=box,color=blue];
		j295793828 -> j779473692;
	j3208964242 [label="我已經原諒他離開我們。我不認為其他人做得到……",shape=box,color=blue];
		j3208964242 -> j316785011;
		j3208964242 -> j1828082155;
	j3497613620 [label="主教必須找到回到我們身邊的路。我們只能盡我們所能，在他呼喚時幫助他，並按照那些像他一樣蒙福之人的吩咐行事。",shape=box,color=blue];
		j3497613620 -> j989297039;
	j2125045789 [label="+5 Chemistry",color=orange];
		j2125045789 -> j3703972318;
	j4106987184 [label="+5 Chemistry",color=orange];
		j4106987184 -> j1315596902;
	j2210950190 [label="我認為起初，他是有點想去那裡尋找他留下的女兒的身影。但反而，他找到了對抗漠然的方法──他試圖疏遠的情感。",shape=box,color=red];
		j2210950190 -> j3540922112;
	j3125165133 [label="他的筆記講述了一個極度自吹自擂的故事，誇耀他如何去研究概念式體現，結果卻找到了對抗漠然的價值。",shape=box,color=red];
		j3125165133 -> j2976356433;
	j2194927906 [label="如果他的筆記可信的話，他去那裡是為了教導渡域，進而教導我，如何防範漠然。儘管最終收效甚微。",shape=box,color=red];
		j2194927906 -> j558460460;
	j4231093281 [label="Check boolean IsDating",color=orange];
		j4231093281 -> j3453719291 [label=true,color=green];
		j4231093281 -> j1587271070 [label=false,color=brown];
	j2694148943 [label="（法語）去坐蜂窩吧。",shape=box,color=blue];
		j2694148943 -> j1508231473;
	j779473692 [label="漂泊狼，那麼現在就告訴我實話吧。你為什麼認為他不值得信任？我會努力控制我的脾氣。",shape=box,color=blue];
		j779473692 -> j1828082155;
		j779473692 -> j1770364534;
		j779473692 -> j2941557386;
		j779473692 -> j3731594734;
	j989297039 [label="Evaluate expressions",color=orange];
		j989297039 -> j2717418650 [label="MarieEntratiMonster1",color=purple];
		j989297039 -> j230642356 [label="MarieEntratiMonster1",color=purple];
		j989297039 -> j2717418650 [label="MarieEntratiFan1",color=purple];
		j989297039 -> j1280367672 [label="MarieEntratiFan1",color=purple];
		j989297039 -> j2717418650 [label="false",color=purple];
		j989297039 -> j230642356 [label="false",color=purple];
		j989297039 -> j1280367672 [label="false",color=purple];
		j989297039 -> j2934334832 [label="false",color=purple];
	j3703972318 [label="是的，你說得對。我認為他因自己的所作所為而不斷被愧疚糾纏，而且他非常刻意地與他人保持距離。",shape=box,color=blue];
		j3703972318 -> j3425024365;
	j1315596902 [label="是的，這是一種可怕的悲傷，一種糟糕的痛苦。知道某人……還活著，但似乎選擇不在你身邊？",shape=box,color=blue];
		j1315596902 -> j3425024365;
	j3540922112 [label="這場悲劇讓我心碎，我不認為我能夠承受那種悲傷……然而，她還是不會原諒他？",shape=box,color=blue];
		j3540922112 -> j720287046;
		j3540922112 -> j3257950255;
	j2976356433 [label="你知道他為什麼離開嗎？",shape=box,color=blue];
		j2976356433 -> j720287046;
		j2976356433 -> j1591696141;
	j558460460 [label="你是什麼意思？",shape=box,color=blue];
		j558460460 -> j701841178;
		j558460460 -> j1604398798;
	j3453719291 [label="而且，如果參研者之間的傳聞是真的，你在那裡找到了很多樂趣，對不？",shape=box,color=blue];
		j3453719291 -> j1587271070;
	j1587271070 [label="不，主教對許多其他人做了更糟糕的事，你只是因為受到不便而感到不滿而已。",shape=box,color=blue];
		j1587271070 -> j1591510439;
	j2717418650 [label="我只是希望……我們能讓源拓氏身邊的每個人都停止為已經發生的事情責怪自己和彼此。",shape=box,color=red];
		j2717418650 -> j2322178017;
	j230642356 [label="我不知道我是否會稱他為蒙福之人。",shape=box,color=red];
		j230642356 -> j2772522754;
	j1280367672 [label="如果我能夠理解源拓氏的過錯，寬恕他就容易多了。",shape=box,color=red];
		j1280367672 -> j813655294;
	j2934334832 [label="我會做他需要我做的事，來解決這個問題。然後當一切都塵埃落定時，我再來評判他。",shape=box,color=red];
		j2934334832 -> j524387880;
	j3425024365 [label="他在他人心中造成痛苦，因為痛苦總比什麼都沒有好。因為苦難總比空虛好，對不？",shape=box,color=blue];
		j3425024365 -> j197204155;
	j720287046 [label="當他不做解釋時，恐怕我們只能給自己編造理由了。",shape=box,color=red];
		j720287046 -> j3343434931;
	j3257950255 [label="你沒抓住重點。他把我留在那裡。他看到有人被拋棄在虛空中，然後就把我留在那裡了。",shape=box,color=red];
		j3257950255 -> j1410867075;
	j1591696141 [label="不。我只知道他把我留在那裡。他看到有人被拋棄在虛空中，然後……就把我留在那裡了。",shape=box,color=red];
		j1591696141 -> j3343434931;
	j701841178 [label="他把我留在那裡。他在某個我不知道的時候來過，看到有人被拋棄在虛空中，然後……就把我留在那裡了。",shape=box,color=red];
		j701841178 -> j1410867075;
	j1604398798 [label="最終漠然還是來到了渡域。雖然，它得到了意外的幫助。但那又是另外一回事了。",shape=box,color=red];
		j1604398798 -> j2702343734;
	j2322178017 [label="Boolean MarieEntratiFamily is now true.",color=orange];
		j2322178017 -> j3905936811;
	j2772522754 [label="那麼我想我們也許就繼續各執己見了。",shape=box,color=blue];
		j2772522754 -> j626176547;
	j813655294 [label="我祈禱我們最終都能夠做到。我祈禱我們最終都能活著見證這一刻。但現在，我看到身邊的家人，祈禱他們能為了自身幸福而在心中找到寬恕。",shape=box,color=blue];
		j813655294 -> j3351854883;
	j524387880 [label="+10 Chemistry",color=orange];
		j524387880 -> j1853063282;
	j197204155 [label="這是我最親愛的里昂比大多數人更了解的一課……我很高興他現在肯與你對話。但今天我們談論的是關於主教的事。",shape=box,color=blue];
		j197204155 -> j221931327;
	j3343434931 [label="我只能推測這發生在……謀殺循環往復之前。",shape=box,color=red];
		j3343434931 -> j4136344547;
	j1410867075 [label="而你不知道他為什麼把你留在那裡嗎？",shape=box,color=blue];
		j1410867075 -> j2865612412;
		j1410867075 -> j3343434931;
		j1410867075 -> j420228461;
	j2702343734 [label="不。等一下。漠然有……盟友？",shape=box,color=blue];
		j2702343734 -> j1149346986;
		j2702343734 -> j3035315628;
	j3905936811 [label="Add 1 to Family counter",color=orange];
		j3905936811 -> j3888501654;
	j626176547 [label="Boolean MarieEntratiMonster2 is now true.",color=orange];
		j626176547 -> j2056268357;
	j3351854883 [label="Boolean MarieEntratiFan2 is now true.",color=orange];
		j3351854883 -> j2056268357;
	j1853063282 [label="是的，考慮到你所見所聞，這很合理也很公平。我不能再要求你更多了。",shape=box,color=blue];
		j1853063282 -> j1459098380;
	j221931327 [label="Boolean MarieLyonSuffering3 is now true.",color=orange];
		j221931327 -> j1591510439;
	j4136344547 [label="那麼我必須請你不要對他下最壞的假設，因為這會讓你心生怨恨。",shape=box,color=blue];
		j4136344547 -> j4080423606;
	j2865612412 [label="我只希望他有充分的理由。",shape=box,color=red];
		j2865612412 -> j3413767861;
	j420228461 [label="不知道，而且這不重要。他本可以救我。但他沒有。",shape=box,color=red];
		j420228461 -> j1495513693;
	j1149346986 [label="它只不過是戴著另一張臉而已。",shape=box,color=red];
		j1149346986 -> j1747748885;
	j3035315628 [label="也許？或者是人質。或許它只是戴著她的臉。我們真的不知道。",shape=box,color=red];
		j3035315628 -> j1747748885;
	j3888501654 [label="+10 Chemistry",color=orange];
		j3888501654 -> j4238562793;
	j2056268357 [label="啊，里昂打給我了。再見！",shape=box,color=blue];
		j2056268357 -> "Chat ends.";
	j1459098380 [label="Boolean MarieEntratiNeutral is now true.",color=orange];
		j1459098380 -> j2056268357;
	j4080423606 [label="或許你還不想拋棄渡域。或許它還沒有讓你失望。或許你不願意離開你的朋友？",shape=box,color=blue];
		j4080423606 -> j1687480633;
	j3413767861 [label="+5 Chemistry",color=orange];
		j3413767861 -> j467098273;
	j1495513693 [label="你會說，你在任何界域的任何可能性，都找不到他把你留在那裡的理由嗎？",shape=box,color=blue];
		j1495513693 -> j4080423606;
	j1747748885 [label="Boolean MarieNeci is now true.",color=orange];
		j1747748885 -> j1097236285;
	j4238562793 [label="哦，想法不錯。我認為這是值得追求的理想！",shape=box,color=blue];
		j4238562793 -> j130896092;
	j1687480633 [label="或許他不知道能否把你從中帶走，因為怕它在脆弱狀態下會崩潰。或許他認為如果你離開的話，漠然就會佔領它。或許──",shape=box,color=blue];
		j1687480633 -> j1591510439;
	j467098273 [label="謝謝，這正是我最珍視的點。我們絕不能往最壞處想，因為那樣只會讓我們心生怨恨。",shape=box,color=blue];
		j467098273 -> j1699329495;
	j1097236285 [label="我不知道該如何看待這件事……但這確實很奇怪…… ",shape=box,color=blue];
		j1097236285 -> j1410867075;
