	j3344320285 [label="關於那些被轉變成初代 Warframe 的人，恐怕我們知道的並不多。",shape=box,color=red];
		j3344320285 -> j3526479320;
	j945023667 [label="關於轉變成初代 Wisp 的人，恐怕我們知道的並不多。",shape=box,color=red];
		j945023667 -> j3526479320;
	j291486407 [label="漂泊狼，告訴我關於這個名為「Wisp」的存在，她那腐化的血液在我體內流淌，賜予了我飛翔與自由的恩賜，而在夜幕中，我感受到她的靈魂和我的靈魂如此形影不離。",shape=box,color=blue];
		j291486407 -> j1927132200;
		j291486407 -> j3418113585;
	j1796116269 [label="漂泊狼，告訴我關於這個名為「Wisp」的存在，她那腐化的血液在我體內流淌，賜予了我飛翔與自由的恩賜，而在夜幕中，我感受到她的靈魂和我的靈魂如此形影不離。",shape=box,color=blue];
		j1796116269 -> j1899301046;
	j3526479320 [label="真的嗎？那些紀錄是隨著時間流逝而遺失了，還是你認為它們只是被視為不重要而無需記錄？",shape=box,color=blue];
		j3526479320 -> j1045923653;
		j3526479320 -> j3746880218;
		j3526479320 -> j2048984830;
	j1927132200 [label="關於那些被轉變成初代 Warframe 的人，恐怕我們知道的並不多。",shape=box,color=red];
		j1927132200 -> j1948017729;
	j3418113585 [label="關於轉變成初代 Wisp 的人，恐怕我們知道的並不多。",shape=box,color=red];
		j3418113585 -> j1948017729;
	j1899301046 [label="不知是否談論靈魂的話題會令你感到困擾？若是會，我能夠理解，而我們可以將話題轉向更實際的事情上，我不想讓你感到不自在。",shape=box,color=blue];
		j1899301046 -> j3343273454;
		j1899301046 -> j3800076167;
		j1899301046 -> j1350559949;
	j1045923653 [label="我認為它們被視為不重要而無需記錄。",shape=box,color=red];
		j1045923653 -> j793752415;
	j3746880218 [label="我認為它們隨著時間流逝而遺失了。",shape=box,color=red];
		j3746880218 -> j793752415;
	j2048984830 [label="到頭來，兩者都有。對於他們的主要創造者而言，他們既是……武器又是藝術品。",shape=box,color=red];
		j2048984830 -> j52290918;
	j1948017729 [label="真的嗎？因為我總感覺我了解她，就像她是我的親姊妹一樣，我的血親之一，而並非大教堂裡的姊妹。",shape=box,color=blue];
		j1948017729 -> j488582314;
	j3343273454 [label="沒關係，我們可以談論關於靈魂的事。",shape=box,color=red];
		j3343273454 -> j1927132200;
		j3343273454 -> j3418113585;
		j3343273454 -> j1350559949;
	j3800076167 [label="我並不相信靈魂的存在，所以我們還是談論確切的事實，可以嗎？",shape=box,color=red];
		j3800076167 -> j3630349556;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j793752415 [label="你看到了嗎？這些 Orokin 簡直是惡魔。",shape=box,color=blue];
		j793752415 -> j2510580724;
		j793752415 -> j2783974819;
	j52290918 [label="+5 Chemistry",color=orange];
		j52290918 -> j1844547068;
	j488582314 [label="我聽不見她，不像里昂聽見神祇和衪的守護神靈那樣。我看不到她。我只是感覺得到她就在那裡，在我一旁。",shape=box,color=blue];
		j488582314 -> j1743224525;
	j3630349556 [label="Boolean DrifterFaithStop is now true.",color=orange];
		j3630349556 -> j3368214011;
	"Chat ends." [color=orange];
	j2510580724 [label="武器既可以用來保護，也可以用來傷害。我們不喜歡需要它，但是……我們確實需要它。",shape=box,color=red];
		j2510580724 -> j1798439772;
	j2783974819 [label="並非全是惡人。至於那個嘛？是的。周圍還有一些 Orokin，我不會立即譴責。",shape=box,color=red];
		j2783974819 -> j3612635570;
	j1844547068 [label="（法語）一幅用鮮血繪製的骨畫……你看到了吧？這些 Orokin 簡直是惡魔。",shape=box,color=blue];
		j1844547068 -> j2510580724;
		j1844547068 -> j2783974819;
	j1743224525 [label="或許就像個老朋友。我知道她喜歡什麼，我知道她如何移動。我記得她的笑聲飄蕩在風中……",shape=box,color=blue];
		j1743224525 -> j2028954598;
	j3368214011 [label="+5 Chemistry",color=orange];
		j3368214011 -> j2251876997;
	j1798439772 [label="Add -1 to Thermostat counter",color=orange];
		j1798439772 -> j567642433;
	j3612635570 [label="Add 1 to Thermostat counter",color=orange];
		j3612635570 -> j340614709;
	j2028954598 [label="我一定聽起來很瘋！抱歉了。",shape=box,color=blue];
		j2028954598 -> j1456214663;
		j2028954598 -> j784670490;
		j2028954598 -> j592802980;
		j2028954598 -> j4017408233;
	j2251876997 [label="是的，當然！沒有人希望被說教，尤其是被一位修女說教。我了解。謝謝，我可不想讓自己出醜。",shape=box,color=blue];
		j2251876997 -> j3344320285;
		j2251876997 -> j945023667;
		j2251876997 -> j1350559949;
	j567642433 [label="是的，確實如此。我現在是個武器，正如喃喃者所知！但我尋求遵循主教為我指引的道路，因其蒙福。",shape=box,color=blue];
		j567642433 -> j602975027;
		j567642433 -> j2662177919;
	j340614709 [label="就像主教。他是 Orokin，對不？而他絕對不是一個我會譴責的人。沒有他，就不會成為今天的我。蒙受祝福。",shape=box,color=blue];
		j340614709 -> j360419794;
		j340614709 -> j4290090925;
	j1456214663 [label="Warframe 的製造過程……並不仁慈。我只希望她沒有被困在感染體之中。",shape=box,color=red];
		j1456214663 -> j3219975511;
	j784670490 [label="我覺得無論 Wisp 是誰，她都會很高興認識你。",shape=box,color=red];
		j784670490 -> j2009925566;
	j592802980 [label="我希望他們的靈魂能夠得以安息，但我認為他們某部分的記憶依然留存。",shape=box,color=red];
		j592802980 -> j2729668920;
	j4017408233 [label="完全不會。我相信那些被轉變成 Warframe 的人們，他們的某些部分依然留存於他們的核心結構之中。",shape=box,color=red];
		j4017408233 -> j2724939018;
	j602975027 [label="我有很多事可與他爭論，但我會說，他似乎對於該給誰哪種原型 warframe 血清有很好的直覺。即使我不知道他為什麼這樣做。",shape=box,color=red];
		j602975027 -> j2967746735;
	j2662177919 [label="我希望你不要那麼信任源拓氏。我們不知道他為什麼選擇做他所做的事，他的動機並不明確。",shape=box,color=red];
		j2662177919 -> j1722407835;
	j360419794 [label="我們必須與源拓氏站在一起。我認為我們必須追隨他的腳步。他是我們阻止漠然的唯一機會。",shape=box,color=red];
		j360419794 -> j737842484;
	j4290090925 [label="瑪麗，他是個騙子。他拋棄並傷害他生命中的每個人。他已經拋棄了你，難道你看不出來嗎？",shape=box,color=red];
		j4290090925 -> j1591510439;
