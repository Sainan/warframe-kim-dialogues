		j4144658919 -> j1654989043;
	j2032332260 [label="那個惡魔一直在糾纏我。他和他那些小魔鬼煩死我了！而且全是以你的名義！他說你想討論我幫你讓 Loid 先生上樓的事？",shape=box,color=blue];
		j2032332260 -> j2775877272;
		j2032332260 -> j1654989043;
	j750670901 [label="那個惡魔一直在糾纏我。他和他那些小魔鬼煩死我了！而且全是以你的名義！他說你想再次討論我對主教的承諾？",shape=box,color=blue];
