	j1679187262 [label="我確實想。",shape=box,color=red];
		j1679187262 -> j1682971487;
	j1654989043 [label="他真的這麼說？",shape=box,color=red];
		j1654989043 -> j2486244635;
	j2775877272 [label="我確實想。",shape=box,color=red];
		j2775877272 -> j1318125908;
	j2468175188 [label="我確實想。",shape=box,color=red];
		j2468175188 -> j1760833865;
	j1682971487 [label="我非常抱歉。我知道我冒犯了你。而我不是故意的。相信我，這是我最不想做的事。",shape=box,color=red];
		j1682971487 -> j3889874491;
	j2486244635 [label="（法語）我要殺了他！我就知道那個惡魔滿肚子壞水！我要把他那些徵召來的小魔鬼從哪來踢回哪去！",shape=box,color=blue];
		j2486244635 -> "Chat ends.";
	j1318125908 [label="我不會待太久，因為你不在的時候他已經說服我很多了。而那個惡魔一如既往，為此提出了相當有力的論點。",shape=box,color=blue];
		j1318125908 -> j137155640;
	j1760833865 [label="我不會待太久，因為你不在的時候他已經說服我很多了。而那個惡魔一如既往，為此提出了相當有力的論點。",shape=box,color=blue];
		j1760833865 -> j3346261894;
	j3889874491 [label="而這是為什麼？",shape=box,color=blue];
		j3889874491 -> j4286810148;
		j3889874491 -> j3139080708;
	j137155640 [label="而且我承認我……已經非常厭倦被困在這裡無路可走。",shape=box,color=blue];
		j137155640 -> j4209067344;
	j3346261894 [label="但你應該感謝的不是他的話語，而是他的聰明才智。他讓我和 Loid 先生坐下來談。",shape=box,color=blue];
		j3346261894 -> j1588487158;
		j3346261894 -> j1647996369;
	j4286810148 [label="[表白心意] 瑪麗，這是因為我深深地在乎你。我愛慕你。",shape=box,color=red];
		j4286810148 -> j3230949925;
	j3139080708 [label="算了。這顯然是個錯誤。",shape=box,color=red];
		j3139080708 -> j1615275525;
	j4209067344 [label="所以，我說，好吧。我會協助你。你會得到我的幫助。",shape=box,color=blue];
		j4209067344 -> j3151953893;
	j1588487158 [label="哦？",shape=box,color=red];
		j1588487158 -> j3381456052;
	j1647996369 [label="但 Loid 愛的是阿爾布雷希特。不是嗎？",shape=box,color=red];
		j1647996369 -> j3666082612;
	j3230949925 [label="我就知道我會說錯話。你看，我果然說錯了。",shape=box,color=red];
		j3230949925 -> j787310912;
	j1615275525 [label="你跟他一樣糟糕。",shape=box,color=blue];
