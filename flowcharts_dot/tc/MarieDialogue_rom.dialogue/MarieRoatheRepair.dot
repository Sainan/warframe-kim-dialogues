	j3151953893 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3151953893 -> j2529015854;
	j3381456052 [label="是 Loid 清晰的洞察力讓我能看透自己模糊的視野。因為 Loid 愛主教——他的阿爾布雷希特——但他同時也能看清他所有的缺點。",shape=box,color=blue];
		j3381456052 -> j570483687;
	j3666082612 [label="是的。他愛。但他同時也能看清他所有的缺點。而正是這種清晰的洞察力讓我能看透自己模糊的視野。",shape=box,color=blue];
		j3666082612 -> j570483687;
