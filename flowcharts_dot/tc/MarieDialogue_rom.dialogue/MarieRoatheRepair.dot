		3816 -> 3819 [label="RoatheMarieEntratiDeal, MarieEntratiCompleteC",color=purple];
		3816 -> 3820 [label="false",color=purple];
	3817 [label="漂泊者。那個惡魔一直在糾纏我。他和他那些小魔鬼煩死我了！而且全是以你的名義！他說你只是想屈膝道歉。",shape=box,color=blue];
		3817 -> 3821;
		3817 -> 3822;
	3818 [label="那個惡魔一直在糾纏我。他和他那些小魔鬼煩死我了！而且全是以你的名義！他說你想討論我幫你讓 Loid 先生上樓的事？",shape=box,color=blue];
		3818 -> 3823;
		3818 -> 3824;
	3819 [label="那個惡魔一直在糾纏我。他和他那些小魔鬼煩死我了！而且全是以你的名義！他說你想再次討論我對主教的承諾？",shape=box,color=blue];
		3819 -> 3825;
		3819 -> 3826;
	3820 [label="Chat ends.",color=orange];
	3821 [label="我確實想。",shape=box,color=red];
		3821 -> 3827;
	3822 [label="他真的這麼說？",shape=box,color=red];
		3822 -> 3828;
	3823 [label="我確實想。",shape=box,color=red];
		3823 -> 3829;
	3824 [label="他真的這麼說？",shape=box,color=red];
		3824 -> 3828;
	3825 [label="我確實想。",shape=box,color=red];
		3825 -> 3830;
	3826 [label="他真的這麼說？",shape=box,color=red];
		3826 -> 3828;
	3827 [label="我非常抱歉。我知道我冒犯了你。而我不是故意的。相信我，這是我最不想做的事。",shape=box,color=red];
		3827 -> 3831;
	3828 [label="（法語）我要殺了他！我就知道那個惡魔滿肚子壞水！我要把他那些徵召來的小魔鬼從哪來踢回哪去！",shape=box,color=blue];
		3828 -> 3832;
	3829 [label="我不會待太久，因為你不在的時候他已經說服我很多了。而那個惡魔一如既往，為此提出了相當有力的論點。",shape=box,color=blue];
		3829 -> 3833;
	3830 [label="我不會待太久，因為你不在的時候他已經說服我很多了。而那個惡魔一如既往，為此提出了相當有力的論點。",shape=box,color=blue];
		3830 -> 3834;
	3831 [label="而這是為什麼？",shape=box,color=blue];
		3831 -> 3835;
		3831 -> 3836;
	3832 [label="Chat ends.",color=orange];
	3833 [label="而且我承認我……已經非常厭倦被困在這裡無路可走。",shape=box,color=blue];
		3833 -> 3837;
	3834 [label="但你應該感謝的不是他的話語，而是他的聰明才智。他讓我和 Loid 先生坐下來談。",shape=box,color=blue];
		3834 -> 3838;
		3834 -> 3839;
	3835 [label="[表白心意] 瑪麗，這是因為我深深地在乎你。我愛慕你。",shape=box,color=red];
		3835 -> 3840;
	3836 [label="算了。這顯然是個錯誤。",shape=box,color=red];
		3836 -> 3841;
	3837 [label="所以，我說，好吧。我會協助你。你會得到我的幫助。",shape=box,color=blue];
		3837 -> 3842;
	3838 [label="哦？",shape=box,color=red];
		3838 -> 3843;
	3839 [label="但 Loid 愛的是阿爾布雷希特。不是嗎？",shape=box,color=red];
		3839 -> 3844;
	3840 [label="我就知道我會說錯話。你看，我果然說錯了。",shape=box,color=red];
		3840 -> 3845;
	3841 [label="你跟他一樣糟糕。",shape=box,color=blue];
		3841 -> 3846;
	3842 [label="Update boolean MarieFamilySuccess",color=orange];
		3842 -> 3847;
	3843 [label="是 Loid 清晰的洞察力讓我能看透自己模糊的視野。因為 Loid 愛主教——他的阿爾布雷希特——但他同時也能看清他所有的缺點。",shape=box,color=blue];
		3843 -> 3848;
	3844 [label="是的。他愛。但他同時也能看清他所有的缺點。而正是這種清晰的洞察力讓我能看透自己模糊的視野。",shape=box,color=blue];
		3844 -> 3848;
	3845 [label="我很抱歉我求助於羅瑟來引起你的注意，但我不知道還能找誰。",shape=box,color=red];
		3845 -> 3849;
	3846 [label="Chat ends.",color=orange];
	3847 [label="Update boolean MarieFamilyFail",color=orange];
		3847 -> 3850;
	3848 [label="畢竟，愛一個人意味著什麼，不就是接受他們最好和最壞的一切嗎？",shape=box,color=blue];
		3848 -> 3851;
	3849 [label="哦，漂泊者……我可憐的漂泊者。你不必費這麼大的勁來尋求我的原諒。",shape=box,color=blue];
		3849 -> 3852;
	3850 [label="Chat ends.",color=orange];
	3851 [label="Update boolean MarieEntratiCompleteA",color=orange];
		3851 -> 3853;
	3852 [label="如果你開口問，我早就原諒你了。你在我心中已經有一席之地了，你知道嗎？",shape=box,color=blue];
		3852 -> 3854;
		3852 -> 3855;
	3853 [label="Update boolean MarieEntratiCompleteB",color=orange];
		3853 -> 3856;
	3854 [label="我……有嗎？",shape=box,color=red];
		3854 -> 3857;
	3855 [label="但我費了這麼大的勁……",shape=box,color=red];
		3855 -> 3858;
	3856 [label="Update boolean MarieEntratiCompleteC",color=orange];
		3856 -> 3859;
	3857 [label="有！而且如果你想和我在一起，那麼我也願意。",shape=box,color=blue];
		3857 -> 3860;
		3857 -> 3861;
	3858 [label="那是你自己的錯，不是我的！但如果你想和我在一起，那麼我也願意。",shape=box,color=blue];
		3858 -> 3861;
		3858 -> 3860;
	3859 [label="Chat ends.",color=orange];
	3860 [label="瑪麗，我很樂意。",shape=box,color=red];
		3860 -> 3862;
	3861 [label="再想想，我還是算了。",shape=box,color=red];
		3861 -> 3863;
	3862 [label="啊！你讓我好開心！",shape=box,color=blue];
		3862 -> 3864;
	3863 [label="（法語）我會把你直接扔進虛空。",shape=box,color=blue];
		3863 -> 3865;
	3864 [label="Update boolean MarieDating",color=orange];
		3864 -> 3866;
