	3139 [label="狼！我狼！我見到 Otak 了！我終於見到他了！",shape=box,color=blue];
		3139 -> 3143;
		3139 -> 3144;
	3140 [label="我見到 Otak 了！我終於見到他了！",shape=box,color=blue];
		3140 -> 3143;
		3140 -> 3144;
	3142 [label="狼！我狼！亡骸精靈先生後腦勺上的那張臉！我終於見到他了！",shape=box,color=blue];
		3142 -> 3145;
		3142 -> 3146;
		3142 -> 3147;
	3141 [label="亡骸精靈先生後腦勺上的那張臉！我終於見到他了！",shape=box,color=blue];
		3141 -> 3145;
		3141 -> 3146;
		3141 -> 3147;
	3143 [label="你們的對話進行得怎樣？",shape=box,color=red];
		3143 -> 3148;
	3144 [label="你喜歡和他聊天嗎？",shape=box,color=red];
		3144 -> 3149;
	3145 [label="你見到 Otak 了？天啊……進行得怎樣？",shape=box,color=red];
		3145 -> 3150;
	3146 [label="我很高興你們終於見面了。Otak 有點難以解釋。",shape=box,color=red];
		3146 -> 3151;
	3147 [label="可憐的 Otak……進行得怎樣？",shape=box,color=red];
		3147 -> 3152;
	3148 [label="他……在同一次對話中向我介紹了自己三次，彷彿我們素未謀面。",shape=box,color=blue];
		3148 -> 3153;
	3149 [label="我喜歡。但或許我當下有點想哭。因為他在同一次對話中向我介紹了自己三次，彷彿我們素未謀面。",shape=box,color=blue];
		3149 -> 3153;
	3150 [label="為什麼你聽起來對我見到他並不高興？",shape=box,color=blue];
		3150 -> 3154;
		3150 -> 3155;
		3150 -> 3156;
	3151 [label="是的，我想也是。畫在自動機械背後的孩童塗鴉。我覺得他既可愛又迷人！",shape=box,color=blue];
		3151 -> 3157;
	3152 [label="我覺得他既可愛又迷人！但在幽默感的掩飾下，我感受到了巨大的心碎。",shape=box,color=blue];
		3152 -> 3158;
	3153 [label="他用和之前一樣堅定、愉快的方式跟我打招呼。但他知道我是太陽修女！",shape=box,color=blue];
		3153 -> 3159;
	3154 [label="抱歉。他有時候會惹人心煩。這不是他的錯。",shape=box,color=red];
		3154 -> 3160;
	3155 [label="我不是故意的。他對某些人來說可能只是有點……令人不快。",shape=box,color=red];
		3155 -> 3160;
	3156 [label="他有時候會惹我心煩，就這樣。",shape=box,color=red];
		3156 -> 3161;
	3157 [label="但在幽默感的掩飾下，卻隱藏著巨大的心碎。",shape=box,color=blue];
		3157 -> 3158;
	3158 [label="你能告訴我可憐的 Otak 先生的故事嗎？",shape=box,color=blue];
		3158 -> 3162;
	3159 [label="確實，他對聖光者很了解！我們詳細討論了他所謂在「Orokin 帝國之前的時代」的「古老宗教」。",shape=box,color=blue];
		3159 -> 3163;
	3160 [label="我希望他們能對他表現出善意和耐心。但靠著日尊的恩典，我們才能走到今天。",shape=box,color=blue];
		3160 -> 3164;
	3161 [label="我希望你能對一個明顯虛弱的人更加友善。畢竟，我們都是靠著日尊的恩典，才能走到今天。",shape=box,color=blue];
		3161 -> 3164;
	3162 [label="Otak 曾經是名哲士、Orokin 科學家，也是學者。發生在他身上的事算不上什麼愉快的故事。",shape=box,color=red];
		3162 -> 3165;
	3163 [label="雖然他說那些知識現在大多遺失了，深藏在檔案庫中，而且絕對禁止查閱。他要我發誓保密。",shape=box,color=blue];
		3163 -> 3166;
	3164 [label="這樣的命運可能等待著我們任何人。甚至是你。",shape=box,color=blue];
		3164 -> 3167;
		3164 -> 3168;
	3165 [label="據傳他是個天才，也是開發利用氬結晶體的幕後主腦。",shape=box,color=red];
		3165 -> 3169;
	3166 [label="他告訴我，他非常擔心執行者 Ballas——無論他是誰——可能會發現我這個異端教派，然後處決我。",shape=box,color=blue];
		3166 -> 3170;
		3166 -> 3171;
	3167 [label="我只是沒有時間花在他身上，抱歉。",shape=box,color=red];
		3167 -> 3172;
	3168 [label="你說得對，抱歉。我不是那個意思。",shape=box,color=red];
		3168 -> 3158;
	3169 [label="這些結晶獲取自虛空──它們是我們能夠製造許多強大 warframe 和武器的原因。",shape=box,color=red];
		3169 -> 3173;
	3170 [label="這種事……不會發生。繼續說。",shape=box,color=red];
		3170 -> 3174;
	3171 [label="Ballas 已經死了……繼續講。",shape=box,color=red];
		3171 -> 3174;
	3172 [label="那我很抱歉浪費了你更多時間。",shape=box,color=blue];
		3172 -> 3175;
	3173 [label="他專攻晶體學。而他的作品歸檔於這裡的實驗室。",shape=box,color=red];
		3173 -> 3176;
	3174 [label="+5 Chemistry",color=orange];
		3174 -> 3177;
	3175 [label="Update boolean MarieOtakComplete",color=orange];
		3175 -> 3178;
	3176 [label="出於某種原因，我不知道為什麼，他被轉變成中樞，並獲得了自己的亡骸精靈外殼。",shape=box,color=red];
		3176 -> 3179;
	3177 [label="我當下也是這麼認為……嗯，他問我來自哪裡，當我告訴他時，他笑了，說「不，絕不可能！這我應該知道，因為我是──」",shape=box,color=blue];
		3177 -> 3180;
	3178 [label="Chat ends.",color=orange];
	3179 [label="並非所有中樞都是作為懲罰而製造的。但火衛二上的事……變得很糟，他受到了嚴重的損壞。",shape=box,color=red];
		3179 -> 3181;
	3180 [label="然後他……又再次向我介紹了自己。還問我是不是帶著礦物樣本從平野過來的……",shape=box,color=blue];
		3180 -> 3182;
		3180 -> 3183;
	3181 [label="（法語）可憐東西……",shape=box,color=blue];
		3181 -> 3184;
	3182 [label="哦，瑪麗。我很抱歉……",shape=box,color=red];
		3182 -> 3185;
	3183 [label="是啊……那就是 Otak。",shape=box,color=red];
		3183 -> 3185;
	3184 [label="Update boolean MarieOtak1",color=orange];
		3184 -> 3143;
		3184 -> 3144;
	3185 [label="一想到無法為他做任何事，我的心就碎成千萬片。",shape=box,color=blue];
