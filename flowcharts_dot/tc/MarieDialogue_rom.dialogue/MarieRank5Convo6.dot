		j3097375491 -> j390507128 [label=true,color=green];
		j3097375491 -> j3117188491 [label=false,color=brown];
	j1531716415 [label="狼！我狼！我見到 Otak 了！我終於見到他了！",shape=box,color=blue];
		j1531716415 -> j2566252596;
		j1531716415 -> j2637180428;
	j1754392999 [label="我見到 Otak 了！我終於見到他了！",shape=box,color=blue];
		j1754392999 -> j2566252596;
		j1754392999 -> j2637180428;
	j390507128 [label="狼！我狼！亡骸精靈先生後腦勺上的那張臉！我終於見到他了！",shape=box,color=blue];
		j390507128 -> j1058643837;
		j390507128 -> j3392306625;
		j390507128 -> j2833167865;
	j3117188491 [label="亡骸精靈先生後腦勺上的那張臉！我終於見到他了！",shape=box,color=blue];
		j3117188491 -> j1058643837;
		j3117188491 -> j3392306625;
		j3117188491 -> j2833167865;
	j2566252596 [label="你們的對話進行得怎樣？",shape=box,color=red];
		j2566252596 -> j2795558412;
	j2637180428 [label="你喜歡和他聊天嗎？",shape=box,color=red];
		j2637180428 -> j555476768;
	j1058643837 [label="你見到 Otak 了？天啊……進行得怎樣？",shape=box,color=red];
		j1058643837 -> j2882680278;
	j3392306625 [label="我很高興你們終於見面了。Otak 有點難以解釋。",shape=box,color=red];
		j3392306625 -> j1740050470;
	j2833167865 [label="可憐的 Otak……進行得怎樣？",shape=box,color=red];
		j2833167865 -> j2025877465;
	j2795558412 [label="他……在同一次對話中向我介紹了自己三次，彷彿我們素未謀面。",shape=box,color=blue];
		j2795558412 -> j3611132442;
	j555476768 [label="我喜歡。但或許我當下有點想哭。因為他在同一次對話中向我介紹了自己三次，彷彿我們素未謀面。",shape=box,color=blue];
		j555476768 -> j3611132442;
	j2882680278 [label="為什麼你聽起來對我見到他並不高興？",shape=box,color=blue];
		j2882680278 -> j4046870895;
		j2882680278 -> j3037431698;
		j2882680278 -> j73845942;
	j1740050470 [label="是的，我想也是。畫在自動機械背後的孩童塗鴉。我覺得他既可愛又迷人！",shape=box,color=blue];
		j1740050470 -> j1778760793;
	j2025877465 [label="我覺得他既可愛又迷人！但在幽默感的掩飾下，我感受到了巨大的心碎。",shape=box,color=blue];
		j2025877465 -> j3511312525;
	j3611132442 [label="他用和之前一樣堅定、愉快的方式跟我打招呼。但他知道我是太陽修女！",shape=box,color=blue];
		j3611132442 -> j1585660924;
	j4046870895 [label="抱歉。他有時候會惹人心煩。這不是他的錯。",shape=box,color=red];
		j4046870895 -> j2403602116;
	j3037431698 [label="我不是故意的。他對某些人來說可能只是有點……令人不快。",shape=box,color=red];
		j3037431698 -> j2403602116;
	j73845942 [label="他有時候會惹我心煩，就這樣。",shape=box,color=red];
		j73845942 -> j1952743270;
	j1778760793 [label="但在幽默感的掩飾下，卻隱藏著巨大的心碎。",shape=box,color=blue];
		j1778760793 -> j3511312525;
	j3511312525 [label="你能告訴我可憐的 Otak 先生的故事嗎？",shape=box,color=blue];
		j3511312525 -> j2486253530;
	j1585660924 [label="確實，他對聖光者很了解！我們詳細討論了他所謂在「Orokin 帝國之前的時代」的「古老宗教」。",shape=box,color=blue];
		j1585660924 -> j4196492395;
	j2403602116 [label="我希望他們能對他表現出善意和耐心。但靠著日尊的恩典，我們才能走到今天。",shape=box,color=blue];
		j2403602116 -> j4094426240;
	j1952743270 [label="我希望你能對一個明顯虛弱的人更加友善。畢竟，我們都是靠著日尊的恩典，才能走到今天。",shape=box,color=blue];
		j1952743270 -> j4094426240;
	j2486253530 [label="Otak 曾經是名哲士、Orokin 科學家，也是學者。發生在他身上的事算不上什麼愉快的故事。",shape=box,color=red];
		j2486253530 -> j724963450;
	j4196492395 [label="雖然他說那些知識現在大多遺失了，深藏在檔案庫中，而且絕對禁止查閱。他要我發誓保密。",shape=box,color=blue];
		j4196492395 -> j2881493135;
	j4094426240 [label="這樣的命運可能等待著我們任何人。甚至是你。",shape=box,color=blue];
		j4094426240 -> j3670582447;
		j4094426240 -> j1823211463;
	j724963450 [label="據傳他是個天才，也是開發利用氬結晶體的幕後主腦。",shape=box,color=red];
		j724963450 -> j192244517;
	j2881493135 [label="他告訴我，他非常擔心執行者 Ballas——無論他是誰——可能會發現我這個異端教派，然後處決我。",shape=box,color=blue];
		j2881493135 -> j428406514;
		j2881493135 -> j3615750756;
	j3670582447 [label="我只是沒有時間花在他身上，抱歉。",shape=box,color=red];
		j3670582447 -> j4293978803;
	j1823211463 [label="你說得對，抱歉。我不是那個意思。",shape=box,color=red];
		j1823211463 -> j3511312525;
	j192244517 [label="這些結晶獲取自虛空──它們是我們能夠製造許多強大 warframe 和武器的原因。",shape=box,color=red];
		j192244517 -> j4127661560;
	j428406514 [label="這種事……不會發生。繼續說。",shape=box,color=red];
		j428406514 -> j3728135559;
	j3615750756 [label="Ballas 已經死了……繼續講。",shape=box,color=red];
		j3615750756 -> j3728135559;
	j4293978803 [label="那我很抱歉浪費了你更多時間。",shape=box,color=blue];
		j4293978803 -> j3007723528;
	j4127661560 [label="他專攻晶體學。而他的作品歸檔於這裡的實驗室。",shape=box,color=red];
		j4127661560 -> j241865606;
	j3728135559 [label="+5 Chemistry",color=orange];
		j3728135559 -> j3463304547;
	j3007723528 [label="Boolean MarieOtakComplete is now true.",color=orange];
		j3007723528 -> "Chat ends.";
	j241865606 [label="出於某種原因，我不知道為什麼，他被轉變成中樞，並獲得了自己的亡骸精靈外殼。",shape=box,color=red];
		j241865606 -> j2463161510;
	j3463304547 [label="我當下也是這麼認為……嗯，他問我來自哪裡，當我告訴他時，他笑了，說「不，絕不可能！這我應該知道，因為我是──」",shape=box,color=blue];
		j3463304547 -> j3955668631;
	j2463161510 [label="並非所有中樞都是作為懲罰而製造的。但火衛二上的事……變得很糟，他受到了嚴重的損壞。",shape=box,color=red];
		j2463161510 -> j328986173;
	j3955668631 [label="然後他……又再次向我介紹了自己。還問我是不是帶著礦物樣本從平野過來的……",shape=box,color=blue];
		j3955668631 -> j2436451142;
		j3955668631 -> j1396815675;
	j328986173 [label="（法語）可憐東西……",shape=box,color=blue];
		j328986173 -> j1698645168;
	j2436451142 [label="哦，瑪麗。我很抱歉……",shape=box,color=red];
		j2436451142 -> j2055537047;
	j1396815675 [label="是啊……那就是 Otak。",shape=box,color=red];
		j1396815675 -> j2055537047;
	j1698645168 [label="Boolean MarieOtak1 is now true.",color=orange];
		j1698645168 -> j2566252596;
		j1698645168 -> j2637180428;
	j2055537047 [label="一想到無法為他做任何事，我的心就碎成千萬片。",shape=box,color=blue];
		j2055537047 -> j1970966774;
	j1970966774 [label="Evaluate expressions",color=orange];
		j1970966774 -> j2936127143 [label="MarieCephalonSoul",color=purple];
		j1970966774 -> j3413345018 [label="MarieCephalonNoSoul",color=purple];
		j1970966774 -> j3874829471 [label="MarieCephalonUnsure",color=purple];
		j1970966774 -> j2948394037 [label="false",color=purple];
	j2936127143 [label="哦，聖光者啊，你們給他製造了什麼樣的地獄，把他的靈魂囚禁在那個由科學和閃光組成的牢籠裡？",shape=box,color=blue];
		j2936127143 -> j2599418674;
	j3413345018 [label="我只能向聖光者祈禱，希望你是對的，那個外殼裡剩下的只是……只是科學和閃光。",shape=box,color=blue];
		j3413345018 -> j1115218345;
	j3874829471 [label="我知道你不確定中樞是否包含靈魂，但我只能向聖光者祈禱……希望可憐的 Otak 不會受苦。",shape=box,color=blue];
		j3874829471 -> j2280369348;
	j2948394037 [label="我只能向聖光者祈禱，希望那個外殼裡剩下的只是……只是科學和閃光。",shape=box,color=blue];
		j2948394037 -> j974709779;
	j2599418674 [label="為什麼讓他留在那裡，破碎地等待著被允許死去才得以安寧？我只能祈禱……如果那裡有某種存在──",shape=box,color=blue];
		j2599418674 -> j2327767138;
	j1115218345 [label="而且沒有靈魂被困在那個破碎的東西裡，等待著被允許死去才得以安寧。",shape=box,color=blue];
		j1115218345 -> j1785925792;
	j2280369348 [label="沒有靈魂被困在那個破碎的東西裡，等待著被允許死去才得以安寧。",shape=box,color=blue];
		j2280369348 -> j3905776809;
	j974709779 [label="而且沒有靈魂被困在那個破碎的東西裡，等待著被允許死去才得以安寧。",shape=box,color=blue];
		j974709779 -> j3905776809;
	j2327767138 [label="是因為他自願留下來進行某種孤獨的守望……",shape=box,color=blue];
		j2327767138 -> j3522344359;
	j1785925792 [label="因為如果你錯了，而有個靈魂違背自己的意願留在那個牢籠裡呢？",shape=box,color=blue];
		j1785925792 -> j2410877936;
	j3905776809 [label="或者如果那裡有某種存在，那是因為他自願留下來進行某種孤獨的守望。",shape=box,color=blue];
		j3905776809 -> j3522344359;
	j3522344359 [label="否則持相反觀點，豈不足以讓人質疑諸神的仁慈，對不？",shape=box,color=blue];
		j3522344359 -> j2108810567;
	j2410877936 [label="豈不足以讓人質疑神明的仁慈，對不？",shape=box,color=blue];
		j2410877936 -> j2108810567;
	j2108810567 [label="那我又該怎麼辦呢？",shape=box,color=blue];
		j2108810567 -> j3908367118;
	j3908367118 [label="請原諒我，我今天……我今天心情好鬱悶。",shape=box,color=blue];
		j3908367118 -> j4190999030;
	j4190999030 [label="Evaluate expressions",color=orange];
		j4190999030 -> j2850233404 [label="MarieRoathePastry1",color=purple];
