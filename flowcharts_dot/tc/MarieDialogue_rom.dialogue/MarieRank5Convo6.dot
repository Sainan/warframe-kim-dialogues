		j4190999030 -> j2850233404 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j1801643359 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j1570593125 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j4217106747 [label="RoatheMariePastry1",color=purple];
		j4190999030 -> j2850233404 [label="false",color=purple];
		j4190999030 -> j1570593125 [label="false",color=purple];
		j4190999030 -> j4217106747 [label="false",color=purple];
	j2850233404 [label="我能做什麼來讓你開心起來嗎？比如，我們可以去折磨羅瑟。",shape=box,color=red];
		j2850233404 -> j887563151;
	j1801643359 [label="有什麼我能做的讓你開心起來嗎？也許我們可以去偷些糕點？",shape=box,color=red];
		j1801643359 -> j944691548;
	j1570593125 [label="瑪麗，有時候神明是很殘忍的。這就是人生。",shape=box,color=red];
		j1570593125 -> j99050272;
	j4217106747 [label="沒關係。你有充分的理由感到難過。",shape=box,color=red];
		j4217106747 -> j1754965131;
	j887563151 [label="+15 Chemistry",color=orange];
		j887563151 -> j464385035;
	j944691548 [label="+20 Chemistry",color=orange];
		j944691548 -> j464385035;
	j99050272 [label="+5 Chemistry",color=orange];
		j99050272 -> j1101995321;
	j1754965131 [label="+20 Chemistry",color=orange];
		j1754965131 -> j2491361762;
	j464385035 [label="哈！謝謝。這肯定能止住我這些愚蠢的眼淚。你確實知道怎麼哄傻裡傻氣的小瑪麗開心，對不？",shape=box,color=blue];
		j464385035 -> j654855239;
		j464385035 -> j446290537;
	j1101995321 [label="對。你說得對。衪們是殘酷的。世界上充滿了像 Otak 先生這樣的故事，而且有許多比他的還要悲慘。我不應該為一個故事哭泣。",shape=box,color=blue];
		j1101995321 -> j2055916524;
	j2491361762 [label="謝謝。好吧，我不想再感到鬱悶了。我要去做些更開心的事！我想費波那契先生的魚缸該清理了。",shape=box,color=blue];
		j2491361762 -> j2425134241;
	j654855239 [label="你一點也不愚蠢。我有同樣的感受。",shape=box,color=red];
		j654855239 -> j2235898819;
	j446290537 [label="這是我最起碼能為你做的事。",shape=box,color=red];
		j446290537 -> j2235898819;
	j2055916524 [label="然而我卻坐在這裡，正在做這件事。謝謝你提醒我自己有多愚蠢。哼！傻裡傻氣的小瑪麗。好吧……我想費波那契先生的魚缸該清理了。",shape=box,color=blue];
		j2055916524 -> j2425134241;
