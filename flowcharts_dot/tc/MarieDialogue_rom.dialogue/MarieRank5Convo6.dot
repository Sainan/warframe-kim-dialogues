		3186 -> 3187 [label="false",color=purple];
	3190 [label="哦，聖光者啊，你們給他製造了什麼樣的地獄，把他的靈魂囚禁在那個由科學和閃光組成的牢籠裡？",shape=box,color=blue];
		3190 -> 3194;
	3189 [label="我只能向聖光者祈禱，希望你是對的，那個外殼裡剩下的只是……只是科學和閃光。",shape=box,color=blue];
		3189 -> 3193;
	3188 [label="我知道你不確定中樞是否包含靈魂，但我只能向聖光者祈禱……希望可憐的 Otak 不會受苦。",shape=box,color=blue];
		3188 -> 3192;
	3187 [label="我只能向聖光者祈禱，希望那個外殼裡剩下的只是……只是科學和閃光。",shape=box,color=blue];
		3187 -> 3191;
	3194 [label="為什麼讓他留在那裡，破碎地等待著被允許死去才得以安寧？我只能祈禱……如果那裡有某種存在──",shape=box,color=blue];
		3194 -> 3197;
	3193 [label="而且沒有靈魂被困在那個破碎的東西裡，等待著被允許死去才得以安寧。",shape=box,color=blue];
		3193 -> 3196;
	3192 [label="沒有靈魂被困在那個破碎的東西裡，等待著被允許死去才得以安寧。",shape=box,color=blue];
		3192 -> 3195;
	3191 [label="而且沒有靈魂被困在那個破碎的東西裡，等待著被允許死去才得以安寧。",shape=box,color=blue];
		3191 -> 3195;
	3197 [label="是因為他自願留下來進行某種孤獨的守望……",shape=box,color=blue];
		3197 -> 3200;
	3196 [label="因為如果你錯了，而有個靈魂違背自己的意願留在那個牢籠裡呢？",shape=box,color=blue];
		3196 -> 3199;
	3195 [label="或者如果那裡有某種存在，那是因為他自願留下來進行某種孤獨的守望。",shape=box,color=blue];
		3195 -> 3198;
	3200 [label="否則持相反觀點，豈不足以讓人質疑諸神的仁慈，對不？",shape=box,color=blue];
		3200 -> 3201;
	3199 [label="豈不足以讓人質疑神明的仁慈，對不？",shape=box,color=blue];
		3199 -> 3201;
	3198 [label="否則持相反觀點，豈不足以讓人質疑諸神的仁慈，對不？",shape=box,color=blue];
		3198 -> 3201;
	3201 [label="那我又該怎麼辦呢？",shape=box,color=blue];
		3201 -> 3202;
	3202 [label="請原諒我，我今天……我今天心情好鬱悶。",shape=box,color=blue];
