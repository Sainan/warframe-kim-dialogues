		3203 -> 3207 [label="false",color=purple];
	3204 [label="我能做什麼來讓你開心起來嗎？比如，我們可以去折磨羅瑟。",shape=box,color=red];
		3204 -> 3208;
	3205 [label="有什麼我能做的讓你開心起來嗎？也許我們可以去偷些糕點？",shape=box,color=red];
		3205 -> 3209;
	3206 [label="瑪麗，有時候神明是很殘忍的。這就是人生。",shape=box,color=red];
		3206 -> 3210;
	3207 [label="沒關係。你有充分的理由感到難過。",shape=box,color=red];
		3207 -> 3211;
	3208 [label="+15 Chemistry",color=orange];
		3208 -> 3212;
	3209 [label="+20 Chemistry",color=orange];
		3209 -> 3212;
	3210 [label="+5 Chemistry",color=orange];
		3210 -> 3213;
	3211 [label="+20 Chemistry",color=orange];
		3211 -> 3214;
	3212 [label="哈！謝謝。這肯定能止住我這些愚蠢的眼淚。你確實知道怎麼哄傻裡傻氣的小瑪麗開心，對不？",shape=box,color=blue];
		3212 -> 3215;
		3212 -> 3216;
	3213 [label="對。你說得對。衪們是殘酷的。世界上充滿了像 Otak 先生這樣的故事，而且有許多比他的還要悲慘。我不應該為一個故事哭泣。",shape=box,color=blue];
		3213 -> 3217;
	3214 [label="謝謝。好吧，我不想再感到鬱悶了。我要去做些更開心的事！我想費波那契先生的魚缸該清理了。",shape=box,color=blue];
		3214 -> 3218;
	3215 [label="你一點也不愚蠢。我有同樣的感受。",shape=box,color=red];
		3215 -> 3219;
	3216 [label="這是我最起碼能為你做的事。",shape=box,color=red];
		3216 -> 3219;
	3217 [label="然而我卻坐在這裡，正在做這件事。謝謝你提醒我自己有多愚蠢。哼！傻裡傻氣的小瑪麗。好吧……我想費波那契先生的魚缸該清理了。",shape=box,color=blue];
		3217 -> 3218;
