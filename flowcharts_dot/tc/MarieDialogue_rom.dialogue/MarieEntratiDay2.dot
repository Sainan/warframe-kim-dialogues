		2661 -> 2674 [label="false",color=purple];
	2662 [label="而且我想，你還有很多善意可以施予我的里昂，甚至施予……那個惡魔……",shape=box,color=blue];
		2662 -> 2675;
		2662 -> 2676;
	2652 [label="的確，我仍然希望看到 Loid 先生能與樓上那些人團圓。我也希望為主教剩餘的家人帶來慰藉，而你正是通往這一切的關鍵！",shape=box,color=blue];
		2652 -> 2662;
	2663 [label="+10 Chemistry",color=orange];
		2663 -> 2677;
	2664 [label="要知道，當一個人「贏」了的時候，保持風度還是很重要的。",shape=box,color=blue];
		2664 -> 2678;
		2664 -> 2679;
	2665 [label="當他的道路上只剩下破碎的生命和心靈時，還能留下什麼「更大的善」？",shape=box,color=blue];
		2665 -> 2645;
	2666 [label="不。他不是我的父親。因為我的父親在我小時候就把我拋棄在街頭，而主教從未做過如此殘忍的事。",shape=box,color=blue];
		2666 -> 2680;
	2667 [label="許多悲劇都是在一時激情犯下的。事情往往就是如此。",shape=box,color=blue];
		2667 -> 2681;
	2668 [label="我想我已經知道你要說什麼了。",shape=box,color=red];
		2668 -> 2682;
	2669 [label="瑪麗，我不會看不起你。我保證。",shape=box,color=red];
		2669 -> 2683;
	2670 [label="如果可以的話，我們……先談完關於主教的對話，我心碎的事先暫且不談，好嗎？",shape=box,color=blue];
		2670 -> 2684;
	2671 [label="的確，我怎麼能把你推開，當你已經向我表白了你的心意。",shape=box,color=blue];
		2671 -> 2685;
	2672 [label="的確，我怎麼能把你推開，當你已經向我表白了你對我們親愛的里昂的心意？你能為他帶來如此平靜……如此慰藉……",shape=box,color=blue];
		2672 -> 2685;
	2673 [label="的確，我怎麼能把你推開，當你似乎對惡魔情有獨鍾？我不理解你的品味，但……看來你會待在我們身邊，對不？",shape=box,color=blue];
		2673 -> 2685;
	2674 [label="我不想失去你這個夥伴。我們能不能先把這一切放到一邊，就算彼此意見不合，也還是可以繼續走下去，好嗎？",shape=box,color=blue];
		2674 -> 2686;
		2674 -> 2687;
	2675 [label="瑪麗，等一下。拜託。讓我道歉。",shape=box,color=red];
		2675 -> 2688;
	2676 [label="老實說，我並不覺得自己對你說的話很重要，我並沒有想到這對你來說有那麼重要。",shape=box,color=red];
		2676 -> 2688;
	2677 [label="我對此的感激，遠超過你所能想像，謝謝。",shape=box,color=blue];
		2677 -> 2689;
	2678 [label="我只是在逗你玩。",shape=box,color=red];
