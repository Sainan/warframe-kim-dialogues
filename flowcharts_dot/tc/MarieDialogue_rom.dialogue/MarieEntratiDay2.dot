	2738 [label="（法語）再見。",shape=box,color=blue];
		2738 -> 2744;
	2739 [label="[表白心意] 瑪麗，你不是傻瓜。你一點也不傻。如果說這證明了什麼，那正好證明了你其實有多美好。",shape=box,color=red];
		2739 -> 2745;
	2740 [label="而你在向我的靈魂弟兄表白你的愛的同時，還對我說這些話？！你是打算把我們倆都當傻瓜耍嗎？！",shape=box,color=blue];
		2740 -> 2746;
	2741 [label="而你在和惡魔鬼混的同時，還對我說這些話？！你是打算把我們倆都當傻瓜耍嗎？！",shape=box,color=blue];
		2741 -> 2746;
	2742 [label="我……哦，心肝。我的心肝！哦，我也有同樣的感受！但我不敢說出口，我不敢寫信給你──因為我覺得自己那樣做很傻。",shape=box,color=blue];
		2742 -> 2747;
	2743 [label="是的，正如你所說，如今我已看得一清二楚。我……也只能再次感謝你的耐心。",shape=box,color=blue];
		2743 -> 2748;
	2744 [label="Update boolean MarieNoDate",color=orange];
		2744 -> 2749;
	2745 [label="瑪麗，你對我變得如此重要……而我很抱歉這次對話演變成這樣。",shape=box,color=red];
		2745 -> 2750;
	2746 [label="Update boolean DrifterMarieWhoops",color=orange];
		2746 -> 2751;
	2747 [label="啊！你讓我好開心！我很好奇……你聽到這個回應會打算怎麼做呢？",shape=box,color=blue];
		2747 -> 2752;
		2747 -> 2753;
	2748 [label="在我拼命想抓住那個已經不在的父親時，我差點把仍在身邊的家人給推開了。",shape=box,color=blue];
		2748 -> 2754;
	2749 [label="Update boolean MarieEntratiCompleteB",color=orange];
		2749 -> 3890;
	2750 [label="但我需要讓你明白，源拓氏是個很複雜的人，他也同樣可以傷害你。我不想讓你以後受到更嚴重的傷害。",shape=box,color=red];
		2750 -> 2756;
	2751 [label="Update boolean MarieNoDate",color=orange];
		2751 -> 2757;
	2752 [label="[提出邀約] 嗯，我在想……你是否願意，嗯……成為一對情侶？",shape=box,color=red];
		2752 -> 2758;
	2753 [label="我想我們可以慢慢來。我們還在了解彼此。",shape=box,color=red];
		2753 -> 2759;
	2754 [label="而我想我不是唯一一個，對不？我想……我現在已經做好準備幫助我們面對樓上那些人的問題了，對不？",shape=box,color=blue];
		2754 -> 2760;
