		2734 -> 2741 [label="RoatheDating",color=purple];
		2734 -> 2742 [label="false",color=purple];
	2735 [label="不，他對你很好。那不是謊話。但這並不代表那就是他的全部為人，也不代表那就是他所能做的一切。",shape=box,color=red];
		2735 -> 2743;
