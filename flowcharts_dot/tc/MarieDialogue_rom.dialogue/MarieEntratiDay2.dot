digraph {
	2615 [label="MarieEntratiDay2 begins.",color=orange];
		2615 -> 2616;
	2616 [label="漂泊者。我花了些時間思考並……讓自己冷靜下來。我有個嚴格的原則，就是在我憤怒之時不會與任何人進行對話。",shape=box,color=blue];
		2616 -> 2617;
	2617 [label="Evaluate expressions",color=orange];
		2617 -> 2618 [label="MarieEntrati5a",color=purple];
		2617 -> 2619 [label="MarieEntrati5b",color=purple];
		2617 -> 2620 [label="MarieEntrati5c",color=purple];
		2617 -> 2621 [label="MarieEntrati5d",color=purple];
		2617 -> 2622 [label="MarieEntrati5e",color=purple];
		2617 -> 2623 [label="MarieEntrati5f",color=purple];
		2617 -> 2624 [label="MarieEntrati5g",color=purple];
		2617 -> 2625 [label="MarieEntrati5h",color=purple];
		2617 -> 2626 [label="MarieEntrati5i",color=purple];
		2617 -> 2627 [label="false",color=purple];
	2618 [label="你昨天說的話就像……在我肋間插了一刀。沒錯，我承認我離開是因為感到憤怒，但同時也感到厭惡。不是對你，而是對我自己。",shape=box,color=blue];
		2618 -> 2628;
	2619 [label="但在我們繼續之前，我必須先說一件事，那就是你對我說話的語氣。我知道你一定把我當小孩。你已經活了好幾個世紀了，甚至還更久。",shape=box,color=blue];
		2619 -> 2629;
	2620 [label="我花了很多時間思考你的話。這不是聖戰，而主教的手段一直都很有操縱性。",shape=box,color=blue];
		2620 -> 2630;
	2621 [label="當然，你問我太陽經文哪裡提到無辜者是可被犧牲的這個問題是對的。經文裡沒有寫到。",shape=box,color=blue];
		2621 -> 2631;
	2622 [label="在我們繼續之前，我必須先說一件事，那就是你竟然在爭論中利用我的信仰來對付我，而你自己卻不信奉任何信仰。",shape=box,color=blue];
		2622 -> 2632;
	2623 [label="我……很抱歉昨天匆匆結束了我們的對話。那實在太超過了。不過在我們繼續之前，我必須問你，你當時說的都是真心話嗎？還是你只是想操縱我的感情來避免一場不愉快的爭論？",shape=box,color=blue];
		2623 -> 2633;
		2623 -> 2634;
	2624 [label="看來我們在主教的問題上陷入了僵局，對不？你把他視為怪物，而我，把他視為聖人。",shape=box,color=blue];
		2624 -> 2635;
	2625 [label="如果你願意的話，我想和你談談你為了博取我的好感而選擇站在源拓氏這邊的決定。",shape=box,color=blue];
		2625 -> 2636;
	2626 [label="如果你願意的話，我現在想和你談談你的謊言。",shape=box,color=blue];
		2626 -> 2636;
	2627 [label="Chat ends.",color=orange];
	2628 [label="你出手如此致命精準，我又怎會感到意外？竟然把我的話，與惡魔的話相提並論……",shape=box,color=blue];
		2628 -> 2637;
	2629 [label="你穿越過未知的維度，穿越過虛空本身。與諸神和天使戰鬥過。那麼在你眼中，我又算什麼呢，對不？不過就是傻裡傻氣的小瑪麗罷了。",shape=box,color=blue];
		2629 -> 2638;
	2630 [label="而我相信……是的，你說得對。這不是聖戰。因為根本沒有聖戰這回事。戰爭從來都不神聖、不公正、不正義。痛苦永遠不該成為指路明燈。",shape=box,color=blue];
		2630 -> 2639;
	2631 [label="戰爭從來都不神聖、不公正、不正義。痛苦永遠不該成為指路明燈。",shape=box,color=blue];
		2631 -> 2639;
	2632 [label="漂泊者，這樣就太虛偽了，既殘酷又無效。這只是一種想要「贏下」對話的手段，也不符合一個人應有的行為分寸。",shape=box,color=blue];
		2632 -> 2640;
	2633 [label="我是真心的。如果我的時機……不對，我很抱歉。我深深在乎你，瑪麗……",shape=box,color=red];
		2633 -> 2641;
	2634 [label="我不是真心的，我只是……一時衝動。我很抱歉。是當下情緒太過激動了。",shape=box,color=red];
		2634 -> 2642;
	2635 [label="然而……我不希望我們之間就這樣收場。你是個善良的靈魂，而我們之間有太多我不想就此變質的事。",shape=box,color=blue];
		2635 -> 2946;
	2636 [label="試圖操弄情況來控制我的感受……既虛偽又殘酷。漂泊者，我承認我確實很想因此而恨你。",shape=box,color=blue];
		2636 -> 2644;
	2637 [label="我本以為自己是個對世界和所有人都敞開心胸的人。而你精確地，用一支帶刺的箭，就證明我錯了。",shape=box,color=blue];
		2637 -> 2645;
	2638 [label="一方面，我理解這點。也表示同情。我們兩個當時都在氣頭上。但另一方面，我希望你能更優雅和得體地來對待我，而不是像之前那樣。",shape=box,color=blue];
		2638 -> 2646;
	2639 [label="甚至我們現在所做的事，摧毀喃喃者並對抗你的眾多敵人，也不是聖光者的道路。",shape=box,color=blue];
		2639 -> 2647;
	2640 [label="信仰不是，也永遠不該是，用來對付他人的武器。它是盾牌。黑暗中的光。指引道路的聲音。",shape=box,color=blue];
		2640 -> 2648;
	2641 [label="在我面對……面對這個龐大的問題之前，請允許我先解釋一下關於主教的事。",shape=box,color=blue];
		2641 -> 2649;
	2642 [label="Update boolean DrifterMarie",color=orange];
		2642 -> 2650;
	2946 [label="Check boolean LoidFamilyComplete",color=orange];
		2946 -> 2651 [label=true,color=green];
		2946 -> 2643 [label=false,color=brown];
	2644 [label="然而……我不希望我們之間就這樣收場。我們之間有太多我不想就此變質的事。",shape=box,color=blue];
		2644 -> 1395;
	2645 [label="我想我是來道歉的，來說我為如此愚蠢地固執感到深深抱歉。我希望你能理解。",shape=box,color=blue];
		2645 -> 2653;
		2645 -> 2654;
	2646 [label="因為我曾流落街頭。我一生中的每一天都活在肉體的折磨之中。我經歷過心碎，經歷過愛，經歷過恐懼與拒絕。我經歷過生命與失去。",shape=box,color=blue];
		2646 -> 2655;
	2647 [label="儘管舉起劍也許是必要的，以免世間被他們的同類淹沒，但這種行為不該被推崇。而且當無辜者在過程中受到傷害時，這當然更不可被原諒。",shape=box,color=blue];
		2647 -> 2656;
	2648 [label="而你試圖用它來對付我，只是為了「擊敗」我？這是個懦弱的策略。但我們兩個當時都在氣頭上，如果你能原諒我在憤怒中說的話，我會……原諒你。",shape=box,color=blue];
		2648 -> 2657;
		2648 -> 2658;
	2649 [label="我想，對我來說很難放棄幫主教辯護……我花了一些時間才明白為什麼我無法放開他。",shape=box,color=blue];
		2649 -> 2659;
	2650 [label="不，我理解……有多少謀殺是因為「激情」而犯下的，對不？當然也有同樣多的孩子是在激情的瞬間被創造出來的。",shape=box,color=blue];
		2650 -> 2660;
	2651 [label="而你在如此短的時間內對我變得如此重要……我發現我們的對話是如此愉快。",shape=box,color=blue];
		2651 -> 2661;
	2643 [label="的確，我仍然希望看到 Loid 先生能與樓上那些人團圓。我也希望為主教剩餘的家人帶來慰藉，而你正是通往這一切的關鍵！",shape=box,color=blue];
		2643 -> 2651;
	1395 [label="Check boolean LoidFamilyComplete",color=orange];
		1395 -> 2662 [label=true,color=green];
		1395 -> 2652 [label=false,color=brown];
	2653 [label="我理解。如果我的話傷到你，我也很抱歉。我只是不知道還能怎麼說出口。",shape=box,color=red];
		2653 -> 2663;
	2654 [label="我很高興我的話你能夠聽得進去。我都快要絕望了。",shape=box,color=red];
		2654 -> 2664;
	2655 [label="如果你真的覺得自己如此高人一等，凌駕於我們所有人之上，那麼你看到的只會是你迷失其中的雲霧。",shape=box,color=blue];
		2655 -> 2657;
		2655 -> 2658;
	2656 [label="所以……我會承認主教以「更大的善」之名傷害他人是不正當的。",shape=box,color=blue];
		2656 -> 2665;
	2657 [label="我很沮喪，但我不知道還能怎麼讓你看清楚。源拓氏不是你的朋友。也不是你的父親。",shape=box,color=red];
		2657 -> 2666;
	2658 [label="我很抱歉。我沒有控制住自己的脾氣，說了一些我不該說的話。",shape=box,color=red];
		2658 -> 2667;
	2659 [label="我只是不想讓你因為我向你坦白真相而看不起我。這看起來如此渺小和可悲。",shape=box,color=blue];
		2659 -> 2668;
		2659 -> 2669;
	2660 [label="我很……失望。受傷。但我……我原諒你。",shape=box,color=blue];
		2660 -> 2670;
	2661 [label="Evaluate expressions",color=orange];
