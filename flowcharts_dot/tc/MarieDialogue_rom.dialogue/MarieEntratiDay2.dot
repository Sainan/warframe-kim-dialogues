	2682 [label="我想對你來說這應該很明顯，對不？同樣也失去家人的人。",shape=box,color=blue];
		2682 -> 2694;
	2683 [label="我們再看看吧。我想到最後，我在他身上看見了一點那個拋棄我的父親的影子，儘管現在對我來說這看起來如此渺小和可悲。",shape=box,color=blue];
		2683 -> 2694;
	2684 [label="我想，對我來說很難放棄幫主教辯護……我花了一些時間才明白為什麼我無法放開他。",shape=box,color=blue];
		2684 -> 2695;
	2685 [label="我們能不能先把這一切放到一邊，就算彼此意見不合，也還是可以繼續走下去，好嗎？",shape=box,color=blue];
		2685 -> 2686;
