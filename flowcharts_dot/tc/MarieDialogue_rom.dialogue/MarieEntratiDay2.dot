digraph {
	"MarieEntratiDay2 begins." [color=orange];
		"MarieEntratiDay2 begins." -> j3889026895;
	j3889026895 [label="漂泊者。我花了些時間思考並……讓自己冷靜下來。我有個嚴格的原則，就是在我憤怒之時不會與任何人進行對話。",shape=box,color=blue];
		j3889026895 -> j69936295;
	j69936295 [label="Evaluate expressions",color=orange];
		j69936295 -> j680886711 [label="MarieEntrati5a",color=purple];
		j69936295 -> j4025004132 [label="MarieEntrati5b",color=purple];
		j69936295 -> j3750191754 [label="MarieEntrati5c",color=purple];
		j69936295 -> j312074665 [label="MarieEntrati5d",color=purple];
		j69936295 -> j1468230572 [label="MarieEntrati5e",color=purple];
		j69936295 -> j897255338 [label="MarieEntrati5f",color=purple];
		j69936295 -> j1960224553 [label="MarieEntrati5g",color=purple];
		j69936295 -> j1481978574 [label="MarieEntrati5h",color=purple];
		j69936295 -> j2524433288 [label="MarieEntrati5i",color=purple];
		j69936295 -> "Chat ends." [label="false",color=purple];
	j680886711 [label="你昨天說的話就像……在我肋間插了一刀。沒錯，我承認我離開是因為感到憤怒，但同時也感到厭惡。不是對你，而是對我自己。",shape=box,color=blue];
		j680886711 -> j4142438446;
	j4025004132 [label="但在我們繼續之前，我必須先說一件事，那就是你對我說話的語氣。我知道你一定把我當小孩。你已經活了好幾個世紀了，甚至還更久。",shape=box,color=blue];
		j4025004132 -> j1327798802;
	j3750191754 [label="我花了很多時間思考你的話。這不是聖戰，而主教的手段一直都很有操縱性。",shape=box,color=blue];
		j3750191754 -> j3830822253;
	j312074665 [label="當然，你問我太陽經文哪裡提到無辜者是可被犧牲的這個問題是對的。經文裡沒有寫到。",shape=box,color=blue];
		j312074665 -> j3613532051;
	j1468230572 [label="在我們繼續之前，我必須先說一件事，那就是你竟然在爭論中利用我的信仰來對付我，而你自己卻不信奉任何信仰。",shape=box,color=blue];
		j1468230572 -> j628728275;
	j897255338 [label="我……很抱歉昨天匆匆結束了我們的對話。那實在太超過了。不過在我們繼續之前，我必須問你，你當時說的都是真心話嗎？還是你只是想操縱我的感情來避免一場不愉快的爭論？",shape=box,color=blue];
		j897255338 -> j4123726974;
		j897255338 -> j2332913823;
	j1960224553 [label="看來我們在主教的問題上陷入了僵局，對不？你把他視為怪物，而我，把他視為聖人。",shape=box,color=blue];
		j1960224553 -> j702336974;
	j1481978574 [label="如果你願意的話，我想和你談談你為了博取我的好感而選擇站在源拓氏這邊的決定。",shape=box,color=blue];
		j1481978574 -> j896397473;
	j2524433288 [label="如果你願意的話，我現在想和你談談你的謊言。",shape=box,color=blue];
		j2524433288 -> j896397473;
	"Chat ends." [color=orange];
	j4142438446 [label="你出手如此致命精準，我又怎會感到意外？竟然把我的話，與惡魔的話相提並論……",shape=box,color=blue];
		j4142438446 -> j2831780827;
	j1327798802 [label="你穿越過未知的維度，穿越過虛空本身。與諸神和天使戰鬥過。那麼在你眼中，我又算什麼呢，對不？不過就是傻裡傻氣的小瑪麗罷了。",shape=box,color=blue];
		j1327798802 -> j1749342264;
	j3830822253 [label="而我相信……是的，你說得對。這不是聖戰。因為根本沒有聖戰這回事。戰爭從來都不神聖、不公正、不正義。痛苦永遠不該成為指路明燈。",shape=box,color=blue];
		j3830822253 -> j913580784;
	j3613532051 [label="戰爭從來都不神聖、不公正、不正義。痛苦永遠不該成為指路明燈。",shape=box,color=blue];
		j3613532051 -> j913580784;
	j628728275 [label="漂泊者，這樣就太虛偽了，既殘酷又無效。這只是一種想要「贏下」對話的手段，也不符合一個人應有的行為分寸。",shape=box,color=blue];
		j628728275 -> j1592726063;
	j4123726974 [label="我是真心的。如果我的時機……不對，我很抱歉。我深深在乎你，瑪麗……",shape=box,color=red];
		j4123726974 -> j1092458133;
	j2332913823 [label="我不是真心的，我只是……一時衝動。我很抱歉。是當下情緒太過激動了。",shape=box,color=red];
		j2332913823 -> j315314467;
	j702336974 [label="然而……我不希望我們之間就這樣收場。你是個善良的靈魂，而我們之間有太多我不想就此變質的事。",shape=box,color=blue];
		j702336974 -> j483300420;
	j896397473 [label="試圖操弄情況來控制我的感受……既虛偽又殘酷。漂泊者，我承認我確實很想因此而恨你。",shape=box,color=blue];
		j896397473 -> j217331278;
	j2831780827 [label="我本以為自己是個對世界和所有人都敞開心胸的人。而你精確地，用一支帶刺的箭，就證明我錯了。",shape=box,color=blue];
		j2831780827 -> j4116034528;
	j1749342264 [label="一方面，我理解這點。也表示同情。我們兩個當時都在氣頭上。但另一方面，我希望你能更優雅和得體地來對待我，而不是像之前那樣。",shape=box,color=blue];
		j1749342264 -> j2561944679;
	j913580784 [label="甚至我們現在所做的事，摧毀喃喃者並對抗你的眾多敵人，也不是聖光者的道路。",shape=box,color=blue];
		j913580784 -> j1410134267;
	j1592726063 [label="信仰不是，也永遠不該是，用來對付他人的武器。它是盾牌。黑暗中的光。指引道路的聲音。",shape=box,color=blue];
		j1592726063 -> j1579615521;
	j1092458133 [label="在我面對……面對這個龐大的問題之前，請允許我先解釋一下關於主教的事。",shape=box,color=blue];
		j1092458133 -> j217268363;
	j315314467 [label="Boolean DrifterMarie is now false.",color=orange];
		j315314467 -> j3995664682;
	j483300420 [label="Check boolean LoidFamilyComplete",color=orange];
		j483300420 -> j806092359 [label=true,color=green];
		j483300420 -> j74061975 [label=false,color=brown];
	j217331278 [label="然而……我不希望我們之間就這樣收場。我們之間有太多我不想就此變質的事。",shape=box,color=blue];
		j217331278 -> j3805730835;
	j4116034528 [label="我想我是來道歉的，來說我為如此愚蠢地固執感到深深抱歉。我希望你能理解。",shape=box,color=blue];
		j4116034528 -> j3152317295;
		j4116034528 -> j2128561401;
	j2561944679 [label="因為我曾流落街頭。我一生中的每一天都活在肉體的折磨之中。我經歷過心碎，經歷過愛，經歷過恐懼與拒絕。我經歷過生命與失去。",shape=box,color=blue];
		j2561944679 -> j2294781886;
	j1410134267 [label="儘管舉起劍也許是必要的，以免世間被他們的同類淹沒，但這種行為不該被推崇。而且當無辜者在過程中受到傷害時，這當然更不可被原諒。",shape=box,color=blue];
		j1410134267 -> j1319686725;
	j1579615521 [label="而你試圖用它來對付我，只是為了「擊敗」我？這是個懦弱的策略。但我們兩個當時都在氣頭上，如果你能原諒我在憤怒中說的話，我會……原諒你。",shape=box,color=blue];
		j1579615521 -> j2932277995;
		j1579615521 -> j3622504205;
	j217268363 [label="我想，對我來說很難放棄幫主教辯護……我花了一些時間才明白為什麼我無法放開他。",shape=box,color=blue];
		j217268363 -> j432717356;
	j3995664682 [label="不，我理解……有多少謀殺是因為「激情」而犯下的，對不？當然也有同樣多的孩子是在激情的瞬間被創造出來的。",shape=box,color=blue];
		j3995664682 -> j2228609644;
	j806092359 [label="而你在如此短的時間內對我變得如此重要……我發現我們的對話是如此愉快。",shape=box,color=blue];
		j806092359 -> j1186072069;
	j74061975 [label="的確，我仍然希望看到 Loid 先生能與樓上那些人團圓。我也希望為主教剩餘的家人帶來慰藉，而你正是通往這一切的關鍵！",shape=box,color=blue];
		j74061975 -> j806092359;
	j3805730835 [label="Check boolean LoidFamilyComplete",color=orange];
		j3805730835 -> j828935573 [label=true,color=green];
		j3805730835 -> j1036441922 [label=false,color=brown];
	j3152317295 [label="我理解。如果我的話傷到你，我也很抱歉。我只是不知道還能怎麼說出口。",shape=box,color=red];
		j3152317295 -> j1718128966;
	j2128561401 [label="我很高興我的話你能夠聽得進去。我都快要絕望了。",shape=box,color=red];
		j2128561401 -> j87279080;
	j2294781886 [label="如果你真的覺得自己如此高人一等，凌駕於我們所有人之上，那麼你看到的只會是你迷失其中的雲霧。",shape=box,color=blue];
		j2294781886 -> j2932277995;
		j2294781886 -> j3622504205;
	j1319686725 [label="所以……我會承認主教以「更大的善」之名傷害他人是不正當的。",shape=box,color=blue];
		j1319686725 -> j584295105;
	j2932277995 [label="我很沮喪，但我不知道還能怎麼讓你看清楚。源拓氏不是你的朋友。也不是你的父親。",shape=box,color=red];
		j2932277995 -> j3295314687;
	j3622504205 [label="我很抱歉。我沒有控制住自己的脾氣，說了一些我不該說的話。",shape=box,color=red];
		j3622504205 -> j2321323341;
	j432717356 [label="我只是不想讓你因為我向你坦白真相而看不起我。這看起來如此渺小和可悲。",shape=box,color=blue];
		j432717356 -> j4267263435;
		j432717356 -> j4083323046;
	j2228609644 [label="我很……失望。受傷。但我……我原諒你。",shape=box,color=blue];
		j2228609644 -> j387047348;
	j1186072069 [label="Evaluate expressions",color=orange];
		j1186072069 -> j4095197781 [label="DrifterMarie",color=purple];
		j1186072069 -> j1043673530 [label="DrifterLyon",color=purple];
		j1186072069 -> j2230604625 [label="DrifterRoathe",color=purple];
		j1186072069 -> j2062839042 [label="false",color=purple];
	j828935573 [label="而且我想，你還有很多善意可以施予我的里昂，甚至施予……那個惡魔……",shape=box,color=blue];
		j828935573 -> j1508983535;
		j828935573 -> j448696597;
	j1036441922 [label="的確，我仍然希望看到 Loid 先生能與樓上那些人團圓。我也希望為主教剩餘的家人帶來慰藉，而你正是通往這一切的關鍵！",shape=box,color=blue];
		j1036441922 -> j828935573;
	j1718128966 [label="+10 Chemistry",color=orange];
		j1718128966 -> j1146416407;
	j87279080 [label="要知道，當一個人「贏」了的時候，保持風度還是很重要的。",shape=box,color=blue];
		j87279080 -> j1781870202;
		j87279080 -> j500938608;
	j584295105 [label="當他的道路上只剩下破碎的生命和心靈時，還能留下什麼「更大的善」？",shape=box,color=blue];
		j584295105 -> j4116034528;
	j3295314687 [label="不。他不是我的父親。因為我的父親在我小時候就把我拋棄在街頭，而主教從未做過如此殘忍的事。",shape=box,color=blue];
		j3295314687 -> j786197016;
	j2321323341 [label="許多悲劇都是在一時激情犯下的。事情往往就是如此。",shape=box,color=blue];
		j2321323341 -> j3939449437;
	j4267263435 [label="我想我已經知道你要說什麼了。",shape=box,color=red];
		j4267263435 -> j3356318944;
	j4083323046 [label="瑪麗，我不會看不起你。我保證。",shape=box,color=red];
		j4083323046 -> j3726017687;
	j387047348 [label="如果可以的話，我們……先談完關於主教的對話，我心碎的事先暫且不談，好嗎？",shape=box,color=blue];
		j387047348 -> j1991416008;
	j4095197781 [label="的確，我怎麼能把你推開，當你已經向我表白了你的心意。",shape=box,color=blue];
		j4095197781 -> j984447218;
	j1043673530 [label="的確，我怎麼能把你推開，當你已經向我表白了你對我們親愛的里昂的心意？你能為他帶來如此平靜……如此慰藉……",shape=box,color=blue];
		j1043673530 -> j984447218;
	j2230604625 [label="的確，我怎麼能把你推開，當你似乎對惡魔情有獨鍾？我不理解你的品味，但……看來你會待在我們身邊，對不？",shape=box,color=blue];
		j2230604625 -> j984447218;
	j2062839042 [label="我不想失去你這個夥伴。我們能不能先把這一切放到一邊，就算彼此意見不合，也還是可以繼續走下去，好嗎？",shape=box,color=blue];
		j2062839042 -> j3073095520;
		j2062839042 -> j2846777201;
	j1508983535 [label="瑪麗，等一下。拜託。讓我道歉。",shape=box,color=red];
		j1508983535 -> j2100209008;
	j448696597 [label="老實說，我並不覺得自己對你說的話很重要，我並沒有想到這對你來說有那麼重要。",shape=box,color=red];
		j448696597 -> j2100209008;
	j1146416407 [label="我對此的感激，遠超過你所能想像，謝謝。",shape=box,color=blue];
		j1146416407 -> j3684885099;
	j1781870202 [label="我只是在逗你玩。",shape=box,color=red];
		j1781870202 -> j2568620127;
	j500938608 [label="不好意思。我不太常「贏」。",shape=box,color=red];
		j500938608 -> j1607037146;
	j786197016 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j786197016 -> j542165713;
	j3939449437 [label="+5 Chemistry",color=orange];
		j3939449437 -> j2105152947;
	j3356318944 [label="我想對你來說這應該很明顯，對不？同樣也失去家人的人。",shape=box,color=blue];
		j3356318944 -> j1718291395;
	j3726017687 [label="我們再看看吧。我想到最後，我在他身上看見了一點那個拋棄我的父親的影子，儘管現在對我來說這看起來如此渺小和可悲。",shape=box,color=blue];
		j3726017687 -> j1718291395;
	j1991416008 [label="我想，對我來說很難放棄幫主教辯護……我花了一些時間才明白為什麼我無法放開他。",shape=box,color=blue];
		j1991416008 -> j541174659;
	j984447218 [label="我們能不能先把這一切放到一邊，就算彼此意見不合，也還是可以繼續走下去，好嗎？",shape=box,color=blue];
		j984447218 -> j3073095520;
		j984447218 -> j2846777201;
	j3073095520 [label="不，我還沒有釐清楚這些事。我們需要把這次對話談完。",shape=box,color=red];
		j3073095520 -> j2276353189;
	j2846777201 [label="我覺得這樣很合理。我同意。",shape=box,color=red];
		j2846777201 -> j2985728200;
	j2100209008 [label="漂泊者，我原諒你對我說的那些謊。我們可以繼續做朋友和盟友。但像你這樣對我撒謊，只是為了想要……什麼？",shape=box,color=blue];
