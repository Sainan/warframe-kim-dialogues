		2731 -> 2737;
	2732 [label="至於主教的問題嘛？我想我們將在這個話題上仍然各執己見。就如同我們在感情上也注定各走各的。",shape=box,color=blue];
		2732 -> 2738;
	2733 [label="愚蠢的小瑪麗……當然，他並不是他看起來的那樣。",shape=box,color=blue];
