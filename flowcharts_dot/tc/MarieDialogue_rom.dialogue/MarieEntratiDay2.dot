		2756 -> 2761;
	2757 [label="（法語）你以為你可以從未來來到這裡，像操縱人偶一樣操縱我們所有人嗎？！我建議你拿起那台機器，彎下腰，把它牢牢地塞進你的屁眼裡，你這個骯髒噁心的臭爛人！",shape=box,color=blue];
		2757 -> 2762;
	2758 [label="「一對情侶」？我親愛的狼，我想自從我那個有未婚夫、講求包辦婚姻的年代以來，時代早已不同了……我可真不認為你是在向我求婚！",shape=box,color=blue];
		2758 -> 2763;
	2759 [label="是的，這很合理。相當合理。我來自一個講求正式求愛的時代，對不？不過我也很好奇，如今時代究竟改變了多少。",shape=box,color=blue];
		2759 -> 2764;
