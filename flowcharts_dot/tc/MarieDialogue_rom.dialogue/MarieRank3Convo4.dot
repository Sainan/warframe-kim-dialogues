		j2921399795 -> j396039035;
	j396039035 [label="前幾天我和 Loid 先生談論到他的童年，我有個問題想問你。",shape=box,color=blue];
		j396039035 -> j548132546;
		j396039035 -> j1881652771;
		j396039035 -> j2571098715;
		j396039035 -> j1350559949;
	j548132546 [label="不好意思。你說什麼？",shape=box,color=red];
		j548132546 -> j4238897433;
	j1881652771 [label="我……不……知道該怎麼看待這件事。",shape=box,color=red];
		j1881652771 -> j3744536107;
	j2571098715 [label="什麼問題？",shape=box,color=red];
		j2571098715 -> j665899933;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j4238897433 [label="他在跟我講他年輕時的事。我做了什麼事冒犯到你嗎？",shape=box,color=blue];
		j4238897433 -> j2604773736;
		j4238897433 -> j1345312260;
	j3744536107 [label="我不明白。我做了什麼事冒犯到你嗎？",shape=box,color=blue];
		j3744536107 -> j2604773736;
		j3744536107 -> j1345312260;
	j665899933 [label="哲士是 Orokin 嗎？或者他們不是呢？這個詞用得太隨意了。",shape=box,color=blue];
		j665899933 -> j1749120622;
	"Chat ends." [color=orange];
	j2604773736 [label="我想我只是……嫉妒吧。",shape=box,color=red];
		j2604773736 -> j591339852;
	j1345312260 [label="我想我只是……驚訝吧。",shape=box,color=red];
		j1345312260 -> j3779061880;
	j1749120622 [label="我想我可以去問那個惡魔，但如果能避免的話，我實在不太想跟他說話。",shape=box,color=blue];
		j1749120622 -> j775321573;
		j1749120622 -> j1418703824;
	j591339852 [label="（法語）嫉妒？為什麼？",shape=box,color=blue];
		j591339852 -> j287158760;
	j3779061880 [label="（法語）為什麼？",shape=box,color=blue];
		j3779061880 -> j319599303;
		j3779061880 -> j2624598231;
	j775321573 [label="不，哲士的階級在 Orokin 之下。",shape=box,color=red];
		j775321573 -> j221699738;
	j1418703824 [label="Orokin 帝國之所以叫這個名字是因為 Orokin 統治它，但 Orokin 同時也只是統治階級的名稱。",shape=box,color=red];
		j1418703824 -> j221699738;
	j287158760 [label="+10 Chemistry",color=orange];
		j287158760 -> j3769253063;
	j319599303 [label="我只是有點驚訝，你現在比我更了解他。",shape=box,color=red];
		j319599303 -> j287158760;
	j2624598231 [label="我對 Loid 的過去一無所知，而且我認識他已經有一陣子了。",shape=box,color=red];
		j2624598231 -> j287158760;
	j221699738 [label="這種事常發生。你不是唯一一個。",shape=box,color=red];
		j221699738 -> j4262843532;
	j3769253063 [label="哦！請別放心上！",shape=box,color=blue];
		j3769253063 -> j1142584535;
	j4262843532 [label="Orokin 是故意讓他們的社會變得混亂難懂的嗎？",shape=box,color=blue];
		j4262843532 -> j2660681482;
		j4262843532 -> j2788582015;
		j4262843532 -> j2259382668;
	j1142584535 [label="Loid 先生，怎麼說呢，有點疏遠。",shape=box,color=blue];
		j1142584535 -> j167435061;
		j1142584535 -> j684362178;
	j2660681482 [label="掌權數千年之後，人們會變得……無聊。無聊的人建立複雜的體系。",shape=box,color=red];
		j2660681482 -> j522781322;
	j2788582015 [label="他們對華麗和精緻的事物情有獨鍾。這種品味延伸到了官僚體制上。",shape=box,color=red];
		j2788582015 -> j522781322;
	j2259382668 [label="老實說，我開始這麼認為了。",shape=box,color=red];
		j2259382668 -> j522781322;
	j167435061 [label="我對他真的一無所知。",shape=box,color=red];
		j167435061 -> j2159435009;
	j684362178 [label="他確實有點疏離，是的。",shape=box,color=red];
		j684362178 -> j2159435009;
	j522781322 [label="+10 Chemistry",color=orange];
		j522781322 -> j3141657571;
	j2159435009 [label="看一下我都跟誰相處，好嗎？學會解讀一座雕像，就不難學會解讀另一座了。",shape=box,color=blue];
		j2159435009 -> j394978424;
	j3141657571 [label="我覺得他們這麼做就是故意要惱人！",shape=box,color=blue];
		j3141657571 -> j3700436428;
	j394978424 [label="+10 Chemistry",color=orange];
		j394978424 -> j388262539;
	j3700436428 [label="然後他們還疑惑為什麼會爆發叛亂。你們或許有你們的 Warframe，但我們有我們的斷頭台！",shape=box,color=blue];
		j3700436428 -> j347411187;
	j388262539 [label="不過我得承認，Loid 先生比親愛的里昂更……有意思。",shape=box,color=blue];
		j388262539 -> j4271883503;
		j388262539 -> j239154589;
	j347411187 [label="（法語）革命萬歲！",shape=box,color=blue];
		j347411187 -> j2535278348;
		j347411187 -> j3318789554;
		j347411187 -> j2650118097;
	j4271883503 [label="他有他的理由。",shape=box,color=red];
		j4271883503 -> j1749608229;
	j239154589 [label="嗯……你的問題是什麼？",shape=box,color=red];
		j239154589 -> j1121620863;
	j2535278348 [label="我該擔心嗎？",shape=box,color=red];
		j2535278348 -> j3563894822;
	j3318789554 [label="革命萬歲！我也這麼認為。",shape=box,color=red];
		j3318789554 -> j594831187;
	j2650118097 [label="我不太確定剛才發生什麼事。但我想，我同意。",shape=box,color=red];
		j2650118097 -> j594831187;
	j1749608229 [label="是的，他當然有。",shape=box,color=blue];
		j1749608229 -> j2605659843;
	j1121620863 [label="啊！是的。",shape=box,color=blue];
		j1121620863 -> j2605659843;
	j3563894822 [label="別理會我，我只是玩玩而已。傻裡傻氣的革命家瑪麗登場了。",shape=box,color=blue];
		j3563894822 -> j1469432876;
	j594831187 [label="+10 Chemistry",color=orange];
		j594831187 -> j3563894822;
	j2605659843 [label="恐怕我已經完全忘記我來這裡要問你什麼了！哈！算了。我會想起來的。",shape=box,color=blue];
		j2605659843 -> j3675160860;
	j1469432876 [label="謝謝你回答我的問題，我該讓你繼續忙你的事了。",shape=box,color=blue];
		j1469432876 -> j3675160860;
	j3675160860 [label="很抱歉打擾到你的白天。或者夜晚。或無論何時何日，無論身在何處。",shape=box,color=blue];
