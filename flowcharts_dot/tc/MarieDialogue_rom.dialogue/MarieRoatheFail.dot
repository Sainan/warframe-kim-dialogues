		j1175500902 -> j1490096764;
	j2704456602 [label="我正試著說服羅瑟幫助我們讓 Loid 和源拓氏家族團圓。但他對服用血清這件事很固執。我需要你幫忙跟他談談。",shape=box,color=red];
		j2704456602 -> j3494446424;
	j2751767053 [label="我正試著讓羅瑟意識到他有能力改變。他可以原諒自己過去所做的事。而我需要你的幫助才能做到這點。",shape=box,color=red];
		j2751767053 -> j2299363608;
	j383664445 [label="羅瑟正因為他所做的事而內心煎熬。如果沒有你的幫助，我擔心如果他不能接受自己是誰，他就會繼續自我毀滅。",shape=box,color=red];
		j383664445 -> j2563756227;
	j116764264 [label="羅瑟得知了關於血清的真相。他是自願服用的。而這正在摧毀他。我需要你幫忙讓他冷靜下來。",shape=box,color=red];
		j116764264 -> j3494446424;
	j1490096764 [label="羅瑟快把我逼瘋了。我不知道該怎麼跟他說話。你有什麼建議嗎？",shape=box,color=red];
		j1490096764 -> j3494446424;
	j3494446424 [label="不，如果我擅長跟那個惡魔說話，你覺得我還會總是用高勒語對他大吼大叫嗎？",shape=box,color=blue];
		j3494446424 -> j455509549;
