	3607 [label="Chat ends.",color=orange];
	3609 [label="我一直在想怎麼說服 Loid 走上那些階梯，終於去找家族談談，然後……我有個主意，但我覺得你不會喜歡。",shape=box,color=red];
		3609 -> 3614;
	3610 [label="你有再想過要怎麼說服 Loid 去跟樓上的源拓氏家族談談嗎？",shape=box,color=red];
		3610 -> 3615;
	3611 [label="關於讓 Loid 和源拓氏家族對話這件事，我在想……你有沒有重新考慮過讓羅瑟參與？",shape=box,color=red];
		3611 -> 3616;
	3612 [label="瑪麗，你還願意……試著說服 Loid 去跟「樓上的鄰居」談談嗎？我知道上次那話題結束得有點尷尬。",shape=box,color=red];
		3612 -> 3616;
	3608 [label="我一直在想 Loid 先生為什麼如此害怕與主教的家人說話。",shape=box,color=blue];
		3608 -> 3613;
	3614 [label="Check boolean MarieDating",color=orange];
		3614 -> 3619 [label=true,color=green];
		3614 -> 3618 [label=false,color=brown];
	3615 [label="Check boolean MarieDating",color=orange];
		3615 -> 3621 [label=true,color=green];
		3615 -> 3620 [label=false,color=brown];
	3616 [label="Check boolean MarieDating",color=orange];
		3616 -> 3623 [label=true,color=green];
		3616 -> 3622 [label=false,color=brown];
	3613 [label="還有我們必須如何打破這個僵局。我們被困在這煉獄中的狀況不該繼續下去。這似乎是毫無必要的痛苦。",shape=box,color=blue];
		3613 -> 3617;
	3619 [label="你好，我的心肝！你擔心我不會喜歡什麼？",shape=box,color=blue];
		3619 -> 3625;
	3618 [label="你好！哦？你擔心我不會喜歡什麼？",shape=box,color=blue];
		3618 -> 3625;
	3621 [label="你好，我的心肝！是的，我想過了……我真的很不願承認這點。說這話讓我一點也不高興。",shape=box,color=blue];
		3621 -> 3626;
	3620 [label="你好，我的心肝！是的，我想過了……我真的很不願承認這點。說這話讓我一點也不高興。",shape=box,color=blue];
		3620 -> 3626;
	3623 [label="你好，你好，我的心肝！我想過了，是的……我真的很不願承認這點。說這話讓我一點也不高興。",shape=box,color=blue];
		3623 -> 3627;
	3622 [label="你好，是的，我想過了……我真的很不願承認這點。說這話讓我一點也不高興。",shape=box,color=blue];
		3622 -> 3627;
	3617 [label="但我覺得我們需要……某種後盾，對不？你有什麼想法嗎？",shape=box,color=blue];
		3617 -> 3624;
		3617 -> 3625;
	3625 [label="我想我們可能需要羅瑟的幫助，才能說服 Loid 去和源拓氏家族談談。否則我不認為他會答應，除非有人能保證家族和他本人都會受到保護。",shape=box,color=red];
		3625 -> 3629;
	3626 [label="但我想……我想──啊，願日尊原諒我，可能還是需要那個惡魔的協助。否則我認為 Loid 先生不會聽我們的。",shape=box,color=blue];
		3626 -> 3630;
	3627 [label="我認為你或許說得對。那個惡魔可能就是我們需要的那塊拼圖。啊，連打出這些字都讓我覺得好痛苦！",shape=box,color=blue];
		3627 -> 3631;
	3624 [label="我真的沒什麼好主意，除非向可怕的來源求助。那些可能會讓我們日後陷入大麻煩的來源。也就是羅瑟。",shape=box,color=red];
		3624 -> 3628;
	3629 [label="我……不願承認，但我想你可能是對的……願日尊原諒我。",shape=box,color=blue];
		3629 -> 3631;
	3630 [label="那個惡魔很強大，而且在事情出錯時，也能提供某種力量上的保證，對不？",shape=box,color=blue];
		3630 -> 3634;
		3630 -> 3635;
	3631 [label="Evaluate expressions",color=orange];
		3631 -> 3638 [label="RoatheFamilyFail",color=purple];
		3631 -> 3637 [label="RoatheRedeemed, RoatheFamilyDelay
",color=purple];
