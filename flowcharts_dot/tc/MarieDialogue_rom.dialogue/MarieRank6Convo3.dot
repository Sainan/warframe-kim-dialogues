		3683 -> 3691 [label="false",color=purple];
	3690 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3690 -> 3701;
	3689 [label="（法語）我的心肝，謝謝！",shape=box,color=blue];
		3689 -> 3700;
	3688 [label="（法語）謝謝！",shape=box,color=blue];
		3688 -> 3700;
	3687 [label="好吧！等你的好消息，在那之前我會準備好等你！我的心肝，謝謝。",shape=box,color=blue];
		3687 -> 3699;
	3686 [label="好吧！等你的好消息，在那之前我會準備好等你！謝謝。",shape=box,color=blue];
		3686 -> 3699;
	3697 [label="我只看你很高興就很快樂了。而且如果那個惡魔有地方可以發洩他的……精力……那就更好了，對不？",shape=box,color=blue];
		3697 -> 3708;
	3698 [label="我絕不會暗示說因為那個惡魔似乎偏愛你，所以也許他會聽你的，而對所有其他人他似乎都會忽視。",shape=box,color=blue];
		3698 -> 3709;
	3692 [label="他生命中的每個人都試圖把他塑造成某種怪物。我想我是第一個沒有這麼做的人。",shape=box,color=red];
		3692 -> 3703;
	3693 [label="他有很多面向不知道該如何展現。那不完全是在武裝自己，但他不相信人們不會傷害他。",shape=box,color=red];
		3693 -> 3704;
	3695 [label="他……在漫長的歲月中經歷過真正的心碎。那只是結痂後長出了荊棘，僅此而已。",shape=box,color=red];
		3695 -> 3706;
	3696 [label="我想我能理解他活過的歲月。我見過跟他一樣多的死亡。",shape=box,color=red];
		3696 -> 3707;
	3694 [label="他只是一直試圖做正確的事。沒錯也許用錯了方式，但他是在試圖拯救始源星系免於 Orokin 統治。",shape=box,color=red];
		3694 -> 3705;
	3691 [label="我喜歡他那種諷刺的幽默感。當你看穿他的自負之後，他其實很聰明。",shape=box,color=red];
		3691 -> 3702;
	3701 [label="Chat ends.",color=orange];
	3700 [label="好吧！等你的好消息，在那之前我會準備好等你！",shape=box,color=blue];
		3700 -> 3711;
	3699 [label="Update boolean MarieFamilySuccess",color=orange];
		3699 -> 3710;
	3708 [label="如果你能成為他肩上的小天使來約束他，對我們所有人來說就更好了。",shape=box,color=blue];
		3708 -> 3716;
		3708 -> 3717;
	3709 [label="而且絕不會在私密時刻。不。絕不。",shape=box,color=blue];
		3709 -> 3718;
		3709 -> 3719;
	3703 [label="而我想我最近在那份名單的第一順位了，對不？我想我應該……考慮他的理由，為什麼他會是這個樣子。譴責救不了任何靈魂。",shape=box,color=blue];
		3703 -> 3713;
	3704 [label="我們總是向周圍的人隱藏著某種痛苦。某些我們想要庇護的東西，因為害怕別人會利用它。如果你說的是真的，我想我應該努力對他更友善一些。",shape=box,color=blue];
		3704 -> 3713;
	3706 [label="我無法想像一個人在那麼多年裡必須承受多少愛與失去。即使我親眼見證，這一切似乎還是難以置信。",shape=box,color=blue];
		3706 -> 3714;
	3707 [label="有時候當我跟他說話時，我會忘記他已經活了多少個世紀。即使我親眼見證，這一切似乎還是難以置信。",shape=box,color=blue];
		3707 -> 3715;
	3705 [label="總是有……細微差別的，對吧？總是有這樣或那樣做的理由。如果你說的是真的，我想我應該努力對他更友善一些。",shape=box,color=blue];
		3705 -> 3713;
	3702 [label="從來沒有人說過那個惡魔不機智。",shape=box,color=blue];
		3702 -> 3712;
	3711 [label="Update boolean MarieFamilySuccess",color=orange];
		3711 -> 3721;
	3710 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3710 -> 3720;
	3716 [label="誰說我在試圖約束他？",shape=box,color=red];
		3716 -> 3723;
	3717 [label="我不能做出任何承諾。",shape=box,color=red];
		3717 -> 3724;
	3718 [label="我從不知道你還有這一面。",shape=box,color=red];
		3718 -> 3684;
	3719 [label="你讓我驚訝。我實在佩服。",shape=box,color=red];
		3719 -> 3684;
	3713 [label="+10 Chemistry",color=orange];
		3713 -> 3722;
	3714 [label="對呀，那會對靈魂造成什麼樣的傷害？我明白為什麼你會想找另一個能理解你的人。而他，也理解你。",shape=box,color=blue];
		3714 -> 3713;
	3715 [label="活了這麼久，見過這麼多死亡，而且其中許多還是自己親手造成的。",shape=box,color=blue];
		3715 -> 3714;
	3712 [label="+5 Chemistry",color=orange];
		3712 -> 3722;
	3721 [label="Update boolean MarieRank5Convo4Complete",color=orange];
		3721 -> 3725;
	3720 [label="Chat ends.",color=orange];
	3723 [label="Add -1 to Thermostat",color=orange];
		3723 -> 3726;
	3724 [label="Add 1 to Thermostat",color=orange];
		3724 -> 3727;
	3722 [label="我只是很高興那個惡魔有人可以說話，而那個人會試圖約束他。他肩上的那個小天使。",shape=box,color=blue];
		3722 -> 3716;
		3722 -> 3717;
	3725 [label="Chat ends.",color=orange];
	3726 [label="+10 Chemistry",color=orange];
		3726 -> 3728;
	3727 [label="+10 Chemistry",color=orange];
		3727 -> 3729;
	3728 [label="也許你是對的……沒有惡魔的天使算什麼天使？他提醒我們所有人應該努力避免什麼。",shape=box,color=blue];
		3728 -> 3730;
	3729 [label="是的，我擔心他身上有一種無法真正被治癒的邪惡。他太享受那種感覺了。",shape=box,color=blue];
