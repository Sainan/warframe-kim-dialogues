	3679 [label="+10 Chemistry",color=orange];
		3679 -> 3686;
	3684 [label="+5 Chemistry",color=orange];
		3684 -> 3697;
	3685 [label="我完全不知道你在說什麼！我也沒有暗示什麼。我只是一個純潔無辜的太陽修女。",shape=box,color=blue];
		3685 -> 3698;
