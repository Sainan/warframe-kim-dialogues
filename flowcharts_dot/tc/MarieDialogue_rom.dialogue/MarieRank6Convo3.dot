		j148501058 -> j3295850130 [label="MarieFamilyOther",color=purple];
		j148501058 -> j155877073 [label="false",color=purple];
	j3028229933 [label="我一直在想怎麼說服 Loid 走上那些階梯，終於去找家族談談，然後……我有個主意，但我覺得你不會喜歡。",shape=box,color=red];
		j3028229933 -> j3431982611;
	j3295850130 [label="你有再想過要怎麼說服 Loid 去跟樓上的源拓氏家族談談嗎？",shape=box,color=red];
		j3295850130 -> j2607534784;
	j2136665002 [label="關於讓 Loid 和源拓氏家族對話這件事，我在想……你有沒有重新考慮過讓羅瑟參與？",shape=box,color=red];
		j2136665002 -> j1903226774;
	j2356233814 [label="瑪麗，你還願意……試著說服 Loid 去跟「樓上的鄰居」談談嗎？我知道上次那話題結束得有點尷尬。",shape=box,color=red];
		j2356233814 -> j1903226774;
	j155877073 [label="我一直在想 Loid 先生為什麼如此害怕與主教的家人說話。",shape=box,color=blue];
		j155877073 -> j1464993187;
	j3431982611 [label="Check boolean MarieDating",color=orange];
		j3431982611 -> j1408847286 [label=true,color=green];
		j3431982611 -> j2022740614 [label=false,color=brown];
	j2607534784 [label="Check boolean MarieDating",color=orange];
		j2607534784 -> j3008047878 [label=true,color=green];
		j2607534784 -> j3008047878 [label=false,color=brown];
	j1903226774 [label="Check boolean MarieDating",color=orange];
		j1903226774 -> j1892229115 [label=true,color=green];
		j1903226774 -> j2175036137 [label=false,color=brown];
	j1464993187 [label="還有我們必須如何打破這個僵局。我們被困在這煉獄中的狀況不該繼續下去。這似乎是毫無必要的痛苦。",shape=box,color=blue];
		j1464993187 -> j3342864122;
	j1408847286 [label="你好，我的心肝！你擔心我不會喜歡什麼？",shape=box,color=blue];
		j1408847286 -> j2746038627;
	j2022740614 [label="你好！哦？你擔心我不會喜歡什麼？",shape=box,color=blue];
		j2022740614 -> j2746038627;
	j3008047878 [label="你好，我的心肝！是的，我想過了……我真的很不願承認這點。說這話讓我一點也不高興。",shape=box,color=blue];
		j3008047878 -> j2568075135;
	j1892229115 [label="你好，你好，我的心肝！我想過了，是的……我真的很不願承認這點。說這話讓我一點也不高興。",shape=box,color=blue];
		j1892229115 -> j3067869803;
	j2175036137 [label="你好，是的，我想過了……我真的很不願承認這點。說這話讓我一點也不高興。",shape=box,color=blue];
		j2175036137 -> j3067869803;
	j3342864122 [label="但我覺得我們需要……某種後盾，對不？你有什麼想法嗎？",shape=box,color=blue];
		j3342864122 -> j1504972273;
		j3342864122 -> j2746038627;
	j2746038627 [label="我想我們可能需要羅瑟的幫助，才能說服 Loid 去和源拓氏家族談談。否則我不認為他會答應，除非有人能保證家族和他本人都會受到保護。",shape=box,color=red];
		j2746038627 -> j137300753;
	j2568075135 [label="但我想……我想──啊，願日尊原諒我，可能還是需要那個惡魔的協助。否則我認為 Loid 先生不會聽我們的。",shape=box,color=blue];
		j2568075135 -> j422296560;
	j3067869803 [label="我認為你或許說得對。那個惡魔可能就是我們需要的那塊拼圖。啊，連打出這些字都讓我覺得好痛苦！",shape=box,color=blue];
		j3067869803 -> j636489540;
	j1504972273 [label="我真的沒什麼好主意，除非向可怕的來源求助。那些可能會讓我們日後陷入大麻煩的來源。也就是羅瑟。",shape=box,color=red];
		j1504972273 -> j3239037554;
	j137300753 [label="我……不願承認，但我想你可能是對的……願日尊原諒我。",shape=box,color=blue];
		j137300753 -> j636489540;
	j422296560 [label="那個惡魔很強大，而且在事情出錯時，也能提供某種力量上的保證，對不？",shape=box,color=blue];
		j422296560 -> j3488598395;
		j422296560 -> j1208440411;
	j636489540 [label="Evaluate expressions",color=orange];
		j636489540 -> j3511230733 [label="RoatheFamilyFail",color=purple];
		j636489540 -> j3698540931 [label="RoatheRedeemed & RoatheFamilyDelay
",color=purple];
		j636489540 -> j3698540931 [label="RoatheRedeemed & RoatheFamilySuccess
",color=purple];
		j636489540 -> j1115359196 [label="RoatheVillain & RoatheFamilyDelay
",color=purple];
		j636489540 -> j1115359196 [label="RoatheVillain & RoatheFamilySuccess",color=purple];
		j636489540 -> j2453014084 [label="false",color=purple];
	j3239037554 [label="你真的這麼確定嗎？如果我都能放下與那個惡魔的分歧，那你當然也可以，對不？",shape=box,color=blue];
		j3239037554 -> j3477825936;
		j3239037554 -> j3089727414;
	j3488598395 [label="不，一定還有別的辦法。我拒絕在這件事上向他求助。",shape=box,color=red];
		j3488598395 -> j3239037554;
	j1208440411 [label="你說得對。我本來就沒想到你會同意，所以我不敢開口問。",shape=box,color=red];
		j1208440411 -> j636489540;
	j3511230733 [label="他會在這方面給予我們幫助嗎？",shape=box,color=blue];
		j3511230733 -> j1221608490;
	j3698540931 [label="他會在這方面給予我們幫助嗎？",shape=box,color=blue];
		j3698540931 -> j1512658868;
	j1115359196 [label="他會在這方面給予我們幫助嗎？",shape=box,color=blue];
		j1115359196 -> j1589585782;
	j2453014084 [label="但你覺得你能說服他幫助我們嗎？",shape=box,color=blue];
		j2453014084 -> j3418431545;
		j2453014084 -> j3124905798;
	j3477825936 [label="不，我很抱歉。",shape=box,color=red];
		j3477825936 -> j931045688;
	j3089727414 [label="好吧。如果你沒問題，我也沒問題。",shape=box,color=red];
		j3089727414 -> j2464336276;
	j1221608490 [label="不，很可惜……我想，找他幫忙的這條路是條死路。你覺得還有別的辦法嗎？",shape=box,color=red];
		j1221608490 -> j3948789867;
	j1512658868 [label="他會的。我已經說服他幫忙讓他們團圓，而且你不會相信，目的是讓他能幫忙保護源拓氏的家人。畢竟他們是 Orokin 真正僅存的遺族。",shape=box,color=red];
		j1512658868 -> j4101421510;
	j1589585782 [label="他會的。我已經說服他幫忙讓他們團圓，而且你不會對此感到意外，主要是為了在阿爾布雷希特不在時激怒他。",shape=box,color=red];
		j1589585782 -> j68453100;
	j3418431545 [label="還沒定下來。他……嗯，你知道他是什麼德性。",shape=box,color=red];
		j3418431545 -> j2913252443;
	j3124905798 [label="我還在想辦法，但我想我可以。",shape=box,color=red];
		j3124905798 -> j1104176810;
	j931045688 [label="+20 Chemistry",color=orange];
		j931045688 -> j516500004;
	j2464336276 [label="是的，我不必喜歡這件事，但我想這是我們必須吞下的苦藥。",shape=box,color=blue];
		j2464336276 -> j636489540;
	j3948789867 [label="哦！那真是……太可惜了。我不知道也不這麼認為……你能想到用另一種方式接觸那個惡魔嗎？或是再試一次的辦法？",shape=box,color=blue];
		j3948789867 -> j2803745555;
	j4101421510 [label="他正在幫助保護那個違背他意願將他變成原型 Warframe、還把他丟到過去、奪走他記憶的男人的家人……",shape=box,color=blue];
		j4101421510 -> j2156567655;
	j68453100 [label="你說得對，我完全……不意外。",shape=box,color=blue];
		j68453100 -> j326077659;
		j68453100 -> j909715968;
	j2913252443 [label="Check boolean RoatheDating",color=orange];
		j2913252443 -> j926278235 [label=true,color=green];
		j2913252443 -> j2867372410 [label=false,color=brown];
	j1104176810 [label="Check boolean RoatheDating",color=orange];
		j1104176810 -> j3285497641 [label=true,color=green];
		j1104176810 -> j3000529763 [label=false,color=brown];
	j516500004 [label="那麼我也會支持你的選擇。",shape=box,color=blue];
		j516500004 -> j1179567760;
	j2803745555 [label="我同時會去跟里昂談談，但我並不抱太大希望。",shape=box,color=blue];
		j2803745555 -> j1138722042;
	j2156567655 [label="+20 Chemistry",color=orange];
		j2156567655 -> j1530743054;
	j326077659 [label="至少他會幫忙。而且我會確保他不會真的實行他的威脅。",shape=box,color=red];
		j326077659 -> j3047783893;
	j909715968 [label="我覺得那只是他用來掩飾的藉口。",shape=box,color=red];
		j909715968 -> j1846421683;
	j926278235 [label="是的，我知道。但我想你有一種特殊的方式能說服他，而所有人在這方面都失敗了，對不？",shape=box,color=blue];
		j926278235 -> j3015635910;
		j926278235 -> j1377089212;
	j2867372410 [label="是的，我當然知道。那個惡魔即使在最好的時候也很固執。有時候，我覺得他就是喜歡唱反調！",shape=box,color=blue];
		j2867372410 -> j2386932750;
		j2867372410 -> j3305088323;
	j3285497641 [label="我想你有一種特殊的方式能說服他，而所有人在這方面都失敗了，對不？",shape=box,color=blue];
		j3285497641 -> j3015635910;
		j3285497641 -> j1377089212;
	j3000529763 [label="祝你好運。那個惡魔即使在最好的時候也很固執。有時候，我覺得他就是喜歡唱反調！",shape=box,color=blue];
		j3000529763 -> j2386932750;
		j3000529763 -> j3305088323;
	j1179567760 [label="Boolean MarieFamilyFail is now true.",color=orange];
		j1179567760 -> j2605366984;
	j1138722042 [label="+20 Chemistry",color=orange];
		j1138722042 -> j4141183460;
	j1530743054 [label="我對我們這個惡魔的誤解實在太深了……",shape=box,color=blue];
		j1530743054 -> j2449071187;
	j3047783893 [label="是的。至少有你在身邊確保我們能阻止他實行他那些……更低劣的本能。",shape=box,color=blue];
		j3047783893 -> j2198758823;
	j1846421683 [label="是的，我希望你是對的。",shape=box,color=blue];
		j1846421683 -> j2198758823;
	j3015635910 [label="我不想把我跟他之間的關係當作談判工具。",shape=box,color=red];
		j3015635910 -> j531832947;
	j1377089212 [label="瑪麗，你是在暗示什麼？",shape=box,color=red];
		j1377089212 -> j1818490367;
	j2386932750 [label="說來奇怪，但我其實有點喜歡這樣。我們相處得很好。",shape=box,color=red];
		j2386932750 -> j3155211899;
	j3305088323 [label="他有時候會這樣，但我覺得那很大程度只是做做樣子。",shape=box,color=red];
		j3305088323 -> j4271673674;
	j2605366984 [label="Boolean MarieRank5Convo4Complete is now true.",color=orange];
		j2605366984 -> "Chat ends.";
	j4141183460 [label="正如人們所說，惡魔很善變！這就是人生！",shape=box,color=blue];
		j4141183460 -> j3569999725;
	j2449071187 [label="而我也不傻，看得出你在確保促成這一切的過程中扮演的角色！",shape=box,color=blue];
		j2449071187 -> j3242583483;
	j2198758823 [label="Check boolean MarieDating",color=orange];
		j2198758823 -> j3073269239 [label=true,color=green];
		j2198758823 -> j1024209488 [label=false,color=brown];
	j531832947 [label="哦！抱歉，我不是那個意思！只是他似乎偏愛你，所以雖然他會忽視所有其他人，但他也許會聽你說話。",shape=box,color=blue];
		j531832947 -> j3666374744;
	j1818490367 [label="+5 Chemistry",color=orange];
		j1818490367 -> j2861224637;
	j3155211899 [label="是的，他似乎確實偏愛你。也許是因為你們共享同個時空，而我們沒有。不然還能是為什麼？",shape=box,color=blue];
		j3155211899 -> j3822691405;
	j4271673674 [label="是嗎？你是什麼意思？",shape=box,color=blue];
		j4271673674 -> j3822691405;
	j3569999725 [label="Boolean MarieFamilySuccess is now true.",color=orange];
		j3569999725 -> j2605366984;
	j3242583483 [label="Check boolean MarieDating",color=orange];
		j3242583483 -> j2289369472 [label=true,color=green];
		j3242583483 -> j2173451968 [label=false,color=brown];
	j3073269239 [label="+10 Chemistry",color=orange];
		j3073269239 -> j4124454875;
	j1024209488 [label="+10 Chemistry",color=orange];
		j1024209488 -> j1318929485;
	j3666374744 [label="+5 Chemistry",color=orange];
		j3666374744 -> j1904442084;
	j2861224637 [label="我完全不知道你在說什麼！我也沒有暗示什麼。我只是一個純潔無辜的太陽修女。",shape=box,color=blue];
		j2861224637 -> j1215427689;
	j3822691405 [label="Evaluate expressions",color=orange];
		j3822691405 -> j3604158492 [label="RoatheVillain",color=purple];
		j3822691405 -> j3616809047 [label="RoatheRedeemed",color=purple];
		j3822691405 -> j3115224691 [label="RoatheUnloved3",color=purple];
		j3822691405 -> j790004607 [label="RoatheTraitor2",color=purple];
		j3822691405 -> j1162855533 [label="RoatheExecutor2",color=purple];
		j3822691405 -> j1394426228 [label="false",color=purple];
	j2289369472 [label="（法語）我的心肝，謝謝！",shape=box,color=blue];
		j2289369472 -> j3538661568;
	j2173451968 [label="（法語）謝謝！",shape=box,color=blue];
		j2173451968 -> j3538661568;
	j4124454875 [label="好吧！等你的好消息，在那之前我會準備好等你！我的心肝，謝謝。",shape=box,color=blue];
		j4124454875 -> j3569999725;
	j1318929485 [label="好吧！等你的好消息，在那之前我會準備好等你！謝謝。",shape=box,color=blue];
		j1318929485 -> j3569999725;
	j1904442084 [label="我只看你很高興就很快樂了。而且如果那個惡魔有地方可以發洩他的……精力……那就更好了，對不？",shape=box,color=blue];
		j1904442084 -> j3940426209;
	j1215427689 [label="我絕不會暗示說因為那個惡魔似乎偏愛你，所以也許他會聽你的，而對所有其他人他似乎都會忽視。",shape=box,color=blue];
		j1215427689 -> j1918540927;
	j3604158492 [label="他生命中的每個人都試圖把他塑造成某種怪物。我想我是第一個沒有這麼做的人。",shape=box,color=red];
		j3604158492 -> j3285501939;
	j3616809047 [label="他有很多面向不知道該如何展現。那不完全是在武裝自己，但他不相信人們不會傷害他。",shape=box,color=red];
		j3616809047 -> j588611661;
	j3115224691 [label="他……在漫長的歲月中經歷過真正的心碎。那只是結痂後長出了荊棘，僅此而已。",shape=box,color=red];
		j3115224691 -> j620923835;
	j790004607 [label="我想我能理解他活過的歲月。我見過跟他一樣多的死亡。",shape=box,color=red];
		j790004607 -> j509898044;
	j1162855533 [label="他只是一直試圖做正確的事。沒錯也許用錯了方式，但他是在試圖拯救始源星系免於 Orokin 統治。",shape=box,color=red];
		j1162855533 -> j1975602475;
	j1394426228 [label="我喜歡他那種諷刺的幽默感。當你看穿他的自負之後，他其實很聰明。",shape=box,color=red];
		j1394426228 -> j865320228;
	j3538661568 [label="好吧！等你的好消息，在那之前我會準備好等你！",shape=box,color=blue];
		j3538661568 -> j3569999725;
	j3940426209 [label="如果你能成為他肩上的小天使來約束他，對我們所有人來說就更好了。",shape=box,color=blue];
		j3940426209 -> j313274415;
		j3940426209 -> j435250180;
	j1918540927 [label="而且絕不會在私密時刻。不。絕不。",shape=box,color=blue];
		j1918540927 -> j1040960932;
		j1918540927 -> j305610023;
	j3285501939 [label="而我想我最近在那份名單的第一順位了，對不？我想我應該……考慮他的理由，為什麼他會是這個樣子。譴責救不了任何靈魂。",shape=box,color=blue];
		j3285501939 -> j3996976838;
	j588611661 [label="我們總是向周圍的人隱藏著某種痛苦。某些我們想要庇護的東西，因為害怕別人會利用它。如果你說的是真的，我想我應該努力對他更友善一些。",shape=box,color=blue];
		j588611661 -> j3996976838;
	j620923835 [label="我無法想像一個人在那麼多年裡必須承受多少愛與失去。即使我親眼見證，這一切似乎還是難以置信。",shape=box,color=blue];
		j620923835 -> j556989362;
	j509898044 [label="有時候當我跟他說話時，我會忘記他已經活了多少個世紀。即使我親眼見證，這一切似乎還是難以置信。",shape=box,color=blue];
		j509898044 -> j1788231020;
	j1975602475 [label="總是有……細微差別的，對吧？總是有這樣或那樣做的理由。如果你說的是真的，我想我應該努力對他更友善一些。",shape=box,color=blue];
		j1975602475 -> j3996976838;
