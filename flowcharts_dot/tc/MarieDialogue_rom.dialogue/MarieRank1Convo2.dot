		65 -> 67;
	66 [label="不，他對新鮮事物很在行。我不會感到意外他已經研究過那些地下巢穴裡的自走機械，而且很快就會有自己的設計了。",shape=box,color=blue];
		66 -> 67;
	67 [label="他只是不認識你而已。里昂⋯⋯即使在最佳狀態也不太善於交際。這並非有意冒犯你。",shape=box,color=blue];
