	1412 [label="啊！午餐準備好了。我得走了。",shape=box,color=blue];
		1412 -> 1415;
	1410 [label="他會跟我們說，既然 Orokin 即將統治星系，這算不上真正的偷竊！然後我跟他就會開始對罵，里昂會懇求一絲平靜。",shape=box,color=blue];
		1410 -> 1413;
		1410 -> 1414;
	1415 [label="Chat ends.",color=orange];
	1413 [label="不過，羅瑟有帶夠糕點來分享嗎？",shape=box,color=red];
		1413 -> 1416;
	1414 [label="而那些糕點後來怎麼處理？",shape=box,color=red];
		1414 -> 1417;
	1416 [label="嗯，他有。但我不知道是他的本意，還是里昂的暴力威脅促使他這麼做。",shape=box,color=blue];
		1416 -> 1394;
	1417 [label="我們不能就這麼浪費它，不是嗎？",shape=box,color=blue];
