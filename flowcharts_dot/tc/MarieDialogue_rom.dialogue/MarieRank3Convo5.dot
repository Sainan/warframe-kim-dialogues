	1281 [label="我很好，你呢？",shape=box,color=red];
		1281 -> 1285;
	1280 [label="我的狀況不太好，不過謝謝你的關心。你好嗎？",shape=box,color=red];
		1280 -> 1284;
	1283 [label="我……現在應該向你坦白，我其實並不真的是……太陽的追隨者。",shape=box,color=red];
		1283 -> 1287;
	3947 [label="現在跟你說過話後感覺好多了。但有你在的每一天都讓我的日子更加明亮。",shape=box,color=red];
		3947 -> 3948;
