		1381 -> 1388;
	1382 [label="只是不要讓那個惡魔靠近半步。不然他會把糕點偷走！他沒吃飽就會偷甜食！",shape=box,color=blue];
		1382 -> 1389;
	1390 [label="他們還在療傷。他們的旅程尚未結束。",shape=box,color=red];
		1390 -> 1398;
	1391 [label="我希望能為他們做更多。",shape=box,color=red];
		1391 -> 1398;
	1392 [label="是的，你說得對。許多人尋求信仰就是希望信仰能帶給他們一種使命，一個方向。",shape=box,color=blue];
		1392 -> 1399;
	1393 [label="原來「Grineer」是那樣拼寫，謝謝！我非常高興得知就連一個被教導戰爭和死亡才是王道的種族，也能找到另一番使命。",shape=box,color=blue];
		1393 -> 1400;
	1386 [label="就是這種態度！我想，即使是惡魔，偶爾吃點糕點也無妨。",shape=box,color=blue];
		1386 -> 1394;
	1387 [label="不客氣。我真心希望我有讓你感到一絲欣慰。我知道你有讓我感到欣慰。",shape=box,color=blue];
		1387 -> 1402;
	1388 [label="啊，我抱怨歸抱怨，但即使最卑劣的惡魔，偶爾吃點糕點也無妨，對吧？",shape=box,color=blue];
