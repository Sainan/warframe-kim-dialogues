		1346 -> 1352;
		1346 -> 1353;
		1346 -> 1354;
	1348 [label="有時候，我想到自己有多少事都得靠自己摸索，反而會有點羨慕那孩子有機會接受正規訓練。",shape=box,color=red];
		1348 -> 1356;
	1349 [label="我認為沒有「好」的方式可以讓人走上戰爭的人生。無論是天生、養成，或是選擇。到頭來，最重要的還是要看你是什麼樣的人，以及你如何面對這個身份。",shape=box,color=red];
		1349 -> 1357;
	1347 [label="然而你周遭的那些人可能看起來疏遠或冷漠或耐心地坐等你先打招呼。",shape=box,color=blue];
		1347 -> 1355;
	1350 [label="是的，如果你像里昂那樣，我會告訴你，十鞭就是你該付的代價！但你不是。而且你已被寬恕。",shape=box,color=blue];
		1350 -> 1341;
	1351 [label="是的，我原諒你。如果你像里昂那樣，我會告訴你，十鞭就是你該付的代價。",shape=box,color=blue];
		1351 -> 1341;
