	1292 [label="你什麼意思？",shape=box,color=red];
		1292 -> 1301;
	1293 [label="我也曾經走過你走的路。",shape=box,color=red];
		1293 -> 1302;
	1288 [label="這個……只是……很難解釋。",shape=box,color=red];
		1288 -> 1297;
	1289 [label="煩心事太多。時間卻很少。",shape=box,color=red];
		1289 -> 1298;
	1290 [label="我有個朋友曾經形容這種感覺像是「蜘蛛」。牠們會時不時悄悄鑽進來。",shape=box,color=red];
		1290 -> 1299;
	1291 [label="有時候，一切……都讓我覺得好煩。不過我會沒事的。",shape=box,color=red];
		1291 -> 1300;
	1294 [label="我以為這會是個更了解你的機會……",shape=box,color=red];
		1294 -> 1303;
	1295 [label="我以為這樣很好玩。",shape=box,color=red];
		1295 -> 1304;
	1296 [label="老實說我也不知道。只是一時衝動。",shape=box,color=red];
		1296 -> 1305;
	3949 [label="我是認真的。如果讓你不舒服，我很抱歉。",shape=box,color=red];
		3949 -> 3951;
	3950 [label="抱歉。我只是在開玩笑。",shape=box,color=red];
		3950 -> 3951;
	1301 [label="我是太陽修女。我不應該……打打殺殺。參研者告訴我喃喃者並非活物，但我面對的其他敵人呢？",shape=box,color=blue];
		1301 -> 1310;
	1302 [label="+5 Chemistry",color=orange];
		1302 -> 1311;
	1297 [label="那我就不多問了。我知道有時候，有些事很難用言語表達。",shape=box,color=blue];
		1297 -> 1306;
	1298 [label="教堂裡有位修女也是這樣。她總是忙個不停。我有次發現她凌晨三點在擦銀器。",shape=box,color=blue];
		1298 -> 1307;
	1299 [label="啊，是的。我想我知道你在說什麼了。彷彿……一片遮住太陽的雲。",shape=box,color=blue];
		1299 -> 1308;
	1300 [label="就像個杯子，一點一滴地被水裝滿，對不？",shape=box,color=blue];
		1300 -> 1309;
	1303 [label="你不需要對我說這樣的謊才能更了解我。",shape=box,color=blue];
		1303 -> 1312;
	1304 [label="我不懂你的幽默。或許在未來，「風趣」的定義有所不同？",shape=box,color=blue];
		1304 -> 1313;
	1305 [label="我不知道是哪種衝動驅使你對我說這樣的謊。",shape=box,color=blue];
		1305 -> 1314;
	3951 [label="（法語）好了，我剛說到哪了？",shape=box,color=blue];
		3951 -> 1278;
	1310 [label="以太陽之名戰鬥……這就是我的道路嗎？我這個小瑪麗，要以他之名成為殺戮之人嗎？",shape=box,color=blue];
		1310 -> 1319;
		1310 -> 1320;
	1311 [label="我知道你是在打比方，但我快笑死了！我現在連路都走不了，我哪來什麼路給你走啦！",shape=box,color=blue];
		1311 -> 1321;
	1306 [label="我們的日子和心情有太多種方式可以出錯了。這些黑暗深淵會讓我們深陷泥濘而無法自拔，對不？",shape=box,color=blue];
		1306 -> 1315;
	1307 [label="我問她為什麼要這麼做，她說她睡不著，因為她太焦慮了。",shape=box,color=blue];
		1307 -> 1316;
	1308 [label="我們有個詞形容這個，叫做「倦怠」。一種疲憊和不滿，讓一切看起來……毫無意義。",shape=box,color=blue];
		1308 -> 1317;
	1309 [label="最終會裝滿並溢出。甚至有可能會打翻。然後一切看起來像場災難。",shape=box,color=blue];
		1309 -> 1318;
	1312 [label="一個靈魂不只是他們信奉的信仰。我是太陽修女，但我希望你看到的不只是這點，對不？",shape=box,color=blue];
		1312 -> 1322;
	1313 [label="對我而言，一點都不好笑。",shape=box,color=blue];
		1313 -> 1323;
	1314 [label="我只能希望這是善意的謊言，而不是消費我的殘酷玩笑。那麼，我將選擇追隨太陽的典範──",shape=box,color=blue];
		1314 -> 1324;
	1319 [label="我沒受過當士兵的訓練。不像那孩子。你也沒有。",shape=box,color=red];
		1319 -> 1328;
	1320 [label="我不是……一直以來都是個戰士。我也是經歷過許多磨難才學會的。",shape=box,color=red];
		1320 -> 1329;
	1321 [label="我腦中浮現的畫面快讓我笑死。在我笑到不行之前，告訴我，你指的是什麼？",shape=box,color=blue];
		1321 -> 1319;
		1321 -> 1320;
	1315 [label="當這種情況發生時，我們只能盡量對自己仁慈一點和耐心一點。",shape=box,color=blue];
		1315 -> 1325;
	1316 [label="每次我看到她這樣，我都會問她是否需要陪她。有時候她會說要，有時候她會說不要。",shape=box,color=blue];
		1316 -> 1306;
	1317 [label="又或許你的感覺是，想躲起來、想哭泣，更像是絕望，我也說不上來。",shape=box,color=blue];
		1317 -> 1335;
	1318 [label="你會清理打翻的水，把杯子扶正……然後一切又重新開始，對吧？",shape=box,color=blue];
		1318 -> 1327;
	1322 [label="我們可以選擇談論的話題多如天上繁星！",shape=box,color=blue];
		1322 -> 1330;
		1322 -> 1331;
	1323 [label="Update boolean DrifterFaithSol",color=orange];
		1323 -> 1332;
	1324 [label="──無論你是否信奉，我都追隨衪的信仰，並且原諒你。如果你像里昂那樣，我會告訴你，十鞭就是你該付的代價。",shape=box,color=blue];
		1324 -> 1333;
	1328 [label="是的！那小子和他的悲慘故事……一想到就讓我想哭。被以為是家人的人變成戰爭機器。",shape=box,color=blue];
		1328 -> 1337;
	1329 [label="是的！我聽說了，你經歷了許多苦難才學會像現在這樣戰鬥。死亡是殘酷的導師，我無法想像……",shape=box,color=blue];
		1329 -> 1337;
	1325 [label="我不知道這些話對你是否有意義。還是它們只不過是呼呼作聲的機台上發出的眾多小光點。",shape=box,color=blue];
		1325 -> 1334;
	1335 [label="我不認識你的這位朋友，但我想，他們有你真好。",shape=box,color=blue];
		1335 -> 1306;
	1327 [label="教堂裡有位神父的性格我覺得跟你很像。他可以承受一切，直到他再也承受不住了。",shape=box,color=blue];
		1327 -> 1336;
	1330 [label="對不起。這是個愚蠢的行為。",shape=box,color=red];
		1330 -> 1338;
	1331 [label="那你會原諒我嗎？",shape=box,color=red];
