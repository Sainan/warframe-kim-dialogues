		1332 -> 1340;
	1333 [label="Update boolean DrifterFaithSol",color=orange];
		1333 -> 1341;
	1337 [label="不。我寧願像現在這樣。我選擇握住主教的手，接受他提供的血清。",shape=box,color=blue];
		1337 -> 1343;
	1334 [label="確實，當你考慮到實際情況，我寫下這些文字的時候，根據你所處的時間，可能已經過了好幾天或許多年。",shape=box,color=blue];
		1334 -> 1342;
	1336 [label="當他感到不堪重負，一切都變得一團糟時，我會問他要不要我作伴。有時候要,有時候不要。",shape=box,color=blue];
		1336 -> 1306;
