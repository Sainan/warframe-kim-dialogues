		1367 -> 1371;
	1369 [label="但我懂你的意思。你看到你的另一個自己得到的訓練和指導，難免希望自己也能擁有相同待遇。尤其是當你孤立無援的時候。",shape=box,color=blue];
		1369 -> 1376;
