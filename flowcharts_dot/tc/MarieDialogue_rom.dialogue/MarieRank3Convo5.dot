	1371 [label="Chat ends.",color=orange];
	1376 [label="然而，我現在不免看到的是，一個孤獨的小子……和一隻與狼群奔跑的狼。",shape=box,color=blue];
		1376 -> 1383;
	1377 [label="當你從培育之初就被灌輸那是你唯一的使命、存在的唯一意義時，想打破這種模式是非常困難的。使命能帶給人慰藉。",shape=box,color=red];
		1377 -> 1384;
	1378 [label="我認為他們會。我遇到過幾名 Grineer，他們向我證明了 Grineer 一生中不只有戰爭和死亡。",shape=box,color=red];
		1378 -> 1385;
