	1340 [label="Chat ends.",color=orange];
	1341 [label="我們都只是盲者，努力在這個世界上摸索出自己的道路。",shape=box,color=blue];
		1341 -> 1346;
	1343 [label="但你了解困擾我的那種憂傷，那種不確定性。不是為戰爭而生，也不是為戰爭而養成。",shape=box,color=blue];
		1343 -> 1348;
		1343 -> 1349;
	1342 [label="總而言之，我知道當我寫下你並不孤單時，可能會讓人覺得很沒說服力。",shape=box,color=blue];
		1342 -> 1347;
	1344 [label="+10 Chemistry",color=orange];
