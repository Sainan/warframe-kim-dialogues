		1360 -> 1364;
	1363 [label="哈！是的，的確是。很好，我很高興聽到這個。",shape=box,color=blue];
		1363 -> 1367;
	1365 [label="是的，但那樣的話，你就不會是我們認識和喜愛的那隻瀟灑狼了，是嗎？我認為日尊把你放在最適合你的位置。",shape=box,color=blue];
		1365 -> 1369;
	1366 [label="是的，我完全同意。沒有人生來是為了投身戰爭。嗯，除了我聽說的那些 「Grin-ire」，即便如此……",shape=box,color=blue];
		1366 -> 1370;
	1364 [label="（法語）糕點！",shape=box,color=blue];
