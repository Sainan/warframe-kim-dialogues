	1599 [label="+5 Chemistry",color=orange];
		1599 -> 1605;
	1600 [label="無論如何，我要回去為亡骸精靈先生編花冠了。他大驚小怪的，但我不會聽他說不！",shape=box,color=blue];
		1600 -> 1606;
		1600 -> 1607;
