	1583 [label="+5 Chemistry",color=orange];
		1583 -> 1592;
	1584 [label="哦，不要以為我是要你對他們殘忍！不是的！要珍惜他們，因為他們很珍貴，而且他們會變成這樣並非出於自己的過錯！",shape=box,color=blue];
		1584 -> 1593;
