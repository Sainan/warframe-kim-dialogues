	1612 [label="+10 Chemistry",color=orange];
		1612 -> 1615;
	1613 [label="+5 Chemistry",color=orange];
		1613 -> 1616;
	1601 [label="怎麼會想問這個？",shape=box,color=red];
		1601 -> 1934;
	1602 [label="我希望有一天你能見到他。",shape=box,color=red];
		1602 -> 1609;
	1614 [label="（法語）謝謝！再見！",shape=box,color=blue];
		1614 -> 1617;
	1615 [label="哦！這是太陰的儀式之一。在靈魂逝世的週年紀念日，人們編織花冠或花圈，放在他們的頭骨或墳墓上。",shape=box,color=blue];
		1615 -> 1618;
	1616 [label="（法語）謝謝，我會的！再見！",shape=box,color=blue];
		1616 -> 1617;
	1609 [label="好的。但我想，困擾我的不是他的沉默。我問亡骸精靈先生，他身上裝飾的那個頭骨曾經是否屬於某個活著的靈魂。",shape=box,color=blue];
		1609 -> 1936;
	1617 [label="Chat ends.",color=orange];
	1618 [label="傳統的死者墓穴通常會讓屍體暴露在外，對吧？這樣你就可以這麼做。我想這種習俗的一部分依然流傳下來。",shape=box,color=blue];
		1618 -> 1619;
	1619 [label="我在一些 Orokin 藝術作品中看到了這點的反映，他們對頭骨的熱愛。",shape=box,color=blue];
		1619 -> 1620;
		1619 -> 1621;
		1619 -> 1622;
	1620 [label="這就難怪了。",shape=box,color=red];
		1620 -> 1623;
	1621 [label="越是改變，越是不變，對吧？",shape=box,color=red];
		1621 -> 1623;
	1622 [label="我想女兒曾經試過這麼做，你會讓她嫉妒的。",shape=box,color=red];
		1622 -> 1624;
	1623 [label="是的！都過了這麼久，影響依然存在。能夠知道即使是微小的碎片仍然留存，真的讓我感到無比欣慰。",shape=box,color=blue];
		1623 -> 1625;
	1624 [label="是嗎？那我期待有一天能見到她！我會告訴她我對他毫不留情。",shape=box,color=blue];
		1624 -> 1625;
	1625 [label="無論是假頭骨還是真頭骨，亡骸精靈先生都應該戴個花冠。而且當我寵愛他時，他變得好害羞！我想如果他能臉紅的話，他肯定會臉紅。這讓我微笑。",shape=box,color=blue];
		1625 -> 1626;
	1626 [label="（法語）再見！",shape=box,color=blue];
