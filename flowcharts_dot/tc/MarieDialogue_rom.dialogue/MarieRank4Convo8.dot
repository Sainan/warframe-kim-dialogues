digraph {
	"MarieRank4Convo8 begins." [color=orange];
		"MarieRank4Convo8 begins." -> j2786051379;
	j2786051379 [label="Check boolean MarieOtak1",color=orange];
		j2786051379 -> j1682791017 [label=true,color=green];
		j2786051379 -> j2588092754 [label=false,color=brown];
	j1682791017 [label="漂泊者，我越是思考關於亡骸精靈先生和 Otak 先生的事，就越感到困惑……",shape=box,color=blue];
		j1682791017 -> j1411144042;
		j1682791017 -> j3143100397;
	j2588092754 [label="漂泊者，我能跟你談談嗎？",shape=box,color=blue];
		j2588092754 -> j3042250235;
		j2588092754 -> j1350559949;
	j1411144042 [label="怎麼說？",shape=box,color=red];
		j1411144042 -> j2557897637;
	j3143100397 [label="具體來說是什麼問題？",shape=box,color=red];
		j3143100397 -> j2557897637;
	j3042250235 [label="當然。什麼事？",shape=box,color=red];
		j3042250235 -> j2683804225;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j2557897637 [label="我問亡骸精靈先生，他身上裝飾的那個頭骨曾經是否屬於某個活著的靈魂。",shape=box,color=blue];
		j2557897637 -> j1540286692;
	j2683804225 [label="我很好奇為什麼他的後腦勺還有另一張臉，看似孩子的塗鴉。",shape=box,color=blue];
		j2683804225 -> j1381210547;
	"Chat ends." [color=orange];
	j1540286692 [label="而亡骸精靈先生告訴我那是「他的」頭骨，但他承認 Loid 先生才是「本尊」。Loid 先生插話告訴我那是他自己頭骨的「複製」版本。",shape=box,color=blue];
		j1540286692 -> j1865126365;
	j1381210547 [label="我詢問過亡骸精靈先生和 Loid 先生，但他們都不願談論此事，只告訴了我一個名字──Otak。而他們說出這個名字時，帶著極大悲傷。",shape=box,color=blue];
		j1381210547 -> j584174187;
	j1865126365 [label="怎麼會這樣？「複製」又是什麼意思？這是真的頭骨還是假的？為什麼亡骸精靈先生和 Loid 先生的答案不同？",shape=box,color=blue];
		j1865126365 -> j2258908649;
		j1865126365 -> j4223212061;
		j1865126365 -> j678018956;
	j584174187 [label="所以我來找你說話，希望你能協助我。",shape=box,color=blue];
		j584174187 -> j1959744401;
	j2258908649 [label="我想從亡骸精靈的角度來看，那是他的頭骨。沒錯。但從 Loid 的角度來看，它是複製品。",shape=box,color=red];
		j2258908649 -> j63899073;
	j4223212061 [label="老實說我不知道它是用什麼做的。可能是骨頭。或者某種聚合物……",shape=box,color=red];
		j4223212061 -> j1400513853;
	j678018956 [label="我認為你糾結的問題根源是「亡骸精靈是真的嗎？」，而不是「頭骨是真的嗎？」。",shape=box,color=red];
		j678018956 -> j2904564570;
	j1959744401 [label="你能告訴我可憐的 Otak 先生的故事嗎？",shape=box,color=blue];
		j1959744401 -> j2562606374;
	j63899073 [label="我想這就是困惑我的地方。是兩位先生對它起源的看法。一個認為它是神聖的，另一個則認為是複製品。",shape=box,color=blue];
		j63899073 -> j3408858168;
	j1400513853 [label="我不知道令我困惑的是頭骨是用什麼做的。而是它的起源。或者說是兩位先生對其起源的看法。一個認為它是神聖的，另一個則認為它是複製品。",shape=box,color=blue];
		j1400513853 -> j3408858168;
	j2904564570 [label="+5 Chemistry",color=orange];
		j2904564570 -> j2912266575;
	j2562606374 [label="Otak 曾經是名哲士、Orokin 科學家，也是學者。發生在他身上的事算不上什麼愉快的故事。",shape=box,color=red];
		j2562606374 -> j2428199457;
	j3408858168 [label="Evaluate expressions",color=orange];
		j3408858168 -> j1124231826 [label="MarieCephalonSoul",color=purple];
		j3408858168 -> j103775113 [label="MarieCephalonNoSoul",color=purple];
		j3408858168 -> j3191887444 [label="MarieCephalonUnsure",color=purple];
		j3408858168 -> j218147482 [label="false",color=purple];
	j2912266575 [label="是的！你說得對，這就是問題的核心或者說問題的頭骨，哈哈。一個認為它是神聖的，另一個則認為它是複製品。",shape=box,color=blue];
		j2912266575 -> j3408858168;
	j2428199457 [label="據傳他是個天才，也是開發利用氬結晶體的幕後主腦。",shape=box,color=red];
		j2428199457 -> j1480015789;
	j1124231826 [label="當亡骸精靈先生連自己的骨頭都不屬於他時，他又如何能擁有靈魂？",shape=box,color=blue];
		j1124231826 -> j3641002969;
		j1124231826 -> j2539872037;
		j1124231826 -> j2019655713;
	j103775113 [label="這是否更證明了亡骸精靈先生沒有靈魂？",shape=box,color=blue];
		j103775113 -> j3641002969;
		j103775113 -> j2539872037;
		j103775113 -> j2019655713;
	j3191887444 [label="我知道你不確定亡骸精靈先生是否能擁有靈魂。但我不知道當他連自己的骨頭都不屬於他時，他又如何能擁有靈魂。",shape=box,color=blue];
		j3191887444 -> j3641002969;
		j3191887444 -> j2539872037;
		j3191887444 -> j2019655713;
	j218147482 [label="我說的是一件非常精密的擬人科技產品，不是嗎？一台複雜許多倍的留聲機。",shape=box,color=blue];
		j218147482 -> j580216576;
		j218147482 -> j2542891738;
		j218147482 -> j2488790436;
		j218147482 -> j1143625192;
		j218147482 -> j1289395464;
	j1480015789 [label="這些結晶獲取自虛空──它們是我們能夠製造許多強大 warframe 和武器的原因。",shape=box,color=red];
		j1480015789 -> j3286403755;
	j3641002969 [label="也許你是對的。也許他們真的只是人的複製品。但我不確定，無論如何我們必須把他們當作人來對待。",shape=box,color=red];
		j3641002969 -> j3856212609;
	j2539872037 [label="我認為亡骸精靈是例外，不是通則。他是作為一個人的複製品被製造出來的，而不是從一個人製造出來的。",shape=box,color=red];
		j2539872037 -> j3667114790;
	j2019655713 [label="你說得對。如果他們實際上不是被困在精密科技裡的靈魂，那可能更好、更人道……",shape=box,color=red];
		j2019655713 -> j1984590870;
	j580216576 [label="亡骸精靈也許沒有靈魂，但他很獨特。其他中樞，像 Otak，則是有靈魂。他們在被製造的過程中被損毀了。",shape=box,color=red];
		j580216576 -> j4080821347;
	j2542891738 [label="你說得對。那麼你希望我怎麼做？",shape=box,color=red];
		j2542891738 -> j1140349946;
	j2488790436 [label="你說得對。他們沒有靈魂。但這並不代表我們可以隨意對他們苛刻。",shape=box,color=red];
		j2488790436 -> j3960895226;
	j1143625192 [label="我不知道你說的對與否。但他們依然能思考和感受，而我們不能把他們當成物品來對待。",shape=box,color=red];
		j1143625192 -> j3354578395;
	j1289395464 [label="亡骸精靈有靈魂。所有中樞都有。",shape=box,color=red];
		j1289395464 -> j4002754376;
	j3286403755 [label="他專攻晶體學。而他的作品歸檔於這裡的實驗室。",shape=box,color=red];
		j3286403755 -> j1227341793;
