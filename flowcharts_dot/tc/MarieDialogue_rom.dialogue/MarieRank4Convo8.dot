	1586 [label="+5 Chemistry",color=orange];
		1586 -> 1594;
	1587 [label="+5 Chemistry",color=orange];
		1587 -> 1595;
	1579 [label="並非所有中樞都是作為懲罰而製造的。但火衛二上的事……變得很糟，他受到了嚴重的損壞。",shape=box,color=red];
		1579 -> 1588;
