	1927 [label="漂泊者，我越是思考關於亡骸精靈先生和 Otak 先生的事，就越感到困惑……",shape=box,color=blue];
		1927 -> 1930;
		1927 -> 1931;
	1926 [label="漂泊者，我能跟你談談嗎？",shape=box,color=blue];
		1926 -> 1928;
		1926 -> 1929;
	1930 [label="怎麼說？",shape=box,color=red];
		1930 -> 1934;
	1931 [label="具體來說是什麼問題？",shape=box,color=red];
		1931 -> 1934;
	1928 [label="當然。什麼事？",shape=box,color=red];
		1928 -> 1932;
	1929 [label="[結束]",shape=box,color=red];
		1929 -> 1933;
	1934 [label="我問亡骸精靈先生，他身上裝飾的那個頭骨曾經是否屬於某個活著的靈魂。",shape=box,color=blue];
		1934 -> 1936;
	1932 [label="我很好奇為什麼他的後腦勺還有另一張臉，看似孩子的塗鴉。",shape=box,color=blue];
		1932 -> 1935;
	1933 [label="Chat ends.",color=orange];
	1936 [label="而亡骸精靈先生告訴我那是「他的」頭骨，但他承認 Loid 先生才是「本尊」。Loid 先生插話告訴我那是他自己頭骨的「複製」版本。",shape=box,color=blue];
		1936 -> 1938;
	1935 [label="我詢問過亡骸精靈先生和 Loid 先生，但他們都不願談論此事，只告訴了我一個名字──Otak。而他們說出這個名字時，帶著極大悲傷。",shape=box,color=blue];
		1935 -> 1937;
	1938 [label="怎麼會這樣？「複製」又是什麼意思？這是真的頭骨還是假的？為什麼亡骸精靈先生和 Loid 先生的答案不同？",shape=box,color=blue];
		1938 -> 1940;
		1938 -> 1941;
		1938 -> 1942;
	1937 [label="所以我來找你說話，希望你能協助我。",shape=box,color=blue];
		1937 -> 1939;
	1940 [label="我想從亡骸精靈的角度來看，那是他的頭骨。沒錯。但從 Loid 的角度來看，它是複製品。",shape=box,color=red];
		1940 -> 1944;
	1941 [label="老實說我不知道它是用什麼做的。可能是骨頭。或者某種聚合物……",shape=box,color=red];
		1941 -> 1945;
	1942 [label="我認為你糾結的問題根源是「亡骸精靈是真的嗎？」，而不是「頭骨是真的嗎？」。",shape=box,color=red];
		1942 -> 1946;
	1939 [label="你能告訴我可憐的 Otak 先生的故事嗎？",shape=box,color=blue];
		1939 -> 1943;
	1944 [label="我想這就是困惑我的地方。是兩位先生對它起源的看法。一個認為它是神聖的，另一個則認為是複製品。",shape=box,color=blue];
		1944 -> 1948;
	1945 [label="我不知道令我困惑的是頭骨是用什麼做的。而是它的起源。或者說是兩位先生對其起源的看法。一個認為它是神聖的，另一個則認為它是複製品。",shape=box,color=blue];
		1945 -> 1948;
	1946 [label="+5 Chemistry",color=orange];
		1946 -> 1949;
	1943 [label="Otak 曾經是名哲士、Orokin 科學家，也是學者。發生在他身上的事算不上什麼愉快的故事。",shape=box,color=red];
		1943 -> 1947;
	1948 [label="Evaluate expressions",color=orange];
		1948 -> 1558 [label="MarieCephalonSoul",color=purple];
		1948 -> 1557 [label="MarieCephalonNoSoul",color=purple];
		1948 -> 1559 [label="MarieCephalonUnsure",color=purple];
		1948 -> 1560 [label="false",color=purple];
	1949 [label="是的！你說得對，這就是問題的核心或者說問題的頭骨，哈哈。一個認為它是神聖的，另一個則認為它是複製品。",shape=box,color=blue];
		1949 -> 1948;
	1947 [label="據傳他是個天才，也是開發利用氬結晶體的幕後主腦。",shape=box,color=red];
		1947 -> 1556;
	1558 [label="當亡骸精靈先生連自己的骨頭都不屬於他時，他又如何能擁有靈魂？",shape=box,color=blue];
		1558 -> 1562;
		1558 -> 1563;
		1558 -> 1564;
	1557 [label="這是否更證明了亡骸精靈先生沒有靈魂？",shape=box,color=blue];
		1557 -> 1562;
		1557 -> 1563;
		1557 -> 1564;
	1559 [label="我知道你不確定亡骸精靈先生是否能擁有靈魂。但我不知道當他連自己的骨頭都不屬於他時，他又如何能擁有靈魂。",shape=box,color=blue];
		1559 -> 1562;
		1559 -> 1563;
		1559 -> 1564;
	1560 [label="我說的是一件非常精密的擬人科技產品，不是嗎？一台複雜許多倍的留聲機。",shape=box,color=blue];
		1560 -> 1565;
		1560 -> 1566;
		1560 -> 1567;
		1560 -> 1568;
		1560 -> 1569;
	1556 [label="這些結晶獲取自虛空──它們是我們能夠製造許多強大 warframe 和武器的原因。",shape=box,color=red];
		1556 -> 1561;
	1562 [label="也許你是對的。也許他們真的只是人的複製品。但我不確定，無論如何我們必須把他們當作人來對待。",shape=box,color=red];
		1562 -> 1571;
	1563 [label="我認為亡骸精靈是例外，不是通則。他是作為一個人的複製品被製造出來的，而不是從一個人製造出來的。",shape=box,color=red];
		1563 -> 1572;
	1564 [label="你說得對。如果他們實際上不是被困在精密科技裡的靈魂，那可能更好、更人道……",shape=box,color=red];
		1564 -> 1573;
	1565 [label="亡骸精靈也許沒有靈魂，但他很獨特。其他中樞，像 Otak，則是有靈魂。他們在被製造的過程中被損毀了。",shape=box,color=red];
		1565 -> 1574;
	1566 [label="你說得對。那麼你希望我怎麼做？",shape=box,color=red];
		1566 -> 1575;
	1567 [label="你說得對。他們沒有靈魂。但這並不代表我們可以隨意對他們苛刻。",shape=box,color=red];
		1567 -> 1576;
	1568 [label="我不知道你說的對與否。但他們依然能思考和感受，而我們不能把他們當成物品來對待。",shape=box,color=red];
		1568 -> 1577;
	1569 [label="亡骸精靈有靈魂。所有中樞都有。",shape=box,color=red];
		1569 -> 1578;
	1561 [label="他專攻晶體學。而他的作品歸檔於這裡的實驗室。",shape=box,color=red];
		1561 -> 1570;
