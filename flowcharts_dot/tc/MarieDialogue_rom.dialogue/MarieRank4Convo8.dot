		j3509886475 -> j2533891950;
	j2887069292 [label="這更加證明了惡魔和他的同類理應受到譴責。但是，或許你對 Otak 和他的同類的看法是正確的，又或許相信這點能帶給你平靜。",shape=box,color=blue];
		j2887069292 -> j202843515;
	j202843515 [label="到頭來我可能是錯的。表現出善意和尊重永遠沒有壞處。",shape=box,color=blue];
		j202843515 -> j2056044030;
	j3657838681 [label="或許你說得對，但我不認為 Orokin 惡魔會比我們更了解靈魂的運作。他們並非偉大的神祇。",shape=box,color=blue];
		j3657838681 -> j202843515;
	j472439905 [label="或許你說得對，又或許相信這點能帶給你平靜。",shape=box,color=blue];
		j472439905 -> j202843515;
	j1777504029 [label="（法語）可憐東西……",shape=box,color=blue];
		j1777504029 -> j3134774711;
	j1430946540 [label="+5 Chemistry",color=orange];
		j1430946540 -> j276699306;
	j2042743991 [label="+5 Chemistry",color=orange];
		j2042743991 -> j3415480482;
	j2533891950 [label="+5 Chemistry",color=orange];
		j2533891950 -> j1257681369;
	j2056044030 [label="無論如何，我要回去為亡骸精靈先生編花冠了。他大驚小怪的，但我不會聽他說不！",shape=box,color=blue];
		j2056044030 -> j957936948;
		j2056044030 -> j1646247018;
		j2056044030 -> j2313483096;
	j3134774711 [label="Boolean MarieOtak1 is now true.",color=orange];
		j3134774711 -> j3951815689;
	j276699306 [label="是的，那才是明智之舉。我只是在隨口思考，也好奇在你看來他們究竟是什麼。你說得很對，表現善意與尊重，永遠不會有壞處。",shape=box,color=blue];
		j276699306 -> j3471913226;
	j3415480482 [label="或許你是對的。而且我希望你是對的！無論如何，我們必須善待他們，因為他們是會思考的生物。而能思考的，就能感受。",shape=box,color=blue];
		j3415480482 -> j3471913226;
	j1257681369 [label="無論如何，我們必須善待他們，因為他們是會思考的生物。而能思考的，就能感受。",shape=box,color=blue];
		j1257681369 -> j202843515;
