	j31715293 [label="+5 Chemistry",color=orange];
		j31715293 -> j3178663178;
	j2929372299 [label="怎麼會想問這個？",shape=box,color=red];
		j2929372299 -> j2557897637;
	j1006907106 [label="我希望有一天你能見到他。",shape=box,color=red];
		j1006907106 -> j1303893072;
	j1925847410 [label="（法語）謝謝！再見！",shape=box,color=blue];
		j1925847410 -> "Chat ends.";
	j1602626884 [label="哦！這是太陰的儀式之一。在靈魂逝世的週年紀念日，人們編織花冠或花圈，放在他們的頭骨或墳墓上。",shape=box,color=blue];
		j1602626884 -> j3697754277;
	j3178663178 [label="（法語）謝謝，我會的！再見！",shape=box,color=blue];
		j3178663178 -> "Chat ends.";
	j1303893072 [label="好的。但我想，困擾我的不是他的沉默。我問亡骸精靈先生，他身上裝飾的那個頭骨曾經是否屬於某個活著的靈魂。",shape=box,color=blue];
		j1303893072 -> j1540286692;
	j3697754277 [label="傳統的死者墓穴通常會讓屍體暴露在外，對吧？這樣你就可以這麼做。我想這種習俗的一部分依然流傳下來。",shape=box,color=blue];
		j3697754277 -> j81458830;
	j81458830 [label="我在一些 Orokin 藝術作品中看到了這點的反映，他們對頭骨的熱愛。",shape=box,color=blue];
		j81458830 -> j802061758;
		j81458830 -> j3893359786;
		j81458830 -> j3581373804;
	j802061758 [label="這就難怪了。",shape=box,color=red];
		j802061758 -> j3514291550;
	j3893359786 [label="越是改變，越是不變，對吧？",shape=box,color=red];
		j3893359786 -> j3514291550;
	j3581373804 [label="我想女兒曾經試過這麼做，你會讓她嫉妒的。",shape=box,color=red];
		j3581373804 -> j4293403326;
	j3514291550 [label="是的！都過了這麼久，影響依然存在。能夠知道即使是微小的碎片仍然留存，真的讓我感到無比欣慰。",shape=box,color=blue];
		j3514291550 -> j1332935599;
	j4293403326 [label="是嗎？那我期待有一天能見到她！我會告訴她我對他毫不留情。",shape=box,color=blue];
		j4293403326 -> j1332935599;
	j1332935599 [label="無論是假頭骨還是真頭骨，亡骸精靈先生都應該戴個花冠。而且當我寵愛他時，他變得好害羞！我想如果他能臉紅的話，他肯定會臉紅。這讓我微笑。",shape=box,color=blue];
		j1332935599 -> j1702153079;
	j1702153079 [label="（法語）再見！",shape=box,color=blue];
