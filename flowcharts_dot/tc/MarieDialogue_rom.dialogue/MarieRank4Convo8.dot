		j1129167056 -> j3509886475;
	j954107857 [label="+5 Chemistry",color=orange];
		j954107857 -> j2887069292;
	j3259851929 [label="哦，不要以為我是要你對他們殘忍！不是的！要珍惜他們，因為他們很珍貴，而且他們會變成這樣並非出於自己的過錯！",shape=box,color=blue];
		j3259851929 -> j202843515;
	j1102635234 [label="+5 Chemistry",color=orange];
		j1102635234 -> j3259851929;
	j4004280450 [label="+5 Chemistry",color=orange];
		j4004280450 -> j3657838681;
	j2527396360 [label="+5 Chemistry",color=orange];
		j2527396360 -> j472439905;
	j2676755886 [label="並非所有中樞都是作為懲罰而製造的。但火衛二上的事……變得很糟，他受到了嚴重的損壞。",shape=box,color=red];
		j2676755886 -> j1777504029;
