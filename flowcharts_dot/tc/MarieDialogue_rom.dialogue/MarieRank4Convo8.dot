	1596 [label="Update boolean MarieOtak1",color=orange];
		1596 -> 2945;
	1603 [label="是的，那才是明智之舉。我只是在隨口思考，也好奇在你看來他們究竟是什麼。你說得很對，表現善意與尊重，永遠不會有壞處。",shape=box,color=blue];
		1603 -> 1610;
	1604 [label="或許你是對的。而且我希望你是對的！無論如何，我們必須善待他們，因為他們是會思考的生物。而能思考的，就能感受。",shape=box,color=blue];
		1604 -> 1610;
	1605 [label="無論如何，我們必須善待他們，因為他們是會思考的生物。而能思考的，就能感受。",shape=box,color=blue];
		1605 -> 1593;
