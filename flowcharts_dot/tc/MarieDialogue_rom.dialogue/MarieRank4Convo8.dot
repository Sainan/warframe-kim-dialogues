	1591 [label="Update boolean MarieCephalonUnsure",color=orange];
		1591 -> 1599;
	1592 [label="這更加證明了惡魔和他的同類理應受到譴責。但是，或許你對 Otak 和他的同類的看法是正確的，又或許相信這點能帶給你平靜。",shape=box,color=blue];
		1592 -> 1593;
	1593 [label="到頭來我可能是錯的。表現出善意和尊重永遠沒有壞處。",shape=box,color=blue];
		1593 -> 1600;
	1594 [label="或許你說得對，但我不認為 Orokin 惡魔會比我們更了解靈魂的運作。他們並非偉大的神祇。",shape=box,color=blue];
		1594 -> 1593;
	1595 [label="或許你說得對，又或許相信這點能帶給你平靜。",shape=box,color=blue];
