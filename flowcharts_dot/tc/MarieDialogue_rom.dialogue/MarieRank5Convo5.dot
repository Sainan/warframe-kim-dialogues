	edge [fontname="Roboto Condensed"];

	"MarieRank5Convo5 begins." [color=orange];
		"MarieRank5Convo5 begins." -> j20182927;
	j20182927 [label="Check boolean MarieDating",color=orange];
		j20182927 -> j3057447165 [label=true,color=green];
		j20182927 -> j2481282841 [label=false,color=brown];
	j3057447165 [label="我的心肝，你好！我得告訴你一件最傻的事。",shape=box,color=blue];
		j3057447165 -> j2074428330;
		j3057447165 -> j1350559949;
	j2481282841 [label="你好！我得告訴你一件最傻的事。",shape=box,color=blue];
		j2481282841 -> j2074428330;
		j2481282841 -> j1350559949;
	j2074428330 [label="哦？發生什麼事了？",shape=box,color=red];
		j2074428330 -> j1169089214;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j1169089214 [label="我問鳥三先生他的生日是什麼時候，結果他不知道！多麼令人難過啊！",shape=box,color=blue];
		j1169089214 -> j4234723200;
	"Chat ends." [color=orange];
	j4234723200 [label="參研者都不知道自己的生日，我想這也說得通，畢竟他們出生時沒有說話的能力，也不像我們一樣知悉日曆。",shape=box,color=blue];
		j4234723200 -> j2439941243;
	j2439941243 [label="所以我想，這真是太悲慘了！我們必須立刻糾正這件事，對不？",shape=box,color=blue];
		j2439941243 -> j4099692158;
		j2439941243 -> j365963902;
		j2439941243 -> j3299635512;
	j4099692158 [label="我從沒想過這件事。",shape=box,color=red];
		j4099692158 -> j1243922164;
	j365963902 [label="你要怎麼找出他們是什麼時候出生的？",shape=box,color=red];
		j365963902 -> j2817771492;
	j3299635512 [label="你會讓他們挑自己的生日嗎？",shape=box,color=red];
		j3299635512 -> j3274284503;
	j1243922164 [label="對呀！Loid 先生也沒想過。當我發現這件事時，他臉上的表情充滿了悲傷……",shape=box,color=blue];
		j1243922164 -> j254028399;
	j2817771492 [label="起初，我想去查主教的記錄，或許他記錄了他們的出生時間，對不？",shape=box,color=blue];
		j2817771492 -> j2402114516;
	j3274284503 [label="「讓」？你說得好像這是由我決定的一樣！",shape=box,color=blue];
		j3274284503 -> j2817771492;
	j254028399 [label="他認為自己沒有率先想到這件事是他的錯，這讓我很心痛。這不是他的錯，他已經為這麼多人做了這麼多事……",shape=box,color=blue];
		j254028399 -> j2648202585;
	j2402114516 [label="Evaluate expressions",color=orange];
		j2402114516 -> j3565509995 [label="MarieEntratiComplete",color=purple];
		j2402114516 -> j3565509995 [label="MarieEntrati3a",color=purple];
		j2402114516 -> j677760186 [label="false",color=purple];
	j2648202585 [label="我們所有人都很幸運能認識 Loid 先生的善良。他無私的慷慨，像口深不見底的井。",shape=box,color=blue];
		j2648202585 -> j2202441928;
		j2648202585 -> j2641274006;
	j3565509995 [label="但後來我想起了……我與汰廢先生還有其他人的對話，然後我想……那可能不太明智。",shape=box,color=blue];
		j3565509995 -> j755862337;
	j677760186 [label="但他們似乎對尋找自己過去的記錄不感興趣。我知道想起自己的身世會有多麼痛苦。",shape=box,color=blue];
		j677760186 -> j755862337;
	j2202441928 [label="我們真的很幸運有他在這裡。",shape=box,color=red];
		j2202441928 -> j892639984;
	j2641274006 [label="我只是希望他能偶爾開心一點。",shape=box,color=red];
		j2641274006 -> j143339841;
	j755862337 [label="畢竟，我也不知道自己的出生日期。",shape=box,color=blue];
		j755862337 -> j54263511;
		j755862337 -> j769136953;
		j755862337 -> j1502060363;
	j892639984 [label="對呀，我們是。我們所有人都很幸運。",shape=box,color=blue];
		j892639984 -> j3542593548;
	j143339841 [label="他是個嚴肅的人，但我見過他微笑。在你最不經意的時候，他身上是有幽默感的。只需要有點耐心。",shape=box,color=blue];
		j143339841 -> j3542593548;
	j54263511 [label="如果這能讓你好過一點的話，我也不知道自己的生日。我猜那孩子也不記得了。",shape=box,color=red];
		j54263511 -> j730865736;
	j769136953 [label="生日過譽了。",shape=box,color=red];
		j769136953 -> j486523183;
	j1502060363 [label="自己挑更有趣，反而更「有意義」。",shape=box,color=red];
		j1502060363 -> j446931299;
	j3542593548 [label="Check boolean MarieDating",color=orange];
		j3542593548 -> j356027069 [label=true,color=green];
		j3542593548 -> j1594488876 [label=false,color=brown];
	j730865736 [label="又多了為你和你那個小子哭泣的理由！我們又多了共同點了！",shape=box,color=blue];
		j730865736 -> j3542593548;
	j486523183 [label="我一點也不覺得生日過譽了！我們必須慶祝那些仍與我們同在的人，就像我們慶祝那些已逝去的人一樣。",shape=box,color=blue];
		j486523183 -> j3542593548;
	j446931299 [label="「有意義」？我都不知道你會說高勒語！你是從我這裡學的嗎？",shape=box,color=blue];
		j446931299 -> j4251659899;
		j446931299 -> j3648847103;
	j356027069 [label="+20 Chemistry",color=orange];
		j356027069 -> j2162058726;
	j1594488876 [label="+20 Chemistry",color=orange];
		j1594488876 -> j2064289472;
	j4251659899 [label="我……我想這詞在兩種語言裡的意思是一樣的……",shape=box,color=red];
		j4251659899 -> j3190256326;
	j3648847103 [label="我一定是從你那裡學的。",shape=box,color=red];
		j3648847103 -> j2362750680;
	j2162058726 [label="來吧！我的心肝，快來！就算這件事最後沒有結果，心意永遠是最重要的！去看日曆吧！",shape=box,color=blue];
		j2162058726 -> "Chat ends.";
	j2064289472 [label="來吧！快來！就算這件事最後沒有結果，心意才是最重要的！去看日曆吧！",shape=box,color=blue];
		j2064289472 -> "Chat ends.";
	j3190256326 [label="噗！其他語言總是竊取高勒語的精華，然後照搬不誤！世道永遠不會改變！",shape=box,color=blue];
		j3190256326 -> j3542593548;
	j2362750680 [label="那你很聰明！高勒語是有史以來最美麗的語言之一，我很高興能把它帶到這個未來。",shape=box,color=blue];
		j2362750680 -> j3542593548;
}