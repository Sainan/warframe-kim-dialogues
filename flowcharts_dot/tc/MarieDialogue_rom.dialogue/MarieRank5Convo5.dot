		3092 -> 3094 [label=false,color=brown];
	3093 [label="我的心肝，你好！我得告訴你一件最傻的事。",shape=box,color=blue];
		3093 -> 3095;
		3093 -> 3096;
	3094 [label="你好！我得告訴你一件最傻的事。",shape=box,color=blue];
		3094 -> 3095;
		3094 -> 3096;
	3095 [label="哦？發生什麼事了？",shape=box,color=red];
		3095 -> 3097;
	3096 [label="[結束]",shape=box,color=red];
		3096 -> 3098;
	3097 [label="我問鳥三先生他的生日是什麼時候，結果他不知道！多麼令人難過啊！",shape=box,color=blue];
		3097 -> 3099;
	3098 [label="Chat ends.",color=orange];
	3099 [label="參研者都不知道自己的生日，我想這也說得通，畢竟他們出生時沒有說話的能力，也不像我們一樣知悉日曆。",shape=box,color=blue];
		3099 -> 3100;
	3100 [label="所以我想，這真是太悲慘了！我們必須立刻糾正這件事，對不？",shape=box,color=blue];
		3100 -> 3101;
		3100 -> 3102;
		3100 -> 3103;
	3101 [label="我從沒想過這件事。",shape=box,color=red];
		3101 -> 3104;
	3102 [label="你要怎麼找出他們是什麼時候出生的？",shape=box,color=red];
		3102 -> 3105;
	3103 [label="你會讓他們挑自己的生日嗎？",shape=box,color=red];
		3103 -> 3106;
	3104 [label="對呀！Loid 先生也沒想過。當我發現這件事時，他臉上的表情充滿了悲傷……",shape=box,color=blue];
		3104 -> 3107;
	3105 [label="起初，我想去查主教的記錄，或許他記錄了他們的出生時間，對不？",shape=box,color=blue];
		3105 -> 3108;
	3106 [label="「讓」？你說得好像這是由我決定的一樣！",shape=box,color=blue];
		3106 -> 3105;
	3107 [label="他認為自己沒有率先想到這件事是他的錯，這讓我很心痛。這不是他的錯，他已經為這麼多人做了這麼多事……",shape=box,color=blue];
		3107 -> 3109;
	3108 [label="Evaluate expressions",color=orange];
		3108 -> 3110 [label="MarieEntratiComplete",color=purple];
		3108 -> 3110 [label="MarieEntrati3a",color=purple];
		3108 -> 3111 [label="false",color=purple];
	3109 [label="我們所有人都很幸運能認識 Loid 先生的善良。他無私的慷慨，像口深不見底的井。",shape=box,color=blue];
		3109 -> 3112;
		3109 -> 3113;
	3110 [label="但後來我想起了……我與汰廢先生還有其他人的對話，然後我想……那可能不太明智。",shape=box,color=blue];
		3110 -> 3114;
	3111 [label="但他們似乎對尋找自己過去的記錄不感興趣。我知道想起自己的身世會有多麼痛苦。",shape=box,color=blue];
		3111 -> 3114;
	3112 [label="我們真的很幸運有他在這裡。",shape=box,color=red];
		3112 -> 3115;
	3113 [label="我只是希望他能偶爾開心一點。",shape=box,color=red];
		3113 -> 3116;
	3114 [label="畢竟，我也不知道自己的出生日期。",shape=box,color=blue];
		3114 -> 3117;
		3114 -> 3118;
		3114 -> 3119;
	3115 [label="對呀，我們是。我們所有人都很幸運。",shape=box,color=blue];
		3115 -> 3120;
	3116 [label="他是個嚴肅的人，但我見過他微笑。在你最不經意的時候，他身上是有幽默感的。只需要有點耐心。",shape=box,color=blue];
		3116 -> 3120;
	3117 [label="如果這能讓你好過一點的話，我也不知道自己的生日。我猜那孩子也不記得了。",shape=box,color=red];
		3117 -> 3121;
	3118 [label="生日過譽了。",shape=box,color=red];
		3118 -> 3122;
	3119 [label="自己挑更有趣，反而更「有意義」。",shape=box,color=red];
		3119 -> 3123;
	3120 [label="Check boolean MarieDating",color=orange];
		3120 -> 3125 [label=true,color=green];
		3120 -> 3124 [label=false,color=brown];
	3121 [label="又多了為你和你那個小子哭泣的理由！我們又多了共同點了！",shape=box,color=blue];
		3121 -> 3120;
	3122 [label="我一點也不覺得生日過譽了！我們必須慶祝那些仍與我們同在的人，就像我們慶祝那些已逝去的人一樣。",shape=box,color=blue];
		3122 -> 3120;
	3123 [label="「有意義」？我都不知道你會說高勒語！你是從我這裡學的嗎？",shape=box,color=blue];
		3123 -> 3126;
		3123 -> 3127;
	3125 [label="+20 Chemistry",color=orange];
		3125 -> 3129;
	3124 [label="+20 Chemistry",color=orange];
		3124 -> 3128;
	3126 [label="我……我想這詞在兩種語言裡的意思是一樣的……",shape=box,color=red];
		3126 -> 3130;
	3127 [label="我一定是從你那裡學的。",shape=box,color=red];
		3127 -> 3131;
	3129 [label="來吧！我的心肝，快來！就算這件事最後沒有結果，心意永遠是最重要的！去看日曆吧！",shape=box,color=blue];
		3129 -> 3132;
	3128 [label="來吧！快來！就算這件事最後沒有結果，心意才是最重要的！去看日曆吧！",shape=box,color=blue];
		3128 -> 3132;
	3130 [label="噗！其他語言總是竊取高勒語的精華，然後照搬不誤！世道永遠不會改變！",shape=box,color=blue];
		3130 -> 3120;
	3131 [label="那你很聰明！高勒語是有史以來最美麗的語言之一，我很高興能把它帶到這個未來。",shape=box,color=blue];
		3131 -> 3120;
	3132 [label="Chat ends.",color=orange];
}