	2821 [label="是的，我向你保證我很好。但謝謝。我很感激你的關心。",shape=box,color=blue];
		2821 -> 2830;
	2825 [label="哈！有趣的是，對不？你說得對。我原本沒在想我的雙腳，但現在我一想到它們，馬上就痛了起來。",shape=box,color=blue];
		2825 -> 2834;
	2826 [label="是的！你已經在做了，在陪我說話。人的心是個了不起的東西，不是嗎？我想我的雙腳彷彿無時無刻都在疼痛，但我卻已經學會只是將這種疼痛忽略。",shape=box,color=blue];
		2826 -> 2835;
