		j2458473611 -> j2257893296;
	j447300271 [label="但就像你說的，對不？所有像我這樣的不便，都蘊含神秘力量。我們只需要去發現它們。",shape=box,color=blue];
		j447300271 -> j852179302;
	j3386467039 [label="是的，確實如此。我知道你的沮喪。我有時會坐在那裡，盯著書櫃最上層的一本書，心想自己竟然無法拿到它，這是多麼不公平。",shape=box,color=blue];
		j3386467039 -> j2870267142;
	j2943715694 [label="前幾天我在聖堂裡擦拭所有的吊燈。Loid 先生求我停下來。",shape=box,color=blue];
		j2943715694 -> j3548925707;
	j261756024 [label="這事很難解釋，但我試試。我的腳，對不？我的腳。血清改變了我，賦予了我飄浮的能力──",shape=box,color=blue];
		j261756024 -> j3961355427;
	j4268779475 [label="聖光在上，我真的很抱歉。那你就明白那是什麼感覺了，對吧？",shape=box,color=blue];
		j4268779475 -> j1509756307;
	j988289510 [label="是的！哦，前幾天我在聖堂裡擦拭所有的吊燈。Loid 先生求我停下來。",shape=box,color=blue];
		j988289510 -> j693752938;
	j833579754 [label="但就像你說的，對不？所有像我們這樣的不便，都蘊含神秘力量。我們只需要去發現它們。",shape=box,color=blue];
		j833579754 -> j976326677;
	j2559820871 [label="是的，我知道你的沮喪。我有時會坐在那裡，盯著書櫃最上層的一本書，心想自己竟然無法拿到它，這是多麼不公平。",shape=box,color=blue];
		j2559820871 -> j1484438096;
	j2776737553 [label="是的！哦，你真的理解！例如──",shape=box,color=blue];
		j2776737553 -> j1332355411;
	j2257893296 [label="你知道當別人能夠行走，而你卻必須日復一日、時時刻刻地漂浮著，有多麼疲累嗎？",shape=box,color=blue];
		j2257893296 -> j3334231733;
	j852179302 [label="但是的，這很令人沮喪。我有時會坐在那裡，盯著書櫃最上層的一本書，心想自己竟然無法拿到它，這是多麼不公平。",shape=box,color=blue];
		j852179302 -> j2870267142;
	j2870267142 [label="那本書裡記載的知識，除了我沒有其他人會在意，那為什麼我卻被剝奪這份知識呢？接著就會有某個好心的靈魂出於憐憫，替我把它從原位取下來……",shape=box,color=blue];
		j2870267142 -> j2269963893;
	j3548925707 [label="我告訴他我需要保持忙碌，需要讓雙手一直動著。我認為他不太理解為什麼我必須如此活躍。",shape=box,color=blue];
		j3548925707 -> j2377033685;
	j3961355427 [label="但我仍然感覺得到它們，那些扭曲的東西曾威脅要吞噬我，威脅要粉碎我靈魂中所有的希望與喜悅。",shape=box,color=blue];
		j3961355427 -> j1929720625;
	j1509756307 [label="擁有一個不聽話、拖累靈魂的身體。即使是現在，這依然感覺很奇怪。血清改變了我，賦予了我漂浮的能力──",shape=box,color=blue];
		j1509756307 -> j236076384;
	j693752938 [label="我告訴他我需要保持忙碌，需要讓雙手一直動著。我認為他不太理解為什麼我必須如此活躍。",shape=box,color=blue];
		j693752938 -> j155367553;
	j976326677 [label="但我明白你的沮喪。哦，我太清楚了。我有時會坐在那裡，盯著書櫃最上層的一本書，心想自己竟然無法拿到它，這是多麼不公平。",shape=box,color=blue];
		j976326677 -> j1484438096;
	j1484438096 [label="那本書裡記載的知識，除了我沒有其他人會在意，那為什麼我卻被剝奪這份知識呢？接著就會有某個好心的靈魂出於憐憫，替我把它從原位取下來……",shape=box,color=blue];
		j1484438096 -> j2382917431;
		j1484438096 -> j909061116;
	j1332355411 [label="你知道當別人能夠行走，而你卻必須日復一日、時時刻刻地漂浮著，有多麼疲累嗎？",shape=box,color=blue];
		j1332355411 -> j3514371563;
	j3334231733 [label="我很高興能如此靈活，能夠拿到我想要的任何東西，別誤會我的意思。但這依然非常令人疲憊！",shape=box,color=blue];
		j3334231733 -> j2377033685;
	j2269963893 [label="而且這不是他們的錯，因為他們是在行善，是我需要幫助。而我需要幫助這件事，也不是他們的錯。唉，但是必須依賴那樣的協助，還真是令人沮喪呢。",shape=box,color=blue];
		j2269963893 -> j3544372544;
		j2269963893 -> j2104921456;
	j2377033685 [label="只是……能夠談論這一切真是太好了。我實在難以用言語完整形容。能夠討論我遭受的這種看不見的無聲瘟疫，實在難得。",shape=box,color=blue];
		j2377033685 -> j510718319;
	j1929720625 [label="它們總是讓我感到很痛。總是如此。即使現在，當我坐在這裡，如果我想到它們，我就會感到疼痛。但這種痛並不總是強烈到引起我注意。",shape=box,color=blue];
		j1929720625 -> j740119196;
		j1929720625 -> j922716076;
	j236076384 [label="但我仍然感覺得到它們，那些扭曲的東西曾威脅要吞噬我，威脅要粉碎我靈魂中所有的希望與喜悅。",shape=box,color=blue];
		j236076384 -> j2170276009;
	j155367553 [label="啊，知道這裡有人理解那是什麼感覺就讓我感到快樂。能夠理解我們遭受的這種看不見的無聲瘟疫，實在難得。",shape=box,color=blue];
		j155367553 -> j831570175;
	j2382917431 [label="那有什麼問題？",shape=box,color=red];
		j2382917431 -> j2668181798;
	j909061116 [label="對。我知道。而且這並不是他們的錯。",shape=box,color=red];
		j909061116 -> j2034149437;
	j3514371563 [label="我很高興能如此靈活，能夠拿到我想要的任何東西，別誤會我的意思。但這依然非常令人疲憊！",shape=box,color=blue];
		j3514371563 -> j155367553;
	j3544372544 [label="我很抱歉看到你忍受這一切。",shape=box,color=red];
		j3544372544 -> j3412015671;
	j2104921456 [label="而且你甚至無法表達那種沮喪。",shape=box,color=red];
		j2104921456 -> j3412015671;
	j510718319 [label="就像一隻小花使停在我肩上每天蜇我。不足以摧毀我，卻足以成為麻煩。",shape=box,color=blue];
		j510718319 -> j1537375797;
		j510718319 -> j468763779;
	j2170276009 [label="它們總是讓我感到很痛。總是如此。即使現在，當我坐在這裡，如果我想到它們，我就會感到疼痛。但這種痛並不總是強烈到引起我注意。",shape=box,color=blue];
		j2170276009 -> j3680133117;
		j2170276009 -> j496153026;
	j831570175 [label="就像一隻小花使停在我們身上，每天蜇我們一下。不足以摧毀我們，卻足以讓我們感到煩躁。",shape=box,color=blue];
		j831570175 -> j468763779;
		j831570175 -> j1537375797;
	j2668181798 [label="沒什麼！真的沒什麼不對。我確實需要幫助。但問題的根源就在於，我需要幫助。而且正如你所說的……這真的令人沮喪。",shape=box,color=blue];
		j2668181798 -> j3529662382;
	j2034149437 [label="是的！這不是他們的錯，因為他們是在行善，是我需要幫助。而我需要幫助這件事，也不是他們的錯。唉，但是必須依賴那樣的協助，還真是令人沮喪呢。",shape=box,color=blue];
		j2034149437 -> j3529662382;
	j3412015671 [label="+10 Chemistry",color=orange];
		j3412015671 -> j2377033685;
