	2827 [label="如果你確定的話。但如果你想聊的話，我在這裡。",shape=box,color=red];
		2827 -> 2838;
	2828 [label="我……知道那是什麼感覺。在我開始「循環」之前，我在渡域受了重傷。傷口雖然全癒了，但仍然時不時地痛得要命。每當痛起來，我都盡量掩飾自己的痛苦。",shape=box,color=red];
		2828 -> 2839;
