		j3073792241 -> j4113371363;
		j3073792241 -> j2389602617;
	j4164816434 [label="你已經在做了，在陪我說話。人的心是個了不起的東西，不是嗎？我想我的雙腳彷彿無時無刻都在疼痛，但我卻已經學會只是將這種疼痛忽略。",shape=box,color=blue];
