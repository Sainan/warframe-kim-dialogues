		2829 -> 2840;
	2830 [label="Chat ends.",color=orange];
	2834 [label="人的心真是個了不起的東西。我覺得很不可思議，我的雙腳彷彿無時無刻都在疼痛，而我卻已經學會只是將這種疼痛忽略。",shape=box,color=blue];
		2834 -> 2835;
		2834 -> 2836;
		2834 -> 2837;
	2835 [label="我也一樣。只要我一專注於……嗯，疼痛就會出現。有時候我也會想，是不是因為這樣，所以我才會讓自己一直保持忙碌。",shape=box,color=red];
		2835 -> 2845;
	2836 [label="有時我會生氣，想著如果我不總是被疼痛分散注意力，我能完成多少事。",shape=box,color=red];
