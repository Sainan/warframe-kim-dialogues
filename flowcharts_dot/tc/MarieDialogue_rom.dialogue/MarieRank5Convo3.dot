		j4113371363 -> j2716662205;
	j2389602617 [label="真的沒有治療的方法嗎？疼痛永遠不會停止了嗎？",shape=box,color=red];
		j2389602617 -> j3092160412;
	j4128337190 [label="如果你確定的話。但如果你想聊的話，我在這裡。",shape=box,color=red];
		j4128337190 -> j3879048089;
	j3872199845 [label="我……知道那是什麼感覺。在我開始「循環」之前，我在渡域受了重傷。傷口雖然全癒了，但仍然時不時地痛得要命。每當痛起來，我都盡量掩飾自己的痛苦。",shape=box,color=red];
		j3872199845 -> j2008150765;
	j1155634931 [label="長期存在的舊患有時跟新痛一樣麻煩。只因為它們反覆出現、一直伴隨我們，並不代表它們不值得被談起。",shape=box,color=red];
		j1155634931 -> j1615930417;
	j3136938417 [label="人的心真是個了不起的東西。我覺得很不可思議，我的雙腳彷彿無時無刻都在疼痛，而我卻已經學會只是將這種疼痛忽略。",shape=box,color=blue];
		j3136938417 -> j1198386493;
		j3136938417 -> j3232925051;
		j3136938417 -> j3043030787;
	j1198386493 [label="我也一樣。只要我一專注於……嗯，疼痛就會出現。有時候我也會想，是不是因為這樣，所以我才會讓自己一直保持忙碌。",shape=box,color=red];
		j1198386493 -> j4237857758;
	j3232925051 [label="有時我會生氣，想著如果我不總是被疼痛分散注意力，我能完成多少事。",shape=box,color=red];
		j3232925051 -> j1378819069;
	j3043030787 [label="你也總是一直感到疲倦嗎？有時我會想，這是不是我如此疲憊的原因。我總是在背後消耗精力去忍受疼痛。",shape=box,color=red];
		j3043030787 -> j4225997584;
