	j3529662382 [label="+5 Chemistry",color=orange];
		j3529662382 -> j155367553;
	j2699604754 [label="我也希望！但同樣地，它造就了我們一部分，對不？我們又憑什麼說我們哪些部分是重要的，哪些不重要？",shape=box,color=blue];
