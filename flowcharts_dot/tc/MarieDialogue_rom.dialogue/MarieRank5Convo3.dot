	2850 [label="你知道當別人能夠行走，而你卻必須日復一日、時時刻刻地漂浮著，有多麼疲累嗎？",shape=box,color=blue];
		2850 -> 2860;
	2851 [label="但是的，這很令人沮喪。我有時會坐在那裡，盯著書櫃最上層的一本書，心想自己竟然無法拿到它，這是多麼不公平。",shape=box,color=blue];
		2851 -> 2852;
	2852 [label="那本書裡記載的知識，除了我沒有其他人會在意，那為什麼我卻被剝奪這份知識呢？接著就會有某個好心的靈魂出於憐憫，替我把它從原位取下來……",shape=box,color=blue];
		2852 -> 2861;
	2853 [label="我告訴他我需要保持忙碌，需要讓雙手一直動著。我認為他不太理解為什麼我必須如此活躍。",shape=box,color=blue];
		2853 -> 2862;
	2858 [label="但我仍然感覺得到它們，那些扭曲的東西曾威脅要吞噬我，威脅要粉碎我靈魂中所有的希望與喜悅。",shape=box,color=blue];
		2858 -> 2867;
	2859 [label="擁有一個不聽話、拖累靈魂的身體。即使是現在，這依然感覺很奇怪。血清改變了我，賦予了我漂浮的能力──",shape=box,color=blue];
		2859 -> 2868;
	2863 [label="我告訴他我需要保持忙碌，需要讓雙手一直動著。我認為他不太理解為什麼我必須如此活躍。",shape=box,color=blue];
		2863 -> 2872;
	2864 [label="但我明白你的沮喪。哦，我太清楚了。我有時會坐在那裡，盯著書櫃最上層的一本書，心想自己竟然無法拿到它，這是多麼不公平。",shape=box,color=blue];
		2864 -> 2865;
	2865 [label="那本書裡記載的知識，除了我沒有其他人會在意，那為什麼我卻被剝奪這份知識呢？接著就會有某個好心的靈魂出於憐憫，替我把它從原位取下來……",shape=box,color=blue];
		2865 -> 2873;
		2865 -> 2874;
	2866 [label="你知道當別人能夠行走，而你卻必須日復一日、時時刻刻地漂浮著，有多麼疲累嗎？",shape=box,color=blue];
		2866 -> 2875;
	2860 [label="我很高興能如此靈活，能夠拿到我想要的任何東西，別誤會我的意思。但這依然非常令人疲憊！",shape=box,color=blue];
		2860 -> 2862;
	2861 [label="而且這不是他們的錯，因為他們是在行善，是我需要幫助。而我需要幫助這件事，也不是他們的錯。唉，但是必須依賴那樣的協助，還真是令人沮喪呢。",shape=box,color=blue];
		2861 -> 2869;
		2861 -> 2870;
	2862 [label="只是……能夠談論這一切真是太好了。我實在難以用言語完整形容。能夠討論我遭受的這種看不見的無聲瘟疫，實在難得。",shape=box,color=blue];
		2862 -> 2871;
	2867 [label="它們總是讓我感到很痛。總是如此。即使現在，當我坐在這裡，如果我想到它們，我就會感到疼痛。但這種痛並不總是強烈到引起我注意。",shape=box,color=blue];
		2867 -> 2811;
		2867 -> 2810;
	2868 [label="但我仍然感覺得到它們，那些扭曲的東西曾威脅要吞噬我，威脅要粉碎我靈魂中所有的希望與喜悅。",shape=box,color=blue];
		2868 -> 2876;
	2872 [label="啊，知道這裡有人理解那是什麼感覺就讓我感到快樂。能夠理解我們遭受的這種看不見的無聲瘟疫，實在難得。",shape=box,color=blue];
		2872 -> 2880;
	2873 [label="那有什麼問題？",shape=box,color=red];
		2873 -> 2881;
	2874 [label="對。我知道。而且這並不是他們的錯。",shape=box,color=red];
		2874 -> 2882;
	2875 [label="我很高興能如此靈活，能夠拿到我想要的任何東西，別誤會我的意思。但這依然非常令人疲憊！",shape=box,color=blue];
		2875 -> 2872;
	2869 [label="我很抱歉看到你忍受這一切。",shape=box,color=red];
		2869 -> 2877;
	2870 [label="而且你甚至無法表達那種沮喪。",shape=box,color=red];
		2870 -> 2877;
	2871 [label="就像一隻小花使停在我肩上每天蜇我。不足以摧毀我，卻足以成為麻煩。",shape=box,color=blue];
		2871 -> 2878;
		2871 -> 2879;
	2876 [label="它們總是讓我感到很痛。總是如此。即使現在，當我坐在這裡，如果我想到它們，我就會感到疼痛。但這種痛並不總是強烈到引起我注意。",shape=box,color=blue];
		2876 -> 2813;
		2876 -> 2812;
	2880 [label="就像一隻小花使停在我們身上，每天蜇我們一下。不足以摧毀我們，卻足以讓我們感到煩躁。",shape=box,color=blue];
		2880 -> 2879;
		2880 -> 2878;
	2881 [label="沒什麼！真的沒什麼不對。我確實需要幫助。但問題的根源就在於，我需要幫助。而且正如你所說的……這真的令人沮喪。",shape=box,color=blue];
		2881 -> 2885;
	2882 [label="是的！這不是他們的錯，因為他們是在行善，是我需要幫助。而我需要幫助這件事，也不是他們的錯。唉，但是必須依賴那樣的協助，還真是令人沮喪呢。",shape=box,color=blue];
		2882 -> 2885;
