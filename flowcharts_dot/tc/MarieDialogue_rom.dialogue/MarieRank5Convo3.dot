	2819 [label="+10 Chemistry",color=orange];
		2819 -> 2826;
	2816 [label="是的，恐怕是這樣。人的心真是個了不起的東西。我覺得很不可思議，我的雙腳彷彿無時無刻都在疼痛，而我卻已經學會只是將這種疼痛忽略。",shape=box,color=blue];
		2816 -> 2822;
		2816 -> 2823;
		2816 -> 2824;
	2817 [label="你已經在做了，在陪我說話。人的心是個了不起的東西，不是嗎？我想我的雙腳彷彿無時無刻都在疼痛，但我卻已經學會只是將這種疼痛忽略。",shape=box,color=blue];
