digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank2Convo4 begins." [color=orange];
		"MarieRank2Convo4 begins." -> j1946709042;
		"MarieRank2Convo4 begins." -> j3077029372;
		"MarieRank2Convo4 begins." -> j1350559949;
	j1946709042 [label="我想冒昧問你關於羅瑟的事，那樣會讓你大發雷霆嗎？",shape=box,color=red];
		j1946709042 -> j3780294130;
	j3077029372 [label="我能問你關於房間裡的大象的問題嗎？",shape=box,color=red];
		j3077029372 -> j2626306598;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j3780294130 [label="（法語）那個惡魔是個自以為無可挑剔的蠢貨！我寧願喝下一罐木漆，也不願再多花一分鐘聽他像舔舐自己毛皮的貓一樣自鳴得意！",shape=box,color=blue];
		j3780294130 -> j2842619497;
		j3780294130 -> j224542109;
	j2626306598 [label="（法語）什麼！哪裡？大象？！",shape=box,color=blue];
		j2626306598 -> j2702996431;
	"Chat ends." [color=orange];
	j2842619497 [label="那些話真的好有創意。",shape=box,color=red];
		j2842619497 -> j21040823;
	j224542109 [label="那我就……當做那些都不是什麼友善的話了。",shape=box,color=red];
		j224542109 -> j4090217238;
	j2702996431 [label="我只看到一條魚、一隻鳥，還有……無論汰廢先生是什麼。我在這個聖堂裡看到許多奇奇怪怪的東西，但就沒有看到大象──你是在開玩笑嗎？",shape=box,color=blue];
		j2702996431 -> j1967909356;
	j21040823 [label="+5 Chemistry",color=orange];
		j21040823 -> j3291044242;
	j4090217238 [label="+5 Chemistry",color=orange];
		j4090217238 -> j2887604663;
	j1967909356 [label="哦！很抱歉。那是我 1999 年的朋友們教我的一句俗語……",shape=box,color=red];
		j1967909356 -> j3993919965;
		j1967909356 -> j3079041935;
	j3291044242 [label="謝謝。確實很有創意，但你只是問了我一個問題，而我不該把矛頭指向你，抱歉。",shape=box,color=blue];
		j3291044242 -> j3218359144;
	j2887604663 [label="確實不友善。抱歉，我不該向你抱怨那些。",shape=box,color=blue];
		j2887604663 -> j3218359144;
	j3993919965 [label="我並不是指字面上的意思。",shape=box,color=red];
		j3993919965 -> j827839179;
	j3079041935 [label="現在我明白為什麼他們總覺得我困惑的樣子很可愛了……",shape=box,color=red];
		j3079041935 -> j713954526;
	j3218359144 [label="Evaluate expressions",color=orange];
		j3218359144 -> j1810827347 [label="MarieRoatheWarning",color=purple];
		j3218359144 -> j332907970 [label="DrifterRoathe",color=purple];
		j3218359144 -> j3852768784 [label="MarieRoatheSoldier",color=purple];
		j3218359144 -> j2626405431 [label="false",color=purple];
	j827839179 [label="+5 Chemistry",color=orange];
		j827839179 -> j3949234032;
	j713954526 [label="+5 Chemistry",color=orange];
		j713954526 -> j1981907613;
	j1810827347 [label="不過我很意外你又過來問我的想法。你之前已經很明確地說過，你不想再聽到我說他和他同類的壞話。",shape=box,color=blue];
		j1810827347 -> j419426725;
		j1810827347 -> j3722149152;
	j332907970 [label="老實說，我承認我不清楚應不應該繼續這場對話。你似乎像飛蛾撲火那樣，被他深深吸引。",shape=box,color=blue];
		j332907970 -> j3627092854;
		j332907970 -> j442155391;
	j3852768784 [label="還想找他當盟友？你帶他加入你的狼群是在玩危險的遊戲。他很可能在你最意想不到的時候扯出你的喉嚨。",shape=box,color=blue];
		j3852768784 -> j3934042178;
		j3852768784 -> j1642277364;
	j2626405431 [label="我很意外你會來找我。很明顯我對那個惡魔印像極差。",shape=box,color=blue];
		j2626405431 -> j1151984761;
		j2626405431 -> j2848630936;
	j3949234032 [label="如果真有大象我也不會感到意外！這地方似乎就有收容各種各樣的奇珍異獸。",shape=box,color=blue];
		j3949234032 -> j849816942;
	j1981907613 [label="是的，挺有魅力的，不是嗎？我經常對 Loid 先生說些什麼，然後他看我的眼神好像我完全讓他措手不及一樣。",shape=box,color=blue];
		j1981907613 -> j2572180984;
	j419426725 [label="我的回應過激了，為此我深感抱歉。我不想在還沒搞清楚狀況之前就譴責他──我在試圖從各方面理解他。",shape=box,color=red];
		j419426725 -> j3315763870;
	j3722149152 [label="我確實不想。他的經歷很難讓人懂。但我很好奇，你是否願意告訴我你們倆是怎麼認識的。",shape=box,color=red];
		j3722149152 -> j4104534058;
	j3627092854 [label="我只是想找出他為什麼會這樣。我在試圖理解他。",shape=box,color=red];
		j3627092854 -> j1612162009;
	j442155391 [label="如果我能更了解他，也許就能幫助我弄清楚如何引導他走上一條稍微……更溫和的道路。",shape=box,color=red];
		j442155391 -> j2243617174;
	j3934042178 [label="我知道。但我不能因為他為了服務他的人民而做出必須做的事就恨他。我曾經也不得不做出同樣選擇。",shape=box,color=red];
		j3934042178 -> j3883088276;
	j1642277364 [label="他是 Orokin 帝國有史以來最厲害的 Orokin 之一。拒絕那種幫助簡直愚蠢至極。",shape=box,color=red];
		j1642277364 -> j736934106;
	j1151984761 [label="我知道，但你肯定更了解他。我在嘗試更好地了解他。",shape=box,color=red];
		j1151984761 -> j2572656654;
	j2848630936 [label="這就是為什麼我要問你關於他的事。我想理解他，而我不太相信他以自己觀點講述的故事。",shape=box,color=red];
		j2848630936 -> j855250348;
	j849816942 [label="這句話是什麼意思？如果房間裡有大象，為什麼我們不願談論牠？",shape=box,color=blue];
		j849816942 -> j1163392231;
	j2572180984 [label="而對於一個本可以成為女王貼身侍從的人來說，我為此感到自豪。",shape=box,color=blue];
		j2572180984 -> j849816942;
	j3315763870 [label="Add 1 to Thermostat counter",color=orange];
		j3315763870 -> j3460944704;
	j4104534058 [label="Add 1 to Thermostat counter",color=orange];
		j4104534058 -> j2072635794;
	j1612162009 [label="Add -1 to Thermostat counter",color=orange];
		j1612162009 -> j1915511443;
	j2243617174 [label="Add 1 to Thermostat counter",color=orange];
		j2243617174 -> j602206282;
	j3883088276 [label="Add 1 to Thermostat counter",color=orange];
		j3883088276 -> j1196647575;
	j736934106 [label="Add -1 to Thermostat counter",color=orange];
		j736934106 -> j1245302542;
	j2572656654 [label="Add -1 to Thermostat counter",color=orange];
		j2572656654 -> j3027473382;
	j855250348 [label="Add 1 to Thermostat counter",color=orange];
		j855250348 -> j2459098920;
	j1163392231 [label="我無法想像，對於大多數身邊沒有會飛的頭顱和會說話的動物來說，大象不是理所當然的討論話題。",shape=box,color=blue];
		j1163392231 -> j1815616554;
	j3460944704 [label="+5 Chemistry",color=orange];
		j3460944704 -> j529327997;
	j2072635794 [label="而你以為我不懂嗎？我不是傻的──即使被傳送到這裡而且轉變成這樣，我都沒有歇斯底里。",shape=box,color=blue];
		j2072635794 -> j1452338358;
		j2072635794 -> j1792369347;
	j1915511443 [label="我擔心的是理解到什麼程度。但你不需要我對你說教，我也不是你老母，而我並不想在這段友誼初期就使其變調……",shape=box,color=blue];
		j1915511443 -> j1520339146;
	j602206282 [label="+5 Chemistry",color=orange];
		j602206282 -> j2501634926;
	j1196647575 [label="+5 Chemistry",color=orange];
		j1196647575 -> j3186553230;
	j1245302542 [label="我只是敦促你務必謹慎。我想，他能迷得太陰把天上的星星摘給他。",shape=box,color=blue];
		j1245302542 -> j3168541195;
	j3027473382 [label="我擔心的是理解到什麼程度。但你不需要我對你說教。",shape=box,color=blue];
		j3027473382 -> j3332362684;
	j2459098920 [label="+5 Chemistry",color=orange];
		j2459098920 -> j2255242004;
	j1815616554 [label="……我疑似回答了自己的問題，對嗎？",shape=box,color=blue];
		j1815616554 -> j3668475940;
	j529327997 [label="我感謝並接受你的道歉，但也請顧及到我已經被傳送和轉變，並發現自己被不可能之事包圍。",shape=box,color=blue];
		j529327997 -> j2452277906;
	j1452338358 [label="沒關係。我自己去找那個惡魔本人談談。",shape=box,color=red];
		j1452338358 -> j509949910;
	j1792369347 [label="抱歉。我並不是想和你爭論，我不是那個意思。",shape=box,color=red];
		j1792369347 -> j97776254;
		j1792369347 -> j3431721786;
	j1520339146 [label="我只是擔心你。他是個奸詐狡猾而且善於操控的野獸……",shape=box,color=blue];
		j1520339146 -> j835589959;
	j2501634926 [label="而我會宣布你為太陽之聖人，即使你只是嘗試這麼做。",shape=box,color=blue];
		j2501634926 -> j835589959;
	j3186553230 [label="是的，士兵的詛咒……燒毀城鎮以拯救國家。殺死一人以拯救家庭。但這種恐怖的事要到哪才會止步？",shape=box,color=blue];
		j3186553230 -> j3013510196;
	j3168541195 [label="記住他到底是誰、是什麼……既不是神，也不是野獸，而是個人。一個自視甚高的人。",shape=box,color=blue];
		j3168541195 -> j835589959;
	j3332362684 [label="我想，他能迷得太陰把天上的星星摘給他。我只能說，請小心。",shape=box,color=blue];
		j3332362684 -> j835589959;
	j2255242004 [label="那麼你是明智的，不會去聽他的甜言蜜語。我想，他能迷得太陰把天上的星星摘給他。",shape=box,color=blue];
		j2255242004 -> j835589959;
	j3668475940 [label="你有。這句子的意思是「我們能談談我們都在迴避的話題嗎？」，這就好像我們都沒有在談論房間裡顯而易見的大象一樣。",shape=box,color=red];
		j3668475940 -> j3361340335;
	j2452277906 [label="當你認為我無法理解或無法同情他人的故事時，請再多顧慮一下，好嗎？",shape=box,color=blue];
		j2452277906 -> j410486861;
	j509949910 [label="（法語）隨你。",shape=box,color=blue];
		j509949910 -> "Chat ends.";
	j97776254 [label="他是個士兵。他為了「更偉大的使命」不得不做可怕的事情。我知道那是什麼感覺。有時候，那種遭遇會把你變成……嗯。像他那樣。",shape=box,color=red];
		j97776254 -> j730960628;
	j3431721786 [label="他活了好幾百年，甚至可能好幾千年。誰知道那對一個人到底會造成多少影響、多少痛苦，和多少折磨？我知道那是什麼感覺。",shape=box,color=red];
		j3431721786 -> j2007844592;
	j835589959 [label="但你想問我關於惡魔本人的事，不是嗎？你想知道什麼？",shape=box,color=blue];
		j835589959 -> j2621925639;
		j835589959 -> j1981852292;
		j835589959 -> j1719444640;
	j3013510196 [label="我們必須透過統計學家的眼光看待戰爭，因為如果我們從陣亡者的角度看它，我們將永遠不會停止哭泣。",shape=box,color=blue];
		j3013510196 -> j835589959;
	j3361340335 [label="如果讓我再猜一次這頭大象的特徵……他的皮膚會是藍色的嗎？",shape=box,color=blue];
		j3361340335 -> j3218359144;
	j410486861 [label="而就我而言，也將重新考慮不對你說教。",shape=box,color=blue];
		j410486861 -> j1452338358;
		j410486861 -> j1753336900;
	j730960628 [label="+5 Chemistry",color=orange];
		j730960628 -> j1462757955;
	j2007844592 [label="+5 Chemistry",color=orange];
		j2007844592 -> j2180430562;
	j2621925639 [label="為什麼你這麼不喜歡他？",shape=box,color=red];
		j2621925639 -> j2780873851;
	j1981852292 [label="為什麼源拓氏把他留給你和里昂？",shape=box,color=red];
		j1981852292 -> j1716374173;
	j1719444640 [label="我很好奇你們是怎麼認識的？",shape=box,color=red];
		j1719444640 -> j3714923143;
	j1753336900 [label="同意。",shape=box,color=red];
		j1753336900 -> j3457806400;
	j1462757955 [label="啊，現在我反倒覺得自己很傻。是的，你當然知道，就像你說的，以「使命」之名殺人是什麼感覺……當然你會試圖去理解做過同樣事情的人。",shape=box,color=blue];
		j1462757955 -> j2621378504;
	j2180430562 [label="啊，現在我反倒覺得自己很傻。是的，你當然知道一直反復活過來是什麼感覺……當然你會試圖去認識經歷相同的人。",shape=box,color=blue];
		j2180430562 -> j2621378504;
	j2780873851 [label="這難道還不明顯嗎？他的行為就像一隻堅持要標記領地並把東西從架子上打翻的大貓。",shape=box,color=blue];
		j2780873851 -> j3392199427;
		j2780873851 -> j3730823979;
	j1716374173 [label="當日曜主教──源拓氏──最後一次離開時，他把那個惡魔留在了我們家門口。傷痕累累、鮮血直流，甚至幾乎都無法想起自己的名字了。",shape=box,color=blue];
		j1716374173 -> j1315425540;
	j3714923143 [label="那個惡魔來找我們的那晚正下著暴風雨。可怕的雷鳴震動著大教堂的牆壁。",shape=box,color=blue];
		j3714923143 -> j4132570505;
	j3457806400 [label="Boolean MarieRoatheWarning is now false.",color=orange];
		j3457806400 -> j2326359558;
	j2621378504 [label="我們來達成共識。當你認為我無法理解或無法同情他人的故事時，請再多顧慮一下，好嗎？",shape=box,color=blue];
		j2621378504 -> j410486861;
	j3392199427 [label="就我個人而言，我比較喜歡貓。",shape=box,color=red];
		j3392199427 -> j3109250448;
	j3730823979 [label="你不喜歡貓嗎？",shape=box,color=red];
		j3730823979 -> j1572873410;
	j1315425540 [label="我現在才知道，他不久前才剛被注射血清，而這種轉變，如果非自願的話，是……非常痛苦的。",shape=box,color=blue];
		j1315425540 -> j197704804;
	j4132570505 [label="Check boolean MarieLyonVisions",color=orange];
		j4132570505 -> j816535788 [label=true,color=green];
		j4132570505 -> j4250590963 [label=false,color=brown];
	j2326359558 [label="太好了！現在，你想問我關於惡魔本人的事，不是嗎？你想知道什麼？",shape=box,color=blue];
		j2326359558 -> j2621925639;
		j2326359558 -> j1981852292;
		j2326359558 -> j1719444640;
	j3109250448 [label="貓真的很神奇，但這是當貓是貓的時候！他是個成年人，而且已經活好多年了！",shape=box,color=blue];
		j3109250448 -> j3130922987;
	j1572873410 [label="我喜歡，但這是當貓是貓的時候！他是個人，一個成年人，而且已經活好多年了！",shape=box,color=blue];
		j1572873410 -> j3130922987;
	j197704804 [label="主教俯視著惡魔說道：「被放逐的 Xata 的異端者──Uriel，回答我，Orokin 能否得到寬恕」？",shape=box,color=blue];
		j197704804 -> j1204456524;
	j816535788 [label="這次，如果里昂告訴你關於那場震動我們家的暴風雨，他是在陳述事實，那確實是我們的共同經歷。",shape=box,color=blue];
		j816535788 -> j4250590963;
	j4250590963 [label="我想，讓這等邪惡在這般大混亂中登場，簡直是老套的絕妙。",shape=box,color=blue];
		j4250590963 -> j1716374173;
	j3130922987 [label="活得比任何人應有的壽命都還久，無論是藍色皮膚的，還是如他們所願被轉變得面目全非的人。",shape=box,color=blue];
		j3130922987 -> j4282009613;
		j3130922987 -> j1458853840;
		j3130922987 -> j1080772348;
	j1204456524 [label="而在一聲雷鳴中，彷彿諸神親自召喚他離開一樣，主教就這麼消失了。",shape=box,color=blue];
		j1204456524 -> j1593462830;
	j4282009613 [label="在 Orokin 時代，基因改造自己的外形是種時尚宣言。但他們和我們一樣都是人類。或者，我想……曾經是。",shape=box,color=red];
		j4282009613 -> j3557195304;
	j1458853840 [label="除了尾巴以外，老實說他看起來……比當年許多 Orokin 還更像人類。",shape=box,color=red];
		j1458853840 -> j2072013933;
	j1080772348 [label="別擔心，我覺得你比他漂亮多了。",shape=box,color=red];
		j1080772348 -> j2617491924;
	j1593462830 [label="而留給我們來面對……他。那個惡魔。",shape=box,color=blue];
		j1593462830 -> j2521217600;
	j3557195304 [label="是的，我想我都搞不清楚現在自己是什麼了。一部分瑪麗、一部分……「Wisp」、一部分……那個現在共用我血管的什麼感染體。",shape=box,color=blue];
		j3557195304 -> j819480606;
	j2072013933 [label="是的，我之前在看主教的一幅舊肖像，他看起來更像惡魔。他告訴我 Orokin 的行事作風，他們過去如何改造自己。",shape=box,color=blue];
		j2072013933 -> j3570506640;
	j2617491924 [label="Check boolean DrifterMarie",color=orange];
		j2617491924 -> j3961711317 [label=true,color=green];
		j2617491924 -> j2996836341 [label=false,color=brown];
	j2521217600 [label="主教把他留給我們……或許是為了照看他的靈魂？又或至少看管束縛他的枷鎖。（法語）我寧願把他送回地獄。",shape=box,color=blue];
		j2521217600 -> j3128134366;
		j2521217600 -> j633892980;
	j819480606 [label="或許下次可以再聊這個話題。",shape=box,color=blue];
		j819480606 -> j2521979911;
