		640 -> 649;
	641 [label="Add 1 to Thermostat",color=orange];
		641 -> 650;
	638 [label="Add 1 to Thermostat",color=orange];
		638 -> 647;
	639 [label="Add -1 to Thermostat",color=orange];
		639 -> 648;
	636 [label="Add -1 to Thermostat",color=orange];
		636 -> 645;
	637 [label="Add 1 to Thermostat",color=orange];
		637 -> 646;
	635 [label="我無法想像，對於大多數身邊沒有會飛的頭顱和會說話的動物來說，大象不是理所當然的討論話題。",shape=box,color=blue];
		635 -> 644;
	651 [label="+5 Chemistry",color=orange];
		651 -> 660;
	652 [label="而你以為我不懂嗎？我不是傻的──即使被傳送到這裡而且轉變成這樣，我都沒有歇斯底里。",shape=box,color=blue];
		652 -> 661;
		652 -> 662;
	649 [label="我擔心的是理解到什麼程度。但你不需要我對你說教，我也不是你老母，而我並不想在這段友誼初期就使其變調……",shape=box,color=blue];
		649 -> 658;
	650 [label="+5 Chemistry",color=orange];
		650 -> 659;
	647 [label="+5 Chemistry",color=orange];
		647 -> 656;
	648 [label="我只是敦促你務必謹慎。我想，他能迷得太陰把天上的星星摘給他。",shape=box,color=blue];
		648 -> 657;
	645 [label="我擔心的是理解到什麼程度。但你不需要我對你說教。",shape=box,color=blue];
		645 -> 654;
	646 [label="+5 Chemistry",color=orange];
		646 -> 655;
	644 [label="……我疑似回答了自己的問題，對嗎？",shape=box,color=blue];
		644 -> 653;
	660 [label="我感謝並接受你的道歉，但也請顧及到我已經被傳送和轉變，並發現自己被不可能之事包圍。",shape=box,color=blue];
		660 -> 666;
	661 [label="沒關係。我自己去找那個惡魔本人談談。",shape=box,color=red];
		661 -> 667;
	662 [label="抱歉。我並不是想和你爭論，我不是那個意思。",shape=box,color=red];
		662 -> 668;
		662 -> 669;
	658 [label="我只是擔心你。他是個奸詐狡猾而且善於操控的野獸……",shape=box,color=blue];
		658 -> 664;
	659 [label="而我會宣布你為太陽之聖人，即使你只是嘗試這麼做。",shape=box,color=blue];
		659 -> 664;
	656 [label="是的，士兵的詛咒……燒毀城鎮以拯救國家。殺死一人以拯救家庭。但這種恐怖的事要到哪才會止步？",shape=box,color=blue];
		656 -> 665;
	657 [label="記住他到底是誰、是什麼……既不是神，也不是野獸，而是個人。一個自視甚高的人。",shape=box,color=blue];
		657 -> 664;
	654 [label="我想，他能迷得太陰把天上的星星摘給他。我只能說，請小心。",shape=box,color=blue];
		654 -> 664;
	655 [label="那麼你是明智的，不會去聽他的甜言蜜語。我想，他能迷得太陰把天上的星星摘給他。",shape=box,color=blue];
		655 -> 664;
	653 [label="你有。這句子的意思是「我們能談談我們都在迴避的話題嗎？」，這就好像我們都沒有在談論房間裡顯而易見的大象一樣。",shape=box,color=red];
		653 -> 663;
	666 [label="當你認為我無法理解或無法同情他人的故事時，請再多顧慮一下，好嗎？",shape=box,color=blue];
		666 -> 673;
	667 [label="（法語）隨你。",shape=box,color=blue];
		667 -> 674;
	668 [label="他是個士兵。他為了「更偉大的使命」不得不做可怕的事情。我知道那是什麼感覺。有時候，那種遭遇會把你變成……嗯。像他那樣。",shape=box,color=red];
		668 -> 675;
	669 [label="他活了好幾百年，甚至可能好幾千年。誰知道那對一個人到底會造成多少影響、多少痛苦，和多少折磨？我知道那是什麼感覺。",shape=box,color=red];
		669 -> 676;
	664 [label="但你想問我關於惡魔本人的事，不是嗎？你想知道什麼？",shape=box,color=blue];
		664 -> 670;
		664 -> 671;
		664 -> 672;
	665 [label="我們必須透過統計學家的眼光看待戰爭，因為如果我們從陣亡者的角度看它，我們將永遠不會停止哭泣。",shape=box,color=blue];
		665 -> 664;
	663 [label="如果讓我再猜一次這頭大象的特徵……他的皮膚會是藍色的嗎？",shape=box,color=blue];
		663 -> 618;
	673 [label="而就我而言，也將重新考慮不對你說教。",shape=box,color=blue];
		673 -> 661;
		673 -> 680;
	674 [label="Chat ends.",color=orange];
	675 [label="+5 Chemistry",color=orange];
		675 -> 681;
	676 [label="+5 Chemistry",color=orange];
		676 -> 682;
	670 [label="為什麼你這麼不喜歡他？",shape=box,color=red];
		670 -> 677;
	671 [label="為什麼源拓氏把他留給你和里昂？",shape=box,color=red];
		671 -> 678;
	672 [label="我很好奇你們是怎麼認識的？",shape=box,color=red];
		672 -> 679;
	680 [label="同意。",shape=box,color=red];
		680 -> 687;
	681 [label="啊，現在我反倒覺得自己很傻。是的，你當然知道，就像你說的，以「使命」之名殺人是什麼感覺……當然你會試圖去理解做過同樣事情的人。",shape=box,color=blue];
		681 -> 688;
	682 [label="啊，現在我反倒覺得自己很傻。是的，你當然知道一直反復活過來是什麼感覺……當然你會試圖去認識經歷相同的人。",shape=box,color=blue];
		682 -> 688;
	677 [label="這難道還不明顯嗎？他的行為就像一隻堅持要標記領地並把東西從架子上打翻的大貓。",shape=box,color=blue];
		677 -> 683;
		677 -> 684;
	678 [label="當日曜主教──源拓氏──最後一次離開時，他把那個惡魔留在了我們家門口。傷痕累累、鮮血直流，甚至幾乎都無法想起自己的名字了。",shape=box,color=blue];
		678 -> 685;
	679 [label="那個惡魔來找我們的那晚正下著暴風雨。可怕的雷鳴震動著大教堂的牆壁。",shape=box,color=blue];
		679 -> 686;
	687 [label="Update boolean MarieRoatheWarning",color=orange];
		687 -> 694;
	688 [label="我們來達成共識。當你認為我無法理解或無法同情他人的故事時，請再多顧慮一下，好嗎？",shape=box,color=blue];
		688 -> 673;
	683 [label="就我個人而言，我比較喜歡貓。",shape=box,color=red];
		683 -> 689;
	684 [label="你不喜歡貓嗎？",shape=box,color=red];
		684 -> 690;
	685 [label="我現在才知道，他不久前才剛被注射血清，而這種轉變，如果非自願的話，是……非常痛苦的。",shape=box,color=blue];
		685 -> 691;
	686 [label="Check boolean MarieLyonVisions",color=orange];
		686 -> 693 [label=true,color=green];
		686 -> 692 [label=false,color=brown];
	694 [label="太好了！現在，你想問我關於惡魔本人的事，不是嗎？你想知道什麼？",shape=box,color=blue];
		694 -> 670;
		694 -> 671;
		694 -> 672;
	689 [label="貓真的很神奇，但這是當貓是貓的時候！他是個成年人，而且已經活好多年了！",shape=box,color=blue];
		689 -> 695;
	690 [label="我喜歡，但這是當貓是貓的時候！他是個人，一個成年人，而且已經活好多年了！",shape=box,color=blue];
		690 -> 695;
	691 [label="主教俯視著惡魔說道：「被放逐的 Xata 的異端者──Uriel，回答我，Orokin 能否得到寬恕」？",shape=box,color=blue];
		691 -> 696;
	693 [label="這次，如果里昂告訴你關於那場震動我們家的暴風雨，他是在陳述事實，那確實是我們的共同經歷。",shape=box,color=blue];
		693 -> 692;
	692 [label="我想，讓這等邪惡在這般大混亂中登場，簡直是老套的絕妙。",shape=box,color=blue];
		692 -> 678;
	695 [label="活得比任何人應有的壽命都還久，無論是藍色皮膚的，還是如他們所願被轉變得面目全非的人。",shape=box,color=blue];
		695 -> 697;
		695 -> 698;
		695 -> 3906;
	696 [label="而在一聲雷鳴中，彷彿諸神親自召喚他離開一樣，主教就這麼消失了。",shape=box,color=blue];
		696 -> 699;
	697 [label="在 Orokin 時代，基因改造自己的外形是種時尚宣言。但他們和我們一樣都是人類。或者，我想……曾經是。",shape=box,color=red];
		697 -> 700;
	698 [label="除了尾巴以外，老實說他看起來……比當年許多 Orokin 還更像人類。",shape=box,color=red];
		698 -> 701;
	3906 [label="別擔心，我覺得你比他漂亮多了。",shape=box,color=red];
		3906 -> 3907;
	699 [label="而留給我們來面對……他。那個惡魔。",shape=box,color=blue];
		699 -> 702;
	700 [label="是的，我想我都搞不清楚現在自己是什麼了。一部分瑪麗、一部分……「Wisp」、一部分……那個現在共用我血管的什麼感染體。",shape=box,color=blue];
		700 -> 703;
	701 [label="是的，我之前在看主教的一幅舊肖像，他看起來更像惡魔。他告訴我 Orokin 的行事作風，他們過去如何改造自己。",shape=box,color=blue];
		701 -> 704;
	3907 [label="Check boolean DrifterMarie",color=orange];
		3907 -> 3908 [label=true,color=green];
		3907 -> 3909 [label=false,color=brown];
	702 [label="主教把他留給我們……或許是為了照看他的靈魂？又或至少看管束縛他的枷鎖。（法語）我寧願把他送回地獄。",shape=box,color=blue];
		702 -> 705;
		702 -> 706;
	703 [label="或許下次可以再聊這個話題。",shape=box,color=blue];
		703 -> 707;
	704 [label="就像我那個時代的女士們會戴著華麗浮誇且直衝雲霄的假髮，或穿著可以輕鬆容納整座孤兒院的裙襬，既是相似卻又陌生！",shape=box,color=blue];
		704 -> 708;
	3908 [label="你必須停止讓我臉紅！Loid 先生會懷疑我坐在這裡在幹嘛呢！",shape=box,color=blue];
		3908 -> 3911;
	3909 [label="Update boolean DrifterMarie",color=orange];
		3909 -> 3910;
	705 [label="你覺得最終每個人都能得到寬恕嗎？",shape=box,color=red];
		705 -> 709;
	706 [label="他有哪方面是你喜歡的嗎？哪方面都好。",shape=box,color=red];
		706 -> 710;
	707 [label="Update boolean MarieInfestation",color=orange];
		707 -> 711;
	708 [label="人類終究是人類──永遠不滿意太陽賜予自己的外在。渴望像黏土一樣捏造自己的肉體。我想我也不例外。",shape=box,color=blue];
		708 -> 712;
	3911 [label="再說了，比那個惡魔漂亮並不難，對不？他的五官很英俊，但那個藍色……不太適合我。",shape=box,color=blue];
		3911 -> 3912;
	3910 [label="啊！你讓我臉紅了！如果 Loid 先生看到我像這樣坐在這裡，他會怎麼想？",shape=box,color=blue];
		3910 -> 3911;
	709 [label="我嗎？是的。對的。我相信所有靈魂都有能力為自己的過錯贏得寬恕。",shape=box,color=blue];
		709 -> 713;
	710 [label="完全沒有。永遠都不會有。",shape=box,color=blue];
		710 -> 714;
		710 -> 715;
	711 [label="我看不慣他的是，他具有貓科動物般的所有獵殺傲氣，卻沒有絲毫作為可愛小同伴的迷人天性。",shape=box,color=blue];
		711 -> 716;
	712 [label="我當時還非常樂意接受施打那個血清，它讓我轉變成一部分瑪麗，一部分……「Wisp」，和一部分……那個現在共用我血管的什麼感染體。",shape=box,color=blue];
		712 -> 703;
	3912 [label="如果你是真心的，我接受你的讚美。我只是有些受寵若驚。我們能……回到正題嗎？",shape=box,color=blue];
		3912 -> 707;
	713 [label="問題仍然存在……他甚至覺得自己需要寬恕這種東西嗎？",shape=box,color=blue];
		713 -> 717;
	714 [label="好吧，我感謝你的故事。所以源拓氏希望他被……寬恕？為了什麼？Tau 星系的事？還是僅僅因為他是 Orokin？",shape=box,color=red];
		714 -> 718;
	715 [label="好吧，我相信你。我不認為你會對我撒謊。",shape=box,color=red];
		715 -> 719;
	716 [label="他自視甚高。他毫不猶豫地奪取生命。他玩弄他的敵人，彷彿他們只不過是被他困住的老鼠。",shape=box,color=blue];
		716 -> 702;
	717 [label="寬恕無法給予那些不認為自己需要得到寬恕的人。與其寬恕他們，不如教魚飛行。",shape=box,color=blue];
		717 -> 720;
	718 [label="我不知道。而另一個問題仍然存在，他甚至覺得自己需要寬恕這種東西嗎？",shape=box,color=blue];
		718 -> 717;
	719 [label="哼！好吧。我們確實有個共同點……對甜食有著邪惡誘惑。那個惡魔經常回到大教堂，帶著從商店偷來的糕點，一毛錢都沒付。",shape=box,color=blue];
		719 -> 721;
	720 [label="但如果你想理解你現在面臨的不可逾越的挑戰，想贏得那場特定戰爭，那就親自和他談論這個話題。",shape=box,color=blue];
		720 -> 722;
	721 [label="我向他解釋這是偷竊，然後他會長篇大論地說什麼 Orokin 很快就會統治太陽系，所以綜觀大局這算不上偷竊……",shape=box,color=blue];
		721 -> 723;
	722 [label="我只能祝你好運了。",shape=box,color=blue];
		722 -> 724;
	723 [label="我接著會對著他大喊大叫，里昂會被迫出面調解……",shape=box,color=blue];
		723 -> 725;
		723 -> 726;
	724 [label="+10 Chemistry",color=orange];
		724 -> 727;
	725 [label="而那些糕點後來怎麼處理？",shape=box,color=red];
		725 -> 728;
	726 [label="那你可否想過他也許是想帶回來與你們一起享用？",shape=box,color=red];
		726 -> 729;
	727 [label="Chat ends.",color=orange];
	728 [label="我們不能就這麼浪費它們，對吧？吃掉它們是種罪過，但讓它們發霉是更大的罪過。於是我們就享用了它們。",shape=box,color=blue];
		728 -> 730;
	729 [label="如果這是真的，那他在這個過程中做出了錯誤的示範。但……你也許是對的。無論如何，我們不能就這麼浪費它們。吃掉它們是種罪過，但讓它們發霉是更大的罪過。於是我們就享用了它們。",shape=box,color=blue];
		729 -> 730;
	730 [label="+10 Chemistry",color=orange];
		730 -> 731;
	731 [label="嗯。現在我回想起來，或許這確實是他的一種習慣，總是帶回那麼多而自己卻又吃不下……",shape=box,color=blue];
		731 -> 732;
	732 [label="Update boolean MarieRoathePastry1",color=orange];
