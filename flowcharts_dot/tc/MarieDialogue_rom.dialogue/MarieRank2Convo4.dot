digraph {
	599 [label="MarieRank2Convo4 begins.",color=orange];
		599 -> 602;
		599 -> 601;
		599 -> 600;
	602 [label="我想冒昧問你關於羅瑟的事，那樣會讓你大發雷霆嗎？",shape=box,color=red];
		602 -> 605;
	601 [label="我能問你關於房間裡的大象的問題嗎？",shape=box,color=red];
		601 -> 604;
	600 [label="[結束]",shape=box,color=red];
		600 -> 603;
	605 [label="（法語）那個惡魔是個自以為無可挑剔的蠢貨！我寧願喝下一罐木漆，也不願再多花一分鐘聽他像舔舐自己毛皮的貓一樣自鳴得意！",shape=box,color=blue];
		605 -> 607;
		605 -> 608;
	604 [label="（法語）什麼！哪裡？大象？！",shape=box,color=blue];
		604 -> 606;
	603 [label="Chat ends.",color=orange];
	607 [label="那些話真的好有創意。",shape=box,color=red];
		607 -> 610;
	608 [label="那我就……當做那些都不是什麼友善的話了。",shape=box,color=red];
		608 -> 611;
	606 [label="我只看到一條魚、一隻鳥，還有……無論汰廢先生是什麼。我在這個聖堂裡看到許多奇奇怪怪的東西，但就沒有看到大象──你是在開玩笑嗎？",shape=box,color=blue];
		606 -> 609;
	610 [label="+5 Chemistry",color=orange];
		610 -> 614;
	611 [label="+5 Chemistry",color=orange];
		611 -> 615;
	609 [label="哦！很抱歉。那是我 1999 年的朋友們教我的一句俗語……",shape=box,color=red];
		609 -> 612;
		609 -> 613;
	614 [label="謝謝。確實很有創意，但你只是問了我一個問題，而我不該把矛頭指向你，抱歉。",shape=box,color=blue];
		614 -> 618;
	615 [label="確實不友善。抱歉，我不該向你抱怨那些。",shape=box,color=blue];
		615 -> 618;
	612 [label="我並不是指字面上的意思。",shape=box,color=red];
		612 -> 616;
	613 [label="現在我明白為什麼他們總覺得我困惑的樣子很可愛了……",shape=box,color=red];
		613 -> 617;
	618 [label="Evaluate expressions",color=orange];
		618 -> 624 [label="MarieRoatheWarning",color=purple];
		618 -> 623 [label="DrifterRoathe",color=purple];
		618 -> 622 [label="MarieRoatheSoldier",color=purple];
		618 -> 621 [label="false",color=purple];
	616 [label="+5 Chemistry",color=orange];
		616 -> 619;
	617 [label="+5 Chemistry",color=orange];
		617 -> 620;
	624 [label="不過我很意外你又過來問我的想法。你之前已經很明確地說過，你不想再聽到我說他和他同類的壞話。",shape=box,color=blue];
		624 -> 633;
		624 -> 634;
	623 [label="老實說，我承認我不清楚應不應該繼續這場對話。你似乎像飛蛾撲火那樣，被他深深吸引。",shape=box,color=blue];
		623 -> 631;
		623 -> 632;
	622 [label="還想找他當盟友？你帶他加入你的狼群是在玩危險的遊戲。他很可能在你最意想不到的時候扯出你的喉嚨。",shape=box,color=blue];
		622 -> 629;
		622 -> 630;
	621 [label="我很意外你會來找我。很明顯我對那個惡魔印像極差。",shape=box,color=blue];
		621 -> 627;
		621 -> 628;
	619 [label="如果真有大象我也不會感到意外！這地方似乎就有收容各種各樣的奇珍異獸。",shape=box,color=blue];
		619 -> 625;
	620 [label="是的，挺有魅力的，不是嗎？我經常對 Loid 先生說些什麼，然後他看我的眼神好像我完全讓他措手不及一樣。",shape=box,color=blue];
		620 -> 626;
	633 [label="我的回應過激了，為此我深感抱歉。我不想在還沒搞清楚狀況之前就譴責他──我在試圖從各方面理解他。",shape=box,color=red];
		633 -> 642;
	634 [label="我確實不想。他的經歷很難讓人懂。但我很好奇，你是否願意告訴我你們倆是怎麼認識的。",shape=box,color=red];
		634 -> 643;
	631 [label="我只是想找出他為什麼會這樣。我在試圖理解他。",shape=box,color=red];
		631 -> 640;
	632 [label="如果我能更了解他，也許就能幫助我弄清楚如何引導他走上一條稍微……更溫和的道路。",shape=box,color=red];
		632 -> 641;
	629 [label="我知道。但我不能因為他為了服務他的人民而做出必須做的事就恨他。我曾經也不得不做出同樣選擇。",shape=box,color=red];
		629 -> 638;
	630 [label="他是 Orokin 帝國有史以來最厲害的 Orokin 之一。拒絕那種幫助簡直愚蠢至極。",shape=box,color=red];
		630 -> 639;
	627 [label="我知道，但你肯定更了解他。我在嘗試更好地了解他。",shape=box,color=red];
		627 -> 636;
	628 [label="這就是為什麼我要問你關於他的事。我想理解他，而我不太相信他以自己觀點講述的故事。",shape=box,color=red];
		628 -> 637;
	625 [label="這句話是什麼意思？如果房間裡有大象，為什麼我們不願談論牠？",shape=box,color=blue];
		625 -> 635;
	626 [label="而對於一個本可以成為女王貼身侍從的人來說，我為此感到自豪。",shape=box,color=blue];
		626 -> 625;
	642 [label="Add 1 to Thermostat",color=orange];
		642 -> 651;
	643 [label="Add 1 to Thermostat",color=orange];
		643 -> 652;
