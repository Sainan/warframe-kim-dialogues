	294 [label="抱歉。我幾乎不認識你，也不了解你抵抗操控的能力。我只是擔心，因為我們把我們的苦難都堆疊在你身上了。",shape=box,color=blue];
		294 -> 297;
	295 [label="這樣我也就別無所求了。感謝、感謝、再感謝。現在，我恐怕得走了。",shape=box,color=blue];
		295 -> 298;
	296 [label="是的，你說得對。我幾乎不認識你，也不了解你抵抗操控的能力。我只是擔心，因為我們把我們的苦難都堆疊在你身上了。",shape=box,color=blue];
