		245 -> 249 [label="x > 0",color=purple];
		245 -> 248 [label="x <= 0",color=purple];
		245 -> 248 [label="false",color=purple];
	250 [label="真的嗎？那麼看來唯獨你不這麼認為。在那孩子和惡魔之間，似乎所有人都在尋找他們遺失的自我。",shape=box,color=blue];
		250 -> 255;
		250 -> 256;
	251 [label="我如此問是否會太過分，想知為何你如此失落？我知道那孩子和惡魔的原因，但唯獨不知道你的。",shape=box,color=blue];
		251 -> 255;
		251 -> 256;
	249 [label="你為何同意幫助那個惡魔完成他的計劃？我聽說是你屠殺了他的族人。",shape=box,color=blue];
		249 -> 252;
		249 -> 253;
		249 -> 254;
	248 [label="你打算協助那個惡魔完成他的計劃嗎？我聽說是你屠殺了他的族人。",shape=box,color=blue];
		248 -> 252;
		248 -> 253;
		248 -> 254;
	255 [label="我花了無數年，死在……嗯？自己手裡。我不介意記不得每一次。",shape=box,color=red];
		255 -> 260;
	256 [label="總之，我經歷了……非常多年的痛苦。我想選擇遺忘是某種自我防衛機制。",shape=box,color=red];
		256 -> 261;
	252 [label="那是另一個我幹的。我相信應該追究個人的責任，而非整個社會。",shape=box,color=red];
		252 -> 257;
	253 [label="那不是我幹的，那是那個孩子。但我和那孩子一樣痛恨 Orokin。",shape=box,color=red];
		253 -> 258;
	254 [label="長胴鼓之夜，Tenno 背叛 Orokin 的時候，我並不在場。那是那個孩子幹的。",shape=box,color=red];
		254 -> 259;
	260 [label="我也不責怪你。如果我遭受那樣的虐待，我也會急切地想把一切都隱藏起來。至少，我不會去尋找它。",shape=box,color=blue];
		260 -> 265;
	261 [label="這我絕無質疑！如果我遭受那樣的虐待，我想我的靈魂也會做出類似的事。把所有無法修補、毫無益處的東西都隱藏起來。",shape=box,color=blue];
		261 -> 265;
