digraph {
	237 [label="MarieRank1Convo4 begins.",color=orange];
		237 -> 238;
	238 [label="我可以問個希望不算無禮的問題嗎？對於我們之間的友誼來說，這還言之過早，尤其是對你而言，看來你早已經歷長久的歲月。",shape=box,color=blue];
		238 -> 241;
		238 -> 240;
		238 -> 239;
	241 [label="老實說，我已經遺忘了大部分歲月。",shape=box,color=red];
		241 -> 244;
	240 [label="當然，我不介意。請說。",shape=box,color=red];
		240 -> 243;
	239 [label="[結束]",shape=box,color=red];
		239 -> 242;
	244 [label="哦，我的太陽！你的話讓我好心疼。你和那個惡魔都發現自己的心智缺乏知識，如同一本被移除章節的書，對不？",shape=box,color=blue];
		244 -> 246;
		244 -> 247;
	243 [label="+5 Chemistry",color=orange];
		243 -> 245;
	242 [label="Chat ends.",color=orange];
	246 [label="我並不懷念我那段失去的過往。",shape=box,color=red];
		246 -> 250;
	247 [label="如果是出於截然不同的原因，那麼是的。",shape=box,color=red];
		247 -> 251;
