	281 [label="啊，我明白了。你只是在招兵買馬。但那個惡魔寧願在你肋間捅刀，也不會在你背後守著你。",shape=box,color=blue];
		281 -> 284;
	280 [label="惡魔會誘惑最堅強的心靈。他玩著狡猾的遊戲，但要小心。確保他只直視你的眼睛，而別無其他。",shape=box,color=blue];
		280 -> 283;
	279 [label="在我看來，他比任何常人都還活得久。我想或許地獄該來收回它的東西，它似乎走丟了。",shape=box,color=blue];
		279 -> 283;
	285 [label="我讚賞你的同情心，它讓我心中充滿喜悅。聖光會教導我們，人人皆可獲得幫助。人人皆可獲得寬恕。但……唯有當他們主動尋求之時。",shape=box,color=blue];
		285 -> 290;
	284 [label="他不是你的盟友，永遠都不是。那個惡魔只與有利於他之人打交道。",shape=box,color=blue];
		284 -> 287;
		284 -> 288;
		284 -> 289;
	283 [label="+5 Chemistry",color=orange];
		283 -> 286;
	290 [label="不停地幫助那些從不為自己救贖之田付出血汗之人，等同於奴隸般渴求自由卻求而不得的生活。",shape=box,color=blue];
		290 -> 287;
		290 -> 288;
		290 -> 289;
	287 [label="我比你更了解 Orokin 和他的處境。我不需要你的幫助。",shape=box,color=red];
		287 -> 291;
	288 [label="我感謝你的警語。我與他打交道時會記住這些點。",shape=box,color=red];
		288 -> 292;
	289 [label="謝謝。但我自己能應付。況且，主要是我處理過比他更糟糕的情況。",shape=box,color=red];
		289 -> 293;
	286 [label="但我這樣說有點太殘酷了……你不了解他。你沒看清他的真面目。我只是不希望你受傷。",shape=box,color=blue];
