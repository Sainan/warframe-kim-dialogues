		258 -> 263;
	259 [label="長胴鼓之夜。哦，我腦海中彷彿浮現它的影象了。多麼絢麗的色彩啊！",shape=box,color=blue];
		259 -> 264;
	265 [label="+5 Chemistry",color=orange];
		265 -> 268;
	262 [label="是的，我懂。當惡臭僅是牆內死老鼠的臭味時，我們卻急著把整棟建築燒毀。",shape=box,color=blue];
		262 -> 266;
	263 [label="我好想知道為什麼！但又是下次交談的話題了。否則我們會永遠待在這裡聊個不停，然後 Loid 先生會恨死我。",shape=box,color=blue];
		263 -> 267;
