digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"MarieRank1Convo4 begins." [color=orange];
		"MarieRank1Convo4 begins." -> j3367140610;
	j3367140610 [label="我可以問個希望不算無禮的問題嗎？對於我們之間的友誼來說，這還言之過早，尤其是對你而言，看來你早已經歷長久的歲月。",shape=box,color=blue];
		j3367140610 -> j3307961767;
		j3367140610 -> j614822476;
		j3367140610 -> j1350559949;
	j3307961767 [label="老實說，我已經遺忘了大部分歲月。",shape=box,color=red];
		j3307961767 -> j3649125868;
	j614822476 [label="當然，我不介意。請說。",shape=box,color=red];
		j614822476 -> j2947588656;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j3649125868 [label="哦，我的太陽！你的話讓我好心疼。你和那個惡魔都發現自己的心智缺乏知識，如同一本被移除章節的書，對不？",shape=box,color=blue];
		j3649125868 -> j2463021250;
		j3649125868 -> j2810516446;
	j2947588656 [label="+5 Chemistry",color=orange];
		j2947588656 -> j523704316;
	"Chat ends." [color=orange];
	j2463021250 [label="我並不懷念我那段失去的過往。",shape=box,color=red];
		j2463021250 -> j637836516;
	j2810516446 [label="如果是出於截然不同的原因，那麼是的。",shape=box,color=red];
		j2810516446 -> j839033781;
	j523704316 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j523704316 -> j3882416812 [label="x > 0",color=purple];
		j523704316 -> j2558382420 [label="x <= 0",color=purple];
		j523704316 -> j2558382420 [label="false",color=purple];
	j637836516 [label="真的嗎？那麼看來唯獨你不這麼認為。在那孩子和惡魔之間，似乎所有人都在尋找他們遺失的自我。",shape=box,color=blue];
		j637836516 -> j1796311358;
		j637836516 -> j2246470465;
	j839033781 [label="我如此問是否會太過分，想知為何你如此失落？我知道那孩子和惡魔的原因，但唯獨不知道你的。",shape=box,color=blue];
		j839033781 -> j1796311358;
		j839033781 -> j2246470465;
	j3882416812 [label="你為何同意幫助那個惡魔完成他的計劃？我聽說是你屠殺了他的族人。",shape=box,color=blue];
		j3882416812 -> j4219801726;
		j3882416812 -> j3057264417;
		j3882416812 -> j2261739224;
	j2558382420 [label="你打算協助那個惡魔完成他的計劃嗎？我聽說是你屠殺了他的族人。",shape=box,color=blue];
		j2558382420 -> j4219801726;
		j2558382420 -> j3057264417;
		j2558382420 -> j2261739224;
	j1796311358 [label="我花了無數年，死在……嗯？自己手裡。我不介意記不得每一次。",shape=box,color=red];
		j1796311358 -> j2341211867;
	j2246470465 [label="總之，我經歷了……非常多年的痛苦。我想選擇遺忘是某種自我防衛機制。",shape=box,color=red];
		j2246470465 -> j3265298263;
	j4219801726 [label="那是另一個我幹的。我相信應該追究個人的責任，而非整個社會。",shape=box,color=red];
		j4219801726 -> j145766454;
	j3057264417 [label="那不是我幹的，那是那個孩子。但我和那孩子一樣痛恨 Orokin。",shape=box,color=red];
		j3057264417 -> j2246624562;
	j2261739224 [label="長胴鼓之夜，Tenno 背叛 Orokin 的時候，我並不在場。那是那個孩子幹的。",shape=box,color=red];
		j2261739224 -> j1909494139;
	j2341211867 [label="我也不責怪你。如果我遭受那樣的虐待，我也會急切地想把一切都隱藏起來。至少，我不會去尋找它。",shape=box,color=blue];
		j2341211867 -> j1954076720;
	j3265298263 [label="這我絕無質疑！如果我遭受那樣的虐待，我想我的靈魂也會做出類似的事。把所有無法修補、毫無益處的東西都隱藏起來。",shape=box,color=blue];
		j3265298263 -> j1954076720;
	j145766454 [label="Add 1 to Thermostat counter",color=orange];
		j145766454 -> j1690073226;
	j2246624562 [label="Add -1 to Thermostat counter",color=orange];
		j2246624562 -> j3154583257;
	j1909494139 [label="長胴鼓之夜。哦，我腦海中彷彿浮現它的影象了。多麼絢麗的色彩啊！",shape=box,color=blue];
		j1909494139 -> j610227984;
	j1954076720 [label="+5 Chemistry",color=orange];
		j1954076720 -> j3517613213;
	j1690073226 [label="是的，我懂。當惡臭僅是牆內死老鼠的臭味時，我們卻急著把整棟建築燒毀。",shape=box,color=blue];
		j1690073226 -> j2058818266;
	j3154583257 [label="我好想知道為什麼！但又是下次交談的話題了。否則我們會永遠待在這裡聊個不停，然後 Loid 先生會恨死我。",shape=box,color=blue];
		j3154583257 -> j4192617946;
	j610227984 [label="我需要向 Loid 先生了解更多細節。但！",shape=box,color=blue];
		j610227984 -> j4192617946;
	j3517613213 [label="不過，這或許能讓我對我想與你討論的事情有些見解。",shape=box,color=blue];
		j3517613213 -> j523704316;
	j2058818266 [label="但那又是下次交談的話題了，否則我們會永遠待在這裡聊個不停，然後 Loid 先生會恨死我。",shape=box,color=blue];
		j2058818266 -> j4192617946;
	j4192617946 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4192617946 -> j210329253 [label="x > 0",color=purple];
		j4192617946 -> j145917601 [label="x <= 0",color=purple];
		j4192617946 -> j145917601 [label="false",color=purple];
	j210329253 [label="抱歉！我沒能讓你有機會回答。那麼，為什麼要幫助那個惡魔？",shape=box,color=blue];
		j210329253 -> j379953492;
		j210329253 -> j952953908;
		j210329253 -> j1850715364;
		j210329253 -> j2556392126;
	j145917601 [label="抱歉！我沒能讓你有機會回答。那麼，你會幫助那個惡魔嗎？",shape=box,color=blue];
		j145917601 -> j2556392126;
		j145917601 -> j1850715364;
		j145917601 -> j952953908;
		j145917601 -> j379953492;
	j379953492 [label="他還沒做任何事來證明他不值得幫助……至少現在還沒有。",shape=box,color=red];
		j379953492 -> j1773525448;
	j952953908 [label="我想我不忍拒絕盟友。",shape=box,color=red];
		j952953908 -> j966783899;
	j1850715364 [label="（坦白對羅瑟感興趣）他有某種迷人的特質……",shape=box,color=red];
		j1850715364 -> j3726597236;
	j2556392126 [label="他這麼做似乎只是為了生存所需。我無法因此責怪他。",shape=box,color=red];
		j2556392126 -> j99614269;
	j1773525448 [label="Add 1 to Thermostat counter",color=orange];
		j1773525448 -> j642223173;
	j966783899 [label="Boolean MarieRoatheSoldier is now true.",color=orange];
		j966783899 -> j2715412354;
	j3726597236 [label="Boolean DrifterRoathe is now true.",color=orange];
		j3726597236 -> j2470375723;
	j99614269 [label="Add -1 to Thermostat counter",color=orange];
		j99614269 -> j2401084699;
	j642223173 [label="+5 Chemistry",color=orange];
		j642223173 -> j1451126132;
	j2715412354 [label="啊，我明白了。你只是在招兵買馬。但那個惡魔寧願在你肋間捅刀，也不會在你背後守著你。",shape=box,color=blue];
		j2715412354 -> j757081633;
	j2470375723 [label="惡魔會誘惑最堅強的心靈。他玩著狡猾的遊戲，但要小心。確保他只直視你的眼睛，而別無其他。",shape=box,color=blue];
		j2470375723 -> j505691543;
	j2401084699 [label="在我看來，他比任何常人都還活得久。我想或許地獄該來收回它的東西，它似乎走丟了。",shape=box,color=blue];
		j2401084699 -> j505691543;
	j1451126132 [label="我讚賞你的同情心，它讓我心中充滿喜悅。聖光會教導我們，人人皆可獲得幫助。人人皆可獲得寬恕。但……唯有當他們主動尋求之時。",shape=box,color=blue];
		j1451126132 -> j2113175430;
	j757081633 [label="他不是你的盟友，永遠都不是。那個惡魔只與有利於他之人打交道。",shape=box,color=blue];
		j757081633 -> j3920529526;
		j757081633 -> j1234882661;
		j757081633 -> j1382486894;
	j505691543 [label="+5 Chemistry",color=orange];
		j505691543 -> j632857387;
	j2113175430 [label="不停地幫助那些從不為自己救贖之田付出血汗之人，等同於奴隸般渴求自由卻求而不得的生活。",shape=box,color=blue];
		j2113175430 -> j3920529526;
		j2113175430 -> j1234882661;
		j2113175430 -> j1382486894;
	j3920529526 [label="我比你更了解 Orokin 和他的處境。我不需要你的幫助。",shape=box,color=red];
		j3920529526 -> j1248098494;
	j1234882661 [label="我感謝你的警語。我與他打交道時會記住這些點。",shape=box,color=red];
		j1234882661 -> j1693357865;
	j1382486894 [label="謝謝。但我自己能應付。況且，主要是我處理過比他更糟糕的情況。",shape=box,color=red];
		j1382486894 -> j751985137;
	j632857387 [label="但我這樣說有點太殘酷了……你不了解他。你沒看清他的真面目。我只是不希望你受傷。",shape=box,color=blue];
		j632857387 -> j3920529526;
		j632857387 -> j1234882661;
		j632857387 -> j1382486894;
	j1248098494 [label="Boolean MarieRoatheWarning is now true.",color=orange];
		j1248098494 -> j3600951408;
	j1693357865 [label="+10 Chemistry",color=orange];
		j1693357865 -> j1630806035;
	j751985137 [label="+5 Chemistry",color=orange];
		j751985137 -> j4250142897;
	j3600951408 [label="抱歉。我幾乎不認識你，也不了解你抵抗操控的能力。我只是擔心，因為我們把我們的苦難都堆疊在你身上了。",shape=box,color=blue];
		j3600951408 -> j3456636276;
	j1630806035 [label="這樣我也就別無所求了。感謝、感謝、再感謝。現在，我恐怕得走了。",shape=box,color=blue];
		j1630806035 -> "Chat ends.";
	j4250142897 [label="是的，你說得對。我幾乎不認識你，也不了解你抵抗操控的能力。我只是擔心，因為我們把我們的苦難都堆疊在你身上了。",shape=box,color=blue];
		j4250142897 -> j1972566045;
	j3456636276 [label="我將不再僭越。",shape=box,color=blue];
		j3456636276 -> "Chat ends.";
	j1972566045 [label="而現在，我恐怕得走了。",shape=box,color=blue];
		j1972566045 -> "Chat ends.";
}