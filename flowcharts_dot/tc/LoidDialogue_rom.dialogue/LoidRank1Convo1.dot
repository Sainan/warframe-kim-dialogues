	"LoidRank1Convo1 begins." [color=orange];
		"LoidRank1Convo1 begins." -> j2814360744;
	j2814360744 [label="漂泊者，請原諒我如此冒昧。我本不願透過這個裝置與你聯繫，但眼下情況幾乎已到緊急關頭，而我實在不知道還能求助於誰。",shape=box,color=blue];
		j2814360744 -> j2492051642;
		j2814360744 -> j1243657125;
	j2492051642 [label="POM2_LAB1 是誰？",shape=box,color=red];
		j2492051642 -> j1531324222;
	j1243657125 [label="這是誰……？",shape=box,color=red];
		j1243657125 -> j1531324222;
	j1531324222 [label="喔，是的，這裝置還在預設設定上。是我，Loid。我本該先……自報姓名的，但最近解剖聖堂這裡實在是一片混亂。",shape=box,color=blue];
		j1531324222 -> j1817383349;
	j1817383349 [label="也正因如此，我才聯絡你。我需要你的協助。三名原型 Warframe 出現在聖堂，在我這個時代。而且我們不曾相識。",shape=box,color=blue];
		j1817383349 -> j3827798633;
	j3827798633 [label="其中一位是……",shape=box,color=blue];
		j3827798633 -> j3889805668;
	j3889805668 [label="抱歉。",shape=box,color=blue];
		j3889805668 -> j3293065123;
	j3293065123 [label="漂泊者，其中一位是 Orokin。",shape=box,color=blue];
		j3293065123 -> j57325474;
		j3293065123 -> j1228955832;
		j3293065123 -> j3802309688;
	j57325474 [label="Lotus 在哪？",shape=box,color=red];
		j57325474 -> j207010888;
	j1228955832 [label="哦，不……",shape=box,color=red];
		j1228955832 -> j2956255551;
	j3802309688 [label="什麼？！",shape=box,color=red];
		j3802309688 -> j2956255551;
	j207010888 [label="請相信我，Lotus 和指揮官目前另有要事。他們早已不堪重負，疲憊不堪。若非萬不得已，我不會請你來處理此事。",shape=box,color=blue];
		j207010888 -> j511275982;
	j2956255551 [label="若非萬不得已，我不會請你來處理此事。你似乎……成了這類事的新專家。",shape=box,color=blue];
		j2956255551 -> j1622040018;
	j511275982 [label="你似乎……成了這類事的新專家。",shape=box,color=blue];
		j511275982 -> j1622040018;
	j1622040018 [label="我實在不知該如何描述他們。但若你來到聖堂，應該很難錯過他們。他們之中有兩位已同意在 POM-2 上與你對話，另一位……則可能還需要再勸說一下。",shape=box,color=blue];
		j1622040018 -> j473623742;
	j473623742 [label="我……有信心……你一定能成功。",shape=box,color=blue];
		j473623742 -> j3173882;
