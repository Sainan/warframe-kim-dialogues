digraph {
	0 [label="LoidRank1Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="漂泊者，請原諒我如此冒昧。我本不願透過這個裝置與你聯繫，但眼下情況幾乎已到緊急關頭，而我實在不知道還能求助於誰。",shape=box,color=blue];
		1 -> 2;
		1 -> 3;
	2 [label="POM2_LAB1 是誰？",shape=box,color=red];
		2 -> 4;
	3 [label="這是誰……？",shape=box,color=red];
		3 -> 4;
	4 [label="喔，是的，這裝置還在預設設定上。是我，Loid。我本該先……自報姓名的，但最近解剖聖堂這裡實在是一片混亂。",shape=box,color=blue];
		4 -> 5;
	5 [label="也正因如此，我才聯絡你。我需要你的協助。三名原型戰甲出現在聖堂，在我這個時代。而且我們不曾相識。",shape=box,color=blue];
		5 -> 6;
	6 [label="其中一位是……",shape=box,color=blue];
		6 -> 7;
	7 [label="抱歉。",shape=box,color=blue];
		7 -> 8;
	8 [label="漂泊者，其中一位是 Orokin。",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
		8 -> 11;
	9 [label="Lotus 在哪？",shape=box,color=red];
		9 -> 12;
	10 [label="哦，不……",shape=box,color=red];
		10 -> 13;
	11 [label="什麼？！",shape=box,color=red];
		11 -> 13;
	12 [label="請相信我，Lotus 和指揮官目前另有要事。他們早已不堪重負，疲憊不堪。若非萬不得已，我不會請你來處理此事。",shape=box,color=blue];
		12 -> 14;
	13 [label="若非萬不得已，我不會請你來處理此事。你似乎……成了這類事的新專家。",shape=box,color=blue];
		13 -> 15;
	14 [label="你似乎……成了這類事的新專家。",shape=box,color=blue];
		14 -> 15;
	15 [label="我實在不知該如何描述他們。但若你來到聖堂，應該很難錯過他們。他們之中有兩位已同意在 POM-2 上與你對話，另一位……則可能還需要再勸說一下。",shape=box,color=blue];
		15 -> 16;
	16 [label="我……有信心……你一定能成功。",shape=box,color=blue];
		16 -> 29;
	29 [label="Update boolean LoidTriadAvailable",color=orange];
		29 -> 17;
	17 [label="Chat ends. Next chat will be LoidFamily.",color=orange];
}