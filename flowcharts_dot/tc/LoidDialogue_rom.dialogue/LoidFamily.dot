		19 -> 20 [label="MarieFamilySuccess, LyonFamilySuccess, RoatheFamilySuccess",color=purple];
		19 -> 21 [label="false",color=purple];
	20 [label="漂泊者，我妥協了。羅瑟、瑪麗，和里昂說服了我，時機終於成熟了。",shape=box,color=blue];
		20 -> 22;
	21 [label="Chat ends.",color=orange];
	22 [label="我對自己必須做的事所感到的恐懼直透骨髓。確實，當 Gomaitru 與她的家人發現一直以來腳下所發生的一切並陷入狂怒之時，也許我會被肢解，而那份恐懼將從我身上剝離。",shape=box,color=blue];
		22 -> 23;
	23 [label="現在再以那個名字稱呼她感覺真是奇怪，但我們之間已經發生太多變化，而更多的變化也即將到來。",shape=box,color=blue];
		23 -> 24;
		23 -> 25;
	24 [label="這件事早就該做了。你會沒事的。",shape=box,color=red];
		24 -> 26;
	25 [label="你行的。",shape=box,color=red];
		25 -> 26;
	26 [label="嗯，好吧。請務必過來一趟，確保我的內臟不會被拿去當亡骸殿的節慶裝飾，好嗎？等一切塵埃落定後，我還可能需要一點……安慰。",shape=box,color=blue];
		26 -> 27;
	27 [label="Update boolean LoidFamilyComplete",color=orange];
		27 -> 28;
	28 [label="Chat ends.",color=orange];
