	j84921078 [label="漂泊者，我妥協了。羅瑟、瑪麗，和里昂說服了我，時機終於成熟了。",shape=box,color=blue];
		j84921078 -> j196482295;
	"Chat ends." [color=orange];
	j196482295 [label="我對自己必須做的事所感到的恐懼直透骨髓。確實，當 Gomaitru 與她的家人發現一直以來腳下所發生的一切並陷入狂怒之時，也許我會被肢解，而那份恐懼將從我身上剝離。",shape=box,color=blue];
		j196482295 -> j3812495661;
	j3812495661 [label="現在再以那個名字稱呼她感覺真是奇怪，但我們之間已經發生太多變化，而更多的變化也即將到來。",shape=box,color=blue];
		j3812495661 -> j2074838071;
		j3812495661 -> j1453702422;
	j2074838071 [label="這件事早就該做了。你會沒事的。",shape=box,color=red];
		j2074838071 -> j510135690;
	j1453702422 [label="你行的。",shape=box,color=red];
		j1453702422 -> j510135690;
	j510135690 [label="嗯，好吧。請務必過來一趟，確保我的內臟不會被拿去當亡骸殿的節慶裝飾，好嗎？等一切塵埃落定後，我還可能需要一點……安慰。",shape=box,color=blue];
		j510135690 -> j937202740;
