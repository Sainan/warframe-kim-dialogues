digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank4Convo3 begins." [color=orange];
		"KayaRank4Convo3 begins." -> j2905668036;
	j2905668036 [label="我相信你。",shape=box,color=blue];
		j2905668036 -> j688783582;
	j688783582 [label="但這並不意味著我會待在這裡而不留後路。",shape=box,color=blue];
		j688783582 -> j4096434134;
		j688783582 -> j990626123;
		j688783582 -> j944904333;
	j4096434134 [label="我很高興我們現在信任彼此了 [結束]",shape=box,color=red];
		j4096434134 -> j465934596;
	j990626123 [label="妳離確保自己的「後路」還有多遠？",shape=box,color=red];
		j990626123 -> j101986468;
	j944904333 [label="是什麼說服了妳？",shape=box,color=red];
		j944904333 -> j3209122046;
	j465934596 [label="+20 Chemistry",color=orange];
		j465934596 -> "Chat ends. Next chat will be KayaRank4Convo4.";
	j101986468 [label="呃，明天再問我一次，好嗎？",shape=box,color=blue];
		j101986468 -> j3206695514;
	j3209122046 [label="我知道我們早已脫離高中生活。",shape=box,color=blue];
		j3209122046 -> j1462050716;
	"Chat ends. Next chat will be KayaRank4Convo4." [color=orange];
	j3206695514 [label="可能已經很接近了，真的有所發現。",shape=box,color=blue];
		j3206695514 -> j400611879;
		j3206695514 -> j3129086426;
	j1462050716 [label="但這不需要天才小孩也能看出你是真的關心我們。我們也都尊重你。",shape=box,color=blue];
		j1462050716 -> j2846457895;
	j400611879 [label="妳就快要逃離 1999 年了？",shape=box,color=red];
		j400611879 -> j433350114;
	j3129086426 [label="目前的主要方向是什麼？",shape=box,color=red];
		j3129086426 -> j1573055490;
	j2846457895 [label="就連亞瑟也是。首先，超級迷戀他的，我的天啊。",shape=box,color=blue];
		j2846457895 -> j1211137507;
	j433350114 [label="是的！當然也有些注意事項。最確定且安全的路徑是去往你來的確切時間點，因為那裡有某種「虛空指紋」。",shape=box,color=blue];
		j433350114 -> j746199768;
		j433350114 -> j713667151;
		j433350114 -> j3058792546;
	j1573055490 [label="當然是你啊。",shape=box,color=blue];
		j1573055490 -> j200824428;
		j1573055490 -> j3048600651;
	j1211137507 [label="Check boolean ArthurDating",color=orange];
		j1211137507 -> j773424114 [label=true,color=green];
		j1211137507 -> j203966021 [label=false,color=brown];
		j1211137507 -> j1554455146 [label=false,color=brown];
	j746199768 [label="那麼，妳還確定這點嗎？",shape=box,color=red];
		j746199768 -> j3663006253;
	j713667151 [label="我的時代確實也沒多好，但至少我在那裡幫忙。",shape=box,color=red];
		j713667151 -> j1468029969;
	j3058792546 [label="嗯，其實虛空看待手指還挺嚴肅的。",shape=box,color=red];
		j3058792546 -> j2124084598;
	j200824428 [label="我肯定很特別。",shape=box,color=red];
		j200824428 -> j433350114;
	j3048600651 [label="我？",shape=box,color=red];
		j3048600651 -> j433350114;
	j773424114 [label="妳知道他已經名草有主了嗎？",shape=box,color=red];
		j773424114 -> j4034704399;
	j203966021 [label="我會替妳美言幾句。",shape=box,color=red];
		j203966021 -> j1621164701;
	j1554455146 [label="噁心。",shape=box,color=red];
		j1554455146 -> j3069340089;
	j3663006253 [label="非常確定。這是個挑戰。該發生的總會發生，對吧？就像，它讓我保持忙碌，專注……",shape=box,color=blue];
		j3663006253 -> j2736389861;
	j1468029969 [label="沒錯！破釜沉舟！不再回頭！",shape=box,color=blue];
		j1468029969 -> j465934596;
	j2124084598 [label="蛤？",shape=box,color=blue];
		j2124084598 -> j2609594142;
	j4034704399 [label="噗噓，我知道，超幸運的！言歸正傳……",shape=box,color=blue];
		j4034704399 -> j3589012270;
	j1621164701 [label="噗噓，不，拜託請不要，我是信任你才告訴你的！言歸正傳……",shape=box,color=blue];
		j1621164701 -> j3589012270;
	j3069340089 [label="呃，你瘋了嗎？一點都不噁。言歸正傳！",shape=box,color=blue];
		j3069340089 -> j3589012270;
	j2736389861 [label="沒有壞處。要麼弄明白，要麼沒有。要麼在這裡見，要麼在那裡見。對吧？再見！",shape=box,color=blue];
		j2736389861 -> j465934596;
	j2609594142 [label="所有這一切，源拓氏造成的所有這一切。他追逐虛空──這一切的……本質。",shape=box,color=red];
		j2609594142 -> j190613541;
	j3589012270 [label="但在某種程度上，這就像高中，每個人都喜歡你。",shape=box,color=blue];
		j3589012270 -> j2586274336;
	j190613541 [label="這一切歸根結底為一根手指。一根手指。",shape=box,color=red];
		j190613541 -> j2295021514;
	j2586274336 [label="而這就說明了還有比受歡迎更深一層的東西。",shape=box,color=blue];
		j2586274336 -> j4263901980;
	j2295021514 [label="你是喝了亞瑟的啤酒嗎？為什麼你沒有早點提到件事？",shape=box,color=blue];
		j2295021514 -> j2058417913;
		j2295021514 -> j554376836;
		j2295021514 -> j91203068;
	j4263901980 [label="我們都多少有點錯亂。",shape=box,color=blue];
		j4263901980 -> j14087616;
		j4263901980 -> j3199930032;
		j4263901980 -> j2049030590;
	j2058417913 [label="虛空。教科書對這個主題幫助不大。",shape=box,color=red];
		j2058417913 -> j3654200323;
	j554376836 [label="啤酒或許可以讓事情變得更有道理。",shape=box,color=red];
		j554376836 -> j3654200323;
	j91203068 [label="這不是什麼隨便就被「提及」的事。它即是結束也是開始。",shape=box,color=red];
		j91203068 -> j3654200323;
	j14087616 [label="又亂又忙！歡迎加入團隊。[結束]",shape=box,color=red];
		j14087616 -> j465934596;
	j3199930032 [label="妳認為誰最錯亂？",shape=box,color=red];
		j3199930032 -> j740919551;
	j2049030590 [label="這是在誇讚我嗎？",shape=box,color=red];
		j2049030590 -> j3052595996;
	j3654200323 [label="但你說的一根手指是什麼意思？",shape=box,color=blue];
		j3654200323 -> j4273241375;
		j3654200323 -> j2862391670;
	j740919551 [label="我的天啊……聊八卦嗎？在我剛才說完那些之後？",shape=box,color=blue];
		j740919551 -> j2352768661;
	j3052595996 [label="百分之百完全是。因為這裡沒有人在競爭。",shape=box,color=blue];
		j3052595996 -> j3953574663;
	j4273241375 [label="阿爾佈雷希特有它的手指。",shape=box,color=red];
		j4273241375 -> j1261036467;
	j2862391670 [label="有一根來自……它的手指。在我的時代。在我們的世界，我猜。",shape=box,color=red];
		j2862391670 -> j1261036467;
	j2352768661 [label="（但顯然是亞瑟，因為當我在和他交談時，聽起來你真的把他搞到精神錯亂了）。",shape=box,color=blue];
		j2352768661 -> j130193185;
	j3953574663 [label="這就像是最怪異的事。我們正在變成怪物，但這是我感覺最像人類的時刻。",shape=box,color=blue];
		j3953574663 -> j1933634294;
	j1261036467 [label="好的，所以物體有保留下來，謝謝！",shape=box,color=blue];
		j1261036467 -> j1565222930;
	j130193185 [label="順便說一下，這證實了我對你與 1999 年的肉體連接的假說。",shape=box,color=blue];
		j130193185 -> j789280698;
	j1933634294 [label="其實現在我可以做自己了。",shape=box,color=blue];
		j1933634294 -> j1077538800;
	j1565222930 [label="就這樣？",shape=box,color=red];
		j1565222930 -> j1272566203;
	j789280698 [label="這是相關的，因為……啊！測試完畢。再聊。",shape=box,color=blue];
		j789280698 -> j465934596;
	j1077538800 [label="我不再害怕。",shape=box,color=blue];
		j1077538800 -> j397233073;
	j1272566203 [label="不想問「它是什麼」？為什麼它會有一根手指？",shape=box,color=red];
		j1272566203 -> j2256587494;
	j397233073 [label="所以，謝謝。",shape=box,color=blue];
		j397233073 -> j465934596;
	j2256587494 [label="你可以處理那個問題。物體的狀態保存更有趣。謝謝！",shape=box,color=blue];
		j2256587494 -> j465934596;
}