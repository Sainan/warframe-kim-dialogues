	629 [label="蛤？",shape=box,color=blue];
		629 -> 636;
	630 [label="是的！當然也有些注意事項。最確定且安全的路徑是去往你來的確切時間點，因為那裡有某種「虛空指紋」。",shape=box,color=blue];
		630 -> 619;
		630 -> 620;
