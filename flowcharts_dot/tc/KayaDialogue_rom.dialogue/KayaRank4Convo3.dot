		650 -> 654;
	651 [label="但你說的一根手指是什麼意思？",shape=box,color=blue];
		651 -> 655;
		651 -> 656;
	652 [label="+20 Chemistry",color=orange];
		652 -> 657;
	653 [label="我的天啊……聊八卦嗎？在我剛才說完那些之後？",shape=box,color=blue];
