	658 [label="（但顯然是亞瑟，因為當我在和他交談時，聽起來你真的把他搞到精神錯亂了）。",shape=box,color=blue];
		658 -> 661;
	659 [label="這就像是最怪異的事。我們正在變成怪物，但這是我感覺最像人類的時刻。",shape=box,color=blue];
