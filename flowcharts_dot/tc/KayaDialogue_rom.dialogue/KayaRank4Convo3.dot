	640 [label="這一切歸根結底為一根手指。一根手指。",shape=box,color=red];
		640 -> 643;
	641 [label="而這就說明了還有比受歡迎更深一層的東西。",shape=box,color=blue];
		641 -> 644;
	642 [label="Chat ends. Next chat will be KayaRank4Convo4.",color=orange];
	643 [label="你是喝了亞瑟的啤酒嗎？為什麼你沒有早點提到件事？",shape=box,color=blue];
		643 -> 645;
