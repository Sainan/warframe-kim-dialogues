digraph {
	"KayaRank4Convo1 begins." [color=orange];
		"KayaRank4Convo1 begins." -> j8395738;
	j8395738 [label="你想知道那種感覺是怎樣的嗎？網際網路問世了，向我們允諾無限可能性。",shape=box,color=blue];
		j8395738 -> j2512121852;
	j2512121852 [label="想象一下你是我。你剛滿十八。你登上網路。你開始和世界各地的新朋友聊天！",shape=box,color=blue];
		j2512121852 -> j3296646120;
	j3296646120 [label="而對於像我這樣所謂的「聰明女孩」來說，你在網路上做了最愚蠢的事。",shape=box,color=blue];
		j3296646120 -> j1118905280;
	j1118905280 [label="你誤信了螢幕另一端的人。",shape=box,color=blue];
		j1118905280 -> j2901115797;
	j2901115797 [label="你眼中只看到所有這些新科技，卻忘記了人始終還是人。",shape=box,color=blue];
		j2901115797 -> j4165059867;
	j4165059867 [label="於是你傳送了自己的一張就連白月都會臉紅的裸照。你以為自己和網路上遇到的人有著真實的情感連結。你以為可以信任自己的線上男友。",shape=box,color=blue];
		j4165059867 -> j616102197;
	j616102197 [label="然而隔天，那張照片已傳遍世界各地的大街小巷。校園裡的每個人都看過了。分享了。傳給了你的指導教授們。傳遍了整個網際網路。甚至是傳到了連我都不知道有存在的國家。",shape=box,color=blue];
		j616102197 -> j4008371520;
	j4008371520 [label="我本可以成為這世上最聰明的人，而人們對我的印象卻只是那張照片。",shape=box,color=blue];
		j4008371520 -> j2898148936;
	j2898148936 [label="所以當我說我要離開這裡的時候，我是認真的。我知道那張照片毫無意義，未來仍繼續前行，人們滿足了私慾。",shape=box,color=blue];
		j2898148936 -> j3299510764;
	j3299510764 [label="但對我來說，它毀了我的人生。我想生活在一個沒有網路的未來。我想證明我能夠從這個事件中走出來。回到過去只會證明他們是對的，證明我無法從中走出去。",shape=box,color=blue];
		j3299510764 -> j1288469752;
	j1288469752 [label="所以，就等著吧。你會看到我在你來的那裡。",shape=box,color=blue];
		j1288469752 -> j2460480596;
	j2460480596 [label="然後我們就可以看著這個世界，笑著說我的選擇並沒有毀掉我。這一切只是讓我變得更聰明。聰明到足以離開。",shape=box,color=blue];
		j2460480596 -> j3258508148;
	j3258508148 [label="+20 Chemistry",color=orange];
		j3258508148 -> "Chat ends. Next chat will be KayaRank4Convo2.";
	"Chat ends. Next chat will be KayaRank4Convo2." [color=orange];
}