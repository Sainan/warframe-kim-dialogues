digraph {
	"KayaRank2Convo2 begins." [color=orange];
		"KayaRank2Convo2 begins." -> j3387223494;
	j3387223494 [label="嗨。你能幫我確認一些事嗎？",shape=box,color=blue];
		j3387223494 -> j3582891717;
	j3582891717 [label="你時間旅行能力的關鍵是技改細胞和虛空的某個混合比嗎？",shape=box,color=blue];
		j3582891717 -> j2953198523;
		j3582891717 -> j399048940;
	j2953198523 [label="混合比？我們是要烤蛋糕嗎？",shape=box,color=red];
		j2953198523 -> j3824948954;
	j399048940 [label="所以妳的研究進行得還順利囉？",shape=box,color=red];
		j399048940 -> j1423390383;
	j3824948954 [label="從沒那樣試過，但我敢打賭一定能烤出超棒的蛋糕。",shape=box,color=blue];
		j3824948954 -> j1797233553;
		j3824948954 -> j4013597080;
	j1423390383 [label="超級順利。其實我已經超接近了。超級接近。",shape=box,color=blue];
		j1423390383 -> j1781766834;
		j1423390383 -> j2353032764;
	j1797233553 [label="妳怎麼知道？",shape=box,color=red];
		j1797233553 -> j898094817;
	j4013597080 [label="謙虛點，Nova。",shape=box,color=red];
		j4013597080 -> j898094817;
	j1781766834 [label="妳怎麼能確定？",shape=box,color=red];
		j1781766834 -> j1678120851;
	j2353032764 [label="妳肯定是個優秀的學生。",shape=box,color=red];
		j2353032764 -> j860142177;
	j898094817 [label="我不需要謙虛。我的高中成績是歷年來最高的，而且我的大學一年級學業成績是百年以來最好的。",shape=box,color=blue];
		j898094817 -> j2761338672;
		j898094817 -> j908228706;
	j1678120851 [label="你有聽過「Nora Night」這個人嗎？",shape=box,color=blue];
		j1678120851 -> j1553044887;
		j1678120851 -> j4176332113;
	j860142177 [label="我的高中成績是歷年來最高的，而且我的大學一年級學業成績是百年以來最好的。",shape=box,color=blue];
		j860142177 -> j2285661896;
	j2761338672 [label="但這並不代表妳會烤蛋糕說。除非妳修過烘焙課？",shape=box,color=red];
		j2761338672 -> j1488447066;
	j908228706 [label="但顯然還不夠聰明，服用了源拓氏的血清，不是吧？",shape=box,color=red];
		j908228706 -> j1892073671;
	j1553044887 [label="好像有，但她肯定聽說過我。",shape=box,color=red];
		j1553044887 -> j708042299;
	j4176332113 [label="哇哦，聽過啊。她是我那個時代的人",shape=box,color=red];
		j4176332113 -> j708042299;
	j2285661896 [label="我不只是個優秀的學生。很多大學都紛紛向我伸出橄欖枝。我的大一學年度本可以完美的……",shape=box,color=blue];
		j2285661896 -> j1778648105;
		j2285661896 -> j1213092535;
	j1488447066 [label="Boolean KayaCake is now true.",color=orange];
		j1488447066 -> j3897498331;
	j1892073671 [label="笑死，還以為是誰呢。不就是「源拓氏的老師們的寵物」？是啊，我已經聽說了大家對你的意見了",shape=box,color=blue];
		j1892073671 -> j133540930;
		j1892073671 -> j4103907506;
	j708042299 [label="嗯哼，當然了。好吧，我研究出一個能攔截時間的公式，最終它有辦法攔截並接收到時空上的聲波！",shape=box,color=blue];
		j708042299 -> j3935210828;
	j1778648105 [label="要不是因為……這一切？",shape=box,color=red];
		j1778648105 -> j2803194718;
	j1213092535 [label="要不是因為……源拓氏？",shape=box,color=red];
		j1213092535 -> j2803194718;
	j3897498331 [label="哦我的天啊。你真以為我不會烤蛋糕？",shape=box,color=blue];
		j3897498331 -> j726455264;
	j133540930 [label="妳在捏造事實來發洩情緒。為什麼？",shape=box,color=red];
		j133540930 -> j4073101682;
	j4103907506 [label="妳是想傷害我的感受嗎？",shape=box,color=red];
		j4103907506 -> j4073101682;
	j3935210828 [label="我一直有在收聽這些電台。我覺得我們會相處得不錯。",shape=box,color=blue];
		j3935210828 -> j3265537775;
	j2803194718 [label="要不是因為這個白痴的網路。",shape=box,color=blue];
		j2803194718 -> j96554406;
		j2803194718 -> j24201325;
	j726455264 [label="剛好可以讓我專注在別件事上。你給我等著。",shape=box,color=blue];
		j726455264 -> j2906669224;
	j4073101682 [label="受歡迎並不是一切好嗎。要是每個人都想看你失敗呢？如果你身處高位，總有一天每個人都會想把你拉下來。",shape=box,color=blue];
		j4073101682 -> j464638723;
		j4073101682 -> j3267350316;
	j3265537775 [label="首先為了讓我可以核對我的理論，也許可以試著攔截某種物質，為了安全起見先攔截無生命的物質。",shape=box,color=blue];
		j3265537775 -> j3677327801;
	j96554406 [label="網路最終會消亡，別擔心。",shape=box,color=red];
		j96554406 -> j1916088979;
	j24201325 [label="所以妳在大學過得不好是因為……網路。",shape=box,color=red];
		j24201325 -> j3084781395;
	j2906669224 [label="+20 Chemistry",color=orange];
		j2906669224 -> "Chat ends. Next chat will be KayaRank2Convo3.";
	j464638723 [label="這裡不是高中。",shape=box,color=red];
		j464638723 -> j2607023928;
	j3267350316 [label="Nova，我們在這裡不是那樣的，我們還有真正的屁事要處理。",shape=box,color=red];
		j3267350316 -> j2607023928;
	j3677327801 [label="在某種程度上你算是留下了一個你自己的蟲洞讓我可以研究，所以我想你也算得上是我的研究夥伴。可以拿部分學分。",shape=box,color=blue];
		j3677327801 -> j3486332077;
		j3677327801 -> j3467374696;
	j1916088979 [label="也許是我殺死它的！",shape=box,color=blue];
		j1916088979 -> j2443544389;
	j3084781395 [label="我剛剛確實是這麼說的。",shape=box,color=blue];
		j3084781395 -> j1526196603;
	"Chat ends. Next chat will be KayaRank2Convo3." [color=orange];
	j2607023928 [label="信任別人會讓你受傷。信任網路上的人呢？會毀你一生。",shape=box,color=blue];
		j2607023928 -> j2906669224;
	j3486332077 [label="我們倆成績都拿到 A+！",shape=box,color=red];
		j3486332077 -> j777614900;
	j3467374696 [label="很高興我能幫上忙。",shape=box,color=red];
		j3467374696 -> j1022683695;
	j2443544389 [label="哦我的天啊，是我嗎？",shape=box,color=blue];
		j2443544389 -> j2464568268;
		j2443544389 -> j3644518745;
	j1526196603 [label="我來快速講給你聽，因為你有可能不知道在這裡事情是怎麼運作的。",shape=box,color=blue];
		j1526196603 -> j3997799117;
	j777614900 [label="但妳確定那不是我的收音機開著嗎？",shape=box,color=red];
		j777614900 -> j3108048973;
	j1022683695 [label="即使我快跟不上了。",shape=box,color=red];
		j1022683695 -> j3457525825;
	j2464568268 [label="抱歉但我真的不知道。",shape=box,color=red];
		j2464568268 -> j689734010;
	j3644518745 [label="哦是啊，當然。Nova 是以毀滅網路而聞名的。這就是我來這裡的原因，來阻止妳。",shape=box,color=red];
		j3644518745 -> j1617791345;
	j3997799117 [label="人們會在網路上會撒謊。他們會假裝是你的朋友，謠言在他們口中散佈得特別快。",shape=box,color=blue];
		j3997799117 -> j992499968;
	j3108048973 [label="百分之百確定。",shape=box,color=blue];
		j3108048973 -> j2906669224;
	j3457525825 [label="那就繼續跟上。",shape=box,color=blue];
		j3457525825 -> j2906669224;
	j689734010 [label="遜。隨便了。",shape=box,color=blue];
		j689734010 -> "Chat ends. Next chat will be KayaRank2Convo3.";
	j1617791345 [label="哈。最好是。",shape=box,color=blue];
		j1617791345 -> j973441048;
	j992499968 [label="而當這種事一旦發生，就別想再有正常的生活。朋友什麼的也都沒了。",shape=box,color=blue];
		j992499968 -> j59354241;
	j973441048 [label="+20 Chemistry",color=orange];
		j973441048 -> j2434932178;
	j59354241 [label="嗯那又怎樣，反正你也不會懂。讓我一個人靜一靜。",shape=box,color=blue];
		j59354241 -> j1405011396;
		j59354241 -> j1968588821;
	j2434932178 [label="當我專注於某件事時，沒人能阻止我。",shape=box,color=blue];
		j2434932178 -> "Chat ends. Next chat will be KayaRank2Convo3.";
	j1405011396 [label="如妳所願。獨自一人。",shape=box,color=red];
		j1405011396 -> j2800328152;
	j1968588821 [label="我很難知道我會不會惹到妳，發生在妳身上的事我很抱歉，但……",shape=box,color=red];
		j1968588821 -> j2242046869;
	j2800328152 [label="行。",shape=box,color=blue];
		j2800328152 -> "Chat ends. Next chat will be KayaRank2Convo3.";
	j2242046869 [label="我就需要靜一下。好。掰。",shape=box,color=blue];
		j2242046869 -> "Chat ends. Next chat will be KayaRank2Convo3.";
}