digraph {
	"KayaRank2Convo3 begins." [color=orange];
		"KayaRank2Convo3 begins." -> j1101874228;
	j1101874228 [label="你能解釋一下「Protea」的機制嗎？我找到一些她藍圖的資料，想確認一下。",shape=box,color=blue];
		j1101874228 -> j1306506470;
		j1101874228 -> j2355965593;
		j1101874228 -> j1183627483;
	j1306506470 [label="不行，無可奉告。[結束]",shape=box,color=red];
		j1306506470 -> j2189522063;
	j2355965593 [label="解釋她的機制？我可以試試。",shape=box,color=red];
		j2355965593 -> j1328771918;
		j2355965593 -> j2386779275;
	j1183627483 [label="Protea？她還蠻複雜的。",shape=box,color=red];
		j1183627483 -> j2253304628;
	j2189522063 [label="+20 Chemistry",color=orange];
		j2189522063 -> "Chat ends. Next chat will be KayaRank3Convo1.";
	j1328771918 [label="投擲。",shape=box,color=red];
		j1328771918 -> j4134402988;
	j2386779275 [label="我猜妳是想知道關於時空定錨的事？",shape=box,color=red];
		j2386779275 -> j2463585578;
	j2253304628 [label="不只是因為她能做什麼，而是因為她來的哪裡。",shape=box,color=red];
		j2253304628 -> j794908230;
		j2253304628 -> j2386779275;
	"Chat ends. Next chat will be KayaRank3Convo1." [color=orange];
	j4134402988 [label="投擲？",shape=box,color=blue];
		j4134402988 -> j3821305013;
		j4134402988 -> j2154038875;
	j2463585578 [label="+5 Chemistry",color=orange];
		j2463585578 -> j3953331428;
	j794908230 [label="無論她曾經是誰，她現在是 Parvos Granum 的侍奉者。",shape=box,color=red];
		j794908230 -> j291659860;
	j3821305013 [label="投擲，然後再投擲一些。",shape=box,color=red];
		j3821305013 -> j3327527069;
	j2154038875 [label="妳是這樣問的。",shape=box,color=red];
		j2154038875 -> j262140155;
	j3953331428 [label="是的。",shape=box,color=blue];
		j3953331428 -> j2788333275;
	j291659860 [label="是啊，有錢又有腦的大壞蛋。一如往常。",shape=box,color=blue];
		j291659860 -> j563707614;
		j291659860 -> j1063492538;
		j291659860 -> j2515983844;
	j3327527069 [label="呃。掰了？掰。",shape=box,color=blue];
		j3327527069 -> j2189522063;
	j262140155 [label="我問是想知道關於她的時間能力的答案，至少以我來看……",shape=box,color=blue];
		j262140155 -> j2788333275;
	j2788333275 [label="是的。是因為時間旅行，或是看起來有掌握某些與時間有關的能力。",shape=box,color=red];
		j2788333275 -> j410237963;
	j563707614 [label="妳知道這種人？",shape=box,color=red];
		j563707614 -> j907937668;
	j1063492538 [label="他也不是壞到骨子裡，但妳形容得很貼切了。",shape=box,color=red];
		j1063492538 -> j1089948633;
	j2515983844 [label="他要負責的事可多了。多到列不完，但 Protea 就是其中之一。",shape=box,color=red];
		j2515983844 -> j1279717923;
	j410237963 [label="是的。",shape=box,color=blue];
		j410237963 -> j778563921;
		j410237963 -> j352309609;
	j907937668 [label="是的。",shape=box,color=blue];
		j907937668 -> j2907849713;
	j1089948633 [label="隨便",shape=box,color=blue];
		j1089948633 -> j1279717923;
	j1279717923 [label="所以他是那個我該交談的人嗎？",shape=box,color=blue];
		j1279717923 -> j1549836788;
		j1279717923 -> j3340805912;
	j778563921 [label="因為出於某種原因，Nova 所能做的就是詢問她認識的唯一一個時間旅行者關於時間旅行的事。",shape=box,color=red];
		j778563921 -> j18224841;
	j352309609 [label="因為妳真的不會放棄？不是說我希望妳放棄，但我真的不知道該怎麼幫妳。",shape=box,color=red];
		j352309609 -> j986266481;
	j2907849713 [label="我大學的院長就是這種人。如果再給我遇見他……",shape=box,color=blue];
		j2907849713 -> j3487156245;
	j1549836788 [label="如果妳想在餘生都被當作科學實驗品的話，那當然沒問題。",shape=box,color=red];
		j1549836788 -> j3142788980;
	j3340805912 [label="我不認為讓妳跟他聯繫會是個好主意，即使這樣是可行的。",shape=box,color=red];
		j3340805912 -> j1257455528;
	j18224841 [label="+5 Chemistry",color=orange];
		j18224841 -> j1547016873;
	j986266481 [label="關於 Protea 的細節。像是有沒有我這樣形體的她？你知道的，像個半成品怪胎？",shape=box,color=blue];
		j986266481 -> j3474329041;
		j986266481 -> j254219889;
	j3487156245 [label="我以為他會站在我這邊但……",shape=box,color=blue];
		j3487156245 -> j381197013;
		j3487156245 -> j1086202472;
	j3142788980 [label="然後再把妳賣給出價最高的人。",shape=box,color=red];
		j3142788980 -> j1403451200;
	j1257455528 [label="我們試著專注在可以幫到妳的事物上。",shape=box,color=red];
		j1257455528 -> j3819994924;
	j1547016873 [label="是的。",shape=box,color=blue];
		j1547016873 -> j371533051;
	j3474329041 [label="然而那個半成品怪胎會解決時間旅行的問題。給自己一點肯定。",shape=box,color=red];
		j3474329041 -> j3154396057;
	j254219889 [label="我們認知中的那個 Protea Warframe。",shape=box,color=red];
		j254219889 -> j469066856;
	j381197013 [label="妳在大學發生了什麼事？",shape=box,color=red];
		j381197013 -> j3371778556;
	j1086202472 [label="在什麼事上站在妳這邊？",shape=box,color=red];
		j1086202472 -> j3371778556;
	j1403451200 [label="他是聰明人，但不是好人。我不覺得可以把他當成盟友。",shape=box,color=red];
		j1403451200 -> j518462224;
	j3819994924 [label="時空……方面的事物。",shape=box,color=red];
		j3819994924 -> j778563921;
	j371533051 [label="太好了，很興你能理解。",shape=box,color=blue];
		j371533051 -> j1383441528;
		j371533051 -> j1192432646;
	j3154396057 [label="+5 Chemistry",color=orange];
		j3154396057 -> j1921976621;
	j469066856 [label="辛苦她了。",shape=box,color=blue];
		j469066856 -> j3112306530;
	j3371778556 [label="呃，我們就讓話題停留在「Nova 對抗網路」吧。",shape=box,color=blue];
		j3371778556 -> j870825933;
	j518462224 [label="我想一下。",shape=box,color=blue];
		j518462224 -> j2675363939;
	j1383441528 [label="如果我想問關於 1999 年的問題呢？",shape=box,color=red];
		j1383441528 -> j3413157328;
	j1192432646 [label="我可以問妳任何事情嗎？",shape=box,color=red];
		j1192432646 -> j3413157328;
	j1921976621 [label="你說得對。",shape=box,color=blue];
		j1921976621 -> j3112306530;
	j3112306530 [label="但──",shape=box,color=blue];
		j3112306530 -> j3413157328;
	j870825933 [label="笨笨的 Nova。",shape=box,color=blue];
		j870825933 -> j2207970414;
	j2675363939 [label="嗯。好吧，我們假設 Protea 在所有這些造物之中擁有最先進的時間掌控能力",shape=box,color=blue];
		j2675363939 -> j2977061061;
	j3413157328 [label="事情是這樣的，而且會以這種方式進行。",shape=box,color=blue];
		j3413157328 -> j1037468459;
	j2207970414 [label="如果老師拒絕讓你上課，那麼成績就毫無意義了。",shape=box,color=blue];
		j2207970414 -> j2883416843;
		j2207970414 -> j2479421733;
	j2977061061 [label="這種掌控能力是否基於理論、科學、天生的能力，還是……嗯。",shape=box,color=blue];
		j2977061061 -> j2991446452;
	j1037468459 [label="我要像你那樣進行時間旅行。",shape=box,color=blue];
		j1037468459 -> j890837865;
	j2883416843 [label="現在已經事過境遷了。",shape=box,color=red];
		j2883416843 -> j2893179509;
	j2479421733 [label="如果妳想聊一下這件事……",shape=box,color=red];
		j2479421733 -> j2893179509;
	j2991446452 [label="嗯，好吧。其實。是的，我們就假設虛空與它有關。",shape=box,color=blue];
		j2991446452 -> j2384028125;
		j2991446452 -> j4223509191;
	j890837865 [label="我會去你穿越過來的那裡。",shape=box,color=blue];
		j890837865 -> j3391140675;
	j2893179509 [label="我知道，我知道……",shape=box,color=blue];
		j2893179509 -> j1317791936;
	j2384028125 [label="虛空並不是妳能簡單「解釋」的東西。",shape=box,color=red];
		j2384028125 -> j523525988;
	j4223509191 [label="虛空與……一切都有關。",shape=box,color=red];
		j4223509191 -> j155699923;
	j3391140675 [label="然後我就會知道你是不是會耍我了，或是我能不能真的信任你，我會知道未來發生的事。",shape=box,color=blue];
		j3391140675 -> j3280109324;
	j1317791936 [label="這樣好了，等我弄明白這個「時間旅行」的事，我會告訴你更多。反正我也沒什麼損失。",shape=box,color=blue];
		j1317791936 -> j2189522063;
	j523525988 [label="但它可能是我能夠利用的東西！哈！是時候測試一些東西了。",shape=box,color=blue];
		j523525988 -> j2864550264;
	j155699923 [label="那這可能對我來說意味著有一切理由進行另一項測試了。再見！",shape=box,color=blue];
		j155699923 -> j2864550264;
	j3280109324 [label="所以，我要回去看書了！關於 Protea 的事……嗯。",shape=box,color=blue];
		j3280109324 -> j2189522063;
	j2864550264 [label="等一下，小心！",shape=box,color=red];
		j2864550264 -> j4088838641;
	j4088838641 [label="Boolean KayaVoidTest is now true.",color=orange];
		j4088838641 -> j2189522063;
}