digraph {
	"KayaRank1Convo1 begins." [color=orange];
		"KayaRank1Convo1 begins." -> j1523093040;
	j1523093040 [label="你好，每個人都能穿越時空嗎，還是只有你？",shape=box,color=blue];
		j1523093040 -> j3305321215;
		j1523093040 -> j353016097;
	j3305321215 [label="嗯，妳也好。聽著，孩子，事情沒那麼簡單。",shape=box,color=red];
		j3305321215 -> j3557486344;
	j353016097 [label="妳好？卡婭？妳今天過得怎麼樣？",shape=box,color=red];
		j353016097 -> j1826398039;
	j3557486344 [label="我不是孩子。我已經十九歲了。",shape=box,color=blue];
		j3557486344 -> j3702211228;
		j3557486344 -> j3542362168;
	j1826398039 [label="還不錯。",shape=box,color=blue];
		j1826398039 -> j3085162182;
	j3702211228 [label="是的。不過孩子，我會說妳是這個新團體中最年輕的。",shape=box,color=red];
		j3702211228 -> j2845874940;
	j3542362168 [label="好吧，只是別急著了解時間旅行的事。這……很複雜。",shape=box,color=red];
		j3542362168 -> j2411115276;
	j3085162182 [label="所以，只有你嗎？還有其他人嗎？在未來，學校會教授時空穿越嗎？",shape=box,color=blue];
		j3085162182 -> j527518506;
	j2845874940 [label="呃。是最年輕沒錯，但顯然也是最執著於尋找答案的人。試著跟上我的腳步。所以，時間旅行。怎麼做到，誰能做到？",shape=box,color=blue];
		j2845874940 -> j159091955;
	j2411115276 [label="呃。有多複雜？公式？化學和原子元素？我會弄明白的，只要給我指引方向。",shape=box,color=blue];
		j2411115276 -> j3632305874;
		j2411115276 -> j1344024112;
	j527518506 [label="我們就當作只有我一個吧。這樣比較簡單。",shape=box,color=red];
		j527518506 -> j2835770848;
	j159091955 [label="而你又怎麼做到的？你是有計劃的嗎？",shape=box,color=blue];
		j159091955 -> j1215363836;
	j3632305874 [label="我真的不知道要告訴妳什麼。這不只牽扯到科學領域，就算是的話，那也是源拓氏所研究的科學領域。",shape=box,color=red];
		j3632305874 -> j914632635;
	j1344024112 [label="這裡有個方向：停止。[結束]",shape=box,color=red];
		j1344024112 -> j2938341431;
	j2835770848 [label="至於在學校有沒有教，如果有的話，我是沒學過。但或許有教？",shape=box,color=red];
		j2835770848 -> j894346757;
	j1215363836 [label="如果沒有，你有什麼樣的建議？這樣我才能獲得關於你能力的任何科學資料。",shape=box,color=blue];
		j1215363836 -> j3782914852;
	j914632635 [label="呃，那混蛋。我就知道我應該多問他一些問題的。好吧。至少如果這是科學問題的話，意味著我可以重現它，而且既然你能來去自如，我就能弄明白了。再見。",shape=box,color=blue];
		j914632635 -> j2938341431;
	j2938341431 [label="+20 Chemistry",color=orange];
		j2938341431 -> "Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue";
	j894346757 [label="為什麼，想做點家庭作業嗎？時間旅行以現在來說還可能太先進了……",shape=box,color=red];
		j894346757 -> j2136716582;
	j3782914852 [label="孩子，妳問題真多。但很遺憾地告訴妳，我不知道。只有源拓氏有答案。",shape=box,color=red];
		j3782914852 -> j3118378574;
	"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" [label="Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue",color=orange];
		"Initiate conversation HexKayaConvo1 in /Lotus/Types/Gameplay/1999Wf/Dialogue/HexDialogue_rom.dialogue" -> "Chat ends. Next chat will be KayaRank1Convo2.";
	j2136716582 [label="呃，你是認真的嗎？",shape=box,color=blue];
		j2136716582 -> j3986859597;
	j3118378574 [label="Boolean KayaSetKid is now true.",color=orange];
		j3118378574 -> j3619197689;
	"Chat ends. Next chat will be KayaRank1Convo2." [color=orange];
	j3986859597 [label="六煞幫有誰弄明白了嗎？他們有任何資料嗎？",shape=box,color=blue];
		j3986859597 -> j624168572;
		j3986859597 -> j1907643176;
	j3619197689 [label="行。",shape=box,color=blue];
		j3619197689 -> j2938341431;
	j624168572 [label="也許阿米爾？他可能有玩一些涉及時間旅行情節的遊戲……",shape=box,color=red];
		j624168572 -> j3193796833;
	j1907643176 [label="孩子，我認為沒有。但如果妳想學些有用的東西，可以向莉蒂請教關於治療的基礎知識。",shape=box,color=red];
		j1907643176 -> j1773390532;
	j3193796833 [label="Boolean KayaAmirTravel is now true.",color=orange];
		j3193796833 -> j812964278;
	j1773390532 [label="Boolean KayaLettieHeal is now true.",color=orange];
		j1773390532 -> j3629723759;
	j812964278 [label="遊戲？我只需要答案，一個方向，什麼都好。我會弄明白的。如果你想到任何有幫助的事，來找我。",shape=box,color=blue];
		j812964278 -> j2938341431;
	j3629723759 [label="沒什麼興趣。但隨便吧。",shape=box,color=blue];
		j3629723759 -> j2938341431;
}