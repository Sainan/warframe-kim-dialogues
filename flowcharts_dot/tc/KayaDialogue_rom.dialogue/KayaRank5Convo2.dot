	824 [label="像是我最大的憾事？",shape=box,color=red];
		824 -> 827;
	825 [label="比如什麼？妳來選。",shape=box,color=red];
		825 -> 828;
	823 [label="要不……聊聊卡利莫斯？",shape=box,color=red];
		823 -> 826;
	827 [label="嗯好的，當然可以。所以是什麼？",shape=box,color=blue];
		827 -> 832;
		827 -> 833;
		827 -> 834;
	828 [label="嗯我想……關於我的第一隻寵物？",shape=box,color=blue];
		828 -> 835;
	826 [label="嗯，她很好，只是我更是個愛狗女孩。小時候有養一隻。真希望能再見到牠。",shape=box,color=blue];
		826 -> 829;
		826 -> 830;
		826 -> 831;
	832 [label="沒有強硬要求阿爾布雷希特負起應負的責任。",shape=box,color=red];
		832 -> 838;
	833 [label="沒有早點阻止 Ballas。",shape=box,color=red];
		833 -> 839;
	834 [label="放棄自己。",shape=box,color=red];
		834 -> 840;
	835 [label="雖然這通常是那些駭客在網絡上的慣用問題，所以呃，不要告訴任何人。",shape=box,color=blue];
		835 -> 841;
	829 [label="我很遺憾。最好還是這裡結束話題。[結束]",shape=box,color=red];
		829 -> 836;
	830 [label="我很遺憾，告訴我關於牠的事。",shape=box,color=red];
		830 -> 837;
	831 [label="我也失去過一隻寵物。牠叫什麼名字？",shape=box,color=red];
		831 -> 837;
	838 [label="就像即使經歷了這一切，我還是讓他逃脫了。",shape=box,color=red];
		838 -> 844;
	839 [label="我不知道我怎麼樣才能改變事情。",shape=box,color=red];
		839 -> 845;
	840 [label="別人怎麼看並不重要。曾經有段時間，沒有人比我自己更恨我自己。",shape=box,color=red];
		840 -> 846;
	841 [label="但牠的名字是齋洛。我想你會叫他庫狛。",shape=box,color=blue];
		841 -> 847;
	836 [label="+20 Chemistry",color=orange];
		836 -> 842;
	837 [label="這其實有點不公平。源拓氏就可以帶著他那隻怪貓一起時間旅行？",shape=box,color=blue];
		837 -> 843;
	844 [label="我知道他以為他是在教我一些東西，但那混蛋甚至都沒意識到他讓我經歷了什麼。",shape=box,color=red];
		844 -> 849;
	845 [label="但我知道，如果我就算只快一分鐘，就會有人少受一點苦。",shape=box,color=red];
		845 -> 850;
	846 [label="我甚至不能死。而我希望我能。",shape=box,color=red];
		846 -> 851;
	847 [label="牠超大隻的，你能想像最巨大的狗。我打賭牠能把沃爾科夫先生咬成兩半。",shape=box,color=blue];
		847 -> 852;
		847 -> 853;
	842 [label="Chat ends. Next chat will be KayaRank5Convo3.",color=orange];
	843 [label="如果我有齋洛在我身邊……這趟旅途會輕鬆很多。",shape=box,color=blue];
		843 -> 848;
	849 [label="而不只是我。我們所有人。還有 Loid，Gomaitru……這簡直太令人作嘔了。如果我再見到他，我不知道自己能否忍住。",shape=box,color=red];
		849 -> 851;
	850 [label="Ballas 就是我所懼怕的一切。他就是生命本身最糟糕的一面。",shape=box,color=red];
		850 -> 851;
	851 [label="當你這樣說的時候……我想人生和人們有時確實有點糟糕，不是嗎？",shape=box,color=blue];
		851 -> 855;
	852 [label="我來的那裡我們還有大型庫狛！",shape=box,color=red];
		852 -> 856;
	853 [label="額，我不知道欸，沃爾科夫先生可是相當強悍。",shape=box,color=red];
		853 -> 857;
	848 [label="你知道嗎，齋洛是第一個看到我哭的生物。",shape=box,color=blue];
		848 -> 854;
	855 [label="但有時候它又很棒。",shape=box,color=blue];
		855 -> 859;
	856 [label="噢，我的天啊……這讓我更有理由去那裡了。哇哦！",shape=box,color=blue];
		856 -> 860;
	857 [label="其實你可能說得有道理……但反正，齋洛是嚇人的大傢伙。但牠非常保護我。",shape=box,color=blue];
		857 -> 848;
	854 [label="我當時大概五歲，在我記憶中我一直都沒哭過。",shape=box,color=blue];
		854 -> 858;
	859 [label="我想我們不能用最重大的憾事來定義自己。我覺得你有幫助我從我的遺憾中走出來了。",shape=box,color=blue];
		859 -> 862;
	860 [label="齋洛先生非常保護我。",shape=box,color=blue];
		860 -> 848;
	858 [label="但那次我在小學一年級的第一天回到家，齋洛就在那裡。",shape=box,color=blue];
		858 -> 861;
	862 [label="但我不會改變已經發生過的事。",shape=box,color=blue];
		862 -> 865;
	861 [label="然後他就跟著我回房間，在我哭泣時守在門口。",shape=box,color=blue];
		861 -> 863;
		861 -> 864;
	865 [label="因為，我並不討厭自己的這一切。Nova 簡直是有史以來最酷的事情了。",shape=box,color=blue];
		865 -> 868;
	863 [label="是什麼讓妳這麼難過？",shape=box,color=red];
		863 -> 866;
	864 [label="妳怎麼會記得這件事？",shape=box,color=red];
		864 -> 867;
	868 [label="妳不會改變任何一件事？",shape=box,color=red];
		868 -> 871;
	866 [label="有人說我胖。",shape=box,color=blue];
		866 -> 869;
	867 [label="我又怎麼會忘記？！",shape=box,color=blue];
		867 -> 870;
	871 [label="一件都不會。而我希望你也不會。",shape=box,color=blue];
		871 -> 874;
	869 [label="這在我成長的年代是讓孩子不受歡迎的事情。",shape=box,color=blue];
