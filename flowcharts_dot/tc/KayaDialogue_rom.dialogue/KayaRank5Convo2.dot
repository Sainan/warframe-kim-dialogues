digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank5Convo2 begins." [color=orange];
		"KayaRank5Convo2 begins." -> j3193862034;
	j3193862034 [label="這次我問妳關於時間旅行的事怎麼樣？",shape=box,color=red];
		j3193862034 -> j2904419459;
	j2904419459 [label="不用了。其實我們還是聊點別的好了！好嗎？",shape=box,color=blue];
		j2904419459 -> j3602582192;
	j3602582192 [label="Check boolean KayaPromiseRegret",color=orange];
		j3602582192 -> j3394974994 [label=true,color=green];
		j3602582192 -> j2547984124 [label=false,color=brown];
		j3602582192 -> j855499546 [label=false,color=brown];
	j3394974994 [label="像是我最大的憾事？",shape=box,color=red];
		j3394974994 -> j3399376298;
	j2547984124 [label="比如什麼？妳來選。",shape=box,color=red];
		j2547984124 -> j2192278189;
	j855499546 [label="要不……聊聊卡利莫斯？",shape=box,color=red];
		j855499546 -> j3902037586;
	j3399376298 [label="嗯好的，當然可以。所以是什麼？",shape=box,color=blue];
		j3399376298 -> j2270265104;
		j3399376298 -> j1094918217;
		j3399376298 -> j2249656815;
	j2192278189 [label="嗯我想……關於我的第一隻寵物？",shape=box,color=blue];
		j2192278189 -> j528511842;
	j3902037586 [label="嗯，她很好，只是我更是個愛狗女孩。小時候有養一隻。真希望能再見到牠。",shape=box,color=blue];
		j3902037586 -> j2858899587;
		j3902037586 -> j1430499524;
		j3902037586 -> j3141021240;
	j2270265104 [label="沒有強硬要求阿爾布雷希特負起應負的責任。",shape=box,color=red];
		j2270265104 -> j1582844782;
	j1094918217 [label="沒有早點阻止 Ballas。",shape=box,color=red];
		j1094918217 -> j77985652;
	j2249656815 [label="放棄自己。",shape=box,color=red];
		j2249656815 -> j1952226609;
	j528511842 [label="雖然這通常是那些駭客在網絡上的慣用問題，所以呃，不要告訴任何人。",shape=box,color=blue];
		j528511842 -> j3515111424;
	j2858899587 [label="我很遺憾。最好還是這裡結束話題。[結束]",shape=box,color=red];
		j2858899587 -> j3219460250;
	j1430499524 [label="我很遺憾，告訴我關於牠的事。",shape=box,color=red];
		j1430499524 -> j1761766622;
	j3141021240 [label="我也失去過一隻寵物。牠叫什麼名字？",shape=box,color=red];
		j3141021240 -> j1761766622;
	j1582844782 [label="就像即使經歷了這一切，我還是讓他逃脫了。",shape=box,color=red];
		j1582844782 -> j3708430707;
	j77985652 [label="我不知道我怎麼樣才能改變事情。",shape=box,color=red];
		j77985652 -> j4128221334;
	j1952226609 [label="別人怎麼看並不重要。曾經有段時間，沒有人比我自己更恨我自己。",shape=box,color=red];
		j1952226609 -> j1163456586;
	j3515111424 [label="但牠的名字是齋洛。我想你會叫他庫狛。",shape=box,color=blue];
		j3515111424 -> j3106228473;
	j3219460250 [label="+20 Chemistry",color=orange];
		j3219460250 -> "Chat ends. Next chat will be KayaRank5Convo3.";
	j1761766622 [label="這其實有點不公平。源拓氏就可以帶著他那隻怪貓一起時間旅行？",shape=box,color=blue];
		j1761766622 -> j1601713493;
	j3708430707 [label="我知道他以為他是在教我一些東西，但那混蛋甚至都沒意識到他讓我經歷了什麼。",shape=box,color=red];
		j3708430707 -> j1327128635;
	j4128221334 [label="但我知道，如果我就算只快一分鐘，就會有人少受一點苦。",shape=box,color=red];
		j4128221334 -> j1727360820;
	j1163456586 [label="我甚至不能死。而我希望我能。",shape=box,color=red];
		j1163456586 -> j1513463094;
	j3106228473 [label="牠超大隻的，你能想像最巨大的狗。我打賭牠能把沃爾科夫先生咬成兩半。",shape=box,color=blue];
		j3106228473 -> j2770565930;
		j3106228473 -> j1691993985;
	"Chat ends. Next chat will be KayaRank5Convo3." [color=orange];
	j1601713493 [label="如果我有齋洛在我身邊……這趟旅途會輕鬆很多。",shape=box,color=blue];
		j1601713493 -> j2440795803;
	j1327128635 [label="而不只是我。我們所有人。還有 Loid，Gomaitru……這簡直太令人作嘔了。如果我再見到他，我不知道自己能否忍住。",shape=box,color=red];
		j1327128635 -> j1513463094;
	j1727360820 [label="Ballas 就是我所懼怕的一切。他就是生命本身最糟糕的一面。",shape=box,color=red];
		j1727360820 -> j1513463094;
	j1513463094 [label="當你這樣說的時候……我想人生和人們有時確實有點糟糕，不是嗎？",shape=box,color=blue];
		j1513463094 -> j2036619926;
	j2770565930 [label="我來的那裡我們還有大型庫狛！",shape=box,color=red];
		j2770565930 -> j3613163171;
	j1691993985 [label="額，我不知道欸，沃爾科夫先生可是相當強悍。",shape=box,color=red];
		j1691993985 -> j2870825075;
	j2440795803 [label="你知道嗎，齋洛是第一個看到我哭的生物。",shape=box,color=blue];
		j2440795803 -> j3634989588;
	j2036619926 [label="但有時候它又很棒。",shape=box,color=blue];
		j2036619926 -> j997162386;
	j3613163171 [label="噢，我的天啊……這讓我更有理由去那裡了。哇哦！",shape=box,color=blue];
		j3613163171 -> j5349088;
	j2870825075 [label="其實你可能說得有道理……但反正，齋洛是嚇人的大傢伙。但牠非常保護我。",shape=box,color=blue];
		j2870825075 -> j2440795803;
	j3634989588 [label="我當時大概五歲，在我記憶中我一直都沒哭過。",shape=box,color=blue];
		j3634989588 -> j202391948;
	j997162386 [label="我想我們不能用最重大的憾事來定義自己。我覺得你有幫助我從我的遺憾中走出來了。",shape=box,color=blue];
		j997162386 -> j1528189802;
	j5349088 [label="齋洛先生非常保護我。",shape=box,color=blue];
		j5349088 -> j2440795803;
	j202391948 [label="但那次我在小學一年級的第一天回到家，齋洛就在那裡。",shape=box,color=blue];
		j202391948 -> j4260732871;
	j1528189802 [label="但我不會改變已經發生過的事。",shape=box,color=blue];
		j1528189802 -> j3747054688;
	j4260732871 [label="然後他就跟著我回房間，在我哭泣時守在門口。",shape=box,color=blue];
		j4260732871 -> j2299937482;
		j4260732871 -> j1879252749;
	j3747054688 [label="因為，我並不討厭自己的這一切。Nova 簡直是有史以來最酷的事情了。",shape=box,color=blue];
		j3747054688 -> j67567359;
	j2299937482 [label="是什麼讓妳這麼難過？",shape=box,color=red];
		j2299937482 -> j1567199499;
	j1879252749 [label="妳怎麼會記得這件事？",shape=box,color=red];
		j1879252749 -> j2212274803;
	j67567359 [label="妳不會改變任何一件事？",shape=box,color=red];
		j67567359 -> j1932712793;
	j1567199499 [label="有人說我胖。",shape=box,color=blue];
		j1567199499 -> j3141383976;
	j2212274803 [label="我又怎麼會忘記？！",shape=box,color=blue];
		j2212274803 -> j1567199499;
	j1932712793 [label="一件都不會。而我希望你也不會。",shape=box,color=blue];
		j1932712793 -> j3219460250;
	j3141383976 [label="這在我成長的年代是讓孩子不受歡迎的事情。",shape=box,color=blue];
		j3141383976 -> j3735695909;
		j3141383976 -> j4031764140;
	j3735695909 [label="孩子們有時候真的很殘忍。",shape=box,color=red];
		j3735695909 -> j1124104241;
	j4031764140 [label="受歡迎真的有那麼重要嗎？",shape=box,color=red];
		j4031764140 -> j1433919981;
	j1124104241 [label="每個人都很殘忍。",shape=box,color=blue];
		j1124104241 -> j4007582000;
	j1433919981 [label="是的……直到這一切發生。經歷這些糟糕事之後，我覺得我成為了更好的人，好像，我終於成為了真正應該成為的自己。",shape=box,color=blue];
		j1433919981 -> j1061869470;
	j4007582000 [label="每個人都想當酷小孩。",shape=box,color=blue];
		j4007582000 -> j4147511032;
	j1061869470 [label="不再在意別人對我的看法。就……終於開始真正地活出自己。",shape=box,color=blue];
		j1061869470 -> j3219460250;
	j4147511032 [label="但我現在意識到，不在乎自己酷不酷才更酷。所以你才這麼酷。",shape=box,color=blue];
		j4147511032 -> j686513904;
	j686513904 [label="經歷這些糟糕事之後，我覺得我成為了更好的人，好像，我終於成為了真正應該成為的自己。",shape=box,color=blue];
		j686513904 -> j1061869470;
}