	875 [label="每個人都很殘忍。",shape=box,color=blue];
		875 -> 878;
	876 [label="是的……直到這一切發生。經歷這些糟糕事之後，我覺得我成為了更好的人，好像，我終於成為了真正應該成為的自己。",shape=box,color=blue];
		876 -> 879;
	878 [label="每個人都想當酷小孩。",shape=box,color=blue];
		878 -> 880;
	879 [label="不再在意別人對我的看法。就……終於開始真正地活出自己。",shape=box,color=blue];
		879 -> 881;
	880 [label="但我現在意識到，不在乎自己酷不酷才更酷。所以你才這麼酷。",shape=box,color=blue];
		880 -> 882;
	881 [label="+20 Chemistry",color=orange];
		881 -> 883;
	882 [label="經歷這些糟糕事之後，我覺得我成為了更好的人，好像，我終於成為了真正應該成為的自己。",shape=box,color=blue];
