		j1743400265 -> j1232005620;
		j1743400265 -> j1167247155;
	j2173208422 [label="Nova，深呼吸，放鬆一下。[結束]",shape=box,color=red];
		j2173208422 -> j3588492270;
	j1232005620 [label="這對每個人來說都不容易。妳會沒事的。",shape=box,color=red];
		j1232005620 -> j2806132612;
	j1167247155 [label="我們每個人都因為這屁事而失去了一些東西。看看四周。",shape=box,color=red];
		j1167247155 -> j1242786840;
	j3588492270 [label="+20 Chemistry",color=orange];
		j3588492270 -> "Chat ends. Next chat will be KayaRank4Convo1.";
	j2806132612 [label="當我能逃離這一年時，我才會「沒事」。",shape=box,color=blue];
		j2806132612 -> j340121;
	j1242786840 [label="我只是不知道我還能不能再相信人了。甚至是你……",shape=box,color=blue];
		j1242786840 -> j348543973;
	"Chat ends. Next chat will be KayaRank4Convo1." [color=orange];
	j340121 [label="你把我困在了我生命中最慘的一年。",shape=box,color=blue];
		j340121 -> j348543973;
	j348543973 [label="基本上我只是在利用你來逃離這裡。",shape=box,color=blue];
		j348543973 -> j1798296242;
		j348543973 -> j130835136;
	j1798296242 [label="無論是什麼原因導致妳變成這樣，都在毀掉妳獲得真正幸福的機會。",shape=box,color=red];
		j1798296242 -> j62235826;
	j130835136 [label="隨便妳。妳越早滾開，我就越不需要面對妳這種態度。",shape=box,color=red];
		j130835136 -> j3256197341;
	j62235826 [label="妳無法讓我怨恨妳。妳當然可以惹惱我，但那並不是恨。",shape=box,color=red];
		j62235826 -> j2750954149;
		j62235826 -> j3455591568;
	j3256197341 [label="很高興我們意見一致。",shape=box,color=blue];
		j3256197341 -> j1173661291;
	j2750954149 [label="如果妳要把這當成是在利用我們的話，那就隨妳便。",shape=box,color=red];
		j2750954149 -> j3530039649;
	j3455591568 [label="無論如何，我都會想辦法幫妳。",shape=box,color=red];
		j3455591568 -> j4242027638;
	j1173661291 [label="Boolean KayaAttitude is now true.",color=orange];
		j1173661291 -> j3588492270;
	j3530039649 [label="當妳釐清一切時，而妳一定會的，我們仍舊會在這裡。",shape=box,color=red];
		j3530039649 -> j743145022;
	j4242027638 [label="我只希望妳能夠盡快了解到我們並不是想要傷害妳。",shape=box,color=red];
		j4242027638 -> j3375768083;
	j743145022 [label="當你們發現時……你們都不會用同樣的眼光看待我了……",shape=box,color=blue];
		j743145022 -> j3588492270;
	j3375768083 [label="就算你們沒有想傷害我，我就是會搞砸一些事。我總是這樣。",shape=box,color=blue];
		j3375768083 -> j3588492270;
