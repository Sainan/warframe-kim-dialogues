	236 [label="Chat ends. Next chat will be KayaRank2Convo2.",color=orange];
	237 [label="不懂……",shape=box,color=red];
		237 -> 238;
	238 [label="在大學裡就會有一群女生對彼此稱姊道妹並以為這樣很特別。就像某個「俱樂部」之類的吧，我猜。",shape=box,color=blue];
		238 -> 239;
