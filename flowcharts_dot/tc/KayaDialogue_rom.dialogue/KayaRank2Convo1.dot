		218 -> 225;
	220 [label="+20 Chemistry",color=orange];
		220 -> 227;
	221 [label="Chat ends. Next chat will be KayaRank2Convo2.",color=orange];
	222 [label="你們真心……喜歡我嗎？",shape=box,color=blue];
		222 -> 228;
		222 -> 229;
	226 [label="而且每個人似乎都信任你，或者至少他們是這麼說的。",shape=box,color=blue];
		226 -> 225;
		226 -> 224;
		226 -> 223;
	223 [label="信任他人並一起努力正是讓我們成就自己的原因。",shape=box,color=red];
		223 -> 230;
	224 [label="關心朋友是一種力量。正是這個原因讓每個人都能承受這一切狗屁。",shape=box,color=red];
		224 -> 230;
	225 [label="我們都有自己的狗屁事要處理。一個人獨自面對是很困難的。",shape=box,color=red];
		225 -> 230;
	227 [label="Chat ends. Next chat will be KayaRank2Convo2.",color=orange];
	228 [label="我們只是在等妳在我們身邊能感到自在。",shape=box,color=red];
		228 -> 231;
	229 [label="我們怎麼可能不喜歡妳？",shape=box,color=red];
		229 -> 231;
	230 [label="哈哈，聽起來好像是什麼姊妹會的口號。",shape=box,color=blue];
		230 -> 232;
		230 -> 233;
	231 [label="我……知道了。",shape=box,color=blue];
		231 -> 234;
	232 [label="「姊妹會口號」到底是什麼？",shape=box,color=red];
