digraph {
	169 [label="KayaRank2Convo1 begins.",color=orange];
		169 -> 170;
	170 [label="嘿，卡婭！",shape=box,color=red];
		170 -> 171;
	171 [label="是 Nova，我的線上暱稱是 Nova。",shape=box,color=blue];
		171 -> 172;
		171 -> 173;
	172 [label="好的，那就叫妳 Nova。",shape=box,color=red];
		172 -> 174;
	173 [label="這樣啊。什麼時候開始的？",shape=box,color=red];
		173 -> 175;
	174 [label="嗯，就別在網路上直呼我卡婭，謝謝。你可以當面這樣叫我，但在這裡，就叫我 NOVA，可以嗎？",shape=box,color=blue];
		174 -> 176;
		174 -> 177;
	175 [label="額，這有很重要嗎？我在網路上不想使用真實姓名。",shape=box,color=blue];
		175 -> 178;
		175 -> 179;
	176 [label="好吧，但我能問為什麼嗎？",shape=box,color=red];
		176 -> 180;
	177 [label="了解。Nova。Nova。對。我想請問一下我還能為妳做些什麼來讓妳在這裡感覺更舒服自在的嗎？",shape=box,color=red];
		177 -> 181;
	178 [label="對啊，不想讓別人看到妳有多常問我關於時間旅行的事了。",shape=box,color=red];
		178 -> 182;
	179 [label="哦？我很確定阿米爾已經把這裡的網路弄得很安全了，除非還有我不知道的事？",shape=box,color=red];
		179 -> 183;
	180 [label="你有問過其他人他們有喜歡用的暱稱嗎？你管我。",shape=box,color=blue];
		180 -> 177;
	181 [label="我知道沒有人要求「待在」這個臨時之家，但我們大家都在盡力了。",shape=box,color=red];
		181 -> 184;
	182 [label="你是認真的嗎？網路上很危險。是真的很危險。",shape=box,color=blue];
		182 -> 185;
		182 -> 186;
	183 [label="這對我來說很重要。我不想讓任何人再在網路上找到關於卡婭的資料。",shape=box,color=blue];
		183 -> 187;
		183 -> 188;
	184 [label="嗯呃，很舒服自在了。沒有人散佈關於我的流言蜚語吧？",shape=box,color=blue];
		184 -> 189;
		184 -> 190;
	185 [label="妳是有發生什麼事嗎？",shape=box,color=red];
		185 -> 191;
	186 [label="妳覺得時間旅行就不危險嗎？",shape=box,color=red];
		186 -> 192;
	187 [label="我發誓時空特警不會抓到妳的。",shape=box,color=red];
		187 -> 193;
	188 [label="有遇上什麼麻煩了？",shape=box,color=red];
		188 -> 194;
	189 [label="這個嘛，葵確實有說……",shape=box,color=red];
		189 -> 195;
	190 [label="一個字都沒有。只是很高興有妳在。",shape=box,color=red];
		190 -> 196;
	191 [label="Check boolean KayaSetKid",color=orange];
		191 -> 198 [label=true,color=green];
		191 -> 197 [label=false,color=brown];
	192 [label="Check boolean KayaSetKid",color=orange];
		192 -> 200 [label=true,color=green];
		192 -> 199 [label=false,color=brown];
	193 [label="呃。不好笑。",shape=box,color=blue];
		193 -> 201;
	194 [label="曾經，我犯下了一個愚蠢的錯誤。",shape=box,color=blue];
		194 -> 202;
	195 [label="就別開這種玩笑了。",shape=box,color=blue];
		195 -> 203;
	196 [label="亞瑟和愛琳娜肯定是把妳當成比他們還要聰明的小妹妹了。",shape=box,color=red];
		196 -> 204;
	198 [label="是你說我像個孩子的，如果我真的是有發生什麼事呢？",shape=box,color=blue];
		198 -> 206;
	197 [label="現在我什麼都改變不了。",shape=box,color=blue];
		197 -> 205;
	200 [label="聽著，我知道你認為我只是個孩子。",shape=box,color=blue];
		200 -> 208;
	199 [label="好吧。你說得對。",shape=box,color=blue];
		199 -> 207;
	201 [label="+20 Chemistry",color=orange];
		201 -> 209;
	202 [label="而我是不會犯錯的。",shape=box,color=blue];
		202 -> 210;
	203 [label="一點都不好笑。把我們這樣的女孩關在同個房間裡，每個人都期待我們會互撕。",shape=box,color=blue];
		203 -> 211;
	204 [label="阿米爾和崑西對妳的蟲洞難以忘懷，我發誓當妳沒在注意的時候，他們就會穿過去了。",shape=box,color=red];
		204 -> 212;
	206 [label="那我會希望妳能從周圍的人身上看到，我們是個互相幫助的團隊。",shape=box,color=red];
		206 -> 214;
	205 [label="那麼，這就是為什麼妳想要弄明白這個關於時間旅行的事情嗎？是想證明什麼嗎？",shape=box,color=red];
		205 -> 213;
	208 [label="但──",shape=box,color=blue];
		208 -> 194;
	207 [label="大概吧。而就因為這樣，我更要知道怎麼正確地做這件事。不能犯下任何錯。",shape=box,color=blue];
		207 -> 194;
	209 [label="Chat ends. Next chat will be KayaRank2Convo2.",color=orange];
	210 [label="所以再給我幾天時間，也許幾個星期，我就能把這整件事弄明白，然後就可以跟 1999 年說再見了。",shape=box,color=blue];
		210 -> 215;
	211 [label="嫉妒。比較。呃，我已經受夠那階段的人生了。別想讓我與其他女孩起爭執。",shape=box,color=blue];
		211 -> 216;
	212 [label="葵和莉蒂似乎下不了決定是否要當妳最好的朋友還是當妳的媽媽了。",shape=box,color=red];
		212 -> 217;
	214 [label="嗯。",shape=box,color=blue];
		214 -> 219;
	213 [label="也許吧。",shape=box,color=blue];
		213 -> 218;
	215 [label="說到做到。",shape=box,color=blue];
		215 -> 220;
	216 [label="+20 Chemistry",color=orange];
		216 -> 221;
	217 [label="當然還有我，我很高興有人想要了解我是怎麼來到這裡的。",shape=box,color=red];
		217 -> 222;
	219 [label="你說得對。你也並不是完全不受歡迎。",shape=box,color=blue];
		219 -> 226;
	218 [label="不過，你那麼在乎幹嘛？",shape=box,color=blue];
		218 -> 223;
