		430 -> 433;
	433 [label="很噁對吧？超噁的。但後來我一看，發現他們在蛋糕底下藏了一個塑膠容器，裡面裝滿了密封的吉你夢卡牌包。這是我最喜歡的東西了。",shape=box,color=blue];
		433 -> 434;
	434 [label="但凡我這樣的女孩在學校絕對不能被發現開心收到那些東西。但顯然這個害羞的小朋友是真的很了解我並偷偷塞給我真正的禮物，同時看起來想用大蛋糕之類的吸引我的注意，我也不知道。",shape=box,color=blue];
