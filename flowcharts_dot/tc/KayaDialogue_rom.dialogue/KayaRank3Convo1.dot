digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank3Convo1 begins." [color=orange];
		"KayaRank3Convo1 begins." -> j3942273417;
	j3942273417 [label="我剛才意識到你讓我想起誰了。",shape=box,color=blue];
		j3942273417 -> j4289409783;
	j4289409783 [label="大學一年級時跟我一組的一位學生。",shape=box,color=blue];
		j4289409783 -> j2561229719;
	j2561229719 [label="Check boolean KayaCake",color=orange];
		j2561229719 -> j3628382771 [label=true,color=green];
		j2561229719 -> j243650349 [label=false,color=brown];
		j2561229719 -> j202310841 [label=false,color=brown];
	j3628382771 [label="呃哦。這樣算好事嗎？",shape=box,color=red];
		j3628382771 -> j3003080601;
	j243650349 [label="一位極具魅力且聰明的學生？",shape=box,color=red];
		j243650349 -> j1215287868;
	j202310841 [label="我準備一下，免得起爭執……",shape=box,color=red];
		j202310841 -> j593907429;
	j3003080601 [label="其實，是的。",shape=box,color=blue];
		j3003080601 -> j3200594796;
	j1215287868 [label="噁爛。不想打破你的興致，但我從不調情。永遠不會。",shape=box,color=blue];
		j1215287868 -> j4134839538;
	j593907429 [label="我的天啊，拜託，不要。這是一段快樂的回憶。",shape=box,color=blue];
		j593907429 -> j3874242289;
		j593907429 -> j1555055364;
	j3200594796 [label="我正在烤蛋糕來證明你錯了。",shape=box,color=blue];
		j3200594796 -> j4280207499;
	j4134839538 [label="尤其在網路上。",shape=box,color=blue];
		j4134839538 -> j3869566756;
		j4134839538 -> j2888957827;
	j3874242289 [label="你說是就是了。",shape=box,color=red];
		j3874242289 -> j2918523915;
	j1555055364 [label="你似乎沒有太多這樣的回憶。",shape=box,color=red];
		j1555055364 -> j1540686252;
	j4280207499 [label="這讓我想起唯一一次有人為我烤蛋糕的是那位害羞的同學。",shape=box,color=blue];
		j4280207499 -> j3849397352;
	j3869566756 [label="但如果我想呢？",shape=box,color=red];
		j3869566756 -> j3317483160;
	j2888957827 [label="該死，我的錯。我的錯。",shape=box,color=red];
		j2888957827 -> j428250429;
	j2918523915 [label="其實是關於我的生日，但不是關於我。",shape=box,color=blue];
		j2918523915 -> j2952001432;
	j1540686252 [label="那麼就讓我來分享一個吧！",shape=box,color=blue];
		j1540686252 -> j2918523915;
	j3849397352 [label="他們不知道是怎麼發現我生日的，儘管我私下從未和他們有過任何交集。",shape=box,color=blue];
		j3849397352 -> j488114943;
	j3317483160 [label="那麼對象就絕對不會是我了。",shape=box,color=blue];
		j3317483160 -> j2013445877;
	j428250429 [label="以後就別再試了。",shape=box,color=blue];
		j428250429 -> j816826911;
	j2952001432 [label="好吧，我想有點算是關於我。我應該說，呃，我絕對是大家都想高攀的那個人。",shape=box,color=blue];
		j2952001432 -> j1004235817;
	j488114943 [label="他們為我買了撒有香草糖霜的香草蛋糕，我發誓那蛋糕有三層高。",shape=box,color=blue];
		j488114943 -> j2732961121;
	j2013445877 [label="+5 Chemistry",color=orange];
		j2013445877 -> "Chat ends. Next chat will be KayaRank3Convo2.";
	j816826911 [label="我答應我以後不會了。",shape=box,color=red];
		j816826911 -> j93078502;
	j1004235817 [label="成績很好。其實超好。而且又是啦啦隊隊長。受邀參加我的生日派對是件大事。",shape=box,color=blue];
		j1004235817 -> j326472218;
	j2732961121 [label="總之，我看到他們拿著蛋糕。我還很擔心讓全班看到他們送我蛋糕。我們玩在一起的交友圈根本就不是同一個。",shape=box,color=blue];
		j2732961121 -> j4092787;
	"Chat ends. Next chat will be KayaRank3Convo2." [color=orange];
	j93078502 [label="Boolean KayaFlirtPromise is now true.",color=orange];
		j93078502 -> j9523615;
	j326472218 [label="總之，這位學生為我烤了個生日蛋糕，但告訴我不要與任何人分享，等我回到家後才吃。",shape=box,color=blue];
		j326472218 -> j3026219733;
	j4092787 [label="我成績很好。其實是超好。而且又是啦啦隊隊長。受邀參加我的生日派對是件大事。",shape=box,color=blue];
		j4092787 -> j326472218;
	j9523615 [label="好吧。",shape=box,color=blue];
		j9523615 -> j326472218;
	j3026219733 [label="老實說，這讓我感覺好怪，有點像你最初給我的印象。但後來我切開蛋糕時，我的廚刀切到某個堅硬的東西。",shape=box,color=blue];
		j3026219733 -> j337043462;
	j337043462 [label="很噁對吧？超噁的。但後來我一看，發現他們在蛋糕底下藏了一個塑膠容器，裡面裝滿了密封的吉你夢卡牌包。這是我最喜歡的東西了。",shape=box,color=blue];
		j337043462 -> j4246060230;
	j4246060230 [label="但凡我這樣的女孩在學校絕對不能被發現開心收到那些東西。但顯然這個害羞的小朋友是真的很了解我並偷偷塞給我真正的禮物，同時看起來想用大蛋糕之類的吸引我的注意，我也不知道。",shape=box,color=blue];
		j4246060230 -> j1318802838;
		j4246060230 -> j2937053811;
		j4246060230 -> j3953526728;
	j1318802838 [label="我不會給你烤蛋糕的。",shape=box,color=red];
		j1318802838 -> j2154821723;
	j2937053811 [label="對於一個被認為是天才小孩的人來說，你真的花很長時間才能表達重點……",shape=box,color=red];
		j2937053811 -> j972636144;
	j3953526728 [label="而這究竟怎麼讓你想起我了？",shape=box,color=red];
		j3953526728 -> j1211430780;
	j2154821723 [label="+20 Chemistry",color=orange];
		j2154821723 -> j64924198;
	j972636144 [label="而對於一個來自偉大且鼓舞人心的未來的人，你確實錯過了重點。那就是吉你夢卡牌！我！你相信嗎？",shape=box,color=blue];
		j972636144 -> j1845175252;
		j972636144 -> j1310663289;
	j1211430780 [label="我想這是在用我自己的方式說，我信任你，所以讓你知道我有在收集吉你夢卡牌。這些卡牌算是只有魯蛇才會玩的東西。",shape=box,color=blue];
		j1211430780 -> j3689451458;
	j64924198 [label="哈哈哈！",shape=box,color=blue];
		j64924198 -> j2184897535;
	j1845175252 [label="我完全不知道那是什麼東西！",shape=box,color=red];
		j1845175252 -> j3907356807;
	j1310663289 [label="它們像是，特別的收藏品嗎？",shape=box,color=red];
		j1310663289 -> j3907356807;
	j3689451458 [label="或者至少我是這麼想的。但真正的魯蛇是其他所有人。",shape=box,color=blue];
		j3689451458 -> j901715548;
		j3689451458 -> j849116547;
		j3689451458 -> j2574419930;
	j2184897535 [label="反正也可能會很噁心就是了。",shape=box,color=blue];
		j2184897535 -> j2805743173;
		j2184897535 -> j2644789031;
	j3907356807 [label="它們就像是給小朋友玩的怪獸卡牌遊戲。尤其在大學裡，完全算是只有魯蛇才會玩的東西。",shape=box,color=blue];
		j3907356807 -> j3689451458;
	j901715548 [label="也許找一天你讓我看一下你的吉你夢卡牌？",shape=box,color=red];
		j901715548 -> j22162042;
	j849116547 [label="哇哦，我們完成了一次隻字沒提到時間旅行的完整對話欸！",shape=box,color=red];
		j849116547 -> j3939774225;
	j2574419930 [label="這是你向我敞開心扉嗎？感覺好不習慣！",shape=box,color=red];
		j2574419930 -> j121649753;
	j2805743173 [label="你大概是對的。",shape=box,color=red];
		j2805743173 -> j91130150;
	j2644789031 [label="難不倒我的。",shape=box,color=red];
		j2644789031 -> j91130150;
	j22162042 [label="也許吧。",shape=box,color=blue];
		j22162042 -> j1895387827;
	j3939774225 [label="嗒噠！",shape=box,color=blue];
		j3939774225 -> j1895387827;
	j121649753 [label="別得寸進尺。也許吧。呃，我也不知道。",shape=box,color=blue];
		j121649753 -> j1895387827;
	j91130150 [label="嘿呀嘿呀！",shape=box,color=blue];
		j91130150 -> j2153255664;
	j1895387827 [label="+20 Chemistry",color=orange];
		j1895387827 -> "Chat ends. Next chat will be KayaRank3Convo2.";
	j2153255664 [label="我想這是在用我自己的方式說，我信任你，所以讓你知道我有在收集吉你夢卡牌。這些卡牌算是只有魯蛇會玩的東西。",shape=box,color=blue];
		j2153255664 -> j3784629453;
	j3784629453 [label="或者至少我是這麼想的。但真正的魯蛇是其他所有人。",shape=box,color=blue];
		j3784629453 -> j2574419930;
		j3784629453 -> j849116547;
