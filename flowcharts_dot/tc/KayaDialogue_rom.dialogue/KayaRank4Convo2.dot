	j399004327 [label="卡婭？",shape=box,color=red];
		j399004327 -> j426217053;
	j426217053 [label="……",shape=box,color=blue];
		j426217053 -> j3291672822;
	j3291672822 [label="我們大家都不會評判妳。",shape=box,color=red];
		j3291672822 -> j4071163640;
	j4071163640 [label="發生在妳身上的事完全是對個人的侵犯。",shape=box,color=red];
		j4071163640 -> j1836157450;
	j1836157450 [label="有人違背了妳的信任並試圖羞辱妳。",shape=box,color=red];
		j1836157450 -> j3110947812;
	j3110947812 [label="妳曾經易受利用因而遭到背叛。",shape=box,color=red];
		j3110947812 -> j333997879;
	j333997879 [label="妳的世界瞬間天崩地裂。",shape=box,color=red];
		j333997879 -> j744319566;
	j744319566 [label="人們用異樣眼光看待妳。",shape=box,color=red];
		j744319566 -> j2101653490;
	j2101653490 [label="你明白我為什麼需要離開了嗎？",shape=box,color=blue];
		j2101653490 -> j3604734875;
	j3604734875 [label="好像發生在我身上的事從來沒有發生在任何人身上一樣。",shape=box,color=blue];
		j3604734875 -> j3507109713;
	j3507109713 [label="它製造了頭條新聞。人們嘲笑我，說我裝作自己是某事件的受害者，而事實上卻是我自己的選擇在網路上分享那張照片。",shape=box,color=blue];
		j3507109713 -> j3139928611;
	j3139928611 [label="你甚至無法在學生資料庫中查找我的名字，而不禁讓人聯想那個 －老師的風騷淫蕩婊兒，簡稱「騷蕩婊」。",shape=box,color=blue];
		j3139928611 -> j3209456498;
	j3209456498 [label="你們也會看到那張照片，而且所有人都不會再用同樣眼光看待我。一切個人自尊……永遠消失了。",shape=box,color=blue];
		j3209456498 -> j763536544;
	j763536544 [label="我必須離開，我必須繼續前行，去到一個我聰明到足以將這一切拋在身後的時間和地點。",shape=box,color=blue];
		j763536544 -> j2267506869;
		j763536544 -> j4187975435;
		j763536544 -> j1554150865;
	j2267506869 [label="我也不想多說什麼。我們都做過讓自己後悔的事。",shape=box,color=red];
		j2267506869 -> j4132395867;
	j4187975435 [label="只想說，我更加尊重妳了。",shape=box,color=red];
		j4187975435 -> j3613875781;
	j1554150865 [label="我們絕不會因為這件事而評判妳。",shape=box,color=red];
		j1554150865 -> j3051414897;
	j4132395867 [label="也許有一天你會告訴我你最悔不當初的事……",shape=box,color=blue];
		j4132395867 -> j768624179;
		j4132395867 -> j2234381467;
	j3613875781 [label="別他ㄇ的騙我了。",shape=box,color=blue];
		j3613875781 -> j673898806;
		j3613875781 -> j2457685615;
	j3051414897 [label="Check boolean KayaEternalismTest",color=orange];
		j3051414897 -> j1833935058 [label=true,color=green];
		j3051414897 -> j2072611246 [label=false,color=brown];
	j768624179 [label="也許我會。畢竟，我們還有很多時間。",shape=box,color=red];
		j768624179 -> j636956295;
	j2234381467 [label="這是個承諾。妳在這個世界上並不孤單。我們都只是選擇在他人身上賭一把而已。",shape=box,color=red];
		j2234381467 -> j3706483799;
	j673898806 [label="沒在騙妳。就相信它。[結束] ",shape=box,color=red];
		j673898806 -> j636956295;
	j2457685615 [label="聽我說。",shape=box,color=red];
		j2457685615 -> j3051414897;
	j1833935058 [label="妳顯然理解了永恆主義，也許比我理解得更好。",shape=box,color=red];
		j1833935058 -> j1561758251;
	j2072611246 [label="Check boolean KayaAttitude",color=orange];
		j2072611246 -> j2422433194 [label=true,color=green];
		j2072611246 -> j3945763908 [label=false,color=brown];
	j636956295 [label="+20 Chemistry",color=orange];
		j636956295 -> "Chat ends. Next chat will be KayaRank4Convo3.";
	j3706483799 [label="Boolean KayaPromiseRegret is now true.",color=orange];
		j3706483799 -> j636956295;
	j1561758251 [label="這就說明了一些事。",shape=box,color=red];
		j1561758251 -> j2072611246;
	j2422433194 [label="所有那些妳給我擺的態度至少是有道理的，妳既害怕又憤怒。在妳眼中，我只是網路上的另一名陌生人。",shape=box,color=red];
		j2422433194 -> j3945763908;
	j3945763908 [label="我絕不會勸阻妳離開 1999 年。",shape=box,color=red];
		j3945763908 -> j2537534591;
	"Chat ends. Next chat will be KayaRank4Convo3." [color=orange];
	j2537534591 [label="我相信一定有辦法。而對妳來說，去別的地方，任何其他的地方，都更有意義。",shape=box,color=red];
		j2537534591 -> j4282882520;
	j4282882520 [label="這裡永遠為妳提供幫助。雖然我可能會是更好的傾聽者而非時間旅行者。就別害羞了。",shape=box,color=red];
		j4282882520 -> j636956295;
}