	581 [label="也許我會。畢竟，我們還有很多時間。",shape=box,color=red];
		581 -> 587;
	582 [label="這是個承諾。妳在這個世界上並不孤單。我們都只是選擇在他人身上賭一把而已。",shape=box,color=red];
		582 -> 588;
