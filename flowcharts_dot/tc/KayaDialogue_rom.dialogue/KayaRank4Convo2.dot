	570 [label="好像發生在我身上的事從來沒有發生在任何人身上一樣。",shape=box,color=blue];
		570 -> 571;
	571 [label="它製造了頭條新聞。人們嘲笑我，說我裝作自己是某事件的受害者，而事實上卻是我自己的選擇在網路上分享那張照片。",shape=box,color=blue];
		571 -> 572;
	572 [label="你甚至無法在學生資料庫中查找我的名字，而不禁讓人聯想那個 －老師的風騷淫蕩婊兒，簡稱「騷蕩婊」。",shape=box,color=blue];
		572 -> 573;
	573 [label="你們也會看到那張照片，而且所有人都不會再用同樣眼光看待我。一切個人自尊……永遠消失了。",shape=box,color=blue];
		573 -> 574;
	574 [label="我必須離開，我必須繼續前行，去到一個我聰明到足以將這一切拋在身後的時間和地點。",shape=box,color=blue];
		574 -> 575;
		574 -> 576;
		574 -> 577;
	575 [label="我也不想多說什麼。我們都做過讓自己後悔的事。",shape=box,color=red];
		575 -> 578;
	576 [label="只想說，我更加尊重妳了。",shape=box,color=red];
