	66 [label="我想知道答案。",shape=box,color=blue];
		66 -> 71;
	67 [label="+20 Chemistry",color=orange];
		67 -> 72;
	68 [label="Chat ends. Next chat will be KayaRank1Convo3.",color=orange];
	69 [label="你確定你的未來沒有網際網路嗎？非常確定？",shape=box,color=blue];
		69 -> 73;
	70 [label="Chat ends. Next chat will be KayaRank1Convo3.",color=orange];
	71 [label="+20 Chemistry",color=orange];
		71 -> 74;
	72 [label="Chat ends. Next chat will be KayaRank1Convo3.",color=orange];
	73 [label="這樣好了，忘了我說的任何事。我到了那裡就會知道了。",shape=box,color=blue];
		73 -> 75;
	74 [label="這個糞坑裡的事情日新月異。尤其是在網際網路地下聊天室裡談論到的這位博士的事。",shape=box,color=blue];
		74 -> 76;
	75 [label="+20 Chemistry",color=orange];
		75 -> 77;
	76 [label="於是我找到了他，這讓他大吃一驚。哦，我的天啊。博士爺爺很不高興，但我還是直切重點了。",shape=box,color=blue];
		76 -> 78;
	77 [label="Chat ends. Next chat will be KayaRank1Convo3.",color=orange];
	78 [label="我知道他來自未來。他知道我知道。他給了我一個選擇，然後不管怎樣。現在我找到了你。",shape=box,color=blue];
		78 -> 79;
	79 [label="而以某種程度上來說，我也給你一個選擇。選擇幫我或悔不當初。",shape=box,color=blue];
		79 -> 80;
		79 -> 81;
	80 [label="很會講。我不是妳的敵人，妳知道吧。",shape=box,color=red];
		80 -> 82;
	81 [label="妳都這樣威脅妳所有新朋友的嗎？",shape=box,color=red];
