digraph {
	38 [label="KayaRank1Convo2 begins.",color=orange];
		38 -> 39;
	39 [label="嗨。為什麼源拓氏的跨時間設備似乎涉及與開映線上網絡之間有活躍的線接？",shape=box,color=blue];
		39 -> 40;
	40 [label="又或者，我想，嗨。時間旅行需要用到網際網路嗎？",shape=box,color=blue];
		40 -> 41;
		40 -> 42;
	41 [label="好的，直接切入正題。不，「網際網路」並沒有持續到我的時代，所以不可能需要用到它。又或許需要。",shape=box,color=red];
		41 -> 43;
	42 [label="妳也好，卡婭。",shape=box,color=red];
		42 -> 44;
	43 [label="所以你不需要網際網路連線就能來去自如嗎？源拓氏需要嗎？",shape=box,color=blue];
		43 -> 45;
	44 [label="呃。網際網路嗎？考慮到網絡的特性，我能理解為什麼……",shape=box,color=blue];
		44 -> 45;
	45 [label="我真的不確定。我只知道有個序列，源拓氏有個計劃，這個計劃涉及到我，在這裡，現在。我需要來到這裡，遇見你們所有人。",shape=box,color=red];
		45 -> 46;
	46 [label="好的，但為什麼在他的一些筆記中似乎有條必要的網際網路連線？",shape=box,color=blue];
		46 -> 47;
		46 -> 48;
		46 -> 49;
	47 [label="我下次見到他時再問他。",shape=box,color=red];
		47 -> 50;
	48 [label="妳有他的筆記？",shape=box,color=red];
		48 -> 51;
	49 [label="這有問題嗎？像妳這樣的孩子不是很喜歡網際網路嗎？",shape=box,color=red];
		49 -> 52;
	50 [label="？",shape=box,color=blue];
		50 -> 53;
		50 -> 54;
	51 [label="非字面意思。只是當我找到他時所看到的。我認為他沒想到會被找到。",shape=box,color=blue];
		51 -> 55;
	52 [label="Check boolean KayaSetKid",color=orange];
		52 -> 56 [label=true,color=green];
		52 -> 57 [label=false,color=brown];
	53 [label="抱歉，只是開個玩笑……未來也是有玩笑的。",shape=box,color=red];
		53 -> 58;
	54 [label="開個玩笑。放輕鬆點。",shape=box,color=red];
		54 -> 59;
	55 [label="Update boolean KayaSetFound",color=orange];
		55 -> 60;
		55 -> 61;
	56 [label="一直說我是孩子會讓你比較有優越感嗎？你難道不明白嗎？",shape=box,color=blue];
		56 -> 62;
	57 [label="你對我一無所知。",shape=box,color=blue];
		57 -> 63;
	58 [label="好吧。",shape=box,color=blue];
		58 -> 64;
	59 [label="不了。",shape=box,color=blue];
		59 -> 65;
	60 [label="妳？當沒人能找到源拓氏時，妳卻找到了他？",shape=box,color=red];
		60 -> 66;
	61 [label="妳找到他了？怎麼做到的？",shape=box,color=red];
		61 -> 66;
	62 [label="我不得不趕快長大。這該死的網際網路上的人們確保了這點。",shape=box,color=blue];
		62 -> 67;
	63 [label="+20 Chemistry",color=orange];
