		j3919099667 -> j3294271043 [label=false,color=brown];
	j3294271043 [label="我可能永遠也離不開這裡。我已經接受了這個事實。",shape=box,color=blue];
		j3294271043 -> j2142998171;
	j3189381557 [label="首先，你現在可以叫我卡婭了。",shape=box,color=blue];
		j3189381557 -> j3919762676;
	j2142998171 [label="我正在學會接受自己，我不應該讓遺憾定義我。",shape=box,color=blue];
		j2142998171 -> j579056294;
	j3919762676 [label="因為如果有人讀到這則訊息的話，是卡婭・維拉斯科解決了這個問題。",shape=box,color=blue];
		j3919762676 -> j4208577370;
	j579056294 [label="而且，就算我真的出得去，這等同於害人。對任何跟著過來的人來說都太危險了。",shape=box,color=blue];
		j579056294 -> j4058994116;
	j4208577370 [label="如果你搜索我的名字，你會發現兩件事：我解決了這件事，我已經離開了 1999 年。",shape=box,color=blue];
		j4208577370 -> j163546218;
	j4058994116 [label="所以，我們就在這裡做我們能做的事吧！在這個 1999 年。",shape=box,color=blue];
		j4058994116 -> j1285440519;
		j4058994116 -> j4253163918;
	j163546218 [label="還有無論你找到我的什麼照片，那女孩已經把你們都拋在身後了。掰！",shape=box,color=blue];
		j163546218 -> j837589029;
	j1285440519 [label="1999 年很幸運有卡婭・維拉斯科",shape=box,color=red];
		j1285440519 -> j1491866842;
	j4253163918 [label="任何事情都有可能發生，我很高興我們能夠一起度過這一切。",shape=box,color=red];
		j4253163918 -> j1491866842;
	j837589029 [label="卡婭？不可能。證明給我看。",shape=box,color=red];
		j837589029 -> j1121575986;
	j1121575986 [label="沒問題。到 Larunda 找我。我會在那裡等著，仰望著星空。",shape=box,color=blue];
		j1121575986 -> j1699379038;
	j1699379038 [label="Boolean KayaLarunda is now true.",color=orange];
