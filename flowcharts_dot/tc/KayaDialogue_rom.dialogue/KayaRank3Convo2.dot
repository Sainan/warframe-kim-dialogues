digraph {
	460 [label="KayaRank3Convo2 begins.",color=orange];
		460 -> 461;
	461 [label="妳似乎對「時間旅行」很好奇。甚至是到了癡迷的地步。",shape=box,color=red];
		461 -> 462;
	462 [label="正在忙一些事。差不多快好了。",shape=box,color=blue];
		462 -> 463;
	463 [label="一旦妳弄明白時間旅行，還有個更大的問題。永恆主義。",shape=box,color=red];
		463 -> 464;
	464 [label="嗯……什麼？",shape=box,color=blue];
		464 -> 465;
		464 -> 466;
	465 [label="我們來看一下你是不是夠聰明能夠弄明白這點。多虧永恆主義，這段對話有種版本是不會到這邊就結束的。[結束]",shape=box,color=red];
		465 -> 467;
	466 [label="希望妳不忙，因為這是我來這裡的真正原因。",shape=box,color=red];
		466 -> 468;
	467 [label="Update boolean KayaEternalismTest",color=orange];
		467 -> 469;
	468 [label="我不忙，請解釋。這可能對時空操縱理論的最後加工修飾息息相關。",shape=box,color=blue];
		468 -> 470;
	469 [label="+20 Chemistry",color=orange];
		469 -> 471;
	470 [label="這一切之所以發生並不是因為一位科學家想出了一套公式。",shape=box,color=red];
		470 -> 472;
	471 [label="Chat ends. Next chat will be KayaRank3Convo3.",color=orange];
	472 [label="好吧，我想事情是那樣開始的。",shape=box,color=red];
		472 -> 473;
	473 [label="但現在的這一切？這已經超出了那些範圍。這是因為阿爾布雷希特去了某個地方，喚醒了某個東西，而跟隨他回來的就是它。虛空。",shape=box,color=red];
		473 -> 474;
		473 -> 475;
	474 [label="虛空是活的但同時也不是。它存在但同時也不存在。它是個悖論，同時也是發生在我們每個人身上的一切原因和理由。",shape=box,color=red];
		474 -> 476;
	475 [label="沒有「元素周期表」或公式可以解釋它是什麼。",shape=box,color=red];
		475 -> 477;
	476 [label="你好，世界。",shape=box,color=blue];
		476 -> 478;
		476 -> 479;
	477 [label="科學可以解釋。它主宰著一切。",shape=box,color=blue];
		477 -> 480;
	478 [label="「再見阿爾布雷希特」",shape=box,color=red];
		478 -> 481;
	479 [label="什麼？",shape=box,color=red];
		479 -> 482;
	480 [label="Check boolean KayaVoidTest",color=orange];
		480 -> 484 [label=true,color=green];
		480 -> 483 [label=false,color=brown];
	481 [label="+5 Chemistry",color=orange];
		481 -> 485;
	482 [label="這是在網際網路上發布的第一篇內容。第一則訊息。由網際網路的創造者發布，以表明網路「有效」。",shape=box,color=blue];
		482 -> 486;
	484 [label="我叫妳要小心虛空。這就是原因。",shape=box,color=red];
		484 -> 488;
	483 [label="要是科學無法解釋呢？",shape=box,color=red];
		483 -> 487;
	485 [label="哈！哦我的天啊，希望是這樣。但你知道「你好，世界」嗎？",shape=box,color=blue];
		485 -> 482;
	486 [label="從那時起，一切都失控了。人們都興奮不已。科學、金融、技術、娛樂。",shape=box,color=blue];
		486 -> 489;
	488 [label="有些事物無法被治理。",shape=box,color=red];
		488 -> 491;
	487 [label="要是妳認知中的一切是鐵則……",shape=box,color=red];
		487 -> 490;
	489 [label="經過數十億種選擇和因果組合，導致我那天上了網然後……",shape=box,color=blue];
		489 -> 492;
	491 [label="有些事情無法被解釋。",shape=box,color=red];
		491 -> 493;
	490 [label="這一切會發生只是因為外面的某些東西想要它發生。",shape=box,color=red];
		490 -> 493;
	492 [label="然後那次就是 Nova 的終結，或者更確切地說是卡婭的終結。她的未來，她的職涯，她的朋友，她的一切。因為一個錯誤。",shape=box,color=blue];
		492 -> 494;
	493 [label="所以你是說，我的實驗、試驗、研究和假說中缺少的部分是「魔法」？",shape=box,color=blue];
		493 -> 495;
		493 -> 496;
	494 [label="所以我想與其信任其他人我更信任虛空。",shape=box,color=blue];
		494 -> 497;
		494 -> 498;
		494 -> 499;
	495 [label="不是魔法。就只是……虛空。虛空。來自別處的能量。",shape=box,color=red];
		495 -> 500;
	496 [label="妳有看過我能做什麼嗎？",shape=box,color=red];
		496 -> 501;
	497 [label="別說了。[結束]",shape=box,color=red];
		497 -> 502;
	498 [label="前途好暗淡，Nova。",shape=box,color=red];
		498 -> 503;
	499 [label="我也信任它。",shape=box,color=red];
		499 -> 503;
	500 [label="我可以利用這點。",shape=box,color=blue];
		500 -> 504;
		500 -> 505;
	501 [label="見識過。觀察過。記錄過。研究過。重新研究過。嗯。這一切都可以被解釋，都基於某些東西。也許是「魔法」。",shape=box,color=blue];
		501 -> 506;
	502 [label="+20 Chemistry",color=orange];
		502 -> 507;
	503 [label="我想也許你還沒完全進入狀況。",shape=box,color=blue];
