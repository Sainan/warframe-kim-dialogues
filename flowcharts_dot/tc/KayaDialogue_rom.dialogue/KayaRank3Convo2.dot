digraph {
	"KayaRank3Convo2 begins." [color=orange];
		"KayaRank3Convo2 begins." -> j1807968766;
	j1807968766 [label="妳似乎對「時間旅行」很好奇。甚至是到了癡迷的地步。",shape=box,color=red];
		j1807968766 -> j449439643;
	j449439643 [label="正在忙一些事。差不多快好了。",shape=box,color=blue];
		j449439643 -> j3645378014;
	j3645378014 [label="一旦妳弄明白時間旅行，還有個更大的問題。永恆主義。",shape=box,color=red];
		j3645378014 -> j1147471045;
	j1147471045 [label="嗯……什麼？",shape=box,color=blue];
		j1147471045 -> j789853216;
		j1147471045 -> j3717765631;
	j789853216 [label="我們來看一下你是不是夠聰明能夠弄明白這點。多虧永恆主義，這段對話有種版本是不會到這邊就結束的。[結束]",shape=box,color=red];
		j789853216 -> j3655577789;
	j3717765631 [label="希望妳不忙，因為這是我來這裡的真正原因。",shape=box,color=red];
		j3717765631 -> j3767311101;
	j3655577789 [label="Boolean KayaEternalismTest is now true.",color=orange];
		j3655577789 -> j2156753723;
	j3767311101 [label="我不忙，請解釋。這可能對時空操縱理論的最後加工修飾息息相關。",shape=box,color=blue];
		j3767311101 -> j581313597;
	j2156753723 [label="+20 Chemistry",color=orange];
		j2156753723 -> "Chat ends. Next chat will be KayaRank3Convo3.";
	j581313597 [label="這一切之所以發生並不是因為一位科學家想出了一套公式。",shape=box,color=red];
		j581313597 -> j2594379938;
	"Chat ends. Next chat will be KayaRank3Convo3." [color=orange];
	j2594379938 [label="好吧，我想事情是那樣開始的。",shape=box,color=red];
		j2594379938 -> j2920987711;
	j2920987711 [label="但現在的這一切？這已經超出了那些範圍。這是因為阿爾布雷希特去了某個地方，喚醒了某個東西，而跟隨他回來的就是它。虛空。",shape=box,color=red];
		j2920987711 -> j1005275397;
		j2920987711 -> j993826842;
	j1005275397 [label="虛空是活的但同時也不是。它存在但同時也不存在。它是個悖論，同時也是發生在我們每個人身上的一切原因和理由。",shape=box,color=red];
		j1005275397 -> j626738540;
	j993826842 [label="沒有「元素周期表」或公式可以解釋它是什麼。",shape=box,color=red];
		j993826842 -> j469872929;
	j626738540 [label="你好，世界。",shape=box,color=blue];
		j626738540 -> j1836669052;
		j626738540 -> j2040841007;
	j469872929 [label="科學可以解釋。它主宰著一切。",shape=box,color=blue];
		j469872929 -> j3668359530;
	j1836669052 [label="「再見阿爾布雷希特」",shape=box,color=red];
		j1836669052 -> j3715333131;
	j2040841007 [label="什麼？",shape=box,color=red];
		j2040841007 -> j325324836;
	j3668359530 [label="Check boolean KayaVoidTest",color=orange];
		j3668359530 -> j259468803 [label=true,color=green];
		j3668359530 -> j1180172117 [label=false,color=brown];
	j3715333131 [label="+5 Chemistry",color=orange];
		j3715333131 -> j1134127855;
	j325324836 [label="這是在網際網路上發布的第一篇內容。第一則訊息。由網際網路的創造者發布，以表明網路「有效」。",shape=box,color=blue];
		j325324836 -> j3604901146;
	j259468803 [label="我叫妳要小心虛空。這就是原因。",shape=box,color=red];
		j259468803 -> j2136720260;
	j1180172117 [label="要是科學無法解釋呢？",shape=box,color=red];
		j1180172117 -> j3546961134;
	j1134127855 [label="哈！哦我的天啊，希望是這樣。但你知道「你好，世界」嗎？",shape=box,color=blue];
		j1134127855 -> j325324836;
	j3604901146 [label="從那時起，一切都失控了。人們都興奮不已。科學、金融、技術、娛樂。",shape=box,color=blue];
		j3604901146 -> j1435531812;
	j2136720260 [label="有些事物無法被治理。",shape=box,color=red];
		j2136720260 -> j507256672;
	j3546961134 [label="要是妳認知中的一切是鐵則……",shape=box,color=red];
		j3546961134 -> j3622385568;
	j1435531812 [label="經過數十億種選擇和因果組合，導致我那天上了網然後……",shape=box,color=blue];
		j1435531812 -> j189113788;
	j507256672 [label="有些事情無法被解釋。",shape=box,color=red];
		j507256672 -> j2989816256;
	j3622385568 [label="這一切會發生只是因為外面的某些東西想要它發生。",shape=box,color=red];
		j3622385568 -> j2989816256;
	j189113788 [label="然後那次就是 Nova 的終結，或者更確切地說是卡婭的終結。她的未來，她的職涯，她的朋友，她的一切。因為一個錯誤。",shape=box,color=blue];
		j189113788 -> j2278724431;
	j2989816256 [label="所以你是說，我的實驗、試驗、研究和假說中缺少的部分是「魔法」？",shape=box,color=blue];
		j2989816256 -> j3396586542;
		j2989816256 -> j945343178;
	j2278724431 [label="所以我想與其信任其他人我更信任虛空。",shape=box,color=blue];
		j2278724431 -> j1767717614;
		j2278724431 -> j2910390015;
		j2278724431 -> j3199857124;
	j3396586542 [label="不是魔法。就只是……虛空。虛空。來自別處的能量。",shape=box,color=red];
		j3396586542 -> j903963524;
	j945343178 [label="妳有看過我能做什麼嗎？",shape=box,color=red];
		j945343178 -> j3456390008;
	j1767717614 [label="別說了。[結束]",shape=box,color=red];
		j1767717614 -> j2156753723;
	j2910390015 [label="前途好暗淡，Nova。",shape=box,color=red];
		j2910390015 -> j3207402988;
	j3199857124 [label="我也信任它。",shape=box,color=red];
		j3199857124 -> j3207402988;
	j903963524 [label="我可以利用這點。",shape=box,color=blue];
		j903963524 -> j4138762009;
		j903963524 -> j1361270249;
	j3456390008 [label="見識過。觀察過。記錄過。研究過。重新研究過。嗯。這一切都可以被解釋，都基於某些東西。也許是「魔法」。",shape=box,color=blue];
		j3456390008 -> j903963524;
	j3207402988 [label="我想也許你還沒完全進入狀況。",shape=box,color=blue];
		j3207402988 -> j1144371698;
	j4138762009 [label="如果妳衝動行事，可能會讓妳失去一切。",shape=box,color=red];
		j4138762009 -> j3207402988;
	j1361270249 [label="妳可以「利用這點」？",shape=box,color=red];
		j1361270249 -> j3207402988;
	j1144371698 [label="但我要逃脫 1999 年了。",shape=box,color=blue];
		j1144371698 -> j1294300566;
	j1294300566 [label="我根本不在乎嘗試到達那裡的過程中會發生什麼事。",shape=box,color=blue];
		j1294300566 -> j343280097;
	j343280097 [label="這是佔據我腦海的唯一一件事。",shape=box,color=blue];
		j343280097 -> j862967066;
	j862967066 [label="而對我來說，這是件好事。",shape=box,color=blue];
		j862967066 -> j2156753723;
}