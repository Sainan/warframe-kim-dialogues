	"KayaRank4Convo4 begins." [color=orange];
		"KayaRank4Convo4 begins." -> j1386317507;
	j1386317507 [label="我想我有些東西可以幫到妳。",shape=box,color=red];
		j1386317507 -> j1913527848;
	j1913527848 [label="我知道有個地方，我猜其實我就來自那個地方。渡域。",shape=box,color=red];
		j1913527848 -> j3751123889;
	j3751123889 [label="即使我不在，它依然存在。在虛空中。",shape=box,color=red];
		j3751123889 -> j3643513828;
	j3643513828 [label="還有那另一名孩子所在的星系，那是我曾經去過的地方。",shape=box,color=red];
		j3643513828 -> j1458201970;
	j1458201970 [label="嗯哼，你的所有足跡確實是我「安全步驟」的關鍵。",shape=box,color=blue];
		j1458201970 -> j3801316177;
	j3801316177 [label="Boolean KayaFutureWin1 is now true.",color=orange];
		j3801316177 -> j727022826;
	j727022826 [label="當涉及到粒子被吸引到它們下一種形態時，這就像個巨大發光的虛空安全出口標誌。",shape=box,color=blue];
		j727022826 -> j2538779766;
	j2538779766 [label="抱歉，呃對了，但「渡域」是什麼？是一種物態嗎？",shape=box,color=blue];
		j2538779766 -> j1981951166;
		j2538779766 -> j905892799;
	j1981951166 [label="那是我在虛空之中創造的地方。",shape=box,color=red];
		j1981951166 -> j1941237553;
	j905892799 [label="從多方面來說，它是我真正的家。我在那裡……長大。",shape=box,color=red];
		j905892799 -> j676371156;
	j1941237553 [label="充滿了具體化的概念與情感。",shape=box,color=red];
		j1941237553 -> j2412000229;
	j676371156 [label="它在虛空之中。",shape=box,color=red];
		j676371156 -> j939032032;
	j2412000229 [label="它基本上是一本活過來的「教科書」。",shape=box,color=red];
		j2412000229 -> j933009411;
	j939032032 [label="不過，這些日子來我們這裡的訪客並太多。",shape=box,color=red];
		j939032032 -> j1499184515;
	j933009411 [label="哈哈！我的天啊。好的，我知道了，還有它固定位於虛空中嗎？",shape=box,color=blue];
		j933009411 -> j2842763527;
	j1499184515 [label="我出現的話，請鋪好紅地毯。",shape=box,color=blue];
		j1499184515 -> j3486140446;
		j1499184515 -> j3502152729;
		j1499184515 -> j188485551;
	j2842763527 [label="是的，雖然它與扎日曼號緊緊相連。",shape=box,color=red];
		j2842763527 -> j2839991083;
	j3486140446 [label="我不常回去那裡……",shape=box,color=red];
		j3486140446 -> j4158976589;
	j3502152729 [label="妳真的認為妳會去那裡嗎？",shape=box,color=red];
		j3502152729 -> j3662310327;
	j188485551 [label="遵命，太空旅者！[結束] ",shape=box,color=red];
		j188485551 -> j392027042;
	j2839991083 [label="像一個巨大的金屬月球。",shape=box,color=red];
		j2839991083 -> j4145844605;
	j4158976589 [label="它還有在那裡嗎？你怎麼能確定？",shape=box,color=blue];
		j4158976589 -> j707540839;
	j3662310327 [label="計劃之中不排除一切潛在結果。",shape=box,color=blue];
		j3662310327 -> j1534730315;
		j3662310327 -> j1973960489;
	j392027042 [label="+20 Chemistry",color=orange];
		j392027042 -> "Chat ends. Next chat will be KayaRank5Convo1.";
	j4145844605 [label="那裡有太陽嗎？",shape=box,color=blue];
		j4145844605 -> j2890866472;
		j4145844605 -> j277611593;
	j707540839 [label="我是這麼認為。如果我一離開它就消失的話，我會知道的。",shape=box,color=red];
		j707540839 -> j3907848239;
	j1534730315 [label="如果那結果是妳迷失在某處、某時怎麼辦？",shape=box,color=red];
		j1534730315 -> j1358400822;
	j1973960489 [label="我不介意談論這一切，但妳真的認為妳能找到逃離 1999 年的方法嗎？",shape=box,color=red];
		j1973960489 -> j891654183;
	"Chat ends. Next chat will be KayaRank5Convo1." [color=orange];
	j2890866472 [label="仔細想的話，大概有一個，也許？",shape=box,color=red];
		j2890866472 -> j2436716047;
	j277611593 [label="我只是在流露詩意，那裡沒有太陽。",shape=box,color=red];
		j277611593 -> j3128266014;
	j3907848239 [label="你會嗎？有一派科學可能認為觀察渡域就是它存在的關鍵。",shape=box,color=blue];
		j3907848239 -> j2067463082;
		j3907848239 -> j3545851455;
	j1358400822 [label="我也不知道，如果你不再見到我，就在我告別式上說些好的祭文，摺些漂亮的東西。",shape=box,color=blue];
		j1358400822 -> j2848745659;
	j891654183 [label="會的，如果你能幫忙，就跟我說一聲！",shape=box,color=blue];
		j891654183 -> j392027042;
	j2436716047 [label="哈哈。",shape=box,color=blue];
		j2436716047 -> j42878510;
	j3128266014 [label="有任何天體嗎？",shape=box,color=blue];
		j3128266014 -> j2318063428;
		j3128266014 -> j3424749059;
	j2067463082 [label="我不確定科學能解釋這件事。「它」就是這一切的起因。",shape=box,color=red];
		j2067463082 -> j48891688;
	j3545851455 [label="那聽起來更像是哲學。",shape=box,color=red];
		j3545851455 -> j1687717946;
	j2848745659 [label="哦還有告訴亞瑟我覺得他很可愛，但只有在我真的離世的情況下才說。",shape=box,color=blue];
		j2848745659 -> j1487584150;
	j42878510 [label="我盡力。",shape=box,color=blue];
		j42878510 -> j392027042;
	j2318063428 [label="據我所知沒有。",shape=box,color=red];
		j2318063428 -> j279932384;
	j3424749059 [label="沒有。",shape=box,color=red];
		j3424749059 -> j279932384;
	j48891688 [label="你認為「它」可以被解釋嗎？",shape=box,color=blue];
		j48891688 -> j774087381;
		j48891688 -> j3077120353;
	j1687717946 [label="不是我拿最高分的課目，別提醒我了，唉。",shape=box,color=blue];
		j1687717946 -> j802649921;
	j1487584150 [label="Check boolean ArthurDating",color=orange];
		j1487584150 -> j1203305090 [label=true,color=green];
		j1487584150 -> j1908308021 [label=false,color=brown];
		j1487584150 -> j565302947 [label=false,color=brown];
	j279932384 [label="已知宇宙中的所有事物都是由它們與天體的關係來定義的。這虛空真的好奇怪。",shape=box,color=blue];
		j279932384 -> j2239695039;
		j279932384 -> j2341137153;
	j774087381 [label="我不知道我想不想去解釋它。",shape=box,color=red];
		j774087381 -> j3816071209;
	j3077120353 [label="如果「它」可以被解釋的話，我們就可以解決很多問題了。",shape=box,color=red];
		j3077120353 -> j3816071209;
	j802649921 [label="妳覺得哲學很難嗎？",shape=box,color=red];
		j802649921 -> j4041765204;
	j1203305090 [label="不管情況怎麼樣……如果事情到了那一步，我會這麼做。 ",shape=box,color=red];
		j1203305090 -> j1411209647;
	j1908308021 [label="知道了。 ",shape=box,color=red];
		j1908308021 -> j1411209647;
	j565302947 [label="我希望事情不會發展到那一步。",shape=box,color=red];
		j565302947 -> j1659878439;
	j2239695039 [label="都說是「虛空」了。有東西之前什麼都沒有。",shape=box,color=red];
		j2239695039 -> j2971129508;
	j2341137153 [label="當我們找到阿爾布雷希特時，我們必須把他帶回那裡或者會有其它打算。我現在還沒有真正的計劃。",shape=box,color=red];
		j2341137153 -> j2971129508;
	j3816071209 [label="嗯，為了你，我想說回答你的科學謎題應該會很有趣，我希望你能得到答案。",shape=box,color=blue];
		j3816071209 -> j2491660630;
		j3816071209 -> j3495525763;
	j4041765204 [label="我猜？也許不到「掙扎」的地步。誰還會在乎「原因」和「對象」，我們只管做很酷的東西就好。",shape=box,color=blue];
		j4041765204 -> j4040806846;
		j4041765204 -> j1180066063;
	j1411209647 [label="謝謝你！",shape=box,color=blue];
		j1411209647 -> j392027042;
	j1659878439 [label="噗。",shape=box,color=blue];
		j1659878439 -> j1411209647;
	j2971129508 [label="嗯，這似乎相關，但不是我的研究重點。如果我能再見到你，再見！",shape=box,color=blue];
		j2971129508 -> j392027042;
	j2491660630 [label="Nova，我不確定是否會喜歡那些答案。",shape=box,color=red];
		j2491660630 -> j392027042;
	j3495525763 [label="我也是，總有一天。",shape=box,color=red];
		j3495525763 -> j392027042;
	j4040806846 [label="我猜，但妳在跟其他人共享這個星球，不管我們喜不喜歡，我們的選擇都會對其他人產生影響。",shape=box,color=red];
		j4040806846 -> j1088945895;
	j1180066063 [label="也許這就是源拓氏在第一次進入虛空之前的想法，現在看看我們。",shape=box,color=red];
		j1180066063 -> j2866946554;
	j1088945895 [label="噗。",shape=box,color=blue];
		j1088945895 -> j218198061;
	j2866946554 [label="噗。",shape=box,color=blue];
		j2866946554 -> j392027042;
	j218198061 [label="嗯好吧，你說得對。",shape=box,color=blue];
		j218198061 -> j392027042;
