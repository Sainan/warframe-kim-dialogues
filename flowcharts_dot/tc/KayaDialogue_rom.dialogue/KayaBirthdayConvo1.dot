		j4161655766 -> j3377962037;
	j4210075196 [label="生日快樂，卡婭。變老的感覺怎麼樣？",shape=box,color=red];
		j4210075196 -> j2095195876;
	j3377962037 [label="+20 Chemistry",color=orange];
		j3377962037 -> j1431250770;
	j2095195876 [label="但我沒有變老，不是嗎？我們都沒有。我們只是在這個旋轉木馬上轉啊轉，像著火的漂亮小馬尖叫著",shape=box,color=blue];
		j2095195876 -> "Chat ends.";
	j1431250770 [label="哇，你記得呵？我的意思是你一旦過了八歲，生日就不是什麼大不了的事了，但你這樣算是很有心了，謝啦",shape=box,color=blue];
		j1431250770 -> "Chat ends.";
