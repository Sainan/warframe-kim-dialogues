digraph {
	"KayaRank5Convo1 begins." [color=orange];
		"KayaRank5Convo1 begins." -> j618716823;
	j618716823 [label="我一直看到這些紫色的東西，但它們第二天就憑空消失了。",shape=box,color=blue];
		j618716823 -> j275643153;
	j275643153 [label="而我在想說這跟它們的衰變特性有關。",shape=box,color=blue];
		j275643153 -> j2641226434;
	j2641226434 [label="因為那些物質並不只是重組成新同位素的衰變狀態。",shape=box,color=blue];
		j2641226434 -> j3374278693;
	j3374278693 [label="實際上它在這裡憑空消失了。",shape=box,color=blue];
		j3374278693 -> j2982177276;
		j3374278693 -> j3756634047;
	j2982177276 [label="妳是指永凍晶礦嗎？",shape=box,color=red];
		j2982177276 -> j175946287;
	j3756634047 [label="妳是指氬結晶嗎？",shape=box,color=red];
		j3756634047 -> j976527221;
	j175946287 [label="嗯不，不是那個。",shape=box,color=blue];
		j175946287 -> j3756634047;
		j175946287 -> j3930557883;
	j976527221 [label="那個肯定就是了！",shape=box,color=blue];
		j976527221 -> j3934916184;
	j3930557883 [label="妳是指 Orokin 電池嗎？",shape=box,color=red];
		j3930557883 -> j1812033222;
	j3934916184 [label="在你來的那裡，你們有辦法保存它們嗎？",shape=box,color=blue];
		j3934916184 -> j2805283621;
		j3934916184 -> j1339480598;
	j1812033222 [label="嗯不，肯定也不是那個。",shape=box,color=blue];
		j1812033222 -> j1520247798;
		j1812033222 -> j3756634047;
	j2805283621 [label="妳一旦把它們帶出虛空，它們就會消失了。",shape=box,color=red];
		j2805283621 -> j2395714826;
	j1339480598 [label="從來沒有，我一直以為它們只是衰變了。",shape=box,color=red];
		j1339480598 -> j2395714826;
	j1520247798 [label="妳是指紅化結晶嗎？",shape=box,color=red];
		j1520247798 -> j2108209964;
	j2395714826 [label="嗯那就對了， 在虛空中它們是惰性的。",shape=box,color=blue];
		j2395714826 -> j2767612261;
	j2108209964 [label="我不覺得是，如果我們弄不明白，我可能永遠無法解開這個問題了。",shape=box,color=blue];
		j2108209964 -> j3987723088;
		j2108209964 -> j3756634047;
	j2767612261 [label="然後它們會離開虛空，也總會回到虛空。它們不會衰變成新物質。",shape=box,color=blue];
		j2767612261 -> j2746296399;
	j3987723088 [label="妳是指奈米胞子嗎？",shape=box,color=red];
		j3987723088 -> j1539115011;
	j2746296399 [label="它們相移回虛空。虛空無處不在，在召喚它們回去。",shape=box,color=blue];
		j2746296399 -> j221969447;
	j1539115011 [label="呃，噢不，我最後的樣本不見了。我……唉。我得走了。",shape=box,color=blue];
		j1539115011 -> j3830316046;
	j221969447 [label="Boolean KayaFutureWin2 is now true.",color=orange];
		j221969447 -> j493005347;
		j221969447 -> j2272122746;
	j3830316046 [label="我想我做不到。",shape=box,color=blue];
		j3830316046 -> j4123196853;
	j493005347 [label="這能讓妳逃離 1999 年嗎？打算藏匿在虛空之中？我是不推薦妳這麼做。",shape=box,color=red];
		j493005347 -> j4198974868;
	j2272122746 [label="這對妳的目標重要嗎？",shape=box,color=red];
		j2272122746 -> j2328323313;
	j4123196853 [label="+20 Chemistry",color=orange];
		j4123196853 -> "Chat ends. Next chat will be KayaRank5Convo2.";
	j4198974868 [label="這更多是關於物質的狀態還有虛空並不是「線性」的理論，這樣我就可以把它當作彈跳床來有效地跟著你回去。",shape=box,color=blue];
		j4198974868 -> j712793202;
	j2328323313 [label="非常非常非常重要！這意味著物質在虛空和這裡之間存在連結。原子，物質，它們在兩個區域裡都是一致的。",shape=box,color=blue];
		j2328323313 -> j3081557486;
	"Chat ends. Next chat will be KayaRank5Convo2." [color=orange];
	j712793202 [label="等一下，跟著我？",shape=box,color=red];
		j712793202 -> j661820827;
	j3081557486 [label="在我們的理解中，虛空並不是「線性」的，這樣我就可以把它當作彈跳床來有效地跟著你回去。",shape=box,color=blue];
		j3081557486 -> j712793202;
	j661820827 [label="是的，無論我進行多少測試或計算多少方程式，可以說我都缺少一座「燈塔」。彈跳床跳躍需要有個落點，而且如果你曾經回去過一次，這樣應該足以進行校準了。",shape=box,color=blue];
		j661820827 -> j522781401;
		j661820827 -> j2598669920;
	j522781401 [label="我希望妳會後空翻！一座燈塔馬上就來。",shape=box,color=red];
		j522781401 -> j1205479683;
	j2598669920 [label="哇，我不知道我是不是能夠接受這件事。要是妳被困住或迷失了怎麼辦？！",shape=box,color=red];
		j2598669920 -> j2145146611;
	j1205479683 [label="當然，我還沒有完全準備好。俗話說三思而後行，凡事要經過深思熟慮。",shape=box,color=blue];
		j1205479683 -> j304526414;
		j1205479683 -> j1421569022;
	j2145146611 [label="我不會的。",shape=box,color=blue];
		j2145146611 -> j3698551076;
	j304526414 [label="有道理，科學最好在信心滿滿的情況下進行。",shape=box,color=red];
		j304526414 -> j355828301;
	j1421569022 [label="我們直接試了！沒時間思慮了，現在就出發！",shape=box,color=red];
		j1421569022 -> j2405372421;
	j3698551076 [label="妳可能會。",shape=box,color=red];
		j3698551076 -> j3144635456;
	j355828301 [label="我看我把你教得很好。",shape=box,color=blue];
		j355828301 -> j3345545516;
		j355828301 -> j3301666165;
	j2405372421 [label="喔不──，我還沒準備好！不能急於求成！",shape=box,color=blue];
		j2405372421 -> j1787885293;
	j3144635456 [label="絕對不會。",shape=box,color=blue];
		j3144635456 -> j2636526539;
		j3144635456 -> j570761986;
	j3345545516 [label="妳想太多了！",shape=box,color=red];
		j3345545516 -> j4123196853;
	j3301666165 [label="哦，當然，妳是一位好老師。儘管我想我只看到妳做的唯一一件事就是教米娜瓦怎麼玩新的飲酒遊戲。",shape=box,color=red];
		j3301666165 -> j2053721223;
	j1787885293 [label="好吧，看來妳還是知道到這可能有多危險。非常好。",shape=box,color=red];
		j1787885293 -> j1372881899;
	j2636526539 [label="唉……",shape=box,color=red];
		j2636526539 -> j1124377402;
	j570761986 [label="但……妳可能會。",shape=box,color=red];
		j570761986 -> j1124377402;
	j2053721223 [label="不過米娜瓦宿醉時比時間旅行更危險。快跑！",shape=box,color=blue];
		j2053721223 -> j4123196853;
	j1372881899 [label="不過米娜瓦宿醉時更危險。快跑！",shape=box,color=blue];
		j1372881899 -> j4123196853;
	j1124377402 [label="你會來找我的。",shape=box,color=blue];
		j1124377402 -> j889873334;
	j889873334 [label="別把責任推到我頭上……",shape=box,color=red];
		j889873334 -> j3121128377;
	j3121128377 [label="不能反悔！",shape=box,color=blue];
		j3121128377 -> j4123196853;
}