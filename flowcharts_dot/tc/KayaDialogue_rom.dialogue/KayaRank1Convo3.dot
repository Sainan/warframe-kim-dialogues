	108 [label="+5 Chemistry",color=orange];
		108 -> 101;
	107 [label="他在用他的電腦還是什麼的。",shape=box,color=blue];
		107 -> 113;
	110 [label="嗯，我想我們都在物盡其用。妳有跟阿米爾聊過妳的問題了嗎？",shape=box,color=red];
		110 -> 116;
	109 [label="Check boolean KayaLettieHeal",color=orange];
		109 -> 115 [label=true,color=green];
		109 -> 114 [label=false,color=brown];
	111 [label="是的，我不了解你。我只知道你能做什麼。這就是我們交談的原因。所以麻煩認真點。",shape=box,color=blue];
		111 -> 117;
	112 [label="來自網際網路上陌生人的承諾。得了吧。哈。就告訴我我想知道的事。",shape=box,color=blue];
		112 -> 118;
	113 [label="然後我出現了，他真的被嚇到了。好像，他根本沒料想到有人會出現。",shape=box,color=blue];
		113 -> 119;
		113 -> 120;
	116 [label="我有。我們在一些基礎理論上有達成共識，但他似乎對具體且可重現的時間旅行定理不感興趣。",shape=box,color=blue];
		116 -> 123;
	115 [label="嗯，我想我們都在物盡其用。妳有跟莉蒂聊過了嗎？我覺得妳和她會相處得很好。",shape=box,color=red];
		115 -> 122;
	114 [label="是的，只是想說如果妳能使用我的時代的更多工具的話會更容易一些……",shape=box,color=red];
		114 -> 121;
	117 [label="好吧，我們認真一點。",shape=box,color=red];
		117 -> 124;
		117 -> 125;
	118 [label="妳是有發生什麼事嗎？",shape=box,color=red];
		118 -> 126;
	119 [label="哇哦，那真是厲害了。",shape=box,color=red];
		119 -> 127;
	120 [label="哇哦，妳這是在自吹自擂嗎？",shape=box,color=red];
		120 -> 127;
	123 [label="事實上，他有讓我信服我在一些原始假說上是錯的，所以確實有幫助，但他提醒我，也許我可以付費找答案，又或者如果你不願意幫我的話，至少付費與其他來自未來的人談論。",shape=box,color=blue];
		123 -> 130;
		123 -> 131;
	122 [label="我們相處得很好。她讓我想起曾經的一位老師，沒有絲毫惡意，看重我聰明的頭腦。",shape=box,color=blue];
		122 -> 129;
	121 [label="那是個提議嗎？我能用到什麼？任何幫助都好。",shape=box,color=blue];
		121 -> 128;
	124 [label="妳想穿越時空，但想去到哪裡？為什麼？",shape=box,color=red];
		124 -> 132;
	125 [label="妳有四周查看過了嗎？",shape=box,color=red];
		125 -> 133;
	126 [label="我們所有人都發生了一些事。如果你想到了幫助我的方法就告訴我。",shape=box,color=blue];
		126 -> 134;
	127 [label="呃，為什麼還要我再跟你解釋一次？",shape=box,color=blue];
		127 -> 135;
	130 [label="給我 10 霍幣，我就告訴妳會怎麼死去。",shape=box,color=red];
		130 -> 139;
	131 [label="任何賣妳那種東西的人都是騙子。我會盡量幫妳，真的。不收費。",shape=box,color=red];
		131 -> 140;
	129 [label="她確實超級酷。也很聰明。雖然，她告訴我真的要信任你，所以，我想我們拭目以待。",shape=box,color=blue];
		129 -> 137;
		129 -> 138;
	128 [label="如果妳想按照自己的方式來弄明白的話，我看一下能幫妳找些什麼。",shape=box,color=red];
		128 -> 136;
	132 [label="唉，你能搞定任何事嗎？",shape=box,color=blue];
		132 -> 141;
	133 [label="恩，我有。我已經看過一切了。這個奇跡轉圜的千禧年。受邀參加許多派對，因為人們都想要「那名女孩」到場。",shape=box,color=blue];
		133 -> 142;
	134 [label="+20 Chemistry",color=orange];
		134 -> 143;
	135 [label="就告訴我，我需要開始存還是怎樣呢？",shape=box,color=blue];
		135 -> 144;
		135 -> 145;
	139 [label="呃。變態。",shape=box,color=blue];
		139 -> 149;
	140 [label="那我們就拭目以待，好嗎？",shape=box,color=blue];
		140 -> 150;
	137 [label="我不是來這裡背叛妳的，而且我也不是什麼時間旅行的教科書",shape=box,color=red];
