	94 [label="妳知道妳的群組「Nova」完全與時間旅行無關，對吧？",shape=box,color=red];
		94 -> 98;
	95 [label="聽著，妳似乎真的只在乎一件事。時間旅行。為什麼？",shape=box,color=red];
		95 -> 99;
