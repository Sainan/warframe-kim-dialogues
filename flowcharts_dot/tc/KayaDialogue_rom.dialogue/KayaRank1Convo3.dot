		86 -> 87;
	87 [label="時間旅行──會很貴嗎？成本與原材料息息相關嗎？還是在你的時代已經以某種方式商品化了，跟這裡的某些事物差不多？",shape=box,color=blue];
		87 -> 88;
		87 -> 89;
	88 [label="為什麼？想省下一些霍幣來賄賂我嗎？",shape=box,color=red];
		88 -> 90;
