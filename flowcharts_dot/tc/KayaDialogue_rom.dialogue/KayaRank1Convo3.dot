digraph {
	"KayaRank1Convo3 begins." [color=orange];
		"KayaRank1Convo3 begins." -> j1047356244;
	j1047356244 [label="時間旅行──會很貴嗎？成本與原材料息息相關嗎？還是在你的時代已經以某種方式商品化了，跟這裡的某些事物差不多？",shape=box,color=blue];
		j1047356244 -> j1743357445;
		j1047356244 -> j3657776605;
	j1743357445 [label="為什麼？想省下一些霍幣來賄賂我嗎？",shape=box,color=red];
		j1743357445 -> j339786366;
	j3657776605 [label="有些代價是沒有附帶霍幣符號的。順便問候一聲，嗨。",shape=box,color=red];
		j3657776605 -> j3351591088;
	j339786366 [label="這對源拓氏有效。",shape=box,color=blue];
		j339786366 -> j1526774244;
		j339786366 -> j2286425779;
	j3351591088 [label="嗨。所以我不能只付錢給某人做某件事，然後自己從中學習怎麼做嗎？",shape=box,color=blue];
		j3351591088 -> j1343569905;
		j3351591088 -> j689459441;
		j3351591088 -> j3918746743;
	j1526774244 [label="不好意思，說什麼？",shape=box,color=red];
		j1526774244 -> j1310704431;
	j2286425779 [label="什麼？",shape=box,color=red];
		j2286425779 -> j1310704431;
	j1343569905 [label="妳知道妳的群組「Nova」完全與時間旅行無關，對吧？",shape=box,color=red];
		j1343569905 -> j1479968385;
	j689459441 [label="聽著，妳似乎真的只在乎一件事。時間旅行。為什麼？",shape=box,color=red];
		j689459441 -> j1647355773;
	j3918746743 [label="妳這樣是不行的。[結束]",shape=box,color=red];
		j3918746743 -> j3994434447;
	j1310704431 [label="Check boolean KayaSetFound",color=orange];
		j1310704431 -> j1733778826 [label=true,color=green];
		j1310704431 -> j1384967163 [label=false,color=brown];
	j1479968385 [label="Nova 能做什麼或不能做什麼都沒關係。",shape=box,color=blue];
		j1479968385 -> j2647674648;
	j1647355773 [label="你不會懂的。",shape=box,color=blue];
		j1647355773 -> j218298868;
		j1647355773 -> j976362408;
	j3994434447 [label="+20 Chemistry",color=orange];
		j3994434447 -> "Chat ends. Next chat will be KayaRank2Convo1.";
	j1733778826 [label="呃，我已經告訴過你了。我找到他了。",shape=box,color=blue];
		j1733778826 -> j1858985762;
	j1384967163 [label="還有就是。",shape=box,color=blue];
		j1384967163 -> j3173358792;
	j2647674648 [label="Check boolean KayaAmirTravel",color=orange];
		j2647674648 -> j2400301698 [label=true,color=green];
		j2647674648 -> j368315635 [label=false,color=brown];
	j218298868 [label="妳又不了解我。等一下，這應該是妳的句子吧？",shape=box,color=red];
		j218298868 -> j3574443985;
	j976362408 [label="我保證我會明白的。",shape=box,color=red];
		j976362408 -> j1511242737;
	"Chat ends. Next chat will be KayaRank2Convo1." [color=orange];
	j1858985762 [label="+5 Chemistry",color=orange];
		j1858985762 -> j1384967163;
	j3173358792 [label="他在用他的電腦還是什麼的。",shape=box,color=blue];
		j3173358792 -> j384308128;
	j2400301698 [label="嗯，我想我們都在物盡其用。妳有跟阿米爾聊過妳的問題了嗎？",shape=box,color=red];
		j2400301698 -> j1300118266;
	j368315635 [label="Check boolean KayaLettieHeal",color=orange];
		j368315635 -> j548921612 [label=true,color=green];
		j368315635 -> j1598004049 [label=false,color=brown];
	j3574443985 [label="是的，我不了解你。我只知道你能做什麼。這就是我們交談的原因。所以麻煩認真點。",shape=box,color=blue];
		j3574443985 -> j478685511;
	j1511242737 [label="來自網際網路上陌生人的承諾。得了吧。哈。就告訴我我想知道的事。",shape=box,color=blue];
		j1511242737 -> j1550401792;
	j384308128 [label="然後我出現了，他真的被嚇到了。好像，他根本沒料想到有人會出現。",shape=box,color=blue];
		j384308128 -> j976247659;
		j384308128 -> j2090748968;
	j1300118266 [label="我有。我們在一些基礎理論上有達成共識，但他似乎對具體且可重現的時間旅行定理不感興趣。",shape=box,color=blue];
		j1300118266 -> j812888918;
	j548921612 [label="嗯，我想我們都在物盡其用。妳有跟莉蒂聊過了嗎？我覺得妳和她會相處得很好。",shape=box,color=red];
		j548921612 -> j2451763196;
	j1598004049 [label="是的，只是想說如果妳能使用我的時代的更多工具的話會更容易一些……",shape=box,color=red];
		j1598004049 -> j2086565644;
	j478685511 [label="好吧，我們認真一點。",shape=box,color=red];
		j478685511 -> j3698186628;
		j478685511 -> j2835883657;
	j1550401792 [label="妳是有發生什麼事嗎？",shape=box,color=red];
		j1550401792 -> j2312065299;
	j976247659 [label="哇哦，那真是厲害了。",shape=box,color=red];
		j976247659 -> j2016652857;
	j2090748968 [label="哇哦，妳這是在自吹自擂嗎？",shape=box,color=red];
		j2090748968 -> j2016652857;
	j812888918 [label="事實上，他有讓我信服我在一些原始假說上是錯的，所以確實有幫助，但他提醒我，也許我可以付費找答案，又或者如果你不願意幫我的話，至少付費與其他來自未來的人談論。",shape=box,color=blue];
		j812888918 -> j2121269140;
		j812888918 -> j3421252374;
	j2451763196 [label="我們相處得很好。她讓我想起曾經的一位老師，沒有絲毫惡意，看重我聰明的頭腦。",shape=box,color=blue];
		j2451763196 -> j1776516824;
	j2086565644 [label="那是個提議嗎？我能用到什麼？任何幫助都好。",shape=box,color=blue];
		j2086565644 -> j1973997914;
	j3698186628 [label="妳想穿越時空，但想去到哪裡？為什麼？",shape=box,color=red];
		j3698186628 -> j947720301;
	j2835883657 [label="妳有四周查看過了嗎？",shape=box,color=red];
		j2835883657 -> j4091275452;
	j2312065299 [label="我們所有人都發生了一些事。如果你想到了幫助我的方法就告訴我。",shape=box,color=blue];
		j2312065299 -> j3994434447;
	j2016652857 [label="呃，為什麼還要我再跟你解釋一次？",shape=box,color=blue];
		j2016652857 -> j994410264;
	j2121269140 [label="給我 10 霍幣，我就告訴妳會怎麼死去。",shape=box,color=red];
		j2121269140 -> j743445528;
	j3421252374 [label="任何賣妳那種東西的人都是騙子。我會盡量幫妳，真的。不收費。",shape=box,color=red];
		j3421252374 -> j2372984958;
	j1776516824 [label="她確實超級酷。也很聰明。雖然，她告訴我真的要信任你，所以，我想我們拭目以待。",shape=box,color=blue];
		j1776516824 -> j3228277642;
		j1776516824 -> j4057504022;
	j1973997914 [label="如果妳想按照自己的方式來弄明白的話，我看一下能幫妳找些什麼。",shape=box,color=red];
		j1973997914 -> j16837167;
	j947720301 [label="唉，你能搞定任何事嗎？",shape=box,color=blue];
		j947720301 -> j1686252231;
	j4091275452 [label="恩，我有。我已經看過一切了。這個奇跡轉圜的千禧年。受邀參加許多派對，因為人們都想要「那名女孩」到場。",shape=box,color=blue];
		j4091275452 -> j3577644608;
	j994410264 [label="就告訴我，我需要開始存還是怎樣呢？",shape=box,color=blue];
		j994410264 -> j4285884093;
		j994410264 -> j2343888168;
	j743445528 [label="呃。變態。",shape=box,color=blue];
		j743445528 -> j3994434447;
	j2372984958 [label="那我們就拭目以待，好嗎？",shape=box,color=blue];
		j2372984958 -> j3994434447;
	j3228277642 [label="我不是來這裡背叛妳的，而且我也不是什麼時間旅行的教科書",shape=box,color=red];
		j3228277642 -> j1955417577;
	j4057504022 [label="我向妳保證妳可以信任我，我不太明白妳為什麼對我會這麼有敵意。",shape=box,color=red];
		j4057504022 -> j603470847;
	j16837167 [label="我想。我會的。",shape=box,color=blue];
		j16837167 -> j3994434447;
	j1686252231 [label="誰會想生活在這裡啊？好像……",shape=box,color=blue];
		j1686252231 -> j3927675112;
	j3577644608 [label="這永無止境。向前看。當你能幫助我時來找我。",shape=box,color=blue];
		j3577644608 -> j3994434447;
	j4285884093 [label="卡婭，我認為妳對這件事有點太過於執著了。如果妳弄不明白怎麼辦？",shape=box,color=red];
		j4285884093 -> j2781564408;
	j2343888168 [label="不知道。卡婭，我是被選中的那個。",shape=box,color=red];
		j2343888168 -> j868862070;
	j1955417577 [label="呃。行",shape=box,color=blue];
		j1955417577 -> j3994434447;
	j603470847 [label="我有我的理由",shape=box,color=blue];
		j603470847 -> j3994434447;
	j3927675112 [label="我會弄明白的，我知道我行的，所以，就這樣。再見。",shape=box,color=blue];
		j3927675112 -> j3994434447;
	j2781564408 [label="我會的。",shape=box,color=blue];
		j2781564408 -> j3994434447;
	j868862070 [label="是啊，被選中的混蛋。",shape=box,color=blue];
		j868862070 -> j3994434447;
}