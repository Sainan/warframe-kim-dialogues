digraph {
	887 [label="KayaRank5Convo3 begins.",color=orange];
		887 -> 888;
	888 [label="哦，嗨，我可以向你介紹一下吉你夢卡牌的基礎知識嗎？",shape=box,color=blue];
		888 -> 889;
	889 [label="阿米爾當然很興奮他終於有人可以一起玩（而且可以讓他輸了）。",shape=box,color=blue];
		889 -> 890;
	890 [label="但我們都認為讓你加入吉你夢會很有趣。",shape=box,color=blue];
		890 -> 891;
		890 -> 892;
		890 -> 893;
	891 [label="你們玩吧。我很忙。[結束]",shape=box,color=red];
		891 -> 894;
	892 [label="我口袋裡的霍幣放到都快燒出破洞了，我們要從哪裡開始？",shape=box,color=red];
		892 -> 895;
	893 [label="提醒我一下……我們在談論什麼？",shape=box,color=red];
		893 -> 896;
	894 [label="+20 Chemistry",color=orange];
		894 -> 897;
	895 [label="嗯，很好！首先，我們專注在你身上。你認為自己更像龍、鷹還是豹？",shape=box,color=blue];
		895 -> 898;
		895 -> 899;
		895 -> 900;
	896 [label="這可是 1999 年最受歡迎的節目、遊戲和收藏品！",shape=box,color=blue];
		896 -> 901;
	897 [label="Chat ends. Next chat will be KayaRank5Convo4.",color=orange];
	898 [label="一隻豹。",shape=box,color=red];
		898 -> 902;
	899 [label="一隻鷹。",shape=box,color=red];
		899 -> 903;
	900 [label="一條龍。",shape=box,color=red];
		900 -> 904;
	901 [label="你知道的，有超酷的角色和生物……",shape=box,color=blue];
		901 -> 905;
	902 [label="好的，那麼你絕對會想用潛影豹開始遊戲",shape=box,color=blue];
		902 -> 906;
	903 [label="好的，所以你肯定會想用鷹伯特開始遊戲",shape=box,color=blue];
		903 -> 907;
	904 [label="好的，所以你大概會想用龍蛙寶開始遊戲。",shape=box,color=blue];
		904 -> 908;
	905 [label="我想這不是重點。總之，我們先從你開始。你認為自己更像龍、鷹還是豹？",shape=box,color=blue];
		905 -> 898;
		905 -> 899;
		905 -> 900;
	906 [label="這是最酷的選擇，但確實很棘手，一開始真的很弱。",shape=box,color=blue];
		906 -> 909;
	907 [label="這有點高級但真的很酷。",shape=box,color=blue];
		907 -> 910;
	908 [label="這對初學者來說是個很好的選擇。",shape=box,color=blue];
		908 -> 911;
	909 [label="但到了最後，最華麗、最威嚴的獵豹基本上就屬於你的了。",shape=box,color=blue];
		909 -> 912;
	910 [label="而且鷹伯特超可愛，因為你可以餵牠汽泡葡萄，讓牠比其他吉祥物更快升級。",shape=box,color=blue];
		910 -> 913;
	911 [label="當然，你一開始擁有的基本上是有史以來最可愛的青蛙，但最終如果你贏得足夠多的戰鬥……",shape=box,color=blue];
		911 -> 914;
	912 [label="完全是個高雅的選擇。",shape=box,color=blue];
		912 -> 915;
	913 [label="這讓你可以解鎖整個農作系統。",shape=box,color=blue];
		913 -> 915;
	914 [label="你可以將龍蛙寶升級成一條龍。",shape=box,color=blue];
		914 -> 915;
	915 [label="這到底是什麼遊戲……",shape=box,color=red];
		915 -> 916;
	916 [label="嗯好的，所以你收集吉你夢吉祥物，它們會為你戰鬥，你還可以到四處冒險。",shape=box,color=blue];
		916 -> 917;
	917 [label="但那是在電玩遊戲版本中。在卡牌遊戲版本中，像是你在現實生活中與別人對戰一樣。",shape=box,color=blue];
		917 -> 918;
	918 [label="不過這整個概念都是一樣的。吉你夢、吉你夢、吉你夢。",shape=box,color=blue];
		918 -> 919;
	919 [label="那麼，準備好要玩你的第一場比賽了嗎？",shape=box,color=blue];
		919 -> 920;
		919 -> 921;
		919 -> 922;
		919 -> 923;
	920 [label="不要。[結束]",shape=box,color=red];
		920 -> 924;
	921 [label="當然可以，初學者的好運一定會眷顧我。",shape=box,color=red];
		921 -> 925;
	922 [label="妳只是想要輕鬆獲勝。不要。",shape=box,color=red];
		922 -> 926;
	923 [label="不，我現在更加困惑了。妳什麼都沒解釋到！",shape=box,color=red];
		923 -> 926;
	924 [label="+20 Chemistry",color=orange];
		924 -> 927;
	925 [label="太好了……你只需要花個大概一萬霍幣來購買你自己的入門卡包……",shape=box,color=blue];
		925 -> 928;
		925 -> 929;
	926 [label="哦，拜託……我會對你手下留情的。我甚至還會讓阿米爾幫助你！",shape=box,color=blue];
		926 -> 930;
	927 [label="Chat ends. Next chat will be KayaRank5Convo4.",color=orange];
	928 [label="既然妳這麼說的話……",shape=box,color=red];
		928 -> 931;
	929 [label="什麼！我沒有那麼多錢。",shape=box,color=red];
		929 -> 931;
	930 [label="而且如果你贏了，我還會送你一包未開封的吉你夢卡包！",shape=box,color=blue];
		930 -> 932;
		930 -> 933;
		930 -> 934;
	931 [label="那也沒關係，如果你可以把你的銀行資料打在螢幕上……",shape=box,color=blue];
