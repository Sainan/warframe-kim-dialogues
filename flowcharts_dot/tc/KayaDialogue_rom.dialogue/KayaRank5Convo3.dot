digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"KayaRank5Convo3 begins." [color=orange];
		"KayaRank5Convo3 begins." -> j3748804603;
	j3748804603 [label="哦，嗨，我可以向你介紹一下吉你夢卡牌的基礎知識嗎？",shape=box,color=blue];
		j3748804603 -> j821713664;
	j821713664 [label="阿米爾當然很興奮他終於有人可以一起玩（而且可以讓他輸了）。",shape=box,color=blue];
		j821713664 -> j242259911;
	j242259911 [label="但我們都認為讓你加入吉你夢會很有趣。",shape=box,color=blue];
		j242259911 -> j2603883486;
		j242259911 -> j2461965885;
		j242259911 -> j3708464451;
	j2603883486 [label="你們玩吧。我很忙。[結束]",shape=box,color=red];
		j2603883486 -> j145506587;
	j2461965885 [label="我口袋裡的霍幣放到都快燒出破洞了，我們要從哪裡開始？",shape=box,color=red];
		j2461965885 -> j3158078682;
	j3708464451 [label="提醒我一下……我們在談論什麼？",shape=box,color=red];
		j3708464451 -> j1961860108;
	j145506587 [label="+20 Chemistry",color=orange];
		j145506587 -> "Chat ends. Next chat will be KayaRank5Convo4.";
	j3158078682 [label="嗯，很好！首先，我們專注在你身上。你認為自己更像龍、鷹還是豹？",shape=box,color=blue];
		j3158078682 -> j3058192751;
		j3158078682 -> j3248553118;
		j3158078682 -> j3268428733;
	j1961860108 [label="這可是 1999 年最受歡迎的節目、遊戲和收藏品！",shape=box,color=blue];
		j1961860108 -> j2681149783;
	"Chat ends. Next chat will be KayaRank5Convo4." [color=orange];
	j3058192751 [label="一隻豹。",shape=box,color=red];
		j3058192751 -> j3051103957;
	j3248553118 [label="一隻鷹。",shape=box,color=red];
		j3248553118 -> j3960659099;
	j3268428733 [label="一條龍。",shape=box,color=red];
		j3268428733 -> j1767595864;
	j2681149783 [label="你知道的，有超酷的角色和生物……",shape=box,color=blue];
		j2681149783 -> j908367491;
	j3051103957 [label="好的，那麼你絕對會想用潛影豹開始遊戲",shape=box,color=blue];
		j3051103957 -> j4061380091;
	j3960659099 [label="好的，所以你肯定會想用鷹伯特開始遊戲",shape=box,color=blue];
		j3960659099 -> j3863846868;
	j1767595864 [label="好的，所以你大概會想用龍蛙寶開始遊戲。",shape=box,color=blue];
		j1767595864 -> j3842536674;
	j908367491 [label="我想這不是重點。總之，我們先從你開始。你認為自己更像龍、鷹還是豹？",shape=box,color=blue];
		j908367491 -> j3058192751;
		j908367491 -> j3248553118;
		j908367491 -> j3268428733;
	j4061380091 [label="這是最酷的選擇，但確實很棘手，一開始真的很弱。",shape=box,color=blue];
		j4061380091 -> j1105868605;
	j3863846868 [label="這有點高級但真的很酷。",shape=box,color=blue];
		j3863846868 -> j2467275287;
	j3842536674 [label="這對初學者來說是個很好的選擇。",shape=box,color=blue];
		j3842536674 -> j1512440596;
	j1105868605 [label="但到了最後，最華麗、最威嚴的獵豹基本上就屬於你的了。",shape=box,color=blue];
		j1105868605 -> j196417114;
	j2467275287 [label="而且鷹伯特超可愛，因為你可以餵牠汽泡葡萄，讓牠比其他吉祥物更快升級。",shape=box,color=blue];
		j2467275287 -> j2008235513;
	j1512440596 [label="當然，你一開始擁有的基本上是有史以來最可愛的青蛙，但最終如果你贏得足夠多的戰鬥……",shape=box,color=blue];
		j1512440596 -> j433781184;
	j196417114 [label="完全是個高雅的選擇。",shape=box,color=blue];
		j196417114 -> j2147402865;
	j2008235513 [label="這讓你可以解鎖整個農作系統。",shape=box,color=blue];
		j2008235513 -> j2147402865;
	j433781184 [label="你可以將龍蛙寶升級成一條龍。",shape=box,color=blue];
		j433781184 -> j2147402865;
	j2147402865 [label="這到底是什麼遊戲……",shape=box,color=red];
		j2147402865 -> j2861714521;
	j2861714521 [label="嗯好的，所以你收集吉你夢吉祥物，它們會為你戰鬥，你還可以到四處冒險。",shape=box,color=blue];
		j2861714521 -> j2394661820;
	j2394661820 [label="但那是在電玩遊戲版本中。在卡牌遊戲版本中，像是你在現實生活中與別人對戰一樣。",shape=box,color=blue];
		j2394661820 -> j2820193854;
	j2820193854 [label="不過這整個概念都是一樣的。吉你夢、吉你夢、吉你夢。",shape=box,color=blue];
		j2820193854 -> j1954797457;
	j1954797457 [label="那麼，準備好要玩你的第一場比賽了嗎？",shape=box,color=blue];
		j1954797457 -> j222842084;
		j1954797457 -> j1439020107;
		j1954797457 -> j3032385758;
		j1954797457 -> j3992618640;
	j222842084 [label="不要。[結束]",shape=box,color=red];
		j222842084 -> j145506587;
	j1439020107 [label="當然可以，初學者的好運一定會眷顧我。",shape=box,color=red];
		j1439020107 -> j247594712;
	j3032385758 [label="妳只是想要輕鬆獲勝。不要。",shape=box,color=red];
		j3032385758 -> j3455169441;
	j3992618640 [label="不，我現在更加困惑了。妳什麼都沒解釋到！",shape=box,color=red];
		j3992618640 -> j3455169441;
	j247594712 [label="太好了……你只需要花個大概一萬霍幣來購買你自己的入門卡包……",shape=box,color=blue];
		j247594712 -> j2751179180;
		j247594712 -> j2520938435;
	j3455169441 [label="哦，拜託……我會對你手下留情的。我甚至還會讓阿米爾幫助你！",shape=box,color=blue];
		j3455169441 -> j2268275646;
	j2751179180 [label="既然妳這麼說的話……",shape=box,color=red];
		j2751179180 -> j3631112404;
	j2520938435 [label="什麼！我沒有那麼多錢。",shape=box,color=red];
		j2520938435 -> j3631112404;
	j2268275646 [label="而且如果你贏了，我還會送你一包未開封的吉你夢卡包！",shape=box,color=blue];
		j2268275646 -> j954599838;
		j2268275646 -> j2401586995;
		j2268275646 -> j721828366;
	j3631112404 [label="那也沒關係，如果你可以把你的銀行資料打在螢幕上……",shape=box,color=blue];
		j3631112404 -> j419697909;
		j3631112404 -> j2697596332;
	j954599838 [label="好的，沒問題。只要阿米爾能幫助我。",shape=box,color=red];
		j954599838 -> j247594712;
	j2401586995 [label="下次怎麼樣？",shape=box,color=red];
		j2401586995 -> j1761279356;
	j721828366 [label="不要！",shape=box,color=red];
		j721828366 -> j1761279356;
	j419697909 [label="我才不會上當！",shape=box,color=red];
		j419697909 -> j2615128037;
	j2697596332 [label="好的，4……1",shape=box,color=red];
		j2697596332 -> j1639227277;
	j1761279356 [label="好吧。",shape=box,color=blue];
		j1761279356 -> j145506587;
	j2615128037 [label="恭喜，你通過了開映線上的防詐測試。",shape=box,color=blue];
		j2615128037 -> j396002327;
	j1639227277 [label="噢我的天啊，不！這是個測試，你不應該把你的銀行資料放在開映線上的網路服務上！",shape=box,color=blue];
		j1639227277 -> j2199748329;
	j396002327 [label="噢我的天啊，阿米爾還很篤定你會上當。",shape=box,color=blue];
		j396002327 -> j2631651960;
	j2199748329 [label="呃，該死！我欠阿米爾一場遊戲。他說你會上當。",shape=box,color=blue];
		j2199748329 -> j145506587;
	j2631651960 [label="但好吧，我們晚點來玩。",shape=box,color=blue];
		j2631651960 -> j145506587;
}