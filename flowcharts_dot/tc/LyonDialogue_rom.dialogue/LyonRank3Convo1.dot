digraph {
	"LyonRank3Convo1 begins." [color=orange];
		"LyonRank3Convo1 begins." -> j592487653;
	j592487653 [label="你好，漂泊者。",shape=box,color=blue];
		j592487653 -> j2131463037;
	j2131463037 [label="我聽說了你希望能與我談談。",shape=box,color=blue];
		j2131463037 -> j1482898803;
		j2131463037 -> j4015037127;
		j2131463037 -> j1225378210;
	j1482898803 [label="我很高興能在這裡和你交談，里昂——謝謝你。",shape=box,color=red];
		j1482898803 -> j3701741011;
	j4015037127 [label="是瑪麗終於說服你我不會構成威脅了嗎？",shape=box,color=red];
		j4015037127 -> j1812926507;
	j1225378210 [label="哦！你好啊，里昂。我還真沒想到你居然會被說服。很高興你改變心意了。",shape=box,color=red];
		j1225378210 -> j903615253;
	j3701741011 [label="你最終或許會後悔自己當初那麼急於求成，不過沒關係，不用客氣。",shape=box,color=blue];
		j3701741011 -> j1231874424;
		j3701741011 -> j3301670101;
	j1812926507 [label="不要讓我這麼快就找到反悔的理由。",shape=box,color=blue];
		j1812926507 -> j1933300832;
	j903615253 [label="是的……不過等一切塵埃落定時，你或許就不會這麼高興了。",shape=box,color=blue];
		j903615253 -> j1231874424;
		j903615253 -> j3301670101;
	j1231874424 [label="我聽其他人說你有些事情想跟我談談。有什麼我能幫上忙的嗎？",shape=box,color=red];
		j1231874424 -> j2457444625;
	j3301670101 [label="有什麼問題嗎？",shape=box,color=red];
		j3301670101 -> j4129191878;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j2457444625 [label="或許吧，將來。但我們才剛開始交談。我來這裏只是想……告訴你，我最終還是沒有抵擋瑪麗的勸告，而相信你在談話方面是值得信任的。",shape=box,color=blue];
		j2457444625 -> j2777944732;
	j4129191878 [label="這個問題荒謬得可笑，我根本不想回答，我們才剛開始交談。我來這裏只是想……告訴你，我最終還是沒有抵擋瑪麗的勸告，而相信你在談話方面是值得信任的。",shape=box,color=blue];
		j4129191878 -> j2777944732;
	"Chat ends." [color=orange];
	j2777944732 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j2777944732 -> j468989977 [label="x > 0",color=purple];
		j2777944732 -> j2641716965 [label="x <= 0",color=purple];
		j2777944732 -> j2641716965 [label="false",color=purple];
	j468989977 [label="既然我們現在要在羅瑟「狠下心」要推進的這件事合作，那麼我們最好還是彼此瞭解一下。看來你也比較喜歡這種方式。所以，我來了。",shape=box,color=blue];
		j468989977 -> j1985549187;
		j468989977 -> j3805329710;
	j2641716965 [label="既然我們現在要在羅瑟「狠下心」要推進的這件事可能會永久地合作，那麼我們最好還是彼此瞭解一下。看來你也比較喜歡這種方式。所以，我來了。",shape=box,color=blue];
		j2641716965 -> j1985549187;
		j2641716965 -> j3805329710;
	j1985549187 [label="不知道怎地，我覺得自己好像一開始就做錯了。",shape=box,color=red];
		j1985549187 -> j869875167;
	j3805329710 [label="那……有其他你更喜歡的方式嗎？",shape=box,color=red];
		j3805329710 -> j3521063265;
	j869875167 [label="不，你沒有。我只是不是那種跟你平常跟他們聊天的人。就這點來說，你至今為止已經很幸運了，雖說像我這樣的瘋子是很罕見。",shape=box,color=blue];
		j869875167 -> j2439581628;
	j3521063265 [label="不。這個完全可以接受。事實上，這樣給了我時間按照自己喜歡的方式整理思路。我能理解為什麼這種設備如此吸引。",shape=box,color=blue];
		j3521063265 -> j1731560353;
	j2439581628 [label="我離題了。恐怕我來這裏並非為了花太多時間「打字」，這肯定會讓你失望。我只是想通知你我已投降。",shape=box,color=blue];
		j2439581628 -> j2030443616;
		j2439581628 -> j3879021759;
	j1731560353 [label="不過，恐怕我來這裏並非為了花太多時間「打字」，這肯定會讓你失望。我只是想通知你我已投降。",shape=box,color=blue];
		j1731560353 -> j3879021759;
		j1731560353 -> j2030443616;
	j2030443616 [label="瑪麗比她看起來更危險，不是嗎？",shape=box,color=red];
		j2030443616 -> j1900985845;
	j3879021759 [label="我再一次，向你說聲謝謝。",shape=box,color=red];
		j3879021759 -> j349148563;
	j1900985845 [label="+20 Chemistry",color=orange];
		j1900985845 -> j194561839;
	j349148563 [label="+15 Chemistry",color=orange];
		j349148563 -> j1064376676;
	j194561839 [label="你現在才開始意識到這片水域有多深。",shape=box,color=blue];
		j194561839 -> j2331496732;
	j1064376676 [label="而無論如何……不用客氣。",shape=box,color=blue];
		j1064376676 -> j2331496732;
