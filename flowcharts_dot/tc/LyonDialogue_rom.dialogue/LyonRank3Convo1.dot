digraph {
	0 [label="LyonRank3Convo1 begins.",color=orange];
		0 -> 1;
	1 [label="你好，漂泊者。",shape=box,color=blue];
		1 -> 2;
	2 [label="我聽說了你希望能與我談談。",shape=box,color=blue];
		2 -> 3;
		2 -> 4;
		2 -> 5;
	3 [label="我很高興能在這裡和你交談，里昂——謝謝你。",shape=box,color=red];
		3 -> 6;
	4 [label="是瑪麗終於說服你我不會構成威脅了嗎？",shape=box,color=red];
		4 -> 7;
	5 [label="哦！你好啊，里昂。我還真沒想到你居然會被說服。很高興你改變心意了。",shape=box,color=red];
		5 -> 8;
	6 [label="你最終或許會後悔自己當初那麼急於求成，不過沒關係，不用客氣。",shape=box,color=blue];
		6 -> 9;
		6 -> 10;
	7 [label="不要讓我這麼快就找到反悔的理由。",shape=box,color=blue];
		7 -> 11;
	8 [label="是的……不過等一切塵埃落定時，你或許就不會這麼高興了。",shape=box,color=blue];
		8 -> 9;
		8 -> 10;
	9 [label="我聽其他人說你有些事情想跟我談談。有什麼我能幫上忙的嗎？",shape=box,color=red];
		9 -> 12;
	10 [label="有什麼問題嗎？",shape=box,color=red];
		10 -> 13;
	11 [label="+10 Chemistry",color=orange];
		11 -> 14;
	12 [label="或許吧，將來。但我們才剛開始交談。我來這裏只是想……告訴你，我最終還是沒有抵擋瑪麗的勸告，而相信你在談話方面是值得信任的。",shape=box,color=blue];
		12 -> 15;
	13 [label="這個問題荒謬得可笑，我根本不想回答，我們才剛開始交談。我來這裏只是想……告訴你，我最終還是沒有抵擋瑪麗的勸告，而相信你在談話方面是值得信任的。",shape=box,color=blue];
		13 -> 15;
	14 [label="Chat ends.",color=orange];
	15 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		15 -> 16 [label="x > 0",color=purple];
		15 -> 17 [label="x <= 0",color=purple];
		15 -> 17 [label="false",color=purple];
	16 [label="既然我們現在要在羅瑟「狠下心」要推進的這件事合作，那麼我們最好還是彼此瞭解一下。看來你也比較喜歡這種方式。所以，我來了。",shape=box,color=blue];
		16 -> 18;
		16 -> 19;
	17 [label="既然我們現在要在羅瑟「狠下心」要推進的這件事可能會永久地合作，那麼我們最好還是彼此瞭解一下。看來你也比較喜歡這種方式。所以，我來了。",shape=box,color=blue];
		17 -> 18;
		17 -> 19;
	18 [label="不知道怎地，我覺得自己好像一開始就做錯了。",shape=box,color=red];
		18 -> 20;
	19 [label="那……有其他你更喜歡的方式嗎？",shape=box,color=red];
		19 -> 21;
	20 [label="不，你沒有。我只是不是那種跟你平常跟他們聊天的人。就這點來說，你至今為止已經很幸運了，雖說像我這樣的瘋子是很罕見。",shape=box,color=blue];
		20 -> 22;
	21 [label="不。這個完全可以接受。事實上，這樣給了我時間按照自己喜歡的方式整理思路。我能理解為什麼這種設備如此吸引。",shape=box,color=blue];
		21 -> 23;
	22 [label="我離題了。恐怕我來這裏並非為了花太多時間「打字」，這肯定會讓你失望。我只是想通知你我已投降。",shape=box,color=blue];
		22 -> 24;
		22 -> 25;
	23 [label="不過，恐怕我來這裏並非為了花太多時間「打字」，這肯定會讓你失望。我只是想通知你我已投降。",shape=box,color=blue];
		23 -> 25;
		23 -> 24;
	24 [label="瑪麗比她看起來更危險，不是嗎？",shape=box,color=red];
		24 -> 26;
	25 [label="我再一次，向你說聲謝謝。",shape=box,color=red];
		25 -> 27;
	26 [label="+20 Chemistry",color=orange];
		26 -> 28;
	27 [label="+15 Chemistry",color=orange];
		27 -> 29;
	28 [label="你現在才開始意識到這片水域有多深。",shape=box,color=blue];
		28 -> 30;
	29 [label="而無論如何……不用客氣。",shape=box,color=blue];
		29 -> 30;
	30 [label="-里昂・阿拉德神父",shape=box,color=blue];
		30 -> 31;
	31 [label="Chat ends.",color=orange];
}