		"LyonRank4Convo3 begins." -> j1350559949;
	j3376909198 [label="你跟參研者相處得怎麼樣？",shape=box,color=red];
		j3376909198 -> j2136230454;
	j2877204195 [label="你覺得 Loid 怎樣？",shape=box,color=red];
		j2877204195 -> j959335321;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j2136230454 [label="我很喜歡聽他們鬥嘴，不過正如你所想，我自己並不參與。我沒什麼好補充的。",shape=box,color=blue];
		j2136230454 -> j3865445546;
	j959335321 [label="我覺得他非常討人喜歡。事實上，在我新認識的這些夥伴中，我最喜歡跟他在一起。",shape=box,color=blue];
		j959335321 -> j158225890;
	"Chat ends." [color=orange];
	j3865445546 [label="不過，當我發現羅瑟站著和鳥三長時間交談時，我感到很擔憂。我不知道他這樣做的目的是什麼。",shape=box,color=blue];
		j3865445546 -> j2507757158;
	j158225890 [label="不過我想這大概不會讓任何人感到意外。乍眼一看，我們的個性非常相似。",shape=box,color=blue];
		j158225890 -> j3287036131;
	j2507757158 [label="Boolean LyonRoatheCavia1 is now true.",color=orange];
		j2507757158 -> j4197594531;
		j2507757158 -> j563524159;
	j3287036131 [label="我覺得更奇怪的是那個年輕的指揮官……還有他們口中的 Lotus。以及我們和他們之間那種疏離感。",shape=box,color=blue];
		j3287036131 -> j2142252355;
	j4197594531 [label="嗯，我會問問他的。",shape=box,color=red];
		j4197594531 -> j4262592007;
	j563524159 [label="你覺得他到底是什麼動機？",shape=box,color=red];
		j563524159 -> j318092610;
	j2142252355 [label="我們可以互動，當然了，不過不是這樣。不是在這裡。為什麼呢？",shape=box,color=blue];
		j2142252355 -> j2669367497;
		j2142252355 -> j4029278788;
	j4262592007 [label="或許這是明智之舉。我不想看到他繼續操縱這些生物，讓牠們被利用的程度比現在更深。",shape=box,color=blue];
		j4262592007 -> j3287036131;
	j318092610 [label="羅瑟在跟任何人說話時總別有用心。我真不希望看到他進一步操縱那些生物，讓它們淪為他的工具。",shape=box,color=blue];
		j318092610 -> j3120943758;
	j2669367497 [label="孩子……他們自己有一堆煩心事要處理。我們不能再對他們要求更多了。這不公平。",shape=box,color=red];
		j2669367497 -> j306841377;
	j4029278788 [label="我……大概是因為我之前有使用原型 Warframe 的「過往經驗」吧？",shape=box,color=red];
		j4029278788 -> j3260070664;
	j3120943758 [label="如果你有時間，或許值得調查一下。當然，這完全取決於你自己。",shape=box,color=blue];
		j3120943758 -> j3287036131;
	j306841377 [label="是的。我聽聞過他們被迫忍受的苦難。戰爭的故事，還有……分崩離析、支離破碎的友誼。",shape=box,color=blue];
		j306841377 -> j359936311;
	j3260070664 [label="Check boolean IsDating",color=orange];
		j3260070664 -> j2908808305 [label=true,color=green];
		j3260070664 -> j1955996409 [label=false,color=brown];
	j359936311 [label="戰爭摧毀了太多東西，讓我心碎。但更讓我感到不可思議的是，戰爭竟然也能創造出新的東西。",shape=box,color=blue];
		j359936311 -> j1955996409;
	j2908808305 [label="嗯。現在都這樣叫的嗎？「過往經驗」？真是妙極了。雖然源拓氏似乎把事情搞得一團糟，但我很高興你……找到了自娛的方式。",shape=box,color=blue];
		j2908808305 -> j3339393966;
		j2908808305 -> j3352583857;
		j2908808305 -> j3694244589;
	j1955996409 [label="Loid 先生跟我講過你過去在霍爾瓦尼亞（也就是我們的未來）的「不幸遭遇」。源拓氏確實把事情搞得一團糟。",shape=box,color=blue];
		j1955996409 -> j575498596;
		j1955996409 -> j2231119788;
	j3339393966 [label="我做錯什麼了嗎？",shape=box,color=red];
		j3339393966 -> j3487893497;
	j3352583857 [label="小心點，否則我可能會以為你在想圍牆另一邊的草是不是比較綠一些，牧師。",shape=box,color=red];
		j3352583857 -> j619519124;
	j3694244589 [label="里昂，從你口聽起來好像這只是逢場作戲。請不要這樣侮辱我。",shape=box,color=red];
		j3694244589 -> j1331458418;
	j575498596 [label="相信我，情況本來可能更差。",shape=box,color=red];
		j575498596 -> j2511517112;
	j2231119788 [label="那些原型 Warframe 都是我的好朋友，他們就像是我的家人一樣。",shape=box,color=red];
		j2231119788 -> j3911744239;
	j3487893497 [label="Check boolean LyonFirstFlirt",color=orange];
		j3487893497 -> j1441107671 [label=true,color=green];
		j3487893497 -> j1785763114 [label=false,color=brown];
	j619519124 [label="Check boolean LyonFirstFlirt",color=orange];
		j619519124 -> j1441107671 [label=true,color=green];
		j619519124 -> j4067956138 [label=false,color=brown];
	j1331458418 [label="Check boolean LyonFirstFlirt",color=orange];
		j1331458418 -> j1441107671 [label=true,color=green];
		j1331458418 -> j604963129 [label=false,color=brown];
	j2511517112 [label="我深信這一切都是源拓氏宏偉而精妙的計劃。他要將未來的命運託付給你和一群烏合之眾。",shape=box,color=blue];
		j2511517112 -> j2817278650;
	j3911744239 [label="我的祖父母是在高勒革命期間相遇的。戰爭與死亡總像是一對舞伴，以最奇特的方式，引領出一場關於患難情誼的共舞。",shape=box,color=blue];
		j3911744239 -> j3628502303;
	j1441107671 [label="原諒我。我只是覺得，上次我們討論事情的時候，你……",shape=box,color=blue];
		j1441107671 -> j490650739;
	j1785763114 [label="請原諒我。我不了解你的內心也不了解別人的內心。你私下和別人做什麼，是你自己的事。",shape=box,color=blue];
		j1785763114 -> j90648060;
		j1785763114 -> j2025979526;
	j4067956138 [label="請原諒我。不，你說得對。我並非有意嫉妒也不是想挑釁。你私下和別人做什麼，是你自己的事。",shape=box,color=blue];
		j4067956138 -> j90648060;
		j4067956138 -> j2025979526;
	j604963129 [label="當時。請原諒我。我不了解你的內心也不了解別人的內心。你私下和別人做什麼，是你自己的事。",shape=box,color=blue];
		j604963129 -> j90648060;
		j604963129 -> j2025979526;
	j2817278650 [label="我……流浪者 — 我知道我不是你接觸過的人當中最容易相處的人最……容易相處的人，為此我會繼續道歉。
",shape=box,color=blue];
		j2817278650 -> j56343605;
	j3628502303 [label="Boolean LyonBackstory2 is now true.",color=orange];
		j3628502303 -> j1661458696;
		j3628502303 -> j3167329253;
	j490650739 [label="算了……我不應感到意外人心善變。尤其是當牽涉我的時候更是如此。",shape=box,color=blue];
		j490650739 -> j1274378319;
		j490650739 -> j4057998964;
	j90648060 [label="我和他們一起……經歷了很多。這往往會拉近人跟人之間的距離。",shape=box,color=red];
		j90648060 -> j4045259015;
	j2025979526 [label=" [表白心意] 說實話，我一直在想該找個時間跟你談談這個話題。",shape=box,color=red];
		j2025979526 -> j70895410;
	j56343605 [label="我就是這樣的人，我不知道該如何改變。事實上，我認為我無力彌補那些惡人對我的靈魂造成的傷害，他們一直糾纏著我。",shape=box,color=blue];
		j56343605 -> j2153734729;
	j1661458696 [label="縱觀歷史，的確如此。",shape=box,color=red];
		j1661458696 -> j586524281;
	j3167329253 [label="我很想多瞭解你的家庭。",shape=box,color=red];
		j3167329253 -> j1213584012;
	j1274378319 [label="等等。你誤會了。我沒有誤導你。事情只是 — 嗯，有點複雜。",shape=box,color=red];
		j1274378319 -> j1205685121;
	j4057998964 [label="我以為你對我沒興趣。",shape=box,color=red];
		j4057998964 -> j3809437744;
	j4045259015 [label="我的祖父母是在高勒革命期間相遇的。戰爭與死亡總像是一對舞伴，以最奇特的方式，引領出一場關於激情與愛戀的共舞。",shape=box,color=blue];
		j4045259015 -> j3628502303;
	j70895410 [label="我現在非常緊張……我可以問是為什麼嗎？",shape=box,color=blue];
		j70895410 -> j2460183349;
		j70895410 -> j463843269;
	j2153734729 [label="在這層破碎的玻璃表面之下隱藏著的是……",shape=box,color=blue];
		j2153734729 -> j3711474839;
		j2153734729 -> j3784927943;
	j586524281 [label="確實。我想我不應該對戰爭的黑暗和破壞所帶來的任何正面影響感到不滿。",shape=box,color=blue];
		j586524281 -> j2133268995;
		j586524281 -> j1767255916;
	j1213584012 [label="我並不喜歡講這個故事。對任何人都不喜歡。所以如果我不太願意分享的話，請你們諒解。或許下次吧。",shape=box,color=blue];
		j1213584012 -> j1121757570;
		j1213584012 -> j1353648214;
	j1205685121 [label="請繼續。",shape=box,color=blue];
		j1205685121 -> j2460183349;
		j1205685121 -> j463843269;
	j3809437744 [label="恕我直言，我並不認識你。而且我身負重任，與陌生人發展戀情也絕非我的首要考量。",shape=box,color=blue];
		j3809437744 -> j2271276013;
	j2460183349 [label="我 — 我們改天再試一次，很抱歉。 ",shape=box,color=red];
		j2460183349 -> j2890848911;
	j463843269 [label="我不確定你是否理解到，或者這聽起來是否很瘋狂，但是 — 對我來說，我……可以同時對不止一個人產生如此強烈的感情。",shape=box,color=red];
		j463843269 -> j2934111586;
	j3711474839 [label="沒關係，里昂。我們慢慢來。相信我，我不急。",shape=box,color=red];
		j3711474839 -> j2885685858;
	j3784927943 [label="是什麼？",shape=box,color=red];
		j3784927943 -> j2774313504;
	j2133268995 [label="你是什麼意思？",shape=box,color=red];
		j2133268995 -> j2902650949;
	j1767255916 [label="你不滿嗎？",shape=box,color=red];
		j1767255916 -> j2499533190;
	j1121757570 [label="我會一直在這裏。",shape=box,color=red];
		j1121757570 -> j2628665450;
	j1353648214 [label="當然。里昂，你隨時都可以說。",shape=box,color=red];
		j1353648214 -> j2441141264;
	j2271276013 [label="我肯定在這樣的情況下，有人會在另一個人的懷抱中找到慰藉，但我不是那些幸運兒之一。",shape=box,color=blue];
		j2271276013 -> j3266066239;
	j2890848911 [label="+20 Chemistry",color=orange];
		j2890848911 -> j3227465846;
	j2934111586 [label="我對你有感覺。但我對他們也有感覺。而對我來說，這兩種感覺都是真的。",shape=box,color=red];
		j2934111586 -> j341853943;
	j2885685858 [label="+20 Chemistry",color=orange];
		j2885685858 -> j3396619495;
	j2774313504 [label="+10 Chemistry",color=orange];
		j2774313504 -> j3277111592;
	j2902650949 [label="原諒我。我並不喜歡講這個故事。對任何人都不喜歡。所以如果我不太願意分享的話，請你們諒解。或許下次吧。",shape=box,color=blue];
		j2902650949 -> j1121757570;
		j2902650949 -> j1353648214;
	j2499533190 [label="不是因為愛不存在……而是我的家庭生活中愛的缺失。原諒我。我並不喜歡講這個故事。對任何人都不喜歡。所以如果我不太願意分享的話，請你們諒解。或許下次吧。",shape=box,color=blue];
		j2499533190 -> j1121757570;
		j2499533190 -> j1353648214;
	j2628665450 [label="+15 Chemistry",color=orange];
		j2628665450 -> j2108409106;
	j2441141264 [label="+20 Chemistry",color=orange];
		j2441141264 -> j3352601115;
	j3266066239 [label="你不妨去找找他們其中一位。祝你今天愉快。",shape=box,color=blue];
		j3266066239 -> j2331496732;
	j3227465846 [label="好的。如果你願意的話，我們可以改日再說此事。在此之前，我將繼續處理我今天的工作。",shape=box,color=blue];
		j3227465846 -> j2331496732;
	j341853943 [label="這種概念對我來說並不像你想的那般陌生。確實，令我躊躇的並非這個概念本身，而是涉及的對象——請別見怪。",shape=box,color=blue];
		j341853943 -> j572721783;
	j3396619495 [label="Boolean LyonVisions3 is now true.",color=orange];
		j3396619495 -> j1413451297;
	j3277111592 [label="對大部份人來說太難承受了。感謝你們繼續去嘗試承受。就這麼多。",shape=box,color=blue];
		j3277111592 -> j2331496732;
	j2108409106 [label="對，我最終還是得出了這個無可避免的結論。祝你今天愉快。",shape=box,color=blue];
		j2108409106 -> j2331496732;
	j3352601115 [label="謝謝。下次再說，祝你今天順利。",shape=box,color=blue];
