		j572721783 -> j428606078;
	j1413451297 [label="謝謝……",shape=box,color=blue];
		j1413451297 -> j2331496732;
	j3933994366 [label="公平地說，我當時並沒有說「立即」。我只是解釋一下。",shape=box,color=red];
		j3933994366 -> j285120448;
	j428606078 [label="所以……你的意思是………我們還有希望？",shape=box,color=red];
		j428606078 -> j2905636711;
	j285120448 [label="+20 Chemistry",color=orange];
		j285120448 -> j2577636823;
	j2905636711 [label="+20 Chemistry",color=orange];
		j2905636711 -> j583776796;
	j2577636823 [label="嗯……如果到有一天我決定我不討厭你的時候，或許我們可以重新開始討論這個問題。",shape=box,color=blue];
		j2577636823 -> j2899248590;
	j583776796 [label="是的……或許吧。如果到有一天我決定我不討厭你的時候。而不過一切有待觀察，漂泊者。",shape=box,color=blue];
		j583776796 -> j2899248590;
	j2899248590 [label="在此之前，我必須繼續履行今天的職責。我很欣賞這次……有趣的談話。我想。",shape=box,color=blue];
