		963 -> 965;
	964 [label="是的……或許吧。如果到有一天我決定我不討厭你的時候。而不過一切有待觀察，漂泊者。",shape=box,color=blue];
		964 -> 965;
	965 [label="在此之前，我必須繼續履行今天的職責。我很欣賞這次……有趣的談話。我想。",shape=box,color=blue];
