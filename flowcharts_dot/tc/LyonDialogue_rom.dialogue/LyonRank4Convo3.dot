digraph {
	871 [label="LyonRank4Convo3 begins.",color=orange];
		871 -> 872;
		871 -> 873;
		871 -> 874;
	872 [label="你跟參研者相處得怎麼樣？",shape=box,color=red];
		872 -> 875;
	873 [label="你覺得 Loid 怎樣？",shape=box,color=red];
		873 -> 876;
	874 [label="[結束]",shape=box,color=red];
		874 -> 877;
	875 [label="我很喜歡聽他們鬥嘴，不過正如你所想，我自己並不參與。我沒什麼好補充的。",shape=box,color=blue];
		875 -> 878;
	876 [label="我覺得他非常討人喜歡。事實上，在我新認識的這些夥伴中，我最喜歡跟他在一起。",shape=box,color=blue];
		876 -> 879;
	877 [label="Chat ends.",color=orange];
	878 [label="不過，當我發現羅瑟站著和鳥三長時間交談時，我感到很擔憂。我不知道他這樣做的目的是什麼。",shape=box,color=blue];
		878 -> 880;
	879 [label="不過我想這大概不會讓任何人感到意外。乍眼一看，我們的個性非常相似。",shape=box,color=blue];
		879 -> 881;
	880 [label="Update boolean LyonRoatheCavia1",color=orange];
		880 -> 882;
		880 -> 883;
	881 [label="It is the young Operator that I find more strange... and the one they call the Lotus. And how we are kept at arms length from them.",shape=box,color=blue];
		881 -> 884;
	882 [label="嗯，我會問問他的。",shape=box,color=red];
		882 -> 885;
	883 [label="你覺得他到底是什麼動機？",shape=box,color=red];
		883 -> 886;
	884 [label="我們可以互動，當然了，不過不是這樣。不是在這裡。為什麼呢？",shape=box,color=blue];
		884 -> 887;
		884 -> 888;
	885 [label="Perhaps that is wise. I would hate to see him manipulate those creatures into being objects of use more than they already have.",shape=box,color=blue];
		885 -> 881;
	886 [label="Roathe always has a motive in mind when he is conversing with anyone. I would hate to see him manipulate those creatures into being objects of use any more than they already have.",shape=box,color=blue];
		886 -> 889;
	887 [label="The kid... has their own nonsense they're going through. We can't ask even more of them. It isn't right.",shape=box,color=red];
		887 -> 890;
	888 [label="我……大概是因為我之前有使用原型 Warframe 的「過往經驗」吧？",shape=box,color=red];
		888 -> 891;
	889 [label="如果你有時間，或許值得調查一下。當然，這完全取決於你自己。",shape=box,color=blue];
		889 -> 881;
	890 [label="Yes. I have heard whispers of what they have been forced to endure. Tales of war and... broken friendship, torn asunder.",shape=box,color=blue];
		890 -> 892;
	891 [label="Check boolean IsDating",color=orange];
		891 -> 894 [label=true,color=green];
		891 -> 893 [label=false,color=brown];
	892 [label="戰爭摧毀了太多東西，讓我心碎。但更讓我感到不可思議的是，戰爭竟然也能創造出新的東西。",shape=box,color=blue];
		892 -> 895;
	894 [label="嗯。現在都這樣叫的嗎？「過往經驗」？真是妙極了。雖然源拓氏似乎把事情搞得一團糟，但我很高興你……找到了自娛的方式。",shape=box,color=blue];
		894 -> 898;
		894 -> 899;
		894 -> 900;
	893 [label="Loid 先生跟我講過你過去在霍爾瓦尼亞（也就是我們的未來）的「不幸遭遇」。源拓氏確實把事情搞得一團糟。",shape=box,color=blue];
		893 -> 896;
		893 -> 897;
	895 [label="Loid 先生跟我講過你過去在霍爾瓦尼亞（也就是我們的未來）的「不幸遭遇」。源拓氏確實把事情搞得一團糟。",shape=box,color=blue];
		895 -> 896;
		895 -> 897;
	898 [label="我做錯什麼了嗎？",shape=box,color=red];
		898 -> 903;
	899 [label="小心點，否則我可能會以為你在想圍牆另一邊的草是不是比較綠一些，牧師。",shape=box,color=red];
		899 -> 904;
	900 [label="里昂，從你口聽起來好像這只是逢場作戲。請不要這樣侮辱我。",shape=box,color=red];
		900 -> 905;
	896 [label="相信我，情況本來可能更差。",shape=box,color=red];
		896 -> 901;
	897 [label="那些原型 Warframe 都是我的好朋友，他們就像是我的家人一樣。",shape=box,color=red];
		897 -> 902;
	903 [label="Check boolean LyonFirstFlirt",color=orange];
		903 -> 908 [label=true,color=green];
		903 -> 909 [label=false,color=brown];
	904 [label="Check boolean LyonFirstFlirt",color=orange];
		904 -> 908 [label=true,color=green];
