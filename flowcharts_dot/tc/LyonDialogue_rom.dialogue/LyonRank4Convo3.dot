	905 [label="Check boolean LyonFirstFlirt",color=orange];
		905 -> 908 [label=true,color=green];
		905 -> 911 [label=false,color=brown];
	901 [label="我深信這一切都是源拓氏宏偉而精妙的計劃。他要將未來的命運託付給你和一群烏合之眾。",shape=box,color=blue];
		901 -> 906;
	902 [label="My grandparents met during the Gaullique Revolution. War and death have always been partners that lead to a dance of camaraderie in the strangest of ways.",shape=box,color=blue];
		902 -> 907;
	908 [label="原諒我。我只是覺得，上次我們討論事情的時候，你……",shape=box,color=blue];
		908 -> 915;
	909 [label="請原諒我。我不了解你的內心也不了解別人的內心。你私下和別人做什麼，是你自己的事。",shape=box,color=blue];
		909 -> 916;
		909 -> 917;
	910 [label="請原諒我。不，你說得對。我並非有意嫉妒也不是想挑釁。你私下和別人做什麼，是你自己的事。",shape=box,color=blue];
		910 -> 916;
		910 -> 917;
	911 [label="當時。請原諒我。我不了解你的內心也不了解別人的內心。你私下和別人做什麼，是你自己的事。",shape=box,color=blue];
		911 -> 916;
		911 -> 917;
	906 [label="我……流浪者 — 我知道我不是你接觸過的人當中最容易相處的人最……容易相處的人，為此我會繼續道歉。
",shape=box,color=blue];
		906 -> 912;
	907 [label="Update boolean LyonBackstory2",color=orange];
		907 -> 913;
		907 -> 914;
	915 [label="算了……我不應感到意外人心善變。尤其是當牽涉我的時候更是如此。",shape=box,color=blue];
		915 -> 921;
		915 -> 922;
	916 [label="我和他們一起……經歷了很多。這往往會拉近人跟人之間的距離。",shape=box,color=red];
		916 -> 923;
	917 [label=" [表白心意] 說實話，我一直在想該找個時間跟你談談這個話題。",shape=box,color=red];
		917 -> 924;
	912 [label="我就是這樣的人，我不知道該如何改變。事實上，我認為我無力彌補那些惡人對我的靈魂造成的傷害，他們一直糾纏著我。",shape=box,color=blue];
		912 -> 918;
	913 [label="縱觀歷史，的確如此。",shape=box,color=red];
		913 -> 919;
	914 [label="我很想多瞭解你的家庭。",shape=box,color=red];
		914 -> 920;
	921 [label="等等。你誤會了。我沒有誤導你。事情只是 — 嗯，有點複雜。",shape=box,color=red];
		921 -> 931;
	922 [label="我以為你對我沒興趣。",shape=box,color=red];
		922 -> 932;
	923 [label="My grandparents met during the Gaullique Revolution. War and death have always been partners in a dance that leads to passion and love in the strangest of ways.",shape=box,color=blue];
		923 -> 907;
	924 [label="我現在非常緊張……我可以問是為什麼嗎？",shape=box,color=blue];
		924 -> 933;
		924 -> 934;
	918 [label="在這層破碎的玻璃表面之下隱藏著的是……",shape=box,color=blue];
		918 -> 925;
		918 -> 926;
	919 [label="確實。我想我不應該對戰爭的黑暗和破壞所帶來的任何正面影響感到不滿。",shape=box,color=blue];
		919 -> 927;
		919 -> 928;
	920 [label="我並不喜歡講這個故事。對任何人都不喜歡。所以如果我不太願意分享的話，請你們諒解。或許下次吧。",shape=box,color=blue];
		920 -> 929;
		920 -> 930;
	931 [label="請繼續。",shape=box,color=blue];
		931 -> 933;
		931 -> 934;
	932 [label="With all do respect, I do not know you. And with all the rest that I have heaped upon me, a romantic endeavor with a stranger is hardly my first priority.",shape=box,color=blue];
		932 -> 941;
	933 [label="我 — 我們改天再試一次，很抱歉。 ",shape=box,color=red];
		933 -> 942;
	934 [label="我不確定你是否理解到，或者這聽起來是否很瘋狂，但是 — 對我來說，我……可以同時對不止一個人產生如此強烈的感情。",shape=box,color=red];
		934 -> 943;
	925 [label="It's all right, Lyon. We'll get there. I'm in no rush, believe me.",shape=box,color=red];
		925 -> 935;
	926 [label="是什麼？",shape=box,color=red];
		926 -> 936;
	927 [label="你是什麼意思？",shape=box,color=red];
		927 -> 937;
	928 [label="你不滿嗎？",shape=box,color=red];
		928 -> 938;
	929 [label="我會一直在這裏。",shape=box,color=red];
		929 -> 939;
	930 [label="當然。里昂，你隨時都可以說。",shape=box,color=red];
		930 -> 940;
	941 [label="我肯定在這樣的情況下，有人會在另一個人的懷抱中找到慰藉，但我不是那些幸運兒之一。",shape=box,color=blue];
		941 -> 948;
	942 [label="+20 Chemistry",color=orange];
		942 -> 949;
	943 [label="我對你有感覺。但我對他們也有感覺。而對我來說，這兩種感覺都是真的。",shape=box,color=red];
		943 -> 950;
	935 [label="+20 Chemistry",color=orange];
		935 -> 944;
	936 [label="+10 Chemistry",color=orange];
		936 -> 945;
	937 [label="原諒我。我並不喜歡講這個故事。對任何人都不喜歡。所以如果我不太願意分享的話，請你們諒解。或許下次吧。",shape=box,color=blue];
		937 -> 929;
		937 -> 930;
	938 [label="Not the existence of love - perhaps the absence of it in my own family life. Forgive me. It is not a tale I enjoy telling. To anyone. So you will forgive me if I am not overeager to share it. Perhaps another time.",shape=box,color=blue];
		938 -> 929;
		938 -> 930;
	939 [label="+15 Chemistry",color=orange];
		939 -> 946;
	940 [label="+20 Chemistry",color=orange];
		940 -> 947;
	948 [label="你不妨去找找他們其中一位。祝你今天愉快。",shape=box,color=blue];
		948 -> 954;
	949 [label="好的。如果你願意的話，我們可以改日再說此事。在此之前，我將繼續處理我今天的工作。",shape=box,color=blue];
		949 -> 954;
	950 [label="Such a concept is not as foreign to my heart as you might think it. Indeed it is not the notion of it that gives me pause as it is the parties involved - no offence.",shape=box,color=blue];
		950 -> 955;
	944 [label="Update boolean LyonVisions3",color=orange];
		944 -> 951;
	945 [label="對大部份人來說太難承受了。感謝你們繼續去嘗試承受。就這麼多。",shape=box,color=blue];
		945 -> 952;
	946 [label="對，我最終還是得出了這個無可避免的結論。祝你今天愉快。",shape=box,color=blue];
		946 -> 953;
	947 [label="謝謝。下次再說，祝你今天順利。",shape=box,color=blue];
		947 -> 953;
	954 [label="-F. Lyon Allard",shape=box,color=blue];
		954 -> 958;
	955 [label="And perhaps how close to our new \"home\" your arrow seeks to fly.",shape=box,color=blue];
		955 -> 959;
		955 -> 960;
	951 [label="謝謝……",shape=box,color=blue];
		951 -> 952;
	952 [label="-F. Lyon Allard",shape=box,color=blue];
		952 -> 956;
	953 [label="-F. Lyon Allard",shape=box,color=blue];
		953 -> 957;
	958 [label="Chat ends.",color=orange];
	959 [label="I wasn't saying \"now,\" to be fair. Just explaining myself.",shape=box,color=red];
