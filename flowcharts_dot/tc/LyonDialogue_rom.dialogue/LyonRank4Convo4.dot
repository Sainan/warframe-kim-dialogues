	j1339328250 [label="+5 Chemistry",color=orange];
		j1339328250 -> j3065285095;
	j4146914402 [label="現在決定好方向了嗎？還是說，你的神經比我更脆弱？",shape=box,color=blue];
		j4146914402 -> j233394710;
		j4146914402 -> j2868225641;
	j323741573 [label="+5 Chemistry",color=orange];
		j323741573 -> j3507885072;
	j3407765562 [label="我往往不確定該如何得體地回應此類情境——無論是對我過往的單純好奇，甚或是……善意的示好。",shape=box,color=blue];
		j3407765562 -> j973113382;
	j326211490 [label="+5 Chemistry",color=orange];
		j326211490 -> j906878768;
	j3065285095 [label="是的，正是這份……情感讓我越來越忐忑不安，我必須承認。為了讓我安心，您的意圖，是否真如我所恐懼的那般？",shape=box,color=blue];
		j3065285095 -> j1131550597;
		j3065285095 -> j1612835614;
	j233394710 [label="很抱歉之前冷落你……",shape=box,color=red];
		j233394710 -> j3248766122;
	j2868225641 [label="你是什麼意思……？",shape=box,color=red];
		j2868225641 -> j3248766122;
	j3507885072 [label="我要說實話……你用的措辭讓我有些不安。雖然我不知道你的意思是否跟我理解的一樣。",shape=box,color=blue];
		j3507885072 -> j1131550597;
		j3507885072 -> j1612835614;
	j973113382 [label="不管怎樣 — 你是在打聽我的過去，對吧？",shape=box,color=blue];
		j973113382 -> j1954929062;
	j1131550597 [label="那我就讓你放心吧 — 我對你沒有任何感覺。",shape=box,color=red];
		j1131550597 -> j3137804683;
	j1612835614 [label="里昂，你就這麼難相信我對你有感覺嗎？",shape=box,color=red];
		j1612835614 -> j3269682069;
	j3248766122 [label="你放棄追求的熱情與你開始追求的熱情一樣高漲。我以為你已經正確地意識到這是一個糟糕的決定。",shape=box,color=blue];
		j3248766122 -> j4160695244;
		j3248766122 -> j172148016;
	j1954929062 [label="你可能已經留意到，我能看見……異象。自我還是個小孩子的時候，這就是我生活的一部分。",shape=box,color=blue];
		j1954929062 -> j2203479060;
	j3137804683 [label="我無意冷落你，但也許釐清彼此的立場是件好事。我……為我如此拙劣的處理方式向你致歉。",shape=box,color=blue];
		j3137804683 -> j3407765562;
	j3269682069 [label="Boolean DrifterLyon is now true.",color=orange];
		j3269682069 -> j554693071;
	j4160695244 [label="你說得對，這一切都是個錯誤。",shape=box,color=red];
		j4160695244 -> j9994260;
	j172148016 [label="我只是不確定我有沒有不請自來。 ",shape=box,color=red];
		j172148016 -> j1090075377;
	j2203479060 [label="這些異象，說得委婉點，往往都不是什麼令人愉快的景象。",shape=box,color=blue];
		j2203479060 -> j1492161892;
		j2203479060 -> j1718088592;
		j2203479060 -> j3520493682;
	j554693071 [label="簡單來說？是的。我……無意拒絕你的好意。我只是……不習慣……被人關愛，漂泊者。不論是哪種形式。",shape=box,color=blue];
		j554693071 -> j2443596458;
	j9994260 [label="我猜也是這樣。因此，我只想祝你今天餘下的時間過得愉快。",shape=box,color=blue];
		j9994260 -> "Chat ends.";
	j1090075377 [label="+5 Chemistry",color=orange];
		j1090075377 -> j12417769;
	j1492161892 [label="你認為這些幻象來自太陰？",shape=box,color=red];
		j1492161892 -> j1555519638;
	j1718088592 [label="具體有什麼？",shape=box,color=red];
		j1718088592 -> j1555519638;
	j3520493682 [label="它們有嚇到你嗎？",shape=box,color=red];
		j3520493682 -> j3972095612;
	j2443596458 [label="如果你心意已決，我不會勸退你。即便……即便這一切讓我感到心神不寧，又……如此陌生。",shape=box,color=blue];
		j2443596458 -> j830693462;
	j12417769 [label="它們並非完全……無法接受，也許？它們只是……令人費解，光是這份心意竟然「存在」的這件事，就足夠讓我困惑了。",shape=box,color=blue];
		j12417769 -> j526001156;
