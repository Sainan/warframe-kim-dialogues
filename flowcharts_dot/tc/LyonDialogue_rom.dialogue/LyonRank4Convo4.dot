		j367054140 -> "Chat ends.";
	j4258126805 [label="恐怕這不是個令人愉快的故事。我曾向你提過那些驅使我前往大教堂侍奉聖光會的幻象，以及在高勒革命期間相遇的祖父母。你確定要將時間揮霍在這種瑣事上嗎？",shape=box,color=blue];
