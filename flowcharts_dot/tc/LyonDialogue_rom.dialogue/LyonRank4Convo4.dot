	977 [label="I fear it is not a terribly pleasant story to tell. I told you of the grandparents who met during the Gaullique Revolution. Are you certain you wish to waste your time with such things?",shape=box,color=blue];
		977 -> 981;
		977 -> 982;
		977 -> 980;
	976 [label="我恐怕這不是什麼令人高興的故事。你確定要把時間浪費在這種事情上嗎？",shape=box,color=blue];
		976 -> 980;
	975 [label="Chat ends.",color=orange];
	981 [label="你為什麼會覺得這是在浪費時間？",shape=box,color=red];
		981 -> 984;
	982 [label="對我來說，這不是浪費時間，里昂。我真的很想更了解你。",shape=box,color=red];
		982 -> 985;
	980 [label="那算了。如果你不想的話。",shape=box,color=red];
		980 -> 983;
	984 [label="I would simply think there are better ways for you to spend your energies. Such as defending some bastion against an encroaching enemy party, discovering unknown knowledge... or sorting clothing.",shape=box,color=blue];
