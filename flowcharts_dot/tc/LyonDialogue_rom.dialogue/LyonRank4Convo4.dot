	"Chat ends." [color=orange];
	j2726806080 [label="你為什麼會覺得這是在浪費時間？",shape=box,color=red];
		j2726806080 -> j2796664521;
	j3293930828 [label="對我來說，這不是浪費時間，里昂。我真的很想更了解你。",shape=box,color=red];
		j3293930828 -> j1584197471;
	j2242908227 [label="那算了。如果你不想的話。",shape=box,color=red];
		j2242908227 -> j906878768;
	j2796664521 [label="我只是認為你完全可以把精力用在更有意義的事情上。例如抵禦入侵堡壘的敵軍、探索未知的知識……抑或是整理衣物。",shape=box,color=blue];
