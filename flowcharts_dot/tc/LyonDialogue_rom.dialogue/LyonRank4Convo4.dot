	j1584197471 [label="Evaluate expressions",color=orange];
		j1584197471 -> j1339328250 [label="LyonFirstFlirt",color=purple];
		j1584197471 -> j4146914402 [label="LyonFlirtIgnored",color=purple];
		j1584197471 -> j323741573 [label="false",color=purple];
	j906878768 [label="不，原諒我。我……為我如此拙劣的應對方式向您致歉。",shape=box,color=blue];
		j906878768 -> j3407765562;
	j1319918369 [label="里昂，如果你希望我離開的話，請直接說。",shape=box,color=red];
