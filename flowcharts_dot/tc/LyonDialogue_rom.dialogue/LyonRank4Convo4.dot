	j2905595770 [label="三個月後，村裡一名婦女被發現死在家中，雙眼被老鼠啃噬清光。",shape=box,color=blue];
		j2905595770 -> j1060170125;
	j160924974 [label="三個月後，村裡一名婦女被發現死在家中，雙眼被老鼠啃噬清光。",shape=box,color=blue];
		j160924974 -> j1344152481;
	j1060170125 [label="我把那天晚上醒來時看到的異象告訴了母親。她也記得我看到的，和我一樣。",shape=box,color=blue];
		j1060170125 -> j2112267674;
		j1060170125 -> j4183191404;
	j1344152481 [label="是的，漂泊者。那些異象嚇到我了。",shape=box,color=blue];
		j1344152481 -> j1060170125;
	j2112267674 [label="她做了什麼？",shape=box,color=red];
		j2112267674 -> j4246210775;
	j4183191404 [label="她當時認為這是巧合，還是某種預兆？",shape=box,color=red];
		j4183191404 -> j1372887184;
	j4246210775 [label="她用藤條鞭笞我，直至我無法站立。我的背脊鮮血淋漓，迫使我夜裡只能俯臥入睡。我至今仍記得她揮打時的尖叫聲——「魔鬼！巫師！」",shape=box,color=blue];
		j4246210775 -> j2378976319;
		j4246210775 -> j2314784198;
		j4246210775 -> j839559093;
		j4246210775 -> j2792455430;
	j1372887184 [label="我不知道。我只知道她用鞭子抽打我直到我再也站不起來。我的背脊鮮血淋漓，迫使我夜裡只能俯臥入睡。我至今仍記得她揮打時的尖叫聲——「魔鬼！巫師！」",shape=box,color=blue];
		j1372887184 -> j2378976319;
		j1372887184 -> j2314784198;
		j1372887184 -> j839559093;
		j1372887184 -> j2792455430;
	j2378976319 [label="你當時幾歲？",shape=box,color=red];
		j2378976319 -> j3099480341;
	j2314784198 [label="噢，里昂……我真的，真的很難過……",shape=box,color=red];
		j2314784198 -> j4100209311;
	j839559093 [label="太可憐了……",shape=box,color=red];
		j839559093 -> j4100209311;
	j2792455430 [label="當時她很無知，她不知道該怎樣處理。",shape=box,color=red];
		j2792455430 -> j4100209311;
	j3099480341 [label="或許四歲吧。最多六歲。我不知道。我們那時候不像你們現在這樣熱衷於記錄過往。",shape=box,color=blue];
		j3099480341 -> j2698478763;
	j4100209311 [label="+5 Chemistry",color=orange];
		j4100209311 -> j2872604088;
	j2698478763 [label="Check boolean LyonPainOff",color=orange];
		j2698478763 -> j3928951485 [label=true,color=green];
		j2698478763 -> j4216614411 [label=false,color=brown];
		j2698478763 -> j3928951485 [label=false,color=brown];
	j2872604088 [label="我們離開故土來這裡的時候，我母親早已過世。如今，她也化作了塵土。她一生飽受苦難……而且注定要將苦難散播下去。",shape=box,color=blue];
		j2872604088 -> j84398978;
	j3928951485 [label="傷害一個孩童……這是不可寬恕的。",shape=box,color=red];
		j3928951485 -> j4100209311;
	j4216614411 [label="所以這就是原因為什麼你……？",shape=box,color=red];
		j4216614411 -> j2933368378;
	j84398978 [label="她很害怕。無論我患了什麼病，無論是神明的重擔，瘋狂，或是詛咒，她都無法應對。",shape=box,color=blue];
		j84398978 -> j2958608658;
	j2933368378 [label="Check boolean LyonLecture2",color=orange];
		j2933368378 -> j454081163 [label=true,color=green];
		j2933368378 -> j727516972 [label=false,color=brown];
	j2958608658 [label="然而，即便我母親再殘忍，也不及我父親。細節我就不贅述了。",shape=box,color=blue];
		j2958608658 -> j388496446;
	j454081163 [label="或許吧。我常常在想，這會不會是某種強迫症的一部分。但正如我之前跟你說過的，這也是太陰的一種方法。",shape=box,color=blue];
		j454081163 -> j1191684597;
	j727516972 [label="或許吧。我常常在想，這會不會是某種強迫症的一部分。但這也是太陰的一種方法。是聖光者的修行方法。我並非唯一實踐這種方法的人。",shape=box,color=blue];
		j727516972 -> j2537642516;
	j388496446 [label="隨著年齡增長，那些異象變成了聲音。那些低語不時在我耳邊響起，無論醒著還是在夢裡。我的農務因此受到影響，而我本身也飽受折磨。",shape=box,color=blue];
		j388496446 -> j272534990;
		j388496446 -> j1295810372;
	j1191684597 [label="+5 Chemistry",color=orange];
		j1191684597 -> j240375100;
	j2537642516 [label="+5 Chemistry",color=orange];
		j2537642516 -> j3325347749;
	j272534990 [label="是什麼讓你參加教會？",shape=box,color=red];
		j272534990 -> j4013567020;
	j1295810372 [label="有些人不配當父母。",shape=box,color=red];
		j1295810372 -> j2698293659;
	j240375100 [label="我向你堅持說明，這件事確實為我帶來了一絲安寧，儘管我也知道，對你而言，這依然顯得有些難以理解。",shape=box,color=blue];
		j240375100 -> j2958608658;
	j3325347749 [label="這是大教堂中另一位神父教給我的，目的是為了協助我……清空思緒。那些被太陰選中的人往往都會有幸被「賜予」這種「幻象」。",shape=box,color=blue];
		j3325347749 -> j141864020;
	j4013567020 [label="Check boolean LyonPainOff",color=orange];
		j4013567020 -> j3394913389 [label=true,color=green];
		j4013567020 -> j800746207 [label=false,color=brown];
	j2698293659 [label="我很感激你的好意，但我亦不能低估我小時候有多難管教，尤其是我比他們更高更強大之後。",shape=box,color=blue];
		j2698293659 -> j4013567020;
	j141864020 [label="Boolean LyonLecture2 is now true.",color=orange];
		j141864020 -> j2958608658;
	j3394913389 [label="漂泊者，我的幻象和聲音常常讓我陷入暴怒發作。折磨自己往往是我唯一能從那些畫面中醒來的方法。",shape=box,color=blue];
		j3394913389 -> j3217518256;
	j800746207 [label="漂泊者，我的幻象和聲音常常讓我陷入暴怒發作。我常常會拿刀割傷自己的軀體，因為只有疼痛才能讓我從痛苦中醒來。",shape=box,color=blue];
		j800746207 -> j3217518256;
	j3217518256 [label="但就在那時候那些聲音指引我到",shape=box,color=blue];
		j3217518256 -> j2184142211;
	j2184142211 [label="我……我做不到。我真的做不到。對不起。我打字的時候雙手都在顫抖。我現在一定要停下來。",shape=box,color=blue];
		j2184142211 -> j1188650744;
		j2184142211 -> j271529009;
	j1188650744 [label="當然。沒關係。不急。我隨時都在這裏，只要你準備好。",shape=box,color=red];
		j1188650744 -> j3147186308;
	j271529009 [label="我知道，這已經太多了。好好休息吧，好嗎？還有……謝謝你。這對我來說很重要。",shape=box,color=red];
		j271529009 -> j927198097;
	j3147186308 [label="+10 Chemistry",color=orange];
		j3147186308 -> j528237742;
	j927198097 [label="+15 Chemistry",color=orange];
		j927198097 -> j3459159343;
	j528237742 [label="謝謝。我再找你。",shape=box,color=blue];
		j528237742 -> j3590718556;
	j3459159343 [label="我想，這對我的意義超過你的想像。朋友，也謝謝你。我們很快再說。",shape=box,color=blue];
		j3459159343 -> j4056626237;
