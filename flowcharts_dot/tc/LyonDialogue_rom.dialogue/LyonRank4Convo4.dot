		1043 -> 1046 [label=true,color=green];
		1043 -> 1045 [label=false,color=brown];
		1043 -> 1046 [label=false,color=brown];
	1044 [label="我們離開故土來這裡的時候，我母親早已過世。如今，她也化作了塵土。她一生飽受苦難……而且注定要將苦難散播下去。",shape=box,color=blue];
		1044 -> 1047;
	1046 [label="傷害一個孩童……這是不可寬恕的。",shape=box,color=red];
		1046 -> 1042;
	1045 [label="所以這就是原因為什麼你……？",shape=box,color=red];
		1045 -> 1048;
	1047 [label="她很害怕。無論我患了什麼病，無論是神明的重擔，瘋狂，或是詛咒，她都無法應對。",shape=box,color=blue];
		1047 -> 1049;
	1048 [label="Check boolean LyonLecture2",color=orange];
		1048 -> 1050 [label=true,color=green];
		1048 -> 1051 [label=false,color=brown];
	1049 [label="然而，即便我母親再殘忍，也不及我父親。細節我就不贅述了。",shape=box,color=blue];
		1049 -> 1052;
	1050 [label="或許吧。我常常在想，這會不會是某種強迫症的一部分。但正如我之前跟你說過的，這也是太陰的一種方法。",shape=box,color=blue];
		1050 -> 1053;
	1051 [label="或許吧。我常常在想，這會不會是某種強迫症的一部分。但這也是太陰的一種方法。是聖光者的修行方法。我並非唯一實踐這種方法的人。",shape=box,color=blue];
		1051 -> 1054;
	1052 [label="隨著年齡增長，那些異象變成了聲音。那些低語不時在我耳邊響起，無論醒著還是在夢裡。我的農務因此受到影響，而我本身也飽受折磨。",shape=box,color=blue];
		1052 -> 1055;
		1052 -> 1056;
	1053 [label="+5 Chemistry",color=orange];
		1053 -> 2233;
	1054 [label="+5 Chemistry",color=orange];
		1054 -> 1058;
	1055 [label="是什麼讓你參加教會？",shape=box,color=red];
		1055 -> 1059;
	1056 [label="有些人不配當父母。",shape=box,color=red];
		1056 -> 1060;
	2233 [label="我向你堅持說明，這件事確實為我帶來了一絲安寧，儘管我也知道，對你而言，這依然顯得有些難以理解。",shape=box,color=blue];
		2233 -> 1049;
	1058 [label="It was taught to me by one of the other Fathers at the Cathedral, to help me... clear my mind. Those who are chosen by Lua are often \"blessed\" by \"visions.\"",shape=box,color=blue];
		1058 -> 1061;
	1059 [label="Check boolean LyonPainOff",color=orange];
		1059 -> 1063 [label=true,color=green];
		1059 -> 1062 [label=false,color=brown];
	1060 [label="我很感激你的好意，但我亦不能低估我小時候有多難管教，尤其是我比他們更高更強大之後。",shape=box,color=blue];
		1060 -> 1059;
	1061 [label="Update boolean LyonLecture2",color=orange];
		1061 -> 1049;
	1063 [label="漂泊者，我的幻象和聲音常常讓我陷入暴怒發作。折磨自己往往是我唯一能從那些畫面中醒來的方法。",shape=box,color=blue];
		1063 -> 1064;
	1062 [label="漂泊者，我的幻象和聲音常常讓我陷入暴怒發作。我常常會拿刀割傷自己的軀體，因為只有疼痛才能讓我從痛苦中醒來。",shape=box,color=blue];
		1062 -> 1064;
	1064 [label="但就在那時候那些聲音指引我到",shape=box,color=blue];
		1064 -> 1065;
	1065 [label="我……我做不到。我真的做不到。對不起。我打字的時候雙手都在顫抖。我現在一定要停下來。",shape=box,color=blue];
		1065 -> 1066;
		1065 -> 1067;
	1066 [label="當然。沒關係。不急。我隨時都在這裏，只要你準備好。",shape=box,color=red];
		1066 -> 1068;
	1067 [label="我知道，這已經太多了。好好休息吧，好嗎？還有……謝謝你。這對我來說很重要。",shape=box,color=red];
		1067 -> 1069;
	1068 [label="+10 Chemistry",color=orange];
		1068 -> 1070;
	1069 [label="+15 Chemistry",color=orange];
		1069 -> 1071;
	1070 [label="謝謝。我再找你。",shape=box,color=blue];
		1070 -> 1072;
	1071 [label="我想，這對我的意義超過你的想像。朋友，也謝謝你。我們很快再說。",shape=box,color=blue];
		1071 -> 1073;
	1072 [label="Update boolean LyonBackstory3b",color=orange];
