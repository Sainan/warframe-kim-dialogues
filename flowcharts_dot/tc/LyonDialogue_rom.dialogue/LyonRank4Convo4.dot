	1008 [label="具體有什麼？",shape=box,color=red];
		1008 -> 1013;
	1009 [label="它們有嚇到你嗎？",shape=box,color=red];
		1009 -> 1014;
	1017 [label="If you are set upon this path, I shall not deter you and I... I have found as unsettled and... foreign to me as this is?",shape=box,color=blue];
		1017 -> 1021;
	1015 [label="Chat ends.",color=orange];
	1016 [label="They are not... unwelcome, per se? They simply are... perplexing, in the fact that they exist at all.",shape=box,color=blue];
		1016 -> 1020;
		1016 -> 1001;
	1013 [label="I once awoke in the middle of the night to the visage of an old woman sitting at the foot of my bed.",shape=box,color=blue];
		1013 -> 1018;
	1014 [label="I once awoke in the middle of the night to the visage of an old woman sitting at the foot of my bed.",shape=box,color=blue];
		1014 -> 1019;
	1021 [label="+5 Chemistry",color=orange];
		1021 -> 1025;
	1020 [label="你希望我停下嗎？",shape=box,color=red];
		1020 -> 1024;
	1018 [label="So thin and frail that she might have already been dead and buried for years, her skin clung to her bones so tight that I could see the spaces between them.",shape=box,color=blue];
		1018 -> 1022;
	1019 [label="So thin and frail that she might have already been dead and buried for years, her skin clung to her bones so tight that I could see the spaces between them.",shape=box,color=blue];
		1019 -> 1023;
	1025 [label="I am... perhaps, cautiously hopeful to see where this new path leads. However - you were enquiring as to my past, yes?",shape=box,color=blue];
		1025 -> 1028;
	1024 [label="No, I... do not mean to rebuff your efforts. I am simply... unaccustomed... to affection, Drifter. Of any sort.",shape=box,color=blue];
		1024 -> 1017;
	1022 [label="Her hair was barely more than a few wisps of white that hung limply from her head. But it was her eyes that I will remember most. ",shape=box,color=blue];
		1022 -> 1026;
	1023 [label="Her hair was barely more than a few wisps of white that hung limply from her head. But it was her eyes that I will remember most. ",shape=box,color=blue];
		1023 -> 1027;
	1028 [label="Update boolean LyonFlirt2",color=orange];
		1028 -> 998;
	1026 [label="For she had none at all.",shape=box,color=blue];
		1026 -> 1029;
	1027 [label="For she had none at all.",shape=box,color=blue];
		1027 -> 1030;
	1029 [label="Three months later, a woman in the village was discovered dead in her home. Her eyes, devoured by rats.",shape=box,color=blue];
		1029 -> 1031;
	1030 [label="三個月後，村裡一名婦女被發現死在家中，雙眼被老鼠啃噬清光。",shape=box,color=blue];
		1030 -> 1032;
	1031 [label="我把那天晚上醒來時看到的異象告訴了母親。她也記得我看到的，和我一樣。",shape=box,color=blue];
		1031 -> 1033;
		1031 -> 1034;
	1032 [label="是的，漂泊者。那些異象嚇到我了。",shape=box,color=blue];
		1032 -> 1031;
	1033 [label="她做了什麼？",shape=box,color=red];
		1033 -> 1035;
	1034 [label="她當時認為這是巧合，還是某種預兆？",shape=box,color=red];
		1034 -> 1036;
	1035 [label="She beat me with a switch until I could no longer stand. My back would bleed until I would be forced to sleep lying face down. I still recall her screams as she would strike me. \"Diable ! Sorcier !\"",shape=box,color=blue];
		1035 -> 1037;
		1035 -> 1038;
		1035 -> 1039;
		1035 -> 1040;
	1036 [label="I do not know. All I know is she beat me with a switch until I could not longer stand. My back would bleed until I would be forced to sleep lying face down. I still recall her screams as she would strike me. \"Diable ! Sorcier !\"",shape=box,color=blue];
		1036 -> 1037;
		1036 -> 1038;
		1036 -> 1039;
		1036 -> 1040;
	1037 [label="你當時幾歲？",shape=box,color=red];
		1037 -> 1041;
	1038 [label="噢，里昂……我真的，真的很難過……",shape=box,color=red];
		1038 -> 1042;
	1039 [label="太可憐了……",shape=box,color=red];
		1039 -> 1042;
	1040 [label="當時她很無知，她不知道該怎樣處理。",shape=box,color=red];
		1040 -> 1042;
	1041 [label="或許四歲吧。最多六歲。我不知道。我們那時候不像你們現在這樣熱衷於記錄過往。",shape=box,color=blue];
		1041 -> 1043;
