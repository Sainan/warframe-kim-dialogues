	j526001156 [label="你希望我停下嗎？",shape=box,color=red];
		j526001156 -> j2081339347;
	j2427229626 [label="她瘦骨嶙峋和如此虛弱，彷彿早已死去並埋葬多年。她的皮膚緊緊吸附著骨架，緊繃到我甚至能看清骨骼之間的空隙。",shape=box,color=blue];
		j2427229626 -> j4079241689;
	j2165847856 [label="她瘦骨嶙峋和如此虛弱，彷彿早已死去並埋葬多年。她的皮膚緊緊吸附著骨架，緊繃到我甚至能看清骨骼之間的空隙。",shape=box,color=blue];
		j2165847856 -> j47246047;
	j3707274152 [label="我也許……懷著一點點謹慎的希望，想看看這條路會通往哪裡。不過——你剛才問起了我的過去，對吧？",shape=box,color=blue];
		j3707274152 -> j3332795835;
	j2081339347 [label="不。我……無意拒絕你的好意。我只是……不習慣……被人關愛，漂泊者。不論是哪種形式。",shape=box,color=blue];
		j2081339347 -> j2443596458;
	j4079241689 [label="她的頭髮稀疏得只剩幾絲白髮……死氣沉沉地掛在頭上。但真正讓我忘不掉的，是她的眼睛。",shape=box,color=blue];
		j4079241689 -> j3365656368;
	j47246047 [label="她的頭髮稀疏得只剩幾絲白髮……死氣沉沉地掛在頭上。但真正讓我忘不掉的，是她的眼睛。",shape=box,color=blue];
