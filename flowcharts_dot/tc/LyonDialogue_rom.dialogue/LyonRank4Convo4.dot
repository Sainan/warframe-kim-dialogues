		973 -> 975;
	979 [label="I fear it is not a terribly pleasant story to tell. I told you of the visions that sent me to the Cathedral to worship the Luminaries, and the grandparents who met during the Gaullique Revolution. Are you certain you wish to waste your time with such things?",shape=box,color=blue];
