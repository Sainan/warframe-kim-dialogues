	989 [label="現在決定好方向了嗎？還是說，你的神經比我更脆弱？",shape=box,color=blue];
		989 -> 994;
		989 -> 995;
	990 [label="+5 Chemistry",color=orange];
		990 -> 996;
	986 [label="I am not quite often certain how one is to properly respond in situations such as simple curiosity over one's history - or even benign expressions of friendship.",shape=box,color=blue];
		986 -> 992;
	993 [label="+5 Chemistry",color=orange];
		993 -> 983;
	997 [label="Yes, and it is this... sentiment that makes me increasingly trepidatious, I must admit. For my peace of mind, simply confirm for me that you mean what I am more and more increasingly fear you might.",shape=box,color=blue];
		997 -> 1000;
		997 -> 1001;
	994 [label="很抱歉之前冷落你……",shape=box,color=red];
		994 -> 999;
	995 [label="你是什麼意思……？",shape=box,color=red];
		995 -> 999;
	996 [label="我要說實話……你用的措辭讓我有些不安。雖然我不知道你的意思是否跟我理解的一樣。",shape=box,color=blue];
		996 -> 1000;
		996 -> 1001;
	992 [label="不管怎樣 — 你是在打聽我的過去，對吧？",shape=box,color=blue];
		992 -> 998;
	1000 [label="那我就讓你放心吧 — 我對你沒有任何感覺。",shape=box,color=red];
		1000 -> 1005;
	1001 [label="里昂，你就這麼難相信我對你有感覺嗎？",shape=box,color=red];
		1001 -> 1006;
	999 [label="You abandoned the pursuit with as much fervor as you began it. I assumed you had rightly decided it was a poor decision.",shape=box,color=blue];
		999 -> 1003;
		999 -> 1004;
	998 [label="你可能已經留意到，我能看見……異象。自我還是個小孩子的時候，這就是我生活的一部分。",shape=box,color=blue];
		998 -> 1002;
	1005 [label="I did not mean to rebuff you, but it is good to know where we stand. I... apologize for how poorly I am handling all this.",shape=box,color=blue];
		1005 -> 986;
	1006 [label="Update boolean DrifterLyon",color=orange];
		1006 -> 1012;
	1003 [label="你說得對，這一切都是個錯誤。",shape=box,color=red];
		1003 -> 1010;
	1004 [label="我只是不確定我有沒有不請自來。 ",shape=box,color=red];
		1004 -> 1011;
	1002 [label="這些異象，說得委婉點，往往都不是什麼令人愉快的景象。",shape=box,color=blue];
		1002 -> 1007;
		1002 -> 1008;
		1002 -> 1009;
	1012 [label="Simply put? Well, yes. I... do not mean to rebuff your efforts. I am simply... unaccustomed... to affection, Drifter. Of any sort.",shape=box,color=blue];
		1012 -> 1017;
	1010 [label="I thought as much. I will therefore simply wish you a good rest of your day.",shape=box,color=blue];
		1010 -> 1015;
	1011 [label="+5 Chemistry",color=orange];
		1011 -> 1016;
	1007 [label="And you think the visions came from Lua?",shape=box,color=red];
