	507 [label="-里昂・阿拉德神父",shape=box,color=blue];
		507 -> 513;
	503 [label="我願意替她承受那份痛苦，我會把它刻進我的靈魂。但這是她要面對的，她一人。",shape=box,color=blue];
		503 -> 508;
	504 [label="你要記得他的成長背景，記得他為了生存而必須學習的環境。他過去是 — 現在也是 — Orokin 人。",shape=box,color=red];
		504 -> 509;
		504 -> 510;
	505 [label="老實說我覺得他沒那麼差。我越來越喜歡他了。",shape=box,color=red];
		505 -> 511;
	506 [label="Update boolean LyonVisions1",color=orange];
		506 -> 512;
	513 [label="Chat ends.",color=orange];
	508 [label="所以，漂泊者，我會努力避免這種痛苦。 ",shape=box,color=blue];
		508 -> 514;
	509 [label="這並不代表他的所作所為是對的，但或許能幫助你瞭解他更多。",shape=box,color=red];
