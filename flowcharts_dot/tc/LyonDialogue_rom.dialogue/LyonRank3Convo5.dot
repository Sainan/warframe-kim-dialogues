		470 -> 478 [label=false,color=brown];
	472 [label="如果這句話是真的話，你會怎麼看，漂泊者？",shape=box,color=blue];
		472 -> 480;
	473 [label="「然後，」就沒了。我已經把我親眼目睹的事件經過告訴了你，這就是我親身經歷的真相。就這樣而已。",shape=box,color=blue];
		473 -> 469;
	474 [label="瑪麗並不了解源拓氏的真實面目，以及他以「進步」和現在的「救贖」之名所做的所有可怕的勾當。",shape=box,color=red];
		474 -> 481;
	475 [label="瑪麗是個成年女性。我明白你想保護她的心情，但她有權利自己決定要相信什麼，以及相信誰。",shape=box,color=red];
		475 -> 482;
	471 [label="玷污我們的身體，摧毀我們的未來，腐蝕我們的過去 ─ 這一切，或許我都能原諒。",shape=box,color=blue];
		471 -> 479;
	476 [label="源拓氏或許不擅長待人接物但他正在努力拯救宇宙。",shape=box,color=red];
		476 -> 471;
	477 [label="他是否強迫你成為像羅瑟那樣的原型 Warframe？",shape=box,color=red];
		477 -> 483;
