digraph {
	445 [label="LyonRank3Convo5 begins.",color=orange];
		445 -> 446;
	446 [label="「日曜主教」來到我們這裡的那晚正值雷雨交加。他站在教堂的聖殿，絲毫沒有受到外頭狂風暴雨的影響。",shape=box,color=blue];
		446 -> 447;
	447 [label="這本應是令我感到擔憂的第一個原因。但我卻向他低頭，像迎接聖母派來的任何一位新使者一樣向他問好。",shape=box,color=blue];
		447 -> 448;
	448 [label="畢竟，自從上一位主教幾個月前因病離職後，我們就一直在期待一位新的主教到來。",shape=box,color=blue];
		448 -> 449;
	449 [label="日曜主教笑著跟我用力地握手。我問他旅途是否漫長。他的回答我永遠不會忘記。",shape=box,color=blue];
		449 -> 450;
	450 [label="「雖然很艱難……但時間並不長。」",shape=box,color=blue];
		450 -> 451;
	451 [label="當時我感到很困惑，還有他那件非常乾的外套也令我想不明白。但我沒太在意，就像所有人面對不尋常的事情時都會有的反應。",shape=box,color=blue];
		451 -> 452;
	452 [label="我當時還來不及細想，瑪麗就趕急地趕來了。",shape=box,color=blue];
		452 -> 453;
	453 [label="他單膝跪地，跟坐在椅子上的她平視，握住了她的手。我當時就應該看穿他的伎倆。",shape=box,color=blue];
		453 -> 454;
	454 [label="畢竟，他可並不是唯一一個在暴風雨中來到我們家門口的魔鬼。",shape=box,color=blue];
		454 -> 455;
	455 [label="Update boolean LyonEntrati1",color=orange];
		455 -> 456;
	456 [label="Check boolean MarieEntrati1",color=orange];
		456 -> 457 [label=true,color=green];
		456 -> 459 [label=true,color=green];
		456 -> 460 [label=true,color=green];
		456 -> 458 [label=false,color=brown];
		456 -> 457 [label=false,color=brown];
	457 [label="另一個惡魔是羅瑟嗎？",shape=box,color=red];
		457 -> 461;
	459 [label="她講這個故事的內容完全不同。",shape=box,color=red];
		459 -> 463;
	460 [label="她依然相信他的本意是好的。你信嗎？",shape=box,color=red];
		460 -> 464;
	458 [label="看來你不是源拓氏的盟友？",shape=box,color=red];
		458 -> 462;
	461 [label="是的。不過那就是另一個故事了。如果我開始討論他，我原本就糟糕的心情會變得更加……",shape=box,color=blue];
		461 -> 465;
	463 [label="是的，她會。",shape=box,color=blue];
		463 -> 467;
		463 -> 468;
	464 [label="+5 Chemistry",color=orange];
		464 -> 469;
	462 [label="在忍受了他的謊言和背叛之後，而我們繼續承受他對瑪麗的操縱，你希望我屈服嗎？不，我絕對不會。",shape=box,color=blue];
		462 -> 466;
	465 [label="……站不住腳。如果你不介意的話，我更願意把注意力集中在源拓氏的惡行上。",shape=box,color=blue];
		465 -> 470;
	467 [label="她告訴我有時候你可以看到別人看不到的東西。",shape=box,color=red];
		467 -> 472;
	468 [label="然後呢？",shape=box,color=red];
		468 -> 473;
	469 [label="瑪麗相信人本善。這是她不斷磨練精進和完善的技能，以此作為抵禦周遭世界的保護網。",shape=box,color=blue];
		469 -> 474;
		469 -> 475;
	466 [label="+5 Chemistry",color=orange];
		466 -> 471;
