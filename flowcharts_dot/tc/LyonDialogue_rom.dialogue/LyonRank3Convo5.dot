	481 [label="信任就像一扇彩色玻璃窗。製作精巧，絢麗奪目；破碎時令人扼腕嘆息；一旦破損便非常危險。",shape=box,color=blue];
		481 -> 496;
	482 [label="信任就像一扇彩色玻璃窗。製作精巧，絢麗奪目；破碎時令人扼腕嘆息；一旦破損便非常危險。",shape=box,color=blue];
		482 -> 491;
	479 [label="但看看他是如何扭曲瑪麗的……利用她相信人本善來達到自己的目的？",shape=box,color=blue];
		479 -> 485;
	483 [label="不。我接受那血清自有我的理由。我知道它會把我變成何等變態的怪物。瑪麗也知道。",shape=box,color=blue];
		483 -> 492;
	484 [label="+5 Chemistry",color=orange];
		484 -> 471;
	486 [label="我想其實我都不太在乎吧？",shape=box,color=red];
		486 -> 493;
	488 [label="我唯一的問題是，如果你能看到幻象的話，這些幻象會讓你感到困擾嗎？",shape=box,color=red];
		488 -> 495;
	489 [label="你前幾天說的話 — 讓我有點擔心你是不是出了什麼事。",shape=box,color=red];
		489 -> 494;
	487 [label="我只是想知道你是否一切安好。",shape=box,color=red];
		487 -> 494;
	496 [label="+15 Chemistry",color=orange];
		496 -> 502;
	491 [label="在太陽溫暖的光芒中，她沐浴在陽光下，看不見太陽表面形成的裂痕。聽不見越來越深的裂縫。",shape=box,color=blue];
		491 -> 497;
	485 [label="這件事，我永不會原諒。我要用我的香爐將鞭打他直到他乞求救贖為止。",shape=box,color=blue];
		485 -> 474;
		485 -> 475;
	492 [label="我們並非資…像魔鬼那樣被強行摧毀。我同情羅瑟所遭受的一切。",shape=box,color=blue];
		492 -> 498;
	493 [label="那我認為沒有必要繼續這個話題了。",shape=box,color=blue];
		493 -> 499;
	495 [label="我老實說我不知道該如何回答這個問題，漂泊者。",shape=box,color=blue];
		495 -> 501;
	494 [label="Update boolean LyonAllRight",color=orange];
		494 -> 500;
	502 [label="我希望能將他植入到她腦中的腐敗思想去除。我只能祈求你能在我失敗的地方取得成功。",shape=box,color=blue];
		502 -> 507;
	497 [label="她渾然不知，自己一手打造的傑作的碎片很快就會被用來對付她。她選擇對即將到來的災難視而不見。",shape=box,color=blue];
		497 -> 503;
	498 [label="然後他張開嘴說話。",shape=box,color=blue];
		498 -> 504;
		498 -> 505;
	499 [label="Chat ends.",color=orange];
	501 [label="這麼多年來，我目睹過無數足以把其他人送進精神病院的恐怖景象。更悲慘的是，我的預言有時會變成現實。",shape=box,color=blue];
		501 -> 506;
	500 [label="我是否「一切安好」？我老實說我不知道該如何回答這個問題，漂泊者。",shape=box,color=blue];
