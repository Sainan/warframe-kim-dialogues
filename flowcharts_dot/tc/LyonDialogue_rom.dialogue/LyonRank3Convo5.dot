digraph {
	"LyonRank3Convo5 begins." [color=orange];
		"LyonRank3Convo5 begins." -> j2740907723;
	j2740907723 [label="「日曜主教」來到我們這裡的那晚正值雷雨交加。他站在教堂的聖殿，絲毫沒有受到外頭狂風暴雨的影響。",shape=box,color=blue];
		j2740907723 -> j1838156479;
	j1838156479 [label="這本應是令我感到擔憂的第一個原因。但我卻向他低頭，像迎接聖母派來的任何一位新使者一樣向他問好。",shape=box,color=blue];
		j1838156479 -> j3036152681;
	j3036152681 [label="畢竟，自從上一位主教幾個月前因病離職後，我們就一直在期待一位新的主教到來。",shape=box,color=blue];
		j3036152681 -> j1009804788;
	j1009804788 [label="日曜主教笑著跟我用力地握手。我問他旅途是否漫長。他的回答我永遠不會忘記。",shape=box,color=blue];
		j1009804788 -> j3583659560;
	j3583659560 [label="「雖然很艱難……但時間並不長。」",shape=box,color=blue];
		j3583659560 -> j723507227;
	j723507227 [label="當時我感到很困惑，還有他那件非常乾的外套也令我想不明白。但我沒太在意，就像所有人面對不尋常的事情時都會有的反應。",shape=box,color=blue];
		j723507227 -> j4288765233;
	j4288765233 [label="我當時還來不及細想，瑪麗就趕急地趕來了。",shape=box,color=blue];
		j4288765233 -> j2770210336;
	j2770210336 [label="他單膝跪地，跟坐在椅子上的她平視，握住了她的手。我當時就應該看穿他的伎倆。",shape=box,color=blue];
		j2770210336 -> j80687354;
	j80687354 [label="畢竟，他可並不是唯一一個在暴風雨中來到我們家門口的魔鬼。",shape=box,color=blue];
		j80687354 -> j1928339452;
	j1928339452 [label="Boolean LyonEntrati1 is now true.",color=orange];
		j1928339452 -> j2100050873;
	j2100050873 [label="Check boolean MarieEntrati1",color=orange];
		j2100050873 -> j3233121399 [label=true,color=green];
		j2100050873 -> j2950911147 [label=true,color=green];
		j2100050873 -> j3879117638 [label=true,color=green];
		j2100050873 -> j3232876657 [label=false,color=brown];
		j2100050873 -> j3233121399 [label=false,color=brown];
	j3233121399 [label="另一個惡魔是羅瑟嗎？",shape=box,color=red];
		j3233121399 -> j587931830;
	j2950911147 [label="她講這個故事的內容完全不同。",shape=box,color=red];
		j2950911147 -> j1723258583;
	j3879117638 [label="她依然相信他的本意是好的。你信嗎？",shape=box,color=red];
		j3879117638 -> j4024844253;
	j3232876657 [label="看來你不是源拓氏的盟友？",shape=box,color=red];
		j3232876657 -> j1277796704;
	j587931830 [label="是的。不過那就是另一個故事了。如果我開始討論他，我原本就糟糕的心情會變得更加……",shape=box,color=blue];
		j587931830 -> j3472419988;
	j1723258583 [label="是的，她會。",shape=box,color=blue];
		j1723258583 -> j2816725715;
		j1723258583 -> j1989556881;
	j4024844253 [label="+5 Chemistry",color=orange];
		j4024844253 -> j3991165231;
	j1277796704 [label="在忍受了他的謊言和背叛之後，而我們繼續承受他對瑪麗的操縱，你希望我屈服嗎？不，我絕對不會。",shape=box,color=blue];
		j1277796704 -> j3102856610;
	j3472419988 [label="……站不住腳。如果你不介意的話，我更願意把注意力集中在源拓氏的惡行上。",shape=box,color=blue];
		j3472419988 -> j1428371468;
	j2816725715 [label="她告訴我有時候你可以看到別人看不到的東西。",shape=box,color=red];
		j2816725715 -> j2019388870;
	j1989556881 [label="然後呢？",shape=box,color=red];
		j1989556881 -> j2542375447;
	j3991165231 [label="瑪麗相信人本善。這是她不斷磨練精進和完善的技能，以此作為抵禦周遭世界的保護網。",shape=box,color=blue];
		j3991165231 -> j469544139;
		j3991165231 -> j238265692;
	j3102856610 [label="+5 Chemistry",color=orange];
		j3102856610 -> j722461273;
	j1428371468 [label="Check boolean RoatheSerum1",color=orange];
		j1428371468 -> j3147957574 [label=true,color=green];
		j1428371468 -> j2560205531 [label=true,color=green];
		j1428371468 -> j3147957574 [label=false,color=brown];
		j1428371468 -> j796192885 [label=false,color=brown];
	j2019388870 [label="如果這句話是真的話，你會怎麼看，漂泊者？",shape=box,color=blue];
		j2019388870 -> j2821822155;
	j2542375447 [label="「然後，」就沒了。我已經把我親眼目睹的事件經過告訴了你，這就是我親身經歷的真相。就這樣而已。",shape=box,color=blue];
		j2542375447 -> j3991165231;
	j469544139 [label="瑪麗並不了解源拓氏的真實面目，以及他以「進步」和現在的「救贖」之名所做的所有可怕的勾當。",shape=box,color=red];
		j469544139 -> j2998106100;
	j238265692 [label="瑪麗是個成年女性。我明白你想保護她的心情，但她有權利自己決定要相信什麼，以及相信誰。",shape=box,color=red];
		j238265692 -> j19060218;
	j722461273 [label="玷污我們的身體，摧毀我們的未來，腐蝕我們的過去 ─ 這一切，或許我都能原諒。",shape=box,color=blue];
		j722461273 -> j3902197238;
	j3147957574 [label="源拓氏或許不擅長待人接物但他正在努力拯救宇宙。",shape=box,color=red];
		j3147957574 -> j722461273;
	j2560205531 [label="他是否強迫你成為像羅瑟那樣的原型 Warframe？",shape=box,color=red];
		j2560205531 -> j2854947468;
	j796192885 [label="當然。為什麼對源拓氏感到不滿？",shape=box,color=red];
		j796192885 -> j3102856610;
	j2821822155 [label="Check boolean LyonVisions1",color=orange];
		j2821822155 -> j696594256 [label=true,color=green];
		j2821822155 -> j2045557007 [label=true,color=green];
		j2821822155 -> j325155570 [label=true,color=green];
		j2821822155 -> j696594256 [label=false,color=brown];
		j2821822155 -> j722176165 [label=false,color=brown];
		j2821822155 -> j2045557007 [label=false,color=brown];
	j2998106100 [label="信任就像一扇彩色玻璃窗。製作精巧，絢麗奪目；破碎時令人扼腕嘆息；一旦破損便非常危險。",shape=box,color=blue];
		j2998106100 -> j2721549766;
	j19060218 [label="信任就像一扇彩色玻璃窗。製作精巧，絢麗奪目；破碎時令人扼腕嘆息；一旦破損便非常危險。",shape=box,color=blue];
		j19060218 -> j937411670;
	j3902197238 [label="但看看他是如何扭曲瑪麗的……利用她相信人本善來達到自己的目的？",shape=box,color=blue];
		j3902197238 -> j2405715131;
	j2854947468 [label="不。我接受那血清自有我的理由。我知道它會把我變成何等變態的怪物。瑪麗也知道。",shape=box,color=blue];
		j2854947468 -> j483028651;
	j696594256 [label="我想其實我都不太在乎吧？",shape=box,color=red];
		j696594256 -> j2013551396;
	j2045557007 [label="我唯一的問題是，如果你能看到幻象的話，這些幻象會讓你感到困擾嗎？",shape=box,color=red];
		j2045557007 -> j3080584849;
	j325155570 [label="你前幾天說的話 — 讓我有點擔心你是不是出了什麼事。",shape=box,color=red];
		j325155570 -> j45669781;
	j722176165 [label="我只是想知道你是否一切安好。",shape=box,color=red];
		j722176165 -> j45669781;
	j2721549766 [label="+15 Chemistry",color=orange];
		j2721549766 -> j1298468342;
	j937411670 [label="在太陽溫暖的光芒中，她沐浴在陽光下，看不見太陽表面形成的裂痕。聽不見越來越深的裂縫。",shape=box,color=blue];
		j937411670 -> j585227172;
	j2405715131 [label="這件事，我永不會原諒。我要用我的香爐將鞭打他直到他乞求救贖為止。",shape=box,color=blue];
		j2405715131 -> j469544139;
		j2405715131 -> j238265692;
	j483028651 [label="我們並非資…像魔鬼那樣被強行摧毀。我同情羅瑟所遭受的一切。",shape=box,color=blue];
		j483028651 -> j3840688345;
	j2013551396 [label="那我認為沒有必要繼續這個話題了。",shape=box,color=blue];
		j2013551396 -> "Chat ends.";
	j3080584849 [label="我老實說我不知道該如何回答這個問題，漂泊者。",shape=box,color=blue];
		j3080584849 -> j3309593915;
	j45669781 [label="Boolean LyonAllRight is now true.",color=orange];
		j45669781 -> j3009352217;
	j1298468342 [label="我希望能將他植入到她腦中的腐敗思想去除。我只能祈求你能在我失敗的地方取得成功。",shape=box,color=blue];
		j1298468342 -> j2331496732;
	j585227172 [label="她渾然不知，自己一手打造的傑作的碎片很快就會被用來對付她。她選擇對即將到來的災難視而不見。",shape=box,color=blue];
		j585227172 -> j3512722404;
	j3840688345 [label="然後他張開嘴說話。",shape=box,color=blue];
		j3840688345 -> j3390131125;
		j3840688345 -> j1288323854;
	"Chat ends." [color=orange];
	j3309593915 [label="這麼多年來，我目睹過無數足以把其他人送進精神病院的恐怖景象。更悲慘的是，我的預言有時會變成現實。",shape=box,color=blue];
		j3309593915 -> j397947900;
	j3009352217 [label="我是否「一切安好」？我老實說我不知道該如何回答這個問題，漂泊者。",shape=box,color=blue];
		j3009352217 -> j3309593915;
	j2331496732 [label="-里昂・阿拉德神父",shape=box,color=blue];
		j2331496732 -> "Chat ends.";
	j3512722404 [label="我願意替她承受那份痛苦，我會把它刻進我的靈魂。但這是她要面對的，她一人。",shape=box,color=blue];
		j3512722404 -> j306741984;
	j3390131125 [label="你要記得他的成長背景，記得他為了生存而必須學習的環境。他過去是 — 現在也是 — Orokin 人。",shape=box,color=red];
		j3390131125 -> j1444216994;
		j3390131125 -> j1528272030;
	j1288323854 [label="老實說我覺得他沒那麼差。我越來越喜歡他了。",shape=box,color=red];
		j1288323854 -> j508581762;
	j397947900 [label="Boolean LyonVisions1 is now true.",color=orange];
		j397947900 -> j1609662052;
	j306741984 [label="所以，漂泊者，我會努力避免這種痛苦。 ",shape=box,color=blue];
		j306741984 -> j3924855534;
	j1444216994 [label="這並不代表他的所作所為是對的，但或許能幫助你瞭解他更多。",shape=box,color=red];
		j1444216994 -> j3036613956;
	j1528272030 [label="他在做他認為自己要做的事。",shape=box,color=red];
		j1528272030 -> j4286176778;
	j508581762 [label="我打算去找 Loid 先生拿點藥膏治療這種病。免得病情擴散。",shape=box,color=blue];
		j508581762 -> j2230654291;
		j508581762 -> j4261682057;
	j1609662052 [label="Boolean LyonBackstory1 is now true.",color=orange];
		j1609662052 -> j3688030377;
	j3924855534 [label="如果你有任何貶低她的行為？",shape=box,color=blue];
		j3924855534 -> j3530026162;
	j3036613956 [label="Add 1 to Thermostat counter",color=orange];
		j3036613956 -> j1367289321;
	j4286176778 [label="Add -1 to Thermostat counter",color=orange];
		j4286176778 -> j3258675587;
	j2230654291 [label="那魔鬼總有一種他獨特的魅力。",shape=box,color=red];
		j2230654291 -> j2037302876;
	j4261682057 [label="不用擔心，我不會給他的魅力所迷惑。",shape=box,color=red];
		j4261682057 -> j3737538692;
	j3688030377 [label="因此，我當時認為這是太陰的指引，是聖光會選中我來承擔這份重任。至少我當時是這麼認為的。這就是我想成為神父的原因。",shape=box,color=blue];
		j3688030377 -> j1984162203;
		j3688030377 -> j1758553237;
		j3688030377 -> j4084145728;
	j3530026162 [label="願太陰憐憫你的靈魂。",shape=box,color=blue];
		j3530026162 -> j2331496732;
	j1367289321 [label="我們的經文教導我們不要跟魔鬼談判，而是要驅逐他們。但他們並沒有讓我們為這種情況做好準備。",shape=box,color=blue];
		j1367289321 -> j3535448532;
	j3258675587 [label="或許吧。我還不能確定那生物心中是否全無疑慮。",shape=box,color=blue];
		j3258675587 -> j3535448532;
	j2037302876 [label="Add -1 to Thermostat counter",color=orange];
		j2037302876 -> j3427608939;
	j3737538692 [label="Add 1 to Thermostat counter",color=orange];
		j3737538692 -> j3440069485;
	j1984162203 [label="你之前認為那些幻像是來自太陰？現在你不這麼認為了？",shape=box,color=red];
		j1984162203 -> j824441052;
	j1758553237 [label="是什麼樣的恐怖景象……？",shape=box,color=red];
		j1758553237 -> j2683643145;
	j4084145728 [label="那你現在怎麼想？",shape=box,color=red];
		j4084145728 -> j4174987026;
	j3535448532 [label="我們很快就會看到那個那魔鬼會選擇走哪條路，不是嗎？",shape=box,color=blue];
		j3535448532 -> j1144920832;
	j3427608939 [label="而這正是令我困惑的地方。當所有人都在胡言亂語時，魔鬼卻面帶微笑，說出合乎情理的話語 ",shape=box,color=blue];
		j3427608939 -> j4065509553;
	j3440069485 [label="+20 Chemistry",color=orange];
		j3440069485 -> j1337389917;
	j824441052 [label="由於最近新的消息，我信奉的東西變得……複雜了。",shape=box,color=blue];
		j824441052 -> j4174987026;
	j2683643145 [label="漂泊者，我們才剛開始談論這些事。並非我不相信你親眼目睹過最慘絕人寰的苦難，我也不相信你承受不了我能吐出的說話。",shape=box,color=blue];
		j2683643145 -> j3239651193;
	j4174987026 [label="坦白說，漂泊者，我不知道該相信什麼。",shape=box,color=blue];
		j4174987026 -> j2539279287;
	j1144920832 [label="-里昂・阿拉德神父",shape=box,color=blue];
		j1144920832 -> j367054140;
	j4065509553 [label="他總是在我們最不經意的時候 ─ 在我們最脆弱的時候，在我們最無助的時候，在我們最需要答案的時候出現。",shape=box,color=blue];
		j4065509553 -> j1732007762;
		j4065509553 -> j2282232534;
	j1337389917 [label="好。你最好別那樣做。我可不想教訓你。你看起來像是那種會還擊的人。",shape=box,color=blue];
		j1337389917 -> j3116750010;
	j3239651193 [label="跟剛認識的人談論這些事然後對方再也不理我，只會讓我精疲力盡。我不願意我們要被迫合作，至少在短期內是如此。",shape=box,color=blue];
		j3239651193 -> j3577858698;
		j3239651193 -> j2392909257;
	j2539279287 [label="Boolean LyonFaith1 is now true.",color=orange];
		j2539279287 -> j3346146562;
	j367054140 [label="+20 Chemistry",color=orange];
		j367054140 -> "Chat ends.";
	j1732007762 [label="我抵擋得了。我保證不會讓他影響我的心情。",shape=box,color=red];
		j1732007762 -> j3440069485;
	j2282232534 [label="你似乎頗有經驗。他給了你什麼答案？",shape=box,color=red];
		j2282232534 -> j2277001582;
	j3116750010 [label="那我們會發現自己身處在怎樣的奇異狀態呢？",shape=box,color=blue];
		j3116750010 -> "Chat ends.";
	j3577858698 [label="如果你想等到你更信任我之後再說的話，我理解。",shape=box,color=red];
		j3577858698 -> j2849950500;
	j2392909257 [label="里昂，我哪裡都不會去。你可以信任我。",shape=box,color=red];
		j2392909257 -> j3888191459;
	j3346146562 [label="但我恐怕這一切都只能以後再說了。",shape=box,color=blue];
		j3346146562 -> j994470886;
	j2277001582 [label="那些令……很多事情變得撲朔迷離的答案。但我恐怕這一切都只能留待以後再說了。",shape=box,color=blue];
		j2277001582 -> j3838261353;
	j2849950500 [label="+20 Chemistry",color=orange];
		j2849950500 -> j545104567;
	j3888191459 [label="+15 Chemistry",color=orange];
		j3888191459 -> j1150521285;
	j994470886 [label="+20 Chemistry",color=orange];
		j994470886 -> j315711583;
	j3838261353 [label="Boolean LyonFaith1 is now true.",color=orange];
		j3838261353 -> j994470886;
	j545104567 [label="謝謝。並非我不相信你寫的東西是真的，只是我的經驗教會我相反的事。",shape=box,color=blue];
		j545104567 -> j315711583;
	j1150521285 [label="並非我不相信你寫的東西是真的，只是我的經驗教會我相反的事。",shape=box,color=blue];
		j1150521285 -> j315711583;
	j315711583 [label="與此同時，我懇請各位的寬恕和耐心。 ",shape=box,color=blue];
		j315711583 -> j2331496732;
}