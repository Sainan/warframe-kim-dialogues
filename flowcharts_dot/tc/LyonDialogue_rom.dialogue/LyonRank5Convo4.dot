	2348 [label="Update boolean LyonRell3",color=orange];
		2348 -> 2350;
	1628 [label="我聽說這非常痛苦。",shape=box,color=red];
		1628 -> 1632;
	1629 [label="我簡直無法想像。 ",shape=box,color=red];
		1629 -> 1633;
	1630 [label="【警告：提及虐童內容。點擊此處結束。不會因此損失與里昂的曖昧值。 】",shape=box,color=red];
		1630 -> 1634;
	1627 [label="[結束]",shape=box,color=red];
		1627 -> 1631;
	2350 [label="Update boolean LyonWillDate",color=orange];
		2350 -> 2351;
	1632 [label="我想也是。不過我相信我在這方面已經有多年的練習，因此，源拓氏的警告讓它聽起來比實際上更可怕。",shape=box,color=blue];
		1632 -> 1633;
	1633 [label="瑪麗和我決定私下注射血清。我請她讓我先來，體驗這個變化，然後幫助引導她完成她自己的，但她當然堅決拒絕了。",shape=box,color=blue];
		1633 -> 1636;
	1634 [label="+20 Chemistry",color=orange];
		1634 -> 1637;
	1631 [label="Update boolean LyonConfessionFail",color=orange];
		1631 -> 1635;
	2351 [label="Chat ends. Next chat will be Lyon5FaithDay2.",color=orange];
	1636 [label="她嘲笑我竟然想在沒有她堅定地站在我身邊的情況下，去任何地方或做任何事，然後她就前往自己的房間了。",shape=box,color=blue];
		1636 -> 1638;
	1637 [label="Update boolean LyonFamilySuccess",color=orange];
		1637 -> 1639;
	1635 [label="Chat ends.",color=orange];
	1638 [label="我鎖上門，脫掉衣服，坐在房間地板中央，盡可能遠離任何物體，然後把針頭刺進我的側腰。",shape=box,color=blue];
		1638 -> 1640;
	1639 [label="Update boolean LyonRell3",color=orange];
		1639 -> 1641;
	1640 [label="我見過 Infestation 對羅瑟做了什麼，把他的肉體和他當時穿的任何衣物扭曲在一起，我不想遭受同樣的命運。",shape=box,color=blue];
		1640 -> 1642;
	1641 [label="Update boolean LyonFaith3Unknown",color=orange];
		1641 -> 1643;
	1642 [label="當痛苦結束時，我本已受損的視力……變得模糊。被……某種雙重影像籠罩？彷彿我看到的影象是重疊的。",shape=box,color=blue];
		1642 -> 1644;
	1643 [label="Chat ends. Next chat will be Lyon5FaithDay2.",color=orange];
	1644 [label="然而，我對自己的韌性很是自豪，我設法在嘔吐到失去意識之前穿上了褲子。",shape=box,color=blue];
		1644 -> 1645;
	1645 [label="當我醒來時，我並不孤單。然而，我也不在我房間的地板上。我坐在我童年臥室裡我非常熟悉的吱吱作響的舊地板上。",shape=box,color=blue];
		1645 -> 1646;
	1646 [label="坐在我旁邊的是一個年輕人。站在他身旁的是我現在所知的 Harrow。這個年輕人手裡拿著一個小玩偶。它的四肢有關節，油漆早已磨損，也許只剩褶皺和裂縫。它屬於我的父親。那是個士兵。",shape=box,color=blue];
		1646 -> 1647;
	1647 [label="那是我小時候唯一能宣稱屬於自己的玩具。",shape=box,color=blue];
		1647 -> 1648;
		1647 -> 1649;
	1648 [label="我小時候也有類似的玩偶。那是我最喜歡的玩具之一。",shape=box,color=red];
		1648 -> 1650;
	1649 [label="Rell?",shape=box,color=red];
		1649 -> 1651;
	1650 [label="我聽說過。我相信我的玩偶最終證明是更良善的。",shape=box,color=blue];
		1650 -> 1652;
		1650 -> 1653;
		1650 -> 1654;
	1651 [label="確實。",shape=box,color=blue];
		1651 -> 1655;
	1652 [label="戰魁是個複雜的話題。我不想在這裡討論。",shape=box,color=red];
		1652 -> 1656;
	1653 [label="那不是他的錯。在那一刻他正是我需要的那種人。",shape=box,color=red];
		1653 -> 1657;
	1654 [label="沒關係。他正在進步。雖然很慢。但總算有點進展。看似不可能的事也能改變。",shape=box,color=red];
		1654 -> 1658;
	1655 [label="這個年輕人與他沉默的守護者到我的夢裡和心裡拜訪我，對我來說既是陌生人，又像是我們從小一起長大的兄弟姐妹那般熟悉。",shape=box,color=blue];
		1655 -> 1659;
	1656 [label="沒錯。我們可能會在這裡迷失數小時，辯論渡域的道德和神學含義。",shape=box,color=blue];
		1656 -> 1655;
	1657 [label="當我思考，哪怕我會在你的位置上召喚出什麼最微不足道的念想時，我都會被恐懼的浪潮淹沒。但我們可能會在這裡迷失數小時，討論這樣的事情。",shape=box,color=blue];
		1657 -> 1655;
	1658 [label="如果他顯示出改變的跡象，而他又是你的情緒產物，或許這表明了什麼。但這是改天再辯論的話題，或許吧。",shape=box,color=blue];
		1658 -> 1655;
	1659 [label="原諒我用一個誇張的比喻，但這就像我們是三棵樹，它們的根交織在一起，變得無法區分──",shape=box,color=blue];
		1659 -> 1660;
	1660 [label="只是這種狀態被眨眼間創造出來。我能記得沒有 Rell 和 Harrow 的日子。然而，他們就在那裡。在每一時刻的每一瞬間都在我身邊。",shape=box,color=blue];
		1660 -> 1661;
	1661 [label="順便說一句，我希望我能和源拓氏談談這件事，我迫切想知道什麼樣的科學是這個的根源，沒要搞雙關的意思，但當我們終於從變化中恢復過來時，源拓氏已經走了。",shape=box,color=blue];
		1661 -> 1662;
	1662 [label="Check boolean LoidFamilyComplete",color=orange];
		1662 -> 1664 [label=true,color=green];
		1662 -> 1663 [label=false,color=brown];
		1662 -> 1664 [label=false,color=brown];
	1664 [label="我對 Infestation 及其運作方式所知甚少，它似乎有點……也許……我不知道，被時間排除在外？",shape=box,color=red];
		1664 -> 1666;
	1663 [label="源拓氏的女兒在樓上。她在他身邊學習和工作。她也許能幫上忙。",shape=box,color=red];
		1663 -> 1665;
	1666 [label="有一把……吉他……這一切都很難解釋，而且我們都通過 Helminth 穿越時間……",shape=box,color=red];
		1666 -> 1668;
	1665 [label="Update boolean LyonFamilySuccess",color=orange];
		1665 -> 1667;
	1668 [label="我相信那個過程會在我的噩夢中徘徊很長一段時間。無論如何，我並不知道 Rell、Harrow 和我是如何在這種……分子與靈性層面上結合的具體細節。",shape=box,color=blue];
		1668 -> 1670;
	1667 [label="Add 1 to Family",color=orange];
		1667 -> 1669;
	1670 [label="但這個十字路口是雙向的。他們在我的生活中，我也在他們的生活中。我看到了漠然。我理解了他們在守護什麼。我瞥見了 Harrow，以及他曾經是什麼樣的人。",shape=box,color=blue];
		1670 -> 1672;
	1669 [label="要是我們被允許和她說話就好了。我懷疑已經有計劃要進行這件事了。如果是這樣，你可以指望我的……協助。在需要時我可以很有說服力。",shape=box,color=blue];
		1669 -> 1671;
	1672 [label="但漠然的壓迫接管了一切，我能感覺到也聽到，它們就在那裡敲擊著牆壁。噠……噠……噠……",shape=box,color=blue];
		1672 -> 1673;
	1671 [label="無論如何，我並不知道 Rell、Harrow 和我是如何在這種……分子與靈性層面上結合的具體細節。",shape=box,color=blue];
		1671 -> 1670;
	1673 [label="我年輕時的所有幻象，我見過的所有恐怖，它們是否只是漠然？是我記錯了嗎？還是我確實被太陰「祝福」了？",shape=box,color=blue];
		1673 -> 1674;
	1674 [label="我內心的信仰……徹底崩潰瓦解了。就像燒焦的紙片，化為塵埃。噢，我多麼痛恨自己的軟弱……",shape=box,color=blue];
		1674 -> 1675;
	1675 [label="Evaluate expressions",color=orange];
		1675 -> 1681 [label="LyonDating",color=purple];
		1675 -> 1682 [label="DrifterFaithYesSimilar",color=purple];
		1675 -> 1682 [label="DrifterFaithYesForeign",color=purple];
