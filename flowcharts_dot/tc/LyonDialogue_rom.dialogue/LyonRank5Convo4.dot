		1675 -> 1680 [label="DrifterFaithBalance",color=purple];
		1675 -> 1679 [label="DrifterFaithAgnostic",color=purple];
		1675 -> 1678 [label="DrifterFaithNoFear",color=purple];
		1675 -> 1677 [label="DrifterFaithNoMITW",color=purple];
		1675 -> 1678 [label="DrifterFaithNoMaybe",color=purple];
		1675 -> 1676 [label="false",color=purple];
	1681 [label="噢，里昂……你經歷太多了。懷疑不是軟弱的表現，而是痛苦的產物。",shape=box,color=red];
		1681 -> 1683;
		1681 -> 1684;
		1681 -> 1685;
		1681 -> 1686;
		1681 -> 1687;
	1682 [label="信仰不需要是恆定的，也不期望它是。有多少故事講述那些失去信仰，卻又重新找回的人？",shape=box,color=red];
		1682 -> 1683;
		1682 -> 1684;
		1682 -> 1685;
	1680 [label="里昂，你一生都奉獻給了我們的聖光會。你認為他們會因為這種事而疏遠你嗎？",shape=box,color=red];
		1680 -> 1683;
		1680 -> 1684;
		1680 -> 1685;
	1679 [label="里昂，我不知道世上有沒有神 ─ 我想我們誰也無法真正知道。但我知道的是，你經歷了很多。",shape=box,color=red];
		1679 -> 1683;
		1679 -> 1685;
		1679 -> 1686;
	1678 [label="雖然我個人是不相信世上有神，但我知道這對你的生命來說有多重要。我不想輕視這一點。",shape=box,color=red];
		1678 -> 1685;
		1678 -> 1687;
	1677 [label="漠然是我們造成的 ─ 他不是神，里昂。別讓源拓氏的錯誤毀了你。至於你的信仰？",shape=box,color=red];
		1677 -> 1685;
		1677 -> 1687;
	1676 [label="我很不忍心看到你這樣，被捲入所有人的鬧劇之中。你不應該承受這些。",shape=box,color=red];
		1676 -> 1683;
		1676 -> 1684;
		1676 -> 1685;
		1676 -> 1686;
		1676 -> 1687;
	1683 [label="我不是說你需要重新找到你的信仰。我是說如果你想也覺得你需要的話，它不是永遠失去的東西。",shape=box,color=red];
		1683 -> 1688;
	1684 [label="當然，太陰能看到你經歷了什麼。你以她的名義忍受了什麼。",shape=box,color=red];
		1684 -> 1689;
	1685 [label="我認為你需要專注的是在自己內心找到某種平靜，無論你需要如何找到它。",shape=box,color=red];
		1685 -> 1690;
	1686 [label="如果有神，如果你的太陰確實存在，她肯定能看到你經歷了什麼。你以她的名義忍受了什麼。這對她一定意味著什麼。",shape=box,color=red];
		1686 -> 1691;
	1687 [label="我認為你需要放下是否有神的任何概念，首先專注於治癒自己。",shape=box,color=red];
		1687 -> 1692;
	1688 [label="Update boolean LyonFaith3Maybe",color=orange];
		1688 -> 1693;
	1689 [label="Update boolean LyonFaith3Yes",color=orange];
		1689 -> 1693;
	1690 [label="Update boolean LyonFaith3Maybe",color=orange];
		1690 -> 1693;
	1691 [label="Update boolean LyonFaith3Yes",color=orange];
		1691 -> 1693;
	1692 [label="Update boolean LyonFaith3No",color=orange];
		1692 -> 1693;
	1693 [label="或許你是對的……而我充滿疑慮的悲傷故事並不是重點。但我會考慮你的話。我們明天會更詳細地討論這個。",shape=box,color=blue];
		1693 -> 1694;
	1694 [label="我看到了 Rell 在扎日曼 10-0 號上的生活，以及他之後所忍受的一切。我看到了 Harrow 作為士兵的生活，儘管這些景象彷彿透過 Infestation 褪色了。就像他們看到了我在高盧的生活以及我所遭受的一切。",shape=box,color=blue];
		1694 -> 1695;
	1695 [label="你可能會覺得奇怪，我們三個從未說過一句話。我們從未發現有這個必要。我們之間就是有種……默契。",shape=box,color=blue];
		1695 -> 1696;
		1695 -> 1697;
	1696 [label="真的假的？從來沒有？",shape=box,color=red];
		1696 -> 1698;
	1697 [label="是啊……我能看得出來。",shape=box,color=red];
		1697 -> 1699;
	1698 [label="我能聽到他們的聲音，我知道他們生命中說過的所有話語。但那些話從未對我說過。",shape=box,color=blue];
		1698 -> 1699;
	1699 [label="微笑需要演講嗎？皺眉需要嗎？你需要聽到孩子哭泣才知道他痛苦或害怕嗎？不，我們就是清楚彼此間傳遞的訊息。",shape=box,color=blue];
		1699 -> 1700;
	1700 [label="直到……直到它不再存在。",shape=box,color=blue];
		1700 -> 1701;
	1701 [label="Check boolean LyonDating",color=orange];
		1701 -> 1703 [label=true,color=green];
		1701 -> 1702 [label=false,color=brown];
	1703 [label="我的奇蹟，他們並沒有消失……只是死了。",shape=box,color=blue];
		1703 -> 1704;
	1702 [label="我的朋友，他們並沒有消失……只是死了。",shape=box,color=blue];
		1702 -> 1704;
	1704 [label="我再也聽不到他們那些未確定的部分。現在，我相信，我只能聽到他們那些已確定的部分。",shape=box,color=blue];
		1704 -> 1705;
		1704 -> 1706;
	1705 [label="抱歉，確定的部分？",shape=box,color=red];
		1705 -> 1707;
	1706 [label="你是什麼時候……聽不到他的？",shape=box,color=red];
		1706 -> 1708;
	1707 [label="我無法更進一步地解釋它了。我不知道該如何解釋。原諒我。",shape=box,color=blue];
		1707 -> 1708;
	1708 [label="就在我們和羅瑟一起穿過 Helminth 來到這裡，來到聖堂的那一刻。我不知道……為什麼。或如何。",shape=box,color=blue];
		1708 -> 1709;
	1709 [label="但在穿過那層時間的面紗時，我的朋友們，我的兄弟們……那些根系與我靈魂如此緊密交織的樹木……在我身邊枯萎凋零了。",shape=box,color=blue];
		1709 -> 1710;
	1710 [label="現在那裡只剩下空虛和腐爛。他們的記憶仍在腐蝕我自己的記憶。但如果有機會，我也不會放棄它……",shape=box,color=blue];
		1710 -> 1711;
		1710 -> 1712;
	1711 [label="噢？",shape=box,color=red];
		1711 -> 1713;
	1712 [label="為什麼不？",shape=box,color=red];
		1712 -> 1713;
	1713 [label="我能回憶起我母親第一次打我的記憶。我以兩種方式記得它，清晰得如日尊最明亮的光芒，我知道所有版本都是真實的。",shape=box,color=blue];
		1713 -> 1714;
	1714 [label="在一個版本中……我獨自在房間的黑暗中哭泣。在另一個版本中，兩個身影站在我身旁的陰影中。",shape=box,color=blue];
		1714 -> 1715;
	1715 [label="我對第一次用刀刃劃破皮膚以清除腦中聲音的記憶有兩次。在一個版本中，房間是空的。",shape=box,color=blue];
		1715 -> 1716;
	1716 [label="在另一個版本中，我聽到身後傳來哼唱。我感覺到一個堅毅守護者的沉默存在。",shape=box,color=blue];
		1716 -> 1717;
	1717 [label="如果我失去了對太陰女神的信仰，卻得到了他們的引導作為回報……這可能會是我願意做的交易。",shape=box,color=blue];
		1717 -> 1718;
	1718 [label="Evaluate expressions",color=orange];
