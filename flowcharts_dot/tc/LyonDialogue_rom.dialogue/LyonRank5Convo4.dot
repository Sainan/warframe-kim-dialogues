		j499051772 -> j3856020424;
	j4075781927 [label="Boolean LyonWillDate is now true.",color=orange];
		j4075781927 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j2625852555 [label="我想也是。不過我相信我在這方面已經有多年的練習，因此，源拓氏的警告讓它聽起來比實際上更可怕。",shape=box,color=blue];
		j2625852555 -> j778826289;
	j778826289 [label="瑪麗和我決定私下注射血清。我請她讓我先來，體驗這個變化，然後幫助引導她完成她自己的，但她當然堅決拒絕了。",shape=box,color=blue];
		j778826289 -> j1449208107;
	j1843578849 [label="+20 Chemistry",color=orange];
		j1843578849 -> j2698387260;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	"Chat ends. Next chat will be Lyon5FaithDay2." [color=orange];
	j1449208107 [label="她嘲笑我竟然想在沒有她堅定地站在我身邊的情況下，去任何地方或做任何事，然後她就前往自己的房間了。",shape=box,color=blue];
		j1449208107 -> j709287623;
	j2698387260 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j2698387260 -> j2559080857;
	j709287623 [label="我鎖上門，脫掉衣服，坐在房間地板中央，盡可能遠離任何物體，然後把針頭刺進我的側腰。",shape=box,color=blue];
		j709287623 -> j1066306363;
	j2559080857 [label="Boolean LyonRell3 is now true.",color=orange];
		j2559080857 -> j4008758555;
	j1066306363 [label="我見過 Infestation 對羅瑟做了什麼，把他的肉體和他當時穿的任何衣物扭曲在一起，我不想遭受同樣的命運。",shape=box,color=blue];
		j1066306363 -> j3840614208;
	j4008758555 [label="Boolean LyonFaith3Unknown is now true.",color=orange];
		j4008758555 -> "Chat ends. Next chat will be Lyon5FaithDay2.";
	j3840614208 [label="當痛苦結束時，我本已受損的視力……變得模糊。被……某種雙重影像籠罩？彷彿我看到的影象是重疊的。",shape=box,color=blue];
		j3840614208 -> j4047644577;
	j4047644577 [label="然而，我對自己的韌性很是自豪，我設法在嘔吐到失去意識之前穿上了褲子。",shape=box,color=blue];
		j4047644577 -> j3956659858;
	j3956659858 [label="當我醒來時，我並不孤單。然而，我也不在我房間的地板上。我坐在我童年臥室裡我非常熟悉的吱吱作響的舊地板上。",shape=box,color=blue];
		j3956659858 -> j4122552821;
	j4122552821 [label="坐在我旁邊的是一個年輕人。站在他身旁的是我現在所知的 Harrow。這個年輕人手裡拿著一個小玩偶。它的四肢有關節，油漆早已磨損，也許只剩褶皺和裂縫。它屬於我的父親。那是個士兵。",shape=box,color=blue];
		j4122552821 -> j1067385696;
	j1067385696 [label="那是我小時候唯一能宣稱屬於自己的玩具。",shape=box,color=blue];
		j1067385696 -> j3871331982;
		j1067385696 -> j1396115482;
	j3871331982 [label="我小時候也有類似的玩偶。那是我最喜歡的玩具之一。",shape=box,color=red];
		j3871331982 -> j1998687044;
	j1396115482 [label="Rell?",shape=box,color=red];
		j1396115482 -> j4055211912;
	j1998687044 [label="我聽說過。我相信我的玩偶最終證明是更良善的。",shape=box,color=blue];
		j1998687044 -> j2210272590;
		j1998687044 -> j1943988895;
		j1998687044 -> j1119627872;
	j4055211912 [label="確實。",shape=box,color=blue];
		j4055211912 -> j1966938411;
	j2210272590 [label="戰魁是個複雜的話題。我不想在這裡討論。",shape=box,color=red];
		j2210272590 -> j3388876628;
	j1943988895 [label="那不是他的錯。在那一刻他正是我需要的那種人。",shape=box,color=red];
		j1943988895 -> j1140535847;
	j1119627872 [label="沒關係。他正在進步。雖然很慢。但總算有點進展。看似不可能的事也能改變。",shape=box,color=red];
		j1119627872 -> j2786010227;
	j1966938411 [label="這個年輕人與他沉默的守護者到我的夢裡和心裡拜訪我，對我來說既是陌生人，又像是我們從小一起長大的兄弟姐妹那般熟悉。",shape=box,color=blue];
		j1966938411 -> j1915517977;
	j3388876628 [label="沒錯。我們可能會在這裡迷失數小時，辯論渡域的道德和神學含義。",shape=box,color=blue];
		j3388876628 -> j1966938411;
	j1140535847 [label="當我思考，哪怕我會在你的位置上召喚出什麼最微不足道的念想時，我都會被恐懼的浪潮淹沒。但我們可能會在這裡迷失數小時，討論這樣的事情。",shape=box,color=blue];
		j1140535847 -> j1966938411;
	j2786010227 [label="如果他顯示出改變的跡象，而他又是你的情緒產物，或許這表明了什麼。但這是改天再辯論的話題，或許吧。",shape=box,color=blue];
		j2786010227 -> j1966938411;
	j1915517977 [label="原諒我用一個誇張的比喻，但這就像我們是三棵樹，它們的根交織在一起，變得無法區分──",shape=box,color=blue];
		j1915517977 -> j211440236;
	j211440236 [label="只是這種狀態被眨眼間創造出來。我能記得沒有 Rell 和 Harrow 的日子。然而，他們就在那裡。在每一時刻的每一瞬間都在我身邊。",shape=box,color=blue];
		j211440236 -> j691931810;
	j691931810 [label="順便說一句，我希望我能和源拓氏談談這件事，我迫切想知道什麼樣的科學是這個的根源，沒要搞雙關的意思，但當我們終於從變化中恢復過來時，源拓氏已經走了。",shape=box,color=blue];
		j691931810 -> j1937133691;
	j1937133691 [label="Check boolean LoidFamilyComplete",color=orange];
		j1937133691 -> j4239141357 [label=true,color=green];
		j1937133691 -> j1035711542 [label=false,color=brown];
		j1937133691 -> j4239141357 [label=false,color=brown];
	j4239141357 [label="我對 Infestation 及其運作方式所知甚少，它似乎有點……也許……我不知道，被時間排除在外？",shape=box,color=red];
		j4239141357 -> j2606699234;
	j1035711542 [label="源拓氏的女兒在樓上。她在他身邊學習和工作。她也許能幫上忙。",shape=box,color=red];
		j1035711542 -> j587396541;
	j2606699234 [label="有一把……吉他……這一切都很難解釋，而且我們都通過 Helminth 穿越時間……",shape=box,color=red];
		j2606699234 -> j3553592798;
	j587396541 [label="Boolean LyonFamilySuccess is now true.",color=orange];
		j587396541 -> j1638394053;
	j3553592798 [label="我相信那個過程會在我的噩夢中徘徊很長一段時間。無論如何，我並不知道 Rell、Harrow 和我是如何在這種……分子與靈性層面上結合的具體細節。",shape=box,color=blue];
		j3553592798 -> j1321653962;
	j1638394053 [label="Add 1 to Family counter",color=orange];
		j1638394053 -> j4014984863;
	j1321653962 [label="但這個十字路口是雙向的。他們在我的生活中，我也在他們的生活中。我看到了漠然。我理解了他們在守護什麼。我瞥見了 Harrow，以及他曾經是什麼樣的人。",shape=box,color=blue];
		j1321653962 -> j196314661;
	j4014984863 [label="要是我們被允許和她說話就好了。我懷疑已經有計劃要進行這件事了。如果是這樣，你可以指望我的……協助。在需要時我可以很有說服力。",shape=box,color=blue];
		j4014984863 -> j1622872264;
	j196314661 [label="但漠然的壓迫接管了一切，我能感覺到也聽到，它們就在那裡敲擊著牆壁。噠……噠……噠……",shape=box,color=blue];
		j196314661 -> j4208818361;
	j1622872264 [label="無論如何，我並不知道 Rell、Harrow 和我是如何在這種……分子與靈性層面上結合的具體細節。",shape=box,color=blue];
		j1622872264 -> j1321653962;
	j4208818361 [label="我年輕時的所有幻象，我見過的所有恐怖，它們是否只是漠然？是我記錯了嗎？還是我確實被太陰「祝福」了？",shape=box,color=blue];
		j4208818361 -> j1338881796;
	j1338881796 [label="我內心的信仰……徹底崩潰瓦解了。就像燒焦的紙片，化為塵埃。噢，我多麼痛恨自己的軟弱……",shape=box,color=blue];
		j1338881796 -> j2547210604;
	j2547210604 [label="Evaluate expressions",color=orange];
		j2547210604 -> j1336382997 [label="LyonDating",color=purple];
		j2547210604 -> j449642776 [label="DrifterFaithYesSimilar",color=purple];
		j2547210604 -> j449642776 [label="DrifterFaithYesForeign",color=purple];
		j2547210604 -> j449642776 [label="DrifterFaithPersonal",color=purple];
		j2547210604 -> j2664595243 [label="DrifterFaithSol",color=purple];
		j2547210604 -> j2664595243 [label="DrifterFaithLua",color=purple];
		j2547210604 -> j2664595243 [label="DrifterFaithBalance",color=purple];
		j2547210604 -> j2331153613 [label="DrifterFaithAgnostic",color=purple];
		j2547210604 -> j2335951940 [label="DrifterFaithNoFear",color=purple];
		j2547210604 -> j3342580237 [label="DrifterFaithNoMITW",color=purple];
		j2547210604 -> j2335951940 [label="DrifterFaithNoMaybe",color=purple];
		j2547210604 -> j4043508149 [label="false",color=purple];
	j1336382997 [label="噢，里昂……你經歷太多了。懷疑不是軟弱的表現，而是痛苦的產物。",shape=box,color=red];
		j1336382997 -> j3540700217;
		j1336382997 -> j2832588005;
		j1336382997 -> j2344915481;
		j1336382997 -> j748615150;
		j1336382997 -> j619653438;
	j449642776 [label="信仰不需要是恆定的，也不期望它是。有多少故事講述那些失去信仰，卻又重新找回的人？",shape=box,color=red];
		j449642776 -> j3540700217;
		j449642776 -> j2832588005;
		j449642776 -> j2344915481;
	j2664595243 [label="里昂，你一生都奉獻給了我們的聖光會。你認為他們會因為這種事而疏遠你嗎？",shape=box,color=red];
		j2664595243 -> j3540700217;
		j2664595243 -> j2832588005;
		j2664595243 -> j2344915481;
	j2331153613 [label="里昂，我不知道世上有沒有神 ─ 我想我們誰也無法真正知道。但我知道的是，你經歷了很多。",shape=box,color=red];
		j2331153613 -> j3540700217;
		j2331153613 -> j2344915481;
		j2331153613 -> j748615150;
	j2335951940 [label="雖然我個人是不相信世上有神，但我知道這對你的生命來說有多重要。我不想輕視這一點。",shape=box,color=red];
		j2335951940 -> j2344915481;
		j2335951940 -> j619653438;
	j3342580237 [label="漠然是我們造成的 ─ 他不是神，里昂。別讓源拓氏的錯誤毀了你。至於你的信仰？",shape=box,color=red];
		j3342580237 -> j2344915481;
		j3342580237 -> j619653438;
	j4043508149 [label="我很不忍心看到你這樣，被捲入所有人的鬧劇之中。你不應該承受這些。",shape=box,color=red];
		j4043508149 -> j3540700217;
		j4043508149 -> j2832588005;
		j4043508149 -> j2344915481;
		j4043508149 -> j748615150;
		j4043508149 -> j619653438;
	j3540700217 [label="我不是說你需要重新找到你的信仰。我是說如果你想也覺得你需要的話，它不是永遠失去的東西。",shape=box,color=red];
		j3540700217 -> j1021661880;
	j2832588005 [label="當然，太陰能看到你經歷了什麼。你以她的名義忍受了什麼。",shape=box,color=red];
		j2832588005 -> j3061175160;
	j2344915481 [label="我認為你需要專注的是在自己內心找到某種平靜，無論你需要如何找到它。",shape=box,color=red];
		j2344915481 -> j1021661880;
	j748615150 [label="如果有神，如果你的太陰確實存在，她肯定能看到你經歷了什麼。你以她的名義忍受了什麼。這對她一定意味著什麼。",shape=box,color=red];
		j748615150 -> j3061175160;
	j619653438 [label="我認為你需要放下是否有神的任何概念，首先專注於治癒自己。",shape=box,color=red];
		j619653438 -> j4195674773;
	j1021661880 [label="Boolean LyonFaith3Maybe is now true.",color=orange];
		j1021661880 -> j1697080645;
	j3061175160 [label="Boolean LyonFaith3Yes is now true.",color=orange];
		j3061175160 -> j1697080645;
	j4195674773 [label="Boolean LyonFaith3No is now true.",color=orange];
		j4195674773 -> j1697080645;
	j1697080645 [label="或許你是對的……而我充滿疑慮的悲傷故事並不是重點。但我會考慮你的話。我們明天會更詳細地討論這個。",shape=box,color=blue];
		j1697080645 -> j2398813758;
	j2398813758 [label="我看到了 Rell 在扎日曼 10-0 號上的生活，以及他之後所忍受的一切。我看到了 Harrow 作為士兵的生活，儘管這些景象彷彿透過 Infestation 褪色了。就像他們看到了我在高盧的生活以及我所遭受的一切。",shape=box,color=blue];
		j2398813758 -> j2260633219;
	j2260633219 [label="你可能會覺得奇怪，我們三個從未說過一句話。我們從未發現有這個必要。我們之間就是有種……默契。",shape=box,color=blue];
		j2260633219 -> j696752736;
		j2260633219 -> j2427859551;
	j696752736 [label="真的假的？從來沒有？",shape=box,color=red];
		j696752736 -> j1752635181;
	j2427859551 [label="是啊……我能看得出來。",shape=box,color=red];
		j2427859551 -> j3600868414;
	j1752635181 [label="我能聽到他們的聲音，我知道他們生命中說過的所有話語。但那些話從未對我說過。",shape=box,color=blue];
		j1752635181 -> j3600868414;
	j3600868414 [label="微笑需要演講嗎？皺眉需要嗎？你需要聽到孩子哭泣才知道他痛苦或害怕嗎？不，我們就是清楚彼此間傳遞的訊息。",shape=box,color=blue];
		j3600868414 -> j267559947;
	j267559947 [label="直到……直到它不再存在。",shape=box,color=blue];
		j267559947 -> j944777217;
	j944777217 [label="Check boolean LyonDating",color=orange];
		j944777217 -> j2196890610 [label=true,color=green];
		j944777217 -> j3343800236 [label=false,color=brown];
	j2196890610 [label="我的奇蹟，他們並沒有消失……只是死了。",shape=box,color=blue];
		j2196890610 -> j3457900377;
	j3343800236 [label="我的朋友，他們並沒有消失……只是死了。",shape=box,color=blue];
		j3343800236 -> j3457900377;
	j3457900377 [label="我再也聽不到他們那些未確定的部分。現在，我相信，我只能聽到他們那些已確定的部分。",shape=box,color=blue];
		j3457900377 -> j811691192;
		j3457900377 -> j1405711381;
	j811691192 [label="抱歉，確定的部分？",shape=box,color=red];
		j811691192 -> j971833058;
	j1405711381 [label="你是什麼時候……聽不到他的？",shape=box,color=red];
		j1405711381 -> j2642754142;
	j971833058 [label="我無法更進一步地解釋它了。我不知道該如何解釋。原諒我。",shape=box,color=blue];
		j971833058 -> j2642754142;
	j2642754142 [label="就在我們和羅瑟一起穿過 Helminth 來到這裡，來到聖堂的那一刻。我不知道……為什麼。或如何。",shape=box,color=blue];
		j2642754142 -> j792995816;
	j792995816 [label="但在穿過那層時間的面紗時，我的朋友們，我的兄弟們……那些根系與我靈魂如此緊密交織的樹木……在我身邊枯萎凋零了。",shape=box,color=blue];
		j792995816 -> j1131205503;
	j1131205503 [label="現在那裡只剩下空虛和腐爛。他們的記憶仍在腐蝕我自己的記憶。但如果有機會，我也不會放棄它……",shape=box,color=blue];
		j1131205503 -> j1013443360;
		j1131205503 -> j864992193;
	j1013443360 [label="噢？",shape=box,color=red];
		j1013443360 -> j2416721306;
	j864992193 [label="為什麼不？",shape=box,color=red];
		j864992193 -> j2416721306;
	j2416721306 [label="我能回憶起我母親第一次打我的記憶。我以兩種方式記得它，清晰得如日尊最明亮的光芒，我知道所有版本都是真實的。",shape=box,color=blue];
		j2416721306 -> j1664443950;
	j1664443950 [label="在一個版本中……我獨自在房間的黑暗中哭泣。在另一個版本中，兩個身影站在我身旁的陰影中。",shape=box,color=blue];
		j1664443950 -> j945429042;
	j945429042 [label="我對第一次用刀刃劃破皮膚以清除腦中聲音的記憶有兩次。在一個版本中，房間是空的。",shape=box,color=blue];
		j945429042 -> j3012217470;
	j3012217470 [label="在另一個版本中，我聽到身後傳來哼唱。我感覺到一個堅毅守護者的沉默存在。",shape=box,color=blue];
