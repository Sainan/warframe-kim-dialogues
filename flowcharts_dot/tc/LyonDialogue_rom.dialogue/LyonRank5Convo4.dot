	j2666301513 [label="你能考慮這種可能性嗎……也許這一切都是太陰的傑作？為了安慰你？",shape=box,color=red];
		j2666301513 -> j4207653200;
	j3195235007 [label="我不認為兩者必須是互相排斥的，但是……我不知道。我不知道我們是否永遠會知道。",shape=box,color=red];
		j3195235007 -> j4113740696;
	j1781001536 [label="我只是……很高興 Rell 跟 Harrow 能和你在一起，里昂……即使只是在回憶裡。",shape=box,color=red];
		j1781001536 -> j1839276595;
	j1839276595 [label="謝謝。我很想念他們。但是……我漸漸明白，在這個地方，能理解我痛苦的人比不能理解我的人要多。",shape=box,color=blue];
		j1839276595 -> j2656210949;
	j984148656 [label="謝謝。我想念他們的存在。但我……不再孤單了，不是嗎，我的奇蹟？",shape=box,color=blue];
		j984148656 -> j2656210949;
	j4207653200 [label="是的。不要以為我沒有考慮過。我不確定我的信仰是否會如此輕易地修復，但是……思考這一點仍然是一種安慰。",shape=box,color=blue];
		j4207653200 -> j2656210949;
