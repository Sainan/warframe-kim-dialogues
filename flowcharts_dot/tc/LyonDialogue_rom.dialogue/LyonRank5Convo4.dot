		1718 -> 1720 [label="false",color=purple];
	1719 [label="我只是 — 我只是對你們所經歷的一切感到非常抱歉。",shape=box,color=red];
		1719 -> 1725;
	1724 [label="我只是……很高興 Rell 跟 Harrow 能和你在一起，里昂……即使只是在回憶裡。",shape=box,color=red];
		1724 -> 1728;
	1723 [label="你能考慮這種可能性嗎……也許這一切都是神或諸神的傑作？為了安慰你？",shape=box,color=red];
		1723 -> 1727;
