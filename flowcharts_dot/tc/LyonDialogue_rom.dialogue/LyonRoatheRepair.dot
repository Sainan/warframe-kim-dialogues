		j1278987414 -> j4254468945;
	j1535435110 [label="但當我得知你為了讓我留在身邊會不惜採取如此荒謬的手段時，我的不悅也就煙消雲散了。",shape=box,color=blue];
		j1535435110 -> j2398113586;
