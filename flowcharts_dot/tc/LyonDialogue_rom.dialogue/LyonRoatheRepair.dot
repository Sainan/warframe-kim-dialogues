	j3760836957 [label="我不明白。我們不能回頭。覆水難收。",shape=box,color=blue];
		j3760836957 -> j4282314162;
		j3760836957 -> j779051092;
	j992232423 [label="明白。",shape=box,color=blue];
		j992232423 -> "Chat ends.";
	j945938305 [label="我承認，這事的荒謬性是促使我來一探究竟的原因之一。你真有那麼心煩意亂嗎？我實在無法想像失去我的陪伴對你來說會是多麼糟糕的事。",shape=box,color=blue];
		j945938305 -> j1409502846;
	j2860441535 [label="你會得到你所要求的協助。我同情你的攻擊惡魔接下來會對瑪麗做什麼。",shape=box,color=blue];
		j2860441535 -> j92487004;
	j903677820 [label="你會得到你所要求的協助。現在請，叫停你的攻擊惡魔。",shape=box,color=blue];
		j903677820 -> j770168571;
	j4282314162 [label="哦。好吧，那這真是浪費了大把時間，不是嗎？",shape=box,color=red];
		j4282314162 -> "Chat ends.";
	j779051092 [label="我想……那我會直接說我很抱歉沒有聽你的話。",shape=box,color=red];
