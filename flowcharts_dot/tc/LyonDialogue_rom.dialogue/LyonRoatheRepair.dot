		j4027642932 -> j1285258823;
	"Chat ends." [color=orange];
	j3150323401 [label="你意識到這聽起來多麼荒謬，對吧？",shape=box,color=blue];
		j3150323401 -> j3548711948;
		j3150323401 -> j1431120058;
	j1293643562 [label="我不想再浪費比我已經浪費的更多時間去聽他的論證。我只會說，很好。",shape=box,color=blue];
		j1293643562 -> j2169173578;
	j1285258823 [label="問題是，如果我沒錯的話，你不想涉足我的過去。現在你似乎改變主意了？",shape=box,color=blue];
		j1285258823 -> j3760836957;
	j3548711948 [label="我不知道他說我會道歉。",shape=box,color=red];
		j3548711948 -> j992232423;
	j1431120058 [label="我不知道還能做什麼。事後看來我知道這很荒謬。",shape=box,color=red];
		j1431120058 -> j73293415;
	j2169173578 [label="Check boolean MarieFamilyFail",color=orange];
		j2169173578 -> j2860441535 [label=true,color=green];
		j2169173578 -> j903677820 [label=false,color=brown];
	j3760836957 [label="我不明白。我們不能回頭。覆水難收。",shape=box,color=blue];
		j3760836957 -> j4282314162;
		j3760836957 -> j779051092;
	j992232423 [label="明白。",shape=box,color=blue];
		j992232423 -> "Chat ends.";
	j73293415 [label="我承認，這事的荒謬性是促使我來一探究竟的原因之一。你真有那麼心煩意亂嗎？我實在無法想像失去我的陪伴對你來說會是多麼糟糕的事。",shape=box,color=blue];
		j73293415 -> j2376801152;
	j2860441535 [label="你會得到你所要求的協助。我同情你的攻擊惡魔接下來會對瑪麗做什麼。",shape=box,color=blue];
		j2860441535 -> j92487004;
	j903677820 [label="你會得到你所要求的協助。現在請，叫停你的攻擊惡魔。",shape=box,color=blue];
		j903677820 -> j770168571;
	j4282314162 [label="哦。好吧，那這真是浪費了大把時間，不是嗎？",shape=box,color=red];
		j4282314162 -> "Chat ends.";
	j779051092 [label="我想……那我會直接說我很抱歉沒有聽你的話。",shape=box,color=red];
		j779051092 -> j1835178222;
	j2376801152 [label="是的，里昂。我非常在乎你。我知道我之前對你太過份了。",shape=box,color=red];
