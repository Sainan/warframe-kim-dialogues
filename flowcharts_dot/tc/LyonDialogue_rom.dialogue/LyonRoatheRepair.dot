		j770168571 -> j3711686580;
	j1835178222 [label="我可以問你為什麼沒有聽嗎？你害怕那些內容嗎？也許覺得無聊？還是你認為自己不夠堅強來承受它？",shape=box,color=blue];
		j1835178222 -> j389109521;
