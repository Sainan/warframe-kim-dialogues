		j3512148922 -> j3728827642;
	j3198575585 [label="這是私事，漂泊者。我很感激你嘗試和我說話。我很欣賞你如此輕易地承認說謊。我也明白我不是……你接觸過的人當中最容易相處的人。",shape=box,color=blue];
