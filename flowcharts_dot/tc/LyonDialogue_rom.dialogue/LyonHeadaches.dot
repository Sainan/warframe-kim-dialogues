		j3728827642 -> j730830614;
		j3728827642 -> j797141504;
	j2313669438 [label="所以，如果我覺得你這番親近的提議天真得有些可笑，請見諒。我不認識你也不信任你。事實上，我所能相信的，只是別人的一面之詞。",shape=box,color=blue];
		j2313669438 -> j641795842;
