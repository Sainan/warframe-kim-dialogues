		j976473763 -> j4144924443;
	j568956021 [label="她似乎暗示你對自己有頭痛的原因有一些想法？",shape=box,color=red];
		j568956021 -> j1827858373;
	j4266807859 [label="瑪麗覺得你一個人承擔了一切。我想讓你知道我一直都在這裏。",shape=box,color=red];
		j4266807859 -> j3233356385;
