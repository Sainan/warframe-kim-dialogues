	"LyonRank5Convo9 begins." [color=orange];
		"LyonRank5Convo9 begins." -> j3594191379;
	j3594191379 [label="Evaluate expressions",color=orange];
		j3594191379 -> "Chat ends." [label="LyonDating, LyonDatingConfession",color=purple];
		j3594191379 -> j3648342469 [label="LyonDating",color=purple];
		j3594191379 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j3648342469 [label="我的奇蹟，我……在告訴你我接下來的這段軼事之前，必須非常確定你理解某件事。",shape=box,color=blue];
		j3648342469 -> j2759189679;
	j2759189679 [label="對我來說很重要的是，你要非常密切地注意我接下來傳給你的這些話。你明白嗎？",shape=box,color=blue];
		j2759189679 -> j1013803546;
		j2759189679 -> j1509194431;
	j1013803546 [label="你讓我覺得很緊張。怎麼了？",shape=box,color=red];
		j1013803546 -> j3497314369;
	j1509194431 [label="對，我在這。請說。",shape=box,color=red];
		j1509194431 -> j2193407220;
	j3497314369 [label="沒有什麼不對，恰好相反。這就是為什麼你必須理解這一點如此重要，我希望你免受可能發生的可怕後果，如果你認為它們可能會發生的話。",shape=box,color=blue];
		j3497314369 -> j3310403328;
		j3497314369 -> j342495007;
		j3497314369 -> j400408785;
	j2193407220 [label="+5 Chemistry",color=orange];
		j2193407220 -> j3568879412;
	j3310403328 [label="我在聽。",shape=box,color=red];
		j3310403328 -> j3351613906;
	j342495007 [label="你說得不太清楚。",shape=box,color=red];
		j342495007 -> j774567953;
	j400408785 [label="……什麼的可怕後果？",shape=box,color=red];
		j400408785 -> j3166072608;
	j3568879412 [label="謝謝你。在我開始之前，我想向你保證沒有什麼不對，然而，這其中可能蘊藏著可怕的後果，我希望你免受其害，如果你認為它們可能會發生的話。",shape=box,color=blue];
		j3568879412 -> j3310403328;
		j3568879412 -> j342495007;
		j3568879412 -> j400408785;
	j3351613906 [label="+5 Chemistry",color=orange];
		j3351613906 -> j4261883892;
	j774567953 [label="是的。我對此深有體會。",shape=box,color=blue];
		j774567953 -> j3166072608;
	j3166072608 [label="容許我重新開始過。",shape=box,color=blue];
		j3166072608 -> j4261883892;
	j4261883892 [label="我意識到我可能被許多人解讀為，事實上很可能確實是……不健康的。至少，我並非完全精神健全。",shape=box,color=blue];
		j4261883892 -> j3669859014;
	j3669859014 [label="我早已接受了這一點。它不再困擾我。折磨我的幻象和聲音，我已經找到了與它們共處的方法，沒有恐懼或仇恨。",shape=box,color=blue];
		j3669859014 -> j1669622368;
	j1669622368 [label="最近，我想，如果我誠實點的話，有點出於怨恨，但那無關緊要。",shape=box,color=blue];
		j1669622368 -> j2546689392;
	j2546689392 [label="但我希望你明白，如果你要結束我們之間的關係，這種我以為以前在我和另一個人之間是不可能形成的紐帶——",shape=box,color=blue];
		j2546689392 -> j3329515549;
	j3329515549 [label="如果你的心離我的心而去？",shape=box,color=blue];
		j3329515549 -> j2498744512;
	j2498744512 [label="我會忍受的，我的奇蹟。",shape=box,color=blue];
		j2498744512 -> j1619917030;
	j1619917030 [label="我不會被折磨我的東西吞噬。",shape=box,color=blue];
		j1619917030 -> j2851720794;
	j2851720794 [label="Check boolean LyonAllRight",color=orange];
		j2851720794 -> j2257302337 [label=true,color=green];
		j2851720794 -> j2345513657 [label=false,color=brown];
	j2257302337 [label="用你的俗語來說，我會「沒事的」。我會再次找到微笑和大笑的理由。",shape=box,color=blue];
		j2257302337 -> j4189385754;
		j2257302337 -> j3620826278;
	j2345513657 [label="我會活下來。我會沒事的。我會再次找到微笑和大笑的理由。",shape=box,color=blue];
		j2345513657 -> j4189385754;
		j2345513657 -> j3620826278;
	j4189385754 [label="哦，里昂……你對我來說不是負擔。",shape=box,color=red];
		j4189385754 -> j4007612697;
	j3620826278 [label="你是在……說你想結束我們之間的關係嗎？",shape=box,color=red];
		j3620826278 -> j530668082;
	j4007612697 [label="我只是試圖讓你免受任何你可能因為我而感到的任何困難……",shape=box,color=blue];
		j4007612697 -> j4102220853;
		j4007612697 -> j1474491724;
		j4007612697 -> j3760226602;
	j530668082 [label="不！絕無此意！我只是試圖讓你免受任何你可能因為我而感到的任何困難。",shape=box,color=blue];
		j530668082 -> j4102220853;
		j530668082 -> j1474491724;
		j530668082 -> j3760226602;
	j4102220853 [label="你的痛苦……呼應著某種我自己的痛苦。幫助你度過它永遠不會是一種困難。",shape=box,color=red];
		j4102220853 -> j1010511852;
	j1474491724 [label="我無法描述是什麼吸引我來到你身邊。但你永遠不會是一種責任或負擔。",shape=box,color=red];
		j1474491724 -> j1376939062;
	j3760226602 [label="[分手] 這一切對我來說變得太沉重了，我很抱歉。在這裡結束可能最好。",shape=box,color=red];
		j3760226602 -> j2824526336;
	j1010511852 [label="對此我無法表達我的心為你而碎。但我永遠感激我們孤獨的痛苦幽靈找到了彼此。",shape=box,color=blue];
		j1010511852 -> j565787054;
	j1376939062 [label="對此我無法恰當地表達我的感激，我認為任何言語都無法做到。",shape=box,color=blue];
		j1376939062 -> j565787054;
	j2824526336 [label="是的。當然。在這個時候接受任何其他答案都會顯得……虛偽……",shape=box,color=blue];
		j2824526336 -> j4243973687;
	j565787054 [label="但既然我已經費盡心思地完成了這段極其華麗的自我陶醉式開場白……",shape=box,color=blue];
		j565787054 -> j3335449459;
		j565787054 -> j2907365596;
		j565787054 -> j896960276;
	j4243973687 [label="我完全理解。我祝你一切順利。我會珍惜我們一起度過的所有時光。",shape=box,color=blue];
		j4243973687 -> j530993253;
	j3335449459 [label="對於一個一開始沉默的人來說，你真的變得很多話了。",shape=box,color=red];
		j3335449459 -> j2800420631;
	j2907365596 [label="我覺得它們很可愛，別擔心。",shape=box,color=red];
		j2907365596 -> j2736887797;
	j896960276 [label="你本可以只說「你知道，如果我們分道揚鑣，我會沒事的」。",shape=box,color=red];
		j896960276 -> j3700952855;
	j530993253 [label="我會在我的靈魂中記住它們，即使它們從我的腦海中消失。再見了。",shape=box,color=blue];
		j530993253 -> j1597456553;
	j2800420631 [label="+5 Chemistry",color=orange];
		j2800420631 -> j497268897;
	j2736887797 [label="+5 Chemistry",color=orange];
		j2736887797 -> j1522901777;
	j3700952855 [label="+5 Chemistry",color=orange];
		j3700952855 -> j3609002901;
	j1597456553 [label="Boolean LyonDating is now false.",color=orange];
		j1597456553 -> j90727028;
	j497268897 [label="噗！如果你不想了解我思想的內部運作，你就不應該到處戳。這完全是你的錯。",shape=box,color=blue];
		j497268897 -> j1603488610;
	j1522901777 [label="我很高興你喜歡我的思緒漫遊。這正是我選擇盡量少說話的原因。你能想像親自忍受這個嗎？瑪麗多年前就會像瘋狗一樣把我處決了。",shape=box,color=blue];
		j1522901777 -> j1603488610;
	j3609002901 [label="你天生具有一定程度的不敬和諷刺，是我永遠無法企及的。我會讓你決定怎麼想。",shape=box,color=blue];
		j3609002901 -> j1603488610;
	j90727028 [label="Boolean IsDating is now false.",color=orange];
		j90727028 -> j2142921449;
	j1603488610 [label="然而，所有這一切都是為了作為一個故事的序言，與其餘部分相比，這個故事現在看起來會相當簡短……",shape=box,color=blue];
		j1603488610 -> j860806192;
	j2142921449 [label="- 里昂",shape=box,color=blue];
		j2142921449 -> "Chat ends.";
	j860806192 [label="我昨晚從噩夢中醒來。當我醒來時，陰影圍繞著我。在我這種精神狀態下，這並不陌生或新鮮。它們在我的床上隱現，不會消散。",shape=box,color=blue];
		j860806192 -> j3456764212;
	j3456764212 [label="我並不害怕它們，因為我知道它們無法傷害我。然而，它們也不會從我的腦海中消失。我只知道一種方法可以擺脫它們。",shape=box,color=blue];
		j3456764212 -> j3819876710;
	j3819876710 [label="我從床上起身，盡我所能地穿好衣服，在持續的噩夢的模糊視線中蹣跚而行。我抓住我的焚爐，跪在地板中央，準備……嗯。",shape=box,color=blue];
		j3819876710 -> j1843388215;
	j1843388215 [label="我準備「清理我的思緒」。我們就這麼說吧。",shape=box,color=blue];
		j1843388215 -> j440908013;
	j440908013 [label="但當我閉上眼睛時，我的思緒游蕩了。我的思想漂移……到你身上，我的奇蹟……",shape=box,color=blue];
		j440908013 -> j4238527152;
	j4238527152 [label="你的聲音。你的手放在我肩上的觸感……",shape=box,color=blue];
		j4238527152 -> j1894950402;
	j1894950402 [label="然後幻象……逃走了。它們放棄了崗位，被更強大的幽靈趕走了……你的幽靈。",shape=box,color=blue];
		j1894950402 -> j995768261;
	j995768261 [label="我……站起身。把我的焚爐放在床頭櫃上，然後……選擇在聖堂的沙地上散步……",shape=box,color=blue];
		j995768261 -> j201668878;
		j995768261 -> j1592031695;
	j201668878 [label="現在我明白你為什麼需要那段開場白了。",shape=box,color=red];
		j201668878 -> j2941044068;
	j1592031695 [label="我不知道應該說什麼……",shape=box,color=red];
		j1592031695 -> j553568816;
	j2941044068 [label="是的。好吧。在我散步時，我……立即意識到這樣一個時刻的黑暗危機。你可能會……認為這是一種責任，開始把我視為壓在你身上的鎖鏈。",shape=box,color=blue];
		j2941044068 -> j327674638;
	j553568816 [label="+5 Chemistry",color=orange];
		j553568816 -> j405459965;
	j327674638 [label="我懇求你──我祈禱，向任何在高處或下方的神或諸神祈禱──你永遠不要這樣想。這是你給我的禮物，每一次我都會珍惜它帶來的新鮮感。",shape=box,color=blue];
		j327674638 -> j4070273890;
	j405459965 [label="不需要言語，我的奇蹟……",shape=box,color=blue];
		j405459965 -> j2890815435;
	j4070273890 [label="向我發誓，我的奇蹟，如果時候到了，我已經成為你的空籠子……你將擺脫我。",shape=box,color=blue];
		j4070273890 -> j2309315583;
	j2890815435 [label="在我散步時，我……立即意識到這樣一個時刻的黑暗危機。你可能會……認為這是一種責任，開始把我視為壓在你身上的鎖鏈。",shape=box,color=blue];
		j2890815435 -> j327674638;
	j2309315583 [label="我不會成為我所愛之人的空洞監獄。不為你。不為瑪麗。",shape=box,color=blue];
		j2309315583 -> j2647233768;
		j2309315583 -> j2134895339;
	j2647233768 [label="[分手] 我──我不能。我不能承諾那個，我很抱歉。",shape=box,color=red];
		j2647233768 -> j4006725981;
	j2134895339 [label="我發誓。 ",shape=box,color=red];
		j2134895339 -> j147300186;
	j4006725981 [label="+10 Chemistry",color=orange];
		j4006725981 -> j2133828784;
	j147300186 [label="+10 Chemistry",color=orange];
		j147300186 -> j3639929833;
	j2133828784 [label="謝謝你。謝謝你，我的奇蹟，感謝你的誠實。在這一刻這需要勇氣，我為此讚揚你。",shape=box,color=blue];
		j2133828784 -> j1275643667;
	j3639929833 [label="謝謝你。謝謝你，我的奇蹟……",shape=box,color=blue];
		j3639929833 -> j1533983500;
	j1275643667 [label="我會好好珍惜我們一起度過的所有時光。我這份認真遠遠超乎你的想像。",shape=box,color=blue];
		j1275643667 -> j530993253;
	j1533983500 [label="我突然感到非常疲倦，好像……一個巨大的重擔從我肩上卸下。恐怕我必須去躺下了。",shape=box,color=blue];
