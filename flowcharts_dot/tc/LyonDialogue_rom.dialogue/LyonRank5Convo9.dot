digraph {
	"LyonRank5Convo9 begins." [color=orange];
		"LyonRank5Convo9 begins." -> j3594191379;
	j3594191379 [label="Evaluate expressions",color=orange];
		j3594191379 -> "Chat ends." [label="LyonDating, LyonDatingConfession",color=purple];
		j3594191379 -> j936780548 [label="LyonDating",color=purple];
		j3594191379 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j936780548 [label="Mon miracle, I... must make very certain you understand something before I tell you this next anecdote of mine. ",shape=box,color=blue];
		j936780548 -> j4159811722;
	j4159811722 [label="It is important to me that you are paying very close attention to these next words that I send you. Do you understand?",shape=box,color=blue];
		j4159811722 -> j2578999905;
		j4159811722 -> j756815561;
	j2578999905 [label="你讓我覺得很緊張。怎麼了？",shape=box,color=red];
		j2578999905 -> j1069758547;
	j756815561 [label="對，我在這。請說。",shape=box,color=red];
		j756815561 -> j3916973064;
	j1069758547 [label="Nothing is wrong - quite the opposite. That is what is so imperative for you to comprehend - the dire consequences from which I wish to free you, should you assume they might follow.",shape=box,color=blue];
		j1069758547 -> j2778420290;
		j1069758547 -> j3886986957;
		j1069758547 -> j1402889034;
	j3916973064 [label="+5 Chemistry",color=orange];
		j3916973064 -> j3582070553;
	j2778420290 [label="我在聽。",shape=box,color=red];
		j2778420290 -> j2554362356;
	j3886986957 [label="You're not making much sense.",shape=box,color=red];
		j3886986957 -> j680300674;
	j1402889034 [label="Dire consequences of... what?",shape=box,color=red];
		j1402889034 -> j3987381161;
	j3582070553 [label="Thank you. Before I begin I wish to assure you that there is nothing wrong - however, therein lies perhaps the dire consequences from which I wish to free you, should you assume they might follow.",shape=box,color=blue];
		j3582070553 -> j2778420290;
		j3582070553 -> j3886986957;
		j3582070553 -> j1402889034;
	j2554362356 [label="+5 Chemistry",color=orange];
		j2554362356 -> j1431582334;
	j680300674 [label="是的。我對此深有體會。",shape=box,color=blue];
		j680300674 -> j3987381161;
	j3987381161 [label="容許我重新開始過。",shape=box,color=blue];
		j3987381161 -> j1431582334;
	j1431582334 [label="I am aware that I can be construed by many, and in fact, very well might be, in reality, to be... unwell. At the very least, I am not entirely of sound mind.",shape=box,color=blue];
		j1431582334 -> j859227014;
	j859227014 [label="I have long since come to be at peace with this. It does not trouble me any longer. The visions that plague me - the voices - I have come to find ways to live with them without fear or hatred.",shape=box,color=blue];
		j859227014 -> j172510597;
	j172510597 [label="(Lately, I think, a little out of spite if I might be honest, but that is neither here nor there.)",shape=box,color=blue];
		j172510597 -> j177894192;
	j177894192 [label="But I wish you to understand that if you were to end this between us - this bond that I thought was previously heretofore impossible between myself and another -",shape=box,color=blue];
		j177894192 -> j366168809;
	j366168809 [label="If you were to ever let your heart wander away from mine? ",shape=box,color=blue];
		j366168809 -> j783622402;
	j783622402 [label="I will endure, mon miracle.",shape=box,color=blue];
		j783622402 -> j1661396643;
	j1661396643 [label="I will not be consumed by that which has plagued me. ",shape=box,color=blue];
		j1661396643 -> j2851720794;
	j2851720794 [label="Check boolean LyonAllRight",color=orange];
		j2851720794 -> j2593909355 [label=true,color=green];
		j2851720794 -> j3685047443 [label=false,color=brown];
	j2593909355 [label="I will be, to use your colloquialism, \"all right.\" I will find cause to smile and laugh once more.",shape=box,color=blue];
		j2593909355 -> j2564771206;
		j2593909355 -> j3173859274;
	j3685047443 [label="I will survive. I will be fine. I will find cause to smile and laugh once more.",shape=box,color=blue];
		j3685047443 -> j2564771206;
		j3685047443 -> j3173859274;
	j2564771206 [label="Oh, Lyon... you aren't a burden to me.",shape=box,color=red];
		j2564771206 -> j3100575924;
	j3173859274 [label="Are you... saying you want to end things between us?",shape=box,color=red];
		j3173859274 -> j117931688;
	j3100575924 [label="I am simply attempting to free you of any perceived hardship you might feel on my account...",shape=box,color=blue];
		j3100575924 -> j1184286906;
		j3100575924 -> j1500576013;
		j3100575924 -> j3513103224;
	j117931688 [label="No! Anything of the sort! I am simply attempting to free you of any perceived hardship you might feel on my account.",shape=box,color=blue];
		j117931688 -> j1184286906;
		j117931688 -> j1500576013;
		j117931688 -> j3513103224;
	j1184286906 [label="Your pain... echoes a kind of my own. It'd never be a hardship to help you through it.",shape=box,color=red];
		j1184286906 -> j2855601375;
	j1500576013 [label="I can't describe what draws me to you. But you will never be a duty or a burden.",shape=box,color=red];
		j1500576013 -> j373203722;
	j3513103224 [label="[Break up.] This is all just become too much for me, I'm sorry. It might be best to end things here.",shape=box,color=red];
		j3513103224 -> j2844691822;
	j2855601375 [label="To which I cannot express how much my heart breaks in turn for you. But that I am forever grateful that our lonely ghosts of pain have found each other.",shape=box,color=blue];
		j2855601375 -> j4042102795;
	j373203722 [label="To which I cannot properly express my gratitude, and I do not think any words ever can.",shape=box,color=blue];
		j373203722 -> j4042102795;
	j2844691822 [label="Yes. Of course. It would be... hypocritical to accept any other answer at this point in time... ",shape=box,color=blue];
		j2844691822 -> j1228018020;
	j4042102795 [label="But now that I have gone through great pains to go through what has been a most spectacularly self-indulgent preamble...",shape=box,color=blue];
		j4042102795 -> j1429314132;
		j4042102795 -> j3490005444;
		j4042102795 -> j1853939158;
	j1228018020 [label="I understand completely. And I wish you nothing but the best. And I will cherish all the moments we have spent together.",shape=box,color=blue];
		j1228018020 -> j765230948;
	j1429314132 [label="For a guy who started off silent, you really did get wordy.",shape=box,color=red];
		j1429314132 -> j2715272411;
	j3490005444 [label="I find them endearing, don't worry.",shape=box,color=red];
		j3490005444 -> j110500346;
	j1853939158 [label="You could've just said \"I'll be fine, you know, if we ever go our separate ways.\"",shape=box,color=red];
		j1853939158 -> j1531735630;
	j765230948 [label="I will remember them in my soul, even if they vanish from my mind. Farewell.",shape=box,color=blue];
		j765230948 -> j1597456553;
	j2715272411 [label="+5 Chemistry",color=orange];
		j2715272411 -> j650218329;
	j110500346 [label="+5 Chemistry",color=orange];
		j110500346 -> j3707558592;
	j1531735630 [label="+5 Chemistry",color=orange];
		j1531735630 -> j1917666568;
	j1597456553 [label="Boolean LyonDating is now false.",color=orange];
		j1597456553 -> j90727028;
	j650218329 [label="Bah! If you did not wish to be privy to the inner workings of my mind, you should not have gone poking about. You are entirely to blame for that.",shape=box,color=blue];
		j650218329 -> j2689524070;
	j3707558592 [label="I am quite glad you enjoy my wanderings. This is precisely why I choose to speak as little as I do. Can you imagine enduring this in person? Marie would have put me down years ago like a mad dog.",shape=box,color=blue];
		j3707558592 -> j2689524070;
	j1917666568 [label="There is a certain amount of irreverence and sarcasm to which you naturally prevail that I could never hope to ascend. I will leave it to you.",shape=box,color=blue];
		j1917666568 -> j2689524070;
	j90727028 [label="Boolean IsDating is now false.",color=orange];
		j90727028 -> j2142921449;
	j2689524070 [label="Nevertheless, all of this was meant to serve as pretext to a story that will now seem quite short in comparison to the rest...",shape=box,color=blue];
		j2689524070 -> j1463597812;
	j2142921449 [label="- 里昂",shape=box,color=blue];
		j2142921449 -> "Chat ends.";
	j1463597812 [label="I awoke last night from a nightmare. When I did, shadows surrounded me. This is nothing foreign or new in my state of mind. They loomed over my bed, and would not clear.",shape=box,color=blue];
		j1463597812 -> j2030553251;
	j2030553251 [label="I was not frightened of them, for I knew they could not harm me. However, they would not be gone from my mind, either. There was only one I knew to be rid of them.",shape=box,color=blue];
		j2030553251 -> j625061232;
	j625061232 [label="Pushing up from bed, I dressed as best I could, staggering through the blurry vision of the continued nightmare. I grasped my thurible and fell to my knees in the middle of my floor, and prepared to... well. ",shape=box,color=blue];
		j625061232 -> j2270183965;
	j2270183965 [label="I prepared to \"clear my mind.\" We shall leave it at that.",shape=box,color=blue];
		j2270183965 -> j2655476814;
	j2655476814 [label="But as I shut my eyes, my mind wandered. My thoughts drifted... to you, mon miracle...",shape=box,color=blue];
		j2655476814 -> j1985151467;
	j1985151467 [label="The sound of your voice. The touch of your hand upon my shoulder... ",shape=box,color=blue];
		j1985151467 -> j1757109856;
	j1757109856 [label="And the visions... fled. They abandoned their post, chased away by the stronger ghost... of you.",shape=box,color=blue];
		j1757109856 -> j3540069305;
	j3540069305 [label="I... stood. Placed my thurible upon the nightstand, and... opted to walk through the sand of the Sanctum instead...",shape=box,color=blue];
		j3540069305 -> j1724503260;
		j3540069305 -> j680380100;
	j1724503260 [label="I can understand why you felt the need for the preamble, now.",shape=box,color=red];
		j1724503260 -> j2444701236;
	j680380100 [label="我不知道應該說什麼……",shape=box,color=red];
		j680380100 -> j3279927297;
	j2444701236 [label="Yes. Well. On my walk I... instantly realized the dark danger of such a moment. That you might... come to think it a responsibility - come to see me as chains that weigh you down.",shape=box,color=blue];
		j2444701236 -> j1499421918;
	j3279927297 [label="+5 Chemistry",color=orange];
		j3279927297 -> j3899625316;
	j1499421918 [label="I beg of you - I pray, to any god or gods on high or below - that you never do. This is a gift you have given me, and each time in its newness I will cherish it.",shape=box,color=blue];
		j1499421918 -> j1844748948;
	j3899625316 [label="There are no words needed, mon miracle... ",shape=box,color=blue];
		j3899625316 -> j2410649970;
	j1844748948 [label="Vow to me, mon miracle - that should the time come, that I have become for you an empty cage... you will be free of me.",shape=box,color=blue];
		j1844748948 -> j2136586070;
	j2410649970 [label="On my walk I... instantly realized the dark danger of such a moment. That you might... come to think it a responsibility - come to see me as chains that weigh you down.",shape=box,color=blue];
		j2410649970 -> j1499421918;
	j2136586070 [label="I shall be no hollow prison for those I love. Not for you. Not for Marie.",shape=box,color=blue];
		j2136586070 -> j460393089;
		j2136586070 -> j1271436036;
	j460393089 [label="[Break up.] I - I can't. I can't promise that, I'm sorry.",shape=box,color=red];
		j460393089 -> j943829648;
	j1271436036 [label="我發誓。 ",shape=box,color=red];
		j1271436036 -> j3522716974;
	j943829648 [label="+10 Chemistry",color=orange];
		j943829648 -> j709023392;
	j3522716974 [label="+10 Chemistry",color=orange];
		j3522716974 -> j29012984;
	j709023392 [label="Thank you. Thank you, mon miracle, for your honesty. This took bravery, in this moment, and I commend you for it.",shape=box,color=blue];
		j709023392 -> j496650400;
	j29012984 [label="Thank you. Thank you, mon miracle...",shape=box,color=blue];
		j29012984 -> j2588819817;
	j496650400 [label="我會好好珍惜我們一起度過的所有時光。我這份認真遠遠超乎你的想像。",shape=box,color=blue];
		j496650400 -> j765230948;
	j2588819817 [label="I am suddenly so very tired, as if... a great weight has been lifted from my shoulders. I fear I must go lie down.",shape=box,color=blue];
		j2588819817 -> j3994987466;
	j3994987466 [label="- 里昂",shape=box,color=blue];
		j3994987466 -> j3446510588;
	j3446510588 [label="Boolean LyonDatingConfession is now true.",color=orange];
		j3446510588 -> "Chat ends.";
}