digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank4Convo2 begins." [color=orange];
		"LyonRank4Convo2 begins." -> j2243582331;
		"LyonRank4Convo2 begins." -> j2999205773;
		"LyonRank4Convo2 begins." -> j1350559949;
	j2243582331 [label="你和瑪麗身為神父和修女，怎麼能同時又……犯下暴力罪行的呢？",shape=box,color=red];
		j2243582331 -> j1301954128;
		j2243582331 -> j3970877152;
		j2243582331 -> j3919826248;
	j2999205773 [label="里昂，我可以問你一個有點奇怪的問題嗎？",shape=box,color=red];
		j2999205773 -> j4043092183;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j1301954128 [label="我聽到瑪麗喊著「異教徒！」就衝進戰鬥了，但……我實在不覺得她是那種會因為信仰不同就譴責別人的人。我想你也應該跟她差不多。她顯然很欣賞你。",shape=box,color=red];
		j1301954128 -> j1564681119;
	j3970877152 [label="你們教會對你和瑪麗在這裡做的事情會有什麼看法？關於……你們被要求以祂們的名義做的事？",shape=box,color=red];
		j3970877152 -> j4290956862;
	j3919826248 [label="我看著你和瑪麗在戰場上拼殺，然後我私下和她說話，又看到你靜靜讀書……我實在很難將這些景象裡的人在腦中聯繫起來。\n",shape=box,color=red];
		j3919826248 -> j4240355691;
	j4043092183 [label="如果你只用「怪異」來形容我們現在的困境，那我要麼是佩服你的剛毅，要麼是替你可憐的詞彙量感到遺憾。不過，我猜應該是前者吧。",shape=box,color=blue];
		j4043092183 -> j2116511520;
	"Chat ends." [color=orange];
	j1564681119 [label="你說得完全正確。瑪麗不會因為別人心中懷有古老的樹神信仰就譴責他們——相反，她會努力尋找自己與他們共同的信仰。",shape=box,color=blue];
		j1564681119 -> j3220143988;
	j4290956862 [label="過去，人們藉著太陽或太陰的名義發動了許多聖戰。血腥的「十字軍東征」就為了驅逐「異教徒」或「奪回聖地」，或其他任何當時流行的牽強附會的理由。",shape=box,color=blue];
		j4290956862 -> j1084497696;
	j4240355691 [label="你說得沒錯。當瑪麗在戰場上與敵人交戰時，我相信不外乎兩種情況：其一，她不過是在玩一場遊戲，扮演古代的聖戰士，幻想自己身穿日尊騎士的閃耀鎧甲——",shape=box,color=blue];
		j4240355691 -> j3182147195;
	j2116511520 [label="+5 Chemistry",color=orange];
		j2116511520 -> j1933732392;
	j3220143988 [label="難道那棵樹不是沐浴著太陽的光芒嗎？難道她就不能和他們分享麵包嗎？她更願意坐下來傾聽他們的故事，而不是因為他們的信仰而傷害他們。",shape=box,color=blue];
		j3220143988 -> j3730820474;
	j1084497696 [label="聖光會正統教派沒有軍隊，也不會發動戰爭。但他們也不禁止教團成員採取行動，或保護他人。",shape=box,color=blue];
		j1084497696 -> j3651640768;
	j3182147195 [label="或者，更有可能的是，她記起了《阿斯弗記》八章二十三節：「試圖以暴力進入我的家園的靈魂是孤獨的，因為他們是被太陽之光拋棄的人。」",shape=box,color=blue];
		j3182147195 -> j1474062728;
	j1933732392 [label="也就是說，是的，繼續吧。不管你好奇什麼，也不會讓我覺得更「怪異」了。",shape=box,color=blue];
		j1933732392 -> j1301954128;
		j1933732392 -> j3970877152;
		j1933732392 -> j3919826248;
	j3730820474 [label="當她在戰場上與敵人交戰時，我相信不外乎兩種情況：其一，她不過是在玩一場遊戲，扮演古代的聖戰士，幻想自己身穿日尊騎士的閃耀鎧甲——",shape=box,color=blue];
		j3730820474 -> j3182147195;
	j3651640768 [label="當瑪麗在戰場上與敵人交戰時，我相信不外乎兩種情況：其一，她不過是在玩一場遊戲，扮演古代的聖戰士，幻想自己身穿日尊騎士的閃耀鎧甲——",shape=box,color=blue];
		j3651640768 -> j3182147195;
	j1474062728 [label="在她眼中，她犯下的暴力行為是正當的，因為這是為了守護至高的善。我想，你和那些與你並肩作戰的人也會這麼認為。",shape=box,color=blue];
		j1474062728 -> j1953681691;
	j1953681691 [label="因此，她所對抗的人——無論信仰什麼——都早已被太陽拋棄了。即使他們穿著與她相同的聖袍，在她眼中，他們也是異教徒。",shape=box,color=blue];
		j1953681691 -> j3565525518;
		j1953681691 -> j222086199;
	j3565525518 [label="我注意到你把自己排除在外了。你對這些戰鬥有什麼感覺？",shape=box,color=red];
		j3565525518 -> j3736853033;
	j222086199 [label="明白。謝謝。",shape=box,color=red];
		j222086199 -> j3655618514;
	j3736853033 [label="我是故意迴避的，漂泊者。",shape=box,color=blue];
		j3736853033 -> j3108619213;
		j3736853033 -> j3790709222;
	j3655618514 [label="+5 Chemistry",color=orange];
		j3655618514 -> j1201889110;
	j3108619213 [label="我是有意糾纏的，神父。",shape=box,color=red];
		j3108619213 -> j2020286754;
	j3790709222 [label="好吧。今天我能知道多少就知道多少吧。",shape=box,color=red];
		j3790709222 -> j3655618514;
	j1201889110 [label="不管怎樣，瑪麗……告訴我你是出於好意。即使我自己都不相信，我也相信她。",shape=box,color=blue];
		j1201889110 -> j808687592;
	j2020286754 [label="+10 Chemistry",color=orange];
		j2020286754 -> j1099389933;
	j808687592 [label="到頭來，我或許只能懇求你們的耐心了。 太陰知道，大多數時候我對自己都缺乏耐心。",shape=box,color=blue];
		j808687592 -> j2331496732;
	j1099389933 [label="很好。既然你不願放棄，而且如此渴望知道的話，我對我造成的死亡並沒有像……你可能預期的那樣感到困擾。",shape=box,color=blue];
		j1099389933 -> j2767279903;
	j2331496732 [label="-里昂・阿拉德神父",shape=box,color=blue];
		j2331496732 -> "Chat ends.";
	j2767279903 [label="或者說，對於像我這樣的神職人員和學者來說，這可能是「恰當的」。",shape=box,color=blue];
		j2767279903 -> j3899712058;
		j2767279903 -> j3759326648;
	j3899712058 [label="里昂，在我生命裡經歷過的戰爭比和平多得多。如果我受它困擾的話，我想我早已不在人世了。但這不代表它沒有帶來真正的負擔——真正的代價。",shape=box,color=red];
		j3899712058 -> j4149869488;
	j3759326648 [label="我相信其他人已經告訴過你我是誰了。我是什麼。我的來歷。伴隨著我的死亡——我來自的死亡。定義我的死亡。你覺得你的任何感受會讓我感到驚訝嗎？",shape=box,color=red];
		j3759326648 -> j3650648624;
	j4149869488 [label="Add 1 to Thermostat counter",color=orange];
		j4149869488 -> j1413622569;
	j3650648624 [label="Add -1 to Thermostat counter",color=orange];
		j3650648624 -> j4284384904;
	j1413622569 [label="是的，它會。",shape=box,color=blue];
		j1413622569 -> j2739433833;
		j1413622569 -> j3950667062;
	j4284384904 [label="是的。",shape=box,color=blue];
		j4284384904 -> j2739433833;
		j4284384904 -> j3950667062;
	j2739433833 [label="抱歉。我覺得我讓你難過了。我不是故意的。",shape=box,color=red];
		j2739433833 -> j2759740555;
	j3950667062 [label="你……可否詳細說明一下？",shape=box,color=red];
		j3950667062 -> j1475301209;
	j2759740555 [label="這不是你的錯，漂泊者。我，就像我們來自自由國的弟兄姐妹可能會說的那樣，是個「難啃的硬骨頭」。",shape=box,color=blue];
		j2759740555 -> j877909628;
	j1475301209 [label="在我腦中迴盪的恐懼似乎沒有邊界。我目睹了曾經滲著鮮紅血液的人類肌腱，如今變得脆弱焦黑。",shape=box,color=blue];
		j1475301209 -> j294958789;
	j877909628 [label="我只是一個被圍困的個體。我必須守住城牆。一旦大門開啟，便會危及防禦的完整性。",shape=box,color=blue];
		j877909628 -> j3149245151;
		j877909628 -> j3961223903;
	j294958789 [label="我看到千千萬萬張與我相似卻陌生的面孔。空洞的靈柩，扭曲破碎的凡人之軀，懸吊在生與死的帷幕之間。",shape=box,color=blue];
		j294958789 -> j3828538969;
	j3149245151 [label="我明白。等你準備好了，我們再說。",shape=box,color=red];
		j3149245151 -> j1035246517;
	j3961223903 [label="你是什麼意思？",shape=box,color=red];
		j3961223903 -> j1475301209;
	j3828538969 [label="他們的表情凝固在空洞的平靜面具所掩蓋。但在他們靈魂閃爍的殘餘中，我聽到他們在吶喊。無止境地嚎叫著復仇。為了自由。",shape=box,color=blue];
		j3828538969 -> j2855393617;
	j1035246517 [label="我開始越來越清楚地意識到，在這件事上我別無他選。",shape=box,color=blue];
		j1035246517 -> j3468663926;
	j2855393617 [label="為了死亡。",shape=box,color=blue];
		j2855393617 -> j198173741;
	j3468663926 [label="+15 Chemistry",color=orange];
		j3468663926 -> j3254446247;
	j198173741 [label="這些幻象困擾著我，在我清醒之時，又在我做夢之時。我沒有惡夢，因為我所經歷的只有這些──我已經變成這樣了。",shape=box,color=blue];
		j198173741 -> j1274675553;
	j3254446247 [label="但是，不管怎樣，瑪麗……告訴我你是出於好意。即使我自己都不相信，我也相信她。",shape=box,color=blue];
		j3254446247 -> j2092360979;
	j1274675553 [label="Check boolean LyonPainOff",color=orange];
		j1274675553 -> j2634327446 [label=true,color=green];
		j1274675553 -> j307564687 [label=false,color=brown];
	j2092360979 [label="到頭來，我或許只能懇求你們的耐心了。 太陰知道，大多數時候我對自己都缺乏耐心。",shape=box,color=blue];
		j2092360979 -> j1234693651;
	j2634327446 [label="只有當我順從內心深處的低語時，世界才會以你可能熟悉的方式反映在我面前。",shape=box,color=blue];
		j2634327446 -> j4081285919;
	j307564687 [label="只有當我將血肉從身體上撕裂，作為獻祭給靈魂深處迴盪的低語時，世界才會以你可能熟悉的方式反映在我面前。",shape=box,color=blue];
		j307564687 -> j4081285919;
	j1234693651 [label="-里昂・阿拉德神父",shape=box,color=blue];
		j1234693651 -> j2522325746;
	j4081285919 [label="漂泊者，請切勿妄稱了解我的「感受」。這一切恐怕你才剛開始明白。",shape=box,color=blue];
		j4081285919 -> j569169012;
		j4081285919 -> j4144275582;
		j4081285919 -> j3726129586;
	j2522325746 [label="Boolean LyonVisions2d is now true.",color=orange];
		j2522325746 -> "Chat ends.";
	j569169012 [label="我……對不起。不，我當時不知道。",shape=box,color=red];
		j569169012 -> j503539737;
	j4144275582 [label="里昂，我還目睹了許多你無法理解的恐怖跟痛苦。",shape=box,color=red];
		j4144275582 -> j1205029718;
	j3726129586 [label="如果你覺得我的話不合時宜，我很抱歉。但我很想了解。你的這些幻象……",shape=box,color=red];
		j3726129586 -> j3037580086;
	j503539737 [label="是的。好吧。我熬過了這麼多年。我肯定能再堅持一段時間。你不必太過擔心。",shape=box,color=blue];
		j503539737 -> j4270520825;
	j1205029718 [label="我非常肯定你已經有所體會，因為從這個地方的景像中就能看出一些端倪。但你認為自己高人一等嗎？是洞悉一切恐怖與苦難的至高無上的存在嗎？",shape=box,color=blue];
		j1205029718 -> j276432138;
		j1205029718 -> j1337217273;
	j3037580086 [label="是的。好吧。這麼多年來我都熬過了。我肯定能再堅持一段時間。你不必太過擔心。",shape=box,color=blue];
		j3037580086 -> j4270520825;
	j4270520825 [label="Boolean LyonVisions2a is now true.",color=orange];
		j4270520825 -> j3335552504;
		j4270520825 -> j2582183696;
	j276432138 [label="我的意思是我可能比你想像的更能明白你的感受。",shape=box,color=red];
		j276432138 -> j1154582413;
	j1337217273 [label="我的意思是我經歷過太多恐怖與死亡，里昂。所以我不喜歡別人用居高臨下的語氣跟我說話。",shape=box,color=red];
		j1337217273 -> j4006722487;
	j3335552504 [label="里昂，你所描述的…這種景像是在你成為原型 Warframe 之前還是之後所產生的？",shape=box,color=red];
		j3335552504 -> j2999741913;
	j2582183696 [label="我們能再談一下這件事嗎？拜託？",shape=box,color=red];
		j2582183696 -> j23037597;
	j1154582413 [label="Boolean LyonVisions2b is now true.",color=orange];
		j1154582413 -> j833325849;
	j4006722487 [label="Boolean LyonVisions2c is now true.",color=orange];
		j4006722487 -> j1993952026;
	j2999741913 [label="如果這個問題真像你認為的那麼簡單就好了。不過，我今天不想回答這個問題。我覺得快要頭痛了。",shape=box,color=blue];
		j2999741913 -> j378132294;
	j23037597 [label="我開始越來越清楚地意識到，在這件事上我別無他選。",shape=box,color=blue];
		j23037597 -> j378132294;
	j833325849 [label="漂泊者，或許你會覺得奇怪，我並非尋求同情。我尋求的是答案，是確定性，是蒼穹，當一切都是幻象跟謊言之時。",shape=box,color=blue];
		j833325849 -> j566136442;
		j833325849 -> j3976471452;
	j1993952026 [label="那麼，請允許我匍匐在您的腳下。讚美你所承受的一切。驚嘆於你目睹了那麼多，卻還能保持清醒。",shape=box,color=blue];
		j1993952026 -> j1022198327;
	j378132294 [label="+10 Chemistry",color=orange];
		j378132294 -> j2000305509;
	j566136442 [label="我會盡力而為。",shape=box,color=red];
		j566136442 -> j768051224;
	j3976471452 [label="那或許我可以幫到你。我們能再談談這件事嗎？拜託了？",shape=box,color=red];
		j3976471452 -> j23037597;
	j1022198327 [label="而且我很驚訝，你怎麼還有時間關心我們這些在你高人一等的地位之下的人。",shape=box,color=blue];
		j1022198327 -> "Chat ends.";
	j2000305509 [label="但是，不管怎樣，瑪麗……告訴我你是出於好意。即使我自己都不相信，我也相信她。",shape=box,color=blue];
		j2000305509 -> j808687592;
	j768051224 [label="+5 Chemistry",color=orange];
		j768051224 -> j3069717847;
	j3069717847 [label="這不就是我們所渴求的嗎？",shape=box,color=blue];
		j3069717847 -> "Chat ends.";
}