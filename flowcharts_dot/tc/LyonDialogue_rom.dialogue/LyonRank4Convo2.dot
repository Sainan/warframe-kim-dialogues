digraph {
	"LyonRank4Convo2 begins." [color=orange];
		"LyonRank4Convo2 begins." -> j583714901;
		"LyonRank4Convo2 begins." -> j516450741;
		"LyonRank4Convo2 begins." -> j1350559949;
	j583714901 [label="How is it that you and Marie can reconcile being a priest and a nun, but also... committing acts of violence?",shape=box,color=red];
		j583714901 -> j1604356449;
		j583714901 -> j2552179655;
		j583714901 -> j851731309;
	j516450741 [label="里昂，我可以問你一個有點奇怪的問題嗎？",shape=box,color=red];
		j516450741 -> j3784073089;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j1604356449 [label="I hear Marie shout \"païens!\" and rush off into the fight, and... yet I have a hard time thinking her the kind of person to condemn someone for differing beliefs. I can't imagine you must be much different, either. She clearly thinks so highly of you.",shape=box,color=red];
		j1604356449 -> j2615416336;
	j2552179655 [label="How would your church feel about what you and Marie are here doing? About... what you're being asked to do in their name?",shape=box,color=red];
		j2552179655 -> j1049618698;
	j851731309 [label="I watch you and Marie on the battlefield, and then I speak to her in private, and I see you quietly reading books... and I suppose I am having a hard time making those individuals line up in my mind.",shape=box,color=red];
	j3784073089 [label="If you find the ability to describe our current predicament as simply \"odd\" I am either impressed by your fortitude or dismayed by your lack of vocabulary. I suspect, however, it is the former.",shape=box,color=blue];
		j3784073089 -> j1156330686;
	"Chat ends." [color=orange];
	j2615416336 [label="You are quite right. Marie is not the kind to condemn another for holding in their hearts an ancient god of trees - instead, she would seek to find what beliefs she held in common with them.",shape=box,color=blue];
		j2615416336 -> j3447735129;
	j1049618698 [label="Many a holy war was waged in its day in the name of Sol or Lua. Bloody \"crusades\" to drive back \"heathens\" or to \"take holy land\" or whatever contrived reasoning was the favorite of the day.",shape=box,color=blue];
		j1049618698 -> j403281261;
	j1156330686 [label="+5 Chemistry",color=orange];
		j1156330686 -> j2840151376;
	j3447735129 [label="Is the tree not nourished by the light of Sol, perhaps? Is there not a common ground on which she could break bread with them? She is more apt to sit and listen to their stories, than seek to harm them for their faith.",shape=box,color=blue];
		j3447735129 -> j4034901687;
	j403281261 [label="The Luminary Orthodoxy has no army, and wages no wars. They do not bar those in their order to take actions or to protect others.",shape=box,color=blue];
		j403281261 -> j1768255781;
	j2840151376 [label="That is, to say, yes, proceed. You cannot make this any more \"odd\" for me by asking whatever it is over which you are curious.",shape=box,color=blue];
		j2840151376 -> j1604356449;
		j2840151376 -> j2552179655;
		j2840151376 -> j851731309;
	j4034901687 [label="When she engages with her foe upon the battlefield, I believe it is one of two things: either, she is having a bit of fun, play-acting as an ancient crusader, imagining herself in the shining armor of a Knight of Sol -",shape=box,color=blue];
		j4034901687 -> j3397315241;
	j1768255781 [label="When Marie engages with her foes upon the battlefield, I believe it is one of two things: either, she is having a bit of fun, play-acting as an ancient crusader, imagining herself in the shining armor of a Knight of Sol -",shape=box,color=blue];
		j1768255781 -> j3397315241;
	j3397315241 [label="Or, most likely, she is remembering Astaphor 8:23 \"Lonely are the souls who seek to enter my house by violence, for they are the ones cast from the light of Sol.\"",shape=box,color=blue];
		j3397315241 -> j1391590534;
	j1391590534 [label="In her eyes, the violence she commits is righteous in the name of defending a greater good - as would you, as would those you fight beside, I assume. ",shape=box,color=blue];
		j1391590534 -> j8374536;
	j8374536 [label="And, therefore, those she fights - regardless of their religion - are cast from Sol. Even if they were to wear the holy cloth of her own order, they are in her eyes, heathens.",shape=box,color=blue];
		j8374536 -> j2036961850;
		j8374536 -> j2170945823;
	j2036961850 [label="I notice you left yourself out of this. How do you feel about all the fighting?",shape=box,color=red];
		j2036961850 -> j3054598496;
	j2170945823 [label="明白。謝謝。",shape=box,color=red];
		j2170945823 -> j2941890968;
	j3054598496 [label="I am being intentionally elusive, Drifter.",shape=box,color=blue];
		j3054598496 -> j3440315115;
		j3054598496 -> j1637703533;
	j2941890968 [label="+5 Chemistry",color=orange];
		j2941890968 -> j2163171357;
	j3440315115 [label="And I am being pointedly persistent, Priest.",shape=box,color=red];
		j3440315115 -> j2503570629;
	j1637703533 [label="Fair enough. I'll take what I can get today.",shape=box,color=red];
		j1637703533 -> j2941890968;
	j2163171357 [label="For what it is worth, Marie... has told me you mean well. And I believe her, even when I do not believe myself.",shape=box,color=blue];
		j2163171357 -> j2959315451;
	j2503570629 [label="+10 Chemistry",color=orange];
		j2503570629 -> j3157379558;
	j2959315451 [label="All I may do is beg your patience, in the end. Lua knows I run short of it with myself most days.",shape=box,color=blue];
		j2959315451 -> j944546954;
	j3157379558 [label="Very well. If you will not be dissuaded, and you are so curious? I am not as troubled by the death I cause as... perhaps you might expect.",shape=box,color=blue];
		j3157379558 -> j520204221;
	j944546954 [label="-F. Lyon Allard",shape=box,color=blue];
		j944546954 -> "Chat ends.";
	j520204221 [label="Or that one might feel is \"proper\" for a man of the cloth and a scholar such as I.",shape=box,color=blue];
		j520204221 -> j2169526290;
		j520204221 -> j3056551528;
	j2169526290 [label="I've known more war than peace in my life, Lyon. If I let it trouble me, I don't think I would still be here. But that isn't to say it doesn't still come with a real burden - a real cost.",shape=box,color=red];
		j2169526290 -> j3467249208;
	j3056551528 [label="I'm sure the others have told you who I am. What I am. Where I've come from. The death that follows me - the death I've come from. The death that defines me. Do you think anything you feel will surprise me?",shape=box,color=red];
		j3056551528 -> j158781669;
	j3467249208 [label="Add 1 to Thermostat counter",color=orange];
		j3467249208 -> j2911912479;
	j158781669 [label="Add -1 to Thermostat counter",color=orange];
		j158781669 -> j1894648924;
	j2911912479 [label="Yes, it does.",shape=box,color=blue];
		j2911912479 -> j1484276980;
		j2911912479 -> j4202539200;
	j1894648924 [label="Yes, I do.",shape=box,color=blue];
		j1894648924 -> j1484276980;
		j1894648924 -> j4202539200;
	j1484276980 [label="I'm sorry. I feel I've upset you. That wasn't my intention.",shape=box,color=red];
		j1484276980 -> j2509781752;
	j4202539200 [label="你……可否詳細說明一下？",shape=box,color=red];
		j4202539200 -> j1586803457;
	j2509781752 [label="You are not to blame, Drifter. I am, as our brothers and sisters from Libertatia might say, a \"hard nut to crack.\"",shape=box,color=blue];
		j2509781752 -> j2868871722;
	j1586803457 [label="The horrors that echo within my mind seem to know no boundaries. I witness chains of human sinew that once oozed with fresh crimson, turned brittle and blackened.",shape=box,color=blue];
		j1586803457 -> j619593295;
	j2868871722 [label="I am merely a besieged individual. I hold the wall. To open the gate is to threaten the integrity of the defenses.",shape=box,color=blue];
		j2868871722 -> j3659910425;
		j2868871722 -> j618207762;
	j619593295 [label="I see a hundred thousand visages of my own self, similar but foreign. Hollowed caskets, corpses of twisted, broken human flesh, suspended in the veil between life and death.",shape=box,color=blue];
		j619593295 -> j3728128003;
	j3659910425 [label="我明白。等你準備好了，我們再說。",shape=box,color=red];
		j3659910425 -> j736927038;
	j618207762 [label="你是什麼意思？",shape=box,color=red];
		j618207762 -> j1586803457;
	j3728128003 [label="Expressions locked in a mask of empty repose. But in the flickering remains of their souls, embers that linger and do not die, I hear them screaming. Endlessly howling for retribution. For freedom.",shape=box,color=blue];
		j3728128003 -> j2666648367;
	j736927038 [label="I am starting to come to the distinct impression that I do not have a choice in this matter.",shape=box,color=blue];
		j736927038 -> j938209347;
	j2666648367 [label="For death.",shape=box,color=blue];
		j2666648367 -> j2593910760;
	j938209347 [label="+15 Chemistry",color=orange];
		j938209347 -> j1192456601;
	j2593910760 [label="These visions haunt my waking hours. My dreams. I have no nightmares, for that is all I experience - all I have become.",shape=box,color=blue];
		j2593910760 -> j1274675553;
	j1192456601 [label="But, for what it is worth, Marie... has told me you mean well. And I believe her, even when I do not believe myself.",shape=box,color=blue];
		j1192456601 -> j2455985978;
	j1274675553 [label="Check boolean LyonPainOff",color=orange];
		j1274675553 -> j1935970551 [label=true,color=green];
		j1274675553 -> j241308745 [label=false,color=brown];
	j2455985978 [label="All I may do is beg your patience, in the end. Lua knows I run short of it with myself most days.",shape=box,color=blue];
		j2455985978 -> j156526603;
	j1935970551 [label="Only when I sacrifice to the whispers that echo within my soul, is the world reflected to me in a manner similar to that which you might find familiar.",shape=box,color=blue];
		j1935970551 -> j3769690399;
	j241308745 [label="Only when I rend the flesh from my body as a sacrifice to the whispers that echo within my soul, is the world reflected to me in a manner similar to that which you might find familiar.",shape=box,color=blue];
		j241308745 -> j3769690399;
	j156526603 [label="- 里昂・阿拉德神父",shape=box,color=blue];
		j156526603 -> j2522325746;
	j3769690399 [label="Kindly do not pretend to know of what I \"feel,\" Drifter. I fear you have only begun to understand.",shape=box,color=blue];
		j3769690399 -> j908250128;
		j3769690399 -> j3002022287;
		j3769690399 -> j2255755756;
	j2522325746 [label="Boolean LyonVisions2d is now true.",color=orange];
		j2522325746 -> "Chat ends.";
	j908250128 [label="我……對不起。不，我當時不知道。",shape=box,color=red];
		j908250128 -> j2902539613;
	j3002022287 [label="里昂，我還目睹了許多你無法理解的恐怖跟痛苦。",shape=box,color=red];
		j3002022287 -> j945946918;
	j2255755756 [label="I'm sorry if you feel I spoke out of turn. But I want to understand. These visions of yours...",shape=box,color=red];
		j2255755756 -> j102031654;
	j2902539613 [label="Yes. Well. I have survived these long years. I will hold strong a few more, I am certain. You needn't worry over much.",shape=box,color=blue];
		j2902539613 -> j4270520825;
	j945946918 [label="I am most certain you have, seeing some of it reflected in the imagery of this place. But do you think yourself paramount? Supreme Knower of All Horrors and All Suffering?",shape=box,color=blue];
		j945946918 -> j276432138;
		j945946918 -> j39295631;
	j102031654 [label="Yes. Well. I have withstood them all my years. I will hold strong a few more, I am certain. You needn't worry over much.",shape=box,color=blue];
		j102031654 -> j4270520825;
	j4270520825 [label="Boolean LyonVisions2a is now true.",color=orange];
		j4270520825 -> j4021021885;
		j4270520825 -> j2864297936;
	j276432138 [label="我的意思是我可能比你想像的更能明白你的感受。",shape=box,color=red];
		j276432138 -> j1154582413;
	j39295631 [label="I'm saying I've been through a lot of death and horror, Lyon. So I don't enjoy being spoken down to over it.",shape=box,color=red];
		j39295631 -> j2031743382;
	j4021021885 [label="里昂，你所描述的…這種景像是在你成為原型 Warframe 之前還是之後所產生的？",shape=box,color=red];
		j4021021885 -> j1205035694;
	j2864297936 [label="我們能再談一下這件事嗎？拜託？",shape=box,color=red];
		j2864297936 -> j2291701031;
	j1154582413 [label="Boolean LyonVisions2b is now true.",color=orange];
		j1154582413 -> j833325849;
	j2031743382 [label="Boolean LyonVisions2c is now true.",color=orange];
		j2031743382 -> j3316146926;
	j1205035694 [label="如果這個問題真像你認為的那麼簡單就好了。不過，我今天不想回答這個問題。我覺得快要頭痛了。",shape=box,color=blue];
		j1205035694 -> j3024606693;
	j2291701031 [label="我開始越來越清楚地意識到，在這件事上我別無他選。",shape=box,color=blue];
		j2291701031 -> j3024606693;
	j833325849 [label="漂泊者，或許你會覺得奇怪，我並非尋求同情。我尋求的是答案，是確定性，是蒼穹，當一切都是幻象跟謊言之時。",shape=box,color=blue];
		j833325849 -> j566136442;
		j833325849 -> j2252670754;
	j3316146926 [label="Than allow me to bow down at your feet. Praise you for all you have endured. Wonder how you are still sane for all you have witnessed.",shape=box,color=blue];
		j3316146926 -> j1653090935;
	j3024606693 [label="+10 Chemistry",color=orange];
		j3024606693 -> j3557979583;
	j566136442 [label="我會盡力而為。",shape=box,color=red];
		j566136442 -> j768051224;
	j2252670754 [label="那或許我可以幫到你。我們能再談談這件事嗎？拜託了？",shape=box,color=red];
		j2252670754 -> j2291701031;
	j1653090935 [label="And marvel over how you still spare time for all the rest of us who you view so far beneath your vaulted status.",shape=box,color=blue];
		j1653090935 -> "Chat ends.";
	j3557979583 [label="但是，不管怎樣，瑪麗……告訴我你是出於好意。即使我自己都不相信，我也相信她。",shape=box,color=blue];
		j3557979583 -> j3484237911;
	j768051224 [label="+5 Chemistry",color=orange];
		j768051224 -> j3069717847;
	j3484237911 [label="到頭來，我或許只能懇求你們的耐心了。 太陰知道，大多數時候我對自己都缺乏耐心。",shape=box,color=blue];
		j3484237911 -> j944546954;
	j3069717847 [label="這不就是我們所渴求的嗎？",shape=box,color=blue];
		j3069717847 -> "Chat ends.";
}