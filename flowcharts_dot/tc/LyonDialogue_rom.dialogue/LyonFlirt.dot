	j404236366 [label="里昂？我們可以談一談嗎？ ",shape=box,color=red];
		j404236366 -> j3134880436;
	j736510910 [label="里昂？如果我說的話讓你覺得不舒服，我十分十分抱歉。那並非我的本意。",shape=box,color=red];
		j736510910 -> j3666572548;
	j1284230352 [label="[結束]",shape=box,color=red];
		j1284230352 -> j2883342425;
	j3134880436 [label="漂泊者，你想討論些什麼？",shape=box,color=blue];
		j3134880436 -> j550300316;
	j3666572548 [label="那麼，我只能納悶，如果你不是為了自己高興而故意跟我調情讓我感到不舒服……那你當初為什麼要跟我調情呢？",shape=box,color=blue];
		j3666572548 -> j2836271551;
		j3666572548 -> j1837589654;
		j3666572548 -> j2885604281;
	j2883342425 [label="Boolean LyonFlirtIgnored is now true.",color=orange];
		j2883342425 -> "Chat ends.";
	j550300316 [label="你這些輕佻的言論只是為了自娛嗎？還是你想換個話題？",shape=box,color=blue];
		j550300316 -> j1564615446;
		j550300316 -> j3492467811;
		j550300316 -> j2885604281;
	j2836271551 [label="里昂，我對你很有興趣。就是這麼簡單。",shape=box,color=red];
		j2836271551 -> j2254068441;
	j1837589654 [label="里昂，我不知道自己當時怎麼了。明顯這一切都是個錯誤。我非常抱歉。",shape=box,color=red];
		j1837589654 -> j3381683973;
	j2885604281 [label="我……說的都是真心話。但一切發生得太快了，我明白。",shape=box,color=red];
		j2885604281 -> j3381683973;
	"Chat ends." [color=orange];
	j1564615446 [label="里昂，我跟你調情不是為了玩。如果你誤會了，我很抱歉。",shape=box,color=red];
		j1564615446 -> j3381683973;
	j3492467811 [label="我不是要故意冒犯你的，我只是在開玩笑。對不起。",shape=box,color=red];
		j3492467811 -> j2847468712;
	j2254068441 [label="而我沒有相同感覺。就這麼簡單。",shape=box,color=blue];
		j2254068441 -> "Chat ends.";
	j3381683973 [label="我……原諒我，漂泊者。",shape=box,color=blue];
		j3381683973 -> j1322664245;
	j2847468712 [label="我明白了。",shape=box,color=blue];
		j2847468712 -> "Chat ends.";
	j1322664245 [label="再次原諒我的直率，我想表達一下最近一直縈繞在我心頭的各種事情：",shape=box,color=blue];
		j1322664245 -> j429947579;
	j429947579 [label="我現在身處一個充滿奇異幻想跟看似無休止的肆意殺戮的世界，周圍都是陌生人和會說話的野獸。",shape=box,color=blue];
		j429947579 -> j606172291;
	j606172291 [label="我所知道的一切都被「翠玉之光」、「Orokin 帝國」以及「虛空」的耀眼光束席捲而去，並受到「喃喃者」的威脅。",shape=box,color=blue];
		j606172291 -> j344945342;
	j344945342 [label="所以，如果我覺得你這番感情的提議天真得有些可笑，請見諒。我不認識你也不信任你。事實上，我所能相信的，只是別人的一面之詞。",shape=box,color=blue];
		j344945342 -> j3611659089;
	j3611659089 [label="那些我既不認識也不信任的人的話。",shape=box,color=blue];
		j3611659089 -> j1964663911;
	j1964663911 [label="同時，所有這些我和瑪麗承受的外在壓力 — 更不用說我還要跟你們看不見的所有其他挑戰搏鬥。",shape=box,color=blue];
		j1964663911 -> j180934631;
	j180934631 [label="我欣賞你的直白。我知道你的意圖，也讚賞你的做法。我希望，如果將來我需要重新考慮你的提議的話……這個方案依然有效。",shape=box,color=blue];
		j180934631 -> j4135258252;
		j180934631 -> j2967504918;
		j180934631 -> j480669420;
	j4135258252 [label="不要許下承諾，神父。",shape=box,color=red];
		j4135258252 -> j414709456;
	j2967504918 [label="以我一位摯友的話來說，「我這個人很固執，老友。」",shape=box,color=red];
		j2967504918 -> j19107727;
	j480669420 [label="會的。",shape=box,color=red];
		j480669420 -> j328945179;
	j414709456 [label="當然。這全部都在意料之外。",shape=box,color=blue];
