	328 [label="有趣。我一直以為你把你的漠然奉為神明，就像你把太陰或太陽視為神明一樣。難道我理解錯了？",shape=box,color=blue];
		328 -> 337;
		328 -> 338;
	333 [label="不。但我認為，想到自己最終能夠猜到漠然在做什麼，會讓我感到一種平靜。",shape=box,color=red];
		333 -> 342;
	334 [label="不，說到底，我想我不確定。但我跟它接觸已經足夠，我覺得我有理由去弄明白。",shape=box,color=red];
		334 -> 343;
	335 [label="還能是什麼呢？漠然似乎正在逐一探究人體各部位的用途。",shape=box,color=red];
		335 -> 344;
	336 [label="因為它們死後都會變成那樣子。我們已經無數次證明了這一點。",shape=box,color=blue];
		336 -> 345;
		336 -> 346;
		336 -> 347;
	341 [label="嗯，是的。瑪麗跟我說過這件事。你不相信我們這個世界存在著無形的力量 ─ 包括漠然的力量。對嗎？",shape=box,color=blue];
		341 -> 352;
		341 -> 353;
	340 [label="有意思。這已經是我第二次從你身上感覺到你似乎不相信自己漠然的真實性了。對嗎？",shape=box,color=blue];
		340 -> 350;
		340 -> 351;
	339 [label="耐人尋味。我是否從你的言談中看出，你近來自己的信仰也動搖了？或者，你從一開始就從未相信過漠然？",shape=box,color=blue];
		339 -> 350;
		339 -> 351;
	337 [label="我並不確定漠然這是否真實存在，直到我們把它變成真實。我想我們創造它的方式，和我創造渡域的方式一樣。",shape=box,color=red];
		337 -> 348;
	338 [label="我確實認為漠然是一種真正的神靈 — 它背後有著真正的認知意識。",shape=box,color=red];
		338 -> 349;
	342 [label="有時候，我會想這或許就是為什麼那麼多人最終會投向信仰的原因……",shape=box,color=blue];
		342 -> 354;
	343 [label="恕我直言，當任何人覺得自己的任何行為都是「有理由的」時，我都會開始感到擔憂，尤其是在預測他人動機方面。",shape=box,color=blue];
		343 -> 355;
		343 -> 356;
	344 [label="我們是否應該擔心，當探討到不太明顯的部分時會發生什麼？",shape=box,color=blue];
		344 -> 357;
	345 [label="我認為漠然正在努力學習如何成為「人」。它一直以來都是某種更宏大，更獨特的東西。所以它正在學習如何以更渺小的形式存在，如何成為我們。",shape=box,color=red];
		345 -> 358;
	346 [label="有時我會想在我們跟漠然互動之前，它是否從未真正擁有自己的實體。所以，它現在正在學習如何存在。",shape=box,color=red];
		346 -> 359;
	347 [label="我認為漠然似乎正在逐一探究人體各部位的用途。",shape=box,color=red];
