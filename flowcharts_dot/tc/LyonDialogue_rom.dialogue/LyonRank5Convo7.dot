		j1946087518 -> j2774642050;
	j2054675290 [label="沒錯。他這樣做是為了贏得戰爭，有時這意味著輸掉幾場戰役。",shape=box,color=red];
		j2054675290 -> j2774642050;
	j1532394551 [label="他會及時原諒自己。但我不認為外殼真的會改變。",shape=box,color=red];
		j1532394551 -> j2774642050;
	j1115851778 [label="你了解自己的想法和極限。我祝你們倆一切順利。",shape=box,color=blue];
		j1115851778 -> j847767316;
	j1681288320 [label="里昂？我對你有感覺。我在乎你。如果你願意和我在一起，我想和你在一起。",shape=box,color=red];
