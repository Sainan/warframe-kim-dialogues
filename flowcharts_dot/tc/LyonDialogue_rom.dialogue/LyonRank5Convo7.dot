		j1314047301 -> j3113685223;
	j2689478901 [label="對此我無法恰當地表達我的感激，我認為任何言語都無法做到。",shape=box,color=blue];
		j2689478901 -> j3113685223;
	j2824526336 [label="是的。當然。在這個時候接受任何其他答案都會顯得……虛偽……",shape=box,color=blue];
		j2824526336 -> j4243973687;
	j3113685223 [label="但既然我已經費盡心思地完成了這段極其華麗的自我陶醉式開場白……",shape=box,color=blue];
		j3113685223 -> j3825338603;
		j3113685223 -> j2152972818;
		j3113685223 -> j1388142598;
	j4243973687 [label="我完全理解。我祝你一切順利。我會珍惜我們一起度過的所有時光。",shape=box,color=blue];
		j4243973687 -> j530993253;
	j3825338603 [label="對於一個一開始沉默的人來說，你真的變得很多話了。",shape=box,color=red];
		j3825338603 -> j2327993892;
	j2152972818 [label="我覺得它們很可愛，別擔心。",shape=box,color=red];
		j2152972818 -> j1646813193;
	j1388142598 [label="你本可以只說「你知道，如果我們分道揚鑣，我會沒事的」。",shape=box,color=red];
		j1388142598 -> j3464498064;
	j530993253 [label="我會在我的靈魂中記住它們，即使它們從我的腦海中消失。再見了。",shape=box,color=blue];
		j530993253 -> j1597456553;
	j2327993892 [label="+5 Chemistry",color=orange];
		j2327993892 -> j3214852692;
	j1646813193 [label="+5 Chemistry",color=orange];
		j1646813193 -> j471093873;
	j3464498064 [label="+5 Chemistry",color=orange];
		j3464498064 -> j2491467332;
	j1597456553 [label="Boolean LyonDating is now false.",color=orange];
		j1597456553 -> j90727028;
	j3214852692 [label="噗！如果你不想了解我思想的內部運作，你就不應該到處戳。這完全是你的錯。",shape=box,color=blue];
		j3214852692 -> j2661662725;
	j471093873 [label="我很高興你喜歡我的思緒漫遊。這正是我選擇盡量少說話的原因。你能想像親自忍受這個嗎？瑪麗多年前就會像瘋狗一樣把我處決了。",shape=box,color=blue];
		j471093873 -> j2661662725;
	j2491467332 [label="你天生具有一定程度的不敬和諷刺，是我永遠無法企及的。我會讓你決定怎麼想。",shape=box,color=blue];
		j2491467332 -> j2661662725;
	j90727028 [label="Boolean IsDating is now false.",color=orange];
		j90727028 -> j2142921449;
	j2661662725 [label="然而，所有這一切都是為了作為一個故事的序言，與其餘部分相比，這個故事現在看起來會相當簡短……",shape=box,color=blue];
		j2661662725 -> j4291939057;
	j4291939057 [label="我昨晚從噩夢中醒來。當我醒來時，陰影圍繞著我。在我這種精神狀態下，這並不陌生或新鮮。它們在我的床上隱現，不會消散。",shape=box,color=blue];
		j4291939057 -> j2572669379;
	j2572669379 [label="我並不害怕它們，因為我知道它們無法傷害我。然而，它們也不會從我的腦海中消失。我只知道一種方法可以擺脫它們。",shape=box,color=blue];
		j2572669379 -> j3880877193;
	j3880877193 [label="我從床上起身，盡我所能地穿好衣服，在持續的噩夢的模糊視線中蹣跚而行。我抓住我的焚爐，跪在地板中央，準備……嗯。",shape=box,color=blue];
		j3880877193 -> j3929267686;
	j3929267686 [label="我準備「清理我的思緒」。我們就這麼說吧。",shape=box,color=blue];
		j3929267686 -> j3047678840;
	j3047678840 [label="但當我閉上眼睛時，我的思緒游蕩了。我的思想漂移……到你身上，我的奇蹟……",shape=box,color=blue];
		j3047678840 -> j3371997455;
	j3371997455 [label="你的聲音。你的手放在我肩上的觸感……",shape=box,color=blue];
		j3371997455 -> j2722765385;
	j2722765385 [label="然後幻象……逃走了。它們放棄了崗位，被更強大的幽靈趕走了……你的幽靈。",shape=box,color=blue];
		j2722765385 -> j3483256099;
	j3483256099 [label="我……站起身。把我的焚爐放在床頭櫃上，然後……選擇在聖堂的沙地上散步……",shape=box,color=blue];
		j3483256099 -> j3887479512;
		j3483256099 -> j4055319522;
	j3887479512 [label="現在我明白你為什麼需要那段開場白了。",shape=box,color=red];
		j3887479512 -> j1335947929;
	j4055319522 [label="我不知道應該說什麼……",shape=box,color=red];
		j4055319522 -> j3013069924;
	j1335947929 [label="是的。好吧。在我散步時，我……立即意識到這樣一個時刻的黑暗危機。你可能會……認為這是一種責任，開始把我視為壓在你身上的鎖鏈。",shape=box,color=blue];
		j1335947929 -> j1466554359;
	j3013069924 [label="+5 Chemistry",color=orange];
		j3013069924 -> j2070627720;
	j1466554359 [label="我懇求你──我祈禱，向任何在高處或下方的神或諸神祈禱──你永遠不要這樣想。這是你給我的禮物，每一次我都會珍惜它帶來的新鮮感。",shape=box,color=blue];
		j1466554359 -> j687072972;
	j2070627720 [label="不需要言語，我的奇蹟……",shape=box,color=blue];
		j2070627720 -> j3712742216;
	j687072972 [label="向我發誓，我的奇蹟，如果時候到了，我已經成為你的空籠子……你將擺脫我。",shape=box,color=blue];
		j687072972 -> j3482531045;
	j3712742216 [label="在我散步時，我……立即意識到這樣一個時刻的黑暗危機。你可能會……認為這是一種責任，開始把我視為壓在你身上的鎖鏈。",shape=box,color=blue];
		j3712742216 -> j1466554359;
	j3482531045 [label="我不會成為我所愛之人的空洞監獄。不為你。不為瑪麗。",shape=box,color=blue];
		j3482531045 -> j2647233768;
		j3482531045 -> j2134895339;
