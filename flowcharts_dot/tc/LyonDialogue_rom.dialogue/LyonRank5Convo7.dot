		j1946313043 -> j2480651836;
	j1138328647 [label="我對我們之間發生的事不抱怨恨，我仍然只能表達我感恩的靈魂，感謝我們確實一起度過的時光。",shape=box,color=blue];
		j1138328647 -> j864934708;
	j1808997365 [label="當她談到你時，她眼中充滿喜悅。每當她想到你可能會來時，她就興奮得眉飛色舞。",shape=box,color=blue];
		j1808997365 -> j42037428;
	j2585708508 [label="我只是想告訴你，她的快樂是有感染力的，我發現自己也在想到這件事時微笑。所以為此，我也必須感謝你。",shape=box,color=blue];
		j2585708508 -> j2142921449;
	j2419992243 [label="他可能認為這是恐懼的行為，服用血清並忘記導致它的行為，如同一隻逃離沉船的老鼠。",shape=box,color=blue];
		j2419992243 -> j4039392113;
