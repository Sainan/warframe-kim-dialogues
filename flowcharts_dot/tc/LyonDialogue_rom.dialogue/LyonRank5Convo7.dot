		j1159995195 -> j1314047301;
	j4176640911 [label="我無法描述是什麼吸引我來到你身邊。但你永遠不會是一種責任或負擔。",shape=box,color=red];
		j4176640911 -> j2689478901;
	j3760226602 [label="[分手] 這一切對我來說變得太沉重了，我很抱歉。在這裡結束可能最好。",shape=box,color=red];
