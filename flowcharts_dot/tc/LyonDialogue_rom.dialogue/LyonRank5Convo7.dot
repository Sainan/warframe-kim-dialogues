		j3331820961 -> j873860494;
	j2774642050 [label="+10 Chemistry",color=orange];
		j2774642050 -> j3663227299;
	j847767316 [label="+10 Chemistry",color=orange];
		j847767316 -> j3665412483;
	j3051894796 [label="原諒我，請原諒我，我只是以為這是不可能的，這……不是我……能夠……想像的……",shape=box,color=blue];
		j3051894796 -> j2623137314;
	j1549986054 [label="絕對不是！那不是我的意思！絕──絕非如此，事實上，我只是以為這是不可能的，這……不是我……能夠……想像的……",shape=box,color=blue];
		j1549986054 -> j2623137314;
	j873860494 [label="但我希望你明白，如果你要結束我們之間的關係，這種我以為以前在我和另一個人之間是不可能形成的紐帶——",shape=box,color=blue];
		j873860494 -> j1024763684;
