	j81462296 [label="我很高興有人能找到力量穿過羅瑟性格的荊棘，看到藏在其中破碎的東西。",shape=box,color=blue];
		j81462296 -> j425062758;
	j4150575820 [label="我能否問個我擔心會是不得體的問題嗎，我的朋友？",shape=box,color=blue];
		j4150575820 -> j1399675133;
		j4150575820 -> j1878687149;
	j1060988686 [label="多麼美好且良善又迷人且平凡的問題。我不常被問到這個。",shape=box,color=blue];
		j1060988686 -> j206778144;
	j2449021341 [label="是的，什麼事？有什麼問題嗎？",shape=box,color=blue];
		j2449021341 -> j2037236522;
		j2449021341 -> j2124907206;
	j2162361231 [label="你讓我緊張了。怎麼了？",shape=box,color=red];
		j2162361231 -> j4235788368;
	j3924777577 [label="對，我在這。請說。",shape=box,color=red];
		j3924777577 -> j1379126946;
	j435356082 [label="我不知道你會怎麼想，因為……",shape=box,color=red];
		j435356082 -> j756251105;
	j3008582826 [label="我有點……敬畏她。",shape=box,color=red];
		j3008582826 -> j1414516853;
	j527823597 [label="這是你要威脅我的對話嗎？還是？",shape=box,color=red];
		j527823597 -> j1622294456;
	j425062758 [label="我知道，儘管他強烈否認，他認為自己是個懦夫。我不會給他這樣的標籤。",shape=box,color=blue];
		j425062758 -> j2712538391;
	j1399675133 [label="當然。我問過你很多次了。",shape=box,color=red];
		j1399675133 -> j2932332758;
	j1878687149 [label="為什麼我正在跟羅瑟約會？",shape=box,color=red];
		j1878687149 -> j2675967587;
	j206778144 [label="我……挺好，謝謝。",shape=box,color=blue];
		j206778144 -> j4065429353;
	j2037236522 [label="算了。抱歉。其實忘了我要說什麼了。",shape=box,color=red];
		j2037236522 -> j3295259671;
	j2124907206 [label="我不知道怎麼措辭最好，所以我就直說了，我對你有感覺。",shape=box,color=red];
		j2124907206 -> j4039788106;
	j4235788368 [label="沒有什麼不對，恰好相反。這就是為什麼你必須理解這一點如此重要，我希望你免受可能發生的可怕後果，如果你認為它們可能會發生的話。",shape=box,color=blue];
