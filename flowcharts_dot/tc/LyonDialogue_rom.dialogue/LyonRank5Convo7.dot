	j1379126946 [label="+5 Chemistry",color=orange];
		j1379126946 -> j1946313043;
	j756251105 [label="哈。你以為我會感到驚訝嗎？我一直站在她的光芒的陰影中。不，我的朋友，我對此並不感到苦澀或嫉妒，我向你保證。",shape=box,color=blue];
		j756251105 -> j1138328647;
	j1414516853 [label="我們都是如此。我的靈魂姊妹從不停止讓我驚嘆。我為你們倆感到高興，無法用言語表達。",shape=box,color=blue];
		j1414516853 -> j1808997365;
	j1622294456 [label="嗯？不。我不會那麼粗魯地到處跺腳，假裝是她的守護者。如果她決定你值得的話，她完全有能力打斷你的骨頭。",shape=box,color=blue];
		j1622294456 -> j2585708508;
	j2712538391 [label="源拓氏告訴他，他將被需要去拯救一個他不知道的未來。一個他沒有王權、沒有人民在他腳下卑躬屈膝、沒有僕人崇拜他的未來。",shape=box,color=blue];
