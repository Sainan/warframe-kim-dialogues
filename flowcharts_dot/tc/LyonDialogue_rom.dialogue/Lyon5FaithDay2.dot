	j1320758387 [label="我在思考 Rell 和 Harrow 如此不可避免地存在於我生命中意味著什麼──",shape=box,color=blue];
		j1320758387 -> j1054649578;
	j2880295032 [label="我想著我為一個本質上旨在在這個世界上行善的組織服務的那些年……Rell 和 Harrow 如此不可避免地存在於我生命中意味著什麼──",shape=box,color=blue];
		j2880295032 -> j2184242968;
	j4201695498 [label="我在思考 Rell 和 Harrow 如此不可避免地存在於我生命中意味著什麼──",shape=box,color=blue];
		j4201695498 -> j3799303368;
	j2628135024 [label="我不知道像信仰這樣的東西對於像我這樣的人來說是否真的曾經「找到」或「失去」過，而是永遠在尋求。永遠在質疑，永遠在尋找答案。",shape=box,color=blue];
		j2628135024 -> j950149251;
	j950149251 [label="但我認為，就像痛苦一樣，需要取得平衡，以確保既不會在其中溺斃，也不會變得如此麻木以至於免疫和無感。",shape=box,color=blue];
		j950149251 -> j1286686499;
	j1054649578 [label="他們的身影終究會從我的靈魂深處被抹去，只留下記憶。我不知道這是否代表世間真的存在神明。",shape=box,color=blue];
