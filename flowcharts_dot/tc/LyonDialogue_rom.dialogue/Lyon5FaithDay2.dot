	j2173598357 [label="也許你是對的。也許我們的銀色女神只會給予這樣悲劇性的祝福。她不會希望移除痛苦的記憶，就像對羅瑟那樣。",shape=box,color=blue];
		j2173598357 -> j1599264750;
	j3211650380 [label="你同意羅瑟和我關於牆中人不是真神的觀點嗎？",shape=box,color=red];
		j3211650380 -> j912222344;
	j2227005012 [label="你認為漠然在這方面屬於哪一邊？",shape=box,color=red];
		j2227005012 -> j2896510159;
	j61045120 [label="你是否和羅瑟一樣認為漠然是真神？",shape=box,color=red];
		j61045120 -> j912222344;
	j912222344 [label="我不知道我在這件事上的立場。我沒有足夠的證據來做出任何決定。但我想這不會改變太多，對吧？",shape=box,color=blue];
		j912222344 -> j1945193632;
		j912222344 -> j2039356737;
	j2896510159 [label="漠然是否是神，我不知道我在這件事上的立場。我沒有足夠的證據來做出任何決定。但我想這不會改變太多，對吧？",shape=box,color=blue];
		j2896510159 -> j1945193632;
		j2896510159 -> j2039356737;
	j1945193632 [label="我認為這改變了很多。如果它不是真神，它是由人創造的。這意味著它可以被人打敗。",shape=box,color=red];
		j1945193632 -> j2124712208;
	j2039356737 [label="你是什麼意思？",shape=box,color=red];
		j2039356737 -> j550827306;
	j2124712208 [label="如果你不希望它能被我們的努力打敗，為什麼首先要對抗它？真的，你是個令人困惑的生物。",shape=box,color=blue];
		j2124712208 -> j4042430005;
	j550827306 [label="它進入我們宇宙的方式不會改變我們可能打敗它的方法。",shape=box,color=blue];
		j550827306 -> j1867026078;
	j4042430005 [label="你不可能是認真的。那你只是在「隨波逐流」，跟著別人的行動嗎？對抗它只是因為沒有更好的事情可做？",shape=box,color=blue];
		j4042430005 -> j1549645565;
	j1867026078 [label="看哪：一個由我們創造的神，從我們自己的空虛織物中縫製而成。",shape=box,color=blue];
		j1867026078 -> j1283978589;
	j1549645565 [label="你肯定能想到一個更好的愛好。",shape=box,color=blue];
		j1549645565 -> j1053154962;
		j1549645565 -> j3506838376;
	j1283978589 [label="一個我們可能用悲傷、我們的哀痛、我們的痛苦、我們的憤怒、我們的煎熬過度填充的織布娃娃，直到縫線因此快要被撐破。",shape=box,color=blue];
		j1283978589 -> j1389593153;
	j1053154962 [label="不，我不認為這是沒有希望的，那不是我的意思。",shape=box,color=red];
		j1053154962 -> j3109851751;
	j3506838376 [label="我的意思是，這改變了我們可以如何思考殺死它。理解它。",shape=box,color=red];
		j3506838376 -> j814807931;
	j1389593153 [label="請原諒我，但我發現這比它原本就是神更讓我恐懼。",shape=box,color=blue];
		j1389593153 -> j2084681107;
	j3109851751 [label="說話前思考不是必需的。開槍前也不是。",shape=box,color=blue];
		j3109851751 -> j1867026078;
	j814807931 [label="我不相信那是真的。我認為我們現在對它的動機的理解和它是某個「偉大而不可知的神」時一樣少。",shape=box,color=blue];
		j814807931 -> j1867026078;
	j2084681107 [label="是的，事實上，我更喜歡那樣。",shape=box,color=blue];
		j2084681107 -> j2876132595;
	j2876132595 [label="這樣可能還有希望它比整個人類更聰明。",shape=box,color=blue];
		j2876132595 -> j2466337798;
