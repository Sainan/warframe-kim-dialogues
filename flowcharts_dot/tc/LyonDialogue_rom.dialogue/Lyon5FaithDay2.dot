		j3287457751 -> j490182959 [label="false",color=purple];
	j387343702 [label="日尊會像熱刀燒灼傷口般將痛苦燒盡，而太陰會讓我擁抱那份餘溫，在他缺席帶來的痛苦逐漸冷卻時。",shape=box,color=blue];
		j387343702 -> j3033215865;
	j1117770655 [label="而我知道，如果我仍然能找到 Rell 和他的 Harrow 的存在，他們不會希望我為他們的逝去而痛苦。他們安息了。",shape=box,color=blue];
		j1117770655 -> j1607148825;
	j895222704 [label="噢，里昂……你經歷太多了。懷疑不是軟弱的表現，而是痛苦的產物。",shape=box,color=red];
		j895222704 -> j3918913852;
		j895222704 -> j3363220127;
		j895222704 -> j906724063;
		j895222704 -> j3649221851;
		j895222704 -> j3229389633;
	j323432156 [label="信仰不需要是恆定的，也不期望它是。有多少故事講述那些失去信仰，卻又重新找回的人？",shape=box,color=red];
		j323432156 -> j3918913852;
		j323432156 -> j3363220127;
		j323432156 -> j906724063;
	j982268486 [label="里昂，你一生都奉獻給了我們的聖光會。你認為他們會因為這種事而疏遠你嗎？",shape=box,color=red];
		j982268486 -> j3918913852;
		j982268486 -> j3363220127;
		j982268486 -> j906724063;
	j2881283552 [label="里昂，我不知道世上有沒有神 ─ 我想我們誰也無法真正知道。但我知道的是，你經歷了很多。",shape=box,color=red];
		j2881283552 -> j3918913852;
		j2881283552 -> j906724063;
		j2881283552 -> j3649221851;
	j2065498649 [label="雖然我個人是不相信世上有神，但我知道這對你的生命來說有多重要。我不想輕視這一點。",shape=box,color=red];
		j2065498649 -> j906724063;
		j2065498649 -> j3229389633;
	j2222232143 [label="漠然是我們造成的 ─ 他不是神，里昂。別讓源拓氏的錯誤毀了你。至於你的信仰？",shape=box,color=red];
		j2222232143 -> j906724063;
		j2222232143 -> j3229389633;
	j490182959 [label="我很不忍心看到你這樣，被捲入所有人的鬧劇之中。你不應該承受這些。",shape=box,color=red];
		j490182959 -> j3918913852;
