		j2386751053 -> j2628135024;
	j304301762 [label="很難說。我不知道，因為像我這樣的人，從來沒有真正「找到」或「失去」那樣的東西，而只是一直在尋找。一直在質疑 — 一直在尋找答案。",shape=box,color=blue];
		j304301762 -> j950149251;
