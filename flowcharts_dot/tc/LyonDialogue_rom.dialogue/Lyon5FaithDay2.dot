		j490182959 -> j906724063;
		j490182959 -> j3649221851;
		j490182959 -> j3229389633;
	j3033215865 [label="因為沒有痛苦可能會摧毀我們，就如同過量痛苦會淹沒我們一樣。",shape=box,color=blue];
		j3033215865 -> j3912153962;
		j3033215865 -> j1764186361;
		j3033215865 -> j499051772;
	j1607148825 [label="我也不認為我所有的苦難都是徒勞的。它不會否定我所忍受的一切。",shape=box,color=blue];
		j1607148825 -> j132674350;
	j3918913852 [label="我不是說你需要重新找到你的信仰。我是說如果你想也覺得你需要的話，它不是永遠失去的東西。",shape=box,color=red];
		j3918913852 -> j2938429140;
	j3363220127 [label="當然，太陰能看到你經歷了什麼。你以她的名義忍受了什麼。",shape=box,color=red];
		j3363220127 -> j3520041596;
	j906724063 [label="我認為你需要專注的是在自己內心找到某種平靜，無論你需要如何找到它。",shape=box,color=red];
		j906724063 -> j2938429140;
	j3649221851 [label="如果有神，如果你的太陰確實存在，她肯定能看到你經歷了什麼。你以她的名義忍受了什麼。這對她一定意味著什麼。",shape=box,color=red];
		j3649221851 -> j3520041596;
	j3229389633 [label="我認為你需要放下是否有神的任何概念，首先專注於治癒自己。",shape=box,color=red];
		j3229389633 -> j2109867447;
	j3912153962 [label="相信我……我知道冷漠有多危險。",shape=box,color=red];
		j3912153962 -> j2386751053;
