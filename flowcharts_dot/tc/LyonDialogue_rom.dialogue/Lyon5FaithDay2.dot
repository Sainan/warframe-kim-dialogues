	j4238886490 [label="I have been considering the nature of our conversation yesterday. And what it means to have the presence of Rell and Harrow so inexorably within my life -",shape=box,color=blue];
		j4238886490 -> j1237384321;
	j605000189 [label="I have been considering the nature of our conversation yesterday. And what it means to have the presence of Rell and Harrow so inexorably within my life -",shape=box,color=blue];
		j605000189 -> j1280999104;
	j943597450 [label="I have been considering the nature of our conversation yesterday. And what it means to have the presence of Rell and Harrow so inexorably within my life -",shape=box,color=blue];
		j943597450 -> j1189480813;
	j2989423937 [label="There is something I have been meaning to broach with you, and only now have the opportunity to do so. When... Rell, Harrow, and I became entangled - the how and the why of it, is not important -",shape=box,color=blue];
		j2989423937 -> j1491355501;
	"Chat ends." [color=orange];
	j1237384321 [label="Only to have their presence stricken from my soul once more, only to remain as a memory. And how that may have been a gift of Lua...",shape=box,color=blue];
		j1237384321 -> j2080169059;
	j1280999104 [label="Only to have their presence stricken from my soul once more, only to remain as a memory. And you are correct. It may mean that there are no gods in this world.",shape=box,color=blue];
		j1280999104 -> j1995958783;
	j1189480813 [label="Only to have their presence stricken from my soul once more, only to remain as a memory. And I do not know whether or not it means there are gods in this world or not.",shape=box,color=blue];
		j1189480813 -> j2026589959;
	j1491355501 [label="I became wrapped up in their past in the same fashion their became wrapped up in mine. I saw all of the Zariman Ten Zero, flashes of the Old War, and in the same manner, they saw all of my past.",shape=box,color=blue];
		j1491355501 -> j3907043592;
	j2080169059 [label="I have come to realize our silver lady would give such a tragic blessing. She would not wish to remove the memory of pain, such as with Roathe.",shape=box,color=blue];
		j2080169059 -> j447607820;
	j1995958783 [label="But it does not change, I think, the years I spent in service to an organization that meant, at its heart, to do kind deeds in this world.",shape=box,color=blue];
		j1995958783 -> j826316934;
	j2026589959 [label="As you stated, we... may never know. And it may not be for us to know. Such is the way of things. But it does not change, I think, the years I spent in service to an organization that meant, at its heart, to do kind deeds in this world.",shape=box,color=blue];
		j2026589959 -> j826316934;
	j3907043592 [label="It... threw a great many things into question for me, namely... my faith. It crumpled and fell away, like charred paper - turning to dust. I loathe myself for this weakness...",shape=box,color=blue];
		j3907043592 -> j3287457751;
	j447607820 [label="Neither would she remove the sting of the lash from my flesh. It is certainly not her way to protect me from the grief of his passing.",shape=box,color=blue];
		j447607820 -> j438364248;
	j826316934 [label="To help those that wished to ease pain from their lives in the moments where it would drown them.",shape=box,color=blue];
		j826316934 -> j567551084;
	j3287457751 [label="Evaluate expressions",color=orange];
		j3287457751 -> j895222704 [label="LyonDating",color=purple];
		j3287457751 -> j4293022073 [label="DrifterFaithYesSimilar",color=purple];
		j3287457751 -> j4293022073 [label="DrifterFaithYesForeign",color=purple];
		j3287457751 -> j4293022073 [label="DrifterFaithPersonal",color=purple];
		j3287457751 -> j982268486 [label="DrifterFaithSol",color=purple];
		j3287457751 -> j982268486 [label="DrifterFaithLua",color=purple];
		j3287457751 -> j982268486 [label="DrifterFaithBalance",color=purple];
		j3287457751 -> j2881283552 [label="DrifterFaithAgnostic",color=purple];
		j3287457751 -> j2065498649 [label="DrifterFaithNoFear",color=purple];
		j3287457751 -> j2222232143 [label="DrifterFaithNoMITW",color=purple];
		j3287457751 -> j2065498649 [label="DrifterFaithNoMaybe",color=purple];
		j3287457751 -> j490182959 [label="false",color=purple];
	j438364248 [label="Where Sol would blaze away the pain like a hot knife might cauterize a wound - Lua would have me the embrace the warmth of the pain his absence might bring.",shape=box,color=blue];
		j438364248 -> j2882535722;
	j567551084 [label="And I know, were I still able to find Rell and his Harrow's presence, that they would not wish me to agonize over their loss. They are at peace.",shape=box,color=blue];
		j567551084 -> j4226435930;
	j895222704 [label="噢，里昂……你經歷太多了。懷疑不是軟弱的表現，而是痛苦的產物。",shape=box,color=red];
		j895222704 -> j3243631726;
		j895222704 -> j1821793230;
		j895222704 -> j1008067748;
		j895222704 -> j2332103997;
		j895222704 -> j2886368155;
	j4293022073 [label="Faith doesn't need to be constant - nor is it expected to be. How many tales are told of those who lose their faith, only to find it again?",shape=box,color=red];
		j4293022073 -> j3243631726;
		j4293022073 -> j1821793230;
		j4293022073 -> j1008067748;
	j982268486 [label="里昂，你一生都奉獻給了我們的聖光會。你認為他們會因為這種事而疏遠你嗎？",shape=box,color=red];
		j982268486 -> j3243631726;
		j982268486 -> j1821793230;
		j982268486 -> j1008067748;
	j2881283552 [label="里昂，我不知道世上有沒有神 ─ 我想我們誰也無法真正知道。但我知道的是，你經歷了很多。",shape=box,color=red];
		j2881283552 -> j3243631726;
		j2881283552 -> j1008067748;
		j2881283552 -> j2332103997;
	j2065498649 [label="雖然我個人是不相信世上有神，但我知道這對你的生命來說有多重要。我不想輕視這一點。",shape=box,color=red];
		j2065498649 -> j1008067748;
		j2065498649 -> j2886368155;
	j2222232143 [label="漠然是我們造成的 ─ 他不是神，里昂。別讓源拓氏的錯誤毀了你。至於你的信仰？",shape=box,color=red];
		j2222232143 -> j1008067748;
		j2222232143 -> j2886368155;
	j490182959 [label="我很不忍心看到你這樣，被捲入所有人的鬧劇之中。你不應該承受這些。",shape=box,color=red];
		j490182959 -> j3243631726;
		j490182959 -> j1821793230;
		j490182959 -> j1008067748;
		j490182959 -> j2332103997;
		j490182959 -> j2886368155;
	j2882535722 [label="For it is the absence of pain that threatens to destroy us, just as much as an abundance of it might drown us.",shape=box,color=blue];
		j2882535722 -> j1996664390;
		j2882535722 -> j3628155715;
		j2882535722 -> j499051772;
	j4226435930 [label="Nor do I believe all my suffering was for naught. It does not invalidate all that I endured.",shape=box,color=blue];
		j4226435930 -> j3833022970;
	j3243631726 [label="I'm not saying you need to find your faith again. I'm saying if you want to - if you feel you need to - it's not something that's forever lost.",shape=box,color=red];
		j3243631726 -> j2776026819;
	j1821793230 [label="Surely, Lua can see what you've been put through. What you've endured in her name. ",shape=box,color=red];
		j1821793230 -> j1862159007;
	j1008067748 [label="What I think is that you need to focus on is finding some kind of peace within yourself - however it is you need to find it.",shape=box,color=red];
		j1008067748 -> j2776026819;
	j2332103997 [label="If there is a god, if your Lua does exist - surely she can see what you've been through. What you've endured in her name. It must mean something to her.",shape=box,color=red];
		j2332103997 -> j1862159007;
	j2886368155 [label="I think you need to let go of any notion of whether or not there are gods, and focus on healing yourself, first.",shape=box,color=red];
		j2886368155 -> j4031129186;
	j1996664390 [label="Trust me... I know how dangerous apathy can be.",shape=box,color=red];
		j1996664390 -> j1303917838;
	j3628155715 [label="這是否代表你重新找回了信仰？",shape=box,color=red];
		j3628155715 -> j1189454899;
	j499051772 [label="[結束]",shape=box,color=red];
		j499051772 -> j3856020424;
	j3833022970 [label="For it is the absence of pain that threatens to destroy us, just as much as an abundance of it might drown us.",shape=box,color=blue];
		j3833022970 -> j1996664390;
		j3833022970 -> j118388814;
		j3833022970 -> j499051772;
	j2776026819 [label="Boolean LyonFaith3Maybe is now true.",color=orange];
		j2776026819 -> j376639039;
	j1862159007 [label="Boolean LyonFaith3Yes is now true.",color=orange];
		j1862159007 -> j191321970;
	j4031129186 [label="Boolean LyonFaith3No is now true.",color=orange];
		j4031129186 -> j2197730271;
	j1303917838 [label="看來確實如此。 ",shape=box,color=blue];
		j1303917838 -> j2910116758;
	j1189454899 [label="很難說。我不知道，因為像我這樣的人，從來沒有真正「找到」或「失去」那樣的東西，而只是一直在尋找。一直在質疑 — 一直在尋找答案。",shape=box,color=blue];
		j1189454899 -> j3732328809;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j118388814 [label="Does this mean you've given up on your faith?",shape=box,color=red];
		j118388814 -> j1189454899;
	j376639039 [label="I think on what it means to have Rell and Harrow so inexorably within my life -",shape=box,color=blue];
		j376639039 -> j2455965420;
	j191321970 [label="I think of the years I spent in service to an organization that meant, at its heart, to do kind deeds in this world... what it means to have the presence of Rell and Harrow so inexorably within my life -",shape=box,color=blue];
		j191321970 -> j95667870;
	j2197730271 [label="I think on what it means to have Rell and Harrow so inexorably within my life -",shape=box,color=blue];
		j2197730271 -> j1581232170;
	j2910116758 [label="I do not know as something like faith is anything someone like myself truly ever has \"found\" or \"lost\" but is, instead, forever seeking. Forever questioning - forever in search of answers.",shape=box,color=blue];
		j2910116758 -> j3732328809;
	j3732328809 [label="But I think there is, like with pain, a balance to be struck to ensure that one neither drowns within it nor becomes so inured that one is immune and numb.",shape=box,color=blue];
		j3732328809 -> j1286686499;
	j2455965420 [label="他們的身影終究會從我的靈魂深處被抹去，只留下記憶。我不知道這是否代表世間真的存在神明。",shape=box,color=blue];
		j2455965420 -> j2026589959;
	j95667870 [label="Only to have their presence stricken from my soul once more, only to remain as a memory. And how that may have been a gift of Lua...",shape=box,color=blue];
		j95667870 -> j745389752;
	j1581232170 [label="Only to have their presence stricken from my soul once more, only to remain as a memory. And you are correct. It may mean that there are no gods in this world.",shape=box,color=blue];
		j1581232170 -> j1995958783;
	j1286686499 [label="Check boolean DrifterFaithNoMITW",color=orange];
		j1286686499 -> j3566446828 [label=true,color=green];
		j1286686499 -> j2701997255 [label=true,color=green];
		j1286686499 -> j1962865196 [label=false,color=brown];
		j1286686499 -> j2701997255 [label=false,color=brown];
	j745389752 [label="Perhaps you are right. Perhaps our silver lady would only give such a tragic blessing. She would not wish to remove the memory of pain, such as with Roathe.",shape=box,color=blue];
		j745389752 -> j447607820;
	j3566446828 [label="Do you agree with Roathe and me about the Man in the Wall not being a real god?",shape=box,color=red];
		j3566446828 -> j4267531;
	j2701997255 [label="Where do you think the Indifference falls in this?",shape=box,color=red];
		j2701997255 -> j552527757;
	j1962865196 [label="Do you side with Roathe in thinking the Indifference is a real god or not?",shape=box,color=red];
		j1962865196 -> j4267531;
	j4267531 [label="I do not know where I stand on the matter. I haven't enough evidence to make a decision either way. But I suppose it does not change much, does it?",shape=box,color=blue];
		j4267531 -> j2363797422;
		j4267531 -> j2149715783;
	j552527757 [label="Whether or not the Indifference is a god, I do not know where I stand on the matter. I haven't enough evidence to make a decision either way. But I suppose it does not change much, does it?",shape=box,color=blue];
		j552527757 -> j2363797422;
		j552527757 -> j2149715783;
	j2363797422 [label="I think it changes a great deal. If it isn't a real god - it's made by people. That means it can be defeated by people.",shape=box,color=red];
		j2363797422 -> j932559774;
	j2149715783 [label="你是什麼意思？",shape=box,color=red];
		j2149715783 -> j1058466213;
	j932559774 [label="If you had no hope that it could be defeated by our efforts, why bother stand against it in the first place? Truly, you are a baffling creature.",shape=box,color=blue];
		j932559774 -> j4058215482;
	j1058466213 [label="The method of its arrival into our universe does not change the methods by which we might defeat it.",shape=box,color=blue];
		j1058466213 -> j1005374044;
	j4058215482 [label="You cannot possibly mean those words. Are you simply \"going along\" with the actions of others, then? Fighting it for lack of anything better to do with your time?",shape=box,color=blue];
		j4058215482 -> j468703429;
	j1005374044 [label="Behold: a god of our creation, sewn from the fabric of our own emptiness.",shape=box,color=blue];
		j1005374044 -> j3171909539;
	j468703429 [label="Surely you could think of a better hobby.",shape=box,color=blue];
		j468703429 -> j1948014830;
		j468703429 -> j1067527762;
	j3171909539 [label="A fabric doll we might over-fill with sadness, our grief, our pain, our anger, our agony, until the stitches threaten to burst with it.",shape=box,color=blue];
		j3171909539 -> j3503527215;
	j1948014830 [label="No, I didn't think it was hopeless - that's not what I meant.",shape=box,color=red];
		j1948014830 -> j3508308679;
	j1067527762 [label="What I meant was, this changes how we can think about killing it. Understanding it.",shape=box,color=red];
		j1067527762 -> j614079362;
	j3503527215 [label="You will pardon me if I find that fills me with far more dread than if it were a god before we arrived. ",shape=box,color=blue];
		j3503527215 -> j1323175555;
	j3508308679 [label="Thinking before one puts words into the world is not a prerequisite. Neither is it for bullets. ",shape=box,color=blue];
		j3508308679 -> j1005374044;
	j614079362 [label="I do not believe that is true. I would argue that we understand just as little about its motivations now as we might if it were some \"great and unknowable god.\"",shape=box,color=blue];
		j614079362 -> j1005374044;
	j1323175555 [label="Yes, in fact, I think I prefer that.",shape=box,color=blue];
		j1323175555 -> j3621350897;
	j3621350897 [label="There might be some hope that it could be more intelligent than humanity at large.",shape=box,color=blue];
		j3621350897 -> j2786728996;
	j2786728996 [label="With that... utterly bleak thought, I think I shall leave you for the day.",shape=box,color=blue];
		j2786728996 -> j742749064;
	j742749064 [label="Check boolean LyonDating",color=orange];
		j742749064 -> j3453245384 [label=true,color=green];
		j742749064 -> j2688017687 [label=false,color=brown];
