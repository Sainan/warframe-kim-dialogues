digraph {
	1485 [label="LyonRank5Convo2 begins.",color=orange];
		1485 -> 1486;
	1486 [label="Evaluate expressions",color=orange];
		1486 -> 1487 [label="LyonPainOff",color=purple];
		1486 -> 1491 [label="LyonBackstory3a",color=purple];
		1486 -> 1490 [label="LyonBackstory3b",color=purple];
		1486 -> 1489 [label="LyonBackstory2",color=purple];
		1486 -> 1489 [label="LyonBackstory1",color=purple];
		1486 -> 1488 [label="false",color=purple];
	1487 [label="+20 Chemistry",color=orange];
		1487 -> 490;
	1491 [label="我的朋友，你一直對我很有耐心，你也額外地對我很溫柔體貼。我知道你一定也對我的故事的這一部分感到好奇 ─ 月球最黑暗的那個晚上。",shape=box,color=blue];
		1491 -> 1493;
	1490 [label="我的朋友，你一直對我很有耐心。我知道你一定也對我的故事的這一部分感到好奇 ─ 月球最黑暗的那個晚上。",shape=box,color=blue];
		1490 -> 1493;
	1489 [label="我的朋友，你一直對我的過去感到好奇。我知道你一定也對我的故事的這一部分感到好奇 — 關於月球最黑暗的那個晚上。。",shape=box,color=blue];
		1489 -> 1493;
	1488 [label="我的朋友，我知道你聽了我的故事後一定很想知道，尤其是月球最黑暗的那個晚上。",shape=box,color=blue];
		1488 -> 1493;
	490 [label="[由於先前已設定情緒觸發警告，對話已跳過]",shape=box,color=blue];
		490 -> 1492;
	1493 [label="這是一個我發誓永遠不會說出口的故事。只有瑪麗知道，因為她在我的日記中讀到了。而現在，我將把它寫在這裡給你。",shape=box,color=blue];
		1493 -> 1495;
	1492 [label="Update boolean LyonConfession1",color=orange];
		1492 -> 1494;
	1495 [label="一旦我開始，就無法停止，因為我無法重新開始。所以如果我不允許你問我問題的話，請你見諒。",shape=box,color=blue];
		1495 -> 1499;
		1495 -> 1498;
		1495 -> 1497;
		1495 -> 1496;
	1494 [label="Chat ends.",color=orange];
	1499 [label="當然。",shape=box,color=red];
		1499 -> 1503;
	1498 [label="[讓他繼續]",shape=box,color=red];
		1498 -> 1502;
	1497 [label="【警告：討論提及虐童內容。點擊此處結束。不會因此損失與里昂的曖昧值。 】",shape=box,color=red];
		1497 -> 1501;
	1496 [label="[結束]",shape=box,color=red];
		1496 -> 1500;
	1503 [label="謝謝你。",shape=box,color=blue];
		1503 -> 1507;
	1502 [label="+5 Chemistry",color=orange];
		1502 -> 1503;
	1501 [label="Check boolean LyonSpeech",color=orange];
		1501 -> 1505 [label=true,color=green];
		1501 -> 1506 [label=false,color=brown];
	1500 [label="Update boolean LyonConfessionFail",color=orange];
		1500 -> 1504;
	1507 [label="Evaluate expressions",color=orange];
		1507 -> 1511 [label="LyonBackstory3a",color=purple];
		1507 -> 1511 [label="LyonBackstory3b",color=purple];
		1507 -> 1510 [label="false",color=purple];
	1505 [label="+20 Chemistry",color=orange];
		1505 -> 1508;
	1506 [label="如果你覺得作出這個選擇是懦弱的表現，我懇求你 — 別這樣想。這份痛苦不是你該面對的，而是我。你並沒有被要求去承受這一切。",shape=box,color=blue];
		1506 -> 1509;
	1504 [label="Chat ends.",color=orange];
	1511 [label="我們談過我的家人。談過我在農場長大的時光。談過那些一直折磨我並驅使我訴諸暴力的幻象。",shape=box,color=blue];
		1511 -> 1515;
	1510 [label="我知道我很少跟你們提起養大我的人。但我恐怕這是有原因的。",shape=box,color=blue];
		1510 -> 1514;
	1508 [label="Update boolean LyonConfession1",color=orange];
		1508 -> 1512;
	1509 [label="我們面前這具機械裝置，營造出一種隱晦的疏離假象。它讓我們誤以為自己受到了庇護，彷彿無論對方透過它敲打出什麼樣的字句，都無法傷及我們分毫。",shape=box,color=blue];
		1509 -> 1513;
	1515 [label="我告訴過你我聽到的聲音，會對我低語，從其他房間呼喚我。有時它們聽起來像是在呼喚我的名字──",shape=box,color=blue];
		1515 -> 1518;
	1514 [label="我的母親……把我的幻象視為惡魔的傑作。並試圖用鞭子把它們從我身上打出來。經常打到我無法站立。",shape=box,color=blue];
		1514 -> 1517;
	1512 [label="Chat ends.",color=orange];
	1513 [label="我的看法恰恰相反——一旦卸下平日社交時用來武裝自己的盔甲，我們反倒被剝光了防禦，變得無遮無掩。",shape=box,color=blue];
		1513 -> 1516;
	1518 [label="其他時候，它們聽起來根本不像任何東西。語無倫次的胡言亂語，或惡魔的語言。",shape=box,color=blue];
		1518 -> 1521;
	1517 [label="而我的父親？嗯。儘管我母親殘忍，我父親更糟。我就不告訴你細節了。",shape=box,color=blue];
		1517 -> 1520;
	1516 [label="因此，在類似的情況下……我深知自己射出的箭或許未能擊中全副武裝的士兵，卻射穿了林中野鹿那毫無戒備的咽喉。",shape=box,color=blue];
		1516 -> 1519;
	1521 [label="起初，這些話語毫無意義的狂言嚇壞了我。我懇求它們說得有意義。我向太陰祈禱，祈求她的靈魂告訴我它們想要我做什麼。",shape=box,color=blue];
		1521 -> 1524;
	1520 [label="但他們的暴力也得到了我的回應。我的幻象經常讓我難以應對——尤其是當我長大後，身材比我父親還要高大強壯時。",shape=box,color=blue];
		1520 -> 1523;
	1519 [label="因此在最後，我想跟你說的是：",shape=box,color=blue];
		1519 -> 1522;
	1524 [label="但當我開始解讀它們想要什麼時，我後悔自己曾如此絕望地祈禱的東西。因為現在，我知道了它們要求我以它們的名義去做哪些 事。",shape=box,color=blue];
		1524 -> 1526;
	1523 [label="這些幻象常常以聲音的形式出現。有時候它們聽起來像是在呼喚我的名字 —",shape=box,color=blue];
		1523 -> 1518;
	1522 [label="即使我們自己沒有勇氣站起來，我們也必須提醒自己，要找到力量去幫助別人站起來。",shape=box,color=blue];
		1522 -> 1525;
	1526 [label="噢，他們為此付出了多麼慘痛的代價啊。",shape=box,color=blue];
		1526 -> 1528;
	1525 [label="這才是故事的真正目的。",shape=box,color=blue];
		1525 -> 1527;
	1528 [label="不要誤會我的意思。我對我的父親和母親沒有愛。我可能對他們有過的任何親情，早已在無數的瘀傷和創傷下消耗殆盡。",shape=box,color=blue];
		1528 -> 1530;
	1527 [label="+20 Chemistry",color=orange];
		1527 -> 1529;
	1530 [label="但它們為我哭喊著要我為它們做什麼……？而在那個最黑暗的夜晚，它們迫使我做什麼……？",shape=box,color=blue];
		1530 -> 1532;
	1529 [label="保重，漂泊者。我們很快會再聯絡。",shape=box,color=blue];
		1529 -> 1531;
	1532 [label="我當時幾乎還只是個男孩，還不算是個男人。也許我十六歲？十八歲？起初，我以為這一切只是另一場可怕的噩夢，一場扭曲的夢。",shape=box,color=blue];
		1532 -> 1534;
	1531 [label="-里昂・阿拉德神父",shape=box,color=blue];
		1531 -> 1533;
	1534 [label="人影站在我周圍，憔悴而扭曲地顯現，純粹由惡意和陰影構成。",shape=box,color=blue];
		1534 -> 1536;
	1533 [label="Update boolean LyonConfession1",color=orange];
		1533 -> 1535;
	1536 [label="嘲弄我，要求我做必須做的事，如果那些聲稱愛我的人要我的血肉……那麼我，反過來，也必須要他們的……",shape=box,color=blue];
		1536 -> 1537;
	1535 [label="Chat ends.",color=orange];
	1537 [label="當我從噩夢中醒來，又或許我一直都是醒著的，我不太確定，我手裡拿著一把獵刀。而我站在我父母房間的門口。",shape=box,color=blue];
		1537 -> 1538;
	1538 [label="那是新月之夜。雲層很厚。沒有一絲光線可以看見。那是絕對的黑暗。",shape=box,color=blue];
		1538 -> 1539;
	1539 [label="太陰拋棄了我。",shape=box,color=blue];
		1539 -> 1540;
	1540 [label="我無法回應那些聲音的召喚。我無法把我父母的靈魂交給他們。",shape=box,color=blue];
		1540 -> 1541;
	1541 [label="我逃進了空曠的夜色中。逃進了深林，樹枝刮傷了我赤裸的肌膚，但我對痛苦毫不在乎。",shape=box,color=blue];
		1541 -> 1542;
	1542 [label="我跑到雙腿癱軟在我身下，再也跑不動了。我當時可能一直在哭泣，我不知道。",shape=box,color=blue];
		1542 -> 1543;
	1543 [label="但那些顯化體追著我。它們仍然低語渴望鮮血。",shape=box,color=blue];
		1543 -> 1544;
	1544 [label="我當時想，如果我看不見它們，它們可能會消失……當我把那把刀刺進我的眼窩時……",shape=box,color=blue];
		1544 -> 1545;
	1545 [label="可惜我昏過去了，無法完成我的任務。現在，我永遠不會知道了。",shape=box,color=blue];
		1545 -> 1546;
	1546 [label="當我醒來時，我在當地的太陰教區。一位弟兄找到了我，並包紮了我的傷口。他問我在逃避什麼。",shape=box,color=blue];
		1546 -> 1547;
	1547 [label="我崩潰了。我無法對他撒謊。我全盤托出——幻象，還有它們叫我要做的事。我預料自己會受到譴責。",shape=box,color=blue];
		1547 -> 1548;
	1548 [label="當我說完後，他只是帶著如此了然的悲傷微笑，並把一個太陰的護身符放在我的手心。「她既是祝福也是詛咒，我的孩子。」",shape=box,color=blue];
		1548 -> 1549;
	1549 [label="他送我去光之城的大教堂。在那裡，我一直待到源拓氏找到我……",shape=box,color=blue];
		1549 -> 1550;
	1550 [label="就是這樣了……現在你都知道了。",shape=box,color=blue];
		1550 -> 1551;
	1551 [label="而……我現在要走了。",shape=box,color=blue];
		1551 -> 1552;
	1552 [label="Update boolean LyonConfession1",color=orange];
		1552 -> 1553;
	1553 [label="+20 Chemistry",color=orange];
		1553 -> 1554;
	1554 [label="- 里昂",shape=box,color=blue];
		1554 -> 1555;
	1555 [label="Chat ends.",color=orange];
}