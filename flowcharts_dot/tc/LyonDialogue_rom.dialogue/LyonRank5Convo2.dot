		j680575522 -> j186342256 [label="LyonBackstory3b",color=purple];
		j680575522 -> j1895031517 [label="LyonBackstory2",color=purple];
		j680575522 -> j1895031517 [label="LyonBackstory1",color=purple];
		j680575522 -> j1295254518 [label="false",color=purple];
	j2317562060 [label="+20 Chemistry",color=orange];
		j2317562060 -> j2709259124;
	j2928051810 [label="我的朋友，你一直對我很有耐心，你也額外地對我很溫柔體貼。我知道你一定也對我的故事的這一部分感到好奇 ─ 月球最黑暗的那個晚上。",shape=box,color=blue];
		j2928051810 -> j3155101646;
	j186342256 [label="我的朋友，你一直對我很有耐心。我知道你一定也對我的故事的這一部分感到好奇 ─ 月球最黑暗的那個晚上。",shape=box,color=blue];
		j186342256 -> j3155101646;
	j1895031517 [label="我的朋友，你一直對我的過去感到好奇。我知道你一定也對我的故事的這一部分感到好奇 — 關於月球最黑暗的那個晚上。。",shape=box,color=blue];
		j1895031517 -> j3155101646;
	j1295254518 [label="我的朋友，我知道你聽了我的故事後一定很想知道，尤其是月球最黑暗的那個晚上。",shape=box,color=blue];
		j1295254518 -> j3155101646;
	j2709259124 [label="[由於先前已設定情緒觸發警告，對話已跳過]",shape=box,color=blue];
		j2709259124 -> j370687875;
	j3155101646 [label="這是一個我發誓永遠不會說出口的故事。只有瑪麗知道，因為她在我的日記中讀到了。而現在，我將把它寫在這裡給你。",shape=box,color=blue];
		j3155101646 -> j3496490249;
	j370687875 [label="Boolean LyonConfession1 is now true.",color=orange];
		j370687875 -> "Chat ends.";
	j3496490249 [label="一旦我開始，就無法停止，因為我無法重新開始。所以如果我不允許你問我問題的話，請你見諒。",shape=box,color=blue];
		j3496490249 -> j4164335615;
		j3496490249 -> j2666633263;
		j3496490249 -> j2387658780;
		j3496490249 -> j499051772;
	"Chat ends." [color=orange];
	j4164335615 [label="當然。",shape=box,color=red];
		j4164335615 -> j1711987131;
	j2666633263 [label="[讓他繼續]",shape=box,color=red];
		j2666633263 -> j1444830706;
	j2387658780 [label="【警告：討論提及虐童內容。點擊此處結束。不會因此損失與里昂的曖昧值。 】",shape=box,color=red];
		j2387658780 -> j784838610;
	j499051772 [label="[結束]",shape=box,color=red];
		j499051772 -> j3856020424;
	j1711987131 [label="謝謝你。",shape=box,color=blue];
		j1711987131 -> j141195667;
	j1444830706 [label="+5 Chemistry",color=orange];
		j1444830706 -> j1711987131;
	j784838610 [label="Check boolean LyonSpeech",color=orange];
		j784838610 -> j3342655806 [label=true,color=green];
		j784838610 -> j1776789236 [label=false,color=brown];
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j141195667 [label="Evaluate expressions",color=orange];
		j141195667 -> j2333971107 [label="LyonBackstory3a",color=purple];
		j141195667 -> j2333971107 [label="LyonBackstory3b",color=purple];
		j141195667 -> j1958327010 [label="false",color=purple];
	j3342655806 [label="+20 Chemistry",color=orange];
		j3342655806 -> j370687875;
	j1776789236 [label="如果你覺得作出這個選擇是懦弱的表現，我懇求你 — 別這樣想。這份痛苦不是你該面對的，而是我。你並沒有被要求去承受這一切。",shape=box,color=blue];
		j1776789236 -> j2928008278;
	j2333971107 [label="我們談過我的家人。談過我在農場長大的時光。談過那些一直折磨我並驅使我訴諸暴力的幻象。",shape=box,color=blue];
		j2333971107 -> j3517895320;
	j1958327010 [label="我知道我很少跟你們提起養大我的人。但我恐怕這是有原因的。",shape=box,color=blue];
		j1958327010 -> j899339564;
	j2928008278 [label="我們面前這具機械裝置，營造出一種隱晦的疏離假象。它讓我們誤以為自己受到了庇護，彷彿無論對方透過它敲打出什麼樣的字句，都無法傷及我們分毫。",shape=box,color=blue];
		j2928008278 -> j1025742451;
	j3517895320 [label="我告訴過你我聽到的聲音，會對我低語，從其他房間呼喚我。有時它們聽起來像是在呼喚我的名字──",shape=box,color=blue];
		j3517895320 -> j3826300893;
	j899339564 [label="我的母親……把我的幻象視為惡魔的傑作。並試圖用鞭子把它們從我身上打出來。經常打到我無法站立。",shape=box,color=blue];
		j899339564 -> j2565538473;
	j1025742451 [label="我的看法恰恰相反——一旦卸下平日社交時用來武裝自己的盔甲，我們反倒被剝光了防禦，變得無遮無掩。",shape=box,color=blue];
		j1025742451 -> j3778607252;
	j3826300893 [label="其他時候，它們聽起來根本不像任何東西。語無倫次的胡言亂語，或惡魔的語言。",shape=box,color=blue];
		j3826300893 -> j436016490;
	j2565538473 [label="而我的父親？嗯。儘管我母親殘忍，我父親更糟。我就不告訴你細節了。",shape=box,color=blue];
		j2565538473 -> j1610191931;
	j3778607252 [label="因此，在類似的情況下……我深知自己射出的箭或許未能擊中全副武裝的士兵，卻射穿了林中野鹿那毫無戒備的咽喉。",shape=box,color=blue];
		j3778607252 -> j1971358724;
	j436016490 [label="起初，這些話語毫無意義的狂言嚇壞了我。我懇求它們說得有意義。我向太陰祈禱，祈求她的靈魂告訴我它們想要我做什麼。",shape=box,color=blue];
		j436016490 -> j1576810299;
	j1610191931 [label="但他們的暴力也得到了我的回應。我的幻象經常讓我難以應對——尤其是當我長大後，身材比我父親還要高大強壯時。",shape=box,color=blue];
		j1610191931 -> j4065781441;
	j1971358724 [label="因此在最後，我想跟你說的是：",shape=box,color=blue];
		j1971358724 -> j412353947;
	j1576810299 [label="但當我開始解讀它們想要什麼時，我後悔自己曾如此絕望地祈禱的東西。因為現在，我知道了它們要求我以它們的名義去做哪些 事。",shape=box,color=blue];
		j1576810299 -> j2715455592;
	j4065781441 [label="這些幻象常常以聲音的形式出現。有時候它們聽起來像是在呼喚我的名字 —",shape=box,color=blue];
		j4065781441 -> j3826300893;
	j412353947 [label="即使我們自己沒有勇氣站起來，我們也必須提醒自己，要找到力量去幫助別人站起來。",shape=box,color=blue];
		j412353947 -> j1711928899;
	j2715455592 [label="噢，他們為此付出了多麼慘痛的代價啊。",shape=box,color=blue];
		j2715455592 -> j3750487784;
	j1711928899 [label="這才是故事的真正目的。",shape=box,color=blue];
		j1711928899 -> j2714483348;
	j3750487784 [label="不要誤會我的意思。我對我的父親和母親沒有愛。我可能對他們有過的任何親情，早已在無數的瘀傷和創傷下消耗殆盡。",shape=box,color=blue];
		j3750487784 -> j233783013;
	j2714483348 [label="+20 Chemistry",color=orange];
		j2714483348 -> j658475305;
	j233783013 [label="但它們為我哭喊著要我為它們做什麼……？而在那個最黑暗的夜晚，它們迫使我做什麼……？",shape=box,color=blue];
		j233783013 -> j2618833113;
	j658475305 [label="保重，漂泊者。我們很快會再聯絡。",shape=box,color=blue];
		j658475305 -> j3816820637;
	j2618833113 [label="我當時幾乎還只是個男孩，還不算是個男人。也許我十六歲？十八歲？起初，我以為這一切只是另一場可怕的噩夢，一場扭曲的夢。",shape=box,color=blue];
		j2618833113 -> j3024238191;
	j3816820637 [label="-里昂・阿拉德神父",shape=box,color=blue];
		j3816820637 -> j370687875;
	j3024238191 [label="人影站在我周圍，憔悴而扭曲地顯現，純粹由惡意和陰影構成。",shape=box,color=blue];
		j3024238191 -> j255288552;
	j255288552 [label="嘲弄我，要求我做必須做的事，如果那些聲稱愛我的人要我的血肉……那麼我，反過來，也必須要他們的……",shape=box,color=blue];
		j255288552 -> j2401058661;
	j2401058661 [label="當我從噩夢中醒來，又或許我一直都是醒著的，我不太確定，我手裡拿著一把獵刀。而我站在我父母房間的門口。",shape=box,color=blue];
		j2401058661 -> j3223387385;
	j3223387385 [label="那是新月之夜。雲層很厚。沒有一絲光線可以看見。那是絕對的黑暗。",shape=box,color=blue];
		j3223387385 -> j3869446366;
	j3869446366 [label="太陰拋棄了我。",shape=box,color=blue];
		j3869446366 -> j1281508190;
	j1281508190 [label="我無法回應那些聲音的召喚。我無法把我父母的靈魂交給他們。",shape=box,color=blue];
		j1281508190 -> j588117664;
	j588117664 [label="我逃進了空曠的夜色中。逃進了深林，樹枝刮傷了我赤裸的肌膚，但我對痛苦毫不在乎。",shape=box,color=blue];
		j588117664 -> j728344748;
	j728344748 [label="我跑到雙腿癱軟在我身下，再也跑不動了。我當時可能一直在哭泣，我不知道。",shape=box,color=blue];
		j728344748 -> j3706615983;
	j3706615983 [label="但那些具象體追著我。它們仍然低語渴望鮮血。",shape=box,color=blue];
		j3706615983 -> j848475395;
	j848475395 [label="我當時想，如果我看不見它們，它們可能會消失……當我把那把刀刺進我的眼窩時……",shape=box,color=blue];
		j848475395 -> j1789851357;
	j1789851357 [label="可惜我昏過去了，無法完成我的任務。現在，我永遠不會知道了。",shape=box,color=blue];
		j1789851357 -> j4051925385;
	j4051925385 [label="當我醒來時，我在當地的太陰教區。一位弟兄找到了我，並包紮了我的傷口。他問我在逃避什麼。",shape=box,color=blue];
		j4051925385 -> j165040696;
	j165040696 [label="我崩潰了。我無法對他撒謊。我全盤托出——幻象，還有它們叫我要做的事。我預料自己會受到譴責。",shape=box,color=blue];
		j165040696 -> j1949270783;
	j1949270783 [label="當我說完後，他只是帶著如此了然的悲傷微笑，並把一個太陰的護身符放在我的手心。「她既是祝福也是詛咒，我的孩子。」",shape=box,color=blue];
		j1949270783 -> j1574963050;
	j1574963050 [label="他送我去光之城的大教堂。在那裡，我一直待到源拓氏找到我……",shape=box,color=blue];
		j1574963050 -> j1270815953;
	j1270815953 [label="就是這樣了……現在你都知道了。",shape=box,color=blue];
		j1270815953 -> j3987721489;
	j3987721489 [label="而……我現在要走了。",shape=box,color=blue];
		j3987721489 -> j698489751;
	j698489751 [label="Boolean LyonConfession1 is now true.",color=orange];
		j698489751 -> j1480159113;
	j1480159113 [label="+20 Chemistry",color=orange];
		j1480159113 -> j2142921449;
	j2142921449 [label="- 里昂",shape=box,color=blue];
		j2142921449 -> "Chat ends.";
}