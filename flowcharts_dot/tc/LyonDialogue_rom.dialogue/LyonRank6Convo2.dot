		j1350559949 -> "Chat ends.";
	j2814135789 [label="瑪麗是我的靈魂姊妹，而惡魔欠我一個人情。我不會透露是因為什麼，這是我打算帶進墳墓的秘密，所以就別費心問了。",shape=box,color=blue];
		j2814135789 -> j3347705625;
