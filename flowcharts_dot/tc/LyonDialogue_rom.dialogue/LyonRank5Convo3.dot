	j410090499 [label="Evaluate expressions",color=orange];
		j410090499 -> j1941655520 [label="LyonDating",color=purple];
		j410090499 -> j422409681 [label="LyonConvession1",color=purple];
		j410090499 -> j422409681 [label="LyonRell2a",color=purple];
		j410090499 -> j422409681 [label="LyonRell2b",color=purple];
		j410090499 -> j422409681 [label="LyonRell1",color=purple];
		j410090499 -> "Chat ends." [label="false",color=purple];
	j1941655520 [label="我對此並不自豪，但我已經喝完了整瓶酒，現在我準備好告訴你所有我一直拼命試圖不說的其餘部分了，我的奇蹟……",shape=box,color=blue];
		j1941655520 -> j438934475;
	j422409681 [label="我對此並不自豪，但我已經喝完了整瓶酒，現在我準備好告訴你所有我一直拼命試圖不說的其餘部分了……",shape=box,color=blue];
		j422409681 -> j438934475;
	"Chat ends." [color=orange];
	j438934475 [label="如果這瓶東西確實是酒的話，因為它沒有明確標示，而且 Loid 先生也不太確定我那個時代的酒和他所知道的酒是否是同一種東西。",shape=box,color=blue];
		j438934475 -> j4099641397;
	j4099641397 [label="為我辯護一下，我本來沒打算喝完整瓶……但我試圖辨別它是否確實是同一種物質，然後它就沒了……",shape=box,color=blue];
		j4099641397 -> j944189845;
		j4099641397 -> j3962300056;
		j4099641397 -> j3676605580;
	j944189845 [label="不。我不想。",shape=box,color=red];
		j944189845 -> j783796709;
	j3962300056 [label="味道嘗起來一樣嗎？",shape=box,color=red];
		j3962300056 -> j921527520;
	j3676605580 [label="你醉了嗎？",shape=box,color=red];
		j3676605580 -> j3480842498;
	j783796709 [label="要是我能這麼輕易逃脫就好了。我不怪你。",shape=box,color=blue];
		j783796709 -> j3856020424;
	j921527520 [label="我不知道！這才是整件事最讓人沮喪的地方！但這不是重點。重點是喝醉。而且我甚至不知道自己是否真的喝醉了。不過，我肯定不是清醒的 ─",shape=box,color=blue];
		j921527520 -> j2548915235;
	j3480842498 [label="或許吧。反正我肯定算不上他們所說的清醒狀態。",shape=box,color=blue];
		j3480842498 -> j1431126500;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j2548915235 [label="那我想這樣就足夠了。",shape=box,color=blue];
		j2548915235 -> j3189115457;
		j2548915235 -> j1408669530;
	j1431126500 [label="這正是我們做這件事的目的。那我想這樣就足夠了。",shape=box,color=blue];
		j1431126500 -> j3189115457;
		j1431126500 -> j1408669530;
	j3189115457 [label="到底是什麼可怕的事情，讓你一定要喝醉了才能跟我說？",shape=box,color=red];
		j3189115457 -> j402953187;
	j1408669530 [label="我隨時準備好聽你說……",shape=box,color=red];
		j1408669530 -> j402953187;
	j402953187 [label="噠、噠、噠……",shape=box,color=blue];
		j402953187 -> j688364480;
		j402953187 -> j510623406;
	j688364480 [label="……噢。",shape=box,color=red];
		j688364480 -> j3722416398;
	j510623406 [label="這樣就夠了。",shape=box,color=red];
		j510623406 -> j3722416398;
	j3722416398 [label="我確定他們並非我一生都在我腦海中。那個名叫 Rell 的 Tenno 和他的守護者 Harrow。他們不可能在我童年家中的牆內。",shape=box,color=blue];
		j3722416398 -> j3840335708;
	j3840335708 [label="他們不可能在我這些年的幻象中以低語、語無倫次的聲音在我腦海中迴響。然而我仍然在我的記憶中看到他們在那裡，聽到他在那裡。",shape=box,color=blue];
		j3840335708 -> j252073137;
	j252073137 [label="Check boolean LyonTime1",color=orange];
		j252073137 -> j3536918658 [label=true,color=green];
		j252073137 -> j1665472281 [label=false,color=brown];
	j3536918658 [label="我在哲學意義上理解了源拓氏所說的能量如何能同時存在於時間中的多個地方。但我直到……注射血清後才在情感上理解它。",shape=box,color=blue];
		j3536918658 -> j113840059;
	j1665472281 [label="就好像在我注射血清的那一刻，萬物合而為一。當源拓氏揭示自己，以及他存在的所有真相時──",shape=box,color=blue];
		j1665472281 -> j425045396;
	j113840059 [label="有時我在腦海中看到一個巨大而淺的靜止湖泊，向各個方向延伸。黑暗而光滑，就像一面黑瑪瑙占卜鏡。",shape=box,color=blue];
		j113840059 -> j291155744;
	j425045396 [label="他向我闡述了他所知道的所有「量子糾纏」、「疊加態」、「永恆主義」等等。",shape=box,color=blue];
		j425045396 -> j1915204853;
	j291155744 [label="一個向無限流淌的巨大黑色湖泊。無法理解。",shape=box,color=blue];
		j291155744 -> j28800876;
	j1915204853 [label="我在科學上、在相當哲學的意義上理解了這一切。但我直到……注射血清後才在情感上理解它。",shape=box,color=blue];
		j1915204853 -> j113840059;
	j28800876 [label="而那就是我會找到他們的地方。那就是我們會相遇的地方。那也是我會感覺到他們的地方……",shape=box,color=blue];
		j28800876 -> j3004555386;
	j3004555386 [label="他們？",shape=box,color=red];
		j3004555386 -> j2294022742;
	j2294022742 [label="其他的 Harrow……空洞的事物雕像，回聲的回聲的回聲……它們永恆地向所有方向延伸下去……",shape=box,color=blue];
		j2294022742 -> j2135653879;
	j2135653879 [label="Rell 把自己放進了其中一個。在其中迷失了自己。而通過這樣做，在所有這些之中迷失了自己……",shape=box,color=blue];
		j2135653879 -> j2289204010;
	j2289204010 [label="包括我。包括造就我的血清中的 Harrow。",shape=box,color=blue];
		j2289204010 -> j2642064851;
		j2289204010 -> j4162990255;
	j2642064851 [label="虛空，我竟然都沒意識到……",shape=box,color=red];
		j2642064851 -> j3899928011;
	j4162990255 [label="噢不 -",shape=box,color=red];
		j4162990255 -> j3899928011;
	j3899928011 [label="Rell 和他的 Harrow 在我腦海中和我在一起，他們與我如此相似，卻又如此不同。",shape=box,color=blue];
		j3899928011 -> j4241383622;
	j4241383622 [label="他毫不畏懼，而且信心十足。兩個我都完全不具備的特質。",shape=box,color=blue];
		j4241383622 -> j3706278164;
	j3706278164 [label="他堅定地對抗漠然，不在乎它是什麼或不是什麼。只是知道需要做什麼。",shape=box,color=blue];
		j3706278164 -> j1612949561;
	j1612949561 [label="即使在他遭受的所有殘酷的折磨之後。這些年來，在那個永恆的「現在」和「過去」，在我注射血清的那一刻……在「之前」和「之後」，他都在那裡。",shape=box,color=blue];
		j1612949561 -> j3130165607;
	j3130165607 [label="當時他既是我的朋友，也是我的兄弟。",shape=box,color=blue];
		j3130165607 -> j3312228710;
	j3312228710 [label="在過去？在現在？",shape=box,color=blue];
		j3312228710 -> j3970954915;
	j3970954915 [label="我再也感覺不到他了。",shape=box,color=blue];
		j3970954915 -> j2062065619;
		j3970954915 -> j3920341725;
	j2062065619 [label="他……他現在安息了，里昂……他安詳了。",shape=box,color=red];
		j2062065619 -> j1329424307;
	j3920341725 [label="噢，里昂……",shape=box,color=red];
		j3920341725 -> j670386453;
	j1329424307 [label="我知道。當他離開時我感覺到了。我哭了。我深深地想念他。我知道他仍然在迴響，不知怎的，不知為何，雖然我不完全理解如何。",shape=box,color=blue];
		j1329424307 -> j3818911547;
		j1329424307 -> j3855766329;
	j670386453 [label="我深深地想念他。我知道他仍然在迴響，不知怎的，不知為何，雖然我不完全理解如何。",shape=box,color=blue];
		j670386453 -> j3818911547;
		j670386453 -> j3855766329;
	j3818911547 [label="Rell 是我們所有人中最堅強的。我很高興你曾經有機會認識他。",shape=box,color=red];
		j3818911547 -> j3615374839;
	j3855766329 [label="Rell 因為孩子們的無知殘忍而被排斥……他不應該遭遇那些事。",shape=box,color=red];
		j3855766329 -> j3143488755;
	j3615374839 [label="我也很高興認識他。至於他的力量？或許是，或許不是。到最後，他只是知道需要什麼，而且他足夠堅強去完成它。",shape=box,color=blue];
		j3615374839 -> j754033501;
	j3143488755 [label="或許吧。但到最後，他做了需要做的事。而且他足夠堅強去完成它。",shape=box,color=blue];
		j3143488755 -> j754033501;
	j754033501 [label="在這樣的時刻，我想「足夠堅強」就是我們所能祈求的一切。",shape=box,color=blue];
		j754033501 -> j382830432;
	j382830432 [label="不幸的是，這瓶酒不能說是一樣……它非常烈，只是很慢生效。",shape=box,color=blue];
		j382830432 -> j4120300512;
	j4120300512 [label="我要在走之前",shape=box,color=blue];
		j4120300512 -> j1077850060;
	j1077850060 [label="先走了。",shape=box,color=blue];
		j1077850060 -> j111445917;
	j111445917 [label="Check boolean LyonDating",color=orange];
		j111445917 -> j924101777 [label=true,color=green];
		j111445917 -> j2845411929 [label=false,color=brown];
	j924101777 [label="+20 Chemistry",color=orange];
		j924101777 -> j1481988180;
	j2845411929 [label="+20 Chemistry",color=orange];
		j2845411929 -> j2041664187;
	j1481988180 [label="謝謝你，我的愛人。",shape=box,color=blue];
		j1481988180 -> j3719356733;
	j2041664187 [label="謝謝你，我的朋友。",shape=box,color=blue];
		j2041664187 -> j3719356733;
	j3719356733 [label="- 里昂",shape=box,color=blue];
		j3719356733 -> j561186479;
	j561186479 [label="Boolean LyonConfession2 is now true.",color=orange];
		j561186479 -> j4275890424;
	j4275890424 [label="Boolean LyonWillDate is now true.",color=orange];
		j4275890424 -> "Chat ends.";
}