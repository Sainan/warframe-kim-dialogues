	j410090499 [label="Evaluate expressions",color=orange];
		j410090499 -> j4229507800 [label="LyonDating",color=purple];
		j410090499 -> j3763652076 [label="LyonConvession1",color=purple];
		j410090499 -> j3763652076 [label="LyonRell2a",color=purple];
		j410090499 -> j3763652076 [label="LyonRell2b",color=purple];
		j410090499 -> j3763652076 [label="LyonRell1",color=purple];
		j410090499 -> "Chat ends." [label="false",color=purple];
	j4229507800 [label="I am not proud of this, but I have imbibed an entire bottle of wine and I am now ready to tell you all the rest of what I have been desperately trying not to, mon miracle...",shape=box,color=blue];
		j4229507800 -> j5384825;
	j3763652076 [label="I am not proud of this, but I have imbibed an entire bottle of wine and I am now ready to tell you all the rest of what I have been desperately trying not to...",shape=box,color=blue];
		j3763652076 -> j5384825;
	"Chat ends." [color=orange];
	j5384825 [label="If what this bottle is, indeed, wine, as it was not precisely labeled - and M. Loid was not exactly sure that what we had in my day and what he would know as wine are the same thing.",shape=box,color=blue];
		j5384825 -> j2981653517;
	j2981653517 [label="I did not intend to drink the whole bottle, in my defense... but I was attempting to discern if it was in fact the same substance and then it was gone...",shape=box,color=blue];
		j2981653517 -> j1409645932;
		j2981653517 -> j3962300056;
		j2981653517 -> j3676605580;
	j1409645932 [label="No. I'm not doing this.",shape=box,color=red];
		j1409645932 -> j3666629067;
	j3962300056 [label="味道嘗起來一樣嗎？",shape=box,color=red];
		j3962300056 -> j921527520;
	j3676605580 [label="你醉了嗎？",shape=box,color=red];
		j3676605580 -> j3480842498;
	j3666629067 [label="Would that I could escape so easily. I do not blame you.",shape=box,color=blue];
		j3666629067 -> j3856020424;
	j921527520 [label="我不知道！這才是整件事最讓人沮喪的地方！但這不是重點。重點是喝醉。而且我甚至不知道自己是否真的喝醉了。不過，我肯定不是清醒的 ─",shape=box,color=blue];
		j921527520 -> j2548915235;
	j3480842498 [label="或許吧。反正我肯定算不上他們所說的清醒狀態。",shape=box,color=blue];
		j3480842498 -> j1431126500;
	j3856020424 [label="Boolean LyonConfessionFail is now true.",color=orange];
		j3856020424 -> "Chat ends.";
	j2548915235 [label="那我想這樣就足夠了。",shape=box,color=blue];
		j2548915235 -> j671153413;
		j2548915235 -> j1810895789;
	j1431126500 [label="這正是我們做這件事的目的。那我想這樣就足夠了。",shape=box,color=blue];
		j1431126500 -> j671153413;
		j1431126500 -> j1810895789;
	j671153413 [label="到底是什麼可怕的事情，讓你一定要喝醉了才能跟我說？",shape=box,color=red];
		j671153413 -> j3375269506;
	j1810895789 [label="我隨時準備好聽你說……",shape=box,color=red];
		j1810895789 -> j3375269506;
	j3375269506 [label="Rap... tap... tap...",shape=box,color=blue];
		j3375269506 -> j844040956;
		j3375269506 -> j4260178804;
	j844040956 [label="……噢。",shape=box,color=red];
		j844040956 -> j2064845869;
	j4260178804 [label="這樣就夠了。",shape=box,color=red];
		j4260178804 -> j2064845869;
	j2064845869 [label="I know for certain that they were not there within my mind my entire life. The Tenno known as Rell and his guardian Harrow. It is not possible that they were within the walls of my childhood home.",shape=box,color=blue];
		j2064845869 -> j222537682;
	j222537682 [label="There is no possible way that they echoed within my mind with the whispered, garbled voices of my visions all my years. Yet I see them there, hear him there, in my memories, all the same.",shape=box,color=blue];
		j222537682 -> j252073137;
	j252073137 [label="Check boolean LyonTime1",color=orange];
		j252073137 -> j3003835193 [label=true,color=green];
		j252073137 -> j1329755728 [label=false,color=brown];
	j3003835193 [label="I understood all that Entrati said of how energy could exist in time in several places at once in a philosophical sense. But I did not understand it emotionally until I... injected the serum.",shape=box,color=blue];
		j3003835193 -> j3622433423;
	j1329755728 [label="It is as though the moment I injected the serum - all things became one. When Entrati revealed himself, and all the truth of his existence - ",shape=box,color=blue];
		j1329755728 -> j2976556538;
	j3622433423 [label="I see sometimes in my mind's eye a great and shallow still lake that stretches out in all directions. Black and smooth, like an onyx scrying mirror.",shape=box,color=blue];
		j3622433423 -> j1646545013;
	j2976556538 [label="He laid out to me all that he knew of \"quantum entanglement,\" \"superposition,\" \"eternalism,\" and the like.",shape=box,color=blue];
		j2976556538 -> j2941501463;
	j1646545013 [label="A great black lake that flows out in infinity. Impossible to comprehend.",shape=box,color=blue];
		j1646545013 -> j3384657718;
	j2941501463 [label="I understood it all in a scientific, rather philosophical sense. But I did not understand it emotionally until... I injected the serum.",shape=box,color=blue];
		j2941501463 -> j3622433423;
	j3384657718 [label="And that is where I would find them. That is where we would meet. And that is where I would feel Them as well...",shape=box,color=blue];
		j3384657718 -> j3316522517;
	j3316522517 [label="他們？",shape=box,color=red];
		j3316522517 -> j3835309935;
	j3835309935 [label="The other Harrows... Empty statues of things, echoes of echoes of echoes... They go on and on and on for all eternity in all directions...",shape=box,color=blue];
		j3835309935 -> j1397478560;
	j1397478560 [label="Rell placed himself inside of one. Lost himself inside of it. And by doing so, lost himself inside all of them...",shape=box,color=blue];
		j1397478560 -> j1699068891;
	j1699068891 [label="Including me. Including the Harrow that was in the serum that made me.",shape=box,color=blue];
		j1699068891 -> j2025828370;
		j1699068891 -> j2579346456;
	j2025828370 [label="虛空，我竟然都沒意識到……",shape=box,color=red];
		j2025828370 -> j2553463471;
	j2579346456 [label="噢不 -",shape=box,color=red];
		j2579346456 -> j2553463471;
	j2553463471 [label="They were there with me, in my mind - Rell and his Harrow, so very much like me, and yet so very different.",shape=box,color=blue];
		j2553463471 -> j882478926;
	j882478926 [label="他毫不畏懼，而且信心十足。兩個我都完全不具備的特質。",shape=box,color=blue];
		j882478926 -> j3238287759;
	j3238287759 [label="He stood fast against the Indifference, cared not for what it was or was not. Simply knew what needed to be done.",shape=box,color=blue];
		j3238287759 -> j3829358959;
	j3829358959 [label="Even after all the cruelty he suffered. For all those years, in the \"now\" and the \"then\" of that eternity, of the moment I injected the serum... of the \"before\" and the \"after,\" he was there.",shape=box,color=blue];
		j3829358959 -> j524280230;
	j524280230 [label="當時他既是我的朋友，也是我的兄弟。",shape=box,color=blue];
		j524280230 -> j3746702889;
	j3746702889 [label="Then? In the now?",shape=box,color=blue];
		j3746702889 -> j2581056844;
	j2581056844 [label="I can sense him no more.",shape=box,color=blue];
		j2581056844 -> j1548861044;
		j2581056844 -> j1654514716;
	j1548861044 [label="He... he's at rest, now, Lyon... he's at peace.",shape=box,color=red];
		j1548861044 -> j702776548;
	j1654514716 [label="噢，里昂……",shape=box,color=red];
		j1654514716 -> j3405251440;
	j702776548 [label="I know. I felt it when he was gone. And I wept. I miss him dearly. I know he echoes, still - somehow, someway, though I do not fully understand how.",shape=box,color=blue];
		j702776548 -> j977695107;
		j702776548 -> j3974515182;
	j3405251440 [label="I miss him dearly. I know he echoes, still - somehow, someway, though I do not fully understand how.",shape=box,color=blue];
		j3405251440 -> j977695107;
		j3405251440 -> j3974515182;
	j977695107 [label="Rell was the strongest of us all. I'm glad you had any chance at all to know him.",shape=box,color=red];
		j977695107 -> j2502695178;
	j3974515182 [label="Rell was outcasted because of ignorance and the cruelty of children... he didn't deserve what happened to him.",shape=box,color=red];
		j3974515182 -> j1190314223;
	j2502695178 [label="I am glad I knew him as well. As for his strength? Perhaps, perhaps not. In the end, he simply knew what was needed and he was strong enough to see it done.",shape=box,color=blue];
		j2502695178 -> j1773986427;
	j1190314223 [label="Perhaps. But in the end, he did what was needed. And he was strong enough to see it done.",shape=box,color=blue];
		j1190314223 -> j1773986427;
	j1773986427 [label="In times like these, \"strong enough\" is all we can pray for, I think.",shape=box,color=blue];
		j1773986427 -> j3837294958;
	j3837294958 [label="Which is, unfortunately, not the same to be said of this wine... which was very strong, just slow to take effect.",shape=box,color=blue];
		j3837294958 -> j1077739176;
	j1077739176 [label="I should go before ",shape=box,color=blue];
		j1077739176 -> j434510046;
	j434510046 [label="我要走了。",shape=box,color=blue];
		j434510046 -> j111445917;
	j111445917 [label="Check boolean LyonDating",color=orange];
		j111445917 -> j924101777 [label=true,color=green];
		j111445917 -> j2845411929 [label=false,color=brown];
	j924101777 [label="+20 Chemistry",color=orange];
		j924101777 -> j1481988180;
	j2845411929 [label="+20 Chemistry",color=orange];
		j2845411929 -> j2041664187;
	j1481988180 [label="謝謝你，我的愛人。",shape=box,color=blue];
		j1481988180 -> j3719356733;
	j2041664187 [label="謝謝你，我的朋友。",shape=box,color=blue];
		j2041664187 -> j3719356733;
	j3719356733 [label="- 里昂",shape=box,color=blue];
		j3719356733 -> j561186479;
