	1422 [label="+10 Chemistry",color=orange];
		1422 -> 1429;
	1423 [label="不，里昂。我是認真的。你對我來說很重要，而我只希望我能讓你相信這一點。",shape=box,color=red];
		1423 -> 1391;
	1424 [label="我……也許你是對的。也許現在不是時候。",shape=box,color=red];
		1424 -> 1430;
	1425 [label="我們已經偏離這次對話的重點太遠了，不是嗎？我非常抱歉。你不需要忍受這種浮誇、自憐的胡言亂語。",shape=box,color=blue];
		1425 -> 1431;
