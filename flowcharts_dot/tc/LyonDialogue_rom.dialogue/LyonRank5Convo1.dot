	1452 [label="那……你當時相信他嗎？",shape=box,color=red];
		1452 -> 1456;
	1453 [label="Update boolean LyonWillDate",color=orange];
		1453 -> 1457;
	1454 [label="正是我當時問他的。他向我解釋了「量子糾纏」、「疊加態」和「永恆主義」的概念。",shape=box,color=blue];
		1454 -> 1458;
	1455 [label="他帶來了他不可能存在的證據。我知道他是阿爾布雷希特·源拓氏，而不是日曜主教。但要說我的一切——我所信仰的一切——都是漠然的傑作？",shape=box,color=blue];
		1455 -> 1459;
	1456 [label="起初我不知道該相信什麼。他帶來了他不可能存在的證據。我知道他是阿爾布雷希特．源拓氏，而不是日曜主教。但要說我的一切——我所信仰的一切——都是漠然的傑作？",shape=box,color=blue];
		1456 -> 1459;
	1457 [label="Update boolean LyonDating",color=orange];
		1457 -> 1460;
	1458 [label="雖然這一切在表面上、在科學上對我來說都說得通，但我並不真正理解。",shape=box,color=blue];
		1458 -> 1461;
		1458 -> 1462;
	1459 [label="而我這些年來一直在侍奉一個虛假的神和太陰？",shape=box,color=blue];
		1459 -> 1463;
	1460 [label="Update boolean LyonHasDated",color=orange];
		1460 -> 1464;
	1461 [label="這會讓我頭痛。",shape=box,color=red];
		1461 -> 1465;
	1462 [label="但漠然在你的時代還沒有脫困。但在我們的時代，他脫困了嗎？",shape=box,color=red];
		1462 -> 1466;
	1463 [label="我不知道該怎麼辦。我現在仍然不知道。",shape=box,color=blue];
		1463 -> 1467;
	1464 [label="Update boolean IsDating",color=orange];
		1464 -> 1468;
	1465 [label="這正是我大多數時候試圖不去糾結細節的原因……",shape=box,color=blue];
		1465 -> 1469;
	1466 [label="你看，這就是我面臨的問題。",shape=box,color=blue];
		1466 -> 1465;
	1467 [label="當羅瑟到來時，事情變得更糟了。我的信仰危機變得更加複雜，因為當我得知漠然根本不是神──",shape=box,color=blue];
		1467 -> 1470;
	1468 [label="你還想聽聽我和羅瑟之間的狀況嗎？恐怕今天這件事在我心中已經變得既無關緊要又可笑了。",shape=box,color=blue];
