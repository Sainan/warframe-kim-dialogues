		1312 -> 1316 [label="false",color=purple];
		1312 -> 1313 [label="false",color=purple];
	1315 [label="你之前提到過你想談談我不認為「漠然」是「真正的神」這件事。現在是時候討論嗎？",shape=box,color=red];
		1315 -> 1320;
	1313 [label="[結束]",shape=box,color=red];
		1313 -> 1318;
	1314 [label="那天你問我關於概念式體現跟漠然的問題。你是不是有什麼煩惱事？",shape=box,color=red];
		1314 -> 1319;
	1317 [label="羅瑟信牆中人並非真正的神，而是「概念式體現」的產物。你怎麼看？",shape=box,color=red];
		1317 -> 1322;
	1316 [label="里昂，你和羅瑟之間到底發生了什麼事？我只聽到了一些零星的消息。",shape=box,color=red];
		1316 -> 1321;
	1320 [label="漂泊者，我不確定什麼時候才叫「好」時機，畢竟這對我造成了實質的困擾。",shape=box,color=blue];
		1320 -> 1324;
	1318 [label="Chat ends.",color=orange];
	1319 [label="漂泊者，有很多事情困擾著我。恐怕關於漠然和概念式體現的話題只是其中之一。",shape=box,color=blue];
		1319 -> 1323;
	1322 [label="漂泊者，問題在於我不知道。如果我知道答案的話，我就不會陷入如此痛苦的內心掙扎了。",shape=box,color=blue];
		1322 -> 1326;
	1321 [label="我會長話短說，雖然我很驚訝你居然沒聽過他對這件事的長篇大論。他可是迫不及待想抓住每個機會去說出這些怨言呢。",shape=box,color=blue];
		1321 -> 1325;
	1324 [label="但是，現在也的確算是「好」時機了。而我感到好奇的是，你似乎同意羅瑟的觀點，認為漠然並非真正的神。",shape=box,color=blue];
		1324 -> 1326;
	1323 [label="或者兩者都是，這取決於你想怎麼解讀當下的情況。不過我想，這確實就是讓我進退兩難的關鍵。",shape=box,color=blue];
		1323 -> 1326;
	1326 [label="不過，我應該……從頭說起。如果你不了解來龍去脈，大概無法理解為什麼這個話題對我這麼重要……",shape=box,color=blue];
		1326 -> 1328;
	1325 [label="他認為，漠然並非虛空之神，無論從哪個意義上來說都是如此，它實際上是由源拓氏以及之後所有與它接觸過的人共同創造的。",shape=box,color=blue];
		1325 -> 1327;
	1328 [label="我是太陰的兄弟。我畢生致力於對她的崇拜。我一生都堅信這一點。",shape=box,color=blue];
		1328 -> 1330;
	1327 [label="- 透過你所知的「概念式體現」從虛空創造出來。 ",shape=box,color=blue];
		1327 -> 1329;
	1330 [label="自從我來到教會以來，這麼多年裡面，我一直堅守著我的信仰——我堅信，我的苦難、我的痛苦和我的幻象——",shape=box,color=blue];
		1330 -> 1331;
	1329 [label="我相信，你創作渡域的方式也跟它非常相似。",shape=box,color=blue];
		1329 -> 1326;
	1331 [label="——全是為了侍奉她。以她的名義。因她的旨意。",shape=box,color=blue];
		1331 -> 1332;
	1332 [label="那是……直到「日曜主教」承認他其實就是阿爾布雷希特．源拓氏之前，我都是這麼想的。",shape=box,color=blue];
		1332 -> 1333;
	1333 [label="他向我們坦白了他的真實身份，講述了他與虛空之間的種種罪行，以及由此產生的一切後果。更確切地說……是從中逃出的某種東西。",shape=box,color=blue];
		1333 -> 1334;
		1333 -> 1335;
	1334 [label="漠然。",shape=box,color=red];
		1334 -> 1336;
	1335 [label="然後呢？",shape=box,color=red];
		1335 -> 1337;
	1336 [label="沒錯。他向我們講述了那個冷笑著迎接他的東西，以及他從那個酷似他實驗室的地方取回的手指。",shape=box,color=blue];
		1336 -> 1338;
	1337 [label="他說，他曾乘坐色璃艙鐘，沉入那片空無之中。那個酷似他實驗室的地方。",shape=box,color=blue];
		1337 -> 1338;
	1338 [label="此外，他還告訴了我們他感受到的巨大恐懼，因為他知道，他所釋放出的那個東西，不僅能跨越空間，更能跨越時間跟隨他。",shape=box,color=blue];
		1338 -> 1339;
	1339 [label="虛無之神。一個必須被禁錮的東西。一個他還留著碎塊、正在牆壁後面拼命想逃出來的造物。",shape=box,color=blue];
		1339 -> 1340;
	1340 [label="可怕的神祇，吞噬一切的神祇。祂既已自由，也尚未自由。",shape=box,color=blue];
		1340 -> 1341;
		1340 -> 1342;
	1341 [label="你是什麼意思？",shape=box,color=red];
		1341 -> 1343;
	1342 [label="「既」已自由，「也尚未」自由？",shape=box,color=red];
		1342 -> 1343;
	1343 [label="Check boolean LyonRell1",color=orange];
		1343 -> 1345 [label=true,color=green];
		1343 -> 1344 [label=false,color=brown];
	1345 [label="時間……對於處於我現在這種狀態的人來說，是纏繞糾結的。很難形容。我曾嘗試解釋過一次，但卻徹底失敗了。",shape=box,color=blue];
		1345 -> 1346;
	1344 [label="對於處於我現在這種狀態的人來說，時間是……纏繞糾結的。這難以描述，而我的描述令一切更難描述。",shape=box,color=blue];
		1344 -> 1346;
	1346 [label="我更希望擇日再解釋其中的細節，因為那並非我今日想闡述的重點。",shape=box,color=blue];
		1346 -> 1347;
	1347 [label="Check boolean LyonRell1",color=orange];
		1347 -> 1348 [label=true,color=green];
		1347 -> 1349 [label=true,color=green];
		1347 -> 1350 [label=true,color=green];
		1347 -> 1349 [label=false,color=brown];
		1347 -> 1350 [label=false,color=brown];
	1348 [label="但是，如果你聽過——或正在聆聽—— Rell 的話……我想談談這件事。",shape=box,color=red];
		1348 -> 1351;
	1349 [label="好的，你說了算。",shape=box,color=red];
		1349 -> 1352;
	1350 [label="我確實想深入探討一下這個問題……",shape=box,color=red];
		1350 -> 1353;
	1351 [label="我知道。而我一直刻意迴避這個話題。光是他的名字就足以讓我避而不談。",shape=box,color=blue];
		1351 -> 1354;
	1352 [label="我知道我一直在極力刻意避開這個話題，我很抱歉。但它很可能會讓我陷入一種幻象，我並不確定自己能否輕易擺脫。",shape=box,color=blue];
		1352 -> 1355;
	1353 [label="我向你保證，我們會的。我知道我一直在極力刻意避開這個話題，我很抱歉。但它很可能會讓我陷入一種幻象，我並不確定自己能否輕易擺脫。",shape=box,color=blue];
		1353 -> 1355;
	1354 [label="它在威脅著",shape=box,color=blue];
		1354 -> 1356;
	1355 [label="我不想再次因為我身體不適而不得不中斷這次對話。",shape=box,color=blue];
		1355 -> 1357;
		1355 -> 1358;
		1355 -> 1359;
	1356 [label="讓人聯想到一個男人被鎖鏈束縛的畫面",shape=box,color=blue];
		1356 -> 1360;
	1357 [label="里昂，我不認為我會叫任何經歷過你所經歷的一切的人做「體弱者」。",shape=box,color=red];
		1357 -> 1361;
	1358 [label="以「虛弱」來形容「被自己不願看見的幻象所詛咒」實在太糟糕了。不過，隨你喜歡。",shape=box,color=red];
		1358 -> 1361;
	1359 [label="你清楚自己的能力，所以我會聽從你的安排。",shape=box,color=red];
		1359 -> 1362;
	1360 [label="以血鑄造",shape=box,color=blue];
		1360 -> 1363;
	1361 [label="我謝謝你的好意。但我知道自己，即使在最好的情況下，我也只不過是一扇破碎的彩色玻璃窗。我站在這裡在想有那麼多碎片散落到了什麼地方。",shape=box,color=blue];
		1361 -> 1364;
	1362 [label="謝謝你。你的耐性讓我驚嘆。但我知道即使在最好的情況下，我也只不過是一扇破碎的彩色玻璃窗。我站在這裡在想有那麼多碎片散落到了什麼地方。",shape=box,color=blue];
		1362 -> 1364;
	1363 [label="以筋腱以及血肉鑿成",shape=box,color=blue];
		1363 -> 1365;
	1364 [label="每次我找到丟失的碎片時，我更有可能被碎片的邊緣割傷，而不是把它放回原來的位置。",shape=box,color=blue];
		1364 -> 1366;
	1365 [label="請你叫這一切停下來",shape=box,color=blue];
		1365 -> 1367;
	1366 [label="有時我感到好奇，如果我能成為我腦海中那些眼神空洞的 Harrow 之一，是不是會更好，這種感覺會隨著我的惡夢延伸到極致。",shape=box,color=blue];
		1366 -> 1368;
	1367 [label="他們的臉龐
千千萬萬
空洞而破碎
沉默不語
永遠破碎的禱告
我將成為什麼",shape=box,color=blue];
		1367 -> 1369;
		1367 -> 1370;
	1368 [label="Evaluate expressions",color=orange];
		1368 -> 1372 [label="MarieDating",color=purple];
		1368 -> 1371 [label="MarieDating",color=purple];
		1368 -> 1371 [label="RoatheDating",color=purple];
		1368 -> 1372 [label="RoatheDating",color=purple];
		1368 -> 1371 [label="false",color=purple];
		1368 -> 1372 [label="false",color=purple];
		1368 -> 1373 [label="false",color=purple];
	1369 [label="深呼吸，里昂。深呼吸。他們並不是真的在那裡。",shape=box,color=red];
		1369 -> 1374;
	1370 [label="我 ─ 對不起，里昂。專心看著螢幕。我在這裡。",shape=box,color=red];
		1370 -> 1375;
	1372 [label="我知道這是你被迫承擔的沉重負擔。也許這樣是不對的。但我不知道該如何擺脫困境。",shape=box,color=red];
		1372 -> 1377;
	1371 [label="你對瑪麗來說非常重要。你也成了我非常親密的朋友。我想即使是羅瑟也會想念你，雖然他不會承認。",shape=box,color=red];
		1371 -> 1376;
	1373 [label="[表白心意] 里昂，如果你讓那種事發生在你身上，我會心碎的。我……我很在乎你。",shape=box,color=red];
		1373 -> 1378;
	1374 [label="你錯了
他們就在那裡
而他們永遠不會再離開我
永遠都不會
源拓氏能保證
原諒我",shape=box,color=blue];
		1374 -> 1379;
	1375 [label="撕裂我的血肉
把它從我的骨頭上剝離
為什麼？為了什麼目的？
這究竟是為了滿足誰的飢餓？",shape=box,color=blue];
		1375 -> 1380;
		1375 -> 1381;
	1377 [label="除非訴諸……難以想像的手段。或者說只能那樣了。",shape=box,color=red];
		1377 -> 1383;
	1376 [label="你被珍惜。你被愛。你有家人和朋友。即使有時你可能感覺不到這一點。",shape=box,color=red];
		1376 -> 1382;
	1378 [label="我 — 你肯定是在開玩笑吧？在你親眼目睹了這一切之後，你不可能真心實意地說出這些話吧？要嘛你失去了理智，要嘛你的同情心蒙蔽了你的雙眼。",shape=box,color=blue];
		1378 -> 1384;
		1378 -> 1385;
	1379 [label="+10 Chemistry",color=orange];
		1379 -> 1386;
	1380 [label="沒有人。你不需要再這樣痛苦了。放下吧。",shape=box,color=red];
		1380 -> 1387;
	1381 [label="我知道。我知道這很痛苦。很對不起。走出來房間吧。",shape=box,color=red];
		1381 -> 1388;
	1383 [label="+10 Chemistry",color=orange];
		1383 -> 1390;
	1382 [label="里昂，你並不孤單。而我們都會想念你。",shape=box,color=red];
		1382 -> 1389;
	1384 [label="不，里昂。我是認真的。你對我來說很重要，而我只希望我能讓你相信這一點。",shape=box,color=red];
		1384 -> 1391;
	1385 [label="我……也許你是對的。也許現在不是時候。",shape=box,color=red];
		1385 -> 1392;
	1386 [label="Update boolean LyonRell2b",color=orange];
		1386 -> 1393;
	1387 [label="如果事情真有那麼簡單就好了
這些鎖鏈我已束縛太久
比語言更長
比我的名字更長
原諒我",shape=box,color=blue];
		1387 -> 1379;
	1388 [label="轉身，並在腦海中走出這個房間。",shape=box,color=red];
		1388 -> 1394;
	1390 [label="我看到了亡骸精靈先生，也聽說了 Ordis 先生或 Otak 先生的故事。我想到那些空蕩蕩的 Warframe，它們的思想被從頭顱中抽離。",shape=box,color=blue];
		1390 -> 1396;
	1389 [label="+10 Chemistry",color=orange];
		1389 -> 1395;
	1391 [label="我。",shape=box,color=blue];
		1391 -> 1397;
	1392 [label="很好。我很高興你從自己短暫的瘋狂中清醒過來了。這畢竟一定會傳染。也許我們該從這個裝置上休息一下，因為我擔心它已經開始腐蝕你的大腦了。",shape=box,color=blue];
		1392 -> 1398;
	1393 [label="Chat ends.",color=orange];
	1394 [label="是的
他們會在另一個時間出現
這個血與鏈的密室
等待
永遠等待",shape=box,color=blue];
		1394 -> 1399;
	1396 [label="Check boolean LyonPainOff",color=orange];
		1396 -> 1400 [label=true,color=green];
		1396 -> 1401 [label=false,color=brown];
	1395 [label="謝謝……但我在想，這種悲傷能持續多久，才能隨著時間變成另一種更容易承受的負擔？",shape=box,color=blue];
		1395 -> 1390;
	1397 [label="Evaluate expressions",color=orange];
		1397 -> 1403 [label="DrifterLiar",color=purple];
		1397 -> 1402 [label="LyonNoDate",color=purple];
		1397 -> 1404 [label="false",color=purple];
	1398 [label="Chat ends.",color=orange];
	1399 [label="我必須請求你的原諒。有時我會神智不清，我討厭別人看到我這副模樣。",shape=box,color=blue];
		1399 -> 1405;
	1400 [label="投降是多麼容易。放棄是多麼容易。把我的痛苦擺在苦難的祭壇上，然後不發一語。",shape=box,color=blue];
		1400 -> 1406;
	1401 [label="投降是多麼容易。放棄是多麼容易。把我的痛苦放在苦難的祭壇上，然後不發一語。或者做更糟糕的事——做許多人擔心我可能會在黑夜深處用刀刃做的事。",shape=box,color=blue];
		1401 -> 1406;
	1403 [label="只是……有個問題，漂泊者。我知道你以前說過謊，我怎麼能相信你說的是真話呢？",shape=box,color=blue];
		1403 -> 1408;
	1402 [label="雖說我深感榮幸，但我恐怕我的回答非常簡單清楚是「不」。",shape=box,color=blue];
		1402 -> 1407;
	1404 [label="我無話可說。",shape=box,color=blue];
		1404 -> 1409;
	1405 [label="Evaluate expressions",color=orange];
		1405 -> 1410 [label="MarieDating",color=purple];
		1405 -> 1412 [label="MarieDating",color=purple];
		1405 -> 1410 [label="RoatheDating",color=purple];
		1405 -> 1412 [label="RoatheDating",color=purple];
		1405 -> 1410 [label="false",color=purple];
		1405 -> 1411 [label="false",color=purple];
		1405 -> 1412 [label="false",color=purple];
	1406 [label="但這……不……是我。這不是我，也永遠不會是我。我要繼續作為這個……破碎的堡壘，這面粉碎的盾牌……",shape=box,color=blue];
		1406 -> 1413;
	1408 [label="我已經發現你說謊了。雖然我不知道你這次說謊的目的是什麼，但恐怕你已經徹底摧毀了我對你的信任。",shape=box,color=blue];
		1408 -> 1414;
	1407 [label="Chat ends.",color=orange];
	1409 [label="我知道這對我來說並不完全罕見，然而，我覺得我應該對此做出某種回應",shape=box,color=blue];
		1409 -> 1415;
	1410 [label="你想在這裡停下來嗎？還是你能繼續？無論如何我都理解。",shape=box,color=red];
		1410 -> 1416;
	1412 [label="沒事的。我會陪著你。你會沒事的吧？",shape=box,color=red];
		1412 -> 1418;
	1411 [label="[表白心意] 里昂，我……我在乎你。如果你願意的話，當你有這些時刻時，我想陪在你身邊。",shape=box,color=red];
		1411 -> 1417;
	1413 [label="一直在流血，卻永遠死不去……",shape=box,color=blue];
		1413 -> 1419;
	1414 [label="所以，雖說我深感榮幸，但我恐怕我的回答非常簡單清楚",shape=box,color=blue];
		1414 -> 1420;
	1415 [label="— 以某種巧妙的方式，或至少以某種似乎適合這種情況的方式，而不是 —",shape=box,color=blue];
		1415 -> 1421;
	1416 [label="我可以繼續，謝謝你。它過去了，就像它們總會過去一樣。我的這些……幻象就像掠過太陰的雲朵。它們可能完全籠罩黑暗，但通常很短暫。",shape=box,color=blue];
		1416 -> 1422;
	1418 [label="是的，謝謝你。它過去了，就像它們總會過去一樣。我的這些……幻象就像掠過太陰的雲朵。它們可能完全籠罩黑暗，但通常很短暫。",shape=box,color=blue];
		1418 -> 1422;
	1417 [label="你肯定是在開玩笑吧？在你親眼目睹了這一切之後，你不可能真心實意地說出這些話吧？要嘛你失去了理智，要嘛你的同情心蒙蔽了你的雙眼。",shape=box,color=blue];
		1417 -> 1423;
		1417 -> 1424;
	1419 [label="這就是人生c'est la vie，對吧？",shape=box,color=blue];
		1419 -> 1425;
	1420 [label="不。",shape=box,color=blue];
		1420 -> 1426;
	1421 [label="——而不是讓你覺得這份感情沒有得到回應，因為事實絕非如此——",shape=box,color=blue];
		1421 -> 1427;
