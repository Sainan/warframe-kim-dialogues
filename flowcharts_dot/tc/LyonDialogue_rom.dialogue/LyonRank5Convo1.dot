		j3626627435 -> j1938257658 [label="LyonMITW1",color=purple];
		j3626627435 -> j1350559949 [label="LyonMITW1",color=purple];
		j3626627435 -> j3595675393 [label="RoatheMITW3",color=purple];
		j3626627435 -> j1350559949 [label="RoatheMITW3",color=purple];
		j3626627435 -> j3595675393 [label="RoatheMITW2",color=purple];
		j3626627435 -> j1350559949 [label="RoatheMITW2",color=purple];
		j3626627435 -> j3595675393 [label="RoatheMITW1",color=purple];
		j3626627435 -> j1350559949 [label="RoatheMITW1",color=purple];
		j3626627435 -> j720822666 [label="false",color=purple];
		j3626627435 -> j1350559949 [label="false",color=purple];
	j436284630 [label="你之前提到過你想談談我不認為「漠然」是「真正的神」這件事。現在是時候討論嗎？",shape=box,color=red];
		j436284630 -> j1645878856;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j1938257658 [label="那天你問我關於概念式體現跟漠然的問題。你是不是有什麼煩惱事？",shape=box,color=red];
		j1938257658 -> j2430171587;
	j3595675393 [label="羅瑟信牆中人並非真正的神，而是「概念式體現」的產物。你怎麼看？",shape=box,color=red];
		j3595675393 -> j2648533238;
	j720822666 [label="里昂，你和羅瑟之間到底發生了什麼事？我只聽到了一些零星的消息。",shape=box,color=red];
		j720822666 -> j720521557;
	j1645878856 [label="漂泊者，我不確定什麼時候才叫「好」時機，畢竟這對我造成了實質的困擾。",shape=box,color=blue];
		j1645878856 -> j548596891;
	"Chat ends." [color=orange];
	j2430171587 [label="漂泊者，有很多事情困擾著我。恐怕關於漠然和概念式體現的話題只是其中之一。",shape=box,color=blue];
		j2430171587 -> j3194383228;
	j2648533238 [label="漂泊者，問題在於我不知道。如果我知道答案的話，我就不會陷入如此痛苦的內心掙扎了。",shape=box,color=blue];
		j2648533238 -> j3230768495;
	j720521557 [label="我會長話短說，雖然我很驚訝你居然沒聽過他對這件事的長篇大論。他可是迫不及待想抓住每個機會去說出這些怨言呢。",shape=box,color=blue];
		j720521557 -> j1875827528;
	j548596891 [label="但是，現在也的確算是「好」時機了。而我感到好奇的是，你似乎同意羅瑟的觀點，認為漠然並非真正的神。",shape=box,color=blue];
		j548596891 -> j3230768495;
	j3194383228 [label="或者兩者都是，這取決於你想怎麼解讀當下的情況。不過我想，這確實就是讓我進退兩難的關鍵。",shape=box,color=blue];
		j3194383228 -> j3230768495;
	j3230768495 [label="不過，我應該……從頭說起。如果你不了解來龍去脈，大概無法理解為什麼這個話題對我這麼重要……",shape=box,color=blue];
		j3230768495 -> j253666026;
	j1875827528 [label="他認為，漠然並非虛空之神，無論從哪個意義上來說都是如此，它實際上是由源拓氏以及之後所有與它接觸過的人共同創造的。",shape=box,color=blue];
		j1875827528 -> j3582871319;
	j253666026 [label="我是太陰的兄弟。我畢生致力於對她的崇拜。我一生都堅信這一點。",shape=box,color=blue];
		j253666026 -> j863660653;
	j3582871319 [label="- 透過你所知的「概念式體現」從虛空創造出來。 ",shape=box,color=blue];
		j3582871319 -> j955757652;
	j863660653 [label="自從我來到教會以來，這麼多年裡面，我一直堅守著我的信仰——我堅信，我的苦難、我的痛苦和我的幻象——",shape=box,color=blue];
		j863660653 -> j4132735706;
	j955757652 [label="我相信，你創作渡域的方式也跟它非常相似。",shape=box,color=blue];
		j955757652 -> j3230768495;
	j4132735706 [label="——全是為了侍奉她。以她的名義。因她的旨意。",shape=box,color=blue];
		j4132735706 -> j1956824222;
	j1956824222 [label="那是……直到「日曜主教」承認他其實就是阿爾布雷希特．源拓氏之前，我都是這麼想的。",shape=box,color=blue];
		j1956824222 -> j649553104;
	j649553104 [label="他向我們坦白了他的真實身份，講述了他與虛空之間的種種罪行，以及由此產生的一切後果。更確切地說……是從中逃出的某種東西。",shape=box,color=blue];
		j649553104 -> j3678008891;
		j649553104 -> j461122974;
	j3678008891 [label="漠然。",shape=box,color=red];
		j3678008891 -> j3598448686;
	j461122974 [label="然後呢？",shape=box,color=red];
		j461122974 -> j3138727179;
	j3598448686 [label="沒錯。他向我們講述了那個冷笑著迎接他的東西，以及他從那個酷似他實驗室的地方取回的手指。",shape=box,color=blue];
		j3598448686 -> j4035964821;
	j3138727179 [label="他說，他曾乘坐色璃艙鐘，沉入那片空無之中。那個酷似他實驗室的地方。",shape=box,color=blue];
		j3138727179 -> j4035964821;
	j4035964821 [label="此外，他還告訴了我們他感受到的巨大恐懼，因為他知道，他所釋放出的那個東西，不僅能跨越空間，更能跨越時間跟隨他。",shape=box,color=blue];
		j4035964821 -> j2783624773;
	j2783624773 [label="虛無之神。一個必須被禁錮的東西。一個他還留著碎塊、正在牆壁後面拼命想逃出來的造物。",shape=box,color=blue];
		j2783624773 -> j229915438;
	j229915438 [label="可怕的神祇，吞噬一切的神祇。祂既已自由，也尚未自由。",shape=box,color=blue];
		j229915438 -> j3064612536;
		j229915438 -> j4113576490;
	j3064612536 [label="你是什麼意思？",shape=box,color=red];
		j3064612536 -> j3826452011;
	j4113576490 [label="「既」已自由，「也尚未」自由？",shape=box,color=red];
		j4113576490 -> j3826452011;
	j3826452011 [label="Check boolean LyonRell1",color=orange];
		j3826452011 -> j3029527463 [label=true,color=green];
		j3826452011 -> j3478706732 [label=false,color=brown];
	j3029527463 [label="時間……對於處於我現在這種狀態的人來說，是纏繞糾結的。很難形容。我曾嘗試解釋過一次，但卻徹底失敗了。",shape=box,color=blue];
		j3029527463 -> j4255987573;
	j3478706732 [label="對於處於我現在這種狀態的人來說，時間是……纏繞糾結的。這難以描述，而我的描述令一切更難描述。",shape=box,color=blue];
		j3478706732 -> j4255987573;
	j4255987573 [label="我更希望擇日再解釋其中的細節，因為那並非我今日想闡述的重點。",shape=box,color=blue];
		j4255987573 -> j366078008;
	j366078008 [label="Check boolean LyonRell1",color=orange];
		j366078008 -> j2550649451 [label=true,color=green];
		j366078008 -> j3524411925 [label=true,color=green];
		j366078008 -> j3531260318 [label=true,color=green];
		j366078008 -> j3524411925 [label=false,color=brown];
		j366078008 -> j3531260318 [label=false,color=brown];
	j2550649451 [label="但是，如果你聽過——或正在聆聽—— Rell 的話……我想談談這件事。",shape=box,color=red];
		j2550649451 -> j4154858580;
	j3524411925 [label="好的，你說了算。",shape=box,color=red];
		j3524411925 -> j2471509237;
	j3531260318 [label="我確實想深入探討一下這個問題……",shape=box,color=red];
		j3531260318 -> j2263385095;
	j4154858580 [label="我知道。而我一直刻意迴避這個話題。光是他的名字就足以讓我避而不談。",shape=box,color=blue];
		j4154858580 -> j3581351807;
	j2471509237 [label="我知道我一直在極力刻意避開這個話題，我很抱歉。但它很可能會讓我陷入一種幻象，我並不確定自己能否輕易擺脫。",shape=box,color=blue];
		j2471509237 -> j3344327307;
	j2263385095 [label="我向你保證，我們會的。我知道我一直在極力刻意避開這個話題，我很抱歉。但它很可能會讓我陷入一種幻象，我並不確定自己能否輕易擺脫。",shape=box,color=blue];
		j2263385095 -> j3344327307;
	j3581351807 [label="它在威脅著",shape=box,color=blue];
		j3581351807 -> j394193057;
	j3344327307 [label="我不想再次因為我身體不適而不得不中斷這次對話。",shape=box,color=blue];
		j3344327307 -> j2975917128;
		j3344327307 -> j1525080051;
		j3344327307 -> j3385537507;
	j394193057 [label="讓人聯想到一個男人被鎖鏈束縛的畫面",shape=box,color=blue];
		j394193057 -> j1208977372;
	j2975917128 [label="里昂，我不認為我會叫任何經歷過你所經歷的一切的人做「體弱者」。",shape=box,color=red];
		j2975917128 -> j834013407;
	j1525080051 [label="以「虛弱」來形容「被自己不願看見的幻象所詛咒」實在太糟糕了。不過，隨你喜歡。",shape=box,color=red];
		j1525080051 -> j834013407;
	j3385537507 [label="你清楚自己的能力，所以我會聽從你的安排。",shape=box,color=red];
		j3385537507 -> j1856871766;
	j1208977372 [label="以血鑄造",shape=box,color=blue];
		j1208977372 -> j1963696556;
	j834013407 [label="我謝謝你的好意。但我知道自己，即使在最好的情況下，我也只不過是一扇破碎的彩色玻璃窗。我站在這裡在想有那麼多碎片散落到了什麼地方。",shape=box,color=blue];
		j834013407 -> j2775187816;
	j1856871766 [label="謝謝你。你的耐性讓我驚嘆。但我知道即使在最好的情況下，我也只不過是一扇破碎的彩色玻璃窗。我站在這裡在想有那麼多碎片散落到了什麼地方。",shape=box,color=blue];
		j1856871766 -> j2775187816;
	j1963696556 [label="以筋腱以及血肉鑿成",shape=box,color=blue];
		j1963696556 -> j2424696061;
	j2775187816 [label="每次我找到丟失的碎片時，我更有可能被碎片的邊緣割傷，而不是把它放回原來的位置。",shape=box,color=blue];
		j2775187816 -> j3979887942;
	j2424696061 [label="請你叫這一切停下來",shape=box,color=blue];
		j2424696061 -> j3429401037;
	j3979887942 [label="有時我感到好奇，如果我能成為我腦海中那些眼神空洞的 Harrow 之一，是不是會更好，這種感覺會隨著我的惡夢延伸到極致。",shape=box,color=blue];
		j3979887942 -> j3090338735;
	j3429401037 [label="他們的臉龐
千千萬萬
空洞而破碎
沉默不語
永遠破碎的禱告
我將成為什麼",shape=box,color=blue];
		j3429401037 -> j1953216292;
		j3429401037 -> j1968252684;
	j3090338735 [label="Evaluate expressions",color=orange];
		j3090338735 -> j3238875582 [label="MarieDating",color=purple];
		j3090338735 -> j3647401022 [label="MarieDating",color=purple];
		j3090338735 -> j3647401022 [label="RoatheDating",color=purple];
		j3090338735 -> j3238875582 [label="RoatheDating",color=purple];
		j3090338735 -> j3647401022 [label="false",color=purple];
		j3090338735 -> j3238875582 [label="false",color=purple];
		j3090338735 -> j470440033 [label="false",color=purple];
	j1953216292 [label="深呼吸，里昂。深呼吸。他們並不是真的在那裡。",shape=box,color=red];
		j1953216292 -> j2259781834;
	j1968252684 [label="我 ─ 對不起，里昂。專心看著螢幕。我在這裡。",shape=box,color=red];
		j1968252684 -> j197630385;
	j3238875582 [label="我知道這是你被迫承擔的沉重負擔。也許這樣是不對的。但我不知道該如何擺脫困境。",shape=box,color=red];
		j3238875582 -> j930018969;
	j3647401022 [label="你對瑪麗來說非常重要。你也成了我非常親密的朋友。我想即使是羅瑟也會想念你，雖然他不會承認。",shape=box,color=red];
		j3647401022 -> j4125328224;
	j470440033 [label="[表白心意] 里昂，如果你讓那種事發生在你身上，我會心碎的。我……我很在乎你。",shape=box,color=red];
		j470440033 -> j3590600943;
	j2259781834 [label="你錯了
他們就在那裡
而他們永遠不會再離開我
永遠都不會
源拓氏能保證
原諒我",shape=box,color=blue];
		j2259781834 -> j2862131335;
	j197630385 [label="撕裂我的血肉
把它從我的骨頭上剝離
為什麼？為了什麼目的？
這究竟是為了滿足誰的飢餓？",shape=box,color=blue];
		j197630385 -> j2191768386;
		j197630385 -> j3643622187;
	j930018969 [label="除非訴諸……難以想像的手段。或者說只能那樣了。",shape=box,color=red];
		j930018969 -> j3513767195;
	j4125328224 [label="你被珍惜。你被愛。你有家人和朋友。即使有時你可能感覺不到這一點。",shape=box,color=red];
		j4125328224 -> j1601207684;
	j3590600943 [label="我 — 你肯定是在開玩笑吧？在你親眼目睹了這一切之後，你不可能真心實意地說出這些話吧？要嘛你失去了理智，要嘛你的同情心蒙蔽了你的雙眼。",shape=box,color=blue];
		j3590600943 -> j3443487738;
		j3590600943 -> j804643032;
	j2862131335 [label="+10 Chemistry",color=orange];
		j2862131335 -> j4006363057;
	j2191768386 [label="沒有人。你不需要再這樣痛苦了。放下吧。",shape=box,color=red];
		j2191768386 -> j4102408827;
	j3643622187 [label="我知道。我知道這很痛苦。很對不起。走出來房間吧。",shape=box,color=red];
		j3643622187 -> j1590285657;
	j3513767195 [label="+10 Chemistry",color=orange];
		j3513767195 -> j1318592273;
	j1601207684 [label="里昂，你並不孤單。而我們都會想念你。",shape=box,color=red];
		j1601207684 -> j3750434779;
	j3443487738 [label="不，里昂。我是認真的。你對我來說很重要，而我只希望我能讓你相信這一點。",shape=box,color=red];
		j3443487738 -> j2925491369;
	j804643032 [label="我……也許你是對的。也許現在不是時候。",shape=box,color=red];
		j804643032 -> j478927729;
	j4006363057 [label="Boolean LyonRell2b is now true.",color=orange];
		j4006363057 -> "Chat ends.";
	j4102408827 [label="如果事情真有那麼簡單就好了
這些鎖鏈我已束縛太久
比語言更長
比我的名字更長
原諒我",shape=box,color=blue];
		j4102408827 -> j2862131335;
	j1590285657 [label="轉身，並在腦海中走出這個房間。",shape=box,color=red];
		j1590285657 -> j19825196;
	j1318592273 [label="我看到了亡骸精靈先生，也聽說了 Ordis 先生或 Otak 先生的故事。我想到那些空蕩蕩的 Warframe，它們的思想被從頭顱中抽離。",shape=box,color=blue];
		j1318592273 -> j798816541;
	j3750434779 [label="+10 Chemistry",color=orange];
		j3750434779 -> j3673788261;
	j2925491369 [label="我。",shape=box,color=blue];
		j2925491369 -> j2228720352;
	j478927729 [label="很好。我很高興你從自己短暫的瘋狂中清醒過來了。這畢竟一定會傳染。也許我們該從這個裝置上休息一下，因為我擔心它已經開始腐蝕你的大腦了。",shape=box,color=blue];
		j478927729 -> "Chat ends.";
	j19825196 [label="是的
他們會在另一個時間出現
這個血與鏈的密室
等待
永遠等待",shape=box,color=blue];
		j19825196 -> j2575481540;
	j798816541 [label="Check boolean LyonPainOff",color=orange];
		j798816541 -> j1314236460 [label=true,color=green];
		j798816541 -> j2369183202 [label=false,color=brown];
	j3673788261 [label="謝謝……但我在想，這種悲傷能持續多久，才能隨著時間變成另一種更容易承受的負擔？",shape=box,color=blue];
		j3673788261 -> j1318592273;
	j2228720352 [label="Evaluate expressions",color=orange];
		j2228720352 -> j478067985 [label="DrifterLiar",color=purple];
		j2228720352 -> j1630063908 [label="LyonNoDate",color=purple];
		j2228720352 -> j1785937496 [label="false",color=purple];
	j2575481540 [label="我必須請求你的原諒。有時我會神智不清，我討厭別人看到我這副模樣。",shape=box,color=blue];
		j2575481540 -> j1242024200;
	j1314236460 [label="投降是多麼容易。放棄是多麼容易。把我的痛苦擺在苦難的祭壇上，然後不發一語。",shape=box,color=blue];
		j1314236460 -> j1535577674;
	j2369183202 [label="投降是多麼容易。放棄是多麼容易。把我的痛苦放在苦難的祭壇上，然後不發一語。或者做更糟糕的事——做許多人擔心我可能會在黑夜深處用刀刃做的事。",shape=box,color=blue];
		j2369183202 -> j1535577674;
	j478067985 [label="只是……有個問題，漂泊者。我知道你以前說過謊，我怎麼能相信你說的是真話呢？",shape=box,color=blue];
		j478067985 -> j1766339698;
	j1630063908 [label="雖說我深感榮幸，但我恐怕我的回答非常簡單清楚是「不」。",shape=box,color=blue];
		j1630063908 -> "Chat ends.";
	j1785937496 [label="我無話可說。",shape=box,color=blue];
		j1785937496 -> j4222998004;
	j1242024200 [label="Evaluate expressions",color=orange];
		j1242024200 -> j1557485368 [label="MarieDating",color=purple];
		j1242024200 -> j1277651348 [label="MarieDating",color=purple];
		j1242024200 -> j1557485368 [label="RoatheDating",color=purple];
		j1242024200 -> j1277651348 [label="RoatheDating",color=purple];
