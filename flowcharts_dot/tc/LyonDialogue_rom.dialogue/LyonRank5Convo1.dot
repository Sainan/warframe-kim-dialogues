	1426 [label="Chat ends.",color=orange];
	1427 [label="我可以打斷一下嗎？",shape=box,color=red];
		1427 -> 1433;
	1428 [label="里昂？",shape=box,color=red];
		1428 -> 1434;
	1429 [label="太陰在上……我說到哪裡了？",shape=box,color=blue];
		1429 -> 1435;
	1430 [label="很好。我很高興你從自己短暫的瘋狂中清醒過來了。這畢竟一定會傳染。也許我們該從這個裝置上休息一下，因為我擔心它已經開始腐蝕你的大腦了。",shape=box,color=blue];
		1430 -> 1436;
	1431 [label="你完全有理由時不時發洩一下。我很高興你覺得跟我說話很自在。",shape=box,color=red];
		1431 -> 1437;
	1432 [label="這當然不是自憐。我得查查另外兩個詞才能知道它們是否成立。",shape=box,color=red];
		1432 -> 1438;
	1433 [label="請說。",shape=box,color=blue];
		1433 -> 1439;
		1433 -> 1440;
	1434 [label="怎麼了？",shape=box,color=blue];
		1434 -> 1439;
		1434 -> 1440;
	1435 [label="你剛剛談到了漠然和源拓氏，以及現在對你來說時間是如何變得不再那麼……線性。",shape=box,color=red];
		1435 -> 1441;
	1436 [label="Chat ends.",color=orange];
	1437 [label="謝謝。我盡量避免讓自己的擔憂變為別人的負擔。但我很感激你給我這個機會。",shape=box,color=blue];
		1437 -> 1429;
	1438 [label="+5 Chemistry",color=orange];
		1438 -> 1442;
	1439 [label="算了沒事。",shape=box,color=red];
		1439 -> 1443;
	1440 [label="你願意跟我「出去」嗎？我不太清楚你們那一代該怎麼稱呼這種行為。大概是求愛吧。",shape=box,color=red];
		1440 -> 1444;
	1441 [label="沒錯。是的。為了避免陷入循環論證，我們還是跳過這個故事的這一點吧如果你願意的話。",shape=box,color=blue];
		1441 -> 1445;
	1442 [label="這令我笑了。謝謝。",shape=box,color=blue];
		1442 -> 1429;
	1443 [label="Update boolean LyonNoDate",color=orange];
		1443 -> 1446;
	1444 [label="太陰，是的。",shape=box,color=blue];
		1444 -> 1447;
	1445 [label="然而，當源拓氏告訴我，我腦海中的聲音和我一生所遭受的幻象不是太陰造成的結果時，想像一下我的沮喪──",shape=box,color=blue];
		1445 -> 1448;
	1446 [label="Chat ends.",color=orange];
	1447 [label="+20 Chemistry",color=orange];
		1447 -> 1449;
	1448 [label="──它們是漠然對時間線的腐化。",shape=box,color=blue];
		1448 -> 1450;
		1448 -> 1451;
		1448 -> 1452;
	1449 [label="是的，是的，是的！",shape=box,color=blue];
		1449 -> 1453;
	1450 [label="但漠然怎麼可能追溯到你的年代？甚至更早，追溯到你的童年？",shape=box,color=red];
		1450 -> 1454;
	1451 [label="噢……噢不。",shape=box,color=red];
