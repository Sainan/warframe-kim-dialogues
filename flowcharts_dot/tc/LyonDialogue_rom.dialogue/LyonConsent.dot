	"Chat ends." [color=orange];
	j1181132753 [label="Check boolean LyonConsentComplete",color=orange];
		j1181132753 -> "Chat ends." [label=true,color=green];
		j1181132753 -> j2714890705 [label=false,color=brown];
	j1316396836 [label="Check boolean LyonPolyamorySuccess",color=orange];
		j1316396836 -> j1181132753 [label=true,color=green];
		j1316396836 -> "Chat ends." [label=false,color=brown];
	j2714890705 [label="I wish, if I may, to discuss something briefly that I think would put both of our minds at ease, mon miracle.",shape=box,color=blue];
		j2714890705 -> j4092949936;
		j2714890705 -> j3380711970;
	j4092949936 [label="[結束]",shape=box,color=red];
		j4092949936 -> j3944516755;
	j3380711970 [label="有什麼問題嗎，里昂？",shape=box,color=red];
		j3380711970 -> j4181882624;
	j3944516755 [label="Boolean LyonConsentComplete is now true.",color=orange];
		j3944516755 -> "Chat ends.";
	j4181882624 [label="No, nothing is the matter. I simply wished to say that I know you spend time with another in a... amorous way, when you are not with me.",shape=box,color=blue];
		j4181882624 -> j392826153;
	j392826153 [label="And I simply wished to assure you that this does not give me pause nor unease. Your presence in my life has brought me nothing but peace, nothing but joy...",shape=box,color=blue];
		j392826153 -> j3316743480;
	j3316743480 [label="And how could I ever deny that kind of gift to be bestowed upon another?",shape=box,color=blue];
		j3316743480 -> j1794487955;
		j3316743480 -> j1528958345;
	j1794487955 [label="I do think they would adore you, for what it's worth.",shape=box,color=red];
		j1794487955 -> j2764150210;
	j1528958345 [label="Thank you. That means a lot to me.",shape=box,color=red];
		j1528958345 -> j3316136216;
	j2764150210 [label="The thought of it makes me smile. And who knows, perhaps in another life, or another day, we may meet. ",shape=box,color=blue];
		j2764150210 -> j537129550;
	j3316136216 [label="As we are - as I am, with all you have brought me, all that we represent... I am content. Nay, I am... happy. For the first time in a very, very long time.",shape=box,color=blue];
		j3316136216 -> j199793261;
	j537129550 [label="But in this one, I am content as we are. Nay, I am... happy. For the first time in a very, very long time.",shape=box,color=blue];
		j537129550 -> j199793261;
	j199793261 [label="這一切都要感謝你。不過，現在，我要跟你說再見了。",shape=box,color=blue];
		j199793261 -> j306837280;
	j306837280 [label="- 里昂",shape=box,color=blue];
		j306837280 -> j3944516755;
}