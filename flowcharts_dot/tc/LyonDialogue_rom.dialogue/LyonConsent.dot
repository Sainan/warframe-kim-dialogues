	"Chat ends." [color=orange];
	j1181132753 [label="Check boolean LyonConsentComplete",color=orange];
		j1181132753 -> "Chat ends." [label=true,color=green];
		j1181132753 -> j834434792 [label=false,color=brown];
	j1316396836 [label="Check boolean LyonPolyamorySuccess",color=orange];
		j1316396836 -> j1181132753 [label=true,color=green];
		j1316396836 -> "Chat ends." [label=false,color=brown];
	j834434792 [label="如果可以的話，我想簡短地討論一些我認為能讓我們兩人都安心的事情，我的奇蹟。",shape=box,color=blue];
		j834434792 -> j4092949936;
		j834434792 -> j1819799302;
	j4092949936 [label="[結束]",shape=box,color=red];
		j4092949936 -> j3944516755;
	j1819799302 [label="有什麼問題嗎，里昂？",shape=box,color=red];
		j1819799302 -> j931755618;
	j3944516755 [label="Boolean LyonConsentComplete is now true.",color=orange];
		j3944516755 -> "Chat ends.";
	j931755618 [label="不，沒什麼問題。我只是想說，我知道你沒和我在一起的時候，會以……愛戀的方式與另一個人共度時光。",shape=box,color=blue];
		j931755618 -> j4029008332;
	j4029008332 [label="我只是想向你保證，這不會讓我猶豫或不安。你在我生命中的存在只給我帶來了平靜，只帶來了喜悅……",shape=box,color=blue];
		j4029008332 -> j178412984;
	j178412984 [label="我怎麼能拒絕這樣的禮物被賜予另一個人呢？",shape=box,color=blue];
		j178412984 -> j4239524874;
		j178412984 -> j2173583662;
	j4239524874 [label="我真的覺得他們會很喜歡你，雖然這可能不算什麼。",shape=box,color=red];
		j4239524874 -> j4215876873;
	j2173583662 [label="謝謝你。這對我意義重大。",shape=box,color=red];
		j2173583662 -> j3071288203;
	j4215876873 [label="想到這件事讓我微笑。誰知道呢，也許在另一個人生，或另一天，我們可能會見面。",shape=box,color=blue];
		j4215876873 -> j3759511694;
	j3071288203 [label="就像我們現在這樣，就像我現在這樣，帶著你給我的一切，我們所代表的一切……我很滿足。不，我是……快樂的。這是很長很長時間以來的第一次。",shape=box,color=blue];
		j3071288203 -> j199793261;
	j3759511694 [label="但在這一生中，我對我們現在的樣子很滿足。不，我是……快樂的。這是很長很長時間以來的第一次。",shape=box,color=blue];
		j3759511694 -> j199793261;
	j199793261 [label="這一切都要感謝你。不過，現在，我要跟你說再見了。",shape=box,color=blue];
		j199793261 -> j306837280;
	j306837280 [label="- 里昂",shape=box,color=blue];
		j306837280 -> j3944516755;
}