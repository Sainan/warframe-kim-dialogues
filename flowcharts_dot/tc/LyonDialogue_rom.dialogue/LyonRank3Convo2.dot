digraph {
	"LyonRank3Convo2 begins." [color=orange];
		"LyonRank3Convo2 begins." -> j2840867185;
	j2840867185 [label="如果可以的話，我想跟你們說個關於一隻經常出沒於教堂後面的流浪貓的故事。",shape=box,color=blue];
		j2840867185 -> j72109452;
		j2840867185 -> j3915476511;
		j2840867185 -> j3102889003;
	j72109452 [label="繼續說。",shape=box,color=red];
		j72109452 -> j985384870;
	j3915476511 [label="為什麼？",shape=box,color=red];
		j3915476511 -> j1779112186;
	j3102889003 [label="[無視]",shape=box,color=red];
		j3102889003 -> "Chat ends.";
	j985384870 [label="謝謝。",shape=box,color=blue];
		j985384870 -> j3600078915;
	j1779112186 [label="我覺得解釋的功夫不值得。",shape=box,color=blue];
		j1779112186 -> j3942381447;
	"Chat ends." [color=orange];
	j3600078915 [label="雖然我懷疑這個並非這隻老貓專屬的故事，而且我與他的互動似乎也不值得一提，但無論如何，牠都值得被講出來。",shape=box,color=blue];
		j3600078915 -> j359816812;
	j3942381447 [label="算了沒事。",shape=box,color=blue];
		j3942381447 -> "Chat ends.";
	j359816812 [label="他每天都會來乞討剩菜剩飯，以及他能從我和其他疼愛他的兄弟姊妹那得到的些微的關愛。",shape=box,color=blue];
		j359816812 -> j2699346109;
	j2699346109 [label="他亂糟糟的，腿一拐一拐的，還少了一隻耳朵。 ",shape=box,color=blue];
		j2699346109 -> j3147201678;
	j3147201678 [label="幾天沒見他，瑪麗擔心得要命。但對於一隻氣數將盡的老流浪貓，除了向太陰祈禱，還能做什麼呢？",shape=box,color=blue];
		j3147201678 -> j3437213928;
	j3437213928 [label="Boolean LyonStray is now true.",color=orange];
		j3437213928 -> j2178108909;
		j3437213928 -> j2550104309;
		j3437213928 -> j3532687102;
	j2178108909 [label="[讓他繼續]",shape=box,color=red];
		j2178108909 -> j2793003508;
	j2550104309 [label="你們的宗教允許這樣做嗎？我意思是，為動物祈禱。",shape=box,color=red];
		j2550104309 -> j401344257;
	j3532687102 [label="你會為死去的流浪貓祈禱嗎？",shape=box,color=red];
		j3532687102 -> j1227900178;
	j2793003508 [label="不過，當我在市場買麵包時，看到那隻老貓坐在攤主旁邊，我感到非常驚訝。",shape=box,color=blue];
		j2793003508 -> j2665100683;
	j401344257 [label="+10 Chemistry",color=orange];
		j401344257 -> j4203536212;
	j1227900178 [label="當然。我所遇到的一些最純潔，最聰慧的靈魂，但被困在野獸的肉身之中。我無權評斷聖光者如何指引他們走上這條路。",shape=box,color=blue];
		j1227900178 -> j3562172901;
	j2665100683 [label="他跟往常一樣，用沙啞的喵叫聲向我打招呼，然後跳下來蹭我的腿。",shape=box,color=blue];
		j2665100683 -> j3997254787;
	j4203536212 [label="好問題。在某些教派中，答案是不可以，這會被視為異端。但在我們教派中，答案是可以的。我們認為動物擁有靈魂。",shape=box,color=blue];
		j4203536212 -> j3562172901;
	j3562172901 [label="聖伊麗莎白智者以善待動物而聞名，雖然許多傳統並不承認聖徒是聖光者的徒。",shape=box,color=blue];
		j3562172901 -> j1091926629;
	j3997254787 [label="我還要指出一點，漂泊者，他這樣做的時候並沒有跛。",shape=box,color=blue];
		j3997254787 -> j960275388;
	j1091926629 [label="我好奇想知道，我們這個組織的影響力是否延續至今……但這並非我們談話的重點。",shape=box,color=blue];
		j1091926629 -> j1104513585;
	j960275388 [label="「啊，原來是老德輔羅的傻瓜其中一個啊。」那人邊笑著邊把我的麵包裝進袋裡。",shape=box,color=blue];
		j960275388 -> j4085988088;
	j1104513585 [label="Boolean LyonLecture1 is now true.",color=orange];
		j1104513585 -> j2793003508;
	j4085988088 [label="原來那隻老貓一直在玩我們，還有在附近的其他幾個人。牠既沒有挨餓，也沒有生病，更沒有受到任何虐待。",shape=box,color=blue];
		j4085988088 -> j1744348438;
	j1744348438 [label="確實，如果這名男子的話是真的，那麼他對當地的鳥類來說簡直就是個殘忍的惡魔。",shape=box,color=blue];
		j1744348438 -> j909682946;
		j1744348438 -> j4177546066;
		j1744348438 -> j1842779553;
	j909682946 [label="老德輔羅再回來後，你有停止餵牠嗎？",shape=box,color=red];
		j909682946 -> j521788531;
	j4177546066 [label="你是想警告我關於羅瑟的事嗎？",shape=box,color=red];
		j4177546066 -> j2980787499;
	j1842779553 [label="你就是故事中的那隻流浪貓嗎？",shape=box,color=red];
		j1842779553 -> j2626325182;
	j521788531 [label="+10 Chemistry",color=orange];
		j521788531 -> j766699226;
	j2980787499 [label="有很多事情需要警告你們，關於在我們家門口的魔鬼「日曜主教」。也許這算是其中之一，也許不是。",shape=box,color=blue];
		j2980787499 -> j1178076871;
	j2626325182 [label="聖光者都知道我最近確實疲憊不堪。但這是否給我的一個警示呢？或許是，或許不是。",shape=box,color=blue];
		j2626325182 -> j1178076871;
	j766699226 [label="沒有，我們沒有。事實上，瑪麗反而更喜愛他，還逗他，說他是「她的小淘氣」。",shape=box,color=blue];
		j766699226 -> j937213711;
	j1178076871 [label="這只是一個例子，顯示有時候，當一個生物似乎需要幫助時 —",shape=box,color=blue];
		j1178076871 -> j711455766;
	j937213711 [label="但我們不再為牠操心了。我們已經知道老德輔羅完全可以照顧好自己。牠不需要我們。",shape=box,color=blue];
		j937213711 -> j916481522;
		j937213711 -> j3935145039;
	j711455766 [label="+15 Chemistry",color=orange];
		j711455766 -> j1739233577;
	j916481522 [label="那你知道老德輔羅後來怎樣了嗎？",shape=box,color=red];
		j916481522 -> j1294320814;
	j3935145039 [label="你覺得如果不是出於必要的話，是什麼原因驅使老德輔羅來看你呢？",shape=box,color=red];
		j3935145039 -> j1263651618;
	j1739233577 [label="- 檢查一下牠的爪子有多鋒利。",shape=box,color=blue];
		j1739233577 -> "Chat ends.";
	j1294320814 [label="兩年後，他的再度失蹤變成了永久失蹤。",shape=box,color=blue];
		j1294320814 -> j1409634858;
		j1294320814 -> j1247393593;
	j1263651618 [label="我可以給的諷刺答案會是：「貪婪」。既然可以大快朵頤一頓，為什麼不能吃兩頓？為什麼不能吃十頓？",shape=box,color=blue];
		j1263651618 -> j2257063910;
		j1263651618 -> j681142710;
	j1409634858 [label="你有為他祈禱嗎？",shape=box,color=red];
		j1409634858 -> j544616150;
	j1247393593 [label="我希望他離開這個世界時是感到舒服和被愛的。",shape=box,color=red];
		j1247393593 -> j4284482753;
	j2257063910 [label="不帶諷刺的回答又會是什麼？",shape=box,color=red];
		j2257063910 -> j2587387848;
	j681142710 [label="如果他只是尋求情感上的慰藉的話，情況會否一樣？",shape=box,color=red];
		j681142710 -> j2095073265;
	j544616150 [label="得知他去世的那天晚上，我為他點了一支蠟燭，並向太陰祈禱，希望她能引導他的靈魂去往……任何她會引導像他這樣的小精靈去的地方。",shape=box,color=blue];
		j544616150 -> j140126428;
	j4284482753 [label="我能問為什麼嗎？",shape=box,color=blue];
		j4284482753 -> j1829647135;
		j4284482753 -> j4220307680;
	j2587387848 [label="+10 Chemistry",color=orange];
		j2587387848 -> j3086658087;
	j2095073265 [label="對愛的貪婪渴望仍然是欲望，雖然它並非以肉食和美酒來滿足的飢渴。更別說牠是裝模作樣去尋求的？",shape=box,color=blue];
		j2095073265 -> j45546530;
		j2095073265 -> j1804351751;
	j140126428 [label="感謝老德輔羅帶給瑪麗的所有快樂，以換取那些美味的雞軟骨和摸頭服務。",shape=box,color=blue];
		j140126428 -> j4208349457;
	j1829647135 [label="牠是一隻動物。他只是在尋找滿足感 — 食物，住所，愛 — 他的動機跟人類截然不同。他並非在「撒謊」，他只是用不同的方式去捕獵。",shape=box,color=red];
		j1829647135 -> j1106056481;
	j4220307680 [label="里昂，我見過太多暴力，當中有很多都是我造成的。我現在希望每個人，無論他們是什麼人，無論他們做過什麼，都能在愛他們的人的陪伴下安詳地離世。",shape=box,color=red];
		j4220307680 -> j2740223173;
	j3086658087 [label="我發現自己竟然……內心對這隻貓有一份尊敬，因為牠在這個世界上找到了屬於自己的位置。",shape=box,color=blue];
		j3086658087 -> j1097305714;
	j45546530 [label="牠只是一隻貓，里昂。他當時都不知道自己在做什麼。",shape=box,color=red];
		j45546530 -> j3095698675;
	j1804351751 [label="我們還在討論一隻貓，是嗎？",shape=box,color=red];
		j1804351751 -> j3241963929;
	j4208349457 [label="謝謝。我不打擾你了。",shape=box,color=blue];
		j4208349457 -> j2331496732;
	j1106056481 [label="他並沒有剝奪其他人甚麼，反而讓你們都成了他的「傻瓜」。要說的話……你們似乎都從他的來訪中學到些東西。",shape=box,color=red];
		j1106056481 -> j945466173;
	j2740223173 [label="真有趣。我以為你會憎恨你的敵人。但這就是我的愚蠢之處 — 我竟然自以為知道當今時代人們會如何做人處事。",shape=box,color=blue];
		j2740223173 -> j1476623435;
	j1097305714 [label="這是一個學會利用自身狀況 — 外表、年紀、傷疤 — 作為武器來對抗周圍那些看不穿他詭計的「傻瓜」的生物。",shape=box,color=blue];
		j1097305714 -> j2897592481;
	j3095698675 [label="他很清楚怎樣裝跛。 ",shape=box,color=blue];
		j3095698675 -> j2587387848;
	j3241963929 [label="漂泊者，隨你自由理解這段對話。",shape=box,color=blue];
		j3241963929 -> j2587387848;
	j2331496732 [label="-里昂・阿拉德神父",shape=box,color=blue];
		j2331496732 -> "Chat ends.";
	j945466173 [label="Add -1 to Thermostat counter",color=orange];
		j945466173 -> j1154449267;
	j1476623435 [label="Add 1 to Thermostat counter",color=orange];
		j1476623435 -> j639199372;
	j2897592481 [label="他真是個亂糟糟毛茸茸的小淘氣。但每次他來造訪，我還是忍不住想摸摸牠。",shape=box,color=blue];
		j2897592481 -> j309193158;
	j1154449267 [label="是的，我想我們確實是。而我們當時也不缺雞軟骨和搔癢服務。",shape=box,color=blue];
		j1154449267 -> j1649386241;
	j639199372 [label="更何況像你這樣有著特別精彩成長經驗的人。 ",shape=box,color=blue];
		j639199372 -> j3284105737;
	j309193158 [label="兩年後，他的再度失蹤卻是永久性的，這同樣令人心碎。",shape=box,color=blue];
		j309193158 -> j1409634858;
		j309193158 -> j1247393593;
	j1649386241 [label="也許正因如此，我為他點了一支蠟燭，並向太陰祈禱，希望她能引導他的靈魂去往……任何她會引導像他這樣的小精靈去的地方。",shape=box,color=blue];
		j1649386241 -> j1309510926;
	j3284105737 [label="+5 Chemistry",color=orange];
		j3284105737 -> j3945609624;
	j1309510926 [label="+5 Chemistry",color=orange];
		j1309510926 -> j3689583253;
	j3945609624 [label="謝謝。我不打擾你了。這次談話非常有趣。期待下次再聊。",shape=box,color=blue];
		j3945609624 -> j2331496732;
	j3689583253 [label="那天晚上，我在禱告中感謝老德輔羅，感謝牠帶給瑪麗的所有快樂。",shape=box,color=blue];
		j3689583253 -> j2705665974;
	j2705665974 [label="或許牠那些小小的惡行，從某種意義上來說，也算是好事。",shape=box,color=blue];
		j2705665974 -> j3945609624;
}