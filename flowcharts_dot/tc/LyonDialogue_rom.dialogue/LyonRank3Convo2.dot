digraph {
	32 [label="LyonRank3Convo2 begins.",color=orange];
		32 -> 33;
	33 [label="如果可以的話，我想跟你們說個關於一隻經常出沒於教堂後面的流浪貓的故事。",shape=box,color=blue];
		33 -> 36;
		33 -> 35;
		33 -> 34;
	36 [label="繼續說。",shape=box,color=red];
		36 -> 39;
	35 [label="為什麼？",shape=box,color=red];
		35 -> 38;
	34 [label="[無視]",shape=box,color=red];
		34 -> 37;
	39 [label="謝謝。",shape=box,color=blue];
		39 -> 41;
	38 [label="我覺得解釋的功夫不值得。",shape=box,color=blue];
		38 -> 40;
	37 [label="Chat ends.",color=orange];
	41 [label="雖然我懷疑這個並非這隻老貓專屬的故事，而且我與他的互動似乎也不值得一提，但無論如何，牠都值得被講出來。",shape=box,color=blue];
		41 -> 43;
	40 [label="算了沒事。",shape=box,color=blue];
		40 -> 42;
	43 [label="他每天都會來乞討剩菜剩飯，以及他能從我和其他疼愛他的兄弟姊妹那得到的些微的關愛。",shape=box,color=blue];
		43 -> 44;
	42 [label="Chat ends.",color=orange];
	44 [label="他亂糟糟的，腿一拐一拐的，還少了一隻耳朵。 ",shape=box,color=blue];
		44 -> 45;
	45 [label="幾天沒見他，瑪麗擔心得要命。但對於一隻氣數將盡的老流浪貓，除了向太陰祈禱，還能做什麼呢？",shape=box,color=blue];
		45 -> 46;
	46 [label="Update boolean LyonStray",color=orange];
		46 -> 47;
		46 -> 48;
		46 -> 49;
	47 [label="[讓他繼續]",shape=box,color=red];
		47 -> 50;
	48 [label="你們的宗教允許這樣做嗎？我意思是，為動物祈禱。",shape=box,color=red];
		48 -> 51;
	49 [label="你會為死去的流浪貓祈禱嗎？",shape=box,color=red];
		49 -> 52;
	50 [label="不過，當我在市場買麵包時，看到那隻老貓坐在攤主旁邊，我感到非常驚訝。",shape=box,color=blue];
		50 -> 53;
	51 [label="+10 Chemistry",color=orange];
		51 -> 54;
	52 [label="當然。我所遇到的一些最純潔，最聰慧的靈魂，但被困在野獸的肉身之中。我無權評斷聖光者如何指引他們走上這條路。",shape=box,color=blue];
		52 -> 55;
	53 [label="他跟往常一樣，用沙啞的喵叫聲向我打招呼，然後跳下來蹭我的腿。",shape=box,color=blue];
		53 -> 56;
	54 [label="好問題。在某些教派中，答案是不可以，這會被視為異端。但在我們教派中，答案是可以的。我們認為動物擁有靈魂。",shape=box,color=blue];
		54 -> 55;
	55 [label="聖伊麗莎白智者以善待動物而聞名，雖然許多傳統並不承認聖徒是聖光者的徒。",shape=box,color=blue];
		55 -> 57;
	56 [label="我還要指出一點，漂泊者，他這樣做的時候並沒有跛。",shape=box,color=blue];
		56 -> 58;
	57 [label="我好奇想知道，我們這個組織的影響力是否延續至今……但這並非我們談話的重點。",shape=box,color=blue];
		57 -> 59;
	58 [label="「啊，原來是老德輔羅的傻瓜其中一個啊。」那人邊笑著邊把我的麵包裝進袋裡。",shape=box,color=blue];
		58 -> 60;
	59 [label="Update boolean LyonLecture1",color=orange];
		59 -> 50;
	60 [label="原來那隻老貓一直在玩我們，還有在附近的其他幾個人。牠既沒有挨餓，也沒有生病，更沒有受到任何虐待。",shape=box,color=blue];
		60 -> 61;
	61 [label="確實，如果這名男子的話是真的，那麼他對當地的鳥類來說簡直就是個殘忍的惡魔。",shape=box,color=blue];
		61 -> 62;
		61 -> 63;
		61 -> 64;
	62 [label="老德輔羅再回來後，你有停止餵牠嗎？",shape=box,color=red];
		62 -> 65;
	63 [label="你是想警告我關於羅瑟的事嗎？",shape=box,color=red];
		63 -> 66;
	64 [label="你就是故事中的那隻流浪貓嗎？",shape=box,color=red];
		64 -> 67;
	65 [label="+10 Chemistry",color=orange];
		65 -> 68;
	66 [label="有很多事情需要警告你們，關於在我們家門口的魔鬼「日曜主教」。也許這算是其中之一，也許不是。",shape=box,color=blue];
		66 -> 69;
	67 [label="聖光者都知道我最近確實疲憊不堪。但這是否給我的一個警示呢？或許是，或許不是。",shape=box,color=blue];
		67 -> 69;
	68 [label="沒有，我們沒有。事實上，瑪麗反而更喜愛他，還逗他，說他是「她的小淘氣」。",shape=box,color=blue];
		68 -> 70;
	69 [label="這只是一個例子，顯示有時候，當一個生物似乎需要幫助時 —",shape=box,color=blue];
		69 -> 71;
	70 [label="但我們不再為牠操心了。我們已經知道老德輔羅完全可以照顧好自己。牠不需要我們。",shape=box,color=blue];
		70 -> 72;
		70 -> 73;
	71 [label="+15 Chemistry",color=orange];
		71 -> 74;
	72 [label="那你知道老德輔羅後來怎樣了嗎？",shape=box,color=red];
		72 -> 75;
	73 [label="你覺得如果不是出於必要的話，是什麼原因驅使老德輔羅來看你呢？",shape=box,color=red];
		73 -> 76;
	74 [label="- 檢查一下牠的爪子有多鋒利。",shape=box,color=blue];
		74 -> 77;
	75 [label="兩年後，他的再度失蹤變成了永久失蹤。",shape=box,color=blue];
		75 -> 78;
		75 -> 79;
	76 [label="我可以給的諷刺答案會是：「貪婪」。既然可以大快朵頤一頓，為什麼不能吃兩頓？為什麼不能吃十頓？",shape=box,color=blue];
		76 -> 80;
		76 -> 81;
	77 [label="Chat ends.",color=orange];
	78 [label="你有為他祈禱嗎？",shape=box,color=red];
		78 -> 82;
	79 [label="我希望他離開這個世界時是感到舒服和被愛的。",shape=box,color=red];
		79 -> 83;
	80 [label="不帶諷刺的回答又會是什麼？",shape=box,color=red];
		80 -> 84;
	81 [label="如果他只是尋求情感上的慰藉的話，情況會否一樣？",shape=box,color=red];
		81 -> 85;
	82 [label="得知他去世的那天晚上，我為他點了一支蠟燭，並向太陰祈禱，希望她能引導他的靈魂去往……任何她會引導像他這樣的小精靈去的地方。",shape=box,color=blue];
		82 -> 86;
	83 [label="我能問為什麼嗎？",shape=box,color=blue];
		83 -> 87;
		83 -> 88;
	84 [label="+10 Chemistry",color=orange];
		84 -> 89;
	85 [label="對愛的貪婪渴望仍然是欲望，雖然它並非以肉食和美酒來滿足的飢渴。更別說牠是裝模作樣去尋求的？",shape=box,color=blue];
		85 -> 90;
		85 -> 91;
	86 [label="感謝老德輔羅帶給瑪麗的所有快樂，以換取那些美味的雞軟骨和摸頭服務。",shape=box,color=blue];
		86 -> 92;
	87 [label="牠是一隻動物。他只是在尋找滿足感 — 食物，住所，愛 — 他的動機跟人類截然不同。他並非在「撒謊」，他只是用不同的方式去捕獵。",shape=box,color=red];
		87 -> 93;
	88 [label="里昂，我見過太多暴力，當中有很多都是我造成的。我現在希望每個人，無論他們是什麼人，無論他們做過什麼，都能在愛他們的人的陪伴下安詳地離世。",shape=box,color=red];
		88 -> 94;
	89 [label="我發現自己竟然……內心對這隻貓有一份尊敬，因為牠在這個世界上找到了屬於自己的位置。",shape=box,color=blue];
		89 -> 95;
	90 [label="牠只是一隻貓，里昂。他當時都不知道自己在做什麼。",shape=box,color=red];
		90 -> 96;
	91 [label="我們還在討論一隻貓，是嗎？",shape=box,color=red];
		91 -> 97;
	92 [label="謝謝。我不打擾你了。",shape=box,color=blue];
		92 -> 98;
	93 [label="他並沒有剝奪其他人甚麼，反而讓你們都成了他的「傻瓜」。要說的話……你們似乎都從他的來訪中學到些東西。",shape=box,color=red];
		93 -> 99;
	94 [label="真有趣。我以為你會憎恨你的敵人。但這就是我的愚蠢之處 — 我竟然自以為知道當今時代人們會如何做人處事。",shape=box,color=blue];
		94 -> 100;
	95 [label="這是一個學會利用自身狀況 — 外表、年紀、傷疤 — 作為武器來對抗周圍那些看不穿他詭計的「傻瓜」的生物。",shape=box,color=blue];
		95 -> 101;
	96 [label="他很清楚怎樣裝跛。 ",shape=box,color=blue];
		96 -> 84;
	97 [label="漂泊者，隨你自由理解這段對話。",shape=box,color=blue];
		97 -> 84;
	98 [label="-里昂・阿拉德神父",shape=box,color=blue];
		98 -> 102;
	99 [label="Add -1 to Thermostat",color=orange];
		99 -> 103;
	100 [label="Add 1 to Thermostat",color=orange];
		100 -> 104;
	101 [label="他真是個亂糟糟毛茸茸的小淘氣。但每次他來造訪，我還是忍不住想摸摸牠。",shape=box,color=blue];
		101 -> 105;
	102 [label="Chat ends.",color=orange];
	103 [label="是的，我想我們確實是。而我們當時也不缺雞軟骨和搔癢服務。",shape=box,color=blue];
		103 -> 106;
	104 [label="更何況像你這樣有著特別精彩成長經驗的人。 ",shape=box,color=blue];
		104 -> 107;
	105 [label="兩年後，他的再度失蹤卻是永久性的，這同樣令人心碎。",shape=box,color=blue];
		105 -> 78;
		105 -> 79;
	106 [label="也許正因如此，我為他點了一支蠟燭，並向太陰祈禱，希望她能引導他的靈魂去往……任何她會引導像他這樣的小精靈去的地方。",shape=box,color=blue];
		106 -> 108;
	107 [label="+5 Chemistry",color=orange];
		107 -> 109;
	108 [label="+5 Chemistry",color=orange];
		108 -> 110;
	109 [label="謝謝。我不打擾你了。這次談話非常有趣。期待下次再聊。",shape=box,color=blue];
		109 -> 111;
	110 [label="那天晚上，我在禱告中感謝老德輔羅，感謝牠帶給瑪麗的所有快樂。",shape=box,color=blue];
		110 -> 112;
	111 [label="-里昂・阿拉德神父",shape=box,color=blue];
		111 -> 113;
	112 [label="或許牠那些小小的惡行，從某種意義上來說，也算是好事。",shape=box,color=blue];
		112 -> 109;
	113 [label="Chat ends.",color=orange];
}