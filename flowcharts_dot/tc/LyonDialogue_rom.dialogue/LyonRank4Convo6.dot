	j1358843329 [label="+20 Chemistry",color=orange];
		j1358843329 -> j163839883;
	j397312545 [label="里昂，我跟瑪麗聊到了你的……習慣，我在想我們能不能說一下話？",shape=box,color=red];
		j397312545 -> j1551094667;
	j3003987329 [label="[停用關於自殘的對話。執行此操作不會導致與里昂或任何其他角色的曖昧點數流失。]",shape=box,color=red];
		j3003987329 -> j847147474;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j2098630943 [label="里昂？我們可不可以聊一些可能讓你有點……不舒服的話題嗎？",shape=box,color=red];
		j2098630943 -> j151056912;
	j3033521900 [label="里昂，我想跟你說說你為什麼 ─ 嗯……傷害自己，可以嗎？",shape=box,color=red];
		j3033521900 -> j2378848724;
	j163839883 [label="[由於先前已設定情緒觸發警告，對話已跳過]",shape=box,color=blue];
		j163839883 -> "Chat ends.";
	j1551094667 [label="她告訴我你們已經聊過了——是的，當然。你或許會驚訝，但談論這個特徵對我來說根本沒什麼大不了的。",shape=box,color=blue];
		j1551094667 -> j2140314747;
	j847147474 [label="Boolean LyonPainOff is now true.",color=orange];
		j847147474 -> j1536143358;
	"Chat ends." [color=orange];
	j151056912 [label="你可以問，但如果我認為它涉及我不願討論的領域時，我保留終止對話的權利。",shape=box,color=blue];
		j151056912 -> j3793400722;
	j2378848724 [label="嗯。說實話，我很驚訝你過了這麼久才問起我的這個特質。通常來說，這恰恰是大多數人最容易注意到並加以評論的。",shape=box,color=blue];
		j2378848724 -> j4213502779;
	j2140314747 [label="通常情況下這正是大多數人最容易注意到並加以評論的事物。可能是出於擔憂、厭惡，或是出於病態的好奇心。",shape=box,color=blue];
		j2140314747 -> j897187574;
	j1536143358 [label="如果你覺得作出這個選擇是懦弱的表現，我懇求您——別這樣想。這份痛苦不是你該面對的，而是我。你並沒有被要求去承受這一切。",shape=box,color=blue];
		j1536143358 -> j1559590556;
	j3793400722 [label="關鍵在於你有時候會傷害自己。我只是想小心地跟你提起這個話題而已。",shape=box,color=red];
		j3793400722 -> j3932525033;
	j4213502779 [label="或許是出於擔憂、厭惡，或許是出於一種病態的好奇心──就像有人會透過欄杆偷看瘋子一樣。我想知道，你是哪一種？",shape=box,color=blue];
		j4213502779 -> j2717053108;
		j4213502779 -> j3112090673;
		j4213502779 -> j3637652287;
		j4213502779 -> j3434645858;
	j897187574 [label="Evaluate expressions",color=orange];
		j897187574 -> j2717053108 [label="LyonBackstory3a",color=purple];
		j897187574 -> j342556930 [label="LyonBackstory3a",color=purple];
		j897187574 -> j2717053108 [label="LyonBackstory3b",color=purple];
		j897187574 -> j342556930 [label="LyonBackstory3b",color=purple];
		j897187574 -> j2717053108 [label="DrifterHarmHelp",color=purple];
		j897187574 -> j3637652287 [label="DrifterHarmHelp",color=purple];
		j897187574 -> j2717053108 [label="DrifterHarmStop",color=purple];
		j897187574 -> j3434645858 [label="DrifterHarmStop",color=purple];
		j897187574 -> j2717053108 [label="DrifterHarmLoss",color=purple];
		j897187574 -> j3112090673 [label="DrifterHarmLoss",color=purple];
		j897187574 -> j2717053108 [label="false",color=purple];
	j1559590556 [label="我們面前這具機械裝置，營造出一種隱晦的疏離假象。它讓我們誤以為自己受到了庇護，彷彿無論對方透過它敲打出什麼樣的字句，都無法傷及我們分毫。",shape=box,color=blue];
		j1559590556 -> j261346594;
	j3932525033 [label="+5 Chemistry",color=orange];
		j3932525033 -> j3054985306;
	j2717053108 [label="抱歉 — 再想想，我做不到。 [結束]",shape=box,color=red];
		j2717053108 -> j1536143358;
	j3112090673 [label="[警告：涉及輕生話題] 我……曾因這種「習慣」而失去過一個人，所以我……",shape=box,color=red];
		j3112090673 -> j484466001;
	j3637652287 [label="我只是想幫你，確保你一切安好。就這樣而已。",shape=box,color=red];
		j3637652287 -> j4278740242;
	j3434645858 [label="我覺得這樣不健康 ─ 這種事應該要停止。 ",shape=box,color=red];
		j3434645858 -> j2043352089;
	j342556930 [label="我知道你說過在注射血清之前你常常傷害自己，但是……我無法想像這樣做會讓情況好轉。",shape=box,color=red];
		j342556930 -> j2702284559;
	j261346594 [label="我的看法恰恰相反——一旦卸下平日社交時用來武裝自己的盔甲，我們反倒被剝光了防禦，變得無遮無掩。",shape=box,color=blue];
		j261346594 -> j2143770275;
	j3054985306 [label="我……很感激你處理此事時那般小心翼翼的態度，漂泊者。謝謝。但我對這成為話題早已習以為常。無論是出於關切、厭惡，或是病態的好奇心——儘管我認為你已證明了你更傾向屬於前者。",shape=box,color=blue];
		j3054985306 -> j2717053108;
		j3054985306 -> j3112090673;
		j3054985306 -> j3637652287;
		j3054985306 -> j3434645858;
	j484466001 [label="Boolean DrifterHarmLoss is now true.",color=orange];
		j484466001 -> j3069725085;
	j4278740242 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j4278740242 -> j4131174356;
	j2043352089 [label="Boolean DrifterHarmStop is now true.",color=orange];
		j2043352089 -> j1919936800;
	j2702284559 [label="不，恐怕並沒有。它把原本是為了清除困擾我的幻象而必須做的事情，變成了為了運用這種血清的「恩賜」而必須去做的事情。",shape=box,color=blue];
		j2702284559 -> j597327593;
	j2143770275 [label="因此，在類似的情況下……我深知自己射出的箭或許未能擊中全副武裝的士兵，卻射穿了林中野鹿那毫無戒備的咽喉。",shape=box,color=blue];
		j2143770275 -> j3543343533;
	j3069725085 [label="噢，我的朋友……我無法用言語充分表達我對你所承受的一切的同情。",shape=box,color=blue];
		j3069725085 -> j16118087;
	j4131174356 [label="Check boolean LyonAllRight",color=orange];
		j4131174356 -> j3660878908 [label=true,color=green];
		j4131174356 -> j2093485227 [label=false,color=brown];
	j1919936800 [label="我想你晚了好幾年，也錯過了一劑原型 Warframe 的血清，你已經無法阻止我這種特殊的衝動了——事實上，恐怕現在這更像是一種必須採取的行動，不是嗎？",shape=box,color=blue];
		j1919936800 -> j2289566152;
	j597327593 [label="+5 Chemistry",color=orange];
		j597327593 -> j1047946340;
	j3543343533 [label="因此在最後，我想跟你說的是：",shape=box,color=blue];
		j3543343533 -> j1311795982;
	j16118087 [label="當這種時刻來臨之時，語言就會顯得蒼白無力。我們手忙腳亂地想用言語表達，但它們總是讓我們失望。",shape=box,color=blue];
		j16118087 -> j2157751053;
	j3660878908 [label="我再次努力克制自己，不讓自己因為想到自己終於接近「一切都好」這個概念而笑出來。但我非常感謝你的好意，漂泊者。",shape=box,color=blue];
		j3660878908 -> j833720367;
	j2093485227 [label="我努力克制自己，不讓自己因為想到自己有一天會接近「一切都好」這個概念而笑出來。但我非常感謝你的好意，漂泊者。",shape=box,color=blue];
		j2093485227 -> j833720367;
	j2289566152 [label="+5 Chemistry",color=orange];
		j2289566152 -> j822369429;
	j1047946340 [label="如果是在注射血清之前，我還有辦法控制這種或會傷害自己的衝動，但如今我與「Harrow」 Warframe 結合之後，這已經變得完全不可能了。",shape=box,color=blue];
		j1047946340 -> j630653587;
	j1311795982 [label="即使我們自己沒有勇氣站起來，我們也必須提醒自己，要找到力量去幫助別人站起來。",shape=box,color=blue];
		j1311795982 -> j1256072967;
	j2157751053 [label="鑑於你的坦白，如果你不介意的話，我可以做三件事。",shape=box,color=blue];
		j2157751053 -> j3162723753;
	j833720367 [label="+5 Chemistry",color=orange];
		j833720367 -> j2983096234;
		j833720367 -> j2450149798;
	j822369429 [label="但我不是故意要對你關心我身心狀況的好意這麼輕浮，原諒我。我只是單純認為我沒有能力停止。",shape=box,color=blue];
		j822369429 -> j2983096234;
		j822369429 -> j2450149798;
	j630653587 [label="恕我直言，漂泊者，我認為我再也無法以這種方式對自己造成任何真正的永久性傷害了。",shape=box,color=blue];
		j630653587 -> j26817901;
	j1256072967 [label="這才是故事的真正目的。",shape=box,color=blue];
		j1256072967 -> j1300668991;
	j3162723753 [label="首先；我必須立刻向你保證，我並無危險。如果您認為是某種深沉且可怕的自我厭惡驅使我傷害自己，我很樂意讓你放下這些擔憂。",shape=box,color=blue];
		j3162723753 -> j4202167937;
	j2983096234 [label="我可不可以問你為什麼要這樣做？",shape=box,color=red];
		j2983096234 -> j3106172300;
	j2450149798 [label="我只是擔心你會做得太過火。",shape=box,color=red];
		j2450149798 -> j630653587;
	j26817901 [label="儘管我不會傲慢得認為自己擁有那種刀槍不入的能力，但這種行為似乎……容我們說……乃設計的一環。",shape=box,color=blue];
		j26817901 -> j281193199;
	j1300668991 [label="+20 Chemistry",color=orange];
		j1300668991 -> j1388921545;
	j4202167937 [label="雖然我……了解那種深沉的憂鬱，但那並不能激發我使用香爐。（首先，瑪麗也絕對不會允許我這麼做。她寧願把這種憂鬱餵給我，也絕不會讓我再靠近香爐。）",shape=box,color=blue];
		j4202167937 -> j1795481300;
	j3106172300 [label="Evaluate expressions",color=orange];
		j3106172300 -> j1128442721 [label="LyonBackstory3a & LyonLecture2",color=purple];
		j3106172300 -> j1128442721 [label="LyonBackstory3b & LyonLecture2",color=purple];
		j3106172300 -> j2416943694 [label="LyonBackstory3a",color=purple];
		j3106172300 -> j2416943694 [label="LyonBackstory3b",color=purple];
		j3106172300 -> j2724461974 [label="false",color=purple];
	j281193199 [label="+5 Chemistry",color=orange];
		j281193199 -> j2931820141;
	j1388921545 [label="保重，漂泊者。我們很快會再聯絡。",shape=box,color=blue];
		j1388921545 -> j3650812828;
	j1795481300 [label="但朋友，我從未在夜裡聽過如此深切的痛苦低語。我可以向你發誓，我以我所珍惜的一切向你保證。",shape=box,color=blue];
		j1795481300 -> j3517230700;
	j1128442721 [label="我已向您吐露驅使我行動的真相——痛苦能讓我擺脫困擾我的幻象。且此習俗在太陰兄弟會中並不像在你的文化中那般令人羞恥。我可以賭上我所珍視的一切起誓，我並無隱瞞任何秘密。",shape=box,color=blue];
		j1128442721 -> j384773517;
	j2416943694 [label="那是一個複雜的話題，因我撕裂自身血肉背後的緣由並非單一。我曾告訴你關於糾纏我的幻象，以及痛楚如何讓我頭腦清醒。但此行為本身並不如你所想的那般禁忌。",shape=box,color=blue];
		j2416943694 -> j2635769086;
	j2724461974 [label="那是一個複雜的話題，因我撕裂自身血肉背後的緣由並非單一。我必須先言明，此事在你現今所處的時代看來或被視為禁忌，但在當時並非如此。",shape=box,color=blue];
		j2724461974 -> j2635769086;
	j2931820141 [label="我不認為我做的事情是「正確的」。我不認為別人應該效法我所做的事情。我不認為我做的事情值得別人羨慕。",shape=box,color=blue];
		j2931820141 -> j741486120;
	j3650812828 [label="-里昂・阿拉德神父",shape=box,color=blue];
		j3650812828 -> j3787621160;
	j3517230700 [label="其次；我必須稱許你將這些話語傳遞予我的勇氣。迴避它們很容易。但你沒有。",shape=box,color=blue];
		j3517230700 -> j133948631;
	j384773517 [label="如果您認為是某種深沉且可怕的自我厭惡驅使我傷害自己，我很樂意讓你放下這些擔憂。",shape=box,color=blue];
		j384773517 -> j528126791;
	j2635769086 [label="在太陰兄弟會中，有一種古老的鞭笞習俗。那很罕見，就算在我的年代也會被視為古老的習俗，只有那些被「蒙受她賜予幻象」的人才會使用。",shape=box,color=blue];
		j2635769086 -> j994671321;
	j741486120 [label="然而，處於我這極其獨特且在字面意義上可以說明「超自然」的狀態時，它對我來說也並非絕對危險。",shape=box,color=blue];
		j741486120 -> j2747182321;
	j3787621160 [label="Boolean LyonSpeech is now true.",color=orange];
		j3787621160 -> "Chat ends.";
	j133948631 [label="第三，我無法也永遠無法理解你同伴所遭受的苦難。某種程度上，除了他們自己，恐怕沒有人能夠真正理解。",shape=box,color=blue];
		j133948631 -> j16140492;
	j528126791 [label="雖然我……了解那種深沉的憂鬱，但那並不能激發我使用香爐。（首先，瑪麗也絕對不會允許我這麼做。）",shape=box,color=blue];
		j528126791 -> j1956864042;
	j994671321 [label="就在我抵達不久後，大教堂中的一位神父就傳授了這種方法。當他看見我同樣被……「賜福」時，他覺得應該幫助我。",shape=box,color=blue];
		j994671321 -> j2632916461;
	j2747182321 [label="的確，我常常想，現代科學是否有某種奇蹟可以幫助我擺脫病痛。如果我的身體狀況允許，我一定會接受這樣的幫助。但我現在懷疑我的生理機能是否允許。",shape=box,color=blue];
		j2747182321 -> j3475692122;
	j16140492 [label="如此令人身心俱疲的痛苦，本質上來說，是一種孤獨的體驗。",shape=box,color=blue];
		j16140492 -> j985773857;
	j1956864042 [label="Boolean LyonSNo is now true.",color=orange];
		j1956864042 -> j2600709128;
		j1956864042 -> j995681839;
		j1956864042 -> j2817814272;
	j2632916461 [label="Boolean LyonLecture2 is now true.",color=orange];
		j2632916461 -> j2817814272;
		j2632916461 -> j995681839;
		j2632916461 -> j2600709128;
	j3475692122 [label="無論如何，我向你保證──我不會因此喪命。這是我從小背負的重擔。而且，我認為這種症狀總比不去揭開結痂而傷口潰爛化膿要好。",shape=box,color=blue];
		j3475692122 -> j1511931022;
	j985773857 [label="我僅向我的神、你的神，以及眾神祈禱，祈願你心中不存愧疚。因為如果這世間或來世有什麼值得被寬恕的，那便是知曉某人曾受如此苦難的那份仁慈。",shape=box,color=blue];
		j985773857 -> j399574868;
	j2600709128 [label="你確定你永遠不會……做得太過分嗎？",shape=box,color=red];
		j2600709128 -> j630653587;
	j995681839 [label="宗教習俗有時真是奇怪，這讓我感到驚訝。",shape=box,color=red];
		j995681839 -> j1884722426;
	j2817814272 [label="這讓我感覺好多了。",shape=box,color=red];
		j2817814272 -> j630653587;
	j1511931022 [label="Check boolean LyonSNo",color=orange];
		j1511931022 -> j893502030 [label=true,color=green];
		j1511931022 -> j1394501624 [label=false,color=brown];
	j399574868 [label="+15 Chemistry",color=orange];
		j399574868 -> j425756632;
	j1884722426 [label="我對此並無異議。我對不同宗教儀式的差異非常著迷，也十分樂於研究所有相關的文獻資料。",shape=box,color=blue];
		j1884722426 -> j3122269635;
	j893502030 [label="+10 Chemistry",color=orange];
		j893502030 -> j4003059130;
	j1394501624 [label="如果您認為是某種深沉且可怕的自我厭惡驅使我傷害自己，我很樂意讓你放下這些擔憂。",shape=box,color=blue];
		j1394501624 -> j203702505;
	j425756632 [label="保重，漂泊者。我們很快會再聯絡。",shape=box,color=blue];
		j425756632 -> j2331496732;
	j3122269635 [label="宗教人類學對我而言是一門深感親切且珍視的學科。透過研習其儀式，人們能從一個社會與民族中獲益良多。",shape=box,color=blue];
		j3122269635 -> j1972178955;
	j4003059130 [label="不過，這點我可以答應你——如果哪天我真的害怕到無法再信任我自己，我會說出口的。",shape=box,color=blue];
		j4003059130 -> j2691815323;
	j203702505 [label="雖然我……了解那種深沉的憂鬱，但那並不能激發我使用香爐。（首先，瑪麗也絕對不會允許我這麼做。）",shape=box,color=blue];
		j203702505 -> j893502030;
	j2331496732 [label="-里昂・阿拉德神父",shape=box,color=blue];
		j2331496732 -> "Chat ends.";
	j1972178955 [label="在極北凍土存在一個聖光會教派，他們崇拜著一具從消退冰川中挖掘出來的屍體。屍體保存完好，無人知曉其確切的年代。但其頸項所佩戴之黃銅圓盤上，印有太陽的圖案。",shape=box,color=blue];
		j1972178955 -> j2291868214;
	j2691815323 [label="對瑪麗，對你，對 Loid 先生，甚至對羅瑟來說，這一切都不重要。我會說出來。我對此發誓。",shape=box,color=blue];
		j2691815323 -> j4251147190;
		j2691815323 -> j3558268214;
	j2291868214 [label="他們相信那具木乃伊就是太陽的遺體。還相信有一天他會死而復生。每一百年，他們就會準備「大前夜」，很多信徒會在前一晚喝下毒酒。",shape=box,color=blue];
		j2291868214 -> j4171531555;
	j4251147190 [label="你能這麼說我就放心了。謝謝，里昂。",shape=box,color=red];
		j4251147190 -> j2245922156;
	j3558268214 [label="我相信你。我只是想和你一起經歷這個過程。",shape=box,color=red];
		j3558268214 -> j2245922156;
	j4171531555 [label="不用說也知道，等到早上那具木乃伊沒醒來的時候，他們總是有完美的理由解釋算錯了，然後把日期再往後推個一百年左右。",shape=box,color=blue];
		j4171531555 -> j981404936;
	j2245922156 [label="我很感激你渴望確認我不是出於某種不受控的自毀衝動而行事。",shape=box,color=blue];
		j2245922156 -> j1263426969;
	j981404936 [label="但我似乎已經偏離話題太遠了。",shape=box,color=blue];
		j981404936 -> j281193199;
	j1263426969 [label="我不習慣我的生活中會有這樣的朋友。",shape=box,color=blue];
		j1263426969 -> j425756632;
}