	j1358843329 [label="+20 Chemistry",color=orange];
		j1358843329 -> j163839883;
	j2620003888 [label="里昂，我跟瑪麗聊到了你的……習慣，我在想我們能不能說一下話？",shape=box,color=red];
		j2620003888 -> j668400250;
	j925580454 [label="[Disable conversations about self-harm. No loss of chemistry with Lyon or any other character will be incurred by doing so.]",shape=box,color=red];
		j925580454 -> j2321583126;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j3019251801 [label="里昂？我們可不可以聊一些可能讓你有點……不舒服的話題嗎？",shape=box,color=red];
		j3019251801 -> j3439805669;
	j1312077544 [label="里昂，我想跟你說說你為什麼 ─ 嗯……傷害自己，可以嗎？",shape=box,color=red];
		j1312077544 -> j2906557505;
	j163839883 [label="[由於先前已設定情緒觸發警告，對話已跳過]",shape=box,color=blue];
		j163839883 -> "Chat ends.";
	j668400250 [label="She alerted me that you two had spoken - yes, of course. You might be surprised at how little it troubles me to speak of this particular trait of mine.",shape=box,color=blue];
		j668400250 -> j3259213509;
	j2321583126 [label="Boolean LyonPainOff is now true.",color=orange];
		j2321583126 -> j216217535;
	"Chat ends." [color=orange];
	j3439805669 [label="You may ask, though I reserve the right to go no farther in the conversation if I feel it treads into an area of discussion I am no longer willing to partake in. ",shape=box,color=blue];
		j3439805669 -> j2398921518;
	j2906557505 [label="Mm. I am honestly surprised it took this long for you to enquire about this particular trait of mine. It is usually that which most find cause to remark upon most readily.",shape=box,color=blue];
		j2906557505 -> j386238142;
	j3259213509 [label="It is usually that which most find cause to remark upon most readily. Either for reasons of concern, disgust, or the morbid curiosity.",shape=box,color=blue];
		j3259213509 -> j897187574;
	j216217535 [label="If you were to consider yourself a coward for this choice, I beseech you - do not. For this is a pain that is not yours to face. It is mine. You did not ask to bear this moment.",shape=box,color=blue];
		j216217535 -> j2813148884;
	j2398921518 [label="關鍵在於你有時候會傷害自己。我只是想小心地跟你提起這個話題而已。",shape=box,color=red];
		j2398921518 -> j3964869114;
	j386238142 [label="Either for reasons of concern, disgust, or the morbid curiosity that might drive someone to peer through the bars of a lunatic's cage. I wonder, which are you?",shape=box,color=blue];
		j386238142 -> j2757888932;
		j386238142 -> j1396768253;
		j386238142 -> j3637652287;
		j386238142 -> j3608500136;
	j897187574 [label="Evaluate expressions",color=orange];
		j897187574 -> j2757888932 [label="LyonBackstory3a",color=purple];
		j897187574 -> j691979575 [label="LyonBackstory3a",color=purple];
		j897187574 -> j2757888932 [label="LyonBackstory3b",color=purple];
		j897187574 -> j691979575 [label="LyonBackstory3b",color=purple];
		j897187574 -> j2757888932 [label="DrifterHarmHelp",color=purple];
		j897187574 -> j3637652287 [label="DrifterHarmHelp",color=purple];
		j897187574 -> j2757888932 [label="DrifterHarmStop",color=purple];
		j897187574 -> j3608500136 [label="DrifterHarmStop",color=purple];
		j897187574 -> j2757888932 [label="DrifterHarmLoss",color=purple];
		j897187574 -> j1396768253 [label="DrifterHarmLoss",color=purple];
		j897187574 -> j2757888932 [label="false",color=purple];
	j2813148884 [label="This mechanical contraption at which we sit creates an impression of veiled impersonality. That we are somehow sheltered from whatever harm another might cause us through whatever words they type to us upon it.",shape=box,color=blue];
		j2813148884 -> j3957747812;
	j3964869114 [label="+5 Chemistry",color=orange];
		j3964869114 -> j1130820835;
	j2757888932 [label="抱歉 — 再想想，我做不到。 [結束]",shape=box,color=red];
		j2757888932 -> j216217535;
	j1396768253 [label="[Warning: Discussion of suicide.] I... lost someone to this kind of \"habit\" once and I...",shape=box,color=red];
		j1396768253 -> j736429819;
	j3637652287 [label="我只是想幫你，確保你一切安好。就這樣而已。",shape=box,color=red];
		j3637652287 -> j4278740242;
	j3608500136 [label="我覺得這樣不健康 ─ 這種事應該要停止。 ",shape=box,color=red];
		j3608500136 -> j2322491070;
	j691979575 [label="我知道你說過在注射血清之前你常常傷害自己，但是……我無法想像這樣做會讓情況好轉。",shape=box,color=red];
		j691979575 -> j2356034474;
	j3957747812 [label="I would argue instead the opposite - that free of the armor we don in our more mundane social interactions, we are stripped of that which might protect us.",shape=box,color=blue];
		j3957747812 -> j1218899052;
	j1130820835 [label="I... appreciate the delicate nature in which you are treating this, Drifter. Thank you. But I am quite used to this being a topic of discussion. Either for reasons of concern, disgust, or morbid curiosity - though I think you have already proven it to be the former.",shape=box,color=blue];
		j1130820835 -> j2757888932;
		j1130820835 -> j1396768253;
		j1130820835 -> j3637652287;
		j1130820835 -> j3608500136;
	j736429819 [label="Boolean DrifterHarmLoss is now true.",color=orange];
		j736429819 -> j364920886;
	j4278740242 [label="Boolean DrifterHarmHelp is now true.",color=orange];
		j4278740242 -> j4131174356;
	j2322491070 [label="Boolean DrifterHarmStop is now true.",color=orange];
		j2322491070 -> j249870306;
	j2356034474 [label="No, I fear it has not. It has taken something that was... a requirement to clear my mind of the visions that plagued me, and turned it into a requirement to wield the \"gifts\" of this serum.",shape=box,color=blue];
		j2356034474 -> j1055340182;
	j1218899052 [label="Therefore, in situations like these... I am well aware that I let loose an arrow that might find not the battle-ready soldier, but the unsuspecting jugular of a deer in the woods.",shape=box,color=blue];
		j1218899052 -> j692617605;
	j364920886 [label="噢，我的朋友……我無法用言語充分表達我對你所承受的一切的同情。",shape=box,color=blue];
		j364920886 -> j751142610;
	j4131174356 [label="Check boolean LyonAllRight",color=orange];
		j4131174356 -> j986201914 [label=true,color=green];
		j4131174356 -> j4249972755 [label=false,color=brown];
	j249870306 [label="I believe you are several years and one protoframe serum too late to put an end to this particular compulsion of mine - indeed, I fear it is now more of a required action, is it not?",shape=box,color=blue];
		j249870306 -> j1810356245;
	j1055340182 [label="+5 Chemistry",color=orange];
		j1055340182 -> j2909782191;
	j692617605 [label="So I shall, therefore, leave you with this:",shape=box,color=blue];
		j692617605 -> j2893088492;
	j751142610 [label="Language seems paltry when moments like these come to pass. We scramble to wield them as best we can, yet they always seem to fail us.",shape=box,color=blue];
		j751142610 -> j1162239299;
	j986201914 [label="I once more am attempting not to chuckle at the notion of my ever approaching the concept of \"all right.\" But I very much appreciate the sentiment, Drifter.",shape=box,color=blue];
		j986201914 -> j833720367;
	j4249972755 [label="I am attempting not to chuckle at the notion of my ever approaching the concept of \"all right.\" But I very much appreciate the sentiment, Drifter.",shape=box,color=blue];
		j4249972755 -> j833720367;
	j1810356245 [label="+5 Chemistry",color=orange];
		j1810356245 -> j4112952551;
	j2909782191 [label="If the ability to cure my compulsion to harm myself were within my grasp prior to injecting the serum, I believe joining with the \"Harrow\" Warframe has made it quite impossible now.",shape=box,color=blue];
		j2909782191 -> j3723888763;
	j2893088492 [label="We must remind ourselves how to find the strength to pull another to their feet, even when we cannot find the will to stand.",shape=box,color=blue];
		j2893088492 -> j1114038044;
	j1162239299 [label="There are three things I might do, if you would indulge me, in light of your confession.",shape=box,color=blue];
		j1162239299 -> j3757849316;
	j833720367 [label="+5 Chemistry",color=orange];
		j833720367 -> j2983096234;
		j833720367 -> j711871291;
	j4112952551 [label="But I do not mean to be so flippant over what I believe is an expression of concern over my physical and mental well-being, forgive me. I simply do not think it is within my ability to cease.",shape=box,color=blue];
		j4112952551 -> j2983096234;
		j4112952551 -> j711871291;
	j3723888763 [label="If I might be quite crass, Drifter, I do not think I am capable of causing myself any real permanent harm in such a fashion any longer.",shape=box,color=blue];
		j3723888763 -> j2931507029;
	j1114038044 [label="That is the true purpose of story.",shape=box,color=blue];
		j1114038044 -> j2785806157;
	j3757849316 [label="First; is that I am quick to assure you that I am in no danger. If you believe there is some deep and terrible self-loathing that drives my desire to harm myself, I would be quite eager to put those fears to rest.",shape=box,color=blue];
		j3757849316 -> j857718823;
	j2983096234 [label="我可不可以問你為什麼要這樣做？",shape=box,color=red];
		j2983096234 -> j3106172300;
	j711871291 [label="I'm just worried you're going to go too far.",shape=box,color=red];
		j711871291 -> j3723888763;
	j2931507029 [label="While I am not capable of the hubris required to think myself impervious, such an act seems... shall we say... part of the design.",shape=box,color=blue];
		j2931507029 -> j4209829057;
	j2785806157 [label="+20 Chemistry",color=orange];
		j2785806157 -> j4155538500;
	j857718823 [label="While I... know that great melancholy, it does not inspire my thurible. (Marie would never allow it, for one. She is liable to feed it to me before she would let me near one ever again.)",shape=box,color=blue];
		j857718823 -> j709865348;
	j3106172300 [label="Evaluate expressions",color=orange];
		j3106172300 -> j1487070556 [label="LyonBackstory3a, LyonLecture2",color=purple];
		j3106172300 -> j1487070556 [label="LyonBackstory3b, LyonLecture2",color=purple];
		j3106172300 -> j3189595222 [label="LyonBackstory3a",color=purple];
		j3106172300 -> j3189595222 [label="LyonBackstory3b",color=purple];
		j3106172300 -> j1568797432 [label="false",color=purple];
	j4209829057 [label="+5 Chemistry",color=orange];
		j4209829057 -> j190981148;
	j4155538500 [label="保重，漂泊者。我們很快會再聯絡。",shape=box,color=blue];
		j4155538500 -> j3561129701;
	j709865348 [label="But such deep pains have never whispered to me in the night, my friend. This, I can vow to you. This, I pledge to you, on all that I hold dear.",shape=box,color=blue];
		j709865348 -> j3884778164;
	j1487070556 [label="I have spoken you the truth of what inspires me to act - the pain clears my mind of the visions that plague me. And the practice is not so shamed amongst the Brothers of Lua as it might be in your culture. I can vow upon all I hold dear there is no hidden secret I am withholding.",shape=box,color=blue];
		j1487070556 -> j2141972704;
	j3189595222 [label="That is a complicated topic, as the reasons behind my rending my own flesh are not singular. I have told you of the visions that plague me, and that the pain clears my mind. But the act itself is not so taboo as you might believe.",shape=box,color=blue];
		j3189595222 -> j1818589572;
	j1568797432 [label="That is a complicated topic, as the reasons behind my rending my own flesh are not singular. I must start by saying that the matter is not nearly as taboo as it may seem to you in this day and age.",shape=box,color=blue];
		j1568797432 -> j1818589572;
	j190981148 [label="I do not think what I do is \"right.\" I do not think what I do should be practiced by others. I do not think what I do is enviable.",shape=box,color=blue];
		j190981148 -> j4017653653;
	j3561129701 [label="-F. Lyon Allard",shape=box,color=blue];
		j3561129701 -> j3787621160;
	j3884778164 [label="Second; I must commend you on your bravery to send these words to me. It would have been easier to avoid them. You did not.",shape=box,color=blue];
		j3884778164 -> j1105112715;
	j2141972704 [label="If you believe there is some deep and terrible self-loathing that drives my desire to harm myself, I would be quite eager to put those fears to rest.",shape=box,color=blue];
		j2141972704 -> j1796130715;
	j1818589572 [label="Amongst the Brothers of Lua, there is an ancient practice of flagellation. It is rare, and even in my day it was seen as archaic and used by those who were \"blessed by her visions.\"",shape=box,color=blue];
		j1818589572 -> j3453828234;
	j4017653653 [label="However it is not - in my incredibly unique and rather \"supernatural\" in the most literal sense of the word, state - strictly dangerous for me, either.",shape=box,color=blue];
		j4017653653 -> j3721717014;
	j3787621160 [label="Boolean LyonSpeech is now true.",color=orange];
		j3787621160 -> "Chat ends.";
	j1105112715 [label="Third; I do not, nor shall I never comprehend the context of what your companion suffered. And, in a way, no one but they themselves ever shall.",shape=box,color=blue];
		j1105112715 -> j925613773;
	j1796130715 [label="While I... know that great melancholy, it does not inspire my thurible. Marie would never allow it, for one.",shape=box,color=blue];
		j1796130715 -> j1956864042;
	j3453828234 [label="One of the Fathers at the Cathedral taught it to me, not long after I arrived, when he saw that I was similarly... \"blessed,\" and saw fit to aid me. ",shape=box,color=blue];
		j3453828234 -> j2632916461;
	j3721717014 [label="Indeed, I have often wondered if there were not some modern miracle of science that could aid me with my afflictions. Would that I be in such a condition to accept any such help, I would take it. I doubt my physiology would allow for it, now.",shape=box,color=blue];
		j3721717014 -> j991224351;
	j925613773 [label="To suffer in such a way that is so all-consuming is, by its definition, a solitary thing.",shape=box,color=blue];
		j925613773 -> j3312690684;
	j1956864042 [label="Boolean LyonSNo is now true.",color=orange];
		j1956864042 -> j1943141243;
		j1956864042 -> j3207511862;
		j1956864042 -> j2807808070;
	j2632916461 [label="Boolean LyonLecture2 is now true.",color=orange];
		j2632916461 -> j2807808070;
		j2632916461 -> j3207511862;
		j2632916461 -> j1943141243;
	j991224351 [label="Regardless, I assure you - I will not die of this. It is an burden I have carried with me since I was a child. And it is a symptom I have decided is better than the underlying festering wound, should I leave the scab un-picked.",shape=box,color=blue];
		j991224351 -> j1511931022;
	j3312690684 [label="I simply pray to my god, and yours, and theirs, that you do not hold guilt in your heart. For if anything in this world or any other is to be forgiven, it is the kindness of knowing someone who has suffered so.",shape=box,color=blue];
		j3312690684 -> j3408284233;
	j1943141243 [label="And you're certain you're never going to... take it too far?",shape=box,color=red];
		j1943141243 -> j3723888763;
	j3207511862 [label="I'm struck by how odd religious practices can be, sometimes.",shape=box,color=red];
		j3207511862 -> j2381189953;
	j2807808070 [label="That makes me feel a little better, I suppose.",shape=box,color=red];
		j2807808070 -> j3723888763;
	j1511931022 [label="Check boolean LyonSNo",color=orange];
		j1511931022 -> j1537961798 [label=true,color=green];
		j1511931022 -> j4104388867 [label=false,color=brown];
	j3408284233 [label="+15 Chemistry",color=orange];
		j3408284233 -> j715798298;
	j2381189953 [label="I will not find cause to argue with you there. I am fascinated by the differences in religious ceremonies. I deeply enjoy studying all documentation of them.",shape=box,color=blue];
		j2381189953 -> j3932107997;
	j1537961798 [label="+10 Chemistry",color=orange];
		j1537961798 -> j3864570730;
	j4104388867 [label="If you believe there is some deep and terrible self-loathing that drives my desire to harm myself, I would be quite eager to put those fears to rest.",shape=box,color=blue];
		j4104388867 -> j3896744905;
	j715798298 [label="保重，漂泊者。我們很快會再聯絡。",shape=box,color=blue];
		j715798298 -> j944546954;
	j3932107997 [label="Religious anthropology is a subject near and dear to me. There is much you can learn from a society and a people by studying their rituals. ",shape=box,color=blue];
		j3932107997 -> j3916992756;
	j3864570730 [label="I will promise you this, however - should I ever truly fear that it comes to a moment that I can no longer trust myself, I will speak the words.",shape=box,color=blue];
		j3864570730 -> j2691815323;
	j3896744905 [label="While I... know that great melancholy, it does not inspire my thurible. Marie would never allow it, for one.",shape=box,color=blue];
		j3896744905 -> j1537961798;
	j944546954 [label="-F. Lyon Allard",shape=box,color=blue];
		j944546954 -> "Chat ends.";
	j3916992756 [label="在極北凍土存在一個聖光會教派，他們崇拜著一具從消退冰川中挖掘出來的屍體。屍體保存完好，無人知曉其確切的年代。但其頸項所佩戴之黃銅圓盤上，印有太陽的圖案。",shape=box,color=blue];
		j3916992756 -> j923136594;
	j2691815323 [label="對瑪麗，對你，對 Loid 先生，甚至對羅瑟來說，這一切都不重要。我會說出來。我對此發誓。",shape=box,color=blue];
		j2691815323 -> j3735821385;
		j2691815323 -> j4082095730;
	j923136594 [label="They believe the mummified body to be that of Sol himself. And they believe that someday he will return to life and rise again. Every hundred years, they prepare for \"The Great Eve\" and many of their followers drink poisoned wine the night before.",shape=box,color=blue];
		j923136594 -> j2520148068;
	j3735821385 [label="That's the most I could ask for. Thank you, Lyon.",shape=box,color=red];
		j3735821385 -> j1434917054;
	j4082095730 [label="I trust you. I just wanted to walk through it with you.",shape=box,color=red];
		j4082095730 -> j1434917054;
	j2520148068 [label="Needless to say, when their mummified body has failed to return come the morning, they have a perfectly good reason as to why their calculations had been wrong, and the date is shifted another century or so.",shape=box,color=blue];
		j2520148068 -> j1606079713;
	j1434917054 [label="And I deeply appreciate your desire to know that I am not acting out of some unfettered drive to destroy myself.",shape=box,color=blue];
		j1434917054 -> j600066743;
	j1606079713 [label="但我似乎已經偏離話題太遠了。",shape=box,color=blue];
		j1606079713 -> j4209829057;
	j600066743 [label="我不習慣我的生活中會有這樣的朋友。",shape=box,color=blue];
		j600066743 -> j715798298;
}