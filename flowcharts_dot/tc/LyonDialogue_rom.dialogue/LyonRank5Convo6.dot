	j4183305561 [label="+20 Chemistry",color=orange];
		j4183305561 -> j1623626568;
	j727572435 [label="嗯。也許吧。但我們不是棋子，我拒絕被這樣對待。如果源拓氏想提出這樣的請求，他可以寄一封該死的信。",shape=box,color=blue];
		j727572435 -> j146468333;
	j3537225709 [label="那個該死的混蛋可以幫到我們，儘管我非常希望我能找到一個方法把他的嘴封住。",shape=box,color=blue];
		j3537225709 -> j3941867773;
	j1241296981 [label="對……",shape=box,color=red];
