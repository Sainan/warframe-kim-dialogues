		j1856148133 -> j3821080486;
	j674337766 [label="雖然我討厭承認，但瑪麗和我還在笨手笨腳地試圖弄清楚如何使用這棟建築裡一半的設備，而他卻能輕鬆駕馭它。",shape=box,color=blue];
