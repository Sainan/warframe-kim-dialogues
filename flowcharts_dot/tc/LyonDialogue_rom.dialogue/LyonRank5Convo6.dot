		j3203510524 -> "Chat ends." [label="false",color=purple];
	j174552642 [label="漂泊者。我可以提出一個請求嗎？",shape=box,color=blue];
		j174552642 -> j788898499;
		j174552642 -> j1350559949;
	j1040556802 [label="我能花一點時間稱讚你做了一件我認為迄今為止不可能做到的事嗎？",shape=box,color=blue];
		j1040556802 -> j1227388270;
		j1040556802 -> j3752239756;
		j1040556802 -> j1350559949;
	j1838306441 [label="我必須為你在瑪麗和主教的事情上高尚卻悲劇性地短命的努力向你致以哀悼。",shape=box,color=blue];
		j1838306441 -> j3752239756;
		j1838306441 -> j1227388270;
		j1838306441 -> j1350559949;
	j3178743995 [label="我很抱歉你和瑪麗在「主教」的事情上沒有達成共識。但我至少很高興這沒有發展到大打出手。",shape=box,color=blue];
		j3178743995 -> j3752239756;
		j3178743995 -> j1227388270;
		j3178743995 -> j1350559949;
	"Chat ends." [color=orange];
	j788898499 [label="是什麼？",shape=box,color=red];
		j788898499 -> j3238830650;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j1227388270 [label="我對我說的一些話並不完全感到自豪，但是……",shape=box,color=red];
		j1227388270 -> j2074264425;
	j3752239756 [label="她把一切都告訴你了，對嗎？",shape=box,color=red];
		j3752239756 -> j1968712620;
	j3238830650 [label="請說服瑪麗停止使用亡骸微靈複製家具。我不知道該怎麼處理所有這些椅子。",shape=box,color=blue];
		j3238830650 -> j515993699;
	j2074264425 [label="畢竟，「激情犯罪」這個詞的發明是有原因的。如果我們作為生物不堅持我們的信念，我想生活會變得非常無聊。",shape=box,color=blue];
		j2074264425 -> j899296987;
	j1968712620 [label="她說了。我們每晚都會談論當天發生的事。在你們的對話之後，她很快就跑到我身邊告訴我她對此的所有想法。",shape=box,color=blue];
		j1968712620 -> j166320584;
		j1968712620 -> j1996607687;
	j515993699 [label="+20 Chemistry",color=orange];
		j515993699 -> j1364899837;
	j899296987 [label="當然更安靜。更和平。但無聊。肯定不會有什麼藝術可言。",shape=box,color=blue];
		j899296987 -> j3239373804;
	j166320584 [label="她告訴了你什麼？",shape=box,color=red];
		j166320584 -> j3495933037;
	j1996607687 [label="……然後呢？",shape=box,color=red];
		j1996607687 -> j3495933037;
	j1364899837 [label="而且我拒絕接受她……關於它們應該存放在羅瑟體內哪個部位的精彩建議。",shape=box,color=blue];
		j1364899837 -> "Chat ends.";
	j3239373804 [label="但我離題了。我想知道，在我與她的對話中，聽起來你的話很感人。我必須問，你對你們之間的事情的處理方式還滿意嗎？",shape=box,color=blue];
		j3239373804 -> j1424199455;
	j3495933037 [label="Check boolean LyonDating",color=orange];
		j3495933037 -> j1935803068 [label=true,color=green];
		j3495933037 -> j4291813909 [label=false,color=brown];
	j1424199455 [label="Evaluate expressions",color=orange];
		j1424199455 -> j3544814444 [label="MarieDating, MarieFamilyFail",color=purple];
		j1424199455 -> j3206110913 [label="MarieDating, MarieFamilyFail",color=purple];
		j1424199455 -> j1905255472 [label="MarieFamilyFail",color=purple];
		j1424199455 -> j3989791641 [label="MarieFamilyFail",color=purple];
		j1424199455 -> j3544814444 [label="MarieFamilySuccess",color=purple];
		j1424199455 -> j3393072283 [label="MarieEntratiCompleteA",color=purple];
		j1424199455 -> j3740045489 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j3422013352 [label="MarieEntratiCompleteB",color=purple];
		j1424199455 -> j1798674169 [label="MarieEntratiCompleteC",color=purple];
		j1424199455 -> j2455341847 [label="false",color=purple];
	j1935803068 [label="哈！我怎麼會向你出賣她的信任。儘管你對我來說很珍貴，我的奇蹟，她已經是我的靈魂姊妹很多很多年了。",shape=box,color=blue];
		j1935803068 -> j1257283965;
	j4291813909 [label="哈！我怎麼會向你出賣她的信任。儘管你對我來說很珍貴，我的朋友，她已經是我的靈魂姊妹很多很多年了。",shape=box,color=blue];
		j4291813909 -> j1257283965;
	j3544814444 [label="我滿意。我想我得到了她在修補 Loid 和樓上家族之間關係的幫助。而那……很重大，里昂。我無法解釋有多重大。",shape=box,color=red];
		j3544814444 -> j2597031317;
	j3206110913 [label="不，老實說，我們之間目前的情況來看，我已經毀掉了讓她幫助修補 Loid 和樓上家族之間關係的任何機會。",shape=box,color=red];
		j3206110913 -> j2462527761;
	j1905255472 [label="不，老實說，我們之間目前的情況來看，我已經毀掉了讓她幫助修補 Loid 和樓上家族之間關係的任何機會。",shape=box,color=red];
		j1905255472 -> j75223991;
	j3989791641 [label="我滿意。她不會幫我修補 Loid 和樓上家族的關係，這對我來說沒問題。",shape=box,color=red];
		j3989791641 -> j3249918126;
	j3393072283 [label="我滿意。我很高興她看到源拓氏可能不是純粹的「善」，而且……嗯，他也不是純粹的「惡」，對吧？",shape=box,color=red];
		j3393072283 -> j2371367880;
	j3740045489 [label="我對目前的情況很滿意。老實說，我越想越覺得我在源拓氏的事情上站在她那邊。",shape=box,color=red];
		j3740045489 -> j3249918126;
	j3422013352 [label="我們在源拓氏的事情上沒有達成共識。我沒能說服她，而且……我只希望我能做得更好。",shape=box,color=red];
		j3422013352 -> j979107663;
	j1798674169 [label="我們在源拓氏的事情上「求同存異」，我認為這已經是我們在這個話題上能達到的最好結果了。我認為再多的談話也無濟於事。",shape=box,color=red];
		j1798674169 -> j2074628047;
	j2455341847 [label="老實說，沒關係。我認為此時此刻不會變得更好或更糟。",shape=box,color=red];
		j2455341847 -> j2074628047;
	j1257283965 [label="不，恐怕她對我說的話將是我的秘密。但它們對她來說同樣感人。不過我想知道，你對你們之間的事情的處理方式還滿意嗎？",shape=box,color=blue];
		j1257283965 -> j1424199455;
	j2597031317 [label="我相信我能理解其宏偉，即使不能理解其規模。我……很榮幸能以某種小方式參與其中。",shape=box,color=blue];
		j2597031317 -> j2688828408;
		j2597031317 -> j40620676;
	j2462527761 [label="有趣……嗯，你現在是她的愛人了，不是嗎？如果這個地方有誰能影響她的話，那會是你，對吧？",shape=box,color=blue];
		j2462527761 -> j1995298416;
	j75223991 [label="有趣……嗯，我對她有一些……影響力，儘管可能有限。你覺得修補 Loid 先生和源拓氏疏遠的家人之間的關係很重要嗎？",shape=box,color=blue];
		j75223991 -> j1440589087;
		j75223991 -> j3095488809;
	j3249918126 [label="我無法判斷那是任性、傲慢、無知還是冷漠的語氣。因此我將決定這是四者的混合，然後繼續我的一天。",shape=box,color=blue];
		j3249918126 -> j1440562750;
	j2371367880 [label="確實。我和你有類似的想法。我不相信他是一種或另一種方式，而是……動機混雜。",shape=box,color=blue];
		j2371367880 -> j2086590039;
	j979107663 [label="嗯。不幸的是，所有事情都會有必須結束的時候。麵團可能被過度揉捏。藝術家可能在畫作上添加過多。爭論肯定可能會過於激烈。",shape=box,color=blue];
		j979107663 -> j2795892097;
	j2074628047 [label="是的，也許話題最好轉向更好的方向。",shape=box,color=blue];
		j2074628047 -> j878885106;
	j2688828408 [label="我沒想到你會主動幫忙。",shape=box,color=red];
		j2688828408 -> j2309601721;
	j40620676 [label="這意味著你會幫我說服 Loid 上樓去和他們談談嗎？",shape=box,color=red];
		j40620676 -> j983204061;
	j1995298416 [label="我只是希望你在對她說話時沒有做出某種犧牲，為了追求她而將一個優先事項置於另一個之上。",shape=box,color=blue];
		j1995298416 -> j3276085521;
	j1440589087 [label="這個世界上有太多孤獨，里昂。太多悲傷。當我們能終結其中一些時，為什麼不呢？",shape=box,color=red];
		j1440589087 -> j2807183323;
	j3095488809 [label="我不確定，這是一種直覺——一種本能。我覺得源拓氏把你們三個帶到這裡來是有原因的。",shape=box,color=red];
		j3095488809 -> j1340517394;
	j1440562750 [label="可惜了。",shape=box,color=blue];
		j1440562750 -> j3497962379;
	j2086590039 [label="驅使他的是傲慢。對知識的貪婪。現在，也許是對寬恕的貪婪。誰能說呢？我甚至懷疑他自己是否知道。",shape=box,color=blue];
		j2086590039 -> j1359619045;
	j2795892097 [label="我想我會選擇放手並希望有一天她可能有機會看到我們所知道的源拓氏……充其量，是複雜的。",shape=box,color=blue];
		j2795892097 -> j1359619045;
	j878885106 [label="就我而言，我已經受夠了關於那位奇妙無瑕的「主教」的無休止對話。",shape=box,color=blue];
		j878885106 -> j1359619045;
	j2309601721 [label="我知道我不是特別和藹可親，但我也不是什麼食屍鬼。如果你需要我的幫助的話，我隨時樂意效勞。",shape=box,color=blue];
		j2309601721 -> j2800191596;
	j983204061 [label="當然可以。如果你需要我的幫助的話，我隨時樂意效勞。",shape=box,color=blue];
		j983204061 -> j2800191596;
	j3276085521 [label="那將是多麼糟糕的狀況。",shape=box,color=blue];
		j3276085521 -> j2617634622;
	j2807183323 [label="嗯。那麼當這些真相被揭露時，重新進入彼此的生命可能會對各方之間造成的痛苦呢？",shape=box,color=blue];
		j2807183323 -> j3030384628;
		j2807183323 -> j1374846290;
	j1340517394 [label="而你是在憑「本能感覺」的影響去執行源拓氏的命令嗎？",shape=box,color=blue];
		j1340517394 -> j761747439;
		j1340517394 -> j3388017350;
	j3497962379 [label="Boolean LyonFamilyFail is now true.",color=orange];
		j3497962379 -> "Chat ends.";
	j1359619045 [label="我不知道 Loid 先生和源拓氏疏遠的家人之間的事情會如何發展。我只是想說，如果你需要我的協助，你將得到。",shape=box,color=blue];
		j1359619045 -> j2800191596;
