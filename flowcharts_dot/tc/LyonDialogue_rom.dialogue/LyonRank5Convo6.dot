		j2617634622 -> j176861813;
	j3030384628 [label="一開始肯定會痛。就像接骨一樣。但這是這種傷唯一能正確癒合的方式。",shape=box,color=red];
		j3030384628 -> j4183305561;
	j1374846290 [label="我認為我們在一起所能獲得的，大於我們分開所會失去的。",shape=box,color=red];
		j1374846290 -> j4183305561;
	j761747439 [label="不，但我的職責是保護需要保護的人。而我無法永遠守護他們和這個地方，免於低語和 Infestation 的侵害。但你們兩個，甚至可能還有羅瑟，可以。",shape=box,color=red];
		j761747439 -> j4183305561;
	j3388017350 [label="我不一定信任他，但我仍然不認為他是我們的敵人。我感覺戰爭即將來臨，而我們都被放置在棋盤上該在的位置。這就是我們的歸屬。",shape=box,color=red];
		j3388017350 -> j727572435;
	j2180959839 [label="雖然我相信你已經完成了最艱鉅的任務──說服羅瑟。",shape=box,color=blue];
		j2180959839 -> j3537225709;
	j757230278 [label="雖然我必須坐下來想想如何說服羅瑟改變主意……我不確定我是否能做到。而沒有他，這可能是註定失敗的事。",shape=box,color=blue];
		j757230278 -> j1241296981;
		j757230278 -> j3053680849;
