	j3170813690 [label="- 里昂",shape=box,color=blue];
		j3170813690 -> j1933300832;
	j1623626568 [label="確實。說得對。很好。我會跟她談談。我會看看能不能說服她就此事再跟你談談。",shape=box,color=blue];
		j1623626568 -> j1543055844;
		j1623626568 -> j2114426911;
	j146468333 [label="就這點而言，恐怕我認同 Loid 先生的顧慮。我會協助你說服他，但我認為沒有瑪麗你不會有太大進展。",shape=box,color=blue];
