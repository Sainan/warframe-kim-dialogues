	edge [fontname="Roboto Condensed"];

	"LyonRank4Convo5 begins." [color=orange];
		"LyonRank4Convo5 begins." -> j3425926750;
	j3425926750 [label="Check boolean LyonSerum1",color=orange];
		j3425926750 -> j3131362286 [label=true,color=green];
		j3425926750 -> j1350559949 [label=true,color=green];
		j3425926750 -> j4195666497 [label=false,color=brown];
		j3425926750 -> j1350559949 [label=false,color=brown];
	j3131362286 [label="里昂，我可不可以聽羅瑟是如何和你還有瑪麗一起來到大教堂那剩下的故事呢？",shape=box,color=red];
		j3131362286 -> j3577606641;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j4195666497 [label="里昂，我可不可以聽羅瑟是如何和你還有瑪麗一起來到大教堂的故事呢？",shape=box,color=red];
		j4195666497 -> j1914715673;
	j3577606641 [label="如你所願。不過，這可不是個什麼愉快的故事。他像一隻受傷的野貓一樣被丟在我們家門口。",shape=box,color=blue];
		j3577606641 -> j3769319211;
	"Chat ends." [color=orange];
	j1914715673 [label="如你所願。他像一隻受傷的野貓一樣被遺棄在我們家門口。不是一個開心的故事。",shape=box,color=blue];
		j1914715673 -> j3769319211;
	j3769319211 [label="Evaluate expressions",color=orange];
		j3769319211 -> j2209892191 [label="LyonStray",color=purple];
		j3769319211 -> j1021134669 [label="RoatheSerum1",color=purple];
		j3769319211 -> j2320243166 [label="false",color=purple];
	j2209892191 [label="我猜對了，那個故事原本是關於羅瑟的。",shape=box,color=red];
		j2209892191 -> j1002292079;
	j1021134669 [label="根據他自己描述，他出現的時候，完全可以表現得有點……野。",shape=box,color=red];
		j1021134669 -> j1349002391;
	j2320243166 [label="好，繼續吧。",shape=box,color=red];
		j2320243166 -> j2266356665;
	j1002292079 [label="那只是個……關於一隻流浪貓去教堂的故事。你能聽出什麼弦外之音，或是去猜我為什麼要告訴你這件事……那是你自己的事。別忘了，我終究是個神父。",shape=box,color=blue];
		j1002292079 -> j2266356665;
	j1349002391 [label="考慮到他的地位與性格，對於源拓氏對他所做的一切感到憤慨，也在預料之中。坦白說，若他能展現風度寬恕這一切，我反倒會感到驚詫。",shape=box,color=blue];
		j1349002391 -> j2266356665;
	j2266356665 [label="Evaluate expressions",color=orange];
		j2266356665 -> j3291399374 [label="LyonSerum1",color=purple];
		j2266356665 -> j2170989328 [label="false",color=purple];
	j3291399374 [label="我記得之前說到……源拓氏帶著羅瑟回來了，那個已經變成了現在這副怪模樣的羅瑟。源拓氏向我們揭露了他三年多來所說的所有謊言。",shape=box,color=blue];
		j3291399374 -> j1984614717;
	j2170989328 [label="我就試著把那之前發生的事做個總結吧，不然聽起來……最多也就是一堆胡言亂語罷了。",shape=box,color=blue];
		j2170989328 -> j2828015105;
	j1984614717 [label="他向我們提供了「原型 Warframe 血清」，使我們變成了現在的樣子，一旦我們接受了它們……他又立即拋棄了我們。",shape=box,color=blue];
		j1984614717 -> j1808991751;
	j2828015105 [label="沒他擔任我們大教堂的日曜主教一職三年兩個月零十一天。在那段時間裡，我和瑪麗一直侍奉他，卻對他為我們所做的安排一無所知。",shape=box,color=blue];
		j2828015105 -> j290422606;
	j1808991751 [label="於是我們被遺留在那裡，成了一群失去父母的混種，身軀與靈魂被重塑成我們難以理解、更別說要去駕馭的怪物。",shape=box,color=blue];
		j1808991751 -> j38316332;
	j290422606 [label="在你說出口之前，我就知道你想問的問題了。他究竟在密謀什麼？他是否像我聽說的對霍爾瓦尼亞那樣，也要感染這座城市？他的計劃是什麼？他發現了什麼？",shape=box,color=blue];
		j290422606 -> j4073497256;
	j38316332 [label="我們受困於這座曾是我們的家園，但卻不再對我們友善的城市。我們……被迫躲藏起來。",shape=box,color=blue];
		j38316332 -> j1154043480;
		j38316332 -> j3268494887;
	j4073497256 [label="關於這些……恐怕你要失望了。他只是佈道、讀書、休息，還有祈禱。然後某個晚上，他在一場可怕的暴風雨中消失了。就像他出現時那樣。",shape=box,color=blue];
		j4073497256 -> j2575044127;
	j1154043480 [label="因為你的外表嗎？",shape=box,color=red];
		j1154043480 -> j601884184;
	j3268494887 [label="大教堂有趕你們出去嗎？",shape=box,color=red];
		j3268494887 -> j2109105061;
	j2575044127 [label="Check boolean MarieLyonVisions",color=orange];
		j2575044127 -> j1755104932 [label=true,color=green];
		j2575044127 -> j1033487581 [label=false,color=brown];
	j601884184 [label="我不知道你有否留意到，瑪麗會飛，而羅瑟……是藍色的，除此之外還有其他一些問題。",shape=box,color=blue];
		j601884184 -> j2635291424;
	j2109105061 [label="不……不完全是。我們是被迫隱姓埋名。但我們的弟兄姐妹沒有把我們趕到街上，也沒有燒死我們。「日曜主教」讓他們相信我們的變化是……聖光會的旨意。",shape=box,color=blue];
		j2109105061 -> j2396645603;
	j1755104932 [label="雖然我知道其他人可能沒有感受到這場風暴，但我卻真實地感覺到了。",shape=box,color=blue];
		j1755104932 -> j1033487581;
	j1033487581 [label="一年之後的同一天，他最後一次出現，而……羅瑟，正如你現在看到的，倒在他腳下並昏迷不醒。",shape=box,color=blue];
		j1033487581 -> j3110583917;
	j2635291424 [label="我知道你整天忙著跟會說話的動物還有骷髏打交道並思考著虛空的奧秘，但這對一般人來說可不是常態。",shape=box,color=blue];
		j2635291424 -> j2910889992;
	j2396645603 [label="我們被藏在墓穴裡不讓人看見。我們以前的弟兄雖然害怕我們，還是會帶物資過來。",shape=box,color=blue];
		j2396645603 -> j2781402129;
	j3110583917 [label="他簡直就是魔鬼的化身，至少看起來是這樣。就在那時，源拓氏向我們揭示了他的真實身份 — 他來自的地方 — 以及他給予我們的真正任務。他選中我們兩人執行一個極其「神聖的使命」。",shape=box,color=blue];
		j3110583917 -> j618782872;
	j2910889992 [label="沒錯，如果我把自己包得夠緊，我大概是我們三個裡面唯一能在人群中走動的。",shape=box,color=blue];
		j2910889992 -> j2142172231;
		j2910889992 -> j1270252457;
	j2781402129 [label="他們……堅持只瑪麗互動，儘管她總是在樓梯上如鬼魅般突然現身迎接他們。",shape=box,color=blue];
		j2781402129 -> j3953851301;
		j2781402129 -> j1612949085;
	j618782872 [label="瑪麗欣然接受了血清。當然，她會接受的。她怎麼可能不接受呢？而我又怎能不跟隨她呢？我又怎能不去追尋真相，無論真相會將我指引到任何方向呢？",shape=box,color=blue];
		j618782872 -> j249472217;
	j2142172231 [label="你們住在哪裡？",shape=box,color=red];
		j2142172231 -> j2225449923;
	j1270252457 [label="你們是怎樣來到這裡的？",shape=box,color=red];
		j1270252457 -> j1300099542;
	j3953851301 [label="我可以理解他們想避開羅瑟，但……他們寧願避開羅瑟也不願意跟你說話？",shape=box,color=red];
		j3953851301 -> j2671340683;
	j1612949085 [label="她很貼心……",shape=box,color=red];
		j1612949085 -> j1741603668;
	j249472217 [label="Boolean LyonSerum1 is now true.",color=orange];
		j249472217 -> j3033338551;
		j249472217 -> j3169375455;
		j249472217 -> j2959913072;
	j2225449923 [label="我們的弟兄姐妹沒有把我們趕到街上，也沒有燒死我們。「日曜主教」讓他們相信我們的變化是……聖光會的旨意。",shape=box,color=blue];
		j2225449923 -> j704257249;
	j1300099542 [label="具體上到底「如何」做到只有羅瑟才知道，不過在……多年努力之後，他用我們的血造出了一個「Helminth」。",shape=box,color=blue];
		j1300099542 -> j2791527124;
	j2671340683 [label="我相信我們之前見過面的，對嗎？",shape=box,color=blue];
		j2671340683 -> j3321546678;
	j1741603668 [label="正是如此。",shape=box,color=blue];
		j1741603668 -> j3654656026;
	j3033338551 [label="我覺得她對源拓氏的崇拜有點過火了。",shape=box,color=red];
		j3033338551 -> j3797253624;
	j3169375455 [label="之後發生了什麼事？",shape=box,color=red];
		j3169375455 -> j1888051615;
	j2959913072 [label="你後悔嗎？",shape=box,color=red];
		j2959913072 -> j1507015954;
	j704257249 [label="我們被藏在墓穴裡不讓人看見。我們以前的弟兄雖然害怕我們，還是會帶物資過來。",shape=box,color=blue];
		j704257249 -> j3601449961;
	j2791527124 [label="我相信 Infestation 能透過時間……以某種方式連結著彼此……雖然細節我完全搞不懂。",shape=box,color=blue];
		j2791527124 -> j360914557;
		j2791527124 -> j4173720239;
	j3321546678 [label="你們被困在下面多久？",shape=box,color=red];
		j3321546678 -> j2714758609;
	j3654656026 [label="所以……他們把你們都關在地下室了？",shape=box,color=red];
		j3654656026 -> j1798196629;
	j3797253624 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j3797253624 -> j589423904;
	j1888051615 [label="羅瑟醒了過來。最初，他幾乎記不起自己的名字。源拓氏臨別前對這個王八蛋說了一句話：「被放逐的 Xata 異端者 Uriel，回答我 — Orokin 人還能被原諒嗎？」",shape=box,color=blue];
		j1888051615 -> j4067524089;
	j1507015954 [label="「我後悔一切，漂泊者。」是的，我當然後悔。但我還會再做一次嗎？是的，我當然會。我不能留下瑪麗自己一個人。",shape=box,color=blue];
		j1507015954 -> j4235387532;
	j3601449961 [label="他們……堅持只瑪麗互動，儘管她總是在樓梯上如鬼魅般突然現身迎接他們。",shape=box,color=blue];
		j3601449961 -> j4079948666;
		j3601449961 -> j3427287796;
	j360914557 [label="他逆向工程搞出了一個 Helminth？！那花了他多久時間？！",shape=box,color=red];
		j360914557 -> j4139352951;
	j4173720239 [label="我覺得沒人能理解。這是一個新發現。",shape=box,color=red];
		j4173720239 -> j2654663391;
	j2714758609 [label="或許你不該問我，自從我們變成會說話的 Infested 融合體之後過了多少年。從那以後，我對時間流逝的感知一直……很混亂。",shape=box,color=blue];
		j2714758609 -> j2800350033;
		j2714758609 -> j410896282;
	j1798196629 [label="這聽起來或許比實際情況殘酷。我們別無選擇。鐘樓太開闊，擋不住壞天氣。墓室裡夠遮蔽也夠暖和。",shape=box,color=blue];
		j1798196629 -> j2145040667;
	j589423904 [label="在這點上，我們意見一致。但我也不能因此責怪她。給她點時間，她會明白的。她非常聰明，漂泊者。不要把她當傻瓜。",shape=box,color=blue];
		j589423904 -> j4235387532;
	j4067524089 [label="源拓氏就此永遠離開了。他把羅瑟留給了我們，而羅瑟如今已煥然一新，變成了你們現在看到的樣子 — 更能與那喜怒無常的魔鬼抗衡。",shape=box,color=blue];
		j4067524089 -> j1808991751;
	j4235387532 [label="故事的發展就是……源拓氏就此永遠離開了。他把羅瑟留給了我們，而羅瑟如今已煥然一新，變成了你們現在看到的樣子 — 更能與那喜怒無常的魔鬼抗衡。",shape=box,color=blue];
		j4235387532 -> j1808991751;
	j4079948666 [label="我可以理解他們想避開羅瑟，但……他們寧願避開羅瑟也不願意跟你說話？",shape=box,color=red];
		j4079948666 -> j1013680237;
	j3427287796 [label="她很貼心……",shape=box,color=red];
		j3427287796 -> j1282434218;
	j4139352951 [label="Boolean LyonRoatheHelminth is now true.",color=orange];
		j4139352951 -> j1767452782;
	j2654663391 [label="我不知道知道這件事是令人欣慰還是令人沮喪，謝謝。現在知道這些感染者居然會說話，真是匪夷所思。",shape=box,color=blue];
		j2654663391 -> j3388904102;
		j2654663391 -> j4198976446;
	j2800350033 [label="混亂？如何混亂？",shape=box,color=red];
		j2800350033 -> j334846487;
	j410896282 [label="我不確定是否該告訴你，其實 Infestation 也能說話……",shape=box,color=red];
		j410896282 -> j2856788793;
	j2145040667 [label="不幸的是，我們發現它有個出口，羅瑟能利用這些出口……四處遊蕩。",shape=box,color=blue];
		j2145040667 -> j845860967;
	j1013680237 [label="我相信我們之前見過面的，對嗎？",shape=box,color=blue];
		j1013680237 -> j3321546678;
		j1013680237 -> j3654656026;
	j1282434218 [label="正是如此。",shape=box,color=blue];
		j1282434218 -> j3654656026;
		j1282434218 -> j3321546678;
	j1767452782 [label="你大概不該問我。從那之後，我對時間的概念就變得很……混亂。雖然說「更混亂」可能比較準確。好像這一切還不夠恐怖一樣……",shape=box,color=blue];
		j1767452782 -> j2800350033;
		j1767452782 -> j410896282;
	j3388904102 [label="並非所有家具都會。椅子有時可能會……嗯……罷了，請繼續。",shape=box,color=red];
		j3388904102 -> j1787551709;
	j4198976446 [label="關於吉他的事我就不跟你說太多了。",shape=box,color=red];
		j4198976446 -> j194749172;
	j334846487 [label="Boolean LyonTime1 is now true.",color=orange];
		j334846487 -> j753316027;
	j2856788793 [label="請相信我，我懂。這確實令人不安，謝謝。雖然這裡好像隨便什麼家具擺設都會說話。",shape=box,color=blue];
		j2856788793 -> j3388904102;
		j2856788793 -> j4198976446;
	j845860967 [label="Evaluate expressions",color=orange];
		j845860967 -> j3801032461 [label="MarieRoathePastry1",color=purple];
		j845860967 -> j3801032461 [label="RoatheMariePastry1",color=purple];
		j845860967 -> j2740169796 [label="false",color=purple];
	j1787551709 [label="如果你想說的字是「佔據」，那麼我也看到了，漂泊者。那個會低語的東西。牆裡面的那個。我聽見了敲擊聲……",shape=box,color=blue];
		j1787551709 -> j3150260013;
	j194749172 [label="請繼續。雖然，我覺得如果把樂器當成某個短暫停留的半神，會讓我好過很多，總比……其他那些跑來折磨我又拋棄我心智的東西好。這很奇怪嗎，我……自從他……",shape=box,color=blue];
		j194749172 -> j188042414;
	j753316027 [label="我不確定這是不是因為我體質特別敏感，還是因為……我被製造出來時的具體遭遇，或者是……因為他——",shape=box,color=blue];
		j753316027 -> j2541535805;
	j3801032461 [label="我聽說了。",shape=box,color=red];
		j3801032461 -> j350374201;
	j2740169796 [label="噢？",shape=box,color=red];
		j2740169796 -> j2340994945;
	j3150260013 [label="有個聲音在指引我，我知道我這輩子從沒聽過，但它卻連接著我的過去，還伸向遙遠的未來……",shape=box,color=blue];
		j3150260013 -> j2208272476;
	j188042414 [label="他？",shape=box,color=red];
		j188042414 -> j3150260013;
	j2541535805 [label="我知道當我這麼說時，你定會視我為一個徹頭徹尾的瘋子，但我對時間的體驗並非以……純粹的……線性方式推進。",shape=box,color=blue];
		j2541535805 -> j957228249;
		j2541535805 -> j3361527332;
	j350374201 [label="我認為那是他僅有的少數可取之處之一。請注意，並非指竊盜行為本身，而是其背後的緣由。我猜他弄來那些禁品只是為了激起瑪麗與他交談。",shape=box,color=blue];
		j350374201 -> j1307235508;
	j2340994945 [label="這些都無關緊要了。",shape=box,color=blue];
		j2340994945 -> j3629095852;
		j2340994945 -> j2135793470;
	j2208272476 [label="它不是一直都在。但我現在卻想起來了，就像太陰的銀白一樣光輝清晰，就在我兒時家園的牆後。一個年輕男人的聲音。還有另一個東西站在他旁邊……「噠噠噠……」",shape=box,color=blue];
		j2208272476 -> j4126661485;
	j957228249 [label="「他」？「他」是誰？",shape=box,color=red];
		j957228249 -> j3150260013;
	j3361527332 [label="我可是經歷過不知道幾百個世紀的螺旋時間迴圈喔，里昂。",shape=box,color=red];
		j3361527332 -> j3387126397;
	j1307235508 [label="大概是因為那些東西讓她笑了吧，雖然她是趁他看不到的時候笑的。有次他跟我說：「命運讓她活得這麼死氣沉沉真是天大的錯誤。」",shape=box,color=blue];
		j1307235508 -> j3733610902;
	j3629095852 [label="你們花了多久才回到……嗯，現在？",shape=box,color=red];
		j3629095852 -> j3934222112;
	j2135793470 [label="之後發生了什麼事？",shape=box,color=red];
		j2135793470 -> j1300099542;
	j4126661485 [label="我……對不起。我要走了。我現在還不能說這件事。我……我很抱歉。請不要再問我這件事了。",shape=box,color=blue];
