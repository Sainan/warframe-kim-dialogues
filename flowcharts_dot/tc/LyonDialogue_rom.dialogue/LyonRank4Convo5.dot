digraph {
	"LyonRank4Convo5 begins." [color=orange];
		"LyonRank4Convo5 begins." -> j3425926750;
	j3425926750 [label="Check boolean LyonSerum1",color=orange];
		j3425926750 -> j3131362286 [label=true,color=green];
		j3425926750 -> j1350559949 [label=true,color=green];
		j3425926750 -> j4195666497 [label=false,color=brown];
		j3425926750 -> j1350559949 [label=false,color=brown];
	j3131362286 [label="里昂，我可不可以聽羅瑟是如何和你還有瑪麗一起來到大教堂那剩下的故事呢？",shape=box,color=red];
		j3131362286 -> j3577606641;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j4195666497 [label="里昂，我可不可以聽羅瑟是如何和你還有瑪麗一起來到大教堂的故事呢？",shape=box,color=red];
		j4195666497 -> j1914715673;
	j3577606641 [label="如你所願。不過，這可不是個什麼愉快的故事。他像一隻受傷的野貓一樣被丟在我們家門口。",shape=box,color=blue];
		j3577606641 -> j3769319211;
	"Chat ends." [color=orange];
	j1914715673 [label="如你所願。他像一隻受傷的野貓一樣被遺棄在我們家門口。不是一個開心的故事。",shape=box,color=blue];
		j1914715673 -> j3769319211;
	j3769319211 [label="Evaluate expressions",color=orange];
		j3769319211 -> j3583908081 [label="LyonStray",color=purple];
		j3769319211 -> j795861685 [label="RoatheSerum1",color=purple];
		j3769319211 -> j2320243166 [label="false",color=purple];
	j3583908081 [label="我猜對了，那個故事原本是關於羅瑟的。",shape=box,color=red];
		j3583908081 -> j4188132758;
	j795861685 [label="根據他自己描述，他出現的時候，完全可以表現得有點……野。",shape=box,color=red];
		j795861685 -> j3745711565;
	j2320243166 [label="好，繼續吧。",shape=box,color=red];
		j2320243166 -> j2266356665;
	j4188132758 [label="It was a story about a stray cat that used to visit the Cathedral. What you glean behind its meaning, or my reason for telling it to you, is entirely your own responsibility. I am a priest, am I not?",shape=box,color=blue];
		j4188132758 -> j2266356665;
	j3745711565 [label="It would be my expectation for someone of his status and disposition to feel wronged by the actions Entrati took against him. I would, quite honestly, be far more taken aback if he handled it with grace.",shape=box,color=blue];
		j3745711565 -> j2266356665;
	j2266356665 [label="Evaluate expressions",color=orange];
		j2266356665 -> j3287172269 [label="LyonSerum1",color=purple];
		j2266356665 -> j1553539001 [label="false",color=purple];
	j3287172269 [label="I believe where I left us, Entrati had recently returned from his disappearance with Roathe, as we see him now, already changed. Entrati revealed to us all the lies he had spoken for over three years.",shape=box,color=blue];
		j3287172269 -> j3447204892;
	j1553539001 [label="I will attempt to summarize the events that led up to that moment, otherwise it may seem... nonsensical at best.",shape=box,color=blue];
		j1553539001 -> j2721483071;
	j3447204892 [label="他向我們提供了「原型 Warframe 血清」，使我們變成了現在的樣子，一旦我們接受了它們……他又立即拋棄了我們。",shape=box,color=blue];
		j3447204892 -> j2523353943;
	j2721483071 [label="沒他擔任我們大教堂的日曜主教一職三年兩個月零十一天。在那段時間裡，我和瑪麗一直侍奉他，卻對他為我們所做的安排一無所知。",shape=box,color=blue];
		j2721483071 -> j1552752025;
	j2523353943 [label="And there, we remained, as newly orphaned amalgams, with bodies and souls remade into creations we could barely comprehend let alone claim mastery over.",shape=box,color=blue];
		j2523353943 -> j2256942913;
	j1552752025 [label="在你說出口之前，我就知道你想問的問題了。他究竟在密謀什麼？他是否像我聽說的對霍爾瓦尼亞那樣，也要感染這座城市？他的計劃是什麼？他發現了什麼？",shape=box,color=blue];
		j1552752025 -> j2294496618;
	j2256942913 [label="Stranded in a city that was our home, but no longer friendly to us. We were... forced to hide.",shape=box,color=blue];
		j2256942913 -> j3775020872;
		j2256942913 -> j4170203322;
	j2294496618 [label="To these I will say, you will be disappointed. He preached. He studied. He rested. And he prayed. Then, one night, he disappeared in the midst of a terrible storm. The same as the one in which he appeared.",shape=box,color=blue];
		j2294496618 -> j2575044127;
	j3775020872 [label="因為你的外表嗎？",shape=box,color=red];
		j3775020872 -> j1980707957;
	j4170203322 [label="大教堂有趕你們出去嗎？",shape=box,color=red];
		j4170203322 -> j948973488;
	j2575044127 [label="Check boolean MarieLyonVisions",color=orange];
		j2575044127 -> j1755104932 [label=true,color=green];
		j2575044127 -> j1033487581 [label=false,color=brown];
	j1980707957 [label="我不知道你有否留意到，瑪麗會飛，而羅瑟……是藍色的，除此之外還有其他一些問題。",shape=box,color=blue];
		j1980707957 -> j3146046261;
	j948973488 [label="Not... precisely. We were forced from public life. But our fellow Brothers and Sisters did not exile us to the streets, or burn us at the stake. \"Cardinal Dimanche\" convinced them our changes were... the work of the Luminaries.",shape=box,color=blue];
		j948973488 -> j1819120466;
	j1755104932 [label="雖然我知道其他人可能沒有感受到這場風暴，但我卻真實地感覺到了。",shape=box,color=blue];
		j1755104932 -> j1033487581;
	j1033487581 [label="一年之後的同一天，他最後一次出現，而……羅瑟，正如你現在看到的，倒在他腳下並昏迷不醒。",shape=box,color=blue];
		j1033487581 -> j3110583917;
	j3146046261 [label="I know you spend your days dallying with talking animals and skulls and pondering the question of the cosmic Void, but that is not standard issue for most humans.",shape=box,color=blue];
		j3146046261 -> j1721024355;
	j1819120466 [label="We were hidden within the crypts and kept out of sight. Our former brethren, though terrified of us, would bring us supplies.",shape=box,color=blue];
		j1819120466 -> j4022287456;
	j3110583917 [label="他簡直就是魔鬼的化身，至少看起來是這樣。就在那時，源拓氏向我們揭示了他的真實身份 — 他來自的地方 — 以及他給予我們的真正任務。他選中我們兩人執行一個極其「神聖的使命」。",shape=box,color=blue];
		j3110583917 -> j618782872;
	j1721024355 [label="Indeed, I am the one of the three of us that could perhaps wander amongst the crowd if I were to shroud myself well enough. ",shape=box,color=blue];
		j1721024355 -> j3047099651;
		j1721024355 -> j1121225619;
	j4022287456 [label="They... would insist on interacting only with Marie, despite her abrupt ghost-like appearances upon the stairs to greet them. ",shape=box,color=blue];
		j4022287456 -> j4294479892;
		j4022287456 -> j1565637169;
	j618782872 [label="瑪麗欣然接受了血清。當然，她會接受的。她怎麼可能不接受呢？而我又怎能不跟隨她呢？我又怎能不去追尋真相，無論真相會將我指引到任何方向呢？",shape=box,color=blue];
		j618782872 -> j249472217;
	j3047099651 [label="你們住在哪裡？",shape=box,color=red];
		j3047099651 -> j4067760369;
	j1121225619 [label="你們是怎樣來到這裡的？",shape=box,color=red];
		j1121225619 -> j1779874582;
	j4294479892 [label="我可以理解他們想避開羅瑟，但……他們寧願避開羅瑟也不願意跟你說話？",shape=box,color=red];
		j4294479892 -> j3774221737;
	j1565637169 [label="她很貼心……",shape=box,color=red];
		j1565637169 -> j478544901;
	j249472217 [label="Boolean LyonSerum1 is now true.",color=orange];
		j249472217 -> j990640819;
		j249472217 -> j2160514828;
		j249472217 -> j3385594313;
	j4067760369 [label="Our fellow Brothers and Sisters did not exile us to the streets, or burn us at the stake. \"Cardinal Dimanche\" convinced them our changes were... the work of the Luminaries.",shape=box,color=blue];
		j4067760369 -> j2007574409;
	j1779874582 [label="Roathe will know the specifics of precisely \"how,\" but after... many years of work, he created a \"Helminth\" from samples of our blood.",shape=box,color=blue];
		j1779874582 -> j2349739827;
	j3774221737 [label="我相信我們之前見過面的，對嗎？",shape=box,color=blue];
		j3774221737 -> j3893739067;
	j478544901 [label="正是如此。",shape=box,color=blue];
		j478544901 -> j454979609;
	j990640819 [label="我覺得她對源拓氏的崇拜有點過火了。",shape=box,color=red];
		j990640819 -> j2787623709;
	j2160514828 [label="之後發生了什麼事？",shape=box,color=red];
		j2160514828 -> j4182173301;
	j3385594313 [label="你後悔嗎？",shape=box,color=red];
		j3385594313 -> j2658771292;
	j2007574409 [label="We were hidden within the crypts and kept out of sight. Our former brethren, though terrified of us, would bring us supplies.",shape=box,color=blue];
		j2007574409 -> j2681353844;
	j2349739827 [label="I believe the Infestation is connected to itself through... time... somehow... though the details are quite lost on me.",shape=box,color=blue];
		j2349739827 -> j2587361651;
		j2349739827 -> j4173720239;
	j3893739067 [label="你們被困在下面多久？",shape=box,color=red];
		j3893739067 -> j2879177880;
	j454979609 [label="所以……他們把你們都關在地下室了？",shape=box,color=red];
		j454979609 -> j1779196671;
	j2787623709 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j2787623709 -> j3638825849;
	j4182173301 [label="羅瑟醒了過來。最初，他幾乎記不起自己的名字。源拓氏臨別前對這個王八蛋說了一句話：「被放逐的 Xata 異端者 Uriel，回答我 — Orokin 人還能被原諒嗎？」",shape=box,color=blue];
		j4182173301 -> j3294368756;
	j2658771292 [label="「我後悔一切，漂泊者。」是的，我當然後悔。但我還會再做一次嗎？是的，我當然會。我不能留下瑪麗自己一個人。",shape=box,color=blue];
		j2658771292 -> j4237654645;
	j2681353844 [label="They... would insist on interacting only with Marie, despite her abrupt ghost-like appearances upon the stairs to greet them. ",shape=box,color=blue];
		j2681353844 -> j4079948666;
		j2681353844 -> j3427287796;
	j2587361651 [label="He reverse-engineered a Helminth?! How long did that take?!",shape=box,color=red];
		j2587361651 -> j1957525480;
	j4173720239 [label="我覺得沒人能理解。這是一個新發現。",shape=box,color=red];
		j4173720239 -> j2654663391;
	j2879177880 [label="I am perhaps not the one you should ask about how many years passed after we were turned into talking Infested amalgams. My grasp on the passage of time since then has been... convoluted.",shape=box,color=blue];
		j2879177880 -> j983124728;
		j2879177880 -> j4192580199;
	j1779196671 [label="It sounds perhaps more harsh than it seems. There was nowhere else to put us. The belfry was too open, too exposed to the harsh elements. The crypt was sheltered and warm.",shape=box,color=blue];
		j1779196671 -> j924841492;
	j3638825849 [label="在這點上，我們意見一致。但我也不能因此責怪她。給她點時間，她會明白的。她非常聰明，漂泊者。不要把她當傻瓜。",shape=box,color=blue];
		j3638825849 -> j4237654645;
	j3294368756 [label="源拓氏就此永遠離開了。他把羅瑟留給了我們，而羅瑟如今已煥然一新，變成了你們現在看到的樣子 — 更能與那喜怒無常的魔鬼抗衡。",shape=box,color=blue];
		j3294368756 -> j2523353943;
	j4237654645 [label="故事的發展就是……源拓氏就此永遠離開了。他把羅瑟留給了我們，而羅瑟如今已煥然一新，變成了你們現在看到的樣子 — 更能與那喜怒無常的魔鬼抗衡。",shape=box,color=blue];
		j4237654645 -> j2523353943;
	j4079948666 [label="我可以理解他們想避開羅瑟，但……他們寧願避開羅瑟也不願意跟你說話？",shape=box,color=red];
		j4079948666 -> j1013680237;
	j3427287796 [label="她很貼心……",shape=box,color=red];
		j3427287796 -> j1282434218;
	j1957525480 [label="Boolean LyonRoatheHelminth is now true.",color=orange];
		j1957525480 -> j1424411030;
	j2654663391 [label="我不知道知道這件事是令人欣慰還是令人沮喪，謝謝。現在知道這些感染者居然會說話，真是匪夷所思。",shape=box,color=blue];
		j2654663391 -> j2285690740;
		j2654663391 -> j1803225520;
	j983124728 [label="Convoluted, how?",shape=box,color=red];
		j983124728 -> j4020450692;
	j4192580199 [label="I'm not sure if I should tell you that the Infestation can also talk...",shape=box,color=red];
		j4192580199 -> j1408773028;
	j924841492 [label="And, unfortunately, we discovered it had exits that Roathe could use to... wander.",shape=box,color=blue];
		j924841492 -> j845860967;
	j1013680237 [label="我相信我們之前見過面的，對嗎？",shape=box,color=blue];
		j1013680237 -> j3893739067;
		j1013680237 -> j454979609;
	j1282434218 [label="正是如此。",shape=box,color=blue];
		j1282434218 -> j454979609;
		j1282434218 -> j3893739067;
	j1424411030 [label="I am perhaps not the one you should ask. My grasp on the passage of time since then has become... convoluted. Though perhaps it is more accurate to say \"more convoluted.\" As though this could not get more horrifying...",shape=box,color=blue];
		j1424411030 -> j983124728;
		j1424411030 -> j4192580199;
	j2285690740 [label="Not all of the household objects. The chairs can sometimes be... well... never mind, please continue.",shape=box,color=red];
		j2285690740 -> j2060796665;
	j1803225520 [label="關於吉他的事我就不跟你說太多了。",shape=box,color=red];
		j1803225520 -> j1111475185;
	j4020450692 [label="Boolean LyonTime1 is now true.",color=orange];
		j4020450692 -> j2170811973;
	j1408773028 [label="Believe me, I know. And it is disconcerting, thank you. Although it seems every random household object in this place can speak.",shape=box,color=blue];
		j1408773028 -> j2285690740;
		j1408773028 -> j1803225520;
	j845860967 [label="Evaluate expressions",color=orange];
		j845860967 -> j790145832 [label="MarieRoathePastry1",color=purple];
		j845860967 -> j790145832 [label="RoatheMariePastry1",color=purple];
		j845860967 -> j1183455198 [label="false",color=purple];
	j2060796665 [label="If the word you were going to say was \"occupied,\" I have seen it as well, Drifter. That one that whispered. The one within the wall. I heard the tapping...",shape=box,color=blue];
		j2060796665 -> j1240223597;
	j1111475185 [label="Please, do. Though, I would find it far more comforting I think, to have a musical instrument be some transient demigod than... whatever else has come to haunt and abandon my mind. Is it strange, that I... ever since he...",shape=box,color=blue];
		j1111475185 -> j2295490611;
	j2170811973 [label="I am unsure if it is simply because of my unique sensitivity to the matter, or due to... the individual circumstances of my making, or... him -",shape=box,color=blue];
		j2170811973 -> j3244246651;
	j790145832 [label="So I've heard.",shape=box,color=red];
		j790145832 -> j1753336165;
	j1183455198 [label="噢？",shape=box,color=red];
		j1183455198 -> j2653498142;
	j1240223597 [label="There is a voice that has beaconed to me that I know I have not heard my entire life, yet stretches into my past and far into my future...",shape=box,color=blue];
		j1240223597 -> j1184503864;
	j2295490611 [label="他？",shape=box,color=red];
		j2295490611 -> j1240223597;
	j3244246651 [label="And I know you shall think me a right lunatic when I say this, but I do not experience time in a... purely... linear fashion.",shape=box,color=blue];
		j3244246651 -> j2809964260;
		j3244246651 -> j906338316;
	j1753336165 [label="I think it one of his few redeeming qualities. Not the theft, mind. The reasoning behind it. It is my theory he procured the illicit goods to goad Marie into conversations with him.",shape=box,color=blue];
		j1753336165 -> j191343899;
	j2653498142 [label="It is neither here nor there.",shape=box,color=blue];
		j2653498142 -> j2531492468;
		j2653498142 -> j4126901864;
	j1184503864 [label="It is not possible for it always to have been there. Yet I can recall it now, as clear as the silver light of Lua herself, behind the wall of my childhood home. A young man's voice. The presence of another standing beside him... \"Rap tap tap...\"",shape=box,color=blue];
		j1184503864 -> j4126661485;
	j2809964260 [label="「他」？「他」是誰？",shape=box,color=red];
		j2809964260 -> j1240223597;
	j906338316 [label="I experienced time for an untold number of centuries as looping spirals, Lyon.",shape=box,color=red];
		j906338316 -> j1831606356;
	j191343899 [label="And, perhaps, because they made her smile, when she thought he was not looking. Once, he said to me \"it is a great fault of fate that she has been so deprived of life.\"",shape=box,color=blue];
		j191343899 -> j3733610902;
	j2531492468 [label="How long did it take for you all to get back to... well, now?",shape=box,color=red];
		j2531492468 -> j2208366894;
	j4126901864 [label="之後發生了什麼事？",shape=box,color=red];
		j4126901864 -> j1779874582;
	j4126661485 [label="我……對不起。我要走了。我現在還不能說這件事。我……我很抱歉。請不要再問我這件事了。",shape=box,color=blue];
		j4126661485 -> j1538951312;
	j1831606356 [label="What say you then, when I speak of a voice that has beaconed to me beyond my own rational mind? I know I have not heard it my entire life. It is not possible for it to have always been there.",shape=box,color=blue];
		j1831606356 -> j4293391727;
	j3733610902 [label="Boolean LyonRoathePastry is now true.",color=orange];
		j3733610902 -> j3994039800;
		j3733610902 -> j2531492468;
	j2208366894 [label="I am perhaps not the one you should ask about how many years passed after we were turned into talking Infested amalgams. My grasp on the passage of time since then has been... convoluted.",shape=box,color=blue];
		j2208366894 -> j4192580199;
		j2208366894 -> j983124728;
	j1538951312 [label="里昂，等一下！",shape=box,color=red];
		j1538951312 -> j777162605;
	j4293391727 [label="Yet I can recall it now, as clear as the silver light of Lua herself, behind the wall of my childhood home. A young man's voice... \"Rap tap tap...\"",shape=box,color=blue];
		j4293391727 -> j4126661485;
	j3994039800 [label="That is on the verge of being adorable for him, you're right. What happened next?",shape=box,color=red];
		j3994039800 -> j1779874582;
