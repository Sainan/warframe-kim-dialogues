	edge [fontname="Roboto Condensed"];

	"LyonRank4Convo7 begins." [color=orange];
		"LyonRank4Convo7 begins." -> j1350926181;
	j1350926181 [label="漂泊者？我可以為一件事跟你道歉嗎？",shape=box,color=blue];
		j1350926181 -> j3329296292;
		j1350926181 -> j3643976444;
		j1350926181 -> j1350559949;
	j3329296292 [label="可以？是什麼？",shape=box,color=red];
		j3329296292 -> j3844892982;
	j3643976444 [label="里昂，你不需要這麼做的。你沒有做錯任何事。",shape=box,color=red];
		j3643976444 -> j2917039307;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j3844892982 [label="+5 Chemistry",color=orange];
		j3844892982 -> j2491259885;
	j2917039307 [label="雖然我很感激，但我仍然覺得虧欠了你。我會盡量長話短說，以免自己又在賣弄學識說話累贅。",shape=box,color=blue];
		j2917039307 -> j4183775311;
	"Chat ends." [color=orange];
	j2491259885 [label="謝謝。我會盡量長話短說，以免自己又在賣弄學識說話累贅。",shape=box,color=blue];
		j2491259885 -> j4183775311;
	j4183775311 [label="對我來說，與人交談很困難。尤其是在親密的交流中，比起通過冷冰冰的機器或是寫信，面對面交流更讓我不知所措。",shape=box,color=blue];
		j4183775311 -> j2145688611;
	j2145688611 [label="我不知道該如何形容 ─ 只能說……就像我拼命想抓住什麼東西，卻眼睜睜地看著灰塵從指縫間溜走。 ",shape=box,color=blue];
		j2145688611 -> j3572007381;
	j3572007381 [label="我常覺得自己像塊空白的畫布，在上面胡亂抹著油彩——徒勞地試圖勾勒出我腦海中所見圖像的輪廓。",shape=box,color=blue];
		j3572007381 -> j3354760944;
	j3354760944 [label="然而我越努力就越感到絕望。",shape=box,color=blue];
		j3354760944 -> j2888677045;
	j2888677045 [label="我越嘗試就越是失敗。所以我學會……什麼都不嘗試了。",shape=box,color=blue];
		j2888677045 -> j3668536442;
	j3668536442 [label="這就是我一開始躲避你的原因。也是為什麼我至今仍然……容易陷入獨處。我不知該如何表達。",shape=box,color=blue];
		j3668536442 -> j2638453701;
		j3668536442 -> j4236240311;
		j3668536442 -> j3785550151;
	j2638453701 [label="我永遠都願意有你靜靜地待在我身邊。",shape=box,color=red];
		j2638453701 -> j1508322294;
	j4236240311 [label="我有時候，也會這樣。沒關係的。",shape=box,color=red];
		j4236240311 -> j247802110;
	j3785550151 [label="我接受你的道歉。",shape=box,color=red];
		j3785550151 -> j262021105;
	j1508322294 [label="+15 Chemistry",color=orange];
		j1508322294 -> j3472622043;
	j247802110 [label="+15 Chemistry",color=orange];
		j247802110 -> j3290437390;
	j262021105 [label="+10 Chemistry",color=orange];
		j262021105 -> j3166017695;
	j3472622043 [label="我……會記得的。謝謝你，漂泊者。",shape=box,color=blue];
		j3472622043 -> j2331496732;
	j3290437390 [label="我之前沒意識到。我會記得不要再以為在這個世界上只有我孤身一人……謝謝你，漂泊者。",shape=box,color=blue];
		j3290437390 -> j2331496732;
	j3166017695 [label="當然。謝謝你，漂泊者。",shape=box,color=blue];
		j3166017695 -> j2331496732;
	j2331496732 [label="-里昂・阿拉德神父",shape=box,color=blue];
		j2331496732 -> "Chat ends.";
}