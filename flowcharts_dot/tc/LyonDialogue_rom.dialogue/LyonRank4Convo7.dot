	j1350926181 [label="漂泊者？我可以為一件事跟你道歉嗎？",shape=box,color=blue];
		j1350926181 -> j1608098080;
		j1350926181 -> j3837600252;
		j1350926181 -> j1350559949;
	j1608098080 [label="可以？是什麼？",shape=box,color=red];
		j1608098080 -> j996291522;
	j3837600252 [label="里昂，你不需要這麼做的。你沒有做錯任何事。",shape=box,color=red];
		j3837600252 -> j3142466096;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j996291522 [label="+5 Chemistry",color=orange];
		j996291522 -> j4115274018;
	j3142466096 [label="While I appreciate that, I do feel as though you are owed one all the same. I shall do my best to keep this brief, and not to overburden myself with needless erudition.",shape=box,color=blue];
		j3142466096 -> j3497555678;
	"Chat ends." [color=orange];
	j4115274018 [label="Thank you. I shall do my best to keep this brief, and not to overburden myself with needless erudition.",shape=box,color=blue];
		j4115274018 -> j3497555678;
	j3497555678 [label="Conversations are difficult for me. Far more so in intimate engagements than they are in these kinds of impersonal, mechanical ones or by post.",shape=box,color=blue];
		j3497555678 -> j3496470398;
	j3496470398 [label="我不知道該如何形容 ─ 只能說……就像我拼命想抓住什麼東西，卻眼睜睜地看著灰塵從指縫間溜走。 ",shape=box,color=blue];
		j3496470398 -> j3006784853;
	j3006784853 [label="It feels oft as though I am an empty scrap of canvas, smearing oil paints upon its surface - uselessly attempting create a shadow of an image that I can see in my mind's eye.",shape=box,color=blue];
		j3006784853 -> j3354760944;
	j3354760944 [label="然而我越努力就越感到絕望。",shape=box,color=blue];
		j3354760944 -> j2888677045;
	j2888677045 [label="我越嘗試就越是失敗。所以我學會……什麼都不嘗試了。",shape=box,color=blue];
		j2888677045 -> j3668536442;
	j3668536442 [label="這就是我一開始躲避你的原因。也是為什麼我至今仍然……容易陷入獨處。我不知該如何表達。",shape=box,color=blue];
		j3668536442 -> j1776758863;
		j3668536442 -> j3539141315;
		j3668536442 -> j1113732072;
	j1776758863 [label="我永遠都願意有你靜靜地待在我身邊。",shape=box,color=red];
		j1776758863 -> j1714684056;
	j3539141315 [label="我有時候，也會這樣。沒關係的。",shape=box,color=red];
		j3539141315 -> j3027810475;
	j1113732072 [label="我接受你的道歉。",shape=box,color=red];
		j1113732072 -> j1701913919;
	j1714684056 [label="+15 Chemistry",color=orange];
		j1714684056 -> j2065966826;
	j3027810475 [label="+15 Chemistry",color=orange];
		j3027810475 -> j4091511353;
	j1701913919 [label="+10 Chemistry",color=orange];
		j1701913919 -> j2130829246;
	j2065966826 [label="我……會記得的。謝謝你，漂泊者。",shape=box,color=blue];
		j2065966826 -> j944546954;
	j4091511353 [label="我之前沒意識到。我會記得不要再以為在這個世界上只有我孤身一人……謝謝你，漂泊者。",shape=box,color=blue];
		j4091511353 -> j944546954;
	j2130829246 [label="當然。謝謝你，漂泊者。",shape=box,color=blue];
		j2130829246 -> j944546954;
	j944546954 [label="-F. Lyon Allard",shape=box,color=blue];
		j944546954 -> "Chat ends.";
}