		j1073023867 -> j2316929123 [label="DrifterFaithNoMaybe",color=purple];
		j1073023867 -> j2880109334 [label="DrifterFaithNoMITW",color=purple];
		j1073023867 -> j2316929123 [label="DrifterFaithNoMITW",color=purple];
		j1073023867 -> j2316929123 [label="false",color=purple];
	j269395209 [label="我怕可以詳細討論的話題太多了。不過別誤會，我很樂意，只是不想讓你覺得無聊。你想從哪裡開始呢？",shape=box,color=blue];
		j269395209 -> j1799798489;
		j269395209 -> j1080942693;
	j2316929123 [label="不，我純粹好奇而已。",shape=box,color=red];
		j2316929123 -> j2305594065;
	j1780820145 [label="我有信仰。我的信仰跟你的很相似，雖然你可能認不出來。",shape=box,color=red];
		j1780820145 -> j1758482979;
	j2177494805 [label="我有信仰。不過，你肯定認不出我們的任何宗教習俗。",shape=box,color=red];
		j2177494805 -> j2184272291;
	j2139360463 [label="我有信教。這是一種我個人的信仰 ─ 它並沒有一個確切的名稱。",shape=box,color=red];
		j2139360463 -> j64239277;
	j1549053273 [label="我追隨太陽的腳步，就跟瑪麗一樣。",shape=box,color=red];
		j1549053273 -> j1537781347;
	j1067127305 [label="我和你一樣，也走上了太陰的道路。",shape=box,color=red];
		j1067127305 -> j1537781347;
	j3911732266 [label="我追隨聖光者的腳步，但我努力保持平衡的道路。",shape=box,color=red];
		j3911732266 -> j1537781347;
	j1936705856 [label="我相信冥冥之中一定有答案，但我不認為最終人們真的會知道答案。",shape=box,color=red];
		j1936705856 -> j3160779592;
	j1905039867 [label="我沒有信仰。我個人認為宗教是恐懼者的拐杖 ─ 無意冒犯。",shape=box,color=red];
		j1905039867 -> j473427326;
	j3321519530 [label="我沒有宗教。我不會說這世上絕對沒有宗教，但這並非我所擔憂的事。",shape=box,color=red];
		j3321519530 -> j400527975;
	j2880109334 [label="我沒有信仰。我認為所有的神 — 甚至包括漠然 — 都是我們想像的產物。無意冒犯。",shape=box,color=red];
		j2880109334 -> j2112458510;
	j1799798489 [label="你能給我講講你的假期嗎？",shape=box,color=red];
		j1799798489 -> j1466880850;
	j1080942693 [label="你能給我講講太陽和太陰嗎？",shape=box,color=red];
		j1080942693 -> j387070918;
	j2305594065 [label="Check boolean LyonSuspicious",color=orange];
		j2305594065 -> j3585855897 [label=true,color=green];
		j2305594065 -> j2118217225 [label=false,color=brown];
	j1758482979 [label="+20 Chemistry",color=orange];
		j1758482979 -> j2412437168;
	j2184272291 [label="+20 Chemistry",color=orange];
		j2184272291 -> j4168328066;
	j64239277 [label="請問你是如何形成如此個人化的信仰的？如果你不介意我問你的話？",shape=box,color=blue];
		j64239277 -> j624901760;
		j64239277 -> j2292206637;
		j64239277 -> j1073685743;
