		j1073023867 -> j2928370919 [label="DrifterFaithNoMaybe",color=purple];
		j1073023867 -> j2316929123 [label="DrifterFaithNoMaybe",color=purple];
		j1073023867 -> j921599227 [label="DrifterFaithNoMITW",color=purple];
		j1073023867 -> j2316929123 [label="DrifterFaithNoMITW",color=purple];
		j1073023867 -> j2316929123 [label="false",color=purple];
	j269395209 [label="我怕可以詳細討論的話題太多了。不過別誤會，我很樂意，只是不想讓你覺得無聊。你想從哪裡開始呢？",shape=box,color=blue];
		j269395209 -> j680352200;
		j269395209 -> j3647268522;
	j2316929123 [label="不，我純粹好奇而已。",shape=box,color=red];
		j2316929123 -> j2305594065;
	j4171086722 [label="我有信仰。我的信仰跟你的很相似，雖然你可能認不出來。",shape=box,color=red];
		j4171086722 -> j3731441545;
	j3987714450 [label="我有信仰。不過，你肯定認不出我們的任何宗教習俗。",shape=box,color=red];
		j3987714450 -> j147387221;
	j2139360463 [label="我有信教。這是一種我個人的信仰 ─ 它並沒有一個確切的名稱。",shape=box,color=red];
		j2139360463 -> j64239277;
	j1675719537 [label="我追隨太陽的腳步，就跟瑪麗一樣。",shape=box,color=red];
		j1675719537 -> j3172646158;
	j3788034195 [label="我和你一樣，也走上了太陰的道路。",shape=box,color=red];
		j3788034195 -> j3172646158;
	j2179608109 [label="我追隨聖光者的腳步，但我努力保持平衡的道路。",shape=box,color=red];
		j2179608109 -> j3172646158;
	j2907622215 [label="我相信冥冥之中一定有答案，但我不認為最終人們真的會知道答案。",shape=box,color=red];
		j2907622215 -> j658781235;
	j1905039867 [label="我沒有信仰。我個人認為宗教是恐懼者的拐杖 ─ 無意冒犯。",shape=box,color=red];
		j1905039867 -> j473427326;
	j2928370919 [label="我沒有宗教。我不會說這世上絕對沒有宗教，但這並非我所擔憂的事。",shape=box,color=red];
		j2928370919 -> j1418500908;
	j921599227 [label="我沒有信仰。我認為所有的神 — 甚至包括漠然 — 都是我們想像的產物。無意冒犯。",shape=box,color=red];
		j921599227 -> j2588779138;
	j680352200 [label="你能給我講講你的假期嗎？",shape=box,color=red];
		j680352200 -> j4070381960;
	j3647268522 [label="你能給我講講太陽和太陰嗎？",shape=box,color=red];
		j3647268522 -> j3144745297;
	j2305594065 [label="Check boolean LyonSuspicious",color=orange];
		j2305594065 -> j3585855897 [label=true,color=green];
		j2305594065 -> j2118217225 [label=false,color=brown];
	j3731441545 [label="+20 Chemistry",color=orange];
		j3731441545 -> j3371133297;
	j147387221 [label="+20 Chemistry",color=orange];
		j147387221 -> j2656796006;
	j64239277 [label="請問你是如何形成如此個人化的信仰的？如果你不介意我問你的話？",shape=box,color=blue];
		j64239277 -> j2074457076;
		j64239277 -> j2883286984;
		j64239277 -> j1269539464;
	j3172646158 [label="+20 Chemistry",color=orange];
		j3172646158 -> j2370053658;
	j658781235 [label="+20 Chemistry",color=orange];
		j658781235 -> j2025931377;
	j473427326 [label="+20 Chemistry",color=orange];
		j473427326 -> j1871931408;
	j1418500908 [label="+20 Chemistry",color=orange];
		j1418500908 -> j4217890106;
	j2588779138 [label="Boolean LyonMITW2 is now true.",color=orange];
		j2588779138 -> j337437913;
	j4070381960 [label="Boolean LyonLectureHolidays is now true.",color=orange];
		j4070381960 -> j1409924793;
	j3144745297 [label="Boolean LyonLectureSolLua is now true.",color=orange];
		j3144745297 -> j3913820152;
	j3585855897 [label="Boolean DrifterLiar is now true.",color=orange];
		j3585855897 -> j3951164;
	j2118217225 [label="Boolean LyonSuspicious is now true.",color=orange];
		j2118217225 -> j3951164;
	j3371133297 [label="I wonder how much our faiths influenced each other, intentionally or unintentionally as the case may be.",shape=box,color=blue];
		j3371133297 -> j1731662155;
	j2656796006 [label="Fascinating! as a scholar of the cloth, I do hope we have time to learn from one another at length of our respective beliefs.",shape=box,color=blue];
		j2656796006 -> j1731662155;
	j2074457076 [label="說來話長。",shape=box,color=red];
		j2074457076 -> j4256241725;
	j2883286984 [label="I studied a bunch of different religions, and none of them really suited me. I wound up with sort of a weird collection of humanity.",shape=box,color=red];
		j2883286984 -> j2873854866;
	j1269539464 [label="我相信自己的感覺。我不需要建築物或書來告訴我那是什麼。",shape=box,color=red];
		j1269539464 -> j2833363171;
	j2370053658 [label="Truly? I am... surprised. Surprised, but pleased. And it is no wonder you are curious, then. Our teachings must be so very foreign to what you know. So much time has passed.",shape=box,color=blue];
		j2370053658 -> j1731662155;
	j2025931377 [label="I respect that. There is honor in recognizing what we cannot know, in seeing the smallness of the human condition.",shape=box,color=blue];
		j2025931377 -> j1731662155;
	j1871931408 [label="相信我，我沒有生氣。在很多情況下，你的說法完全正確。",shape=box,color=blue];
		j1871931408 -> j3880671792;
		j1871931408 -> j2284503585;
	j4217890106 [label="I would admit I am jealous that you do not find cause to fret over what may wait for us beyond the veil. Would that more others did, our world would have known more peace in its days.",shape=box,color=blue];
		j4217890106 -> j1731662155;
	j337437913 [label="That is a topic over which I wish to talk with you at great length. Simply not now, at a time when I am not prepared for such a discussion.",shape=box,color=blue];
		j337437913 -> j1731662155;
	j1409924793 [label="這是一個明智的起點。瞭解一個文化，就如同瞭解它的靈魂。因為一個民族如何慶祝，就決定了他們將被後人銘記的方式。因為那些共同經歷的時刻，就是那些最珍貴的回憶。",shape=box,color=blue];
		j1409924793 -> j3090646825;
	j3913820152 [label="Of course. Let us begin with that which you may already know: Sol and Lua, the sun and the moon. They are deities who are forever transmutable in their aspects.",shape=box,color=blue];
		j3913820152 -> j3477967620;
	j3951164 [label="嗯。讓我來解答你的好奇心吧。為了避免讓你感到無聊，你想從哪裡開始呢？",shape=box,color=blue];
		j3951164 -> j3647268522;
		j3951164 -> j680352200;
	j1731662155 [label="我疏忽了，沒有跟著話題說。恐怕我已經遠遠偏離主題了。",shape=box,color=blue];
		j1731662155 -> j593607843;
	j4256241725 [label="+20 Chemistry",color=orange];
		j4256241725 -> j1992520764;
	j2873854866 [label="+20 Chemistry",color=orange];
		j2873854866 -> j1533802566;
	j2833363171 [label="+20 Chemistry",color=orange];
		j2833363171 -> j2535693632;
	j3880671792 [label="不過，這並不代表我對學習不感興趣。",shape=box,color=red];
		j3880671792 -> j893915209;
	j2284503585 [label="那你的情況又如何呢？",shape=box,color=red];
		j2284503585 -> j1297540298;
	j3090646825 [label="Our main and most common holidays are the Winter and Summer Solstices that mark the shortest and longest days of the year.",shape=box,color=blue];
		j3090646825 -> j1006894806;
	j3477967620 [label="Appearing in many forms over the centuries to many believers. Sometimes male, sometimes female. But always as Sol, the Sun, and Lua, the Moon.",shape=box,color=blue];
		j3477967620 -> j2825650989;
		j3477967620 -> j1691723119;
	j593607843 [label="You wished to know about the Luminary Orthodoxy, did you not? In order to avoid boring you to tears, where would you like to begin?",shape=box,color=blue];
		j593607843 -> j3647268522;
		j593607843 -> j680352200;
	j1992520764 [label="Mm. And one best told to a trusted friend. I understand completely. Besides which, you came to me for information, not the other way around.",shape=box,color=blue];
		j1992520764 -> j1731662155;
	j1533802566 [label="A stained glass window of the soul. Shattered when left apart, but what a beautiful image it paints when assembled.",shape=box,color=blue];
		j1533802566 -> j1731662155;
	j2535693632 [label="如果全世界都跟你有著一樣好信仰，世界將會變得更美好。",shape=box,color=blue];
		j2535693632 -> j1731662155;
	j893915209 [label="And for that, I laud your curiosity and scholarly nature. ",shape=box,color=blue];
		j893915209 -> j1731662155;
	j1297540298 [label="My case is... complex. But I will not lie and say that it has not been devoid of fear. Though religion has brought a flood of it into my life. It has never removed it.",shape=box,color=blue];
		j1297540298 -> j1731662155;
	j1006894806 [label="Both holidays are marked by great feasts, though they are delineated by whom you share the feasts with. Where the Winter Solstice is for sharing with family and close friends, the Summer Solstice is for strangers.",shape=box,color=blue];
		j1006894806 -> j2750950237;
		j1006894806 -> j3800122351;
	j2825650989 [label="Oh, that makes so much more sense now.",shape=box,color=red];
		j2825650989 -> j548800671;
	j1691723119 [label="[讓他繼續]",shape=box,color=red];
		j1691723119 -> j909654574;
	j2750950237 [label="真的嗎？跟我說說夏至吧。",shape=box,color=red];
		j2750950237 -> j1291961447;
	j3800122351 [label="多跟我說說冬至吧。",shape=box,color=red];
		j3800122351 -> j684431399;
	j548800671 [label="Yes, some sects can be a bit strict in their choice of iconography, declaring that Sol \"Must\" be one way or \"Must\" be another but the Orthodoxy does not recognize this as fact.",shape=box,color=blue];
		j548800671 -> j2958288033;
	j909654574 [label="Each of the Luminaries holds within them multiple aspects. Each aspect can be seen as a function of the whole. Lua, for example, is the mother, the maiden, the crone.",shape=box,color=blue];
		j909654574 -> j3731378977;
	j1291961447 [label="The Summer Solstice is for sharing great bounties and for bringing together strangers who have never met. You would gather in a field, bringing food and wares of your own making, it would not matter what.",shape=box,color=blue];
		j1291961447 -> j2896618745;
	j684431399 [label="The Winter Solstice is for bracing against the cold and cherishing those who warm us against the darkest times. You decorate a tree with candles, one light for each of those who have gone before who guide the way as the stars in the sky.",shape=box,color=blue];
		j684431399 -> j1389574110;
	j2958288033 [label="I expect that whatever has survived to this far-flung future has wound up being... a bit confused in its documentation of my religion.",shape=box,color=blue];
		j2958288033 -> j3344825619;
	j3731378977 [label="But Lua can also be He who guides souls along the river of tears to the endless night. Death himself. The harbinger and herald.",shape=box,color=blue];
		j3731378977 -> j2027385197;
	j2896618745 [label="Candles, or bread, or clothes, or paintings. Or books of poetry. Or wreaths of flowers. Even to come empty handed but \"with glad tidings\" is to be seen as a blessing.",shape=box,color=blue];
		j2896618745 -> j52566173;
	j1389574110 [label="And atop it, Sol himself, suffering atop the star tree in the darkness. Dimmed, but not forgotten. For this is the time of Lua. And we celebrate her in this time of shadow.",shape=box,color=blue];
		j1389574110 -> j333093705;
	j3344825619 [label="I find myself a living archaeological relic. How depressing. But I digress.",shape=box,color=blue];
		j3344825619 -> j909654574;
	j2027385197 [label="And in other sects, Death is an old veiled woman. It differs. But it speaks to the same spirit reaching out to all of us. The silvered hand that wishes to guide us in that last moment.",shape=box,color=blue];
		j2027385197 -> j4139900077;
	j52566173 [label="A celebration of life - laughter - music - sharing of all of these things, would commence during that, the longest of Sol's days. ",shape=box,color=blue];
		j52566173 -> j3131215254;
	j333093705 [label="And as we draw in close, and we feast upon a roasted bird and root vegetables and all that does not grow fresh in the frozen earth, we hold those that we love. And we tell stories of those that have gone.",shape=box,color=blue];
		j333093705 -> j3210860494;
	j4139900077 [label="The moon that slips over the sun during the eclipse, guiding us through the crossroads in that moment where all is lost.",shape=box,color=blue];
		j4139900077 -> j1402025786;
	j3131215254 [label="All were welcome to make new friends of strangers, and take home that which they needed.",shape=box,color=blue];
		j3131215254 -> j650819662;
	j3210860494 [label="We remember, on Lua's longest night, that she will guide us and our family through in the end.",shape=box,color=blue];
		j3210860494 -> j650819662;
	j1402025786 [label="Boolean DrifterEclipse is now true.",color=orange];
		j1402025786 -> j1704025367;
	j650819662 [label="But the most sacred of holidays to the Luminaries is The Summum Bonum. It is a rare event, when Sol and Lua align into a perfect eclipse.",shape=box,color=blue];
		j650819662 -> j88202600;
	j1704025367 [label="Check boolean VelimirEclipse",color=orange];
		j1704025367 -> j2264350474 [label=true,color=green];
		j1704025367 -> j3582331431 [label=false,color=brown];
	j88202600 [label="It is a wonderous and holy occasion, where all of nature responds. Have you had such luck as to witness it yourself?",shape=box,color=blue];
		j88202600 -> j1351788480;
	j2264350474 [label="等一下……",shape=box,color=red];
		j2264350474 -> j358866036;
	j3582331431 [label="Have you ever seen an eclipse yourself?",shape=box,color=red];
		j3582331431 -> j1841520923;
	j1351788480 [label="Boolean DrifterEclipse is now true.",color=orange];
		j1351788480 -> j2702204293;
	j358866036 [label="That sounds... really familiar.",shape=box,color=red];
		j358866036 -> j2874179201;
	j1841520923 [label="I have been blessed to witness it twice. And both times, I found it... transformative. If I could stay within that brief moment, suspended there forever, I would.",shape=box,color=blue];
		j1841520923 -> j3370750026;
	j2702204293 [label="Evaluate expressions",color=orange];
		j2702204293 -> j4284192412 [label="Megrim",color=purple];
		j2702204293 -> j2468608519 [label="Megrim",color=purple];
		j2702204293 -> j424862263 [label="Megrim",color=purple];
		j2702204293 -> j3204752403 [label="Megrim",color=purple];
		j2702204293 -> j981086510 [label="Megrim",color=purple];
		j2702204293 -> j4284192412 [label="Migraine",color=purple];
		j2702204293 -> j2468608519 [label="Migraine",color=purple];
		j2702204293 -> j424862263 [label="Migraine",color=purple];
		j2702204293 -> j3204752403 [label="Migraine",color=purple];
		j2702204293 -> j2541110455 [label="Migraine",color=purple];
		j2702204293 -> j4284192412 [label="false",color=purple];
		j2702204293 -> j2468608519 [label="false",color=purple];
		j2702204293 -> j424862263 [label="false",color=purple];
		j2702204293 -> j3204752403 [label="false",color=purple];
	j2874179201 [label="為什麼？",shape=box,color=blue];
		j2874179201 -> j1001114438;
	j3370750026 [label="我改天再跟你講我第一次親眼目睹的日蝕的故事。現在天色已晚，或許還很早，我也說不準。",shape=box,color=blue];
		j3370750026 -> j1544097519;
	j4284192412 [label="我沒有。",shape=box,color=red];
		j4284192412 -> j281742006;
	j2468608519 [label="我看過。感覺沒那麼厲害。",shape=box,color=red];
		j2468608519 -> j1135454135;
	j424862263 [label="我看過。還好。",shape=box,color=red];
		j424862263 -> j1135454135;
	j3204752403 [label="我看過。很漂亮。",shape=box,color=red];
		j3204752403 -> j1841520923;
	j981086510 [label="我看過。說出來你可能不信，它讓我得了嚴重的眼部週期性偏頭痛。不過，確實很漂亮。",shape=box,color=red];
		j981086510 -> j1985029912;
	j2541110455 [label="我看過。說出來你可能不信，它讓我得了嚴重的眼部偏頭痛。不過，確實很漂亮。",shape=box,color=red];
		j2541110455 -> j1985029912;
	j1001114438 [label="Does this phrase sound familiar to you: \"On empty crossroads, seek the eclipse - for when Sol and Lua align, the lost shall find their way home.\"",shape=box,color=red];
		j1001114438 -> j3378445911;
	j1544097519 [label="Boolean LyonFirstEclipse is now true.",color=orange];
		j1544097519 -> j1138883388;
		j1544097519 -> j4038185409;
	j281742006 [label="如果有機會，一定要去。",shape=box,color=blue];
		j281742006 -> j1841520923;
	j1135454135 [label="但願我也能像你一樣對這件事漠不關心……",shape=box,color=blue];
		j1135454135 -> j1841520923;
	j1985029912 [label="You must be touched by the Luminaries, and their presence overwhelmed you. Or perhaps they wished to smite you for some great sin. One of the other. Heh.",shape=box,color=blue];
		j1985029912 -> j20890549;
	j3378445911 [label="Celestines 18:19, from the Third Orthodox Book of Lua. Where in the name of the Luminaries did you hear it?",shape=box,color=blue];
		j3378445911 -> j3249252080;
		j3378445911 -> j1948390070;
	j1138883388 [label="你準備好隨時都可以。",shape=box,color=red];
		j1138883388 -> j3020243031;
	j4038185409 [label="我很期待。謝謝你的時間，里昂。",shape=box,color=red];
		j4038185409 -> j3020243031;
	j20890549 [label="Such is the way of the gods. Their signs can often be interpreted any which way.",shape=box,color=blue];
		j20890549 -> j3370750026;
	j3249252080 [label="說來話長。但毋庸置疑，我認為你們的一些經文現在已經被漠然所利用了。",shape=box,color=red];
		j3249252080 -> j962616468;
