		j2112458510 -> j791383782;
	j1466880850 [label="Boolean LyonLectureHolidays is now true.",color=orange];
		j1466880850 -> j691245080;
	j387070918 [label="Boolean LyonLectureSolLua is now true.",color=orange];
		j387070918 -> j677966681;
	j3585855897 [label="Boolean DrifterLiar is now true.",color=orange];
		j3585855897 -> j3951164;
	j2118217225 [label="Boolean LyonSuspicious is now true.",color=orange];
		j2118217225 -> j3951164;
	j2412437168 [label="我在想，我們的信仰在有心或無意之間究竟相互影響了多少。",shape=box,color=blue];
		j2412437168 -> j3756452216;
	j4168328066 [label="真有意思！作為一名宗教學者，我真心希望我們能有時間好好了解彼此的信仰。",shape=box,color=blue];
		j4168328066 -> j3756452216;
	j624901760 [label="說來話長。",shape=box,color=red];
		j624901760 -> j2617237919;
	j2292206637 [label="我研究過很多宗教，但沒有一個真正適合我。最後，我看到的是一大堆怪異、複雜的人。",shape=box,color=red];
		j2292206637 -> j759722301;
	j1073685743 [label="我相信自己的感覺。我不需要建築物或書來告訴我那是什麼。",shape=box,color=red];
		j1073685743 -> j2375315770;
	j877715525 [label="真的嗎？我有點……驚訝。驚訝之餘，也很高興。難怪你會好奇。我們的教義對你來說一定很陌生。時間過得太久了。",shape=box,color=blue];
		j877715525 -> j3756452216;
	j1770652428 [label="我很欣賞這一點。正視我們的無知，並意識到人類的虛弱與渺小，這本身就是一種榮譽。",shape=box,color=blue];
		j1770652428 -> j3756452216;
	j1871931408 [label="相信我，我沒有生氣。在很多情況下，你的說法完全正確。",shape=box,color=blue];
		j1871931408 -> j3034372827;
		j1871931408 -> j3840411740;
	j4205646965 [label="我承認，我羨慕你從不為死後的世界憂慮。要是更多人能這樣，我們的世界會和平得多。",shape=box,color=blue];
		j4205646965 -> j3756452216;
	j791383782 [label="這是一個我很想跟你深入討論的話題。只是現在還不是時候，我還沒準備好進行這樣的討論。",shape=box,color=blue];
		j791383782 -> j3756452216;
	j691245080 [label="這是一個明智的起點。瞭解一個文化，就如同瞭解它的靈魂。因為一個民族如何慶祝，就決定了他們將被後人銘記的方式。因為那些共同經歷的時刻，就是那些最珍貴的回憶。",shape=box,color=blue];
		j691245080 -> j3107247901;
	j677966681 [label="當然。我們先從你可能知道的說起：太陽和太陰。他們是永恆變化的神祇。",shape=box,color=blue];
		j677966681 -> j2360725196;
	j3951164 [label="嗯。讓我來解答你的好奇心吧。為了避免讓你感到無聊，你想從哪裡開始呢？",shape=box,color=blue];
		j3951164 -> j1080942693;
		j3951164 -> j1799798489;
	j3756452216 [label="我疏忽了，沒有跟著話題說。恐怕我已經遠遠偏離主題了。",shape=box,color=blue];
		j3756452216 -> j1309902763;
	j2617237919 [label="+20 Chemistry",color=orange];
		j2617237919 -> j3416711061;
	j759722301 [label="+20 Chemistry",color=orange];
		j759722301 -> j3071272983;
	j2375315770 [label="+20 Chemistry",color=orange];
		j2375315770 -> j1927179949;
	j3034372827 [label="不過，這並不代表我對學習不感興趣。",shape=box,color=red];
		j3034372827 -> j1315483382;
	j3840411740 [label="那你的情況又如何呢？",shape=box,color=red];
		j3840411740 -> j4036296087;
	j3107247901 [label="我們最主要又最常見的節日是冬至和夏至，那標誌了一年晝夜最短與最長之日。",shape=box,color=blue];
		j3107247901 -> j2350158499;
	j2360725196 [label="祂們在幾個世紀以來以許多形式顯現在信徒面前。時為男相，時為女相。但永遠是日尊，太陽；太陰，月亮。",shape=box,color=blue];
		j2360725196 -> j3114241239;
		j2360725196 -> j262190382;
	j1309902763 [label="你是想知道聖光會正統的事，對吧？為了避免你無聊到哭出來，你想從哪裡開始呢？",shape=box,color=blue];
		j1309902763 -> j1080942693;
		j1309902763 -> j1799798489;
	j3416711061 [label="嗯。這種事最好跟信任的朋友說。我完全理解。再說，是你來找我問情報，不是我來找你的。",shape=box,color=blue];
		j3416711061 -> j3756452216;
	j3071272983 [label="靈魂如同彩繪玻璃窗。離散則碎，然而組合起來之時所描繪之景象何其美麗。",shape=box,color=blue];
		j3071272983 -> j3756452216;
	j1927179949 [label="如果全世界都跟你有著一樣好信仰，世界將會變得更美好。",shape=box,color=blue];
		j1927179949 -> j3756452216;
	j1315483382 [label="為此，我讚揚你的好奇心和求知欲。",shape=box,color=blue];
		j1315483382 -> j3756452216;
	j4036296087 [label="我的情況……很複雜。但我不能騙你說我從沒感到恐懼。宗教為我的生命帶來無盡恐懼，卻從未將其消除。",shape=box,color=blue];
		j4036296087 -> j3756452216;
	j2350158499 [label="這兩個節日都有盛大的宴會，區分在於共饗的對象。冬至之宴旨在與親友團聚，而夏至之宴則專為陌生人而設。",shape=box,color=blue];
		j2350158499 -> j2770587403;
		j2350158499 -> j2912017153;
	j3114241239 [label="哦，現在合理多了。",shape=box,color=red];
		j3114241239 -> j1833656708;
	j262190382 [label="[讓他繼續]",shape=box,color=red];
		j262190382 -> j2778563670;
	j2770587403 [label="真的嗎？跟我說說夏至吧。",shape=box,color=red];
		j2770587403 -> j878855425;
	j2912017153 [label="多跟我說說冬至吧。",shape=box,color=red];
		j2912017153 -> j1416920905;
	j1833656708 [label="是的，有些教派對聖像的選擇會比較嚴格，堅稱太陽「必須」是某個樣子，但正統教派不認為這是事實。",shape=box,color=blue];
		j1833656708 -> j3131703300;
	j2778563670 [label="聖光會的的神祇是蘊藏多重面向的。每個面向皆可視為整體的一項職能。例如，月尊既為母親，也為少女，亦為老嫗。",shape=box,color=blue];
		j2778563670 -> j1620789726;
	j878855425 [label="夏至是為了分享豐盛的收穫，並聚集從未見面的陌生人。人們會聚集在田野中，帶著自己製作的食物或物品，帶什麼來並不重要。",shape=box,color=blue];
		j878855425 -> j1777967349;
	j1416920905 [label="冬至是為了抵禦嚴寒，並珍惜那些在最黑暗時期給予我們溫暖的人。人們會用蠟燭裝飾樹木，一盞燈代表一位先逝之人，他們如同天上的星辰，引領前路。",shape=box,color=blue];
		j1416920905 -> j2500401033;
	j3131703300 [label="我估計，任何流傳至如此遙遠未來的文獻，對於我們信仰的記載多少會有點……混亂吧。",shape=box,color=blue];
		j3131703300 -> j3329222303;
	j1620789726 [label="但太陰也可以是那位引導靈魂沿著淚河走向無盡長夜的神祇。祂就是死亡本身。也是先驅亦為使者。",shape=box,color=blue];
		j1620789726 -> j42480838;
	j1777967349 [label="蠟燭、麵包、衣物、畫作。詩集也可以。花環也是。即使空手而至但「帶來佳音」，也會被視為一種祝福。。",shape=box,color=blue];
		j1777967349 -> j4083674239;
	j2500401033 [label="在樹頂之上，日尊於星辰之樹上受難。祂的光芒雖黯淡，卻未曾被遺忘。因為這是太陰的時代。在這陰影籠罩的時刻，我們頌揚著她。",shape=box,color=blue];
		j2500401033 -> j445360844;
	j3329222303 [label="我發現自己竟成了活著的古董。真讓人沮喪。不過，我離題了。",shape=box,color=blue];
		j3329222303 -> j2778563670;
	j42480838 [label="在其他教派中，死亡是一位蒙著面紗的老婦。雖然形象或有所不同，但都代表著那隻伸向我們所有人的聖靈。那隻在我們臨終之際願引導我們的銀手。",shape=box,color=blue];
		j42480838 -> j2077974810;
	j4083674239 [label="在白晝最長的那一日，一場歌頌生命的慶典將拉開序幕——歡笑、音樂，分享一切美好的事物。",shape=box,color=blue];
		j4083674239 -> j3567866775;
	j445360844 [label="當我們聚在一起，享用烤禽、根莖蔬菜，以及所有在冰凍大地中無法新鮮生長的食物時，我們緊抱著所愛之人。然後講述逝去者的故事。",shape=box,color=blue];
		j445360844 -> j2956451667;
	j2077974810 [label="日蝕之時，月亮會悄然滑過太陽，在看似一切都已失去的十字路口上指引著我們前進。",shape=box,color=blue];
		j2077974810 -> j1402025786;
	j3567866775 [label="所有人都受到歡迎以結交新的陌生朋友，並將他們需要的東西帶回家。",shape=box,color=blue];
		j3567866775 -> j701813258;
	j2956451667 [label="在太陰最漫長的夜晚，我們會謹記，最終祂將會引導我們和我們的家人度過難關。",shape=box,color=blue];
		j2956451667 -> j701813258;
	j1402025786 [label="Boolean DrifterEclipse is now true.",color=orange];
		j1402025786 -> j1704025367;
	j701813258 [label="但是對於聖光會信徒來說，最神聖的節日是至善日。這是一個罕見的現象，即太陽與太陰完美對齊，形成日蝕。",shape=box,color=blue];
		j701813258 -> j3499218790;
	j1704025367 [label="Check boolean VelimirEclipse",color=orange];
		j1704025367 -> j791722496 [label=true,color=green];
		j1704025367 -> j2487179768 [label=false,color=brown];
	j3499218790 [label="這是一個奇妙而神聖的景象，大自然與萬物皆有所回應。你有幸親眼見證過嗎？",shape=box,color=blue];
		j3499218790 -> j1351788480;
	j791722496 [label="等一下……",shape=box,color=red];
		j791722496 -> j674992407;
	j2487179768 [label="你有親眼見過日食嗎？",shape=box,color=red];
		j2487179768 -> j3864090489;
	j1351788480 [label="Boolean DrifterEclipse is now true.",color=orange];
		j1351788480 -> j2702204293;
	j674992407 [label="聽起來……很熟悉。",shape=box,color=red];
		j674992407 -> j2140865761;
	j3864090489 [label="我有幸親眼目睹過兩次。兩次我都覺得它……震撼人心。如果我可以永遠停留在那個短暫的瞬間，我願意。",shape=box,color=blue];
		j3864090489 -> j3370750026;
	j2702204293 [label="Evaluate expressions",color=orange];
		j2702204293 -> j2199664663 [label="Megrim",color=purple];
		j2702204293 -> j4023119022 [label="Megrim",color=purple];
		j2702204293 -> j2694888542 [label="Megrim",color=purple];
		j2702204293 -> j288572241 [label="Megrim",color=purple];
		j2702204293 -> j2536130101 [label="Megrim",color=purple];
		j2702204293 -> j2199664663 [label="Migraine",color=purple];
		j2702204293 -> j4023119022 [label="Migraine",color=purple];
		j2702204293 -> j2694888542 [label="Migraine",color=purple];
		j2702204293 -> j288572241 [label="Migraine",color=purple];
		j2702204293 -> j4205752935 [label="Migraine",color=purple];
		j2702204293 -> j2199664663 [label="false",color=purple];
		j2702204293 -> j4023119022 [label="false",color=purple];
		j2702204293 -> j2694888542 [label="false",color=purple];
		j2702204293 -> j288572241 [label="false",color=purple];
	j2140865761 [label="為什麼？",shape=box,color=blue];
		j2140865761 -> j986426735;
	j3370750026 [label="我改天再跟你講我第一次親眼目睹的日蝕的故事。現在天色已晚，或許還很早，我也說不準。",shape=box,color=blue];
