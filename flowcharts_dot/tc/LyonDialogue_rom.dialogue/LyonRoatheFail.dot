	"LyonRoatheFail begins." [color=orange];
		"LyonRoatheFail begins." -> j628946987;
		"LyonRoatheFail begins." -> j1350559949;
	j628946987 [label="里昂，我需要你在羅瑟的事情上幫忙。",shape=box,color=red];
		j628946987 -> j421763245;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j421763245 [label="Check boolean LyonDating",color=orange];
		j421763245 -> j93446840 [label=true,color=green];
		j421763245 -> j1445122282 [label=false,color=brown];
	"Chat ends." [color=orange];
	j93446840 [label="如果我能做任何事情來協助，我會去做，我的奇蹟。你們兩個之間似乎出了什麼問題？",shape=box,color=blue];
		j93446840 -> j477154082;
	j1445122282 [label="如果我能做任何事情來協助，我會去做，我的朋友。你們兩個之間似乎出了什麼問題？",shape=box,color=blue];
		j1445122282 -> j477154082;
	j477154082 [label="Evaluate expressions",color=orange];
		j477154082 -> j1121867556 [label="RoatheFail",color=purple];
		j477154082 -> j1121867556 [label="RoatheFailStall",color=purple];
		j477154082 -> j2383528687 [label="RoatheFailUltimate",color=purple];
		j477154082 -> j3396776213 [label="RoatheFailNot21",color=purple];
		j477154082 -> j1392772592 [label="RoatheFailUnloved",color=purple];
		j477154082 -> j1121867556 [label="RoatheRepair1",color=purple];
		j477154082 -> j1121867556 [label="false",color=purple];
	j1121867556 [label="羅瑟一直在面對他……嗯……服用血清的真相。我不知道怎麼回事，但我覺得我在幫助他度過這件事時做得很糟糕。",shape=box,color=red];
		j1121867556 -> j921311801;
	j2383528687 [label="我不確定。我想我說了不該說的話。",shape=box,color=red];
		j2383528687 -> j2432332334;
	j3396776213 [label="他告訴我不要再深入他的記憶。所以我沒有。現在我們似乎……卡住了？",shape=box,color=red];
		j3396776213 -> j2197350071;
	j1392772592 [label="我告訴他我只是為了隨性陪伴才和他在一起，儘管他似乎對此沒有問題，但現在我覺得我們的關係倒退了。",shape=box,color=red];
		j1392772592 -> j2432332334;
	j921311801 [label="我明白了。當一個人的過去行為被新的視角重新審視時，要和解可能是件困難的事。我詛咒源拓氏強迫他，以及我們，陷入這種可恥的境地。",shape=box,color=blue];
		j921311801 -> j2601671120;
	j2432332334 [label="我明白了。恐怕我必須告訴你，在這件事上我能做的很少，因為你正在經歷「自食其果」的後果。",shape=box,color=blue];
		j2432332334 -> j3404317905;
	j2197350071 [label="我明白了。有時候，按照一個人的最佳意願行事與完全按照他們的要求行事並不相同。",shape=box,color=blue];
		j2197350071 -> j870901059;
	j2601671120 [label="我會盡我所能說服他聽你的話。但我必須建議你準備更好的論據，說明為什麼他的行為不該被視為懦弱。",shape=box,color=blue];
		j2601671120 -> j1737972067;
	j3404317905 [label="以如此冷酷無情的方式行事必然會導致相應的報應。特別是當你面對的是像羅瑟這樣的人時。",shape=box,color=blue];
		j3404317905 -> j3475981319;
	j870901059 [label="這是我們必須做的可怕事，違背某人的意願，特別是在翻閱他們的私人記憶和思想這類事情上。",shape=box,color=blue];
		j870901059 -> j268900225;
	j1737972067 [label="因為我知道那就是從內而外吞噬他的東西。",shape=box,color=blue];
		j1737972067 -> j558081994;
	j3475981319 [label="我不知道你有什麼辦法糾正事情。但恕我直言，我不認為你能從瑪麗或我這裡得到幫助。",shape=box,color=blue];
		j3475981319 -> j1347471990;
	j268900225 [label="我詛咒源拓氏強迫他，以及我們自己，陷入如此可恥的境地。",shape=box,color=blue];
		j268900225 -> j4156312246;
	j558081994 [label="Boolean LyonRoatheFailFix is now true.",color=orange];
		j558081994 -> j618688711;
	j1347471990 [label="也許此時最好尋求其他選擇。",shape=box,color=blue];
		j1347471990 -> "Chat ends.";
	j4156312246 [label="但在我看來，幫助他的唯一方法，不幸的是，就是這樣做。並繼續探索墮落淵獄，直到每一段記憶都被發掘。",shape=box,color=blue];
		j4156312246 -> j2585965033;
	j618688711 [label="Check boolean MarieRoatheFailFix",color=orange];
		j618688711 -> j3598202760 [label=true,color=green];
		j618688711 -> j3737409562 [label=false,color=brown];
	j2585965033 [label="無論惡魔如何抗議。",shape=box,color=blue];
		j2585965033 -> "Chat ends.";
	j3598202760 [label="看來你已經得到瑪麗的協助來說服他了。我很佩服。這兩人之間可沒什麼好感。",shape=box,color=blue];
		j3598202760 -> j2453908006;
	j3737409562 [label="我知道在這件事上我們也需要瑪麗的協助。她可能更難說服，因為你知道他們兩個之間沒什麼情誼可言。",shape=box,color=blue];
		j3737409562 -> j342673702;
	j2453908006 [label="那麼，我想我們可以開始了。",shape=box,color=blue];
		j2453908006 -> "Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue";
	j342673702 [label="願太陰引導你。",shape=box,color=blue];
		j342673702 -> "Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	"Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue" [label="Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue",color=orange];
		"Initiate conversation RoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/RoatheDialogue_rom.dialogue" -> "Chat ends.";
	"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
		"Initiate conversation MarieRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" -> "Chat ends.";
}