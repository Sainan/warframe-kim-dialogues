digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LyonRank3Convo3 begins." [color=orange];
		"LyonRank3Convo3 begins." -> j2000312437;
	j2000312437 [label="我當時在 Loid 先生的圖書館幫忙，把書放回書架上，但他堅持說那些奇特的飛行器……也能完成這項工作 —",shape=box,color=blue];
		j2000312437 -> j3042588122;
	j3042588122 [label="我無意中發現了一本奇特的書，書中詳細講述了由尤拉瑞亞．源拓氏所創作的虛構世界中的兒童故事。",shape=box,color=blue];
		j3042588122 -> j2123331396;
	j2123331396 [label="留意到作者的姓氏跟我們「日曜主教」的真名相同，我立刻把這本書留給自己。",shape=box,color=blue];
		j2123331396 -> j1616205315;
		j2123331396 -> j2518941918;
		j2123331396 -> j3102889003;
	j1616205315 [label="我想我知道你指的是哪本書了……",shape=box,color=red];
		j1616205315 -> j1021543373;
	j2518941918 [label="拜托我們可以跳過開場白嗎？你想知道什麼就問吧。",shape=box,color=red];
		j2518941918 -> j1904568226;
	j3102889003 [label="[無視]",shape=box,color=red];
		j3102889003 -> "Chat ends.";
	j1021543373 [label="+5 Chemistry",color=orange];
		j1021543373 -> j2844621147;
	j1904568226 [label="Boolean LyonMITW1 is now true.",color=orange];
		j1904568226 -> j3725388008;
	"Chat ends." [color=orange];
	j2844621147 [label="從 Loid 先生驚恐的表情以及他堅持讓我立即退還這本書，「免得讓你不高興」來看，我懷疑你確實知道一些內情。",shape=box,color=blue];
		j2844621147 -> j3731907097;
	j3725388008 [label="我的問題跟「概念式體現」的本質有關。看完之後，我明白這本書的目的是教導孩子如何避免自己的情緒跟虛空互動。",shape=box,color=blue];
		j3725388008 -> j1196263293;
		j3725388008 -> j2556380228;
	j3731907097 [label="《渡域故事集》。雖然我從 Loid 先生那裡得到了相當……疲憊和漫長的解釋，說明你所遭受的苦難，但我還有一件事想問一下。",shape=box,color=blue];
		j3731907097 -> j368852386;
	j1196263293 [label="作用不大，對我而言更是如此。",shape=box,color=red];
		j1196263293 -> j1406217329;
	j2556380228 [label="強烈的情緒跟虛空互動會造成……嚴重的問題。",shape=box,color=red];
		j2556380228 -> j883022820;
	j368852386 [label="對，但，前提是這樣做不會太麻煩？",shape=box,color=blue];
		j368852386 -> j2799187275;
		j368852386 -> j1611947401;
	j1406217329 [label="我們生活中有多少東西是別人強加給我們的，並被當作事實來教導我們，但經試驗後卻被證明毫無用處？",shape=box,color=blue];
		j1406217329 -> j767421245;
	j883022820 [label="看來確實如此。我見過參研者。我聽過虛空天使。我親耳聽過喃喃者。 ",shape=box,color=blue];
		j883022820 -> j440256791;
	j2799187275 [label="不會。你繼續吧。",shape=box,color=red];
		j2799187275 -> j1904568226;
	j1611947401 [label="這完全取決於實際情況。我完全不知道你想問我什麼。",shape=box,color=red];
		j1611947401 -> j3891242203;
	j767421245 [label="Boolean LyonFaith1 is now true.",color=orange];
		j767421245 -> j2961741979;
	j440256791 [label="這就是我好奇的本質。我之所以「說出來」這個問題，是想看看你是否能闡述。當虛空被賦予形態時，從中出來的是什麼 — 它們是「真實」的嗎？",shape=box,color=blue];
		j440256791 -> j907603552;
		j440256791 -> j635392556;
		j440256791 -> j802529226;
	j3891242203 [label="+5 Chemistry",color=orange];
		j3891242203 -> j2585228119;
	j2961741979 [label="我常常好奇為什麼要用這些毫無用處的謊言蒙騙別人？他們是為了追求權力？影響力嗎？還是他們真的相信自己所說的話，對自己的謊言渾然不自知？",shape=box,color=blue];
		j2961741979 -> j3324256888;
		j2961741979 -> j1869130216;
	j907603552 [label="不，我認為虛空所創造的一切都只是……暫時性的。是創造它的存在或事物的碎片。是記憶的幽靈。",shape=box,color=red];
		j907603552 -> j304251276;
	j635392556 [label="是的，我相信是。就像藝術家創作的一幅畫，它可能源自於某人的想像，但一旦創作完成，它就是真實的。",shape=box,color=red];
		j635392556 -> j954993402;
	j802529226 [label="這完全取決於你對「真實」的定義了。",shape=box,color=red];
		j802529226 -> j736048994;
	j2585228119 [label="是的，原諒我。我不太擅長……直接溝通，尤其是不擅長用這種奇怪的方式。但我現在會努力嘗試。",shape=box,color=blue];
		j2585228119 -> j1904568226;
	j3324256888 [label="我認為尤拉瑞亞．源拓氏的本意是希望她寫的東西有用。只是在我需要的時候，它並沒有幫助到我。",shape=box,color=red];
		j3324256888 -> j1612028455;
	j1869130216 [label="我不知道。里昂，你腦子裡都裝著哪些謊言呢？",shape=box,color=red];
		j1869130216 -> j3398706369;
	j304251276 [label="那麼，虛空中的這些元素所造成的影響不是「真實」的嗎？",shape=box,color=blue];
		j304251276 -> j552195611;
	j954993402 [label="但你用的這個比喻不太準確，對吧？從虛空中提取的物質難道最終不會回歸虛空嗎？",shape=box,color=blue];
		j954993402 -> j2334314865;
	j736048994 [label="+5 Chemistry",color=orange];
		j736048994 -> j2469905731;
	j1612028455 [label="要替她說話的是，我接觸虛空的時間遠遠超過了她希望這本書作為指導的時間。",shape=box,color=red];
		j1612028455 -> j330173591;
	j3398706369 [label="不是我來找你討論的事情。",shape=box,color=blue];
		j3398706369 -> "Chat ends.";
	j552195611 [label="許多回憶都曾經使人酗酒，甚至令他們結束自己的生命。難道這些回憶就不是「真實」的嗎？",shape=box,color=blue];
		j552195611 -> j1394647791;
	j2334314865 [label="很好，這是個想法。詩歌或歌曲即使沒有被寫下來，但仍然存在。",shape=box,color=red];
		j2334314865 -> j2572075116;
	j2469905731 [label="你可以詳細說明一下嗎？",shape=box,color=blue];
		j2469905731 -> j72891012;
	j330173591 [label="+5 Chemistry",color=orange];
		j330173591 -> j1123394727;
	j1394647791 [label="但我的論點是，那些都是他發自內在的力量，不是外在的力量。",shape=box,color=red];
		j1394647791 -> j2487775255;
	j2572075116 [label="但如果它被遺忘，就不存在了。一段被時間遺忘的故事就會永遠消失。",shape=box,color=blue];
		j2572075116 -> j2235390320;
	j72891012 [label="你如何衡量「真實性」？",shape=box,color=red];
		j72891012 -> j650173880;
		j72891012 -> j3651256316;
		j72891012 -> j1073141617;
	j1123394727 [label="對於他人作惡的原因，不幸的無知或許是人們所能抱持的最大希望。",shape=box,color=blue];
		j1123394727 -> j1602749812;
	j2487775255 [label="但我的問題是，有什麼分別？如果最終結果相同，又有關係嗎？",shape=box,color=blue];
		j2487775255 -> j857908886;
		j2487775255 -> j1991248693;
		j2487775255 -> j1247455109;
	j2235390320 [label="一場由發動者自身思想催生的革命，是一把非常鈍的劍。",shape=box,color=blue];
		j2235390320 -> j857908886;
		j2235390320 -> j1991248693;
		j2235390320 -> j1247455109;
	j650173880 [label="憑物理上的永恆？憑重量和質量？來自虛空之物只是暫時存在在這裏。",shape=box,color=red];
		j650173880 -> j3343238226;
	j3651256316 [label="它對歷史發展的影響是什麼？來自虛空的事物已經改變了歷史的路徑。",shape=box,color=red];
		j3651256316 -> j1736935616;
	j1073141617 [label="是根據它對其他人的影響？來自虛空的「事物」的影響無疑產生了這種效果。",shape=box,color=red];
		j1073141617 -> j3653120277;
	j1602749812 [label="然而，我的好奇心並非在於這本書本身或它有用與否。請容許我抒發一下詩意。",shape=box,color=blue];
		j1602749812 -> j2448647606;
	j857908886 [label="你不是在問它們是否「真實」，而是在問它們是否「確實」，是否應該被承認或否定。",shape=box,color=red];
		j857908886 -> j3010408222;
	j1991248693 [label="那我要問，就因為你們無法跟太陽或太陰握手你們的「聖光者」是否「真實」的。",shape=box,color=red];
		j1991248693 -> j3177984322;
	j1247455109 [label="你轉彎抹角地問，虛空中的所有「事物」在這裏存在是否僅僅是因為我們用意志力將它們創造出來的。",shape=box,color=red];
		j1247455109 -> j1858933350;
	j3343238226 [label="你的意思是，來自虛空的事物最終將回歸虛空？但虛空，從定義上來說，不就是由虛無構成的嗎？",shape=box,color=blue];
		j3343238226 -> j2880432577;
	j1736935616 [label="有道理。難道僅僅因為革命無法被量化，就不是「真正的」革命嗎？",shape=box,color=blue];
		j1736935616 -> j3653120277;
	j3653120277 [label="它確實是奪走了許多人的生命。他們會極力辯稱它的合理性。然而，想想以下幾點：",shape=box,color=blue];
		j3653120277 -> j2561045342;
	j2448647606 [label="我之所以「說出來」這個問題，是想看看你是否能闡述。當虛空被賦予形態時，從中出來的是什麼 — 它們是「真實」的嗎？",shape=box,color=blue];
		j2448647606 -> j907603552;
		j2448647606 -> j802529226;
		j2448647606 -> j635392556;
	j3010408222 [label="+5 Chemistry",color=orange];
		j3010408222 -> j2841512444;
	j3177984322 [label="我們討論的不是聖光者。是虛空。",shape=box,color=blue];
		j3177984322 -> j3736750481;
		j3177984322 -> j307996113;
		j3177984322 -> j3512533358;
		j3177984322 -> j2415878867;
	j1858933350 [label="+5 Chemistry",color=orange];
		j1858933350 -> j2636486904;
	j2880432577 [label="我想是吧？我接觸過的虛空部分似乎都被我們留下印記。我們已經賦予了它某種形狀或形態。或者說，我們已經模糊了現實之間的界線。",shape=box,color=red];
		j2880432577 -> j1778889595;
		j2880432577 -> j49210753;
	j2561045342 [label="一場革命只有在發動革命的人心中存在時才具意義。",shape=box,color=blue];
		j2561045342 -> j2640700773;
	j2841512444 [label="是的，我想你可以這麼說。我們應該對縈繞在我們大廳的幽靈視而不見嗎？還是說，如果我們對他們給予關注，反而會助長他們的氣焰？",shape=box,color=blue];
		j2841512444 -> j3736750481;
		j2841512444 -> j307996113;
		j2841512444 -> j3512533358;
		j2841512444 -> j2415878867;
	j3736750481 [label="我認為我們目前面臨的挑戰是危險的。極度危險。我們應該以對待危險的態度來對待它們。",shape=box,color=red];
		j3736750481 -> j309579261;
	j307996113 [label="鬼魂真實得足以帶給我們痛苦。但他們無法以子彈消滅。至少我還沒找到能做到這一點的子彈。",shape=box,color=red];
		j307996113 -> j3737640055;
	j3512533358 [label="這到底是怎麼回事，里昂？真的？",shape=box,color=red];
		j3512533358 -> j1923096737;
	j2415878867 [label="我……真的不知道，里昂。我希望我知道。",shape=box,color=red];
		j2415878867 -> j3275269396;
	j2636486904 [label="是的，我想你可以這樣說。我們怎麼能確定我們沒有……顯露出我們自己的魔鬼呢？",shape=box,color=blue];
		j2636486904 -> j3736750481;
		j2636486904 -> j307996113;
		j2636486904 -> j3512533358;
		j2636486904 -> j2415878867;
	j1778889595 [label="整個結構，甚至包括太陰本身，都曾被放入虛空並被取回。因此並非僅僅因為存在於虛空中就會令物質消失。",shape=box,color=red];
		j1778889595 -> j1978597428;
	j49210753 [label="你的意思是存在一個「更深的」虛空，在那裏任何東西都無法存在，對此我真的沒有答案。",shape=box,color=red];
		j49210753 -> j1853322423;
	j2640700773 [label="如果它從周圍所有人的記憶中消失，它就會不再存在，不是嗎？",shape=box,color=blue];
		j2640700773 -> j1991248693;
		j2640700773 -> j857908886;
		j2640700773 -> j1247455109;
	j309579261 [label="Boolean LyonReal1 is now true.",color=orange];
		j309579261 -> j699785798;
	j3737640055 [label="Boolean LyonFake1 is now true.",color=orange];
		j3737640055 -> j1123540714;
	j1923096737 [label="Boolean LyonFaith1 is now true.",color=orange];
		j1923096737 -> j48533299;
	j3275269396 [label="你老實自己不知道的事情，這種坦誠令人耳目一新。但願更多的人都能擁有這樣的特質。",shape=box,color=blue];
		j3275269396 -> j3053143976;
	j1978597428 [label="我不在乎那些被放入虛空又被取回的東西。我在乎的是那些完全憑空從虛空中創造出來的東西。",shape=box,color=blue];
		j1978597428 -> j857908886;
		j1978597428 -> j1991248693;
		j1978597428 -> j1247455109;
	j1853322423 [label="我謝謝你的坦誠。或許我對那些不能存在的事物，而不是現已存在的事物更感興趣。",shape=box,color=blue];
		j1853322423 -> j857908886;
		j1853322423 -> j1991248693;
		j1853322423 -> j1247455109;
	j699785798 [label="是的，我想你應該知道哪些東西可以以武力從虛空中擊落而哪些不能……",shape=box,color=blue];
		j699785798 -> j1776624782;
	j1123540714 [label="或許這就是為什麼那麼多人沉溺……為了止住那看不見卻隱隱作痛的傷口。這傷口是可以治癒的，但靠的是心靈的力量，而非武器。",shape=box,color=blue];
		j1123540714 -> j1776624782;
	j48533299 [label="我顯然完全搞錯了。我們改天再討論。原諒我的打擾。",shape=box,color=blue];
		j48533299 -> j2331496732;
	j3053143976 [label="但依然，我對這件事的看法未完全有定論。",shape=box,color=blue];
		j3053143976 -> j48533299;
	j1776624782 [label="雖然我如常地抱有疑慮。原諒我的打擾。謝謝你抽出時間，漂泊者。",shape=box,color=blue];
		j1776624782 -> j2331496732;
	j2331496732 [label="-里昂・阿拉德神父",shape=box,color=blue];
		j2331496732 -> "Chat ends.";
}