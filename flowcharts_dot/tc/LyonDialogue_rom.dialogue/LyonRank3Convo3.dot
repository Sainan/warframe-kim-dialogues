digraph {
	114 [label="LyonRank3Convo3 begins.",color=orange];
		114 -> 115;
	115 [label="我當時在 Loid 先生的圖書館幫忙，把書放回書架上，但他堅持說那些奇特的飛行器……也能完成這項工作 —",shape=box,color=blue];
		115 -> 116;
	116 [label="我無意中發現了一本奇特的書，書中詳細講述了由尤拉瑞亞．源拓氏所創作的虛構世界中的兒童故事。",shape=box,color=blue];
		116 -> 117;
	117 [label="留意到作者的姓氏跟我們「日曜主教」的真名相同，我立刻把這本書留給自己。",shape=box,color=blue];
		117 -> 120;
		117 -> 119;
		117 -> 118;
	120 [label="我想我知道你指的是哪本書了……",shape=box,color=red];
		120 -> 123;
	119 [label="拜托我們可以跳過開場白嗎？你想知道什麼就問吧。",shape=box,color=red];
		119 -> 122;
	118 [label="[無視]",shape=box,color=red];
		118 -> 121;
	123 [label="+5 Chemistry",color=orange];
		123 -> 125;
	122 [label="Update boolean LyonMITW1",color=orange];
		122 -> 124;
	121 [label="Chat ends.",color=orange];
	125 [label="從 Loid 先生驚恐的表情以及他堅持讓我立即退還這本書，「免得讓你不高興」來看，我懷疑你確實知道一些內情。",shape=box,color=blue];
		125 -> 128;
	124 [label="我的問題跟「概念式體現」的本質有關。看完之後，我明白這本書的目的是教導孩子如何避免自己的情緒跟虛空互動。",shape=box,color=blue];
		124 -> 126;
		124 -> 127;
	128 [label="《渡域故事集》。雖然我從 Loid 先生那裡得到了相當……疲憊和漫長的解釋，說明你所遭受的苦難，但我還有一件事想問一下。",shape=box,color=blue];
		128 -> 131;
	126 [label="作用不大，對我而言更是如此。",shape=box,color=red];
		126 -> 129;
	127 [label="強烈的情緒跟虛空互動會造成……嚴重的問題。",shape=box,color=red];
		127 -> 130;
	131 [label="對，但，前提是這樣做不會太麻煩？",shape=box,color=blue];
		131 -> 134;
		131 -> 135;
	129 [label="我們生活中有多少東西是別人強加給我們的，並被當作事實來教導我們，但經試驗後卻被證明毫無用處？",shape=box,color=blue];
		129 -> 132;
	130 [label="看來確實如此。我見過參研者。我聽過虛空天使。我親耳聽過喃喃者。 ",shape=box,color=blue];
		130 -> 133;
	134 [label="不會。你繼續吧。",shape=box,color=red];
		134 -> 122;
	135 [label="這完全取決於實際情況。我完全不知道你想問我什麼。",shape=box,color=red];
		135 -> 140;
	132 [label="Update boolean LyonFaith1",color=orange];
		132 -> 136;
	133 [label="這就是我好奇的本質。我之所以「說出來」這個問題，是想看看你是否能闡述。當虛空被賦予形態時，從中出來的是什麼 — 它們是「真實」的嗎？",shape=box,color=blue];
		133 -> 137;
		133 -> 138;
		133 -> 139;
	140 [label="+5 Chemistry",color=orange];
		140 -> 146;
	136 [label="我常常好奇為什麼要用這些毫無用處的謊言蒙騙別人？他們是為了追求權力？影響力嗎？還是他們真的相信自己所說的話，對自己的謊言渾然不自知？",shape=box,color=blue];
		136 -> 142;
		136 -> 141;
	137 [label="不，我認為虛空所創造的一切都只是……暫時性的。是創造它的存在或事物的碎片。是記憶的幽靈。",shape=box,color=red];
		137 -> 143;
	138 [label="是的，我相信是。就像藝術家創作的一幅畫，它可能源自於某人的想像，但一旦創作完成，它就是真實的。",shape=box,color=red];
		138 -> 144;
	139 [label="這完全取決於你對「真實」的定義了。",shape=box,color=red];
		139 -> 145;
	146 [label="是的，原諒我。我不太擅長……直接溝通，尤其是不擅長用這種奇怪的方式。但我現在會努力嘗試。",shape=box,color=blue];
		146 -> 122;
	142 [label="我認為尤拉瑞亞．源拓氏的本意是希望她寫的東西有用。只是在我需要的時候，它並沒有幫助到我。",shape=box,color=red];
		142 -> 148;
	141 [label="我不知道。里昂，你腦子裡都裝著哪些謊言呢？",shape=box,color=red];
		141 -> 147;
	143 [label="那麼，虛空中的這些元素所造成的影響不是「真實」的嗎？",shape=box,color=blue];
		143 -> 149;
	144 [label="但你用的這個比喻不太準確，對吧？從虛空中提取的物質難道最終不會回歸虛空嗎？",shape=box,color=blue];
		144 -> 150;
	145 [label="+5 Chemistry",color=orange];
		145 -> 151;
	148 [label="要替她說話的是，我接觸虛空的時間遠遠超過了她希望這本書作為指導的時間。",shape=box,color=red];
		148 -> 153;
	147 [label="不是我來找你討論的事情。",shape=box,color=blue];
		147 -> 152;
	149 [label="許多回憶都曾經使人酗酒，甚至令他們結束自己的生命。難道這些回憶就不是「真實」的嗎？",shape=box,color=blue];
		149 -> 154;
	150 [label="很好，這是個想法。詩歌或歌曲即使沒有被寫下來，但仍然存在。",shape=box,color=red];
		150 -> 155;
	151 [label="你可以詳細說明一下嗎？",shape=box,color=blue];
		151 -> 156;
	153 [label="+5 Chemistry",color=orange];
		153 -> 157;
	152 [label="Chat ends.",color=orange];
	154 [label="但我的論點是，那些都是他發自內在的力量，不是外在的力量。",shape=box,color=red];
		154 -> 158;
	155 [label="但如果它被遺忘，就不存在了。一段被時間遺忘的故事就會永遠消失。",shape=box,color=blue];
		155 -> 159;
	156 [label="你如何衡量「真實性」？",shape=box,color=red];
		156 -> 160;
		156 -> 161;
		156 -> 162;
	157 [label="對於他人作惡的原因，不幸的無知或許是人們所能抱持的最大希望。",shape=box,color=blue];
		157 -> 163;
	158 [label="但我的問題是，有什麼分別？如果最終結果相同，又有關係嗎？",shape=box,color=blue];
		158 -> 164;
		158 -> 165;
		158 -> 166;
	159 [label="一場由發動者自身思想催生的革命，是一把非常鈍的劍。",shape=box,color=blue];
		159 -> 164;
		159 -> 165;
		159 -> 166;
	160 [label="憑物理上的永恆？憑重量和質量？來自虛空之物只是暫時存在在這裏。",shape=box,color=red];
		160 -> 167;
	161 [label="它對歷史發展的影響是什麼？來自虛空的事物已經改變了歷史的路徑。",shape=box,color=red];
		161 -> 168;
	162 [label="是根據它對其他人的影響？來自虛空的「事物」的影響無疑產生了這種效果。",shape=box,color=red];
		162 -> 169;
	163 [label="然而，我的好奇心並非在於這本書本身或它有用與否。請容許我抒發一下詩意。",shape=box,color=blue];
		163 -> 170;
	164 [label="你不是在問它們是否「真實」，而是在問它們是否「確實」，是否應該被承認或否定。",shape=box,color=red];
		164 -> 171;
	165 [label="那我要問，就因為你們無法跟太陽或太陰握手你們的「聖光者」是否「真實」的。",shape=box,color=red];
		165 -> 172;
	166 [label="你轉彎抹角地問，虛空中的所有「事物」在這裏存在是否僅僅是因為我們用意志力將它們創造出來的。",shape=box,color=red];
		166 -> 173;
	167 [label="你的意思是，來自虛空的事物最終將回歸虛空？但虛空，從定義上來說，不就是由虛無構成的嗎？",shape=box,color=blue];
		167 -> 174;
	168 [label="有道理。難道僅僅因為革命無法被量化，就不是「真正的」革命嗎？",shape=box,color=blue];
		168 -> 169;
	169 [label="它確實是奪走了許多人的生命。他們會極力辯稱它的合理性。然而，想想以下幾點：",shape=box,color=blue];
		169 -> 175;
	170 [label="我之所以「說出來」這個問題，是想看看你是否能闡述。當虛空被賦予形態時，從中出來的是什麼 — 它們是「真實」的嗎？",shape=box,color=blue];
		170 -> 137;
		170 -> 139;
		170 -> 138;
	171 [label="+5 Chemistry",color=orange];
		171 -> 176;
	172 [label="我們討論的不是聖光者。是虛空。",shape=box,color=blue];
		172 -> 177;
		172 -> 178;
		172 -> 179;
		172 -> 180;
	173 [label="+5 Chemistry",color=orange];
		173 -> 181;
	174 [label="我想是吧？我接觸過的虛空部分似乎都被我們留下印記。我們已經賦予了它某種形狀或形態。或者說，我們已經模糊了現實之間的界線。",shape=box,color=red];
		174 -> 182;
		174 -> 183;
	175 [label="一場革命只有在發動革命的人心中存在時才具意義。",shape=box,color=blue];
		175 -> 184;
	176 [label="是的，我想你可以這麼說。我們應該對縈繞在我們大廳的幽靈視而不見嗎？還是說，如果我們對他們給予關注，反而會助長他們的氣焰？",shape=box,color=blue];
		176 -> 177;
		176 -> 178;
		176 -> 179;
		176 -> 180;
	177 [label="我認為我們目前面臨的挑戰是危險的。極度危險。我們應該以對待危險的態度來對待它們。",shape=box,color=red];
		177 -> 185;
	178 [label="鬼魂真實得足以帶給我們痛苦。但他們無法以子彈消滅。至少我還沒找到能做到這一點的子彈。",shape=box,color=red];
		178 -> 186;
	179 [label="這到底是怎麼回事，里昂？真的？",shape=box,color=red];
		179 -> 187;
	180 [label="我……真的不知道，里昂。我希望我知道。",shape=box,color=red];
		180 -> 188;
	181 [label="是的，我想你可以這樣說。我們怎麼能確定我們沒有……顯露出我們自己的魔鬼呢？",shape=box,color=blue];
		181 -> 177;
		181 -> 178;
		181 -> 179;
		181 -> 180;
	182 [label="整個結構，甚至包括太陰本身，都曾被放入虛空並被取回。因此並非僅僅因為存在於虛空中就會令物質消失。",shape=box,color=red];
		182 -> 189;
	183 [label="你的意思是存在一個「更深的」虛空，在那裏任何東西都無法存在，對此我真的沒有答案。",shape=box,color=red];
		183 -> 190;
	184 [label="如果它從周圍所有人的記憶中消失，它就會不再存在，不是嗎？",shape=box,color=blue];
		184 -> 165;
		184 -> 164;
		184 -> 166;
	185 [label="Update boolean LyonReal1",color=orange];
		185 -> 191;
	186 [label="Update boolean LyonFake1",color=orange];
		186 -> 192;
	187 [label="Update boolean LyonFaith1",color=orange];
		187 -> 193;
	188 [label="你老實自己不知道的事情，這種坦誠令人耳目一新。但願更多的人都能擁有這樣的特質。",shape=box,color=blue];
		188 -> 194;
	189 [label="我不在乎那些被放入虛空又被取回的東西。我在乎的是那些完全憑空從虛空中創造出來的東西。",shape=box,color=blue];
		189 -> 164;
		189 -> 165;
		189 -> 166;
	190 [label="我謝謝你的坦誠。或許我對那些不能存在的事物，而不是現已存在的事物更感興趣。",shape=box,color=blue];
		190 -> 164;
		190 -> 165;
		190 -> 166;
	191 [label="是的，我想你應該知道哪些東西可以以武力從虛空中擊落而哪些不能……",shape=box,color=blue];
		191 -> 195;
	192 [label="或許這就是為什麼那麼多人沉溺……為了止住那看不見卻隱隱作痛的傷口。這傷口是可以治癒的，但靠的是心靈的力量，而非武器。",shape=box,color=blue];
		192 -> 195;
	193 [label="我顯然完全搞錯了。我們改天再討論。原諒我的打擾。",shape=box,color=blue];
		193 -> 196;
	194 [label="但依然，我對這件事的看法未完全有定論。",shape=box,color=blue];
		194 -> 193;
	195 [label="雖然我如常地抱有疑慮。原諒我的打擾。謝謝你抽出時間，漂泊者。",shape=box,color=blue];
		195 -> 196;
	196 [label="-里昂・阿拉德神父",shape=box,color=blue];
		196 -> 197;
	197 [label="Chat ends.",color=orange];
}