		573 -> 574 [label="MarieLyonVisions",color=purple];
		573 -> 575 [label="MarieLyonVisions",color=purple];
		573 -> 576 [label="MarieLyonVisions",color=purple];
		573 -> 574 [label="LyonVisions1",color=purple];
		573 -> 575 [label="LyonVisions1",color=purple];
		573 -> 576 [label="LyonVisions1",color=purple];
		573 -> 577 [label="LyonVisions1",color=purple];
		573 -> 574 [label="false",color=purple];
		573 -> 575 [label="false",color=purple];
	577 [label="有人提醒過我，你對事物的看法可能跟我們不一樣。但這並不會困擾我。我對你的見解很有興趣。",shape=box,color=red];
		577 -> 581;
	574 [label="瑪麗似乎對「主教」很著迷。而羅瑟顯然非常恨他。我需要一個中立的第三方。你是我能找到的最接近的人選。",shape=box,color=red];
		574 -> 578;
	575 [label="我……不知道還有什麼可以問你？",shape=box,color=red];
		575 -> 579;
	576 [label="有人提醒我，你看待事物的方式可能跟我們不一樣。但我認為，你或許看得到別人看不到的真相。",shape=box,color=red];
		576 -> 580;
	581 [label="嗯。難道你不介意和瘋子，精神病患混在一起嗎？真奇怪。雖然你似乎也會結交會說話的動物以及……來自異時空的生物。我想，我跟你的其他生物收藏相比，也沒什麼特別古怪的。",shape=box,color=blue];
		581 -> 582;
	578 [label="看來你真是找不到什麼明智的選擇，竟然一個瘋子和神經病患者是你尋求「中立」意見的唯一來源。我實在不懂你為什麼還要跟我說話。",shape=box,color=blue];
		578 -> 582;
	579 [label="為什麼一定要堅持跟我說話？你明白到，根本不需要。如果你想跟瑪麗做朋友— 甚至追求她 — 我既不是她的監護人，也不是她的父親。至於你對那個王八蛋羅瑟有什麼企圖，我根本不在乎，我只關心他欠我的那些問題。",shape=box,color=blue];
		579 -> 582;
	580 [label="「真相。」我真希望你能明白最近我覺得這話有多可笑。難道你不介意和瘋子，精神病患混在一起嗎？真奇怪。雖然你似乎也會結交會說話的動物以及……來自異時空的生物。我想，我跟你的其他生物收藏相比，也沒什麼特別古怪的。",shape=box,color=blue];
		580 -> 582;
	582 [label="Evaluate expressions",color=orange];
		582 -> 585 [label="LyonFirstFlirt",color=purple];
		582 -> 585 [label="DrifterLyon",color=purple];
		582 -> 584 [label="LyonOffer",color=purple];
		582 -> 583 [label="false",color=purple];
	585 [label="拜託，別再讓我們兩個……尷尬了，好嗎？我知道你說的是跟我交談的理由。雖然我覺得受寵若驚，但這種荒誕的虛偽實在刺耳。",shape=box,color=blue];
		585 -> 586;
		585 -> 587;
		585 -> 588;
	584 [label="請不要長篇大論地跟我講你想如何「幫助」我，好嗎？我知道你是出於好意，但這種荒誕的虛偽實在刺耳。",shape=box,color=blue];
		584 -> 586;
		584 -> 587;
		584 -> 588;
	583 [label="請不要長篇大論地跟我講你想如何「幫助」我或你想如何「做我的朋友」。我知道你是出於好意，但這種荒誕的虛偽實在刺耳。",shape=box,color=blue];
		583 -> 586;
		583 -> 587;
		583 -> 588;
	586 [label="你覺得我說的話不真誠是因為你認為我言不由衷，還是因為你認為我說的關於你的事不會是真心的？",shape=box,color=red];
		586 -> 589;
	587 [label="神父，我只想知道源拓氏蒂冒充主教的時間有多長。僅此而已。",shape=box,color=red];
		587 -> 590;
	588 [label="你說的「不誠懇」是什麼意思？你是在說我在說謊嗎？",shape=box,color=red];
		588 -> 591;
	589 [label="都不是。你的話對我來說是既不需要也不想要的施捨。",shape=box,color=blue];
		589 -> 592;
		589 -> 593;
	590 [label="沒錯。他擔任我們大教堂的日曜主教一職長達三年兩個月零十一天。在那段時間裡，我和瑪麗一直侍奉他，卻對他為我們所做的安排一無所知。",shape=box,color=blue];
		590 -> 594;
	591 [label="Evaluate expressions",color=orange];
		591 -> 597 [label="DrifterLiar",color=purple];
		591 -> 596 [label="LyonSuspicious",color=purple];
		591 -> 595 [label="false",color=purple];
	592 [label="瑪麗是怎麼忍受這一切的……？",shape=box,color=red];
		592 -> 598;
	593 [label="你認為任何選擇跟你交往的人都是在憐憫嗎？",shape=box,color=red];
		593 -> 599;
	594 [label="在你說出口之前，我就知道你想問的問題了。他究竟在密謀什麼？他是否像我聽說的對霍爾瓦尼亞那樣，也要感染這座城市？他的計劃是什麼？他發現了什麼？",shape=box,color=blue];
		594 -> 600;
	597 [label="漂泊者，你有什麼想要坦白的嗎？你有東西要贖罪嗎？",shape=box,color=blue];
		597 -> 601;
	596 [label="嗯。不。或許，還沒到那個時候。",shape=box,color=blue];
		596 -> 595;
	595 [label="你的虛偽並非謊言，而是出於好意。但我不需要也不想要這種好意。 ",shape=box,color=blue];
		595 -> 592;
		595 -> 593;
	598 [label="你最好自己去問她。我也常常有同樣的疑問。",shape=box,color=blue];
		598 -> 602;
	599 [label="簡單一句？是的。",shape=box,color=blue];
		599 -> 603;
	600 [label="我要告訴那些人，你們會失望的。在那三年兩個月零十一天裡，他傳道、學習、休息、禱告。",shape=box,color=blue];
		600 -> 604;
		600 -> 605;
		600 -> 606;
	601 [label="這無關緊要。你來參加這次對話並非為了尋求原諒，你過去的謊言也與你現在的虛偽截然不同。",shape=box,color=blue];
		601 -> 607;
	602 [label="Chat ends.",color=orange];
	603 [label="Update boolean LyonHate1",color=orange];
		603 -> 608;
		603 -> 609;
		603 -> 610;
	604 [label="他什麼時候把你變成原型 Warframe 的？",shape=box,color=red];
		604 -> 611;
	605 [label="我很難想像源拓氏禱告的樣子。",shape=box,color=red];
		605 -> 612;
	606 [label="所以他……在放假？ ！",shape=box,color=red];
		606 -> 613;
	607 [label="你現在所說的不過是出於好意。但我不需要也不想要這種好意。",shape=box,color=blue];
		607 -> 592;
		607 -> 593;
	608 [label="這件事值得改天再深入探討 ─ 我覺得這場對話正慢慢失控。",shape=box,color=red];
		608 -> 614;
	609 [label="瑪麗呢…？",shape=box,color=red];
		609 -> 615;
	610 [label="你一定非常看低你自己。",shape=box,color=red];
		610 -> 616;
	611 [label="三年又幾天後，他在一場可怕的風暴中消失了。這場風暴和他出現時的風暴一模一樣。",shape=box,color=blue];
		611 -> 617;
	612 [label="我們不可能了解別人的內心思想。他跪在祭壇前，低著頭。他那時候是在祈禱嗎？還是只是沉浸在自己的思緒中？我不知道。",shape=box,color=blue];
		612 -> 611;
	613 [label="+5 Chemistry",color=orange];
		613 -> 618;
	614 [label="+5 Chemistry",color=orange];
		614 -> 619;
	615 [label="如果瑪麗認為這樣做能給這隻瘋熊帶來片刻安寧，她甚至會把瘋熊抱在懷裡，任由牠咬開自己的喉嚨。",shape=box,color=blue];
		615 -> 620;
	616 [label="我認為這是一種對實用主義的堅定不移的堅持，但你怎樣定義它都可以。",shape=box,color=blue];
		616 -> 621;
	617 [label="Evaluate expressions",color=orange];
		617 -> 622 [label="MarieLyonVisions",color=purple];
		617 -> 622 [label="LyonVisions1",color=purple];
		617 -> 623 [label="false",color=purple];
	618 [label="嘻。我之前沒這麼想過，不過 ─ 或許他真的是這樣。這會令你們其他人非常生氣。這似乎也符合我們對他的真面目的一些了解。",shape=box,color=blue];
		618 -> 611;
	619 [label="這或許是個明智的決定。你問的是「日曜主教」及他在教堂的任期。",shape=box,color=blue];
		619 -> 624;
	620 [label="她擁有舉世無雙的美麗靈魂，我會守護她直到生命的最後一刻。",shape=box,color=blue];
		620 -> 621;
	621 [label="+5 Chemistry",color=orange];
		621 -> 625;
	622 [label="雖然我知道其他人可能沒有感受到這場風暴，但我卻真實地感覺到了。",shape=box,color=blue];
		622 -> 623;
	623 [label="一年之後的同一天，他最後一次出現，而……羅瑟，正如你現在看到的，倒在他腳下並昏迷不醒。",shape=box,color=blue];
		623 -> 626;
	624 [label="沒他擔任我們大教堂的日曜主教一職長達三年兩個月零十一天。在那段時間裡，我和瑪麗一直侍奉他，卻對他為我們所做的安排一無所知。",shape=box,color=blue];
		624 -> 594;
	625 [label="但你應該預料到這種情況，問一個瘋子一個簡單的問題，往往引出很多無關緊要的話題。請容許我把話題拉回你最初的主題，而不是我自己的。",shape=box,color=blue];
		625 -> 624;
	626 [label="他簡直就是魔鬼的化身，至少看起來是這樣。就在那時，源拓氏向我們揭示了他的真實身份 — 他來自的地方 — 以及他給予我們的真正任務。",shape=box,color=blue];
		626 -> 627;
	627 [label="他選中我們兩個去執行一個「神聖的使命」。",shape=box,color=blue];
		627 -> 628;
		627 -> 629;
	628 [label="為什麼要用引號？",shape=box,color=red];
		628 -> 630;
	629 [label="聽起來你並不相信他。",shape=box,color=red];
		629 -> 630;
	630 [label="我學到了很多東西，這讓我開始質疑源拓氏對任何自然或任何神靈的神聖信仰的信服……如果真有這種東西存在的話……",shape=box,color=blue];
		630 -> 631;
		630 -> 632;
	631 [label="如果真有這種東西的話？里昂，你是什麼意思？",shape=box,color=red];
		631 -> 633;
	632 [label="繼續。",shape=box,color=red];
		632 -> 634;
	633 [label="Update boolean LyonFaith2",color=orange];
		633 -> 635;
	634 [label="瑪麗欣然接受了血清。當然，她會接受的。她怎麼可能不接受呢？而我又怎能不跟隨她呢？我又怎能不去追尋真相，無論真相會將我指引到任何方向呢？",shape=box,color=blue];
		634 -> 636;
	635 [label="我們別日再討論這個話題吧。",shape=box,color=blue];
		635 -> 634;
	636 [label="Update boolean LyonSerum1",color=orange];
		636 -> 637;
		636 -> 638;
		636 -> 639;
	637 [label="我覺得她對源拓氏的崇拜有點過火了。",shape=box,color=red];
		637 -> 640;
	638 [label="之後發生了什麼事？",shape=box,color=red];
		638 -> 641;
	639 [label="你後悔嗎？",shape=box,color=red];
		639 -> 642;
	640 [label="Update boolean LyonMarieEntrati",color=orange];
		640 -> 643;
	641 [label="羅瑟醒了過來。最初，他幾乎記不起自己的名字。源拓氏臨別前對這個王八蛋說了一句話：「被放逐的 Xata 異端者 Uriel，回答我 — Orokin 人還能被原諒嗎？」",shape=box,color=blue];
		641 -> 644;
	642 [label="「我後悔一切，漂泊者。」是的，我當然後悔。但我還會再做一次嗎？是的，我當然會。我不能留下瑪麗自己一個人。",shape=box,color=blue];
		642 -> 645;
	643 [label="在這點上，我們意見一致。但我也不能因此責怪她。給她點時間，她會明白的。她非常聰明，漂泊者。不要把她當傻瓜。",shape=box,color=blue];
		643 -> 645;
	644 [label="源拓氏就此永遠離開了。他把羅瑟留給了我們，而羅瑟如今已煥然一新，變成了你們現在看到的樣子 — 更能與那喜怒無常的魔鬼抗衡。",shape=box,color=blue];
		644 -> 646;
	645 [label="故事的下文就是……源拓氏就此永遠離開了。他把羅瑟留給了我們，而羅瑟如今已煥然一新，變成了你們現在看到的樣子 — 更能與那喜怒無常的魔鬼抗衡。",shape=box,color=blue];
		645 -> 646;
	646 [label="剩下的故事我怕只能以後再說了。Loid 先生需要使用 POM-2 而我急於把它還給他。希望這至少能解答你的一些疑問。",shape=box,color=blue];
		646 -> 647;
		646 -> 648;
	647 [label="並且透過新答案帶來兩倍的疑惑。",shape=box,color=red];
		647 -> 649;
	648 [label="有，謝謝你。",shape=box,color=red];
		648 -> 650;
	649 [label="+15 Chemistry",color=orange];
		649 -> 651;
	650 [label="+10 Chemistry",color=orange];
		650 -> 652;
	651 [label="那我已盡到神父的職責。我祝你晚安。",shape=box,color=blue];
		651 -> 653;
	652 [label="那我就祝你晚安了。",shape=box,color=blue];
		652 -> 653;
	653 [label="-里昂・阿拉德神父",shape=box,color=blue];
		653 -> 654;
	654 [label="Chat ends.",color=orange];
}