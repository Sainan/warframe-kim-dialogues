		j4196769031 -> j1432510264 [label="MarieLyonVisions",color=purple];
		j4196769031 -> j3055364148 [label="LyonVisions1",color=purple];
		j4196769031 -> j46889 [label="LyonVisions1",color=purple];
		j4196769031 -> j1432510264 [label="LyonVisions1",color=purple];
		j4196769031 -> j4212348697 [label="LyonVisions1",color=purple];
		j4196769031 -> j3055364148 [label="false",color=purple];
		j4196769031 -> j46889 [label="false",color=purple];
	j4212348697 [label="有人提醒過我，你對事物的看法可能跟我們不一樣。但這並不會困擾我。我對你的見解很有興趣。",shape=box,color=red];
		j4212348697 -> j3420548339;
	j3055364148 [label="瑪麗似乎對「主教」很著迷。而羅瑟顯然非常恨他。我需要一個中立的第三方。你是我能找到的最接近的人選。",shape=box,color=red];
		j3055364148 -> j4004874402;
	j46889 [label="我……不知道還有什麼可以問你？",shape=box,color=red];
		j46889 -> j3110476376;
	j1432510264 [label="有人提醒我，你看待事物的方式可能跟我們不一樣。但我認為，你或許看得到別人看不到的真相。",shape=box,color=red];
		j1432510264 -> j176778541;
	j3420548339 [label="嗯。難道你不介意和瘋子，精神病患混在一起嗎？真奇怪。雖然你似乎也會結交會說話的動物以及……來自異時空的生物。我想，我跟你的其他生物收藏相比，也沒什麼特別古怪的。",shape=box,color=blue];
		j3420548339 -> j2845885253;
	j4004874402 [label="看來你真是找不到什麼明智的選擇，竟然一個瘋子和神經病患者是你尋求「中立」意見的唯一來源。我實在不懂你為什麼還要跟我說話。",shape=box,color=blue];
		j4004874402 -> j2845885253;
	j3110476376 [label="為什麼一定要堅持跟我說話？你明白到，根本不需要。如果你想跟瑪麗做朋友— 甚至追求她 — 我既不是她的監護人，也不是她的父親。至於你對那個王八蛋羅瑟有什麼企圖，我根本不在乎，我只關心他欠我的那些問題。",shape=box,color=blue];
		j3110476376 -> j2845885253;
	j176778541 [label="「真相。」我真希望你能明白最近我覺得這話有多可笑。難道你不介意和瘋子，精神病患混在一起嗎？真奇怪。雖然你似乎也會結交會說話的動物以及……來自異時空的生物。我想，我跟你的其他生物收藏相比，也沒什麼特別古怪的。",shape=box,color=blue];
		j176778541 -> j2845885253;
	j2845885253 [label="Evaluate expressions",color=orange];
		j2845885253 -> j2201170550 [label="LyonFirstFlirt",color=purple];
		j2845885253 -> j2201170550 [label="DrifterLyon",color=purple];
		j2845885253 -> j2785236913 [label="LyonOffer",color=purple];
		j2845885253 -> j3981895578 [label="false",color=purple];
	j2201170550 [label="拜託，別再讓我們兩個……尷尬了，好嗎？我知道你說的是跟我交談的理由。雖然我覺得受寵若驚，但這種荒誕的虛偽實在刺耳。",shape=box,color=blue];
		j2201170550 -> j309476511;
		j2201170550 -> j3015805107;
		j2201170550 -> j1332153375;
	j2785236913 [label="請不要長篇大論地跟我講你想如何「幫助」我，好嗎？我知道你是出於好意，但這種荒誕的虛偽實在刺耳。",shape=box,color=blue];
		j2785236913 -> j309476511;
		j2785236913 -> j3015805107;
		j2785236913 -> j1332153375;
	j3981895578 [label="請不要長篇大論地跟我講你想如何「幫助」我或你想如何「做我的朋友」。我知道你是出於好意，但這種荒誕的虛偽實在刺耳。",shape=box,color=blue];
		j3981895578 -> j309476511;
		j3981895578 -> j3015805107;
		j3981895578 -> j1332153375;
	j309476511 [label="你覺得我說的話不真誠是因為你認為我言不由衷，還是因為你認為我說的關於你的事不會是真心的？",shape=box,color=red];
		j309476511 -> j2202811625;
	j3015805107 [label="神父，我只想知道源拓氏蒂冒充主教的時間有多長。僅此而已。",shape=box,color=red];
		j3015805107 -> j2420731961;
	j1332153375 [label="你說的「不誠懇」是什麼意思？你是在說我在說謊嗎？",shape=box,color=red];
		j1332153375 -> j5625625;
	j2202811625 [label="都不是。你的話對我來說是既不需要也不想要的施捨。",shape=box,color=blue];
		j2202811625 -> j654657448;
		j2202811625 -> j3155200273;
	j2420731961 [label="沒錯。他擔任我們大教堂的日曜主教一職長達三年兩個月零十一天。在那段時間裡，我和瑪麗一直侍奉他，卻對他為我們所做的安排一無所知。",shape=box,color=blue];
		j2420731961 -> j1265851926;
	j5625625 [label="Evaluate expressions",color=orange];
		j5625625 -> j4210266645 [label="DrifterLiar",color=purple];
		j5625625 -> j495447300 [label="LyonSuspicious",color=purple];
		j5625625 -> j3551903962 [label="false",color=purple];
	j654657448 [label="瑪麗是怎麼忍受這一切的……？",shape=box,color=red];
		j654657448 -> j3171460165;
	j3155200273 [label="你認為任何選擇跟你交往的人都是在憐憫嗎？",shape=box,color=red];
		j3155200273 -> j2284775229;
	j1265851926 [label="在你說出口之前，我就知道你想問的問題了。他究竟在密謀什麼？他是否像我聽說的對霍爾瓦尼亞那樣，也要感染這座城市？他的計劃是什麼？他發現了什麼？",shape=box,color=blue];
		j1265851926 -> j3839913237;
	j4210266645 [label="漂泊者，你有什麼想要坦白的嗎？你有東西要贖罪嗎？",shape=box,color=blue];
		j4210266645 -> j1129100709;
	j495447300 [label="嗯。不。或許，還沒到那個時候。",shape=box,color=blue];
		j495447300 -> j3551903962;
	j3551903962 [label="你的虛偽並非謊言，而是出於好意。但我不需要也不想要這種好意。 ",shape=box,color=blue];
		j3551903962 -> j654657448;
		j3551903962 -> j3155200273;
	j3171460165 [label="你最好自己去問她。我也常常有同樣的疑問。",shape=box,color=blue];
		j3171460165 -> "Chat ends.";
	j2284775229 [label="簡單一句？是的。",shape=box,color=blue];
		j2284775229 -> j3994772085;
	j3839913237 [label="我要告訴那些人，你們會失望的。在那三年兩個月零十一天裡，他傳道、學習、休息、禱告。",shape=box,color=blue];
		j3839913237 -> j4184866152;
		j3839913237 -> j2902607332;
		j3839913237 -> j2543648771;
	j1129100709 [label="這無關緊要。你來參加這次對話並非為了尋求原諒，你過去的謊言也與你現在的虛偽截然不同。",shape=box,color=blue];
		j1129100709 -> j2074559020;
	j3994772085 [label="Boolean LyonHate1 is now true.",color=orange];
		j3994772085 -> j3758081021;
		j3994772085 -> j1437110633;
		j3994772085 -> j2180476905;
	j4184866152 [label="他什麼時候把你變成原型 Warframe 的？",shape=box,color=red];
		j4184866152 -> j3272821263;
	j2902607332 [label="我很難想像源拓氏禱告的樣子。",shape=box,color=red];
		j2902607332 -> j3106905162;
	j2543648771 [label="所以他……在放假？ ！",shape=box,color=red];
		j2543648771 -> j3587650550;
	j2074559020 [label="你現在所說的不過是出於好意。但我不需要也不想要這種好意。",shape=box,color=blue];
		j2074559020 -> j654657448;
		j2074559020 -> j3155200273;
	j3758081021 [label="這件事值得改天再深入探討 ─ 我覺得這場對話正慢慢失控。",shape=box,color=red];
		j3758081021 -> j2790281038;
	j1437110633 [label="瑪麗呢…？",shape=box,color=red];
		j1437110633 -> j3289510280;
	j2180476905 [label="你一定非常看低你自己。",shape=box,color=red];
		j2180476905 -> j3759923266;
	j3272821263 [label="三年又幾天後，他在一場可怕的風暴中消失了。這場風暴和他出現時的風暴一模一樣。",shape=box,color=blue];
		j3272821263 -> j3307858394;
	j3106905162 [label="我們不可能了解別人的內心思想。他跪在祭壇前，低著頭。他那時候是在祈禱嗎？還是只是沉浸在自己的思緒中？我不知道。",shape=box,color=blue];
		j3106905162 -> j3272821263;
	j3587650550 [label="+5 Chemistry",color=orange];
		j3587650550 -> j1812299324;
	j2790281038 [label="+5 Chemistry",color=orange];
		j2790281038 -> j1934183574;
	j3289510280 [label="如果瑪麗認為這樣做能給這隻瘋熊帶來片刻安寧，她甚至會把瘋熊抱在懷裡，任由牠咬開自己的喉嚨。",shape=box,color=blue];
		j3289510280 -> j4264938155;
	j3759923266 [label="我認為這是一種對實用主義的堅定不移的堅持，但你怎樣定義它都可以。",shape=box,color=blue];
		j3759923266 -> j1467533886;
	j3307858394 [label="Evaluate expressions",color=orange];
		j3307858394 -> j3514252993 [label="MarieLyonVisions",color=purple];
		j3307858394 -> j3514252993 [label="LyonVisions1",color=purple];
		j3307858394 -> j1984123842 [label="false",color=purple];
	j1812299324 [label="嘻。我之前沒這麼想過，不過 ─ 或許他真的是這樣。這會令你們其他人非常生氣。這似乎也符合我們對他的真面目的一些了解。",shape=box,color=blue];
		j1812299324 -> j3272821263;
	j1934183574 [label="這或許是個明智的決定。你問的是「日曜主教」及他在教堂的任期。",shape=box,color=blue];
		j1934183574 -> j431147396;
	j4264938155 [label="她擁有舉世無雙的美麗靈魂，我會守護她直到生命的最後一刻。",shape=box,color=blue];
		j4264938155 -> j1467533886;
	j1467533886 [label="+5 Chemistry",color=orange];
		j1467533886 -> j2215783581;
	j3514252993 [label="雖然我知道其他人可能沒有感受到這場風暴，但我卻真實地感覺到了。",shape=box,color=blue];
		j3514252993 -> j1984123842;
	j1984123842 [label="一年之後的同一天，他最後一次出現，而……羅瑟，正如你現在看到的，倒在他腳下並昏迷不醒。",shape=box,color=blue];
		j1984123842 -> j117299910;
	j431147396 [label="沒他擔任我們大教堂的日曜主教一職長達三年兩個月零十一天。在那段時間裡，我和瑪麗一直侍奉他，卻對他為我們所做的安排一無所知。",shape=box,color=blue];
		j431147396 -> j1265851926;
	j2215783581 [label="但你應該預料到這種情況，問一個瘋子一個簡單的問題，往往引出很多無關緊要的話題。請容許我把話題拉回你最初的主題，而不是我自己的。",shape=box,color=blue];
		j2215783581 -> j431147396;
	j117299910 [label="他簡直就是魔鬼的化身，至少看起來是這樣。就在那時，源拓氏向我們揭示了他的真實身份 — 他來自的地方 — 以及他給予我們的真正任務。",shape=box,color=blue];
		j117299910 -> j686339527;
	j686339527 [label="他選中我們兩個去執行一個「神聖的使命」。",shape=box,color=blue];
		j686339527 -> j4214728806;
		j686339527 -> j245816528;
	j4214728806 [label="為什麼要用引號？",shape=box,color=red];
		j4214728806 -> j2414495361;
	j245816528 [label="聽起來你並不相信他。",shape=box,color=red];
		j245816528 -> j2414495361;
	j2414495361 [label="我學到了很多東西，這讓我開始質疑源拓氏對任何自然或任何神靈的神聖信仰的信服……如果真有這種東西存在的話……",shape=box,color=blue];
		j2414495361 -> j2625879775;
		j2414495361 -> j371440481;
	j2625879775 [label="如果真有這種東西的話？里昂，你是什麼意思？",shape=box,color=red];
		j2625879775 -> j1780845611;
	j371440481 [label="繼續。",shape=box,color=red];
		j371440481 -> j2208279485;
	j1780845611 [label="Boolean LyonFaith2 is now true.",color=orange];
		j1780845611 -> j616526199;
	j2208279485 [label="瑪麗欣然接受了血清。當然，她會接受的。她怎麼可能不接受呢？而我又怎能不跟隨她呢？我又怎能不去追尋真相，無論真相會將我指引到任何方向呢？",shape=box,color=blue];
		j2208279485 -> j1813802388;
	j616526199 [label="我們別日再討論這個話題吧。",shape=box,color=blue];
		j616526199 -> j2208279485;
	j1813802388 [label="Boolean LyonSerum1 is now true.",color=orange];
		j1813802388 -> j2385168873;
		j1813802388 -> j3583657281;
		j1813802388 -> j2693178693;
	j2385168873 [label="我覺得她對源拓氏的崇拜有點過火了。",shape=box,color=red];
		j2385168873 -> j1135637769;
	j3583657281 [label="之後發生了什麼事？",shape=box,color=red];
		j3583657281 -> j3744681282;
	j2693178693 [label="你後悔嗎？",shape=box,color=red];
		j2693178693 -> j1816670458;
	j1135637769 [label="Boolean LyonMarieEntrati is now true.",color=orange];
		j1135637769 -> j2213208028;
	j3744681282 [label="羅瑟醒了過來。最初，他幾乎記不起自己的名字。源拓氏臨別前對這個王八蛋說了一句話：「被放逐的 Xata 異端者 Uriel，回答我 — Orokin 人還能被原諒嗎？」",shape=box,color=blue];
		j3744681282 -> j3910612028;
	j1816670458 [label="「我後悔一切，漂泊者。」是的，我當然後悔。但我還會再做一次嗎？是的，我當然會。我不能留下瑪麗自己一個人。",shape=box,color=blue];
		j1816670458 -> j1393454023;
	j2213208028 [label="在這點上，我們意見一致。但我也不能因此責怪她。給她點時間，她會明白的。她非常聰明，漂泊者。不要把她當傻瓜。",shape=box,color=blue];
		j2213208028 -> j1393454023;
	j3910612028 [label="源拓氏就此永遠離開了。他把羅瑟留給了我們，而羅瑟如今已煥然一新，變成了你們現在看到的樣子 — 更能與那喜怒無常的魔鬼抗衡。",shape=box,color=blue];
		j3910612028 -> j2631797767;
	j1393454023 [label="故事的下文就是……源拓氏就此永遠離開了。他把羅瑟留給了我們，而羅瑟如今已煥然一新，變成了你們現在看到的樣子 — 更能與那喜怒無常的魔鬼抗衡。",shape=box,color=blue];
		j1393454023 -> j2631797767;
	j2631797767 [label="剩下的故事我怕只能以後再說了。Loid 先生需要使用 POM-2 而我急於把它還給他。希望這至少能解答你的一些疑問。",shape=box,color=blue];
		j2631797767 -> j2068178185;
		j2631797767 -> j632272694;
	j2068178185 [label="並且透過新答案帶來兩倍的疑惑。",shape=box,color=red];
		j2068178185 -> j659673343;
	j632272694 [label="有，謝謝你。",shape=box,color=red];
		j632272694 -> j1430283452;
	j659673343 [label="+15 Chemistry",color=orange];
		j659673343 -> j2034985153;
	j1430283452 [label="+10 Chemistry",color=orange];
		j1430283452 -> j4056885703;
	j2034985153 [label="那我已盡到神父的職責。我祝你晚安。",shape=box,color=blue];
		j2034985153 -> j2331496732;
	j4056885703 [label="那我就祝你晚安了。",shape=box,color=blue];
		j4056885703 -> j2331496732;
