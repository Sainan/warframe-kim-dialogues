		2795 -> 2798;
	2796 [label="嗯？
有什麼好生氣的？",shape=box,color=blue];
		2796 -> 2798;
	2797 [label="嗯？
有什麼好理解的？",shape=box,color=blue];
		2797 -> 2798;
	2798 [label="我不願讓你置身你不願待的處境。我知道這不是我們之前討論過的事。所以如果你不想的話，那也沒關係。我希望你明白這點。",shape=box,color=red];
		2798 -> 2799;
	2799 [label="我們之間的關係對我來說很重要，非常重要，而且它是真實的。我不希望你懷疑這點。",shape=box,color=red];
		2799 -> 2800;
	2800 [label="（西語）啊，我懂了……
我想，我只是想知道
小太陽，你真的在乎他們嗎？
（西語）無論他們是誰",shape=box,color=blue];
		2800 -> 2801;
		2800 -> 2802;
	2801 [label="我確實在乎他們。但我也非常在乎你。",shape=box,color=red];
