	j2060878437 [label="嘿，莉蒂？你在忙嗎？[徵求同意發展多重伴侶關係]",shape=box,color=red];
		j2060878437 -> j2640170823;
	j3138840004 [label="[結束]",shape=box,color=red];
		j3138840004 -> j3702107533;
	j2640170823 [label="永遠都在忙\n但為了你的話……\n（西語）什麼事？",shape=box,color=blue];
		j2640170823 -> j2654602817;
	j3702107533 [label="Boolean LettieConsentComplete is now true.",color=orange];
		j3702107533 -> "Chat ends.";
	j2654602817 [label="我想和你說件事，我想確認你的想法。",shape=box,color=red];
		j2654602817 -> j1747997104;
	j1747997104 [label="對我來說更重要的是，希望你不會覺得我在騙你或以任何方式對你不忠。",shape=box,color=red];
		j1747997104 -> j1599124620;
		j1747997104 -> j1500651122;
		j1747997104 -> j2292352326;
	j1599124620 [label="請別傷害我。",shape=box,color=red];
		j1599124620 -> j105009193;
	j1500651122 [label="請別生氣。",shape=box,color=red];
		j1500651122 -> j3245938338;
	j2292352326 [label="我希望你能理解。",shape=box,color=red];
		j2292352326 -> j1279307111;
	j105009193 [label="哈哈\n我們談過這個了\n我只會用你喜歡的方式弄痛你\n你現在到底想說什麼啦",shape=box,color=blue];
		j105009193 -> j3690408073;
	j3245938338 [label="嗯？\n有什麼好生氣的？",shape=box,color=blue];
		j3245938338 -> j3690408073;
	j1279307111 [label="嗯？\n有什麼好理解的？",shape=box,color=blue];
		j1279307111 -> j3690408073;
	j3690408073 [label="我不願讓你置身你不願待的處境。我知道這不是我們之前討論過的事。所以如果你不想的話，那也沒關係。我希望你明白這點。",shape=box,color=red];
		j3690408073 -> j3309591292;
	j3309591292 [label="我們之間的關係對我來說很重要，非常重要，而且它是真實的。我不希望你懷疑這點。",shape=box,color=red];
		j3309591292 -> j3899563086;
	j3899563086 [label="（西語）啊，我懂了……\n我想，我只是想知道\n小太陽，你真的在乎他們嗎？\n（西語）無論他們是誰\n你真的在乎他們嗎？",shape=box,color=blue];
		j3899563086 -> j3517542075;
		j3899563086 -> j2174507784;
	j3517542075 [label="我確實在乎他們。但我也非常在乎你。",shape=box,color=red];
		j3517542075 -> j4113744776;
	j2174507784 [label="我應該猜到你很快就會發現了。",shape=box,color=red];
		j2174507784 -> j511427541;
	j4113744776 [label="（西語）哎呀，好的\n這也很難怪你，你這麼見多識廣\n行走天下\n只是別叫我參與其中了\n這件事我沒問題",shape=box,color=blue];
		j4113744776 -> j1279477;
	j511427541 [label="我作弊了\n愛琳娜警告過我\n哈哈，她還真是個糟糕的八卦女王",shape=box,color=blue];
		j511427541 -> j1315434965;
	j1279477 [label="但就是別碰六煞成員\n（西語）不要碰我家人，拜託好嗎？\n這樣我就得用消毒棉片擦拭身體一週了",shape=box,color=blue];
		j1279477 -> j670669270;
	j1315434965 [label="這也很難怪你，你這麼見多識廣\n行走天下\n只是別叫我參與其中了\n這件事我沒問題",shape=box,color=blue];
		j1315434965 -> j1279477;
	j670669270 [label="+20 Chemistry",color=orange];
		j670669270 -> j1093324719;
	j1093324719 [label="小太陽，你已經對我變得非常重要了\n如果他們為你帶來快樂的話\n但願他們為我帶來同樣快樂\n就這麼簡單",shape=box,color=blue];
		j1093324719 -> j1795405165;
	j1795405165 [label="哦\n還有，哪天找個方法，把他們帶來這裡\n我想認識他們",shape=box,color=blue];
		j1795405165 -> j2731145241;
		j1795405165 -> j3435135764;
	j2731145241 [label="遵命，女士。 : )",shape=box,color=red];
		j2731145241 -> j3702107533;
	j3435135764 [label="我來想辦法。 ; )",shape=box,color=red];
		j3435135764 -> j3702107533;
