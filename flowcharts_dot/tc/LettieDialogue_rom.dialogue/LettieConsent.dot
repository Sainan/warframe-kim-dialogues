		2787 -> 2789;
	2790 [label="我想和你說件事，我想確認你的想法。",shape=box,color=red];
		2790 -> 2791;
	2789 [label="Chat ends.",color=orange];
	2791 [label="對我來說更重要的是，希望你不會覺得我在騙你或以任何方式對你不忠。",shape=box,color=red];
