	"Chat ends." [color=orange];
	j1852549966 [label="是 Neenah\n我的寶貝鼠之一\n今早，瘦女士帶她走了",shape=box,color=blue];
		j1852549966 -> j2868534239;
		j1852549966 -> j2048334425;
	j2868534239 [label="呃……一旦年度重置，她就會回來了不是？",shape=box,color=red];
		j2868534239 -> j425577897;
	j2048334425 [label="哦，不……莉蒂，我為你的憾事感到抱歉。 : (",shape=box,color=red];
		j2048334425 -> j1632024809;
	j425577897 [label="是的\n她會\n但那就是生命的本質\n稍縱即逝",shape=box,color=blue];
		j425577897 -> j2712733174;
	j1632024809 [label="謝謝\n但那就是生命的本質\n稍縱即逝",shape=box,color=blue];
		j1632024809 -> j2712733174;
	j2712733174 [label="鼠的壽命比人短\n人的壽命比樹短\n樹的壽命比神短",shape=box,color=blue];
		j2712733174 -> j3436306467;
	j3436306467 [label="蟲的壽命比鼠短\n這都是相對的\n而我們就是不斷地循環下去，對吧，哈哈",shape=box,color=blue];
		j3436306467 -> j4110013845;
	j4110013845 [label="我想我們就是阿米爾所形容的「極端個案」\n還什麼的",shape=box,color=blue];
		j4110013845 -> j240202877;
		j4110013845 -> j1947500901;
	j240202877 [label="你是想說什麼？",shape=box,color=red];
		j240202877 -> j3476985618;
	j1947500901 [label="所以你不會難過？",shape=box,color=red];
		j1947500901 -> j1811979336;
	j3476985618 [label="（西語）別讓我看起來像個笨蛋，趕緊去做你擅長的事\n我只是想說\n我們要記得活在當下",shape=box,color=blue];
		j3476985618 -> j3324921340;
	j1811979336 [label="（西語）我當然會\n我只是想說\n我們要記得活在當下",shape=box,color=blue];
		j1811979336 -> j3324921340;
	j3324921340 [label="這就是為什麼我會養老鼠的主要原因\n牠們的生命很短暫，但牠們永遠不會忘記好好過活\n每塊麵包屑之中都能盡可能找到歡樂\n並懂得知恩圖報\n永遠不知道什麼時候會離開",shape=box,color=blue];
		j3324921340 -> "Chat ends.";
