digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"LettieRank6Convo8 begins." [color=orange];
		"LettieRank6Convo8 begins." -> j775755487;
	j775755487 [label="我聽說了發生在卡婭身上的事\n關於某個男蟲對她做過的事",shape=box,color=blue];
		j775755487 -> j1408496936;
		j775755487 -> j3990864709;
	j1408496936 [label="呃喔。",shape=box,color=red];
		j1408496936 -> j1478071955;
	j3990864709 [label="是喔……",shape=box,color=red];
		j3990864709 -> j1478071955;
	j1478071955 [label="我不知道怎麼做到\n我不知道這是否可能\n但你這樣就打破了時空的法則",shape=box,color=blue];
		j1478071955 -> j2954927683;
	j2954927683 [label="我要找到他\n我要把他帶來這裡\n我要讓他坐在我們所有人面前",shape=box,color=blue];
		j2954927683 -> j86563883;
		j2954927683 -> j2841451551;
	j86563883 [label="然後呢？",shape=box,color=red];
		j86563883 -> j2170832966;
	j2841451551 [label="我們不能隨便去傷害某個青少年。",shape=box,color=red];
		j2841451551 -> j2601710986;
	j2170832966 [label="我要讓他感受一下當那個害怕的人，而且全世界與他作對是什麼樣的感覺\n當每個人都在嘲笑他\n嘲弄他時",shape=box,color=blue];
		j2170832966 -> j2725377030;
	j2601710986 [label="誰說要打算那樣做了\n我最清楚這種人了\n全都是膽小鬼，躲在自以為安全的地方亂講話",shape=box,color=blue];
		j2601710986 -> j2170832966;
	j2725377030 [label="你知道以我這個樣子長大是什麼感覺嗎？\n講話像我\n穿著像我\n而在軍事基地裡，身邊全是不像我的孩子",shape=box,color=blue];
		j2725377030 -> j564646669;
	j564646669 [label="我經常被打得鼻青臉腫回家，因為我會為自己挺身而出\n我媽媽總是責備我叫我應該要低調點\n（西語）叫我閉嘴？\n門都沒有",shape=box,color=blue];
		j564646669 -> j580547789;
	j580547789 [label="Check boolean KayaFutureWin2",color=orange];
		j580547789 -> j846885071 [label=true,color=green];
		j580547789 -> j1389174330 [label=false,color=brown];
	j846885071 [label="我並不怪卡婭想要逃離\n如果可以的話，我也會這麼做\n但\n有留意到她並未永遠離去嗎？",shape=box,color=blue];
		j846885071 -> j1279338565;
		j846885071 -> j3754618190;
	j1389174330 [label="我並不怪卡婭想要逃離\n如果可以的話，我也會這麼做\n當她長大一些，這種想法就會消失了",shape=box,color=blue];
		j1389174330 -> j1590512096;
		j1389174330 -> j2246740513;
	j1279338565 [label="沒有。",shape=box,color=red];
		j1279338565 -> j2356963820;
	j3754618190 [label="這是因為只有她才有辦法幫忙進行時空探研。",shape=box,color=red];
		j3754618190 -> j3120686298;
	j1590512096 [label="我很難過沒能幫到她。",shape=box,color=red];
		j1590512096 -> j3982352613;
	j2246740513 [label="這是你能幫到她的事嗎？",shape=box,color=red];
		j2246740513 -> j3982352613;
	j2356963820 [label="哈哈，提醒我永遠不要把你設為緊急聯絡人\n是的，她會離開一陣子然而她又會回來這裡\n為了時空什麼碗糕的\n但我想也為了……我們",shape=box,color=blue];
		j2356963820 -> j1296034084;
	j3120686298 [label="是啊，時空什麼碗糕的\n但我想也為了……我們",shape=box,color=blue];
		j3120686298 -> j1296034084;
	j3982352613 [label="有時候只是需要時間\n但如果可以的話，我會盡量幫助她\n月君知道她對醫學科學有足夠興趣，哈哈\n（西語）她總是問一些毛骨悚然的問題",shape=box,color=blue];
		j3982352613 -> j4206918522;
	j1296034084 [label="我喜歡她在身邊\n我想她知道這點\n不過她喜歡在手術中協助我……\n（西語）她總是問一些毛骨悚然的問題",shape=box,color=blue];
		j1296034084 -> j1531432992;
	j4206918522 [label="沒辦法她會瞬間移動\n我喜歡看她嚇阿米爾\n那個快速的混蛋活該，他經常對我們這麼做，哈哈",shape=box,color=blue];
		j4206918522 -> "Chat ends.";
	j1531432992 [label="沒辦法她會瞬間移動\n我喜歡看她嚇阿米爾\n那個快速的混蛋活該，他經常對我們這麼做，哈哈\n希望她永遠不要就這樣一去不回",shape=box,color=blue];
		j1531432992 -> "Chat ends.";
	"Chat ends." [color=orange];
}