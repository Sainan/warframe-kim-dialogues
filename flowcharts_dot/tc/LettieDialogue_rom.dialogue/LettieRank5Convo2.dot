		1842 -> 1845;
	1840 [label="但人會犯錯，而人也會承擔責任。而你在這裡，試圖修補這些錯誤。所以……我看到的是一個嘗試彌補自己所犯的錯，努力去做正確的事的人。",shape=box,color=red];
