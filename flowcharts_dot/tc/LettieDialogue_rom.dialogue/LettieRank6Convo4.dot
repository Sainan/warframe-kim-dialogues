	"LettieRank6Convo4 begins." [color=orange];
		"LettieRank6Convo4 begins." -> j1350559949;
		"LettieRank6Convo4 begins." -> j4251116957;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j4251116957 [label="你還好嗎？",shape=box,color=red];
		j4251116957 -> j3874390277;
	"Chat ends." [color=orange];
	j3874390277 [label="（西語）呃，就醬\n一如往常\n事情會過去，它們總會過去",shape=box,color=blue];
		j3874390277 -> j3945334228;
		j3874390277 -> j1149028771;
	j3945334228 [label=": ( 很抱歉聽你經歷這一切。",shape=box,color=red];
		j3945334228 -> j2554187398;
	j1149028771 [label="發生什麼事了嗎？",shape=box,color=red];
		j1149028771 -> j1667776923;
	j2554187398 [label="（西語）又是那些蜘蛛\n又把我腦海當自己家了\n牠們會離開的",shape=box,color=blue];
		j2554187398 -> j701862244;
	j1667776923 [label="不，沒什麼新鮮事\n（西語）又是那些蜘蛛\n又把我腦海當自己家了\n牠們會離開的",shape=box,color=blue];
		j1667776923 -> j701862244;
	j701862244 [label="有時候我會希望\n它可以像問題那樣輕鬆解決\n這樣我就可以解決它了，對吧？\n把它講出來，打一頓，哈哈",shape=box,color=blue];
		j701862244 -> j4019341768;
	j4019341768 [label="問題可被解決\n問題會有答案\n（西語）但情感無法被解決\n相信我，試過了",shape=box,color=blue];
		j4019341768 -> j2991552376;
		j4019341768 -> j3427963296;
	j2991552376 [label="但，你有千百種快樂的理由說。",shape=box,color=red];
		j2991552376 -> j3998660117;
	j3427963296 [label="我在渡域的慘痛經歷讓我意識到，有時「修復情感」是更糟的選擇。",shape=box,color=red];
		j3427963296 -> j1748377084;
	j3998660117 [label="哎，是，我知道\n我知道我有\n而有時候，我希望\n人們能夠了解那部分的我\n永遠不會讓我接受這件事",shape=box,color=blue];
		j3998660117 -> j1376615311;
	j1748377084 [label="是的……\n雖然有時候會很想，哈哈\n就很希望它們能夠徹底消失\n但你已經告訴過我會發生什麼事\n當一切都變得麻木時",shape=box,color=blue];
		j1748377084 -> j4283507363;
	j1376615311 [label="我希望我能有所不同\n但我就是我\n而且我已經放棄為這件事道歉\n在更早之前",shape=box,color=blue];
		j1376615311 -> "Chat ends.";
	j4283507363 [label="不希望這件事發生在任何人身上\n好吧，可能阿爾布雷希特除外\n（西語）那混蛋\n因為他心性冷血",shape=box,color=blue];
		j4283507363 -> j1768563116;
		j4283507363 -> j4008929625;
	j1768563116 [label="我們可以做點什麼來讓你放空不去多想？還是你想待在這裡？",shape=box,color=red];
		j1768563116 -> j1681729241;
	j4008929625 [label="我們只能希望他在打持久戰。",shape=box,color=red];
		j4008929625 -> j3124488495;
	j1681729241 [label="咦，好問題\n老實說，不清楚\n待在這裡或許比較好\n或是，我們可以出去殺殺東西\n（西語）待這裡好？還是殺東西好？\n好難抉擇……",shape=box,color=blue];
		j1681729241 -> j3895531648;
		j1681729241 -> j3006204560;
	j3124488495 [label="我唯一希望牽扯到那混帳的一件事\n就是搭乘電梯\n跟我一起\n而我手持棒球棍",shape=box,color=blue];
		j3124488495 -> j3108984768;
	j3895531648 [label="我投待這裡一票。",shape=box,color=red];
		j3895531648 -> j2733555398;
	j3006204560 [label="我投殺東西一票。",shape=box,color=red];
		j3006204560 -> j2801160099;
	j3108984768 [label="腦中閃過那個畫面簡直都讓我興奮不已",shape=box,color=blue];
		j3108984768 -> j3819368348;
	j2733555398 [label="好主意\n坐酒吧跟米和韋\n或許打個一輪牌\n可以放空不多想",shape=box,color=blue];
		j2733555398 -> j3819368348;
	j2801160099 [label="哈哈，好主意\n把痛苦從腦海中解放\n放到其他人的腦海中",shape=box,color=blue];
		j2801160099 -> j3819368348;
