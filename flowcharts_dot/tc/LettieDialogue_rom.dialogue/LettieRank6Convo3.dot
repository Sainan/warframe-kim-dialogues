	j441350601 [label="唉，你真無趣\n總之\n（西語）別讓我分心",shape=box,color=blue];
		j441350601 -> j429349343;
	j991739034 [label="哈，只是跟你開個玩笑。別太認真。",shape=box,color=red];
		j991739034 -> j2766362969;
	j3857784108 [label="我能說聲抱歉嗎？為了我說的那些讓你不高興的話。我覺得我無意中踩到你的雷了。",shape=box,color=red];
		j3857784108 -> j1528277216;
	j2869565564 [label="哈哈，不是，不過有可能\n很誘人\n我在想也許我們可以蓋個溫室",shape=box,color=blue];
		j2869565564 -> j84323408;
	j1666057094 [label="我在想\n那麼大一片平面空間\n也許我們可以蓋個溫室",shape=box,color=blue];
		j1666057094 -> j84323408;
	j1538510373 [label="唉，你真無趣\n好吧，心肝\n總之\n（西語）別讓我分心",shape=box,color=blue];
		j1538510373 -> j429349343;
	j3664307834 [label="唉，你真無趣\n好吧，小太陽\n總之\n（西語）別讓我分心",shape=box,color=blue];
		j3664307834 -> j429349343;
	j2766362969 [label="是是\n就知道\n（西語）別讓我分心",shape=box,color=blue];
		j2766362969 -> j429349343;
	j1528277216 [label="……\n啊──該死\n是──好的\n不能一直對亞瑟說教要他放下過去\n如果連我自己都做不到的話",shape=box,color=blue];
		j1528277216 -> j1316507292;
	j84323408 [label="能夠理解今天或明天都不會建好\n或許短時間內都不會\n但光想就覺得很不錯\n（西語）你覺得怎樣？",shape=box,color=blue];
		j84323408 -> j3715881094;
		j84323408 -> j3710097075;
		j84323408 -> j2585936643;
	j1316507292 [label="Boolean LettieNoDate is now false.",color=orange];
		j1316507292 -> j2071780206;
	j3715881094 [label="哦，我們可以種些新鮮蔬菜。",shape=box,color=red];
		j3715881094 -> j233924986;
	j3710097075 [label="對你的小鬆餅們會很棒。 : ) 可以放心地讓牠們在陽光底下玩一會兒。",shape=box,color=red];
		j3710097075 -> j1402837544;
	j2585936643 [label="我喜歡！但為什麼會選擇溫室？",shape=box,color=red];
		j2585936643 -> j4078517258;
	j2071780206 [label="（西語）原諒你了\n你得到原諒了\n只是別讓我後悔餒，好嗎，呆呆？ ",shape=box,color=blue];
		j2071780206 -> j55233874;
	j233924986 [label="是啊，是啊\n比如，新鮮食物。（西語）再叫我吃披薩的話，我可能要抓狂了\n我還可以種植萬壽菊花\n但是……呃，別笑",shape=box,color=blue];
		j233924986 -> j4004457909;
	j1402837544 [label="+5 Chemistry",color=orange];
		j1402837544 -> j1914965391;
	j4078517258 [label="很多原因\n比如，新鮮食物。（西語）再叫我吃披薩的話，我可能要抓狂了\n我還可以種植萬壽菊花\n但是……呃，別笑",shape=box,color=blue];
		j4078517258 -> j4004457909;
	j55233874 [label="總之\n（西語）別讓我分心",shape=box,color=blue];
		j55233874 -> j429349343;
	j4004457909 [label="那是給愛琳娜的",shape=box,color=blue];
		j4004457909 -> j1449379922;
		j4004457909 -> j4246132577;
		j4004457909 -> j2791787269;
	j1914965391 [label="唉，別讓我哭了\n你還想到我的小鬆餅們，真是太感動了\n謝謝\n我還在想別的事\n但是……呃，別笑",shape=box,color=blue];
		j1914965391 -> j4004457909;
	j1449379922 [label="我記得她喜歡植物。我覺得她肯定會喜歡的。",shape=box,color=red];
		j1449379922 -> j3032115704;
	j4246132577 [label="我只是很高興你倆和好了。",shape=box,color=red];
		j4246132577 -> j4078737066;
	j2791787269 [label="我為什麼要笑？",shape=box,color=red];
		j2791787269 -> j3083680652;
	j3032115704 [label="這裡太沉悶了\n（西語）我們沒必要讓它更陰鬱和骯髒\n寧願她和植物說話，而不是……\n嗯……和槍說話……",shape=box,color=blue];
		j3032115704 -> j2002347201;
	j4078737066 [label="是的\n有時候放下很不容易\n接受事情可以改變很困難\n寧願她和植物說話，而不是……\n嗯……和槍說話……",shape=box,color=blue];
		j4078737066 -> j2002347201;
	j3083680652 [label="她和我一直都不是最要好的「閨蜜」\n有時候放下很不容易\n接受事情可以改變很困難\n寧願她和植物說話，而不是……\n嗯……和槍說話……",shape=box,color=blue];
		j3083680652 -> j2002347201;
	j2002347201 [label="但我發現當她微笑時\n我也會跟著微笑\n這更可能是她施的巫法吧，哈哈",shape=box,color=blue];
		j2002347201 -> j1933954278;
	j1933954278 [label="不管怎樣\n真心覺得會很棒\n「死寂商場」並不需要真的了無生機",shape=box,color=blue];
