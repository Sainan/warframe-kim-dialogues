		j2243648749 -> j2527143540;
	j1117754135 [label="我以為你們倆個合得來說，哈哈。",shape=box,color=red];
		j1117754135 -> j2993035235;
	j2527143540 [label="哈哈，不\n有更多人陪伴很好啊\n特別是那個，她能照顧好自己\n有個我不用擔心要從地板上刮起屍塊的人在身邊真好",shape=box,color=blue];
		j2527143540 -> j992248683;
	j2993035235 [label="哈哈\n你想暗示什麼？！\n有更多人陪伴很好啊\n特別是那個，她能照顧好自己\n有個我不用擔心要從地板上刮起屍塊的人在身邊真好",shape=box,color=blue];
		j2993035235 -> j992248683;
	j992248683 [label="而且那個韋利米爾會讓我為之動容\n我很欣賞一個清楚知道自己是誰的男人\n（西語）一個對自己真誠和忠實的男人，對吧？\n前幾天他還讓葵給他塗腳趾甲，哈哈\n邊塗邊聊他最愛的自由國經典肌肉車\n毫不在意",shape=box,color=blue];
		j992248683 -> j1683220004;
	j1683220004 [label="不知道還有沒有更多這類人到來\n但這是很長久以來的第一次\n有點希望會有",shape=box,color=blue];
		j1683220004 -> "Chat ends.";
	"Chat ends." [color=orange];
}