		j777855750 -> j2958604592;
		j777855750 -> j340366089;
		j777855750 -> j1579679105;
	j3136806464 [label="美。",shape=box,color=blue];
		j3136806464 -> j2888608214;
	j4290497565 [label="多麼美好的一瞬間。",shape=box,color=blue];
		j4290497565 -> j918012326;
	j3702268292 [label="它有一種獨特的美。",shape=box,color=blue];
		j3702268292 -> j4290874667;
	j954751531 [label="美。",shape=box,color=blue];
		j954751531 -> j2888608214;
	j3227726260 [label="當中蘊含著美。",shape=box,color=blue];
		j3227726260 -> j4290874667;
	j842833783 [label="如此大肆殺戮？其美難以掩蓋。",shape=box,color=blue];
		j842833783 -> j3609398078;
	j3108028208 [label="多麼美好的一瞬間。",shape=box,color=blue];
		j3108028208 -> j918012326;
	j2958604592 [label="你說得好像這是一種……藝術形式。",shape=box,color=red];
		j2958604592 -> j243941662;
	j340366089 [label="我不喜歡被迫取人性命，羅瑟。",shape=box,color=red];
		j340366089 -> j1625996162;
	j1579679105 [label="那你最喜歡的是什麼？",shape=box,color=red];
		j1579679105 -> j397554585;
	j2888608214 [label="Boolean RoatheWeaponBow is now true.",color=orange];
		j2888608214 -> j2958604592;
		j2888608214 -> j340366089;
		j2888608214 -> j1579679105;
	j918012326 [label="Boolean RoatheWeaponDagger is now true.",color=orange];
		j918012326 -> j2958604592;
		j918012326 -> j340366089;
		j918012326 -> j1579679105;
	j4290874667 [label="Boolean RoatheWeaponSniper is now true.",color=orange];
		j4290874667 -> j2958604592;
		j4290874667 -> j340366089;
		j4290874667 -> j1579679105;
	j3609398078 [label="Boolean RoatheWeaponPoison is now true.",color=orange];
		j3609398078 -> j2958604592;
		j3609398078 -> j340366089;
		j3609398078 -> j1579679105;
	j243941662 [label="因為它就是。而且你也心知肚明。實際上，你存在的另一半，從字面上講，都是建立在將殺戮視為一種藝術形式這一概念之上的！",shape=box,color=blue];
		j243941662 -> j312901116;
	j1625996162 [label="喔？真的嗎？讓我們花點時間來好好審視一下。",shape=box,color=blue];
		j1625996162 -> j4138930450;
	j397554585 [label="它最近改變了。而且這讓我非常困擾。",shape=box,color=blue];
		j397554585 -> j2720915436;
		j397554585 -> j2848733788;
	j312901116 [label="我看到了 Tenno 所運用的「學派」，以及你間接借用的那些力量。更不用說 禁衛的教誨了。他們會在通訊頻道裡無休止地嘮叨個沒完，即便我們告訴他們那是限制頻道多少次也沒用。",shape=box,color=blue];
		j312901116 -> j3706322172;
	j4138930450 [label="告訴我一件事，請誠實地回答。因為在這個時刻說謊對你我都沒有好處，尤其是你自己：",shape=box,color=blue];
		j4138930450 -> j3005948852;
	j2720915436 [label="改變了？如何改變？",shape=box,color=red];
		j2720915436 -> j2588350958;
	j2848733788 [label="因為 Uriel？",shape=box,color=red];
		j2848733788 -> j1169964438;
	j3706322172 [label="如果我再也不用去聽他們中的任何一人對我說「我是一把刀」和「我存在的意義就是攻擊」，那麼我就死而無憾了，篡位者。",shape=box,color=blue];
		j3706322172 -> j3957528159;
	j3005948852 [label="你是否曾想過為自己裝備一把武器或是一個 Warframe 並完全依照你個人品味客製化的？也許是獨特的塗裝，或是一個你覺得更符合你心情的外觀？",shape=box,color=blue];
		j3005948852 -> j1344948312;
		j3005948852 -> j599614671;
		j3005948852 -> j2770525221;
	j2588350958 [label="我以前偏愛以劍為武器。優雅。迅捷。我能在戰場中穿梭，在近身範圍內斬殺敵人。銀色的刀刃上染著鮮紅，在藍色星辰的光芒下閃耀。",shape=box,color=blue];
		j2588350958 -> j4151580951;
	j1169964438 [label="我想應該就是這樣。或許是因為我缺失了一些記憶。我不知道還有什麼其他原因。",shape=box,color=blue];
		j1169964438 -> j2588350958;
	j3957528159 [label="人類歷來視「謀殺」為罪行，卻視「殺戮」為藝術。你難道從未覺得這很奇怪嗎？揮舞利刃，在戰鬥中擊敗敵人，被視為近乎超凡脫俗的存在。",shape=box,color=blue];
		j3957528159 -> j834292975;
	j1344948312 [label=" 我有……但跟這這件事有什麼關係？",shape=box,color=red];
		j1344948312 -> j3048496259;
	j599614671 [label="沒有。從來都沒有。",shape=box,color=red];
		j599614671 -> j2917398192;
	j2770525221 [label="我不想跟你玩這個。 [結束]",shape=box,color=red];
		j2770525221 -> j578323833;
	j4151580951 [label="但現在呢？現在我只想嚐嚐牙齒上的血腥味，感受鮮血在利爪下噴湧而出的感覺。我只想把手指深深插入血肉和骨骼，將它們撕成碎片。",shape=box,color=blue];
		j4151580951 -> j1012766454;
	j834292975 [label="在小巷裡用磨尖的金屬片殺人，是懦夫和墮落的行為。 ",shape=box,color=blue];
		j834292975 -> j2257958116;
	j3048496259 [label="我很欣賞你的坦誠。現在，我不否認你可能從不享受冷血謀殺，殺害無辜生命也不是你會感到愉悅的事情（儘管也許你確實如此，你之前的說法是謊言，如果能揭穿這一點該多麼令人興奮啊，但這並非我們今天要討論的重點）。",shape=box,color=blue];
		j3048496259 -> j520591183;
	j2917398192 [label="請你花點時間好好想想。我親眼看到你的 Tenno 朋友們在這裡橫衝直撞，就像一群五彩斑斕的馬戲團噩夢，如同野獸掉進了藝術家的顏料罐裡。 ",shape=box,color=blue];
		j2917398192 -> j2750258043;
	j578323833 [label="非常好。",shape=box,color=blue];
		j578323833 -> "Chat ends.";
	j1012766454 [label="我想痛飲那些鮮血，同時折斷筋腱，感受身軀在我身下撕裂成血淋淋的碎片。像剝開甜美的果實一樣，將它層層剝開，讓骨髓流動。",shape=box,color=blue];
		j1012766454 -> j4050944820;
		j1012766454 -> j1759736060;
	j2257958116 [label="差別是什麼？ 是「榮譽」？誰來決定什麼是榮譽，什麼是不榮譽？是失敗者？還是勝利者？或者只是因為有足夠的傳統來界定什麼是榮譽，什麼是不榮譽？",shape=box,color=blue];
		j2257958116 -> j3252945005;
		j2257958116 -> j3165469385;
		j2257958116 -> j3757133241;
	j520591183 [label="但假設情況並非如此，你只是像你所說的那樣因為「不得不」殺人，那麼請問，你為什麼要花時間以個性化的方式裝備你的殺人武器呢？",shape=box,color=blue];
		j520591183 -> j3137523624;
	j2750258043 [label="你從未感到過你必須這樣做嗎？一次也沒有？我向你保證，即使你承認這一點，我也不會因此而看不起你。",shape=box,color=blue];
		j2750258043 -> j3553771704;
		j2750258043 -> j3090973975;
	j4050944820 [label="羅瑟？",shape=box,color=red];
		j4050944820 -> j2004501160;
	j1759736060 [label="這……對你來說不正常嗎？",shape=box,color=red];
		j1759736060 -> j74459889;
	j3252945005 [label="我明白你的意思。界線確實有點模糊。 ",shape=box,color=red];
		j3252945005 -> j53541149;
	j3165469385 [label="一種需要練習和投入，另一種則純粹是……殘暴。",shape=box,color=red];
		j3165469385 -> j2134807048;
	j3757133241 [label="我不想參與這場對話。[結束]",shape=box,color=red];
		j3757133241 -> j3180246391;
	j3137523624 [label="為什麼要在意自己在死亡戰場上的形象？當然不是為了方便別人辨認你的屍體。你這副模樣，誰也認不出來。不，因為如果你非要當殺人犯，我親愛的篡位者，我敢打賭，你肯定想死得轟轟烈烈。",shape=box,color=blue];
		j3137523624 -> j1533556633;
	j3553771704 [label="不。",shape=box,color=red];
		j3553771704 -> j578323833;
	j3090973975 [label="好，我有。又如何？",shape=box,color=red];
		j3090973975 -> j3048496259;
	j2004501160 [label="是的，我知道！我知道。但我不會做這些事，請注意。我也不會把周圍的一切都燒成灰燼，儘管我很想這麼做。",shape=box,color=blue];
		j2004501160 -> j3988054101;
	j74459889 [label="不！絕對不是！想到要把周圍的東西都燒成灰燼，我就流口水了，這也不正常！",shape=box,color=blue];
		j74459889 -> j3988054101;
	j53541149 [label="所有這類的界線都是武斷劃分的。我們越早理解這一點，就能越快就哪些戰鬥值得打、哪些不值得打達成共識。",shape=box,color=blue];
		j53541149 -> j1051267315;
	j2134807048 [label="很好，就讓我們把這種推理推演下去。殺戮只要足夠熟練就變得有榮譽可言？所以你的意思是，如果我像禁衛一樣，只是用足夠的排場和儀式來包裝我的謀殺，它就成了藝術？",shape=box,color=blue];
		j2134807048 -> j4231125340;
	j3180246391 [label="很好。",shape=box,color=blue];
		j3180246391 -> "Chat ends.";
	j1533556633 [label="那如果不是享受行為本身，那又是什麼呢？",shape=box,color=blue];
		j1533556633 -> j3000844161;
	j3988054101 [label="肯定是 Uriel 的錯。雖然我承認我以前也有這種毀滅性和嗜血的念頭，但遠沒有這麼具有毀滅性。",shape=box,color=blue];
		j3988054101 -> j2811965030;
	j1051267315 [label="判斷一場殺戮是否光榮，就像試圖決定被火燒死或用水溺斃哪種更糟糕一樣。兩者都是悲慘的死法。",shape=box,color=blue];
		j1051267315 -> j2246734087;
	j4231125340 [label="現在我們正在遊走在儀式和宗教的邊緣。",shape=box,color=blue];
		j4231125340 -> j3201245725;
	j3000844161 [label="不要誤會我！我不是在評判你。你只是在盡力應對你的處境！在這場生命的巨大鬧劇中，死亡將你選為她的舞伴，而你別無選擇，只能聽從她的召喚。",shape=box,color=blue];
		j3000844161 -> j1092621087;
	j2811965030 [label="而且肯定不會如此……毀天滅地。",shape=box,color=blue];
		j2811965030 -> "Chat ends.";
	j2246734087 [label="殊途同歸，又何必斤斤計較？我們還有更重要的問題需要解決。",shape=box,color=blue];
		j2246734087 -> "Chat ends.";
	j3201245725 [label="至少，用刀捅死這種簡單直接的死法還有點坦誠。它不帶任何虔誠，也不張揚或矯飾。事情就是這樣發生了。",shape=box,color=blue];
		j3201245725 -> j3670952556;
	j1092621087 [label="如果你放下武器，我倒是好奇你身邊將會有多少人死掉？不，為什麼不在你的工作中尋求一點點驕傲？從這整個「藝術」中獲得一點樂趣呢？我問你，替代方案是什麼？瘋狂？還是湮滅？",shape=box,color=blue];
		j1092621087 -> j3305103966;
	j3670952556 [label="難道這其中就沒有藝術性嗎？",shape=box,color=blue];
		j3670952556 -> "Chat ends.";
	j3305103966 [label="我看過太多人走上這條路而最後落得絞刑的下場。不，我說，篡位者，隨你便。因為人生始終會按照它的計劃來打造你。",shape=box,color=blue];
		j3305103966 -> "Chat ends.";
}