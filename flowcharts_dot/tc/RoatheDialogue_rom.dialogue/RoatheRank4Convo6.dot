digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank4Convo6 begins." [color=orange];
		"RoatheRank4Convo6 begins." -> j3740842678;
	j3740842678 [label="篡位者，你最喜歡用哪一種方式殺人？",shape=box,color=blue];
		j3740842678 -> j3593663929;
		j3740842678 -> j3971785986;
		j3740842678 -> j1350559949;
	j3593663929 [label="什麼？",shape=box,color=red];
		j3593663929 -> j3906344438;
	j3971785986 [label="你是想親自試試看嗎？",shape=box,color=red];
		j3971785986 -> j4016726500;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j3906344438 [label="我只是最近發現自己變得喜歡談論哲學，純粹是出於好奇。",shape=box,color=blue];
		j3906344438 -> j2819244076;
	j4016726500 [label="哈！才沒有。不過……跟你交手幾回合倒是會很有趣。不，我只是最近發現自己變得喜歡談論哲學，純粹是出於好奇。",shape=box,color=blue];
		j4016726500 -> j2819244076;
	"Chat ends." [color=orange];
	j2819244076 [label="論數量，我想你我可能勢均力敵。論殺傷力，嗯……我不想下賭注，我對這種比喻性的量劍比長度式討論也沒太大興趣。",shape=box,color=blue];
		j2819244076 -> j3864083509;
	j3864083509 [label="以殺手的身份問你。你更喜歡哪一種？你喜歡近身肉搏嗎？你喜歡潛行，還是喜歡戰場上的混亂？",shape=box,color=blue];
		j3864083509 -> j2469276639;
		j3864083509 -> j3488493879;
		j3864083509 -> j1596049682;
		j3864083509 -> j2611648681;
	j2469276639 [label="我更喜歡混亂。爆炸。槍聲。巨響。越多越好。",shape=box,color=red];
		j2469276639 -> j1542984661;
	j3488493879 [label="潛行。我喜歡在敵人察覺到我之前就解決掉他們。如果可以的話，我會在他們睡覺的地方動手。",shape=box,color=red];
		j3488493879 -> j111576086;
	j1596049682 [label="我討厭戰鬥。我希望我永遠不必戰鬥。",shape=box,color=red];
		j1596049682 -> j2527595664;
	j2611648681 [label="這種對話令人作嘔。",shape=box,color=red];
		j2611648681 -> j606862455;
	j1542984661 [label="Boolean RoatheSoldier is now true.",color=orange];
		j1542984661 -> j1547169096;
	j111576086 [label="Boolean RoatheAssassin is now true.",color=orange];
		j111576086 -> j1962513655;
	j2527595664 [label="哦，我可憐的、可憐的篡位者，要是你能親耳聽到我的笑聲就好了……",shape=box,color=blue];
		j2527595664 -> j2525413979;
	j606862455 [label="那麼，走吧。",shape=box,color=blue];
		j606862455 -> "Chat ends.";
	j1547169096 [label="像我一樣飽經戰火的士兵。考慮到我對你過往事蹟的了解，我並不驚訝。你在哪裡，鮮血就在哪裡。先是渡域，然後是「那爾邁」，再之後就是霍爾瓦尼亞。現在又輪到這裡。",shape=box,color=blue];
		j1547169096 -> j2242285796;
	j1962513655 [label="啊，我們中間竟然藏著一位刺客！他們如此有用，卻又如此不被賞識。我一直覺得刺客就像是技藝高超的管家。",shape=box,color=blue];
		j1962513655 -> j1384107373;
	j2525413979 [label="你這個悲慘、貧乏的生物。我希望你是騙我的，否則這樣對你沒有好處。",shape=box,color=blue];
		j2525413979 -> j2573410740;
	j2242285796 [label="誰知道還有什麼，或是之後發生了什麼，或是你這段時間忘記了什麼。死亡是你的藝術，你用它來描繪世界。",shape=box,color=blue];
		j2242285796 -> j4005294004;
	j1384107373 [label="當他們把工作做得非常出色時，往往不為人知。",shape=box,color=blue];
		j1384107373 -> j796751773;
	j2573410740 [label="+20 Chemistry",color=orange];
		j2573410740 -> j3732451754;
	j4005294004 [label="所以，你最喜歡的畫筆是什麼？讓我們深入探討。",shape=box,color=blue];
		j4005294004 -> j533743000;
		j4005294004 -> j960437079;
		j4005294004 -> j1954668610;
		j4005294004 -> j3428705018;
	j796751773 [label="所以，是匕首？毒藥？弓箭？",shape=box,color=blue];
		j796751773 -> j124030700;
		j796751773 -> j4194714515;
		j796751773 -> j4179725389;
		j796751773 -> j2003858182;
		j796751773 -> j4171209991;
	j3732451754 [label="否則，那可能是我這麼多年聽過的最悲傷的事情了。",shape=box,color=blue];
		j3732451754 -> j2927459171;
	j533743000 [label="說實話，身邊有什麼就用什麼。我喜歡即興發揮。",shape=box,color=red];
		j533743000 -> j82325312;
	j960437079 [label="弓。優雅而致命。",shape=box,color=red];
		j960437079 -> j3538777377;
	j1954668610 [label="刀。我喜歡近身肉搏。",shape=box,color=red];
		j1954668610 -> j1287964155;
	j3428705018 [label="步槍和槍械。雖然很吵，但它們總能完成任務。",shape=box,color=red];
		j3428705018 -> j2424026544;
	j124030700 [label="說實話，身邊有什麼就用什麼。我喜歡即興發揮。",shape=box,color=red];
		j124030700 -> j230918767;
	j4194714515 [label="弓。優雅而安靜。",shape=box,color=red];
		j4194714515 -> j485730042;
	j4179725389 [label="狙擊步槍。一發子彈？一條人命。",shape=box,color=red];
		j4179725389 -> j3502537817;
	j2003858182 [label="毒藥。在他們知道自己已死之前，我就已經走了。",shape=box,color=red];
		j2003858182 -> j170486521;
	j4171209991 [label="匕首。我喜歡它近距離的親密感。",shape=box,color=red];
		j4171209991 -> j19592774;
	j2927459171 [label="Boolean RoatheWeaponNone is now true.",color=orange];
		j2927459171 -> "Chat ends.";
	j82325312 [label="我正想像著你帶著醫療長凳在戰場上橫衝直撞。用綁在彎曲管子上的一塊輪胎撕裂士兵。",shape=box,color=blue];
		j82325312 -> j677032581;
	j3538777377 [label="在激烈的戰鬥中揮舞弓箭需要決心和清醒的頭腦，這是很少人能辦到的。當然，還需要穩定的雙手。",shape=box,color=blue];
		j3538777377 -> j2145111441;
	j1287964155 [label="嗯，小心。別讓我太興奮了，篡位者。我多麼想看到你在戰場上起舞，手持兵刃，血花四濺，如花瓣般絢爛盛開……",shape=box,color=blue];
		j1287964155 -> j973691873;
	j2424026544 [label="篡位者，從它被發明的那一刻起就是所有戰爭中的主力，這絕非偶然。而且無法否認的是，當它們擊中目標時，使命即可完成。",shape=box,color=blue];
		j2424026544 -> j2938090460;
	j230918767 [label="我正想像著你用餐具或椅腿暗殺某人。用窗簾束帶奪走某人性命。",shape=box,color=blue];
		j230918767 -> j2103106692;
	j485730042 [label="獵手之道。雖不先進，但簡潔優雅。有時，最簡易、最古老的方法，本質上最為奏效。",shape=box,color=blue];
		j485730042 -> j3933184699;
	j3502537817 [label="對我來說，這有點不夠個人化和過於冷靜，但我不能評判它的效率。這種沉著確實有其可取之處。",shape=box,color=blue];
		j3502537817 -> j3643669426;
	j170486521 [label="陰險的藥劑師，嗯？熬製藥水並將小瓶藥劑倒入毫無防備者的酒杯之中？還是用毒液浸漬刀刃和子彈，讓戰場上最輕微的擦傷都變成致命一擊？",shape=box,color=blue];
		j170486521 -> j2360486791;
	j19592774 [label="嗯，小心。別讓我太興奮了，篡位者。這多麼誘人啊，一晚醒來，發現你潛伏於陰影之中，一把匕首蓄勢待發，準備刺下……",shape=box,color=blue];
		j19592774 -> j1619951540;
	j677032581 [label="+10 Chemistry",color=orange];
		j677032581 -> j3418940752;
	j2145111441 [label="這一切的寂靜值得欣賞。箭上弦，拉滿弓，蓄勢待發……然後當它擊中目標之時，就是最甜蜜美味的死亡？",shape=box,color=blue];
		j2145111441 -> j3279620083;
	j973691873 [label="我欣賞這種親力親為的渴望。看著受害人的四肢在你終結他們生命之時逐漸無力。看著他們毫無生氣的軀體在你面前癱倒。知道這一切都是你親手完成的，而不是別人。",shape=box,color=blue];
		j973691873 -> j3226211395;
	j2938090460 [label="髒亂、吵鬧、價格極為昂貴。但殺戮能力非常非常強。",shape=box,color=blue];
		j2938090460 -> j3863251787;
	j2103106692 [label="+10 Chemistry",color=orange];
		j2103106692 -> j1506508835;
	j3933184699 [label="這一切的寂靜值得欣賞。箭上弦，拉滿弓，蓄勢待發……然後當它擊中目標之時，就是最甜蜜美味的死亡？",shape=box,color=blue];
		j3933184699 -> j2559029769;
	j3643669426 [label="在戰場上看似無法平息的喧囂中，狙擊手必須像潮汐一樣調整呼吸。吸氣，呼氣，然後奪走一條生命。",shape=box,color=blue];
		j3643669426 -> j1349715436;
	j2360486791 [label="我曾親眼見過，士兵手臂上僅僅一個小傷口就能讓整個營隊變成一灘爛泥。一種從血液傳播到肺部，再傳到另一個人肺部的毒素就足以摧毀整個國家。",shape=box,color=blue];
		j2360486791 -> j3283362507;
	j1619951540 [label="我欣賞這種對人際互動的渴望。凝視著另一個人的眼睛，看著它們變得空洞黯淡，隨著光線漸暗，身體的溫暖也隨之消逝。",shape=box,color=blue];
		j1619951540 -> j2876467850;
	j3418940752 [label="我……無法決定這究竟是讓你更可怕還是更不可怕，篡位者。我想我還是傾向於認為你比較可怕。無論如何，我覺得這本身就很有趣，也很引人注目。",shape=box,color=blue];
		j3418940752 -> j777855750;
