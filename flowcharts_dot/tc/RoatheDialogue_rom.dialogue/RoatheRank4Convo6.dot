		j3863251787 -> j3702268292;
	j1506508835 [label="我……無法決定這究竟是讓你更可怕還是更不可怕，篡位者。我想我還是傾向於認為你比較可怕。無論如何，我覺得這本身就很有趣，也很引人注目。",shape=box,color=blue];
		j1506508835 -> j777855750;
