	"Chat ends." [color=orange];
	j279644354 [label="語音訊息：順從",shape=box,color=blue];
		j279644354 -> j3290536826;
	j3290536826 [label="文字記錄：我從一開始就明白——無論在戰場上還是在臥室裡——通過表面順從取得勝利的道路。",shape=box,color=blue];
		j3290536826 -> j2113520021;
	j2113520021 [label="敵人發現你屈服的點，你可以確信他就會往那裡推進；這樣你就能輕易絆倒他。",shape=box,color=blue];
		j2113520021 -> j3665622186;
	j3665622186 [label="他們叫我「走狗」、「哈巴狗」。Nitokh 以為自己在掌控。我多麼巧妙地誘導她。",shape=box,color=blue];
		j3665622186 -> j949743882;
	j949743882 [label="血手羅瑟。以部下屍體自肥的食人魔羅瑟。生命的揮霍者。",shape=box,color=blue];
		j949743882 -> j2148073968;
	j2148073968 [label="彷彿我只是為戰鬥而戰鬥！不。Orokin 帝國必須終結。",shape=box,color=blue];
		j2148073968 -> j2356991262;
	j2356991262 [label="為此，戰爭必須繼續。只有徹底且不可逆轉的失敗，才能推倒那七尊金色石像鬼。",shape=box,color=blue];
		j2356991262 -> j3354699936;
	j3354699936 [label="連 Nitokh 都不知道我的真心。她以為我渴望與她並肩統治。",shape=box,color=blue];
		j3354699936 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}