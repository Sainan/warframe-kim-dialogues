		2312 -> 2311;
	2315 [label="Chat ends.",color=orange];
	2311 [label="文字記錄：我從一開始就明白——無論在戰場上還是在臥室裡——通過表面順從取得勝利的道路。",shape=box,color=blue];
		2311 -> 5722;
	5722 [label="Where the enemy finds you yielding, there you can be sure he will push; and so you may easily trip him.",shape=box,color=blue];
		5722 -> 5723;
	5723 [label="“Lackey,” they called me. “Lapdog.” Nitokh thought herself in control. How subtly I guided her. ",shape=box,color=blue];
		5723 -> 2310;
	2310 [label="血手羅瑟。以部下屍體自肥的食人魔羅瑟。生命的揮霍者。",shape=box,color=blue];
		2310 -> 2314;
	2314 [label="彷彿我只是為戰鬥而戰鬥！不。Orokin 帝國必須終結。",shape=box,color=blue];
		2314 -> 5724;
	5724 [label="For that to happen, the war must continue. Only defeat, absolute and irrevocable, would topple those seven golden gargoyles.",shape=box,color=blue];
		5724 -> 2316;
	2316 [label="連 Nitokh 都不知道我的真心。她以為我渴望與她並肩統治。",shape=box,color=blue];
		2316 -> 2309;
	2309 [label="Add 1 to HellStory",color=orange];
		2309 -> 2347;
	2347 [label="{\"Id\":2347,\"Incoming\":[2309],\"Outgoing\":[2313],\"GraphPos\":[4758,-3705],\"CompletionType\":1}",color=orange];
