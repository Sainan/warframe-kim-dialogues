	"Chat ends." [color=orange];
	j2033626171 [label="VM: SUBMISSION",shape=box,color=blue];
		j2033626171 -> j1165936181;
	j1165936181 [label="文字記錄：我從一開始就明白——無論在戰場上還是在臥室裡——通過表面順從取得勝利的道路。",shape=box,color=blue];
		j1165936181 -> j334231098;
	j334231098 [label="Where the enemy finds you yielding, there you can be sure he will push; and so you may easily trip him.",shape=box,color=blue];
		j334231098 -> j2754333275;
	j2754333275 [label="“Lackey,” they called me. “Lapdog.” Nitokh thought herself in control. How subtly I guided her. ",shape=box,color=blue];
		j2754333275 -> j3017772552;
	j3017772552 [label="血手羅瑟。以部下屍體自肥的食人魔羅瑟。生命的揮霍者。",shape=box,color=blue];
		j3017772552 -> j1439731216;
	j1439731216 [label="彷彿我只是為戰鬥而戰鬥！不。Orokin 帝國必須終結。",shape=box,color=blue];
		j1439731216 -> j3862024726;
	j3862024726 [label="For that to happen, the war must continue. Only defeat, absolute and irrevocable, would topple those seven golden gargoyles.",shape=box,color=blue];
		j3862024726 -> j3354699936;
	j3354699936 [label="連 Nitokh 都不知道我的真心。她以為我渴望與她並肩統治。",shape=box,color=blue];
		j3354699936 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}