digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRepair begins." [color=orange];
		"RoatheRepair begins." -> j2688688654;
	j2688688654 [label="Evaluate expressions",color=orange];
		j2688688654 -> j409546561 [label="LyonRoatheFailFix, MarieRoatheFailFix",color=purple];
		j2688688654 -> "Chat ends." [label="false",color=purple];
	j409546561 [label="夠了！夠了。我讓步就是了！快叫你那些狂熱的打手停下來。他們比發了瘋的庫狛還糟糕！我走到哪這些該死的生物就跟到哪。我連覺都睡不成了！",shape=box,color=blue];
		j409546561 -> j1441932803;
	"Chat ends." [color=orange];
	j1441932803 [label="是什麼？ ！你想要什麼？ ！",shape=box,color=blue];
		j1441932803 -> j589137261;
		j1441932803 -> j1178528497;
		j1441932803 -> j2853983767;
	j589137261 [label="這是另一個跟你談談接受血清這件事的機會。羅瑟，是時候停止逃避了。",shape=box,color=red];
		j589137261 -> j1979205857;
	j1178528497 [label="羅瑟。服用血清並不會讓你變成懦夫。它只會讓你成為唯一倖存的 Orokin 人。接受這個事實吧。",shape=box,color=red];
		j1178528497 -> j1420398166;
	j2853983767 [label="羅瑟，接受血清並不代表你是個膽小鬼。它給了你重活一次的機會，讓你去創造真正的改變。",shape=box,color=red];
		j2853983767 -> j62611055;
	j1979205857 [label="Evaluate expressions on Thermostat counter",color=orange];
		j1979205857 -> j9365069 [label="x >= 5",color=purple];
		j1979205857 -> j3387845385 [label="x <= 0",color=purple];
		j1979205857 -> j137288027 [label="x > 0 && x < 5",color=purple];
		j1979205857 -> j137288027 [label="false",color=purple];
	j1420398166 [label="Add -5 to Thermostat counter",color=orange];
		j1420398166 -> j1979205857;
	j62611055 [label="Add 5 to Thermostat counter",color=orange];
		j62611055 -> j1979205857;
	j9365069 [label="你讓憤怒吞噬了自己。你本可以利用它來對抗那些至今仍在破壞這個世界的人。就在此刻。就在這裡。",shape=box,color=red];
		j9365069 -> j630258279;
	j3387845385 [label="你把矛頭指向了自己。你應該指向的是這個世界，那個因為你盡力拯救它脫離 Orokin 帝國而責怪你的世界。",shape=box,color=red];
		j3387845385 -> j1655856806;
	j137288027 [label="所以這就是你說服他們日夜騷擾我的原因？就為了那個？這是你為了讓我聽信你那可笑論點的最後嘗試嗎？",shape=box,color=blue];
		j137288027 -> j4136937824;
	j630258279 [label="羅瑟，你不是由你的過去所定義。你是由你的未來所定義。而且你仍然有未來可以生活，你不像其他在長胴鼓之夜死去的 Orokin。",shape=box,color=red];
		j630258279 -> j485552767;
	j1655856806 [label="你不是被身邊的人他們的看法所定義的。也不被他們對你行為的評價而定義。你僅由你對自己的信念和你的選擇所定義。",shape=box,color=red];
		j1655856806 -> j2569147234;
	j4136937824 [label="不。",shape=box,color=blue];
		j4136937824 -> j70362747;
	j485552767 [label="那是現在唯一能定義你的東西。你可以改變。而且你可以改變周圍的世界。我想我唯一的問題是，你至少會嘗試嗎？",shape=box,color=red];
		j485552767 -> j2129588126;
	j2569147234 [label="而簡單的事實是？你是我們知道的極少數在長胴鼓之夜中倖存下來的 Orokin 之一。從我的角度來看？那是一次戰略撤退。",shape=box,color=red];
		j2569147234 -> j1156830014;
	j70362747 [label="你的失敗真是可悲。而且不是一次，而是兩次。",shape=box,color=blue];
		j70362747 -> j3343752142;
	j2129588126 [label="嘗試原諒自己並繼續前進？",shape=box,color=red];
		j2129588126 -> j939431362;
	j1156830014 [label="不多不少，僅此而已。",shape=box,color=red];
		j1156830014 -> j1250948828;
	j3343752142 [label="我不建議你去競選公職。",shape=box,color=blue];
		j3343752142 -> "Chat ends.";
	j939431362 [label="Boolean RoatheRedeemed is now true.",color=orange];
		j939431362 -> j1303780169;
	j1250948828 [label="Boolean RoatheVillain is now true.",color=orange];
		j1250948828 -> j1953234007;
	j1303780169 [label="+20 Chemistry",color=orange];
		j1303780169 -> j3481937379;
	j1953234007 [label="+20 Chemistry",color=orange];
		j1953234007 -> j2557006182;
	j3481937379 [label="我該原諒自己所做的一切嗎？然後繼續向前邁進嗎？嗯。",shape=box,color=blue];
		j3481937379 -> j2451823220;
	j2557006182 [label="以退為進。嗯。 ",shape=box,color=blue];
		j2557006182 -> j980568647;
	j2451823220 [label="雖然我對你重新解讀局勢的方式略有懷疑，但我……太渴望這個新的未來以及它可能帶給我的意義，以至於無法抗拒，親愛的漂泊者。",shape=box,color=blue];
		j2451823220 -> j2240410068;
	j980568647 [label="雖然我對你將事件重新定義為戰術撤退的說法略有懷疑，但我承認，我仍然同意這種說法，親愛的漂泊者。",shape=box,color=blue];
		j980568647 -> j1601749676;
	j2240410068 [label="這個所謂「新生」的機會。好吧。我讓步並接受你的論點。雖然有點遲了，但不管怎樣……這終究還是奏效了。",shape=box,color=blue];
		j2240410068 -> j2576016048;
	j1601749676 [label="好吧。我讓步並接受你的論點。雖然有點遲了，但不管怎樣……這終究還是奏效了。",shape=box,color=blue];
		j1601749676 -> j2576016048;
	j2576016048 [label="我很感激。比你想像的還要感激。",shape=box,color=blue];
		j2576016048 -> j757561088;
	j757561088 [label="Boolean RoatheFail is now false.",color=orange];
		j757561088 -> j2141078128;
	j2141078128 [label="Boolean RoatheFamilyFail is now false.",color=orange];
		j2141078128 -> j313480356;
	j313480356 [label="Boolean RoatheFailStall is now false.",color=orange];
		j313480356 -> j3136897973;
	j3136897973 [label="Check boolean LoidFamilyComplete",color=orange];
		j3136897973 -> "Chat ends." [label=true,color=green];
		j3136897973 -> j1487547981 [label=false,color=brown];
	j1487547981 [label="現在，我想我們可以進入戰爭的下一個階段了，對吧？那個管家。",shape=box,color=blue];
		j1487547981 -> j4221977183;
	j4221977183 [label="我已經迫不及待了。",shape=box,color=blue];
		j4221977183 -> j1288719760;
	j1288719760 [label="Boolean RoatheFamilyDelay is now true.",color=orange];
		j1288719760 -> "Chat ends.";
}