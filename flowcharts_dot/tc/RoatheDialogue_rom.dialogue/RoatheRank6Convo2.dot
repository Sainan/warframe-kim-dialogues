		j448815969 -> j3847561112;
	j760616206 [label="你真是個非常奇怪的小生物。親愛的漂泊者，美而怪。",shape=box,color=blue];
		j760616206 -> j997601862;
	j2603535991 [label="唯一比惡魔更危險的……就是擁有像你一樣負債累累的朋友的惡魔。現在，請容我離開。我有一個漂浮的「太陽姊妹」要去惹惱。",shape=box,color=blue];
		j2603535991 -> "Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue";
	j3847561112 [label="唯一比惡魔更危險的……就是擁有像你一樣負債累累的朋友的惡魔。現在，請容我離開。我有一個瘋癲的神父要去惹惱。",shape=box,color=blue];
