	j3424141606 [label="+10 Chemistry",color=orange];
		j3424141606 -> j1176212407;
	j4141088605 [label="什麼？",shape=box,color=blue];
		j4141088605 -> j90377438;
	j1177758482 [label="我確信你所說的話中有些真誠之處。或者至少，我相信你沒有意識到自己一直在自欺欺人。",shape=box,color=blue];
		j1177758482 -> j2599874981;
	j1176212407 [label="誠實是件好事，親愛的漂泊者。你覺得我會讓你因為享受生活而感到羞恥嗎？當然不會。",shape=box,color=blue];
		j1176212407 -> j553737647;
	j90377438 [label="不，你肯定是在開玩笑吧？",shape=box,color=blue];
		j90377438 -> j1706844343;
	j2599874981 [label="我認為 Orokin 帝國最大的成就是它能夠讓其境內的人們相信他們自己的幻想。",shape=box,color=blue];
		j2599874981 -> j2530599814;
	j553737647 [label="希望雙方都能建立互惠互利的關係。",shape=box,color=blue];
		j553737647 -> j3921499284;
	j1706844343 [label="但為什麼要做出這樣的安排呢，除非……？",shape=box,color=blue];
		j1706844343 -> j891954690;
		j1706844343 -> j1606395552;
	j2530599814 [label="事實上，這或許才是人類真正的共同點：我們擁有高超的自欺欺人的能力。",shape=box,color=blue];
		j2530599814 -> j1980665942;
	j3921499284 [label="Boolean RoatheUnloved4 is now true.",color=orange];
		j3921499284 -> j2965571546;
	j891954690 [label="我上次搞砸了，我不能再冒這個險了。",shape=box,color=red];
		j891954690 -> j3718686251;
	j1606395552 [label="我之所以達成這筆交易，是因為我迫切地希望把這件事做好。 ",shape=box,color=red];
		j1606395552 -> j3718686251;
	j1980665942 [label="這一切都是為了避免承認自己需要去改變時那種可怕的羞恥感。",shape=box,color=blue];
		j1980665942 -> j3699244152;
