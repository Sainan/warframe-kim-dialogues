	j1989876514 [label="請原諒我。求求你原諒我。我不知道。",shape=box,color=blue];
		j1989876514 -> j572670450;
	j572670450 [label="你還得明白，直到現在，我的愛一直都是無人問津的商品。沒有人想要真正擁有它。",shape=box,color=blue];
		j572670450 -> j675923072;
	j675923072 [label="所以你似乎願意為了區區一點殘餘就出賣靈魂。你能想像我當時的困惑嗎？我真是百思不得其解。",shape=box,color=blue];
