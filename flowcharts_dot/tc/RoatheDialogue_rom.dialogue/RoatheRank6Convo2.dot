	j3608237715 [label="你把靈魂出賣給了魔鬼，因為……他不知不覺中已經擁有了你破碎的心。",shape=box,color=blue];
		j3608237715 -> j1170059083;
	j3297341297 [label="我對此一無所知。",shape=box,color=blue];
