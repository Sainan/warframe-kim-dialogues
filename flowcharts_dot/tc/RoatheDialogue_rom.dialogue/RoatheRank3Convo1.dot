digraph {
	1333 [label="RoatheRank3Convo1 begins.",color=orange];
		1333 -> 1334;
	1334 [label="你終於能跟我們親愛的里昂對話了？還是他仍在對你冷眼相待？老實說，你最好還是離他遠一點比較好。",shape=box,color=blue];
		1334 -> 1337;
		1334 -> 1336;
		1334 -> 1335;
	1337 [label="你和他關係不好嗎？",shape=box,color=red];
		1337 -> 1340;
	1336 [label="如果你對瑪麗和里昂友善一點，他們或許也會對你友善一些。",shape=box,color=red];
		1336 -> 1339;
	1335 [label="[結束]",shape=box,color=red];
		1335 -> 1338;
	1340 [label="如果他能努力多了解我，了解我的出身，我們或許能「相處」得更好。我就是我，幾個世紀以來一直如此。我不會因為他們現在的要求就改變自己。",shape=box,color=blue];
		1340 -> 1341;
	1339 [label="篡位者，他們對我的恩情又算什麼？我就是我，幾個世紀以來一直如此。我不會因為他們現在的要求就改變自己。",shape=box,color=blue];
		1339 -> 1341;
	1338 [label="Chat ends.",color=orange];
	1341 [label="Evaluate expressions on HellStory",color=orange];
		1341 -> 1343 [label="x >= 21",color=purple];
		1341 -> 1342 [label="x < 21",color=purple];
		1341 -> 1342 [label="false",color=purple];
	1343 [label="我或許是自願接受了血清——但我絕對沒有同意被那兩個白眼狼沒日沒夜地糾纏說教。",shape=box,color=blue];
		1343 -> 1344;
	1342 [label="都是阿爾布雷希特的錯，我才會變成這樣！都是他的錯，我才被困在這裡和他們在一起，不是我的錯！我跟這個可怕的局面一點關係都沒有！",shape=box,color=blue];
		1342 -> 1344;
	1344 [label="他們可以去找他們珍愛的「主教」投訴，而不是找我。",shape=box,color=blue];
		1344 -> 1345;
		1344 -> 1346;
		1344 -> 1347;
	1345 [label="他們的出發點是好的，即使他們的方式並不完美。",shape=box,color=red];
		1345 -> 1348;
	1346 [label="你難道不覺得你需要為自己做過的事情尋求原諒嗎？",shape=box,color=red];
		1346 -> 1349;
	1347 [label="他們只是想幫助你。",shape=box,color=red];
		1347 -> 1350;
	1348 [label="Add -1 to Thermostat",color=orange];
		1348 -> 1351;
	1349 [label="Add 1 to Thermostat",color=orange];
		1349 -> 1352;
	1350 [label="「幫助」。對啊。「幫助」。恕我直言，因為我覺得他們那套「幫助」的方式極度「沒有幫助」。",shape=box,color=blue];
		1350 -> 1353;
	1351 [label="是的，這就是整件事的悲劇。他們真心相信自己在做好事。",shape=box,color=blue];
		1351 -> 1354;
	1352 [label="被誰原諒？你？他們？那個管家？阿爾布雷希特？還是「那些神明」？",shape=box,color=blue];
		1352 -> 1355;
		1352 -> 1356;
		1352 -> 1357;
	1353 [label="事實上，如果他們把我的酒換成腐蝕收斂劑，我反而會覺得更「有幫助」。",shape=box,color=blue];
		1353 -> 1358;
	1354 [label="那你覺得呢？你覺得我需要什麼「偉大的救贖」嗎？某種「神聖的寬恕」？",shape=box,color=blue];
		1354 -> 1359;
	1355 [label="你的名單漏掉了一個重要對象。",shape=box,color=red];
		1355 -> 1360;
	1356 [label="你是 Orokin。你在戰爭中犯下了滔天罪行，而你的社會本質也決定了你所犯下的種種罪行。你有很多需要贖罪的地方。",shape=box,color=red];
		1356 -> 1361;
	1357 [label="難道你一點也不覺得自己這輩子做過很多可怕的事嗎？",shape=box,color=red];
		1357 -> 1362;
	1358 [label="至少這樣會更有效率。",shape=box,color=blue];
		1358 -> 1363;
	1359 [label="Evaluate expressions",color=orange];
		1359 -> 1364 [label="RoatheTraitor2",color=purple];
		1359 -> 1365 [label="RoatheTraitor2",color=purple];
		1359 -> 1366 [label="RoatheTraitor2",color=purple];
		1359 -> 1367 [label="RoatheTraitor2",color=purple];
		1359 -> 1364 [label="RoatheTraitor1",color=purple];
		1359 -> 1365 [label="RoatheTraitor1",color=purple];
		1359 -> 1366 [label="RoatheTraitor1",color=purple];
		1359 -> 1367 [label="RoatheTraitor1",color=purple];
		1359 -> 1364 [label="RoatheExecutor2",color=purple];
		1359 -> 1365 [label="RoatheExecutor2",color=purple];
		1359 -> 1366 [label="RoatheExecutor2",color=purple];
		1359 -> 1367 [label="RoatheExecutor2",color=purple];
		1359 -> 1364 [label="false",color=purple];
		1359 -> 1365 [label="false",color=purple];
		1359 -> 1366 [label="false",color=purple];
	1360 [label="請告訴我。 ",shape=box,color=blue];
		1360 -> 1368;
		1360 -> 1369;
		1360 -> 1370;
	1361 [label="我不會為 Orokin 社會道歉，因為我並非它的締造者而只是其中的一員。如果你要歸咎所有參與一個他們只是剛好被生在其中的體系的人，你那傲慢的自以為是所責罪的是數十億人。至於其他的呢？",shape=box,color=blue];
		1361 -> 1371;
	1362 [label="就算我做過又怎樣？我現在無法改變它們。感到愧疚又有什麼意義？",shape=box,color=blue];
		1362 -> 1372;
		1362 -> 1373;
	1363 [label="不過，我必須承認，在他們兩個人當中，我更喜歡那個神父。他聽得進道理。他可能最終會意識到漠然根本不是一個真正的神。",shape=box,color=blue];
		1363 -> 1374;
	1364 [label="我確實認為我們應該反思那些傷害過人的行為，並試著理解如何去彌補。但我認為他們兩個的做法完全不對。",shape=box,color=red];
		1364 -> 1375;
	1365 [label="說到底，我不認為你需要去原諒除了自己以外的任何人。如果你對自己做過的事感到釋懷？那就這樣吧。",shape=box,color=red];
		1365 -> 1376;
	1366 [label="你出生在那個環境，在那裡很多 Orokin 的行徑不過是……理所當然、習以為常的。在你眼裡，那根本不是「錯誤」。我不是說這能夠讓它變得合理，我只是說可以理解。",shape=box,color=red];
		1366 -> 1377;
	1367 [label="當時正計畫推翻 Orokin。你知道他們腐敗，而且你試圖去糾正他們。",shape=box,color=red];
		1367 -> 1378;
	1368 [label="你自己。",shape=box,color=red];
		1368 -> 1379;
	1369 [label="你即將背叛的是你自己的人。",shape=box,color=red];
		1369 -> 1380;
	1370 [label="那些被你屠殺的 Sentient。",shape=box,color=red];
		1370 -> 1371;
	1371 [label="那是戰爭。戰爭的本質就是大量屠殺與你對抗的人。你會為你殺死的 Grineer 或是「Corpus」哭泣嗎？",shape=box,color=blue];
		1371 -> 1381;
		1371 -> 1382;
		1371 -> 1383;
	1372 [label="獲得他人的寬恕很重要。",shape=box,color=red];
		1372 -> 1384;
	1373 [label="你可以改變你未來的行為方式。",shape=box,color=red];
		1373 -> 1385;
	1374 [label="事實上，我或許還能說服他徹底看穿他的宗教──真是不可思議。一個既能看到奇幻血腥幻覺，同時也具備理性和邏輯的人。多麼罕見。",shape=box,color=blue];
		1374 -> 1386;
		1374 -> 1387;
	1375 [label="嗯。我明白了。你反對的不是行為本身，而是方法。我在此收回我先前的讚許，並以驚愕取而代之。",shape=box,color=blue];
		1375 -> 1388;
	1376 [label="Update boolean RoatheVillainSelf",color=orange];
		1376 -> 1389;
	1377 [label="Update boolean RoatheVillainOrokin",color=orange];
		1377 -> 1389;
	1378 [label="所以我覺得，即使你打算按照自己的想法重新塑造它，你也知道它必須改變。",shape=box,color=red];
		1378 -> 1390;
		1378 -> 1391;
	1379 [label="Check boolean RoatheKnowsReset2",color=orange];
		1379 -> 1392 [label=true,color=green];
		1379 -> 1393 [label=false,color=brown];
	1380 [label="我從未因為背叛自己人而感到愧疚或徹夜難眠。信我。",shape=box,color=blue];
		1380 -> 1394;
	1381 [label="不。但 Sentient  的情況不同。",shape=box,color=red];
		1381 -> 1395;
	1382 [label="是的，我會。",shape=box,color=red];
		1382 -> 1396;
	1383 [label="我對自己必須奪走的生命有何感受，那是我的私事。我們現在說的是你。",shape=box,color=red];
		1383 -> 1397;
	1384 [label="為什麼？是為了讓我獨自一人？讓我不至於成為什麼……異類？什麼社會棄兒？ ",shape=box,color=blue];
		1384 -> 1398;
	1385 [label="從錯誤中學習固然重要，但一個人並不需要感到「愧疚」才能明白何謂「失敗」。",shape=box,color=blue];
		1385 -> 1399;
	1386 [label="里昂似乎已經夠忙的了，你不覺得嗎？",shape=box,color=red];
		1386 -> 1400;
	1387 [label="抱歉，你在做什麼？",shape=box,color=red];
		1387 -> 1401;
	1388 [label="Chat ends.",color=orange];
	1389 [label="你們所處的時代和我們現在的時代不同。而我們眼中的殘酷與可怕，在你們從小接受的教育中，只是世界運作的一部分。",shape=box,color=red];
		1389 -> 1402;
	1390 [label="但這並不能為你的所作所為開脫──暴行依舊是暴行，恐怖依然是恐怖。但你至少有嘗試。",shape=box,color=red];
		1390 -> 1403;
	1391 [label="在我看來，你當時身處戰亂之中，一邊要周旋於一群反社會人格者組成的社會，一邊還要計劃推翻他們。他們卻因此給你貼上魔鬼的標籤。我覺得這不公平。",shape=box,color=red];
		1391 -> 1404;
	1392 [label="為了你的逃避。",shape=box,color=red];
		1392 -> 1405;
	1393 [label="為了你的失敗。",shape=box,color=red];
		1393 -> 1405;
	1394 [label="我不會為 Orokin 社會道歉，因為我並非它的締造者而只是其中的一員。但我也不會為策劃摧毀它而承擔任何責備。我們罪有應得，甚至更糟。",shape=box,color=blue];
		1394 -> 1406;
	1395 [label="篡位者，每種情況都是「不同的情況」。背景永遠是關鍵。而你只是以事馬後炮的視角來看待「遠古之戰」。",shape=box,color=blue];
		1395 -> 1407;
	1396 [label="那麼，篡位者，我對你感到無比同情。我建議你，要麼接受你被賦予的任務，要麼就隱退，去種田吧。",shape=box,color=blue];
		1396 -> 1408;
	1397 [label="嗯。我喜歡你這麼清晰地表達出我碰到了你的痛處，感覺真好。你轉移話題的技巧太拙劣了。",shape=box,color=blue];
		1397 -> 1409;
	1398 [label="看著我，篡位者。看看我是什麼人。一個 Orokin，一個被自己的帝國放逐的人。",shape=box,color=blue];
		1398 -> 1410;
	1399 [label="說到底，原諒又有什麼意義？我應該努力向誰尋求寬恕？向別人嗎？只是為了讓我不再是個眾矢之的？",shape=box,color=blue];
		1399 -> 1398;
	1400 [label="而這正是我想要幫助他的地方！我只是想幫他理清一些關於漠然以及源拓氏告訴他的事情而感到的疑惑。",shape=box,color=blue];
		1400 -> 1411;
	1401 [label="絕無惡意，無論那個討厭的漂浮小走狗對你說了什麼。我只是想幫他理清一些關於漠然以及源拓氏告訴他的事情而感到的疑惑。",shape=box,color=blue];
		1401 -> 1411;
	1402 [label="+10 Chemistry",color=orange];
		1402 -> 1412;
	1403 [label="Update boolean RoatheVillainOrokin",color=orange];
		1403 -> 1402;
	1404 [label="Update boolean RoatheVillainShortcut",color=orange];
		1404 -> 1413;
	1405 [label="Update boolean RoatheForgivenessShortcut",color=orange];
		1405 -> 1414;
	1406 [label="如果我真的對某件事感到一絲愧疚？那就是能親手將那一切付之一炬的是 Tenno，而不是我。",shape=box,color=blue];
		1406 -> 1415;
	1407 [label="如果你用未來擁有的所有資訊來判斷過去人們的行為，你應感到羞愧。",shape=box,color=blue];
		1407 -> 1416;
	1408 [label="雖然會很可惜。看你動手很有意思。效率雖然不怎麼樣——但絢麗奪目。",shape=box,color=blue];
		1408 -> 1417;
	1409 [label="不過我想，獨自度過幾個世紀，除了由自己童話般的想像力所創造的人物之外，沒有任何人可以交談，這確實會限制一個人磨練社交能力的機會。",shape=box,color=blue];
		1409 -> 1418;
	1410 [label="在我的時代，我被稱為「Tau 之惡魔」。而現在，對於所有遇見我的人來說，我就是個「惡魔」。",shape=box,color=blue];
		1410 -> 1419;
	1411 [label="源拓氏告訴他，他的「幻象」並非來自月球太陰，而是來自漠然。這正讓他陷入了一場「信仰危機」。",shape=box,color=blue];
		1411 -> 1420;
	1412 [label="很高興知道你還懂得何謂「細微差別」和「精妙之處」。是的，你說得非常對。我是另一個時空、另一個社會所製造出來的產物。",shape=box,color=blue];
		1412 -> 1421;
	1413 [label="+20 Chemistry",color=orange];
		1413 -> 1422;
	1414 [label="+10 Chemistry",color=orange];
		1414 -> 1423;
	1415 [label="Update boolean RoatheForgivenessNoGuilt",color=orange];
		1415 -> 1424;
	1416 [label="接受過往，然後繼續前行。",shape=box,color=blue];
		1416 -> 1425;
	1417 [label="就算別的什麼都沒做，至少你讓戰場變得「有趣」。 ",shape=box,color=blue];
		1417 -> 1425;
	1418 [label="去和神父切磋一下吧，你們倆都需要練習。 ",shape=box,color=blue];
		1418 -> 1426;
	1419 [label="阿爾布雷希特認為確保這個綽號永久流傳是極為合適。 ",shape=box,color=blue];
		1419 -> 1425;
	1420 [label="然而，我正試圖說服他事實並非如此，因為沒有任何「神」會賜予這些，也因為根本沒有「神」。他只是病了。",shape=box,color=blue];
		1420 -> 1427;
		1420 -> 1428;
	1421 [label="然而，我還是能夠認清我的族人的殘酷與暴行的。我的族人中許多人沉淪的低劣程度，連我也無法忍受。",shape=box,color=blue];
		1421 -> 1429;
	1422 [label="篡位者，我就知道我喜歡你是有原因的。終於！有人欣賞我了！這僅僅花了……多少個世紀？！",shape=box,color=blue];
		1422 -> 1430;
	1423 [label="Chat ends.",color=orange];
	1424 [label="+10 Chemistry",color=orange];
		1424 -> 1431;
	1425 [label="我的建議是：像我一樣把心裡所有那些愧疚通通殺死。用刀捅進它的心臟，把它徹底了結。",shape=box,color=blue];
		1425 -> 1432;
	1426 [label="+5 Chemistry",color=orange];
		1426 -> 1433;
	1427 [label="里昂需要你的幫助嗎？",shape=box,color=red];
		1427 -> 1434;
	1428 [label="你覺得這樣對他來說會更好嗎？",shape=box,color=red];
		1428 -> 1435;
	1429 [label="但這些事情……很複雜。我很感謝你能理解這一點。啊。那個管家正在盯著我。我必須結束這次對話了。我們很快會再談。",shape=box,color=blue];
		1429 -> 1436;
	1430 [label="啊。那個管家正在盯著我。我必須結束這次對話了。我們很快會再談。",shape=box,color=blue];
		1430 -> 1437;
	1431 [label="Chat ends.",color=orange];
	1432 [label="愧疚不過是夜裡的叛徒，它會奪走你珍愛的一切。它對你只有傷害。",shape=box,color=blue];
		1432 -> 1438;
	1433 [label="Chat ends.",color=orange];
	1434 [label="他沒有拒絕去聽。他沒叫我閉嘴。如果他要我靜，我當然會停。",shape=box,color=blue];
		1434 -> 1439;
	1435 [label="就因為那些有宗教傾向的人能操縱他，他就該被肆意操縱嗎？指著他的幻覺，稱其為「幻象」，而不是施以援手？",shape=box,color=blue];
		1435 -> 1440;
	1436 [label="Chat ends.",color=orange];
	1437 [label="Chat ends.",color=orange];
	1438 [label="Update boolean RoatheForgivenessNoGuilt",color=orange];
		1438 -> 1441;
	1439 [label="It angers me to see those around Lyon use and manipulate him, whether or not they even realize they are doing it. All in the name of \"religion\" and \"belief.\"",shape=box,color=blue];
		1439 -> 1440;
	1440 [label="我一直在閱讀相關的記錄。這個.……「血色面紗」本來可以在那數個世紀裡從那位 Tenno 的 Harrow 中取回。但他們沒有。他們任由他枯萎死去。",shape=box,color=blue];
		1440 -> 1442;
	1441 [label="+10 Chemistry",color=orange];
		1441 -> 1443;
	1442 [label="為什麼？為了防範某個……理論上的「虛空之神」。",shape=box,color=blue];
		1442 -> 1444;
		1442 -> 1445;
	1443 [label="Chat ends.",color=orange];
	1444 [label="認為 Rell 的犧牲毫無意義嗎？",shape=box,color=red];
		1444 -> 1446;
	1445 [label="這麼多年來，只有 Rell 才能阻止這件事發生。",shape=box,color=red];
		1445 -> 1447;
	1446 [label="不。他是在防範某種東西。但誰知道他讓事情變得多糟？誰知道在那些世紀裡，他究竟滋養了多少自己的恐懼和畏懼？",shape=box,color=blue];
		1446 -> 1448;
	1447 [label="又或者他才是那些年來唯一餵飽它的。",shape=box,color=blue];
		1447 -> 1448;
	1448 [label="概念式體現僅能顯化其擁有的創造素材。虛空也只能利用所擁有的素材來創作。",shape=box,color=blue];
		1448 -> 1449;
	1449 [label="我很想知道那個 Tenno 究竟為它的存在注入了多少？他簡直是痛苦、折磨、背叛、悲傷……孤獨……的極致盛宴。",shape=box,color=blue];
		1449 -> 1450;
	1450 [label="及他在那個地方數千年的孤獨中，對著虛無說話所迎來的麻木感。伴隨而來的，如果不是漠然還能是什麼？",shape=box,color=blue];
		1450 -> 1451;
		1450 -> 1452;
	1451 [label="你說的有可能是真的。我只是……不知道是不是真的。我也不知道是不是假的。",shape=box,color=red];
		1451 -> 1453;
	1452 [label="在它接近 Rell 之前，它就已經很強大了。如果沒有充分的理由，他不會這樣犧牲自己的。",shape=box,color=red];
		1452 -> 1454;
	1453 [label="+10 Chemistry",color=orange];
