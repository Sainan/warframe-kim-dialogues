	508 [label="+5 Chemistry",color=orange];
		508 -> 516;
	509 [label="Check boolean DrifterRoathe",color=orange];
		509 -> 517 [label=true,color=green];
		509 -> 518 [label=false,color=brown];
	510 [label="所以你承認你是在浪費我的時間了。真是太好了！我可不是某個老態龍鍾，只因記不清其他事便反覆濫述一段戰爭軼事的糟老頭。",shape=box,color=blue];
		510 -> 519;
	515 [label="我正準備開始滔滔不絕地講一些關於 Orokin 社會又臭又長的演講，心想或許你們會有點興趣。然而我又在想，你很有可能早就聽過了，不是嗎？",shape=box,color=blue];
		515 -> 500;
		515 -> 501;
		515 -> 502;
	514 [label="這很好，因為若不是你和那小鬼先完成那一步，我們根本不會有任何進展。不然那位管家一上樓，大概就會被攪成碎肉。",shape=box,color=blue];
		514 -> 522;
	513 [label="順便問一句，你想過我的提議了嗎？我乖乖坐好，而你去幫忙讓那管家跟樓上那些被丟下的感染 Orokin 和解？",shape=box,color=blue];
		513 -> 520;
		513 -> 521;
	512 [label="你可能得先處理這件事，才考慮讓那位管家上樓。否則他上去時恐怕只會被攪成碎肉。",shape=box,color=blue];
		512 -> 522;
	511 [label="順便問一句，你想過我的提議了嗎？我乖乖坐好，而你去幫忙讓那管家跟樓上那些被丟下的感染 Orokin 和解？解決家庭問題是第一步，但……",shape=box,color=blue];
		511 -> 520;
		511 -> 521;
	516 [label="你竟然讓一位 Orokin 開口說話。你不知道你做了什麼。要是不小心的話，你起碼得待上一個小時。",shape=box,color=blue];
		516 -> 523;
	517 [label="+5 Chemistry",color=orange];
		517 -> 524;
	518 [label="哦？那麼，「請問」這是為什麼呢？",shape=box,color=blue];
		518 -> 528;
		518 -> 527;
		518 -> 525;
		518 -> 526;
	519 [label="我之所以想不起這段對話，原因不就在你那破鏡子裡嗎！",shape=box,color=blue];
		519 -> 529;
	522 [label="你必須搞懂一件事，不管怎樣，那個管家和源拓氏家族骨子裡還是 Orokin。他們是那個社會生養出來的，儘管那個社會……缺陷斑斑。",shape=box,color=blue];
		522 -> 532;
	520 [label="不，我不會改變心意的，羅瑟。那沒那麼重要。",shape=box,color=red];
		520 -> 530;
	521 [label="我有。我……同意。",shape=box,color=red];
		521 -> 531;
	523 [label="不過我猜，漂泊者，你這種人也沒什麼機會和 Orokin 打交道吧？那孩子的人生跟你可截然不同。",shape=box,color=blue];
		523 -> 533;
	524 [label="嗯，沒錯。而且我們都知道原因，不是嗎？但你得耐心點。",shape=box,color=blue];
		524 -> 534;
	528 [label=" [表白心意]我想你懂的。",shape=box,color=red];
		528 -> 538;
	527 [label="我對你挺感興趣的。",shape=box,color=red];
		527 -> 537;
	525 [label="我以前可沒什麼機會和 Orokin 打交道。除了……和他們戰鬥時。倒是你這人真有意思。",shape=box,color=red];
		525 -> 535;
	526 [label="算了。[結束]",shape=box,color=red];
		526 -> 536;
	529 [label="Chat ends.",color=orange];
	532 [label="儘管那裡罪孽深重，階級與秩序卻從來沒人敢質疑。軍隊沒有，社會也沒有。哲士聽命於 Orokin，Orokin 聽命於執行者，執行者則聽命於帝王……嗯，至少表面如此。",shape=box,color=blue];
		532 -> 541;
	530 [label="悉聽尊便。但這扇門不會一直開著。",shape=box,color=blue];
		530 -> 539;
	531 [label="Update boolean RoatheNoDeal",color=orange];
		531 -> 540;
	533 [label="據我所知，你的人生就是在扎日曼 10-0 號的悲劇時開始脫軌。",shape=box,color=blue];
		533 -> 542;
		533 -> 543;
		533 -> 544;
	534 [label="不過，如果你想「聽聽」，我樂意奉陪。不過先提醒你一句，你可是想讓一位 Orokin 開口說話。",shape=box,color=blue];
		534 -> 545;
	538 [label="+5 Chemistry",color=orange];
		538 -> 549;
	537 [label="+5 Chemistry",color=orange];
		537 -> 548;
	535 [label="知己知彼，對吧？或者只是感到好奇，想和一個不可能的存在坐下來談談？",shape=box,color=blue];
		535 -> 546;
	536 [label="盡管掙扎吧，小魚。是你自己游過來的。",shape=box,color=blue];
		536 -> 547;
	541 [label="就算你不相信即便過了這麼久，那些傳統還能讓 Loid 願意聽我的？那麼請考慮另一件事：我可是……非常擅長說服的。畢竟，我曾是執行者當中最糟糕的左右手。",shape=box,color=blue];
		541 -> 551;
		541 -> 552;
		541 -> 553;
	539 [label="Chat ends.",color=orange];
	540 [label="Update boolean RoatheDeal",color=orange];
		540 -> 550;
	542 [label="不。扎日曼事件前我幾乎沒和 Orokin 打過交道——之後嘛……你大概知道情況了。",shape=box,color=red];
		542 -> 554;
	543 [label="我和 Orokin 打過的交道已經足夠多了，知道他們一個字都不能信。",shape=box,color=red];
		543 -> 555;
	544 [label="恕我直言，我對你們這種人的好感不比那小孩多。",shape=box,color=red];
		544 -> 555;
	545 [label="你不知道你做了什麼。要是不小心的話，你起碼得待上一個小時。",shape=box,color=blue];
		545 -> 523;
	549 [label="嗯，我記得。本來還以為你會賞我個面子把它寫出來給我看呢。唉，好吧……",shape=box,color=blue];
		549 -> 557;
	548 [label="是嗎？嗯。那我們就看看我能用魚叉把魚刺在矛上多久。",shape=box,color=blue];
		548 -> 534;
	546 [label="+5 Chemistry",color=orange];
		546 -> 556;
	547 [label="Chat ends.",color=orange];
	551 [label="執行者之中最爛的一個，就是 Ballas。",shape=box,color=red];
		551 -> 559;
	552 [label="你曾侍奉的是哪一位？",shape=box,color=red];
		552 -> 560;
	553 [label="How so?",shape=box,color=red];
		553 -> 561;
	550 [label="+5 Chemistry",color=orange];
		550 -> 558;
	554 [label="沒錯，我侍奉過他。啊，Ballas。說出來可能會嚇到你，他可不是他們之中最爛的。",shape=box,color=blue];
		554 -> 562;
		554 -> 563;
	555 [label="我也不怪你。我以前也以為他們還能搶救一下。把他們熔了——重塑、再造，就像煉金一樣。",shape=box,color=blue];
		555 -> 564;
	557 [label="改天吧。你啊，篡位者，你得學著享受這些時刻。",shape=box,color=blue];
		557 -> 566;
	556 [label="可敬。甚至睿智。若我也有機會與一名 Sentient 交談，甚至成為朋友？我大概也會這麼做。",shape=box,color=blue];
		556 -> 565;
	559 [label="我尊重你的意見，也不會為此怪你。Ballas 是個白痴，而且還是那些墮落者裡的翹楚。這點我完全同意。",shape=box,color=blue];
		559 -> 567;
	560 [label="Evaluate expressions on HellStory",color=orange];
		560 -> 569 [label="x >= 1",color=purple];
		560 -> 568 [label="x <= 1",color=purple];
		560 -> 568 [label="false",color=purple];
	561 [label="我知道你和 Ballas 打過交道，所以你會覺得他是七位金色的主裡最爛的那位，我不怪你。畢竟，他確實是那些墮落者裡的翹楚。這點我完全同意。",shape=box,color=blue];
		561 -> 570;
	558 [label="太好了！我很高興你終於肯講道理了。現在我們終於能有所進展。",shape=box,color=blue];
		558 -> 522;
	562 [label="真的嗎？",shape=box,color=red];
		562 -> 571;
	563 [label="你很難讓我相信那套。",shape=box,color=red];
		563 -> 571;
	564 [label="嗯。除了那些執行者。他們早就沒救了。你可能會很驚訝，Ballas 其實不是他們之中最糟的。",shape=box,color=blue];
		564 -> 563;
		564 -> 562;
	566 [label="Update boolean DrifterRoathe",color=orange];
		566 -> 534;
	565 [label="如果你哪天在戰場上再遇到他們——甚至是你以前的好戰友——這種認知會讓你心裡佔上風。",shape=box,color=blue];
		565 -> 572;
	567 [label="而且事實上，所謂這場「那爾邁」的恐怖，我並未親眼目睹，只從管家口中得知，並從這台 POM-2 機器的記錄裡拼湊出來。",shape=box,color=blue];
		567 -> 573;
	569 [label="你以前聽我提過她。更重要的是，你也聽到一點我們當時的計畫。不過那是以後才該說的故事。執行者 Nitokh——準確地說，是大攝政執行者 Nitokh。統御 Orokin 帝國全軍之主帥，也是七位金色領主中最兇殘、最致命的那一位。",shape=box,color=blue];
		569 -> 574;
	568 [label="執行者 Nitokh。確切而言，乃大攝政執行者 Nitokh——統御 Orokin 帝國全軍之主帥，亦為七位金色的主中最凶狠、最致命的一個。",shape=box,color=blue];
		568 -> 574;
	570 [label="甚至有可能，在我從管家與這台 POM-2 上得知的這場「那爾邁」事件中，他的惡名已經超越了舊時代的那些執行者。",shape=box,color=blue];
		570 -> 573;
	571 [label="我不是說他是個聖人。我是在告訴你，那個最壞的惡魔只是被他的同夥比下去了那麼一點點。我只是在做個最細微的區分而已，篡位者。",shape=box,color=blue];
		571 -> 575;
	572 [label="好吧，如果你想「聽聽」，我樂意奉陪。不過先提醒你一句，你可是想讓一位 Orokin 開口說話。",shape=box,color=blue];
		572 -> 545;
	573 [label="不過，我也認為，你會有這種印象只是因為你和 Ballas 有私人恩怨，而且和其他六位金色的主，接觸得太少。",shape=box,color=blue];
		573 -> 574;
	574 [label="黃金七賢。呸。你知道黃金最好的一點是什麼嗎，漂泊者？就是它可以被無限次地熔掉，然後改造成更好的東西。",shape=box,color=blue];
		574 -> 576;
	575 [label="但 Ballas 是最壞的嗎？對你來說可能是。而且，或許他在這段時期的罪行比以往的執行者們還要差劣。",shape=box,color=blue];
		575 -> 577;
	576 [label="我曾經相信——某程度現在我還相信——Orokin 是有救的。我們本可以扭轉帝國的頹勢。但是執行者？ 不。他們必須被阻止。他們幾乎代表了人性所能展現最邪惡的一切，只是程度不同而已。",shape=box,color=blue];
		576 -> 578;
	577 [label="然而若你親眼目見那血流成湖、遍野殘骸如孩童棄之不理之玩物一樣堆滿扭曲破碎屍體的田野——",shape=box,color=blue];
		577 -> 579;
	578 [label="而這話是我說的，篡位者。請容我——Tau 之惡魔之本人——以行家的角度向你保證，Ballas 還不是他們之中最糟的。",shape=box,color=blue];
		578 -> 580;
	579 [label="如果你見過 Nitokh 幾乎不用思考就能造成的毀滅性破壞…… ",shape=box,color=blue];
		579 -> 581;
	580 [label="Check boolean RoatheUsurper",color=orange];
		580 -> 583 [label=true,color=green];
		580 -> 584 [label=true,color=green];
		580 -> 582 [label=false,color=brown];
		580 -> 583 [label=false,color=brown];
		580 -> 584 [label=false,color=brown];
	581 [label="但除非親眼目睹，否則此等恐怖很難感同身受。此等悲劇難以用數字來衡量。我倒是可以滔滔不絕地向你講述我見過的事，但對你來說，那些終究只是——故事。",shape=box,color=blue];
		581 -> 585;
	583 [label="你很難讓我相信那套。",shape=box,color=red];
		583 -> 587;
	584 [label="真的嗎？",shape=box,color=red];
		584 -> 587;
	582 [label="你為什麼老是叫我「篡位者」？",shape=box,color=red];
		582 -> 586;
	585 [label="對你而言，Ballas 永遠都會是那個更真實、更令你恐懼的惡棍。這也在情理之中。",shape=box,color=blue];
		585 -> 588;
	587 [label="若你親眼目見那血流成湖、遍野殘骸如孩童棄之不理之玩物一樣堆滿扭曲破碎屍體的田野——",shape=box,color=blue];
		587 -> 579;
	586 [label="啊！那就是你，對吧？Tenno 從 Orokin 手中奪走了整個始源星系。而你，就像巢中偽雛那樣，從你自己的世界偷偷鑽到這裡來。",shape=box,color=blue];
		586 -> 589;
	588 [label="關於他，你不知道的還多著呢。至於那個蠢貨，你們早就把他那點破事聊爛了。但我怕那些更精彩的故事我還有更多猛料呢。",shape=box,color=blue];
		588 -> 590;
		588 -> 591;
	589 [label="所以，在我看來，你至少有兩條篡奪之罪。（如果把管家跟我說的渡域的事也算上，也許是三條。不過那事以後再說。）",shape=box,color=blue];
		589 -> 592;
