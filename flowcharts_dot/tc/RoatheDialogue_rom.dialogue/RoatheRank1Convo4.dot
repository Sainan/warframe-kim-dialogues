digraph {
	472 [label="RoatheRank1Convo4 begins.",color=orange];
		472 -> 473;
	473 [label="Check boolean LoidFamilyComplete",color=orange];
		473 -> 474 [label=true,color=green];
		473 -> 475 [label=false,color=brown];
	474 [label="尤拉瑞亞和佩特羅斯的下場，還真是近乎可悲。不過你記住，我們從來都不是朋友。但他們畢竟也是 Orokin。而現在，我們 Orokin 已經所剩無幾了。不過我猜我還是該謹言慎行——時間一久，誰知道我會退化成什麼鬼東西。",shape=box,color=blue];
		474 -> 476;
	475 [label="我真心覺得太可笑了。尤拉瑞亞和佩特羅斯居然完全不知道我們就在他們下面。就像老鼠一樣，在他們腳底下亂竄。你和那些孩子們是怎麼把這秘密藏這麼久的？",shape=box,color=blue];
		475 -> 477;
	476 [label="我一點也不驚訝「祖母」能活下來。（真難想像，居然放棄像 Dagath 這麼好一個名字。）",shape=box,color=blue];
		476 -> 478;
		476 -> 479;
	477 [label="Evaluate expressions on HellStory",color=orange];
		477 -> 481 [label="x >= 21",color=purple];
		477 -> 480 [label="x < 21",color=purple];
		477 -> 480 [label="false",color=purple];
	478 [label="佩特羅斯？",shape=box,color=red];
		478 -> 482;
	479 [label="你覺得那些孩子怎麼樣？",shape=box,color=red];
		479 -> 483;
	481 [label="不過老實說，我更驚訝的是祖母居然搞不清狀況。（真難想像，居然放棄像 Dagath 這麼好一個名字。）我還以為她腦子更明智一點。",shape=box,color=blue];
		481 -> 486;
	480 [label="不過老實說，我更驚訝的是祖母居然搞不清狀況。（真難想像，居然放棄像 Dagath 這麼好一個名字。）我還以為她腦子更有慧根一點。",shape=box,color=blue];
		480 -> 484;
		480 -> 485;
	482 [label="呵？啊。亡骸精靈跟我說你還是那個小鬼閒著沒事幹，跑去幫那些連自己本名都已經忘了的傢伙，捏造了堆假名字。你叫他「Vilcor」是吧。",shape=box,color=blue];
		482 -> 487;
	483 [label="那男孩，性情乖戾、惹人生厭、且自我中心。典型 Orokin。至於「Kaelli」，她說她現在喜歡別人這麼叫她，我倒覺得她聰明得不得了，勉強值得我忍受她的存在。",shape=box,color=blue];
		483 -> 488;
	486 [label="我……這太荒謬了。我知道我們以前已經經歷過這一切了。我們也已經談過了。這件事，我到現在還是覺得很不安。",shape=box,color=blue];
		486 -> 491;
	484 [label="他們有他們各自……需要專注的事。",shape=box,color=red];
		484 -> 489;
	485 [label="佩特羅斯？",shape=box,color=red];
		485 -> 490;
	487 [label="但我認識的他，是佩特羅斯‧沃頓。是引以為傲亡骸機甲艦隊的發明者。一想到時間已經在他身上流逝了那麼多，而我——相對他來說卻只活了這點時間，真是奇怪。",shape=box,color=blue];
		487 -> 488;
	488 [label="但你怎麼可能現在還不知道？你是在耍我嗎，篡位者？我們現在肯定只是…… 在重複以前的話題，對吧？",shape=box,color=blue];
		488 -> 492;
	491 [label="Evaluate expressions",color=orange];
		491 -> 498 [label="RoatheDatingDeal",color=purple];
		491 -> 498 [label="RoatheMarieDatingDeal",color=purple];
		491 -> 498 [label="RoatheLyonDatingDeal",color=purple];
		491 -> 498 [label="RoatheSerumDeal",color=purple];
		491 -> 497 [label="RoatheFamilyDeal",color=purple];
		491 -> 498 [label="RoatheMarieEntratiDeal",color=purple];
		491 -> 498 [label="RoatheLyonConfessionDeal",color=purple];
		491 -> 499 [label="false",color=purple];
	489 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		489 -> 494 [label=true,color=green];
		489 -> 493 [label=false,color=brown];
	490 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank",color=orange];
		490 -> 496 [label=true,color=green];
		490 -> 495 [label=false,color=brown];
	492 [label="Update boolean RoatheKnowsReset",color=orange];
		492 -> 500;
		492 -> 501;
		492 -> 502;
	498 [label="我正準備開始滔滔不絕地講一些關於 Orokin 社會又臭又長的演講，心想或許你們會有點興趣。但我突然又想起來……漂泊者，你來這的目的可不是為了這個，對吧？你還有別的把戲要玩……",shape=box,color=blue];
		498 -> 506;
	497 [label="我正準備開始滔滔不絕地講一些關於 Orokin 社會又臭又長的演講，心想或許你們會有點興趣。然而我又在想，你很有可能早就聽過了，不是嗎？",shape=box,color=blue];
		497 -> 505;
	499 [label="你是希望我乾脆陪你演下去？還是……你做這件事有什麼特別的目的？我真的搞不懂，你玩這種殘酷的遊戲，到底想得到什麼？",shape=box,color=blue];
		499 -> 507;
	494 [label="對，我聽亡骸精靈說了。不過，自從你或那個小鬼幫忙解決之後，他們的問題好像變少了。至少現在他們不會再——字面意義上地——把自己撕開。",shape=box,color=blue];
		494 -> 504;
	493 [label="對，我聽亡骸精靈說了。看來他們還是執意要鬧得四分五裂。",shape=box,color=blue];
		493 -> 503;
	496 [label="呵？啊。亡骸精靈跟我說你還是那個小鬼閒著沒事幹，跑去幫那些連自己本名都已經忘了的傢伙，捏造了堆假名字。你叫他「Vilcor」是吧。我認識的他，那時他還是叫做佩特羅斯‧沃頓。引以為的傲亡骸機甲艦隊的發明者。",shape=box,color=blue];
		496 -> 504;
	495 [label="嗯？啊。我認識的他，那時他還是叫做佩特羅斯‧沃頓。引以為的傲亡骸機甲艦隊的發明者。但是亡骸精靈告訴我，他們已經忘了自己的名字。你可能只知道他叫「父親」。",shape=box,color=blue];
		495 -> 503;
	500 [label="不，我之前沒聽過。請，繼續。",shape=box,color=red];
		500 -> 508;
	501 [label="我在跟你說話，羅瑟……因為我想和你說話。",shape=box,color=red];
		501 -> 509;
	502 [label="是的，我之前聽說過。但請再說一次。",shape=box,color=red];
		502 -> 510;
	506 [label="Update boolean RoatheKnowsReset",color=orange];
