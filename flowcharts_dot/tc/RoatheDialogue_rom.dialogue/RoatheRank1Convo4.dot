digraph {
	"RoatheRank1Convo4 begins." [color=orange];
		"RoatheRank1Convo4 begins." -> j86368880;
	j86368880 [label="Check boolean LoidFamilyComplete",color=orange];
		j86368880 -> j601681307 [label=true,color=green];
		j86368880 -> j1054609127 [label=false,color=brown];
	j601681307 [label="尤拉瑞亞和佩特羅斯的下場，還真是近乎可悲。不過你記住，我們從來都不是朋友。但他們畢竟也是 Orokin。而現在，我們 Orokin 已經所剩無幾了。不過我猜我還是該謹言慎行——時間一久，誰知道我會退化成什麼鬼東西。",shape=box,color=blue];
		j601681307 -> j4258120216;
	j1054609127 [label="我真心覺得太可笑了。尤拉瑞亞和佩特羅斯居然完全不知道我們就在他們下面。就像老鼠一樣，在他們腳底下亂竄。你和那些孩子們是怎麼把這秘密藏這麼久的？",shape=box,color=blue];
		j1054609127 -> j348115237;
	j4258120216 [label="我一點也不驚訝「祖母」能活下來。（真難想像，居然放棄像 Dagath 這麼好一個名字。）",shape=box,color=blue];
		j4258120216 -> j2443296809;
		j4258120216 -> j2752706003;
	j348115237 [label="Evaluate expressions on HellStory counter",color=orange];
		j348115237 -> j2232139451 [label="x >= 21",color=purple];
		j348115237 -> j3120709906 [label="x < 21",color=purple];
		j348115237 -> j3120709906 [label="false",color=purple];
	j2443296809 [label="佩特羅斯？",shape=box,color=red];
		j2443296809 -> j3879272758;
	j2752706003 [label="你覺得那些孩子怎麼樣？",shape=box,color=red];
		j2752706003 -> j392673480;
	j2232139451 [label="不過老實說，我更驚訝的是祖母居然搞不清狀況。（真難想像，居然放棄像 Dagath 這麼好一個名字。）我還以為她腦子更明智一點。",shape=box,color=blue];
		j2232139451 -> j4262900642;
	j3120709906 [label="不過老實說，我更驚訝的是祖母居然搞不清狀況。（真難想像，居然放棄像 Dagath 這麼好一個名字。）我還以為她腦子更有慧根一點。",shape=box,color=blue];
		j3120709906 -> j978880175;
		j3120709906 -> j942708029;
	j3879272758 [label="呵？啊。亡骸精靈跟我說你還是那個小鬼閒著沒事幹，跑去幫那些連自己本名都已經忘了的傢伙，捏造了堆假名字。你叫他「Vilcor」是吧。",shape=box,color=blue];
		j3879272758 -> j2427018840;
	j392673480 [label="那男孩，性情乖戾、惹人生厭、且自我中心。典型 Orokin。至於「Kaelli」，她說她現在喜歡別人這麼叫她，我倒覺得她聰明得不得了，勉強值得我忍受她的存在。",shape=box,color=blue];
		j392673480 -> j2696252526;
	j4262900642 [label="我……這太荒謬了。我知道我們以前已經經歷過這一切了。我們也已經談過了。這件事，我到現在還是覺得很不安。",shape=box,color=blue];
		j4262900642 -> j2782860910;
	j978880175 [label="他們有他們各自……需要專注的事。",shape=box,color=red];
		j978880175 -> j1185426142;
	j942708029 [label="佩特羅斯？",shape=box,color=red];
		j942708029 -> j3688976473;
	j2427018840 [label="但我認識的他，是佩特羅斯‧沃頓。是引以為傲亡骸機甲艦隊的發明者。一想到時間已經在他身上流逝了那麼多，而我——相對他來說卻只活了這點時間，真是奇怪。",shape=box,color=blue];
		j2427018840 -> j2696252526;
	j2696252526 [label="但你怎麼可能現在還不知道？你是在耍我嗎，篡位者？我們現在肯定只是…… 在重複以前的話題，對吧？",shape=box,color=blue];
		j2696252526 -> j139011919;
	j2782860910 [label="Evaluate expressions",color=orange];
		j2782860910 -> j1113618376 [label="RoatheDatingDeal",color=purple];
		j2782860910 -> j1113618376 [label="RoatheMarieDatingDeal",color=purple];
		j2782860910 -> j1113618376 [label="RoatheLyonDatingDeal",color=purple];
		j2782860910 -> j1113618376 [label="RoatheSerumDeal",color=purple];
		j2782860910 -> j4012919624 [label="RoatheFamilyDeal",color=purple];
		j2782860910 -> j1113618376 [label="RoatheMarieEntratiDeal",color=purple];
		j2782860910 -> j1113618376 [label="RoatheLyonConfessionDeal",color=purple];
		j2782860910 -> j3853786813 [label="false",color=purple];
	j1185426142 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j1185426142 -> j4131712828 [label=true,color=green];
		j1185426142 -> j1194664916 [label=false,color=brown];
	j3688976473 [label="Check /Lotus/Scripts/1999/DialogueScriptNodes.lua:IsSyndicateRank(syndicate=EntratiSyndicate, syndicateRank=5)",color=orange];
		j3688976473 -> j3865766187 [label=true,color=green];
		j3688976473 -> j3824864723 [label=false,color=brown];
	j139011919 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j139011919 -> j238165023;
		j139011919 -> j3715682963;
		j139011919 -> j1838915385;
	j1113618376 [label="我正準備開始滔滔不絕地講一些關於 Orokin 社會又臭又長的演講，心想或許你們會有點興趣。但我突然又想起來……漂泊者，你來這的目的可不是為了這個，對吧？你還有別的把戲要玩……",shape=box,color=blue];
		j1113618376 -> j139011919;
	j4012919624 [label="我正準備開始滔滔不絕地講一些關於 Orokin 社會又臭又長的演講，心想或許你們會有點興趣。然而我又在想，你很有可能早就聽過了，不是嗎？",shape=box,color=blue];
		j4012919624 -> j139011919;
	j3853786813 [label="你是希望我乾脆陪你演下去？還是……你做這件事有什麼特別的目的？我真的搞不懂，你玩這種殘酷的遊戲，到底想得到什麼？",shape=box,color=blue];
		j3853786813 -> j1736958466;
	j4131712828 [label="對，我聽亡骸精靈說了。不過，自從你或那個小鬼幫忙解決之後，他們的問題好像變少了。至少現在他們不會再——字面意義上地——把自己撕開。",shape=box,color=blue];
		j4131712828 -> j3572873736;
	j1194664916 [label="Check boolean RoatheSyndicateMaxRank",color=orange];
		j1194664916 -> j4131712828 [label=true,color=green];
		j1194664916 -> j4021455521 [label=false,color=brown];
	j3865766187 [label="呵？啊。亡骸精靈跟我說你還是那個小鬼閒著沒事幹，跑去幫那些連自己本名都已經忘了的傢伙，捏造了堆假名字。你叫他「Vilcor」是吧。我認識的他，那時他還是叫做佩特羅斯‧沃頓。引以為的傲亡骸機甲艦隊的發明者。",shape=box,color=blue];
		j3865766187 -> j3572873736;
	j3824864723 [label="Check boolean RoatheSyndicateMaxRank",color=orange];
		j3824864723 -> j3865766187 [label=true,color=green];
		j3824864723 -> j1552571371 [label=false,color=brown];
	j238165023 [label="不，我之前沒聽過。請，繼續。",shape=box,color=red];
		j238165023 -> j3669901635;
	j3715682963 [label="我在跟你說話，羅瑟……因為我想和你說話。",shape=box,color=red];
		j3715682963 -> j862518501;
	j1838915385 [label="是的，我之前聽說過。但請再說一次。",shape=box,color=red];
		j1838915385 -> j3073198347;
	j1736958466 [label="Boolean RoatheKnowsReset is now true.",color=orange];
		j1736958466 -> j1437420524;
	j3572873736 [label="Evaluate expressions",color=orange];
		j3572873736 -> j1112206885 [label="RoatheDeal",color=purple];
		j3572873736 -> j3643986241 [label="RoatheNoDeal",color=purple];
		j3572873736 -> j3643986241 [label="false",color=purple];
	j4021455521 [label="對，我聽亡骸精靈說了。看來他們還是執意要鬧得四分五裂。",shape=box,color=blue];
		j4021455521 -> j3930011928;
	j1552571371 [label="嗯？啊。我認識的他，那時他還是叫做佩特羅斯‧沃頓。引以為的傲亡骸機甲艦隊的發明者。但是亡骸精靈告訴我，他們已經忘了自己的名字。你可能只知道他叫「父親」。",shape=box,color=blue];
		j1552571371 -> j3930011928;
	j3669901635 [label="+5 Chemistry",color=orange];
		j3669901635 -> j1344306864;
	j862518501 [label="Check boolean DrifterRoathe",color=orange];
		j862518501 -> j3360623324 [label=true,color=green];
		j862518501 -> j4171024061 [label=false,color=brown];
	j3073198347 [label="所以你承認你是在浪費我的時間了。真是太好了！我可不是某個老態龍鍾，只因記不清其他事便反覆濫述一段戰爭軼事的糟老頭。",shape=box,color=blue];
		j3073198347 -> j3656069689;
	j1437420524 [label="我正準備開始滔滔不絕地講一些關於 Orokin 社會又臭又長的演講，心想或許你們會有點興趣。然而我又在想，你很有可能早就聽過了，不是嗎？",shape=box,color=blue];
		j1437420524 -> j238165023;
		j1437420524 -> j3715682963;
		j1437420524 -> j1838915385;
	j1112206885 [label="這很好，因為若不是你和那小鬼先完成那一步，我們根本不會有任何進展。不然那位管家一上樓，大概就會被攪成碎肉。",shape=box,color=blue];
		j1112206885 -> j3112896609;
	j3643986241 [label="順便問一句，你想過我的提議了嗎？我乖乖坐好，而你去幫忙讓那管家跟樓上那些被丟下的感染 Orokin 和解？",shape=box,color=blue];
		j3643986241 -> j249989520;
		j3643986241 -> j1410991646;
	j3930011928 [label="Evaluate expressions",color=orange];
		j3930011928 -> j608673425 [label="RoatheDeal",color=purple];
		j3930011928 -> j2771104408 [label="RoatheNoDeal",color=purple];
		j3930011928 -> j2771104408 [label="false",color=purple];
	j1344306864 [label="你竟然讓一位 Orokin 開口說話。你不知道你做了什麼。要是不小心的話，你起碼得待上一個小時。",shape=box,color=blue];
		j1344306864 -> j4267967648;
	j3360623324 [label="+5 Chemistry",color=orange];
		j3360623324 -> j3460839074;
	j4171024061 [label="哦？那麼，「請問」這是為什麼呢？",shape=box,color=blue];
		j4171024061 -> j2479212421;
		j4171024061 -> j387370667;
		j4171024061 -> j1845514305;
		j4171024061 -> j1583739534;
	j3656069689 [label="我之所以想不起這段對話，原因不就在你那破鏡子裡嗎！",shape=box,color=blue];
		j3656069689 -> "Chat ends.";
	j3112896609 [label="你必須搞懂一件事，不管怎樣，那個管家和源拓氏家族骨子裡還是 Orokin。他們是那個社會生養出來的，儘管那個社會……缺陷斑斑。",shape=box,color=blue];
		j3112896609 -> j1442198354;
	j249989520 [label="不，我不會改變心意的，羅瑟。那沒那麼重要。",shape=box,color=red];
		j249989520 -> j3953223783;
	j1410991646 [label="我有。我……同意。",shape=box,color=red];
		j1410991646 -> j2219451800;
	j608673425 [label="你可能得先處理這件事，才考慮讓那位管家上樓。否則他上去時恐怕只會被攪成碎肉。",shape=box,color=blue];
		j608673425 -> j3112896609;
	j2771104408 [label="順便問一句，你想過我的提議了嗎？我乖乖坐好，而你去幫忙讓那管家跟樓上那些被丟下的感染 Orokin 和解？解決家庭問題是第一步，但……",shape=box,color=blue];
		j2771104408 -> j249989520;
		j2771104408 -> j1410991646;
	j4267967648 [label="不過我猜，漂泊者，你這種人也沒什麼機會和 Orokin 打交道吧？那孩子的人生跟你可截然不同。",shape=box,color=blue];
		j4267967648 -> j3077376546;
	j3460839074 [label="嗯，沒錯。而且我們都知道原因，不是嗎？但你得耐心點。",shape=box,color=blue];
		j3460839074 -> j2149868426;
	j2479212421 [label=" [表白心意]我想你懂的。",shape=box,color=red];
		j2479212421 -> j2501830450;
	j387370667 [label="我對你挺感興趣的。",shape=box,color=red];
		j387370667 -> j3799062480;
	j1845514305 [label="我以前可沒什麼機會和 Orokin 打交道。除了……和他們戰鬥時。倒是你這人真有意思。",shape=box,color=red];
		j1845514305 -> j1488601034;
	j1583739534 [label="算了。[結束]",shape=box,color=red];
		j1583739534 -> j757249628;
	"Chat ends." [color=orange];
	j1442198354 [label="儘管那裡罪孽深重，階級與秩序卻從來沒人敢質疑。軍隊沒有，社會也沒有。哲士聽命於 Orokin，Orokin 聽命於執行者，執行者則聽命於帝王……嗯，至少表面如此。",shape=box,color=blue];
		j1442198354 -> j1748336509;
	j3953223783 [label="悉聽尊便。但這扇門不會一直開著。",shape=box,color=blue];
		j3953223783 -> "Chat ends.";
	j2219451800 [label="Boolean RoatheNoDeal is now false.",color=orange];
		j2219451800 -> j2159004892;
	j3077376546 [label="據我所知，你的人生就是在扎日曼 10-0 號的悲劇時開始脫軌。",shape=box,color=blue];
		j3077376546 -> j3676443001;
		j3077376546 -> j9518612;
		j3077376546 -> j181381218;
	j2149868426 [label="不過，如果你想「聽聽」，我樂意奉陪。不過先提醒你一句，你可是想讓一位 Orokin 開口說話。",shape=box,color=blue];
		j2149868426 -> j1478114996;
	j2501830450 [label="+5 Chemistry",color=orange];
		j2501830450 -> j2878082390;
	j3799062480 [label="+5 Chemistry",color=orange];
		j3799062480 -> j3868765140;
	j1488601034 [label="知己知彼，對吧？或者只是感到好奇，想和一個不可能的存在坐下來談談？",shape=box,color=blue];
		j1488601034 -> j2970693551;
	j757249628 [label="盡管掙扎吧，小魚。是你自己游過來的。",shape=box,color=blue];
		j757249628 -> "Chat ends.";
	j1748336509 [label="就算你不相信即便過了這麼久，那些傳統還能讓 Loid 願意聽我的？那麼請考慮另一件事：我可是……非常擅長說服的。畢竟，我曾是執行者當中最糟糕的左右手。",shape=box,color=blue];
		j1748336509 -> j604622140;
		j1748336509 -> j2928096419;
		j1748336509 -> j3999595227;
	j2159004892 [label="Boolean RoatheDeal is now true.",color=orange];
		j2159004892 -> j10957350;
	j3676443001 [label="不。扎日曼事件前我幾乎沒和 Orokin 打過交道——之後嘛……你大概知道情況了。",shape=box,color=red];
		j3676443001 -> j123754825;
	j9518612 [label="我和 Orokin 打過的交道已經足夠多了，知道他們一個字都不能信。",shape=box,color=red];
		j9518612 -> j2910175850;
	j181381218 [label="恕我直言，我對你們這種人的好感不比那小孩多。",shape=box,color=red];
		j181381218 -> j2910175850;
	j1478114996 [label="你不知道你做了什麼。要是不小心的話，你起碼得待上一個小時。",shape=box,color=blue];
		j1478114996 -> j4267967648;
	j2878082390 [label="嗯，我記得。本來還以為你會賞我個面子把它寫出來給我看呢。唉，好吧……",shape=box,color=blue];
		j2878082390 -> j4108144879;
	j3868765140 [label="是嗎？嗯。那我們就看看我能用魚叉把魚刺在矛上多久。",shape=box,color=blue];
		j3868765140 -> j2149868426;
	j2970693551 [label="+5 Chemistry",color=orange];
		j2970693551 -> j3353283663;
	j604622140 [label="執行者之中最爛的一個，就是 Ballas。",shape=box,color=red];
		j604622140 -> j2308016725;
	j2928096419 [label="你曾侍奉的是哪一位？",shape=box,color=red];
		j2928096419 -> j3317686772;
	j3999595227 [label="怎麼說？",shape=box,color=red];
		j3999595227 -> j3631966127;
	j10957350 [label="+5 Chemistry",color=orange];
		j10957350 -> j2110040006;
	j123754825 [label="沒錯，我侍奉過他。啊，Ballas。說出來可能會嚇到你，他可不是他們之中最爛的。",shape=box,color=blue];
		j123754825 -> j1598511744;
		j123754825 -> j2787497855;
	j2910175850 [label="我也不怪你。我以前也以為他們還能搶救一下。把他們熔了——重塑、再造，就像煉金一樣。",shape=box,color=blue];
		j2910175850 -> j1016657668;
	j4108144879 [label="改天吧。你啊，篡位者，你得學著享受這些時刻。",shape=box,color=blue];
		j4108144879 -> j1507426323;
	j3353283663 [label="可敬。甚至睿智。若我也有機會與一名 Sentient 交談，甚至成為朋友？我大概也會這麼做。",shape=box,color=blue];
		j3353283663 -> j2419552792;
	j2308016725 [label="我尊重你的意見，也不會為此怪你。Ballas 是個白痴，而且還是那些墮落者裡的翹楚。這點我完全同意。",shape=box,color=blue];
		j2308016725 -> j4080425455;
	j3317686772 [label="Evaluate expressions on HellStory counter",color=orange];
		j3317686772 -> j4219745317 [label="x >= 1",color=purple];
		j3317686772 -> j1810042753 [label="x <= 1",color=purple];
		j3317686772 -> j1810042753 [label="false",color=purple];
	j3631966127 [label="我知道你和 Ballas 打過交道，所以你會覺得他是七位金色的主裡最爛的那位，我不怪你。畢竟，他確實是那些墮落者裡的翹楚。這點我完全同意。",shape=box,color=blue];
		j3631966127 -> j2346301320;
	j2110040006 [label="太好了！我很高興你終於肯講道理了。現在我們終於能有所進展。",shape=box,color=blue];
		j2110040006 -> j3112896609;
	j1598511744 [label="真的嗎？",shape=box,color=red];
		j1598511744 -> j1718299111;
	j2787497855 [label="你很難讓我相信那套。",shape=box,color=red];
		j2787497855 -> j1718299111;
	j1016657668 [label="嗯。除了那些執行者。他們早就沒救了。你可能會很驚訝，Ballas 其實不是他們之中最糟的。",shape=box,color=blue];
		j1016657668 -> j2787497855;
		j1016657668 -> j1598511744;
	j1507426323 [label="Boolean DrifterRoathe is now true.",color=orange];
		j1507426323 -> j2149868426;
	j2419552792 [label="如果你哪天在戰場上再遇到他們——甚至是你以前的好戰友——這種認知會讓你心裡佔上風。",shape=box,color=blue];
		j2419552792 -> j2762756042;
	j4080425455 [label="而且事實上，所謂這場「那爾邁」的恐怖，我並未親眼目睹，只從管家口中得知，並從這台 POM-2 機器的記錄裡拼湊出來。",shape=box,color=blue];
		j4080425455 -> j1714821593;
	j4219745317 [label="你以前聽我提過她。更重要的是，你也聽到一點我們當時的計畫。不過那是以後才該說的故事。執行者 Nitokh——準確地說，是大攝政執行者 Nitokh。統御 Orokin 帝國全軍之主帥，也是七位金色領主中最兇殘、最致命的那一位。",shape=box,color=blue];
		j4219745317 -> j2649117081;
	j1810042753 [label="執行者 Nitokh。確切而言，乃大攝政執行者 Nitokh——統御 Orokin 帝國全軍之主帥，亦為七位金色的主中最凶狠、最致命的一個。",shape=box,color=blue];
		j1810042753 -> j2649117081;
	j2346301320 [label="甚至有可能，在我從管家與這台 POM-2 上得知的這場「那爾邁」事件中，他的惡名已經超越了舊時代的那些執行者。",shape=box,color=blue];
		j2346301320 -> j1714821593;
	j1718299111 [label="我不是說他是個聖人。我是在告訴你，那個最壞的惡魔只是被他的同夥比下去了那麼一點點。我只是在做個最細微的區分而已，篡位者。",shape=box,color=blue];
		j1718299111 -> j1488822203;
	j2762756042 [label="好吧，如果你想「聽聽」，我樂意奉陪。不過先提醒你一句，你可是想讓一位 Orokin 開口說話。",shape=box,color=blue];
		j2762756042 -> j1478114996;
	j1714821593 [label="不過，我也認為，你會有這種印象只是因為你和 Ballas 有私人恩怨，而且和其他六位金色的主，接觸得太少。",shape=box,color=blue];
		j1714821593 -> j2649117081;
	j2649117081 [label="黃金七賢。呸。你知道黃金最好的一點是什麼嗎，漂泊者？就是它可以被無限次地熔掉，然後改造成更好的東西。",shape=box,color=blue];
		j2649117081 -> j2218016681;
	j1488822203 [label="但 Ballas 是最壞的嗎？對你來說可能是。而且，或許他在這段時期的罪行比以往的執行者們還要差劣。",shape=box,color=blue];
		j1488822203 -> j3084453888;
	j2218016681 [label="我曾經相信——某程度現在我還相信——Orokin 是有救的。我們本可以扭轉帝國的頹勢。但是執行者？ 不。他們必須被阻止。他們幾乎代表了人性所能展現最邪惡的一切，只是程度不同而已。",shape=box,color=blue];
		j2218016681 -> j735267133;
	j3084453888 [label="然而若你親眼目見那血流成湖、遍野殘骸如孩童棄之不理之玩物一樣堆滿扭曲破碎屍體的田野——",shape=box,color=blue];
		j3084453888 -> j4244317381;
	j735267133 [label="而這話是我說的，篡位者。請容我——Tau 之惡魔之本人——以行家的角度向你保證，Ballas 還不是他們之中最糟的。",shape=box,color=blue];
		j735267133 -> j581353866;
	j4244317381 [label="如果你見過 Nitokh 幾乎不用思考就能造成的毀滅性破壞…… ",shape=box,color=blue];
		j4244317381 -> j687442803;
	j581353866 [label="Check boolean RoatheUsurper",color=orange];
		j581353866 -> j3245195765 [label=true,color=green];
		j581353866 -> j958772249 [label=true,color=green];
		j581353866 -> j3274113866 [label=false,color=brown];
		j581353866 -> j3245195765 [label=false,color=brown];
		j581353866 -> j958772249 [label=false,color=brown];
	j687442803 [label="但除非親眼目睹，否則此等恐怖很難感同身受。此等悲劇難以用數字來衡量。我倒是可以滔滔不絕地向你講述我見過的事，但對你來說，那些終究只是——故事。",shape=box,color=blue];
		j687442803 -> j2515557558;
	j3245195765 [label="你很難讓我相信那套。",shape=box,color=red];
		j3245195765 -> j1645061322;
	j958772249 [label="真的嗎？",shape=box,color=red];
		j958772249 -> j1645061322;
	j3274113866 [label="你為什麼老是叫我「篡位者」？",shape=box,color=red];
		j3274113866 -> j4043215621;
	j2515557558 [label="對你而言，Ballas 永遠都會是那個更真實、更令你恐懼的惡棍。這也在情理之中。",shape=box,color=blue];
		j2515557558 -> j1521036835;
	j1645061322 [label="若你親眼目見那血流成湖、遍野殘骸如孩童棄之不理之玩物一樣堆滿扭曲破碎屍體的田野——",shape=box,color=blue];
		j1645061322 -> j4244317381;
	j4043215621 [label="啊！那就是你，對吧？Tenno 從 Orokin 手中奪走了整個始源星系。而你，就像巢中偽雛那樣，從你自己的世界偷偷鑽到這裡來。",shape=box,color=blue];
		j4043215621 -> j3843955950;
	j1521036835 [label="關於他，你不知道的還多著呢。至於那個蠢貨，你們早就把他那點破事聊爛了。但我怕那些更精彩的故事我還有更多猛料呢。",shape=box,color=blue];
		j1521036835 -> j1133520178;
		j1521036835 -> j1653953394;
	j3843955950 [label="所以，在我看來，你至少有兩條篡奪之罪。（如果把管家跟我說的渡域的事也算上，也許是三條。不過那事以後再說。）",shape=box,color=blue];
		j3843955950 -> j1826667263;
	j1133520178 [label="比如什麼？",shape=box,color=red];
		j1133520178 -> j1083303088;
	j1653953394 [label="我對 Ballas 的生平不感興趣。",shape=box,color=red];
		j1653953394 -> j3914922977;
	j1826667263 [label="別打岔，篡位者。我理解你很難相信我，然而若你親眼目見那血流成湖、遍野殘骸如孩童棄之不理之玩物一樣堆滿扭曲破碎屍體的田野——",shape=box,color=blue];
		j1826667263 -> j733319236;
	j1083303088 [label="Boolean RoatheBallas1 is now true.",color=orange];
		j1083303088 -> j3211743285;
	j3914922977 [label="嗯，好啊。既然你不聽他的，我猜你現在就得賞臉聽我的故事了。真可笑。",shape=box,color=blue];
		j3914922977 -> j3715718345;
	j733319236 [label="Boolean RoatheUsurper is now true.",color=orange];
		j733319236 -> j4244317381;
	j3211743285 [label="那是個……很長的故事。我現在沒時間說。那個管家在一旁盯著。我最討厭有人盯著了。",shape=box,color=blue];
		j3211743285 -> j4186578810;
	j3715718345 [label="+5 Chemistry",color=orange];
		j3715718345 -> j1964991264;
	j4186578810 [label="何其無禮。",shape=box,color=blue];
