	592 [label="別打岔，篡位者。我理解你很難相信我，然而若你親眼目見那血流成湖、遍野殘骸如孩童棄之不理之玩物一樣堆滿扭曲破碎屍體的田野——",shape=box,color=blue];
		592 -> 595;
	593 [label="Update boolean RoatheBallas1",color=orange];
		593 -> 596;
	594 [label="嗯，好啊。既然你不聽他的，我猜你現在就得賞臉聽我的故事了。真可笑。",shape=box,color=blue];
