		j3652665456 -> j1350559949;
	j1523179249 [label="你一直叫我「篡位者」。這是在侮辱我嗎？",shape=box,color=red];
		j1523179249 -> j2617828332;
	j1106596289 [label="Boolean RoatheUsurper is now true.",color=orange];
		j1106596289 -> j2180994010;
	j330754809 [label="我只是覺得，既然你犯了同樣的事，但你卻用這個詞來侮辱我，實在有點可笑。",shape=box,color=red];
		j330754809 -> j3842502844;
	j2607190313 [label="我只是想弄清楚，你為什麼一直給我起這個稱謂。",shape=box,color=red];
		j2607190313 -> j2140828884;
	j2617828332 [label="哈！才怪！如果你以為我這麼多天以來只是隨便侮辱你，那你就真的太有耐心了。",shape=box,color=blue];
		j2617828332 -> j2389195802;
	j2180994010 [label="沒錯，那就是你，對吧？Tenno 從 Orokin 手中奪走了整個始源星系。而你，就像巢中偽雛那樣，從你自己的世界偷偷鑽到這裡來。",shape=box,color=blue];
		j2180994010 -> j3091792836;
	j3842502844 [label="哈！侮辱？如果你以為我這麼多天以來只是隨便嘲笑你，那你就真的太有耐心了。",shape=box,color=blue];
		j3842502844 -> j1583718725;
	j2140828884 [label="+5 Chemistry",color=orange];
		j2140828884 -> j1601300921;
	j2389195802 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2389195802 -> j1303303523 [label=true,color=green];
		j2389195802 -> j1383093360 [label=false,color=brown];
	j3091792836 [label="所以，在我看來，你至少有兩條篡奪之罪。（如果把管家跟我說的渡域的事也算上，也許是三條。不過那事以後再說。）",shape=box,color=blue];
		j3091792836 -> j2637037979;
		j3091792836 -> j103045011;
	j1583718725 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1583718725 -> j1623751247 [label=true,color=green];
		j1583718725 -> j3216107904 [label=false,color=brown];
	j1601300921 [label="因為它的確只是一個稱謂，一個榮譽稱號。你已經實現了我一直以來的願望。 ",shape=box,color=blue];
		j1601300921 -> j542652332;
	j1303303523 [label="特別是當你擁有如此巨大的權力，我們就不要假裝這個局面是單方面的，好吧？",shape=box,color=blue];
		j1303303523 -> j3517962590;
	j1383093360 [label="特別是當我知道，你隨時都能用你那虛空賦予的力量穿過牆壁，在我後腦勺開幾槍。",shape=box,color=blue];
		j1383093360 -> j3517962590;
	j2637037979 [label="所以……你是在侮辱我。",shape=box,color=red];
		j2637037979 -> j3842502844;
	j103045011 [label="好吧。那為什麼還要一直用這個稱謂呢？",shape=box,color=red];
		j103045011 -> j2140828884;
	j1623751247 [label="特別是當你擁有如此巨大的權力，我們就不要假裝這個局面是單方面的，好吧？",shape=box,color=blue];
		j1623751247 -> j1328515258;
	j3216107904 [label="特別是當我知道，你隨時都能用你那虛空賦予的力量穿過牆壁，在我後腦勺開幾槍。",shape=box,color=blue];
		j3216107904 -> j1328515258;
	j542652332 [label="這個稱號只是表達了我淡淡的讚賞。即便它帶有恰到好處的諷刺意味來迎合我的自身需要。當然，我絕對也會承認這一點。",shape=box,color=blue];
		j542652332 -> j4045759951;
		j542652332 -> j1672529774;
		j542652332 -> j4201347682;
		j542652332 -> j3717182333;
	j3517962590 [label="我沒心情與你為敵，篡位者。不，這不是侮辱。只是因為你疏忽大意，所以沒意識到我的過去與你的經驗有許多相似之處。",shape=box,color=blue];
		j3517962590 -> j1707450605;
	j1328515258 [label="我沒心情與你為敵，篡位者。不，這充其量只是一種尊稱。你已經完成了我一直渴望要做的事，僅此而已。",shape=box,color=blue];
		j1328515258 -> j542652332;
	j4045759951 [label="所有 Orokin 人都跟你一樣嗎？",shape=box,color=red];
		j4045759951 -> j128665007;
	j1672529774 [label="如果我好好請你換個稱呼，你會嗎？",shape=box,color=red];
		j1672529774 -> j1554986079;
	j4201347682 [label="我會忍。",shape=box,color=red];
		j4201347682 -> j3933480072;
	j3717182333 [label="別再叫我篡位者了。",shape=box,color=red];
		j3717182333 -> j1165866438;
	j1707450605 [label="我一心想要推翻 Orokin 政權，就像你的那個 Tenno 複製體以及他們的同夥一樣。只是在我有機會之前，就被從時間線中抹去了。",shape=box,color=blue];
		j1707450605 -> j409009105;
	j128665007 [label="+10 Chemistry",color=orange];
		j128665007 -> j4206146514;
	j1554986079 [label="+5 Chemistry",color=orange];
		j1554986079 -> j894282307;
	j3933480072 [label="+5 Chemistry",color=orange];
		j3933480072 -> j2842400965;
	j1165866438 [label="嗯……",shape=box,color=blue];
		j1165866438 -> j4003632528;
	j409009105 [label="Boolean RoatheTraitor1 is now true.",color=orange];
		j409009105 -> j542652332;
	j4206146514 [label="哈！我彷彿都能聽到聖堂裡傳來的嘆息。他們都跟我一樣嗎？不。他們遠不如我。而且恐怕更令人惱火。",shape=box,color=blue];
		j4206146514 -> j3499987069;
	j894282307 [label="嗯……不。但我很欣賞你展現出的禮儀。篡位者，你的頭銜是你用本事從我這裡贏來的。你知道的。",shape=box,color=blue];
		j894282307 -> j3499987069;
	j2842400965 [label="很好。無論如何，你都別無選擇。 ",shape=box,color=blue];
		j2842400965 -> j3499987069;
	j4003632528 [label="不。",shape=box,color=blue];
		j4003632528 -> j3499987069;
	j3499987069 [label="+5 Chemistry",color=orange];
		j3499987069 -> j3595879464;
	j3595879464 [label="真的，你令事情變得太有趣了。",shape=box,color=blue];
		j3595879464 -> "Chat ends.";
}