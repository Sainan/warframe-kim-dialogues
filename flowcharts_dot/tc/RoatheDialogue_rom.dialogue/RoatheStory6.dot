	j3604596075 [label="語音訊息：SENTIENT",shape=box,color=blue];
		j3604596075 -> j2750169663;
	j2750169663 [label="文字記錄：我們不把 Sentient 當作「他們」而更多視為「它們」。",shape=box,color=blue];
		j2750169663 -> j1586121798;
	j1586121798 [label="我們面對的軍團被拋向我們，對個體生命的重視不比血球更多。",shape=box,color=blue];
		j1586121798 -> j1396663664;
	j1396663664 [label="它們是龐大惡意軀體中的細胞。",shape=box,color=blue];
		j1396663664 -> j3248364982;
	j3248364982 [label="我想，我們太受 Infestation 經驗的影響了，那是完全不同類型的蜂巢意識。",shape=box,color=blue];
		j3248364982 -> j1617289984;
	j1617289984 [label="Sentient 被賦予進化的使命，而它們進化終點的唯一模板就是我們。",shape=box,color=blue];
		j1617289984 -> j1628306337;
	j1628306337 [label="它們返回始源星系不僅是為了消滅 Orokin，更是要取代他們，最終……完善自己。",shape=box,color=blue];
		j1628306337 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}