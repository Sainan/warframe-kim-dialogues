digraph {
	1995 [label="RoatheRank3Convo5 begins.",color=orange];
		1995 -> 1996;
	1996 [label="阿爾布雷希特從一開始就是個麻煩人物。他以及所有和虛空有關的事情。我想他之所以被安排與姬芮薇恩結合，就是希望一個家庭能讓他安定下來。",shape=box,color=blue];
		1996 -> 1997;
	1997 [label="我想這反而讓事情更糟了。一旦有了孩子，他就把他們視為額外的幫手，成為他瘋狂實驗的共犯。",shape=box,color=blue];
		1997 -> 1998;
	1998 [label="可有可無。就像他生命中的所有東西一樣。",shape=box,color=blue];
		1998 -> 2001;
		1998 -> 2000;
		1998 -> 1999;
	2001 [label="姬芮薇恩？",shape=box,color=red];
		2001 -> 2004;
	2000 [label="他視眾人不單單是可有可無之物。",shape=box,color=red];
		2000 -> 2003;
	1999 [label="[結束]",shape=box,color=red];
		1999 -> 2002;
	2004 [label="一個可能已被歷史遺忘的名字……阿爾布雷希特．源拓氏的妻子，篡位者。他孩子的母親。",shape=box,color=blue];
		2004 -> 2006;
	2003 [label="好吧，我承認他會像任何執行者一樣冷酷無情地殺害他生命中的任何人和物。但他不會無緣無故這麼做。",shape=box,color=blue];
		2003 -> 2005;
	2002 [label="Chat ends.",color=orange];
	2006 [label="Check boolean LoidFamilyComplete",color=orange];
		2006 -> 2009 [label=true,color=green];
		2006 -> 2010 [label=false,color=brown];
	2005 [label="你知道嗎，現在回想起來，正是他那冷靜的本性使他在我們那個時代如此危險。他能夠犧牲一切，只為了達成他的目標。任何東西。",shape=box,color=blue];
		2005 -> 2007;
		2005 -> 2008;
	2009 [label="但你又來了，很可能又在把我當傻瓜——既然管家已經和他們重新聯繫，你很可能早已知道這些資訊了。",shape=box,color=blue];
		2009 -> 2013;
	2010 [label="那些安然無恙地坐在這破敗聖堂深處，對我們的存在渾然不覺的人們。這點我仍然覺得無比寶貴。",shape=box,color=blue];
		2010 -> 2005;
	2007 [label="我以為 Orokin 人不介意犧牲任何他們珍惜的東西。你們看起來卻彼此之間極其冷酷無情。",shape=box,color=red];
		2007 -> 2011;
	2008 [label="你是怎麼知道的？",shape=box,color=red];
		2008 -> 2012;
	2013 [label="我不想再跟你爭論這點。我沒有心情。",shape=box,color=blue];
		2013 -> 2005;
	2011 [label="漂泊者，你非常急切地想斷言許多你一無所知的事情。",shape=box,color=blue];
		2011 -> 2014;
	2012 [label="+10 Chemistry",color=orange];
		2012 -> 2015;
	2014 [label="還是你的皮膚上有我沒注意到的藍色痕跡？你曾經是個 Orokin 嗎？如果是，我向你致以最深切、最真誠的歉意！",shape=box,color=blue];
		2014 -> 2016;
		2014 -> 2017;
	2015 [label="人們或許普遍誤解我們奧羅金人只會互相背叛和謀殺。沒錯，這種事確實不少，別誤會我的意思。我們近乎不死，除此之外也沒什麼事可做。",shape=box,color=blue];
		2015 -> 2018;
	2016 [label="對不起，我無意冒犯你。說實話，我自己對 Orokin 社會也沒什麼印象──我是個外人，只是往裡看。",shape=box,color=red];
		2016 -> 2019;
	2017 [label="如果我對 Orokin 社會的印象不好，請見諒。我記憶中大多是廣播系統裡對我吼叫的命令。那是我被困在虛空之前的事……",shape=box,color=red];
		2017 -> 2020;
	2018 [label="但我們也是一群充滿激情的人。沒有人能像 Orokin 那樣創造藝術。沒有人能創作出我們那樣的音樂、戲劇或詩歌。",shape=box,color=blue];
		2018 -> 2021;
	2019 [label="接受你的道歉。就這一次。我已經受夠了周圍其他人對我的不敬。儘管你很迷人，但我不是每個人的出氣筒。我有更好的方式來打發時間。",shape=box,color=blue];
		2019 -> 2022;
	2020 [label="Update boolean RoatheInsulted",color=orange];
		2020 -> 2023;
	2021 [label="當我們的心愛上一個人時，沒有人的愛會比我們愛得更深。",shape=box,color=blue];
		2021 -> 2024;
	2022 [label="我剛才說到哪裡了？啊，對了。我們那面無表情的源拓氏。",shape=box,color=blue];
		2022 -> 2015;
	2023 [label="給你一個警告。就這一次。我已經受夠了周圍其他人對我的不敬。儘管你很迷人，但我不是每個人的出氣筒。我有更好的方式來打發時間。",shape=box,color=blue];
		2023 -> 2022;
	2024 [label="除了阿爾布雷希特。他做的每件事，他接觸的每個人，都像是隔著他那片珍貴的色璃在看。",shape=box,color=blue];
		2024 -> 2025;
	2025 [label="疏離。冷漠。漠不關心。無動於衷。即使姬芮薇恩去世，留下他獨自撫養他那位可憐的小女兒時，他也同樣如此。",shape=box,color=blue];
		2025 -> 2026;
	2026 [label="Check boolean LoidFamilyComplete",color=orange];
		2026 -> 2028 [label=true,color=green];
		2026 -> 2027 [label=false,color=brown];
	2028 [label="按理說，她註定會比他更有成就，如果她最終沒被感染也未被困於原地的話。真可惜。",shape=box,color=blue];
		2028 -> 2031;
		2028 -> 2032;
	2027 [label="按理說，她註定會比他更有成就。我迫不及待想看看她和源拓氏家族的其他人會變成什麼樣子了。在他們那……Infested 的榮耀之中。",shape=box,color=blue];
		2027 -> 2029;
		2027 -> 2030;
	2031 [label="我很高興我們成功說服 Loid 上樓了。",shape=box,color=red];
		2031 -> 2035;
	2032 [label="我知道你可能不記得我們為什麼要這麼做了，但我們成功地把 Loid 弄到樓上真是件好事。",shape=box,color=red];
		2032 -> 2036;
	2029 [label="我仍然在想這是否是最好的主意……",shape=box,color=red];
		2029 -> 2033;
	2030 [label="如果我們成功說服 Loid 上樓，你接下來打算怎麼辦？",shape=box,color=red];
		2030 -> 2034;
	2035 [label="你說得輕鬆。然而我卻像個傻瓜一樣站在那裡，守著他們，聽他們談論那場團聚，假裝我好像記得那件事如何發生。你知道那有多尷尬嗎？！",shape=box,color=blue];
		2035 -> 2039;
	2036 [label="你知道那有多尷尬嗎，我無論如何都回想不起來的時候，還必須站在那裡假裝我記得那場團聚發生過？！",shape=box,color=blue];
		2036 -> 2039;
	2033 [label="嗯，很可能不是。我只是想知道，你有沒有阿爾布雷希特的轉發地址？",shape=box,color=blue];
		2033 -> 2037;
	2034 [label="我還沒決定。或許我會開始砍下他們的四肢，並將它們保存在液體中。你恰好有阿爾布雷希特的轉發地址嗎？",shape=box,color=blue];
		2034 -> 2038;
	2039 [label="這就像你站在一場盛會上，有人走過來明顯知道你是誰，但你對他們完全沒有印象，卻被迫要假裝認識並繼續對話！",shape=box,color=blue];
		2039 -> 2042;
	2037 [label="沒有，為什麼？",shape=box,color=red];
		2037 -> 2040;
	2038 [label="What?!",shape=box,color=red];
		2038 -> 2041;
	2042 [label="你對你把我置於其中的這種痛苦有一點概念嗎？！絲毫也無？！像那樣站在上面簡直是折磨，這一切都是你造成的！",shape=box,color=blue];
		2042 -> 2044;
	2040 [label="我在想，一旦我上樓了，我就會開始砍下他家人的四肢，然後一個一個裝在罐子裡寄給他。",shape=box,color=blue];
		2040 -> 5776;
	2041 [label="+10 Chemistry",color=orange];
		2041 -> 2043;
	2044 [label="唉，夠了。我需要喝一杯。",shape=box,color=blue];
		2044 -> 2046;
	5776 [label="What?!",shape=box,color=red];
		5776 -> 2041;
	2043 [label="冷靜點！這裡就沒有人能開得起玩笑嗎？",shape=box,color=blue];
		2043 -> 2045;
	2046 [label="+10 Chemistry",color=orange];
		2046 -> 2048;
	2045 [label="說到底，誰會幫我郵寄那些東西呢？",shape=box,color=blue];
		2045 -> 2047;
	2048 [label="Chat ends.",color=orange];
	2047 [label="Chat ends.",color=orange];
}