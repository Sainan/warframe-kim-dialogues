	j4281297864 [label="語音訊息：分開",shape=box,color=blue];
		j4281297864 -> j3614034301;
	j3614034301 [label="文字記錄：在 Sentient 第一次入侵星系和 Orokin 災難性的反擊之後，奇怪的沉默籠罩著。",shape=box,color=blue];
		j3614034301 -> j3340199503;
	j3340199503 [label="我們沒有來自滯留在 Tau 的人民的消息，也無從得知他們的訊號是否被干擾還是他們已被完全殲滅。",shape=box,color=blue];
		j3340199503 -> j4181903195;
	j4181903195 [label="我發現自己被請求發表意見。作為戰略家，我理應理解敵人。",shape=box,color=blue];
		j4181903195 -> j211148746;
	j211148746 [label="Sentient 隨時可以摧毀 Tau 上方的星際航道終點站，但軌道仍在運作。",shape=box,color=blue];
		j211148746 -> j1663126618;
	j1663126618 [label="為什麼？讓大門敞開對它們有什麼好處？",shape=box,color=blue];
		j1663126618 -> j2231582741;
	j2231582741 [label="它們的侵略是統一的，還是有些仍希望和平共處？",shape=box,color=blue];
		j2231582741 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
