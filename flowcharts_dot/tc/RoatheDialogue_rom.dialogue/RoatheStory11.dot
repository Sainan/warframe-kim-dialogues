	j535682595 [label="語音訊息：分開",shape=box,color=blue];
		j535682595 -> j3255935554;
	j3255935554 [label="文字記錄：在 Sentient 第一次入侵星系和 Orokin 災難性的反擊之後，奇怪的沉默籠罩著。",shape=box,color=blue];
		j3255935554 -> j3393944473;
	j3393944473 [label="我們沒有來自滯留在 Tau 的人民的消息，也無從得知他們的訊號是否被干擾還是他們已被完全殲滅。",shape=box,color=blue];
		j3393944473 -> j2985602203;
	j2985602203 [label="我發現自己被請求發表意見。作為戰略家，我理應理解敵人。",shape=box,color=blue];
		j2985602203 -> j959502199;
	j959502199 [label="Sentient 隨時可以摧毀 Tau 上方的星際航道終點站，但軌道仍在運作。",shape=box,color=blue];
		j959502199 -> j3961779914;
	j3961779914 [label="Why? What did they gain from leaving the gate open?",shape=box,color=blue];
		j3961779914 -> j3273990187;
	j3273990187 [label="Were they united in their aggression, or did some yet hope for peaceful coexistence?",shape=box,color=blue];
		j3273990187 -> j921430358;
