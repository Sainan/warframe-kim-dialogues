	j2615979315 [label="VM: LIES",shape=box,color=blue];
		j2615979315 -> j448954413;
	j448954413 [label="文字記錄：我輕鬆精通了我們許多武器，但在一種的使用上尤為出色──謊言。",shape=box,color=blue];
		j448954413 -> j412265492;
	j412265492 [label="I brandished it most often against my own troops. I whipped them to the bone with lies of duty and discipline.",shape=box,color=blue];
		j412265492 -> j68393061;
	j68393061 [label="I smothered them with the lie that the war could be won. I pierced them with the lie of my favour, my most esteemed regard for them.",shape=box,color=blue];
		j68393061 -> j4073585801;
	j4073585801 [label="獨自一人時，私下裡，我把那武器轉向自己。哦，我流血了。",shape=box,color=blue];
		j4073585801 -> j1648694156;
	j1648694156 [label="Add 1 to HellStory counter",color=orange];
