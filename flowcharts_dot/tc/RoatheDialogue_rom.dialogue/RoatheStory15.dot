		j979891222 -> j2692126586;
	j2692126586 [label="文字記錄：我輕鬆精通了我們許多武器，但在一種的使用上尤為出色──謊言。",shape=box,color=blue];
		j2692126586 -> j3241039120;
	j3241039120 [label="最常對自己的部隊揮舞它。我用責任和紀律的謊言鞭策他們直到見骨。",shape=box,color=blue];
		j3241039120 -> j1973954105;
	j1973954105 [label="我用戰爭可以勝利的謊言窒息他們。我用恩惠的謊言、用對他們最崇高敬意的謊言刺穿他們。",shape=box,color=blue];
		j1973954105 -> j4073585801;
	j4073585801 [label="獨自一人時，私下裡，我把那武器轉向自己。哦，我流血了。",shape=box,color=blue];
