		j2747122768 -> j4209958616;
	j2154416533 [label="我估計等我說服他之後管家會很生氣。我肯定，你會是第一個知道。他一定會忍不住抱怨個不停。",shape=box,color=blue];
		j2154416533 -> j3520701224;
	j4209958616 [label="我不會傷害他！我只會用言語表達，我發誓。不過，以我對他的瞭解，會說成是最惡毒的辱罵。",shape=box,color=blue];
