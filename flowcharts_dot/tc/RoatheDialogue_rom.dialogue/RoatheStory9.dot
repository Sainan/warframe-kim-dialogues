	"Chat ends." [color=orange];
	j4238235960 [label="語音訊息：指揮官",shape=box,color=blue];
		j4238235960 -> j1272846087;
	j1272846087 [label="文字記錄：我現在回想起他們。成群歡笑的 Orokin 青年。",shape=box,color=blue];
		j1272846087 -> j1537717383;
	j1537717383 [label="貴族們穿著尚未玷污的指揮服飾。",shape=box,color=blue];
		j1537717383 -> j3993725772;
	j3993725772 [label="童年的朋友們現在指揮著禁衛軍團、Grineer 軍團、虛物質單元、自我複製的致癌體、原始生物無人機刀蛛、低技術部隊罐頭。",shape=box,color=blue];
		j3993725772 -> j260038816;
	j260038816 [label="金色男孩女孩們，召喚著貪婪的惡魔。",shape=box,color=blue];
		j260038816 -> j2093885827;
	j2093885827 [label="他們的傲慢如刺痛的汗水滴入我的腦海。他們飲酒高歌，吹噓即將來臨的時代。",shape=box,color=blue];
		j2093885827 -> j1703155325;
	j1703155325 [label="他們要為自己揚名立萬。讓家族榮耀攀升。",shape=box,color=blue];
		j1703155325 -> j4226214769;
	j4226214769 [label="他們中那麼多人倒下了。連屍體都沒能找回。",shape=box,color=blue];
		j4226214769 -> j1872766324;
	j1872766324 [label="為防止敵人窺探我們的秘密，他們被赤毒電擊，死後便會液化。",shape=box,color=blue];
		j1872766324 -> j295307769;
	j295307769 [label="一代人的希望，最終化作油膩的泥坑，被 Grineer 的靴子踩踏而過。",shape=box,color=blue];
		j295307769 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}