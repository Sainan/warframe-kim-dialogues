	2205 [label="童年的朋友們現在指揮著禁衛軍團、Grineer 軍團、虛物質單元、自我複製的致癌體、原始生物無人機刀蛛、低技術部隊罐頭。",shape=box,color=blue];
		2205 -> 2213;
	2213 [label="金色男孩女孩們，召喚著貪婪的惡魔。",shape=box,color=blue];
		2213 -> 2215;
	2215 [label="他們的傲慢如刺痛的汗水滴入我的腦海。他們飲酒高歌，吹噓即將來臨的時代。",shape=box,color=blue];
		2215 -> 5696;
	5696 [label="他們要為自己揚名立萬。讓家族榮耀攀升。",shape=box,color=blue];
		5696 -> 5697;
	5697 [label="他們中那麼多人倒下了。連屍體都沒能找回。",shape=box,color=blue];
