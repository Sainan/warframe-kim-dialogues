	j580530661 [label="VM: COMMANDERS",shape=box,color=blue];
		j580530661 -> j2170247285;
	j2170247285 [label="文字記錄：我現在回想起他們。成群歡笑的 Orokin 青年。",shape=box,color=blue];
		j2170247285 -> j3636361561;
	j3636361561 [label="貴族們穿著尚未玷污的指揮服飾。",shape=box,color=blue];
		j3636361561 -> j1842102380;
	j1842102380 [label="童年的朋友們現在指揮著禁衛軍團、Grineer 軍團、虛物質單元、自我複製的致癌體、原始生物無人機刀蛛、低技術部隊罐頭。",shape=box,color=blue];
		j1842102380 -> j2398655841;
	j2398655841 [label="金色男孩女孩們，召喚著貪婪的惡魔。",shape=box,color=blue];
		j2398655841 -> j1759663778;
	j1759663778 [label="他們的傲慢如刺痛的汗水滴入我的腦海。他們飲酒高歌，吹噓即將來臨的時代。",shape=box,color=blue];
		j1759663778 -> j3287874755;
	j3287874755 [label="他們要為自己揚名立萬。讓家族榮耀攀升。",shape=box,color=blue];
		j3287874755 -> j959536154;
	j959536154 [label="他們中那麼多人倒下了。連屍體都沒能找回。",shape=box,color=blue];
		j959536154 -> j4128425166;
	j4128425166 [label="為防止敵人窺探我們的秘密，他們被赤毒電擊，死後便會液化。",shape=box,color=blue];
		j4128425166 -> j3147355237;
	j3147355237 [label="一代人的希望變，最終化作油膩的泥坑，被 Grineer 的靴子踩踏而過。",shape=box,color=blue];
		j3147355237 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}