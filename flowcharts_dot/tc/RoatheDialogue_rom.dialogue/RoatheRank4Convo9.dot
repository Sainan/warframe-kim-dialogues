	j3624568175 [label="我會處理……",shape=box,color=red];
		j3624568175 -> j421153441;
	j421153441 [label="你知道她對「主教」有多諂媚。所以，當這一切最終與汰廢爆發時，我一點也不感到驚訝。",shape=box,color=blue];
		j421153441 -> j1434802299;
