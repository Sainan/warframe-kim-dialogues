		j391969990 -> "Chat ends.";
	j2137045019 [label="那你就能理解我為什麼這麼想知道她後來的遭遇了。我只是想知道她的故事結局如何。如果真的有結局的話。",shape=box,color=blue];
		j2137045019 -> j3361901433;
	j3361901433 [label="想要擺脫那些在你人生故事中扮演關鍵角色的人，無論他們多麼惡毒，都是件難事。",shape=box,color=blue];
		j3361901433 -> j1052197933;
