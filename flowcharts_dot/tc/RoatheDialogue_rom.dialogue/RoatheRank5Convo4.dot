		j2099623384 -> j4059208805;
		j2099623384 -> j3261848714;
	j2552262100 [label="What an astonishing question. I have wondered that myself many times since my transformation into this Infested amalgam.",shape=box,color=blue];
		j2552262100 -> j3035100416;
	j2706269968 [label="I will come for what is owed to me, whether or not you needed to use your end of the contract.",shape=box,color=blue];
		j2706269968 -> j4216311802;
		j2706269968 -> j3232562987;
	j2190673343 [label="I couldn't get her to budge...",shape=box,color=red];
		j2190673343 -> j3903689393;
	j3258767548 [label="It's fine to leave things where they are. I don't need your help.",shape=box,color=red];
		j3258767548 -> j2721263264;
	j4059208805 [label="No, I feel like I failed him.",shape=box,color=red];
		j4059208805 -> j1896475573;
	j3261848714 [label="It's fine to leave things where they are. I don't need your help.",shape=box,color=red];
		j3261848714 -> j28963877;
	j3035100416 [label="But I find myself thinking of her more frequently now that my memories are fully returned.",shape=box,color=blue];
		j3035100416 -> j565021317;
	j4216311802 [label="Which is what, exactly? You never said what you wanted out of this.",shape=box,color=red];
		j4216311802 -> j3164988290;
	j3232562987 [label="I think you're bluffing. I don't even think you have a plan for what you want. ",shape=box,color=red];
		j3232562987 -> j368728859;
	j3903689393 [label="Well, then I shall solve this problem for you and soon enough, I shall come for what is owed to me.",shape=box,color=blue];
		j3903689393 -> j1302743033;
		j3903689393 -> j2306283727;
