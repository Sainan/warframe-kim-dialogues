		j1713655375 -> "Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j1845777769 [label="I understand. It's okay.",shape=box,color=red];
		j1845777769 -> j2387099330;
	j2151892296 [label="I wish you wouldn't talk about her.",shape=box,color=red];
		j2151892296 -> j2758913117;
	j1958300931 [label="+5 Chemistry",color=orange];
		j1958300931 -> j3544138181;
	j1924796915 [label="That isn't quite accurate. I am. I no longer love her. I no longer care if she suffers a brutal death at my hands. But I find myself overwhelmingly curious to know how her story ended.",shape=box,color=blue];
		j1924796915 -> j1455952708;
	j1206103728 [label="It is hard to think that someone with such a taste for blood and death would be so quiet for all these centuries.",shape=box,color=blue];
		j1206103728 -> j3138943665;
	"Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue" [label="Initiate conversation MarieRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/MarieDialogue_rom.dialogue",color=orange];
