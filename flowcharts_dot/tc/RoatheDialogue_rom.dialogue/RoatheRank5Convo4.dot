		j2772106444 -> j1075247982;
	j2691178385 [label="+5 Chemistry",color=orange];
		j2691178385 -> j1713655375;
	j1942168483 [label="Yet how much I, in the same breath, owe her. Without her, I would not be what I am. I learned all that I know from her. She took raw clay and shaped it.",shape=box,color=blue];
		j1942168483 -> j2604463853;
		j1942168483 -> j1845777769;
		j1942168483 -> j2151892296;
	j2604463853 [label="I understand. I've been in a similar relationship, once.",shape=box,color=red];
		j2604463853 -> j1958300931;
