	j460636754 [label="Boolean RoatheLyonConfessionDeal is now false.",color=orange];
		j460636754 -> j2691178385;
	j1886148928 [label="I hope this does not spur feelings of jealousy in you. That is not my intention. I am simply trying to provide an explanation of how much harm she caused me.",shape=box,color=blue];
		j1886148928 -> j1942168483;
	j271910200 [label="Without her, I would not be what I am. I learned all that I know from her. She took raw clay and shaped it.",shape=box,color=blue];
		j271910200 -> j2604463853;
