	j1080153434 [label="+5 Chemistry",color=orange];
		j1080153434 -> j2137045019;
	j2891126634 [label="這並不完全準確。我的確愛她。我不再愛她了。我不再在意她是否會死在我手中。但我卻無比好奇她的故事最終結局如何。",shape=box,color=blue];
