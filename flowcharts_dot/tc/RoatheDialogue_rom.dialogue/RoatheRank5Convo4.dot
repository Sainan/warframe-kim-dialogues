		"Initiate conversation LyonRoatheRepair in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j2387099330 [label="It is for the sake of the past that I find myself curious to know what became of her. Simply because I wish to know how her story ended. If it even has.",shape=box,color=blue];
		j2387099330 -> j1455952708;
	j2758913117 [label="Pardon me, as you are the one who brought her up. You really are quite confounding, Drifter dear.",shape=box,color=blue];
		j2758913117 -> "Chat ends.";
	j3544138181 [label="Then you can empathize as to why I am curious to know what became of her. Simply because I wish to know how her story ended. If it even has.",shape=box,color=blue];
		j3544138181 -> j1455952708;
	j1455952708 [label="It is difficult to rid yourself of those who have been such a key player in your own tale. No matter how venomous they are.",shape=box,color=blue];
		j1455952708 -> j1206103728;
	j3138943665 [label="If she is still alive, she has not been lying in wait of her own accord.",shape=box,color=blue];
		j3138943665 -> j1537602650;
	j1537602650 [label="I will say this, however: If she is still alive?",shape=box,color=blue];
