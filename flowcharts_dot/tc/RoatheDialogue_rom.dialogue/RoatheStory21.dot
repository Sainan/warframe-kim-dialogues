	"Chat ends." [color=orange];
	j2987807347 [label="語音訊息：遺忘",shape=box,color=blue];
		j2987807347 -> j2002741751;
	j2002741751 [label="文字記錄：懦夫。",shape=box,color=blue];
		j2002741751 -> j4104291291;
	j4104291291 [label="他們就是這麼叫我的，不是嗎？我讀過散落在這塵封的大廳裡的歷史書籍。謊言。他們不知道真相。我還來不及完成我的任務，就從我的時代被奪走了。",shape=box,color=blue];
		j4104291291 -> j3808260570;
	j3808260570 [label="懦夫。",shape=box,color=blue];
		j3808260570 -> j3976517004;
	j3976517004 [label="我現在想起來了。他在金色大廳接近我。他戴著一張我不認識的臉。但這對我們這種人來說並不罕見。我認得他的聲音。我認得他的舉止。",shape=box,color=blue];
		j3976517004 -> j1333468811;
	j1333468811 [label="懦夫！",shape=box,color=blue];
		j1333468811 -> j2082041808;
	j2082041808 [label="他問了我一個問題。我真的相信自己能因把一切燒成灰燼而被寬恕嗎？",shape=box,color=blue];
		j2082041808 -> j4073611682;
	j4073611682 [label="懦夫！",shape=box,color=blue];
		j4073611682 -> j3476281006;
	j3476281006 [label="在那蒼白、伸出的手中……一支注射器。閃爍著自由……另一次機會……另一個生命。",shape=box,color=blue];
		j3476281006 -> j1815054726;
	j1815054726 [label="我接受了。",shape=box,color=blue];
		j1815054726 -> j3663093416;
	j3663093416 [label="懦夫！",shape=box,color=blue];
		j3663093416 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}