	"Chat ends." [color=orange];
	j3391874652 [label="VM: OBLIVION",shape=box,color=blue];
		j3391874652 -> j3069983295;
	j3069983295 [label="文字記錄：懦夫。",shape=box,color=blue];
		j3069983295 -> j3312865082;
	j3312865082 [label="That is what they called me, isn’t it? I’ve read the history books scattered about this dusty hall. A lie. They did not know the truth. That I was ripped away from my time before I could complete my work.",shape=box,color=blue];
		j3312865082 -> j3785978416;
	j3785978416 [label="Coward.",shape=box,color=blue];
		j3785978416 -> j2441164838;
	j2441164838 [label="I remember now. He approached me, in the Golden Halls. He wore a face I did not know. But that is not so very unusual for our kind. I knew his voice. I knew the way he moved.",shape=box,color=blue];
		j2441164838 -> j1371672921;
	j1371672921 [label="Coward!",shape=box,color=blue];
		j1371672921 -> j2633454744;
	j2633454744 [label="He asked me a single question. Did I truly believe that I could ever be forgiven for burning it all to ash?",shape=box,color=blue];
		j2633454744 -> j1194613138;
	j1194613138 [label="COWARD!",shape=box,color=blue];
		j1194613138 -> j1106719180;
	j1106719180 [label="在那蒼白、伸出的手中……一支注射器。閃爍著自由……另一次機會……另一個生命。",shape=box,color=blue];
		j1106719180 -> j2030181782;
	j2030181782 [label="我接受了。",shape=box,color=blue];
		j2030181782 -> j2066040554;
	j2066040554 [label="COWARD!",shape=box,color=blue];
		j2066040554 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}