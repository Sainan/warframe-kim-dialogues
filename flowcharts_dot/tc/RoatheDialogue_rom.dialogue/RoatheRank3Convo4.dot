digraph {
	"RoatheRank3Convo4 begins." [color=orange];
		"RoatheRank3Convo4 begins." -> j2943973298;
	j2943973298 [label="篡位者，你能回答我一個問題嗎？它困擾了我一段時間了。",shape=box,color=blue];
		j2943973298 -> j253824713;
		j2943973298 -> j3578790807;
		j2943973298 -> j1350559949;
	j253824713 [label="儘管問。 ",shape=box,color=red];
		j253824713 -> j3533322036;
	j3578790807 [label="什麼事能讓你如此煩惱？",shape=box,color=red];
		j3578790807 -> j1418221968;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j3533322036 [label="為什麼要做這一切？",shape=box,color=blue];
		j3533322036 -> j3524964328;
	j1418221968 [label="我可以滔滔不絕把所有問題都列出來，但我擔心我們會因此花掉整個下午。不，我今天的問題只針對一個特定主題。至少今天是這樣。",shape=box,color=blue];
		j1418221968 -> j3533322036;
	"Chat ends." [color=orange];
	j3524964328 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3524964328 -> j3476526251 [label=true,color=green];
		j3524964328 -> j2768280751 [label=false,color=brown];
	j3476526251 [label="我說的不是你篡改我的記憶這件事，我指的是更廣義的「這一切」。",shape=box,color=blue];
		j3476526251 -> j2768280751;
	j2768280751 [label="Check boolean LoidFamilyComplete",color=orange];
		j2768280751 -> j1848872404 [label=true,color=green];
		j2768280751 -> j3831887689 [label=false,color=brown];
	j1848872404 [label="你看起來決心要提著拖把水桶在宇宙中跟在阿爾布雷希特身後奔波。看看你跟他管家幹的那些事。 ",shape=box,color=blue];
		j1848872404 -> j2476974658;
	j3831887689 [label="你看起來決心要提著拖把水桶在宇宙中跟在阿爾布雷希特身後奔波。",shape=box,color=blue];
		j3831887689 -> j2476974658;
	j2476974658 [label="Check boolean IsDating",color=orange];
		j2476974658 -> j2651527288 [label=true,color=green];
		j2476974658 -> j1645580626 [label=false,color=brown];
	j2651527288 [label="看來你這段時間也有自己的事情要忙——我對此表示讚賞，我絕無評判之意。只是讓我覺得奇怪的是，一個平常如此……古怪又瘋狂的人，竟然會如此順從。 ",shape=box,color=blue];
		j2651527288 -> j1691669700;
		j2651527288 -> j3200622758;
		j2651527288 -> j4241055741;
	j1645580626 [label="只是讓我覺得奇怪的是，一個平常如此……古怪又瘋狂的人，竟然會如此順從。 ",shape=box,color=blue];
		j1645580626 -> j1691669700;
		j1645580626 -> j3200622758;
		j1645580626 -> j4241055741;
	j1691669700 [label="讓漠然毀滅始源星系——或任何其他地方——對誰都沒有好處。",shape=box,color=red];
		j1691669700 -> j3751782125;
	j3200622758 [label="我不聽令於源拓氏。",shape=box,color=red];
		j3200622758 -> j4067881913;
	j4241055741 [label="我有我自己的理由。而這些理由我不會告訴任何人。",shape=box,color=red];
		j4241055741 -> j3919721827;
	j3751782125 [label="啊，我明白了。你只是在提供臨時協助直到「漠然」問題解決為止。那之後你打算怎麼做呢？",shape=box,color=blue];
		j3751782125 -> j1106060898;
		j3751782125 -> j2689891076;
		j3751782125 -> j2374831953;
		j3751782125 -> j4270383633;
		j3751782125 -> j2747462912;
	j4067881913 [label="真的嗎？在我看來他彈個手指，你就像受過訓練的庫狛一樣，跑來坐在他的腳邊。他甚至只是低語「Tau」這個名字，你們就爭先恐後地回憶所有關於那個失落之地的細節。",shape=box,color=blue];
		j4067881913 -> j2107639167;
		j4067881913 -> j157423002;
	j3919721827 [label="真是神秘莫測，難以捉摸！簡直一派胡言。如果你不願意承認自己對他言聽計從，那就隨你便。",shape=box,color=blue];
		j3919721827 -> j4114781466;
	j1106060898 [label="你為什麼糾纏著這個問題？你真正想問我什麼？",shape=box,color=red];
		j1106060898 -> j3499977446;
	j2689891076 [label="說實話，我還沒有想得那麼遠。",shape=box,color=red];
		j2689891076 -> j1357612767;
	j2374831953 [label="我一定要讓他為造成的混亂付出代價。他有太多罪孽需要贖還。",shape=box,color=red];
		j2374831953 -> j177817353;
	j4270383633 [label="你的意思是，假設我能活下來？",shape=box,color=red];
		j4270383633 -> j1577815080;
	j2747462912 [label="哪裡需要我，我就去哪裡，就像我一直以來做的那樣。麻煩總是會找上門。",shape=box,color=red];
		j2747462912 -> j1168669431;
	j2107639167 [label="你為什麼這麼努力想激怒我？",shape=box,color=red];
		j2107639167 -> j459516160;
	j157423002 [label="我只是在做我必須做的事情，去幫助人們擺脫他們所處的悲慘境遇。",shape=box,color=red];
		j157423002 -> j743618702;
	j4114781466 [label="因為在我看來，他彈個手指你就像受過訓練的庫狛一樣，跑來坐在他的腳邊。他甚至只是低語「Tau」這個名字，你們就爭先恐後地回憶所有關於那個失落之地的細節。",shape=box,color=blue];
		j4114781466 -> j2107639167;
		j4114781466 -> j157423002;
	j3499977446 [label="+5 Chemistry",color=orange];
		j3499977446 -> j610555480;
	j1357612767 [label="啊！所以你承認你是一個白痴！真令人耳目一新。我喜歡傻瓜把他們缺乏智慧的樣子公開展示，這讓我操縱他們的任務輕鬆多了。",shape=box,color=blue];
		j1357612767 -> j2021111499;
	j177817353 [label="啊！所以你追求的是低級、原始的復仇！何等光榮啊。一隻狂暴的野獸，準備啃噬那些傷害過你的人的骨頭。",shape=box,color=blue];
		j177817353 -> j3807164546;
	j1577815080 [label="+5 Chemistry",color=orange];
		j1577815080 -> j265152004;
	j1168669431 [label="啊，我明白了。虛偽的冷漠但披著高貴的外衣。你不知道你屬於哪裡、該待在哪裡，所以你用「正義的犧牲」這層外衣來偽裝自己，並聽從他人的指令？",shape=box,color=blue];
		j1168669431 -> j2248745269;
	j459516160 [label="因為我無論如何也無法理解，你，一個據我所知來自完全另一個現實版本的實體，為什麼執意要在時間和空間中橫衝直撞，「扮演心理治療師」。",shape=box,color=blue];
		j459516160 -> j3265256998;
	j743618702 [label="沒錯，這才是重點！你為什麼堅持要在時空中到處遊蕩，「扮演心理治療師」？你，這個據我所知完全來自另一個版本現實的實體。",shape=box,color=blue];
		j743618702 -> j3265256998;
	j610555480 [label="精明。是的，很好，我會更直接地切入我問題的核心。我剛才是在故意激怒你，想看看是否會引出更誠實的回答。",shape=box,color=blue];
		j610555480 -> j3645996687;
	j2021111499 [label="你就像一隻終於咬住凱駿的庫狛。現在你咬住了，卻不知道該怎麼辦。",shape=box,color=blue];
		j2021111499 -> j157423002;
		j2021111499 -> j2107639167;
	j3807164546 [label="這是所有人類動機中最簡單、最古老的一種。因此，也是最容易理解的一種。",shape=box,color=blue];
		j3807164546 -> j157423002;
	j265152004 [label="雖然你從未正式當過兵，但從你的語氣中，我聽出了身經百戰的老兵的疲憊。",shape=box,color=blue];
		j265152004 -> j2042555978;
	j2248745269 [label="真是太可悲了。",shape=box,color=blue];
		j2248745269 -> j2966493939;
		j2248745269 -> j4236461839;
	j3265256998 [label="如果我是你，我會回到渡域，試著探索虛空結構還有哪些漏洞可以突破！想想那該有多大的可能性！想想那些唾手可得的世界吧！",shape=box,color=blue];
		j3265256998 -> j1253442641;
		j3265256998 -> j3505841308;
	j3645996687 [label="但我想這已經足夠了。",shape=box,color=blue];
		j3645996687 -> j2727884185;
	j2042555978 [label="很好。出於尊重，我會更直接地切入我問題的核心。我剛才是在故意激怒你，想看看是否會引出更誠實的回答。",shape=box,color=blue];
		j2042555978 -> j2727884185;
	j2966493939 [label="我有屬於我的地方。",shape=box,color=red];
		j2966493939 -> j1530406149;
	j4236461839 [label="你不知道你在說什麼。",shape=box,color=red];
		j4236461839 -> j120905224;
	j1253442641 [label="你跟阿爾布雷希特沒有兩樣。他穿越時空製造這一切的問題。而你卻想對整個維度都這樣做？！",shape=box,color=red];
		j1253442641 -> j2852195460;
	j3505841308 [label="這就是 Orokin 的問題所在。你以為整個世界都只是你的私有財產，你可以隨心所欲地支配它們。 ",shape=box,color=red];
		j3505841308 -> j1036707403;
	j2727884185 [label="+5 Chemistry",color=orange];
		j2727884185 -> j1482949558;
	j1530406149 [label="說來聽聽！是這個霍爾瓦尼亞嗎？或許是渡域？又或許是你墜毀在地球殘骸上的軌道飛行器？",shape=box,color=blue];
		j1530406149 -> j157423002;
		j1530406149 -> j2107639167;
	j120905224 [label="那就告訴我你的家在哪裡吧！是這個霍爾瓦尼亞嗎？或許是渡域？又或許是你墜毀在地球殘骸上的軌道飛行器？",shape=box,color=blue];
		j120905224 -> j157423002;
		j120905224 -> j2107639167;
	j2852195460 [label="我們為什麼不應該這樣做？我們不是更優越的造物嗎？阿爾布雷希特想做什麼就做什麼，而你毫不介意跟在他身後收拾殘局！我為什麼沒有權利做同樣的事？憑什麼他的任務「正當」，而我的就不行？",shape=box,color=blue];
		j2852195460 -> j287846216;
	j1036707403 [label="我們為什麼不應該這樣做？我們不是更優越的造物嗎？阿爾布雷希特為所欲為，在時間中橫衝直撞，用他幾乎也不理解的疾病感染大眾，全都是打著「擊敗一個所謂的神」的旗號。",shape=box,color=blue];
		j1036707403 -> j287846216;
	j1482949558 [label="我無論如何也無法理解，你，一個據我所知來自完全另一個現實版本的實體，為什麼執意要在時間和空間中橫衝直撞，「扮演心理治療師」。",shape=box,color=blue];
		j1482949558 -> j3956801596;
	j287846216 [label="但看看你！ ",shape=box,color=blue];
		j287846216 -> j965779903;
	j3956801596 [label="Check boolean IsDating",color=orange];
		j3956801596 -> j1533549539 [label=true,color=green];
		j3956801596 -> j1640766241 [label=false,color=brown];
	j965779903 [label="Check boolean IsDating",color=orange];
		j965779903 -> j2301261671 [label=true,color=green];
		j965779903 -> j366838597 [label=false,color=brown];
	j1533549539 [label="你，擁有我從未聽聞其他任何實體擁有過的力量：循環時間的能力。創造小小的私人維度的能力。然而你卻在這裡……修補關係。（也順便收集了幾個屬於你自己的關係。）",shape=box,color=blue];
		j1533549539 -> j4080881028;
	j1640766241 [label="你，擁有我從未聽聞其他任何實體擁有過的力量：循環時間的能力。創造小小的私人維度的能力。然而你卻在這裡……修補關係。",shape=box,color=blue];
		j1640766241 -> j4080881028;
	j2301261671 [label="你，擁有我從未聽聞其他任何實體擁有過的力量：循環時間的能力。創造小小的私人維度的能力。然而你卻在這裡……修補關係。（也順便收集了幾個屬於你自己的關係。）",shape=box,color=blue];
		j2301261671 -> j942622910;
	j366838597 [label="你，擁有我從未聽聞其他任何實體擁有過的力量：循環時間的能力。創造小小的私人維度的能力。然而你卻在這裡……修補關係。",shape=box,color=blue];
		j366838597 -> j942622910;
	j4080881028 [label="我簡直驚呆了。我真的無法理解。為什麼？為什麼？你明明完全可以統治某個宇宙啊！",shape=box,color=blue];
		j4080881028 -> j1987177966;
		j4080881028 -> j436817228;
		j4080881028 -> j390302734;
	j942622910 [label="我簡直驚呆了。我真的無法理解。為什麼？為什麼？你明明完全可以統治某個宇宙啊！",shape=box,color=blue];
		j942622910 -> j1428335440;
		j942622910 -> j1056970553;
		j942622910 -> j1017534163;
	j1987177966 [label="我很喜歡我現在做的事情。我正在以我想要的方式幫助別人。",shape=box,color=red];
		j1987177966 -> j4079758590;
	j436817228 [label="我不確定你是否能明白這一點，但請試著理解：我不想統治宇宙。",shape=box,color=red];
		j436817228 -> j1008390029;
	j390302734 [label="那樣我就跟阿爾布雷希特或 Orokin 沒什麼兩樣，到處橫行霸道，按照我的意願重塑世界。我對那種事沒興趣。",shape=box,color=red];
		j390302734 -> j1008390029;
	j1428335440 [label="我很喜歡我現在做的事情。我正在以我想要的方式幫助別人。",shape=box,color=red];
		j1428335440 -> j4079758590;
	j1056970553 [label="我不確定你是否能明白這一點，但請試著理解：我不想統治宇宙。",shape=box,color=red];
		j1056970553 -> j145494130;
	j1017534163 [label="那樣我就跟阿爾布雷希特或 Orokin 沒什麼兩樣，到處橫行霸道，按照我的意願重塑世界。我對那種事沒興趣。",shape=box,color=red];
		j1017534163 -> j145494130;
	j4079758590 [label="但為什麼？這才是我無法理解的部份。",shape=box,color=blue];
		j4079758590 -> j1990388149;
	j1008390029 [label="所以你寧願當個……什麼？渺小的人？",shape=box,color=blue];
		j1008390029 -> j1985981386;
		j1008390029 -> j2739733207;
	j145494130 [label="所以你寧願當個……什麼？渺小的人？",shape=box,color=blue];
		j145494130 -> j2739733207;
		j145494130 -> j1985981386;
	j1990388149 [label="Check boolean RoatheUnloved1",color=orange];
		j1990388149 -> j563589203 [label=true,color=green];
		j1990388149 -> j2725091628 [label=true,color=green];
		j1990388149 -> j1579159102 [label=true,color=green];
		j1990388149 -> j563589203 [label=false,color=brown];
		j1990388149 -> j2725091628 [label=false,color=brown];
		j1990388149 -> j3271461359 [label=false,color=brown];
	j1985981386 [label="如果你認為我做的事情很渺小，當然。那是你的意見。但我做的事情已經改寫了歷史。",shape=box,color=red];
		j1985981386 -> j2884193424;
	j2739733207 [label="不是渺小。是隱而不見。讓所有人都去譁眾取寵吧。我會留在陰影中。",shape=box,color=red];
		j2739733207 -> j2660870979;
	j563589203 [label="因為在人們需要幫助的時候伸出援手，才是我們最終擺脫困境的辦法。",shape=box,color=red];
		j563589203 -> j3278465433;
	j2725091628 [label="因為我只是在做我該做的事。不多，不少。",shape=box,color=red];
		j2725091628 -> j2321568382;
	j1579159102 [label="你說你從未體會過被愛的滋味。我想你永遠不會明白，愛能有多強大，它能改變你周遭的世界。",shape=box,color=red];
		j1579159102 -> j3079516391;
	j3271461359 [label="羅瑟，你有愛過嗎？或者在乎過一個人，在乎到可以為他毀滅整個宇宙？",shape=box,color=red];
		j3271461359 -> j1910824300;
	j2884193424 [label="這正是我要說的！那就讓我們去改寫歷史吧！而不是坐在這裡試圖說服大家手牽手齊唱歌！",shape=box,color=blue];
		j2884193424 -> j321643191;
		j2884193424 -> j3583478061;
		j2884193424 -> j3216117855;
	j2660870979 [label="啊，我明白了，你更喜歡當個躲在陰影中的安靜刺客，是嗎？在最不被懷疑時動手？不。我不這麼認為。我看你只是在原地打轉。",shape=box,color=blue];
		j2660870979 -> j3156558896;
	j3278465433 [label="嗯哼。替陌生人跑腿直到他們把你當成當地英雄一樣崇拜？還是說服他們手牽手唱歌？恕我要先去費波那契罐子裡吐一口。",shape=box,color=blue];
		j3278465433 -> j1312106856;
		j3278465433 -> j1058076670;
	j2321568382 [label="而你「正在做的事」似乎就是到處奔波，在展示完不可思議的暴力之後，又說服所有人手拉手唱歌。暴力的部份還算合理。但其他部分令人作嘔。",shape=box,color=blue];
		j2321568382 -> j1312106856;
		j2321568382 -> j1058076670;
	j3079516391 [label="如果你堅持我們能夠透過手拉手唱歌來拯救這個掌握在「漠然」手中的宇宙，請原諒我，恕我要先去費波那契罐子裡吐一口。",shape=box,color=blue];
		j3079516391 -> j2789890324;
		j3079516391 -> j1312106856;
		j3079516391 -> j1058076670;
	j1910824300 [label="Boolean RoatheUnloved1 is now true.",color=orange];
		j1910824300 -> j323182122;
	j321643191 [label="請保持耐心。我們必須先處理漠然。",shape=box,color=red];
		j321643191 -> j3280937564;
	j3583478061 [label="也許吧，也許等這一切都結束了之後。但不是現在。",shape=box,color=red];
		j3583478061 -> j2700968802;
