	j433534318 [label="VM: COMMISSION",shape=box,color=blue];
		j433534318 -> j1072422502;
	j1072422502 [label="轉錄：我聽說，在七人眾之中，我被視為 Nitokh 的玩物和情人。",shape=box,color=blue];
		j1072422502 -> j1599547691;
	j1599547691 [label="在戰爭初期，在她的慫恿下，他們任命我為副攝政大元帥，以為這是個玩笑話。",shape=box,color=blue];
		j1599547691 -> j2036532672;
	j2036532672 [label="當我一次又一次帶回勝利的消息時，他們的笑聲多快就變成了莊嚴的掌聲。",shape=box,color=blue];
		j2036532672 -> j918380216;
	j918380216 [label="更優秀之人的鮮血，如同勳章點綴在我身上。我在暗地裡為 Nitokh 囤積武器。",shape=box,color=blue];
		j918380216 -> j3434736175;
	j3434736175 [label="這很容易就能夠做到。我當時的聲望太高，沒人會懷疑我。",shape=box,color=blue];
		j3434736175 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}