	j3951316385 [label="語音訊息：委托",shape=box,color=blue];
		j3951316385 -> j1225574956;
	j1225574956 [label="轉錄：我聽說，在七人眾之中，我被視為 Nitokh 的玩物和情人。",shape=box,color=blue];
		j1225574956 -> j212929237;
	j212929237 [label="在戰爭初期，在她的慫恿下，他們任命我為副攝政大元帥，以為這是個玩笑話。",shape=box,color=blue];
		j212929237 -> j4251138809;
	j4251138809 [label="當我一次又一次帶回勝利的消息時，他們的笑聲多快就變成了莊嚴的掌聲。",shape=box,color=blue];
		j4251138809 -> j2984920349;
	j2984920349 [label="更優秀之人的鮮血，如同勳章點綴在我身上。我在暗地裡為 Nitokh 囤積武器。",shape=box,color=blue];
		j2984920349 -> j3747957497;
	j3747957497 [label="這很容易辦到。我這種太光榮的人物，不會被懷疑。",shape=box,color=blue];
		j3747957497 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}