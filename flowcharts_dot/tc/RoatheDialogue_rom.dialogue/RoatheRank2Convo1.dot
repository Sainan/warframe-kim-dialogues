		633 -> 648 [label="false",color=purple];
	634 [label="里昂……他要處理的事情太多了。我不知道該怎麼幫他挺過去。",shape=box,color=red];
		634 -> 656;
	635 [label="瑪麗就是看不清源拓氏的真面目！我不管怎麼做，都沒法讓她看清真相。",shape=box,color=red];
		635 -> 657;
	636 [label="呃，你看，你對於你為什麼喝血清這件事……有你自己的一整套說法，而我……我又總是在錯誤的時間點說了錯誤的話。",shape=box,color=red];
		636 -> 658;
	637 [label="這話說出口有點不好意思……但我對你們三人裡的某個人有意思。",shape=box,color=red];
		637 -> 659;
		637 -> 660;
		637 -> 661;
	638 [label="我正試著讓你和他們幫我讓 Loid 和樓上的家人團聚，但……我……辦不到……",shape=box,color=red];
		638 -> 662;
	641 [label="不，里昂……好像不太愛說話。",shape=box,color=red];
		641 -> 665;
	642 [label="我跟瑪麗還頗合得來的。你幹嘛叫她馬屁精？",shape=box,color=red];
		642 -> 666;
	643 [label="你好像不太喜歡他們。為什麼？",shape=box,color=red];
		643 -> 667;
	639 [label="不。抱歉。我不和 Orokin 做交易。以前不會，現在不會，以後也絕對不會。",shape=box,color=red];
		639 -> 663;
	640 [label="羅瑟，你最好別讓我為此後悔。行。我同意了。",shape=box,color=red];
		640 -> 664;
	644 [label="「至少目前為止」。有意思。我們真的是在重踏舊步像宮廷裡的侍臣模仿的舞步那樣嗎？一遍又一遍，註定自我重覆？",shape=box,color=blue];
		644 -> 668;
		644 -> 669;
	645 [label="我猜你早就知道了，是吧？真有意思，這一切居然這麼好預測。很高興知道就算是像他那樣支離破碎的人，也還是有那麼一兩次靠得住。",shape=box,color=blue];
		645 -> 670;
	646 [label="你不是早就知道了嗎？嗯。也許你根本沒到那一步。第一次重覆也好，第兩萬次重來也罷，你仍想過去問。",shape=box,color=blue];
		646 -> 670;
	647 [label="喔。趁我還沒忘，還有一件事。",shape=box,color=blue];
		647 -> 671;
	649 [label="你還真是把靈魂出賣給了惡魔，而且還賣了兩次……你是不是在精心安排想確保我會帶你上我的床？還是你覬覦的是我的心嗎，篡位者？嗯。我們走著瞧。不過，得慢慢來。",shape=box,color=blue];
		649 -> 672;
	650 [label="篡位者，時候到了，我自然會確保你面前一片坦途，讓你去搞定那個飄著的小走狗。放心，這事我會處理。",shape=box,color=blue];
		650 -> 673;
	651 [label="篡位者，時候到了，我自然會確保你面前一片坦途，讓你去追求那位可憐破碎的神父。放心，這事我會處理。",shape=box,color=blue];
		651 -> 674;
	652 [label="時候到了，我就會記住這一點的。要是我們之後對我的記憶又有分歧，我們可不能再重複你之前的錯誤。",shape=box,color=blue];
		652 -> 675;
	655 [label="時候一到，我自會確保那位小管家走上那些樓梯。這事包在我身上。",shape=box,color=blue];
		655 -> 678;
	654 [label="你跟瑪麗瑪麗還有她對源拓氏那套諂媚崇拜的問題，你就當解決了。時候一到，我自會處理。",shape=box,color=blue];
		654 -> 677;
	653 [label="篡位者，你和里昂以及他那些心魔的問題，你就當解決了。時候一到，我自會處理。",shape=box,color=blue];
		653 -> 676;
	648 [label="我……好像忘了你到底在追求什麼。要怪就怪你老去亂動我的記憶。到底是什麼？",shape=box,color=blue];
		648 -> 626;
	656 [label="我本來會建議你耐心點，但是… 既然你旁邊就已經放著一把雷射切割器，我總不能還建議你去用鑿子吧。",shape=box,color=blue];
		656 -> 679;
	657 [label="哼。我懂了。老實說，這目標還挺高尚的。這事我自己也試過很多、很多次了。而且每一次都敗得同樣徹底。",shape=box,color=blue];
		657 -> 680;
	658 [label="嗯。",shape=box,color=blue];
		658 -> 681;
	659 [label="里昂。",shape=box,color=red];
		659 -> 682;
	660 [label="……你。",shape=box,color=red];
		660 -> 683;
	661 [label="瑪麗。",shape=box,color=red];
		661 -> 684;
	662 [label="呵，我懂了。咱倆說好合作，結果你不知何故搞砸了。所以你的獎品就這麼沒了。",shape=box,color=blue];
		662 -> 685;
	665 [label="他一開口基本就得兩種情況——要嘛是蠢得要命，要嘛是瘋得要命。",shape=box,color=blue];
		665 -> 688;
	666 [label="喔？你居然到現在都倖免於難？我真是嫉妒死你了。不過，你也蹦躂不了多久了，最好先聽聽我的警告。",shape=box,color=blue];
		666 -> 689;
	667 [label="我親愛的漂泊者。你是不是忘了？我們 Orokin 從不信什麼神。唯一被我們膜拜的就只有我們自己。",shape=box,color=blue];
		667 -> 690;
	663 [label="悉聽尊便。不過我警告你，你這個決定一旦做了，可不是能不付代價就反悔的。",shape=box,color=blue];
		663 -> 686;
	664 [label="你安分點，幫我讓 Loid 上樓去跟家人和好。然後我就幫你好好整理那堆記憶。",shape=box,color=red];
		664 -> 687;
	668 [label="這又不是說你不能自己做主。這只是說有些事得多試幾次才能成。",shape=box,color=red];
		668 -> 691;
	669 [label="我希望這不會讓你難過。",shape=box,color=red];
		669 -> 692;
	670 [label="我們真的是在重踏舊步像宮廷裡的侍臣模仿的舞步那樣嗎，註定要自我重覆嗎？",shape=box,color=blue];
		670 -> 668;
		670 -> 669;
	671 [label="不久之前，我曾告訴你一個可怕的真相。現在我卻不記得為什麼了。",shape=box,color=blue];
		671 -> 693;
