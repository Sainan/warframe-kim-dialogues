	676 [label="Update boolean RoatheLyonConfessionDealNo",color=orange];
		676 -> 698;
	679 [label="我想我開始明白你為什麼要把我們的記憶全部抹去。看著那些失敗的嘗試與徒勞的努力……那為什麼不把棋盤掀了重新來過？",shape=box,color=blue];
		679 -> 701;
	680 [label="當你發現再也無法說服她去相信那些最簡單的事實時，你憤而轉向你手中所擁有的——這個……天賦。",shape=box,color=blue];
		680 -> 702;
	681 [label="我可不喜歡你為了補自己的錯就跑來動我的腦子，漂泊者。不過，既然你是為了我而這麼做……我想，多少還能接受。",shape=box,color=blue];
