		684 -> 706;
	685 [label="所以，你知道自己再也無法達成先前唾手可得的目標，你就訴諸了那種你擁有的……天賦。",shape=box,color=blue];
		685 -> 707;
	688 [label="這就像擲枚硬幣，你永遠不知道會是哪一面。而我又始終分不清自己更偏愛哪一面。",shape=box,color=blue];
		688 -> 710;
	689 [label="那個女人對阿爾布雷希特那種堅定不移、近乎偏執的奉獻，簡直是沒完沒了 。我本想說那個管家該擔心，但老實說我真心相信那只是單純的崇敬。這話可是由我說出來的。",shape=box,color=blue];
		689 -> 711;
	690 [label="滿口「太陽」「太陰」，那兩個狂信份子簡直連兩分鐘都不肯靜下來，非得連夜壺都要祝福一番。",shape=box,color=blue];
