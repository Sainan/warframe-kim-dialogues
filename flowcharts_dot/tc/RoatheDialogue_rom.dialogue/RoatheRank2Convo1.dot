		j2953660143 -> j3952825054 [label=false,color=brown];
		j2953660143 -> j3684474996 [label=false,color=brown];
		j2953660143 -> j2769508047 [label=false,color=brown];
	j216315216 [label="我們那個漂浮的小馬屁精怎麼樣了？我猜那個神父還是不肯跟你說話吧。",shape=box,color=blue];
		j216315216 -> j3488545337;
		j216315216 -> j3203517383;
		j216315216 -> j26105841;
	j3379658947 [label="告訴我，你已經對我的提議回心轉意了嗎？這是你最後的機會了，篡位者。我是一個有耐心的惡魔，但我不喜歡被晾在一邊。",shape=box,color=blue];
		j3379658947 -> j1826599690;
		j3379658947 -> j3767213927;
	j2488297233 [label="至少目前為止，我和瑪麗相處得還算順利。",shape=box,color=red];
		j2488297233 -> j1689107394;
	j2376252713 [label="還沒。但他總會想通的。",shape=box,color=red];
		j2376252713 -> j1971913273;
	j3345771736 [label="你好像不太喜歡他們。為什麼？",shape=box,color=red];
		j3345771736 -> j3427933319;
	j2285472441 [label="隨你便。不過我得提醒你，這是你最後的機會了。現在起，你就只能靠自己了。",shape=box,color=blue];
		j2285472441 -> j4161874764;
	j1876832257 [label="Evaluate expressions",color=orange];
		j1876832257 -> j400118295 [label="RoatheDatingDealNo",color=purple];
		j1876832257 -> j1819382130 [label="RoatheMarieDatingDealNo",color=purple];
		j1876832257 -> j847342050 [label="RoatheLyonDatingDealNo",color=purple];
		j1876832257 -> j1433069073 [label="RoatheSerumDealNo",color=purple];
		j1876832257 -> j845959353 [label="RoatheFamilyDealNo",color=purple];
		j1876832257 -> j318540315 [label="RoatheMarieEntratiDealNo",color=purple];
		j1876832257 -> j706586427 [label="RoatheLyonConfessionDealNo",color=purple];
		j1876832257 -> j890949204 [label="false",color=purple];
	j3731542657 [label="里昂……他要處理的事情太多了。我不知道該怎麼幫他挺過去。",shape=box,color=red];
		j3731542657 -> j1912707602;
	j3252449687 [label="瑪麗就是看不清源拓氏的真面目！我不管怎麼做，都沒法讓她看清真相。",shape=box,color=red];
		j3252449687 -> j2391366286;
	j3952825054 [label="呃，你看，你對於你為什麼喝血清這件事……有你自己的一整套說法，而我……我又總是在錯誤的時間點說了錯誤的話。",shape=box,color=red];
		j3952825054 -> j88042062;
	j3684474996 [label="這話說出口有點不好意思……但我對你們三人裡的某個人有意思。",shape=box,color=red];
		j3684474996 -> j1491940867;
		j3684474996 -> j126294695;
		j3684474996 -> j1265460739;
	j2769508047 [label="我正試著讓你和他們幫我讓 Loid 和樓上的家人團聚，但……我……辦不到……",shape=box,color=red];
		j2769508047 -> j3043467059;
	j3488545337 [label="不，里昂……好像不太愛說話。",shape=box,color=red];
		j3488545337 -> j4280463898;
	j3203517383 [label="我跟瑪麗還頗合得來的。你幹嘛叫她馬屁精？",shape=box,color=red];
		j3203517383 -> j3694015948;
	j26105841 [label="你好像不太喜歡他們。為什麼？",shape=box,color=red];
		j26105841 -> j2213828175;
	j1826599690 [label="不。抱歉。我不和 Orokin 做交易。以前不會，現在不會，以後也絕對不會。",shape=box,color=red];
		j1826599690 -> j1248454557;
	j3767213927 [label="羅瑟，你最好別讓我為此後悔。行。我同意了。",shape=box,color=red];
		j3767213927 -> j662188125;
	j1689107394 [label="「至少目前為止」。有意思。我們真的是在重踏舊步像宮廷裡的侍臣模仿的舞步那樣嗎？一遍又一遍，註定自我重覆？",shape=box,color=blue];
		j1689107394 -> j993538733;
		j1689107394 -> j1276939310;
	j1971913273 [label="我猜你早就知道了，是吧？真有意思，這一切居然這麼好預測。很高興知道就算是像他那樣支離破碎的人，也還是有那麼一兩次靠得住。",shape=box,color=blue];
		j1971913273 -> j2782898555;
	j3427933319 [label="你不是早就知道了嗎？嗯。也許你根本沒到那一步。第一次重覆也好，第兩萬次重來也罷，你仍想過去問。",shape=box,color=blue];
		j3427933319 -> j2782898555;
	j4161874764 [label="喔。趁我還沒忘，還有一件事。",shape=box,color=blue];
		j4161874764 -> j1809662592;
	j400118295 [label="你還真是把靈魂出賣給了惡魔，而且還賣了兩次……你是不是在精心安排想確保我會帶你上我的床？還是你覬覦的是我的心嗎，篡位者？嗯。我們走著瞧。不過，得慢慢來。",shape=box,color=blue];
		j400118295 -> j1672321314;
	j1819382130 [label="篡位者，時候到了，我自然會確保你面前一片坦途，讓你去搞定那個飄著的小走狗。放心，這事我會處理。",shape=box,color=blue];
		j1819382130 -> j1672321314;
	j847342050 [label="篡位者，時候到了，我自然會確保你面前一片坦途，讓你去追求那位可憐破碎的神父。放心，這事我會處理。",shape=box,color=blue];
		j847342050 -> j2348567369;
	j1433069073 [label="時候到了，我就會記住這一點的。要是我們之後對我的記憶又有分歧，我們可不能再重複你之前的錯誤。",shape=box,color=blue];
		j1433069073 -> j1293281246;
	j845959353 [label="時候一到，我自會確保那位小管家走上那些樓梯。這事包在我身上。",shape=box,color=blue];
		j845959353 -> j1672321314;
	j318540315 [label="你跟瑪麗瑪麗還有她對源拓氏那套諂媚崇拜的問題，你就當解決了。時候一到，我自會處理。",shape=box,color=blue];
		j318540315 -> j3689740941;
	j706586427 [label="篡位者，你和里昂以及他那些心魔的問題，你就當解決了。時候一到，我自會處理。",shape=box,color=blue];
		j706586427 -> j2665620134;
	j890949204 [label="我……好像忘了你到底在追求什麼。要怪就怪你老去亂動我的記憶。到底是什麼？",shape=box,color=blue];
		j890949204 -> j2953660143;
	j1912707602 [label="我本來會建議你耐心點，但是… 既然你旁邊就已經放著一把雷射切割器，我總不能還建議你去用鑿子吧。",shape=box,color=blue];
		j1912707602 -> j1864556816;
	j2391366286 [label="哼。我懂了。老實說，這目標還挺高尚的。這事我自己也試過很多、很多次了。而且每一次都敗得同樣徹底。",shape=box,color=blue];
		j2391366286 -> j919101149;
	j88042062 [label="嗯。",shape=box,color=blue];
		j88042062 -> j47926874;
	j1491940867 [label="里昂。",shape=box,color=red];
		j1491940867 -> j1495507524;
	j126294695 [label="……你。",shape=box,color=red];
		j126294695 -> j1139695451;
	j1265460739 [label="瑪麗。",shape=box,color=red];
		j1265460739 -> j2481687031;
	j3043467059 [label="呵，我懂了。咱倆說好合作，結果你不知何故搞砸了。所以你的獎品就這麼沒了。",shape=box,color=blue];
		j3043467059 -> j2656057703;
	j4280463898 [label="他一開口基本就得兩種情況——要嘛是蠢得要命，要嘛是瘋得要命。",shape=box,color=blue];
		j4280463898 -> j4126308839;
	j3694015948 [label="喔？你居然到現在都倖免於難？我真是嫉妒死你了。不過，你也蹦躂不了多久了，最好先聽聽我的警告。",shape=box,color=blue];
		j3694015948 -> j3403292416;
	j2213828175 [label="我親愛的漂泊者。你是不是忘了？我們 Orokin 從不信什麼神。唯一被我們膜拜的就只有我們自己。",shape=box,color=blue];
		j2213828175 -> j3332206781;
	j1248454557 [label="悉聽尊便。不過我警告你，你這個決定一旦做了，可不是能不付代價就反悔的。",shape=box,color=blue];
		j1248454557 -> j2973583334;
	j662188125 [label="你安分點，幫我讓 Loid 上樓去跟家人和好。然後我就幫你好好整理那堆記憶。",shape=box,color=red];
		j662188125 -> j2207368964;
	j993538733 [label="這又不是說你不能自己做主。這只是說有些事得多試幾次才能成。",shape=box,color=red];
		j993538733 -> j3019852552;
	j1276939310 [label="我希望這不會讓你難過。",shape=box,color=red];
		j1276939310 -> j3689392497;
	j2782898555 [label="我們真的是在重踏舊步像宮廷裡的侍臣模仿的舞步那樣嗎，註定要自我重覆嗎？",shape=box,color=blue];
		j2782898555 -> j993538733;
		j2782898555 -> j1276939310;
	j1809662592 [label="不久之前，我曾告訴你一個可怕的真相。現在我卻不記得為什麼了。",shape=box,color=blue];
		j1809662592 -> j152355301;
	j1672321314 [label="Boolean RoatheFamilyDealNo is now false.",color=orange];
		j1672321314 -> j1891461359;
	j2348567369 [label="Boolean RoatheLyonDatingDealNo is now false.",color=orange];
		j2348567369 -> j4125917382;
	j1293281246 [label="Boolean RoatheSerumDealNo is now false.",color=orange];
		j1293281246 -> j2782521863;
	j3689740941 [label="Boolean RoatheMarieEntratiDealNo is now false.",color=orange];
		j3689740941 -> j1960305047;
	j2665620134 [label="Boolean RoatheLyonConfessionDealNo is now false.",color=orange];
		j2665620134 -> j937923978;
	j1864556816 [label="我想我開始明白你為什麼要把我們的記憶全部抹去。看著那些失敗的嘗試與徒勞的努力……那為什麼不把棋盤掀了重新來過？",shape=box,color=blue];
		j1864556816 -> j2694455983;
	j919101149 [label="當你發現再也無法說服她去相信那些最簡單的事實時，你憤而轉向你手中所擁有的——這個……天賦。",shape=box,color=blue];
		j919101149 -> j1964219998;
	j47926874 [label="我可不喜歡你為了補自己的錯就跑來動我的腦子，漂泊者。不過，既然你是為了我而這麼做……我想，多少還能接受。",shape=box,color=blue];
		j47926874 -> j2714154885;
	j1495507524 [label="Boolean DrifterLyon is now true.",color=orange];
		j1495507524 -> j2428811083;
	j1139695451 [label="Boolean DrifterRoathe is now true.",color=orange];
		j1139695451 -> j182052009;
	j2481687031 [label="Boolean DrifterMarie is now true.",color=orange];
		j2481687031 -> j4206795687;
	j2656057703 [label="所以，你知道自己再也無法達成先前唾手可得的目標，你就訴諸了那種你擁有的……天賦。",shape=box,color=blue];
		j2656057703 -> j1608100240;
	j4126308839 [label="這就像擲枚硬幣，你永遠不知道會是哪一面。而我又始終分不清自己更偏愛哪一面。",shape=box,color=blue];
		j4126308839 -> j2778859540;
	j3403292416 [label="那個女人對阿爾布雷希特那種堅定不移、近乎偏執的奉獻，簡直是沒完沒了 。我本想說那個管家該擔心，但老實說我真心相信那只是單純的崇敬。這話可是由我說出來的。",shape=box,color=blue];
		j3403292416 -> j630585002;
	j3332206781 [label="滿口「太陽」「太陰」，那兩個狂信份子簡直連兩分鐘都不肯靜下來，非得連夜壺都要祝福一番。",shape=box,color=blue];
		j3332206781 -> j3223573469;
	j2973583334 [label="Boolean RoatheFamilyFail is now true.",color=orange];
		j2973583334 -> j3614804610;
	j2207368964 [label="+5 Chemistry",color=orange];
		j2207368964 -> j2207027530;
	j3019852552 [label="你的樂觀真是把我逗樂了。大英雄。我發誓，你們這群人純粹就只是一袋袋由樂觀和希望充氣而來的血肉骨頭。光聽著都讓人牙疼。",shape=box,color=blue];
