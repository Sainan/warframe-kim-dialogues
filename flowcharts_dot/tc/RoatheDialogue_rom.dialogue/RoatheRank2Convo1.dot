	844 [label="錯了！錯得離譜！錯得無以復加！別用那種口氣跟我說話，好像你很懂我的憤怒似的！那種複雜的感受你連萬分之一都無法理解！",shape=box,color=blue];
		844 -> 746;
	845 [label="漂泊者，不准你來對我腦子裡的東西指手畫腳，告訴我什麼有價值什麼沒價值。這並非你的私有物，你無權據為己有。",shape=box,color=blue];
		845 -> 746;
	847 [label="人類最會「眼不見為淨」了。再說了——我好歹是個「原型 Warframe」和一個身經百戰的 Orokin 精英。你以為我連從市集順手拿點糕點都會被抓嗎？",shape=box,color=blue];
		847 -> 852;
	848 [label="沒錯，頂著藍皮膚、尾巴、和被感染的肉。一件斗篷、一頂帽子和一張面具就能起作用，真是令人驚訝。",shape=box,color=blue];
		848 -> 852;
	846 [label="他們已經夠煩了，天天對我鬼叫，說我有罪，要我該懺悔。我可不想再因為騙你而被他們扣上一頂「又撒謊了」的帽子。",shape=box,color=blue];
		846 -> 758;
		846 -> 759;
		846 -> 760;
		846 -> 761;
	849 [label="Update boolean RoatheRank2Convo1Complete",color=orange];
		849 -> 853;
	850 [label="Update boolean RoatheRank2Convo1Complete",color=orange];
		850 -> 854;
	851 [label="Update boolean RoatheRank2Convo1Complete",color=orange];
		851 -> 855;
	852 [label="Update boolean RoatheMariePastry1",color=orange];
		852 -> 856;
		852 -> 857;
	853 [label="Chat ends.",color=orange];
	854 [label="Chat ends.",color=orange];
	855 [label="Chat ends.",color=orange];
	856 [label="但是你順回來的夠瑪麗和里昂吃嗎？",shape=box,color=red];
		856 -> 858;
	857 [label="所以你就這樣偷了那些糕點。",shape=box,color=red];
		857 -> 859;
	858 [label="啊。你以為我會怎樣？只拿自己的份，讓他們餓著？為什麼？只因我不喜歡與他們為伍，我就該把他們甩掉嗎？",shape=box,color=blue];
		858 -> 860;
	859 [label="那顆星球上的一切，原本很快就屬於 Orokin 帝國。嚴格來說，也算是我的。",shape=box,color=blue];
		859 -> 861;
	860 [label="你以為我討厭他們就代表我必然要殘酷對待他們。因為我是個惡魔嘛，所以這樣做也就理所當然了，是嗎？",shape=box,color=blue];
		860 -> 862;
	861 [label="再說，我又沒錢。你還希望我能怎樣？",shape=box,color=blue];
		861 -> 863;
	862 [label="真讓人失望。那種膚淺的行為，蠢人和校園惡霸才會做。",shape=box,color=blue];
		862 -> 864;
	863 [label="我還知道你在船艦上橫衝直撞，奪走所有你想要的東西——別那樣裝無辜地看著我，篡位者。",shape=box,color=blue];
		863 -> 865;
		863 -> 866;
	864 [label="我討厭他們。可我還得跟他們一起活。我還不至於為了區區一塊破糕點去薄待他們。那只是一塊糕點。何必多此一舉把事情搞砸？",shape=box,color=blue];
		864 -> 867;
		864 -> 868;
		864 -> 869;
	865 [label="算了。",shape=box,color=red];
		865 -> 870;
	866 [label="嗯，有道理。",shape=box,color=red];
		866 -> 871;
	867 [label="或者，你也可以出於善意而善待他們。",shape=box,color=red];
		867 -> 872;
	868 [label="所以照你這麼說——你之所以對他們好，是因為你恨他們？",shape=box,color=red];
		868 -> 873;
	869 [label="我猜，我從來沒有那樣想過。",shape=box,color=red];
		869 -> 874;
	870 [label="棒極了。又一個死不認錯的傢伙。好像那兩個狂熱分子還不夠煩似的，整天對我大吼大叫，求我懺悔。",shape=box,color=blue];
		870 -> 758;
		870 -> 759;
		870 -> 760;
		870 -> 761;
	871 [label="+5 Chemistry",color=orange];
		871 -> 875;
	872 [label="沒錯，你也試試看讓他們整天整夜在你耳邊嗡嗡叫，罵你的名字、哭著要你懺悔。",shape=box,color=blue];
		872 -> 758;
		872 -> 759;
		872 -> 760;
		872 -> 761;
	873 [label="正是。這有什麼難理解的？還有我聽得出來你在挖苦我，篡位者。不過別擔心，我覺得挺有趣。",shape=box,color=blue];
		873 -> 876;
	874 [label="+5 Chemistry",color=orange];
		874 -> 877;
	875 [label="謝謝你。總算有個知道什麼時候該讓步的人了！要是那兩個狂熱分子也能這樣，我就不用聽他們整天對我大吼大叫，求我懺悔了。",shape=box,color=blue];
		875 -> 758;
		875 -> 759;
		875 -> 760;
		875 -> 761;
	876 [label="至少比起那些狂熱份子沒完沒了地說教——整天罵我、哭著要我懺悔——這還算好多了。",shape=box,color=blue];
		876 -> 758;
		876 -> 759;
		876 -> 760;
		876 -> 761;
	877 [label="不客氣。真是鬆了一口氣，終於有人腦子懂得轉彎了。要是那兩個狂熱分子也能這樣，我就不用聽他們整天對我大吼大叫，求我懺悔了。",shape=box,color=blue];
		877 -> 758;
		877 -> 759;
		877 -> 760;
		877 -> 761;
}