	609 [label="我覺得非常有趣……你竟與我合謀，來安排我自己的命途。惡魔以其肉身為籌碼，真是諷刺。",shape=box,color=blue];
		609 -> 619;
	608 [label="你那邊怎麼樣了，我的篡位者？我正忙著在幕後幫你牽線，雖然我的影響你可能看不見也暫時感覺不到。",shape=box,color=blue];
		608 -> 619;
	610 [label="告訴我，你已經對我的提議回心轉意了。以前我可能在你在追尋你那……浪漫目標上是一個阻礙？現在，我保證會像雪獸一樣溫馴。嗯。除非那不是你想要的。選擇，由你來決定。",shape=box,color=blue];
		610 -> 620;
	611 [label="告訴我，你已經對我的提議回心轉意了。我能幫你搞定瑪麗那個小麻煩。保證你輕輕鬆鬆抱得美人歸。",shape=box,color=blue];
		611 -> 620;
	612 [label="告訴我，你已經對我的提議回心轉意了。我能幫你搞定里昂這個小問題。保證你輕輕鬆鬆就手到擒來。",shape=box,color=blue];
		612 -> 620;
	613 [label="告訴我，你已經對我的提議回心轉意了。對於……喝血清這件事，以前我可能太過抗拒？我保證這次我會乖得跟雪獸一樣。",shape=box,color=blue];
		613 -> 620;
	614 [label="告訴我，你已經對我的提議回心轉意了。以前我對管家和他的家庭團聚這件事曾經是個阻礙？我保證這次乖得跟雪獸一樣。",shape=box,color=blue];
		614 -> 620;
	615 [label="告訴我，你已經對我的提議回心轉意了——我能幫你搞定瑪麗那個小麻煩。保證你們的對話順順利利。",shape=box,color=blue];
		615 -> 620;
	616 [label="告訴我，你已經對我的提議回心轉意了——我能幫你搞定里昂那個小問題。保證你們的對話順順利利。",shape=box,color=blue];
		616 -> 620;
	617 [label="篡位者，我真忍不住要想你這依依不捨地纏著我聊天，肯定是有什麼企圖吧。而且這個企圖，搞不好我能幫你一把。",shape=box,color=blue];
		617 -> 621;
	618 [label="Evaluate expressions on HellStory",color=orange];
		618 -> 606 [label="x >= 21",color=purple];
		618 -> 622 [label="x < 21",color=purple];
		618 -> 622 [label="false",color=purple];
	619 [label="從我的角度來看，這挑戰挺奇怪的，我只能靠一部分記憶來運作，卻知道你手裡握著另一半的牌。",shape=box,color=blue];
		619 -> 623;
	620 [label="但是你現在做的這一切… 磨蹭瞎忙？這純粹是在浪費時間。所以，快點。你肯開口，你的問題就能解決。",shape=box,color=blue];
		620 -> 624;
		620 -> 625;
	621 [label="告訴我你的目標，讓我們達成一致。 這些……磨蹭瞎忙純粹是在浪費時間。",shape=box,color=blue];
		621 -> 626;
	622 [label="Evaluate expressions",color=orange];
		622 -> 628 [label="RoatheDeal",color=purple];
		622 -> 627 [label="RoatheNoDeal",color=purple];
		622 -> 627 [label="false",color=purple];
	623 [label="那好吧，反正也沒別的事幹，我就繼續吧。「順便問下，我們那個漂浮的小馬屁精怎麼樣了？我猜那個神父還是不肯跟你說話吧。」呸。鬧劇一場。",shape=box,color=blue];
		623 -> 629;
		623 -> 630;
		623 -> 631;
	624 [label="不。抱歉。我不會和 Orokin 做交易。以前不會，現在不會，以後也絕對不會。",shape=box,color=red];
		624 -> 632;
	625 [label="羅瑟，你最好別讓我為此後悔。行。我同意了。我需要你的幫助。",shape=box,color=red];
