	687 [label="+5 Chemistry",color=orange];
		687 -> 709;
	691 [label="你的樂觀真是把我逗樂了。大英雄。我發誓，你們這群人純粹就只是一袋袋由樂觀和希望充氣而來的血肉骨頭。光聽著都讓人牙疼。",shape=box,color=blue];
		691 -> 713;
	692 [label="不，你誤會我了。某種意義上，我覺得這反而讓人安心。這表示即使被剝去所有外殼，我們依舊如故。我們改變不了。",shape=box,color=blue];
		692 -> 714;
	693 [label="你或許是我此生唯一曾想信任的靈魂……也是我現在想不起來當初為什麼敢信任你的理由。",shape=box,color=blue];
