	628 [label="我們那個漂浮的小馬屁精怎麼樣了？我猜那個神父還是不肯跟你說話吧。",shape=box,color=blue];
		628 -> 641;
		628 -> 642;
		628 -> 643;
	627 [label="告訴我，你已經對我的提議回心轉意了嗎？這是你最後的機會了，篡位者。我是一個有耐心的惡魔，但我不喜歡被晾在一邊。",shape=box,color=blue];
		627 -> 639;
		627 -> 640;
	629 [label="至少目前為止，我和瑪麗相處得還算順利。",shape=box,color=red];
		629 -> 644;
	630 [label="還沒。但他總會想通的。",shape=box,color=red];
		630 -> 645;
	631 [label="你好像不太喜歡他們。為什麼？",shape=box,color=red];
		631 -> 646;
	632 [label="隨你便。不過我得提醒你，這是你最後的機會了。現在起，你就只能靠自己了。",shape=box,color=blue];
