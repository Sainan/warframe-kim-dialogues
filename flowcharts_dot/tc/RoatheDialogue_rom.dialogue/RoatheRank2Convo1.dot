	j216863090 [label="Evaluate expressions",color=orange];
		j216863090 -> j2694130358 [label="RoatheKnowsReset",color=purple];
		j216863090 -> j2694130358 [label="RoatheDeal",color=purple];
		j216863090 -> j2694130358 [label="RoatheNoDeal",color=purple];
		j216863090 -> j2694130358 [label="false",color=purple];
	j2415361512 [label="我覺得非常有趣……你竟與我合謀，來安排我自己的命途。惡魔以其肉身為籌碼，真是諷刺。",shape=box,color=blue];
		j2415361512 -> j3659435143;
	j3517801924 [label="你那邊怎麼樣了，我的篡位者？我正忙著在幕後幫你牽線，雖然我的影響你可能看不見也暫時感覺不到。",shape=box,color=blue];
		j3517801924 -> j3659435143;
	j1514545470 [label="告訴我，你已經對我的提議回心轉意了。以前我可能在你在追尋你那……浪漫目標上是一個阻礙？現在，我保證會像雪獸一樣溫馴。嗯。除非那不是你想要的。選擇，由你來決定。",shape=box,color=blue];
		j1514545470 -> j1524098897;
	j3892634525 [label="告訴我，你已經對我的提議回心轉意了。我能幫你搞定瑪麗那個小麻煩。保證你輕輕鬆鬆抱得美人歸。",shape=box,color=blue];
		j3892634525 -> j1524098897;
	j2333628178 [label="告訴我，你已經對我的提議回心轉意了。我能幫你搞定里昂這個小問題。保證你輕輕鬆鬆就手到擒來。",shape=box,color=blue];
		j2333628178 -> j1524098897;
	j780874717 [label="告訴我，你已經對我的提議回心轉意了。對於……喝血清這件事，以前我可能太過抗拒？我保證這次我會乖得跟雪獸一樣。",shape=box,color=blue];
		j780874717 -> j1524098897;
	j1000495852 [label="告訴我，你已經對我的提議回心轉意了。以前我對管家和他的家庭團聚這件事曾經是個阻礙？我保證這次乖得跟雪獸一樣。",shape=box,color=blue];
		j1000495852 -> j1524098897;
	j2327898175 [label="告訴我，你已經對我的提議回心轉意了——我能幫你搞定瑪麗那個小麻煩。保證你們的對話順順利利。",shape=box,color=blue];
		j2327898175 -> j1524098897;
	j2019080726 [label="告訴我，你已經對我的提議回心轉意了——我能幫你搞定里昂那個小問題。保證你們的對話順順利利。",shape=box,color=blue];
		j2019080726 -> j1524098897;
	j2082901911 [label="篡位者，我真忍不住要想你這依依不捨地纏著我聊天，肯定是有什麼企圖吧。而且這個企圖，搞不好我能幫你一把。",shape=box,color=blue];
		j2082901911 -> j1927027186;
	j2694130358 [label="Evaluate expressions on HellStory counter",color=orange];
		j2694130358 -> j3869625108 [label="x >= 21",color=purple];
		j2694130358 -> j2075111951 [label="x < 21",color=purple];
		j2694130358 -> j2075111951 [label="false",color=purple];
	j3659435143 [label="從我的角度來看，這挑戰挺奇怪的，我只能靠一部分記憶來運作，卻知道你手裡握著另一半的牌。",shape=box,color=blue];
		j3659435143 -> j1333303708;
	j1524098897 [label="但是你現在做的這一切… 磨蹭瞎忙？這純粹是在浪費時間。所以，快點。你肯開口，你的問題就能解決。",shape=box,color=blue];
		j1524098897 -> j3531971381;
		j1524098897 -> j3516264063;
	j1927027186 [label="告訴我你的目標，讓我們達成一致。 這些……磨蹭瞎忙純粹是在浪費時間。",shape=box,color=blue];
		j1927027186 -> j2953660143;
	j2075111951 [label="Evaluate expressions",color=orange];
		j2075111951 -> j216315216 [label="RoatheDeal",color=purple];
		j2075111951 -> j3379658947 [label="RoatheNoDeal",color=purple];
		j2075111951 -> j3379658947 [label="false",color=purple];
	j1333303708 [label="那好吧，反正也沒別的事幹，我就繼續吧。「順便問下，我們那個漂浮的小馬屁精怎麼樣了？我猜那個神父還是不肯跟你說話吧。」呸。鬧劇一場。",shape=box,color=blue];
		j1333303708 -> j2488297233;
		j1333303708 -> j2376252713;
		j1333303708 -> j3345771736;
	j3531971381 [label="不。抱歉。我不會和 Orokin 做交易。以前不會，現在不會，以後也絕對不會。",shape=box,color=red];
		j3531971381 -> j2285472441;
	j3516264063 [label="羅瑟，你最好別讓我為此後悔。行。我同意了。我需要你的幫助。",shape=box,color=red];
		j3516264063 -> j1876832257;
	j2953660143 [label="Check boolean LoidFamilyComplete",color=orange];
		j2953660143 -> j3731542657 [label=true,color=green];
		j2953660143 -> j3252449687 [label=true,color=green];
		j2953660143 -> j3952825054 [label=true,color=green];
		j2953660143 -> j3684474996 [label=true,color=green];
		j2953660143 -> j3731542657 [label=false,color=brown];
