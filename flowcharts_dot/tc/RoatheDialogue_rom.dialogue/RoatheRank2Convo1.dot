	j609331212 [label="我們才剛剛開始，只解鎖了記憶的冰山一角。漂泊者，我不知道阿爾布雷希特跟他們說了我的哪些罪行。",shape=box,color=blue];
		j609331212 -> j2275676505;
	j1063049953 [label="我們才剛剛開始，只碰到了那些被鎖住的記憶的一點皮毛。漂泊者，我不知道阿爾布雷希特跟他們說了我的哪些罪行。",shape=box,color=blue];
		j1063049953 -> j2275676505;
	j3535975273 [label="我不知道阿爾布雷希特跟他們說了我的哪些罪行，因為連我自己都搞不清楚。漂泊者，真相就藏在我的記憶裡。",shape=box,color=blue];
		j3535975273 -> j2275676505;
	j3549461092 [label="我知道，你骨子裡根本就是一座憤怒的火山。我也知道，我們得先搞定一些事才能好好談談。",shape=box,color=red];
		j3549461092 -> j1100760152;
	j1798560746 [label="而且你為什麼要信任我？你對我的印象不就只有我……竄改了你的記憶嗎。",shape=box,color=red];
		j1798560746 -> j3221830276;
	j3585503662 [label="漂泊者，如果你不能給我帶點樂子，我幹嘛浪費時間在你身上？我已經有那兩個狂熱分子要應付了，而且我還被迫得忍受他們。",shape=box,color=blue];
		j3585503662 -> j3866645924;
	j618109207 [label="呵，她果然跟你告狀了。她當然會！哼，那能怪我嗎！在那個鳥不生蛋的地獄，除了那些破點心之外算是唯一的好東西了。",shape=box,color=blue];
		j618109207 -> j2356977432;
		j618109207 -> j2593776897;
	j4293101009 [label="+5 Chemistry",color=orange];
		j4293101009 -> j1118919788;
	j1349707318 [label="漂泊者，我需要知道我被奪走了什麼。我需要知道當阿爾布雷希特強行給我注射那管血清時，他到底搶走了我什麼。",shape=box,color=blue];
		j1349707318 -> j1052547321;
		j1349707318 -> j3592486616;
	j2275676505 [label="我必須知道阿爾布雷希特用那管血清搶走了我什麼。漂泊者，我必須知道我腦子裡到底藏了什麼。當然，是在你方便的時候……",shape=box,color=blue];
		j2275676505 -> j3975930180;
		j2275676505 -> j3076491551;
	j1100760152 [label="漂泊者，我為什麼要生氣？",shape=box,color=blue];
		j1100760152 -> j3327070671;
		j1100760152 -> j1001375065;
		j1100760152 -> j2432364358;
	j3221830276 [label="「竄改了我的記憶」？說得真輕巧。好像我是個阿耶檀識塑像，任由你惡作劇一樣擺弄。你幹的可不只是竄改。你把它徹底抹去了。",shape=box,color=blue];
		j3221830276 -> j2544315469;
		j3221830276 -> j3458950125;
	j2356977432 [label="居然是真的？你會溜進高盧去偷巧克力？就憑你那副尊宀……？",shape=box,color=red];
		j2356977432 -> j1489193114;
	j2593776897 [label="你到底是怎麼弄到手的？",shape=box,color=red];
		j2593776897 -> j3980671349;
	j1118919788 [label="哈！真好笑。那個破地方唯一值得懷念的東西大概就是那些巧克力了。",shape=box,color=blue];
		j1118919788 -> j1696684972;
	j1052547321 [label="我保證。",shape=box,color=red];
		j1052547321 -> j3060212290;
	j3592486616 [label="總會搞定的。但這要點時間。",shape=box,color=red];
		j3592486616 -> j40551120;
	j3975930180 [label="我會搞定的。",shape=box,color=red];
		j3975930180 -> j3683561480;
	j3076491551 [label="我在努力了。但是你讓事情變得很困難。",shape=box,color=red];
		j3076491551 -> j2806146958;
	j3327070671 [label="你嘴上說不生氣，但我知道你在騙我。因為……我早就不是第一次幹這種事了。",shape=box,color=red];
		j3327070671 -> j1026176942;
	j1001375065 [label="你氣的是你自願注射了那破血清。你恨你自己，所以你才這麼火大——因為你現在一無所有只剩下你自己了。",shape=box,color=red];
		j1001375065 -> j908043700;
	j2432364358 [label="你說你不生氣？但我真的搞不懂，你怎麼可能不憤怒。",shape=box,color=red];
		j2432364358 -> j908043700;
	j2544315469 [label="你並沒有失去任何值得保留的東西，只是失去了我們的對話而已。",shape=box,color=red];
		j2544315469 -> j3644854696;
	j3458950125 [label="但不是全部——只是我們在這裡的對話。你保留著其他所有東西，甚至包括我們在「墮落淵獄」中恢復的那些。",shape=box,color=red];
		j3458950125 -> j3644854696;
	j1489193114 [label="沒錯，頂著藍皮膚、尾巴、和被感染的肉。一件斗篷、一頂帽子和一張面具就能起作用，真是令人驚訝。",shape=box,color=blue];
		j1489193114 -> j2256350294;
	j3980671349 [label="那有什麼難的？再說了——我好歹是個「原型 Warframe」和一個身經百戰的 Orokin 精英。你以為我連從市集順手拿點糕點都會被抓嗎？",shape=box,color=blue];
		j3980671349 -> j826962782;
	j1696684972 [label="趁你還沒問，我得先開口。這個故事最好讓瑪麗去說。免得那兩個狂熱份子 又來對我鬼吼鬼叫。",shape=box,color=blue];
		j1696684972 -> j3968219141;
	j3060212290 [label="向惡魔許下承諾……可是件危險的事。",shape=box,color=blue];
		j3060212290 -> j3866645924;
	j40551120 [label="而我就是一位有耐心的惡魔。",shape=box,color=blue];
		j40551120 -> j3866645924;
	j3683561480 [label="最好是這樣。",shape=box,color=blue];
		j3683561480 -> j3866645924;
	j2806146958 [label="當然不是！那樣的話趣味何在？",shape=box,color=blue];
		j2806146958 -> j3866645924;
	j1026176942 [label="真是太棒了！我一點也不覺得意外！至於這是真是假，我又何必在意呢？ ！而且——",shape=box,color=blue];
		j1026176942 -> j908043700;
	j908043700 [label="錯了！錯得離譜！錯得無以復加！別用那種口氣跟我說話，好像你很懂我的憤怒似的！那種複雜的感受你連萬分之一都無法理解！",shape=box,color=blue];
		j908043700 -> j3708258034;
	j3644854696 [label="漂泊者，不准你來對我腦子裡的東西指手畫腳，告訴我什麼有價值什麼沒價值。這並非你的私有物，你無權據為己有。",shape=box,color=blue];
		j3644854696 -> j3708258034;
	j2256350294 [label="人類最會「眼不見為淨」了。再說了——我好歹是個「原型 Warframe」和一個身經百戰的 Orokin 精英。你以為我連從市集順手拿點糕點都會被抓嗎？",shape=box,color=blue];
		j2256350294 -> j4202875018;
	j826962782 [label="沒錯，頂著藍皮膚、尾巴、和被感染的肉。一件斗篷、一頂帽子和一張面具就能起作用，真是令人驚訝。",shape=box,color=blue];
		j826962782 -> j4202875018;
	j3968219141 [label="他們已經夠煩了，天天對我鬼叫，說我有罪，要我該懺悔。我可不想再因為騙你而被他們扣上一頂「又撒謊了」的帽子。",shape=box,color=blue];
		j3968219141 -> j3034795636;
		j3968219141 -> j4270924303;
		j3968219141 -> j4012584657;
		j3968219141 -> j1495853141;
	j4202875018 [label="Boolean RoatheMariePastry1 is now true.",color=orange];
		j4202875018 -> j1344564930;
		j4202875018 -> j2299451035;
	j1344564930 [label="但是你順回來的夠瑪麗和里昂吃嗎？",shape=box,color=red];
		j1344564930 -> j232699121;
	j2299451035 [label="所以你就這樣偷了那些糕點。",shape=box,color=red];
		j2299451035 -> j1433615450;
	j232699121 [label="啊。你以為我會怎樣？只拿自己的份，讓他們餓著？為什麼？只因我不喜歡與他們為伍，我就該把他們甩掉嗎？",shape=box,color=blue];
		j232699121 -> j2353787963;
	j1433615450 [label="那顆星球上的一切，原本很快就屬於 Orokin 帝國。嚴格來說，也算是我的。",shape=box,color=blue];
		j1433615450 -> j1248821982;
	j2353787963 [label="你以為我討厭他們就代表我必然要殘酷對待他們。因為我是個惡魔嘛，所以這樣做也就理所當然了，是嗎？",shape=box,color=blue];
		j2353787963 -> j1210114683;
	j1248821982 [label="再說，我又沒錢。你還希望我能怎樣？",shape=box,color=blue];
		j1248821982 -> j1309023155;
	j1210114683 [label="真讓人失望。那種膚淺的行為，蠢人和校園惡霸才會做。",shape=box,color=blue];
		j1210114683 -> j3428897851;
	j1309023155 [label="我還知道你在船艦上橫衝直撞，奪走所有你想要的東西——別那樣裝無辜地看著我，篡位者。",shape=box,color=blue];
		j1309023155 -> j1492210738;
		j1309023155 -> j2367549778;
	j3428897851 [label="我討厭他們。可我還得跟他們一起活。我還不至於為了區區一塊破糕點去薄待他們。那只是一塊糕點。何必多此一舉把事情搞砸？",shape=box,color=blue];
		j3428897851 -> j1669824837;
		j3428897851 -> j1953170894;
		j3428897851 -> j2736166109;
	j1492210738 [label="算了。",shape=box,color=red];
		j1492210738 -> j1015294123;
	j2367549778 [label="嗯，有道理。",shape=box,color=red];
		j2367549778 -> j3234017791;
	j1669824837 [label="或者，你也可以出於善意而善待他們。",shape=box,color=red];
		j1669824837 -> j98782976;
	j1953170894 [label="所以照你這麼說——你之所以對他們好，是因為你恨他們？",shape=box,color=red];
		j1953170894 -> j3314774266;
	j2736166109 [label="我猜，我從來沒有那樣想過。",shape=box,color=red];
		j2736166109 -> j332647006;
	j1015294123 [label="棒極了。又一個死不認錯的傢伙。好像那兩個狂熱分子還不夠煩似的，整天對我大吼大叫，求我懺悔。",shape=box,color=blue];
		j1015294123 -> j3034795636;
		j1015294123 -> j4270924303;
		j1015294123 -> j4012584657;
		j1015294123 -> j1495853141;
	j3234017791 [label="+5 Chemistry",color=orange];
		j3234017791 -> j4100142105;
	j98782976 [label="沒錯，你也試試看讓他們整天整夜在你耳邊嗡嗡叫，罵你的名字、哭著要你懺悔。",shape=box,color=blue];
		j98782976 -> j3034795636;
		j98782976 -> j4270924303;
		j98782976 -> j4012584657;
		j98782976 -> j1495853141;
	j3314774266 [label="正是。這有什麼難理解的？還有我聽得出來你在挖苦我，篡位者。不過別擔心，我覺得挺有趣。",shape=box,color=blue];
		j3314774266 -> j652860630;
	j332647006 [label="+5 Chemistry",color=orange];
		j332647006 -> j1479933045;
	j4100142105 [label="謝謝你。總算有個知道什麼時候該讓步的人了！要是那兩個狂熱分子也能這樣，我就不用聽他們整天對我大吼大叫，求我懺悔了。",shape=box,color=blue];
		j4100142105 -> j3034795636;
		j4100142105 -> j4270924303;
		j4100142105 -> j4012584657;
		j4100142105 -> j1495853141;
	j652860630 [label="至少比起那些狂熱份子沒完沒了地說教——整天罵我、哭著要我懺悔——這還算好多了。",shape=box,color=blue];
		j652860630 -> j3034795636;
		j652860630 -> j4270924303;
		j652860630 -> j4012584657;
		j652860630 -> j1495853141;
	j1479933045 [label="不客氣。真是鬆了一口氣，終於有人腦子懂得轉彎了。要是那兩個狂熱分子也能這樣，我就不用聽他們整天對我大吼大叫，求我懺悔了。",shape=box,color=blue];
		j1479933045 -> j3034795636;
		j1479933045 -> j4270924303;
		j1479933045 -> j4012584657;
		j1479933045 -> j1495853141;
}