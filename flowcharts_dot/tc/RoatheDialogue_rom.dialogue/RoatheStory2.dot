		j3541039037 -> j2983508709;
	j2983508709 [label="為了首次穿越的運輸，大費周章地搞了場大活動。",shape=box,color=blue];
		j2983508709 -> j715502377;
	j715502377 [label="那是執行者 Tormis 的豪華巡洋艦，選擇 Tormis 作為遠征隊長可以解讀為對執行者 Tuvul 在「扎日曼 10-0」號那場醜陋事故中的集體譴責。",shape=box,color=blue];
		j715502377 -> j3394174734;
	j3394174734 [label="Tormis 出發了又返回了，帶回了關於新星系和新世界珠寶般璀璨的記憶。",shape=box,color=blue];
		j3394174734 -> j3158912492;
	j3158912492 [label="幾天內，殖民船隊紛紛出發，急切想踏上那片處女地。",shape=box,color=blue];
