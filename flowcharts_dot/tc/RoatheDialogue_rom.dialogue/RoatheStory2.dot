		j1106480438 -> j391470386;
	j391470386 [label="文字記錄：當 Sentient 完成通往 Tau 的星際軌道時，沒有舉辦盛大儀式。就那樣開始運作了。",shape=box,color=blue];
		j391470386 -> j325420187;
	j325420187 [label="當然，儀式是匆忙安排的，因為真正的 Orokin 連擤鼻涕都要遵守某種講究的排場和禮儀。",shape=box,color=blue];
		j325420187 -> j2228289036;
	j2228289036 [label="首次穿越的運輸船製造了大量聲勢。",shape=box,color=blue];
		j2228289036 -> j3381979634;
	j3381979634 [label="那是執行者 Tormis 的豪華巡洋艦，選擇 Tormis 作為遠征隊長可以解讀為對執行者 Tuvul 在「扎日曼 10-0」號那場醜陋事故中的集體譴責。",shape=box,color=blue];
		j3381979634 -> j1808570033;
	j1808570033 [label="Tormis 出發了又返回了，帶回了關於新星系和新世界珠寶般璀璨的記憶。",shape=box,color=blue];
		j1808570033 -> j1752789942;
	j1752789942 [label="幾天內，殖民船隊紛紛出發，急切想踏上那片處女地。",shape=box,color=blue];
		j1752789942 -> j1068210121;
	j1068210121 [label="隨之而來的 Sentient 攻擊頗為掃興。",shape=box,color=blue];
		j1068210121 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
