	edge [fontname="Roboto Condensed"];

	"RoatheRank4Convo3 begins." [color=orange];
		"RoatheRank4Convo3 begins." -> j3018222529;
	j3018222529 [label="篡位者，請回答我這個問題：如果真到了殊死一戰之時，你覺得你能擊敗你的 Tenno 對立面嗎？",shape=box,color=blue];
		j3018222529 -> j1476491746;
		j3018222529 -> j3007195373;
		j3018222529 -> j1350559949;
	j1476491746 [label="什麼？為什麼……？",shape=box,color=red];
		j1476491746 -> j1987767739;
	j3007195373 [label="我不想參與這場對話。",shape=box,color=red];
		j3007195373 -> j1239509768;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j1987767739 [label="因為我不確定你有沒有注意到，但「Lotus」不僅僅是個 Sentient——順帶一提，她還是把太陰藏進虛空的元兇——而且她也確定地失去了對她自身電路的控制。",shape=box,color=blue];
		j1987767739 -> j850524380;
		j1987767739 -> j1336135594;
		j1987767739 -> j3933189313;
		j1987767739 -> j2580416971;
		j1987767739 -> j3521482903;
	j1239509768 [label="我不非有意粗魯。你該明白，我是很認真的。這純粹是一場務實的對話。",shape=box,color=blue];
		j1239509768 -> j1987767739;
	"Chat ends." [color=orange];
	j850524380 [label="她沒事。你不知道你在說什麼。",shape=box,color=red];
		j850524380 -> j4048397677;
	j1336135594 [label="她失去了對電路的控制？你這話是什麼意思？",shape=box,color=red];
		j1336135594 -> j1213295855;
	j3933189313 [label="不，我不會這麼做。Lotus 救了我的命。她無數次拯救了 Tenno 的生命。我們的一切都歸功於她。",shape=box,color=red];
		j3933189313 -> j2895950922;
	j2580416971 [label="閉嘴，羅瑟，我受夠了。 [結束。 ]",shape=box,color=red];
		j2580416971 -> j1226142599;
	j3521482903 [label="我知道，我也很擔心。但她為我們做了那麼多，我不能背棄她。我必須支持她。",shape=box,color=red];
		j3521482903 -> j2004332608;
	j4048397677 [label="難道不是嗎？注意！看看四周！她究竟花了多少年月站在懸崖邊，拿著那款舊式尋呼機，哼著歌？凝視著虛空？",shape=box,color=blue];
		j4048397677 -> j1983588286;
	j1213295855 [label="她究竟花了多少年月站在懸崖邊，拿著那款舊式尋呼機，哼著歌？凝視著虛空？",shape=box,color=blue];
		j1213295855 -> j1983588286;
	j2895950922 [label="我並非冷漠無情。我理解你的感受。你欠她太多了。我不是叫你殺了她，我是要你別再讓她影響你身邊的人。",shape=box,color=blue];
		j2895950922 -> j1213295855;
	j1226142599 [label="如你所願。但當這一切崩塌的時候呢？別來找我求助。",shape=box,color=blue];
		j1226142599 -> "Chat ends.";
	j2004332608 [label="+5 Chemistry",color=orange];
		j2004332608 -> j3192359153;
	j1983588286 [label="而現在她只是……徘徊著？在黑暗中？將孩子的自我一步步送入記憶深處，為了什麼？僅僅因為阿爾布雷希特打了個響指，低語了句咒語，就能找到回家的路嗎？",shape=box,color=blue];
		j1983588286 -> j1826361976;
	j3192359153 [label="我並非冷漠無情。我理解你的感受。你欠她太多了。我不是叫你殺了她，我是要你別再讓她影響你身邊的人。",shape=box,color=blue];
		j3192359153 -> j263375936;
	j1826361976 [label="難道你不覺得可疑嗎？你不覺得危險嗎？這是個陷阱。她在被人操縱。不是阿爾布雷希特，就是那個所謂的「漠然」。她是個毀壞的程式。她的底層指令正在失靈。",shape=box,color=blue];
		j1826361976 -> j871193792;
	j263375936 [label="當她站在懸崖邊，手裡拿著一部舊式尋呼機，對著自己哼著歌？凝視著虛空？你難道沒想過她可能會跳下去嗎？",shape=box,color=blue];
		j263375936 -> j1983588286;
	j871193792 [label="我不認為她想傷害你。我覺得她只是被利用了。但當時候到了，你可能需要自衛。或者，你可能需要親手除掉他們。",shape=box,color=blue];
		j871193792 -> j2766007866;
	j2766007866 [label="雖然你（但願如此）很可能明白避免 Lotus 再次惹出麻煩的必要性，但她那群野蠻的孩子大軍卻不會。所以我再問一次：",shape=box,color=blue];
		j2766007866 -> j2971614427;
	j2971614427 [label="如果可怕的一天真的到來，你必須動用一切資源背水一戰時，你認為誰會贏？你和你擁有的一切，能對抗所有的 Tenno 和 Lotus？",shape=box,color=blue];
		j2971614427 -> j1236920870;
		j2971614427 -> j3578745638;
		j2971614427 -> j2507502185;
	j1236920870 [label="這太荒謬了。不行。",shape=box,color=red];
		j1236920870 -> j1460745243;
	j3578745638 [label="大概……我不知道，他們有上百個吧。而羅瑟，我有自己。",shape=box,color=red];
		j3578745638 -> j4058225004;
	j2507502185 [label="我連從哪裡開始都不知道。",shape=box,color=red];
		j2507502185 -> j390513051;
	j1460745243 [label="如果你必須這麼做，那就把它當作一個愚蠢的遊戲吧！一個孩子們玩的理論遊戲。",shape=box,color=blue];
		j1460745243 -> j3962551543;
		j1460745243 -> j102316190;
	j4058225004 [label="+5 Chemistry",color=orange];
		j4058225004 -> j1207346386;
	j390513051 [label="那麼，你該慶幸你正和「桃源惡魔」對話。我之所以被稱為戰略家是有原因的。讓我們從最基本的一點開始：數量。你在這個領域完全處於劣勢。",shape=box,color=blue];
		j390513051 -> j4181059854;
	j3962551543 [label="這不是遊戲。",shape=box,color=red];
		j3962551543 -> j2637941544;
	j102316190 [label="說最後一次？不要。[結束]",shape=box,color=red];
		j102316190 -> "Chat ends.";
	j1207346386 [label="完美。我們已經確定了佈局戰場的第一條規則：數量。很明顯，你在數量上處於極度劣勢。",shape=box,color=blue];
		j1207346386 -> j4181059854;
	j4181059854 [label="Check boolean IsDating",color=orange];
		j4181059854 -> j2601132588 [label=true,color=green];
		j4181059854 -> j2220327545 [label=false,color=brown];
	j2637941544 [label="你說得對。這不是遊戲。而且總有一天會變成生死攸關的大事。你對抗你那個……迷你版的自己，以及它們那群野性十足的同伴。",shape=box,color=blue];
		j2637941544 -> j1204020667;
	j2601132588 [label="然而，如果關於你在其他時間線中與原型 Warframe 之間的「個人活動」和情人的傳聞可以被……利用，也許那些資源可以以某種方式被召喚出來。Helminth 需要為此目的進行特別研究和培育……",shape=box,color=blue];
		j2601132588 -> j703798197;
	j2220327545 [label="我曾聽聞你與其他時間軸中的原型 Warframe 有過互動。或許我們可以想辦法善用那些資源。為此，我們需要專門研究和培育 Helminth……",shape=box,color=blue];
		j2220327545 -> j703798197;
	j1204020667 [label="順帶一提，那些野蠻的夥伴已經證明是暴力的、難以管教的，並且會因為同伴的想法與他們自己的「正常」觀點差異過大就殘酷地驅逐他們。",shape=box,color=blue];
		j1204020667 -> j606136861;
		j1204020667 -> j2565824032;
		j1204020667 -> j1769499510;
	j703798197 [label="我甚至不知道那是否可能，但它讓我們來到了這裡，所以我看不出有什麼理由不行……",shape=box,color=blue];
		j703798197 -> j2016787698;
		j703798197 -> j3643754436;
		j703798197 -> j2462451412;
	j606136861 [label="你現在是在暗示 Tenno 是邪惡的嗎？",shape=box,color=red];
		j606136861 -> j5118461;
	j2565824032 [label="你到底在說什麼？",shape=box,color=red];
		j2565824032 -> j4068699960;
	j1769499510 [label="不，我受夠了。[結束]",shape=box,color=red];
		j1769499510 -> j1571926977;
	j2016787698 [label="羅瑟？下地獄吧。",shape=box,color=red];
		j2016787698 -> j4070239995;
	j3643754436 [label="我不會把他們捲入這場混亂。",shape=box,color=red];
		j3643754436 -> j693740714;
	j2462451412 [label="你為此投入了這麼多心思令我感到很警惕。",shape=box,color=red];
		j2462451412 -> j1465806921;
	j5118461 [label="不，不是邪惡。篡位者，我不相信「邪惡」。我從不信，將來也不會信。我相信 Tenno 就像其他人一樣，是美妙又美麗的人類。純粹的人類。更重要的是？他們是孩子。",shape=box,color=blue];
		j5118461 -> j3154386671;
	j4068699960 [label="總有一天，那個可怕的時刻會到來，你必須準備好去做那些無法想像的事。",shape=box,color=blue];
		j4068699960 -> j1401585653;
	j1571926977 [label="這場對話你儘管逃避吧，但你知道我說的每句話都是事實。你只是不願意接受它。",shape=box,color=blue];
		j1571926977 -> "Chat ends.";
	j4070239995 [label="+5 Chemistry",color=orange];
		j4070239995 -> j1927294601;
	j693740714 [label="啊！所以你承認情況很惡劣。這也是一種進步。至少讓我把我的論點講完，可以嗎？",shape=box,color=blue];
		j693740714 -> j3387716911;
		j693740714 -> j698467430;
	j1465806921 [label="我感到震驚的是，顯然你根本沒有考慮那麼多。我至少可以說說我的看法嗎？",shape=box,color=blue];
		j1465806921 -> j3387716911;
		j1465806921 -> j698467430;
	j3154386671 [label="這些孩子被迫面對並參與那種恐怖與犯下那些暴行——這種經歷足以擊垮那些擁有數百年歲月且身經百戰的 Orokin 戰士。",shape=box,color=blue];
		j3154386671 -> j3034528966;
	j1401585653 [label="Tenno 就像其他人一樣，是美妙又美麗的人類。純粹的人類。更重要的是？他們是孩子。",shape=box,color=blue];
		j1401585653 -> j3154386671;
	j1927294601 [label="我已經準備好了，篡位者。我早就準備好了。",shape=box,color=blue];
		j1927294601 -> j155006797;
	j3387716911 [label="好，沒問題，請講，我會聽的。",shape=box,color=red];
		j3387716911 -> j2160586861;
	j698467430 [label="不，我受夠了。",shape=box,color=red];
		j698467430 -> j3309870228;
	j3034528966 [label="我親眼見過禁衛——黃金精英禁衛！ ——丟下他們神聖的鍍金寶劍，從 Tenno 操控的 Warframe 涉足戰場時逃跑。",shape=box,color=blue];
		j3034528966 -> j1840923018;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j2160586861 [label="+5 Chemistry",color=orange];
		j2160586861 -> j1290419591;
	j3309870228 [label="瞧，我也是。",shape=box,color=blue];
		j3309870228 -> "Chat ends.";
	j1840923018 [label="篡位者，他們沒有完全變成瘋狂的狂徒簡直是個奇蹟。我不是說它一定會出錯。我只是說它有可能。而且如果那一天真的到來，你必須有一個應對計劃。",shape=box,color=blue];
		j1840923018 -> j3241675077;
	j1290419591 [label="感謝。總有一天，那個可怕的時刻會到來，你必須準備好去做那些無法想像的事。",shape=box,color=blue];
		j1290419591 -> j1401585653;
	j3241675077 [label="被虛空折磨……被迫謀殺或目睹自己父母的死亡……飽受戰爭蹂躪.……記憶被竊取……在低溫休眠中迷失數百年……",shape=box,color=blue];
		j3241675077 -> j3388425686;
	j3388425686 [label="篡位者，他們沒有完全變成瘋狂的狂徒簡直是個奇蹟。我不是說它一定會出錯。我只是說它有可能。而且如果那一天真的到來，你必須有一個應對計劃。",shape=box,color=blue];
		j3388425686 -> j2735009397;
	j2735009397 [label="為最壞的情況做準備沒有壞處。沒有準備才是世上最大的危險。",shape=box,color=blue];
		j2735009397 -> j1871507912;
		j2735009397 -> j1107668997;
		j2735009397 -> j2017720645;
		j2735009397 -> j2577594978;
	j1871507912 [label="我會……關注情況。好嗎？但我不會在背後搞鬼。",shape=box,color=red];
		j1871507912 -> j302095920;
	j1107668997 [label="我真的，真的討厭我竟然有點同意你說的。",shape=box,color=red];
		j1107668997 -> j2664879764;
	j2017720645 [label="你意識到我承受的痛苦和 Tenno 一樣多，對吧？",shape=box,color=red];
		j2017720645 -> j2901695204;
	j2577594978 [label="我不會背叛他們的信任。",shape=box,color=red];
		j2577594978 -> j344970161;
	j302095920 [label="+5 Chemistry",color=orange];
		j302095920 -> j301127635;
	j2664879764 [label="+5 Chemistry",color=orange];
		j2664879764 -> j2174009888;
	j2901695204 [label="誰說我沒有跟他們進行同樣的對話，嗯？",shape=box,color=blue];
		j2901695204 -> j1118224375;
	j344970161 [label="我也沒有暗示你應該做別的事情。",shape=box,color=blue];
		j344970161 -> j346357367;
	j301127635 [label="當然！這正是魔鬼所能奢求的一切了，謝謝。",shape=box,color=blue];
		j301127635 -> j346357367;
	j2174009888 [label="嗯，這只是多年後大腦恢復理智的感覺而已。你會習慣的。",shape=box,color=blue];
