		j1437250236 -> j1692949551 [label=false,color=brown];
	"Chat ends." [color=orange];
	j3651308753 [label="嗯。告訴我。上次我們幹這事的時候，我有沒有成功說服你，你的「漠然」只是拼湊起來的兒童玩具？還是說你仍然堅信「漠然」是什麼「來自虛空的偉大未知存在」？",shape=box,color=blue];
		j3651308753 -> j2454048583;
	j1692949551 [label="Check boolean RoatheMITW1",color=orange];
		j1692949551 -> j4277305654 [label=true,color=green];
		j1692949551 -> j1330166991 [label=false,color=brown];
	j2454048583 [label="如果這世上還有一件事是我鄙視的，那就是追著自己的尾巴跑白忙活。而且我剛意識到這句話，以前這句話聽起來還只是個隱喻，而現在這句話就是寫實的比喻了。",shape=box,color=blue];
		j2454048583 -> j2425749514;
		j2454048583 -> j3934390371;
		j2454048583 -> j1671826701;
	j4277305654 [label="所以，在我們繼續之前，我想先確認一下。你相信漠然是某種來自虛空的可怕未知存在，因為阿爾布雷希特的失誤而洩漏到我們的現實中的？",shape=box,color=blue];
		j4277305654 -> j1767993346;
	j1330166991 [label="這瘋人院裡的每個人都他媽的深信那個「牆中人」是什麼貨真價實、滑天下之大稽的神，連那兩個狂熱分子都好像認真考慮這個可能！",shape=box,color=blue];
		j1330166991 -> j1369896574;
		j1330166991 -> j1764029899;
		j1330166991 -> j2341619462;
	j2425749514 [label="不，你說服不了我。抱歉。",shape=box,color=red];
		j2425749514 -> j1674083411;
	j3934390371 [label="你確實說服了。",shape=box,color=red];
		j3934390371 -> j4220121702;
	j1671826701 [label="我們從來沒有真正倒向任何立場。",shape=box,color=red];
		j1671826701 -> j1065558772;
	j1767993346 [label="容我這麼問吧，免得我們又開始原地打轉，最後又變成追著自己的尾巴跑白忙活。我……剛意識到，追尾巴這個比喻以前是個隱喻，可現在卻是個寫實的比喻了。",shape=box,color=blue];
		j1767993346 -> j3033038969;
	j1369896574 [label="你認為他不是真實的？",shape=box,color=red];
		j1369896574 -> j1738099563;
	j1764029899 [label="那如果你認為他不是神，你認為他是什麼？",shape=box,color=red];
		j1764029899 -> j2569805626;
	j2341619462 [label="你也不信？",shape=box,color=red];
		j2341619462 -> j2749993581;
	j1674083411 [label="Boolean RoatheMITWSkip is now true.",color=orange];
		j1674083411 -> j4007752880;
	j4220121702 [label="Boolean RoatheMITWSkip is now true.",color=orange];
		j4220121702 -> j2848616775;
	j1065558772 [label="啊！好吧，看來我還有工作要做。",shape=box,color=blue];
		j1065558772 -> j4263256138;
	j3033038969 [label="你相信那個叫「漠然」的，在阿爾布雷希特跑去招惹它之前，它就已經存在了嗎？還是你更傾向相信，是他第一次接觸虛空的時候創造了它？",shape=box,color=blue];
		j3033038969 -> j3484857051;
		j3033038969 -> j3767493546;
		j3033038969 -> j4160305888;
		j3033038969 -> j1178915253;
	j1738099563 [label="我可說過那些話喔，篡位者，別急著把話塞到我嘴裡。我沒有否認漠然是「真實存在」的。我否認的是，「他」是神的這種說法。",shape=box,color=blue];
		j1738099563 -> j2438692646;
		j1738099563 -> j3506014002;
	j2569805626 [label="我可以用兩個你應該很清楚也很懂的簡單詞彙，來揭穿這個假神：",shape=box,color=blue];
		j2569805626 -> j933283464;
	j2749993581 [label="絕不可能！第一，這世上根本沒神，這想法有夠蠢。第二，你居然以為阿爾布雷希特那混帳能夠把一個神釋放出來？這比第一點還可笑！",shape=box,color=blue];
		j2749993581 -> j2480538851;
	j4007752880 [label="Boolean RoatheMITW5Real is now true.",color=orange];
		j4007752880 -> j2705645755;
	j2848616775 [label="Boolean RoatheMITW5Fake is now true.",color=orange];
		j2848616775 -> j1214428494;
	j4263256138 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j4263256138 -> j3267007278;
	j3484857051 [label="我不知道。我覺得你也不可能知道。",shape=box,color=red];
		j3484857051 -> j3517484333;
	j3767493546 [label="我認為它是在源拓氏接觸它之前就已經存在的實體。他只是透過概念式體現賦予了它形象和形態。",shape=box,color=red];
		j3767493546 -> j1592170630;
	j4160305888 [label="老實說……我不知道。",shape=box,color=red];
		j4160305888 -> j3945417029;
	j1178915253 [label="你真的認為源拓氏憑空捏造出了一個惡意的虛空之神？",shape=box,color=red];
		j1178915253 -> j1741432449;
	j2438692646 [label="那東西比我以前對抗過的任何東西都更強大。",shape=box,color=red];
		j2438692646 -> j3558338953;
	j3506014002 [label="那麼，你認為他是什麼？",shape=box,color=red];
		j3506014002 -> j2569805626;
	j933283464 [label="概念式體現。",shape=box,color=blue];
		j933283464 -> j3810894781;
		j933283464 -> j992802470;
		j933283464 -> j3266121223;
	j2480538851 [label="虛空中空無一物。正因如此，它才被稱為虛空！ ",shape=box,color=blue];
		j2480538851 -> j2010939343;
		j2480538851 -> j379663114;
	j2705645755 [label="+10 Chemistry",color=orange];
		j2705645755 -> j2467680338;
	j1214428494 [label="+20 Chemistry",color=orange];
		j1214428494 -> j1366089928;
	j3267007278 [label="但是，在我們繼續之前，我想先確認一下。你相信漠然是某種來自虛空的可怕未知存在，因為阿爾布雷希特的失誤而洩漏到我們的現實中的？",shape=box,color=blue];
		j3267007278 -> j1767993346;
	j3517484333 [label="沒錯！我當然可以！正在發生的事，明明就再明顯不過。而你們居然全都堅信窗外有什麼巨大的野獸在拍窗。這簡直可笑至極。事實上那不過是風過枝頭罷了。",shape=box,color=blue];
		j3517484333 -> j379287745;
	j1592170630 [label="怎麼連你也這樣。我還對你抱有一絲希望呢。正在發生的事，明明就再明顯不過。而你們居然全都堅信窗外有什麼巨大的野獸在拍窗。這簡直可笑至極。事實上那不過是風過枝頭罷了。",shape=box,color=blue];
		j1592170630 -> j379287745;
	j3945417029 [label="正在發生的事，明明就再明顯不過。而你們居然全都堅信窗外有什麼巨大的野獸在拍窗。這簡直可笑至極。事實上那不過是風過枝頭罷了。",shape=box,color=blue];
		j3945417029 -> j379287745;
	j1741432449 [label="沒錯！我可以！正在發生的事，明明就再明顯不過。而你們居然全都堅信窗外有什麼巨大的野獸在拍窗。這簡直可笑至極。事實上那不過是風過枝頭罷了。",shape=box,color=blue];
		j1741432449 -> j379287745;
	j3558338953 [label="我有否認過嗎？我倒是覺得，是你們成功地把自己繞進了一場歇斯底里而且毫無意義的巨大折磨裡。",shape=box,color=blue];
		j3558338953 -> j2992604455;
		j3558338953 -> j1061758916;
	j3810894781 [label="虛空以及我們能能利用它做的事的確很危險——相信我，我比你懂。但它是有極限的。你真以為它能憑空造出那種東西？能創造一整套語言？還能用手指啟動船艦來跳躍虛空？",shape=box,color=red];
		j3810894781 -> j146824732;
	j992802470 [label="羅瑟，把他當成只是我們床底下的怪物這種想法……很誘人。但我曾和這東西面對「面」，我不知道那種東西要怎麼只靠我們的腦子就變得出來。",shape=box,color=red];
		j992802470 -> j2442742004;
	j3266121223 [label="概念式體現做不到牆中人能做到的事。雖然源拓氏也許顯化了那東西——也該為把牠帶來負責——但我不相信他是那東西的源頭。",shape=box,color=red];
		j3266121223 -> j1966019256;
	j2010939343 [label="我……",shape=box,color=red];
		j2010939343 -> j1906882177;
	j379663114 [label="不。我見過來自虛空的東西。天使。歌聲。鬼魂。",shape=box,color=red];
		j379663114 -> j1906882177;
	j2467680338 [label="雖然我對你堅持的立場很失望，但我覺得你的坦率令我耳目一新。我很高興我們接下來不用再浪費時間了。我肯定我們會找到別的樂子的。",shape=box,color=blue];
		j2467680338 -> j2638604701;
	j1366089928 [label="Fantastic. I am glad my former self was so wonderfully convincing. And I am hopeful you are being honest and not lying to me in an attempt to \"shut me up.\" But, I have no choice but to believe you.",shape=box,color=blue];
		j1366089928 -> j2439764135;
	j379287745 [label="而現在，受到虛空的影響，你們以恐懼與力量不斷餵養它，如同迴圈般的回饋機制，讓它自行凝聚成這個……東西。牆中人。",shape=box,color=blue];
		j379287745 -> j2170820332;
	j2992604455 [label="你到底在說什麼？",shape=box,color=red];
		j2992604455 -> j1284995337;
	j1061758916 [label="等等。這怎麼怪到我們頭上？該怪的是阿爾布雷希特，是他把它放出來的！",shape=box,color=red];
		j1061758916 -> j190385189;
	j146824732 [label="人類最了不起的地方就是在折磨自己這件事上，總能發明出五花八門的新花樣，不是嗎？你自己見過的那些殘忍玩意，我敢說在咱們那群狂熱者時代是連想都不敢想的。",shape=box,color=blue];
		j146824732 -> j1602782096;
	j2442742004 [label="啊，你離真相如此之近，卻又如此急於將其摒棄。它是你心智的造物這想法很對你當然很「誘人」，因為如果真是如此，就能更容易地否認它，對嗎？不。我反倒認為去面對一個由我們親手造出的造物遠比去面對一個神要危險得多。",shape=box,color=blue];
		j2442742004 -> j2609182042;
	j1966019256 [label="我很欣賞你的謙虛，但我得挑戰一下你那有限的理解力。你根本不懂人類的創造力有多強——尤其是在發明新痛苦這方面。你自己不就以一己之力憑空捏造出你那個宇宙了嗎？",shape=box,color=blue];
		j1966019256 -> j2099361733;
	j1906882177 [label="唯一從虛空而來的東西， 就是那個我們置於其內的東西，——以及那個從中折返的東西。它能改變物質與能量——但它無法創造它們。",shape=box,color=blue];
		j1906882177 -> j283344451;
	j2638604701 [label="我個人倒是很感激能饒過又一輪，不用再在那裡為概念式體現的細枝末節兜圈子、瞎辯論。",shape=box,color=blue];
		j2638604701 -> j1074560031;
	j2439764135 [label="Either way, I am certain we will find other ways to amuse ourselves than to be lost in wandering and circular debates about the finer points of Conceptual Embodiment.",shape=box,color=blue];
		j2439764135 -> j1303871195;
	j2170820332 [label="阿爾布雷希特也許是這場鬧劇的始作俑者。但是你們所有人都在火上加油，令一切燒成了煉獄。漠然本不存在。直至，突然之間，它存在了。",shape=box,color=blue];
		j2170820332 -> j3966883641;
	j1284995337 [label="我要說的是：阿爾布雷希特也許是最初看到他自己的傲慢化作一張獰笑的毀滅之神的臉，然後回望著他，肯定是這樣。",shape=box,color=blue];
		j1284995337 -> j952416615;
	j190385189 [label="阿爾布雷希特也許是最初看到他自己的傲慢化作一張獰笑的毀滅之神的臉，然後回望著他，肯定是這樣。",shape=box,color=blue];
		j190385189 -> j952416615;
	j1602782096 [label="+5 Chemistry",color=orange];
		j1602782096 -> j1211429830;
	j2609182042 [label="一個外來的敵人，你可以去理解他。去操縱他。去打敗他。甚至逼不得已時還能跟他談判。他們有弱點可以被利用。但是一個內在的敵人？那個我們自己造出來的？那可就陰險多了。",shape=box,color=blue];
		j2609182042 -> j2274452402;
	j2099361733 [label="你自己見過的那些殘忍玩意，我敢說在咱們那群狂熱者時代是連想都不敢想的。",shape=box,color=blue];
		j2099361733 -> j1602782096;
	j283344451 [label="想一想，漂泊者。你說的那些虛空天使，那些鬼魂。它們不就是用那些早就迷失在虛空裡的傢伙做的嗎？",shape=box,color=blue];
		j283344451 -> j1947752961;
	j1074560031 [label="雖然這意味著要花更多時間聽那些狂熱分子說教……唉。選擇選擇選擇……",shape=box,color=blue];
		j1074560031 -> "Chat ends.";
	j1303871195 [label="I, for one, am grateful to be spared a second round.",shape=box,color=blue];
		j1303871195 -> j1074560031;
	j3966883641 [label="這一切都是你們的錯。",shape=box,color=blue];
		j3966883641 -> j1913842037;
		j3966883641 -> j3078085485;
		j3966883641 -> j3834627038;
	j952416615 [label="但是你們所有人也都脫不了關係，你們就這樣放任這隻朱巴蜣把屎一路滾下山，越滾越大，越滾越多屎！",shape=box,color=blue];
		j952416615 -> j2880143568;
	j1211429830 [label="作為一種物種，我們可真了不起。總有辦法來餵養我們的恐懼，總有辦法讓它們想出新辦法來毀滅我們自己。",shape=box,color=blue];
		j1211429830 -> j2374976664;
	j2274452402 [label="+5 Chemistry",color=orange];
		j2274452402 -> j694403399;
	j1947752961 [label="那些東西，不過是能量的反芻，就像一隻五顏六色的庫塔在反芻餵養牠的孩子。",shape=box,color=blue];
		j1947752961 -> j2880143568;
	j1913842037 [label="羅斯，我們創造不了那種東西——我跟你說過了。概念式體現是有極限的。",shape=box,color=red];
		j1913842037 -> j1706382751;
	j3078085485 [label="別為這件事責怪我們。那東西造成的破壞，不是我們的錯。",shape=box,color=red];
		j3078085485 -> j607343201;
	j3834627038 [label="你跟我說明一下你的邏輯，看看它到底是如何運作的。大多數透過概念式體現從虛空中誕生出來的東西，都無法離開它——至少不能長時間脫離。",shape=box,color=red];
		j3834627038 -> j2782249577;
	j2880143568 [label="容我用更簡潔的方式來解釋。我可以用兩個你應該很清楚也很懂的簡單詞彙，來揭穿這個假神：",shape=box,color=blue];
		j2880143568 -> j933283464;
	j2374976664 [label="Boolean RoatheMITW1 is now true.",color=orange];
		j2374976664 -> j1767993346;
	j694403399 [label="因為那樣的話我們就必須和我們自己的心魔戰鬥。而人類……從來都贏不了那種戰爭，不是嗎？",shape=box,color=blue];
		j694403399 -> j2374976664;
	j1706382751 [label="這話居然是從那位單槍匹馬憑空幻想出一整個平行維度的人嘴裡說出來的話？拜託，漂泊者……用用你很久以前的想像力想想吧。",shape=box,color=blue];
		j1706382751 -> j2782249577;
	j607343201 [label="我不是在斥責你！這東西在你登場之前，早就醞釀很久了。阿爾布雷希特早就安排好了。",shape=box,color=blue];
		j607343201 -> j285419146;
	j2782249577 [label="概念式體現的原理是這樣的——當你與虛空互動，或靠近虛空時，強烈的情緒和想法就會物理顯現。這點我們都知道。",shape=box,color=blue];
		j2782249577 -> j1974939079;
		j2782249577 -> j769557351;
		j2782249577 -> j2668827637;
	j285419146 [label="他看到了他自己的倒影，並感受到了真正的恐懼。於是，第一顆火星被點燃了，而這把火威脅著要燒毀一切。你們所有人只是在不斷地往裡面添油添柴罷了。",shape=box,color=blue];
		j285419146 -> j2782249577;
	j1974939079 [label="沒錯。就像渡域，它也是透過扎日曼號與這個世界相連的。",shape=box,color=red];
		j1974939079 -> j3394682831;
	j769557351 [label="就像扎日曼號、堅守者和虛空天使一樣。在那艘船上，虛空無處不在。",shape=box,color=red];
		j769557351 -> j3394682831;
	j2668827637 [label="是的。然後呢？",shape=box,color=red];
		j2668827637 -> j2644420355;
	j3394682831 [label="沒錯。虛空在哪裡，概念式體現才能在哪裡。而且只能夠在那裡。",shape=box,color=blue];
		j3394682831 -> j2741998427;
		j3394682831 -> j2374579424;
	j2644420355 [label="虛空在哪裡，概念式體現才能在哪裡。而且只能夠在那裡。",shape=box,color=blue];
		j2644420355 -> j2741998427;
		j2644420355 -> j2374579424;
	j2741998427 [label="但是它曾經去過 1999 。它一直跟著阿爾布雷希特。也跟著我。",shape=box,color=red];
		j2741998427 -> j2048810357;
	j2374579424 [label="等一下……",shape=box,color=red];
		j2374579424 -> j4240947418;
	j2048810357 [label="那些該死的手指。我們為了抵達 Tau 星系，在絕望和瘋狂中，拿走了那些被詛咒的手指。而我們還找到了複製它們的方法，不是嗎？",shape=box,color=blue];
		j2048810357 -> j3380483440;
	j4240947418 [label="對。你總算開竅了。那些該死的手指。我們為了抵達 Tau 星系，在絕望和瘋狂中，拿走了那些被詛咒的手指。而我們還找到了複製它們的方法，不是嗎？",shape=box,color=blue];
		j4240947418 -> j3380483440;
	j3380483440 [label="你走到哪，哪裡就有一點點的虛空……就像一個壕溝和隧道網絡，讓那個東西可以隨心所欲地冒出來。更糟的是？",shape=box,color=blue];
		j3380483440 -> j3870016051;
	j3870016051 [label="Tenno。還有你。你們所有人都被虛空碰過。而且你們所有人，都被那個東西纏著。因為無論你們去哪，它就在哪。",shape=box,color=blue];
		j3870016051 -> j3694619099;
	j3694619099 [label="而且任何與它接觸過一段時間的人都受到影響。源拓氏本人。他的管家。參研者。我自己，和那兩個狂熱分子，因為我們靠近這個聖堂。這名單還能繼續列下去。",shape=box,color=blue];
		j3694619099 -> j1541914938;
		j3694619099 -> j2330075271;
	j1541914938 [label="所以你的高論就是，任何暴露於虛空夠多的人——或者任何如同「電池」一樣的人——都會成為牆中人用作偷窺的窗戶？",shape=box,color=red];
		j1541914938 -> j1190058045;
	j2330075271 [label="但是，我倒是好奇，它是怎麼進入露莎卡的？",shape=box,color=red];
		j2330075271 -> j2241846621;
	j1190058045 [label="正是如此。",shape=box,color=blue];
		j1190058045 -> j3300247143;
	j2241846621 [label="誰？",shape=box,color=blue];
		j2241846621 -> j1949155240;
		j2241846621 -> j3926690934;
	j3300247143 [label="這就能解釋，為什麼它沒有自己的臉，不是嗎？它只能化身為那些它正在折磨的人，出現在那些它試圖折磨的人的眼前。",shape=box,color=blue];
		j3300247143 -> j2656360705;
	j1949155240 [label="妮熙・露莎卡少校。在 1999 年的霍爾瓦尼亞，她負責指揮一支名為清剿隊的軍隊。",shape=box,color=red];
		j1949155240 -> j2349284378;
	j3926690934 [label="長話短說，就是我絕對、絕對不能讓你們兩個見面。",shape=box,color=red];
		j3926690934 -> j3062357616;
	j2656360705 [label="事實上，它似乎只有在掙扎著想把自己表現得更宏大更異類時，才會披上建築的面容。那是它拼命想假裝自己有某種宏偉和神性的時候。",shape=box,color=blue];
		j2656360705 -> j202442017;
		j2656360705 -> j536284827;
	j2349284378 [label="她曾被——或者正被——漠然附。它在共享她的心智，像傀儡一樣操控她。或者，是她允許它入侵的。我們不知道。我們也不知道她是否真的奪回了控制權。",shape=box,color=red];
		j2349284378 -> j707141512;
	j3062357616 [label="你真是一點樂趣都沒有，篡位者。不過，她究竟是如何牽扯進我們的…漠然的？",shape=box,color=blue];
		j3062357616 -> j2349284378;
	j202442017 [label="所以你認為它戴著所有它接觸過的人的臉孔……就是因為它沒有一張屬於自己的臉？",shape=box,color=red];
		j202442017 -> j2497632678;
	j536284827 [label="我倒覺得，牆中人戴著我們的臉，是因為它無法理解當人是什麼感覺。不然的話，它太「宏大」了。",shape=box,color=red];
		j536284827 -> j1125820470;
	j707141512 [label="她聽起來確實是個美味又難纏的傢伙。而且是個十足的樂子。不過，這暫時都無關緊要。你說漠然佔據了她的心智？而這一切是從你那趟穿越過去的短暫旅程開始的？",shape=box,color=blue];
		j707141512 -> j2358725672;
	j2497632678 [label="不，傻瓜。因為它只是在模仿那些創造它的人。它不是一個完整的實體——它只是一個玩具，是用你們餵給它的所有恐懼、可怕和痛苦這些不匹配的零件拼湊起來的。",shape=box,color=blue];
		j2497632678 -> j622946886;
	j1125820470 [label="不，傻瓜。它只是在模仿那些創造它的人。它不是一個完整的實體——它只是一個玩具，是用你們餵給它的所有恐懼、可怕和痛苦這些不匹配的零件拼湊起來的。",shape=box,color=blue];
		j1125820470 -> j622946886;
	j2358725672 [label="如果我們對虛空的認知是對的，那就只有兩種可能：要不就是她自己在 1999 年撞進了虛空（我覺得這可能性極小，但絕非不可能），要不……",shape=box,color=blue];
		j2358725672 -> j4235559744;
	j622946886 [label="唉。我看今天是白費口舌了。算了。你已經對那些洗腦包深信不疑了。我看，阿爾布雷希特根本是個超會洗腦的邪教教主。",shape=box,color=blue];
