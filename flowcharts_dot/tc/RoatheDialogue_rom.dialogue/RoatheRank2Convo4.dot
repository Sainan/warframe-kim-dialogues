		j764131793 -> j3319684477;
	j3528316154 [label="你懂了嗎？永遠別相信科學家。他們願意以瞎搞之名，幹出任何事。不過話說回來，我也只是坐在這裡讀茶解葉猜測罷了，篡位者。這一切都只是單純的假設。",shape=box,color=blue];
