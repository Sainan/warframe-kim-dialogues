		j3834513654 -> j2239647455;
	j1373981470 [label="我理所當然地回抱了她。我是個 Orokin 人，但我並不是怪物。",shape=box,color=blue];
		j1373981470 -> j1145856572;
	j4026532043 [label="那個神父。如果我最後要給個評價，那就是：他的韌性不知為何，竟然像時間本身一樣無窮無盡。",shape=box,color=blue];
		j4026532043 -> j2264179909;
	j3404437014 [label="他對那些事幾乎絕口不提。對此我深表感激。我原以為會聽到譏笑或嘲弄，像是「惡魔終於落魄了」之類的。但事實完全不是那樣。他們表現得就像什麼都沒改變過一樣。",shape=box,color=blue];
