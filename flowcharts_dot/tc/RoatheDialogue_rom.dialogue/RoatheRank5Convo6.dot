		j2813753334 -> j2012830859 [label="RoatheRedeemed",color=purple];
		j2813753334 -> j1354372916 [label="false",color=purple];
	j2960110138 [label="瑪麗？除了想說服你讓她陪我睡上一兩個晚上以外，我還能怎麼想？親愛的漂泊者。（開玩笑的。開玩笑的。）",shape=box,color=blue];
		j2960110138 -> j1193516125;
	j1795239081 [label="我對瑪麗有什麼看法？除了想說服你讓我也加入你們的溫柔鄉過上一兩晚以外，還能有什麼？（開玩笑的。開玩笑的。）",shape=box,color=blue];
		j1795239081 -> j2055815809;
	j2751288731 [label="你到底是如何說服她改變對阿爾布雷希特純潔性的看法的？你可真是個「奇蹟創造者」。或許他們不該崇拜太陽和太陰，而該崇拜你。",shape=box,color=blue];
		j2751288731 -> j560252499;
	j2419144395 [label="我從不知道她仍然活在日常的痛苦中。她將其隱藏，彷彿它就不存在了。她從未提及此事，直到她告訴了你。你彌合了我們之間某種隔閡。",shape=box,color=blue];
		j2419144395 -> j4096235853;
	j3666911169 [label="直到最近我才知道她的成長經歷。她從未對我說過她的故事，直到她告訴了你。你彌合了我們之間某種隔閡。",shape=box,color=blue];
		j3666911169 -> j2139558120;
	j3932484419 [label="一切照舊。我清醒的每一秒都在極度渴望用我的利爪，把她那令人作嘔的聲音徹底撕碎。",shape=box,color=blue];
		j3932484419 -> "Chat ends.";
	j4135785878 [label="好多了，因為我現在有個人可以發洩我的挫敗感。但說實話，我們之間的關係已經改善許多。",shape=box,color=blue];
		j4135785878 -> j2355072826;
	j2531991285 [label="跟里昂「處得來」的人不是我，對吧？哈！請原諒這個糟糕的笑話。我忍不住，而且你讓這一切變得太容易了。",shape=box,color=blue];
		j2531991285 -> j2809057357;
	j759164885 [label="至少比你跟他之間的進度好多了。你到底是怎麼跟他搞砸的？他需要的不過就是一個能聽他傾訴的人。",shape=box,color=blue];
		j759164885 -> j2442918390;
	j2682814837 [label="我們之間的緊張關係改善了很多，尤其是自從你給了他信心，讓他願意說出那些困擾他的心事之後。",shape=box,color=blue];
		j2682814837 -> j2000091244;
	j123823363 [label="我們之間的緊張關係改善了很多，尤其是自從你給了他信心，讓他願意說出那些困擾他的心事之後。",shape=box,color=blue];
		j123823363 -> j3296864009;
	j3060956525 [label="一切照舊。我清醒的每一秒都在極度渴望用我的利爪，把他那令人作嘔的聲音徹底撕碎。",shape=box,color=blue];
		j3060956525 -> "Chat ends.";
	j4003970446 [label="我承認我開始覺得他們稍微好相處一點了。我想很大程度上是因為，他們也一點一點地對我死心了。",shape=box,color=blue];
		j4003970446 -> j4244770486;
	j2012830859 [label="我承認我開始覺得他們慢慢變得好相處些了。我想這和我最近悟出的一些道理有關。",shape=box,color=blue];
		j2012830859 -> j3784453549;
	j1354372916 [label="我發現自己越來越常在想，雖然我現在成了原型 Warframe，沒辦法使用憶夢池來找回記憶……",shape=box,color=blue];
		j1354372916 -> j2440657758;
	j1193516125 [label="我在想她是否意識到，我的挑釁已經從真正的厭煩變成了善意的調侃？",shape=box,color=blue];
		j1193516125 -> j3528116683;
	j2055815809 [label="我必須承認，我一點也不怪你。不僅僅因為她長得漂亮，我又不瞎。那個女人所擁有的慈悲之心，超出了我對她這個年紀的人所能保有的預期。",shape=box,color=blue];
		j2055815809 -> j1193516125;
	j560252499 [label="呸。就是這種言論導致了 Orokin 帝國的崛起。這是這個星系絕不該犯第二次的錯誤。",shape=box,color=blue];
		j560252499 -> j1193516125;
	j4096235853 [label="我承認我就是她說的那些凡夫俗子，我完全搞不懂怎麼會有人能忍受那種一成不變的生活。",shape=box,color=blue];
		j4096235853 -> j1595459771;
	j2139558120 [label="想到她的家人竟然把她丟到大街上。她啊，瑪麗。那個瑪麗啊。那個善良到簡直不合常理的人？！",shape=box,color=blue];
		j2139558120 -> j2642344090;
	j2355072826 [label="他們知道了我的……祕密。關於我自願接受血清的真相。",shape=box,color=blue];
		j2355072826 -> j771837822;
		j2355072826 -> j1495872183;
	j2809057357 [label="我稱讚你敢於面對那個可憐的瘋子。他需要陪伴，也需要慈悲。",shape=box,color=blue];
		j2809057357 -> j3866355558;
	j2442918390 [label="然而你卻把他拒之門外。你真可恥。",shape=box,color=blue];
		j2442918390 -> "Chat ends.";
	j2000091244 [label="他對我提到了他一直聽到的那把 Tenno 小孩聲音。以及他現在如何再也聽不到了。",shape=box,color=blue];
		j2000091244 -> j188755248;
	j3296864009 [label="我很驚訝我對他所遭遇的一切知之甚少。直到他告訴你之後，他才願意告訴我更多。 ",shape=box,color=blue];
		j3296864009 -> j2385453008;
	j4244770486 [label="我開個玩笑。儘管我再次下定決心不理會他們對我人生決定的批評，但我發現自己莫名地開始喜歡上他們了。",shape=box,color=blue];
		j4244770486 -> j219830933;
		j4244770486 -> j4171630529;
	j3784453549 [label="我原本以為他們會嘲笑我的悔改，會譏諷說「他終於清醒了」或「我們早告訴過你了」。但完全不是那樣。他們幾乎絕口不提。",shape=box,color=blue];
		j3784453549 -> j4156770826;
	j2440657758 [label="……如果這還不足以阻止我溺死在裡面的話。",shape=box,color=blue];
		j2440657758 -> "Chat ends.";
	j3528116683 [label="但願如此。但逗她玩實在太有趣了。看著她抓狂，用她的母語土話對我大喊大叫，簡直成了我最喜歡的新消遣。",shape=box,color=blue];
		j3528116683 -> j3536051721;
	j1595459771 [label="她怎麼能維持那樣的冷靜？更不用說那種慈悲之心了。換作是我處在她的境地，我大概會瘋得跟那個神父一樣。",shape=box,color=blue];
		j1595459771 -> j1193516125;
	j2642344090 [label="我無法向你描述我有多想利用 Helminth 回到過去，把她那家人一個一個慢慢殺光。但她大概會反對這麼做。",shape=box,color=blue];
		j2642344090 -> j723332097;
	j771837822 [label="我沒告訴他們。",shape=box,color=red];
		j771837822 -> j363497260;
	j1495872183 [label="他們是怎麼知道的？",shape=box,color=red];
		j1495872183 -> j2650945418;
	j3866355558 [label="但說實話，我們之間的關係已經改善許多。",shape=box,color=blue];
		j3866355558 -> j2355072826;
	j188755248 [label="我想那個聲音即便在他清醒時的噩夢裡，也依然會纏著他不放。那個可憐人將永遠無法分辨現實與虛幻之間的界線。",shape=box,color=blue];
		j188755248 -> j373097172;
	j2385453008 [label="我無法向你描述我有多想利用 Helminth 回到過去，把他的父母一個一個慢慢殺光。但他大概又會跳出來跟我唱反調。",shape=box,color=blue];
		j2385453008 -> j4203315725;
	j219830933 [label="你們三個反正已經被拴在一起了，源拓氏早安排好了。所以，隨遇而安也沒什麼壞處。",shape=box,color=red];
		j219830933 -> j3791536049;
	j4171630529 [label="我很高興。我想他們是真的在乎你。",shape=box,color=red];
		j4171630529 -> j790655549;
	j4156770826 [label="我慶幸他們沒這麼做。我可不想像隻在弄髒地毯後被按著鼻子教訓的小狗一樣受辱。我心裡本來的爛帳已經夠我受了。",shape=box,color=blue];
		j4156770826 -> j219830933;
		j4156770826 -> j4171630529;
