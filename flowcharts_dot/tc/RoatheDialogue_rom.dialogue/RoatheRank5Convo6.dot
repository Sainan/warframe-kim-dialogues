	j1970575181 [label="我握住了他的手，像朋友一樣感謝了他。我是 Orokin 人，但我不是怪物。",shape=box,color=blue];
		j1970575181 -> j417386541;
	j897599105 [label="當我告訴她我們發現的真相時，她什麼也沒說。相反地，她只是……擁抱了我。",shape=box,color=blue];
		j897599105 -> j1093047434;
	j2272388054 [label="尤其是在她了解了關於源拓氏的一切之後。她知道人並不是非黑即白那麼簡單。",shape=box,color=red];
		j2272388054 -> j969967457;
	j3007951556 [label="我只是單純很高興你們兩個能建立起某種友誼。哪怕那僅僅是一場停火協議。",shape=box,color=red];
		j3007951556 -> j2494438101;
	j1595016432 [label="在我這悲慘的一生中，我頭一次接受了這種單純的安慰。",shape=box,color=blue];
		j1595016432 -> j2978726979;
	j2978726979 [label="這其實是委婉地告訴我，她或許沒有我那麼在意這件事。而且她對我為此而讓自己受過的那些折磨感到抱歉。",shape=box,color=blue];
		j2978726979 -> j4008385219;
