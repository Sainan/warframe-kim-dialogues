		j1627473845 -> j3545739259;
	j2823700150 [label="瑪麗有什麼反應？",shape=box,color=red];
		j2823700150 -> j3439471842;
	j3774307227 [label="尤其是里昂。我想他明白直面過去以及我們所做抉擇的艱難。原諒我開個冷笑話，你看看他的眼罩吧。",shape=box,color=blue];
		j3774307227 -> j32725969;
	j3807791478 [label="他厚著臉皮坐過來，跟我抱怨自從喝了源拓氏的血清後，他的信仰是怎麼崩塌的。他為自己的質疑感到羞愧，以及他如何後悔服下血清。",shape=box,color=blue];
		j3807791478 -> j2505707696;
