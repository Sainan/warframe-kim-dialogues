digraph {
	1224 [label="RoatheRank2Convo5 begins.",color=orange];
		1224 -> 1225;
	1225 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1225 -> 1226 [label=true,color=green];
		1225 -> 1227 [label=false,color=brown];
	1226 [label="Check boolean RoatheKnowsReset2",color=orange];
		1226 -> 1229 [label=true,color=green];
		1226 -> 1228 [label=false,color=brown];
	1227 [label="Chat ends.",color=orange];
	1229 [label="以前的我告訴了你關於他和執行者 Nitokh 的交易？唉。我試圖搞懂這一切：以前的我居然信任你，連這麼私人的情報都……結果，轉頭就把我的記憶洗得一乾二淨？",shape=box,color=blue];
		1229 -> 1232;
	1228 [label="Evaluate expressions on HellStory",color=orange];
		1228 -> 1231 [label="x >= 1",color=purple];
		1228 -> 1230 [label="x <= 1",color=purple];
		1228 -> 1230 [label="false",color=purple];
	1232 [label="這讓我痛徹心扉。我本可以告訴你一切——毫無保留地。可你卻把一切……一次又一次抹去，好像我只是你手裡的一個……玩物。",shape=box,color=blue];
		1232 -> 1234;
	1231 [label="你聽我提過執行者 Nitokh。還有我……和她的交易。你必須試著理解，Orokin 帝國並非全然邪惡的。",shape=box,color=blue];
		1231 -> 1233;
	1230 [label="Chat ends.",color=orange];
	1234 [label="我猜，這大概就是天理昭彰吧。畢竟，我們 Orokin 當初就是這樣踐踏人性的，不是嗎？承體廳堂？隨心所欲地炫耀肉體，隨心所欲地選擇新我，用遊戲彼此折磨，只為了那病態的歡愉……",shape=box,color=blue];
		1234 -> 1236;
	1233 [label="只因為毀滅和墮落而被銘記，這讓我很心碎。是的，毀滅和墮落確實無處不在，而我也不否認這一點。",shape=box,color=blue];
		1233 -> 1235;
	1236 [label="我恨它。我非常、非常恨它。",shape=box,color=blue];
		1236 -> 1239;
		1236 -> 1240;
		1236 -> 1238;
	1235 [label="但它同時也有能力創造此等的美麗、此等的喜悅、此等的愛。科學的發展和藝術的進步。看看我們曾經有能力達成的這些豐功偉業！",shape=box,color=blue];
		1235 -> 1237;
	1239 [label="雖然我並非存心傷害你，我也對此深感歉意。但如果這件事能讓你體會到身處於 Orokin 帝國對立面的滋味的話，那也算是寶貴的一課。",shape=box,color=red];
		1239 -> 1245;
	1240 [label="我從沒想過這件事會這樣傷害到你。你不該為 Orokin 社會的運作方式道歉——那不是你締造的。你是在試圖挽救它。",shape=box,color=red];
		1240 -> 1246;
	1238 [label="[結束]",shape=box,color=red];
		1238 -> 1244;
	1237 [label="所以，當 Nitokh 召喚我到她身邊，告訴我她想要殺光所有的 Orokin 時？我立刻就同意了。我想要砍下這條毒蛇的首級。我想要用一個更仁慈的系統來取代它。一個更仁慈的統治者。",shape=box,color=blue];
		1237 -> 1241;
		1237 -> 1242;
		1237 -> 1243;
	1245 [label="Add 3 to Thermostat",color=orange];
		1245 -> 1250;
	1246 [label="Add -3 to Thermostat",color=orange];
		1246 -> 1251;
	1244 [label="Chat ends.",color=orange];
	1241 [label="你的意思是，你想用自己去取代皇帝和執行者？",shape=box,color=red];
		1241 -> 1247;
	1242 [label="那麼統治者會是誰？",shape=box,color=red];
		1242 -> 1248;
	1243 [label="[結束]",shape=box,color=red];
		1243 -> 1249;
	1250 [label="Orokin 帝國並非全然邪惡。只因為毀滅和墮落而被銘記，這讓我很心碎。是的，毀滅和墮落確實無處不在，而我也不否認這一點。",shape=box,color=blue];
		1250 -> 1253;
	1251 [label="要是其他人也能這麼想就好了。要是 Nitokh 也能這麼想就好了。",shape=box,color=blue];
		1251 -> 1254;
	1247 [label="當然！",shape=box,color=blue];
		1247 -> 1252;
	1248 [label="當然，是我自己。",shape=box,color=blue];
		1248 -> 1252;
	1249 [label="Chat ends.",color=orange];
	1253 [label="但它同時也有能力創造此等的美麗、此等的喜悅、此等的愛。科學的發展和藝術的進步。看看我們曾經有能力達成的這些豐功偉業！",shape=box,color=blue];
		1253 -> 1256;
	1254 [label="Orokin 帝國並非全然邪惡。只因為毀滅和墮落而被銘記，這讓我很心碎。是的，毀滅和墮落確實無處不在，而我也不否認這一點。",shape=box,color=blue];
		1254 -> 1253;
	1252 [label="我會確保所有的執行者和皇帝都被……廢黜。然後我會接管，擔任臨時執行者，直到新的體制建立起來。",shape=box,color=blue];
		1252 -> 1255;
	1256 [label="所以，當 Nitokh 召喚我到她身邊，告訴我她想要殺光所有的 Orokin 時？我立刻就同意了。我想要砍下這條毒蛇的首級。我想要用一個更仁慈的系統來取代它。一個更仁慈的統治者。",shape=box,color=blue];
		1256 -> 1260;
		1256 -> 1261;
	1255 [label="要花多久我不知道。但這總比大戰之後發生的那些爛攤子要好，不是嗎？",shape=box,color=blue];
		1255 -> 1257;
		1255 -> 1258;
		1255 -> 1259;
	1260 [label="你的意思是，你想用自己去取代皇帝和執行者？",shape=box,color=red];
		1260 -> 1265;
	1261 [label="那麼統治者會是誰？",shape=box,color=red];
		1261 -> 1266;
	1257 [label="大戰？",shape=box,color=red];
		1257 -> 1262;
	1258 [label="說實話吧，你真的認為你會放棄權力嗎？",shape=box,color=red];
		1258 -> 1263;
	1259 [label="羅瑟，我不認為你會放棄到手了的權力。",shape=box,color=red];
		1259 -> 1264;
	1265 [label="當然！而且別假裝你以前沒聽過，肯定你聽過。",shape=box,color=blue];
		1265 -> 1270;
	1266 [label="當然是我！而且別假裝你以前沒聽過，肯定你聽過。",shape=box,color=blue];
		1266 -> 1270;
	1262 [label="你們現在叫它「遠古之戰」。可對我來說，這場大戰可一點都不「遠古」，在我的記憶中，它才發生了沒幾年。",shape=box,color=blue];
		1262 -> 1267;
	1263 [label="嗯。我不知道。這問題現在還重要嗎？不過在當時，我倒真是堅信我會。",shape=box,color=blue];
		1263 -> 1268;
	1264 [label="+5 Chemistry",color=orange];
		1264 -> 1269;
	1270 [label="我會確保所有的執行者和皇帝都被……廢黜。然後我會接管，擔任臨時執行者，直到新的體制建立起來。",shape=box,color=blue];
		1270 -> 1274;
	1267 [label="時間旅行就是這麼有趣。",shape=box,color=blue];
		1267 -> 1271;
	1268 [label="我竭盡全力才爬回來，結果卻發現……我的族人都死光了。我本來也會和他們 一起被處決。",shape=box,color=blue];
		1268 -> 1272;
	1269 [label="你，閉嘴。",shape=box,color=blue];
		1269 -> 1273;
	1274 [label="要花多久我不知道。但這總比大戰之後發生的那些爛攤子要好，不是嗎？",shape=box,color=blue];
		1274 -> 1258;
		1274 -> 1259;
		1274 -> 1257;
	1271 [label="我感覺才過了短短幾年，「現實」卻已經過去幾千年——帝國早已覆滅，而我的族人盡皆滅亡。",shape=box,color=blue];
		1271 -> 5775;
	1272 [label="在長胴鼓之夜之夜，Tenno 本該將我與眾人一同屠戮。我大概會為了拯救 Nitokh的性命而死。",shape=box,color=blue];
		1272 -> 1275;
	1273 [label="當時我完全堅信我會。但是現在，這一切也無關緊要了，不是嗎？",shape=box,color=blue];
		1273 -> 1268;
	5775 [label="I have come to realize that it does not matter if I would have surrendered power or not, though in the time I was convinced I would.",shape=box,color=blue];
		5775 -> 1272;
	1275 [label="我在想，她到底怎麼了？紀錄裡甚至沒有提到她的名字……所有以她的名義犯下的恐怖、所有的死亡、所有的暴行……我可能是唯一知道這些事的人了。",shape=box,color=blue];
		1275 -> 1276;
	1276 [label="嗯。那些，再加上未來從 Tenno 的腦中、藉由那座憶夢池解鎖出的東西。不過，那並不是我需要解決的問題。",shape=box,color=blue];
		1276 -> 1277;
		1276 -> 1278;
		1276 -> 1279;
	1277 [label="你好像有點被這孩子嚇到了。",shape=box,color=red];
		1277 -> 1280;
	1278 [label="你和 Nitokh 之間發生了什麼事？",shape=box,color=red];
		1278 -> 1281;
	1279 [label="所以你原本計劃背叛 Orokin 人？",shape=box,color=red];
		1279 -> 1282;
	1280 [label="我曾親眼目睹一群被虛空侵蝕的學齡孩童遠端駕馭著被感染的戰爭機器。那些曾經的士兵，如今被重塑為怪誕、美麗，卻又充滿殺意的藝術品，摧毀了整營的士兵。",shape=box,color=blue];
		1280 -> 1283;
	1281 [label="所有事情。",shape=box,color=blue];
		1281 -> 1284;
	1282 [label="沒錯。我們都是。雖然我相信 Nitokh 當時正計畫背叛我，而我也同樣計畫著要背叛 Nitokh。但你應該知道我們 Orokin 就是這副德性。",shape=box,color=blue];
		1282 -> 1285;
	1283 [label="我終於發現他們摧毀了我的帝國。一個統治整個始源星系的帝國。那個眼看就要把 Tau 星系的叛亂給蕩平的帝國！",shape=box,color=blue];
		1283 -> 1286;
	1284 [label="所有在我和 Nitokh 之間發生過的事。",shape=box,color=blue];
		1284 -> 1287;
	1285 [label="每個人都在互相算計。說真的，這不過是家常便飯。",shape=box,color=blue];
		1285 -> 1288;
	1286 [label="而且他們只用了一個夜晚就搞定了。",shape=box,color=blue];
		1286 -> 1289;
	1287 [label="所有事，甚至更多其它的事。",shape=box,color=blue];
		1287 -> 1290;
	1288 [label="Orokin 相互之間的背叛相當普遍。但背叛整個帝國？那種形式的叛國，不僅值得翠玉之光的處決，更值得享受中樞計畫的待遇。",shape=box,color=blue];
		1288 -> 1291;
	1289 [label="你難道就不會嗎？！",shape=box,color=blue];
		1289 -> 1292;
	1290 [label="關於這個話題，我目前想說的就只有這些。",shape=box,color=blue];
		1290 -> 1293;
	1291 [label="Update boolean RoatheTraitor1",color=orange];
		1291 -> 1294;
		1291 -> 1295;
	1292 [label="篡位者，我無法表達我們試圖謀殺執行者所冒的風險有多大——更不用說所有的 Orokin 人了。",shape=box,color=blue];
		1292 -> 1288;
	1293 [label="Update boolean RoatheExecutor1",color=orange];
		1293 -> 1292;
	1294 [label="你認為哪一個比另一個更惡劣？",shape=box,color=red];
		1294 -> 1296;
	1295 [label="所以那種手段並不尋常？",shape=box,color=red];
		1295 -> 1297;
	1296 [label="Nihil 的中樞計畫，毫無疑問。玻璃工匠的造物簡直是……",shape=box,color=blue];
		1296 -> 1298;
	1297 [label="篡位者，Orokin 帝國的存續一直懸在刀刃之上，時刻遊走在毀滅邊緣。只有一樣東西讓它能維持運作：",shape=box,color=blue];
		1297 -> 1299;
	1298 [label="對於那些沒有盔甲或護盾，擋不住翠玉之光一擊的人來說。這算是一種仁慈的死亡。",shape=box,color=blue];
		1298 -> 1300;
	1299 [label="社會規範。",shape=box,color=blue];
		1299 -> 1301;
	1300 [label="中樞，當從一個自願的對象轉換而來時可以毫無痛苦，甚至做到無損。然而……當它被用作懲罰手段時呢？",shape=box,color=blue];
		1300 -> 1302;
	1301 [label="誰也不能隨意站起來謀殺 Orokin！這是絕對不能做的，漂泊者！無法想像！簡直愚蠢透頂！",shape=box,color=blue];
		1301 -> 1303;
	1302 [label="漂泊者，記憶對 Orokin 而言是神聖的。歸根結底，那就是我們的全部。我們的身體是短暫的。我們的臉、我們的聲音、我們的血，一切都可改變。它們就像衣服一樣，隨時可以改變。",shape=box,color=blue];
		1302 -> 1304;
	1303 [label="這也讓弒殺在最終變得荒謬地容易。我想你的 Tenno 分身肯定已經明白到這一點。",shape=box,color=blue];
		1303 -> 1305;
		1303 -> 1306;
	1304 [label="Check boolean RoatheKnowsReset2",color=orange];
		1304 -> 1307 [label=true,color=green];
		1304 -> 1305 [label=false,color=brown];
		1304 -> 1306 [label=false,color=brown];
	1305 [label="但很顯然你根本沒能走到實施計畫的那一步。",shape=box,color=red];
		1305 -> 1308;
	1306 [label="你的計畫怎麼了？",shape=box,color=red];
		1306 -> 1309;
	1307 [label="順便說一句，這可能就是我會如此極度不滿的原因，因為你干擾了它們。",shape=box,color=blue];
		1307 -> 1305;
		1307 -> 1306;
	1308 [label="Evaluate expressions on HellStory",color=orange];
		1308 -> 1310 [label="x >= 21",color=purple];
		1308 -> 1311 [label="x < 21",color=purple];
		1308 -> 1311 [label="false",color=purple];
	1309 [label="Evaluate expressions on HellStory",color=orange];
		1309 -> 1312 [label="x >= 21",color=purple];
		1309 -> 5777 [label="x < 21",color=purple];
		1309 -> 5777 [label="false",color=purple];
	1310 [label="你說得沒錯，非常明顯！在我跟 Nitokh 有時間對執行者們設下陷阱之前，阿爾布雷希特就在那條走廊上與遇到了我。",shape=box,color=blue];
		1310 -> 1313;
	1311 [label="沒能，顯然沒能走到那步。在 Nitokh 和我來得及對執行者們設下陷阱之前，我就被阿爾布雷希特強行變成了這種……東西。",shape=box,color=blue];
		1311 -> 1314;
	1312 [label="你非常清楚我們的計畫發生了什麼事，不是嗎？！在我跟 Nitokh 有時間對執行者們設下陷阱之前，阿爾布雷希特就在那條走廊上與遇到了我。",shape=box,color=blue];
		1312 -> 1315;
	5777 [label="I was forcibly turned into this... thing by Albrecht before Nitokh and I had time to spring our trap for the Executors.",shape=box,color=blue];
		5777 -> 1314;
	1313 [label="然後給我提供了原型 Warframe 血清。嗯……接下來發生的事我們都知道。",shape=box,color=blue];
		1313 -> 1316;
	1314 [label="前一刻，我記得自己還站在一條宏偉的金色走廊裡，下一刻，我就在某個叫做「高盧」的窮鄉僻壤裡痛苦慘叫。",shape=box,color=blue];
		1314 -> 1317;
	1315 [label="他給我提供了原型 Warframe 血清。然後接下來發生的麼我們都知道。",shape=box,color=blue];
		1315 -> 1316;
	1316 [label="這件事我仍然……怒。不。可。遏。為什麼？！我為什麼要跟你說這些？ ！你是怎麼會知道的？ ！ ",shape=box,color=blue];
		1316 -> 1318;
	1317 [label="Nitokh 肯定在我失蹤後就放棄了計畫。她很可能把整個叛國事件都推到我頭上，讓我成為順手的替罪羊。",shape=box,color=blue];
		1317 -> 1319;
	1318 [label="算了！別提了。我現在就走，免得我一時火大就把這該死的電腦給砸了。",shape=box,color=blue];
		1318 -> 1320;
	1319 [label="這就解釋了為什麼我在記錄中找到的所有記載都會稱之我為「懦夫」。他們當然會覺得我是個懦夫——他們以為我跑了！呸。",shape=box,color=blue];
		1319 -> 1321;
	1320 [label="+10 Chemistry",color=orange];
		1320 -> 1322;
	1321 [label="+10 Chemistry",color=orange];
		1321 -> 1323;
	1322 [label="Chat ends.",color=orange];
	1323 [label="不過，知道我在整個計畫中至關重要這種感覺還不錯。我一不在，計畫就得徹底泡湯。",shape=box,color=blue];
		1323 -> 1324;
		1323 -> 1325;
	1324 [label="我不太確定這是否是你該得出的結論。",shape=box,color=red];
		1324 -> 1326;
	1325 [label="被需要的感覺是很不錯。",shape=box,color=red];
		1325 -> 1327;
	1326 [label="Add 1 to Thermostat",color=orange];
		1326 -> 1328;
	1327 [label="+5 Chemistry",color=orange];
		1327 -> 1329;
	1328 [label="漂泊者，你喜歡從哪裡找自我價值就在哪裡找，但我的自我價值由我自己找。 ",shape=box,color=blue];
		1328 -> 1330;
	1329 [label="Add -1 to Thermostat",color=orange];
		1329 -> 1331;
	1330 [label="Chat ends.",color=orange];
	1331 [label="你看？你懂了。",shape=box,color=blue];
		1331 -> 1332;
	1332 [label="Chat ends.",color=orange];
}