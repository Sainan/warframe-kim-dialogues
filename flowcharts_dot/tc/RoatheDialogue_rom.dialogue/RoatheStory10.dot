	2218 [label="文字記錄：是史卡恩，那個易怒、理智又尖酸的人，在戰爭前首先提出了那個計劃。「我們必須飛離巢穴，因為巢穴著火了。」",shape=box,color=blue];
		2218 -> 2221;
	2221 [label="通過過度開發和魯莽實驗，我們已把星系污染到無法再生的地步。",shape=box,color=blue];
		2221 -> 2216;
	2216 [label="向新天地擴張現在是我們唯一的選擇。",shape=box,color=blue];
