	j3683367562 [label="VM: PUNISHMENT",shape=box,color=blue];
		j3683367562 -> j2417950536;
	j2417950536 [label="文字記錄：是史卡恩，那個易怒、理智又尖酸的人，在戰爭前首先提出了那個計劃。「我們必須飛離巢穴，因為巢穴著火了。」",shape=box,color=blue];
		j2417950536 -> j309563701;
	j309563701 [label="通過過度開發和魯莽實驗，我們已把星系污染到無法再生的地步。",shape=box,color=blue];
		j309563701 -> j3507194900;
	j3507194900 [label="向新天地擴張現在是我們唯一的選擇。",shape=box,color=blue];
		j3507194900 -> j2187772141;
	j2187772141 [label="He, too, inaugurated the cowardly Towers in the Void.",shape=box,color=blue];
		j2187772141 -> j50449160;
	j50449160 [label="對 Sentient 回歸的恐懼在他心中如此強烈，以至於他只能想像撤退到虛空之海的島嶼上。",shape=box,color=blue];
		j50449160 -> j1078327309;
	j1078327309 [label="How little credit we gave the Sentients for courage.",shape=box,color=blue];
		j1078327309 -> j1060071859;
	j1060071859 [label="They willingly endured the Void’s scalding fire purely for the chance to punish us.",shape=box,color=blue];
		j1060071859 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}