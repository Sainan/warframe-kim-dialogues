	j120291016 [label="語音訊息：懲罰",shape=box,color=blue];
		j120291016 -> j2859113450;
	j2859113450 [label="文字記錄：是史卡恩，那個易怒、理智又尖酸的人，在戰爭前首先提出了那個計劃。「我們必須飛離巢穴，因為巢穴著火了。」",shape=box,color=blue];
		j2859113450 -> j1976761834;
	j1976761834 [label="通過過度開發和魯莽實驗，我們已把星系污染到無法再生的地步。",shape=box,color=blue];
		j1976761834 -> j1702717878;
	j1702717878 [label="向新天地擴張現在是我們唯一的選擇。",shape=box,color=blue];
		j1702717878 -> j1161282695;
	j1161282695 [label="他也開創了虛空中那些懦弱的塔樓。",shape=box,color=blue];
		j1161282695 -> j523467154;
	j523467154 [label="對 Sentient 回歸的恐懼在他心中如此強烈，以至於他只能想像撤退到虛空之海的島嶼上。",shape=box,color=blue];
		j523467154 -> j4289965391;
	j4289965391 [label="我們多麼低估了 Sentient 的勇氣。",shape=box,color=blue];
		j4289965391 -> j1359219864;
	j1359219864 [label="它們甘願忍受虛空的灼燒之火，純粹為了有機會懲罰我們。",shape=box,color=blue];
		j1359219864 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}