	"Chat ends." [color=orange];
	j4131867352 [label="語音訊息：外交",shape=box,color=blue];
		j4131867352 -> j851004225;
	j851004225 [label="文字記錄：在七人眾之中，Ballas 自詡為同輩中的首席。",shape=box,color=blue];
		j851004225 -> j3362546530;
	j3362546530 [label="永遠是外交家，永遠是能言善道的遊說者，他解決其他人的恩怨和糾紛。",shape=box,color=blue];
		j3362546530 -> j4283754053;
	j4283754053 [label="我欣喜地發現，如今他是夾在兩叢荊棘之間的玫瑰。",shape=box,color=blue];
		j4283754053 -> j3058814797;
	j3058814797 [label="以 Nitokh 為首的好戰派拉向一邊。以史卡恩為首的和平主義者拉向另一邊。",shape=box,color=blue];
		j3058814797 -> j2551736209;
	j2551736209 [label="Ballas 被迫決定，並將招致他所不支持的派系的嚴厲敵意。",shape=box,color=blue];
		j2551736209 -> j3030736335;
	j3030736335 [label="出於我無法猜測的原因，他選擇了和平；投票結果四比三，於是貪婪的 Sentient 突然間成了盟友和朋友。",shape=box,color=blue];
		j3030736335 -> j1523584672;
	j1523584672 [label="「無論如何，他遲早會倒戈」，Nitokh 承諾道，即使我被派去在駐防的禁衛中尋找不滿者。",shape=box,color=blue];
		j1523584672 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}