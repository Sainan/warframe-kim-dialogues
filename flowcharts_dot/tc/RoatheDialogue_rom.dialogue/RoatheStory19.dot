	j2201516041 [label="VM: DIPLOMACY",shape=box,color=blue];
		j2201516041 -> j926928753;
	j926928753 [label="Transcript: Among the Seven Executors, Ballas had styled himself first among equals. ",shape=box,color=blue];
		j926928753 -> j2571974594;
	j2571974594 [label="Ever the diplomat, ever the honey-voiced persuader, he resolved the grudges and disputes of the others.",shape=box,color=blue];
		j2571974594 -> j2135813;
	j2135813 [label="我欣喜地發現，如今他是夾在兩叢荊棘之間的玫瑰。",shape=box,color=blue];
		j2135813 -> j36277383;
	j36277383 [label="The warmonger faction, headed by Nitokh, pulled one way. The pacifists, under Scarne, pulled another.",shape=box,color=blue];
		j36277383 -> j2551736209;
	j2551736209 [label="Ballas 被迫決定，並將招致他所不支持的派系的嚴厲敵意。",shape=box,color=blue];
		j2551736209 -> j3030736335;
	j3030736335 [label="出於我無法猜測的原因，他選擇了和平；投票結果四比三，於是貪婪的 Sentient 突然間成了盟友和朋友。",shape=box,color=blue];
		j3030736335 -> j1523584672;
	j1523584672 [label="「無論如何，他遲早會倒戈」，Nitokh 承諾道，即使我被派去在駐防的禁衛中尋找不滿者。",shape=box,color=blue];
		j1523584672 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}