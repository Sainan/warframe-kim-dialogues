		j4174795012 -> j2553718359 [label="false",color=purple];
	j3925352471 [label="篡位者。我覺得我們快了。再過幾天，我的思緒就差不多完整。我相信，我們很快就能回到「上次中斷的地方」。回想起來，這真是一件奇妙的事。",shape=box,color=blue];
