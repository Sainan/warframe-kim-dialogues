		j3077456970 -> j2277089159 [label="RoatheNoDeal",color=purple];
		j3077456970 -> j2277089159 [label="false",color=purple];
	j2565367296 [label="如果我們做不到，我想你應該有解決方法吧？那，明天又是新的一天，也許感覺就跟昨天一樣。",shape=box,color=blue];
		j2565367296 -> j298080266;
	j1398845000 [label="是的，我想我會那樣做。而且我想我是對的。好吧，明天又是新的一天，也許感覺就跟昨天一樣。",shape=box,color=blue];
		j1398845000 -> j298080266;
	j3368609873 [label="是的。隨之而來的是一種難以承受的恐懼感。那，明天又是新的一天，或許感覺就跟昨天一樣。",shape=box,color=blue];
		j3368609873 -> j298080266;
	j322090080 [label="那麼我接下來要問你的，也是發自我內心的，篡位者。我也明白這對我們雙方意味著什麼。",shape=box,color=blue];
