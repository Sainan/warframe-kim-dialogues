	j3282221461 [label="你以為我會在乎嗎？ ！那兩個狂熱分子根本不會察覺。就像魚缸裡的傻魚（無意冒犯費波那契），他們會繼續渾然不覺地快樂生活。",shape=box,color=blue];
		j3282221461 -> j2060867950;
	j2060867950 [label="篡位者，有些可怕的事正在等著我。山頂之上，我將領悟到某種可怕的真相。我能感覺到它像暴風雨前的烏雲一樣在我腦海中聚集。我能看到地平線上那病態的黃色光芒。",shape=box,color=blue];
