		j3821076670 -> j3990622953 [label=true,color=green];
		j3821076670 -> j3384568122 [label=false,color=brown];
	j3041233274 [label="篡位者，我很高興地告訴你，你在憶夢池的工作已經完成，你可以停止挖掘我的記憶了。",shape=box,color=blue];
		j3041233274 -> j3421670829;
	j3978753699 [label="篡位者，雖然在憶夢池恢復我的記憶還有一些工作要完成，但我很高興地宣布我認為我已經徹底完成了這該死的整件事。",shape=box,color=blue];
		j3978753699 -> j2913771943;
	j2604856009 [label="篡位者，雖然你確實……沒有貢獻，沒有在憶夢池開始做任何工作，但我很高興地宣布，我認為我已經徹底結束了這該死的整個事件。",shape=box,color=blue];
		j2604856009 -> j2911245609;
	j2165858036 [label="雖然你可能認為對於發生的一切，我應該要向你表示感謝和道歉，但我要求你抹去我的記憶並重新開始，我認為這只是讓我們「扯平」我為此所遭受的所有痛苦。",shape=box,color=blue];
		j2165858036 -> j3402722908;
		j2165858036 -> j3177627024;
	j2162235316 [label="感覺好空虛，這一切追逐。我想只有你才能體會。好吧，讓我們堅持下去，好嗎？",shape=box,color=blue];
		j2162235316 -> j3402722908;
		j2162235316 -> j3422538353;
	j3990622953 [label="篡位者，我有一個難以啟齒的請求。這個請求絕非我樂意的。我知道你至少對我有所求，也希望你心中對我有一絲好感……",shape=box,color=blue];
		j3990622953 -> j1872088687;
		j3990622953 -> j4015763500;
		j3990622953 -> j1354729703;
	j3384568122 [label="篡位者，我有一個難以啟齒的請求，一個我並不樂意提出的請求。但首先，我想問……我們成為了朋友嗎？你心中是否對我產生了一絲好感？",shape=box,color=blue];
		j3384568122 -> j1777521279;
		j3384568122 -> j787997437;
		j3384568122 -> j148130463;
	j3421670829 [label="我們可以停止在我腦海中喋喋不休，讓大家都經歷這種虛構的折磨，好嗎？ （即使那個牧師樂在其中。）",shape=box,color=blue];
		j3421670829 -> j3279752047;
	j2913771943 [label="我們可以不要在我腦海中喋喋不休，讓大家都經歷這種虛構的折磨，好嗎？ （即使那個牧師樂在其中。）",shape=box,color=blue];
		j2913771943 -> j3279752047;
	j2911245609 [label="你現在可以把這件事忘得一乾二淨。我相信你今天肯定有比這種虛構更有意義的事情要做，對吧？ （即使那個牧師樂在其中。）",shape=box,color=blue];
		j2911245609 -> j3077456970;
	j3402722908 [label="我們會渡過這個難關的。 ",shape=box,color=red];
		j3402722908 -> j2565367296;
	j3177627024 [label="我只是因為你要求我才這麼做的，羅瑟。你警告過我你會生氣。 ",shape=box,color=red];
		j3177627024 -> j1398845000;
	j3422538353 [label="正如你所說的，我們快要成功了。",shape=box,color=red];
		j3422538353 -> j3368609873;
	j1872088687 [label="羅瑟，我在乎你。至於我是否該在乎你，那就見仁見智了。",shape=box,color=red];
		j1872088687 -> j322090080;
	j4015763500 [label="在更了解你之後我改變了之前所有的想法。我簡直無法忍受你。",shape=box,color=red];
		j4015763500 -> j1812464202;
	j1354729703 [label="羅瑟，我非常在乎你。真的，我是認真的。我不確定自己是否應該這樣，但是……我想我愛上你了。",shape=box,color=red];
		j1354729703 -> j4125157780;
	j1777521279 [label="不……僅僅是這樣。 [表白心意]",shape=box,color=red];
		j1777521279 -> j1558755708;
	j787997437 [label="我希望我們是朋友。至少在我的個度是這樣。",shape=box,color=red];
		j787997437 -> j3102716253;
	j148130463 [label="說實話，羅瑟？我真受不了你。",shape=box,color=red];
		j148130463 -> j3417229347;
	j3279752047 [label="事實上，我堅持要求我們這樣做。",shape=box,color=blue];
		j3279752047 -> j3703058924;
	j3077456970 [label="Evaluate expressions",color=orange];
		j3077456970 -> j2277089159 [label="RoatheDeal",color=purple];
