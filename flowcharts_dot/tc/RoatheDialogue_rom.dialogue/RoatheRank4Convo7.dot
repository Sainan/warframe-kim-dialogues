		j968902046 -> j1417679496;
	j1417679496 [label="我需要你運用你的天賦，清除我原型 Warframe 思維中所有這些胡言亂語。趁現在還來得及。我知道你有這種天賦，別猶豫。只要捶打地板，桌子或其他任何你需要的地方就行了。",shape=box,color=blue];
