	j195437297 [label="VM: STANDARD",shape=box,color=blue];
		j195437297 -> j135573444;
	j135573444 [label="文字記錄：沒有什麼比旗手更能簡潔明了地體現我們這些生物對待戰爭殺戮的傲慢自大了。",shape=box,color=blue];
		j135573444 -> j1842969625;
	j1842969625 [label="他們必須不惜一切代價被保護，並且必須被毫無疑問地跟隨。",shape=box,color=blue];
		j1842969625 -> j960845942;
	j960845942 [label="我還要補充一點，他們可能會被威脅去執行任何理智的士兵永遠不會完成的命令，否則將遭受某種更可怕的命運。",shape=box,color=blue];
		j960845942 -> j461203412;
	j461203412 [label="儘管這聽起來很可笑。",shape=box,color=blue];
		j461203412 -> j196594972;
	j196594972 [label="在眾多屍體中，我的目光總是會被他們吸引，儘管他們殘破的軀體與其他屍體並無二致。",shape=box,color=blue];
		j196594972 -> j1451438139;
	j1451438139 [label="吸引我的總是他們手中那面旗幟，閃耀著 Orokin 的金色光芒，並沾染著斑駁的深紅色。",shape=box,color=blue];
		j1451438139 -> j2617396574;
	j2617396574 [label="我總會在離開戰場前確保那面旗幟驕傲矗立。",shape=box,color=blue];
		j2617396574 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}