		1806 -> 1813;
		1806 -> 1814;
	1804 [label="我聽聞的盡是你戰勝那爾邁、擊敗成群的 Grineer 士兵、一路擊退喃喃者的英勇事蹟。但我竟然能讓你束手無策？",shape=box,color=blue];
