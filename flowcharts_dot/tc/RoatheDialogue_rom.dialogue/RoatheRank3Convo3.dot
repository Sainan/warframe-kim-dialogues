		j3791167673 -> j1948836477 [label="x == 0",color=purple];
		j3791167673 -> j1948836477 [label="false",color=purple];
	j11170100 [label="那種揮之不去的念頭日夜折磨著我：我不僅將我最深的秘密都託付給你，你還背叛了那份信任，將一切從我身邊奪走，而現在我甚至不記得原因……",shape=box,color=blue];
		j11170100 -> j1787026705;
	j1577804765 [label="我們在清除我腦海中的障礙方面進展順利。阿爾布雷希特在給我注射那個血清時，真的整慘了我。",shape=box,color=blue];
		j1577804765 -> j1855390936;
		j1577804765 -> j1036420877;
		j1577804765 -> j1350559949;
	j121691966 [label="你在幫助我揭開記憶方面進度停滯。如果你期望我遵守協議，我期望你繼續在墮落淵獄那裡努力。",shape=box,color=blue];
		j121691966 -> j2823588730;
		j121691966 -> j3784024906;
		j121691966 -> j136487965;
		j121691966 -> j1350559949;
	j1948836477 [label="你至今仍未在墮落淵獄那裡取得任何進展，也未能找回我的記憶。如果你希望我履行承諾，你也應該努力履行你的承諾。",shape=box,color=blue];
		j1948836477 -> j3784024906;
		j1948836477 -> j136487965;
		j1948836477 -> j2823588730;
		j1948836477 -> j1350559949;
	j1787026705 [label="Check boolean RoatheResetForgiven",color=orange];
		j1787026705 -> j385405698 [label=true,color=green];
		j1787026705 -> j3845406929 [label=false,color=brown];
	j1855390936 [label="它們看起來不怎麼愉快。",shape=box,color=red];
		j1855390936 -> j4147722743;
	j1036420877 [label="它們看起來不怎麼愉快。你確定我們應該繼續嗎？",shape=box,color=red];
		j1036420877 -> j1853688278;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j2823588730 [label="說實話，我一直有點吃力……不管我多努力，我總是失敗。",shape=box,color=red];
		j2823588730 -> j816550556;
	j3784024906 [label="我憑什麼要聽你的，羅瑟。",shape=box,color=red];
		j3784024906 -> j308214718;
	j136487965 [label="我一直很忙，我會盡快處理。",shape=box,color=red];
		j136487965 -> j1723184116;
	j385405698 [label="我不僅已經原諒你奪走那些記憶的行為……",shape=box,color=blue];
		j385405698 -> j4119950694;
	j3845406929 [label="我不僅開始原諒你奪走那些記憶的行為……",shape=box,color=blue];
		j3845406929 -> j4119950694;
	j4147722743 [label="當然。它們並不愉快。你對「Tau 之惡魔」抱有什麼期待？難道是關於陽光明媚的午後，躺在毯子上吃葡萄的回憶嗎？",shape=box,color=blue];
		j4147722743 -> j596092331;
	j1853688278 [label="在我全部拿回來之前，我不會知道他奪走了什麼。我們當然要繼續！漂泊者，那些記憶是我的。它們定義我現在和過去的一切。它們是我這個人最核心的部分。",shape=box,color=blue];
		j1853688278 -> j3750832418;
	"Chat ends." [color=orange];
	j816550556 [label="Boolean RoatheStrugglebus is now true.",color=orange];
		j816550556 -> j4154913793;
	j308214718 [label="當然，你不需要。你一天做什麼對我來說都無關緊要。我只是想說，如果你想讓那個瘦弱的小管家走上樓梯，你就得做好自己的工作。",shape=box,color=blue];
		j308214718 -> j3164833370;
	j1723184116 [label="最好是這樣。你一天做什麼對我來說都無關緊要。我只是想說，如果你想讓那個瘦弱的小管家走上樓梯，你就得做好自己的工作。",shape=box,color=blue];
		j1723184116 -> j4199961755;
	j4119950694 [label="但我開始發現自己又想再次信任你了。又一次！明明完全知道你做過什麼。明明知道你很可能會再次背叛我！",shape=box,color=blue];
		j4119950694 -> j2829686510;
	j596092331 [label="我可憐的篡位者，我擔心我們在記憶深處的記載中發現的只有血、殘暴和失敗。",shape=box,color=blue];
		j596092331 -> j2538916451;
		j596092331 -> j1083539094;
	j3750832418 [label="從其他人的描述中，我了解到你在渡域期間也曾遭受類似的困擾，對嗎？",shape=box,color=blue];
		j3750832418 -> j2181149055;
		j3750832418 -> j1170223946;
	j4154913793 [label="我聽聞的盡是你戰勝那爾邁、擊敗成群的 Grineer 士兵、一路擊退喃喃者的英勇事蹟。但我竟然能讓你束手無策？",shape=box,color=blue];
		j4154913793 -> j126828240;
	j3164833370 [label="如果你不在乎？那我也不在乎。我還有自己的事情要處理。",shape=box,color=blue];
		j3164833370 -> "Chat ends.";
	j4199961755 [label="如果你不在乎？那我也不在乎。我還有自己的事情要處理。",shape=box,color=blue];
		j4199961755 -> j1933300832;
	j2829686510 [label="But I find myself sitting in that crypt and I stand from that chair and I think to myself \"I wonder if Drifter is about and if they wish to speak.\"",shape=box,color=blue];
		j2829686510 -> j3775883955;
	j2538916451 [label="你是這艘船的駕駛員。如果你想讓它駛向黑洞的話，那就全速前進吧。",shape=box,color=red];
		j2538916451 -> j2397472369;
	j1083539094 [label="那你確定要繼續下去嗎？",shape=box,color=red];
		j1083539094 -> j644870866;
	j2181149055 [label="羅瑟，我們是非常不同的人。",shape=box,color=red];
		j2181149055 -> j2838674168;
	j1170223946 [label="是的。記憶與麻木。我至今仍記不起……大段大段的時光。",shape=box,color=red];
		j1170223946 -> j47129999;
	j126828240 [label="+20 Chemistry",color=orange];
		j126828240 -> j3897647674;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j3775883955 [label="這真是太可悲了！我竟然淪落到如此地步？我？ ！一個 Orokin 人？ ！羅瑟！Tau 之惡魔！我竟會如此焦躁不安，如此精神匱乏，如此渴望任何刺激，以至於我在這裡，跟你說話！",shape=box,color=blue];
		j3775883955 -> j555619309;
		j3775883955 -> j1736380820;
		j3775883955 -> j2183237180;
		j3775883955 -> j1350559949;
	j2397472369 [label="+10 Chemistry",color=orange];
		j2397472369 -> j330204704;
	j644870866 [label="在我全部拿回來之前，我不會知道他奪走了什麼。我們當然要繼續！漂泊者，那些記憶是我的。它們定義我現在和過去的一切。它們是我這個人最核心的部分。",shape=box,color=blue];
		j644870866 -> j465284801;
		j644870866 -> j1041968148;
	j2838674168 [label="也許是這樣，但這並非我想表達的重點。而你卻在迴避承認這一點。好吧。假設你真的失去了記憶——如果可以的話，你會想辦法找回它們嗎？",shape=box,color=blue];
		j2838674168 -> j465284801;
		j2838674168 -> j1041968148;
	j47129999 [label="如果給你一次機會找回失去的記憶，你會嗎？",shape=box,color=blue];
		j47129999 -> j3042823228;
		j47129999 -> j465284801;
		j47129999 -> j1041968148;
	j3897647674 [label="假設你沒騙我？我承認這真是讓我受寵若驚。可愛。極度悲哀。但確實讓我受寵若驚。",shape=box,color=blue];
		j3897647674 -> "Chat ends.";
	j555619309 [label="無論你是否期待，我都很期待我們的對話。",shape=box,color=red];
		j555619309 -> j1518190395;
	j1736380820 [label="我會盡量不把它視為針對我個人的。",shape=box,color=red];
		j1736380820 -> j156083248;
	j2183237180 [label="或者，你只是喜歡和我說話？",shape=box,color=red];
		j2183237180 -> j1763430380;
	j330204704 [label="說得好，漂泊者。只有找回一切，我才能真正體會失去的一切有多麼珍貴。那些記憶構成了現在的我，塑造了過去的我。它們是我生命中不可分割的一部分。",shape=box,color=blue];
		j330204704 -> j3042823228;
		j330204704 -> j465284801;
		j330204704 -> j1041968148;
	j465284801 [label="我認為知道總比不知道好，但是……我們必須做好準備。",shape=box,color=red];
		j465284801 -> j2027795619;
	j1041968148 [label="有時候我認為有些事情應該被塵封是有原因的。",shape=box,color=red];
		j1041968148 -> j4151157703;
	j3042823228 [label="它是你的。是時候讓我們去取回它了。能有多糟呢？你是個 Orokin，你肯定做過更糟的事情。",shape=box,color=red];
		j3042823228 -> j3513105571;
	j1518190395 [label="那麼我真的該感到萬分慶幸。當你用叉子在我的腦袋裡攪動時，我沒有變成一個流口水的白痴。",shape=box,color=blue];
		j1518190395 -> j3284677091;
	j156083248 [label="也許你應該。畢竟，你才是那個用叉子在我的腦袋裡攪動的人。",shape=box,color=blue];
		j156083248 -> j3284677091;
	j1763430380 [label="如果我不知道你曾經用叉子在我腦子裡亂搗鼓，或許我真的會喜歡。",shape=box,color=blue];
		j1763430380 -> j3284677091;
	j2027795619 [label="準備？究竟要如何準備？你以為我一旦知曉某些駭人戰爭罪行的恐怖真相，就會像不堪一擊的紙牌屋那樣崩塌嗎？",shape=box,color=blue];
		j2027795619 -> j863320607;
	j4151157703 [label="那麼，我們豈不是注定要重蹈覆轍，永遠不吸取教訓，永遠不進步，永遠活在對過去的自己渾然不覺的幸福之中嗎？",shape=box,color=blue];
		j4151157703 -> j1602600278;
	j3513105571 [label="+10 Chemistry",color=orange];
		j3513105571 -> j2693360555;
	j3284677091 [label="Check boolean RoatheResetForgiven",color=orange];
		j3284677091 -> j2340203236 [label=true,color=green];
		j3284677091 -> j2169466440 [label=false,color=brown];
	j863320607 [label="相信我，我可以想像我對 Sentients、對 Orokin，或它們兩者任意組合所做過的所有事情，幾乎沒有什麼能讓我感到震驚或恐懼。",shape=box,color=blue];
		j863320607 -> j2557122776;
	j1602600278 [label="嗯，我意識到，我剛才可能反而反駁了自己的論點，這對大多數人來說可能並不成立。",shape=box,color=blue];
		j1602600278 -> j367621601;
	j2693360555 [label="說得好！我絕不會在得知某些可怕戰爭罪行的真相時，就像脆弱的紙牌屋一樣崩潰。",shape=box,color=blue];
		j2693360555 -> j1550955023;
	j2340203236 [label="我說過我原諒你了。我也正試圖信守我對你的承諾。只是言語並不總能讓事情成真。說原諒某人理論上很好聽，但有時情感很難跟隨事實。",shape=box,color=blue];
		j2340203236 -> j525077327;
		j2340203236 -> j2830329955;
	j2169466440 [label="說真的，這一切相當惱人。我想與你交談，但我同時也想掐死你，因為你玷污了我的心智。",shape=box,color=blue];
		j2169466440 -> j1386600423;
		j2169466440 -> j185655627;
	j2557122776 [label="Add 1 to Thermostat counter",color=orange];
		j2557122776 -> j1367594723;
	j367621601 [label="Add -1 to Thermostat counter",color=orange];
		j367621601 -> j35275293;
	j1550955023 [label="Add -2 to Thermostat counter",color=orange];
		j1550955023 -> j911472721;
	j525077327 [label="我理解。這很難接受，你可能想接受，但辦不到。",shape=box,color=red];
		j525077327 -> j2336991558;
	j2830329955 [label="所以你... 不原諒我？",shape=box,color=red];
		j2830329955 -> j2336991558;
	j1386600423 [label="羅瑟，你必須接受已經發生的事，然後繼續前進。",shape=box,color=red];
		j1386600423 -> j1593949861;
	j185655627 [label="你覺得你有可能原諒我嗎？",shape=box,color=red];
		j185655627 -> j630382107;
	j1367594723 [label="我記得很清楚，我可以在接下來的兩千年裡向聖光會祈求「寬恕」，但仍然永遠不會得到寬恕。 ",shape=box,color=blue];
		j1367594723 -> j2495376659;
	j35275293 [label="我更希望自己了解所有事實，然後再從那裡判斷情況。",shape=box,color=blue];
		j35275293 -> j2495376659;
	j911472721 [label="我可以想像我對 Sentients、對 Orokin，或它們兩者任意組合所做過的所有事情，幾乎沒有什麼能讓我感到震驚或恐懼。",shape=box,color=blue];
		j911472721 -> j1991446292;
	j2336991558 [label="篡位者，我正在盡我最大的努力。因為你身上有某種東西吸引了我的注意。你很有魅力。這在我的世界裡是件罕見的事。",shape=box,color=blue];
		j2336991558 -> j180382594;
	j1593949861 [label="嗯哼。",shape=box,color=blue];
		j1593949861 -> "Chat ends.";
	j630382107 [label="Boolean RoatheResetForgiven is now true.",color=orange];
		j630382107 -> j2336991558;
	j2495376659 [label="不，潛藏在我心底的東西並不嚇人。我只是想奪回那些被錯誤地從我身上拿走的東西。",shape=box,color=blue];
		j2495376659 -> j3632496348;
	j1991446292 [label="不，潛藏在我心底的東西並不嚇人。我只是想奪回那些被錯誤地從我身上拿走的東西。",shape=box,color=blue];
		j1991446292 -> j512192803;
	j180382594 [label="所以，如果你能保持耐心，在我試圖釐清這一切時請忍耐一下。",shape=box,color=blue];
		j180382594 -> j2264247660;
		j180382594 -> j1889340634;
	j3632496348 [label="+10 Chemistry",color=orange];
		j3632496348 -> j1737615146;
	j512192803 [label="正如你所說。是時候讓我們奪回屬於我的東西了。",shape=box,color=blue];
		j512192803 -> "Chat ends.";
	j2264247660 [label="我會的。",shape=box,color=red];
		j2264247660 -> j1541592573;
	j1889340634 [label="羅瑟，應該是我向你請求保持耐心，而不是反過來。",shape=box,color=red];
		j1889340634 -> j359370527;
	j1737615146 [label="但我仍然感謝你的關心。",shape=box,color=blue];
		j1737615146 -> "Chat ends.";
	j1541592573 [label="您真是太好了。",shape=box,color=blue];
		j1541592573 -> j4081414586;
	j359370527 [label="+20 Chemistry",color=orange];
		j359370527 -> j1669746800;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j1669746800 [label="感謝你的認可。",shape=box,color=blue];
		j1669746800 -> "Chat ends.";
