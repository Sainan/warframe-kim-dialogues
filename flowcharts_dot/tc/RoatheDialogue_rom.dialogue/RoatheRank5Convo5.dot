	"Chat ends." [color=orange];
	j4019856944 [label="你有沒有進一步思考我關於你對「漠然」的論點？",shape=box,color=blue];
		j4019856944 -> j2936985388;
		j4019856944 -> j880013358;
		j4019856944 -> j1592181870;
		j4019856944 -> j2207455594;
	j2936985388 [label="我有。我認為源拓氏從虛空中釋放出來的是一個無形的神，在我們到達之前它就已經存在於以太之中了。",shape=box,color=red];
		j2936985388 -> j1033472593;
	j880013358 [label="我有。我覺得你在胡說八道。",shape=box,color=red];
		j880013358 -> j4099310853;
	j1592181870 [label="我有。我覺得你說得對。在源拓氏與它接觸之前，它並不存在。他想找到一位神……所以虛空吐出了一個假裝是神的東西。",shape=box,color=red];
		j1592181870 -> j1559036642;
	j2207455594 [label="我有。我認為答案介於兩者之間。它以前或許不是神，但現在是了。我認為源拓氏打開虛空的那一刻，就把它憑空創造出來了。",shape=box,color=red];
		j2207455594 -> j488241700;
	j1033472593 [label="它根本無法理解我們是什麼。 ",shape=box,color=red];
		j1033472593 -> j374603090;
	j4099310853 [label="Check boolean RoatheDating",color=orange];
		j4099310853 -> j1820255843 [label=true,color=green];
		j4099310853 -> j1690446740 [label=false,color=brown];
	j1559036642 [label="從那時起，我們就一直在以恐懼餵養它。",shape=box,color=red];
		j1559036642 -> j181066758;
	j488241700 [label="就像 Rell 現在既存在又不存在一樣，漠然以前從來不是個神，但現在，它卻永遠都是。",shape=box,color=red];
		j488241700 -> j2411316930;
	j374603090 [label="我能否說服你再次考慮我的立場？還是你在這個問題上的看法是不可改變的？",shape=box,color=blue];
		j374603090 -> j1153836045;
		j374603090 -> j3938857776;
	j1820255843 [label="親愛的漂泊者，我沒想到你會有如此敏銳。但引用那些狂熱分子的話：「這就是人生。」",shape=box,color=blue];
		j1820255843 -> j650387292;
	j1690446740 [label="引用那些狂熱分子的話：「這就是人生。」",shape=box,color=blue];
		j1690446740 -> "Chat ends.";
	j181066758 [label="Boolean DrifterMITWNotGod is now true.",color=orange];
		j181066758 -> j92961922;
	j2411316930 [label="我討厭你們這些信奉永恆主義的人。你們拿它來當作一切事物的藉口。只要哲士認為自己理解了它，他們就開始胡說了。",shape=box,color=blue];
		j2411316930 -> j3973010540;
	j1153836045 [label="你可以試試。",shape=box,color=red];
		j1153836045 -> j3158147376;
	j3938857776 [label="沒用。",shape=box,color=red];
		j3938857776 -> j1690446740;
	j650387292 [label="Boolean RoatheNoDate is now true.",color=orange];
		j650387292 -> j776748929;
	j92961922 [label="+5 Chemistry",color=orange];
		j92961922 -> j1511045787;
	j3973010540 [label="「我沒有忘記澆你辦公室的植物，我承諾過會澆的，它只是在經歷一個與我們平行的永恆主義分支。」",shape=box,color=blue];
		j3973010540 -> j2119984710;
	j3158147376 [label="你今天聽起來不太像哲學家，但我還是想試著回答。",shape=box,color=blue];
		j3158147376 -> j142462550;
	j776748929 [label="Boolean RoatheDating is now false.",color=orange];
		j776748929 -> j178902881;
	j1511045787 [label="太棒了！終於有進展了。吹響號角，敲響鐘聲，終於有人清醒過來了！",shape=box,color=blue];
		j1511045787 -> j4290145;
	j2119984710 [label="這讓我很想尖叫。你們在你們這悲慘的人生中，就不能下定一次決心嗎？！",shape=box,color=blue];
		j2119984710 -> j3204001652;
		j2119984710 -> j1637442137;
	j142462550 [label="我也不是有什麼更重要的事情可以做。",shape=box,color=blue];
		j142462550 -> j895790883;
	j178902881 [label="Boolean IsDating is now false.",color=orange];
		j178902881 -> "Chat ends.";
	j4290145 [label="Check boolean RoatheDating",color=orange];
		j4290145 -> j3074151271 [label=true,color=green];
		j4290145 -> j2313510036 [label=false,color=brown];
	j3204001652 [label="我想說的是，它以前不是神，但它現在是了。",shape=box,color=red];
		j3204001652 -> j2702518224;
	j1637442137 [label="算了。",shape=box,color=red];
		j1637442137 -> j4043617206;
	j895790883 [label="我們從頭開始吧，好嗎？你會如何定義「神」是什麼？",shape=box,color=blue];
		j895790883 -> j2055248313;
		j895790883 -> j3899219292;
		j895790883 -> j2145898918;
	j3074151271 [label="儘管我從不懷疑你會改變主意，親愛的漂泊者，但你已經展現出有著辨別是非的品味了。",shape=box,color=blue];
		j3074151271 -> j1504411511;
	j2313510036 [label="儘管我從不懷疑你會改變主意，漂泊者。我可是很有說服力的。",shape=box,color=blue];
		j2313510036 -> j1504411511;
	j2702518224 [label="我明白了。它被阿爾布雷希特從虛空中塑造成了一個「神」。而現在，我們這裡有一個逍遙法外的「神」。妙啊。",shape=box,color=blue];
		j2702518224 -> j2723897928;
		j2702518224 -> j1469542115;
	j4043617206 [label="確實。",shape=box,color=blue];
		j4043617206 -> "Chat ends.";
	j2055248313 [label="至高無上的存在。擁有絕對且不容置疑的權威或權力的事物。 ",shape=box,color=red];
		j2055248313 -> j2520391089;
	j3899219292 [label="一個對創造或人類命運的某個特定方面擁有力量的超人實體或生物。",shape=box,color=red];
		j3899219292 -> j897525169;
	j2145898918 [label="我不確定。你先說吧。",shape=box,color=red];
		j2145898918 -> j2539245504;
	j1504411511 [label="現在，要是我們能找到一個方法來說服收容所裡所有其他的瘋子就好了...",shape=box,color=blue];
		j1504411511 -> j589134541;
		j1504411511 -> j932285877;
	j2723897928 [label="沒錯，是的。",shape=box,color=red];
		j2723897928 -> j2518333822;
	j1469542115 [label="是的，但我認為我們可能都困在如何定義「神」這件事上了。",shape=box,color=red];
		j1469542115 -> j3559054613;
	j2520391089 [label="而你相信你的漠然是這些至高無上的存在之一？",shape=box,color=blue];
		j2520391089 -> j2893752631;
		j2520391089 -> j3938472234;
	j897525169 [label="而你這位漠然是一個至高無上的實體或生物？它掌管著……漠然？掌管著無情？",shape=box,color=blue];
		j897525169 -> j3938472234;
		j897525169 -> j2893752631;
	j2539245504 [label="現在誰才是膽小鬼？很好。讓我把事情簡化，直接切入正題：",shape=box,color=blue];
		j2539245504 -> j1787240527;
	j589134541 [label="我不明白的是，這樣做對我們有什麼好處？",shape=box,color=red];
		j589134541 -> j368741267;
	j932285877 [label="何必呢？",shape=box,color=red];
		j932285877 -> j1304516561;
	j2518333822 [label="那麼，讓我簡化問題，直奔主題：你相信「神」會死嗎？",shape=box,color=blue];
		j2518333822 -> j3671918385;
	j3559054613 [label="問得有道理。你會如何定義「神」呢？",shape=box,color=blue];
		j3559054613 -> j485260160;
		j3559054613 -> j3230042191;
		j3559054613 -> j1234904963;
	j2893752631 [label="我不知道。",shape=box,color=red];
		j2893752631 -> j831348127;
	j3938472234 [label="是的，我相信是這樣。",shape=box,color=red];
		j3938472234 -> j3323216182;
	j1787240527 [label="你相信「神」會死嗎？",shape=box,color=blue];
		j1787240527 -> j3846860963;
		j1787240527 -> j447284973;
		j1787240527 -> j1087046534;
		j1787240527 -> j3368706027;
		j1787240527 -> j1908395526;
	j368741267 [label="這對我們有什麼好處？ 自然是世間上所有的好處！當然，你總是那個獨自奮戰的人。你從未服從過一支軍隊的戰術。",shape=box,color=blue];
		j368741267 -> j583644106;
	j1304516561 [label="何必呢？你這可憐的東西。當然，你總是那個獨自奮戰的人。你從未服從過一支軍隊的戰術。",shape=box,color=blue];
		j1304516561 -> j583644106;
	j3671918385 [label="「神」能以任何形式被徹底抹除嗎？",shape=box,color=blue];
		j3671918385 -> j1787240527;
	j485260160 [label="我不確定。你先說吧。",shape=box,color=red];
		j485260160 -> j4162283744;
	j3230042191 [label="一個對創造或人類命運的某個特定方面擁有力量的超人實體或生物。",shape=box,color=red];
		j3230042191 -> j4228653328;
	j1234904963 [label="一種超越我們理解的實體。一種存在於我們維度之外的生物，因此，它並不「像我們一樣」存在。",shape=box,color=red];
		j1234904963 -> j2387258492;
	j831348127 [label="夠了，別再繞圈子了。讓我直接切入正題：",shape=box,color=blue];
		j831348127 -> j1787240527;
	j3323216182 [label="Check boolean RoatheDating",color=orange];
		j3323216182 -> j2501628800 [label=true,color=green];
		j3323216182 -> j1310352381 [label=false,color=brown];
	j3846860963 [label="我的希望就是把他送回他來的地方。",shape=box,color=red];
		j3846860963 -> j2786870968;
	j447284973 [label="我不知道。而且我認為沒人能知道。",shape=box,color=red];
		j447284973 -> j665823981;
	j1087046534 [label="不，我不這麼認為。物質不滅之類的那種說法。",shape=box,color=red];
		j1087046534 -> j528086404;
	j3368706027 [label="是的，我想是的。否則我們早就被徹底擊敗了，不是嗎？",shape=box,color=red];
		j3368706027 -> j89585568;
	j1908395526 [label="我誠心希望是這樣。",shape=box,color=red];
		j1908395526 -> j3201376369;
	j583644106 [label="知己知彼，百戰不殆。現在，我有個問題想問你。你認為這種生物能被殺死嗎？",shape=box,color=blue];
		j583644106 -> j1635136557;
		j583644106 -> j1947593829;
		j583644106 -> j1273977867;
	j4162283744 [label="現在誰才是膽小鬼？很好。讓我把事情簡化，直接切入正題：",shape=box,color=blue];
		j4162283744 -> j3671918385;
	j4228653328 [label="而你這位漠然是一個至高無上的實體或生物？它掌管著……漠然？掌管著無情？",shape=box,color=blue];
		j4228653328 -> j3263438449;
		j4228653328 -> j3294190806;
	j2387258492 [label="啊哈，我明白了。問題出在這裡。是的，我們的定義不一致。你描述的這個「漠然」是一個實體？好吧，我們達成共識了。",shape=box,color=blue];
		j2387258492 -> j3865007208;
	j2501628800 [label="真令人失望。我本以為你會比這更聰明。但請允許我直接問你這個問題：",shape=box,color=blue];
		j2501628800 -> j1787240527;
	j1310352381 [label="真令人失望。但請允許我直接問你這個問題：",shape=box,color=blue];
		j1310352381 -> j1787240527;
	j2786870968 [label="和事佬。為什麼總是有和事佬出現。",shape=box,color=blue];
		j2786870968 -> j3499480736;
	j665823981 [label="因此，你以你謙遜的無知暗示，我們都在黑暗中摸索前進。",shape=box,color=blue];
		j665823981 -> j1291887651;
	j528086404 [label="喔，太棒了。你認為「神」不會死！",shape=box,color=blue];
		j528086404 -> j3499480736;
	j89585568 [label="而你的邏輯是……神會死，因為……「神」就像泡博一樣嗎？",shape=box,color=blue];
		j89585568 -> j1737586471;
	j3201376369 [label="嗯，對，這很明顯，但漂泊者，好好聽著米我需要你集中注意力。",shape=box,color=blue];
		j3201376369 -> j1737586471;
	j1635136557 [label="說實話，我也不知道。",shape=box,color=red];
		j1635136557 -> j822468097;
	j1947593829 [label="萬物皆可被消滅，連漠然也不例外。總有辦法。",shape=box,color=red];
		j1947593829 -> j37312196;
	j1273977867 [label="我們或許殺不死它，但不代表我們無法阻止它。",shape=box,color=red];
		j1273977867 -> j1512614760;
	j3263438449 [label="是的，我相信是這樣。",shape=box,color=red];
		j3263438449 -> j2667725311;
	j3294190806 [label="我不知道。",shape=box,color=red];
		j3294190806 -> j2667725311;
	j3865007208 [label="我們只是對專有名詞的理解並不一致。真可笑。",shape=box,color=blue];
		j3865007208 -> j1691183718;
	j3499480736 [label="你面前只有兩個選擇。要嘛你相信這個東西會死，因此它不是「神」；",shape=box,color=blue];
		j3499480736 -> j2704355272;
	j1291887651 [label="如果我們都不知道「神」是否會死，而這個漠然又是其中之一，那我們為什麼還要費力去與它戰鬥呢？",shape=box,color=blue];
		j1291887651 -> j3499480736;
