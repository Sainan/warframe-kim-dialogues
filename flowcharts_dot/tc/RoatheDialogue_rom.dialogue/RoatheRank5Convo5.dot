		j2667725311 -> j1787240527;
	j1691183718 [label="老實說，我想「超出我們理解範圍的可怕上古恐怖之物」這詞彙太長了，不適合用來互相調侃。",shape=box,color=blue];
		j1691183718 -> j1787240527;
