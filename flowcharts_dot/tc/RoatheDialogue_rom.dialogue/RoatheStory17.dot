	j2076732161 [label="語音訊息：WARFRAME",shape=box,color=blue];
		j2076732161 -> j2220962579;
	j2220962579 [label="文字記錄：起初， Warframe 似乎更像是藝術宣言而非正當武器。",shape=box,color=blue];
		j2220962579 -> j3790337831;
	j3790337831 [label="戰爭幾乎已輸；Sentient 無法被戰勝；那麼，讓我們創造這些奇異而超現實的戰士，用古老血統的武器武裝他們。",shape=box,color=blue];
		j3790337831 -> j1245944918;
	j1245944918 [label="至少我們的失敗將是美麗的。令人難忘的。",shape=box,color=blue];
		j1245944918 -> j1303358109;
	j1303358109 [label="但出乎所有預料，他們取得了勝利。很快，關於令人難以置信的英雄戰績故事從前線傳回。",shape=box,color=blue];
		j1303358109 -> j1964135267;
	j1964135267 [label="Warframe 如同天使般從天而降，解放俘虜，摧毀 Sentient 據點。即使單獨一個也是個奇蹟；成群結隊時，他們就是神。",shape=box,color=blue];
		j1964135267 -> j803195758;
	j803195758 [label="難怪他們被視為純粹的宣傳工具。",shape=box,color=blue];
		j803195758 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}