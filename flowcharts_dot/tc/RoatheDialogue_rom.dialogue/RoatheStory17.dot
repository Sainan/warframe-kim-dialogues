	2287 [label="VM: WARFRAMES",shape=box,color=blue];
		2287 -> 2286;
	2284 [label="Chat ends.",color=orange];
	2286 [label="文字記錄：起初， Warframe 似乎更像是藝術宣言而非正當武器。",shape=box,color=blue];
		2286 -> 2285;
	2285 [label="爭幾乎已輸；Sentient 無法被戰勝；那麼，讓我們創造這些奇異而超現實的戰士，用古老血統的武器武裝他們。",shape=box,color=blue];
		2285 -> 2282;
	2282 [label="至少我們的失敗將是美麗的。令人難忘的。",shape=box,color=blue];
		2282 -> 2283;
	2283 [label="但出乎所有預料，他們取得了勝利。很快，關於令人難以置信的英雄戰績故事從前線傳回。",shape=box,color=blue];
		2283 -> 5715;
	5715 [label="Warframes had appeared from the sky, angel-like, liberating captives and devastating Sentient strongholds. Even alone they were miracles; in groups, they were gods.",shape=box,color=blue];
		5715 -> 5716;
	5716 [label="Little wonder, then, that they were seen as mere propaganda.",shape=box,color=blue];
		5716 -> 2281;
