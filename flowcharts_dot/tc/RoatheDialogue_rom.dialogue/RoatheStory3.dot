	"Chat ends." [color=orange];
	j3876382352 [label="VM: OROKIN",shape=box,color=blue];
		j3876382352 -> j3947306943;
	j3947306943 [label="文字記錄：Orokin 帝國長久以來都沒有樹敵。其軍隊通常只是為了追逐瑣碎的恩怨，家族對抗家族，執行者對抗執行者。",shape=box,color=blue];
		j3947306943 -> j3122827415;
	j3122827415 [label="當 Sentient 攻擊時，我們體會到了長久以來被拒絕的團結。禁衛拔劍對抗的不再是無禮的農民或無良的商人。",shape=box,color=blue];
		j3122827415 -> j2690756032;
	j2690756032 [label="那些權力由執行者掌握的老不死掛名帝國統治者們，在塵封的黃金寶座上猛然醒來。",shape=box,color=blue];
		j2690756032 -> j813163621;
	j813163621 [label="戰爭，壯麗的戰爭！終於，帝國有了意義。在比太陽最終死亡更迫在眉睫的滅絕威脅下，我們深飲生命的甘露。",shape=box,color=blue];
		j813163621 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}