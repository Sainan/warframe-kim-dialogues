		190 -> 191 [label="x >= 21",color=purple];
		190 -> 192 [label="x < 21",color=purple];
		190 -> 192 [label="false",color=purple];
	189 [label="Chat ends.",color=orange];
	191 [label="我怎麼就那麼懷疑你早就知道答案了呢，篡位者？既然你早就把我腦子裡的破爛都翻過一遍了，還跑來問這種無聊小事，你又在玩什麼花樣？",shape=box,color=blue];
		191 -> 193;
	192 [label="好！你儘管問！這剛好給了我一個機會來炫耀我有多聰明，順便抱怨一下阿爾布雷希特那混帳怎麼能做到莽撞如兔同時又膽小如鼠的！",shape=box,color=blue];
		192 -> 194;
	193 [label="Check boolean RoatheKnowsReset",color=orange];
		193 -> 196 [label=true,color=green];
		193 -> 195 [label=false,color=brown];
	194 [label="Evaluate expressions on HellKeyPlayed",color=orange];
		194 -> 197 [label="x >= 1",color=purple];
		194 -> 198 [label="x <= 0",color=purple];
		194 -> 198 [label="false",color=purple];
	196 [label="你跟阿爾布雷希特一樣噁心！隨便亂搞別人的腦子——以為他們都是你們的玩具嗎！所以告訴我。既然你早就知道答案了，還問個屁？！",shape=box,color=blue];
		196 -> 201;
		196 -> 202;
	195 [label="告訴我。我是不是猜對你早就知道答案了？你早就知道我是怎麼跟那兩個神經病一起回來的——知道我們是從哪裡來的。而且你很可能知道的遠不止這些，對嗎？",shape=box,color=blue];
		195 -> 199;
		195 -> 200;
	197 [label="我猜你不是阿爾布雷希特刻意安排你到那裡去的。",shape=box,color=red];
		197 -> 203;
	198 [label="啊。所以你不是自願被丟到過去的。",shape=box,color=red];
		198 -> 203;
	201 [label="我正試著幫你們所有人走完這個流程，但我上次把它搞砸了，搞得一蹋糊塗。我正在重試。可以說是「從頭來過」。",shape=box,color=red];
		201 -> 206;
	202 [label="我真的不知道該怎麼解釋。我也沒要求要有這種抹除你們記憶的能力，我只是在盡我所能地去駕馭它。",shape=box,color=red];
		202 -> 207;
	199 [label="不。我沒有。",shape=box,color=red];
		199 -> 204;
	200 [label="我得承認我……有答案。有。",shape=box,color=red];
		200 -> 205;
	203 [label="不。我絕對不是。現在，你必須了解 Orokin 一件事：我們經常——好吧，是曾經——互相玩遊戲。什麼類型的都玩。政治的、心理的、性方面的。都沒差。",shape=box,color=blue];
		203 -> 208;
	206 [label="+5 Chemistry",color=orange];
		206 -> 211;
	207 [label="那你可幹得真夠爛的，我這位老相好。你到底想圖什麼？你以前沒撈到的東西現在還想撈？",shape=box,color=blue];
		207 -> 212;
	204 [label="哈。現在我知道了，你這篡位者，不僅是個記憶竊賊，還是個騙子。",shape=box,color=blue];
		204 -> 209;
	205 [label="Update boolean RoatheKnowsReset",color=orange];
		205 -> 210;
	208 [label="靠著赤毒和承體廳堂，我們基本上就是永生的。你能不能理解，那種日子過久了，會變得多麼、多麼的困倦嗎？",shape=box,color=blue];
		208 -> 213;
		208 -> 214;
	211 [label="Update boolean RoatheResetScrewedUp",color=orange];
		211 -> 215;
