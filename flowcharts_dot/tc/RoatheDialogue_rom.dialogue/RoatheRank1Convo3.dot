	209 [label="Chat ends.",color=orange];
	210 [label="那你為什麼還要來問我這些你早就知道答案的問題？",shape=box,color=blue];
		210 -> 201;
		210 -> 202;
	213 [label="你信不信也好，這方面我可有經驗了。",shape=box,color=red];
		213 -> 219;
	214 [label="事實上，我理解。但請繼續。",shape=box,color=red];
		214 -> 220;
	215 [label="這個嘛，我就覺得有意思了……你是把和我之間的事「搞砸了」，還是把和里昂或瑪麗的事「搞砸了」？",shape=box,color=blue];
		215 -> 221;
		215 -> 222;
		215 -> 223;
	217 [label="呃，你看，你對於你為什麼喝血清這件事……有你自己的一整套說法，而我……我又總是在錯誤的時間點說了錯誤的話。",shape=box,color=red];
		217 -> 225;
	218 [label="我……我正試著贏得你們其中一個人的芳心，而我……真的……搞砸了……",shape=box,color=red];
		218 -> 226;
	216 [label="我正試著讓你和他們幫我讓 Loid 和樓上的家人團聚，但……我……辦不到……",shape=box,color=red];
		216 -> 224;
	219 [label="據我所知，你體驗過的無盡的死亡。這可有意思多了——但你最後，還是對這一切感到麻木了。",shape=box,color=blue];
		219 -> 220;
	220 [label="我想說的是——我早就習慣了。我們 Orokin 就是為了取樂而互耍的那些陰謀詭計。那不過是我們打發時間的方式罷了。",shape=box,color=blue];
		220 -> 227;
	221 [label="里昂……",shape=box,color=red];
		221 -> 228;
	222 [label="瑪麗……",shape=box,color=red];
		222 -> 229;
	223 [label="和你……",shape=box,color=red];
		223 -> 230;
	225 [label="+5 Chemistry",color=orange];
		225 -> 232;
	226 [label="+5 Chemistry",color=orange];
		226 -> 233;
	224 [label="呵，我懂了。咱倆說好的，結果你不知何故搞砸了。所以你的獎品就這麼沒了。",shape=box,color=blue];
		224 -> 231;
	227 [label="但是我們有我們不跨越的底線，也有我們永不採取的行動。我本可以細說，但我不想。我只簡單總結一句：阿爾布雷希特把所有規矩都打破了。",shape=box,color=blue];
		227 -> 234;
	228 [label="真的嗎？你試過一天餵他一次飯、澆一次水，看看這樣行不行？好吧……",shape=box,color=blue];
		228 -> 235;
	229 [label="你居然連那個純真的小可愛都搞不定？我……真心……希望我這位老相好，你以後千萬別去做什麼談判專家。",shape=box,color=blue];
		229 -> 236;
	230 [label="+5 Chemistry",color=orange];
		230 -> 237;
	232 [label="嗯。",shape=box,color=blue];
		232 -> 239;
	233 [label="哈！太有意思了！你現在成功引起我的注意了……是哪方面的？嗯？快說……別害羞。也許我們可以做個……約定。",shape=box,color=blue];
		233 -> 240;
		233 -> 241;
		233 -> 242;
	231 [label="我就坐在這裡，當我的懷疑被證實後，我立刻想到了兩件事：",shape=box,color=blue];
		231 -> 238;
	234 [label="他把我丟在那裡，丟在那個極其古老的年代，那個始源星系某個窮鄉僻壤裡！你知不知道那個被虛空詛咒的「大教堂」竟然連電力都還沒有？！電力！",shape=box,color=blue];
		234 -> 243;
	235 [label="他讓你很頭疼嗎？也許我們可以做個……約定？",shape=box,color=blue];
		235 -> 244;
	236 [label="告訴我，她到底哪裡讓你這麼煩惱？或許我們可以達成某種……約定？",shape=box,color=blue];
		236 -> 245;
	237 [label="哈！太有意思了！你現在成功引起我的注意了……哪方面的？嗯？快說… 別害羞。也許我們可以做個……約定。",shape=box,color=blue];
