digraph {
	186 [label="RoatheRank1Convo3 begins.",color=orange];
		186 -> 188;
		186 -> 187;
	188 [label="我能問一下嗎——你到底是怎麼回到這裡來的？準確地說… 你是什麼時候來的？",shape=box,color=red];
		188 -> 190;
	187 [label="[結束]",shape=box,color=red];
		187 -> 189;
