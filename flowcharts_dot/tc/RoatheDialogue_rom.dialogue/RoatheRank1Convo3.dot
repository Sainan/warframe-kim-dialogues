	262 [label="第二，我一想到我這顆腦袋最近居然被玩了兩次，我就暴怒了。不過，現在又冒出另一種情緒蓋過了這股火氣。一種我還搞不懂的怪感覺。",shape=box,color=blue];
		262 -> 271;
	267 [label="我不知道細節，因為他強加給我的那場改造，讓我的腦子裡有很多記憶都不見了。",shape=box,color=blue];
		267 -> 275;
	268 [label="對！一點都沒錯！用的還是我自己的血，一點不差！我告訴你，我絕對不是在我們離開那年才開始的！我對虛空發誓，我一看到他那張愚蠢又自以為是的臉，我就要用我的新長的利爪扒光他的皮——",shape=box,color=blue];
		268 -> 276;
	269 [label="我本來會建議你耐心點，但是… 既然你旁邊就已經放著一把雷射切割器，我總不能還建議你去用鑿子吧。",shape=box,color=blue];
		269 -> 277;
	270 [label="+5 Chemistry",color=orange];
		270 -> 278;
	5737 [label="Second, I am struck by the immediate fury and anger at knowing that my mind has been trifled with not once but twice in recent history. But there is another emotion that comes to defeat the anger. One I do not quite yet understand.",shape=box,color=blue];
		5737 -> 5740;
	272 [label="第一：我真佩服你！你刪光我們所有人的記憶，就是為了能再試一次，贏得他的愛？！",shape=box,color=blue];
		272 -> 280;
	273 [label="第一：我真佩服你！你刪光我們所有人的記憶，就是為了能再試一次，贏得她的愛？！",shape=box,color=blue];
		273 -> 281;
	274 [label="喔，這可真是太神奇了！你刪光我們所有人的記憶，就是為了能再試一次，來贏得我的愛？！",shape=box,color=blue];
		274 -> 282;
	271 [label="背叛。",shape=box,color=blue];
		271 -> 279;
	275 [label="但我會閃過一些畫面。一條黃金走廊的零碎片段。 一把我認得的聲音——但不是那張臉。 是阿爾布雷希特，但不是我認識的那個。",shape=box,color=blue];
		275 -> 283;
	276 [label="容我花點時間來控制一下我的情緒。",shape=box,color=blue];
		276 -> 284;
	277 [label="我就坐在這裡，當我的懷疑被證實後，我立刻想到了兩件事：",shape=box,color=blue];
		277 -> 285;
	278 [label="哼。我懂了。老實說，這目標還挺高尚的。這事我自己也試過很多、很多次了。而且每一次都敗得同樣徹底。",shape=box,color=blue];
		278 -> 286;
	5740 [label="Betrayal.",shape=box,color=blue];
		5740 -> 5741;
	280 [label="你可真夠 Orokin 的。",shape=box,color=blue];
		280 -> 288;
