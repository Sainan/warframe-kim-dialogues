		281 -> 289;
	282 [label="你可真夠 Orokin 的。",shape=box,color=blue];
		282 -> 290;
	279 [label="為什麼？",shape=box,color=blue];
		279 -> 287;
	283 [label="灼燒之痛，撕心裂肺。我以前從來沒有經歷過。漂泊者，我以前在戰場上被炸斷過手腳。我也曾被燒得體無完膚，要不是赤毒，我根本活不下來。我懂什麼叫痛苦。",shape=box,color=blue];
		283 -> 291;
	284 [label="謝謝。我們可以繼續。",shape=box,color=blue];
		284 -> 292;
	285 [label="我在想……如果我有那種能力，我會把多少場戰役徹底抹掉，然後再重打一遍？",shape=box,color=blue];
		285 -> 293;
	286 [label="我就坐在這裡，當我的懷疑被證實後，我立刻想到了兩件事：",shape=box,color=blue];
		286 -> 294;
	5741 [label="Why?",shape=box,color=blue];
		5741 -> 5742;
	288 [label="第二：你到底是有多無能啊？！我敢肯定，你要是試著一天餵那個教士一次飯、一次水，他早就對你愛戴得死心塌地了！",shape=box,color=blue];
		288 -> 296;
	289 [label="第二：你試過在她面前裝瘸嗎？假裝生病呢？拋媚眼呢？還是就跟她說她今天很好看？她看起來也不難追啊。",shape=box,color=blue];
		289 -> 297;
	290 [label="我就坐在這裡，當我的懷疑被證實後，我立刻想到了兩件事：",shape=box,color=blue];
		290 -> 298;
	287 [label="不過那是以後再說的事。我對你有個提議。我相信你會對這個更感興趣。",shape=box,color=blue];
		287 -> 295;
	291 [label="我的身體被撕裂，然後被強行改造。這不是我選的。我不知道其他人是不是也一樣。",shape=box,color=blue];
		291 -> 299;
	292 [label="我用我自己的血當樣本，透過反覆試驗，逆向工程出一個 Helminth。這可不容易，尤其是在沒有任何 Orokin 設備的情況下。事實上，是沒有任何設備，除了那些我偷來的，就從……",shape=box,color=blue];
		292 -> 300;
	293 [label="如果當初是我掌握了你的能力，你猜我會玷污多少人的心智？",shape=box,color=blue];
		293 -> 301;
	294 [label="我在想……如果我有那種能力，我會把多少場戰役徹底抹掉，然後再重打一遍？",shape=box,color=blue];
		294 -> 302;
	5742 [label="But that is a conversation for another day. For I have a proposal for you. One I believe you will be far more interested in.",shape=box,color=blue];
		5742 -> 5739;
	296 [label="別誤會！我只是對你如此狡猾感到印象深刻。",shape=box,color=blue];
		296 -> 304;
	297 [label="第三：我坐在這裡，當我的懷疑被證實後，我突然被強烈的感悟淹沒了：",shape=box,color=blue];
		297 -> 305;
	298 [label="我在想……如果我有那種能力，我會把多少場戰役徹底抹掉，然後再重打一遍？",shape=box,color=blue];
		298 -> 306;
	295 [label="我會在你面前，在那兩個狂熱分子面前，假裝什麼都不知道……",shape=box,color=blue];
		295 -> 303;
	299 [label="我記得我身下冰冷的樓梯，當時我被丟在了上面。 里昂和瑪麗跟我說了他們的記憶，我現在才知道那是大教堂的樓梯。",shape=box,color=blue];
		299 -> 307;
	300 [label="我才不會施捨他們管那叫什麼「簡陋」醫院。阿爾布雷希特用 Helminth 把我們送到過去。我不知道那東西是怎麼在過去長成的，因為它必須先在那裡，我們才能抵達。它在過程中枯萎死掉了——我懷疑可以用另一個返回。",shape=box,color=blue];
		300 -> 308;
