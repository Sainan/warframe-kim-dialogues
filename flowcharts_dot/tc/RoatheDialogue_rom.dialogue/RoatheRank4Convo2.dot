	j1413506821 [label="你有能力，你也有實力，你已經充分表明了你對現狀的不滿。",shape=box,color=red];
		j1413506821 -> j1983023564;
	j2520911778 [label="我實在不明白，為什麼「Tau 之惡魔」甘願待在墓穴裡無所事事。即便有了我們的協議。",shape=box,color=red];
		j2520911778 -> j2206556128;
	j77595897 [label="你是 Orokin。你顯然憎恨周圍的每一個人。是什麼妨礙了你？",shape=box,color=red];
		j77595897 -> j644912490;
	j1073632153 [label="我實在不明白，為什麼「Tau 之惡魔」甘願待在墓穴裡無所事事。尤其是在我們之間沒有任何協議的情況下。",shape=box,color=red];
		j1073632153 -> j3657429577;
	j1983023564 [label="+5 Chemistry",color=orange];
		j1983023564 -> j2244225573;
	j2206556128 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2206556128 -> j1721477874 [label=true,color=green];
		j2206556128 -> j543227264 [label=false,color=brown];
	j644912490 [label="請容許我花點時間整理思緒，然後再開始這段充滿憤怒與怨恨的對話。",shape=box,color=blue];
		j644912490 -> j2091907727;
	j3657429577 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3657429577 -> j1721477874 [label=true,color=green];
		j3657429577 -> j836183841 [label=false,color=brown];
	j2244225573 [label="我很高興你意識到，我完全有能力輕易地把這裡變成屠宰場。",shape=box,color=blue];
		j2244225573 -> j720685440;
	j1721477874 [label="因為我至今仍不明白，我為何會如此信任你，告訴你那麼多事，而你卻背叛了我的信任，篡位者。",shape=box,color=blue];
		j1721477874 -> j3532105811;
	j543227264 [label="我還有工作要做，篡位者。如果我把附近所有人都殺光，你又怎麼能幫我恢復所有記憶呢？",shape=box,color=blue];
		j543227264 -> j2306254636;
	j2091907727 [label="我努力克制自己，不想立刻證明你的觀點是對的。",shape=box,color=blue];
		j2091907727 -> j26232799;
	j836183841 [label="或許我是希望你會醒悟過來，改變主意。但如果我已經把附近所有人都屠殺殆盡，這種可能性就會大大降低，不是嗎？",shape=box,color=blue];
		j836183841 -> j2306254636;
	j720685440 [label="但這樣做也於事無補，不是嗎？如果說戰爭教會了我們什麼，那就是殺戮最終帶來的結果少得驚人。",shape=box,color=blue];
		j720685440 -> j3470215358;
	j3532105811 [label="如果我把附近所有人都屠殺殆盡，那麼成功的幾率就會急劇下降，不是嗎？戰爭教會我們的一件事就是，殺戮最終帶來的結果少得驚人。",shape=box,color=blue];
		j3532105811 -> j2379251470;
	j2306254636 [label="另外，這樣做也於事無補，不是嗎？如果說戰爭教會了我們什麼，那就是殺戮最終帶來的結果少得驚人。",shape=box,color=blue];
		j2306254636 -> j2379251470;
	j26232799 [label="我理解你對 Orokin 的憎恨。相信我，大多數 Orokin 人都鄙視自己。我並非不了解我們所犯下的罪行，種種我們犯下的暴行。 ",shape=box,color=blue];
		j26232799 -> j3423781523;
	j3470215358 [label="儘管偶爾滿足一下這種小慾望，感覺會很不錯。",shape=box,color=blue];
		j3470215358 -> j1328814545;
		j3470215358 -> j4042281045;
		j3470215358 -> j1981848690;
	j2379251470 [label="儘管偶爾滿足一下這種小慾望，感覺會很不錯。",shape=box,color=blue];
		j2379251470 -> j1981848690;
		j2379251470 -> j4042281045;
		j2379251470 -> j1328814545;
	j3423781523 [label="光是那個承體廳堂就足以成為應將我們的社會付之一炬的理由了。但你卻用一概而論的方式，譴責了一整個民族——順便一提，篡位者，你就是這個民族的產物！",shape=box,color=blue];
		j3423781523 -> j3747057006;
	j1328814545 [label="所以，你放過所有人的唯一原因就是因為殺了他們毫無意義？",shape=box,color=red];
		j1328814545 -> j2325352691;
	j4042281045 [label="除此之外你沒有其它讓所有人都活下來理由嗎？",shape=box,color=red];
		j4042281045 -> j3129709428;
	j1981848690 [label="連瑪麗和里昂也算嗎？",shape=box,color=red];
		j1981848690 -> j1512282887;
	j3747057006 [label="你對那些曾在金碧輝煌的建築內辛勤工作、最終逝去的善良靈魂一無所知。那些關於他們的傳奇故事，如今已湮沒在歷史長河中。",shape=box,color=blue];
		j3747057006 -> j3613220325;
	j2325352691 [label="殺了他們毫無意義，不是嗎？你是想說服我改變想法嗎？篡位者，我真佩服你──我萬萬沒想到你竟然是這麼陰險狡詐的傢伙！",shape=box,color=blue];
		j2325352691 -> j2134639538;
		j2325352691 -> j1190694964;
	j3129709428 [label="篡位者，如果你想故弄玄虛地暗示什麼，那不如直接說出來吧。",shape=box,color=blue];
		j3129709428 -> j2134639538;
		j3129709428 -> j1190694964;
	j1512282887 [label="我相當確定，如果你來到墓穴，發現狂熱分子站過的地方只剩下兩灘血跡，你一定會對我大發雷霆，不是嗎？",shape=box,color=blue];
		j1512282887 -> j1616057786;
	j3613220325 [label="那些因無人知曉的悲劇而流下的淚早已成河一去不返，而這僅僅因為你對此一無所知。",shape=box,color=blue];
		j3613220325 -> j1407887179;
	j2134639538 [label="承認自己享受與人相處的時光並沒有錯。人存在的意義遠不止於提供實用價值。",shape=box,color=red];
		j2134639538 -> j796436421;
	j1190694964 [label="承認我們是在排解寂寞也沒有關係，就算我們確實惹惱你。",shape=box,color=red];
		j1190694964 -> j134072315;
	j1616057786 [label="可能是你，也可能是管家，或者是那個 Tenno，又或者是 Tenno 那位可怕的「母親」。唉，那個人。那個人讓我很困擾。以後再說吧。",shape=box,color=blue];
		j1616057786 -> j1190694964;
		j1616057786 -> j2134639538;
	j1407887179 [label="我聽到你的孩子一遍遍地哭喊著亞迪的名字。 ",shape=box,color=blue];
		j1407887179 -> j1717344173;
	j796436421 [label="Add 1 to Thermostat counter",color=orange];
		j796436421 -> j3607629830;
	j134072315 [label="Add -1 to Thermostat counter",color=orange];
		j134072315 -> j36104292;
	j1717344173 [label="亞迪只是千百萬人的其中之一。",shape=box,color=blue];
		j1717344173 -> j1456583489;
	j3607629830 [label="Evaluate expressions",color=orange];
		j3607629830 -> j4098651718 [label="RoatheUnloved2",color=purple];
		j3607629830 -> j4098651718 [label="RoatheUnloved1",color=purple];
		j3607629830 -> j4098651718 [label="RoatheAlone1",color=purple];
		j3607629830 -> j4098651718 [label="RoatheBirdThree",color=purple];
		j3607629830 -> j138261928 [label="false",color=purple];
	j36104292 [label="Evaluate expressions",color=orange];
		j36104292 -> j4227798748 [label="RoatheUnloved2",color=purple];
		j36104292 -> j4227798748 [label="RoatheUnloved1",color=purple];
		j36104292 -> j4227798748 [label="RoatheAlone1",color=purple];
		j36104292 -> j4227798748 [label="RoatheBirdThree",color=purple];
		j36104292 -> j1649727132 [label="false",color=purple];
	j1456583489 [label="他們的名字對你來說是獨一無二的。",shape=box,color=blue];
		j1456583489 -> j1070802483;
	j4098651718 [label="別得寸進尺，篡位者。 「享受」有點誇張了。更確切地說，你越來越讓我反感了。就像黴菌一樣。",shape=box,color=blue];
		j4098651718 -> j1328807703;
	j138261928 [label="「享受」？這就是所謂的享受嗎？我從不知道我竟然是個受虐狂。嗯。又或者，這只是我的身體正在腐爛，以及你們所有人「漸漸融入我的生活」的感覺？",shape=box,color=blue];
		j138261928 -> j2624443422;
	j4227798748 [label="有人可以聊天還挺讓人享受的。即使你們有時候確實像你們說的那樣，挺惹惱的。",shape=box,color=blue];
		j4227798748 -> j27012317;
	j1649727132 [label="寂寞？呸。你們唯一阻止的，就是我生活中那一點點正在恢復的理智。如果你想暗示你們這群人「越來越讓我喜歡」，你知道還有什麼才能做到這一點嗎？",shape=box,color=blue];
		j1649727132 -> j1754721472;
	j1070802483 [label="但對於星辰來說不是。",shape=box,color=blue];
		j1070802483 -> j601936457;
	j1328807703 [label="+5 Chemistry",color=orange];
		j1328807703 -> j689414758;
	j2624443422 [label="像黴菌一樣。",shape=box,color=blue];
		j2624443422 -> j689414758;
	j27012317 [label="+5 Chemistry",color=orange];
		j27012317 -> j2555388106;
	j1754721472 [label="黴菌。",shape=box,color=blue];
		j1754721472 -> j689414758;
	j601936457 [label="隨你便，就儘管將我們族人染成血紅吧。熔掉 Orokin 的黃金，稱我們為怪物。我們活該承受你為我們準備的每一分惡毒詛咒。",shape=box,color=blue];
		j601936457 -> j488947030;
	j689414758 [label="Boolean RoatheAlone2 is now true.",color=orange];
		j689414758 -> j1654361623;
	j2555388106 [label="我得承認，你已經在我身上扎根了。像黴菌一樣。",shape=box,color=blue];
		j2555388106 -> j689414758;
	j488947030 [label="但千萬不要以為這就是我們全部的能力。",shape=box,color=blue];
		j488947030 -> j803387021;
	j1654361623 [label="Check boolean LoidFamilyComplete",color=orange];
		j1654361623 -> j1933300832 [label=true,color=green];
		j1654361623 -> j1289489066 [label=false,color=brown];
	j803387021 [label="如果你想徹底消滅所有 Orokin？那就走上樓梯。你會看到一些倖存的 Orokin 人，他們逃不出你的魔爪。就從「祖母」開始吧。",shape=box,color=blue];
		j803387021 -> j599624728;
	j1933300832 [label="+10 Chemistry",color=orange];
		j1933300832 -> "Chat ends.";
	j1289489066 [label="篡位者，我之所以沒有進行一場瘋狂、嗜血、駭人的暴行，還有另一個原因。",shape=box,color=blue];
		j1289489066 -> j2254526611;
	j599624728 [label="畢竟，她是見過我們這種人最多的一個了。",shape=box,color=blue];
		j599624728 -> j155006797;
	j2254526611 [label="我還沒看到我們那位親愛的管家和阿爾布雷希特樓上那幾個疏遠的家人之間的小戲碼如何收場。",shape=box,color=blue];
		j2254526611 -> j197245306;
	j155006797 [label="Boolean RoatheNoDate is now true.",color=orange];
		j155006797 -> "Chat ends.";
	j197245306 [label="別忘了，這一切我有我的私人目的，不管我們有沒有達成協議。我想確保阿爾布雷希特踏進這個聖堂時，看到的第一張臉是……",shape=box,color=blue];
		j197245306 -> j2346222560;
	j2346222560 [label="我。",shape=box,color=blue];
		j2346222560 -> j3411235599;
	j3411235599 [label="我只是還無法決定，等他回來時，我是不是該讓他被他所愛之人的屍體圍繞。",shape=box,color=blue];
		j3411235599 -> j3453024495;
	j3453024495 [label="很難選擇啊……",shape=box,color=blue];
		j3453024495 -> j1933300832;
}