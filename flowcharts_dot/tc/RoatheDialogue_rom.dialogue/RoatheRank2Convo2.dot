		j2868117985 -> j539306627 [label=false,color=brown];
		j2868117985 -> j3872471016 [label=false,color=brown];
	j4160145353 [label="你之前提過自己「搞砸了」，或者說與那兩個狂熱分子之間的事糾纏得太深，已無法理清。所以你真的、真心地認為，這是你眼前最好的選擇嗎？",shape=box,color=blue];
		j4160145353 -> j4277841122;
		j4160145353 -> j4051985391;
		j4160145353 -> j1671466525;
		j4160145353 -> j1823851308;
	j1823851308 [label="我不知道還能怎麼辦。我沒有別的選擇。",shape=box,color=red];
		j1823851308 -> j3772047713;
	j1671466525 [label="是我。沒想到你會……變成這種狀態，記憶殘缺不全。我很抱歉。",shape=box,color=red];
		j1671466525 -> j3852459793;
	j4277841122 [label="羅瑟，老實說？我……從沒想過自己能做到的這件事竟然真的會有意義。",shape=box,color=red];
		j4277841122 -> j3065811135;
	j3709392100 [label="我 只是好奇想看看會發生什麼。",shape=box,color=red];
		j3709392100 -> j2704759553;
	j2248527490 [label="到底發生了什麼，讓事情有了這麼天翻地覆的變化？",shape=box,color=red];
		j2248527490 -> j1472815285;
	j3913640726 [label="人是改變不了多少的。他骨子裡一直都幹得出那種事。",shape=box,color=red];
		j3913640726 -> j1689432231;
	j263915390 [label="你之前提過我們之間「搞砸了」，或者說與那兩個狂熱分子之間的事糾纏得太深，已無法理清。所以你真的、真心地認為，這是你眼前最好的選擇嗎？",shape=box,color=blue];
