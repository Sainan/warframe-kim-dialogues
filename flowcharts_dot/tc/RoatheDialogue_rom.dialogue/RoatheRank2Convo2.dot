	j3772047713 [label="Evaluate expressions on HellStory counter",color=orange];
		j3772047713 -> j1362446653 [label="x >= 21",color=purple];
		j3772047713 -> j3487142460 [label="x < 21",color=purple];
		j3772047713 -> j3487142460 [label="false",color=purple];
	j3852459793 [label="嗯，沒錯。不過你大概從未應付過像我這樣記憶……支離破碎的原型 Warframe 吧。就這點來說，我猜我有那麼一點點同情你了。",shape=box,color=blue];
		j3852459793 -> j3191424586;
	j3065811135 [label="啊，原來如此……你習慣了去做這種完全不用負責任的事。不過，你大概沒遇過另一個記憶像我這樣……支離破碎的原型 Warframe。",shape=box,color=blue];
		j3065811135 -> j3191424586;
	j2704759553 [label="啊，所以你也是 Orokin 帝國的人。太棒了。",shape=box,color=blue];
		j2704759553 -> j3191424586;
	j1472815285 [label="Add 1 to Thermostat counter",color=orange];
		j1472815285 -> j41821828;
