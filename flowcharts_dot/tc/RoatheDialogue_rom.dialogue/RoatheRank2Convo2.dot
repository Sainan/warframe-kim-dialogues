		j1689432231 -> j2294612155;
	j2526722761 [label="我 只是好奇想看看會發生什麼。",shape=box,color=red];
		j2526722761 -> j1775940249;
	j1646847578 [label="Evaluate expressions on HellStory counter",color=orange];
		j1646847578 -> j1749415458 [label="x >= 21",color=purple];
		j1646847578 -> j2418577563 [label="x < 21",color=purple];
		j1646847578 -> j2418577563 [label="false",color=purple];
	j1622904867 [label="啊，所以你也是 Orokin 帝國的人。太棒了。要說你是為了「愛」才這麼做……我可不信。",shape=box,color=blue];
		j1622904867 -> j2297067398;
	j936564741 [label="啊，原來如此……你習慣了去做這種完全不用負責任的事。不過，你大概沒遇過另一個記憶像我這樣……支離破碎的原型 Warframe。從這個角度來說，我大概可以稍微理解你。而這一切，都打著「愛」的旗號。",shape=box,color=blue];
		j936564741 -> j1707413934;
	j2590006219 [label="嗯，沒錯。不過你大概從未應付過像我這樣記憶……支離破碎的原型 Warframe 吧。就這點來說，我猜我有那麼一點點同情你了。而這一切，都打著「愛」的旗號。",shape=box,color=blue];
		j2590006219 -> j1707413934;
	j3401771544 [label="所以，篡位者，我總算懂了，你一開始是怎麼搞砸的。",shape=box,color=blue];
		j3401771544 -> j3191424586;
	j1362446653 [label="+5 Chemistry",color=orange];
		j1362446653 -> j3022086744;
	j3487142460 [label="+5 Chemistry",color=orange];
		j3487142460 -> j479274492;
	j3191424586 [label="我本該責備你為了達成目的所做的一切，但一想到 Orokin 人曾經幹過更糟的甚至那些更有創意的事，我就不免啞然了。",shape=box,color=blue];
		j3191424586 -> j1186946924;
	j41821828 [label="當然，是你。或者更確切地說，是那些孩子們。Tenno。有時我會想，那一切是否早已註定，抑或他其實還有改變命運的機會。",shape=box,color=blue];
		j41821828 -> j1484840411;
	j2294612155 [label="也許你是對的。又或者，我們終究都只是未琢的原石。各自帶著裂紋與瑕疵，斑駁而成其形。",shape=box,color=blue];
		j2294612155 -> j2198995253;
	j1775940249 [label="所以，篡位者，我總算懂了，你一開始是怎麼搞砸的。我可不信你是為了什麼「愛」才幹出這種事的。",shape=box,color=blue];
		j1775940249 -> j2297067398;
	j1749415458 [label="+5 Chemistry",color=orange];
		j1749415458 -> j4087700991;
	j2418577563 [label="+5 Chemistry",color=orange];
		j2418577563 -> j717570080;
	j2297067398 [label="但我想，Orokin 人表達情感的方式一直都很奇怪。",shape=box,color=blue];
		j2297067398 -> j1186946924;
	j1707413934 [label="我本該責備你以「愛」之名所做的一切，但一想到 Orokin 人曾經幹過更糟的甚至那些更有創意的事，我就不免啞然了。",shape=box,color=blue];
		j1707413934 -> j1186946924;
	j3022086744 [label="若是我，我會勸人安靜地與自己的錯誤共處，坦然面對失敗。但是，那樣豈不讓我成了個不折不扣的偽君子，不是嗎？",shape=box,color=blue];
		j3022086744 -> j3167677053;
	j479274492 [label="若是我，我會勸人安靜地與自己的錯誤共處，坦然面對失敗。可惜我並沒有那種虛空賜予的本事能重繞時間、抹去記憶。",shape=box,color=blue];
		j479274492 -> j742340193;
	j1186946924 [label="我跟你說過 Ballas 和 Margulis 的故事嗎？我只能指望你對我說實話了，因為我絕對沒辦法知道真相。",shape=box,color=blue];
		j1186946924 -> j1956724196;
	j1484840411 [label="我更傾向於相信我們終究都只是未琢的原石。各自帶著裂紋與瑕疵，斑駁而成其形。",shape=box,color=blue];
		j1484840411 -> j2198995253;
	j2198995253 [label="而我們也許會被琢磨成不同的樣子，或為了捕捉光線，鑲嵌進精緻的藝術品；或被磨成武器的刃鋒你，又或……化為塵埃碎裂殆盡。",shape=box,color=blue];
		j2198995253 -> j925250985;
	j4087700991 [label="若是我，我會勸人安靜地與自己的錯誤共處，坦然面對失敗。但是，那樣豈不讓我成了個不折不扣的偽君子，不是嗎？",shape=box,color=blue];
		j4087700991 -> j758596884;
	j717570080 [label="若是我，我會勸人安靜地與自己的錯誤共處，坦然面對失敗。可惜我並沒有那種虛空賜予的本事能重繞時間、抹去記憶。",shape=box,color=blue];
		j717570080 -> j790546031;
	j3167677053 [label="而且，誰能說我就不會好好利用這個虛空賜予的循環時間和抹除記憶的能力呢？",shape=box,color=blue];
		j3167677053 -> j742340193;
	j742340193 [label="話說回來，這到底……是怎麼運作的？",shape=box,color=blue];
		j742340193 -> j2054994755;
		j742340193 -> j4215587613;
		j742340193 -> j1350559949;
	j1956724196 [label="我多麼憎惡這一點，讓我告訴你。",shape=box,color=blue];
		j1956724196 -> j3104978299;
		j1956724196 -> j3896961100;
		j1956724196 -> j2201622172;
		j1956724196 -> j3919468931;
	j925250985 [label="也許那是個天真的想法，而我們確實都一成不變。你應該比我更清楚這一點，至少我是這樣聽說的。",shape=box,color=blue];
		j925250985 -> j3822415044;
	j758596884 [label="而且，誰能說我就不會好好利用這個虛空賜予的循環時間和抹除記憶的能力呢？",shape=box,color=blue];
		j758596884 -> j790546031;
	j790546031 [label="話說回來，這到底……是怎麼運作的？",shape=box,color=blue];
		j790546031 -> j1057998598;
		j790546031 -> j960713211;
		j790546031 -> j1350559949;
	j2054994755 [label="你現在是 Infested。而且你和用來製造所有原型 Warframe 的血清的 Infested 菌株都有聯繫。",shape=box,color=red];
		j2054994755 -> j2188511809;
	j4215587613 [label="一把會說話的吉他欠我幾個人情。",shape=box,color=red];
		j4215587613 -> j1654903319;
	j3104978299 [label="我聽說過了。",shape=box,color=red];
		j3104978299 -> j2180977163;
	j3896961100 [label="我聽說過了，但請，繼續說。",shape=box,color=red];
		j3896961100 -> j1858937199;
	j2201622172 [label="其實，我還沒聽過。",shape=box,color=red];
		j2201622172 -> j3128915060;
	j3919468931 [label="不，我沒聽過這個故事。這……其實也是我們會在這裡的原因之一。我知道我第一次時錯過了這些機會。",shape=box,color=red];
		j3919468931 -> j1508641704;
	j3822415044 [label="但是你讓我把順序講得顛三倒四了。容我好好地重新開始。",shape=box,color=blue];
		j3822415044 -> j2813428231;
	j1057998598 [label="你現在是 Infested。而且你和用來製造所有原型 Warframe 的血清的 Infested 菌株都有聯繫。",shape=box,color=red];
		j1057998598 -> j1342744491;
	j960713211 [label="一把會說話的吉他欠我幾個人情。",shape=box,color=red];
		j960713211 -> j2555166904;
	j2188511809 [label="據我所知——雖然她的話並不完全可信，聽聽就好——每一批原型 Warframe 所使用的菌株，其實都能被分開調整。",shape=box,color=red];
		j2188511809 -> j2028630607;
	j1654903319 [label="我……明白了。",shape=box,color=blue];
		j1654903319 -> j632780050;
	j2180977163 [label="+10 Chemistry",color=orange];
		j2180977163 -> j3463073250;
	j1858937199 [label="要嘛你是在刻意奉承我，這點我還得誇你一句；要嘛就是你今天實在乏味透頂。不過，作為一個人生歷經無數輪迴的人，我幾乎能理解那種倦怠。",shape=box,color=blue];
		j1858937199 -> j3589430171;
	j3128915060 [label="有趣。要不是你在說謊，就是我身上還有些秘密你還沒挖出來。這也許就是你為什麼又跑來這裡，把犁過的田再犁一遍的理由吧。",shape=box,color=blue];
		j3128915060 -> j3657397179;
	j1508641704 [label="嗯，一筆一劃，你快要說服我原諒你搞出來的這團爛攤子了。",shape=box,color=blue];
		j1508641704 -> j3059117681;
	j2813428231 [label="早在扎日曼 10-0 號啟程前，在 Tenno 還只是無名小卒的時候，哲士 Margulis 和 Ballas 就在一個新建的穹頂園林開幕式上遇見了。",shape=box,color=blue];
		j2813428231 -> j1921666497;
	j1342744491 [label="據我所知——雖然她的話並不完全可信，聽聽就好——每一批原型 Warframe 所使用的菌株，其實都能被分開調整。",shape=box,color=red];
		j1342744491 -> j573800658;
	j2555166904 [label="我……知道了。",shape=box,color=blue];
		j2555166904 -> j285766487;
	j2028630607 [label="每一種菌株似乎都活在自己獨立的時間線裡。它們彼此相連，卻又各自存在於某種……節點之中。一切都極其複雜。",shape=box,color=red];
		j2028630607 -> j3828042168;
	j632780050 [label="自從我離開之後，這個宇宙顯然變得更奇怪了……",shape=box,color=blue];
		j632780050 -> j144059189;
		j632780050 -> j1307647774;
	j3463073250 [label="那我就不重提那些老故事來煩你了，就讓你在今天剩下的時間裡去找別的樂子吧。",shape=box,color=blue];
		j3463073250 -> j2888030837;
	j3589430171 [label="說得好像我就不是你的樂子一樣。",shape=box,color=blue];
		j3589430171 -> j3657397179;
	j3657397179 [label="但是？不管怎樣……",shape=box,color=blue];
		j3657397179 -> j4022560949;
	j3059117681 [label="Boolean RoatheResetForgiven is now true.",color=orange];
		j3059117681 -> j3657397179;
	j1921666497 [label="Ballas 去那裡只是為了走個過場——你知道的，我們最愛搞這些排場了——而 Margulis 當時正死命地不想被任何人注意到。",shape=box,color=blue];
		j1921666497 -> j3045021790;
	j573800658 [label="每一種菌株似乎都活在自己獨立的時間線裡。它們彼此相連，卻又各自存在於某種……節點之中。一切都極其複雜。",shape=box,color=red];
		j573800658 -> j1618329351;
	j285766487 [label="自從我離開之後，這個宇宙顯然變得更奇怪了……",shape=box,color=blue];
		j285766487 -> j1183336326;
		j285766487 -> j3595275367;
	j3828042168 [label="既然我能讓時間循環，我就能在一定程度上循環感染的「批次」。",shape=box,color=red];
		j3828042168 -> j3166757845;
	j144059189 [label="你根本無法想像。",shape=box,color=red];
		j144059189 -> j3191424586;
	j1307647774 [label="她才是真正的佼佼者。好吧……算了。",shape=box,color=red];
		j1307647774 -> j3191424586;
	j2888030837 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j2888030837 -> "Chat ends.";
	j4022560949 [label="Ballas 和 Margulis。",shape=box,color=blue];
		j4022560949 -> j2813428231;
	j3045021790 [label="你 必須明白一件事，我親愛的篡位者。Ballas 根本沒有理由和她交往。完全沒有理由。除非……他的迷戀是真的。",shape=box,color=blue];
		j3045021790 -> j562339068;
	j1618329351 [label="既然我能讓時間循環，我就能在一定程度上循環感染的「批次」。",shape=box,color=red];
		j1618329351 -> j717604738;
	j1183336326 [label="你根本無法想像。",shape=box,color=red];
		j1183336326 -> j2124494666;
	j3595275367 [label="她才是真正的佼佼者。好吧……算了。",shape=box,color=red];
		j3595275367 -> j2124494666;
	j3166757845 [label="「她」是誰？",shape=box,color=blue];
		j3166757845 -> j3931401104;
		j3166757845 -> j2376683641;
	j562339068 [label="那不僅僅是慾望。因為他想要誰他就能得到誰——而且他經常這麼幹。如果他只是想要她，他大可占有她，然後甩了她。",shape=box,color=blue];
		j562339068 -> j2243985294;
	j717604738 [label="「她」是誰？",shape=box,color=blue];
		j717604738 -> j4027122872;
		j717604738 -> j2481396138;
	j2124494666 [label="不管怎樣，這一切，都打著「愛」的旗號？",shape=box,color=blue];
		j2124494666 -> j1707413934;
	j3931401104 [label="莉慈，她會喜歡你的。",shape=box,color=red];
		j3931401104 -> j1654903319;
	j2376683641 [label="一把會說話的吉他。",shape=box,color=red];
		j2376683641 -> j1654903319;
	j2243985294 [label="他可是執行者。是七人眾裡最有權勢的一位。他只要召她上床，她便會毫不遲疑地出現在他的寢殿。",shape=box,color=blue];
		j2243985294 -> j1726163011;
	j4027122872 [label="莉慈，她會喜歡你的。",shape=box,color=red];
		j4027122872 -> j2555166904;
	j2481396138 [label="一把會說話的吉他。",shape=box,color=red];
		j2481396138 -> j2555166904;
	j1726163011 [label="但他沒有那麼做。漂泊者，那一夜他只看了她一眼——便徹底淪陷了。他整個人都亂了方寸。",shape=box,color=blue];
		j1726163011 -> j808735642;
	j808735642 [label="我從沒見過那樣的場面。就好像整個房間裡除了 Margulis 之外，根本沒有其他人存在。他甚至……害羞到不敢跟她說話。他可是 Ballas！Ballas 啊！",shape=box,color=blue];
		j808735642 -> j2766649762;
		j808735642 -> j553763255;
	j2766649762 [label="真的嗎？",shape=box,color=red];
		j2766649762 -> j2109688509;
	j553763255 [label="你在編故事。",shape=box,color=red];
		j553763255 -> j3081853746;
	j2109688509 [label="我用我僅存的榮譽發誓，我沒有！而且我有什麼理由要撒謊？我到底幹嘛要在乎你對他們關係的看法？",shape=box,color=blue];
		j2109688509 -> j2589196157;
	j3081853746 [label="我用我僅存的榮譽發誓！而且我有什麼理由要撒謊？我到底幹嘛要在乎你對他們關係的看法？",shape=box,color=blue];
		j3081853746 -> j2589196157;
	j2589196157 [label="我只是覺得很可悲而已。你們這些人總喜歡把事情簡單化。這件事，可遠比你們想像的要複雜得多。",shape=box,color=blue];
		j2589196157 -> j4036858367;
	j4036858367 [label="無論你相信與否也好，他們確實彼此相愛。Ballas 違背了所有階級規則和傳統，就為了迎娶一位哲士成為他的愛人——而且是唯一的浪漫伴侶。",shape=box,color=blue];
		j4036858367 -> j1957758370;
	j1957758370 [label="只有真愛才能讓一個男人如此瘋狂，尤其是在一切都大錯特錯之時……",shape=box,color=blue];
		j1957758370 -> j2089586798;
		j1957758370 -> j9189459;
	j2089586798 [label="你是怎麼得出這個結論的？他難道不該為她的死負責嗎？",shape=box,color=red];
		j2089586798 -> j302327792;
	j9189459 [label="是 Ballas 下令處決她的。",shape=box,color=red];
		j9189459 -> j302327792;
	j302327792 [label="首先，讓我們先假設你說的一切全都正確。假設他幹那事純粹是自願的。然後我們再假設這背後沒有任何政治花樣、勒索或黑幕逼他迫使他採取這種行動。",shape=box,color=blue];
		j302327792 -> j2982846113;
	j2982846113 [label="就算真是那樣，就算 Ballas 是在完全沒有受到任何影響的情況下，下令處決她。你也該考慮到那時早就來不及了。他感受到的背叛早就讓他痛苦不堪。",shape=box,color=blue];
		j2982846113 -> j2141213519;
	j2141213519 [label="他的心智和他的理智早已破碎。",shape=box,color=blue];
		j2141213519 -> j3881586629;
		j2141213519 -> j1408283171;
	j3881586629 [label="如果你是想讓我同情他的話，我可不會。",shape=box,color=red];
		j3881586629 -> j879662986;
	j1408283171 [label="是因為 Tenno？還是因為他們對她所做的一切？",shape=box,color=red];
		j1408283171 -> j1672242220;
	j879662986 [label="我可沒要求你去同情 他！Ballas 只配往他墳頭上撒尿——如果他真有墳墓的話。",shape=box,color=blue];
		j879662986 -> j1257368288;
	j1672242220 [label="在某種程度上，兩者都是。但又在某種程度上，兩者都不是。在他下令處決她的那天，他就已經瘋了。事實上，我甚至懷疑他的某部分根本不記得自己幹過這事。",shape=box,color=blue];
		j1672242220 -> j1982685745;
	j1257368288 [label="我只是在陳述，在他下令處決她的那天，他已經是個瘋子。就算他事後完全不記得自己幹了這事，我也一點都不會驚訝。",shape=box,color=blue];
		j1257368288 -> j1982685745;
	j1982685745 [label="Ballas 愛 Margulis。他全心全意徹底地獻身於她。他願意為她犧牲一切。他的靈魂、他的身體、Orokin 帝國。任何你能想像到的東西。",shape=box,color=blue];
		j1982685745 -> j3743310226;
	j3743310226 [label="沒有什麼代價是太高的。沒有什麼道德是不能犧牲的。如果你塞給他一個嬰兒，跟他說 Margulis 想看腦漿，你話還沒說完，那嬰兒就已經死了。",shape=box,color=blue];
		j3743310226 -> j1127075612;
	j1127075612 [label="篡位者，他本來會為了她把整個始源星系燒成灰燼，再以她的形象重建……但悲劇就在這裡。",shape=box,color=blue];
		j1127075612 -> j856832026;
	j856832026 [label="Margulis？啊，Margulis。親愛的、甜美的、惹人憐愛的 Margulis……她還保有良知。",shape=box,color=blue];
		j856832026 -> j2127244876;
	j2127244876 [label="而當她看到那些可憐的 Tenno，那些可憐的、被虛空撕裂的孩子們時……",shape=box,color=blue];
		j2127244876 -> j13247644;
	j13247644 [label="她的生命中出現了比 Ballas 更重要的東西。她的生命中有某樣東西值得她拚命去保護…… 而那個東西不是他。",shape=box,color=blue];
		j13247644 -> j3254887295;
	j3254887295 [label="不是她對他的愛。",shape=box,color=blue];
		j3254887295 -> j1727548088;
	j1727548088 [label="而且他清楚意識到知道這一點，我親愛的漂泊者。從她把目光投向他們的那一刻起，他就知道了。而當她的「瘋狂動物」確保他們就是她此生最後所見之物時，他就徹底明白了。至少，我們 Orokin 之間的謠言是這麼說的。",shape=box,color=blue];
		j1727548088 -> j3310279257;
	j3310279257 [label="被虛空撕裂的、瘋狂的小鬼們燒瞎了 Ballas 那寶貝哲士的眼睛時，你能想像 Orokin 人當時有多高興嗎？",shape=box,color=blue];
		j3310279257 -> j3193549424;
	j3193549424 [label="但我認為，Ballas 的心碎發生於更早時候。就在 Margulis 為了那群 Tenno 而反抗 Ballas 的那一刻起，他的心就碎成了渣渣，再也拼不回去了。",shape=box,color=blue];
		j3193549424 -> j458243766;
	j458243766 [label="因為他知道，他在她的心中已經被取代了。",shape=box,color=blue];
		j458243766 -> j3051075241;
	j3051075241 [label="我猜因為這個原因，我才同情他。但之後呢？一場流芳百世的愛情故事……最後卻以如此令人心碎的悲劇收場。 ",shape=box,color=blue];
		j3051075241 -> j3913544913;
	j3913544913 [label="我真希望你看過他們是怎麼對著彼此微笑的……",shape=box,color=blue];
		j3913544913 -> j3745824768;
		j3913544913 -> j1893663649;
	j3745824768 [label="你可以隨意美化他們的過去，但那不能幫他的所作所為開脫。Ballas 幹的那些爛事，不可原諒。",shape=box,color=red];
		j3745824768 -> j3730114463;
	j1893663649 [label="我很高興他們的愛是真的。他當時確實……很複雜。而且 Margulis 並不是從頭到尾都在被玩弄。",shape=box,color=red];
		j1893663649 -> j3557154181;
	j3730114463 [label="Add 1 to Thermostat counter",color=orange];
		j3730114463 -> j1807797091;
	j3557154181 [label="Add -1 to Thermostat counter",color=orange];
		j3557154181 -> j2296177445;
	j1807797091 [label="+10 Chemistry",color=orange];
		j1807797091 -> j389396272;
	j2296177445 [label="+10 Chemistry",color=orange];
		j2296177445 -> j273294856;
	j389396272 [label="篡位者，我也不打算把這兩件事相提並論。我只是在陳述，一個人既可以被愛，但也有能力幹出可怕的事。唉……看來我們這些墮落的傻瓜也無藥可救了……",shape=box,color=blue];
		j389396272 -> j4218882510;
	j273294856 [label="沒錯。有時候我一想到連那個墮落之王都能找到真愛，（冷笑）… 我們這些剩下來的好像就也有希望了，嗯？哈！",shape=box,color=blue];
		j273294856 -> j4218882510;
	j4218882510 [label="Boolean RoatheMargulis1 is now true.",color=orange];
		j4218882510 -> j910395154;
	j910395154 [label="不過，我今天已經占用了你夠多時間了。現在，你可以走了。",shape=box,color=blue];
