	j2475645347 [label="你知道嗎，他們曾經相愛過。",shape=box,color=blue];
		j2475645347 -> j647517270;
		j2475645347 -> j1212189839;
		j2475645347 -> j1350559949;
	j2366410360 [label="瞎搞我們所有人的記憶……全是為了慾望？真愛？還是什麼？你會如何稱呼它？我只是很好奇，這一切值嗎？呵，或者我猜你還不知道，因為你還沒拿到你的回報。",shape=box,color=blue];
		j2366410360 -> j105731226;
	j3574335918 [label="瞎搞我們所有人的記憶……這到底是為了什麼？為了把某個……隱形的任務清單打勾？還是說，這全是為了打倒你那個憑空捏造的、所謂的「神」？",shape=box,color=blue];
		j3574335918 -> j1279510591;
	j647517270 [label="誰？",shape=box,color=red];
		j647517270 -> j159764624;
	j1212189839 [label="我很難相信這一點。",shape=box,color=red];
		j1212189839 -> j799821182;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j105731226 [label="我想這還挺浪漫的，雖然有一點點……反烏托邦。為了贏得你心上人的心（和／或身體），你還真是不擇手段啊。",shape=box,color=blue];
		j105731226 -> j1067259113;
	j1279510591 [label="還是比那更糟？你只是出於好奇，想看看事情會變成什麼樣？就那樣坐著，一邊拔著昆蟲的腿取樂？我們已經弄清楚你行為背後的「是什麼」，現在我想問的是「為什麼」。",shape=box,color=blue];
		j1279510591 -> j3362610447;
	j159764624 [label="Ballas 和 Margulis。",shape=box,color=blue];
		j159764624 -> j1991546585;
	j799821182 [label="這是真的！我幾乎能聽到你在聖堂那頭發出的嗤笑聲。但是 Ballas 和 Margulis 以前確實彼此相愛。。",shape=box,color=blue];
		j799821182 -> j1022797958;
	j1067259113 [label="還是比那更糟？你只是出於好奇，想看看事情會變成什麼樣？就那樣坐著，一邊拔著昆蟲的腿取樂？我們已經弄清楚你行為背後的「是什麼」，現在我想問的是「為什麼」。",shape=box,color=blue];
		j1067259113 -> j2868117985;
