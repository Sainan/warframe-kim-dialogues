	j1991546585 [label="我幾乎能聽到你在聖堂那頭發出的嗤笑聲。但這是真的。",shape=box,color=blue];
		j1991546585 -> j1022797958;
	j1022797958 [label="恐怕你認識 Ballas 時，一切早就……變得不對勁了。",shape=box,color=blue];
		j1022797958 -> j2248527490;
		j1022797958 -> j3913640726;
