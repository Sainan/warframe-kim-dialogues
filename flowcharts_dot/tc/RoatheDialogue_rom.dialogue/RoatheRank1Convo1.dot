digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank1Convo1 begins." [color=orange];
		"RoatheRank1Convo1 begins." -> j3998890108;
	j3998890108 [label="Evaluate expressions on HellStory counter",color=orange];
		j3998890108 -> j1735724814 [label="x >= 21",color=purple];
		j3998890108 -> j2724955499 [label="x >= 6",color=purple];
		j3998890108 -> j406825128 [label="x < 6",color=purple];
		j3998890108 -> j406825128 [label="false",color=purple];
	j1735724814 [label="我可真得佩服你的膽量！說真的，你該不會是 Orokin 假扮的吧？故意藏起你那身藍皮，就為了不讓別人起疑？！」",shape=box,color=blue];
		j1735724814 -> j2748089015;
		j1735724814 -> j1404307787;
		j1735724814 -> j1594197338;
	j2724955499 [label="Boolean RoatheResetEdgeCase is now true.",color=orange];
		j2724955499 -> j406825128;
	j406825128 [label="虛空誕生的異類。「漂泊者」。篡位者。我們總算能說上話了。來。 惡魔想跟你談筆交易……",shape=box,color=blue];
		j406825128 -> j3758997629;
		j406825128 -> j1563774959;
		j406825128 -> j2708103803;
		j406825128 -> j3172551913;
	j2748089015 [label="你好，羅瑟。",shape=box,color=red];
		j2748089015 -> j3622143226;
	j1404307787 [label="你到底想指責我什麼？",shape=box,color=red];
		j1404307787 -> j4291731470;
	j1594197338 [label="抱歉？",shape=box,color=red];
		j1594197338 -> j4291731470;
	j3758997629 [label="篡位者？",shape=box,color=red];
		j3758997629 -> j942089482;
	j1563774959 [label="什麼……樣的交易？",shape=box,color=red];
		j1563774959 -> j1610373403;
	j2708103803 [label="「桃源惡魔」到底能有什麼提議要給我？",shape=box,color=red];
		j2708103803 -> j2588549352;
	j3172551913 [label="你好，羅瑟。",shape=box,color=red];
		j3172551913 -> j1693042311;
	j3622143226 [label="啊，太好了！你居然還真的知道我叫什麼！我還以為你早就忘了！畢竟你當時忙著一遍又一遍地殺我！",shape=box,color=blue];
		j3622143226 -> j3518443497;
	j4291731470 [label="你真的沒別的更有意義的事要幹嗎？！還是說你覺得一遍又一遍地玩這種「貼羚角」的蠢遊戲，就是你最好的消遣？！",shape=box,color=blue];
		j4291731470 -> j3518443497;
	j942089482 [label="Boolean RoatheUsurper is now true.",color=orange];
		j942089482 -> j341958474;
	j1610373403 [label="嗯，不用擔心……也不必激動。此僅為一筆商業協議，你我二人各取所需互惠互利罷了。",shape=box,color=blue];
		j1610373403 -> j1693042311;
	j2588549352 [label="+5 Chemistry",color=orange];
		j2588549352 -> j3963875433;
	j1693042311 [label="現在。聽好了。那兩個狂熱分子沒完沒了地罵我，真是無聊透頂。我希望你能長進點，別跟他們一樣蠢。",shape=box,color=blue];
		j1693042311 -> j2901133154;
		j1693042311 -> j314760;
	j3518443497 [label="我真的很難相信！這一切——我從你手中遭受的這一切不公，我心靈受到的這一切剝削……居然不是你故意指使，純粹為了折磨我！",shape=box,color=blue];
		j3518443497 -> j3914407941;
		j3518443497 -> j1705464959;
		j3518443497 -> j2726402173;
	j341958474 [label="+5 Chemistry",color=orange];
		j341958474 -> j135888682;
	j3963875433 [label="看來我名聲在外。很好。這能幫我們省點時間。",shape=box,color=blue];
		j3963875433 -> j198341473;
	j2901133154 [label="我憑什麼要聽你的。",shape=box,color=red];
		j2901133154 -> j4026548805;
	j314760 [label="我盡力而為吧。",shape=box,color=red];
		j314760 -> j739816367;
	j3914407941 [label="這看起來不像是個優先事項嗎？",shape=box,color=red];
		j3914407941 -> j312185745;
	j1705464959 [label="我……只是我剛好沒空處理這個。",shape=box,color=red];
		j1705464959 -> j682289560;
	j2726402173 [label="你不記得……但我們以前已經經歷過這一切了。",shape=box,color=red];
		j2726402173 -> j4278557320;
	j135888682 [label="啊！那就是你，對吧？Tenno 從 Orokin 手中奪走了整個始源星系。而你，就像巢中偽雛那樣，從你自己的世界偷偷鑽到這裡來。",shape=box,color=blue];
		j135888682 -> j1413356779;
	j198341473 [label="不用擔心也不必激動。此僅為一筆商業協議，你我二人各取所需互惠互利罷了。",shape=box,color=blue];
		j198341473 -> j1693042311;
	j4026548805 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j4026548805 -> j3919420474 [label="x >= 21",color=purple];
		j4026548805 -> j4269422907 [label="x >= 1",color=purple];
		j4026548805 -> j4273049732 [label="x <= 0",color=purple];
		j4026548805 -> j4273049732 [label="false",color=purple];
	j739816367 [label="最好是這樣。",shape=box,color=blue];
		j739816367 -> j4156038386;
	j312185745 [label="看起來不像——",shape=box,color=blue];
		j312185745 -> j3196616810;
	j682289560 [label="喔！真是非常抱歉給你添麻煩了，我還真沒意識到你的檔期已經被排滿了！",shape=box,color=blue];
		j682289560 -> j1749599587;
	j4278557320 [label="+5 Chemistry",color=orange];
		j4278557320 -> j419644082;
	j1413356779 [label="所以，在我看來，你至少有兩條篡奪之罪。（如果把管家跟我說的渡域的事也算上，也許是三條。不過那事以後再說。）",shape=box,color=blue];
		j1413356779 -> j1693042311;
	j3919420474 [label="你已經一遍又一遍既殘酷又清楚地表明了這一點了，多謝。",shape=box,color=blue];
		j3919420474 -> j4156038386;
	j4269422907 [label="你已經說得很清楚了。",shape=box,color=blue];
		j4269422907 -> j4156038386;
	j4273049732 [label="我們走著瞧。",shape=box,color=blue];
		j4273049732 -> j4156038386;
	j4156038386 [label="聽著，交易很簡單，我這位迷人、滑膩而又虛無縹緲的新「朋友」。",shape=box,color=blue];
		j4156038386 -> j1071362491;
	j3196616810 [label="這看起來不像是個優先事項嗎？！",shape=box,color=blue];
		j3196616810 -> j1477565101;
	j1749599587 [label="真的。我太驚訝了。漂泊者，你這教養簡直爛透了。",shape=box,color=blue];
		j1749599587 -> j198037087;
	j419644082 [label="你說啥？我怎麼可能忘了？！你把我腦子當成納貝流士派對上的迷離之碗一樣在那翻來覆去，我怎麼可能忘了！",shape=box,color=blue];
		j419644082 -> j2383191491;
		j419644082 -> j967526634;
	j1071362491 [label="Evaluate expressions on HellKeyPlayed counter",color=orange];
		j1071362491 -> j401362825 [label="x >= 21",color=purple];
		j1071362491 -> j3659652889 [label="x >= 1",color=purple];
		j1071362491 -> j1103635853 [label="x <= 0",color=purple];
		j1071362491 -> j1103635853 [label="false",color=purple];
	j1477565101 [label="你平常都這樣的嗎？在別人的記憶裡亂挖一通，毀掉他們過去的形象，連先了解一下對方都不願意？！",shape=box,color=blue];
		j1477565101 -> j2141940215;
	j198037087 [label="但我想現在也沒什麼辦法了。你知道真相。我已經在你面前原形畢露，連同我那令人憎惡的懦弱。",shape=box,color=blue];
		j198037087 -> j823417938;
	j2383191491 [label="長話短說，就是……Infestation 好像也延伸到了原型 Warframe 的血清裡…",shape=box,color=red];
		j2383191491 -> j2218479192;
	j967526634 [label="啊。好吧。是這樣的。我有能力讓時間循環。",shape=box,color=red];
		j967526634 -> j2218479192;
	j401362825 [label="既然你們已經像隻喝醉的銳澤獸在玻璃店裡一樣把我的腦子搞得一團亂。我現在就需要你幫我搞清楚這一切是怎麼回事。",shape=box,color=blue];
		j401362825 -> j282364245;
	j3659652889 [label="你和那兩個狂熱分子已經像隻喝醉的銳澤獸在玻璃店裡一樣把我的腦子搞得一團亂。我現在就需要你幫我搞清楚這一切是怎麼回事。",shape=box,color=blue];
		j3659652889 -> j282364245;
	j1103635853 [label="當阿爾布雷希特用那管注射器插進我脖子把我變成這副——東西——時，他還幹了別的。Orokin 之間的遊戲當然是一回事。但這種？這完全是另一回事。",shape=box,color=blue];
		j1103635853 -> j1081810267;
	j2141940215 [label="你這教養簡直爛透了！",shape=box,color=blue];
		j2141940215 -> j198037087;
	j823417938 [label="我猜你現在過來，只是為了嘲笑我。我請求你，要笑就現在一次笑個夠，這樣我們才能不受干擾地繼續。",shape=box,color=blue];
		j823417938 -> j2699265052;
	j2218479192 [label="我本來以為，它之所以在 1999 年對原型 Warframe 起作用，是因為那一年本身就在循環，但事實並非如此。 ",shape=box,color=red];
		j2218479192 -> j1893124967;
	j282364245 [label="我不僅需要你幫我找回記憶——更糟的是，我現在似乎連靠自己分辨這些記憶真假的能力都沒了！",shape=box,color=blue];
		j282364245 -> j2633141803;
		j282364245 -> j2230914676;
	j1081810267 [label="他搶走了我的大部分記憶。我看到那個小小版本的……你，正和那群受了創傷的 Tenno 朋友到處亂跑。我看到 Lotus 正在幫它恢復。",shape=box,color=blue];
		j1081810267 -> j3228376594;
		j1081810267 -> j3629000732;
	j2699265052 [label="我可不想整天被這玩意絆腳，搞得像在應付哪個女伶養來當觀賞又只會亂叫的庫狛。",shape=box,color=blue];
		j2699265052 -> j3175023834;
		j2699265052 -> j4226406179;
	j1893124967 [label="我覺得這可能……跟 Infestation 本身比較有關？有把會說話的吉就暗示過。而且，你是坐在 Helminth 之中過來的，對吧？",shape=box,color=red];
		j1893124967 -> j3234184268;
	j2633141803 [label="所以你是說你……只是需要找個人聊聊？",shape=box,color=red];
		j2633141803 -> j2043639443;
	j2230914676 [label="如果我能幫上忙我很樂意，但我真的不知道該怎麼做。",shape=box,color=red];
		j2230914676 -> j2820037094;
	j3228376594 [label="所以……你為什麼不自己進那個憶夢池？",shape=box,color=red];
		j3228376594 -> j3425354157;
	j3629000732 [label="那孩子不是「它」。",shape=box,color=red];
		j3629000732 -> j444532147;
	j3175023834 [label="你逃跑了。但很多人都會逃跑。關鍵是你得敢面對發生了的事。",shape=box,color=red];
		j3175023834 -> j2047604489;
	j4226406179 [label="我不是要嘲笑你。你只是選擇了擇日再戰罷了。",shape=box,color=red];
		j4226406179 -> j1972096178;
	j3234184268 [label="漂泊者，我怎麼看你好像對這場對話很不確認啊？特別是談到我這顆腦袋裡的東西時。",shape=box,color=blue];
		j3234184268 -> j3532197688;
	j2043639443 [label="喔別把這說得好像我只需要躺在沙發上好好談談我的『感受』那樣。",shape=box,color=blue];
		j2043639443 -> j2820037094;
	j2820037094 [label="我需要有個人聽我指揮來操作這台機器，因為我目前沒辦法自己動手。",shape=box,color=blue];
		j2820037094 -> j3990466217;
	j3425354157 [label="相信我，我巴不得自己來——但我辦不到啊！阿爾布雷希特那混帳用他媽的原型 Warframe 血清來毒害我，害我現在碰都碰不了這鬼玩意！",shape=box,color=blue];
		j3425354157 -> j78349356;
	j444532147 [label="我跟你保證，我說的「它」就是那個意思。",shape=box,color=blue];
		j444532147 -> j4099194006;
	j2047604489 [label="Add 1 to Thermostat counter",color=orange];
		j2047604489 -> j3754840495;
	j1972096178 [label="Add -1 to Thermostat counter",color=orange];
		j1972096178 -> j104974951;
	j3532197688 [label="沒錯。我確實是乘著 Helminth 過來的。那還是我自己設計和培養的，謝謝。現在。你是說你……抹除了我的記憶？！抹除了什麼？我們之間的對話嗎？！",shape=box,color=blue];
		j3532197688 -> j1670577022;
	j3990466217 [label="我還需要找個人幫我記錄回憶，並協助我釐清它們。差不多就是想找個臨時打雜。",shape=box,color=blue];
		j3990466217 -> j1488960002;
	j78349356 [label="此外，我不僅需要你幫我找回記憶——更糟的是，我現在似乎連靠自己分辨這些記憶真假的能力都沒了！",shape=box,color=blue];
		j78349356 -> j2633141803;
		j78349356 -> j2230914676;
	j4099194006 [label="我巴不得自己來——但我辦不到啊！阿爾布雷希特那混帳用他媽的原型 Warframe 血清來毒害我，害我現在碰都碰不了這鬼玩意！",shape=box,color=blue];
		j4099194006 -> j78349356;
	j3754840495 [label="好極了。又來一隻嗡嗡叫的破蒼蠅，在我耳邊飛來飛去想教訓我我需要自我反省和懺悔似的？",shape=box,color=blue];
		j3754840495 -> j3680645873;
	j104974951 [label="+5 Chemistry",color=orange];
		j104974951 -> j1645506167;
	j1670577022 [label="我對你可真是「印象深刻」啊，我可是清清楚楚地記得你是怎麼為了你那血腥的樂子把我一遍又一遍地剁成肉醬！這他媽的到底哪裡合理了？",shape=box,color=blue];
		j1670577022 -> j1931862521;
		j1670577022 -> j1650383981;
	j1488960002 [label="作為交換——你會得到我鄭重的承諾。我會……安靜地待在這裡。我絕對有本事去威脅誰，但我向你保證……我不會威脅任何人。我不會傷害那兩個狂熱分子。或是那個管家。或是阿爾布雷希特的虛空腐化動物。",shape=box,color=blue];
		j1488960002 -> j1052444536;
	j3680645873 [label="我真幸運。",shape=box,color=blue];
		j3680645873 -> j201877281;
	j1645506167 [label="現在，我所做的似乎就是「這破墳墓裡跟兩個白痴神經病一起發爛發臭，順便發些破爛玩具給那些被戰爭嚇傻的小鬼」。",shape=box,color=blue];
		j1645506167 -> j3014107347;
	j1931862521 [label="我不知道，而且羅瑟，我不是來這裡聽你辱罵的。我讓所有人陷入循環，可不是為了被你抓著這件事罵的。",shape=box,color=red];
		j1931862521 -> j1297326961;
	j1650383981 [label="據我猜測？我們的對話並不深入。它們是表層記憶。我們在你過去中發現的那些……更像是你核心記憶的一部分吧，我猜？",shape=box,color=red];
		j1650383981 -> j3492039046;
	j1052444536 [label="更重要的是，我不會傷害阿爾布雷希特那群扭曲的家人。他們就像上面那些突變的植物一樣待在那裡——對我們的存在渾然不覺。",shape=box,color=blue];
		j1052444536 -> j65491554;
		j1052444536 -> j1957255828;
		j1052444536 -> j689412802;
	j201877281 [label="漂泊者，我打算繼續做我的事，但事實是——你知道了太多關於我過去的秘密。所以我們……只能暫時……保持現狀。",shape=box,color=blue];
		j201877281 -> j315877084;
	j3014107347 [label="但我猜這一定就是你們現在的叫法吧。",shape=box,color=blue];
		j3014107347 -> j201877281;
	j1297326961 [label="沒錯。我大概猜得到，你為什麼要用你那虛空把戲來洗掉我們的記憶。你這招真是太好猜了。",shape=box,color=blue];
		j1297326961 -> j1238322013;
	j3492039046 [label="真是太棒了。簡直妙不可言。我現在的命居然捏在一個能隨心所欲洗掉我記憶的瘋子手裡！真是妙極了。",shape=box,color=blue];
		j3492039046 -> j1238322013;
	j65491554 [label="我以為這是一筆交易。現在你卻在威脅我？",shape=box,color=red];
		j65491554 -> j747074473;
	j1957255828 [label="羅斯？拜託你停下來，聽我說一下。",shape=box,color=red];
		j1957255828 -> j324563692;
	j689412802 [label="你要我做什麼？",shape=box,color=red];
		j689412802 -> j2257935907;
	j315877084 [label="你最好別讓我太不舒服。我保證你對我做什麼我也會試著對你做什麼。",shape=box,color=blue];
		j315877084 -> j1797287558;
		j315877084 -> j3435199350;
	j1238322013 [label="好吧。如果你說的是實話——我猜這鬼話編也編不出來——那我會試著原諒你，原諒你知道了我那不堪的真相。",shape=box,color=blue];
		j1238322013 -> j787198812;
	j747074473 [label="你剛才沒在聽嗎？真是的，現在的人理解能力都這麼差嗎……篡位者，我可沒有在威脅你。我誰也沒威脅。",shape=box,color=blue];
		j747074473 -> j192864528;
	j324563692 [label="這肯定會是場大戲。請。自便。舞台是你的。",shape=box,color=blue];
		j324563692 -> j4232649798;
		j324563692 -> j3836048581;
		j324563692 -> j3787816928;
	j2257935907 [label="你剛是沒在聽嗎？現在的人閱讀理解能力都這麼差嗎……篡位者，我正試著跟你談交易。我真不敢相信你連這都聽不懂。",shape=box,color=blue];
		j2257935907 -> j2880113859;
	j1797287558 [label="不。",shape=box,color=red];
		j1797287558 -> j3412762221;
	j3435199350 [label="我認為這夠公平了。",shape=box,color=red];
		j3435199350 -> j2859950526;
	j787198812 [label="不過我倒是想拜託你——如果可以的話——你能不能先把你想嘲笑我的話一次性說完，這樣我們才能不受干擾地繼續。",shape=box,color=blue];
		j787198812 -> j2699265052;
