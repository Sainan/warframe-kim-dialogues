	"Chat ends." [color=orange];
	j3275756547 [label="VM: ADAPTATION",shape=box,color=blue];
		j3275756547 -> j2943966233;
	j2943966233 [label="文字記錄：許多 Sentient 在交戰之間進化，所以我們永遠無法確定會面對同樣的敵人兩次。但其他的保持一致的形態，彷彿它們很久以前就達到了某個平台期。",shape=box,color=blue];
		j2943966233 -> j3050771632;
	j3050771632 [label="Perfected killers, they brought the same cold horror that a shark does.",shape=box,color=blue];
		j3050771632 -> j335182429;
	j335182429 [label="這太瘋狂了。我該如何針對 Sentient 蟹形船的行為制定戰略？當我的戰術剛被完善，蟹形船就被蟲形船取代了。",shape=box,color=blue];
		j335182429 -> j2561583920;
	j2561583920 [label="而那些蟲形船還有多久會被某種新的怪物取代？",shape=box,color=blue];
		j2561583920 -> j198894524;
	j198894524 [label="All we could do was go backward. Progress had been fatal. Old traditions, time-hallowed paths of honor and discipline, were owed their due.",shape=box,color=blue];
		j198894524 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}