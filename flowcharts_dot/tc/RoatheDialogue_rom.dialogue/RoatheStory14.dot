		2257 -> 2259;
	2260 [label="Chat ends.",color=orange];
	2259 [label="文字記錄：許多 Sentient 在交戰之間進化，所以我們永遠無法確定會面對同樣的敵人兩次。但其他的保持一致的形態，彷彿它們很久以前就達到了某個平台期。",shape=box,color=blue];
		2259 -> 5709;
	5709 [label="Perfected killers, they brought the same cold horror that a shark does.",shape=box,color=blue];
		5709 -> 2256;
	2256 [label="這太瘋狂了。我該如何針對 Sentient 蟹形船的行為制定戰略？當我的戰術剛被完善，蟹形船就被蟲形船取代了。",shape=box,color=blue];
		2256 -> 2253;
	2253 [label="而那些蟲形船還有多久會被某種新的怪物取代？",shape=box,color=blue];
		2253 -> 5710;
	5710 [label="All we could do was go backward. Progress had been fatal. Old traditions, time-hallowed paths of honor and discipline, were owed their due.",shape=box,color=blue];
		5710 -> 2255;
	2255 [label="Add 1 to HellStory",color=orange];
		2255 -> 2341;
	2341 [label="{\"Id\":2341,\"Incoming\":[2255],\"Outgoing\":[2254],\"GraphPos\":[4071,-6212],\"CompletionType\":1}",color=orange];
		2341 -> 2254;
	2254 [label="Chat ends.",color=orange];
