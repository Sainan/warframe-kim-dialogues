	j1513882788 [label="語音訊息：適應",shape=box,color=blue];
		j1513882788 -> j2355846153;
	j2355846153 [label="文字記錄：許多 Sentient 在交戰之間進化，所以我們永遠無法確定會面對同樣的敵人兩次。但其他的保持一致的形態，彷彿它們很久以前就達到了某個平台期。",shape=box,color=blue];
		j2355846153 -> j1769830126;
	j1769830126 [label="這些完美的殺手，帶來如同鯊魚般冷酷的恐怖。",shape=box,color=blue];
		j1769830126 -> j3069978495;
	j3069978495 [label="這太瘋狂了。我該如何針對 Sentient 蟹形船的行為制定戰略？當我的戰術剛被完善，蟹形船就被蟲形船取代了。",shape=box,color=blue];
		j3069978495 -> j2510470675;
	j2510470675 [label="而那些蟲形船還有多久會被某種新的怪物取代？",shape=box,color=blue];
		j2510470675 -> j2241260823;
	j2241260823 [label="我們所能做的就是倒退。進步是致命的。舊傳統、經受時間考驗的榮譽和紀律之道，應得到應有的尊重。",shape=box,color=blue];
		j2241260823 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}