	j989980218 [label="語音訊息：NITOKH",shape=box,color=blue];
		j989980218 -> j844398231;
	j844398231 [label="文字記錄：她的瘋狂具有誘惑力，因為它顯而易見。",shape=box,color=blue];
		j844398231 -> j141979885;
	j141979885 [label="人們總能清楚自己與她的立場──在那深淵的邊緣。",shape=box,color=blue];
		j141979885 -> j3530262152;
	j3530262152 [label="她的眼神閃耀著某種宇宙巨大玩笑的喜悅，彷彿對我說道，跳下去吧。",shape=box,color=blue];
		j3530262152 -> j3047911427;
	j3047911427 [label="通過她瘋狂的幻象，我能逃離 Orokin 漫長而黯淡的僵滯。",shape=box,color=blue];
		j3047911427 -> j3119214891;
	j3119214891 [label="我們所有的感官在幾個世紀前就已麻木。然而她仍以某種方式永遠保持著鮮活。",shape=box,color=blue];
		j3119214891 -> j2790845858;
	j2790845858 [label="她的飢渴無窮無盡。某天晚上她召喚我到她的浴池。我跨過混合著香水和鮮血的水窪，盡職地立正站好。",shape=box,color=blue];
		j2790845858 -> j3424061441;
	j3424061441 [label="「我無聊了，羅瑟。我們殺光其他 Orokin，然後接管一切吧。」",shape=box,color=blue];
		j3424061441 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}