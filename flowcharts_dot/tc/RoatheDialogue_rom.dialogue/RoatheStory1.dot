	"Chat ends." [color=orange];
	j3376597498 [label="VM: NITOKH",shape=box,color=blue];
		j3376597498 -> j4199384026;
	j4199384026 [label="文字記錄：她的瘋狂之所以具有誘惑力，是因為它是顯而易見的。",shape=box,color=blue];
		j4199384026 -> j2124435525;
	j2124435525 [label="One always knew where one stood with her - right on the precipice of the great abyss.",shape=box,color=blue];
		j2124435525 -> j1462483172;
	j1462483172 [label="她的眼神閃耀著某種宇宙巨大玩笑的喜悅，彷彿對我說道，跳下去吧。",shape=box,color=blue];
		j1462483172 -> j2629073658;
	j2629073658 [label="通過她瘋狂的幻象，我能逃離 Orokin 漫長而黯淡的僵滯。",shape=box,color=blue];
		j2629073658 -> j413115115;
	j413115115 [label="我們所有的感官在數個世紀前麻木飽和了。然而，她依然保持著她獨特的清新感。",shape=box,color=blue];
		j413115115 -> j2790845858;
	j2790845858 [label="她的飢渴無窮無盡。某天晚上她召喚我到她的浴池。我跨過混合著香水和鮮血的水窪，盡職地立正站好。",shape=box,color=blue];
		j2790845858 -> j3424061441;
	j3424061441 [label="「我無聊了，羅瑟。我們殺光其他 Orokin，然後接管一切吧。」",shape=box,color=blue];
		j3424061441 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}