	3377 [label="If you want to choose to blaze a path on your own? For yourself? Do it. Don't apologize. But that is your path to choose, no one else's.",shape=box,color=red];
		3377 -> 3399;
	3378 [label="If you wish to seek forgiveness, you can. But you need to want it. You need to choose that path. No one else can.",shape=box,color=red];
