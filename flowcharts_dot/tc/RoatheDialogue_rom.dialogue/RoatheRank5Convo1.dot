	3422 [label="You're letting that anger tear you up inside. You could be using it to help you fight the people who are still destroying this world today. Here. Now.",shape=box,color=red];
		3422 -> 3453;
	3421 [label="You're pointing it at yourself. You should be pointing it at the world that is blaming you for doing the best you could to save it from the Orokin Empire.",shape=box,color=red];
		3421 -> 3452;
	3418 [label="Being angry isn't going to solve anything, Roathe. You're angry because you're scared to face what you did. And what you've become.",shape=box,color=red];
		3418 -> 3422;
	3419 [label="Fine. Be angry. But use that anger for something worthwhile. Use it to shake loose all this hatred you have in you that you're pointing in the wrong direction.",shape=box,color=red];
		3419 -> 3421;
	3420 [label="I just wish I knew how to help you. I wish I knew what to say. It feels like you're torn in two directions. Which way do you want to go?",shape=box,color=red];
