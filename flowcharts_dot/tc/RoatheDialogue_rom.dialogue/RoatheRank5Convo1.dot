		j1600617836 -> j3161399345;
	j2534828413 [label="等等。",shape=box,color=red];
		j2534828413 -> j3903661223;
	j3703723188 [label="羅瑟，等等。",shape=box,color=red];
		j3703723188 -> j3903661223;
	j698309146 [label="我告訴過你，趁現在還來得及，停止對我心智的探索！我告訴過你，停止你的工作，可是……可是！",shape=box,color=blue];
		j698309146 -> j2105624452;
	j4050659853 [label="你一直瞞著我，現在才告訴我？這一切對你來說是不是一場變態的遊戲？ ！你明知我會因此遭受懲罰，卻還故意放縱我內心深處的慾望？ ！",shape=box,color=blue];
		j4050659853 -> j2872124131;
	j941419113 [label="現在怎麼辦，親愛的？現在怎麼辦……？我感覺自己已經走投無路了。至少以前，我還有屈辱作為庇護！",shape=box,color=blue];
		j941419113 -> j2970128030;
	j3177464597 [label="現在怎麼辦，篡位者？現在怎麼辦……？我感覺自己已經走投無路了。至少以前，我還有屈辱作為庇護！",shape=box,color=blue];
		j3177464597 -> j116575550;
	j122004476 [label="我明白。相信我，我比你更明白。我明白。",shape=box,color=blue];
		j122004476 -> j3539413984;
	j3383057072 [label="我真的愛你。無論你以何種形式出現。無論你選擇成為誰。我都愛你。",shape=box,color=red];
		j3383057072 -> j1329246130;
	j3161399345 [label="我告訴過你，趁現在還來得及，停止對我心智的探索！我告訴過你，停止你的工作，可是……可是！",shape=box,color=blue];
		j3161399345 -> j1157625488;
