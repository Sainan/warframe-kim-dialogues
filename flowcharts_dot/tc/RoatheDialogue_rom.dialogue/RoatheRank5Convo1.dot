		j3591612755 -> j1934009866 [label="false",color=purple];
	j3543133375 [label="最初，我以為是 Uriel。怎會不是呢？另一個心靈，另一個破碎、殘缺、被遺棄的靈魂。他因自己並未選擇犯下的罪行而受到譴責。",shape=box,color=blue];
