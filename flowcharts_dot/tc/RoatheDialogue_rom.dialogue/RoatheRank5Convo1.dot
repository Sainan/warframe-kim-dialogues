		j3920616854 -> j664958039 [label=false,color=brown];
	j339879918 [label="你給了我你的承諾。你的承諾！但現在我發現你不過是個騙子！",shape=box,color=blue];
		j339879918 -> j2956493820;
		j339879918 -> j354798357;
	j2379788871 [label="我早該知道的。我早該知道不該相信你，你這個虛空誕生的異類！你是否知道有什麼在那裡等著我？！在我不知道的時候，你是否以某種方式知道了真相？！",shape=box,color=blue];
		j2379788871 -> j1231867975;
		j2379788871 -> j3637664048;
	j4035930766 [label="而我們又一次回到了原點。再一次踏在我們過去的屍體上。與以前一樣，毫無進展。",shape=box,color=blue];
		j4035930766 -> j1337921222;
	j2620398896 [label="看來完全不是因為我自己的懇求造成的！然而，我仍然清楚記得當初選擇服用那血清時的痛苦。",shape=box,color=blue];
		j2620398896 -> j1337921222;
	j1124547725 [label="而我們又一次回到了原點。再一次踏在我們過去的屍體上。與以前一樣，毫無進展。",shape=box,color=blue];
		j1124547725 -> j655505302;
	j2217159207 [label="看來完全不是因為我自己的懇求造成的！然而，我仍然清楚記得當初選擇服用那血清時的痛苦。",shape=box,color=blue];
		j2217159207 -> j655505302;
	j1583736552 [label="你曾對我說過一些話，我當時覺得它們根本不可能成真。請你再告訴我一次，那些話都是真的。請你再說一次。求你了。我現在比以往任何時候都更需要它們。",shape=box,color=blue];
		j1583736552 -> j2795992405;
		j1583736552 -> j4143805684;
	j2596437358 [label="你給了我你的承諾。你的承諾！而且你還用親暱的話語將它們美化得如此美好。但現在我發現你不過是個騙子！",shape=box,color=blue];
		j2596437358 -> j346511558;
		j2596437358 -> j1600617836;
	j664958039 [label="你知道嗎？ ！你知道嗎？ ！你是不是偷偷溜到我身邊，對我低語著親暱的話語，是希望藉此軟化接下來的打擊嗎？",shape=box,color=blue];
		j664958039 -> j2534828413;
		j664958039 -> j3703723188;
	j2956493820 [label="等等。",shape=box,color=red];
		j2956493820 -> j698309146;
	j354798357 [label="羅瑟，等等。",shape=box,color=red];
