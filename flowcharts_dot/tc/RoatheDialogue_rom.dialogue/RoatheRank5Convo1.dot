	j1231867975 [label="等等。",shape=box,color=red];
		j1231867975 -> j4050659853;
	j3637664048 [label="羅瑟，等等。",shape=box,color=red];
		j3637664048 -> j4050659853;
	j1337921222 [label="真可笑！真是太可笑了！我贏不了！我根本贏不了！",shape=box,color=blue];
		j1337921222 -> j941419113;
	j655505302 [label="真可笑！真是太可笑了！我贏不了！我根本贏不了！",shape=box,color=blue];
		j655505302 -> j3177464597;
	j2795992405 [label="我……做不到。對不起。",shape=box,color=red];
		j2795992405 -> j122004476;
	j4143805684 [label="羅瑟，我愛你。",shape=box,color=red];
		j4143805684 -> j3383057072;
	j346511558 [label="等等。",shape=box,color=red];
		j346511558 -> j3161399345;
