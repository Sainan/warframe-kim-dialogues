	j2766333329 [label="在這場瘋狂之中，自從我的記憶消失的那一刻起，我就一直感覺到這種……撕扯。這種撕扯感撕扯著我的胸膛，我的皮膚，就像某種巨大的野獸拼命想要掙脫我的束縛一樣。",shape=box,color=blue];
