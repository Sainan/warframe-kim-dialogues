	3352 [label="Forgot.",shape=box,color=blue];
		3352 -> 3372;
	3353 [label="It was not that big of a deal?!",shape=box,color=blue];
		3353 -> 3373;
	3354 [label="Please. Calm down. We don't need to resort to that. ",shape=box,color=red];
		3354 -> 3328;
	3355 [label="Be mad at me. Hate me if you want. But I'm not going to do anything until we solve this, first.",shape=box,color=red];
		3355 -> 3330;
	3348 [label="I feel as though I have had the very understanding of myself, the very basis of my foundation, cracked and torn open like damnable Lua herself! Rewritten in ink that runs. Coward!",shape=box,color=blue];
		3348 -> 3368;
	3349 [label="And I have had that definition of myself recently entirely rewritten. I have had it stamped upon my psyche in an ink that runs.",shape=box,color=blue];
		3349 -> 3369;
	3350 [label="You can hate me all you want, Roathe. But I've did what I did because it needed to happen. You couldn't hide from this any longer.",shape=box,color=red];
		3350 -> 3370;
	3351 [label="Think of me what you will. But I know a spiral when I've seen one.",shape=box,color=red];
		3351 -> 3371;
	3360 [label="You forgot?!",shape=box,color=blue];
		3360 -> 3379;
	3361 [label="I am sorry?!",shape=box,color=blue];
		3361 -> 3380;
	3356 [label="So perhaps you are correct. Perhaps it shall not change who I am. Perhaps that part of me shall never be rewritten. Not now, not ever.",shape=box,color=blue];
		3356 -> 3374;
	3357 [label="And you dare to tell me to \"calm down?!\"",shape=box,color=blue];
		3357 -> 3375;
	3358 [label="And we are right back to predictable and uninteresting.",shape=box,color=blue];
		3358 -> 3376;
	3359 [label="Yes, I do think you would be a bit of a \"connoisseur\" of such things, wouldn't you? Go on.",shape=box,color=blue];
		3359 -> 3377;
		3359 -> 3378;
	3362 [label="Beneath the memories, beneath the Orokin exterior, beneath this... blue skin and Infestation, beneath Uriel and this mask of Vice Regent Grand Carnus Roathe I wear...",shape=box,color=blue];
		3362 -> 3381;
	3363 [label="Beneath the memories, beneath the Orokin exterior, beneath this... blue skin and Infestation, beneath Uriel and this mask of Vice Regent Grand Carnus Roathe I wear...",shape=box,color=blue];
		3363 -> 3382;
	3364 [label="You have a gift. A gift that can undo time. Spiral it, if not loop it. And this has... an interesting effect upon the minds of Protoframes, by its attachment to the Infestation and its  attachment to time. ",shape=box,color=blue];
		3364 -> 3383;
	3365 [label="If you can say to me that you have never once used your gifts to play with the minds of the Protoframes you call friends and lovers, and you can say it without a lie in your soul?",shape=box,color=blue];
		3365 -> 3384;
	3366 [label="I am the last of the Orokin. I am crowned amongst them until anyone stands up to challenge me. And I shall be captain amongst all of my own affairs until the day my life is snuffed out.",shape=box,color=blue];
		3366 -> 3385;
	3367 [label="I am the last of the Orokin. I am crowned amongst them until anyone stands up to challenge me. And I shall be captain amongst all of my own affairs until the day my life is snuffed out.",shape=box,color=blue];
