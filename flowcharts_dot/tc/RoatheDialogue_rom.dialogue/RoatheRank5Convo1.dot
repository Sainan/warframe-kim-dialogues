	3344 [label="Which is what...? ",shape=box,color=red];
		3344 -> 3364;
	3345 [label="No. I know what you're going to ask, and the answer is already no.",shape=box,color=red];
		3345 -> 3365;
	3346 [label="I cast off these chains of shame and past cowardice. I throw off these shackles of rank and servitude.",shape=box,color=blue];
