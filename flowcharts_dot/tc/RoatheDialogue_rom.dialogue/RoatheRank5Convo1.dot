		j3920616854 -> j1583736552 [label=true,color=green];
		j3920616854 -> j664958039 [label=false,color=brown];
	j339879918 [label="你給了我你的承諾。你的承諾！但現在我發現你不過是個騙子！",shape=box,color=blue];
		j339879918 -> j2956493820;
		j339879918 -> j354798357;
	j2379788871 [label="我早該知道的。我早該知道不該相信你，你這個虛空誕生的異類！你是否知道有什麼在那裡等著我？！在我不知道的時候，你是否以某種方式知道了真相？！",shape=box,color=blue];
		j2379788871 -> j1231867975;
		j2379788871 -> j3637664048;
	j4035930766 [label="而我們又一次回到了原點。再一次踏在我們過去的屍體上。與以前一樣，毫無進展。",shape=box,color=blue];
		j4035930766 -> j1337921222;
	j2620398896 [label="看來完全不是因為我自己的懇求造成的！然而，我仍然清楚記得當初選擇服用那血清時的痛苦。",shape=box,color=blue];
		j2620398896 -> j1337921222;
	j1124547725 [label="而我們又一次回到了原點。再一次踏在我們過去的屍體上。與以前一樣，毫無進展。",shape=box,color=blue];
		j1124547725 -> j655505302;
	j2217159207 [label="看來完全不是因為我自己的懇求造成的！然而，我仍然清楚記得當初選擇服用那血清時的痛苦。",shape=box,color=blue];
		j2217159207 -> j655505302;
	j1583736552 [label="你曾對我說過一些話，我當時覺得它們根本不可能成真。請你再告訴我一次，那些話都是真的。請你再說一次。求你了。我現在比以往任何時候都更需要它們。",shape=box,color=blue];
		j1583736552 -> j2795992405;
		j1583736552 -> j4143805684;
	j2596437358 [label="你給了我你的承諾。你的承諾！而且你還用親暱的話語將它們美化得如此美好。但現在我發現你不過是個騙子！",shape=box,color=blue];
		j2596437358 -> j346511558;
		j2596437358 -> j1600617836;
	j664958039 [label="你知道嗎？ ！你知道嗎？ ！你是不是偷偷溜到我身邊，對我低語著親暱的話語，是希望藉此軟化接下來的打擊嗎？",shape=box,color=blue];
		j664958039 -> j2534828413;
		j664958039 -> j3703723188;
	j2956493820 [label="等等。",shape=box,color=red];
		j2956493820 -> j698309146;
	j354798357 [label="羅瑟，等等。",shape=box,color=red];
		j354798357 -> j698309146;
	j1231867975 [label="等等。",shape=box,color=red];
		j1231867975 -> j4050659853;
	j3637664048 [label="羅瑟，等等。",shape=box,color=red];
		j3637664048 -> j4050659853;
	j1337921222 [label="真可笑！真是太可笑了！我贏不了！我根本贏不了！",shape=box,color=blue];
		j1337921222 -> j941419113;
	j655505302 [label="真可笑！真是太可笑了！我贏不了！我根本贏不了！",shape=box,color=blue];
		j655505302 -> j3177464597;
	j2795992405 [label="我……做不到。對不起。",shape=box,color=red];
		j2795992405 -> j122004476;
	j4143805684 [label="羅瑟，我愛你。",shape=box,color=red];
		j4143805684 -> j3383057072;
	j346511558 [label="等等。",shape=box,color=red];
		j346511558 -> j3161399345;
	j1600617836 [label="羅瑟，等等。",shape=box,color=red];
		j1600617836 -> j3161399345;
	j2534828413 [label="等等。",shape=box,color=red];
		j2534828413 -> j3903661223;
	j3703723188 [label="羅瑟，等等。",shape=box,color=red];
		j3703723188 -> j3903661223;
	j698309146 [label="我告訴過你，趁現在還來得及，停止對我心智的探索！我告訴過你，停止你的工作，可是……可是！",shape=box,color=blue];
		j698309146 -> j2105624452;
	j4050659853 [label="你一直瞞著我，現在才告訴我？這一切對你來說是不是一場變態的遊戲？ ！你明知我會因此遭受懲罰，卻還故意放縱我內心深處的慾望？ ！",shape=box,color=blue];
		j4050659853 -> j2872124131;
	j941419113 [label="現在怎麼辦，親愛的？現在怎麼辦……？我感覺自己已經走投無路了。至少以前，我還有屈辱作為庇護！",shape=box,color=blue];
		j941419113 -> j2970128030;
	j3177464597 [label="現在怎麼辦，篡位者？現在怎麼辦……？我感覺自己已經走投無路了。至少以前，我還有屈辱作為庇護！",shape=box,color=blue];
		j3177464597 -> j116575550;
	j122004476 [label="我明白。相信我，我比你更明白。我明白。",shape=box,color=blue];
		j122004476 -> j3539413984;
	j3383057072 [label="我真的愛你。無論你以何種形式出現。無論你選擇成為誰。我都愛你。",shape=box,color=red];
		j3383057072 -> j1329246130;
	j3161399345 [label="我告訴過你，趁現在還來得及，停止對我心智的探索！我告訴過你，停止你的工作，可是……可是！",shape=box,color=blue];
		j3161399345 -> j1157625488;
	j3903661223 [label="你一直瞞著我，現在才告訴我？這一切對你來說是不是一場變態的遊戲？ ！你明知我會因此遭受懲罰，卻還故意放縱我內心深處的慾望？ ！",shape=box,color=blue];
		j3903661223 -> j2580643080;
	j2105624452 [label="看看你都做了什麼！",shape=box,color=blue];
		j2105624452 -> j25295461;
	j2872124131 [label="看看你都做了什麼！",shape=box,color=blue];
		j2872124131 -> j1643179786;
	j2970128030 [label="啊，我知道了……就是這裡。再次開始這螺旋式的循環。讓時間倒流。「重新開始」，對嗎？結束我內心的痛苦。重新開始。",shape=box,color=blue];
		j2970128030 -> j3107116128;
		j2970128030 -> j3981309038;
		j2970128030 -> j4076380099;
	j116575550 [label="啊，我知道了……就是這裡。再次開始這螺旋式的循環。讓時間倒流。「重新開始」，對嗎？結束我內心的痛苦。重新開始。",shape=box,color=blue];
		j116575550 -> j1868873925;
		j116575550 -> j1853650633;
		j116575550 -> j4289018140;
	j3539413984 [label="但這並不能減輕接下來將要面臨的殘酷現實。",shape=box,color=blue];
		j3539413984 -> j125404012;
	j1329246130 [label="哦，我最親愛的漂泊者……你給了我最珍貴的禮物。我……我不知道該如何感謝你。",shape=box,color=blue];
		j1329246130 -> j1248426513;
	j1157625488 [label="看看你都做了什麼！",shape=box,color=blue];
		j1157625488 -> j2082008866;
	j2580643080 [label="看看你都做了什麼！",shape=box,color=blue];
		j2580643080 -> j3210399678;
	j25295461 [label="我要求你解決這個問題。我知道你做得到！運用你的天賦，清除我腦中的這些記憶！",shape=box,color=blue];
		j25295461 -> j2078938997;
		j25295461 -> j1123813684;
		j25295461 -> j1793976753;
	j1643179786 [label="我要求你解決這個問題。我知道你做得到！運用你的天賦，清除我腦中的這些記憶！",shape=box,color=blue];
		j1643179786 -> j1110030593;
		j1643179786 -> j477241871;
		j1643179786 -> j4003653584;
	j3107116128 [label="羅瑟，這並不能消除深層記憶帶來的痛苦……只能消除這些表面的痛苦。這解決不了問題。",shape=box,color=red];
		j3107116128 -> j2590219528;
	j3981309038 [label="你確定嗎？你想讓我……再次抹去你的記憶？",shape=box,color=red];
