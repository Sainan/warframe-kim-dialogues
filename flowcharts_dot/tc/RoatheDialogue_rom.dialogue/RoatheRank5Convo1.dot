	j2158931152 [label="遭人詆毀，被誤解，被人唾棄。從天上被貶下，任其腐朽。真是同路人啊！",shape=box,color=blue];
		j2158931152 -> j246758138;
	j3939737060 [label="我知道這並非我們第一次經歷這一切。我記得之前也來過這裏。我也知道這或許不會是最後一次。我一直懇求你停下來，重新開始，而你真的這麼做了，這對我來說意義重大。",shape=box,color=blue];
		j3939737060 -> j1789946445;
	j2584099546 [label="我知道這並非我們第一次經歷這一切。我記得之前也來過這裏。我也知道這或許不會是最後一次。我一直懇求你停下來，重新開始，而你真的這麼做了，這對我來說意義重大。",shape=box,color=blue];
		j2584099546 -> j2933207261;
	j1162686963 [label="我知道這並非我們第一次經歷這一切。我記得之前也來過這裏。我也知道這或許不會是最後一次。我一直懇求你停下來，重新開始，而你真的這麼做了，這對我來說意義重大。",shape=box,color=blue];
		j1162686963 -> j2294477451;
	j4140626917 [label="篡位者，我必須讚揚你，因為你聽從了我的要求，沒有進一步深入憶夢池，也沒有觸及我在墮落淵獄中的記憶。即使我們之間沒有任何約定。",shape=box,color=blue];
		j4140626917 -> j1976589443;
	j1529846687 [label="親愛的，我必須讚揚你信守承諾，沒有繼續深入墮落淵獄和憶夢池，也沒有找回我最後的記憶。這對我來說很重要。",shape=box,color=blue];
		j1529846687 -> j3432067420;
	j431526750 [label="篡位者，我必須讚揚你，因為你聽從了我的要求，沒有進一步深入憶夢池，也沒有觸及我在墮落淵獄中的記憶。這對我來說很重要。",shape=box,color=blue];
		j431526750 -> j3432067420;
	j1687455130 [label="篡位者，我必須讚揚你信守承諾，沒有繼續深入墮落淵獄和憶夢池，也沒有找回我最後的記憶。",shape=box,color=blue];
		j1687455130 -> j642176772;
	j591245922 [label="篡位者，我必須讚揚你，因為你聽從了我的要求，沒有進一步深入憶夢池，也沒有觸及我在墮落淵獄中的記憶。即使我們之間沒有任何約定。",shape=box,color=blue];
		j591245922 -> j642176772;
	j246758138 [label="當那些被徵召者到來時，三種能量在我的體內扭曲融合，那麼第四種能量就不那麼令人驚訝了。這個巨大而可怕的東西，渴望像地殼一樣將我撕裂，然後傾瀉而出。",shape=box,color=blue];
		j246758138 -> j1257755707;
	j1789946445 [label="我記得你對我的承諾。而我竟然在你心中佔了如此一席位，以至於你讓我身處如此煉獄般的境地？謝謝你，我的寵物。",shape=box,color=blue];
		j1789946445 -> j3432067420;
	j2933207261 [label="我竟在你心中佔據了如此重要的位置，以至於你讓我一直處於這種煉獄般的境地？謝謝你，我的寶貝。謝謝你。",shape=box,color=blue];
		j2933207261 -> j3432067420;
	j2294477451 [label="我記得你對我的承諾。而我竟然與你建立了如此深厚的友誼，以至於你讓我身處如此煉獄般的境地？謝謝你，我的朋友。",shape=box,color=blue];
		j2294477451 -> j642176772;
	j1976589443 [label="而我竟然與你建立了如此深厚的友誼，以至於你讓我身處如此煉獄般的境地？謝謝你，我的朋友。",shape=box,color=blue];
		j1976589443 -> j642176772;
	j3432067420 [label="雖然這件事仍然讓我耿耿於懷，但它就像一隻被拴著的庫狛，吠叫著，可以被控制，可以被訓練。",shape=box,color=blue];
		j3432067420 -> j2756459558;
