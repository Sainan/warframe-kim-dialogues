	3381 [label="Who am I...?",shape=box,color=blue];
		3381 -> 3402;
	3382 [label="Who am I...?",shape=box,color=blue];
		3382 -> 3403;
	3383 [label="And our attachment, therefore, to time. I ask you now. No, I beseech you, to wield it now on my behalf. Take these thoughts away from me. Take these memories away from me.",shape=box,color=blue];
		3383 -> 3404;
	3384 [label="Then very well. So be it. I will not ask this of you now. But if you have never once done it for your own amusement, curiosity, or to seek to undue errors you have made in the dealings with others?!",shape=box,color=blue];
		3384 -> 3404;
