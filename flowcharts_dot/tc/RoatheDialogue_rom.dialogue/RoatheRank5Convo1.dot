		j1643179786 -> j4003653584;
	j3551351480 [label="羅瑟，這並不能消除深層記憶帶來的痛苦……只能消除這些表面的痛苦。這解決不了問題。",shape=box,color=red];
		j3551351480 -> j502368171;
