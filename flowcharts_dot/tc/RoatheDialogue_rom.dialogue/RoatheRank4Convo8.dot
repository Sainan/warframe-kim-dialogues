digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank4Convo8 begins." [color=orange];
		"RoatheRank4Convo8 begins." -> j917005897;
		"RoatheRank4Convo8 begins." -> j1350559949;
	j917005897 [label="羅瑟，你的童年是什麼樣的？",shape=box,color=red];
		j917005897 -> j3241512031;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j3241512031 [label="嗯？一個有趣的問題。它是「什麼樣的」？說實話，我不太記得。那些承載著回憶的恆星和雕塑，我想，現在大概早就化為塵土，或被煉成內融核心了吧。",shape=box,color=blue];
		j3241512031 -> j2545325442;
	"Chat ends." [color=orange];
	j2545325442 [label="我恐怕只能回憶起最零碎的片段，因為那已經是極其久遠的事了。我時常懷疑，大部分的回憶是否像一場夢一樣，是我自己想像出來的，或者，我只是將在歷史書上讀到的事件附會上了畫面。",shape=box,color=blue];
		j2545325442 -> j3020402703;
	j3020402703 [label="因此，我承認，我能回憶起來的內容很可能是極度不可靠的。你為什麼要問這個？",shape=box,color=blue];
		j3020402703 -> j1149366625;
		j3020402703 -> j2732251737;
		j3020402703 -> j205551785;
	j1149366625 [label="即使這些故事是虛假的，它們仍然是你對自己成長歲月的故事。它們仍然值得知曉。",shape=box,color=red];
		j1149366625 -> j3938992576;
	j2732251737 [label="我很好奇作為 Orokin 貴族成長是什麼感覺。",shape=box,color=red];
		j2732251737 -> j2551546879;
	j205551785 [label="我想知道是什麼造就了「你」。你是怎麼變成現在這個樣子的。",shape=box,color=red];
		j205551785 -> j3027315194;
	j3938992576 [label="+5 Chemistry",color=orange];
		j3938992576 -> j3252038757;
	j2551546879 [label="我從小就被送到了那些狂熱分子所謂的「寄宿學校」，就像所有註定要成就一番事業的 Orokin 青年一樣。在那裡，我接受了傾向和資質的測試與訓練。",shape=box,color=blue];
		j2551546879 -> j1282087485;
		j2551546879 -> j3852999750;
	j3027315194 [label="+5 Chemistry",color=orange];
		j3027315194 -> j872440496;
	j3252038757 [label="我同意，我們對自己撒的謊往往比真相重要。篡位者，真是精闢的見解。",shape=box,color=blue];
		j3252038757 -> j3966414031;
	j1282087485 [label="你的父母就這樣把你送走了嗎？送走了多久？",shape=box,color=red];
		j1282087485 -> j3746362655;
	j3852999750 [label="那裡是什麼樣的？",shape=box,color=red];
		j3852999750 -> j3408410981;
	j872440496 [label="你是在試著找出我到底在哪裡出了「問題」嗎？我明白了！真夠好笑的。我可不覺得你能在我的童年裡找到任何解答。",shape=box,color=blue];
		j872440496 -> j959378372;
	j3966414031 [label="Add -1 to Thermostat counter",color=orange];
		j3966414031 -> j2551546879;
	j3746362655 [label="我的整個少年時期。我想我再也沒有見過那兩個生下我的人。或許在我被宣布為年級第一的儀式上有見過吧？",shape=box,color=blue];
		j3746362655 -> j1836835767;
	j3408410981 [label="我認為這個問題會因人而異，意見也可能大不相同。剛到的時候，那些高年級的男生打我毫不留情，教訓也極為殘酷有效。",shape=box,color=blue];
		j3408410981 -> j2726427806;
	j959378372 [label="Add 1 to Thermostat counter",color=orange];
		j959378372 -> j2551546879;
	j1836835767 [label="我相信那是他們第一次聲稱擁有我的所有權。我不太在意。",shape=box,color=blue];
		j1836835767 -> j3426784073;
	j2726427806 [label="但我學習能力很強，所有事都能很快上手。我明白，如果我想在探研的這個特定領域有所建樹，最好運用創意十足的技巧，以免淪為平庸之輩。",shape=box,color=blue];
		j2726427806 -> j1736834343;
		j2726427806 -> j3058692090;
	j3426784073 [label="我對父母的記憶不多。雖然有些 Orokin 熱衷於撫養自己的後代，但我的父母卻並非如此。他們急於擺脫我，開始他們自己的生活。",shape=box,color=blue];
		j3426784073 -> j3490482055;
		j3426784073 -> j814466231;
	j1736834343 [label="哲士竟然允許這種事情發生？",shape=box,color=red];
		j1736834343 -> j250599348;
	j3058692090 [label="那……真可怕。",shape=box,color=red];
		j3058692090 -> j3882309627;
	j3490482055 [label="這似乎並沒有阻檔你人生的發展。",shape=box,color=red];
		j3490482055 -> j1588093850;
	j814466231 [label="很抱歉。這似乎很悲慘。",shape=box,color=red];
		j814466231 -> j1588093850;
	j250599348 [label="我可憐的篡位者，那天晚上一位新學員鬧得太過火了，是校長親自拿來一瓶赤毒和一個男僕。",shape=box,color=blue];
		j250599348 -> j1883457548;
	j3882309627 [label="篡位者，傳統是個強大的工具。一件強大而危險的工具，能讓許多理智的人陷入瘋狂的思考模式。",shape=box,color=blue];
		j3882309627 -> j687606416;
	j1588093850 [label="剛剛相反。由於缺乏家庭牽絆，我有更多的時間投入那些在同儕看來過時的軍事戰略中。 ",shape=box,color=blue];
		j1588093850 -> j4025660718;
	j1883457548 [label="傳統是個強大的工具。一件強大而危險的工具，能讓許多理智的人陷入瘋狂的思考模式。",shape=box,color=blue];
		j1883457548 -> j3594222769;
		j1883457548 -> j2273745329;
	j687606416 [label="那天晚上一位新學員鬧得太過火了，是校長親自拿來一瓶赤毒和一個男僕。",shape=box,color=blue];
		j687606416 -> j3594222769;
		j687606416 -> j2273745329;
	j4025660718 [label="他們當時並不知道這件事以後會對我幫助有多大。",shape=box,color=blue];
		j4025660718 -> j3816967863;
		j4025660718 -> j3052675945;
	j3594222769 [label="那你的父母呢？",shape=box,color=red];
		j3594222769 -> j3426784073;
	j2273745329 [label="你在那裏有朋友嗎？",shape=box,color=red];
		j2273745329 -> j3262669312;
	j3816967863 [label="值得嗎，你覺得？",shape=box,color=red];
		j3816967863 -> j1094077043;
	j3052675945 [label="可是，你似乎過著孤獨的生活。",shape=box,color=red];
		j3052675945 -> j1479508516;
	j3262669312 [label="不，我一直獨來獨往。我明白，恐懼很容易製造，也容易被他人利用，但它就像一層脆弱的冰，一碰到陽光便會融化。",shape=box,color=blue];
		j3262669312 -> j3686929653;
	j1094077043 [label="我的同儕當時並不知道這些學習經驗會在未來對我產生多大的幫助。不過如果你問的是最終是得是失呢？",shape=box,color=blue];
		j1094077043 -> j1036293018;
	j1479508516 [label="是，我是。但這就是過著魔鬼般生活的必然結果，不是嗎？即使在那時，人們一是把我視為無權無勢的二流貨色和情人，或是把我視為嗜血的軍閥和橫衝直撞的怪物。",shape=box,color=blue];
		j1479508516 -> j1568230517;
	j3686929653 [label="怪物一定要被關在黑暗中。如果我要一直保持危險的氣息，那就只能獨來獨往。",shape=box,color=blue];
		j3686929653 -> j3490482055;
		j3686929653 -> j814466231;
	j1036293018 [label="嗯。我不知道。",shape=box,color=blue];
		j1036293018 -> j3607493349;
		j1036293018 -> j3725060809;
	j1568230517 [label="我既不受地位高於我的人歡迎，也不受地位低於我的人歡迎。而且，我也沒有真正意義上的同胞。",shape=box,color=blue];
		j1568230517 -> j299591844;
	j3607493349 [label="你還有一次機會彌補你所做的一切。他們沒有。 ",shape=box,color=red];
		j3607493349 -> j3493305610;
	j3725060809 [label="那，他們都死了但你還活著。所以我想是的，確實是。",shape=box,color=red];
		j3725060809 -> j1201476715;
	j299591844 [label="Boolean RoatheUnloved2 is now true.",color=orange];
		j299591844 -> j3607493349;
		j299591844 -> j3374793864;
	j3493305610 [label="Add 1 to Thermostat counter",color=orange];
		j3493305610 -> j413434966;
	j1201476715 [label="Add -1 to Thermostat counter",color=orange];
		j1201476715 -> j413434966;
	j3374793864 [label="至少你還有很長的未來，可以自己決定如何過。他們沒有。",shape=box,color=red];
		j3374793864 -> j1201476715;
	j413434966 [label="+5 Chemistry",color=orange];
		j413434966 -> j2644626194;
	j2644626194 [label="我想我們很快就會知道了。不是嗎？",shape=box,color=blue];
		j2644626194 -> "Chat ends.";
}