digraph {
	1042 [label="RoatheRank2Convo3 begins.",color=orange];
		1042 -> 1043;
	1043 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		1043 -> 1044 [label=true,color=green];
		1043 -> 1045 [label=false,color=brown];
	1044 [label="Check boolean RoatheKnowsReset2",color=orange];
		1044 -> 1046 [label=true,color=green];
		1044 -> 1047 [label=false,color=brown];
	1045 [label="Chat ends.",color=orange];
	1046 [label="我知道你八成早就聽過了。但我今天懶得管那麼多——我沒耐心了。",shape=box,color=blue];
		1046 -> 1047;
	1047 [label="我認為，導致 Orokin 帝國覆滅的，是玻璃層太多。",shape=box,color=blue];
		1047 -> 1048;
		1047 -> 1049;
		1047 -> 1050;
	1048 [label="怎麼說？",shape=box,color=red];
		1048 -> 1051;
	1049 [label="太沒人情味了？",shape=box,color=red];
		1049 -> 1052;
	1050 [label="[結束]",shape=box,color=red];
		1050 -> 1053;
	1051 [label="想像一個社會，一個建立在你將永遠安全無虞這種信念之上的社會。你總被庇護著，甚至連死亡本身都拿你沒辦法。",shape=box,color=blue];
		1051 -> 1054;
	1052 [label="+5 Chemistry",color=orange];
		1052 -> 1055;
	1053 [label="Chat ends.",color=orange];
	1054 [label="一個沒有任何東西能傷害你的地方。",shape=box,color=blue];
		1054 -> 1056;
	1055 [label="確實。與危險和現實過於脫離。",shape=box,color=blue];
		1055 -> 1051;
	1056 [label="這會導致一種無聊，而這種無聊會滋生出各種自己找死的玩法。政治。宮廷鬥爭。突然間，我們就開始發明各種全新的、高明的作死方法，因為我們已經消滅了舊有的威脅。",shape=box,color=blue];
		1056 -> 1057;
		1056 -> 1058;
	1057 [label="怎麼突然提到這個？",shape=box,color=red];
		1057 -> 1059;
	1058 [label="哪樣更糟？是當靶子，還是擔心被捅刀？",shape=box,color=red];
		1058 -> 1060;
	1059 [label="我那趟……被迫待在「高盧」的日子，有趣或愉快的部分真是少得可憐。食物 是其中之一。而第二個……則是那些風暴。",shape=box,color=blue];
		1059 -> 1061;
	1060 [label="哈哈！恐怕我很難說我比較喜歡哪一種，因為我兩種技藝我都經驗豐富。你呢？",shape=box,color=blue];
		1060 -> 1062;
		1060 -> 1063;
	1061 [label="那種雷暴，我作為 Orokin 了這麼多年從沒見過。它們撼動大地，把那些木窗框震得嘎嘎作響。就連我待在那個關押我們的、滿是灰塵的墓穴裡都能聽到。",shape=box,color=blue];
		1061 -> 1064;
	1062 [label="我喜歡明明白白地知道我的敵人是誰。歡迎他們光明正大地朝我開火。",shape=box,color=red];
		1062 -> 1065;
	1063 [label="當靶子。我寧願在幕後牽線把事情搞定。我有的是時間。",shape=box,color=red];
		1063 -> 1066;
	1064 [label="每當風暴席捲那座城市，我都會爬上鐘樓，盡我所能地靠近。我想要感受空氣中的電流，想要感受那種被暴雨拍打在皮膚上的感覺。",shape=box,color=blue];
		1064 -> 1067;
		1064 -> 1068;
		1064 -> 1069;
	1065 [label="Add 1 to Thermostat",color=orange];
		1065 -> 1070;
	1066 [label="Add -1 to Thermostat",color=orange];
		1066 -> 1071;
	1067 [label="那樣做不會有點危險嗎？",shape=box,color=red];
		1067 -> 1072;
	1068 [label="那聽起來真棒。",shape=box,color=red];
		1068 -> 1073;
	1069 [label="那瑪麗和里昂對你偷溜出去有什麼感想？",shape=box,color=red];
		1069 -> 1074;
	1070 [label="我明白你的意思。我也得承認，那確實有種單純的樂趣。不過當敵人拿槍指著你的臉時，你很難把他錯認成別的東西。",shape=box,color=blue];
		1070 -> 1075;
	1071 [label="嗯，很美妙，不是嗎？一個謹慎的計劃，一個巧妙的佈局，然後看著它一一實現。看著所有的棋子各就各位……實在妙趣橫生。",shape=box,color=blue];
		1071 -> 1075;
	1072 [label="那正是我幹那件事的重點！我無法形容感受到那種最原始的力量是一種怎樣的感覺。不，不只是那樣；那是真正的力量。我凝視著那些充滿狂怒閃電的烏雲，我看到了我的祖先拼命想要駕馭的東西。",shape=box,color=blue];
		1072 -> 1076;
	1073 [label="+5 Chemistry",color=orange];
		1073 -> 1077;
	1074 [label="你這樣問，好像我還在乎過他們的想法似的。他們沒有跟著我，如果這是你想知道的。但我敢說，那位神父根本不在乎我是不是會被閃電劈死。至於瑪麗？她 大概正忙著崇拜她的假神呢。太陽或阿爾布雷希特，你隨便挑一個。",shape=box,color=blue];
		1074 -> 1078;
	1075 [label="+5 Chemistry",color=orange];
		1075 -> 1079;
	1076 [label="而且，我知道我 待在那裡 也可能會死，而且附近也沒有赤毒來復活我。更何況那神聖的赤毒對我這副扭曲變形的身軀也沒用。",shape=box,color=blue];
		1076 -> 1080;
	1077 [label="沒錯！我無法形容感受到那種最原始的力量是一種怎樣的感覺。不，不只是那樣；那是真正的力量。我凝視著那些充滿狂怒閃電的烏雲，我看到了我的祖先拼命想要駕馭的東西。",shape=box,color=blue];
		1077 -> 1076;
	1078 [label="但只是感受到那種最原始的力量？不，不只是那樣；那是真正的力量。我凝視著那些充滿狂怒閃電的烏雲，我看到了我的祖先拼命想要駕馭的東西。",shape=box,color=blue];
		1078 -> 1076;
	1079 [label="不過我發現，如同世間所有事物一樣，成功的答案總藏在於中庸與兼容之中。若過於沉溺於其中一方，便難免放棄了另一方。",shape=box,color=blue];
		1079 -> 1081;
	1080 [label="它讓我感到恐懼。漂泊者，我感受到了恐懼。恐懼。這也許是我幾百年來的……第一次？",shape=box,color=blue];
		1080 -> 1082;
		1080 -> 1083;
	1081 [label="恐怕我們就是這樣創造出 Ballas 和 Nitokh 這種生物的。一個是操縱者，另一個是鮮血女王。呸。",shape=box,color=blue];
		1081 -> 1084;
	1082 [label="你怕死？",shape=box,color=red];
		1082 -> 1085;
	1083 [label="那你怎麼做？",shape=box,color=red];
		1083 -> 1086;
	1084 [label="但我來這裡是為了談風暴的。",shape=box,color=blue];
		1084 -> 1059;
	1085 [label="是的，看來就是這樣！而且，容我補充一下，那種感受非常強烈。我在那一刻才發現。漂泊者，我不怕死。我只是還不想死。我還沒玩夠。",shape=box,color=blue];
		1085 -> 1087;
	1086 [label="我爬上了石欄杆，就在那個扭曲的石像鬼旁邊，我伸開雙臂……我笑了。我對著風暴大笑。",shape=box,color=blue];
		1086 -> 1088;
	1087 [label="這本身就是一種頓悟。我爬上了石欄杆，就在那個扭曲的石像鬼旁邊，我伸開雙臂……我笑了。我對著風暴大笑。",shape=box,color=blue];
		1087 -> 1089;
	1088 [label="因為我突然明白，我不怕死，漂泊者。我只是還不想死。我還沒活夠。",shape=box,color=blue];
		1088 -> 1089;
	1089 [label="儘管發生了這一切。儘管 Tau 已成荒蕪。儘管 Orokin 帝國迎來了不可避免的毀滅。儘管我的身體被扭曲成了… 這副模樣。儘管我被拋棄被丟進過去，在那裡自生自滅。",shape=box,color=blue];
		1089 -> 1090;
	1090 [label="我知道我會找到路回來的。回到這個時間。這個地方。回到阿爾布雷希特留下他所有最珍貴的東西的地方。",shape=box,color=blue];
		1090 -> 1091;
	1091 [label="+5 Chemistry",color=orange];
		1091 -> 1092;
	1092 [label="因為我還沒活夠。但是我對虛空發誓，我會確保他活夠了。",shape=box,color=blue];
		1092 -> 1093;
	1093 [label="Update boolean RoatheEntrati1",color=orange];
		1093 -> 1094;
	1094 [label="Chat ends.",color=orange];
}