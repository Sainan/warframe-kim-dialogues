digraph {
	graph [fontname="Roboto Condensed"];
	node [fontname="Roboto Condensed"];
	edge [fontname="Roboto Condensed"];

	"RoatheRank2Convo3 begins." [color=orange];
		"RoatheRank2Convo3 begins." -> j4208251187;
	j4208251187 [label="Check boolean RoatheRank2Convo1Complete",color=orange];
		j4208251187 -> j3438455715 [label=true,color=green];
		j4208251187 -> "Chat ends." [label=false,color=brown];
	j3438455715 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3438455715 -> j3288828272 [label=true,color=green];
		j3438455715 -> j2564031889 [label=false,color=brown];
	"Chat ends." [color=orange];
	j3288828272 [label="我知道你八成早就聽過了。但我今天懶得管那麼多——我沒耐心了。",shape=box,color=blue];
		j3288828272 -> j2564031889;
	j2564031889 [label="我認為，導致 Orokin 帝國覆滅的，是玻璃層太多。",shape=box,color=blue];
		j2564031889 -> j2488726800;
		j2564031889 -> j2140511423;
		j2564031889 -> j1350559949;
	j2488726800 [label="怎麼說？",shape=box,color=red];
		j2488726800 -> j2054020720;
	j2140511423 [label="太沒人情味了？",shape=box,color=red];
		j2140511423 -> j1513190033;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j2054020720 [label="想像一個社會，一個建立在你將永遠安全無虞這種信念之上的社會。你總被庇護著，甚至連死亡本身都拿你沒辦法。",shape=box,color=blue];
		j2054020720 -> j675706941;
	j1513190033 [label="+5 Chemistry",color=orange];
		j1513190033 -> j677216;
	j675706941 [label="一個沒有任何東西能傷害你的地方。",shape=box,color=blue];
		j675706941 -> j1462037394;
	j677216 [label="確實。與危險和現實過於脫離。",shape=box,color=blue];
		j677216 -> j2054020720;
	j1462037394 [label="這會導致一種無聊，而這種無聊會滋生出各種自己找死的玩法。政治。宮廷鬥爭。突然間，我們就開始發明各種全新的、高明的作死方法，因為我們已經消滅了舊有的威脅。",shape=box,color=blue];
		j1462037394 -> j1527792749;
		j1462037394 -> j3366232085;
	j1527792749 [label="怎麼突然提到這個？",shape=box,color=red];
		j1527792749 -> j302592055;
	j3366232085 [label="哪樣更糟？是當靶子，還是擔心被捅刀？",shape=box,color=red];
		j3366232085 -> j1300041659;
	j302592055 [label="我那趟……被迫待在「高盧」的日子，有趣或愉快的部分真是少得可憐。食物 是其中之一。而第二個……則是那些風暴。",shape=box,color=blue];
		j302592055 -> j4187098974;
	j1300041659 [label="哈哈！恐怕我很難說我比較喜歡哪一種，因為我兩種技藝我都經驗豐富。你呢？",shape=box,color=blue];
		j1300041659 -> j3331883670;
		j1300041659 -> j3281936814;
	j4187098974 [label="那種雷暴，我作為 Orokin 了這麼多年從沒見過。它們撼動大地，把那些木窗框震得嘎嘎作響。就連我待在那個關押我們的、滿是灰塵的墓穴裡都能聽到。",shape=box,color=blue];
		j4187098974 -> j1620598532;
	j3331883670 [label="我喜歡明明白白地知道我的敵人是誰。歡迎他們光明正大地朝我開火。",shape=box,color=red];
		j3331883670 -> j1564441377;
	j3281936814 [label="當靶子。我寧願在幕後牽線把事情搞定。我有的是時間。",shape=box,color=red];
		j3281936814 -> j3160044141;
	j1620598532 [label="每當風暴席捲那座城市，我都會爬上鐘樓，盡我所能地靠近。我想要感受空氣中的電流，想要感受那種被暴雨拍打在皮膚上的感覺。",shape=box,color=blue];
		j1620598532 -> j1830591581;
		j1620598532 -> j279724872;
		j1620598532 -> j3884487282;
	j1564441377 [label="Add 1 to Thermostat counter",color=orange];
		j1564441377 -> j2425471313;
	j3160044141 [label="Add -1 to Thermostat counter",color=orange];
		j3160044141 -> j1520116592;
	j1830591581 [label="那樣做不會有點危險嗎？",shape=box,color=red];
		j1830591581 -> j4215466152;
	j279724872 [label="那聽起來真棒。",shape=box,color=red];
		j279724872 -> j554927963;
	j3884487282 [label="那瑪麗和里昂對你偷溜出去有什麼感想？",shape=box,color=red];
		j3884487282 -> j1326592134;
	j2425471313 [label="我明白你的意思。我也得承認，那確實有種單純的樂趣。不過當敵人拿槍指著你的臉時，你很難把他錯認成別的東西。",shape=box,color=blue];
		j2425471313 -> j1155774959;
	j1520116592 [label="嗯，很美妙，不是嗎？一個謹慎的計劃，一個巧妙的佈局，然後看著它一一實現。看著所有的棋子各就各位……實在妙趣橫生。",shape=box,color=blue];
		j1520116592 -> j1155774959;
	j4215466152 [label="那正是我幹那件事的重點！我無法形容感受到那種最原始的力量是一種怎樣的感覺。不，不只是那樣；那是真正的力量。我凝視著那些充滿狂怒閃電的烏雲，我看到了我的祖先拼命想要駕馭的東西。",shape=box,color=blue];
		j4215466152 -> j3421111488;
	j554927963 [label="+5 Chemistry",color=orange];
		j554927963 -> j1399537745;
	j1326592134 [label="你這樣問，好像我還在乎過他們的想法似的。他們沒有跟著我，如果這是你想知道的。但我敢說，那位神父根本不在乎我是不是會被閃電劈死。至於瑪麗？她 大概正忙著崇拜她的假神呢。太陽或阿爾布雷希特，你隨便挑一個。",shape=box,color=blue];
		j1326592134 -> j3995257650;
	j1155774959 [label="+5 Chemistry",color=orange];
		j1155774959 -> j2265192784;
	j3421111488 [label="而且，我知道我 待在那裡 也可能會死，而且附近也沒有赤毒來復活我。更何況那神聖的赤毒對我這副扭曲變形的身軀也沒用。",shape=box,color=blue];
		j3421111488 -> j2987648402;
	j1399537745 [label="沒錯！我無法形容感受到那種最原始的力量是一種怎樣的感覺。不，不只是那樣；那是真正的力量。我凝視著那些充滿狂怒閃電的烏雲，我看到了我的祖先拼命想要駕馭的東西。",shape=box,color=blue];
		j1399537745 -> j3421111488;
	j3995257650 [label="但只是感受到那種最原始的力量？不，不只是那樣；那是真正的力量。我凝視著那些充滿狂怒閃電的烏雲，我看到了我的祖先拼命想要駕馭的東西。",shape=box,color=blue];
		j3995257650 -> j3421111488;
	j2265192784 [label="不過我發現，如同世間所有事物一樣，成功的答案總藏在於中庸與兼容之中。若過於沉溺於其中一方，便難免放棄了另一方。",shape=box,color=blue];
		j2265192784 -> j1087505607;
	j2987648402 [label="它讓我感到恐懼。漂泊者，我感受到了恐懼。恐懼。這也許是我幾百年來的……第一次？",shape=box,color=blue];
		j2987648402 -> j3346505938;
		j2987648402 -> j4244971553;
	j1087505607 [label="恐怕我們就是這樣創造出 Ballas 和 Nitokh 這種生物的。一個是操縱者，另一個是鮮血女王。呸。",shape=box,color=blue];
		j1087505607 -> j1975479848;
	j3346505938 [label="你怕死？",shape=box,color=red];
		j3346505938 -> j4060023432;
	j4244971553 [label="那你怎麼做？",shape=box,color=red];
		j4244971553 -> j3353348903;
	j1975479848 [label="但我來這裡是為了談風暴的。",shape=box,color=blue];
		j1975479848 -> j302592055;
	j4060023432 [label="是的，看來就是這樣！而且，容我補充一下，那種感受非常強烈。我在那一刻才發現。漂泊者，我不怕死。我只是還不想死。我還沒玩夠。",shape=box,color=blue];
		j4060023432 -> j1143795534;
	j3353348903 [label="我爬上了石欄杆，就在那個扭曲的石像鬼旁邊，我伸開雙臂……我笑了。我對著風暴大笑。",shape=box,color=blue];
		j3353348903 -> j2757722968;
	j1143795534 [label="這本身就是一種頓悟。我爬上了石欄杆，就在那個扭曲的石像鬼旁邊，我伸開雙臂……我笑了。我對著風暴大笑。",shape=box,color=blue];
		j1143795534 -> j936540823;
	j2757722968 [label="因為我突然明白，我不怕死，漂泊者。我只是還不想死。我還沒活夠。",shape=box,color=blue];
		j2757722968 -> j936540823;
	j936540823 [label="儘管發生了這一切。儘管 Tau 已成荒蕪。儘管 Orokin 帝國迎來了不可避免的毀滅。儘管我的身體被扭曲成了… 這副模樣。儘管我被拋棄被丟進過去，在那裡自生自滅。",shape=box,color=blue];
		j936540823 -> j2636421991;
	j2636421991 [label="我知道我會找到路回來的。回到這個時間。這個地方。回到阿爾布雷希特留下他所有最珍貴的東西的地方。",shape=box,color=blue];
		j2636421991 -> j976320683;
	j976320683 [label="+5 Chemistry",color=orange];
		j976320683 -> j3859761388;
	j3859761388 [label="因為我還沒活夠。但是我對虛空發誓，我會確保他活夠了。",shape=box,color=blue];
		j3859761388 -> j3359792563;
	j3359792563 [label="Boolean RoatheEntrati1 is now true.",color=orange];
		j3359792563 -> "Chat ends.";
}