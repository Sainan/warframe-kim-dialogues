	j1603189464 [label="VM: TREASON",shape=box,color=blue];
		j1603189464 -> j235032877;
	j235032877 [label="文字記錄：「和平？」",shape=box,color=blue];
		j235032877 -> j3891778209;
	j3891778209 [label="Her voice was broken glass grinding in my ears.",shape=box,color=blue];
		j3891778209 -> j1394563427;
	j1394563427 [label="Executor Nitokh was displeased. She had expected a glorious escalation, battle after battle, ending in the climactic ecstasy of the Orokin’s demise.",shape=box,color=blue];
		j1394563427 -> j2208349936;
	j2208349936 [label="After which she would emerge from hiding and… well, there I am left to speculate. Perhaps she expected to be invited into the Sentients’ confidence.",shape=box,color=blue];
		j2208349936 -> j823123440;
	j823123440 [label="又或許她認為它們會放棄始源星系那被焚燒、污染的殘骸，讓她建立自己的新王國。",shape=box,color=blue];
		j823123440 -> j714831303;
	j714831303 [label="無論如何，和平絕不會被容忍。所以我們開始破壞它。",shape=box,color=blue];
		j714831303 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
