	j1543263881 [label="語音訊息：叛國",shape=box,color=blue];
		j1543263881 -> j200310415;
	j200310415 [label="文字記錄：「和平？」",shape=box,color=blue];
		j200310415 -> j952693342;
	j952693342 [label="她的聲音如同碎玻璃在我耳中研磨。",shape=box,color=blue];
		j952693342 -> j3066327075;
	j3066327075 [label="執行者 Nitokh 不悅了。她本期待光榮晉陞，一場接一場的戰役，以 Orokin 滅亡的高潮狂喜告終。",shape=box,color=blue];
		j3066327075 -> j2846112623;
	j2846112623 [label="之後她便會從藏身處現身……好吧，接下來的事我只能臆測了。或許她期待被邀請加入 Sentient 的信任圈。",shape=box,color=blue];
		j2846112623 -> j823123440;
	j823123440 [label="又或許她認為它們會放棄始源星系那被焚燒、污染的殘骸，讓她建立自己的新王國。",shape=box,color=blue];
		j823123440 -> j714831303;
	j714831303 [label="無論如何，和平絕不會被容忍。所以我們開始破壞它。",shape=box,color=blue];
		j714831303 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}