		j1433735716 -> j2859518231;
	j3666362610 [label="但我在騙誰呢？！我們都知道你為什麼這麼做，不是嗎？不是因為愛我。甚至根本與愛無關。我只是在無病呻吟罷了。",shape=box,color=blue];
