	"RoatheRank3Convo6 begins." [color=orange];
		"RoatheRank3Convo6 begins." -> j2358404320;
		"RoatheRank3Convo6 begins." -> j3771508939;
		"RoatheRank3Convo6 begins." -> j1350559949;
	j2358404320 [label="羅瑟，你為什麼花這麼多時間跟參研者待在一起？",shape=box,color=red];
		j2358404320 -> j2695662037;
	j3771508939 [label="離參研者遠點，羅瑟。它讓我感到不安。",shape=box,color=red];
		j3771508939 -> j3566685870;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j2695662037 [label="嗯？好吧，我認為他們是我在整個媽的始源星系裡，見過最可憐、最失敗的實驗品。",shape=box,color=blue];
		j2695662037 -> j1641662258;
	j3566685870 [label="為了盡可能避免誤解，我將收起我的長篇大論，簡潔地說：",shape=box,color=blue];
		j3566685870 -> j3161139075;
	"Chat ends." [color=orange];
	j1641662258 [label="實驗動物。阿爾布雷希特，實驗動物！你把動物扔進媽的虛空，然後當牠們出來，說著你編造的鬼話時，你叫你的管家去安樂死牠們？！",shape=box,color=blue];
		j1641662258 -> j4169797686;
	j3161139075 [label="不。",shape=box,color=blue];
		j3161139075 -> "Chat ends.";
	j4169797686 [label="總是把髒活留給別人做。但我離題了。你在問我為什麼坐在那裡和他們說話。尤其是那隻鳥。原因很簡單。但我想讓你猜猜。我想看看你能不能想出來。",shape=box,color=blue];
		j4169797686 -> j3453292709;
		j4169797686 -> j3213636347;
		j4169797686 -> j1943458240;
		j4169797686 -> j267879897;
		j4169797686 -> j2641005065;
	j3453292709 [label="他不知道你是誰。",shape=box,color=red];
		j3453292709 -> j854730646;
	j3213636347 [label="鳥三愛每一位。",shape=box,color=red];
		j3213636347 -> j1400552171;
	j1943458240 [label="你喜歡和那些讓你覺得自己很聰明的人在一起。",shape=box,color=red];
		j1943458240 -> j3202035561;
	j267879897 [label="他對身邊之人有極為敏銳的洞察。",shape=box,color=red];
		j267879897 -> j4265249962;
	j2641005065 [label="他極易受人擺佈。",shape=box,color=red];
		j2641005065 -> j3202035561;
	j854730646 [label="是的。某種程度上，確實如此。他不知道我是誰。他對「Tau 之惡魔」一無所知。而且他……更重要的是，他不在乎。",shape=box,color=blue];
		j854730646 -> j113173193;
	j1400552171 [label="確實。他那天真無邪的樣子相當迷人。但你是不是在換個更委婉、更繞口的方式說除了他，沒人會愛我，是這樣嗎？",shape=box,color=blue];
		j1400552171 -> j1013953926;
	j3202035561 [label="我希望你能明白你錯得有多離譜，你的箭射得離目標有多遠……但你並非唯一一個這樣看待我的人。",shape=box,color=blue];
		j3202035561 -> j2190149481;
	j4265249962 [label="確實如此。他的觀察很有價值，但這些觀點我自己也能在幾分鐘內就得出。",shape=box,color=blue];
		j4265249962 -> j3292830221;
	j113173193 [label="+10 Chemistry",color=orange];
		j113173193 -> j627400132;
	j1013953926 [label="所以我只能和這隻笨鳥作伴了？不過你說的也算接近真相了，我想我就給你……一個及格的分數吧。",shape=box,color=blue];
		j1013953926 -> j627400132;
	j2190149481 [label="絕對不是只有你。",shape=box,color=blue];
		j2190149481 -> j3705997063;
	j3292830221 [label="你是在用一種更和善、更婉轉的方式說，你認為我在利用那隻會說話的大鳥來達到我的目的？是這樣嗎？",shape=box,color=blue];
		j3292830221 -> j4145931202;
	j627400132 [label="對他來說，我不是羅瑟。我不是 Orokin。我不是罪犯。也不是叛徒。也不是懦夫。我只是……我自己。",shape=box,color=blue];
		j627400132 -> j2579707691;
	j3705997063 [label="Boolean RoatheAlone1 is now true.",color=orange];
		j3705997063 -> j4081414586;
	j4145931202 [label="不。但你的評價，很多人都這樣想。絕對不是只有你。",shape=box,color=blue];
		j4145931202 -> j3705997063;
	j2579707691 [label="我無法向你描述那種簡單又難得的解脫感……",shape=box,color=blue];
		j2579707691 -> j3830999064;
		j2579707691 -> j1559222614;
		j2579707691 -> j3359000109;
	j4081414586 [label="+5 Chemistry",color=orange];
		j4081414586 -> "Chat ends.";
	j3830999064 [label="你知道，你可以放下這一切。你可以改變。即使在這裡，即使是現在。",shape=box,color=red];
		j3830999064 -> j2582466208;
	j1559222614 [label="那一定是個沉重的負擔。無論走到哪裡，即使就在這裡，你都得承受人們對你名譽的期望。",shape=box,color=red];
		j1559222614 -> j2999786217;
	j3359000109 [label="你的意思是說，剩下的部分都是你精心策劃的一場表演嗎？",shape=box,color=red];
		j3359000109 -> j3249407288;
	j2582466208 [label="Add 2 to Thermostat counter",color=orange];
		j2582466208 -> j2929972768;
	j2999786217 [label="Add -1 to Thermostat counter",color=orange];
		j2999786217 -> j1703325214;
	j3249407288 [label="要是真這麼簡單就好了，要是這一切都只是我可以像變臉一樣換掉的巨大偽裝！不，篡位者。我就是這個樣子，從裡到外都爛透了。",shape=box,color=blue];
		j3249407288 -> j3615347839;
	j2929972768 [label="要是真這麼簡單就好了，篡位者。你把這一切說得如此誘人。我可以嗎？或許……或許還不算太晚，即使對我這樣一個悲慘的魔鬼來說也是如此。",shape=box,color=blue];
		j2929972768 -> j1160924323;
	j1703325214 [label="+10 Chemistry",color=orange];
		j1703325214 -> j2098285712;
	j3615347839 [label="但這並不意味著我不喜歡有機會放下一切，享受片刻與一個對我過去所有可怕罪行一無所知的人交談的機會。",shape=box,color=blue];
		j3615347839 -> j172570375;
	j1160924323 [label="+10 Chemistry",color=orange];
		j1160924323 -> j1172569887;
	j2098285712 [label="篡位者，這樣很累。我多麼希望我可以像變臉一樣換幅面放下這個人設，永遠不再戴上。但我就是這個樣子，從裡到外都爛透了。",shape=box,color=blue];
		j2098285712 -> j3615347839;
	j172570375 [label="Boolean RoatheBirdThree is now true.",color=orange];
		j172570375 -> j507677810;
		j172570375 -> j4067632510;
	j1172569887 [label="這只是一個我佩戴的巨大偽裝嗎？還是它已深入我腐爛的骨頭？我還不知道。我只能說，我仍然享受能暫時放下這一切的機會。",shape=box,color=blue];
		j1172569887 -> j200448785;
	j507677810 [label="如果這話聽起來冒犯了你，請見諒……但聽起來您的生活似乎很孤獨。",shape=box,color=red];
		j507677810 -> j2902082429;
	j4067632510 [label="你不太習慣有很多朋友，是嗎？",shape=box,color=red];
		j4067632510 -> j2539663690;
	j200448785 [label="我將重擔擱置一旁，與一個對我可怕罪行一無所知的人坐在一起，和那隻巨大、迷人卻又呆頭呆腦的鳥交談，然後發現自己……感到平靜。長久以來第一次。",shape=box,color=blue];
		j200448785 -> j377359950;
	j2902082429 [label="Evaluate expressions",color=orange];
		j2902082429 -> j1075245501 [label="RoatheUnloved1, RoatheKnowsReset2",color=purple];
		j2902082429 -> j192638702 [label="RoatheKnowsReset2",color=purple];
		j2902082429 -> j2990677513 [label="RoatheUnloved1",color=purple];
		j2902082429 -> j3034937558 [label="false",color=purple];
	j2539663690 [label="Check boolean RoatheKnowsReset2",color=orange];
		j2539663690 -> j3344118278 [label=true,color=green];
		j2539663690 -> j1437960886 [label=false,color=brown];
	j377359950 [label="或許你說的還有希望。又或許我只是在欺騙自己。這只是一個暫時的喘息。",shape=box,color=blue];
		j377359950 -> j172570375;
	j1075245501 [label="是的，它一直如此。至少在我能回憶的部分是。還是說，篡位者，那才是你從我這裡奪走的東西？我們曾是戀人，我向你告白，但你沒有同樣的感覺？",shape=box,color=blue];
		j1075245501 -> j3039545035;
	j192638702 [label="我承認，情況一直如此。至少在我能回憶的部分是。如果我告訴你我從未愛過人，你會感到震驚嗎？至少從未兩情相悅。或許你不會驚訝。畢竟，我們很可能以前已經談論過這一切了。",shape=box,color=blue];
		j192638702 -> j561748281;
	j2990677513 [label="它確實如此。漫長而孤單。但這都是我咎由自取的，篡位者。我來這裡不是為了博取你的同情或憐憫。",shape=box,color=blue];
		j2990677513 -> j3698287103;
	j3034937558 [label="我承認確實如此。至少就我記憶所及而言如是。如果我告訴你我從未真正戀愛過，你會不會感到震驚？但這都是我咎由自取的，篡位者。我來這裡不是為了博取你的同情或憐憫。",shape=box,color=blue];
		j3034937558 -> j2587717783;
	j3344118278 [label="誰知道呢？也許我曾經有朋友，你我是朋友，而你選擇結束那段關係，所以我根本記不起了，嗯？",shape=box,color=blue];
		j3344118278 -> j383679544;
	j1437960886 [label="誰知道呢？或許我曾經有朋友，但我只是不記得了，因為源拓氏在我的腦袋裡攪動，奪走了我關於他們的記憶。",shape=box,color=blue];
		j1437960886 -> j383679544;
	j3039545035 [label="還是恰恰相反？你瘋狂地愛上了惡魔本人，但他的心對你依然冷漠。心煩意亂之下，你做了唯一能做的事——你把他的心智撕成了碎片！",shape=box,color=blue];
		j3039545035 -> j3361283050;
