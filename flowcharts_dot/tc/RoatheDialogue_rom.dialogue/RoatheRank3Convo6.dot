		2118 -> 2121 [label="false",color=purple];
	2117 [label="我想知道，那是不是你從我這裡奪走的東西，篡位者？我們曾是戀人，我向你告白，但你沒有同樣的感覺？",shape=box,color=blue];
		2117 -> 2113;
	2116 [label="無論你對我形成了多麼糟糕的看法，我都罪有應得。而且持有這種看法的絕對不只你一個。你一點也不孤單。",shape=box,color=blue];
		2116 -> 2120;
	2115 [label="Update boolean RoatheAlone1",color=orange];
		2115 -> 2116;
	2119 [label="Chat ends.",color=orange];
	2124 [label="確實很悲哀……我幾乎想知道所有細節，但我覺得那樣就等於在我們還沒準備好之前就跳到書的結尾。",shape=box,color=blue];
		2124 -> 2125;
	2123 [label="但我在騙誰呢？！我們都知道你為什麼這麼做，不是嗎？不是因為愛我。而是因為愛著另一個人。我只是在無病呻吟罷了。",shape=box,color=blue];
		2123 -> 2125;
	2122 [label="但我在騙誰呢？！我們都知道你為什麼這麼做，不是嗎？不是因為愛我。甚至根本與愛無關。我只是在無病呻吟罷了。",shape=box,color=blue];
		2122 -> 2125;
	2121 [label="算了。但坐在這裡說這些廢話有什麼用？",shape=box,color=blue];
		2121 -> 2125;
	2120 [label="Chat ends.",color=orange];
	2125 [label="但我來這裡不是為了博取你的同情或憐憫。這都是我咎由自取。無論你對我形成了多麼糟糕的看法，我都罪有應得。而且持有這種看法的絕對不只你一個。",shape=box,color=blue];
