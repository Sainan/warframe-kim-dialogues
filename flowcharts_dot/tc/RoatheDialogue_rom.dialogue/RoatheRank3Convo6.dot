digraph {
	2049 [label="RoatheRank3Convo6 begins.",color=orange];
		2049 -> 2052;
		2049 -> 2050;
		2049 -> 2051;
	2052 [label="羅瑟，你為什麼花這麼多時間跟參研者待在一起？",shape=box,color=red];
		2052 -> 2055;
	2050 [label="離參研者遠點，羅瑟。它讓我感到不安。",shape=box,color=red];
		2050 -> 2053;
	2051 [label="[結束]",shape=box,color=red];
		2051 -> 2054;
	2055 [label="嗯？好吧，我認為他們是我在整個媽的始源星系裡，見過最可憐、最失敗的實驗品。",shape=box,color=blue];
		2055 -> 2057;
	2053 [label="為了盡可能避免誤解，我將收起我的長篇大論，簡潔地說：",shape=box,color=blue];
		2053 -> 2056;
	2054 [label="Chat ends.",color=orange];
	2057 [label="實驗動物。阿爾布雷希特，實驗動物！你把動物扔進媽的虛空，然後當牠們出來，說著你編造的鬼話時，你叫你的管家去安樂死牠們？！",shape=box,color=blue];
		2057 -> 2059;
	2056 [label="不。",shape=box,color=blue];
		2056 -> 2058;
	2059 [label="總是把髒活留給別人做。但我離題了。你在問我為什麼坐在那裡和他們說話。尤其是那隻鳥。原因很簡單。但我想讓你猜猜。我想看看你能不能想出來。",shape=box,color=blue];
		2059 -> 2060;
		2059 -> 2061;
		2059 -> 2062;
		2059 -> 2063;
		2059 -> 2064;
	2058 [label="Chat ends.",color=orange];
	2060 [label="他不知道你是誰。",shape=box,color=red];
		2060 -> 2065;
	2061 [label="鳥三愛每一位。",shape=box,color=red];
		2061 -> 2066;
	2062 [label="你喜歡和那些讓你覺得自己很聰明的人在一起。",shape=box,color=red];
		2062 -> 2067;
	2063 [label="他對身邊之人有極為敏銳的洞察。",shape=box,color=red];
		2063 -> 2068;
	2064 [label="他極易受人擺佈。",shape=box,color=red];
		2064 -> 2069;
	2065 [label="是的。某種程度上，確實如此。他不知道我是誰。他對「Tau 之惡魔」一無所知。而且他……更重要的是，他不在乎。",shape=box,color=blue];
		2065 -> 2070;
	2066 [label="確實。他那天真無邪的樣子相當迷人。但你是不是在換個更委婉、更繞口的方式說除了他，沒人會愛我，是這樣嗎？",shape=box,color=blue];
		2066 -> 2071;
	2067 [label="我希望你能明白你錯得有多離譜，你的箭射得離目標有多遠……但你並非唯一一個這樣看待我的人。",shape=box,color=blue];
		2067 -> 2072;
	2068 [label="確實如此。他的觀察很有價值，但這些觀點我自己也能在幾分鐘內就得出。",shape=box,color=blue];
		2068 -> 2073;
	2069 [label="我希望你能明白你錯得有多離譜，你的箭射得離目標有多遠……但你並非唯一一個這樣看待我的人。",shape=box,color=blue];
		2069 -> 2074;
	2070 [label="+10 Chemistry",color=orange];
		2070 -> 2075;
	2071 [label="所以我只能和這隻笨鳥作伴了？不過你說的也算接近真相了，我想我就給你……一個及格的分數吧。",shape=box,color=blue];
		2071 -> 2075;
	2072 [label="絕對不是只有你。",shape=box,color=blue];
		2072 -> 2076;
	2073 [label="你是在用一種更和善、更婉轉的方式說，你認為我在利用那隻會說話的大鳥來達到我的目的？是這樣嗎？",shape=box,color=blue];
		2073 -> 2077;
	2074 [label="絕對不是只有你。",shape=box,color=blue];
		2074 -> 2078;
	2075 [label="對他來說，我不是羅瑟。我不是 Orokin。我不是罪犯。也不是叛徒。也不是懦夫。我只是……我自己。",shape=box,color=blue];
		2075 -> 2079;
	2076 [label="Update boolean RoatheAlone1",color=orange];
		2076 -> 2080;
	2077 [label="不。但你的評價，很多人都這樣想。絕對不是只有你。",shape=box,color=blue];
		2077 -> 2078;
	2078 [label="Update boolean RoatheAlone1",color=orange];
		2078 -> 2081;
	2079 [label="我無法向你描述那種簡單又難得的解脫感……",shape=box,color=blue];
		2079 -> 2082;
		2079 -> 2083;
		2079 -> 2084;
	2080 [label="+5 Chemistry",color=orange];
		2080 -> 2085;
	2081 [label="+5 Chemistry",color=orange];
		2081 -> 2086;
	2082 [label="你知道，你可以放下這一切。你可以改變。即使在這裡，即使是現在。",shape=box,color=red];
		2082 -> 2087;
	2083 [label="那一定是個沉重的負擔。無論走到哪裡，即使就在這裡，你都得承受人們對你名譽的期望。",shape=box,color=red];
		2083 -> 2088;
	2084 [label="你的意思是說，剩下的部分都是你精心策劃的一場表演嗎？",shape=box,color=red];
		2084 -> 2089;
	2085 [label="Chat ends.",color=orange];
	2086 [label="Chat ends.",color=orange];
	2087 [label="Add 2 to Thermostat",color=orange];
		2087 -> 2090;
	2088 [label="Add -1 to Thermostat",color=orange];
		2088 -> 2091;
	2089 [label="要是真這麼簡單就好了，要是這一切都只是我可以像變臉一樣換掉的巨大偽裝！不，篡位者。我就是這個樣子，從裡到外都爛透了。",shape=box,color=blue];
		2089 -> 2092;
	2090 [label="要是真這麼簡單就好了，篡位者。你把這一切說得如此誘人。我可以嗎？或許……或許還不算太晚，即使對我這樣一個悲慘的魔鬼來說也是如此。",shape=box,color=blue];
		2090 -> 2093;
	2091 [label="+10 Chemistry",color=orange];
		2091 -> 2094;
	2092 [label="但這並不意味著我不喜歡有機會放下一切，享受片刻與一個對我過去所有可怕罪行一無所知的人交談的機會。",shape=box,color=blue];
		2092 -> 2095;
	2093 [label="+10 Chemistry",color=orange];
		2093 -> 2096;
	2094 [label="篡位者，這樣很累。我多麼希望我可以像變臉一樣換幅面放下這個人設，永遠不再戴上。但我就是這個樣子，從裡到外都爛透了。",shape=box,color=blue];
		2094 -> 2092;
	2095 [label="Update boolean RoatheBirdThree",color=orange];
		2095 -> 2097;
		2095 -> 2098;
	2096 [label="這只是一個我佩戴的巨大偽裝嗎？還是它已深入我腐爛的骨頭？我還不知道。我只能說，我仍然享受能暫時放下這一切的機會。",shape=box,color=blue];
		2096 -> 2099;
	2097 [label="如果這話聽起來冒犯了你，請見諒……但聽起來您的生活似乎很孤獨。",shape=box,color=red];
		2097 -> 2100;
	2098 [label="你不太習慣有很多朋友，是嗎？",shape=box,color=red];
		2098 -> 2101;
	2099 [label="我將重擔擱置一旁，與一個對我可怕罪行一無所知的人坐在一起，和那隻巨大、迷人卻又呆頭呆腦的鳥交談，然後發現自己……感到平靜。長久以來第一次。",shape=box,color=blue];
		2099 -> 2102;
	2100 [label="Evaluate expressions",color=orange];
		2100 -> 2106 [label="RoatheUnloved1, RoatheKnowsReset2",color=purple];
		2100 -> 2105 [label="RoatheKnowsReset2",color=purple];
		2100 -> 2104 [label="RoatheUnloved1",color=purple];
		2100 -> 2103 [label="false",color=purple];
	2101 [label="Check boolean RoatheKnowsReset2",color=orange];
		2101 -> 2108 [label=true,color=green];
		2101 -> 2107 [label=false,color=brown];
	2102 [label="或許你說的還有希望。又或許我只是在欺騙自己。這只是一個暫時的喘息。",shape=box,color=blue];
		2102 -> 2109;
	2106 [label="是的，它一直如此。至少在我能回憶的部分是。還是說，篡位者，那才是你從我這裡奪走的東西？我們曾是戀人，我向你告白，但你沒有同樣的感覺？",shape=box,color=blue];
		2106 -> 2113;
	2105 [label="我承認，情況一直如此。至少在我能回憶的部分是。如果我告訴你我從未愛過人，你會感到震驚嗎？至少從未兩情相悅。或許你不會驚訝。畢竟，我們很可能以前已經談論過這一切了。",shape=box,color=blue];
		2105 -> 2112;
	2104 [label="它確實如此。漫長而孤單。但這都是我咎由自取的，篡位者。我來這裡不是為了博取你的同情或憐憫。",shape=box,color=blue];
		2104 -> 2111;
	2103 [label="我承認確實如此。至少就我記憶所及而言如是。如果我告訴你我從未真正戀愛過，你會不會感到震驚？但這都是我咎由自取的，篡位者。我來這裡不是為了博取你的同情或憐憫。",shape=box,color=blue];
		2103 -> 2110;
	2108 [label="誰知道呢？也許我曾經有朋友，你我是朋友，而你選擇結束那段關係，所以我根本記不起了，嗯？",shape=box,color=blue];
		2108 -> 2114;
	2107 [label="誰知道呢？或許我曾經有朋友，但我只是不記得了，因為源拓氏在我的腦袋裡攪動，奪走了我關於他們的記憶。",shape=box,color=blue];
		2107 -> 2114;
	2109 [label="Update boolean RoatheBirdThree",color=orange];
		2109 -> 2097;
		2109 -> 2098;
	2113 [label="還是恰恰相反？你瘋狂地愛上了惡魔本人，但他的心對你依然冷漠。心煩意亂之下，你做了唯一能做的事——你把他的心智撕成了碎片！",shape=box,color=blue];
		2113 -> 2118;
	2112 [label="Update boolean RoatheUnloved1",color=orange];
		2112 -> 2117;
	2111 [label="Update boolean RoatheAlone1",color=orange];
		2111 -> 2116;
	2110 [label="Update boolean RoatheUnloved1",color=orange];
		2110 -> 2115;
	2114 [label="但這似乎並沒有為我帶來任何好處。",shape=box,color=blue];
		2114 -> 2119;
	2118 [label="Evaluate expressions",color=orange];
		2118 -> 2124 [label="RoatheDatingDeal",color=purple];
