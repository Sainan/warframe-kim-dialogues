	j1834864876 [label="我想知道，那是不是你從我這裡奪走的東西，篡位者？我們曾是戀人，我向你告白，但你沒有同樣的感覺？",shape=box,color=blue];
		j1834864876 -> j3039545035;
	j3351528683 [label="無論你對我形成了多麼糟糕的看法，我都罪有應得。而且持有這種看法的絕對不只你一個。你一點也不孤單。",shape=box,color=blue];
		j3351528683 -> "Chat ends.";
	j1649861122 [label="確實很悲哀……我幾乎想知道所有細節，但我覺得那樣就等於在我們還沒準備好之前就跳到書的結尾。",shape=box,color=blue];
