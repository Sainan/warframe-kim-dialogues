	j1947499047 [label="我要求你解決它。這是你的錯。我能感覺到，它在撕咬我，像一頭巨大的野獸。",shape=box,color=blue];
		j1947499047 -> j166115088;
	j296816708 [label="如果不承認這是歸功於你的幫助，那就太失禮了，親愛的。謝謝你。",shape=box,color=blue];
