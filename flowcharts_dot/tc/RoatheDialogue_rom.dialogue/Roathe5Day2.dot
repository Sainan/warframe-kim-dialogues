		j2171950327 -> j4097346351 [label=false,color=brown];
	j647879620 [label="無論你想要什麼，現在都別想得到。你最好就此作罷，讓我徹底忘記我們之間這段荒唐的經歷。",shape=box,color=blue];
		j647879620 -> j3968522555;
	j3995652144 [label="好吧，無論你想要什麼，現在都別想得到。你最好就此作罷，讓我徹底忘記我們之間這段荒唐的經歷。",shape=box,color=blue];
