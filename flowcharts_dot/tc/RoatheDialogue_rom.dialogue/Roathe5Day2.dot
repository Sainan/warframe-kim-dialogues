		j617454213 -> "Chat ends." [label="false",color=purple];
	j2467825564 [label="新的一天開始了，我發現自己正在為未來做規劃，這是……很長一段時間以來第一次。思考我如何能重塑我周圍的這個世界。思考我如何能運用我所知曉的。我這個人。我如何能更好地利用它。",shape=box,color=blue];
		j2467825564 -> j3984658869;
	j3686836256 [label="新的一天開始了，我發現自己正在為未來做規劃，這是……很長一段時間以來第一次。思考這對我來說意味著什麼，對我想要的東西意味著什麼，以及我希望如何重塑我的環境以適應我的需求。",shape=box,color=blue];
		j3686836256 -> j2558396776;
	j3175524417 [label="請問你到底在等什麼？我坐在這裡，對事件的回憶仍然完好無損。你曾給我你的承諾，說你會將它們從我的腦海中清除。",shape=box,color=blue];
		j3175524417 -> j492042730;
		j3175524417 -> j3658856230;
		j3175524417 -> j274798575;
	j627510060 [label="你下定決心了嗎？我是一個有耐性的魔鬼，但也是有限度的。你會將這些記憶從我的腦海中清除，還是想讓我繼續沉浸其中？",shape=box,color=blue];
		j627510060 -> j1825374387;
		j627510060 -> j617388142;
	j3686616726 [label="我們在這裡，我們也將留在這裡。在這個煉獄裡。我希望你喜歡這裡，因為我不認為我們能再前進一步了。",shape=box,color=blue];
		j3686616726 -> j2171950327;
	j1801947931 [label="什麼意思？",shape=box,color=red];
		j1801947931 -> j647879620;
	j1675946874 [label="這邊一點，那邊又一點？",shape=box,color=red];
		j1675946874 -> j3995652144;
	j334370529 [label="這一切都與你無關，羅瑟。從來都與你無關。",shape=box,color=red];
		j334370529 -> j2320439744;
	j495437001 [label="你這個蠢貨！你幹了什麼？！為什麼，為什麼要去那些明明不歡迎你的洞穴裡探索？！",shape=box,color=blue];
		j495437001 -> j1947499047;
	"Chat ends." [color=orange];
