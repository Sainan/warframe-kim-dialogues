		j1995298832 -> j82412358;
	j3924352802 [label="如果真是那樣，你完全可以再做一次。這就像你擁有取之不盡的天賦，不是嗎？",shape=box,color=blue];
		j3924352802 -> j82412358;
	j1763000453 [label="很有可能。我會把所有線索連結起來，然後怪你做了我沒讓你做的事。我相信你能挺過難關。",shape=box,color=blue];
		j1763000453 -> j82412358;
