		j2309856237 -> "Chat ends.";
	j2299019185 [label="即使這意味著我們將永遠被困在這個僵局中？你這可憐的、悲哀的篡位者……好。對魔鬼來說，煉獄總比地獄好，不是嗎？",shape=box,color=blue];
		j2299019185 -> j4115561371;
	j1221276887 [label="很好。快行動吧。我厭倦了腦子裡知道這些破事。",shape=box,color=blue];
		j1221276887 -> j378811769;
	j609781752 [label="儘管如此，這對你又有什麼關係？你已經從我這具空殼般的屍體上得到了所有你想要切除的東西。我的肋骨已經光禿禿、蒼白一片。",shape=box,color=blue];
		j609781752 -> j1776100240;
	j4097346351 [label="真悲哀，不是嗎？源拓氏家族的那些渣滓永遠不會知道，管家就這麼孤獨地躺在這裡，雙手緊緊地絞在一起，悲痛欲絕。",shape=box,color=blue];
		j4097346351 -> j1776100240;
	j3968522555 [label="如果你執意如此，那這將是你唯一的出路。如果你不在乎，那我也不在乎。隨你便。",shape=box,color=blue];
		j3968522555 -> j786587934;
	j166115088 [label="擺脫這個東西。擺脫這場瘟疫。把這些記憶從我腦子裡清掉。我知道你辦得到。用你那個天賦，現在就結束一切。",shape=box,color=blue];
