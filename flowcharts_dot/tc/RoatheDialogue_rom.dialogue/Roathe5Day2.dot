	j338536709 [label="Boolean IsDating is now false.",color=orange];
		j338536709 -> j4105266207;
	j2938517661 [label="別這麼憤憤不平，就算你現在意識到自己被我耍了也一樣。我明明已經把契約條款都告訴你了，卻從未明確說明我的條件。難道你沒注意到嗎？",shape=box,color=blue];
		j2938517661 -> j3430823225;
	j2560953564 [label="我明明已經把契約條款都告訴你了，卻從未明確說明我的條件。難道你沒注意到嗎？",shape=box,color=blue];
		j2560953564 -> j3430823225;
	j1440267218 [label="「我需要找個人幫我記錄回憶，並協助我釐清它們。差不多就是想找個臨時打雜。」",shape=box,color=blue];
		j1440267218 -> j4123769235;
	j2381353092 [label="我會直接認定你在說謊，這很可能會讓我對你的看法徹底崩塌。",shape=box,color=blue];
		j2381353092 -> j1277039787;
		j2381353092 -> j1805420292;
	j303735681 [label="每次我們交談時我都會忍不住想，我們踏上的這片土地，對你來說是熟悉還是陌生的？我只是在重複自己說過的話，還是會帶給你新的驚喜？",shape=box,color=blue];
		j303735681 -> j4254649692;
	j2774738703 [label="你履行了契約義務。現在我們來到了倒數第二個階段，必須敲定我們進攻策略的具體細節。",shape=box,color=blue];
		j2774738703 -> j287245405;
	j4105266207 [label="Boolean RoatheDating is now false.",color=orange];
		j4105266207 -> j733874391;
	j3430823225 [label="我只是告訴你你能從這項約定中得到什麼。我從來沒有說過你必須做什麼，也沒說過為什麼要這樣做才能得到它們。而你卻盲目地同意了。",shape=box,color=blue];
		j3430823225 -> j3390331244;
	j4123769235 [label="雖然你滿足了第一個標準「記錄我的回憶」，但你卻在第二個標準「協助我釐清它們」上徹底失敗。",shape=box,color=blue];
		j4123769235 -> j2229136557;
	j1277039787 [label="不。我不能這麼做。我不會這麼做。我們必須一起面對這個局面。難道我們不能好好談談嗎？",shape=box,color=red];
