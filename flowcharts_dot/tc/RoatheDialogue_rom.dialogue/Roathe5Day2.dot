	j1805420292 [label="我……真的沒有其他辦法了嗎？",shape=box,color=red];
		j1805420292 -> j3013135037;
	j4254649692 [label="總之，我還是希望你別告訴我。我討厭自己太容易被猜到。不過，你確實幫我解決了一個對我來說非常重要的問題。 ",shape=box,color=blue];
		j4254649692 -> j3219470493;
	j287245405 [label="這場戰役必須在三條戰線上同時展開。所有人必須齊心協力，才能贏得這場戰爭。",shape=box,color=blue];
		j287245405 -> j1804694201;
		j287245405 -> j4125843397;
	j733874391 [label="好吧，無論你想要什麼，現在都別想得到。你最好就此作罷，讓我徹底忘記我們之間這段荒唐的經歷。「親愛的漂泊者」。",shape=box,color=blue];
		j733874391 -> j3968522555;
	j3390331244 [label="我猜這就是以前所謂的「空白支票」吧？而且你還是心甘情願地簽名的。",shape=box,color=blue];
		j3390331244 -> j2538412512;
		j3390331244 -> j1472189968;
	j2229136557 [label="我很難說它們已經釐清了，你覺得呢？",shape=box,color=blue];
		j2229136557 -> j2479917497;
	j3013135037 [label="不。如果你希望這位管家上樓？你就要按照我的要求，把我的腦子裡這些胡言亂語全部清除。如果你不在乎？那就隨你的便。對我來說無所謂。",shape=box,color=blue];
		j3013135037 -> j875810090;
	j3219470493 [label="昨晚我睡得比以往任何時候都好。但要說「好到我都記不清了」那可就太沒品了。",shape=box,color=blue];
		j3219470493 -> j1210702068;
	j1804694201 [label="不好意思，說什麼？",shape=box,color=red];
		j1804694201 -> j236350001;
	j4125843397 [label="我們是在說 Loid 嗎？",shape=box,color=red];
		j4125843397 -> j1232419400;
	j2538412512 [label="我有什麼辦法能改變你的想法嗎？",shape=box,color=red];
		j2538412512 -> j2846161444;
	j1472189968 [label="我該如何擺脫困境？",shape=box,color=red];
		j1472189968 -> j949963335;
	j2479917497 [label="你沒有履行你的承諾，所以我也不會履行我的承諾。",shape=box,color=blue];
		j2479917497 -> j2538412512;
		j2479917497 -> j458874988;
	j875810090 [label="當然，還有一點，我們之間的私人友誼是我在這件事上唯一能使用的籌碼。就這麼簡單。",shape=box,color=blue];
		j875810090 -> j2267583809;
	j1210702068 [label="所以，現在輪到我來幫你了。那位管家。你還想讓他和樓上的阿爾布雷希特一家團聚嗎？",shape=box,color=blue];
		j1210702068 -> j744968765;
	j236350001 [label="那位管家。讓他與阿爾布雷希特的家人團聚。你還是想這麼做，是嗎？",shape=box,color=blue];
		j236350001 -> j1949841813;
	j1232419400 [label="是的。請盡量跟上。我猜您仍然希望讓他和樓上的阿爾布雷希特一家團聚，對嗎？",shape=box,color=blue];
		j1232419400 -> j1949841813;
