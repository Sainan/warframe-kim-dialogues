	j4082306472 [label="語音訊息：戰火",shape=box,color=blue];
		j4082306472 -> j602038484;
	j602038484 [label="文字記錄：在過去，殘暴和放縱為我們提供了良好的服務。我被期望將它們應用為戰術。",shape=box,color=blue];
		j602038484 -> j1724036032;
	j1724036032 [label="我們的祖先當年是如何馴服 Infestation 的？當然是像撕開玫瑰花蕾一樣，撕開原子的核心！",shape=box,color=blue];
		j1724036032 -> j437663765;
	j437663765 [label="七人眾一致命令我成為手持三叉戟彈頭的惡魔，成為背著猖獗輻射背袋的播種者。",shape=box,color=blue];
		j437663765 -> j2442915536;
	j2442915536 [label="那一天，我們得知 Sentient 不僅能使我們的技術失效，還能強行徵用它。",shape=box,color=blue];
		j2442915536 -> j422833522;
	j422833522 [label="我們派出的那群邪惡的小型夷平者無人機歡快地飛回來，仍載滿炸彈，用未知音節咯咯笑著，在派遣它們的母艦中間引爆。",shape=box,color=blue];
		j422833522 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}