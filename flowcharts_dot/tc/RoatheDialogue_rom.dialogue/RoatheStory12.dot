	2244 [label="文字記錄：在過去，殘暴和放縱為我們提供了良好的服務。我被期望將它們應用為戰術。",shape=box,color=blue];
		2244 -> 2239;
	2239 [label="我們的祖先當年是如何馴服 Infestation 的？當然是像撕開玫瑰花蕾一樣，撕開原子的核心！",shape=box,color=blue];
		2239 -> 2236;
	2236 [label="七人眾一致命令我成為手持三叉戟彈頭的惡魔，成為背著猖獗輻射背袋的播種者。",shape=box,color=blue];
		2236 -> 5704;
	5704 [label="That was the day we learned the Sentients were not only capable of nullifying our technology, but also of commandeering it.",shape=box,color=blue];
		5704 -> 5705;
	5705 [label="The flock of wicked little leveller-drones we sent out came winging merrily back to us still heavy with bombs, chortling in unknown syllables, detonating in the midst of the very motherships that dispatched them.",shape=box,color=blue];
