	"Chat ends." [color=orange];
	j3547749075 [label="VM: SACRIFICE",shape=box,color=blue];
		j3547749075 -> j757470385;
	j757470385 [label="文字記錄：特雷文。我看著你把銳捷號投入普拉咖薩的巨口。她分心了，貪婪地吞食你和你的部下，從未注意到我自己的船正在加速逃離。",shape=box,color=blue];
		j757470385 -> j1044648074;
	j1044648074 [label="You laid down your life for your superior officer. I felt your selflessness like a slap in the face.",shape=box,color=blue];
		j1044648074 -> j1263633377;
	j1263633377 [label="Maryna. You gave me your body. Together, in that trench, we drank Kuva. My hands shook and my gashed throat leaked, but I kept enough drops down for it to take.",shape=box,color=blue];
		j1263633377 -> j3267800043;
	j3267800043 [label="I remember your last salute. The fading. Then I blinked open the eyes that had been yours, and saw my gutted corpse dead in the mud.",shape=box,color=blue];
		j3267800043 -> j1843678821;
	j1843678821 [label="羅斯提。他們說複製過程中出了問題。還有什麼能讓 Grineer 在活活燒死時，仍堅守砲塔？連老鼠都懂得自保了！不。你的「缺陷」把你置於他們之上。",shape=box,color=blue];
		j1843678821 -> j1298964934;
	j1298964934 [label="不。你的「缺陷」把你置於他們之上。",shape=box,color=blue];
		j1298964934 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}