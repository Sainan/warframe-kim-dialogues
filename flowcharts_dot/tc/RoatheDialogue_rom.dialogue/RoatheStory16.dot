	"Chat ends." [color=orange];
	j4018905884 [label="語音訊息：犧牲",shape=box,color=blue];
		j4018905884 -> j3962968943;
	j3962968943 [label="文字記錄：特雷文。我看著你把銳捷號投入普拉咖薩的巨口。她分心了，貪婪地吞食你和你的部下，從未注意到我自己的船正在加速逃離。",shape=box,color=blue];
		j3962968943 -> j4048380357;
	j4048380357 [label="你為上級軍官獻出了生命。我感到你的無私如一記耳光。",shape=box,color=blue];
		j4048380357 -> j4114764156;
	j4114764156 [label="瑪麗娜。你把身體給了我。在那戰壕裡，我們一起喝下赤毒。我的雙手在顫抖，割開的喉嚨在滲血，但我保留了足夠的液滴讓它起效。",shape=box,color=blue];
		j4114764156 -> j4059051776;
	j4059051776 [label="我記得你最後的敬禮。你漸漸消逝。然後我眨開曾經是你的雙眼，看到我被掏空的屍體死在泥濘中。",shape=box,color=blue];
		j4059051776 -> j1843678821;
	j1843678821 [label="羅斯提。他們說複製過程中出了問題。還有什麼能讓 Grineer 在活活燒死時，仍堅守砲塔？連老鼠都懂得自保了！不。你的「缺陷」把你置於他們之上。",shape=box,color=blue];
		j1843678821 -> j1298964934;
	j1298964934 [label="不。你的「缺陷」把你置於他們之上。",shape=box,color=blue];
		j1298964934 -> j921430358;
	j921430358 [label="Add 1 to HellStory counter",color=orange];
		j921430358 -> "Chat ends.";
}