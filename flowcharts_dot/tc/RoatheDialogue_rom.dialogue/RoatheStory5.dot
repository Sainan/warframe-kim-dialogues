	2172 [label="文字記錄：現在，我記得武術 Archimedea 的發展起初被當作娛樂呈現。",shape=box,color=blue];
		2172 -> 5692;
	5692 [label="就像墮落的浪蕩子圍觀罪犯在競技馬戲場中被處決。",shape=box,color=blue];
		5692 -> 2169;
	2169 [label="我們自以為想出了新奇刺激的方法來處決遠遠低劣的敵人。",shape=box,color=blue];
		2169 -> 2170;
	2170 [label="我們多麼自欺欺人。事實上，我們是在絕望中創新，知道自己被千變萬化的敵人壓制。",shape=box,color=blue];
		2170 -> 5685;
	5685 [label="他們撕裂我們，如同成群的孩子吞噬臃腫的母親。",shape=box,color=blue];
		5685 -> 5686;
	5686 [label="如同被時間夾在書頁間碾壓乾癟，我們只是在進化中被淘汰了。",shape=box,color=blue];
