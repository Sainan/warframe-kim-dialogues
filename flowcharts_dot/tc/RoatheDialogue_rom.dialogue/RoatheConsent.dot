	"Chat ends." [color=orange];
	j511900548 [label="Check boolean RoatheConsentComplete",color=orange];
		j511900548 -> "Chat ends." [label=true,color=green];
		j511900548 -> j1470886005 [label=false,color=brown];
		j511900548 -> j1630258115 [label=false,color=brown];
	j4082858284 [label="Check boolean RoathePolyamorySuccess",color=orange];
		j4082858284 -> j511900548 [label=true,color=green];
		j4082858284 -> "Chat ends." [label=false,color=brown];
	j1470886005 [label="嘿，羅瑟？你有空嗎？[徵求同意發展多重伴侶關係]",shape=box,color=red];
		j1470886005 -> j4225606204;
	j1630258115 [label="[結束]",shape=box,color=red];
		j1630258115 -> j604242687;
	j4225606204 [label="嗯？什麼事了，親愛的？",shape=box,color=blue];
		j4225606204 -> j3617139650;
	j604242687 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j604242687 -> "Chat ends.";
	j3617139650 [label="我想和你說件事，我想確認你的想法。",shape=box,color=red];
		j3617139650 -> j2858300420;
	j2858300420 [label="對我來說更重要的是，希望你不會覺得我在騙你或對你不忠。",shape=box,color=red];
		j2858300420 -> j1524584031;
	j1524584031 [label="繼續說。聽起來很有趣。",shape=box,color=blue];
		j1524584031 -> j1037166360;
	j1037166360 [label="我不願讓你置身你不願待的處境。所以如果你不想的話，那也沒關係。我希望你明白這點。",shape=box,color=red];
		j1037166360 -> j3057227975;
	j3057227975 [label="我們之間的關係對我來說很重要，非常重要，而且它是真實的。我不希望你懷疑這點。",shape=box,color=red];
		j3057227975 -> j2024690594;
	j2024690594 [label="等等。虛空在上，你是在試圖隱瞞你有另一個伴侶的這件事嗎？",shape=box,color=blue];
		j2024690594 -> j16002816;
	j16002816 [label="你覺得我有多傻？我已經知道了，親愛的漂泊者！",shape=box,color=blue];
		j16002816 -> j2709878271;
		j16002816 -> j2182695479;
	j2709878271 [label="那，看來你不介意吧？",shape=box,color=red];
		j2709878271 -> j4294872436;
	j2182695479 [label="你……知道？",shape=box,color=red];
		j2182695479 -> j994289296;
	j4294872436 [label="你要是現在能在聖堂聽到我的笑聲就好了。漂泊者，親愛的。我親愛的漂泊者。我是 Orokin 。我當然不介意。",shape=box,color=blue];
		j4294872436 -> j322692219;
	j994289296 [label="你要是現在能在聖堂聽到我的笑聲就好了。漂泊者，親愛的。我親愛的漂泊者。",shape=box,color=blue];
		j994289296 -> j2035085624;
	j322692219 [label="無論你對我的社會，以及我們那種享受他人陪伴的愛好有什麼看法，即使在你眼中，那種方式顯得輕率又廉價，但我們也同樣明白愛是什麼感覺。",shape=box,color=blue];
		j322692219 -> j2713183636;
	j2035085624 [label="在發生的瞬間我就知道了。我有我的方法。而且，不，我一點也不介意。我可是 Orokin 人。",shape=box,color=blue];
		j2035085624 -> j322692219;
	j2713183636 [label="沒有人比 Orokin 人更懂得愛。我們知道，一顆心可容納的不只一個愛人。 ",shape=box,color=blue];
		j2713183636 -> j48548506;
	j48548506 [label="我只是有點失望，那些狂熱分子可能思想太過保守了，沒法一起找樂子。",shape=box,color=blue];
		j48548506 -> j2971580700;
	j2971580700 [label="唉。轉念一想，這或許是最好的安排。你能想像那會引起多大的混亂嗎？",shape=box,color=blue];
		j2971580700 -> j865389762;
	j865389762 [label="Boolean RoatheConsentComplete is now true.",color=orange];
		j865389762 -> j1492298267;
	j1492298267 [label="算了，不管怎樣，如果他們能讓你開心，那就去好好享受吧。但你要清楚，當你和我在一起時……",shape=box,color=blue];
		j1492298267 -> j2992575235;
	j2992575235 [label="+5 Chemistry",color=orange];
		j2992575235 -> j1205363538;
	j1205363538 [label="你是我的，而且只能屬於我一個。",shape=box,color=blue];
		j1205363538 -> "Chat ends.";
}