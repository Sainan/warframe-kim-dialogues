	j3856478282 [label="Boolean RoatheVillain is now true.",color=orange];
		j3856478282 -> j756895710;
	j1966486911 [label="你擁有一種天賦。一種可以逆轉時間的天賦。即使不去循環，也能使其螺旋前進。而這對原型 Warframe 的心智會產生……一種有趣的影響，因為它與 Infestation 的聯繫以及它與時間的聯繫。",shape=box,color=blue];
		j1966486911 -> j3885971668;
	j32530440 [label="如果你能對我說，你從未用過你的天賦來玩弄你稱之為朋友和愛人的原型 Warframe 的心智，而且你能發自內心地說出這番話，沒有絲毫謊言？",shape=box,color=blue];
		j32530440 -> j2332285514;
	j2830668457 [label="很好。我讓步並接受你的論點。謝謝你，漂泊者，從這個特定的懸崖把我勸了回來。",shape=box,color=blue];
		j2830668457 -> j2912213961;
	j2378404293 [label="+20 Chemistry",color=orange];
