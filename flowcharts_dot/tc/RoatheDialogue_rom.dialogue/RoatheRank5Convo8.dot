	j756895710 [label="+20 Chemistry",color=orange];
		j756895710 -> j4224789936;
	j3885971668 [label="因此，我們依附於時間。我現在請求你。不，我懇求你，現在就為我用那力量，將這些思緒從我身上帶走。將這些記憶從我身上帶走。",shape=box,color=blue];
		j3885971668 -> j149168530;
	j2332285514 [label="那好吧。就這樣吧。我現在不要求你這麼做。但你從未為了你自己的娛樂、好奇心，或為了試圖糾正你在與他人交往中所犯下的錯誤而使用過它？！",shape=box,color=blue];
		j2332285514 -> j149168530;
	j2912213961 [label="我很感激。比你想像的還要感激。",shape=box,color=blue];
		j2912213961 -> j4161264070;
	j1168236793 [label="我該原諒自己所做的一切嗎？然後繼續向前邁進嗎？嗯。",shape=box,color=blue];
		j1168236793 -> j1833925268;
	j4224789936 [label="以退為進。嗯。 ",shape=box,color=blue];
		j4224789936 -> j184972509;
