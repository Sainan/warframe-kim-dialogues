		j1758133089 -> "Chat ends." [label="x <= 21",color=purple];
		j1758133089 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j2128844021 [label="你這個蠢貨！你幹了什麼？！為什麼，為什麼要去那些明明不歡迎你的洞穴裡探索？！",shape=box,color=blue];
		j2128844021 -> j3477529184;
	j3477529184 [label="我要求你解決它。這是你的錯。我能感覺到，它在撕咬我，像一頭巨大的野獸。",shape=box,color=blue];
		j3477529184 -> j1269558017;
	j1269558017 [label="擺脫這個東西。擺脫這場瘟疫。把這些記憶從我腦子裡清掉。我知道你辦得到。用你那個天賦，現在就結束一切。",shape=box,color=blue];
		j1269558017 -> j1699675947;
		j1269558017 -> j3129034874;
		j1269558017 -> j986211639;
	j1699675947 [label="你確定嗎？但是……你很聰明，我感覺你會發現有什麼不對勁。",shape=box,color=red];
		j1699675947 -> j1638494737;
	j3129034874 [label="羅瑟，那些屬於另一種記憶，這種方法對它們無效。它們深埋在你潛意識深處。",shape=box,color=red];
		j3129034874 -> j4132104325;
	j986211639 [label="逃避和躲藏真相是行不通的。我們最終只會回到原點。",shape=box,color=red];
		j986211639 -> j3479166748;
	j1638494737 [label="很有可能。我會把所有線索連結起來，然後怪你做了我沒讓你做的事。我相信你能挺過難關。",shape=box,color=blue];
		j1638494737 -> j2777456118;
	j4132104325 [label="也許是這樣。你說的很可能沒錯。但我現在也沒有其他辦法了，不是嗎？",shape=box,color=blue];
		j4132104325 -> j2777456118;
	j3479166748 [label="如果真是那樣，你完全可以再做一次。這就像你擁有取之不盡的天賦，不是嗎？",shape=box,color=blue];
		j3479166748 -> j2777456118;
	j2777456118 [label="我確信，一旦我意識到你已經篡改了我的記憶，我當然會對你極度憤怒。而我建議你，親愛的，別告訴我是我要求的。",shape=box,color=blue];
		j2777456118 -> j1835073539;
	j1835073539 [label="我會直接認定你在說謊，這很可能會讓我對你的看法徹底崩塌。",shape=box,color=blue];
		j1835073539 -> j1049516727;
		j1835073539 -> j4185336766;
	j1049516727 [label="不。我不能這麼做。我不會這麼做。我們必須一起面對這個局面。難道我們不能好好談談嗎？",shape=box,color=red];
		j1049516727 -> j3123776496;
	j4185336766 [label="我……真的沒有其他辦法了嗎？",shape=box,color=red];
		j4185336766 -> j3123776496;
	j3123776496 [label="不。如果你希望這位管家上樓？你就要按照我的要求，把我的腦子裡這些胡言亂語全部清除。如果你不在乎？那就隨你的便。對我來說無所謂。",shape=box,color=blue];
		j3123776496 -> j293077910;
	j293077910 [label="當然，還有一點，我們之間的私人友誼是我在這件事上唯一能使用的籌碼。就這麼簡單。",shape=box,color=blue];
		j293077910 -> j4085036228;
	j4085036228 [label="你意下如何？",shape=box,color=blue];
		j4085036228 -> j227043353;
		j4085036228 -> j477423554;
	j227043353 [label="好吧。我……我來做。我會抹去你的記憶。即使這會連累瑪麗和里昂。",shape=box,color=red];
		j227043353 -> j2085691284;
	j477423554 [label="不，我拒絕。對不起，我們必須面對現實。",shape=box,color=red];
		j477423554 -> j1874486431;
		j477423554 -> j1390612214;
	j2085691284 [label="+10 Chemistry",color=orange];
		j2085691284 -> j1824777617;
	j1874486431 [label="我們來好好談談。",shape=box,color=red];
		j1874486431 -> j1246009370;
	j1390612214 [label="你要恨我就恨吧。但在我們解決這件事之前，我不會做任何事。",shape=box,color=red];
		j1390612214 -> j3909252230;
	j1824777617 [label="很好，開始吧。 ",shape=box,color=blue];
		j1824777617 -> j4072107213;
	j1246009370 [label="你膽敢——你膽敢跟我提什麼「冷靜下來」！你不覺得我有充分的理由感到自己快要被撕成兩半嗎？ ！",shape=box,color=blue];
		j1246009370 -> j2520806740;
	j3909252230 [label="有意思。太有意思了，完全沒想到。解釋一下。",shape=box,color=blue];
		j3909252230 -> j1229203662;
		j3909252230 -> j2959881882;
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j2520806740 [label="我感覺自己對自己的認知，我賴以生存的根基，就像該死的太陰一樣被徹底撕裂、崩裂！一切都被墨跡改寫，蕩然無存。懦夫！",shape=box,color=blue];
		j2520806740 -> j880394040;
	j1229203662 [label="我這麼做是因為必須這麼做。你再也無法逃避了。",shape=box,color=red];
		j1229203662 -> j3517155419;
	j2959881882 [label="隨便你怎麼想。但這種輪迴我看得出來。",shape=box,color=red];
		j2959881882 -> j541041235;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
	j880394040 [label="你竟然敢叫我「冷靜」？ ！",shape=box,color=blue];
		j880394040 -> j1830055178;
	j3517155419 [label="Boolean RoatheFail is now true.",color=orange];
		j3517155419 -> j2930798159;
	j541041235 [label="是的，我想你對這種事情有點像個「行家」，難道不是嗎？繼續說。",shape=box,color=blue];
		j541041235 -> j3277681543;
		j541041235 -> j1662163149;
	j1830055178 [label="Evaluate expressions",color=orange];
		j1830055178 -> j3163275654 [label="RoatheForgivenessShortcut",color=purple];
		j1830055178 -> j2229257442 [label="RoatheVillainyShortcut",color=purple];
		j1830055178 -> j2318547072 [label="false",color=purple];
	j2930798159 [label="我體內有一頭狂暴的野獸，正從內而外啃噬我的肋骨。",shape=box,color=blue];
		j2930798159 -> j1125360607;
	j3277681543 [label="如果你希望尋求寬恕，你可以。但你需要發自內心地想這麼做。你需要選擇那條路。沒有人可以代勞。",shape=box,color=red];
		j3277681543 -> j2950837790;
	j1662163149 [label="如果你想選擇獨自開闢一條屬於自己的道路？為你自己？去吧。不要道歉。但那是你自己的選擇，不是別人的。",shape=box,color=red];
		j1662163149 -> j2527360634;
	j3163275654 [label="羅瑟，生氣解決不了任何問題。你生氣是因為你害怕面對你所做的一切，以及你變成了的人。",shape=box,color=red];
		j3163275654 -> j785129833;
	j2229257442 [label="好。生氣吧。但把那份憤怒用在值得的事情上。用它來擺脫你心裡所有那些指錯了方向的仇恨。",shape=box,color=red];
		j2229257442 -> j3070282021;
	j2318547072 [label="Evaluate expressions on Thermostat counter",color=orange];
		j2318547072 -> j3163275654 [label="x >= 5",color=purple];
		j2318547072 -> j2229257442 [label="x <= 0",color=purple];
		j2318547072 -> j3369060719 [label="x > 0 && x < 5",color=purple];
		j2318547072 -> j3369060719 [label="false",color=purple];
	j1125360607 [label="而我不知道如何才能滿足它。我不知道我是否能做到。我曾希望這些對話能為我指明一條路；但我現在明白，這是徒勞的。",shape=box,color=blue];
		j1125360607 -> j2116423111;
	j2950837790 [label="羅瑟，你不是由你的過去所定義。你是由你的未來所定義。而且你仍然有未來可以生活，你不像其他在長胴鼓之夜死去的 Orokin。",shape=box,color=red];
		j2950837790 -> j2329201;
	j2527360634 [label="你不是被身邊的人他們的看法所定義的。也不被他們對你行為的評價而定義。你僅由你對自己的信念和你的選擇所定義。",shape=box,color=red];
		j2527360634 -> j3104447393;
	j785129833 [label="你讓憤怒吞噬了自己。你本可以利用它來對抗那些至今仍在破壞這個世界的人。就在此刻。就在這裡。",shape=box,color=red];
		j785129833 -> j941222410;
	j3070282021 [label="你把矛頭指向了自己。你應該指向的是這個世界，那個因為你盡力拯救它脫離 Orokin 帝國而責怪你的世界。",shape=box,color=red];
		j3070282021 -> j893391993;
	j3369060719 [label="我只是希望我知道該如何幫助你。我希望我知道該說些什麼。你感覺像是被撕成兩半左右為難。你想往哪邊走？",shape=box,color=red];
		j3369060719 -> j2489337141;
	j2116423111 [label="但總有解決辦法，不是嗎？你有能力解決這個問題……解決我內心這種可怕的痛苦。",shape=box,color=blue];
		j2116423111 -> j4143136673;
	j2329201 [label="那是現在唯一能定義你的東西。你可以改變。而且你可以改變周圍的世界。我想我唯一的問題是，你至少會嘗試嗎？",shape=box,color=red];
		j2329201 -> j3526713224;
	j3104447393 [label="而簡單的事實是？你是我們知道的極少數在長胴鼓之夜中倖存下來的 Orokin 之一。從我的角度來看？那是一次戰略撤退。",shape=box,color=red];
		j3104447393 -> j816199841;
	j941222410 [label="你讓憤怒吞噬了自己。你本可以利用它來對抗那些至今仍在破壞這個世界的人。就在此刻。就在這裡。",shape=box,color=red];
		j941222410 -> j1089881616;
	j893391993 [label="你不是被身邊的人他們的看法所定義的。也不被他們對你行為的評價而定義。你僅由你對自己的信念和你的選擇所定義。",shape=box,color=red];
		j893391993 -> j737734830;
	j2489337141 [label="Boolean RoatheFail is now true.",color=orange];
		j2489337141 -> j2543236792;
	j4143136673 [label="篡位者。漂泊者。我現在求求你了。確實，我相信這也是我們能繼續前進的唯一方式，對吧？這也符合你自身的利益。",shape=box,color=blue];
		j4143136673 -> j2540186358;
	j3526713224 [label="嘗試原諒自己並繼續前進？",shape=box,color=red];
		j3526713224 -> j996035257;
	j816199841 [label="不多不少，僅此而已。",shape=box,color=red];
		j816199841 -> j459190906;
	j1089881616 [label="那是現在唯一能定義你的東西。你可以改變。而且你可以改變周圍的世界。我想我唯一的問題是，你至少會嘗試嗎？",shape=box,color=red];
		j1089881616 -> j383630150;
	j737734830 [label="而簡單的事實是？你是我們知道的極少數在長胴鼓之夜中倖存下來的 Orokin 之一。從我的角度來看？那是一次戰略撤退。",shape=box,color=red];
