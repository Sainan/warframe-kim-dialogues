digraph {
	"RoatheRank5Convo8 begins." [color=orange];
		"RoatheRank5Convo8 begins." -> j4125803273;
	j4125803273 [label="Check boolean RoatheFailNot21",color=orange];
		j4125803273 -> j1758133089 [label=true,color=green];
		j4125803273 -> "Chat ends." [label=false,color=brown];
	j1758133089 [label="Evaluate expressions on HellStory counter",color=orange];
		j1758133089 -> j2128844021 [label="x >= 21",color=purple];
		j1758133089 -> "Chat ends." [label="x <= 21",color=purple];
		j1758133089 -> "Chat ends." [label="false",color=purple];
	"Chat ends." [color=orange];
	j2128844021 [label="你這個蠢貨！你幹了什麼？！為什麼，為什麼要去那些明明不歡迎你的洞穴裡探索？！",shape=box,color=blue];
		j2128844021 -> j3477529184;
	j3477529184 [label="我要求你解決它。這是你的錯。我能感覺到，它在撕咬我，像一頭巨大的野獸。",shape=box,color=blue];
		j3477529184 -> j1269558017;
	j1269558017 [label="擺脫這個東西。擺脫這場瘟疫。把這些記憶從我腦子裡清掉。我知道你辦得到。用你那個天賦，現在就結束一切。",shape=box,color=blue];
		j1269558017 -> j1699675947;
		j1269558017 -> j3129034874;
		j1269558017 -> j986211639;
	j1699675947 [label="你確定嗎？但是……你很聰明，我感覺你會發現有什麼不對勁。",shape=box,color=red];
		j1699675947 -> j1638494737;
	j3129034874 [label="羅瑟，那些屬於另一種記憶，這種方法對它們無效。它們深埋在你潛意識深處。",shape=box,color=red];
		j3129034874 -> j4132104325;
	j986211639 [label="逃避和躲藏真相是行不通的。我們最終只會回到原點。",shape=box,color=red];
		j986211639 -> j3479166748;
	j1638494737 [label="很有可能。我會把所有線索連結起來，然後怪你做了我沒讓你做的事。我相信你能挺過難關。",shape=box,color=blue];
		j1638494737 -> j2777456118;
	j4132104325 [label="也許是這樣。你說的很可能沒錯。但我現在也沒有其他辦法了，不是嗎？",shape=box,color=blue];
		j4132104325 -> j2777456118;
	j3479166748 [label="如果真是那樣，你完全可以再做一次。這就像你擁有取之不盡的天賦，不是嗎？",shape=box,color=blue];
		j3479166748 -> j2777456118;
	j2777456118 [label="我確信，一旦我意識到你已經篡改了我的記憶，我當然會對你極度憤怒。而我建議你，親愛的，別告訴我是我要求的。",shape=box,color=blue];
		j2777456118 -> j1835073539;
	j1835073539 [label="我會直接認定你在說謊，這很可能會讓我對你的看法徹底崩塌。",shape=box,color=blue];
		j1835073539 -> j1049516727;
		j1835073539 -> j4185336766;
	j1049516727 [label="不。我不能這麼做。我不會這麼做。我們必須一起面對這個局面。難道我們不能好好談談嗎？",shape=box,color=red];
		j1049516727 -> j3123776496;
	j4185336766 [label="我……真的沒有其他辦法了嗎？",shape=box,color=red];
		j4185336766 -> j3123776496;
	j3123776496 [label="不。如果你希望這位管家上樓？你就要按照我的要求，把我的腦子裡這些胡言亂語全部清除。如果你不在乎？那就隨你的便。對我來說無所謂。",shape=box,color=blue];
		j3123776496 -> j293077910;
	j293077910 [label="當然，還有一點，我們之間的私人友誼是我在這件事上唯一能使用的籌碼。就這麼簡單。",shape=box,color=blue];
		j293077910 -> j4085036228;
	j4085036228 [label="你意下如何？",shape=box,color=blue];
		j4085036228 -> j227043353;
		j4085036228 -> j3797350139;
	j227043353 [label="好吧。我……我來做。我會抹去你的記憶。即使這會連累瑪麗和里昂。",shape=box,color=red];
		j227043353 -> j2085691284;
	j3797350139 [label="不。我拒絕。我會找到另一種方法說服你繼續前進。",shape=box,color=red];
		j3797350139 -> j821522365;
	j2085691284 [label="+10 Chemistry",color=orange];
		j2085691284 -> j1824777617;
	j821522365 [label="祝你好運。",shape=box,color=blue];
		j821522365 -> "Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue";
	j1824777617 [label="很好，開始吧。 ",shape=box,color=blue];
		j1824777617 -> j4072107213;
	"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" [label="Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue",color=orange];
		"Initiate conversation LyonRoatheFail in /Lotus/Types/Gameplay/1999Wf/Dialogue/LyonDialogue_rom.dialogue" -> "Chat ends.";
	j4072107213 [label="Add 1 to Promise counter",color=orange];
		j4072107213 -> j302033967;
	j302033967 [label="Boolean RoatheWillReset is now true.",color=orange];
		j302033967 -> "Chat ends.";
}