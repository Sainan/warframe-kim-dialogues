		"RoatheRank3Convo2 begins." -> j1350559949;
	j2259245716 [label="你當初打算用什麼方法解決掉執行者？",shape=box,color=red];
		j2259245716 -> j3720655375;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j3720655375 [label="Check boolean RoatheKnowsReset2",color=orange];
		j3720655375 -> j825146019 [label=true,color=green];
		j3720655375 -> j750683704 [label=false,color=brown];
	"Chat ends." [color=orange];
	j825146019 [label="為什麼問我？漂泊者，你的真正目的是什麼？你當然不是在打聽那些武器藏在哪裡吧。",shape=box,color=blue];
		j825146019 -> j3516477393;
	j750683704 [label="為什麼？想回到過去，去打破你年輕時自己創下的紀錄？需要顛覆極權統治的訣竅？還是想找到能炸掉整顆星球的武器？",shape=box,color=blue];
		j750683704 -> j709964237;
	j3516477393 [label="我為什麼會相信你？我當初怎麼會相信你？！",shape=box,color=blue];
		j3516477393 -> j2310817378;
	j709964237 [label="還是你只是在閒聊？",shape=box,color=blue];
		j709964237 -> j3188343708;
		j709964237 -> j1780509657;
		j709964237 -> j3184923738;
	j2310817378 [label="Check boolean RoatheResetForgiven",color=orange];
		j2310817378 -> j2791479714 [label=true,color=green];
		j2310817378 -> j4026765527 [label=false,color=brown];
	j3188343708 [label="說實話，我很想知道你是否後悔過這些決定。如果你可以重來，你會不會改變你之前的計畫？",shape=box,color=red];
		j3188343708 -> j359092998;
	j1780509657 [label="我很好奇想出那樣一個計畫會是怎樣的感覺。那肯定是一件傑作。",shape=box,color=red];
		j1780509657 -> j176487989;
	j3184923738 [label="說真的，如果你在現在還能去到的地方藏了任何武器，或許還真是一件好事。",shape=box,color=red];
		j3184923738 -> j662300118;
	j2791479714 [label="我已經原諒你做過的這件事。我只是希望我能記得為什麼——為什麼！為什麼偏偏是你，是你？！",shape=box,color=blue];
		j2791479714 -> j1794257051;
		j2791479714 -> j2539973798;
	j4026765527 [label="為什麼！為什麼是你，偏偏是你？！",shape=box,color=blue];
		j4026765527 -> j2539973798;
		j4026765527 -> j4221098100;
	j359092998 [label="Add 1 to Thermostat counter",color=orange];
		j359092998 -> j3475310094;
	j176487989 [label="Add -1 to Thermostat counter",color=orange];
		j176487989 -> j3504887587;
	j662300118 [label="+5 Chemistry",color=orange];
		j662300118 -> j1058231669;
	j1794257051 [label="我知道。我依然感到非常抱歉。",shape=box,color=red];
		j1794257051 -> j2508088273;
	j2539973798 [label="我想讓你明白其中的原因。",shape=box,color=red];
		j2539973798 -> j3504189513;
	j4221098100 [label="羅瑟，我對辜負了你的信任感到抱歉。信不信由你，我並非有意為之。",shape=box,color=red];
		j4221098100 -> j3987447938;
	j3475310094 [label="我唯一遺憾的是它最終未能實現。我後悔浪費了時間。",shape=box,color=blue];
		j3475310094 -> j3830357822;
	j3504887587 [label="篡位者，那確實是一件傑作。",shape=box,color=blue];
		j3504887587 -> j3830357822;
	j1058231669 [label="實用至極。但這麼多年過去了，那些我「藏匿」物資的許多地方，很可能在漫長的歲月中不知所蹤。",shape=box,color=blue];
		j1058231669 -> j3155598527;
	j2508088273 [label="是的，是的。我想我們應該繼續這場愚蠢的對話，又把我們之前的話題再重複一次。",shape=box,color=blue];
		j2508088273 -> j2736547075;
	j3504189513 [label="+5 Chemistry",color=orange];
		j3504189513 -> j257228390;
	j3987447938 [label="是的，你可能認為自己的行為不會有任何後果。但不管怎樣，我們還是應該繼續這場愚蠢的對話，重蹈覆轍，然後繼續過自己的生活。",shape=box,color=blue];
		j3987447938 -> j2736547075;
	j3830357822 [label="+5 Chemistry",color=orange];
		j3830357822 -> j1800250970;
	j3155598527 [label="而且許多地點連我自己都不知道。這個計畫極度複雜。層層疊疊，錯綜複雜。",shape=box,color=blue];
		j3155598527 -> j1670539323;
	j2736547075 [label="你剛才的問題是什麼？啊！對了。「我當初打算用什麼方法解決掉執行者？」",shape=box,color=blue];
		j2736547075 -> j274853783;
	j257228390 [label="透過重述那些關於我為何想謀殺那些早已化為塵土之人的無謂對話？至少這極為務實。",shape=box,color=blue];
		j257228390 -> j2736547075;
	j1800250970 [label="這個計畫極度複雜。層層疊疊、環環相扣。刺客的刺客、以及會清理其他刺客的刺客，以防第一個刺客失手。",shape=box,color=blue];
		j1800250970 -> j3543668314;
	j1670539323 [label="刺客的刺客、以及會清理其他刺客的刺客，以防第一個刺客失手。",shape=box,color=blue];
		j1670539323 -> j3543668314;
	j274853783 [label="為什麼？",shape=box,color=blue];
		j274853783 -> j3188343708;
		j274853783 -> j1780509657;
		j274853783 -> j3184923738;
	j3543668314 [label="多棟建築、整艘飛船甚至一顆衛星上都佈滿了炸彈，這些炸彈都已安裝完畢，準備用偷來的炸藥引爆。還有一個星際航道隨時準備墜出軌道。",shape=box,color=blue];
		j3543668314 -> j2531726653;
	j2531726653 [label="而這一切，屆時都將會偽裝成一場「巨型的 Sentient 災難」。一旦執行者們和帝王們被……處理掉後，Nitokh 和我將宣布帝國進入緊急狀態。",shape=box,color=blue];
		j2531726653 -> j1742364006;
	j1742364006 [label="Boolean RoatheTraitor2 is now true.",color=orange];
		j1742364006 -> j285070892;
	j285070892 [label="Check boolean RoatheExecutor1",color=orange];
		j285070892 -> j2856566040 [label=true,color=green];
		j285070892 -> j1528822374 [label=true,color=green];
		j285070892 -> j1431287079 [label=true,color=green];
		j285070892 -> j2856566040 [label=false,color=brown];
		j285070892 -> j1528822374 [label=false,color=brown];
	j2856566040 [label="如果你的計畫失敗了怎麼辦？",shape=box,color=red];
		j2856566040 -> j125517168;
	j1528822374 [label="那你當時打算怎麼辦？",shape=box,color=red];
		j1528822374 -> j2196664435;
	j1431287079 [label="你打算怎麼處置 Nitokh？",shape=box,color=red];
		j1431287079 -> j1932713100;
	j125517168 [label="這不過是成千上萬種可能結果中的其中之一，而我早已備妥應對之策。",shape=box,color=blue];
		j125517168 -> j3554675221;
	j2196664435 [label="對於我們的計畫，有一千種可能的結果。對於每一個可能影響結果的變量，我們都設計了一條可能的路徑。 ",shape=box,color=blue];
		j2196664435 -> j3125434025;
	j1932713100 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1932713100 -> j2920198758 [label=true,color=green];
		j1932713100 -> j974329743 [label=false,color=brown];
	j3554675221 [label="如果我們徹底失敗了，我就會口含雷克斯的槍管，然後結束這一天。",shape=box,color=blue];
		j3554675221 -> j2932051943;
	j3125434025 [label="對於每一條路徑，我都擬定了一個結果。對於每一種路徑，我都清楚知道自己打算怎麼做。它們在大方向上相似，但在細節上卻截然不同。",shape=box,color=blue];
		j3125434025 -> j3417778374;
	j2920198758 [label="我以前告訴過你什麼？因為我覺得我還沒完全信任你到可以和盤托出。",shape=box,color=blue];
		j2920198758 -> j1983415741;
		j2920198758 -> j1204326496;
	j974329743 [label="那是一件複雜的事情，涉及到我們之間的一些……重要的談判。",shape=box,color=blue];
		j974329743 -> j3716849267;
		j974329743 -> j3317323006;
	j2932051943 [label="為灑了出來的赤毒哭泣毫無意義。",shape=box,color=blue];
		j2932051943 -> j2283654650;
		j2932051943 -> j942363157;
	j3417778374 [label="如果我們徹底失敗了，我就會口含雷克斯的槍管，然後結束這一天。",shape=box,color=blue];
		j3417778374 -> j2341660623;
	j1983415741 [label="你把一切都告訴我了。",shape=box,color=red];
		j1983415741 -> j2902884956;
	j1204326496 [label="那我就不逼你說出更多你不想說的了。",shape=box,color=red];
		j1204326496 -> j828329111;
	j3716849267 [label="這句話裡蘊含著許多訊息。",shape=box,color=red];
		j3716849267 -> j1101824179;
	j3317323006 [label="什麼樣的談判？",shape=box,color=red];
		j3317323006 -> j2125695436;
	j2283654650 [label="換作是我，我會直接跑路。",shape=box,color=red];
		j2283654650 -> j2724035281;
	j942363157 [label="你會就這樣接受死亡嗎？",shape=box,color=red];
		j942363157 -> j126953045;
	j2341660623 [label="如果這次行動只是取得一般程度的成功，這也是最可能的結果，那麼就需要進行善後工作，確保所有遺留的問題都得到解決。當然，我自然也是其中之一。而且我已經採取了一些措施，以確保在短期內我仍然具有足夠的價值，不會被像其他成員一樣輕易收割。",shape=box,color=blue];
		j2341660623 -> j797450548;
	j2902884956 [label="那我再重複一次也沒用了，對吧？事實上，這場談話根本毫無意義。祝你今天餘下的時間愉快。",shape=box,color=blue];
		j2902884956 -> "Chat ends.";
	j828329111 [label="+5 Chemistry",color=orange];
		j828329111 -> j2186539670;
	j1101824179 [label="+5 Chemistry",color=orange];
		j1101824179 -> j2515266323;
	j2125695436 [label="你能想到的各樣談判。",shape=box,color=blue];
		j2125695436 -> j1861383400;
	j2724035281 [label="我的篡位者，你認為可以跑去哪裡？不是每個人在緊急關頭都能有個私人維度可以躲進去。",shape=box,color=blue];
		j2724035281 -> j2586439290;
	j126953045 [label="我幾乎沒有別的選擇，不是嗎？無處可去，無處可藏。",shape=box,color=blue];
		j126953045 -> j2586439290;
	j797450548 [label="如果情況極度成功，我就會繼續執行計畫的第二階段。",shape=box,color=blue];
		j797450548 -> j1295826729;
		j797450548 -> j3613067564;
	j2186539670 [label="很好。我必須說那是一件複雜的事情，涉及到我們之間的一些……重要的談判。",shape=box,color=blue];
		j2186539670 -> j3716849267;
		j2186539670 -> j3317323006;
	j2515266323 [label="沙塵下還埋了幾百年呢。",shape=box,color=blue];
		j2515266323 -> j1861383400;
	j1861383400 [label="Boolean RoatheExecutor2 is now true.",color=orange];
		j1861383400 -> j1717274806;
	j2586439290 [label="尼托克早已痛苦地說得很清楚，如果我們失敗了，我將會成為公開的犧牲品。",shape=box,color=blue];
		j2586439290 -> j803710049;
		j2586439290 -> j3041635361;
