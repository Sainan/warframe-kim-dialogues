		j1295826729 -> j3093089034;
	j3613067564 [label="弒了 Nitok？",shape=box,color=red];
		j3613067564 -> j596495675;
	j1717274806 [label="Evaluate expressions on HellStory counter",color=orange];
		j1717274806 -> j235886892 [label="x >= 7",color=purple];
		j1717274806 -> j3833344431 [label="x < 7",color=purple];
		j1717274806 -> j3833344431 [label="false",color=purple];
	j803710049 [label="你覺得沒問題？",shape=box,color=red];
		j803710049 -> j1227818365;
	j3041635361 [label="如果她想要你的效忠，威脅你可不是個好主意。",shape=box,color=red];
		j3041635361 -> j1739393913;
	j3093089034 [label="當然是殺了尼托克。這也稱不上什麼反轉。她自己心裡有數，還時不時拿這事來嘲諷我。",shape=box,color=blue];
		j3093089034 -> j2266898656;
		j3093089034 -> j1489534905;
	j596495675 [label="+5 Chemistry",color=orange];
		j596495675 -> j1275536292;
	j235886892 [label="如你所知，我是她眾多玩物之一。",shape=box,color=blue];
		j235886892 -> j1745457192;
	j3833344431 [label="我是她的眾多伴侶之一，你明白嗎？",shape=box,color=blue];
		j3833344431 -> j1104766140;
		j3833344431 -> j219206340;
	j1227818365 [label="+5 Chemistry",color=orange];
		j1227818365 -> j1463970080;
	j1739393913 [label="關於 Orokin，你必須理解一件事：我們總是互相算計。",shape=box,color=blue];
		j1739393913 -> j310105256;
	j2266898656 [label="她對此並不介意？",shape=box,color=red];
		j2266898656 -> j463658018;
	j1489534905 [label="你們倆早就知道對方要殺了對方？",shape=box,color=red];
		j1489534905 -> j330947302;
	j1275536292 [label="Check boolean RoatheKnowsReset2",color=orange];
		j1275536292 -> j92171000 [label=true,color=green];
		j1275536292 -> j3837380339 [label=false,color=brown];
	j1745457192 [label="我曾經相信我們是伴侶。在政治上，在密謀中，在床上……",shape=box,color=blue];
		j1745457192 -> j1568209532;
	j1104766140 [label="商業伴侶？",shape=box,color=red];
		j1104766140 -> j2903238457;
	j219206340 [label="伴侶，什麼伴侶？",shape=box,color=red];
		j219206340 -> j997097353;
	j1463970080 [label="幾乎不會。關於 Orokin，你必須理解一件事：我們總是互相算計。",shape=box,color=blue];
		j1463970080 -> j310105256;
	j310105256 [label="我知道，如果殺死我可能幫助她達到目標， Nitokh 隨時都會毫不猶豫地這樣做。",shape=box,color=blue];
		j310105256 -> j2867948454;
	j463658018 [label="我覺得她很享受這種挑戰，篡位者。那種危險感。那種知道自己正和一個想要她命的人上床的刺激感。",shape=box,color=blue];
		j463658018 -> j4212571242;
	j330947302 [label="我倒想假裝我們是第一對陷入這種境地的 Orokin 人，但其實這種情況並不算罕見。",shape=box,color=blue];
		j330947302 -> j4212571242;
	j92171000 [label="沒錯！感覺你好像早就聽過這事。這也稱不上什麼反轉。她還時不時拿這事來嘲諷我。",shape=box,color=blue];
		j92171000 -> j2266898656;
		j92171000 -> j1489534905;
	j3837380339 [label="沒錯！這也稱不上什麼反轉。她自己心裡有數，還時不時拿這事來嘲諷我。",shape=box,color=blue];
		j3837380339 -> j2266898656;
		j3837380339 -> j1489534905;
	j1568209532 [label="當然我不認為我們是平等的。她是執行者，偉大的 Nitokh。但我認為自己是她眾多附庸中的第一人。",shape=box,color=blue];
		j1568209532 -> j143003620;
	j2903238457 [label="你真可愛。是的，某種程度上，我們是商業伴侶。但我們在許多其他更重要的方面也是伴侶。",shape=box,color=blue];
		j2903238457 -> j997097353;
	j997097353 [label="在戰爭上。在政治上，在密謀中，在床上……",shape=box,color=blue];
		j997097353 -> j972422400;
	j2867948454 [label="然而她也知道，我在她背後磨刀，期盼著能砍下她的頭。",shape=box,color=blue];
		j2867948454 -> j2094587782;
	j4212571242 [label="我活得越久，就越意識到我們這個物種或許不適合永生。",shape=box,color=blue];
		j4212571242 -> j1117711218;
	j143003620 [label="我當初真是個傻瓜……",shape=box,color=blue];
		j143003620 -> j2343979512;
		j143003620 -> j4018832804;
		j143003620 -> j3707999413;
		j143003620 -> j2791578265;
		j143003620 -> j1377487297;
	j972422400 [label="但我懷疑我是否記錯了。我懷疑用「伴侶」這個詞來形容我們之間的關係有點言過其實。 ",shape=box,color=blue];
		j972422400 -> j1792976809;
	j2094587782 [label="可以說，我們的關係……很複雜。",shape=box,color=blue];
		j2094587782 -> j1377487297;
		j2094587782 -> j2791578265;
		j2094587782 -> j3707999413;
		j2094587782 -> j2343979512;
		j2094587782 -> j4018832804;
	j1117711218 [label="但是，沒錯。你可以說 Nitokh 和我的關係……很複雜。",shape=box,color=blue];
		j1117711218 -> j1377487297;
		j1117711218 -> j2791578265;
		j1117711218 -> j3707999413;
		j1117711218 -> j2343979512;
		j1117711218 -> j4018832804;
	j2343979512 [label="你在乎過她嗎？",shape=box,color=red];
		j2343979512 -> j3089742236;
	j4018832804 [label="你愛過她嗎？",shape=box,color=red];
		j4018832804 -> j1441063823;
	j3707999413 [label="你信任過她嗎？",shape=box,color=red];
		j3707999413 -> j1295162117;
	j2791578265 [label="不要後悔你做過的事。你已經做了選擇。沒有回頭路。只能向前走。",shape=box,color=red];
		j2791578265 -> j1523887921;
	j1377487297 [label="我們唯一能做的就是睜大眼睛向前看，以彌補我們過去的行為。",shape=box,color=red];
		j1377487297 -> j2409630603;
	j1792976809 [label="畢竟她是偉大的 Nitokh。一位執行者。",shape=box,color=blue];
		j1792976809 -> j143003620;
	j3089742236 [label="虛空啊，不！如果她哪天下午喝醉後飄出氣閘，那就真的能幫我解決很多大麻煩。",shape=box,color=blue];
		j3089742236 -> j4033790164;
