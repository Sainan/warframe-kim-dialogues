digraph {
	135 [label="RoatheRank1Convo2 begins.",color=orange];
		135 -> 136;
	136 [label="你確實知道你那個所謂的「漠然」並不是一個真正的「神」，對吧？",shape=box,color=blue];
		136 -> 139;
		136 -> 138;
		136 -> 137;
	139 [label="他已經夠接近了。",shape=box,color=red];
		139 -> 142;
	138 [label="你憑什麼這麼肯定？",shape=box,color=red];
		138 -> 141;
	137 [label="[結束]",shape=box,color=red];
		137 -> 140;
	142 [label="這瘋人院裡的每個人都他媽的深信那個「牆中人」是什麼貨真價實、滑天下之大稽的神，連那兩個狂熱分子都好像認真考慮這個可能！",shape=box,color=blue];
		142 -> 144;
		142 -> 145;
		142 -> 146;
	141 [label="好吧，我們先把這殘酷的現實放一邊，那些相信有神的白痴都只是因為：第一，當他們面對死亡和靈魂終結的那種恐怖時，他們需要一個絨毛娃娃來抱著安慰自己；",shape=box,color=blue];
		141 -> 143;
	140 [label="Chat ends.",color=orange];
	144 [label="你認為他不是真實的？",shape=box,color=red];
		144 -> 148;
	145 [label="那如果你認為他不是神，你認為他是什麼？",shape=box,color=red];
		145 -> 149;
	146 [label="你也不信？",shape=box,color=red];
		146 -> 150;
	143 [label="第二，當你意識到根本沒有什麼偉大力量在為你安排人生，所以你必須為你自己的行為負責時，你所感到的那種焦慮；",shape=box,color=blue];
		143 -> 147;
	148 [label="我可說過那些話喔，篡位者，別急著把話塞到我嘴裡。我沒有否認漠然是「真實存在」的。我否認的是，「他」是神的這種說法。",shape=box,color=blue];
		148 -> 152;
		148 -> 153;
	149 [label="我可以用兩個你應該很清楚也很懂的簡單詞彙，來揭穿這個假神：",shape=box,color=blue];
		149 -> 154;
	150 [label="絕不可能！第一，這世上根本沒神，這想法有夠蠢。第二，你居然以為阿爾布雷希特那混帳能夠把一個神釋放出來？這比第一點還可笑！",shape=box,color=blue];
		150 -> 155;
	147 [label="第三，伴隨著焦慮和恐懼而來的正義的憤怒。當這一切都讓你明白，並無「地獄」靜候惡魔，亦無「天堂」恭迎天使。",shape=box,color=blue];
		147 -> 151;
	152 [label="那東西比我以前對抗過的任何東西都更強大。",shape=box,color=red];
		152 -> 156;
	153 [label="那麼，你認為他是什麼？",shape=box,color=red];
		153 -> 149;
	154 [label="概念式體現。",shape=box,color=blue];
		154 -> 157;
		154 -> 158;
		154 -> 159;
	155 [label="虛空中空無一物。正因如此，它才被稱為虛空！ ",shape=box,color=blue];
		155 -> 160;
		155 -> 161;
	151 [label="我姑且假設，你不是那種只會流口水且滿腦子只有憤怒、恐懼或焦慮的狂熱分子。在這個假設上，我準備提出我的第二個論點，來揭穿「漠然」的所謂神性：",shape=box,color=blue];
		151 -> 154;
	156 [label="我有否認過嗎？我倒是覺得，是你們成功地把自己繞進了一場歇斯底里而且毫無意義的巨大折磨裡。",shape=box,color=blue];
		156 -> 162;
		156 -> 163;
	157 [label="虛空以及我們能能利用它做的事的確很危險——相信我，我比你懂。但它是有極限的。你真以為它能憑空造出那種東西？能創造一整套語言？還能用手指啟動船艦來跳躍虛空？",shape=box,color=red];
		157 -> 164;
	158 [label="羅瑟，把他當成只是我們床底下的怪物這種想法……很誘人。但我曾和這東西面對「面」，我不知道那種東西要怎麼只靠我們的腦子就變得出來。",shape=box,color=red];
		158 -> 165;
	159 [label="概念式體現做不到牆中人能做到的事。雖然源拓氏也許顯化了那東西——也該為把牠帶來負責——但我不相信他是那東西的源頭。",shape=box,color=red];
		159 -> 166;
	160 [label="不。我見過來自虛空的東西。天使。歌聲。鬼魂。",shape=box,color=red];
		160 -> 167;
	161 [label="我……",shape=box,color=red];
		161 -> 167;
	162 [label="你到底在說什麼？",shape=box,color=red];
		162 -> 168;
	163 [label="等等。這怎麼怪到我們頭上？該怪的是阿爾布雷希特，是他把它放出來的！",shape=box,color=red];
		163 -> 169;
	164 [label="人類最了不起的地方就是在折磨自己這件事上，總能發明出五花八門的新花樣，不是嗎？你自己見過的那些殘忍玩意，我敢說在咱們那群狂熱者時代是連想都不敢想的。",shape=box,color=blue];
		164 -> 170;
	165 [label="啊，你離真相如此之近，卻又如此急於將其摒棄。它是你心智的造物這想法很對你當然很「誘人」，因為如果真是如此，就能更容易地否認它，對嗎？不。我反倒認為去面對一個由我們親手造出的造物遠比去面對一個神要危險得多。",shape=box,color=blue];
		165 -> 171;
	166 [label="我很欣賞你的謙虛，但我得挑戰一下你那有限的理解力。你根本不懂人類的創造力有多強——尤其是在發明新痛苦這方面。你自己不就以一己之力憑空捏造出你那個宇宙了嗎？",shape=box,color=blue];
		166 -> 172;
	167 [label="唯一從虛空而來的東西， 就是那個我們置於其內的東西，——以及那個從中折返的東西。它能改變物質與能量——但它無法創造它們。",shape=box,color=blue];
		167 -> 173;
	168 [label="我要說的是：阿爾布雷希特也許是最初看到他自己的傲慢化作一張獰笑的毀滅之神的臉，然後回望著他，肯定是這樣。",shape=box,color=blue];
		168 -> 174;
	169 [label="阿爾布雷希特也許是最初看到他自己的傲慢化作一張獰笑的毀滅之神的臉，然後回望著他，肯定是這樣。",shape=box,color=blue];
		169 -> 174;
	170 [label="+15 Chemistry",color=orange];
		170 -> 175;
	171 [label="一個外來的敵人，你可以去理解他。去操縱他。去打敗他。甚至逼不得已時還能跟他談判。他們有弱點可以被利用。但是一個內在的敵人？那個我們自己造出來的？那可就陰險多了。",shape=box,color=blue];
		171 -> 176;
	172 [label="你自己見過的那些殘忍玩意，我敢說在咱們那群狂熱者時代是連想都不敢想的。",shape=box,color=blue];
		172 -> 177;
	173 [label="想一想，漂泊者。你說的那些虛空天使，那些鬼魂。它們不就是用那些早就迷失在虛空裡的傢伙做的嗎？",shape=box,color=blue];
		173 -> 178;
	174 [label="但是你們所有人也都脫不了關係，你們就這樣放任這隻朱巴蜣把屎一路滾下山，越滾越大，越滾越多屎！",shape=box,color=blue];
		174 -> 179;
	175 [label="作為一種物種，我們可真了不起。總有辦法來餵養我們的恐懼，總有辦法讓它們想出新辦法來毀滅我們自己。",shape=box,color=blue];
		175 -> 180;
	176 [label="+20 Chemistry",color=orange];
		176 -> 181;
	177 [label="+10 Chemistry",color=orange];
		177 -> 175;
	178 [label="那些東西，不過是能量的反芻，就像一隻五顏六色的庫塔在反芻餵養牠的孩子。",shape=box,color=blue];
		178 -> 179;
	179 [label="容我用更簡潔的方式來解釋。我可以用兩個你應該很清楚也很懂的簡單詞彙，來揭穿這個假神：",shape=box,color=blue];
		179 -> 154;
	180 [label="嗯。恐怕我得走了。我就讓你好好想想，琢磨琢磨我說的話。",shape=box,color=blue];
		180 -> 182;
		180 -> 183;
	181 [label="因為那樣的話我們就必須和我們自己的心魔戰鬥。而人類……從來都贏不了那種戰爭，不是嗎？",shape=box,color=blue];
		181 -> 180;
	182 [label="我會的。謝謝。",shape=box,color=red];
		182 -> 184;
	183 [label="也請你琢磨琢磨我的話。等你真的要去對付一個神的反面的時候，你可能就巴不得寧願神是真的了",shape=box,color=red];
		183 -> 184;
	184 [label="Update boolean RoatheMITW1",color=orange];
		184 -> 185;
	185 [label="Chat ends.",color=orange];
}