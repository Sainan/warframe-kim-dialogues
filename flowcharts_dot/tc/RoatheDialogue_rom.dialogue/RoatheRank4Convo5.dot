digraph {
	"RoatheRank4Convo5 begins." [color=orange];
		"RoatheRank4Convo5 begins." -> j2479609706;
	j2479609706 [label="篡位者，你還記得多少你在帝國時期的日子？看起來充其量只是零碎片段。不過我可沒資格評判，你懂的。",shape=box,color=blue];
		j2479609706 -> j3364612382;
		j2479609706 -> j135574538;
		j2479609706 -> j1578639778;
		j2479609706 -> j1350559949;
	j3364612382 [label="足以知道你們所有人都活該被燒死。",shape=box,color=red];
		j3364612382 -> j892613128;
	j135574538 [label="零零碎碎的一些片段。怎麼了嗎？",shape=box,color=red];
		j135574538 -> j3482181029;
	j1578639778 [label="我們被送上扎日曼號時我還很小。而在那之後……嗯。",shape=box,color=red];
		j1578639778 -> j3482181029;
	j1350559949 [label="[結束]",shape=box,color=red];
		j1350559949 -> "Chat ends.";
	j892613128 [label="這相當公平。然而，這樣你就缺失了我們歷史和文化記錄的很大一部分。我知道在帝國滅亡後，我們就像過街老鼠人人喊打，但是……",shape=box,color=blue];
		j892613128 -> j2229322852;
	j3482181029 [label="嗯。只是讓我覺得奇怪，我們社會和文化的完整記錄留存如此稀少。我知道帝國覆滅後我們不得人心，但……",shape=box,color=blue];
		j3482181029 -> j3390098042;
	"Chat ends." [color=orange];
	j2229322852 [label="連凍陵發生了什麼都沒有任何記載？",shape=box,color=blue];
		j2229322852 -> j1876694425;
		j2229322852 -> j3017531330;
	j3390098042 [label="連凍陵發生了什麼都沒有任何記載？",shape=box,color=blue];
		j3390098042 -> j1122309092;
		j3390098042 -> j418196223;
	j1876694425 [label="這最終會是某種可怕的 Orokin 酷刑嗎？",shape=box,color=red];
		j1876694425 -> j1712634309;
	j3017531330 [label="我覺得如果我以前聽過這個詞，我會記得的。",shape=box,color=red];
		j3017531330 -> j3172981120;
	j1122309092 [label="凍……什麼？",shape=box,color=red];
		j1122309092 -> j290104496;
	j418196223 [label="我覺得如果我以前聽過這個詞，我會記得的。",shape=box,color=red];
		j418196223 -> j290104496;
	j1712634309 [label="意外的是……並沒有。或許是因為在過去……的大多歲月，我都和這兩個狂熱份子一起被困在這個墓穴裡，但讓我震驚的是，數千年來，關於 Orokin 如何處理死者的記錄完全沒有留存下來。",shape=box,color=blue];
		j1712634309 -> j1763515951;
		j1712634309 -> j2789553857;
	j3172981120 [label="或許是因為在過去……的大多歲月，我都和這兩個狂熱份子一起被困在這個墓穴裡，但讓我震驚的是，數千年來，關於 Orokin 如何處理死者的記錄完全沒有留存下來。",shape=box,color=blue];
		j3172981120 -> j2234111560;
		j3172981120 -> j497276804;
	j290104496 [label="或許是因為在過去……的大多歲月，我都和這兩個狂熱份子一起被困在這個墓穴裡，但讓我震驚的是，數千年來，關於 Orokin 如何處理死者的記錄完全沒有留存下來。",shape=box,color=blue];
		j290104496 -> j445251486;
		j290104496 -> j1062770621;
	j1763515951 [label="我以為你們不會死。你們只是在承體廳堂借屍還魂。",shape=box,color=red];
		j1763515951 -> j2587165318;
	j2789553857 [label="我以為你們借屍還魂來解決那個問題。你們所做的只是嘲弄死亡。",shape=box,color=red];
		j2789553857 -> j822457608;
	j2234111560 [label="我以為你們不會死。你們只是在承體廳堂借屍還魂。",shape=box,color=red];
		j2234111560 -> j2587165318;
	j497276804 [label="繼續說。",shape=box,color=red];
		j497276804 -> j1519733309;
	j445251486 [label="我以為你們不會死。你們只是在承體廳堂借屍還魂。",shape=box,color=red];
		j445251486 -> j3353042386;
	j1062770621 [label="繼續說。",shape=box,color=red];
		j1062770621 -> j1825500848;
	j2587165318 [label="是的，但那些「接近」但「不夠重要」的其他人呢？哲士？或者低端的 Orokin 人？階級中總是有階級。即使天花板是玻璃的，天花板確實存在。相信我。",shape=box,color=blue];
		j2587165318 -> j1338569111;
	j822457608 [label="我們確實如此。在每一個可能的轉折點。但不是所有人都倖免，對吧？那些「接近」但「不夠重要」的人呢？哲士？低端的 Orokin 人呢？",shape=box,color=blue];
		j822457608 -> j2855345924;
	j1519733309 [label="考慮一下所有那些「接近」但「不夠重要」的人。哲士。低階的 Orokin 人。階級中總是有階級。即使天花板是玻璃的，天花板確實存在。相信我。",shape=box,color=blue];
		j1519733309 -> j1338569111;
	j3353042386 [label="是的，但那些「接近」但「不夠重要」的其他人呢？哲士？或者低端的 Orokin 人？階級中總是有階級。即使天花板是玻璃的，天花板確實存在。相信我。",shape=box,color=blue];
		j3353042386 -> j1369041204;
	j1825500848 [label="考慮一下所有那些「接近」但「不夠重要」的人。哲士。低階的 Orokin 人。階級中總是有階級。即使天花板是玻璃的，天花板確實存在。相信我。",shape=box,color=blue];
		j1825500848 -> j1369041204;
	j1338569111 [label="並非所有人都如此幸運，每當他們的舊的肉體燃盡時就能獲得新的肉體。但我確信你認為承體承續是一種令人厭惡的做法，是吧？",shape=box,color=blue];
		j1338569111 -> j336445546;
		j1338569111 -> j2610645658;
	j2855345924 [label="並非所有人都如此幸運，每當他們的舊的肉體燃盡時就能獲得新的肉體。顯然，你認為承體承續是一種令人厭惡的做法。",shape=box,color=blue];
		j2855345924 -> j4138632336;
		j2855345924 -> j2610645658;
	j1369041204 [label="並非所有人都如此幸運，每當他們的舊的肉體燃盡時就能獲得新的肉體。但我確信你認為承體承續是一種令人厭惡的做法，是吧？",shape=box,color=blue];
		j1369041204 -> j1138565124;
		j1369041204 -> j1266156813;
	j336445546 [label="我對這種做法了解不夠，無法做出判斷。",shape=box,color=red];
		j336445546 -> j3263586573;
	j2610645658 [label="我確實這麼想。我認為你們所做的一切都很噁心。關於承體廳堂所有記載都說你們偷走了孩子並抹去了他們的意識。",shape=box,color=red];
		j2610645658 -> j869345414;
	j4138632336 [label="我怎麼能不這麼認為？你們從人們家中綁架孩子，抹去他們的意識來替換成你們自己的！",shape=box,color=red];
		j4138632336 -> j1472900918;
	j1138565124 [label="我對這種做法了解不夠，無法做出判斷。",shape=box,color=red];
		j1138565124 -> j3755613116;
	j1266156813 [label="我確實這麼想。我認為你們所做的一切都很噁心。關於承體廳堂所有記載都說你們偷走了孩子並抹去了他們的意識。",shape=box,color=red];
		j1266156813 -> j676000949;
	j3263586573 [label="+5 Chemistry",color=orange];
		j3263586573 -> j1456348463;
	j869345414 [label="「關於承體廳堂的所有記載都說。」這些東西都記錄在哪裡？更重要的是，誰寫下了所有這些東西？",shape=box,color=blue];
		j869345414 -> j1429258932;
	j1472900918 [label="你怎麼知道這一切的？你親眼目睹過承體廳堂嗎？",shape=box,color=blue];
		j1472900918 -> j761427877;
		j1472900918 -> j2543224003;
		j1472900918 -> j3389844467;
	j3755613116 [label="+5 Chemistry",color=orange];
		j3755613116 -> j1456348463;
	j676000949 [label="然而你剛才說只有我們歷史和文化記錄的碎片留存下來。這些東西都記錄在哪裡？更重要的是，誰寫下了所有這些東西？",shape=box,color=blue];
		j676000949 -> j1429258932;
	j1456348463 [label="在掌握所有資訊之前保留判斷？天哪，篡位者！你聽起來很聰明！還真是稀奇！",shape=box,color=blue];
		j1456348463 -> j2650546844;
	j1429258932 [label="這些故事是由那些極力想把 Orokin 的一切都渲染得盡可能災難和邪惡的人所講述的。",shape=box,color=blue];
		j1429258932 -> j759416800;
	j761427877 [label=" 沒有。",shape=box,color=red];
		j761427877 -> j29651220;
	j2543224003 [label="有。",shape=box,color=red];
		j2543224003 -> j3800574521;
	j3389844467 [label="我有沒有都無所謂，記載很清楚。",shape=box,color=red];
		j3389844467 -> j2951645105;
	j2650546844 [label="那麼請允許我為你轉換歷史的視角，如果可以的話。想一下你可能聽到的關於承體廳堂的記載是出自哪裡。",shape=box,color=blue];
		j2650546844 -> j1429258932;
	j759416800 [label="因為那些摧毀始源星系社會的所有支柱並將其推入徹底混亂的人，必須給依靠這個社會的人們一個充分的理由。",shape=box,color=blue];
		j759416800 -> j2627356993;
	j29651220 [label="那麼你依賴的是二手資訊。想一下這些記載寫在哪裡。更重要的是，想一下是誰寫下了它們。",shape=box,color=blue];
		j29651220 -> j1429258932;
	j3800574521 [label="哈！騙子。",shape=box,color=blue];
		j3800574521 -> j686954750;
	j2951645105 [label="是嗎？想一下這些記載寫在哪裡。更重要的是，考慮是誰寫下了所有這些記載。",shape=box,color=blue];
		j2951645105 -> j1429258932;
	j2627356993 [label="篡位者，想一下中繼站上普通人類的生活。一個遠離 Tenno 試煉和磨難的人。一個對大戰爭毫不關心的人。",shape=box,color=blue];
		j2627356993 -> j3053716935;
	j686954750 [label="你依賴的是二手資訊。想一下這些記載寫在哪裡。更重要的是，想一下是誰寫下了它們。",shape=box,color=blue];
		j686954750 -> j1429258932;
	j3053716935 [label="當 Orokin 滅亡時，他們的生活在隨之而來的權力真空中被拋入絕對的地獄。他們必須編造解釋、製造和焚燒替罪羔羊。我們必須成為黑暗中的怪物。",shape=box,color=blue];
		j3053716935 -> j3607046046;
		j3053716935 -> j196231823;
	j3607046046 [label="你是在告訴我，你們沒有違背意願綁架兒童去承體廳堂嗎？",shape=box,color=red];
		j3607046046 -> j3288643927;
	j196231823 [label="那麼承體廳堂到底發生了什麼？",shape=box,color=red];
		j196231823 -> j3884407714;
	j3288643927 [label="不，那是完全正確的。",shape=box,color=blue];
		j3288643927 -> j4052395314;
	j3884407714 [label="+5 Chemistry",color=orange];
		j3884407714 -> j1846145994;
	j4052395314 [label="我只是想讓你注意一下你的資料來源，僅此而已。",shape=box,color=blue];
		j4052395314 -> j1184899867;
	j1846145994 [label="說我們沒有違背祭品的意願擄走他們是不正確的。我們確實有這樣做。但這並非全部真相。這些事情沒有看上去那般單純，往往都不是那麼黑白分明。",shape=box,color=blue];
		j1846145994 -> j497713414;
	j1184899867 [label="因為這並非全部真相。這些事情沒有看上去那般單純，往往都不是那麼黑白分明。篡位者，世界是灰色的。而界線也沒那麼容易劃分。",shape=box,color=blue];
		j1184899867 -> j2427423757;
	j497713414 [label="篡位者，世界是灰色的。而界線也沒那麼容易劃分。",shape=box,color=blue];
		j497713414 -> j2427423757;
	j2427423757 [label="這種做法一開始並不是以如此可恥的方式開始的。起初，它被視為最高的榮譽。獻出自己，使帝國能夠不間斷、不屈不撓地延續下去。只為帝國霸業能夠繼續。",shape=box,color=blue];
		j2427423757 -> j1445506442;
	j1445506442 [label="它起初也並非針對年輕人。最初是那些壽命尚長的人。但隨後自願獻身者變得……越來越年輕。虔誠是一劑猛藥。",shape=box,color=blue];
		j1445506442 -> j1263529823;
	j1263529823 [label="我在那些報名參戰的人身上看到了類似的情況。在文書上謊報年齡去「為正義而戰」。他們不知道他們正在為那些將被迫在他們之後到來的人樹立一個危險的先例。",shape=box,color=blue];
		j1263529823 -> j4001822046;
	j4001822046 [label="因為在某個時候，某個執行者意識到它可以作為……懲罰手段。只要用承體廳堂來威脅，某些城市或……整個星球都能被控制住。尤其當以特別強硬的方式徵收祭品時。",shape=box,color=blue];
		j4001822046 -> j317678189;
		j4001822046 -> j1479344803;
	j317678189 [label="你對此事作何感想？",shape=box,color=red];
		j317678189 -> j3785039711;
	j1479344803 [label="你有沒有參與過非自願的祭品？",shape=box,color=red];
		j1479344803 -> j745276694;
	j3785039711 [label="+5 Chemistry",color=orange];
		j3785039711 -> j3937091865;
	j745276694 [label="我不會對你撒謊。我有。你可以隨意認為我是個怪物。但當你的整個社會建立在數百年對某事的正常化之上時，很難背棄它。",shape=box,color=blue];
		j745276694 -> j4211923068;
	j3937091865 [label="嗯。複雜。一方面，我自己多次參與了承體廳堂的儀式。如果我譴責它，我就是終極偽君子。當你的整個社會建立在數百年對某事的正常化之上時，很難背棄它。",shape=box,color=blue];
		j3937091865 -> j188460189;
	j4211923068 [label="即使在回顧中，或在清醒的時刻，這一切是如此清楚明白。",shape=box,color=blue];
		j4211923068 -> j2300983163;
	j188460189 [label="另一方面，如果脫離環境來看，或者事後回顧，這件事的恐怖本質就變得十分清晰。",shape=box,color=blue];
		j188460189 -> j2300983163;
	j2300983163 [label="+5 Chemistry",color=orange];
		j2300983163 -> j2178024908;
	j2178024908 [label="篡位者，沒有人應該永生。承體廳堂就是最好的證明。",shape=box,color=blue];
		j2178024908 -> "Chat ends.";
}