		j2884433088 -> j1086654821;
	j1086654821 [label="在 Sentient 第一次遠征襲擊後，我們就準備了懲罰性的反擊。",shape=box,color=blue];
		j1086654821 -> j2550090066;
	j2550090066 [label="金魅號從穀神星的霧中以致命之翼升起，一艘滿載無人機和銀甲戰士的帆船戰艦。",shape=box,color=blue];
		j2550090066 -> j652617019;
	j652617019 [label="精細如霧的電路在他們半透明的裝甲下形成精緻的蕾絲。",shape=box,color=blue];
		j652617019 -> j771284409;
	j771284409 [label="她如此龐大，幾乎無法通過星際軌道的邊緣。",shape=box,color=blue];
		j771284409 -> j4002162579;
	j4002162579 [label="Sentient 確保我們看到了結果。他們歌唱，而我們的技術失效了。我們的戰士在閃亮的盔甲內掙扎窒息。",shape=box,color=blue];
		j4002162579 -> j1623573928;
	j1623573928 [label="金魅號的船員活活被烤死，她如天鵝俯衝般失去動力，穿過Tau的天空，成了一個複雜而昂貴的煙火秀。",shape=box,color=blue];
		j1623573928 -> j921430358;
