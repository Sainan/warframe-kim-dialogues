		j999369126 -> j2874648323;
	j3288003164 [label="「你醒來發現自己在地下深處的一間陰暗潮濕的地牢牢房內。在鐵杆門外的走廊裡，一名守衛正在打呼嚕。患有睡眠呼吸中止症？他或許應該去體檢一下。你不太記得了，但你知道自己必須逃出去。」",shape=box,color=blue];
