		j4218146088 -> j4131891852;
	j1246653565 [label="接著我們又再次循環，不會有人記得他們不喜歡上次循環的作戰計劃，但在時空結構上有一些微妙的印痕，讓他們本能地意識到上一次循環裡我的作戰計劃讓他們感到很無聊。所以他們死都不想在任何循環裡再玩了，永遠不想",shape=box,color=blue];
