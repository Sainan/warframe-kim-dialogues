		j3635938057 -> j1168789816;
	j4244343500 [label="拿起剪線鉗。",shape=box,color=red];
		j4244343500 -> j4056847696;
	j4221069571 [label="拿起撬棍。",shape=box,color=red];
		j4221069571 -> j607192801;
	j4148060287 [label="我",shape=box,color=blue];
		j4148060287 -> j41840385;
	j3396203511 [label="Boolean WhatLoop3 is now true.",color=orange];
		j3396203511 -> j1243822504;
	j1168789816 [label="Boolean ControlPanel is now true.",color=orange];
		j1168789816 -> j3136528501;
	j4056847696 [label="Boolean WireCutters is now true.",color=orange];
		j4056847696 -> j130313587;
	j607192801 [label="「你拿起沉重的撬棍，這是個厚實的工具。男人嘴巴被封住的叫聲變得更加強烈。」",shape=box,color=blue];
		j607192801 -> j2595799736;
		j607192801 -> j2499283276;
		j607192801 -> j1627231303;
	j41840385 [label="我得先阻止你，不然你會讓我患上腕道症候群還是什麼的",shape=box,color=blue];
		j41840385 -> j3499126904;
	j3136528501 [label="Check boolean PanelSmashed",color=orange];
		j3136528501 -> j1296871445 [label=true,color=green];
		j3136528501 -> j1772430913 [label=false,color=brown];
	j130313587 [label="「剪線鉗是工業級的，看起來幾乎可以剪斷任何東西。」",shape=box,color=blue];
		j130313587 -> j4033896007;
	j2595799736 [label="使用撬棍砸爛控制面板。",shape=box,color=red];
		j2595799736 -> j1110728012;
	j2499283276 [label="大力把撬棍甩向渦輪機葉片。",shape=box,color=red];
		j2499283276 -> j673719542;
	j1627231303 [label="繼續到處查看",shape=box,color=red];
		j1627231303 -> j1571667540;
	j3499126904 [label="這要嘛是虐待，要嘛是你真的很遜",shape=box,color=blue];
		j3499126904 -> j1056908451;
	j1296871445 [label="「你大概不會想再動那東西了。」",shape=box,color=blue];
		j1296871445 -> j4244343500;
		j1296871445 -> j4221069571;
	j1772430913 [label="「你試圖使用控制面板，但它被安全協定鎖住了，連你都無法破解。你意識到你必須手動操作。」",shape=box,color=blue];
		j1772430913 -> j4244343500;
		j1772430913 -> j4221069571;
	j4033896007 [label="剪斷電纜。",shape=box,color=red];
		j4033896007 -> j995680227;
	j1110728012 [label="Boolean ControlPanel is now true.",color=orange];
		j1110728012 -> j572503223;
	j673719542 [label="「你大力把撬棍甩進渦輪機。房間裡充滿了齒輪和活塞摩擦的刺耳巨響。隨著渦輪機慢慢停止運轉。」",shape=box,color=blue];
		j673719542 -> j2581235939;
	j1056908451 [label="所以呢，我們就直接跳到下個部分了",shape=box,color=blue];
		j1056908451 -> j465314147;
	j995680227 [label="Check boolean TurbineStopped",color=orange];
		j995680227 -> j481121408 [label=true,color=green];
		j995680227 -> j3022275626 [label=false,color=brown];
	j572503223 [label="Check boolean PanelSmashed",color=orange];
		j572503223 -> j2471061508 [label=true,color=green];
		j572503223 -> j2054187879 [label=false,color=brown];
	j2581235939 [label="「男人鬆了口氣癱倒下來說，『帶我離開這裡。』」",shape=box,color=blue];
		j2581235939 -> j207191395;
	j465314147 [label="咳咳",shape=box,color=blue];
		j465314147 -> j1258041761;
	j481121408 [label="「剪線鉗很快就剪斷了連接到男人身上的電纜。他的雙臂重獲自由後，他就能夠解開身上的其他束縛了。」",shape=box,color=blue];
		j481121408 -> j3197914880;
	j3022275626 [label="「你把剪線鉗的刀口夾住冒著電弧的電纜，立刻就後悔了。電流通過剪線鉗流入你的身體，把你電得向後飛出去。」",shape=box,color=blue];
		j3022275626 -> j113308316;
	j2471061508 [label="「上次那樣做的結果並不太好。」",shape=box,color=blue];
		j2471061508 -> j1627231303;
		j2471061508 -> j2499283276;
	j2054187879 [label="「當你砸爛控制面板時，被困住的男人似乎在對你大喊大叫。他不喜歡你那樣做。」",shape=box,color=blue];
		j2054187879 -> j1502386489;
	j207191395 [label="Boolean TurbineStopped is now true.",color=orange];
		j207191395 -> j4033896007;
	j1258041761 [label="（清嗓子）",shape=box,color=blue];
		j1258041761 -> j3828546101;
	j3197914880 [label="「男人摘下他的圓形墨鏡，仔細打量著他的救命恩人。」",shape=box,color=blue];
		j3197914880 -> j3499241272;
	j113308316 [label="「你摔落在地板上昏了過去後慢慢醒了過來。那個男人還是很痛苦，現在你的頭髮被電到站了起來。」",shape=box,color=blue];
		j113308316 -> j970257374;
	j1502386489 [label="Boolean PanelSmashed is now true.",color=orange];
		j1502386489 -> j1627231303;
		j1502386489 -> j2499283276;
	j3828546101 [label="「不知道為什麼，渦輪機竟然在男人純粹力量下奇蹟般地爆炸了！」",shape=box,color=blue];
		j3828546101 -> j3150533557;
	j3499241272 [label="Check boolean AmirDating",color=orange];
		j3499241272 -> j3986544842 [label=true,color=green];
		j3499241272 -> j2792139094 [label=false,color=brown];
	j970257374 [label="Boolean Zapped is now true.",color=orange];
		j970257374 -> j1571667540;
	j3150533557 [label="「男人摘下他的圓形眼鏡，仔細打量著他的救命恩人。」",shape=box,color=blue];
		j3150533557 -> j2498657901;
	j3986544842 [label="「他的眼神很犀利。」",shape=box,color=blue];
		j3986544842 -> j180685364;
	j2792139094 [label="圓形眼鏡是吧，那他叫什麼名字？",shape=box,color=red];
		j2792139094 -> j1710731683;
	j2498657901 [label="呃，我的意思是",shape=box,color=blue];
		j2498657901 -> j4107155370;
	j180685364 [label="「你注意到他強壯的雙手，堅硬的前臂，和結實的雙腿。你挑著眉毛想『天生的速度奇才。』」",shape=box,color=blue];
		j180685364 -> j777761025;
	j1710731683 [label="「『我叫扎比爾。』他自信地說道。」",shape=box,color=blue];
		j1710731683 -> j2252705613;
	j4107155370 [label="「男人摘下他的圓形眼鏡，仔細打量著這名試圖救他的人。」",shape=box,color=blue];
		j4107155370 -> j3499241272;
	j777761025 [label="大傢伙，慢著。這位帥哥叫什麼名字？",shape=box,color=red];
		j777761025 -> j1710731683;
	j2252705613 [label="聽起來很熟悉。他們在對你做什麼？",shape=box,color=red];
		j2252705613 -> j1977526098;
	j1977526098 [label="「『他們在汲取我體內的能量。我充滿電力，但你大概已經注意到了。』扎比爾說道。」",shape=box,color=blue];
		j1977526098 -> j2015883517;
	j2015883517 [label="好吧，扎比爾，我們要怎麼拯救 Lotus。",shape=box,color=red];
		j2015883517 -> j947598597;
	j947598597 [label="扎比爾感到震驚。「拯救 Lotus？是她把我關在這裡的！我們要趕快離開這個小行星！」",shape=box,color=blue];
		j947598597 -> j1006016236;
		j947598597 -> j2853346713;
	j1006016236 [label="阿米爾，這是怎麼回事？",shape=box,color=red];
		j1006016236 -> j2438114656;
	j2853346713 [label="你把 Lotus 設定成大反派了？",shape=box,color=red];
