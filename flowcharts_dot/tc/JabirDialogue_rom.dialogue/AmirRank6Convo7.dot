		4334 -> 4337;
	4335 [label="「你注意到他強壯的雙手，堅硬的前臂，和結實的雙腿。你挑著眉毛想『天生的速度奇才。』」",shape=box,color=blue];
		4335 -> 4338;
	4336 [label="「『我叫扎比爾。』他自信地說道。」",shape=box,color=blue];
		4336 -> 4339;
	4337 [label="「男人摘下他的圓形眼鏡，仔細打量著這名試圖救他的人。」",shape=box,color=blue];
		4337 -> 4329;
	4338 [label="大傢伙，慢著。這位帥哥叫什麼名字？",shape=box,color=red];
