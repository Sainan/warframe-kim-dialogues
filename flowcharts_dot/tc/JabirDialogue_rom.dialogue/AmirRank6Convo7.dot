	4267 [label="Chat ends.",color=orange];
	4268 [label="「你發現自己站在一座大型服務電梯前。原來這裡不單純只是個地牢？」",shape=box,color=blue];
		4268 -> 4269;
		4268 -> 4270;
	4269 [label="返回地牢。",shape=box,color=red];
		4269 -> 4271;
	4270 [label="搭乘電梯。",shape=box,color=red];
		4270 -> 4272;
	4271 [label="「你轉過身看了下地牢，心想『回到那裡是個愚蠢的想法。』」",shape=box,color=blue];
		4271 -> 4273;
	4272 [label="「你搭乘電梯往上。透過開放的電梯廂，你可以看到地牢的石牆被越來越先進的科技所取代。你再次疑惑，『我到底在哪裡？』」",shape=box,color=blue];
		4272 -> 4274;
	4273 [label="哈哈……好吧，那就搭乘那台電梯吧。",shape=box,color=red];
		4273 -> 4272;
	4274 [label="「走出電梯，你來到一個擺滿咕嚕作響的機器和佈滿巨大管線的大廳。這是某種實驗室嗎？」",shape=box,color=blue];
		4274 -> 4275;
	4275 [label="你聽到走廊盡頭的房間裡，傳來一個男人痛苦的叫聲。",shape=box,color=blue];
		4275 -> 4276;
		4275 -> 4277;
	4276 [label="別管叫聲了，先找條出路。",shape=box,color=red];
		4276 -> 4278;
	4277 [label="去找哭喊的男人。",shape=box,color=red];
		4277 -> 4279;
	4278 [label="「你在走廊到處尋找任何有價值的東西，但哭聲變得無法忽視。這個男人的狀況引起了你的好奇心，讓你無法置身事外，你決定幫助他。」",shape=box,color=blue];
		4278 -> 4279;
	4279 [label="「你沿著走廊循著痛苦的聲源走去。你走進一間大型機房，在那裡你看見一個男人。一個不錯看的男人，被綁在一個機台上。電弧在他指尖上舞動，流進一個巨大的渦輪機，為其供給驅動力。」",shape=box,color=blue];
		4279 -> 4280;
		4279 -> 4281;
	4280 [label="問他，「怎麼樣？」",shape=box,color=red];
		4280 -> 4282;
	4281 [label="檢查男人的情況。",shape=box,color=red];
		4281 -> 4282;
	4282 [label="「這個男人被綁在一個升起的平台上，雙臂張開。他的指尖連接著探針，這些探針纏繞在一起形成一條厚重的電纜，通向一個巨大的渦輪機。電弧靈巧地在他的指尖上舞動。」",shape=box,color=blue];
		4282 -> 4283;
	4283 [label="在哀嚎聲和電擊聲之間，男人掙扎著說出，「停止……渦輪機！！」",shape=box,color=blue];
		4283 -> 4284;
	4284 [label="檢查房間。",shape=box,color=red];
		4284 -> 4285;
	4285 [label="「你在房間到處查找有用的東西。你看到一張擺著工具的工作台。上面有個撬棍、巨大剪線鉗、還有控制面板。」",shape=box,color=blue];
