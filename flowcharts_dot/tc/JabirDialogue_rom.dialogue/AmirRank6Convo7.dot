		j1345898161 -> "Chat ends.";
	j4066425749 [label="「當你轉動意外友善的龐大鼠群給你的那把鑰匙時，你祈禱門背後的遭遇會比身後的地牢更好。」",shape=box,color=blue];
		j4066425749 -> j1789310100;
	"Chat ends. Next chat will be AmirRank6Convo3." [color=orange];
	"Chat ends. Next chat will be AmirRank6Convo2." [color=orange];
	j1789310100 [label="「你發現自己站在一座大型服務電梯前。原來這裡不單純只是個地牢？」",shape=box,color=blue];
		j1789310100 -> j428483227;
		j1789310100 -> j93526024;
	j428483227 [label="返回地牢。",shape=box,color=red];
		j428483227 -> j2299194314;
	j93526024 [label="搭乘電梯。",shape=box,color=red];
		j93526024 -> j1227037149;
	j2299194314 [label="「你轉過身看了下地牢，心想『回到那裡是個愚蠢的想法。』」",shape=box,color=blue];
		j2299194314 -> j2409544897;
	j1227037149 [label="「你搭乘電梯往上。透過開放的電梯廂，你可以看到地牢的石牆被越來越先進的科技所取代。你再次疑惑，『我到底在哪裡？』」",shape=box,color=blue];
		j1227037149 -> j4099907920;
	j2409544897 [label="哈哈……好吧，那就搭乘那台電梯吧。",shape=box,color=red];
		j2409544897 -> j1227037149;
	j4099907920 [label="「走出電梯，你來到一個擺滿咕嚕作響的機器和佈滿巨大管線的大廳。這是某種實驗室嗎？」",shape=box,color=blue];
		j4099907920 -> j3052188695;
	j3052188695 [label="你聽到走廊盡頭的房間裡，傳來一個男人痛苦的叫聲。",shape=box,color=blue];
		j3052188695 -> j720271507;
		j3052188695 -> j3481641111;
	j720271507 [label="別管叫聲了，先找條出路。",shape=box,color=red];
		j720271507 -> j1572987599;
	j3481641111 [label="去找哭喊的男人。",shape=box,color=red];
		j3481641111 -> j1759024101;
	j1572987599 [label="「你在走廊到處尋找任何有價值的東西，但哭聲變得無法忽視。這個男人的狀況引起了你的好奇心，讓你無法置身事外，你決定幫助他。」",shape=box,color=blue];
		j1572987599 -> j1759024101;
	j1759024101 [label="「你沿著走廊循著痛苦的聲源走去。你走進一間大型機房，在那裡你看見一個男人。一個不錯看的男人，被綁在一個機台上。電弧在他指尖上舞動，流進一個巨大的渦輪機，為其供給驅動力。」",shape=box,color=blue];
		j1759024101 -> j1953542752;
		j1759024101 -> j3915032805;
	j1953542752 [label="問他，「怎麼樣？」",shape=box,color=red];
		j1953542752 -> j2528250532;
	j3915032805 [label="檢查男人的情況。",shape=box,color=red];
		j3915032805 -> j2528250532;
	j2528250532 [label="「這個男人被綁在一個升起的平台上，雙臂張開。他的指尖連接著探針，這些探針纏繞在一起形成一條厚重的電纜，通向一個巨大的渦輪機。電弧靈巧地在他的指尖上舞動。」",shape=box,color=blue];
		j2528250532 -> j1893492416;
	j1893492416 [label="在哀嚎聲和電擊聲之間，男人掙扎著說出，「停止……渦輪機！！」",shape=box,color=blue];
		j1893492416 -> j1369478113;
	j1369478113 [label="檢查房間。",shape=box,color=red];
		j1369478113 -> j3417299084;
	j3417299084 [label="「你在房間到處查找有用的東西。你看到一張擺著工具的工作台。上面有個撬棍、巨大剪線鉗、還有控制面板。」",shape=box,color=blue];
		j3417299084 -> j1571667540;
	j1571667540 [label="Check boolean WhatLoop",color=orange];
		j1571667540 -> j4289283942 [label=true,color=green];
