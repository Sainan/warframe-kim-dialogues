	4318 [label="咳咳",shape=box,color=blue];
		4318 -> 4324;
	4319 [label="「剪線鉗很快就剪斷了連接到男人身上的電纜。他的雙臂重獲自由後，他就能夠解開身上的其他束縛了。」",shape=box,color=blue];
		4319 -> 4325;
	4320 [label="「你把剪線鉗的刀口夾住冒著電弧的電纜，立刻就後悔了。電流通過剪線鉗流入你的身體，把你電得向後飛出去。」",shape=box,color=blue];
		4320 -> 4326;
