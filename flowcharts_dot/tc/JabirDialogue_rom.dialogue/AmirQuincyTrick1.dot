digraph {
	3492 [label="AmirQuincyTrick1 begins.",color=orange];
		3492 -> 3493;
		3492 -> 3495;
	3493 [label="嘿，阿米爾，在嗎？",shape=box,color=red];
		3493 -> 3494;
	3495 [label="[無視]",shape=box,color=red];
		3495 -> 3496;
	3494 [label="怎麼樣，朋友？！",shape=box,color=blue];
		3494 -> 3497;
		3494 -> 3498;
	3496 [label="Chat ends.",color=orange];
	3497 [label="機器人。",shape=box,color=red];
		3497 -> 3499;
	3498 [label="那個……崑西在對你惡作劇，而我就是幌子。",shape=box,color=red];
		3498 -> 3500;
	3499 [label="機器人──",shape=box,color=blue];
		3499 -> 3501;
	3500 [label="蛤？！惡作劇是嗎？像……什麼樣的惡作劇……？",shape=box,color=blue];
		3500 -> 3502;
		3500 -> 3503;
	3501 [label="（咳嗽）我的意思是……怎麼了嗎？你想說關於這些你所提到的機器人的什麼事？",shape=box,color=blue];
		3501 -> 3504;
		3501 -> 3505;
	3502 [label="他在用包裝填充物塞滿你整間房間。",shape=box,color=red];
		3502 -> 3506;
	3503 [label="老實說，我覺得這是他表達關心的方式。",shape=box,color=red];
		3503 -> 3507;
	3504 [label="我有告訴過你關於金星上的巨型機器蜘蛛的事嗎？",shape=box,color=red];
		3504 -> 3508;
	3505 [label="我有告訴過你關於機器獵犬的事嗎？",shape=box,color=red];
		3505 -> 3509;
	3506 [label="什麼！從來就沒有人關心我到這種程度，用包裝填充物塞滿我整間房間。",shape=box,color=blue];
		3506 -> 3510;
	3507 [label="……嗚嗚嗚……好開心喔！從來就沒有人會喜歡我到對我惡作劇！",shape=box,color=blue];
		3507 -> 3510;
	3508 [label="我好像在哪部電影裡有看過",shape=box,color=blue];
		3508 -> 3511;
	3509 [label="你、有、機器、狗？！",shape=box,color=blue];
		3509 -> 3512;
	3510 [label="好吧，我不會表露出已經從你那裡得知他在做什麼事的樣子，我只會坐在這裡，假裝忙著編寫我的遊戲的程式碼，哈哈",shape=box,color=blue];
		3510 -> 3524;
	3511 [label="但那不是科幻片，而是西部片。整體來說它還蠻爛的，但說實話我還算喜歡",shape=box,color=blue];
		3511 -> 3513;
	3512 [label="我突然意識到人生有了新的使命。我需要擁有一隻機器狗。我要幫它取名斐多。或是破爛。或是晶片。昌片！晶片是最棒的機器狗名字",shape=box,color=blue];
		3512 -> 3514;
	3524 [label="+20 Chemistry",color=orange];
		3524 -> 3526;
	3513 [label="我的意思是，它知道自己想成為什麼樣的電影，只是它並沒有太把自己當回事，你知道嗎？沒有什麼比一部牛仔電影裡出現一隻巨型蒸氣龐克蜘蛛，想藉此手法把自己定義為高級藝術片更讓我煩躁的了，哈哈哈",shape=box,color=blue];
		3513 -> 3515;
	3514 [label="如果你有不同意見的話，我就會跟你打起來",shape=box,color=blue];
		3514 -> 3516;
	3526 [label="呵呵，但我希望他意識到這當然……意味著……戰爭開打！",shape=box,color=blue];
		3526 -> 3592;
	3515 [label="我不是說這部電影是高級藝術片，這正是我想說的。這部電影沒有那樣，但它確實有個巨型機器蜘蛛。雖然我相信你說的那些屬於更高科技的蜘蛛",shape=box,color=blue];
		3515 -> 3517;
	3516 [label="懂嗎？是「晶片」，哈哈，因為電腦裡有晶片，比如……電腦晶片，懂了嗎？……你那個時代的電腦還用晶片嗎？",shape=box,color=blue];
		3516 -> 3518;
	3592 [label="{\"Id\":3592,\"Incoming\":[3526],\"Outgoing\":[3525],\"GraphPos\":[-11528,45678],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/QuincyDialogue_rom.dialogue\",\"Tag\":\"QuincyAmirTrick2\",\"Value\":0}]}",color=orange];
		3592 -> 3525;
	3517 [label="對不起，你說什麼？",shape=box,color=blue];
		3517 -> 3519;
	3518 [label="還是它們都是由虛空組合的奇怪有機原肉東西？",shape=box,color=blue];
		3518 -> 3519;
	3525 [label="Chat ends.",color=orange];
	3519 [label="等一下",shape=box,color=blue];
		3519 -> 3520;
	3520 [label="你有聽到吸塵器的聲音嗎……？",shape=box,color=blue];
		3520 -> 3522;
	3522 [label="+20 Chemistry",color=orange];
		3522 -> 3521;
	3521 [label="馬上回來",shape=box,color=blue];
		3521 -> 3593;
	3593 [label="{\"Id\":3593,\"Incoming\":[3521],\"Outgoing\":[3523],\"GraphPos\":[-9530,45370],\"CompletionType\":2,\"OtherDialogueInfos\":[{\"Dialogue\":\"/Lotus/Types/Gameplay/1999Wf/Dialogue/QuincyDialogue_rom.dialogue\",\"Tag\":\"QuincyAmirTrick2\",\"Value\":0}]}",color=orange];
		3593 -> 3523;
	3523 [label="Chat ends.",color=orange];
}