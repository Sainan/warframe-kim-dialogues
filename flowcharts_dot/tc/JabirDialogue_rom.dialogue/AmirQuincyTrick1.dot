digraph {
	"AmirQuincyTrick1 begins." [color=orange];
		"AmirQuincyTrick1 begins." -> j1258829160;
		"AmirQuincyTrick1 begins." -> j3102889003;
	j1258829160 [label="嘿，阿米爾，在嗎？",shape=box,color=red];
		j1258829160 -> j2724500803;
	j3102889003 [label="[無視]",shape=box,color=red];
		j3102889003 -> "Chat ends.";
	j2724500803 [label="怎麼樣，朋友？！",shape=box,color=blue];
		j2724500803 -> j2468041769;
		j2724500803 -> j2608197055;
	"Chat ends." [color=orange];
	j2468041769 [label="機器人。",shape=box,color=red];
		j2468041769 -> j2773901458;
	j2608197055 [label="那個……崑西在對你惡作劇，而我就是幌子。",shape=box,color=red];
		j2608197055 -> j1251282015;
	j2773901458 [label="機器人──",shape=box,color=blue];
		j2773901458 -> j1076924697;
	j1251282015 [label="蛤？！惡作劇是嗎？像……什麼樣的惡作劇……？",shape=box,color=blue];
		j1251282015 -> j420695897;
		j1251282015 -> j2103862826;
	j1076924697 [label="（咳嗽）我的意思是……怎麼了嗎？你想說關於這些你所提到的機器人的什麼事？",shape=box,color=blue];
		j1076924697 -> j1619780020;
		j1076924697 -> j2978259176;
	j420695897 [label="他在用包裝填充物塞滿你整間房間。",shape=box,color=red];
		j420695897 -> j2266331920;
	j2103862826 [label="老實說，我覺得這是他表達關心的方式。",shape=box,color=red];
		j2103862826 -> j1550268676;
	j1619780020 [label="我有告訴過你關於金星上的巨型機器蜘蛛的事嗎？",shape=box,color=red];
		j1619780020 -> j1509485229;
	j2978259176 [label="我有告訴過你關於機器獵犬的事嗎？",shape=box,color=red];
		j2978259176 -> j1792670030;
	j2266331920 [label="什麼！從來就沒有人關心我到這種程度，用包裝填充物塞滿我整間房間。",shape=box,color=blue];
		j2266331920 -> j161354853;
	j1550268676 [label="……嗚嗚嗚……好開心喔！從來就沒有人會喜歡我到對我惡作劇！",shape=box,color=blue];
		j1550268676 -> j161354853;
	j1509485229 [label="我好像在哪部電影裡有看過",shape=box,color=blue];
		j1509485229 -> j50265000;
	j1792670030 [label="你、有、機器、狗？！",shape=box,color=blue];
		j1792670030 -> j2603862689;
	j161354853 [label="好吧，我不會表露出已經從你那裡得知他在做什麼事的樣子，我只會坐在這裡，假裝忙著編寫我的遊戲的程式碼，哈哈",shape=box,color=blue];
		j161354853 -> j526237436;
	j50265000 [label="但那不是科幻片，而是西部片。整體來說它還蠻爛的，但說實話我還算喜歡",shape=box,color=blue];
		j50265000 -> j59408123;
	j2603862689 [label="我突然意識到人生有了新的使命。我需要擁有一隻機器狗。我要幫它取名斐多。或是破爛。或是晶片。昌片！晶片是最棒的機器狗名字",shape=box,color=blue];
		j2603862689 -> j3613708233;
	j526237436 [label="+20 Chemistry",color=orange];
		j526237436 -> j2282283501;
	j59408123 [label="我的意思是，它知道自己想成為什麼樣的電影，只是它並沒有太把自己當回事，你知道嗎？沒有什麼比一部牛仔電影裡出現一隻巨型蒸氣龐克蜘蛛，想藉此手法把自己定義為高級藝術片更讓我煩躁的了，哈哈哈",shape=box,color=blue];
		j59408123 -> j645683186;
	j3613708233 [label="如果你有不同意見的話，我就會跟你打起來",shape=box,color=blue];
		j3613708233 -> j4051453788;
	j2282283501 [label="呵呵，但我希望他意識到這當然……意味著……戰爭開打！",shape=box,color=blue];
		j2282283501 -> "Initiate conversation QuincyAmirTrick2 in /Lotus/Types/Gameplay/1999Wf/Dialogue/QuincyDialogue_rom.dialogue";
	j645683186 [label="我不是說這部電影是高級藝術片，這正是我想說的。這部電影沒有那樣，但它確實有個巨型機器蜘蛛。雖然我相信你說的那些屬於更高科技的蜘蛛",shape=box,color=blue];
		j645683186 -> j3002784561;
	j4051453788 [label="懂嗎？是「晶片」，哈哈，因為電腦裡有晶片，比如……電腦晶片，懂了嗎？……你那個時代的電腦還用晶片嗎？",shape=box,color=blue];
		j4051453788 -> j3152969342;
	"Initiate conversation QuincyAmirTrick2 in /Lotus/Types/Gameplay/1999Wf/Dialogue/QuincyDialogue_rom.dialogue" [label="Initiate conversation QuincyAmirTrick2 in /Lotus/Types/Gameplay/1999Wf/Dialogue/QuincyDialogue_rom.dialogue",color=orange];
		"Initiate conversation QuincyAmirTrick2 in /Lotus/Types/Gameplay/1999Wf/Dialogue/QuincyDialogue_rom.dialogue" -> "Chat ends.";
	j3002784561 [label="對不起，你說什麼？",shape=box,color=blue];
		j3002784561 -> j2543499463;
	j3152969342 [label="還是它們都是由虛空組合的奇怪有機原肉東西？",shape=box,color=blue];
		j3152969342 -> j2543499463;
	j2543499463 [label="等一下",shape=box,color=blue];
		j2543499463 -> j240982384;
	j240982384 [label="你有聽到吸塵器的聲音嗎……？",shape=box,color=blue];
		j240982384 -> j2270779975;
	j2270779975 [label="+20 Chemistry",color=orange];
		j2270779975 -> j2701975890;
	j2701975890 [label="馬上回來",shape=box,color=blue];
		j2701975890 -> "Initiate conversation QuincyAmirTrick2 in /Lotus/Types/Gameplay/1999Wf/Dialogue/QuincyDialogue_rom.dialogue";
}