		j2293602194 -> "Chat ends." [label=false,color=brown];
	j2083998010 [label="嘿……阿米爾？我們能談談嗎？[徵求同意發展多重伴侶關係]",shape=box,color=red];
		j2083998010 -> j2056442285;
	j1750675046 [label="[結束]",shape=box,color=red];
		j1750675046 -> j3316821453;
	j2056442285 [label="嘿喲，怎樣？",shape=box,color=blue];
		j2056442285 -> j2718733206;
	j3316821453 [label="Boolean AmirConsentComplete is now true.",color=orange];
		j3316821453 -> "Chat ends.";
	j2718733206 [label="我想和你說件事，我想在事情還沒到無法挽回之前確認你的想法。",shape=box,color=red];
		j2718733206 -> j2739437832;
	j2739437832 [label="我知道這不是我們之前談論過的事。對我來說更重要的是，希望你不會覺得我在騙你或以任何方式對你不忠。",shape=box,color=red];
		j2739437832 -> j1138822420;
	j1138822420 [label="呃發生什麼事了出什麼事了你殺人了嗎誰死了還是等一下這是更詭異的事嗎一定是更詭異的事你是在跟那把吉他談戀愛嗎哦我的白月啊",shape=box,color=blue];
		j1138822420 -> j2095288318;
		j1138822420 -> j383456046;
	j2095288318 [label="我知道這樣可能會很怪，但這並不意味著我對你的感情有變少。",shape=box,color=red];
		j2095288318 -> j1039727749;
	j383456046 [label="呃，至少不是那把吉他。聽著，我知道這樣說可能會很怪，但這並不意味著我對你的感情有變少。",shape=box,color=red];
		j383456046 -> j3875381530;
	j1039727749 [label="抱歉大腦還卡在你可能在跟吉他談戀愛這件事上等等我得重啟一下",shape=box,color=blue];
		j1039727749 -> j1014062794;
	j3875381530 [label="+5 Chemistry",color=orange];
		j3875381530 -> j1039727749;
	j1014062794 [label="然後我們回來了。不好意思，你剛才想告訴我什麼？",shape=box,color=blue];
		j1014062794 -> j3292053891;
	j3292053891 [label="你……在某處還有另一個對象？或者……在某個時間線？那個他……不是六煞成員之一……對吧？……啊，那樣會超怪的",shape=box,color=blue];
		j3292053891 -> j853177513;
	j853177513 [label="那就像你跟我表妹蕾菈在交往一樣噁──",shape=box,color=blue];
		j853177513 -> j3150669991;
		j853177513 -> j1796334153;
	j3150669991 [label="不，不是六煞成員之一。也不是那把吉他。也不是你表妹。",shape=box,color=red];
		j3150669991 -> j408598639;
	j1796334153 [label="我不知道你還有個表妹。",shape=box,color=red];
		j1796334153 -> j2915929739;
	j408598639 [label="好吧，所以是怎樣，怎麼你發展出另一段關係？！",shape=box,color=blue];
		j408598639 -> j3529861574;
	j2915929739 [label="是啊，我想我們確實從來沒怎麼聊過我的家人，我們有太多其他狗屎事要聊了，比如，怎麼你發展出另一段關係？！",shape=box,color=blue];
		j2915929739 -> j3529861574;
	j3529861574 [label="如果這件事讓你感到不舒服，我定能理解。而我希望你明白，這並不意味著你對我來說不重要。",shape=box,color=red];
		j3529861574 -> j497291816;
	j497291816 [label="他們不是來自這裡，我甚至都不知道能不能或能怎麼介紹你們認識，但……他們對我也很重要。但你也一樣。",shape=box,color=red];
		j497291816 -> j3854666630;
	j3854666630 [label="我知道這可能很難接受，如果你無法接受這件事，我完全理解。我只是不想讓你覺得我在騙你，或瞞你什麼。",shape=box,color=red];
		j3854666630 -> j144931279;
	j144931279 [label="劈里啪啦──",shape=box,color=blue];
		j144931279 -> j3087694261;
	j3087694261 [label="（順便說那是我秀逗時發出的聲音）",shape=box,color=blue];
		j3087694261 -> j3033793295;
	j3033793295 [label="你對我很重要。真的非常非常重要。我不想失去這份感情。而如果他們對你很重要，那麼……他們對我也很重要。",shape=box,color=blue];
		j3033793295 -> j4273192448;
	j4273192448 [label="我想，我現在只是嫉妒我沒辦法見到他們，哈哈，憑什麼都你在爽？可惡被困在 1999 年",shape=box,color=blue];
		j4273192448 -> j1467049796;
	j1467049796 [label="+20 Chemistry",color=orange];
		j1467049796 -> j402435301;
	j402435301 [label="爛──",shape=box,color=blue];
		j402435301 -> j3086425361;
	j3086425361 [label="Evaluate expressions",color=orange];
		j3086425361 -> j3633974464 [label="AmirCephalon4",color=purple];
		j3086425361 -> j3633974464 [label="AmirNightmare3",color=purple];
		j3086425361 -> j3633974464 [label="AmirRPGAll",color=purple];
		j3086425361 -> j3633974464 [label="AmirDungeonEscaped",color=purple];
		j3086425361 -> j4267839797 [label="false",color=purple];
	j3633974464 [label="但說真的，我真的……相信你。你對我非常重要，我很高興你選擇告訴我真相。我想，如果你在這件事上騙我的話，那情況又會很不一樣了，你懂吧？",shape=box,color=blue];
		j3633974464 -> j20493774;
	j4267839797 [label="但說真的，我……我願意看看這會怎麼樣發展。我選擇信任你。我很高興你選擇告訴我真相。我想，如果你在這件事上騙我的話，那情況又會很不一樣了，你懂吧？",shape=box,color=blue];
		j4267839797 -> j20493774;
	j20493774 [label="所以謝謝。還有……對了，我接受這個提議。只要大家沒意見就好。",shape=box,color=blue];
		j20493774 -> j3316821453;
}