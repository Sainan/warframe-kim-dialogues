	j3719481381 [label="我就知道",shape=box,color=blue];
		j3719481381 -> j3926683596;
		j3719481381 -> j2482100850;
	j3926683596 [label="Orokin 做過比這更糟的事，所以……",shape=box,color=red];
		j3926683596 -> j2546095424;
	j2482100850 [label="我不致於做出那種推測。",shape=box,color=red];
