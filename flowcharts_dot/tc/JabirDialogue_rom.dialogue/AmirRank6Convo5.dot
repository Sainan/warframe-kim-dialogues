digraph {
	"AmirRank6Convo5 begins." [color=orange];
		"AmirRank6Convo5 begins." -> j1533285883;
	j1533285883 [label="所以未來人……你來自未來，對吧？",shape=box,color=blue];
		j1533285883 -> j3006820469;
		j1533285883 -> j67890160;
	j3006820469 [label="經我最近一次確認是這樣的。",shape=box,color=red];
		j3006820469 -> j669759373;
	j67890160 [label="不涉及永恆主義去深入討論這個話題的話，是的，我來自未來。",shape=box,color=red];
		j67890160 -> j669759373;
	j669759373 [label="告訴我關於所有外星人的事",shape=box,color=blue];
		j669759373 -> j722519014;
		j669759373 -> j1636706719;
	j722519014 [label="你是什麼意思？",shape=box,color=red];
		j722519014 -> j662549374;
	j1636706719 [label="飲者札茲諾格可以跟你拼酒把你給喝趴。",shape=box,color=red];
		j1636706719 -> j1653576890;
	j662549374 [label="你知道的，外星人、幽浮、該死的探棒！",shape=box,color=blue];
		j662549374 -> j844338692;
		j662549374 -> j2790300744;
	j1653576890 [label="哇哦！真的嗎？他都喝什麼？",shape=box,color=blue];
		j1653576890 -> j2034350838;
		j1653576890 -> j1706859542;
	j844338692 [label="我不想讓你失望……",shape=box,color=red];
		j844338692 -> j1915083207;
	j2790300744 [label="是有 Sentient，但我很確定那不是你想問的。",shape=box,color=red];
		j2790300744 -> j688669434;
	j2034350838 [label="主要是活塞油。他喜歡喝活塞油。",shape=box,color=red];
		j2034350838 -> j1667009928;
	j1706859542 [label="格洛普白蘭地",shape=box,color=red];
		j1706859542 -> j1667009928;
	j1915083207 [label="不！",shape=box,color=blue];
		j1915083207 -> j107902321;
	j688669434 [label="不過 sentient 原本就來自地球",shape=box,color=blue];
		j688669434 -> j745846278;
	j1667009928 [label="哇哦……",shape=box,color=blue];
		j1667009928 -> j1362629763;
	j107902321 [label="連來自遙遠太陽系的一個訊息都沒有嗎？",shape=box,color=blue];
		j107902321 -> j67840550;
	j745846278 [label="我是說像是星際深空的外星生物",shape=box,color=blue];
		j745846278 -> j3828152457;
	j1362629763 [label="等一下，你是在騙我嗎？",shape=box,color=blue];
		j1362629763 -> j984595390;
		j1362629763 -> j1396741454;
	j67840550 [label="一個「你好」？？",shape=box,color=blue];
		j67840550 -> j1321268050;
	j3828152457 [label="長相有趣的外星人在銀河系以光速到處飛行，結交朋友和打擊壞蛋",shape=box,color=blue];
		j3828152457 -> j807663553;
	j984595390 [label="永遠不會。",shape=box,color=red];
		j984595390 -> j2825292572;
	j1396741454 [label="被抓包了。",shape=box,color=red];
		j1396741454 -> j3588190333;
	j1321268050 [label="都在那麼久遠的未來了，肯定會有什麼吧",shape=box,color=blue];
		j1321268050 -> j1658080798;
		j1321268050 -> j4195944869;
	j807663553 [label="還是什麼的，所以我才會問",shape=box,color=blue];
		j807663553 -> j4195944869;
		j807663553 -> j1658080798;
	j2825292572 [label="哈哈……不是，說真的",shape=box,color=blue];
		j2825292572 -> j2963054489;
	j3588190333 [label="+5 Chemistry",color=orange];
		j3588190333 -> j2825292572;
	j1658080798 [label="就算有的話，也從來沒有人告訴過我。",shape=box,color=red];
		j1658080798 -> j3622725838;
	j4195944869 [label="如果 Orokin 發現了外星人，他們也會保密。",shape=box,color=red];
		j4195944869 -> j3622725838;
	j2963054489 [label="一定有外星人，告訴我關於他們的事，我必須知道",shape=box,color=blue];
		j2963054489 -> j2790300744;
		j2963054489 -> j844338692;
	j3622725838 [label="所以這是個陰謀了",shape=box,color=blue];
