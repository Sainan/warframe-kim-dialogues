		j4063582829 -> j4020460451;
	j585186622 [label="「到處都是血跡。顯然，先前已有其他囚犯嘗試過不太……有效的方法。所以從他們致命的試驗與錯誤中，你可以推斷出接下來該怎麼做！」",shape=box,color=blue];
