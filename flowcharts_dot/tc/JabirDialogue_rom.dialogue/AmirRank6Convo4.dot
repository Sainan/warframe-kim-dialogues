		4092 -> 4094 [label=false,color=brown];
	4093 [label="只因為我表現得像台電腦，而且大部分時間都在用電腦，還有……呃……",shape=box,color=blue];
		4093 -> 4097;
	4095 [label="好吧，我想要知道文字冒險遊戲接下來會怎麼發展。",shape=box,color=red];
