	4131 [label="Update boolean FlintTaken",color=orange];
		4131 -> 4118;
	4133 [label="「你現在可以看到地牢走廊更遠一點了。你會怎麼做？」",shape=box,color=blue];
		4133 -> 4137;
		4133 -> 4139;
	4132 [label="「牆上掛著一支火把。你會怎麼做？」",shape=box,color=blue];
