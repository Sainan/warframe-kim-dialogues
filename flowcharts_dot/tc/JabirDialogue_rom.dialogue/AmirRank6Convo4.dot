	4143 [label="Check boolean TorchTaken",color=orange];
		4143 -> 4149 [label=true,color=green];
		4143 -> 4148 [label=false,color=brown];
	4145 [label="「你試著輕輕推開門，但它發出巨大的嘎吱聲，守衛們立即察覺到你企圖越獄。你對他們的同伴做的事讓他們憤怒至極。」",shape=box,color=blue];
		4145 -> 4151;
	4144 [label="「你從牆上取下火把」",shape=box,color=blue];
		4144 -> 4150;
	4146 [label="Check boolean DickingAroundApology",color=orange];
		4146 -> 4152 [label=true,color=green];
		4146 -> 4153 [label=false,color=brown];
	4147 [label="「你腦海深處傳來耳語『嘿，丑八怪，這是你最後機會了。守衛身上還是沒有好東西。別鬧了。』」",shape=box,color=blue];
		4147 -> 4154;
	4149 [label="「你拿起火把，希望火焰不會熄滅。你沿著走廊走。你經過空的牢房，每一間都和上一間一樣荒涼。」",shape=box,color=blue];
		4149 -> 4156;
	4148 [label="「你摸黑進入其中在尋找著……什麼……每走一步都讓你感到更加迷失。突然你被一個突起的石階絆倒了。」",shape=box,color=blue];
		4148 -> 4155;
	4151 [label="「你的死亡快速，但還不致於快到不痛。所以很痛，非常痛。」",shape=box,color=blue];
		4151 -> 4157;
	4150 [label="Update boolean TorchTaken",color=orange];
		4150 -> 4124;
	4152 [label="好了，我們就到這邊",shape=box,color=blue];
		4152 -> 4158;
	4153 [label="「一位古老神明受夠了你的胡搞瞎搞。你被閃電擊中了。你死了。結束。」",shape=box,color=blue];
		4153 -> 4159;
	4154 [label="Update boolean FlintLoop3",color=orange];
		4154 -> 4118;
	4156 [label="「當你小心翼翼地走向走廊盡頭時，火把的光開始照亮前方的一個黑暗深坑。你站在一個蓄水池的邊上。你向下一探池子深不見底。如果沒有火把，你肯定墜死無疑。」",shape=box,color=blue];
		4156 -> 4160;
	4155 [label="「你正在墜落。你剛好有足夠時間去後悔沒有帶上光源，然後你重摔落地，血漿四溢。」",shape=box,color=blue];
		4155 -> 4157;
