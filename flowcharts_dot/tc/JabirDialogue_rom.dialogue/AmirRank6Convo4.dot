		4170 -> 4177 [label=false,color=brown];
	4169 [label="「你再次……死得很慘。要再次……再試一次嗎？」",shape=box,color=blue];
		4169 -> 4175;
		4169 -> 4176;
	4167 [label="當然了！",shape=box,color=red];
