	4173 [label="Update boolean BrutalDeath",color=orange];
		4173 -> 4124;
	4174 [label="哦對，那個……你或許說得對",shape=box,color=blue];
		4174 -> 4181;
	4179 [label="幹嘛不進去？",shape=box,color=red];
		4179 -> 4186;
	4180 [label="地牢裡還會有隧道？很會瞎掰餒，是吧？",shape=box,color=red];
		4180 -> 4187;
	4185 [label="但正如俗話所說，如果你修不好的話，那就讓槽點成為特點",shape=box,color=blue];
		4185 -> 4191;
	4184 [label="什麼？",shape=box,color=red];
		4184 -> 4190;
	4182 [label="Update boolean BrutalDeath2",color=orange];
		4182 -> 4124;
	4183 [label="你的臉才開始變得有點無聊了",shape=box,color=blue];
		4183 -> 4189;
	4181 [label="但是等我清點完成，我還有更多精彩內容給你玩",shape=box,color=blue];
		4181 -> 4188;
	4186 [label="就是這種態度……所以你要進去嗎？",shape=box,color=blue];
		4186 -> 4192;
		4186 -> 4193;
	4187 [label="拜託，這是用來通風的，就連中世紀奇幻版本的 Grineer 也是需要呼吸新鮮空氣的好嗎",shape=box,color=blue];
		4187 -> 4194;
	4191 [label="「到處都是血跡。顯然，先前已有其他囚犯嘗試過不太……有效的方法。所以從他們致命的試驗與錯誤中，你可以推斷出接下來該怎麼做！」",shape=box,color=blue];
		4191 -> 4149;
	4190 [label="沒事。你要不要再玩一次？哈哈",shape=box,color=blue];
		4190 -> 4196;
		4190 -> 4197;
	4189 [label="但是等我清點完成，我還有更多精彩內容給你玩",shape=box,color=blue];
		4189 -> 4195;
	4188 [label="Chat ends.",color=orange];
	4192 [label="那裡面最好不要有什麼可怕的東西。",shape=box,color=red];
		4192 -> 4198;
	4193 [label="我要頭先進去！",shape=box,color=red];
		4193 -> 4198;
	4194 [label="「你想要怎麼做？」",shape=box,color=blue];
		4194 -> 4199;
		4194 -> 4200;
	4196 [label="……要啊。",shape=box,color=red];
		4196 -> 4201;
	4197 [label="我不玩了。[結束]",shape=box,color=red];
		4197 -> 4202;
	4195 [label="Chat ends.",color=orange];
	4198 [label="「你蹲下身鑽進隧道。痛苦地緩慢爬行，似乎永遠沒有盡頭。裡面又冷又濕，而且還真的，真的非常髒。」",shape=box,color=blue];
		4198 -> 4203;
	4199 [label="如果只有一條前進的路可走，那我們就走隧道吧。",shape=box,color=red];
		4199 -> 4198;
	4200 [label="我想我要爬進去。",shape=box,color=red];
		4200 -> 4198;
	4201 [label="四次顯靈",shape=box,color=blue];
		4201 -> 4204;
	4202 [label="這大概是最好的結局了，開始變得好像有點在虐待動物了，哈哈",shape=box,color=blue];
		4202 -> 4205;
	4203 [label="「最終，你爬出了隧道。你鬆了一口氣，站起身並環顧四周。」",shape=box,color=blue];
		4203 -> 4206;
	4204 [label="Update boolean BrutalDeath3",color=orange];
		4204 -> 4124;
	4205 [label="Chat ends.",color=orange];
	4206 [label="「你發現自己身處在一個很大的空房間裡。似乎是某種地窖，也許吧？唯一值得注意的是一扇厚重的金屬門。」",shape=box,color=blue];
		4206 -> 4207;
		4206 -> 4208;
	4207 [label="讓我來猜，門是鎖住的？",shape=box,color=red];
		4207 -> 4209;
	4208 [label="我能打開那扇門嗎？",shape=box,color=red];
		4208 -> 4209;
	4209 [label="「門是鎖住的。」",shape=box,color=blue];
		4209 -> 4210;
	4210 [label="「你開始聽到一種微弱的聲音。那是……吱吱聲嗎？」",shape=box,color=blue];
		4210 -> 4211;
		4210 -> 4212;
	4211 [label="別告訴我是老鼠。",shape=box,color=red];
		4211 -> 4213;
	4212 [label="是老鼠，對吧？",shape=box,color=red];
		4212 -> 4213;
	4213 [label="是該死的老鼠！！",shape=box,color=blue];
		4213 -> 4214;
	4214 [label="不對，我的意思是……",shape=box,color=blue];
		4214 -> 4215;
	4215 [label="「吱吱聲越來越大，接著是爪子刮在石頭上的噼哩啪啦。突然，你的火把投下一道陰影。有隻貓那麼大的老鼠……不是……是狗那麼大的老鼠衝你而來。」",shape=box,color=blue];
		4215 -> 4216;
	4216 [label="「但不只一隻而已，牠們從四面八方蜂擁而上。」",shape=box,color=blue];
		4216 -> 4217;
		4216 -> 4218;
		4216 -> 4219;
	4217 [label="跟鼠群拼了。",shape=box,color=red];
		4217 -> 4220;
	4218 [label="嘗試用我的火把嚇跑牠們。",shape=box,color=red];
		4218 -> 4220;
	4219 [label="你有給莉蒂看過這部分了嗎？",shape=box,color=red];
		4219 -> 4221;
	4220 [label="「鼠群包圍你了。你昂首挺胸，準備迎戰，但牠們沒有攻擊。反而最大的那隻向你低下頭。你注意到牠戴著項鍊。銀鍊子滑落下來，掉在地上。老鼠的表情彷彿在說，『這是給你的。』」",shape=box,color=blue];
		4220 -> 4222;
		4220 -> 4223;
	4221 [label="沒有，而且我也不打算",shape=box,color=blue];
		4221 -> 4224;
	4222 [label="撿起項鍊。",shape=box,color=red];
		4222 -> 4225;
	4223 [label="問老鼠是誰給牠的項鍊？",shape=box,color=red];
		4223 -> 4226;
	4224 [label="鼠群衝你而來，你會怎麼計劃？",shape=box,color=blue];
		4224 -> 4217;
		4224 -> 4218;
	4225 [label="「你撿起項鍊。鍊子上有把鑰匙。」",shape=box,color=blue];
		4225 -> 4227;
	4226 [label="「老鼠不會說話。畢竟，牠只是隻老鼠。」",shape=box,color=blue];
		4226 -> 4227;
	4227 [label="「鼠群轉過身後就跑掉了。無論是誰給了牠們那把鑰匙，肯定知道你在這裡。只有一個人有這種能力……那就是 Lotus。」",shape=box,color=blue];
		4227 -> 4228;
	4228 [label="一把鑰匙？它能打開那扇門嗎？",shape=box,color=red];
		4228 -> 4229;
	4229 [label="「你拿鑰匙插入門上的鑰匙孔，而門開了。門另一邊的強光照進了你的眼睛，你痛苦地瞇起雙眼。你無法相信你所看到的……」",shape=box,color=blue];
		4229 -> 4230;
	4230 [label="然後……",shape=box,color=blue];
		4230 -> 4231;
	4231 [label="目前我就寫這麼多了",shape=box,color=blue];
		4231 -> 4232;
		4231 -> 4233;
		4231 -> 4234;
	4232 [label="就這樣？？我才剛開始投入其中而已。",shape=box,color=red];
