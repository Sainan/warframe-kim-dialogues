		4168 -> 4174;
	4171 [label="「你試著用火把的光照進縫隙。一陣氣流讓你的火焰搖曳。你聽到水滴聲。」",shape=box,color=blue];
		4171 -> 4166;
	4172 [label="「你使出全身力氣撬開木板，露出剩下的一些生鏽的鐵柵欄。有空間可以鑽過去。而再過去，是一條低矮、狹窄的隧道。」",shape=box,color=blue];
		4172 -> 4179;
		4172 -> 4180;
	4178 [label="好了，這開始變得很荒謬了，而且還是以我的標準來說",shape=box,color=blue];
		4178 -> 4185;
	4177 [label="「《你死得很慘三：追加內容》」",shape=box,color=blue];
