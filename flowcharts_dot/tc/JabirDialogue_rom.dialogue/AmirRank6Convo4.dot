	j2967752907 [label="不對，我的意思是……",shape=box,color=blue];
		j2967752907 -> j1385807063;
	j1385807063 [label="「吱吱聲越來越大，接著是爪子刮在石頭上的噼哩啪啦。突然，你的火把投下一道陰影。有隻貓那麼大的老鼠……不是……是狗那麼大的老鼠衝你而來。」",shape=box,color=blue];
		j1385807063 -> j3140272824;
	j3140272824 [label="「但不只一隻而已，牠們從四面八方蜂擁而上。」",shape=box,color=blue];
		j3140272824 -> j1377244020;
		j3140272824 -> j3363221835;
		j3140272824 -> j305468876;
	j1377244020 [label="跟鼠群拼了。",shape=box,color=red];
		j1377244020 -> j3471448307;
	j3363221835 [label="嘗試用我的火把嚇跑牠們。",shape=box,color=red];
		j3363221835 -> j3471448307;
	j305468876 [label="你有給莉蒂看過這部分了嗎？",shape=box,color=red];
		j305468876 -> j1481306645;
	j3471448307 [label="「鼠群包圍你了。你昂首挺胸，準備迎戰，但牠們沒有攻擊。反而最大的那隻向你低下頭。你注意到牠戴著項鍊。銀鍊子滑落下來，掉在地上。老鼠的表情彷彿在說，『這是給你的。』」",shape=box,color=blue];
		j3471448307 -> j524965224;
		j3471448307 -> j1334324270;
	j1481306645 [label="沒有，而且我也不打算",shape=box,color=blue];
		j1481306645 -> j1739948506;
	j524965224 [label="撿起項鍊。",shape=box,color=red];
		j524965224 -> j2475412163;
	j1334324270 [label="問老鼠是誰給牠的項鍊？",shape=box,color=red];
		j1334324270 -> j1077516367;
	j1739948506 [label="鼠群衝你而來，你會怎麼計劃？",shape=box,color=blue];
		j1739948506 -> j1377244020;
		j1739948506 -> j3363221835;
	j2475412163 [label="「你撿起項鍊。鍊子上有把鑰匙。」",shape=box,color=blue];
		j2475412163 -> j486099981;
	j1077516367 [label="「老鼠不會說話。畢竟，牠只是隻老鼠。」",shape=box,color=blue];
		j1077516367 -> j486099981;
	j486099981 [label="「鼠群轉過身後就跑掉了。無論是誰給了牠們那把鑰匙，肯定知道你在這裡。只有一個人有這種能力……那就是 Lotus。」",shape=box,color=blue];
		j486099981 -> j2299023683;
	j2299023683 [label="一把鑰匙？它能打開那扇門嗎？",shape=box,color=red];
		j2299023683 -> j128524740;
	j128524740 [label="「你拿鑰匙插入門上的鑰匙孔，而門開了。門另一邊的強光照進了你的眼睛，你痛苦地瞇起雙眼。你無法相信你所看到的……」",shape=box,color=blue];
		j128524740 -> j449070891;
	j449070891 [label="然後……",shape=box,color=blue];
		j449070891 -> j102370623;
	j102370623 [label="目前我就寫這麼多了",shape=box,color=blue];
		j102370623 -> j2767440076;
		j102370623 -> j467688010;
		j102370623 -> j1635910317;
	j2767440076 [label="就這樣？？我才剛開始投入其中而已。",shape=box,color=red];
		j2767440076 -> j3267023449;
	j467688010 [label="太精彩了。所以那個清點進行得怎麼樣了？",shape=box,color=red];
		j467688010 -> j2934384784;
	j1635910317 [label="燧石是拿來幹嘛的？我還以為我的火把會熄滅說。",shape=box,color=red];
		j1635910317 -> j2643168815;
	j3267023449 [label="+5 Chemistry",color=orange];
		j3267023449 -> j891264230;
	j2934384784 [label="我馬上去弄",shape=box,color=blue];
		j2934384784 -> j3342348877;
	j2643168815 [label="+5 Chemistry",color=orange];
		j2643168815 -> j4289525783;
	j891264230 [label="哦不。還會有更多精彩內容。你相信我嘛。我只需要把它寫出來……",shape=box,color=blue];
		j891264230 -> j2411348185;
	j3342348877 [label="+5 Chemistry",color=orange];
		j3342348877 -> j2152482615;
	j4289525783 [label="燧石……哦對，燧石。該死，我都忘了把它加進去。嗯……不知道欸，1.2 版肯定會有的。我保證",shape=box,color=blue];
		j4289525783 -> j3102106576;
	j2411348185 [label="對啊……",shape=box,color=blue];
		j2411348185 -> j3102106576;
	j2152482615 [label="在我想好門的另一邊會是什麼之後……",shape=box,color=blue];
		j2152482615 -> j3102106576;
