	4107 [label="Chat ends.",color=orange];
	4108 [label="好吧，但如果你再這樣做就不會有第三次了，我是認真的",shape=box,color=blue];
		4108 -> 4112;
	4110 [label="亞瑟真的很想要完成那個庫存清點。",shape=box,color=red];
		4110 -> 4114;
	4111 [label="我們來看一下！",shape=box,color=red];
		4111 -> 4115;
	4109 [label="阿米爾，我連上一個都還沒玩完。",shape=box,color=red];
		4109 -> 4113;
	4112 [label="我們剛才說到哪裡了？哦，對了",shape=box,color=blue];
		4112 -> 4115;
	4114 [label="最好是",shape=box,color=blue];
		4114 -> 4117;
	4115 [label="「你站在牢房裡，腳下踩著你剛才殺死的一名 Grineer 的屍體。你無法停止回想他臨死前說的話：『你永遠找不到 Lotus。』」",shape=box,color=blue];
		4115 -> 4118;
	4113 [label="沒問題",shape=box,color=blue];
		4113 -> 4116;
	4117 [label="但首先……",shape=box,color=blue];
		4117 -> 4115;
	4118 [label="「你看了眼敞開的牢房門。你會怎麼走下一步？」",shape=box,color=blue];
		4118 -> 4119;
		4118 -> 4120;
		4118 -> 4121;
	4116 [label="現在我需要有人來試玩下個情節",shape=box,color=blue];
		4116 -> 4115;
	4119 [label="關上門並等待救援，同時我來完成庫存清點。[結束]",shape=box,color=red];
		4119 -> 4122;
	4120 [label="我可以搜查守衛的屍體嗎？",shape=box,color=red];
		4120 -> 4123;
	4121 [label="我想到走廊去。",shape=box,color=red];
		4121 -> 4124;
	4122 [label="真的嗎，你就走這步？？",shape=box,color=blue];
		4122 -> 4125;
	4123 [label="Check boolean FlintTaken",color=orange];
		4123 -> 4126 [label=true,color=green];
		4123 -> 4127 [label=false,color=brown];
	4124 [label="「你小心翼翼地溜出牢房。你的右邊是一扇大門，也就是出口。它只開了一條縫。你聽到更多 Grineer 守衛在門的另一邊閒聊。你的左邊地牢走廊一路延伸，但太黑了什麼都看不見。」",shape=box,color=blue];
		4124 -> 4128;
	4125 [label="好吧",shape=box,color=blue];
		4125 -> 4129;
	4126 [label="「你再次搜查了守衛的屍體，但沒有發現更多有價值的東西。你想著要吃那塊發霉的餅乾，直到聞到它的味道後，就又迅速打消了這個念頭。」",shape=box,color=blue];
		4126 -> 4130;
	4127 [label="「你在守衛的屍體上下摸索想搜出任何有價值的東西。除了一塊燧石和一塊發霉的餅乾外，什麼都沒有。你拿走了燧石。」",shape=box,color=blue];
		4127 -> 4131;
	4128 [label="Check boolean TorchTaken",color=orange];
		4128 -> 4133 [label=true,color=green];
		4128 -> 4132 [label=false,color=brown];
	4129 [label="「你關上門並等待救援，但救援沒來。反倒是守衛們來了，他們非常生氣，因為你不應該殺死他們的朋友，所以他們對你做出各種可怕和殘忍的事情，直到你死得很慘，很沒意義。」",shape=box,color=blue];
		4129 -> 4134;
