	j221085784 [label="Check boolean FlintTaken",color=orange];
		j221085784 -> j1020422712 [label=true,color=green];
		j221085784 -> j2327361862 [label=false,color=brown];
	j2969024196 [label="「你小心翼翼地溜出牢房。你的右邊是一扇大門，也就是出口。它只開了一條縫。你聽到更多 Grineer 守衛在門的另一邊閒聊。你的左邊地牢走廊一路延伸，但太黑了什麼都看不見。」",shape=box,color=blue];
		j2969024196 -> j1405298677;
	j4036531595 [label="好吧",shape=box,color=blue];
		j4036531595 -> j2197442177;
	j1020422712 [label="「你再次搜查了守衛的屍體，但沒有發現更多有價值的東西。你想著要吃那塊發霉的餅乾，直到聞到它的味道後，就又迅速打消了這個念頭。」",shape=box,color=blue];
		j1020422712 -> j3451620922;
	j2327361862 [label="「你在守衛的屍體上下摸索想搜出任何有價值的東西。除了一塊燧石和一塊發霉的餅乾外，什麼都沒有。你拿走了燧石。」",shape=box,color=blue];
		j2327361862 -> j3747987375;
