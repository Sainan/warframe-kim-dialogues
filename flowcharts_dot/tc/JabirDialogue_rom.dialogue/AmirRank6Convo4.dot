		j1763251803 -> j1543494696;
	j4181316398 [label="「你站在牢房裡，腳下踩著你剛才殺死的一名 Grineer 的屍體。你無法停止回想他臨死前說的話：『你永遠找不到 Lotus。』」",shape=box,color=blue];
		j4181316398 -> j3624163721;
