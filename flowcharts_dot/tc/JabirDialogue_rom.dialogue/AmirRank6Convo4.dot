		j2609203447 -> j4181316398;
	j943815895 [label="阿米爾，我連上一個都還沒玩完。",shape=box,color=red];
		j943815895 -> j2851638109;
	j1577897986 [label="我們剛才說到哪裡了？哦，對了",shape=box,color=blue];
