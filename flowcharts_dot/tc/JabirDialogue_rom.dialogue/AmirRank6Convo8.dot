		j2075371485 -> j2744284978;
	j427443533 [label="我想更了解那個帥氣的扎比爾。看來你可能有競爭對手了。",shape=box,color=red];
		j427443533 -> j1594224753;
	"Chat ends. Next chat will be AmirRank6Convo3." [color=orange];
	"Chat ends. Next chat will be AmirRank6Convo2." [color=orange];
	j821010538 [label="你的損失",shape=box,color=blue];
		j821010538 -> "Chat ends.";
	j2744284978 [label="+5 Chemistry",color=orange];
		j2744284978 -> j2423639701;
	j1594224753 [label="+5 Chemistry",color=orange];
		j1594224753 -> j3838950542;
	j2423639701 [label="哦……它準備好了",shape=box,color=blue];
		j2423639701 -> j3571636712;
	j3838950542 [label="不怪你，他確實很迷人",shape=box,color=blue];
		j3838950542 -> j3571636712;
	j3571636712 [label="開始了",shape=box,color=blue];
		j3571636712 -> j1611039643;
	j1611039643 [label="「你和剛重獲自由的扎比爾一起站在電力實驗室中央。他看向你說『沒有時間可以浪費了，快跟我來。』」",shape=box,color=blue];
		j1611039643 -> j3173874591;
	j3173874591 [label="「他帶你穿過一條又一條通道。他對這顆小行星瞭若指掌，清楚掌握每名守衛及他們的動線。」",shape=box,color=blue];
		j3173874591 -> j4047178009;
		j3173874591 -> j3754574328;
		j3173874591 -> j2203184921;
	j4047178009 [label="問扎比爾關於老鼠的事。",shape=box,color=red];
		j4047178009 -> j4150710343;
	j3754574328 [label="他也是囚犯嗎？",shape=box,color=red];
		j3754574328 -> j3758654407;
	j2203184921 [label="扎比爾要帶我去哪裡？",shape=box,color=red];
		j2203184921 -> j1729820910;
	j4150710343 [label="「扎比爾感到震驚。『鼠群找到你了？太棒了。成功了。看這個。』扎比爾舉起一個雕工精美的金哨子。『鼠后送我的。我們需要找到她。』」",shape=box,color=blue];
		j4150710343 -> j1092247391;
	j3758654407 [label="「你問扎比爾他是怎麼來到這裡的，『沒時間說這些了，』他回說，『我們需要先想辦法逃離這裡。』」",shape=box,color=blue];
		j3758654407 -> j4047178009;
		j3758654407 -> j2203184921;
	j1729820910 [label="「扎比爾回過頭對你說，『帶你去機庫。我們去偷一艘船，然後盡可能遠離這裡。找到鼠后。』」",shape=box,color=blue];
		j1729820910 -> j1092247391;
	j1092247391 [label="鼠后？",shape=box,color=red];
		j1092247391 -> j764949361;
	j764949361 [label="「『她給了我這個哨子。鼠群對它唯命是從。她是我的朋友。雖然她不是總是那麼友善，但她還是會關心我。』」",shape=box,color=blue];
		j764949361 -> j3755962948;
		j764949361 -> j1977600262;
	j3755962948 [label="你有給莉蒂看過這個了嗎？",shape=box,color=red];
		j3755962948 -> j1375218830;
	j1977600262 [label="她聽起來也很熟悉。",shape=box,color=red];
		j1977600262 -> j613267064;
	j1375218830 [label="我非常珍惜自己的生命，所以才不會去冒那個險",shape=box,color=blue];
		j1375218830 -> j651893727;
	j613267064 [label="若與現實或想像中之人物有著任何雷同之處，純屬巧合",shape=box,color=blue];
		j613267064 -> j651893727;
	j651893727 [label="「在扎比爾的幫助下，你在小行星的通道中曲折前行。他巧妙地避開了守衛和監視器。」",shape=box,color=blue];
		j651893727 -> j1296056469;
	j1296056469 [label="「最終，你們來到一扇大門前。扎比爾示意要蹲下。你們都蹲下身子，並偷偷溜進了飛船機庫。」",shape=box,color=blue];
		j1296056469 -> j3655867574;
	j3655867574 [label="你蹲在柱子的陰影中。附近可以聽到 Grineer 守衛的聲音。",shape=box,color=blue];
		j3655867574 -> j3133320521;
	j3133320521 [label="「你會怎麼做？」",shape=box,color=blue];
		j3133320521 -> j3544885394;
		j3133320521 -> j3507323513;
	j3544885394 [label="攻擊守衛。",shape=box,color=red];
		j3544885394 -> j774378737;
	j3507323513 [label="到處看看。",shape=box,color=red];
		j3507323513 -> j3364266421;
	j774378737 [label="「沒有一絲自我保護意識或事先預謀，你就衝向一旁的開闊區域。而這時另一邊的一群守衛就開始射擊。你直接衝向子彈流，瞬間被火力擊斃。扎比爾對你這種無腦逞一時勇的行為搖了搖頭。」",shape=box,color=blue];
		j774378737 -> j4214557870;
	j3364266421 [label="「你探頭探向拐角，勘察周遭的區域。」",shape=box,color=blue];
		j3364266421 -> j3655917117;
	j4214557870 [label="要再試一次嗎，還有這次不要再讓自己秒死了，好嗎？",shape=box,color=blue];
		j4214557870 -> j122572722;
		j4214557870 -> j1663266404;
	j3655917117 [label="「一艘銳捷號停在機庫正中央。進入銳捷號的坡道被一名守衛擋著。機庫一側有十幾名 Grineer 正在忙著玩骰子遊戲。你前方幾步處有一張桌子，上面有一個控制面板。」",shape=box,color=blue];
		j3655917117 -> j3344525459;
	j122572722 [label="好 der。",shape=box,color=red];
		j122572722 -> j601596998;
	j1663266404 [label="今天這樣就夠了。[結束]",shape=box,color=red];
		j1663266404 -> "Chat ends.";
	j3344525459 [label="「『要想出去，我們得先打開機庫的大門。』扎比爾細語道。」",shape=box,color=blue];
		j3344525459 -> j3355765898;
	j601596998 [label="「你這次會怎麼做？」",shape=box,color=blue];
		j601596998 -> j2244722077;
		j601596998 -> j3507323513;
	j3355765898 [label="「扎比爾看向你說，『有什麼好主意嗎？』」",shape=box,color=blue];
		j3355765898 -> j774369477;
		j3355765898 -> j3355765898;
	j2244722077 [label="……勘察周遭區域嗎？",shape=box,color=red];
		j2244722077 -> j3364266421;
