		j2662935952 -> j1202094836 [label=false,color=brown];
		j2662935952 -> j3709400424 [label=false,color=brown];
		j2662935952 -> j876886598 [label=false,color=brown];
	j876886598 [label="我們來用一下那個老鼠哨子的東東。",shape=box,color=red];
		j876886598 -> j4057770162;
	j2144603430 [label="使用控制面板。",shape=box,color=red];
		j2144603430 -> j341952326;
	j3709400424 [label="衝向銳捷號。",shape=box,color=red];
		j3709400424 -> j2575423088;
	j1202094836 [label="叫扎比爾攻擊坡道守衛。",shape=box,color=red];
		j1202094836 -> j4183570713;
	j4057770162 [label="「扎比爾拿起哨子，吹出一聲長音。除了呼吸聲以外，你什麼都聽不到。你坐著等待，但什麼都沒發生。沒有鼠群，什麼都沒有。扎比爾聳了聳肩。」",shape=box,color=blue];
		j4057770162 -> j2562996683;
	j341952326 [label="「你走到控制面板前，但被一名警覺的守衛發現了。你試圖舉起雙手投降，但他們還是開槍擊斃了你，因為 Grineer 就是那樣無情。」",shape=box,color=blue];
		j341952326 -> j2043430609;
		j341952326 -> j2438992826;
	j2575423088 [label="「你衝向飛船，但坡道的守衛發現了你並朝你開火。你的一天，還有你的生命，痛苦地畫上句點。」",shape=box,color=blue];
		j2575423088 -> j2043430609;
		j2575423088 -> j1217376860;
	j4183570713 [label="哦，當然，有危險的時候你叫阿米爾上就好",shape=box,color=blue];
		j4183570713 -> j1361184752;
	j2562996683 [label="「然後你聽到了，一種咀嚼聲。像是在咀嚼東西。突然鼠群從機庫周圍的通風口中湧出。Grineer 守衛像小學生一樣尖叫並開火。子彈到處亂飛。」",shape=box,color=blue];
		j2562996683 -> j2497353620;
	j2043430609 [label="我需要休息一下。[結束]",shape=box,color=red];
		j2043430609 -> j1858109619;
	j2438992826 [label="再來一次。",shape=box,color=red];
		j2438992826 -> j318932394;
	j1217376860 [label="再來！",shape=box,color=red];
		j1217376860 -> j1595881847;
	j1361184752 [label="我是指扎比爾",shape=box,color=blue];
		j1361184752 -> j1511754810;
	j2497353620 [label="「鼠群分散了守衛們的注意力。現在要幹嘛？」",shape=box,color=blue];
		j2497353620 -> j3381736593;
		j2497353620 -> j2258215826;
	j1858109619 [label="你會回來的",shape=box,color=blue];
		j1858109619 -> "Chat ends.";
	j318932394 [label="Boolean OneMoreTime is now true.",color=orange];
		j318932394 -> j774369477;
	j1595881847 [label="Boolean Again is now true.",color=orange];
		j1595881847 -> j774369477;
	j1511754810 [label="好吧",shape=box,color=blue];
		j1511754810 -> j3790085766;
	j3381736593 [label="讓扎比爾電擊坡道守衛！",shape=box,color=red];
		j3381736593 -> j1654556006;
	j2258215826 [label="打開控制面板控制的門。",shape=box,color=red];
		j2258215826 -> j1695384942;
	j3790085766 [label="「你喊道，『扎比爾，上！』同時指向坡道的守衛。」",shape=box,color=blue];
		j3790085766 -> j1265802429;
	j1654556006 [label="「扎比爾衝向守衛並電擊他。守衛癱軟地倒下去。」",shape=box,color=blue];
		j1654556006 -> j3028613594;
	j1695384942 [label="「你偷偷溜到控制台那裡，在盡力保持隱蔽的同時嘗試操作控制台。你成功開啟了艙門。」",shape=box,color=blue];
		j1695384942 -> j209065810;
	j1265802429 [label="「違背自己理智判斷的扎比爾勇敢地衝了進去。即使是他也不夠快，無法避免被發現。守衛們開火了，而扎比爾悲慘地慘遭擊斃。」",shape=box,color=blue];
		j1265802429 -> j3103093747;
	j3028613594 [label="Boolean RampGuardZapped is now true.",color=orange];
		j3028613594 -> j1915017362;
	j209065810 [label="「被鼠群分散注意力的守衛們甚至都沒有注意到。」",shape=box,color=blue];
		j209065810 -> j256735146;
	j3103093747 [label="遊戲結束，夥計",shape=box,color=blue];
		j3103093747 -> j4266049940;
	j1915017362 [label="Check boolean HangarDoorsOpen",color=orange];
		j1915017362 -> j3178704668 [label=true,color=green];
		j1915017362 -> j153818713 [label=false,color=brown];
	j256735146 [label="Boolean HangarDoorsOpen is now true.",color=orange];
		j256735146 -> j1087431613;
	j4266049940 [label="再試一次嗎？這次讓扎比爾活下來，好嗎？",shape=box,color=blue];
		j4266049940 -> j2554407777;
		j4266049940 -> j1193089079;
	j3178704668 [label="「你感覺到機會來了，並衝向銳捷號。」",shape=box,color=blue];
		j3178704668 -> j3701847937;
	j153818713 [label="「扎比爾向你揮手，示意你打開機庫的門。」",shape=box,color=blue];
		j153818713 -> j2258215826;
	j1087431613 [label="Check boolean RampGuardZapped",color=orange];
		j1087431613 -> j3178704668 [label=true,color=green];
		j1087431613 -> j1055809245 [label=false,color=brown];
	j2554407777 [label="我保證這次應該不會再害死你了。",shape=box,color=red];
		j2554407777 -> j769413847;
	j1193089079 [label="我想我們可以在這裡結束了。[結束]",shape=box,color=red];
		j1193089079 -> j103180645;
	j3701847937 [label="「你看著扎比爾說，『我希望你知道怎麼駕駛這東西。』扎比爾回說，『我不會，但你會。』」",shape=box,color=blue];
		j3701847937 -> j3870322292;
	j1055809245 [label="「扎比爾指向坡道的守衛。」",shape=box,color=blue];
		j1055809245 -> j3381736593;
	j769413847 [label="Boolean KeepZabirAlive is now true.",color=orange];
		j769413847 -> j774369477;
	j103180645 [label="快被你搞死了",shape=box,color=blue];
		j103180645 -> "Chat ends.";
	j3870322292 [label="「你發動飛船，正當你要按下按鈕收起坡道並關上艙門時，扎比爾說，『等一下！我們不能丟下牠們。』」",shape=box,color=blue];
		j3870322292 -> j3156793525;
		j3870322292 -> j348800276;
	j3156793525 [label="你說得對，我們必須救牠們。",shape=box,color=red];
		j3156793525 -> j3129589498;
	j348800276 [label="拜託不要。我們真的應該丟下牠們。",shape=box,color=red];
		j348800276 -> j3043692570;
	j3129589498 [label="「扎比爾舉起哨子並吹響。」",shape=box,color=blue];
		j3129589498 -> j1106145452;
	j3043692570 [label="「『駁回！』扎比爾回說。」",shape=box,color=blue];
		j3043692570 -> j3129589498;
	j1106145452 [label="「幾秒後，幾十隻老鼠湧上飛船。扎比爾看著你大叫一聲，『快走！』」",shape=box,color=blue];
		j1106145452 -> j2335658178;
	j2335658178 [label="「飛船起飛了。Grineer 朝它開火，但子彈都被強大的銳捷號彈開了，飛船飛出了機庫。」",shape=box,color=blue];
		j2335658178 -> j1106421985;
	j1106421985 [label="「當鼠群在艦橋上鼠竄時，你望向浩瀚無垠的太空，然後自信地說，『銳速驅動，啟用。』銳捷號以曲速消失在遠方。」",shape=box,color=blue];
		j1106421985 -> j3286381628;
	j3286381628 [label="「完。」",shape=box,color=blue];
		j3286381628 -> j699750483;
	j699750483 [label="哇哦。",shape=box,color=red];
		j699750483 -> j2975419244;
	j2975419244 [label="所以，你覺得結局怎麼樣？會不會太瘋狂了？",shape=box,color=blue];
		j2975419244 -> j3293769002;
		j2975419244 -> j1369161258;
	j3293769002 [label="我不予置評。",shape=box,color=red];
		j3293769002 -> j1321607035;
	j1369161258 [label="是的，我很喜歡。",shape=box,color=red];
		j1369161258 -> j2721637073;
	j1321607035 [label="我看過更糟的回饋",shape=box,color=blue];
		j1321607035 -> j3103705255;
	j2721637073 [label="呼，我還擔心我這裡寫得有點太狂野了",shape=box,color=blue];
		j2721637073 -> j3103705255;
	j3103705255 [label="那麼，關於那個庫存清點的事。",shape=box,color=red];
		j3103705255 -> j2765060373;
