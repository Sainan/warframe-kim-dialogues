	4373 [label="抱歉，現在不行。[結束]",shape=box,color=red];
		4373 -> 4376;
	4374 [label="如果它準備好了，那我也就準備好了。",shape=box,color=red];
		4374 -> 4377;
	4375 [label="我想更了解那個帥氣的扎比爾。看來你可能有競爭對手了。",shape=box,color=red];
		4375 -> 4378;
	4372 [label="Chat ends. Next chat will be AmirRank6Convo3.",color=orange];
