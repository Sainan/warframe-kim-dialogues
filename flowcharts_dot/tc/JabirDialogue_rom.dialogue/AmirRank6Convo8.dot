	4423 [label="我們來用一下那個老鼠哨子的東東。",shape=box,color=red];
		4423 -> 4427;
	4421 [label="使用控制面板。",shape=box,color=red];
		4421 -> 4425;
	4424 [label="衝向銳捷號。",shape=box,color=red];
		4424 -> 4428;
	4422 [label="叫扎比爾攻擊坡道守衛。",shape=box,color=red];
		4422 -> 4426;
	4427 [label="「扎比爾拿起哨子，吹出一聲長音。除了呼吸聲以外，你什麼都聽不到。你坐著等待，但什麼都沒發生。沒有鼠群，什麼都沒有。扎比爾聳了聳肩。」",shape=box,color=blue];
		4427 -> 4432;
	4425 [label="「你走到控制面板前，但被一名警覺的守衛發現了。你試圖舉起雙手投降，但他們還是開槍擊斃了你，因為 Grineer 就是那樣無情。」",shape=box,color=blue];
		4425 -> 4429;
		4425 -> 4430;
	4428 [label="「你衝向飛船，但坡道的守衛發現了你並朝你開火。你的一天，還有你的生命，痛苦地畫上句點。」",shape=box,color=blue];
		4428 -> 4429;
		4428 -> 4433;
	4426 [label="哦，當然，有危險的時候你叫阿米爾上就好",shape=box,color=blue];
		4426 -> 4431;
	4432 [label="「然後你聽到了，一種咀嚼聲。像是在咀嚼東西。突然鼠群從機庫周圍的通風口中湧出。Grineer 守衛像小學生一樣尖叫並開火。子彈到處亂飛。」",shape=box,color=blue];
		4432 -> 4437;
	4429 [label="我需要休息一下。[結束]",shape=box,color=red];
		4429 -> 4434;
	4430 [label="再來一次。",shape=box,color=red];
		4430 -> 4435;
	4433 [label="再來！",shape=box,color=red];
		4433 -> 4438;
	4431 [label="我是指扎比爾",shape=box,color=blue];
		4431 -> 4436;
	4437 [label="「鼠群分散了守衛們的注意力。現在要幹嘛？」",shape=box,color=blue];
		4437 -> 4441;
		4437 -> 4442;
	4434 [label="你會回來的",shape=box,color=blue];
		4434 -> 4439;
	4435 [label="Update boolean OneMoreTime",color=orange];
		4435 -> 4414;
	4438 [label="Update boolean Again",color=orange];
		4438 -> 4414;
	4436 [label="好吧",shape=box,color=blue];
		4436 -> 4440;
	4441 [label="讓扎比爾電擊坡道守衛！",shape=box,color=red];
		4441 -> 4444;
	4442 [label="打開控制面板控制的門。",shape=box,color=red];
		4442 -> 4445;
	4439 [label="Chat ends.",color=orange];
	4440 [label="「你喊道，『扎比爾，上！』同時指向坡道的守衛。」",shape=box,color=blue];
		4440 -> 4443;
	4444 [label="「扎比爾衝向守衛並電擊他。守衛癱軟地倒下去。」",shape=box,color=blue];
		4444 -> 4447;
	4445 [label="「你偷偷溜到控制台那裡，在盡力保持隱蔽的同時嘗試操作控制台。你成功開啟了艙門。」",shape=box,color=blue];
		4445 -> 4448;
	4443 [label="「違背自己理智判斷的扎比爾勇敢地衝了進去。即使是他也不夠快，無法避免被發現。守衛們開火了，而扎比爾悲慘地慘遭擊斃。」",shape=box,color=blue];
		4443 -> 4446;
	4447 [label="Update boolean RampGuardZapped",color=orange];
		4447 -> 4450;
	4448 [label="「被鼠群分散注意力的守衛們甚至都沒有注意到。」",shape=box,color=blue];
		4448 -> 4451;
	4446 [label="遊戲結束，夥計",shape=box,color=blue];
		4446 -> 4449;
	4450 [label="Check boolean HangarDoorsOpen",color=orange];
		4450 -> 4455 [label=true,color=green];
		4450 -> 4454 [label=false,color=brown];
	4451 [label="Update boolean HangarDoorsOpen",color=orange];
		4451 -> 4456;
	4449 [label="再試一次嗎？這次讓扎比爾活下來，好嗎？",shape=box,color=blue];
		4449 -> 4452;
		4449 -> 4453;
	4455 [label="「你感覺到機會來了，並衝向銳捷號。」",shape=box,color=blue];
		4455 -> 4459;
	4454 [label="「扎比爾向你揮手，示意你打開機庫的門。」",shape=box,color=blue];
		4454 -> 4442;
	4456 [label="Check boolean RampGuardZapped",color=orange];
		4456 -> 4455 [label=true,color=green];
		4456 -> 4460 [label=false,color=brown];
	4452 [label="我保證這次應該不會再害死你了。",shape=box,color=red];
		4452 -> 4457;
	4453 [label="我想我們可以在這裡結束了。[結束]",shape=box,color=red];
		4453 -> 4458;
	4459 [label="「你看著扎比爾說，『我希望你知道怎麼駕駛這東西。』扎比爾回說，『我不會，但你會。』」",shape=box,color=blue];
		4459 -> 4462;
	4460 [label="「扎比爾指向坡道的守衛。」",shape=box,color=blue];
		4460 -> 4441;
	4457 [label="Update boolean KeepZabirAlive",color=orange];
		4457 -> 4414;
	4458 [label="快被你搞死了",shape=box,color=blue];
		4458 -> 4461;
	4462 [label="「你發動飛船，正當你要按下按鈕收起坡道並關上艙門時，扎比爾說，『等一下！我們不能丟下牠們。』」",shape=box,color=blue];
		4462 -> 4463;
		4462 -> 4464;
	4461 [label="Chat ends.",color=orange];
	4463 [label="你說得對，我們必須救牠們。",shape=box,color=red];
		4463 -> 4465;
	4464 [label="拜託不要。我們真的應該丟下牠們。",shape=box,color=red];
		4464 -> 4466;
	4465 [label="「扎比爾舉起哨子並吹響。」",shape=box,color=blue];
		4465 -> 4467;
	4466 [label="「『駁回！』扎比爾回說。」",shape=box,color=blue];
		4466 -> 4465;
	4467 [label="「幾秒後，幾十隻老鼠湧上飛船。扎比爾看著你大叫一聲，『快走！』」",shape=box,color=blue];
		4467 -> 4468;
	4468 [label="「飛船起飛了。Grineer 朝它開火，但子彈都被強大的銳捷號彈開了，飛船飛出了機庫。」",shape=box,color=blue];
		4468 -> 4469;
	4469 [label="「當鼠群在艦橋上鼠竄時，你望向浩瀚無垠的太空，然後自信地說，『銳速驅動，啟用。』銳捷號以曲速消失在遠方。」",shape=box,color=blue];
		4469 -> 4470;
	4470 [label="「完。」",shape=box,color=blue];
		4470 -> 4471;
	4471 [label="哇哦。",shape=box,color=red];
		4471 -> 4472;
	4472 [label="所以，你覺得結局怎麼樣？會不會太瘋狂了？",shape=box,color=blue];
		4472 -> 4473;
		4472 -> 4474;
	4473 [label="我不予置評。",shape=box,color=red];
		4473 -> 4475;
	4474 [label="是的，我很喜歡。",shape=box,color=red];
		4474 -> 4476;
	4475 [label="我看過更糟的回饋",shape=box,color=blue];
		4475 -> 4477;
	4476 [label="呼，我還擔心我這裡寫得有點太狂野了",shape=box,color=blue];
		4476 -> 4477;
	4477 [label="那麼，關於那個庫存清點的事。",shape=box,color=red];
		4477 -> 4478;
	4478 [label="哦，那件事嗎？",shape=box,color=blue];
		4478 -> 4479;
	4479 [label="今早弄完了",shape=box,color=blue];
		4479 -> 4480;
	4480 [label="+5 Chemistry",color=orange];
