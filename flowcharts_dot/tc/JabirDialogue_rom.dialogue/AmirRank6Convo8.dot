		4377 -> 4380;
	4378 [label="+5 Chemistry",color=orange];
		4378 -> 4381;
	4379 [label="Chat ends.",color=orange];
	4380 [label="哦……它準備好了",shape=box,color=blue];
		4380 -> 4382;
	4381 [label="不怪你，他確實很迷人",shape=box,color=blue];
		4381 -> 4382;
	4382 [label="開始了",shape=box,color=blue];
		4382 -> 4383;
	4383 [label="「你和剛重獲自由的扎比爾一起站在電力實驗室中央。他看向你說『沒有時間可以浪費了，快跟我來。』」",shape=box,color=blue];
		4383 -> 4384;
	4384 [label="「他帶你穿過一條又一條通道。他對這顆小行星瞭若指掌，清楚掌握每名守衛及他們的動線。」",shape=box,color=blue];
		4384 -> 4385;
		4384 -> 4386;
		4384 -> 4387;
	4385 [label="問扎比爾關於老鼠的事。",shape=box,color=red];
		4385 -> 4388;
	4386 [label="他也是囚犯嗎？",shape=box,color=red];
		4386 -> 4389;
	4387 [label="扎比爾要帶我去哪裡？",shape=box,color=red];
		4387 -> 4390;
	4388 [label="「扎比爾感到震驚。『鼠群找到你了？太棒了。成功了。看這個。』扎比爾舉起一個雕工精美的金哨子。『鼠后送我的。我們需要找到她。』」",shape=box,color=blue];
		4388 -> 4391;
	4389 [label="「你問扎比爾他是怎麼來到這裡的，『沒時間說這些了，』他回說，『我們需要先想辦法逃離這裡。』」",shape=box,color=blue];
		4389 -> 4385;
		4389 -> 4387;
	4390 [label="「扎比爾回過頭對你說，『帶你去機庫。我們去偷一艘船，然後盡可能遠離這裡。找到鼠后。』」",shape=box,color=blue];
		4390 -> 4391;
	4391 [label="鼠后？",shape=box,color=red];
		4391 -> 4392;
	4392 [label="「『她給了我這個哨子。鼠群對它唯命是從。她是我的朋友。雖然她不是總是那麼友善，但她還是會關心我。』」",shape=box,color=blue];
		4392 -> 4393;
		4392 -> 4394;
	4393 [label="你有給莉蒂看過這個了嗎？",shape=box,color=red];
		4393 -> 4395;
	4394 [label="她聽起來也很熟悉。",shape=box,color=red];
		4394 -> 4396;
	4395 [label="我非常珍惜自己的生命，所以才不會去冒那個險",shape=box,color=blue];
		4395 -> 4397;
	4396 [label="若與現實或想像中之人物有著任何雷同之處，純屬巧合",shape=box,color=blue];
		4396 -> 4397;
	4397 [label="「在扎比爾的幫助下，你在小行星的通道中曲折前行。他巧妙地避開了守衛和監視器。」",shape=box,color=blue];
		4397 -> 4398;
	4398 [label="「最終，你們來到一扇大門前。扎比爾示意要蹲下。你們都蹲下身子，並偷偷溜進了飛船機庫。」",shape=box,color=blue];
		4398 -> 4399;
	4399 [label="你蹲在柱子的陰影中。附近可以聽到 Grineer 守衛的聲音。",shape=box,color=blue];
		4399 -> 4400;
	4400 [label="「你會怎麼做？」",shape=box,color=blue];
		4400 -> 4401;
		4400 -> 4402;
	4401 [label="攻擊守衛。",shape=box,color=red];
		4401 -> 4403;
	4402 [label="到處看看。",shape=box,color=red];
		4402 -> 4404;
	4403 [label="「沒有一絲自我保護意識或事先預謀，你就衝向一旁的開闊區域。而這時另一邊的一群守衛就開始射擊。你直接衝向子彈流，瞬間被火力擊斃。扎比爾對你這種無腦逞一時勇的行為搖了搖頭。」",shape=box,color=blue];
		4403 -> 4405;
	4404 [label="「你探頭探向拐角，勘察周遭的區域。」",shape=box,color=blue];
		4404 -> 4406;
	4405 [label="要再試一次嗎，還有這次不要再讓自己秒死了，好嗎？",shape=box,color=blue];
		4405 -> 4407;
		4405 -> 4408;
	4406 [label="「一艘銳捷號停在機庫正中央。進入銳捷號的坡道被一名守衛擋著。機庫一側有十幾名 Grineer 正在忙著玩骰子遊戲。你前方幾步處有一張桌子，上面有一個控制面板。」",shape=box,color=blue];
		4406 -> 4409;
	4407 [label="好 der。",shape=box,color=red];
		4407 -> 4410;
	4408 [label="今天這樣就夠了。[結束]",shape=box,color=red];
		4408 -> 4411;
	4409 [label="「『要想出去，我們得先打開機庫的大門。』扎比爾細語道。」",shape=box,color=blue];
		4409 -> 4412;
	4410 [label="「你這次會怎麼做？」",shape=box,color=blue];
		4410 -> 4413;
		4410 -> 4402;
	4411 [label="Chat ends.",color=orange];
	4412 [label="「扎比爾看向你說，『有什麼好主意嗎？』」",shape=box,color=blue];
		4412 -> 4414;
		4412 -> 4412;
	4413 [label="……勘察周遭區域嗎？",shape=box,color=red];
		4413 -> 4404;
