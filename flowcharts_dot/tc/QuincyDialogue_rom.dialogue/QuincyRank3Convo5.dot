digraph {
	1431 [label="QuincyRank3Convo5 begins.",color=orange];
		1431 -> 1503;
		1431 -> 1504;
	1503 [label="好吧，我忍不住要問了，攝影到底是什麼一回事？",shape=box,color=red];
		1503 -> 1505;
	1504 [label="在這些事發生之前，你本來……想做什麼？",shape=box,color=red];
		1504 -> 1506;
	1505 [label="我就不能有點愛好嗎？每個人都得有自己的愛好啊，老友，哈哈",shape=box,color=blue];
		1505 -> 1507;
		1505 -> 1508;
	1506 [label="嗯……我也不知道像我這樣的人是否真的能擁有對未來的夢想，老友",shape=box,color=blue];
		1506 -> 1525;
	1507 [label="我真的很喜歡給你拍照，真是太美了。",shape=box,color=red];
		1507 -> 1509;
		1507 -> 1510;
	1508 [label="我只是很好奇。",shape=box,color=red];
		1508 -> 1509;
		1508 -> 1510;
	1525 [label="對於像我這樣的人來說，生活根本就不是那樣的，你懂我的意思吧。我曾夢想有一天能成名，帶著一大筆錢回家給奶奶和妹妹",shape=box,color=blue];
		1525 -> 1526;
	1509 [label="我只是想知道你是從哪裡開始接觸它的，僅此而已。",shape=box,color=red];
		1509 -> 1511;
	1510 [label="你看起來不像是個喜歡攝影的人。",shape=box,color=red];
		1510 -> 1512;
	1526 [label="但現在這些都不會發生了，對吧？我在這，我們都在這，一直循環著，永遠循環著。或者直到什麼地方出現問題，一切崩塌，但誰知道呢",shape=box,color=blue];
		1526 -> 1527;
		1526 -> 1528;
	1511 [label="我爸。他去世時，我們還留著他所有的東西，對吧？月尊可不允許你帶行李。",shape=box,color=blue];
		1511 -> 1515;
	1512 [label="我為什麼非得一定要這麼街頭風？",shape=box,color=blue];
		1512 -> 1513;
	1527 [label="你倒是挺能接受「永遠困在這裡」的事嘛。",shape=box,color=red];
		1527 -> 1529;
	1528 [label="你好像很少提到你的家人。",shape=box,color=red];
		1528 -> 1531;
	1515 [label="我們把所有值錢的東西都賣了，當然啦，我們都得付房租嘛，老兄。不過還有些雜七雜八的東西留著",shape=box,color=blue];
		1515 -> 1516;
	1513 [label="哎呀，老兄，能不能有點深度？",shape=box,color=blue];
		1513 -> 1514;
	1529 [label="改不了，那又何必氣得跳腳？我們還有事情要做，而且也有好的一面",shape=box,color=blue];
		1529 -> 1530;
	1531 [label="Check boolean QuincyHome1",color=orange];
		1531 -> 1534 [label=true,color=green];
		1531 -> 1532 [label=false,color=brown];
	1516 [label="小時候有次翻箱子，掏出個小綠色的矩形相機",shape=box,color=blue];
		1516 -> 1517;
	1514 [label="Chat ends.",color=orange];
	1530 [label="我肯定遲早會受不了的，可能會瘋掉，但現在還行。我可是很堅強的",shape=box,color=blue];
		1530 -> 1533;
	1534 [label="我想我沒有提過。我有個妹妹，有我的奶奶，還有我的姑媽。妹妹和奶奶住在拉德斯頓，姑媽住在沙瑪卡，那是一個海外熱帶的小島，美得不像話。我告訴你，這場末日真是挑錯地方了。我們本來可以在沙瑪卡的",shape=box,color=blue];
		1534 -> 1537;
		1534 -> 1538;
		1534 -> 1539;
	1532 [label="Check boolean QuincyHomeAsked",color=orange];
		1532 -> 1535 [label=true,color=green];
		1532 -> 1536 [label=false,color=brown];
	1517 [label="那閃光燈充電時聲音難聽爆了，應該是電容器的問題吧，或者什麼其它的",shape=box,color=blue];
		1517 -> 1518;
	1533 [label="不過我覺得莉蒂應付得不怎麼好……陛下也一樣",shape=box,color=blue];
		1533 -> 1544;
		1533 -> 1545;
	1537 [label="你還有和他們聯繫嗎？我們可是有手機啊，開呼啊。",shape=box,color=red];
		1537 -> 1541;
	1538 [label="他們至少知道你還好吧？",shape=box,color=red];
		1538 -> 1541;
	1539 [label="你一定很想念他們吧……",shape=box,color=red];
		1539 -> 1540;
	1535 [label="可能吧。我有個妹妹、奶奶和姑媽。妹妹和奶奶在老家，姑媽住在沙瑪卡。別再問我沙瑪卡在地圖上的位置了，它根本離這兒遠得很。不過，我得說，這場末日真的是選錯地方了，本來我們可以在沙瑪卡那樣的天堂",shape=box,color=blue];
		1535 -> 1537;
		1535 -> 1538;
		1535 -> 1539;
	1536 [label="大概是吧。我有個妹妹、一個奶奶，還有個姑媽。妹妹和奶奶待在家裡，而姑媽更遠，在沙瑪卡。這場末日真是選錯地方了，我們本來可以在沙瑪卡的",shape=box,color=blue];
		1536 -> 1537;
		1536 -> 1538;
		1536 -> 1539;
	1518 [label="拍的照片糟透了，可我還是超喜歡",shape=box,color=blue];
		1518 -> 1519;
	1544 [label="至少你們還有彼此。",shape=box,color=red];
		1544 -> 1546;
	1545 [label="他們會安頓下來的，我相信。",shape=box,color=red];
		1545 -> 1547;
	1541 [label="是啊，我有聯繫。他們還好，科腐者還沒蔓延到那邊。不知道以後會不會變，希望不會",shape=box,color=blue];
		1541 -> 1543;
	1540 [label="是啊，當然想。但我已經很久很久沒回家了，老兄，真的很久。軍隊、危應部隊，現在又到這裡？",shape=box,color=blue];
		1540 -> 1542;
	1519 [label="以前到處亂跑亂拍什麼都拍，把我姑媽氣得發瘋，哈哈！那可是一段好日子",shape=box,color=blue];
		1519 -> 1520;
	1546 [label="是啊，我們的確還有彼此。而人們會適應。這就是人類最厲害的地方，對吧？不管發生什麼，你向人們扔炸彈，人們還是會像「哦，該去買麵包了，哼哼哈嘿」一樣繼續生活",shape=box,color=blue];
		1546 -> 1548;
	1547 [label="人們會適應。這就是人類最厲害的地方，對吧？不管發生什麼，你向人們扔炸彈，人們還是會像「哦，該去買麵包了，哼哼哈嘿」一樣繼續生活",shape=box,color=blue];
		1547 -> 1548;
	1543 [label="真的很想念他們。不過能聽到他們的聲音，已經算是一種安慰了。我早就習慣了不能回家，這麼多年，除了偶爾假期回去一兩次，我已經好多年沒踏進家門了",shape=box,color=blue];
		1543 -> 1553;
	1542 [label="除了偶爾假期回去一兩次，我已經好多好多年沒回家了",shape=box,color=blue];
		1542 -> 1553;
	1520 [label="我想我那時候就迷上了。從那以後，只要有時間我就喜歡拍照，拍照能讓我忘掉工作",shape=box,color=blue];
		1520 -> 1521;
	1548 [label="奶奶給我看過她們在戰爭時期的照片，那時每晚都有人往他們頭上丟炸彈，但一切就像「是啊，我們就當什麼事都沒發生一樣過日子吧」",shape=box,color=blue];
		1548 -> 1549;
	1553 [label="Check boolean QuincyFlirt",color=orange];
		1553 -> 1554 [label=true,color=green];
		1553 -> 1555 [label=false,color=brown];
	1521 [label="透過瞄準鏡和透過鏡頭去看世界是差不多的……除了結局不一樣",shape=box,color=blue];
		1521 -> 1522;
	1549 [label="當我還是個小屁孩的時候，我覺得這簡直是瘋了，怎麼可能會做到？！後來我長大了，經歷了戰爭……然後我看到了這一切",shape=box,color=blue];
		1549 -> 1550;
	1554 [label="現在，變成這樣？我是說，我倒是不介意……顯然你也挺欣賞我的賣相吧 ;)",shape=box,color=blue];
		1554 -> 1556;
	1555 [label="……現在，變成這樣？我是說，我倒是不介意………而且那些被我帶到這裡的男男女女肯定也不會介意，哈哈",shape=box,color=blue];
		1555 -> 1556;
	1522 [label="但我可以捕捉那些瞬間。我覺得，我是想向世界展示那些人們不願面對的事情，或者早已遺忘的東西",shape=box,color=blue];
		1522 -> 1523;
