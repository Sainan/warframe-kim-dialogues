		2319 -> 2320 [label=true,color=green];
		2319 -> 2321 [label=false,color=brown];
	2320 [label="你提過那個叫 parvos 的家伙，挺有錢的那個",shape=box,color=blue];
		2320 -> 2322;
	2321 [label="在你未來的世界裡，有沒有什麼像是……巨頭人物？",shape=box,color=blue];
		2321 -> 2323;
		2321 -> 2324;
	2322 [label="你覺得他快樂嗎？",shape=box,color=blue];
		2322 -> 2328;
		2322 -> 2327;
		2322 -> 2329;
	2323 [label="巨頭人物？什麼意思？",shape=box,color=red];
		2323 -> 2325;
	2324 [label="巨頭，是指大企業嗎？",shape=box,color=red];
		2324 -> 2326;
	2328 [label="快樂？我不太了解那個人啊，崑。我們不熟，也沒怎麼來往。",shape=box,color=red];
		2328 -> 2331;
	2327 [label="你為什麼這麼問？",shape=box,color=red];
		2327 -> 2332;
	2329 [label="我沒時間談他了。[結束]",shape=box,color=red];
		2329 -> 2330;
	2325 [label="巨頭。企業。商界的大佬，滿身是錢的富豪",shape=box,color=blue];
		2325 -> 2335;
		2325 -> 2334;
	2326 [label="對，你懂的。商界的大佬，滿身是錢的富豪",shape=box,color=blue];
		2326 -> 2335;
		2326 -> 2334;
	2331 [label="是啊，但你和他有過互動。你聽過他說話，接觸過他身邊人",shape=box,color=blue];
		2331 -> 2333;
	2332 [label="因為這個世界一直都是擁有的人擁有很多，沒有的人一無所有，對吧？我想知道這世界是不是永遠都是這樣",shape=box,color=blue];
		2332 -> 2340;
		2332 -> 2338;
		2332 -> 2339;
	2330 [label="Chat ends.",color=orange];
	2335 [label="其實是有的。Parvos Granum，Corpus 的首領。",shape=box,color=red];
		2335 -> 2337;
	2334 [label="我沒時間談他了，抱歉。[結束]",shape=box,color=red];
		2334 -> 2336;
	2333 [label="你覺得他對自己的生活感到快樂嗎？甚至滿足？",shape=box,color=blue];
		2333 -> 2340;
		2333 -> 2338;
		2333 -> 2339;
	2340 [label="我覺得錢買不到快樂。",shape=box,color=red];
		2340 -> 2341;
	2338 [label="我認為那些說錢買不到幸福的人只是缺乏創意。",shape=box,color=red];
		2338 -> 2343;
	2339 [label="從我觀察來看情況確實如此。他有一些支持者，看起來他們支持他的理由*不只是*為了錢。",shape=box,color=red];
		2339 -> 2344;
	2337 [label="Update boolean QuincyParvos",color=orange];
		2337 -> 2333;
	2336 [label="Chat ends.",color=orange];
	2341 [label="那我覺得你只是因為不夠努力，哈哈",shape=box,color=blue];
		2341 -> 2342;
	2343 [label="對，沒錯。他們就是不夠努力，笑死",shape=box,color=blue];
		2343 -> 2342;
	2344 [label="哦，是嗎？請說",shape=box,color=blue];
		2344 -> 2346;
		2344 -> 2345;
	2342 [label="他有家人嗎？或者支持他的人？",shape=box,color=blue];
		2342 -> 2346;
		2342 -> 2345;
	2346 [label="有個名為 Vala Glarios 的女士。她原本只是他的一個部下，但當戰艦沉沒時，她仍然繼續開炮，怒吼著與命運抗爭到底。",shape=box,color=red];
		2346 -> 2347;
	2345 [label="他培養了一些姐妹，把她們聚在身邊。而且我看得出他對她們感到自豪，把她們當作家人看待。",shape=box,color=red];
		2345 -> 2349;
	2347 [label="他曾打開過虛空的一道裂縫，至於細節嘛，是個很長故事，但沒那麼重要。他救了她的命。我覺得他真的很欣賞她，也很重視她，甚至像看待妹妹一樣對待她。",shape=box,color=red];
		2347 -> 2348;
	2349 [label="說真的，有點邪教那味兒了。不過你能怎麼辦？這就是金錢的特性啊。",shape=box,color=red];
		2349 -> 2351;
	2348 [label="我覺得她也把他當成家人看待。",shape=box,color=red];
		2348 -> 2353;
	2351 [label="金錢能買到忠誠，只要你還繼續擁有它。畢竟，黃金崇拜可是世上最古老的信仰",shape=box,color=blue];
		2351 -> 2350;
		2351 -> 2352;
	2353 [label="沒有人是絕對的善或絕對的惡，你知道吧？聽起來這人很清楚誰是他真正的朋友，懂我的意思嗎？",shape=box,color=blue];
		2353 -> 2354;
	2350 [label="我真的不喜歡你聽起來這麼像他。人生可不只有錢。",shape=box,color=red];
		2350 -> 2361;
	2352 [label="你們倆肯定合得來，合得不得了。",shape=box,color=red];
		2352 -> 2361;
	2354 [label="他有資源照顧他在乎的人，身邊的人都知道這一點",shape=box,color=blue];
		2354 -> 2357;
		2354 -> 2358;
		2354 -> 2355;
		2354 -> 2356;
	2361 [label="我沒說這混蛋是什麼英雄，老兄，哈哈哈。這世上哪有英雄？我的意思是，他有能力讓自己過得開心，也能照顧他在乎的人而已",shape=box,color=blue];
		2361 -> 2362;
	2357 [label="為了生存他只能去做他必須要做的事，我尊重這一點。即使這通常意味著我們站在對立面。",shape=box,color=red];
		2357 -> 2359;
	2358 [label="他只會留下對他有價值的人。只要成為了累贅，他就會立刻甩掉他們。",shape=box,color=red];
		2358 -> 2361;
	2355 [label="這並不意味著他不是個冷酷無情的混蛋。我一點都不信任他。而且他的手下總是擋在我槍口前面。",shape=box,color=red];
		2355 -> 2361;
	2356 [label="我真的無法認同他掠奪式開採宇宙資源的立場。我更傾向於幫助那些需要幫助的人，而不是只關注純粹的貪婪。",shape=box,color=red];
		2356 -> 2361;
	2362 [label="對我來說，這完全就是我的夢想。讓我、我的兄弟和家人一輩子安穩，誰都不會挨餓受苦。而要做到這一切？你得賺大錢",shape=box,color=blue];
		2362 -> 2365;
		2362 -> 2363;
		2362 -> 2364;
	2359 [label="+10 Chemistry",color=orange];
		2359 -> 2360;
	2365 [label="所以你想變得富有是為了他人嗎？",shape=box,color=red];
		2365 -> 2366;
	2363 [label="所以你想變得富有是為了自己嗎？",shape=box,color=red];
		2363 -> 2369;
	2364 [label="說到底這一切還是純粹的貪婪。",shape=box,color=red];
		2364 -> 2370;
	2360 [label="我就是這個意思。他不是什麼英雄，這個世界上也沒有英雄。他只是有辦法讓自己快樂並照顧他在乎的人而已",shape=box,color=blue];
		2360 -> 2362;
	2366 [label="+10 Chemistry",color=orange];
		2366 -> 2367;
	2369 [label="你還是不明白。如果我變得富有，我就能去幫助別人。羅賓漢的想法是錯的，窮人幫不了窮人，只有富人才能幫助窮人。因為權力全都掌握在富人手中",shape=box,color=blue];
		2369 -> 2368;
	2370 [label="你不懂，你真的不懂。金錢就是權力，而權力能改變這個世界運作的方式",shape=box,color=blue];
		2370 -> 2371;
	2367 [label="沒錯！權力就在那裡。一旦你站穩腳跟，就能幫助其他人，推動真正的改變。在此之前？你只不過是一個被視為製造麻煩的人，明白我意思嗎？",shape=box,color=blue];
		2367 -> 2368;
	2368 [label="怎樣也好，我得走了",shape=box,color=blue];
		2368 -> 2372;
	2371 [label="算了，我不想跟你爭論",shape=box,color=blue];
		2371 -> 2372;
	2372 [label="不過我還是真有點想見見那個叫parvos的家伙",shape=box,color=blue];
		2372 -> 2373;
	2373 [label="聽起來挺有意思的，雖然有點像個混蛋。不過巨頭中的那些人到頭來都差不多",shape=box,color=blue];
		2373 -> 2374;
	2374 [label="因為這就是出人頭地的方式，對吧",shape=box,color=blue];
		2374 -> 2375;
	2375 [label="Chat ends.",color=orange];
}