	j743543049 [label="最近一直在店裡幫葵，忙著維修那些重機",shape=box,color=blue];
		j743543049 -> j4057672389;
	j4057672389 [label="她和韋利米爾相處起來就像家人一樣，可愛到無法言喻，哈哈",shape=box,color=blue];
		j4057672389 -> j2961363183;
		j4057672389 -> j3068242535;
	j2961363183 [label="你從來不怎麼談論葵。",shape=box,color=red];
		j2961363183 -> j2708821284;
	j3068242535 [label="你覺得韋利米爾怎麼樣？",shape=box,color=red];
		j3068242535 -> j2468680651;
	j2708821284 [label="從來沒這必要吧？葵就是葵。她雖不是堅不可摧，但也從來不是累贅",shape=box,color=blue];
		j2708821284 -> j910141653;
	j2468680651 [label="哈哈──",shape=box,color=blue];
		j2468680651 -> j3617827555;
	j910141653 [label="那名女子清楚知道自己是誰，也知道怎麼處理自己的事",shape=box,color=blue];
		j910141653 -> j1212652259;
	j3617827555 [label="夥計，我就喜歡那種清楚知道自己是誰，而且完全不在乎別人看法的男人",shape=box,color=blue];
		j3617827555 -> j504968364;
	j1212652259 [label="而且她打從第一天就把我給看透了，笑死",shape=box,color=blue];
		j1212652259 -> j3723041914;
	j504968364 [label="老大應該可以從他身上習得一二",shape=box,color=blue];
		j504968364 -> j3488132386;
	j3723041914 [label="起初讓我覺得很緊張，以為她打算「改造」我還是什麼的",shape=box,color=blue];
		j3723041914 -> j3350690053;
	j3488132386 [label="雖然他叫我，「長射手 麥極不列坦」先生",shape=box,color=blue];
		j3488132386 -> j3445343869;
	j3350690053 [label="但沒有。她懂我。在某種程度上她就像我大姊姊一樣",shape=box,color=blue];
		j3350690053 -> j2134776798;
	j3445343869 [label="……我長得沒那麼不列坦吧，有嗎？",shape=box,color=blue];
		j3445343869 -> j1997522366;
		j3445343869 -> j987435036;
	j2134776798 [label="只是別告訴她我這麼說，不然我會隔牆射你，哈哈",shape=box,color=blue];
		j2134776798 -> "Chat ends.";
	j1997522366 [label="是的。沒錯，你就是。而且就算我從來沒去過那裡，但我就是知道。",shape=box,color=red];
		j1997522366 -> j2135843849;
	j987435036 [label="我不會知道，我只有你和亞瑟可以參考。",shape=box,color=red];
		j987435036 -> j4109272117;
	"Chat ends." [color=orange];
	j2135843849 [label="+5 Chemistry",color=orange];
