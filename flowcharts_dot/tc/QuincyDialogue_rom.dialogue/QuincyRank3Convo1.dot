digraph {
	1132 [label="QuincyRank3Convo1 begins.",color=orange];
		1132 -> 1175;
		1132 -> 1176;
		1132 -> 1177;
	1175 [label="我覺得你是這方面的專家。這時代除了線上男孩，還有其他音樂嗎？",shape=box,color=red];
		1175 -> 1178;
