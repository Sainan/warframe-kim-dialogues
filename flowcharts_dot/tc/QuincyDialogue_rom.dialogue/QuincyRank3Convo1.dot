		1178 -> 1180;
	1179 [label="Chat ends.",color=orange];
	1180 [label="這沒什麼丟臉的。我也不會對那些要靠它來過活的人指指點點",shape=box,color=blue];
		1180 -> 1181;
	1181 [label="我知道名利是有代價的，生活中沒什麼是免費的，但看起來確實不錯",shape=box,color=blue];
		1181 -> 1182;
		1181 -> 1183;
		1181 -> 1184;
		1181 -> 1185;
	1182 [label="我就是想聽點不一樣的，這個……不太合我口味。",shape=box,color=red];
		1182 -> 1188;
	1183 [label="我不覺得我會想靠這個賺錢……壓力太大了，太公開了。",shape=box,color=red];
		1183 -> 1186;
	1184 [label="那些崇拜你的粉絲？那些渴望接近你的人？那肯定會很棒。",shape=box,color=red];
		1184 -> 1187;
	1185 [label="我只希望能讓他們閉嘴。我真不懂葵是怎麼忍受的。",shape=box,color=red];
		1185 -> 1190;
	1188 [label="我懂你，我懂你。老實說，這也不是我的菜，老兄。不過我看看能不能幫你安排點什麼，像是 Mf Calamity、Mos Prob、Prof Dre",shape=box,color=blue];
		1188 -> 1193;
	1186 [label="Update boolean QuincyFamous",color=orange];
		1186 -> 1189;
	1187 [label="Update boolean QuincyFamous",color=orange];
		1187 -> 1191;
	1190 [label="你可別因為她喜歡的東西而看不起她。這世界上的快樂已經不夠分了，別試圖剝奪她那一點點擁有的快樂",shape=box,color=blue];
		1190 -> 1192;
	1193 [label="給你弄點好喝的，放些音樂，我們很快就能讓你融入這裡",shape=box,color=blue];
		1193 -> 1194;
		1193 -> 1195;
	1189 [label="認真？不，那就是我的夢想啊。站在聚光燈下？男人女人都為我著迷？鈔票滾滾來，每晚都有狂歡派對？",shape=box,color=blue];
		1189 -> 1196;
	1191 [label="你懂我，這就是夢想啊！站在聚光燈下，男人女人都對我垂涎三尺，鈔票滾滾而來，每晚都有派對狂歡",shape=box,color=blue];
		1191 -> 1196;
	1192 [label="這是最容易惹火她的方式，也會讓我覺得你沒自己以為的那麼厲害",shape=box,color=blue];
		1192 -> 1222;
		1192 -> 1223;
	1194 [label="聽起來不錯啊。:)",shape=box,color=red];
		1194 -> 1203;
	1195 [label="我覺得我剛剛簽了個自找麻煩的合同。",shape=box,color=red];
		1195 -> 1942;
	1196 [label="那是他媽的肯定啦，老友。但現在是做不到的吧，除非你袖子裡藏了什麼超強魔法",shape=box,color=blue];
		1196 -> 1198;
		1196 -> 1199;
	1222 [label="哎呀……抱歉，抱歉。這真不是我的菜。",shape=box,color=red];
		1222 -> 1224;
	1223 [label="我沒想到你這麼護著她。",shape=box,color=red];
		1223 -> 1225;
	1203 [label="+20 Chemistry",color=orange];
		1203 -> 1201;
	1942 [label="+20 Chemistry",color=orange];
		1942 -> 1202;
	1198 [label="我是說，這裡商場裡有個舞台……",shape=box,color=red];
		1198 -> 1197;
	1199 [label="我可沒*那種*魔術把戲啊，抱歉啊。",shape=box,color=red];
		1199 -> 1200;
	1224 [label="那你幹嘛非要拖別人下水，老兄？直接幹不就行了？",shape=box,color=blue];
		1224 -> 1237;
