		1207 -> 1208;
	1242 [label="沒錯，老兄",shape=box,color=blue];
		1242 -> 1238;
	1240 [label="這才是人生該有的活法，兄弟。我罩著你，放心吧",shape=box,color=blue];
		1240 -> 1238;
	1232 [label="葵可以喜歡她喜歡的東西，你可以不聽，也別批評",shape=box,color=blue];
		1232 -> 1233;
		1232 -> 1234;
	1233 [label="抱歉，我不是想假裝自己比別人厲害，那些東西真的讓我很抓狂。",shape=box,color=red];
		1233 -> 1235;
	1234 [label="兄弟，我只是說實話而已。",shape=box,color=red];
		1234 -> 1236;
	1208 [label="他開始用拳頭敲大腿，沒用麥克風就唱了起來。眼睛閉著，不知道是什麼歌，但聽到歌詞時我全身發抖。就像某個鬼魂回來摸了我一樣",shape=box,color=blue];
		1208 -> 1209;
	1238 [label="Chat ends.",color=orange];
	1235 [label="那你就直接這麼說就好了",shape=box,color=blue];
		1235 -> 1237;
	1236 [label="隨便你，蠢材",shape=box,color=blue];
		1236 -> 1244;
	1209 [label="「你為什麼坐在我的墳前，還想讓死人開口說話？為什麼你哭著打擾我的安息，卻不讓我入睡？」",shape=box,color=blue];
		1209 -> 1210;
	1244 [label="Chat ends.",color=orange];
	1210 [label="「我的胸膛像泥土一樣冰冷，我的呼吸充滿人世氣息。如果你吻了我冰冷的泥土雙唇，你的日子就不會長久」",shape=box,color=blue];
		1210 -> 1211;
	1211 [label="光是想想就渾身發冷，靠",shape=box,color=blue];
		1211 -> 1212;
	1212 [label="我們全場都他媽安靜了……盯著他看了足足4分鐘，不知道要幹什麼好",shape=box,color=blue];
		1212 -> 1213;
	1213 [label="我是第一個開口的人，我必須站出來，告訴他我的想法",shape=box,color=blue];
