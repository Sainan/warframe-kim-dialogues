digraph {
	1898 [label="QuincyAmirNightmares begins.",color=orange];
		1898 -> 1897;
	1897 [label="嗨",shape=box,color=blue];
		1897 -> 1888;
	1888 [label="我照你說的，去找那個疾風仔談過了",shape=box,color=blue];
		1888 -> 1901;
		1888 -> 1899;
		1888 -> 1904;
	1901 [label="順利嗎？",shape=box,color=red];
		1901 -> 1900;
	1899 [label="哇，真聽我的了？",shape=box,color=red];
		1899 -> 1902;
	1904 [label="抱歉，我正忙著呢。[結束]",shape=box,color=red];
		1904 -> 1903;
	1900 [label="一開始他還以為我要揍他，笑死。但我把帶他上了屋頂，我們坐下來聊了聊",shape=box,color=blue];
		1900 -> 1905;
	1902 [label="媽的閉嘴，讓我說完，行不？",shape=box,color=blue];
		1902 -> 1900;
	1903 [label="Chat ends.",color=orange];
	1905 [label="我告訴他，我知道他經常做那些惡夢，也知道他現在狀態不太好",shape=box,color=blue];
		1905 -> 1907;
		1905 -> 1906;
	1907 [label="然後呢？",shape=box,color=red];
		1907 -> 1908;
	1906 [label="他怎麼說？",shape=box,color=red];
		1906 -> 1908;
	1908 [label="一開始什麼都沒說",shape=box,color=blue];
		1908 -> 1909;
	1909 [label="他就那樣坐在那裡，看起來挺羞愧的",shape=box,color=blue];
		1909 -> 1910;
	1910 [label="他大概以為我要取笑他",shape=box,color=blue];
		1910 -> 1911;
	1911 [label="說實話，他看起來那麼慌，還真挺讓人想嘲笑他的",shape=box,color=blue];
		1911 -> 1912;
	1912 [label="於是……我跟他講了我第一次要去殺人的事。第一次透過瞄準鏡瞄準並奪走一條生命",shape=box,color=blue];
		1912 -> 1893;
	1893 [label="在戰場上殺紅了眼，有人拿槍拿刀衝過來，這是一回事……",shape=box,color=blue];
		1893 -> 1913;
	1913 [label="當你在屋頂上，距離他們300碼，他們甚至不知道你在哪，這又是另一回事了……",shape=box,color=blue];
		1913 -> 1914;
	1914 [label="然後你就有時間去*想*，他們是誰，為什麼會在那裡，有家人嗎？有孩子嗎？",shape=box,color=blue];
		1914 -> 1931;
	1931 [label="然後……你扣下扳機，砰",shape=box,color=blue];
		1931 -> 1928;
	1928 [label="現在這些已經不重要了",shape=box,color=blue];
		1928 -> 1889;
	1889 [label="他們死了，是我奪走了他們的生命",shape=box,color=blue];
		1889 -> 1892;
	1892 [label="那張臉一直留在我的腦海裡",shape=box,color=blue];
		1892 -> 1915;
	1915 [label="之後的每一個也都一樣",shape=box,color=blue];
		1915 -> 1896;
		1915 -> 1930;
	1896 [label="他有什麼反應……？",shape=box,color=red];
		1896 -> 1916;
	1930 [label="聽起來……真讓人振奮。",shape=box,color=red];
		1930 -> 1916;
	1916 [label="他很久都沒說話，我們只是坐在那裡沉默著",shape=box,color=blue];
		1916 -> 1927;
	1927 [label="然後他……告訴了我他最近做的那些惡夢",shape=box,color=blue];
		1927 -> 1894;
	1894 [label="他總覺得因為自己不是個真正的士兵而沒法成為團隊的一份子",shape=box,color=blue];
		1894 -> 1890;
	1890 [label="所以我跟他說了我以前經常做的那些惡夢，就像我小時候做的那些",shape=box,color=blue];
		1890 -> 1891;
	1891 [label="但我跟他道歉，說我一直以來都像個混蛋一樣對待他",shape=box,color=blue];
		1891 -> 1895;
	1895 [label="我還告訴他他跟我們一樣屬於這裡，就像其他人一樣。我也有我的特質，就像他有他的特質一樣，這就是我們的本性，你懂我意思嗎？",shape=box,color=blue];
		1895 -> 1929;
	1929 [label="……然後你知道他說了什麼嗎……？",shape=box,color=blue];
		1929 -> 1926;
		1929 -> 1925;
	1926 [label="什麼？",shape=box,color=red];
		1926 -> 1922;
	1925 [label="不？",shape=box,color=red];
		1925 -> 1922;
	1922 [label="「你說得對，你這個混蛋」",shape=box,color=blue];
		1922 -> 1920;
	1920 [label="可就在我快要把他推下屋頂的時候？",shape=box,color=blue];
		1920 -> 1921;
	1921 [label="他抱了我，媽的他居然抱了我。還說：「但你也是我大哥」",shape=box,color=blue];
		1921 -> 1923;
	1923 [label="什麼鬼",shape=box,color=blue];
		1923 -> 1924;
	1924 [label="但是……算了。值了。我覺得這對他真的有意義……對我來說，我猜，也有意義",shape=box,color=blue];
		1924 -> 1918;
	1918 [label="+20 Chemistry",color=orange];
		1918 -> 1919;
	1919 [label="所以……謝啦",shape=box,color=blue];
		1919 -> 1917;
	1917 [label="Chat ends.",color=orange];
}