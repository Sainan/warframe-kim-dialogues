digraph {
	1845 [label="QuincyAmirSoldier begins.",color=orange];
		1845 -> 1846;
	1846 [label="嗨",shape=box,color=blue];
		1846 -> 1847;
	1847 [label="我照你說的，去找那個疾風仔談過了",shape=box,color=blue];
		1847 -> 1850;
		1847 -> 1848;
		1847 -> 1853;
	1850 [label="順利嗎？",shape=box,color=red];
		1850 -> 1849;
	1848 [label="哇，真聽我的了？",shape=box,color=red];
		1848 -> 1851;
	1853 [label="抱歉，我正忙著呢。[結束]",shape=box,color=red];
		1853 -> 1852;
	1849 [label="一開始他還以為我要揍他，笑死。但我把帶他上了屋頂，我們坐下來聊了聊",shape=box,color=blue];
		1849 -> 1854;
	1851 [label="媽的閉嘴，讓我說完，行不？",shape=box,color=blue];
		1851 -> 1849;
	1852 [label="Chat ends.",color=orange];
	1854 [label="我跟他講了我怎麼加入軍隊，怎麼成為一名狙擊手",shape=box,color=blue];
		1854 -> 1856;
		1854 -> 1855;
	1856 [label="你*其實*是怎麼成為狙擊手的？",shape=box,color=red];
		1856 -> 1857;
	1855 [label="然後呢？",shape=box,color=red];
		1855 -> 1858;
	1857 [label="現在這不重要",shape=box,color=blue];
		1857 -> 1858;
	1858 [label="我跟他說了我第一次殺人的事",shape=box,color=blue];
		1858 -> 1859;
	1859 [label="第一次透過瞄準鏡瞄準並奪走一條生命",shape=box,color=blue];
		1859 -> 1860;
	1860 [label="在戰場上殺紅了眼，有人拿槍拿刀衝過來，這是一回事……",shape=box,color=blue];
		1860 -> 1861;
	1861 [label="當你在屋頂上，距離他們300碼，他們甚至不知道你在哪，這又是另一回事了……",shape=box,color=blue];
		1861 -> 1864;
	1864 [label="然後你就有時間去*想*，他們是誰，為什麼會在那裡，有家人嗎？有孩子嗎？",shape=box,color=blue];
		1864 -> 1862;
	1862 [label="然後……你扣下扳機，砰",shape=box,color=blue];
		1862 -> 1863;
	1863 [label="現在這些已經不重要了",shape=box,color=blue];
		1863 -> 1865;
	1865 [label="他們死了，是我奪走了他們的生命",shape=box,color=blue];
		1865 -> 1866;
	1866 [label="那張臉一直留在我的腦海裡",shape=box,color=blue];
		1866 -> 1867;
	1867 [label="之後的每一個也都一樣",shape=box,color=blue];
		1867 -> 1868;
		1867 -> 1869;
	1868 [label="他有什麼反應……？",shape=box,color=red];
		1868 -> 1871;
	1869 [label="聽起來……真讓人振奮。",shape=box,color=red];
		1869 -> 1871;
	1871 [label="他很久都沒說話，我們只是坐在那裡沉默著",shape=box,color=blue];
		1871 -> 1877;
	1877 [label="然後他……告訴了我他最近做的那些惡夢",shape=box,color=blue];
		1877 -> 1874;
	1874 [label="他總覺得因為自己不是個真正的士兵而沒法成為團隊的一份子",shape=box,color=blue];
		1874 -> 1872;
	1872 [label="所以我跟他說了，作為士兵第一次殺人對我來說是多麼可怕",shape=box,color=blue];
		1872 -> 1873;
	1873 [label="我告訴他，這件事讓我經常做惡夢，比我小時候的惡夢還要糟糕",shape=box,color=blue];
		1873 -> 1875;
	1875 [label="但我跟他道歉，說我一直以來都像個混蛋一樣對待他",shape=box,color=blue];
		1875 -> 1876;
	1876 [label="我還告訴他他跟我們一樣屬於這裡，就像其他人一樣。我也有我的特質，就像他有他的特質一樣，這就是我們的本性，你懂我意思嗎？",shape=box,color=blue];
		1876 -> 1870;
	1870 [label="……然後你知道他說了什麼嗎……？",shape=box,color=blue];
		1870 -> 1878;
		1870 -> 1879;
	1878 [label="什麼？",shape=box,color=red];
		1878 -> 1882;
	1879 [label="不？",shape=box,color=red];
		1879 -> 1882;
	1882 [label="「你說得對，你這個混蛋」",shape=box,color=blue];
		1882 -> 1884;
	1884 [label="可就在我快要把他推下屋頂的時候？",shape=box,color=blue];
		1884 -> 1883;
	1883 [label="他抱了我，媽的他居然抱了我。還說：「但你也是我大哥」",shape=box,color=blue];
		1883 -> 1881;
	1881 [label="什麼鬼",shape=box,color=blue];
		1881 -> 1880;
	1880 [label="但是……算了。值了。我覺得這對他真的有意義……對我來說，我猜，也有意義",shape=box,color=blue];
		1880 -> 1886;
	1886 [label="+20 Chemistry",color=orange];
		1886 -> 1885;
	1885 [label="所以……謝啦",shape=box,color=blue];
		1885 -> 1887;
	1887 [label="Chat ends.",color=orange];
}