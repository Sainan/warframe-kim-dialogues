digraph {
	3001 [label="QuincyDay2 begins.",color=orange];
		3001 -> 3002;
	3002 [label="你失敗了",shape=box,color=blue];
		3002 -> 3003;
		3002 -> 3004;
		3002 -> 3005;
	3003 [label="嗯好。",shape=box,color=red];
		3003 -> 3007;
	3004 [label="失敗什麼？",shape=box,color=red];
		3004 -> 3007;
	3005 [label="哦，很好，我們還在繼續。",shape=box,color=red];
		3005 -> 3006;
	3007 [label="你應該要讓我恨你的",shape=box,color=blue];
		3007 -> 3008;
	3006 [label="閉嘴",shape=box,color=blue];
		3006 -> 3007;
	3008 [label="這就是這整個練習的重點，但你失敗了",shape=box,color=blue];
		3008 -> 3009;
	3009 [label="而現在──該死。該死的……",shape=box,color=blue];
		3009 -> 3010;
	3010 [label="Check boolean QuincySorted",color=orange];
		3010 -> 3011 [label=true,color=green];
		3010 -> 3013 [label=false,color=brown];
	3011 [label="就跟你說過，告訴你我怎麼加入六煞幫的故事不是什麼趣事",shape=box,color=blue];
		3011 -> 3012;
	3013 [label="現在換我告訴你這個會讓你恨我的故事了",shape=box,color=blue];
		3013 -> 3014;
	3012 [label="但現在這件事就要發生了。因為現在換我告訴你這個會讓你恨我的故事了",shape=box,color=blue];
		3012 -> 3014;
	3014 [label="因為還得有人來做這件事，對吧？如果不是你的話，那就是我了。一如往常那樣",shape=box,color=blue];
		3014 -> 3015;
		3014 -> 3016;
		3014 -> 3017;
	3015 [label="好喔。我在聽。",shape=box,color=red];
		3015 -> 3024;
	3016 [label="崑西，你可以不用這麼做。",shape=box,color=red];
		3016 -> 3023;
	3017 [label="我要走了。我不想玩這種遊戲。[結束]",shape=box,color=red];
		3017 -> 3022;
	3024 [label="也許你聽完我說的，也許你最後會明白",shape=box,color=blue];
		3024 -> 3025;
	3023 [label="不，我得做。也許你聽完我說的，也許你最後會明白為什麼",shape=box,color=blue];
		3023 -> 3025;
	3022 [label="好吧。很好。你幫我省去這個麻煩了。謝謝",shape=box,color=blue];
		3022 -> 3021;
	3025 [label="Check boolean QuincyArthur3",color=orange];
		3025 -> 3026 [label=true,color=green];
		3025 -> 3027 [label=false,color=brown];
	3021 [label="Update boolean QuincyNoDate",color=orange];
		3021 -> 3020;
	3026 [label="我告訴過你我為什麼會加入軍隊。我有多想讓我和我家人過上更好的生活",shape=box,color=blue];
		3026 -> 3119;
	3027 [label="我從來沒有告訴過你我為什麼會加入軍隊。那我就說快點，單純想讓我和我家人過上更好的生活",shape=box,color=blue];
		3027 -> 3028;
	3020 [label="Update boolean QuincyDating",color=orange];
		3020 -> 3019;
	3119 [label="我有機會這麼做之前，一切都發生了巨變",shape=box,color=blue];
		3119 -> 3038;
	3028 [label="在我長大的地方，沒有這種免費的機會讓你這麼做。不，你得出去闖",shape=box,color=blue];
		3028 -> 3029;
	3019 [label="Update boolean IsDating",color=orange];
		3019 -> 3018;
	3038 [label="不用天才也知道，陛下是我人生走錯路的原因，也是為什麼我發誓再也不會跟任何人交心了",shape=box,color=blue];
		3038 -> 3035;
	3029 [label="而像我這種人想要闖出一片天，最簡單的方法就是從軍。他們有發放獎學金，讓士兵可以上大學",shape=box,color=blue];
		3029 -> 3032;
	3018 [label="Chat ends.",color=orange];
	3035 [label="所以",shape=box,color=blue];
		3035 -> 3036;
	3032 [label="所以我想說，我就去幫他們殺個幾年的人，然後就可以順利進入商學院就讀。主修財金或企業管理碩士之類的",shape=box,color=blue];
		3032 -> 3030;
	3036 [label="在因緣際會，偶然機遇下，我最後加入了陛下的同個軍團，第三營隊──赤血守望。",shape=box,color=blue];
		3036 -> 3034;
	3030 [label="之後回家把家人安頓好，用有效的方式做出實質的改變",shape=box,color=blue];
		3030 -> 3031;
	3034 [label="他當時已經是中校了。而我才剛踏出軍校",shape=box,color=blue];
		3034 -> 3039;
	3031 [label="但我有機會這麼做之前，一切都發生了巨變",shape=box,color=blue];
		3031 -> 3033;
	3039 [label="有段時間，我試著遵守這些潛規則，當個優秀的小士兵。但當我繼續這樣做……我意識到局面還是對我不利",shape=box,color=blue];
		3039 -> 3037;
	3033 [label="Update boolean QuincyArthur3",color=orange];
		3033 -> 3038;
	3037 [label="人生並不公平。無論去到哪裡，到處都充斥著，偏袒、偏愛、盲從。人們因為我的來歷而鄙視我",shape=box,color=blue];
		3037 -> 3044;
	3044 [label="因為我的背景",shape=box,color=blue];
		3044 -> 3041;
	3041 [label="於是我……開始做蠢事。開始做我現在後悔的事。開始愚蠢地發洩情緒。如果他們想從我這裡拿走什麼，我就會反過來拿走他們的",shape=box,color=blue];
		3041 -> 3042;
	3042 [label="因為如果他們沒在為我著想的話，我又為什麼要為他們著想呢？所以我只在乎我自己，只有我自己，清楚嗎？",shape=box,color=blue];
		3042 -> 3040;
	3040 [label="我沒有偷東西。沒有違反規定。我是一名優秀的小士兵。但如果你有聽說過「惡意服從」這個詞，你就會明白我的用意了",shape=box,color=blue];
		3040 -> 3045;
	3045 [label="我當時一刻都沒浪費在別人身上，一直都沒有。我只想做完自己的事然後領完工資走人",shape=box,color=blue];
		3045 -> 3049;
	3049 [label="然後一切都出了差錯。我們正在執行一場任務。我在進行偵察，透過望遠鏡發現敵軍突然開始朝我們這個方向發動攻擊。他們發現我們在那裡",shape=box,color=blue];
		3049 -> 3046;
	3046 [label="亞瑟和其他部隊被困在戰場上，我必須在瞬間做出決定。我可以對那些亂了陣腳的敵軍開火並暴露自己的位置，給陛下和隊友們示警及時間後撤到安全的地方",shape=box,color=blue];
		3046 -> 3047;
	3047 [label="但這樣做會讓我陷入真正的麻煩。我敢肯定那些敵軍很快就會衝向我這邊了。所以……",shape=box,color=blue];
		3047 -> 3051;
	3051 [label="我收拾好自己的東西並使用無線電回報我們的行蹤已經暴露……反正，我想陛下和其他人早已經被敵方幹掉了……",shape=box,color=blue];
		3051 -> 3050;
	3050 [label="我離開那個我一直躲藏的房間，就在轉角遇到一名敵軍用步槍對準我",shape=box,color=blue];
		3050 -> 3048;
	3048 [label="他們一直都知道我在那裡。他們打從一開始就掌握我的動向了",shape=box,color=blue];
		3048 -> 3054;
	3054 [label="他們把我拖到街上，強迫我跪下並用手槍頂在我後腦勺",shape=box,color=blue];
		3054 -> 3053;
	3053 [label="砰砰",shape=box,color=blue];
		3053 -> 3561;
	3561 [label="是亞瑟。陛下不知從哪裡冒出來救了我",shape=box,color=blue];
		3561 -> 3562;
	3562 [label="因為這樣，我對他好生氣。我站起來後，當場斥責了他",shape=box,color=blue];
		3562 -> 3055;
		3562 -> 3056;
	3055 [label="是因為你捨得讓他去死，而他卻不願意丟下你？",shape=box,color=red];
		3055 -> 3062;
	3056 [label="因為你現在欠他一條命了？",shape=box,color=red];
		3056 -> 3062;
	3062 [label="是的",shape=box,color=blue];
		3062 -> 3063;
	3063 [label="看",shape=box,color=blue];
		3063 -> 3067;
	3067 [label="你難道不明白嗎？我過去只為我自己和我家人而活。那對我來說才是最重要的，是唯一對我來說有意義的事",shape=box,color=blue];
		3067 -> 3065;
	3065 [label="而現在……現在我得到這個混蛋，現在我還得關心他會發生什麼事",shape=box,color=blue];
		3065 -> 3064;
	3064 [label="那不是計劃的一部分",shape=box,color=blue];
		3064 -> 3059;
	3059 [label="所以當他幾個月後讓我們陷入大麻煩，而他卻要被開除時？！",shape=box,color=blue];
		3059 -> 3066;
	3066 [label="我得作選擇。我該他媽的對上級說一堆謊話？還是像以前一樣把他推出去？還我該做的正確的事？",shape=box,color=blue];
		3066 -> 3057;
	3057 [label="我選擇做正確的事，因為這是我虧欠他的，我……我和他一起離開了軍隊，也……也就這樣結束了我那個大學夢",shape=box,color=blue];
		3057 -> 3061;
	3061 [label="我渴望為自己和我家人過上更好生活的美夢沒了。但亞瑟說，「夥計，一切都會沒事的」",shape=box,color=blue];
		3061 -> 3060;
	3060 [label="「我已經在一個維和組織內幫我們安排好新的崗位了。他們給的薪水更多，而且從不拖欠。你會沒事的」",shape=box,color=blue];
		3060 -> 3058;
	3058 [label="然後我就像個白癡一樣跟他一起加入了危應部隊",shape=box,color=blue];
		3058 -> 3069;
		3058 -> 3068;
	3069 [label="然後科腐暴發了……",shape=box,color=red];
		3069 -> 3070;
	3068 [label="噢不……",shape=box,color=red];
		3068 -> 3071;
	3070 [label="是的，然後科腐就暴發了……事態急劇惡化，而那時……他比以往都還更需要我",shape=box,color=blue];
		3070 -> 3074;
	3071 [label="然後科腐就暴發了，事態急劇惡化，而那時……他比以往都還更需要我",shape=box,color=blue];
		3071 -> 3074;
	3074 [label="但我不能就這樣……轉身離開。已經不是那樣做的時候了，對吧？那時離不開……現在也走不了……",shape=box,color=blue];
		3074 -> 3072;
	3072 [label="每次我與別人交心，最後我都會成為他們的小玩具士兵……",shape=box,color=blue];
		3072 -> 3073;
	3073 [label="所以當你出現……然後直接闖進來……",shape=box,color=blue];
		3073 -> 3075;
	3075 [label="踢開了我緊緊鎖上的門……",shape=box,color=blue];
		3075 -> 3076;
	3076 [label="Check boolean QuincyDating",color=orange];
		3076 -> 3077 [label=true,color=green];
		3076 -> 3078 [label=false,color=brown];
	3077 [label="然後說，「不，夥計，現在你就是要和我在一起，就這麽辦，儘管我沒有什麼好的理由」",shape=box,color=blue];
		3077 -> 3079;
	3078 [label="然後說，「不是的，我在乎你，儘管我沒有什麼好的理由」",shape=box,color=blue];
		3078 -> 3079;
	3079 [label="我應該怎麼辦？上次發生這種事……還把我人生都毀了……",shape=box,color=blue];
		3079 -> 3081;
		3079 -> 3080;
		3079 -> 3082;
	3081 [label="我很抱歉你覺得你必須經歷這樣的人生。但之前發生的事並不是我的錯。",shape=box,color=red];
		3081 -> 3084;
	3080 [label="我理解你為什麼會覺得需要保護自己。",shape=box,color=red];
		3080 -> 3083;
	3082 [label="我還期待能聽到一些更勁爆的故事。你聽完我的故事後，能講的就這些？",shape=box,color=red];
		3082 -> 3089;
	3084 [label="我知道。你說得對。而……我很抱歉。我很害怕做這個「在一起」的這件事，無論這意味著什麼，只會再次毀了我",shape=box,color=blue];
		3084 -> 3086;
	3083 [label="……謝謝。這對我意義重大。但並不意味它是正確的。對不起，我打從心底感到害怕，這個「在一起」的這件事，無論這個「在一起」是什麼，會再次毀了我",shape=box,color=blue];
		3083 -> 3085;
	3089 [label="Update boolean QuincyNoDate",color=orange];
		3089 -> 3087;
	3086 [label="要嘛你重置世界讓我忘記你——別說你做不到——要嘛在事情變糟或我需要你時，你溜到未來去",shape=box,color=blue];
		3086 -> 3091;
	3085 [label="Update boolean Day2_20",color=orange];
		3085 -> 3086;
	3087 [label="Update boolean QuincyDating",color=orange];
		3087 -> 3090;
	3091 [label="但這也就是人生，不是嗎？生命就……就像你說的……是一次一段關係",shape=box,color=blue];
		3091 -> 3094;
	3090 [label="Update boolean IsDating",color=orange];
		3090 -> 3088;
	3094 [label="Check boolean QuincyDating",color=orange];
		3094 -> 3093 [label=true,color=green];
		3094 -> 3092 [label=false,color=brown];
	3088 [label="Chat ends.",color=orange];
	3093 [label="我想知道的是，寶貝，你能夠原諒我嗎？我們這次能夠真的繼續走下去嗎？",shape=box,color=blue];
		3093 -> 3095;
		3093 -> 3096;
	3092 [label="我想知道的是，你能夠原諒我嗎？我們這次能夠真的繼續走下去嗎？",shape=box,color=blue];
		3092 -> 3097;
		3092 -> 3096;
	3095 [label="我當然原諒你了。你對我來說很重要。",shape=box,color=red];
		3095 -> 3099;
	3096 [label="我……做不到。對不起。",shape=box,color=red];
		3096 -> 3098;
	3097 [label="我當然原諒你了。",shape=box,color=red];
		3097 -> 3100;
	3099 [label="Update boolean QuincyForgiven",color=orange];
		3099 -> 3105;
	3098 [label="……嗯，好吧。是我活該。對不起，如果我不再傳簡訊給你的話，是我……不想再提起這件事了，好嗎？掰了，再見",shape=box,color=blue];
		3098 -> 3104;
