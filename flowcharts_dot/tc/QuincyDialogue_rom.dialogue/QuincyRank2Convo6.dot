	1120 [label="嘿，崑西，我知道你不喜歡阿米爾，但我有件事想請你幫忙。",shape=box,color=red];
		1120 -> 1116;
	1121 [label="那麼，如果我想賄賂你去做點事，這得要花我多少錢？",shape=box,color=red];
		1121 -> 1122;
	1116 [label="哦，真的嗎？我可有點好奇了",shape=box,color=blue];
		1116 -> 1123;
		1116 -> 1124;
	1122 [label="哈哈，如果我還不知道你想要我做什麼，我怎麼知道這值多少錢？",shape=box,color=blue];
		1122 -> 1123;
		1122 -> 1124;
	1123 [label="好吧，那……先聽我說完再決定，好嗎？就是……有個遊戲。",shape=box,color=red];
		1123 -> 1127;
		1123 -> 1128;
		1123 -> 1129;
	1124 [label="阿米爾想讓大家聚在一起去玩一個桌上角色扮演遊戲。",shape=box,color=red];
		1124 -> 1125;
	1127 [label="我覺得這是個不錯的機會來能讓大家聚在一起。",shape=box,color=red];
		1127 -> 1131;
	1128 [label="這只是個放鬆一下的藉口，大家可以躺一躺，還可以喝幾杯啤酒。",shape=box,color=red];
		1128 -> 1130;
	1129 [label="團隊的士氣現在很低，因為發生了太多事情。",shape=box,color=red];
		1129 -> 1134;
	1125 [label="哈哈，當然不行",shape=box,color=blue];
		1125 -> 1126;
	1131 [label="我每天都已經花了很多時間來陪你們了，哈哈。萬一你忘記了的話，我想提醒你我們都被卡在這裡，哈哈哈。對不起，你們年輕人自己玩吧",shape=box,color=blue];
		1131 -> 1133;
	1130 [label="所以啊，這是一個很蠢的桌遊，*真的很蠢。*",shape=box,color=red];
