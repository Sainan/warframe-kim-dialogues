	1137 [label="「擲骰子並假裝自己是巫師」那種蠢。",shape=box,color=red];
		1137 -> 1139;
	1138 [label="聽我說，這個遊戲叫做《寓言與先驅》。",shape=box,color=red];
		1138 -> 1140;
	1139 [label="哈哈，看看我，老友，我看起來像是那種會想參加的人嗎？",shape=box,color=blue];
