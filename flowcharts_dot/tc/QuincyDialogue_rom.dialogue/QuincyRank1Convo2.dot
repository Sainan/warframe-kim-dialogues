	j1654096977 [label="笑死。你已經問了，你個白痴",shape=box,color=blue];
		j1654096977 -> j1399921285;
	"Chat ends." [color=orange];
	j1399921285 [label="你想知道我和陛下之間有什麼過節？我告訴你，總共有兩件事",shape=box,color=blue];
		j1399921285 -> j1985548755;
	j1985548755 [label="Boolean QuincyArthur1 is now true.",color=orange];
		j1985548755 -> j1417268302;
	j1417268302 [label="1. 英雄哥把自己看得太他媽的重要了",shape=box,color=blue];
		j1417268302 -> j1245601931;
	j1245601931 [label="他以為自己還在軍隊裡，這人得稍微冷靜點，明白在這裡根本沒有規則",shape=box,color=blue];
		j1245601931 -> j1190935603;
	j1190935603 [label="他就不能偶爾笑一下嗎？！他媽的！居然還有人以為是我有問題",shape=box,color=blue];
		j1190935603 -> j2495651456;
		j1190935603 -> j2275581073;
		j1190935603 -> j2730396364;
	j2495651456 [label="當領導壓力可不小。",shape=box,color=red];
		j2495651456 -> j2983995654;
	j2275581073 [label="他確實喜歡發愁……",shape=box,color=red];
		j2275581073 -> j2913017331;
	j2730396364 [label="那第二件事呢？",shape=box,color=red];
		j2730396364 -> j4225117634;
	j2983995654 [label="你以為我看不出來嗎？頭兒，我可不是傻子啊，別看我一眼就妄下結論",shape=box,color=blue];
		j2983995654 -> j1489567727;
	j2913017331 [label="+5 Chemistry",color=orange];
		j2913017331 -> j2863108071;
	j4225117634 [label="英雄仔看上的是我高超的技能，懂嗎？因為這樣他才讓我待在這裡，否則他才不會忍受我這種麻煩友",shape=box,color=blue];
		j4225117634 -> j28927971;
	j1489567727 [label="我是說，英雄哥需要把那根棍子從他那個他媽的屁股裡拿出來，不要那麼死板",shape=box,color=blue];
		j1489567727 -> j691316798;
	j2863108071 [label="我知道。世界要末日也不代表你不能偶爾放鬆一下",shape=box,color=blue];
		j2863108071 -> j4225117634;
	j28927971 [label="但他根本不聽我，覺得我只會做一件事：開槍和射殺",shape=box,color=blue];
		j28927971 -> j2301424410;
	j691316798 [label="這對任何人都沒有好處，而且它讓我快瘋了",shape=box,color=blue];
		j691316798 -> j4225117634;
	j2301424410 [label="他以為我是那種一有麻煩事就落跑的小子？不，老兄，我才不是這種人",shape=box,color=blue];
		j2301424410 -> j2752097369;
		j2301424410 -> j448559289;
	j2752097369 [label="當事情變得糟糕時，你為什麼*還*要留在這裡？",shape=box,color=red];
		j2752097369 -> j1722720529;
	j448559289 [label="我不知道。你會嗎？[結束]",shape=box,color=red];
		j448559289 -> j2276600610;
	j1722720529 [label="當科腐者爆發的時候？靠，你一來就問重點啊",shape=box,color=blue];
		j1722720529 -> j1401596010;
	j2276600610 [label="你對我一無所知，老友。別做夢了。你從某個鬼扯的未來過來，你根本不知道我經歷過什麼",shape=box,color=blue];
		j2276600610 -> j1846242014;
