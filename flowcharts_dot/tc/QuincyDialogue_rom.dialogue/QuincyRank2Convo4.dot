	1003 [label="很高興你終於理解了",shape=box,color=blue];
		1003 -> 1005;
	1027 [label="如果這樣有幫助的話，我想一下辦法吧。",shape=box,color=red];
		1027 -> 1032;
	1028 [label="我認識一個認為金錢能解決一切的人，你們倆肯定會很合得來。他就是 Parvos Granum。",shape=box,color=red];
		1028 -> 1030;
	1008 [label="Update boolean QuincyParvos",color=orange];
		1008 -> 1013;
	1009 [label="行行行，對不起。你一輩子都在忙著混日子，也就習慣了這種套路。我想說的是：你有錢，或者至少能搞到。而那幫貪得無厭的人還在用開呼在這破地方送貨呢",shape=box,color=blue];
