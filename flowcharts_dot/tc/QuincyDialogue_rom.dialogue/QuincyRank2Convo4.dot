	991 [label="我不喜歡玩遊戲。",shape=box,color=red];
		991 -> 994;
	992 [label="不值得繼續爭論……崑西，你到底想要什麼？",shape=box,color=red];
		992 -> 1005;
	1022 [label="別去看床底下吃掉你兄弟的怪物了，不不不，老兄，買買買，懂嗎？買了那台超棒的音響你就會開心了。繼續分散注意力，轉移焦點，花錢花錢花錢",shape=box,color=blue];
		1022 -> 1023;
	995 [label="+15 Chemistry",color=orange];
		995 -> 993;
	994 [label="你覺得我在玩嗎？得了吧，兄弟，我還以為這個階段已經過去了",shape=box,color=blue];
		994 -> 998;
		994 -> 999;
	1023 [label="到處都是他媽的一樣的故事，每次都這樣",shape=box,color=blue];
		1023 -> 1024;
	993 [label="是嗎？好吧。你想要真相？那我就直說。我想要對我有利的東西，如果說你想聽的話能達到目的，那我就會說。但這不代表我虛偽，只說明我懂得怎麼玩這場遊戲",shape=box,color=blue];
		993 -> 996;
	998 [label="我也是啊。",shape=box,color=red];
		998 -> 1017;
	999 [label="崑西，你*到底*想要什麼？",shape=box,color=red];
		999 -> 1000;
	1024 [label="不過看起來你是能賺些真金白銀的，去幫我們把東西直接送到崑哥我這兒吧",shape=box,color=blue];
		1024 -> 1025;
	996 [label="事實擺在這兒：現在對我好的事對你也有好處。我們是在同一條船上的，所以你又何必去在意我什麼時候對你笑？這些對你也有好處啊",shape=box,color=blue];
		996 -> 997;
	1017 [label="你想抱著你的泰迪熊，給自己講善人惡人的故事，好讓自己晚上能睡得著嗎？那你自便吧，老兄。我們其他人都活在現實世界裡",shape=box,color=blue];
		1017 -> 1018;
	1000 [label="跟其他人一樣，無論他們願不願意告訴你實話，我只想要對自己有利的東西。現在呢？這對你也有好處",shape=box,color=blue];
		1000 -> 1001;
		1000 -> 1002;
	1025 [label="然後我就把這些東西轉手賣給那些以為買了它就能改善生活的人。他們開始把我們當成年輕的羅賓漢，像是在幫窮人一樣",shape=box,color=blue];
		1025 -> 1026;
	997 [label="那麼他媽的問題到底是什麼呢？",shape=box,color=blue];
		997 -> 1006;
		997 -> 1007;
	1018 [label="而現實世界是由有錢人和窮人組成。誰有錢有資源，誰就掌控街道。你覺得他們會為此失眠嗎？才不會",shape=box,color=blue];
		1018 -> 1019;
	1001 [label="這話可真糟糕。",shape=box,color=red];
		1001 -> 1017;
	1002 [label="我懶得再跟你爭論下去。你到底想要什麼，崑西？說出來吧。",shape=box,color=red];
		1002 -> 1003;
	1026 [label="怎麼樣？你先幫我買些東西，我保證讓大家知道這些貨是你給的",shape=box,color=blue];
		1026 -> 1027;
		1026 -> 1028;
	1006 [label="我真希望能把你介紹給 Parvos Granum。你倆肯定能*合得來*。",shape=box,color=red];
		1006 -> 1008;
	1007 [label="因為我不喜歡被人玩弄，崑西。如果你想要我幫忙，直接開口。事情就這樣簡單，保持誠實就夠。",shape=box,color=red];
		1007 -> 1009;
	1019 [label="把你的腦袋從屁股裡拿出來，不然你就會變成那邊的陛下了",shape=box,color=blue];
