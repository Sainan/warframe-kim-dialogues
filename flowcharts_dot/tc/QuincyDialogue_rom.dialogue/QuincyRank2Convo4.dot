	972 [label="我在想，你用你那迷人的屁股到處幫人跑腿做事時，能不能順便幫幫你這位奢華的帥哥？",shape=box,color=blue];
		972 -> 975;
		972 -> 976;
	967 [label="怎麼了，我就不能跟我最愛的新住客——太空怪人打聲招呼嗎？",shape=box,color=blue];
		967 -> 973;
	974 [label="我在想，你到處幫人跑腿做事時，能不能順便幫幫你這位好哥們？",shape=box,color=blue];
		974 -> 979;
		974 -> 980;
	975 [label="為了你，做什麼都可以。你需要我做什麼？",shape=box,color=red];
