	"QuincyRank2Convo4 begins." [color=orange];
		"QuincyRank2Convo4 begins." -> j3671517917;
	j3671517917 [label="Boolean QuincyBlackMarket is now true.",color=orange];
		j3671517917 -> j3865965441;
	j3865965441 [label="Check boolean QuincyFlirt",color=orange];
		j3865965441 -> j1703008583 [label=true,color=green];
		j3865965441 -> j3217515919 [label=false,color=brown];
	j1703008583 [label="嘿，親愛的，有空聊一下嗎？",shape=box,color=blue];
		j1703008583 -> j872332403;
		j1703008583 -> j4131111636;
	j3217515919 [label="嘿，兄弟，有空聊一下嗎？",shape=box,color=blue];
		j3217515919 -> j3084976472;
		j3217515919 -> j4131111636;
	j872332403 [label="親愛的，嗯？；) 看來我被提拔了。",shape=box,color=red];
		j872332403 -> j3843605994;
	j4131111636 [label="我感覺你準備要開口求點什麼了……",shape=box,color=red];
		j4131111636 -> j2040835650;
	j3084976472 [label="兄弟，嗯？看來我被提拔了。",shape=box,color=red];
		j3084976472 -> j3676227257;
	j3843605994 [label="看到好東西就得欣賞，這不過分吧",shape=box,color=blue];
		j3843605994 -> j1299503705;
	j2040835650 [label="+5 Chemistry",color=orange];
		j2040835650 -> j760570535;
	j3676227257 [label="哈哈哈是的",shape=box,color=blue];
		j3676227257 -> j4206441716;
	j1299503705 [label="我在想，你用你那迷人的屁股到處幫人跑腿做事時，能不能順便幫幫你這位奢華的帥哥？",shape=box,color=blue];
		j1299503705 -> j2772363552;
		j1299503705 -> j1263998774;
	j760570535 [label="怎麼了，我就不能跟我最愛的新住客——太空怪人打聲招呼嗎？",shape=box,color=blue];
		j760570535 -> j82514374;
	j4206441716 [label="我在想，你到處幫人跑腿做事時，能不能順便幫幫你這位好哥們？",shape=box,color=blue];
		j4206441716 -> j3808612117;
		j4206441716 -> j1889357183;
	j2772363552 [label="為了你，做什麼都可以。你需要我做什麼？",shape=box,color=red];
		j2772363552 -> j3942140906;
	j1263998774 [label="等一下。你是在奉承我，然後要我幫忙嗎？",shape=box,color=red];
		j1263998774 -> j217730843;
	j82514374 [label="瞧，他們讓你到處跑腿幫人做雜活可真不公平啊。其實我是想幫*你*一個忙，才請你幫我做些小事",shape=box,color=blue];
		j82514374 -> j835086907;
		j82514374 -> j2151062857;
	j3808612117 [label="當然，你需要什麼？",shape=box,color=red];
		j3808612117 -> j3942140906;
	j1889357183 [label="等一下。你是在奉承我，然後要我幫忙嗎？",shape=box,color=red];
		j1889357183 -> j3576378402;
	j3942140906 [label="你看，這些事明明有更輕鬆的解決方法，但那位英雄哥陛下就是不信，結果害你白忙活一圈",shape=box,color=blue];
		j3942140906 -> j78248902;
	j217730843 [label="不，親愛的，你錯了。我只是想讓你的日子過得輕鬆一些，然後告訴你我的看法。兩者都可以是真實的，懂嗎",shape=box,color=blue];
		j217730843 -> j4087082052;
	j835086907 [label="我就知道，你*是*有目的的。",shape=box,color=red];
		j835086907 -> j2731941716;
	j2151062857 [label="崑西，你可以直接跟我說你要什麼，別再假奉承了。",shape=box,color=red];
		j2151062857 -> j312339118;
	j3576378402 [label="Check boolean QuincyDrifterNoHome",color=orange];
		j3576378402 -> j4168774855 [label=true,color=green];
		j3576378402 -> j724064465 [label=false,color=brown];
	j78248902 [label="+15 Chemistry",color=orange];
		j78248902 -> j1749200173;
	j4087082052 [label="我知道那位英雄仔陛下讓你在全城忙前忙後，幫大家做事，但其實有更輕鬆的方法能搞定我們需要的東西",shape=box,color=blue];
		j4087082052 -> j78248902;
	j2731941716 [label="看，就算我需要什麼，也不代表我們不能互相幫忙，懂不？",shape=box,color=blue];
		j2731941716 -> j78248902;
	j312339118 [label="你怎麼覺得這是假話？",shape=box,color=blue];
		j312339118 -> j3330925528;
	j4168774855 [label="不，兄弟，這就是我們彼此的做事方式。我幫你，你幫我。我知道你還不太習慣這樣 :)",shape=box,color=blue];
		j4168774855 -> j78248902;
	j724064465 [label="嘿，不，兄弟，你搞錯了。我只是想讓你日子過得輕鬆一些，這就是家人應該做的事，不是嗎？",shape=box,color=blue];
		j724064465 -> j78248902;
	j1749200173 [label="情況是這樣的，懂不？錢在街上沒啥用，但在這個超蠢的開映線上卻大派用場",shape=box,color=blue];
		j1749200173 -> j2406600955;
	j3330925528 [label="Check boolean QuincyHonesty",color=orange];
		j3330925528 -> j1391331752 [label=true,color=green];
		j3330925528 -> j3541443453 [label=true,color=green];
		j3330925528 -> j1788402295 [label=true,color=green];
		j3330925528 -> j3541443453 [label=false,color=brown];
		j3330925528 -> j1788402295 [label=false,color=brown];
	j2406600955 [label="世界可能就要完蛋了，但錢還是繼續有人去賺，所以政府還會繼續推動大家買買買",shape=box,color=blue];
		j2406600955 -> j2184490038;
	j1391331752 [label="崑西，你不是想我對你「真實」嗎？我也希望你能同樣待我。",shape=box,color=red];
		j1391331752 -> j3908125908;
	j3541443453 [label="我不喜歡玩遊戲。",shape=box,color=red];
		j3541443453 -> j1176651599;
	j1788402295 [label="不值得繼續爭論……崑西，你到底想要什麼？",shape=box,color=red];
		j1788402295 -> j78248902;
	j2184490038 [label="別去看床底下吃掉你兄弟的怪物了，不不不，老兄，買買買，懂嗎？買了那台超棒的音響你就會開心了。繼續分散注意力，轉移焦點，花錢花錢花錢",shape=box,color=blue];
		j2184490038 -> j717475708;
	j3908125908 [label="+15 Chemistry",color=orange];
		j3908125908 -> j1454433125;
	j1176651599 [label="你覺得我在玩嗎？得了吧，兄弟，我還以為這個階段已經過去了",shape=box,color=blue];
		j1176651599 -> j2393426711;
		j1176651599 -> j3968093083;
	j717475708 [label="到處都是他媽的一樣的故事，每次都這樣",shape=box,color=blue];
		j717475708 -> j480141873;
	j1454433125 [label="是嗎？好吧。你想要真相？那我就直說。我想要對我有利的東西，如果說你想聽的話能達到目的，那我就會說。但這不代表我虛偽，只說明我懂得怎麼玩這場遊戲",shape=box,color=blue];
		j1454433125 -> j258119030;
	j2393426711 [label="我也是啊。",shape=box,color=red];
		j2393426711 -> j1903772715;
	j3968093083 [label="崑西，你*到底*想要什麼？",shape=box,color=red];
		j3968093083 -> j3219350440;
	j480141873 [label="不過看起來你是能賺些真金白銀的，去幫我們把東西直接送到崑哥我這兒吧",shape=box,color=blue];
		j480141873 -> j2304312396;
	j258119030 [label="事實擺在這兒：現在對我好的事對你也有好處。我們是在同一條船上的，所以你又何必去在意我什麼時候對你笑？這些對你也有好處啊",shape=box,color=blue];
		j258119030 -> j2221381446;
	j1903772715 [label="你想抱著你的泰迪熊，給自己講善人惡人的故事，好讓自己晚上能睡得著嗎？那你自便吧，老兄。我們其他人都活在現實世界裡",shape=box,color=blue];
		j1903772715 -> j2614544144;
	j3219350440 [label="跟其他人一樣，無論他們願不願意告訴你實話，我只想要對自己有利的東西。現在呢？這對你也有好處",shape=box,color=blue];
		j3219350440 -> j1339104577;
		j3219350440 -> j3715074943;
	j2304312396 [label="然後我就把這些東西轉手賣給那些以為買了它就能改善生活的人。他們開始把我們當成年輕的羅賓漢，像是在幫窮人一樣",shape=box,color=blue];
		j2304312396 -> j782640205;
	j2221381446 [label="那麼他媽的問題到底是什麼呢？",shape=box,color=blue];
		j2221381446 -> j1467616466;
		j2221381446 -> j2423602031;
	j2614544144 [label="而現實世界是由有錢人和窮人組成。誰有錢有資源，誰就掌控街道。你覺得他們會為此失眠嗎？才不會",shape=box,color=blue];
		j2614544144 -> j209243941;
	j1339104577 [label="這話可真糟糕。",shape=box,color=red];
		j1339104577 -> j1903772715;
	j3715074943 [label="我懶得再跟你爭論下去。你到底想要什麼，崑西？說出來吧。",shape=box,color=red];
		j3715074943 -> j2078300918;
	j782640205 [label="怎麼樣？你先幫我買些東西，我保證讓大家知道這些貨是你給的",shape=box,color=blue];
		j782640205 -> j3378289718;
		j782640205 -> j4169139187;
	j1467616466 [label="我真希望能把你介紹給 Parvos Granum。你倆肯定能*合得來*。",shape=box,color=red];
		j1467616466 -> j4000707486;
	j2423602031 [label="因為我不喜歡被人玩弄，崑西。如果你想要我幫忙，直接開口。事情就這樣簡單，保持誠實就夠。",shape=box,color=red];
		j2423602031 -> j2410836694;
	j209243941 [label="把你的腦袋從屁股裡拿出來，不然你就會變成那邊的陛下了",shape=box,color=blue];
		j209243941 -> "Chat ends.";
	j2078300918 [label="很高興你終於理解了",shape=box,color=blue];
		j2078300918 -> j78248902;
	j3378289718 [label="如果這樣有幫助的話，我想一下辦法吧。",shape=box,color=red];
		j3378289718 -> j1076977961;
	j4169139187 [label="我認識一個認為金錢能解決一切的人，你們倆肯定會很合得來。他就是 Parvos Granum。",shape=box,color=red];
		j4169139187 -> j4000707486;
	j4000707486 [label="Boolean QuincyParvos is now true.",color=orange];
		j4000707486 -> j535812952;
	j2410836694 [label="行行行，對不起。你一輩子都在忙著混日子，也就習慣了這種套路。我想說的是：你有錢，或者至少能搞到。而那幫貪得無厭的人還在用開呼在這破地方送貨呢",shape=box,color=blue];
		j2410836694 -> j69138801;
	"Chat ends." [color=orange];
	j1076977961 [label="+5 Chemistry",color=orange];
		j1076977961 -> j715974354;
	j535812952 [label="我可聽得出你在嘲諷我，老友，不用你明說我也知道你在暗指我貪婪。要是你非得抱著泰迪熊給自己講些善惡分明的故事，那你自便吧",shape=box,color=blue];
		j535812952 -> j333662565;
	j69138801 [label="Boolean QuincyHonesty is now true.",color=orange];
		j69138801 -> j263497570;
	j715974354 [label="沒錯，這就是我想說的。我知道我可以指望你",shape=box,color=blue];
		j715974354 -> "Chat ends.";
	j333662565 [label="我們其他人都活在現實世界裡。而現實世界是由有錢人和窮人組成。誰有錢有資源，誰就掌控街道。你覺得他們會為此失眠嗎？才不會",shape=box,color=blue];
		j333662565 -> j1225447354;
	j263497570 [label="世界可能就要完蛋了，但錢還是繼續有人去賺，所以政府還會繼續推動大家買買買",shape=box,color=blue];
		j263497570 -> j1697765015;
	j1225447354 [label="如果那個叫 Parvos 的傢伙都認同我，那就說明他見過世面，也明白生活的真相。所以別再自以為是了，不然你就會變成那邊的陛下了",shape=box,color=blue];
		j1225447354 -> "Chat ends.";
	j1697765015 [label="所以，計劃是這樣的：你用你的現金去幫我買些貨，直接寄到你的好哥們崑哥這裡",shape=box,color=blue];
		j1697765015 -> j2304312396;
}