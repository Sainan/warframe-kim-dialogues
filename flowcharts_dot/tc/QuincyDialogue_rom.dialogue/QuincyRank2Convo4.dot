	1021 [label="世界可能就要完蛋了，但錢還是繼續有人去賺，所以政府還會繼續推動大家買買買",shape=box,color=blue];
		1021 -> 1022;
	981 [label="崑西，你不是想我對你「真實」嗎？我也希望你能同樣待我。",shape=box,color=red];
