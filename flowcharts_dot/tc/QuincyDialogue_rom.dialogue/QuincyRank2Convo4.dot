	1030 [label="Update boolean QuincyParvos",color=orange];
		1030 -> 1031;
	1013 [label="我可聽得出你在嘲諷我，老友，不用你明說我也知道你在暗指我貪婪。要是你非得抱著泰迪熊給自己講些善惡分明的故事，那你自便吧",shape=box,color=blue];
		1013 -> 1014;
