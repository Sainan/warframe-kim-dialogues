	976 [label="等一下。你是在奉承我，然後要我幫忙嗎？",shape=box,color=red];
		976 -> 985;
	973 [label="瞧，他們讓你到處跑腿幫人做雜活可真不公平啊。其實我是想幫*你*一個忙，才請你幫我做些小事",shape=box,color=blue];
		973 -> 977;
		973 -> 978;
	979 [label="當然，你需要什麼？",shape=box,color=red];
		979 -> 988;
	980 [label="等一下。你是在奉承我，然後要我幫忙嗎？",shape=box,color=red];
		980 -> 970;
	984 [label="你看，這些事明明有更輕鬆的解決方法，但那位英雄哥陛下就是不信，結果害你白忙活一圈",shape=box,color=blue];
		984 -> 1005;
	985 [label="不，親愛的，你錯了。我只是想讓你的日子過得輕鬆一些，然後告訴你我的看法。兩者都可以是真實的，懂嗎",shape=box,color=blue];
		985 -> 989;
	977 [label="我就知道，你*是*有目的的。",shape=box,color=red];
		977 -> 986;
	978 [label="崑西，你可以直接跟我說你要什麼，別再假奉承了。",shape=box,color=red];
		978 -> 987;
	988 [label="你看，這些事明明有更輕鬆的解決方法，但那位英雄哥陛下就是不信，結果害你白忙活一圈",shape=box,color=blue];
		988 -> 1005;
	970 [label="Check boolean QuincyDrifterNoHome",color=orange];
		970 -> 982 [label=true,color=green];
		970 -> 983 [label=false,color=brown];
	1005 [label="+15 Chemistry",color=orange];
		1005 -> 1004;
	989 [label="我知道那位英雄仔陛下讓你在全城忙前忙後，幫大家做事，但其實有更輕鬆的方法能搞定我們需要的東西",shape=box,color=blue];
		989 -> 1005;
	986 [label="看，就算我需要什麼，也不代表我們不能互相幫忙，懂不？",shape=box,color=blue];
		986 -> 1005;
	987 [label="你怎麼覺得這是假話？",shape=box,color=blue];
		987 -> 3531;
	982 [label="不，兄弟，這就是我們彼此的做事方式。我幫你，你幫我。我知道你還不太習慣這樣 :)",shape=box,color=blue];
		982 -> 1005;
	983 [label="嘿，不，兄弟，你搞錯了。我只是想讓你日子過得輕鬆一些，這就是家人應該做的事，不是嗎？",shape=box,color=blue];
		983 -> 1005;
	1004 [label="情況是這樣的，懂不？錢在街上沒啥用，但在這個超蠢的開映線上卻大派用場",shape=box,color=blue];
		1004 -> 1021;
	3531 [label="Check boolean QuincyHonesty",color=orange];
