	2479 [label="+10 Chemistry",color=orange];
		2479 -> 2480;
	2422 [label="什麼類型的都有，但大多是有聲書。因為當你執行持續觀察任務時——比如那種要在狙擊點上一待就是兩三天的任務——你得老老實實待著不動",shape=box,color=blue];
		2422 -> 2448;
	2429 [label="哈哈哈，你就真的是從太空來的，對吧。是啊，你可以這麼說，大部分人確實會這樣，哈哈。他們要麼根據我的性格，要麼根據我打字的方式，就覺得知道我的能力",shape=box,color=blue];
		2429 -> 2428;
	2480 [label="真的嗎？那太好了！我很想看看從你那遙遠的未來回望，事情到底會變成怎麼樣",shape=box,color=blue];
		2480 -> 2460;
	2448 [label="真的會無！聊！死！所以我喜歡待在上面，戴上一隻耳機，聽有聲書，明白吧？",shape=box,color=blue];
		2448 -> 2449;
	2428 [label="他們總以為我沒什麼本事。我跟葵有點像，大家看到她漂亮的臉，就覺得她蠢得像塊磚頭",shape=box,color=blue];
		2428 -> 2426;
	2460 [label="Chat ends.",color=orange];
	2449 [label="我覺得，既然反正要待在那裡，不如用時間學點實用的東西。所以我會聽財經、統計、科學、物理之類的書",shape=box,color=blue];
		2449 -> 2447;
	2426 [label="她比我們所有人加起來都強，還是戰場上的戰術大師。這女人是個威脅。而我呢？別人覺得我是個小混混？隨他們去吧",shape=box,color=blue];
