		j1659027750 -> j2952301376;
	j628408 [label="「你搞笑了，我老鼠全都在這」",shape=box,color=blue];
		j628408 -> j200423273;
	j200423273 [label="我竟然花了四個小時在餵養和陪伴一隻商場的野老鼠",shape=box,color=blue];
		j200423273 -> j3884343483;
