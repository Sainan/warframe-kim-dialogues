digraph {
	"QuincyRank6Convo10 begins." [color=orange];
		"QuincyRank6Convo10 begins." -> j687819484;
	j687819484 [label="我坐在那裡自顧自地在清理著軍械庫的槍支，對吧？",shape=box,color=blue];
		j687819484 -> j2667874057;
		j687819484 -> j411297034;
	j2667874057 [label="呃喔。",shape=box,color=red];
		j2667874057 -> j2226307171;
	j411297034 [label="嗯，然後呢？",shape=box,color=red];
		j411297034 -> j3333885917;
	j2226307171 [label="不，這是個好故事",shape=box,color=blue];
		j2226307171 -> j4053165189;
	j3333885917 [label="我在拆解一把惡沸患－5，然後我聽到小小的「吱吱」聲",shape=box,color=blue];
		j3333885917 -> j1067910951;
		j3333885917 -> j1274490467;
		j3333885917 -> j3953056578;
		j3333885917 -> j4237779047;
	j4053165189 [label="反正",shape=box,color=blue];
		j4053165189 -> j3333885917;
	j1067910951 [label="像是「老鼠」的聲音嗎？",shape=box,color=red];
		j1067910951 -> j2639074000;
	j1274490467 [label="[讓他繼續]",shape=box,color=red];
		j1274490467 -> j819647370;
	j3953056578 [label="吱吱？",shape=box,color=red];
		j3953056578 -> j3113584179;
	j4237779047 [label="你說什麼？我沒聽到。哈哈",shape=box,color=red];
		j4237779047 -> j85832832;
	j2639074000 [label="對呀！還是……泡博……什麼的？還是你們那個時代叫牠什麼來著",shape=box,color=blue];
		j2639074000 -> j819647370;
	j819647370 [label="我低下頭一看，有隻小老鼠就這樣躺在我腿上，像黑道老大一樣，抬頭看著我，像是在說，「兄弟，怎樣」",shape=box,color=blue];
		j819647370 -> j261857370;
	j3113584179 [label="對呀，你知道，就像老鼠發出的吱吱聲",shape=box,color=blue];
		j3113584179 -> j3262920805;
		j3113584179 -> j1274490467;
	j85832832 [label="閉嘴啦，笨蛋",shape=box,color=blue];
		j85832832 -> j819647370;
	j261857370 [label="我心想，「哦，嘿，是莉蒂家的其中一隻老鼠過來打招呼了」，就回了個，「嘿，小家人」，於是我就坐在那裡跟這個小傢伙說話，還餵了牠\n一些我的披薩，對吧？",shape=box,color=blue];
		j261857370 -> j5928985;
	j3262920805 [label="我覺得那應該拼作「唧」。",shape=box,color=red];
		j3262920805 -> j3650172680;
	j5928985 [label="給這隻小老大一些水喝，告訴牠說我在做什麼，教牠怎麼清理槍械的彈簧，笑死",shape=box,color=blue];
		j5928985 -> j914502761;
	j3650172680 [label="夥計，我從來就不需要去拼寫這個字，但還真是謝謝你啊，順便去死一死吧",shape=box,color=blue];
		j3650172680 -> j1036271557;
	j914502761 [label="整個過程牠就坐在那裡看著、聽著，打理著牠的小鬍鬚",shape=box,color=blue];
		j914502761 -> j2954865951;
	j1036271557 [label="你到底想不想聽這個故事啦？！",shape=box,color=blue];
		j1036271557 -> j1841364827;
		j1036271557 -> j1936176937;
		j1036271557 -> j3531928929;
	j2954865951 [label="超可愛",shape=box,color=blue];
		j2954865951 -> j3014608453;
	j1841364827 [label="其實，我還好。",shape=box,color=red];
		j1841364827 -> "Chat ends.";
	j1936176937 [label="抱歉。 : (",shape=box,color=red];
		j1936176937 -> j963164080;
	j3531928929 [label="抱歉。請繼續。",shape=box,color=red];
		j3531928929 -> j4143484017;
	j3014608453 [label="然後我忙完後，就說，「好啦，小家人，帶你回你媽媽那邊去」，於是牠就這樣跳到我肩膀上，一副沒什麼大不了的樣子，我就帶牠去找莉蒂了……",shape=box,color=blue];
		j3014608453 -> j2220149780;
		j3014608453 -> j1120897927;
	"Chat ends." [color=orange];
	j963164080 [label="+5 Chemistry",color=orange];
		j963164080 -> j1634962012;
	j4143484017 [label="嗯哼",shape=box,color=blue];
		j4143484017 -> j819647370;
	j2220149780 [label="我想我可以看到接下來這會怎麼發展了……",shape=box,color=red];
		j2220149780 -> j3163411611;
	j1120897927 [label="然後呢？",shape=box,color=red];
		j1120897927 -> j2952301376;
	j1634962012 [label="不……應該是我道歉才對，我有時候會對這種事很火大，是我的錯。總之",shape=box,color=blue];
		j1634962012 -> j819647370;
	j3163411611 [label="Check boolean QuincyDating",color=orange];
