		j3163411611 -> j1659027750 [label=false,color=brown];
	j2952301376 [label="我見到莉蒂後就對她說，「家人，你的老鼠還你」，結果她滿臉問號地回我",shape=box,color=blue];
		j2952301376 -> j628408;
