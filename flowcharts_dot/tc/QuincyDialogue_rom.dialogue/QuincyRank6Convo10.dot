		j273572308 -> j2610990494;
	j2610990494 [label="還不知道要給牠取什麼名字……",shape=box,color=blue];
		j2610990494 -> j4211338130;
	j4211338130 [label="在想要不要取「亞瑟」，但莉蒂說不要。哈哈。我晚點再決定了。她說會幫我給牠準備寵物用品",shape=box,color=blue];
