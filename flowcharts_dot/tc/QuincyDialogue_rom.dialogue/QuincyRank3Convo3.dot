digraph {
	1351 [label="QuincyRank3Convo3 begins.",color=orange];
		1351 -> 1352;
	1352 [label="所以…那隻巨大的怪異無毛怪物貓又是怎麼回事？",shape=box,color=blue];
		1352 -> 1353;
		1352 -> 1354;
		1352 -> 1355;
	1353 [label="你是在問卡利莫斯嗎？說實話，我也不太確定。",shape=box,color=red];
		1353 -> 1356;
	1354 [label="你是指她是一隻巨大的怪物貓這件事吧，還是想問她的具體情況？",shape=box,color=red];
		1354 -> 1357;
	1355 [label="稍等，我得去餵那隻巨大怪異的無毛怪物貓了。[結束]",shape=box,color=red];
		1355 -> 1359;
	1356 [label="哈哈，那可真是個好兆頭。如果連你都不知道，那我們該怎麼辦？",shape=box,color=blue];
		1356 -> 1361;
	1357 [label="嗯，好吧，既然你這麼說？哈哈，其實兩者我都想知道。",shape=box,color=blue];
		1357 -> 1362;
		1357 -> 1363;
		1357 -> 1364;
	1359 [label="+20 Chemistry",color=orange];
		1359 -> 1358;
	1361 [label="我有點覺得不該背對著它。我該擔心它還在為源拓氏工作嗎？",shape=box,color=blue];
		1361 -> 1364;
		1361 -> 1363;
	1362 [label="據我了解，卡利莫斯是一種庫娃，這種東西是從你們那些「貓」進化而成的。",shape=box,color=red];
		1362 -> 1365;
	1363 [label="說真的，我覺得卡利莫斯受夠了源拓氏的那些破事，就像很多人一樣。",shape=box,color=red];
		1363 -> 1369;
	1364 [label="有可能嗎？我是說，她是隻庫娃嘛，牠們總是有點狡猾，不是嗎？哈哈。",shape=box,color=red];
		1364 -> 1370;
	1358 [label="嗯，好吧，那還挺搞笑的，哈哈，6/10分",shape=box,color=blue];
		1358 -> 1360;
	1365 [label="酷啊，巨大的殺手貓",shape=box,color=blue];
		1365 -> 1366;
	1369 [label="這就說明牠比普通的貓更聰明，對吧",shape=box,color=blue];
		1369 -> 1372;
	1370 [label="這就是為什麼我喜歡狗，懂嗎？就算貓愛你，你也永遠沒法完全信任牠們",shape=box,color=blue];
		1370 -> 1371;
	1360 [label="Chat ends.",color=orange];
	1366 [label="但我是不是該擔心牠還在為源拓氏效力",shape=box,color=blue];
		1366 -> 1367;
		1366 -> 1368;
	1372 [label="我們是在說類似於人類的智力水平嗎？直話直說吧",shape=box,color=blue];
		1372 -> 1374;
	1371 [label="我奶奶有時候會把我留在她朋友家。那是一位很好的老太太，但她養了一隻完全瘋狂的貓",shape=box,color=blue];
		1371 -> 1373;
	1367 [label="我是說，「貓」總是有點狡猾的，對吧？哈哈。",shape=box,color=red];
		1367 -> 1370;
	1368 [label="如果你是源拓氏的寵物，你不也會受夠他的那些破事嗎？",shape=box,color=red];
		1368 -> 1369;
	1374 [label="Check boolean LettieCavia",color=orange];
		1374 -> 1375 [label=true,color=green];
		1374 -> 1376 [label=false,color=brown];
	1373 [label="一開始超乖超甜超溫柔，喵喵的叫還蹭著你，一副愛你的樣子，結果你以為安全了吧……一爪子招呼到你臉上",shape=box,color=blue];
		1373 -> 1380;
	1375 [label="她是不是像莉蒂跟我提過的那些參研者？莉蒂當時暴跳如雷，我很久沒見她那麼生氣了",shape=box,color=blue];
		1375 -> 1378;
		1375 -> 1379;
	1376 [label="我是說……源拓氏以前確實創造過有人類智力的動物，但它們通常會說話。",shape=box,color=red];
		1376 -> 1377;
	1380 [label="貓這東西，分分鐘發飆就能把你眼珠挖下來",shape=box,color=blue];
		1380 -> 1382;
		1380 -> 1383;
	1378 [label="我覺得她跟我們一樣聰明。她只是在裝酷，而我不打算去挑明這件事，因為我還想保住自己的臉。",shape=box,color=red];
		1378 -> 1381;
	1379 [label="但如果卡利莫斯有那麼聰明，我們早該知道了……對吧？",shape=box,color=red];
		1379 -> 1381;
	1377 [label="它們叫參研者。但如果卡利莫斯是其中之一，我們早該知道了……對吧？",shape=box,color=red];
		1377 -> 1381;
	1382 [label="不過我真的很喜歡庫娃，牠們聰明又優雅。牠們愛你是因為牠們選擇這麼做。而庫狛，也就是狗，抱歉，更多是因為本能。",shape=box,color=red];
		1382 -> 1385;
	1383 [label="我也跟你一樣，我也超愛庫狛——抱歉，就是狗狗。",shape=box,color=red];
		1383 -> 1384;
	1381 [label="哈哈，我可以跟你講講我一個前任的故事",shape=box,color=blue];
		1381 -> 1389;
	1385 [label="貓這玩意兒總在盤算著什麼事",shape=box,color=blue];
		1385 -> 1386;
	1384 [label="牠們總是那麼開心地見到你，只是想要你的愛",shape=box,color=blue];
		1384 -> 1385;
	1389 [label="牠以前總是裝得乖乖的，喵喵地叫超可愛，然後你一不注意…？立即進入殺戮模式！所有人都低估了牠，包括我自己",shape=box,color=blue];
		1389 -> 1390;
	1386 [label="我覺得那隻怪貓現在可能沒有惡意，但牠肯定在圖謀什麼",shape=box,color=blue];
		1386 -> 1387;
		1386 -> 1388;
	1390 [label="我絕對不會再犯這種錯，無論是對人還是對一隻巨大的怪貓",shape=box,color=blue];
		1390 -> 1391;
	1387 [label="我也不確定。不過我知道被人利用和忽視是什麼滋味。如果她願意留下，那她會有一張暖暖的床，還有我隨時願意給她的摸摸。",shape=box,color=red];
		1387 -> 1397;
	1388 [label="高見啊，謝啦。",shape=box,color=red];
		1388 -> 1394;
	1391 [label="我可不打算背對那玩意，哈哈，你最好也留點神",shape=box,color=blue];
		1391 -> 1387;
		1391 -> 1388;
	1397 [label="+20 Chemistry",color=orange];
		1397 -> 1392;
	1394 [label="+10 Chemistry",color=orange];
		1394 -> 1395;
	1392 [label="……嗯，你說得對。我們在某種程度上都是被那傢伙拋棄的流浪者，對吧",shape=box,color=blue];
		1392 -> 1393;
	1395 [label="Chat ends.",color=orange];
	1393 [label="只是又一個被利用後丟棄的東西，就算牠是一隻怪異的變種貓……但如果牠吃了我，我要你知道這全是你的錯",shape=box,color=blue];
		1393 -> 1396;
