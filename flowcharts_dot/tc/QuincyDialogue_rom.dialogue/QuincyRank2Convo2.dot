		j2604175939 -> j4104367945;
		j2604175939 -> j12341916;
	j1600341209 [label="噢老友，這也太爛了，不是嗎？",shape=box,color=blue];
		j1600341209 -> j2769252834;
	j3118449209 [label="哈哈哈，我不確定我是否還能「全裸」登場。還在習慣這些……裝甲。不過別擔心，我還是很猛的",shape=box,color=blue];
