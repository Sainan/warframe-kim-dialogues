		j1679997444 -> j1911456973;
	j383790018 [label="我長大的地方沒那種東西，不過，嘿，我在書本和電影裡見過",shape=box,color=blue];
		j383790018 -> j3555807038;
		j383790018 -> j3471364191;
	j3422346469 [label="這就是為什麼你需要我來帶你熟悉這裡嘛。怎麼樣，改變主意了嗎？拜託，一點小忙也算不上什麼吧",shape=box,color=blue];
		j3422346469 -> j2689593757;
		j3422346469 -> j3556931128;
	j1870851104 [label="你需要的是一個嚮導，一個老師，明白嗎？我就是那個人，當然啦，收費還是應該的哈哈",shape=box,color=blue];
		j1870851104 -> j1869441466;
		j1870851104 -> j1758451962;
	j460855304 [label="不管那個該死的源拓氏躲到哪，他都根本沒地方能躲過我。有些事情你就是不能亂搞，懂嗎？",shape=box,color=blue];
		j460855304 -> j501988093;
	j769440951 [label="老兄，你根本沒有概念",shape=box,color=blue];
		j769440951 -> j460855304;
	j620832450 [label="你的好意我心領了，但你不必保護我遠離現實。我看得夠多了，信我。可能沒你經歷的那麼瘋狂，但同樣殘酷",shape=box,color=blue];
		j620832450 -> j3637007633;
	j3234809650 [label="別再說那些屁話了，頭兒。你講話簡直跟那位英雄哥陛下一模一樣。我受不了多一個那種人在這裡閒晃，這肯定讓我抓狂",shape=box,color=blue];
		j3234809650 -> j2854821693;
	j1510001943 [label="我倒希望她別老待在我的腦子裡，不過我挺佩服她有那種正面硬剛一切的膽量",shape=box,color=blue];
		j1510001943 -> j1637066850;
	j2440214217 [label="Boolean QuincyDrifterNoHome is now true.",color=orange];
		j2440214217 -> j242787835;
	j1911456973 [label="那你為什麼還在這？少來這套，老友，我不買帳，抱歉了。你根本沒在掩飾，你的名字就讓你露餡了",shape=box,color=blue];
		j1911456973 -> j3754312296;
	j3555807038 [label="我那裡有凱駿。牠們聽起來都差不多，只是……沒毛。它們只有骨架。",shape=box,color=red];
		j3555807038 -> j62641314;
	j3471364191 [label="它們聽起來很可愛，還活著。對我來說，這是一個不錯的變化。",shape=box,color=red];
		j3471364191 -> j3462276783;
