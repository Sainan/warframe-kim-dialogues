		j3667695893 -> j2043676775;
	j3813329538 [label="那他們就是搞出科腐者的大聰明嗎？",shape=box,color=blue];
		j3813329538 -> j2575179872;
		j3813329538 -> j1844242758;
	j1018816152 [label="其實沒錯，我正想講。你有看到這些衣服嗎？這些可花了我不少氣力",shape=box,color=blue];
		j1018816152 -> j1734009650;
	j2561132338 [label="我超期待有機會能親手解決那些混蛋",shape=box,color=blue];
		j2561132338 -> j2110384368;
	j2043676775 [label="不知道神防不防彈，但有機會的話我肯定會試試，哈哈哈",shape=box,color=blue];
		j2043676775 -> j2110384368;
	j2575179872 [label="不，但他們確實是你現在要面對的大部分問題的元兇。",shape=box,color=red];
		j2575179872 -> j1742739191;
	j1844242758 [label="我懷疑是，但我無法證實，*一切*都源於他們。",shape=box,color=red];
		j1844242758 -> j1742739191;
	j1734009650 [label="不是啦，老兄。我只是想搞清楚我該恨誰，說不定某天我還真有機會碰到那些混蛋",shape=box,color=blue];
		j1734009650 -> j2110384368;
	j2110384368 [label="……不過現在我想起來，我們被困在這裡，我，還有六煞幫們，對吧？",shape=box,color=blue];
		j2110384368 -> j917632376;
		j2110384368 -> j1376093793;
	j1742739191 [label="還剩下誰可以讓我練練靶？",shape=box,color=blue];
		j1742739191 -> j2110384368;
	j917632376 [label="我想，如果你讓我對你使用傳識，我可以帶你前往未來。雖然我不知道能持續多久，但至少是個機會。",shape=box,color=red];
		j917632376 -> j1101179576;
	j1376093793 [label="我是這樣想的……",shape=box,color=red];
		j1376093793 -> j364328865;
