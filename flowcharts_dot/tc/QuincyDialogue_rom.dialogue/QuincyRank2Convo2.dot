		j893124097 -> j769440951;
	j1464303548 [label="老實說，這是因為我不知道該跟你說什麼。我一生都在追尋正義，但我不想讓你抱太大希望。",shape=box,color=red];
		j1464303548 -> j620832450;
	j3118296973 [label="源拓氏。Orokin。漠然。有區別嗎？這是為了拯救宇宙，而不是為了復仇。",shape=box,color=red];
		j3118296973 -> j3234809650;
	j2489726378 [label="看看愛琳娜，她變成了下一個怪物，你見她哭過嗎？她在努力接受一切，試著抬頭挺胸",shape=box,color=blue];
		j2489726378 -> j1510001943;
	j1348826441 [label="……不。",shape=box,color=red];
		j1348826441 -> j2440214217;
