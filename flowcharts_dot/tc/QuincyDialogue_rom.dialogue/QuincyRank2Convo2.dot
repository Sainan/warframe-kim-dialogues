	j1758451962 [label="我不需要嚮導，崑西。",shape=box,color=red];
		j1758451962 -> j1499315316;
	j3637007633 [label="我只想知道該把怒火發洩到誰身上。我甚至連他媽的名字是什麼都不知道。把我們變成怪胎是源拓氏的錯，那麼其它事情呢？！像科腐者那種事我又該怪誰？",shape=box,color=blue];
		j3637007633 -> j2044955018;
	j2854821693 [label="老友，我只是想知道該把誰的照片貼牆上當靶子讓我打幾槍。我需要一個能怪罪的人，我得找個地方把這股怒火發洩出去",shape=box,color=blue];
		j2854821693 -> j878817654;
	j1637066850 [label="如果你問我的話，她的膽子可比她兄弟大多了。如果打起來，我知道我會挺誰。",shape=box,color=blue];
