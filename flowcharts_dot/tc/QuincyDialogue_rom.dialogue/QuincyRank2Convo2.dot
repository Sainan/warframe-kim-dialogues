		j1101179576 -> j570440476 [label=true,color=green];
		j1101179576 -> j280256024 [label=false,color=brown];
	j364328865 [label="那外面的世界呢？這個鬼地方外的其它地方呢？也跟我們一樣卡在時間循環裡？永永遠遠……被困住？",shape=box,color=blue];
		j364328865 -> j2352193698;
		j364328865 -> j2526859309;
	j570440476 [label="哦，太棒了，我就喜歡像條狗一樣被人牽著走。去未來看看應該挺有意思的，雖然傳識這玩意兒真讓我害怕。不過要是能有機會干掉源拓氏……",shape=box,color=blue];
		j570440476 -> j3149909869;
	j280256024 [label="你是說我要像條狗一樣被牽出去溜？狗鏈這種事，好像通常是莉蒂玩的。不過嘛，為了你我倒是可以破例。;)",shape=box,color=blue];
		j280256024 -> j3418237081;
		j280256024 -> j3029053010;
		j280256024 -> j2332859788;
	j2352193698 [label="崑西，我也是邊走邊瞎搞的。你猜跟我猜其實差不了多少。",shape=box,color=red];
