	j501988093 [label="你真愛轉移話題，對吧",shape=box,color=blue];
		j501988093 -> j1464303548;
		j501988093 -> j3118296973;
	j2463280852 [label="我會像莉蒂那樣站在那裡生氣嗎？像陛下那樣憂鬱嗎？像小阿米爾那樣驚慌嗎？不……這些都不是我的風格",shape=box,color=blue];
		j2463280852 -> j2489726378;
	j742872635 [label="是啊，但我還有家人在家等我，你懂嗎？",shape=box,color=blue];
		j742872635 -> j1348826441;
		j742872635 -> j1679997444;
	j3266143709 [label="所以說你要有我崑西在你身邊。馬，就是那種四條腿的農場動物，跑得快，會嘶嘶叫，還有毛。",shape=box,color=blue];
