		j3149909869 -> j1536047970;
		j3149909869 -> j3750940610;
	j3418237081 [label="你戴起來肯定很不錯。不過老實說，我敢說你穿什麼都好看……甚至什麼都不穿。",shape=box,color=red];
		j3418237081 -> j2174758671;
	j3029053010 [label="你介意別再調情嗎？這不是針對你，只是……你不是我喜歡的那類。",shape=box,color=red];
		j3029053010 -> j1757499039;
	j2332859788 [label="哈哈，你想得美。不過我很高興你試著往好的方面想。",shape=box,color=red];
		j2332859788 -> j2880544078;
	j128250347 [label="很高興知道你沒覺得自己是萬物的主宰。嗯，我想你有大把時間可以把每件事都做到完美……大概這就是你為什麼有這麼多厲害的招式吧……",shape=box,color=blue];
