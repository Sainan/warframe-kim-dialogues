	872 [label="……好吧，是的老兄，我剛才有點過頭了。我有點抓狂，對這件事不怎麼驕傲。原諒我啦。",shape=box,color=blue];
		872 -> 874;
	873 [label="……好吧，我原諒你了，重新來吧",shape=box,color=blue];
		873 -> 874;
	884 [label="這就解釋了你為什麼還在這裡跟我們這些混蛋待在戰區",shape=box,color=blue];
		884 -> 888;
	887 [label="我就納悶你為什麼不回家？回到你來自的地方，而不是困在這裡，跟我們這群混蛋一起待在戰區裡",shape=box,color=blue];
