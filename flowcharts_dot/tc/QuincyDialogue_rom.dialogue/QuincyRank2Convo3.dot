		916 -> 920;
	917 [label="Update boolean QuincyDuviri1",color=orange];
		917 -> 921;
	940 [label="我曾經就是那個玩具士兵。被告知我是最棒的。「冠軍」將拯救世界免於壞人的侵害。我受夠了這些謊話",shape=box,color=blue];
		940 -> 941;
	937 [label="也許是，也許不是。也許你對他們有用，直到你沒用了。小心點，老兄。我經歷過那樣的事。也做過",shape=box,color=blue];
		937 -> 938;
	932 [label="下次你得跟我說清楚。但我想如果那是你必須作出的選擇？那裡還是這裡？",shape=box,color=blue];
		932 -> 936;
	931 [label="……創造了什麼？天哇！這玩意兒對你做了什麼？你跟神有仇？活見鬼了",shape=box,color=blue];
		931 -> 932;
	919 [label="我幾乎是孤軍奮戰，為了拯救始源星系裡被洗腦的無辜者，試著讓他們起來反抗那兩個掌控宇宙的瘋子。",shape=box,color=red];
		919 -> 918;
	920 [label="那是我第一次遇上漠然，可那不是最後一次。而就在那裡，牆中人徹底奪走了我擁有的*一切*。",shape=box,color=red];
		920 -> 922;
	921 [label="順帶一提，這個暴君其實是虛空侵入我的心靈時從中抽取了一本故事書的碎片後誕生的，他是我記憶的產物。",shape=box,color=red];
		921 -> 923;
	941 [label="但到了生死時刻呢？當我需要他們的時候呢？我受傷了又或者需要幫助呢？哈哈，什麼也沒有",shape=box,color=blue];
		941 -> 942;
	938 [label="免費忠告。你總是太晚才發現誰是你真正的家人。所以眼睛睜大點",shape=box,color=blue];
		938 -> 939;
	936 [label="好歹這個地方還有我這尊奢華的屁股鎮著撐撐場面",shape=box,color=blue];
		936 -> 3295;
	918 [label="那些你救過的人呢，他們沒鋪紅毯歡迎你？你覺得他們對會不會回去毫不在意？",shape=box,color=blue];
		918 -> 933;
