	923 [label="我他媽的看了什麼",shape=box,color=blue];
		923 -> 932;
	942 [label="突然之間，我就變成了某個該死的編號，只能跑去那個鳥不拉屎的辦公室，就為了被告知請滾蛋",shape=box,color=blue];
		942 -> 943;
