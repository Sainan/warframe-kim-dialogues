		3642 -> 3645;
		3642 -> 3646;
	3643 [label="嗯，她說那東西來自未來。我想說，廢話，它們肯定不是來自這裡，哈哈",shape=box,color=blue];
		3643 -> 3645;
		3643 -> 3646;
	3644 [label="Chat ends.",color=orange];
	3645 [label="嗯……你確定阿米爾沒有「超頻」他其中一個桌上玩具嗎？",shape=box,color=red];
