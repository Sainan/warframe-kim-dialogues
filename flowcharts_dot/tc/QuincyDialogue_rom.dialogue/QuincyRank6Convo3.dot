		3684 -> 3691 [label=true,color=green];
		3684 -> 3690 [label=false,color=brown];
	3685 [label="而阿耶就像……Ordis 曾經稱它為「記憶腦漿」。它幾乎可以在其中儲存任何東西。",shape=box,color=red];
		3685 -> 3692;
	3686 [label="是啊，他們……總的來說算不上什麼好人。",shape=box,color=red];
		3686 -> 3693;
	3687 [label="當整個社會建立在說服你某件事不但「沒問題」，而且還是「受尊敬」的基礎上，有時候在當下很難看清它的本質。",shape=box,color=red];
		3687 -> 3694;
	3688 [label="我們才剛開始。",shape=box,color=red];
		3688 -> 3695;
	3689 [label="總有一天，我真心希望你不會再有新的恐怖太空創傷可以教我了",shape=box,color=blue];
		3689 -> 3696;
	3691 [label="說到這個，你一定會很喜歡 Varzia 和 Maroo。他們也會很喜歡你。搞不好喜歡得有點上頭喔。 ; )",shape=box,color=red];
		3691 -> 3697;
	3690 [label="說到這個，你一定會很喜歡 Varzia 和 Maroo。他們也會很喜歡你。",shape=box,color=red];
