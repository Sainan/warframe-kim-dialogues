	3634 [label="我一直在城鎮裡發現這些奇怪的……像是……",shape=box,color=blue];
		3634 -> 3635;
	3635 [label="我甚至都不知道它們叫什麼",shape=box,color=blue];
		3635 -> 3636;
	3636 [label="它們也不太像熔岩燈或那些喝水鳥的玩意兒",shape=box,color=blue];
		3636 -> 3637;
	3637 [label="我找到一個，給粉紅頭看，她看了一眼說那是「潛在」的永動機",shape=box,color=blue];
