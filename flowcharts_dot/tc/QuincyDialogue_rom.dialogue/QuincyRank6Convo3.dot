	3692 [label="夥計，你得幫我用另一種方式來解釋這個了",shape=box,color=blue];
		3692 -> 3698;
	3693 [label="所以你要不要告訴我這些老不死的老害跟這個古怪的桌上玩具有什麼關係，笑死",shape=box,color=blue];
		3693 -> 3675;
		3693 -> 3676;
	3694 [label="直到 Orokin 處決了哲士 Margulis ，Tenno 才奮起反抗 Orokin。而這不是因為「承續」儀式或承體廳堂之類的事情。",shape=box,color=red];
		3694 -> 3699;
	3695 [label="是啊，我本想說",shape=box,color=blue];
		3695 -> 3700;
	3696 [label="晚點見",shape=box,color=blue];
		3696 -> 3701;
	3697 [label="哈哈，寶貝，就別嫉妒了，我們只有在你同意的情況下才會那樣恣情放縱，哈哈",shape=box,color=blue];
		3697 -> 3702;
	3954 [label="哈哈，哦，真的嗎？也許我得去和粉紅頭談談，讓我搭個便車",shape=box,color=blue];
		3954 -> 3955;
	3698 [label="這樣說好了。阿耶就像錄影帶中的實體磁帶。阿耶檀識之星就像是把磁帶放入卡式盒的樣子。",shape=box,color=red];
		3698 -> 3703;
	3699 [label="+5 Chemistry",color=orange];
		3699 -> 3704;
	3700 [label="你還沒告訴我這個古怪的桌上玩具是什麼，而且它跟那些老不死的老害有什麼關係，笑死",shape=box,color=blue];
		3700 -> 3675;
		3700 -> 3676;
	3701 [label="Chat ends.",color=orange];
	3702 [label="除此之外，每次我了解更多關於未來的事，我就越慶幸自己困在過去",shape=box,color=blue];
		3702 -> 3705;
	3955 [label="開個玩笑而已，每次我了解更多關於未來的事，我就越慶幸自己困在過去",shape=box,color=blue];
		3955 -> 3705;
	3703 [label="而阿耶檀識塑就像錄影帶播放器。",shape=box,color=red];
		3703 -> 3706;
	3704 [label="不，你說得對。我們很容易把發生的事情歸咎於壞人，但當整個社會都這樣時，那又是另一回事了，對不？",shape=box,color=blue];
		3704 -> 3707;
	3705 [label="還好它們有被妥善地利用，而且適當地被熔化",shape=box,color=blue];
		3705 -> 3689;
	3706 [label="……我需要知道什麼樣的螢幕可以播放這些該死的未來錄影帶嗎……？",shape=box,color=blue];
		3706 -> 3708;
	3707 [label="人們在那個世界帶大，在其中長大，信任它，建立它",shape=box,color=blue];
		3707 -> 3709;
	3708 [label="Orokin 自己本身。就是，一名 Orokin 個體。而他們主要用它們來儲存他們最喜愛的回憶。",shape=box,color=red];
		3708 -> 3680;
	3709 [label="而拆了它需要花上不少精力。你的世界還要面對這種問題喔？",shape=box,color=blue];
		3709 -> 3710;
	3710 [label="同樣的屁事，不同的時空背景。我想就只有一件事沒變，對吧？無論何時何地，人性難改。",shape=box,color=blue];
		3710 -> 3700;
