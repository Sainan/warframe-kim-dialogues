		3663 -> 3667;
	3664 [label="這個我們……現在不會深入討論，因為那又是另一個麻煩事。",shape=box,color=red];
		3664 -> 3668;
	3665 [label="承續儀式是 Orokin 用來將意識轉移到另一個身軀的儀式。",shape=box,color=red];
		3665 -> 3669;
	3666 [label="他們以為自己是神。他們最喜愛的回憶盡是折磨、鞭打、屠殺……處決的回憶。",shape=box,color=red];
		3666 -> 3670;
	3667 [label="當你能夠永生不死，而你隨時就可以把意識轉移到另一個身軀裡……",shape=box,color=red];
		3667 -> 3670;
	3668 [label="呃，是啊，好吧，就直接跳過就好，有什麼不行呢",shape=box,color=blue];
		3668 -> 3671;
		3668 -> 3672;
	3669 [label="喲，等一下，什麼",shape=box,color=blue];
		3669 -> 3673;
	3670 [label="宇宙等級的殘酷事件，永遠儲存在磁片上",shape=box,color=blue];
		3670 -> 3674;
	3671 [label="如果要我細數 Orokin 幹過的每件可怕的事，我們會在這裡待上一整年了。",shape=box,color=red];
		3671 -> 3675;
		3671 -> 3676;
	3672 [label="我已經盡量總結很多了，甚至試圖解釋那麼多，抱歉了。",shape=box,color=red];
		3672 -> 3675;
		3672 -> 3676;
