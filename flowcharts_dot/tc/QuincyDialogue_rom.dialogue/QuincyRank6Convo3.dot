	3660 [label="簡而言之嗎？是的。",shape=box,color=red];
		3660 -> 3655;
	3662 [label="阿耶壇識塑像是古老的 Orokin 神器，與 Orokin 的「承續」儀式相關。",shape=box,color=red];
		3662 -> 3664;
