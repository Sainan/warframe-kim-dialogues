		3673 -> 3677;
	3674 [label="來自地獄的家庭影片……",shape=box,color=blue];
		3674 -> 3678;
		3674 -> 3679;
	3675 [label="簡單來說，總結一下，阿耶壇識塑像是用來儲存 Orokin 最喜愛的回憶……",shape=box,color=red];
		3675 -> 3680;
	3676 [label="所以，阿耶壇識塑像可以安裝阿耶檀識之星。安裝後，它們就會動。",shape=box,color=red];
		3676 -> 3681;
	3677 [label="他們會挑選年輕漂亮的「承體」作為非情願的宿主，並使用赤毒來摧毀宿主原有的意識，進而讓自己的意識進行覆寫。",shape=box,color=red];
		3677 -> 3682;
	3678 [label="它們還包含 Warframe 的藍圖。許多 Warframe 我們都還在陸續探索中。",shape=box,color=red];
		3678 -> 3683;
	3679 [label="好消息是，我們在未來有用到它們。我們會把它們熔掉並用來升級我們自己的武器。",shape=box,color=red];
		3679 -> 3684;
