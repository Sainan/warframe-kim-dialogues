		3144 -> 3146;
	3147 [label="應感是觸碰過虛空的武器，既有近戰武器也有槍械。它們會對能量作出反應。",shape=box,color=red];
		3147 -> 3150;
	3148 [label="扎日曼號上有個叫 Cavalero 的人……我突然有種強烈的衝動想把你們倆互相介紹認識。",shape=box,color=red];
