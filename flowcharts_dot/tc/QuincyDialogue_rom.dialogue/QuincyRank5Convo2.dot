		3150 -> 3153;
		3150 -> 3152;
	3149 [label="總之，他開始製造一些觸碰過虛空的武器，包括近戰和槍械。它們會對能量作出反應……我猜大概是這樣吧。",shape=box,color=red];
		3149 -> 3151;
	3153 [label="我的意思是……我會把槍口指著遠離我臉的地方，剩下的我就不太擔心了。",shape=box,color=red];
		3153 -> 3161;
		3153 -> 3160;
	3152 [label="好吧，聽著。雖然我能*使用*虛空的力量，但並不代表我總是知道它是怎麼運作的。這些武器是通過虛空來實現它們的變化。",shape=box,color=red];
		3152 -> 3161;
