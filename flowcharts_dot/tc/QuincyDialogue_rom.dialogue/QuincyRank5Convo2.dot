	3151 [label="你聽著好像也不太確定啊。還有，那個 cavalero 是誰？",shape=box,color=blue];
		3151 -> 3152;
		3151 -> 3154;
	3161 [label="據我所知，它們從我殺死的敵人身上吸取能量，這樣它們才能變形。",shape=box,color=red];
		3161 -> 3162;
	3160 [label="虛空……能夠對很多東西做出很多奇怪的事。其實這很難解釋清楚，但你可以這麼想……",shape=box,color=red];
		3160 -> 3163;
	3154 [label="Cavalero 是扎日曼號上的其中一位堅守者。你也可以說他是個鬼魂。他脾氣不好，負責武器管理。基本上就是個混蛋。你一定會喜歡他。",shape=box,color=red];
