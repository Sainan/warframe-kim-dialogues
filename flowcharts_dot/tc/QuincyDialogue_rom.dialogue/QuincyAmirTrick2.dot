digraph {
	3451 [label="QuincyAmirTrick2 begins.",color=orange];
		3451 -> 3450;
	3450 [label="你知道嗎，每次我以為自己已經搞懂那小疾風仔了，他就是會讓我驚奇，笑死我了",shape=box,color=blue];
		3450 -> 3452;
		3450 -> 3453;
		3450 -> 3454;
	3452 [label="怎麼說？",shape=box,color=red];
		3452 -> 3457;
	3453 [label="他在為包裝花生的事生氣嗎？",shape=box,color=red];
		3453 -> 3456;
	3454 [label="[無視]",shape=box,color=red];
		3454 -> 3455;
	3457 [label="嗯，於是我就用紙板隔開房間，並在上面開了個洞，然後用吸塵器反向把包裝花生吸到他房間裡，得把那玩意兒塞滿他整個房間",shape=box,color=blue];
		3457 -> 3459;
		3457 -> 3458;
	3456 [label="除了那件事以外",shape=box,color=blue];
		3456 -> 3457;
	3455 [label="Chat ends.",color=orange];
	3459 [label="讓我好佩服。",shape=box,color=red];
		3459 -> 3460;
	3458 [label="顯然你以前做過這種事。",shape=box,color=red];
		3458 -> 3460;
	3460 [label="生活在軍事基地有時還真挺無聊的，不知道要怎麼跟你說，哈哈",shape=box,color=blue];
		3460 -> 3461;
	3461 [label="接著就是把門關上，然後從門底下的縫拉出紙板，這樣他開門的時候，所有東西就會倒出來了，就這麼簡單",shape=box,color=blue];
		3461 -> 3462;
	3462 [label="他走過來後，一切都按照計劃進行，他說「誒，我的門怎麼關起來了，好奇怪喔」。接著把門打開。咻一聲",shape=box,color=blue];
		3462 -> 3463;
	3463 [label="他像個小女生看到老鼠一樣尖叫起來，還單用一條腿跳來跳去，真是太棒了",shape=box,color=blue];
		3463 -> 3467;
	3467 [label="然後他聽到我在大笑，我當下以為他會生氣。但他接著也開始大笑起來",shape=box,color=blue];
		3467 -> 3464;
	3464 [label="他還問了我是怎麼做的！所以我就跟他講了整個過程。那個小疾風仔好像……很佩服的樣子，向我要了我用過的紙板，然後用它把他房門的下半部給黏死，像個圍欄一樣",shape=box,color=blue];
		3464 -> 3465;
	3465 [label="這個小怪胎把自己的房間打造成包裝花生的球池了，就像你在漢堡店看到的那樣。我發現他和葵一起在裡面玩，兩個人在互扔花生，像是在扔雪球一樣",shape=box,color=blue];
		3465 -> 3466;
	3466 [label="他們問我要不要加入",shape=box,color=blue];
		3466 -> 3468;
		3466 -> 3469;
	3468 [label="那你有加入嗎？",shape=box,color=red];
		3468 -> 3470;
	3469 [label="然後呢？",shape=box,color=red];
		3469 -> 3470;
	3470 [label="去，我嗎？崑哥？！我？！老子本人？我這高手？你以為會看到我跟那些年輕人在池子裡嗎？",shape=box,color=blue];
		3470 -> 3471;
	3471 [label="當然了，我跳了進去！",shape=box,color=blue];
		3471 -> 3472;
	3472 [label="你出現之前，我根本就不會做那種事。完全不會。所以……嗯。謝謝你開導我",shape=box,color=blue];
		3472 -> 3473;
	3473 [label="+20 Chemistry",color=orange];
		3473 -> 3474;
	3474 [label="下一個惡作劇對象？輪到亞瑟了。 ; )",shape=box,color=blue];
		3474 -> 3475;
	3475 [label="Chat ends.",color=orange];
}