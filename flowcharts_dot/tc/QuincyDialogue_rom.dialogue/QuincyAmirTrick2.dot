	"QuincyAmirTrick2 begins." [color=orange];
		"QuincyAmirTrick2 begins." -> j1379322400;
	j1379322400 [label="你知道嗎，每次我以為自己已經搞懂那小疾風仔了，他就是會讓我驚奇，笑死我了",shape=box,color=blue];
		j1379322400 -> j732095326;
		j1379322400 -> j2548842533;
		j1379322400 -> j3102889003;
	j732095326 [label="怎麼說？",shape=box,color=red];
		j732095326 -> j3997191437;
	j2548842533 [label="他在為包裝花生的事生氣嗎？",shape=box,color=red];
		j2548842533 -> j121090811;
	j3102889003 [label="[無視]",shape=box,color=red];
		j3102889003 -> "Chat ends.";
	j3997191437 [label="嗯，於是我就用紙板隔開房間，並在上面開了個洞，然後用吸塵器反向把包裝花生吸到他房間裡，得把那玩意兒塞滿他整個房間",shape=box,color=blue];
		j3997191437 -> j3628544425;
		j3997191437 -> j1658104385;
	j121090811 [label="除了那件事以外",shape=box,color=blue];
		j121090811 -> j3997191437;
	"Chat ends." [color=orange];
	j3628544425 [label="讓我好佩服。",shape=box,color=red];
		j3628544425 -> j235003259;
	j1658104385 [label="顯然你以前做過這種事。",shape=box,color=red];
		j1658104385 -> j235003259;
	j235003259 [label="生活在軍事基地有時還真挺無聊的，不知道要怎麼跟你說，哈哈",shape=box,color=blue];
		j235003259 -> j2773234268;
	j2773234268 [label="接著就是把門關上，然後從門底下的縫拉出紙板，這樣他開門的時候，所有東西就會倒出來了，就這麼簡單",shape=box,color=blue];
		j2773234268 -> j3625963060;
	j3625963060 [label="他走過來後，一切都按照計劃進行，他說「誒，我的門怎麼關起來了，好奇怪喔」。接著把門打開。咻一聲",shape=box,color=blue];
		j3625963060 -> j469900774;
	j469900774 [label="他像個小女生看到老鼠一樣尖叫起來，還單用一條腿跳來跳去，真是太棒了",shape=box,color=blue];
		j469900774 -> j2964076957;
	j2964076957 [label="然後他聽到我在大笑，我當下以為他會生氣。但他接著也開始大笑起來",shape=box,color=blue];
		j2964076957 -> j3203071478;
	j3203071478 [label="他還問了我是怎麼做的！所以我就跟他講了整個過程。那個小疾風仔好像……很佩服的樣子，向我要了我用過的紙板，然後用它把他房門的下半部給黏死，像個圍欄一樣",shape=box,color=blue];
		j3203071478 -> j4144587282;
	j4144587282 [label="這個小怪胎把自己的房間打造成包裝花生的球池了，就像你在漢堡店看到的那樣。我發現他和葵一起在裡面玩，兩個人在互扔花生，像是在扔雪球一樣",shape=box,color=blue];
		j4144587282 -> j2822607464;
	j2822607464 [label="他們問我要不要加入",shape=box,color=blue];
		j2822607464 -> j1029630846;
		j2822607464 -> j2557945308;
	j1029630846 [label="那你有加入嗎？",shape=box,color=red];
		j1029630846 -> j3964929514;
	j2557945308 [label="然後呢？",shape=box,color=red];
		j2557945308 -> j3964929514;
	j3964929514 [label="去，我嗎？崑哥？！我？！老子本人？我這高手？你以為會看到我跟那些年輕人在池子裡嗎？",shape=box,color=blue];
		j3964929514 -> j1594063066;
	j1594063066 [label="當然了，我跳了進去！",shape=box,color=blue];
		j1594063066 -> j2440003292;
	j2440003292 [label="你出現之前，我根本就不會做那種事。完全不會。所以……嗯。謝謝你開導我",shape=box,color=blue];
		j2440003292 -> j4134193741;
	j4134193741 [label="+20 Chemistry",color=orange];
		j4134193741 -> j944275376;
	j944275376 [label="下一個惡作劇對象？輪到亞瑟了。 ; )",shape=box,color=blue];
		j944275376 -> "Chat ends.";
}