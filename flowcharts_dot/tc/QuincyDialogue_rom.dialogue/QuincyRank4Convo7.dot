		2714 -> 2718;
		2714 -> 2717;
	2713 [label="好吧……聽著。阿米爾正在搞一場《寓言與先驅》的遊戲。",shape=box,color=red];
		2713 -> 2718;
		2713 -> 2717;
	2716 [label="阿米爾在搞一場桌遊，這是我們大家聚在一起的好機會。",shape=box,color=red];
		2716 -> 2718;
		2716 -> 2717;
	2718 [label="我知道這些宅東西可能不是你的菜，但我敢打賭，如果你肯試試，這會比你想的更好玩。",shape=box,color=red];
		2718 -> 2720;
	2717 [label="你知道的。笑一笑、聚一聚、喝點酒、吃點零食，開心一下。這對他來說很有意義。",shape=box,color=red];
		2717 -> 2719;
	2720 [label="能不能說服你去試一次，就一晚？要是你不喜歡，隨時可以不玩了。",shape=box,color=red];
		2720 -> 2722;
