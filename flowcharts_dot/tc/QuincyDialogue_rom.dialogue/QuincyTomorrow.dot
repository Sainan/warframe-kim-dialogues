		2680 -> 2681 [label=true,color=green];
		2680 -> 2682 [label=false,color=brown];
	2678 [label="Update boolean QuincySorted",color=orange];
		2678 -> 2679;
	2681 [label="就算我們在一起了也這樣嗎？",shape=box,color=blue];
		2681 -> 2687;
		2681 -> 2688;
		2681 -> 2689;
	2682 [label="……你真厲害。好吧。我得先理清自己的思緒。等我理清了再來找你聊",shape=box,color=blue];
		2682 -> 2683;
	2679 [label="Chat ends.",color=orange];
	2687 [label="就先這樣吧。我想。你覺得可以嗎？",shape=box,color=red];
		2687 -> 2692;
	2688 [label="這可能意味著我們無法更進一步。但如果你能接受，我也沒問題。",shape=box,color=red];
		2688 -> 2694;
	2689 [label="我不知道，我也只是邊走邊學，我不習慣處理感情關係。但我想和你在一起，我也希望你能信任我。不過我也明白，信任是不能強迫的。",shape=box,color=red];
		2689 -> 2696;
	2683 [label="說在前頭，到時候可能不會太愉快。暫時就這樣吧，下次見",shape=box,color=blue];
		2683 -> 2684;
	2692 [label="+5 Chemistry",color=orange];
