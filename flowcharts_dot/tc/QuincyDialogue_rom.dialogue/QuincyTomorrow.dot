		2663 -> 2666 [label=false,color=brown];
		2663 -> 2667 [label=false,color=brown];
	2661 [label="Chat ends.",color=orange];
	2665 [label="崑，我們在交往。但很明顯你不想告訴我到底發生過什麼事。你應該能信任我，和我分享這些事。",shape=box,color=red];
		2665 -> 2668;
	2666 [label="我一直在等你告訴我，而且我一直很耐心。",shape=box,color=red];
		2666 -> 2672;
	2667 [label="如果你不想告訴我就直接說吧。我們每個人都有秘密。不管發生了什麼，這是你的事。",shape=box,color=red];
		2667 -> 2673;
	2664 [label="崑，我們是朋友。但很明顯你不想告訴我到底發生過什麼事。你應該能信任我，和我分享這些事。",shape=box,color=red];
		2664 -> 2670;
	2668 [label="聽著，我就不跟你計較了，因為很明顯你這輩子沒多少感情經歷，甚至可能完全沒有",shape=box,color=blue];
		2668 -> 2669;
	2672 [label="好吧，好吧，是的，很抱歉，這真不是我喜歡提的事",shape=box,color=blue];
		2672 -> 2674;
	2673 [label="別總吊著我說要告訴我又不說。你不喜歡被耍，我也一樣。",shape=box,color=red];
		2673 -> 2672;
	2670 [label="聽著，我就不跟你計較了，因為很明顯你這輩子沒多少朋友",shape=box,color=blue];
		2670 -> 2671;
	2669 [label="但和某人交往還得信任到把自己最黑暗的過去都告訴他們？哈哈，有時候你真的挺像個小屁孩",shape=box,color=blue];
		2669 -> 2675;
		2669 -> 2676;
	2674 [label="無意冒犯",shape=box,color=blue];
		2674 -> 2676;
	2671 [label="但和某人交朋友還得信任到把自己最黑暗的過去都告訴他們？哈哈，有時候你真的挺像個小屁孩",shape=box,color=blue];
		2671 -> 2675;
		2671 -> 2676;
	2675 [label="這不就是信任的意思嗎？",shape=box,color=red];
		2675 -> 2677;
	2676 [label="我懂了。你準備好了再說，沒問題。如果「要準備好」就是「永遠不說」，那也行。",shape=box,color=red];
		2676 -> 2680;
	2677 [label="日尊啊，你有時候還挺可愛的。不，我們現在不討論這事，我也不想跟你吵。我會好好想想，等我理清楚了我們再聊",shape=box,color=blue];
		2677 -> 2678;
