		3485 -> 3486;
	3488 [label="還有對所有事，所有人感到不滿，因為他們剝奪我的未來，我的夢想，尤其是亞瑟……",shape=box,color=blue];
		3488 -> 3489;
	3486 [label="Chat ends.",color=orange];
