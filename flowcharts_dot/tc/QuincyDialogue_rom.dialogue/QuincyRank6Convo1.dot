		3489 -> 3490;
	3490 [label="我從來沒有想過，也許，嘿……蠢蛋，你想要的東西是會變的。也許你現在擁有的一切就是你一直以來做夢都想得到的東西",shape=box,color=blue];
		3490 -> 3491;
	3491 [label="現在我看了看四周，我看……我看到的是一個社區。是啊，當然，沒問題，我們依然要面對科腐者像蒼蠅一樣不斷騷擾我們，還有維克多在外頭耍流岷",shape=box,color=blue];
		3491 -> 3487;
