	3968 [label="嘿，崑？有空嗎？[徵求同意發展多重伴侶關係]",shape=box,color=red];
		3968 -> 3971;
	3967 [label="[結束]",shape=box,color=red];
		3967 -> 3970;
	3966 [label="Chat ends.",color=orange];
	3971 [label="有啊，怎麼了寶貝？",shape=box,color=blue];
		3971 -> 3973;
	3970 [label="Update boolean QuincyConsentComplete",color=orange];
		3970 -> 3972;
	3973 [label="我想和你說件事，我想確認你的想法。",shape=box,color=red];
		3973 -> 3974;
	3972 [label="Chat ends.",color=orange];
	3974 [label="對我來說更重要的是，希望你不會覺得我在騙你或以任何方式對你不忠。",shape=box,color=red];
		3974 -> 3975;
	3975 [label="笑死，你到底做了什麼",shape=box,color=blue];
		3975 -> 3976;
	3976 [label="你殺了誰，陛下死了？",shape=box,color=blue];
		3976 -> 3977;
	3977 [label="不！沒什麼。亞瑟還活著。我只是想跟你談件事，希望不會讓你感到不舒服。",shape=box,color=red];
		3977 -> 3978;
	3978 [label="我不願讓你置身你不願待的處境。所以如果你不想的話，那也沒關係。我希望你明白這點。",shape=box,color=red];
		3978 -> 3979;
	3979 [label="我們之間的關係對我來說很重要，非常重要，而且它是真實的。我不希望你懷疑這點。",shape=box,color=red];
		3979 -> 3980;
	3980 [label="Check boolean QuincyForgiven",color=orange];
		3980 -> 3982 [label=true,color=green];
		3980 -> 3981 [label=false,color=brown];
	3982 [label="哦，天啊寶貝，你是想告訴我你在另一個城市還有另一個情人？",shape=box,color=blue];
		3982 -> 3984;
	3981 [label="哦，天啊寶貝，你是想告訴我你在另一座城開了另一個局？",shape=box,color=blue];
		3981 -> 3983;
	3984 [label="我想在事情還沒到無法挽回之前徵求你的同意。我不想讓你不開心，而且這是我們從來沒談過的事。",shape=box,color=red];
		3984 -> 3986;
	3983 [label="我想在事情還沒到無法挽回之前徵求你的同意。我不想讓你不開心，而且這是我們從來沒談過的事。",shape=box,color=red];
		3983 -> 3985;
	3986 [label="誰說我會不開心了？不是啊，寶貝，我還在想粉紅頭可以怎麼幫我搭個便車過去呢，笑死",shape=box,color=blue];
		3986 -> 3988;
	3985 [label="不會！不會，我尊重會玩的人",shape=box,color=blue];
		3985 -> 3987;
	3988 [label="不過說真的，這我懂。我知道那是什麼感覺。有時候你會墜入愛河，然後又再次墜入愛河，這只代表你有顆能那樣做的心，沒什麼好羞恥的",shape=box,color=blue];
		3988 -> 3990;
	3987 [label="不過說真的，這我懂。我知道那是什麼感覺。有時候你會愛上一個，然後又愛上另一個，這只代表你有顆能那樣做的心，沒什麼好羞恥的",shape=box,color=blue];
		3987 -> 3989;
	3990 [label="+20 Chemistry",color=orange];
		3990 -> 3992;
	3989 [label="+20 Chemistry",color=orange];
		3989 -> 3991;
	3992 [label="如果你是說我們之間還有什麼，那我就信你",shape=box,color=blue];
