	j2181949898 [label="嘿，崑？有空嗎？[徵求同意發展多重伴侶關係]",shape=box,color=red];
		j2181949898 -> j2720002381;
	j2107693800 [label="[結束]",shape=box,color=red];
		j2107693800 -> j3870760305;
	j2720002381 [label="有啊，怎麼了寶貝？",shape=box,color=blue];
		j2720002381 -> j3834083806;
	j3870760305 [label="Boolean QuincyConsentComplete is now true.",color=orange];
		j3870760305 -> "Chat ends.";
	j3834083806 [label="我想和你說件事，我想確認你的想法。",shape=box,color=red];
		j3834083806 -> j2465321707;
	j2465321707 [label="對我來說更重要的是，希望你不會覺得我在騙你或以任何方式對你不忠。",shape=box,color=red];
		j2465321707 -> j1031778691;
	j1031778691 [label="笑死，你到底做了什麼",shape=box,color=blue];
		j1031778691 -> j17759896;
	j17759896 [label="你殺了誰，陛下死了？",shape=box,color=blue];
		j17759896 -> j3540816189;
	j3540816189 [label="不！沒什麼。亞瑟還活著。我只是想跟你談件事，希望不會讓你感到不舒服。",shape=box,color=red];
		j3540816189 -> j2111970762;
	j2111970762 [label="我不願讓你置身你不願待的處境。所以如果你不想的話，那也沒關係。我希望你明白這點。",shape=box,color=red];
		j2111970762 -> j3893130014;
	j3893130014 [label="我們之間的關係對我來說很重要，非常重要，而且它是真實的。我不希望你懷疑這點。",shape=box,color=red];
		j3893130014 -> j1148984836;
	j1148984836 [label="Check boolean QuincyForgiven",color=orange];
		j1148984836 -> j2490781909 [label=true,color=green];
		j1148984836 -> j2555766455 [label=false,color=brown];
	j2490781909 [label="哦，天啊寶貝，你是想告訴我你在另一個城市還有另一個情人？",shape=box,color=blue];
		j2490781909 -> j1677892;
	j2555766455 [label="哦，天啊寶貝，你是想告訴我你在另一座城開了另一個局？",shape=box,color=blue];
		j2555766455 -> j543520623;
	j1677892 [label="我想在事情還沒到無法挽回之前徵求你的同意。我不想讓你不開心，而且這是我們從來沒談過的事。",shape=box,color=red];
		j1677892 -> j4134268983;
	j543520623 [label="我想在事情還沒到無法挽回之前徵求你的同意。我不想讓你不開心，而且這是我們從來沒談過的事。",shape=box,color=red];
		j543520623 -> j729014171;
	j4134268983 [label="誰說我會不開心了？不是啊，寶貝，我還在想粉紅頭可以怎麼幫我搭個便車過去呢，笑死",shape=box,color=blue];
		j4134268983 -> j405137986;
	j729014171 [label="不會！不會，我尊重會玩的人",shape=box,color=blue];
		j729014171 -> j829565992;
	j405137986 [label="不過說真的，這我懂。我知道那是什麼感覺。有時候你會墜入愛河，然後又再次墜入愛河，這只代表你有顆能那樣做的心，沒什麼好羞恥的",shape=box,color=blue];
		j405137986 -> j274806126;
	j829565992 [label="不過說真的，這我懂。我知道那是什麼感覺。有時候你會愛上一個，然後又愛上另一個，這只代表你有顆能那樣做的心，沒什麼好羞恥的",shape=box,color=blue];
		j829565992 -> j3015160682;
	j274806126 [label="+20 Chemistry",color=orange];
		j274806126 -> j3340422559;
	j3015160682 [label="+20 Chemistry",color=orange];
		j3015160682 -> j2599326408;
	j3340422559 [label="如果你是說我們之間還有什麼，那我就信你",shape=box,color=blue];
		j3340422559 -> j3067651084;
	j2599326408 [label="如果你是說我們之間還沒結束，那我就信你",shape=box,color=blue];
		j2599326408 -> j3067651084;
	j3067651084 [label="你最好別開始用曖昧的表情盯著六煞或圓桌成員看",shape=box,color=blue];
		j3067651084 -> j1575132376;
	j1575132376 [label="拜託最好不要是六煞成員，我會徹底瘋掉",shape=box,color=blue];
		j1575132376 -> j3870760305;
