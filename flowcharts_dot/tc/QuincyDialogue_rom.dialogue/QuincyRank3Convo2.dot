		j1569770138 -> j2124717937;
	j974835706 [label="我跟其他人一樣討厭 Orokin 帝國，真的。但 Sentients 也不是什麼聖人。",shape=box,color=red];
		j974835706 -> j3377178500;
	j1945988067 [label="為了完成這個計劃，他們創造了一個人工的合成種族，Sentients。然而，Sentients 最後卻為此對 Orokin 帝國發動戰爭。",shape=box,color=red];
