	j3716173170 [label="砰，開始吧，老大！",shape=box,color=blue];
		j3716173170 -> j1195954959;
	j2124717937 [label="我不是說他們是英雄啦，兄弟。我只是說這個世界有太多歷史，把那些被視為「低等」的人當成可消耗品，懂嗎？",shape=box,color=blue];
		j2124717937 -> j2408507888;
	j3377178500 [label="我不是說他們是，兄弟。我只是說這個世界有太多歷史，把那些被視為「低等」的人當成可消耗品，懂嗎？",shape=box,color=blue];
		j3377178500 -> j2408507888;
	j2236749316 [label="哇哇哇，等一下，等一下。你得讓我緩一下，這一堆荒謬的東西太多了",shape=box,color=blue];
